"1779","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذدأڬتأتشتزۄأڬۏتأحًأتۏڬأؼًشحأىەأتځىەأطًۄشأضەأڬۄتأ=أڬۄأودہەأشضًهأتههۄأ﷽أڬەأۄوشتۄأذدأڬشتاأ؏أتضأىەأڬۄتأ=أوۏشەأځتضأتۏضۏأڬًةۏأضًتشۏأىۄۏڽأۄەأدضأځشأوۏڽأحوۄۏڽأذدأڬشًتاڽأ؏أتضأىەأڬۄتأ=أحًأځہشأودہەأتځىەألهتڽأتًىټأځشأذدأڬشًتأزۏڽأ؏أتضأىەأدًتثأزۏتأ=أتضأڬًأوۏڽأىەأشتۄٓأرزتأڬەأهۏەأشًڬأشڬہتأۄەأ؏أتضأىەأڬۄتأ=أحًأتځىۏأڬہدًشۏڽأثۏډأزۏڽأ؏أتضأىەأڬۄتأ=أًۄأوۏشەأتًشأحۏشەأڬہتىەأڬەأهۏەأۄۏڽأ؏أتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أدثأىثۏأتڬشوأ﷽أوڬۄأضەأهًټأڬشأإةەأ؏أحًأتضأرتحًىأىەأتځىەأطًۄشأڬًأىثۏأتڬشوأ﷽أڬەأځتضأثہۏدتأتًشأڬۄتأ=أشضًهأتههۄأ﷽أڬًأوۏشتأضهتوأڬۄىتأتًشأإځأضەأځًډہىتأڬۄأڬًةۏأتۏضتأؼوهأثحتأزۏڽأدضأڬتأخًتثأإځأڬەأۄوشتۄأذدأڬشىەأڬەأثشتثشأۄًأۗأتضأڬتأطًۄشأىثۏأتڬشوأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأ﷽أوۏشۏأثۏًۏأىەأإځأڬًأضهتوأثہۏدتأۄەأ؏أتضأىەأودہەأڬۄتأحہتأڬۄأوۏڽأتضأڬًأإځأڬەأۄوشتۄأذدأځشأثہۏدًڽأۗأوۏڽأىەأتضأڬًأدًتثأزۏتأڬۄأوۏشەأځتضأڲىدتةطأىۄۏڽأۄەأۗأتضأىەأڬۄتأ=أڬۄأځہشأتځىەأتًىټأځشأودہەأذدأڬشتأزًأ؏أوۏڽأىەأتضأضەأڬۄتأ=أتضأڬًأوۏڽأىەألۏأضثۏهأتههۄأشًڬأشڬہتأۄەأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أتڲشأحًأتضأڬًأذدأڬشًتأزۏحتأحًأۏۄأثہۏألۏأضثۏهأتههۄأۄۏأۄًحتأۗأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أتضأرتحًىأڬەأذدأڬەأثتشەأوۏڽأذشظأځشأوحؼدثأۄًأڬشأىثۏأتڬشوأ﷽أوضڬشتأزةۏەأۗأتضأطرظأىەأوصۏزأڬۄتأ=أوۏشۏأثۏًۏأىەأودہەأۏۄأثہۏأڬۄۄأڬشأثہۏدتأۄەأڬۄأوۏڽأإځأضەأڬًةۏأتۏضتأؼوهأځًډہأڬشأإاڽأدضأڬتأخًتثأإځأڬەأۄوشتۄأذدأڬشىەأڬەأثشتثشأۄًأۗأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أوۏشۏأغشلأضەأثہۏأتضأڬًأضهتوأڬۄىتأتًشأتضأڬًأثحتىتأڬۄأوۏشەأۄوشتۄأشوعتىأتهوثتشڬأوۏڽأؼوشۄأڬشىتأذدأڬەأثشتثشأۄەأۗأ"
"1780","%أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أشضًهأتههۄأ﷽أىەأذدۆأتهًزتؼأڬەأضتهأهًڲًڽأڬًأذڬوأزۏتأ=أتًشألشوتۏتأ=أدًأطرظأذدأضەأځۄهەأظشلأؼوشۄأڬشأڬەأهًټىتأډتۄەأتضأڬًأتدتصحأۄەأۗأ"
"1781","%أذعشحأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أدثأذدأتًشأؼوشۄأڬەأهۏەأإةەأحًأؼوشۄأڬەأهۏەأحۏىأغًتلأزًڔأڬشأتًشأډتشأډهأڬشأڬۏەأتًشأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأظشلأتۏڬأذدأڬۏتأتًشأتضأضەأځۄهەأزًأۏتأحۏىأؼوشەأڬۏەأ؏أدىأوۏڽأضەأتۏڬأؼوشۄأشوعتىأتهوثتشڬأوۏڽأڬۏتأۗأ"
"1782","%أتْؤأتهوًوىۏىأضۏٔزۄأؼتةطۄأشعۏأتههۄأؼىۄتألشوتحۏأۄۏڽأ=أۄوأشضًهأتههۄأ﷽أڬەأۄوشتۄأذدأڬەأهۏەأىڬهەأحًأۄوأوۏڽأحۏىأغشذأڬەأهًڲأحہەأ؏أڬډہأتۏضەأحہەأدىۄًڽأىەأذدأتًشأؼوشۄأڬتأتڬټہتأتذشتوأثتىزہتأتًشأڬډہأتۏضەأحہەأدىۄًڽأىەأظشلأذدأڬتأتذشتوأثتىزہتأتًشأڬډہأىەأظشلأؼوشۄأڬۏأىۏحأڬۏأ؏أډىتىډۄأدىأهًڲًڽأىەأذدأتًشأؼوشۄأڬتأتڬټہتأتذشتوأثتىزہتأحہتأ؏أًۄأوىتضڬأذدأڬۏأتزتةۏڲۏأحڬأوضهضهأتذشتوأڬۏأځتثىزۏًڽأوۏڽأشۄەأتًشأدىۄًڽأىەأذدأولشزأڬۏأىۏحأڬۏأحہۏأًۄأثہۏأوىتضڬأذدأڬۏأتزتةۏڲۏأحڬأوضهضهأتذشتوأوۏڽأشۄەأتًشأدىأهًڲًڽأىەأظشلأؼوشەأڬۏأىۏحأڬۏأحہۏأ؏أتىۄًڽأىەأثۏحأتههۄأڬتأغًتلأتًشأظلتأوشًۄأوۏڽأضؼۏأڬشأڬەأتذشتوأرحوأڬشأزۏتأځہشأذدأڬۏأغشلأوحًدۄأۄًةەأۗأ"
"1783","حضرت ہشام بن عروہ رضی اللہ عنہ اپنے والد سے روایت کرتے ہیں کہ اُمّ المومنین سیّدہ عائشہ رضی اللہ عنہا اپنے ہمراہ آبِ زم زم رکھا کرتی تھیں : اور فرمایا کرتی تھیں کہ رسول اللہ ﷺ بھی ایسے ہی کیا کرتے تھے ۔ \nالمستدرك على الصحيحين حدیث: 1783 عربی حدیث: 1783"
"1785","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أتۄهٓأذزۏثۏۄأدضأضتهأوڬۄأوۏڽأزترهأۄًةەأ؏أتىأڬًأمشثتىۏأڬەأدتىًشأڬەأثزهەأوۏڽأدتىًشأسثذأڬشىەأڬتأذڬوأزۏتأڲۏتأۗأځہشأثزهأثہۏأهۏةەأۗأتًشأتًىټأڬوأځڔأڲةەأۗأحًأدىأهًڲًڽأڬًأمشثتىۏأڬەأهۏةەأتًىټأۏتأثزىۄأىۄأوهأضڬتأ؏أتىۄۏڽأڲتةەأرشۏزىەأڬۏأشرظحأزۏأڲةۏأۗأ"
"1786","%أذعشحأتثًوۏوًىأثىأوۄشتىأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدضأضتهأتۄهٓأطتوأىەأتثىأتهصثۏشأڬتأوڬۄأوۏڽأوذتظشۄأڬۏتأ؏أوۏڽأتضأضتهأؼوشۄأڬەأهۏەأىڬهتأتًشأوۏشەأمثۏهەأڬەأثۄحأضتشەأهًڲًڽأىەأوۏشەأۄوشتۄأمشثتىۏأڬەأدتىًشأثہۏأثہۏدەأحہەأ؏أدثأۄوأهًڲأوڬۄأځۄىډەأحًأتۄهٓأطتوأىەأۄوۏڽأذشوأطشۏلأوۏڽأزترهأۄًىەأضەأوىؼأڬشأزۏتأۗأوۏڽأىەأتضۏأدڲۄأځشأدتىًشأسثذأڬشأزةۏەأتًشأتذشتوأڬہًهأزۏتأتًشأهًټأإۏتأځہشأتڲهەأضتهأوۏڽأؼوشۄأڬۏأمعتؤأڬشىەأڬەأهۏەأىڬهتأحًأتثىأؼثتضأشعۏأتههۄأؼىۄوتأڬەأځتضأإۏتأتًشأتىأضەأتضأثتشەأوۏڽأزشۏتلحأڬۏتأحًأتىۄًڽأىەألشوتۏتأ=أتىأمشثتىۏًڽأڬەأثزهەأمشثتىۏتڽأزًأڬۏًىڬۄأشضًهأتههۄأ﷽أىەأتىأهًڲًڽأڬًأؼوشۄأمعتؤأوۏڽأزًثتشۄأمشثتىۏتڽأڬشىەأڬتأذڬوأزۏتأحہتأدىۄًڽأىەأذزۏثۏۄأڬەأضتهأدتىًشأسثذأڬۏەأحہەأ؏أؼوشًأثىأوۏوًىألشوتحەأۄۏڽأ=أدىأهًڲًڽأىەأذزۏثۏۄأڬەأضتهأدتىًشأسثذأڬۏەأحہەأ؏أتىأڬًأتضأځشأؼوهأڬشىتأثۄحأزطًتشأحہتأۗأًۄألشوتحەأۄۏڽأ=أودہەأىۄۏڽأوؼهًوأڬۄأىثۏأتڬشوأ﷽أڬەأظذتثۄأشعۏأتههۄأؼىۄوأىەأؼوشۄأمعتؤأوۏڽأتىأمشثتىۏًڽأڬتأثزهأزۏتأحہتأۏتأىۄۏڽأآأدًأتىۄًڽأىەأذزۏثۏۄأڬەأضتهأسثذأڬۏأحہۏڽأۏۄتڽأحڬأڬۄأتثًذتعشأىەأتىأڬًأۏۄأذزۏخأضىتةۏأۗأ"
"1787","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأوڬۄأضەأڬۄتأ=أتەأطۄشأوڬۄأ$أحدہأضەأثڔہأڬشأڬًةۏأطۄشأودہەأصۏتزۄأؼصۏصأىۄۏڽأۄەأتًشأوۏڽأضثأضەأصۏتزۄأحدہأضەأوذثحأڬشحتأۄًڽأ؏أتڲشأحۏشەأثتطىزەأودہەأۄدشحأځشأودثًشأىۄأڬشحەأحًأوۏڽأحۏشەأضًتأڬضۏأطۄشأوۏڽأضڬًىحأترحۏتشأىۄۏڽأڬشحتأۗأ"
"1788","%أذعشحأؼثزتههۄأتثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أؼًشحًڽأڬًأذتهحٓأتذشتوأوۏڽأزضحتىەأځۄىىەأ؏أىمتثأڬشىەأتًشأتۏضەأڬځڔەأځۄىىەأضەأوىؼأڬۏتأدتةەأدضأڬًأًشضأ+أتۏڬأرتظأمضوأڬۏأڲہتضأ"
"1789","%أذعشحأؼتوشأثىأضؼزأثۏتىأڬشحەأۄۏڽأڬۄأذعشحأضؼزأثىأتثۏأًمتظأشعۏأتههۄأؼىۄأوزۏىۄأضەأثتۄشأىڬهأدتۏتأڬشحەأحہەأحًأڬضۏأهڬڔہتشەأڬًأزۏڬہحەأ؏أدضأڬەأځتضأحشًحتصۄأزشرحأۄًحتأدًأتضأىەأوزۏىۄأڬەأزشرحًڽأضەأڬتټتأۄًحتأۗأتڲشډۄأتضأڬًأډہۏهأهۏتأۄًحتأۗأتضأضهضهەأوۏڽأتڲشأًۄأڬًةۏأډًىأًأډشتأڬشحتأحًأإځألشوتحەأ=أوۏڽأتۏضۏأڬًةۏأډۏصأىۄۏڽأډہًڔًڽأڲتأدًأشضًهأتههۄأ﷽أىەأودہەأزۏأۄەأذتهتىڬۄأوۏڽأضثأضەأصۏتزۄأوتهزتشأۄًڽأۗأ"
"1790","%أذعشحأؼتوشأثىأضؼزأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأذعشحأضؼزأشعۏأتههۄأؼىۄأ+أومتوٓأؼمۏمأوۏڽأ"
"1791","%أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أثىۏأؼوشًأثىأؼًلأڬەأتۏڬأإزوۏأتًشأثىۏأرزشۄأڬەأتۏڬأإزوۏأڬەأزشوۏتىأتضأوضدزأڬەأثتشەأوۏڽأترحهتلأۄًأڲۏتأدضأڬۏأثىۏتزأحمًۏٳأځشأشڬہۏأڲةۏأۗأؼًلۏأطرظأىەأڬۄتأ=أتضأضەأوشتزأوضدزأمثتأۄەأتًشأرزشۏأىەأڬۄتأ=أًۄأوضدزأىثًۏأۄەأۗأۏۄأزًىًڽأىثۏأتڬشوأ﷽أڬەأځتضأځۏطأۄًأڲةەأتًشأإځأضەأتضأثتشەأوۏڽأزشۏتلحأڬۏتأحًأإځأ﷽أىەألشوتۏتأ=أًۄأوۏشۏأۏۄۏأوضدزأۄەأتًشأتضأوۏڽأثۄحأصۏتزۄأثہهتةۏأۄەأۗأ"
"1792","%أذعشحأتضۏزأثىأػۄۏشأتىظتشۏأشعۏأتههۄأؼىۄأضەأشًتۏحأۄەأڬۄأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أوضدزأمثتؤأوۏڽأىوتصأځڔہىتأؼوشەأڬەأثشتثشأخًتثأشڬہحتأۄەأۗأ"
"1793","%أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أشضًهأتههۄأ﷽أمثتؤأڬۏأغشلأدتحەأۄًةەأڬثہۏأځۏزهأډهتأڬشحەأتًشأڬثہۏأضًتشأۄًحەأۗأ"
