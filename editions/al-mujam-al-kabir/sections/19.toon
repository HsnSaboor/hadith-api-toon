hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"10801","10772  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  خَالِدُ بْنُ يُوسُفَ السَّمْتِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  رَاشِدِ بْنِ أَبِي نَجِيحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ عَلَى هَذَا الْمِنْبَرِ يُحَدِّثُ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقُولُ هَؤُلَاءِ الْكَلِمَاتِ عِنْدَ الْكَرْبِ :  لَا إِلَهَ إِلَّا اللهُ الْعَظِيمُ الْحَلِيمُ  ، لَا إِلَهَ إِلَّا اللهُ رَبُّ الْعَرْشِ الْعَظِيمِ ، لَا إِلَهَ إِلَّا اللهُ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ ، وَرَبُّ الْعَرْشِ الْعَظِيمِ ، اصْرِفْ عَنِّي شَرَّ فُلَانٍ  .","","Al-Mu'jam al-Kabir 10772","","عبد الله بن عباس عن عبد الله بن الحارث بن نوفل عن راشد بن نجيح الحماني عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن محمد بن صالح النرسي عن الطبراني","عبد الله بن الحارث عن ابن عباس"
"10802","[10/318]      مُحَمَّدُ بْنُ كَعْبٍ الْقُرَظِيُّ  عَنِ  ابْنِ عَبَّاسٍ  10773  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ ،  ثَنَا  يَحْيَى بْنُ صَالِحٍ الْوُحَاظِيُّ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْكِنْدِيُّ ،  ثَنَا  صَالِحُ بْنُ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا بَأْسَ أَنْ يُقَلِّبَ الرَّجُلُ الْجَارِيَةَ إِذَا أَرَادَ أَنْ يَشْتَرِيَهَا  ، مَا خَلَا  عَوْرَتَهَا  ؛ مَا بَيْنَ رُكْبَتَيَهَا إِلَى مَعْقِدِ  إِزَارِهَا  "" .  في طبعة مكتبة ابن تيمية والنسختين الخطيتين ( مقعد ) وكتب فوقه في إحدى النسخ خطية ( معقد ) وصحح عليها","","Al-Mu'jam al-Kabir 10773","","عبد الله بن عباس عن محمد بن كعب بن سليم القرظي عن صالح بن حسان النضري عن حفص بن عمر الكندي عن يحيى بن صالح الوحاظي عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","محمد بن كعب القرظي عن ابن عباس"
"10803","10774  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ الْمَوْصِلِيُّ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  ثَنَا  مُوسَى بْنُ خَلَفٍ الْعَمِّيُّ ،  عَنْ  أَبِي الْمِقْدَامِ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ  عِيسَى ابْنَ مَرْيَمَ  عَلَيْهِ السَّلَامُ قَالَ : إِنَّمَا الْأُمُورُ ثَلَاثَةٌ  : أَمْرٌ يَتَبَيَّنُ لَكَ رُشْدُهُ فَاتَّبِعْهُ ، وَأَمْرٌ يَتَبَيَّنُ لَكَ غَيُّهُ فَاجْتَنِبْهُ ، وَأَمْرٌ اخْتُلِفَ فِيهِ فَرُدَّهُ إِلَى عَالِمِهِ  "" .","","Al-Mu'jam al-Kabir 10774","","عبد الله بن عباس عن محمد بن كعب بن سليم القرظي عن هشام بن زياد بن أبي يزيد العثماني عن موسى بن خلف العمي عن المعافى بن عمران عن محمد بن عبد الله بن عمار الغامدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن كعب القرظي عن ابن عباس"
"10804","10775  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  عِيسَى بْنُ مَيْمُونٍ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ كَعْبٍ  يُحَدِّثُ ، عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمِنْبَرِ :  أَلَا أُنَبِّئُكُمْ بِشِرَارِكُمْ ؟  قَالُوا : بَلَى ، إِنْ شِئْتَ يَا رَسُولَ اللهِ ، قَالَ : "" فَإِنَّ شِرَارَكُمُ الَّذِي يَنْزِلُ وَحْدَهُ ، وَيَجْلِدُ عَبْدَهُ ، وَيَمْنَعُ رِفْدَهُ "" ، قَالَ : "" أَفَلَا أُنَبِّئُكُمْ بِشَرٍّ مِنْ ذَلِكُمْ ؟ "" قَالُوا : بَلَى إِنْ شِئْتَ يَا رَسُولَ اللهِ ، قَالَ : "" مَنْ يُبْغِضُ النَّاسَ وَيُبْغِضُونَهُ "" ، قَالَ : "" أَوَ أُنَبِّئُكُمْ بِشَرٍّ مِنْ ذَلِكُمْ ؟ "" قَالُوا : بَلَى إِنْ شِئْتَ يَا رَسُولَ اللهِ ، قَالَ : "" الَّذِينَ لَا يُقِيلُونَ  عَثْرَةً  ، وَلَا يَقْبَلُونَ مَعْذِرَةً ، وَلَا يَغْفِرُونَ ذَنْبًا "" ، قَالَ : "" أَفَلَا أُنَبِّئُكُمْ بِشَرٍّ مِنْ ذَلِكَ ؟ "" قَالُوا : بَلَى يَا رَسُولَ اللهِ ، قَالَ : "" مَنْ لَا يُرْجَى خَيْرُهُ ، وَلَا يُؤْمَنُ شَرُّهُ  "" .  في طبعة مكتبة ابن تيمية : ( يقبلون ) وهي على الصواب في النسخة الخطية","","Al-Mu'jam al-Kabir 10775","","عبد الله بن عباس عن محمد بن كعب بن سليم القرظي عن عيسى بن ميمون الواسطي عن شيبان بن فروخ الحبطي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","محمد بن كعب القرظي عن ابن عباس"
"10805","10776  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  مَسْرُوقُ بْنُ         [10/319]      الْمَرْزُبَانِ الْكِنْدِيُّ ،  ثَنَا  الْمُسَيِّبُ بْنُ شَرِيكٍ الْعَامِرِيُّ ،  عَنْ  عِيسَى بْنِ مَيْمُونٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ،  وَعَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ، قَالَا :  دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَسْجِدَ ، فَإِذَا أَصْوَاتٌ كَدَوِيِّ النَّحْلِ قِرَاءَةَ الْقُرْآنِ ، فَقَالَ :  إِنَّ الْإِسْلَامَ يَشِيعُ ، ثُمَّ تَكُونُ لَهُ  فَتْرَةٌ  ، فَمَنْ كَانَتْ فَتْرَتُهُ إِلَى غُلُوٍّ وَبِدْعَةٍ فَأُولَئِكَ أَهْلُ النَّارِ  "" .","","Al-Mu'jam al-Kabir 10776","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عيسى بن ميمون الواسطي عن المسيب بن شريك الشقري عن مسروق بن المرزبان الكندي عن محمد بن عثمان بن أبي شيبة عن الطبراني","محمد بن كعب القرظي عن ابن عباس"
"10806","10777  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  عِيسَى بْنِ مَيْمُونٍ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ كَعْبٍ الْقُرَظِيَّ  يُحَدِّثُ ، عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْخُلُقُ  الْحَسَنُ يُذِيبُ الْخَطَايَا كَمَا يُذِيبُ الْمَاءُ  الْجَلِيدَ  ،  وَالْخُلُقُ  السُّوءُ يُفْسِدُ الْعَمَلَ كَمَا يُفْسِدُ الْخَلُّ الْعَسَلَ  "" .","","Al-Mu'jam al-Kabir 10777","","عبد الله بن عباس عن محمد بن كعب بن سليم القرظي عن عيسى بن ميمون الواسطي عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","محمد بن كعب القرظي عن ابن عباس"
"10807","10778  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو ،  ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، قَالَا :  ثَنَا  عِيسَى بْنُ مَيْمُونٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا ذِئْبَانِ ضَارِيَانِ بَاتَا فِي غَنَمٍ  بِأَفْسَدَ لَهَا مِنْ حُبِّ ابْنِ آدَمَ الشَّرَفَ وَالْمَالَ  "" .","","Al-Mu'jam al-Kabir 10778","","عبد الله بن عباس عن محمد بن كعب بن سليم القرظي عن عيسى بن ميمون الواسطي عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","محمد بن كعب القرظي عن ابن عباس"
"10808","10779  -  حَدَّثَنَا  الْمُنْتَصِرُ بْنُ مُحَمَّدِ بْنِ الْمُنْتَصِرِ ،  ثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْحَضْرَمِيُّ ،  ثَنَا  سَعِيدُ بْنُ مُحَمَّدٍ الثَّقَفِيُّ الْوَرَّاقُ ،  ثَنَا  صَالِحُ بْنُ حَسَّانَ ،         [10/320]      عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا سَأَلْتُمْ بِاللهِ فَسَلُوهُ بِبُطُونِ أَكُفِّكُمْ  ، وَلَا تَسْأَلُوهُ بِظُهُورِهَا ، وَامْسَحُوا بِهَا وُجُوهَكُمْ  "" .","","Al-Mu'jam al-Kabir 10779","","عبد الله بن عباس عن محمد بن كعب بن سليم القرظي عن صالح بن حسان النضري عن سعيد بن محمد الوراق عن الحسن بن حماد سجادة عن منتصر بن محمد بن منتصر البغدادي عن الطبراني","محمد بن كعب القرظي عن ابن عباس"
"10809","10780  -  حَدَّثَنَا  الْمُنْتَصِرُ بْنُ مُحَمَّدِ بْنِ الْمُنْتَصِرِ ،  ثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  ثَنَا  سَعِيدُ بْنُ مُحَمَّدٍ الثَّقَفِيُّ ،  عَنْ  صَالِحِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِكُلِّ شَيْءٍ  خُلُقًا  ، وَإِنَّ  خُلُقَ  الْإِسْلَامِ الْحَيَاءُ  "" .","","Al-Mu'jam al-Kabir 10780","","عبد الله بن عباس عن محمد بن كعب بن سليم القرظي عن صالح بن حسان النضري عن سعيد بن محمد الوراق عن الحسن بن حماد سجادة عن منتصر بن محمد بن منتصر البغدادي عن الطبراني","محمد بن كعب القرظي عن ابن عباس"
"10810","10781  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  أَبُو صَالِحٍ الْحَرَّانِيُّ ،  ثَنَا  هِشَامُ بْنُ زِيَادٍ أَبُو الْمِقْدَامِ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِكُلِّ شَيْءٍ شَرَفًا  ، وَإِنَّ شَرَفَ الْمَجَالِسِ مَا اسْتُقْبِلَ بِهِ الْقِبْلَةُ ، وَمَنْ نَظَرَ فِي  كِتَابِ  أَخِيهِ مِنْ غَيْرِ أَمْرِهِ فَكَأَنَّمَا يَنْظُرُ فِي النَّارِ  "" .","","Al-Mu'jam al-Kabir 10781","","عبد الله بن عباس عن محمد بن كعب بن سليم القرظي عن هشام بن زياد بن أبي يزيد العثماني عن عبد الغفار بن داود الحراني عن أحمد بن محمد بن الحجاج المصري عن الطبراني","محمد بن كعب القرظي عن ابن عباس"
"10811","10782  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَتِ  الْمُتْعَةُ  فِي أَوَّلِ الْإِسْلَامِ  ، وَكَانُوا يَقْرَأُونَ هَذِهِ الْآيَةَ : ( فَمَا اسْتَمْتَعْتُمْ بِهِ مِنْهُنَّ إِلَى أَجَلٍ مُسَمًّى ) ، كَانَ الرَّجُلُ يَقْدَمُ الْبَلَدَ لَيْسَ لَهُ بِهِ مَعْرِفَةٌ ، فَيَتَزَوَّجُ بِقَدْرِ مَا يَرَى أَنَّهُ يَفْرُغُ مِنْ حَاجَتِهِ ؛ لِتَحْفَظَ مَتَاعَهُ ، وَتُصْلِحَ لَهُ شَأْنَهُ ، حَتَّى نَزَلَتْ هَذِهِ الْآيَةُ :         {      حُرِّمَتْ عَلَيْكُمْ أُمَّهَاتُكُمْ         }      إِلَى آخِرِ الْآيَةِ ، وَنُسِخَ الْأَجَلُ وَحُرِّمَتِ  الْمُتْعَةُ  ، وَتَصْدِيقُهَا فِي الْقُرْآنِ :         {      إِلا عَلَى أَزْوَاجِهِمْ أوْ مَا مَلَكَتْ أَيْمَانُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ         }      ، فَمَا سِوَى هَذَا الْفَرْجِ فَهُوَ حَرَامٌ  "" .","","Al-Mu'jam al-Kabir 10782","","عبد الله بن عباس عن محمد بن كعب بن سليم القرظي عن موسى بن عبيدة بن نشيط الحميري عن سفيان الثوري عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن كعب القرظي عن ابن عباس"
"10812","[10/321]      ذَكْوَانُ  عَنِ  ابْنِ عَبَّاسٍ  10783  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ ،  حَدَّثَنِي  ابْنُ أَبِي مُلَيْكَةَ ،  أَنَّهُ حَدَّثَهُ  ذَكْوَانُ حَاجِبُ عَائِشَةَ  قَالَ  :  جَاءَ عَبْدُ اللهِ بْنُ عَبَّاسٍ يَسْتَأْذِنُ عَلَى  عَائِشَةَ  ، فَجِئْتُ وَعِنْدَ رَأْسِهَا ابْنُ أَخِيهَا  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  ، فَقُلْتُ : هَذَا  ابْنُ عَبَّاسٍ  يَسْتَأْذِنُ ، فَأَكَبَّ عَلَيْهَا ابْنُ أَخِيهَا  عَبْدُ اللهِ  فَقَالَ : هَذَا  ابْنُ عَبَّاسٍ  يَسْتَأْذِنُ ، فَقَالَتْ : دَعْنِي مِنِ  ابْنِ عَبَّاسٍ  ؛ فَإِنَّهُ لَا حَاجَةَ لِي بِهِ ، فَقَالَ : يَا أُمَّتَاهُ ، إِنَّ  ابْنَ عَبَّاسٍ  مِنْ صَالِحِي بَنِيكِ يُسَلِّمُ وَيُوَدِّعُكِ ، قَالَتِ : ائْذَنْ لَهُ إِنْ شِئْتَ ، فَأَدْخَلْتُهُ ، فَلَمَّا جَلَسَ قَالَ : أَبْشِرِي ، فَقَالَتْ : أَيْضًا ، فَقَالَ : مَا بَيْنَكِ وَبَيْنَ أَنْ تَلْحَقِي  مُحَمَّدًا  إِلَّا أَنْ تَخْرُجَ الرُّوحُ مِنَ الْجَسَدِ ، كُنْتِ أَحَبَّ نِسَاءِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَمْ يَكُنْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُحِبُّ إِلَّا طَيِّبًا ، وَسَقَطَتْ قِلَادَتُكِ لَيْلَةَ  الْأَبْوَاءِ  ، فَأَصْبَحَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى يُصْبِحَ فِي الْمَنْزِلِ ، وَأَصْبَحَ النَّاسُ لَيْسَ مَعَهُمْ مَاءٌ ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ أَنْ :         {      فَتَيَمَّمُوا صَعِيدًا طَيِّبًا         }      ، وَكَانَ ذَلِكَ فِي سَبَبِكِ وَمَا أَنْزَلَ اللهُ لِهَذِهِ الْأُمَّةِ مِنَ الرُّخْصَةِ ، وَأَنْزَلَ اللهُ تَعَالَى بَرَاءَتَكِ مِنْ فَوْقِ سَبْعِ سَمَاوَاتٍ ، جَاءَ بِهَا الرُّوحُ الْأَمِينُ ، فَأَصْبَحَ وَلَيْسَ مَسْجِدٌ مِنْ مَسَاجِدِ اللهِ يَذْكُرُ اللهَ إِلَّا هِيَ تُتْلَى فِيهِ آنَاءَ اللَّيْلِ وَآنَاءَ النَّهَارِ  ، فَقَالَتْ : دَعْنِي مِنْكَ يَا  ابْنَ عَبَّاسٍ  ، فَوَالَّذِي نَفْسِي بِيَدِهِ ، لَوَدِدْتُ أَنِّي كُنْتُ  نَسْيًا  مَنْسِيًّا  .","","Al-Mu'jam al-Kabir 10783","","عبد الله بن عباس عن ذكوان مولى عائشة بنت أبي بكر عن ابن أبي مليكة عن عبد الله بن عثمان بن خثيم عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","ذكوان عن ابن عباس"
"10813","[10/322]      أَبُو غَطَفَانَ  عَنِ  ابْنِ عَبَّاسٍ  10784  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  وَكِيعٌ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  قَارِظِ بْنِ شَيْبَةَ ،  عَنْ  أَبِي غَطَفَانَ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اسْتَنْشِقُوا مَرَّتَيْنِ  ، وَالْأُذُنَانِ مِنَ الرَّأْسِ  "" .","","Al-Mu'jam al-Kabir 10784","","عبد الله بن عباس عن أبو غطفان المري عن قارظ بن شيبة الليثي عن محمد بن عبد الرحمن بن المغيرة عن وكيع بن الجراح عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو غطفان عن ابن عباس"
"10814","10785  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، وَأَحْمَدُ بْنُ رِشْدِينَ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ أُمَيَّةَ ،  أَنَّهُ سَمِعَ  أَبَا غَطَفَانَ بْنَ طَرِيفٍ الْمُرِّيَّ يَقُولُ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  صَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ عَاشُورَاءَ ، وَأَمَرَ بِصِيَامِهِ ، فَقَالُوا : يَا رَسُولَ اللهِ ، يَوْمًا يُعَظِّمُهُ الْيَهُودُ وَالنَّصَارَى ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا كَانَ عَامُ الْمُقْبِلِ إِنْ شَاءَ اللهُ صُمْنَا التَّاسِعَ  ، فَلَمْ يَأْتِ عَامُ الْمُقْبِلِ حَتَّى تُوُفِّيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 10785","","عبد الله بن عباس عن أبو غطفان المري عن إسماعيل بن أمية الأموي عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أبو غطفان عن ابن عباس"
"10815","سَعِيدُ بْنُ أَبِي هِنْدٍ  عَنِ  ابْنِ عَبَّاسٍ  10786  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَعِيدِ بْنِ أَبِي هِنْدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الصِّحَّةَ وَالْفَرَاغَ نِعْمَتَانِ مَغْبُونٌ فِيهِمَا         [10/323]      كَثِيرٌ مِنَ النَّاسِ  "" .","","Al-Mu'jam al-Kabir 10786","","عبد الله بن عباس عن سعيد بن أبي هند الفزاري عن عبد الله بن سعيد بن أبي هند الفزاري عن إسماعيل بن جعفر بن أبي كثير الزرقي عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","سعيد بن أبي هند عن ابن عباس"
"10816","10787  -  حَدَّثَنَا  أَبُو يَزِيدَ ،  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدِ بْنِ أَبِي هِنْدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 10787","","عبد الله بن عباس عن سعيد بن أبي هند الفزاري عن عبد الله بن سعيد بن أبي هند الفزاري عن إسماعيل بن جعفر بن أبي كثير الزرقي عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","سعيد بن أبي هند عن ابن عباس"
"10817","مُحَمَّدُ بْنُ عَمْرِو بْنِ عَطَاءٍ  عَنِ  ابْنِ عَبَّاسٍ  10788  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الْعِيدَيْنِ  فِي الرَّكْعَةِ الْأُولَى بِفَاتِحَةِ الْكِتَابِ وَ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ، وَفِي الْآخِرَةِ بِفَاتِحَةِ الْكِتَابِ وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      .","","Al-Mu'jam al-Kabir 10788","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن موسى بن عبيدة بن نشيط الحميري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10818","10789  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  عُثْمَانُ بْنُ مُسْلِمٍ ،  ثَنَا  وُهَيْبٌ ، (  ح  )  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عُمَرُ بْنُ عَلِيٍّ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  أَبِي  (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ ، قَالَا :  ثَنَا  يَحْيَى         [10/324]      الْحِمَّانِيُّ ،  ثَنَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يَحْيَى بْنُ عُثْمَانَ الْحَرَّانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ، كُلُّهُمْ  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكَلَ كَتِفًا ثُمَّ صَلَّى وَلَمْ يَمَسَّ مَاءً  ،  وَاللَّفْظُ لِحَدِيثِ  يَحْيَى الْقَطَّانِ  .","","Al-Mu'jam al-Kabir 10789","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن وهب بن كيسان القرشي عن هشام بن عروة بن الزبير عن إسماعيل بن عياش الأحول عن يحيى بن عثمان الحراني عن الحسين بن إسحاق التستري عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10819","10790  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، وَعَبْدَانُ ، قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكَلَ كَتِفًا وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 10790","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن وهب بن كيسان القرشي عن أيوب السختياني عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن عبد الله بن أحمد الجواليقي عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10820","10791  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ حَلْحَلَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَدْ تَوَضَّأَ ، ثُمَّ خَرَجَ إِلَى الصَّلَاةِ  فَأُتِيَ بِصَحْفَةٍ فِيهَا لَحْمٌ وَخُبْزٌ ، فَأَكَلَ مِنْهَا وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 10791","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن محمد بن عمرو بن حلحلة الديلي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10821","10792  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ  قَالَ  :  دَخَلْتُ بَيْتَ  مَيْمُونَةَ  زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَوَجَدْتُ فِيهِ  عَبْدَ اللهِ بْنَ عَبَّاسٍ  ، فَتَذَاكَرْنَا الْوُضُوءَ مِمَّا مَسَّتِ النَّارُ ، فَقَالَ ابْنُ عَبَّاسٍ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْكُلُ مِمَّا مَسَّتِ النَّارُ  ، ثُمَّ يُصَلِّي وَلَا يَتَوَضَّأُ ، فَقُلْنَا : أَنْتَ رَأَيْتَهُ ؟ فَأَشَارَ إِلَى عَيْنَيْهِ فَقَالَ :  بَصُرَ  عَيْنِي  .","","Al-Mu'jam al-Kabir 10792","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن الحكم الجمحي عن يوسف بن يزيد القراطيسي عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10822","10793  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ،  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  وُهَيْبٌ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكَلَ مِنْ كَتِفٍ ، ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 10793","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن موسى بن عقبة عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10823","10794  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا         [10/325]      جُنَادَةُ بْنُ سَلْمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَمْرٍو  ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكَلَ  كَتِفًا أَوْ ذِرَاعًا  ، ثُمَّ صَلَّى بِالنَّاسِ وَلَمْ يَتَوَضَّأْ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبيد الله بن عمر).","","Al-Mu'jam al-Kabir 10794","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10824","10795  -  حَدَّثَنَا  مُحَمَّدُ بْنُ السَّرِيِّ بْنِ مِهْرَانَ النَّاقِدُ الْبَغْدَادِيُّ ، وَمُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عَنْبَسَةُ بْنُ عَبْدِ الْوَاحِدِ ،  عَنْ  أَيُّوبَ بْنِ عُتْبَةَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  حَجَّةِ الْوَدَاعِ  ، أُتِيَ  بِعَرْقٍ  وَهُوَ يَطُوفُ  بِالْبَيْتِ  يَوْمَ النَّحْرِ  ، فَانْتَهَسَ مِنْهُ ، ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  "" .","","Al-Mu'jam al-Kabir 10795","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن يحيى بن أبي كثير عن أيوب بن عتبة اليمامي عن عنبسة بن عبد الواحد عن عبد الله بن عمر مشكدانة عن محمد بن عثمان بن أبي شيبة عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10825","10796  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ السَّامِيُّ الْكُوفِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنِ  الْوَلِيدِ بْنِ كَثِيرٍ قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ عَمْرِو بْنِ عَطَاءٍ قَالَ :  كُنْتُ مَعَ ابْنِ عَبَّاسٍ فَقَالَ :  إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ إِلَى الصَّلَاةِ ، فَلَقِيَتْهُ هَدِيَّةٌ  ؛ عُضْوًا مِنْ شَاةٍ ، فَأَكَلَ مِنْهَا لُقْمَةً أَوْ لُقْمَتَيْنِ ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 10796","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن الوليد بن كثير المخزومي عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن ابن الرواس جعفر بن أحمد بن عاصم عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10826","10797  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 10797","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن محمد بن إسحاق عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10827","10798  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ حَلْحَلَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَكَلَ مِنْ خُضَرِكُمْ هَذِهِ شَيْئًا فَلَا يَقْرَبَنَّ مَسْجِدَنَا  ؛ فَإِنَّ الْمَلَائِكَةَ يَتَأَذَّى مِمَّا يَتَأَذَّى مِنْهُ بَنُو آدَمَ  .","","Al-Mu'jam al-Kabir 10798","","عبد الله بن عباس عن محمد بن عمرو بن عطاء العامري عن محمد بن عمرو بن حلحلة الديلي عن عبد الله بن جعفر بن نجيح عن داود بن رشيد الخوارزمي عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن عمرو بن عطاء عن ابن عباس"
"10828","[10/326]      صَالِحٌ مَوْلَى التَّوْأَمَةِ  عَنِ  ابْنِ عَبَّاسٍ  10799  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  صَالِحٍ مَوْلَى التَّوْأَمَةِ ،  سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ :  غُسِّلَ رَسُولُ اللهِ فِي قَمِيصٍ ، وَنَزَلَ فِي حُفْرَتِهِ  عَلِيٌّ  ،  وَالْفَضْلُ بْنُ عَبَّاسٍ  ،  وَصَالِحُ بْنُ عَبَّاسٍ  ،  وَصَالِحُ بْنُ شُقْرَانَ مَوْلَى رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 10799","","عبد الله بن عباس عن صالح بن نبهان الجمحي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","صالح مولى التوأمة عن ابن عباس"
"10829","10800  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ،  ثَنَا  زَيْدُ بْنُ الْمُبَارَكِ ،  ثَنَا  مُحَمَّدُ بْنُ ثَوْرٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  صَالِحٍ مَوْلَى التَّوْأَمَةِ ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ :  طَافَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى رَاحِلَتِهِ فِي  حَجَّةِ الْوَدَاعِ  ،  فَاسْتَلَمَ  الرُّكْنَ  بِمِحْجَنِهِ  ؛ كَرَاهِيَةَ أَنْ  يَصُدَّ  النَّاسَ عَنْهُ  "" .","","Al-Mu'jam al-Kabir 10800","","عبد الله بن عباس عن صالح بن نبهان الجمحي عن ابن جريج عن محمد بن ثور الصنعاني عن زيد بن المبارك الصنعاني عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","صالح مولى التوأمة عن ابن عباس"
"10830","10801  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَعِيدُ بْنُ سَالِمٍ الْقَدَّاحُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  صَالِحٍ مَوْلَى التَّوْأَمَةِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ طَافَ فِي  حَجَّةِ الْوَدَاعِ  عَلَى نَاقَتِهِ  الْقَصْوَاءِ  .","","Al-Mu'jam al-Kabir 10801","","عبد الله بن عباس عن صالح بن نبهان الجمحي عن ابن جريج عن سعيد بن سالم القداح عن محمد بن سلم الرازي عن محمد بن علي بن زيد الصائغ عن الطبراني","صالح مولى التوأمة عن ابن عباس"
"10831","10802  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَالِكٍ الضَّبِّيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  صَالِحُ بْنُ مِسْمَارٍ ،  ثَنَا  هِشَامُ بْنُ سُلَيْمَانَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  صَالِحُ بْنُ أَبِي صَالِحٍ ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ قَالَ :  مَرَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِامْرَأَةٍ  بِهَا جُنُونٌ فَقَالَ :  أَيُّهُمَا أَحَبُّ إِلَيْكِ ؟ أَتَبْرَئِينَ مِنْ هَذَا أَحَبُّ إِلَيْكِ أَوْ تَصْبِرِينَ وَلَكِ الْجَنَّةُ  ؟ "" قَالَتْ : لِيَ الْجَنَّةُ  .","","Al-Mu'jam al-Kabir 10802","","عبد الله بن عباس عن صالح بن نبهان الجمحي عن ابن جريج عن هشام بن سليمان بن عكرمة عن صالح بن مسمار الكشميهني عن محمد بن يحيى  بن مالك الأصبهاني عن الطبراني","صالح مولى التوأمة عن ابن عباس"
"10832","10803  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ، (  ح  )  وَحَدَّثَنَا  عَلِيٌّ ،  ثَنَا  الْقَعْنَبِيُّ ، كِلَاهُمَا  عَنْ  دَاوُدَ بْنِ قَيْسٍ ،  عَنْ  صَالِحٍ مَوْلَى         [10/327]      التَّوْأَمَةِ ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ :  جَمَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ الظُّهْرِ وَالْعَصْرِ ، وَالْمَغْرِبِ وَالْعِشَاءِ  بِالْمَدِينَةِ  مِنْ غَيْرِ خَوْفٍ وَلَا مَطَرٍ ، قَالَ : قُلْتُ  لِابْنِ عَبَّاسٍ  : لِمَ تُرَاهُ فَعَلَ ذَلِكَ ؟ قَالَ : أَرَادَ التَّوْسِعَةَ عَلَى أُمَّتِهِ  .","","Al-Mu'jam al-Kabir 10803","","عبد الله بن عباس عن صالح بن نبهان الجمحي عن داود بن قيس الدباغ عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","صالح مولى التوأمة عن ابن عباس"
"10833","10804  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُغِيرَةِ ،  ثَنَا  النُّعْمَانُ بْنُ عَبْدِ السَّلَامِ ،  عَنْ  سُفْيَانَ ،  عَنْ  دَاوُدَ بْنِ قَيْسٍ ،  عَنْ  صَالِحٍ مَوْلَى التَّوْأَمَةِ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 10804","","عبد الله بن عباس عن صالح بن نبهان الجمحي عن داود بن قيس الدباغ عن سفيان الثوري عن النعمان بن عبد السلام عن محمد بن المغيرة ابن أبي مريم الأصبهاني عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","صالح مولى التوأمة عن ابن عباس"
"10834","10805  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ،  ثَنَا  آدَمُ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسٍ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالَا :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  صَالِحٍ مَوْلَى التَّوْأَمَةِ ،  أَنَّ  أُمَّ الْفَضْلِ  أَرْسَلَتْ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِلَبَنٍ  ، فَشَرِبَ وَهُوَ يَخْطُبُ النَّاسَ  بِعَرَفَةَ  .","","Al-Mu'jam al-Kabir 10805","","صالح بن نبهان الجمحي عن محمد بن عبد الرحمن بن المغيرة عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","صالح مولى التوأمة عن ابن عباس"
"10835","10806  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ النَّسَائِيُّ الْبَغْدَادِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  يُوسُفُ بْنُ خَالِدٍ السَّمْتِيُّ ،  ثَنَا  زِيَادُ بْنُ سَعْدٍ ،  عَنْ  صَالِحٍ مَوْلَى التَّوْأَمَةِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ كَانَ لَا يَرَى بِالْهِمْيَانِ لِلْمُحْرِمِ بَأْسًا  . وَرَوَى ذَلِكَ  ابْنُ عَبَّاسٍ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 10806","","عبد الله بن عباس عن صالح بن نبهان الجمحي عن زياد بن سعد الخراساني عن يوسف بن خالد السمتي عن عبيد الله بن عمر القواريري عن محمد بن على بن العباس النسائي عن الطبراني","صالح مولى التوأمة عن ابن عباس"
"10836","10807  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِسْحَاقَ الْجَوْهَرِيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  زِيَادٌ ، أَنَّ صَالِحًا مَوْلَى التَّوْأَمَةِ  أَخْبَرَهُ  ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يُحَدِّثُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ لِلرَّحِمِ  حُجْنَةً  آخِذَةً  بِحُجْزَةِ  الرَّحْمَنِ  ، تَصِلُ مَنْ وَصَلَهَا ، وَتَقْطَعُ مَنْ قَطَعَهَا  .         [10/328]","","Al-Mu'jam al-Kabir 10807","","عبد الله بن عباس عن صالح بن نبهان الجمحي عن زياد بن سعد الخراساني عن ابن جريج عن أبو عاصم النبيل عن عبد الله بن إسحاق الجوهري عن محمد بن صالح النرسي عن الطبراني","صالح مولى التوأمة عن ابن عباس"
"10837","10808  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْبَكْرِيُّ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  صَالِحٍ مَوْلَى التَّوْأَمَةِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَوَّلُ مَنْ غَيَّرَ دِينَ  إِبْرَاهِيمَ  عَلَيْهِ السَّلَامُ  عَمْرُو بْنُ لُحَيِّ بْنِ قَمَعَةَ بْنِ خِنْدِفَ أَبُو خُزَاعَةَ  .","","Al-Mu'jam al-Kabir 10808","","عبد الله بن عباس عن صالح بن نبهان الجمحي عن محمد بن عبد الرحمن بن المغيرة عن عبد الله بن يزيد البكري عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","صالح مولى التوأمة عن ابن عباس"
"10838","طَلْحَةُ بْنُ عَبْدِ اللهِ بْنِ عَوْفٍ  عَنِ  ابْنِ عَبَّاسٍ  10809  -  حَدَّثَنَا  الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  طَلْحَةَ بْنِ عَبْدِ اللهِ بْنِ عَوْفٍ  قَالَ  :  صَلَّيْتُ مَعَ ابْنِ عَبَّاسٍ عَلَى جِنَازَةٍ ، فَقَرَأَ فَاتِحَةَ الْكِتَابِ  ، فَقُلْتُ لَهُ ، فَقَالَ : إِنَّهُ مِنَ السُّنَّةِ  .","","Al-Mu'jam al-Kabir 10809","","عبد الله بن عباس عن طلحة الندى  ، طلحة بن عبد الله بن عوف عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طلحة بن عبد الله بن عوف عن ابن عباس"
"10839","أَبُو الْحُوَيْرِثِ  عَنِ  ابْنِ عَبَّاسٍ  10810  -  حَدَّثَنَا  إِسْحَاقُ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الْحُوَيْرِثِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَاتَ وَهُوَ ابْنُ خَمْسٍ وَسِتِّينَ ،  وَأَبُو بَكْرٍ  وَهُوَ بِمَنْزِلَتِهِ  ،  وَعُمَرُ بْنُ الْخَطَّابِ  ابْنُ سِتٍّ وَخَمْسِينَ ،  وَعُثْمَانُ  ابْنُ إِحْدَى وَثَمَانِينَ  .  كذا في طبعة ابن تيمية ، والصواب :( بن الحويرث ) .","","Al-Mu'jam al-Kabir 10810","","عبد الله بن عباس عن سعيد بن الحويرث المكي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو الحويرث عن ابن عباس"
"10840","10811  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي نُعَيْمٍ         [10/329]      الْوَاسِطِيُّ ،  ثَنَا  هُشَيْمٌ ،  حَدَّثَنِي  الْمَدِينِيُّ ،  عَنْ  أَبِي الْحُوَيْرِثِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  إِذَا كَانَتِ الْأَرْضُ مُخْصِبَةً ، فَتَقَصَّدُوا فِي السَّيْرِ  ، وَأَعْطُوا الرِّكَابَ حَقَّهَا ؛ فَإِنَّ اللهَ تَعَالَى رَفِيقٌ يُحِبُّ  الرِّفْقَ  ، وَإِنْ كَانَتْ مُجْدِبَةً فَانْجُوا ، وَعَلَيْكُمْ  بِالدُّلْجَةِ  ؛ فَإِنَّ الْأَرْضَ  تُطْوَى  بِاللَّيْلِ ، وَإِيَّاكُمْ وَالتَّعْرِيسَ عَلَى ظَهْرِ الطَّرِيقِ ؛ فَإِنَّهُ مَأْوَى الْحَيَّاتِ ، وَمَدْرَجَةُ  السِّبَاعِ  ""  .","","Al-Mu'jam al-Kabir 10811","","عبد الله بن عباس عن عبد الرحمن بن معاوية النوفلي عن المديني عن هشيم بن بشير عن محمد بن موسى بن أبي نعيم الهذلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الحويرث عن ابن عباس"
"10841","10812  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي نُعَيْمٍ الْوَاسِطِيُّ ،  ثَنَا  هُشَيْمٌ ،  ثَنَا  الْمَدِينِيُّ ،  عَنْ  أَبِي الْحُوَيْرِثِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا وَلَدَنِي مِنْ  سِفَاحِ  أَهْلِ الْجَاهِلِيَّةِ شَيْءٌ  ، وَمَا وَلَدَنِي إِلَّا نِكَاحٌ كَنِكَاحِ الْإِسْلَامِ  .  قَالَ أَبُو الْقَاسِمِ :  الْمَدِينِيُّ  هُوَ عِنْدِي  فُلَيْحُ بْنُ سُلَيْمَانَ  .","","Al-Mu'jam al-Kabir 10812","","عبد الله بن عباس عن عبد الرحمن بن معاوية النوفلي عن فليح بن سليمان عن هشيم بن بشير عن محمد بن موسى بن أبي نعيم الهذلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الحويرث عن ابن عباس"
"10842","أَبُو حَسَنٍ مَوْلَى بَنِي نَوْفَلٍ  عَنِ  ابْنِ عَبَّاسٍ  10813  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  شَيْبَانُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عُمَرَ بْنِ مُعَتِّبٍ ، أَنَّ أَبَا حَسَنٍ مَوْلَى بَنِي نَوْفَلٍ  أَخْبَرَهُ  ،  أَنَّهُ اسْتَفْتَى ابْنَ عَبَّاسٍ فِي مَمْلُوكٍ كَانَتْ تَحْتَهُ مَمْلُوكَةٌ ، فَطَلَّقَهَا تَطْلِيقَتَيْنِ  ، ثُمَّ إِنَّهُمَا أُعْتِقَا بَعْدَ ذَلِكَ ، هَلْ يَصْلُحُ لِلرَّجُلِ أَنْ يَخْطُبَهَا ؟  فَقَالَ  ابْنُ عَبَّاسٍ  : نَعَمْ ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى بِذَلِكَ  .","","Al-Mu'jam al-Kabir 10813","","عبد الله بن عباس عن أبو الحسن النوفلي عن عمر بن معتب المدني عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو حسن مولى بني نوفل عن ابن عباس"
"10843","10814  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عُمَرَ بْنِ مُعَتِّبٍ ،  عَنِ  الْحَسَنِ مَوْلَى بَنِي نَوْفَلٍ  قَالَ :  سُئِلَ  ابْنُ عَبَّاسٍ عَنْ عَبْدٍ طَلَّقَ امْرَأَةً تَطْلِيقَتَيْنِ ، ثُمَّ عَتَقَا أَيَتَزَوَّجُهَا  ؟ قَالَ :         [10/330]      نَعَمْ . قِيلَ : عَنْ مَنْ ؟ قَالَ : أَفْتَى بِذَلِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( أبي الحسن مولى بني نوفل) كما في مصادر التخريج .","","Al-Mu'jam al-Kabir 10814","","عبد الله بن عباس عن أبو الحسن النوفلي عن عمر بن معتب المدني عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو حسن مولى بني نوفل عن ابن عباس"
"10844","10815  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  ثَنَا  يَحْيَى بْنُ صَالِحٍ الْوُحَاظِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ سَلَّامٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عُمَرَ بْنِ مُعَتِّبٍ ، أَنَّ أَبَا حَسَنٍ مَوْلَى بَنِي نَوْفَلٍ  أَخْبَرَهُ  ،  أَنَّهُ اسْتَفْتَى ابْنَ عَبَّاسٍ فِي رَجُلٍ مَمْلُوكٍ كَانَتْ تَحْتَهُ مَمْلُوكَةٌ ، فَطَلَّقَهَا تَطْلِيقَتَيْنِ  فَبَانَتْ  ، ثُمَّ إِنَّهُمَا عَتَقَا بَعْدَ ذَلِكَ ، هَلْ يَصْلُحُ لِلرَّجُلِ أَنْ يَخْطُبَهَا  ؟  فَقَالَ  ابْنُ عَبَّاسٍ  : نَعَمْ ، قَضَى بِذَلِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 10815","","عبد الله بن عباس عن أبو الحسن النوفلي عن عمر بن معتب المدني عن يحيى بن أبي كثير عن معاوية بن سلام عن يحيى بن صالح الوحاظي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","أبو حسن مولى بني نوفل عن ابن عباس"
"10845","عَبْدُ اللهِ بْنُ مَعْبَدٍ  عَنِ  ابْنِ عَبَّاسٍ  10816  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عُمَرُ بْنُ عُثْمَانَ ابْنُ أَخِي عَلِيِّ بْنِ عَاصِمٍ ،  ثَنَا  أَبُو تُمَيْلَةَ يَحْيَى بْنُ وَاضِحٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَعْبَدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الرَّكْعَتَيْنِ قَبْلَ الصُّبْحِ  فِي الرَّكْعَةِ الْأُولَى بِفَاتِحَةِ الْكِتَابِ وَبِآيَتَيْنِ مِنْ آخِرِ الْبَقَرَةِ :         {      آمَنَ الرَّسُولُ بِمَا أُنْـزِلَ إِلَيْهِ مِنْ رَبِّهِ         }      ، وَفِي الرَّكْعَةِ الثَّانِيَةِ بِفَاتِحَةِ الْكِتَابِ وَبِآيَةٍ مِنْ آلِ عِمْرَانَ :         {      قُلْ يَا أَهْلَ الْكِتَابِ تَعَالَوْا إِلَى كَلِمَةٍ سَوَاءٍ بَيْنَنَا وَبَيْنَكُم         }      إِلَى آخِرِ الْآيَةِ  .","","Al-Mu'jam al-Kabir 10816","","عبد الله بن عباس عن عبد الله بن معبد بن العباس بن عبد المطلب عن محمد بن إسحاق عن يحيى بن واضح الأنصاري عن عمر بن عثمان بن عاصم القرشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن معبد عن ابن عباس"
"10846","عَبْدُ اللهِ بْنُ عُمَيْرٍ  عَنِ  ابْنِ عَبَّاسٍ  10817  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ ، وَمُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبَّاسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ عِشْتُ         [10/331]      إِنْ شَاءَ اللهُ إِلَى قَابِلٍ صُمْتُ التَّاسِعَ ؛ مَخَافَةَ أَنْ يَفُوتَنِي يَوْمُ عَاشُورَاءَ  .","","Al-Mu'jam al-Kabir 10817","","عبد الله بن عباس عن عبد الله بن عمير العباسي عن القاسم بن العباس اللهبي عن محمد بن عبد الرحمن بن المغيرة عن أحمد بن عبد الله اليربوعي عن لحية الليف محمد بن العباس عن الطبراني","عبد الله بن عمير عن ابن عباس"
"10847","كِنَانَةُ  عَنِ  ابْنِ عَبَّاسٍ  10818  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  هِشَامِ بْنِ إِسْحَاقَ بْنِ  عَبْدِ اللهِ بْنِ كِنَانَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَرْسَلَنِي  أَمِيرٌ مِنَ الْأُمَرَاءِ  إِلَى ابْنِ عَبَّاسٍ أَسْأَلُهُ عَنِ الِاسْتِسْقَاءِ ، قَالَ : مَنْ أَرْسَلَكَ ؟ قُلْتُ : فُلَانٌ ، قَالَ : وَمَا مَنَعَهُ أَنْ يَأْتِيَنِي فَيَسْأَلَنِي ؟  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُتَوَاضِعًا  مُتَضَرِّعًا  مُبْتَذِلًا  ، فَلَمْ يَخْطُبْ خُطْبَتَكُمْ هَذِهِ ، وَصَلَّى رَكْعَتَيْنِ كَمَا يُصَلِّي فِي الْعِيدِ  .  في طبعة مكتبة ابن تيمية : (عن) والمثبت من نسخة الظاهرية (1) ، وهو في أصل النسخة : (عن) وكتب أمامه في الهامش : (بن) وصحح عليه ، والله أعلم .","","Al-Mu'jam al-Kabir 10818","","عبد الله بن عباس عن إسحاق بن عبد الله بن الحارث بن كنانة العامري عن هشام بن إسحاق بن عبد الله القرشي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","كنانة عن ابن عباس"
"10848","10819  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ رَبِيعَةَ بْنِ هِشَامِ بْنِ إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ كِنَانَةَ مِنْ بَنِي عَامِرِ بْنِ لُؤَيٍّ ،  أَنَّهُ سَمِعَ  جَدَّهُ هِشَامَ بْنَ إِسْحَاقَ بْنَ عَبْدِ اللهِ  يُحَدِّثُ ، عَنْ  أَبِيهِ إِسْحَاقَ بْنِ عَبْدِ اللهِ  ،  أَنَّ  الْوَلِيدَ بْنَ عُتْبَةَ  أَرْسَلَهُ إِلَى عَبْدِ اللهِ بْنِ عَبَّاسٍ فَقَالَ :  يَا ابْنَ أَخِي ، سَلْهُ كَيْفَ صَنَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الِاسْتِسْقَاءِ يَوْمَ اسْتَسْقَى بِالنَّاسِ ؟ قَالَ  إِسْحَاقُ  : فَدَخَلْتُ عَلَى  ابْنِ عَبَّاسٍ  فَقُلْتُ : يَا  أَبَا عَبَّاسٍ  ، كَيْفَ صَنَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الِاسْتِسْقَاءِ يَوْمَ اسْتَسْقَى بِالنَّاسِ ؟ قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُتَخَشِّعًا مُبْتَذِلًا  ، فَصَنَعَ فِيهِ كَمَا صَنَعَ فِي الْفِطْرِ وَالْأَضْحَى  .","","Al-Mu'jam al-Kabir 10819","","عبد الله بن عباس عن إسحاق بن عبد الله بن الحارث بن كنانة العامري عن هشام بن إسحاق بن عبد الله القرشي عن إسماعيل بن ربيعة بن هشام بن إسحاق عن عبد الله بن يوسف التنيسي عن يحيى بن عثمان بن صالح عن الطبراني","كنانة عن ابن عباس"
"10849","إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ الشَّيْبَانِيُّ  عَنِ  ابْنِ عَبَّاسٍ  10820  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  جَرِيرٌ ،         [10/332]      عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ طَلْحَةَ بْنِ يَزِيدَ بْنِ رُكَانَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ الشَّيْبَانِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ بِيَهُودِيٍّ وَيَهُودِيَّةٍ قَدْ أُحْصِنَا  ، فَسَأَلُوهُ أَنْ يَحْكُمَ فِيهِمَا بِالرَّجْمِ ، فَرَجَمَهُمَا فِي فِنَاءِ الْمَسْجِدِ  .","","Al-Mu'jam al-Kabir 10820","","عبد الله بن عباس عن إبراهيم بن إسماعيل السلمي عن محمد بن طلحة بن يزيد بن ركانة الحجازي عن محمد بن إسحاق عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","إسماعيل بن إبراهيم الشيباني عن ابن عباس"
"10850","يَعْقُوبُ بْنُ خَالِدٍ  عَنِ  ابْنِ عَبَّاسٍ  10821  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ ،  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الْهَادِ ،  عَنْ  إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ ،  عَنْ  يَعْقُوبَ بْنِ خَالِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْوُضُوءُ مَرَّةٌ مَرَّةٌ  .","","Al-Mu'jam al-Kabir 10821","","عبد الله بن عباس عن يعقوب بن خالد بن المسيب المخزومي عن إبراهيم بن إسماعيل السلمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","يعقوب بن خالد عن ابن عباس"
"10851","نَاعِمٌ مَوْلَى أُمِّ سَلَمَةَ  عَنِ  ابْنِ عَبَّاسٍ  10822  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ، أَنَّ نَاعِمًا أَبَا عَبْدِ اللهِ مَوْلَى أُمِّ سَلَمَةَ  حَدَّثَهُ  ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ :  رَأَى رَسُولُ اللهِ حِمَارًا مَوْسُومَ الْوَجْهِ ، فَأَنْكَرَ ذَلِكَ  ، فَقَالَ  الرَّجُلُ  : فَوَاللهِ لَا  أَسِمُهُ  إِلَّا أَقْصَى شَيْءٍ مِنَ الْوَجْهِ ، فَأَمَرَ بِحِمَارٍ لَهُ فَكُوِيَ فِي  جَاعِرَتَيْهِ  .","","Al-Mu'jam al-Kabir 10822","","عبد الله بن عباس عن ناعم بن أجيل الهمداني عن يزيد بن أبي حبيب الأزدي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","ناعم مولى أم سلمة عن ابن عباس"
"10852","سَعِيدُ بْنُ أَبِي سَعِيدٍ الْمَقْبُرِيُّ  عَنِ  ابْنِ عَبَّاسٍ  10823  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْمُنْذِرُ الْقَزَّازُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  هَمَّامٌ ،  ثَنَا  مُحَمَّدُ بْنُ عَجْلَانَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ، أَنَّهُ  صَلَّى خَلْفَ ابْنِ عَبَّاسٍ عَلَى جِنَازَةٍ ، فَأَجْهَرَ قِرَاءَةَ فَاتِحَةِ الْكِتَابِ ،  فَقَالَ  :  أَحْبَبْتُ أَنْ يَعْلَمَ النَّاسُ وَأَنْ تَعْلَمُوا أَنَّهَا السُّنَّةُ  .","","Al-Mu'jam al-Kabir 10823","","عبد الله بن عباس عن سعيد المقبري عن محمد بن عجلان عن همام بن يحيى بن دينار عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","سعيد بن أبي سعيد المقبري عن ابن عباس"
"10853","[10/333]      عَبْدُ الرَّحْمَنِ بْنُ الْحَارِثِ  عَنِ  ابْنِ عَبَّاسٍ  10824  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ شُجَاعِ بْنِ الْوَلِيدِ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  سَابِقٌ الْجَزَرِيُّ ، أَنَّ عَمْرَو بْنَ أَبِي عَمْرٍو مَوْلَى الْمُطَّلِبِ  أَخْبَرَهُ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْحَلَالُ بَيِّنٌ ، وَالْحَرَامُ بَيِّنٌ ، وَبَيْنَ ذَلِكَ شُبُهَاتٌ  ، فَمَنْ أَوْقَعَ بِهِنَّ فَهُوَ  قَمِنٌ  أَنْ يَأْثَمَ ، وَمَنِ اجْتَنَبَهُنَّ فَهُوَ أَوْفَرُ لِدِينِهِ كَمُرْتِعٍ إِلَى جَنْبِ حِمًى أَوْشَكَ أَنْ يَقَعَ فِيهِ ، وَلِكُلِّ مَلِكٍ حِمًى ، وَحِمَى اللهِ الْحَرَامُ  .","","Al-Mu'jam al-Kabir 10824","","عبد الله بن عباس عن عبد الرحمن بن الحارث المخزومي عن عمرو بن أبي عمرو المخزومي عن سابق بن عبد الله الحجام عن شجاع بن الوليد السكوني عن الوليد بن شجاع عن ابن الرازي محمد بن جعفر البغدادى عن الطبراني","عبد الرحمن بن الحارث عن ابن عباس"
"10854","مَحْمُودُ بْنُ لَبِيدٍ  عَنِ  ابْنِ عَبَّاسٍ  10825  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُخْتَارِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الْحَارِثِ بْنِ فُضَيْلٍ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الشُّهَدَاءُ عَلَى بَارِقٍ نَهَرٍ بِبَابِ الْجَنَّةِ  ، يَخْرُجُ عَلَيْهِمْ رِزْقُهُمْ بُكْرَةً وَعَشِيًّا  .","","Al-Mu'jam al-Kabir 10825","","عبد الله بن عباس عن محمود بن لبيد الأشهلي عن الحارث بن فضيل الخطمي عن محمد بن إسحاق عن حبويه ، إبراهيم بن المختار عن محمد بن سعيد حمدان عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمود بن لبيد عن ابن عباس"
"10855","زِيَادٌ مَوْلَى ابْنِ عَيَّاشٍ  عَنِ  ابْنِ عَبَّاسٍ  10826  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مِقْلَاصٍ الْمِصْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ سَالِمًا أَبَا النَّضْرِ  حَدَّثَهُ  ،  عَنْ  زِيَادٍ مَوْلَى ابْنِ عَيَّاشٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  دَخَلَ  عَلَى عُثْمَانَ بْنِ مَظْعُونٍ  يَوْمَ مَاتَ ، فَأَحْنَى عَلَيْهِ كَأَنَّهُ يُوصِيهِ ، ثُمَّ رَفَعَ رَأْسَهُ فَرَأَوْا فِي عَيْنَيْهِ         [10/334]      أَثَرَ الْبُكَاءِ ، ثُمَّ أَحْنَى عَلَيْهِ الثَّانِيَةَ ، ثُمَّ رَفَعَ رَأْسَهُ فَرَأَوْهُ يَبْكِي ، ثُمَّ أَحْنَى عَلَيْهِ الثَّالِثَةَ ، ثُمَّ رَفَعَ رَأْسَهُ وَلَهُ شَهِيقٌ ، فَعَرَفُوا أَنَّهُ قَدْ مَاتَ ، فَبَكَى  الْقَوْمُ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَهْ ؛ إِنَّمَا هَذَا مِنَ الشَّيْطَانِ ، فَاسْتَغْفِرُوا اللهَ  ، ثُمَّ قَالَ : "" أَذْهِبْ عَنْكَ  أَبَا السَّائِبِ  ، فَلَقَدْ خَرَجْتَ وَلَمْ  تَتَلَبَّسْ  مِنْهَا بِشَيْءٍ  .","","Al-Mu'jam al-Kabir 10826","","عبد الله بن عباس عن زياد بن أبي زياد المخزومي عن سالم بن أبي أمية التيمي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","زياد مولى ابن عياش عن ابن عباس"
"10856","10827  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مِقْلَاصٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ أَبَا النَّضْرِ  حَدَّثَهُ  ،  عَنْ  زِيَادٍ مَوْلَى ابْنِ عَيَّاشٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ دُفِنَ  سَعْدُ بْنُ مُعَاذٍ  وَهُوَ قَاعِدٌ عَلَى قَبْرِهِ قَالَ :  لَوْ نَجَا أَحَدٌ مِنْ فِتْنَةِ الْقَبْرِ لَنَجَا  سَعْدُ بْنُ مُعَاذٍ  ، وَلَقَدْ ضُمَّ ضَمَّةً ثُمَّ رُخِيَ عَنْهُ  .","","Al-Mu'jam al-Kabir 10827","","عبد الله بن عباس عن زياد بن أبي زياد المخزومي عن سالم بن أبي أمية التيمي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","زياد مولى ابن عياش عن ابن عباس"
"10857","يَزِيدُ بْنُ هُرْمُزَ  عَنِ  ابْنِ عَبَّاسٍ  10828  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  يَزِيدُ بْنُ هُرْمُزَ ،  أَنَّ  نَجْدَةَ الْحَرُورِيَّ  حِينَ حَجَّ فِي فِتْنَةِ  ابْنِ الزُّبَيْرِ  أَرْسَلَ إِلَى  ابْنِ عَبَّاسٍ  يَسْأَلُهُ  عَنْ  سَهْمِ  ذِي الْقُرْبَى لِمَنْ يَرَاهُ  ، قَالَ ابْنُ عَبَّاسٍ : هُوَ لِقُرْبَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 10828","","عبد الله بن عباس عن يزيد بن هرمز المدني عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن الحسن بن الربيع البوراني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يزيد بن هرمز عن ابن عباس"
"10858","10829  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ النُّمَيْرِيُّ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ الْأَيْلِيِّ قَالَ :  سَمِعْتُ  الزُّهْرِيَّ  يُحَدِّثُ ، عَنْ  يَزِيدَ بْنِ هُرْمُزَ ،  أَنَّ  نَجْدَةَ الْحَرُورِيَّ  حِينَ حَجَّ فِي فِتْنَةِ  ابْنِ الزُّبَيْرِ  أَرْسَلَ إِلَى  ابْنِ عَبَّاسٍ  يَسْأَلُهُ عَنْ  سَهْمِ  ذِي الْقُرْبَى وَيَقُولُ لِمَنْ يَرَاهُ ؟  فَقَالَ  ابْنُ عَبَّاسٍ :  هُوَ لِقُرْبَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَسَمَهُ لَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَقَدْ كَانَ  عُمَرُ  عَرَضَ عَلَيْنَا مِنْ ذَلِكَ عَرْضًا رَأَيْنَاهُ دُونَ حَقِّنَا ، فَرَدَدْنَاهُ عَلَيْهِ ، وَأَبَيْنَا أَنْ نَقْبَلَهُ ، وَكَانَ عَرَضَ عَلَيْهِمْ أَنْ يُعِينَ         [10/335]      نَاكِحَهُمْ ، وَأَنْ يَقْضِيَ عَنْ غَارِمِهِمْ ، وَأَنْ يُعْطِيَ فَقِيرَهُمْ ، وَأَبَى أَنْ يَزِيدَهُمْ عَلَى ذَلِكَ  .","","Al-Mu'jam al-Kabir 10829","","عبد الله بن عباس عن يزيد بن هرمز المدني عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن عمر النميري عن حجاج بن المنهال الأنماطي عن الحسن بن الربيع البوراني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يزيد بن هرمز عن ابن عباس"
"10859","10830  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُعَاذٍ الْحَلَبِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ، قَالَا :  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  حَدَّثَنِي  قَيْسُ بْنُ سَعْدٍ ،  عَنْ  يَزِيدَ بْنِ هُرْمُزَ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ، وَأَتَاهُ كِتَابُ  نَجْدَةَ  ، كَتَبَ إِلَيْهِ يَسْأَلُهُ عَنْ ذِي الْقُرْبَى الَّذِينَ ذَكَرَ اللهُ فِي الْقُرْآنِ ، وَعَنْ قَتْلِ أَوْلَادِ الْمُشْرِكِينَ ، وَهَلْ كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْتُلُهُمْ ؟ وَعَنِ انْقِضَاءِ يُتْمِ الْيَتِيمِ ، وَعَنِ الْعَبْدِ وَالْمَرْأَةِ يَشْهَدَانِ الْبَأْسَ ، فَقَالَ : لَوْلَا أَنْ أَرُدَّهُ عَنْ شَرٍّ أَخَافُ أَنْ يَقَعَ فِيهِ مَا كَتَبْتُ إِلَيْهِ ، فَكَتَبَ فِي ذَوِي الْقُرْبَى : إِنَّا كُنَّا نَرَى قَرَابَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ هُمْ ، فَأَبَى عَلَيْنَا قَوْمُنَا ذَلِكَ ، وَأَمَّا الْيَتِيمُ فَإِذَا بَلَغَ النِّكَاحَ ، وَأُونِسَ مِنْهُمْ رُشْدٌ ، دُفِعَ إِلَيْهِ مَالُهُ ، فَقَدِ انْقَضَى يُتْمُهُ ،  وَأَمَّا الصِّبْيَانُ فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَكُنْ يَقْتُلُ أَوْلَادَ الْمُشْرِكِينَ  ، وَأَنْتَ فَلَا تَقْتُلْهُمْ ، إِلَّا أَنْ تَكُونَ تَعْلَمُ مِثْلَ مَا عَلِمَ  الْخَضِرُ  مِنِ الْغُلَامِ حِينَ قَتَلَهُ ، وَفِي الْعَبْدِ وَالْمَرْأَةِ هَلْ لَهُمَا  سَهْمٌ  إِذَا شَهِدَا الْبَأْسَ ؟ فَكَتَبَ إِلَيْهِ أَنَّهُ لَيْسَ لَهُمَا  سَهْمٌ  مَعْلُومٌ ، إِلَّا أَنْ يُحْذَيَا مِنْ غَنَائِمِ  الْقَوْمِ  .","","Al-Mu'jam al-Kabir 10830","","عبد الله بن عباس عن يزيد بن هرمز المدني عن قيس بن سعد الحبشي عن جرير بن حازم عن عبد الله بن رجاء الغداني عن محمد بن معاذ بن سفيان العنزي عن الطبراني","يزيد بن هرمز عن ابن عباس"
"10860","10831  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  عَنْ  زَائِدَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُخْتَارِ بْنِ صَيْفِيٍّ ،  عَنْ  يَزِيدَ بْنِ هُرْمُزَ  قَالَ  :  كَتَبَ  نَجْدَةُ  إِلَى ابْنِ عَبَّاسٍ يَسْأَلُهُ عَنْ يَتِيمٍ مَتَى يَنْقَطِعُ عَنْهُ الْيُتْمُ ، وَعَنْ قَتْلِ الْوِلْدَانِ  ، وَعَنِ الْمَمْلُوكِ أَلَهُ مِنَ الْفَيْءِ شَيْءٌ ؟ وَعَنِ الْخُمُسِ لِمَنْ هُوَ ؟ فَقَالَ  ابْنُ عَبَّاسٍ  : لَوْلَا أَنْ يَأْتِيَ  أُحْمُوقَةً  مَا كَتَبْتُ إِلَيْهِ ، ثُمَّ كَتَبَ إِلَيْهِ : أَمَّا الْيَتِيمُ فَإِذَا احْتَلَمَ ، وَأُونِسَ مِنْهُ رُشْدًا فَقَدِ انْقَطَعَ عَنْهُ الْيُتْمُ ، وَأَمَّا الْوِلْدَانُ فَإِنْ كُنْتَ تَعْلَمُ فِيهِمْ مَا عَلِمَ  الْخَضِرُ  وَإِلَّا فَلَا تَقْتُلْهُمْ ،         [10/336]      وَأَمَّا الْمَمْلُوكُ فَقَدْ كَانَ يُحْذَى لَهُ ، وَأَمَّا النِّسَاءُ فَقَدْ كُنَّ يُدَاوِينَ الْجَرْحَى وَيَسْقِينَ الْمَاءَ ، وَأَمَّا الْخُمُسُ فَنَزْعُمُ أَنَّهُ لَنَا ، وَيَزْعُمُ قَوْمُنَا أَنَّهُ لَيْسَ  لَنَا .","","Al-Mu'jam al-Kabir 10831","","عبد الله بن عباس عن يزيد بن هرمز المدني عن مختار بن صيفي الكوفي عن الأعمش عن زائدة بن قدامة عن أبو إسحاق الفزاري عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","يزيد بن هرمز عن ابن عباس"
"10861","10832  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضْرِ ،  ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ، (  ح  )  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ، جَمِيعًا  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  يَزِيدَ بْنِ هُرْمُزَ قَالَ :  كَتَبَ  نَجْدَةُ  إِلَى  ابْنِ عَبَّاسٍ  يَسْأَلُهُ  عَنِ الْخُمُسِ لِمَنْ هُوَ  ؟ وَعَنِ الْعَبْدِ وَالْمَرْأَةِ يَحْضُرَانِ الْمَغْنَمَ ، هَلْ لَهُمَا مِنْهُ شَيْءٌ ؟ وَعَنِ الْيَتِيمِ ، مَتَى يُرْفَعُ عَنْهُ اسْمُ الْيُتْمِ ؟ وَعَنْ قَتْلِ الْوِلْدَانِ ، فَقَالَ ابْنُ عَبَّاسٍ : لَوْلَا أَنِّي أَرْجُو أَنْ يَنْفَعَهُ اللهُ بِكِتَابِي مَا كَتَبْتُ إِلَيْهِ ، ثُمَّ قَالَ : اكْتُبْ يَا  يَزِيدُ  ، أَمَّا الْخُمُسُ فَإِنَّا كُنَّا نَرَى أَنَّهُ لَنَا ، فَأَبَى عَلَيْنَا قَوْمُنَا ذَلِكَ ، وَأَمَّا الْعَبْدُ وَالْمَرْأَةُ يَحْضُرَانِ الْمَغْنَمَ فَإِنَّهُ لَيْسَ لَهُمَا مِنْهُ شَيْءٌ ، وَلَكِنْ يُرْضَخُ لَهُمَا ، وَأَمَّا الْيَتِيمُ فَإِنَّهُ يُرْفَعُ عَنْهُ الْيُتْمُ إِذَا بَلَغَ الْحُلُمَ ، وَيَصِيرُ مِنْ فُقَرَاءِ الْمُسْلِمِينَ ، وَأَمَّا الْوِلْدَانِ فَلَا تَقْتُلْهُمْ حَتَّى تَعْلَمَ مِنْهُمْ مِثْلَ مَا عَلِمَ  الْخَضِرُ  مِنَ الْغُلَامِ قَبْلَ أَنْ تَقْتُلَهُ  ،  وَاللَّفْظُ لِحَدِيثِ  أَبِي إِسْحَاقَ الْفَزَارِيِّ  .","","Al-Mu'jam al-Kabir 10832","","عبد الله بن عباس عن يزيد بن هرمز المدني عن سعيد المقبري عن إسماعيل بن أمية الأموي عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","يزيد بن هرمز عن ابن عباس"
"10862","10833  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  يَزِيدَ بْنِ هُرْمُزَ ،  أَنَّ  نَجْدَةَ  كَتَبَ إِلَى  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا يَسْأَلُهُ عَنْ خَمْسِ خِلَالٍ ، فَقَالَ  ابْنُ عَبَّاسٍ  : لَوْلَا أَنْ أَكْتُمَ عِلْمًا لَمَا كَتَبْتُ إِلَيْهِ ، فَكَتَبَ إِلَيْهِ  نَجْدَةُ  : أَمَّا بَعْدُ ، فَأَخْبِرْنِي هَلْ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَغْزُو بِالنِّسَاءِ ؟ وَهَلْ كَانَ يَضْرِبُ لَهُنَّ بِسَهْمٍ ؟ وَهَلْ كَانَ يَقْتُلُ الصِّبْيَانَ ؟ وَمَتَى يَنْقَطِعُ يُتْمُ الْيَتِيمِ ؟ وَعَنِ الْخُمُسِ لِمَنْ هُوَ ؟ فَكَتَبَ إِلَيْهِ ابْنُ عَبَّاسٍ : كَتَبْتَ تَسْأَلُنِي : هَلْ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَغْزُو بِالنِّسَاءِ ؟ وَقَدْ كَانَ يَغْزُو بِهِنَّ فَيُدَاوِينَ الْجَرْحَى ، وَيُحْذَيْنَ مِنَ الْغَنِيمَةِ ، وَأَمَّا  سَهْمٌ  فَلَمْ يَضْرِبْ لَهُنَّ ،         [10/337]      وَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَقْتُلِ الصِّبْيَانَ  ، وَكَتَبْتَ : مَتَى يَنْقَضِي يُتْمُ الْيَتِيمِ ؟ وَلَعَمْرِي إِنَّ الرَّجُلَ يَشِبُ لِحْيَتُهُ وَإِنَّهُ لَضَعِيفُ الْأَخْذِ لِنَفْسِهِ ، ضَعِيفُ الْإِعْطَاءِ مِنْهَا ، فَإِذَا أَخَذَ لِنَفْسِهِ مِنْ أَصْلَحِ مَا يَأْخُذُ النَّاسُ ، فَقَدْ ذَهَبَ عَنْهُ الْيُتْمُ ، وَكَتَبْتَ تَسْأَلُنِي عَنِ الْخُمُسِ ، لِمَنْ هُوَ ؟ فَإِنَّا نَقُولُ : هُوَ لَنَا ، وَأَبَى عَلَيْنَا قَوْمُنَا ذَلِكَ .","","Al-Mu'jam al-Kabir 10833","","عبد الله بن عباس عن يزيد بن هرمز المدني عن أبو جعفر الباقر عن جعفر الصادق عن سليمان بن بلال القرشي عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يزيد بن هرمز عن ابن عباس"
"10863","10834  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  يَزِيدَ بْنِ هُرْمُزَ ،  أَنَّ  نَجْدَةَ  كَتَبَ إِلَى ابْنِ عَبَّاسٍ  ، فَذَكَرَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 10834","","عبد الله بن عباس عن يزيد بن هرمز المدني عن أبو جعفر الباقر عن جعفر الصادق عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","يزيد بن هرمز عن ابن عباس"
"10864","10835  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ ،  ثَنَا  أَحْمَدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَلِيٍّ ، وَالزُّهْرِيُّ ، (  ح  )  وَثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيٍّ  عَنْ  يَزِيدَ بْنِ هُرْمُزَ قَالَ :  كَتَبَ  نَجْدَةُ  إِلَى ابْنِ عَبَّاسٍ  ،  ثُمَّ ذَكَرَ الْحَدِيثَ نَحْوَ لَفْظِ  جَعْفَرِ بْنِ مُحَمَّدٍ  .","","Al-Mu'jam al-Kabir 10835","","عبد الله بن عباس عن يزيد بن هرمز المدني عن أبو جعفر الباقر عن محمد بن إسحاق عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","يزيد بن هرمز عن ابن عباس"
"10865","شُرَحْبِيلُ بْنُ سَعْدٍ الْأَنْصَارِيُّ  عَنِ  ابْنِ عَبَّاسٍ  10836  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ، (  ح  )  وَثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  خَلَّادُ بْنُ يَحْيَى ، قَالَا :  ثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  ثَنَا  شُرَحْبِيلُ بْنُ سَعْدٍ الْأَنْصَارِيُّ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ : قَالَ رَسُولُ اللهِ         [10/338]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ أَحَدٍ تُدْرِكُ لَهُ ابْنَتَانِ ، فَيُحْسِنُ إِلَيْهِمَا مَا صَحِبَتَاهُ وَصَحِبَهُمَا ، إِلَّا أَدْخَلَتَاهُ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 10836","","عبد الله بن عباس عن شرحبيل بن سعد الخطمي عن فطر بن خليفة عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","شرحبيل بن سعد الأنصاري عن ابن عباس"
"10866","عَبْدُ اللهِ بْنُ شَدَّادٍ  عَنِ  ابْنِ عَبَّاسٍ  10837  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مِسْعَرٍ ،  عَنْ  أَبِي عَوْنٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  حُرِّمَتِ الْخَمْرُ بِعَيْنِهَا ، وَالْمُسْكِرُ مِنْ كُلِّ شَرَابٍ  "" .","","Al-Mu'jam al-Kabir 10837","","عبد الله بن عباس عن عبد الله بن شداد بن الهاد الليثي عن محمد بن عبيد الله بن سعيد الثقفي عن مسعر بن كدام عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن شداد عن ابن عباس"
"10867","10838  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ، وَمُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ ، قَالَا :  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ، وَالْأَعْمَشِ ،  عَنْ  ذَرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ  رَجُلًا  قَالَ :  يَا رَسُولَ اللهِ ، إِنِّي لَأُحَدِّثُ نَفْسِي بِالشَّيْءِ مِنْ أَمْرِ الرَّبِّ  ، لَأَنْ أَكُونَ  حُمَمَةً  أَحَبُّ إِلَيَّ مِنْ أَنْ أَتَكَلَّمَ بِهِ ، قَالَ  شُعْبَةُ  : قَالَ أَحَدُهُمَا : "" الْحَمْدُ لِلهِ الَّذِي لَمْ يَقْدِرْ مِنْكُمْ إِلَّا عَلَى  الْوَسْوَسَةِ  "" ، وَقَالَ الْآخَرُ : "" لِلهِ الَّذِي رَدَّ أَمْرَهُ إِلَى  الْوَسْوَسَةِ  .","","Al-Mu'jam al-Kabir 10838","","عبد الله بن عباس عن عبد الله بن شداد بن الهاد الليثي عن ذر بن عبد الله المرهبي عن الأعمش عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن محمد بن محمد بن حيان التمار عن الطبراني","عبد الله بن شداد عن ابن عباس"
"10868","10839  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  خَلَّادُ بْنُ يَحْيَى ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ، قَالَا :  ثَنَا  مِسْعَرٌ ،  عَنْ  أَبِي عَوْنٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  حُرِّمَتِ الْخَمْرُ بِعَيْنِهَا ، الْقَلِيلُ مِنْهَا وَالْكَثِيرُ  ،  وَالسَّكَرُ  مِنْ كُلِّ شَرَابٍ  "" .","","Al-Mu'jam al-Kabir 10839","","عبد الله بن عباس عن عبد الله بن شداد بن الهاد الليثي عن محمد بن عبيد الله بن سعيد الثقفي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن شداد عن ابن عباس"
"10869","10840  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،         [10/339]      عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي عَوْنٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنِ  ابْنِ عَبَّاسٍ بِمِثْلِهِ .  وَأَبُو سَلَمَةَ هَذَا مِسْعَرٌ  .","","Al-Mu'jam al-Kabir 10840","","عبد الله بن عباس عن عبد الله بن شداد بن الهاد الليثي عن محمد بن عبيد الله بن سعيد الثقفي عن مسعر بن كدام عن سفيان الثوري عن محمد بن كثير العبدي عن عثمان بن عمر الضبي عن الطبراني","عبد الله بن شداد عن ابن عباس"
"10870","10841  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنِ  الْعَبَّاسِ بْنِ ذَرِيحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  الْخَمْرُ بِعَيْنِهَا حَرَامٌ ، قَلِيلُهَا وَكَثِيرُهَا ،  وَالسَّكَرُ  مِنْ كُلِّ شَرَابٍ  ""  .","","Al-Mu'jam al-Kabir 10841","","عبد الله بن عباس عن عبد الله بن شداد بن الهاد الليثي عن عباس بن ذريح الكلبي عن شريك بن عبد الله النخعي عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عبد الله بن شداد عن ابن عباس"
"10871","10842  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى السُّدِّيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَيَّاشٍ الْعَامِرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا نَزَلَ تَحْرِيمُ الْخَمْرِ قَالُوا : يَا رَسُولَ اللهِ ، أَلَا نَبِيعُ ؟ قَالَ :  إِنَّ الَّذِي حَرَّمَ شُرْبَهَا حَرَّمَ بَيْعَهَا  .","","Al-Mu'jam al-Kabir 10842","","عبد الله بن عباس عن عبد الله بن شداد بن الهاد الليثي عن عياش بن عمرو العامري عن شريك بن عبد الله النخعي عن إسماعيل بن موسى الفزاري عن موسى بن هارون الحمال عن الطبراني","عبد الله بن شداد عن ابن عباس"
"10872","أَبُو صَالِحٍ  عَنِ  ابْنِ عَبَّاسٍ  10843  -  حَدَّثَنَا  الْعَبَّاسُ الْأَسْفَاطِيُّ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  مِنْدَلُ بْنُ عَلِيٍّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يُؤْذِ جَارَهُ  ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلْيَقُلْ خَيْرًا أَوْ لِيَسْكُتْ  .","","Al-Mu'jam al-Kabir 10843","","عبد الله بن عباس عن ذكوان السمان عن الأعمش عن مندل بن علي عن أحمد بن عبد الله اليربوعي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","أبو صالح عن ابن عباس"
"10873","10844  -  حَدَّثَنَا  وَرْدُ بْنُ أَحْمَدَ بْنِ لَبِيدٍ الْبَيْرُوتِيُّ ،  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  شَيْبَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ         [10/340]      عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  هِجْرَةَ  بَعْدَ الْفَتْحِ ، وَلَكِنْ  جِهَادٌ  وَنِيَّةٌ  ، وَإِذَا  اسْتُنْفِرْتُمْ  فَانْفِرُوا  .","","Al-Mu'jam al-Kabir 10844","","عبد الله بن عباس عن ذكوان السمان عن الأعمش عن شيبان بن عبد الرحمن المؤدب عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن محمد بن أحمد بن لبيد عن الطبراني","أبو صالح عن ابن عباس"
"10874","[11/5]      أَبُو صَالِحٍ  عَنِ  ابْنِ عَبَّاسٍ  10845  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ سَنْدِيلَةُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَيُّوبَ الْفِرْسَانِيُّ ،  ثَنَا  أَبُو هَانِئٍ إِسْمَاعِيلُ بْنُ خَلِيفَةَ ،  عَنْ  مَعْمَرٍ ،  عَنْ  زَائِدَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""  مَنْ كَتَمَ عِلْمًا يَعْلَمُهُ  أُلْجِمَ  يَوْمَ الْقِيَامَةِ بِلِجَامٍ مِنْ نَارٍ  . قَالَ : ""  هِيَ الشَّهَادَةُ تَكُونُ عِنْدَ الرَّجُلِ يُدْعَى لَهَا أَوْ لَا يُدْعَى لَهَا  ، وَهُوَ يَعْلَمُهَا ، وَلَا يُرْشِدُ صَاحِبَهَا إِلَيْهَا فَهُوَ هَذَا الْعِلْمُ  .","","Al-Mu'jam al-Kabir 10845","","عبد الله بن عباس عن ذكوان السمان عن الأعمش عن زائدة بن قدامة عن معمر بن راشد عن إسماعيل بن خليفة الأصبهاني عن إبراهيم بن أيوب الفرسانى عن عبد الله بن داود سنديلة عن محمد بن يحيى بن مندة عن الطبراني","أبو صالح عن ابن عباس"
"10875","طَاوُسٌ  عَنِ  ابْنِ عَبَّاسٍ  10846  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  خَلَّادُ بْنُ يَحْيَى ،  ثَنَا  قَيْسُ بْنُ         [11/6]      الرَّبِيعِ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُقَامُ الْحُدُودُ فِي الْمَسَاجِدِ  ، وَلَا يُقَادُ وَالِدٌ بِوَلَدٍ  .","","Al-Mu'jam al-Kabir 10846","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن قيس بن الربيع الأسدي عن خلاد بن يحيى الأرحبي عن بشر بن موسى بن صالح الأسدي عن الطبراني","طاوس عن ابن عباس"
"10876","10847  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  عُمَرُ بْنُ حَوْشَبٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ :  أَنَّ الثَّلَاثَ كَانَتْ تُجْعَلُ وَاحِدَةً عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 10847","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن عمر بن حوشب الصنعاني عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10877","10848  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ، (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ، قَالَا :  ثَنَا  سُلَيْمَانُ بْنُ كَثِيرٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قُتِلَ فِي  عِمِّيَّا  أَوْ  رِمِّيَّا  يَكُونُ بَيْنَهُمْ بِحَجَرٍ أَوْ سَوْطٍ أَوْ بِعَصًا فَعَقْلُهُ عَقْلُ  خَطَأٍ  ، وَمَنْ قَتَلَ عَمْدًا فَقَوَدُ يَدِهِ ، فَمَنْ حَالَ بَيْنَهُ وَبَيْنَهُ فَعَلَيْهِ لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ ، لَا يُقْبَلُ مِنْهُمْ  صَرْفٌ  وَلَا عَدْلٌ  .","","Al-Mu'jam al-Kabir 10848","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سليمان بن كثير الأصيد عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","طاوس عن ابن عباس"
"10878","10849  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الْحَسَنِ بْنِ عُمَارَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 10849","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن الحسن بن عمارة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10879","10850  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 10850","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن أبو معاوية الضرير عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","طاوس عن ابن عباس"
"10880","[11/7]      10851  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدٍ الْمُجَاشِعِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي يَعْقُوبَ الْكَرْمَانِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّا مَعَاشِرَ الْأَنْبِيَاءِ أُمِرْنَا أَنْ نُعَجِّلَ الْإِفْطَارَ  ، وَأَنْ نُؤَخِّرَ السُّحُورَ ، وَأَنْ نَضْرِبَ بِأَيْمَانِنَا عَلَى شَمَائِلِنَا  .","","Al-Mu'jam al-Kabir 10851","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن محمد بن إسحاق الكرماني عن العباس بن محمد بن مجاشع الأصبهاني عن الطبراني","طاوس عن ابن عباس"
"10881","10852  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ أَحْسَنَ النَّاسِ قِرَاءَةً مَنْ إِذَا قَرَأَ يَتَحَزَّنُ  .  في طبعة مكتبة ابن تيمية : (عثمان بن يحيى بن صالح) والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 10852","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","طاوس عن ابن عباس"
"10882","10853  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، وَمُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ (  ح  ) ،  وَثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ، قَالُوا :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ ، قَالَ :  سَمِعْتُ  طَاوُسًا ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ، يَقُولُ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحْرِمٌ  "" .","","Al-Mu'jam al-Kabir 10853","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","طاوس عن ابن عباس"
"10883","10854  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا         [11/8]      سَلَمَةُ بْنُ سُلَيْمَانَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ مُحْرِمٌ  "" .","","Al-Mu'jam al-Kabir 10854","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن ابن جريج عن سلمة بن سليمان المروزي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عباس"
"10884","10855  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَمَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَسْجُدَ عَلَى سَبْعٍ وَلَا  نَكُفَّ  شَعَرًا  ، وَلَا ثَوْبًا  .","","Al-Mu'jam al-Kabir 10855","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10885","10856  -  حَدَّثَنَا  إِسْحَاقُ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ،  أَنَّهُ سَمِعَ  طَاوُسًا ، - يَحْسَبُ أَنْ يَأْثِرَ ذَلِكَ - ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أُمِرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَسْجُدَ عَلَى سَبْعٍ  : وَجْهِهِ ، وَكَفَّيْهِ ، وَرُكْبَتَيْهِ ، وَقَدَمَيْهِ ، وَنُهِيَ أَنْ  نَكُفَّ  شَعَرًا أَوْ ثَوْبًا  .","","Al-Mu'jam al-Kabir 10856","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10886","10857  -  حَدَّثَنَا  إِسْحَاقُ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ الطَّائِفِيِّ ، وَابْنِ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 10857","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10887","10858  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، وَأَبُو خَيْثَمَةَ وَمُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ، قَالُوا :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :         [11/9]      أُمِرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَسْجُدَ عَلَى سَبْعٍ  ، وَنُهِيَ أَنْ  يَكُفَّ  شَعَرَهُ ، وَثِيَابَهُ  .","","Al-Mu'jam al-Kabir 10858","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن عبد الله بن أحمد بن حنبل عن الطبراني","طاوس عن ابن عباس"
"10888","10859  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  أَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  ، وَنَهَى أَنْ  نَكُفَّ  شَعَرًا أَوْ ثَوْبًا  .","","Al-Mu'jam al-Kabir 10859","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10889","10860  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أُمِرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَسْجُدَ عَلَى سَبْعَةٍ  ، وَأَلَّا  يَكُفَّ  شَعَرَهُ أَوْ ثِيَابَهُ  .","","Al-Mu'jam al-Kabir 10860","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10890","10861  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ، وَحَمَّادُ بْنُ سَلَمَةَ كِلَاهُمَا ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْضَاءٍ  : الْأَنْفِ ، وَالْجَبْهَةِ ، وَالرَّاحَتَيْنِ ، وَأَطْرَافِ الْأَصَابِعِ ، وَلَا  أَكُفَّ  شَعَرًا ، وَلَا ثَوْبًا  .","","Al-Mu'jam al-Kabir 10861","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن سلمة عن يحيى بن إسحاق السيلحيني عن بشر بن موسى بن صالح الأسدي عن الطبراني","طاوس عن ابن عباس"
"10891","10862  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  رَوْحُ بْنُ الْقَاسِمِ ، وَشُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  ، وَلَا  أَكُفَّ  شَعَرًا وَلَا ثَوْبًا  .","","Al-Mu'jam al-Kabir 10862","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن يزيد بن زريع العيشي عن محمد بن المنهال عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10892","10863  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِبْرَاهِيمَ بْنِ يَزِيدَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  ، وَلَا  أَكُفَّ  شَعَرًا ، وَلَا ثَوْبًا  .","","Al-Mu'jam al-Kabir 10863","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إبراهيم بن يزيد الخوزي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10893","[11/10]      10864  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  ، وَنُهِيتُ أَنْ  أَكُفَّ  شَعَرًا أَوْ ثَوْبًا  .","","Al-Mu'jam al-Kabir 10864","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن أبان بن يزيد العطار عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10894","10865  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْحَسَنِ بْنِ مُكْرَمٍ الْبَغْدَادِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  ، وَنُهِيتُ أَنْ  أَكُفَّ  شَعَرًا أَوْ ثَوْبًا  .","","Al-Mu'jam al-Kabir 10865","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن عيسى بن أبي عيسى الرازي عن علي بن الجعد عن أحمد بن الحسن بن مكرم البزاز عن الطبراني","طاوس عن ابن عباس"
"10895","10866  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةٍ  ، وَلَا  أَكُفَّ  شَعَرًا وَلَا ثَوْبًا  .","","Al-Mu'jam al-Kabir 10866","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن محمد بن عبد الله بن عبيد الليثي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","طاوس عن ابن عباس"
"10896","10867  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَبُو كَامِلٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  ، وَلَا  أَكُفَّ  شَعَرًا وَلَا ثَوْبًا  .","","Al-Mu'jam al-Kabir 10867","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن الوضاح بن عبد الله اليشكري عن فضيل بن حسين الجحدري عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عباس"
"10897","10868  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو ،  ثَنَا  الْمُنْذِرُ بْنُ الْوَلِيدِ الْجَارُودِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  ، وَلَا  أَكُفَّ  شَعَرًا وَلَا ثَوْبًا  .","","Al-Mu'jam al-Kabir 10868","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن أيوب السختياني عن الحسن بن أبي جعفر الجفري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن أحمد بن عمرو بن أحمد الزئبقي عن الطبراني","طاوس عن ابن عباس"
"10898","[11/11]      10869  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ،  ثَنَا  عَمْرُو بْنُ يَحْيَى بْنِ غُفْرَةَ الْبَجَلِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ شَرْطٍ لَيْسَ فِي كِتَابِ اللهِ فَهُوَ بَاطِلٌ  ، وَإِنْ كَانَ مِائَةَ شَرْطٍ  .","","Al-Mu'jam al-Kabir 10869","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن زيد عن عمرو بن يحيى بن غفرة البجلي عن البزار عن الطبراني","طاوس عن ابن عباس"
"10899","10870  -  حَدَّثَنَا  الْعَبَّاسُ الْأَسْفَاطِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ  الثَّمَرِ  حَتَّى يُطْعَمَ  .","","Al-Mu'jam al-Kabir 10870","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","طاوس عن ابن عباس"
"10900","10871  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ ابْتَاعَ طَعَامًا فَلَا يَبِعْهُ حَتَّى يَقْبِضَهُ  .","","Al-Mu'jam al-Kabir 10871","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","طاوس عن ابن عباس"
"10901","10872  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ الطَّائِفِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِذَا ابْتَعْتَ طَعَامًا فَلَا تَبِعْهُ حَتَّى تَقْبِضَهُ  قَالَ  ابْنُ عَبَّاسٍ  :  فَأَرَى مَا سِوَى ذَلِكَ مِنَ الْبَيْعِ مِثْلَ الطَّعَامِ  .","","Al-Mu'jam al-Kabir 10872","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن داود بن عمرو المسيبي عن لحية الليف محمد بن العباس عن الطبراني","طاوس عن ابن عباس"
"10902","[11/12]      10873  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  مَنِ ابْتَاعَ طَعَامًا فَلَا يَبْتَعْهُ حَتَّى يَسْتَوْفِيَهُ  وَأَحْسَبُ أَنَّ كُلَّ شَيْءٍ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 10873","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10903","10874  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  هُشَيْمٌ ،  أَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  الطَّعَامُ الَّذِي نَهَى عَنْهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنْ يُبَاعَ حَتَّى يُقْبَضَ  .","","Al-Mu'jam al-Kabir 10874","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن هشيم بن بشير عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","طاوس عن ابن عباس"
"10904","10875  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَهَى عَنْ بَيْعِ الطَّعَامِ قَبْلَ أَنْ يُقْبَضَ  .","","Al-Mu'jam al-Kabir 10875","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن عبد الله بن أحمد بن حنبل عن الطبراني","طاوس عن ابن عباس"
"10905","10876  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  سَهْلُ بْنُ بَكَّارٍ ، (  ح  ) ،  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا اشْتَرَى أَحَدُكُمْ طَعَامًا فَلَا يَبِعْهُ حَتَّى يَقْبِضَهُ  .","","Al-Mu'jam al-Kabir 10876","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","طاوس عن ابن عباس"
"10906","10877  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ حَفْصٍ النُّفَيْلِيُّ ، قَالَ :  قَرَأْنَا عَلَى  مَعْقِلِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ ابْتَاعَ طَعَامًا فَلَا يَبِعْهُ حَتَّى يَسْتَوْفِيَهُ  .","","Al-Mu'jam al-Kabir 10877","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن معقل بن عبيد الله الجزري عن سعيد بن حفص بن عمر الهذلي عن أحمد بن النضر بن بحر العسكري عن الطبراني","طاوس عن ابن عباس"
"10907","10878  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الطَّاهِرِ بْنُ السَّرْحِ ،  ثَنَا  مُوسَى بْنُ رَبِيعَةَ ،  عَنِ  الْمُثَنَّى بْنِ الصَّبَّاحِ ،  عَنْ  عَمْرِو بْنِ         [11/13]      دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الطَّعَامِ حَتَّى يُسْتَوْفَى  .","","Al-Mu'jam al-Kabir 10878","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن المثنى بن الصباح الأبناوي عن موسى بن ربيعة الجمحي عن أحمد بن عمرو بن بن السرح المصري عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"10908","10879  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رِزْمَةَ ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  ثَنَا  شَرِيكٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" لَمْ يُحَرِّمِ الْمُزَارَعَةَ  ، وَلَكِنْ أَمَرَ أَنْ يَرْفُقَ بَعْضُهُمْ بَعْضًا  .","","Al-Mu'jam al-Kabir 10879","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن شريك بن عبد الله النخعي عن الفضل بن موسى السيناني عن محمد بن عبد العزيز بن أبي رزمة عن عبد الله بن أحمد بن حنبل عن الطبراني","طاوس عن ابن عباس"
"10909","10880  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَأَنْ  يَمْنَحَ  أَحَدُكُمْ أَخَاهُ أَرْضَهُ  ، خَيْرٌ لَهُ مِنْ أَنْ يَأْخُذَ أَجْرًا مَعْلُومًا  .","","Al-Mu'jam al-Kabir 10880","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان الثوري عن محمد بن كثير العبدي عن أحمد بن داود بن موسى السدوسي عن الطبراني","طاوس عن ابن عباس"
"10910","10881  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  ابْنُ عَائِشَةَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمْ يَنْهَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كِرَاءِ الْأَرْضِ ، وَلَكِنَّهُ قَالَ :  لَأَنْ  يَمْنَحَ  أَحَدُكُمْ أَخَاهُ ، خَيْرٌ لَهُ مِنْ أَنْ يَأْخُذَ عَلَيْهَا أَجْرًا  .","","Al-Mu'jam al-Kabir 10881","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن سلمة عن ابن عائشة عن أحمد بن داود بن موسى السدوسي عن الطبراني","طاوس عن ابن عباس"
"10911","10882  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ، قَالَ :  حَدَّثَنِي  ابْنُ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَأَنْ  يَمْنَحَ  الرَّجُلُ أَخَاهُ أَرْضَهُ ، خَيْرٌ لَهُ مِنْ أَنْ يَأْخُذَ عَلَيْهَا خَرْجًا  مَعْلُومًا  .","","Al-Mu'jam al-Kabir 10882","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10912","10883  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ         [11/14]      بْنُ زُرَيْعٍ ،  عَنْ  رَوْحِ بْنِ الْقَاسِمِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْأَرْضِ قَالَ :  تَمْنَحُهَا  أَخَاكَ خَيْرٌ مِنْ أَنْ تَأْخُذَ عَلَيْهَا خَرَاجًا  .","","Al-Mu'jam al-Kabir 10883","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن محمد بن المنهال عن معاذ بن المثنى العنبري عن الطبراني","طاوس عن ابن عباس"
"10913","10884  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ،  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ، (  ح  ) ،  وَحَدَّثَنَا  حَامِدُ بْنُ سَعْدَانَ بْنِ يَزِيدَ ،  ثَنَا  مُحَمَّدُ بْنُ رُمْحٍ الْمِصْرِيُّ ، قَالَا :  ثَنَا  اللَّيْثُ ،  عَنْ  ، [ عَبْدِ الْمَلِكِ بْنِ عَبْدِ الْعَزِيزِ بْنِ جُرَيْجٍ ]  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَأَنْ يَمْنَحَهَا أَحَدُكُمْ أَخَاهُ خَيْرٌ لَهُ  وَلَمْ يَنْهَ عَنْ كِرَاهَا  .  في طبعة مكتبة ابن تيمية والنسخة الخطية : ( عبد الملك بن عبد العزيز عن ابن جريج ) ويظهر في النسخة الخطية وكأنه ضرب على لفظة ( عن ) وهو الصواب ، والله أعلم .","","Al-Mu'jam al-Kabir 10884","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن ابن جريج عن الليث بن سعد عن محمد بن رمح بن المهاجر التجيبي عن حامد بن سعدان بن يزيد البغدادي عن الطبراني","طاوس عن ابن عباس"
"10914","10885  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ ،  ثَنَا  سَعْدُ بْنُ عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ،  ثَنَا  حَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَأَنْ يُزْرِعَ الرَّجُلُ أَخَاهُ خَيْرٌ لَهُ مِنْ أَنْ يَأْخُذَ عَلَيْهَا خَرَاجًا  .","","Al-Mu'jam al-Kabir 10885","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن شعيب الحماني عن سعد بن عبد الحميد الأنصاري عن لحية الليف محمد بن العباس عن الطبراني","طاوس عن ابن عباس"
"10915","10886  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  وَعَبْدِ اللهِ بْنِ طَاوُسٍ ،  عَنْ  طَاوُسٍ  ، قَالَ  عَمْرٌو  :  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُهِلُّ  أَهْلُ الْمَدِينَةِ  مِنْ  ذِي الْحُلَيْفَةِ  ،  وَأَهْلُ الشَّامِ  مِنَ  الْجُحْفَةِ  ،  وَأَهْلُ الْيَمَنِ  مِنْ  يَلَمْلَمَ  ،  وَأَهْلُ نَجْدٍ  مِنْ  قَرْنٍ  .","","Al-Mu'jam al-Kabir 10886","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10916","[11/15]      10887  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي ظَاهَرْتُ مِنِ امْرَأَتِي ، وَإِنَّهَا أَعْجَبَتْنِي خَلْخَالُهَا الْبَارِحَةَ ، فَوَقَعْتُ عَلَيْهَا قَبْلَ أَنْ أُكَفِّرَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَوَلَمْ يَقُلِ اللهُ عَزَّ وَجَلَّ :         {      مِنْ قَبْلِ أَنْ يَتَمَاسَّا         }      . أَمْسِكْ حَتَّى تُكَفِّرَ  .","","Al-Mu'jam al-Kabir 10887","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن أبو معاوية الضرير عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","طاوس عن ابن عباس"
"10917","10888  -  حَدَّثَنَا  سَهْلُ بْنُ مُوسَى شِيرَانُ ،  أَنَا  أَحْمَدُ بْنُ عَبْدَةَ الضَّبِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حُمْرَانَ ،  ثَنَا  إِسْمَاعِيلُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  إِنَّمَا نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ  مُصْمَتِ  الْحَرِيرِ  ، وَأَمَّا مَا كَانَ سَدَاهُ قُطْنً ، أَوْ كَتَّانً ، فَلَا بَأْسَ بِهِ  .","","Al-Mu'jam al-Kabir 10888","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن محمد بن حمران القيسي عن أحمد بن عبدة الضبي عن شيران سهل بن موسى الرامهرمزي عن الطبراني","طاوس عن ابن عباس"
"10918","10889  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ النَّشَائِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَخْرَجَ فِي يَدِهِ قِطْعَةً مِنْ ذَهَبٍ ،         [11/16]      وَقِطْعَةً مِنْ حَرِيرٍ ، فَقَالَ :  إِنَّ هَذَيْنِ حُرِّمَا عَلَى ذُكُورِ أُمَّتِي وَحُلَّا لِإِنَاثِهِمْ  .","","Al-Mu'jam al-Kabir 10889","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن محمد بن عبد الله بن المثنى الخزرجي عن محمد بن حرب النشائي عن محمود بن محمد بن منويه المفيد عن الطبراني","طاوس عن ابن عباس"
"10919","10890  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ، وَمُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَوَّلُ مَنْ جَهَرَ بِالْإِسْلَامِ  عُمَرُ بْنُ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ  ""  .","","Al-Mu'jam al-Kabir 10890","","عمر بن الخطاب عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عمرو بن دينار الأثرم عن خالد بن يزيد الجمحي عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","طاوس عن ابن عباس"
"10920","10891  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدِ بْنِ كَاسِبٍ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَئِنْ بَقِيتُ إِلَى قَابِلٍ لَأَصُومَنَّ التَّاسِعَ  .","","Al-Mu'jam al-Kabir 10891","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن مروان بن معاوية الفزاري عن يعقوب بن حميد بن كاسب المدني عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","طاوس عن ابن عباس"
"10921","10892  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَالَ :  لَا يَحِلُّ لِامْرِئٍ مُسْلِمٍ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ يَرْجِعُ فِي هِبَتِهِ إِلَّا الْوَالِدُ  .","","Al-Mu'jam al-Kabir 10892","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن مروان بن معاوية الفزاري عن يعقوب بن حميد بن كاسب المدني عن أحمد بن داود بن موسى السدوسي عن الطبراني","طاوس عن ابن عباس"
"10922","10893  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  إِبْرَاهِيمَ بْنِ أَبِي إِسْمَاعِيلَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :         [11/17]      سَأَلْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قُلْتُ : خَيْلٌ مِنَ الْمُسْلِمِينَ وَقَعَتْ عَلَى قَوْمٍ مِنَ الْمُشْرِكِينَ فَقَاتَلُوهُمْ ، وَقَتَلُوا أَبْنَاءَهُمْ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هُمْ مَعَ آبَائِهِمْ  .","","Al-Mu'jam al-Kabir 10893","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إبراهيم بن يزيد الخوزي عن معتمر بن سليمان عن محمد بن المتوكل بن ابى السرى عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","طاوس عن ابن عباس"
"10923","10894  -  حَدَّثَنَا  الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْحَرْبِ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ رَبِيعَةَ الْكِلَابِيُّ ،  عَنْ  إِبْرَاهِيمَ بْنِ يَزِيدَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا أُنْفِقَتُ الْوَرِقُ فِي شَيْءٍ أَحَبَّ إِلَى اللهِ مِنْ نَحِيرٍ يُنْحَرُ فِي يَوْمِ عِيدٍ  .","","Al-Mu'jam al-Kabir 10894","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إبراهيم بن يزيد الخوزي عن محمد بن ربيعة بن سمير الرؤاسي عن محمد بن حرب النشائي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طاوس عن ابن عباس"
"10924","10895  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبُو مُوسَى الْهَرَوِيُّ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  عَنْ  إِبْرَاهِيمَ بْنِ يَزِيدَ ،  عَنْ  سُلَيْمَانَ الْأَحْوَلِ ، أَوْ عَمْرِو بْنِ دِينَارٍ  ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمْ يُرَ لِلْمُتَحَابَّيْنِ مِثْلُ النِّكَاحِ  .","","Al-Mu'jam al-Kabir 10895","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إبراهيم بن يزيد الخوزي عن المعافى بن عمران عن إسحاق بن إبراهيم الهروي عن عبد الله بن أحمد بن حنبل عن الطبراني","طاوس عن ابن عباس"
"10925","10896  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ هَاشِمٍ الْبَصْرِيُّ ،  ثَنَا  شَاهِينُ بْنُ حَيَّانَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي خُطْبَتِهِ :  إِنَّمَا يَهْدِي إِلَى أَحْسَنِ  الْأَخْلَاقِ  ، وَإِنَّمَا يَصْرِفُ سَيِّئَهَا هُوَ  .","","Al-Mu'jam al-Kabir 10896","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن سلمة عن شاهين بن حيان عن محمد بن هاشم البصري عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عباس"
"10926","[11/18]      10897  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  ثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  وَهَبَ  رَجُلٌ  لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَاقَةً ، فَأَثَابَهُ عَلَيْهَا ، فَقَالَ : "" رَضِيتَ ؟ "" قَالَ : لَا ، فَزَادَهُ فَقَالَ : "" رَضِيتَ ؟ "" قَالَ : لَا ، فَزَادَهُ ، قَالَ : "" رَضِيتَ ؟ "" قَالَ : نَعَمْ ، قَالَ :  لَقَدْ هَمَمْتُ أَنْ لَا  أَتَّهِبَ  هِبَةً إِلَّا مِنْ أَنْصَارِيٍّ أَوْ قُرَشِيٍّ أَوْ ثَقَفِيٍّ  .","","Al-Mu'jam al-Kabir 10897","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن زيد عن يونس بن محمد بن مسلم البغدادي عن مجاهد بن موسى عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عباس"
"10927","10898  -  حَدَّثَنَا  عَبْدَانُ ،  ثَنَا  أَيُّوبُ الْوَزَّانُ ،  ثَنَا  فُهَيْرٌ يَحْيَى بْنُ زِيَادٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ يَزِيدَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَقِرُّوا عَلَى سَكِينَتِكُمْ فَقَدِ انْقَطَعَتِ  الْهِجْرَةُ  ، وَلَكِنْ  جِهَادٌ  وَنِيَّةٌ ، وَإِذَا  اسْتُنْفِرْتُمْ  فَانْفِرُوا  .","","Al-Mu'jam al-Kabir 10898","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن إبراهيم بن يزيد الخوزي عن يحيى بن زياد بن أبي داود الحراني عن أيوب بن محمد الوزان عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عباس"
"10928","10899  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عَقِيلٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سُلَيْمَانَ الدَّبَّاسُّ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْأَنْصَارِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، أَنَعْمَلُ فِيمَا جَرَتْ بِهِ الْمَقَادِيرُ ، وَجَفَّ بِهِ الْقَلَمُ ، أَوْ شَيْءٌ نَأْتَنِفُهُ ؟ قَالَ :  بَلْ لِمَا جَرَتْ بِهِ الْمَقَادِيرُ ، وَجَفَّ بِهِ الْقَلَمُ  قَالَ : فَفِيمَ الْعَمَلُ ؟ قَالَ : "" اعْمَلْ فَكُلٌّ  مُيَسَّرٌ  .","","Al-Mu'jam al-Kabir 10899","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن يحيى بن سعيد الأنصاري عن إبراهيم بن سليمان الدباس عن محمد بن عبد الله بن عبيد بن عقيل الهلالي عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عباس"
"10929","[11/19]      10900  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا : "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي صَلَاةِ الْفَجْرِ يَوْمَ الْجُمُعَةِ بِسُورَةِ         {      الم         }      تَنْزِيلُ وَسُورَةٍ مِنَ الْمُفَصَّلِ  ، وَرُبَّمَا قَالَ :         {      هَلْ أَتَى عَلَى الإِنْسَانِ         }      .","","Al-Mu'jam al-Kabir 10900","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10930","10901  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  خَالِدُ بْنُ يُوسُفَ السَّمْتِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلْحِقُوا الْفَرَائِضَ بِالْمَالِ  فَمَا أَنْفَقَتِ الْفَرَائِضُ  فَلِأَوْلَى  ذَكَرٍ  .","","Al-Mu'jam al-Kabir 10901","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن زياد بن سعد الخراساني عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن محمد بن صالح النرسي عن الطبراني","طاوس عن ابن عباس"
"10931","10902  -  حَدَّثَنَا  إِسْحَاقُ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اقْسِمِ الْمَالَ بَيْنِ أَهْلِ الْفَرَائِضِ عَلَى كِتَابِ اللهِ  فَمَا تَرَكَتِ الْفَرَائِضُ  فَلِأَوْلَى  رَجُلٍ  ذَكَرٍ  .","","Al-Mu'jam al-Kabir 10902","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10932","10903  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلْحِقُوا الْفَرَائِضَ بِكِتَابِ اللهِ  ، فَمَا تَرَكَتْ  فَلِأَوْلَى  رَجُلٍ  ذَكَرٍ  .","","Al-Mu'jam al-Kabir 10903","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن محمد بن المنهال عن معاذ بن المثنى العنبري عن الطبراني","طاوس عن ابن عباس"
"10933","[11/20]      10904  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  سَهْلُ بْنُ بَكَّارٍ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَلْحِقُوا الْفَرَائِضَ بِأَهْلِهَا  ، فَمَا بَقِيَ  فَلِأَوْلَى  رَجُلٍ  ذَكَرٍ  .","","Al-Mu'jam al-Kabir 10904","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن سهل بن بكار الدارمي عن عثمان بن عمر الضبي عن الطبراني","طاوس عن ابن عباس"
"10934","10905  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْعَيْنُ  حَقٌّ  ، وَلَوْ كَانَ شَيْءٌ يَسْبِقُ الْقَدَرَ لَسَبَقَتْهُ  الْعَيْنُ  ، وَإِذَا  اسْتُغْسِلْتُمْ  فَاغْتَسِلُوا  .","","Al-Mu'jam al-Kabir 10905","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10935","10906  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانُوا يَرَوْنَ الْعُمْرَةَ فِي أَشْهُرِ  الْحَجِّ  مِنْ  أَفْجَرِ  الْفُجُورِ فِي الْأَرْضِ  ، وَكَانُوا يُسَمُّونَ الْمُحَرَّمَ صَفَرًا ، وَيَقُولُونَ : إِذَا بَرَأَ  الدَّبَرُ  ،  وَعَفَا  الْأَثَرُ ، وَسَلَخَ صَفَرُ  حَلَّتِ  الْعُمْرَةُ لِمَنِ اعْتَمَرَ  ""  .","","Al-Mu'jam al-Kabir 10906","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10936","10907  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  الْحَسَنُ بْنُ سَهْلٍ الْخَيَّاطُ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنِ  ابْنِ جُرَيْجٍ ، وَمُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  وَاللهِ مَا اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَائِشَةَ  فِي ذِي الْحِجَّةِ إِلَّا لِيَقْطَعَ بِذَلِكَ مِنْ قَوْلِ أَهْلِ  الشِّرْكِ  ، فَإِنَّ هَذَا الْحَيَّ مِنْ  قُرَيْشٍ  ، وَمَنْ  دَانَ  دِينَهُمْ كَانُوا يَقُولُونَ : إِذَا عَفَا  الْوَبَرُ  ، وَبَرَأَ  الدَّبَرُ  ، وَدَخَلَ صَفَرُ فَقَدْ  حَلَّتِ  الْعُمْرَةُ لِمَنِ اعْتَمَرَ ، فَكَانُوا يُحَرِّمُونَ الْعُمْرَةَ حَتَّى         [11/21]      يَنْسَلِخَ ذُو الْحِجَّةِ ، وَالْمُحَرَّمُ ، فَوَاللهِ "" مَا أَعْمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَائِشَةَ  إِلَّا لِيَنْقُضَ  ذَلِكَ مِنْ قَوْلِهِمُ  "" .  في طبعة مكتبة ابن تيمية : ( ليقض ) والذي في النسخة الخطية ( ليقص ) وهي غير واضحة بصورة جيدة ، وكتب أمامها في الهامش : ( لينقض ) وهي كذلك في صحيح ابن حبان ( 3765 ) . والله أعلم","","Al-Mu'jam al-Kabir 10907","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن محمد بن إسحاق عن يحيى بن زكريا بن أبي زائدة عن الحسن بن سهل الخياط عن محمد بن عثمان بن أبي شيبة عن الطبراني","طاوس عن ابن عباس"
"10937","10908  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  سَهْلُ بْنُ بَكَّارٍ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" احْتَجَمَ  وَأَعْطَى الْحَجَّامَ أَجْرَهُ  وَاسْتَعَطَ  "" .","","Al-Mu'jam al-Kabir 10908","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن سهل بن بكار الدارمي عن عثمان بن عمر الضبي عن الطبراني","طاوس عن ابن عباس"
"10938","10909  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  سَهْلُ بْنُ بَكَّارٍ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنَّهُ قِيلَ لَهُ فِي الذَّبْحِ وَالْحَلْقِ فِي التَّقْدِيمِ وَالتَّأْخِيرِ قَالَ : "" لَا حَرَجَ  .","","Al-Mu'jam al-Kabir 10909","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن سهل بن بكار الدارمي عن عثمان بن عمر الضبي عن الطبراني","طاوس عن ابن عباس"
"10939","10910  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْعَائِدُ فِي هِبَتِهِ كَالْكَلْبِ يَعُودُ فِي قَيْئِهِ  .","","Al-Mu'jam al-Kabir 10910","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن مسلم بن إبراهيم الشحام عن أحمد بن محمد بن علي الخزاعي عن الطبراني","طاوس عن ابن عباس"
"10940","10911  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ ،  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَا :  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :         [11/22]      وَقَّتَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ نَجْدٍ  قَرْنًا  ،  وَلِأَهْلِ الْيَمَنِ  يَلَمْلَمَ  لِأَهْلِهِنَّ ، وَلِمَنْ يَأْتِي عَلَيْهِنَّ مِمَّنْ أَرَادَ  الْحَجَّ  وَالْعُمْرَةَ ، فَمَنْ كَانَ دُونَ ذَلِكَ فَمِنْ حَيْثُ أَنْشَأَ حَتَّى  أَهْلُ مَكَّةَ  مِنْ  مَكَّةَ  .","","Al-Mu'jam al-Kabir 10911","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن مسلم بن إبراهيم الشحام عن أحمد بن محمد بن علي الخزاعي عن الطبراني","طاوس عن ابن عباس"
"10941","10912  -  حَدَّثَنَا  الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 10912","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن سفيان الثوري عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طاوس عن ابن عباس"
"10942","10913  -  حَدَّثَنَا  الْمُنْتَصِرُ بْنُ مُحَمَّدِ بْنِ الْمُنْتَصِرِ ،  ثَنَا  يُونُسُ بْنُ سُلَيْمَانَ الْحَمَّالُ ،  ثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 10913","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن يونس بن سليمان الحمال عن منتصر بن محمد بن منتصر البغدادي عن الطبراني","طاوس عن ابن عباس"
"10943","10914  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  سَوَّارُ بْنُ مُحَمَّدِ بْنِ قُرَيْشٍ الْعَنْبَرِيُّ الْبَصْرِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      فَلا رَفَثَ وَلا فُسُوقَ وَلا جِدَالَ فِي الْحَجِّ         }      قَالَ :  الرَّفَثُ : الْإِعْرَابَةُ وَالتَّعَرُّضُ لِلنِّسَاءِ بِالْجِمَاعِ  ، وَالْفُسُوقُ : الْمَعَاصِي كُلُّهَا ، وَالْجِدَالُ : جِدَالُ الرَّجُلِ صَاحِبَهُ  ""  .","","Al-Mu'jam al-Kabir 10914","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن سوار بن محمد بن قريش العنبري عن يحيى بن عثمان بن صالح عن الطبراني","طاوس عن ابن عباس"
"10944","10915  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَهَى أَنْ يَبِيعَ الرَّجُلُ طَعَامًا حَتَّى يَسْتَوْفِيَهُ  .","","Al-Mu'jam al-Kabir 10915","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن موسى بن إسماعيل التبوذكي عن محمد بن محمد بن حيان التمار عن الطبراني","طاوس عن ابن عباس"
"10945","[11/23]      10916  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  كَانَ الطَّلَاقُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَأَبِي بَكْرٍ  وَسَنَتَيْنِ مِنْ خِلَافَةِ  عُمَرَ  طَلَاقُ الثَّلَاثِ وَاحِدَةٌ  . فَقَالَ  عُمَرُ  : إِنَّ النَّاسَ قَدِ اسْتَعْجَلُوا أَمْرًا كَانَتْ لَهُمْ فِيهِ أَنَاةٌ فَلَوْ أَمْضَيْنَاهُ عَلَيْهِمْ ، فَأَمْضَاهُ عَلَيْهِمْ  .","","Al-Mu'jam al-Kabir 10916","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10946","10917  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ  أَبَا الصَّهْبَاءِ ،  قَالَ  لِابْنِ عَبَّاسٍ :  تَعْلَمُ أَنَّهَا كَانَتِ الثَّلَاثُ تُجْعَلُ وَاحِدَةً عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَبِي بَكْرٍ ، وَثَلَاثًا مِنْ إِمَارَةِ عُمَرَ ؟  فَقَالَ  ابْنُ عَبَّاسٍ  : "" نَعَمْ  "" .","","Al-Mu'jam al-Kabir 10917","","عمر بن الخطاب عن عبد الله بن عباس عن صهيب البكري عن طاوس بن كيسان عن عبد الله بن طاووس عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10947","10918  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  سَهْلُ بْنُ بَكَّارٍ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" نَكَحَ  مَيْمُونَةَ  وَهُوَ مُحْرِمٌ  "" .","","Al-Mu'jam al-Kabir 10918","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن سهل بن بكار الدارمي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","طاوس عن ابن عباس"
"10948","10919  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  ، وَلَا  نَكُفَّ  الشَّعَرَ ، وَلَا الثِّيَابَ  .         [11/24]","","Al-Mu'jam al-Kabir 10919","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","طاوس عن ابن عباس"
"10949","10920  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُعَاوِيَةَ الْجُمَحِيُّ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .","","Al-Mu'jam al-Kabir 10920","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن عبد الله بن معاوية الجمحي عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"10950","10921  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  سَهْلُ بْنُ بَكَّارٍ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  إِنَّمَا نُهِيَ عَنِ  الْمُتْعَةِ  ، لِأَنَّهُمْ كَانُوا  يَتَّجِرُونَ  فِي وَسَطِ السَّنَةِ  ""  .","","Al-Mu'jam al-Kabir 10921","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن سهل بن بكار الدارمي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","طاوس عن ابن عباس"
"10951","10922  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  ثَنَا  حَجَّاجٌ ،  ثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ، وَقَالَ  ابْنُ رَجَاءٍ  :  أَخْبَرَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ،  عَنْ  حُمَيْدِ بْنِ وَهْبٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ عَلَيْهِ  رَجُلٌ  قَدْ خَضَبَ بِالْحِنَّاءِ ، فَقَالَ : "" مَا أَحْسَنَ هَذَا  ، ثُمَّ مَرَّ عَلَيْهِ آخَرُ ، وَقَدْ خَضَبَ بِالْحِنَّاءِ ،  وَالْكَتَمِ  فَقَالَ : "" مَا أَحْسَنَ هَذَا "" ، ثُمَّ مَرَّ عَلَيْهِ آخَرُ ، وَقَدْ خَضَبَ بِالصُّفْرَةِ ، فَقَالَ : "" هَذَا أَحْسَنُ مِنْ هَذَا كُلِّهِ "" . وَكَانَ  طَاوُسٌ  يَخْضِبُ بِالصُّفْرَةِ  .","","Al-Mu'jam al-Kabir 10922","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن حميد بن وهب الأصبهاني عن محمد بن طلحة بن مصرف الهمداني عن حجاج بن المنهال الأنماطي عن عبد الله بن رجاء الغداني عن أبو مسلم الكجي عن الطبراني","طاوس عن ابن عباس"
"10952","10923  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ         [11/25]      الْمُقَدَّمِيُّ ، قَالَا :  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُتَلَقَّى الرُّكْبَانُ  ، وَأَنْ يَبِيعَ  حَاضِرٌ  لِبَادٍ  .","","Al-Mu'jam al-Kabir 10923","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن عبد الواحد بن زياد عن محمد بن أبي بكر المقدمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طاوس عن ابن عباس"
"10953","10924  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ ،  ثَنَا  زُهَيْرُ بْنُ مُحَمَّدٍ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  أَوَّلُ مَنْ أَسْلَمَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ  ""  .","","Al-Mu'jam al-Kabir 10924","","عبد الله بن عباس عن عروة بن الزبير عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن زهير بن محمد بن قمير المروزي عن محمد بن العباس ابن الأخرم عن الطبراني","طاوس عن ابن عباس"
"10954","10925  -  حَدَّثَنَا  الْحَسَنُ بْنُ غُلَيْبٍ الْمِصْرِيُّ ،  ثَنَا  عِمْرَانُ بْنُ هَارُونَ الرَّمْلِيُّ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمٍ الطَّائِفِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مَيْمُونٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ شَقَّ عَصَا الْمُسْلِمِينَ وَالْمُسْلِمُونَ فِي إِسْلَامٍ  دَامِجٍ  ، فَقَدْ خَلَعَ  رِبْقَةَ  الْإِسْلَامِ مِنْ عُنُقِهِ  .","","Al-Mu'jam al-Kabir 10925","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن إبراهيم بن ميمون الصنعاني عن يحيى بن سليم الطائفي عن الصوفي عمران بن أبى عمران عن الحسن بن غليب المصري عن الطبراني","طاوس عن ابن عباس"
"10955","10926  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  الصَّلْتُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ،  ثَنَا  يَحْيَى بْنُ عُثْمَانَ التَّيْمِيُّ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  شَرُّ الْبَيْتِ الْحَمَّامُ  ، تَعْلُو فِيهِ الْأَصْوَاتُ ، وَتُكْشَفُ فِيهِ  الْعَوْرَاتُ  "" فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ يُدَاوَى فِيهِ الْمَرِيضُ ، وَيَذْهَبُ         [11/26]      فِيهِ الْوَسَخُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَمَنْ دَخَلَهُ فَلَا يَدْخُلْهُ إِلَّا مُسْتَتِرًا  .","","Al-Mu'jam al-Kabir 10926","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن يحيى بن عثمان مولى أبي بكر الصديق عن الصلت بن مسعود الجحدري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طاوس عن ابن عباس"
"10956","10927  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  الْحَسَنُ بْنُ عَبْدِ الْعَزِيزِ الْجَرَوِيُّ ،  ثَنَا  يَحْيَى بْنُ حَسَّانَ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَكَرَ الْخَمْرَ ، فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ إِنَّا نَتَّخِذُ شَرَابًا مِنْ هَذَا  الْمِزْرِ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ مُسْكِرٍ حَرَامٌ  .","","Al-Mu'jam al-Kabir 10927","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن يحيى بن حسان بن حيان التنيسي عن الحسن بن عبد العزيز بن الوزير الجذامي عن عبد الله بن أحمد بن حنبل عن الطبراني","طاوس عن ابن عباس"
"10957","10928  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نَاجِيَةَ ،  ثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  ثَنَا  عَلِيُّ بْنُ عَاصِمٍ  ،  أَخْبَرَنِي  ابْنُ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَجُوزُ فِي الْبُدْنِ : الْعَوْرَاءُ ، وَالْعَجْفَاءُ  ، وَإِيَّاكُمْ وَالْمُصْطَلَحَةَ  .  في طبعة مكتبة ابن تيمية : (عامر) والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 10928","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن علي بن عاصم بن صهيب عن أحمد بن منيع البغوي عن عبد الله بن محمد بن ناجية البربري عن الطبراني","طاوس عن ابن عباس"
"10958","10929  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مُسْلِمُ بْنُ خَالِدٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَقَدْ أُهْدِيَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَحْمُ صَيْدٍ فَرَدَّهُ ، وَقَالَ :  إِنَّا حُرُمٌ  .","","Al-Mu'jam al-Kabir 10929","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن مسلم بن خالد الزنجي عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عباس"
"10959","10930  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ الْعَيْشِيُّ ،  ثَنَا  وُهَيْبٌ ،  ثَنَا  عَبْدُ اللهِ بْنُ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ الْمَسْجِدَ يَوْمَ الْجُمُعَةِ ، فَإِذَا هُوَ  بِأَبِي إِسْرَائِيلَ  قَائِمًا فِي الشَّمْسِ ، وَلَا يَسْتَظِلُّ ، فَقَالَ         [11/27]      النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا لَهُ ؟ "" قَالُوا : نَذَرَ أَنْ يَقُومَ وَلَا يَسْتَظِلَّ وَلَا يُفْطِرَ ، قَالَ :  مُرُوهُ فَلْيَجْلِسْ ، وَلْيَسْتَظِلَّ ، وَلْيُفْطِرْ  .","","Al-Mu'jam al-Kabir 10930","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن عبد الرحمن بن المبارك الخلقاني عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","طاوس عن ابن عباس"
"10960","10931  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  ،  ثَنَا  عَفَّانُ ،  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ  لِصَبِيحَةِ رَابِعَةٍ مُهِلِّينَ بِالْحَجِّ  ، فَأَمَرَهُمْ أَنْ يَجْعَلُوهَا عُمْرَةً ، فَتَعَاظَمَ ذَلِكَ عِنْدَهُمْ ، فَقَالُوا : يَا رَسُولَ اللهِ ، أَيُّ الْحِلِّ ؟ قَالَ :  الْحِلُّ كُلُّهُ  .","","Al-Mu'jam al-Kabir 10931","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","طاوس عن ابن عباس"
"10961","10932  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ ،  ثَنَا  أَبُو الْأَصْبَغِ عَبْدُ الْعَزِيزِ بْنُ يَحْيَى الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  ابْنِ طَاوُسٍ ،  وَعَنِ  السَّخْتِيَانِيِّ ،  عَنْ  طَاوُسٍ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اتَّقُوا بَيْتًا يُقَالُ لَهُ الْحَمَّامُ  فَقَالُوا : يَا رَسُولَ اللهِ يَذْهَبُ  بِالدَّرَنِ  ، وَيَنْفَعُ الْمَرِيضَ ، قَالَ : "" فَمَنْ دَخَلَهُ فَلْيَسْتَتِرْ  .","","Al-Mu'jam al-Kabir 10932","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد العزيز بن يحيى البكائي عن أحمد بن علي بن مسلم النخشبي عن الطبراني","طاوس عن ابن عباس"
"10962","10933  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَلَفٍ ،  ثَنَا  عُمَرُ بْنُ يُونُسَ ،  ثَنَا  سُلَيْمَانُ بْنُ أَبِي سُلَيْمَانَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا نَذْرَ إِلَّا فِيمَا أُطِيعَ         [11/28]      اللهُ فِيهِ  ، وَلَا نَذْرَ فِي قَطِيعَةِ رَحِمٍ ، وَلَا طَلَاقَ ، وَلَا عَتَاقَ فِيمَا لَا يَمْلِكُ  .","","Al-Mu'jam al-Kabir 10933","","عبد الله بن عباس عن طاوس بن كيسان عن يحيى بن أبي كثير عن سليمان بن أبي سليمان اليمامي عن عمر بن يونس بن القاسم عن محمد بن أحمد بن أبي خلف القطيعي عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"10963","10934  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ الصَّالِحِيُّ ،  ثَنَا  عُمَرُ بْنُ رَبَاحٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يُصَلِّي فِي  خَمِيصَةٍ  .","","Al-Mu'jam al-Kabir 10934","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن عمر بن رياح السعدي عن أيوب بن محمد بن أيوب القلب الصالحي عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"10964","10935  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ، (  ح  ) ،  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ، قَالَا :  ثَنَا  عُمَرُ بْنُ رَبَاحٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  أَحْيَا  أَرْضًا مَيْتَةً فَهُوَ أَحَقُّ بِهَا  .","","Al-Mu'jam al-Kabir 10935","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن عمر بن رياح السعدي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","طاوس عن ابن عباس"
"10965","10936  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ الصَّالِحِيُّ (  ح  ) ،  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ، قَالَا :  ثَنَا  عُمَرُ بْنُ رَبَاحٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَرْفَعُ يَدَيْهِ فِي كُلِّ رَكْعَةٍ  ، وَقَالَ  الصَّالِحِيُّ  : عِنْدَ كُلِّ تَكْبِيرَةٍ  .","","Al-Mu'jam al-Kabir 10936","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن عمر بن رياح السعدي عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"10966","10937  -  حَدَّثَنَا  سَهْلُ بْنُ مُوسَى شِيرَانُ ،  ثَنَا  عُمَرُ بْنُ يَحْيَى الْأُبُلِّيُّ ،  ثَنَا  عُمَرُ بْنُ رَبَاحٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،         [11/29]      قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يُصَلِّي فِي جُبَّةِ صُوفٍ وَحْدَهَا  .","","Al-Mu'jam al-Kabir 10937","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن عمر بن رياح السعدي عن عمر بن يحيى الأبلي عن شيران سهل بن موسى الرامهرمزي عن الطبراني","طاوس عن ابن عباس"
"10967","10938  -  حَدَّثَنَا  سَهْلُ بْنُ مُوسَى ،  ثَنَا  عُمَرُ بْنُ يَحْيَى (  ح  ) ،  وَحَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ الصَّالِحِيُّ ، قَالَا :  ثَنَا  عُمَرُ بْنُ رَبَاحٍ ،  ثَنَا  ابْنُ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحِجَامَةُ فِي الرَّأْسِ شِفَاءٌ مِنْ سَبْعٍ إِذَا مَا نَوَى صَاحِبُهَا  مِنَ الْجُنُونِ ، وَالْجُذَامِ ، وَالْبَرَصِ ، وَالنُّعَاسِ ، وَوَجَعِ الضِّرْسِ ، وَالصُّدَاعِ ، وَظُلْمَةٍ يَجِدُهَا فِي عَيْنَيْهِ  .","","Al-Mu'jam al-Kabir 10938","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن عمر بن رياح السعدي عن أيوب بن محمد بن أيوب القلب الصالحي عن علي بن سعيد بن بشير عليك عن الطبراني","طاوس عن ابن عباس"
"10968","10939  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  ثَنَا  عُمَرُ بْنُ يُونُسَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ بَعْدَ  التَّشَهُّدِ  : "" اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَذَابِ  جَهَنَّمَ  ، وَأَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ ، وَأَعُوذُ بِكَ مِنْ فِتْنَةِ  الدَّجَّالِ  ، وَأَعُوذُ بِكَ مِنْ فِتْنَةِ الْمَحْيَا وَالْمَمَاتِ  "" .","","Al-Mu'jam al-Kabir 10939","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن محمد بن عبد الله بن طاوس بن كيسان عن عمر بن يونس بن القاسم عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","طاوس عن ابن عباس"
"10969","10940  -  حَدَّثَنَا  أَحْمَدُ بْنُ سَعِيدِ بْنِ فَرْقَدٍ الْجُدِّيُّ ،  ثَنَا  أَبُو حُمَةَ مُحَمَّدُ بْنُ يُوسُفَ الزُّبَيْدِيُّ ،  أَنَا  عَبْدُ الرَّحْمَنِ بْنُ طَاوُسٍ ، مِنْ وَلَدِ طَاوُسٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ بْنِ طَاوُسٍ ،  عَنْ  طَاوُسٍ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      فَاقْرَءُوا مَا تَيَسَّرَ مِنَ الْقُرْآنِ         }      قَالَ : "" مِائَةَ آيَةٍ  .","","Al-Mu'jam al-Kabir 10940","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن محمد بن عبد الله بن طاوس بن كيسان عن عبد الرحمن بن طاوس من ولد طاوس عن محمد بن يوسف الزيادي عن أحمد بن سعيد بن فرقد الجدي عن الطبراني","طاوس عن ابن عباس"
"10970","[11/30]      10941  -  حَدَّثَنَا  أَحْمَدُ بْنُ سَعِيدِ بْنِ فَرْقَدٍ  ، ثَنَا  أَبُو حُمَةَ مُحَمَّدُ بْنُ يُوسُفَ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ زَيْدٍ ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  لَا طَلَاقَ إِلَّا بِعِدَّةٍ  ، وَلَا عِتْقَ إِلَّا لِوَجْهِ اللهِ تَعَالَى  ""  .","","Al-Mu'jam al-Kabir 10941","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن محمد بن عبد الله بن طاوس بن كيسان عن عبد الله بن محمد بن عبد الله الخزرجي عن محمد بن يوسف الزيادي عن أحمد بن سعيد بن فرقد الجدي عن الطبراني","طاوس عن ابن عباس"
"10971","10942  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  أَبُو عُمَرَ الضَّرِيرُ (  ح  ) ،  وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  سَهْلُ بْنُ بَكَّارٍ ، قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" صَلَّى الْعِيدَ بِلَا أَذَانٍ وَلَا إِقَامَةٍ  ، ثُمَّ أَتَى النِّسَاءَ فَوَعَظَهُنَّ وَحَثَّهُنَّ عَلَى الصَّدَقَةِ ، فَكَمْ مِنْ قِلَادَةٍ وَخَاتَمٍ أُلْقِيَ فِي ثَوْبِ  بِلَالٍ  حَتَّى مَلَأَ ثَوْبَهُ أَوْ مَا شَاءَ اللهُ  .","","Al-Mu'jam al-Kabir 10942","","عبد الله بن عباس عن طاوس بن كيسان عن جابر الجعفي عن الوضاح بن عبد الله اليشكري عن سهل بن بكار الدارمي عن أحمد بن داود بن موسى السدوسي عن الطبراني","طاوس عن ابن عباس"
"10972","10943  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ النَّسَائِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ رَافِعٍ النَّيْسَابُورِيُّ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  مُفَضَّلُ بْنُ مُهَلْهِلٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ فَتْحِ مَكَّةَ  :  إِنَّ هَذَا الْبَلَدَ حَرَامٌ حَرَّمَهُ اللهُ  ، وَلَمْ يُحِلَّ فِيهِ الْقَتْلَ لِأَحَدٍ قَبْلِي ، وَأُحِلَّتْ لِي فَهِيَ  حَرَامٌ  بِحُرْمَةِ  اللهِ  .","","Al-Mu'jam al-Kabir 10943","","عبد الله بن عباس عن طاوس بن كيسان عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن المفضل بن مهلهل السعدي عن يحيى بن آدم عن محمد بن رافع القشيري عن النسائي عن الطبراني","طاوس عن ابن عباس"
"10973","10944  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ         [11/31]      اللهُ عَنْهُمَا ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ فَتْحِ مَكَّةَ  :  لَا  هِجْرَةَ  بَعْدَ الْفَتْحِ ، وَلَكِنْ  جِهَادٌ  وَنِيَّةٌ  ، وَإِذَا  اسْتُنْفِرْتُمْ  فَانْفِرُوا  .","","Al-Mu'jam al-Kabir 10944","","عبد الله بن عباس عن طاوس بن كيسان عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10974","10945  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ النَّسَائِيُّ ،  أَنَا  مُحَمَّدُ بْنُ رَافِعٍ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  مُفَضَّلُ بْنُ مُهَلْهِلٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  سَافَرْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي رَمَضَانَ ، فَصَامَ حَتَّى بَلَغَ  عُسْفَانَ  ، ثُمَّ دَعَا بِإِنَاءٍ ، فَشَرِبَ بِهَا لِيَرَاهُ النَّاسُ ، ثُمَّ أَفْطَرَ حِينَ دَخَلَ  مَكَّةَ  ، وَافْتَتَحَ  مَكَّةَ  فِي رَمَضَانَ ، قَالَ  ابْنُ عَبَّاسٍ  : "" صَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي السَّفَرِ ، وَأَفْطَرَ ، فَمَنْ شَاءَ صَامَ وَمَنْ شَاءَ أَفْطَرَ  "" .","","Al-Mu'jam al-Kabir 10945","","عبد الله بن عباس عن طاوس بن كيسان عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن المفضل بن مهلهل السعدي عن يحيى بن آدم عن محمد بن رافع القشيري عن النسائي عن الطبراني","طاوس عن ابن عباس"
"10975","10946  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ الْمُحَارِبِيُّ ،  ثَنَا  أَبُو مُحَيَّاةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  كَانَ ثَمَنُ  الْمِجَنِّ  فِي عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَشَرَةَ دَرَاهِمَ  ""  .","","Al-Mu'jam al-Kabir 10946","","عبد الله بن عباس عن طاوس بن كيسان عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن يحيى بن يعلى بن حرملة التيمي عن محمد بن عبيد بن محمد بن واقد النحاس عن علي بن سعيد بن بشير عليك عن الطبراني","طاوس عن ابن عباس"
"10976","10947  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  هَاشِمُ بْنُ مُحَمَّدٍ الرُّبَيْعِيُّ ،  ثَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ ،  ثَنَا  سَعِيدُ بْنُ مِقْلَاصٍ ،  عَنْ  مُوسَى بْنِ أَعْيَنَ الْجَزَرِيِّ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  الْغُسْلُ  وَاجِبٌ  عَلَى كُلِّ مُسْلِمٍ فِي كُلِّ سَبْعَةِ أَيَّامٍ  شَعَرَةٌ وَبَشَرَةٌ  -  يَعْنِي فِي الْجُمُعَةِ  - . ""  سَعِيدُ بْنُ مِقْلَاصٍ ، هُوَ سَعِيدُ بْنُ أَبِي أَيُّوبَ  "" .","","Al-Mu'jam al-Kabir 10947","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن موسى بن أعين الجزري عن سعيد بن أبي أيوب الخزاعي عن المفضل بن فضالة عن هاشم بن محمد الربعي عن يحيى بن عثمان بن صالح عن الطبراني","طاوس عن ابن عباس"
"10977","[11/32]      10948  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ خَالِدٍ ،  ثَنَا  الْحَسَنُ بْنُ يَحْيَى الْخُشَنِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي يَوْمِ أَضْحَى :  مَا عَمِلَ ابْنُ آدَمَ فِي هَذَا الْيَوْمِ ، أَفْضَلَ مِنْ دَمٍ يُهَرَاقُ  ، إِلَّا أَنْ يَكُونَ رَحِمًا مَقْطُوعَةً تُوصَلُ  .","","Al-Mu'jam al-Kabir 10948","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن إسماعيل بن عياش الأحول عن الحسن بن يحيى الخشني عن هشام بن خالد السلامي عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عباس"
"10978","10949  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  عَبْدُ الْعَزِيزِ بْنُ يَحْيَى الْمَدِينِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  عَنْ  سُلَيْمَانَ بْنِ عِيسَى ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ بِمُؤْمِنٍ مُسْتَكْمِلِ الْإِيمَانِ مَنْ لَمْ يَعُدَّ الْبَلَاءَ نِعْمَةً ، وَالرَّخَاءَ مُصِيبَةً  قَالُوا : كَيْفَ يَا رَسُولَ اللهِ ؟ قَالَ : "" لِأَنَّ الْبَلَاءَ لَا يَتْبَعُهُ إِلَّا الرَّخَاءُ ، وَكَذَلِكَ الرَّخَاءُ لَا تَتْبَعُهُ إِلَّا الْمُصِيبَةُ ، وَلَيْسَ بِمُؤْمِنٍ مُسْتَكْمَلِ الْإِيمَانِ مَنْ لَمْ يَكُنْ فِي غَمٍّ مَا لَمْ يَكُنْ فِي صَلَاةٍ "" قَالُوا : وَلِمَ يَا رَسُولَ اللهِ ؟ قَالَ : "" لِأَنَّ الْمُصَلِّيَ يُنَاجِي رَبَّهُ ، وَإِذَا كَانَ فِي غَيْرِ صَلَاةٍ إِنَّمَا يُنَاجِي ابْنَ آدَمَ  .","","Al-Mu'jam al-Kabir 10949","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن سفيان الثوري عن سليمان بن عيسى بن نجيح السجزي عن عبد الله بن وهب المصري عن عبد العزيز بن يحيى بن عبد الله الهاشمي عن محمد بن علي بن زيد الصائغ عن الطبراني","طاوس عن ابن عباس"
"10979","10950  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،         [11/33]      عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مِنَ السُّنَّةِ أَنْ تَمَسَّ إِلْيَتَيْكَ عَقِبَيْكَ فِي الصَّلَاةِ  ""  .","","Al-Mu'jam al-Kabir 10950","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"10980","10951  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ،  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَسِّرُوا  وَلَا تُعَسِّرُوا  ، وَبَشِّرُوا وَلَا  تُنَفِّرُوا ،  وَإِذَا غَضِبْتَ فَاسْكُتْ  .","","Al-Mu'jam al-Kabir 10951","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","طاوس عن ابن عباس"
"10981","10952  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو رَبِيعَةَ فَهْدُ بْنُ عَوْفٍ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  أَشْرَكَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ الْحُدَيْبِيَةِ  بَيْنَ أَصْحَابِهِ سَبْعَةً فِي بَقَرَةٍ  .","","Al-Mu'jam al-Kabir 10952","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن عبد الواحد بن زياد عن زيد بن عوف القطعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10982","10953  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَإِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ، أَخُو الْحَجَّاجِ  ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي آخِذٌ  بِحُجَزِكُمْ  أَقُولُ اتَّقُوا النَّارَ اتَّقُوا الْحُدُودَ  ، فَإِذَا مُتُّ تَرَكْتُكُمْ ، وَأَنَا  فَرَطُكُمْ  عَلَى الْحَوْضِ ، فَمَنْ وَرَدَ فَقَدْ أَفْلَحَ ، فَيُؤْتَى بِأَقْوَامٍ فَيُؤْخَذُ بِهِمْ ذَاتَ الشِّمَالِ ، فَأَقُولُ : رَبِّ ، فَيَقُولُ : إِنَّهُمْ لَمْ يَزَالُوا بَعْدَكَ يَرْتَدُّوا عَلَى  أَعْقَابِهِمْ  .","","Al-Mu'jam al-Kabir 10953","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن عبد الواحد بن زياد عن محمد بن المنهال الأنماطي عن إبراهيم بن هاشم البغوي عن الطبراني","طاوس عن ابن عباس"
"10983","[11/34]      10954  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ،  ثَنَا  شَرِيكٌ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ  بِرَجُلٍ  يَطُوفُ  بِالْبَيْتِ  وَرَجُلٌ  يَقُودُهُ  بِحِزَامٍ  فِي أَنْفِهِ فِي نَذْرٍ كَانَ عَلَيْهِ فَقَطَعَهُ وَقَالَ :  قُدْهُ بِيَدِهِ  وَمَرَّ  بِرَجُلٍ  قَدْ رَبَطَ يَدَهُ إِلَى إِنْسَانٍ بِسَيْرٍ أَوْ بِخَيْطٍ أَوْ شَيْءٍ غَيْرِ ذَلِكَ فَقَطَعَهُ وَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قُدْهُ بِيَدِهِ  .","","Al-Mu'jam al-Kabir 10954","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن محمد بن سليمان لوين عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طاوس عن ابن عباس"
"10984","10955  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  مَعْنُ بْنُ عِيسَى ،  حَدَّثَنِي  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الطَّوَافُ  بِالْبَيْتِ  صَلَاةٌ  ، وَلَكِنَّ اللهَ تَعَالَى  أَحَلَّ  فِيهِ الْمَنْطِقَ ، فَمَنْ نَطَقَ فَلَا يَنْطِقْ إِلَّا بِخَيْرٍ  .","","Al-Mu'jam al-Kabir 10955","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن موسى بن أعين الجزري عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طاوس عن ابن عباس"
"10985","10956  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ ،  ثَنَا  أَبُو خَيْثَمَةَ مُصْعَبُ بْنُ سَعِيدٍ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا قَامَ أَحَدُكُمْ فِي الصَّلَاةِ فَلَا يُغْمِضْ عَيْنَيْهِ  .","","Al-Mu'jam al-Kabir 10956","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن موسى بن أعين الجزري عن مصعب بن سعيد المصيصي عن أحمد بن النضر بن بحر العسكري عن الطبراني","طاوس عن ابن عباس"
"10986","[11/35]      10957  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بنِ  الْبَرَاءِ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يُسَمِّي حَجَّةَ الْوَدَاعِ حَجَّةَ الْإِسْلَامِ  .  سقط من طبعة مكتبة ابن تيمية ، وهو على الصواب في النسخة الخطية .","","Al-Mu'jam al-Kabir 10957","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن محمد بن أحمد بن البراء العبدي عن الطبراني","طاوس عن ابن عباس"
"10987","10958  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  إِنَّمَا  رَمَلَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْبَيْتِ  ، وَبَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، لِأَنَّ الْمُشْرِكِينَ رَأَوْا بِهِ  جَهْدًا  وَبِأَصْحَابِهِ ، فَرَمَلَ  .","","Al-Mu'jam al-Kabir 10958","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن الفضيل بن عياض عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10988","10959  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ أَبُو جَعْفَرٍ التِّرْمِذِيُّ ،  ثَنَا  سَعِيدُ بْنُ عَمْرٍو الْأَشْعَثِيُّ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  وَنَافِعٍ  ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَقْتُلُ الْمُحْرِمُ الْغُرَابَ  ،  وَالْحِدَأَةَ  ، وَالْعَقْرَبَ ، وَالْكَلْبَ  الْعَقُورَ  ،  وَالْفَأْرَةَ  .","","Al-Mu'jam al-Kabir 10959","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن ليث بن أبي سليم عن عبد الرحيم بن سليمان الأشل عن سعيد بن عمرو بن سهل الأشعثي عن محمد بن أحمد بن نصر الترمذي عن الطبراني","طاوس عن ابن عباس"
"10989","10960  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُمِرَ ابْنُ آدَمَ أَنْ يَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  .","","Al-Mu'jam al-Kabir 10960","","عبد الله بن عباس عن طاوس بن كيسان عن حفص بن غياث النخعي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","طاوس عن ابن عباس"
"10990","[11/36]      10961  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَالِكٍ الضَّبِّيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رِزْمَةَ ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  دَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِكَتِفٍ  فَقَالَ :  ايتُونِي  بِكَتِفٍ  أَكْتُبُ لَكُمْ كِتَابًا لَا  تَخْتَلِفُوا  بَعْدِي أَبَدًا  وَأَخَذَ مَنْ عِنْدَهُ مِنَ النَّاسِ فِي لَغَطٍ ، فَقَالَتِ  امْرَأَةٌ  مِمَّنْ حَضَرَ : وَيْحَكُمْ عَهْدُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَيْكُمْ ! فَقَالَ بَعْضُ  الْقَوْمِ  : اسْكُتِي ، فَإِنَّهُ لَا عَقْلَ لَكِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَنْتُمْ لَا أَحْلَامَ لَكُمْ  .","","Al-Mu'jam al-Kabir 10961","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن محمد بن ميمون أبو حمزة السكري عن علي بن الحسن بن شقيق عن محمد بن عبد العزيز بن أبي رزمة عن محمد بن يحيى  بن مالك الأصبهاني عن الطبراني","طاوس عن ابن عباس"
"10991","10962  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ إِبْرَاهِيمَ بْنِ سُوَيْدٍ النَّخَعِيُّ ،  ثَنَا  هِلَالُ بْنُ مِقْلَاصٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ايتُونِي  بِكَتِفٍ  وَدَوَاةٍ أَكْتُبْ لَكُمْ كِتَابًا لَا يَخْتَلِفُ فِيهِ رَجُلَانِ  قَالَ : "" فَأَبْطَأُوا بِالْكَتِفِ وَالدَّوَاةِ فَقَبَضَهُ اللهُ  .","","Al-Mu'jam al-Kabir 10962","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن هلال بن أبي حميد عن يحيى بن زكريا بن إبراهيم النخعي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"10992","10963  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ اللَّيْلِ مَثْنَى مَثْنَى  ،  وَالْوِتْرُ  رَكْعَةٌ مِنْ آخِرِ اللَّيْلِ  .","","Al-Mu'jam al-Kabir 10963","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن إسماعيل بن عياش الأحول عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عباس"
"10993","10964  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ         [11/37]      الرَّيَّانُ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  عَنْ  لَيْثٍ ، وَمُجَاهِدٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ الْفَتْحِ  عَنْ لُحُومِ  الْجَلَّالَةِ  ، وَأَلْبَانِهَا ، وَظُهُورِهَا  .","","Al-Mu'jam al-Kabir 10964","","عبد الله بن عباس عن طاوس بن كيسان عن مجاهد بن جبر المخزومي عن حسان بن إبراهيم الكرماني عن محمد بن بكار الرصافي عن علي بن سعيد بن بشير عليك عن الطبراني","طاوس عن ابن عباس"
"10994","10965  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  شَرِيكٌ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  تَمَتَّعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى مَاتَ  ، وَتَمَتَّعَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ حَتَّى مَاتَ ،  وَعُمَرُ  وَعُثْمَانُ  رَضِيَ اللهُ عَنْهُمَا  .  يَعْنِي مُتْعَةَ  الْحَجِّ  .","","Al-Mu'jam al-Kabir 10965","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","طاوس عن ابن عباس"
"10995","10966  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  ثَنَا  لَيْثُ بْنُ أَبِي سُلَيْمٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  نَظَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  الْكَعْبَةِ  فَقَالَ : "" لَا إِلَهَ إِلَّا اللهُ مَا أَطْيَبَكِ  ، وَأَطْيَبَ رِيحَكِ ، وَأَعْظَمَ  حُرْمَتَكَ  ، وَالْمُؤْمِنُ أَعْظَمُ  حُرْمَةً  مِنْكِ ، إِنَّ اللهَ عَزَّ وَجَلَّ جَعَلَكِ حَرَامًا ، وَحَرَّمَ مِنَ الْمُؤْمِنِ مَالَهُ وَدَمَهُ وَعِرْضَهُ ، وَأَنْ نَظُنَّ بِهِ ظَنًّا سَيِّئًا  .","","Al-Mu'jam al-Kabir 10966","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن الحسن بن أبي جعفر الجفري عن حفص بن عمر الحوضى عن أحمد بن داود بن موسى السدوسي عن الطبراني","طاوس عن ابن عباس"
"10996","10967  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُسْلِمُ بْنُ         [11/38]      سَلَّامٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَبَّى فِي الْعُمْرَةِ حَتَّى  اسْتَلَمَ  الْحَجَرَ  ، وَفِي  الْحَجِّ  حَتَّى رَمَى الْجَمْرَةَ  .","","Al-Mu'jam al-Kabir 10967","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن عبد السلام بن حرب الملائي عن مسلم بن سلام الحنفي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طاوس عن ابن عباس"
"10997","10968  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْوَهَّابِ الصَّيْرَفِيُّ ،  ثَنَا  أَبُو قُتَيْبَةَ ،  أَنَا  شَرِيكٌ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْطَى جَدَّةً سُدُسًا  .","","Al-Mu'jam al-Kabir 10968","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن سلم بن قتيبة الشعيري عن عبد الرحمن بن عبد الوهاب الصيرفي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","طاوس عن ابن عباس"
"10998","10969  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  أَبُو صَالِحٍ عَبْدُ اللهِ بْنُ صَالِحٍ (  ح  ) ،  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ ، قَالَا :  ثَنَا  سَوَّارُ بْنُ مُصْعَبٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فَضْلُ الْعِلْمِ أَفْضَلُ مِنَ الْعِبَادَةِ  ،  وَمِلَاكُ  الدِّينِ  الْوَرَعُ  .","","Al-Mu'jam al-Kabir 10969","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن سوار بن مصعب المؤذن عن معلى بن مهدي الموصلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","طاوس عن ابن عباس"
"10999","10970  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْجَارُودِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ الْكِنْدِيُّ ،  ثَنَا  عِيسَى بْنُ سَوَادَةَ النَّخَعِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  سَمِعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَوْتَ رَجُلَيْنِ وَهُمَا يَقُولَانِ :  فَسَأَلَ عَنْهُمَا ، فَقِيلَ :  مُعَاوِيَةُ  وَعَمْرُو بْنُ الْعَاصِ  ، فَقَالَ :  اللَّهُمَّ أَرْكِسْهُمَا فِي الْفِتْنَةِ  رَكْسًا  وَدُعَّهُمَا إِلَى النَّارِ دَعًّا  .","","Al-Mu'jam al-Kabir 10970","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن عيسى بن سوادة النخعي عن عبد الله بن سعيد الأشج عن الجارودي أحمد بن علي الأصبهاني عن الطبراني","طاوس عن ابن عباس"
"11000","[11/39]      10971  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَحِلُّ  الرُّقْبَى  ، وَلَا  الْعُمْرَى  فَمَنْ  أُرْقِبَ  شَيْئًا أَوْ  أُعْمِرَ  شَيْئًا فَهُوَ لَهُ  .","","Al-Mu'jam al-Kabir 10971","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن سفيان الثوري عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طاوس عن ابن عباس"
"11001","10972  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  قَطَنُ بْنُ نُسَيْرٍ الذَّرَّاعُ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  ثَنَا  لَيْثٌ ،  عَنْ  عَطَاءٍ ، وَطَاوُسٍ ، وَمُجَاهِدٍ ،  عَنْ  جَابِرٍ ، وَابْنِ عَبَّاسٍ ، قَالَ :  قَدِمْنَا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلَا نُرِيدُ إِلَّا  الْحَجَّ  ، فَأَهْلَلْنَا بِالْحَجِّ ، وَطَافَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى رَاحِلَتِهِ يَسْتَلِمُ الرُّكْنَ  بِمِحْجَنٍ  كَانَ مَعَهُ ، ثُمَّ عَدَلَ إِلَى السِّقَايَةِ فَقَالَ : "" انْزِعُوا لِي مِنْهَا "" ، فَنَزَعُوا لَهُ دَلْوًا ، فَأَخَذَ حَسْوَةً فَمَضْمَضَ ، ثُمَّ مَجَّهُ فِي الدَّلْوِ ، ثُمَّ قَالَ : "" أَعِيدُوهُ فِيهَا "" فَقَالَ : "" يَا  بَنِي هَاشِمٍ ،  إِنَّكُمْ عَلَى عَمَلٍ صَالِحٍ لَوْلَا أَنْ تُغْلَبُوا عَلَيْهِ أَوْ تُتَّخَذَ سُنَّةً لَأَخَذْتُ مَعَكُمْ ، ثُمَّ أَتَى مَنْزِلَهُ فَخَطَبَ أَصْحَابَهُ وَقَالَ :  إِنَّ الْعُمْرَةَ قَدْ  دَخَلَتْ  فِي حَجِّكُمْ  فَحُلُّوا إِلَّا مَنْ كَانَ مَعَهُ هَدْيٌ "" وَقَالَ : "" لَوْلَا أَنَّ مَعِيَ هَدْيًا لَكَثَّرْتُكُمْ "" فَقَامَ  سُرَاقَةُ بْنُ مَالِكٍ  فَقَالَ : يَا رَسُولَ اللهِ أَلِعَامِنَا أَمْ  لِلْأَبَدِ  ؟ قَالَ : "" بَلْ  لِلْأَبَدِ  "" ، وَكَانَ يُعْجِبُهُمْ مَا وَافَقَ صَنِيعُهُمْ صَنِيعَ أَهْلِ الْجَاهِلِيَّةِ ، وَكَانَ أَهْلُ الْجَاهِلِيَّةِ يَقُولُونَ : إِذَا انْسَلَخَ صَفَرُ ،  وَعَفَا  الْوَبَرُ  ، وَبَرَأَ  الدَّبَرُ  فَقَدْ  حَلَّتِ  الْعُمْرَةُ لِمَنِ اعْتَمَرَ  .","","Al-Mu'jam al-Kabir 10972","","عبد الله بن عباس عن عطاء بن أبي رباح عن ليث بن أبي سليم عن عبد الوارث بن سعيد بن ذكوان عن قطن بن نسير الغبري عن الحسن بن علي بن شبيب المعمري عن الطبراني","طاوس عن ابن عباس"
"11002","10973  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  أَبِي  ،  ثَنَا         [11/40]      يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  ثَنَا  الْهَيَّاجُ بْنُ بِسْطَامٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَيَكُونُ أُمَرَاءٌ يَعْرِفُونَ وَيُنْكِرُونَ  ، فَمَنْ نَابَذَهُمْ نَجَا ، وَمَنِ اعْتَزَلَهُمْ سَلِمَ ، وَمَنْ خَالَطَهُمْ هَلَكَ  .","","Al-Mu'jam al-Kabir 10973","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن هياج بن بسطام البرجمي عن يحيى بن أبي بكير عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","طاوس عن ابن عباس"
"11003","10974  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  سَوَّارُ بْنُ مُصْعَبٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ، وَطَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ فِي الْبَقَرِ  الْعَوَامِلِ  صَدَقَةٌ  ، وَلَكِنْ فِي كُلِّ ثَلَاثِينَ  تَبِيعٌ  وَفِي كُلِّ أَرْبَعِينَ  مُسِنٌّ  أَوْ  مُسِنَّةٌ  .","","Al-Mu'jam al-Kabir 10974","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن سوار بن مصعب المؤذن عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","طاوس عن ابن عباس"
"11004","10975  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ،  ثَنَا  خَالِدُ بْنُ خِدَاشٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَتِ الثَّلَاثُ تُجْعَلُ وَاحِدَةً عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ""  .","","Al-Mu'jam al-Kabir 10975","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن أيوب السختياني عن حماد بن زيد عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","طاوس عن ابن عباس"
"11005","10976  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْوَهَّابِ الْحَارِثِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الطَّوَافُ صَلَاةٌ فَأَقِلُّوا فِيهِ الْكَلَامَ  .","","Al-Mu'jam al-Kabir 10976","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن محمد بن عبد الله بن عبيد الليثي عن محمد بن عبد الواهب بن الزبير الحارثي عن عبد الله بن أحمد بن حنبل عن الطبراني","طاوس عن ابن عباس"
"11006","[11/41]      10977  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  حَمَّادُ بْنُ الْحَسَنِ بْنِ عَنْبَسَةَ الْوَرَّاقُ ،  ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ مَثَّلَ بِالشَّعْرِ ، فَلَيْسَ لَهُ عِنْدَ اللهِ  خَلَاقٌ  .","","Al-Mu'jam al-Kabir 10977","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن محمد بن مسلم بن سوسن الطائفي عن حجاج بن نصير الفساطيطي عن حماد بن الحسن بن عنبسة النهشلي عن أحمد بن يحيى بن زهير التستري عن الطبراني","طاوس عن ابن عباس"
"11007","10978  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ سَلِمَةَ ، وَإِبْرَاهِيمَ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ  صَفْوَانَ بْنَ أُمَيَّةَ  ، قَدِمَ  الْمَدِينَةَ  فَنَامَ فِي الْمَسْجِدِ وَوَضَعَ  خَمِيصَةً  لَهُ تَحْتَ رَأْسِهِ ، فَأَتَى سَارِقٌ فَسَرَقَهَا ، فَجَاءَ بِهِ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَمَرَ بِهِ أَنْ يُقْطَعَ ، فَقَالَ  صَفْوَانُ  : يَا رَسُولَ اللهِ هِيَ لَهُ ، قَالَ :  فَهَلَّا قَبْلَ أَنْ تَأْتِيَنِي بِهِ  .","","Al-Mu'jam al-Kabir 10978","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن سفيان بن عيينة عن يعقوب بن حميد بن كاسب المدني عن محمد بن علي بن زيد الصائغ عن الطبراني","طاوس عن ابن عباس"
"11008","10979  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ أَبِي عُمَرَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ ، وَقَالَ : ""  اشْكُمُوهُ  .","","Al-Mu'jam al-Kabir 10979","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن سفيان بن عيينة عن ابن أبي عمر العدني عن عبد الله بن أحمد الجواليقي عن الطبراني","طاوس عن ابن عباس"
"11009","10980  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ الْعُمَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رُبَّ مُعَلِّمِ حُرُوفِ أَبِي جَادٍ دَارِسٌ فِي النُّجُومِ  لَيْسَ لَهُ عِنْدَ اللهِ  خَلَاقٌ  يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 10980","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن محمد بن مسلم بن سوسن الطائفي عن خالد بن يزيد الحذاء عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"11010","[11/42]      10981  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  إِبْرَاهِيمُ بْنُ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ ذَكَرَ قَوْلَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غُسْلِ يَوْمِ الْجُمُعَةِ  ، فَقُلْتُ  لِابْنِ عَبَّاسٍ  وَيَمَسُّ طِيبًا أَوْ دُهْنًا إِنْ كَانَ لِأَهْلِهِ ؟ قَالَ : "" لَا أَعْلَمُهُ  ""  .","","Al-Mu'jam al-Kabir 10981","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"11011","10982  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  أُسَامَةُ بْنُ زَيْدٍ ،  حَدَّثَنِي  الْحَسَنُ بْنُ مُسْلِمٍ ،  عَنْ  طَاوُسٍ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ، يَقُولُ :  سَنَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ السَّفَرِ رَكْعَتَيْنِ رَكْعَتَيْنِ  ، وَسَنَّ صَلَاةَ الْحَضَرِ أَرْبَعَ رَكَعَاتٍ  .","","Al-Mu'jam al-Kabir 10982","","عبد الله بن عباس عن طاوس بن كيسان عن الحسن بن مسلم بن يناق عن أسامة بن زيد الليثي المدني عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","طاوس عن ابن عباس"
"11012","10983  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  شَهِدْتُ الْعِيدَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" فَبَدَأَ بِالصَّلَاةِ قَبْلَ الْخُطْبَةِ  .","","Al-Mu'jam al-Kabir 10983","","عبد الله بن عباس عن طاوس بن كيسان عن الحسن بن مسلم بن يناق عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"11013","10984  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  سُلَيْمَانَ الْأَحْوَلِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ وَهُوَ يَطُوفُ  بِالْكَعْبَةِ  بِإِنْسَانٍ  يَقُودُ  إِنْسَانًا  بِخِزَامَةٍ بِأَنْفِهِ  ، فَقَطَعَهَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ أَمَرَهُ أَنْ يَقُودَ بِيَدِهِ  .","","Al-Mu'jam al-Kabir 10984","","عبد الله بن عباس عن طاوس بن كيسان عن سليمان بن أبي مسلم الأحول عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"11014","10985  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ         [11/43]      ابْنِ جُرَيْجٍ ،  عَنْ  سُلَيْمَانَ الْأَحْوَلِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ وَهُوَ يَطُوفُ  بِالْكَعْبَةِ  بِإِنْسَانٍ  قَدْ رَبَطَ يَدَهُ إِلَى  إِنْسَانٍ  آخَرَ  بِسَيْرٍ أَوْ خَيْطٍ أَوْ بِشَيْءٍ غَيْرِ ذَلِكَ  فَقَطَعَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَالَ :  قُدْهُ بِيَدِكَ  .","","Al-Mu'jam al-Kabir 10985","","عبد الله بن عباس عن طاوس بن كيسان عن سليمان بن أبي مسلم الأحول عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"11015","10986  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  سُلَيْمَانَ الْأَحْوَلِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ النَّاسُ يَنْصَرِفُونَ فِي كُلِّ وَجْهٍ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَنْفِرَنَّ أَحَدٌ حَتَّى يَكُونَ آخِرُ عَهْدِهِ  بِالْبَيْتِ  .","","Al-Mu'jam al-Kabir 10986","","عبد الله بن عباس عن طاوس بن كيسان عن سليمان بن أبي مسلم الأحول عن سفيان بن عيينة عن سعيد بن منصور عن محمد بن علي بن زيد الصائغ عن الطبراني","طاوس عن ابن عباس"
"11016","10987  -  حَدَّثَنَا  الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  أَخْبَرَنِي  سُلَيْمَانُ الْأَحْوَلُ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا قَامَ مِنَ اللَّيْلِ يَتَهَجَّدُ قَالَ : "" اللَّهُمَّ لَكَ الْحَمْدُ أَنْتَ نُورُ السَّمَاوَاتِ وَالْأَرْضِ  وَمَنْ فِيهِنَّ ، وَلَكَ الْحَمْدُ أَنْتَ قَيُّومُ السَّمَاوَاتِ وَالْأَرْضِ ، وَمَنْ فِيهِنَّ ، وَلَكَ الْحَمْدُ أَنْتَ مَلِكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَنْ فِيهِنَّ ، وَلَكَ الْحَمْدُ أَنْتَ الْحَقُّ وَقَوْلُكَ حَقٌّ ، وَلِقَاؤُكَ حَقٌّ ، وَالْجَنَّةُ حَقٌّ ، وَالنَّارُ حَقٌّ ، وَالسَّاعَةُ حَقٌّ ،  وَمُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَقٌّ ، وَالنَّبِيُّونَ حَقٌّ اللَّهُمَّ لَكَ أَسْلَمْتُ ، وَبِكَ آمَنْتُ وَعَلَيْكَ تَوَكَّلْتُ ، وَإِلَيْكَ  أَنَبْتُ ،  وَبِكَ خَاصَمْتُ وَإِلَيْكَ  حَاكَمْتُ  فَاغْفِرْ         [11/44]      لِي مَا قَدَّمْتُ وَمَا أَخَّرْتُ ، وَمَا أَسْرَرْتُ وَمَا أَعْلَنْتُ أَنْتَ الْمُقَدِّمُ وَأَنْتَ الْمُؤَخِّرُ لَا إِلَهَ إِلَّا أَنْتَ  .","","Al-Mu'jam al-Kabir 10987","","عبد الله بن عباس عن طاوس بن كيسان عن سليمان بن أبي مسلم الأحول عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"11017","10988  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  هِشَامِ بْنِ حُجَيْرٍ ،  عَنْ  طَاوُسٍ ، أَوْ غَيْرِهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  الْحِجْرُ مِنَ  الْبَيْتِ  قَالَ اللهُ :         {      وَلْيَطَّوَّفُوا بِالْبَيْتِ الْعَتِيقِ         }      ،  وَطَافَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ وَرَائِهِ  .","","Al-Mu'jam al-Kabir 10988","","عبد الله بن عباس عن غيره عن هشام بن حجير الحجازي عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"11018","10989  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ أَبِي زَائِدَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ رَجَعَ فِي هِبَتِهِ فَهُوَ كَالرَّاجِعِ فِي قَيْئِهِ  .","","Al-Mu'jam al-Kabir 10989","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن يحيى بن زكريا بن أبي زائدة عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"11019","10990  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَبَّى حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  يَوْمَ النَّحْرِ  .","","Al-Mu'jam al-Kabir 10990","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن إسماعيل ابن علية عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"11020","10991  -  حَدَّثَنَا  خَلَفُ بْنُ عَمْرٍو الْعُكْبَرِيُّ ،  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سَلَمَةُ بْنُ سِيسَنَ الْخَيَّاطُ الْمَكِّيُّ ،  حَدَّثَنِي  بِشْرُ بْنُ عُبَيْدٍ ، وَكَانَ شَيْخًا قَدِيمًا قَالَ :  كُنَّا مَعَ  طَاوُسٍ  عِنْدَ  الْمَقَامِ  فَسَمِعْنَا ضَوْضَاءَةً ، فَقَالَ : مَا هَذَا ؟ فَقِيلَ : قَوْمٌ أَخَذَهُمُ  ابْنُ هِشَامٍ  فِي سَبَبٍ فَطَوَّقَهُمْ ،  فَسَمِعْتُ  طَاوُسًا  يُحَدِّثُ عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ أَحَدٍ يُحْدِثُ فِي هَذِهِ الْأُمَّةِ حَدَثًا لَمْ يَكُنْ فَيَمُوتُ حَتَّى يُصِيبَهُ ذَلِكَ  . فَأَنَا رَأَيْتُ  ابْنَ هِشَامٍ  حِينَ عُزِلَ ، وَأَتَى عُمَّالُ  الْوَلِيدِ  فَطَوَّقُوهُ  .","","Al-Mu'jam al-Kabir 10991","","عبد الله بن عباس عن طاوس بن كيسان عن بشر بن عبيد عن سلمة بن سيسن المكى عن الحميدي عن خلف بن عمرو بن عبد الرحمن العكبري عن الطبراني","طاوس عن ابن عباس"
"11021","[11/45]      10992  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَرْوَزِيُّ ،  ثَنَا  أَبُو الدَّرْدَاءِ عَبْدُ الْعَزِيزِ بْنُ الْمُنِيبِ ،  حَدَّثَنِي  إِسْحَاقُ بْنُ عَبْدِ اللهِ بْنِ كَيْسَانَ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنْ  مُجَاهِدٍ ، وَطَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَمْسٌ بِخَمْسٍ "" قَالُوا : يَا رَسُولَ اللهِ وَمَا خَمْسٌ بِخَمْسٍ  ؟ قَالَ : "" مَا نَقَضَ قَوْمٌ الْعَهْدَ إِلَّا سُلِّطَ عَلَيْهِمْ عَدُوُّهُمْ ، وَمَا حَكَمُوا بِغَيْرِ مَا أَنْزَلَ اللهُ إِلَّا فَشَا فِيهِمُ الْفَقْرُ ، وَلَا ظَهَرَتْ فِيهِمُ الْفَاحِشَةُ إِلَّا فَشَا فِيهِمُ الْمَوْتُ ، وَلَا طَفَّفُوا الْمِكْيَالَ إِلَّا مُنِعُوا النَّبَاتَ وَأُخِذُوا بِالسِّنِينَ ، وَلَا مَنَعُوا الزَّكَاةَ إِلَّا حُبِسَ عَنْهُمُ الْقَطْرُ  .","","Al-Mu'jam al-Kabir 10992","","عبد الله بن عباس عن طاوس بن كيسان عن الضحاك بن مزاحم الهلالي عن عبد الله بن كيسان المروزي عن إسحاق بن عبد الله بن كيسان المروزي عن عبد العزيز بن منيب المروزي عن محمد بن علي بن محمد المروزي عن الطبراني","طاوس عن ابن عباس"
"11022","10993  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  جُنَادَةُ بْنُ سَلْمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ بَعْدَ التَّكْبِيرِ  وَبَعْدَ أَنْ يَقُولَ : "" وَجَّهْتُ وَجْهِيَ لِلَّذِي فَطَرَ السَّمَاوَاتِ وَالْأَرْضَ حَنِيفًا مُسْلِمًا ، اللَّهُمَّ لَكَ الْحَمْدُ أَنْتَ نُورُ السَّمَاوَاتِ وَالْأَرْضِ وَمَنْ فِيهِنَّ أَنْتَ الْحَقُّ ، وَوَعْدُكَ حَقُّ وَلِقَاؤُكَ حَقٌّ وَالْجَنَّةُ حَقٌّ وَالنَّارُ حَقٌّ وَالسَّاعَةُ حَقٌّ ، اللَّهُمَّ لَكَ أَسْلَمْتُ وَبِكَ آمَنْتُ ، وَعَلَيْكَ تَوَكَّلْتُ وَإِلَيْكَ  أَنَبْتُ ،  وَبِكَ خَاصَمْتُ وَإِلَيْكَ  حَاكَمْتُ ،  فَاغْفِرْ لِي مَا قَدَّمْتُ وَمَا أَخَّرْتُ ، وَمَا أَسْرَرْتُ وَمَا أَعْلَنْتُ ، اللَّهُمَّ أَنْتَ إِلَهِي لَا إِلَهَ إِلَّا أَنْتَ "" ، ثُمَّ يَقْرَأُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدَ هَذَا  .","","Al-Mu'jam al-Kabir 10993","","عبد الله بن عباس عن طاوس بن كيسان عن أبو الزبير المكي عن عبيد الله بن عمر العمري عن جنادة بن سلم العامري عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","طاوس عن ابن عباس"
"11023","10994  -  حَدَّثَنَا  وَرْدُ بْنُ أَحْمَدَ بْنِ لَبِيدٍ الْبَيْرُوتِيُّ ،  ثَنَا         [11/46]      صَفْوَانُ بْنُ صالح  ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  سَعِيدِ بْنِ بَشِيرٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَقَدْ أُهْدِيَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِكُرَاعِ الْغَمِيرِ  رِجْلُ حِمَارٍ وَحْشِيٍّ  ، فَرَدَّهُ إِلَى صَاحِبِهِ ، وَاعْتَذَرَ إِلَيْهِ وَقَالَ : "" إِنَّا مُحْرِمُونَ  .  في طبعة مكتبة ابن تيمية : ( سالم ) والمثبت من نسخة أحمد الثالث والمعجم الأوسط للمصنف","","Al-Mu'jam al-Kabir 10994","","عبد الله بن عباس عن طاوس بن كيسان عن أبو الزبير المكي عن سعيد بن بشير الأزدي عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن محمد بن أحمد بن لبيد عن الطبراني","طاوس عن ابن عباس"
"11024","10995  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  عَطَاءٍ ، قَالَ  مُحَمَّدُ بْنُ فُضَيْلٍ  :  وَثَنَا  الْحَجَّاجُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعَائِدُ فِي هِبَتِهِ كَالْعَائِدِ فِي قَيْئِهِ  .","","Al-Mu'jam al-Kabir 10995","","عبد الله بن عباس عن طاوس بن كيسان عن أبو الزبير المكي عن حجاج بن أرطاة عن محمد بن فضيل بن غزوان عن يحيى بن سليمان بن يحيى عن روح بن الفرج القطان عن الطبراني","طاوس عن ابن عباس"
"11025","10996  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، وَطَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُعَلِّمُنَا  التَّشَهُّدَ  كَمَا يُعَلِّمُنَا الْقُرْآنَ  ، وَكَانَ يَقُولُ : ""  التَّحِيَّاتُ  الْمُبَارَكَاتُ ، الصَّلَوَاتُ الطَّيِّبَاتُ لِلهِ ، سَلَامٌ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ  .  قَالَ  يَحْيَى بْنُ بُكَيْرٍ  : وَكَانَ  اللَّيْثُ  يَأْخُذُ بِهِ  .","","Al-Mu'jam al-Kabir 10996","","عبد الله بن عباس عن طاوس بن كيسان عن أبو الزبير المكي عن الليث بن سعد عن يحيى بن عبد الله بن بكير المخزومي عن عمرو بن أبي الطاهر المصري عن الطبراني","طاوس عن ابن عباس"
"11026","10997  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْحَجَّاجِ بْنِ رِشْدِينَ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ، أَنَّ أَبَا الزُّبَيْرِ ،  حَدَّثَهُ  عَنْ  عَطَاءٍ ، وَطَاوُسٍ ، وَسَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 10997","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو الزبير المكي عن عمرو بن الحارث بن يعقوب عن رشدين بن سعد المهري عن حجاج بن رشدين المصري عن محمد بن الحجاج بن رشدين المهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","طاوس عن ابن عباس"
"11027","[11/47]      10998  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  طَاوُسًا يَقُولُ :  قُلْتُ  لِابْنِ عَبَّاسٍ فِي  الْإِقْعَاءِ  عَلَى الْقَدَمَيْنِ قَالَ : "" هِيَ السُّنَّةُ  ، فَقُلْتُ : إِنَّا لَنَرَاهُ جَفَاءً  بِالرَّجُلِ  ، فَقَالَ : "" هِيَ سُنَّةُ نَبِيِّكَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 10998","","عبد الله بن عباس عن طاوس بن كيسان عن أبو الزبير المكي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"11028","10999  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْفُضَيْلِ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعَائِدُ فِي هِبَتِهِ كَالْعَائِدِ فِي قَيْئِهِ  .","","Al-Mu'jam al-Kabir 10999","","عبد الله بن عباس عن طاوس بن كيسان عن أبو الزبير المكي عن حجاج بن أرطاة عن محمد بن فضيل بن غزوان عن يحيى بن سليمان بن يحيى عن روح بن الفرج القطان عن الطبراني","طاوس عن ابن عباس"
"11029","11000  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  أَبُو الْمُعَافَى مُحَمَّدُ بْنُ وَهْبِ بْنِ أَبِي كَرِيمَةَ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تُرْقِبُوا أَمْوَالَكُمْ  ، فَمَنْ  أَرْقَبَ  شَيْئًا فَهُوَ لِمَنْ أُرْقِبَهُ  .  وَالرُّقْبَى أَنْ يَقُولَ الرَّجُلُ : هَذَا لِفُلَانٍ مَا عَاشَ ، فَإِنْ مَاتَ فُلَانٌ فَهُوَ لِفُلَانٍ  .","","Al-Mu'jam al-Kabir 11000","","عبد الله بن عباس عن طاوس بن كيسان عن أبو الزبير المكي عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن محمد بن وهب بن عمر الحراني عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"11030","11001  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ،  ثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ ،  ثَنَا  يَحْيَى بْنُ أَبِي قُتَيْلَةَ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  مَالِكٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  أَبِي مَعْبَدٍ ، وَطَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مُزْدَلِفَةُ  كُلُّهَا مَوْقِفٌ  ، وَارْتَفِعُوا عَنْ بَطْنِ  مُحَسِّرٍ  ،  وَمِنًى  كُلُّهَا مَنْحَرٌ  .","","Al-Mu'jam al-Kabir 11001","","عبد الله بن عباس عن طاوس بن كيسان عن أبو الزبير المكي عن زياد بن سعد الخراساني عن مالك بن أنس عن عبد العزيز بن أبي حازم المخزومي عن يحيى بن إبراهيم بن عثمان السلمي عن عبد الله بن شبيب الربعي عن البزار عن الطبراني","طاوس عن ابن عباس"
"11031","[11/48]      11002  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ ،  ثَنَا  عَمِّي  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ مَاهَانَ بْنِ أَبِي حَنِيفَةَ ،  ثَنَا  أَبِي  ،  عَنْ  طَلْحَةَ بْنِ زَيْدٍ ،  عَنْ  يَزِيدَ بْنِ سِنَانٍ ،  عَنْ  يَزِيدَ بْنِ جَابِرٍ الدِّمَشْقِيِّ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَرَأَ السُّورَةَ الَّتِي يُذْكَرُ فِيهَا  آلُ عِمْرَانَ  يَوْمَ الْجُمُعَةِ  صَلَّى اللهُ عَلَيْهِ وَمَلَائِكَتُهُ حَتَّى تَجِبَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 11002","","عبد الله بن عباس عن طاوس بن كيسان عن يزيد بن جابر الأزدي عن يزيد بن سنان الرهاوي عن طلحة بن زيد الرقي عن محمد بن ماهان القصباني عن أحمد بن أبي حنيفة محمد بن ماهان عن محمد بن حنيفة القصبى عن الطبراني","طاوس عن ابن عباس"
"11032","11003  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّزِايُّ ،  ثَنَا  أَبُو حَسَّانَ الزِّيَادِيُّ ،  ثَنَا  شُعَيْبُ بْنُ صَفْوَانَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ خَلَقَ هَذَا الْبَلَدَ يَوْمَ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ  ، وَصَاغَهُ حِينَ صَاغَ الشَّمْسَ وَالْقَمَرَ ، وَمَا حِيَالُهُ مِنَ السَّمَاءِ حَرَامٌ ، وَإِنَّهُ لَا يَحِلُّ لِأَحَدٍ قَبْلِي ، وَإِنَّمَا حَلَّ لِي سَاعَةً مِنْ نَهَارٍ ، ثُمَّ عَادَ كَمَا كَانَ "" فَقِيلَ لَهُ : هَذَا  خَالِدُ بْنُ الْوَلِيدِ  يَقْتُلُ قَالَ : "" قُمْ يَا فُلَانُ ، فَائْتِ  خَالِدَ بْنَ الْوَلِيدِ  فَلْيَرْفَعْ يَدَهُ مِنَ الْقَتْلِ ، فَأَتَاهُ  الرَّجُلُ  فَقَالَ : إِنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : "" اقْتُلْ مَنْ قَدَرْتَ عَلَيْهِ "" فَقَتَلَ سَبْعِينَ إِنْسَانًا ، فَأُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذُكِرَ ذَلِكَ لَهُ ، فَأَرْسَلَ إِلَى  خَالِدٍ  ، فَقَالَ : "" أَلَمْ أَنْهَكَ عَنِ الْقَتْلِ ؟ "" فَقَالَ : جَاءَنِي فُلَانٌ ، فَأَمَرَنِي أَنْ أَقْتُلَ مَنْ قَدَرْتُ عَلَيْهِ ، فَأَرْسَلَ إِلَيْهِ : "" أَلَمْ آمُرْكَ ؟ "" قَالَ : أَرَدْتَ أَمْرًا وَأَرَادَ اللهُ أَمْرًا ، فَكَانَ أَمْرُ اللهِ فَوْقَ أَمْرِكَ ، وَمَا اسْتَطَعْتُ إِلَّا الَّذِي         [11/49]      كَانَ ، فَسَكَتَ عَنْهُ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَمَا رَدَّ عَلَيْهِ شَيْئًا  .","","Al-Mu'jam al-Kabir 11003","","عبد الله بن عباس عن طاوس بن كيسان عن عطاء بن السائب عن شعيب بن صفوان الأبناوي عن الحسن بن عثمان الزيادي عن علي بن سعيد بن بشير عليك عن الطبراني","طاوس عن ابن عباس"
"11033","11004  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ ،  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ، وَيَحْيَى بْنُ بُكَيْرٍ ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا طَلَاقَ إِلَّا مِنْ بَعْدِ مِلْكٍ  ، وَلَا عِتْقَ إِلَّا مِنْ بَعْدِ مِلْكٍ  .","","Al-Mu'jam al-Kabir 11004","","عبد الله بن عباس عن طاوس بن كيسان عن محمد بن المنكدر عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","طاوس عن ابن عباس"
"11034","11005  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ ،  ثَنَا  أَبُو مُوسَى الْأَنْصَارِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  عَرَفَةُ  كُلُّهَا مَوْقِفٌ  ، وَارْتَفِعُوا عَنْ  بَطْنِ عُرَنَةَ  .","","Al-Mu'jam al-Kabir 11005","","عبد الله بن عباس عن طاوس بن كيسان عن زيد بن أسلم عن محمد بن المنكدر عن سفيان بن عيينة عن إسحاق بن موسى الخطمي عن عبيد العجل عن الطبراني","طاوس عن ابن عباس"
"11035","11006  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ ،  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  شَقِيقِ بْنِ بِشْرٍ الْعِجْلِيُّ  ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْضَاءٍ  ، وَأَنْ لَا  أَكُفَّ  لِي ثَوْبًا وَلَا شَعَرًا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( سقيف بن بشر العجلي )","","Al-Mu'jam al-Kabir 11006","","عبد الله بن عباس عن طاوس بن كيسان عن سقيف بن بشر العجلي عن عيسى بن يونس بن أبي إسحاق عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطبراني","طاوس عن ابن عباس"
"11036","11007  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  يُوسُفُ بْنُ يَزِيدَ أَبُو مَعْشَرٍ الْبَرَّاءُ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ الْأَخْنَسِ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي حُسَيْنٍ ، أَنَّ طَاوُسًا ،  أَخْبَرَهُ  ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  وُجِّهْنَا عَلَى سَبْعَةِ أَعْظُمٍ  ، وَأُمِرْنَا أَنْ لَا  نَكُفَّ  ثَوْبًا ، وَلَا شَعَرًا  .","","Al-Mu'jam al-Kabir 11007","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن عبد الرحمن بن أبي حسين النوفلي عن عبيد الله بن الأخنس النخعي عن يوسف بن يزيد البراء عن عبيد الله بن عمر القواريري عن محمد بن عبدوس السراج عن الطبراني","طاوس عن ابن عباس"
"11037","[11/50]      11008  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِسْحَاقُ بْنُ يُوسُفَ الْأَزْرَقُ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا أَوْ  يَمْنَحْهَا  أَخَاهُ  .","","Al-Mu'jam al-Kabir 11008","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الملك بن ميسرة الهلالي عن مسعر بن كدام عن إسحاق بن يوسف الأزرق عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","طاوس عن ابن عباس"
"11038","11009  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمْ نَرَ لِلْمُتَحَابَّيْنِ مِثْلَ النِّكَاحِ  .","","Al-Mu'jam al-Kabir 11009","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن محمد بن مسلم بن سوسن الطائفي عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","طاوس عن ابن عباس"
"11039","11010  -  حَدَّثَنَا  إِسْحَاقُ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مِنَ السُّنَّةِ أَنْ تَمَسَّ عَقِبَيْكَ أَلْيَتَيْكَ  "" .","","Al-Mu'jam al-Kabir 11010","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","طاوس عن ابن عباس"
"11040","11011  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ، وَأَبُو خَلِيفَةَ ، قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  ، وَلَا  أَكُفَّ  شَعَرًا ، وَلَا ثَوْبًا  .","","Al-Mu'jam al-Kabir 11011","","عبد الله بن عباس عن طاوس بن كيسان عن إبراهيم بن ميسرة الطائفي عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن الفضل بن الحباب الجمحي عن الطبراني","طاوس عن ابن عباس"
"11041","11012  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ، قَالَا :  ثَنَا  عِمْرَانُ الْقَصِيرُ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ  كَانَ إِذَا قَامَ مِنَ اللَّيْلِ كَبَّرَ  ، ثُمَّ قَالَ : "" اللَّهُمَّ لَكَ الْحَمْدُ  قَيَّامُ  السَّمَاوَاتِ وَالْأَرْضِ ، وَلَكَ الْحَمْدُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ ، وَلَكَ         [11/51]      الْحَمْدُ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَنْ فِيهِنَّ ، أَنْتَ حَقٌّ ، وَقَوْلُكَ حَقٌّ ، وَوَعْدُكَ حَقٌّ ، وَلِقَاؤُكَ حَقٌّ ، وَالْجَنَّةُ حَقٌّ ، وَالنَّارُ حَقٌّ ، وَالسَّاعَةُ حَقٌّ ، اللَّهُمَّ لَكَ أَسْلَمْتُ وَبِكَ آمَنْتُ وَعَلَيْكَ تَوَكَّلْتُ وَإِلَيْكَ  أَنَبْتُ ،  وَبِكَ خَاصَمْتُ ، وَإِلَيْكَ  حَاكَمْتُ  أَنْتَ رَبُّنَا وَإِلَيْكَ  الْمَصِيرُ  ، رَبِّ اغْفِرْ لِي مَا أَسْرَرْتُ وَمَا أَعْلَنْتُ ، وَمَا قَدَّمْتُ وَمَا أَخَّرْتُ إِنَّكَ إِلَهِي لَا إِلَهَ إِلَّا أَنْتَ  .","","Al-Mu'jam al-Kabir 11012","","عبد الله بن عباس عن طاوس بن كيسان عن قيس بن سعد الحبشي عن عمران بن مسلم القصير عن مهدي بن ميمون المعولي عن شيبان بن فروخ الحبطي عن الحسين بن إسحاق التستري عن الطبراني","طاوس عن ابن عباس"
"11042","11013  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَقَدْ  نَسَلْتُهُ  بِالْإِذْخِرِ ، وَالصُّوفَةِ  "" -  يَعْنِي : الْمَنِيَّ  -  .","","Al-Mu'jam al-Kabir 11013","","عبد الله بن عباس عن طاوس بن كيسان عن قيس بن سعد الحبشي عن حماد بن سلمة عن هدبة بن خالد عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","طاوس عن ابن عباس"
"11043","11014  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ  ، ثَنَا  نُوحُ بْنُ أَنَسٍ الْمُقْرِئُ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءٍ ،  أَخْبَرَنِي  عَبْدُ الْكَرِيمِ بْنُ أَبِي الْمُخَارِقِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُمِرْنَا أَنْ نَسْجُدَ عَلَى سَبْعَةِ أَعْضَاءٍ  ، وَلَا  نَكُفَّ  شَعَرًا وَلَا ثَوْبًا  .","","Al-Mu'jam al-Kabir 11014","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الكريم بن أبي المخارق عن عبد الرحمن بن مغراء الدوسي عن نوح بن أنس الرازي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","طاوس عن ابن عباس"
"11044","11015  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ عُبَيْدِ اللهِ الْحَلَبِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  طَاوُسٍ  ، عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  مِنَ السُّنَّةِ فِي الصَّلَاةِ أَنْ تَضَعَ إِلْيَتَيْكَ عَلَى عَقِبَيْكَ بَيْنَ السَّجْدَتَيْنِ  ""  .","","Al-Mu'jam al-Kabir 11015","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الكريم بن أبي المخارق عن سفيان بن عيينة عن عبد الرحمن بن عبيد الله بن حكيم الأسدي عن أحمد بن النضر بن بحر العسكري عن الطبراني","طاوس عن ابن عباس"
"11045","11016  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ بْنِ مُجَمِّعٍ ،  حَدَّثَنِي  عَبْدُ الْكَرِيمِ بْنُ أَبِي الْمُخَارِقِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [11/52]      بِامْرَأَةٍ  فِي مِحَفَّتِهَا فَأَخْرَجَتْ صَبِيًّا ، فَقَالَتْ : يَا نَبِيَّ اللهِ ، أَلِهَذَا حَجٌّ ؟ قَالَ :  نَعَمْ ، وَلَكِ أَجْرٌ  .","","Al-Mu'jam al-Kabir 11016","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الكريم بن أبي المخارق عن إبراهيم بن إسماعيل بن مجمع عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","طاوس عن ابن عباس"
"11046","11017  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي سَمِينَةَ ،  ثَنَا  رَوْحُ بْنُ عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  عَبْدِ الْكَرِيمِ أَبِي أُمَيَّةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قُتِلَ فِي  عِمِّيَّا  أَوْ  رِمِّيَّا  بِحَجَرٍ أَوْ عَصًا : فَإِنَّ دِيَتَهُ مُغَلَّظَةٌ عَلَى عَاقِلَتِهِ  ، وَمَنْ قُتِلَ بِيَدِهِ فَهُوَ  قَوَدُ  يَدِهِ ، وَمَنْ حَالَ دُونَهُ فَعَلَيْهِ لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ ، لَا يُقْبَلُ مِنْهُ  صَرْفٌ  وَلَا عَدْلٌ  .","","Al-Mu'jam al-Kabir 11017","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الكريم بن أبي المخارق عن روح بن عطاء بن أبي ميمونة البصري عن محمد بن يحيى بن أبي سمينة التمار عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طاوس عن ابن عباس"
"11047","11018  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ أُسَيْدٍ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ الْحُصَيْنِ ،  عَنْ  عَبْدِ الْكَرِيمِ بْنِ أَبِي الْمُخَارِقِ ،  أَخْبَرَنِي  عَطَاءٌ ، وَطَاوُسٌ ، وَعِكْرِمَةُ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" تَزَوَّجَ  مَيْمُونَةَ  وَهُوَ مُحْرِمٌ  .","","Al-Mu'jam al-Kabir 11018","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عبد الكريم بن أبي المخارق عن عبد العزيز بن الحصين المروزي عن خالد بن مخلد القطواني عن محمد بن عثمان بن كرامة الوراق عن عبد الله بن أحمد بن أسيد الرحال عن الطبراني","طاوس عن ابن عباس"
"11048","11019  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي الْكُسُوفِ قَالَ : "" قَرَأَ ثُمَّ رَكَعَ ثُمَّ قَرَأَ ثُمَّ رَكَعَ ثُمَّ قَرَأَ ثُمَّ رَكَعَ ثُمَّ قَرَأَ ثُمَّ رَكَعَ  وَالْأُخْرَى مِثْلُ ذَلِكَ  .","","Al-Mu'jam al-Kabir 11019","","عبد الله بن عباس عن طاوس بن كيسان عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","طاوس عن ابن عباس"
"11049","11020  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ،         [11/53]      ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  يُونُسَ بْنِ خَبَّابٍ ، قَالَ :  سَمِعْتُ  طَاوُسًا ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عِلْمٍ لَا يَنْفَعُ  ، وَمِنْ دُعَاءٍ لَا  يُسْمَعُ ،  وَمِنْ قَلْبٍ لَا يَخْشَعُ ، وَنَفْسٍ لَا تَشْبَعُ ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ هَؤُلَاءِ الْأَرْبَعِ  .","","Al-Mu'jam al-Kabir 11020","","عبد الله بن عباس عن طاوس بن كيسان عن يونس بن خباب الأسيدي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن علي بن معبد العبدي عن يوسف بن يزيد القراطيسي عن الطبراني","طاوس عن ابن عباس"
"11050","11021  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدٍ الْمُجَاشِعِيُّ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي يَعْقُوبَ الْكَرْمَانِيُّ ،  ثَنَا  أَبُو مُطِيعٍ قَاضِي بَلْخٍ ،  عَنِ  الْحَسَنِ - يَعْنِي ابْنَ عُمَارَةَ  - عَنِ  الْحَكَمِ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ  بِمِنًى  :  لَوْ يَعْلَمُ أَهْلُ الْجَمْعِ  بِمَنْ حَلُّوا أَوْ بِمَنْ نَزَلُوا  لَاسْتَبْشَرُوا بِالْفَضْلِ مِنْ رَبِّهِمْ  بَعْدَ الْمَغْفِرَةِ  .","","Al-Mu'jam al-Kabir 11021","","عبد الله بن عباس عن طاوس بن كيسان عن الحكم بن عتيبة الكندي عن الحسن بن عمارة عن الحكم بن عبد الله بن مسلمة الخراساني عن محمد بن إسحاق الكرماني عن العباس بن محمد بن مجاشع الأصبهاني عن الطبراني","طاوس عن ابن عباس"
"11051","11022  -  حَدَّثَنَا  أَحْمَدُ بْنُ زِيَادِ بْنِ زَكَرِيَّا الْإِيَادِيُّ ،  بِجَبَلَةَ  ،  ثَنَا  يَزِيدُ بْنُ قَيْسٍ ،  ثَنَا  عَبْدُ الْمَجِيدِ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ طَهْمَانَ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ  بِمِنًى  يَقُولُ :  لَوْ يَعْلَمُ أَهْلُ الْجَمْعِ بِمَنْ حَلُّوا لَاسْتَبْشَرُوا بِالْفَضْلِ بَعْدَ الْمَغْفِرَةِ  .","","Al-Mu'jam al-Kabir 11022","","عبد الله بن عباس عن طاوس بن كيسان عن الحكم بن عتيبة الكندي عن إبراهيم بن طهمان عن عبد المجيد بن عبد العزيز بن أبي رواد عن يزيد بن قبيس السيلحيني عن أحمد بن زياد الإيادي عن الطبراني","طاوس عن ابن عباس"
"11052","11023  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ الْحِمْصِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ سَالِمٍ ،  عَنِ  الزُّبَيْدِيِّ ،  ثَنَا  عِيسَى بْنُ يَزِيدَ ، أَنَّ طَاوُسًا أَبَا عَبْدِ الرَّحْمَنِ  حَدَّثَهُ         [11/54]      أَنَّ عَبْدَ اللهِ بْنَ عَبَّاسٍ  حَدَّثَهُمْ  :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَخَّرَ صَلَاةَ الْعِشَاءِ لَيْلَةً حَتَّى انْقَلَبَ أَهْلُ الْمَسْجِدِ إِلَّا  عُثْمَانَ بْنَ مَظْعُونٍ  وَهُوَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَخَمْسَةَ عَشَرَ رَجُلًا - أَوْ سِتَّةَ عَشَرَ  - مَا بَلَغُوا سَبْعَةَ عَشَرَ ، فَقَالَ  عُثْمَانُ  : لَا أَخْرُجُ اللَّيْلَةَ حَتَّى يَخْرُجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأُصَلِّيَ مَعَهُ وَأَعْلَمَ مَا أَمْرُهُ ، فَخَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي قَرِيبٍ مِنْ ثُلُثِ اللَّيْلِ وَمَعَهُ  بِلَالٌ  وَلَمْ يَرَ فِي الْمَسْجِدِ أَحَدًا إِذْ سَمِعَ نَغَمَةً مِنْ كَلَامِهِمْ فِي نَاحِيَةِ الْمَسْجِدِ ، فَمَشَى إِلَيْهِمْ حَتَّى سَلَّمَ عَلَيْهِمْ ، فَقَالَ : "" مَا يُجْلِسُكُمْ هَذِهِ السَّاعَةِ ؟ "" قَالُوا : انْتَظَرْنَاكَ لِنَشْهَدَ الصَّلَاةَ مَعَكَ ، فَقَالَ لَهُمْ : "" مَا صَلَّى صَلَاتَكُمْ هَذِهِ أُمَّةٌ قَطُّ قَبْلَكُمْ ، وَمَا زِلْتُمْ فِي صَلَاةٍ بَعْدُ "" وَقَالَ :  إِنَّ النُّجُومَ أَمَانُ السَّمَاءِ ، فَإِذَا طُمِسَتِ النُّجُومُ أَتَى السَّمَاءَ مَا تُوعَدُونَ  ، وَإِنِّي أَمَانٌ لِأَصْحَابِي ، فَإِذَا ذَهَبْتُ أَتَى أَصْحَابِي مَا يُوعَدُونَ ، وَأَصْحَابِي أَمَانٌ لِأُمَّتِي ، فَإِذَا ذَهَبَ أَصْحَابِي أَتَى أُمَّتِي مَا يُوعَدُونَ  .","","Al-Mu'jam al-Kabir 11023","","عبد الله بن عباس عن طاوس بن كيسان عن عيسى بن يزيد الشامي عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عمرو بن الحارث الزبيدي عن إسحاق بن إبراهيم بن العلاء عن عمرو بن إسحاق بن إبراهيم الزبيدي عن الطبراني","طاوس عن ابن عباس"
"11053","11024  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مَا أَحَدٌ  أُزَكِّيهِ  غَيْرَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ""  .","","Al-Mu'jam al-Kabir 11024","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","طاوس عن ابن عباس"
"11054","11025  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى بْنُ زَكَرِيَّا الْمُعَلِّمُ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَمْ تَنْهَهُ صَلَاتُهُ عَنِ الْفَحْشَاءِ وَالْمُنْكَرِ  ، لَمْ يَزْدَدْ مِنَ اللهِ إِلَّا  بُعْدًا  .","","Al-Mu'jam al-Kabir 11025","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن أبو معاوية الضرير عن يحيى بن زكريا المعلم عن محمد بن عبد الله مطين الحضرمي عن الطبراني","طاوس عن ابن عباس"
"11055","[11/55]      11026  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَعْلَى بْنُ الْحَارِثِ الْمُحَارِبِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  غَيْلَانَ بْنِ جَامِعٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ، وَطَاوُسٍ ، وَمُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ ، وَجَابِرٍ رَضِيَ اللهُ عَنْهُمْ :  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابَهُ "" لَمْ يَطُوفُوا بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  إِلَّا طَوَافًا وَاحِدًا  لِحَجِّهِمْ ، وَعُمْرَتِهِمْ  .","","Al-Mu'jam al-Kabir 11026","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن مجاهد بن جبر المخزومي عن الليث بن سعد عن غيلان بن جامع المحاربي عن أبو يعلى بن الحارث بن حرب المحاربي عن يعلى بن الحارث بن حرب المحاربي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","طاوس عن ابن عباس"
"11056","11027  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ابْنُ آدَمَ سِتُّونَ وَثَلَاثُمِائَةِ مَفْصِلٍ عَلَى كُلِّ وَاحِدٍ مِنْهَا فِي كُلِّ يَوْمٍ صَدَقَةٌ  قَالَ : "" كَلِمَةُ  الطَّيِّبَةُ يَتَكَلَّمُ بِهَا الرَّجُلُ صَدَقَةٌ ، وَعَوْنُ الرَّجُلِ أَخَاهُ عَلَى الشَّيْءِ صَدَقَةٌ ، وَالشَّرْبَةُ مِنَ الْمَاءِ يَسْقِيهَا صَدَقَةٌ ، وَإِمَاطَةُ  الْأَذَى  عَنِ الطَّرِيقِ صَدَقَةٌ  .  كذا في طبعة مكتبة ابن تيمية والأصل الخطي ، وفي المصادر كلها ( الكلمة ) .","","Al-Mu'jam al-Kabir 11027","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن عبد الواحد بن زياد عن محمد بن أبي بكر المقدمي عن إبراهيم بن هاشم البغوي عن الطبراني","طاوس عن ابن عباس"
"11057","11028  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ، وَأَحْمَدُ بْنُ مُحَمَّدٍ الْبَزَّارُ الْأَصْبَهَانِيُّ ، قَالَا :  ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  غَوْثُ بْنُ غَيْلَانَ بْنِ مُنَبِّهٍ الصَّنْعَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَفْوَانَ ،  عَنْ  إِدْرِيسَ ابْنِ بِنْتِ وَهْبِ بْنِ مُنَبِّهٍ ،  حَدَّثَنِي  وَهْبُ بْنُ مُنَبِّهٍ  ، عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَوْلَا مَا طَبَعَ  الرُّكْنَ  مِنْ أَنْجَاسِ الْجَاهِلِيَّةِ ، وَأَرْجَاسِهَا ، وَأَيْدِي الظَّلَمَةِ  ، وَالْأَثَمَةِ لَاسْتُشْفِيَ         [11/56]      بِهِ مِنْ كُلِّ عَاهَةٍ ، وَلَأُلْقِيَ الْيَوْمَ كَهَيْئَةِ يَوْمَ خَلَقَهُ اللهُ ، وَإِنَّمَا غَيَّرَهُ اللهُ بِالسَّوَادِ لِئَلَّا يَنْظُرَ أَهْلُ الدُّنْيَا إِلَى زِينَةِ الْجَنَّةِ ، وَلِيَصْبِرَنَّ إِلَيْهَا ، وَإِنَّهُ لَيَاقُوتَةٌ مِنْ يَاقُوتِ الْجَنَّةِ وَضَعَهُ اللهُ حِينَ أُنْزِلَ  آدَمُ  فِي مَوْضِعِ  الْكَعْبَةِ  قَبْلَ أَنْ تَكُونَ  الْكَعْبَةُ  ، وَالْأَرْضُ يَوْمَئِذٍ طَاهِرَةٌ وَلَمْ يُعْمَلْ فِيهَا شَيْءٌ مِنَ الْمَعَاصِي ، وَلَيْسَ لَهَا أَهْلٌ يُنَجِّسُونَهَا ، فَوُضِعَ لَهُ صَفٌّ مِنَ الْمَلَائِكَةِ عَلَى أَطْرَافِ  الْحَرَمِ  يَحْرُسُونَهُ مِنْ سُكَّانِ الْأَرْضِ ، وَسُكَّانُهَا يَوْمَئِذٍ الْجِنُّ ، لَا يَنْبَغِي لَهُمْ أَنْ يَنْظُرُوا إِلَيْهِ ؛ لِأَنَّهُ شَيْءٌ مِنَ الْجَنَّةِ ، فَالْمَلَائِكَةُ يَذُودُونَهُمْ عَنْهُ وَهُمْ وُقُوفٌ عَلَى أَطْرَافِ الْحَرَمِ يَحْدِقُونَ بِهِ مِنْ كُلِّ جَانِبٍ وَلِذَلِكَ سُمِّيَ  الْحَرَمُ  ؛ لِأَنَّهُمْ يَحُولُونَ فِيمَا بَيْنَهُمْ وَبَيْنَهُ  .","","Al-Mu'jam al-Kabir 11028","","عبد الله بن عباس عن طاوس بن كيسان عن وهب بن منبه عن إدريس بن سنان اليماني عن عبد الله بن صفوان الجمحي عن غوث بن جابر بن غيلان الصنعاني عن الحسن بن علي الريحاني عن محمد بن علي بن زيد الصائغ عن الطبراني","طاوس عن ابن عباس"
"11058","وَهْبُ بْنُ مُنَبِّهٍ  ، عَنِ  ابْنِ عَبَّاسٍ  .  11029  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مُنْذِرُ بْنُ النُّعْمَانِ ،  عَنْ  وَهْبِ بْنِ مُنَبِّهٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَخْرُجُ مِنْ  عَدَنِ  أَبْيَنَ اثْنَا عَشَرَ أَلْفًا يَنْصُرُونَ اللهَ وَرَسُولَهُ  هُمْ خَيْرُ مَنْ بَيْنِي وَبَيْنَهُمْ  .","","Al-Mu'jam al-Kabir 11029","","عبد الله بن عباس عن وهب بن منبه عن المنذر بن النعمان الأفطس عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","وهب بن منبه عن ابن عباس"
"11059","11030  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،         [11/57]      عَنْ  أَبِي مُوسَى الْيَمَانِيِّ ،  عَنْ  وَهْبِ بْنِ مُنَبِّهٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  رَفَعَهُ  قَالَ :  مَنْ  بَدَا  جَفَا ،  وَمَنِ اتَّبَعَ الصَّيْدَ  غَفَلَ  ، وَمَنْ أَتَى السُّلْطَانَ افْتُتِنَ  .","","Al-Mu'jam al-Kabir 11030","","عبد الله بن عباس عن وهب بن منبه عن أبو موسى اليماني عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وهب بن منبه عن ابن عباس"
"11060","11031  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى بْنُ حَسَّانَ الْكُوفِيُّ ،  ثَنَا  هِشَامُ بْنُ سُلَيْمَانَ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي مُوسَى ،  عَنْ  وَهْبِ بْنِ مُنَبِّهٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَدْخُلُ الْجَنَّةَ مَنْ أَتَى ذَا  مَحْرَمٍ  .","","Al-Mu'jam al-Kabir 11031","","عبد الله بن عباس عن وهب بن منبه عن أبو موسى اليماني عن سفيان الثوري عن هشام بن سليمان بن عكرمة عن يحيى بن حسان بن حيان التنيسي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","وهب بن منبه عن ابن عباس"
"11061","11032  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ الْكُوفِيُّ  ، ثَنَا  عَبْدُ الْحَمِيدِ بْنُ صَالِحٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  إِدْرِيسَ ابْنِ بِنْتِ وَهْبِ بْنِ مُنَبِّهٍ ،  عَنْ  وَهْبِ بْنِ مُنَبِّهٍ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَفَى بِكَ إِثْمًا أَنْ لَا تَزَالَ مُخَاصِمًا  .","","Al-Mu'jam al-Kabir 11032","","عبد الله بن عباس عن وهب بن منبه عن إدريس بن سنان اليماني عن أبو بكر بن عياش عن عبد الحميد بن صالح البرجمي عن الحسين بن جعفر القتات عن الطبراني","وهب بن منبه عن ابن عباس"
"11062","11033  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ الْكُوفِيُّ  ، ثَنَا  عَبْدٌ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  أَبِي بَكْرِ بْنِ عَيَّاشٍ ،  عَنْ  إِدْرِيسَ بْنِ مُنَبِّهٍ ،  عَنْ  أَبِيهِ وَهْبِ بْنِ مُنَبِّهٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  سَأَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  جِبْرِيلَ  عَلَيْهِ السَّلَامُ أَنْ يَرَاهُ فِي صُورَتِهِ  قَالَ : ادْعُ رَبَّكَ ، فَدَعَا رَبَّهُ ، فَطَلَعَ عَلَيْهِ سَوَادٌ مِنْ قِبَلِ الْمَشْرِقِ فَجَعَلَ يَرْتَفِعُ فَيَنْتَشِرُ ، فَلَمَّا رَآهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَعِقَ فَأَتَاهُ فَنَعَشَهُ وَمَسَحَ الْبُزَاقَ عَنْ شِدْقِهِ  .","","Al-Mu'jam al-Kabir 11033","","عبد الله بن عباس عن وهب بن منبه عن إدريس بن سنان اليماني عن أبو بكر بن عياش عن يحيى بن آدم عن عبد بن حميد عن الحسين بن جعفر القتات عن الطبراني","وهب بن منبه عن ابن عباس"
"11063","11034  -  حَدَّثَنَا  حَجَّاجُ بْنُ عِمْرَانَ السَّدُوسِيُّ  ، ثَنَا  عَمْرُو بْنُ         [11/58]      الْحُصَيْنِ الْعُقَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُلَاثَةَ ،  عَنِ  الْحَكَمِ بْنِ أَبَانَ ،  عَنْ  وَهْبِ بْنِ مُنَبِّهٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَوْتُ الْغَرِيبِ شَهَادَةٌ إِذَا احْتُضِرَ  ، فَرَمَى بِبَصَرِهِ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ ، فَلَمْ يَرَ إِلَّا غَرِيبًا ، وَذَكَرَ أَهْلَهُ وَوَلَدَهُ ، وَتَنَفَّسَ فَلَهُ بِكُلِّ نَفَسٍ يَنَفَّسُهُ يَمْحُو اللهُ أَلْفَيْ أَلْفِ سَيِّئَةٍ ، وَيَكْتُبُ لَهُ أَلْفَيْ أَلْفِ حَسَنَةٍ  .","","Al-Mu'jam al-Kabir 11034","","عبد الله بن عباس عن وهب بن منبه عن الحكم بن أبان العدني عن قاضي الجن محمد بن عبد الله بن علاثة عن عمرو بن الحصين العقيلي عن حجاج بن عمران السدوسي عن الطبراني","وهب بن منبه عن ابن عباس"
"11064","مُجَاهِدٌ  عَنِ  ابْنِ عَبَّاسٍ  11035  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  خَلَّادُ بْنُ يَحْيَى ،  ثَنَا  مِسْعَرٌ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  قَالَ  ابْنُ عَبَّاسٍ فِي سَجْدَةِ "" ص "" :  تَوْبَةُ نَبِيٍّ أَمَرَ اللهُ نَبِيَّهُ أَنْ يَقْتَدِيَ بِهِ  ""  .","","Al-Mu'jam al-Kabir 11035","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عمرو بن مرة المرادي عن مسعر بن كدام عن خلاد بن يحيى الأرحبي عن بشر بن موسى بن صالح الأسدي عن الطبراني","مجاهد عن ابن عباس"
"11065","11036  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي ،  ثَنَا  عَمْرُو بْنُ مُرَّةَ  ،  أَنَا  شُعْبَةُ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مَرْزُوقٍ ، قَالَ :  سَمِعْتُ  مُجَاهِدًا يَقُولُ :  سُئِلَ  ابْنُ عَبَّاسٍ عَنِ السُّجُودِ فِي "" ص "" ، فَقَالَ :         {      أُولَئِكَ الَّذِينَ هَدَى اللهُ فَبِهُدَاهُمُ اقْتَدِهِ         }      .  في طبعة مكتبة ابن تيمية : (مرزوق) ، والمثبت من نسخة الظاهرية (1) .","","Al-Mu'jam al-Kabir 11036","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","مجاهد عن ابن عباس"
"11066","11037  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  ثَنَا  شَيْبَانُ ،  عَنْ  جَابِرٍ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، وَهُوَ يَقْرَأُ سُورَةَ "" ص  "" فَسَجَدَ فِيهَا  .","","Al-Mu'jam al-Kabir 11037","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عمرو بن مرة المرادي عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عباس"
"11067","[11/59]      11038  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ فِي قَوْلِهِ :         {      وَلَقَدْ آتَيْنَاكَ سَبْعًا مِنَ الْمَثَانِي         }      قَالَ : "" هِيَ  السَّبْعُ  الطِّوَالُ  ""  .","","Al-Mu'jam al-Kabir 11038","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","مجاهد عن ابن عباس"
"11068","11039  -  حَدَّثَنَا  زَكَرِيَّا بْنُ حَمْدَوَيْهِ الْبَغْدَادِيُّ  ، ثَنَا  عُبَيْدُ بْنُ إِسْحَاقَ الْعَطَّارُ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" احْتَجَمَ عَلَى ظَهْرِ قَدَمِهِ وَهُوَ صَائِمٌ  .","","Al-Mu'jam al-Kabir 11039","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن قيس بن الربيع الأسدي عن عبيد بن إسحاق عطار المطلقات عن زكريا بن حمدويه الصفار عن الطبراني","مجاهد عن ابن عباس"
"11069","11040  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مِسْعَرٌ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ قَالَ :  رُخِّصَ لِلشَّيْخِ وَهُوَ صَائِمٌ ، وَنُهِيَ الشَّابُّ  ""  .","","Al-Mu'jam al-Kabir 11040","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن حبيب بن أبي ثابت الكاهلي عن مسعر بن كدام عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11070","11041  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  مُوسَى بْنُ دَاوُدَ الضَّبِّيُّ (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، حَدَّثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، وَأَحْمَدُ بْنُ يُونُسَ (  ح  ) .  وَحَدَّثَنَا  خَلَفُ بْنُ عَمْرٍو الْعُكْبَرِيُّ  ، ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  خَالِدُ بْنُ خِدَاشٍ ، قَالُوا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  بُكَيْرِ بْنِ الْأَخْنَسِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  فَرَضَ  اللهُ عَزَّ وَجَلَّ الصَّلَاةَ عَلَى         [11/60]      لِسَانِ نَبِيِّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْحَضَرِ أَرْبَعًا  ، وَفِي السَّفَرِ رَكْعَتَيْنِ ، وَفِي الْخَوْفِ رَكْعَةً  .","","Al-Mu'jam al-Kabir 11041","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن بكير بن الأخنس السدوسي عن الوضاح بن عبد الله اليشكري عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11071","11042  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ (  ح  ) ،  وَحَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  أَبُو مَعْمَرٍ الْقَطِيعِيُّ ، قَالَا :  ثَنَا  الْقَاسِمُ بْنُ مَالِكٍ الْمُزَنِيُّ ،  عَنْ  أَيُّوبَ بْنِ عَائِذٍ ،  عَنْ  بُكَيْرِ بْنِ الْأَخْنَسِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صَلَاةُ الْحَضَرِ أَرْبَعًا  ، وَالسَّفَرِ رَكْعَتَيْنِ ، وَالْخَوْفِ رَكْعَةٌ  .","","Al-Mu'jam al-Kabir 11042","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن بكير بن الأخنس السدوسي عن أيوب بن عائذ عن القاسم بن مالك المزني عن إسماعيل بن إبراهيم المقعد عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11072","11043  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  مَهْدِيُّ بْنُ جَعْفَرٍ الرَّمْلِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنِ  الْحَارِثِ الْغَنَوِيِّ ،  عَنْ  بُكَيْرِ بْنِ الْأَخْنَسِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  افْتَرَضَ اللهُ الصَّلَاةَ عَلَى لِسَانِ نَبِيِّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْحَضَرِ أَرْبَعًا  ، وَفِي السَّفَرِ رَكْعَتَيْنِ ، وَفِي الْخَوْفِ رَكْعَةً  .","","Al-Mu'jam al-Kabir 11043","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن بكير بن الأخنس السدوسي عن الحارث الغنوي عن هشيم بن بشير عن مهدي بن جعفر بن جيهان الرملي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","مجاهد عن ابن عباس"
"11073","11044  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ، وَعُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نُصِرْتُ بِالصَّبَا ، وَأُهْلِكَتْ  عَادٌ  بِالدَّبُورِ  .","","Al-Mu'jam al-Kabir 11044","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","مجاهد عن ابن عباس"
"11074","11045  -  حَدَّثَنَا  يُوسُفُ ، وَعُثْمَانُ بْنُ عُمَرَ ، قَالَا :  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقُولُ :  هَذِهِ         [11/61]      عُمْرَةٌ اسْتَمْتَعْنَا بِهَا ، فَمَنْ لَمْ يَكُنْ عِنْدَهُ هَدْيٌ ، فَلْيَحْلِلِ الْحِلَّ كُلَّهُ  ، فَقَدْ  دَخَلَتِ  الْعُمْرَةُ فِي  الْحَجِّ  إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 11045","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","مجاهد عن ابن عباس"
"11075","11046  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  أَبُو مَرْيَمَ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  إِنَّمَا جَعَلَهَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عُمْرَةً ، فَإِنَّهُمْ قَدِمُوا  مَكَّةَ  قَبْلَ  عَرَفَةَ  بِأَرْبَعِ لَيَالٍ ، فَكَرِهَ أَنْ يَمْكُثَ الْمُسْلِمُونَ أَرْبَعَ لَيَالٍ لَا يَطُوفُونَ  بِالْبَيْتِ  ، وَعَلِمَ أَنَّهُمْ إِذَا طَافُوا  بِالْبَيْتِ  حَلُّوا إِلَّا مَنْ كَانَ سَاقَ هَدْيًا ، فَقَالَ :  عُمْرَةٌ اسْتَمْتَعْنَا بِهَا - ثَلَاثَ مَرَّاتٍ - ثُمَّ  دَخَلَتِ  الْعُمْرَةُ فِي  الْحَجِّ  إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 11046","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن عبد الغفار بن القاسم الأنصاري عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","مجاهد عن ابن عباس"
"11076","11047  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَبْدُ اللهِ بْنُ حَمَّادِ بْنِ نُمَيْرٍ ،  ثَنَا  حُصَيْنُ بْنُ نُمَيْرٍ ،  ثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُعْطِيتُ خَمْسًا لَمْ يُعْطَهُنَّ نَبِيٌّ قَبْلِي  : وَأُرْسِلْتُ إِلَى الْأَحْمَرِ وَالْأَسْوَدِ ، وَكَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُرْسَلُ إِلَى خَاصَّةٍ ، وَنُصِرْتُ  بِالرُّعْبِ  حَتَّى إِنَّ الْعَدُوَّ لَيَخَافُونِي مِنْ  مَسِيرَةِ  شَهْرٍ أَوْ شَهْرَيْنِ ، وَأُحِلَّتْ لِيَ الْغَنَائِمُ وَلَمْ تَحِلَّ لِمَنْ قَبْلِي ، وَجُعِلَتْ لِيَ الْأَرْضُ مَسْجِدًا وَطَهُورًا ، وَقِيلَ لِي : سَلْ تُعْطَهْ ، فَادَّخَرْتُ دَعْوَتِي شَفَاعَةً لِأُمَّتِي فَهِيَ نَائِلَةٌ إِنْ شَاءَ اللهُ لِمَنْ مَاتَ لَا يُشْرِكُ بِاللهِ شَيْئًا  .","","Al-Mu'jam al-Kabir 11047","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن حصين بن نمير الأنصاري عن عبد الله بن حماد بن نمير عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11077","11048  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  سُفْيَانَ بْنِ حُسَيْنٍ ،  عَنِ         [11/62]      الْحَكَمِ ،  عَنْ  مِقْسَمٍ ، وَمُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  قَبْلَ  التَّرْوِيَةِ  بِيَوْمٍ  :  مَنْزِلُنَا غَدًا إِنْ شَاءَ اللهُ  بِالْخَيْفِ  الْأَيْمَنِ حَيْثُ اسْتَقْسَمَ الْمُشْرِكُونَ  .","","Al-Mu'jam al-Kabir 11048","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن سفيان بن حسين المعلم عن عباد بن العوام الكلابي عن سعيد بن سليمان سعدويه عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","مجاهد عن ابن عباس"
"11078","11049  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ  الْفَضْلُ  أَكْبَرَ مِنِّي ، وَكَانَ يُرْدِفُنِي فَأَكُونُ بَيْنَ يَدَيْهِ  ، فَارْتَدَفْتُ أَنَا وَأَخِي حِمَارَةً ، فَانْتَهَيْنَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُصَلِّي بِالنَّاسِ  بِعَرَفَةَ  فَنَزَلْنَا بَيْنَ يَدَيْهِ ، وَدَخَلْنَا فَصَلَّيْنَا ، وَتَرَكْنَاهَا تَرْعَى بَيْنَ يَدَيْهِ ، وَلَمْ يَقْطَعْ صَلَاتَهُ  .","","Al-Mu'jam al-Kabir 11049","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن محمد بن عبد الله بن المثنى الخزرجي عن أبو مسلم الكجي عن الطبراني","مجاهد عن ابن عباس"
"11079","11050  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الْحَسَنِ بْنِ عُمَارَةَ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مِنَ السُّنَّةِ أَنْ لَا يُصَلِّيَ الرَّجُلُ بِالتَّيَمُّمِ إِلَّا صَلَاةً وَاحِدَةً  ، ثُمَّ يَتَيَمَّمُ لِلصَّلَاةِ الْأُخْرَى  ""  .","","Al-Mu'jam al-Kabir 11050","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن الحسن بن عمارة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مجاهد عن ابن عباس"
"11080","11051  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ أَيُّوبَ بْنِ رَاشِدٍ الْبَصْرِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ كَعْبٍ الْقُرَظِيُّ ، وَالْحَكَمُ بْنُ عُتَيْبَةَ ،  عَنْ  مِقْسَمٍ ، وَمُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمَّا وَقَفَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  حَمْزَةَ  فَنَظَرَ إِلَى مَا بِهِ قَالَ :  لَوْلَا أَنْ تَحْزَنَ النِّسَاءُ مَا غَيَّبْتُهُ ، وَلَتَرَكْتُهُ حَتَّى يَكُونَ فِي بُطُونِ  السِّبَاعِ  وَحَوَاصِلِ الطُّيُورِ حَتَّى يَبْعَثَهُ اللهُ مِمَّا هُنَالِكَ "" قَالَ : وَأَحْزَنَهُ مَا رَأَى بِهِ ، فَقَالَ : "" لَئِنْ ظَفِرْتُ  بِقُرَيْشٍ         [11/63]      لَأُمَثِّلَنَّ بِثَلَاثِينَ رَجُلًا مِنْهُمْ "" فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ فِي ذَلِكَ         {      وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا بِمِثْلِ مَا عُوقِبْتُمْ بِهِ         }      إِلَى قَوْلِهِ         {      يَمْكُرُونَ         }      ، ثُمَّ أَمَرَ بِهِ فَهُيِّئَ إِلَى الْقِبْلَةِ ثُمَّ كَبَّرَ عَلَيْهِ تِسْعًا ، ثُمَّ جَمَعَ عَلَيْهِ الشُّهَدَاءَ كُلَّمَا أُتِيَ بِشَهِيدٍ وُضِعَ إِلَى  حَمْزَةَ  فَصَلَّى عَلَيْهِ ، وَعَلَى الشُّهَدَاءِ مَعَهُ ، حَتَّى صَلَّى عَلَيْهِ وَعَلَى الشُّهَدَاءِ اثْنَتَيْنِ وَسَبْعِينَ صَلَاةً ، ثُمَّ قَامَ عَلَى أَصْحَابِهِ حَتَّى وَارَاهُمْ ، وَلَمَّا نَزَلَ الْقُرْآنُ عَفَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَتَجَاوَزَ وَتَرَكَ الْمُثْلَ  .","","Al-Mu'jam al-Kabir 11051","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن أحمد بن أيوب بن راشد الشعيري عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11081","11052  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  جُبَارَةُ بْنُ الْمُغَلِّسِ ،  ثَنَا  أَبُو شَيْبَةَ إِبْرَاهِيمُ بْنُ عُثْمَانَ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اغْزُوا تَغْنَمُوا بَنَاتِ  الْأَصْفَرِ  فَقَالَ نَاسٌ مِنَ الْمُنَافِقِينَ : إِنَّهُ لَيَفْتِنُكُمْ بِالنِّسَاءِ "" فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ         {      وَمِنْهُمْ مَنْ يَقُولُ ائْذَنْ لِي وَلا تَفْتِنِّي         }      .","","Al-Mu'jam al-Kabir 11052","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن إبراهيم بن عثمان أبو شيبة العبسي عن جبارة بن المغلس عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11082","11053  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ شَبِيبٍ الْأَصْبَهَانِيُّ الْعَسَّالُ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  أَبُو مَرْيَمَ عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ ،  حَدَّثَنِي  الْحَكَمُ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  سَافَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي رَمَضَانَ فَصَامَ وَأَفْطَرَ  ، فَمَنْ شَاءَ صَامَ ، وَمَنْ شَاءَ أَفْطَرَ  .","","Al-Mu'jam al-Kabir 11053","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن عبد الغفار بن القاسم الأنصاري عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","مجاهد عن ابن عباس"
"11083","11054  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  أَبُو مُوسَى الْهَرَوِيُّ ،  ثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  ثَنَا  سُفْيَانُ بْنُ حُسَيْنٍ ،  عَنِ  الْحَكَمِ ،  عَنْ         [11/64]      مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نُسِخَتْ آيَتَانِ مِنْ سُورَةِ الْمَائِدَةِ : آيَةُ الْهَدْيِ ، وَالْقَلَائِدِ  ، وَالْآيَةُ الْأُخْرَى :         {      فَاحْكُمْ بَيْنَهُمْ أَوْ أَعْرِضْ عَنْهُمْ         }      . قَالَ : "" كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ مُخَيَّرًا إِنْ شَاءَ حَكَمَ بَيْنَهُمْ ، وَإِنْ شَاءَ رَدَّهُمْ إِلَى حُكْمِ غَيْرِهِ حَتَّى نَزَلَتْ         {      فَاحْكُمْ بَيْنَهُمْ بِمَا أَنْـزَلَ اللهُ         }      .","","Al-Mu'jam al-Kabir 11054","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن سفيان بن حسين المعلم عن عباد بن العوام الكلابي عن إسحاق بن إبراهيم الهروي عن محمد بن الفضل بن جابر السقطى عن الطبراني","مجاهد عن ابن عباس"
"11084","11055  -  حَدَّثَنَا  عُمَرُ  بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  إِبْرَاهِيمَ بْنِ طَهْمَانَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  أَبِيهِ  ، عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ، قَالَا :  يُكْرَهُ أَنْ يُشْرَبَ مِنْ أُذُنِ الْقَدَحِ  ، وَثُلْمَةِ الْقَدَحِ  ""  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (عمرو).","","Al-Mu'jam al-Kabir 11055","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبو إبراهيم بن مهاجر بن جابر البجلي عن إبراهيم بن مهاجر بن جابر البجلي عن إبراهيم بن طهمان عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن عمرو بن أبي الطاهر المصري عن الطبراني","مجاهد عن ابن عباس"
"11085","11056  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْفَضْلِ بْنِ مُوَفَّقٍ ،  ثَنَا  أَبِي  ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نُصِرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالرُّعْبِ  مَسِيرَةَ  شَهْرَيْنِ عَلَى عَدُوِّهِ  .","","Al-Mu'jam al-Kabir 11056","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن إسماعيل بن إبراهيم بن مهاجر النخعي عن الفضل بن الموفق الثقفي عن عبد الرحمن بن الفضل بن موفق عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عباس"
"11086","11057  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْخُزَاعِيُّ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  عُثْمَانَ بْنِ الْمُغِيرَةِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رَأَيْتُ  عِيسَى  وَمُوسَى  وَإِبْرَاهِيمَ  عَلَيْهِمُ السَّلَامُ  ، فَأَمَّا  عِيسَى  : فَأَحْمَرُ  جَعْدٌ  عَرِيضُ الصَّدْرِ ، وَأَمَّا  مُوسَى  : فَآدَمُ جَسِيمٌ سَبِطٌ كَأَنَّهُ مِنْ رِجَالِ الزُّطِّ "" فَقَالُوا لَهُ :  إِبْرَاهِيمُ  ؟ قَالَ : "" انْظُرُوا إِلَى صَاحِبِكُمْ  .","","Al-Mu'jam al-Kabir 11057","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عثمان بن المغيرة الأعشى عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن كثير العبدي عن أحمد بن محمد بن علي الخزاعي عن الطبراني","مجاهد عن ابن عباس"
"11087","[11/65]      11058  -  حَدَّثَنَا  الْحَضْرَمِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي مُعَاوِيَةَ ،  ثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الذُّبَابُ  كُلُّهُ فِي النَّارِ إِلَّا النَّحْلَةَ  .","","Al-Mu'jam al-Kabir 11058","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن أبو معاوية الضرير عن إبراهيم بن أبي معاوية عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عباس"
"11088","11059  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ  ، ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  أَبُو مُسْلِمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  أَحْسَبُهُ  ابْنَ عَبَّاسٍ ، قَالَ :  إِنْ كَانَ الرَّجُلُ مِنْ أَهْلِ الْعَوَالِي لَيَدْعُو رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنِصْفِ اللَّيْلِ  عَلَى خُبْزِ الشَّعِيرِ فَيُجِيبُ  "" .","","Al-Mu'jam al-Kabir 11059","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن عبيد الله بن سعيد بن مسلم الجعفي عن عمرو بن عثمان بن سعيد الجعفي عن يحيى بن سليمان بن يحيى عن روح بن الفرج القطان عن الطبراني","مجاهد عن ابن عباس"
"11089","11060  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ عَرْعَرَةُ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" طَافَ  بِالْبَيْتِ  عَلَى رَاحِلَتِهِ  يَسْتَلِمُ  الرُّكْنَ  بِمِحْجَنِهِ  .","","Al-Mu'jam al-Kabir 11060","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن شعبة بن الحجاج عن يحيى القطان عن إبراهيم بن محمد بن عرعرة عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11090","11061  -  حَدَّثَنَا  الْمَعْمَرِيُّ ، وَمُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ، قَالَا :         [11/66]      ثَنَا  عَبْدُ السَّلَامِ بْنُ صَالِحٍ الْهَرَوِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنَا مَدِينَةُ الْعِلْمِ ،  وَعَلِيٌّ  بَابُهَا  ، فَمَنْ أَرَادَ الْعِلْمَ فَلْيَأْتِهِ مِنْ بَابِهِ  .","","Al-Mu'jam al-Kabir 11061","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن أبو معاوية الضرير عن عبد السلام بن صالح الهروي عن محمد بن علي بن زيد الصائغ عن الطبراني","مجاهد عن ابن عباس"
"11091","11062  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ الْمِصْرِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  رَوْحُ بْنُ مُسَافِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ خَرَجَ إِلَى  بَنِي قُرَيْظَةَ  عَلَى حِمَارٍ  ، وَمَعَهُ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ عَلَى بَغْلَةٍ بَيْضَاءَ تَحْتَهُ قَطِيفَةٌ مِنْ إِسْتَبْرَقٍ خَمَّلَهَا اللِّوَاءُ ، فَسَارَ سَاعَةً ، ثُمَّ قَالَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ : يَا  مُحَمَّدُ  ، أَمَا وَالَّذِي بَعَثَكَ بِالْحَقِّ لَا أَنْزِلُ عَنْهَا حَتَّى تُفْتَحَ لَكَ "" ، قَالَ  ابْنُ عَبَّاسٍ  : "" فَلَمْ يَرْجِعْ حَتَّى فُتِحَ لَهُ  .","","Al-Mu'jam al-Kabir 11062","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن روح بن مسافر البصري عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مجاهد عن ابن عباس"
"11092","11063  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ خَلَّادٍ الدَّوْرَقِيُّ  ، ثَنَا  مِلْحَانُ بْنُ سُلَيْمَانَ الدَّوْرَقِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ الْخُرَيْبِيُّ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  عَلِيٍّ  وَفَاطِمَةَ  وَهُمَا يَضْحَكَانِ ، فَلَمَّا رَأَيَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَكَتَا ، فَقَالَ لَهُمَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا لَكُمَا كُنْتُمَا تَضْحَكَانِ ، فَلَمَّا رَأَيْتُمَانِي سَكَتُّمَا ؟ "" فَبَادَرَتْ  فَاطِمَةُ  فَقَالَتْ : بِأَبِي أَنْتَ يَا رَسُولَ اللهِ ، قَالَ هَذَا : أَنَا أَحَبُّ إِلَى رَسُولِ اللهِ مِنْكِ ، فَقُلْتُ : بَلْ أَنَا أَحَبُّ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْكَ ، فَتَبَسَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَالَ :  يَا بُنَيَّةُ لَكِ رِقَّةُ الْوَلَدِ ،  وَعَلِيٌّ  أَعَزُّ عَلَيَّ مِنْكِ  .","","Al-Mu'jam al-Kabir 11063","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن عبد الله بن داود الخريبي عن ملحان بن سليمان الدورقي عن عبد الرحمن بن خلاد الدورقي عن الطبراني","مجاهد عن ابن عباس"
"11093","[11/67]      11064  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْحَسَنِ الصَّابُونِيُّ التُّسْتَرِيُّ  ، ثَنَا  عَبَّادُ بْنُ يَعْقُوبَ ،  ثَنَا  مُوسَى بْنُ عُمَيْرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،         {      سَلامٌ عَلَى إِلْ يَاسِينَ         }      قَالَ : "" نَحْنُ  آلَ مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 11064","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن موسى بن عمير السبخي عن عباد بن يعقوب الرواجني عن عبد الرحمن بن الحسن الصابوني التستري عن الطبراني","مجاهد عن ابن عباس"
"11094","11065  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ الرَّازِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  قَالَ : لَمَّا نَزَلَتِ الْآيَةُ :         {      فِيهِ رِجَالٌ يُحِبُّونَ أَنْ يَتَطَهَّرُوا         }      بَعَثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  عُوَيْمِرِ بْنِ سَاعِدَةَ  ، فَقَالَ :  مَا هَذَا الطُّهُورُ الَّذِي أَثْنَى اللهُ عَزَّ وَجَلَّ عَلَيْكُمْ ؟  فَقَالُوا : يَا رَسُولَ اللهِ مَا خَرَجَ مِنَّا رَجُلٌ وَلَا امْرَأَةٌ مِنَ الْغَائِطِ إِلَّا غَسَلَ  فَرْجَهُ - أَوْ قَالَ : مَقْعَدَتَهُ  - "" فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هُوَ هَذَا  .","","Al-Mu'jam al-Kabir 11065","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن محمد بن حميد الرازي عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11095","11066  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  يَحْيَى بْنُ حَمَّادٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي وَهُوَ  بِمَكَّةَ  نَحْوَ  بَيْتِ الْمَقْدِسِ  وَالْكَعْبَةُ  بَيْنَ يَدَيْهِ  ، وَبَعْدَمَا هَاجَرَ سِتَّةَ عَشَرَ شَهْرًا ، ثُمَّ انْصَرَفَ إِلَى  الْكَعْبَةِ  "" .","","Al-Mu'jam al-Kabir 11066","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن الوضاح بن عبد الله اليشكري عن يحيى بن حماد بن أبي زياد الشيباني عن محمد بن عبد الله بن نمير عن محمد بن عبدوس السراج عن الطبراني","مجاهد عن ابن عباس"
"11096","11067  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ         [11/68]      عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  شَرِيكٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ خَيْبَرَ  عَنْ لُحُومِ الْحُمُرِ  الْأَهْلِيَّةِ  ، وَعَنِ الْحَبَالَى أَنْ يُوطَأْنَ حَتَّى يَضَعْنَ مَا فِي بُطُونِهِنِّ ، وَعَنْ أَكْلِ كُلِّ ذِي نَابٍ مِنَ  السِّبَاعِ  ، وَعَنْ بَيْعِ الْمَغْنَمِ حَتَّى يُقْسَمَ ، وَعَنْ قَتْلِ الْوِلْدَانِ  "" .","","Al-Mu'jam al-Kabir 11067","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن شريك بن عبد الله النخعي عن يزيد بن هارون عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عباس"
"11097","11068  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ أَسَدِ بْنِ يَزِيدَ الْأَصْبَهَانِيُّ  ، حَدَّثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَلَا هَذِهِ الْآيَةَ :         {      اتَّقُوا اللهَ حَقَّ تُقَاتِهِ         }      . الْآيَةَ ، فَقَالَ :  لَوْ أَنَّ قَطْرَةً مِنَ  الزَّقُّومِ  قَطَرَتْ فِي بِحَارِ الدُّنْيَا لَأَفْسَدَتْ عَلَيْهِمْ مَعَايِشَهُمْ  كَيْفَ بِمَنْ يَكُونُ طَعَامَهُ ؟  .","","Al-Mu'jam al-Kabir 11068","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن شعبة بن الحجاج عن أبو داود الطيالسي عن ابن أسد محمد بن أسد بن يزيد الأصبهاني عن الطبراني","مجاهد عن ابن عباس"
"11098","11069  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ  ، ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ كَانَ "" يَرَى الِاسْتِثْنَاءَ ، وَلَوْ بَعْدَ سَنَةٍ  ، ثُمَّ قَرَأَ :         {      وَلا تَقُولَنَّ لِشَيْءٍ إِنِّي فَاعِلٌ ذَلِكَ غَدًا             *          إِلا أَنْ يَشَاءَ اللهُ وَاذْكُرْ رَبَّكَ إِذَا نَسِيتَ         }      . يَقُولُ : "" إِذَا ذَكَرْتَ  "" .  فَقِيلَ  لِلْأَعْمَشِ :  سَمِعْتَ  هَذَا مِنْ مُجَاهِدٍ قَالَ :  حَدَّثَنِي بِهِ  اللَّيْثُ  عَنْ  مُجَاهِدٍ .","","Al-Mu'jam al-Kabir 11069","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن الأعمش عن أبو معاوية الضرير عن يحيى بن سليمان بن يحيى عن أحمد بن يحيى بن خالد الرقي عن الطبراني","مجاهد عن ابن عباس"
"11099","[11/69]      11070  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرٍ الْمَدِينِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  عَنْ  حُمَيْدٍ الْأَعْرَجِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا :  أَنَّ فِتْيَانًا مِنْ  بَنِي هَاشِمٍ  أَتَوُا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : يَا رَسُولَ اللهِ اسْتَعْمِلْنَا عَلَى هَذِهِ الصَّدَقَةِ نُصِيبُ مِنْهَا مَا يُصِيبُ النَّاسُ ، وَنُؤَدِّي كَمَا يُؤَدُّونَ ، فَقَالَ :  إِنَّا  آلَ مُحَمَّدٍ  لَا تَحِلُّ لَنَا الصَّدَقَةُ وَهِيَ أَوْسَاخُ النَّاسِ  ، وَلَكِنْ مَا ظَنُّكُمْ إِذَا أَنَا أَخَذْتُ بِحَلْقَةِ الْجَنَّةِ هَلْ أُوثِرُ عَلَيْكُمْ أَحَدًا  ؟ ""  .","","Al-Mu'jam al-Kabir 11070","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن حميد بن قيس الأعرج عن جعفر الصادق عن عبد الله بن جعفر بن نجيح عن علي ابن المديني عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11100","11071  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ بْنِ مُجَمِّعٍ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  مُجَاهِدٍ وَسَعِيدِ بْنِ جُبَيْرٍ ، وَطَاوُسٍ وَعَطَاءٍ ، أَخْبَرُوهُ  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّهُ أَخْبَرَهُمْ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يَجْمَعُ بَيْنَ الظُّهْرِ وَالْعَصْرِ  ، وَيَجْمَعُ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ فِي السَّفَرِ مِنْ غَيْرِ أَنْ يُعْجِلَهُ أَمْرٌ أَوْ يَطْلُبَهُ عَدُوٌّ أَوْ يَخَافَ شَيْئًا  .","","Al-Mu'jam al-Kabir 11071","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الكريم الاصطخري عن إبراهيم بن إسماعيل بن مجمع عن عبد العزيز بن أبي حازم المخزومي عن مصعب بن عبد الله بن مصعب الزبيري عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11101","11072  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنْتُ فِي بَيْتِ خَالَتِي  مَيْمُونَةَ  ، فَقَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ اللَّيْلِ  فَتَوَضَّأَ فَقُمْتُ عَنْ شِمَالِهِ فَأَدَارَنِي بِيَدَيْهِ فَأَقَامَنِي عَنْ يَمِينِهِ  .","","Al-Mu'jam al-Kabir 11072","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","مجاهد عن ابن عباس"
"11102","[11/70]      11073  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  جَمَعَ فِي السَّفَرِ وَالْحَضَرِ بَيْنَ الظُّهْرِ وَالْعَصْرِ  ، وَالْمَغْرِبِ وَالْعِشَاءِ  .","","Al-Mu'jam al-Kabir 11073","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","مجاهد عن ابن عباس"
"11103","11074  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  صَالِحُ بْنُ عَبْدِ اللهِ التِّرْمِذِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْإِسْلَامَ بَدَأَ  غَرِيبًا  ، وَسَيَعُودُ  غَرِيبًا  ،  فَطُوبَى  لِلْغُرَبَاءِ  .","","Al-Mu'jam al-Kabir 11074","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن صالح بن عبد الله بن ذكوان الترمذي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11104","11075  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  صَالِحٌ التِّرْمِذِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ فِتَنًا  كَقِطَعِ  اللَّيْلِ الْمُظْلِمِ  يُصْبِحُ الرَّجُلُ فِيهَا مُؤْمِنًا ، وَيُمْسِي كَافِرًا ، وَيُمْسِي مُؤْمِنًا ، وَيُصْبِحُ كَافِرًا ، يَبِيعُ فِيهَا قَوْمٌ دِينَهُمْ بِعَرَضٍ مِنَ الدُّنْيَا  .","","Al-Mu'jam al-Kabir 11075","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن صالح بن عبد الله بن ذكوان الترمذي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11105","11076  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  يَعْقُوبُ الْقُمِّيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى         [11/71]      اللهُ عَلَيْهِ وَسَلَّمَ :  احْتَجِمُوا لِخَمْسَ عَشْرَةَ  ، أَوْ لِسَبْعَ عَشْرَةَ ، أَوْ تِسْعَ عَشْرَةَ ، أَوْ إِحْدَى وَعِشْرِينَ ، لَا  يَتَبَيَّغُ  بِكُمُ الدَّمُ فَيَقْتُلَكُمْ  .","","Al-Mu'jam al-Kabir 11076","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن أحمد بن يونس بن المسيب الضبي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عباس"
"11106","11077  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  أَبُو خَيْثَمَةَ مُصْعَبُ بْنُ سَعِيدٍ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ وُلِدَ لَهُ ثَلَاثَةٌ فَلَمْ يُسَمِّ أَحَدَهُمْ مُحَمَّدًا فَقَدْ جَهِلَ  .","","Al-Mu'jam al-Kabir 11077","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن موسى بن أعين الجزري عن مصعب بن سعيد المصيصي عن أحمد بن النضر بن بحر العسكري عن الطبراني","مجاهد عن ابن عباس"
"11107","11078  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ ،  ثَنَا  أَبُو خَيْثَمَةَ مُصْعَبُ بْنُ سَعِيدٍ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَهْلُ  الْمَعْرُوفِ  فِي الدُّنْيَا أَهْلُ  الْمَعْرُوفِ  فِي الْآخِرَةِ  .","","Al-Mu'jam al-Kabir 11078","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن موسى بن أعين الجزري عن مصعب بن سعيد المصيصي عن أحمد بن النضر بن بحر العسكري عن الطبراني","مجاهد عن ابن عباس"
"11108","11079  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَرَحِ الْأَصْبَهَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَحَبَّ الْأَعْمَالِ إِلَى اللهِ بَعْدَ الْفَرَائِضِ  إِدْخَالُ السُّرُورِ عَلَى الْمُسْلِمِ  .","","Al-Mu'jam al-Kabir 11079","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن إسماعيل بن عمرو البجلي عن محمد بن الفرح الأصبهاني عن الطبراني","مجاهد عن ابن عباس"
"11109","11080  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَيَانٍ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  شَرِيكٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ فَتْحِ مَكَّةَ  عَنِ  الْجَلَّالَةِ  ، وَعَنِ النُّهْبَةِ  .","","Al-Mu'jam al-Kabir 11080","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن عبد الحميد بن بيان السكري عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن ابن عباس"
"11110","[11/72]      11081  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رُزَيْقِ بْنِ جَامِعٍ الْمِصْرِيُّ  ، ثَنَا  الْهَيْثَمُ بْنُ حَبِيبٍ ،  ثَنَا  سَلَّامٌ الطَّوِيلُ ،  عَنْ  حَمْزَةَ الزَّيَّاتِ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ يَوْمَ عَرَفَةَ كَانَ لَهُ كَفَّارَةُ سَنَتَيْنِ  .","","Al-Mu'jam al-Kabir 11081","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن حمزة الزيات عن سلام بن سلم الطويل عن الهيثم بن حبيب عن محمد بن رزيق بن جامع العدل عن الطبراني","مجاهد عن ابن عباس"
"11111","11082  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رُزَيْقِ بْنِ جَامِعٍ  ، ثَنَا  الْهَيْثَمُ بْنُ حَبِيبٍ ،  ثَنَا  سَلَّامٌ الطَّوِيلُ ،  عَنْ  حَمْزَةَ الزَّيَّاتِ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ يَوْمًا مِنَ الْمُحَرَّمِ فَلَهُ بِكُلِّ يَوْمٍ ثَلَاثِينَ حَسَنَةً  .","","Al-Mu'jam al-Kabir 11082","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن حمزة الزيات عن سلام بن سلم الطويل عن الهيثم بن حبيب عن محمد بن رزيق بن جامع العدل عن الطبراني","مجاهد عن ابن عباس"
"11112","11083  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  مِنْدَلٌ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَّا مَنْ لَمْ يُوَقِّرِ الْكَبِيرَ ، وَيَرْحَمِ الصَّغِيرَ  ، وَيَأْمُرْ بِالْمَعْرُوفِ ، وَيَنْهَى عَنِ الْمُنْكَرِ  .","","Al-Mu'jam al-Kabir 11083","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن مندل بن علي عن أبو بلال الأشعري عن عمر بن حفص السدوسي عن الطبراني","مجاهد عن ابن عباس"
"11113","[11/73]      11084  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلَوَيْهِ الْقَطَّانُ  ، ثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ السُّكَّرِيُّ ،  ثَنَا  مُوسَى بْنُ أَبِي سُلَيْمٍ الْبَصْرِيُّ ،  ثَنَا  مِنْدَلٌ ،  ثَنَا  الْأَعْمَشُ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  خَرَجْتُ أَنَا وَالنَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَعَلِيٌّ  رَضِيَ اللهُ عَنْهُ ، فِي  حِشَانِ  الْمَدِينَةِ  ، فَمَرَرْنَا  بِحَدِيقَةٍ  ، فَقَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : مَا أَحْسَنَ هَذِهِ  الْحَدِيقَةَ  يَا رَسُولَ اللهِ ، فَقَالَ :  حَدِيقَتُكَ  فِي الْجَنَّةِ أَحْسَنُ مِنْهَا  ، ثُمَّ أَوْمَأَ بِيَدِهِ إِلَى رَأْسِهِ وَلِحْيَتِهِ ثُمَّ بَكَى حَتَّى عَلَا بُكَاؤُهُ ، قِيلَ : مَا يُبْكِيكَ ؟ قَالَ : "" ضَغَائِنُ فِي صُدُورِ قَوْمٍ لَا يُبْدُونَهَا لَكَ حَتَّى يَفْقِدُونِي  .","","Al-Mu'jam al-Kabir 11084","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن مندل بن علي عن موسى بن أبي سليم البصري عن أحمد بن محمد السكري عن ابن علويه الحسن بن علي القطان عن الطبراني","مجاهد عن ابن عباس"
"11114","11085  -  حَدَّثَنَا  سَلَمَةُ بْنُ إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ بْنِ يَحْيَى بْنِ سَلَمَةَ بْنِ كُهَيْلٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ  ، عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُعْطِيتُ خَمْسًا لَمْ يُعْطَهَا نَبِيٌّ قَبْلِي  : بُعِثْتُ إِلَى النَّاسِ كَافَّةً  الْأَحْمَرِ  وَالْأَسْوَدِ ، وَإِنَّمَا كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُبْعَثُ إِلَى قَوْمِهِ ، وَنُصِرْتُ  بِالرُّعْبِ  يُرْعَبُ مِنِّي عَدُوِّي عَلَى  مَسِيرَةِ  شَهْرٍ ، وَأُعْطِيتُ الْمَغْنَمَ ، وَجُعِلَتْ لِيَ الْأَرْضُ مَسْجِدًا وَطَهُورًا ، وَأُعْطِيتُ الشَّفَاعَةَ ، فَأَخَّرْتُهَا لِأُمَّتِي يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 11085","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن إسماعيل بن يحيى بن سلمة بن كهيل الحضرمي عن إبراهيم بن إسماعيل الكهيلى عن سلمة بن إبراهيم بن إسماعيل بن يحيى بن سلمة بن كهيل عن الطبراني","مجاهد عن ابن عباس"
"11115","11086  -  حَدَّثَنَا  سَلَمَةُ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ سَلَمَةَ بْنِ كُهَيْلٍ  ، عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [11/74]      قَالَ لَيْلَةَ أُسْرِيَ بِي :  رَأَيْتُ  إِبْرَاهِيمَ  وَهُوَ يُشْبِهُنِي  ، وَرَأَيْتُ  مُوسَى  طُوَالٌ  جَعْدٌ  كَأَنَّهُ مِنْ رِجَالِ  شَنُوءَةَ  ، وَرَأَيْتُ  عِيسَى  أَحْمَرُ رَبْعَةٌ سَبِطٌ ، كَأَنَّ رَأْسَهُ يَقْطُرُ الدُّهْنَ  .","","Al-Mu'jam al-Kabir 11086","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن سلمة بن كهيل الحضرمي عن إسماعيل بن يحيى بن سلمة بن كهيل الحضرمي عن إبراهيم بن إسماعيل الكهيلى عن سلمة عن الطبراني","مجاهد عن ابن عباس"
"11116","11087  -  حَدَّثَنَا  سَلَمَةُ ،  ثَنَا  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ  ، عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِعَلِيٍّ  :  أَنْتَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  .","","Al-Mu'jam al-Kabir 11087","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن إسماعيل بن يحيى بن سلمة بن كهيل الحضرمي عن إبراهيم بن إسماعيل الكهيلى عن سلمة عن الطبراني","مجاهد عن ابن عباس"
"11117","11088  -  حَدَّثَنَا  سَلَمَةُ ،  ثَنَا  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ  ، عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ فِي  حَجَّةِ الْوَدَاعِ  :  لَأَقْتُلَنَّ  الْعَمَالِقَةَ  فِي  كَتِيبَةٍ  . فَقَالَ  جِبْرِيلُ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَوْ  عَلِيُّ بْنُ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 11088","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن إسماعيل بن يحيى بن سلمة بن كهيل الحضرمي عن إبراهيم بن إسماعيل الكهيلى عن سلمة عن الطبراني","مجاهد عن ابن عباس"
"11118","11089  -  حَدَّثَنَا  سَلَمَةُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ  ، عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ كَانَ يَقْرَأُ هَذَا الْحَرْفَ         {      مُسْتَكْبِرِينَ بِهِ سَامِرًا تَهْجُرُونَ         }      . قَالَ : "" كَانَ الْمُشْرِكُونَ يَهْجُرُونَ رَسُولَ اللهِ فِي شِعْرِهِمْ  "" .","","Al-Mu'jam al-Kabir 11089","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن إسماعيل بن يحيى بن سلمة بن كهيل الحضرمي عن إبراهيم بن إسماعيل الكهيلى عن سلمة بن إبراهيم عن الطبراني","مجاهد عن ابن عباس"
"11119","11090  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْوَاهِبِ الْحَارِثِيُّ ،  ثَنَا  يَحْيَى بْنُ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  يُكْرَهُ الْكَلَامُ فِي أَرْبَعِ مَوَاطِنَ  : يَوْمِ         [11/75]      الْجُمُعَةِ ، وَيَوْمِ الْفِطْرِ ، وَيَوْمِ الْأَضْحَى ، وَفِي الِاسْتِسْقَاءِ إِذَا صَعِدَ الْإِمَامُ الْمِنْبَرَ ، فَيَتَكَلَّمُ حَتَّى يَنْزِلَ ""  .","","Al-Mu'jam al-Kabir 11090","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن محمد بن عبد الواهب بن الزبير الحارثي عن إبراهيم بن هاشم البغوي عن الطبراني","مجاهد عن ابن عباس"
"11120","11091  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ هَاشِمٍ الْبَعْلَبَكِّيُّ ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  حَدَّثَنِي  الْحَجَّاجُ بْنُ دِينَارٍ ،  عَنْ  مَنْصُورِ بْنِ الْمُعْتَمِرِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ  أَعْرَابِيًّا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، كَيْفَ الْوُضُوءُ ؟  فَدَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِوَضُوءٍ فَغَسَلَ يَدَهُ الْيُمْنَى ثَلَاثًا ، ثُمَّ أَدْخَلَ يَدَهُ فِي الْإِنَاءِ ، ثُمَّ مَضْمَضَ وَاسْتَنْشَقَ ثَلَاثًا ثَلَاثًا ، ثُمَّ مَسَحَ بِرَأْسِهِ وَظَاهِرِ أُذُنَيْهِ مَعَ رَأْسِهِ ، ثُمَّ غَسَلَ رِجْلَيْهِ ثَلَاثًا "" ، ثُمَّ قَالَ : هَكَذَا الْوُضُوءُ ، فَمَنْ زَادَ عَلَى هَذَا فَقَدْ تَعَدَّى وَظَلَمَ  .","","Al-Mu'jam al-Kabir 11091","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن حجاج بن دينار الأشجعي عن سويد بن عبد العزيز السلمي عن محمد بن هاشم البعلبكي عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11121","11092  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ  ، ثَنَا  حَامِدُ بْنُ آدَمَ الْمَرْوَزِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمَّا آخَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ أَصْحَابِهِ ، بَيْنَ  الْمُهَاجِرِينَ  وَالْأَنْصَارِ  فَلَمْ يُؤَاخِ بَيْنَ  عَلِيِّ بْنِ أَبِي طَالِبٍ  وَبَيْنَ أَحَدٍ مِنْهُمْ ، خَرَجَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ مُغْضَبًا حَتَّى أَتَى  جَدْوَلًا  مِنَ الْأَرْضِ فَتَوَسَّدَ  ذِرَاعَهُ فَسُفَّ عَلَيْهِ الرِّيحُ ، فَطَلَبَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى وَجَدَهُ  فَوَكَزَهُ  بِرِجْلِهِ ، فَقَالَ لَهُ :  قُمْ فَمَا صَلُحْتَ أَنْ تَكُونَ إِلَّا أَبَا تُرَابٍ ، أَغَضِبْتَ عَلَيَّ حِينِ وَاخَيْتُ بَيْنَ  الْمُهَاجِرِينَ  وَالْأَنْصَارِ  وَلَمْ أُوَاخِ         [11/76]      بَيْنَكَ وَبَيْنَ أَحَدٍ مِنْهُمْ ، أَمَا تَرْضَى أَنْ تَكُونَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  ، إِلَّا أَنَّهُ لَيْسَ بَعْدِي نَبِيٌّ ؟ أَلَا مَنْ أَحَبَّكَ حُفَّ بِالْأَمْنِ وَالْإِيمَانِ ، وَمَنْ أَبْغَضَكَ أَمَاتَهُ اللهُ  مِيتَةَ  الْجَاهِلِيَّةِ ، وَحُوسِبَ بِعَمَلِهِ فِي الْإِسْلَامِ  .  في طبعة مكتبة ابن تيمية : ( فتسود ) وهي على الصواب في النسخة الخطية .","","Al-Mu'jam al-Kabir 11092","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن حامد بن آدم التلياني عن محمود بن محمد بن عبد العزيز المروزي عن الطبراني","مجاهد عن ابن عباس"
"11122","11093  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ رَبِّهِ الصَّفَّارُ الْبَغْدَادِيُّ  ، ثَنَا  عَلِيُّ بْنُ جَمِيلٍ الرَّقِّيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فِي الْجَنَّةِ  شَجَرَةٌ  أَوْ مَا فِي الْجَنَّةِ  شَجَرَةٌ  "" -  شَكَّ  عَلِيُّ بْنُ جَمِيلٍ  - "" مَا عَلَيْهَا وَرَقَةٌ إِلَّا مَكْتُوبٌ عَلَيْهَا لَا إِلَهَ إِلَّا اللهُ  مُحَمَّدٌ  رَسُولُ اللهِ  أَبُو بَكْرِ الصِّدِّيقُ  عُمَرُ الْفَارُوقُ  عُثْمَانُ ذُو النُّورَيْنِ  .","","Al-Mu'jam al-Kabir 11093","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن علي بن جميل الرقي عن سعيد بن عبدويه البغدادي عن الطبراني","مجاهد عن ابن عباس"
"11123","11094  -  حَدَّثَنَا  الْمُنْتَصِرُ بْنُ مُحَمَّدِ بْنِ الْمُنْتَصِرِ الْبَغْدَادِيُّ  ، ثَنَا  الْحَسَنُ بْنُ حَمَّادٍ سَجَّادَةُ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ -  أَحْسَبُهُ  رَفَعَهُ  - قَالَ :  إِذَا غَرَبَتِ الشَّمْسُ فَكُفُّوا صِبْيَانَكُمْ  ، فَإِنَّهَا سَاعَةٌ يَنْتَشِرُ فِيهَا الشَّيَاطِينُ  .","","Al-Mu'jam al-Kabir 11094","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن حفص بن غياث النخعي عن الحسن بن حماد سجادة عن منتصر بن محمد بن منتصر البغدادي عن الطبراني","مجاهد عن ابن عباس"
"11124","11095  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ أَيُّوبَ الرَّازِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ         [11/77]      عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا -  أَحْسَبُهُ  رَفَعَهُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - قَالَ :  مَنْهُومَانِ  لَا يَقْضِي أَحَدُهُمَا  نَهْمَتَهُ  :  مَنْهُومٌ  فِي طَلَبِ الْعِلْمِ ،  وَمَنْهُومٌ  فِي طَلَبِ الدُّنْيَا  .","","Al-Mu'jam al-Kabir 11095","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن محمد بن إسحاق بن أيوب النيسابوري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عباس"
"11125","11096  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ  ، ثَنَا  يُوسُفُ بْنُ عَدِيٍّ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" سَجَدَ فِي ص  .","","Al-Mu'jam al-Kabir 11096","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عباس"
"11126","11097  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبَانَ بْنِ صَالِحٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  عَرَضْتُ الْمُصْحَفَ عَلَى ابْنِ عَبَّاسٍ مِنْ فَاتِحَتِهِ إِلَى خَاتِمَتِهِ أُوقِفُهُ عَلَيْهِ عِنْدَ كُلِّ آيَةٍ مِنْهُ  ، وَأَسْأَلُهُ عَنْهَا حَتَّى انْتَهَيْتُ إِلَى هَذِهِ الْآيَةِ :         {      نِسَاؤُكُمْ حَرْثٌ لَكُمْ فَأْتُوا حَرْثَكُمْ أَنَّى شِئْتُمْ         }      ،  فَقَالَ  ابْنُ عَبَّاسٍ  : "" إِنَّ هَذَا الْحَيَّ مِنْ  قُرَيْشٍ  يَشْرَحُونَ  النِّسَاءَ  بِمَكَّةَ  ، وَيَتَلَذَّذُونَ بِهِنَّ مُقْبِلَاتٍ وَمُدْبِرَاتٍ ، فَلَمَّا قَدِمُوا  الْمَدِينَةَ  وَتَزَوَّجُوا فِي  الْأَنْصَارِ  ، وَذَهَبُوا لِيَفْعَلُوا بِهِنَّ ، فَأَنْكَرْنَ ذَلِكَ وَقُلْنَ هَذَا شَيْءٌ لَمْ يَكُنْ يُؤْتَى عَلَيْهِ ، فَانْتَشَرَ الْحَدِيثُ حَتَّى انْتَهَى إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ فِي ذَلِكَ :         {      نِسَاؤُكُمْ حَرْثٌ لَكُمْ فَأْتُوا حَرْثَكُمْ أَنَّى شِئْتُمْ         }      فَمُقْبِلَةً ، وَإِنْ شِئْتَ فَبَارِكَةً "" ، وَإِنَّمَا يَعْنِي بِذَلِكَ مَوْضِعَ الْوَلَدِ لِلْحَرْثِ يَقُولُ : ائْتِ الْحَرْثَ مِنْ حَيْثُ شِئْتَ ،         [11/78]      فَقَالَ  ابْنُ عَبَّاسٍ  : قَالَ  ابْنُ عُمَرَ  : فِي دُبُرِهَا ، فَأَوْهَمَ  ابْنُ عُمَرَ  - وَاللهُ يَغْفِرُ لَهُ - وَإِنَّمَا كَانَ الْحَدِيثُ عَلَى هَذَا  .","","Al-Mu'jam al-Kabir 11097","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبان بن صالح بن عمير عن محمد بن إسحاق عن عبد الرحمن بن محمد المحاربي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","مجاهد عن ابن عباس"
"11127","11098  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَمْرُو بْنُ عُثْمَانَ ابْنُ أَخِي عَلِيِّ بْنِ عَاصِمٍ ،  ثَنَا  أَبُو تُمَيْلَةَ يَحْيَى بْنُ وَاضِحٍ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَذَّنَ سَبْعَ سِنِينَ مُحْتَسِبًا كُتِبَ  لَهُ بَرَاءَةٌ مِنَ النَّارِ  .  في طبعة مكتبة ابن تيمية : ( كبت ) وهي على الصواب في النسخة الخطية .","","Al-Mu'jam al-Kabir 11098","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن جابر الجعفي عن محمد بن ميمون أبو حمزة السكري عن يحيى بن واضح الأنصاري عن عمر بن عثمان بن عاصم القرشي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11128","11099  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  رَوْحُ بْنُ جَنَاحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فَقِيهٌ وَاحِدٌ أَشَدُّ عَلَى الشَّيْطَانِ مِنْ أَلْفِ عَابِدٍ  .","","Al-Mu'jam al-Kabir 11099","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن روح بن جناح مولى الوليد بن عبد الملك عن الوليد بن مسلم القرشي عن سليمان بن أحمد الدمشقي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11129","11100  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  الْحُسَيْنُ بْنُ حُرَيْثٍ ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  ثَنَا  رَجَاءُ بْنُ الْحَارِثِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُهُنَّ أَيْسَرُهُنَّ صَدَاقًا  .","","Al-Mu'jam al-Kabir 11100","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن رجاء بن أبي رجاء المكي عن الفضل بن موسى السيناني عن الحسين بن حريث الخزاعي عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن ابن عباس"
"11130","11101  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،         [11/79]      ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  عَنْ  أَبِي الْحَارِثِ - قَالَ  إِسْحَاقُ بْنُ رَاهَوَيْهِ  : وَهُوَ  رَجَاءٌ  -  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  خَيْرُهُنَّ أَيْسَرُهُنَّ صَدَاقًا  .","","Al-Mu'jam al-Kabir 11101","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن رجاء بن أبي رجاء المكي عن الفضل بن موسى السيناني عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","مجاهد عن ابن عباس"
"11131","11102  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ الْمَوْصِلِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ شَرِكَ فِي دَمٍ حَرَامٍ  بِشَطْرِ  كَلِمَةٍ  جَاءَ يَوْمَ الْقِيَامَةِ مَكْتُوبٌ بَيْنَ عَيْنَيْهِ آيِسٌ مِنْ رَحْمَةِ اللهِ  .","","Al-Mu'jam al-Kabir 11102","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11132","11103  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ مُحْرِمٌ  .","","Al-Mu'jam al-Kabir 11103","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","مجاهد عن ابن عباس"
"11133","11104  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ عَامَّةَ عَذَابِ الْقَبْرِ مِنَ الْبَوْلِ  ،  فَتَنَزَّهُوا  عَنْهُ  .","","Al-Mu'jam al-Kabir 11104","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11134","[11/80]      11105  -  وَبِإِسْنَادِهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُسْلِمُونَ  شُرَكَاءُ  فِي ثَلَاثٍ  : فِي النَّارِ وَالْمَاءِ وَالْكَلَأِ ، وَثَمَنُهُ حَرَامٌ  .","","Al-Mu'jam al-Kabir 11105","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11135","11106  -  حَدَّثَنَا  عَبْدَانُ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِرَجُلٍ  بِهِ جُرْحٌ  يَسْتَأْذِنُهُ فِي بَطِّهِ ، فَأَذِنَ لَهُ  .","","Al-Mu'jam al-Kabir 11106","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11136","11107  -  حَدَّثَنَا  عَبْدَانُ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْتَوْصُوا بِعَمِّيَ  الْعَبَّاسِ  خَيْرًا  ، فَإِنَّهُ بَقِيَّةُ آبَائِي ، وَإِنَّمَا عَمُّ الرَّجُلِ  صِنْوُ  أَبِيهِ  .","","Al-Mu'jam al-Kabir 11107","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11137","11108  -  حَدَّثَنَا  عَبْدَانُ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  دَعَا لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  نِعْمَ  التُّرْجُمَانُ  أَنْتَ  ، وَدَعَا لِي  جِبْرِيلُ  مَرَّتَيْنِ  .","","Al-Mu'jam al-Kabir 11108","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11138","11109  -  حَدَّثَنَا  عَبْدَانُ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ         [11/81]      بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمَّا أَسْلَمَ  عُمَرُ  نَزَلَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَالَ : يَا  مُحَمَّدُ  ، قَدِ اسْتَبْشَرَ أَهْلُ السَّمَاءِ بِإِسْلَامِ  عُمَرَ  .","","Al-Mu'jam al-Kabir 11109","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11139","11110  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدٌ ،  ثَنَا  عَبْدُ اللهِ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ -  أُرَاهُ  رَفَعَهُ  - قَالَ :  اطْلُبُوا الْخَيْرَ وَالْحَوَائِجَ مِنْ حِسَانِ الْوُجُوهِ  .","","Al-Mu'jam al-Kabir 11110","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11140","11111  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدٌ ،  ثَنَا  عَبْدُ اللهِ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  جَاءَ  رَجُلٌ  يُؤْذِنُ بِجِنَازَةِ النَّاسَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَيُّهَا النَّاسُ سَلُوا إِلَى اللهِ مَوْتَاكُمْ ، وَلَا تُؤْذِنُوا بِهِمُ النَّاسَ  "" .","","Al-Mu'jam al-Kabir 11111","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11141","11112  -  حَدَّثَنَا  عَبْدَانُ  ، ثَنَا  زَيْدٌ ،  ثَنَا  عَبْدُ اللهِ ،  عَنِ  الْعَوَّامِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَأَبُو بَكْرٍ  وَعُمَرُ  يُدْخِلُونَ الْمَيِّتَ الْقَبْرَ مِنْ قِبَلِ الْقِبْلَةِ  .","","Al-Mu'jam al-Kabir 11112","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11142","11113  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنِ         [11/82]      ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  زَيِّنُوا  أَصْوَاتَكُمْ بِالْقُرْآنِ  .","","Al-Mu'jam al-Kabir 11113","","عبد الله بن عباس عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن عبد الله بن عمر مشكدانة عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن ابن عباس"
"11143","11114  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  عَبْدَةَ بْنِ أَبِي لُبَابَةَ ،  عَنْ  مِقْسَمٍ ، وَمُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،         {      اللهُ وَلِيُّ الَّذِينَ آمَنُوا يُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ         }      قَالَ : "" هُمْ قَوْمٌ كَانُوا كَفَرُوا  بِعِيسَى  فَآمَنُوا  بِمُحَمَّدٍ  ،         {      وَالَّذِينَ كَفَرُوا أَوْلِيَاؤُهُمُ الطَّاغُوتُ يُخْرِجُونَهُمْ مِنَ النُّورِ إِلَى الظُّلُمَاتِ         }      ، هُمْ قَوْمٌ آمَنُوا  بِعِيسَى  ، فَلَمَّا بُعِثَ  مُحَمَّدٌ  كَفَرُوا بِهِ  ""  .","","Al-Mu'jam al-Kabir 11114","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبدة بن أبي لبابة عن منصور بن المعتمر عن جرير بن عبد الحميد عن أبو بلال الأشعري عن عمر بن حفص السدوسي عن الطبراني","مجاهد عن ابن عباس"
"11144","11115  -  حَدَّثَنَا  الْحَضْرَمِيُّ  ، ثَنَا  لَيْثُ بْنُ هَارُونَ الْعُكْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  بَيْنَمَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمِنْبَرِ إِذْ قَالَ : "" آمِينَ "" ثَلَاثَ مَرَّاتٍ ، فَسُئِلَ عَنْ ذَلِكَ ، فَقَالَ :  أَتَانِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَالَ : مَنْ ذُكِرْتَ عِنْدَهُ ، فَلَمْ يُصَلِّ عَلَيْكَ  فَأَبْعَدَهُ  اللهُ ، قُلْ : آمِينَ ، فَقُلْتُ : آمِينَ  ، قَالَ : مَنْ أَدْرَكَ وَالِدَيْهِ أَوْ أَحَدَهُمَا فَمَاتَ وَلَمْ يُغْفَرْ لَهُ  فَأَبْعَدَهُ  اللهُ ، قُلْ : آمِينَ ، فَقُلْتُ : آمِينَ ، وَمَنْ أَدْرَكَ رَمَضَانَ ، فَلَمْ يُغْفَرْ لَهُ فَأَبْعَدَهُ اللهُ ، قُلْ : آمِينَ ، فَقُلْتُ : آمِينَ  .","","Al-Mu'jam al-Kabir 11115","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن الليث بن هارون العكلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عباس"
"11145","11116  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدٌ ،  عَنْ  يَزِيدَ         [11/83]      بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ أَيَّامٍ أَعْظَمُ عِنْدَ اللهِ ، وَلَا أَحَبُّ إِلَيْهِ الْعَمَلُ فِيهِنَّ مِنْ أَيَّامِ الْعَشْرِ  ، فَأَكْثِرُوا فِيهِنَّ التَّسْبِيحَ ، وَالتَّكْبِيرَ ، وَالتَّهْلِيلَ  .","","Al-Mu'jam al-Kabir 11116","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","مجاهد عن ابن عباس"
"11146","11117  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَدِمْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حُجَّاجًا ، وَأَمَرَهُمْ فَجَعَلُوهَا عُمْرَةً ، ثُمَّ قَالَ :  لَوِ  اسْتَقْبَلْتُ  مِنْ أَمْرِي مَا اسْتَدْبَرْتُ لَفَعَلْتُ كَمَا فَعَلُوا ، وَلَكِنْ  دَخَلَتِ  الْعُمْرَةُ فِي  الْحَجِّ  إِلَى يَوْمِ الْقِيَامَةِ  ، ثُمَّ أَنْشَبَ أَصَابِعَهُ بَعْضَهَا بِبَعْضٍ ، فَحَلَّ النَّاسُ إِلَّا مَنْ كَانَ مَعَهُ الْهَدْيُ ، وَقَدِمَ  عَلِيٌّ  مِنَ  الْيَمَنِ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" بِمَ أَهْلَلْتَ ؟ "" قَالَ : أَهْلَلْتُ بِمَا أَهْلَلْتَ بِهِ ، قَالَ : "" فَهَلْ مَعَكَ هَدْيٌ ؟ "" قَالَ : لَا ، قَالَ : "" فَأَقِمْ كَمَا أَنْتَ وَلَكَ ثُلُثُ هَدْيِي "" وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَهْدَى  مِائَةَ بَدَنَةٍ  .","","Al-Mu'jam al-Kabir 11117","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","مجاهد عن ابن عباس"
"11147","11118  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  سُرَيْجُ بْنُ النُّعْمَانِ (  ح  ) ،  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، قَالَا :  ثَنَا  هُشَيْمٌ ،  أَنَا  زِيَادُ بْنُ أَبِي زِيَادٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْحَجِّ ، فَلَمَّا قَدِمَ طَافَ  بِالْبَيْتِ  وَبَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، وَلَمْ يُقَصِّرْ وَلَمْ يَحِلَّ مَنْ أَهَلَّ الْهَدْيَ ، وَأَمَرَ مَنْ لَمْ يَكُنْ سَاقَ الْهَدْيَ أَنْ يَطُوفَ ، وَأَنْ يَسْعَى وَيُقَصِّرَ أَوْ يَحْلِقَ ، ثُمَّ يَحِلَّ  .","","Al-Mu'jam al-Kabir 11118","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن يزيد بن أبي زياد القرشي عن هشيم بن بشير عن سريج بن النعمان الجوهري عن لحية الليف محمد بن العباس عن الطبراني","مجاهد عن ابن عباس"
"11148","[11/84]      11119  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ، قَالَ :  سَمِعْتُ  إِسْرَائِيلَ ،  يَذْكُرُ عَنْ  أَبِي يَحْيَى الْقَتَّاتِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  مَرَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِرَجُلٍ  وَفَخِذُهُ خَارِجَةٌ ، فَقَالَ :  غَطِّهَا ، فَإِنَّ فَخِذَ الرَّجُلِ مِنْ  عَوْرَتِهِ  .","","Al-Mu'jam al-Kabir 11119","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن إسرائيل بن يونس بن أبي إسحاق عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11149","11120  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ كَيْسَانَ الْمِصِّيصِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي يَحْيَى الْقَتَّاتِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ عَامَّةَ عَذَابِ الْقَبْرِ مِنَ الْبَوْلِ  فَتَنَزَّهُوا  مِنَ الْبَوْلِ  .","","Al-Mu'jam al-Kabir 11120","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن الحسن بن كيسان المصيصي عن الطبراني","مجاهد عن ابن عباس"
"11150","11121  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ كَيْسَانَ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي يَحْيَى الْقَتَّاتِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ عَجَزَ مِنْكُمْ عَنِ الْعَدُوِّ أَنْ يُجَاهِدَهُ  ، وَعَنِ اللَّيْلِ أَنْ يُكَابِدَهُ ، فَلْيُكْثِرْ ذِكْرَ اللهِ  .","","Al-Mu'jam al-Kabir 11121","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","مجاهد عن ابن عباس"
"11151","11122  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ         [11/85]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَنْبَغِي أَنْ يَقُولَ : أَنَا عِنْدَ اللهِ خَيْرٌ مِنْ  يُونُسَ بْنِ مَتَّى  .","","Al-Mu'jam al-Kabir 11122","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن الحسن عن الطبراني","مجاهد عن ابن عباس"
"11152","11123  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  قُطْبَةَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  التَّحْرِيشِ  بَيْنَ الْبَهَائِمِ  .","","Al-Mu'jam al-Kabir 11123","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن الأعمش عن قطبة بن عبد العزيز بن سياه الحماني عن يحيى بن آدم عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مجاهد عن ابن عباس"
"11153","11124  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا الْغَلَّابِيُّ  ، أَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  مُسْلِمٍ الْأَعْوَرِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  وُلِدَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ الِاثْنَيْنِ  ، وَأُنْزِلَ عَلَيْهِ يَوْمَ الِاثْنَيْنِ ، وَمَاتَ يَوْمَ الِاثْنَيْنِ  .","","Al-Mu'jam al-Kabir 11124","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","مجاهد عن ابن عباس"
"11154","11125  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا  ، أَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْلَا أَنْ أَشُقَّ عَلَى أُمَّتِي لَجَعَلْتُ عَلَيْهِمُ السِّوَاكَ  عِنْدَ كُلِّ صَلَاةٍ  .","","Al-Mu'jam al-Kabir 11125","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن عمران البطين عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","مجاهد عن ابن عباس"
"11155","11126  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا  ، أَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَغْتَسِلُ مِنْ وَرَاءِ حُجُرَاتٍ  ، وَمَا رَأَى  عَوْرَتَهُ  أَحَدٌ قَطُّ  .","","Al-Mu'jam al-Kabir 11126","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن عمران البطين عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","مجاهد عن ابن عباس"
"11156","[11/86]      11127  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ خَاتَمُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَلْقَةً مِنْ فِضَّةٍ  .","","Al-Mu'jam al-Kabir 11127","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن عمران البطين عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","مجاهد عن ابن عباس"
"11157","11128  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا  ، ثَنَا  عَبْدُ اللهِ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" نَحَرَ هَدْيَهُ يَوْمَ صُدَّ  بِالتَّنْعِيمِ  .","","Al-Mu'jam al-Kabir 11128","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","مجاهد عن ابن عباس"
"11158","11129  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا  ، ثَنَا  عَبْدُ اللهِ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى عَلَى حَصِيرٍ  .","","Al-Mu'jam al-Kabir 11129","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","مجاهد عن ابن عباس"
"11159","11130  -  حَدَّثَنَا  مُحَمَّدٌ  ، ثَنَا  عَبْدُ اللهِ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      يَا أَيُّهَا النَّبِيُّ لِمَ تُحَرِّمُ مَا أَحَلَّ اللهُ لَكَ         }      قَالَ : "" حَرَّمَ سُرِّيَّتَهُ  ""  .","","Al-Mu'jam al-Kabir 11130","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","مجاهد عن ابن عباس"
"11160","11131  -  حَدَّثَنَا  مُحَمَّدٌ  ، ثَنَا  عَبْدُ اللهِ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  سَافَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي رَمَضَانَ فَصَامَ يَوْمًا إِلَى الْعَصْرِ ثُمَّ أَفْطَرَ  ، ثُمَّ صَامَ فَأَتَمَّ الصِّيَامَ إِلَى اللَّيْلِ  .","","Al-Mu'jam al-Kabir 11131","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","مجاهد عن ابن عباس"
"11161","11132  -  حَدَّثَنَا  مُحَمَّدٌ  ، ثَنَا  عَبْدُ اللهِ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  طَافَ رَسُولُ اللهِ         [11/87]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَرَمَلَ الثَّلَاثَ الْأُولَى  لِيُرِيَ الْمُشْرِكِينَ أَنَّ بِهِ ، وَبِأَصْحَابِهِ قُوَّةً وَمَشَى الْأَرْبَعَ  .","","Al-Mu'jam al-Kabir 11132","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","مجاهد عن ابن عباس"
"11162","11133  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ  ، ثَنَا  عَبْدُ الْحَمِيدِ بْنُ صَالِحٍ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْلَا أَنْ تَضْعُفَ أُمَّتِي لَأَمَرْتُهُمْ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ  .","","Al-Mu'jam al-Kabir 11133","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن سلام بن سليم الحنفي عن عبد الحميد بن صالح البرجمي عن الحسين بن جعفر القتات عن الطبراني","مجاهد عن ابن عباس"
"11163","11134  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      وَاللاتِي يَأْتِينَ الْفَاحِشَةَ مِنْ نِسَائِكُمْ         }      إِلَى قَوْلِهِ :         {      حَتَّى يَتَوَفَّاهُنَّ الْمَوْتُ         }      قَالَ : "" كُنَّ يُحْبَسْنَ فِي الْبُيُوتِ  فَإِنْ مَاتَتْ مَاتَتْ ، وَإِنْ عَاشَتْ عَاشَتْ "" ، حَتَّى نَزَلَتْ هَذِهِ الْآيَةُ الَّتِي فِي النُّورِ         {      الزَّانِيَةُ وَالزَّانِي فَاجْلِدُوا كُلَّ وَاحِدٍ مِنْهُمَا مِائَةَ جَلْدَةٍ         }      وَنَزَلَتْ سُورَةُ الْحُدُودِ ، فَمَنْ عَمِلَ شَيْئًا جُلِدَ وَأُرْسِلَ  "" .","","Al-Mu'jam al-Kabir 11134","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن قيس بن الربيع الأسدي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","مجاهد عن ابن عباس"
"11164","11135  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  ثَنَا  مُسْلِمٌ الضَّبِّيُّ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمَيِّتَ إِذَا دُفِنَ سَمِعَ  خَفْقَ  نِعَالِهِمْ إِذَا وَلَّوْا عَنْهُ مُنْصَرِفِينَ  "" .","","Al-Mu'jam al-Kabir 11135","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن محمد بن فضيل بن غزوان عن يحيى بن سليمان بن يحيى عن روح بن الفرج القطان عن الطبراني","مجاهد عن ابن عباس"
"11165","[11/88]      11136  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ النَّهْدِيُّ ،  ثَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَلْبَسُ قَمِيصًا قَصِيرَ الْيَدَيْنِ وَالطُّولِ  .","","Al-Mu'jam al-Kabir 11136","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن الحسن بن صالح بن صالح بن حي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11166","11137  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ، وَالْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ شَبِيبٍ الْعَسَّالُ الْأَصْبَهَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ، قَالَا :  ثَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اعْتَمَرَ فِي رَمَضَانَ  .","","Al-Mu'jam al-Kabir 11137","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن كيسان البراد عن الحسن بن صالح بن صالح بن حي عن أحمد بن عبد الله اليربوعي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","مجاهد عن ابن عباس"
"11167","11138  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  سَعِيدُ بْنُ حَفْصٍ النُّفَيْلِيُّ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  فِطْرِ بْنِ خَلِيفَةَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَوَّلُ هَذَا الْأَمْرِ نُبُوَّةٌ وَرَحْمَةٌ ، ثُمَّ يَكُونُ خِلَافَةً وَرَحْمَةً  ، ثُمَّ يَكُونُ مُلْكًا وَرَحْمَةً ، ثُمَّ يَكُونُ إِمَارَةً وَرَحْمَةً ، ثُمَّ يَتَكَادَمُونَ عَلَيْهِ تَكَادُمَ الْحُمُرِ فَعَلَيْكُمْ  بِالْجِهَادِ  ، وَإِنَّ أَفْضَلَ  جِهَادِكُمُ  الرِّبَاطُ  ، وَإِنَّ أَفْضَلَ رِبَاطِكُمْ  عَسْقَلَانُ  .","","Al-Mu'jam al-Kabir 11138","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن فطر بن خليفة عن الزهري عن موسى بن أعين الجزري عن سعيد بن حفص بن عمر الهذلي عن أحمد بن النضر بن بحر العسكري عن الطبراني","مجاهد عن ابن عباس"
"11168","11139  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  أَبِي الْأَشْهَبِ الْكُوفِيِّ ،  عَنْ  إِسْمَاعِيلَ بْنِ         [11/89]      أُمَيَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ كَثِيرٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  كُنْتُ جَالِسًا عِنْدَ  ابْنِ عَبَّاسٍ  ، فَأَتَاهُ  رَجُلٌ  ، فَقَالَ : يَا  أَبَا عَبَّاسٍ  طَلَّقْتُ امْرَأَتِي ثَلَاثًا  ،  فَقَالَ  ابْنُ عَبَّاسٍ : "" عَصَيْتَ رَبَّكَ ،  وَبَانَتْ  مِنْكَ امْرَأَتُكَ ، قَالَ اللهُ عَزَّ وَجَلَّ : ( يَا أَيُّهَا النَّبِيُّ إِذَا طَلَّقْتُمُ النِّسَاءَ فَطَلِّقُوهُنَّ فِي قُبُلِ عِدَّتِهِنَّ )  ""  .","","Al-Mu'jam al-Kabir 11139","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن كثير بن عبد الله الداري عن إسماعيل بن أمية الأموي عن جعفر بن حيان العطاردي عن موسى بن أعين الجزري عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","مجاهد عن ابن عباس"
"11169","11140  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  عُبَيْدُ بْنُ عُبَيْدَةَ التَّمَّارُ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  عُثْمَانَ بْنِ سَاجٍ ،  عَنْ  خُصَيْفٍ ،  عَنْ  مُجَاهِدٍ وَعِكْرِمَةَ ، وَسَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  ذُكِرَ الْمَسْحُ عَلَى الْخُفَّيْنِ عِنْدَ  عُمَرَ  وَسَعْدٍ  وَعَبْدِ اللهِ بْنِ عُمَرَ  فَقَالَ  عُمَرُ  وَسَعْدٌ  : أَفْقَهُ ، فَقَالَ  ابْنُ عَبَّاسٍ  :  يَا  سَعْدُ  أَمَا تَذْكُرُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قَدْ مَسَحَ  ، وَلَكِنْ هَلْ مَسَحَ مُنْذُ نَزَلَتْ سُورَةُ الْمَائِدَةِ  .","","Al-Mu'jam al-Kabir 11140","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن خصيف الجزري عن عثمان بن عمرو بن ساج الجزري عن معتمر بن سليمان عن عبيد بن عبيدة التمار عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","مجاهد عن ابن عباس"
"11170","11141  -  حَدَّثَنَا  الْحَسَنُ بْنُ جَرِيرٍ الصُّورِيُّ  ، ثَنَا  أَبُو الْجُمَاهِرِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  رُفِعَ الْقَلَمُ عَنْ ثَلَاثَةٍ  : عَنِ النَّائِمِ حَتَّى يَسْتَيْقِظَ ، وَعَنِ  الْمَعْتُوهِ  حَتَّى يُفِيقَ ، وَالصَّبِيِّ حَتَّى يَعْقِلَ أَوْ يَحْتَلِمَ  .","","Al-Mu'jam al-Kabir 11141","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن محمد بن عثمان الكفرسوسي عن الحسن بن جرير الزنبقي عن الطبراني","مجاهد عن ابن عباس"
"11171","11142  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  عَنْ  هَارُونَ بْنِ هَارُونَ ،         [11/90]      عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَلَاكُ أُمَّتِي فِي ثَلَاثٍ  : فِي  الْعَصَبِيَّةِ  ، وَالْقَدَرِيَّةِ ، وَالرِّوَايَةِ فِي غَيْرِ تَثَبُّتٍ  .","","Al-Mu'jam al-Kabir 11142","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن هارون بن هارون الهديري عن محمد بن شعيب بن شابور القرشي عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","مجاهد عن ابن عباس"
"11172","11143  -  حَدَّثَنَا  الْحَسَنُ بْنُ جَرِيرٍ الصُّورِيُّ  ، ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ حُصَيْنٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ         {      وَاذْكُرْ رَبَّكَ إِذَا نَسِيتَ         }      ، قَالَ : "" إِذَا نَسِيتَ الِاسْتِثْنَاءَ ، فَاسْتَثْنِ إِذَا ذَكَرْتَ  ، وَهِيَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَاصَّةً ، وَلَيْسَ لَنَا أَنْ نَسْتَثْنِيَ إِلَّا فِي صِلَةِ الْيَمِينِ  ""  .","","Al-Mu'jam al-Kabir 11143","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن عبد العزيز بن الحصين المروزي عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن الحسن بن جرير الزنبقي عن الطبراني","مجاهد عن ابن عباس"
"11173","11144  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  قَزَعَةُ بْنُ سُوَيْدٍ الْبَاهِلِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا أَسْأَلُكُمْ عَلَى         [11/91]      مَا أَتَيْتُكُمْ مِنَ الْبَيِّنَاتِ وَالْهُدَى أَجْرًا إِلَّا أَنْ تُوَادُّوا اللهَ  ، وَتَقَرَّبُوا إِلَيْهِ بِطَاعَتِهِ  .","","Al-Mu'jam al-Kabir 11144","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن قزعة بن سويد بن حجير الباهلي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11174","11145  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ، وَيَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ الْحَارِثِ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَهَى  يَوْمَ خَيْبَرَ  عَنْ بَيْعِ الْمَغَانِمِ قَبْلَ أَنْ تُقْسَمَ  .","","Al-Mu'jam al-Kabir 11145","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن عبد الرحمن بن الحارث المخزومي عن عبد الرحمن بن أبي الزناد عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","مجاهد عن ابن عباس"
"11175","11146  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  مُصْعَبُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ عَيَّاشِ بْنِ أَبِي رَبِيعَةَ الْمَخْزُومِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي نَجِيحٍ  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى  يَوْمَ خَيْبَرَ  عَنِ الْحَبَالَى  وَقَالَ : "" تَسْقِي مَاءَكَ زَرْعَ غَيْرِكِ ، وَعَنْ بَيْعِ الْمَغَانِمِ قَبْلَ أَنْ تُقْسَمَ ، وَعَنْ أَكْلِ لُحُومِ الْحُمُرِ  الْإِنْسِيَّةِ  ، وَعَنْ كُلِّ ذِي نَابٍ مِنَ  السِّبَاعِ  .","","Al-Mu'jam al-Kabir 11146","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن عبد الرحمن بن الحارث المخزومي عن مصعب بن عبد الرحمن بن الحارث بن عياش بن أبي ربيعة المخزومي عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11176","11147  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَيُّوبَ ، صَاحِبُ الْمَغَازِي ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ أَبِي نَجِيحٍ  : حَدَّثَنِي  مُجَاهِدٌ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَهْدَى  عَامَ الْحُدَيْبِيَةِ         [11/92]      جَمَلًا فِي هَدَايَاهُ  لِأَبِي جَهْلٍ  فِي رَأْسِهِ  بُرَةٌ  مِنْ فِضَّةٍ لِيَغِيظَ بِهِ الْمُشْرِكِينَ  .","","Al-Mu'jam al-Kabir 11147","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن أحمد بن محمد بن أيوب عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11177","11148  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  أَحْمَدُ بْنُ عَبْدِ الْمَلِكِ بْنِ وَاقِدٍ الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  أَهْدَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  عُمْرَةِ الْحُدَيْبِيَةِ  جَمَلَ  أَبِي جَهْلِ بْنِ هِشَامٍ  عَلَيْهِ  خِشَاشٌ  مِنْ ذَهَبٍ  ، وَهُوَ الزِّمَامُ ، وَمَا فَعَلَ ذَلِكَ إِلَّا لِيَغِيظَ  قُرَيْشًا  .","","Al-Mu'jam al-Kabir 11148","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن أحمد بن عبد الملك بن واقد الحراني عن محمد بن أحمد بن النضر النضري عن الطبراني","مجاهد عن ابن عباس"
"11178","11149  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ الْعَسْقَلَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ ،  ثَنَا  حَفْصُ بْنُ مَيْسَرَةَ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمَانَ أَبُو سُلَيْمَانَ الْمَدِينِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي أُرِيدُ الْغَزْوَ فِي  سَبِيلِ  اللهِ ، قَالَ :  عَلَيْكَ  بِالشَّامِ  فَإِنَّ اللهَ عَزَّ وَجَلَّ قَدْ تَكَفَّلَ لِي  بِالشَّامِ  وَأَهْلِهِ  ، وَالْزَمْ مِنَ  الشَّامِ  عَسْقَلَانَ  ، فَإِنَّهَا إِذَا دَارَتِ الرَّحَا فِي أُمَّتِي كَانَ أَهْلُهَا فِي خَيْرٍ وَعَافِيَةٍ  .","","Al-Mu'jam al-Kabir 11149","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن محمد بن إسحاق عن يحيى بن سليمان أبو سليمان المديني عن حفص بن ميسرة العقيلي عن محمد بن المتوكل بن ابى السرى عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","مجاهد عن ابن عباس"
"11179","[11/93]      11150  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ (  ح  ) ،  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  اللَّهُمَّ اغْفِرْ  لِلْمُحَلِّقِينَ  . قَالُوا : وَلِلْمُقَصِّرِينَ ، قَالَ فِي الثَّالِثَةِ : "" وَلِلْمُقَصِّرِينَ  .","","Al-Mu'jam al-Kabir 11150","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن محمد بن إسحاق عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","مجاهد عن ابن عباس"
"11180","11151  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ ،  ثَنَا  عَامِرُ بْنُ مُدْرِكٍ ،  ثَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ فَرَّ مِنَ اثْنَيْنِ فَقَدْ فَرَّ  ، وَمَنْ فَرَّ مِنْ ثَلَاثَةٍ فَلَمْ يَفِرَّ  .","","Al-Mu'jam al-Kabir 11151","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن الحسن بن صالح بن صالح بن حي عن عامر بن مدرك بن أبي الصفيراء الحارثي عن معمر بن سهل بن معمر الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11181","11152  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  الْحُسَيْنُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  حُسَيْنٌ الْأَشْقَرُ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  السُّبَّقُ ثَلَاثَةٌ : فَالسَّابِقُ إِلَى  مُوسَى  يُوشَعُ بْنُ نُونَ  ، وَالسَّابِقُ إِلَى  عِيسَى  صَاحِبُ يَاسِينَ ، وَالسَّابِقُ إِلَى  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  .","","Al-Mu'jam al-Kabir 11152","","عبد الله بن عباس عن سفيان بن عيينة عن الحسين بن الحسن الأشقر عن الحسين بن أبي السري العسقلاني عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن ابن عباس"
"11182","11153  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ ، وَالْحَسَنُ         [11/94]      بْنُ عَلِيٍّ الْمَعْمَرِيُّ ، قَالَا :  ثَنَا  عَبْدُ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمَّا زَوَّجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَلِيًّا  قَالَتْ  فَاطِمَةُ  : يَا رَسُولَ اللهِ ، زَوَّجْتَنِي مِنْ رَجُلٍ فَقِيرٍ لَيْسَ لَهُ شَيْءٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَا تَرْضَيْنَ يَا  فَاطِمَةُ  أَنَّ اللهَ عَزَّ وَجَلَّ اخْتَارَ مِنْ أَهْلِ الْأَرْضِ رَجُلَيْنِ  أَحَدُهُمَا أَبُوكِ وَالْآخَرُ زَوْجُكِ  .","","Al-Mu'jam al-Kabir 11153","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن معمر بن راشد عن عبد الرزاق الصنعاني عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11183","11154  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  عَبْدُ السَّلَامِ بْنُ صَالِحٍ الْهَرَوِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمَّا زَوَّجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَلِيًّا  مِنْ  فَاطِمَةَ  ، قَالَتْ : زَوَّجْتَنِي مِنْ  عَائِلٍ  لَا مَالَ لَهُ ، فَقَالَ لَهَا :  أَمَا تَرْضَيْنَ أَنْ يَكُونَ اللهُ اطَّلَعَ إِلَى الْأَرْضِ فَاخْتَارَ مِنْهَا رَجُلَيْنِ  جَعَلَ أَحَدَهُمَا أَبَاكِ وَالْآخَرَ زَوْجَكِ  .","","Al-Mu'jam al-Kabir 11154","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن معمر بن راشد عن عبد الرزاق الصنعاني عن عبد السلام بن صالح الهروي عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11184","11155  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ الْوَاسِطِيُّ ،  أَنَا  شَرِيكٌ ،  عَنْ  أَبَّارِ بْنِ تَغْلِبٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،         {      فَاتِّبَاعٌ بِالْمَعْرُوفِ وَأَدَاءٌ إِلَيْهِ بِإِحْسَانٍ         }      قَالَ :  كَانَتْ  بَنُو إِسْرَائِيلَ  إِذَا قُتِلَ مِنْهُمُ الْقَتِيلُ عَمْدًا لَمْ يَحِلَّ لَهُمْ إِلَّا الْقَوَدُ  ، وَأُحِلَّتْ لَكُمُ الدِّيَةُ ، فَأُمِرَ هَذَا أَنْ يَتَّبِعَ بِمَعْرُوفٍ ، وَأُمِرَ هَذَا أَنْ يُؤَدِّيَ بِإِحْسَانٍ ،         {      ذَلِكَ تَخْفِيفٌ مِنْ رَبِّكُمْ         }      ""  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( أبان )","","Al-Mu'jam al-Kabir 11155","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن أبان بن تغلب بن رياح عن شريك بن عبد الله النخعي عن محمد بن عبد الملك الدقيقي عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11185","11156  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ         [11/95]      حُمَيْدٍ الرَّازِيُّ ،  ثَنَا  هَارُونُ بْنُ الْمُغِيرَةِ ،  ثَنَا  عَنْبَسَةُ ،  عَنْ  زَكَرِيَّا بْنِ خَالِدٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَمَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَلِيًّا  أَنْ يَقْسِمَ هَدْيَهُ ، فَقَسَمَهَا أَعْضَاءً ، ثُمَّ أَتَاهُ فَقَالَ :  قَسِّمْ جِلَالَهَا وَجُلُودَهَا  "" .","","Al-Mu'jam al-Kabir 11156","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن زكريا بن خالد عن عنبسة بن سعيد بن الضريس عن هارون بن المغيرة المروزي عن محمد بن حميد الرازي عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11186","11157  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ، وَحُمَيْدٍ الْأَعْرَجِ ،  أَنَّ  رَجُلًا  سَأَلَ  ابْنَ عَبَّاسٍ ، فَقَالَ : إِنَّهُ طَلَّقَ امْرَأَتَهُ مِائَةً ، فَقَالَ : "" عَصَيْتَ رَبَّكَ  ،  وَبَانَتْ  مِنْكَ امْرَأَتُكَ ، فَلَمْ تَتَّقِ اللهَ فَيَجْعَلَ لَكَ مَخْرَجًا وَيَرْزُقَكَ مِنْ حَيْثُ لَا تَحْتَسِبُ ، وَقَرَأَ :         {      يَا أَيُّهَا النَّبِيُّ إِذَا طَلَّقْتُمُ النِّسَاءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ         }      ""  .","","Al-Mu'jam al-Kabir 11157","","عبد الله بن عباس عن حميد بن قيس الأعرج عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","مجاهد عن ابن عباس"
"11187","11158  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ الْعَبَّاسِ صَاحِبُ الشَّامَةِ ،  ثَنَا  الْحَارِثُ بْنُ عَطِيَّةَ ،  ثَنَا  بَعْضُ أَصْحَابِنَا ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا مَرَرْتُمْ بِرِيَاضِ الْجَنَّةِ  فَارْتَعُوا  ، قِيلَ : يَا رَسُولَ اللهِ ، وَمَا رِيَاضُ الْجَنَّةِ ؟ قَالَ : "" مَجَالِسُ الْعِلْمِ  .","","Al-Mu'jam al-Kabir 11158","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن بعض أصحاب الحارث بن عطية المصيصي عن الحارث بن عطية المصيصي عن أحمد بن العباس صاحب الشامة عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11188","11159  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا يُقَاتِلُ قَوْمًا حَتَّى يَدْعُوَهُمْ  .","","Al-Mu'jam al-Kabir 11159","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن عبد الواحد بن زياد عن فضيل بن حسين الجحدري عن محمد بن الفضل بن جابر السقطى عن الطبراني","مجاهد عن ابن عباس"
"11189","[11/96]      11160  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ الرَّازِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  سَيْفِ بْنِ سُلَيْمَانَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ يَهُودَ كَانُوا يَقُولُونَ : هَذِهِ الدُّنْيَا سَبْعَةُ آلَافِ سَنَةٍ ، وَإِنَّمَا نُعَذَّبُ لِكُلِّ أَلْفِ سَنَةٍ يَوْمًا فِي النَّارِ  ، وَإِنَّمَا هِيَ سَبْعَةُ أَيَّامٍ مَعْدُودَاتٍ ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ فِي ذَلِكَ :         {      وَقَالُوا لَنْ تَمَسَّنَا النَّارُ إِلا أَيَّامًا مَعْدُودَةً         }      ، إِلَى قَوْلِهِ :         {      فِيهَا خَالِدُونَ         }      "" .","","Al-Mu'jam al-Kabir 11160","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن سيف بن سليمان المخزومي عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن محمد بن حميد الرازي عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11190","11161  -  حَدَّثَنَا  الْمَعْمَرِيُّ  ، ثَنَا  طَاهِرُ بْنُ أَبِي أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  أَبُو سَعِيدِ بْنُ عَوْدٍ الْمَكِّيُّ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَهَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ النَّوْمِ قَبْلَ الْعِشَاءِ  ، وَعَنِ الْحَدِيثِ بَعْدَهَا  .","","Al-Mu'jam al-Kabir 11161","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن رجاء بن أبي رجاء المكي عن محمد بن عبد الله بن الزبير عن طاهر بن أبى أحمد الزبيري عن الحسن بن علي بن شبيب المعمري عن الطبراني","مجاهد عن ابن عباس"
"11191","11162  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  ثَنَا  ابْنُ مُجَاهِدٍ ،  عَنْ  أَبِيهِ  وَعَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا         [11/97]      أَهْلَ مَكَّةَ  لَا تَقْصُرُوا الصَّلَاةَ فِي أَدْنَى مِنْ أَرْبَعِ  بُرُدٍ  مِنْ  مَكَّةَ  إِلَى  عُسْفَانَ  .","","Al-Mu'jam al-Kabir 11162","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الوهاب بن مجاهد مولى السائب عن إسماعيل بن عياش الأحول عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","مجاهد عن ابن عباس"
"11192","11163  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ الْمُؤَذِّنُ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ مُجَاهِدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَزَلَتْ هَذِهِ الْآيَةُ فِي الْقَدَرِيَّةِ  :         {      يَوْمَ يُسْحَبُونَ فِي النَّارِ عَلَى وُجُوهِهِمْ ذُوقُوا مَسَّ سَقَرَ             *          إِنَّا كُلَّ شَيْءٍ خَلَقْنَاهُ بِقَدَرٍ         }      ""  .","","Al-Mu'jam al-Kabir 11163","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الوهاب بن مجاهد مولى السائب عن عثمان بن الهيثم بن جهم الأشج عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11193","11164  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ مُجَاهِدٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ بِاللَّيْلِ وَالنَّهَارِ سِرًّا وَعَلانِيَةً         }      قَالَ : "" نَزَلَتْ فِي  عَلِيِّ بْنِ أَبِي طَالِبٍ  كَانَتْ عِنْدَهُ أَرْبَعَةُ دَرَاهِمَ ، فَأَنْفَقَ بِاللَّيْلِ وَاحِدًا ، وَبِالنَّهَارِ وَاحِدًا ، وَفِي السِّرِّ وَاحِدًا ، وَفِي الْعَلَانِيَةِ وَاحِدًا  ""  .","","Al-Mu'jam al-Kabir 11164","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الوهاب بن مجاهد مولى السائب عن عبد الرزاق الصنعاني عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","مجاهد عن ابن عباس"
"11194","11165  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  ثَنَا  قَيْسُ بْنُ سَعْدٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَاءَ إِلَى  زَمْزَمَ  فَنَزَعْنَا لَهُ دَلْوًا ، فَشَرِبَ ثُمَّ مَجَّ فِي الدَّلْوِ ، ثُمَّ صَبَبْنَاهُ فِي زَمْزَمَ ، ثُمَّ قَالَ :  لَوْلَا أَنْ تُغْلَبُوا عَلَيْهَا لَنَزَعْتُ بِيَدِي  .","","Al-Mu'jam al-Kabir 11165","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن قيس بن سعد الحبشي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مجاهد عن ابن عباس"
"11195","[11/98]      11166  -  حَدَّثَنَا  أَبُو حَنِيفَةَ مُحَمَّدُ بْنُ حَنِيفَةَ الْوَاسِطِيُّ  ، ثَنَا  أَحْمَدُ بْنُ أَبِي بَكْرٍ السَّالِمِيُّ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  عَنْ  رَبَاحِ بْنِ أَبِي مَعْرُوفٍ الْمَكِّيِّ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَدْخُلُ الْجَنَّةَ رَجُلٌ لَا يَبْقَى فِي الْجَنَّةِ أَهْلُ دَارٍ ، وَلَا غُرْفَةٍ إِلَّا قَالُوا : مَرْحَبًا مَرْحَبًا إِلَيْنَا  فَقَالَ  أَبُو بَكْرٍ  : يَا رَسُولَ اللهِ ، مَا ثَوَابُ هَذَا الرَّجُلِ فِي ذَلِكَ الْيَوْمِ ؟ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَجَلْ وَأَنْتَ هُوَ يَا  أَبَا بَكْرٍ  .","","Al-Mu'jam al-Kabir 11166","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن قيس بن سعد الحبشي عن رباح بن أبي معروف المكي عن محمد بن إسماعيل بن مسلم الديلي عن أحمد بن أبي بكر السالمي عن محمد بن حنيفة القصبى عن الطبراني","مجاهد عن ابن عباس"
"11196","11167  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ، وَعَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ، قَالَا :  ثَنَا  الْحَسَنُ بْنُ أَحْمَدَ بْنِ أَبِي شُعَيْبٍ الْحَرَّانِيُّ ،  ثَنَا  مِسْكِينُ بْنُ بُكَيْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ مُهَاجِرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ أَبِي حُرَّةَ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُ مَاءٍ عَلَى وَجْهِ الْأَرْضِ مَاءُ زَمْزَمَ  فِيهِ طَعَامٌ مِنَ الطُّعْمِ وَشِفَاءٌ مِنَ السُّقْمِ ، وَشَرُّ مَاءٍ عَلَى وَجْهِ الْأَرْضِ مَاءٌ  بِوَادِي بَرَهُوتَ  بَقِيَّةُ  حَضْرَمَوْتَ  كَرِجْلِ الْجَرَادِ مِنَ الْهَوَامِّ يُصْبِحُ يَتَدَفَّقُ وَيُمْسِي لَا بِلَالَ بِهَا  .","","Al-Mu'jam al-Kabir 11167","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن إبراهيم بن أبي حرة النصيبي عن محمد بن مهاجر بن أبي مسلم عن مسكين بن بكير الحراني عن الحسن بن أحمد بن أبي شعيب الحراني عن علي بن سعيد بن بشير عليك عن الطبراني","مجاهد عن ابن عباس"
"11197","11168  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ  ، ثَنَا  زُهَيْرُ بْنُ عَبَّادٍ الرُّؤَاسِيُّ ،  ثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  عَنْ  خُصَيْفٍ ،  عَنْ         [11/99]      مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَدْخُلُ الْجَنَّةَ  مُدْمِنُ  خَمْرٍ ، وَلَا عَاقٌّ ، وَلَا مَنَّانٌ  .","","Al-Mu'jam al-Kabir 11168","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن خصيف الجزري عن عتاب بن بشير عن زهير بن عباد بن مليح الرؤاسي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","مجاهد عن ابن عباس"
"11198","11169  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الصَّائِغِ الْمَكِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُعَاوِيَةَ النَّيْسَابُورِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ الْحَرَّانِيُّ ،  عَنْ  خُصَيْفٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَيَجِيءُ فِي آخِرِ الزَّمَانِ أَقْوَامٌ يَكُونُ وُجُوهُهُمْ وُجُوهَ الْآدَمِيِّينَ ، وَقُلُوبُهُمْ قُلُوبَ الشَّيَاطِينِ  ، أَمْثَالُ الذِّئَابِ الضَّوَارِي ، لَيْسَ فِي قُلُوبِهِمْ شَيْءٌ مِنَ الرَّحْمَةِ ، سَفَّاكُونَ لِلدِّمَاءِ ، لَا يَرِعُونَ عَنْ قَبِيحٍ ، إِنْ تَابَعْتَهُمْ  وَارَبُوكَ  ، وَإِنْ تَوَارَيْتَ عَنْهُمُ اغْتَابُوكَ ، وَإِنْ حَدَّثُوكَ كَذَبُوكَ ، وَإِنِ ائْتَمَنْتَهُمْ خَانُوكَ ، صَبِيُّهُمْ عَامِرٌ وَشَابُّهُمْ شَاطِرٌ وَشَيْخُهُمْ لَا يَأْمُرُ بِمَعْرُوفٍ وَلَا يَنْهَى عَنْ مُنْكَرٍ ، الِاعْتِزَازُ بِهِمْ ذُلٌّ ، وَطَلَبُ مَا فِي أَيْدِيهِمْ فَقْرٌ ، الْحَلِيمُ فِيهِمْ غَاوٍ ، وَالْآمِرُ بِالْمَعْرُوفِ فِيهِمْ مُتَّهَمٌ ، الْمُؤْمِنُ فِيهِمْ مُسْتَضْعَفٌ ، وَالْفَاسِقُ فِيهِمْ مُشَرَّفٌ ، السُّنَّةُ فِيهِمْ بِدْعَةٌ ، وَالْبِدْعَةُ فِيهِمْ سُنَّةٌ ، فَعِنْدَ ذَلِكَ يُسَلَّطُ عَلَيْهِمْ شِرَارُهُمْ ، وَيَدْعُو خِيَارُهُمْ فَلَا يُسْتَجَابُ لَهُمْ  .","","Al-Mu'jam al-Kabir 11169","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن خصيف الجزري عن محمد بن سلمة الباهلي عن محمد بن معاوية بن أعين النيسابوري عن محمد بن علي بن زيد الصائغ عن الطبراني","مجاهد عن ابن عباس"
"11199","11170  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  زُهَيْرُ بْنُ عَبَّادٍ ،  ثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  عَنْ  خُصَيْفٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ         [11/100]      عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَدْخُلُ الْجَنَّةَ  مُدْمِنُ  خَمْرٍ ، وَلَا عَاقٌّ ، وَلَا مَنَّانٌ  قَالَ  ابْنُ عَبَّاسٍ  :  فَشَقَّ ذَلِكَ عَلَيَّ ؛ لِأَنَّ الْمُؤْمِنِينَ يُصِيبُونَ ذُنُوبًا حَتَّى وَجَدْتُ ذَلِكَ فِي كِتَابِ اللهِ فِي الْعَاقِّ :         {      فَهَلْ عَسَيْتُمْ إِنْ تَوَلَّيْتُمْ أَنْ تُفْسِدُوا فِي الأَرْضِ وَتُقَطِّعُوا أَرْحَامَكُمْ         }      الْآيَةَ ، وَفِي الْمَنَّانِ :         {      لا تُبْطِلُوا صَدَقَاتِكُمْ بِالْمَنِّ وَالأَذَى         }      الْآيَةَ ، وَفِي الْخَمْرِ :         {      إِنَّمَا الْخَمْرُ وَالْمَيْسِرُ وَالأَنْصَابُ وَالأَزْلامُ رِجْسٌ         }      إِلَى قَوْلِهِ :         {      فَاجْتَنِبُوهُ         }      .","","Al-Mu'jam al-Kabir 11170","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن خصيف الجزري عن عتاب بن بشير عن زهير بن عباد بن مليح الرؤاسي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","مجاهد عن ابن عباس"
"11200","11171  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  أَحْمَدُ بْنُ عُبَيْدِ اللهِ الْغُدَانِيُّ ،  ثَنَا  الْمُعَلَّى بْنُ مَيْمُونٍ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمَلَائِكَةَ لَتَفْرَحُ بِذَهَابِ الشِّتَاءِ رَحْمَةً لِمَا يَدْخُلُ عَلَى فُقَرَاءِ الْمُؤْمِنِينَ مِنَ الشِّدَّةِ  .","","Al-Mu'jam al-Kabir 11171","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مطر بن طهمان الوراق عن معلى بن ميمون الخصاف عن أحمد بن عبيد الله بن سهيل الغداني عن أحمد بن داود بن موسى السدوسي عن الطبراني","مجاهد عن ابن عباس"
"11201","11172  -  حَدَّثَنَا  إِسْحَاقُ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  عَبْدُ الْكَرِيمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  جَرَيْتُ أَنَا  وَالْفَضْلُ  أَمَامَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [11/101]      مُرْتَدِفَيْنِ  أَتَانًا  وَهُوَ يُصَلِّي  يَوْمَ عَرَفَةَ  لَيْسَ بَيْنَنَا وَبَيْنَهُ مَنْ يَحُولُ بَيْنَنَا وَبَيْنَهُ  .","","Al-Mu'jam al-Kabir 11172","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الكريم بن أبي المخارق عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مجاهد عن ابن عباس"
"11202","11173  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ         }      قَالَ : ""  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ""  .","","Al-Mu'jam al-Kabir 11173","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن جعفر بن إياس اليشكري عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن أبو مسلم الكجي عن الطبراني","مجاهد عن ابن عباس"
"11203","11174  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ يَزِيدَ النَّرْسِيُّ الْبَغْدَادِيُّ  ، ثَنَا  أَبُو عُمَرَ حَفْصُ بْنُ عُمَرَ الْمُقَدَّمِيُّ الزَّوْزَنِيُّ ،  ثَنَا  أَبُو مُحَمَّدٍ الْيَزِيدِيُّ ،  حَدَّثَنِي  أَبُو عَمْرِو بْنُ الْعَلَاءِ ،  عَنْ  مُجَاهِدٍ  ، عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّهُ كَانَ يَقْرَأُ : (         {      وَمَا كَانَ لِنَبِيٍّ أَنْ يَغُلَّ         }      )  وَكَيْفَ لَا يَكُونُ لَهُ أَنْ يَغُلَّ ، وَلَهُ أَنْ يُقْتَلَ "" ، قَالَ اللهُ :         {      وَيَقْتُلُونَ الأَنْبِيَاءَ         }      وَلَكِنَّ الْمُنَافِقِينَ اتَّهَمُوا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي شَيْءٍ "" فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ : ( 855         {      وَمَا كَانَ لِنَبِيٍّ أَنْ يَغُلَّ         }      855 )  "" .","","Al-Mu'jam al-Kabir 11174","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبو عمرو بن العلاء عن يحيى بن المبارك بن المغيرة اليزيدي عن حفص بن عمر بن عبد العزيز صاحب الكسائي عن محمد بن أحمد بن يزيد النرسي عن الطبراني","مجاهد عن ابن عباس"
"11204","11175  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْعَبَّاسِ النَّسَائِيُّ الْبَغْدَادِيُّ  ، ثَنَا  سَهْلُ بْنُ إِبْرَاهِيمَ الْمَرْوَزِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْحُسَيْنِ بْنِ وَاقِدٍ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنِي  أَبُو الْعَلَاءِ بْنُ عَمْرٍو ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  مَا كَانَ فِي الْقُرْآنِ قَتَّلَ بِالتَّشْدِيدِ فَهُوَ عَذَابٌ ، وَمَا كَانَ قَتَلَ بِالتَّخْفِيفِ فَهُوَ رَحْمَةٌ  ""  .","","Al-Mu'jam al-Kabir 11175","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبو عمرو بن العلاء عن الحسين بن واقد المروزي عن علي بن الحسين بن واقد عن سهل بن إبراهيم المروزي عن محمد بن على بن العباس النسائي عن الطبراني","مجاهد عن ابن عباس"
"11205","11176  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  أَبُو مَعْشَرٍ الْبَرَّاءُ يُوسُفُ بْنُ يَزِيدَ ،  ثَنَا  مَيَّاحُ بْنُ سَرِيعٍ ،  عَنْ  مُجَاهِدٍ ،  أَنَّ رَجُلًا كُوفِيًّا سَأَلَ ابْنَ عَبَّاسٍ عَنْ نَبِيذِ  الْجَرِّ  ، فَوَضَعَ  ابْنُ عَبَّاسٍ  إِصْبَعَيْهِ فِي أُذُنَيْهِ وَقَالَ : صُمَّتَا إِنْ كَذَبْتُ عَلَى         [11/102]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَمِعْتُهُ يَقُولُ :  الْمَدَرُ كُلُّهُ حَرَامٌ ، أَبْيَضُهُ وَأَحْمَرُهُ وَأَسْوَدُهُ وَأَخْضَرُهُ  .","","Al-Mu'jam al-Kabir 11176","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مياح بن سريع عن يوسف بن يزيد البراء عن عبيد الله بن عمر القواريري عن محمد بن عبدوس السراج عن الطبراني","مجاهد عن ابن عباس"
"11206","11177  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ الدُّورِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَزِيدَ بْنِ سُلَيْمٍ ، مَوْلَى بَنِي هَاشِمٍ ،  حَدَّثَنِي  حُسَيْنُ بْنُ الْحَسَنِ الْأَشْقَرُ ،  ثَنَا  هُشَيْمُ بْنُ بَشِيرٍ ،  عَنْ  أَبِي هَاشِمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَزُولُ قَدَمَا عَبْدٍ يَوْمَ الْقِيَامَةِ حَتَّى يُسْأَلَ عَنْ أَرْبَعٍ  : عَنْ عُمُرِهِ فِيمَا أَفْنَاهُ ، وَعَنْ جَسَدِهِ فِيمَا أَبْلَاهُ ، وَعَنْ مَالِهِ فِيمَا أَنْفَقَهُ ، وَمِنْ أَيْنَ كَسَبَهُ ، وَعَنْ حُبِّنَا  أَهْلَ الْبَيْتِ  .","","Al-Mu'jam al-Kabir 11177","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن يحيى بن دينار الرماني عن هشيم بن بشير عن الحسين بن الحسن الأشقر عن أحمد بن محمد بن يزيد مولى بني هاشم عن الهيثم بن خلف الدوري عن الطبراني","مجاهد عن ابن عباس"
"11207","11178  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  سَلَّامٌ الطَّوِيلُ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَسْجُدُ عَلَى ثَوْبِهِ  "" .","","Al-Mu'jam al-Kabir 11178","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن زيد بن الحواري العمي عن سلام بن سلم الطويل عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن ابن عباس"
"11208","عَبْدُ الرَّحْمَنِ بْنُ سَابِطٍ  عَنِ  ابْنِ عَبَّاسٍ  11179  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْقُرْمُطِيُّ  ، ثَنَا  هَارُونُ بْنُ         [11/103]      مُوسَى الْهَرَوِيُّ ،  ثَنَا  أَبُو ضَمْرَةَ ،  عَنِ  ابْنِ سَمْعَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَعَلَّكَ أَنْ تَبْقَى بَعْدِي حَتَّى تُدْرِكَ قَوْمًا يُكَذِّبُونَ بِقَدَرِ اللهِ  الذُّنُوبَ عَلَى عِبَادِهِ اشْتَقُّوا كَلَامَهُمْ ذَلِكَ مِنَ النَّصْرَانِيَّةِ ، فَإِذَا كَانَ ذَلِكَ فَابْرَءُوا إِلَى اللهِ مِنْهُمْ "" . فَكَانَ  ابْنُ عَبَّاسٍ  يَرْفَعُ يَدَيْهِ وَيَقُولُ : "" اللَّهُمَّ إِنِّي أَبْرَأُ إِلَيْكَ مِنْهُمْ كَمَا أَمَرَ نَبِيُّكَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 11179","","عبد الرحمن بن سابط الجمحي عن عمرو بن دينار الأثرم عن محمد بن أبي يحيى الأسلمي عن أنس بن عياض الليثي عن هارون بن موسى بن أبي علقمة عن القرمطي محمد بن عبد الله العدوي عن الطبراني","عبد الرحمن بن سابط عن ابن عباس"
"11209","عُبَيْدُ بْنُ عُمَيْرٍ  عَنِ  ابْنِ عَبَّاسٍ  11180  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُمِرَ ابْنُ آدَمَ أَنْ يَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  .","","Al-Mu'jam al-Kabir 11180","","عبد الله بن عباس عن عبيد بن عمير بن قتادة الجندعي عن أبو الزبير المكي عن حفص بن غياث النخعي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عبيد بن عمير عن ابن عباس"
"11210","11181  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  حَدَّثَنِي  يَحْيَى بْنُ صَالِحٍ الْأَيْلِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَالَ إِبْلِيسُ لِرَبِّهِ : يَا رَبِّ قَدْ أُهْبِطَ  آدَمُ  وَقَدْ عَلِمْتُ أَنَّهُ سَيَكُونُ كِتَابٌ وَرُسُلٌ ، فَمَا كِتَابُهُمْ وَرُسُلُهُمْ ؟ قَالَ : قَالَ :  رُسُلُهُمُ الْمَلَائِكَةُ وَالنَّبِيُّونَ مِنْهُمْ ، وَكُتُبُهُمُ التَّوْرَاةُ ، وَالزَّبُورُ ، وَالْإِنْجِيلُ ،         [11/104]      وَالْفُرْقَانُ  ، قَالَ : فَمَا كِتَابِي ؟ قَالَ : كِتَابُكَ الْوَشْمُ ، وَقُرْآنُكَ الشِّعْرُ ، وَرُسُلُكَ الْكَهَنَةُ ، وَطَعَامُكَ مَا لَا يُذْكَرُ اسْمُ اللهِ عَلَيْهِ ، وَشَرَابُكَ كُلُّ مُسْكِرٍ ، وَصِدْقُكُ الْكَذِبُ ، وَبَيْتُكَ الْحَمَّامُ ، وَمَصَائِدُكَ النِّسَاءُ ، وَمُؤَذِّنُكَ  الْمِزْمَارُ  ، وَمَسْجِدُكَ الْأَسْوَاقُ  "" .","","Al-Mu'jam al-Kabir 11181","","عبد الله بن عباس عن عبيد بن عمير بن قتادة الجندعي عن إسماعيل بن أمية الأموي عن يحيى بن صالح الأيلي عن يحيى بن عبد الله بن بكير المخزومي عن يحيى بن عثمان بن صالح عن الطبراني","عبيد بن عمير عن ابن عباس"
"11211","عَمْرُو بْنُ دِينَارٍ  عَنِ  ابْنِ عَبَّاسٍ  .  11182  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  يَعْقُوبُ بْنُ أَبِي عَبَّادٍ الْمَكِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ التَّارِيخُ فِي السَّنَةِ الَّتِي قَدِمَ فِيهَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  الْمَدِينَةِ  وَفِيهَا وُلِدَ  عَبْدُ اللهِ بْنُ الزُّبَيْرِ  ""  .","","Al-Mu'jam al-Kabir 11182","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن يعقوب بن إسحاق القلزمي عن سعيد بن الحكم الجمحي عن عمرو بن أبي الطاهر المصري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11212","11183  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  مَالِكُ بْنُ زِيَادٍ الْكُوفِيُّ ،  ثَنَا  مِنْدَلُ بْنُ عَلِيٍّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أُهْدِيَتْ لَهُ هَدِيَّةٌ ، وَعِنْدَهُ قَوْمٌ فَهُمْ شُرَكَاؤُهُ فِيهَا  .","","Al-Mu'jam al-Kabir 11183","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن ابن جريج عن مندل بن علي عن مالك بن إسماعيل النهدي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11213","11184  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُوسَى بْنِ أَبِي عُثْمَانَ الْأَنْمَاطِيُّ         [11/105]      ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  مَسْلَمَةُ بْنُ عُلَيٍّ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ، وَعَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ نَظَرَ إِلَى فُرْجَةٍ فِي صَفٍّ فَلْيَسُدَّهَا بِنَفْسِهِ  ، فَإِنْ لَمْ يَفْعَلْ فَمَرَّ مَارٌّ  فَلْيَتَخَطَّ  عَلَى رَقَبَتِهِ فَإِنَّهُ لَا  حُرْمَةَ  لَهُ  .","","Al-Mu'jam al-Kabir 11184","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن ابن جريج عن مسلمة بن علي بن خلف الخشني عن الحكم بن موسى بن أبي زهير النسائي عن ابن بلعها عبد الله بن موسى الدهقان عن الطبراني","عمرو بن دينار عن ابن عباس"
"11214","11185  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قَضَى بِالْيَمِينِ وَالشَّاهِدِ  "" .","","Al-Mu'jam al-Kabir 11185","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن موسى بن مسعود النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11215","11186  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَيُّوبَ صَاحِبُ الْمَغَازِي ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنَّ  أَزْوَاجُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْضِبْنَ بِالْحِنَّاءِ وَهُنَّ مُحْرِمَاتٌ  ، وَيَلْبَسْنَ الْمُعَصْفَرَ وَهُنَّ مُحْرِمَاتٌ  .","","Al-Mu'jam al-Kabir 11186","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن يعقوب بن عطاء بن أبي رباح المكي عن أبو بكر بن عياش عن أحمد بن محمد بن أيوب عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عباس"
"11216","11187  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ اللهِ بْنُ الْحَارِثِ الْمَخْزُومِيُّ ،  ثَنَا  شِبْلُ بْنُ عَبَّادٍ ، قَالَ :  سَمِعْتُ  عَمْرَو بْنَ دِينَارٍ ،  يُحَدِّثُ ، عَنْ  جَابِرٍ ، وَابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ بَيْعِ  الثَّمَرِ  حَتَّى يَبْدُوَ صَلَاحُهُ  .","","Al-Mu'jam al-Kabir 11187","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن شبل بن عباد المكي عن عبد الله بن الحارث بن عبد الملك المخزومي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عباس"
"11217","11188  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  سَعِيدُ بْنُ حَفْصٍ النُّفَيْلِيُّ ، قَالَ :  قَرَأْنَا عَلَى  مَعْقِلِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تَبِيعُوا  الثَّمَرَ  حَتَّى يَبْدُوَ صَلَاحُهُ  .","","Al-Mu'jam al-Kabir 11188","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن معقل بن عبيد الله الجزري عن سعيد بن حفص بن عمر الهذلي عن أحمد بن النضر بن بحر العسكري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11218","[11/106]      11189  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا شَهِدَ جِنَازَةً رُئِيَتْ عَلَيْهِ كَآبَةٌ ، وَأَكْثَرَ حَدِيثَ النَّفْسِ  .","","Al-Mu'jam al-Kabir 11189","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","عمرو بن دينار عن ابن عباس"
"11219","11190  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْأُثَايَةِ  إِذْ أُتِيَ بِوَرْدِ الْحِنَّاءِ ، فَقَالَ :  يُشْبِهُ رَيْحَانَ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 11190","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","عمرو بن دينار عن ابن عباس"
"11220","11191  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ وَعَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا مَرَّ بِهَذِهِ الْآيَةِ :         {      وَنَفْسٍ وَمَا سَوَّاهَا             *          فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَاهَا         }      وَقَفَ ، ثُمَّ قَالَ :  اللَّهُمَّ ائْتِ نَفْسِي تَقْوَاهَا أَنْتَ وَلِيُّهَا وَمَوْلَاهَا وَخَيْرُ مَنْ زَكَّاهَا  .","","Al-Mu'jam al-Kabir 11191","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","عمرو بن دينار عن ابن عباس"
"11221","11192  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ  ابْنَ عَبَّاسٍ  قَالَ :  مَنْ لَقِيَ اللهَ لَا يُشْرِكُ بِهِ شَيْئًا ، وَلَا يَقْتُلُ نَفْسًا لَقِيَ اللهَ وَهُوَ خَفِيفُ الظَّهْرِ  .","","Al-Mu'jam al-Kabir 11192","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","عمرو بن دينار عن ابن عباس"
"11222","11193  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  ثَنَا  أَبِي  ،  ثَنَا         [11/107]      ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُدِيمُوا إِلَى  الْمَجْذُومِينَ  النَّظَرَ  .","","Al-Mu'jam al-Kabir 11193","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","عمرو بن دينار عن ابن عباس"
"11223","11194  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْوَاحِدِ الْكَلَاعِيُّ ،  ثَنَا  زَيْنُ بْنُ شُعَيْبٍ الْإِسْكَنْدَرَانِيُّ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ بْنِ مُجَمِّعٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَنَى بِخَالَتِهِ  مَيْمُونَةَ  بِسَرِفَ  وَمَاتَتْ  بِسَرِفَ  .  قَالَ  اللَّيْثُ بْنُ سَعْدٍ  : "" كَانَ  زَيْنُ بْنُ شُعَيْبٍ كَمَا سُمِّيَ زَيْنًا  "" .","","Al-Mu'jam al-Kabir 11194","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن إبراهيم بن إسماعيل بن مجمع عن القاسم بن عبد الله بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن زين بن شعيب المعافري عن عبد الأعلى بن عبد الواحد الكلاعي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11224","11195  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْحُسَيْنِ الْخَوَّاصُ الْمَوْصِلِيُّ ،  ثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  عَنْ  عُمَرَ بْنِ حَبِيبٍ الْمَكِّيِّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ  رَجُلًا  أَعْتَقَ مَمْلُوكًا لَهُ ، فَمَاتَ الْمُعْتِقُ  فَوَرَّثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمُعْتَقَ  "" .","","Al-Mu'jam al-Kabir 11195","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عمر بن حبيب المكي عن عتاب بن بشير عن علي بن الحسين الخواص عن علي بن سعيد بن بشير عليك عن الطبراني","عمرو بن دينار عن ابن عباس"
"11225","11196  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ أَبُو عَبْدِ الرَّحْمَنِ النَّسَائِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ سَيْفٍ أَبُو دَاوُدَ الْحَرَّانِيُّ ،  ثَنَا  سَهْلُ بْنُ حَمَّادٍ أَبُو عَتَّابٍ الدَّلَّالُ ،  ثَنَا  عَزْرَةُ بْنُ ثَابِتٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَابِعُوا بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ ، فَإِنَّهُمَا يَنْفِيَانِ الذُّنُوبَ كَمَا يَنْفِي  الْكِيرُ  خَبَثَ  الْحَدِيدِ  .","","Al-Mu'jam al-Kabir 11196","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عزرة بن ثابت بن أبي زيد الأنصاري عن سهل بن حماد الدلال عن سليمان بن سيف الطائي عن النسائي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11226","[11/108]      11197  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَبَّاسٍ الرَّازِيُّ  ، ثَنَا  عَلِيُّ بْنُ هَاشِمِ بْنِ مَرْزُوقٍ ،  ثَنَا  أَبِي  ،  ثَنَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، رَجُلٌ قَاتَلَ فِي  سَبِيلِ  اللهِ مُحْتَسِبًا حَتَّى يُقْتَلَ ، أَفِي الْجَنَّةِ هُوَ ؟ قَالَ : "" نَعَمْ  فَلَمَّا قَفَا دَعَاهُ : "" أَتَانِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَالَ : إِنْ لَمْ يَكُنْ عَلَيْهِ دَيْنٌ  .","","Al-Mu'jam al-Kabir 11197","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن ليث بن أبي سليم عن عيسى بن أبي عيسى الرازي عن هاشم بن مرزوق عن علي بن هاشم بن مرزوق الرازي عن الجمال الحسن بن العباس عن الطبراني","عمرو بن دينار عن ابن عباس"
"11227","11198  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَمْرُو بْنُ هِشَامٍ أَبُو أُمَيَّةَ الْحَرَّانِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الطَّرَائِفِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ ثَابِتِ بْنِ ثَوْبَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الدِّينُ  النَّصِيحَةُ  ، قِيلَ : لِمَنْ يَا رَسُولَ اللهِ ؟ قَالَ : "" لِلهِ وَلِكِتَابِهِ وَلِنَبِيِّهِ وَلِأَئِمَّةِ الْمُسْلِمِينَ وَعَامَّتِهِمْ  .","","Al-Mu'jam al-Kabir 11198","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عبد الرحمن بن ثابت العنسي عن عثمان بن عبد الرحمن الطرائفي عن عمرو بن هشام بن بزين الحراني عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11228","11199  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَيُّوبُ الْوَزَّانُ ،  ثَنَا  الْوَلِيدُ بْنُ الْوَلِيدِ ،  عَنِ  ابْنِ ثَوْبَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ يَوْمًا مِنْ رَمَضَانَ مُحْتَسِبًا  كَانَ لَهُ بِصَوْمِهِ مَا لَوْ أَنَّ أَهْلَ الدُّنْيَا         [11/109]      اجْتَمَعُوا مُنْذُ كَانَتِ الدُّنْيَا إِلَى أَنْ تَنْقَضِيَ لَأَوْسَعَهُمْ طَعَامًا وَشَرَابًا لَا يَطْلُبُ إِلَى أَهْلِ الْجَنَّةِ شَيْئًا مِنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 11199","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عبد الرحمن بن ثابت العنسي عن الوليد بن الوليد بن زيد القلانسي عن أيوب بن محمد الوزان عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11229","11200  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  زَكَرِيَّا بْنُ إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ  رَجُلًا  جَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّ أَبِي شَيْخٌ كَبِيرٌ لَا يَسْتَطِيعُ أَنْ يَحُجَّ ، أَفَأَحُجُّ عَنْهُ ؟ قَالَ :  نَعَمْ ، أَرَأَيْتَ لَوْ كَانَ عَلَيْهِ دَيْنٌ فَقَضَيْتَ عَنْهُ أَفَلَا يُجْزِي عَنْهُ ؟ فَإِنَّمَا هَذَا مِثْلُ هَذَا  .","","Al-Mu'jam al-Kabir 11200","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عباس"
"11230","11201  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ مُحَمَّدٍ الْمُبَارَكِيُّ ،  ثَنَا  أَبُو شِهَابٍ ،  عَنْ  حَمْزَةَ النَّصِيبِيِّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْتَوْصُوا بِالْمِعْزَى خَيْرًا ، فَإِنَّهَا مَالٌ  رَقِيقٌ  ، وَهُوَ فِي الْجَنَّةِ ، وَأَحَبُّ الْمَالِ إِلَى اللهِ الضَّأْنُ ، وَعَلَيْكُمْ بِالْبَيَاضِ ، فَإِنَّ اللهَ خَلَقَ الْجَنَّةَ بَيْضَاءَ ، فَلْيَلْبَسْهُ أَحْيَاؤُكُمْ وَكَفِّنُوا فِيهِ مَوْتَاكُمْ ، وَإِنَّ دَمَ الشَّاةِ الْبَيْضَاءِ أَعْظَمُ عِنْدَ اللهِ مِنْ دَمِ السَّوْدَاوَيْنِ  .","","Al-Mu'jam al-Kabir 11201","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن حمزة بن أبي حمزة النصيبي عن عبد ربه بن نافع الحناط عن سليمان بن داود المباركي عن الحسن بن علي بن شبيب المعمري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11231","11202  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مِهْرَانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ  رَجُلًا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ بِيَ النَّاسُورَ فَيَسِيلُ مِنِّي ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا تَوَضَّأْتَ مِنْ قَرْنِكَ إِلَى قَدَمِكَ فَلَا وُضُوءَ عَلَيْكَ  .","","Al-Mu'jam al-Kabir 11202","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عبد الملك بن مهران المغازلي عن بقية بن الوليد عن نعيم بن حماد الخزاعي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11232","[11/110]      11203  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ سَهْلِ بْنِ مُحَمَّدٍ الْعَسْكَرِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  أَبُو جَمِيلَةَ الْفَضْلُ بْنُ صَالِحٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" بَعَثَ  بُدَيْلَ بْنَ وَرْقَاءَ  بِمِنًى  فَنَادَى :  إِنَّ هَذِهِ أَيَّامُ أَكْلٍ  وَشُرْبٍ  ، فَلَا تَصُومُوهَا  .","","Al-Mu'jam al-Kabir 11203","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن المفضل بن صالح النخاس عن سهل بن عثمان العسكري عن محمد بن يحيى بن سهل بن محمد العسكري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11233","11204  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ،  ثَنَا  أَبِي  ،  ثَنَا  أَبُو النَّضْرِ هَاشِمُ بْنُ الْقَاسِمِ ،  ثَنَا  وَرْقَاءُ بْنُ عَمْرٍو ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  صَبَبْتُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَضُوءًا ، فَقَالَ :  اللَّهُمَّ  فَقِّهْهُ  فِي الدِّينِ وَعَلِّمْهُ  التَّأْوِيلَ  .","","Al-Mu'jam al-Kabir 11204","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن ورقاء بن عمر عن هاشم بن القاسم بن مسلم عن علي بن شعيب السمسار عن محمد بن علي بن شعيب السمسار عن الطبراني","عمرو بن دينار عن ابن عباس"
"11234","11205  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  زَكَرِيَّا بْنُ إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَثَ  بِمَكَّةَ  ثَلَاثَ عَشْرَةَ سَنَةً  ، وَتُوُفِّيَ وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ سَنَةً  "" .","","Al-Mu'jam al-Kabir 11205","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن زكريا بن إسحاق المكي عن روح بن عبادة القيسي عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","عمرو بن دينار عن ابن عباس"
"11235","11206  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  عُثْمَانُ بْنُ عَبْدِ الْوَهَّابِ الثَّقَفِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَخَّصَ لِلْحَائِضِ أَنْ تَصْدُرَ قَبْلَ أَنْ تَطُوفَ إِذَا كَانَتْ قَدْ طَافَتْ  .","","Al-Mu'jam al-Kabir 11206","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن عبد الوهاب بن عبد المجيد الثقفي عن عثمان بن عبد الوهاب بن عبد المجيد الثقفى عن إبراهيم بن هاشم البغوي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11236","[11/111]      11207  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ النَّجَّارُ الرَّقِّيُّ ،  ثَنَا  فَيَّاضُ بْنُ مُحَمَّدٍ الرَّقِّيُّ ،  ثَنَا  مَرْوَانُ الْغِفَارِيُّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَرَّ بِقَبْرِ  مُوسَى  عَلَيْهِ السَّلَامُ وَهُوَ يُصَلِّي فِي قَبْرِهِ  .","","Al-Mu'jam al-Kabir 11207","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن ابن جريج عن مروان بن سالم الغفاري عن فياض بن محمد بن سنان الرقي عن محمد بن عبد الله بن سابور النجار عن أحمد بن علي بن مسلم النخشبي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11237","11208  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو أُمَيَّةَ عَمْرُو بْنُ هِشَامٍ الْحَرَّانِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَلِيِّ بْنِ عُرْوَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ، وَعَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَيْفٌ قَائِمَتُهُ مِنْ فِضَّةٍ ، وَقُبَّعَتُهُ مِنْ فِضَّةٍ ، وَكَانَ يُسَمَّى ذَا  الْفَقَارِ  ، وَكَانَتْ لَهُ قَوْسٌ تُسَمَّى  السَّدَادَ ،  وَكَانَتْ لَهُ كِنَانَةٌ تُسَمَّى الْجُمْعَ ، وَكَانَتْ لَهُ دِرْعٌ مُوَشَّحَةٌ بِالنُّحَاسِ تُسَمَّى ذَاتَ  الْفُضُولِ  ، وَكَانَتْ لَهُ حَرْبَةٌ تُسَمَّى النَّبْعَاءَ ، وَكَانَ لَهُ  مِجَنٌّ  يُسَمَّى الذَّقَنَ ، وَكَانَ لَهُ تُرْسٌ أَبْيَضُ يُسَمَّى الْمُوجَزَ ، وَكَانَ لَهُ فَرَسٌ أَدْهَمُ يُسَمَّى  السَّكْبَ ،  وَكَانَ لَهُ سَرْجٌ يُسَمَّى الدَّاجَ ، وَكَانَتْ لَهُ بَغْلَةٌ شَهْبَاءُ يُقَالُ لَهَا  دُلْدُلٌ  ، وَكَانَتْ لَهُ نَاقَةٌ تُسَمَّى  الْقَصْوَاءَ  ، وَكَانَ لَهُ حِمَارٌ يُسَمَّى  يَعْفُورَ  ، وَكَانَ لَهُ بِسَاطٌ يُسَمَّى الْكُرَّ ، وَكَانَتْ لَهُ  عَنَزَةٌ  تُسَمَّى النَّمِرَ ، وَكَانَتْ لَهُ  رَكْوَةٌ  تُسَمَّى  الصَّادِرَ ،  وَكَانَتْ لَهُ مِرْآةٌ تُسَمَّى الْمُدِلَّةَ ،         [11/112]      وَكَانَ لَهُ مِقْرَاضٌ يُسَمَّى الْجَامِعَ ، وَكَانَ لَهُ قَضِيبُ  شَوْحَطٍ  يُسَمَّى الْمُشَوِّقَ  "" .","","Al-Mu'jam al-Kabir 11208","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عبد الملك بن أبي سليمان العرزمي عن علي بن عروة القرشي عن عثمان بن عبد الرحمن الطرائفي عن عمرو بن هشام بن بزين الحراني عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11238","11209  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَكَرِيَّا شَاذَانُ الْبَصْرِيُّ  ، ثَنَا  عَمْرُو بْنُ عُثْمَانَ الْحِمْصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَيْرٍ ،  عَنْ  عَلِيٍّ الْقُرَشِيِّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  جَاءَ  جَابِرُ بْنُ عَبْدِ اللهِ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِسَفَرْجَلَةٍ قَدِمَ بِهَا مِنَ  الطَّائِفِ  ، فَنَاوَلَهُ إِيَّاهَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَذْهَبُ بِطَخَاوَةِ الصَّدْرِ ، وَيَجْلُو الْفُؤَادَ  .","","Al-Mu'jam al-Kabir 11209","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن علي بن زيد بن جدعان عن محمد بن حمير القضاعي عن عمرو بن عثمان بن سعيد الحمصي عن أحمد بن زكريا شاذان البصري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11239","11210  -  حَدَّثَنَا مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  عُبَادَةُ بْنُ زِيَادٍ الْأَسْدِيُّ ،  ثَنَا  يَحْيَى بْنُ الْعَلَاءِ ،  عَنْ  عَلِيِّ بْنِ عُرْوَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  عِيَادَةُ الْمَرِيضِ أَوَّلَ يَوْمٍ سُنَّةٌ  وَبَعْدَ ذَلِكَ تَطَوُّعٌ ""  .","","Al-Mu'jam al-Kabir 11210","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن علي بن عروة القرشي عن يحيى بن العلاء الفوراردي عن عباد بن زياد  بن موسى الساجي عن محمد بن عثمان بن أبي شيبة عن الطبراني","عمرو بن دينار عن ابن عباس"
"11240","11211  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  سُفْيَانُ         [11/113]      بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كُتِبَ عَلَيْهِمْ أَنْ لَا يَفِرَّ عَشْرٌ مِنْ مِائَتَيْنِ ، ثُمَّ خَفَّفَ عَنْهُمْ  ، فَقَالَ :         {      الآنَ خَفَّفَ اللهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا         }      الْآيَةَ ، فَكَتَبَ : "" أَنْ لَا يَفِرَّ الْمِائَةُ مِنَ الْمِائَتَيْنِ  "" .","","Al-Mu'jam al-Kabir 11211","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عبد الله بن مسلمة القعنبي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11241","11212  -  حَدَّثَنَا  عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بْنِ مِقْلَاصٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  كُنْتُ فِيمَنْ قَدَّمَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْمُزْدَلِفَةِ  إِلَى  مِنًى  مَعَ الْعِيَالِ  .","","Al-Mu'jam al-Kabir 11212","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن عبد العزيز بن عمران المصري عن عمر بن عبد العزيز الخزاعي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11242","11213  -  حَدَّثَنَا  أَبُو مُسْلِمٍ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَتْ  عُكَاظٌ  وَمَجَنَّةُ  وَذُو الْمَجَازِ  أَسْوَاقً فِي الْجَاهِلِيَّةِ  ، فَلَمَّا جَاءَ الْإِسْلَامُ تَأَثَّمُوا ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلا مِنْ رَبِّكُمْ         }      فِي  مَوَاسِمِ  الْحَجِّ  ""  .","","Al-Mu'jam al-Kabir 11213","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عبد الله بن مسلمة القعنبي عن أبو مسلم الكجي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11243","11214  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُوسَى بْنِ أَبِي عُثْمَانَ الْأَنْمَاطِيُّ  ، ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  مَسْلَمَةُ بْنُ عُلَيٍّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ، وَعَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ نَظَرَ إِلَى فُرْجَةِ صَفٍّ فَلْيَسْتُرْهَا بِنَفْسِهِ  ، فَإِنْ لَمْ يَفْعَلْ فَمَرَّ مَارٌّ عَلَيْهِ فَلْيَطَأْ عَلَى رَقَبَتِهِ ، فَإِنَّهُ لَا  حُرْمَةَ  لَهُ  .","","Al-Mu'jam al-Kabir 11214","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن ابن جريج عن مسلمة بن علي بن خلف الخشني عن الحكم بن موسى بن أبي زهير النسائي عن ابن بلعها عبد الله بن موسى الدهقان عن الطبراني","عمرو بن دينار عن ابن عباس"
"11244","11215  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْقَوَّاسُ ،  ثَنَا  عَبْدُ الْمَجِيدِ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ         [11/114]      دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ :  إِنَّ الْمُسْتَهْزِئِينَ :  بَقِيَّةُ بْنُ الْوَلِيدِ بْنِ الْمُغِيرَةِ  وَأَبُو زَمْعَةَ - وَهُوَ الْأَسْوَدُ بْنُ عَبْدِ الْمُطَّلِبِ -  وَالْأَسْوَدُ بْنُ عَبْدِ يَغُوثَ ،  وَالْعَاصُ بْنُ وَائِلٍ ،  قَالَ :  كُلُّهُمْ قُتِلَ  بِبَدْرٍ  بِمَوْتٍ أَوْ مَرَضٍ ،  وَالْحَارِثُ بْنُ قَيْسٍ  وَهُوَ مِنَ الْهَيَاطِلِ  ""  .","","Al-Mu'jam al-Kabir 11215","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن ابن جريج عن عبد المجيد بن عبد العزيز بن أبي رواد عن أحمد بن محمد بن علقمة النبال عن محمد بن علي بن زيد الصائغ عن الطبراني","عمرو بن دينار عن ابن عباس"
"11245","11216  -  حَدَّثَنَا  ابْنُ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْوَاسِطِيُّ ،  ثَنَا  أَبُو شِهَابٍ ،  عَنْ  أَبِي مُحَمَّدٍ الْجَزَرِيِّ - وَهُوَ حَمْزَةُ النَّصِيبِيُّ  - عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَعَانَ بِبَاطِلٍ لِيُدْحِضَ بِبَاطِلِهِ حَقًّا ، فَقَدْ بَرِئَ مِنْ ذِمَّةِ اللهِ وَذِمَّةِ رَسُولِهِ  ، وَمَنْ مَشَى إِلَى سُلْطَانِ اللهِ لِيُذِلَّهُ أَذَلَّهُ اللهُ مَعَ مَا  يَدَّخِرُ  لَهُ مِنَ الْخِزْيِ يَوْمَ الْقِيَامَةِ ، سُلْطَانُ اللهِ كِتَابُ اللهِ وَسُنَّةُ نَبِيِّهِ ، وَمَنْ تَوَلَّى مِنْ أُمَرَاءِ الْمُسْلِمِينَ شَيْئًا فَاسْتَعْمَلَ عَلَيْهِمْ رَجُلًا وَهُوَ يَعْلَمُ أَنَّ فِيهِمْ مَنْ هُوَ أَوْلَى بِذَلِكَ ، وَأَعْلَمُ مِنْهُ بِكِتَابِ اللهِ وَسُنَّةِ رَسُولِهِ ، فَقَدْ خَانَ اللهَ وَرَسُولَهُ وَجَمِيعَ الْمُؤْمِنِينَ ، وَمَنْ تَرَكَ حَوَائِجَ النَّاسِ لَمْ يَنْظُرِ اللهُ فِي حَاجَتِهِ حَتَّى يَقْضِيَ حَوَائِجَهُمْ وَيُؤَدِّيَ إِلَيْهِمْ بِحَقِّهِمْ ، وَمَنْ أَكَلَ دِرْهَمَ رِبًا فَهُوَ ثَلَاثٌ وَثَلَاثِينَ زَنْيَةً ، وَمَنْ نَبَتَ لَحْمُهُ مِنْ  سُحْتٍ  ، فَالنَّارُ أَوْلَى بِهِ  .","","Al-Mu'jam al-Kabir 11216","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن حمزة بن أبي حمزة النصيبي عن عبد ربه بن نافع الحناط عن محمد بن أبان بن عمران السلمي عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن دينار عن ابن عباس"
"11246","11217  -  حَدَّثَنَا  عَبْدَانُ  ، ثَنَا  إِسْحَاقُ بْنُ الضَّيْفِ ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ ، يَقُولُ :  بَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْكُلُ  عَرْقًا  ، فَأَتَى الْمُؤَذِّنُ لِلصَّلَاةِ فَوَضَعَهُ وَقَامَ إِلَى الصَّلَاةِ وَلَمْ يَمَسَّ مَاءً  "" .","","Al-Mu'jam al-Kabir 11217","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن ابن جريج عن حجاج بن محمد الأعور عن إسحاق بن الضيف الباهلي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11247","[11/115]      11218  -  حَدَّثَنَا  عَلِيُّ بْنُ إِبْرَاهِيمَ الْعَامِرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  حَسَنُ بْنُ صَالِحٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  قَالَ  ابْنُ عَبَّاسٍ :  إِنَّمَا هُوَ مَنْزِلٌ نَزَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ،  يَعْنِي  الْأَبْطَحَ  .","","Al-Mu'jam al-Kabir 11218","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن الحسن بن صالح بن صالح بن حي عن أحمد بن عبد الله اليربوعي عن علي بن إبراهيم العامري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11248","11219  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  حَسَنِ بْنِ صَالِحٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  إِنَّمَا سَعَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْعُمْرَةِ مِنْ أَجْلِ الْمُشْرِكِينَ  .","","Al-Mu'jam al-Kabir 11219","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن الحسن بن صالح بن صالح بن حي عن حميد بن عبد الرحمن الرؤاسي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11249","11220  -  حَدَّثَنَا  الْحَسَنُ بْنُ غُلَيْبٍ الْمِصْرِيُّ  ، ثَنَا  سُفْيَانُ بْنُ بِشْرٍ الْكُوفِيُّ ،  ثَنَا  جَامِعُ بْنُ عَمْرٍو ،  عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ الطَّائِفِيِّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا وَلِيَ أَحَدٌ وِلَايَةً إِلَّا بُسِطَتْ لَهُ الْعَافِيَةُ  ، فَإِنْ قَبِلَهَا تَمَّتْ لَهُ ، وَإِنْ خَفَرَ عَنْهَا فُتِحَ لَهُ مَا لَا طَاقَةَ لَهُ بِهِ "" . قُلْتُ  لِابْنِ عَبَّاسٍ  : مَا خَفَرَ عَنْهَا ؟ قَالَ : يَطْلُبُ  الْعَثَرَاتِ  وَالْعَوْرَاتِ  .","","Al-Mu'jam al-Kabir 11220","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن جامع بن عمرو عن سفيان بن بشر الكوفي عن الحسن بن غليب المصري عن الطبراني","عمرو بن دينار عن ابن عباس"
"11250","11221  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ النَّسَائِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْوَاسِطِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنَّا نَعْرِفُ انْصِرَافَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِقَوْلِهِ :  سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ وَسَلَامٌ عَلَى الْمُرْسَلِينَ وَالْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( النشائي )","","Al-Mu'jam al-Kabir 11221","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن محمد بن عبد الله بن عبيد الليثي عن محمد بن يزيد الكلاعي عن محمد بن حرب النشائي عن عبيد العجل عن الطبراني","عمرو بن دينار عن ابن عباس"
"11251","[11/116]      11222  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَلِيُّ بْنُ مَيْمُونٍ الرَّقِّيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  مَسْلَمَةُ - يَعْنِي ابْنَ عَلِيٍّ  - عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أُتِيَ بِالْبَاكُورَةِ وَضَعَهُ عَلَى عَيْنَيْهِ ، ثُمَّ قَالَ :  اللَّهُمَّ كَمَا أَطْعَمَتْنَا أَوَّلَهُ فَأَطْعِمْنَا آخِرَهُ  ، ثُمَّ يَأْمُرُ بِهِ لِلْمَوْلُودِ مِنْ أَهْلِهِ  .","","Al-Mu'jam al-Kabir 11222","","عبد الله بن عباس عن عمرو بن دينار الأثرم عن مسلمة بن علي بن خلف الخشني عن عثمان بن عبد الرحمن الطرائفي عن علي بن ميمون الرقي عن عبد الله بن أحمد الجواليقي عن الطبراني","عمرو بن دينار عن ابن عباس"
"11252","عَبْدُ اللهِ بْنُ أَبِي مُلَيْكَةَ  عَنِ  ابْنِ عَبَّاسٍ  .  11223  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، وَعَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيَّانِ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  نَافِعُ بْنُ عُمَرَ ،  حَدَّثَنِي  ابْنُ أَبِي مُلَيْكَةَ ، قَالَ :  كَتَبْتُ إِلَى  ابْنِ عَبَّاسٍ أَسْأَلُهُ عَنِ امْرَأَتَيْنِ كَانَتَا تَخْرِزَانِ ، فَخَرَجَتْ إِحْدَاهُمَا فَادَّعَتْ أَنَّ صَاحِبَتَهَا ضَرَبَتْهَا بِالْإِشْفَا وَأَنْكَرَتِ الْأُخْرَى ، فَكَتَبَ إِلَيَّ  ابْنُ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَضَى :  أَنَّ الْيَمِينَ عَلَى الْمُدَّعَى عَلَيْهِ  ، وَلَوْ أَنَّ النَّاسَ أُعْطُوا دَعْوَاهُمْ لَادَّعَى أُنَاسٌ مِنَ النَّاسِ أَمْوَالَ أُنَاسٍ وَدِمَاءَهُمْ وَلَكِنِ ادْعُهَا "" فَاتْلُ عَلَيْهَا :         {      إِنَّ الَّذِينَ يَشْتَرُونَ بِعَهْدِ اللهِ وَأَيْمَانِهِمْ ثَمَنًا قَلِيلا أُولَئِكَ لا خَلاقَ لَهُمْ فِي الآخِرَةِ         }      . قَالَ : فَفَعَلْتُ فَاعْتَرَفَتْ فَبَلَغَهُ ذَلِكَ فَسُرَّ بِهِ  .","","Al-Mu'jam al-Kabir 11223","","عبد الله بن عباس عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن سعيد بن الحكم الجمحي عن عمرو بن أبي الطاهر المصري عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11253","[11/117]      11224  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  ثَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ يُعْطَى النَّاسُ بِدَعْوَاهُمْ لَادَّعَى رِجَالٌ أَمْوَالَ رِجَالٍ وَدِمَاءَهُمْ وَلَكِنَّ الْيَمِينَ عَلَى الْمُدَّعَى عَلَيْهِ  .","","Al-Mu'jam al-Kabir 11224","","عبد الله بن عباس عن ابن أبي مليكة عن ابن جريج عن المفضل بن فضالة عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11254","11225  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  الْحَسَنُ بْنُ سَهْلٍ الْخَيَّاطُ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  ثَنَا  ابْنُ جُرَيْجٍ ، وَعُثْمَانُ بْنُ الْأَسْوَدِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَوْ يُعْطَى النَّاسُ بِدَعْوَاهُمْ لَادَّعَى رِجَالٌ أَمْوَالَ قَوْمٍ وَدِمَاءَهُمْ  .","","Al-Mu'jam al-Kabir 11225","","عبد الله بن عباس عن ابن أبي مليكة عن عثمان بن الأسود الجمحي عن عبد الله بن إدريس الأودي عن الحسن بن سهل الجعفي عن موسى بن هارون الحمال عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11255","11226  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  أَبِي عَامِرٍ الْخَزَّازِ ،  حَدَّثَنِي  ابْنُ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَشْرَبُ عِنْدَ  سَوْدَةَ  مِنَ الْعَسَلِ ، فَيَدْخُلُ عَلَى  عَائِشَةَ ،  فَقَالَتْ : إِنِّي أَجِدُ مِنْكَ رِيحًا ، ثُمَّ دَخَلَ عَلَى  حَفْصَةَ ،  فَقَالَتْ : إِنِّي أَجِدُ مِنْكَ رِيحًا ، فَقَالَ :  إِنِّي أُرَاهُ مِنْ شَرَابٍ شَرِبْتُهُ عِنْدَ  سَوْدَةَ  وَاللهِ لَا أَشْرَبُهُ  ، فَنَزَلَتْ هَذِهِ الْآيَةُ :         {      يَا أَيُّهَا النَّبِيُّ لِمَ تُحَرِّمُ مَا أَحَلَّ اللهُ لَكَ         }      "" .","","Al-Mu'jam al-Kabir 11226","","عبد الله بن عباس عن ابن أبي مليكة عن صالح بن رستم الخزاز عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11256","11227  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ  ، ثَنَا  أَبُو ظُفُرٍ عَبْدُ السَّلَامِ بْنُ مُطَهَّرٍ ،  ثَنَا  مُوسَى بْنُ خَلَفٍ الْعَمِّيُّ ،  ثَنَا  أَبُو عَامِرٍ         [11/118]      الْخَزَّازُ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أُقِيمَتِ صَلَاةُ الْغَدَاةِ ، فَنَهَضْتُ أُصَلِّي الرَّكْعَتَيْنِ قَبْلَ الْغَدَاةِ ، فَأَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِيَدِي فَجَرَّنِي وَقَالَ :  أَتُصَلِّي الْغَدَاةَ أَرْبَعًا  ؟  .","","Al-Mu'jam al-Kabir 11227","","عبد الله بن عباس عن ابن أبي مليكة عن صالح بن رستم الخزاز عن موسى بن خلف العمي عن عبد السلام بن مطهر الأزدي عن محمد بن يحيى بن المنذر القزاز عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11257","11228  -  حَدَّثَنَا  الْحَسَنُ بْنُ الْعَبَّاسِ الرَّازِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ تَوْبَةَ الْقَزْوِينِيُّ ،  ثَنَا  عَفَّانُ بْنُ سَيَّارٍ ،  ثَنَا  أَبُو عَامِرٍ الْخَزَّازُ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ أُمَّتِي يَشْرَبُونَ الْخَمْرَ فِي آخِرِ الزَّمَانِ يُسَمُّونَهَا بِغَيْرِ اسْمِهَا  "" .","","Al-Mu'jam al-Kabir 11228","","عبد الله بن عباس عن ابن أبي مليكة عن صالح بن رستم الخزاز عن عفان بن سيار الجرجاني عن إسماعيل بن توبة القزويني عن الجمال الحسن بن العباس عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11258","11229  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْكَرِيمِ الزَّعْفَرَانِيُّ الْعَسْكَرِيُّ ، وَعَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عِمْرَانَ الْأَصْبَهَانِيُّ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ يَزِيدَ ، أَخُو رُسْتَةَ  ،  ثَنَا  يَعْقُوبُ أَبُو عُمَرَ صَاحِبُ الْهَرَوِيِّ ،  ثَنَا  أَبُو عَامِرٍ الْخَزَّازُ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُسَافِرُ مِنَ  الْمَدِينَةِ  إِلَى  مَكَّةَ  لَا يَخَافُ إِلَّا اللهَ يُصَلِّي رَكْعَتَيْنِ رَكْعَتَيْنِ  .","","Al-Mu'jam al-Kabir 11229","","عبد الله بن عباس عن ابن أبي مليكة عن صالح بن رستم الخزاز عن يعقوب أبو عمر صاحب الهروي عن عبد الله بن عمر الأصبهاني عن عبد الله بن محمد بن عمران الأصبهاني عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11259","11230  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرٍ الْمُلَيْكِيُّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَيْفَ تُقَدَّسُ أُمَّةٌ لَا يُؤْخَذُ لِضَعِيفِهَا مَنْ قَوِيِّهَا  ؟  "" .","","Al-Mu'jam al-Kabir 11230","","عبد الله بن عباس عن ابن أبي مليكة عن عبد الرحمن بن أبي بكر الجدعاني عن موسى بن إسماعيل التبوذكي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11260","[11/119]      11231  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَالِكٍ الْأَصْبَهَانِيُّ  ، ثَنَا  صَالِحُ بْنُ مِسْمَارٍ ،  ثَنَا  مَعْنُ بْنُ عِيسَى ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرٍ الْمُلَيْكِيُّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  عَرَفَةُ  كُلُّهَا مَوْقِفٌ وَارْتَفِعُوا عَنْ  بَطْنِ  عُرَنَةَ  وَالْمُزْدَلِفَةُ  كُلُّهَا مَوْقِفٌ  ، وَارْتَفِعُوا عَنْ  بَطْنِ مُحَسِّرٍ  .  تصحفت في طبعة مكتبة ابن تيمية إلى : ( عرفة ) وهي على الصواب في المخطوط .]","","Al-Mu'jam al-Kabir 11231","","عبد الله بن عباس عن ابن أبي مليكة عن عبد الرحمن بن أبي بكر الجدعاني عن معن بن عيسى عن صالح بن مسمار الكشميهني عن محمد بن يحيى  بن مالك الأصبهاني عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11261","11232  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ الْمَوْصِلِيُّ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِبْرَاهِيمُ  بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  مَعْنُ بْنُ عِيسَى ، قَالَا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرٍ الْمُلَيْكِيُّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَعْوَتَانِ لَيْسَ بَيْنَهُمَا وَبَيْنَ اللهِ حِجَابٌ  : دَعْوَةُ الْمَظْلُومِ ، وَدَعْوَةُ الْمَرْءِ لِأَخِيهِ بِظَهْرِ الْغَيْبِ  .  في طبعة مكتبة ابن تيمية : (محمد) والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 11232","","عبد الله بن عباس عن ابن أبي مليكة عن عبد الرحمن بن أبي بكر الجدعاني عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11262","11233  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْفَسَوِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُؤَمَّلِ ، قَالَ :  سَمِعْتُ  ابْنَ أَبِي مُلَيْكَةَ  يُحَدِّثُ ، عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  صَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الْكَعْبَةِ  وَكَانَ  بِلَالٌ  وَالْفَضْلُ  عَلَى الْبَابِ ، فَقَالَ  بِلَالٌ  : "" سَجَدَ "" ، وَقَالَ  الْفَضْلُ  : "" رَكَعَ  "" .","","Al-Mu'jam al-Kabir 11233","","عبد الله بن عباس عن ابن أبي مليكة عن عبد الله بن المؤمل العائذي عن سعيد بن سليمان سعدويه عن الحسن بن علي بن الوليد الفسوي عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11263","[11/120]      11234  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  مَعْنُ بْنُ عِيسَى بْنِ مَالِكٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُؤَمَّلِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خُذُوهَا يَا  بَنِي طَلْحَةَ  خَالِدَةً تَالِدَةً لَا يَنْزِعُهَا مِنْكُمْ إِلَّا ظَالِمٌ  -  يَعْنِي  حِجَابَةَ  الْكَعْبَةِ  - .","","Al-Mu'jam al-Kabir 11234","","عبد الله بن عباس عن ابن أبي مليكة عن عبد الله بن المؤمل العائذي عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11264","11235  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  مَعْنُ بْنُ عِيسَى ،  عَنْ  عَبْدِ اللهِ بْنِ الْمُؤَمَّلِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَبَّى حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .","","Al-Mu'jam al-Kabir 11235","","عبد الله بن عباس عن ابن أبي مليكة عن عبد الله بن المؤمل العائذي عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11265","11236  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  ثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُؤَمَّلِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ دُعِيتُ إِلَى كُرَاعٍ لَأَجَبْتُ  .","","Al-Mu'jam al-Kabir 11236","","عبد الله بن عباس عن ابن أبي مليكة عن عبد الله بن المؤمل العائذي عن بشر بن السري عن هارون بن معروف المروزي عن موسى بن هارون الحمال عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11266","11237  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ سَعِيدٍ الْقَطَّانُ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُؤَمَّلِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ         [11/121]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  خَطَبَ النَّاسَ وَظَهْرُهُ إِلَى  الْكَعْبَةِ  مَا بَيْنَ الْحَجَرِ إِلَى الْبَابِ  "" .","","Al-Mu'jam al-Kabir 11237","","عبد الله بن عباس عن ابن أبي مليكة عن عبد الله بن المؤمل العائذي عن زيد بن الحباب العكلي عن أحمد بن محمد بن يحيى القطان عن محمد بن العباس ابن الأخرم عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11267","11238  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  الْحَارِثُ بْنُ عُبَيْدٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ الْأَخْنَسِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَأَنِّي أَنْظُرُ إِلَى أَسْوَدَ  أَفْحَجَ  يَقْلَعُهَا حَجَرًا حَجَرًا  -  يَعْنِي الْكَعْبَةَ  - .","","Al-Mu'jam al-Kabir 11238","","عبد الله بن عباس عن ابن أبي مليكة عن عبيد الله بن الأخنس النخعي عن الحارث بن عبيد الإيادي عن مسلم بن إبراهيم الشحام عن أبو مسلم الكجي عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11268","11239  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  الْحَارِثُ بْنُ عُبَيْدٍ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  أَبُو مَعْشَرٍ الْبَرَّاءُ (  ح  ) ،  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  ثَنَا  هَارُونُ بْنُ مُسْلِمٍ ، كُلُّهُمْ  عَنْ  عَبْدِ اللهِ بْنِ الْأَخْنَسِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَّا مَنْ لَمْ  يَتَغَنَّ  بِالْقُرْآنِ  "" .","","Al-Mu'jam al-Kabir 11239","","عبد الله بن عباس عن ابن أبي مليكة عن عبيد الله بن الأخنس النخعي عن الحارث بن عبيد الإيادي عن مسلم بن إبراهيم الشحام عن أحمد بن داود بن موسى السدوسي عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11269","11240  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي هَذِهِ الْآيَةِ :         {      إِلا الْمُسْتَضْعَفِينَ مِنَ الرِّجَالِ وَالنِّسَاءِ وَالْوِلْدَانِ لا يَسْتَطِيعُونَ حِيلَةً وَلا يَهْتَدُونَ سَبِيلا         }             [11/122]      قَالَ :  كُنْتُ أَنَا وَأُمِّي مِمَّنْ عَذَرَ اللهُ  ""  .","","Al-Mu'jam al-Kabir 11240","","عبد الله بن عباس عن ابن أبي مليكة عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11270","11241  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ (  ح  ) ،  وَحَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ، قَالَا :  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ مِنَ الْخَلَاءِ ، فَقُرِّبَ إِلَيْهِ طَعَامٌ ، فَقَالُوا أَلَا نَأْتِيكَ بِوَضُوءٍ قَالَ :  إِنَّمَا أُمِرْتُ بِالْوُضُوءِ إِذَا قُمْتُ إِلَى الصَّلَاةِ  .","","Al-Mu'jam al-Kabir 11241","","عبد الله بن عباس عن ابن أبي مليكة عن إسماعيل ابن علية عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11271","11242  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلَوَيْهِ الْقَطَّانُ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عِيسَى الْعَطَّارُ ،  ثَنَا  إِسْحَاقُ بْنُ بِشْرٍ أَبُو حُذَيْفَةَ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ تَعَالَى يَدْعُو النَّاسَ يَوْمَ الْقِيَامَةِ بِأَسْمَائِهِمْ  سِتْرًا مِنْهُ عَلَى عِبَادِهِ  ، وَأَمَّا عِنْدَ الصِّرَاطِ ، فَإِنَّ اللهَ عَزَّ وَجَلَّ يُعْطِي كُلَّ مُؤْمِنٍ نُورًا ، وَكُلَّ مُؤْمِنَةٍ نُورًا ، وَكُلَّ مُنَافِقٍ نُورًا ، فَإِذَا اسْتَوَوْا عَلَى الصِّرَاطِ سَلَبَ اللهُ نُورَ الْمُنَافِقِينَ وَالْمُنَافِقَاتِ ، فَقَالَ الْمُنَافِقُونَ :         {      انْظُرُونَا نَقْتَبِسْ مِنْ نُورِكُمْ         }      وَقَالَ الْمُؤْمِنُونَ :         {      رَبَّنَا أَتْمِمْ لَنَا نُورَنَا         }      فَلَا يَذْكُرُ عِنْدَ ذَلِكَ أَحَدٌ أَحَدًا  .  كذا في طبعة مكتبة ابن تيمية ، ونسخة أحمد الثالث ، تفسير ابن كثير عن المصنف ، والذي في نسخة الظاهرية : ( أمهاتهم ) وكذا ذكر في أكثر كتب التخريج والشروح عن المصنف ، ولعله الصواب ، والله أعلم.","","Al-Mu'jam al-Kabir 11242","","عبد الله بن عباس عن ابن أبي مليكة عن ابن جريج عن إسحاق بن بشر البخاري عن إسماعيل بن عيسى البغدادي عن ابن علويه الحسن بن علي القطان عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11272","[11/123]      11243  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ ،  ثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  ثَنَا  أَبُو شِهَابٍ الْحَنَّاطُ ،  ثَنَا  عِيسَى بْنُ مُحَمَّدٍ الْقُرَشِيُّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا غُلَامُ ، احْفَظِ اللهَ يَحْفَظْكَ ، احْفَظِ اللهَ تَجِدْهُ أَمَامَكَ  ،  تَعَرَّفْ  بِاللهِ فِي  الرَّخَاءِ  يَعْرِفْكَ فِي الشِّدَّةِ ، وَاعْلَمْ أَنَّ مَا أَصَابَكَ لَمْ يَكُنْ لِيُخْطِئَكَ ، وَمَا أَخْطَأَكَ لَمْ يَكُنْ لِيُصِيبَكَ ، وَاعْلَمْ أَنَّ الْخَلَائِقَ لَوِ اجْتَمَعُوا عَلَى أَنْ يُعْطُوكَ شَيْئًا لَمْ يُرِدِ اللهُ أَنْ يُعْطِيَكَ لَمْ يَقْدِرُوا عَلَيْهِ ، أَوْ يَصْرِفُوا عَنْكَ شَيْئًا أَرَادَ أَنْ يُصِيبَكَ بِهِ لَمْ يَقْدِرُوا عَلَى ذَلِكَ ، فَإِذَا سَأَلْتَ فَسَلِ اللهَ ، وَإِذَا اسْتَعَنْتَ فَاسْتَعِنْ بِاللهِ ، وَاعْلَمْ أَنَّ النَّصْرَ مَعَ الصَّبْرِ ، وَأَنَّ الْفَرَجَ مَعَ الْكَرْبِ ، وَأَنَّ مَعَ الْعُسْرِ يُسْرًا ، وَاعْلَمْ أَنَّ الْقَلَمَ قَدْ جَرَى بِمَا هُوَ كَائِنٌ  .","","Al-Mu'jam al-Kabir 11243","","عبد الله بن عباس عن ابن أبي مليكة عن عيسى بن محمد القرشي عن عبد ربه بن نافع الحناط عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن معلى بن مهدي الموصلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11273","11244  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  أَبُو حَمْزَةَ السُّكَّرِيُّ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الشَّرِيكُ شَفِيعٌ  ،  وَالشُّفْعَةُ  فِي كُلِّ شَيْءٍ  .","","Al-Mu'jam al-Kabir 11244","","عبد الله بن عباس عن ابن أبي مليكة عن عبد العزيز بن رفيع الطائفي عن محمد بن ميمون أبو حمزة السكري عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11274","[11/124]      11245  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  عَنْ  عُثْمَانَ بْنِ الْأَسْوَدِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  فِي قَوْلِهِ :         {      حَتَّى إِذَا اسْتَيْئَسَ الرُّسُلُ وَظَنُّوا أَنَّهُمْ قَدْ كُذِبُوا         }      قَالَ :  كَانُوا بَشَرًا فَضَعُفُوا وَظَنُّوا أَنَّهُمْ قَدْ أُخْلِفُوا  ، وَقَرَأَ :         {      حَتَّى يَقُولَ الرَّسُولُ         }      .","","Al-Mu'jam al-Kabir 11245","","عبد الله بن عباس عن ابن أبي مليكة عن عثمان بن الأسود الجمحي عن عتاب بن بشير عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11275","11246  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عُمَرَ ، قَالَ عَبْدُ الرَّزَّاقِ : وَلَا أَعْلَمُ الثَّوْرِيَّ إِلَّا  حَدَّثَنَا  ،  عَنْ  عُثْمَانَ بْنِ الْأَسْوَدِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  آيَةُ مَا بَيْنَنَا وَبَيْنَ الْمُنَافِقِينَ أَنَّهُمْ لَا يَتَضَلَّعُونَ مِنْ زَمْزَمَ  .","","Al-Mu'jam al-Kabir 11246","","عبد الله بن عباس عن ابن أبي مليكة عن عثمان بن الأسود الجمحي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11276","11247  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ مُكْرَمٍ  ، ثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  عَنْ  عُثْمَانَ بْنِ أَبِي الْأَسْوَدِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ، قَالَ :  قِيلَ لِابْنِ عَبَّاسٍ : إِنَّ  مُعَاوِيَةَ  أَوْتَرَ بِرَكْعَةٍ ،  فَقَالَ  :  دَعُونَا مِنْ  مُعَاوِيَةَ  فَإِنَّهُ قَدْ صَحِبَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 11247","","عبد الله بن عباس عن ابن أبي مليكة عن عثمان بن الأسود الجمحي عن عبد الله بن رجاء البصري عن سريج بن يونس المروزي عن محمد بن الحسين بن مكرم البارع عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11277","11248  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  خَالِدُ بْنُ يَزِيدَ الْعُمَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدٍ اللَّيْثِيُّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [11/125]      يُنْزِلُ اللهُ كُلَّ يَوْمٍ عِشْرِينَ وَمِائَةَ رَحْمَةٍ : سِتُّونَ مِنْهَا لِلطَّوَّافِينَ  ، وَأَرْبَعُونَ لِلْعَاكِفِينَ حَوْلَ  الْبَيْتِ  ، وَعِشْرُونَ مِنْهَا لِلنَّاظِرِينَ إِلَى  الْبَيْتِ  .","","Al-Mu'jam al-Kabir 11248","","عبد الله بن عباس عن ابن أبي مليكة عن محمد بن عبد الله بن عبيد الليثي عن خالد بن يزيد الحذاء عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11278","11249  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْوَاهِبِ الْحَارِثِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَوْضِي  مَسِيرَةُ  شَهْرٍ زَوَايَاهُ سَوَاءٌ أَكْوَازُهُ عَدَدُ نُجُومِ السَّمَاءِ  ، مَاؤُهُ أَبْيَضُ مِنَ الثَّلْجِ ، وَأَحْلَى مِنَ الْعَسَلِ ، وَأَطْيَبُ مِنَ الْمِسْكِ ، مَنْ شَرِبَ مِنْهُ شَرْبَةً لَمْ يَظْمَأْ بَعْدَهَا أَبَدًا  .","","Al-Mu'jam al-Kabir 11249","","عبد الله بن عباس عن ابن أبي مليكة عن عبد الله بن عبيد بن عمير الجندعي عن محمد بن عبد الواهب بن الزبير الحارثي عن إبراهيم بن هاشم البغوي عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11279","11250  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ  ، ثَنَا  الْحَسَنُ بْنُ بِشْرٍ الْبَجَلِيُّ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  عَنْ  إِبْرَاهِيمَ بْنِ يَزِيدَ ، قَالَ :  سَمِعْتُ  ابْنَ أَبِي مُلَيْكَةَ ، يَقُولُ :  سَمِعْتُ  ابْنَ عَبَّاسٍ :  إِنَّ  الْوَلِيدَ بْنَ الْمُغِيرَةِ  صَنَعَ  لِقُرَيْشٍ  طَعَامًا فَلَمَّا أَكَلُوا قَالَ : مَا تَقُولُونَ فِي هَذَا الرَّجُلِ ؟  فَقَالَ بَعْضُهُمْ : سَاحِرٌ ، وَقَالَ بَعْضُهُمْ : لَيْسَ بِسَاحِرٍ ، وَقَالَ بَعْضُهُمْ :  كَاهِنٌ  ، وَقَالَ بَعْضُهُمْ : لَيْسَ  بِكَاهِنٍ  ، وَقَالَ بَعْضُهُمْ : شَاعِرٌ ، وَقَالَ بَعْضُهُمْ : لَيْسَ بِشَاعِرٍ ، وَقَالَ بَعْضُهُمْ : سِحْرٌ يُؤْثَرُ ، فَأُجْمِعَ رَأْيُهُمْ عَلَى أَنَّهُ سِحْرٌ يُؤْثَرُ ، فَبَلَغَ ذَلِكَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" فَحَزِنَ وَقَنَعَ رَأْسَهُ وَتَدَثَّرَ "" فَأَنْزَلَ اللهُ         [11/126]             {      يَا أَيُّهَا الْمُدَّثِّرُ             *          قُمْ فَأَنْذِرْ             *          وَرَبَّكَ فَكَبِّرْ             *          وَثِيَابَكَ فَطَهِّرْ         }             {      وَالرُّجْزَ فَاهْجُرْ             *          وَلا تَمْنُنْ تَسْتَكْثِرُ             *          وَلِرَبِّكَ فَاصْبِرْ         }      .","","Al-Mu'jam al-Kabir 11250","","عبد الله بن عباس عن ابن أبي مليكة عن إبراهيم بن يزيد الخوزي عن المعافى بن عمران عن الحسن بن بشر الكاهلي عن محمد بن علي بن شعيب السمسار عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11280","11251  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ، وَابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَائِطًا لِبَعْضِ  الْأَنْصَارِ ،  فَجَعَلَ يَتَنَاوَلُ مِنَ الرُّطَبِ فَيَأْكُلُ ، وَهُوَ يَمْشِي وَأَنَا مَعَهُ ، فَالْتَفَتَ إِلَيَّ ، فَقَالَ :  يَا  ابْنَ عَبَّاسٍ  ، لَا تَأْكُلْ بِإِصْبَعَيْنِ ، فَإِنَّهَا أَكْلَةُ الشَّيْطَانِ ، وَكُلْ بِثَلَاثَةِ أَصَابِعَ  .","","Al-Mu'jam al-Kabir 11251","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن يحيى بن عثمان بن صالح عن الطبراني","عبد الله بن أبي مليكة عن ابن عباس"
"11281","عُبَيْدُ اللهِ بْنُ أَبِي يَزِيدَ  عَنِ  ابْنِ عَبَّاسٍ  .  11252  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ :  مَا عَلِمْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ  يَتَحَرَّى  صِيَامَ يَوْمٍ يَبْتَغِي  فَضْلَهُ عَلَى غَيْرِهِ إِلَّا هَذَا الْيَوْمَ لِيَوْمِ عَاشُورَاءَ أَوْ شَهْرِ رَمَضَانَ  .  في طبعة مكتبة ابن تيمية : ( ينبغي ) وما أثبتاه موافق للتخريج.","","Al-Mu'jam al-Kabir 11252","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11282","11252  / 2  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَوْنُ بْنُ سَلَّامٍ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْوَرْدِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عُبَيْدِ اللهِ         [11/127]      بْنِ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  يَرْفَعُهُ  قَالَ :  لَيْسَ لِيَوْمٍ عَلَى يَوْمٍ فَضْلٌ إِلَّا شَهْرَ رَمَضَانَ وَعَاشُورَاءَ  .","","Al-Mu'jam al-Kabir 11252","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن عمرو بن دينار الأثرم عن عبد الجبار بن الورد المخزومي عن عون بن سلام الهاشمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11283","11253  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ، وَعَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، قَالَا :  ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْوَرْدِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ لِيَوْمٍ فَضْلٌ عَلَى يَوْمٍ فِي الصِّيَامِ إِلَّا شَهْرَ رَمَضَانَ ، وَيَوْمَ عَاشُورَاءَ  .","","Al-Mu'jam al-Kabir 11253","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن ابن أبي مليكة عن عبد الجبار بن الورد المخزومي عن عبد الأعلى بن حماد النرسي عن عبد الله بن أحمد بن حنبل عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11284","11254  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَالْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ، وَعَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ قَالُوا :  ثَنَا  أَحْمَدُ بْنُ عُبَيْدِ بْنِ نِسْطَاسٍ الْمَخْزُومِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَضَّلَ يَوْمًا عَلَى يَوْمٍ إِلَّا يَوْمَ عَاشُورَاءَ  .","","Al-Mu'jam al-Kabir 11254","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن عطاء بن السائب عن أبو بكر بن عياش عن أحمد بن عبيد بن نسطاس المخزومي عن علي بن سعيد بن بشير عليك عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11285","11255  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَلَّافُ ،  ثَنَا  مُحَمَّدُ بْنُ سَوَاءٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  يَحْيَى بْنِ كَثِيرٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمْ يَكُنْ يَتَوَخَّى فَضْلَ يَوْمٍ عَلَى يَوْمٍ بَعْدَ رَمَضَانَ إِلَّا يَوْمَ عَاشُورَاءَ  .","","Al-Mu'jam al-Kabir 11255","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن يحيى بن أبي كثير عن سعيد بن أبي عروبة عن محمد بن سواء السدوسي عن محمد بن عبد الرحمن العلاف عن إبراهيم بن هاشم البغوي عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11286","[11/128]      11256  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يُوسُفُ بْنُ مُسْلِمٍ ،  ثَنَا  عَلِيُّ بْنُ هَارُونَ الزَّيْنِيُّ  ،  ثَنَا  مُسْلِمُ بْنُ خَالِدٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مَا صَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا  يَتَحَرَّى  فَضْلَهُ عَلَى يَوْمٍ بَعْدَ رَمَضَانَ إِلَّا يَوْمَ عَاشُورَاءَ  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: (الزينبى) .","","Al-Mu'jam al-Kabir 11256","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن زياد بن سعد الخراساني عن مسلم بن خالد الزنجي عن علي بن هارون الزينبي عن يوسف بن سعيد الأنطاكي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11287","11257  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ يَزِيدَ الْمُقْرِئُ ،  ثَنَا  أَبِي  ،  ثَنَا  وَرْقَاءُ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ .","","Al-Mu'jam al-Kabir 11257","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن ورقاء بن عمر عن عبد الله بن يزيد القصير عن محمد بن أبي عبد الرحمن المكي عن الحسين بن إسحاق التستري عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11288","11258  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  دَاوُدُ بْنُ مِهْرَانَ الدَّبَّاغُ ،  ثَنَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ يَتَوَضَّأُ بِالْمُدِّ ، وَيَغْتَسِلُ بِالصَّاعِ  .","","Al-Mu'jam al-Kabir 11258","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن ابن جريج عن داود ابن النصراني عن داود بن مهران الدباغ عن لحية الليف محمد بن العباس عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11289","11259  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ الْعَيْشِيُّ ،  ثَنَا  أَبُو بَحْرٍ الْبَكْرَاوِيُّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَرُشُّ عَلَى أَهْلِهِ الْمَاءَ لَيْلَةَ ثَلَاثٍ وَعِشْرِينَ  "" .","","Al-Mu'jam al-Kabir 11259","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن ابن جريج عن أبو بحر البكراوي عن محمد بن بكار العيشي عن الحسن بن علي بن شبيب المعمري عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11290","11260  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ         [11/129]      عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنْتُ فِيمَنْ قَدَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ ضَعَفَةِ أَهْلِهِ مِنَ  الْمُزْدَلِفَةِ  إِلَى  مِنًى  .","","Al-Mu'jam al-Kabir 11260","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11291","11261  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ (  ح  ) ،  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ ، يَقُولُ :  قَدَّمَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الضَّعَفَةِ أَوْ فِي  الثَّقَلِ  مِنْ  جَمْعٍ  بِلَيْلٍ  .","","Al-Mu'jam al-Kabir 11261","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن حماد بن زيد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11292","11262  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ بْنِ خُنَيْسٍ الْمَكِّيُّ ،  ثَنَا  الْحَسَنُ بْنُ مُحَمَّدِ بْنِ عُبَيْدِ اللهِ بْنِ أَبِي يَزِيدَ ، قَالَ :  قَالَ لِي  ابْنُ جُرَيْجٍ ،  حَدَّثَنِي  جَدُّكَ عُبَيْدُ اللهِ بْنُ أَبِي يَزِيدَ ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، يَقُولُ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي رَأَيْتُنِي فِي هَذِهِ اللَّيْلَةِ فِيمَا يَرَى النَّائِمُ ، كَأَنِّي أُصَلِّي عِنْدَ شَجَرَةٍ ، وَكَأَنِّي قَرَأْتُ سُورَةَ السَّجْدَةِ ، فَسَجَدْتُ فَرَأَيْتُ الشَّجَرَةَ كَأَنَّهَا سَجَدَتْ بِسُجُودِي ، وَكَأَنِّي أَسْمَعُهَا وَهِيَ تَقُولُ :  اللَّهُمَّ اكْتُبْ لِي بِهَا عِنْدَكَ أَجْرًا وَضَعْ عَنِّي بِهَا وِزْرًا ، وَاجْعَلْهَا لِي عِنْدَكَ ذُخْرًا  ، وَتَقَبَّلْ مِنِّي كَمَا تَقَبَّلْتَ مِنْ عَبْدِكَ  دَاوُدَ  ، قَالَ  ابْنُ عَبَّاسٍ  : "" فَقَرَأَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ السَّجْدَةَ فَسَمِعْتُهُ يَقُولُ فِي سُجُودِهِ كَمَا أَخْبَرَهُ الرَّجُلُ عَنْ قَوْلِ الشَّجَرَةِ  .","","Al-Mu'jam al-Kabir 11262","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن ابن جريج عن الحسن بن محمد بن عبيد الله المقرئ عن محمد بن يزيد المخزومي عن نصر بن علي بن نصر الجهضمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عبيد الله بن أبي يزيد عن ابن عباس"
"11293","[11/130]      أَبُو الْمِنْهَالِ  ، عَنِ  ابْنِ عَبَّاسٍ  .  11263  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ كَثِيرٍ ،  عَنْ  أَبِي الْمِنْهَالِ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَدِمَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْمَدِينَةَ  وَهُمْ يُسْلِفُونَ فِي  الثَّمَرِ  السَّنَةَ وَالسَّنَتَيْنِ وَالثَّلَاثَ ، فَقَالَ :  مَنْ أَسْلَفَ فَلْيُسْلِفْ فِي كَيْلٍ مَعْلُومٍ وَوَزْنٍ مَعْلُومٍ إِلَى أَجَلٍ مَعْلُومٍ  .","","Al-Mu'jam al-Kabir 11263","","عبد الله بن عباس عن عبد الرحمن بن مطعم العنزي عن عبد الله بن كثير بن عبد الله الداري عن عبد الله بن أبي نجيح عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو المنهال عن ابن عباس"
"11294","11264  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ كَثِيرٍ ،  عَنْ  أَبِي الْمِنْهَالِ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَدِمَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْمَدِينَةَ  وَهُمْ يُسْلِفُونَ فِي  الثَّمَرِ  السَّنَتَيْنِ وَالثَّلَاثَ ، فَقَالَ :  مَنْ أَسْلَفَ فَلْيُسْلِفْ فِي كَيْلٍ مَعْلُومٍ وَوَزْنٍ مَعْلُومٍ إِلَى أَجَلٍ مَعْلُومٍ  .","","Al-Mu'jam al-Kabir 11264","","عبد الله بن عباس عن عبد الرحمن بن مطعم العنزي عن عبد الله بن كثير بن عبد الله الداري عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن عبد الله بن مسلمة القعنبي عن أبو مسلم الكجي عن الطبراني","أبو المنهال عن ابن عباس"
"11295","11265  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وُهَيْبٍ الْغَزِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ كَثِيرٍ ،  عَنْ  أَبِي الْمِنْهَالِ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Al-Mu'jam al-Kabir 11265","","عبد الله بن عباس عن عبد الرحمن بن مطعم العنزي عن عبد الله بن كثير بن عبد الله الداري عن عبد الله بن أبي نجيح عن معمر بن راشد عن معتمر بن سليمان عن محمد بن المتوكل بن ابى السرى عن عبد الله بن وهيب الجذامي عن الطبراني","أبو المنهال عن ابن عباس"
"11296","11266  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ الْعَيْشِي  (  ح  ) ،         [11/131]      وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ، قَالَا :  ثَنَا  مُسْلِمُ بْنُ خَالِدٍ الزَّنْجِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  أَبِي الْمِنْهَالِ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  ذُكِرَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّ يَهُودَ يَصُومُونَ يَوْمَ عَاشُورَاءَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ عِشْنَا خَالَفْنَاهُمْ وَصُمْنَا الْيَوْمَ التَّاسِعَ  .  تصحفت في طبعة مكتبة ابن تيمية إلى : ( العيش ) وهي على الصواب في المخطوط .","","Al-Mu'jam al-Kabir 11266","","عبد الله بن عباس عن عبد الرحمن بن مطعم العنزي عن إسماعيل بن أمية الأموي عن مسلم بن خالد الزنجي عن عبد الرحمن بن المبارك الخلقاني عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","أبو المنهال عن ابن عباس"
"11297","عُمَرُ بْنُ عَطَاءِ بْنِ أَبِي الْخُوَارِ  عَنِ  ابْنِ عَبَّاسٍ  .  11267  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  عُمَرُ بْنُ عَطَاءِ بْنِ أَبِي الْخُوَارِ ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ :  بَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَأْكُلُ  عَرْقًا  أَتَاهُ الْمُؤَذِّنُ فَوَضَعَهُ ، ثُمَّ قَامَ إِلَى الصَّلَاةِ ، وَلَمْ يَمَسَّ مَاءً  .","","Al-Mu'jam al-Kabir 11267","","عبد الله بن عباس عن عمر بن عطاء بن أبي الخوار العامري عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عمر بن عطاء بن أبي الخوار عن ابن عباس"
"11298","حُمَيْدٌ الضَّمْرِيُّ  عَنِ  ابْنِ عَبَّاسٍ  .  11268  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  حُمَيْدٍ الضَّمْرِيِّ ،  أَنَّهُ سَأَلَ  ابْنَ عَبَّاسٍ ، فَقَالَ : إِنِّي أُسَافِرُ فَأَقْصُرُ الصَّلَاةَ فِي السَّفَرِ ؟  فَقَالَ  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا : لَيْسَ بِقَصْرٍ ، وَلَكِنَّهُ تَمَامُهَا وَسُنَّةُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ آمِنًا لَا يَخَافُ إِلَّا اللهَ فَصَلَّى اثْنَتَيْنِ حَتَّى رَجَعَ  .","","Al-Mu'jam al-Kabir 11268","","عبد الله بن عباس عن حميد الطويل عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","حميد الضمري عن ابن عباس"
"11299","[11/132]      11269  -  أَبُو نَجِيحٍ  عَنِ  ابْنِ عَبَّاسٍ  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو زُرْعَةَ ، قَالَا :  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  زُفَرُ بْنُ الْهُذَيْلِ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  مَا قَاتَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَوْمًا قَطُّ حَتَّى يَدْعُوَهُمْ  .","","Al-Mu'jam al-Kabir 11269","","عبد الله بن عباس عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن أبي نجيح عن زفر بن الهذيل الكوفي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو نجيح عن ابن عباس"
"11300","11270  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مَا قَاتَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَوْمًا قَطُّ إِلَّا دَعَاهُمْ  .","","Al-Mu'jam al-Kabir 11270","","عبد الله بن عباس عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن أبي نجيح عن سفيان الثوري عن محمد بن كثير العبدي عن أحمد بن داود بن موسى السدوسي عن الطبراني","أبو نجيح عن ابن عباس"
"11301","11271  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  ثَنَا  حَجَّاجُ بْنُ أَرْطَاةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مَا قَاتَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَوْمًا قَطُّ حَتَّى يَدْعُوَهُمْ  .","","Al-Mu'jam al-Kabir 11271","","عبد الله بن عباس عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن أبي نجيح عن حجاج بن أرطاة عن حفص بن غياث النخعي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو نجيح عن ابن عباس"
"11302","عِكْرِمَةُ بْنُ خَالِدٍ  ، عَنِ  ابْنِ عَبَّاسٍ  .  11272  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  عِكْرِمَةَ بْنِ خَالِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كُنْتُ فِي بَيْتِ خَالَتِي  مَيْمُونَةَ  "" فَقَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي مِنَ اللَّيْلِ ، فَقُمْتُ عَنْ يَسَارِهِ ، فَأَخَذَ بِيَدِي فَجَعَلَنِي عَنْ يَمِينِهِ  ، ثُمَّ صَلَّى ثَلَاثَ عَشْرَةَ رَكْعَةً قَدْرَ         {      يَا أَيُّهَا الْمُزَّمِّلُ         }      .","","Al-Mu'jam al-Kabir 11272","","عبد الله بن عباس عن عكرمة بن خالد بن العاص عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عكرمة بن خالد عن ابن عباس"
"11303","[11/133]      مَيْمُونٌ الْمَكِّيُّ  عَنِ  ابْنِ عَبَّاسٍ  11273  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  مُوسَى بْنُ دَاوُدَ الضَّبِّيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي هُبَيْرَةَ ، أَنَّ مَيْمُونً الْمَكِّيَّ ،  أَخْبَرَهُ  ،  أَنَّهُ رَأَى  ابْنَ الزُّبَيْرِ  صَلَّى بِالنَّاسِ  يُشِيرُ  بِكَفَّيْهِ إِذَا قَامَ فِي الصَّلَاةِ ، إِذَا قَامَ وَإِذَا رَكَعَ  ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ، وَإِذَا نَهَضَ "" فَانْطَلَقْتُ إِلَى  ابْنِ عَبَّاسٍ ،  فَقُلْتُ : إِنِّي رَأَيْتُ  ابْنَ الزُّبَيْرِ  يُصَلِّي صَلَاةً لَمْ أَرَ أَحَدًا يُصَلِّيهَا ، وَوَصَفْتُ لَهُ هَذِهِ الْإِشَارَةَ ، فَقَالَ ابْنُ عَبَّاسٍ :  إِنْ أَرَدْتَ أَنْ تَنْظُرَ إِلَى صَلَاةِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَاقْتَدِ بِصَلَاةِ  ابْنِ الزُّبَيْرِ  .","","Al-Mu'jam al-Kabir 11273","","عبد الله بن عباس عن ميمون المكي عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن موسى بن داود الخلقاني عن بشر بن موسى بن صالح الأسدي عن الطبراني","ميمون المكي عن ابن عباس"
"11304","سَعِيدٌ الْعَلَّافُ  ، عَنِ  ابْنِ عَبَّاسٍ  .  11274  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ ،  ثَنَا  مُسْلِمُ بْنُ خَالِدٍ الزَّنْجِيُّ ،  حَدَّثَنِي  سَعِيدٌ هُوَ الْعَلَّافُ ،  عَنِ         [11/134]      ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ عَزَّ وَجَلَّ  تَجَاوَزَ  لِأُمَّتِي عَنِ الخَطَأِ  وَالنِّسْيَانِ وَمَا اسْتُكْرِهُوا عَلَيْهِ  .","","Al-Mu'jam al-Kabir 11274","","عبد الله بن عباس عن سعيد العلاف عن مسلم بن خالد الزنجي عن معلى بن مهدي الموصلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سعيد العلاف عن ابن عباس"
"11305","طَلْقُ بْنُ حَبِيبٍ  عَنِ  ابْنِ عَبَّاسٍ  11275  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ  ، ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  ثَنَا  حُمَيْدٌ الطَّوِيلُ ،  عَنْ  طَلْقِ بْنِ حَبِيبٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَرْبَعٌ مَنْ أُعْطِيَهُنَّ أُعْطِيَ خَيْرَ الدُّنْيَا وَالْآخِرَةِ  : قَلْبًا شَاكِرًا ، وَلِسَانًا ذَاكِرًا ، وَبَدَنًا عَلَى الْبَلَاءِ صَابِرًا ، وَزَوْجَةً لَا تَبْغِيهِ خَوْنًا فِي نَفْسِهَا وَلَا مَالِهِ  .","","Al-Mu'jam al-Kabir 11275","","عبد الله بن عباس عن طلق بن حبيب العنزي عن حميد الطويل عن حماد بن سلمة عن مؤمل بن إسماعيل العدوي عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","طلق بن حبيب عن ابن عباس"
"11306","رَبَاحٌ أَبُو سَعِيدٍ الْمَكِّيُّ  عَنِ  ابْنِ عَبَّاسٍ  11276  -  حَدَّثَنَا  مَسْعُودُ بْنُ مُحَمَّدٍ الرَّمْلِيُّ أَبُو الْجَارُودِ  ، ثَنَا  عِمْرَانُ بْنُ هَارُونَ الرَّمْلِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  بَكْرُ بْنُ عَمْرٍو ،  عَنْ  رَبَاحٍ أَبِي سَعِيدٍ الْمَكِّيِّ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَرَهُ أَنْ يَقْرَأَ فِي صَلَاةِ الصُّبْحِ بِـاللَّيْلِ إِذَا يَغْشَى ،         {      وَالشَّمْسِ وَضُحَاهَا         }      .","","Al-Mu'jam al-Kabir 11276","","عبد الله بن عباس عن رباح المكي عن بكر بن عمرو المعافري عن عبد الله بن لهيعة عن الصوفي عمران بن أبى عمران عن مسعود بن محمد الرملي أبو الجارود عن الطبراني","رباح أبو سعيد المكي عن ابن عباس"
"11307","[11/135]      طَلْحَةُ بْنُ نَافِعٍ  عَنِ  ابْنِ عَبَّاسٍ  11277  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سِمَاعَةَ الرَّمْلِيُّ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْبَلْخِيُّ ، قَالَا :  ثَنَا  أَيُّوبُ بْنُ سُوَيْدٍ الرَّمْلِيُّ ،  ثَنَا  عُتْبَةُ بْنُ أَبِي حَكِيمٍ ،  عَنْ  أَبِي سُفْيَانَ طَلْحَةَ بْنِ نَافِعٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَبَّاسٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعَدَ  الْعَبَّاسَ  ذَوْدًا مِنْ إِبِلٍ فَبَعَثَنِي إِلَيْهِ فَبِتُّ عِنْدَهُ ، وَكَانَتْ لَيْلَةَ  مَيْمُونَةَ بِنْتِ الْحَارِثِ  ، فَقَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ غَيْرَ كَثِيرٍ ، فَتَوَسَّدْتُ الْوِسَادَةَ الَّتِي تَوَسَّدَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" فَتَوَضَّأَ فَأَسْبَغَ الْوُضُوءَ ، وَأَقَلَّ هَرَاقَةَ الْمَاءِ  ، ثُمَّ قَامَ فَافْتَتَحَ الصَّلَاةَ ، وَقُمْتُ فَتَوَضَّأْتُ وَقُمْتُ عَنْ يَسَارِهِ ، فَأَخْلَفَ بِيَدِهِ ، فَأَخَذَ بِأُذُنِي فَأَقَامَنِي عَنْ يَمِينِهِ "" وَكَانَتْ  مَيْمُونَةُ  حَائِضًا فَقَامَتْ فَتَوَضَّأَتْ ، ثُمَّ قَعَدَتْ خَلْفَهُ تَذْكُرُ اللهَ  .","","Al-Mu'jam al-Kabir 11277","","عبد الله بن عباس عن طلحة بن نافع العراقي عن عتبة بن أبي حكيم عن أيوب بن سويد الحميري عن محمد بن أبى إبراهيم حمدويه عن محمد بن جابان الجند يسابوري عن الطبراني","طلحة بن نافع عن ابن عباس"
"11308","يُوسُفُ بْنُ مَاهَكَ  عَنِ  ابْنِ عَبَّاسٍ  11278  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  الْحَارِثُ بْنُ عُبَيْدٍ الْإِيَادِيُّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْأَخْنَسِ ،         [11/136]      عَنِ  الْوَلِيدِ بْنِ عَبْدِ اللهِ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ تَعَلَّمَ عِلْمًا مِنَ النُّجُومِ تَعَلَّمَ شُعْبَةً مِنَ السِّحْرِ  ، مَنْ زَادَ زَادَ ، مَنْ زَادَ زَادَ  .","","Al-Mu'jam al-Kabir 11278","","عبد الله بن عباس عن يوسف بن ماهك الفارسي عن الوليد بن عبد الله بن أبي مغيث العبدري عن عبيد الله بن الأخنس النخعي عن الحارث بن عبيد الإيادي عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","يوسف بن ماهك عن ابن عباس"
"11309","أَبُو الزُّبَيْرِ  عَنِ  ابْنِ عَبَّاسٍ  11279  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْبَرْبَهَارِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سَابِقٍ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَرَّبَ  نِسَاءَهُ  لَيْلَةَ  جَمْعٍ  قَبْلَ الزِّحَامِ  .","","Al-Mu'jam al-Kabir 11279","","عبد الله بن عباس عن أبو الزبير المكي عن إبراهيم بن طهمان عن محمد بن سابق التميمي عن أحمد بن على بن الحسن البربهاري عن الطبراني","أبو الزبير عن ابن عباس"
"11310","11280  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ أَبَا الزُّبَيْرِ  أَخْبَرَهُ  أَنَّ  عَبْدَ اللهِ بْنَ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُقَدِّمُ الْعِيَالَ وَالضَّعَفَةَ إِلَى  مِنًى  مِنَ  الْمُزْدَلِفَةِ  .","","Al-Mu'jam al-Kabir 11280","","عبد الله بن عباس عن أبو الزبير المكي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أبو الزبير عن ابن عباس"
"11311","11281  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ أَبَا الزُّبَيْرِ ،  أَخْبَرَهُ  ،  أَنَّ  عَبْدَ اللهِ بْنَ الْعَبَّاسِ كَانَ يَقُولُ :  مَا الْإِنَاخَةُ  بِالْمُحَصَّبِ  شَيْئًا  ، إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  إِنَّمَا انْتَظَرَ بِهِ  عَائِشَةَ  حَتَّى تَأْتِيَ  "" .","","Al-Mu'jam al-Kabir 11281","","عبد الله بن عباس عن أبو الزبير المكي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أبو الزبير عن ابن عباس"
"11312","[11/137]      11282  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ أَبِي خِدَاشٍ ،  أَنَّ  ابْنَ عَبَّاسٍ ، قَالَ :  لَمَّا أَشْرَفَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمَقْبَرَةِ وَهُوَ عَلَى طَرِيقِهَا الْأَوَّلِ أَشَارَ بِيَدِهِ وَرَاءَ  الضَّفِيرَةِ  أَوِ الظَّهِيرَةِ  ، فَقَالَ : "" نِعْمَ الْمَقْبَرَةُ هَذِهِ "" قُلْتُ لِلَّذِي يُخْبِرُنِي : خَصَّ الشِّعْبَ ؟ قَالَ :  هَكَذَا كُنَّا نَسْمَعُ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" خَصَّ الشِّعْبَ الْمُقَابِلَ  بِالْبَيْتِ  .","","Al-Mu'jam al-Kabir 11282","","عبد الله بن عباس عن إبراهيم بن أبي خداش اللهبي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو الزبير عن ابن عباس"
"11313","عَمْرُو بْنُ كَيْسَانَ  عَنِ  ابْنِ عَبَّاسٍ  11283  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَمْرِو بْنِ كَيْسَانَ ، قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ،  يَقْرَأُ دَارَسْتُ تَلَوْتُ ، خَاصَمْتُ جَادَلْتُ  "" .","","Al-Mu'jam al-Kabir 11283","","عبد الله بن عباس عن عمرو بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عمرو بن كيسان عن ابن عباس"
"11314","الْقَاسِمُ بْنُ أَبِي بَزَّةَ  وَعَبْدُ اللهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ  عَنِ  ابْنِ عَبَّاسٍ  11284  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  سُرَيْجُ بْنُ النُّعْمَانِ ،  ثَنَا  هُذَيْلُ بْنُ بِلَالٍ ، قَالَ :  سَمِعْتُ  الْقَاسِمَ بْنَ أَبِي بَزَّةَ ، وَعَبْدَ اللهِ بْنَ عُبَيْدِ بْنِ عُمَيْرٍ ،  يُحَدِّثَانِ عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ  أَعْرَابِيًّا  أَتَاهُ ، فَاسْتَسْقَاهُ فَسُقِيَ نَبِيذًا ، فَقَالَ : مَا  شَأْنُ  إِخْوَانِكُمْ يَسْقُونَ الْعَسَلَ         [11/138]      وَاللَّبَنَ ، وَتَسْقُونَ أَنْتُمُ النَّبِيذَ ؟ فَقَالَ : أَمَا إِنَّهُ لَيْسَ بِنَا بُخْلٌ ، وَلَكِنِ  اسْتَسْقَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَقَيْنَاهُ نَبِيذًا  ، فَقَالَ : أَحْسَنْتُمْ وَأَجْمَلْتُمْ ، هَكَذَا فَافْعَلُوا  .","","Al-Mu'jam al-Kabir 11284","","عبد الله بن عباس عن عبد الله بن عبيد بن عمير الجندعي عن الهذيل بن بلال الفزاري عن سريج بن النعمان الجوهري عن لحية الليف محمد بن العباس عن الطبراني","القاسم بن أبي بزة وعبد الله بن عبيد بن عمير عن ابن عباس"
"11315","عَطَاءٌ  عَنِ  ابْنِ عَبَّاسٍ  11285  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَكَرِيَّا الْعَابِدِيُّ الْمَكِّيُّ  ، ثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ الْمَخْزُومِيُّ ،  ثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" قَدَّمَهُ مِنْ  مُزْدَلِفَةَ  فِي ضَعَفَةِ أَهْلِهِ  "" .","","Al-Mu'jam al-Kabir 11285","","عبد الله بن عباس عن عطاء بن أبي رباح عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن بشر بن السري عن سعيد بن عبد الرحمن بن حسان المخزومي عن أحمد بن زكريا العابدي عن الطبراني","عطاء عن ابن عباس"
"11316","11286  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عُقْبَةُ بْنُ قَبِيصَةَ ،  ثَنَا  أَبِي  ،  ثَنَا  فِطْرٌ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Al-Mu'jam al-Kabir 11286","","عبد الله بن عباس عن عطاء بن أبي رباح عن فطر بن خليفة عن قبيصة بن عقبة السوائي عن عقبة بن قبيصة بن عقبة العامري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11317","11287  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  خَلَّادُ بْنُ يَحْيَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَدَّمَ ضَعَفَةَ أَهْلِهِ مِنْ  جَمْعٍ  بِلَيْلٍ  "" .","","Al-Mu'jam al-Kabir 11287","","عبد الله بن عباس عن عطاء بن أبي رباح عن إسماعيل بن عبد الملك بن أبي الصفير الأسدي عن خلاد بن يحيى الأرحبي عن بشر بن موسى بن صالح الأسدي عن الطبراني","عطاء عن ابن عباس"
"11318","[11/139]      11288  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  إِنَّمَا فَعَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِيُرِيَ الْمُشْرِكِينَ قُوَّتَهُ  ، فَمَنْ شَاءَ فَعَلَهُ ، وَمَنْ شَاءَ تَرَكَهُ  .  يَعْنِي الرَّمَلَ  .","","Al-Mu'jam al-Kabir 11288","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن موسى بن أعين الجزري عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عطاء عن ابن عباس"
"11319","11289  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  الْوَلِيدُ بْنُ مُسَبِّحٍ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَبَّى حَتَّى رَمَى جَمْرَةَ الْعَقَبَةِ  .","","Al-Mu'jam al-Kabir 11289","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن الوضاح بن عبد الله اليشكري عن الوليد بن مسيح عن يوسف بن يزيد القراطيسي عن الطبراني","عطاء عن ابن عباس"
"11320","11290  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  سُوَيْدٌ أَبُو حَاتِمٍ ،  ثَنَا  عَبْدُ الْمَلِكِ ، رَاوِيَةُ عَطَاءٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَنَا  الزَّعِيمُ  بِبَيْتٍ فِي رِبَاضِ الْجَنَّةِ ، وَبِبَيْتٍ فِي أَعْلَاهَا  ، وَبِبَيْتٍ فِي أَسْفَلِهَا لِمَنْ تَرَكَ  الْجَدَلَ  وَهُوَ مُحِقٌ ، وَتَرَكَ الْكَذِبَ وَهُوَ  لَاعِبٌ  وَحَسَّنَ  خُلُقَهُ  لِلنَّاسِ  .","","Al-Mu'jam al-Kabir 11290","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن سويد بن إبراهيم الجحدري عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد الجواليقي عن الطبراني","عطاء عن ابن عباس"
"11321","11291  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  بِتُّ فِي بَيْتِ         [11/140]      خَالَتِي  مَيْمُونَةَ  "" ،  فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ اللَّيْلِ ، فَأَطْلَقَ الْقِرْبَةَ فَتَوَضَّأَ ، ثُمَّ قَامَ إِلَى الصَّلَاةِ  ، فَقُمْتُ فَتَوَضَّأْتُ ، فَقُمْتُ عَنْ يَسَارِهِ ، فَأَخَذَنِي بِيَمِينِهِ ، فَأَدَارَنِي مِنْ وَرَائِهِ وَأَقَامَنِي عَنْ يَمِينِهِ فَصَلَّيْتُ مَعَهُ  .","","Al-Mu'jam al-Kabir 11291","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عطاء عن ابن عباس"
"11322","11292  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَفَاضَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  عَرَفَةَ  وَرِدْفُهُ  أُسَامَةُ بْنُ زَيْدٍ  ،  فَجَالَتْ  بِهِ النَّاقَةُ وَهُوَ رَافِعٌ يَدَيْهِ لَا يُجَاوِزَانِ رَأْسَهُ ، ثُمَّ سَارَ عَلَى هَيْئَتِهِ إِلَى  جَمْعٍ  وَرِدْفُهُ  الْفَضْلُ ،  فَمَا زَالَ يُلَبِّي حَتَّى رَمَى الْجَمْرَةَ  "" .","","Al-Mu'jam al-Kabir 11292","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عطاء عن ابن عباس"
"11323","11293  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَمُوسَى بْنُ هَارُونَ ، قَالَا :  ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  مَنْصُورُ بْنُ أَبِي الْأَسْوَدِ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" طَافَ لِحَجَّتِهِ وَعُمْرَتِهِ طَوَافًا وَاحِدًا  .","","Al-Mu'jam al-Kabir 11293","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن منصور بن أبي الأسود الليثي عن داود بن عمرو المسيبي عن موسى بن هارون الحمال عن الطبراني","عطاء عن ابن عباس"
"11324","11294  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ بُخَيْتٍ ،  ثَنَا  سَعِيدُ بْنُ مَسْلَمَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَنَّهُ  كَانَ  يَتَفَاءَلُ  وَلَا يَتَطَيَّرُ  ، وَكَانَ يُحِبُّ الِاسْمَ الْحَسَنَ  .","","Al-Mu'jam al-Kabir 11294","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن ليث بن أبي سليم عن سعيد بن مسلمة الأموي عن عبد الله بن بخيت عن الساجي عن الطبراني","عطاء عن ابن عباس"
"11325","[11/141]      11295  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، وَالْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ، قَالُوا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْوَلِيدِ الْوَصَّافِيِّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ أَهْلِ بَيْتٍ وَاصَلُوا إِلَّا أَجْرَى اللهُ عَلَيْهِمُ الرِّزْقَ ، وَكَانُوا فِي  كَنَفِ  اللهِ عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 11295","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبيد الله بن الوليد الوصافي عن سفيان الثوري عن إسماعيل بن عياش الأحول عن هشام بن عمار عن الحسن بن علي بن شبيب المعمري عن الطبراني","عطاء عن ابن عباس"
"11326","11295  / 2  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَمُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ ، قَالَا :  ثَنَا  ابْنُ الْأَصْبَهَانِيِّ (  ح  ) ،  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ، قَالَا :  ثَنَا  يَحْيَى بْنُ يَمَانٍ ،  عَنِ  الْمِنْهَالِ بْنِ خَلِيفَةَ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْرًا لَيْلًا وَأَسْرَجَ لَهُ فِيهِ سِرَاجًا ، فَأَخَذَهُ مِنْ قِبَلِ الْقِبْلَةِ ، وَكَبَّرَ عَلَيْهِ أَرْبَعًا ، وَقَالَ :  رَحِمَكَ اللهُ إِنْ كُنْتَ لَأَوَّاهًا تَلَّاءً لِلْقُرْآنِ  .","","Al-Mu'jam al-Kabir 11295","","عبد الله بن عباس عن حجاج بن أرطاة عن المنهال بن خليفة العجلي عن يحيى بن يمان العجلي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عطاء عن ابن عباس"
"11327","11296  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ الْكُوفِيُّ ،  ثَنَا         [11/142]      إِسْمَاعِيلُ بْنُ الْخَلِيلِ الْخَزَّازُ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَطَاءٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  مِنَ السُّنَّةِ أَنْ لَا تَخْرُجَ يَوْمَ الْفِطْرِ حَتَّى تُخْرِجَ الصَّدَقَةَ  ، وَتَطْعَمَ شَيْئًا قَبْلَ أَنْ تَخْرُجَ  "" .","","Al-Mu'jam al-Kabir 11296","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن علي بن مسهر القرشي عن إسماعيل بن الخليل عن الحسين بن جعفر القتات عن الطبراني","عطاء عن ابن عباس"
"11328","11297  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبَّادٍ الْخَطَّابِيُّ  ، ثَنَا  أَبُو الْجَوْزَاءِ أَحْمَدُ بْنُ عُثْمَانَ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  حَجَّاجٍ النَّخَعِيِّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  تَزَوَّجَ  مَيْمُونَةَ  وَهُوَ مُحْرِمٌ  .","","Al-Mu'jam al-Kabir 11297","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن شعبة بن الحجاج عن أبو داود الطيالسي عن أحمد بن عثمان بن أبي عثمان أبو الجوزاء النوفلي عن القاسم بن عباد الخطابى عن الطبراني","عطاء عن ابن عباس"
"11329","11298  -  حَدَّثَنَا  حُمَيْدُ بْنُ أَبِي مَخْلَدٍ الْوَاسِطِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ الْجَرْجَرَائِيُّ ،  ثَنَا  مَعْمَرُ بْنُ سُلَيْمَانَ الرَّقِّيُّ ،  عَنْ  حَجَّاجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا نِكَاحَ إِلَّا بِوَلِيٍّ ، وَالسُّلْطَانُ وَلِيُّ مَنْ لَا وَلِيَّ لَهُ  .","","Al-Mu'jam al-Kabir 11298","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن معمر بن سليمان النخعي عن محمد بن الصباح الجرجرائي عن حميد بن أحمد بن عبد الله بن أبي مخلد الواسطي عن الطبراني","عطاء عن ابن عباس"
"11330","11299  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو مُعَاوِيَةَ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ، كِلَاهُمَا  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عُمْرَةٌ فِي رَمَضَانَ تَعْدِلُ حَجَّةً  زَادَ  أَبُو مُعَاوِيَةَ  فِي حَدِيثِهِ : مَعِيَ  .","","Al-Mu'jam al-Kabir 11299","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن علي بن مسهر القرشي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عطاء عن ابن عباس"
"11331","[11/143]      11300  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ  ، ثَنَا  عُمَرُ بْنُ شَبَّةَ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  عُثْمَانُ بْنُ طُلَيْقٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَصْبَحَ صَائِمًا ؟ "" قَالَ  أَبُو بَكْرٍ  : أَنَا ، قَالَ : "" مَنْ عَادَ مَرِيضًا ؟  قَالَ  أَبُو بَكْرٍ  : أَنَا ، قَالَ : "" مَنْ شَيَّعَ جِنَازَةً ؟ "" قَالَ  أَبُو بَكْرٍ  : أَنَا ، قَالَ : "" مَنْ جَمَعَهُنَّ فِي يَوْمٍ دَخَلَ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 11300","","عبد الله بن عباس عن عطاء بن أبي رباح عن الأعمش عن عثمان بن طليق عن موسى بن إسماعيل التبوذكي عن عمر بن شبة عن سعيد بن عبد الرحمن التستري عن الطبراني","عطاء عن ابن عباس"
"11332","11301  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْبَيْتَ  فَكَبَّرَ فِي نَوَاحِيهِ  ، وَدَعَا ثُمَّ خَرَجَ فَصَلَّى خَلْفَ  الْمَقَامِ  .","","Al-Mu'jam al-Kabir 11301","","عبد الله بن عباس عن عطاء بن أبي رباح عن ليث بن أبي سليم عن عبد الوارث بن سعيد بن ذكوان عن عبيد الله بن عمر القواريري عن عبد الله بن أحمد بن حنبل عن الطبراني","عطاء عن ابن عباس"
"11333","11302  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  هَنَّادُ بْنُ السَّرِيِّ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَرَادَ أَحَدُكُمْ أَنْ يُعْطِيَ أَخَاهُ أَرْضَهُ ،  فَلْيَمْنَحْهَا  إِيَّاهُ أَوْ لِيُزْرِعْهَا إِيَّاهُ  وَلَا يُعْطِيهِ بِالثُّلُثِ وَالرُّبُعِ  .","","Al-Mu'jam al-Kabir 11302","","عبد الله بن عباس عن عطاء بن أبي رباح عن ليث بن أبي سليم عن أبو معاوية الضرير عن هناد بن السري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عطاء عن ابن عباس"
"11334","11303  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  تَزَوَّجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَيْمُونَةَ  وَهُوَ مُحْرِمٌ  .","","Al-Mu'jam al-Kabir 11303","","عبد الله بن عباس عن عطاء بن أبي رباح عن ليث بن أبي سليم عن محمد بن فضيل بن غزوان عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عطاء عن ابن عباس"
"11335","[11/144]      11304  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  مُعَلَّى الْجُعْفِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ، وَعَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  شَكَا  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْعُزُوبَةَ ، فَقَالَ : أَلَا أَخْتَصِي ؟ فَقَالَ : "" لَا ،  لَيْسَ مِنَّا مَنْ خَصَى أَوِ اخْتَصَى  ، وَلَكِنْ صُمْ وَوَفِّرْ شَعَرَ جَسَدِكَ  .","","Al-Mu'jam al-Kabir 11304","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن معلى بن هلال بن سويد الطحان عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","عطاء عن ابن عباس"
"11336","11305  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ آدَمَ الْمِصِّيصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُيَسَّرٍ أَبُو سَعْدٍ الصَّاغَانِيُّ ،  عَنْ  أَبِي جَعْفَرٍ الرَّازِيِّ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  رُبَّمَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يُصَلِّي وَالْحُمُرُ تَعْتَرِكُ بَيْنَ يَدَيْهِ  .","","Al-Mu'jam al-Kabir 11305","","عبد الله بن عباس عن عطاء بن أبي رباح عن ليث بن أبي سليم عن عيسى بن أبي عيسى الرازي عن محمد بن ميسر الصاغاني عن محمد بن آدم الجهني عن أحمد بن النضر بن بحر العسكري عن الطبراني","عطاء عن ابن عباس"
"11337","11306  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قُمْتُ عَنْ يَسَارِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فَأَخَذَ بِيَدِي فَأَقَامَنِي عَنْ يَمِينِهِ ، وَمَسَحَ عَلَى رَأْسِي  .","","Al-Mu'jam al-Kabir 11306","","عبد الله بن عباس عن عطاء بن أبي رباح عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن علي بن حكيم بن ذبيان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11338","11307  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْبَرَاءِ  ، ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  رُخِّصَ  لِأَهْلِ السِّقَايَةِ  ،  وَأَهْلِ الْحِجَابَةِ ،  أَنْ يَبِيتُوا  بِمَكَّةَ  لَيَالِيَ  مِنًى  .  يَعْنِي  آلَ شَيْبَةَ  وَآلَ الْعَبَّاسِ  .","","Al-Mu'jam al-Kabir 11307","","عبد الله بن عباس عن عطاء بن أبي رباح عن ليث بن أبي سليم عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن محمد بن أحمد بن البراء العبدي عن الطبراني","عطاء عن ابن عباس"
"11339","11308  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عِصْمَةُ بْنُ سُلَيْمَانَ         [11/145]      الْخَزَّازُ ،  ثَنَا  شَرِيكٌ ،  عَنْ  جَابِرٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  أُتِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِلَبَنٍ  يَوْمَ عَرَفَةَ  فَشَرِبَهُ ، وَسَقَى الَّذِي عَنْ يَمِينِهِ  .","","Al-Mu'jam al-Kabir 11308","","عبد الله بن عباس عن عطاء بن أبي رباح عن جابر الجعفي عن شريك بن عبد الله النخعي عن عصمة بن سليمان الخزاز عن أبو مسلم الكجي عن الطبراني","عطاء عن ابن عباس"
"11340","11309  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  أَبُو غَسَّانَ ،  ثَنَا  صَبَّاحٌ أَبُو عَبْدِ اللهِ الْفَرَّاءُ ،  عَنْ  جَابِرٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَعَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ النَّائِحَةَ وَالْمُسْتَمِعَةَ وَقَالَ :  لَيْسَ لِلنِّسَاءِ فِي الْجِنَازَةِ نَصِيبٌ  .","","Al-Mu'jam al-Kabir 11309","","عبد الله بن عباس عن عطاء بن أبي رباح عن جابر الجعفي عن الصباح الفراء عن مالك بن إسماعيل النهدي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11341","11310  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ سَعِيدِ بْنِ الْمُسَيِّبِ بْنِ شَرِيكٍ ،  ثَنَا  أَبُو النَّضْرِ الْأَكْفَانِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  جَابِرٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سُئِلَ عَنْ عِلْمٍ فَكَتَمَهُ جَاءَ يَوْمَ الْقِيَامَةِ مُلْجَمًا بِلِجَامٍ مِنْ نَارٍ  .","","Al-Mu'jam al-Kabir 11310","","عبد الله بن عباس عن عطاء بن أبي رباح عن جابر الجعفي عن سفيان الثوري عن الحارث بن النعمان بن سالم الأكفاني عن القاسم بن سعيد بن المسيب التميمي عن محمود بن محمد بن منويه المفيد عن الطبراني","عطاء عن ابن عباس"
"11342","11311  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ شَقِيقٍ ، قَالَ :  سَمِعْتُ  أَبِي  ،  ثَنَا  أَبُو حَمْزَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  الْمُتْعَةُ  فِي  الْحَجِّ  سُنَّةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 11311","","عبد الله بن عباس عن عطاء بن أبي رباح عن جابر الجعفي عن محمد بن ميمون أبو حمزة السكري عن علي بن الحسن بن شقيق عن محمد بن علي بن الحسن بن شقيق المطوعي عن محمد بن جابان الجند يسابوري عن الطبراني","عطاء عن ابن عباس"
"11343","11312  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ         [11/146]      بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  أَبُو حَفْصٍ عُمَرُ بْنُ حَفْصِ بْنِ يَزِيدَ الْقُرَظِيُّ ،  عَنْ  عَمْرِو بْنِ شِمْرٍ ،  عَنْ  جَابِرِ بْنِ يَزِيدَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بُغْضُ  بَنِي هَاشِمٍ  وَالْأَنْصَارِ  كُفْرٌ ، وَبُغْضُ الْعَرَبِ نِفَاقٌ  "" .","","Al-Mu'jam al-Kabir 11312","","عبد الله بن عباس عن عطاء بن أبي رباح عن جابر الجعفي عن عمرو بن شمر الجعفي عن عمر بن حفص بن عمر القرظ عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","عطاء عن ابن عباس"
"11344","11313  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  السُّدِّيِّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  قَوْلُهُ :         {      أَمْ يَحْسُدُونَ النَّاسَ عَلَى مَا آتَاهُمُ اللهُ مِنْ فَضْلِهِ         }      قَالَ  ابْنُ عَبَّاسٍ  :  نَحْنُ النَّاسَ دُونَ النَّاسِ  "" .","","Al-Mu'jam al-Kabir 11313","","عبد الله بن عباس عن عطاء بن أبي رباح عن السدي الكبير عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11345","11314  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  حَدَّثَنِي  أَبِي ،  عَنِ  ابْنِ أَبِي لَيْلَى  ، عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْحَجَرُ الْأَسْوَدُ مِنْ حِجَارَةِ الْجَنَّةِ ، وَمَا فِي الْأَرْضِ مِنَ الْجَنَّةِ غَيْرُهُ  ، وَكَانَ أَبْيَضَ كَالْمَهَا ، وَلَوْلَا مَا مَسَّهُ مِنْ رِجْسِ الْجَاهِلِيَّةِ مَا مَسَّهُ ذُو عَاهَةٍ إِلَّا بَرَأَ  .","","Al-Mu'jam al-Kabir 11314","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11346","11315  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  ثَنَا  أَبِي ،  عَنِ  ابْنِ أَبِي لَيْلَى  ، عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا  يُعْضَدُ  شَوْكُ  الْحَرَمِ  ، وَلَا يُقْتَلُ صَيْدُهُ  ، وَلَا يُخْتَلَى خَلَاهُ ، وَلَا يَحِلُّ لُقَطَتُهُ إِلَّا  لِمُنْشِدٍ  .","","Al-Mu'jam al-Kabir 11315","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11347","11316  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي ،         [11/147]      قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  ،  ثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَنَتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي صَلَاةِ الْفَجْرِ دَعَا عَلَى قَوْمٍ ، وَدَعَا لِقَوْمٍ  .","","Al-Mu'jam al-Kabir 11316","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","عطاء عن ابن عباس"
"11348","11317  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ وَهَبَ هِبَةً فَهُوَ أَحَقُّ بِهِبَتِهِ مَا لَمْ يُثَبْ مِنْهَا  ، فَإِنْ رَجَعَ فِي هِبَتِهِ فَهُوَ كَالَّذِي يَقِيءُ وَيَأْكُلُ فِيهِ  .","","Al-Mu'jam al-Kabir 11317","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن أبي شيبة العبسي عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","عطاء عن ابن عباس"
"11349","11318  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي ، قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  جَلَبَ  فِي الْإِسْلَامِ  .","","Al-Mu'jam al-Kabir 11318","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن أبي شيبة العبسي عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","عطاء عن ابن عباس"
"11350","11319  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  خَالِدٌ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  مَا زَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَمْسَحُ عَلَى الْخُفَّيْنِ حَتَّى قَبَضَهُ اللهُ  .","","Al-Mu'jam al-Kabir 11319","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن خالد بن عبد الله الطحان عن إسماعيل بن عمرو البجلي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عطاء عن ابن عباس"
"11351","[11/148]      11320  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  حَفْصُ بْنُ أَبِي دَاوُدَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ مُحْرِمٌ ، فَغُشِيَ عَلَيْهِ  ، فَنَهَى النَّاسَ يَوْمَئِذٍ أَنْ يَحْتَجِمَ الصَّائِمُ كَرَاهِيَةَ الضَّعْفِ  .","","Al-Mu'jam al-Kabir 11320","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن حفيص الأسدي عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","عطاء عن ابن عباس"
"11352","11321  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  سَعِيدُ بْنُ يَحْيَى بنِ  الْأَزْهَرِ الْوَاسِطِيُّ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  شَرِيكٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  سُئِلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمَنِيِّ يُصِيبُ الثَّوْبَ قَالَ :  إِنَّمَا هُوَ بِمَنْزِلَةِ الْبُزَاقِ أَوِ الْمُخَاطِ ، أَمِطْهُ عَنْهُ بِخِرْقَةٍ أَوْ بِإِذْخَرٍ  .  سقط من طبعة مكتبة ابن تيمية ، وهو على الصواب في النسخة الخطية .  في طبعة مكتبة ابن تيمية : ( ذخر ) والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 11321","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن سعيد بن يحيى بن الأزهر الواسطي عن الحسين بن إسحاق التستري عن الطبراني","عطاء عن ابن عباس"
"11353","11322  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  حَدَّثَنِي  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  جَاءَتْ  أُمُّ سُلَيْمٍ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : يَا رَسُولَ اللهِ ، إِنَّ  أَبَا طَلْحَةَ  وَابْنَهُ حَجَّا عَلَى  نَاضِحِهِمَا  وَتَرَكَانِي ، فَقَالَ :  يَا  أُمَّ سُلَيْمٍ ،  إِنَّ عُمْرَةً فِي رَمَضَانَ تُجْزِئُ مِنْ حَجَّةٍ  .","","Al-Mu'jam al-Kabir 11322","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11354","[11/149]      11323  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  حَدَّثَنِي  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ، كِلَاهُمَا  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ أَبِي شَيْخٌ كَبِيرٌ لَمْ يَحُجَّ ، أَفَأَحُجُّ عَنْهُ ؟ قَالَ :  أَرَأَيْتَ لَوْ كَانَ عَلَى أَبِيكَ دَيْنٌ كُنْتَ قَاضِيَهُ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" فَحُجَّ عَنْهُ  .","","Al-Mu'jam al-Kabir 11323","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11355","11324  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  حَدَّثَنِي  أَبِي ،  عَنِ  ابْنِ أَبِي لَيْلَى  ، عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" لَبَّى فِي الْعُمْرَةِ حَتَّى  اسْتَلَمَ  الْحَجَرَ  ، وَلَبَّى فِي  الْحَجِّ  حَتَّى رَمَى  حَجَرَةَ الْعَقَبَةِ  يَوْمَ النَّحْرِ  .","","Al-Mu'jam al-Kabir 11324","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11356","11325  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  تَمِيمُ بْنُ الْمُنْتَصِرِ ،  ثَنَا  إِسْحَاقُ الْأَزْرَقُ ،  عَنْ  شَرِيكٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  خَرَجَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْمَدِينَةِ  إِلَى  مَكَّةَ  حِينَ افْتَتَحَهَا ، وَذَلِكَ فِي رَمَضَانَ ، وَهُوَ صَائِمٌ فَصَامَ حَتَّى أَتَى  قُدَيْدًا  ، فَبَلَغَهُ أَنَّ النَّاسَ قَدْ أَصَابَهُمْ عَطَشٌ ،  وَجَهْدٌ  ، فَدَعَا بِمَاءٍ فَشَرِبَ وَأَفْطَرَ ،  فَمَنْ شَاءَ صَامَ وَمَنْ شَاءَ أَفْطَرَ  .","","Al-Mu'jam al-Kabir 11325","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن تميم بن المنتصر مولى ابن عباس عن محمود بن محمد بن منويه المفيد عن الطبراني","عطاء عن ابن عباس"
"11357","11326  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ (  ح  )         [11/150]      وَحَدَّثَنَا  الْحَسَنُ بْنُ عَلَوَيْهِ الْقَطَّانُ  ، ثَنَا  يَزِيدُ بْنُ مَرْوَانَ الْخَلَّالُ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يَجْمَعُ بَيْنَ الصَّلَاتَيْنِ فِي السَّفَرِ : الظُّهْرِ  وَالْعَصْرِ ، وَالْمَغْرِبِ وَالْعِشَاءِ  .","","Al-Mu'jam al-Kabir 11326","","عبد الله بن عباس عن عطاء بن أبي رباح عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن يزيد بن مروان الخلال عن ابن علويه الحسن بن علي القطان عن الطبراني","عطاء عن ابن عباس"
"11358","11327  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  ثَنَا  عِمْرَانُ بْنُ عُيَيْنَةَ عُقْبَةُ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ :  عَنِ الْغُلَامِ  عَقِيقَتَانِ  ، وَعَنِ الْجَارِيَةِ  عَقِيقَةٌ  .","","Al-Mu'jam al-Kabir 11327","","عبد الله بن عباس عن عطاء بن أبي رباح عن يزيد بن أبي زياد القرشي عن عمران بن عيينة الهلالي عن عبد الله بن عمر مشكدانة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11359","11328  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ عُثْمَانَ الْأَوْدِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ شَرِيكٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عِكْرِمَةَ ، وَعَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ :         {      ثُمَّ دَنَا فَتَدَلَّى         }      ، قَالَ :  هُوَ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، دَنَا  فَتَدَلَّى  إِلَى رَبِّهِ عَزَّ وَجَلَّ  ""  .","","Al-Mu'jam al-Kabir 11328","","عبد الله بن عباس عن عطاء بن أبي ميمونة البصرى عن عطاء بن السائب عن شريك بن عبد الله النخعي عن عبد الرحمن بن شريك بن عبد الله النخعي عن أحمد بن عثمان بن حكيم عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11360","11329  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" يُضَحِّي بِكَبْشَيْنِ  أَمْلَحَيْنِ  ، يَضَعُ رِجْلَهُ عَلَى صِفَاحِهِمَا إِذَا أَرَادَ أَنْ يَذْبَحَ ، وَيَقُولُ : "" بِاسْمِ اللهِ مِنْكَ وَلَكَ ، اللَّهُمَّ تَقَبَّلْ مِنْ  مُحَمَّدٍ  .","","Al-Mu'jam al-Kabir 11329","","عبد الله بن عباس عن عطاء بن السائب عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عطاء عن ابن عباس"
"11361","[11/151]      11330  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْبُورَانِيُّ ، قَاضِي الْحَدِيثَةِ ، وَالْحَدِيثَةُ مِنْ دِيَارِ رَبِيعَةَ ،  ثَنَا  الْحُسَيْنُ بْنُ عَلِيٍّ الصُّدَائِيُّ ،  ثَنَا  الْحَكَمُ بْنُ الْجَارُودِ ،  ثَنَا  ابْنُ أَبِي الْمَتِيدِ خَالُ ابْنِ عُيَيْنَةِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَنْظَرَ مُعْسِرًا إِلَى مَيْسَرَتِهِ أَنْظَرَهُ اللهُ بِذَنْبِهِ إِلَى تَوْبَتِهِ  .","","Al-Mu'jam al-Kabir 11330","","عبد الله بن عباس عن عطاء بن أبي رباح عن أبو يوسف بن أبى المتئد عن يوسف بن أبى المتئد عن الحكم بن الجارود عن الحسين بن علي الصدائي عن أحمد بن محمد البوراني عن الطبراني","عطاء عن ابن عباس"
"11362","11331  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ بْنِ سَوْرَةَ الْبَغْدَادِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُونُسَ بْنِ بُكَيْرٍ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عُبَيْدِ اللهِ الْعَرْزَمِيُّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  طَعَامٌ فِي  الْعُرْسِ  يَوْمٌ سُنَّةٌ  ، وَطَعَامُ يَوْمَيْنِ فَضْلٌ ، وَطَعَامُ ثَلَاثَةِ أَيَّامٍ رِيَاءٌ وَسُمْعَةٌ  .","","Al-Mu'jam al-Kabir 11331","","عبد الله بن عباس عن عطاء بن أبي رباح عن محمد بن عبيد الله بن أبي سليمان العرزمي عن يونس بن بكير عن عبد الله بن يونس بن بكير الكوفي عن محمد بن يعقوب بن سورة البغدادي عن الطبراني","عطاء عن ابن عباس"
"11363","11332  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  سَلَّامٌ الطَّوِيلُ ،  عَنِ  الْفَضْلِ بْنِ عَطِيَّةَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَعْتَرِي  الْحِدَّةُ  خِيَارَ أُمَّتِي  .","","Al-Mu'jam al-Kabir 11332","","عبد الله بن عباس عن عطاء بن أبي رباح عن الفضل بن عطية المروزي عن سلام بن سلم الطويل عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","عطاء عن ابن عباس"
"11364","[11/152]      11333  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ بْنِ مَرْوَانَ الْوَاسِطِيُّ  ، ثَنَا  عُمَرُ بْنُ صَالِحِ بْنِ خَيْرَةَ ،  ثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ بْنِ عَطِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبَضَ عَلَى الذَّهَبِ وَالْحَرِيرِ وَهُوَ يُحَرِّكُهُ وَيَقُولُ :  هَذَا يَحْرُمُ عَلَى الذُّكُورِ مِنْ أُمَّتِي  .","","Al-Mu'jam al-Kabir 11333","","عبد الله بن عباس عن عطاء بن أبي رباح عن الفضل بن عطية المروزي عن محمد بن الفضل بن عطية العبسي عن عمر بن صالح الواسطي عن إبراهيم بن أحمد بن مروان الواسطي عن الطبراني","عطاء عن ابن عباس"
"11365","11334  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ بْنِ مَرْوَانَ الْوَاسِطِيُّ  ، ثَنَا  عُمَرُ بْنُ صَالِحِ بْنِ خَيْرَةَ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ ،  عَنْ  كُرْزٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ  يُصَلِّي مُحْتَبِيًا مُحَلِّلَ الْأَزْرَارِ  .","","Al-Mu'jam al-Kabir 11334","","عبد الله بن عباس عن عطاء بن أبي رباح عن كرز بن وبرة الحارثي عن محمد بن الفضل بن عطية العبسي عن عمر بن صالح الواسطي عن إبراهيم بن أحمد بن مروان الواسطي عن الطبراني","عطاء عن ابن عباس"
"11366","11335  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  ثَنَا  أَبُو يَحْيَى الْحِمَّانِيُّ ،  عَنْ  يُوسُفَ بْنِ مَيْمُونٍ ،  عَنْ  كُرْزٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمَّا فَتَحَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَكَّةَ  قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ وَرَسُولَهُ حَرَّمَ عَلَيْكُمُ الْخَمْرَ وَثَمَنَهَا  ، وَحَرَّمَ عَلَيْكُمُ الْمَيْتَةَ وَثَمَنَهَا ، وَحَرَّمَ عَلَيْكُمُ الْخَنَازِيرَ وَأَكْلَهَا وَثَمَنَهَا "" . وَقَالَ : "" قُصُّوا الشَّوَارِبَ ، وَأَعْفُوا اللِّحَى ، وَلَا تَمْشُوا فِي الْأَسْوَاقِ إِلَّا وَعَلَيْكُمُ الْأُزُرُ ، إِنَّهُ لَيْسَ مِنَّا مَنْ عَمِلَ بِسُنَّةِ غَيْرِنَا  .","","Al-Mu'jam al-Kabir 11335","","عبد الله بن عباس عن عطاء بن أبي رباح عن كرز بن وبرة الحارثي عن يوسف بن ميمون الصباغ عن عبد الحميد بن عبد الرحمن بشمين عن الحسن بن حماد الوراق عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11367","[11/153]      11336  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  ثَنَا  أَبُو يَحْيَى الْحِمَّانِيُّ ،  عَنْ  يُوسُفَ بْنِ مَيْمُونٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  عُمَرَ  وَمَعَهُ نَاسٌ مِنْ أَصْحَابِهِ ، فَقَالَ : "" أَمُؤْمِنُونَ أَنْتُمْ ؟ "" فَسَكَتُوا ثَلَاثَ مَرَّاتٍ ، فَقَالَ  عُمَرُ  فِي آخِرِهِنَّ : نَعَمْ يَا رَسُولَ اللهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" وَمِمَّ ذَاكَ ؟ "" فَقَالَ  عُمَرُ  : نَرْجُو ثَوَابًا مِنَ اللهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مُؤْمِنُونَ وَرَبِّ الْكَعْبَةِ  .","","Al-Mu'jam al-Kabir 11336","","عبد الله بن عباس عن عطاء بن أبي رباح عن يوسف بن ميمون الصباغ عن عبد الحميد بن عبد الرحمن بشمين عن الحسن بن حماد الوراق عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11368","11337  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  طَلْحَةُ بْنُ عَمْرٍو ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَا أَيُّهَا النَّاسُ تَدَاوَوْا  ، فَإِنَّ اللهَ عَزَّ وَجَلَّ لَمْ يَخْلُقْ دَاءً إِلَّا خَلَقَ لَهُ شِفَاءً إِلَّا  السَّامَ  ، ""  وَالسَّامُ : الْمَوْتُ  ""  .","","Al-Mu'jam al-Kabir 11337","","عبد الله بن عباس عن عطاء بن أبي رباح عن طلحة بن عمرو الحضرمي عن عبد الله بن وهب المصري عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","عطاء عن ابن عباس"
"11369","11338  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ الْجَرْجَرَائِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ الْمَكِّيُّ ،  عَنْ  طَلْحَةَ بْنِ عَمْرٍو ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نِعْمَ  الْإِدَامُ  الْخَلُّ  .","","Al-Mu'jam al-Kabir 11338","","عبد الله بن عباس عن عطاء بن أبي رباح عن طلحة بن عمرو الحضرمي عن عبد الله بن رجاء البصري عن محمد بن الصباح الجرجرائي عن بحشل عن الطبراني","عطاء عن ابن عباس"
"11370","11339  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبُو الْوَلِيدِ وَمُحَمَّدُ بْنُ كَثِيرٍ ، قَالَا :  ثَنَا  هَمَّامٌ ، قَالَ :  سَمِعْتُ  عَطَاءً يَقُولُ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :         [11/154]      دَخَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْكَعْبَةَ  وَفِيهَا سِتَّةُ  سَوَارٍ  ، "" فَقَامَ عِنْدَ كُلِّ سَارِيَةٍ  فَدَعَا وَلَمْ يُصَلِّ  .","","Al-Mu'jam al-Kabir 11339","","عبد الله بن عباس عن عطاء بن أبي رباح عن همام بن يحيى بن دينار عن محمد بن كثير العبدي عن معاذ بن المثنى العنبري عن الطبراني","عطاء عن ابن عباس"
"11371","11340  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  أَبُو الْوَلِيدِ ، وَعَمْرُو بْنُ مَرْزُوقٍ ، قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنْ  أَيُّوبَ ، قَالَ :  سَمِعْتُ  عَطَاءً يَقُولُ : أَشْهَدُ عَلَى  ابْنِ عَبَّاسٍ  ،  وَقَالَ  ابْنُ عَبَّاسٍ :  أَشْهَدُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ خَرَجَ يَوْمَ فِطْرٍ ، فَصَلَّى رَكْعَتَيْنِ  ، ثُمَّ أَتَى النِّسَاءَ وَمَعَهُ  بِلَالٌ  "" فَأَمَرَهُنَّ بِالصَّدَقَةِ فَجَعَلْنَ يُلْقِينَ  .","","Al-Mu'jam al-Kabir 11340","","عبد الله بن عباس عن عطاء بن أبي رباح عن أيوب السختياني عن شعبة بن الحجاج عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء عن ابن عباس"
"11372","11341  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  أَسْوَدُ بْنُ عَامِرٍ ،  ثَنَا  أَيُّوبُ بْنُ عُتْبَةَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ  الْغَرَرِ  .","","Al-Mu'jam al-Kabir 11341","","عبد الله بن عباس عن عطاء بن أبي رباح عن يحيى بن أبي كثير عن أيوب بن عتبة اليمامي عن الأسود بن عامر شاذان عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11373","11342  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  أَسْوَدُ بْنُ عَامِرٍ ،  عَنْ  أَيُّوبَ بْنِ عُتْبَةَ ،  عَنْ  عِكْرِمَةَ وَعَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  تَزَوَّجَ  مَيْمُونَةَ  وَهُوَ مُحْرِمٌ  .","","Al-Mu'jam al-Kabir 11342","","عبد الله بن عباس عن عطاء بن أبي رباح عن أيوب بن عتبة اليمامي عن الأسود بن عامر شاذان عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عطاء عن ابن عباس"
"11374","[11/155]      11343  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ ،  ثَنَا  الرَّبِيعُ بْنُ بَدْرٍ ،  ثَنَا  النَّهَّاسُ بْنُ قَهْمٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَكُونُ نِكَاحٌ إِلَّا بِوَلِيٍّ  ، وَشَاهِدَيْنِ ، وَمَهْرٍ مَا كَانَ قَلَّ أَمْ كَثُرَ  .","","Al-Mu'jam al-Kabir 11343","","عبد الله بن عباس عن عطاء بن أبي رباح عن النهاس بن قهم القيسي عن الربيع بن بدر عليلة عن عبد الرحمن بن المبارك الخلقاني عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","عطاء عن ابن عباس"
"11375","11344  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ ، صَاحِبُ الْبَصْرِيِّ ،  ثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  عَنْ  مَالِكِ بْنِ دِينَارٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِإِسْبَاغِ الْوُضُوءِ  .","","Al-Mu'jam al-Kabir 11344","","عبد الله بن عباس عن عطاء بن أبي رباح عن مالك بن دينار الناجي عن جعفر بن سليمان الضبعي عن سليمان بن أيوب بن سليمان عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","عطاء عن ابن عباس"
"11376","11345  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَيُّوبَ ، وَقَيْسِ بْنِ سَعْدٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَخَّرَ صَلَاةَ الْعِشَاءِ الْأَخِيرَةِ ذَاتَ لَيْلَةٍ حَتَّى نَامَ  الْقَوْمُ  وَاسْتَيْقَظُوا  ، ثُمَّ نَامُوا ثُمَّ اسْتَيْقَظُوا "" ، فَجَاءَ  عُمَرُ  ، فَقَالَ : يَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، الصَّلَاةَ ، فَصَلَّوْا فَلَمْ يَذْكُرْ أَنَّهُمْ  تَوَضَّأُوا  .","","Al-Mu'jam al-Kabir 11345","","عبد الله بن عباس عن عطاء بن أبي رباح عن قيس بن سعد الحبشي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","عطاء عن ابن عباس"
"11377","11346  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ ،  ثَنَا  ابْنُ عَائِشَةَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَيُّوبَ ، وَيُونُسَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِمِثْلِهِ .","","Al-Mu'jam al-Kabir 11346","","عبد الله بن عباس عن عطاء بن أبي رباح عن يونس بن عبيد عن حماد بن سلمة عن ابن عائشة عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","عطاء عن ابن عباس"
"11378","[11/156]      11347  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ قَالَ :  اللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ  مِلْءَ  السَّمَاوَاتِ وَمِلْءَ الْأَرْضِ  ، وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ  .","","Al-Mu'jam al-Kabir 11347","","عبد الله بن عباس عن عطاء بن أبي رباح عن قيس بن سعد الحبشي عن هشام بن حسان العتكي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عطاء عن ابن عباس"
"11379","11348  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ (  ح  ) ،  وَحَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ، قَالَا :  ثَنَا  مُعَاوِيَةُ بْنُ عَبْدِ الْكَرِيمِ الضَّالُّ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ، قَالَ :  سُئِلَ  عَطَاءٌ عَنِ الِاسْتِلَامِ ، فَقَالَ :  قَالَ  ابْنُ عَبَّاسٍ :  إِنَّمَا أُمِرْتُمْ أَنْ تَطُوفُوا  ، فَإِنْ تَيَسَّرَ  فَاسْتَلِمُوا  ""  .  الضَّالُّ كَانَ ضَلَّ بِطَرِيقِ  مَكَّةَ ،  فَمَاتَ مَفْقُودًا ، قَالَ : وَكَانَ  مَعْمَرُ بْنُ رَاشِدٍ  وَسَلْمُ بْنُ أَبِي الذَّيَّالِ  فُقِدَا ، فَلَمْ يُرَ لَهُمَا أَثَرٌ  .","","Al-Mu'jam al-Kabir 11348","","عبد الله بن عباس عن عطاء بن أبي رباح عن قيس بن سعد الحبشي عن الضال معاوية بن عبد الكريم عن محمد بن عبيد بن حساب الغبري عن الساجي عن الطبراني","عطاء عن ابن عباس"
"11380","11349  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ  ، ثَنَا  أَبُو عَاصِمٍ ،  ثَنَا  عَبَّادُ بْنُ مَنْصُورٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَمَرَ  بِلَالًا  فِي لَيْلَةِ رِيحٍ وَمَطَرٍ ، فَنَادَى أَنْ  صَلُّوا فِي  الرِّحَالِ  .","","Al-Mu'jam al-Kabir 11349","","عبد الله بن عباس عن عطاء بن أبي رباح عن عباد بن منصور الناجي عن أبو عاصم النبيل عن محمد بن يحيى بن المنذر القزاز عن الطبراني","عطاء عن ابن عباس"
"11381","11350  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَالِدٍ الْمِصِّيصِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ         [11/157]      عِيسَى الطَّبَّاعُ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  مَنْصُورِ بْنِ زَاذَانَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  سُئِلَ عَمَّنْ حَلَقَ قَبْلَ أَنْ يَذْبَحَ ، فَقَالَ : "" لَا حَرَجَ  .","","Al-Mu'jam al-Kabir 11350","","عبد الله بن عباس عن عطاء بن أبي رباح عن منصور بن زاذان الثقفي عن هشيم بن بشير عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","عطاء عن ابن عباس"
"11382","11351  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْوَاسِطِيُّ ،  ثَنَا  طَلْحَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَخَّصَ لِلْمُحْرِمِ فِي السَّرَاوِيلِ إِذَا لَمْ يَجِدْ إِزَارًا  ، وَفِي الْخُفَّيْنِ إِذَا لَمْ يَجِدِ النَّعْلَيْنِ  .","","Al-Mu'jam al-Kabir 11351","","عبد الله بن عباس عن عطاء بن أبي رباح عن قتادة بن دعامة عن طلحة بن عبد الرحمن القناد عن الحسن بن علي بن راشد الواسطي عن عبد الله بن أحمد الجواليقي عن الطبراني","عطاء عن ابن عباس"
"11383","11352  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عِمْرَانَ أَبِي بَكْرٍ ،  حَدَّثَنِي  عَطَاءُ بْنُ أَبِي رَبَاحٍ ، قَالَ :  قَالَ لِي  ابْنُ عَبَّاسٍ :  أَلَا أُرِيكَ امْرَأَةً مِنْ أَهْلِ الْجَنَّةِ ؟ قُلْتُ : بَلَى ، قَالَ : هَذِهِ  الْمَرْأَةُ  السَّوْدَاءُ أَتَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَتْ : يَا رَسُولَ اللهِ ، إِنِّي أُصْرَعُ ، وَإِنِّي أَنَكْشِفُ فَادْعُ اللهَ لِي ، فَقَالَ :  إِنْ شِئْتِ صَبَرْتِ وَلَكِ الْجَنَّةُ ، وَإِنْ شِئْتِ دَعَوْتُ اللهَ أَنْ يُعَافِيَكِ  فَقَالَتْ : أَصْبِرُ . فَقَالَتْ : إِنِّي أَنَكْشِفُ فَادْعُ اللهَ أَنْ لَا أَنَكْشِفَ ، فَدَعَا لَهَا  .","","Al-Mu'jam al-Kabir 11352","","عبد الله بن عباس عن عطاء بن أبي رباح عن عمران بن مسلم القصير عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عطاء عن ابن عباس"
"11384","11353  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالُوا :  ثَنَا  يَزِيدُ بْنُ إِبْرَاهِيمَ التُّسْتَرِيُّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ         [11/158]      اللهُ عَنْهُمَا ، قَالَ :  كُنْتُ فِيمَنْ تَعَجَّلَ فِي  ثَقَلِ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لَيْلَةَ  جَمْعٍ  .","","Al-Mu'jam al-Kabir 11353","","عبد الله بن عباس عن عطاء بن أبي رباح عن يزيد بن إبراهيم التستري عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","عطاء عن ابن عباس"
"11385","11354  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  الرَّبِيعُ بْنُ صُبَيْحٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَدَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ضَعَفَةَ أَهْلِهِ  لَيْلَةَ الْمُزْدَلِفَةِ  وَأَمَرَهُمْ أَنْ لَا يَرْمُوا الْجَمْرَةَ حَتَّى تَطْلُعَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 11354","","عبد الله بن عباس عن عطاء بن أبي رباح عن الربيع بن صبيح عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","عطاء عن ابن عباس"
"11386","11355  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي نُعَيْمٍ الْوَاسِطِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  كَثِيرِ بْنِ شِنْظِيرٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  إِنَّمَا كَانَ بَدْءُ الْإِيضَاعِ مِنْ قِبَلِ أَهْلِ الْبَادِيَةِ ، كَانُوا يَقِفُونَ حَافَتَيِ النَّاسِ وَقَدْ تَعَلَّقُوا الْقِسِيَّ وَالْجِعَابَ ، فَإِذَا نَفَرُوا  تَقَعْقَعَتْ  ، لَقَدْ رُئِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَأَنَّ ذِفْرَيْ نَاقَتِهِ لَتَمَسُّ حَارِكَهَا ، وَهُوَ يَقُولُ :  يَا أَيُّهَا النَّاسُ عَلَيْكُمْ  بِالسَّكِينَةِ  ، يَا أَيُّهَا النَّاسُ عَلَيْكُمْ  بِالسَّكِينَةِ  .","","Al-Mu'jam al-Kabir 11355","","عبد الله بن عباس عن عطاء بن أبي رباح عن كثير بن شنظير المازني عن حماد بن زيد عن محمد بن موسى بن أبي نعيم الهذلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء عن ابن عباس"
"11387","11356  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ (  ح  ) ،  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَمُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْأَحْمَرُ النَّاقِدُ الْبَصْرِيُّ  ، ثَنَا  طَالُوتُ بْنُ عَبَّادٍ ، قَالُوا :  ثَنَا  الْحَارِثُ بْنُ عُبَيْدٍ ،  عَنْ  عَامِرٍ الْأَحْوَلِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ         [11/159]      عَبَّاسٍ ، قَالَ :  كَانَ إِيلَاءُ أَهْلِ الْجَاهِلِيَّةِ السَّنَةَ وَالسَّنَتَيْنِ  ، ثُمَّ  وَقَّتَ  اللهُ الْإِيلَاءَ ، فَمَنْ كَانَ إِيلَاؤُهُ دُونَ أَرْبَعَةِ أَشْهُرٍ فَلَيْسَ بِإِيلَاءٍ ""  ""  وَاللَّفْظُ لِحَدِيثِ  سَعِيدِ بْنِ مَنْصُورٍ  "" .","","Al-Mu'jam al-Kabir 11356","","عبد الله بن عباس عن عطاء بن أبي رباح عن عامر بن عبد الواحد الأحول عن الحارث بن عبيد الإيادي عن طالوت بن عباد الجحدري عن غلام طالوت محمد بن علي بن الحسن عن الطبراني","عطاء عن ابن عباس"
"11388","11357  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الْعَبْدِيُّ ،  ثَنَا  دَاوُدُ بْنُ أَبِي الْفُرَاتِ (  ح  ) ،  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  إِبْرَاهِيمُ الصَّائِغُ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  صَلَّى نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالنَّاسِ يَوْمَ فِطْرٍ رَكْعَتَيْنِ بِغَيْرِ أَذَانٍ وَلَا إِقَامَةٍ  ، ثُمَّ خَطَبَ بَعْدَ الصَّلَاةِ ، ثُمَّ أَخَذَ بِيَدِ  بِلَالٍ  فَانْطَلَقَ إِلَى النِّسَاءِ فَخَطَبَهُنَّ ، ثُمَّ أَمَرَ  بِلَالًا  بَعْدَمَا قَفَا مِنْ عِنْدِهِنَّ أَنْ يَأْتِيَهُنَّ فَيَأْمُرَهُنَّ أَنْ يَتَصَدَّقْنَ  .","","Al-Mu'jam al-Kabir 11357","","عبد الله بن عباس عن عطاء بن أبي رباح عن إبراهيم بن ميمون الصائغ عن حسان بن إبراهيم الكرماني عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","عطاء عن ابن عباس"
"11389","11358  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْعَبَّاسِ النَّسَائِيُّ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  عَوْنُ بْنُ مَعْمَرٍ ،  عَنْ  إِبْرَاهِيمَ الصَّائِغِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  انْتَظَرُوا الصَّلَاةَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَسْجِدِ ، فَرَقَدُوا ، ثُمَّ اسْتَيْقَظْنَا ثَلَاثَ مَرَّاتٍ ، فَخَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَصَلَّى الْعِشَاءَ وَقَالَ :  لَوْلَا أَنْ أَشُقَّ عَلَى النَّاسِ لَأَمَرْتُهُمْ أَنْ يُؤَخِّرُوا هَذِهِ الصَّلَاةَ إِلَى هَذِهِ السَّاعَةِ  فَنَظَرْنَا فَإِذَا هُوَ  شَطْرُ  اللَّيْلِ  .","","Al-Mu'jam al-Kabir 11358","","عبد الله بن عباس عن عطاء بن أبي رباح عن إبراهيم بن ميمون الصائغ عن عون بن معمر البجلي عن عبيد الله بن عمر القواريري عن محمد بن على بن العباس النسائي عن الطبراني","عطاء عن ابن عباس"
"11390","11359  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  مُحَمَّدُ         [11/160]      بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي الشَّوَارِبِ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  عَنْ  إِبْرَاهِيمَ الصَّائِغِ ،  حَدَّثَنِي  عَطَاءٌ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَا  بَنِي عَبْدِ مَنَافٍ  ، إِنْ وُلِّيتُمْ هَذَا الْأَمْرَ بَعْدِي  فَلَا تَمْنَعُنَّ أَحَدًا طَافَ بِهَذَا  الْبَيْتِ ،  أَوْ صَلَّى أَيَّةَ سَاعَةٍ شَاءَ مِنْ لَيْلٍ أَوْ نَهَارٍ  .","","Al-Mu'jam al-Kabir 11359","","عبد الله بن عباس عن عطاء بن أبي رباح عن إبراهيم بن ميمون الصائغ عن حسان بن إبراهيم الكرماني عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن عبد الله بن أحمد بن حنبل عن الطبراني","عطاء عن ابن عباس"
"11391","11360  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  دَاوُدُ بْنُ عَمْرٍو الضَّبِّيُّ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَبْدِ الْمَجِيدِ ،  عَنْ  حُسَيْنٍ الْمُعَلِّمِ ،  عَنْ  عَطَاءٍ ،  حَدَّثَنِي  ابْنُ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ "" يَبْعَثُ  بِالثَّقَلِ  سَحَرًا  . وَكُنْتُ فِيمَنْ بُعِثَ ،  يَعْنِي مِنَ  الْمُزْدَلِفَةِ  .","","Al-Mu'jam al-Kabir 11360","","عبد الله بن عباس عن عطاء بن أبي رباح عن حسين المعلم عن عبد الوهاب بن عبد المجيد الثقفي عن داود بن عمرو المسيبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عطاء عن ابن عباس"
"11392","11361  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  نَافِعٌ أَبُو هُرْمُزَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا أُخْبِرُكُمْ بِأَفْضَلِ الْمَلَائِكَةِ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ  ، وَأَفْضَلِ النَّبِيِّينَ  آدَمُ  ، وَأَفْضَلِ النِّسَاءِ  مَرْيَمُ بِنْتُ عِمْرَانَ  .","","Al-Mu'jam al-Kabir 11361","","عبد الله بن عباس عن عطاء بن أبي رباح عن نافع بن هرمز البصري عن شيبان بن فروخ الحبطي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عطاء عن ابن عباس"
"11393","11362  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  نَافِعٌ أَبُو هُرْمُزَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ "" يُكَبِّرُ عَلَى  أَهْلِ بَدْرٍ  سَبْعَ تَكْبِيرَاتٍ  ، وَعَلَى  بَنِي هَاشِمٍ  خَمْسَ         [11/161]      تَكْبِيرَاتٍ ، ثُمَّ كَانَ آخِرُ صَلَاتِهِ أَرْبَعَ تَكْبِيرَاتٍ حَتَّى خَرَجَ مِنَ الدُّنْيَا  .","","Al-Mu'jam al-Kabir 11362","","عبد الله بن عباس عن عطاء بن أبي رباح عن نافع بن هرمز البصري عن شيبان بن فروخ الحبطي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عطاء عن ابن عباس"
"11394","11363  -  حَدَّثَنَا  إِبْرَاهِيمُ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  نَافِعٌ أَبُو هُرْمُزَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يُوضَعُ فِي مِيزَانِهِ قِيرَاطَانِ كُلُّ قِيرَاطٍ مِثْلُ  أُحُدٍ  ،  يَعْنِي مَنْ تَبِعَ الْجِنَازَةَ  .","","Al-Mu'jam al-Kabir 11363","","عبد الله بن عباس عن عطاء بن أبي رباح عن نافع بن هرمز البصري عن شيبان بن فروخ الحبطي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عطاء عن ابن عباس"
"11395","11364  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ  ، ثَنَا  شَيْبَانُ ،  ثَنَا  نَافِعٌ أَبُو هُرْمُزَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ "" إِذَا اسْتَوَى النَّهَارُ خَرَجَ إِلَى بَعْضِ حِيطَانِ  الْمَدِينَةِ  وَقَدْ يُسِّرَ لَهُ فِيهَا طَهُورٌ ، فَإِنْ كَانَتْ لَهُ حَاجَةٌ قَضَاهَا وَإِلَّا تَطَهَّرَ ، فَإِذَا زَالَتِ الشَّمْسُ عَنْ كَبِدِ السَّمَاءِ قَدْرَ شِرَاكٍ ، قَامَ فَصَلَّى أَرْبَعَ رَكَعَاتٍ ، وَلَمْ يَتَشَهَّدْ بَيْنَهُنَّ وَسَلَّمَ فِي آخِرِ الْأَرْبَعِ ، ثُمَّ يَقُومُ فَيَأْتِي الْمَسْجِدَ "" ، فَقَالَ  ابْنُ عَبَّاسٍ  : يَا رَسُولَ اللهِ ، مَا هَذِهِ الصَّلَاةُ الَّتِي تُصَلِّيهَا ، وَلَا نُصَلِّيهَا ؟ قَالَ  ابْنُ عَبَّاسٍ  :  مِنْ صَلَّاهُنَّ مِنْ أُمَّتِي فَقَدْ أَحْيَى لَيْلَتَهُ سَاعَةً ، يُفْتَحُ فِيهَا أَبْوَابُ السَّمَاءِ  وَيُسْتَجَابُ فِيهَا الدُّعَاءُ  .","","Al-Mu'jam al-Kabir 11364","","عبد الله بن عباس عن عطاء بن أبي رباح عن نافع بن هرمز البصري عن شيبان بن فروخ الحبطي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عطاء عن ابن عباس"
"11396","11365  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ  ، ثَنَا  شَيْبَانُ ،  ثَنَا  نَافِعٌ أَبُو هُرْمُزَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  جَاءَ  الْعَبَّاسُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَاعَةً لَمْ يَأْتِيهِ فِيهَا ، فَقِيلَ : يَا رَسُولَ اللهِ هَذَا عَمُّكَ عَلَى الْبَابِ ، فَقَالَ : "" ائْذَنُوا لَهُ فَقَدْ جَاءَ لِأَمْرٍ "" فَلَمَّا         [11/162]      دَخَلَ عَلَيْهِ قَالَ : "" فَمَا جَاءَ بِكَ يَا عَمَّاهُ هَذِهِ السَّاعَةَ ، وَلَيْسَتْ سَاعَتَكَ الَّتِي كُنْتَ تَجِيءُ فِيهَا ؟ "" قَالَ : يَا ابْنَ أَخِي ، ذَكَرْتُ الْجَاهِلِيَّةَ وَجَهْلَهَا فَضَاقَتْ عَلَيَّ الدُّنْيَا بِمَا  رَحُبَتْ  ، فَقُلْتُ : مَنْ يُفَرِّجُ عَنِّي ؟ فَعَلِمْتُ أَنَّهُ لَا يُفَرِّجُ عَنِّي أَحَدٌ إِلَّا اللهُ ثُمَّ أَنْتَ ، فَقَالَ :  الْحَمْدُ لِلهِ الَّذِي أَوْقَعَ هَذَا فِي قَلْبِكَ ، وَوَدِدْتُ أَنَّ  أَبَا طَالِبٍ  أَخَذَ نَصِيبَهُ  ، وَلَكِنَّ اللهَ يَفْعَلُ مَا يَشَاءُ "" ، قَالَ : ""  أَحْبُوكَ  ؟ "" قَالَ : نَعَمْ ، قَالَ : أُعْطِيكَ ؟ قَالَ : نَعَمْ ، قَالَ : ""  أَحْبُوكَ  ؟ "" قَالَ : نَعَمْ ، قَالَ : "" فَإِذَا كَانَتْ سَاعَةٌ يُصَلَّى فِيهَا ، لَيْسَتْ بَعْدَ الْعَصْرِ وَلَا بَعْدَ طُلُوعِ الشَّمْسِ ، فَمَا بَيْنَ ذَلِكَ فَأَسْبِغْ طَهُورَكَ ثُمَّ قُمْ إِلَى اللهِ فَاقْرَأْ بِفَاتِحَةِ الْكِتَابِ وَسُورَةٍ إِنْ شِئْتَ جَعَلْتَهَا مِنْ أَوَّلِ الْمُفَصَّلِ ، فَإِذَا فَرَغْتَ مِنَ السُّورَةِ فَقُلْ : سُبْحَانَ اللهِ وَالْحَمْدُ لِلهِ وَلَا إِلَهَ إِلَّا اللهُ وَاللهُ أَكْبَرُ ، خَمْسَ عَشْرَةَ مَرَّةً ، فَإِذَا رَكَعْتَ فَقُلْ ذَلِكَ عَشْرًا ، فَإِذَا رَفَعْتَ رَأْسَكَ فَقُلْ ذَلِكَ عَشْرً مِرَارًا  .","","Al-Mu'jam al-Kabir 11365","","عبد الله بن عباس عن عطاء بن أبي رباح عن نافع بن هرمز البصري عن شيبان بن فروخ الحبطي عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عطاء عن ابن عباس"
"11397","11366  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدٍ الْحِنَّائِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  نَافِعٌ أَبُو هُرْمُزَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَحْتَجِمُ يَوْمَ الثُّلَاثَاءِ ، فَقُلْتُ :  هَذَا الْيَوْمَ تَحْتَجِمُ ؟ قَالَ : "" نَعَمْ ، وَمَنْ وَافَقَ مِنْكُمْ يَوْمَ الثُّلَاثَاءِ لَيْلَةَ سَبْعَ عَشْرَةَ مَضَتْ مِنَ  الشَّهْرِ  ، فَلَا يُجَاوِزُ حَتَّى يَحْتَجِمَ فَاحْتَجِمُوا  .","","Al-Mu'jam al-Kabir 11366","","عبد الله بن عباس عن عطاء بن أبي رباح عن نافع بن هرمز البصري عن شيبان بن فروخ الحبطي عن يحيى بن محمد بن البختري الحنائي عن الطبراني","عطاء عن ابن عباس"
"11398","11367  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدٍ الْحِنَّائِيُّ  ، ثَنَا  شَيْبَانُ بْنُ         [11/163]      فَرُّوخَ ،  ثَنَا  نَافِعٌ أَبُو هُرْمُزَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْلَةَ أُسْرِيَ بِي مَا مَرَرْتُ عَلَى مَلَأٍ مِنَ الْمَلَائِكَةِ إِلَّا أَمَرُونِي بِالْحِجَامَةِ  .","","Al-Mu'jam al-Kabir 11367","","عبد الله بن عباس عن عطاء بن أبي رباح عن نافع بن هرمز البصري عن شيبان بن فروخ الحبطي عن يحيى بن محمد بن البختري الحنائي عن الطبراني","عطاء عن ابن عباس"
"11399","11368  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدٍ الْحِنَّائِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  نَافِعٌ أَبُو هُرْمُزَ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ لِإِبْلِيسَ  مَرَدَةً  مِنَ الشَّيَاطِينِ يَقُولُ لَهُمْ : عَلَيْكُمْ بِالْحُجَّاجِ وَالْمُجَاهِدِينَ  ، فَأَضِلُّوهُمْ عَنِ السَّبِيلِ  .","","Al-Mu'jam al-Kabir 11368","","عبد الله بن عباس عن عطاء بن أبي رباح عن نافع بن هرمز البصري عن شيبان بن فروخ الحبطي عن يحيى بن محمد بن البختري الحنائي عن الطبراني","عطاء عن ابن عباس"
"11400","11369  -  حَدَّثَنَا  أَبُو عَبْدِ الْمَلِكِ أَحْمَدُ بْنُ إِبْرَاهِيمَ الْقُرَشِيُّ الدِّمَشْقِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  سَعْدَانُ بْنُ يَحْيَى ،  ثَنَا  نَافِعٌ ، مَوْلَى يُوسُفَ السُّلَمِيِّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مِفْتَاحُ الصَّلَاةِ الطُّهُورُ  ،  وَتَحْرِيمُهَا  التَّكْبِيرُ ،  وَتَحْلِيلُهَا  التَّسْلِيمُ  .","","Al-Mu'jam al-Kabir 11369","","عبد الله بن عباس عن عطاء بن أبي رباح عن نافع مولى يوسف السلمي عن سعيد بن يحيى سعدان عن سليمان بن عبد الرحمن التميمي عن أحمد بن إبراهيم بن محمد البسري عن الطبراني","عطاء عن ابن عباس"
