hadiths[158]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4290","«قاتل الله اليهود اتخذوا قبور أنبيائهم مساجد»","صحيح","Sahih al-Jami al-Saghir 4290","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4291","«قاتل الله اليهود إن الله عز وجل لما حرم عليهم الشحوم جملوها ثم باعوها فأكلوا أثمانها»","صحيح","Sahih al-Jami al-Saghir 4291","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4292","«قاتل الله قوما يصورون ما لا يخلقون»","صحيح","Sahih al-Jami al-Saghir 4292","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4293","«قاتل دون مالك حتى تحوز مالك أو تقتل فتكون من شهداء الآخرة»","صحيح","Sahih al-Jami al-Saghir 4293","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4294","«قاتل عمار وسالبه في النار»","صحيح","Sahih al-Jami al-Saghir 4294","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4295","«قاتلهم حتى يشهدوا أن لا إله إلا الله وأن محمدا رسول الله فإذا فعلوا ذلك فقد منعوا منك دماءهم وأموالهم إلا بحقها وحسابهم على الله»","صحيح","Sahih al-Jami al-Saghir 4295","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4296","«قاربوا وسددوا ففي كل ما يصاب به المسلم كفارة حتى النكبة ينكبها أو الشوكة يشاكها»","صحيح","Sahih al-Jami al-Saghir 4296","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4297","«قاربوا وسددوا وأبشروا واعلموا أنه لن ينجوأحد منكم بعمله ولا أنا إلا أن يتغمدني الله برحمة منه وفضل»","صحيح","Sahih al-Jami al-Saghir 4297","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4298","«قاضيان في النار وقاض في الجنة قاض عرف الحق فقضى به فهو في الجنة وقاض عرف الحق فجار متعمدا أو قضى بغير علم فهما في النار»","صحيح","Sahih al-Jami al-Saghir 4298","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4299","«قاطع السدر يصوب الله رأسه في النار»","صحيح","Sahih al-Jami al-Saghir 4299","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4300","«قال الله تعالى: إذا ابتليت عبدا من عبادي مؤمنا فحمدني وصبر على ما بليته فإنه يقوم من مضجعه ذلك كيوم ولدته أمه من الخطايا ويقول الرب عز وجل للحفظة: إني أنا قيدت عبدي هذا وابتليته فأجروا له ما كنتم تجرون له قبل ذلك من الأجر وهو صحيح»","حسن","Sahih al-Jami al-Saghir 4300","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4301","«قال الله تعالى: إذا ابتليت عبدي المؤمن فلم يشكني إلى عواده أطلقته من إساري ثم أبدلته لحما خيرا من لحمه ودما خيرا من دمه ثم يستأنف العمل»","صحيح","Sahih al-Jami al-Saghir 4301","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4302","«قال الله تعالى: إذا ابتليت عبدي بحبيبتيه - يريد بعينيه - ثم صبر عوضته منهما الجنة»","صحيح","Sahih al-Jami al-Saghir 4302","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4303","«قال الله تعالى: إذا أحب عبدي لقائي أحببت لقاءه وإذا كره لقائي كرهت لقاءه»","صحيح","Sahih al-Jami al-Saghir 4303","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4304","«قال الله تعالى: إذا تقرب إلي العبد شبرا تقربت إليه ذراعا وإذا تقرب إلي ذراعا تقربت منه باعا وإذا أتاني مشيا أتيته هرولة»","صحيح","Sahih al-Jami al-Saghir 4304","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4305","«قال الله تعالى: إذا سلبت من عبدي كريمتيه وهو بهما صابر ضنين لم أرض له بهما ثوابا دون الجنة إذا حمدني عليهما»","حسن","Sahih al-Jami al-Saghir 4305","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4306","«قال الله تعالى: إذا هم عبدي بحسنة ولم يعملها كتبتها له حسنة فإن عملها كتبتها له عشر حسنات إلى سبعمائة ضعف وإذا هم بسيئة ولم يعملها لم أكتبها عليه فإن عملها كتبتها سيئة واحدة»","صحيح","Sahih al-Jami al-Saghir 4306","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4307","«قال الله تعالى: أعددت لعبادي الصالحين ما لا عين رأت ولا أذن سمعت ولا خطر على قلب بشر»","صحيح","Sahih al-Jami al-Saghir 4307","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4308","«قال الله تعالى: الصيام جنة يستجن بها العبد من النار وهو لي وأنا أجزي به»","حسن","Sahih al-Jami al-Saghir 4308","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4309","«قال الله تعالى: الكبرياء ردائي فمن نازعني في ردائي قصمته»","صحيح","Sahih al-Jami al-Saghir 4309","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4310","«قال الله تعالى: الكبرياء ردائي والعز إزاري فمن نازعني في شيء منهما عذبته»","صحيح","Sahih al-Jami al-Saghir 4310","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4311","«قال الله تعالى: الكبرياء ردائي والعظمة إزاري فمن نازعني واحدا منهما قذفته في النار»","صحيح","Sahih al-Jami al-Saghir 4311","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4312","«قال الله تعالى: المتحابون في جلالي لهم منابر من نور يغبطهم النبيون والشهداء»","صحيح","Sahih al-Jami al-Saghir 4312","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4313","«قال الله تعالى: أنا أغنى الشركاء عن الشرك من عمل عملا أشرك فيه معي غيري تركته وشركه»","صحيح","Sahih al-Jami al-Saghir 4313","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4314","«قال الله تعالى: أنا خلقت الرحم وشققت لها اسما من اسمي فمن وصلها وصلته ومن قطعها قطعته ومن بتها بتته»","صحيح","Sahih al-Jami al-Saghir 4314","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4315","«قال الله تعالى: أنا عند ظن عبدي بي إن ظن خيرا فله وإن ظن شرا فله»","صحيح","Sahih al-Jami al-Saghir 4315","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4316","«قال الله تعالى: أنا عند ظن عبدي بي فليظن بي ما شاء»","صحيح","Sahih al-Jami al-Saghir 4316","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4317","«قال الله عز وجل: أنفق أنفق عليك»","صحيح","Sahih al-Jami al-Saghir 4317","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4318","«قال الله تعالى: إن المؤمن مني بعرض كل خير إني أنزع نفسه من بين جنبيه وهو يحمدني»","صحيح","Sahih al-Jami al-Saghir 4318","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4319","«قال الله تعالى: إن أمتك لا يزالون يقولون ما كذا ما كذا حتى يقولوا: هذا الله خلق الخلق فمن خلق الله تعالى»","صحيح","Sahih al-Jami al-Saghir 4319","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4320","«قال الله تعالى: حقت محبتي على المتحابين أظلهم في ظل العرش يوم القيامة يوم لا ظل إلا ظلي»","صحيح","Sahih al-Jami al-Saghir 4320","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4321","قال الله تعالى: حقت محبتي للمتحابين في وحقت محبتي للمتواصلين في وحقت محبتي للمتناصحين في وحقت محبتي للمتزأورين في وحقت محبتي للمتباذلين في. المتحابون في على منابر من نور يغبطهم بمكانهم النبيون والصديقون والشهداء","صحيح","Sahih al-Jami al-Saghir 4321","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4322","«قال الله تعالى: سبقت رحمتي غضبي»","صحيح","Sahih al-Jami al-Saghir 4322","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4323","قال الله تعالى: شتمني ابن آدم وما ينبغي له أن يشتمني وكذبني وما ينبغي له أن يكذبني أما شتمه إياي فقوله: إن لي ولدا وأنا الله الأحد الصمد لم ألد ولم أولد ولم يكن لي كفوا أحد وأما تكذيبه إياي فقوله: ليس يعيدني كما بدأني وليس أول الخلق بأهون علي من إعادته","صحيح","Sahih al-Jami al-Saghir 4323","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4324","«قال الله تعالى: عبدي إذا ذكرتني خاليا ذكرتك خاليا وإن ذكرتني في ملأ ذكرتك في ملأ خير منهم وأكبر»","صحيح","Sahih al-Jami al-Saghir 4324","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4325","«قال الله تعالى: عبدي أنا عند ظنك بي وأنا معك إذا ذكرتني»","صحيح","Sahih al-Jami al-Saghir 4325","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4326","«قال الله تعالى: قسمت الصلاة بيني وبين عبدي نصفين ولعبدي ما سأل فإذا قال العبد: {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ} قال الله: حمدني عبدي فإذا قال: {الرَّحْمَنِ الرَّحِيمِ} قال الله: أثنى علي عبدي فإذا قال: {مَالِكِ يَوْمِ الدِّينِ} قال: مجدني عبدي فإذا قال: {إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ} قال: هذا بيني وبين عبدي ولعبدي ما سأل فإذا قال: {اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ. صراط صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ} قال: هذا لعبدي ولعبدي ما سأل»","صحيح","Sahih al-Jami al-Saghir 4326","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4327","«قال الله تعالى: كذبني ابن آدم ولم يكن له ذلك وشتمني ولم يكن له ذلك فأما تكذيبه إياي فزعم أني لا أقدر أن أعيده كما كان وأما شتمه إياي فقوله: لي ولد فسبحاني أن أتخذ صاحبة أو ولدا»","صحيح","Sahih al-Jami al-Saghir 4327","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4328","«قال الله تعالى: كل عمل ابن آدم له إلا الصيام فإنه لي وأنا أجزي به والصيام جنة وإذا كان يوم صوم أحدكم فلا يرفث ولا يصخب وإن سابه أحد أو قاتله فليقل: إني امرؤ صائم والذي نفس محمد بيده لخلوف فم الصائم عند الله أطيب من ريح المسك وللصائم فرحتان يفرحهما: إذا أفطر فرح بفطره وإذا لقي ربه فرح بصومه»","صحيح","Sahih al-Jami al-Saghir 4328","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4329","«قال الله تعالى للنفس: اخرجي قالت: لا أخرج إلا كارهة»","صحيح","Sahih al-Jami al-Saghir 4329","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4330","«قال الله تعالى: من علم أني ذوقدرة على مغفرة الذنوب غفرت له ولا أبالي ما لم يشرك بي شيئا»","حسن","Sahih al-Jami al-Saghir 4330","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4331","«قال الله تعالى: وجبت محبتي للمتحابين في والمتجالسين في والمتباذلين في والمتزأورين في»","صحيح","Sahih al-Jami al-Saghir 4331","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4332","«قال الله تعالى: وعزتي وجلالي لا أجمع لعبدي أمنين ولا خوفين إن هوأمنني في الدنيا أخفته يوم أجمع عبادي وإن هوخافني في الدنيا أمنته يوم أجمع عبادي»","حسن","Sahih al-Jami al-Saghir 4332","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4333","«قال الله تعالى: ومن أظلم ممن ذهب يخلق خلقا كخلقي فليخلقوا حبة أو ليخلقوا ذرة أو ليخلقوا شعيرة»","صحيح","Sahih al-Jami al-Saghir 4333","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4334","«قال الله تعالى: لا يأتي ابن آدم النذر بشيء لم أكن قد قدرته ولكن يلقيه النذر إلى القدر وقد قدرته له استخرج به من البخيل فيؤتيني عليه ما لم يكن يؤتيني من قبل!»","صحيح","Sahih al-Jami al-Saghir 4334","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4335","«قال الله تعالى: لا يذكرني عبد في نفسه إلا ذكرته في ملأ من ملائكتي ولا يذكرني في ملأ إلا ذكرته في الرفيق الأعلى»","حسن","Sahih al-Jami al-Saghir 4335","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4336","«قال الله تعالى: لا ينبغي لعبد لي أن يقول: أنا خير من يونس بن متى»","صحيح","Sahih al-Jami al-Saghir 4336","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4337","«قال الله تعالى: يا ابن آدم! إن ذكرتني في نفسك ذكرتك في نفسي وإن ذكرتني في ملأ ذكرتك في ملأ خير منهم وإن دنوت مني شبرا دنوت منك ذراعا وإن دنوت مني ذراعا دنوت منك باعا وإن أتيتني تمشي أتيت إليك أهرول»","صحيح","Sahih al-Jami al-Saghir 4337","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4338","«قال الله تعالى: يا ابن آدم! إنك ما دعوتني ورجوتني غفرت لك على ما كان منك ولا أبالي يا ابن آدم! لوبلغت ذنوبك عنان السماء ثم استغفرتني غفرت لك ولا أبالي يا ابن آدم! لوأنك أتيتني بقراب الأرض خطايا ثم لقيتني لا تشرك بي شيئا لأتيتك بقرابها مغفرة»","حسن","Sahih al-Jami al-Saghir 4338","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4339","«قال الله تعالى: يا ابن آدم! صل لي أربع ركعات من أول النهار أكفك آخره»","صحيح","Sahih al-Jami al-Saghir 4339","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4340","«قال الله تعالى: يا ابن آدم قم إلي أمش إليك وامش إلي أهرول إليك»","صحيح","Sahih al-Jami al-Saghir 4340","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4341","«قال الله تعالى: يا ابن آدم! مهما عبدتني ورجوتني ولم تشرك بي شيئا غفرت لك على ما كان منك وإن استقبلتني بملء السماء والأرض خطايا وذنوبا استقبلتك بملئهن من المغفرة وأغفر لك ولا أبالي»","صحيح","Sahih al-Jami al-Saghir 4341","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4342","«قال الله تعالى: يا ابن آدم! لا تعجز عن أربع ركعات في أول النهار أكفك آخره»","صحيح","Sahih al-Jami al-Saghir 4342","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4343","«قال الله تعالى: يؤذيني ابن آدم يسب الدهر وأنا الدهر بيدي الأمر أقلب الليل والنهار»","صحيح","Sahih al-Jami al-Saghir 4343","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4344","«قال الله تعالى: يؤذيني ابن آدم يقول: يا خيبة الدهر! فلا يقولن أحدكم: يا خيبة الدهر! فإني أنا الدهر أقلب ليله ونهاره فإذا شئت قبضتهما»","صحيح","Sahih al-Jami al-Saghir 4344","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4345","قال الله تعالى: يا عبادي! إني حرمت الظلم على نفسي وجعلته محرما بينكم فلا تظالموا يا عبادي! كلكم ضال إلا من هديته فاستهدوني أهدكم يا عبادي! كلكم جائع إلا من أطعمته فاستطعموني أطعمكم يا عبادي! كلكم عار إلا من كسوته فاستكسوني أكسكم يا عبادي! إنكم تخطئون بالليل والنهار وأنا أغفر الذنوب جميعا فاستغفروني أغفر لكم يا عبادي! إنكم لن تبلغوا ضري فتضروني ولن تبلغوا نفعي فتنفعوني يا عبادي! لو أن أولكم وآخركم وإنسكم وجنكم كانوا على أتقى قلب رجل واحد منكم ما زاد ذلك في ملكي شيئا يا عبادي! لو أن أولكم وآخركم وإنسكم وجنكم كانوا على أفجر قلب رجل واحد منكم ما نقص ذلك من ملكي شيئا يا عبادي! لوأن أولكم وآخركم وإنسكم وجنكم قاموا في صعيد واحد فسألوني فأعطيت كل إنسان مسألته ما نقص ذلك مما عندي إلا كما ينقص المخيط إذا أدخل البحر يا عبادي! إنما هي أعمالكم أحصيها لكم ثم أوفيكم إياها فمن وجد خيرا فليحمد الله ومن وجد غير ذلك فلا يلومن إلا نفسه","صحيح","Sahih al-Jami al-Saghir 4345","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4346","«قال رجل: لأتصدقن الليلة بصدقة فخرج بصدقته فوضعها في يد سارق فأصبحوا يتحدثون: تصدق الليلة على سارق فقال: اللهم لك الحمد على سارق! لأتصدقن الليلة بصدقة فخرج بصدقته فوضعها في يد زانية فأصبحوا يتحدثون: تصدق الليلة على زانية! فقال: اللهم لك الحمد على زانية! لأتصدقن الليلة بصدقة فخرج بصدقته فوضعها في يد غني فأصبحوا يتحدثون: تصدق الليلة على غني فقال: اللهم لك الحمد على سارق وعلى زانية وعلى غني فأتي فقيل له: أما صدقتك على سارق فلعله أن يستعف عن سرقته وأما الزانية فلعلها أن تستعف عن زناها وأما الغني فلعله أن يعتبر فينفق مما أعطاه الله»","صحيح","Sahih al-Jami al-Saghir 4346","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4347","«قال رجل: لا يغفر الله لفلان! فأوحى الله تعالى إلى نبي من الأنبياء: إنها خطيئة فليستقبل العمل»","صحيح","Sahih al-Jami al-Saghir 4347","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4348","«قال سليمان بن دأود: لأطوفن الليلة على مائة امرأة كلهن تأتي بفارس يجاهد في سبيل الله فقال له صاحبه: قل: إن شاء الله فلم يقل: إن شاء الله فطاف عليهن فلم تحمل منهن إلا امرأة واحدة جاءت بشق إنسان والذي نفس محمد بيده لوقال: إن شاء الله لم يحنث وكان دركا لحاجته»","صحيح","Sahih al-Jami al-Saghir 4348","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4349","«قال لي جبريل: إنا لا ندخل بيتا فيه كلب ولا تصأوير»","صحيح","Sahih al-Jami al-Saghir 4349","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4350","«قال لي جبريل: بشر خديجة ببيت في الجنة من قصب لا صخب فيه ولا نصب»","صحيح","Sahih al-Jami al-Saghir 4350","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4351","«قال لي جبريل: راجع حفصة فإنها صوامة قوامة وإنها زوجتك في الجنة»","حسن","Sahih al-Jami al-Saghir 4351","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4352","«قال لي جبريل: {قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ} فقلتها فقال: {قُلْ أَعُوذُ بِرَبِّ النَّاسِ} فقلتها»","صحيح","Sahih al-Jami al-Saghir 4352","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4353","«قال لي جبريل: لورأيتني وأنا آخذ من حال البحر فأدسه في في فرعون مخافة أن تدركه الرحمة»","صحيح","Sahih al-Jami al-Saghir 4353","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4354","«قال لي جبريل: من مات من أمتك لا يشرك بالله شيئا دخل الجنة قلت: وإن زنى وإن سرق؟ قال: وإن زنى وإن سرق»","صحيح","Sahih al-Jami al-Saghir 4354","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4355","«قال لي جبريل: يا محمد عش ما شئت فإنك ميت وأحبب من شئت فإنك مفارقه واعمل ما شئت فإنك ملاقيه»","حسن","Sahih al-Jami al-Saghir 4355","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4356","«قالت الملائكة: يا رب ذاك عبدك يريد أن يعمل بسيئة وهو أبصر به فقال: ارقبوه فإن عملها فاكتبوها له بمثلها وإن تركها فاكتبوها له حسنة إنما تركها من جراي»","صحيح","Sahih al-Jami al-Saghir 4356","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4357","«قام موسى خطيبا في بني إسرائيل فسئل أي الناس أعلم؟ فقال: أنا فعتب الله عليه إذ لم يرد العلم إليه وأوحى الله إليه: إن لي عبدا بمجمع البحرين هو أعلم منك قال: يا رب! وكيف لي به؟ فقيل: احمل حوتا في مكتل فإذا فقدته فهو ثم فانطلق وانطلق معه فتاه يوشع بن نون وحملا حوتا في مكتل حتى كانا عند الصخرة فوضعا رءوسهما فناما فانسل الحوت من المكتل فاتخذ سبيله في البحر سربا وكان لموسى وفتاه عجبا فانطلقا بقية يومهما وليلتهما فلما أصبحا قال موسى لفتاه: {آتِنَا غَدَاءَنَا لَقَدْ لَقِينَا مِنْ سَفَرِنَا هَذَا نَصَباً} ولم يجد موسى مسا من النصب حتى جأوز المكان الذي أمره الله به فقال له فتاه: {أَرَأَيْتَ إِذْ أويْنَا إِلَى الصَّخْرَةِ فَإِنِّي نَسِيتُ الْحُوتَ} قال موسى: {ذَلِكَ مَا كُنَّا نَبْغِ فَارْتَدَّا عَلَى آثَارِهِمَا قَصَصاً} فلما انتهيا إلى الصخرة إذا رجل مسجى بثوب فسلم موسى فقال الخضر: أنى بأرضك السلام؟ قال: أنا موسى قال: موسى بني إسرائيل؟ قال: نعم» قال: {هَلْ أَتَّبِعُكَ عَلَى أَنْ تُعَلِّمَنِ مِمَّا عُلِّمْتَ رُشْداً} ؟ {قَالَ إِنَّكَ لَنْ تَسْتَطِيعَ مَعِيَ صَبْراً} يا موسى إني على علم من علم الله تعالى علمنيه لا تعلمه أنت وأنت على علم من علم الله تعالى علمكه الله لا أعلمه {قَالَ سَتَجِدُنِي إِنْ شَاءَ اللَّهُ صَابِراً وَلا أَعْصِي لَكَ أَمْراً} فانطلقا يمشيان على الساحل فمرت سفينة فكلموهم أن يحملوهما فعرفوا الخضر فحملوهما بغير نول وجاء عصفور فوقع على حرف السفينة فنقر نقرة أو نقرتين في البحر فقال الخضر: يا موسى ما نقص علمي وعلمك من علم الله إلا كنقرة هذا العصفور في هذا البحر! فعمد الخضر إلى لوح من ألواح السفينة فنزعه فقال موسى: قوم حملونا بغير نول عمدت إلى سفينتهم فخرقتها لتغرق أهلها؟ {قَالَ أَلَمْ أَقُلْ إِنَّكَ لَنْ تَسْتَطِيعَ مَعِيَ صَبْراً} . {قَالَ لا تُؤَاخِذْنِي بِمَا نَسِيتُ} فكانت الأولى من موسى نسيانا فانطلقا فإذا غلام يلعب مع الغلمان فأخذ الخضر برأسه من أعلاه فاقتلع رأسه بيده فقال له موسى: {أَقَتَلْتَ نَفْساً زَكِيَّةً بِغَيْرِ نَفْسٍ} {قَالَ أَلَمْ أَقُلْ لَكَ إِنَّكَ لَنْ تَسْتَطِيعَ مَعِيَ صَبْراً} ، {فَانْطَلَقَا حَتَّى إِذَا أَتَيَا أَهْلَ قَرْيَةٍ اسْتَطْعَمَا أَهْلَهَا فَأَبَوْا أَنْ يُضَيِّفُوهُمَا فَوَجَدَا فِيهَا جِدَاراً يُرِيدُ أَنْ يَنْقَضَّ} قال الخضر بيده {فَأَقَامَهُ} فقال موسى: {لَوشِئْتَ لَتَّخَذْتَ عَلَيْهِ أَجْراً، قَالَ هَذَا فِرَاقُ بَيْنِي وَبَيْنِكَ} ، يرحم الله موسى لوددنا لوصبر حتى يقص علينا من أمرهما","صحيح","Sahih al-Jami al-Saghir 4357","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4358","«قتال المسلم أخاه كفر وسبابه فسوق»","صحيح","Sahih al-Jami al-Saghir 4358","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4359","«قتال المسلم كفر وسبابه فسوق ولا يحل لمسلم أن يهجر أخاه فوق ثلاثة أيام»","صحيح","Sahih al-Jami al-Saghir 4359","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4360","«قتل الصبر لا يمر بذنب إلا محاه»","حسن","Sahih al-Jami al-Saghir 4360","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4361","«قتل المؤمن أعظم عند الله من زوال الدنيا»","صحيح","Sahih al-Jami al-Saghir 4361","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4362","قتلوه قتلهم الله ألا سألوا إذا لم يعلموا فإنما شفاء العي السؤال؟ إنما كان يكفيه أن يتيمم.... ...","صحيح","Sahih al-Jami al-Saghir 4362","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4363","«قتلوه قتلهم الله ألم يكن شفاء العي السؤال؟»","صحيح","Sahih al-Jami al-Saghir 4363","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4364","«قد آجرك الله ورد عليك في الميراث»","صحيح","Sahih al-Jami al-Saghir 4364","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4365","«قد اجتمع في يومكم هذا عيدان فمن شاء أجزأه عن الجمعة وإنا مجمعون إن شاء الله تعالى»","صحيح","Sahih al-Jami al-Saghir 4365","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4366","«قد أجرنا من أجرت يا أم هانئ!»","صحيح","Sahih al-Jami al-Saghir 4366","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4367","«قد أذن الله لكن أن تخرجن لحوائجكن»","صحيح","Sahih al-Jami al-Saghir 4367","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4368","«قد أفلح من أسلم ورزق كفافا وقنعه الله بما آتاه»","صحيح","Sahih al-Jami al-Saghir 4368","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4369","«قد تركتكم على البيضاء ليلها كنهارها لا يزيغ عنها بعدي إلا هالك ومن يعش منكم فسيرى اختلافا كثيرا فعليكم بما عرفتم من سنتي وسنة الخلفاء الراشدين المهديين عضوا عليها بالنواجذ وعليكم بالطاعة وإن عبدا حبشيا فإنما المؤمن كالجمل الأنف حيثما انقيد انقاد»","صحيح","Sahih al-Jami al-Saghir 4369","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4370","«قد حللت حين وضعت حملك»","صحيح","Sahih al-Jami al-Saghir 4370","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4371","«قد دنت مني الجنة حتى لواجترأت عليها لجئتكم بقطاف من قطافها ودنت مني النار حتى قلت: أي رب وأنا معهم؟ فإذا امرأة تخدشها هرة قلت: ما شأن هذه؟ قالوا: حبستها حتى ماتت جوعا لا هي أطعمتها ولا أرسلتها تأكل من خشاش الأرض»","صحيح","Sahih al-Jami al-Saghir 4371","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4372","«قد رأيت الآن منذ صليت لكم الجنة والنار ممثلتين لي في قبل هذا الجدار فلم أر كاليوم في الخير والشر»","صحيح","Sahih al-Jami al-Saghir 4372","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4373","«قد رحمها الله تعالى برحمتها ابنيها»","صحيح","Sahih al-Jami al-Saghir 4373","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4374","«قد سألت الله لآجال مضروبة وأيام معدودة وأرزاق مقسومة لا يعجل شيئا منها قبل حله ولا يؤخر منها شيئا بعد حله ولو كنت سألت الله أن يعيذك من عذاب في النار وعذاب في القبر كان خيرا لك وأفضل»","صحيح","Sahih al-Jami al-Saghir 4374","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4375","«قد عجب الله من صنيعكما بضيفكما الليلة»","صحيح","Sahih al-Jami al-Saghir 4375","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4376","«قد قضينا الصلاة فمن أحب أن يجلس للخطبة فليجلس ومن أحب أن يذهب فليذهب»","صحيح","Sahih al-Jami al-Saghir 4376","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4377","«قد كان فيما مضى قبلكم من الأمم أناس محدثون فإن يك في أمتي أحد منهم فهو عمر بن الخطاب»","صحيح","Sahih al-Jami al-Saghir 4377","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4378","«قد كنت أكره أن تقولوا: ما شاء الله وشاء محمد ولكن قولوا: ما شاء الله ثم شاء محمد»","صحيح","Sahih al-Jami al-Saghir 4378","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4379","«قد كنت نهيتكم عن زيارة القبور فقد أذن لمحمد في زيارة قبر أمه فزوروها فإنها تذكركم الآخرة»","صحيح","Sahih al-Jami al-Saghir 4379","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4380","«قدر الله المقادير قبل أن يخلق السموات والأرضين بخمسين ألف سنة»","صحيح","Sahih al-Jami al-Saghir 4380","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4381","«قدمت المدينة ولأهل المدينة يومان يلعبون فيهما في الجاهلية وإن الله تعالى قد أبدلكم بهما خيرا منهما يوم الفطر ويوم النحر»","صحيح","Sahih al-Jami al-Saghir 4381","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4382","«قدموا قريشا ولا تقدموها وتعلموا من قريش ولا تعلموها ولولا أن تبطر قريش لأخبرتها ما لخيارها عند الله تعالى»","صحيح","Sahih al-Jami al-Saghir 4382","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4383","«قدموا قريشا ولا تقدموها وتعلموا منها ولا تعالموها»","صحيح","Sahih al-Jami al-Saghir 4383","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4384","«قدموا قريشا ولا تقدموها ولولا أن تبطر قريش لأخبرتها بما لها عند الله»","صحيح","Sahih al-Jami al-Saghir 4384","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4385","«قده بيده»","صحيح","Sahih al-Jami al-Saghir 4385","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4386","«قربيه فقد بلغت محلها»","صحيح","Sahih al-Jami al-Saghir 4386","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4387","«قربيه فما أفقر بيت من أدم فيه خل»","صحيح","Sahih al-Jami al-Saghir 4387","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4388","«قرصت نملة نبيا من الأنبياء فأمر بقرية النمل فأحرقت فأوحى الله تعالى إليه أن قرصتك نملة أحرقت أمة من الأمم تسبح؟!»","صحيح","Sahih al-Jami al-Saghir 4388","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4389","«قريش والأنصار وجهينة ومزينة وأسلم وأشجع وغفار موالي ليس لهم مولى دون الله ورسوله»","صحيح","Sahih al-Jami al-Saghir 4389","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4390","«قريش ولاة الناس في الخير والشر إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 4390","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4391","«قريش ولاة هذا الأمر فبر الناس تبع لبرهم وفاجرهم تبع لفاجرهم»","صحيح","Sahih al-Jami al-Saghir 4391","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4392","«قصوا الشوارب واعفوا اللحى»","حسن","Sahih al-Jami al-Saghir 4392","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4393","«قفلة كغزوة»","صحيح","Sahih al-Jami al-Saghir 4393","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4394","«قفوا على مشاعركم هذه فإنكم على إرث من إرث أبيكم إبراهيم»","صحيح","Sahih al-Jami al-Saghir 4394","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4395","«قل آمنت بالله ثم استقم»","صحيح","Sahih al-Jami al-Saghir 4395","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4396","« {قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ} و {قُلْ أَعُوذُ بِرَبِّ النَّاسِ} ما تعوذ الناس بأفضل منهما»","صحيح","Sahih al-Jami al-Saghir 4396","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4397","«قل: السلام عليكم أأدخل؟»","صحيح","Sahih al-Jami al-Saghir 4397","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4398","«قل اللهم اغفر لي وارحمني وعافني وارزقني فإن هؤلاء تجمع لك دنياك وآخرتك»","صحيح","Sahih al-Jami al-Saghir 4398","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4399","«قل اللهم إني أعوذ بك من شر سمعي ومن شر بصري ومن شر لساني ومن شر قلبي ومن شر منيي»","صحيح","Sahih al-Jami al-Saghir 4399","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4400","«قل اللهم إني ظلمت نفسي ظلما كثيرا وإنه لا يغفر الذنوب إلا أنت فاغفر لي مغفرة من عندك وارحمني إنك أنت الغفور الرحيم»","صحيح","Sahih al-Jami al-Saghir 4400","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4401","«قل: اللهم اهدني وسددني واذكر بالهدى هدايتك الطريق والسداد سداد السهم»","صحيح","Sahih al-Jami al-Saghir 4401","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4402","«قل: اللهم فاطر السموات والأرض عالم الغيب والشهادة رب كل شيء ومليكه أشهد أن لا إله إلا أنت أعوذ بك من شر نفسي ومن شر الشيطان وشركه قلها إذا أصبحت وإذا أمسيت وإذا أخذت مضجعك»","صحيح","Sahih al-Jami al-Saghir 4402","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4403","«قل كما يقولون فإذا انتهيت فسل تعط - يعني المؤذنين»","صحيح","Sahih al-Jami al-Saghir 4403","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4404","« {قُلْ هُواللَّهُ أَحَدٌ} تعدل ثلث القرآن»","صحيح","Sahih al-Jami al-Saghir 4404","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4405","« {قُلْ هُواللَّهُ أَحَدٌ} تعدل ثلث القرآن و {قُلْ يَا أَيُّهَا الْكَافِرُونَ} تعدل ربع القرآن»","صحيح","Sahih al-Jami al-Saghir 4405","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4406","« {قُلْ هُواللَّهُ أَحَدٌ} والمعوذتين حين تمسي وحين تصبح ثلاث مرات تكفيك من كل شيء»","صحيح","Sahih al-Jami al-Saghir 4406","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4407","«قلب الشيخ شاب على حب اثنتين: حب العيش والمال»","صحيح","Sahih al-Jami al-Saghir 4407","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4408","«قلب الشيخ شاب على حب اثنتين: طول الحياة وكثرة المال»","صحيح","Sahih al-Jami al-Saghir 4408","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4409","«قلب شاكر ولسان ذاكر وزوجة صالحة تعينك على أمر دنياك ودينك خير ما اكتنز الناس»","صحيح","Sahih al-Jami al-Saghir 4409","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4410","«قليل ما أسكر كثيره حرام»","صحيح","Sahih al-Jami al-Saghir 4410","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4411","«قمت على باب الجنة فإذا عامة من دخلها المساكين وإذا أصحاب الجد محبوسون إلا أصحاب النار فقد أمر بهم إلى النار وقمت على باب النار فإذا عامة من يدخلها النساء»","صحيح","Sahih al-Jami al-Saghir 4411","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4412","«قوائم منبري رواتب في الجنة»","صحيح","Sahih al-Jami al-Saghir 4412","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4413","«قوام أمتي بشرارها»","حسن","Sahih al-Jami al-Saghir 4413","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4414","«قولوا: اللهم صل على محمد النبي الأمي وعلى آل محمد كما صليت على آل إبراهيم وبارك على محمد النبي الأمي كما باركت على آل إبراهيم في العالمين إنك حميد مجيد والسلام كما قد علمتم»","صحيح","Sahih al-Jami al-Saghir 4414","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4415","«قولوا: اللهم صل على محمد عبدك ورسولك كما صليت على إبراهيم وبارك على محمد وآل محمد كما باركت على إبراهيم وآل إبراهيم»","صحيح","Sahih al-Jami al-Saghir 4415","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4416","«قولوا: اللهم صل على محمد وعلى آل محمد كما صليت على إبراهيم وعلى آل إبراهيم إنك حميد مجيد اللهم بارك على محمد وعلى آل محمد كما باركت على إبراهيم وآل إبراهيم إنك حميد مجيد»","صحيح","Sahih al-Jami al-Saghir 4416","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4417","«قولوا: اللهم صل على محمد وعلى أزواجه وذريته كما صليت على إبراهيم وبارك على محمد وعلى أزواجه وذريته كما باركت على إبراهيم إنك حميد مجيد»","صحيح","Sahih al-Jami al-Saghir 4417","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4418","«قولوا بعض قولكم ولا يستحوذنكم الشيطان»","صحيح","Sahih al-Jami al-Saghir 4418","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4419","«قولوا خيرا تغنموا واسكتوا عن شر تسلموا»","صحيح","Sahih al-Jami al-Saghir 4419","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4420","«قولوا: ما شاء الله ثم شئت»","صحيح","Sahih al-Jami al-Saghir 4420","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4421","«قولي: السلام على أهل الديار من المؤمنين والمسلمين ويرحم الله المستقدمين منا والمستأخرين وإنا إن شاء الله بكم لاحقون»","صحيح","Sahih al-Jami al-Saghir 4421","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4422","«قولي: اللهم اغفر لي وله واعقبني منه عقبى حسنة»","صحيح","Sahih al-Jami al-Saghir 4422","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4423","«قولى: اللهم إنك عفوتحب العفوفاعف عني»","صحيح","Sahih al-Jami al-Saghir 4423","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4424","«قولي: اللهم رب السموات السبع ورب العرش العظيم ربنا ورب كل شيء منزل التوراة والإنجيل والقرآن فالق الحب والنوى أعوذ بك من شر كل شيء أنت آخذ بناصيته أنت الأول فليس قبلك شيء وأنت الآخر فليس بعدك شيء وأنت الظاهر فليس فوقك شيء وأنت الباطن فليس دونك شيء اقض عني الدين وأغنني من الفقر»","صحيح","Sahih al-Jami al-Saghir 4424","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4425","«قولي: لبيك اللهم لبيك ومحلي من الأرض حيث تحبسني فإن لك على ربك ما استثنيت»","صحيح","Sahih al-Jami al-Saghir 4425","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4426","«قوموا إلى جنة عرضها السموات والأرض»","صحيح","Sahih al-Jami al-Saghir 4426","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4427","«قوموا إلى سيدكم»","صحيح","Sahih al-Jami al-Saghir 4427","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4428","«قوموا فإن للموت فزعا»","صحيح","Sahih al-Jami al-Saghir 4428","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4429","«قيام ساعة في الصف للقتال في سبيل الله خير من قيام ستين سنة»","صحيح","Sahih al-Jami al-Saghir 4429","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4430","«قيل لبني إسرائيل {ادْخُلُوا الْبَابَ سُجَّداً، وَقُولُوا حِطَّةٌ} فبدلوا فدخلوا يزحفون على أستاههم وقالوا: حبة في شعيرة»","صحيح","Sahih al-Jami al-Saghir 4430","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4431","«قيلوا فإن الشياطين لا تقيل»","حسن","Sahih al-Jami al-Saghir 4431","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4432","«قيد وتوكل»","حسن","Sahih al-Jami al-Saghir 4432","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4433","«قيدها وتوكل»","حسن","Sahih al-Jami al-Saghir 4433","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4434","«قيدوا العلم بالكتاب»","صحيح","Sahih al-Jami al-Saghir 4434","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4435","«القائم بعدي في الجنة والذي يقوم بعده في الجنة والثالث والرابع في الجنة»","صحيح","Sahih al-Jami al-Saghir 4435","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4436","«القاتل لا يرث»","صحيح","Sahih al-Jami al-Saghir 4436","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4437","«القاعد على الصلاة كالقانت ويكتب من المصلين من حين يخرج من بيته حتى يرجع إلى بيته»","صحيح","Sahih al-Jami al-Saghir 4437","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4438","«القتل في سبيل الله شهادة والطاعون شهادة والبطن شهادة والغرق شهادة والنفساء شهادة»","صحيح","Sahih al-Jami al-Saghir 4438","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4439","«القتل في سبيل الله شهادة والطاعون شهادة والغرق شهادة والبطن شهادة والحرق شهادة والسل والنفساء يجرها ولدها بسررها إلى الجنة»","حسن","Sahih al-Jami al-Saghir 4439","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4440","«القتل في سبيل الله يكفر كل خطيئة إلا الدين»","صحيح","Sahih al-Jami al-Saghir 4440","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4441","«القتيل في سبيل الله شهيد والمبطون شهيد والمطعون شهيد والغريق شهيد والنفساء شهيدة»","صحيح","Sahih al-Jami al-Saghir 4441","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4442","«القدرية مجوس هذه الأمة إن مرضوا فلا تعودوهم وإن ماتوا فلا تشهدوهم»","حسن","Sahih al-Jami al-Saghir 4442","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4443","«القرآن شافع مشفع وماحل مصدق من جعله أمامه قاده إلى الجنة ومن جعله خلفه ساقه إلى النار»","صحيح","Sahih al-Jami al-Saghir 4443","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4444","«القرآن يقرأ على سبعة أحرف فلا تماروا في القرآن فإن مراء في القرآن كفر»","صحيح","Sahih al-Jami al-Saghir 4444","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4445","«القصاص ثلاثة: أمير أو مأمور أو مختال»","صحيح","Sahih al-Jami al-Saghir 4445","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4446","«القضاة ثلاثة اثنان في النار وواحد في الجنة: رجل علم الحق فقضى به فهو في الجنة ورجل قضى للناس على جهل فهو في النار ورجل عرف الحق فجار في الحكم فهو في النار»","صحيح","Sahih al-Jami al-Saghir 4446","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
"4447","«القضاة ثلاثة: قاضيان في النار وقاض في الجنة قاض قضى بالهوى فهو في النار وقاض قضى بغير علم فهو في النار وقاض قضى بالحق فهو في الجنة»","صحيح","Sahih al-Jami al-Saghir 4447","","","الأحاديث المبدوءة بحرف القاف Hadith Beginning with the Letter Qaf (ق)"
