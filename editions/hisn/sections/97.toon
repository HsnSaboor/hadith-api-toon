hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"192","بِسْمِ الله اللّهُـمَّ جَنِّبْنا الشَّيْـطانَ، وَجَنِّبِ الشَّـيْطانَ ما رَزَقْـتَنا","","","","","Comprehensive types of good and manners"
"193","أَعـوذُ بِاللهِ مِنَ الشَّيْـطانِ الرَّجيـم","","","","","Comprehensive types of good and manners"
