hadiths[361]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"7201","4 - (  7196  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  أَخْبَرَنَا  نَضْرُ بْنُ شُمَيْلٍ ،  أَخْبَرَنَا  شُعْبَةُ ،  حَدَّثَنَا  عَاصِمُ بْنُ عُبَيْدِ اللهِ قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَامِرِ بْنِ رَبِيعَةَ  يَذْكُرُ عَنْ  أَبِيهِ  أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  مَا مِنْ عَبْدٍ  صَلَّى  عَلَيَّ صَلَاةً ، إِلَّا صَلَّتْ عَلَيْهِ الْمَلَائِكَةُ مَا  صَلَّى  عَلَيَّ  ، فَلْيُقِلَّ عَبْدٌ مِنْ ذَلِكَ أَوْ لِيُكْثِرْ  .         [13/155]","","Musnad Abi Ya'la al-Mawsili 7196","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7202","5 - (  7197  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ .         [13/156]      عَنْ  أَبِيهِ  أَنَّ  رَجُلًا مِنْ بَنِي فَزَارَةَ  تَزَوَّجَ  امْرَأَةً  عَلَى نَعْلَيْنِ ، فَأَجَازَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نِكَاحَهَا  .","","Musnad Abi Ya'la al-Mawsili 7197","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن سفيان الثوري عن وكيع بن الجراح عن إسحاق بن إسماعيل الطالقاني عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7203","6 - (  7198  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَلِيُّ بْنُ قَادِمٍ ،  أَخْبَرَنَا  شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَقُولُ :  يَعْنِي الرَّبَّ  - عَزَّ وَجَلَّ - :  إِنَّ الرَّحِمَ  شِجْنَةٌ  مِنِّي  ، فَمَنْ وَصَلَهَا وَصَلْتُهُ ، وَمَنْ قَطَعَهَا قَطَعْتُهُ  .         [13/157]","","Musnad Abi Ya'la al-Mawsili 7198","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن شريك بن عبد الله النخعي عن علي بن قادم الخزاعي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7204","7 - (  7199  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَاصِمٌ قَالَ :  حَدَّثَنِي  الْمَسْعُودِيُّ ،  عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  قَالَ :  إِنْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيَبْعَثُنَا وَمَا لَنَا طَعَامٌ إِلَّا  السَّلْفُ  مِنَ التَّمْرِ ، فَنَقْسِمُهُ قَبْضَةً قَبْضَةً  ، نَنْتَهِي إِلَى تَمْرَةٍ تَمْرَةٍ ، فَوَاللهِ مُنْذُ أَنْ فَقَدْنَاهَا  اخْتَلَلْنَاهَا  .","","Musnad Abi Ya'la al-Mawsili 7199","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عاصم بن علي الواسطي عن إسحاق بن إسماعيل الطالقاني عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7205","8 - (  7200  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  .         [13/158]      عَنْ  عَامِرِ بْنِ رَبِيعَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا رَأَيْتُمُ الْجِنَازَةَ فَقُومُوا لَهَا حَتَّى تُخَلِّفَكُمْ أَوْ تُوضَعَ  "" .         [13/159]","","Musnad Abi Ya'la al-Mawsili 7200","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7206","9 - (  7201  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ الْبَصْرِيُّ ،  حَدَّثَنَا  الضَّحَّاكُ بْنُ مَخْلَدٍ ،  أَخْبَرَنِي  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  عَاصِمُ بْنُ عُبَيْدِ اللهِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  سَيَكُونُ عَلَيْكُمْ أُمَرَاءُ بَعْدِي ، يُصَلُّونَ الصَّلَاةَ يُؤَخِّرُونَهَا  ، فَإِنْ صَلَّوْهَا لِوَقْتِهَا وَصَلَّيْتُمُوهَا مَعَهُمْ فَلَكُمْ وَلَهُمْ ، وَإِنْ صَلَّوْهَا لِغَيْرِ وَقْتِهَا فَصَلَّيْتُمُوهَا مَعَهُمْ فَلَكُمْ وَعَلَيْهِمْ ، فَمَنْ  فَارَقَ  الْجَمَاعَةَ فَقَدْ بَرِئَ مِنَ الْإِسْلَامِ ، وَمَنْ مَاتَ وَقَدْ نَكَثَ الْعَهْدَ ، لَقِيَ اللهَ وَلَا حُجَّةَ لَهُ  قُلْتُ :  مَنْ أَخْبَرَكَ  بِهَذَا ؟ قَالَ :  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .         [13/160]","","Musnad Abi Ya'la al-Mawsili 7201","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن ابن جريج عن أبو عاصم النبيل عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7207","10 - (  7202  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  أَخْبَرَنَا  أَبِي  ،  سَمِعْتُ  النُّعْمَانَ بْنَ رَاشِدٍ  يُحَدِّثُ عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  أَنَّهُ رَأَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يُومِئُ  بِرَأْسِهِ حَيْثُ تَوَجَّهَ وَجْهُهُ  .         [13/161]","","Musnad Abi Ya'la al-Mawsili 7202","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن الزهري عن النعمان بن راشد الجزري عن جرير بن حازم عن وهب بن جرير بن حازم عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7208","11 - (  7203  ) -  حَدَّثَنَا  أَبُو الْحَارِثِ سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَكُونُ عَلَيْكُمْ         [13/162]      أُمَرَاءُ يُصَلُّونَ الصَّلَاةَ لِوَقْتِهَا ، وَيُؤَخِّرُونَ عَنْ وَقْتِهَا  ، فَمَا صَلَّوْهَا لِوَقْتِهَا وَصَلَّيْتُمُوهَا مَعَهُمْ فَلَكُمْ وَلَهُمْ ، وَمَا أَخَّرُوهَا عَنْ وَقْتِهَا ، فَصَلَّيْتُمُوهَا مَعَهُمْ ، فَلَكُمْ وَعَلَيْهِمْ ، وَمَنْ  فَارَقَ  الْجَمَاعَةَ خَلَعَ  رِبْقَةَ  الْإِسْلَامِ مِنْ عُنُقِهِ ، وَمَنْ مَاتَ  نَاكِثًا  الْعَهْدَ ، جَاءَ يَوْمَ الْقِيَامَةِ لَا حُجَّةَ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 7203","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن ابن جريج عن يحيى بن سعيد بن أبان عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7209","12 - (  7204  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، وَإِسْحَاقُ قَالَا :  حَدَّثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  عَمْرٌو مَوْلَى آلِ مَنْظُورِ بْنِ سَيَّارٍ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَطُوفُ  بِالْبَيْتِ  ، فَانْقَطَعَ  شِسْعُهُ  ، فَأَخْرَجَ  رَجُلٌ  شِسْعًا  مِنْ نَعْلِهِ ، فَذَهَبَ يَشُدُّهُ فِي نَعْلِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَانْتَزَعَهَا ، وَقَالَ :  هَذِهِ أَثَرَةٌ ، وَلَا أُحِبُّ الْأَثَرَةَ  .","","Musnad Abi Ya'la al-Mawsili 7204","","عامر بن ربيعة بن كعب العنزي عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن عمر بن قيس سندل عن عمر بن علي بن عطاء عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث عامر بن ربيعة"
"7210","[13/163]      حَدِيثُ  أَبِي بَصْرَةَ الْغِفَارِيِّ  1 - (  7205  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  خَيْرِ بْنِ نُعَيْمٍ الْحَضْرَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ هُبَيْرَةَ السَّبَائِيِّ وَكَانَ  ثِقَةً  ،  عَنْ  أَبِي تَمِيمٍ الْجَيْشَانِيِّ ،  عَنْ  أَبِي بَصْرَةَ الْغِفَارِيِّ قَالَ :  صَلَّى بِنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [13/164]      صَلَاةَ الْعَصْرِ ، فَلَمَّا قَضَى صَلَاتَهُ - قَالَ يَعْقُوبُ مَرَّةً أُخْرَى : فَلَمَّا انْصَرَفَ مِنْ صَلَاتِهِ - قَالَ :  إِنَّ هَذِهِ الصَّلَاةَ عُرِضَتْ عَلَى مَنْ كَانَ قَبْلَكُمْ فَتَوَانَوْا عَنْهَا وَتَرَكُوهَا  ، فَمَنْ صَلَّاهَا مِنْكُمْ ضُوعِفَ لَهُ فِي أَجْرِهَا ضِعْفَيْنِ ، وَلَا صَلَاةَ بَعْدَهَا حَتَّى يُرَى  الشَّاهِدُ  ،  وَالشَّاهِدُ : النَّجْمُ  "" .         [13/165]","","Musnad Abi Ya'la al-Mawsili 7205","","حميل بن بصرة الغفاري عن عبد الله بن مالك بن أبي الأسحم الجيشاني عن عبد الله بن هبيرة السبئي عن خير بن نعيم الناهضى عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","حديث أبي بصرة الغفاري"
"7211","1 - (  7206  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مُنِيبٍ الْعَدَنِيُّ ،  عَنِ  السَّرِيِّ بْنِ يَحْيَى ،  عَنْ  رَجُلٍ مِنْ طَيِّئٍ - وَأَثْنَى عَلَيْهِ خَيْرًا - قَالَ :  كُنْتُ أَسْأَلُ اللهَ - عَزَّ وَجَلَّ - أَنْ يُرِيَنِي الِاسْمَ الَّذِي إِذَا دُعِيَ بِهِ أَجَابَ . فَرَأَيْتُ مَكْتُوبًا فِي الْكَوَاكِبِ فِي السَّمَاءِ :  يَا بَدِيعَ السَّمَاوَاتِ وَالْأَرْضِ يَا ذَا  الْجَلَالِ  وَالْإِكْرَامِ  ""  .","","Musnad Abi Ya'la al-Mawsili 7206","","رجل من طيئ عن السري بن يحيى الشيباني عن محمد بن منيب العدني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث أبي بصرة الغفاري"
"7212","1 - (  7207  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ  قَالَ  :  كَانَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ إِذَا دَخَلَ مَنْزِلَهُ قَرَأَ فِي زَوَايَا         [13/166]      مَنْزِلِهِ آيَةَ الْكُرْسِيِّ  .","","Musnad Abi Ya'la al-Mawsili 7207","","عبد الرحمن بن عوف بن عبد عوف القرشي عن عبد الله بن عبيد بن عمير الجندعي عن عبد العزيز بن رفيع الطائفي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","حديث أبي بصرة الغفاري"
"7213","1 - (  7208  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ قُدَامَةَ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  مُجَاهِدٍ  قَالَ  :  مَرَّ رَجُلٌ بِابْنِ عَبَّاسٍ فَقَالَ :  إِنَّ هَذَا الرَّجُلَ يُحِبُّنِي . قَالُوا : وَمَا يُدْرِيكَ يَا  أَبَا عَبَّاسٍ  ؟ قَالَ : لِأَنِّي أُحِبُّهُ  .","","Musnad Abi Ya'la al-Mawsili 7208","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن أبو بكر بن عياش عن محمد بن قدامة الجوهري عن أبو يعلى الموصلي","حديث أبي بصرة الغفاري"
"7214","[13/167]      حَدِيثُ  زَيْدِ بْنِ حَارِثَةَ  1 - (  7209  ) -  حَدَّثَنِي  سَعِيدُ بْنُ يَحْيَى الْأُمَوِيُّ قَالَ :  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  كَثِيرِ بْنِ كَثِيرٍ ،  عَنْ  عَلِيِّ بْنِ عَبْدِ اللهِ ،         [13/168]      عَنْ  زَيْدِ بْنِ حَارِثَةَ قَالَ :  سَأَلَ  رَجُلٌ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ وَقْتِ صَلَاةِ الصُّبْحِ ، فَقَالَ :  صَلِّهَا مَعِيَ الْيَوْمَ وَغَدًا  فَلَمَّا كَانَ  بِقَاعِ  نَمِرَةَ  بِالْجُحْفَةِ  ، صَلَّاهَا حِينَ طَلَعَ الْفَجْرُ ، حَتَّى إِذَا كَانَ  بِذِي طُوًى  أَخَّرَهَا ، حَتَّى قَالَ النَّاسُ : أَقُبِضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقَالُوا : لَوْ صَلَّيْنَا ؟ فَخَرَجَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَلَّاهَا أَمَامَ الشَّمْسِ ، ثُمَّ أَقْبَلَ عَلَى النَّاسِ ، فَقَالَ : "" مَاذَا قُلْتُمْ ؟ "" قَالُوا : قُلْنَا : لَوْ صَلَّيْنَا ؟ قَالَ : "" لَوْ فَعَلْتُمْ أَصَابَكُمْ عَذَابٌ "" ثُمَّ دَعَا السَّائِلَ         [13/169]      فَقَالَ : "" الصَّلَاةُ مَا بَيْنَ هَاتَيْنِ الصَّلَاتَيْنِ  "" .","","Musnad Abi Ya'la al-Mawsili 7209","","زيد بن حارثة الكلبي عن علي بن أبي الوليد البارقي عن كثير بن كثير بن المطلب السهمي عن ابن جريج عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","حديث زيد بن حارثة"
"7215","2 - (  7210  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ أَبُو مُحَمَّدٍ الْأَزْدِيُّ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْبَرَاءِ ،  عَنْ  زَيْدِ بْنِ حَارِثَةَ أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ! آخَيْتَ بَيْنِي وَبَيْنَ  حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ  .         [13/170]","","Musnad Abi Ya'la al-Mawsili 7210","","زيد بن حارثة الكلبي عن البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن يونس بن بكير عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","حديث زيد بن حارثة"
"7216","3 - (  7211  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ  أَنَّ  زَيْدَ بْنَ حَارِثَةَ قَالَ :  يَا رَسُولَ اللهِ ! آخَيْتَ بَيْنِي وَبَيْنَ  حَمْزَةَ  .","","Musnad Abi Ya'la al-Mawsili 7211","","زيد بن حارثة الكلبي عن البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن يونس بن بكير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","حديث زيد بن حارثة"
"7217","4 - (  7212  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ قَالَ :  حَدَّثَنَا عَبْدُ الْوَهَّابِ بْنُ عَبْدِ الْمَجِيدِ ،  أَمْلَاهُ عَلَيْنَا مِنْ كِتَابِهِ  ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ، وَيَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبِ بْنِ أَبِي بَلْتَعَةَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،         [13/171]      عَنْ  زَيْدِ بْنِ حَارِثَةَ  قَالَ :  خَرَجْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا حَارًّا مِنْ أَيَّامِ  مَكَّةَ  - وَهُوَ مُرْدِفِي - إِلَى  نُصُبٍ  مِنَ  الْأَنْصَابِ  ، وَقَدْ ذَبَحْنَا لَهُ شَاةً فَأَنْضَجْنَاهَا . قَالَ : فَلَقِيَهُ  زَيْدُ بْنُ عَمْرِو بْنِ نُفَيْلٍ  ، فَحَيَّا كُلُّ وَاحِدٍ مِنْهُمَا صَاحِبَهُ بِتَحِيَّةِ الْجَاهِلِيَّةِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" يَا  زَيْدُ  ، مَا لِي أَرَى قَوْمَكَ قَدْ  شَنِفُوا  لَكَ ؟ "" قَالَ : وَاللهِ يَا  مُحَمَّدُ  إِنَّ ذَلِكَ لَبِغَيْرِ نَائِلَةٍ لِي مِنْهُمْ ، وَلَكِنِّي خَرَجْتُ أَبْتَغِي هَذَا الدِّينَ ، حَتَّى أَقْدَمَ عَلَى  أَحْبَارِ فَدَكَ  ، فَوَجَدْتُهُمْ يَعْبُدُونَ اللهَ وَيُشْرِكُونَ بِهِ .  قَالَ : قُلْتُ : مَا هَذَا بِالدِّينِ الَّذِي أَبْتَغِي ، فَخَرَجْتُ حَتَّى أَقْدَمَ عَلَى  أَحْبَارِ الشَّامِ  فَوَجَدْتُهُمْ يَعْبُدُونَ اللهَ وَيُشْرِكُونَ بِهِ ، قُلْتُ : مَا هَذَا بِالدِّينِ الَّذِي أَبْتَغِي ، فَقَالَ شَيْخٌ مِنْهُمْ : إِنَّكَ لَتَسْأَلُ عَنْ دِينٍ مَا نَعْلَمُ أَحَدًا يَعْبُدُ اللهَ بِهِ إِلَّا شَيْخٌ  بِالْحِيرَةِ  . قَالَ : فَخَرَجْتُ حَتَّى أَقْدَمَ عَلَيْهِ ، فَلَمَّا رَآنِي قَالَ : مِمَّنْ أَنْتَ ؟ قُلْتُ : مِنْ أَهْلِ بَيْتِ اللهِ ، مِنْ أَهْلِ الشَّوْكِ وَالْغَرْبِ ، فَقَالَ : إِنَّ الدِّينَ الَّذِي تَطْلُبُ قَدْ ظَهَرَ بِبِلَادِكَ ، قَدْ بُعِثَ نَبِيٌّ ، قَدْ         [13/172]      طَلَعَ نَجْمُهُ ، وَجَمِيعُ مَنْ رَأَيْتَهُمْ فِي ضَلَالٍ ، فَلَمْ  أُحِسَّ  بِشَيْءٍ بَعْدُ يَا  مُحَمَّدُ  .  قَالَ : وَقَرَّبَ إِلَيْهِ  السُّفْرَةَ  . قَالَ : فَقَالَ : مَا هَذَا يَا  مُحَمَّدُ  ؟ فَقَالَ : شَاةٌ ذَبَحْنَاهَا  لِنُصُبٍ  مِنَ  الْأَنْصَابِ  "" قَالَ : فَقَالَ : مَا كُنْتُ لِآكُلَ مِمَّا لَمْ يُذْكَرِ اسْمُ اللهِ عَلَيْهِ ، قَالَ  زَيْدُ بْنُ حَارِثَةَ  : فَأَتَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْبَيْتَ  . قَالَ : وَتَفَرَّقْنَا فَطَافَ بِهِ ، وَأَنَا مَعَهُ ،  وَبِالصَّفَا  وَالْمَرْوَةِ  قَالَ : وَكَانَ عِنْدَ  الصَّفَا  وَالْمَرْوَةِ  صَنَمَانِ مِنْ نُحَاسٍ : أَحَدُهُمَا يُقَالُ لَهُ : يَسَافٌ ، وَالْآخَرُ يُقَالُ لَهُ : نَائِلَةُ ، وَكَانَ الْمُشْرِكُونَ إِذَا طَافُوا تَمَسَّحُوا بِهِمَا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" لَا تَمْسَحْهُمَا ، فَإِنَّهُمَا رِجْسٌ "" فَقُلْتُ فِي نَفْسِي : لَأَمَسَّنَّهُمَا حَتَّى أَنْظُرَ مَا يَقُولُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَسَسْتُهُمَا ، فَقَالَ : "" يَا  زَيْدُ  ، أَلَمْ تُنْهَ ؟ "" قَالَ : وَمَاتَ  زَيْدُ بْنُ عَمْرٍو  ، وَأُنْزِلَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِزَيْدٍ  :  إِنَّهُ يُبْعَثُ  أُمَّةً  وَحْدَهُ  "" .","","Musnad Abi Ya'la al-Mawsili 7212","","زيد بن حارثة الكلبي عن أسامة بن زيد بن حارثة ذو البطين عن يحيى بن عبد الرحمن بن حاطب اللخمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الوهاب بن عبد المجيد الثقفي عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث زيد بن حارثة"
"7218","[13/173]             [13/174]      حَدِيثُ  خَبَّابِ بْنِ الْأَرَتِّ  1 - (  7213  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسٍ ،  عَنْ  خَبَّابٍ قَالَ :  شَكَوْنَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ مُتَوَسِّدٌ بِبُرْدَةٍ لَهُ فِي ظِلِّ  الْكَعْبَةِ  ، فَقُلْنَا : أَلَا تَسْتَنْصِرُ لَنَا ؟ فَجَلَسَ مُحْمَرًّا وَجْهُهُ ، فَقَالَ :  قَدْ كَانَ مَنْ قَبْلَكُمْ يُؤْخَذُ الرَّجُلُ فَيُحْفَرُ لَهُ فِي الْأَرْضِ ، ثُمَّ يُجَاءُ بِالْمِنْشَارِ يُجْعَلُ فَوْقَ رَأْسِهِ  ، مَا يَصْرِفُهُ عَنْ دِينِهِ ، أَوْ يُمْشَطُ بِأَمْشَاطِ الْحَدِيدِ مَا دُونَ لَحْمِهِ مِنْ عَظْمٍ وَعَصَبٍ مَا يَصْرِفُهُ عَنْ دِينِهِ ، وَلَيُتِمَّنَّ اللهُ هَذَا الْأَمْرَ حَتَّى يَسِيرَ الرَّاكِبُ مِنْ         [13/175]      صَنْعَاءَ  إِلَى  حَضْرَمَوْتَ  لَا يَخْشَى إِلَّا اللهَ - عَزَّ وَجَلَّ - ، وَالذِّئْبَ عَلَى غَنَمِهِ ، وَلَكِنَّكُمْ تَعْجَلُونَ  .","","Musnad Abi Ya'la al-Mawsili 7213","","خباب بن الأرت التميمي عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","حديث خباب بن الأرت"
"7219","2 - (  7214  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ  قَالَ  :  عَادَ خَبَّابًا نَاسٌ مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالُوا :         [13/176]      أَبْشِرْ  أَبَا عَبْدِ اللهِ  تَرِدُ عَلَى  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْحَوْضَ ، فَقَالَ : كَيْفَ بِهَذَا - وَأَشَارَ إِلَى أَعْلَى الْبَيْتِ وَأَسْفَلِهِ - وَقَدْ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا يَكْفِي أَحَدَكُمْ مِنَ الدُّنْيَا كَزَادِ الرَّاكِبِ  .","","Musnad Abi Ya'la al-Mawsili 7214","","خباب بن الأرت التميمي عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث خباب بن الأرت"
"7220","3 - (  7215  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  أَيُّوبَ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  رَجُلٍ مِنْ عَبْدِ الْقَيْسِ كَانَ مَعَ الْخَوَارِجِ ، ثُمَّ فَارَقَهُمْ ، فَقَالَ :  دَخَلُوا قَرْيَةً ، فَخَرَجَ  عَبْدُ اللهِ بْنُ خَبَّابٍ  ذَعِرًا يَجُرُّ رِدَاءَهُ ،         [13/177]      فَقَالُوا : لَمْ  تُرَعْ  ، فَقَالَ : وَاللهِ لَقَدْ رُعْتُمُونِي ، قَالُوا : لَمْ  تُرَعْ  . قَالَ : وَاللهِ لَقَدْ رُعْتُمُونِي ، قَالُوا : أَنْتَ  عَبْدُ اللهِ بْنُ خَبَّابٍ صَاحِبُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : نَعَمْ ، قَالُوا : فَهَلْ  سَمِعْتَ مِنْ  أَبِيكَ  حَدِيثًا تُحَدِّثُنَا بِهِ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ ذَكَرَ فِتْنَةً :  الْقَاعِدُ فِيهَا خَيْرٌ مِنَ الْقَائِمِ  ، وَالْقَائِمُ فِيهَا خَيْرٌ مِنَ الْمَاشِي ، وَالْمَاشِي فِيهَا خَيْرٌ مِنَ السَّاعِي . قَالَ : "" فَإِنْ أَدْرَكَكَ ذَاكَ ، فَكُنْ عَبْدَ اللهِ الْمَقْتُولَ "" قَالَ  أَيُّوبُ  : وَلَا أَعْلَمُهُ إِلَّا قَالَ : وَلَا تَكُنْ عَبْدَ اللهِ الْقَاتِلَ "" ، قَالُوا : أَنْتَ سَمِعْتَ هَذَا مِنْ أَبِيكَ يُحَدِّثُ بِهِ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : نَعَمْ . قَالَ : فَقَدَّمُوهُ عَلَى ضَفَّةِ النَّهَرِ ، فَضَرَبُوا عُنُقَهُ ، فَسَالَ دَمًا كَأَنَّهُ شِرَاكُ نَعْلٍ مُنْدَفِرٍ ،  وَبَقَرُوا  أُمَّ وَلَدِهِ عَمَّا فِي بَطْنِهَا  .","","Musnad Abi Ya'la al-Mawsili 7215","","خباب بن الأرت التميمي عن عبد الله بن خباب بن الأرت التميمي عن رجل من عبد القيس عن حميد بن هلال العدوي عن أيوب السختياني عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","حديث خباب بن الأرت"
"7221","[13/178]      بَقِيَّةُ حَدِيثِ  زَيْدِ بْنِ أَرْقَمَ  1 - (  7216  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  سَمِعْتُ  دَاوُدَ الطُّفَاوِيَّ  يُحَدِّثُ ، عَنْ  أَبِي مُسْلِمٍ الْبَجَلِيِّ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ قَالَ :  كَانَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُو فِي دُبُرِ الصَّلَاةِ :  اللَّهُمَّ رَبَّنَا وَرَبَّ كُلِّ شَيْءٍ ، أَنَا شَهِيدٌ أَنَّ الْعِبَادَ كُلَّهُمْ إِخْوَةٌ  ، اللَّهُمَّ رَبَّنَا وَرَبَّ كُلِّ شَيْءٍ ، اجْعَلْنِي مُخْلِصًا لَكَ وَأَهْلِي فِي كُلِّ سَاعَةٍ مِنَ الدُّنْيَا وَالْآخِرَةِ ، ذَا  الْجَلَالِ  وَالْإِكْرَامِ ، وَاسْمَعْ         [13/179]      وَاسْتَجِبِ ، اللهُ أَكْبَرُ الْأَكْبَرُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ ، اللهُ أَكْبَرُ الْأَكْبَرُ ، حَسْبِيَ اللهُ وَنِعْمَ الْوَكِيلُ ، اللهُ أَكْبَرُ الْأَكْبَرُ  .","","Musnad Abi Ya'la al-Mawsili 7216","","زيد بن أرقم الأنصاري عن أبو مسلم البجلي عن داود بن راشد الطفاوي عن معتمر بن سليمان عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","بقية حديث زيد بن أرقم"
"7222","2 - (  7217  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  دَاوُدَ الْبَصْرِيِّ ،  عَنْ  أَبِي مُسْلِمٍ الْبَجَلِيِّ قَالَ :  سَمِعْتُ  زَيْدَ بْنَ أَرْقَمَ ، يَقُولُ :  أَدْرَكْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَدْعُو فِي دُبُرِ الصَّلَاةِ ، وَهُوَ يَقُولُ  : فَذَكَرَ مِثْلَهُ ، أَوْ نَحْوَهُ  .         [13/180]","","Musnad Abi Ya'la al-Mawsili 7217","","زيد بن أرقم الأنصاري عن أبو مسلم البجلي عن داود بن راشد الطفاوي عن جرير بن عبد الحميد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","بقية حديث زيد بن أرقم"
"7223","3 - (  7218  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  أَخْبَرَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْقَاسِمِ الشَّيْبَانِيِّ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ هَذِهِ  الْحُشُوشَ  مُحْتَضَرَةٌ ،  فَإِذَا أَرَادَ أَحَدُكُمْ أَنْ يَدْخُلَ الْخَلَاءَ ، فَلْيَقُلْ : أَعُوذُ بِاللهِ مِنَ  الْخُبُثِ  وَالْخَبَائِثِ  .","","Musnad Abi Ya'la al-Mawsili 7218","","زيد بن أرقم الأنصاري عن القاسم بن عوف الشيباني عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن بكر بن عثمان البرساني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","بقية حديث زيد بن أرقم"
"7224","[13/181]             [13/182]      4 - (  7219  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ، قَالَ :  سَمِعْتُ  النَّضْرَ بْنَ أَنَسٍ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ هَذِهِ  الْحُشُوشَ  ، فَذَكَرَ نَحْوَهُ  .","","Musnad Abi Ya'la al-Mawsili 7219","","زيد بن أرقم الأنصاري عن النضر بن أنس بن مالك الأنصاري عن قتادة بن دعامة عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","بقية حديث زيد بن أرقم"
"7225","5 - (  7220  ) -  حَدَّثَنَا  صَالِحُ بْنُ حَاتِمِ بْنِ وَرْدَانَ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  أَيُّوبُ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ،  عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ قَالَ :  قَدِمَتْ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَقْبِيَةٌ قَسَمَهَا بَيْنَ أَصْحَابِهِ ، فَقَالَ لِي أَبِي  مَخْرَمَةُ  : انْطَلِقْ بِنَا إِلَيْهِ ، لَعَلَّهُ أَنْ يُعْطِيَنَا مِنْهَا شَيْئًا . قَالَ : فَجَاءَ أَبِي إِلَى الْبَابِ ، فَقَالَ : هَاهُنَا هُوَ ، فَسَمِعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَوْتَهُ ، فَخَرَجَ مَعَهُ بِقَبَاءٍ قَالَ : فَكَأَنِّي أَنْظُرُ إِلَيْهِ يُرِي أَبِي مَحَاسِنَ الْقَبَاءِ وَهُوَ يَقُولُ :  خَبَأْتُ هَذَا لَكَ  ، قَالَ  أَبُو مُحَمَّدٍ صَالِحٌ  :  فَقُلْتُ  لِأَبِي :  مِنْ أَيِّ شَيْءٍ فَعَلَ هَذَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَخْرَمَةَ  ؟ فَقَالَ : كَانَ يَتَّقِي لِسَانَهُ  .","","Musnad Abi Ya'la al-Mawsili 7220","","المسور بن مخرمة عن ابن أبي مليكة عن أيوب السختياني عن حاتم بن وردان عن صالح بن حاتم بن وردان البصري عن أبو يعلى الموصلي","بقية حديث زيد بن أرقم"
"7226","[13/183]             [13/184]             [13/185]      حَدِيثُ  أَبِي مُوسَى الْأَشْعَرِيِّ  1 - (  7221  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ الْوَاسِطِيُّ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  إِسْمَاعِيلَ بْنِ حَمَّادِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،         [13/186]      عَنْ  عَبْدِ اللهِ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُعَلِّمُنَا خُطْبَةَ الْحَاجَةِ ، فَيَقُولُ :  إِنَّ الْحَمْدَ لِلهِ نَحْمَدُهُ وَنَسْتَعِينُهُ ، وَنَعُوذُ بِاللهِ مِنْ شُرُورِ أَنْفُسِنَا  ، وَمِنْ سَيِّئَاتِ أَعْمَالِنَا ، مَنْ يَهْدِهِ اللهُ فَلَا مُضِلَّ لَهُ ، وَمَنْ يُضْلِلْ فَلَا هَادِيَ لَهُ ، وَأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَحْدَهُ لَا شَرِيكَ لَهُ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ  .  قَالَ أَبُو عُبَيْدَةَ :  وَسَمِعْتُ  مِنْ أَبِي مُوسَى ، يَقُولُ : كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  فَإِنْ شِئْتَ أَنْ تَصِلَ خُطْبَتَكَ بِآيٍ مِنَ الْقُرْآنِ  ، تَقُولُ :         {      اتَّقُوا اللهَ حَقَّ تُقَاتِهِ وَلا تَمُوتُنَّ إِلا وَأَنْتُمْ مُسْلِمُونَ         }             {      وَاتَّقُوا اللهَ الَّذِي تَسَاءَلُونَ بِهِ وَالأَرْحَامَ إِنَّ اللهَ كَانَ عَلَيْكُمْ رَقِيبًا         }             {      اتَّقُوا اللهَ وَقُولُوا قَوْلا سَدِيدًا             *          يُصْلِحْ لَكُمْ أَعْمَالَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَمَنْ يُطِعِ اللهَ وَرَسُولَهُ فَقَدْ فَازَ فَوْزًا عَظِيمًا         }      أَمَّا بَعْدُ ثُمَّ تَكَلَّمُ حَاجَتَكَ  .         [13/187]","","Musnad Abi Ya'la al-Mawsili 7221","","أبو موسى الأشعري عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن إسماعيل بن حماد بن أبي سليمان عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7227","2 - (  7222  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرِو بْنِ زُهَيْرٍ الضَّبِّيُّ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ نُعَيْمٍ ،  عَنِ  الضَّحَّاكِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَرْزَبٍ الْأَشْعَرِيِّ ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَقَدَ  يَوْمَ حُنَيْنٍ  لِأَبِي عَامِرٍ الْأَشْعَرِيِّ  عَلَى خَيْلِ الطَّلَبِ ، فَلَمَّا انْهَزَمَتْ  هَوَازِنُ  ، طَلَبَهَا ، حَتَّى أَدْرَكَ  دُرَيْدَ بْنَ الصِّمَّةِ  ، فَأَسْرَعَ بِهِ         [13/188]      نَفَسُهُ ، فَقَتَلَ  ابْنُ دُرَيْدٍ  أَبَا عَامِرٍ  ، قَالَ  أَبُو مُوسَى  : فَشَدَدْتُ عَلَى  ابْنِ دُرَيْدٍ  فَقَتَلْتُهُ ، وَأَخَذْتُ اللِّوَاءَ ، وَانْصَرَفْتُ بِالنَّاسِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا رَأَى اللِّوَاءَ بِيَدِي قَالَ : ""  أَبَا مُوسَى  ، قُتِلَ  أَبُو عَامِرٍ  ؟ قُلْتُ : نَعَمْ يَا رَسُولَ اللهِ . قَالَ : فَرَفَعَ يَدَيْهِ يَدْعُو لَهُ ، يَقُولُ :  اللَّهُمَّ  أَبَا عَامِرٍ  اجْعَلْهُ فِي الْأَكْثَرِينَ يَوْمَ الْقِيَامَةِ  هَذَا أَوْ نَحْوَهُ  .         [13/189]","","Musnad Abi Ya'la al-Mawsili 7222","","أبو موسى الأشعري عن الضحاك بن عبد الرحمن بن عرزب الأردني عن عبد الله بن نعيم بن همام القيني عن يحيى بن عبد العزيز الأردني عن الوليد بن مسلم القرشي عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7228","3 - (  7223  ) -  حَدَّثَنَا  خَالِدُ بْنُ مِرْدَاسٍ ،  حَدَّثَنَا  الرَّبِيعُ بْنُ بَدْرٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         [13/190]      ""  اثْنَانِ فَمَا فَوْقَهُمَا جَمَاعَةٌ  .","","Musnad Abi Ya'la al-Mawsili 7223","","أبو موسى الأشعري عن عمرو بن جراد التميمي عن بدر بن عمرو بن جراد السعدى عن الربيع بن بدر عليلة عن خالد بن مرداس البغدادي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7229","4 - (  7224  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  يَزِيدُ ،  حَدَّثَنَا  سَعِيدٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  يُونُسَ بْنِ جُبَيْرٍ ،  عَنْ  حِطَّانَ بْنِ عَبْدِ اللهِ الرَّقَاشِيِّ  أَنَّ  أَبَا مُوسَى صَلَّى بِهِمْ صَلَاةً ، فَلَمَّا جَلَسُوا فِي آخِرِ         [13/191]      صَلَاتِهِمْ ، قَالَ رَجُلٌ مِنَ  الْقَوْمِ  :  أُقِرَّتِ  الصَّلَاةُ بِالْبِرِّ وَالزَّكَاةِ ؟ فَلَمَّا انْفَتَلَ  أَبُو مُوسَى  أَقْبَلَ عَلَى  الْقَوْمِ  ، فَقَالَ : أَيُّكُمُ الْقَائِلُ كَلِمَةَ كَذَا وَكَذَا ؟  فَأَرَمَّ  الْقَوْمُ  مَرَّتَيْنِ قَالَ : فَلَعَلَّكَ يَا  حِطَّانُ  قُلْتَهَا ؟ قَالَ : مَا قُلْتُهَا ، وَلَقَدْ خَشِيتُ أَنْ  تَبْكَعَنِي  بِهَا ، فَقَالَ رَجُلٌ مِنَ  الْقَوْمِ  : أَنَا قُلْتُهَا ، وَمَا أَرَدْتُ بِهَا إِلَّا الْخَيْرَ . فَقَالَ  أَبُو مُوسَى  : أَمَا تَعْلَمُونَ مَا تَقُولُونَ فِي صَلَاتِكُمْ ؟ إِنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَطَبَنَا فَبَيَّنَ لَنَا سُنَّتَنَا ، وَعَلَّمَنَا صَلَاتَنَا ، فَقَالَ :  إِذَا صَلَّيْتُمْ فَأَقِيمُوا صُفُوفَكُمْ ، ثُمَّ لِيَؤُمَّكُمْ أَحَدُكُمْ ، فَإِذَا كَبَّرَ الْإِمَامُ  ، فَكَبِّرُوا ، وَإِذَا قَالَ :         {      غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ         }      ، فَقُولُوا : آمِينَ يُجِبْكُمُ اللهُ ، فَإِذَا كَبَّرَ وَرَكَعَ ، فَكَبِّرُوا وَارْكَعُوا ، فَإِنَّ الْإِمَامَ يَرْكَعُ قَبْلَكُمْ ، وَيَرْفَعُ قَبْلَكُمْ ، فَقَالَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  فَتِلْكَ  بِتِلْكَ ، فَإِذَا قَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، فَقُولُوا : اللَّهُمَّ رَبَّنَا لَكَ الْحَمْدُ ، يَسْمَعِ اللهُ لَكُمْ ، فَإِنَّ اللهَ قَالَ عَلَى لِسَانِ نَبِيِّهِ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، فَإِذَا كَبَّرَ وَسَجَدَ فَكَبِّرُوا وَاسْجُدُوا ، فَإِنَّ الْإِمَامَ يَسْجُدُ قَبْلَكُمْ ، وَيَرْفَعُ قَبْلَكُمْ ، قَالَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  فَتِلْكَ  بِتِلْكَ ، حَتَّى إِذَا كَانَ عِنْدَ الْقَعْدَةِ فَلْيَكُنْ مِنْ أَوَّلِ قَوْلِ أَحَدِكُمُ :  التَّحِيَّاتُ  الصَّلَوَاتُ الطَّيِّبَاتُ لِلهِ ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ         [13/192]      اللهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ "" .         [13/193]      سَبْعُ كَلِمَاتٍ مِنْ  تَحِيَّةِ  الصَّلَاةِ  ،  قَالَ  سَعِيدٌ  : فَلَا أَدْرِي ، أَفِي قَوْلِ  أَبِي مُوسَى  كَانَ ذَلِكَ ، أَوْ شَيْءٍ كَانَ  قَتَادَةُ  يَقُولُهُ ، يَعْنِي بِقَوْلِهِ : سَبْعَ كَلِمَاتٍ  .","","Musnad Abi Ya'la al-Mawsili 7224","","أبو موسى الأشعري عن حطان بن عبد الله الرقاشي عن يونس بن جبير الباهلي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7230","5 - (  7225  ) -  حَدَّثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ الْحِمَّانِيُّ ،  حَدَّثَنَا  أَبُو بَكْرٍ النَّهْشَلِيُّ . قَالَ :  حَدَّثَنِي  أَبُو بَكْرِ بْنُ أَبِي مُوسَى ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا تُنْكَحُ الْمَرْأَةُ عَلَى عَمَّتِهَا  ، وَلَا عَلَى خَالَتِهَا  "" .         [13/194]","","Musnad Abi Ya'la al-Mawsili 7225","","أبو موسى الأشعري عن أبو بكر بن أبي موسى الأشعري عن أبو بكر النهشلي عن جبارة بن المغلس عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7231","6 - (  7226  ) -  حَدَّثَنَا  جُبَارَةُ ،  حَدَّثَنَا  أَبُو بَكْرٍ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  أُسَامَةَ بْنِ شَرِيكٍ ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  اللَّهُمَّ اجْعَلْ فَنَاءَ أُمَّتِي فِي الطَّعْنِ وَالطَّاعُونِ  ، قَالُوا : يَا رَسُولَ اللهِ ، قَدْ عَرَفْنَا الطَّعْنَ ، فَمَا الطَّاعُونُ ؟ قَالَ : ""  وَخْزُ         [13/195]      أَعْدَائِكُمْ مِنَ الْجِنِّ ، وَفِيهِ شَهَادَةٌ  .","","Musnad Abi Ya'la al-Mawsili 7226","","أبو موسى الأشعري عن أسامة بن شريك الذبياني عن زياد بن علاقة الثعلبي عن أبو بكر النهشلي عن جبارة بن المغلس عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7232","7 - (  7227  ) -  حَدَّثَنَا  بُنْدَارٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي بُرْدَةَ .         [13/196]      عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا نِكَاحَ إِلَّا بِوَلِيٍّ  .         [13/197]             [13/198]","","Musnad Abi Ya'la al-Mawsili 7227","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرحمن بن مهدي عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7233","8 - (  7228  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ قَالَ :  حَدَّثَنَا  عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ ،  عَنْ  إِيَادِ بْنِ لَقِيطٍ ،  عَنْ  قَرَظَةَ بْنِ حَسَّانَ قَالَ :  سَمِعْتُ  أَبَا مُوسَى فِي يَوْمِ جُمُعَةٍ عَلَى مِنْبَرِ  الْبَصْرَةِ  ، يَقُولُ : سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ السَّاعَةِ وَأَنَا شَاهِدٌ ، فَقَالَ :  لَا يَعْلَمُهَا إِلَّا اللهُ ، لَا يُجَلِّيهَا لِوَقْتِهَا إِلَّا هُوَ ، وَلَكِنْ سَأُحَدِّثُكُمْ بِمَشَارِيطِهَا  ، وَمَا بَيْنَ أَيْدِيهَا ، إِنَّ بَيْنَ يَدَيْهَا رَدْمًا مِنَ الْفِتَنِ ،         [13/199]      وَهَرْجًا  "" فَقِيلَ : وَمَا  الْهَرْجُ  يَا رَسُولَ اللهِ ؟ قَالَ : "" هُوَ بِلِسَانِ  الْحَبَشَةِ  : الْقَتْلُ ، وَأَنْ تَخِفَّ قُلُوبُ النَّاسِ ، وَأَنْ يُلْقَى بَيْنَهُمُ التَّنَاكُرُ ، فَلَا يَكَادُ أَحَدٌ يَعْرِفُ أَحَدًا ، وَيُرْفَعُ ذَوُو الْحِجَى ، وَتَبْقَى  رِجْرِجَةٌ  مِنَ النَّاسِ لَا تَعْرِفُ مَعْرُوفًا ، وَلَا تُنْكِرُ مُنْكَرًا  .         [13/200]","","Musnad Abi Ya'la al-Mawsili 7228","","أبو موسى الأشعري عن قرظة بن حسان عن إياد بن لقيط السدوسي عن عبد الغفار بن القاسم الأنصاري عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7234","9 - (  7229  ) -  حَدَّثَنَا  بُنْدَارٌ ،  حَدَّثَنَا  سَلْمُ بْنُ قُتَيْبَةَ ،  حَدَّثَنَا  يُونُسُ ،  سَمِعَ  أَبَا بُرْدَةَ ،  سَمِعَ  أَبَا مُوسَى  ، سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِذَا أَرَادَ الرَّجُلُ أَنْ يُزَوِّجَ ابْنَتَهُ فَلْيَسْتَأْذِنْهَا  .         [13/201]","","Musnad Abi Ya'la al-Mawsili 7229","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن يونس بن أبي إسحاق عن سلم بن قتيبة الشعيري عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7235","10 - (  7230  ) -  حَدَّثَنَا  بُنْدَارٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  حَدَّثَنَا  يُونُسُ ،  عَنْ  أَبِي بُرْدَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 7230","","أبو بردة بن أبي موسى الأشعري عن يونس بن أبي إسحاق عن عبد الله بن داود الخريبي عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7236","11 - (  7231  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي مُوسَى قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَقَدْ مَرَّ بِالصَّخْرَةِ مِنَ  الرَّوْحَاءِ  سَبْعُونَ نَبِيًّا  ، مِنْهُمْ  مُوسَى  نَبِيُّ اللهِ حُفَاةً عَلَيْهِمُ  الْعَبَاءُ  ، يَؤُمُّونَ  بَيْتَ اللهِ الْعَتِيقَ  .         [13/202]","","Musnad Abi Ya'la al-Mawsili 7231","","أبو موسى الأشعري عن أبان بن عبد الله الرقاشي عن يزيد بن أبان الرقاشي عن إبراهيم بن إسماعيل بن مجمع عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7237","12 - (  7232  ) -  حَدَّثَنِي  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ قَالَ :  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  طَلْحَةُ بْنُ يَحْيَى ،  حَدَّثَنِي  أَبُو بُرْدَةَ بْنُ أَبِي مُوسَى ،  عَنْ  أَبِيهِ  قَالَ :  خَرَجْنَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْبَحْرِ حَتَّى جِئْنَا  مَكَّةَ  وَإِخْوَتِي مَعِي  :  أَبُو عَامِرِ بْنُ قَيْسٍ  ،  وَأَبُو رُهْمِ بْنُ قَيْسٍ  ،  وَمُحَمَّدُ بْنُ قَيْسٍ  ، خَمْسُونَ مِنَ  الْأَشْعَرِيِّينَ  ، وَسِتَّةٌ مِنْ  عَكٍّ  ، ثُمَّ هَاجَرْنَا فِي الْبَحْرِ حَتَّى أَتَيْنَا  الْمَدِينَةَ  .         [13/203]      13 - (  7233  ) -  قَالَ  :  فَقَالَ  أَبُو بُرْدَةَ :  فَقَالَ  أَبُو مُوسَى : وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِنَّ لِلنَّاسِ هِجْرَةً وَاحِدَةً ، وَلَكُمْ هِجْرَتَانِ  .","","Musnad Abi Ya'la al-Mawsili 7232","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن طلحة بن يحيى بن طلحة التيمي عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7238","14 - (  7234  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  أَبُو بُرْدَةَ بْنُ عَبْدِ اللهِ بْنِ أَبِي بُرْدَةَ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ  الْهَرْجَ  قُلْنَا : وَمَا  الْهَرْجُ  ؟ قَالَ : "" الْقَتْلُ الْقَتْلُ ، حَتَّى يَقْتُلَ الرَّجُلُ جَارَهُ ، وَابْنَ عَمِّهِ ، وَأَبَاهُ "" قَالَ : فَرَأَيْنَا مَنْ قَتَلَ أَبَاهُ زَمَانَ  الْأَزَارِقَةِ  .         [13/204]","","Musnad Abi Ya'la al-Mawsili 7234","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7239","15 - (  7235  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  دَاوُدَ ،  عَنْ  عَبْدِ الْأَعْلَى النَّخَعِيِّ ،  عَنْ  أُمِّ عَبْدِ اللهِ ، قَالَتْ :  قَالَ لِي  أَبُو مُوسَى فِي مَرَضِهِ : أَلَا أُخْبِرُكِ بِمَنْ لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : قُلْتُ : بَلَى . قَالَ :  لَعَنَ مَنْ  حَلَقَ  ، أَوْ  سَلَقَ  ، أَوْ خَرَقَ  .         [13/205]             [13/206]","","Musnad Abi Ya'la al-Mawsili 7235","","أبو موسى الأشعري عن أم عبد الله امرأة أبي موسى الأشعري عن عبد الأعلى النخعي عن داود بن أبي هند عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7240","16 - (  7236  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  بُرَيْدٍ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ :  قَدِمْنَا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَمَا فُتِحَتْ  خَيْبَرُ  بِثَلَاثٍ ، فَأَسْهَمَ لَنَا  ، وَلَمْ يُسْهِمْ لِأَحَدٍ لَمْ يَشْهَدِ الْفَتْحَ غَيْرَنَا  .         [13/207]","","Musnad Abi Ya'la al-Mawsili 7236","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حفص بن غياث النخعي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7241","17 - (  7237  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي مُوسَى  أَظُنُّهُ  رَفَعَهُ  قَالَ :  مَثَلُ الْمُؤْمِنِ الَّذِي يَقْرَأُ الْقُرْآنَ مَثَلُ الْأُتْرُجَّةِ ، رِيحُهَا طَيِّبٌ ، وَطَعْمُهَا طَيِّبٌ  ، وَمَثَلُ الْمُؤْمِنِ الَّذِي لَا يَقْرَأُ الْقُرْآنَ مَثَلُ التَّمْرَةِ ، لَيْسَ لَهَا رِيحٌ ، وَطَعْمُهَا حُلْوٌ ، وَمَثَلُ الْمُنَافِقِ الَّذِي يَقْرَأُ الْقُرْآنَ مَثَلُ الرَّيْحَانَةِ ، رِيحُهَا طَيِّبٌ ، وَطَعْمُهَا مُرٌّ ، وَمَثَلُ الْمُنَافِقِ الَّذِي لَا يَقْرَأُ الْقُرْآنَ مَثَلُ الْحَنْظَلَةِ ، لَيْسَ لَهَا رِيحٌ ، وَطَعْمُهَا مُرٌّ  .         [13/208]             [13/209]","","Musnad Abi Ya'la al-Mawsili 7237","","أبو موسى الأشعري عن أنس بن مالك عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن خلف بن هشام البزار عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7242","18 - (  7238  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْهَرَوِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي بُرْدَةَ بْنِ أَبِي مُوسَى الْأَشْعَرِيِّ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أُعْطِيتُ فَوَاتِحَ الْكَلِمِ وَخَوَاتِمَهُ  ، قُلْنَا : يَا رَسُولَ اللهِ ! عَلِّمْنَا مِمَّا عَلَّمَكَ اللهُ - عَزَّ وَجَلَّ - ، فَعَلَّمَنَا  التَّشَهُّدَ  .         [13/210]","","Musnad Abi Ya'la al-Mawsili 7238","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن هشيم بن بشير عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7243","19 - (  7239  ) -  حَدَّثَنَا  خَالِدُ بْنُ مِرْدَاسٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنِ  الْأَجْلَحِ ، قَالَ :  حَدَّثَنِي  أَبُو بَكْرِ بْنُ أَبِي مُوسَى الْأَشْعَرِيُّ ، يَعْنِي ،  عَنْ  أَبِيهِ  قَالَ :  بَعَثَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  الْيَمَنِ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ! إِنَّ بِهَا أَشْرِبَةً ، فَمَا أَشْرَبُ مِنْهَا وَمَا أَدَعُ ؟  قَالَ : "" وَمَا هِيَ ؟ "" .  قُلْتُ :  الْبِتْعُ  وَالْمِزْرُ  .  قَالَ : "" وَمَا  الْبِتْعُ  وَالْمِزْرُ  ؟ "" .  قُلْتُ :  الْبِتْعُ  مِنَ الْعَسَلِ يَشْتَدُّ حَتَّى يُسْكِرَ ،  وَالْمِزْرُ  مِنَ الذُّرَةِ يَشْتَدُّ حَتَّى يُسْكِرَ .  قَالَ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَشْرَبْ مُسْكِرًا ، فَإِنِّي حَرَّمْتُ كُلَّ مُسْكِرٍ  .         [13/211]             [13/212]             [13/213]","","Musnad Abi Ya'la al-Mawsili 7239","","أبو موسى الأشعري عن أبو بكر بن أبي موسى الأشعري عن أجلح بن عبد الله الكندي عن عبد الله بن المبارك عن خالد بن مرداس البغدادي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7244","20 - (  7240  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ بْنِ مَيْسَرَةَ الْجُشَمِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  قُرَّةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  حُمَيْدُ بْنُ هِلَالٍ ،  حَدَّثَنَا  أَبُو بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ :  أَقْبَلْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَا وَرَجُلَانِ مِنَ  الْأَشْعَرِيِّينَ  :  أَحَدُهُمَا عَنْ يَمِينِي ، وَالْآخَرُ عَنْ يَسَارِي ، فَكِلَاهُمَا سَأَلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْعَمَلَ وَهُوَ يَسْتَاكُ ، فَقَالَ : "" مَا تَقُولُ  يَا  عَبْدَ اللهِ بْنَ قَيْسٍ  ، أَوْ يَا  أَبَا مُوسَى  ؟ "" قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا أَطْلَعَانِي عَلَى مَا فِي         [13/214]      أَنْفُسِهِمَا ، وَمَا شَعَرْتُ أَنَّهُمَا يَطْلُبَانِ الْعَمَلَ . قَالَ : فَكَأَنِّي أَنْظُرُ إِلَى سِوَاكِهِ وَهُوَ تَحْتَ شَفَتِهِ قَلَصَتْ ، ثُمَّ قَالَ :  يَا  أَبَا مُوسَى  إِنَّا  لَا ، أَوْ لَنْ  نَسْتَعْمِلَ عَلَى عَمَلِنَا مَنْ أَرَادَهُ  ، وَلَكِنِ اذْهَبْ أَنْتَ  يَا  عَبْدَ اللهِ بْنَ قَيْسٍ  ، أَوْ يَا  أَبَا مُوسَى  ، فَبَعَثَهُ عَلَى  الْيَمَنِ  ، ثُمَّ أَتْبَعَهُ  مُعَاذَ بْنَ جَبَلٍ  ، فَلَمَّا قَدِمَ عَلَيْهِ ، قَالَ لَهُ : انْزِلْ ، وَأَلْقَى لَهُ وِسَادَةً  .         [13/215]","","Musnad Abi Ya'la al-Mawsili 7240","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن حميد بن هلال العدوي عن قرة بن خالد السدوسي عن يحيى القطان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7245","21 - (  7241  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  قُرَّةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  سَيَّارٌ أَبُو الْحَكَمِ ،  عَنْ  أَبِي بُرْدَةَ ،         [13/216]      عَنْ  أَبِي مُوسَى  قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ! إِنَّ  أَهْلَ الْيَمَنِ  يَتَّخِذُونَ شَرَابًا  الْبِتْعَ  مِنَ الْعَسَلِ ،  وَالْمِزْرَ  مِنَ الذُّرَةِ وَالشَّعِيرِ قَالَ :  أَنْهَاكُمْ عَنْ كُلِّ مُسْكِرٍ  .","","Musnad Abi Ya'la al-Mawsili 7241","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن سيار بن أبي سيار العنزي عن قرة بن خالد السدوسي عن يحيى القطان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7246","22 - (  7242  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْخَطَّابِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ  قَالَ :  دَخَلَتِ  امْرَأَةُ ابْنِ مَظْعُونٍ  عَلَى نِسَاءِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَيْنَهَا سَيِّئَةَ الْهَيْئَةِ ، فَقُلْنَ لَهَا : مَا لَكِ ؟ مَا فِي  قُرَيْشٍ  رَجُلٌ أَغْنَى مِنْ  بَعْلِكِ  ؟ قَالَتْ : مَا كُنَّا مِنْهُ مِنْ شَيْءٍ : أَمَّا نَهَارُهُ فَصَائِمٌ ، وَأَمَّا لَيْلُهُ فَقَائِمٌ قَالَ : فَدَخَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرْنَ ذَلِكَ لَهُ . قَالَ : فَلَقِيَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا  عُثْمَانُ  ، أَمَا لَكَ بِي أُسْوَةٌ ؟  قَالَ : وَمَا ذَاكَ يَا رَسُولَ اللهِ ! فِدَاكَ أَبِي وَأُمِّي ؟ قَالَ : "" أَمَّا أَنْتَ فَتَقُومُ بِاللَّيْلِ وَتَصُومُ بِالنَّهَارِ ، وَإِنَّ لِأَهْلِكَ عَلَيْكَ حَقًّا ، وَإِنَّ لِجَسَدِكَ حَقًّا ، فَصَلِّ وَنَمْ ، وَصُمْ وَأَفْطِرْ "" قَالَ : فَأَتَتْهُمُ الْمَرْأَةُ بَعْدَ ذَلِكَ عَطِرَةً كَأَنَّهَا عَرُوسٌ ، فَقُلْنَ لَهَا :  مَهْ  ؟ قَالَتْ : أَصَابَنَا مَا أَصَابَ النَّاسَ  .         [13/217]","","Musnad Abi Ya'la al-Mawsili 7242","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن أبو جابر محمد بن عبد الملك الأزدي عن محمد بن الخطاب البلدي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7247","23 - (  7243  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي بَكْرٍ .  عَنْ  أَبِيهِ أَبِي مُوسَى  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَوْ أَنَّ حَجَرًا قُذِفَ بِهِ فِي  جَهَنَّمَ  لَهَوَى سَبْعِينَ  خَرِيفًا  قَبْلَ أَنْ يَبْلُغَ قَعْرَهَا  .         [13/218]","","Musnad Abi Ya'la al-Mawsili 7243","","أبو موسى الأشعري عن أبو بكر بن أبي موسى الأشعري عن عطاء بن السائب عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7248","24 - (  7244  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُسَمِّي لَنَا نَفْسَهُ أَسْمَاءً ، فَقَالَ :  أَنَا  مُحَمَّدٌ  ،  وَأَحْمَدُ  ،  وَالْمُقَفِّي  ،  وَالْحَاشِرُ  ،  وَنَبِيُّ الرَّحْمَةِ  ،  وَنَبِيُّ الْمَلْحَمَةِ  .         [13/219]","","Musnad Abi Ya'la al-Mawsili 7244","","أبو موسى الأشعري عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن الأعمش عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7249","25 - (  7245  ) -  حَدَّثَنَا  بُنْدَارٌ ،  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  مُرَّةَ  ،  عَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  كَمُلَ مِنَ الرِّجَالِ كَثِيرٌ ، وَلَمْ يَكْمُلْ مِنَ النِّسَاءِ إِلَّا  مَرْيَمُ بِنْتُ عِمْرَانَ  ،  وَآسِيَةُ         [13/220]      امْرَأَةُ فِرْعَوْنَ  ، وَفَضْلُ  عَائِشَةَ  عَلَى النِّسَاءِ كَفَضْلِ  الثَّرِيدِ  عَلَى  سَائِرِ  الطَّعَامِ  .         [13/221]","","Musnad Abi Ya'la al-Mawsili 7245","","أبو موسى الأشعري عن مرة بن شراحيل عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7250","26 - (  7246  ) -  حَدَّثَنَا  أَبُو عَبْدِ اللهِ مُحَمَّدُ بْنُ إِبْرَاهِيمَ الشَّامِيُّ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُلَيْمَانَ ،  عَنْ  حَرْبِ بْنِ سُرَيْجٍ ،  عَنْ  حَمَّادِ بْنِ أَبِي سُلَيْمَانَ قَالَ : تَعَشَّيْتُ مَعَ  أَبِي بُرْدَةَ ،  فَقَالَ  : أَلَا أُحَدِّثُكَ مَا  حَدَّثَنِي بِهِ  أَبِي عَبْدُ اللهِ بْنُ قَيْسٍ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ أَكَلَ فَشَبِعَ ، وَشَرِبَ فَرَوِيَ ، فَقَالَ : الْحَمْدُ لِلهِ الَّذِي أَطْعَمَنِي وَأَشْبَعَنِي  ، وَسَقَانِي وَأَرْوَانِي ، خَرَجَ مِنْ ذُنُوبِهِ كَيَوْمِ وَلَدَتْهُ أُمُّهُ  .         [13/222]","","Musnad Abi Ya'la al-Mawsili 7246","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن حماد بن أبي سليمان عن حرب بن سريج المنقري عن إبراهيم بن سليمان أبو إسماعيل عن محمد بن إبراهيم بن العلاء السائح عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7251","27 - (  7247  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ قَالَ :  حَدَّثَ  أَبُو مُوسَى - وَهُوَ بِالدَّيْرِ مِنْ  أَصْبَهَانَ  - قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ  الْهَرْجَ  . قَالَ : فَقُلْنَا : وَمَا  الْهَرْجُ  ؟ قَالَ : فَقَالَ : "" الْقَتْلُ "" قَالَ : فَقُلْنَا : وَاللهِ إِنَّا لَنَقْتُلُ فِي الْعَامِ الْوَاحِدِ أَكْثَرَ مِنْ سَبْعِينَ أَلْفًا مِنَ الْمُشْرِكِينَ . قَالَ : فَقَالَ : "" وَاللهِ مَا هُوَ بِقَتْلِكُمُ الْمُشْرِكِينَ ، وَلَكِنَّهُ قَتْلُ بَعْضِكُمْ بَعْضًا "" . قَالَ : فَقُلْنَا : وَفِينَا كِتَابُ اللهِ - عَزَّ وَجَلَّ - ، وَمَعَنَا عُقُولُنَا ؟ قَالَ : "" وَفِيكُمْ كِتَابُ اللهِ "" . قَالَ : إِنَّكُمْ لَتَرَوُنَّ أَنَّ مَعَكُمْ عُقُولَكُمْ غَيْرَ أَنَّهُ تُنْزَعُ عُقُولُ أَكْثَرِ أَهْلِ ذَلِكَ الزَّمَانِ ، وَيَرَوْنَ أَنَّهُمْ عَلَى شَيْءٍ وَلَيْسُوا عَلَى شَيْءٍ ، وَيَخْلُفُ لَهُ هَبَاءٌ مِنَ النَّاسِ يَرَوْنَ أَنَّهُمْ فِي شَيْءٍ ، وَلَيْسُوا فِي شَيْءٍ "" قَالَ : فَقُلْنَا : مَا الْمَنْجَى مِنْ ذَلِكَ ؟ قَالَ : مَا أَجِدُ لِي وَلَكُمْ مِنْهَا مَنْجًى - إِنْ هِيَ أَدْرَكَتْنَا -         [13/223]      فِيمَا عَهِدَ إِلَيْنَا نَبِيُّنَا عَلَيْهِ السَّلَامُ إِلَّا أَنْ نَخْرُجَ مِنْهَا كَيَوْمَ دَخَلْنَاهَا  .","","Musnad Abi Ya'la al-Mawsili 7247","","أبو موسى الأشعري عن الحسن البصري عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن عبد الواحد بن غياث عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7252","28 - (  7248  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ الْبَصْرِيُّ ،  حَدَّثَنَا  مُعْتَمِرٌ قَالَ :  قَرَأْتُ عَلَى  فُضَيْلٍ ،  عَنْ  أَبِي حَرِيزٍ ،  عَنْ  أَبِي بُرْدَةَ ،         [13/224]      عَنْ  أَبِي مُوسَى  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا يَدْخُلُ الْجَنَّةَ  مُدْمِنُ  خَمْرٍ  ، وَلَا مُؤْمِنٌ بِسِحْرٍ ، وَلَا قَاطِعٌ ، وَمَنْ مَاتَ وَهُوَ يَشْرَبُ الْخَمْرَ ، سَقَاهُ اللهُ مِنَ الْغُوطَةِ ، وَهُوَ مَاءٌ يَسِيلُ مِنْ  فُرُوجِ  الْمُومِسَاتِ  يُؤْذِي رِيحُهُ مَنْ فِي النَّارِ  .         [13/225]","","Musnad Abi Ya'la al-Mawsili 7248","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن معتمر بن سليمان عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7253","29 - (  7249  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  الْأَزْهَرُ بْنُ سِنَانٍ الْقُرَشِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ وَاسِعٍ الْأَزْدِيُّ قَالَ : دَخَلْتُ عَلَى  بِلَالِ بْنِ أَبِي بُرْدَةَ  ، فَقُلْتُ لَهُ : يَا  بِلَالُ  ، إِنَّ  أَبَاكَ  حَدَّثَنِي  ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ فِي  جَهَنَّمَ  وَادِيًا يُقَالُ لَهُ :  هَبْهَبُ ،  حَقًّا عَلَى اللهِ أَنْ يُسْكِنَهُ كُلَّ جَبَّارٍ  ، فَإِيَّاكَ يَا  بِلَالُ  أَنْ تَكُونَ مِمَّنْ يَسْكُنُهُ  .         [13/226]","","Musnad Abi Ya'la al-Mawsili 7249","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن محمد بن واسع بن جابر عن أزهر بن سنان البصري عن يزيد بن هارون عن مجاهد بن موسى عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7254","30 - (  7250  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ ،  عَنْ  طَلِيقِ بْنِ عِمْرَانَ بْنِ حُصَيْنِ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى .  قَالَ :  لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَنْ فَرَّقَ بَيْنَ وَالِدٍ وَوَلَدِهِ  ، وَبَيْنَ الْأَخِ وَأَخِيهِ  .         [13/227]             [13/228]","","Musnad Abi Ya'la al-Mawsili 7250","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن طليق بن عمران الخزاعي عن إبراهيم بن إسماعيل بن مجمع عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7255","31 - (  7251  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  غَيْلَانَ بْنِ جَرِيرٍ ،  عَنْ  أَبِي بُرْدَةَ ،         [13/229]      عَنْ  أَبِي مُوسَى  قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي رَهْطٍ مِنَ  الْأَشْعَرِيِّينَ  نَسْتَحْمِلُهُ ، فَقَالَ :  وَاللهِ لَا أَحْمِلُكُمْ ، وَمَا عِنْدِي مَا أَحْمِلُكُمْ عَلَيْهِ  . قَالَ : فَلَبِثْنَا مَا شَاءَ اللهُ ، ثُمَّ أُتِيَ بِإِبِلٍ ، فَأَمَرَ لَنَا بِثَلَاثَةِ ذَوْدٍ غُرِّ الذُّرَى . قَالَ : فَلَمَّا انْطَلَقْنَا  قُلْنَا - أَوْ قَالَ بَعْضُنَا لِبَعْضٍ  - : لَا يُبَارِكُ اللهُ لَنَا ، أَتَيْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَسْتَحْمِلُهُ ، فَحَلَفَ أَلَّا يَحْمِلَنَا ، ثُمَّ حَمَلَنَا ، ائْتُوهُ فَأَخْبِرُوهُ ، فَقَالَ : "" مَا أَنَا  حَمَلْتُكُمْ  ، وَلَكِنَّ اللهَ حَمَلَكُمْ ، إِنِّي وَاللهِ إِنْ شَاءَ اللهُ لَا أَحْلِفُ عَلَى يَمِينٍ فَأَرَى غَيْرَهَا خَيْرًا مِنْهَا إِلَّا كَفَّرْتُ عَنْ يَمِينِي ، وَأَتَيْتُ الَّذِي هُوَ خَيْرٌ  .         [13/230]             [13/231]","","Musnad Abi Ya'la al-Mawsili 7251","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن غيلان بن جرير المعولي عن حماد بن زيد عن خلف بن هشام البزار عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7256","32 - (  7252  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أَبِي مُوسَى قَالَ :  كُنَّا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ ، فَكَانَ  الْقَوْمُ  إِذَا عَلَوْا شَرَفًا كَبَّرُوا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّهَا النَّاسُ : ارْبَعُوا عَلَى أَنْفُسِكُمْ ، فَإِنَّكُمْ لَا تَدْعُونَ أَصَمَّ وَلَا غَائِبًا  ، وَلَكِنَّكُمْ تَدْعُونَ سَمِيعًا قَرِيبًا "" .  قَالَ : وَأَتَى عَلَيَّ وَأَنَا أَقُولُ : لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ . قَالَ : "" بَلَى يَا  عَبْدَ اللهِ  ، أَلَا أَدُلُّكَ عَلَى  كَنْزٍ  مِنْ كُنُوزِ الْجَنَّةِ ؟ لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ  .         [13/232]             [13/233]             [13/234]","","Musnad Abi Ya'la al-Mawsili 7252","","أبو موسى الأشعري عن أبو عثمان النهدي عن أيوب السختياني عن حماد بن زيد عن خلف بن هشام البزار عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7257","33 - (  7253  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ قَالَ :  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ! الرَّجُلُ يُقَاتِلُ شَجَاعَةً ، وَيُقَاتِلُ حَمِيَّةً ، وَيُقَاتِلُ رِيَاءً ، أَيُّ ذَلِكَ يَكُونُ فِي  سَبِيلِ  اللهِ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ قَاتَلَ لِتَكُونَ كَلِمَةُ اللهِ هِيَ الْعُلْيَا فَهُوَ فِي  سَبِيلِ  اللهِ - عَزَّ وَجَلَّ  -  "" .         [13/235]             [13/236]","","Musnad Abi Ya'la al-Mawsili 7253","","أبو موسى الأشعري عن شقيق بن سلمة عن الأعمش عن علي بن مسهر القرشي عن محرز بن عون الهلالي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7258","34 - (  7254  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ مُحَمَّدُ بْنُ يَزِيدَ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  يُونُسَ بْنِ عَمْرٍو ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ :  أَتَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَعْرَابِيًّا  فَأَكْرَمَهُ ، فَقَالَ لَهُ : "" ائْتِنَا "" ، فَأَتَاهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" سَلْ حَاجَتَكَ "" ، فَقَالَ : نَاقَةً نَرْكَبُهَا ، وَأَعْنُزًا يَحْلُبُهَا أَهْلِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  عَجَزْتُمْ أَنْ تَكُونُوا مِثْلَ عَجُوزِ  بَنِي إِسْرَائِيلَ  ؟  .  قَالَ : إِنَّ  مُوسَى  لَمَّا سَارَ  بِبَنِي إِسْرَائِيلَ  مِنْ  مِصْرَ  ضَلُّوا الطَّرِيقَ ، فَقَالَ : مَا هَذَا ؟ فَقَالَ عُلَمَاؤُهُمْ : إِنَّ  يُوسُفَ  لَمَّا حَضَرَهُ الْمَوْتُ أَخَذَ عَلَيْنَا مَوْثِقًا مِنَ اللهِ أَنْ لَا نَخْرُجَ مِنْ  مِصْرَ  حَتَّى نَنْقُلَ عِظَامَهُ مَعَنَا . قَالَ : فَمَنْ يَعْلَمُ مَوْضِعَ قَبْرِهِ ؟ قَالَ : عَجُوزٌ مِنْ  بَنِي إِسْرَائِيلَ  ، فَبَعَثَ إِلَيْهَا فَأَتَتْهُ ، فَقَالَ : دُلِّينِي عَلَى قَبْرِ  يُوسُفَ  ، قَالَتْ : حَتَّى تُعْطِيَنِي حُكْمِي . قَالَ : مَا حُكْمُكِ ؟ قَالَتْ : أَكُونُ مَعَكَ فِي الْجَنَّةِ ، فَكَرِهَ أَنْ يُعْطِيَهَا ذَلِكَ ، فَأَوْحَى اللهُ إِلَيْهِ أَنْ أَعْطِهَا حُكْمَهَا ، فَانْطَلَقَتْ بِهِمْ إِلَى بُحَيْرَةٍ : مَوْضِعِ مُسْتَنْقَعِ مَاءٍ ، فَقَالَتْ : أَنْضِبُوا هَذَا الْمَاءَ ، فَأَنْضَبُوا ، قَالَتِ : احْتَفِرُوا         [13/237]      وَاسْتَخْرِجُوا عِظَامَ  يُوسُفَ  ، فَلَمَّا أَقَلُّوهَا إِلَى الْأَرْضِ إِذَا الطَّرِيقُ مِثْلُ ضَوْءِ النَّهَارِ  .","","Musnad Abi Ya'la al-Mawsili 7254","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن يونس بن أبي إسحاق عن محمد بن فضيل بن غزوان عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7259","35 - (  7255  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمِقْدَامِ الْعِجْلِيُّ ،  حَدَّثَنَا  حَزْمٌ ، قَالَ :  سَمِعْتُ  الْحَسَنَ  يُحَدِّثُ ، عَنْ  أَبِي مُوسَى ،  يَرْفَعُهُ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ  الْهَرْجَ  ، قَالُوا : وَمَا  الْهَرْجُ  يَا رَسُولَ اللهِ ؟ قَالَ : "" الْقَتْلُ "" ، قَالُوا : أَوَمَا يَكْفِي مَا نَقْتُلُ كُلَّ عَامٍ مِائَةَ أَلْفٍ مِنَ الْمُشْرِكِينَ ؟ قَالَ : "" لَيْسَ ذَاكَ ، وَلَكِنْ قَتْلُ أَنْفُسِكُمْ "" ، قَالُوا : وَمَعَنَا عُقُولُنَا ؟ قَالَ : إِنَّهُ يَخْتَلِسُ عُقُولَ أَهْلِ ذَلِكَ الزَّمَانِ ، وَسَيُؤَخَّرُ لَهَا هَبَاءٌ مِنَ النَّاسِ يَرَوْنَ أَنَّهُمْ عَلَى شَيْءٍ ، وَلَيْسُوا عَلَى شَيْءٍ ، قَالَ  أَبُو مُوسَى  : مَا أُرَاهَا إِلَّا مُدْرِكَتِي وَإِيَّاكُمْ ، فَمَا أَعْلَمُ         [13/238]      الْمَخْرَجَ مِنْهَا فِيمَا عَهِدَ إِلَيْنَا إِلَّا أَنْ نَخْرُجَ مِنْهَا كَيَوْمَ دَخَلْنَا فِيهَا  .","","Musnad Abi Ya'la al-Mawsili 7255","","أبو موسى الأشعري عن الحسن البصري عن حزم بن أبي حزم القطعي عن أحمد بن المقدام العجلي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7260","36 - (  7256  ) -  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْعَلَّافُ ،  حَدَّثَنَا  عَبْدَةُ ،  حَدَّثَنَا  صَالِحُ بْنُ صَالِحِ بْنِ حَيٍّ الْهَمْدَانِيُّ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ كَانَتْ لَهُ جَارِيَةٌ فَأَدَّبَهَا ، فَأَحْسَنَ أَدَبَهَا ، وَعَلَّمَهَا فَأَحْسَنَ تَعْلِيمَهَا ، ثُمَّ أَعْتَقَهَا وَتَزَوَّجَهَا ، فَلَهُ أَجْرَانِ  ، وَأَيُّمَا رَجُلٍ مِنْ  أَهْلِ الْكِتَابِ  آمَنَ بِنَبِيِّهِ ، وَآمَنَ  بِمُحَمَّدٍ  فَلَهُ أَجْرَانِ ، وَأَيُّمَا عَبْدٍ أَدَّى حَقَّ اللهِ ، وَحَقَّ مَوَالِيهِ فَلَهُ أَجْرَانِ         [13/239]             [13/240]      قَالَ  صَالِحٌ  : قَالَ لِيَ  الشَّعْبِيُّ  : أَعْطَيْتُكَهَا بِغَيْرِ شَيْءٍ ، وَإِنْ كَانَ الرَّاكِبُ لَيَرْكَبُ فِي دُونِهَا إِلَى  الْمَدِينَةِ  .","","Musnad Abi Ya'la al-Mawsili 7256","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن الشعبي عن صالح بن صالح بن حي الثوري عن عبدة بن سليمان الكلابي عن عبد الله بن عبد الرحمن العلاف عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7261","37 - (  7257  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  يَحْيَى بْنُ بُرَيْدٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ :  قَدِمَ عَلَى  عُمَرَ  ، فَقَامَ عَلَى بَابِهِ ، فَقَالَ :         [13/241]      السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، أَيُؤْذَنُ  لِأَبِي مُوسَى  - أَوْ  لِعَبْدِ اللهِ بْنِ قَيْسٍ  ؟ ثَلَاثًا ، فَلَمْ يُكَلَّمْ ، فَانْصَرَفَ ، فَخَرَجَ  عُمَرُ  ، فَقَالَ : أَيْنَ  أَبُو مُوسَى  ؟ قَالُوا : انْصَرَفَ ، فَبَعَثَ فِي أَثَرِهِ ، فَلَمَّا أَنْ جَاءَ قَالَ : مَا صَرَفَكَ ؟ قَالَ : اسْتَأْذَنْتُ ثَلَاثًا ، فَلَمْ يُؤْذَنْ لِي ، فَانْصَرَفْتُ ، وَسَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنِ اسْتَأْذَنَ ثَلَاثًا فَلَمْ يُؤْذَنْ لَهُ ، فَلْيَنْصَرِفْ  قَالَ : ائْتِنِي مَعَكَ بِمَنْ سَمِعَ هَذَا مِنْهُ قَالَ : فَأَتَى  الْأَنْصَارَ  ، فَأَخْبَرَهُمْ قَالَ : فَكُلُّهُمْ يَقُولُ : قَدْ سَمِعْنَا ، فَقَالَ : لِيَقُمْ مَعِي بَعْضُكُمْ ، فَقَامَ مَعَهُ بَعْضُهُمْ ، فَأَتَى  عُمَرَ  ، فَأَخْبَرَهُمْ  .         [13/242]","","Musnad Abi Ya'la al-Mawsili 7257","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن يحيى بن بريد الأشعري عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7262","38 - (  7258  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  أَتَانِي نَاسٌ مِنْ قَوْمِي ، فَقَالُوا : اسْتَحْمِلْ لَنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَحْمِلُ عَلَى إِبِلٍ . قَالَ : فَأَتَيْنَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاسْتَحْمَلْنَاهُ ، قَالَ : فَحَلَفَ : وَاللهِ لَا أَحْمِلُكُمْ "" ، فَانْصَرَفْنَا وَقَدْ شَقَّ ذَلِكَ عَلَيْنَا . قَالَ : فَمَكَثْنَا أَيَّامًا ، وَأُتِيَ بِإِبِلٍ ، قَالَ : فَقَالَ : خُذْ هَذَيْنِ  الْقَرِينَيْنِ  ، خُذْ هَذَيْنِ  الْقَرِينَيْنِ  "" ثَلَاثًا سِتَّةَ أَحْمَالٍ ، فَقُلْتُ لِأَصْحَابِي : إِنَّهُ قَدْ حَلَفَ أَنْ لَا يَحْمِلَنَا ، وَلَا أُرَاهُ إِلَّا قَدْ نَسِيَ ، فَإِنْ أَخَذْنَاهَا لَمْ يُبَارَكْ لَنَا فِيهَا ، فَقُلْنَا : يَا رَسُولَ اللهِ ، لَقَدْ كُنْتَ حَلَفْتَ ثَلَاثًا أَنْ لَا تَحْمِلَنَا ؟ فَقَالَ : "" وَأَنَا أَحْلِفُ السَّاعَةَ ، وَاللهِ لَأَحْمِلَنَّكُمْ ، فَحَلَفَ ثَلَاثًا ، ثُمَّ قَالَ :  مَنْ حَلَفَ عَلَى يَمِينٍ ، فَرَأَى مَا هُوَ خَيْرٌ مِنْهَا ، فَلْيَأْتِ الَّذِي هُوَ خَيْرٌ ، وَلْيُكَفِّرْ عَنْ يَمِينِهِ  .","","Musnad Abi Ya'la al-Mawsili 7258","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن يحيى بن بريد الأشعري عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7263","39 - (  7259  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  مُوسَى بْنِ سُلَيْمَانَ ،  عَنِ  الْقَاسِمِ بْنِ مُخَيْمِرَةَ ،  عَنْ  أَبِي مُوسَى قَالَ :  تَحَيَّنْتُ  فِطْرَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَيْتُهُ بِنَبِيذِ  جَرٍّ  ، فَلَمَّا أَدْنَاهُ إِلَى فِيهِ إِذَا هُوَ  يَنِشُّ  ، فَقَالَ :  اضْرِبْ بِهَذَا         [13/243]      الْحَائِطَ ، فَإِنَّ هَذَا شَرَابُ مَنْ لَا يُؤْمِنُ بِاللهِ ، وَلَا بِالْيَوْمِ الْآخِرِ  "" .","","Musnad Abi Ya'la al-Mawsili 7259","","أبو موسى الأشعري عن القاسم بن مخيمرة عن موسى بن سليمان بن موسى الدمشقي عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن مجاهد بن موسى عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7264","40 - (  7260  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  الْوَلِيدُ ،  عَنْ  صَدَقَةَ أَبِي مُعَاوِيَةَ ،  عَنْ  زَيْدِ بْنِ وَاقِدٍ ،  عَنْ  خَالِدِ بْنِ عَبْدِ اللهِ  أَنَّهُ سَمِعَ  أَبَا هُرَيْرَةَ يُخْبِرُ أَنَّهُ  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَبِيذِ  جَرٍّ  ، فَقَالَ لَهُ مِثْلَ هَذَا  .         [13/244]","","Musnad Abi Ya'la al-Mawsili 7260","","أبو هريرة الدوسي عن خالد بن عبد الله بن حسين الأموي عن زيد بن واقد القرشي عن صدقة بن عبد الله السمين عن الوليد بن مسلم القرشي عن مجاهد بن موسى عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7265","41 - (  7261  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  يَحْيَى بْنُ بُرَيْدٍ . قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَيْسَ مِنَّا مَنْ  حَمَلَ  عَلَيْنَا السِّلَاحَ  .         [13/245]","","Musnad Abi Ya'la al-Mawsili 7261","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن يحيى بن بريد الأشعري عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7266","42 - (  7262  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْمَسْعُودِيِّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ اللهَ لَا يَنَامُ ، وَلَا يَنْبَغِي لَهُ أَنْ يَنَامَ  ،  يَخْفِضُ  الْقِسْطَ ،  وَيَرْفَعُهُ ، حِجَابُهُ النُّورُ ، لَوْ كَشَفَهَا لَأَحْرَقَتْ  سُبُحَاتُ  وَجْهِهِ كُلَّ شَيْءٍ أَدْرَكَهُ بَصَرُهُ مِنْ خَلْقِهِ  ثُمَّ قَرَأَ  أَبُو عُبَيْدَةَ  :         {      نُودِيَ أَنْ بُورِكَ مَنْ فِي النَّارِ وَمَنْ حَوْلَهَا وَسُبْحَانَ اللهِ رَبِّ الْعَالَمِينَ         }      .         [13/246]","","Musnad Abi Ya'la al-Mawsili 7262","","أبو موسى الأشعري عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7267","43 - (  7263  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  أَبِي مُوسَى  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِهِ إِلَّا أَنَّهُ لَمْ يَذْكُرْ : وَقَرَأَ  أَبُو عُبَيْدَةَ  .         [13/247]","","Musnad Abi Ya'la al-Mawsili 7263","","أبو موسى الأشعري عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن الأعمش عن أبو معاوية الضرير عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7268","44 - (  7264  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  بُرَيْدٍ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْمُؤْمِنُ يَأْكُلُ فِي  مِعًى  وَاحِدٍ  ، وَالْكَافِرُ يَأْكُلُ فِي سَبْعَةِ أَمْعَاءٍ  .         [13/248]","","Musnad Abi Ya'la al-Mawsili 7264","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7269","45 - (  7265  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  أَبُو جَمْرَةَ الضُّبَعِيُّ ،  عَنْ  أَبِي بَكْرٍ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ صَلَّى  الْبَرْدَيْنِ  دَخَلَ الْجَنَّةَ  .         [13/249]             [13/250]","","Musnad Abi Ya'la al-Mawsili 7265","","أبو موسى الأشعري عن أبو بكر بن أبي موسى الأشعري عن نصر بن عمران بن عصام الضبعي عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7270","46 - (  7266  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ :  يَا بُنَيَّ لَوْ رَأَيْتَنَا وَنَحْنُ مَعَ نَبِيِّنَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - وَأَصَابَتْنَا السَّمَاءُ لَحَسِبْتَ أَنَّ رِيحَنَا رِيحُ الضَّأْنِ  .","","Musnad Abi Ya'la al-Mawsili 7266","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن عبد الواحد بن غياث عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7271","47 - (  7267  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  يَحْيَى بْنُ بُرَيْدٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَعِيدٍ ،  عَنْ  أَبِيهِ سَعِيدِ بْنِ أَبِي بُرْدَةَ ،         [13/251]      عَنْ  أَبِي بُرْدَةَ  قَالَ :  وَفَدَ  إِلَى  عُمَرَ  - أَوْ إِلَى  سُلَيْمَانَ  - قَالَ : فَقَضَى حَوَائِجَهُ ، حَتَّى إِذَا كَانَ فِي بَعْضِ اللَّيْلِ  قَالَ : قُمْ ، قَالَ : فَقُمْتُ ، فَانْطَلَقَ إِلَى بَابِ الْوَالِي فَدَقَّهُ . قَالَ : فَقَالَ الْحَاجِبُ : مَنْ هَذَا ؟ قَالَ  أَبُو بُرْدَةَ  : اسْتَأْذِنْ لِي عَلَيْهِ . قَالَ : فَدَخَلَ ، قَالَ : أَعْلِمْهُ مَكَانِي ، فَأَعَلَمَهُ ، فَخَرَجَ إِلَيْهِ ، فَأَذِنَ لَهُ . قَالَ : خَيْرٌ يَا  أَبَا بُرْدَةَ  ؟ قَالَ : خَيْرٌ . قَالَ : حَاجَتَكَ ؟ قَالَ : قَدْ فَرَغْتُ مِنْ حَوَائِجِي ، ذَكَرْتُ حَدِيثًا :  48 - (  7268  ) -  حَدَّثَنِي  أَبِي قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِذَا جَمَعَ اللهُ الْخَلَائِقَ لِلْحِسَابِ  ، أُتِيَ بِيَهُودِيٍّ ، أَوْ نَصْرَانِيٍّ ، قِيلَ : يَا مُؤْمِنُ ، هَذَا فِدَاؤُكَ مِنَ النَّارِ "" قَالَ : أَنْتَ سَمِعْتَهُ ؟ قَالَ : سَمِعْتُهُ مِنْ أَبِي  .         [13/252]             [13/253]","","Musnad Abi Ya'la al-Mawsili 7267","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن سعيد بن أبي بردة الأشعري عن عبد الرحمن بن سعيد بن أبي بردة عن يحيى بن بريد الأشعري عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7272","49 - (  7269  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ الْهَمْدَانِيِّ ،  عَنْ  مُرَّةَ ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  كَمُلَ مِنَ الرِّجَالِ كَثِيرٌ ، وَلَمْ يَكْمُلْ مِنَ النِّسَاءِ غَيْرُ  مَرْيَمَ بِنْتِ عِمْرَانَ  ،  وَآسِيَةَ امْرَأَةِ فِرْعَوْنَ  ، وَإِنَّ فَضْلَ  عَائِشَةَ  عَلَى النِّسَاءِ كَفَضْلِ  الثَّرِيدِ  عَلَى  سَائِرِ  الطَّعَامِ  .","","Musnad Abi Ya'la al-Mawsili 7269","","أبو موسى الأشعري عن مرة بن شراحيل عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن حماد بن أسامة القرشي عن مجاهد بن موسى عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7273","50 - (  7270  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  يَحْيَى بْنُ بُرَيْدٍ قَالَ :  أَخْبَرَنِي  أَبِي  ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ جَلِيسَ الصِّدْقِ وَجَلِيسَ السَّوْءِ كَحَامِلِ الْمِسْكِ ، إِمَّا أَنْ يُحْذِيَكَ ، وَإِمَّا أَنْ تَجِدَ رِيحًا طَيِّبَةً  ، وَنَافِخُ  الْكِيرِ  إِمَّا أَنْ  يَحْرِقَ  ثِيَابَكَ ، وَإِمَّا أَنْ تَجِدَ رِيحًا خَبِيثَةً  .         [13/254]             [13/255]","","Musnad Abi Ya'la al-Mawsili 7270","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن يحيى بن بريد الأشعري عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7274","51 - (  7271  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي مُوسَى قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَقَدْ مَرَّ بِالصَّخْرَةِ مِنَ  الرَّوْحَاءِ  سَبْعُونَ نَبِيًّا حُفَاةً  ، عَلَيْهِمُ  الْعَبَاءُ  .","","Musnad Abi Ya'la al-Mawsili 7271","","أبو موسى الأشعري عن أبان بن عبد الله الرقاشي عن يزيد بن أبان الرقاشي عن صالح بن كيسان الدوسي عن إبراهيم بن إسماعيل بن مجمع عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7275","52 - (  7272  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  أَبِي جَعْفَرٍ الرَّازِيِّ ،  حَدَّثَنَا  رَبِيعُ بْنُ أَنَسٍ ،  عَنْ  جَدَّيْهِ : زَيْدٍ ، وَزِيَادٍ  - وَكَانَا يَخْتَلِفَانِ إِلَى  أَبِي مُوسَى  بِالْبَصْرَةِ  يُقْرِئُهُمُ الْقُرْآنَ -         [13/256]      عَنْ  أَبِي مُوسَى قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  لَا تُقْبَلُ صَلَاةُ رَجُلٍ مَا دَامَ  فِي جِلْدِهِ ، أَوْ فِي جَسَدِهِ  مِنْهُ شَيْءٌ  ،  يَعْنِي : الصُّفْرَةَ  ""  .         [13/257]","","Musnad Abi Ya'la al-Mawsili 7272","","أبو موسى الأشعري عن زياد جد الربيع بن أنس عن الربيع بن أنس البكري عن عيسى بن أبي عيسى الرازي عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7276","53 - (  7273  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبَّادِ بْنِ عَبَّادٍ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  أَبِي مُوسَى قَالَ :  أَتَيْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِوَضُوءٍ ، فَتَوَضَّأَ قَالَ : "" اللَّهُمَّ اغْفِرْ لِي ذَنْبِي  ، وَوَسِّعْ لِي فِي دَارِي ، وَبَارِكْ لِي فِي رِزْقِي  "" .","","Musnad Abi Ya'la al-Mawsili 7273","","أبو موسى الأشعري عن لاحق بن حميد عن عباد بن عباد بن علقمة المازني عن معتمر بن سليمان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7277","54 - (  7274  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  جَعْفَرِ بْنِ بُرْقَانَ ،  عَنْ  ثَابِتِ بْنِ الْحَجَّاجِ ،  عَنْ  أَبِي بُرْدَةَ ،         [13/258]      عَنْ  أَبِيهِ  قَالَ :  اخْتَصَمَ  رَجُلَانِ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  حَضْرَمَوْتَ  فِي أَرْضٍ ، فَقَالَ لِلْمُدَّعَى عَلَيْهِ : "" احْلِفْ "" ، فَقَالَ الْمُدَّعِي : يَا رَسُولَ اللهِ ! مَا لِي إِلَّا يَمِينُهُ ؟ إِذًا يَذْهَبُ بِأَرْضِي ، فَقَالَ :  إِنِ اقْتَطَعَهَا بِيَمِينِهِ ، كَانَ مِمَّنْ لَا يُكَلِّمُهُ اللهُ - عَزَّ وَجَلَّ - ، وَلَا يَنْظُرُ إِلَيْهِ ، وَلَا  يُزَكِّيهِ  ، وَلَهُ عَذَابٌ أَلِيمٌ "" قَالَ : فَتَوَرَّعَ الْآخَرُ ، فَرَدَّهَا عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 7274","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن ثابت بن الحجاج الكلابي عن جعفر بن برقان الكلابي عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7278","55 - (  7275  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  مُعَلَّى بْنُ مَنْصُورٍ ،         [13/259]      عَنْ  مُوسَى بْنِ أَعْيَنَ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  عَقِيلٍ مَوْلَى ابْنِ عَبَّاسٍ ،  عَنْ  أَبِي مُوسَى قَالَ :  كُنْتُ أَنَا  وَأَبُو الدَّرْدَاءِ  عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  مَنْ حَفِظَ مَا بَيْنَ  فُقْمَيْهِ  وَرِجْلَيْهِ ، دَخَلَ الْجَنَّةَ  .         [13/260]","","Musnad Abi Ya'la al-Mawsili 7275","","أبو موسى الأشعري عن عقيل عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عبد الله بن محمد بن عقيل بن أبي طالب عن موسى بن أعين الجزري عن معلى بن منصور الرازي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7279","56 - (  7276  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  مُجَمِّعِ بْنِ يَحْيَى ،  عَنْ  سَعِيدِ بْنِ أَبِي بُرْدَةَ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِيهِ  قَالَ :  صَلَّيْنَا الْمَغْرِبَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قُلْنَا : لَوْ جَلَسْنَا حَتَّى نُصَلِّيَ مَعَهُ الْعِشَاءَ . قَالَ : فَجَلَسْنَا ، فَخَرَجَ عَلَيْنَا ، فَقَالَ : "" مَا زِلْتُمْ هَاهُنَا ؟ "" فَقُلْنَا : نَعَمْ يَا رَسُولَ اللهِ ! صَلَّيْنَا مَعَكَ الْمَغْرِبَ ، ثُمَّ قُلْنَا : نَجْلِسُ حَتَّى نُصَلِّيَ مَعَكَ الْعِشَاءَ . قَالَ :  أَحْسَنْتُمْ ، أَوْ أَصَبْتُمْ  قَالَ : فَرَفَعَ رَأْسَهُ إِلَى السَّمَاءِ - وَكَانَ كَثِيرًا مَا يَرْفَعُ رَأْسَهُ إِلَى السَّمَاءِ - فَقَالَ :  النُّجُومُ أَمَانٌ لِأَهْلِ السَّمَاءِ ، فَإِذَا ذَهَبَ النُّجُومُ أَتَى أَهْلَ السَّمَاءِ مَا يُوعَدُونَ  ، وَأَنَا  أَمَنَةٌ  لِأَصْحَابِي ، فَإِذَا ذَهَبْتُ أَتَى أَصْحَابِي مَا يُوعَدُونَ ، وَأَصْحَابِي  أَمَنَةٌ  لِأُمَّتِي ، فَإِذَا ذَهَبَ أَصْحَابِي أَتَى أُمَّتِي مَا يُوعَدُونَ  .         [13/261]","","Musnad Abi Ya'la al-Mawsili 7276","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن سعيد بن أبي بردة الأشعري عن مجمع بن يحيى بن زيد الأنصاري عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7280","57 - (  7277  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ يَمَانٍ ،  حَدَّثَنَا  حَرْمَلَةُ بْنُ قَيْسٍ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أُمَّتِي أُمَّةٌ مَرْحُومَةٌ ، لَيْسَ عَلَيْهَا عَذَابٌ فِي الْآخِرَةِ  ، عَذَابُهَا فِي الدُّنْيَا : الزَّلَازِلُ ، وَالْفِتَنُ ، وَالْقَتْلُ  .         [13/262]             [13/263]","","Musnad Abi Ya'la al-Mawsili 7277","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن حرملة بن قيس النخعي عن يحيى بن يمان العجلي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7281","58 - (  7278  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ ،  حَدَّثَنَا  أَيُّوبُ بْنُ عَائِذٍ ،  حَدَّثَنَا  قَيْسُ بْنُ مُسْلِمٍ ،  سَمِعْتُ  طَارِقَ بْنَ شِهَابٍ قَالَ :  حَدَّثَنِي  أَبُو مُوسَى الْأَشْعَرِيُّ قَالَ :  بَعَثَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى أَرْضِ قَوْمِي ، فَجِئْتُ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُنِيخٌ  بِالْأَبْطَحِ  قَالَ : فَسَلَّمْتُ عَلَيْهِ ، فَقَالَ :  أَحَجَجْتَ يَا  عَبْدَ اللهِ بْنَ قَيْسٍ  ؟  قَالَ : قُلْتُ : نَعَمْ يَا رَسُولَ اللهِ . قَالَ : كَيْفَ قُلْتَ ؟ قَالَ : قُلْتُ : لَبَّيْكَ إِهْلَالًا ، كَإِهْلَالِكَ . قَالَ : فَقَالَ : "" هَلْ سُقْتَ هَدْيًا ؟ "" قَالَ : قُلْتُ : لَا ، لَمْ أَسُقْ هَدْيًا . قَالَ : "" فَطُفْ  بِالْبَيْتِ  وَاسْعَ بَيْنَ  الصَّفَا  ، ثُمَّ حِلَّ "" . قَالَ : فَفَعَلْتُ حَتَّى مَشَّطَتْنِي امْرَأَةٌ         [13/264]      مِنْ  بَنِي قَيْسٍ  . قَالَ : فَمَكَثْنَا بِذَلِكَ حَتَّى اسْتُخْلِفَ  عُمَرُ  . قَالَ : فَإِنِّي عِنْدَ  الْمَقَامِ  أُفْتِي النَّاسَ بِالَّذِي أَمَرَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَبِالَّذِي صَنَعْتُ . قَالَ : فَجَاءَنِي  رَجُلٌ  فَسَارَّنِي فِي أُذُنِي ، فَقَالَ :  اتَّئِدْ  فِي فُتْيَاكَ ، فَإِنَّ أَمِيرَ الْمُؤْمِنِينَ قَدْ أَحْدَثَ فِي  النُّسُكِ  . قَالَ : فَقُلْتُ : أَيُّهَا النَّاسُ مَنْ كُنَّا أَفْتَيْنَاهُ شَيْئًا فِي  النُّسُكِ  فَلْيَتَّئِدْ ، فَإِنَّ هَذَا أَمِيرَ الْمُؤْمِنِينَ قَادِمٌ عَلَيْكُمْ ، فَإِلَيَّ مَنْ عَلِمَ مِنْهُ شَيْئًا ، فَلَمَّا قَدِمَ  عُمَرُ  أَتَيْتُهُ ، فَقُلْتُ : يَا أَمِيرَ الْمُؤْمِنِينَ ، أَحْدَثْتَ فِي  النُّسُكِ  ؟ قَالَ : إِنْ أَخَذْنَا بِكِتَابِ اللهِ - عَزَّ وَجَلَّ - ، فَإِنَّهُ يَأْمُرُنَا بِالتَّمَامِ ، وَإِنْ أَخَذْنَا بِسُنَّةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَإِنَّهُ لَمْ يَحِلَّ حَتَّى نَحَرَ الْبُدْنَ . قَالَ : فَنَهَى عَنِ الْعُمْرَةِ فِي أَيَّامِ         [13/265]      الْحَجِّ  .         [13/266]","","Musnad Abi Ya'la al-Mawsili 7278","","أبو موسى الأشعري عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن أيوب بن عائذ عن عبد الواحد بن زياد عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7282","59 - (  7279  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  خَالِدُ بْنُ نَافِعٍ ،  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي بُرْدَةَ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَعَائِشَةَ  مَرَّا  بِأَبِي مُوسَى  وَهُوَ يَقْرَأُ فِي بَيْتِهِ ، فَقَامَا يَسْتَمِعَانِ لِقِرَاءَتِهِ ، ثُمَّ إِنَّهُمَا مَضَيَا ، فَلَمَّا أَصْبَحَ ، لَقِيَ  أَبَا مُوسَى  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا  أَبَا مُوسَى  ، مَرَرْتُ بِكَ الْبَارِحَةَ وَمَعِي  عَائِشَةُ  ، وَأَنْتَ تَقْرَأُ فِي بَيْتِكَ ، فَقُمْنَا ، فَاسْتَمَعْنَا  ، فَقَالَ لَهُ  أَبُو مُوسَى  : أَمَا إِنِّي يَا رَسُولَ اللهِ ! لَوْ عَلِمْتُ  لَحَبَّرْتُ  لَكَ تَحْبِيرًا  .         [13/267]             [13/268]","","Musnad Abi Ya'la al-Mawsili 7279","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن سعيد بن أبي بردة الأشعري عن خالد بن نافع الأشعري عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7283","60 - (  7280  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  سَعِيدِ بْنِ أَبِي بُرْدَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي مُوسَى  أَنَّ  رَجُلَيْنِ  ادَّعَيَا بَعِيرًا ، فَبَعَثَ كُلُّ وَاحِدٍ مِنْهُمَا شَاهِدَيْنِ  ، فَقَسَمَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَهُمَا  .","","Musnad Abi Ya'la al-Mawsili 7280","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن سعيد بن أبي بردة الأشعري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7284","61 - (  7281  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  سَعِيدِ بْنِ أَبِي بُرْدَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي مُوسَى  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَا مِنْ         [13/269]      مُسْلِمٍ يَمُوتُ إِلَّا جَعَلَ اللهُ مَكَانَهُ رَجُلًا  مِنَ الْيَهُودِ أَوِ النَّصَارَى فِي النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 7281","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن سعيد بن أبي بردة الأشعري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7285","62 - (  7282  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  أَبُو مَعْشَرٍ ،  عَنْ  مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِي بُرْدَةَ بْنِ أَبِي مُوسَى ،  عَنْ  أَبِي مُوسَى  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَا مِنْ مُؤْمِنٍ إِلَّا يَأْتِي يَوْمَ الْقِيَامَةِ بِيَهُودِيٍّ أَوْ نَصْرَانِيٍّ  ، يَقُولُ : هَذَا فِدَائِي مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 7282","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن محمد بن المنكدر عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن نجيح بن عبد الرحمن السندي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7286","63 - (  7283  ) -  حَدَّثَنَا  الْقَاسِمُ بْنُ يَحْيَى ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  أَبُو سَعِيدٍ رَوْحُ بْنُ جَنَاحٍ ،  عَنْ  مَوْلًى لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  :         {      يَوْمَ يُكْشَفُ عَنْ سَاقٍ         }      . قَالَ : عَنْ نُورٍ عَظِيمٍ يَخِرُّونَ لَهُ سُجَّدًا  .         [13/270]             [13/271]","","Musnad Abi Ya'la al-Mawsili 7283","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن مولى لعمر بن عبد العزيز عن روح بن جناح مولى الوليد بن عبد الملك عن الوليد بن مسلم القرشي عن القاسم بن يحيى عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7287","64 - (  7284  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  حَدَّثَنَا  عَلِيُّ بْنُ عَاصِمٍ ،  عَنْ  خَالِدٍ ،  عَنْ  تَوْبَةَ الْعَنْبَرِيِّ ،  عَنْ  أَبِي بُرْدَةَ بْنِ أَبِي مُوسَى ،  عَنْ  أَبِيهِ أَبِي مُوسَى  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  كَانَ صَاحِبُ  بَنِي إِسْرَائِيلَ  أَشَدَّ فِي الْبَوْلِ مِنْكُمْ  ، كَانَتْ مَعَهُ مِبْرَاةٌ إِذَا أَصَابَ شَيْئًا مِنْ جَسَدِهِ الْبَوْلُ ، بَرَاهُ بِهَا  .","","Musnad Abi Ya'la al-Mawsili 7284","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن توبة بن أبي الأسد العنبري عن خالد الحذاء عن علي بن عاصم بن صهيب عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7288","65 - (  7285  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  بُرَيْدُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِي بُرْدَةَ ،         [13/272]      عَنْ  أَبِي مُوسَى  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَلَّهُ أَفْرَحُ بِتَوْبَةِ عَبْدِهِ الَّذِي قَدْ أَسْرَفَ عَلَى نَفْسِهِ مِنْ رَجُلٍ سَافَرَ فِي أَرْضٍ فَلَاةٍ مَعْطَبَةٍ مَهْلَكَةٍ  ، فَلَمَّا تَوَسَّطَ أَضَلَّ رَاحِلَتَهُ ، فَسَعَى فِي  بُغَائِهَا  يَمِينًا وَشِمَالًا حَتَّى  أَعْيَى - أَوْ أَيِسَ  - مِنْهَا ، وَظَنَّ أَنْ قَدْ هَلَكَ ، نَظَرَ فَوَجَدَهَا فِي مَكَانٍ لَمْ يَكُنْ يَرْجُو أَنْ يَجِدَهَا ، فَاللهُ - عَزَّ وَجَلَّ - أَفْرَحُ بِتَوْبَةِ عَبْدِهِ الْمُسْرِفِ مِنْ ذَلِكَ الرَّجُلِ بِرَاحِلَتِهِ حِينَ وَجَدَهَا  .","","Musnad Abi Ya'la al-Mawsili 7285","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7289","66 - (  7286  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  سُئِلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَيُّ الْمُسْلِمِينَ أَفْضَلُ ؟ قَالَ :  مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  .         [13/273]","","Musnad Abi Ya'la al-Mawsili 7286","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7290","67 - (  7287  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ اللهَ - عَزَّ وَجَلَّ - يُمْلِي لِلظَّالِمِ حَتَّى إِذَا أَخَذَهُ لَمْ يَنْفَلِتْ  ، ثُمَّ تَلَا :         {      وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ إِنَّ أَخْذَهُ أَلِيمٌ شَدِيدٌ         }      .         [13/274]","","Musnad Abi Ya'la al-Mawsili 7287","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7291","68 - (  7288  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  بُرَيْدُ بْنُ عَبْدِ اللهِ بْنِ أَبِي بُرْدَةَ ،  حَدَّثَنَا  أَبُو بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ :  سَأَلْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَيُّ الْإِسْلَامِ أَفْضَلُ ؟ قَالَ :  مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  .","","Musnad Abi Ya'la al-Mawsili 7288","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7292","69 - (  7289  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  مَكِّيٌّ ،  عَنِ  الْجُعَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  يَزِيدَ بْنِ خُصَيْفَةَ ،  عَنْ  حُمَيْدِ بْنِ بَشِيرٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ قَالَ :  حَدَّثَنِي  أَبُو مُوسَى الْأَشْعَرِيُّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا يُقَلِّبُ  كَعَبَاتِهَا  رَجُلٌ يَنْظُرُ مَا تَأْتِي بِهِ إِلَّا عَصَى اللهَ وَرَسُولَهُ  .","","Musnad Abi Ya'la al-Mawsili 7289","","أبو موسى الأشعري عن محمد بن كعب بن سليم القرظي عن حميد بن بشير بن المحرر عن يزيد بن عبد الله بن خصيفة الكندي عن الجعد بن عبد  الرحمن بن أوس الكندي عن مكي بن إبراهيم عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7293","70 - (  7290  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْجُشَمِيُّ ،  حَدَّثَنَا         [13/275]      يَحْيَى بْنُ سَعِيدٍ ، وَبِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِنْدٍ ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ لَعِبَ بِالنَّرْدِ ، فَقَدْ عَصَى اللهَ وَرَسُولَهُ  .         [13/276]","","Musnad Abi Ya'la al-Mawsili 7290","","أبو موسى الأشعري عن سعيد بن أبي هند الفزاري عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن بشر بن المفضل عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7294","71 - (  7291  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  بُرَيْدٍ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا مَرَّ أَحَدُكُمْ فِي مَسْجِدِنَا ، أَوْ فِي سُوقِنَا ، وَمَعَهُ نَبْلٌ  ،  فَلْيُمْسِكْ عَلَى نِصَالِهَا ، أَوْ قَالَ : فَلْيَقْبِضْ بِكَفِّهِ  أَنْ يُصِيبَ أَحَدًا مِنَ الْمُسْلِمِينَ مِنْهَا شَيْءٌ  .         [13/277]","","Musnad Abi Ya'la al-Mawsili 7291","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7295","72 - (  7292  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ  حَمَلَ  عَلَيْنَا السِّلَاحَ فَلَيْسَ مِنَّا  .","","Musnad Abi Ya'la al-Mawsili 7292","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7296","73 - (  7293  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  احْتَرَقَ بَيْتٌ  بِالْمَدِينَةِ  عَلَى أَهْلِهِ مِنَ اللَّيْلِ ، فَلَمَّا حُدِّثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِشَأْنِهِمْ ، قَالَ :  إِنَّ هَذِهِ النَّارَ إِنَّمَا هِيَ عَدُوٌّ لَكُمْ ، فَإِذَا نِمْتُمْ فَأَطْفِئُوهَا عَنْكُمْ  .         [13/278]","","Musnad Abi Ya'la al-Mawsili 7293","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7297","74 - (  7294  ) -  وَعَنْ  أَبِي مُوسَى قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ أَعْظَمَ النَّاسِ أَجْرًا فِي الصَّلَاةِ أَبْعَدُهُمْ إِلَيْهِ مَمْشًى فَأَبْعَدُهُمْ  ، وَالَّذِي يَنْتَظِرُ الصَّلَاةَ حَتَّى يُصَلِّيَهَا مَعَ الْإِمَامِ فِي جَمَاعَةٍ ، أَعْظَمُ أَجْرًا مِنَ الَّذِي يُصَلِّيهَا ثُمَّ يَنَامُ  .         [13/279]","","Musnad Abi Ya'la al-Mawsili 7294","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7298","75 - (  7295  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ الْمُؤْمِنَ لِلْمُؤْمِنِ كَالْبُنْيَانِ  يَشُدُّ بَعْضُهُ بَعْضًا  .         [13/280]","","Musnad Abi Ya'la al-Mawsili 7295","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7299","76 - (  7296  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  كَانَ  إِذَا أَتَاهُ السَّائِلُ ، وَرُبَّمَا قَالَ : جَاءَ السَّائِلُ ، أَوْ صَاحِبُ الْحَاجَةِ  قَالَ :  اشْفَعُوا فَلْتُؤْجَرُوا ، وَيَقْضِي اللهُ عَلَى لِسَانِ نَبِيِّهِ مَا شَاءَ  .         [13/281]             [13/282]","","Musnad Abi Ya'la al-Mawsili 7296","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7300","77 - (  7297  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  أَرْسَلَنِي أَصْحَابِي إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَسْأَلُهُ  الْحُمْلَانَ  لَهُمْ إِذْ هُمْ فِي جَيْشِ  الْعُسْرَةِ  ، وَهِيَ  غَزْوَةُ تَبُوكَ  ، فَقُلْتُ : يَا نَبِيَّ اللهِ ، إِنَّ أَصْحَابِي أَرْسَلُونِي إِلَيْكَ لِتَحْمِلَهُمْ قَالَ : لَا ، وَاللهِ لَا أَحْمِلُهُمْ عَلَى شَيْءٍ ، وَوَافَقْتُهُ وَهُوَ غَضْبَانُ وَلَا أَشْعُرُ ، فَرَجَعْتُ حَزِينًا مِنْ مَنْعِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمِنْ مَخَافَةِ أَنْ يَكُونَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ وَجَدَ فِي نَفْسِهِ عَلَيَّ ، فَرَجَعْتُ إِلَى أَصْحَابِي ، فَأَخْبَرْتُهُمُ الَّذِي قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ أَلْبَثْ إِلَّا سُوَيْعَةً إِذْ سَمِعْتُ  بِلَالًا  يُنَادِي :         [13/283]      أَيْنَ  عَبْدُ اللهِ بْنُ قَيْسٍ  ؟ فَأَجَبْتُهُ ، فَقَالَ : أَجِبْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُوكَ ، فَلَمَّا أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" خُذْ هَذَيْنِ  الْقَرِينَيْنِ ،  وَهَذَيْنِ  الْقَرِينَيْنِ ،  وَهَذَيْنِ  الْقَرِينَيْنِ  - لِسِتَّةِ أَبْعِرَةٍ ابْتَاعَهُنَّ حِينَئِذٍ مِنْ  سَعْدٍ  - فَانْطَلِقْ بِهِنَّ إِلَى أَصْحَابِكَ ، فَقُلْ :  إِنَّ اللهَ - عَزَّ وَجَلَّ - أَوْ إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - يَحْمِلُكُمْ عَلَى هَؤُلَاءِ ، فَارْكَبُوهُنَّ  .  قَالَ  أَبُو مُوسَى  : فَانْطَلَقْتُ إِلَى أَصْحَابِي بِهِنَّ ، فَقُلْتُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَحْمِلُ عَلَى هَؤُلَاءِ ، وَلَكِنْ وَاللهِ لَا أَدَعُكُمْ حَتَّى يَنْطَلِقَ مَعِي بَعْضُكُمْ إِلَى مَنْ سَمِعَ مَقَالَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ سَأَلْتُهُ لَكُمْ ، وَمَنَعَهُ فِي أَوَّلِ مَرَّةٍ ، ثُمَّ أَعْطَاهُ إِيَّايَ بَعْدَ ذَلِكَ ، لَا تَظُنُّوا أَنِّي حَدَّثْتُكُمْ شَيْئًا لَمْ يَقُلْهُ ، فَقَالُوا : وَاللهِ إِنَّكَ عِنْدَنَا لَمُصَدَّقٌ ، وَلَنَفْعَلَنَّ مَا أَحْبَبْتَ ، فَانْطَلَقَ  أَبُو مُوسَى  بِنَفَرٍ مِنْهُمْ حَتَّى أَتَوُا الَّذِينَ سَمِعُوا قَوْلَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَنْعَهُ إِيَّاهُمْ ، ثُمَّ أَعْطَاهُ بَعْدُ ، فَحَدَّثَهُمْ مِثْلَ مَا حَدَّثَهُمْ  أَبُو مُوسَى  سَوَاءً  .","","Musnad Abi Ya'la al-Mawsili 7297","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7301","78 - (  7298  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  رَأَيْتُ فِي الْمَنَامِ أَنِّي أُهَاجِرُ مِنْ  مَكَّةَ  إِلَى أَرْضٍ بِهَا نَخْلٌ  ، فَذَهَبَ وَهْمِي إِلَى أَنَّهَا  الْيَمَامَةُ  وَهَجَرُ  ، فَإِذَا هِيَ  الْمَدِينَةُ يَثْرِبُ  .         [13/284]      وَرَأَيْتُ فِي رُؤْيَايَ هَذِهِ أَنِّي هَزَزْتُ سَيْفًا فَانْقَطَعَ صَدْرُهُ ، فَإِذَا هُوَ مَا أُصِيبَ مِنَ الْمُؤْمِنِينَ  يَوْمَ أُحُدٍ  ، وَهَزَزْتُهُ أُخْرَى فَعَادَ خَيْرًا مِمَّا كَانَ ، فَإِذَا هُوَ مَا جَاءَ اللهُ بِهِ مِنَ الْفَتْحِ وَاجْتِمَاعِ الْمُؤْمِنِينَ ، وَرَأَيْتُ فِيهَا أَيْضًا بَقَرًا وَاللهُ خَيْرٌ ، فَإِذَا هُمُ النَّفَرُ مِنَ الْمُؤْمِنِينَ  يَوْمَ أُحُدٍ  ، وَإِذَا الْخَيْرُ مَا جَاءَ اللهُ بِهِ مِنَ الْخَيْرِ بَعْدُ ، وَثَوَابُ الصِّدْقِ أَتَانَا بَعْدُ  يَوْمَ بَدْرٍ  .         [13/285]","","Musnad Abi Ya'la al-Mawsili 7298","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7302","79 - (  7299  ) -  وَعَنْ  أَبِي مُوسَى أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَيَأْتِيَنَّ زَمَانٌ يَطُوفُ الرَّجُلُ بِالصَّدَقَةِ مِنَ الذَّهَبِ ، ثُمَّ لَا يَجِدُ أَحَدًا يَأْخُذُهَا مِنْهُ  ، وَتَرَى الرَّجُلَ يَتْبَعُهُ أَرْبَعُونَ امْرَأَةً يَلُذْنَ بِهِ مِنْ قِلَّةِ الرِّجَالِ وَكَثْرَةِ النِّسَاءِ  .","","Musnad Abi Ya'la al-Mawsili 7299","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7303","80 - (  7300  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  كُنْتُ أَنَا وَأَصْحَابِي الَّذِينَ قَدِمُوا مَعِي فِي السَّفِينَةِ ، نُزُولًا فِي  بَقِيعِ بُطْحَانَ  - وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْمَدِينَةِ  - فَكَانَ يَتَنَاوَبُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ صَلَاةِ الْعِشَاءِ كُلَّ لَيْلَةٍ نَفَرٌ مِنْهُمْ .         [13/286]      قَالَ  أَبُو مُوسَى  : فَوَافَقْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَا وَأَصْحَابِي وَلَهُ بَعْضُ الشُّغْلِ فِي بَعْضِ أَمْرِهِ ، فَأَعْتَمَ بِالصَّلَاةِ حَتَّى  ابْهَارَّ  اللَّيْلُ ، حَتَّى خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا قَضَى صَلَاتَهُ ، قَالَ لِمَنْ حَضَرَهُ :  عَلَى رِسْلِكُمْ ، أَبْشِرُوا إِنَّ مِنْ نِعْمَةِ اللهِ عَلَيْكُمْ  أَنَّهُ  لَيْسَ مِنْ أَحَدٍ مِنَ النَّاسِ يُصَلِّي هَذِهِ الصَّلَاةَ غَيْرُكُمْ "" أَوْ قَالَ : "" مَا صَلَّى هَذِهِ السَّاعَةَ أَحَدٌ غَيْرُكُمْ  "" لَا يَدْرِي أَيَّ الْكَلِمَتَيْنِ قَالَ .  قَالَ  أَبُو مُوسَى  : فَرَجَعْنَا فَرِحِينَ بِمَا سَمِعْنَا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .         [13/287]","","Musnad Abi Ya'la al-Mawsili 7300","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7304","81 - (  7301  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ أَحَبَّ  لِقَاءَ  اللهِ أَحَبَّ اللهُ  لِقَاءَهُ  ، وَمَنْ كَرِهَ  لِقَاءَ  اللهِ كَرِهَ اللهُ لِقَاءَهُ  .","","Musnad Abi Ya'la al-Mawsili 7301","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7305","82 - (  7302  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  كَسَفَتِ الشَّمْسُ         [13/288]      زَمَنَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَامَ يُصَلِّي بِأَطْوَلَ قِيَامٍ وَرُكُوعٍ وَسُجُودٍ رَأَيْتُهُ يَفْعَلُهُ فِي صَلَاةٍ قَطُّ ، ثُمَّ قَالَ :  إِنَّ هَذِهِ الْآيَاتِ الَّتِي تُرْسَلُ لَا تَكُونُ لِمَوْتِ أَحَدٍ وَلَا لِحَيَاتِهِ  ، وَلَكِنَّ اللهَ - عَزَّ وَجَلَّ - يُرْسِلُهَا يُخَوِّفُ بِهَا عِبَادَهُ ، فَإِذَا رَأَيْتُمْ مِنْهَا شَيْئًا ،  فَافْزَعُوا  إِلَى ذِكْرِهِ وَدُعَائِهِ وَاسْتِغْفَارِهِ  .","","Musnad Abi Ya'la al-Mawsili 7302","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7306","83 - (  7303  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ أَشْيَاءَ كَرِهَهَا ، فَلَمَّا أُكْثِرَ عَلَيْهِ غَضِبَ ، ثُمَّ         [13/289]      قَالَ لِلنَّاسِ :  سَلُونِي عَمَّا شِئْتُمْ  ، فَقَالَ  رَجُلٌ  : مَنْ أَبِي ؟ قَالَ : أَبُوكَ  حُذَافَةُ  ، فَقَالَ آخَرُ : مَنْ أَبِي يَا رَسُولَ اللهِ ؟ قَالَ : أَبُوكَ  سَالِمٌ مَوْلَى شَيْبَةَ  .  فَلَمَّا رَأَى  عُمَرُ  مَا فِي وَجْهِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الْغَضَبِ قَالَ : يَا رَسُولَ اللهِ ، إِنَّا نَتُوبُ إِلَى اللهِ - عَزَّ وَجَلَّ  - .","","Musnad Abi Ya'la al-Mawsili 7303","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7307","84 - (  7304  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  خَرَجْنَا مَعَ         [13/290]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزَاةٍ وَنَحْنُ سِتَّةُ نَفَرٍ بَيْنَنَا بَعِيرٌ  نَعْتَقِبُهُ  قَالَ :  فَنَقِبَتْ  أَقْدَامُنَا  وَنَقِبَتْ  قَدَمَايَ وَسَقَطَ أَظْفَارِي ، فَكُنَّا نَلُفُّ عَلَى أَرْجُلِنَا الْخِرَقَ . قَالَ : فَسُمِّيَتْ  غَزْوَةَ ذَاتِ الرِّقَاعِ  لِمَا كُنَّا نَعْصِبُ عَلَى أَرْجُلِنَا مِنَ الْخِرَقِ . قَالَ  أَبُو بُرْدَةَ  : فَحَدَّثَ  أَبُو مُوسَى  بِهَذَا الْحَدِيثِ ، ثُمَّ كَرِهَ ذَلِكَ ، فَقَالَ : مَا كُنْتُ أَصْنَعُ بِأَنْ أَذْكُرَ هَذَا الْحَدِيثَ قَالَ : لِأَنَّهُ كَرِهَ أَنْ يَكُونَ شَيْئًا مِنْ عَمَلِهِ أَفْشَاهُ  .  قَالَ  أَبُو أُسَامَةَ  ، وَقَالَ غَيْرُهُ : اللهُ يَجْزِي بِهِ .         [13/291]","","Musnad Abi Ya'la al-Mawsili 7304","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7308","85 - (  7305  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  تَعَاهَدُوا الْقُرْآنَ ، فَوَالَّذِي نَفْسِي بِيَدِهِ لَهُوَ أَشَدُّ تَفَلُّتًا مِنَ الْإِبِلِ مِنْ عُقُلِهَا  .","","Musnad Abi Ya'la al-Mawsili 7305","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7309","86 - (  7306  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَثَلُ الْبَيْتِ الَّذِي يُذْكَرُ اللهُ فِيهِ ، وَالْبَيْتِ الَّذِي لَا يُذْكَرُ اللهُ فِيهِ ، مَثَلُ الْحَيِّ وَالْمَيِّتِ  .         [13/292]      .         [13/293]","","Musnad Abi Ya'la al-Mawsili 7306","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7310","87 - (  7307  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّمَا مَثَلُ جَلِيسِ الصَّالِحِ ، وَجَلِيسِ السَّوْءِ ، كَحَامِلِ الْمِسْكِ وَنَافِخِ  الْكِيرِ  ، فَحَامِلُ الْمِسْكِ إِمَّا أَنْ يُحْذِيَكَ ، وَإِمَّا أَنْ تَبْتَاعَ مِنْهُ ، وَإِمَّا أَنْ تَجِدَ مِنْهُ رِيحًا طَيِّبَةً ، وَنَافِخُ  الْكِيرِ  إِمَّا أَنْ  يَحْرِقَ  ثِيَابَكَ ، وَإِمَّا أَنْ تَجِدَ مِنْهُ رِيحًا مُنْتِنَةً  .","","Musnad Abi Ya'la al-Mawsili 7307","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7311","88 - (  7308  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لِلْمَمْلُوكِ الَّذِي يُحْسِنُ عِبَادَةَ رَبِّهِ وَيُؤَدِّي إِلَى سَيِّدِهِ الَّذِي لَهُ عَلَيْهِ مِنَ الْحَقِّ  وَالنَّصِيحَةِ  وَالطَّاعَةِ ، أَجْرَانِ  : أَجْرُ مَا أَحْسَنَ عِبَادَةَ رَبِّهِ ، وَأَجْرُ مَا أَدَّى إِلَى مَلِيكِهِ الَّذِي لَهُ عَلَيْهِ مِنَ الْحَقِّ  .","","Musnad Abi Ya'la al-Mawsili 7308","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7312","89 - (  7309  ) -  وَبِهِ  عَنْ  أَبِي مُوسَى قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ  الْأَشْعَرِيِّينَ  إِذَا  أَرْمَلُوا  فِي الْغَزْوِ ، أَوْ قَلَّ طَعَامُ عِيَالِهِمْ  بِالْمَدِينَةِ  ، جَمَعُوا مَا كَانَ عِنْدَهُمْ فِي ثَوْبٍ وَاحِدٍ  ، ثُمَّ اقْتَسَمُوا بَيْنَهُمْ فِي إِنَاءٍ وَاحِدٍ بِالسَّوِيَّةِ ، وَهُمْ مِنِّي وَأَنَا مِنْهُمْ  .         [13/294]","","Musnad Abi Ya'la al-Mawsili 7309","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7313","90 - (  7310  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ مَثَلِي وَمَثَلَ مَا بَعَثَنِي اللهُ بِهِ ، كَمَثَلِ رَجُلٍ أَتَاهُ قَوْمُهُ  ، فَقَالَ : يَا قَوْمِ ، إِنِّي رَأَيْتُ الْجَيْشَ ، إِنِّي أَنَا النَّذِيرُ  الْعُرْيَانُ  ،  فَالنَّجَاءَ  ! ! فَأَطَاعَهُ طَائِفَةٌ مِنْ قَوْمِهِ فَأَدْلَجُوا ، فَانْطَلَقُوا عَلَى مَهْلِهِمْ ، فَنَجَوْا ، وَكَذَّبَتْ طَائِفَةٌ فَأَصْبَحُوا مَكَانَهُمْ ، فَصَبَّحَهُمُ الْجَيْشُ فَاجْتَاحَهُمْ ، فَذَلِكَ مَثَلُ مَنْ أَطَاعَنِي فَاتَّبَعَ مَا جِئْتُ بِهِ ، وَمَثَلُ مَنْ عَصَانِي         [13/295]      وَكَذَّبَ مَا جِئْتُ بِهِ مِنَ الْحَقِّ  .","","Musnad Abi Ya'la al-Mawsili 7310","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7314","91 - (  7311  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :         [13/296]      ""  إِنَّ مَثَلَ مَا أَتَانِي اللهُ بِهِ مِنَ الْهُدَى وَالْعِلْمِ كَمَثَلِ غَيْثٍ أَصَابَ أَرْضًا  ، فَكَانَتْ مِنْهَا طَائِفَةٌ طَيِّبَةٌ قَبِلَتِ الْمَاءَ ، فَأَنْبَتَتِ الْكَلَأَ وَالْعُشْبَ الْكَثِيرَ ، وَكَانَتْ مِنْهَا  إِخَاذَاتٌ  أَمْسَكَتِ الْمَاءَ ، فَنَفَعَ اللهُ بِهَا النَّاسَ ، فَشَرِبُوا مِنْهَا وَسَقَوْا وَزَرَعُوا ، وَأَصَابَتْ مِنْهَا طَائِفَةً أُخْرَى ، إِنَّمَا هِيَ  قِيعَانٌ  لَا تُمْسِكُ مَاءً وَلَا تُنْبِتُ كَلَأً ، فَذَلِكَ مَثَلُ مَنْ  فَقُهَ  فِي دِينِ اللهِ وَنَفَعَهُ مَا بَعَثَنِي اللهُ بِهِ ، فَعَلِمَ وَعَلَّمَ ، وَمَثَلُ مَنْ لَمْ يَرْفَعْ بِذَلِكَ رَأْسًا وَلَمْ يَقْبَلْ هُدَى اللهِ الَّذِي أُرْسِلْتُ بِهِ  .         [13/297]","","Musnad Abi Ya'la al-Mawsili 7311","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7315","92 - (  7312  ) -  وَعَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَثَلُ الْمُسْلِمِينَ وَالْيَهُودِ وَالنَّصَارَى ، كَمَثَلِ رَجُلٍ اسْتَأْجَرَ قَوْمًا  ، يَعْمَلُونَ لَهُ عَمَلًا يَوْمًا إِلَى اللَّيْلِ عَلَى أَجْرٍ مَعْلُومٍ ، فَعَمِلُوا لَهُ إِلَى نِصْفِ النَّهَارِ ، ثُمَّ قَالُوا : لَا حَاجَةَ لَنَا فِي أَجْرِكَ الَّذِي شَرَطْتَ لَنَا ، وَمَا عَمِلْنَا بَاطِلٌ ، فَقَالَ لَهُمْ : لَا تَفْعَلُوا ، اعْمَلُوا بَقِيَّةَ         [13/298]      يَوْمِكُمْ وَخُذُوا أَجْرَكُمْ كَامِلًا ، فَأَبَوْا وَتَرَكُوا ذَلِكَ عَلَيْهِ ، فَاسْتَأْجَرَ قَوْمًا آخَرِينَ بَعْدَهُمْ ، وَقَالَ : اعْمَلُوا بَقِيَّةَ يَوْمِكُمْ وَلَكُمُ الَّذِي شَرَطْتُ لَهُمْ مِنَ الْأَجْرِ ، فَعَمِلُوا حَتَّى إِذَا كَانَ حِينَ صَلَاةِ الْعَصْرِ ، قَالُوا : لَكَ الَّذِي عَمِلْنَا بَاطِلٌ ، وَلَكَ الْأَجْرُ الَّذِي جَعَلْتَ لَنَا ، لَا حَاجَةَ لَنَا فِيهِ قَالَ : اعْمَلُوا بَقِيَّةَ عَمَلِكُمْ ، فَإِنَّ مَا بَقِيَ مِنَ النَّهَارِ شَيْءٌ يَسِيرٌ ، ثُمَّ خُذُوا أَجْرَكُمْ ، فَأَبَوْا عَلَيْهِ ، فَاسْتَأْجَرَ قَوْمًا آخَرِينَ ، فَعَمِلُوا لَهُ بَقِيَّةَ يَوْمِهِمْ حَتَّى غَابَتِ الشَّمْسُ وَاسْتَكْمَلُوا أَجْرَ الْفَرِيقَيْنِ كِلَيْهِمَا ، وَالْأَجْرَ كُلَّهُ ، فَذَلِكَ مَثَلُ الْيَهُودِ وَالنَّصَارَى وَالَّذِينَ تَرَكُوا مَا أَمَرَهُمُ اللهُ بِهِ ، وَمَثَلُ الْمُسْلِمِينَ الَّذِينَ قَبِلُوا هُدَى اللهِ وَمَا جَاءَ بِهِ رَسُولُهُ  .         [13/299]","","Musnad Abi Ya'la al-Mawsili 7312","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7316","93 - (  7313  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  بُرَيْدٍ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ :  لَمَّا فَرَغَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  حُنَيْنٍ  ، بَعَثَ  أَبَا عَامِرٍ  عَلَى جَيْشٍ إِلَى  أَوْطَاسٍ  ، فَلَقِيَ  دُرَيْدَ بْنَ الصِّمَّةِ  ، فَقَتَلَ  دُرَيْدًا  ، وَهَزَمَ اللهُ أَصْحَابَهُ ، قَالَ  أَبُو مُوسَى  : وَبَعَثَنِي مَعَ  أَبِي عَامِرٍ  قَالَ : فَرُمِيَ  أَبُو عَامِرٍ  فِي رُكْبَتِهِ ، رَمَاهُ رَجُلٌ مِنْ  بَنِي جُشَمٍ  بِسَهْمٍ ،  فَأَثْبَتَهُ  فِي         [13/300]      رُكْبَتِهِ ، فَانْتَهَيْتُ إِلَيْهِ فَقُلْتُ : يَا عَمِّ ، مَنْ رَمَاكَ ؟ فَأَشَارَ  أَبُو عَامِرٍ  إِلَى  أَبِي مُوسَى  : أَنَّ ذَاكَ قَاتِلِي ، تُرَاهُ ذَاكَ الَّذِي رَمَانِي ، قَالَ  أَبُو مُوسَى  : فَقَصَدْتُ لَهُ ، فَاعْتَمَدْتُ لَهُ ، فَلَحِقْتُهُ ، فَلَمَّا رَآنِي وَلَّى عَنِّي ذَاهِبًا فَاتَّبَعْتُهُ ، وَجَعَلْتُ أَقُولُ : أَلَا تَسْتَحِي ؟ أَلَا تَثْبُتُ ؟ أَلَا تَسْتَحِي ؟ أَلَسْتَ عَرَبِيًّا ؟ فَكَفَّ ، فَالْتَقَيْتُ أَنَا وَهُوَ ، فَاخْتَلَفْنَا أَنَا وَهُوَ ضَرْبَتَيْنِ ، فَضَرَبْتُهُ بِالسَّيْفِ فَقَتَلْتُهُ ثُمَّ رَجَعْتُ إِلَى  أَبِي عَامِرٍ  ، فَقُلْتُ : قَدْ قَتَلَ اللهُ صَاحِبَكَ .  قَالَ : فَانْزِعْ هَذَا السَّهْمَ ، فَنَزَعْتُهُ ، فَنَزَلَ مِنْهُ الْمَاءُ قَالَ : يَا ابْنَ أَخِي ، انْطَلِقْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَقْرِئْهُ مِنِّي السَّلَامَ ، وَقُلْ لَهُ : يَقُولُ لَكَ : اسْتَغْفِرْ لِي .  قَالَ : فَاسْتَخْلَفَنِي  أَبُو عَامِرٍ  ، وَمَكَثَ يَسِيرًا ، ثُمَّ إِنَّهُ مَاتَ ، فَلَمَّا رَجَعْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلْتُ عَلَيْهِ وَهُوَ فِي بَيْتٍ عَلَى سَرِيرٍ ، وَقَدْ أَثَّرَ السَّرِيرُ بِظَهْرِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَجَنْبَيْهِ ، فَأَخْبَرْتُهُ خَبَرَنَا ، وَخَبَرَ  أَبِي عَامِرٍ  ، فَقُلْتُ : إِنَّهُ قَدْ قَالَ : اسْتَغْفِرْ لِي . قَالَ : فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمَاءٍ فَتَوَضَّأَ مِنْهُ ، ثُمَّ رَفَعَ يَدَيْهِ ، ثُمَّ قَالَ : اللَّهُمَّ اغْفِرْ  لِعُبَيْدٍ أَبِي عَامِرٍ  ، ثُمَّ قَالَ : اللَّهُمَّ اجْعَلْهُ يَوْمَ الْقِيَامَةِ فَوْقَ كَثِيرٍ مِنْ خَلْقِكَ ، وَمِنَ النَّاسِ .  فَقُلْتُ : وَلِي يَا رَسُولَ اللهِ فَاسْتَغْفِرْ ، فَقَالَ         [13/301]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اللَّهُمَّ اغْفِرْ  لِعَبْدِ اللهِ بْنِ قَيْسٍ  ذَنْبَهُ ، وَأَدْخِلْهُ مُدْخَلًا كَرِيمًا  .  قَالَ  أَبُو بُرْدَةَ  : إِحْدَاهُمَا  لِأَبِي عَامِرٍ  وَالْأُخْرَى  لِأَبِي مُوسَى  .","","Musnad Abi Ya'la al-Mawsili 7313","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7317","94 - (  7314  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  كُنْتُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَازِلًا  بِالْجِعْرَانَةِ  بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  ، وَمَعَهُ  بِلَالٌ  ، فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلٌ أَعْرَابِيٌّ  ، فَقَالَ لَهُ :  أَلَا تُنْجِزُ لِي يَا  مُحَمَّدُ  مَا وَعَدْتَنِي ؟ فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَبْشِرْ  فَقَالَ لَهُ الْأَعْرَابِيُّ : قَدْ أَكْثَرْتَ عَلَيَّ مِنَ الْبِشْرِ . قَالَ : فَأَقْبَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  أَبِي مُوسَى  وَبِلَالٍ  كَهَيْئَةِ الْغَضْبَانِ ، فَقَالَ : إِنَّ هَذَا قَدْ رَدَّ الْبُشْرَى ، فَاقْبَلَا أَنْتُمَا ، فَقَالَا : قَبِلْنَا يَا رَسُولَ اللهِ .         [13/302]      قَالَ : فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَدَحٍ فِيهِ مَاءٌ فَغَسَلَ يَدَيْهِ وَوَجْهَهُ وَمَجَّ فِيهِ ، ثُمَّ قَالَ لَهُمَا : اشْرَبَا مِنْهُ ، وَأَفْرِغَا عَلَى وُجُوهِكُمَا وَنُحُورِكُمَا ، فَأَخَذَا الْقَدَحَ فَفَعَلَا مَا أَمَرَهُمَا بِهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَنَادَتْنَا  أُمُّ سَلَمَةَ  مِنْ وَرَاءِ السِّتْرِ أَنْ أَفْضِلَا لِأُمِّكُمَا مِمَّا فِي إِنَائِكُمَا ، فَأَفْضَلَا لَهَا مِنْهُ طَائِفَةً  .","","Musnad Abi Ya'la al-Mawsili 7314","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7318","95 - (  7315  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  وُلِدَ لِي غُلَامٌ ، فَأَتَيْتُ بِهِ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَسَمَّاهُ  إِبْرَاهِيمَ  ،  وَحَنَّكَهُ  بِتَمْرَةٍ ، وَدَعَا لَهُ بِالْبَرَكَةِ ، وَدَفَعَهُ إِلَيَّ ، وَكَانَ أَكْبَرَ وَلَدِ  أَبِي مُوسَى  .         [13/303]","","Musnad Abi Ya'la al-Mawsili 7315","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7319","96 - (  7316  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  بَلَغَنَا مَخْرَجُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَحْنُ  بِالْيَمَنِ  ، فَخَرَجْنَا مُهَاجِرِينَ إِلَيْهِ  ، وَأَخَوَانِ لِي أَنَا أَصْغَرُهُمَا : أَحَدُهُمَا  أَبُو بُرْدَةَ  ، وَالْآخَرُ  أَبُو رُهْمٍ  -  إِمَّا قَالَ :  بِضْعٌ  ، وَإِمَّا قَالَ : فِي ثَلَاثَةٍ أَوِ اثْنَيْنِ وَخَمْسِينَ رَجُلًا مِنْ قَوْمِي  ، فَرَكِبْنَا سَفِينَةً ، فَأَلْقَتْنَا سَفِينَتُنَا إِلَى  النَّجَاشِيِّ  بِالْحَبَشَةِ  ، فَوَافَقْنَا  جَعْفَرَ بْنَ أَبِي طَالِبٍ  وَأَصْحَابَهُ عِنْدَهُ .  قَالَ  جَعْفَرٌ  : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَنَا وَأَمَرَنَا بِالْإِقَامَةِ ، فَأَقِيمُوا مَعَنَا ، فَأَقَمْنَا مَعَهُ حَتَّى قَدِمْنَا جَمِيعًا قَالَ : فَوَافَقْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ  فَتْحِ خَيْبَرَ  ،  فَأَسْهَمَ لَنَا - أَوْ قَالَ : فَأَعْطَانَا مِنْهَا  ، وَمَا قَسَمَ لِأَحَدٍ غَابَ عَنْ فَتْحٍ - يَعْنِي :  خَيْبَرَ  - شَيْئًا إِلَّا لِمَنْ شَهِدَ مَعَهُ إِلَّا أَصْحَابَ سَفِينَتِنَا مَعَ         [13/304]      جَعْفَرٍ  وَأَصْحَابِهِ ، قَسَمَ لَهُمْ مَعَهُمْ .  قَالَ : فَكَانَ نَاسٌ مِنَ النَّاسِ يَقُولُونَ لَنَا -  يَعْنِي أَهْلَ السَّفِينَةِ  - : سَبَقْنَاكُمْ بِالْهِجْرَةِ . قَالَ : فَدَخَلَتْ  أَسْمَاءُ بِنْتُ عُمَيْسٍ  - وَهِيَ مِمَّنْ قَدِمَ مَعَنَا - عَلَى  حَفْصَةَ  زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - زَائِرَةً ، وَقَدْ كَانَتْ هَاجَرَتْ إِلَى  النَّجَاشِيِّ  فِيمَنْ هَاجَرَ إِلَيْهِ ، فَدَخَلَ  عُمَرُ  عَلَى  حَفْصَةَ  -  وَأَسْمَاءُ  عِنْدَهَا - فَقَالَ  عُمَرُ  حِينَ رَأَى  أَسْمَاءَ  : مَنْ هَذِهِ ؟ قَالَتْ :  أَسْمَاءُ بِنْتُ عُمَيْسٍ  ، قَالَ  عُمَرُ  : الْحَبَشِيَّةُ هَذِهِ ؟ الْبَحْرِيَّةُ هَذِهِ ؟ فَقَالَتْ  أَسْمَاءُ  : نَعَمْ ، قَالَ  عُمَرُ  : سَبَقْنَاكُمْ بِالْهِجْرَةِ ، نَحْنُ .  أَحَقُّ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَغَضِبَتْ ، وَقَالَتْ كَلِمَةً : يَا  عُمَرُ  ، كَلَّا وَاللهِ ، كُنْتُمْ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُطْعِمُ جَائِعَكُمْ ، وَيَعِظُ جَاهِلَكُمْ ،  وَكُنَّا فِي دَارِ - أَوْ فِي أَرْضِ  الْبُعَدَاءِ  الْبُغَضَاءِ  بِالْحَبَشَةِ  ، وَذَلِكَ فِي اللهِ وَفِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَايْمُ اللهِ لَا أَطْعَمُ طَعَامًا ، وَلَا أَشْرَبُ شَرَابًا حَتَّى أَذْكُرَ مَا قُلْتَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَحْنُ كُنَّا نُؤْذَى وَنُخَافُ ، وَسَأَذْكُرُ ذَلِكَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَسْأَلُهُ ، وَاللهِ لَا أَكْذِبُ ، وَلَا  أَزِيغُ  وَلَا أَزِيدُ عَلَى ذَلِكَ ، فَلَمَّا جَاءَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : يَا نَبِيَّ اللهِ ، إِنَّ  عُمَرَ  قَالَ :         [13/305]      كَذَا وَكَذَا ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَمَا قُلْتِ لَهُ ؟ قَالَتْ : قُلْتُ كَذَا وَكَذَا ، قَالَ : لَيْسَ بِأَحَقَّ بِي مِنْكُمْ ، وَلَهُ وَلِأَصْحَابِهِ هِجْرَةٌ وَاحِدَةٌ ، وَلَكُمْ أَنْتُمْ أَهْلَ السَّفِينَةِ هِجْرَتَانِ ، قَالَتْ : فَلَقَدْ رَأَيْتُ  أَبَا مُوسَى  وَأَصْحَابَ السَّفِينَةِ يَأْتُونَنِي أَرْسَالًا يَسْأَلُونَنِي عَنْ هَذَا الْحَدِيثِ ، مَا مِنَ الدُّنْيَا شَيْءٌ هُمْ بِهِ أَفْرَحُ وَلَا أَعْظَمُ فِي أَنْفُسِهِمْ مِمَّا قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  أَبُو بُرْدَةَ  : قَالَتْ  أَسْمَاءُ  : فَلَقَدْ رَأَيْتُ  أَبَا مُوسَى  ، وَإِنَّهُ لَيَسْتَعِيدُ هَذَا الْحَدِيثَ مِنِّي  .  97 - (  7317  ) -  وَحَدَّثَنَا  مَرَّةً أُخْرَى ، وَقَالَ :  لَكُمُ الْهِجْرَةُ مَرَّتَيْنِ : هَاجَرْتُمْ إِلَى  النَّجَاشِيِّ  وَهَاجَرْتُمْ إِلَيَّ  .","","Musnad Abi Ya'la al-Mawsili 7316","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7320","98 - (  7318  ) -  وَعَنْ  أَبِي مُوسَى قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنِّي لَأَعْرِفُ أَصْوَاتَ رُفْقَةِ  الْأَشْعَرِيِّينَ  بِالْقُرْآنِ  ، وَإِنْ كُنْتُ لَا أَرَى مَنَازِلَهُمْ حِينَ نَزَلُوا بِالنَّهَارِ ، وَأَعْرِفُ مَنَازِلَهُمْ مِنْ أَصْوَاتِهِمْ بِالْقُرْآنِ بِاللَّيْلِ ، وَمِنْهُمْ حَكِيمٌ إِذَا لَقِيَ         [13/306]      الْخَيْلَ - أَوْ قَالَ : الْعَدُوَّ  - قَالَ لَهُمْ : إِنَّ أَصْحَابِي يَأْمُرُونَكُمْ أَنْ تَنْتَظِرُوهُمْ  .","","Musnad Abi Ya'la al-Mawsili 7318","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7321","99 - (  7319  ) -  وَعَنْ  أَبِي مُوسَى قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا بَعَثَ أَحَدًا مِنْ أَصْحَابِهِ فِي بَعْضِ أَمْرِهِ قَالَ :  بَشِّرُوا وَلَا  تُنَفِّرُوا ،  وَيَسِّرُوا وَلَا تُعَسِّرُوا  .","","Musnad Abi Ya'la al-Mawsili 7319","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7322","100 - (  7320  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  بُرَيْدٌ ،  عَنْ  أَبِي بُرْدَةَ ،         [13/307]      عَنْ  أَبِي مُوسَى  قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَا وَرَجُلَانِ مِنْ بَنِي عَمِّي ، فَقَالَ أَحَدُ الرَّجُلَيْنِ : أَيْ رَسُولَ اللهِ ، أَمِّرْنَا عَلَى بَعْضِ مَا وَلَّاكَ اللهُ ، وَقَالَ الْآخَرُ مِثْلَ ذَلِكَ ، فَقَالَ :  إِنَّا وَاللهِ لَا نُوَلِّي هَذَا الْعَمَلَ أَحَدًا سَأَلَهُ ، وَلَا أَحَدًا حَرَصَ عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 7320","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7323","101 - (  7321  ) -  وَعَنْ  أَبِي مُوسَى قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  الْمُؤْمِنُ لِلْمُؤْمِنِ كَالْبُنْيَانِ يَشُدُّ بَعْضُهُ بَعْضًا  ، ثُمَّ  شَبَّكَ  بَيْنَ أَصَابِعِهِ  .","","Musnad Abi Ya'la al-Mawsili 7321","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن بريد بن عبد الله بن أبي بردة عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7324","102 - (  7322  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  بُرَيْدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي مُوسَى  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ اللهَ  لَيُمْلِي  لِلظَّالِمِ حَتَّى إِذَا أَخَذَهُ لَمْ  يُفْلِتْهُ  ، ثُمَّ قَرَأَ :         {      وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ إِنَّ أَخْذَهُ أَلِيمٌ شَدِيدٌ         }      .         [13/308]","","Musnad Abi Ya'la al-Mawsili 7322","","أبو موسى الأشعري عن عبد الله بن أبي بردة الأشعري عن بريد بن عبد الله بن أبي بردة عن أبو معاوية الضرير عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7325","103 - (  7323  ) -  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْعَلَّافُ ،  حَدَّثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ الْقُرَشِيُّ ،  عَنْ  مُطَرِّفٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ كَانَتْ لَهُ جَارِيَةٌ فَأَحْسَنَ إِلَيْهَا ، وَأَدَّبَهَا ، وَأَعْتَقَهَا ، وَتَزَوَّجَهَا ، فَلَهُ أَجْرَانِ  .","","Musnad Abi Ya'la al-Mawsili 7323","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن الشعبي عن مطرف بن طريف عن أسباط بن محمد بن ميسرة القرشي عن عبد الله بن عبد الرحمن العلاف عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7326","104 - (  7324  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  أَبُو عِمْرَانَ الْجَوْنِيُّ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ اللهِ بْنِ قَيْسٍ قَالَ :  سَمِعْتُ  أَبِي  وَهُوَ بِحَضْرَةِ الْعَدُوِّ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ أَبْوَابَ الْجَنَّةِ تَحْتَ  ظِلَالِ  السُّيُوفِ  قَالَ : فَقَامَ رَجُلٌ مِنَ  الْقَوْمِ  رَثُّ الْهَيْئَةِ ، فَقَالَ : يَا  أَبَا مُوسَى  ، آنْتَ سَمِعْتَ هَذَا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : نَعَمْ . قَالَ : فَرَجَعَ إِلَى أَصْحَابِهِ ، فَقَالَ : أَقْرَأُ عَلَيْكُمُ السَّلَامَ ، ثُمَّ كَسَرَ جَفْنَ سَيْفِهِ ، فَأَلْقَاهُ ، ثُمَّ مَشَى بِسَيْفِهِ إِلَى الْعَدُوِّ فَقَاتَلَ حَتَّى قُتِلَ  .         [13/309]","","Musnad Abi Ya'la al-Mawsili 7324","","أبو موسى الأشعري عن أبو بكر بن أبي موسى الأشعري عن عبد الملك بن حبيب الجوني عن جعفر بن سليمان الضبعي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7327","105 - (  7325  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،         [13/310]      عَنْ  أَبِي مُوسَى قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  عُودُوا الْمَرِيضَ ، وَأَطْعِمُوا الْجَائِعَ ،  وَفُكُّوا  الْعَانِيَ  ،  يَعْنِي : الْأَسِيرَ  .         [13/311]","","Musnad Abi Ya'la al-Mawsili 7325","","أبو موسى الأشعري عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7328","106 - (  7326  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  قَتَادَةَ ،  عَنْ  يُونُسَ بْنِ جُبَيْرٍ أَبِي غَلَّابٍ ،  عَنْ  حِطَّانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا كَبَّرَ -  يَعْنِي : الْإِمَامَ  - فَكَبِّرُوا ، وَإِذَا قَرَأَ  فَأَنْصِتُوا  .","","Musnad Abi Ya'la al-Mawsili 7326","","أبو موسى الأشعري عن حطان بن عبد الله الرقاشي عن يونس بن جبير الباهلي عن قتادة بن دعامة عن سليمان بن طرخان عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7329","107 - (  7327  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَامِرِ بْنِ زُرَارَةَ الْحَضْرَمِيُّ الْكُوفِيُّ  ثِقَةٌ  ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي بُرْدَةَ بْنِ أَبِي مُوسَى ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  تُسْتَأْمَرُ  الْيَتِيمَةُ  فِي نَفْسِهَا ، فَإِنْ سَكَتَتْ فَقَدْ أَذِنَتْ ، وَإِنْ أَبَتْ لَمْ تُكْرَهْ  .         [13/312]","","Musnad Abi Ya'la al-Mawsili 7327","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن يونس بن أبي إسحاق عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عامر بن زرارة الحضرمي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7330","108 - (  7328  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَامِرٍ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 7328","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عامر بن زرارة الحضرمي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7331","109 - (  7329  ) -  حَدَّثَنَا  عَاصِمُ بْنُ النَّضْرِ الْأَحْوَلُ ،  حَدَّثَنَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  سَمِعْتُ  أَبِي  ،  حَدَّثَنَا  أَبُو عُثْمَانَ ،  عَنْ  أَنَسِ بْنِ جَنْدَلٍ -  يُحَدِّثُهُ  أَنَسٌ أَنَّهُ -         [13/313]      سَمِعَ  مِنْ أَبِي مُوسَى ، يَقُولُ :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَدَّثَ بِفِتْنَةٍ ، النَّائِمُ فِيهَا خَيْرٌ مِنَ الْجَالِسِ ، وَالْجَالِسُ فِيهَا خَيْرٌ مِنَ الْقَائِمِ  ، وَالْقَائِمُ فِيهَا خَيْرٌ مِنَ السَّاعِي ، أَوْ كَمَا قَالَ  .         [13/314]","","Musnad Abi Ya'la al-Mawsili 7329","","أبو موسى الأشعري عن أنس بن جندل البصري عن أبو عثمان السلي عن سليمان بن طرخان عن معتمر بن سليمان عن عاصم بن النضر الأحول عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7332","110 - (  7330  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ الْهَرَوِيُّ ،  حَدَّثَنَا  جَعْفَرٌ ،  عَنْ  أَبِي عِمْرَانَ ،  عَنْ  أَبِي بَكْرِ بْنِ أَبِي مُوسَى قَالَ :  سَمِعْتُ  أَبَا مُوسَى ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  أَبْوَابُ الْجَنَّةِ تَحْتَ  ظِلَالِ  السُّيُوفِ  .  قَالَ : فَقَالَ رَجُلٌ رَثُّ الْهَيْئَةِ : يَا  أَبَا مُوسَى  ، أَنْتَ سَمِعْتَهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : نَعَمْ . قَالَ : فَجَاءَ إِلَى أَصْحَابِهِ ، فَقَالَ : أَقْرَأُ عَلَيْكُمُ السَّلَامَ ، ثُمَّ كَسَرَ جَفْنَ سَيْفِهِ ، ثُمَّ رَمَى بِهِ إِلَى الْعَدُوِّ ، فَضَرَبَ بِهِ حَتَّى قُتِلَ  .","","Musnad Abi Ya'la al-Mawsili 7330","","أبو موسى الأشعري عن أبو بكر بن أبي موسى الأشعري عن عبد الملك بن حبيب الجوني عن جعفر بن سليمان الضبعي عن إبراهيم بن عبد الله الهروي عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7333","111 - (  7331  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الصَّمَدِ الْعَمِّيُّ ،  حَدَّثَنَا  أَبُو عِمْرَانَ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ اللهِ بْنِ قَيْسٍ ،  عَنْ  أَبِيهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  جَنَّتَانِ مِنْ فِضَّةٍ آنِيَتُهُمَا وَمَا فِيهِمَا ، وَجَنَّتَانِ مِنْ ذَهَبٍ آنِيَتُهُمَا وَمَا فِيهِمَا  ، وَلَيْسَ بَيْنَ  الْقَوْمِ  وَبَيْنَ أَنْ يَنْظُرُوا إِلَى رَبِّهِمْ - عَزَّ وَجَلَّ - إِلَّا رِدَاءُ الْكِبْرِيَاءِ عَلَى وَجْهِهِ فِي جَنَّةِ عَدْنٍ  .         [13/315]","","Musnad Abi Ya'la al-Mawsili 7331","","أبو موسى الأشعري عن أبو بكر بن أبي موسى الأشعري عن عبد الملك بن حبيب الجوني عن عبد العزيز بن عبد الصمد العمي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7334","112 - (  7332  ) -  وَعَنْ  أَبِيهِ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ فِي الْجَنَّةِ خَيْمَةً مِنْ لُؤْلُؤَةٍ مُجَوَّفَةٍ  ، عَرْضُهَا سِتُّونَ مِيلًا ، فِي كُلِّ زَاوِيَةٍ مِنْهَا أَهْلٌ لَا يَرَاهُمُ الْآخَرُونَ ، يَطُوفُ عَلَيْهِمُ الْمُؤْمِنُ  .         [13/316]","","Musnad Abi Ya'la al-Mawsili 7332","","أبو موسى الأشعري عن أبو بكر بن أبي موسى الأشعري عن عبد الملك بن حبيب الجوني عن عبد العزيز بن عبد الصمد العمي عن إسحاق ابن راهويه عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7335","113 - (  7333  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  أَبُو أُسَامَةَ قَالَ :  حَدَّثَنِي  أَبُو عُمَيْسِ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ الْجَدَلِيِّ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنْ  أَبِي مُوسَى قَالَ :  كَانَ يَوْمُ عَاشُورَاءَ يَوْمًا تَصُومُهُ الْيَهُودُ وَيُعَظِّمُونَهُ  ، فَلَمَّا قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْمَدِينَةَ  أَمَرَ بِصَوْمِهِ  .         [13/317]","","Musnad Abi Ya'la al-Mawsili 7333","","أبو موسى الأشعري عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن عتبة بن عبد الله بن عتبة المسعودي عن حماد بن أسامة القرشي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7336","114 - (  7334  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  حَدَّثَنَا  شُعْبَةُ ، أَوْ سَعِيدٌ  ،  عَنْ  غَالِبٍ التَّمَّارِ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  مَسْرُوقِ بْنِ أَوْسٍ : أَنَّ أَبَا مُوسَى  حَدَّثَهُ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَضَى فِي الْأَصَابِعِ عَشْرًا عَشْرًا  .         [13/318]             [13/319]","","Musnad Abi Ya'la al-Mawsili 7334","","أبو موسى الأشعري عن مسروق بن أوس اليربوعي عن حميد بن هلال العدوي عن غالب بن مهران التمار عن سعيد بن أبي عروبة عن النضر بن شميل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7337","115 - (  7335  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  غَالِبٍ التَّمَّارِ ،  عَنْ  مَسْرُوقِ بْنِ أَوْسٍ ،  عَنْ  أَبِي مُوسَى ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَضَى فِي الْأَصَابِعِ عَشْرًا عَشْرًا  .","","Musnad Abi Ya'la al-Mawsili 7335","","أبو موسى الأشعري عن مسروق بن أوس اليربوعي عن غالب بن مهران التمار عن إسماعيل ابن علية عن إسحاق ابن راهويه عن أبو يعلى الموصلي","حديث أبي موسى الأشعري"
"7338","[13/320]      مُسْنَدُ  عَمْرِو بْنِ الْعَاصِ  رَضِيَ اللهُ عَنْهُ  1 - (  7336  ) -  وَبِهِ  أَخْبَرَنَا أَبُو الْقَاسِمِ زَاهِرُ بْنُ طَاهِرِ بْنِ         [13/321]      مُحَمَّدٍ الشَّحَّامِيُّ  قِرَاءَةً عَلَيْهِ  ،  أَخْبَرَنَا أَبُو سَعْدٍ مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مُحَمَّدٍ الْجَنْزَرُوذِيُّ  قِرَاءَةً عَلَيْهِ  ،  أَخْبَرَنَا أَبُو عَمْرٍو مُحَمَّدُ بْنُ أَحْمَدَ بْنِ حَمْدَانَ الْحِيرِيُّ  بِقِرَاءَةِ أَبِي جَعْفَرٍ الْعَزَائِمِيِّ عَلَيْهِ  فِي رَجَبٍ سَنَةَ خَمْسٍ وَسَبْعِينَ وَثَلَاثِمِائَةٍ ،  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعُ بْنُ الْجَرَّاحِ ،  عَنْ  مُوسَى بْنِ عُلَيٍّ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  عَمْرَو بْنَ الْعَاصِ ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  اشْدُدْ عَلَيْكَ ثِيَابَكَ قَالَ : فَفَعَلْتُ ، ثُمَّ أَتَيْتُهُ فَوَجَدْتُهُ يَتَوَضَّأُ ، فَرَفَعَ رَأْسَهُ ،  فَصَعَّدَ  فِيَّ الْبَصَرَ  وَصَوَّبَهُ  ، ثُمَّ قَالَ : يَا  عَمْرُو  ، إِنِّي أُرِيدُ أَنْ أَبْعَثَكَ وَجْهًا ، فَيُسَلِّمَكَ اللهُ وَيُغْنِمَكَ ، وَأَرْغَبُ لَكَ مِنَ الْمَالِ رَغْبَةً صَالِحَةً . قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ! إِنِّي لَمْ أُسْلِمْ         [13/322]      رَغْبَةً فِي الْمَالِ ، إِنَّمَا أَسْلَمْتُ رَغْبَةً فِي  الْجِهَادِ  وَالْكَيْنُونَةِ مَعَكَ ، فَقَالَ : يَا  عَمْرُو  ،  نِعِمَّا  بِالْمَالِ الصَّالِحِ لِلرَّجُلِ الصَّالِحِ  "" .","","Musnad Abi Ya'la al-Mawsili 7336","","عمرو بن العاص بن وائل السهمي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7339","2 - (  7337  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  مُوسَى بْنِ عُلَيٍّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي قَيْسٍ مَوْلَى عَمْرِو بْنِ الْعَاصِ ،  عَنْ  عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  فَصْلٌ بَيْنَ صِيَامِكُمْ وَصِيَامِ أَهْلِ الْكِتَابِ أَكْلَةُ السَّحَرِ  "" .         [13/323]","","Musnad Abi Ya'la al-Mawsili 7337","","عمرو بن العاص بن وائل السهمي عن عبد الرحمن بن ثابت السهمي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7340","3 - (  7338  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  سَعِيدٍ ،  عَنْ  مَطَرٍ ،  عَنْ  رَجَاءٍ ،  عَنْ  قَبِيصَةَ ،  عَنْ  عَمْرِو بْنِ الْعَاصِ قَالَ :  لَا تَلْبِسُوا عَلَيْنَا سُنَّةَ نَبِيِّنَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عِدَّةُ  أُمِّ الْوَلَدِ  عِدَّةُ  الْمُتَوَفَّى عَنْهَا  .         [13/324]","","Musnad Abi Ya'la al-Mawsili 7338","","عمرو بن العاص بن وائل السهمي عن قبيصة بن ذؤيب الخزاعي عن رجاء بن حيوة عن مطر بن طهمان الوراق عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7341","4 - (  7339  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ الْعَاصِ قَالَ :  مَا رَأَيْتُ  قُرَيْشًا  أَرَادُوا قَتْلَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا يَوْمَ ائْتَمَرُوا بِهِ وَهُمْ جُلُوسٌ فِي ظِلِّ  الْكَعْبَةِ  ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي عِنْدَ  الْمَقَامِ  ، فَقَامَ إِلَيْهِ  عُقْبَةُ بْنُ أَبِي         [13/325]      مُعَيْطٍ  ، فَجَعَلَ رِدَاءَهُ فِي عُنُقِهِ ، ثُمَّ جَذَبَهُ حَتَّى وَجَبَ لِرُكْبَتَيْهِ ، وَتَصَايَحَ النَّاسُ ، وَظَنُّوا أَنَّهُ مَقْتُولٌ . قَالَ : وَأَقْبَلَ  أَبُو بَكْرٍ  يَشْتَدُّ حَتَّى أَخَذَ بِضَبْعِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ وَرَائِهِ ، وَهُوَ يَقُولُ : أَيَقْتُلُونَ رَجُلًا أَنْ يَقُولَ رَبِّيَ اللهُ ؟ ! ثُمَّ انْصَرَفُوا عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا قَضَى صَلَاتَهُ ، مَرَّ بِهِمْ وَهُمْ جُلُوسٌ فِي ظِلِّ  الْكَعْبَةِ  ، فَقَالَ :  يَا مَعْشَرَ  قُرَيْشٍ  ، أَمَا وَالَّذِي نَفْسِي بِيَدِهِ مَا أُرْسِلْتُ إِلَيْكُمْ إِلَّا بِالذَّبْحِ  وَأَشَارَ بِيَدِهِ إِلَى حَلْقِهِ ، قَالَ لَهُ  أَبُو جَهْلٍ  : يَا  مُحَمَّدُ  ، مَا كُنْتَ جَهُولًا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَنْتَ مِنْهُمْ  "" .         [13/326]","","Musnad Abi Ya'la al-Mawsili 7339","","عمرو بن العاص بن وائل السهمي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن علي بن مسهر القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7342","5 - (  7340  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  الْفَضْلُ بْنُ دُكَيْنٍ ،  عَنْ  هِشَامِ بْنِ سَعْدٍ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَمْرِو بْنِ الْعَاصِ  قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَقَفَ ، ثُمَّ قَالَ :  إِنَّمَا هَلَكَ مَنْ كَانَ قَبْلَكُمْ بِسُؤَالِهِمْ أَنْبِيَاءَهُمْ  ، وَاخْتِلَافِهِمْ عَلَيْهِمْ ، فَلَنْ يُؤْمِنَ أَحَدٌ حَتَّى يُؤْمِنَ بِالْقَدَرِ كُلِّهِ خَيْرِهِ وَشَرِّهِ  .         [13/327]","","Musnad Abi Ya'la al-Mawsili 7340","","عمرو بن العاص بن وائل السهمي عن شعيب بن محمد السهمي عن عمرو بن شعيب عن هشام بن سعد المخزومي عن الفضل بن دكين عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7343","6 - (  7341  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  غُنْدَرٌ ،  عَنْ  شُعْبَةَ ،  عَنِ  الْحَكَمِ قَالَ :  سَمِعْتُ  ذَكْوَانَ  يُحَدِّثُ ، عَنْ  مَوْلًى لِعَمْرِو بْنِ الْعَاصِ  أَنَّهُ أَرْسَلَ إِلَى  عَلِيٍّ  يَسْتَأْذِنُ عَلَى  أَسْمَاءَ بِنْتِ عُمَيْسٍ  ، فَأَذِنَ لَهُ ، حَتَّى إِذَا فَرَغَ مِنْ حَاجَتِهِ ، سَأَلَ الْمَوْلَى عَمْرًا عَنْ ذَلِكَ ، فَقَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَانَا أَنْ نَدْخُلَ عَلَى النِّسَاءِ بِغَيْرِ إِذْنِ أَزْوَاجِهِنَّ  .","","Musnad Abi Ya'la al-Mawsili 7341","","عمرو بن العاص بن وائل السهمي عن مولى لعمرو بن العاص عن ذكوان السمان عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7344","7 - (  7342  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  وَرْقَاءَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  زِيَادٍ مَوْلًى لِعَمْرِو بْنِ الْعَاصِ ،  عَنْ  عَمْرِو بْنِ الْعَاصِ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  تَقْتُلُ  عَمَّارًا  الْفِئَةُ  الْبَاغِيَةُ  "" .         [13/328]","","Musnad Abi Ya'la al-Mawsili 7342","","عمرو بن العاص بن وائل السهمي عن زياد السهمي مولى عمرو بن العاص عن عمرو بن دينار الأثرم عن ورقاء بن عمر عن يحيى بن آدم عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7345","8 - (  7343  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  شَاذَانُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي جَعْفَرٍ الْخَطْمِيِّ ،  عَنْ  عُمَارَةَ بْنِ خُزَيْمَةَ قَالَ :  خَرَجْنَا مَعَ عَمْرِو بْنِ الْعَاصِ مُتَوَجِّهِينَ إِلَى  مَكَّةَ  ، فَإِذَا نَحْنُ بِامْرَأَةٍ عَلَيْهَا جَبَائِرُ لَهَا وَخَوَاتِيمُ ، وَقَدْ بَسَطَتْ يَدَهَا إِلَى الْهَوْدَجِ ، فَقَالَ : كُنَّا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَإِذَا نَحْنُ بِغِرْبَانٍ - يَعْنِي : وَفِيهَا غُرَابٌ أَعْصَمُ أَحْمَرُ الْمِنْقَارِ وَالرِّجْلَيْنِ ، فَقَالَ :  لَا يَدْخُلُ الْجَنَّةَ مِنَ النِّسَاءِ إِلَّا قَدْرُ هَذَا الْغُرَابِ فِي هَؤُلَاءِ الْغِرْبَانِ  "" .         [13/329]","","Musnad Abi Ya'la al-Mawsili 7343","","عمرو بن العاص بن وائل السهمي عن عمارة بن خزيمة الحارثي عن عمير بن يزيد بن عمير الخطمي عن حماد بن سلمة عن الأسود بن عامر شاذان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7346","9 - (  7344  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  شَبَابَةُ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  رَجُلٍ ،  عَنْ  عَمْرِو بْنِ الْعَاصِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يُجِيرُ  عَلَى الْمُسْلِمِينَ الرَّجُلُ مِنْهُمْ  "" .","","Musnad Abi Ya'la al-Mawsili 7344","","عمرو بن العاص بن وائل السهمي عن رجل عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن شبابة بن سوار المدائني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7347","10 - (  7345  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنْ  عَمْرِو بْنِ الْعَاصِ قَالَ :  قِيلَ : يَا رَسُولَ اللهِ ! أَيُّ النَّاسِ أَحَبُّ إِلَيْكَ ؟ قَالَ :  عَائِشَةُ  قَالَ : مِنَ الرِّجَالِ ؟ قَالَ :         [13/330]      ""  أَبُو بَكْرٍ  "" قَالَ : ثُمَّ مَنْ ؟ قَالَ : ثُمَّ  أَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ  .","","Musnad Abi Ya'la al-Mawsili 7345","","عمرو بن العاص بن وائل السهمي عن عبد الله بن شقيق العقيلي عن سعيد بن إياس الجريري عن حماد بن سلمة عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7348","11 - (  7346  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَرْعَرَةَ ،  حَدَّثَنَا         [13/331]      عَبْدُ الرَّزَّاقِ ،  حَدَّثَنَا  مَعْمَرٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  أَبِيهِ  قَالَ  :  دَخَلَ  عَمْرُو بْنُ حَزْمٍ  عَلَى عَمْرِو بْنِ الْعَاصِ فَقَالَ : قُتِلَ  عَمَّارٌ  وَقَدْ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَقْتُلُهُ  الْفِئَةُ  الْبَاغِيَةُ  ، فَدَخَلَ  عَمْرٌو  عَلَى  مُعَاوِيَةَ  ، فَقَالَ : قُتِلَ  عَمَّارٌ  فَقَالَ  مُعَاوِيَةُ  : قُتِلَ  عَمَّارٌ  ، فَمَاذَا ؟ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : "" تَقْتُلُهُ  الْفِئَةُ  الْبَاغِيَةُ ،  قَالَ : دُحِضْتَ فِي بَوْلِكَ ! أَنَحْنُ قَتَلْنَاهُ ؟ إِنَّمَا قَتَلَهُ عَلِيٌّ وَأَصْحَابُهُ  .","","Musnad Abi Ya'la al-Mawsili 7346","","عمرو بن العاص بن وائل السهمي عن محمد بن عمرو بن حزم النجاري عن أبو بكر بن محمد الخزرجي عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عرعرة عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7349","12 - (  7347  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  الْوَلِيدُ ،  عَنْ  يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ،  عَنْ  حِبَّانَ بْنِ أَبِي جَبَلَةَ ،  عَنْ  عَمْرِو بْنِ الْعَاصِ قَالَ :  مَا عَدَلَ بِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَبِخَالِدِ بْنِ الْوَلِيدِ  فِي حَرْبِهِ مُنْذُ أَسْلَمْنَا أَحَدًا مِنْ أَصْحَابِهِ  .         [13/332]","","Musnad Abi Ya'la al-Mawsili 7347","","عمرو بن العاص بن وائل السهمي عن حبان بن أبي جبلة المصري عن يحيى بن عبد الرحمن الكناني عن الوليد بن مسلم القرشي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7350","13 - (  7348  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  يَحْيَى الْقَطَّانُ ،  عَنْ  سُلَيْمَانَ قَالَ :  سَمِعْتُ  أَبَا صَالِحٍ ،  يَقُولُ  :  جَاءَ عَمْرُو بْنُ الْعَاصِ إِلَى مَنْزِلِ  عَلِيٍّ  يَلْتَمِسُهُ ، فَلَمْ يَقْدِرْ عَلَيْهِ ، ثُمَّ رَجَعَ فَوَجَدَهُ ، فَلَمَّا دَخَلَ كَلَّمَ  فَاطِمَةَ  ، فَقَالَ لَهُ  عَلِيٌّ  : مَا أَرَى حَاجَتَكَ إِلَى الْمَرْأَةِ ؟ قَالَ : أَجَلْ ،  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَانَا أَنْ نَدْخُلَ عَلَى  الْمُغِيبَاتِ  .","","Musnad Abi Ya'la al-Mawsili 7348","","عمرو بن العاص بن وائل السهمي عن ذكوان السمان عن الأعمش عن يحيى القطان عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7351","14 - (  7349  ) -  حَدَّثَنَا  أَبُو مُوسَى : إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْهَرَوِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  رَجَاءِ بْنِ حَيْوَةَ ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ ،         [13/333]      عَنْ  عَمْرِو بْنِ الْعَاصِ قَالَ :  لَا تَلْبِسُوا عَلَيْنَا سُنَّةَ نَبِيِّنَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عِدَّةُ  أُمِّ الْوَلَدِ إِذَا تُوُفِّيَ عَنْهَا سَيِّدُهَا أَرْبَعَةُ أَشْهُرٍ وَعَشْرٌ  .","","Musnad Abi Ya'la al-Mawsili 7349","","عمرو بن العاص بن وائل السهمي عن قبيصة بن ذؤيب الخزاعي عن رجاء بن حيوة عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن هارون عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7352","15 - (  7350  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  ابْنِ الْأَحْنَفِ ،  سَمِعَ  أَبَا سَلَّامٍ الْأَسْوَدَ ، يَقُولُ :  أَخْبَرَنِي  أَبُو صَالِحٍ الْأَشْعَرِيُّ أَنَّ أَبَا عَبْدِ اللهِ الْأَشْعَرِيَّ  حَدَّثَهُ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَصُرَ  بِرَجُلٍ  لَا يُتِمُّ رُكُوعَهُ وَلَا سُجُودَهُ  ، فَقَالَ : لَوْ مَاتَ هَذَا عَلَى مَا هُوَ عَلَيْهِ لَمَاتَ عَلَى غَيْرِ مِلَّةِ  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتِمُّوا الرُّكُوعَ وَالسُّجُودَ ، فَإِنَّ مَثَلَ الَّذِي يُصَلِّي وَلَا يُتِمُّ رُكُوعَهُ وَلَا سُجُودَهُ ، مَثَلُ الْجَائِعِ الَّذِي لَا يَأْكُلُ إِلَّا التَّمْرَةَ وَالتَّمْرَتَيْنِ ، لَا تُغْنِيَانِ عَنْهُ شَيْئًا ، قَالَ  أَبُو صَالِحٍ  : فَلَقِيتُ  أَبَا عَبْدِ اللهِ  ، فَقُلْتُ : مَنْ حَدَّثَكَ هَذَا الْحَدِيثَ أَنَّهُ سَمِعَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ :  حَدَّثَنِي  أُمَرَاءُ  الْأَجْنَادِ  : خَالِدُ بْنُ الْوَلِيدِ ، وَشُرَحْبِيلُ بْنُ حَسَنَةَ ، وَعَمْرُو بْنُ الْعَاصِ أَنَّهُمْ سَمِعُوهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Musnad Abi Ya'la al-Mawsili 7350","","عمرو بن العاص بن وائل السهمي عن أبو عبدالله الأشعري عن أبو صالح الأشعري عن ممطور الحبشي عن شيبة بن الأحنف الأوازعي عن الوليد بن مسلم القرشي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7353","16 - (  7351  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى ابْنُ بِنْتِ السُّدِّيِّ ،  حَدَّثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ         [13/334]      عَبْدِ الرَّحْمَنِ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ قَالَ :  رَجَعْتُ مَعَ  مُعَاوِيَةَ  مِنْ  صِفِّينَ  ، فَكَانَ  مُعَاوِيَةُ  ،  وَأَبُو الْأَعْوَرِ السُّلَمِيُّ  يَسِيرُونَ مِنْ جَانِبٍ ، وَرَأَيْتُهُ يَسِيرُونَ مِنْ جَانِبٍ ، فَكُنْتُ بَيْنَهُمْ لَيْسَ أَحَدٌ غَيْرِي ، فَكُنْتُ أَحْيَانًا أُوضِعُ إِلَى هَؤُلَاءِ ، وَأَحْيَانًا أُوضِعُ إِلَى هَؤُلَاءِ ،  فَسَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ لِأَبِيهِ  : أَبَةِ ، أَمَا سَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  لِعَمَّارٍ  حِينَ يَبْنِي الْمَسْجِدَ :  إِنَّكَ لَحَرِيصٌ عَلَى الْأَجْرِ قَالَ : أَجَلْ قَالَ : وَإِنَّكَ مِنْ أَهْلِ الْجَنَّةِ ، وَلَتَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  قَالَ : بَلَى ، قَدْ سَمِعْتُهُ قَالَ : فَلِمَ قَتَلْتُمُوهُ ؟ قَالَ : فَالْتَفَتَ إِلَى  مُعَاوِيَةَ  ، فَقَالَ :  يَا أَبَا عَبْدِ الرَّحْمَنِ  ، أَلَا تَسْمَعُ مَا يَقُولُ هَذَا ؟ قَالَ : أَمَا سَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  لِعَمَّارٍ  وَهُوَ يَبْنِي الْمَسْجِدَ : وَيْحَكَ ، إِنَّكَ لَحَرِيصٌ عَلَى الْأَجْرِ ، وَلَتَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  "" قَالَ : بَلَى قَدْ سَمِعْتُهُ . قَالَ : فَلِمَ قَتَلْتُمُوهُ ؟ قَالَ : وَيْحَكَ ، مَا تَزَالُ تَدْحَضُ فِي بَوْلِكَ ، أَوَنَحْنُ قَتَلْنَاهُ ؟ إِنَّمَا قَتَلَهُ مَنْ جَاءَ بِهِ  .         [13/335]","","Musnad Abi Ya'la al-Mawsili 7351","","عمرو بن العاص بن وائل السهمي عن عبد الله بن عمرو بن العاص عن عبد الله بن الحارث بن نوفل عن عبد الرحمن بن زياد الهاشمي عن الأعمش عن أسباط بن محمد بن ميسرة القرشي عن إسماعيل بن موسى الفزاري عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7354","17 - (  7352  ) -  حَدَّثَنَا  أَبُو يَعْقُوبَ إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  حَدَّثَنَا  ابْنُ عَوْنٍ ،  عَنْ  عُمَيْرِ بْنِ إِسْحَاقَ قَالَ :  اسْتَأْذَنَ  جَعْفَرٌ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : ائْذَنْ لِي أَنْ آتِيَ أَرْضًا أَعْبُدُ اللهَ فِيهَا  ، لَا أَخَافُ أَحَدًا ، فَأَذِنَ لَهُ ، فَأَتَى  النَّجَاشِيَّ  قَالَ :  فَحَدَّثَنِي  عَمْرُو بْنُ الْعَاصِ قَالَ : فَلَمَّا رَأَيْتُ مَكَانَهُ  حَسَدْتُهُ  قَالَ : قُلْتُ : وَاللهِ لَأَسْتَقْتِلَنَّ لِهَذَا وَأَصْحَابِهِ قَالَ : فَأَتَيْتُ  النَّجَاشِيَّ  ، فَدَخَلْتُ مَعَهُ عَلَيْهِ ، فَقُلْتُ : إِنَّ بِأَرْضِكَ رَجُلًا ابْنُ عَمِّهِ بِأَرْضِنَا ،         [13/336]      وَإِنَّهُ يَزْعُمُ أَنَّهُ لَيْسَ لِلنَّاسِ إِلَّا إِلَهٌ وَاحِدٌ ، وَإِنَّكَ وَاللهِ إِنْ لَمْ تَقْتُلْهُ وَأَصْحَابَهُ لَا أَقْطَعُ إِلَيْكَ هَذِهِ  النُّطْفَةَ  أَبَدًا ، لَا أَنَا ، وَلَا وَاحِدٌ مِنْ أَصْحَابِي . قَالَ : ادْعُهُ ، قُلْتُ : إِنَّهُ لَا يَجِيءُ مَعِي ، فَأَرْسِلْ مَعِي رَسُولًا قَالَ : فَجَاءَ ، فَلَمَّا انْتَهَى الْبَابَ ، نَادَيْتُ ائْذَنْ  لِعَمْرِو بْنِ الْعَاصِ  ، فَنَادَاهُ هُوَ مِنْ خَلْفِي ائْذَنْ  لِعُبَيْدِ اللهِ  قَالَ : فَسَمِعَ صَوْتَهُ ، فَأَذِنَ لَهُ قَبْلِي قَالَ : فَدَخَلَ هُوَ وَأَصْحَابُهُ قَالَ : ثُمَّ أَذِنَ لِي فَدَخَلْتُ ، فَإِذَا هُوَ جَالِسٌ . قَالَ : فَذَكَرَ أَيْنَ كَانَ مَقْعَدُهُ مِنَ السَّرِيرِ ، وَذَكَرَ الْحَدِيثَ بِطُولِهِ  .         [13/337]","","Musnad Abi Ya'la al-Mawsili 7352","","عمرو بن العاص بن وائل السهمي عن عمير بن إسحاق الهاشمي عن عبد الله بن عون بن أرطبان عن النضر بن شميل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7355","18 - (  7353  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  قَالَ  عَمْرُو بْنُ الْعَاصِ  خَرَجَ جَيْشٌ مِنَ الْمُسْلِمِينَ أَنَا أَمِيرُهُمْ حَتَّى نَزَلْنَا  الْإِسْكَنْدَرِيَّةَ  ، فَقَالَ لِي عَظِيمٌ مِنْ عُظَمَائِهِمْ : أَخْرِجُوا إِلَيَّ رَجُلًا أُكَلِّمُهُ وَيُكَلِّمُنِي ، فَقُلْتُ : لَا يَخْرُجُ إِلَيْهِ غَيْرِي فَخَرَجْتُ مَعَ  تُرْجُمَانِهِ  حَتَّى وُضِعَ لَنَا مِنْبَرَانِ فَقَالَ : مَا أَنْتُمْ ؟ فَقُلْنَا : نَحْنُ الْعَرَبُ ، وَنَحْنُ أَهْلُ الشَّوْكِ         [13/338]      وَالْقَرَظِ وَنَحْنُ أَهْلُ بَيْتِ اللهِ . كُنَّا أَضْيَقَ النَّاسِ أَرْضًا ، وَأَشَدَّهُ عَيْشًا نَأْكُلُ الْمَيْتَةَ وَالدَّمَ وَيُغِيرُ بَعْضُنَا عَلَى بَعْضٍ بِشَرِّ عَيْشٍ عَاشَ بِهِ النَّاسُ حَتَّى خَرَجَ فِينَا رَجُلٌ لَيْسَ بِأَعْظَمِنَا يَوْمَئِذٍ شَرَفًا وَلَا بِأَكْثَرِنَا مَالًا ، فَقَالَ : أَنَا رَسُولُ اللهِ إِلَيْكُمْ يَأْمُرُنَا بِأَشْيَاءَ لَا نَعْرِفُ وَيَنْهَانَا عَمَّا كُنَّا عَلَيْهِ وَكَانَتْ عَلَيْهِ آبَاؤُنَا  فَشَنَّفْنَا  لَهُ ، وَكَذَّبْنَاهُ وَرَدَدْنَا عَلَيْهِ مَقَالَتَهُ حَتَّى خَرَجَ إِلَيْهِ قَوْمٌ مِنْ غَيْرِنَا فَقَالُوا : نَحْنُ نُصَدِّقُكَ وَنُؤْمِنُ بِكَ وَنَتَّبِعُكَ وَنُقَاتِلُ مَنْ قَاتَلَكَ ، فَخَرَجَ إِلَيْهِمْ ، وَخَرَجْنَا إِلَيْهِ فَقَاتَلْنَاهُ فَقَتَلَنَا وَظَهَرَ عَلَيْنَا وَغَلَبَنَا وَتَنَاوَلَ مَنْ يَلِيهِ مِنَ الْعَرَبِ فَقَاتَلَهُمْ حَتَّى ظَهَرَ عَلَيْهِمْ فَلَوْ يَعْلَمُ مَنْ وَرَائِي مِنَ الْعَرَبِ مَا أَنْتُمْ فِيهِ مِنَ الْعَيْشِ لَمْ يَبْقَ أَحَدٌ إِلَّا جَاءَكُمْ حَتَّى يَشْرَكَكُمْ فِيمَا أَنْتُمْ فِيهِ مِنَ الْعَيْشِ فَضَحِكَ ، ثُمَّ قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ صَدَقَ قَدْ جَاءَتْنَا رُسُلُنَا بِمِثْلِ الَّذِي جَاءَ بِهِ رَسُولُكُمْ فَكُنَّا عَلَيْهِ حَتَّى ظَهَرَتْ فِينَا مُلُوكٌ فَجَعَلُوا يَعْمَلُونَ فِيهَا بِأَهْوَائِهِمْ ، وَيَتْرُكُونَ أَمْرَ الْأَنْبِيَاءِ ، فَإِنْ         [13/339]      أَنْتُمْ أَخَذْتُمْ بِأَمْرِ نَبِيِّكُمْ لَمْ يُقَاتِلْكُمْ أَحَدٌ إِلَّا غَلَبْتُمُوهُ ، وَلَمْ يُشَارِرْكُمْ أَحَدٌ إِلَّا ظَهَرْتُمْ عَلَيْهِ ، فَإِذَا فَعَلْتُمْ مِثْلَ الَّذِي فَعَلْنَا فَتَرَكْتُمْ أَمْرَ نَبِيِّكُمْ وَعَمِلْتُمْ مِثْلَ الَّذِي عَمِلُوا بِأَهْوَائِهِمْ يُخَلَّى بَيْنَنَا وَبَيْنَكُمْ ، فَلَمْ تَكُونُوا أَكْثَرَ عَدَدًا مِنَّا وَلَا أَشَدَّ قُوَّةً مِنَّا . قَالَ  عَمْرُو بْنُ الْعَاصِ  : فَمَا كَلَّمْتُ رَجُلًا أَذْكَرَ مِنْهُ  .","","Musnad Abi Ya'la al-Mawsili 7353","","عمرو بن العاص بن وائل السهمي عن علقمة بن وقاص العتواري عن عمرو بن علقمة بن وقاص الليثي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند عمرو بن العاص رضي الله عنه"
"7356","[13/340]      حَدِيثُ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  رَضِيَ اللهُ عَنْهُ  1 - (  7354  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ،  حَدَّثَنَا  وَهْبُ بْنُ         [13/341]      جَرِيرٍ ،  حَدَّثَنَا  أَبِي  قَالَ :  سَمِعْتُ  يَحْيَى بْنَ أَيُّوبَ  يُحَدِّثُ ، عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِنَّمَا أَنَا خَازِنٌ ، وَإِنَّمَا يُعْطِي اللهُ  ، فَمَنْ أَعْطَيْتُهُ عَطَاءً وَأَنَا بِهِ طَيِّبُ النَّفْسِ ، بُورِكَ لَهُ فِيهِ ، وَمَنْ أَعْطَيْتُهُ عَطَاءً عَنْ شَرَهِ نَفْسٍ وَشِدَّةِ مَسْأَلَةٍ ، فَهُوَ كَالَّذِي يَأْكُلُ وَلَا يَشْبَعُ  "" .","","Musnad Abi Ya'la al-Mawsili 7354","","معاوية بن أبي سفيان عن عبد الله بن عامر بن يزيد اليحصبي عن جعفر بن ربيعة الكندي عن يزيد بن أبي حبيب الأزدي عن يحيى بن أيوب الغافقي عن جرير بن حازم عن وهب بن جرير بن حازم عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7357","2 - (  7355  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ قَالَ :  حَدَّثَنِي  عَلِيُّ بْنُ مَيْمُونٍ الرَّقِّيُّ ،  حَدَّثَنَا  خَالِدُ بْنُ حَيَّانَ أَبُو يَزِيدَ الْخَرَّازُ ،  عَنْ         [13/342]      سُلَيْمَانَ بْنِ عَبْدِ اللهِ بْنِ الزِّبْرِقَانِ ،  عَنْ  يَعْلَى بْنِ أَوْسٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  كُلُّ مُسْكِرٍ عَلَى كُلِّ مُؤْمِنٍ حَرَامٌ  "" .","","Musnad Abi Ya'la al-Mawsili 7355","","معاوية بن أبي سفيان عن يعلى بن شداد بن أوس الخزرجي عن سليمان بن عبد الله بن الزبرقان الأنطاكي عن خالد بن حيان الرقي عن علي بن ميمون الرقي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7358","3 - (  7356  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  الْوَلِيدُ ،  عَنِ  ابْنِ جُرَيْجٍ قَالَ :  أَخْبَرَنِي  عُمَرُ بْنُ عَطَاءٍ  أَنَّ نَافِعَ بْنَ جُبَيْرٍ أَرْسَلَهُ إِلَى السَّائِبِ بْنِ يَزِيدَ أَنْ  يَسْأَلَهُ  ، فَقَالَ لَهُ  السَّائِبُ  : صَلَّيْتُ الْجُمُعَةَ مَعَ مُعَاوِيَةَ فِي الْمَقْصُورَةِ ، فَلَمَّا         [13/343]      سَلَّمْتُ ، قُمْتُ أُصَلِّي ، فَقَالَ لِي :  إِذَا صَلَّيْتَ الْجُمُعَةَ ، فَلَا تَصِلْهَا بِصَلَاةٍ إِلَّا أَنْ تَكَلَّمَ أَوْ تَخْرُجَ ، فَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ بِذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 7356","","معاوية بن أبي سفيان عن السائب بن يزيد الكندي عن عمر بن عطاء بن أبي الخوار العامري عن ابن جريج عن الوليد بن مسلم القرشي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7359","4 - (  7357  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  فُلَيْحٌ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  مُعَاوِيَةَ ، يَقُولُ وَهُوَ عَلَى الْمِنْبَرِ ، وَفِي يَدِهِ  قُصَّةٌ  مِنْ شَعَرٍ : مَا بَالُ نِسَائِكُمْ يَجْعَلْنَ فِي رُؤُوسِهِنَّ مِثْلَ هَذَا ؟ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنِ امْرَأَةٍ تَجْعَلُ فِي رَأْسِهَا شَعَرًا مِنْ شَعَرِ غَيْرِهَا إِلَّا كَانَ زُورًا  .         [13/344]             [13/345]","","Musnad Abi Ya'la al-Mawsili 7357","","معاوية بن أبي سفيان عن أبو سعيد المقبري عن سعيد المقبري عن فليح بن سليمان عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7360","5 - (  7358  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 7358","","معاوية بن أبي سفيان عن أبو سعيد المقبري عن سعيد المقبري عن زيد بن أسلم عن إسماعيل بن عياش الأحول عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7361","6 - (  7359  ) -  حَدَّثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الْجَبَّارِ أَبُو أَيُّوبَ الرَّقِّيُّ ،  حَدَّثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  رَجُلٍ ،  عَنْ  مُعَاوِيَةَ  أَنَّهُ رَأَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكَلَ لَبَأً ، ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  .         [13/346]","","Musnad Abi Ya'la al-Mawsili 7359","","معاوية بن أبي سفيان عن رجل عن محمد بن المنكدر عن ابن جريج عن أبو عاصم النبيل عن سليمان بن عبد الجبار الخياط عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7362","7 - (  7360  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ الْعَنْبَرِيُّ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  شُعْبَةَ ،  عَنْ  أَبِي التَّيَّاحِ قَالَ :  سَمِعْتُ  حُمْرَانَ بْنَ أَبَانَ ،  يَقُولُ  : خَطَبَنَا مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ ، فَقَالَ :  إِنَّكُمْ لَتُصَلُّونَ صَلَاةً مَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّيهَا  ، وَلَقَدْ كَانَ يَنْهَى عَنْهَا ،  يَعْنِي : الرَّكْعَتَيْنِ بَعْدَ الْعَصْرِ  .","","Musnad Abi Ya'la al-Mawsili 7360","","معاوية بن أبي سفيان عن حمران بن أبان النمري عن يزيد بن حميد الضبعي عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7363","8 - (  7361  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ جَابِرٍ قَالَ :  حَدَّثَنِي  ابْنُ أَبِي الْمُهَاجِرِ - أَوْ أَبُو عَبْدِ رَبٍّ  ،  الْوَلِيدُ  شَكَّ  - قَالَ :         [13/347]      سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِنَّ رَجُلًا مِمَّنْ كَانَ قَبْلَكُمْ لَقِيَ رَجُلًا  عَالِمًا - أَوْ عَابِدًا  - فَقَالَ : إِنَّ الْآخَرَ قَتَلَ تِسْعَةً وَتِسْعِينَ نَفْسًا  ، كُلُّهَا يَقْتُلُهَا ظُلْمًا ، فَهَلْ تَجِدُ لِي مِنْ تَوْبَةٍ ؟ قَالَ : لَا ، فَقَتَلَهُ ، ثُمَّ لَقِيَ آخَرَ ، فَقَالَ : إِنَّ الْآخَرَ قَتَلَ مِائَةَ نَفْسٍ ، كُلُّهَا يَقْتُلُهَا ظُلْمًا ، فَهَلْ تَجِدُ لِي مِنْ تَوْبَةٍ ؟ قَالَ : لَئِنْ قُلْتُ لَكَ : إِنَّ اللهَ - عَزَّ وَجَلَّ - لَا يَتُوبُ عَلَى مَنْ تَابَ لَقَدْ كَذَبْتُ ، هَاهُنَا دَيْرٌ فِيهِ قَوْمٌ يَعْبُدُونَ ، فَأْتِهِمْ ، فَاعْبُدِ اللهَ مَعَهُمْ ، لَعَلَّ اللهَ يَتُوبُ عَلَيْكَ .  فَانْطَلَقَ إِلَيْهِمْ ، فَمَاتَ قَبْلَ أَنْ يَأْتِيَهُمْ ، فَاحْتَجَّ مَلَائِكَةُ الْعَذَابِ ، وَمَلَائِكَةُ الرَّحْمَةِ ، فَبَعَثَ اللهُ مَلَكًا : أَنْ قِيسُوا بَيْنَ الْمَكَانَيْنِ ، فَأَيُّهُمَا كَانَ أَقْرَبَ فَهُوَ مِنْهُ ، فَقَاسُوهُ ، فَوَجَدُوهُ أَقْرَبَ إِلَى دَيْرِ التَّوَّابِينَ بِأُنْمُلَةٍ ، فَغَفَرَ اللهُ لَهُ  "" .         [13/348]","","Musnad Abi Ya'la al-Mawsili 7361","","معاوية بن أبي سفيان عن أبو عبد رب الدمشقي عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن الوليد بن شجاع عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7364","9 - (  7362  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَابِرٍ قَالَ :  سَمِعْتُ  أَبَا عَبْدِ رَبٍّ ، يَقُولُ :  سَمِعْتُ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّمَا الْأَعْمَالُ بِخَوَاتِيمِهَا  ، كَالْوِعَاءِ إِذَا طَابَ أَعْلَاهُ ، طَابَ أَسْفَلُهُ ، وَإِذَا خَبُثَ أَعْلَاهُ ، خَبُثَ أَسْفَلُهُ  "" .         [13/349]","","Musnad Abi Ya'la al-Mawsili 7362","","معاوية بن أبي سفيان عن أبو عبد رب الدمشقي عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن الوليد بن شجاع عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7365","10 - (  7363  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  مُعَاوِيَةَ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ  شَرِبَ  الْخَمْرَ فَاجْلِدُوهُ  ، فَإِنْ عَادَ فَاجْلِدُوهُ ، فَإِنْ عَادَ  فَاقْتُلُوهُ  .         [13/350]             [13/351]             [13/352]             [13/353]","","Musnad Abi Ya'la al-Mawsili 7363","","معاوية بن أبي سفيان عن ذكوان السمان عن عاصم بن بهدلة عن أبو بكر بن عياش عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7366","11 - (  7364  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ قَالَ :  سَمِعْتُ  جَرِيرًا ، يَقُولُ :  سَمِعْتُ  شَيْخًا ،  يُحَدِّثُ  مُغِيرَةَ ،  عَنِ  ابْنَةِ هِشَامِ بْنِ الْوَلِيدِ بْنِ الْمُغِيرَةِ - وَكَانَتْ تُمَرِّضُ  عَمَّارًا  -  قَالَتْ  :  جَاءَ مُعَاوِيَةُ إِلَى  عَمَّارٍ  يَعُودُهُ ، فَلَمَّا خَرَجَ مِنْ عِنْدِهِ قَالَ : اللَّهُمَّ لَا تَجْعَلْ مَنِيَّتَهُ بِأَيْدِينَا ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [13/354]      يَقُولُ :  تَقْتُلُ  عَمَّارًا  الْفِئَةُ  الْبَاغِيَةُ  "" .","","Musnad Abi Ya'la al-Mawsili 7364","","معاوية بن أبي سفيان عن ابنة هشام بن الوليد بن المغيرة عن شيخ عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7367","12 - (  7365  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مِسْعَرٍ ،  عَنْ  مُجَمِّعٍ ،  عَنْ  أَبِي أُمَامَةَ بْنِ سَهْلِ بْنِ حُنَيْفٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَسَمِعَ الْمُؤَذِّنَ ، فَقَالَ مِثْلَ مَا قَالَ  .         [13/355]","","Musnad Abi Ya'la al-Mawsili 7365","","معاوية بن أبي سفيان عن أسعد بن سهل بن حنيف عن مجمع بن يحيى بن زيد الأنصاري عن مسعر بن كدام عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7368","13 - (  7366  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ الْبَصْرِيُّ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ بْنُ نَجْدَةَ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  مَرْوَانَ بْنِ جَنَاحٍ ،  عَنِ  ابْنِ حَلْبَسٍ ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  تَزْعُمُونَ أَنِّي         [13/356]      مِنْ آخِرِكُمْ وَفَاةً ، أَلَا وَإِنِّي مِنْ أَوَّلِكُمْ وَفَاةً  ، وَلَتَتْبَعُنِّي  أَفْنَادًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  "" .","","Musnad Abi Ya'la al-Mawsili 7366","","معاوية بن أبي سفيان عن يونس بن ميسرة بن حلبس الجبلاني عن مروان بن جناح الدمشقي عن الوليد بن مسلم القرشي عن عبد الوهاب بن نجدة عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7369","14 - (  7367  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ أَحَبَّ  الْأَنْصَارَ  ، أَحَبَّهُ اللهُ  ، وَمَنْ أَبْغَضَ  الْأَنْصَارَ  ، أَبْغَضَهُ اللهُ  .         [13/357]","","Musnad Abi Ya'la al-Mawsili 7367","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى بن زكريا بن أبي زائدة عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7370","15 - (  7368  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنِ  الْحَكَمِ بْنِ مِينَاءَ ،  عَنْ  زَيْدِ بْنِ جَارِيَةَ  ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَ ذَلِكَ .  كذا في طبعة دار المأمون للتراث ، والصواب : ( يزيد بن جارية )","","Musnad Abi Ya'la al-Mawsili 7368","","معاوية بن أبي سفيان عن يزيد بن جارية الأنصاري عن الحكم بن ميناء الأنصاري عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن يحيى بن سعيد الأنصاري عن يحيى بن زكريا بن أبي زائدة عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7371","16 - (  7369  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،         [13/358]      حَدَّثَنَا  حَمَّادٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ابْنِ الْحَنَفِيَّةِ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْعُمْرَى  جَائِزَةٌ لِأَهْلِهَا  "" .","","Musnad Abi Ya'la al-Mawsili 7369","","معاوية بن أبي سفيان عن ابن الحنفية عن عبد الله بن محمد بن عقيل بن أبي طالب عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7372","17 - (  7370  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ الْأَعْرَجُ بْنُ هُرْمُزَ         [13/359]      أَنَّ  الْعَبَّاسَ بْنَ عَبْدِ اللهِ بْنِ الْعَبَّاسِ  أَنْكَحَ  عَبْدَ الرَّحْمَنِ بْنَ الْحَكَمِ  ابْنَتَهُ ، وَأَنْكَحَهُ  عَبْدُ الرَّحْمَنِ  ابْنَتَهُ  ، وَقَدْ كَانَا جَعَلَاهُ صَدَاقًا ، فَكَتَبَ مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ - وَهُوَ  خَلِيفَةٌ  - إِلَى  مَرْوَانَ  ، فَأَمَرَهُ بِالتَّفْرِيقِ بَيْنَهُمَا ، وَقَالَ فِي كِتَابِهِ : هَذَا  الشِّغَارُ  ، وَقَدْ نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْهُ  .","","Musnad Abi Ya'la al-Mawsili 7370","","معاوية بن أبي سفيان عن عبد الرحمن بن هرمز الأعرج عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7373","18 - (  7371  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  بَقِيَّةُ ،  عَنْ  حَرِيزِ بْنِ عُثْمَانَ قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ أَبِي عَوْفٍ الْجُرَشِيُّ ،  عَنْ  أَبِي هِنْدٍ الْبَجَلِيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  لَا تَنْقَطِعُ  الْهِجْرَةُ  حَتَّى تَنْقَطِعَ التَّوْبَةُ  - قَالَهَا ثَلَاثَ مَرَّاتٍ - وَلَا تَنْقَطِعُ التَّوْبَةُ حَتَّى تَطْلُعَ الشَّمْسُ مِنْ مَغْرِبِهَا  "" .         [13/360]             [13/361]             [13/362]","","Musnad Abi Ya'la al-Mawsili 7371","","معاوية بن أبي سفيان عن أبو هند البجلي عن عبد الرحمن بن أبي عوف الجرشي عن حريز بن عثمان الرحبي عن بقية بن الوليد عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7374","19 - (  7372  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحُسَيْنِ الْأَنْطَاكِيُّ ،  حَدَّثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  أَبِي بَكْرِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  عَطِيَّةَ بْنِ قَيْسٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  الْعَيْنُ  وِكَاءُ  السَّهِ  ، فَإِذَا نَامَتِ الْعَيْنُ اسْتَطْلَقَ  الْوِكَاءُ  "" .         [13/363]             [13/364]","","Musnad Abi Ya'la al-Mawsili 7372","","معاوية بن أبي سفيان عن عطية بن قيس الكلابي عن أبو بكر الغساني عن بقية بن الوليد عن إبراهيم بن الحسين الأنطاكي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7375","20 - (  7373  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحُسَيْنِ الْأَنْطَاكِيُّ ،  حَدَّثَنَا  مُبَشِّرٌ يَعْنِي ابْنَ إِسْمَاعِيلَ الْحَلَبِيَّ الْكَلْبِيَّ ، وَالْحَارِثُ بْنُ عَطِيَّةَ ، وَمُحَمَّدُ بْنُ كَثِيرٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَعِيشَ بْنِ الْوَلِيدِ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ :  دَخَلْتُ عَلَى  أُمِّ حَبِيبَةَ  زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي ثَوْبٍ وَاحِدٍ  ، فَقُلْتُ : أَلَا أُرَاهُ يُصَلِّي كَمَا أَرَى ؟ قَالَتْ : نَعَمْ ، وَهُوَ الثَّوْبُ الَّذِي كَانَ فِيهِ مَا كَانَ  .","","Musnad Abi Ya'la al-Mawsili 7373","","معاوية بن أبي سفيان عن يعيش بن الوليد بن هشام القرشي عن أبو عمرو الأوزاعي عن محمد بن كثير بن أبي عطاء عن إبراهيم بن الحسين الأنطاكي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7376","21 - (  7374  ) -  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ فُضَيْلِ بْنِ عِيَاضٍ ،  حَدَّثَنَا  أَبُو سَعِيدٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ أَبُو الْعَلَاءِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مُهَاجِرٍ ،  عَنْ  كَيْسَانَ مَوْلَى مُعَاوِيَةَ قَالَ :  خَطَبَنَا  مُعَاوِيَةُ ، فَقَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ سَبْعٍ ، وَأَنَا أَنْهَاكُمْ عَنْهُنَّ  ، أَلَا إِنَّ مِنْهُنَّ : النَّوْحَ ، وَالْغِنَاءَ ، وَالتَّصَاوِيرَ ، وَالشِّعْرَ ، وَالذَّهَبَ ، وَجُلُودَ  السِّبَاعِ  ،  وَالتَّبَرُّجَ  ، وَالْحَرِيرَ  .         [13/365]             [13/366]","","Musnad Abi Ya'la al-Mawsili 7374","","معاوية بن أبي سفيان عن كيسان مولى معاوية الشامي عن محمد بن مهاجر بن أبي مسلم عن عبد الرحمن أبو العلاء عن عبد الرحمن بن عبد الله بن عبيد جردقة عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7377","22 - (  7375  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ مَاتَ وَلَيْسَ عَلَيْهِ إِمَامٌ ، مَاتَ  مِيتَةً  جَاهِلِيَّةً  .","","Musnad Abi Ya'la al-Mawsili 7375","","معاوية بن أبي سفيان عن ذكوان السمان عن عاصم بن بهدلة عن أبو بكر بن عياش عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7378","23 - (  7376  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْبَصْرِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ قَالَ :  حَدَّثَنِي  أَحْمَدُ بْنُ إِبْرَاهِيمَ ، قَالَ :  حَدَّثَنِي  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ الْغَمْرِ مَوْلَى  سُمُوكٍ  قَالَ :  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي ،  قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ حُدَيْجٍ ، يَقُولُ :  كُنْتُ عِنْدَ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ حِينَ جَاءَهُ كِتَابُ عَامِلِهِ يُخْبِرُهُ أَنَّهُ وَقَعَ بِالتُّرْكِ وَهَزَمَهُمْ ، وَكَثْرَةَ مَنْ قَتَلَ مِنْهُمْ ، وَكَثْرَةَ مَنْ         [13/367]      غَنِمَ ، فَغَضِبَ  مُعَاوِيَةُ  مِنْ ذَلِكَ ، ثُمَّ أَمَرَ أَنْ يَكْتُبَ إِلَيْهِ قَدْ فَهِمْتُ مَا ذَكَرْتَ مِمَّا قَتَلْتَ وَغَنِمْتَ ، فَلَا أَعْلَمَنَّ مَا عُدْتَ لِشَيْءٍ مِنْ ذَلِكَ ، وَلَا قَاتَلْتَهُمْ حَتَّى يَأْتِيَكَ أَمْرِي ، قُلْتُ لَهُ : لِمَ يَا أَمِيرَ الْمُؤْمِنِينَ ؟ فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَتَظْهَرَنَّ التُّرْكُ عَلَى الْعَرَبِ حَتَّى تُلْحِقَهَا بِمَنَابِتِ الشِّيحِ وَالْقَيْصُومِ  ، فَأَكْرَهُ قِتَالَهُمْ لِذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 7376","","معاوية بن أبي سفيان عن معاوية بن حديج السكوني عن جد إبراهيم بن الغمر بن الحصين الغساني عن إبراهيم بن الغمر بن الحصين الغساني عن إسحاق بن إبراهيم بن الغمر الغساني عن أحمد بن إبراهيم عن محمد بن يعقوب بن عبد الوهاب الزبيري عن محمد بن يحيى بن سعيد القطان عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7379","24 - (  7377  ) -  حَدَّثَنَا  خَلِيفَةُ بْنُ خَيَّاطٍ ،  حَدَّثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  حَدَّثَنَا  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ عُقْبَةَ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  يَكُونُ أُمَرَاءُ فَلَا يُرَدُّ عَلَيْهِمْ ،  يَتَهَافَتُونَ  فِي النَّارِ  ، يَتْبَعُ بَعْضُهُمْ بَعْضًا  .         [13/368]","","Musnad Abi Ya'la al-Mawsili 7377","","معاوية بن أبي سفيان عن محمد بن عقبة بن أبي مالك القرظي عن هشام بن سعد المخزومي عن أبو عامر العقدي عن خليفة بن خياط عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7380","25 - (  7378  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  زَائِدَةَ ،  عَنِ  السَّائِبِ بْنِ حُبَيْشٍ الْكَلَاعِيِّ ،  عَنْ  أَبِي الشَّمَّاخِ الْأَزْدِيِّ ،  عَنِ  ابْنِ عَمٍّ لَهُ ، لَهُ صُحْبَةٌ  أَنَّهُ  دَخَلَ عَلَى مُعَاوِيَةَ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  مَنْ وَلِيَ مِنَ الْمُسْلِمِينَ شَيْئًا ، فَأَغْلَقَ بَابَهُ عَنِ الْمِسْكِينِ وَالضَّعِيفِ  ، وَذِي الْحَاجَةِ دُونَ حَاجَاتِهِمْ  وَفَاقَتِهِمْ  ، أَغْلَقَ اللهُ - عَزَّ وَجَلَّ - عَنْهُ بَابَ رَحْمَتِهِ يَوْمَ حَاجَتِهِ  وَفَاقَتِهِ  أَحْوَجَ مَا يَكُونُ إِلَى ذَلِكَ "" لَا أَدْرِي مَنِ الْقَائِلُ :  الْأَزْدِيُّ  لِمُعَاوِيَةَ  ، أَوْ  مُعَاوِيَةُ  لِلْأَزْدِيِّ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .         [13/369]","","Musnad Abi Ya'la al-Mawsili 7378","","معاوية بن أبي سفيان عن ابن عم أبو الشماخ الأزدي له صحبة عن أبو الشماخ الأزدي عن السائب بن حبيش الكلاعي عن زائدة بن قدامة عن حماد بن أسامة القرشي عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7381","26 - (  7379  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ غُنْدَرٌ ،  حَدَّثَنَا  شُعْبَةُ قَالَ :  سَمِعْتُ  أَبَا إِسْحَاقَ  يُحَدِّثُ ، عَنْ  عَامِرِ بْنِ سَعْدٍ الْبَجَلِيِّ ،  عَنْ  جَرِيرٍ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَخْطُبُ قَالَ  مَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  وَمَاتَ  أَبُو بَكْرٍ  وَعُمَرُ  وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  .         [13/370]","","Musnad Abi Ya'la al-Mawsili 7379","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن عامر بن سعد البجلي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7382","27 - (  7380  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  عَمْرُو بْنُ يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  جَدِّهِ سَعِيدِ بْنِ عَمْرِو بْنِ الْعَاصِ  ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  تَوَضَّؤُوا "" قَالَ : فَلَمَّا تَوَضَّأَ نَظَرَ إِلَيَّ ، فَقَالَ : يَا  مُعَاوِيَةُ  ، إِنْ وُلِّيتَ أَمْرًا فَاتَّقِ اللهَ ، وَاعْدِلْ  قَالَ : فَمَا زِلْتُ أَظُنُّ أَنِّي مُبْتَلًى بِعَمَلٍ لِقَوْلِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى وُلِّيتُ  .         [13/371]","","Musnad Abi Ya'la al-Mawsili 7380","","معاوية بن أبي سفيان عن سعيد بن عمرو بن سعيد بن العاص العذري عن عمرو بن يحيى بن سعيد السعيدي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7383","28 - (  7381  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  الْوَلِيدُ ،  عَنْ  ثَوْرٍ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ اللهَ - عَزَّ وَجَلَّ - لَا يُغْلَبُ وَلَا يُخْلَبُ ، وَلَا يُنَبَّأُ بِمَا لَا يَعْلَمُ  ، مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ ، وَمَنْ لَمْ يُفَقِّهْهُ لَمْ يُبَلْ بِهِ  "" .         [13/372]             [13/373]","","Musnad Abi Ya'la al-Mawsili 7381","","معاوية بن أبي سفيان عن خالد بن معدان عن ثور بن يزيد الكلاعي عن الوليد بن مسلم القرشي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7384","29 - (  7382  ) -  أَخْبَرَنَا  أَبُو يَعْلَى قَالَ :  وَجَدْتُ فِي كِتَابِي ،  عَنْ  سُوَيْدٍ - وَلَمْ أَرَ عَلَيْهِ عَلَامَةَ  السَّمَاعِ  ، وَعَلَيْهِ "" صَحَّ "" ، فَشَكَكْتُ         [13/374]      فِيهِ ، وَأَكْبَرُ ظَنِّي أَنِّي سَمِعْتُهُ مِنْهُ  -  عَنْ  ضِمَامِ بْنِ إِسْمَاعِيلَ الْمَعَافِرِيِّ ،  عَنْ  أَبِي قَبِيلٍ قَالَ :  خَطَبَنَا مُعَاوِيَةُ فِي يَوْمِ جُمُعَةٍ ، فَقَالَ : إِنَّمَا الْمَالُ مَالُنَا وَالْفَيْءُ فَيْئُنَا ، مَنْ شِئْنَا أَعْطَيْنَا ، وَمَنْ شِئْنَا مَنَعْنَا ، فَلَمْ يَرُدَّ عَلَيْهِ أَحَدٌ ، فَلَمَّا كَانَتِ الْجُمُعَةُ الثَّانِيَةُ ، قَالَ مِثْلَ مَقَالَتِهِ ، فَلَمْ يَرُدَّ عَلَيْهِ أَحَدٌ ، فَلَمَّا كَانَتِ الْجُمُعَةُ الثَّالِثَةُ ، قَالَ مِثْلَ مَقَالَتِهِ ، فَقَامَ إِلَيْهِ رَجُلٌ مِمَّنْ شَهِدَ الْمَسْجِدَ ، فَقَالَ : كَلَّا ، بَلِ الْمَالُ مَالُنَا وَالْفَيْءُ فَيْئُنَا ، مَنْ حَالَ بَيْنَنَا وَبَيْنَهُ حَاكَمْنَاهُ بِأَسْيَافِنَا ، فَلَمَّا صَلَّى أَمَرَ بِالرَّجُلِ ، فَأُدْخِلَ عَلَيْهِ ، فَأَجْلَسَهُ مَعَهُ عَلَى السَّرِيرِ ، ثُمَّ أَذِنَ لِلنَّاسِ فَدَخَلُوا عَلَيْهِ ، ثُمَّ قَالَ : أَيُّهَا النَّاسُ ، إِنِّي تَكَلَّمْتُ فِي أَوَّلِ جُمُعَةٍ فَلَمْ يَرُدَّ عَلَيَّ أَحَدٌ ، وَفِي الثَّانِيَةِ فَلَمْ يَرُدَّ عَلَيَّ أَحَدٌ ، فَلَمَّا كَانَتِ الثَّالِثَةُ أَحْيَانِي هَذَا أَحْيَاهُ اللهُ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ  : سَيَأْتِي قَوْمٌ يَتَكَلَّمُونَ ، فَلَا يُرَدُّ عَلَيْهِمْ ، يَتَقَاحَمُونَ فِي النَّارِ تَقَاحُمَ الْقِرَدَةِ  ، فَخَشِيتُ أَنْ يَجْعَلَنِيَ اللهُ مِنْهُمْ ، فَلَمَّا رَدَّ هَذَا عَلَيَّ أَحْيَانِي ، أَحْيَاهُ اللهُ ، وَرَجَوْتُ أَنْ لَا يَجْعَلَنِيَ اللهُ مِنْهُمْ  .         [13/375]","","Musnad Abi Ya'la al-Mawsili 7382","","معاوية بن أبي سفيان عن حيي بن هانئ السريعي عن ضمام بن إسماعيل المرادي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7385","30 - (  7383  ) -  حَدَّثَنَا  أَبُو الْوَلِيدِ الْقُرَشِيُّ ،  حَدَّثَنَا  الْوَلِيدُ ،  عَنِ  ابْنِ جَابِرٍ ،  عَنْ  عُمَيْرِ بْنِ هَانِئٍ ، عَنْ مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ أَنَّهُ  خَطَبَهُمْ  ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  لَا تَزَالُ مِنْ أُمَّتِي أُمَّةٌ قَائِمَةٌ بِأَمْرِ اللهِ - عَزَّ وَجَلَّ - ، لَا يَضُرُّهُمْ مَنْ خَذَلَهُمْ  ، وَلَا مَنْ خَالَفَهُمْ حَتَّى يَأْتِيَ أَمْرُ اللهِ وَهُمْ عَلَى ذَلِكَ ، قَالَ  عُمَيْرٌ  :  قَالَ  مَالِكُ بْنُ يَخَامِرَ السَّكْسَكِيُّ : يَا أَمِيرَ الْمُؤْمِنِينَ ،  سَمِعْتُ  مُعَاذَ بْنَ جَبَلٍ ، يَقُولُ : وَهُمْ  بِالشَّامِ  ، فَقَالَ  مُعَاوِيَةُ  : هَذَا  مَالِكُ بْنُ يَخَامِرَ  - وَلَهُ  النَّسَمَةُ  - يَزْعُمُ أَنَّهُ سَمِعَ  مُعَاذًا  ، يَقُولُ : هُمْ  أَهْلُ الشَّامِ  .         [13/376]             [13/377]","","Musnad Abi Ya'la al-Mawsili 7383","","معاذ بن جبل عن مالك بن يخامر السكسكي عن عمير بن هانئ الداراني عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن أحمد بن عبد الرحمن بن بكار البسري عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7386","31 - (  7384  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  أَبُو دَاوُدَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ :  قَدِمَ مُعَاوِيَةُ فَأُتِيَ بِعَصًا عَلَى رَأْسِهَا خِرْقَةٌ  ، فَقَالَ : مَا كُنْتُ أَرَى أَحَدًا يَفْعَلُ هَذَا إِلَّا الْيَهُودَ ، إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَلَغَهُ ذَلِكَ ، فَسَمَّاهُ الزُّورَ  .","","Musnad Abi Ya'la al-Mawsili 7384","","معاوية بن أبي سفيان عن سعيد بن المسيب عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن أبو داود الطيالسي عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7387","31 - (  7384  ) - مُكَرَّرٌ  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  طَلْحَةُ بْنُ يَحْيَى ،  عَنْ  عَمِّهِ عِيسَى بْنِ طَلْحَةَ قَالَ :  كُنْتُ جَالِسًا عِنْدَ مُعَاوِيَةَ ، فَأَتَى الْمُؤَذِّنُ يُؤْذِنُهُ بِالصَّلَاةِ ، فَقَالَ  مُعَاوِيَةُ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ أَطْوَلَ النَّاسِ  أَعْنَاقًا  يَوْمَ الْقِيَامَةِ الْمُؤَذِّنُونَ  "" .         [13/378]","","Musnad Abi Ya'la al-Mawsili 7384","","معاوية بن أبي سفيان عن عيسى بن طلحة التيمي عن طلحة بن يحيى بن طلحة التيمي عن عبدة بن سليمان الكلابي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7388","32 - (  7385  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  الْعَلَاءُ بْنُ هِلَالٍ الرَّقِّيُّ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي الْفَيْضِ ،  عَنْ  مُعَاوِيَةَ بْنِ عَلِيٍّ السُّلَمِيِّ  قَالَ :  صَلَّى بِنَا مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ الْمَغْرِبَ ثَلَاثًا ، فَقَامَ فِي رَكْعَتَيْنِ ، فَسَبَّحُوا بِهِ  ، فَأَوْمَأَ إِلَيْهِمْ أَنْ قُومُوا ، فَلَمَّا قَضَى صَلَاتَهُ وَسَلَّمَ ، انْصَرَفَ فَخَطَبَهُمْ ، ثُمَّ قَالَ : رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَعَلَ كَالَّذِي رَأَيْتُمُونِي فَعَلْتُ ، وَلَوْلَا أَنِّي رَأَيْتُهُ فَعَلَهُ لَمْ أَفْعَلْهُ  .         [13/379]             [13/380]      كذا في طبعة دار المأمون للتراث ، ولعل الصواب : ( معن بن علي السلمي )","","Musnad Abi Ya'la al-Mawsili 7385","","معاوية بن أبي سفيان عن معن بن علي السلمي عن موسى بن أيوب المهري عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن العلاء بن هلال الباهلي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7389","33 - (  7386  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ قَالَ :  حَدَّثَنِي  أَبِي  قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ مَلَاذٍ الْأَشْعَرِيَّ  يُحَدِّثُ ، عَنْ  نُمَيْرِ بْنِ أَوْسٍ ،  عَنْ  مَالِكِ بْنِ مَسْرُوحٍ ،  عَنْ  عَامِرِ بْنِ أَبِي عَامِرٍ الْأَشْعَرِيِّ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي  الْأَشْعَرِيِّينَ  : هُمْ مِنِّي وَأَنَا مِنْهُمْ  .  قَالَ : فَحَدَّثْتُ بِهِ مُعَاوِيَةَ ، فَقَالَ : لَيْسَ هَكَذَا ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِنَّمَا قَالَ : هُمْ مِنِّي وَإِلَيَّ قَالَ : قُلْتُ : لَيْسَ هَكَذَا ، حَدَّثَنِي أَبِي ، إِنَّمَا قَالَ : هُمْ مِنِّي وَأَنَا مِنْهُمْ . قَالَ : فَأَنْتَ إِذًا أَعْلَمُ بِحَدِيثِ أَبِيكَ  .         [13/381]","","Musnad Abi Ya'la al-Mawsili 7386","","معاوية بن أبي سفيان عن عامر بن أبي عامر الأشعري عن مالك بن مسروح الشامي عن نمير بن أوس الأشعري عن عبد الله بن ملاذ الأشعري عن جرير بن حازم عن وهب بن جرير بن حازم عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7390","34 - (  7387  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ قَالَ :  حَدَّثَنِي  مَرْحُومٌ ،  حَدَّثَنَا  أَبُو نَعَامَةَ السَّعْدِيُّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  خَرَجَ مُعَاوِيَةُ عَلَى حَلْقَةٍ فِي الْمَسْجِدِ ، فَقَالَ : مَا يُجْلِسُكُمْ ؟ قَالُوا : جَلَسْنَا نَذْكُرُ اللهَ - عَزَّ وَجَلَّ - قَالَ : آللهِ مَا أَجْلَسَكُمْ إِلَّا ذَلِكَ ؟ قَالُوا : وَاللهِ مَا أَجْلَسَنَا إِلَّا ذَلِكَ . قَالَ : أَمَا إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ عَلَى حَلْقَةٍ مِنْ أَصْحَابِهِ فَقَالَ : مَا يُجْلِسُكُمْ ؟ قَالُوا : جَلَسْنَا نَذْكُرُ اللهَ - عَزَّ وَجَلَّ - ، وَنَحْمَدُهُ عَلَى مَا هَدَانَا لِلْإِسْلَامِ ، وَمَنَّ عَلَيْنَا بِهِ . قَالَ : آللهِ مَا يُجْلِسُكُمْ إِلَّا ذَلِكَ ؟ قَالُوا : آللهِ مَا أَجْلَسَنَا إِلَّا ذَلِكَ . قَالَ :  أَمَا إِنِّي لَمْ أَسْتَحْلِفْكُمْ  تُهْمَةً  لَكُمْ ، وَلَكِنَّ  جِبْرِيلَ  أَتَانِي فَأَخْبَرَنِي أَنَّ اللهَ  يُبَاهِي  بِكُمُ الْمَلَائِكَةَ  .         [13/382]","","Musnad Abi Ya'la al-Mawsili 7387","","معاوية بن أبي سفيان عن أبو سعيد الخدري عن أبو عثمان النهدي عن عبد ربه السعدي عن مرحوم بن عبد العزيز العطار عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7391","35 - (  7388  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الصَّمَدِ ،  حَدَّثَنَا  الْقَاسِمُ بْنُ الْحَكَمِ ،  عَنْ  سُفْيَانَ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أَطْوَلُ النَّاسِ  أَعْنَاقًا  يَوْمَ الْقِيَامَةِ الْمُؤَذِّنُونَ  "" .","","Musnad Abi Ya'la al-Mawsili 7388","","معاوية بن أبي سفيان عن عيسى بن طلحة التيمي عن طلحة بن يحيى بن طلحة التيمي عن سفيان الثوري عن القاسم بن الحكم بن كثير عن عبد الله بن عبد الصمد عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7392","36 - (  7389  ) -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ الْفُضَيْلِ الرَّاسِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  ثَوْرٍ ،  عَنْ  رَاشِدِ بْنِ سَعْدٍ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّكَ إِذَا اتَّبَعْتَ  عَوْرَاتِ  النَّاسِ  أَفْسَدْتَهُمْ ، أَوْ كِدْتَ أَنْ تُفْسِدَهُمْ  . قَالَ : يَقُولُ  أَبُو الدَّرْدَاءِ  : كَلِمَةٌ سَمِعَهَا  مُعَاوِيَةُ  مِنْ         [13/383]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : "" نَفَعَهُ اللهُ بِهَا  "" .","","Musnad Abi Ya'la al-Mawsili 7389","","معاوية بن أبي سفيان عن راشد بن سعد المقرائي عن ثور بن يزيد الكلاعي عن سفيان الثوري عن محمد بن يوسف الفريابي عن جعفر بن محمد بن الفضيل الرسعني عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7393","37 - (  7390  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  أَبُو تُمَيْلَةَ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ إِسْحَاقَ قَالَ :  ادَّعَى  نَصْرُ بْنُ الْحَجَّاجِ بْنِ عِلَاطٍ السُّلَمِيُّ  عَبْدَ اللهِ بْنَ رَبَاحٍ مَوْلَى خَالِدِ بْنِ الْوَلِيدِ  ، فَقَامَ  عَبْدُ الرَّحْمَنِ بْنُ خَالِدِ بْنِ الْوَلِيدِ  ، فَقَالَ : مَوْلَايَ وُلِدَ عَلَى فِرَاشِ مَوْلَايَ ، وَقَالَ  نَصْرٌ  : أَخِي أَوْصَانِي بِمَنْزِلِهِ . قَالَ : فَطَالَتْ خُصُومَتُهُمْ ، فَدَخَلُوا مَعَهُ عَلَى مُعَاوِيَةَ -  وَفِهْرٌ  تَحْتَ رَأْسِهِ - فَادَّعَيَا .  فَقَالَ  مُعَاوِيَةُ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْوَلَدُ  لِلْفِرَاشِ ،  وَلِلْعَاهِرُ  الْحَجَرُ  ، فَقَالَ  نَصْرٌ  : فَأَيْنَ قَضَاؤُكَ هَذَا يَا  مُعَاوِيَةُ  فِي  زِيَادٍ  ؟ فَقَالَ  مُعَاوِيَةُ  : قَضَاءُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَيْرٌ مِنْ قَضَاءِ  مُعَاوِيَةَ  ، فَكَانَ  عَبْدُ اللهِ بْنُ رَبَاحٍ  لَا يُجِيبُ  نَصْرًا  إِلَى مَا يَدَّعِي ، فَقَالَ  نَصْرٌ  :  ثَرِيٌّ         [13/384]","","Musnad Abi Ya'la al-Mawsili 7390","","معاوية بن أبي سفيان عن محمد بن إسحاق عن يحيى بن واضح الأنصاري عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","حديث معاوية بن أبي سفيان رضي الله عنه"
"7394","[13/385]      حَدِيثُ جُبَيْرِ بْنِ مُطْعِمٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  1 - (  7391  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا يَدْخُلُ الْجَنَّةَ قَاطِعٌ  "" .         [13/386]","","Musnad Abi Ya'la al-Mawsili 7391","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7395","2 - (  7392  ) -  حَدَّثَنَا  وَهْبٌ ،  أَخْبَرَنَا  خَالِدٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرٍ ،         [13/387]      عَنْ  أَبِيهِ  ، وَقَدْ أَدْرَكَ  جُبَيْرٌ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا يَدْخُلُ الْجَنَّةَ قَاطِعٌ  "" .","","Musnad Abi Ya'la al-Mawsili 7392","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن الزهري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7396","3 - (  7393  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَرَأَ فِي الْمَغْرِبِ بِـ ( الطُّورِ  ) .         [13/388]","","Musnad Abi Ya'la al-Mawsili 7393","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7397","4 - (  7394  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ  قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  لَا يَدْخُلُ الْجَنَّةَ قَاطِعٌ  "" .","","Musnad Abi Ya'la al-Mawsili 7394","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7398","5 - (  7395  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ ، جَمِيعًا         [13/389]      قَالَا :  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  سَمِعَ  مُحَمَّدَ بْنَ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  أَنَا  مُحَمَّدٌ  ، وَأَنَا  أَحْمَدُ  ، وَأَنَا  الْمَاحِي  الَّذِي يُمْحَى بِيَ الْكُفْرُ  ، وَأَنَا  الْحَاشِرُ  الَّذِي يُحْشَرُ النَّاسُ عَلَى عَقِبِي ، وَأَنَا  الْعَاقِبُ  الَّذِي لَيْسَ بَعْدَهُ نَبِيٌّ  .         [13/390]","","Musnad Abi Ya'la al-Mawsili 7395","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن الزهري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7399","6 - (  7396  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابَاهْ ،  عَنْ  جُبَيْرِ بْنِ مُطْعِمٍ ، فَذَكَرَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  يَا  بَنِي عَبْدِ مَنَافٍ  ، لَا تَمْنَعُنَّ أَحَدًا طَافَ بِهَذَا  الْبَيْتِ  وَصَلَّى أَيَّ سَاعَةٍ شَاءَ مِنْ لَيْلٍ أَوْ نَهَارٍ  .         [13/391]             [13/392]","","Musnad Abi Ya'la al-Mawsili 7396","","جبير بن مطعم بن عدي النوفلي عن عبد الله بن باباه البصري عن أبو الزبير المكي عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7400","7 - (  7397  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سُلَيْمَانَ بْنِ صُرَدٍ ،  عَنْ  جُبَيْرِ بْنِ مُطْعِمٍ قَالَ :  تَذَاكَرْنَا  الْغُسْلَ  مِنَ الْجَنَابَةِ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أَمَّا أَنَا فَأُفِيضُ عَلَى رَأْسِي ثَلَاثًا  .         [13/393]","","Musnad Abi Ya'la al-Mawsili 7397","","جبير بن مطعم بن عدي النوفلي عن سليمان بن صرد الخزاعي عن أبو إسحاق السبيعي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7401","8 - (  7398  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  عَاصِمٍ الْعَنَزِيِّ ،  عَنِ  ابْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا دَخَلَ الصَّلَاةَ قَالَ :  اللهُ أَكْبَرُ  كَبِيرًا ،  وَالْحَمْدُ لِلهِ كَثِيرًا - ثَلَاثًا - سُبْحَانَ اللهِ بُكْرَةً وَأَصِيلًا - ثَلَاثًا -  أَعُوذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيمِ : مِنْ  نَفْخِهِ  وَهَمْزِهِ وَنَفْثِهِ  قَالَ  عَمْرٌو  :  نَفْخُهُ :  الْكِبْرُ  ،  وَهَمْزُهُ : الْمُوتَةُ  ،  وَنَفْثُهُ  : الشِّعْرُ  .         [13/394]             [13/395]             [13/396]","","Musnad Abi Ya'la al-Mawsili 7398","","جبير بن مطعم بن عدي النوفلي عن نافع بن جبير بن مطعم النوفلي عن عاصم بن عمير العنزي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7402","9 - (  7399  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  جُبَيْرِ بْنِ مُطْعِمٍ قَالَ :  لَمَّا قَسَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  سَهْمَ  ذِي الْقُرْبَى بَيْنَ  بَنِي هَاشِمٍ  ،  وَبَنِي الْمُطَّلِبِ  ، أَتَيْتُهُ أَنَا  وَعُثْمَانُ  ، فَقُلْنَا : يَا رَسُولَ اللهِ ، هَؤُلَاءِ  بَنُو هَاشِمٍ  لَا يُنْكَرُ فَضْلُهُمْ بِمَكَانِكَ الَّذِي وَضَعَكَ اللهُ - عَزَّ وَجَلَّ - بِهِ مِنْهُمْ ، أَرَأَيْتَ  بَنِي الْمُطَّلِبِ  أَعْطَيْتَهُمْ وَمَنَعْتَنَا ، وَإِنَّمَا نَحْنُ وَهُمْ مِنْكَ بِمَنْزِلَةٍ ؟ فَقَالَ :  إِنَّهُمْ لَمْ يُفَارِقُونِي فِي جَاهِلِيَّةٍ وَلَا إِسْلَامٍ ، وَإِنَّمَا  بَنُو هَاشِمٍ  وَبَنُو الْمُطَّلِبِ  شَيْءٌ وَاحِدٌ ،  وَشَبَّكَ  بَيْنَ أَصَابِعِهِ  .         [13/397]","","Musnad Abi Ya'la al-Mawsili 7399","","جبير بن مطعم بن عدي النوفلي عن سعيد بن المسيب عن الزهري عن محمد بن إسحاق عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7403","10 - (  7400  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ ،  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  طَلْحَةَ بْنِ عَبْدِ اللهِ بْنِ عَوْفٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَزْهَرَ ،  عَنْ  جُبَيْرِ بْنِ مُطْعِمٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ لِلْقُرَشِيِّ مِثْلَ قُوَّةِ الرَّجُلَيْنِ مِنْ غَيْرِ  قُرَيْشٍ  ، فَقِيلَ  لِلزُّهْرِيِّ  : مَا عَنَى بِهِ ؟ قَالَ : نُبْلَ الرَّأْيِ  .         [13/398]","","Musnad Abi Ya'la al-Mawsili 7400","","جبير بن مطعم بن عدي النوفلي عن عبد الرحمن بن أزهر الزهري عن طلحة الندى  ، طلحة بن عبد الله بن عوف عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7404","11 - (  7401  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  أَبِيهِ  قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي مَسِيرٍ لَهُ ، فَقَالَ :  يَطْلُعُ عَلَيْكُمْ  أَهْلُ الْيَمَنِ  كَأَنَّهُمُ السَّحَابُ  ، هُمْ خِيَارُ مَنْ فِي الْأَرْضِ ، فَقَالَ  رَجُلٌ مِنَ الْأَنْصَارِ  : إِلَّا نَحْنُ يَا رَسُولَ اللهِ ! فَسَكَتَ ، ثُمَّ أَعَادَهَا ، فَسَكَتَ ، ثُمَّ أَعَادَهَا الثَّالِثَةَ : إِلَّا نَحْنُ يَا رَسُولَ اللهِ ؟ فَقَالَ - كَلِمَةً ضَعِيفَةً - : "" إِلَّا أَنْتُمْ  "" .         [13/399]","","Musnad Abi Ya'la al-Mawsili 7401","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن الحارث بن عبد الرحمن العامري عن محمد بن عبد الرحمن بن المغيرة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7405","12 - (  7402  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  يَزِيدُ ،  أَخْبَرَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  أَبِيهِ  أَنَّ  امْرَأَةً  أَتَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَسْأَلُهُ شَيْئًا ، فَقَالَ لَهَا : ارْجِعِي إِلَيَّ ، فَقَالَتْ لَهُ :  يَا رَسُولَ اللهِ ! فَإِنْ رَجَعْتُ فَلَمْ أَرَكَ ، - تُعَرِّضُ بِالْمَوْتِ - فَقَالَ : إِنْ لَمْ تَجِدِينِي ، فَالْقَيْ  أَبَا بَكْرٍ  .         [13/400]","","Musnad Abi Ya'la al-Mawsili 7402","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7406","13 - (  7403  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ عَمْرٍو أَبُو عَامِرٍ ،  عَنْ  زُهَيْرِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  أَبِيهِ  أَنَّ  رَجُلًا  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا رَسُولَ اللهِ ! أَيُّ الْبُلْدَانِ شَرٌّ ؟ فَقَالَ : لَا أَدْرِي ،  فَلَمَّا جَاءَهُ  جِبْرِيلُ  - عَلَيْهِ السَّلَامُ - قَالَ :  جِبْرِيلُ  ، أَيُّ الْبُلْدَانِ شَرٌّ ؟ قَالَ : لَا أَدْرِي ، حَتَّى أَسْأَلَ رَبِّيَ - عَزَّ وَجَلَّ - ، فَانْطَلَقَ  جِبْرِيلُ  ، فَمَكَثَ مَا شَاءَ اللهُ ، ثُمَّ جَاءَ ، فَقَالَ : يَا  مُحَمَّدُ  ، إِنَّكَ سَأَلْتَنِي : أَيُّ الْبُلْدَانِ شَرٌّ فَقُلْتُ : لَا أَدْرِي ، وَإِنِّي سَأَلْتُ رَبِّيَ - عَزَّ وَجَلَّ - : أَيُّ الْبُلْدَانِ شَرٌّ ؟ فَقَالَ : أَسْوَاقُهَا  .         [13/401]","","Musnad Abi Ya'la al-Mawsili 7403","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن عبد الله بن محمد بن عقيل بن أبي طالب عن زهير بن محمد التميمي عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7407","14 - (  7404  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  ابْنُ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ قَالَ :  أَخْبَرَنِي  عُمَرُ بْنُ مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ  أَنَّ  مُحَمَّدَ بْنَ جُبَيْرٍ قَالَ :  أَخْبَرَنِي  جُبَيْرُ بْنُ مُطْعِمٍ  أَنَّهُ بَيْنَا هُوَ يَسِيرُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهُ النَّاسُ -  مَقْفَلَهُ  مِنْ  حُنَيْنٍ  -  عَلِقَتِ  الْأَعْرَابُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْأَلُونَهُ حَتَّى اضْطَرُّوهُ إِلَى  سَمُرَةٍ  ، فَخُطِفَتْ رِدَاؤُهُ ، فَوَقَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ :  أَعْطُونِي رِدَائِي ، فَلَوْ كَانَ عَدَدُ هَذِهِ  الْعِضَاهِ  نَعَمًا قَسَمْتُهُ بَيْنَكُمْ  ، ثُمَّ لَا تَجِدُونِي بَخِيلًا ، وَلَا كَذَّابًا ، وَلَا جَبَانًا  "" .         [13/402]             [13/403]","","Musnad Abi Ya'la al-Mawsili 7404","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن عمر بن محمد بن جبير بن مطعم النوفلي عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7408","15 - (  7405  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ قَالَ :  سَمِعْتُ  رَجُلًا ،  سَمِعَ  جُبَيْرًا قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ! إِنَّ أُنَاسًا يَقُولُونَ : لَيْسَ لَنَا أُجُورٌ  بِمَكَّةَ  ؟ قَالَ :  لَتَأْتِيَنَّكُمْ أُجُورُكُمْ ، وَلَوْ كُنْتُمْ فِي جُحْرِ ثَعْلَبٍ  "" .","","Musnad Abi Ya'la al-Mawsili 7405","","جبير بن مطعم بن عدي النوفلي عن رجل عن النعمان بن سالم الطائفي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7409","16 - (  7406  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ يُوسُفَ ،  حَدَّثَنَا  زَكَرِيَّا ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  نَافِعِ بْنِ جُبَيْرٍ ،         [13/404]      عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا  حِلْفَ  فِي الْإِسْلَامِ  ، وَأَيُّمَا  حِلْفٍ  كَانَ فِي الْجَاهِلِيَّةِ فَإِنَّ الْإِسْلَامَ لَمْ يَزِدْهُ إِلَّا شِدَّةً  .","","Musnad Abi Ya'la al-Mawsili 7406","","جبير بن مطعم بن عدي النوفلي عن نافع بن جبير بن مطعم النوفلي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زكريا بن أبي زائدة الوادعي عن إسحاق بن يوسف الأزرق عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7410","17 - (  7407  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ قَالَ :  سَمِعْتُ  بَعْضَ إِخْوَتِي  يُحَدِّثُ ، عَنْ  أَبِي ،  عَنْ  جُبَيْرِ بْنِ مُطْعِمٍ  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي فِدَاءِ الْمُشْرِكِينَ ، وَمَا أَسْلَمَ يَوْمَئِذٍ  قَالَ : فَانْتَهَيْتُ إِلَيْهِ وَهُوَ يُصَلِّي الْمَغْرِبَ ، وَهُوَ يَقْرَأُ فِيهَا بِـ ( الطُّورِ ) كَأَنَّمَا صُدِعَ قَلْبِي حِينَ سَمِعْتُ الْقُرْآنَ  .","","Musnad Abi Ya'la al-Mawsili 7407","","جبير بن مطعم بن عدي النوفلي عن إبراهيم بن عبد الرحمن بن عوف عن بعض إخوة سعد بن إبراهيم بن عبد الرحمن بن عوف عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن حجاج بن محمد الأعور عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7411","18 - (  7408  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هِشَامُ بْنُ عَبْدِ الْمَلِكِ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  نَافِعِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،         [13/405]      عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَنْزِلُ  اللهُ - عَزَّ وَجَلَّ - إِلَى السَّمَاءِ الدُّنْيَا كُلَّ لَيْلَةٍ ، فَيَقُولُ :  هَلْ مِنْ دَاعٍ فَأَسْتَجِيبَ لَهُ ؟ هَلْ مِنْ مُسْتَغْفِرٍ فَأَغْفِرَ لَهُ  ؟ "" .","","Musnad Abi Ya'la al-Mawsili 7408","","جبير بن مطعم بن عدي النوفلي عن نافع بن جبير بن مطعم النوفلي عن عمرو بن دينار الأثرم عن حماد بن سلمة عن أبو الوليد الطيالسي عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7412","19 - (  7409  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ، مِثْلَهُ .         [13/406]","","Musnad Abi Ya'la al-Mawsili 7409","","جبير بن مطعم بن عدي النوفلي عن نافع بن جبير بن مطعم النوفلي عن عمرو بن دينار الأثرم عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7413","20 - (  7410  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ قَالَ :  وَأَخْبَرَنَا  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  نَافِعِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِيهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ فِي سَفَرٍ ، فَقَالَ : مَنْ يَكْلَؤُنَا اللَّيْلَةَ ، لَا يَرْقُدُ عَنْ صَلَاةِ الْفَجْرِ ؟ فَقَالَ  بِلَالٌ  : أَنَا  ، فَاسْتَقْبَلَ مَطْلِعَ الشَّمْسِ ،  فَضُرِبَ  عَلَى آذَانِهِمْ ، فَمَا أَيْقَظَهُمْ إِلَّا حَرُّ الشَّمْسِ ، فَقَامُوا ، فَبَادَرُوا فَتَوَضَّؤُوا ، وَأَذَّنَ  بِلَالٌ  ، وَصَلَّوُا الرَّكْعَتَيْنِ ، ثُمَّ صَلَّوُا الْفَجْرَ  .","","Musnad Abi Ya'la al-Mawsili 7410","","جبير بن مطعم بن عدي النوفلي عن نافع بن جبير بن مطعم النوفلي عن عمرو بن دينار الأثرم عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7414","21 - (  7411  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  حُصَيْنٌ ،  عَنْ  مُحَمَّدِ بْنِ طَلْحَةَ ،  عَنْ  جُبَيْرِ بْنِ مُطْعِمٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  صَلَاةٌ فِي مَسْجِدِي هَذَا تَزِيدُ عَلَى سِوَاهُ مِنَ الْمَسَاجِدِ أَلْفَ صَلَاةٍ  ، لَيْسَ  الْمَسْجِدَ الْحَرَامَ  .         [13/407]             [13/408]","","Musnad Abi Ya'la al-Mawsili 7411","","جبير بن مطعم بن عدي النوفلي عن محمد بن طلحة بن يزيد بن ركانة الحجازي عن حصين بن عبد الرحمن السلمي عن عبد العزيز بن مسلم الخراساني عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7415","22 - (  7412  ) -  حَدَّثَنَا  سُلَيْمَانُ الشَّاذَكُونِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  حَدَّثَنَا  حُصَيْنٌ ،  عَنْ  مُحَمَّدِ بْنِ طَلْحَةَ بْنِ يَزِيدَ بْنِ رُكَانَةَ ،  عَنْ  جُبَيْرِ بْنِ مُطْعِمٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  صَلَاةٌ فِي مَسْجِدِي هَذَا أَفْضَلُ مِنْ أَلْفِ صَلَاةٍ فِيمَا سِوَاهُ إِلَّا  الْمَسْجِدَ الْحَرَامَ  .","","Musnad Abi Ya'la al-Mawsili 7412","","جبير بن مطعم بن عدي النوفلي عن محمد بن طلحة بن يزيد بن ركانة الحجازي عن حصين بن عبد الرحمن السلمي عن هشيم بن بشير عن الشاذكوني عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7416","23 - (  7413  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي ،  عَنِ  ابْنِ إِسْحَاقَ قَالَ :  فَذَكَرَ  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  أَبِيهِ جُبَيْرٍ  قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ وَهُوَ يَخْطُبُ النَّاسَ  بِالْخَيْفِ  :  نَضَّرَ  اللهُ عَبْدًا سَمِعَ مَقَالَتِي ،  فَوَعَاهَا  ، ثُمَّ أَدَّاهَا إِلَى مَنْ لَمْ يَسْمَعْهَا  ، فَرُبَّ حَامِلِ فِقْهٍ لَا فِقْهَ لَهُ ، وَرُبَّ حَامِلِ فِقْهٍ إِلَى مَنْ أَفْقَهُ مِنْهُ .  ثَلَاثٌ لَا  يُغِلُّ  عَلَيْهِنَّ قَلْبُ مُؤْمِنٍ : إِخْلَاصُ الْعَمَلِ لِلهِ ، وَطَاعَةُ ذَوِي الْأَمْرِ ، وَلُزُومُ الْجَمَاعَةِ ، فَإِنَّ دَعْوَتَهُمْ تَكُونُ مِنْ وَرَائِهِمْ  .         [13/409]             [13/410]             [13/411]","","Musnad Abi Ya'la al-Mawsili 7413","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن الزهري عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7417","24 - (  7414  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ زُهَيْرٌ ،  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنَا  أَبِي ،  عَنِ  ابْنِ إِسْحَاقَ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ أَبِي عَمْرٍو مَوْلَى الْمُطَّلِبِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْحُوَيْرِثِ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  أَبِيهِ  : مِثْلَ حَدِيثِ  ابْنِ شِهَابٍ  ، لَمْ يَزِدْ وَلَمْ يَنْقُصْ .         [13/412]","","Musnad Abi Ya'la al-Mawsili 7414","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن عبد الرحمن بن معاوية النوفلي عن عمرو بن أبي عمرو المخزومي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7418","25 - (  7415  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ، وَإِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ، قَالَا :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ بَابَاهْ ،  عَنْ  جُبَيْرِ بْنِ مُطْعِمٍ -  يَبْلُغُ بِهِ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  يَا  بَنِي عَبْدِ مَنَافٍ  ، لَا تَمْنَعُوا أَحَدًا طَافَ بِهَذَا  الْبَيْتِ  أَوْ صَلَّى أَيَّ سَاعَةٍ مِنْ لَيْلٍ أَوْ نَهَارٍ  .","","Musnad Abi Ya'la al-Mawsili 7415","","جبير بن مطعم بن عدي النوفلي عن عبد الله بن باباه البصري عن أبو الزبير المكي عن سفيان بن عيينة عن هارون بن معروف المروزي عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7419","26 - (  7416  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَوْ كَانَ  الْمُطْعِمُ  حَيًّا قَالَ : وَكَانَ لَهُ عِنْدَهُ يَدٌ ، فَكَلَّمَنِي فِي هَؤُلَاءِ  النَّتْنَى  لَأَطْلَقْتُهُمْ - أُسَارَى بَدْرٍ  -  .         [13/413]","","Musnad Abi Ya'la al-Mawsili 7416","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن الزهري عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7420","27 - (  7417  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  سَمِعْتُ  سُلَيْمَانَ بْنَ صُرَدٍ قَالَ :  سَمِعْتُ  جُبَيْرَ بْنَ مُطْعِمٍ ، قَالَ :  ذُكِرَ  الْغُسْلُ  مِنَ الْجَنَابَةِ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَمَّا أَنَا فَأَصُبُّ عَلَى رَأْسِي ثَلَاثًا  .","","Musnad Abi Ya'la al-Mawsili 7417","","جبير بن مطعم بن عدي النوفلي عن سليمان بن صرد الخزاعي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7421","28 - (  7418  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  النَّضْرُ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ قَالَ :  أَخْبَرَنِي  بَعْضُ إِخْوَتِي ،  عَنْ  جُبَيْرِ بْنِ مُطْعِمٍ  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي فِدَاءٍ مِنْ فِدَاءِ الْمُشْرِكِينَ قَالَ :  فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يُصَلِّي الْمَغْرِبَ ، فَقَرَأَ فِيهَا بِـ ( الطُّورِ ) ، فَكَأَنَّمَا صُدِعَ قَلْبِي حِينَ سَمِعْتُ الْقُرْآنَ  .         [13/414]","","Musnad Abi Ya'la al-Mawsili 7418","","جبير بن مطعم بن عدي النوفلي عن بعض إخوة سعد بن إبراهيم بن عبد الرحمن بن عوف عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7422","29 - (  7419  ) -  حَدَّثَنَا  أَبُو هِشَامٍ مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ الْحَكَمِ الْقُدَيْدِيُّ قَالَ :  حَدَّثَنِي  أَبِي ،  عَنْ  إِسْمَاعِيلَ بْنِ خَالِدٍ الْخُزَاعِيِّ  أَنَّ  مُحَمَّدَ بْنَ جُبَيْرِ بْنِ مُطْعِمٍ ،  سَمِعَ  جُبَيْرَ بْنَ مُطْعِمٍ ،  وَهُوَ يَقُولُ : قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أَتُحِبُّ يَا  جُبَيْرُ  إِذَا خَرَجْتَ سَفَرًا أَنْ تَكُونَ مِنْ أَمْثَلِ أَصْحَابِكَ هَيْئَةً ،  وَأَكْثَرِهِمْ زَادًا ؟ فَقُلْتُ : نَعَمْ ، بِأَبِي أَنْتَ وَأُمِّي . قَالَ : فَاقْرَأْ هَذِهِ السُّوَرَ الْخَمْسَ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      إِذَا جَاءَ نَصْرُ اللهِ وَالْفَتْحُ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      وَ         {      قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ         }      وَ         {      قُلْ أَعُوذُ بِرَبِّ النَّاسِ         }      وَافْتَحْ كُلَّ سُورَةٍ بِبِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ، وَاخْتِمْ قِرَاءَتَكَ بِبِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ، قَالَ  جُبَيْرٌ  : وَكُنْتُ غَنِيًّا كَثِيرَ الْمَالِ ، فَكُنْتُ أَخْرُجُ مَعَ مَنْ شَاءَ اللهُ أَنْ أَخْرُجَ مَعَهُمْ فِي سَفَرٍ ، فَأَكُونَ  أَبَذَّهُمْ  هَيْئَةً ، وَأَقَلَّهُمْ زَادًا ، فَمَا زِلْتُ مُنْذُ عَلَّمَنِيهِنَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَرَأْتُ بِهِنَّ أَكُونُ مِنْ أَحْسَنِهِمْ هَيْئَةً ، وَأَكْثَرِهِمْ زَادًا ، حَتَّى أَرْجِعَ مِنْ سَفَرِي ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 7419","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن إسماعيل بن خالد الخزاعي عن سليمان بن الحكم بن أيوب الخزاعي عن محمد بن سليمان الخزاعي عن أبو يعلى الموصلي","حديث جبير بن مطعم عن النبي صلى الله عليه وسلم"
"7423","[13/415]      حَدِيثُ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  1 - (  7420  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  عَبْدُ الْأَعْلَى أَبُو مُحَمَّدٍ السَّامِيُّ ،  حَدَّثَنَا  سَعِيدٌ ، يَعْنِي : الْجُرَيْرِيَّ ،         [13/416]      عَنْ  أَبِي نَضْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَوَلَةَ الْقُشَيْرِيِّ قَالَ :  كُنْتُ  بِالْأَهْوَازِ  إِذْ مَرَّ بِي شَيْخٌ ضَخْمٌ عَلَى بَغْلَةٍ ، وَهُوَ يَقُولُ : اللَّهُمَّ ذَهَبَ قَرْنِي مِنْ هَذِهِ الْأُمَّةِ ، فَأَلْحِقْنِي بِهِمْ ، فَأَلْحَقْتُهُ دَابَّتِي ، فَقُلْتُ : وَأَنَا يَرْحَمُكَ اللهُ . قَالَ : وَصَاحِبِي هَذَا إِنْ أَرَادَ ذَلِكَ . قَالَ : ثُمَّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَيْرُ أُمَّتِي  قَرْنِي  ، ثُمَّ الَّذِينَ يَلُونَهُمْ  -  فَلَا أَدْرِي أَذَكَرَ الثَّالِثَ أَمْ لَا  - ثُمَّ يَخْلُفُ قَوْمٌ يَظْهَرُ فِيهُمُ  السِّمَنُ  وَيُهَرِيقُونَ الشَّهَادَةَ ، وَلَا يَسْأَلُونَهَا "" فَإِذَا هُوَ أَبُو بَرْزَةَ الْأَسْلَمِيُّ  .         [13/417]","","Musnad Abi Ya'la al-Mawsili 7420","","نضلة بن عبيد بن عابد الأسلمي عن عبد الله بن مولة القشيري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن عبد الأعلى بن عبد الأعلى القرشي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7424","2 - (  7421  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ قَالَ :  حَدَّثَنِي  حَجَّاجُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي حَمْزَةَ جَارِهِمْ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُطَرِّفٍ ،  عَنْ  أَبِي بَرْزَةَ قَالَ :  كَانَ أَبْغَضَ الْأَحْيَاءِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بَنُو أُمَيَّةَ  ،  وَثَقِيفُ  ،  وَبَنُو حَنِيفَةَ  .","","Musnad Abi Ya'la al-Mawsili 7421","","نضلة بن عبيد بن عابد الأسلمي عن عبد الله بن مطرف العامري عن حميد بن هلال العدوي عن عبد الرحمن بن عبد الله المازني عن شعبة بن الحجاج عن حجاج بن محمد الأعور عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7425","3 - (  7422  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  عَوْفٍ ،  عَنْ  سَيَّارِ بْنِ سَلَامَةَ ،  عَنْ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَكْرَهُ النَّوْمَ قَبْلَ الْعِشَاءِ  ، وَالْحَدِيثَ بَعْدَهَا قَالَ : وَكَانَ يَقْرَأُ فِي صَلَاةِ الصُّبْحِ مِنْ سِتِّينَ إِلَى الْمِائَةِ ، وَكَانَ يَعْرِفُ كُلُّ وَاحِدٍ مِنَّا مَنْ يَلِيهِ  .         [13/418]             [13/419]","","Musnad Abi Ya'la al-Mawsili 7422","","نضلة بن عبيد بن عابد الأسلمي عن سيار بن سلامة الرياحي عن عوف بن أبي جميلة عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7426","4 - (  7423  ) -  حَدَّثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ الْكُوفِيُّ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ اللهِ بْنِ جُرَيْجٍ ،  عَنْ  أَبِي بَرْزَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا مَعْشَرَ مَنْ آمَنَ بِلِسَانِهِ وَلَمْ يَدْخُلِ الْإِيمَانُ قَلْبَهُ ، لَا تَغْتَابُوا الْمُسْلِمِينَ  ، وَلَا تَتَّبِعُوا  عَوْرَاتِهِمْ  ، فَإِنَّهُ مَنْ تَتَبَّعَ  عَوْرَاتِ  الْمُسْلِمِينَ تَتَّبَعَ اللهُ  عَوْرَتَهُ  حَتَّى يَفْضَحَهُ فِي بَيْتِهِ  .         [13/420]","","Musnad Abi Ya'la al-Mawsili 7423","","نضلة بن عبيد بن عابد الأسلمي عن سعيد بن عبد الله بن جريج الأسلمي عن الأعمش عن أبو بكر بن عياش عن مسروق بن المرزبان الكندي عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7427","5 - (  7424  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَسْوَدُ بْنُ عَامِرٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ اللهِ بْنِ جُرَيْجٍ ،  عَنْ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 7424","","نضلة بن عبيد بن عابد الأسلمي عن سعيد بن عبد الله بن جريج الأسلمي عن الأعمش عن أبو بكر بن عياش عن الأسود بن عامر شاذان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7428","6 - (  7425  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  عَوْفٍ قَالَ :  حَدَّثَنِي  أَبُو الْمِنْهَالِ قَالَ :  انْطَلَقَ أَبِي ، وَانْطَلَقْتُ مَعَهُ ، فَدَخَلْنَا عَلَى أَبِي بَرْزَةَ الْأَسْلَمِيِّ ،  فَقَالَ لَهُ  أَبِي : حَدِّثْنَا كَيْفَ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الْمَكْتُوبَةَ قَالَ :  كَانَ يُصَلِّي  الْهَجِيرَ  الَّتِي تَدْعُونَهَا الْأُولَى حِينَ  تَدْحَضُ  الشَّمْسُ  ، وَيُصَلِّي الْعَصْرَ حِينَ يَرْجِعُ أَحَدُنَا إِلَى رَحْلِهِ         [13/421]      فِي أَقْصَى  الْمَدِينَةِ  ، وَالشَّمْسُ  حَيَّةٌ  قَالَ : وَنَسِيتُ مَا قَالَ فِي الْمَغْرِبِ قَالَ : وَكَانَ يَسْتَحِبُّ أَنْ يُؤَخِّرَ الْعِشَاءَ الَّتِي تَدْعُونَهَا  الْعَتَمَةَ  ، وَكَانَ يَكْرَهُ النَّوْمَ قَبْلَهَا ، وَالْحَدِيثَ بَعْدَهَا ، وَكَانَ يَنْفَتِلُ مِنْ صَلَاةِ الْغَدَاةِ حِينَ يَعْرِفُ الرَّجُلُ جَلِيسَهُ ، وَكَانَ يَقْرَأُ بِالسِّتِّينَ إِلَى الْمِائَةِ  .","","Musnad Abi Ya'la al-Mawsili 7425","","نضلة بن عبيد بن عابد الأسلمي عن سيار بن سلامة الرياحي عن عوف بن أبي جميلة عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7429","7 - (  7426  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  حَجَّاجِ بْنِ دِينَارٍ ،  عَنْ  أَبِي هَاشِمٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنْ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ إِذَا أَرَادَ أَنْ يَقُومَ مِنَ الْمَجْلِسِ :  سُبْحَانَكَ اللَّهُمَّ  وَبِحَمْدِكَ ،  أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ ، أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ  "" .         [13/422]","","Musnad Abi Ya'la al-Mawsili 7426","","نضلة بن عبيد بن عابد الأسلمي عن رفيع بن مهران عن يحيى بن دينار الرماني عن حجاج بن دينار الأشجعي عن عبدة بن سليمان الكلابي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7430","8 - (  7427  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  أَبَانَ بْنِ صَمْعَةَ ،  عَنْ  أَبِي الْوَازِعِ ،  عَنْ  أَبِي بَرْزَةَ قَالَ :  قُلْتُ :  يَا رَسُولَ اللهِ ! دُلَّنِي عَلَى عَمَلٍ أَنْتَفِعُ بِهِ ، قَالَ : نَحِّ  الْأَذَى  عَنْ طَرِيقِ الْمُسْلِمِينَ  .         [13/423]             [13/424]","","Musnad Abi Ya'la al-Mawsili 7427","","نضلة بن عبيد بن عابد الأسلمي عن جابر بن عمرو الراسبي عن أبان بن صمعة عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7431","9 - (  7428  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنِ  التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أَبِي بَرْزَةَ  أَنَّ جَارِيَةً بَيْنَا هِيَ عَلَى  بَعِيرٍ ، أَوْ رَاحِلَةٍ  عَلَيْهَا مَتَاعُ  الْقَوْمِ  بَيْنَ جَبَلَيْنِ ، فَتَضَايَقَ بِهَا الْجَبَلُ ، فَأَتَى عَلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا أَبْصَرَتْهُ ، جَعَلَتْ تَقُولُ : حَلٍ ، اللَّهُمَّ الْعَنْهُ ، اللَّهُمَّ الْعَنْهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَاحِبُ الْجَارِيَةِ ؟ لَا تَصْحَبُنَا  رَاحِلَةٌ أَوْ بَعِيرٌ  عَلَيْهَا لَعْنَةٌ مِنَ اللهِ ، أَوْ كَمَا قَالَ  .         [13/425]","","Musnad Abi Ya'la al-Mawsili 7428","","نضلة بن عبيد بن عابد الأسلمي عن أبو عثمان النهدي عن سليمان بن طرخان عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7432","10 - (  7429  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنِ  التَّيْمِيِّ ،  عَنْ  أَبِي الْمِنْهَالِ ،  عَنْ  أَبِي بَرْزَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقْرَأُ فِي صَلَاةِ الْغَدَاةِ مِنَ السِّتِّينَ إِلَى الْمِائَةِ  .","","Musnad Abi Ya'la al-Mawsili 7429","","نضلة بن عبيد بن عابد الأسلمي عن سيار بن سلامة الرياحي عن سليمان بن طرخان عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7433","11 - (  7430  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ قَالَ :  حَدَّثَتْنِي  أُمُّ الْأَسْوَدِ ،  عَنْ  مُنْيَةَ ،  عَنْ  حَدِيثِ أَبِي بَرْزَةَ قَالَ :  كَانَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تِسْعُ نِسْوَةٍ ،  فَقَالَ يَوْمًا : خَيْرُكُنَّ  أَطْوَلُكُنَّ  يَدًا  ، فَقَامَتْ كُلُّ وَاحِدَةٍ تَضَعُ يَدَهَا عَلَى الْجِدَارِ ، قَالَ : لَسْتُ أَعْنِي هَذَا ، وَلَكِنْ أَصْنَعَكُنَّ يَدَيْنِ  .         [13/426]","","Musnad Abi Ya'la al-Mawsili 7430","","نضلة بن عبيد بن عابد الأسلمي عن منية بنت عبيد بن أبي برزة الأسلمي عن أم الأسود الخزاعية مولاة أبى برزة الأسلمى عن أحمد بن عبد الله اليربوعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7434","12 - (  7431  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ قَالَ :  حَدَّثَنِي  عَوْفٌ ،  عَنْ  مُسَاوِرِ بْنِ عُبَيْدٍ قَالَ :  حَدَّثَنِي  أَبُو بَرْزَةَ قَالَ :  رَجَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجُلًا مِنَّا يُقَالُ لَهُ :  مَاعِزُ بْنُ مَالِكٍ  .         [13/427]","","Musnad Abi Ya'la al-Mawsili 7431","","نضلة بن عبيد بن عابد الأسلمي عن مساور بن عبيد الحماني عن عوف بن أبي جميلة عن هوذة بن خليفة البكراوي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7435","13 - (  7432  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ،  حَدَّثَنَا  أَبُو الْوَازِعِ قَالَ :  سَمِعْتُ  أَبَا بَرْزَةَ يُحَدِّثُ قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى أَحْيَاءٍ مِنْ أَحْيَاءِ الْعَرَبِ فِي شَيْءٍ لَا أَدْرِي مَا هُوَ ، فَشَتَمُوهُ وَسَبُّوهُ وَضَرَبُوهُ ، فَرَجَعَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أَمَا إِنَّكَ لَوْ  أَهْلَ عُمَانَ  أَتَيْتَ مَا سَبُّوكَ وَلَا ضَرَبُوكَ  .","","Musnad Abi Ya'la al-Mawsili 7432","","نضلة بن عبيد بن عابد الأسلمي عن جابر بن عمرو الراسبي عن مهدي بن ميمون المعولي عن يونس بن محمد بن مسلم البغدادي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7436","14 - (  7433  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ ،  عَنْ  أُمِّ الْأَسْوَدِ ،  عَنْ  مُنْيَةَ ،  عَنْ  حَدِيثِ أَبِي بَرْزَةَ قَالَ :  سَأَلُوا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ رَجُلٍ أَقْلَفَ ، أَيَحُجُّ بَيْتَ اللهِ ؟ قَالَ :  لَا ، نَهَانِيَ اللهُ - عَزَّ وَجَلَّ - عَنْ ذَلِكَ حَتَّى يَخْتَتِنَ  .         [13/428]","","Musnad Abi Ya'la al-Mawsili 7433","","نضلة بن عبيد بن عابد الأسلمي عن منية بنت عبيد بن أبي برزة الأسلمي عن أم الأسود الخزاعية مولاة أبى برزة الأسلمى عن أحمد بن عبد الله اليربوعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7437","15 - (  7434  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  أَسْوَدُ بْنُ عَامِرٍ ،  عَنْ  أَبِي بَكْرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ اللهِ بْنِ جُرَيْجٍ ،  عَنْ  أَبِي بَرْزَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا تَزُولُ قَدَمَا الْعَبْدِ يَوْمَ الْقِيَامَةِ حَتَّى يُسْأَلَ عَنْ عُمُرِهِ فِيمَا أَفْنَاهُ  ، وَعَنْ عِلْمِهِ مَا عَمِلَ فِيهِ ، وَعَنْ مَالِهِ مِنْ أَيْنَ اكْتَسَبَهُ ، وَفِيمَا أَنْفَقَهُ ، وَعَنْ جَسَدِهِ فِيمَا أَبْلَاهُ  .         [13/429]","","Musnad Abi Ya'la al-Mawsili 7434","","نضلة بن عبيد بن عابد الأسلمي عن سعيد بن عبد الله بن جريج الأسلمي عن الأعمش عن أبو بكر بن عياش عن الأسود بن عامر شاذان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7438","16 - (  7435  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ،  حَدَّثَنَا  أَبُو الْوَازِعِ جَابِرُ بْنُ عَمْرٍو ،  عَنْ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلًا  إِلَى حَيٍّ مِنْ أَحْيَاءِ الْعَرَبِ فِي شَيْءٍ لَا أَدْرِي مَا هُوَ ، فَسَبُّوهُ وَضَرَبُوهُ ، فَرَجَعَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَشَكَا ذَلِكَ إِلَيْهِ ، فَقَالَ :  لَكِنَّ  أَهْلَ عُمَانَ  لَوْ أَتَاهُمْ رَسُولِي مَا سَبُّوهُ وَلَا ضَرَبُوهُ  .","","Musnad Abi Ya'la al-Mawsili 7435","","نضلة بن عبيد بن عابد الأسلمي عن جابر بن عمرو الراسبي عن مهدي بن ميمون المعولي عن هدبة بن خالد عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7439","17 - (  7436  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  جَرِيرٌ ، وَمُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  سُلَيْمَانَ بْنِ عَمْرِو بْنِ الْأَحْوَصِ قَالَ :  حَدَّثَنِي  أَبُو هِلَالٍ ،  عَنْ  أَبِي بَرْزَةَ قَالَ :  كُنَّا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ ، فَسَمِعَ رَجُلَيْنِ يَتَغَنَّيَانِ ، وَأَحَدُهُمَا يَقُولُ لِصَاحِبِهِ :         [13/430]      قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" مَنْ هَذَا ؟ قَالَ : فَقِيلَ لَهُ :  فُلَانٌ  وَفُلَانٌ  قَالَ : فَقَالَ :  اللَّهُمَّ أَرْكِسْهُمَا فِي الْفِتْنَةِ  رَكْسًا         [13/431]      وَدُعَّهُمَا فِي النَّارِ دَعًّا  .","","Musnad Abi Ya'la al-Mawsili 7436","","نضلة بن عبيد بن عابد الأسلمي عن أبو هلال عن سليمان بن عمرو الجشمي عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7440","18 - (  7437  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  سُلَيْمَانَ بْنِ عَمْرِو بْنِ الْأَحْوَصِ قَالَ :  حَدَّثَنِي  رَبُّ هَذِهِ الدَّارِ أَبُو هِلَالٍ  أَنَّهُ سَمِعَ  أَبَا بَرْزَةَ الْأَسْلَمِيَّ يُحَدِّثُ  أَنَّهُمْ كَانُوا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَمِعُوا غِنَاءً  فَتَشَوَّفُوا  لَهُ  ، فَقَامَ  رَجُلٌ  فَاسْتَمَعَ ، وَذَلِكَ قَبْلَ أَنْ تُحَرَّمَ الْخَمْرُ ، فَأَتَاهُمْ ، ثُمَّ رَجَعَ ، فَقَالَ : هَذَا         [13/432]      فُلَانٌ  وَفُلَانٌ  ، وَهُمَا يَتَغَنَّيَانِ يُجِيبُ أَحَدُهُمَا الْآخَرَ ، وَهُوَ يَقُولُ  : فَذَكَرَ نَحْوَهُ  .","","Musnad Abi Ya'la al-Mawsili 7437","","نضلة بن عبيد بن عابد الأسلمي عن أبو هلال عن سليمان بن عمرو الجشمي عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7441","19 - (  7438  ) -  حَدَّثَنَا  أَحْمَدُ ، يَعْنِي : ابْنَ إِبْرَاهِيمَ الدَّوْرَقِيَّ ،  حَدَّثَنَا  أَبُو دَاوُدَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْمُغِيرَةِ بْنِ أَبِي بَرْزَةَ ،  عَنْ  أَبِيهِ  قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  غِفَارُ  غَفَرَ  اللهُ لَهَا ،  وَأَسْلَمُ  سَالَمَهَا  اللهُ ، مَا أَنَا قُلْتُهُ ، وَلَكِنَّ اللهَ قَالَهُ  .","","Musnad Abi Ya'la al-Mawsili 7438","","نضلة بن عبيد بن عابد الأسلمي عن المغيرة بن أبي برزة الأسلمي عن علي بن زيد بن جدعان عن شعبة بن الحجاج عن أبو داود الطيالسي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7442","20 - (  7439  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  يُونُسُ         [13/433]      بْنُ مُحَمَّدٍ قَالَ :  حَدَّثَتْنَا  أُمُّ الْأَسْوَدِ بِنْتُ يَزِيدَ مَوْلَى أَبِي بَرْزَةَ الْأَسْلَمِيِّ ، قَالَتْ :  حَدَّثَتْنِي  مُنْيَةُ بِنْتُ عُبَيْدِ بْنِ أَبِي بَرْزَةَ ،  عَنْ  جَدِّهَا أَبِي بَرْزَةَ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ عَزَّى الثَّكْلَى ، كُسِيَ بُرْدًا مِنَ الْجَنَّةِ  "" .         [13/434]","","Musnad Abi Ya'la al-Mawsili 7439","","نضلة بن عبيد بن عابد الأسلمي عن منية بنت عبيد بن أبي برزة الأسلمي عن أم الأسود الخزاعية مولاة أبى برزة الأسلمى عن يونس بن محمد بن مسلم البغدادي عن إبراهيم بن سعيد الجوهري عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7443","21 - (  7440  ) -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  حَدَّثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  حَدَّثَنَا  زِيَادُ بْنُ الْمُنْذِرِ ،  عَنْ  نَافِعِ بْنِ الْحَارِثِ ،  عَنْ  أَبِي بَرْزَةَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَبْعَثُ اللهُ - عَزَّ وَجَلَّ - يَوْمَ الْقِيَامَةِ قَوْمًا مِنْ قُبُورِهِمْ  تَأَجَّجُ  أَفْوَاهُهُمْ نَارًا  ، فَقِيلَ : مَنْ هُمْ يَا رَسُولَ اللهِ ؟ فَقَالَ : أَلَمْ تَرَ أَنَّ اللهَ يَقُولُ :         {      إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا إِنَّمَا يَأْكُلُونَ فِي بُطُونِهِمْ نَارًا         }      ؟ .         [13/435]","","Musnad Abi Ya'la al-Mawsili 7440","","نضلة بن عبيد بن عابد الأسلمي عن نفيع بن الحارث الأعمى عن زياد بن المنذر الهمداني عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7444","22 - (  7440  ) م1  -  وَعَنْ  نَافِعِ بْنِ الْحَارِثِ ،  حَدَّثَنَا  أَبُو بَرْزَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  أَلَا         [13/436]      إِنَّ الْكَذِبَ يُسَوِّدُ الْوَجْهَ ، وَالنَّمِيمَةَ عَذَابُ الْقَبْرِ  .","","Musnad Abi Ya'la al-Mawsili 7440","","نضلة بن عبيد بن عابد الأسلمي عن نفيع بن الحارث الأعمى عن زياد بن المنذر الهمداني عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7445","23 - (  7440  ) م2  -  وَعَنْ  نَافِعٍ ،  عَنْ  أَبِي بَرْزَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِنَّ بَعْدِي أَئِمَّةً ، إِنْ أَطَعْتُمُوهُمْ أَكْفَرُوكُمْ ، وَإِنْ عَصَيْتُمُوهُمْ قَتَلُوكُمْ  : أَئِمَّةُ الْكُفْرِ ، وَرُؤُوسُ الضَّلَالَةِ  .","","Musnad Abi Ya'la al-Mawsili 7440","","نضلة بن عبيد بن عابد الأسلمي عن نفيع بن الحارث الأعمى عن زياد بن المنذر الهمداني عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7446","24 - (  7440  ) م3  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْكُوفِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  سُلَيْمَانَ بْنِ عَمْرِو بْنِ الْأَحْوَصِ الْأَزْدِيِّ قَالَ :  حَدَّثَنِي  أَبُو هِلَالٍ صَاحِبُ هَذِهِ الدَّارِ .         [13/437]      عَنْ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَفَعَ يَدَيْهِ فِي الدُّعَاءِ حَتَّى رُئِيَ بَيَاضُ إِبْطَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 7440","","نضلة بن عبيد بن عابد الأسلمي عن أبو هلال عن سليمان بن عمرو الجشمي عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","حديث أبي برزة الأسلمي عن النبي صلى الله عليه وسلم"
"7447","[13/438]      حَدِيثُ  جَابِرِ بْنِ سَمُرَةَ السُّوَائِيِّ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  1 - (  7441  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ قَائِمًا ، ثُمَّ يَقْعُدُ ، فَلَا يَتَكَلَّمُ  ، ثُمَّ يَقُومُ فَيَخْطُبُ خُطْبَةً أُخْرَى عَلَى مِنْبَرِهِ ، فَمَنْ حَدَّثَكَ أَنَّهُ رَآهُ يَخْطُبُ قَاعِدًا فَلَا تُصَدِّقْهُ  .         [13/439]","","Musnad Abi Ya'la al-Mawsili 7441","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7448","2 - (  7442  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ  "" .         [13/440]","","Musnad Abi Ya'la al-Mawsili 7442","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7449","3 - (  7443  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ الْوَلِيدُ بْنُ شُجَاعٍ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  زِيَادُ بْنُ خَيْثَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنِّي  فَرَطٌ  لَكُمْ عَلَى الْحَوْضِ ،  وَإِنَّ بُعْدَ مَا بَيْنَ طَرَفَيْهِ كَمَا بَيْنَ  صَنْعَاءَ  وَأَيْلَةَ  ، كَأَنَّ الْأَبَارِيقَ فِيهِ النُّجُومُ  .         [13/441]","","Musnad Abi Ya'la al-Mawsili 7443","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زياد بن خيثمة الجعفي عن شجاع بن الوليد السكوني عن الوليد بن شجاع عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7450","4 - (  7444  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  لَتَفْتَحَنَّ عِصَابَةٌ  مِنَ الْمُسْلِمِينَ ، أَوْ مِنَ الْمُؤْمِنِينَ  ، كَنْزَ  آلِ كِسْرَى  الَّذِي فِي الْبِيضِ  قَالَ : وَسَمِعْتُهُ يَقُولُ :  إِنَّ اللهَ سَمَّى  الْمَدِينَةَ  طَابَةَ  .         [13/442]","","Musnad Abi Ya'la al-Mawsili 7444","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7451","5 - (  7445  ) -  وَبِإِسْنَادِهِ  ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  مَاتَ بَغْلٌ عِنْدَ  رَجُلٍ  ، فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْتَفْتِيهِ قَالَ : فَزَعَمَ  جَابِرٌ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لِصَاحِبِهَا :  مَا لَكَ مَا يُغْنِيكَ عَنْهَا ؟ قَالَ : لَا . قَالَ : اذْهَبْ فَكُلْهَا  .         [13/443]","","Musnad Abi Ya'la al-Mawsili 7445","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7452","6 - (  7446  ) -  وَعَنْ  جَابِرٍ قَالَ :  رَأَيْتُ  مَاعِزَ بْنَ مَالِكٍ  حِينَ جِيءَ بِهِ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَاسِرًا ، مَا عَلَيْهِ رِدَاءٌ ، فَشَهِدَ عَلَى نَفْسِهِ أَرْبَعَ مَرَّاتٍ أَنَّهُ قَدْ زَنَى ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَلَعَلَّكَ ؟ "" قَالَ : لَا ، وَاللهِ إِنَّهُ قَدْ زَنَى  الْأَخِرُ  قَالَ : فَرَجَمَهُ ، ثُمَّ خَطَبَ ،         [13/444]      فَقَالَ :  أَلَا كُلَّمَا نَفَرُوا فِي  سَبِيلِ  اللهِ  خَلَفَ  أَحَدُهُمْ لَهُ نَبِيبٌ  كَنَبِيبِ  التَّيْسِ  ، يَمْنَحُ إِحْدَاهُنَّ  الْكُثْبَةَ  ، أَمَا إِنْ أَمْكَنَنِي اللهُ - عَزَّ وَجَلَّ - مِنْ أَحَدٍ مِنْهُمْ  لَأُنَكِّلَنَّهُ  عَنْهُنَّ  .         [13/445]","","Musnad Abi Ya'la al-Mawsili 7446","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7453","7 - (  7447  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي نَحْوَ صَلَاتِكُمْ  ، وَيُؤَخِّرُ  الْعَتَمَةَ  بَعْدَ صَلَاتِكُمْ شَيْئًا ، وَكَانَ يُخِفُّ الصَّلَاةَ  .         [13/446]","","Musnad Abi Ya'la al-Mawsili 7447","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن عبيد بن حساب الغبري عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7454","8 - (  7448  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  مَاتَتْ نَاقَةٌ لِأُنَاسٍ مِنْ  بَنِي سُلَيْمٍ  أَوْ غَيْرِهِمْ مِنَ الْحَيِّ  ، وَكَانُوا أَهْلَ بَيْتٍ مُحْتَاجِينَ ، فَسَأَلُوا النَّبِيَّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ أَكْلِهَا فَرَخَّصَ لَهُمُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَكْلِهَا فَكَفَتْهُمْ شِتْوَتَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 7448","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7455","9 - (  7449  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  جَالَسْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكْثَرَ مِنْ مِائَةِ مَرَّةٍ  ، وَكَانَ أَصْحَابُهُ يَتَنَاشَدُونَ الشِّعْرَ ، وَيَتَذَاكَرُونَ شَيْئًا مِنْ أَمْرِ         [13/447]      الْجَاهِلِيَّةِ ، فَرُبَّمَا تَبَسَّمَ مَعَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 7449","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7456","10 - (  7450  ) -  وَعَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  كَانَ بِلَالٌ يُؤَذِّنُ الظُّهْرَ إِذَا دَحَضَتِ الشَّمْسُ ، وَكَانَ رُبَّمَا أَخَّرَ الْإِقَامَةَ ، وَلَا يُؤَخِّرُ الْأَذَانَ عَنِ الْوَقْتِ  .         [13/448]","","Musnad Abi Ya'la al-Mawsili 7450","","بلال بن رباح سابق الحبشة عن جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7457","11 - (  7451  ) -  وَعَنْ  جَابِرِ بْنِ سَمُرَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجَمَ  يَهُودِيًّا  وَيَهُودِيَّةً  .","","Musnad Abi Ya'la al-Mawsili 7451","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7458","12 - (  7452  ) -  وَعَنْ  جَابِرٍ قَالَ :  جَالَسْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكْثَرَ مِنْ مِائَةِ مَرَّةٍ فَمَا كَانَ يَخْطُبُ إِلَّا قَائِمًا وَكَانَ يَقْعُدُ قَعْدَةً  .         [13/449]","","Musnad Abi Ya'la al-Mawsili 7452","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7459","13 - (  7453  ) -  وَعَنْ  جَابِرٍ قَالَ :  كُنَّا إِذَا أَتَيْنَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَلَسَ أَحَدُنَا حَيْثُ يَنْتَهِي  .","","Musnad Abi Ya'la al-Mawsili 7453","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7460","14 - (  7454  ) -  وَعَنْ  جَابِرٍ قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ عِيدٍ فَلَمْ يُؤَذِّنْ وَلَمْ يُقِمْ  .         [13/450]","","Musnad Abi Ya'la al-Mawsili 7454","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7461","15 - (  7455  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ ،  حَدَّثَنَا  حَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَمْشَ السَّاقَيْنِ إِذَا رَأَيْتَهُ قُلْتَ :  أَكْحَلُ  ، وَلَيْسَ بِأَكْحَلَ  ، لَا يَضْحَكُ إِلَّا تَبَسُّمًا  .         [13/451]","","Musnad Abi Ya'la al-Mawsili 7455","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حجاج بن أرطاة عن عبد الرحيم بن سليمان الأشل عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7462","16 - (  7456  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ  أَنَّهُ سَمِعَ  جَابِرَ بْنَ سَمُرَةَ ، يَقُولُ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ شَمِطَ مُقَدَّمُ رَأْسِهِ وَلِحْيَتِهِ  ، فَإِذَا ادَّهَنَ وَمَشَطَهُ لَمْ يَتَبَيَّنْ ، فَإِذَا شَعِثَ رَأَيْتُهُ ، وَكَانَ كَثِيرَ شَعَرِ اللِّحْيَةِ ، فَقَالَ  رَجُلٌ  : وَجْهُهُ مِثْلُ السَّيْفِ ؟ قَالَ : لَا ، مِثْلُ الشَّمْسِ وَالْقَمَرِ مُسْتَدِيرٌ قَالَ : وَرَأَيْتُ خَاتَمَهُ عِنْدَ كَتِفِهِ مِثْلَ بَيْضَةِ النَّعَامَةِ تُشْبِهُ جَسَدَهُ  .         [13/452]","","Musnad Abi Ya'la al-Mawsili 7456","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرحيم بن سليمان الأشل عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7463","17 - (  7457  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَيْتُهُ مُتَّكِئًا عَلَى مِرْفَقِهِ  .         [13/453]","","Musnad Abi Ya'la al-Mawsili 7457","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7464","18 - (  7458  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  حَجَّاجٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  كَانَ فِي سَاقَيْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  حُمُوشَةٌ  ، وَكَانَ لَا يَضْحَكُ إِلَّا تَبَسُّمًا  ، وَكَانَ إِذَا نَظَرْتَ إِلَيْهِ قُلْتَ :  أَكْحَلُ  الْعَيْنَيْنِ ، وَلَيْسَ بِأَكْحَلَ  .","","Musnad Abi Ya'la al-Mawsili 7458","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حجاج بن أرطاة عن عباد بن العوام الكلابي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7465","19 - (  7459  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقْرَأُ فِي الْفَجْرِ بِـ         {      ق وَالْقُرْآنِ الْمَجِيدِ         }      وَكَانَتْ صَلَاتُهُ بَعْدُ تَخْفِيفًا  .         [13/454]","","Musnad Abi Ya'la al-Mawsili 7459","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7466","20 - (  7460  ) -  حَدَّثَنَا  مَخْلَدُ بْنُ أَبِي زُمَيْلٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  سَأَلَ  رَجُلٌ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُصَلِّي فِي الثَّوْبِ الَّذِي آتِي فِيهِ أَهْلِي ؟ قَالَ : نَعَمْ إِلَّا أَنْ تَرَى فِيهِ شَيْئًا فَتَغْسِلَهُ  .         [13/455]","","Musnad Abi Ya'la al-Mawsili 7460","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن عبيد الله بن عمرو بن أبي الوليد عن مخلد بن الحسن بن أبي زميل الحراني عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7467","21 - (  7461  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنِ  الْمُهَاجِرِ بْنِ مِسْمَارٍ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَنَا  الْفَرَطُ  عَلَى الْحَوْضِ  .","","Musnad Abi Ya'la al-Mawsili 7461","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7468","22 - (  7462  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  فِطْرٌ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  ثَلَاثٌ أَخَافُ عَلَى أُمَّتِي : اسْتِسْقَاءٌ بِالْأَنْوَاءِ  ، وَحَيْفُ السُّلْطَانِ ، وَتَكْذِيبٌ بِالْقَدَرِ  .         [13/456]","","Musnad Abi Ya'la al-Mawsili 7462","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن فطر بن خليفة عن محمد بن القاسم الأسدي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7469","23 - (  7463  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنِ  الْمُهَاجِرِ بْنِ مِسْمَارٍ ، عَنْ عَامِرِ بْنِ سَعْدٍ قَالَ :  كَتَبْتُ إِلَى  جَابِرِ بْنِ سَمُرَةَ ، مَعَ غُلَامِي  نَافِعٍ  : أَخْبِرْنِي بِشَيْءٍ سَمِعْتَهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَكَتَبَ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ جُمُعَةٍ عَشِيَّةَ رَجْمِ  الْأَسْلَمِيِّ  يَقُولُ :  لَا         [13/457]      يَزَالُ الدِّينُ قَائِمًا حَتَّى تَقُومَ السَّاعَةُ  ، وَيَكُونَ عَلَيْكُمُ اثْنَا عَشَرَ  خَلِيفَةً  ، كُلُّهُمْ مِنْ  قُرَيْشٍ  .  وَسَمِعْتُهُ يَقُولُ : عُصْبَةٌ مِنَ الْمُسْلِمِينَ يَفْتَتِحُونَ الْبَيْتَ الْأَبْيَضَ ، بَيْتَ  كِسْرَى  وَآلِ كِسْرَى  .","","Musnad Abi Ya'la al-Mawsili 7463","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7470","25 - (  7465  ) -  وَسَمِعْتُهُ  يَقُولُ :  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ ، فَاحْذَرُوهُمْ  .","","Musnad Abi Ya'la al-Mawsili 7465","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7471","26 - (  7466  ) -  وَسَمِعْتُهُ  يَقُولُ :  إِذَا أَعْطَى اللهُ أَحَدَكُمْ خَيْرًا ، فَلْيَبْدَأْ بِنَفْسِهِ وَأَهْلِ بَيْتِهِ  .","","Musnad Abi Ya'la al-Mawsili 7466","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7472","27 - (  7467  ) -  وَسَمِعْتُهُ  يَقُولُ :  أَنَا  فَرَطُكُمْ  عَلَى الْحَوْضِ  .         [13/458]","","Musnad Abi Ya'la al-Mawsili 7467","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7473","28 - (  7468  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  زَكَرِيَّا بْنِ سِيَاهٍ ،  عَنْ  عِمْرَانَ بْنِ رِيَاحٍ ،  عَنْ  عَلِيِّ بْنِ عُمَارَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  كُنْتُ فِي مَجْلِسٍ فِيهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَبِي  سَمُرَةُ  جَالِسٌ أَمَامِي ، فَقَالَ :  إِنَّ  الْفُحْشَ  وَالتَّفَحُّشَ لَيْسَا مِنَ الْإِسْلَامِ فِي شَيْءٍ  ، وَإِنَّ مِنْ أَحْسَنِ النَّاسِ إِسْلَامًا أَحْسَنُهُمْ  خُلُقًا  .         [13/459]","","Musnad Abi Ya'la al-Mawsili 7468","","جابر بن سمرة السوائي عن علي بن عمارة عن عمران بن مسلم بن رياح الثقفي عن زكريا بن سياه الثقفي عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7474","29 - (  7469  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  حَدَّثَنَا  أَبُو دَاوُدَ قَالَ :  حَدَّثَنِي  سُلَيْمَانُ بْنُ مُعَاذٍ ،  حَدَّثَنَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ  بِمَكَّةَ  حَجَرًا كَانَ يُسَلِّمُ عَلَيَّ لَيَالِيَ بُعِثْتُ ، وَإِنِّي لَأَعْرِفُهُ إِذَا مَرَرْتُ عَلَيْهِ  .         [13/460]","","Musnad Abi Ya'la al-Mawsili 7469","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سليمان بن قرم الضبي عن أبو داود الطيالسي عن أحمد بن إبراهيم بن كثير عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7475","30 - (  7470  ) -  حَدَّثَنَا  عَامِرُ بْنُ عَبْدِ اللهِ بْنِ بَرَّادٍ  ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ السُّوَائِيِّ - سَوْءَةِ  قَيْسٍ  - قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  ثَلَاثٌ أَخَافُ عَلَى أُمَّتِي : اسْتِسْقَاءٌ بِالْأَنْوَاءِ ، وَحَيْفُ السُّلْطَانِ ، وَتَكْذِيبٌ بِالْقَدَرِ  .  كذا في طبعة دار المأمون للتراث ونسخة السليمانية والمقصد العلي ، ولعل الصواب : (أبو عامر عبد الله بن براد) والله أعلم .","","Musnad Abi Ya'la al-Mawsili 7470","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن فطر بن خليفة عن محمد بن القاسم الأسدي عن عبد الله بن براد بن يوسف بن أبي بردة بن أبي موسى عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7476","31 - (  7471  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجَمَ  يَهُودِيًّا  وَيَهُودِيَّةً  .","","Musnad Abi Ya'la al-Mawsili 7471","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7477","32 - (  7472  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمٍ الطَّائِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمَسْجِدَ ، فَرَأَى نَاسًا رَافِعِي أَيْدِيهِمْ ، فَقَالَ :  مَا لَهُمْ رَافِعِي أَيْدِيهِمْ كَأَنَّهَا أَذْنَابُ الْخَيْلِ الشُّمْسِ ؟ اسْكُنُوا فِي الصَّلَاةِ  .         [13/461]             [13/462]","","Musnad Abi Ya'la al-Mawsili 7472","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7478","33 - (  7473  ) -  وَعَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمَسْجِدَ ، فَرَأَى نَاسًا يُصَلُّونَ رَافِعِي رُؤُوسِهِمْ إِلَى السَّمَاءِ ، فَقَالَ :  لَيَنْتَهِيَنَّ رِجَالٌ يَشْخَصُونَ بِأَبْصَارِهِمْ إِلَى السَّمَاءِ ، أَوْ لَا تَرْجِعُ إِلَيْهِمْ  .         [13/463]","","Musnad Abi Ya'la al-Mawsili 7473","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7479","34 - (  7474  ) -  وَعَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمَسْجِدَ ، فَقَالَ :  أَلَا تَصُفُّونَ كَمَا تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ ؟ قَالُوا : يَا رَسُولَ اللهِ ! وَكَيْفَ تَصُفُّ عِنْدَ رَبِّهِمْ ؟ قَالَ : يُتِمُّونَ الصُّفُوفَ الْأُوَلَ  ، وَيَتَرَاصُّونَ فِي الصَّفِّ قَالَ : وَخَرَجَ إِلَى الْمَسْجِدِ وَهُمْ فِي الْمَسْجِدِ حِلَقٌ ، فَقَالَ : مَا لِي أَرَاهُمْ  عِزِينَ  ؟ .","","Musnad Abi Ya'la al-Mawsili 7474","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن جرير بن عبد الحميد عن إسحاق ابن راهويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7480","35 - (  7475  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ  :  رَأَيْتُ خَاتَمَ النُّبُوَّةِ بَيْنَ كَتِفَيِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَأَنَّهُ بَيْضَةُ حَمَامَةٍ  .","","Musnad Abi Ya'la al-Mawsili 7475","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق ابن راهويه عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7481","36 - (  7476  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ قَالَ :         [13/464]      سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ ، قَالَ  سِمَاكٌ  : قَالَ لِي أَبِي : فَاحْذَرُوهُمْ  .","","Musnad Abi Ya'la al-Mawsili 7476","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7482","37 - (  7477  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  حَدَّثَنَا  الْمُحَارِبِيُّ ،  حَدَّثَنَا  أَشْعَثُ بْنُ سَوَّارٍ ،  يَذْكُرُ عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي لَيْلَةٍ إِضْحِيَانَ وَعَلَيْهِ  حُلَّةٌ  حَمْرَاءُ ،  فَكُنْتُ أَنْظُرُ إِلَيْهِ وَإِلَى الْقَمَرِ ، فَهُوَ كَانَ فِي عَيْنِي أَزْيَنَ مِنَ الْقَمَرِ  .         [13/465]","","Musnad Abi Ya'la al-Mawsili 7477","","جابر بن سمرة السوائي عن أبو إسحاق السبيعي عن أشعث بن سوار عن عبد الرحمن بن محمد المحاربي عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7483","38 - (  7478  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ قَالَ :  حَدَّثَنِي  أَبِي ،  حَدَّثَنَا  زِيَادُ بْنُ خَيْثَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنِّي  فَرَطُكُمْ  عَلَى الْحَوْضِ  ، وَإِنَّ بُعْدَ مَا بَيْنَ طَرَفَيْهِ كَمَا بَيْنَ  صَنْعَاءَ  وَأَيْلَةَ  ، كَأَنَّ الْأَبَارِيقَ مِثْلُ النُّجُومِ  .","","Musnad Abi Ya'la al-Mawsili 7478","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زياد بن خيثمة الجعفي عن شجاع بن الوليد السكوني عن الوليد بن شجاع عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7484","39 - (  7479  ) -  حَدَّثَنَا  أَبُو طَالِبٍ عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ قَالَ :  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عَمْرٍو الرَّقِّيُّ أَبُو وَهْبٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ  أَنَّ  رَجُلًا  سَأَلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُصَلِّي فِي الثَّوْبِ الَّذِي آتِي فِيهِ أَهْلِي ؟ قَالَ : نَعَمْ إِلَّا أَنْ تَرَى فِيهِ شَيْئًا فَتَغْسِلَهُ  .","","Musnad Abi Ya'la al-Mawsili 7479","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن عبيد الله بن عمرو بن أبي الوليد عن عبد الجبار بن عاصم الخراساني عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7485","40 - (  7480  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  عَنْ  سُلَيْمَانَ قَالَ :  حَدَّثَنِي  الْمُسَيِّبُ بْنُ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ الطَّائِيِّ ،         [13/466]      عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمَسْجِدَ ، وَقَدْ رَفَعُوا أَيْدِيَهُمْ ، فَقَالَ :  قَدْ رَفَعُوا أَيْدِيَهُمْ كَأَنَّهَا أَذْنَابُ خَيْلٍ  شُمْسٍ  ، اسْكُنُوا فِي الصَّلَاةِ  .","","Musnad Abi Ya'la al-Mawsili 7480","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن يحيى القطان عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7486","41 - (  7481  ) -  وَعَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا تَصُفُّونَ كَمَا تَصُفُّ الْمَلَائِكَةُ الَّذِينَ عِنْدَ رَبِّهِمْ ؟  قَالَ : كَيْفَ الْمَلَائِكَةُ الَّذِينَ عِنْدَ رَبِّهِمْ ؟ قَالَ : يُتِمُّونَ الصُّفُوفَ الْأُوَلَ ، وَيَتَرَاصُّونَ فِي الصَّفِّ  .","","Musnad Abi Ya'la al-Mawsili 7481","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن يحيى القطان عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7487","42 - (  7482  ) -  وَعَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُمْ حِلَقٌ فِي الْمَسْجِدِ ، فَقَالَ : مَا لِي أَرَاكُمْ  عِزِينَ  .","","Musnad Abi Ya'la al-Mawsili 7482","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن يحيى القطان عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","حديث جابر بن سمرة السوائي عن النبي صلى الله عليه وسلم"
"7488","[13/467]      حَدِيثُ  وَاثِلَةَ بْنِ الْأَسْقَعِ  1 - (  7483  ) -  حَدَّثَنَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ السَّمَّانُ ،  حَدَّثَنَا  عَنْبَسَةُ ،  حَدَّثَنَا  حَمَّادٌ مَوْلَى أُمَيَّةَ ،  عَنْ  جَنَاحٍ مَوْلَى الْوَلِيدِ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  خَيْرُ شَبَابِكُمْ مَنْ تَشَبَّهَ بِكُهُولِكُمْ ، وَشَرُّ كُهُولِكُمْ مَنْ تَشَبَّهَ بِشَبَابِكُمْ  "" .         [13/468]","","Musnad Abi Ya'la al-Mawsili 7483","","واثلة بن الأسقع الليثي عن جناح الشامي عن حماد مولى بني أمية عن عنبسة بن سعيد الواسطي عن سعيد بن أبى الربيع السمان عن أبو يعلى الموصلي","حديث واثلة بن الأسقع"
"7489","2 - (  7484  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ أَبِي عَبْلَةَ ،  حَدَّثَنَا  الْغَرِيفُ بْنُ عَيَّاشِ بْنِ فَيْرُوزَ الدَّيْلَمِيُّ ،         [13/469]      عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  إِنَّ نَاسًا مِنْ  بَنِي سُلَيْمٍ  أَتَوُا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالُوا :  إِنَّ صَاحِبًا لَنَا قَدْ  أَوْجَبَ  قَالَ :  فَلْيُعْتِقْ  رَقَبَةً ، يَفُكُّ اللهُ بِكُلِّ عُضْوٍ مِنْهَا عُضْوًا مِنْهُ مِنَ النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 7484","","واثلة بن الأسقع الليثي عن الغريف بن عياش بن فيروز الديلمي عن إبراهيم بن أبي عبلة عن عبد الله بن المبارك عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","حديث واثلة بن الأسقع"
"7490","3 - (  7485  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ سَهْمٍ الْأَنْطَاكِيُّ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَمْرٍو الْأَوْزَاعِيِّ ،  عَنْ  أَبِي عَمَّارٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ اللهَ اصْطَفَى  كِنَانَةَ  مِنْ  وَلَدِ إِسْمَاعِيلَ  ، وَاصْطَفَى مِنْ  كِنَانَةَ  قُرَيْشًا  ، وَاصْطَفَى مِنْ  قُرَيْشٍ  بَنِي هَاشِمٍ  ، وَاصْطَفَانِي مِنْ  بَنِي         [13/470]      هَاشِمٍ  .","","Musnad Abi Ya'la al-Mawsili 7485","","واثلة بن الأسقع الليثي عن شداد بن عبد الله العذري عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن محمد بن عبد الرحمن بن حكيم الأنطاكي عن أبو يعلى الموصلي","حديث واثلة بن الأسقع"
"7491","4 - (  7486  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ الْبَصْرِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مُصْعَبٍ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  أَبِي عَمَّارٍ شَدَّادٍ ،         [13/471]      عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  أَقَعَدَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَلِيًّا  عَنْ يَمِينِهِ ،  وَفَاطِمَةَ  عَنْ يَسَارِهِ ،  وَحَسَنًا  وَحُسَيْنًا  بَيْنَ يَدَيْهِ ، وَغَطَّى عَلَيْهِمْ بِثَوْبٍ ، وَقَالَ :  اللَّهُمَّ هَؤُلَاءِ أَهْلُ بَيْتِي  ، وَأَهْلُ بَيْتِي أَتَوْا إِلَيْكَ لَا إِلَى النَّارِ  .         [13/472]","","Musnad Abi Ya'la al-Mawsili 7486","","واثلة بن الأسقع الليثي عن شداد بن عبد الله العذري عن أبو عمرو الأوزاعي عن محمد بن مصعب القرقساني عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","حديث واثلة بن الأسقع"
"7492","5 - (  7487  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ يُوسُفَ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  أَبِي عَمَّارٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ اصْطَفَى  بَنِي كِنَانَةَ  مِنْ  بَنِي إِسْمَاعِيلَ  ، وَاصْطَفَى مِنْ  بَنِي كِنَانَةَ  قُرَيْشًا  ، وَاصْطَفَى مِنْ  قُرَيْشٍ  بَنِي هَاشِمٍ  ، وَاصْطَفَانِي مِنْ  بَنِي هَاشِمٍ  .         [13/473]","","Musnad Abi Ya'la al-Mawsili 7487","","واثلة بن الأسقع الليثي عن شداد بن عبد الله العذري عن أبو عمرو الأوزاعي عن يزيد بن يوسف الرحبي عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","حديث واثلة بن الأسقع"
"7493","6 - (  7488  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى التُّسْتَرِيُّ ،  حَدَّثَنَا  بِشْرُ بْنُ بَكْرٍ ،  عَنِ  الْأَوْزَاعِيِّ قَالَ :  حَدَّثَنِي  رَبِيعَةُ قَالَ :  سَمِعْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  تَزْعُمُونَ أَنِّي مِنْ آخِرِكُمْ وَفَاةً  ، أَلَا وَإِنِّي مِنْ أَوَّلِكُمْ وَفَاةً ، وَتَتْبَعُونِي  أَفْنَادًا  يُهْلِكُ بَعْضُكُمْ بَعْضًا  .","","Musnad Abi Ya'la al-Mawsili 7488","","واثلة بن الأسقع الليثي عن ربيعة بن يزيد القصير عن أبو عمرو الأوزاعي عن بشر بن بكر التنيسي عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","حديث واثلة بن الأسقع"
"7494","7 - (  7489  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  حَدَّثَنَا  أَبُو يَحْيَى الْكُوفِيُّ ،  عَنْ  أَبِي سَعِيدٍ الشَّامِيِّ ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  عُدَّ الْآيَ         [13/474]      فِي التَّطَوُّعِ ، وَلَا تَعُدَّهُ فِي الْفَرِيضَةِ  .         [13/475]","","Musnad Abi Ya'la al-Mawsili 7489","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن أبو سعيد الشامي عن عبد الحميد بن عبد الرحمن بشمين عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","حديث واثلة بن الأسقع"
"7495","8 - (  7490  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ الْبَصْرِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  رَبِيعَةَ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [13/476]      فَقَالَ :  تَزْعُمُونَ أَنِّي مِنْ آخِرِكُمْ وَفَاةً  ، أَلَا وَإِنِّي مِنْ أَوَّلِكُمْ وَفَاةً ، وَلَتَتْبَعُنِّي  أَفْنَادًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .","","Musnad Abi Ya'la al-Mawsili 7490","","واثلة بن الأسقع الليثي عن ربيعة بن يزيد القصير عن أبو عمرو الأوزاعي عن محمد بن كثير بن أبي عطاء عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","حديث واثلة بن الأسقع"
"7496","9 - (  7491  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ قَالَ :  حَدَّثَنِي  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ الرَّحْمَنِ الْقُرَشِيِّ قَالَ :  حَدَّثَنِي  عَنْبَسَةُ بْنُ سَعِيدٍ الْقُرَشِيُّ  ،  عَنْ  مَكْحُولٍ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  سِحَاقُ النِّسَاءِ بَيْنَهُنَّ زِنًى  "" .  كذا في طبعة دار المأمون للتراث ، ولعل الصواب أن القرشي سبق نظر .","","Musnad Abi Ya'la al-Mawsili 7491","","واثلة بن الأسقع الليثي عن مكحول بن أبي مسلم عن عنبسة بن سعيد بن الضريس عن عثمان بن عبد الرحمن الطرائفي عن بقية بن الوليد عن الوليد بن شجاع عن أبو يعلى الموصلي","حديث واثلة بن الأسقع"
"7497","10 - (  7492  ) -  حَدَّثَنَا  أَبُو الْأَشْعَثِ أَحْمَدُ بْنُ الْمِقْدَامِ الْعِجْلِيُّ ،  حَدَّثَنَا  عُبَيْدُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  الْعَلَاءُ بْنُ ثَعْلَبَةَ ،  عَنْ  أَبِي الْمَلِيحِ الْهُذَلِيِّ ،  عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ قَالَ :  تَدَانَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَسْجِدِ         [13/477]      الْخَيْفِ  فَقَالَ لِي أَصْحَابُهُ : إِلَيْكَ يَا  وَاثِلَةُ  ،  أَيْ تَنَحَّ عَنْ وَجْهِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" دَعُوهُ إِنَّمَا جَاءَ يَسْأَلُ . قَالَ : فَدَنَوْتُ ، فَقُلْتُ : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ ! لِتُفْتِنَا عَنْ أَمْرٍ نَأْخُذُهُ عَنْكَ مِنْ بَعْدِكَ . قَالَ : لِتُفْتِكَ نَفْسُكَ . قَالَ : قُلْتُ : وَكَيْفَ لِي بِذَلِكَ ؟ قَالَ :  دَعْ مَا  يَرِيبُكَ  إِلَى مَا لَا  يَرِيبُكَ  ، وَإِنْ أَفْتَاكَ الْمُفْتُونَ ، قُلْتُ : وَكَيْفَ لِي بِعِلْمِ ذَلِكَ ؟ قَالَ : تَضَعُ يَدَكَ عَلَى فُؤَادِكَ ، فَإِنَّ الْقَلْبَ يَسْكُنُ لِلْحَلَالِ ، وَلَا يَسْكُنُ لِلْحَرَامِ ، وَإِنَّ الْوَرِعَ الْمُسْلِمَ يَدَعُ الصَّغِيرَ مَخَافَةَ أَنْ يَقَعَ فِي الْكَبِيرِ ، قُلْتُ : بِأَبِي أَنْتَ وَأُمِّي ، مَا الْعَصَبِيَّةُ ؟ قَالَ : الَّذِي يُعِينُ قَوْمَهُ عَلَى الظُّلْمِ ، قُلْتُ : فَمَنِ الْحَرِيصُ ؟ قَالَ : الَّذِي يَطْلُبُ الْمَكْسَبَةَ مِنْ غَيْرِ حِلِّهَا ، قُلْتُ : فَمَنِ الْوَرِعُ ؟ قَالَ : الَّذِي يَقِفُ عِنْدَ الشُّبْهَةِ .  قُلْتُ : فَمَنِ الْمُؤْمِنُ ؟ قَالَ : مَنْ أَمِنَهُ النَّاسُ عَلَى أَمْوَالِهِمْ وَدِمَائِهِمْ .         [13/478]      قُلْتُ : فَمَنِ الْمُسْلِمُ ؟ قَالَ : مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ ، قُلْتُ : فَأَيُّ  الْجِهَادِ  أَفْضَلُ ؟ قَالَ : كَلِمَةُ حُكْمٍ عِنْدَ إِمَامٍ جَائِرٍ  .","","Musnad Abi Ya'la al-Mawsili 7492","","واثلة بن الأسقع الليثي عن أبو المليح بن أسامة الهذلي عن العلاء بن ثعلبة عن عبيد بن القاسم الأسدي عن أحمد بن المقدام العجلي عن أبو يعلى الموصلي","حديث واثلة بن الأسقع"
"7498","[13/479]             [13/480]      حَدِيثُ  عَبْدِ اللهِ بْنِ سَلَامٍ  1 - (  7493  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  عَمْرُو بْنُ عُثْمَانَ         [13/481]      الْكِلَابِيُّ ،  حَدَّثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  مَعْمَرِ بْنِ رَاشِدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ أَبِي يَعْقُوبَ ،  عَنْ  بِشْرِ بْنِ شَغَافٍ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أَنَا  سَيِّدُ  وَلَدِ آدَمَ يَوْمَ الْقِيَامَةِ وَلَا  فَخْرَ  ، وَأَوَّلُ مَنْ تَنْشَقُّ عَنْهُ الْأَرْضُ ، وَأَوَّلُ شَافِعٍ وَمُشَفَّعٍ ، بِيَدِي  لِوَاءُ  الْحَمْدِ  ، تَحْتِي  آدَمُ  فَمَنْ دُونَهُ  .","","Musnad Abi Ya'la al-Mawsili 7493","","عبد الله بن سلام بن الحارث الإسرائيلي عن بشر بن شغاف الضبي عن محمد بن عبد الله بن أبي يعقوب عن معمر بن راشد عن موسى بن أعين الجزري عن عمرو بن عثمان بن سيار الرقي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","حديث عبد الله بن سلام"
"7499","2 - (  7494  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  عَبْدُ الْغَفَّارِ بْنُ الْحَكَمِ الْحَرَّانِيُّ ، قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ الْعَلَاءِ الْمَدِينِيُّ وَهُوَ         [13/482]      الَّذِي يُقَالُ لَهُ : الرَّازِيُّ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي يَحْيَى الْأَسْلَمِيِّ ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَخَذَ كِسْرَةً مِنْ خُبْزِ شَعِيرٍ  ، ثُمَّ أَخَذَ تَمْرَةً ، فَوَضَعَهَا عَلَيْهَا ، ثُمَّ قَالَ : هَذِهِ إِدَامُ هَذِهِ  .","","Musnad Abi Ya'la al-Mawsili 7494","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن محمد بن أبي يحيى الأسلمي عن يحيى بن العلاء الفوراردي عن عبد الغفار بن الحكم الحراني عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","حديث عبد الله بن سلام"
"7500","3 - (  7495  ) -  حَدَّثَنَا  أَبُو يَاسِرٍ عَمَّارٌ ،  حَدَّثَنَا  هِشَامٌ أَبُو الْمِقْدَامِ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْحَرْبُ  خَدْعَةٌ  "" .         [13/483]","","Musnad Abi Ya'la al-Mawsili 7495","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن والد هشام بن زياد بن أبي يزيد العثماني عن هشام بن زياد بن أبي يزيد العثماني عن عمار بن هارون المستملي عن أبو يعلى الموصلي","حديث عبد الله بن سلام"
"7501","4 - (  7496  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ حَمْزَةَ بْنِ يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَدِّهِ قَالَ :  أَسْلَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِرَجُلٍ مِنَ الْيَهُودِ  دَنَانِيرَ فِي تَمْرٍ مُسَمًّى إِلَى أَجَلٍ مُسَمًّى ، فَقَالَ الْيَهُودِيُّ : مِنْ تَمْرِ حَائِطِ بَنِي فُلَانٍ ؟ قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَمَّا مِنْ تَمْرِ حَائِطِ بَنِي فُلَانٍ ، فَلَا  "" .         [13/484]","","Musnad Abi Ya'la al-Mawsili 7496","","يوسف بن عبد الله بن سلام الإسرائيلي عن حمزة بن يوسف بن عبد الله بن سلام عن محمد بن حمزة الإسرائيلي عن الوليد بن مسلم القرشي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","حديث عبد الله بن سلام"
"7502","5 - (  7497  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  عَنِ  الْأَوْزَاعِيِّ قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ قَالَ :  حَدَّثَنِي  هِلَالٌ أَنَّ عَطَاءَ بْنَ يَسَارٍ  حَدَّثَهُ  أَنَّ عَبْدَ اللهِ بْنَ سَلَامٍ  حَدَّثَهُ  ، أَوْ قَالَ :  حَدَّثَنِي  أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ ، قَالَ :  تَذَاكَرْنَا بَيْنَنَا ، فَقُلْنَا : أَيُّكُمْ يَأْتِي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَسْأَلُهُ  : أَيُّ الْأَعْمَالِ أَحَبُّ إِلَى اللهِ - عَزَّ وَجَلَّ - ، فَهِبْنَا أَنْ يَقُومَ مِنَّا أَحَدٌ ، فَأَرْسَلَ إِلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجُلًا رَجُلًا ، حَتَّى جَمَعَنَا ، فَجِئْنَا يُشِيرُ بَعْضُنَا إِلَى بَعْضٍ ، فَقَرَأَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُورَةَ         {      سَبَّحَ لِلهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ             *          يَا أَيُّهَا الَّذِينَ آمَنُوا لِمَ تَقُولُونَ مَا لا تَفْعَلُونَ         }      فَتَلَاهُنَّ مِنْ أَوَّلِهَا إِلَى آخِرِهَا . قَالَ : فَتَلَاهَا عَلَيْنَا  عَبْدُ اللهِ بْنُ سَلَامٍ  مِنْ أَوَّلِهَا إِلَى آخِرِهَا قَالَ : فَتَلَاهَا عَلَيْنَا  عَطَاءٌ  مِنْ أَوَّلِهَا إِلَى آخِرِهَا ، قَالَ  يَحْيَى  : فَتَلَاهَا عَلَيْنَا  هِلَالٌ  مِنْ أَوَّلِهَا إِلَى آخِرِهَا ، قَالَ  الْأَوْزَاعِيُّ  : فَتَلَاهَا عَلَيْنَا  يَحْيَى  مِنْ أَوَّلِهَا إِلَى آخِرِهَا  .         [13/485]             [13/486]","","Musnad Abi Ya'la al-Mawsili 7497","","عبد الله بن سلام بن الحارث الإسرائيلي عن عطاء بن يسار الهلالي عن هلال بن علي بن أسامة عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن عبد الله بن المبارك عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","حديث عبد الله بن سلام"
"7503","6 - (  7498  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ يَعْلَى الْأَسْلَمِيُّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ أَخِي عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ قَالَ :  كَانَ اسْمِي فِي الْجَاهِلِيَّةِ فُلَانٌ ، سَمَّانِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَبْدَ اللهِ  .         [13/487]","","Musnad Abi Ya'la al-Mawsili 7498","","عبد الله بن سلام بن الحارث الإسرائيلي عن ابن أخي عبد الله بن سلام عن عبد الملك بن عمير القبطي عن يحيى بن يعلى القطواني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث عبد الله بن سلام"
"7504","7 - (  7499  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ قَالَ :  ذَكَرْنَا أَحَبَّ الْأَعْمَالِ إِلَى اللهِ ، فَقُلْنَا : مَنْ يَسْأَلُ لَنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ؟ فَهِبْنَاهُ أَنْ نَسْأَلَهُ ، فَيُفْرِدَنَا رَجُلًا رَجُلًا حَتَّى اجْتَمَعْنَا عِنْدَهُ ، سَارَ بَعْضُنَا إِلَى بَعْضٍ ، فَلَمْ نَدْرِ ، ثُمَّ أَرْسَلَ إِلَيْنَا ، فَقَرَأَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَذِهِ السُّورَةَ :         {      سَبَّحَ لِلهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الأَرْضِ         }      إِلَى قَوْلِهِ :         {      بُنْيَانٌ مَرْصُوصٌ         }      ، قَالَ  ابْنُ سَلَامٍ  : فَقَرَأَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - السُّورَةَ كُلَّهَا مِنْ أَوَّلِهَا إِلَى آخِرِهَا ، قَالَ  أَبُو سَلَمَةَ  : وَقَرَأَ عَلَيْنَا  عَبْدُ اللهِ بْنُ سَلَامٍ  السُّورَةَ مِنْ أَوَّلِهَا إِلَى آخِرِهَا  .         [13/488]","","Musnad Abi Ya'la al-Mawsili 7499","","عبد الله بن سلام بن الحارث الإسرائيلي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن يحيى بن حمزة بن البتلهي عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","حديث عبد الله بن سلام"
"7505","8 - (  7500  ) -  حَدَّثَنَا  عَمَّارٌ أَبُو يَاسِرٍ ،  حَدَّثَنَا  هِشَامُ بْنُ زِيَادٍ أَبُو الْمِقْدَامِ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  اللَّهُمَّ بَارِكْ لِأُمَّتِي فِي بُكُورِهَا  "" .","","Musnad Abi Ya'la al-Mawsili 7500","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن زياد القرشي مولى عثمان بن عفان عن هشام بن زياد بن أبي يزيد العثماني عن عمار بن هارون المستملي عن أبو يعلى الموصلي","حديث عبد الله بن سلام"
"7506","9 - (  7501  ) -  حَدَّثَنَا  أَبُو يَاسِرٍ عَمَّارٌ ،  حَدَّثَنَا  أَبُو الْمِقْدَامِ هِشَامُ بْنُ زِيَادٍ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ  ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْحَيَاءُ  مِنَ الْإِيمَانِ  "" .","","Musnad Abi Ya'la al-Mawsili 7501","","عبد الله بن سلام بن الحارث الإسرائيلي عن يوسف بن عبد الله بن سلام الإسرائيلي عن زياد القرشي مولى عثمان بن عفان عن هشام بن زياد بن أبي يزيد العثماني عن عمار بن هارون المستملي عن أبو يعلى الموصلي","حديث عبد الله بن سلام"
"7507","[13/489]      حَدِيثُ  جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ  1 - (  7502  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  مُعَاوِيَةُ ،  عَنْ  شَيْبَانَ ،  عَنْ  جَابِرٍ ،  عَنْ  عَامِرٍ ،  عَنْ  جَرِيرٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ  : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَإِقَامِ الصَّلَاةِ ،         [13/490]      وَإِيتَاءِ الزَّكَاةِ ، وَحَجِّ الْبَيْتِ ، وَصِيَامِ رَمَضَانَ  "" .","","Musnad Abi Ya'la al-Mawsili 7502","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","حديث جرير بن عبد الله البجلي"
"7508","2 - (  7503  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  حَدَّثَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ قَالَ :  قَالَ  جَرِيرٌ :  بَايَعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى السَّمْعِ وَالطَّاعَةِ ، وَعَلَى أَنْ أَنْصَحَ لِكُلِّ مُسْلِمٍ         [13/491]      قَالَ : فَكَانَ إِذَا اشْتَرَى الشَّيْءَ - كَانَ أَعْجَبَ إِلَيَّ مِنْ ثَمَنِهِ - قَالَ لِصَاحِبِهِ :  وَاللهِ لَمَا نَأْخُذُ مِنْكَ أَحَبُّ إِلَيْنَا مِمَّا نُعْطِيكَ  . قَالَ : يُرِيدُ الْوَفَاءَ بِذَلِكَ  .         [13/492]","","Musnad Abi Ya'la al-Mawsili 7503","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو زرعة بن عمرو بن جرير الغلابي عن عمرو بن سعيد الخولاني عن يونس بن عبيد عن إسماعيل ابن علية عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","حديث جرير بن عبد الله البجلي"
"7509","3 - (  7504  ) -  حَدَّثَنَا  مَخْلَدُ بْنُ أَبِي زُمَيْلٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي إِسْحَاقَ السَّبِيعِيِّ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  صِيَامُ ثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ صِيَامُ الدَّهْرِ  ، أَيَّامُ  الْبِيضِ  : صَبِيحَةُ ثَلَاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ  .         [13/493]","","Musnad Abi Ya'la al-Mawsili 7504","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو إسحاق السبيعي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن مخلد بن الحسن بن أبي زميل الحراني عن أبو يعلى الموصلي","حديث جرير بن عبد الله البجلي"
"7510","4 - (  7505  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى التُّسْتَرِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ قَالَ :  حَدَّثَنِي  ابْنُ لَهِيعَةَ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،         [13/494]      عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا بَعَثَ سَرِيَّةً قَالَ : بِاسْمِ اللهِ ، وَفِي  سَبِيلِ  اللهِ  ، وَعَلَى مِلَّةِ رَسُولِ اللهِ ، لَا تَغُلُّوا ، وَلَا تَغْدِرُوا ، وَلَا تُمَثِّلُوا ، وَلَا تَقْتُلُوا الْوِلْدَانَ  .         [13/495]","","Musnad Abi Ya'la al-Mawsili 7505","","جرير بن عبد الله بن جابر يوسف الأمة عن شقيق بن سلمة عن سلمة بن كهيل الحضرمي عن عبد ربه بن سعيد النجاري عن عبد الله بن لهيعة عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أبو يعلى الموصلي","حديث جرير بن عبد الله البجلي"
"7511","5 - (  7506  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  جَابِرٍ ،  عَنْ  طَارِقٍ التَّمِيمِيِّ ،  عَنْ  جَرِيرٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ عَلَى نِسْوَةٍ ، فَسَلَّمَ عَلَيْهِنَّ  .         [13/496]","","Musnad Abi Ya'la al-Mawsili 7506","","جرير بن عبد الله بن جابر يوسف الأمة عن طارق التميمي عن جابر الجعفي عن شعبة بن الحجاج عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جرير بن عبد الله البجلي"
"7512","6 - (  7507  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  حَدَّثَنَا  دَاوُدُ الْأَعْرَجُ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  بُنِيَ الْإِسْلَامُ عَلَى خَمْسٍ  : شَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَإِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَحَجِّ الْبَيْتِ ، وَصَوْمِ رَمَضَانَ  "" .         [13/497]","","Musnad Abi Ya'la al-Mawsili 7507","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن داود بن يزيد الزعافري عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث جرير بن عبد الله البجلي"
"7513","7 - (  7508  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ جَرِيرٍ الْبَجَلِيِّ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَا مِنْ قَوْمٍ يَكُونُ بَيْنَ  ظَهْرَانَيْهِمْ  رَجُلٌ يَعْمَلُ بِالْمَعَاصِي - هُمْ أَمْنَعُ مِنْهُ وَأَعَزُّ - لَا يُغَيِّرُونَ عَلَيْهِ إِلَّا أَصَابَهُمُ اللهُ بِعِقَابِهِ  "" .         [13/498]","","Musnad Abi Ya'la al-Mawsili 7508","","جرير بن عبد الله بن جابر يوسف الأمة عن عبيد الله بن جرير بن عبد الله البجلي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث جرير بن عبد الله البجلي"
"7514","8 - (  7509  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ قَالَ :  سَمِعْتُ  جَرِيرَ بْنَ عَبْدِ اللهِ - حِينَ مَاتَ  الْمُغِيرَةُ بْنُ شُعْبَةَ  ، وَاسْتُعْمِلَ ، فَرَأَيْتُ  جَرِيرًا  يَخْطُبُ - فَقَالَ :  أُوصِيكُمْ بِتَقْوَى اللهِ وَحْدَهُ لَا شَرِيكَ لَهُ  ، وَأَنْ تَسْمَعُوا وَتُطِيعُوا حَتَّى يَأْتِيَكُمْ أَمِيرٌ قَالَ : ثُمَّ ذَكَرَ  الْمُغِيرَةَ  ، فَقَالَ : اسْتَغْفِرُوا لَهُ ، عَفَا اللهُ عَنْهُ ، فَإِنَّهُ كَانَ يُحِبُّ الْعَافِيَةَ ، ثُمَّ قَالَ : أَمَّا بَعْدُ ، فَإِنِّي بَايَعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْإِسْلَامِ ، وَاشْتَرَطَ عَلَيَّ النُّصْحَ لِكُلِّ مُسْلِمٍ ، فَوَرَبِّ هَذَا الْمَسْجِدِ إِنِّي لَكُمْ لَنَاصِحٌ  .","","Musnad Abi Ya'la al-Mawsili 7509","","جرير بن عبد الله بن جابر يوسف الأمة عن زياد بن علاقة الثعلبي عن شعبة بن الحجاج عن غندر ربيب شعبة عن محمد بن بشار بندار عن أبو يعلى الموصلي","حديث جرير بن عبد الله البجلي"
"7515","[13/499]      حَدِيثُ  سَهْلِ بْنِ سَعْدٍ السَّاعِدِيِّ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  1 - (  7510  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ، وَعَمْرٌو النَّاقِدُ ، قَالَا :  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  سَمِعَهُ مِنْ  سَهْلِ بْنِ سَعْدٍ قَالَ :  اطَّلَعَ  رَجُلٌ  مِنْ جُحْرٍ         [13/500]      فِي حُجْرَةِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَعَهُ  مِدْرًى  يَحُكُّ بِهِ رَأْسَهُ ، فَقَالَ :  لَوْ أَعْلَمُ أَنَّكَ تَنْظُرُ ، لَطَعَنْتُ بِهِ فِي عَيْنِكَ  ، إِنَّمَا جُعِلَ الِاسْتِئْذَانُ مِنْ أَجْلِ الْبَصَرِ  "" .         [13/501]","","Musnad Abi Ya'la al-Mawsili 7510","","سهل بن سعد الساعدي عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7516","2 - (  7511  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا يَزَالُ النَّاسُ بِخَيْرٍ مَا عَجَّلُوا الْفِطْرَ  .         [13/502]","","Musnad Abi Ya'la al-Mawsili 7511","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7517","3 - (  7512  ) -  وَعَنْ  سَهْلِ بْنِ سَعْدٍ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  يَدْخُلُ الْجَنَّةَ مِنْ أُمَّتِي  سَبْعُونَ أَلْفًا أَوْ سَبْعُمِائَةِ أَلْفٍ  ، قَالَ  أَبُو حَازِمٍ  : لَا أَدْرِي قَالَ :  مُتَمَاسِكِينَ ، أَوْ : آخِذِينَ بَعْضُهُمْ         [13/503]      بِبَعْضٍ  .","","Musnad Abi Ya'la al-Mawsili 7512","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7518","4 - (  7513  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي حَازِمٍ ،  سَمِعَ  سَهْلَ بْنَ سَعْدٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ نَابَهُ شَيْءٌ فِي صَلَاتِهِ ، فَإِنَّ التَّصْفِيقَ لِلنِّسَاءِ  ، وَالتَّسْبِيحَ لِلرِّجَالِ  .         [13/504]             [13/505]             [13/506]","","Musnad Abi Ya'la al-Mawsili 7513","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7519","5 - (  7514  ) -  سَمِعْتُ  إِسْحَاقَ ، يَقُولُ :  سَمِعْتُ  سُفْيَانَ ،  يَقُولُ  : كَانَ أَبُو حَازِمٍ ، يَقُولُ :  سَمِعْتُ  سَهْلَ بْنَ سَعْدٍ ، يَقُولُ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَوْضِعُ سَوْطٍ فِي الْجَنَّةِ خَيْرٌ مِنَ الدُّنْيَا وَمَا فِيهَا  "" .         [13/507]","","Musnad Abi Ya'la al-Mawsili 7514","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7520","6 - (  7515  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ :  جَاءَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَحْنُ نَنْقُلُ التُّرَابَ عَلَى رُؤُوسِنَا ، فَقَالَ :         [13/508]      اللَّهُمَّ لَا عَيْشَ إِلَّا عَيْشُ الْآخِرَهْ  فَاغْفِرْ  لِلْأَنْصَارِ  وَالْمُهَاجِرَهْ  .","","Musnad Abi Ya'la al-Mawsili 7515","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7521","7 - (  7516  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ قَالَ :  حَدَّثَنِي  أَبُو حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أُحُدٌ  رُكْنٌ مِنْ أَرْكَانِ الْجَنَّةِ  .         [13/509]","","Musnad Abi Ya'la al-Mawsili 7516","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد الله بن جعفر بن نجيح عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7522","8 - (  7517  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي حَازِمٍ ،  سَمِعَهُ مِنْ  سَهْلِ بْنِ سَعْدٍ وَهُوَ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  وَقَعَ بَيْنَ  الْأَوْسِ  وَالْخَزْرَجِ  كَلَامٌ ، حَتَّى تَنَاوَلَ بَعْضُهُمْ بَعْضًا ، فَأُتِيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأُخْبِرَ ، فَأَتَاهُمْ ، فَأَذَّنَ  بِلَالٌ  بِالصَّلَاةِ ، فَاحْتَبَسَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا أَنِ احْتَبَسَ أَقَامَ الصَّلَاةَ ، وَتَقَدَّمَ  أَبُو بَكْرٍ  يَؤُمُّ النَّاسَ ، وَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ مَجِيئِهِ ذَلِكَ فَتَخَلَّلَ النَّاسَ ، حَتَّى انْتَهَى إِلَى الصَّفِّ الَّذِي يَلِي  أَبَا بَكْرٍ  ، فَصَفَّقَ النَّاسُ ، وَكَانَ  أَبُو بَكْرٍ  لَا يَلْتَفِتُ فِي الصَّلَاةِ ، فَلَمَّا سَمِعَ التَّصْفِيقَ الْتَفَتَ فَإِذَا هُوَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَشَارَ إِلَيْهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَنِ اثْبُتْ قَالَ : مَا كَانَ اللهُ لِيَرَى  ابْنَ أَبِي قُحَافَةَ  بَيْنَ يَدَيْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَالَ لِلنَّاسِ :  مَا لَكُمْ حِينَ نَابَكُمْ شَيْءٌ فِي صَلَاتِكُمْ صَفَّقْتُمْ ؟ إِنَّمَا هُوَ لِلنِّسَاءِ  ، مَنْ نَابَهُ شَيْءٌ فِي صَلَاتِهِ ، فَلْيَقُلْ : سُبْحَانَ اللهِ  .","","Musnad Abi Ya'la al-Mawsili 7517","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7523","9 - (  7518  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنْ  أَبِي حَازِمٍ ،         [13/510]      عَنْ  سَهْلِ بْنِ سَعْدٍ  أَنَّ  أُحُدًا  ارْتَجَّ وَعَلَيْهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  ،  وَعُمَرُ  ،  وَعُثْمَانُ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اثْبُتْ  أُحُدُ  ، فَمَا عَلَيْكَ إِلَّا نَبِيٌّ ، أَوْ صِدِّيقٌ ، أَوْ شَهِيدَانِ  .         [13/511]","","Musnad Abi Ya'la al-Mawsili 7518","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7524","10 - (  7519  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي يَحْيَى ،  عَنْ  أَبِيهِ  قَالَ  :  دَخَلْنَا عَلَى سَهْلِ بْنِ سَعْدٍ السَّاعِدِيِّ فِي نِسْوَةٍ ، فَقَالَ :  لَوْ أَنِّي سَقَيْتُكُمْ مِنْ  بِئْرِ بُضَاعَةَ  لَكَرِهْتُمْ ذَلِكَ ، وَقَدْ وَاللهِ سَقَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ مَائِهَا  .         [13/512]","","Musnad Abi Ya'la al-Mawsili 7519","","سهل بن سعد الساعدي عن سمعان الأسلمي عن محمد بن أبي يحيى الأسلمي عن حاتم بن إسماعيل الحارثي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7525","11 - (  7520  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ الْجُمَحِيُّ قَالَ :  حَدَّثَنَا  أَبُو حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ،  سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَذَكَرَ الْجَنَّةَ ، فَقَالَ :  فِيهَا مَا لَا عَيْنٌ رَأَتْ ، وَلَا أُذُنٌ سَمِعَتْ  ، وَلَا خَطَرَ عَلَى         [13/513]      قَلْبِ بَشَرٍ  .         [13/514]","","Musnad Abi Ya'la al-Mawsili 7520","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سعيد بن عبد الرحمن الجمحي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7526","12 - (  7521  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  أَخْبَرَنَا  مَعْمَرٌ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : سَمِعْتُهُ يُحَدِّثُ  أَنَّ  امْرَأَةً  جَاءَتْ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَهَبَتْ نَفْسَهَا لَهُ ، فَصَمَتَ ، ثُمَّ عَرَضَتْ نَفْسَهَا عَلَيْهِ ، فَصَمَتَ ، فَلَقَدْ رَأَيْتُهَا قَائِمَةً  مَلِيًّا - أَوْ قَالَ : هَوِيًّا  - تَعْرِضُ نَفْسَهَا عَلَيْهِ وَهُوَ صَامِتٌ ، فَقَامَ  رَجُلٌ  - أَحْسَبُهُ قَالَ : مِنَ  الْأَنْصَارِ  - قَالَ : إِنْ لَمْ يَكُنْ لَكَ بِهَا حَاجَةٌ فَزَوِّجْنِيهَا ، فَقَالَ : "" أَلَكَ شَيْءٌ ؟ "" قَالَ : لَا ، وَاللهِ يَا رَسُولَ اللهِ قَالَ : "" فَاذْهَبْ فَالْتَمِسْ شَيْئًا ، وَلَوْ خَاتَمًا مِنْ حَدِيدٍ "" فَذَهَبَ ثُمَّ رَجَعَ ، فَقَالَ : وَاللهِ مَا وَجَدْتُ شَيْئًا غَيْرَ ثَوْبِي هَذَا ، أَشُقُّهُ بَيْنِي وَبَيْنَهَا ، فَقَالَ         [13/515]      النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا فِي ثَوْبِكَ فَضْلٌ عَنْكَ  .         [13/516]             [13/517]","","Musnad Abi Ya'la al-Mawsili 7521","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7527","13 - (  7522  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي حَازِمٍ ،  سَمِعَ  سَهْلَ بْنَ سَعْدٍ ، يَقُولُ فِي  الْقَوْمِ  :  كُنْتُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَامَتِ  امْرَأَةٌ  ، فَقَالَتْ : إِنَّهَا قَدْ وَهَبَتْ نَفْسَهَا لَهُ ، فَرَ فِيهَا رَأْيَكَ ، فَقَامَ إِلَيْهِ  رَجُلٌ  مِنَ  الْقَوْمِ  ، فَقَالَ : زَوِّجْنِيهَا ، فَلَمْ يَرُدَّ عَلَيْهِ شَيْئًا ، ثُمَّ قَالَتْ : إِنَّهَا قَدْ وَهَبَتْ نَفْسَهَا لَكَ ، فَقَامَ رَجُلٌ ، فَقَالَ : زَوِّجْنِيهَا ، ثُمَّ قَامَ الثَّالِثَةَ ، فَقَالَ : هَلْ عِنْدَكَ شَيْءٌ ؟ قَالَ : لَا قَالَ : فَاذْهَبْ فَاطْلُبْ . قَالَ : فَذَهَبَ فَطَلَبَ ، فَقَالَ : مَا وَجَدْتُ شَيْئًا . قَالَ : فَاذْهَبْ فَاطْلُبْ ، وَلَوْ خَاتَمًا مِنْ حَدِيدٍ . قَالَ : فَذَهَبَ ، ثُمَّ رَجَعَ ، فَقَالَ : لَمْ أَجِدْ شَيْئًا . قَالَ : هَلْ مَعَكَ مِنَ الْقُرْآنِ شَيْءٌ ؟ قَالَ : نَعَمْ ، سُورَةُ كَذَا ، وَسُورَةُ كَذَا ، فَقَالَ :  اذْهَبْ فَقَدْ أَنْكَحْتُكَ عَلَى مَا مَعَكَ مِنَ الْقُرْآنِ  .","","Musnad Abi Ya'la al-Mawsili 7522","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7528","14 - (  7523  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  بُعِثْتُ أَنَا         [13/518]      وَالسَّاعَةُ كَهَذِهِ مِنْ هَذِهِ  ،  وَوَصَفَ  سُفْيَانُ  بِإِصْبَعِهِ السَّبَّابَةِ  يُشِيرُ  بِهَا  .         [13/519]","","Musnad Abi Ya'la al-Mawsili 7523","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7529","15 - (  7524  ) -  حَدَّثَنَا  خَلَفُ بْنُ هِشَامٍ الْبَزَّارُ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ :  كَانَ قِتَالٌ بَيْنَ  بَنِي عَمْرِو بْنِ عَوْفٍ  ، فَأَتَاهُمُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِيُصْلِحَ بَيْنَهُمْ ، وَقَدْ صَلَّى الظُّهْرَ ، فَقَالَ  لِبِلَالٍ  : إِنْ حَضَرَتْ صَلَاةُ الْعَصْرِ وَلَمْ آتِ ، فَمُرْ  أَبَا بَكْرٍ  فَلْيُصَلِّ بِالنَّاسِ ، فَلَمَّا حَضَرَتْ صَلَاةُ الْعَصْرِ أَذَّنَ  بِلَالٌ  وَأَقَامَ ، وَقَالَ : يَا  أَبَا بَكْرٍ  تَقَدَّمْ ، فَتَقَدَّمَ  أَبُو بَكْرٍ  ، فَجَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَشَقَّ الصُّفُوفَ ، فَلَمَّا رَأَى النَّاسُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَفَّحُوا ،  يَعْنِي : التَّصْفِيقَ  قَالَ : وَكَانَ  أَبُو بَكْرٍ  إِذَا دَخَلَ فِي صَلَاةٍ لَمْ يَلْتَفِتْ ، فَلَمَّا رَأَى التَّصْفِيقَ لَا يُمْسَكُ عَنْهُ الْتَفَتَ ، فَرَأَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَلْفَهُ ، فَأَوْمَأَ إِلَيْهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنِ امْضِ ، فَلَبِثَ  أَبُو بَكْرٍ  هُنَيَّةً  يَحْمَدُ اللهَ عَلَى قَوْلِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" امْضِ ، ثُمَّ مَشَى  أَبُو بَكْرٍ  الْقَهْقَرَى  ،  يَعْنِي : عَلَى عَقِبِهِ  ، فَلَمَّا رَأَى ذَلِكَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَقَدَّمَ ، فَصَلَّى بِالْقَوْمِ صَلَاتَهُمْ ، فَلَمَّا قَضَى صَلَاتَهُ قَالَ : يَا  أَبَا بَكْرٍ  ، مَا مَنَعَكَ إِذْ أَوْمَأْتُ إِلَيْكَ أَلَّا تَكُونَ مَضَيْتَ ؟ قَالَ  أَبُو بَكْرٍ  : لَمْ يَكُنْ  لِابْنِ أَبِي قُحَافَةَ  أَنْ يَؤُمَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ لِلنَّاسِ :  إِذَا نَابَكُمْ فِي صَلَاتِكُمْ شَيْءٌ فَلْيُسَبِّحِ الرِّجَالُ  ، وَلْيُصَفِّقِ النِّسَاءُ  .         [13/520]","","Musnad Abi Ya'la al-Mawsili 7524","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن حماد بن زيد عن خلف بن هشام البزار عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7530","16 - (  7525  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الزِّمَّانِيُّ ،  حَدَّثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ  حَدَّثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  عَنْ  عُمَرَ بْنِ الْحَكَمِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو","","Musnad Abi Ya'la al-Mawsili 7525","","عبد الله بن عمرو بن العاص عن عمر بن الحكم بن ثوبان الحجازي عن موسى بن عبيدة بن نشيط الحميري عن مكي بن إبراهيم عن محمد بن يحيى بن فياض الزماني عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7531","16 - (  7525  ) - ( م ) -  وَعَنْ  أَبِي حَازِمٍ  عَنْ  سَهْلِ بْنِ سَعْدٍ أَنَّهُ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  دُونَ اللهِ سَبْعُونَ أَلْفَ حِجَابِ نُورٍ وَظُلْمَةٍ  ، وَمَا تَسْمَعُ نَفْسٌ شَيْئًا مِنْ حِسِّ تِلْكَ الْحُجُبِ إِلَّا  زَهَقَتْ  نَفْسُهَا  .         [13/521]","","Musnad Abi Ya'la al-Mawsili 7525","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن موسى بن عبيدة بن نشيط الحميري عن مكي بن إبراهيم عن محمد بن يحيى بن فياض الزماني عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7532","17 - (  7526  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  حَدَّثَنَا  مُعْتَمِرٌ قَالَ :  سَمِعْتُ  عُقْبَةَ بْنَ مُحَمَّدٍ الْمَدِينِيَّ  يُحَدِّثُ ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ،  رَفَعَ الْحَدِيثَ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  عِنْدَ اللهِ خَزَائِنُ لِلْخَيْرِ وَالشَّرِّ  ، مَفَاتِيحُهَا الرِّجَالُ ، فَطُوبَى لِمَنْ جَعَلْتُهُ مِفْتَاحًا لِلْخَيْرِ ، مِغْلَاقًا لِلشَّرِّ ، وَوَيْلٌ لِمَنْ جَعَلْتُهُ مِغْلَاقًا لِلْخَيْرِ ، مِفْتَاحًا لِلشَّرِّ  .         [13/522]","","Musnad Abi Ya'la al-Mawsili 7526","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد الرحمن بن زيد بن أسلم عن عتبة ، ويقال عن معتمر بن سليمان عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7533","18 - (  7527  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَقُولُ  يَوْمَ  خَيْبَرَ  :  لَأُعْطِيَنَّ  الرَّايَةَ  غَدًا رَجُلًا يَفْتَحُ اللهُ عَلَى يَدِهِ  ، فَبَاتَ النَّاسُ  يَدُوكُونَ  ، أَيُّهُمْ يُعْطَى ، فَلَمَّا أَصْبَحَ النَّاسُ ، غَدَوْا عَلَى         [13/523]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كُلُّهُمْ يَرْجُو أَنْ يُعْطَاهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَيْنَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ؟ فَقَالُوا : يَا رَسُولَ اللهِ ! هُوَ يَشْتَكِي عَيْنَيْهِ ، فَأَمَرَ بِهِ ، فَدُعِيَ ، فَبَزَقَ فِي عَيْنَيْهِ ، وَدَعَا لَهُ ، فَبَرَأَ مَكَانَهُ ، حَتَّى كَأَنَّهُ لَمْ يَكُنْ بِهِ شَيْءٌ ، فَدَفَعَ  الرَّايَةَ  إِلَيْهِ ، فَقَالَ : يَا رَسُولَ اللهِ ! عَلَامَ نُقَاتِلُهُمْ ؟ فَقَالَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" عَلَى رِسْلِكَ ،  انْفُذْ  حَتَّى تَنْزِلَ بِسَاحَتِهِمْ ، ثُمَّ ادْعُهُمْ إِلَى اللهِ - عَزَّ وَجَلَّ - ، وَإِلَى رَسُولِهِ ، حَتَّى يَكُونُوا مِثْلَنَا ، وَأَخْبِرْهُمْ بِمَا يَجِبُ عَلَيْهِمْ فِيهِ مِنَ الْحَقِّ ، فَوَاللهِ لَأَنْ يَهْدِيَ اللهُ بِهُدَاكَ رَجُلًا وَاحِدًا خَيْرٌ لَكَ مِنْ حُمْرِ النَّعَمِ  .         [13/524]","","Musnad Abi Ya'la al-Mawsili 7527","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7534","19 - (  7528  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ أَهْلَ الْجَنَّةِ  لَيَتَرَاءَوْنَ  الْغُرْفَةَ مِنْ غُرَفِ الْجَنَّةِ كَمَا تَرَاءَوْنَ الْكَوْكَبَ  الدُّرِّيَّ  فِي الْأُفُقِ الشَّرْقِيِّ أَوِ الْغَرْبِيِّ  .         [13/525]","","Musnad Abi Ya'la al-Mawsili 7528","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد الرحمن بن إسحاق العامري عن بشر بن المفضل عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7535","20 - (  7529  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لِلصَّائِمِينَ بَابٌ فِي الْجَنَّةِ يُقَالُ لَهُ الرَّيَّانُ  ، لَا يَدْخُلُ مِنْهُ أَحَدٌ غَيْرُهُمْ ، فَإِذَا دَخَلَ آخِرُهُمْ أُغْلِقَ ، فَمَنْ دَخَلَ مِنْهُ يَشْرَبْ ، وَمَنْ شَرِبَ لَمْ يَظْمَأْ أَبَدًا  .         [13/526]","","Musnad Abi Ya'la al-Mawsili 7529","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سعيد بن عبد الرحمن الجمحي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7536","21 - (  7530  ) -  وَعَنْ  سَهْلِ بْنِ سَعْدٍ  أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَذْكُرُ الْجَنَّةَ ، يَقُولُ :  فِيهَا مَا لَا عَيْنٌ رَأَتْ  ، وَلَا أُذُنٌ سَمِعَتْ ، وَلَا خَطَرَ عَلَى قَلْبِ بَشَرٍ  .         [13/527]","","Musnad Abi Ya'la al-Mawsili 7530","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سعيد بن عبد الرحمن الجمحي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7537","22 - (  7531  ) -  وَعَنْ  سَهْلِ بْنِ سَعْدٍ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  غَدْوَةٌ  أَوْ رَوْحَةٌ ،  يَعْنِي : فِي  سَبِيلِ  اللهِ  ، خَيْرٌ مِنَ الدُّنْيَا وَمَا فِيهَا  .","","Musnad Abi Ya'la al-Mawsili 7531","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سعيد بن عبد الرحمن الجمحي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7538","23 - (  7532  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  قُدَامَةَ بْنِ إِبْرَاهِيمَ  قَالَ  :  رَأَيْتُ  الْحَجَّاجَ  يَضْرِبُ  عَبَّاسَ بْنَ سَهْلٍ  فِي أَمْرِ  ابْنِ الزُّبَيْرِ  ، فَأَتَاهُ سَهْلُ بْنُ سَعْدٍ ، وَهُوَ شَيْخٌ كَبِيرٌ لَهُ ضِفْرَانِ وَعَلَيْهِ ثَوْبَانِ : إِزَارٌ ، وَرِدَاءٌ ، فَوَقَفَ بَيْنَ  السِّمَاطَيْنِ  ، فَقَالَ : يَا  حَجَّاجُ  ، أَلَا تَحْفَظُ فِينَا وَصِيَّةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : وَمَا أَوْصَى بِهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيكُمْ ؟ قَالَ :  أَوْصَى أَنْ يُحْسَنَ إِلَى مُحْسِنِ  الْأَنْصَارِ  ، وَيُعْفَى عَنْ مُسِيئِهِمْ قَالَ : فَأَرْسَلَهُ  .         [13/528]","","Musnad Abi Ya'la al-Mawsili 7532","","سهل بن سعد الساعدي عن قدامة بن إبراهيم الجمحي عن عبد الله بن مصعب بن ثابت الزبيري عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7539","24 - (  7533  ) -  حَدَّثَنَا  مُصْعَبٌ ،  حَدَّثَنَا  ابْنُ أَبِي حَازِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ، قَالَ :  كُنْتُ أَتَسَحَّرُ فِي أَهْلِي ، ثُمَّ تَكُونُ سُرْعَةٌ أَنْ أُدْرِكَ السُّجُودَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .         [13/529]","","Musnad Abi Ya'la al-Mawsili 7533","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد الله بن عامر الأسلمي عن عبد العزيز بن أبي حازم المخزومي عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7540","25 - (  7534  ) -  حَدَّثَنَا  دَاوُدُ بْنُ عَمْرِو بْنِ زُهَيْرٍ الضَّبِّيُّ ،  حَدَّثَنَا  زُهْرَةُ بْنُ عَمْرِو بْنِ مَعْبَدٍ التَّيْمِيُّ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ السَّاعِدِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  قِيدُ  سَوْطٍ فِي الْجَنَّةِ خَيْرٌ مِنَ الدُّنْيَا وَمَا فِيهَا  ،  وَغَدْوَةٌ  فِي  سَبِيلِ  اللهِ أَوْ رَوْحَةٌ خَيْرٌ مِنَ الدُّنْيَا وَمَا فِيهَا  .","","Musnad Abi Ya'la al-Mawsili 7534","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن زهرة بن عمرو بن منقذ عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7541","26 - (  7535  ) -  وَعَنْ  أَبِي حَازِمٍ قَالَ :  أَخْبَرَنِي  سَهْلُ بْنُ سَعْدٍ قَالَ :  شَهِدْتُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثَلَاثًا حِينَ كُسِرَتْ رَبَاعِيَتُهُ ، وَجُرِحَ وَجْهُهُ  ،  وَهُشِّمَتِ  الْبَيْضَةُ  عَلَى رَأْسِهِ ، وَإِنِّي لَأَعْرِفُ مَنْ يَغْسِلُ الدَّمَ عَنْ وَجْهِهِ ، وَمَنْ يَنْقُلُ عَلَيْهِ الْمَاءَ ، وَمَاذَا جَعَلَ لِمَنْ أَخَذَهُ  ،         [13/530]      وَانْقَطَعَ عَلَى أَبِي يَعْلَى .","","Musnad Abi Ya'la al-Mawsili 7535","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن زهرة بن عمرو بن منقذ عن داود بن عمرو المسيبي عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7542","27 - (  7536  ) -  حَدَّثَنَا  أَبُو إِبْرَاهِيمَ التَّرْجُمَانِيُّ إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ يَعْنِي ابْنَ أَبِي حَازِمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَهْلِ بْنِ سَعْدٍ  أَنَّ  رَجُلًا  سَأَلَهُ : جُرِحَ وَجْهُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقَالَ :  جُرِحَ وَجْهُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكُسِرَتْ رَبَاعِيَتُهُ  ،  وَهُشِّمَتِ  الْبَيْضَةُ  عَلَى رَأْسِهِ ، فَكَانَتْ  فَاطِمَةُ بِنْتُ مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَغْسِلُ الدَّمَ ،  وَعَلِيٌّ  يَسْكُبُ عَلَيْهَا الْمَاءَ  بِالْمِجَنِّ  ، فَلَمَّا رَأَتْ  فَاطِمَةُ  أَنَّ الْمَاءَ لَا يَزِيدُ الدَّمَ إِلَّا كَثْرَةً ، أَخَذَتْ  فَاطِمَةُ         [13/531]      قِطْعَةَ حَصِيرٍ ، فَأَحْرَقَتْهُ ، حَتَّى إِذَا صَارَ  رَمَادًا  ، أَلْصَقَتْهُ بِالْجُرْحِ ، اسْتَمْسَكَ الدَّمُ  .","","Musnad Abi Ya'la al-Mawsili 7536","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن إسماعيل بن إبراهيم الترجماني عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7543","28 - (  7537  ) -  وَعَنْ  سَهْلِ بْنِ سَعْدٍ أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  لَأُعْطِيَنَّ  الرَّايَةَ  غَدًا رَجُلًا يَفْتَحُ اللهُ عَلَى يَدَيْهِ  قَالَ : فَبَاتَ النَّاسُ  يَدُوكُونَ  لِذَلِكَ ، وَيَرَوْنَ أَيَّهُمْ يُعْطَاهَا ، فَلَمَّا أَصْبَحَ النَّاسُ غَدَوْا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كُلُّهُمْ يَرْجُو أَنْ يُعْطَاهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَيْنَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ؟ قَالُوا : يَا رَسُولَ اللهِ ! هُوَ يَشْتَكِي عَيْنَيْهِ ، فَأَمَرَ بِهِ ، فَدُعِيَ ، فَبَصَقَ فِي عَيْنَيْهِ ، وَدَعَا لَهُ ، فَبَرَأَ مَكَانَهُ ، حَتَّى كَأَنْ لَمْ يَكُنْ بِهِ شَيْءٌ ، فَأَعْطَاهُ  الرَّايَةَ  ، فَقَالَ : يَا رَسُولَ اللهِ ! أَنُقَاتِلُهُمْ حَتَّى يَكُونُوا مِثْلَنَا ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" عَلَى رِسْلِكَ ، إِذَا نَزَلْتَ بِسَاحَتِهِمْ فَادْعُهُمْ إِلَى الْإِسْلَامِ ، وَأَخْبِرْهُمْ بِمَا يَجِبُ عَلَيْهِمْ فِيهِ مِنَ الْحَقِّ ، فَوَاللهِ لَأَنْ يَهْدِيَ اللهُ بِهُدَاكَ رَجُلًا وَاحِدًا خَيْرٌ لَكَ مِنْ حُمْرِ النَّعَمِ  .","","Musnad Abi Ya'la al-Mawsili 7537","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن إسماعيل بن إبراهيم الترجماني عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7544","29 - (  7538  ) -  وَعَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ  كَانَ بَيْنَ مُصَلَّى         [13/532]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَالْجِدَارِ مَمَرُّ الشَّاةِ  .","","Musnad Abi Ya'la al-Mawsili 7538","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن إسماعيل بن إبراهيم الترجماني عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7545","30 - (  7539  ) -  وَعَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ :  جَاءَتِ  امْرَأَةٌ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : يَا رَسُولَ اللهِ ! جِئْتُ أَهَبُ نَفْسِيَ لَكَ . قَالَ : فَنَظَرَ إِلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَصَعَّدَ  الْبَصَرَ فِيهَا  وَصَوَّبَهُ  ، فَلَمَّا طَالَ مُقَامُهَا تَنَحَّتْ ، فَجَلَسَتْ ، فَقَامَ  رَجُلٌ مِنْ أَصْحَابِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ! إِنْ لَمْ يَكُنْ لَكَ بِهَا حَاجَةٌ ، فَزَوِّجْنِيهَا . قَالَ : فَهَلْ عِنْدَكَ مِنْ شَيْءٍ ؟ قَالَ : لَا ، وَاللهِ يَا رَسُولَ اللهِ         [13/533]      . قَالَ : فَاذْهَبْ ، فَذَهَبَ ، ثُمَّ رَجَعَ ، فَقَالَ : مَا وَجَدْتُ شَيْئًا . قَالَ : اذْهَبْ فَانْظُرْ وَلَوْ خَاتَمٌ مِنْ حَدِيدٍ . قَالَ : فَذَهَبَ ثُمَّ رَجَعَ ، فَقَالَ : يَا رَسُولَ اللهِ لَا ، وَلَا خَاتَمٌ مِنْ حَدِيدٍ ، هَذَا إِزَارِي وَمَا لَهُ رِدَاءٌ ،  أُصْدِقُهَا  إِيَّاهُ ، فَقَالَ : إِزَارُكَ إِنْ لَبِسَتْهُ لَمْ يَكُنْ عَلَيْكَ مِنْهُ شَيْءٌ ، وَإِنْ لَبِسْتَهُ لَمْ يَكُنْ عَلَيْهَا مِنْهُ شَيْءٌ . قَالَ : فَلَمَّا طَالَ مَجْلِسُهُ قَامَ ، فَرَآهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُوَلِّيًا ، فَأَمَرَ بِهِ ، فَدُعِيَ ، فَقَالَ : مَاذَا مَعَكَ مِنَ الْقُرْآنِ ؟ قَالَ : مَعِي سُورَةُ كَذَا ، وَسُورَةُ كَذَا ، مِنَ السُّوَرِ عَدَّدَهَا ، فَقَالَ :  اذْهَبْ فَقَدْ مَلَّكْتُكَهَا بِمَا مَعَكَ مِنَ الْقُرْآنِ  .","","Musnad Abi Ya'la al-Mawsili 7539","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن إسماعيل بن إبراهيم الترجماني عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7546","31 - (  7540  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  فُضَيْلُ بْنُ سُلَيْمَانَ النُّمَيْرِيُّ ،  حَدَّثَنَا  أَبُو حَازِمٍ ،  حَدَّثَنَا  سَهْلُ بْنُ سَعْدٍ قَالَ :  لَمَّا نَزَلَتْ هَذِهِ الْآيَةُ         {      وَكُلُوا وَاشْرَبُوا حَتَّى يَتَبَيَّنَ لَكُمُ الْخَيْطُ الأَبْيَضُ مِنَ الْخَيْطِ الأَسْوَدِ         }      قَالَ  كَانَ الرَّجُلُ يَأْخُذُ  الْخَيْطَ  الْأَبْيَضَ  وَالْخَيْطَ         [13/534]      الْأَسْوَدَ فَيَأْكُلُ حَتَّى يَسْتَبِينَهُمَا  حَتَّى أَنْزَلَ اللهُ - عَزَّ وَجَلَّ -         {      مِنَ الْفَجْرِ         }      فَبَيَّنَ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 7540","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن فضيل بن سليمان النميري عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7547","32 - (  7541  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ بِشْرٌ وَقَدْ  سَمِعْتُهُ مِنْ  أَبِي حَازِمٍ  أَنَّ رِجَالًا مِنَ الْمُسْلِمِينَ كَانُوا يَشْهَدُونَ الصَّلَاةَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَاقِدِي ثِيَابِهِمْ فِي رِقَابِهِمْ  مَا عَلَى أَحَدٍ مِنْهُمْ إِلَّا ثَوْبٌ وَاحِدٌ  .         [13/535]","","Musnad Abi Ya'la al-Mawsili 7541","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد الرحمن بن إسحاق العامري عن بشر بن المفضل عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7548","33 - (  7542  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ :  كُنَّ النِّسَاءُ يُؤْمَرْنَ فِي عَهْدِ         [13/536]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الصَّلَاةِ أَنْ لَا يَرْفَعْنَ رُؤُوسَهُنَّ  حَتَّى يَأْخُذَ الرِّجَالُ مَقَاعِدَهُمْ مِنَ الْأَرْضِ مِنْ قَبَاحَةِ الثِّيَابِ  ،  قَالَ بِشْرٌ : قَدْ  سَمِعْتُهُ مِنْ  أَبِي حَازِمٍ .","","Musnad Abi Ya'la al-Mawsili 7542","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد الرحمن بن إسحاق العامري عن بشر بن المفضل عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7549","34 - (  7543  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  عُبَيْدَةُ قَالَ :  حَدَّثَنِي  عُمَارَةُ بْنُ غَزِيَّةَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَا لَبَّى مِنْ مُلَبٍّ إِلَّا لَبَّى الدَّبْرُ الَّذِي يَلِيهِ مِنْ هَاهُنَا وَهَاهُنَا  ، عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ حَتَّى يَنْقَطِعَ التُّرَابُ  .         [13/537]","","Musnad Abi Ya'la al-Mawsili 7543","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عمارة بن غزية عن عبيدة بن حميد بن صهيب التيمي عن سريج بن يونس المروزي عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7550","35 - (  7544  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ الْقَاضِي ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ !  يَوْمَ  أُحُدٍ  مَا رَأَيْنَا مِثْلَ مَا أَتَى فُلَانٌ ، آتَاهُ  رَجُلٌ  ! لَقَدْ فَرَّ النَّاسُ وَمَا فَرَّ ، وَمَا تَرَكَ لِلْمُشْرِكِينَ شَاذَّةً وَلَا فَاذَّةً إِلَّا تَبِعَهَا يَضْرِبُهَا بِسَيْفِهِ . قَالَ : وَمَنْ هُوَ ؟ قَالَ : فَنُسِبَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَسَبُهُ ، فَلَمْ يَعْرِفْهُ ، ثُمَّ وُصِفَ لَهُ بِصِفَتِهِ فَلَمْ يَعْرِفْهُ ، حَتَّى طَلَعَ         [13/538]      الرَّجُلُ بِعَيْنِهِ ، فَقَالَ : ذَا يَا رَسُولَ اللهِ الَّذِي أَخْبَرْنَاكَ عَنْهُ ، فَقَالَ : هَذَا ؟ فَقَالُوا : نَعَمْ . قَالَ : إِنَّهُ مِنْ أَهْلِ النَّارِ ؟ قَالَ : فَاشْتَدَّ ذَلِكَ عَلَى الْمُسْلِمِينَ ، قَالُوا : وَأَيُّنَا مِنْ أَهْلِ الْجَنَّةِ إِذَا كَانَ فُلَانٌ مِنْ أَهْلِ النَّارِ ؟ فَقَالَ رَجُلٌ مِنَ  الْقَوْمِ  : يَا قَوْمُ انْظُرُونِي ، فَوَالَّذِي نَفْسِي بِيَدِهِ ، لَا يَمُوتُ عَلَى مِثْلِ الَّذِي أَصْبَحَ عَلَيْهِ ، وَلَأَكُونَنَّ صَاحِبَهُ مِنْ بَيْنِكُمْ ، ثُمَّ رَاحَ عَلَى جَدِّهِ فِي الْغَدِ ، فَجَعَلَ الرَّجُلُ يَشُدُّ مَعَهُ إِذَا شَدَّ ، وَيَرْجِعُ مَعَهُ إِذَا رَجَعَ ، فَيَنْظُرُ مَا يَصِيرُ إِلَيْهِ أَمْرُهُ ، حَتَّى أَصَابَهُ جُرْحٌ  أَذْلَقَهُ  ، فَاسْتَعْجَلَ الْمَوْتَ ، فَوَضَعَ قَائِمَةَ سَيْفِهِ بِالْأَرْضِ ، ثُمَّ وَضَعَ  ذُبَابَهُ  بَيْنَ ثَدْيَيْهِ ، ثُمَّ تَحَامَلَ عَلَى سَيْفِهِ حَتَّى خَرَجَ مِنْ ظَهْرِهِ ، وَخَرَجَ الرَّجُلُ يَعْدُو ، وَيَقُولُ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَشْهَدُ أَنَّكَ رَسُولُ اللهِ ، حَتَّى وَقَفَ بَيْنَ يَدَيْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : وَذَاكَ مَاذَا ؟ قَالَ : يَا رَسُولَ اللهِ ! الرَّجُلُ الَّذِي ذُكِرَ لَكَ ، فَقُلْتَ : إِنَّهُ مِنْ أَهْلِ النَّارِ ، فَاشْتَدَّ ذَلِكَ عَلَى الْمُسْلِمِينَ ، وَقَالُوا : فَأَيُّنَا مِنْ أَهْلِ الْجَنَّةِ إِذَا كَانَ فُلَانٌ مِنْ أَهْلِ النَّارِ ؟ فَقُلْتُ : يَا قَوْمُ انْظُرُونِي ، فَوَالَّذِي نَفْسِي بِيَدِهِ لَا يَمُوتُ عَلَى مِثْلِ الَّذِي أَصْبَحَ عَلَيْهِ ، وَلَأَكُونَنَّ صَاحِبَهُ مِنْ بَيْنِكُمْ ، فَجَعَلْتُ أَشُدُّ مَعَهُ إِذَا شَدَّ ، وَأَرْجِعُ مَعَهُ         [13/539]      إِذَا رَجَعَ ، وَأَنْظُرُ إِلَى مَا يَصِيرُ أَمْرُهُ ، حَتَّى أَصَابَهُ جُرْحٌ  أَذْلَقَهُ  ، فَاسْتَعْجَلَ الْمَوْتَ ، فَوَضَعَ قَائِمَةَ سَيْفِهِ بِالْأَرْضِ ، وَوَضَعَ  ذُبَابَهُ  بَيْنَ ثَدْيَيْهِ ، ثُمَّ تَحَامَلَ عَلَى سَيْفِهِ حَتَّى خَرَجَ مِنْ بَيْنِ ظَهْرِهِ ، فَهُوَ ذَاكَ يَا رَسُولَ اللهِ ! يَتَضَرَّبُ بَيْنَ أَضْغَاثِهِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الرَّجُلَ لَيَعْمَلُ عَمَلَ أَهْلِ الْجَنَّةِ فِيمَا يَبْدُو لِلنَّاسِ ، وَإِنَّهُ لَمِنْ أَهْلِ النَّارِ  ، وَإِنَّ الرَّجُلَ لَيَعْمَلُ عَمَلَ أَهْلِ النَّارِ فِيمَا يَبْدُو لِلنَّاسِ وَإِنَّهُ مِنْ أَهْلِ الْجَنَّةِ  .         [13/540]","","Musnad Abi Ya'la al-Mawsili 7544","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سعيد بن عبد الرحمن الجمحي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7551","36 - (  7545  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ  أَنَّ  بَنِي عَمْرِو بْنِ عَوْفٍ  ، كَانَتْ بَيْنَهُمْ مُنَازَعَةٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِبَعْضِ أَصْحَابِهِ :  اذْهَبُوا بِنَا لِنُصْلِحَ بَيْنَهُمْ فَخَرَجَ وَخَرَجَ مَعَهُ مِنْ أَصْحَابِهِ  ، فَحَضَرَتِ الصَّلَاةُ ، فَقَامَ  بِلَالٌ  فَأَذَّنَ ، ثُمَّ دَنَا مِنْ  أَبِي بَكْرٍ  ، فَقَالَ : أَلَا أُقِيمُ الصَّلَاةَ فَتُصَلِّيَ بِالنَّاسِ حِينَمَا حُبِسَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقَالَ : بَلَى ، فَأَقَامَ ، فَتَقَدَّمَ  أَبُو بَكْرٍ  ، فَكَبَّرَ بِالنَّاسِ ، فَطَلَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ مُؤَخَّرِ الْمَسْجِدِ ، فَجَعَلَ يَجُولُ عَلَى الصُّفُوفِ جَوْلًا عَامِدًا نَحْوَ الْقِبْلَةِ ، فَلَمَّا رَآهُ الْمُسْلِمُونَ صَفَّقُوا  بِأَبِي بَكْرٍ  ، فَمَضَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى انْتَهَى إِلَى أَوَّلِ صَفٍّ ، فَلَمَّا أَكْثَرُوا التَّصْفِيقَ الْتَفَتَ  أَبُو بَكْرٍ  فَإِذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَكَرَّ رَاجِعًا ، فَرَدَّهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى الْقِبْلَةِ ، وَرَفَعَ يَدَيْهِ فَحَمِدَ اللهَ ، ثُمَّ كَرَّ كَرَّةً غَيْرَ مُكَذَّبَةٍ حَتَّى وَلِجَ فِي الصَّفِّ ، فَتَقَدَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَلَّى بِالنَّاسِ حَتَّى فَرَغَ مِنْ صَلَاتِهِ ، ثُمَّ أَقْبَلَ عَلَى النَّاسِ ، فَقَالَ :  أَيُّهَا النَّاسُ ، مَنْ نَابَهُ شَيْءٌ فِي صَلَاتِهِ فَلْيَقُلْ : سُبْحَانَ اللهِ  ، فَإِنَّ التَّسْبِيحَ لِلرِّجَالِ ، وَإِنَّ         [13/541]      التَّصْفِيحَ  لِلنِّسَاءِ ،  يَعْنِي : التَّصْفِيقَ  ، ثُمَّ أَقْبَلَ عَلَى  أَبِي بَكْرٍ  ، فَقَالَ : مَا مَنَعَكَ أَنْ تَثْبُتَ حِينَ أَمَرْتُكَ ؟ قَالَ : مَا كَانَ يَنْبَغِي  لِابْنِ أَبِي قُحَافَةَ  أَنْ يَؤُمَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Musnad Abi Ya'la al-Mawsili 7545","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن سعيد بن عبد الرحمن الجمحي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7552","37 - (  7546  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  عَنْ  عَيَّاشٍ الْحَضْرَمِيِّ قَالَ :  أَخْبَرَنِي  يَحْيَى بْنُ مَيْمُونٍ قَاضِي  مِصْرَ  قَالَ :  حَدَّثَنِي  سَهْلُ بْنُ سَعْدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنِ انْتَظَرَ الصَّلَاةَ فَهُوَ فِي صَلَاةٍ مَا لَمْ يُحْدِثْ  .","","Musnad Abi Ya'la al-Mawsili 7546","","سهل بن سعد الساعدي عن يحيى بن ميمون بن ربيعة الحضرمي عن عياش بن عقبة بن كليب الحضرمي عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7553","38 - (  7547  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  عَنْ  مُوسَى بْنِ يَعْقُوبَ الزَّمْعِيِّ قَالَ :  حَدَّثَنِي  أَبُو حَازِمٍ ،         [13/542]      عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  سَيُعَزِّي  النَّاسُ بَعْضُهُمْ بَعْضًا مِنْ بَعْدِي تَعْزِيَةً بِي  ، فَكَانَ النَّاسُ يَقُولُونَ : مَا هَذَا ؟ فَلَمَّا قُبِضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَقِيَ بَعْضُنَا بَعْضًا يُعَزِّي بَعْضُهُمْ بَعْضًا بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Musnad Abi Ya'la al-Mawsili 7547","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن خالد بن مخلد القطواني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7554","39 - (  7548  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  أَبِي حَفْصٍ الطَّائِفِيِّ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ صَامَ يَوْمَ عَرَفَةَ ، غُفِرَ لَهُ سَنَتَيْنِ مُتَتَابِعَتَيْنِ  .         [13/543]","","Musnad Abi Ya'la al-Mawsili 7548","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد السلام بن حفص السلمي عن معاوية بن هشام القصار عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7555","40 - (  7549  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  عَنْ  مُحَمَّدِ بْنِ جَعْفَرِ بْنِ أَبِي كَثِيرٍ قَالَ :  حَدَّثَنِي  أَبُو حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يُحْشَرُ النَّاسُ يَوْمَ الْقِيَامَةِ عَلَى أَرْضٍ بَيْضَاءَ  عَفْرَاءَ  كَقُرْصَةِ  النَّقِيِّ ،  لَيْسَ فِيهَا مَعْلَمٌ لِأَحَدٍ  .         [13/544]","","Musnad Abi Ya'la al-Mawsili 7549","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن محمد بن جعفر بن أبي كثير الزرقي عن خالد بن مخلد القطواني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7556","41 - (  7550  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  ابْنُ وَهْبٍ قَالَ :  وَحَدَّثَنِي  عَيَّاشُ بْنُ عُقْبَةَ الْحَضْرَمِيُّ أَنَّ يَحْيَى بْنَ مَيْمُونٍ الْحَضْرَمِيَّ  حَدَّثَهُ  قَالَ  :  مَرَّ بِي سَهْلُ بْنُ سَعْدٍ الْأَنْصَارِيُّ ، وَأَنَا جَالِسٌ فِي الْمَسْجِدِ إِلَى الْمَقْصُورَةِ ، فَقَالَ لِي : أَلَا أُخْبِرُكَ مَا سَمِعْتُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقُلْتُ لِرَجُلٍ إِلَى جَنْبِي لَيْسَ بَيْنَهُ وَبَيْنَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا هَذَا : بَلَى ، أَصْلَحَكَ اللهُ فَأَخْبِرْنِي ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ كَانَ فِي الْمَسْجِدِ يَنْتَظِرُ صَلَاةً  ، فَهُوَ فِي صَلَاةٍ مَا كَانَتِ الصَّلَاةُ تَحْبِسُهُ  .         [13/545]","","Musnad Abi Ya'la al-Mawsili 7550","","سهل بن سعد الساعدي عن يحيى بن ميمون بن ربيعة الحضرمي عن عياش بن عقبة بن كليب الحضرمي عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7557","42 - (  7551  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُعَاوِيَةَ ،  عَنِ  ابْنِ أَبِي ذُبَابٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ :  مَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَاهِرًا يَدَيْهِ يَدْعُو عَلَى مِنْبَرٍ ، وَلَا عَلَى غَيْرِهِ  ، وَلَكِنْ رَأَيْتُهُ ، يَقُولُ هَكَذَا  ، وَقَالَ  أَبُو سَعِيدٍ  :  بِإِصْبَعِهِ  السَّبَّاحَةِ  مِنْ يَدِهِ الْيُمْنَى فَقَوَّسَهَا  .         [13/546]","","Musnad Abi Ya'la al-Mawsili 7551","","سهل بن سعد الساعدي عن عبد الله عبد الرحمن بن الحارث الدوسي عن عبد الرحمن بن معاوية النوفلي عن عبد الرحمن بن إسحاق العامري عن بشر بن المفضل عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7558","43 - (  7552  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  ابْنُ أَبِي حَازِمٍ قَالَ :  قَالَ  أَبِي  ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَنْ يَزَالُوا بِخَيْرٍ مَا عَجَّلُوا الْفِطْرَ  .","","Musnad Abi Ya'la al-Mawsili 7552","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن هارون بن معروف المروزي عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7559","44 - (  7553  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  ابْنُ أَبِي حَازِمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  أَنَا  وَكَافِلُ  الْيَتِيمِ فِي الْجَنَّةِ  ، وَأَشَارَ  بِالسَّبَّاحَةِ  وَالْوُسْطَى  .         [13/547]","","Musnad Abi Ya'la al-Mawsili 7553","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد العزيز بن أبي حازم المخزومي عن هارون بن معروف المروزي عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7560","45 - (  7554  ) -  حَدَّثَنَا  الْأَزْرَقُ بْنُ عَلِيٍّ ،  حَدَّثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ الْكَرْمَانِيُّ ،  حَدَّثَنَا  خَالِدُ بْنُ سَعِيدٍ الْمَدَنِيُّ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ لِكُلِّ شَيْءٍ سَنَامًا  ، وَإِنَّ سَنَامَ الْقُرْآنِ سُورَةُ الْبَقَرَةِ ، مَنْ قَرَأَهَا فِي بَيْتِهِ لَيْلًا لَمْ يَدْخُلِ الشَّيْطَانُ بَيْتَهُ ثَلَاثَ لَيَالٍ ، وَمَنْ قَرَأَهَا نَهَارًا لَمْ يَدْخُلِ الشَّيْطَانُ بَيْتَهُ ثَلَاثَ أَيَّامٍ  .         [13/548]","","Musnad Abi Ya'la al-Mawsili 7554","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن خالد بن سعيد بن أبي مريم التيمي عن حسان بن إبراهيم الكرماني عن الأزرق بن علي بن مسلم الحنفي عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
"7561","46 - (  7555  ) -  حَدَّثَنَا  الْمُقَدَّمِيُّ ،  حَدَّثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ         [13/549]      يَضْمَنُ لِي مَا بَيْنَ لَحْيَيْهِ  ، وَمَا بَيْنَ رِجْلَيْهِ ، وَأَضْمَنُ لَهُ الْجَنَّةَ  ؟ .         [13/550]      آخِرُ مَا كَانَ عِنْدَ أَبِي عَمْرِو بْنِ حَمْدَانَ الْحِيرِيِّ مِنْ  مُسْنَدِ  أَبِي يَعْلَى الْمَوْصِلِيِّ رَحْمَةُ اللهِ عَلَيْهِمَا ، وَالْحَمْدُ لِلهِ حَقَّ حَمْدِهِ ، وَصَلَوَاتُهُ وَسَلَامُهُ عَلَى خَيْرِ خَلْقِهِ وَمُظْهِرِ حَقِّهِ  مُحَمَّدٍ  ، وَعَلَى آلِهِ وَصَحْبِهِ .","","Musnad Abi Ya'la al-Mawsili 7555","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عمر بن علي بن عطاء عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","حديث سهل بن سعد الساعدي عن النبي صلى الله عليه وسلم"
