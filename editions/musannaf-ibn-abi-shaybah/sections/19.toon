"18791","(۱۸۷۹۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی الْمُخْتَلِعَۃِ قَالَ : إِنْ کَانَتْ نَاشِزًا ، أَمَرَہُ السُّلْطَانُ أَنْ یَخْلَعَ۔","","Musannaf Ibn Abi Shaybah 18791","","","كتاب الجنة"
"18792","(۱۸۷۹۲) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ عَلِیِّ بْنِ الْمُبَارَکِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : کَانَ عِمْرَانُ بْنُ حُصَیْنٍ ، وَابْنُ مَسْعُودٍ یَقُولاَنِ فِی الَّتِی تَفْتَدِی مِنْ زَوْجِہَا : لَہَا طَلاَقٌ مَا کَانَتْ فِی عِدَّتِہَا۔","","Musannaf Ibn Abi Shaybah 18792","","","كتاب الجنة"
"18793","(۱۸۷۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی فَضَالَۃَ ، عَنْ عَلِیِّ بْنِ أَبِی طَلَحْۃَ ، عَنْ أَبِی عَوْنٍ الأَعْوَرِ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : لِلْمُخْتَلِعَۃِ طَلاَقٌ مَا دَامَتْ فِی الْعِدَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 18793","","","كتاب الجنة"
"18794","(۱۸۷۹۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ الْحَسَنِ بْنِ یَحْیَی ، عَنِ الضَّحَّاکِ ، قَالَ : اخْتَلَفَ ابْنُ مَسْعُودٍ ، وَابْنُ عَبَّاسٍ فِی الرَّجُلِ یَخْلَعُ امْرَأَتَہُ ثُمَّ یُطَلِّقُہَا ، قَالَ أَحَدُہُمَا : لَیْسَ طَلاَقُہُ بِشَیْئٍ ، وَقَالَ الآخَرُ : مَا دَامَتْ فِی الْعِدَّۃِ فَإِنَّ الطَّلاَقَ یَلْحَقُہَا۔","","Musannaf Ibn Abi Shaybah 18794","","","كتاب الجنة"
"18795","(۱۸۷۹۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَلْحَقُہَا الطَّلاَقُ۔","","Musannaf Ibn Abi Shaybah 18795","","","كتاب الجنة"
"18796","(۱۸۷۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَجْرِی عَلَیْہَا الطَّلاَقُ مَا کَانَتْ فِی الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 18796","","","كتاب الجنة"
"18797","(۱۸۷۹۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَخْلَعُ امْرَأَتَہُ ثُمَّ یُطَلِّقُہَا ، قَالَ : أَخْذُہُ الْمَالَ تَطْلِیقَۃٌ ، وَکَلاَمُہُ بِالطَّلاَقِ تَطْلِیقَۃٌ۔","","Musannaf Ibn Abi Shaybah 18797","","","كتاب الجنة"
"18798","(۱۸۷۹۸) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَخِلاَسٍ قَالاَ : یَلْحَقُہَا الطَّلاَقُ مَا کَانَتْ فِی الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 18798","","","كتاب الجنة"
"18799","(۱۸۷۹۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : الْخُلْعُ تَطْلِیقَۃٌ بَائِنٌ ، وَمَا أَتْبَعَ مِنَ الطَّلاَقِ ، فَإِنَّہُ یَلْحَقُہَا مَا کَانَتْ فِی الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 18799","","","كتاب الجنة"
"18800","(۱۸۸۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ؛ فِی الرَّجُلِ یَخْلَعُ امْرَأَتَہُ ثُمَّ یُطَلِّقُہَا ، قَالَ : ذَلِکَ أَبْعَدُ لَہُ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 18800","","","كتاب الجنة"
"18801","(۱۸۸۰۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ إسْمَاعِیلَ، عَنِ الشَّعْبِیِّ، عَنْ شُرَیْحٍ، قَالَ: یَلْزَمُ الْمُطَلَّقَۃَ الطَّلاَقُ فِی الْعِدَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 18801","","","كتاب الجنة"
"18802","(۱۸۸۰۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ بَیَانٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الْمَرْأَۃِ تُبَارِئُ زَوْجَہَا فَیُطَلِّقُہَا ، قَالاَ : یَقَعُ عَلَیْہَا مَا کَانَتْ فِی عِدَّتِہَا ۔ قَالَ سُفْیَانُ : نَرَی أَنَّہُ یَقَعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18802","","","كتاب الجنة"
"18803","(۱۸۸۰۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَطَائٍ ؛ فِی الْمُخْتَلِعَۃِ ، قَالَ : یَلْحَقُہَا الطَّلاَقُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18803","","","كتاب الجنة"
"18804","(۱۸۸۰۴) حَدَّثَنَا ابْنُ الْمُبَارَکِ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، عَنِ ابْنِ عَبَّاسٍ، وَابْنِ الزُّبَیْرِ ؛ أَنَّہُمَا قَالاَ : لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 18804","","","كتاب الجنة"
"18805","(۱۸۸۰۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ أَنَّہُ کَانَ یَقُولُ : لاَ یَلْحَقُہَا طَلاَقُہُ إیَّاہَا ، مَا کَانَتْ فِی عِدَّۃٍ مِنْہُ بَائِنَۃً۔","","Musannaf Ibn Abi Shaybah 18805","","","كتاب الجنة"
"18806","(۱۸۸۰۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، وَمَنْصُورٍ ، عَنِ الْحَسَنِ ، وَحَجَّاجٍ ، عَنْ عَطَائٍ ؛ فِی الْمُخْتَلِعَۃِ : لاَ یَقَعُ عَلَیْہَا طَلاَقُ زَوْجِہَا مَا کَانَتْ فِی عِدَّۃٍ مِنْہُ بَائِنَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 18806","","","كتاب الجنة"
"18807","(۱۸۸۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ قَالَ : لاَ یَقَعُ عَلَیْہَا الطَّلاَقُ مَا کَانَتْ فِی الْعِدَّۃ۔","","Musannaf Ibn Abi Shaybah 18807","","","كتاب الجنة"
"18808","(۱۸۸۰۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ ، عَنْ لَیْثٍ ، عَنِ الشَّعْبِیِّ ، وَطَاوُوسٍ قَالاَ : إذَا خَلَعَ ثُمَّ طَلَّقَ ، لَمْ یَقَعْ طَلاَقُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 18808","","","كتاب الجنة"
"18809","(۱۸۸۰۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ الْمُخْتَلِعَۃَ لاَ یَلْحَقُہَا الطَّلاَقُ فِی عِدَّتِہَا۔","","Musannaf Ibn Abi Shaybah 18809","","","كتاب الجنة"
"18810","(۱۸۸۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، وَابْنِ ثَوْبَانَ ، قَالاَ : إِنْ طَلَّقَہَا فِی مَجْلِسِہِ لَزِمَہُ ، وَإِلاَّ فَلاَ۔","","Musannaf Ibn Abi Shaybah 18810","","","كتاب الجنة"
"18811","(۱۸۸۱۱) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لِلْمُخْتَلِعَۃِ السُّکْنَی وَالنَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 18811","","","كتاب الجنة"
"18812","(۱۸۸۱۲) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَن ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لِلْمُخْتَلِعَۃِ السُّکْنَی وَالنَّفَقَۃُ ، لأَنَّہَا لَوْ شَائَتْ تَزَوَّجَتْ زَوْجَہَا فِی عِدَّتِہِا تَزَوَّجَتْہُ۔","","Musannaf Ibn Abi Shaybah 18812","","","كتاب الجنة"
"18813","(۱۸۸۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، قَالَ : الْمُخْتَلِعَۃِ لَہَا النَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 18813","","","كتاب الجنة"
"18814","(۱۸۸۱۴) حَدَّثَنَا وَکِیعٌ ، وَعَبْدَۃُ ، عَنْ إسْمَاعِیلَ ، عَنْ إبْرَاہِیمَ الْبَصْرِیَّ ، عَنِ الشَّعْبِیِّ ؛ سُئِلَ عَنِ الْمُخْتَلِعَۃِ : لَہَا نَفَقَۃٌ ؟ فَقَالَ : کَیْفَ یُنْفِقُ عَلَیْہَا وَہُوَ یَأْخُذُ مِنْہَا ؟۔","","Musannaf Ibn Abi Shaybah 18814","","","كتاب الجنة"
"18815","(۱۸۸۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ : لَیْسَ لِلْمُخْتَلِعَۃِ وَلاَ لِلْمُطَلَّقَۃِ ثَلاَثًا سُکْنَی وَلاَ نَفَقَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18815","","","كتاب الجنة"
"18816","(۱۸۸۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِید ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، قَالَ : لَیْسَ لِلْمُخْتَلِعَۃِ وَالْمُبَارِئَۃِ نَفَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 18816","","","كتاب الجنة"
"18817","(۱۸۸۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لِلْمُمَلَّکَۃِ ، وَالْمُخَیِّرۃ ،وَالْمُخْتَلِعَۃِ ، مُتْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 18817","","","كتاب الجنة"
"18818","(۱۸۸۱۸) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لِلْمُخْتَلِعَۃِ مُتْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18818","","","كتاب الجنة"
"18819","(۱۸۸۱۹) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ مُطَرِّفٍ، عَنِ الشَّعْبِیِّ، قَالَ: لَیْسَ لِلْمُخْتَلِعَۃِ مُتْعَۃٌ، کَیْفَ یُمَتِّعُہَا وَہُوَ یَأْخُذُ مِنْہَا؟","No Data Available","Musannaf Ibn Abi Shaybah 18819","","","كتاب الجنة"
"18820","(۱۸۸۲۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : لِکُلِّ مُطَلَّقَۃٍ مَتَاعٌ ، إلاَّ الْمُخْتَلِعَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18820","","","كتاب الجنة"
"18821","(۱۸۸۲۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ شَرِیکٍ، عَنْ لَیْثٍ، عَنْ طَاوُوسٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لَیْسَ لِلْمُخْتَلِعَۃِ مُتْعَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 18821","","","كتاب الجنة"
"18822","(۱۸۸۲۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ حَبیب بْنِ مِہْرَانَ التَّیمِیِّ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ بْنَ أَبِی أَوْفَی عَنِ امْرَأَۃٍ اخْتَلَعَتْ مِنْ زَوْجِہَا بِبَقِیَّۃِ مَہْرٍ کَانَ لَہَا عَلَیْہِ ، فَہَلْ لَہُمَا أَنْ یَتَرَاجَعَا ؟ قَالَ : نَعَمْ ، إِنْ لَمْ یَکُنْ ذَکَرَ فِیہَا طَلاَقًا بِمَہْرٍ جَدِیدٍ ، قَالَ : وَسَأَلْتُ مَاہَانَ ؟ فَقَالَ : نَعَمْ ، وَلَوْ بِکُوزٍ مِنَ الْمَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 18822","","","كتاب الجنة"
"18823","(۱۸۸۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ عَامِرٍ ، وَعَنْ إبْرَاہِیمَ ، قَالاَ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ وَاحِدَۃً عَلَی جُعْلٍ ، فَلاَ یَمْلِکُ الرَّجْعَۃَ وَہُوَ خَاطِبٌ مِنَ الْخُطَّابِ۔","","Musannaf Ibn Abi Shaybah 18823","","","كتاب الجنة"
"18824","(۱۸۸۲۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ أَبِی یَقُولُ : صَاحِبُہَا أَوْلیَ بِخِطْبَتِہَا فِی الْعِدَّۃِ","","Musannaf Ibn Abi Shaybah 18824","","","كتاب الجنة"
"18825","(۱۸۸۲۵) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا خَلَعَہَا ثُمَّ نَدِمَا وَہِیَ فِی عِدَّتِہَا ، لَمْ تَرْجِعْ إلَیْہِ ، إلاَّ بِخِطْبَۃٍ۔","","Musannaf Ibn Abi Shaybah 18825","","","كتاب الجنة"
"18826","(۱۸۸۲۶) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یَتَزَوَّجُہَا بِأَقَلَّ مِمَّا أَخَذَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 18826","","","كتاب الجنة"
"18827","(۱۸۸۲۷) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : سَمِعْتُ مَیْمُونَ بْنَ مِہْرَانَ یَقُولُ فِی الْمُخْتَلِعَۃِ : إذَا قَبِلَ مِنْہَا زَوْجُہَا الْفِدْیَۃَ ، ثُمَّ خَطَبَہَا بَعْدَ ذَلِکَ قَالَ : یَتَزَوَّجُہَا وَیُسَمِّی لَہَا مَہْرًا جَدِیدًا۔","","Musannaf Ibn Abi Shaybah 18827","","","كتاب الجنة"
"18828","(۱۸۸۲۸) حَدَّثَنَا إبْرَاہِیمُ بْنُ صَدَقَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الْمُخْتَلِعَۃِ إذَا أَرَادَ زَوْجُہَا مُرَاجَعَتَہَا ، قَالَ : یَخْطُبُہَا بِمَہْرٍ جَدِیدٍ۔ (دارقطنی ۲۷۶۔ بیہقی ۳۱۴)","","Musannaf Ibn Abi Shaybah 18828","","","كتاب الجنة"
"18829","(۱۸۸۲۹) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ امْرَأَۃً أَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَشْکُو زَوْجَہَا ، قَالَ : تَرُدِّینَ عَلَیْہِ مَا أَخَذْتِ مِنْہُ ؟ قَالَتْ : نَعَمْ ، وَأَزِیدُہُ ، قَالَ : أَمَّا زِیَادَۃً فَلاَ۔","","Musannaf Ibn Abi Shaybah 18829","","","كتاب الجنة"
"18830","(۱۸۸۳۰) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ یَأْخُذُ مِنْہَا أَکْثَرَ مِمَّا أَعْطَاہَا۔","Da'if","Musannaf Ibn Abi Shaybah 18830","","","كتاب الجنة"
"18831","(۱۸۸۳۱) حَدَّثَنَا ابن إدْرِیسُ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ؛ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 18831","","","كتاب الجنة"
"18832","(۱۸۸۳۲) حَدَّثَنَا عَبْدُ الرَّزَّاقِ، عَنْ مَعْمَرٍ، عَنِ ابْنِ طَاوُوسٍ، عَنْ أَبِیہِ قَالَ: لاَ یَحِلُّ لَہُ أَنْ یَأْخُذَ مِنْہَا أَکْثَرَ مِمَّا أَعْطَاہَا۔","","Musannaf Ibn Abi Shaybah 18832","","","كتاب الجنة"
"18833","(۱۸۸۳۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ بِشْرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : لاَ یَأْخُذُ مِنْہَا أَکْثَرَ مِمَّا أَعْطَاہَا ، فَإِنَّ أَخْذ رَدَّ عَلَیْہا۔","No Data Available","Musannaf Ibn Abi Shaybah 18833","","","كتاب الجنة"
"18834","(۱۸۸۳۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ أَنْ یَأْخُذَ مِنْہَا أَکْثَرَ مِمَّا أَعْطَاہَا۔","","Musannaf Ibn Abi Shaybah 18834","","","كتاب الجنة"
"18835","(۱۸۸۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، وَالْحَسَنِ قَالاَ : لاَ یَأْخُذُ مِنْہَا أَکْثَرَ مِمَّا أَعْطَاہَا۔","","Musannaf Ibn Abi Shaybah 18835","","","كتاب الجنة"
"18836","(۱۸۸۳۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، وَعَطَائٍ ، وَعَمْرِو بْنِ شُعَیْبٍ قَالُوا : لاَ یَأْخُذُ مِنْہَا زَوْجُہَا إلاَّ مَا أَعْطَاہَا۔","","Musannaf Ibn Abi Shaybah 18836","","","كتاب الجنة"
"18837","(۱۸۸۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَرِہَ أَنْ یَأْخُذَ مِنْہَا أَکْثَرَ مِمَّا أَعْطَاہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 18837","","","كتاب الجنة"
"18838","(۱۸۸۳۸) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ عَبْدِالْکَرِیمِ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ؛ أَنَّہُ کَرِہَ أَنْ یَأْخُذَ أَکْثَرَ مِمَّا أَعْطَاہَا۔","","Musannaf Ibn Abi Shaybah 18838","","","كتاب الجنة"
"18839","(۱۸۸۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا ؟ فَکَرِہَا أَنْ یَأْخُذَ مِنْہَا أَکْثَرَ مِمَّا أَعْطَاہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 18839","","","كتاب الجنة"
"18840","(۱۸۸۴۰) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، قَالَ : مَنْ خَلَعَ امْرَأَتَہُ فَأَخَذَ مِنْہَا أَکْثَرَ مِمَّا أَعْطَاہَا ، فَلَمْ یُسَرِّحْ بِإِحْسَانٍ۔","","Musannaf Ibn Abi Shaybah 18840","","","كتاب الجنة"
"18841","(۱۸۸۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ عَمَّارِ بْنِ عِمْرَانَ الْہَمْدَانِیِّ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَرِہَ أَنْ یَأْخُذَ مِنْہَا أَکْثَرَ مِمَّا أَعْطَاہَا۔","Da'if","Musannaf Ibn Abi Shaybah 18841","","","كتاب الجنة"
"18842","(۱۸۸۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ، عَنْ رَجَائِ بْنِ حَیْوَۃَ ؛ أَنَّہُ سَأَلَہُ : کَیْفَ کَانَ الْحَسَنُ یَقُولُ فِی الْمُخْتَلِعَۃِ ؟ فَقَالَ : إنَّہُ کَانَ یَکْرَہُ أَنْ یَأْخُذَ مِنْہَا فَوْقَ مَا أَعْطَاہَا ، فَقَالَ رَجَائٌ : قَالَ قَبِیصَۃُ بْنُ ذُؤَیْبٍ : اقْرَاِ الآیَۃَ الَّتِی بَعْدَہَا : {فَإِنْ خِفْتُمْ أَنْ لاَّ یُقِیمَا حُدُودَ اللہِ فَلاَ جُنَاحَ عَلَیْہِمَا فِیمَا افْتَدَتْ بِہِ}۔","","Musannaf Ibn Abi Shaybah 18842","","","كتاب الجنة"
"18843","(۱۸۸۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ کَثِیرٍ ، مَوْلَی ابْنِ سَمُرَۃَ ؛ أَنَّ عُمَرَ أُتِیَ بِامْرَأَۃٍ نَاشِزٍ ، فَأَمَرَ بِہَا إلَی بَیْتٍ کَثِیرِ الزِّبْلِ ثَلاَثَاً ، ثُمَّ دَعَاہَا ، فَقَالَ : کَیْفَ وَجَدْتِ ؟ فَقَالَتْ : مَا وَجَدْتُ رَاحَۃً مُذْ کُنْتُ عِنْدَہُ ، إلاَّ ہَذِہِ اللَّیَالِیَ الَّتِی حُبِسْتُہَا ، قَالَ : اخْلَعْہَا وَلَوْ مِنْ قُرْطِہَا۔","","Musannaf Ibn Abi Shaybah 18843","","","كتاب الجنة"
"18844","(۱۸۸۴۴) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، قَالَ : حَدَّثَنَا مَطَرٌ ، عَنْ ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ رَبَاحٍ ؛ أَنَّ عُمَرَ قَالَ : اخْلَعْہَا بِمَا دُونَ عِقَاصِہَا۔","","Musannaf Ibn Abi Shaybah 18844","","","كتاب الجنة"
"18845","(۱۸۸۴۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ؛ أَنَّ مَوْلاَۃً لِصَفِیَّۃَ بِنْتِ أَبِی عُبَیْدٍ اخْتَلَعَتْ مِنْ زَوْجِہَا بِکُلِّ شَیْئٍ لَہَا ، حَتَّی اخْتَلَعَتْ بِبَعْضِ ثِیَابِہَا ، فَبَلَغَ ذَلِکَ ابْنَ عُمَرَ فَلَمْ یُنْکِرْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18845","","","كتاب الجنة"
"18846","(۱۸۸۴۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرٍو ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تَخْتَلِعُ حَتَّی بِعِقَاصِہَا۔","","Musannaf Ibn Abi Shaybah 18846","","","كتاب الجنة"
"18847","(۱۸۸۴۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18847","","","كتاب الجنة"
"18848","(۱۸۸۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَأْخُذُ مِنْہَا حَتَّی عِقَاصِہَا۔","","Musannaf Ibn Abi Shaybah 18848","","","كتاب الجنة"
"18849","(۱۸۸۴۹) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ بَأْسَ أَنْ تَخْتَلِعَ الْمَرْأَۃُ مِنْ زَوْجِہَا ، وَإِنْ کَانَ أَکْثَرَ مِمَّا أَعْطَاہَا۔","","Musannaf Ibn Abi Shaybah 18849","","","كتاب الجنة"
"18850","(۱۸۸۵۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی رَجُلٍ بَانَتْ مِنْہُ امْرَأَتُہُ بِخُلْعٍ ، أَوْ إیلاَئٍ ، فَتَزَوَّجَہَا ، ثُمَّ طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا ، قَالَ : لَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 18850","","","كتاب الجنة"
"18851","(۱۸۸۵۱) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ إسْمَاعِیلَ ، وَأَشْعَثَ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ تَطْلِیقَۃً بَائِنَۃً ، ثُمَّ یَتَزَوَّجُہَا فِی عِدَّتِہَا ، ثُمَّ یُطَلِّقُہَا قَبْلَ أَنْ یَدْخُلَ بِہَا ، قَالَ : لَہَا الصَّدَاقُ ، وَعَلَیْہَا عِدَّۃٌ مُسْتَقْبَلَۃٌ۔","","Musannaf Ibn Abi Shaybah 18851","","","كتاب الجنة"
"18852","(۱۸۸۵۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ مِثْلَہُ ، وَقَالَ : وَہُوَ أَمْلَکُ بِرَجْعَتِہَا۔","","Musannaf Ibn Abi Shaybah 18852","","","كتاب الجنة"
"18853","(۱۸۸۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ؛ لَہَا الصَّدَاقُ کَامِلاً ، وَعَلَیْہَا الْعِدَّۃُ کَامِلَۃً۔","","Musannaf Ibn Abi Shaybah 18853","","","كتاب الجنة"
"18854","(۱۸۸۵۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الْمَرْأَۃِ تَبِینُ مِنْ زَوْجِہَا بِتَطْلِیقَۃٍ ، أَوْ تَطْلِیقَتَیْنِ ، ثُمَّ یَتَزَوَّجُہَا ، ثُمَّ یُطَلِّقُہَا قَبْلَ أَنْ یَدْخُلَ بِہَا ، قَالَ : لَہَا نِصْفُ الصَّدَاقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 18854","","","كتاب الجنة"
"18855","(۱۸۸۵۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ سُئِلَ عَنْ رَجُلٍ آلَی مِنِ امْرَأَتِہِ فَبَانَتْ مِنْہُ ، ثُمَّ تَزَوَّجَہَا فِی عِدَّتِہَا ، ثُمَّ طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا ؟ قَالَ : لَہَا نِصْفُ الصَّدَاقِ ، وَلَیْسَ عَلَیْہَا عِدَّۃٌ۔","","Musannaf Ibn Abi Shaybah 18855","","","كتاب الجنة"
"18856","(۱۸۸۵۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، وَمُحَمَّدُ بْنُ سَوَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، وَالْحَسَنِ، قَالاَ : إذَا خَلَعَہَا ثُمَّ تَزَوَّجَہَا فِی عِدَّتِہَا ، ثُمَّ طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا ، فَلَہَا نِصْفُ الصَّدَاقِ ، وَتُکْمِلُ مَا بَقِیَ عَلَیْہَا مِنَ الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 18856","","","كتاب الجنة"
"18857","(۱۸۸۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 18857","","","كتاب الجنة"
"18858","(۱۸۸۵۸) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ؛ فِی الْمُخْتَلِعَۃِ إذَا قَبِلَ مِنْہَا زَوْجُہَا الْفِدْیَۃَ ، ثُمَّ خَطَبَہَا بَعْدَ ذَلِکَ ، قَالَ : یَتَزَوَّجُہَا وَیُسَمِّی لَہَا صَدَاقًا ، فَإِنْ طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا ، فَلَہَا نِصْفُ الصَّدَاقِ ، قَالَ جَعْفَرٌ : وَکَانَ غَیْرُ مَیْمُونٍ یَقُولُ : لَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 18858","","","كتاب الجنة"
"18859","(۱۸۸۵۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ الْعُکْلِیِّ ؛ أَنَّہُ قَالَ : إذَا اخْتَلَعَتِ الْمَرْأَۃُ مِنْ زَوْجِہَا وَہُوَ مَرِیضٌ ، ثُمَّ مَاتَ فِی الْعِدَّۃِ ، فَلاَ مِیرَاثَ لَہَا۔","","Musannaf Ibn Abi Shaybah 18859","","","كتاب الجنة"
"18860","(۱۸۸۶۰) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ؛ مِثْلُ ذَلِک۔","","Musannaf Ibn Abi Shaybah 18860","","","كتاب الجنة"
"18861","(۱۸۸۶۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ، عَنِ ابْنِ لَہِیعَۃَ، عَنْ جَعْفَرِ بْنِ رَبِیعَۃَ الْقُرَشِیِّ، عَنْ تَوْبَۃَ بْنِ نَمِرٍ، عَنْ سِمَاک ابْنِ عِمْرَانَ ؛ أَنَّ عَبْدَ الْمَلِکَ سَأَلَ قَبِیصَۃَ عَنِ الْمُخْتَلِعَۃِ یَتَوَارِثَانِ؟ قَالَ: لاَ، ِلأَنَّہَا افْتَدَتْ بِمَالِہَا طَیِّبۃً بِہِ نَفْسُہَا۔","","Musannaf Ibn Abi Shaybah 18861","","","كتاب الجنة"
"18862","(۱۸۸۶۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، عَنْ أَبِی سَلَمَۃَ ؛ أَنَّ عُثْمَانَ بْنَ عَفَّانَ ، وَزَیْدَ بْنَ ثَابِتٍ قَالاَ فِی الإِیلاَئِ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ ، وَہِیَ أَمْلَکُ بِنَفْسِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 18862","","","كتاب الجنة"
"18863","(۱۸۸۶۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّ النُّعْمَانَ بْنَ بَشِیرٍ آلَی مِنَ امْرَأَتِہِ ، فَقَالَ ابْنُ مَسْعُودٍ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَقَدْ بَانَتْ مِنْہُ بِتَطْلِیقَۃٍ۔","","Musannaf Ibn Abi Shaybah 18863","","","كتاب الجنة"
"18864","(۱۸۸۶۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَن عَبْدِ اللہِ قَالَ : إذَا آلَی ، فَمَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَقَدْ بَانَتْ مِنْہُ بِتَطْلِیقَۃٍ۔","","Musannaf Ibn Abi Shaybah 18864","","","كتاب الجنة"
"18865","(۱۸۸۶۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ قَالاَ : إذَا آلَی فَلَمْ یَفِیئْ حَتَّی تَمْضِیَ الأَرْبَعَۃُ الأَشْہُرُ فَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 18865","","","كتاب الجنة"
"18866","(۱۸۸۶۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِِ ، عَنْ حَبِیبٍ قَالَ : سَأَلْتُ سَعِیدًا أَمِیرَ مَکَّۃَ عَنِ الإِیلاَئِ ؟ فَقَالَ : کَانَ ابْنُ عَبَّاسٍ یَقُولُ : إذَا مَضَتْ أَرَبَعَۃُ أَشْہُرٍ مَلَکَتْ أَمْرَہَا ، وَکَانَ ابْنُ عُمَرَ یَقُولُ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 18866","","","كتاب الجنة"
"18867","(۱۸۸۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : عَزِیمَۃُ الطَّلاَقِ انْقِضَائُ الأَرْبَعَۃِ الأَشْہُرِ ، وَالْفَیْئُ الْجِمَاعُ۔ (بیہقی ۳۷۹)","Hasan","Musannaf Ibn Abi Shaybah 18867","","","كتاب الجنة"
"18868","(۱۸۸۶۸) حَدَّثَنَا حَفْصٌ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ عَلِیٍّ قَالَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 18868","","","كتاب الجنة"
"18869","(۱۸۸۶۹) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، عَنْ قَبِیصَۃَ قَالَ: إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ۔","","Musannaf Ibn Abi Shaybah 18869","","","كتاب الجنة"
"18870","(۱۸۸۷۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ (ح) وَعَنِ سَالِم ، عَن ابْنِ الْحَنَفِیَّۃِ ، قَالاَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ۔","","Musannaf Ibn Abi Shaybah 18870","","","كتاب الجنة"
"18871","(۱۸۸۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ، وَہِیَ أَمْلَکُ بِنَفْسِہَا۔","","Musannaf Ibn Abi Shaybah 18871","","","كتاب الجنة"
"18872","(۱۸۸۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ قَالَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فِی الإِیلاَئِ کَانَتْ تَطْلِیقَۃً بَائِنَۃً ، فَأَخْبَرْتُ شُرَیْحًا بِقَوْلِ مَسْرُوقٍ ، فَقَالَ بِہِ۔","","Musannaf Ibn Abi Shaybah 18872","","","كتاب الجنة"
"18873","(۱۸۸۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ قَالاَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ۔","","Musannaf Ibn Abi Shaybah 18873","","","كتاب الجنة"
"18874","(۱۸۸۷۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَأَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ، قَالاَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فِی الإِیلاَئِ فَہِیَ تَطْلِیقَۃٌ ، وَہُوَ أَحَقُّ بِرَجْعَتِہَا۔","","Musannaf Ibn Abi Shaybah 18874","","","كتاب الجنة"
"18875","(۱۸۸۷۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ مَکْحُولٍ قَالَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ وَاحِدَۃٌ ، وَہُوَ أَمْلَکُ بِہَا۔","","Musannaf Ibn Abi Shaybah 18875","","","كتاب الجنة"
"18876","(۱۸۸۷۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ قَالَ : آلَی ابْنُ أَنَسٍ مِنَ امْرَأَتِہِ ، فَلَبِثَتْ سِتَّۃَ أَشْہُرٍ ، فَبَیْنَمَا ہُوَ جَالِسٌ فِی الْمَجْلِسِ إذْ ذکر ، فَأَتَی ابْنُ مَسْعُودٍ فَقَالَ : أَعْلِمْہَا أَنَّہَا قَدْ مَلَکَتْ أَمْرَہَا ، فَأَتَاہَا فَأَخْبَرَہَا ، فَقَالَتْ : فَأَنَا أَہْلُکَ ، وَأَصْدَقَہَا رِطْلاً۔","Sahih","Musannaf Ibn Abi Shaybah 18876","","","كتاب الجنة"
"18877","(۱۸۸۷۷) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ جَرِیرٍ ، قَالَ : قرَأْتُ فِی کِتَابِ أَبِی قِلاَبَۃَ عِنْدَ أَیُّوبَ : سَأَلْتُ أَبَا سَلَمَۃَ ، وَسَالِمًا عَنِ الإِیلاَئِ ؟ فَقَالاَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ۔","","Musannaf Ibn Abi Shaybah 18877","","","كتاب الجنة"
"18878","(۱۸۸۷۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ قَالَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ ، وَیَخْطُبُہَا زَوْجُہَا فِی عِدَّتِہَا ، وَلاَ یَخْطُبُہَا غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 18878","","","كتاب الجنة"
"18879","(۱۸۸۷۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ الشَّعْبِیِّ ، عَنْ عَمْرِو بْنِ سَلِمَۃَ بْنِ حَرْبٍ ؛ أَنَّ عَلِیًّا کَانَ یُوقِفُہُ بَعْدَ الأَرْبَعَۃِ حَتَّی یُبَیِّنَ رَجْعَۃً ، أَوْ طَلاَقًا۔","Sahih","Musannaf Ibn Abi Shaybah 18879","","","كتاب الجنة"
"18880","(۱۸۸۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ؛ أَنَّ عَلِیًّا أَوْقَفَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18880","","","كتاب الجنة"
"18881","(۱۸۸۸۱) حَدَّثَنَا ابْنُ إدْرِیسَ ؛ عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ مَرْوَانَ ، عَنْ عَلِیٍّ ، قَالَ : یُوقَفُ عِنْدَ الأَرْبَعَۃِ حَتَّی یُبَیِّنَ طَلاَقًا ، أَوْ رَجْعَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 18881","","","كتاب الجنة"
"18882","(۱۸۸۸۲) حَدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ مَرْوَانَ ، عَنْ عَلِیٍّ قَالَ : أَمَّا أَنَا فَکُنْتُ أُوقِفُہُ بَعْدَ الأَرْبَعَۃِ ، فَإِمَّا أَنْ یَفِیئَ ، وَإِمَّا أَنْ یُطَلِّقَ ، وَقَالَ مَرْوَانُ : لَوْ وُلِّیتُ لَفَعَلْتُ مِثْلَ مَا یَفْعَلُ۔","Da'if","Musannaf Ibn Abi Shaybah 18882","","","كتاب الجنة"
"18883","(۱۸۸۸۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، وَوَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ طَاوُوسٍ ، عَنْ عُثْمَانَ ؛ أَنَّہُ کَانَ یَقُولُ بِقَوْلِ أَہْلِ الْمَدِینَۃِ : یُوقَفُ۔","","Musannaf Ibn Abi Shaybah 18883","","","كتاب الجنة"
"18884","(۱۸۸۸۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ؛ أَنَّ مَرْوَانَ أَوْقَفَہُ بَعْدَ سِتَّۃَ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 18884","","","كتاب الجنة"
"18885","(۱۸۸۸۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ بِضْعَۃَ عَشَرَ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالُوا : یُوقَفُ۔","Sahih","Musannaf Ibn Abi Shaybah 18885","","","كتاب الجنة"
"18886","(۱۸۸۸۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الإِیلاَئِ ؟ فَقَالَ : الأُمَرَائُ یَقْضُونَ فِی ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 18886","","","كتاب الجنة"
"18887","(۱۸۸۸۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ مُجَاہِدٍ (ح) وَعَنِ ابْنِ طَاوُوسٍ عَنْ أَبِیہِ، قالُوا: فِی الإِیلاَئِ یُوقَفُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18887","","","كتاب الجنة"
"18888","(۱۸۸۸۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ دَاوُدَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ فِی الْمُوْلِی : یُوقَفُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18888","","","كتاب الجنة"
"18889","(۱۸۸۸۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ یَحِلُّ لَہُ أَنْ یَفْعَلَ إلاَّ مَا أَمَرَہُ اللَّہُ ، إمَّا أَنْ یَفِیئَ ، وَإِمَّا أَنْ یَعْزِمَ۔","Sahih","Musannaf Ibn Abi Shaybah 18889","","","كتاب الجنة"
"18890","(۱۸۸۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ فُرَاتٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : سَمِعْتُ عَائِشَۃَ تَقُولُ : یُوقَفُ الْمُوْلِی۔","Hasan","Musannaf Ibn Abi Shaybah 18890","","","كتاب الجنة"
"18891","(۱۸۸۹۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا آلَی الرَّجُلُ مِنِ امْرَأَتِہِ وُقِفَ قَبْلَ أَنْ تَمْضِیَ الأَرْبَعَۃُ الأَشْہُرِ فَیُقَالُ لَہُ : اتَّقِ اللَّہَ فَإِمَّا أَنْ یَفِیئَ ، وَإِمَّا أَنْ تُطَلِّقَ طَلاَقًا یُعْرَفُ۔","","Musannaf Ibn Abi Shaybah 18891","","","كتاب الجنة"
"18892","(۱۸۸۹۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 18892","","","كتاب الجنة"
"18893","(۱۸۸۹۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : یُوقَفُ الْمُوْلِی عِنْدَ انْقِضَائِ الأَرْبَعَۃِ ، فَإِنْ فَائَ فَہِیَ امْرَأَتُہُ ، وَإِنْ لَمْ یَفِیئْ فَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ۔","","Musannaf Ibn Abi Shaybah 18893","","","كتاب الجنة"
"18894","(۱۸۸۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَإِمَّا أَنْ یَفِیئَ ، وَإِمَّا أَنْ یُطَلِّقَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18894","","","كتاب الجنة"
"18895","(۱۸۸۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطَرٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ قَالَ : الإِیلاَئُ لَیْسَ بِشَیْئٍ ، یُوقَفُ۔","","Musannaf Ibn Abi Shaybah 18895","","","كتاب الجنة"
"18896","(۱۸۸۹۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَنْظَلَۃَ ، قَالَ : سَمِعْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ وَسُئِلَ عَنِ الإِیلاَئِ ؟ قَالَ : یُوقَفُ فَیُقَالُ لِلَّذِی یَسْأَلُہُ : ہَلْ طَلَّقْتَ ؟ قَالَ : لاَ ، وَلَکِنْ یَدْعُو الإِمَامُ فَإِمَّا أَنْ یَفِیئَ ، وَإِمَّا أَنْ یُفَارِقَ۔","","Musannaf Ibn Abi Shaybah 18896","","","كتاب الجنة"
"18897","(۱۸۸۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلِزٍ ؛ أَنَّہُ کَانَ لاَ یَجْعَلُ فِی الإِیلاَئِ طَلاَقًا۔","","Musannaf Ibn Abi Shaybah 18897","","","كتاب الجنة"
"18898","(۱۸۸۹۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ الإِیلاَئِ ؟ فَقَالَ : لَیْسَ بِشَیْئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 18898","","","كتاب الجنة"
"18899","(۱۸۸۹۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ أَبَانَ الْعَطَّارِ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی الدَّرْدَائِ قَالَ : الإِیلاَئُ مَعْصِیَۃٌ ، وَلاَ تَحْرُم عَلَیْہِ امْرَأَتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18899","","","كتاب الجنة"
"18900","(۱۸۹۰۰) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ قَالَ : قرَأْتُ فِی کِتَابِ أَبِی قِلاَبَۃَ عِنْدَ أَیُّوبَ : سَأَلْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ ، وَسَعِیدَ بْنَ الْمُسَیَّبِ ؟ فَقَالاَ : مَعْصِیَۃٌ ، وَلَیْسَ بِطَلاَقٍ۔","","Musannaf Ibn Abi Shaybah 18900","","","كتاب الجنة"
"18901","(۱۸۹۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ (ح) وَعَنْ سَالِمٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالاَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فِی الإِیلاَئِ فَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ ، وَعَلَیْہَا أَنْ تَعْتَدَّ ثَلاَثَۃَ قُرُوئٍ۔","","Musannaf Ibn Abi Shaybah 18901","","","كتاب الجنة"
"18902","(۱۸۹۰۲) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ عَلِیِّ بْنِ بَذِیمَۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ بَائِنٌ ، وَتَعْتَدُّ بَعْدَ ذَلِکَ ثَلاَثَ حِیَضٍ۔","","Musannaf Ibn Abi Shaybah 18902","","","كتاب الجنة"
"18903","(۱۸۹۰۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ قَالاَ : تَعْتَدُّ بَعْدَ أَرْبَعَۃِ أَشْہُرٍ عِدَّۃَ الْمُطَلَّقَۃِ۔","","Musannaf Ibn Abi Shaybah 18903","","","كتاب الجنة"
"18904","(۱۸۹۰۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ قَالاَ : إذَا آلَی الرَّجُلُ مِنِ امْرَأَتِہِ فَمَضَتْ أَرْبَعَۃُ أَشْہُرٍ ، فَإِنَّہَا تَعْتَدُّ بَعْدَ ذَلِکَ ثَلاَثَۃَ أَشْہُرٍ ، إذَا کَانَتْ لاَ تَحِیضُ۔","","Musannaf Ibn Abi Shaybah 18904","","","كتاب الجنة"
"18905","(۱۸۹۰۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ قَالَ : إذَا آلَی الرَّجُلُ مِنِ امْرَأَتِہِ فَمَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ ، وَتَسْتَقْبِلُ الْعِدَّۃَ۔","","Musannaf Ibn Abi Shaybah 18905","","","كتاب الجنة"
"18906","(۱۸۹۰۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : لَیْسَ عَلَیْہَا عِدَّۃٌ۔","","Musannaf Ibn Abi Shaybah 18906","","","كتاب الجنة"
"18907","(۱۸۹۰۷) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ آلَی مِنِ امْرَأَتِہِ حَتَّی مَضَتْ أَرْبَعَۃُ أَشْہُرٍ کَیْفَ تَعْتَدُّ ؟ قَالَ : تَعْتَدُّ ثَلاَثَۃَ قُرُوئٍ۔","","Musannaf Ibn Abi Shaybah 18907","","","كتاب الجنة"
"18908","(۱۸۹۰۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ عَامِرٍ الأَحْوَلِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : إذَا آلَی مِنِ امْرَأَتِہِ شَہْرًا ، أَوْ شَہْرَیْنِ ، أَوْ ثَلاَثَۃً ، مَا لَمْ یَبْلُغِ الْحَدَّ فَلَیْسَ بِإِیلاَئٍ۔","Da'if","Musannaf Ibn Abi Shaybah 18908","","","كتاب الجنة"
"18909","(۱۸۹۰۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ قَالَ : إذَا حَلَفَ عَلَی دُونِ الأَرْبَعَۃِ فَلَیْسَ بِإِیلاَئٍ۔","","Musannaf Ibn Abi Shaybah 18909","","","كتاب الجنة"
"18910","(۱۸۹۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، وَعَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالاَ : إذَا حَلَفَ عَلَی دُونِ الأَرْبَعَۃِ فَلَیْسَ بِإِیلاَئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 18910","","","كتاب الجنة"
"18911","(۱۸۹۱۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ؛ فِی رَجُلٍ حَلَفَ أَنْ لاَ یَقْرَبَ امْرَأَتَہُ ثَلاَثَۃَ أَشْہُرٍ ، فَتَرَکَہَا حَتَّی مَضَتْ أَرْبَعَۃُ أَشْہُرٍ ، قَالَ : لاَ یَکُونُ مُولِیًا۔","","Musannaf Ibn Abi Shaybah 18911","","","كتاب الجنة"
"18912","(۱۸۹۱۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ وَبَرَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّ رَجُلاً آلَی مِنِ امْرَأَتِہِ عشرًا ، فَأَوْقَعَہُ عَلَیْہِ عَبْدُ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 18912","","","كتاب الجنة"
"18913","(۱۸۹۱۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ قَالاَ : إذَا آلَی الرَّجُلُ مِنِ امْرَأَتِہِ شَہْرًا ، ثُمَّ تَرَکَہَا حَتَّی تَمْضِیَ أَرْبَعَۃُ أَشْہُرٍ ، إنَّہَا تَطْلِیقَۃٌ بَائِنَۃٌ","","Musannaf Ibn Abi Shaybah 18913","","","كتاب الجنة"
"18914","(۱۸۹۱۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ قَالَ : إذَا قَالَ الرَّجُلُ لامْرَأَتِہِ : وَاللَّہِ لاَ أَقْرَبُک الْیَوْمَ ، فَتَرَکَہَا أَرْبَعَۃَ أَشْہُرٍ فَہُوَ إیلاَئٌ۔","","Musannaf Ibn Abi Shaybah 18914","","","كتاب الجنة"
"18915","(۱۸۹۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا حَلَفَ عَلَی دُونِ أَرْبَعَۃٍ فَہُوَ مُولٍ۔","","Musannaf Ibn Abi Shaybah 18915","","","كتاب الجنة"
"18916","(۱۸۹۱۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ؛ فِی الرَّجُلِ یَحْلِفُ أَنْ لاَ یَقْرَبَ امْرَأَتَہُ شَہْرًا قَالَ : ہُوَ مُولٍ۔","","Musannaf Ibn Abi Shaybah 18916","","","كتاب الجنة"
"18917","(۱۸۹۱۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَن أَبِی الشَّعْثَائِ قَالَ : آلَی رَجُلٌ مِنَ الْحَیِّ فَنُفِسَتِ امْرَأَتُہُ قَالَ : فَسَأَلَت عَلْقَمَۃَ وَالأَسْوَدَ وَمَسْرُوقًا فَقَالُوا : إذَا فَائَ بِلِسَانِہِ فَقَدْ فَائَ۔","","Musannaf Ibn Abi Shaybah 18917","","","كتاب الجنة"
"18918","(۱۸۹۱۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ رَجُلٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا آلَی الرَّجُلُ مِنِ امْرَأَتِہِ فَمَنَعَہُ مِنْ جِمَاعِہَا مَرَضٌ ، أَوْ شُغْلٌ ، أَوْ عُذْرٌ مِنْہُ ، أَوْ مِنْہَا ، وَأَشْہَدَ عَلَی فَیْئِہِ أَجْزَأَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 18918","","","كتاب الجنة"
"18919","(۱۸۹۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ قَالَ : إذَا رَاجَعَ بِلِسَانِہِ فَہِی رَجْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 18919","","","كتاب الجنة"
"18920","(۱۸۹۲۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ فِی الْمُولِی : إذَا کَانَ مَرِیضًا ، أَوْ کَانَ مُسَافِرًا ، أَوْ کَانَتْ حَائِضًا أَشْہَدَ عَلَی فَیْئِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 18920","","","كتاب الجنة"
"18921","(۱۸۹۲۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَعِکْرِمَۃَ قَالاَ : إذَا کَانَ لَہُ عُذْرٌ یُعْذَرُ بِہِ فَأَشْہَدَ أَنَّہُ قَدْ فَائَ إلیہا فَذَلِکَ لَہُ۔","","Musannaf Ibn Abi Shaybah 18921","","","كتاب الجنة"
"18922","(۱۸۹۲۲) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : إذَا آلَی الرَّجُلُ مِنَ امْرَأَتِہِ فَأَشْہَدَ أَنَّہُ قَدْ فَائَ فَذَلِکَ لَہُ۔","","Musannaf Ibn Abi Shaybah 18922","","","كتاب الجنة"
"18923","(۱۸۹۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : الْفَیْئُ الْجِمَاعُ۔","Sahih","Musannaf Ibn Abi Shaybah 18923","","","كتاب الجنة"
"18924","(۱۸۹۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : عَزِیمَۃُ الطَّلاَقِ انْقِضَائُ أَرْبَعَۃِ أَشْہُرٍ وَالْفَیْئُ الْجِمَاعُ۔","Hasan","Musannaf Ibn Abi Shaybah 18924","","","كتاب الجنة"
"18925","(۱۸۹۲۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنِ الشَّعْبِیِّ وَالْحَکَمِ قَالاَ : لاَ فَیْئَ إِلاَّ الْجِمَاعُ۔","","Musannaf Ibn Abi Shaybah 18925","","","كتاب الجنة"
"18926","(۱۸۹۲۶) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ فَیْئَ إلاَّ الْجِمَاعُ۔","","Musannaf Ibn Abi Shaybah 18926","","","كتاب الجنة"
"18927","(۱۸۹۲۷) حَدَّثَنَا حَفْصٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ قَالَ : لاَ فَیْئَ إلاَّ الْجِمَاعُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18927","","","كتاب الجنة"
"18928","(۱۸۹۲۸) حَدَّثَنَا حَفْصٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ قَالَ : الْفَیْئُ الْجِمَاعُ۔","","Musannaf Ibn Abi Shaybah 18928","","","كتاب الجنة"
"18929","(۱۸۹۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ بَذِیمَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : الْفَیْئُ الْجِمَاعُ۔","","Musannaf Ibn Abi Shaybah 18929","","","كتاب الجنة"
"18930","(۱۸۹۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ، وَابْنِ مَسْعُودٍ ، وَابْنِ عَبَّاسٍ قَالُوا : الْفَیْئُ الْجِمَاعُ ، وَقَالَ ابْنُ مَسْعُودٍ : فَإِنْ کَانَ بِہِ عِلَّۃٌ مِنْ کِبَرٍ ، أَوْ مَرَضٍ ، أَوْ حَبْسٍ یَحُولُ بَیْنَہُ وَبَیْنَ الْجِمَاعِ ، فَإِنَّ فَیْئِہِ أَنْ یَفِیئَ بِقَلْبِہِ وَلِسَانِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 18930","","","كتاب الجنة"
"18931","(۱۸۹۳۱) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ خُصَیْفٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ أَنَّہُ سَأَلَہُ عَنْ رَجُلٍ آلَی مِنَ امْرَأَتِہِ فَقَالَ یَنَالُ مِنْہَا مَا یَنَالُ الرَّجُلُ مِنَ امْرَأَتِہِ إلاَّ أَنَّہ لم یُجَامِعَہَا فَإِنْ مَضَتْ أَرْبَعَۃُ أَشْہُرٍ قَبْلَ أَنْ یُجَامِعَہَا فَہِیَ طَالِقٌ بَائِنٌ۔","","Musannaf Ibn Abi Shaybah 18931","","","كتاب الجنة"
"18932","(۱۸۹۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ قَالَ : الْفَیْئُ الْجِمَاعُ۔","","Musannaf Ibn Abi Shaybah 18932","","","كتاب الجنة"
"18933","(۱۸۹۳۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ فِی الإِیلاَئِ مِنَ الأَمَۃِ : إذَا مَضَی شَہْرَانِ ، وَلَمْ یَفِیئْ زَوْجُہَا ، فَقَدْ وَقَعَ الإِیلاَئُ۔","","Musannaf Ibn Abi Shaybah 18933","","","كتاب الجنة"
"18934","(۱۸۹۳۴) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِیمَنْ آلَی مِنْ أَمَۃٍ قَالَ : إیلاَؤُہَا شَہْرَانِ۔","","Musannaf Ibn Abi Shaybah 18934","","","كتاب الجنة"
"18935","(۱۸۹۳۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ قَالَ : إِیلاَئُ الأَمَۃِ نِصْفُ إِیلاَئِ الْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 18935","","","كتاب الجنة"
"18936","(۱۸۹۳۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18936","","","كتاب الجنة"
"18937","(۱۸۹۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ فِی الْحُرِّ إذَا آلَی مِنَ الْأَمَۃِ ، أَوْ طَلَّقَہا فَعِدَّتُہَا نِصْفُ عِدَّۃِ الْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 18937","","","كتاب الجنة"
"18938","(۱۸۹۳۸) حَدَّثَنَا شَبَابَۃُ قَالَ : حدَّثَنَا شُعْبَۃُ قَالَ : سَأَلْتُ الْحَکَمَ عَمَّنْ یُولِی مِنَ الْأَمَۃِ فَقَالَ : قَالَ إبْرَاہِیمُ : عِدَّتُہَا شَہْرَانِ ، وَسَأَلْت حَمَّادًا فَقَالَ مِثْلَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18938","","","كتاب الجنة"
"18939","(۱۸۹۳۹) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ قَالَ: إذَا آلَی، ثُمَّ طَلَّقَ، أَوْ طَلَّقَ، ثُمَّ آلَی ہَدَمَ الطَّلاَقُ الإِیلاَئَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18939","","","كتاب الجنة"
"18940","(۱۸۹۴۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ قَالَ : ہُمَا کَفَرَسَیْ رِہَانٍ ، أَیُّہُمَا سَبَقَ أُخِذَتْ بِہِ ، وَإِنْ وَقَعَا جَمِیعًا أُخِذَتْ بِہِما۔","","Musannaf Ibn Abi Shaybah 18940","","","كتاب الجنة"
"18941","(۱۸۹۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ مِثْلَ قَوْلِ الشَّعْبِیِّ۔","","Musannaf Ibn Abi Shaybah 18941","","","كتاب الجنة"
"18942","(۱۸۹۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یُولِی مِنِ امْرَأَتِہِ ، ثُمَّ یُطَلِّقُ قَالَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ ، قَبْلَ أَنْ تَحِیضَ ثَلاَثَ حِیَضٍ ، فَقَدْ بَانَتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 18942","","","كتاب الجنة"
"18943","(۱۸۹۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : یَہْدِمُ الطَّلاَقُ الإِیلاَئَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18943","","","كتاب الجنة"
"18944","(۱۸۹۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : یَہْدِمُ الطَّلاَقُ الإِیلاَئَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18944","","","كتاب الجنة"
"18945","(۱۸۹۴۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ قَالَ : یَہْدِمُ الطَّلاَقُ الإِیلاَئَ وَقَالَ عَلِیٌّ: ہُمَا کَفَرَسَیْ رِہَانٍ۔","","Musannaf Ibn Abi Shaybah 18945","","","كتاب الجنة"
"18946","(۱۸۹۴۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : الإِیلاَئُ فِی الرِّضَا وَالْغَضَبِ۔","","Musannaf Ibn Abi Shaybah 18946","","","كتاب الجنة"
"18947","(۱۸۹۴۷) حَدَّثَنَا أَبُو الْأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ حُرَیْث بن عَمِیرَۃَ ، عَنْ أُمِّ عَطِیَّۃَ قَالَتْ : قَالَ جُبَیْرٌ لامْرَأَتِہِ : إن ابْنَ أَخِی مَعَ ابْنِکَ ، فَقَالَتْ : مَا أَسْتَطِیعُ أَنْ أُرْضِعَ اثْنَیْنِ ، قَالَ : فَحَلَفَ أَنْ لاَ یَقْرَبَہَا حَتَّی تَفْطِمَہُ قَالَ : فَلَمَّا فَطَمُوہُ مُرَّ بِہِ عَلَی الْمَجْلِسِ فَقَالَ الْقَوْمُ : حَسَنٌ مَا غَذَوْتُمُوہُ قَالَ : فَقَالَ جُبَیْرٌ : إنِّی حَلَفْت أَنْ لاَ أَقْرَبَہَا حَتَّی تَفْطِمَہُ ، قَالَ : فَقَالَ الْقَوْمُ : ہَذَا إیلاَئٌ ، فَقَالَ لَہُ عَلِیٌّ : إِنْ کُنْتَ فَعَلْتَ ذَلِکَ غَضَبًا ، فَلاَ تَحِلُّ لَکَ امْرَأَتُکَ ، وَإِلاَّ فَہِیَ امْرَأَتُکَ۔","Da'if","Musannaf Ibn Abi Shaybah 18947","","","كتاب الجنة"
"18948","(۱۸۹۴۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ زُبَیْدٍ عَمَّنْ حَدَّثَہُ ، عَنْ عَلِیٍّ قَالَ : إنَّمَا الإِیلاَئُ فِی الْغَضَبِ۔","Da'if","Musannaf Ibn Abi Shaybah 18948","","","كتاب الجنة"
"18949","(۱۸۹۴۹) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْقَعْقَاعِ بْنِ یَزِیدَ قَالَ : سَأَلْتُ الْحَسَنَ ، عَنِ الإِیلاَئِ فَقَالَ : إنَّمَا الإِیلاَئُ مَا کَانَ فِی الْغَضَبِ ، قَالَ : وَسَأَلْتُ ابْنَ سِیرِینَ فَقَالَ : مَا أَدْرِی مَا ہَذَا ؟ وَتَلاَ آیَۃَ الإِیلاَئِ۔","No Data Available","Musannaf Ibn Abi Shaybah 18949","","","كتاب الجنة"
"18950","(۱۸۹۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَعَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ حَلَفَ أَلاَّ یَقْرَبُ امْرَأَتَہُ حَتَّی تَفْطِمَ صَبِیَّہَا ، قَالاَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَقَدْ دَخَلَ الإِیلاَئُ۔","","Musannaf Ibn Abi Shaybah 18950","","","كتاب الجنة"
"18951","(۱۸۹۵۱) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : الإِیلاَئُ فِی الرِّضَی وَالْغَضَبِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 18951","","","كتاب الجنة"
"18952","(۱۸۹۵۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ جَابِرِ بْنِ زَیْدٍ، عَنِ ابْنِ عَبَّاسٍ قَالَ: لاَ إیلاَئَ إلاَّ بِحَلَفٍ۔","Da'if","Musannaf Ibn Abi Shaybah 18952","","","كتاب الجنة"
"18953","(۱۸۹۵۳) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : الإِیلاَئُ لاَ یَکُونُ إلاَّ بِحَلَفٍ عَلَی الْجِمَاعِ۔","","Musannaf Ibn Abi Shaybah 18953","","","كتاب الجنة"
"18954","(۱۸۹۵۴) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ أَبِی حُرَّۃَ قَالَ : سَأَلْتُ الْحَسَنَ عَنْ رَجُلٍ ہَجَرَ امْرَأَتَہُ سَبْعَۃَ أَشْہُرٍ قَالَ : قَدْ َطَالَ الْہِجْرَانَ ، قُلْتُ : یَدْخُلُ عَلَیْہِ الإِیلاَئُ ؟ قَالَ : حَلَفَ ؟ قُلْتُ : لاَ ، قَالَ : لاَ إیلاَئَ إلاَّ بِیَمِین۔","","Musannaf Ibn Abi Shaybah 18954","","","كتاب الجنة"
"18955","(۱۸۹۵۵) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ لاَ إیلاَئَ إلاَّ أَنْ یَحْلِفَ۔","","Musannaf Ibn Abi Shaybah 18955","","","كتاب الجنة"
"18956","(۱۸۹۵۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : کُلُّ یَمِینٍ مَنَعَتْ جِمَاعًا حَتَّی تَمْضِیَ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ إیلاَئٌ۔","","Musannaf Ibn Abi Shaybah 18956","","","كتاب الجنة"
"18957","(۱۸۹۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنْ رَجُلٍ ہَجَرَ امْرَأَتَہُ فَمَضَتْ أَرْبَعَۃُ أَشْہُرٍ قَالَ : لاَ تَحْرِمُ عَلَیْہِ إلاَّ أَنْ یَکُونَ أَقْسَمَ بِاللَّہِ لاَ یَمَسُّہَا ، وَلاَ یُصَالِحُہَا ، فَإِنْ أَقْسَمَ عَلَی ذَلِکَ وَلَمْ یُرَاجِعْ حَتَّی تَمْضِیَ أَرْبَعَۃُ أَشْہُرٍ فَقَدْ بَانَتْ مِنْہُ ، وَہِیَ الْأَلِیَّۃُ۔","","Musannaf Ibn Abi Shaybah 18957","","","كتاب الجنة"
"18958","(۱۸۹۵۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ قَالَ : لاَ إیلاَئَ إلاَّ أَنْ یَحْلِفَ۔","No Data Available","Musannaf Ibn Abi Shaybah 18958","","","كتاب الجنة"
"18959","(۱۸۹۵۹) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ قَالَ : کُلُّ یَمِینٍ مَنَعَتْ جِمَاعًا فَہِیَ إیلاَئٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18959","","","كتاب الجنة"
"18960","(۱۸۹۶۰) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : کُلُّ یَمِینٍ مَنَعَتْ جِمَاعًا فَہِیَ إیلاَئٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 18960","","","كتاب الجنة"
"18961","(۱۸۹۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ: إذَا انْقَضَتْ عِدَّۃُ الإِیلاَئِ فطلق ، فَإِنَّہُ لاَ یَعُدُّہُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 18961","","","كتاب الجنة"
"18962","(۱۸۹۶۲) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ قَالَ: إذَا قَالَ الرَّجُلُ لاِمْرَأَتِہِ وَہِیَ تَعْتَدُّ مِنْہُ فِی الإیلاَئِ، أَوْ طَلاَقٍ: ہِیَ طَالِقٌ ، فَإِنَّ طلاقہ ذَلِکَ جَائِزٌ عَلَیْہَا ، فَإِذَا قَالَ : أَنْتِ طَالِقٌ بَعْدَ مَا انْقَضَتْ عِدَّتُہَا فَلَیْسَ بِشَیْئٍ ، یُطَلِّقُ مَا لاَ یَمْلِکُ۔","","Musannaf Ibn Abi Shaybah 18962","","","كتاب الجنة"
"18963","(۱۸۹۶۳) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ یُونُسَ، عَنِ الْحَسَنِ سُئِلَ عَنْ إیلاَئِ الْعَبْدِ مِنَ الْحُرَّۃِ فَقَالَ: تَرَبُّصُ أَرْبَعَۃَ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 18963","","","كتاب الجنة"
"18964","(۱۸۹۶۴) حَدَّثَنَا أَبُو عِصَامٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ قَالَ : إیلاَئُ الْعَبْدِ عَلَی النِّصْفِ مِنْ إیلاَئِ الْحُرِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 18964","","","كتاب الجنة"
"18965","(۱۸۹۶۵) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ عَلِیِّ بْنِ بَذِیمَۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : لاَ یَخْطُبُہَا فِی عِدَّتِہَا غَیْرُہُ فَإِذَا انْقَضَتْ عِدَّتُہَا کَانَ ہُوَ وَالنَّاسُ سَوَائً۔","","Musannaf Ibn Abi Shaybah 18965","","","كتاب الجنة"
"18966","(۱۸۹۶۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ومحمد قَالَ : یَخْطُبُہَا ہُوَ فِی عِدَّتِہَا وَلاَ یَخْطُبُہَا غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 18966","","","كتاب الجنة"
"18967","(۱۸۹۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ قَالَ : کَانُوا یَقُولُونَ ، أَوْ یَتَحَدَّثُونَ فِی الإِیلاَئِ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ وَیَخْطُبُہَا فِی عِدَّتِہَا إِنْ شَائَ ، قَالَ ابْنُ عَوْنٍ : فَقُلْت لِمُحَمَّدٍ إنَّ عَامِرًا یَقُولُ : یَخْطُبُہَا فِی عِدَّتِہَا وَلاَ یَخْطُبُہَا غَیْرُہُ ، قَالَ : صَدَقَ عَامِرٌ۔","","Musannaf Ibn Abi Shaybah 18967","","","كتاب الجنة"
"18968","(۱۸۹۶۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ أَنَّہُ سَمِعَ الشَّعْبِیَّ یُحَدِّثُ أَنَّہُ سَمِعَ مَسْرُوقًا قَالَ : إذَا مَضَتْ أَرْبَعَۃُ أَشْہُرٍ فَہِیَ وَاحِدَۃٌ بَائِنَۃٌ وَیَخْطُبُہَا زَوْجُہَا فِی عِدَّتِہَا وَلاَ یَخْطُبُہَا غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 18968","","","كتاب الجنة"
"18969","(۱۸۹۶۹) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ قَالَ : لاَ تَعْتَدُّ مِنْ زَوْجِہَا إذَا أَرَادَ أَنْ یَتَزَوَّجَہَا وَلَکِنْ تَعْتَدُّ مِنَ النَّاسِ ثَلاَثَۃَ قُرُوئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 18969","","","كتاب الجنة"
"18970","(۱۸۹۷۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : لِلْمُطَلَّقَۃِ ثَلاَثًا وَہِیَ حَامِلٌ وَلِلْمُولَی عَنْہَا وَہِیَ حَامِلٌ النَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 18970","","","كتاب الجنة"
"18971","(۱۸۹۷۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : لِلْمُطَلَّقَۃِ ثَلاَثًا وَالْمُولَی عَنْہَا وَالْمُخْتَلِعَۃِ وَالْمُلاَعَنَۃِ وَہُنَّ حَوَامِلُ لَہُنَّ النَّفَقَۃُ إلاَّ أَنْ یُشْتَرَطَ ذَلِکَ عَلَی الْمُخْتَلِعَۃِ۔","","Musannaf Ibn Abi Shaybah 18971","","","كتاب الجنة"
"18972","(۱۸۹۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَعَاسَرَہُ أَہْلُہَا فَحَلَفَ أَنْ لاَ یَبْنِیَ بِہَا ، قَالَ الزُّہْرِیُّ : لاَ إیلاَئَ إلاَّ بَعْدَ دُخُولٍ۔","","Musannaf Ibn Abi Shaybah 18972","","","كتاب الجنة"
"18973","(۱۸۹۷۳) حَدَّثَنَا أَبُو عَاصِمٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : إذَا آلَی مِنْہَا قَبْلَ أَنْ یَدْخُلَ بِہَا فَلَیْسَ بِإِیلاَئٍ ، قُلْتُ : وَإِنْ کَانَ عَلَی جِمَاعِہَا قَادِرًا ؟ قَالَ ، وَإِنْ کَانَ عَلَی جِمَاعِہَا قَادِرًا۔","","Musannaf Ibn Abi Shaybah 18973","","","كتاب الجنة"
"18974","(۱۸۹۷۴) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ أَبِی ہَاشِمٍ فِی رَجُل قَالَ لامْرَأَتِہِ : وَاللَّہِ لاَ أَبْنِی بِامْرَأَتِی فِی ہَذَا الْبَیْتِ ، ثُمَّ تَرَکَہَا حَتَّی مَضَتْ أَرْبَعَۃُ أَشْہُرٍ ، قَالَ : ہُوَ إیلاَئٌ وَقَالَ حَمَّادٌ : لَیْسَ بِإِیلاَئٍ۔","","Musannaf Ibn Abi Shaybah 18974","","","كتاب الجنة"
"18975","(۱۸۹۷۵) حَدَّثَنَا وَکِیعٌ حدَّثَنَا إسْمَاعِیلُ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِیہِ ، عَنْ مُجَاہِدٍ أَنَّ ابْنَ الزُّبَیْرِ تَزَوَّجَ امْرَأَۃً فَاسْتَزَادُوہُ فِی الْمَہْرِ فَحَلَفَ أَنْ لاَ یَزِیدَہُمْ وَلاَ یَدْخُلَ بِہَا حَتَّی یَکُونُوا ہُمَ الَّذِینَ یَطْلُبُونَ ذَلِکَ مِنْہُ قَالَ : فَتَرَکَہَا سِنِینَ ، ثُمَّ طَلَبُوا إلَیْہِ فَدَخَلَ بِہَا فَلَمْ یَرَہُ إیلاَئً ، قَالَ وَکِیعٌ : وَہُوَ قَوْلُ سُفْیَانَ وَکَذَلِکَ نَقُولُ۔","Da'if","Musannaf Ibn Abi Shaybah 18975","","","كتاب الجنة"
"18976","(۱۸۹۷۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ وَمُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ قَالَ: لاَ نجیز قَوْلُ الْمَرْأَۃِ فِی دِینِ اللہِ ، الْمُطَلَّقَۃُ ثَلاَثًا لَہَا السُّکْنَی وَالنَّفَقَۃُ ، زَادَ ابْنُ فُضَیْلٍ : وَقَالَتْ عَائِشَۃُ : مَا لَہَا فِی أَنْ تَذْکُرَ ہَذَا خَیْرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 18976","","","كتاب الجنة"
"18977","(۱۸۹۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عُمَرَ ، وَعَبْدِ اللہِ قَالاَ : لَہَا السُّکْنَی وَالنَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 18977","","","كتاب الجنة"
"18978","(۱۸۹۷۷) حضرت عمر اور حضرت عبد اللہwفرماتے ہیں کہ تین طلاق??ں دی گئی عورت کو رہائش اور نفقہ ملے گا۔","","Musannaf Ibn Abi Shaybah 18978","","","كتاب الجنة"
"18979","(۱۸۹۷۹) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ السُّدِّیِّ ، عَنْ إبْرَاہِیمَ والشَّعْبِیِّ قَالَ : لَہَا السُّکْنَی وَالنَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 18979","","","كتاب الجنة"
"18980","(۱۸۹۸۰) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : لِلْمُطَلَّقَۃِ النَّفَقَۃُ مَا لَمْ تَحْرُمْ فَإِذَا حَرُمَتْ فَلَہَا مَتَاعٌ بِالْمَعْرُوفِ۔","","Musannaf Ibn Abi Shaybah 18980","","","كتاب الجنة"
"18981","(۱۸۹۸۱) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثِ ، عَنِ الْحَسَنِ ، وَعَطَائٍ وَالشَّعْبِیِّ قَالُوا فِی الْمُطَلَّقَۃِ ثَلاَثًا : لَہَا السُّکْنَی وَلاَ نَفَقَۃَ۔","","Musannaf Ibn Abi Shaybah 18981","","","كتاب الجنة"
"18982","(۱۸۹۸۲) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ قَالَ: ذَکَرْتُ لِإِبْرَاہِیمَ حَدِیثَ فَاطِمَۃَ بِنْتِ قَیْسٍ، فَقَالَ إبْرَاہِیمُ: قَالَ عُمَرُ: لاَنَدَعُ کِتَابَ اللہِ وَسُنَّۃَ رَسُولِہِ لِقَوْلِ امْرَأَۃٍ لاَ نَدْرِی حَفِظَتْ، أَوْ نَسِیَتْ، وَکَانَ عُمَرُ یَجْعَلُ لَہَا السُّکْنَی وَالنَّفَقَۃَ۔","","Musannaf Ibn Abi Shaybah 18982","","","كتاب الجنة"
"18983","(۱۸۹۸۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ ، عَنْ رَجُلٍ یُطَلِّقُ امْرَأَتَہُ وَہِیَ فی بَیْتٍ بِکِرَائٍ عَلَی مَنِ الْکِرَائُ ؟ قَالَ : عَلَی زَوْجِہَا ، قَالَ : فَإِنْ لَمْ یَکُنْ عِنْدَ زَوْجِہَا قَالَ : فَعَلَیْہَا ، قَالَ : فَإِنْ لَمْ یَکُنْ عِنْدَہَا ؟ قَالَ : فَعَلَی الأَمِیرِ۔","","Musannaf Ibn Abi Shaybah 18983","","","كتاب الجنة"
"18984","(۱۸۹۸۴) حَدَّثَنَا شَبَابَۃُ قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، عَنْ شُرَیْحٍ قَالَ : الْمُطَلَّقَۃُ ثَلاَثًا لَہَا السُّکْنَی وَالنَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 18984","","","كتاب الجنة"
"18985","(۱۸۹۸۵) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ إبْرَاہِیمَ قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : لاَ نَدَعُ کِتَابَ رَبِّنَا وَسُنَّۃَ نَبِیِّنَا لِقَوْلِ الْمَرْأَۃِ ، الْمُطَلَّقَۃُ ثَلاَثًا لَہَا السُّکْنَی وَالنَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 18985","","","كتاب الجنة"
"18986","(۱۸۹۸۶) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا جَعْفَرُ بْنُ بُرْقَانَ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ قَالَ : قَالَ عُمَرُ : لاَ نَدَعُ کِتَابَ رَبِّنَا وَسُنَّۃَ نَبِیِّنَا صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِقَوْلِ امْرَأَۃٍ۔","","Musannaf Ibn Abi Shaybah 18986","","","كتاب الجنة"
"18987","(۱۸۹۸۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْحَکَمِ أَنَّ شُرَیْحًا قَالَ : الْمُطَلَّقَۃُ ثَلاَثًا لَہَا السُّکْنَی وَالنَّفَقَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 18987","","","كتاب الجنة"
"18988","(۱۸۹۸۸) حَدَّثَنَا وَکِیعٌ قَالَ: حَدَّثَنَا شُعْبَۃُ، عَنِ الْحَکَمِ وَحَمَّادٍ، عَنْ إبْرَاہِیمَ قَالَ: الْمُطَلَّقَۃُ ثَلاَثًا لَہَا السُّکْنَی وَالنَّفَقَۃُ.","","Musannaf Ibn Abi Shaybah 18988","","","كتاب الجنة"
"18989","(۱۸۹۸۹) حَدَّثَنَا وَکِیعٌ قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی الْجَہْمِ بْنِ صُخَیْرٍ الْعَدَوِیِّ ، قَالَ : سَمِعْتُ فَاطِمَۃَ بِنْتَ قَیْسٍ تَقُولُ : إنَّ زَوْجَہَا طَلَّقَہَا ثَلاَثًا فَلَمْ یَجْعَلْ لَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُکْنَی وَلاَ نَفَقَۃً۔ (مسلم۴۸۔ ترمذی ۱۱۳۵)","Sahih","Musannaf Ibn Abi Shaybah 18989","","","كتاب الجنة"
"18990","(۱۸۹۹۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ قَالَ : قالَتْ فَاطِمَۃُ بِنْتُ قَیْسٍ : طَلَّقَنِی زَوْجِی عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثًا فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ سُکْنَی لَکِ وَلاَ نَفَقَۃَ۔n(مسلم ۱۱۱۷۔ ترمذی ۱۱۸۰)","Sahih","Musannaf Ibn Abi Shaybah 18990","","","كتاب الجنة"
"18991","(۱۸۹۹۱) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : الْمُطَلِّقُ ثَلاَثًا لاَ یُجْبَرُ عَلَی النَّفَقَۃِ۔","","Musannaf Ibn Abi Shaybah 18991","","","كتاب الجنة"
"18992","(۱۸۹۹۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، وَالْحَسَنِ قَالَ سَمِعْتہمَا یَقُولاَنِ : الْمُطَلَّقَۃُ ثَلاَثًا وَالْمُتَوَفَّی عَنْہَا لَیْسَ لَہُمَا سُکْنَی وَلاَ نَفَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 18992","","","كتاب الجنة"
"18993","(۱۸۹۹۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ شُعْبَۃَ، عَنْ یَعْلَی بْنِ مُسْلِمٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فِی الْمُطَلَّقَۃِ ثَلاَثًا لاَ نَفَقَۃَ لَہَا۔","","Musannaf Ibn Abi Shaybah 18993","","","كتاب الجنة"
"18994","(۱۸۹۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ نَفَقَۃَ لَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 18994","","","كتاب الجنة"
"18995","(۱۸۹۹۵) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ قَالَ : سَأَلْتُہ عَنِ الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ الْبَتَّۃَ ہل لَہَا مِنْ نَفَقَۃٍ ؟ قَالَ : لاَ نَفَقَۃَ لَہَا۔","","Musannaf Ibn Abi Shaybah 18995","","","كتاب الجنة"
"18996","(۱۸۹۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عنْ عَبْدِ اللہِ قَالَ : لاَ یُطَلِّقُہَا وَہِیَ حَامِلٌ فَیُنَدِّمَہُ اللَّہُ فَیُنْفِقَ عَلَیْہَا حَمْلِہَا وَرَضَاعِہَا حَتَّی تَفْطِمَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18996","","","كتاب الجنة"
"18997","(۱۸۹۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ ثَلاَثًا وَہِیَ حَامِلٌ فَلَہَا عَلَیْہِ النَّفَقَۃُ حُرَّۃً کَانَتْ ، أَوْ أَمَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 18997","","","كتاب الجنة"
"18998","(۱۸۹۹۸) حَدَّثَنَا حَاتِمٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ الْبَتَّۃَ قَالَ : لاَ نَفَقَۃَ لَہَا إلاَّ أَنْ تَکُونَ حُبْلَی فَیُنْفِقَ عَلَیْہَا حَتَّی تَضَعَ حَمْلَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 18998","","","كتاب الجنة"
"18999","(۱۸۹۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : الْمُطَلَّقَۃُ ثَلاَثًا وَالْمُولَی عَنْہَا وَالْمُخْتَلِعَۃُ وَالْمُلاَعَنَۃُ وَہُنَّ حَوَامِلُ لَہُنَّ النَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 18999","","","كتاب الجنة"
"19000","(۱۹۰۰۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، وَعَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ قَالاَ : لِکُلِّ حَامِلٍ نَفَقَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 19000","","","كتاب الجنة"
"19001","(۱۹۰۰۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زَکَرِیَّا قَالَ : سُئِلَ عَامِرٌ عَنِ الْمَرْأَۃِ یُطَلِّقُہَا زَوْجُہَا وَہِیَ حَامِلٌ أَیُنْفِقُ عَلَیْہَا ؟ قَالَ : نَعَمْ ، إذَا کَانَ حُرًّا۔","No Data Available","Musannaf Ibn Abi Shaybah 19001","","","كتاب الجنة"
"19002","(۱۹۰۰۲) حَدَّثَنَا ابْنُ أَبِی غَنِیۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ : {فَأَنْفِقُوا عَلَیْہِنَّ حَتَّی یَضَعْنَ حَمْلَہُنَّ} قَالَ : إذَا طَلَّقَہَا وَہِیَ حَامِلٌ أنفق عَلَیْہَا حَتَّی تَضَعَ۔","","Musannaf Ibn Abi Shaybah 19002","","","كتاب الجنة"
"19003","(۱۹۰۰۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّ أَبَا الْعَالِیَۃِ وَشُرَیْحًا قَالاَ : فِی الْمُخْتَلِعَۃِ الْحَامِلِ : لَہَا النَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 19003","","","كتاب الجنة"
"19004","(۱۹۰۰۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَہَا النَّفَقَۃُ إلاَّ أَنْ یَشْتَرِطَ۔","","Musannaf Ibn Abi Shaybah 19004","","","كتاب الجنة"
"19005","(۱۹۰۰۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : لَہَا النَّفَقَۃُ إلاَّ أَنْ یَشْتَرِطَ عَلَیْہَا قَالَ وَقَالَ ابْنُ طَاوُوسٍ ، عَنْ أَبِیہِ : لَہَا النَّفَقَۃُ وَقَالَ عَمْرُو بْنُ دِینَارٍ : لَہَا النَّفَقَۃُ ، إنَّمَا یُنْفِقُ عَلَی وَلَدِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 19005","","","كتاب الجنة"
"19006","(۱۹۰۰۶) حَدَّثَنَا أَبُو دَاوُدَ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ یَحْیَی، عَنِ الْقَاسِمِ فِی الْمُخْتَلِعَۃِ الْحَامِلِ: لاَ بُدَّ لَہَا مِنْ نَفَقَۃٍ۔","","Musannaf Ibn Abi Shaybah 19006","","","كتاب الجنة"
"19007","(۱۹۰۰۷) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ قَالَ : لَہَا النَّفَقَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 19007","","","كتاب الجنة"
"19008","(۱۹۰۰۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : کَانَ یَجْعَلُ لَہَا النَّفَقَۃَ إذَا کَانَتْ حَامِلاً۔","No Data Available","Musannaf Ibn Abi Shaybah 19008","","","كتاب الجنة"
