hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4801","444 - (  4800  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنَا  كَهْمَسٌ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ شَقِيقٍ قَالَ :         [8/230]      سَأَلْتُ  عَائِشَةَ : مَنْ كَانَ أَحَبَّ النَّاسِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَتْ :  أَبُو بَكْرٍ  ، ثُمَّ  عُمَرُ  ، ثُمَّ  أَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ  .","","Musnad Abi Ya'la al-Mawsili 4800","","عائشة بنت أبي بكر الصديق عن عبد الله بن شقيق العقيلي عن كهمس بن الحسن النمري عن يحيى القطان عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4802","445 - (  4801  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  جَابِرِ بْنِ الصُّبْحِ قَالَ :  حَدَّثَتْنِي  أُمَيْنَةُ ، وَزَيْنَبُ وَهُمَا عَمَّتَاهُ ،  أَنَّهُمَا  لَقِيَتَا عَائِشَةَ فِي نِسْوَةٍ ، وَأَنَّ امْرَأَةً مِنَ النِّسَاءِ سَأَلَتْهَا عَنِ الْأَشْرِبَةِ ، فَقَالَتْ :  لَا أُحِلُّ نَبِيذَ حَنْتَمٍ ، وَلَا  نَقِيرٍ  ، وَلَا  مُزَفَّتٍ  ، وَلَا أُحَرِّمُ إِلَّا مَا حَرَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  .","","Musnad Abi Ya'la al-Mawsili 4801","","عائشة بنت أبي بكر الصديق عن زينب عن جابر بن صبح الراسبي عن يحيى القطان عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4803","446 - (  4802  ) -  حَدَّثَنَا  مُوسَى ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  جَابِرِ بْنِ الصُّبْحِ قَالَ :  سَمِعْتُ  خِلَاسًا الْهَجَرِيَّ ، يَقُولُ :  سَمِعْتُ  عَائِشَةَ تَقُولُ :  كُنْتُ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَبِيتُ فِي الشِّعَارِ الْوَاحِدِ ، وَأَنَا طَامِثٌ حَائِضٌ  ، فَإِنْ أَصَابَهُ شَيْءٌ غَسَلَ ذَلِكَ الْمَكَانَ لَا يَعْدُوهُ ، ثُمَّ صَلَّى فِيهِ  .         [8/231]             [8/232]","","Musnad Abi Ya'la al-Mawsili 4802","","عائشة بنت أبي بكر الصديق عن خلاس بن عمرو الهجري عن جابر بن صبح الراسبي عن يحيى القطان عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4804","447 - (  4803  ) -  حَدَّثَنَا  مُوسَى ،  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ جُرَيْجٍ قَالَ :  سَمِعْتُ  ابْنَ أَبِي مُلَيْكَةَ ،  يُحَدِّثُ عَنْ  ذَكْوَانَ أَبِي عَمْرٍو ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اسْتَأْمِرُوا النِّسَاءَ فِي  أَبْضَاعِهِنَّ  ، فَإِنَّ الْبِكْرَ تَسْتَحِي ، فَتَسْكُتُ ، فَهُوَ إِذْنُهَا  .","","Musnad Abi Ya'la al-Mawsili 4803","","عائشة بنت أبي بكر الصديق عن ذكوان مولى عائشة بنت أبي بكر عن ابن أبي مليكة عن ابن جريج عن يحيى القطان عن موسى بن عبد الرحمن بن سعيد المسروقي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4805","448 - (  4804  ) -  حَدَّثَنَا  مُوسَى ،  حَدَّثَنَا  يَحْيَى ،  حَدَّثَنَا  أَبُو         [8/233]      حَزْرَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ قَالَ :  كُنَّا عِنْدَ عَائِشَةَ ، فَجِيءَ بِطَعَامٍ ، فَقَامَ  الْقَاسِمُ  يُصَلِّي ،  فَقَالَتْ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يُصَلِّ بِحَضْرَةِ الطَّعَامِ ، وَلَا وَهُوَ يُدَافِعُ  الْأَخْبَثَيْنِ  .         [8/234]","","Musnad Abi Ya'la al-Mawsili 4804","","عائشة بنت أبي بكر الصديق عن عبد الله بن أبي عتيق التيمي عن يعقوب بن مجاهد المخزومي عن يحيى القطان عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4806","449 - (  4805  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَيَّانَ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  حَدَّثَنَا  قَيْسٌ ،  عَنْ  أَبِي سَهْلَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ادْعُوا لِي بَعْضَ أَصْحَابِي  ، قُلْتُ :  أَبُو بَكْرٍ  ؟ قَالَ : لَا ، قُلْتُ :  عُمَرُ  ؟ قَالَ : لَا ، قُلْتُ : ابْنُ عَمِّكَ  عَلِيٌّ  ؟ قَالَ : لَا ، قُلْتُ : مَنْ ؟ قَالَ :  عُثْمَانُ  ، فَلَمَّا جَاءَ قَالَ : تَنَحَّيْ ، فَجَعَلَ يُسَارُّهُ ، وَلَوْنُ  عُثْمَانَ  يَتَغَيَّرُ ، فَلَمَّا كَانَ يَوْمُ الدَّارِ وَحُصِرَ ، قُلْنَا : يَا أَمِيرَ الْمُؤْمِنِينَ ، أَلَا تُقَاتِلُ ؟ قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَهِدَ إِلَيَّ عَهْدًا ، وَإِنِّي صَابِرٌ نَفْسِي عَلَيْهِ  .         [8/235]","","Musnad Abi Ya'la al-Mawsili 4805","","عائشة بنت أبي بكر الصديق عن أبو سهلة مولى عثمان بن عفان عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن يحيى القطان عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4807","450 - (  4806  ) -  حَدَّثَنَا  مُوسَى بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَبْدِ الْمَجِيدِ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَائِشَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَمُوتُ أَحَدٌ مِنَ الْمُسْلِمِينَ ، فَيُصَلِّي عَلَيْهِ أُمَّةٌ مِنَ الْمُسْلِمِينَ  ، فَيَبْلُغُونَ أَنْ يَكُونُوا مِائَةً ، فَيَشْفَعُونَ لَهُ إِلَّا شُفِّعُوا فِيهِ  .","","Musnad Abi Ya'la al-Mawsili 4806","","عائشة بنت أبي بكر الصديق عن عبد الله بن يزيد رضيع عائشة عن أبو قلابة الجرمي عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4808","451 - (  4807  ) -  حَدَّثَنَا  مُوسَى ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ ،  حَدَّثَنَا  أَيُّوبُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى بِالنَّاسِ فِي وَجَعِهِ وَهُوَ         [8/236]      جَالِسٌ ، فَقَامُوا ، فَأَوْمَأَ إِلَيْهِمْ ، فَجَلَسُوا ، ثُمَّ قَالَ :  إِنَّمَا الْإِمَامُ لِيُؤْتَمَّ بِهِ ، فَإِذَا رَكَعَ ، فَارْكَعُوا  ، وَإِذَا سَجَدَ ، فَاسْجُدُوا ، وَإِذَا صَلَّى قَاعِدًا ، فَصَلُّوا قُعُودًا  .","","Musnad Abi Ya'la al-Mawsili 4807","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4809","452 - (  4808  ) -  حَدَّثَنَا  مُوسَى ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ ،  حَدَّثَنَا  أَيُّوبُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَتْ  سَوْدَةُ  امْرَأَةً ضَخْمَةً  ثَبِطَةً  ، فَاسْتَأْذَنَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تُفِيضَ مِنْ  جَمْعٍ  بِلَيْلٍ  ، فَأَذِنَ لَهَا ،  فَقَالَتْ  عَائِشَةُ  :  لَيْتَ أَنِّي كُنْتُ اسْتَأْذَنْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَمَا اسْتَأْذَنَتْهُ  سَوْدَةُ  ،  قَالَ  أَيُّوبُ  : وَكَانَتْ  عَائِشَةُ  ، لَا تُفِيضُ إِلَّا مَعَ الْإِمَامِ  .         [8/237]","","Musnad Abi Ya'la al-Mawsili 4808","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4810","453 - (  4809  ) -  حَدَّثَنَا  مُوسَى ،  حَدَّثَنَا  عَبْدُ الْوَهَّابِ قَالَ :  سَمِعْتُ  يَحْيَى بْنَ سَعِيدٍ الْأَنْصَارِيَّ ، يَقُولُ :  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ الْقَاسِمِ ، أَنَّ مُحَمَّدَ بْنَ جَعْفَرِ بْنِ الزُّبَيْرِ ،  أَخْبَرَهُ  أَنَّ عَبَّادَ بْنَ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  حَدَّثَهُ  أَنَّهُ سَمِعَ  عَائِشَةَ ، تَقُولُ :  أَتَى  رَجُلٌ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ،  احْتَرَقْتُ  فَسَأَلَهُ مَا لَهُ ؟ فَقَالَ : أَفْطَرْتُ فِي رَمَضَانَ ، ثُمَّ إِنَّهُ جَلَسَ ، فَأُتِيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمِكْتَلٍ  عَظِيمٍ يُدْعَى  الْعَرَقَ  فِيهِ تَمْرٌ ، فَقَالَ : أَيْنَ الْمُحْتَرِقُ ؟ فَقَامَ ، فَقَالَ :  تَصَدَّقْ  بِهِ  .","","Musnad Abi Ya'la al-Mawsili 4809","","عائشة بنت أبي بكر الصديق عن عباد بن عبد الله بن الزبير بن العوام عن محمد بن جعفر بن الزبير بن العوام عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن يحيى بن سعيد الأنصاري عن عبد الوهاب بن عبد المجيد الثقفي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4811","454 - (  4810  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْمُرُ إِحْدَانَا إِذَا حَاضَتْ ، أَنْ تَتَّزِرَ  ، ثُمَّ يُبَاشِرُهَا  .         [8/238]             [8/239]","","Musnad Abi Ya'la al-Mawsili 4810","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4812","455 - (  4811  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا  دَخَلَ عَلَى مَرِيضٍ ، أَوْ أُتِيَ بِمَرِيضٍ  قَالَ : أَذْهِبِ الْبَأْسَ رَبَّ النَّاسِ  ، وَاشْفِ أَنْتَ الشَّافِي ، شِفَاءً لَا يُغَادِرُ سَقَمًا  .","","Musnad Abi Ya'la al-Mawsili 4811","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4813","456 - (  4812  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  وُهَيْبٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُحَرِّمُ الرَّضْعَةُ وَلَا الرَّضْعَتَانِ  .","","Musnad Abi Ya'la al-Mawsili 4812","","عائشة بنت أبي بكر الصديق عن عبد الله بن الزبير عن ابن أبي مليكة عن أيوب السختياني عن وهيب بن خالد الكرابيسي عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4814","457 - (  4813  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي عَبْدِ الْمَلِكِ الْمَكِّيِّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِنَّمَا عَنَى  بِالْعُسَيْلَةِ  : النِّكَاحَ  .         [8/240]","","Musnad Abi Ya'la al-Mawsili 4813","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن إسماعيل بن عبد الملك بن أبي الصفير الأسدي عن مروان بن معاوية الفزاري عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4815","458 - (  4814  ) -  وَبِهِ  قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُحَرِّمُ الرَّضْعَةُ وَالرَّضْعَتَانِ  .","","Musnad Abi Ya'la al-Mawsili 4814","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن إسماعيل بن عبد الملك بن أبي الصفير الأسدي عن مروان بن معاوية الفزاري عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4816","459 - (  4815  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  أَخْبَرَنِي  مُحَمَّدُ بْنُ أَبِي حَرْمَلَةَ ،  عَنْ  عَطَاءٍ ، وَسُلَيْمَانَ ابْنَيْ يَسَارٍ ، وَأَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  أَنَّ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُضْطَجِعًا فِي بَيْتِهِ ، كَاشِفًا عَنْ  فَخِذَيْهِ - أَوْ سَاقَيْهِ  - فَاسْتَأْذَنَ  أَبُو بَكْرٍ  ، فَأَذِنَ لَهُ وَهُوَ عَلَى تِلْكَ الْحَالِ ، فَتَحَدَّثَ ، ثُمَّ اسْتَأْذَنَ  عُمَرُ  ، فَأَذِنَ لَهُ وَهُوَ كَذَلِكَ ، فَتَحَدَّثَ ، ثُمَّ اسْتَأْذَنَ  عُثْمَانُ  ، فَجَلَسَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَسَوَّى ثِيَابَهُ - قَالَ  مُحَمَّدٌ  : لَا أَقُولُ ذَلِكَ فِي يَوْمٍ وَاحِدٍ - فَدَخَلَ فَتَحَدَّثَ ، فَلَمَّا خَرَجَ ، قَالَتْ  عَائِشَةُ  : يَا رَسُولَ اللهِ ، دَخَلَ  أَبُو بَكْرٍ  ، فَلَمْ تَجْلِسْ وَلَمْ  تُبَالِهِ  ، ثُمَّ دَخَلَ  عُمَرُ  ، فَلَمْ تَهْتَشَّ لَهُ ، وَلَمْ  تُبَالِهِ  .         [8/241]      ثُمَّ دَخَلَ  عُثْمَانُ  ، فَجَلَسْتَ ، وَسَوَّيْتَ ثِيَابَكَ ، فَقَالَ :  أَلَا أَسْتَحِي مِنْ رَجُلٍ تَسْتَحِي مِنْهُ الْمَلَائِكَةُ .  ؟","","Musnad Abi Ya'la al-Mawsili 4815","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن محمد بن أبي حرملة القرشي عن إسماعيل بن جعفر بن أبي كثير الزرقي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4817","460 - (  4816  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  أَخْبَرَنِي  مُحَمَّدٌ ،  أَخْبَرَنِي  أَبُو سَلَمَةَ ،  أَنَّهُ سَأَلَ  عَائِشَةَ ، عَنِ السَّجْدَتَيْنِ اللَّتَيْنِ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّيهِمَا بَعْدَ الْعَصْرِ ، فَقَالَتْ :  كَانَ يُصَلِّيهِمَا ، ثُمَّ إِنَّهُ شُغِلَ عَنْهُمَا ، أَوْ نَسِيَهُمَا ، فَصَلَّاهُمَا بَعْدَ الْعَصْرِ ، ثُمَّ أَثْبَتَهُمَا  ، وَكَانَ إِذَا صَلَّى صَلَاةً أَثْبَتَهَا  ، قَالَ  أَبُو زَكَرِيَّا  : قَالَ  إِسْمَاعِيلُ  :  يَعْنِي : دَامَ عَلَيْهَا  .","","Musnad Abi Ya'la al-Mawsili 4816","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن محمد بن أبي حرملة القرشي عن إسماعيل بن جعفر بن أبي كثير الزرقي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4818","461 - (  4817  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كُنْتُ إِذَا فَرَقْتُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأْسَهُ         [8/242]      صَدَعْتُ فَرْقَهُ عَنْ  يَافُوخِهِ  ، فَأَرْسَلْتُ نَاصِيَتَهُ بَيْنَ عَيْنَيْهِ  .  فَاللهُ أَعْلَمُ أَذَاكَ لِقَوْلِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُنَّا لَا نَكُفُّ شَعَرًا وَلَا ثَوْبًا  ؟ أَمْ هِيَ سِيمَاءُ كَانَ يَتَوَسَّمُ بِهَا ؟ وَقَدْ  قَالَ لِي  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ الزُّبَيْرِ  - وَكَانَ فَقِيهًا مُسْلِمًا - : مَا هِيَ إِلَّا سِيمَاءُ مِنْ سِيمَاءِ الْأَنْبِيَاءِ ، تَمَسَّكَتْ بِهَا النَّصَارَى مِنْ بَيْنِ النَّاسِ  .","","Musnad Abi Ya'la al-Mawsili 4817","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن جعفر بن الزبير بن العوام عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4819","462 - (  4818  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ شِهَابٍ ،  أَخْبَرَنِي  يَحْيَى بْنُ سَعِيدِ بْنِ الْعَاصِ ، أَنَّ سَعِيدَ بْنَ الْعَاصِ ،  أَخْبَرَهُ  : أَنَّ عُثْمَانَ ، وَعَائِشَةَ  حَدَّثَاهُ  ،  أَنَّ  أَبَا بَكْرٍ الصِّدِّيقَ  ، اسْتَأْذَنَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ مُضْطَجِعٌ عَلَى فِرَاشِهِ لَابِسٌ مِرْطَ  عَائِشَةَ  ، فَأَذِنَ  لِأَبِي بَكْرٍ  وَهُوَ كَذَلِكَ قَالَ : فَقَضَى إِلَيْهِ حَاجَتَهُ ، ثُمَّ انْصَرَفَ ، وَقَالَ  عُثْمَانُ  : ثُمَّ اسْتَأْذَنَ  عُمَرُ  ، فَأَذِنَ لَهُ وَهُوَ عَلَى تِلْكَ الْحَالِ ، فَقَضَى إِلَيْهِ حَاجَتَهُ ، ثُمَّ انْصَرَفَ قَالَ : فَقَالَتْ  عَائِشَةُ  : لَمْ أَرَكَ  فَزِعْتَ  لِأَبِي بَكْرٍ  ،  وَعُمَرَ  ، كَمَا  فَزِعْتَ  لِعُثْمَانَ  ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  عُثْمَانَ  رَجُلٌ حَيِيٌّ ، خَشِيتُ إِنْ أَذِنْتُ لَهُ وَأَنَا عَلَى         [8/243]      تِلْكَ الْحَالِ ، أَنْ لَا يَبْلُغَ فِي حَاجَتِهِ  .","","Musnad Abi Ya'la al-Mawsili 4818","","عائشة بنت أبي بكر الصديق عن عكة العسل ، سعيد بن العاص بن أبي أحيحة عن يحيى بن سعيد بن العاص القرشي عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4820","463 - (  4819  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي وَهِيَ مُعْتَرِضَةٌ عَنْ يَمِينِهِ  وَعَنْ شِمَالِهِ  .","","Musnad Abi Ya'la al-Mawsili 4819","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4821","464 - (  4820  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  هَمَّامُ بْنُ يَحْيَى ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي وَهِيَ مُعْتَرِضَةٌ بَيْنَ يَدَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 4820","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4822","465 - (  4821  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَوَضَّأُ ، ثُمَّ يُقَبِّلُ ، ثُمَّ يُصَلِّي  ، وَلَا يُحْدِثُ وُضُوءًا  .","","Musnad Abi Ya'la al-Mawsili 4821","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن أبو بكر بن عياش عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4823","466 - (  4822  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا         [8/244]      سُفْيَانُ ،  عَنْ  أَبِي سَعْدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  قَالَ :  قَالَتْ  عَائِشَةُ :  مَا تَزَوَّجَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى أَتَاهُ  جِبْرِيلُ  بِصُورَتِي  ، فَقَالَ : هَذِهِ زَوْجَتُكَ ، وَلَقَدْ تَزَوَّجَنِي وَإِنِّي لَجَارِيَةٌ عَلَيَّ  حَوْفٌ ،  فَلَمَّا تَزَوَّجَنِي ، أَوْقَعَ اللهُ عَلَيَّ الْحَيَاءَ  .","","Musnad Abi Ya'la al-Mawsili 4822","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن سعيد بن المرزبان عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4824","467 - (  4823  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  حَاتِمٌ ،  عَنِ  ابْنِ حَرْمَلَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ نِيَارٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّ  رَجُلًا  اسْتَأْذَنَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا سَمِعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَوْتَهُ قَالَ :  بِئْسَ  الرَّجُلُ  بِئْسَ  ابْنُ الْعَشِيرَةِ ، فَلَمَّا دَخَلَ انْبَسَطَ إِلَيْهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا خَرَجَ ، كَلَّمَتْهُ         [8/245]      عَائِشَةُ  ، فَقَالَتْ : يَا رَسُولَ اللهِ ، قُلْتَ :  بِئْسَ  الرَّجُلُ  بِئْسَ  ابْنُ الْعَشِيرَةِ ، فَلَمَّا دَخَلَ انْبَسَطْتَ إِلَيْهِ ؟ قَالَ :  يَا  عَائِشَةُ  ، إِنَّ مِنْ شِرَارِ النَّاسِ مَنِ اتُّقِيَ فُحْشُهُ  .","","Musnad Abi Ya'la al-Mawsili 4823","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عبد الله بن نيار الأسلمي عن عبد الرحمن بن حرملة الأسلمي عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4825","468 - (  4824  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  حَاتِمٌ ،  عَنْ  صَالِحِ بْنِ مُحَمَّدِ بْنِ زَائِدَةَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  مَا رَفَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأْسَهُ فِي السَّمَاءِ ، إِلَّا قَالَ : يَا مُصَرِّفَ الْقُلُوبِ  ، ثَبِّتْ قَلْبِي عَلَى طَاعَتِكَ  .","","Musnad Abi Ya'la al-Mawsili 4824","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن صالح بن محمد بن زائدة الليثي عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4826","469 - (  4825  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  ابْنُ أَبِي         [8/246]      فُدَيْكٍ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ  بِابْنِ زُرَارَةَ  أَنْ يُكْوَى  .","","Musnad Abi Ya'la al-Mawsili 4825","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن محمد بن إسماعيل بن مسلم الديلي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4827","470 - (  4826  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ يَمَانٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مَيْمُونِ بْنِ أَبِي شَبِيبٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نُنْزِلَ النَّاسَ مَنَازِلَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 4826","","عائشة بنت أبي بكر الصديق عن ميمون بن أبي شبيب عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن يحيى بن يمان العجلي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4828","471 - (  4827  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْكَرِيمِ بْنِ أَبِي الْمُخَارِقِ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  حَسَنِ بْنِ مُحَمَّدٍ قَالَ :         [8/247]      قَالَتْ  عَائِشَةُ :  أُهْدِيَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَشِيقَةُ  ظَبْيٍ وَهُوَ مُحْرِمٌ ، فَرَدَّهُ  ، وَلَمْ يَأْكُلْهُ  .","","Musnad Abi Ya'la al-Mawsili 4827","","عائشة بنت أبي بكر الصديق عن الحسن بن محمد بن علي بن أبي طالب عن قيس بن مسلم الجدلي عن عبد الكريم بن أبي المخارق عن سفيان بن عيينة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4829","472 - (  4828  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كُفِّنَ فِي ثَلَاثَةِ أَثْوَابٍ  سَحُولِيَّةٍ  ، وَلُحِدَ لَهُ ، وَنُصِبَ عَلَيْهِ اللَّبِنُ نَصْبًا  .","","Musnad Abi Ya'la al-Mawsili 4828","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن محمد الدراوردي عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4830","473 - (  4829  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ قَالَتْ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْتُرُنِي بِثَوْبِهِ ، وَأَنَا أَنْظُرُ إِلَى  الْحَبَشَةِ  ، وَهُمْ يَلْعَبُونَ ، وَأَنَا جَارِيَةٌ ،  فَاقْدُرُوا  قَدْرَ الْجَارِيَةِ الْغَرَّةِ الْحَدِيثَةِ السِّنِّ .         [8/248]      وَقَالَتْ : كَانَ يَوْمُ عِيدٍ يَلْعَبُ السُّودَانُ بِالدَّرَقِ وَالْحِرَابِ ،  فَإِمَّا سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَإِمَّا قَالَ  : تَشْتَهِينَ تُبْصِرِينَ ؟ قُلْتُ : نَعَمْ ، فَأَقَامَنِي وَرَاءَهُ ، خَدِّي عَلَى خَدِّهِ ، وَهُوَ يَقُولُ : دُونَكُمْ بَنِي  أَرْفِدَةَ  ، حَتَّى إِذَا مَلِلْتُ قَالَ : حَسْبُكِ ؟ قُلْتُ : نَعَمْ قَالَ : فَاذْهَبِي  .","","Musnad Abi Ya'la al-Mawsili 4829","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4831","474 - (  4830  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنِي  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  بَكْرُ بْنُ مُضَرَ ،  عَنِ  ابْنِ الْهَادِ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ ، نَحْوَهُ ، قَالَتْ : فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : حَسْبُكِ ؟ فَقُلْتُ : لَا تَعْجَلْ يَا رَسُولَ اللهِ ، قَالَتْ : وَمَا بِي حُبُّ النَّظَرِ         [8/249]      إِلَيْهِمْ ، وَلَكِنْ أَحْبَبْتُ أَنْ يَبْلُغَ النِّسَاءَ مَقَامُكَ ، وَمَكَانِي مِنْهُ .","","Musnad Abi Ya'la al-Mawsili 4830","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن بكر بن مضر المصري عن عبد الله بن وهب المصري عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4832","475 - (  4831  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  وَأَخْبَرَنِي  شَرِيكٌ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كُلَّمَا كَانَتْ         [8/250]      لَيْلَتُهَا مِنْ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْرُجُ مِنْ آخِرِ اللَّيْلِ إِلَى  الْبَقِيعِ  ، فَيَقُولُ : السَّلَامُ عَلَيْكُمْ  دَارَ  قَوْمٍ مُؤْمِنِينَ ، وَأَتَاكُمْ مَا تُوعَدُونَ ، غَدًا مُؤَجَّلُونَ ، وَإِنَّا إِنْ شَاءَ اللهُ بِكُمْ  لَاحِقُونَ ،  اللَّهُمَّ اغْفِرْ لِأَهْلِ  بَقِيعِ الْفَرْقَدِ  .","","Musnad Abi Ya'la al-Mawsili 4831","","عائشة بنت أبي بكر الصديق عن عطاء بن يسار الهلالي عن شريك بن عبد الله بن أبي نمر الكناني عن إسماعيل بن جعفر بن أبي كثير الزرقي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4833","476 - (  4832  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ نِيَارٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّ  رَجُلًا  اسْتَأْذَنَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : مَنْ هَذَا ؟ فَقَالُوا : فُلَانٌ ، فَقَالَ :  بِئْسَ  الرَّجُلُ وَبِئْسَ ابْنُ الْعَشِيرَةِ - أَوْ كَمَا قَالَ - ائْذَنُوا لَهُ ، فَلَمَّا دَخَلَ انْبَسَطَ إِلَيْهِ ، فَقَالَتْ  عَائِشَةُ  : قُلْتَ :  بِئْسَ  الرَّجُلُ ، وَبِئْسَ ابْنُ الْعَشِيرَةِ ، ثُمَّ انْبَسَطْتَ إِلَيْهِ ؟ فَقَالَ :  يَا  عَائِشَةُ  ، إِنَّ شَرَّ النَّاسِ عِنْدَ اللهِ يَوْمَ الْقِيَامَةِ مَنْ تَرَكَهُ النَّاسُ اتِّقَاءَ شَرِّهِ  .","","Musnad Abi Ya'la al-Mawsili 4832","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عبد الله بن نيار الأسلمي عن عبد الرحمن بن حرملة الأسلمي عن وهيب بن خالد الكرابيسي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4834","477 - (  4833  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  ابْنِ إِسْحَاقَ  ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  طَيَّبْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ إِحْرَامِهِ  ، فَرَأَيْتُ الطِّيبَ فِي مَفْرِقِ رَأْسِهِ بَعْدَ ثَلَاثَةٍ وَهُوَ مُحْرِمٌ  .         [8/251]      كذا في طبعة دار المأمون للتراث ، والصواب : (أبي إسحاق). كما في مصادر التخريج.","","Musnad Abi Ya'la al-Mawsili 4833","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4835","478 - (  4834  ) -  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا يَتَوَضَّأُ بَعْدَ الْغُسْلِ  .","","Musnad Abi Ya'la al-Mawsili 4834","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4836","479 - (  4835  ) -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى الْوَاسِطِيُّ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  مَا أَلْفَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدِي بِالْأَسْحَارِ ، إِلَّا وَهُوَ نَائِمٌ  .","","Musnad Abi Ya'la al-Mawsili 4835","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4837","480 - (  4836  ) -  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  إِبْرَاهِيمُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تُقْطَعُ يَدُ السَّارِقِ فِي رُبُعِ دِينَارٍ فَصَاعِدًا  .","","Musnad Abi Ya'la al-Mawsili 4836","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن زكريا بن يحيى زحمويه عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4838","481 - (  4837  ) -  حَدَّثَنَا  كَامِلُ بْنُ طَلْحَةَ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  جَعْفَرُ بْنُ رَبِيعَةَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَيُّمَا امْرَأَةٍ نُكِحَتْ بِغَيْرِ         [8/252]      إِذْنِ وَلِيِّهَا ، فَنِكَاحُهَا بَاطِلٌ  ، وَإِنْ دَخَلَ بِهَا ، فَلَهَا مَهْرُهَا بِمَا أَصَابَ مِنْ فَرْجِهَا ، وَإِنِ اشْتَجَرُوا ، فَالسُّلْطَانُ وَلِيُّ مَنْ لَا وَلِيَّ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 4837","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4839","482 - (  4838  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  حَدَّثَنَا  سَعِيدٌ ،  حَدَّثَنَا  عُقَيْلٌ ، وَيُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ حَمَلَ مِنْ أُمَّتِي دَيْنًا ، ثُمَّ اجْتَهَدَ فِي قَضَائِهِ  ، فَمَاتَ قَبْلَ أَنْ يَقْضِيَهُ ، فَأَنَا وَلِيُّهُ  .         [8/253]","","Musnad Abi Ya'la al-Mawsili 4838","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4840","483 - (  4839  ) -  حَدَّثَنَا  هَارُونُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرٌو ، أَنَّ بَكْرَ بْنَ سَوَادَةَ  حَدَّثَهُ  ، أَنَّ يَزِيدَ بْنَ أَبِي حَبِيبٍ  حَدَّثَهُ  ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  عَائِشَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّ  رَجُلًا  تَلَا هَذِهِ الْآيَةَ :         {      مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ         }      ، فَقَالَ : إِنَّا لَنُجْزَى بِكُلِّ مَا عَمِلْنَا ؟ هَلَكْنَا إِذًا ، فَبَلَغَ ذَلِكَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  نَعَمْ ، يُجْزَى بِهِ الْمُؤْمِنُ فِي الدُّنْيَا ، فِي مُصِيبَتِهِ فِي جَسَدِهِ فِيمَا يُؤْذِيهِ  .","","Musnad Abi Ya'la al-Mawsili 4839","","عائشة بنت أبي بكر الصديق عن عبيد بن عمير بن قتادة الجندعي عن يزيد بن أبي حبيب الأزدي عن بكر بن سوادة عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4841","484 - (  4840  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  حَدَّثَنَا  مُصْعَبُ بْنُ ثَابِتٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ارْهَقُوا  الْقِبْلَةَ  .","","Musnad Abi Ya'la al-Mawsili 4840","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مصعب بن ثابت بن عبد الله بن الزبير بن العوام عن بشر بن السري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4842","485 - (  4841  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  أَبُو النَّضْرِ ،  عَنْ  عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهَا قَالَتِ :  انْكَسَفَتِ الشَّمْسُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَامَ بِالنَّاسِ فِي الْمَسْجِدِ  ، فَضَفُّوا وَرَاءَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - طَوِيلًا مِنَ النَّهَارِ ، حَتَّى صُرِعَ رِجَالٌ         [8/254]      حَرًّا ، حَتَّى رَأَيْتُ رِجَالًا  تَنْضَحُ  وُجُوهُهُمْ بِالْمَاءِ ، ثُمَّ رَكَعَ مِثْلَ قِيَامِهِ ، حَتَّى رَأَيْتُ رِجَالًا يُصْرَعُونَ أَيْضًا ، ثُمَّ رَفَعَ رَأْسَهُ ، ثُمَّ سَجَدَ ، ثُمَّ قَامَ دُونَ قِيَامِهِ الْأَوَّلِ ، ثُمَّ رَكَعَ دُونَ رَكْعَتِهِ الْأُولَى ، ثُمَّ رَفَعَ رَأْسَهُ ، ثُمَّ سَجَدَ ، ثُمَّ قَامَ أَيْضًا دُونَ ذَلِكَ ، ثُمَّ رَكَعَ ، ثُمَّ رَفَعَ رَأْسَهُ ، ثُمَّ سَجَدَ  .         [8/255]             [8/256]             [8/257]","","Musnad Abi Ya'la al-Mawsili 4841","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن سالم بن أبي أمية التيمي عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4843","486 - (  4842  ) -  حَدَّثَنَا  كَامِلُ بْنُ طَلْحَةَ الْجَحْدَرِيُّ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  الْحَارِثُ بْنُ يَزِيدَ ،  عَنْ  زِيَادِ بْنِ نُعَيْمٍ الْحَضْرَمِيِّ ،  عَنْ  مُسْلِمِ بْنِ مِخْرَاقٍ قَالَ :  قُلْتُ  لِعَائِشَةَ  أُمِّ الْمُؤْمِنِينَ : إِنَّ نَاسًا يَقْرَأُ أَحَدُهُمُ الْقُرْآنَ فِي لَيْلَةٍ مَرَّتَيْنِ أَوْ ثَلَاثًا ، قَالَتْ : أُولَئِكَ قَرَؤُوا ، وَلَمْ يَقْرَؤُوا ،  كَانَ رَسُولُ         [8/258]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُومُ اللَّيْلَةَ  التِّمَامَ  يَقْرَأُ بِسُورَةِ الْبَقَرَةِ  ، وَآلِ عِمْرَانَ ، وَالنِّسَاءِ ، لَا يَمُرُّ بِآيَةٍ فِيهَا اسْتِبْشَارٌ إِلَّا دَعَا  .","","Musnad Abi Ya'la al-Mawsili 4842","","عائشة بنت أبي بكر الصديق عن مسلم بن مخراق الحجازي عن زياد بن ربيعة الحضرمي عن الحارث بن يزيد الحضرمي عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4844","487 - (  4843  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  أَبُو الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  مَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ ذَاتِ  الْجَنْبِ  .         [8/259]","","Musnad Abi Ya'la al-Mawsili 4843","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4845","488 - (  4844  ) -  حَدَّثَنَا  كَامِلٌ ،  حَدَّثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنَا  أَبُو الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنِ الصَّلَاةِ حِينَ تَطْلُعُ الشَّمْسُ حَتَّى تَرْتَفِعَ  ، فَيَقُولُ : إِنَّهَا تَطْلُعُ بِقَرْنِ  شَيْطَانٍ  ، وَيَنْهَى عَنِ الصَّلَاةِ حِينَ تُقَارِبُ الْغُرُوبَ حَتَّى تَغْرُبَ  .         [8/260]","","Musnad Abi Ya'la al-Mawsili 4844","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4846","489 - (  4845  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  خَالِدٌ الْحَذَّاءُ ،  عَنِ  ابْنِ شَقِيقٍ وَهُوَ عَبْدُ اللهِ قَالَ :  سَأَلْتُ  عَائِشَةَ عَنْ صَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : كَانَ يُصَلِّي أَرْبَعًا قَبْلَ الظُّهْرِ  ، ثُمَّ يَخْرُجُ فَيُصَلِّي الظُّهْرَ ، ثُمَّ يَرْجِعُ فَيُصَلِّي رَكْعَتَيْنِ ، ثُمَّ يَخْرُجُ لِلْمَغْرِبِ ، ثُمَّ يَرْجِعُ فَيُصَلِّي رَكْعَتَيْنِ ، ثُمَّ يَخْرُجُ لِلْعِشَاءِ ، ثُمَّ يَرْجِعُ فَيُصَلِّي رَكْعَتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 4845","","عائشة بنت أبي بكر الصديق عن عبد الله بن شقيق العقيلي عن خالد الحذاء عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4847","490 - (  4846  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  زَكَرِيَّا ،  عَنْ  حُرَيْثٍ ،  عَنْ  عَامِرٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رُبَّمَا اغْتَسَلَ مِنَ الْجَنَابَةِ ، ثُمَّ أَتَانِي فَضَمَمْتُهُ إِلَيَّ  ، فَأُدْفِئُهُ وَلَمْ أَغْتَسِلْ بَعْدَهُ  .         [8/261]","","Musnad Abi Ya'la al-Mawsili 4846","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن حريث بن أبي مطر الفزاري عن زكريا بن أبي زائدة الوادعي عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4848","491 - (  4847  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ ،  حَدَّثَنِي  أَبِي ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَيْتِهِ مِثْلَ أَحَدِكُمْ فِي بَيْتِهِ  ، يَخِيطُ ثَوْبَهُ ، وَيَعْمَلُ كَمَا يَعْمَلُ أَحَدُكُمْ  .","","Musnad Abi Ya'la al-Mawsili 4847","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن يحيى بن سعيد الأنصاري عن ابن جريج عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4849","492 - (  4848  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ ،  حَدَّثَنَا  أَبِي  قَالَ :  هَذَا مَا  قَرَأْنَا عَلَى  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  أُنْزِلَ         {      عَبَسَ وَتَوَلَّى         }      فِي  ابْنِ أُمِّ مَكْتُومٍ  الْأَعْمَى  ، أَتَى إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلَ ، يَقُولُ : يَا رَسُولَ اللهِ ، أَرْشِدْنِي ، وَعِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ عُظَمَاءِ الْمُشْرِكِينَ ، فَجَعَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُعْرِضُ عَنْهُ ، وَيُقْبِلُ عَلَى الْآخَرِينَ ، فَيَقُولُ : أَتَرَوْنَ بِمَا أَقُولُ بَأْسًا ؟ فَيَقُولُونَ : لَا ، فَفِي هَذَا أُنْزِلَتْ :         {      عَبَسَ وَتَوَلَّى         }      .         [8/262]","","Musnad Abi Ya'la al-Mawsili 4848","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4850","493 - (  4849  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ أَخُو حَجَّاجٍ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  زُرَارَةَ ،  عَنْ  سَعْدِ بْنِ هِشَامٍ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الرَّكْعَتَانِ قَبْلَ الْفَجْرِ خَيْرٌ مِنَ الدُّنْيَا وَمَا فِيهَا  .","","Musnad Abi Ya'la al-Mawsili 4849","","عائشة بنت أبي بكر الصديق عن سعد بن هشام بن عامر الأنصاري عن زرارة بن أوفى عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن محمد بن المنهال الأنماطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4851","494 - (  4850  ) -  حَدَّثَنَا  أَبُو سَعِيدٍ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  أَبُو يَعْقُوبَ التَّوْأَمُ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَبِي مُلَيْكَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَالَ ، فَاتَّبَعَهُ  عُمَرُ  بِكُوزٍ مِنْ مَاءٍ ، فَقَالَ : مَا هَذَا يَا  عُمَرُ  ؟ قَالَ : مَاءٌ تَتَوَضَّأُ يَا رَسُولَ اللهِ ، فَقَالَ         [8/263]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا أُمِرْتُ كُلَّمَا بُلْتُ أَنْ أَتَوَضَّأَ ، وَلَوْ فَعَلْتُ لَكَانَتْ سُنَّةً  .","","Musnad Abi Ya'la al-Mawsili 4850","","عائشة بنت أبي بكر الصديق عن عبيد الله بن عبد الله بن أبي مليكة القرشي عن ابن أبي مليكة عن عبد الله بن يحيى بن سلمان التوأم عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4852","495 - (  4851  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  حَدَّثَنَا  أَشْعَثُ بْنُ أَبِي الشَّعْثَاءِ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  إِنْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيُحِبُّ  التَّيَمُّنَ  فِي طُهُورِهِ إِذَا تَطَهَّرَ  ، وَفِي تَرَجُّلِهِ إِذَا تَرَجَّلَ ، وَفِي انْتِعَالِهِ إِذَا انْتَعَلَ  .         [8/264]             [8/265]","","Musnad Abi Ya'la al-Mawsili 4851","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن سليم بن أسود المحاربي عن أشعث بن أبي الشعثاء عن سلام بن سليم الحنفي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4853","496 - (  4852  ) -  حَدَّثَنَا  أَبُو مُوسَى مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  ابْنُ أَبِي عَدِيٍّ ،  عَنْ  سَعِيدٍ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنِ  النَّخَعِيِّ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَبْعَثُ بِالْهَدْيِ وَيَفْتِلُ قَلَائِدَهَا  ، ثُمَّ لَا يَتَّقِي مَا يَتَّقِي الْمُحْرِمُ  .","","Musnad Abi Ya'la al-Mawsili 4852","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن زياد بن كليب عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4854","497 - (  4853  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  مَالِكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  قَلَّدَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَدْيَهُ وَأَشْعَرَهَا  ، وَبَعَثَ بِهَا مَعَ  أَبِي بَكْرٍ  ، ثُمَّ لَمْ يَدَعْ شَيْئًا أَحَلَّهُ اللهُ حَتَّى نُحِرَ الْهَدْيُ  .","","Musnad Abi Ya'la al-Mawsili 4853","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن عبد الله بن أبي بكر بن محمد  ابن حزم عن مالك بن أنس عن عثمان بن عمر بن فارس عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4855","498 - (  4854  ) -  حَدَّثَنَا  أَبُو مُوسَى ،  حَدَّثَنَا  ابْنُ أَبِي عَدِيٍّ ،  عَنْ  سَعِيدٍ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنِ  النَّخَعِيِّ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كُنْتُ أَفْرُكُهُ مِنْ ثَوْبِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فَإِذَا رَأَيْتَهُ اغْسِلْهُ ، وَإِلَّا فَرُشَّهُ  .         [8/266]             [8/267]             [8/268]","","Musnad Abi Ya'la al-Mawsili 4854","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن زياد بن كليب عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4856","499 - (  4855  ) -  حَدَّثَنَا  أَبُو مُوسَى ،  حَدَّثَنَا  ابْنُ أَبِي عَدِيٍّ ،  عَنْ  سَعِيدٍ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنِ  النَّخَعِيِّ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ إِذَا أَرَادَ أَنْ يَغْتَسِلَ مِنَ الْجَنَابَةِ بَدَأَ بِكَفَّيْهِ ، فَغَسَلَهُمَا  ، ثُمَّ غَسَلَ مَرَافِغَهُ وَأَفَاضَ عَلَيْهَا الْمَاءَ ، فَإِذَا أَنْقَى أَهْوَى بِهِمَا إِلَى حَائِطٍ ، ثُمَّ يَسْتَقْبِلُ الْوُضُوءَ ، ثُمَّ يُفِيضُ الْمَاءَ عَلَى رَأْسِهِ  .","","Musnad Abi Ya'la al-Mawsili 4855","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن زياد بن كليب عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4857","500 - (  4856  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  حَدَّثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  أَرِقَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ لَيْلَةٍ ، ثُمَّ قَالَ :  لَيْتَ رَجُلًا صَالِحًا مِنْ أَصْحَابِي جَاءَ يَحْرُسُنِي اللَّيْلَةَ  ، قَالَتْ :         [8/269]      إِذْ سَمِعْنَا صَوْتَ السِّلَاحِ ، فَقَالَ : مَنْ هَذَا ؟ قَالَ : أَنَا  سَعْدُ بْنُ أَبِي وَقَّاصٍ  ، جِئْتُ أَحْرُسُكَ ، قَالَتْ : فَنَامَ حَتَّى سَمِعْتُ  غَطِيطَهُ  .         [8/270]","","Musnad Abi Ya'la al-Mawsili 4856","","عائشة بنت أبي بكر الصديق عن عبد الله بن عامر بن ربيعة العنزي عن يحيى بن سعيد الأنصاري عن عبدة بن سليمان الكلابي عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4858","501 - (  4857  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْكُوفِيُّ ،  حَدَّثَنَا  ابْنُ أَبِي غَنِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  جُمَيْعِ بْنِ عُمَيْرٍ قَالَ :  دَخَلْتُ مَعَ أُمِّي عَلَى عَائِشَةَ ،  فَسَأَلَتْهَا  عَنْ  عَلِيٍّ  ، فَقَالَتْ : مَا رَأَيْتُ رَجُلًا كَانَ أَحَبَّ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْهُ  ، وَلَا امْرَأَةً كَانَتْ أَحَبَّ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنِ امْرَأَتِهِ  .         [8/271]","","Musnad Abi Ya'la al-Mawsili 4857","","عائشة بنت أبي بكر الصديق عن جميع بن عمير بن عفاق التيمي عن سليمان بن فيروز الشيباني عن عبد الملك بن حميد الخزاعي عن يحيى بن عبد الملك بن حميد عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4859","502 - (  4858  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَغْتَسِلُ بِقَدْرِ الصَّاعِ  ، وَيَتَوَضَّأُ بِقَدْرِ الْمُدِّ  .         [8/272]","","Musnad Abi Ya'la al-Mawsili 4858","","عائشة بنت أبي بكر الصديق عن صفية بنت شيبة الحجبية عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4860","503 - (  4859  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  مُعَاذَةَ الْعَدَوِيَّةِ ،  عَنْ  عَائِشَةَ أَنَّهَا قَالَتْ :  مُرْنَ أَزْوَاجَكُنَّ أَنْ يَغْسِلُوا عَنْهُمْ أَثَرَ الْغَائِطِ ، وَالْبَوْلِ  ، فَإِنِّي أَسْتَحْيِي أَنْ آمُرَهُمْ  ، وَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَفْعَلُهُ  .","","Musnad Abi Ya'la al-Mawsili 4859","","عائشة بنت أبي بكر الصديق عن معاذة بنت عبد الله العدوية عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4861","504 - (  4860  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي لَبِيدٍ ،  سَمِعَ  أَبَا سَلَمَةَ ، يَقُولُ :  أَتَيْتُ  عَائِشَةَ ، فَقُلْتُ :  أَيْ أُمَّهْ أَخْبِرِينِي عَنْ صَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ :  كَانَتْ صَلَاتُهُ بِاللَّيْلِ فِي شَهْرِ رَمَضَانَ ، وَفِيمَا سِوَى ذَلِكَ ثَلَاثَ عَشْرَةَ رَكْعَةً مِنْهَا رَكْعَتَا الْفَجْرِ  .  قُلْتُ : أَخْبِرِينِي عَنْ صِيَامِهِ ، قَالَتْ : كَانَ يَصُومُ حَتَّى نَقُولَ : قَدْ صَامَ ، وَيُفْطِرُ ، حَتَّى نَقُولَ : قَدْ أَفْطَرَ ، وَلَمْ أَرَهُ صَامَ مِنْ شَهْرٍ قَطُّ أَكْثَرَ مِنْ صِيَامِهِ مِنْ شَعْبَانَ ، كَانَ يَصُومُ شَعْبَانَ كُلَّهُ ، كَانَ يَصُومُ شَعْبَانَ إِلَّا قَلِيلًا .         [8/273]","","Musnad Abi Ya'la al-Mawsili 4860","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن عبد الله بن أبي لبيد مولى الأخنس بن شريق عن سفيان بن عيينة عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4862","505 - (  4861  ) -  قَالَ  أَبُو الْفَضْلِ :  وَسَمِعْتُ  سُفْيَانَ ، قَالَ :  قَالَتْ  هِيَ - يَعْنِي عَائِشَةَ - :  كَانَ يَكُونُ عَلَيَّ الصِّيَامُ مِنْ رَمَضَانَ ، فَمَا أَصُومُهُ حَتَّى يَكُونَ شَعْبَانُ  ،  كُلُّهَا تَخْزَى أَنْ تَصُومَ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فِيمَا فَسَّرَهُ  سُفْيَانُ  .         [8/274]             [8/275]","","Musnad Abi Ya'la al-Mawsili 4861","","عائشة بنت أبي بكر الصديق عن سفيان بن عيينة عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4863","506 - (  4862  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  حَدَّثَنَا  الْحَسَنُ ،  عَنْ  سَعْدِ بْنِ هِشَامِ بْنِ عَامِرٍ قَالَ :  كُنْتُ رَجُلًا أَتَتَبَّعُ السُّلْطَانَ ، فَأَخَذَنِي أَبِي فَحَبَسَنِي  - قَالَ  مُبَارَكٌ  : وَلَا أَعْلَمُهُ إِلَّا قَالَ : وَقَيَّدَنِي - فَقَالَ لِي : وَاللهِ لَا تَخْرُجُ حَتَّى تَسْتَظْهِرَ كِتَابَ اللهِ ،  فَاسْتَظْهَرْتُ  كِتَابَ اللهِ ، فَنَفَعَنِي اللهُ بِهِ ، فَذَهَبَتْ عَنِّي الدُّنْيَا ، وَجَعَلْتُ أَكْرَهُ أَنْ أَتَزَوَّجَ وَأَصْنَعُ ، فَدَخَلْتُ عَلَى عَائِشَةَ ، فَقُلْتُ :  سَعْدُ بْنُ هِشَامِ بْنِ عَامِرٍ  ، فَقَالَتْ : رَحِمَ اللهُ  عَامِرًا  أُصِيبَ  يَوْمَ أُحُدٍ  شَهِيدًا . قَالَ : فَقُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ، إِنِّي أُرِيدُ أَنْ أَتَبَتَّلَ ، فَجِئْتُ أَسْأَلُكِ عَنْ ذَلِكَ ، فَقَالَتْ : يَا  هِشَامُ  ، لَا  تَبَتَّلْ  ، فَإِنَّ اللهَ قَالَ :         {      لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ         }      ، وَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَزَوَّجَ ، وَوُلِدَ لَهُ قَالَ : قُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ، حَدِّثِينِي عَنْ  خُلُقِ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : يَا بُنَيَّ ، أَمَا تَقْرَأُ الْقُرْآنَ ؟ قَالَ اللهُ :         {      وَإِنَّكَ لَعَلَى خُلُقٍ عَظِيمٍ         }      ،  خُلُقُ  مُحَمَّدٍ  الْقُرْآنُ .  قَالَ : قُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ، حَدِّثِينِي عَنْ صَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : يَا بُنَيَّ ، وَمَنْ يُطِيقُ صَلَاةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ إِذَا صَلَّى صَلَّى رَكْعَتَيْنِ ، ثُمَّ هَجَعَ هَجْعَةً ، ثُمَّ يَقُومُ         [8/276]      فَيُصَلِّي رَكْعَتَيْنِ ، وَرَكْعَتَيْنِ ، وَرَكْعَتَيْنِ ، وَرَكْعَتَيْنِ ، وَرَكْعَتَيْنِ ، وَرَكْعَةً ، أَوْ قَالَتْ : فَيُصَلِّي رَكْعَتَيْنِ ، وَرَكْعَتَيْنِ ، وَرَكْعَتَيْنِ ، وَرَكْعَتَيْنِ ، وَرَكْعَةً  صَلَاةً بَعْدَ الْعِشَاءِ تِسْعَ رَكَعَاتٍ ، وَإِحْدَى عَشْرَةَ ، فَلَمَّا بَدَّنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَثُرَ لَحْمُهُ ، صَلَّى رَكْعَتَيْنِ ، وَرَكْعَتَيْنِ ، وَرَكْعَةً ، وَصَلَّى رَكْعَتَيْنِ وَهُوَ جَالِسٌ  .         [8/277]","","Musnad Abi Ya'la al-Mawsili 4862","","عائشة بنت أبي بكر الصديق عن سعد بن هشام بن عامر الأنصاري عن الحسن البصري عن مبارك بن فضالة عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4864","507 - (  4863  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  أَبَانُ بْنُ يَزِيدَ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ، أَنَّ مُحَمَّدَ بْنَ أَبَانَ  حَدَّثَهُ  ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ حَدَّثَهُ ، أَنَّ عَائِشَةَ  حَدَّثَتْهُ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ نَذَرَ أَنْ يَعْصِيَ اللهَ ، فَلَا يَعْصِهِ  .         [8/278]","","Musnad Abi Ya'la al-Mawsili 4863","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن محمد بن أبان الأنصاري عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4865","508 - (  4864  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  ابْنُ أَبِي زَائِدَةَ ،  عَنْ  حَارِثَةَ بْنِ مُحَمَّدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ يَقُومُ لِلْوُضُوءِ يَكْفَأُ الْإِنَاءَ ، فَيُسَمِّي  ، ثُمَّ يُسْبِغُ الْوُضُوءَ  .         [8/279]","","Musnad Abi Ya'la al-Mawsili 4864","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن حارثة بن أبي الرجال النجاري عن يحيى بن زكريا بن أبي زائدة عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4866","509 - (  4865  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  صَدَقَةَ بْنِ سَعِيدٍ ،  عَنْ  جُمَيْعِ بْنِ عُمَيْرٍ ،  أَنَّ  أُمَّهَ وَخَالَتَهُ دَخَلَتَا عَلَى عَائِشَةَ ، فَقَالَتَا : يَا أُمَّ الْمُؤْمِنِينَ كَيْفَ كَانَتْ إِحْدَاكُنَّ تَصْنَعُ إِذَا هِيَ حَاضَتْ ؟  قَالَتْ : تَشُدُّ عَلَيْهَا إِزَارًا ، ثُمَّ يَلْتَزِمُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَطْنَهَا وَمَا فَوْقَ ذَلِكَ ، قَالَتَا : كَيْفَ يَغْتَسِلُ ؟ قَالَتْ : يُفِيضُ عَلَى يَدَيْهِ ثُمَّ يَسْتَنْجِي ، ثُمَّ يَضْرِبُ بِيَدِهِ الْأَرْضَ ، ثُمَّ يُفِيضُ عَلَى رَأْسِهِ ثَلَاثًا ، قَالَتْ : وَأَمَّا نَحْنُ ، فَنُفِيضُ خَمْسًا مِنْ أَجْلِ الضُّفُرِ .  قَالَتَا : فَأَخْبِرِينَا عَنْ  عَلِيٍّ  ، قَالَتْ : أَيَّ شَيْءٍ تَسْأَلْنَ عَنْ رَجُلٍ وَضَعَ يَدَهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَوْضِعًا ، فَسَالَتْ نَفْسُهُ فِي يَدِهِ ، فَمَسَحَ بِهَا وَجْهَهُ ؟ وَاخْتَلَفُوا فِي دَفْنِهِ ، فَقَالَ : إِنَّ أَحَبَّ الْبِقَاعِ إِلَى اللهِ مَكَانٌ قُبِضَ فِيهِ نَبِيُّهُ  .  قَالَتَا : فَلِمَ خَرَجْتِ عَلَيْهِ ؟  قَالَتْ :  أَمْرٌ قُضِيَ لَوَدِدْتُ أَنْ أَفْدِيَهُ مَا عَلَى الْأَرْضِ  .         [8/280]","","Musnad Abi Ya'la al-Mawsili 4865","","عائشة بنت أبي بكر الصديق عن جميع بن عمير بن عفاق التيمي عن صدقة بن سعيد الحنفي عن أبو بكر بن عياش عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4867","510 - (  4866  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أُمِّ ذَرَّةٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَا  وَكَافِلُ  الْيَتِيمِ فِي الْجَنَّةِ كَهَاتَيْنِ  - وَجَمَعَ بَيْنَ السَّبَّابَةِ وَالْوُسْطَى - وَالسَّاعِي عَلَى الْيَتِيمِ ، وَالْأَرْمَلَةِ ، وَالْمِسْكِينِ ، كَالْمُجَاهِدِ فِي  سَبِيلِ  اللهِ ، وَالصَّائِمِ الْقَائِمِ لَا يَفْتُرُ  .         [8/281]","","Musnad Abi Ya'la al-Mawsili 4866","","عائشة بنت أبي بكر الصديق عن أم ذرة المدنية مولاة عائشة عن محمد بن المنكدر عن ليث بن أبي سليم عن حفص بن غياث النخعي عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4868","511 - (  4867  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ،  عَنْ  عَبْدِ الرَّحِيمِ بْنِ سُلَيْمَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اجْعَلُوا مِنْ صَلَاتِكُمْ فِي بُيُوتِكُمْ  .         [8/282]","","Musnad Abi Ya'la al-Mawsili 4867","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الرحيم بن سليمان الأشل عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4869","512 - (  4868  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ قَالَ :  مَرَّتْ عَائِشَةُ بِمَاءٍ  لِبَنِي عَامِرٍ  ، يُقَالُ لَهُ : الْحَوْأَبُ ، فَنَبَحَتْ عَلَيْهِ الْكِلَابُ ، فَقَالَتْ : مَا هَذَا ؟ قَالُوا : مَاءٌ  لِبَنِي عَامِرٍ  ، فَقَالَتْ : رُدُّونِي رُدُّونِي ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  كَيْفَ بِإِحْدَاكُنَّ إِذَا نَبَحَتْ عَلَيْهَا كِلَابُ الْحَوْأَبِ . ؟         [8/283]","","Musnad Abi Ya'la al-Mawsili 4868","","عائشة بنت أبي بكر الصديق عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن محمد بن فضيل بن غزوان عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4870","513 - (  4869  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  رَوْحٌ ،  عَنْ  عَبْدِ اللهِ بْنِ سَمْعَانَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنِ  الْقَعْقَاعِ بْنِ حَكِيمٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  سَأَلْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الرَّجُلِ يَطَأُ بِنَعْلَيْهِ فِي الْأَذَى قَالَ :  التُّرَابُ لَهُمَا طَهُورٌ  .","","Musnad Abi Ya'la al-Mawsili 4869","","عائشة بنت أبي بكر الصديق عن القعقاع بن حكيم الكناني عن سعيد المقبري عن عبد الله بن زياد المخزومي عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن محمد بن المنهال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4871","514 - (  4870  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  حَدَّثَنَا  يَزِيدُ ،  حَدَّثَنَا  عُمَارَةُ بْنُ أَبِي حَفْصَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ ، أَخْبِرْنِي عَنِ  ابْنِ جُدْعَانَ  ، قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَمَا كَانَ ؟ قَالَتْ : قُلْتُ : كَانَ         [8/284]      يَنْحَرُ  الْكَوْمَاءَ  ، وَيُكْرِمُ الْجَارَ ، وَيَقْرِي الضَّيْفَ ، وَيَصْدُقُ الْحَدِيثَ ، وَيُوفِي بِالذِّمَّةِ ، وَيَصِلُ الرَّحِمَ ، وَيَفُكُّ  الْعَانِي  ، وَيُطْعِمُ الطَّعَامَ ، وَيُؤَدِّي الْأَمَانَةَ قَالَ :  هَلْ قَالَ يَوْمًا وَاحِدًا : اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ نَارِ  جَهَنَّمَ  ؟  قَالَتْ : لَا ، وَمَا كَانَ يَدْرِي مَا  جَهَنَّمُ  قَالَ : فَلَا إِذًا  .","","Musnad Abi Ya'la al-Mawsili 4870","","عائشة بنت أبي بكر الصديق عن عكرمة مولى ابن عباس عن عمارة بن أبي حفصة العتكي عن يزيد بن زريع العيشي عن محمد بن المنهال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4872","515 - (  4871  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  بِسْطَامُ بْنُ مُسْلِمٍ ،  عَنْ  أَبِي التَّيَّاحِ يَزِيدَ بْنِ حُمَيْدٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  أَنَّ  عَائِشَةَ أَقْبَلَتْ ذَاتَ يَوْمٍ مِنَ الْمَقَابِرِ ، فَقُلْتُ لَهَا : مِنْ أَيْنَ أَقْبَلْتِ يَا أُمَّ الْمُؤْمِنِينَ ؟  قَالَتْ : مِنْ قَبْرِ أَخِي  عَبْدِ الرَّحْمَنِ  ، فَقُلْتُ لَهَا : يَا أُمَّ الْمُؤْمِنِينَ ، أَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْ زِيَارَةِ الْقُبُورِ ؟ قَالَتْ : نَعَمْ ، كَانَ نَهَى عَنْ زِيَارَتِهَا ، وَقَدْ كَانَ نَهَى عَنْ لُحُومِ الْأَضَاحِيِّ أَنْ تُؤْكَلَ فَوْقَ ثَلَاثٍ ، ثُمَّ أَمَرَ بِأَكْلِهَا ، وَكَانَ نَهَى عَنْ شُرْبِ نَبِيذِ  الْجَرِّ  .         [8/285]","","Musnad Abi Ya'la al-Mawsili 4871","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن يزيد بن حميد الضبعي عن بسطام بن مسلم العوذي عن يزيد بن زريع العيشي عن محمد بن المنهال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4873","516 - (  4872  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  أَبَانُ بْنُ صَمْعَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كُنْتُ أَغْتَسِلُ أَنَا وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ  ، يَبْدَأُ قَبْلِي  .         [8/286]","","Musnad Abi Ya'la al-Mawsili 4872","","عائشة بنت أبي بكر الصديق عن عكرمة مولى ابن عباس عن أبان بن صمعة عن يزيد بن زريع العيشي عن محمد بن المنهال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4874","517 - (  4873  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  حَجَّاجٌ ،  عَنْ  لَيْثِ بْنِ سَعْدٍ ،  عَنْ  مُعَاوِيَةَ بْنِ صَالِحٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ، قَالَتْ :  قِيلَ  لِعَائِشَةَ : مَاذَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَعْمَلُ فِي بَيْتِهِ ؟ قَالَتْ :  كَانَ بَشَرًا مِنَ الْبَشَرِ ،  يَفْلِي  ثَوْبَهُ ، وَيَحْلُبُ شَاتَهُ ، وَيَخْدُمُ نَفْسَهُ  .","","Musnad Abi Ya'la al-Mawsili 4873","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن معاوية بن صالح بن حدير الحضرمي عن الليث بن سعد عن حجاج بن محمد الأعور عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4875","518 - (  4874  ) -  حَدَّثَنَا  أَبُو طَالِبٍ عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَمُوتُ أَحَدٌ مِنَ الْمُسْلِمِينَ فَيُصَلِّي عَلَيْهِ أُمَّةٌ مِنَ الْمُسْلِمِينَ  يَبْلُغُونَ أَنْ يَكُونُوا مِائَةً فَيَشْفَعُوا لَهُ ، إِلَّا شُفِّعُوا فِيهِ  .","","Musnad Abi Ya'la al-Mawsili 4874","","عائشة بنت أبي بكر الصديق عن عبد الله بن يزيد رضيع عائشة عن أبو قلابة الجرمي عن أيوب السختياني عن عبيد الله بن عمرو بن أبي الوليد عن عبد الجبار بن عاصم الخراساني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4876","519 - (  4875  ) -  حَدَّثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ،  حَدَّثَنَا  عُمَرُ بْنُ يُونُسَ الْيَمَامِيُّ ،  حَدَّثَنَا  الْمُفَضَّلُ بْنُ ثَوَابٍ ، رَجُلٌ مِنْ أَهْلِ         [8/287]      الْيَمَامَةِ قَالَ :  حَدَّثَنِي  حُسَيْنُ بْنُ فَادِعٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَيْفِ بْنِ عَبْدِ اللهِ الْحِمْيَرِيِّ قَالَ :  دَخَلْتُ أَنَا وَرِجَالٌ مَعِي عَلَى عَائِشَةَ ،  فَسَأَلْنَاهَا  عَنِ الرَّجُلِ يَمْسَحُ فَرْجَهُ ، فَقَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا  أُبَالِي  إِيَّاهُ مَسِسْتُ أَوْ أَنْفِي  .","","Musnad Abi Ya'la al-Mawsili 4875","","عائشة بنت أبي بكر الصديق عن سيف بن عبد الله الحميري عن أبيه عن حسين بن فادع عن مفضل بن ثواب الجندي عن عمر بن يونس بن القاسم عن الجراح بن مخلد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4877","520 - (  4876  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،         [8/288]      حَدَّثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّهَا سُئِلَتْ : مَا كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَعْمَلُ فِي بَيْتِهِ ؟ قَالَتْ :  كَانَ يَخِيطُ ثَوْبَهُ ،  وَيَخْصِفُ  نَعْلَهُ ، وَيَعْمَلُ مَا يَعْمَلُ الرِّجَالُ فِي بُيُوتِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 4876","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مهدي بن ميمون المعولي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4878","521 - (  4877  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  حَدَّثَنَا  مَهْدِيٌّ ،  حَدَّثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّهَا سُئِلَتْ عَنْ صَلَاةِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  كَانَ يُصَلِّي قَاعِدًا ، فَإِذَا أَرَادَ أَنْ يَرْكَعَ قَامَ ، فَقَرَأَ ثَلَاثِينَ آيَةً ، أَوْ أَرْبَعِينَ آيَةً  ، ثُمَّ يَرْكَعُ وَيَسْجُدُ  .","","Musnad Abi Ya'la al-Mawsili 4877","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مهدي بن ميمون المعولي عن عبد الله بن محمد بن أسماء الضبعي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4879","522 - (  4878  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ  حَدَّثَنَا  ابْنُ وَهْبٍ ،  وَحَدَّثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  حَدَّثَنِي  أَبُو حَمْزَةَ ،  عَنْ  عَائِشَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  مَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَائِمًا قَبْلَ الْعِشَاءِ ، وَلَا لَاغِيًا بَعْدَهَا  ؛ إِمَّا ذَاكِرًا فَيَغْنَمُ ، وَإِمَّا نَائِمًا فَيَسْلَمُ  .","","Musnad Abi Ya'la al-Mawsili 4878","","عائشة بنت أبي بكر الصديق عن يونس بن خباب الأسيدي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4880","[8/289]      523 - (  4879  ) -  قَالَ  مُعَاوِيَةُ :  وَحَدَّثَنِي  أَبُو عَبْدِ اللهِ الْأَنْصَارِيُّ ،  عَنْ  عَائِشَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتِ :  السَّمَرُ  لِثَلَاثَةٍ  : لِعَرُوسٍ ، أَوْ مُسَافِرٍ ، أَوْ  مُتَهَجِّدٍ  بِاللَّيْلِ  .","","Musnad Abi Ya'la al-Mawsili 4879","","عائشة بنت أبي بكر الصديق عن أبو عبد الله الأنصاري عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4881","524 - (  4880  ) -  حَدَّثَنَا  الْحَارِثُ بْنُ سُرَيْجٍ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ قَالَ :  بَلَغَ عَائِشَةَ ، عَنِ امْرَأَةٍ تَلْبَسُ النَّعْلَيْنِ ،  فَقَالَتْ  :  نَهَى رَسُولُ         [8/290]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ  رَجُلَةِ  النِّسَاءِ  .","","Musnad Abi Ya'la al-Mawsili 4880","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن ابن جريج عن سفيان بن عيينة عن الحارث بن سريج النقال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4882","525 - (  4881  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  حَدَّثَنَا  أَبُو عَبْدِ الْمَلِكِ الْمَكِّيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَبِي مُلَيْكَةَ ،  عَنْ  عَائِشَةَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْعُسَيْلَةُ  الْجِمَاعُ  .","","Musnad Abi Ya'la al-Mawsili 4881","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن إسماعيل بن عبد الملك بن أبي الصفير الأسدي عن مروان بن معاوية الفزاري عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4883","526 - (  4882  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  سُحِرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى إِنَّهُ لَيُخَيَّلُ إِلَيْهِ أَنَّهُ فَعَلَ الشَّيْءَ وَمَا فَعَلَهُ ، حَتَّى إِذَا كَانَ ذَاتَ يَوْمٍ ، وَهُوَ عِنْدِي ، دَعَا اللهَ ، وَدَعَا ، ثُمَّ قَالَ :  أَشَعَرْتِ يَا  عَائِشَةُ  أَنَّ اللهَ قَدْ أَفْتَانِي فِيمَا اسْتَفْتَيْتُهُ فِيهِ ؟  قُلْتُ : وَمَا ذَاكَ يَا رَسُولَ اللهِ ؟ قَالَ : أَتَانِي مَلَكَانِ ، فَجَلَسَ أَحَدُهُمَا عِنْدَ رَأْسِي ، وَالْآخَرُ عِنْدَ رِجْلَيَّ .         [8/291]      ثُمَّ قَالَ أَحَدُهُمَا لِصَاحِبِهِ : مَا وَجَعُ الرَّجُلِ ؟ قَالَ :  مَطْبُوبٌ  قَالَ : مَنْ طَبَّهُ ؟ قَالَ :  لَبِيدُ بْنُ الْأَعْصَمِ الْيَهُودِيُّ  مِنْ  بَنِي زُرَيْقٍ  قَالَ : فِي مَاذَا ؟ قَالَ : فِي  مُشْطٍ  وَمُشَاطَةٍ قَالَ : فَأَيْنَ هُوَ ؟ قَالَ : فِي  بِئْرِ ذِي أَرْوَانَ  قَالَ : فَذَهَبَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَاسٌ مِنْ أَصْحَابِهِ إِلَى الْبِئْرِ ، فَنَظَرُوا إِلَيْهَا وَنَخْلِهَا ، ثُمَّ رَجَعَ إِلَى  عَائِشَةَ  ، فَقَالَ : وَاللهِ كَأَنَّ مَاءَهَا نُقَاعَةُ الْحِنَّاءِ ، وَكَأَنَّ نَخْلَهَا رُءُوسُ الشَّيَاطِينِ . قُلْتُ : يَا رَسُولَ اللهِ ، فَأَخْرَجْتَهُ ؟ قَالَ : لَا ، أَمَّا أَنَا فَقَدْ عَافَانِي اللهُ وَشَفَانِي ، وَخَشِيتُ أَنْ أُثَوِّرَ عَلَى النَّاسِ مِنْهُ شَرًّا ،         [8/292]      فَأَمَرَ بِهَا فَدُفِنَتْ  .         [8/293]             [8/294]","","Musnad Abi Ya'la al-Mawsili 4882","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4884","527 - (  4883  ) -  حَدَّثَنَا  الْحَارِثُ بْنُ سُرَيْجٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  فُضَيْلٌ أَبُو مُعَاذٍ ،  عَنْ  أَبِي حَرِيزٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَرَادَ أَنْ يُزَوِّجَ امْرَأَةً مِنْ نِسَائِهِ قَالَ : إِنَّ فُلَانَ بْنَ فُلَانٍ يَخْطُبُ فُلَانَةَ  ابْنَةَ فُلَانٍ  .         [8/295]","","Musnad Abi Ya'la al-Mawsili 4883","","عائشة بنت أبي بكر الصديق عن الشعبي عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن يزيد بن زريع العيشي عن الحارث بن سريج النقال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4885","528 - (  4884  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُطِيعٍ ،  حَدَّثَنَا  هُشَيْمٍ ،  عَنِ  الْعَوَّامِ ،  عَمَّنْ  حَدَّثَهُ  ،  عَنْ  عَائِشَةَ قَالَتْ :  لَمَّا أَسَّسَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مَسْجِدَ الْمَدِينَةِ  ، جَاءَ بِحَجَرٍ فَوَضَعَهُ ، وَجَاءَ  أَبُو بَكْرٍ  بِحَجَرٍ فَوَضَعَهُ ، وَجَاءَ  عُمَرُ  بِحَجَرٍ فَوَضَعَهُ ، وَجَاءَ  عُثْمَانُ  بِحَجَرٍ فَوَضَعَهُ ، قَالَتْ : فَسُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ ذَلِكَ ، فَقَالَ :  هَذَا أَمْرُ الْخِلَافَةِ مِنْ بَعْدِي  .","","Musnad Abi Ya'la al-Mawsili 4884","","عائشة بنت أبي بكر الصديق عن عمن عن العوام بن حوشب عن هشيم بن بشير عن عبد الله بن مطيع بن راشد البكري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4886","529 - (  4885  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنِ  الْوَلِيدِ بْنِ أَبِي هِشَامٍ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ وَهُوَ قَاعِدٌ  ، فَإِذَا أَرَادَ أَنْ يَرْكَعَ قَامَ قَدْرَ مَا يَقْرَأُ إِنْسَانٌ أَرْبَعِينَ آيَةً  .         [8/296]      كذا في طبعة دار المأمون للتراث ونسخة السليمانية ، ولعل الصواب : (عمرة) ولم نقف عليه من راوية أبي بكر بن محمد عن عروة إلا في هذا الموضع ، والله أعلم .","","Musnad Abi Ya'la al-Mawsili 4885","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن أبو بكر بن محمد الخزرجي عن الوليد بن أبي هشام القرشي عن إسماعيل ابن علية عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4887","530 - (  4886  ) -  حَدَّثَنَا  مُجَاهِدٌ ،  حَدَّثَنَا  الْقَاسِمُ بْنُ مَالِكٍ ،  عَنْ  عُمَرَ بْنِ سُوَيْدِ بْنِ غَيْلَانَ الثَّقَفِيِّ ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ :  كُنَّا نَخْرُجُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَدْ تَضَمَّخْنَا بِالزَّعْفَرَانِ وَالْوَرْسِ  ، وَقَدْ أَحْرَمْنَا ، فَنَعْرَقُ فَيَسِيلُ عَلَى وُجُوهِنَا ، فَيَرَاهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَا يَعِيبُ ذَلِكَ عَلَيْنَا  .","","Musnad Abi Ya'la al-Mawsili 4886","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن عمر بن سويد بن غيلان الثقفي عن القاسم بن مالك المزني عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4888","531 - (  4887  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  الْجُرَيْرِيُّ أَبُو مَسْعُودٍ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ قَالَ :  قُلْتُ  لِعَائِشَةَ :  أَيُّ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ أَحَبَّ إِلَيْهِ ؟ قَالَتْ :  أَبُو بَكْرٍ  قَالَ : قُلْتُ : ثُمَّ مَنْ ؟ قَالَتْ : ثُمَّ  عُمَرُ  قَالَ : قُلْتُ : ثُمَّ مَنْ ؟ قَالَتْ : ثُمَّ  أَبُو عُبَيْدَةَ بْنُ الْجَرَّاحِ  قَالَ : قُلْتُ : ثُمَّ مَنْ ؟ قَالَ : فَسَكَتَتْ  .         [8/297]","","Musnad Abi Ya'la al-Mawsili 4887","","عائشة بنت أبي بكر الصديق عن عبد الله بن شقيق العقيلي عن سعيد بن إياس الجريري عن حماد بن أسامة القرشي عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4889","532 - (  4888  ) -  حَدَّثَنَا  مُجَاهِدُ بْنُ مُوسَى ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ، وَيَزِيدُ ، قَالَا :  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو اللَّيْثِيُّ ،  حَدَّثَنَا  أَبُو سَلَمَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي وَأَنَا مُعْتَرِضَةٌ أَمَامَهُ فِي الْبَيْتِ  ، فَإِذَا أَرَادَ أَنْ يُوتِرَ ، غَمَزَنِي بِرِجْلِهِ ، وَقَالَ : تَنَحَّيْ  .","","Musnad Abi Ya'la al-Mawsili 4888","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يزيد بن هارون عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4890","533 - (  4889  ) -  حَدَّثَنَا  مُجَاهِدٌ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَهْدَى إِلَى الْبَيْتِ مَرَّةً غَنَمًا ، فَقَلَّدَهَا  .","","Musnad Abi Ya'la al-Mawsili 4889","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4891","534 - (  4890  ) -  حَدَّثَنَا  مُجَاهِدٌ ،  حَدَّثَنَا  مُعَاذٌ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  ذَكْوَانَ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اسْتَأْمِرُوا النِّسَاءَ فِي  أَبْضَاعِهِنَّ  ، قَالُوا : يَا رَسُولَ اللهِ ، فَالْبِكْرُ تَسْتَحِي ؟ قَالَ : سُكُوتُهَا إِقْرَارُهَا  .         [8/298]","","Musnad Abi Ya'la al-Mawsili 4890","","عائشة بنت أبي بكر الصديق عن ذكوان مولى عائشة بنت أبي بكر عن ابن أبي مليكة عن ابن جريج عن معاذ بن معاذ بن نصر عن مجاهد بن موسى عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4892","535 - (  4891  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  حَدَّثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  كَانَ إِذَا أَرَادَ أَنْ يَنَامَ وَهُوَ  جُنُبٌ  ، تَوَضَّأَ وُضُوءَهُ لِلصَّلَاةِ  ، وَإِذَا أَرَادَ أَنْ يَأْكُلَ ، غَسَلَ يَدَيْهِ ، ثُمَّ أَكَلَ  .","","Musnad Abi Ya'la al-Mawsili 4891","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4893","536 - (  4892  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُعْجِبُهُ الْحَلْوَاءُ ، وَالْعَسَلُ  .","","Musnad Abi Ya'la al-Mawsili 4892","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن علي بن مسهر القرشي عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4894","537 - (  4893  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  قَالَ لِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي لَأَعْلَمُ إِذَا كُنْتِ عَلَيَّ غَضْبَى ، وَإِذَا كُنْتِ عَنِّي رَاضِيَةً  ، إِذَا كُنْتِ عَلَيَّ غَضْبَى ، قُلْتِ : لَا ، وَرَبِّ  إِبْرَاهِيمَ  ، وَإِذَا كُنْتِ عَنِّي رَاضِيَةً ، قُلْتِ : لَا ، وَرَبِّ  مُحَمَّدٍ  ، قَالَتْ : أَجَلْ ، وَاللهِ ، مَا أَهْجُرُ إِلَّا اسْمَكَ  .         [8/299]","","Musnad Abi Ya'la al-Mawsili 4893","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن علي بن مسهر القرشي عن عبد الرحمن بن صالح العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4895","538 - (  4894  ) -  حَدَّثَنَاهُ  عَبْدُ اللهِ بْنُ الرُّومِيِّ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي لَأَعْلَمُ إِذَا كُنْتِ عَنِّي رَاضِيَةً ، وَإِذَا كُنْتِ عَلَيَّ غَضْبَى  ، قَالَتْ : قُلْتُ : مِنْ أَيْنَ تَعْرِفُ ذَلِكَ ؟ قَالَ : إِذَا كُنْتِ عَنِّي رَاضِيَةً ، قُلْتِ : لَا ، وَرَبِّ  مُحَمَّدٍ  ، وَإِذَا كُنْتِ عَلَيَّ غَضْبَى ، قُلْتِ : لَا ، وَرَبِّ  إِبْرَاهِيمَ  ، قُلْتُ : أَجَلْ ، وَاللهِ مَا أَهْجُرُ إِلَّا اسْمَكَ  .","","Musnad Abi Ya'la al-Mawsili 4894","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن ابن الرومي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4896","539 - (  4895  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الرُّومِيِّ ،  حَدَّثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّهَا كَانَتْ تَغْتَسِلُ هِيَ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ إِنَاءٍ وَاحِدٍ  .         [8/300]","","Musnad Abi Ya'la al-Mawsili 4895","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو معاوية الضرير عن ابن الرومي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4897","540 - (  4896  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الرُّومِيِّ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحِبُّ الْحَلْوَاءَ وَالْعَسَلَ ، فَكَانَ إِذَا صَلَّى الْعَصْرَ ، دَارَ عَلَى نِسَائِهِ فَيَدْنُو مِنْهُنَّ ، فَدَخَلَ عَلَى  حَفْصَةَ  ، فَاحْتَبَسَ عِنْدَهَا أَكْثَرَ مِمَّا كَانَ يَحْتَبِسُ ، فَسَأَلْتُ عَنْ ذَلِكَ ، فَقِيلَ لِي : أَهْدَتْ لَهَا  امْرَأَةٌ  مِنْ قَوْمِهَا  عُكَّةَ  عَسَلٍ ، فَسَقَتِ النَّبِيَّ شَرْبَةً ، فَقُلْتُ : أَمَا وَاللهِ ، لَنَحْتَالَنَّ لَهُ ، فَذَكَرْتُ ذَلِكَ  لِسَوْدَةَ  ، قُلْتُ : إِذَا دَخَلَ عَلَيْكِ فَإِنَّهُ سَيَدْنُو ، فَقُولِي لَهُ : يَا رَسُولَ اللهِ ، أَكَلْتَ  مَغَافِيرَ  ؟ فَإِنَّهُ سَيَقُولُ لَكِ : سَقَتْنِي  حَفْصَةُ  شَرْبَةَ عَسَلٍ ، فَقُولِي لَهُ :  جَرَسَتْ  نَحْلُهُ  الْعُرْفُطَ ،  وَسَأَقُولُ ذَلِكَ لَهُ ، وَقُولِي أَنْتِ يَا  صَفِيَّةُ  ، فَلَمَّا دَخَلَ عَلَى  سَوْدَةَ  ، قَالَتْ : تَقُولُ  سَوْدَةُ  : وَاللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ ، لَقَدْ ذَكَرْتُ أَنْ أُبَادِئَهُ بِالَّذِي قُلْتِ ، وَإِنَّهُ لَعَلَى الْبَابِ  فَرَقًا  مِنْكِ .  فَلَمَّا دَنَا ، قَالَتْ : يَا رَسُولَ اللهِ ، أَكَلْتَ  مَغَافِيرَ  ؟ قَالَ : لَا ، قُلْتُ : مَا هَذِهِ الرِّيحُ ؟ قَالَ :  سَقَتْنِي  حَفْصَةُ  شَرْبَةَ عَسَلٍ  ، قَالَتْ : قُلْتُ :  جَرَسَتْ  نَحْلُهُ  الْعُرْفُطَ ،  فَلَمَّا دَخَلَ عَلَيَّ ، قُلْتُ لَهُ مِثْلَ ذَلِكَ ، ثُمَّ دَخَلَ عَلَى  صَفِيَّةَ  ، فَقَالَتْ لَهُ مِثْلَ ذَلِكَ ، فَلَمَّا دَخَلَ عَلَى  حَفْصَةَ  ، قَالَتْ : يَا رَسُولَ اللهِ ، أَسْقِيكَ ؟ قَالَ : لَا         [8/301]      حَاجَةَ لِي بِهِ قَالَ : تَقُولُ  سَوْدَةُ  : سُبْحَانَ اللهِ لَقَدْ حَرَمْنَاهُ ، قَالَتْ : قُلْتُ : اسْكُتِي  .","","Musnad Abi Ya'la al-Mawsili 4896","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن ابن الرومي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4898","541 - (  4897  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الرُّومِيِّ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  تَزَوَّجَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا بِنْتُ سِتِّ سِنِينَ  ، وَبَنَى بِي ، وَأَنَا بِنْتُ تِسْعِ سِنِينَ ، فَقَدِمْنَا  الْمَدِينَةَ  فَوُعِكْتُ شَهْرًا ،  فَوَفَى  شَعَرِي  جُمَيْمَةً  ، فَأَتَتْنِي  أُمُّ رُومَانَ  ، وَأَنَا عَلَى  أُرْجُوحَةٍ  ، فَصَرَخَتْ بِي ، فَأَتَيْتُهَا ، وَمَا أَدْرِي مَاذَا يُرَادُ مِنِّي ، فَأَخَذَتْ بِيَدِي ، فَأَوْقَفَتْنِي عَلَى الْبَابِ ، فَقُلْتُ : هَهْ هَهْ ، حَتَّى ذَهَبَ نَفَسِي ، فَأَدْخَلَتْنِي بَيْتًا ، فَإِذَا نِسْوَةٌ مِنَ  الْأَنْصَارِ  ، فَقُلْنَ لِي : عَلَى الْخَيْرِ وَالْبَرَكَةِ ، عَلَى خَيْرِ طَائِرٍ ، فَأَسْلَمَتْنِي إِلَيْهِنَّ ، فَغَسَلْنَ رَأْسِي وَأَصْلَحْنَنِي ، فَلَمْ  يَرُعْنِي  إِلَّا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَسْلَمْنَنِي  .","","Musnad Abi Ya'la al-Mawsili 4897","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن ابن الرومي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4899","542 - (  4898  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  صَالِحُ         [8/302]      بْنُ مُوسَى ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  عَائِشَةَ ابْنَةِ طَلْحَةَ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ :  وَاللهِ ، إِنِّي لَفِي بَيْتِي ذَاتَ يَوْمٍ ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابُهُ فِي الْفِنَاءِ ، وَالسِّتْرُ بَيْنِي وَبَيْنَهُمْ ، إِذْ أَقْبَلَ  طَلْحَةُ بْنُ عُبَيْدِ اللهِ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ سَرَّهُ أَنْ يَنْظُرَ إِلَى رَجُلٍ يَمْشِي عَلَى ظَهْرِ الْأَرْضِ قَدْ قَضَى  نَحْبَهُ  ، فَلْيَنْظُرْ إِلَى  طَلْحَةَ  .","","Musnad Abi Ya'la al-Mawsili 4898","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن معاوية بن إسحاق بن طلحة التيمي عن صالح بن موسى الطلحي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4900","543 - (  4899  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  صَالِحُ بْنُ         [8/303]      مُوسَى ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ :  وَاللهِ ، إِنِّي لَفِي بَيْتِي ذَاتَ يَوْمٍ ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْفِنَاءِ وَأَصْحَابُهُ ، وَالسِّتْرُ بَيْنِي وَبَيْنَهُمْ ، إِذْ أَقْبَلَ  أَبُو بَكْرٍ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ سَرَّهُ أَنْ يَنْظُرَ إِلَى عَتِيقٍ مِنَ النَّارِ ، فَلْيَنْظُرْ إِلَى  أَبِي بَكْرٍ  ، وَإِنَّ اسْمَهُ الَّذِي سَمَّاهُ أَهْلُهُ  لَعَبْدُ اللهِ بْنُ عُثْمَانَ  ، فَغَلَبَ عَلَيْهِ اسْمُ عَتِيقٍ  .","","Musnad Abi Ya'la al-Mawsili 4899","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن معاوية بن إسحاق بن طلحة التيمي عن صالح بن موسى الطلحي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4901","544 - (  4900  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  حَفْصٌ ،  عَنْ  دَاوُدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ قَالَ :  سَأَلْتُ  عَائِشَةَ عَنْ هَذِهِ الْآيَةِ الَّتِي فِيهَا الرُّؤْيَةُ ، فَقَالَتْ : أَنَا         [8/304]      أَعْلَمُ هَذِهِ الْأُمَّةِ بِهَذِهِ ، وَأَنَا سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ ذَلِكَ قَالَ :  رَأَيْتُ  جِبْرِيلَ  ، ثُمَّ قَالَتْ :  مَنْ زَعَمَ أَنَّ  مُحَمَّدًا  رَأَى رَبَّهُ ، فَقَدْ أَعْظَمَ الْكَذِبَ عَلَى اللهِ  .         [8/305]","","Musnad Abi Ya'la al-Mawsili 4900","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن داود بن أبي هند عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4902","545 - (  4901  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  قُلْتُ لَهَا  : يَا أُمَّتَاهُ - يَعْنِي عَائِشَةَ - هَلْ رَأَى  مُحَمَّدٌ  رَبَّهُ ؟  فَقَالَتْ : لَقَدْ  قَفَّ  شَعَرِي مِمَّا قُلْتَ  .","","Musnad Abi Ya'la al-Mawsili 4901","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4903","546 - (  4902  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  رَأَى  جِبْرِيلَ  فِي صُورَتِهِ مَرَّتَيْنِ  .         [8/306]","","Musnad Abi Ya'la al-Mawsili 4902","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4904","547 - (  4903  ) -  حَدَّثَنَا  سَهْلُ بْنُ زَنْجَلَةَ الرَّازِيُّ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ قَالَ :  سَأَلْتُ  الزُّهْرِيَّ ، أَيُّ أَزْوَاجِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَعَاذَتْ مِنْهُ ؟ قَالَ :  أَخْبَرَنِي  عُرْوَةُ ،  عَنْ  عَائِشَةَ : أَنَّ  بِنْتَ الْجَوْنِ الْكِلَابِيَّةَ  ، لَمَّا أُدْخِلَتْ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَدَنَا مِنْهَا ، قَالَتْ : أَعُوذُ بِاللهِ مِنْكَ قَالَ :  لَقَدْ  عُذْتِ  بِمَعَاذٍ ، الْحَقِي بِأَهْلِكِ  .         [8/307]","","Musnad Abi Ya'la al-Mawsili 4903","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن سهل بن أبي سهل الأشتر عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4905","548 - (  4904  ) -  حَدَّثَنَا  أَبُو عُبَيْدَةَ بْنُ فُضَيْلِ بْنِ عِيَاضٍ ،  حَدَّثَنَا  مَالِكُ بْنُ سُعَيْرِ بْنِ الْخِمْسِ ،  حَدَّثَنَا  السَّرِيُّ بْنُ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  كُنَّا نَضَعُ سِوَاكَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَعَ طُهُورِهِ ، قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ، مَا تَدَعُ السِّوَاكَ قَالَ :  أَجَلْ لَوْ أَنِّي أَقْدِرُ عَلَى أَنْ يَكُونَ ذَلِكَ مِنِّي عِنْدَ كُلِّ  شَفْعٍ  مِنْ صَلَاتِي ، لَفَعَلْتُ  .         [8/308]","","Musnad Abi Ya'la al-Mawsili 4904","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن السري بن إسماعيل الهمداني عن مالك بن سعير التميمي عن أبو عبيدة بن الفضيل بن عياض عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4906","549 - (  4905  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ النَّاقِدُ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا نَفَعَنَا مَالٌ ، مَا نَفَعَنَا مَالُ  أَبِي بَكْرٍ  .","","Musnad Abi Ya'la al-Mawsili 4905","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4907","550 - (  4906  ) -  حَدَّثَنَا  عَمْرٌو النَّاقِدُ ،  حَدَّثَنَا  هُشَيْمُ بْنُ بَشِيرٍ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا نِكَاحَ إِلَّا         [8/309]      بِوَلِيٍّ  ، قَالَ  هُشَيْمٌ  : وَالسُّلْطَانُ وَلِيُّ مَنْ لَا وَلِيَّ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 4906","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن حجاج بن أرطاة عن هشيم بن بشير عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4908","551 - (  4907  ) -  حَدَّثَنَا  عَمْرُو بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  مُعَمَّرُ بْنُ سُلَيْمَانَ الرَّقِّيُّ ،  حَدَّثَنَا  حَجَّاجٌ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا نِكَاحَ إِلَّا بِوَلِيٍّ  ، وَالسُّلْطَانُ وَلِيُّ مَنْ لَا وَلِيَّ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 4907","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن حجاج بن أرطاة عن معمر بن سليمان النخعي عن عمرو بن محمد بن بكير عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4909","552 - (  4908  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ الْعَتَكِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  إِنْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيَدْخُلُ عَلَيَّ وَأَنَا أَلْعَبُ بِاللُّعَبِ  ، فَيَجْلِسُ عِنْدِي يَنْظُرُ إِلَيَّ طَوِيلًا ، ثُمَّ يَقُومُ  .         [8/310]","","Musnad Abi Ya'la al-Mawsili 4908","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الرحمن بن عبد الله بن عمر بن حفص بن عاصم بن عمر بن الخطاب عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4910","553 - (  4909  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  أَبُو شِهَابٍ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  رَخَّصَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الرُّقَى مِنَ الْحُمَةِ  .","","Musnad Abi Ya'la al-Mawsili 4909","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن سليمان بن فيروز الشيباني عن عبد ربه بن نافع الحناط عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4911","554 - (  4910  ) -  أَخْبَرَنِي  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ         [8/311]      الْمُثَنَّى الْمَوْصِلِيِّ قَالَ :  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  حَدَّثَنَا  يَحْيَى الْقَطَّانُ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  مُسْلِمٍ قَالَ :  قَالَ  مَسْرُوقٌ ،  عَنْ  عَائِشَةَ قَالَتْ :  صَنَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّةً أَمْرًا ، فَرَخَّصَ فِيهِ ، فَبَلَغَهُ أَنَّ رِجَالًا تَنَزَّهُوا عَنْهُ ، فَقَامَ فَخَطَبَ ، فَقَالَ :  مَا بَالُ رِجَالٍ عَلِمُوا أَنِّي قَدْ صَنَعْتُ شَيْئًا ، فَتَرَخَّصْتُ فِيهِ ، فَتَنَزَّهُوا عَنْهُ  ، وَاللهِ لَأَنَا أَعْلَمُهُمْ بِاللهِ ، وَأَشَدُّهُمْ لَهُ خَشْيَةً  .","","Musnad Abi Ya'la al-Mawsili 4910","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن يحيى القطان عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4912","555 - (  4911  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  مُسْلِمُ بْنُ خَالِدٍ ،  عَنْ  طَرِيفٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ،         [8/312]      أَنَّ عَائِشَةَ ،  حَدَّثَتْهُمْ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَصُومُ شَعْبَانَ كُلَّهُ ، قَالَتْ : قُلْتُ : يَا رَسُولَ اللهِ ، أَحَبُّ الشُّهُورِ إِلَيْكَ أَنْ تَصُومَهُ شَعْبَانُ قَالَ :  إِنَّ اللهَ يَكْتُبُ عَلَى كُلِّ نَفْسٍ مَيِّتَةٍ تِلْكَ السَّنَةَ  ، فَأُحِبُّ أَنْ يَأْتِيَنِي أَجَلِي وَأَنَا صَائِمٌ  .","","Musnad Abi Ya'la al-Mawsili 4911","","عائشة بنت أبي بكر الصديق عن أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن طريف بن الدفاع الحنفي عن مسلم بن خالد الزنجي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4913","556 - (  4912  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ أَنْ يَعْتَكِفَ ، صَلَّى الصُّبْحَ ، فَدَخَلَ مُعْتَكَفَهُ ، فَلَمَّا كَانَ صَبِيحَةَ إِحْدَى وَعِشْرِينَ انْصَرَفَ مِنَ الصُّبْحِ ، فَدَخَلَ الْمَسْجِدَ ، فَرَأَى أَخْبِيَةً ، خِبَاءَ  عَائِشَةَ  ، وَكَانَتِ اسْتَأْذَنَتْهُ ،  وَحَفْصَةَ  ،  وَزَيْنَبَ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  آلْبِرَّ تُرِدْنَ بِهِنَّ ؟  فَأَخَّرَ اعْتِكَافَهُ إِلَى شَوَّالٍ  .         [8/313]","","Musnad Abi Ya'la al-Mawsili 4912","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن عبد العزيز بن محمد الدراوردي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4914","557 - (  4913  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَسْرُوقٍ قَالَ :  قَالَتْ  عَائِشَةُ :  سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الِالْتِفَاتِ فِي الصَّلَاةِ ، فَقَالَ :  هُوَ اخْتِلَاسٌ يَخْتَلِسُهُ الشَّيْطَانُ مِنْ صَلَاةِ الْعَبْدِ  .","","Musnad Abi Ya'la al-Mawsili 4913","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن سليم بن أسود المحاربي عن أشعث بن أبي الشعثاء عن سلام بن سليم الحنفي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4915","558 - (  4914  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  حَدَّثَنَا  مُوسَى بْنُ عُبَيْدَةَ ،  أَخْبَرَنِي  عَمْرُو بْنُ هَانِئٍ ،  عَنْ  عَاصِمِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَالَ لَهَا : نَاوِلِينِي رِدَائِي ، فَنَاوَلَتْهُ ، فَخَرَجَ ، فَصَعِدَ الْمِنْبَرَ ، وَاجْتَمَعَ النَّاسُ إِلَيْهِ ، فَقَالَ :  أَيُّهَا النَّاسُ ، إِنَّ اللهَ ، يَقُولُ : لَتَأْمُرُنَّ بِالْمَعْرُوفِ ، وَلَتَنْهَوُنَّ عَنِ الْمُنْكَرِ ، قَبْلَ أَنْ تُجْدِبُوا  ، فَتَسْتَسْقُونَ ، فَلَا تُسْقَوْنَ .  أَيُّهَا النَّاسُ ، إِنَّ اللهَ ، يَقُولُ : لَتَأْمُرُنَّ بِالْمَعْرُوفِ ، وَلَتَنْهَوُنَّ عَنِ الْمُنْكَرِ ، قَبْلَ أَنْ تَدْعُوا فَلَا يُسْتَجَابُ لَكُمْ  .         [8/314]             [8/315]","","Musnad Abi Ya'la al-Mawsili 4914","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن عمرو بن عثمان بن هانئ المدني عن موسى بن عبيدة بن نشيط الحميري عن زيد بن الحباب العكلي عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4916","559 - (  4915  ) -  قَالَ :  سَأَلْتُ  عَبْدَ الْأَعْلَى ، عَنْ حَدِيثِ  أَبِي بَكْرٍ الصِّدِّيقِ  ، فَقَالَ : هَذَا خَطَأٌ  ،  وَحَدَّثَنِي بِهِ  قَالَ :  حَدَّثَنَا  حَمَّادٌ ،  عَنِ  ابْنِ أَبِي عَتِيقٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي بَكْرٍ الصِّدِّيقِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  السِّوَاكُ مَطْهَرَةٌ لِلْفَمِ  ، مَرْضَاةٌ لِلرَّبِّ  .","","Musnad Abi Ya'la al-Mawsili 4915","","أبو  بكر الصديق عن عبد الله بن أبي عتيق التيمي عن محمد بن عبد الله بن أبي عتيق القرشي عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4917","560 - (  4916  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى ،  حَدَّثَنَا  أَيْضًا الدَّرَاوَرْدِيُّ عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنِ  ابْنِ أَبِي عَتِيقٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  السِّوَاكُ مَطْهَرَةٌ لِلْفَمِ  ، مَرْضَاةٌ لِلرَّبِّ  .","","Musnad Abi Ya'la al-Mawsili 4916","","عائشة بنت أبي بكر الصديق عن عبد الله بن أبي عتيق التيمي عن محمد بن عبد الله بن أبي عتيق القرشي عن عبد العزيز بن محمد الدراوردي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4918","561 - (  4917  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  رَجُلٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  فِي قَوْلِهِ :         {      وَالَّذِينَ يُؤْتُونَ مَا آتَوْا وَقُلُوبُهُمْ وَجِلَةٌ أَنَّهُمْ إِلَى رَبِّهِمْ رَاجِعُونَ         }      قَالَ :  يَا  بِنْتَ الصِّدِّيقِ  - أَوْ يَا  بِنْتَ أَبِي بَكْرٍ  - الَّذِينَ يُصَلُّونَ ، وَيَصُومُونَ وَهُمْ يَفْرَقُونَ أَنْ لَا تُتَقَبَّلَ مِنْهُمْ  ، وَيَتَصَدَّقُونَ وَيَفْرَقُونَ أَنْ لَا تُتَقَبَّلَ مِنْهُمْ  .         [8/316]","","Musnad Abi Ya'la al-Mawsili 4917","","عائشة بنت أبي بكر الصديق عن رجل عن ليث بن أبي سليم عن جرير بن عبد الحميد عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4919","562 - (  4918  ) -  حَدَّثَنَا  عَمْرُو بْنُ حُصَيْنٍ ،  حَدَّثَنَا  ابْنُ عُلَاثَةَ ،  حَدَّثَنِي  الْأَوْزَاعِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ نَامَ بَعْدَ الْعَصْرِ  ، فَاخْتُلِسَ عَقْلُهُ ، فَلَا يَلُومَنَّ إِلَّا نَفْسَهُ  .         [8/317]","","Musnad Abi Ya'la al-Mawsili 4918","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن أبو عمرو الأوزاعي عن قاضي الجن محمد بن عبد الله بن علاثة عن عمرو بن الحصين العقيلي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4920","563 - (  4919  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَجْلَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  إِنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ  ، سَأَلَ رَسُولَ         [8/318]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، أَصُومُ فِي السَّفَرِ ؟ قَالَ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Musnad Abi Ya'la al-Mawsili 4919","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن عجلان عن محمد بن سلمة الباهلي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4921","564 - (  4920  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  أَبُو مَعْشَرٍ ،  عَنْ  سَعِيدٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  عَائِشَةُ  ، لَوْ شِئْتُ لَسَارَتْ مَعِي جِبَالُ الذَّهَبِ  ، جَاءَنِي مَلَكٌ إِنَّ  حُجْزَتَهُ  لَتُسَاوِي  الْكَعْبَةَ  ، فَقَالَ : إِنَّ رَبَّكَ يَقْرَأُ عَلَيْكَ السَّلَامَ ، وَيَقُولُ لَكَ : إِنْ شِئْتَ نَبِيًّا عَبْدًا ، وَإِنْ شِئْتَ نَبِيًّا مَلِكًا قَالَ : فَنَظَرْتُ إِلَى  جِبْرِيلَ  قَالَ : فَأَشَارَ إِلَيَّ أَنْ ضَعْ نَفْسَكَ قَالَ : فَقُلْتُ : نَبِيًّا عَبْدًا قَالَ : فَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَ ذَلِكَ ، لَا يَأْكُلُ  مُتَّكِئًا  ، يَقُولُ : آكُلُ كَمَا يَأْكُلُ الْعَبْدُ ، وَأَجْلِسُ كَمَا يَجْلِسُ الْعَبْدُ  .         [8/319]","","Musnad Abi Ya'la al-Mawsili 4920","","عائشة بنت أبي بكر الصديق عن سعيد المقبري عن نجيح بن عبد الرحمن السندي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4922","565 - (  4921  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  أَبُو مَعْشَرٍ ،  حَدَّثَنِي  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَعَلَ  عِدَّةَ  بَرِيرَةَ  حِينَ فَارَقَهَا زَوْجُهَا  ،  عِدَّةَ  الْمُطَلَّقَةِ  .","","Musnad Abi Ya'la al-Mawsili 4921","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن نجيح بن عبد الرحمن السندي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4923","566 - (  4922  ) -  حَدَّثَنَا  حُمَيْدُ بْنُ الرَّبِيعِ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَطَاءٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُحَمَّدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي الزُّبَيْرِ ،  أَنَّ  عَائِشَةَ زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْتَعِيذُ فِي صَلَاتِهِ مِنْ فِتْنَةِ  الْمَسِيحِ الدَّجَّالِ  .         [8/320]","","Musnad Abi Ya'la al-Mawsili 4922","","عائشة بنت أبي بكر الصديق عن أبو الزبير المكي عن الزهري عن الوليد بن محمد الموقرى عن عبد الله بن عثمان بن عطاء بن أبي مسلم عن حميد بن الربيع الجلاد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4924","567 - (  4923  ) -  حَدَّثَنَا  مُوسَى بْنُ حَيَّانَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبَّاسٍ ،  عَنْ  عَبْدِ اللهِ الْأَسْلَمِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ قَالَتْ :  أُتِيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِظَبْيَةٍ  فِيهَا خَرَزٌ  ، فَقَسَمَهَا لِلْحُرِّ وَالْأَمَةِ ، قَالَتْ :  وَكَانَ أَبِي يَقْسِمُ لِلْحُرِّ وَالْعَبْدِ  .","","Musnad Abi Ya'la al-Mawsili 4923","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عبد الله بن نيار الأسلمي عن القاسم بن العباس اللهبي عن محمد بن عبد الرحمن بن المغيرة عن روح بن عبادة القيسي عن موسى بن محمد بن سعيد البصري عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4925","568 - (  4924  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ سَجَّادَةُ ،  حَدَّثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَسَمَ سُورَةَ الْبَقَرَةِ فِي رَكْعَتَيْنِ  .         [8/321]","","Musnad Abi Ya'la al-Mawsili 4924","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حفص بن غياث النخعي عن الحسن بن حماد سجادة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4926","569 - (  4925  ) -  حَدَّثَنَا  مُسْلِمُ بْنُ أَبِي مُسْلِمٍ الْجَرْمِيُّ ،  حَدَّثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ،  أَنَّهَا ذُكِرَ لَهَا أَنَّ قَوْمًا ، يَقُولُونَ : لَا غُسْلَ إِلَّا مِنَ الْمَاءِ  ، فَقَالَتْ : قَدْ فَعَلْتُ ذَلِكَ أَنَا وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاغْتَسَلْنَا  .","","Musnad Abi Ya'la al-Mawsili 4925","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن أبو عمرو الأوزاعي عن عيسى بن يونس بن أبي إسحاق عن مسلم بن أبي مسلم الجرمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4927","570 - (  4926  ) -  حَدَّثَنَا  مُسْلِمٌ الْجَرْمِيُّ ،  حَدَّثَنَا  مَخْلَدٌ ،  عَنْ  هِشَامٍ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  تَذَاكَرُوا فِي حَلْقَةٍ أَنَا فِيهَا مَا يُوجِبُ الْغُسْلَ  ، فَقَالَ بَعْضُهُمْ : إِذَا خَالَطَ الرَّجُلُ ، وَقَالَ بَعْضُهُمْ : حَتَّى يَنْزِلَ الْمَاءُ قَالَ : فَقُلْتُ : أَنَا آتِيكُمْ بِعِلْمِ ذَلِكَ .         [8/322]      فَأَتَيْتُ  عَائِشَةَ أُمَّ الْمُؤْمِنِينَ ، فَقُلْتُ لَهَا : يَا أُمَّ الْمُؤْمِنِينَ ، إِنِّي أُرِيدُ أَنْ أَسْأَلَكِ عَنْ شَيْءٍ ، وَأَنَا أَسْتَحِي أَنْ أَسْأَلَكِ عَنْهُ ، فَقَالَتْ : لَا تَسْتَحِي أَنْ تَسْأَلَنِي عَمَّا كُنْتَ سَائِلًا عَنْهُ أُمَّكَ ، فَإِنَّمَا أَنَا أُمُّكَ ، فَقُلْتُ : يَا أُمَّهْ ، مَا يُوجِبُ الْغُسْلَ ؟ فَقَالَتْ : عَلَى الْخَبِيرِ  سَقَطْتَ  ، إِذَا قَعَدَ بَيْنَ  شُعَبِهَا  الْأَرْبَعِ ،  وَالْتَقَى  الْخِتَانَانِ ،  فَقَدْ وَجَبَ الْغُسْلُ  .","","Musnad Abi Ya'la al-Mawsili 4926","","عائشة بنت أبي بكر الصديق عن أبو هريرة الدوسي عن محمد بن سيرين عن هشام بن حسان العتكي عن مخلد بن الحسين المهلبي عن مسلم بن أبي مسلم الجرمي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4928","571 - (  4927  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  فُلَيْحُ بْنُ سُلَيْمَانَ الْمَدَنِيُّ ،  عَنِ  ابْنِ شِهَابٍ الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ، وَسَعِيدِ بْنِ الْمُسَيِّبِ ، وَعَلْقَمَةَ بْنِ وَقَّاصٍ اللَّيْثِيِّ ، وَعُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  عَائِشَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ قَالَ لَهَا أَهْلُ  الْإِفْكِ  مَا قَالُوا ،         [8/323]      فَبَرَّأَهَا اللهُ مِنْهُ ، قَالَ  الزُّهْرِيُّ  - وَكُلُّهُمْ حَدَّثَنِي طَائِفَةً مِنْ حَدِيثِهَا ، وَبَعْضُهُمْ أَوْعَى لَهُ مِنْ بَعْضٍ ، وَأَثْبَتُ لَهُ مِنْ بَعْضٍ ، وَأَثْبَتُ لَهُ اقْتِصَاصًا ، وَقَدْ  وَعَيْتُ  عَنْ كُلِّ رَجُلٍ مِنْهُمُ الْحَدِيثَ الَّذِي حَدَّثَنِي بِهِ ، عَنْ  عَائِشَةَ  ، وَبَعْضُ حَدِيثِهِمْ يُصَدِّقُ بَعْضًا - : زَعَمُوا أَنَّ  عَائِشَةَ  قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ سَفَرًا أَقْرَعَ بَيْنَ أَزْوَاجِهِ ، فَأَيَّتُهُنَّ خَرَجَ سَهْمُهَا ، خَرَجَ بِهَا مَعَهُ . قَالَتْ : فَأَقْرَعَ بَيْنَنَا فِي غَزْوَةٍ غَزَاهَا ، فَخَرَجَ  سَهْمِي  ، فَخَرَجْتُ مَعَهُ ، بَعْدَمَا أُنْزِلَ الْحِجَابُ ، فَأَنَا أُحْمَلُ فِي هَوْدَجٍ ، وَأُنْزَلُ فِيهِ ، فَسِرْنَا حَتَّى إِذَا فَرَغَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ غَزْوَتِهِ تِلْكَ ، وَقَفَلَ ، وَدَنَوْنَا مِنَ  الْمَدِينَةِ  ، آذَنَ لَيْلَةً بِالرَّحِيلِ ، فَقُمْتُ حِينَ آذَنُوا بِالرَّحِيلِ ، فَمَشَيْتُ حَتَّى جَاوَزْتُ الْجَيْشَ ، فَلَمَّا قَضَيْتُ شَأْنِي ، أَقْبَلْتُ إِلَى الرَّحْلِ ، فَلَمَسْتُ صَدْرِي ، فَإِذَا عِقْدٌ لِي مِنْ  جَزْعِ  أَظْفَارٍ  قَدِ انْقَطَعَ ، فَرَجَعْتُ ،  فَالْتَمَسْتُ  عِقْدِي ، فَحَبَسَنِي ابْتِغَاؤُهُ ،         [8/324]      فَأَقْبَلَ الَّذِينَ يَرْحَلُونَ بِي ، فَاحْتَمَلُوا هَوْدَجِي ، فَرَحَلُوهُ عَلَى بَعِيرِي الَّذِي كُنْتُ أَرْكَبُ ، وَهُمْ يَحْسَبُونَ أَنِّي فِيهِ ، وَكَانَ النِّسَاءُ إِذْ ذَاكَ خِفَافًا لَمْ يَثْقُلْنَ ، وَلَمْ يَغْشَهُنَّ اللَّحْمُ ، وَإِنَّمَا يَأْكُلْنَ  الْعُلْقَةَ  مِنَ الطَّعَامِ ، فَلَمْ يَسْتَنْكِرِ  الْقَوْمُ  حِينَ رَفَعُوا ثِقَلَ الْهَوْدَجِ ، وَاحْتَمَلُوهُ وَكُنْتُ جَارِيَةً ، حَدِيثَةَ السِّنِّ ، فَبَعَثُوا الْجَمَلَ وَسَارُوا ، فَوَجَدْتُ عِقْدِي بَعْدَمَا اسْتَمَرَّ الْجَيْشُ ، فَجِئْتُ مَنْزِلَهُمْ ، وَلَيْسَ         [8/325]      فِيهِ أَحَدٌ ، فَأَمَّمْتُ مَنْزِلِي الَّذِي كُنْتُ فِيهِ ، وَظَنَنْتُ أَنَّهُمْ سَيَفْقِدُونَنِي ، فَيَرْجِعُونَ إِلَيَّ ، فَبَيْنَا أَنَا جَالِسَةٌ فِي مَنْزِلِي ، غَلَبَتْنِي عَيْنَايَ ، فَنِمْتُ ، وَكَانَ  صَفْوَانُ بْنُ الْمُعَطَّلِ السُّلَمِيُّ ثُمَّ الذَّكْوَانِيُّ  ، مِنْ وَرَاءِ الْجَيْشِ ، فَأَصْبَحَ عِنْدَ مَنْزِلِي ، فَرَأَى سَوَادَ إِنْسَانٍ فَأَتَانِي ، وَكَانَ يَرَانِي قَبْلَ الْحِجَابِ ، فَاسْتَيْقَظْتُ بِاسْتِرْجَاعِهِ حِينَ عَرَفَنِي ،  فَخَمَّرْتُ  وَجْهِي بِجِلْبَابِي ، وَاللهِ مَا تَكَلَّمْتُ بِكَلِمَةٍ ، وَلَا سَمِعْتُ مِنْهُ كَلِمَةً غَيْرَ اسْتِرْجَاعِهِ ، حَتَّى أَنَاخَ رَاحِلَتَهُ ، فَوَطِئَ يَدَهَا فَرَكِبْتُهَا ، فَانْطَلَقَ يَقُودُ بِي الرَّاحِلَةَ حَتَّى أَتَيْنَا الْجَيْشَ مُعَرِّسِينَ فِي  نَحْرِ  الظَّهِيرَةِ ، فَهَلَكَ مَنْ هَلَكَ ، وَكَانَ الَّذِي تَوَلَّى  كِبْرَهُ  عَبْدُ اللَّهِ بْنُ أُبَيٍّ ابْنُ سَلُولَ  ، فَقَدِمْنَا  الْمَدِينَةَ  ، فَاشْتَكَيْتُ بِهَا شَهْرًا ، وَالنَّاسُ يُفِيضُونَ فِي قَوْلِ أَصْحَابِ  الْإِفْكِ  ، لَا أَشْعُرُ بِشَيْءٍ مِنْ ذَلِكَ ، وَيَرِيبُنِي فِي وَجَعِي أَنِّي لَا أَعْرِفُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  اللُّطْفَ  الَّذِي أَرَى مِنْهُ حِينَ أَمْرَضُ ، إِنَّمَا يَدْخُلُ ، فَيُسَلِّمُ ، ثُمَّ         [8/326]      يَقُولُ : كَيْفَ تِيكُمْ ؟ فَذَلِكَ يَرِيبُنِي ، وَلَا أَشْعُرُ حَتَّى نَقَهْتُ ، فَخَرَجْتُ أَنَا ،  وَأُمُّ مِسْطَحٍ بِنْتُ أَبِي رُهْمٍ  قِبَلَ  الْمَنَاصِعِ  مُتَبَرَّزِنَا لَا نَخْرُجُ إِلَّا لَيْلًا إِلَى لَيْلٍ ، وَذَلِكَ قَبْلَ أَنْ نَتَّخِذَ الْكُنُفَ قَرِيبًا مِنْ بُيُوتِنَا ، وَأَمْرُنَا أَمْرُ الْعَرَبِ  الْأُوَلِ  فِي الْبَرِّيَّةِ أَوْ فِي التَّنَزُّهِ ، فَأَقْبَلْتُ أَنَا ،  وَأُمُّ مِسْطَحٍ بِنْتُ أَبِي رُهْمٍ  ، نَمْشِي فَعَثَرَتْ فِي مِرْطِهَا ، فَقَالَتْ :  تَعِسَ  مِسْطَحٌ  ، فَقُلْتُ لَهَا : بِئْسَ مَا قُلْتِ أَتَسُبِّينَ رَجُلًا شَهِدَ  بَدْرًا  ؟ قَالَتْ : يَا  هَنْتَاهُ ،  أَلَمْ تَسْمَعِي مَا قَالُوا ؟ قَالَتْ : قُلْتُ : وَمَا قَالُوا ؟ فَأَخْبَرَتْنِي بِقَوْلِ أَهْلِ  الْإِفْكِ  ، فَازْدَدْتُ         [8/327]      مَرَضًا عَلَى مَرَضِي ، فَلَمَّا رَجَعْتُ إِلَى بَيْتِي ، دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : كَيْفَ تِيكُمْ ؟ فَقُلْتُ : ائْذَنْ لِي آتِ أَبَوَيَّ ، قَالَتْ : وَأَنَا حِينَئِذٍ أُرِيدُ أَنْ أَسْتَيْقِنَ الْخَبَرَ مِنْ قِبَلِهِمَا ، قَالَتْ : فَأَذِنَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَيْتُ أَبَوَيَّ ، فَقُلْتُ لِأُمِّي : مَا يَتَحَدَّثُ النَّاسُ ؟ فَقَالَتْ : يَا بُنَيَّةُ هَوِّنِي عَلَى نَفْسِكِ الشَّأْنَ ، فَوَاللهِ ، لَقَلَّمَا كَانَتِ امْرَأَةٌ قَطُّ  وَضِيئَةٌ  عِنْدَ رَجُلٍ يُحِبُّهَا ، وَلَهَا ضَرَائِرُ إِلَّا أَكْثَرْنَ عَلَيْهَا ، قَالَتْ : فَقُلْتُ : سُبْحَانَ اللهِ وَلَقَدْ تَحَدَّثَ النَّاسُ بِهَذَا ؟ فَبِتُّ تِلْكَ اللَّيْلَةَ حَتَّى أَصْبَحْتُ ، لَا  يَرْقَأُ  لِي دَمْعٌ ، وَلَا أَكْتَحِلُ بِنَوْمٍ ، ثُمَّ أَصْبَحْتُ ، وَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَلِيَّ بْنَ أَبِي طَالِبٍ  ،  وَأُسَامَةَ بْنَ زَيْدٍ  ، حِينَ  اسْتَلْبَثَ  الْوَحْيُ ، يَسْتَشِيرُهُمَا فِي فِرَاقِ أَهْلِهِ .  قَالَتْ : فَأَمَّا  أُسَامَةُ بْنُ زَيْدٍ  ، فَأَشَارَ عَلَيْهِ بِالَّذِي يَعْلَمُ مِنْ بَرَاءَةِ أَهْلِهِ ، وَبِالَّذِي يَعْلَمُ فِي نَفْسِهِ مِنَ الْوُدِّ لَهَا ، فَقَالَ  أُسَامَةُ  : أَهْلَكَ يَا رَسُولَ اللهِ ، وَلَا نَعْلَمُ وَاللهِ إِلَّا خَيْرًا .  وَأَمَّا  عَلِيُّ بْنُ أَبِي طَالِبٍ  ، فَقَالَ : يَا رَسُولَ اللهِ ، لَمْ يُضَيِّقِ اللهُ عَلَيْكَ ، وَالنِّسَاءُ سِوَاهَا كَثِيرٌ ، وَسَلِ الْجَارِيَةَ تَصْدُقْكَ .  قَالَتْ : فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بَرِيرَةَ  ، فَقَالَ : يَا  بَرِيرَةُ  ، هَلْ رَأَيْتِ مِنْهَا شَيْئًا  يَرِيبُكِ  ؟ فَقَالَتْ  بَرِيرَةُ  : لَا وَالَّذِي بَعَثَكَ بِالْحَقِّ ،         [8/328]      إِنْ رَأَيْتُ مِنْهَا أَمْرًا  أَغْمِصُهُ  عَلَيْهَا ، أَكْثَرَ مِنْ أَنَّهَا جَارِيَةٌ حَدِيثَةُ السِّنِّ ، تَنَامُ عَنِ الْعَجِينِ ، فَتَأْتِي  الدَّاجِنُ  ، فَتَأْكُلُهُ . قَالَتْ : فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ يَوْمِهِ ، فَاسْتَعْذَرَ مِنْ  عَبْدِ اللهِ بْنِ أُبَيٍّ ابْنِ سَلُولَ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ  يَعْذِرُنِي  مِنْ رَجُلٍ بَلَغَ أَذَاهُ فِي أَهْلِي ، فَوَاللهِ ، فَوَاللهِ ، فَوَاللهِ - ثَلَاثَ مَرَّاتٍ - مَا عَلِمْتُ عَلَى أَهْلِي إِلَّا خَيْرًا  ، وَقَدْ ذَكَرُوا رَجُلًا مَا عَلِمْتُ عَلَيْهِ إِلَّا خَيْرًا ، وَمَا كَانَ يَدْخُلُ عَلَى أَهْلِي إِلَّا مَعِي . فَقَامَ  سَعْدُ بْنُ مُعَاذٍ  ، فَقَالَ : يَا رَسُولَ اللهِ ، أَنَا وَاللهِ  أَعْذِرُكَ         [8/329]      مِنْهُ ، إِنْ كَانَ مِنَ  الْأَوْسِ  ضَرَبْنَا عُنُقَهُ ، وَإِنْ كَانَ مِنْ إِخْوَانِنَا  الْخَزْرَجِ  أَمَرْتَنَا فَفَعَلْنَا فِيهِ أَمْرَكَ . فَقَامَ  سَعْدُ بْنُ عُبَادَةَ  وَهُوَ سَيِّدُ  الْخَزْرَجِ  ، وَكَانَ قَبْلَ ذَلِكَ رَجُلًا صَالِحًا ، وَلَكِنِ احْتَمَلَتْهُ الْحَمِيَّةُ ، فَقَالَ : كَذَبْتَ ،  لَعَمْرُ  اللهِ ، وَاللهِ ، لَا تَقْتُلُهُ ، وَلَا تَقْدِرُ عَلَى قَتْلِهِ . فَقَامَ  أُسَيْدُ بْنُ حُضَيْرٍ  ، فَقَالَ : كَذَبْتَ ،  لَعَمْرُ  اللهِ ، وَاللهِ ، لَنَقْتُلَنَّهُ ، فَإِنَّكَ مُنَافِقٌ ، تُجَادِلُ عَنِ الْمُنَافِقِينَ .         [8/330]      قَالَ : فَثَارَ الْحَيَّانِ ،  الْأَوْسُ  ،  وَالْخَزْرَجُ  ، حَتَّى مَضَوْا ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَائِمٌ عَلَى الْمِنْبَرِ قَالَ : فَنَزَلَ ، فَخَفَّضَهُمْ ، حَتَّى سَكَتُوا ، وَسَكَتَ .  قَالَتْ : وَبَكَيْتُ يَوْمِي لَا  يَرْقَأُ  لِي دَمْعٌ ، وَلَا أَكْتَحِلُ بِنَوْمٍ ، فَأَصْبَحَ عِنْدِي أَبَوَايَ ، وَقَدْ بَكَيْتُ لَيْلَتَيْنِ وَيَوْمًا ، حَتَّى أَظُنُّ أَنَّ الْبُكَاءَ  فَالِقٌ  كَبِدِي .  قَالَتْ : فَبَيْنَا هُمَا جَالِسَانِ عِنْدِي ، وَأَنَا أَبْكِي ، إِذِ اسْتَأْذَنَتِ  امْرَأَةٌ مِنَ الْأَنْصَارِ  ، فَأَذِنْتُ لَهَا ، فَجَلَسَتْ تَبْكِي مَعِي ، فَبَيْنَا نَحْنُ كَذَلِكَ ، إِذْ دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَلَسَ ، وَلَمْ يَجْلِسْ عِنْدِي مِنْ يَوْمِ قِيلَ مَا قِيلَ قَبْلَهَا ، وَقَدْ مَكَثَ شَهْرًا لَا يُوحَى إِلَيْهِ فِي شَأْنِي .  قَالَتْ : فَتَشَهَّدَ ، ثُمَّ قَالَ : أَمَّا بَعْدُ ، يَا  عَائِشَةُ  ، فَإِنَّهُ بَلَغَنِي عَنْكِ كَذَا وَكَذَا ، فَإِنْ كُنْتِ بَرِيئَةً ، فَسَيُبَرِّئُكِ اللهُ ، وَإِنْ كُنْتِ  أَلْمَمْتِ ،  فَاسْتَغْفِرِي اللهَ ، وَتُوبِي إِلَيْهِ ، فَإِنَّ الْعَبْدَ إِذَا اعْتَرَفَ بِذَنْبِهِ ، ثُمَّ تَابَ ، تَابَ اللهُ عَلَيْهِ .  فَلَمَّا قَضَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَقَالَتَهُ ، قَلَصَ دَمْعِي ، حَتَّى مَا         [8/331]      أُحِسُّ مِنْهُ قَطْرَةً ، فَقُلْتُ لِأَبِي : أَجِبْ عَنِّي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيمَا قَالَ . قَالَتْ : فَقَالَ : وَاللهِ مَا أَدْرِي مَا أَقُولُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .  فَقُلْتُ لِأُمِّي : أَجِيبِي عَنِّي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيمَا قَالَ ، قَالَتْ : وَاللهِ مَا أَقُولُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .  قَالَتْ : وَأَنَا جَارِيَةٌ حَدِيثَةُ السِّنِّ ، لَا أَقْرَأُ كَثِيرًا مِنَ الْقُرْآنِ ، فَقُلْتُ : إِنِّي وَاللهِ لَقَدْ عَلِمْتُ أَنَّكُمْ سَمِعْتُمْ بِمَا تُحُدِّثَ بِهِ ، وَقَدْ قَرَّ فِي أَنْفُسِكُمْ ، وَصَدَّقْتُمْ بِهِ ، وَلَئِنْ قُلْتُ لَكُمْ : إِنِّي لَبَرِيئَةٌ - وَاللهُ يَعْلَمُ إِنِّي لَبَرِيئَةٌ - لَا تُصَدِّقُونَنِي بِذَلِكَ ، وَلَئِنِ اعْتَرَفْتُ لَكُمْ بِأَمْرٍ - اللهُ يَعْلَمُ أَنِّي مِنْهُ بَرِيئَةٌ - لَتُصَدِّقُنِّي ، وَاللهِ مَا أَجِدُ لِي وَلَكُمْ مَثَلًا إِلَّا  أَبَا يُوسُفَ  ، إِذْ قَالَ :         {      فَصَبْرٌ جَمِيلٌ وَاللهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ         }      .  قَالَتْ : ثُمَّ تَحَوَّلْتُ عَلَى فِرَاشِي ، وَأَنَا أَرْجُو أَنْ يُبَرِّئَنِي اللهُ ، وَلَكِنْ وَاللهِ مَا ظَنَنْتُ أَنْ يَنْزِلَ فِي شَأْنِي وَحْيٌ يُتْلَى ، وَأَنَا أَحْقَرُ فِي نَفْسِي مِنْ أَنْ يُتَكَلَّمَ بِالْقُرْآنِ فِي أَمْرِي ، وَلَكِنْ كُنْتُ أَرْجُو أَنْ يَرَى نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي النَّوْمِ رُؤْيَا تُبَرِّئُنِي .  قَالَتْ : فَوَاللهِ ، مَا  رَامَ  مَجْلِسَهُ ، وَلَا خَرَجَ أَحَدٌ مِنْ أَهْلِ الْبَيْتِ ، حَتَّى أُنْزِلَ عَلَيْهِ ، فَأَخَذَهُ مَا كَانَ يَأْخُذُهُ مِنَ  الْبُرَحَاءِ ،  حَتَّى إِنَّهُ يَتَحَدَّرُ         [8/332]      مِنْهُ مِثْلُ  الْجُمَانِ  مِنَ الْعَرَقِ ، فِي يَوْمٍ شَاتٍ .  قَالَتْ : فَلَمَّا  سُرِّيَ  عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَضْحَكُ ، فَكَانَ أَوَّلَ كَلِمَةٍ تَكَلَّمَ بِهَا ، أَنْ قَالَ : يَا  عَائِشَةُ  ، احْمَدِي اللهَ ، فَقَدْ بَرَّأَكِ .  قَالَتْ لِي أُمِّي : قُومِي إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : وَاللهِ لَا أَقُومُ إِلَيْهِ ، وَلَا أَحْمَدُ إِلَّا اللهَ وَأَنْزَلَ اللهُ :         {      إِنَّ الَّذِينَ جَاءُوا بِالإِفْكِ عُصْبَةٌ مِنْكُمْ         }      الْآيَاتِ كُلَّهَا ، فَلَمَّا أَنْزَلَ اللهُ هَذَا فِي بَرَاءَتِي ، قَالَ  أَبُو بَكْرٍ الصِّدِّيقُ  - وَكَانَ يُنْفِقُ عَلَى  مِسْطَحِ بْنِ أُثَاثَةَ  ، لِقَرَابَتِهِ مِنْهُ - : وَاللهِ ، لَا أُنْفِقُ عَلَى  مِسْطَحٍ  شَيْئًا أَبَدًا بَعْدَمَا قَالَ  لِعَائِشَةَ  ، فَأَنْزَلَ اللهُ هَذِهِ الْآيَةَ :         {      وَلا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ أَنْ يُؤْتُوا أُولِي الْقُرْبَى وَالْمَسَاكِينَ وَالْمُهَاجِرِينَ فِي سَبِيلِ اللهِ وَلْيَعْفُوا وَلْيَصْفَحُوا أَلا تُحِبُّونَ أَنْ يَغْفِرَ اللهُ لَكُمْ وَاللهُ غَفُورٌ رَحِيمٌ         }      .  قَالَ  أَبُو بَكْرٍ  : بَلَى ، وَاللهِ ، إِنِّي لَأُحِبُّ أَنْ يَغْفِرَ اللهُ لِي ، فَرَجَعَ إِلَى  مِسْطَحٍ  الَّذِي كَانَ يُجْرِي عَلَيْهِ .  وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَأَلَ  زَيْنَبَ بِنْتَ جَحْشٍ  عَنْ أَمْرِي ، فَقَالَ : يَا  زَيْنَبُ  ، مَا عَلِمْتِ ، وَمَا رَأَيْتِ ؟ قَالَتْ : يَا رَسُولَ اللهِ ،  أَحْمِي  سَمْعِي وَبَصَرِي ، فَوَاللهِ مَا عَلِمْتُ عَلَيْهَا إِلَّا خَيْرًا .         [8/333]      قَالَتْ  عَائِشَةُ  : وَهِيَ الَّتِي  تُسَامِينِي ،  فَعَصَمَهَا  اللهُ  بِالْوَرَعِ  .         [8/334]","","Musnad Abi Ya'la al-Mawsili 4927","","عائشة بنت أبي بكر الصديق عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن فليح بن سليمان عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4929","572 - (  4928  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  فُلَيْحٌ ،  عَنْ  رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ ، وَيَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدِ بْنِ أَبِي بَكْرٍ ، بِمِثْلِهِ .","","Musnad Abi Ya'la al-Mawsili 4928","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن فليح بن سليمان عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4930","573 - (  4929  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  فُلَيْحٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، وَعَبْدِ اللهِ بْنِ الزُّبَيْرِ ، بِمِثْلِهِ .","","Musnad Abi Ya'la al-Mawsili 4929","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن فليح بن سليمان عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4931","574 - (  4930  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ قَالَ :  قَالَ  فُلَيْحٌ :  سَمِعْتُ  نَاسًا مِنْ أَهْلِ الْعِلْمَ يَقُولُونَ :  إِنَّ أَصْحَابَ الْإِفْكِ جُلِدُوا  الْحَدَّ  وَلَا نَعْلَمُ ذَلِكَ  .         [8/335]","","Musnad Abi Ya'la al-Mawsili 4930","","أحد الصحابة عن ناس من أهل العلم عن فليح بن سليمان عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4932","575 - (  4931  ) -  حَدَّثَنَا  حَوْثَرَةُ بْنُ أَشْرَسَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  عَنْ  عَائِشَةَ قَالَتْ :  لَقَدْ تَحَدَّثَ النَّاسُ بِهَذَا الْأَمْرِ ، وَشَاعَ فِيهِمْ  ، وَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَطِيبًا ، وَمَا أَشْعُرُ بِهِ . قَالَتْ : فَخَرَجْتُ ذَاتَ لَيْلَةٍ مَعَ  أُمِّ مِسْطَحٍ  ، لِأَقْضِيَ حَاجَةً ، فَعَثَرَتْ ، فَقَالَتْ :  تَعِسَ  مِسْطَحٌ  فَقُلْتُ : سُبْحَانَ اللهِ عَلَامَ تَسُبِّينَ ابْنَكِ وَهُوَ مِنَ  الْمُهَاجِرِينَ  الْأَوَّلِينَ ، وَقَدْ شَهِدَ  بَدْرًا  ؟ فَقَالَتْ : وَاللهِ مَا أَسُبُّهُ إِلَّا فِيكِ ، قُلْتُ : وَمَا شَأْنِي ؟ فَأَخْبَرَتْنِي بِالْأَمْرِ ، فَذَهَبَتْ حَاجَتِي ، فَمَا أَجِدُ مِنْهَا شَيْئًا ، وَحُمِمْتُ ، فَأَتَيْتُ الْمَنْزِلَ ، فَإِذَا أُمِّي أَسْفَلُ ، وَإِذَا أَبِي فَوْقَ الْبَيْتِ يُصَلِّي ، فَالْتَزَمَتْنِي ، فَبَكَتْ ، وَبَكَيْتُ ، فَسَمِعَ  أَبُو بَكْرٍ  بُكَاءَنَا ، فَقَالَ : مَا  شَأْنُ  ابْنَتِي ؟ قَالَتْ أُمِّي : سَمِعَتْ بِذَاكَ الْخَبَرِ قَالَ : مَكَانَكِ حَتَّى نَغْدُو مَعَكِ عَلَى رَسُولِ اللهِ ، فَغَدَوْنَا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعِنْدَهُ  امْرَأَةٌ مِنَ الْأَنْصَارِ  ، فَمَا مَنَعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَكَانُهَا أَنْ تَكَلَّمَ ، فَقَالَ : يَا  عَائِشَةُ  إِنْ كُنْتِ أَسَأْتِ ، أَوْ أَخْطَأْتِ ، فَاسْتَغْفِرِي اللهَ ، وَتُوبِي إِلَيْهِ .  فَقُلْتُ لِأَبِي : تَكَلَّمْ ، فَقَالَ : بِمَ أَتَكَلَّمُ ؟  فَقُلْتُ لِأُمِّي : تَكَلَّمِي ، فَقَالَتْ : بِمَ أَتَكَلَّمُ ؟  فَحَمِدْتُ اللهَ وَأَثْنَيْتُ عَلَيْهِ ، ثُمَّ قُلْتُ : وَاللهِ ، لَئِنْ قُلْتُ : قَدْ         [8/336]      فَعَلْتُ ، وَاللهُ يَعْلَمُ مَا فَعَلْتُ ، لَتَقُولُنَّ : قَدْ أَقَرَّتْ ، وَلَئِنْ قُلْتُ : مَا فَعَلْتُ ، وَاللهُ يَعْلَمُ مَا فَعَلْتُ ، لَتَقُولُنَّ : كَذَبَتْ ، فَمَا أَجِدُ لِي وَلَكُمْ مَثَلًا ، إِلَّا مَا قَالَ الْعَبْدُ الصَّالِحُ ، فَنَسِيتُ اسْمَهُ ، فَقُلْتُ :  أَبُو يُوسُفَ  :         {      فَصَبْرٌ جَمِيلٌ وَاللهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ         }      ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  جَارِيَةٍ نُوبِيَّةٍ  ، فَقَالَ : يَا فُلَانَةُ ، مَاذَا تَعْلَمِينَ مِنْ  عَائِشَةَ  ؟ فَقَالَتْ : وَاللهِ ، مَا أَعْلَمُ عَلَى  عَائِشَةَ  عَيْبًا ، إِلَّا أَنَّهَا تَنَامُ ، وَتَدْخُلُ  الدَّاجِنُ  فَتَأْكُلُ خَمِيرَهَا وَحَصِيرَهَا ، فَلَمَّا فَطِنَتْ لِمَا يُرِيدُ ، قَالَتْ : وَاللهِ ، مَا أَعْلَمُ مِنْ  عَائِشَةَ  إِلَّا مَا يَعْلَمُ الصَّائِغُ مِنَ  التِّبْرِ  الْأَحْمَرِ .  فَصَعِدَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمِنْبَرَ ، فَقَالَ :  أَشِيرُوا عَلَيَّ يَا مَعْشَرَ الْمُسْلِمِينَ ، فِي قَوْمٍ  أَبَنُوا  أَهْلِي  ، وَايْمُ اللهِ ، مَا عَلِمْتُ عَلَى أَهْلِي سُوءًا قَطُّ ، وَأَبَنُوهُمْ بِمَنْ ؟ وَاللهِ ، مَا عَلِمْتُ عَلَيْهِ مِنْ سَوْءٍ قَطُّ ، وَمَا دَخَلَ بَيْتِي إِلَّا وَأَنَا شَاهِدٌ ، وَلَا سَافَرْتُ إِلَّا وَهُوَ مَعِي ، فَقَالَ  سَعْدُ بْنُ مُعَاذٍ  : أَرَى يَا رَسُولَ اللهِ ، أَنْ تَضْرِبَ أَعْنَاقَهُمْ ، فَقَامَ رِجَالٌ مِنَ  الْخَزْرَجِ  ، فَقَالُوا : وَاللهِ لَوْ كَانُوا مِنْ رَهْطِكَ  الْأَوْسِ  ، مَا أَمَرْتَ بِضَرْبِ أَعْنَاقِهِمْ ، حَتَّى كَادَ أَنْ يَكُونَ بَيْنَ  الْأَوْسِ  وَالْخَزْرَجِ  كَوْنٌ ، وَنَزَلَ الْوَحْيُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - . قَالَتْ  عَائِشَةُ  : فَمَا  سُرِّيَ  عَنْهُ حَتَّى رَأَيْتُ السُّرُورَ بَيْنَ عَيْنَيْهِ ،         [8/337]      فَقَالَ : أَبْشِرِي يَا  عَائِشَةُ  ، فَقَدْ أَنْزَلَ اللهُ عُذْرَكِ .  فَقَالَ أَبَوَايَ : قُومِي ، فَقَبِّلِي رَأْسَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : أَحْمَدُ اللهَ ، لَا إِيَّاكُمَا ، وَتَلَا عَلَيْهِمُ الْقُرْآنَ :         {      إِنَّ الَّذِينَ جَاءُوا بِالإِفْكِ عُصْبَةٌ مِنْكُمْ لا تَحْسَبُوهُ شَرًّا لَكُمْ بَلْ هُوَ خَيْرٌ لَكُمْ لِكُلِّ امْرِئٍ مِنْهُمْ مَا اكْتَسَبَ مِنَ الإِثْمِ وَالَّذِي تَوَلَّى كِبْرَهُ مِنْهُمْ لَهُ عَذَابٌ عَظِيمٌ         }      ،         {      وَلَوْلا إِذْ سَمِعْتُمُوهُ قُلْتُمْ مَا يَكُونُ لَنَا أَنْ نَتَكَلَّمَ بِهَذَا سُبْحَانَكَ هَذَا بُهْتَانٌ عَظِيمٌ         }      ، وَكَانَ مِمَّنْ تَوَلَّى  كِبْرَهُ  حَسَّانُ بْنُ ثَابِتٍ  ،  وَمِسْطَحُ بْنُ أُثَاثَةَ  ،  وَحَمْنَةُ بِنْتُ جَحْشٍ  ، وَكَانَ يُتَحَدَّثُ بِهِ عِنْدَ  عَبْدِ اللهِ بْنِ أُبَيٍّ  ، فَيَسْمَعُهُ ،  وَيَسْتَوْشِيهِ  ، وَيُذِيعُهُ .  وَكَانَ  حَسَّانُ بْنُ ثَابِتٍ  إِذَا سُبَّ عِنْدَ  عَائِشَةَ  قَالَتْ :  لَا  تَسُبُّوا  حَسَّانَ  ، فَإِنَّهُ كَانَ يُكَافِحُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ثُمَّ تَقُولُ : أَيُّ عَذَابٍ أَعْظَمُ مِنْ ذَهَابِ عَيْنَيْهِ ؟         [8/338]      وَقَالَ الَّذِي قِيلَ لَهُ مَا قِيلَ : وَاللهِ ، إِنْ كَشَفْتُ عَنْ  كَنَفِ  أُنْثَى قَطُّ ، وَقُتِلَ  شَهِيدًا  فِي  سَبِيلِ  اللهِ ، فَقَالَ  حَسَّانُ بْنُ ثَابِتٍ  يُكَذِّبُ نَفْسَهُ :  رَزَانٌ  تُزَنُّ  بَعْلًا","","Musnad Abi Ya'la al-Mawsili 4931","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4933","576 - (  4932  ) -  حَدَّثَنَا  حَوْثَرَةُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،         [8/339]      عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  عُرْوَةَ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَلَدَ الَّذِينَ قَالُوا  لِعَائِشَةَ  مَا قَالُوا ثَمَانِينَ ثَمَانِينَ  :  حَسَّانَ بْنَ ثَابِتٍ  ،  وَمِسْطَحَ بْنَ أُثَاثَةَ  ،  وَحَمْنَةَ بِنْتَ جَحْشٍ  .","","Musnad Abi Ya'la al-Mawsili 4932","","عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حوثرة بن أشرس بن عومر العدوي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4934","577 - (  4933  ) -  أَخْبَرَنَا  أَبُو يَعْلَى  وَالْحَسَنُ بْنُ سُفْيَانَ  ، قَالَا  حَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ عَبْدِ اللهِ الْوَاسِطِيُّ الطَّحَّانُ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ شِهَابٍ الْوَاسِطِيِّ ،  حَدَّثَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ، وَسَعِيدُ بْنُ الْمُسَيِّبِ ، وَعَلْقَمَةُ بْنُ وَقَّاصٍ ، وَعُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ ،         [8/340]      عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ قَالَ فِيهَا أَهْلُ  الْإِفْكِ  مَا قَالُوا ، فَبَرَّأَهَا اللهُ ، وَكُلُّهُمْ حَدَّثَنِي طَائِفَةً مِنْ حَدِيثِهَا ، وَبَعْضُهُمْ كَانَ أَوْعَى لِحَدِيثِهَا مِنْ بَعْضٍ ، وَأَثْبَتَ لَهُ اقْتِصَاصًا ، وَقَدْ  وَعَيْتُ  عَنْ كُلِّ وَاحِدٍ مِنْهُمُ الْحَدِيثَ الَّذِي حَدَّثَنِي عَنْ  عَائِشَةَ  . قَالَتْ  عَائِشَةُ  :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَرَادَ أَنْ يَخْرُجَ سَفَرًا أَقْرَعَ بَيْنَ أَزْوَاجِهِ ، فَأَيَّتُهُنَّ خَرَجَ سَهْمُهَا أَخْرَجَهَا مَعَهُ  . قَالَتْ  عَائِشَةُ  : فَأَقْرَعَ بَيْنَنَا فِي غَزْوَةٍ غَزَاهَا ، فَخَرَجَ فِيهَا  سَهْمِي  ، فَخَرَجْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَمَا أُنْزِلَ الْحِجَابُ ، فَكُنْتُ أُحْمَلُ فِي هَوْدَجٍ وَأُنْزَلُ فِيهِ ، فَسِرْنَا حَتَّى إِذَا فَرَغَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ غَزْوَتِهِ تِلْكَ ، وَقَفَلَ وَدَنَوْنَا مِنَ  الْمَدِينَةِ  قَافِلِينَ أَذِنَ لَنَا بِالرَّحِيلِ ، فَقُمْتُ حِينَ أَذِنَ بِالرَّحِيلِ فَمَشَيْتُ حَتَّى جَاوَزْتُ الْجَيْشَ ، فَلَمَّا قَضَيْتُ شَأْنِي ، أَقْبَلْتُ إِلَى رَحْلِي فَلَمَسْتُ صَدْرِي ، فَإِذَا عِقْدٌ لِي مِنْ  جَزْعِ  أَظْفَارٍ  قَدِ انْقَطَعَ ، فَرَجَعْتُ  فَالْتَمَسْتُ  عِقْدِي فَحَبَسَنِي ابْتِغَاؤُهُ .  قَالَتْ : وَأَقْبَلَ الرَّهْطُ الَّذِينَ كَانُوا يَرْحَلُونَ لِي ، فَاحْتَمَلُوا هَوْدَجِي ، فَرَحَلُوهُ عَلَى بَعِيرِي الَّذِي كُنْتُ أَرْكَبُ ، وَهُمْ يَحْسَبُونَ أَنِّي فِيهِ ، وَكَانَ النِّسَاءُ إِذْ ذَاكَ خِفَافًا لَمْ يَغْشَهُنَّ اللَّحْمُ ، وَإِنَّا نَأْكُلُ  الْعُلْقَةَ  مِنَ الطَّعَامِ ، فَلَمْ يَسْتَنْكِرِ  الْقَوْمُ  خِفَّةَ الْهَوْدَجِ ، رَفَعُوهُ وَرَحَلُوهُ ، وَكُنْتُ جَارِيَةً حَدِيثَةَ السِّنِّ فَبَعَثُوا ، وَسَارُوا ، وَوَجَدْتُ عِقْدِي بَعْدَمَا اسْتَمَرَّ الْجَيْشُ ، فَجِئْتُ مَنَازِلَهُمْ وَلَيْسَ بِهَا دَاعٍ وَلَا مُجِيبٌ .         [8/341]      فَيَمَّمْتُ  مَنْزِلِي الَّذِي كُنْتُ بِهِ ، وَظَنَنْتُ أَنَّهُمْ سَيَفْقِدُونَنِي فَيَرْجِعُونَ إِلَيَّ .  فَبَيْنَا أَنَا جَالِسَةٌ فِي مَنْزِلِي غَلَبَتْنِي عَيْنِي ، فَنِمْتُ ، وَكَانَ  صَفْوَانُ بْنُ الْمُعَطَّلِ السُّلَمِيُّ ثُمَّ الذَّكْوَانِيُّ  مِنْ وَرَاءِ الْجَيْشِ ، فَأَدْلَجَ ، فَأَصْبَحَ عِنْدَ مَنْزِلِي ، فَرَأَى سَوَادَ إِنْسَانٍ نَائِمٍ ، فَعَرَفَنِي حِينَ رَآنِي ، وَكَانَ يَرَانِي قَبْلَ الْحِجَابِ ، فَاسْتَيْقَظْتُ بِاسْتِرْجَاعِهِ حِينَ عَرَفَنِي ،  فَخَمَّرْتُ  وَجْهِي بِجِلْبَابِي ، وَاللهِ مَا تَكَلَّمْتُ بِكَلِمَةٍ ، وَلَا سَمِعْتُ مِنْهُ كَلِمَةً غَيْرَ اسْتِرْجَاعِهِ حِينَ أَنَاخَ رَاحِلَتَهُ ، فَوَطِئَ عَلَى يَدِهَا ، وَقُمْتُ فَرَكِبْتُهَا ، فَانْطَلَقَ يَقُودُ بِيَ الرَّاحِلَةَ ، حَتَّى أَتَيْنَا الْجَيْشَ وَهُمْ نُزُولٌ .  قَالَتْ : فَهَلَكَ مَنْ هَلَكَ ، وَكَانَ الَّذِي تَوَلَّى  كِبْرَهُ  مِنْهُمُ الْأَوَّلَ  عَبْدُ اللهِ بْنُ أُبَيٍّ ابْنِ سَلُولَ  .  قَالَ  عُرْوَةُ  : أُخْبِرْتُ أَنَّهُ كَانَ  يُشَاعُ  وَيُحَدَّثُ بِهِ عِنْدَهُ ، فَيُقِرُّهُ وَيُشِيعُهُ  وَيَسْتَوْشِيهِ  .  قَالَ  إِبْرَاهِيمُ  :  يَعْنِي  يَسْتَوْشِيهِ  .  قَالَ  عُرْوَةُ  : إِنَّمَا لَمْ يُسَمَّ مِنْ أَهْلِ  الْإِفْكِ  إِلَّا  مِسْطَحُ بْنُ أُثَاثَةَ  ،  وَحَمْنَةُ بِنْتُ جَحْشٍ  ، فِي أُنَاسٍ آخَرِينَ لَا عِلْمَ لِي بِهِمْ ، غَيْرَ أَنَّهُمْ عُصْبَةٌ ، كَمَا قَالَ اللهُ ، وَإِنَّ كِبْرَ ذَلِكَ كَانَ يُقَالُ عَنْ  عَبْدِ اللهِ بْنِ أُبَيٍّ ابْنِ سَلُولَ  .  قَالَ  عُرْوَةُ  : كَانَتْ  عَائِشَةُ  تَكْرَهُ أَنْ  يُسَبَّ  عِنْدَهَا  حَسَّانُ بْنُ         [8/342]      ثَابِتٍ  ، وَتَقُولُ : إِنَّهُ الَّذِي قَالَ :  وَعِرْضِي  قَالَتْ  عَائِشَةُ  : فَقَدِمْتُ  الْمَدِينَةَ  فَاشْتَكَيْتُ حِينَ قَدِمْتُ شَهْرًا ، وَالنَّاسُ يُفِيضُونَ فِي قَوْلِ أَصْحَابِ  الْإِفْكِ  ، لَا أَشْعُرُ بِشَيْءٍ مِنْ ذَلِكَ ، وَهُوَ يَرِيبُنِي فِي وَجَعِي أَنِّي لَا أَعْرِفُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  اللُّطْفَ  الَّذِي كُنْتُ أَرَى حِينَ أَشْتَكِي ، إِنَّمَا يَدْخُلُ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَقُولُ : كَيْفَ تِيكُمْ ؟ وَيَنْصَرِفُ ، فَذَلِكَ الَّذِي يَرِيبُنِي ، وَلَا أَشْعُرُ حَتَّى خَرَجْتُ بَعْدَمَا نَقِهْتُ ، فَخَرَجْتُ مَعَ  أُمِّ مِسْطَحٍ  قِبَلَ  الْمَنَاصِعِ  ، وَكَانَ مُتَبَرَّزَنَا ، أَمْرُنَا أَمْرُ الْعَرَبِ  الْأُوَلِ  فِي  التَّنْزِيهِ  ، قَبْلَ الْغَائِطِ كُنَّا نَتَأَذَّى بِالْكُنُفِ أَنْ نَتَّخِذَهَا عِنْدَ بُيُوتِنَا .  قَالَتْ : فَانْطَلَقْتُ أَنَا ،  وَأُمُّ مِسْطَحٍ وَهِيَ بِنْتُ أَبِي رُهْمِ بْنِ الْمُطَّلِبِ بْنِ عَبْدِ مَنَافٍ  وَأُمُّهَا  بِنْتُ صَخْرِ بْنِ عَامِرٍ خَالَةُ أَبِي بَكْرٍ الصِّدِّيقِ  ، وَابْنُهَا  مِسْطَحُ بْنُ أُثَاثَةَ بْنِ عَبَّادِ بْنِ عَبْدِ الْمُطَّلِبِ  ، فَأَقْبَلْتُ أَنَا ،  وَأُمُّ مِسْطَحٍ  قِبَلَ بَيْتِي حِينَ فَرَغْنَا مِنْ شَأْنِنَا ، فَعَثَرَتْ  أُمُّ مِسْطَحٍ  فِي مِرْطِهَا ، فَقَالَتْ :  تَعِسَ  مِسْطَحٌ  .  فَقُلْتُ لَهَا : بِئْسَ مَا قُلْتِ أَتَسُبِّينَ رَجُلًا شَهِدَ  بَدْرًا  ؟  قَالَتْ : أَيْ  هَنْتَاهُ  أَوَلَمْ تَسْمَعِي مَا قَالَ ؟ قُلْتُ : وَمَا قَالَ ؟         [8/343]      فَأَخْبَرَتْنِي بِقَوْلِ أَهْلِ  الْإِفْكِ  .  قَالَتْ : فَازْدَدْتُ مَرَضًا عَلَى مَرَضِي ، فَلَمَّا رَجَعْتُ إِلَى بَيْتِي ، دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : كَيْفَ تِيكُمْ ؟ فَقُلْتُ : ائْذَنْ لِي آتِ أَبَوَيَّ ، قَالَتْ : وَأَنَا أُرِيدُ أَنْ أَسْتَيْقِنَ الْخَبَرَ مِنْ قِبَلِهِمَا ، فَأَذِنَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَيْتُهُمَا ، فَقُلْتُ لِأُمِّي : يَا أُمَّتَاهُ ، مَاذَا يَتَحَدَّثُ النَّاسُ ؟ قَالَتْ : هَوِّنِي عَلَيْكِ ، فَوَاللهِ ، لَقَلَّمَا كَانَتِ امْرَأَةٌ قَطُّ  وَضِيئَةٌ  عِنْدَ زَوْجِهَا يُحِبُّهَا ، لَهَا ضَرَائِرُ ، إِلَّا أَكْثَرْنَ عَلَيْهَا .  قَالَتْ : فَقُلْتُ : سُبْحَانَ اللهِ أَوَلَقَدْ تَحَدَّثَ النَّاسُ بِهَذَا ؟  قَالَتْ : فَبَكَيْتُ تِلْكَ اللَّيْلَةَ حَتَّى أَصْبَحْتُ لَا  يَرْقَأُ  لِي دَمْعٌ ، وَلَا أَكْتَحِلُ بِنَوْمٍ .  قَالَتْ : ثُمَّ أَصْبَحْتُ أَبْكِي ، قَالَتْ : وَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَلِيَّ بْنَ أَبِي طَالِبٍ  ،  وَأُسَامَةَ بْنَ زَيْدٍ  ، يَسْتَشِيرُهُمَا فِي فِرَاقِ أَهْلِهِ .  قَالَتْ : فَأَمَّا  أُسَامَةُ بْنُ زَيْدٍ  ، فَأَشَارَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالَّذِي يَعْلَمُ مِنْ بَرَاءَةِ أَهْلِهِ ، وَبِالَّذِي يَعْلَمُ لَهُمْ فِي نَفْسِهِ ، فَقَالَ  أُسَامَةُ بْنُ زَيْدٍ  : يَا رَسُولَ اللهِ ، أَهْلَكَ وَلَا نَعْلَمُ إِلَّا خَيْرًا .  وَأَمَّا  عَلِيٌّ  ، فَقَالَ : يَا رَسُولَ اللهِ ، لَمْ يُضَيِّقِ اللهُ عَلَيْكَ النِّسَاءَ ، وَالنِّسَاءُ سِوَاهَا كَثِيرٌ ، وَسَلِ الْجَارِيَةَ تَصْدُقْكَ .  قَالَتْ : فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بَرِيرَةَ  ، فَقَالَ : أَيْ  بَرِيرَةُ  ، هَلْ         [8/344]      رَأَيْتِ شَيْئًا  يُرِيبُكِ  ؟ قَالَتْ لَهُ  بَرِيرَةُ  : وَالَّذِي بَعَثَكَ بِالْحَقِّ ، مَا رَأَيْتُ عَلَيْهَا أَمْرًا قَطُّ  أَغْمِصُهُ  ، أَكْثَرَ مِنْ أَنَّهَا جَارِيَةٌ حَدِيثَةُ السِّنِّ ، تَنَامُ عَنْ عَجِينِ أَهْلِهَا ، فَتَأْتِي  الدَّاجِنُ  ، فَتَأْكُلُهُ ، فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ يَوْمِهِ ، فَاسْتَعْذَرَ مِنْ  عَبْدِ اللهِ بْنِ أُبَيٍّ ابْنِ سَلُولَ  ، وَهُوَ عَلَى الْمِنْبَرِ ، فَقَالَ : يَا مَعْشَرَ الْمُسْلِمِينَ ، مَنْ  يَعْذِرُنِي  مِنْ رَجُلٍ قَدْ بَلَغَنِي أَذَاهُ فِي أَهْلِي ، وَاللهِ مَا عَلِمْتُ عَلَى أَهْلِي إِلَّا خَيْرًا ، وَلَقَدْ ذَكَرُوا رَجُلًا مَا عَلِمْتُ مِنْهُ إِلَّا خَيْرًا ، وَمَا دَخَلَ عَلَى أَهْلِي إِلَّا مَعِي .  فَقَامَ  سَعْدُ بْنُ مُعَاذٍ  أَحَدُ  بَنِي عَبْدِ الْأَشْهَلِ  ، فَقَالَ : يَا رَسُولَ اللهِ ، أَنَا  أَعْذِرُكَ  مِنْهُ ، فَإِنْ كَانَ مِنَ  الْأَوْسِ  ، ضَرَبْتُ عُنُقَهُ ، وَإِنْ كَانَ مِنْ إِخْوَانِنَا مِنَ  الْخَزْرَجِ  ، أَمَرْتَنَا فَفَعَلْنَا مَا أَمَرْتَنَا بِهِ .  قَالَ : فَقَامَ رَجُلٌ مِنَ  الْخَزْرَجِ  ، وَكَانَتْ  أُمُّ حَسَّانَ  بِنْتَ عَمِّهِ مِنْ فَخِذِهِ وَهُوَ  سَعْدُ بْنُ عُبَادَةَ  سَيِّدُ  الْخَزْرَجِ  ، وَكَانَ رَجُلًا صَالِحًا ، وَلَكِنِ احْتَمَلَتْهُ الْحَمِيَّةُ ، فَقَالَ  لِسَعْدِ بْنِ مُعَاذٍ  : كَذَبْتَ ،  لَعَمْرُ  اللهِ لَا تَقْتُلُهُ ، وَلَا تَقْدِرُ عَلَى قَتْلِهِ ، وَلَوْ كَانَ مِنْ رَهْطِكَ مَا أَحْبَبْتَ أَنْ تَقْتُلَهُ .  فَقَامَ  أُسَيْدُ بْنُ حُضَيْرٍ  وَهُوَ ابْنُ عَمِّ  سَعْدِ بْنِ مُعَاذٍ  ، فَقَالَ  لِسَعْدِ بْنِ عُبَادَةَ  : كَذَبْتَ  لَعَمْرُ  اللهِ ، لَنَقْتُلَنَّهُ ، فَإِنَّكَ مُنَافِقٌ تُجَادِلُ عَنِ الْمُنَافِقِينَ .  قَالَتْ : فَثَارَ الْحَيَّانِ ؛  الْأَوْسُ  وَالْخَزْرَجُ  ، حَتَّى هَمُّوا أَنْ يَقْتَتِلُوا ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَالِسٌ عَلَى الْمِنْبَرِ ، فَلَمْ يَزَلْ رَسُولُ         [8/345]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يُخَفِّضُهُمْ  حَتَّى سَكَتُوا ، وَسَكَتَ .  قَالَتْ : وَبَكَيْتُ يَوْمِي ذَلِكَ كُلَّهُ لَا  يَرْقَأُ  لِي دَمْعٌ ، وَلَا أَكْتَحِلُ بِنَوْمٍ ، قَالَتْ : وَأَصْبَحَ أَبَوَايَ عِنْدِي ، بَكَيْتُ يَوْمِي وَلَيْلَتِي لَا  يَرْقَأُ  لِي دَمْعٌ ، وَلَا أَكْتَحِلُ بِنَوْمٍ ، قَالَتْ : حَتَّى أَظُنُّ أَنَّ الْبُكَاءَ  فَالِقٌ  كَبِدِي .  قَالَتْ : فَبَيْنَمَا أَبَوَايَ جَالِسَانِ عِنْدِي وَأَنَا أَبْكِي ، اسْتَأْذَنَتْ عَلَيَّ  امْرَأَةٌ مِنَ الْأَنْصَارِ  ، فَأَذِنْتُ لَهَا ، فَجَلَسَتْ تَبْكِي مَعِي ، قَالَتْ : فَبَيْنَمَا نَحْنُ عَلَى ذَلِكَ ، إِذْ دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَلَّمَ ثُمَّ جَلَسَ .  قَالَتْ : وَلَمْ يَجْلِسْ عِنْدِي مُنْذُ قِيلَ لِي مَا قِيلَ قَبْلَهَا ، وَلَقَدْ لَبِثَ شَهْرًا لَا يُوحَى إِلَيْهِ فِي شَأْنِي شَيْءٌ .  قَالَتْ : فَتَشَهَّدَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ جَلَسَ ، ثُمَّ قَالَ : أَمَّا بَعْدُ ، يَا  عَائِشَةُ  ، فَإِنَّهُ قَدْ بَلَغَنِي عَنْكِ كَذَا وَكَذَا ، فَإِنْ كُنْتِ بَرِيئَةً فَسَيُبَرِّئُكِ اللهُ ، وَإِنْ كُنْتِ  أَلْمَمْتِ  بِذَنْبٍ فَاسْتَغْفِرِي اللهَ وَتُوبِي إِلَيْهِ ، فَإِنَّ الْعَبْدَ إِذَا اعْتَرَفَ ، وَتَابَ ، تَابَ اللهُ عَلَيْهِ .  قَالَتْ : فَلَمَّا قَضَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَقَالَتَهُ ، قَلَصَ دَمْعِي حَتَّى مَا أُحِسُّ مِنْهُ قَطْرَةً ، فَقُلْتُ لِأَبِي : أَجِبْ عَنِّي رَسُولَ اللهِ فِيمَا قَالَ ، فَقَالَ : وَاللهِ مَا أَدْرِي مَا أَقُولُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .  قَالَتْ : فَقُلْتُ لِأُمِّي : أَجِيبِي عَنِّي رَسُولَ اللهِ فِيمَا قَالَ ، فَقَالَتْ : وَاللهِ مَا أَدْرِي مَا أَقُولُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .         [8/346]      قَالَتْ : فَقُلْتُ وَأَنَا جَارِيَةٌ حَدِيثَةُ السِّنِّ لَا أَقْرَأُ مِنَ الْقُرْآنِ كَثِيرًا : إِنِّي وَاللهِ ، لَقَدْ عَلِمْتُ ، وَلَقَدْ سَمِعْتُمْ ، حَتَّى اسْتَقَرَّ فِي أَنْفُسِكُمْ ، وَصَدَّقْتُمْ بِهِ ، فَإِنْ قُلْتُ لَكُمْ : إِنِّي بَرِيئَةٌ ، لَا تُصَدِّقُونَنِي بِذَلِكَ ، وَلَئِنِ اعْتَرَفْتُ بِأَمْرٍ ، وَاللهُ يَعْلَمُ أَنِّي مِنْهُ بَرِيئَةٌ ، لَتُصَدِّقُنِّي ، وَاللهِ مَا أَجِدُ لِي وَلَا لَكُمْ مَثَلًا إِلَّا  أَبَا يُوسُفَ  ، حِينَ يَقُولُ :         {      فَصَبْرٌ جَمِيلٌ وَاللهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ         }      .  قَالَتْ : فَتَحَوَّلْتُ ، فَاضْطَجَعْتُ عَلَى فِرَاشِي ، وَاللهُ يَعْلَمُ حِينَئِذٍ أَنِّي بَرِيئَةٌ ، وَاللهُ يُبَرِّئُنِي بِبَرَاءَتِي ، وَلَكِنْ وَاللهِ مَا كُنْتُ أَظُنُّ أَنَّ اللهَ يُنْزِلُ فِي شَأْنِي وَحْيًا ، لَشَأْنِي أَحْقَرُ فِي نَفْسِي مِنْ أَنْ يَتَكَلَّمَ اللهُ فِيَّ بِأَمْرِ بَيَانٍ ، وَلَكِنْ كُنْتُ أَرْجُو أَنْ يَرَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي النَّوْمِ رُؤْيَا يُبَرِّئُنِي اللهُ بِهَا .  قَالَتْ : فَوَاللهِ مَا قَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ مَجْلِسِهِ ، وَلَا خَرَجَ أَحَدٌ مِنْ أَهْلِ الْبَيْتِ ، حَتَّى أَنْزَلَ اللهُ عَلَيْهِ ، فَأَخَذَهُ مَا كَانَ يَأْخُذُهُ مِنَ  الْبُرَحَاءِ ،  حَتَّى إِنَّهُ لَيَتَحَدَّرُ مِنْهُ مِنَ الْعَرَقِ مِثْلُ  الْجُمَانِ ،  وَهُوَ فِي يَوْمٍ شَاتٍ مِنْ ثِقَلِ الْقُرْآنِ الَّذِي أُنْزِلَ عَلَيْهِ ، قَالَتْ : فَسُرِّيَ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَضْحَكُ ، وَكَانَ أَوَّلُ كَلِمَةٍ تَكَلَّمَ بِهَا أَنْ قَالَ : يَا  عَائِشَةُ  أَمَّا اللهُ فَقَدْ بَرَّأَكِ .  قَالَتْ : فَقَالَتْ أُمِّي : قُومِي إِلَيْهِ ، فَقُلْتُ : وَاللهِ لَا أَقُومُ إِلَيْهِ ، وَإِنِّي لَا أَحْمَدُ إِلَّا اللهَ ، وَأَنْزَلَ اللهُ :         {      إِنَّ الَّذِينَ جَاءُوا بِالإِفْكِ عُصْبَةٌ مِنْكُمْ لا تَحْسَبُوهُ شَرًّا لَكُمْ         }      الْآيَاتِ .         [8/347]      فَلَمَّا أَنْزَلَ اللهُ هَذَا فِي بَرَاءَتِي ، قَالَ  أَبُو بَكْرٍ الصِّدِّيقُ  ، وَهُوَ يُنْفِقُ عَلَى  مِسْطَحِ بْنِ أُثَاثَةَ  لِقَرَابَتِهِ ، وَفَقْرِهِ : وَاللهِ لَا أُنْفِقُ عَلَى  مِسْطَحٍ  شَيْئًا بَعْدَ الَّذِي قَالَ  لِعَائِشَةَ  ، فَأَنْزَلَ اللهُ :         {      وَلا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ أَنْ يُؤْتُوا أُولِي الْقُرْبَى         }      إِلَى قَوْلِهِ :         {      وَاللهُ غَفُورٌ رَحِيمٌ         }      ، فَقَالَ  أَبُو بَكْرٍ  : بَلَى وَاللهِ ، إِنِّي لَأُحِبُّ أَنْ يَغْفِرَ اللهُ لِي ، فَرَجَعَ إِلَى  مِسْطَحٍ  النَّفَقَةَ الَّتِي كَانَ يُنْفِقُ عَلَيْهِ قَالَ : وَاللهِ لَا أَنْزِعُهَا مِنْهُ أَبَدًا .  قَالَتْ : وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَأَلَ  زَيْنَبَ بِنْتَ جَحْشٍ  عَنْ أَمْرِي ، فَقَالَ  لِزَيْنَبَ  : مَاذَا  عَلِمْتِ أَوْ رَأَيْتِ ؟  قَالَتْ : يَا رَسُولَ اللهِ  أَحْمِي  سَمْعِي وَبَصَرِي ، وَاللهِ مَا عَلِمْتُ إِلَّا خَيْرًا .  قَالَتْ  عَائِشَةُ  : وَهِيَ الَّتِي كَانَتْ  تُسَامِينِي  مِنْ أَزْوَاجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَعَصَمَهَا  اللهُ  بِالْوَرَعِ  ، وَطَفِقَتْ أُخْتُهَا  حَمْنَةُ  تُحَارِبُ فَهَلَكَتْ فِيمَنْ هَلَكَ .  قَالَ  ابْنُ شِهَابٍ  : فَهَذَا الَّذِي بَلَغَنِي مِنْ حَدِيثِ هَؤُلَاءِ الرَّهْطِ .         [8/348]","","Musnad Abi Ya'la al-Mawsili 4933","","عائشة بنت أبي بكر الصديق عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن محمد بن خالد بن عبد الله الواسطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4935","578 - (  4934  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ عَبْدِ اللهِ ،  حَدَّثَنَا  إِبْرَاهِيمُ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ شِهَابٍ قَالَ :  وَقَالَتْ  عَائِشَةُ :  وَاللهِ إِنَّ الرَّجُلَ الَّذِي قِيلَ لَهُ مَا قِيلَ لَيَقُولُ : سُبْحَانَ اللهِ ! وَاللهِ مَا كَشَفْتُ عَنْ  كَنَفِ  أُنْثَى قَطُّ  . قَالَتْ : ثُمَّ قُتِلَ بَعْدَ ذَلِكَ فِي  سَبِيلِ  اللهِ  .","","Musnad Abi Ya'la al-Mawsili 4934","","عائشة بنت أبي بكر الصديق عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن محمد بن خالد بن عبد الله الواسطي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4936","579 - (  4935  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ أَيُّوبَ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  حَدَّثَنِي  صَالِحُ بْنُ كَيْسَانَ ،  عَنِ  ابْنِ شِهَابٍ قَالَ :  حَدَّثَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ، وَسَعِيدُ بْنُ الْمُسَيِّبِ ، وَعَلْقَمَةُ بْنُ وَقَّاصٍ ، وَعُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  عَائِشَةَ زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ قَالَ لَهَا أَهْلُ  الْإِفْكِ  مَا قَالُوا ، فَبَرَّأَهَا اللهُ . قَالَ : وَكُلُّهُمْ قَدْ حَدَّثَنِي طَائِفَةً مِنْ حَدِيثِهَا ، وَبَعْضُهُمْ كَانَ أَوْعَى لَهُ مِنْ بَعْضٍ ، وَأَثْبَتَ لَهُ اقْتِصَاصًا ، وَقَدْ  وَعَيْتُ  عَنْ كُلِّ رَجُلٍ مِنْهُمُ الْحَدِيثَ الَّذِي حَدَّثَنِي عَنْ  عَائِشَةَ  ، وَبَعْضُ حَدِيثِهِمْ يُصَدِّقُ بَعْضًا ، وَإِنْ كَانَ بَعْضُهُمْ أَوْعَى لَهُ مِنْ بَعْضٍ ، قَالُوا : قَالَتْ  عَائِشَةُ  :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ سَفَرًا أَقْرَعَ بَيْنَ         [8/349]      أَزْوَاجِهِ ، فَأَيَّتُهُنَّ خَرَجَ سَهْمُهَا ، خَرَجَ بِهَا رَسُولُ اللهِ -  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَعَهُ ، فَلَمَّا كَانَتْ  غَزْوَةُ بَنِي الْمُصْطَلِقِ  ، أَقْرَعَ بَيْنَ نِسَائِهِ ، كَمَا كَانَ يَصْنَعُ ، فَخَرَجَ  سَهْمِي  عَلَيْهِنَّ ، فَخَرَجَ بِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَعَهُ .  قَالَتْ : وَكَانَ النِّسَاءُ إِذْ ذَاكَ إِنَّمَا يَأْكُلْنَ  الْعُلْقَةَ  ، لَمْ يُهَبَّلْنَ بِاللَّحْمِ فَيَثْقُلْنَ ، وَكُنْتُ إِذَا رُحِلَ لِي بَعِيرٌ وَجَلَسْتُ فِي هَوْدَجِي ، ثُمَّ يَأْتِي  الْقَوْمُ  الَّذِينَ يَرْحَلُونَ لِي يَحْمِلُونَنِي ، فَيَأْخُذُونِي بِأَسْفَلِ الْهَوْدَجِ ، فَيَرْفَعُونَهُ ، وَيَضَعُونَهُ عَلَى ظَهْرِ الْبَعِيرِ ، فَيَشُدُّونَهُ بِحِبَالِهِ ، ثُمَّ يَأْخُذُونَ بِرَأْسِ الْبَعِيرِ ، فَيَنْطَلِقُونَ .  قَالَتْ : فَلَمَّا فَرَغَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ سَفَرِهِ ذَلِكَ ، وَجَّهَ قَافِلًا ، حَتَّى إِذَا جَاءَ قَرِيبًا مِنَ  الْمَدِينَةِ  ، نَزَلَ مَنْزِلًا ، فَبَاتَ بِهِ بَعْضَ اللَّيْلِ ، ثُمَّ أُذِّنَ فِي النَّاسِ بِالرَّحِيلِ ، فَارْتَحَلَ النَّاسُ ، وَخَرَجْتُ لِبَعْضِ حَاجَتِي ، وَفِي عُنُقِي عِقْدٌ لِي مِنْ  جَزَعِ  ظَفَارٍ ، فَلَمَّا فَرَغْتُ ،  انْسَلَّ  مِنْ عُنُقِي وَلَا أَدْرِي ، فَلَمَّا رَجَعْتُ إِلَى الرَّحْلِ ، ذَهَبْتُ أَلْتَمِسُهُ فِي عُنُقِي فَلَمْ أَجِدْهُ ، وَقَدْ أَخَذَ النَّاسُ فِي الرَّحِيلِ ، فَرَجَعْتُ إِلَى مَكَانِي الَّذِي ذَهَبْتُ مِنْهُ ، فَالْتَمَسْتُهُ حَتَّى وَجَدْتُهُ ، وَجَاءَ  الْقَوْمُ         [8/350]      خِلَافِي ، الَّذِينَ كَانُوا يَرْحَلُونَ لِيَ الْبَعِيرَ ، وَقَدْ فَرَغُوا مِنْ رَحْلَتِهِ ، فَأَخَذُوا الْهَوْدَجَ وَهُمْ يَظُنُّونَ أَنِّي فِيهِ ، كَمَا كُنْتُ أَصْنَعُ ، فَاحْتَمَلُوهُ ، فَشَدُّوا عَلَى الْبَعِيرِ وَلَمْ يَشُكُّوا أَنِّي فِيهِ ، ثُمَّ أَخَذُوا بِرَأْسِ الْبَعِيرِ ، فَانْطَلَقُوا بِهِ ، فَرَجَعْتُ إِلَى الْعَسْكَرِ وَمَا فِيهِ دَاعٍ وَلَا مُجِيبٌ ، قَدِ انْطَلَقَ النَّاسُ .  قَالَتْ : فَتَلَفَّعْتُ بِجِلْبَابِي ، ثُمَّ اضْطَجَعْتُ فِي مَكَانِي ، وَعَرَفْتُ أَنْ لَوِ  افْتُقِدْتُ  قَدْ رَجَعَ إِلَيَّ .  قَالَتْ : فَوَاللهِ ، إِنِّي لَمُضْطَجِعَةٌ ، إِذْ مَرَّ بِي  صَفْوَانُ بْنُ الْمُعَطَّلِ السُّلَمِيُّ  ، وَقَدْ كَانَ تَخَلَّفَ عَنِ الْعَسْكَرِ ، لِبَعْضِ حَاجَتِهِ فَلَمْ يَتْبَعِ النَّاسَ ، فَرَأَى سَوَادِي ، فَأَقْبَلَ حَتَّى وَقَفَ عَلَيَّ ، وَقَدْ كَانَ يَرَانِي قَبْلَ أَنْ يُضْرَبَ الْحِجَابُ ، فَلَمَّا رَآنِي قَالَ : إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ ، ظَعِينَةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا  مُتَلَفِّعَةٌ  فِي ثِيَابِي ، وَقَالَ : مَا خَلَّفَكِ رَحِمَكِ اللهُ ؟  قَالَتْ : فَمَا كَلَّمْتُهُ ، ثُمَّ قَرَّبَ الْبَعِيرَ ، فَقَالَ : ارْكَبِي وَاسْتَأْخَرَ عَنِّي .  قَالَتْ : فَرَكِبْتُ وَأَخَذَ بِرَأْسِ الْبَعِيرِ ، فَانْطَلَقَ سَرِيعًا يَطْلُبُ النَّاسَ ، فَوَاللهِ مَا أَدْرَكْنَا النَّاسَ ، وَمَا  افْتُقِدْتُ  حَتَّى أَصْبَحْنَا وَنَزَلَ النَّاسُ ، فَلَمَّا اطْمَأَنُّوا ، طَلَعَ الرَّجُلُ يَقُودُ بِي ، فَقَالَ أَهْلُ  الْإِفْكِ  مَا قَالُوا ، فَارْتَجَّ الْعَسْكَرُ ، وَاللهِ مَا أَعْلَمُ بِشَيْءٍ مِنْ ذَلِكَ ، ثُمَّ قَدِمْنَا         [8/351]      الْمَدِينَةَ  فَلَمْ أَلْبَثْ أَنِ اشْتَكَيْتُ شَكْوَى شَدِيدَةً ، لَمْ يَبْلُغْنِي مِنْ ذَلِكَ شَيْءٌ ، وَقَدِ انْتَهَى الْحَدِيثُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَإِلَى أَبَوَيَّ ، لَا يَذْكُرُونَ مِنْهُ قَلِيلًا وَلَا كَثِيرًا ، إِلَّا أَنِّي قَدْ أَنْكَرْتُ ذَلِكَ مِنْهُ ، كَانَ إِذَا دَخَلَ عَلَيَّ وَعِنْدِي أُمِّي تُمَرِّضُنِي . قَالَ : كَيْفَ تِيكُمْ ؟ لَا يَزِيدُ عَلَى ذَلِكَ .  قَالَتْ : حَتَّى وَجَدْتُ فِي نَفْسِي ، فَقُلْتُ : يَا رَسُولَ اللهِ ، حِينَ رَأَيْتُ مَا رَأَيْتُ مِنْ جَفَائِهِ ، لَوْ أَذِنْتَ لِي فَانْتَقَلْتُ إِلَى أُمِّي فَمَرَّضَتْنِي . قَالَ : لَا عَلَيْكِ ، قَالَتْ : فَانْتَقَلْتُ إِلَى أُمِّي وَلَا أَعْلَمُ بِشَيْءٍ مِمَّا كَانَ حَتَّى نَقَهْتُ مِنْ وَجَعِي بَعْدَ  بِضْعٍ  وَعِشْرِينَ لَيْلَةً ، وَكُنَّا قَوْمًا عَرَبًا لَا نَتَّخِذُ فِي بُيُوتِنَا هَذِهِ الْكُنُفَ الَّتِي يَتَّخِذُهَا الْأَعَاجِمُ ، نَعَافُهَا وَنَكْرَهُهَا ، إِنَّمَا كُنَّا نَذْهَبُ فِي سَبَخِ  الْمَدِينَةِ  ، وَإِنَّمَا كَانَ النِّسَاءُ يَخْرُجْنَ كُلَّ لَيْلَةٍ فِي حَوَائِجِهِنَّ ، فَخَرَجْتُ لَيْلَةً لِبَعْضِ حَاجَتِي ، وَمَعِي  أُمُّ مِسْطَحٍ بِنْتُ أَبِي رُهْمِ بْنِ عَبْدِ الْمُطَّلِبِ بْنِ عَبْدِ مَنَافٍ  ، وَكَانَتْ أُمُّهَا  بِنْتُ صَخْرِ بْنِ عَامِرِ بْنِ كَعْبِ بْنِ سَعْدِ بْنِ تَيْمٍ  خَالَةَ  أَبِي بَكْرٍ الصِّدِّيقِ  . قَالَتْ : فَوَاللهِ ، إِنَّهَا لِتَمْشِي مَعِي إِذْ عَثَرَتْ فِي مِرْطِهَا ، فَقَالَتْ :  تَعِسَ  مِسْطَحٌ  .         [8/352]      قَالَتْ : قُلْتُ : بِئْسَ ،  لَعَمْرُ  اللهِ ، مَا قُلْتِ لِرَجُلٍ مِنَ  الْمُهَاجِرِينَ  قَدْ شَهِدَ  بَدْرًا  ، قَالَتْ : وَمَا بَلَغَكِ الْخَبَرُ ، يَا  بِنْتَ أَبِي بَكْرٍ  ؟  قَالَتْ : قُلْتُ : وَمَا الْخَبَرُ ؟ فَأَخْبَرَتْنِي بِالَّذِي كَانَ مِنْ قَوْلِ أَهْلِ  الْإِفْكِ  ، قَالَتْ : قُلْتُ : وَقَدْ كَانَ هَذَا ؟ قَالَتْ : نَعَمْ ، وَاللهِ لَقَدْ كَانَ ، قَالَتْ : فَوَاللهِ مَا قَدَرْتُ عَلَى أَنْ أَقْضِيَ حَاجَتِي وَرَجَعْتُ ، فَوَاللهِ ، مَا زِلْتُ أَبْكِي حَتَّى ظَنَنْتُ أَنَّ الْبُكَاءَ سَيَصْدَعُ كَبِدِي . قَالَتْ : وَقُلْتُ لِأُمِّي : يَغْفِرُ اللهُ لَكِ ، تَحَدَّثَ النَّاسُ بِمَا تَحَدَّثُوا بِهِ وَلَا تَذْكُرِينَ مِنْ ذَلِكَ شَيْئًا ؟ قَالَتْ : أَيْ بُنَيَّةُ خَفِّفِي عَلَيْكِ الشَّأْنَ ، فَوَاللهِ ، لَقَلَّ مَا كَانَتِ امْرَأَةٌ حَسْنَاءُ عِنْدَ رَجُلٍ يُحِبُّهَا ، لَهَا ضَرَائِرُ ، إِلَّا  كَثَّرْنَ  وَكَثَّرَ النَّاسُ عَلَيْهَا  ، ثُمَّ ذَكَرَ نَحْوَ حَدِيثِ  صَالِحِ بْنِ كَيْسَانَ  بِتَمَامِهِ ، عَلَى نَحْوِ مَا حَدَّثَنَا بِهِ  مُحَمَّدُ بْنُ خَالِدٍ  ، عَنْ  إِبْرَاهِيمَ بْنِ سَعْدٍ  .         [8/353]","","Musnad Abi Ya'la al-Mawsili 4935","","عائشة بنت أبي بكر الصديق عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن أحمد بن محمد بن أيوب عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4937","580 - (  4936  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ قَالَ :  قَالَ لِي  أَبِي  : إِنَّ عَائِشَةَ  قَالَتْ  لَهُ :  يَا ابْنَ أُخْتِي ، لَقَدْ رَأَيْتُ مِنْ تَعْظِيمِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْعَبَّاسَ  ، أَمْرًا عَجَبًا ، وَذَلِكَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَتْ تَأْخُذُهُ  الْخَاصِرَةُ  ، فَتَشْتَدُّ بِهِ جِدًّا ، قَالَتْ : وَكُنَّا نَقُولُ : أَخَذَتْ رَسُولَ اللهِ  عِرْقُ  الْكُلْيَةِ ، وَلَا نَهْتَدِي  لِلْخَاصِرَةِ  ، فَأَخَذَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْخَاصِرَةُ  يَوْمًا مِنْ ذَلِكَ ، فَاشْتَدَّتْ بِهِ جِدًّا حَتَّى أُغْمِيَ عَلَيْهِ ، فَخِفْنَا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَفَزِعَ النَّاسُ إِلَيْهِ .  قَالَتْ : فَظَنَنَّا أَنَّ بِهِ ذَاتَ  الْجَنْبِ  فَلَدَدْنَاهُ .  قَالَتْ : ثُمَّ  سُرِّيَ  عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَفَاقَ  .  قَالَتْ : فَعَرَفَ أَنْ قَدْ لَدَدْنَاهُ ، فَوَجَدَ أَثَرَ اللَّدِّ ، فَقَالَ :  أَظَنَنْتُمْ أَنَّ اللهَ سَلَّطَهَا عَلَيَّ ؟  مَا كَانَ اللهُ لِيُسَلِّطَهَا عَلَيَّ ، وَالَّذِي نَفْسِي بِيَدِهِ ، لَا يَبْقَى أَحَدٌ فِي الْبَيْتِ إِلَّا  لُدَّ  إِلَّا عَمِّي .  قَالَتْ  عَائِشَةُ  : فَلَقَدْ رَأَيْتُهُمْ يَوْمَئِذٍ يُلَدُّونَ رَجُلًا رَجُلًا ، قَالَتْ  عَائِشَةُ  : وَمَنْ فِي الْبَيْتِ يَوْمَئِذٍ يُذْكَرُ فَضْلُهُمْ .         [8/354]      قَالَتْ : فَلُدَّ الرِّجَالُ أَجْمَعِينَ ، قَالَتْ : ثُمَّ بَلَغَنَا وَاللهِ اللَّدُودُ ، أَزْوَاجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلُدِدْنَا وَاللهِ امْرَأَةً امْرَأَةً ، قَالَتْ : حَتَّى بَلَغَ اللَّدُودُ امْرَأَةً مِنَّا ، قَالَتْ : إِنِّي وَاللهِ صَائِمَةٌ ، فَقُلْنَا لَهَا : بِئْسَ مَا ظَنَنْتِ أَنْ نَتْرُكَكِ ، وَقَدْ أَقْسَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ : فَلَدَدْنَاهَا ، وَاللهِ يَا ابْنَ أُخْتِي وَإِنَّهَا لَصَائِمَةٌ .  قَالَ : وَقَالَ  عُرْوَةُ  :  عَبَّاسٌ  وَاللهِ أَخَذَ بِيَدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ أَتَاهُ السَّبْعُونَ مِنَ  الْأَنْصَارِ  الْعَقَبَةَ  ، فَأَخَذَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَيْهِمْ ، وَشَرَطَ عَلَيْهِمْ ، وَذَلِكَ فِي  غُرَّةِ  الْإِسْلَامِ وَأَوَّلِهِ قَبْلَ أَنْ يَعْبُدَ أَحَدٌ اللهَ عَلَانِيَةً  .         [8/355]","","Musnad Abi Ya'la al-Mawsili 4936","","عائشة بنت أبي بكر الصديق عن الزبير بن العوام عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الرحمن بن أبي الزناد عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4938","581 - (  4937  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ الْأَزْرَقِ ،  حَدَّثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  عَنْ  خَالِدِ بْنِ سَلَمَةَ ،  عَنِ  الْبَهِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَذْكُرُ اللهَ فِي كُلِّ أَحْيَانِهِ  .","","Musnad Abi Ya'la al-Mawsili 4937","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عبد الله البهي مولى مصعب بن الزبير عن الفأفأ ، خالد بن سلمة بن العاص عن زكريا بن أبي زائدة الوادعي عن إسحاق بن يوسف الأزرق عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4939","582 - (  4938  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  قَالَ :  سَأَلْتُ  عَائِشَةَ عَنْ رُقْيَةِ  الْحُمَةِ  ، قَالَتْ :  رَخَّصَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الرُّقْيَةِ مِنْ كُلِّ ذِي  حُمَةٍ  .","","Musnad Abi Ya'la al-Mawsili 4938","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن سليمان بن فيروز الشيباني عن علي بن مسهر القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4940","583 - (  4939  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ الْمِقْدَامِ بْنِ شُرَيْحٍ ،  عَنِ  الْمِقْدَامِ بْنِ شُرَيْحٍ ،  عَنْ  أَبِيهِ  ، أَنَّهُ ذَكَرَ أَنَّ عَائِشَةَ ،  حَدَّثَتْهُ  :  أَنَّهَا كَانَتْ إِذَا  عَرَكَتْ  ، قَالَ لَهَا رَسُولُ         [8/356]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  بِنْتَ أَبِي بَكْرٍ  ، اشْدُدِي عَلَى وَسَطِكِ  ، وَكَانَ يُبَاشِرُهَا مِنَ اللَّيْلِ مَا شَاءَ اللهُ ، وَكَانَ يُكَبِّرُ لِصَلَاتِهِ ، وَقَلَّ مَا كَانَ يَنَامُ مِنَ اللَّيْلِ ، لَمَّا قَالَ اللهُ :         {      قُمِ اللَّيْلَ إِلا قَلِيلا         }      .","","Musnad Abi Ya'la al-Mawsili 4939","","عائشة بنت أبي بكر الصديق عن شريح بن هانئ المذحجي عن المقدام بن شريح الحارثي عن يزيد بن المقدام بن شريح الحضرمي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4941","584 - (  4940  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  صَلَاتَانِ مَا تَرَكَهُمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سِرًّا وَلَا عَلَانِيَةً  : رَكْعَتَيْنِ قَبْلَ الْفَجْرِ ، وَرَكْعَتَيْنِ بَعْدَ الْعَصْرِ  .","","Musnad Abi Ya'la al-Mawsili 4940","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن سليمان بن فيروز الشيباني عن علي بن مسهر القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4942","585 - (  4941  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَخْبَرَنَا  زُهَيْرٌ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ،  عَنْ  مُجَاهِدٍ ،  أَنَّ  السَّائِبَ ،  سَأَلَ  عَائِشَةَ ، فَقَالَ : إِنِّي قَدْ كَبِرْتُ ، وَإِنِّي لَا أَسْتَطِيعُ أَنْ         [8/357]      أُصَلِّيَ إِلَّا جَالِسًا ، فَكَيْفَ تَرَيْنَ ؟ فَقَالَتْ :  إِنِّي سَمِعْتُ رَسُولَ اللهِ ، أَوْ قَالَ رَسُولُ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَلَاةُ الْجَالِسِ عَلَى النِّصْفِ مِنْ صَلَاتِهِ قَائِمًا  .","","Musnad Abi Ya'la al-Mawsili 4941","","عائشة بنت أبي بكر الصديق عن السائب بن أبي السائب المخزومي عن مجاهد بن جبر المخزومي عن إبراهيم بن مهاجر بن جابر البجلي عن زهير بن معاوية بن حديج عن علي بن الجعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4943","586 - (  4942  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  حَدَّثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  كُنْتُ أَفْتِلُ قَلَائِدَ هَدْيِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَبْعَثُ بِهَا  ، ثُمَّ لَا يَجْتَنِبُ شَيْئًا مِمَّا يَجْتَنِبُهُ الْمُحْرِمُ  .","","Musnad Abi Ya'la al-Mawsili 4942","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن علي بن الجعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4944","587 - (  4943  ) -  حَدَّثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَخْبَرَنِي  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي بُرْدَةَ  قَالَ  :         [8/358]      دَخَلْنَا عَلَى عَائِشَةَ ، فَأَخْرَجَتْ إِلَيْنَا إِزَارًا غَلِيظًا مِمَّا يُصْنَعُ  بِالْيَمَنِ  ، وَكِسَاءً مِنْ هَذِهِ الَّتِي تَدْعُونَهَا  الْمُلَبَّدَةَ  ، قَالَتْ : قُبِضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي هَذَيْنِ الثَّوْبَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 4943","","عائشة بنت أبي بكر الصديق عن أبو بردة بن أبي موسى الأشعري عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن علي بن الجعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4945","588 - (  4944  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  بِإِسْنَادِهِ  نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 4944","","عائشة بنت أبي بكر الصديق عن أبو بردة بن أبي موسى الأشعري عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4946","589 - (  4945  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ أَبِي ثَوْرٍ ،  عَنْ  عِكْرِمَةَ قَالَ :  سَأَلْتُ  عَائِشَةَ هَلْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَمَثَّلُ شِعْرًا قَطُّ ؟  قَالَتْ : كَانَ أَحْيَانًا إِذَا دَخَلَ بَيْتَهُ يَقُولُ :         [8/359]","","Musnad Abi Ya'la al-Mawsili 4945","","عائشة بنت أبي بكر الصديق عن عكرمة مولى ابن عباس عن الوليد بن عبد الله بن أبي ثور المرهبي عن محمد بن بكار الرصافي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4947","590 - (  4946  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي مَعْشَرٍ ،  حَدَّثَنَا  أَبِي أَبُو مَعْشَرٍ  ،  عَنْ  عَبْدِ اللهِ بْنِ يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ قَالَتْ :  عَطَسَ  رَجُلٌ  عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : مَا أَقُولُ يَا رَسُولَ اللهِ ؟ قَالَ : قُلِ : الْحَمْدُ لِلهِ  ، قَالَ  الْقَوْمُ  : مَا نَقُولُ لَهُ يَا رَسُولَ اللهِ ؟ قَالَ : قُولُوا : رَحِمَكَ اللهُ ، قَالَ الرَّجُلُ : مَا أَرُدُّ عَلَيْهِمْ يَا رَسُولَ اللهِ ؟ قَالَ : قُلْ : يَهْدِيكُمُ اللهُ وَيُصْلِحُ بَالَكُمْ  .         [8/360]","","Musnad Abi Ya'la al-Mawsili 4946","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن عبد الله بن يحيى بن عبد الرحمن عن نجيح بن عبد الرحمن السندي عن محمد بن أبي معشر السندي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4948","591 - (  4947  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْحَاقَ بْنِ يَحْيَى ،  عَنْ  أَبِي بَكْرِ بْنِ حَزْمٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الرَّاشِيَ  ، وَالْمُرْتَشِيَ  .","","Musnad Abi Ya'la al-Mawsili 4947","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن أبو بكر بن محمد الخزرجي عن إسحاق بن يحيى بن طلحة التيمي عن مروان بن معاوية الفزاري عن أحمد بن منيع البغوي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4949","592 - (  4948  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ الْوَلِيدِ الْمَدَنِيُّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَلَّى بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ عِشْرِينَ رَكْعَةً  ، بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .         [8/361]","","Musnad Abi Ya'la al-Mawsili 4948","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن يعقوب بن الوليد الأزدي عن أحمد بن منيع البغوي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4950","593 - (  4949  ) -  حَدَّثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ - إِنْ شَاءَ اللهُ ،  هَكَذَا أَمْلَاهُ عَلَيْنَا  عَبْدُ الْأَعْلَى  - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَبْرِدُوا  بِالظُّهْرِ فِي شِدَّةِ الْحَرِّ  .","","Musnad Abi Ya'la al-Mawsili 4949","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن داود الخريبي عن عبد الأعلى بن حماد النرسي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4951","594 - (  4950  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  يُوسُفَ بْنِ مَيْمُونٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ سَرَّهُ أَنْ يَسْبِقَ الدَّائِبَ الْمُجْتَهِدَ  ، فَلْيَكُفَّ عَنِ الذُّنُوبِ  .","","Musnad Abi Ya'la al-Mawsili 4950","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن يوسف بن ميمون الصباغ عن علي بن مسهر القرشي عن سويد بن سعيد الحدثاني عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4952","595 - (  4951  ) -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ الْهُذَلِيُّ ،  حَدَّثَنَا  أَشْعَثُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ زُبَيْدٍ الْأَيَامِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصْغِي الْإِنَاءَ لِلسِّنَّوْرِ  ، فَتَشْرَبُ مِنْهُ ، ثُمَّ يَتَوَضَّأُ لِلصَّلَاةِ  .         [8/362]","","Musnad Abi Ya'la al-Mawsili 4951","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن سعيد المقبري عن عبد الله بن سعيد بن أبي سعيد المقبري عن أشعث بن عبد الرحمن بن زبيد اليامي عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4953","596 - (  4952  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ حَبِيبٍ ،  عَنِ  ابْنِ أَبِي حُسَيْنٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  هِجْرَةَ  بَعْدَ الْفَتْحِ  ، وَلَكِنْ  جِهَادٌ  وَنِيَّةٌ ، وَإِذَا  اسْتُنْفِرْتُمْ  فَانْفِرُوا  .         [8/363]","","Musnad Abi Ya'la al-Mawsili 4952","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن عبد الله بن عبد الرحمن بن أبي حسين النوفلي عن عبد الله بن حبيب بن أبي ثابت عن عبد الله بن نمير عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4954","597 - (  4953  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ نَافِعٍ مَوْلَى آلِ زَيْدِ بْنِ الْخَطَّابِ قَالَ :  حَدَّثَنِي  أَبُو بَكْرِ بْنُ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ قَالَ :  قَالَتْ  عَمْرَةُ ،  قَالَتْ  عَائِشَةُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَقِيلُوا ذَوِي  الْهَيْئَاتِ  زَلَّاتِهِمْ  .         [8/364]      قَالَ :  فَحَضَرْتُ  أَبَا بَكْرِ بْنَ عَمْرِو بْنِ حَزْمٍ  قَضَى بِذَلِكَ  .         [8/365]","","Musnad Abi Ya'la al-Mawsili 4953","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن أبو بكر بن محمد الخزرجي عن أبو بكر بن نافع مولى عمر بن الخطاب عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4955","598 - (  4954  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنِيعٍ ،  حَدَّثَنَا  مَرْوَانُ ،  عَنْ  رَزِينٍ الْبَكْرِيِّ ،  حَدَّثَتْنَا  مَوْلَاةٌ لَنَا يُقَالُ لَهَا : سَلْمَى مِنْ بَكْرِ بْنِ وَائِلٍ ،  أَنَّهَا سَمِعَتْ  عَائِشَةَ ، تَقُولُ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا  عَائِشَةُ  ، هَلْ مِنْ كِسْرَةٍ ؟  فَأَتَيْتُهُ بِقُرْصٍ ، فَوَضَعَ عَلَى فِيهِ ، وَقَالَ : يَا  عَائِشَةُ  ، هَلْ دَخَلَ بَطْنِي مِنْهُ شَيْءٌ ؟ كَذَلِكَ قُبْلَةُ الصَّائِمِ ، إِنَّمَا الْإِفْطَارُ مِمَّا دَخَلَ ، وَلَيْسَ مِمَّا خَرَجَ  .","","Musnad Abi Ya'la al-Mawsili 4954","","عائشة بنت أبي بكر الصديق عن سلمى البكرية عن رزين بن حبيب الجهني عن مروان بن معاوية الفزاري عن أحمد بن منيع البغوي عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4956","599 - (  4955  ) -  حَدَّثَنَا  هَارُونُ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  مُجَالِدٌ ،  عَنْ  عَامِرٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا أَبْكِي ، فَقَالَ : مَا يُبْكِيكِ ؟ قُلْتُ : سَبَّتْنِي  فَاطِمَةُ  ، فَدَعَا  فَاطِمَةَ  ، فَقَالَ : يَا  فَاطِمَةُ  سَبَبْتِ  عَائِشَةَ  ؟ قَالَتْ : نَعَمْ يَا رَسُولَ اللهِ ، قَالَ : يَا  فَاطِمَةُ  ، أَلَيْسَ تُحِبِّينَ مَنْ أُحِبُّ ؟ قَالَتْ : نَعَمْ ، وَتُبْغِضِينَ مَنْ أُبْغِضُ ؟ قَالَتْ : بَلَى ، قَالَ : فَإِنِّي أُحِبُّ  عَائِشَةَ  ، فَأَحِبِّيهَا ، قَالَتْ  فَاطِمَةُ  : لَا أَقُولُ  لِعَائِشَةَ  شَيْئًا يُؤْذِيهَا أَبَدًا  .         [8/366]","","Musnad Abi Ya'la al-Mawsili 4955","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن حماد بن أسامة القرشي عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4957","600 - (  4956  ) -  حَدَّثَنَا  أَبُو مُوسَى الْحَمَّالُ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحِبُّ الْحَلْوَاءَ وَالْعَسَلَ  .","","Musnad Abi Ya'la al-Mawsili 4956","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4958","601 - (  4957  ) -  حَدَّثَنَا  هَارُونُ الْحَمَّالُ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا صَلَّى الْعَصْرَ دَارَ عَلَى نِسَائِهِ  ، فَيَدْنُو مِنْهُنَّ  .","","Musnad Abi Ya'la al-Mawsili 4957","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4959","602 - (  4958  ) -  حَدَّثَنَا  أَبُو مُوسَى أَيْضًا ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ فِرَاشُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الَّذِي نَرْقُدُ فِيهِ ، مِنْ أَدَمٍ حَشْوُهُ لِيفٌ  .","","Musnad Abi Ya'la al-Mawsili 4958","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4960","603 - (  4959  ) -  وَبِإِسْنَادِهِ  عَنْ  عَائِشَةَ قَالَتْ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَامَ الْفَتْحِ  مِنْ  كَدَاءٍ  مِنْ أَعْلَى  مَكَّةَ  ، وَدَخَلَ فِي الْعُمْرَةِ مِنْ         [8/367]      كُدًا  قَالَ :  فَكَانَ عُرْوَةُ يَدْخُلُ مِنْهُمَا جَمِيعًا ، وَكَانَ أَكْثَرَ مَا يَدْخُلُ مِنْ  كَدَاءٍ  ، وَكَانَ أَقْرَبَهُمَا إِلَى مَنْزِلِهِ  .","","Musnad Abi Ya'la al-Mawsili 4959","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن أبو موسى الزمن عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4961","604 - (  4960  ) -  وَبِإِسْنَادِهِ  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَشْتَدُّ عَلَيْهِ أَنْ يُوجَدَ مِنْهُ  .         [8/368]      قَالَ أَبُو يَعْلَى :  يَعْنِي رِيحَ الثُّومِ وَالْبَصَلِ  .","","Musnad Abi Ya'la al-Mawsili 4960","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن هارون بن عبد الله بن مروان الحمال عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4962","605 - (  4961  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  عَوْبَدُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ الصَّامِتِ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ ، يَكُونُ لِي جَارَانِ ، أَحَدُهُمَا : بَابُهُ قُبَالَةَ بَابِي ، وَالْآخَرُ : شَاسِعٌ عَنْ بَابِي ، وَهُوَ أَقْرَبُ فِي الْجِدَارِ ، فَبِأَيِّهِمَا أَبْدَأُ ؟ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ابْدَئِي بِالَّذِي بَابُهُ قُبَالَةَ بَابِكِ  .  قَالَ  عَبْدُ الْمَلِكِ : هُوَ أَبُو عِمْرَانَ الْجَوْنِيُّ  .","","Musnad Abi Ya'la al-Mawsili 4961","","عائشة بنت أبي بكر الصديق عن عبد الله بن الصامت الغفاري عن عبد الملك بن حبيب الجوني عن عوبد بن عبد الملك عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4963","606 - (  4962  ) -  حَدَّثَنَا  أَبُو هَمَّامٍ ،  حَدَّثَنَا  عَوْبَدُ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ بَابَنُوسَ  قَالَ  :  دَخَلْتُ أَنَا وَرَجُلَانِ آخَرَانِ عَلَى عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، فَقَالَ لَهَا  رَجُلٌ  مِنَّا : يَا أُمَّ الْمُؤْمِنِينَ مَا تَقُولِينَ فِي  الْعِرَاكِ  ؟ قَالَتْ : وَمَا  الْعِرَاكُ  ؟ الْمَحِيضُ هُوَ ؟ قَالَ : نَعَمْ ، قَالَتْ : فَهُوَ الْمَحِيضُ كَمَا         [8/369]      سَمَّاهُ اللهُ ، قَالَتْ : كَأَنِّي إِذَا كَانَ ذَاكَ اتَّزَرْتُ بِإِزَارِي ، فَكَانَ لَهُ مَا فَوْقَ الْإِزَارِ . فَأَنْشَأَتْ تُحَدِّثُنَا ، قَالَتْ : مَا مَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى بَابِي يَوْمًا قَطُّ ، إِلَّا قَدْ قَالَ كَلِمَةً تَقَرُّ بِهَا عَيْنِي . قَالَتْ : فَمَرَّ يَوْمًا فَلَمْ يُكَلِّمْنِي ، وَمَرَّ مِنَ الْغَدِ فَلَمْ يُكَلِّمْنِي ، قَالَتْ : وَمَرَّ مِنَ الْغَدِ فَلَمْ يُكَلِّمْنِي ، وَمَرَّ مِنَ الْغَدِ فَلَمْ يُكَلِّمْنِي ، قُلْتُ : وَجَدَ عَلَيَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي شَيْءٍ ، قَالَتْ : فَعَصَبْتُ رَأْسِي ،         [8/370]      وَصَفَّرْتُ وَجْهِي ، وَأَلْقَيْتُ وِسَادَةً قُبَالَةَ بَابِ الدَّارِ ،  فَاجْتَنَحْتُ  عَلَيْهَا ، قَالَتْ : فَمَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَنَظَرَ إِلَيَّ ، فَقَالَ :  مَا لَكِ يَا  عَائِشَةُ  ؟ قَالَتْ : يَا رَسُولَ اللهِ ، اشْتَكَيْتُ وَصُدِّعْتُ  قَالَ : يَقُولُ : بَلْ ، وَارَأْسَاهُ ، قَالَتْ : فَمَا لَبِثْتُ إِلَّا قَلِيلًا ، حَتَّى أُتِيتُ بِهِ يُحْمَلُ فِي كِسَاءٍ ، قَالَتْ : فَمَرَّضْتُهُ ، وَلَمْ أُمَرِّضْ مَرِيضًا قَطُّ ، وَلَا رَأَيْتُ مَيِّتًا قَطُّ ، قَالَتْ : فَرَفَعَ رَأْسَهُ ، فَأَخَذْتُهُ فَأَسْنَدْتُهُ إِلَى صَدْرِي .  قَالَتْ : فَدَخَلَ  أُسَامَةُ بْنُ زَيْدٍ  ، وَبِيَدِهِ سِوَاكُ أَرَاكٍ رَطِبٌ ، قَالَتْ : فَلَحَطَ إِلَيْهِ ، قَالَتْ : فَظَنَنْتُ أَنَّهُ يُرِيدُهُ ، فَأَخَذْتُهُ ، فَنَكَثْتُهُ بِفِي ، فَدَفَعْتُهُ إِلَيْهِ ، قَالَتْ : فَأَخَذَهُ ، فَأَهْوَاهُ إِلَى فِيهِ ، قَالَتْ : فَخَفَقَتْ يَدُهُ ، فَسَقَطَ مِنْ يَدِهِ ، ثُمَّ أَقْبَلَ بِوَجْهِهِ إِلَيَّ حَتَّى إِذَا كَانَ فَاهُ فِي ثَغْرِي ، سَالَ مِنْ فِيهِ نُقْطَةٌ بَارِدَةٌ اقْشَعَرَّ مِنْهَا جِلْدِي ، وَثَارَ رِيحُ الْمِسْكِ فِي وَجْهِي ، فَمَالَ رَأْسُهُ ، فَظَنَنْتُ أَنَّهُ غُشِيَ عَلَيْهِ .  قَالَتْ : فَأَخَذْتُهُ فَنَوَّمْتُهُ عَلَى الْفِرَاشِ ، وَغَطَّيْتُ وَجْهَهُ ، قَالَتْ : فَدَخَلَ أَبِي  أَبُو بَكْرٍ  ، فَقَالَ : كَيْفَ تَرَيْنَ ؟ فَقُلْتُ : غُشِيَ عَلَيْهِ ، فَدَنَا مِنْهُ ، فَكَشَفَ عَنْ وَجْهِهِ ، فَقَالَ : يَا غَشْيَاهُ مَا أَكْوَنَ هَذَا بِغَشْيٍ ، ثُمَّ كَشَفَ عَنْ وَجْهِهِ ، فَعَرَفَ الْمَوْتَ ، فَقَالَ :         [8/371]      إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ ، ثُمَّ بَكَى ، فَقُلْتُ : فِي  سَبِيلِ  اللهِ انْقِطَاعُ الْوَحْيِ وَدُخُولُ  جِبْرِيلَ  بَيْتِي ، ثُمَّ وَضَعَ يَدَيْهِ عَلَى صُدْغَيْهِ ، وَوَضَعَ فَاهُ عَلَى جَبِينِهِ ، فَبَكَى ، حَتَّى سَالَ دُمُوعُهُ عَلَى وَجْهِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ غَطَّى وَجْهَهُ ، وَخَرَجَ إِلَى النَّاسِ ، وَهُوَ يَبْكِي ، فَقَالَ : يَا مَعْشَرَ الْمُسْلِمِينَ ، هَلْ عِنْدَ أَحَدٍ مِنْكُمْ عَهْدٌ ، بِوَفَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟  قَالُوا : لَا ، ثُمَّ أَقْبَلَ عَلَى  عُمَرَ  ، فَقَالَ : يَا  عُمَرُ  ، أَعِنْدَكَ عَهْدٌ بِوَفَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : لَا قَالَ : وَالَّذِي لَا إِلَهَ غَيْرُهُ ، لَقَدْ ذَاقَ الْمَوْتَ ، وَلَقَدْ قَالَ لَهُمْ : إِنِّي مَيِّتٌ ، وَإِنَّكُمْ مَيِّتُونَ ، فَضَجَّ النَّاسُ ، وَبَكَوْا بُكَاءً شَدِيدًا ، ثُمَّ خَلَّوْا بَيْنَهُ وَبَيْنَ أَهْلِ بَيْتِهِ ، فَغَسَّلَهُ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ،  وَأُسَامَةُ بْنُ زَيْدٍ  يَصُبُّ عَلَيْهِ الْمَاءَ ، فَقَالَ  عَلِيٌّ  : مَا نَسِيتُ مِنْهُ شَيْئًا لَمْ أُغَسِّلْهُ إِلَّا قُلِبَ لِي حَتَّى أَرَى أَحَدًا فَأُغَسِّلُهُ مِنْ غَيْرِ أَنْ أَرَى أَحَدًا ، حَتَّى فَرَغْتُ مِنْهُ ، ثُمَّ كَفَّنُوهُ بِبُرْدٍ يَمَانِيٍّ أَحْمَرَ ،  وَرِيطَتَيْنِ  قَدْ نِيلَ مِنْهُمَا ثُمَّ غُسِلَا ، ثُمَّ أُضْجِعَ عَلَى السَّرِيرِ ، ثُمَّ أَذِنُوا لِلنَّاسِ ، فَدَخَلُوا عَلَيْهِ  فَوْجًا  فَوْجًا  يُصَلُّونَ عَلَيْهِ بِغَيْرِ إِمَامٍ ، حَتَّى لَمْ يَبْقَ أَحَدٌ  بِالْمَدِينَةِ  حُرٌّ  ، وَلَا عَبْدٌ إِلَّا صَلَّى عَلَيْهِ ، ثُمَّ تَشَاجَرُوا فِي دَفْنِهِ ، أَيْنَ يُدْفَنُ ؟ فَقَالَ بَعْضُهُمْ : عِنْدَ الْعُودِ الَّذِي كَانَ يُمْسِكُ بِيَدِهِ ، وَتَحْتَ مِنْبَرِهِ .  وَقَالَ بَعْضُهُمْ : فِي  الْبَقِيعِ  ، حَيْثُ كَانَ يَدْفِنُ مَوْتَاهُ .  فَقَالُوا : لَا نَفْعَلُ ذَلِكَ ، إِذًا لَا يَزَالُ عَبْدُ أَحَدِكُمْ وَوَلِيدَتُهُ         [8/372]      قَدْ غَضِبَ عَلَيْهِ مَوْلَاهُ  فَيَلُوذُ  بِقَبْرِهِ ، فَيَكُونُ سُنَّةً ، فَاسْتَقَامَ رَأْيُهُمْ عَلَى أَنْ يُدْفَنَ فِي بَيْتِهِ ، تَحْتَ فِرَاشِهِ حَيْثُ قُبِضَ رُوحُهُ ، فَلَمَّا مَاتَ  أَبُو بَكْرٍ  ، دُفِنَ مَعَهُ ، فَلَمَّا حَضَرَ  عُمَرَ بْنَ الْخَطَّابِ  الْمَوْتُ ، أَوْصَى قَالَ : إِذَا مَا مُتُّ ، فَاحْمِلُونِي إِلَى بَابِ بَيْتِ  عَائِشَةَ  ، فَقُولُوا لَهَا : هَذَا  عُمَرُ بْنُ الْخَطَّابِ  ،  يُقْرِئُكِ  السَّلَامَ ، وَيَقُولُ : أَدْخُلُ أَوْ أَخْرُجُ ؟ قَالَ : فَسَكَتَتْ سَاعَةً ، ثُمَّ قَالَتْ : أَدْخِلُوهُ ، فَادْفِنُوهُ ، مَعَهُ ،  أَبُو بَكْرٍ  عَنْ يَمِينِهِ ،  وَعُمَرُ  عَنْ يَسَارِهِ ، قَالَتْ : فَلَمَّا دُفِنَ  عُمَرُ  ، أَخَذْتُ الْجِلْبَابَ ، فَتَجَلْبَبْتُ بِهِ قَالَ : فَقِيلَ لَهَا : مَا لَكِ وَلِلْجِلْبَابِ ؟ قَالَتْ : كَانَ هَذَا زَوْجِي ، وَهَذَا أَبِي ، فَلَمَّا دُفِنَ  عُمَرُ  تَجَلْبَبْتُ  .         [8/373]","","Musnad Abi Ya'la al-Mawsili 4962","","عائشة بنت أبي بكر الصديق عن يزيد بن بابنوس البصري عن عبد الملك بن حبيب الجوني عن عويد بن أبي عمران الجوني عن الوليد بن شجاع عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4964","607 - (  4963  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ قَالَتْ :  جَاءَتْ  جُوَيْرِيَةُ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : إِنِّي وَقَعْتُ فِي السَّهْمِ  لِثَابِتِ بْنِ قَيْسِ بْنِ شَمَّاسٍ  ، أَوْ لِابْنِ عَمٍّ لَهُ ، فَكَاتَبْتُهُ عَلَى نَفْسِي ، فَجِئْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَسْتَعِينُهُ عَلَى كِتَابَتِي ، فَقَالَ :  هَلْ لَكِ فِي خَيْرٍ مِنْ ذَلِكَ أَقْضِي كِتَابَكِ وَأَتَزَوَّجُكِ ؟  قَالَتْ : نَعَمْ قَالَ : فَقَدْ فَعَلْتُ  .","","Musnad Abi Ya'la al-Mawsili 4963","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن جعفر بن الزبير بن العوام عن محمد بن إسحاق عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4965","608 - (  4964  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ قَالَتْ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ  رَجُلٍ  طَلَّقَ  امْرَأَتَهُ  الْبَتَّةَ  ،  يَعْنِي ثَلَاثًا  ، فَتَزَوَّجَتْ  رَجُلًا  ، فَطَلَّقَهَا قَبْلَ أَنْ يَدْخُلَ بِهَا ، أَتَرْجِعُ إِلَى الْأَوَّلِ ؟ فَقَالَ :  لَا ، حَتَّى يَذُوقَ مِنْ         [8/374]      عُسَيْلَتِهَا  مَا ذَاقَ صَاحِبُهُ  .","","Musnad Abi Ya'la al-Mawsili 4964","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبيد الله بن عمر العمري عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4966","609 - (  4965  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْقَاسِمِ ،  عَنْ  عَائِشَةَ ، مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 4965","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4967","610 - (  4966  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  يَحْيَى بْنُ زَكَرِيَّا ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 4966","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يحيى بن سعيد الأنصاري عن يحيى بن زكريا بن أبي زائدة عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عائشة أم المؤمنين رضي الله عنها"
"4968","[8/375]             [8/376]      مُسْنَدُ عَبْدِ اللهِ بْنِ مَسْعُودٍ .  1 - (  4967  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى         [8/377]      الْمَوْصِلِيُّ ،  حَدَّثَنَا  أَبُو خَيْثَمَةَ زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  دَخَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمَسْجِدَ ،         [8/378]      وَحَوْلَ  الْكَعْبَةِ  ثَلَاثُمِائَةٍ وَسِتُّونَ صَنَمًا  ، فَجَعَلَ يَطْعَنُهَا بِعُودٍ كَانَ مَعَهُ ، وَيَقُولُ :         {      جَاءَ الْحَقُّ وَزَهَقَ الْبَاطِلُ إِنَّ الْبَاطِلَ كَانَ زَهُوقًا         }      .","","Musnad Abi Ya'la al-Mawsili 4967","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4969","2 - (  4968  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،         [8/379]      عَنْ  عَبْدِ اللهِ قَالَ :  انْشَقَّ الْقَمَرُ عَلَى عَهْدِ رَسُولِ اللهِ شِقَّتَيْنِ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اشْهَدُوا  .         [8/380]","","Musnad Abi Ya'la al-Mawsili 4968","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4970","3 - (  4969  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  حَدَّثَنَا  عَبْدُ الْكَرِيمِ الْجَزَرِيُّ ،  عَنْ  زِيَادِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَعْقِلٍ  قَالَ  :         [8/381]             [8/382]      دَخَلْتُ مَعَ أَبِي عَلَى عَبْدِ اللهِ ، فَقَالَ : سَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  النَّدَمُ تَوْبَةٌ  ؟ قَالَ : نَعَمْ  .         [8/383]","","Musnad Abi Ya'la al-Mawsili 4969","","عبد الله بن مسعود عن عبد الله بن معقل بن مقرن المزني عن زياد بن أبي مريم الجزري عن عبد الكريم الاصطخري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4971","4 - (  4970  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ :  كُنَّا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَارٍ ، فَنَزَلَتْ عَلَيْهِ :         {      وَالْمُرْسَلاتِ عُرْفًا         }      ، فَأَخَذْتُهَا مِنْ فِيهِ ، وَإِنَّ فَاهُ لَرَطْبٌ ،  فَمَا أَدْرِي بِأَيِّهَا خَتَمَ :         {      فَبِأَيِّ حَدِيثٍ بَعْدَهُ يُؤْمِنُونَ         }      ، أَوْ         {      وَإِذَا قِيلَ لَهُمُ ارْكَعُوا لا يَرْكَعُونَ         }      ، فَسَبَقَتْنَا حَيَّةٌ فَدَخَلَتْ فِي جُحْرٍ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وُقِيتُمْ شَرَّهَا ، وَوُقِيَتْ شَرَّكُمْ  .         [8/384]","","Musnad Abi Ya'la al-Mawsili 4970","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4972","5 - (  4971  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ قَالَ :  قَالَ  عَبْدُ اللهِ :  كُنَّا نُسَلِّمُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَرُدُّ عَلَيْنَا ، يَعْنِي فِي الصَّلَاةِ ، فَلَمَّا أَنْ جِئْنَا مِنْ  أَرْضِ الْحَبَشَةِ  سَلَّمْتُ عَلَيْهِ ، فَلَمْ يَرُدَّ عَلَيَّ ، فَأَخَذَنِي مَا بَعُدَ وَمَا قَرُبَ ، فَجَلَسْتُ حَتَّى إِذَا قَضَى الصَّلَاةَ ، قُلْتُ لَهُ : إِنَّكَ كُنْتَ تَرُدُّ عَلَيْنَا ، فَقَالَ :  إِنَّ اللهَ يُحْدِثُ مَا شَاءَ ، وَقَدْ أَحْدَثَ فِي أَمْرِهِ قَضَاءً ، أَنْ لَا تَتَكَلَّمُوا فِي الصَّلَاةِ  .         [8/385]             [8/386]","","Musnad Abi Ya'la al-Mawsili 4971","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4973","6 - (  4972  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هُشَيْمُ بْنُ بَشِيرٍ ،  حَدَّثَنَا  مُغِيرَةُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ قَالَ :  رَأَيْتُ  عَبْدَ اللهِ بْنَ مَسْعُودٍ ، رَمَى جَمْرَةَ الْعَقَبَةِ مِنْ بَطْنِ الْوَادِي  ، فَقَالَ : هَذَا وَالَّذِي لَا إِلَهَ غَيْرُهُ ، مَقَامُ الَّذِي أُنْزِلَتْ عَلَيْهِ سُورَةُ الْبَقَرَةِ  .         [8/387]","","Musnad Abi Ya'la al-Mawsili 4972","","عبد الله بن مسعود عن عبد الرحمن بن يزيد الأبناوي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4974","7 - (  4973  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  شِبَاكٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هُنَيِّ بْنِ نُوَيْرَةَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَعَفُّ النَّاسِ  قِتْلَةً  أَهْلُ الْإِيمَانِ  .         [8/388]","","Musnad Abi Ya'la al-Mawsili 4973","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن هني بن نويرة الضبي عن إبراهيم النخعي عن شباك الضبي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4975","8 - (  4974  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  غُنْدَرٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  شِبَاكٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  هُنَيِّ بْنِ نُوَيْرَةَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَعَفُّ النَّاسِ  قِتْلَةً  أَهْلُ الْإِيمَانِ  .","","Musnad Abi Ya'la al-Mawsili 4974","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن هني بن نويرة الضبي عن إبراهيم النخعي عن شباك الضبي عن المغيرة بن مقسم الضبي عن شعبة بن الحجاج عن غندر ربيب شعبة عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4976","9 - (  4975  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  حَفْصٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الْإِسْلَامَ بَدَأَ  غَرِيبًا  ، وَسَيَعُودُ كَمَا بَدَأَ ،  فَطُوبَى  لِلْغُرَبَاءِ قَالَ : قِيلَ : وَمَا الْغُرَبَاءُ ؟ قَالَ :  النُّزَّاعُ  مِنَ الْقَبَائِلِ  .         [8/389]","","Musnad Abi Ya'la al-Mawsili 4975","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن الأعمش عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4977","10 - (  4976  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَابِعُوا بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  ، فَإِنَّهُمَا يَنْفِيَانِ الْفَقْرَ وَالذُّنُوبَ ، كَمَا يَنْفِي  الْكِيرُ  خَبَثَ  الْحَدِيدِ وَالذَّهَبِ وَالْفِضَّةِ ، وَلَيْسَ لِلْحَجَّةِ  الْمَبْرُورَةِ  جَزَاءٌ إِلَّا الْجَنَّةُ  .         [8/390]","","Musnad Abi Ya'la al-Mawsili 4976","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن عمرو بن قيس الملائي عن سليمان بن حيان الأحمر عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4978","11 - (  4977  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الشَّمْسَ تَطْلُعُ حِينَ تَطْلُعُ ، بَيْنَ  قَرْنَيْ  شَيْطَانٍ  قَالَ : فَكُنَّا نُنْهَى عَنِ الصَّلَاةِ عِنْدَ طُلُوعِ الشَّمْسِ ، وَعِنْدَ غُرُوبِهَا ، وَنِصْفَ النَّهَارِ  .","","Musnad Abi Ya'la al-Mawsili 4977","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4979","12 - (  4978  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عَبْدُ الرَّحِيمِ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  خَرَجْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِحَاجَةٍ ، فَقَالَ :  ائْتِنِي بِشَيْءٍ أَسْتَنْجِي بِهِ  ، وَلَا تُقْرِبْنِي حَائِلًا ، وَلَا رَجِيعًا  .         [8/391]             [8/392]             [8/393]","","Musnad Abi Ya'la al-Mawsili 4978","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن ليث بن أبي سليم عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4980","13 - (  4979  ) -  حَدَّثَنَا  أَبُو نَصْرٍ عَبْدُ الْمَلِكِ بْنُ عَبْدِ الْعَزِيزِ التَّمَّارُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ، أَنَّ ابْنَ مَسْعُودٍ ،  حَدَّثَهُمْ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَكُونُ فِي النَّارِ قَوْمٌ مَا شَاءَ اللهُ ، ثُمَّ يَرْحَمُهُمُ اللهُ  ، فَيُخْرِجُهُمْ ، فَيَكُونُونَ فِي أَدْنَى الْجَنَّةِ ، فَيَغْتَسِلُونَ فِي نَهَرِ الْحَيَاةِ ، وَيُسَمِّيهِمْ أَهْلُ الْجَنَّةِ         [8/394]      الْجَهَنَّمِيِّينَ ، لَوْ أَضَافَ أَحَدُهُمْ أَهْلَ الدُّنْيَا ، لَأَطْعَمَهُمْ وَسَقَاهُمْ ، وَلَحَفَهُمْ وَفَرَشَهُمْ ، قَالَ -  وَأَحْسَبُهُ قَالَ - : وَزَوَّجَهُمْ  ، لَا يَنْقُصُ ذَلِكَ مِمَّا عِنْدَهُ شَيْئًا  .","","Musnad Abi Ya'la al-Mawsili 4979","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن عطاء بن السائب عن حماد بن سلمة عن عبد الملك بن عبد العزيز القشيري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4981","14 - (  4980  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ آخِرَ مَنْ يَدْخُلُ         [8/395]      الْجَنَّةَ ، رَجُلٌ يَمْشِي عَلَى الصِّرَاطِ مَرَّةً ، وَيَكْبُو مَرَّةً  ، وَتَسْفَعُهُ النَّارُ مَرَّةً ، فَإِذَا الْتَفَتَ إِلَيْهَا قَالَ : الْحَمْدُ لِلهِ الَّذِي نَجَّانِي مِنْكِ ، لَقَدْ أَعْطَانِيَ اللهُ شَيْئًا لَمْ يُعْطِهِ أَحَدًا مِنَ الْأَوَّلِينَ ، وَلَمْ يُعْطِهِ أَحَدًا مِنَ الْآخِرِينَ ، فَتُرْفَعُ لَهُ شَجَرَةٌ ، فَيَقُولُ : أَيْ رَبِّ أَدْنِنِي مِنْ هَذِهِ الشَّجَرَةِ فَأَسْتَظِلَّ بِظِلِّهَا ، وَأَشْرَبَ مِنْ مَائِهَا ، فَيَقُولُ اللهُ : يَا ابْنَ آدَمَ ، لَعَلِّي إِنْ أَدْنَيْتُكَ مِنْهَا أَنْ تَسْأَلَنِي غَيْرَهَا ، فَيُعَاهِدُهُ أَنْ لَا يَسْأَلَهُ ، وَرَبُّهُ يَعْلَمُ أَنَّهُ سَيَسْأَلُهُ غَيْرَهَا ؛ لِأَنَّهُ يَرَى مَا لَا صَبْرَ لَهُ ، فَيُدْنِيهِ اللهُ مِنْهَا ، فَيَسْتَظِلُّ بِظِلِّهَا ، وَيَشْرَبُ مِنْ مَائِهَا ، ثُمَّ تُرْفَعُ لَهُ شَجَرَةٌ أُخْرَى هِيَ أَحْسَنُ مِنْ تِلْكَ الشَّجَرَةِ ، فَيَقُولُ : أَيْ رَبِّ ، أَدْنِنِي مِنْ هَذِهِ الشَّجَرَةِ ، فَأَسْتَظِلَّ بِظِلِّهَا ، وَأَشْرَبَ مِنْ مَائِهَا ، فَيَقُولُ اللهُ : يَا ابْنَ آدَمَ أَلَمْ تُعَاهِدْنِي أَنْ لَا تَسْأَلَنِي غَيْرَهَا ؟ فَيَقُولُ : بَلَى ، أَيْ رَبِّ ، وَلَكِنْ هَذِهِ الشَّجَرَةَ ، لَا أَسْأَلُكَ غَيْرَهَا ، فَيُعَاهِدُهُ أَنْ لَا يَسْأَلَهُ ، وَرَبُّهُ يَعْلَمُ أَنَّهُ سَيَسْأَلُهُ غَيْرَهَا ، وَرَبُّهُ  يَعْذِرُهُ  ؛ لِأَنَّهُ يَرَى مَا لَا صَبْرَ لَهُ عَلَيْهِ ، فَيُدْنِيهِ اللهُ مِنْهَا ، فَيَسْتَظِلُّ بِظِلِّهَا ، وَيَشْرَبُ مِنْ مَائِهَا ، ثُمَّ تُرْفَعُ لَهُ  شَجَرَةٌ  عَلَى بَابِ الْجَنَّةِ هِيَ أَحْسَنُ مِنْ تِلْكَ  الشَّجَرَتَيْنِ  الْأُولَيَيْنِ ، فَيَقُولُ : أَيْ رَبِّ ، أَدْنِنِي مِنْ هَذِهِ الشَّجَرَةِ فَأَسْتَظِلَّ بِظِلِّهَا ،         [8/396]      وَأَشْرَبَ مِنْ مَائِهَا ، فَيَقُولُ اللهُ : يَا ابْنَ آدَمَ أَلَمْ تُعَاهِدْ أَنْ لَا تَسْأَلَنِي غَيْرَهَا ؟ فَيَقُولُ : أَيْ رَبِّ أَدْنِنِي مِنْ هَذِهِ الشَّجَرَةِ ، فَأَسْتَظِلَّ بِظِلِّهَا ، وَأَشْرَبَ مِنْ مَائِهَا ، فَيَقُولُ اللهُ لَهُ : لَعَلِّي إِنْ أَدْنَيْتُكَ مِنْهَا أَنْ تَسْأَلَنِي غَيْرَهَا ، فَيُعَاهِدُهُ أَنْ لَا يَسْأَلَهُ غَيْرَهَا ، وَرَبُّهُ يَعْلَمُ أَنَّهُ سَيَسْأَلُهُ غَيْرَهَا ، وَرَبُّهُ  يَعْذِرُهُ  ؛ لِأَنَّهُ يَرَى مَا لَا صَبْرَ لَهُ عَلَيْهِ ، فَيُدْنِيهِ مِنْهَا فَيَسْمَعُ أَصْوَاتَ أَهْلِ الْجَنَّةِ ، فَيَقُولُ : أَيْ رَبِّ أَدْخِلْنِي الْجَنَّةَ ، فَيَقُولُ اللهُ : أَيَسُرُّكَ أَنْ أُعْطِيَكَ الدُّنْيَا  وَمِثْلَهَا  مَعَهَا ؟ فَيَقُولُ : أَيْ رَبِّ ، أَتَسْتَهْزِئُ بِي وَأَنْتَ رَبُّ الْعَالَمِينَ ؟ قَالَ : إِنِّي لَا أَسْتَهْزِئُ بِكَ ، وَلَكِنِّي عَلَى مَا أَشَاءُ قَادِرٌ  .","","Musnad Abi Ya'la al-Mawsili 4980","","عبد الله بن مسعود عن أنس بن مالك عن ثابت البناني عن حماد بن سلمة عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4982","15 - (  4981  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ الْكِنْدِيُّ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لُعِنَ  آكِلُ  الرِّبَا  ، وَمُوكِلُهُ ، وَشَاهِدَاهُ وَكَاتِبُهُ .  وَقَالَ : مَا ظَهَرَ فِي قَوْمٍ الزِّنَا وَالرِّبَا ، إِلَّا أَحَلُّوا         [8/397]      بِأَنْفُسِهِمْ عِقَابَ اللهِ  .         [8/398]","","Musnad Abi Ya'la al-Mawsili 4981","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4983","16 - (  4982  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الْكَافِرَ  لَيُلْجِمُهُ  الْعَرَقُ يَوْمَ الْقِيَامَةِ  ، فَيَقُولُ : أَرِحْنِي وَلَوْ إِلَى النَّارِ  .         [8/399]","","Musnad Abi Ya'la al-Mawsili 4982","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4984","17 - (  4983  ) -  حَدَّثَنَا  أَحْمَدُ بْنُ حَاتِمٍ ،  حَدَّثَنَا  خَلَفٌ يَعْنِي ابْنَ خَلِيفَةَ ،  عَنْ  حُمَيْدٍ يَعْنِي الْأَعْرَجَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنِ  ابْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  كَلَّمَ اللهُ  مُوسَى  وَعَلَيْهِ جُبَّةٌ مِنْ صُوفٍ  ، وَكِسَاءٌ مِنْ صُوفٍ ، وَسَرَاوِيلُ مِنْ صُوفٍ ، وَكُمَّةُ صُوفٍ ، وَنَعْلَاهُ مِنْ جِلْدِ حِمَارٍ ، غَيْرِ ذَكِيٍّ  .","","Musnad Abi Ya'la al-Mawsili 4983","","عبد الله بن مسعود عن عبد الله بن الحارث النجراني عن حميد الأعرج الملائي عن خلف بن خليفة الأشجعي عن أحمد بن حاتم بن يزيد الحناط عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4985","18 - (  4984  ) -  حَدَّثَنَا  أَبُو مَعْمَرٍ إِسْمَاعِيلُ الْهُذَلِيُّ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،         [8/400]      عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّ  الْأَشْعَثَ بْنَ قَيْسٍ  ، اشْتَرَى رَقِيقًا مِنْ رَقِيقِ الْإِمَارَةِ ، فَاخْتَلَفَا فِي الثَّمَنِ  ، فَقَالَ  ابْنُ مَسْعُودٍ  : بِعْتُكَ بِعِشْرِينَ أَلْفًا ، وَقَالَ  الْأَشْعَثُ  : إِنَّمَا اشْتَرَيْتُ مِنْكَ بِعَشَرَةِ آلَافٍ ، فَقَالَ  عَبْدُ اللهِ  : إِنْ شِئْتَ حَدَّثْتُكَ حَدِيثًا سَمِعْتُهُ مِنْ رَسُولِ اللهِ ؟ قَالَ : هَاتِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا اخْتَلَفَ  الْبَيِّعَانِ  ، وَلَيْسَ بَيْنَهُمَا بَيِّنَةٌ ، فَالْقَوْلُ قَوْلُ الْبَائِعِ  ، أَوْ يَتَرَادَّانِ الْبَيْعَ قَالَ : فَإِنِّي أَرُدُّ الْبَيْعَ  .         [8/401]             [8/402]","","Musnad Abi Ya'la al-Mawsili 4984","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن إسماعيل بن إبراهيم المقعد عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4986","19 - (  4985  ) -  حَدَّثَنَا  الْمُعَلَّى بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  كُنْتُ غُلَامًا يَافِعًا فِي غَنَمٍ  لِعُقْبَةَ بْنِ أَبِي مُعَيْطٍ  أَرْعَاهَا ، فَأَتَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  مَعَهُ ، فَقَالَ :  يَا غُلَامُ ، هَلْ مَعَكَ مِنْ لَبَنٍ ؟  فَقُلْتُ : نَعَمْ ، وَلَكِنِّي مُؤْتَمَنٌ ، فَقَالَ : ائْتِنِي بِشَاةٍ لَمْ يَنْزُ عَلَيْهَا  الْفَحْلُ ،  فَأَتَيْتُهُ  بِعَنَاقٍ  أَوْ  جَذَعَةٍ  ،  فَاعْتَقَلَهَا  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ جَعَلَ يَمْسَحُ الضَّرْعَ ،         [8/403]      وَيَدْعُو حَتَّى أَنْزَلَتْ ، فَأَتَاهُ  أَبُو بَكْرٍ  بِصَخْرَةٍ ، فَاحْتَلَبَ فِيهَا ، ثُمَّ قَالَ  لِأَبِي بَكْرٍ  : اشْرَبْ ، فَشَرِبَ  أَبُو بَكْرٍ  ، ثُمَّ شَرِبَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَهُ ، ثُمَّ قَالَ لِلضَّرْعِ :  اقْلِصْ  ، فَقَلَصَ ، فَعَادَ كَمَا كَانَ قَالَ : ثُمَّ أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدُ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، عَلِّمْنِي  مِنْ هَذَا الْكَلَامِ ، أَوْ مِنْ هَذَا الْقُرْآنِ  ، فَمَسَحَ رَأْسِي ، وَقَالَ : إِنَّكَ غُلَامٌ  مُعَلَّمٌ  قَالَ :  فَلَقَدْ أَخَذْتُ مِنْ فِيهِ سَبْعِينَ سُورَةً مَا نَازَعَنِي فِيهَا بَشَرٌ  .         [8/404]","","Musnad Abi Ya'la al-Mawsili 4985","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4987","20 - (  4986  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  حَدَّثَنَا  خَلَفُ بْنُ خَلِيفَةَ ،  عَنْ  حُمَيْدٍ الْأَعْرَجِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  لَمَّا نَزَلَتْ :         {      مَنْ ذَا الَّذِي يُقْرِضُ اللهَ قَرْضًا حَسَنًا         }      ، قَالَ  أَبُو الدَّحْدَاحِ  : يَا رَسُولَ اللهِ ، إِنَّ اللهَ يُرِيدُ مِنَّا الْقَرْضَ ؟ قَالَ :  نَعَمْ ، يَا  أَبَا الدَّحْدَاحِ  قَالَ : أَرِنَا يَدَكَ قَالَ : فَنَاوَلَهُ يَدَهُ قَالَ : قَدْ أَقْرَضْتُ رَبِّي حَائِطِي  ، وَحَائِطُهُ فِيهِ سِتُّمِائَةِ نَخْلَةٍ ، فَجَاءَ يَمْشِي حَتَّى أَتَى الْحَائِطَ ،  وَأُمُّ الدَّحْدَاحِ  فِيهَا وَعِيَالُهَا ، فَنَادَى : يَا  أُمَّ الدَّحْدَاحِ  ، قَالَتْ : لَبَّيْكَ ، فَقَالَ : اخْرُجِي ، فَقَدْ أَقْرَضْتُهُ رَبِّي  .","","Musnad Abi Ya'la al-Mawsili 4986","","عبد الله بن مسعود عن عبد الله بن الحارث النجراني عن حميد الأعرج الملائي عن خلف بن خليفة الأشجعي عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4988","21 - (  4987  ) -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو حَفْصٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،         [8/405]      عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ  وِتْرٌ  ، يُحِبُّ  الْوِتْرِ  ،  فَأَوْتِرُوا  يَا أَهْلَ الْقُرْآنِ ، فَقَالَ  أَعْرَابِيٌّ  : مَا تَقُولُ يَا رَسُولَ اللهِ ؟ قَالَ : لَيْسَ لَكَ وَلَا لِأَصْحَابِكَ  .","","Musnad Abi Ya'la al-Mawsili 4987","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن الأعمش عن عمر بن عبد الرحمن بن قيس عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4989","22 - (  4988  ) -  حَدَّثَنَا  عُثْمَانُ ،  حَدَّثَنَا  أَبُو حَفْصٍ ،  عَنِ  الْأَعْمَشِ ، وَمَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  قِتَالُ الْمُؤْمِنِ  كُفْرٌ  ،  وَسِبَابُهُ  فُسُوقٌ  .         [8/406]","","Musnad Abi Ya'la al-Mawsili 4988","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن عمر بن عبد الرحمن بن قيس عن عثمان ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4990","23 - (  4989  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  ابْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنْ         [8/407]      إِبْرَاهِيمَ بْنِ سُوَيْدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذْنُكَ أَنْ تَرْفَعَ الْحِجَابَ  ، وَتَسْمَعَ  سِوَادِي  حَتَّى أَنْهَاكَ  قَالَ :  بَلَغَنِي أَنَّهَا  السِّرَارُ  .","","Musnad Abi Ya'la al-Mawsili 4989","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم بن سويد الصيرفي الأعور عن الحسن بن عبيد الله النخعي عن سفيان الثوري عن عبد الرحمن بن مهدي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4991","24 - (  4990  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبْدُ         [8/408]      اللهِ بْنُ الْمُبَارَكِ ،  عَنِ  التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  التَّلَقِّي  .","","Musnad Abi Ya'la al-Mawsili 4990","","عبد الله بن مسعود عن أبو عثمان النهدي عن سليمان بن طرخان عن عبد الله بن المبارك عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4992","25 - (  4991  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  مُعْتَمِرٌ ،  عَنْ  أَبِيهِ  ،  حَدَّثَنَا  أَبُو عَمْرٍو الشَّيْبَانِيُّ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سِبَابُ  الْمُسْلِمِ فُسُوقٌ  ، وَقِتَالُهُ  كُفْرٌ  .         [8/409]","","Musnad Abi Ya'la al-Mawsili 4991","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن سليمان بن طرخان عن معتمر بن سليمان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4993","26 - (  4992  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  عَاصِمُ بْنُ بَهْدَلَةَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَسَمَ غَنَائِمَ  حُنَيْنٍ  بِالْجِعِرَّانَةِ  ، فَازْدَحَمُوا عَلَيْهِ  ، فَقَالَ : إِنَّ عَبْدًا مِنْ  عَبِيدِ اللهِ  ، بَعَثَهُ اللهُ إِلَى قَوْمٍ فَكَذَّبُوهُ ، وَضَرَبُوهُ ،  وَشَجُّوهُ  ، قَالَ  عَبْدُ اللهِ  : كَأَنِّي أَنْظُرُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْرَ الرَّحْلِ ، وَقَالَ هَكَذَا : رَبِّ اغْفِرْ لِقَوْمِي ، فَإِنَّهُمْ لَا يَعْلَمُونَ  ،  وَجَعَلَ  أَبُو سَعِيدٍ الْقَوَارِيرِيُّ  إِصْبَعَهُ الْإِبْهَامَ عَلَى جَبِينِهِ ، كَأَنَّهُ  يَسْلُتُ  شَيْئًا  .","","Musnad Abi Ya'la al-Mawsili 4992","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4994","27 - (  4993  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  يَحْيَى ،         [8/410]      عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  حَدَّثَنَا  عَاصِمُ بْنُ بَهْدَلَةَ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  رَأَيْتُ  جِبْرِيلَ  عِنْدَ  السِّدْرَةِ  وَعَلَيْهِ سِتُّمِائَةِ جَنَاحٍ  ، يَنْتَثِرُ مِنْ رِيشِهِ  تَهَاوِيلُ  الدُّرِّ وَالْيَاقُوتِ  .         [8/411]","","Musnad Abi Ya'la al-Mawsili 4993","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن يحيى القطان عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4995","28 - (  4994  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  كَانَ يَقُولُ : اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الشَّيْطَانِ الرَّجِيمِ  : مِنْ  هَمْزِهِ  ،  وَنَفْخِهِ  ،  وَنَفْثِهِ  .  قَالَ :  فَهَمْزُهُ الْمَوْتَةُ ،  وَنَفْثُهُ  الشِّعْرُ ،  وَنَفْخُهُ  الْكِبْرُ  .         [8/412]             [8/413]","","Musnad Abi Ya'la al-Mawsili 4994","","عبد الله بن مسعود عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4996","29 - (  4995  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  فَضْلُ صَلَاةِ الرَّجُلِ فِي الْجَمَاعَةِ عَلَى صَلَاتِهِ وَحْدَهُ  بِضْعٌ  وَعِشْرُونَ دَرَجَةً  .         [8/414]","","Musnad Abi Ya'la al-Mawsili 4995","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4997","30 - (  4996  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عَبَّادُ بْنُ الْعَوَّامِ ،  عَنْ  هَارُونَ بْنِ عَنْتَرَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ ،  وَعَلْقَمَةَ ،  أَنَّهُمَا  قَالَا :         [8/415]      صَلَّيْنَا مَعَ ابْنِ مَسْعُودٍ فِي بَيْتِهِ ، أَحَدُنَا عَنْ يَمِينِهِ ، وَالْآخَرُ عَنْ يَسَارِهِ  ، وَقَالَ : هَكَذَا صَلَّيْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Musnad Abi Ya'la al-Mawsili 4996","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن هارون بن عنترة الشيباني عن عباد بن العوام الكلابي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4998","31 - (  4997  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  زَائِدَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،         [8/416]      عَنْ  عَبْدِ اللهِ قَالَ :  لَحِقَ بِالنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَبْدٌ أَسْوَدُ ، فَمَاتَ ، فَأُوذِنَ بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  انْظُرُوا هَلْ تَرَكَ شَيْئًا ؟ فَقَالُوا : دِينَارَيْنِ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : كَيَّتَانِ  .","","Musnad Abi Ya'la al-Mawsili 4997","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن زائدة بن قدامة عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"4999","32 - (  4998  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْمَسْعُودِيِّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا مَثَلِي وَمَثَلُ الدُّنْيَا كَمَثَلِ رَاكِبٍ قَالَ فِي ظِلِّ شَجَرَةٍ فِي يَوْمٍ حَارٍّ  ، ثُمَّ رَاحَ وَتَرَكَهَا  .         [8/417]","","Musnad Abi Ya'la al-Mawsili 4998","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5000","33 - (  4999  ) -  حَدَّثَنَا  هَنَّادُ بْنُ السَّرِيِّ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُرَّةَ الْهَمْدَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ لِلشَّيْطَانِ  لَمَّةً  ، وَلِلْمَلَكِ  لَمَّةً  ، فَأَمَّا  لَمَّةُ  الشَّيْطَانِ ، فَإِيعَادٌ بِالشَّرِّ ، وَتَكْذِيبٌ بِالْحَقِّ ، وَأَمَّا  لَمَّةُ  الْمَلَكِ ، فَإِيعَادٌ بِالْخَيْرِ ، وَتَصْدِيقٌ بِالْحَقِّ ، فَمَنْ وَجَدَ ذَلِكَ ، فَلْيَحْمَدِ اللهَ ، وَمَنْ وَجَدَ الْأُخْرَى ، فَلْيَتَعَوَّذْ مِنَ الشَّيْطَانِ ، ثُمَّ قَرَأَ         {      الشَّيْطَانُ يَعِدُكُمُ الْفَقْرَ         }      الْآيَةَ  .         [8/418]","","Musnad Abi Ya'la al-Mawsili 4999","","عبد الله بن مسعود عن مرة بن شراحيل عن عطاء بن السائب عن سلام بن سليم الحنفي عن هناد بن السري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5001","34 - (  5000  ) -  حَدَّثَنَا  هُدْبَةُ ،  حَدَّثَنَا  هَمَّامُ بْنُ يَحْيَى ،  حَدَّثَنَا  قَتَادَةُ ،  عَنْ  مُؤَرِّقٍ الْعِجْلِيِّ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَفْضُلُ صَلَاةُ الْجَمِيعِ عَلَى صَلَاةِ الرَّجُلِ وَحْدَهُ  بِضْعًا  وَعِشْرِينَ جُزْءًا  .","","Musnad Abi Ya'la al-Mawsili 5000","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن مورق العجلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5002","35 - (  5001  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ","","Musnad Abi Ya'la al-Mawsili 5001","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن عبد الله بن إدريس الأودي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5003","35 - (  5001  ) - ( م ) -  وَعَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي عُبَيْدَةَ ،         [8/419]      عَنْ  عَبْدِ اللهِ قَالَ :  بَيْنَمَا نَحْنُ فِي  مَسْجِدِ الْخَيْفِ  لَيْلَةَ عَرَفَةَ ، إِذْ سَمِعْنَا  حِسَّ  الْحَيَّةِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اقْتُلُوهَا ، فَدَخَلَتْ فِي شَقِّ جُحْرٍ ، فَأُتِيَ  بِسَعَفَةٍ  فَأَضْرَمَ  فِيهَا نَارٌ ، ثُمَّ إِنَّا قَلَعْنَا بَعْضَ الْجُحْرِ ، فَلَمْ نَجِدْهَا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  دَعُوهَا ، فَقَدْ وَقَاهَا اللهُ شَرَّكُمْ ، كَمَا وَقَاكُمْ شَرَّهَا  .","","Musnad Abi Ya'la al-Mawsili 5001","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن مجاهد بن جبر المخزومي عن ابن جريج عن عبد الله بن إدريس الأودي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5004","36 - (  5002  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنْ  مِسْعَرٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا شَكَّ أَحَدُكُمْ  فَلْيَتَحَرَّ  ، وَلْيَسْجُدْ سَجْدَتَيْنِ  .         [8/420]             [8/421]","","Musnad Abi Ya'la al-Mawsili 5002","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن مسعر بن كدام عن حفص بن غياث النخعي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5005","37 - (  5003  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  حَدَّثَنَا  زَكَرِيَّا ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَّمَنَا  سُنَنَ  الْهُدَى  فِي الصَّلَاةِ فِي الْمَسْجِدِ الَّذِي يُؤَذَّنُ فِيهِ  .         [8/422]","","Musnad Abi Ya'la al-Mawsili 5003","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عبد الملك بن عمير القبطي عن زكريا بن أبي زائدة الوادعي عن محمد بن بشر بن الفرافصة عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5006","38 - (  5004  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  سُلَيْمَانُ بْنُ عَتِيقٍ ،  عَنْ  طَلْقِ بْنِ حَبِيبٍ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا هَلَكَ  الْمُتَنَطِّعُونَ  ، أَلَا هَلَكَ  الْمُتَنَطِّعُونَ ،  أَلَا هَلَكَ  الْمُتَنَطِّعُونَ  .         [8/423]","","Musnad Abi Ya'la al-Mawsili 5004","","عبد الله بن مسعود عن الأحنف بن قيس السعدي عن طلق بن حبيب العنزي عن سليمان بن عتيق المحاربي عن ابن جريج عن يحيى القطان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5007","39 - (  5005  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبِيدَةَ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا نَامَ قَالَ : اللَّهُمَّ قِنِي عَذَابَكَ يَوْمَ تَجْمَعُ عِبَادَكَ  ، وَكَانَ يَجْعَلُ يَدَهُ تَحْتَ خَدِّهِ  .","","Musnad Abi Ya'la al-Mawsili 5005","","عبد الله بن مسعود عن عبيدة بن عمرو السلماني عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5008","40 - (  5006  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ  ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ :  كَانُوا يَقْرَءُونَ خَلْفَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الصَّلَاةِ ، فَقَالَ :  خَلَطْتُمْ عَلَيَّ الْقُرْآنَ  .         [8/424]","","Musnad Abi Ya'la al-Mawsili 5006","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن محمد بن عبد الله بن الزبير عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5009","41 - (  5007  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  حَفْصٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  سُلَيْمَانَ بْنِ عَتِيقٍ ،  عَنْ  طَلْقِ بْنِ حَبِيبٍ ،  عَنِ  الْأَحْنَفِ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا هَلَكَ  الْمُتَنَطِّعُونَ  ثَلَاثًا  .","","Musnad Abi Ya'la al-Mawsili 5007","","عبد الله بن مسعود عن الأحنف بن قيس السعدي عن طلق بن حبيب العنزي عن سليمان بن عتيق المحاربي عن ابن جريج عن حفص بن غياث النخعي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5010","42 - (  5008  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنِ         [8/425]      الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ  قَالَ  :  كُنَّا عِنْدَ عَبْدِ اللهِ ، وَمَعَنَا  زِيَادُ بْنُ حُدَيْرٍ  ، فَدَخَلَ عَلَيْنَا  خَبَّابٌ  ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، أَكُلُّ هَؤُلَاءِ يَقْرَأُ كَمَا تَقْرَأُ ؟ قَالَ : إِنْ شِئْتَ أَمَرْتُ بَعْضَهُمْ أَنْ يَقْرَأَ عَلَيْكَ ، فَقَالَ لِي : اقْرَأْ قَالَ : فَقَالَ لَهُ  ابْنُ حُدَيْرٍ  : تَأْمُرُهُ يَقْرَأُ وَلَيْسَ بِأَقْرَئِنَا ؟ قَالَ : إِنْ شِئْتَ أَخْبَرْتُكَ بِمَا قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِقَوْمِكَ وَقَوْمِهِ ، فَقَرَأْتُ عَلَيْهِ خَمْسِينَ آيَةً مِنْ "" مَرْيَمَ "" فَقَالَ  خَبَّابٌ  : حَسْبُكَ  .","","Musnad Abi Ya'la al-Mawsili 5008","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن يعلى بن عبيد الطنافسي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5011","43 - (  5009  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  أَخْبَرَنِي  أَبُو إِسْحَاقَ الشَّيْبَانِيُّ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَدُورُ رَحَى         [8/426]      الْإِسْلَامِ عَلَى رَأْسِ  خَمْسٍ وَثَلَاثِينَ ، أَوْ سِتٍّ وَثَلَاثِينَ ، أَوْ سَبْعٍ وَثَلَاثِينَ  ، فَإِنْ هَلَكُوا ، فَسَبِيلُ مَنْ هَلَكَ ، وَإِنْ بَقُوا ، بَقِيَ لَهُمْ دِينُهُمْ سَبْعِينَ عَامًا  .","","Musnad Abi Ya'la al-Mawsili 5009","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن سليمان بن فيروز الشيباني عن العوام بن حوشب عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5012","44 - (  5010  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  سِمَاكٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ قَالَ :  سَرَيْنَا ذَاتَ لَيْلَةٍ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْنَا : يَا رَسُولَ اللهِ ، لَوْ مَسِسْنَا الْأَرْضَ فَنِمْنَا ، وَرَعَتْ رِكَابُنَا ؟ قَالَ :  فَمَنْ يَحْرُسُنَا ؟ قَالَ : فَقُلْتُ : أَنَا ، قَالَ : فَغَلَبَتْنِي عَيْنِي  ، فَلَمْ يُوقِظْنَا إِلَّا وَقَدْ طَلَعَتِ الشَّمْسُ ، وَلَمْ يَسْتَيْقِظْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا بِكَلَامِنَا قَالَ : فَأَمَرَ  بِلَالًا  ، فَأَذَّنَ ، ثُمَّ قَامَ ، فَصَلَّى بِنَا  .         [8/427]","","Musnad Abi Ya'la al-Mawsili 5010","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن سماك بن حرب البكري عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5013","45 - (  5011  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  حَدَّثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ         [8/428]      كَيْسَانَ ،  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ شَدَّادِ بْنِ الْهَادِ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا إِنَّ أَوْلَى النَّاسِ بِي يَوْمَ الْقِيَامَةِ أَكْثَرُهُمْ عَلَيَّ صَلَاةً  .         [8/429]","","Musnad Abi Ya'la al-Mawsili 5011","","عبد الله بن مسعود عن شداد بن الهاد الليثي عن عبد الله بن شداد بن الهاد الليثي عن عبد الله بن كيسان مولى طلحة بن عبد الله بن عوف عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن خالد بن مخلد القطواني عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5014","46 - (  5012  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  شَرِيكٍ ،  عَنْ  عُثْمَانَ بْنِ أَبِي زُرْعَةَ ،  عَنْ  أَبِي صَادِقٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِلْجَنَّةِ ثَمَانِيَةُ أَبْوَابٍ  : سَبْعَةٌ مُغْلَقَةٌ ، وَبَابٌ مَفْتُوحٌ لِلتَّوْبَةِ حَتَّى تَطْلُعَ الشَّمْسُ مِنْ نَحْوِهِ  .         [8/430]","","Musnad Abi Ya'la al-Mawsili 5012","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو صادق الأزدي عن عثمان بن المغيرة الأعشى عن شريك بن عبد الله النخعي عن معاوية بن هشام القصار عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5015","47 - (  5013  ) -  حَدَّثَنَا  أَبُو عَبْدِ اللهِ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  الْمُعْتَمِرُ ،  حَدَّثَنَا  عَبَّادُ بْنُ عَبَّادِ بْنِ عَلْقَمَةَ ،  عَنْ  أَبِي مِجْلَزٍ ،  أَنَّ  أَصْحَابَ ابْنِ مَسْعُودٍ قَرَصَهُمُ الْبَرْدُ ، فَجَعَلُوا يَسْتَحْيُونَ أَنْ يَجِيئُوا فِي الْعَشَاشِ  ،  وَالْعَبَاءِ  ، فَفَقَدَهُمْ ، فَقِيلَ لَهُ : أَمْرُهُمْ كَذَا وَكَذَا ، فَأَصْبَحَ  أَبُو عَبْدِ الرَّحْمَنِ  فِي عَبَاءَةٍ ، فَقَالُوا : أَصْبَحَ ابْنُ مَسْعُودٍ فِي عَبَاءَتِهِ ، ثُمَّ جَاءَ يَوْمُ الثَّانِي ، ثُمَّ جَاءَ يَوْمُ الثَّالِثِ ، فَلَمَّا رَأَوْهُ فِي الْعَبَاءَةِ ، جَاءُوا فِي أَكْسِيَتِهِمْ مَعًا ، فَعَرَفَ وُجُوهًا قَدْ كَانَ فَقَدَهَا ، فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَدْخُلُ الْجَنَّةَ أَحَدٌ فِي قَلْبِهِ  مِثْقَالُ  خَرْدَلَةٍ مِنْ  كِبْرٍ  ، أَوْ قَالَ : ذَرَّةٍ مِنْ  كِبْرٍ  .         [8/431]","","Musnad Abi Ya'la al-Mawsili 5013","","عبد الله بن مسعود عن لاحق بن حميد عن عباد بن عباد بن علقمة المازني عن معتمر بن سليمان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5016","48 - (  5014  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  إِبْرَاهِيمَ بْنِ سُوَيْدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَمْسَى قَالَ : أَمْسَيْنَا ، وَأَمْسَى الْمُلْكُ لِلهِ  ، وَالْحَمْدُ لِلهِ ، لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ خَيْرِ هَذِهِ اللَّيْلَةِ ، وَخَيْرِ مَا فِيهَا ،         [8/432]      وَأَعُوذُ بِكَ مِنْ شَرِّهَا ، وَشَرِّ مَا فِيهَا ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْكَسَلِ ،  وَالْهَرَمِ  ، وَسُوءِ  الْكِبَرِ ،  وَفِتْنَةِ الدُّنْيَا ، وَعَذَابِ الْقَبْرِ  .","","Musnad Abi Ya'la al-Mawsili 5014","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم بن سويد الصيرفي الأعور عن الحسن بن عبيد الله النخعي عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5017","49 - (  5015  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  الْمَسْعُودِيُّ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ  :  أَنَّ رَجُلَيْنِ كَانَا يَعْبُدَانِ اللهَ فَسَأَلَا اللهَ أَنْ يُمِيتَهُمَا جَمِيعًا ؛ فَمَاتَا جَمِيعًا فَدُفِنَا  . قَالَ  عَبْدُ اللهِ  : فَلَوْ كُنْتُ ثَمَّ لَأَرَيْتُكُمْ قُبُورَهُمَا بِالنَّعْتِ الَّذِي نَعَتَ لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .         [8/433]","","Musnad Abi Ya'la al-Mawsili 5015","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن يزيد بن هارون عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5018","50 - (  5016  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عَبْدُ السَّلَامِ ،  عَنْ  خُصَيْفٍ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  فِي ثَلَاثِينَ مِنَ الْبَقَرِ  تَبِيعٌ  أَوْ  تَبِيعَةٌ  ، وَفِي أَرْبَعِينَ  مُسِنَّةٌ  .         [8/434]","","Musnad Abi Ya'la al-Mawsili 5016","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن خصيف الجزري عن عبد السلام بن حرب الملائي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5019","51 - (  5017  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  عَنْ  عَلِيِّ بْنِ صَالِحٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي ، فَإِذَا سَجَدَ وَثَبَ  الْحَسَنُ  ،  وَالْحُسَيْنُ  ، عَلَى ظَهْرِهِ ، فَإِذَا أَرَادُوا أَنْ يَمْنَعُوهُمَا ، أَشَارَ إِلَيْهِمْ أَنْ دَعُوهُمَا ، فَإِذَا قَضَى الصَّلَاةَ ، وَضَعَهُمَا فِي حِجْرِهِ قَالَ :  مَنْ أَحَبَّنِي فَلْيُحِبَّ هَذَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5017","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن علي بن صالح بن حي عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5020","52 - (  5018  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، فِي قَوْلِهِ :         {      مَا كَذَبَ الْفُؤَادُ مَا رَأَى         }      قَالَ :  رَأَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  جِبْرِيلَ  فِي حُلَّتَيْ  رَفْرَفٍ  ، قَدْ سَدَّ مَا         [8/435]      بَيْنَ السَّمَاءِ وَالْأَرْضِ  .","","Musnad Abi Ya'la al-Mawsili 5018","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5021","53 - (  5019  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  مِسْعَرٌ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  إِبْرَاهِيمَ قَالَ :  قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِعَبْدِ اللهِ : اقْرَأْ عَلَيَّ قَالَ : أَقْرَأُ عَلَيْكَ ، وَعَلَيْكَ أُنْزِلَ ؟ قَالَ :  إِنِّي أُحِبُّ أَنْ أَسْمَعَهُ مِنْ غَيْرِي  قَالَ : فَقَرَأَ عَلَيْهِ مِنْ أَوَّلِ سُورَةِ النِّسَاءِ إِلَى قَوْلِهِ :         {      فَكَيْفَ إِذَا جِئْنَا مِنْ كُلِّ أُمَّةٍ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَى هَؤُلاءِ شَهِيدًا         }      ، فَبَكَى  .","","Musnad Abi Ya'la al-Mawsili 5019","","","مسند عبد الله بن مسعود"
"5022","[8/436]      54 - (  5020  ) -  قَالَ  مِسْعَرٌ :  حَدَّثَنِي  مَعْنٌ ،  عَنْ  جَعْفَرِ بْنِ عَمْرِو بْنِ أُمَيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  شَهِيدًا عَلَيْهِمْ  مَا دُمْتُ فِيهِمْ ، أَوْ قَالَ : مَا كُنْتُ فِيهِمْ  ؛  شَكَّ  مِسْعَرٌ  .         [8/437]","","Musnad Abi Ya'la al-Mawsili 5020","","عبد الله بن مسعود عن عمرو بن أمية بن خويلد الضمري عن جعفر بن عمرو بن أمية الضمري عن معن بن عبد الرحمن المسعودي عن مسعر بن كدام عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5023","55 - (  5021  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  يَحْيَى بْنُ آدَمَ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ :  رَبِّ قِنِي عَذَابَكَ ، يَوْمَ تَبْعَثُ عِبَادَكَ  .","","Musnad Abi Ya'la al-Mawsili 5021","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن يحيى بن آدم عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5024","56 - (  5022  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  مِسْعَرٍ قَالَ :  أَخْرَجَ إِلَيَّ  مَعْنُ بْنُ عَبْدِ الرَّحْمَنِ  كِتَابًا ، وَحَلَفَ عَلَيْهِ أَنَّهُ خَطُّ  أَبِيهِ  ، فَإِذَا فِيهِ ،  قَالَ  عَبْدُ اللهِ :  وَالَّذِي لَا إِلَهَ غَيْرُهُ ، مَا رَأَيْتُ أَحَدًا كَانَ أَشَدَّ عَلَى  الْمُتَنَطِّعِينَ  مِنْ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَلَا رَأَيْتُ أَحَدًا أَشَدَّ عَلَيْهِمْ بَعْدَهُ مِنْ  أَبِي بَكْرٍ  ، وَإِنِّي لَأَظُنُّ  عُمَرَ  كَانَ أَشَدَّ أَهْلِ الْأَرْضِ خَوْفًا  عَلَيْهِمْ ، أَوْ لَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 5022","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن معن بن عبد الرحمن المسعودي عن مسعر بن كدام عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5025","57 - (  5023  ) -  حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  حَدَّثَنَا  زَكَرِيَّا ،  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ ،         [8/438]      عَنْ  أَبِي الْأَحْوَصِ قَالَ :  قَالَ  عَبْدُ اللهِ :  لَقَدْ رَأَيْتُنَا وَمَا يَتَخَلَّفُ عَنِ الصَّلَاةِ إِلَّا مُنَافِقٌ قَدْ عُلِمَ نِفَاقُهُ  ، أَوْ مَرِيضٌ ، إِنْ كَانَ الْمَرِيضُ لَيَمْشِي بَيْنَ رَجُلَيْنِ حَتَّى يَأْتِيَ الصَّلَاةَ ، وَقَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَّمَنَا  سُنَنَ  الْهُدَى ، وَمِنْ  سُنَنِ  الْهُدَى ، الصَّلَاةُ فِي الْمَسْجِدِ الَّذِي يُؤَذَّنُ فِيهِ  .","","Musnad Abi Ya'la al-Mawsili 5023","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عبد الملك بن عمير القبطي عن زكريا بن أبي زائدة الوادعي عن محمد بن بشر بن الفرافصة عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5026","58 - (  5024  ) -  حَدَّثَنَا  مُصْعَبُ بْنُ عَبْدِ اللهِ الزُّبَيْرِيُّ ،  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  أَنَّ  ابْنَ مَسْعُودٍ قَالَ :  بَيْنَمَا نَحْنُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي قَرِيبٍ مِنْ ثَلَاثِينَ رَجُلًا لَيْسَ فِيهِمْ إِلَّا قُرَشِيٌّ ، لَا وَاللهِ ، مَا رَأَيْتُ صَفْحَةَ وُجُوهِ رِجَالٍ قَطُّ أَحْسَنَ مِنْ وُجُوهِهِمْ يَوْمَئِذٍ . قَالَ : فَذَكَرُوا النِّسَاءَ ، فَتَحَدَّثُوا فِيهِنَّ ، وَتَحَدَّثَ مَعَهُمْ ، حَتَّى أَحْبَبْتُ أَنْ يَسْكُتَ ، ثُمَّ أَتَيْتُهُ ، فَتَشَهَّدَ ، ثُمَّ قَالَ :  أَمَّا بَعْدُ يَا مَعْشَرَ  قُرَيْشٍ  ، فَإِنَّكُمْ أَهْلُ هَذَا الْأَمْرِ مَا أَطَعْتُمُ اللهَ  ، فَإِذَا عَصَيْتُمُوهُ بَعَثَ عَلَيْكُمْ مَنْ يَلْحَاكُمْ كَمَا يُلْحَى هَذَا الْقَضِيبُ         [8/439]      -  لِقَضِيبٍ فِي يَدِهِ  - ثُمَّ لَحَى قَضِيبَهُ ، فَإِذَا هُوَ أَبْيَضُ  يَصْلِدُ  .","","Musnad Abi Ya'la al-Mawsili 5024","","عبد الله بن مسعود عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن مصعب بن عبد الله بن مصعب الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5027","59 - (  5025  ) -  حَدَّثَنَا  صَالِحُ بْنُ حَرْبٍ أَبُو مَعْمَرٍ ،  حَدَّثَنَا  سَلَّامُ بْنُ أَبِي خُبْزَةَ ،  حَدَّثَنَا  عَاصِمُ بْنُ أَبِي النَّجُودِ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنِ اتَّخَذَ كَلْبًا لَيْسَ بِكَلْبِ مَاشِيَةٍ  ، أَوْ كَلْبِ صَيْدٍ ، انْتُقِصَ مِنْ أَجْرِهِ كُلَّ يَوْمٍ قِيرَاطَانِ  .         [8/440]","","Musnad Abi Ya'la al-Mawsili 5025","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سلام بن أبي خبزة البصري عن صالح بن حرب بن خالد الهاشمي مولاهم عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5028","60 - (  5026  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  سُلَيْمَانُ أَبُو دَاوُدَ ،  حَدَّثَنَا  يَزِيدُ بْنُ عَطَاءٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  كَانَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِمَارٌ يُقَالُ لَهُ :  عُفَيْرٌ  .","","Musnad Abi Ya'la al-Mawsili 5026","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن يزيد بن عطاء بن يزيد اليشكري عن أبو داود الطيالسي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5029","61 - (  5027  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  أَبَانُ بْنُ تَغْلِبَ ،  عَنْ  أَبِي إِسْحَاقَ ،         [8/441]      عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ  ، إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ  .","","Musnad Abi Ya'la al-Mawsili 5027","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن أبان بن تغلب بن رياح عن حماد بن زيد عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5030","62 - (  5028  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  الْمُثَنَّى بْنُ بَكْرٍ ،  حَدَّثَنَا  عَوْفٌ ،  حَدَّثَنَا  سُلَيْمَانُ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَعَلَّمُوا الْقُرْآنَ ، وَتَعَلَّمُوا الْعِلْمَ وَعَلِّمُوهُ النَّاسَ  ، وَتَعَلَّمُوا الْفَرَائِضَ وَعَلِّمُوهَا النَّاسَ ، فَإِنِّي امْرُؤٌ مَقْبُوضٌ ، وَإِنَّ الْعِلْمَ سَيُقْبَضُ ، حَتَّى يَخْتَلِفَ الرَّجُلَانِ فِي الْفَرِيضَةِ لَا يَجِدَانِ مَنْ يُخْبِرُهُمَا  .         [8/442]","","Musnad Abi Ya'la al-Mawsili 5028","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن سليمان بن جابر الهجري عن عوف بن أبي جميلة عن المثنى بن بكر العبدي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5031","63 - (  5029  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  يُوسُفُ بْنُ يَزِيدَ يَعْنِي أَبَا مَعْشَرٍ ،  حَدَّثَنَا  أَبُو حَمْزَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  قَنَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَهْرًا يَدْعُو عَلَى  عُصَيَّةَ  وَذَكْوَانَ  ، فَلَمَّا ظَهَرَ عَلَيْهِمْ تَرَكَ  الْقُنُوتَ  .         [8/443]","","Musnad Abi Ya'la al-Mawsili 5029","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن ميمون القصاب عن يوسف بن يزيد البراء عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5032","64 - (  5030  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  عُمَرُ بْنُ عَلِيٍّ ،  عَنْ  سُلَيْمَانَ بْنِ يَسِيرٍ ،  عَنْ  قَيْسٍ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَقْرَضَ رَجُلًا مُسْلِمًا دِرْهَمًا مَرَّتَيْنِ ، كَانَ لَهُ كَأَجْرِ صَدَقَتِهِمَا مَرَّةً  .         [8/444]","","Musnad Abi Ya'la al-Mawsili 5030","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن قيس بن رومي عن سليمان بن يسير النخعي عن عمر بن علي بن عطاء عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5033","65 - (  5031  ) -  حَدَّثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  حَدَّثَنَا  حَمَّادٌ يَعْنِي ابْنَ زَيْدٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ  قَالَ  :  كُنَّا جُلُوسًا عِنْدَ عَبْدِ اللهِ بَعْدَ الْمَغْرِبِ وَهُوَ يُقْرِئُنَا الْقُرْآنَ ، فَسَأَلَهُ رَجُلٌ ، يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، هَلْ سَأَلْتُمْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَمْ يَمْلِكُ هَذِهِ الْأُمَّةَ  خَلِيفَةٌ  ؟ فَقَالَ  ابْنُ مَسْعُودٍ  : مَا سَأَلَنِي عَنْهَا أَحَدٌ مُنْذُ قَدِمْتُ  الْعِرَاقَ  قَبْلَكَ قَالَ : نَعَمْ ، فَسَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  اثْنَا عَشَرَ ، مِثْلَ  نُقَبَاءِ بَنِي إِسْرَائِيلَ  .         [8/445]","","Musnad Abi Ya'la al-Mawsili 5031","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5034","66 - (  5032  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مَالِكِ بْنِ الْحَارِثِ ،  عَنْ  أَبِي وَائِلٍ قَالَ :  كُنَّا جُلُوسًا نَنْتَظِرُ ابْنَ مَسْعُودٍ أَنْ يَخْرُجَ إِلَيْنَا ، إِذْ أَتَانَا  يَزِيدُ بْنُ مُعَاوِيَةَ  ، فَقُلْنَا : اجْلِسْ ، فَقَالَ : حَتَّى أَدْخُلَ عَلَى صَاحِبِكُمْ ، فَإِنْ خَرَجَ وَإِلَّا رَجَعْتُ إِلَيْكُمْ . قَالَ : فَدَخَلَ عَلَيْهِ ، فَخَرَجَا جَمِيعًا ، فَقَالَ  ابْنُ مَسْعُودٍ  : إِنِّي لَأُخْبَرُ  بِمَجْلِسِكُمْ - أَوْ بِمَكَانِكُمْ  - فَمَا يَمْنَعُنِي أَنْ أَخْرُجَ إِلَيْكُمْ إِلَّا كَرَاهَةَ أَنْ أُمِلَّكُمْ ،  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ  يَتَخَوَّلُنَا  بِالْمَوْعِظَةِ فِي الْأَيَّامِ ، مَخَافَةَ السَّآمَةِ عَلَيْنَا  .         [8/446]","","Musnad Abi Ya'la al-Mawsili 5032","","عبد الله بن مسعود عن شقيق بن سلمة عن مالك بن الحارث السلمي عن الأعمش عن الوضاح بن عبد الله اليشكري عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5035","67 - (  5033  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  عِكْرِمَةُ يَعْنِي الْأَزْدِيَّ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  شَقِيقٍ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْمُهَاجِرُونَ  ،  وَالْأَنْصَارُ  ،  وَالطُّلَقَاءُ  مِنْ قُرَيْشٍ  ،  وَالْعُتَقَاءُ مِنْ ثَقِيفَ  ، بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ فِي الدُّنْيَا وَالْآخِرَةِ  .         [8/447]","","Musnad Abi Ya'la al-Mawsili 5033","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن عكرمة بن إبراهيم الباهلى عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5036","68 - (  5034  ) -  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  ابْنُ أَبِي غَنِيَّةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ :  أَنَّهُ سُئِلَ أَكَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ قَائِمًا ؟ قَالَ : فَقَالَ : نَعَمْ ، ثُمَّ قَرَأَ :         {      وَتَرَكُوكَ قَائِمًا         }      .         [8/448]","","Musnad Abi Ya'la al-Mawsili 5034","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن يحيى بن عبد الملك بن حميد عن أبو بكر ابن أبي شيبة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5037","69 - (  5035  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْكُوفِيُّ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَبْدِ اللهِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  سَالِمٍ الْأَفْطَسِ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الرَّجُلَ مِنْ  بَنِي إِسْرَائِيلَ  كَانَ إِذَا رَأَى أَخَاهُ عَلَى ذَنْبٍ ، نَهَاهُ  تَعْذِيرًا  ، فَإِذَا كَانَ مِنَ الْغَدِ ، لَمْ يَمْنَعْهُ مَا رَأَى مِنْهُ أَنْ يَكُونَ  أَكِيلَهُ  ، وَخَلِيطَهُ ، وَشَرِيبَهُ ، فَلَمَّا رَأَى اللهُ ذَلِكَ مِنْهُمْ ، ضَرَبَ بِقُلُوبِ بَعْضِهِمْ عَلَى بَعْضٍ ، وَلَعَنَهُمْ عَلَى لِسَانِ نَبِيِّهِمْ  دَاوُدَ  ،  وَعِيسَى ابْنِ مَرْيَمَ  ،         {      ذَلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ         }      .  ثُمَّ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : وَالَّذِي نَفْسِي بِيَدِهِ ، لَتَأْمُرُنَّ بِالْمَعْرُوفِ ، وَلَتَنْهَوُنَّ عَنِ الْمُنْكَرِ ، وَلَتَأْخُذُنَّ عَلَى يَدَيِ الْمُسِيءِ ، وَلَتَأْطُرُنَّهُ عَلَى الْحَقِّ  أَطْرًا  ، أَوْ لَيَضْرِبَنَّ اللهُ بِقُلُوبِ بَعْضِكُمْ عَلَى         [8/449]      بَعْضٍ ، وَلَيَلْعَنَنَّكُمْ كَمَا لَعَنَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 5035","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن سالم بن عجلان الأفطس عن عمرو بن مرة المرادي عن عبد الله بن عمرو بن مرة الجملي عن علاء بن المسيب عن عبد الرحمن بن محمد المحاربي عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5038","70 - (  5036  ) -  حَدَّثَنَا  هُدْبَةُ بْنُ خَالِدٍ ، وَشَيْبَانُ بْنُ فَرُّوخَ ، قَالَا :  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،         [8/450]      عَنْ  عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أُتِيتُ بِالْبُرَاقِ ، فَرَكِبْتُهُ خَلْفَ  جَبْرَائِيلَ  ، فَسَارَ بِنَا ، فَكَانَ إِذَا أَتَى عَلَى جَبَلٍ ارْتَفَعَتْ رِجْلَاهُ ، وَإِذَا هَبَطَ ارْتَفَعَتْ يَدَاهُ  ، فَسَارَ بِنَا فِي أَرْضٍ  غُمَّةٍ  مُنْتِنَةٍ ، وَأَفْضَيْنَا إِلَى أَرْضٍ فَيْحَاءَ طَيِّبَةٍ ، فَقُلْتُ : يَا  جِبْرِيلُ  إِنَّا كُنَّا نَسِيرُ فِي أَرْضٍ  غُمَّةٍ  مُنْتِنَةٍ ، وَإِنَّا أَفْضَيْنَا إِلَى أَرْضٍ فَيْحَاءَ طَيِّبَةٍ ، فَقَالَ : تِلْكَ أَرْضُ النَّارِ ، وَهَذِهِ أَرْضُ الْجَنَّةِ .  فَأَتَيْنَا عَلَى رَجُلٍ وَهُوَ قَائِمٌ يُصَلِّي قَالَ : فَقَالَ : مَنْ هَذَا مَعَكَ يَا  جِبْرِيلُ  ؟ قَالَ : هَذَا أَخُوكَ  مُحَمَّدٌ  ، فَرَحَّبَ ، وَدَعَا لِي بِالْبَرَكَةِ قَالَ : سَلْ لِأُمَّتِكَ الْيُسْرَ .  قَالَ : قُلْتُ : مَنْ هَذَا يَا  جِبْرِيلُ  ؟ قَالَ : هَذَا أَخُوكَ  عِيسَى  .  قَالَ : ثُمَّ سَارَ ، فَأَتَيْنَا عَلَى رَجُلٍ ، فَقَالَ : مَنْ مَعَكَ يَا  جِبْرِيلُ  ؟ قَالَ : هَذَا أَخُوكَ  مُحَمَّدٌ  قَالَ : فَرَحَّبَ بِي ، وَدَعَا لِي بِالْبَرَكَةِ قَالَ : سَلْ لِأُمَّتِكَ الْيُسْرَ .  قَالَ : قُلْتُ : مَنْ هَذَا يَا  جِبْرِيلُ  ؟ قَالَ : هَذَا أَخُوكَ  مُوسَى  .         [8/451]      قَالَ : ثُمَّ سِرْنَا ، فَرَأَيْنَا مَصَابِيحَ وَضَوْءًا ، فَقُلْتُ : مَا هَذَا يَا  جِبْرِيلُ  ؟ فَقَالَ : هَذِهِ شَجَرَةُ أَبِيكَ  إِبْرَاهِيمَ  ، أَتَدْنُو مِنْهَا ؟ قَالَ : فَقُلْتُ : نَعَمْ ، فَدَنَوْنَا مِنْهَا ، فَرَحَّبَ ، وَدَعَا لِي بِالْبَرَكَةِ ، ثُمَّ مَضَيْنَا ، حَتَّى أَتَيْنَا  بَيْتَ الْمَقْدِسِ  ، وَنُشِرَ لِيَ الْأَنْبِيَاءُ ، مَنْ سَمَّى اللهُ ، وَمَنْ لَمْ يُسَمِّ ، وَصَلَّيْتُ بِهِمْ ، إِلَّا هَؤُلَاءِ النَّفَرَ الثَّلَاثَةَ :  مُوسَى  ،  وَعِيسَى  ،  وَإِبْرَاهِيمَ  .","","Musnad Abi Ya'la al-Mawsili 5036","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن ميمون القصاب عن حماد بن سلمة عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5039","71 - (  5037  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  عَاصِمُ بْنُ بَهْدَلَةَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ قَالَ :  تُوُفِّيَ رَجُلٌ مِنْ  أَصْحَابِ الصُّفَّةِ  ،         [8/452]      فَوَجَدُوا فِي شَمْلَتِهِ دِينَارَيْنِ ، فَذُكِرَ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  كَيَّتَانِ  .","","Musnad Abi Ya'la al-Mawsili 5037","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن حماد بن زيد عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5040","72 - (  5038  ) -  حَدَّثَنَا  نُعَيْمُ بْنُ هَيْصَمٍ ،  حَدَّثَنَا  خَالِدٌ يَعْنِي الْوَاسِطِيَّ ،  عَنْ  يَحْيَى الْجَبَّارِ ،  عَنْ  أَبِي مَاجِدَةَ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ :  سَأَلْنَا نَبِيَّنَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ السَّيْرِ بِالْجِنَازَةِ ، فَقَالَ :  مَا دُونَ  الْخَبَبِ ،  فَإِنْ يَكُ خَيْرًا يُعَجَّلْ بِهِ ، وَإِنْ يَكُ سِوَى ذَلِكَ فَبُعْدًا لِأَهْلِ النَّارِ  ، الْجِنَازَةُ مَتْبُوعَةٌ ، وَلَيْسَتْ بِمُتَّبِعَةٍ ، لَيْسَ مِنْهَا مَنْ تَقَدَّمَهَا  .         [8/453]","","Musnad Abi Ya'la al-Mawsili 5038","","عبد الله بن مسعود عن عائذ بن نضلة الحنفي عن يحيى بن عبد الله بن الحارث الجابر عن خالد بن عبد الله الطحان عن نعيم بن الهيضم الخراساني عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5041","73 - (  5039  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبِي بَكْرٍ  ،  وَعُمَرَ  ، فَلَمْ يَرْفَعُوا أَيْدِيَهُمْ إِلَّا عِنْدَ افْتِتَاحِ الصَّلَاةِ  ،  وَقَدْ قَالَ  مُحَمَّدٌ  :  فَلَمْ يَرْفَعُوا أَيْدِيَهُمْ بَعْدَ التَّكْبِيرَةِ الْأُولَى  .","","Musnad Abi Ya'la al-Mawsili 5039","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5042","74 - (  5040  ) -  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،         [8/454]      عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  عَلْقَمَةَ قَالَ :  قَالَ  ابْنُ مَسْعُودٍ :  أَلَا أُصَلِّي بِكُمْ صَلَاةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ :  فَصَلَّى بِهِمْ ، فَلَمْ يَرْفَعْ يَدَهُ إِلَّا مَرَّةً  .         [8/455]","","Musnad Abi Ya'la al-Mawsili 5040","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن عبد الرحمن بن الأسود النخعي عن عاصم بن كليب الجرمي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5043","75 - (  5041  ) -  حَدَّثَنَا  سُرَيْجُ بْنُ يُونُسَ ،  حَدَّثَنَا  هُشَيْمٌ ،  عَنِ  الْحَجَّاجِ بْنِ أَبِي زَيْنَبَ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  كُنْتُ أُصَلِّي وَقَدْ وَضَعْتُ يَدِي الْيُسْرَى عَلَى الْيُمْنَى ، فَجَاءَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخَذَ بِيَدِي الْيُمْنَى فَوَضَعَهَا عَلَى الْيُسْرَى  .         [8/456]","","Musnad Abi Ya'la al-Mawsili 5041","","عبد الله بن مسعود عن أبو عثمان النهدي عن حجاج  بن أبي زينب الصيقل عن هشيم بن بشير عن سريج بن يونس المروزي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5044","76 - (  5042  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الرُّكَيْنِ بْنِ الرَّبِيعِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ،  يَرْفَعُهُ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الرِّبَا وَإِنْ كَثُرَ ، فَإِنَّ عَاقِبَتَهُ تَصِيرُ إِلَى  قُلٍّ  .         [8/457]","","Musnad Abi Ya'la al-Mawsili 5042","","عبد الله بن مسعود عن الربيع بن عميلة الفزاري عن ركين بن الربيع الفزاري عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5045","77 - (  5043  ) -  حَدَّثَنَا  بِشْرٌ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ :  إِنَّمَا قَنَتَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَهْرًا يَدْعُو فِيهِ عَلَى حَيٍّ مِنْ أَحْيَاءِ  بَنِي سُلَيْمٍ  ، كَانُوا  عُصَيَّةً  ، عَصَوُا اللهَ وَرَسُولَهُ ، ثُمَّ لَمْ يَقْنُتْ بَعْدَ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 5043","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن ميمون القصاب عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5046","78 - (  5044  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  حَبَسَ الْمُشْرِكُونَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ صَلَاةِ الْعَصْرِ ، حَتَّى  اصْفَرَّتِ الشَّمْسُ - أَوِ احْمَرَّتْ  - فَقَالَ :  شَغَلُونَا عَنْ صَلَاةِ الْوُسْطَى ،  مَلَأَ اللهُ أَجْوَافَهُمْ وَقُبُورَهُمْ نَارًا ، أَوْ حَشَا اللهُ أَجْوَافَهُمْ وَقُبُورَهُمْ نَارًا  .         [8/458]","","Musnad Abi Ya'la al-Mawsili 5044","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن محمد بن طلحة بن مصرف الهمداني عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5047","79 - (  5045  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ هُبَيْرَةَ ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّهُ قَرَأَ فِي أُذُنِ مُبْتَلًى ،  فَأَفَاقَ  ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَا قَرَأْتَ فِي أُذُنِهِ ؟ قَالَ : قَرَأْتُ :         {      أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا         }      حَتَّى فَرَغَ مِنْ آخِرِ السُّورَةِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ أَنَّ رَجُلًا مُوقِنًا قَرَأَ بِهَا عَلَى جَبَلٍ لَزَالَ  .         [8/459]","","Musnad Abi Ya'la al-Mawsili 5045","","عبد الله بن مسعود عن حنش بن عبد الله السبائي عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن الوليد بن مسلم القرشي عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5048","80 - (  5046  ) -  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  حَدَّثَنَا  شَرِيكُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِي فَزَارَةَ ،  عَنْ  أَبِي زَيْدٍ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَوَضَّأَ بِالنَّبِيذِ  .         [8/460]             [8/461]","","Musnad Abi Ya'la al-Mawsili 5046","","عبد الله بن مسعود عن أبو زيد المخزومي عن راشد بن كيسان العبسي عن شريك بن عبد الله النخعي عن منصور بن أبي مزاحم عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5049","81 - (  5047  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عَوْنٍ الْخَرَّازُ ،  حَدَّثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبَانَ بْنِ إِسْحَاقَ ،  عَنِ  الصَّبَّاحِ بْنِ مُحَمَّدِ بْنِ أَبِي حَازِمٍ ،  عَنْ  مُرَّةَ الْهَمْدَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اسْتَحْيُوا مِنَ اللهِ حَقَّ الْحَيَاءِ ، فَلْيَحْفَظِ الرَّأْسَ وَمَا حَوَى  ، وَلْيَحْفَظِ الْبَطْنَ وَمَا  وَعَى  ، وَلْيَذْكُرِ الْمَوْتَ وَالْبِلَى ، وَمَنْ أَرَادَ الْآخِرَةَ تَرَكَ زِينَةَ الدُّنْيَا ، فَمَنْ فَعَلَ ذَلِكَ ، فَقَدِ اسْتَحْيَا مِنَ اللهِ حَقَّ الْحَيَاءِ  .         [8/462]","","Musnad Abi Ya'la al-Mawsili 5047","","عبد الله بن مسعود عن مرة بن شراحيل عن صباح بن محمد الأحمسي عن أبان بن إسحاق عن مروان بن معاوية الفزاري عن عبد الله بن عون الهلالي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5050","82 - (  5048  ) -  حَدَّثَنَا  كَامِلُ بْنُ طَلْحَةَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّهُمْ قَالُوا : يَا رَسُولَ اللهِ ، كَيْفَ تَعْرِفُ مَنْ لَمْ تَرَ مِنْ أُمَّتِكَ ؟ قَالَ :  غُرٌّ  مُحَجَّلُونَ  ، بُلْقٌ مِنْ آثَارِ الطُّهُورِ  .         [8/463]","","Musnad Abi Ya'la al-Mawsili 5048","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن كامل بن طلحة الجحدري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5051","83 - (  5049  ) -  حَدَّثَنَا  سَعِيدُ بْنُ أَشْعَثَ ،  أَخْبَرَنِي  عَبْدُ الْمَلِكِ بْنُ الْوَلِيدِ بْنِ مَعْدَانَ ،  حَدَّثَنَا  عَاصِمٌ يَعْنِي ابْنَ بَهْدَلَةَ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  مَا أُحْصِي مَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ فِي الرَّكْعَتَيْنِ قَبْلَ صَلَاةِ الْفَجْرِ  ، وَفِي الرَّكْعَتَيْنِ بَعْدَ الْمَغْرِبِ بِـ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .         [8/464]","","Musnad Abi Ya'la al-Mawsili 5049","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عبد الملك بن الوليد بن معدان الضبعي عن سعيد بن أبى الربيع السمان عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5052","84 - (  5050  ) -  حَدَّثَنَا  سَعِيدُ بْنُ الْأَشْعَثِ ،  أَخْبَرَنِي  عَبْدُ الْمَلِكِ بْنُ الْوَلِيدِ بْنِ مَعْدَانَ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ فِي  الْوِتْرِ  فِي الرَّكْعَةِ الْأُولَى : بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ،  وَفِي الثَّانِيَةِ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَفِي الثَّالِثَةِ :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Musnad Abi Ya'la al-Mawsili 5050","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عبد الملك بن الوليد بن معدان الضبعي عن سعيد بن أبى الربيع السمان عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5053","85 - (  5051  ) -  وَبِإِسْنَادِهِ  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  كَأَنِّي أَنْظُرُ إِلَى بَيَاضِ خَدَّيْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ يَمِينِهِ السَّلَامُ         [8/465]      عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ  ، السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ عَنْ يَسَارِهِ  .         [8/466]","","Musnad Abi Ya'la al-Mawsili 5051","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عبد الملك بن الوليد بن معدان الضبعي عن سعيد بن أبى الربيع السمان عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5054","86 - (  5052  ) -  حَدَّثَنَا  سَعِيدُ بْنُ الْأَشْعَثِ ،  أَخْبَرَنِي  الْهَيْصَمُ بْنُ الشُّدَّاخِ الْعَبْدِيُّ ،  عَنِ  الْأَعْمَشِ  يُحَدِّثُ عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنْ  عَلْقَمَةَ بْنِ قَيْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  عَجِبْتُ لِلنَّاسِ وَتَرْكِهِمْ قِرَاءَتِي وَأَخْذِهِمْ قِرَاءَةَ  زَيْدٍ  ، وَقَدْ أَخَذْتُ مِنْ فِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَبْعِينَ سُورَةً  وَزَيْدُ بْنُ ثَابِتٍ  غُلَامٌ صَاحِبُ ذُؤَابَةٍ يَجِيءُ وَيَذْهَبُ فِي  الْمَدِينَةِ  .         [8/467]","","Musnad Abi Ya'la al-Mawsili 5052","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن يحيى بن وثاب الأصبهاني عن الأعمش عن الهيصم بن الشداخ الوراق عن سعيد بن أبى الربيع السمان عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5055","87 - (  5053  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  عَبْدَةُ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو الْأَوْدِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا         [8/468]      أُخْبِرُكُمْ بِمَنْ  يَحْرُمُ عَلَى النَّارِ ، أَوْ مَنْ تَحْرُمُ عَلَيْهِ النَّارُ ؟  عَلَى كُلِّ هَيِّنٍ قَرِيبٍ سَهْلٍ  .","","Musnad Abi Ya'la al-Mawsili 5053","","عبد الله بن مسعود عن عبد الله بن عمرو الأودي عن موسى بن عقبة عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5056","88 - (  5054  ) -  حَدَّثَنَا  أَبُو طَالِبٍ عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو الرَّقِّيُّ ،  عَنْ  عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ،  عَنْ  أَبِي وَاصِلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَعَنَ  الْمُحِلَّ ،  وَالْمُحَلَّلَ لَهُ  .         [8/469]","","Musnad Abi Ya'la al-Mawsili 5054","","عبد الله بن مسعود عن أبو الواصل عن عبد الكريم الاصطخري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الجبار بن عاصم الخراساني عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5057","89 - (  5055  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَلَاءِ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  شَيْبَانَ ،  عَنْ  فِرَاسٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَقَدْ دَخَلَ الْجَنَّةَ رَجُلٌ مَا عَمِلَ خَيْرًا ، فَقَالَ لِأَهْلِهِ حِينَ حَضَرَتْهُ الْوَفَاةُ ، إِذَا أَنَا         [8/470]      مُتُّ ،  فَأَحْرِقُونِي  ، ثُمَّ اسْحَقُونِي  ، ثُمَّ ذَرُوا نِصْفِي فِي الْبَرِّ ، وَنِصْفِي فِي الْبَحْرِ ، فَأَمَرَ الْبَحْرَ وَالْبَرَّ فَجَمَعَاهُ ، فَقَالَ : مَا حَمَلَكَ عَلَى مَا صَنَعْتَ ؟ قَالَ : مَخَافَتُكَ ، فَغَفَرَ لَهُ لِذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 5055","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فراس بن يحيى الخارفي عن شيبان بن عبد الرحمن المؤدب عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5058","90 - (  5056  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، نَحْوَ هَذَا الْحَدِيثِ ، وَكَانَ الرَّجُلُ نَبَّاشًا فَغَفَرَ لَهُ لِخَوْفِهِ .","","Musnad Abi Ya'la al-Mawsili 5056","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5059","91 - (  5057  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ :  اخْتَصَمَ رَجُلَانِ فِي سُورَةٍ ، فَقَالَ هَذَا : أَقْرَأَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَقَالَ هَذَا : أَقْرَأَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَتَيَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأُخْبِرَ بِذَلِكَ قَالَ : فَتَغَيَّرَ وَجْهُهُ ، فَقَالَ :  اقْرَءُوا كَمَا عُلِّمْتُمْ ، فَذَكَرَ فِيهِ كَلَامًا ، ثُمَّ قَالَ : فَإِنَّمَا هَلَكَ مَنْ كَانَ قَبْلَكُمْ بِاخْتِلَافِهِمْ عَلَى أَنْبِيَائِهِمْ  .         [8/471]      قَالَ : فَقَامَ كُلُّ رَجُلٍ مِنَّا ، وَهُوَ لَا يَقْرَأُ عَلَى قِرَاءَةِ صَاحِبِهِ  .","","Musnad Abi Ya'la al-Mawsili 5057","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5060","92 - (  5058  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ،  عَنْ  زَائِدَةَ ،  حَدَّثَنَا  عَاصِمُ بْنُ أَبِي النَّجُودِ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ مَعَ  أَبِي بَكْرٍ  وَعُمَرَ  ،  وَعَبْدُ اللهِ  يُصَلِّي فَافْتَتَحَ سُورَةَ النِّسَاءِ ،  فَسَجَلَهَا ،  فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَحَبَّ أَنْ يَقْرَأَ الْقُرْآنَ  غَضًّا  كَمَا أُنْزِلَ ، فَلْيَقْرَأْ قِرَاءَةَ  ابْنِ أُمِّ عَبْدٍ  .  ثُمَّ قَعَدَ ، ثُمَّ سَأَلَ ، فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : سَلْ         [8/472]      تُعْطَهْ ، فَقَالَ فِيمَا يَسْأَلُ ، اللَّهُمَّ إِنِّي أَسْأَلُكَ إِيمَانًا لَا يَرْتَدُّ ، وَنَعِيمًا لَا يَنْفَدُ ، وَمُرَافَقَةَ نَبِيِّنَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَعْلَى جَنَّةِ الْخُلْدِ ، فَأَتَى  عُمَرُ  لِيُبَشِّرَهُ بِهَا ، فَوَجَدَ  أَبَا بَكْرٍ  خَارِجًا قَدْ سَبَقَهُ ، فَقَالَ : إِنْ فَعَلْتَ إِنَّكَ لَسَبَّاقٌ بِالْخَيْرِ  .","","Musnad Abi Ya'la al-Mawsili 5058","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن زائدة بن قدامة عن الحسين بن علي الجعفي عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5061","93 - (  5059  ) -  حَدَّثَنَا  أَبُو كُرَيْبٍ ،  حَدَّثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  أَبِي بَكْرِ بْنِ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ :  كُنْتُ فِي الْمَسْجِدِ أُصَلِّي ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهُ  أَبُو بَكْرٍ  وَعُمَرُ  ، فَسَجَلْتُ سُورَةَ النِّسَاءِ ، فَقَرَأْتُهَا ، فَلَمَّا فَرَغْتُ جَلَسْتُ ، فَبَدَأْتُ بِالثَّنَاءِ عَلَى اللهِ عَزَّ وَجَلَّ ، وَالصَّلَاةِ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ دَعَوْتُ لِنَفْسِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سَلْ تُعْطَ ، سَلْ تُعْطَ ، ثُمَّ قَالَ : مَنْ أَحَبَّ أَنْ يَقْرَأَ الْقُرْآنَ  غَضًّا  ، فَلْيَقْرَأْهُ كَمَا يَقْرَأُ  ابْنُ أُمِّ عَبْدٍ  .         [8/473]      قَالَ : فَرَجَعْتُ إِلَى مَنْزِلِي ، فَأَتَانِي  أَبُو بَكْرٍ  فَقَالَ : هَلْ تَحْفَظُ مِمَّا كُنْتَ تَدْعُو شَيْئًا ؟ قَالَ : قُلْتُ : نَعَمِ ، اللَّهُمَّ إِنِّي أَسْأَلُكَ إِيمَانًا لَا يَرْتَدُّ ، وَنَعِيمًا لَا يَنْفَدُ ، وَمُرَافَقَةَ نَبِيِّنَا  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَعْلَى جَنَّةِ الْخُلْدِ .  قَالَ : ثُمَّ أَتَانِي  عُمَرُ  أَيْضًا فَبَشَّرَنِي  .","","Musnad Abi Ya'la al-Mawsili 5059","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن يحيى بن آدم عن أبو كريب محمد بن العلاء عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5062","94 - (  5060  ) -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ قَالَ :  وَأَخْبَرَنِي  عَمْرُو بْنُ أَبِي عَمْرٍو مَوْلَى الْمُطَّلِبِ ،  عَنْ  رَجُلٍ ، مِنْ بَنِي عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ كَانَ سَهْلًا لَيِّنًا قَرِيبًا ، حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 5060","","عبد الله بن مسعود عن رجل من بني عبد الله بن مسعود عن عمرو بن أبي عمرو المخزومي عن إسماعيل بن جعفر بن أبي كثير الزرقي عن يحيى بن أيوب المقابري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5063","95 - (  5061  ) -  حَدَّثَنَا  حَجَّاجُ بْنُ يُوسُفَ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَكِيمٍ ،  حَدَّثَنِي  زَمْعَةُ ،  عَنِ  ابْنِ شِهَابٍ ،  أَخْبَرَنِي  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ ،  عَنِ  ابْنِ مَسْعُودٍ :  أَنَّهُ تَمَتَّعَ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُتْعَةَ  الْحَجِّ  .         [8/474]","","Musnad Abi Ya'la al-Mawsili 5061","","عبد الله بن مسعود عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن زمعة بن صالح الجندي عن يزيد بن أبي حكيم الكناني عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5064","96 - (  5062  ) -  حَدَّثَنَا  حَجَّاجُ بْنُ يُوسُفَ ،  حَدَّثَنِي  عُثْمَانُ بْنُ عُمَرَ ،  أَخْبَرَنَا  يُونُسُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  بِتُّ اللَّيْلَةَ أَقْرَأُ عَلَى الْجِنِّ رُفَقَاءَ  بِالْحَجُونِ  .","","Musnad Abi Ya'la al-Mawsili 5062","","عبد الله بن مسعود عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن يونس بن يزيدالأيلي عن عثمان بن عمر بن فارس عن حجاج يوسف الثقفي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5065","97 - (  5063  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،         [8/475]      عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ارْحَمْ مَنْ فِي الْأَرْضِ ، يَرْحَمْكَ مَنْ فِي السَّمَاءِ  .","","Musnad Abi Ya'la al-Mawsili 5063","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5066","98 - (  5064  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ، وَعَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ ، قَالَا :  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ،  عَنْ  عَلْقَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ :  لَمَّا نَزَلَتْ هَذِهِ الْآيَةُ :         [8/476]             {      لَيْسَ عَلَى الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جُنَاحٌ فِيمَا طَعِمُوا إِذَا مَا اتَّقَوْا         }      إِلَى آخِرِ الْآيَةِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قِيلَ لِي : أَنْتَ مِنْهُمْ  ،  وَهَذَا لَفْظُ  عَبْدِ الْغَفَّارِ  .","","Musnad Abi Ya'la al-Mawsili 5064","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5067","99 - (  5065  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ، وَعَبْدُ الْغَفَّارِ قَالَا :  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَدْخُلُ الْجَنَّةَ أَحَدٌ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةِ  خَرْدَلٍ مِنْ  كِبْرٍ  ، وَلَا يَدْخُلُ النَّارَ مَنْ كَانَ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ مِنْ إِيمَانٍ  .         [8/477]","","Musnad Abi Ya'la al-Mawsili 5065","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5068","100 - (  5066  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَدْخُلُ الْجَنَّةَ مَنْ كَانَ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ  مِنْ خَرْدَلٍ مِنْ  كِبْرٍ  ، وَلَا يَدْخُلُ النَّارَ مَنْ كَانَ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةِ  خَرْدَلٍ مِنْ إِيمَانٍ .","","Musnad Abi Ya'la al-Mawsili 5066","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن عبد العزيز بن مسلم الخراساني عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5069","101 - (  5067  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ بْنُ عَبْدِ اللهِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ  قَالَ :  سَمِعْتُ  ابْنَ يُوسُفَ  ،  قَالَ وَهُوَ عَلَى الْمِنْبَرِ : أَلِّفُوا الْقُرْآنَ كَمَا أَلَّفَهُ  جِبْرِيلُ  : السُّورَةُ الَّتِي تُذْكَرُ فِيهَا الْبَقَرَةُ ، السُّورَةُ الَّتِي يُذْكَرُ فِيهَا آلُ عِمْرَانَ ، السُّورَةُ الَّتِي يُذْكَرُ فِيهَا النِّسَاءُ .  قَالَ  الْأَعْمَشُ  : فَلَقِيتُ  إِبْرَاهِيمَ  ، فَأَخْبَرْتُهُ ، فَسَبَّهُ  ، ثُمَّ  قَالَ  إِبْرَاهِيمُ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ ،  أَنَّهُ كَانَ مَعَ عَبْدِ اللهِ بْنِ مَسْعُودٍ ، حِينَ رَمَى جَمْرَةَ  الْعَقَبَةِ  ، فَاسْتَبْطَنَ  الْوَادِيَ  ، فَرَمَاهَا مِنْ بَطْنِ  الْوَادِي  بِسَبْعِ حَصَيَاتٍ ، يُكَبِّرُ مَعَ كُلِّ حَصَاةٍ  ، فَقُلْتُ لَهُ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، إِنَّ النَّاسَ يَرْمُونَهَا مِنْ فَوْقِهَا ، فَقَالَ  ابْنُ مَسْعُودٍ  :  هَذَا وَالَّذِي لَا إِلَهَ غَيْرُهُ ، مَقَامُ الَّذِي         [8/478]      أُنْزِلَتْ عَلَيْهِ سُورَةُ الْبَقَرَةِ  .","","Musnad Abi Ya'la al-Mawsili 5067","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5070","102 - (  5068  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  أَتَيْتُ  حِمْصَ  ، فَقَالَ لِي نَفَرٌ مِنْهُمْ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، اقْرَأْ عَلَيْنَا ، فَقَرَأْتُ سُورَةَ يُوسُفَ ، فَقَالَ لِي رَجُلٌ : مَا هَكَذَا أُنْزِلَتْ ، فَقُلْتُ لَهُ : وَيْحَكَ ،  وَاللهِ لَقَدْ قَرَأْتُهَا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : أَحْسَنْتَ  قَالَ : فَبَيْنَا أَنَا أُرَادُّهُ بِالْكَلَامِ ، إِذْ وَجَدْتُ مِنْهُ رِيحَ الْخَمْرِ ، فَقُلْتُ لَهُ : أَتَشْرَبُ الرِّجْسَ ، وَتُكَذِّبُ بِالْقُرْآنِ ؟ لَا  جَرَمَ  ، لَا تَبْرَحْ حَتَّى أَجْلِدَكَ  حَدًّا  ، فَجَلَدْتُهُ  حَدًّا  .","","Musnad Abi Ya'la al-Mawsili 5068","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5071","[9/5]      103 - (  5069  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبِيدَةَ السَّلْمَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اقْرَأْ عَلَيْنَا ، قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، أَقْرَأُ عَلَيْكَ ، وَإِنَّمَا أُنْزِلَ الْقُرْآنُ عَلَيْكَ  ؟ قَالَ : إِنِّي أُحِبُّ أَنْ أَسْمَعَهُ مِنْ غَيْرِي ، فَقَرَأْتُ عَلَيْهِ سُورَةَ النِّسَاءِ حَتَّى إِذَا بَلَغْتُ         {      فَكَيْفَ إِذَا جِئْنَا مِنْ كُلِّ أُمَّةٍ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَى هَؤُلاءِ شَهِيدًا         }      غَمَزَنِي ، فَنَظَرْتُ إِلَيْهِ ، فَإِذَا عَيْنَاهُ تُهْرَاقَانِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Musnad Abi Ya'la al-Mawsili 5069","","عبد الله بن مسعود عن عبيدة بن عمرو السلماني عن إبراهيم النخعي عن الأعمش عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5072","104 - (  5070  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  بَيْنَمَا نَحْنُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، إِذِ انْفَلَقَ الْقَمَرُ فِلْقَتَيْنِ  ، فَكَانَتْ فِلْقَةٌ مِنْ وَرَاءِ الْجَبَلِ ، وَفِلْقَةٌ دُونَهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اشْهَدُوا  .         [9/6]","","Musnad Abi Ya'la al-Mawsili 5070","","عبد الله بن مسعود عن عبد الله بن سخبرة عن إبراهيم النخعي عن الأعمش عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5073","105 - (  5071  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، أَنُؤَاخَذُ بِمَا عَمِلْنَا فِي الْجَاهِلِيَّةِ ؟ فَقَالَ :  مَنْ أَحْسَنَ فِي الْإِسْلَامِ لَمْ يُؤْخَذْ بِمَا عَمِلَ بِهِ فِي الْجَاهِلِيَّةِ  ، وَإِنْ أَسَاءَ فِي الْإِسْلَامِ أُخِذَ بِالْأَوَّلِ وَالْآخِرِ .         [9/7]","","Musnad Abi Ya'la al-Mawsili 5071","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5074","106 - (  5072  ) -  حَدَّثَنَا  عَبْدُ الْغَفَّارِ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  كَأَنِّي أَنْظُرُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَكَى نَبِيًّا مِنَ الْأَنْبِيَاءِ ، ضَرَبَهُ قَوْمُهُ ، حَتَّى أَدْمَوْا وَجْهَهُ ، فَجَعَلَ يَمْسَحُ الدَّمَ عَنْ وَجْهِهِ ، وَهُوَ يَقُولُ :  رَبِّ اغْفِرْ لِقَوْمِي فَإِنَّهُمْ لَا يَعْلَمُونَ  .","","Musnad Abi Ya'la al-Mawsili 5072","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن علي بن مسهر القرشي عن عبد الغفار بن عبد الله بن الزبير الزبيري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5075","107 - (  5073  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ بُنْدَارٌ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  تَسَحَّرُوا فَإِنَّ فِي السَّحُورِ بَرَكَةً  .         [9/8]","","Musnad Abi Ya'la al-Mawsili 5073","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن عبد الرحمن بن مهدي عن محمد بن بشار بندار عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5076","108 - (  5074  ) -  حَدَّثَنَا  عَاصِمُ بْنُ النَّضْرِ بْنِ الْمُنْتَشِرِ الْأَحْوَلُ ،  حَدَّثَنَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  الرُّكَيْنَ بْنَ الرَّبِيعِ  يُحَدِّثُ ، عَنِ  الْقَاسِمِ بْنِ حَسَّانَ ،  عَنْ  عَمِّهِ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَكْرَهُ عَشْرَ خِلَالٍ  : الصُّفْرَةُ -  يَعْنِي :  الْخَلُوقَ  - ، وَجَرُّ الْإِزَارِ ، وَالتَّخَتُّمُ بِالذَّهَبِ ، وَنَتْفُ الشَّيْبِ ، وَالضَّرْبُ  بِالْكِعَابِ  ،  وَالتَّبَرُّجُ  بِالزِّينَةِ بِغَيْرِ  مَحَلِّهَا  ، وَالرُّقَى إِلَّا بِالْمُعَوِّذَاتِ ، وَتَعَلُّقٌ  بِالتَّمَائِمِ  ،  وَعَزْلُ  الْمَاءِ عِنْدَ أَوَانِهِ عَنْ مَحَلِّهِ ، وَفَسَادُ الصَّبِيِّ غَيْرُ مُحَرِّمِهِ  .         [9/9]","","Musnad Abi Ya'la al-Mawsili 5074","","عبد الله بن مسعود عن عبد الرحمن بن حرملة الكوفي عن القاسم بن حسان العامري عن ركين بن الربيع الفزاري عن معتمر بن سليمان عن عاصم بن النضر الأحول عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5077","109 - (  5075  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  عَوْسَجَةَ بْنِ الرَّمَّاحِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ : اللَّهُمَّ حَسَّنْتَ خَلْقِي فَحَسِّنْ  خُلُقِي  .         [9/10]","","Musnad Abi Ya'la al-Mawsili 5075","","عبد الله بن مسعود عن عبد الله بن أبي الهذيل الغنوي عن عوسجة بن الرماح الكوفي عن عاصم بن سليمان الأحول عن محمد بن فضيل بن غزوان عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5078","110 - (  5076  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  صَلَاةُ الرَّجُلِ فِي جَمَاعَةٍ تَزِيدُ عَلَى صَلَاتِهِ وَحْدَهُ  بِضْعًا  وَعِشْرِينَ دَرَجَةً  .","","Musnad Abi Ya'la al-Mawsili 5076","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5079","111 - (  5077  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَنَّهُ  كَانَ يَقُولُ : اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الشَّيْطَانِ  ، مِنْ  هَمْزِهِ  ،  وَنَفْثِهِ  ،  وَنَفْخِهِ  ، فَهَمْزُهُ : الْمُوتَةُ ،  وَنَفْخُهُ  : الشِّعْرُ ،  وَنَفْثُهُ  : الْكِبْرُ  .         [9/11]","","Musnad Abi Ya'la al-Mawsili 5077","","عبد الله بن مسعود عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5080","112 - (  5078  ) -  حَدَّثَنَا  ابْنُ نُمَيْرٍ ،  حَدَّثَنَا  أَبِي  ، وَمُحَمَّدُ بْنُ بِشْرٍ ، قَالَا :  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنْ  قَيْسٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ مَسْعُودٍ ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  حَسَدَ  إِلَّا فِي اثْنَتَيْنِ  : رَجُلٌ آتَاهُ اللهُ مَالًا ، فَسَلَّطَهُ عَلَى هَلَكَتِهِ فِي الْحَقِّ ، وَرَجُلٌ آتَاهُ اللهُ الْحِكْمَةَ ، فَهُوَ يَقْضِي بِهَا ، وَيُعَلِّمُهَا  .         [9/12]","","Musnad Abi Ya'la al-Mawsili 5078","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن محمد بن بشر بن الفرافصة عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5081","113 - (  5079  ) -  حَدَّثَنَا  هَارُونُ بْنُ مَعْرُوفٍ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  أَخْبَرَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  أَيُّوبَ بْنِ هَانِئٍ ،  عَنْ  مَسْرُوقِ بْنِ الْأَجْدَعِ ،  عَنِ  ابْنِ مَسْعُودٍ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  كُلُّ مُسْكِرٍ حَرَامٌ  .         [9/13]","","Musnad Abi Ya'la al-Mawsili 5079","","عبد الله بن مسعود عن مسروق بن الأجدع عن أيوب بن هانئ الكوفي عن ابن جريج عن عبد الله بن وهب المصري عن هارون بن معروف المروزي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5082","114 - (  5080  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي سَمِينَةَ الْبَصْرِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الْحَنَفِيُّ ،  حَدَّثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ كَيْسَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ شَدَّادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَوْلَاكُمْ بِي يَوْمَ الْقِيَامَةِ أَكْثَرُكُمْ عَلَيَّ صَلَاةً  .","","Musnad Abi Ya'la al-Mawsili 5080","","عبد الله بن مسعود عن عبد الله بن شداد بن الهاد الليثي عن عبد الله بن كيسان مولى طلحة بن عبد الله بن عوف عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن خالد بن عثمة الهاشمى عن محمد بن إسماعيل بن أبي سمينة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5083","115 - (  5081  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  زِيَادِ بْنِ الْجَرَّاحِ ،  عَنِ  ابْنِ مَعْقِلٍ ،  قَالَ :  دَخَلْتُ مَعَ أَبِي  عَلَى عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فَسَمِعْتُهُ  ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  النَّدَمُ تَوْبَةٌ  .","","Musnad Abi Ya'la al-Mawsili 5081","","عبد الله بن مسعود عن عبد الله بن معقل بن مقرن المزني عن زياد بن الجراح الجزري عن عبد الكريم الاصطخري عن شريك بن عبد الله النخعي عن محمد بن الصباح الدولابي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5084","116 - (  5082  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  كُنَّا نَقُولُ إِذَا جَلَسْنَا فِي الصَّلَاةِ : السَّلَامُ عَلَى اللهِ قَبْلَ عِبَادِهِ ، السَّلَامُ عَلَى  جِبْرِيلَ  ، السَّلَامُ عَلَى  مِيكَائِيلَ  ، السَّلَامُ عَلَى فُلَانٍ ، قَالَ : فَنَقُولُ : مَلَائِكَتَهُ ، فَالْتَفَتَ إِلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  إِنَّ اللهَ هُوَ السَّلَامُ ، فَإِذَا جَلَسْتُمْ         [9/14]      فَقُولُوا :  التَّحِيَّاتُ  لِلهِ ، وَالصَّلَوَاتُ ،  وَالطَّيِّبَاتُ  ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا هُوَ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، ثُمَّ نَتَخَيَّرُ الْكَلَامَ  .         [9/15]             [9/16]","","Musnad Abi Ya'la al-Mawsili 5082","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن علي بن مسهر القرشي عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5085","117 - (  5083  ) -  حَدَّثَنَا  مُحْرِزُ بْنُ عَوْنٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُبَاشِرِ الْمَرْأَةُ         [9/17]      الْمَرْأَةَ فَتَنْعَتَهَا لِزَوْجِهَا  حَتَّى كَأَنَّهُ يَنْظُرُ إِلَيْهَا  .","","Musnad Abi Ya'la al-Mawsili 5083","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن علي بن مسهر القرشي عن محرز بن عون الهلالي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5086","118 - (  5084  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ مُحَمَّدُ بْنُ يَزِيدَ بْنِ رِفَاعَةَ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ أَبِي زِيَادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَجِيءُ رَايَاتٌ         [9/18]      سُودٌ مِنْ قِبَلِ  الْمَشْرِقِ  ، وَتَخُوضُ الْخَيْلُ الدِّمَاءَ إِلَى  ثُنَّتِهَا  يُظْهِرُونَ الْعَدْلَ وَيَطْلُبُونَ الْعَدْلَ فَلَا يُعْطَوْنَهُ ، فَيَظْهَرُونَ ، فَيُطْلَبُ مِنْهُمُ الْعَدْلُ فَلَا يُعْطَوْنَهُ  .","","Musnad Abi Ya'la al-Mawsili 5084","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن يزيد بن أبي زياد القرشي عن أبو بكر بن عياش عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5087","119 - (  5085  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ عُقْبَةَ الشَّيْبَانِيُّ ،  حَدَّثَنَا  زَائِدَةُ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى الْمَسْجِدِ ، فَإِذَا فِيهِ نِسْوَةٌ مِنَ  الْأَنْصَارِ  ، فَأَتَاهُنَّ ، فَوَعَظَهُنَّ ، وَذَكَّرَهُنَّ ، وَقَالَ :  مَا مِنْكُنَّ امْرَأَةٌ يَمُوتُ لَهَا ثَلَاثَةٌ مِنَ الْوَلَدِ إِلَّا دَخَلَتِ الْجَنَّةَ  ، فَقَالَتِ  امْرَأَةٌ  مِنْ أَجَلِّهِنَّ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ ذَاتَ الِاثْنَيْنِ ؟ فَقَالَ : مَا مِنْكُنَّ امْرَأَةٌ يَمُوتُ لَهَا اثْنَانِ إِلَّا دَخَلَتِ الْجَنَّةَ .         [9/19]","","Musnad Abi Ya'la al-Mawsili 5085","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن زائدة بن قدامة عن الوليد بن عقبة بن المغيرة عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5088","120 - (  5086  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ، قَالَ :  حَدَّثَنَا  أَبُو أُسَامَةَ ،  حَدَّثَنَا  أَبُو حَنِيفَةَ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَفْضَلُ  الْحَجِّ  الْعَجُّ  وَالثَّجُّ  ، فَأَمَّا  الْعَجُّ :  فَالتَّلْبِيَةُ ، وَأَمَّا  الثَّجُّ  : فَنَحْرُ الْبُدْنِ .","","Musnad Abi Ya'la al-Mawsili 5086","","عبد الله بن مسعود عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن أبو حنيفة النعمان عن حماد بن أسامة القرشي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5089","121 - (  5087  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْأَعْلَى الثَّعْلَبِيِّ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ بْنِ مَسْعُودٍ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ         [9/20]      اللهَ لَيَغَارُ لِعَبْدِهِ الْمُؤْمِنِ  ، فَلْيَغَرْ لِنَفْسِهِ  .","","Musnad Abi Ya'la al-Mawsili 5087","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عبد الأعلى بن عامر الثعلبي عن سفيان الثوري عن وكيع بن الجراح عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5090","122 - (  5088  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  حَدَّثَنَا  الْحَسَنُ بْنُ عَمْرٍو الْفُقَيْمِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ الْمُؤْمِنُ  بِالطَّعَّانِ  ، وَلَا اللَّعَّانِ ، وَلَا الْبَذِيءِ ، وَلَا الْفَاحِشِ .         [9/21]","","Musnad Abi Ya'la al-Mawsili 5088","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن محمد بن عبد الرحمن بن يزيد النخعي عن الحسن بن عمرو الفقيمي عن أبو بكر بن عياش عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5091","123 - (  5089  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنِ  السُّدِّيِّ ، قَالَ :  سَأَلْتُ  مُرَّةَ الْهَمْدَانِيَّ عَنْ قَوْلِهِ :         {      وَإِنْ مِنْكُمْ إِلا وَارِدُهَا         }      فَحَدَّثَنِي  أَنَّ عَبْدَ اللهِ  حَدَّثَهُمْ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  يَرِدُونَ عَلَى الصِّرَاطِ وَيَصْدُرُونَ عَنْهُ بِأَعْمَالِهِمْ ، فَأَوَّلُهُمْ يَمُرُّ كَالرِّيحِ  ، ثُمَّ  كَحُضْرِ  الْفَرَسِ ، ثُمَّ كَالرَّاكِبِ فِي رَحْلِهِ ، ثُمَّ  كَشَدِّ  الرَّجُلِ ، ثُمَّ كَمَشْيِهِ  .         [9/22]","","Musnad Abi Ya'la al-Mawsili 5089","","عبد الله بن مسعود عن مرة بن شراحيل عن السدي الكبير عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5092","124 - (  5090  ) -  حَدَّثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ،  حَدَّثَنَا  أَبُو بَكْرٍ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ مَاتَ يَجْعَلُ لِلهِ  نِدًّا  ، أَدْخَلَهُ النَّارَ  ، قَالَ  أَبُو عَبْدِ الرَّحْمَنِ  :  وَأُخْرَى قُلْتُهَا : مَنْ مَاتَ لَا يَجْعَلُ لِلهِ  نِدًّا  ، أَدْخَلَهُ اللهُ الْجَنَّةَ  ،         [9/23]      وَإِنَّ هَذِهِ الصَّلَوَاتِ الْحَقَائِقَ كَفَّارَاتٌ لَمَّا بَيْنَهُنَّ مِنَ الْخَطَايَا مَا اجْتُنِبَ الْمَقْتَلُ  .         [9/24]      قَالَ  أَبُو بَكْرٍ  :  يَعْنِي : الْكَبَائِرَ  .         [9/25]","","Musnad Abi Ya'la al-Mawsili 5090","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن أبو بكر بن عياش عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5093","125 - (  5091  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  ذُكِرَ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلٌ  ، فَقِيلَ :  يَا رَسُولَ اللهِ ، إِنَّ فُلَانًا نَامَ اللَّيْلَةَ حَتَّى أَصْبَحَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  بَالَ  الشَّيْطَانُ فِي أُذُنِهِ  .         [9/26]","","Musnad Abi Ya'la al-Mawsili 5091","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن زائدة بن قدامة عن الحسين بن علي الجعفي عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5094","126 - (  5092  ) -  حَدَّثَنَا  أَبُو هِشَامٍ ،  حَدَّثَنَا  عُبَيْدُ اللهِ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عِيسَى بْنِ عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الطِّيَرَةُ :  الشِّرْكُ  ، وَمَا مِنَّا إِلَّا ، وَلَكِنَّ اللهَ يُذْهِبُهُ بِالتَّوَكُّلِ  .         [9/27]","","Musnad Abi Ya'la al-Mawsili 5092","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عيسى بن عاصم الأسدي عن سلمة بن كهيل الحضرمي عن منصور بن المعتمر عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن يزيد بن محمد بن كثير الرفاعي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5095","127 - (  5093  ) -  حَدَّثَنَا  سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْأُمَوِيُّ ،  حَدَّثَنَا  أَبِي ،  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كَأَنِّي أَنْظُرُ إِلَى  مُوسَى بْنِ عِمْرَانَ  فِي هَذَا الْوَادِي مُحْرِمًا بَيْنَ  قَطَوَانِيَّتَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5093","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن زيد بن أبي أنيسة الجزري عن يزيد بن سنان الرهاوي عن يحيى بن سعيد بن أبان عن سعيد بن يحيى بن سعيد الأموي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5096","128 - (  5094  ) -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ الْوَاسِطِيُّ ،  حَدَّثَنَا  خَالِدٌ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّهُ مَنْ كَانَ قَبْلَكُمْ مِنْ بَنِي إِسْرَائِيلَ كَانَ إِذَا عَمِلَ الْعَامِلُ مِنْهُمْ بِالْخَطِيئَةِ نَهَاهُ         [9/28]      النَّاهِي  تَعْذِيرًا  ، فَإِذَا كَانَ مِنَ الْغَدِ جَالَسَهُ ، وَآكَلَهُ ، وَشَارَبَهُ ، كَأَنْ لَمْ يَرَهُ عَلَى الْخَطِيئَةِ بِالْأَمْسِ ، فَلَمَّا رَأَى اللهُ ذَلِكَ مِنْهُمْ ضَرَبَ بِقُلُوبِ بَعْضِهِمْ عَلَى بَعْضٍ ، وَلَعَنَهُمْ عَلَى لِسَانِ نَبِيِّهِمْ  دَاوُدَ  ،  وَعِيسَى ابْنِ مَرْيَمَ  ، ذَلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ ، وَالَّذِي نَفْسِي بِيَدِهِ ، لَتَأْمُرُنَّ بِالْمَعْرُوفِ ، وَلَتَنْهَوُنَّ عَنِ الْمُنْكَرِ ، وَلَتَأْطُرُنَّهُ عَلَى الْحَقِّ  أَطْرًا  ، أَوْ لَيَضْرِبَنَّ اللهُ قُلُوبَ بَعْضِكُمْ بِبَعْضٍ ، وَيَلْعَنَكُمْ كَمَا لَعَنَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 5094","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن علاء بن المسيب عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5097","129 - (  5095  ) -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  مَعْمَرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّ نَاسًا أَتَوُا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالُوا :  إِنَّ صَاحِبَنَا اشْتَكَى ، أَفَنَكْوِيهِ ؟ قَالَ : فَسَكَتَ سَاعَةً ، ثُمَّ قَالَ : إِنْ شِئْتُمْ فَاكْوُوهُ ، وَإِنْ شِئْتُمْ  فَارْضِفُوهُ  .         [9/29]","","Musnad Abi Ya'la al-Mawsili 5095","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن معمر بن راشد عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5098","130 - (  5096  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  حَدَّثَنَا  سَلَّامُ بْنُ سُلَيْمَانَ أَبُو الْمُنْذِرِ ،  حَدَّثَنَا  عَاصِمُ بْنُ بَهْدَلَةَ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  كُنْتُ فِي غَنَمٍ  لِآلِ أَبِي مُعَيْطٍ  أَرْعَاهَا ، فَجَاءَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهُ  أَبُو بَكْرِ بْنُ أَبِي قُحَافَةَ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا غُلَامُ ، هَلْ عِنْدَكَ لَبَنٌ تَسْقِينَا ؟  فَقُلْتُ : نَعَمْ ، وَلَكِنِّي مُؤْتَمَنٌ ، قَالَ : فَهَلْ عِنْدَكَ شَاةٌ شَصُومٌ لَمْ يَنْزُ عَلَيْهَا  الْفَحْلُ  ؟ قُلْتُ : نَعَمْ ، فَأَتَيْتُهُ بِشَاةٍ شَصُومٍ ، قَالَ  سَلَّامٌ  :         [9/30]      لَمْ يَنْزُ عَلَيْهَا  الْفَحْلُ ،  وَهِيَ الَّتِي لَيْسَ لَهَا ضَرْعٌ  ، فَمَسَحَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَكَانَ الضَّرْعِ وَمَا بِهَا ضَرْعٌ ، فَإِذَا ضَرْعٌ  حَافِلٌ  مَمْلُوءٌ لَبَنًا ، وَأَتَيْتُهُ بِصَخْرَةٍ مُنْقَعِرَةٍ ، فَاحْتَلَبَ ، فَسَقَى  أَبَا بَكْرٍ  ، وَسَقَانِي ، ثُمَّ شَرِبَ ، ثُمَّ قَالَ لِلضَّرْعِ :  اقْلِصْ  ، فَرَجَعَ كَمَا كَانَ ، قَالَ : فَأَنَا رَأَيْتُ هَذَا بِعَيْنَيَّ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقُلْتُ : يَا رَسُولَ اللهِ ، عَلِّمْنِي ، فَمَسَحَ بِرَأْسِي ، وَقَالَ : بَارَكَ اللهُ فِيكَ ، فَإِنَّكَ غُلَامٌ  مُعَلَّمٌ  ، فَأَسْلَمْتُ ، فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَبَيْنَمَا نَحْنُ عِنْدَهُ عَلَى  حِرَاءٍ  إِذْ نَزَلَتْ عَلَيْهِ سُورَةُ الْمُرْسَلَاتِ ، فَأَخَذْتُهَا ، وَإِنَّ فَاهُ لَرَطْبٌ بِهَا ،  فَلَا أَدْرِي بِأَيِّ الْآيَتَيْنِ خُتِمَتْ         {      وَإِذَا قِيلَ لَهُمُ ارْكَعُوا لا يَرْكَعُونَ         }      أَوْ ( بِأَيِّ حَدِيثٍ بَعْدَهُ يُؤْمِنُونَ )  فَأَخَذْتُ مِنْ فِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَبْعِينَ سُورَةً ، وَأَخَذْتُ سَائِرَ الْقُرْآنِ مِنْ أَصْحَابِهِ .  قَالَ : فَبَيْنَا نَحْنُ نِيَامٌ عَلَى  حِرَاءٍ  ، فَمَا نَبَّهَنَا إِلَّا قَوْلُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَنَعَهَا مِنْكُمُ الَّذِي مَنَعَكُمْ مِنْهَا ، قُلْنَا : يَا رَسُولَ اللهِ ، وَمَا ذَاكَ ؟ قَالَ : حَيَّةٌ خَرَجَتْ مِنْ نَاحِيَةِ الْجَبَلِ  .         [9/31]","","Musnad Abi Ya'la al-Mawsili 5096","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سلام بن سليمان المزني عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5099","131 - (  5097  ) -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ ،  حَدَّثَنَا  سَلَّامٌ أَبُو الْمُنْذِرِ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّ  مُسَيْلِمَةَ  بَعَثَ رَجُلَيْنِ أَحَدُهُمَا :  ابْنُ أُثَالِ بْنِ حَجْرٍ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَتَشْهَدَانِ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ؟ قَالَا : نَشْهَدُ أَنَّ  مُسَيْلِمَةَ  رَسُولُ اللهِ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : آمَنْتُ بِاللهِ وَرُسُلِهِ ، لَوْ كُنْتُ قَاتِلًا وَفْدًا قَتَلْتُكُمَا .  فَبَيْنَمَا ابْنُ مَسْعُودٍ  بِالْكُوفَةِ  إِذْ رُفِعَ إِلَيْهِ الرَّجُلُ الَّذِي مَعَ  ابْنِ أُثَالٍ  ، وَهُوَ قَرِيبٌ لَهُ فَأَمَرَ بِقَتْلِهِ  ، فَقَالَ لِلْقَوْمِ : وَهَلْ تَدْرُونَ لِمَ قَتَلْتُ هَذَا ؟ قَالُوا : لَا نَدْرِي ، فَقَالَ : إِنَّ  مُسَيْلِمَةَ  بَعَثَ هَذَا مَعَ  ابْنِ أُثَالِ بْنِ حَجْرٍ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَتَشْهَدَانِ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ؟ قَالَا : نَشْهَدُ أَنَّ  مُسَيْلِمَةَ  رَسُولُ اللهِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : آمَنْتُ بِاللهِ وَرُسُلِهِ ، لَوْ كُنْتُ قَاتِلًا وَفْدًا قَتَلْتُكُمَا ، قَالَ : فَلِذَلِكَ قَتَلْتُهُ ، قَالَ  أَبُو وَائِلٍ  : وَكَانَ الرَّجُلُ يَوْمَئِذٍ كَافِرًا  .         [9/32]","","Musnad Abi Ya'la al-Mawsili 5097","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن سلام بن سليمان المزني عن إبراهيم بن الحجاج السامي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5100","132 - (  5098  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  أَبُو شِهَابٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَيُّ الذَّنْبِ عِنْدَ اللهِ         [9/33]      أَكْبَرُ ؟ قَالَ : أَنْ تَجْعَلَ لِلهِ  نِدًّا  وَهُوَ خَلَقَكَ  ، قَالَ : ثُمَّ أَيُّ ؟ قَالَ : ثُمَّ تُزَانِيَ  حَلِيلَةَ  جَارِكَ ، قَالَ : فَأَنْزَلَ اللهُ تَصْدِيقَهَا :         {      وَالَّذِينَ لا يَدْعُونَ مَعَ اللهِ إِلَهًا آخَرَ وَلا يَقْتُلُونَ النَّفْسَ الَّتِي حَرَّمَ اللهُ إِلا بِالْحَقِّ وَلا يَزْنُونَ         }      .         [9/34]             [9/35]","","Musnad Abi Ya'la al-Mawsili 5098","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن عبد ربه بن نافع الحناط عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5101","133 - (  5099  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  أَبُو شِهَابٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَوَّلُ مَا يُقْضَى يَوْمَ الْقِيَامَةِ بَيْنَ النَّاسِ فِي الدِّمَاءِ  .         [9/36]","","Musnad Abi Ya'la al-Mawsili 5099","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن عبد ربه بن نافع الحناط عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5102","134 - (  5100  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنِ  الْحَارِثِ بْنِ سُوَيْدٍ ،         [9/37]      حَدَّثَنَا  عَبْدُ اللهِ حَدِيثَيْنِ : أَحَدَهُمَا عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَالْآخَرَ عَنْ نَفْسِهِ ، قَالَ :  إِنَّ الْمُؤْمِنَ يَرَى ذُنُوبَهُ كَأَنَّهُ قَاعِدٌ تَحْتَ جَبَلٍ يَخَافُ أَنْ يَقَعَ عَلَيْهِ ، وَإِنَّ الْفَاجِرَ لَيَرَى ذُنُوبَهُ كَذُبَابٍ مَرَّ عَلَى أَنْفِهِ قَالَ لَهُ هَكَذَا .  قَالَ : وَقَالَ :  لَلَّهُ أَفْرَحُ بِتَوْبَةِ الْعَبْدِ مِنْ رَجُلٍ نَزَلَ بِدَوِّيَّةٍ مَهْلَكَةٍ عَلَيْهِ ، مَعَهُ رَاحِلَتُهُ عَلَيْهَا طَعَامُهُ وَشَرَابُهُ  فَوَضَعَ رَأْسَهُ فَنَامَ نَوْمَةً فَاسْتَيْقَظَ وَقَدْ ذَهَبَتْ رَاحِلَتُهُ عَلَيْهَا طَعَامُهُ وَشَرَابُهُ ، فَانْطَلَقَ فِي طَلَبِهَا حَتَّى  اشْتَدَّ عَلَيْهِ الْعَطَشُ أَوِ الْجُوعُ  -  أَبُو شِهَابٍ  شَكَّ  - قَالَ : أَرْجِعُ إِلَى مَكَانِي فَأَمُوتُ فِيهِ ، فَرَجَعَ إِلَى مَكَانِهِ فَوَضَعَ رَأْسَهُ فَاسْتَيْقَظَ فَإِذَا هُوَ بِرَاحِلَتِهِ عِنْدَهُ ، وَعَلَيْهَا طَعَامُهُ وَشَرَابُهُ  .         [9/38]             [9/39]","","Musnad Abi Ya'la al-Mawsili 5100","","عبد الله بن مسعود عن الحارث بن سويد الأعور عن عمارة بن عمير التيمي عن الأعمش عن عبد ربه بن نافع الحناط عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5103","135 - (  5101  ) -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ أَبُو الْفَضْلِ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُكَبِّرُ فِي كُلِّ         [9/40]      رَفْعٍ وَوَضْعٍ  ، وَقِيَامٍ وَقُعُودٍ  ،  وَأَبُو بَكْرٍ  ،  وَعُمَرُ  .","","Musnad Abi Ya'la al-Mawsili 5101","","عبد الله بن مسعود عن عبد الرحمن بن الأسود النخعي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5104","136 - (  5102  ) -  وَعَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُسَلِّمُ عَنْ يَمِينِهِ ، وَعَنْ شِمَالِهِ  : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، حَتَّى يُرَى بَيَاضُ خَدَّيْهِ  .","","Musnad Abi Ya'la al-Mawsili 5102","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5105","137 - (  5103  ) -  حَدَّثَنَا  الْعَبَّاسُ ،  حَدَّثَنَا  أَبُو الْأَحْوَصِ ،  حَدَّثَنَا  مَنْصُورُ بْنُ الْمُعْتَمِرِ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ،  عَنْ  عَبِيدَةَ السَّلْمَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَيْرُ أُمَّتِي الْقَرْنُ الَّذِينَ يَلُونِي ، ثُمَّ الَّذِينَ يَلُونَهُمْ  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ،         [9/41]      ثُمَّ يَجِيءُ قَوْمٌ تَسْبِقُ شَهَادَةُ أَحَدِهِمْ يَمِينَهُ ، وَيَمِينُهُ شَهَادَتَهُ ، قَالَ : فَقَالَ  إِبْرَاهِيمُ  : كُنَّا نُنْهَى أَنْ نَحْلِفَ بِالْعَهْدِ وَالشَّهَادَاتِ  .","","Musnad Abi Ya'la al-Mawsili 5103","","عبد الله بن مسعود عن عبيدة بن عمرو السلماني عن إبراهيم النخعي عن منصور بن المعتمر عن سلام بن سليم الحنفي عن العباس بن الوليد النرسي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5106","138 - (  5104  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادٍ ،  حَدَّثَنَا  ابْنُ أَبِي         [9/42]      غَنِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ مِنَ الشِّعْرِ  حِكْمَةً  .","","Musnad Abi Ya'la al-Mawsili 5104","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عبد الملك بن حميد الخزاعي عن يحيى بن عبد الملك بن حميد عن الحسن بن حماد الوراق عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5107","139 - (  5105  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  حَدَّثَنَا  أَبُو الْجَوَّابِ ،  حَدَّثَنَا  سُلَيْمَانُ بْنُ قَرْمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ رَجُلٌ كَثِيرَ الْمَالِ ، لَمَّا حَضَرَهُ الْمَوْتُ ، قَالَ لِأَهْلِهِ : إِنْ فَعَلْتُمْ مَا أَمَرْتُكُمْ بِهِ ، أَوْرَثْتُكُمْ مَالًا كَثِيرًا  ، قَالُوا : نَعَمْ ،         [9/43]      قَالَ : إِذَا مُتُّ فَاحْرِقُونِي ، ثُمَّ اطْحَنُونِي ، فَإِذَا كَانَ يَوْمُ رِيحٍ ، فَارْتَقُوا فَوْقَ قُلَّةِ جَبَلٍ فَاذْرُونِي ، فَإِنَّ اللهَ إِنْ قَدَرَ عَلَيَّ لَمْ يَغْفِرْ لِي ، فَفُعِلَ ذَلِكَ بِهِ ، فَاجْتَمَعَ فِي يَدَيِ اللهِ ، فَقَالَ : مَا حَمَلَكَ عَلَى مَا صَنَعْتَ ؟ قَالَ : يَا رَبِّ مَخَافَتُكَ ، قَالَ : فَاذْهَبْ فَقَدْ غَفَرْتُ لَكَ  .","","Musnad Abi Ya'la al-Mawsili 5105","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن سليمان بن قرم الضبي عن أحوص بن جواب الضبي عن محمد بن عبد الله بن نمير عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5108","140 - (  5106  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الصَّمَدِ ،  حَدَّثَنَا  مَنْصُورٌ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ  رَجُلًا  جَاءَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  إِنَّ فُلَانًا نَامَ الْبَارِحَةَ عَنِ الصَّلَاةِ  ، قَالَ :  بَالَ  الشَّيْطَانُ فِي  أُذُنِهِ - أَوْ أُذُنَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 5106","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن عبد العزيز بن عبد الصمد العمي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5109","141 - (  5107  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ ،  حَدَّثَنَا  مَنْصُورٌ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،         [9/44]      عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَشَدَّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ الْمُصَوِّرُونَ  .","","Musnad Abi Ya'la al-Mawsili 5107","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن عبد العزيز بن عبد الصمد العمي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5110","142 - (  5108  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي قَيْسٍ ،  عَنْ  هُزَيْلٍ ،  أَنَّ  أَبَا مُوسَى ، وَسَلْمَانَ بْنَ رَبِيعَةَ سُئِلَا عَنِ ابْنَةٍ ، وَابْنَةِ ابْنٍ ، وَأُخْتٍ ، فَقَالَا : لِلْأُخْتِ النِّصْفُ ، وَلِلِابْنَةِ النِّصْفُ  ،         [9/45]      فَسُئِلَ  عَبْدُ اللهِ ، فَقَالَ : لَقَدْ ضَلَلْتُ إِذًا وَمَا أَنَا مِنَ الْمُهْتَدِينَ ، أَقُولُ كَمَا قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِلِابْنَةِ النِّصْفُ ، وَلِابْنَةِ الِابْنِ السُّدُسُ تَكْمِلَةُ الثُّلُثَيْنِ ، وَمَا بَقِيَ فَلِلْأُخْتِ  .         [9/46]","","Musnad Abi Ya'la al-Mawsili 5108","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن سفيان الثوري عن يحيى القطان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5111","143 - (  5109  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  فِطْرِ بْنِ خَلِيفَةَ ،  عَنْ  عَطَاءٍ ، قَالَ :  قَالَ  أَبُو الدَّرْدَاءِ :  لَقَدْ تَرَكَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَا فِي السَّمَاءِ طَيْرٌ يَطِيرُ بِجَنَاحِهِ إِلَّا ذَكَّرَنَا مِنْهُ عِلْمًا  .","","Musnad Abi Ya'la al-Mawsili 5109","","أبو الدرداء عن عطاء بن أبي رباح عن فطر بن خليفة عن يحيى القطان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5112","144 - (  5110  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  يُونُسُ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  قَدِمْنَا مَعَ عَبْدِ اللهِ عَلَى  عُثْمَانَ  ، فَقَالَ  عُثْمَانُ  لِعَبْدِ اللهِ  : مَا بَقِيَ مِنْكَ لِلنِّسَاءِ ؟ قَالَ : ادْنُ يَا  عَلْقَمَةَ  - وَكُنْتُ شَابًّا - فَدَنَوْتُ ، فَقَالَ : خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى فِتْيَةٍ عُزَّابٍ ، فَقَالَ :  مَنْ كَانَ مِنْكُمْ ذَا         [9/47]      طَوْلٍ فَلْيَتَزَوَّجْ  ، فَإِنَّهُ أَغَضُّ لِلْبَصَرِ ، وَأَحْصَنُ لِلْفَرْجِ ، وَمَنْ لَا فَالصَّوْمُ لَهُ  وِجَاءٌ  .         [9/48]","","Musnad Abi Ya'la al-Mawsili 5110","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن زياد بن كليب عن يونس بن عبيد عن يزيد بن زريع العيشي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5113","145 - (  5111  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  خَالِدٌ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لِيَلِنِي مِنْكُمْ أُولُو  الْأَحْلَامِ  وَالنُّهَى  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، وَلَا  تَخْتَلِفُوا  فَتَخْتَلِفَ  قُلُوبُكُمْ ، وَإِيَّاكُمْ  وَهَيْشَاتِ  الْأَسْوَاقِ .","","Musnad Abi Ya'la al-Mawsili 5111","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن زياد بن كليب عن خالد الحذاء عن يزيد بن زريع العيشي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5114","146 - (  5112  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الصَّمَدِ ،  حَدَّثَنَا  مَنْصُورٌ ،  عَنْ  ذَرٍّ ،  عَنْ  وَائِلِ بْنِ مَهَانَةَ ،         [9/49]      عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَصَدَّقُوا يَا مَعْشَرَ النِّسَاءِ ، فَإِنَّكُنَّ أَكْثَرُ أَهْلِ  جَهَنَّمَ  يَوْمَ الْقِيَامَةِ  ، قَالَتِ  امْرَأَةٌ  لَيْسَتْ مِنْ عِلْيَةِ النِّسَاءِ : وَلِمَ نَحْنُ أَكْثَرُ أَهْلِ  جَهَنَّمَ  ؟ قَالَ : إِنَّكُنَّ تُكْثِرْنَ اللَّعْنَ وَتَكْفُرْنَ  الْعَشِيرَ  ، قَالَ  ابْنُ مَسْعُودٍ  :  مَا وَجَدْتُ نَاقِصَ الْعَقْلِ وَالدِّينِ أَغْلَبَ عَلَى الرِّجَالِ ذَوِي الْأَحْلَامِ عَلَى أُمُورِهِنَّ مِنْ هَذِهِ النِّسَاءِ  ، قِيلَ : يَا  ابْنَ مَسْعُودٍ  ، وَمَا نَقْصُ عُقُولِهِنَّ وَدِينِهِنَّ ؟ قَالَ : أَمَّا نَقْصُ عُقُولِهِنَّ : فَشَهَادَةُ امْرَأَتَيْنِ بِشَهَادَةِ رَجُلٍ ، وَأَمَّا نَقْصُ دِينِهِنَّ : فَإِنَّهُ يَأْتِي عَلَى إِحْدَاهُنَّ مَا شَاءَ اللهُ مِنْ يَوْمٍ وَلَيْلَةٍ لَا تَسْجُدُ لِلهِ فِيهِ سَجْدَةً  .         [9/50]","","Musnad Abi Ya'la al-Mawsili 5112","","عبد الله بن مسعود عن وائل بن مهانة الحضرمي عن ذر بن عبد الله المرهبي عن منصور بن المعتمر عن عبد العزيز بن عبد الصمد العمي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5115","147 - (  5113  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَنْصُورٍ ، وَسُلَيْمَانَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : أَنُؤَاخَذُ بِمَا عَمِلْنَا فِي الْجَاهِلِيَّةِ ؟ فَقَالَ :  إِنْ أَحْسَنْتَ فِي الْإِسْلَامِ لَمْ تُؤَاخَذْ بِهِ ، وَإِنْ أَسَأْتَ فِي الْإِسْلَامِ أُخِذْتَ بِالْأَوَّلِ وَالْآخِرِ  .","","Musnad Abi Ya'la al-Mawsili 5113","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن سفيان الثوري عن يحيى القطان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5116","148 - (  5114  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا تُبَاشِرِ الْمَرْأَةُ الْمَرْأَةَ تَنْعَتُهَا لِزَوْجِهَا أَوْ تَصِفُهَا لِلرَّجُلِ حَتَّى كَأَنَّهُ يَنْظُرُ إِلَيْهَا  ، وَإِنْ كَانَ ثَلَاثَةٌ فَلَا  يَتَنَاجَى  اثْنَانِ دُونَ صَاحِبِهِمَا ، فَإِنَّ ذَلِكَ يُحْزِنُهُ ،         [9/51]      وَمَنْ حَلَفَ عَلَى يَمِينٍ كَاذِبًا  لِيَقْتَطِعَ  بِهَا مَالَ أَخِيهِ أَوْ مَالَ امْرِئٍ مُسْلِمٍ ، لَقِيَ اللهَ وَهُوَ عَلَيْهِ غَضْبَانُ  ، قَالَ : فَسَمِعَ الْأَشْعَثُ بْنُ قَيْسٍ  ابْنَ مَسْعُودٍ  يَذْكُرُ هَذَا الْحَدِيثَ ، فَقَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي رَجُلَيْنِ اخْتَصَمَا فِي بِئْرٍ  .         [9/52]             [9/53]","","Musnad Abi Ya'la al-Mawsili 5114","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن حماد بن زيد عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5117","149 - (  5115  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  أَبِي وَائِلٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  تُوُفِّيَ رَجُلٌ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  أَصْحَابِ الصُّفَّةِ  ، فَتَرَكَ دِينَارَيْنِ ، فَذُكِرَ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : كَيَّتَيْنِ .","","Musnad Abi Ya'la al-Mawsili 5115","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن حماد بن زيد عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5118","150 - (  5116  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ زَيْدٍ الْوَاسِطِيُّ ،  حَدَّثَنَا  الْعَوَّامُ بْنُ حَوْشَبٍ ،  عَنْ  أَبِي مُحَمَّدٍ مَوْلَى عُمَرَ بْنِ الْخَطَّابِ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ قَدَّمَ ثَلَاثَةً لَمْ يَبْلُغُوا  الْحِنْثَ  كَانُوا لَهُ حِصْنًا حَصِينًا مِنَ النَّارِ  ، قَالَ  أَبُو ذَرٍّ  : قَدَّمْتُ اثْنَيْنِ يَا رَسُولَ اللهِ ، قَالَ : وَاثْنَيْنِ ، قَالَ  أُبَيُّ بْنُ كَعْبٍ  أَبُو الْمُنْذِرِ  سَيِّدُ الْقُرَّاءِ : قَدَّمْتُ وَاحِدًا يَا رَسُولَ اللهِ ، فَقَالَ : وَوَاحِدًا ، قَالَ : وَلَكِنَّ ذَاكَ فِي أَوَّلِ  صَدْمَةٍ  .         [9/54]","","Musnad Abi Ya'la al-Mawsili 5116","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو محمد مولى عمر بن الخطاب عن العوام بن حوشب عن أخو كرخوية محمد بن يزيد عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5119","151 - (  5117  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ دِينَارٍ ،  عَنْ  إِبْرَاهِيمَ الْهَجَرِيِّ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَحْسَنَ الصَّلَاةَ حَيْثُ يَرَاهَا النَّاسُ ، وَأَسَاءَهَا حَيْثُ يَخْلُو  ، فَتِلْكَ اسْتِهَانَةٌ اسْتَهَانَ بِهَا رَبَّهُ تَبَارَكَ وَتَعَالَى  .         [9/55]","","Musnad Abi Ya'la al-Mawsili 5117","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن محمد بن دينار الطاحي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5120","152 - (  5118  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ دِينَارٍ ،  عَنْ  إِبْرَاهِيمَ الْهَجَرِيِّ ،  عَنْ  أَبِي الْأَحْوَصِ ، قَالَ أَبُو يَعْلَى :  أَحْسَبُهُ عَنِ ابْنِ مَسْعُودٍ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْمِسْكِينُ لَيْسَ الطَّوَّافَ عَلَيْكُمُ الَّذِي تَرُدُّهُ اللُّقْمَةُ وَاللُّقْمَتَانِ  ، وَالتَّمْرَةُ وَالتَّمْرَتَانِ ، قُلْنَا : فَمَا الْمِسْكِينُ يَا رَسُولَ اللهِ ؟ قَالَ : الَّذِي لَا يَجِدُ مَا يُغْنِيهِ ، وَيَسْتَحِي أَنْ يَسْأَلَ النَّاسَ ، وَلَا يُفْطَنُ لَهُ فَيُتَصَدَّقُ عَلَيْهِ  .","","Musnad Abi Ya'la al-Mawsili 5118","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن محمد بن دينار الطاحي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5121","153 - (  5119  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ دِينَارٍ ،  عَنْ  إِبْرَاهِيمَ الْهَجَرِيِّ ،  عَنْ  أَبِي الْأَحْوَصِ ،         [9/56]      عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  سِبَابُ  الْمُسْلِمِ أَخَاهُ فُسُوقٌ ، وَقِتَالُهُ  كُفْرٌ  ،  وَحُرْمَةُ  مَالِهِ  كَحُرْمَةِ  دَمِهِ .","","Musnad Abi Ya'la al-Mawsili 5119","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن محمد بن دينار الطاحي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5122","154 - (  5120  ) -  وَبِإِسْنَادِهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِذَا أَتَى أَحَدَكُمْ خَادِمُهُ بِطَعَامِهِ فَلْيَبْدَأْ فَلْيُلْقِمْهُ أَوْ لِيُجْلِسْهُ مَعَهُ  ، فَإِنَّهُ وَلِيَ حَرَّهُ  وَدُخَانَهُ  .","","Musnad Abi Ya'la al-Mawsili 5120","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن محمد بن دينار الطاحي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5123","155 - (  5121  ) -  وَعَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  هَلْ تَدْرُونَ أَيُّ الصَّدَقَةِ أَفْضَلُ ؟  قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ : الْمِنْحَةُ أَنْ تَمْنَحَ أَخَاكَ الدَّنَانِيرَ ، أَوِ الدَّرَاهِمَ ، أَوِ الْبَقَرَةَ ، أَوِ         [9/57]      الشَّاةَ ، أَوْ ظَهْرَ الدَّابَّةِ ، أَوْ لَبَنَ الشَّاةِ ، أَوْ لَبَنَ الْبَقَرَةِ ، وَلَمْ يَقُلِ : الْبَقَرَةَ وَالشَّاةَ .","","Musnad Abi Ya'la al-Mawsili 5121","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن محمد بن دينار الطاحي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5124","156 - (  5122  ) -  وَعَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ الشَّيْطَانَ قَدْ يَئِسَ أَنْ تُعْبَدَ الْأَصْنَامُ فِي أَرْضِ الْعَرَبِ  ، وَلَكِنَّهُ         [9/58]      سَيَرْضَى مِنْكُمْ بِدُونِ ذَلِكَ بِالْمُحَقَّرَاتِ ، وَهِيَ :  الْمُوبِقَاتُ  يَوْمَ الْقِيَامَةِ ، اتَّقُوا الْمَظَالِمَ مَا اسْتَطَعْتُمْ ، فَإِنَّ الْعَبْدَ يَجِيءُ بِالْحَسَنَاتِ يَوْمَ الْقِيَامَةِ يَرَى أَنَّهُ سَتُنْجِيهِ ، فَمَا زَالَ عَبْدٌ يَقُومُ ، فَيَقُولُ : يَا رَبِّ ظَلَمَنِي عَبْدُكَ مَظْلَمَةً ، فَيَقُولُ : امْحُوا مِنْ حَسَنَاتِهِ ، مَا يَزَالُ كَذَلِكَ ، حَتَّى مَا يَبْقَى لَهُ حَسَنَةٌ مِنَ الذُّنُوبِ ، وَإِنَّ مِثْلَ ذَلِكَ كَسَفْرٍ نَزَلُوا بِفَلَاةٍ مِنَ الْأَرْضِ ، لَيْسَ مَعَهُمْ حَطَبٌ ، فَتَفَرَّقَ  الْقَوْمُ  لِيَحْتَطِبُوا ، فَلَمْ يَلْبَثُوا أَنْ حَطَبُوا ، فَأَعْظَمُوا النَّارَ ، وَطَبَخُوا مَا أَرَادُوا ، وَكَذَلِكَ الذُّنُوبُ  .         [9/59]","","Musnad Abi Ya'la al-Mawsili 5122","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن محمد بن دينار الطاحي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5125","157 - (  5123  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ دِينَارٍ ،  عَنْ  إِبْرَاهِيمَ الْهَجَرِيِّ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  مَا أَحَدٌ أَغْيَرَ مِنَ اللهِ ، وَمِنْ غَيْرَتِهِ حَرَّمَ الْفَوَاحِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ  .","","Musnad Abi Ya'la al-Mawsili 5123","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن محمد بن دينار الطاحي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5126","[9/60]      158 - (  5124  ) -  وَعَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ اللهَ يَأْمُرُ مُنَادِيًا يَوْمَ الْقِيَامَةِ : يَا  آدَمُ  قُمْ فَابْعَثْ مِنْ ذُرِّيَّتِكَ بَعْثًا إِلَى النَّارِ  ، فَيَقُومُ  آدَمُ  ، فَيَقُولُ : أَيْ رَبِّ ، مِنْ كُلِّ كَمْ ؟ فَيَقُولُ : مِنْ كُلِّ مِائَةٍ تِسْعَةً وَتِسْعِينَ إِلَى النَّارِ ، وَوَاحِدًا إِلَى الْجَنَّةِ ، فَشَقَّ ذَلِكَ عَلَى مَنْ سَمِعَ مِنْ  أَصْحَابِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالُوا لَهُ : مَنِ النَّاجِي مِنَّا بَعْدَ هَذَا ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّكُمْ فِي خَلِيقَتَيْنِ مِنَ النَّاسِ :  يَأْجُوجَ  ،  وَمَأْجُوجَ  ، وَهُمْ مِنْ كُلِّ حَدَبٍ يَنْسِلُونَ ، وَمَا أَنْتُمْ فِي الدُّنْيَا إِلَّا  كَالرَّقْمَةِ  فِي ذِرَاعِ الدَّابَّةِ ، أَوْ كَالشَّعْرَةِ فِي جَنْبِ الْبَعِيرِ  .","","Musnad Abi Ya'la al-Mawsili 5124","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن محمد بن دينار الطاحي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5127","159 - (  5125  ) -  وَعَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الْأَيْدِي ثَلَاثَةٌ  : فَيَدُ اللهِ تَعَالَى  الْعُلْيَا  ، وَيَدُ الْمُعْطِي الَّتِي تَلِيهَا ،         [9/61]      وَيَدُ السَّائِلِ السُّفْلَى إِلَى يَوْمِ الْقِيَامَةِ ، فَاسْتَعِفَّ عَنِ السُّؤَالِ وَعَنِ الْمَسْأَلَةِ مَا اسْتَطَعْتَ ، فَإِنْ أُعْطِيتَ  شَيْئًا - أَوْ قَالَ : خَيْرًا -  فَلْيُرَ عَلَيْكَ ، وَابْدَأْ بِمَنْ  تَعُولُ ،  وَارْضَخْ مِنَ الْفَضْلِ ، وَلَا تُلَامُ عَلَى الْعَفَافِ .         [9/62]","","Musnad Abi Ya'la al-Mawsili 5125","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن محمد بن دينار الطاحي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5128","160 - (  5126  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  نَضَّرَ  اللهُ امْرَأً سَمِعَ مِنَّا حَدِيثًا فَحَفِظَهُ حَتَّى يُبَلِّغَهُ  .         [9/63]","","Musnad Abi Ya'la al-Mawsili 5126","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن شعبة بن الحجاج عن يحيى القطان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5129","161 - (  5127  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  زُهَيْرِ بْنِ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كُنْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَتَى الْغَائِطَ ، فَقَالَ : الْتَمِسُوا لِي ثَلَاثَةَ أَحْجَارٍ  ، فَلَمْ أَجِدْ إِلَّا حَجَرَيْنِ  وَرَوْثَةً  ، فَأَخَذَ الْحَجَرَيْنِ وَرَدَّ  الرَّوْثَةَ  ، وَقَالَ : هَذِهِ  رِجْسٌ  .         [9/64]","","Musnad Abi Ya'la al-Mawsili 5127","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن يحيى القطان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5130","162 - (  5128  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَحْيَى ، وَمُعَاذُ بْنُ مُعَاذٍ ،  عَنْ  زُهَيْرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ، وَعَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ،  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُكَبِّرُ فِي كُلِّ خَفْضٍ ، وَرَفْعٍ ، وَقِيَامٍ  ، وَقُعُودٍ ، وَيُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، حَتَّى يُرَى بَيَاضُ خَدِّهِ ، وَكَانَ  أَبُو بَكْرٍ  وَعُمَرُ  يَفْعَلَانِ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 5128","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن يحيى القطان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5131","163 - (  5129  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ عُيَيْنَةَ ،  حَدَّثَنَا  عَبْدُ الْكَرِيمِ الْجَزَرِيُّ ،  عَنْ  زِيَادِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَعْقِلٍ  ، قَالَ :  دَخَلْتُ مَعَ أَبِي عَلَى عَبْدِ اللهِ بْنِ مَسْعُودٍ ، فَقَالَ : أَنْتَ سَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  النَّدَمُ تَوْبَةٌ  ؟ قَالَ : نَعَمْ  .","","Musnad Abi Ya'la al-Mawsili 5129","","عبد الله بن مسعود عن عبد الله بن معقل بن مقرن المزني عن زياد بن أبي مريم الجزري عن عبد الكريم الاصطخري عن سفيان بن عيينة عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5132","164 - (  5130  ) -  حَدَّثَنَا  زُهَيْرُ بْنُ حَرْبٍ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَمْرِو بْنِ شُرَحْبِيلَ ،         [9/65]      عَنْ  عَبْدِ اللهِ ، قَالَ :  سَأَلْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّ الذَّنْبِ أَعْظَمُ عِنْدَ اللهِ ؟ قَالَ : أَنْ تَجْعَلَ لِلهِ  نِدًّا  وَهُوَ خَلَقَكَ  ، قَالَ : قُلْتُ : إِنَّ ذَلِكَ لَعَظِيمٌ ، قَالَ : قُلْتُ : ثُمَّ أَيُّ ؟ قَالَ : أَنْ تَقْتُلَ وَلَدَكَ مَخَافَةَ أَنْ يَطْعَمَ مَعَكَ ، قَالَ : قُلْتُ : ثُمَّ أَيُّ ؟ قَالَ : أَنْ تُزَانِيَ  حَلِيلَةَ  جَارِكَ  .","","Musnad Abi Ya'la al-Mawsili 5130","","عبد الله بن مسعود عن عمرو بن شرحبيل الهمداني عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5133","165 - (  5131  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  قَالَ أُنَاسٌ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَنُؤَاخَذُ بِمَا عَمِلْنَا فِي الْجَاهِلِيَّةِ ؟ قَالَ :  أَمَّا مَنْ أَحْسَنَ مِنْكُمْ فِي الْإِسْلَامِ فَلَا يُؤَاخَذُ بِهَا  ، وَمَنْ أَسَاءَ أُخِذَ بِعَمَلِهِ فِي الْجَاهِلِيَّةِ وَالْإِسْلَامِ .","","Musnad Abi Ya'la al-Mawsili 5131","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5134","166 - (  5132  ) -  وَبِإِسْنَادِهِ  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا كُنْتُمْ ثَلَاثَةً فَلَا  يَتَنَاجَى  رَجُلَانِ دُونَ الْآخَرِ حَتَّى تَخْتَلِطُوا بِالنَّاسِ  ، مِنْ  أَجْلِ  أَنَّ ذَلِكَ يُحْزِنُهُ ، وَلَا تُبَاشِرِ الْمَرْأَةُ الْمَرْأَةَ فَتَصِفَهَا لِزَوْجِهَا ، حَتَّى كَأَنَّهُ يَنْظُرُ إِلَيْهَا .         [9/66]","","Musnad Abi Ya'la al-Mawsili 5132","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5135","167 - (  5133  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ :  لَمَّا كَانَ  يَوْمُ حُنَيْنٍ  آثَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْغَنِيمَةِ ، فَأَعْطَى  الْأَقْرَعَ بْنَ حَابِسٍ  مِائَةً مِنَ الْإِبِلِ وَأَعْطَى  عُيَيْنَةَ  مِثْلَ ذَلِكَ ، وَأَعْطَى نَاسًا مِنْ أَشْرَافِ الْعَرَبِ ، وَآثَرَهُمْ فِي الْقِسْمَةِ ، فَقَالَ رَجُلٌ : وَاللهِ إِنَّ هَذِهِ لَقِسْمَةٌ مَا عُدِلَ فِيهَا ، وَمَا أُرِيدَ بِهَا وَجْهُ اللهِ ، قَالَ : فَقُلْتُ : وَاللهِ لَأُخْبِرَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَتَيْتُهُ فَأَخْبَرْتُهُ بِمَا قَالَ الرَّجُلُ ، قَالَ : فَتَغَيَّرَ وَجْهُهُ حَتَّى كَانَ  كَالصِّرْفِ  ، ثُمَّ قَالَ :  فَمَنْ يَعْدِلُ إِذَا لَمْ يَعْدِلْ رَسُولُ اللهِ ؟ ثُمَّ قَالَ : يَرْحَمُ اللهُ  مُوسَى  ، لَقَدْ أُوذِيَ بِأَكْثَرَ مِنْ هَذَا فَصَبَرَ ، فَقُلْتُ : لَا  جَرَمَ  ، لَا أَرْفَعُ إِلَيْهِ بَعْدَ هَذَا شَيْئًا  .         [9/67]","","Musnad Abi Ya'la al-Mawsili 5133","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5136","168 - (  5134  ) -  وَعَنْ  أَبِي وَائِلٍ ، قَالَ : قَالَ عَبْدُ اللهِ :  لَقَدْ أَتَانِي الْيَوْمَ رَجُلٌ ، فَسَأَلَنِي عَنْ أَمْرٍ مَا دَرَيْتُ مَا أَرُدُّ عَلَيْهِ ، فَقَالَ : أَرَأَيْتَ رَجُلًا  مُؤْدِيًا  نَشِيطًا ، يَخْرُجُ فِي الْمَغَازِي ،  فَيَعْزِمُونَ  عَلَيْنَا فِي أَشْيَاءَ لَا نَجِدُ مِنْهَا بُدًّا ، قَالَ : فَقُلْتُ لَهُ : وَاللهِ مَا أَدْرِي مَا أَقُولُ لَكَ ،  إِلَّا أَنَّا كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَعَسَى أَنْ لَا  يَعْزِمَ  عَلَيْنَا فِي الْأَمْرِ إِلَّا مَرَّةً حَتَّى نَفْعَلَهُ  ، وَإِنَّ أَحَدَكُمْ لَنْ يَزَالَ بِخَيْرٍ مَا اتَّقَى اللهَ ، وَإِذَا شَكَّ فِي نَفْسِهِ شَيْئًا         [9/68]      سَأَلَ رَجُلًا فَشَفَاهُ ، وَأَوْشَكَ أَنْ لَا تَجِدُوهُ ، وَالَّذِي لَا إِلَهَ إِلَّا هُوَ ، مَا أَذْكُرُ مَا غَبَرَ مِنَ الدُّنْيَا إِلَّا  كَالثَّغَبِ  ، شُرِبَ صَفْوُهُ وَبَقِيَ كَدَرُهُ  .","","Musnad Abi Ya'la al-Mawsili 5134","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5137","169 - (  5135  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ يَعْنِي ابْنَ عَبْدِ الْحَمِيدِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كُنَّا نَقُولُ فِي الصَّلَاةِ خَلْفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : سَلَامٌ عَلَى فُلَانٍ ، فَقَالَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ :  إِنَّ اللهَ هُوَ السَّلَامُ ، فَإِذَا قَعَدَ أَحَدُكُمْ فِي الصَّلَاةِ فَلْيَقُلِ :  التَّحِيَّاتُ  لِلهِ ، وَالصَّلَوَاتُ  وَالطَّيِّبَاتُ  ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ ، سَلَامٌ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ - فَإِذَا قَالَهَا أَصَابَتْ كُلَّ عَبْدٍ فِي السَّمَاءِ وَالْأَرْضِ صَالِحٍ - أَشْهَدُ أَنْ لَا إِلَهَ         [9/69]      إِلَّا اللهُ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، ثُمَّ يَتَخَيَّرُ مِنَ الْمَسْأَلَةِ مَا شَاءَ  .","","Musnad Abi Ya'la al-Mawsili 5135","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5138","170 - (  5136  ) -  وَبِإِسْنَادِهِ  عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  بِئْسَ مَا لِأَحَدِكُمْ أَنْ يَقُولَ :  نَسِيتُ  آيَةَ كَذَا  وَكَيْتَ  ، بَلْ هُوَ نُسِّيَ  ، اسْتَذْكِرُوا الْقُرْآنَ فَلَهُوَ أَشَدُّ  تَفَصِّيًا  مِنْ صُدُورِ الرِّجَالِ مِنَ النَّعَمِ لِعُقُلِهِ  .         [9/70]","","Musnad Abi Ya'la al-Mawsili 5136","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5139","171 - (  5137  ) -  وَعَنْ  أَبِي وَائِلٍ ، قَالَ :  كَانَ عَبْدُ اللهِ يُذَكِّرُ النَّاسَ فِي كُلِّ يَوْمِ خَمِيسٍ  ، فَقَالَ لَهُ  رَجُلٌ  : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، لَوْ أَنَّكَ ذَكَّرْتَنَا فِي كُلِّ يَوْمٍ ؟ قَالَ : أَمَا إِنَّهُ يَمْنَعُنِي مِنْ ذَلِكَ أَنْ أَكْرَهَ أَنْ أُمِلَّكُمْ ، وَإِنِّي  أَتَخَوَّلُكُمْ         [9/71]      بِالْمَوْعِظَةِ كَمَا  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَتَخَوَّلُنَا  بِالْمَوْعِظَةِ فِي الْأَيَّامِ مَخَافَةَ السَّآمَةِ عَلَيْنَا  .","","Musnad Abi Ya'la al-Mawsili 5137","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5140","172 - (  5138  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الصِّدْقَ يَهْدِي إِلَى  الْبِرِّ  ، وَإِنَّ  الْبِرَّ  يَهْدِي إِلَى الْجَنَّةِ  ، وَإِنَّ الرَّجُلَ لَيَصْدُقُ حَتَّى يُكْتَبَ صِدِّيقًا ، وَإِنَّ الْكَذِبَ يَهْدِي إِلَى  الْفُجُورِ  ، وَإِنَّ  الْفُجُورَ  يَهْدِي إِلَى النَّارِ ، وَإِنَّ الرَّجُلَ لَيَكْذِبُ حَتَّى يُكْتَبَ عِنْدَ اللهِ كَذَّابًا  .         [9/72]","","Musnad Abi Ya'la al-Mawsili 5138","","عبد الله بن مسعود عن شقيق بن سلمة عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5141","173 - (  5139  ) -  وَعَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبِيدَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي لَأَعْلَمُ آخِرَ أَهْلِ النَّارِ خُرُوجًا مِنْهَا ، وَآخِرَ أَهْلِ الْجَنَّةِ دُخُولًا الْجَنَّةَ  ، رَجُلًا يَخْرُجُ مِنَ النَّارِ  حَبْوًا  ، فَيَقُولُ اللهُ : اذْهَبْ فَادْخُلِ الْجَنَّةَ ، فَيَأْتِيهَا فَيُخَيَّلُ إِلَيْهِ أَنَّهَا مَلْأَى ، فَيَقُولُ اللهُ : ادْخُلْ فَإِنَّ لَكَ مِثْلَ الدُّنْيَا عَشْرَ أَمْثَالِهَا ، قَالَ : فَيَقُولُ :  أَتَسْخَرُ  بِي - أَوْ تَضْحَكُ بِي -  وَأَنْتَ الْمَلِكُ ؟ قَالَ : ثُمَّ رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ – ضَحِكَ حَتَّى بَدَتْ  نَوَاجِذُهُ ،  قَالَ : فَكَانَ يُقَالُ : ذَاكَ أَدْنَى أَهْلِ الْجَنَّةِ مَنْزِلًا  .         [9/73]","","Musnad Abi Ya'la al-Mawsili 5139","","عبد الله بن مسعود عن عبيدة بن عمرو السلماني عن إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5142","174 - (  5140  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبِيدَةَ السَّلْمَانِيِّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَيُّ النَّاسِ خَيْرٌ ؟ قَالَ :  قَرْنِي  ، ثُمَّ الَّذِينَ يَلُونَهُمْ  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ يَجِيءُ قَوْمٌ تَبْدُرُ شَهَادَةُ أَحَدِهِمْ يَمِينَهُ ، وَيَبْدُرُ يَمِينُهُ شَهَادَتَهُ ، قَالَ  إِبْرَاهِيمُ  : كَانُوا يَنْهَوْنَنَا وَنَحْنُ صِبْيَانٌ عَنِ الْعَهْدِ وَالشَّهَادَاتِ  .","","Musnad Abi Ya'la al-Mawsili 5140","","عبد الله بن مسعود عن عبيدة بن عمرو السلماني عن إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5143","175 - (  5141  ) -  وَعَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  لَعَنَ اللهُ  الْوَاشِمَاتِ  ، وَالْمُسْتَوْشِمَاتِ وَالْمُتَنَمِّصَاتِ ،  وَالْمُتَفَلِّجَاتِ  لِلْحُسْنِ  ، الْمُغَيِّرَاتِ خَلْقَ اللهِ ، قَالَ : فَبَلَغَ ذَلِكَ امْرَأَةً مِنْ  بَنِي أَسَدٍ  يُقَالُ لَهَا :  أُمُّ يَعْقُوبَ  كَانَتْ تَقْرَأُ الْقُرْآنَ ، فَأَتَتْ فَقَالَتْ : مَا حَدِيثٌ بَلَغَنِي عَنْكَ أَنَّكَ لَعَنْتَ  الْوَاشِمَاتِ  ، وَالْمُسْتَوْشِمَاتِ ، وَالْمُتَنَمِّصَاتِ ،  وَالْمُتَفَلِّجَاتِ         [9/74]      لِلْحُسْنِ ، الْمُغَيِّرَاتِ خَلْقَ اللهِ ؟ فَقَالَ  عَبْدُ اللهِ  : مَا لِي لَا أَلْعَنُ مِنْ لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَهُوَ فِي كِتَابِ اللهِ ؟ قَالَتِ الْمَرْأَةُ : لَقَدْ قَرَأْتُ مَا بَيْنَ لَوْحَيِ الْمُصْحَفِ فَمَا وَجَدْتُهُ ، فَقَالَ : وَاللهِ لَئِنْ كُنْتِ قَرَأْتِهِ لَقَدْ وَجَدْتِهِ ، ثُمَّ قَالَ :         {      وَمَا آتَاكُمُ الرَّسُولُ فَخُذُوهُ وَمَا نَهَاكُمْ عَنْهُ فَانْتَهُوا         }      قَالَتِ الْمَرْأَةُ : فَإِنِّي أَرَى مِنْ هَذَا شَيْئًا عَلَى امْرَأَتِكَ ، قَالَ : فَاذْهَبِي فَانْظُرِي ، قَالَ : فَدَخَلَتْ عَلَى  امْرَأَةِ عَبْدِ اللهِ  فَلَمْ تَرَ شَيْئًا ، فَجَاءَتْ إِلَيْهِ فَقَالَتْ : مَا رَأَيْتُ شَيْئًا ، قَالَ : أَمَا لَوْ كَانَ ذَلِكَ لَمْ نُجَامِعْهَا  .         [9/75]             [9/76]","","Musnad Abi Ya'la al-Mawsili 5141","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5144","176 - (  5142  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  حَدَّثَنَا  مَنْصُورٌ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَاةً ، قَالَ  إِبْرَاهِيمُ  :  لَا أَدْرِي أَزَادَ أَمْ نَقَصَ  ، فَلَمَّا سَلَّمَ ، قِيلَ لَهُ : يَا رَسُولَ اللهِ ، أَحَدَثَ فِي الصَّلَاةِ شَيْءٌ ؟ قَالَ : لَا ، وَمَا ذَاكَ ؟ قَالُوا : صَلَّيْتَ كَذَا وَكَذَا ، قَالَ : فَثَنَى رِجْلَهُ ، وَاسْتَقْبَلَ الْقِبْلَةَ ، وَسَجَدَ سَجْدَتَيْنِ ، ثُمَّ سَلَّمَ ، فَلَمَّا سَلَّمَ أَقْبَلَ عَلَيْنَا بِوَجْهِهِ ، فَقَالَ : إِنَّهُ لَوْ حَدَثَ فِي الصَّلَاةِ شَيْءٌ أَنْبَأْتُكُمْ بِهِ ، وَلَكِنِّي إِنَّمَا أَنَا بَشَرٌ مِثْلُكُمْ ، أَنْسَى كَمَا تَنْسَوْنَ ، فَإِذَا نَسِيتُ فَذَكِّرُونِي ، وَإِذَا شَكَّ أَحَدُكُمْ فِي الصَّلَاةِ  فَلْيَتَحَرَّ  الصَّوَابَ فَلْيُتِمَّ عَلَيْهِ ، ثُمَّ يُسَلِّمُ ، ثُمَّ يَسْجُدُ سَجْدَتَيْنِ  .         [9/77]","","Musnad Abi Ya'la al-Mawsili 5142","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5145","177 - (  5143  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْكُمْ مِنْ أَحَدٍ إِلَّا وَقَدْ وُكِّلَ بِهِ قَرِينٌ مِنَ الْجِنِّ  ، قَالُوا : وَإِيَّاكَ يَا رَسُولَ اللهِ ؟ قَالَ : وَإِيَّايَ ، إِلَّا أَنَّ اللهَ أَعَانَنِي عَلَيْهِ  فَأَسْلَمَ  ، فَلَا يَأْمُرُنِي إِلَّا بِخَيْرٍ  .","","Musnad Abi Ya'la al-Mawsili 5143","","عبد الله بن مسعود عن رافع الغطفاني عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5146","178 - (  5144  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  ذَرٍّ ،  عَنْ  وَائِلِ بْنِ مَهَانَةَ مِنَ التَّيْمِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا مَعْشَرَ النِّسَاءِ ، تَصَدَّقْنَ وَلَوْ مِنْ حُلِيِّكُنَّ ، فَإِنَّكُنَّ أَكْثَرُ أَهْلِ  جَهَنَّمَ  ، فَقَالَتِ  امْرَأَةٌ  لَيْسَتْ مِنْ عِلْيَةِ النِّسَاءِ : وَلِمَ نَحْنُ يَا رَسُولَ اللهِ أَكْثَرُ أَهْلِ  جَهَنَّمَ  ؟ قَالَ : مِنْ أَجْلِ أَنَّكُنَّ تُكْثِرْنَ اللَّعْنَ ، وَتَكْفُرْنَ  الْعَشِيرَ  .         [9/78]","","Musnad Abi Ya'la al-Mawsili 5144","","عبد الله بن مسعود عن وائل بن مهانة الحضرمي عن ذر بن عبد الله المرهبي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5147","179 - (  5145  ) -  وَعَنْ  مَنْصُورٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لَمَّا رَأَى مِنَ النَّاسِ إِدْبَارًا ، قَالَ : اللَّهُمَّ سَبْعٌ كَسَبْعِ  يُوسُفَ  ، فَأَخَذَتْهُمْ سَنَةٌ  حَصَّتْ  كُلَّ شَيْءٍ  ، حَتَّى أَكَلُوا لَحْمَ الْمَيْتَةِ وَالْجُلُودَ وَالْجِيَفَ ، وَيَنْظُرُ إِلَى السَّمَاءِ أَحَدُهُمْ فَيَرَى الدُّخَانَ مِنَ الْجُوعِ ، فَأَتَاهُ  أَبُو سُفْيَانَ  ، فَقَالَ : يَا  مُحَمَّدُ  ، إِنَّكَ جِئْتَ تَأْمُرُ بِطَاعَةِ اللهِ ، وَبِصِلَةِ الرَّحِمِ ، فَإِنَّ قَوْمَكَ قَدْ هَلَكُوا ، فَادْعُ اللهَ لَهُمْ ، قَالَ اللهُ :         {      فَارْتَقِبْ يَوْمَ تَأْتِي السَّمَاءُ بِدُخَانٍ مُبِينٍ         }      إِلَى قَوْلِهِ :         {      إِنَّا مُنْتَقِمُونَ         }      .         [9/79]","","Musnad Abi Ya'la al-Mawsili 5145","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5148","180 - (  5146  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ، قَالَ : ذَكَرَ شِبَاكٌ  لِإِبْرَاهِيمَ  ، قَالَ :  سَأَلْنَا  عَلْقَمَةَ ، عَنْ ذَلِكَ ،  فَحَدَّثَنَا  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  آكِلَ  الرِّبَا ، وَمُوكِلَهُ  ، قَالَ : فَقُلْتُ : وَشَاهِدَيْهِ وَكَاتِبَهُ ، قَالَ : إِنَّمَا نُحَدِّثُ مَا سَمِعْنَا .","","Musnad Abi Ya'la al-Mawsili 5146","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن شباك الضبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5149","181 - (  5147  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  قَالَ  هُنَيٌّ الضَّبِّيُّ :  لَقِينَا  عَلْقَمَةَ - وَقَدْ         [9/80]      مَثَّلَ  زِيَادٌ  بِرَجُلٍ صَلَبَهُ - فَقَالَ لَنَا : عَلَامَ اجْتَمَعَ هَؤُلَاءِ ؟ قُلْتُ : مَثَّلَ  زِيَادٌ  بِرَجُلٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيمَا أَحْسَبُ - :  إِنَّ أَعَفَّ النَّاسِ  قِتْلَةً  أَهْلُ الْإِيمَانِ  .","","Musnad Abi Ya'la al-Mawsili 5147","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن هني بن نويرة الضبي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5150","182 - (  5148  ) -  وَعَنْ  مُغِيرَةَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الْوَلَدُ لِصَاحِبِ  الْفِرَاشِ  ،  وَلِلْعَاهِرِ  الْحَجَرُ  .","","Musnad Abi Ya'la al-Mawsili 5148","","عبد الله بن مسعود عن شقيق بن سلمة عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5151","183 - (  5149  ) -  وَعَنْ  مُغِيرَةَ ،  عَنْ  وَاصِلِ بْنِ حَيَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ كُنْتُ مُتَّخِذًا مِنْ أَهْلِ الْأَرْضِ  خَلِيلًا ،  لَاتَّخَذْتُ  أَبَا بَكْرِ بْنَ أَبِي قُحَافَةَ  خَلِيلًا  ، وَلَكِنَّ صَاحِبَكُمْ  خَلِيلُ  اللهِ ،         [9/81]      وَإِنَّ الْقُرْآنَ نَزَلَ عَلَى سَبْعَةِ  أَحْرُفٍ  ، لِكُلِّ آيَةٍ مِنْهَا  ظَهْرٌ         [9/82]      وَبَطْنٌ ،  وَلِكُلِّ حَدٍّ مَطْلَعٌ  .         [9/83]             [9/84]","","Musnad Abi Ya'la al-Mawsili 5149","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عبد الله بن أبي الهذيل الغنوي عن واصل بن حيان الأحدب عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5152","184 - (  5150  ) -  وَعَنْ  جَرِيرٍ ،  عَنْ  حُصَيْنٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  أَبِي حَيَّانَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اقْرَأْ عَلَيَّ ، قُلْتُ : أَلَيْسَ تَعَلَّمْتُ مِنْكَ يَا رَسُولَ اللهِ ؟ قَالَ : إِنِّي أُحِبُّ أَنْ أَسْمَعَهُ مِنْ غَيْرِي  ، فَقَرَأْتُ عَلَيْهِ سُورَةَ النِّسَاءِ حَتَّى إِذَا بَلَغْتُ :         {      فَكَيْفَ إِذَا جِئْنَا مِنْ كُلِّ أُمَّةٍ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَى هَؤُلاءِ شَهِيدًا         }      فَاضَتْ عَيْنَاهُ  .         [9/85]","","Musnad Abi Ya'la al-Mawsili 5150","","عبد الله بن مسعود عن منذر الأشجعي ختن هلال بن يساف عن هلال بن يساف الأشجعي عن حصين بن عبد الرحمن السلمي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5153","185 - (  5151  ) -  وَعَنْ  جَرِيرٍ ، قَالَ :  وَحَدَّثَنَا  الرُّكَيْنُ بْنُ الرَّبِيعِ بْنِ عَمِيلَةَ الْفَزَارِيُّ ،  عَنِ  الْقَاسِمِ بْنِ حَسَّانَ ،  عَنْ  عَمِّهِ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَرِهَ عَشْرَ خِلَالٍ  : التَّخَتُّمَ بِالذَّهَبِ ، وَجَرَّ الْإِزَارِ ، وَالصُّفْرَةَ -  يَعْنِي  الْخَلُوقَ  - ،  وَتَغْيِيرَ  الشَّيْبِ - قَالَ  جَرِيرٌ  :  يَعْنِي نَتْفَهُ  - ، وَالرُّقَى إِلَّا بِالْمُعَوِّذَتَيْنِ ، وَعَقْدَ  التَّمَائِمِ  ، وَالضَّرْبَ  بِالْكِعَابِ  ،  وَالتَّبَرُّجَ  بِالزِّينَةِ لِغَيْرِ  مَحَلِّهَا ،  وَعَزْلَ  الْمَاءِ عَنْ مَحَلِّهِ ،  وَإِفْسَادَ  الصَّبِيِّ غَيْرَ مُحَرِّمِهِ  .","","Musnad Abi Ya'la al-Mawsili 5151","","عبد الله بن مسعود عن عبد الرحمن بن حرملة الكوفي عن القاسم بن حسان العامري عن ركين بن الربيع الفزاري عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5154","186 - (  5152  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  أَبِي سَعْدٍ الْأَزْدِيِّ ،  عَنْ  أَبِي الْكَنُودِ ، قَالَ :  أَصَبْتُ  رَجُلًا مِنْ عُظَمَاءِ فَارِسَ  يَوْمَ مِهْرَانَ  ، قَالَ : فَرَفَعْتُ  سَلَبَهُ  إِلَى السُّلْطَانِ ، قَالَ : فَأَخَذْتُ خَاتَمًا لَهُ مِنْ ذَهَبٍ ، قَالَ : وَكَانَ قَدْ رُئِيَ فِي يَدِي ، قَالَ : قُلْتُ : إِذَا خَرَجْتُ إِلَى أَرْضِ الْعَجَمِ فَأَصَابَنِي شَيْءٌ ، فَإِنَّهُ نَافِقٌ ،  فَدَخَلْتُ عَلَى  عَبْدِ اللهِ وَهُوَ فِي يَدِي ، فَقَالَ : مَا هَذَا الْخَاتَمُ ؟ فَقَصَصْتُ عَلَيْهِ الْقِصَّةَ ، فَأَخَذَهُ مِنِّي ، فَجَعَلَهُ فِي فِيهِ ثُمَّ مَضَغَهُ ، ثُمَّ طَرَحَهُ إِلَيَّ ، ثُمَّ قَالَ :  نَهَى         [9/86]      النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ حَلْقَةِ الذَّهَبِ  .","","Musnad Abi Ya'la al-Mawsili 5152","","عبد الله بن مسعود عن أبو الكنود الأزدي عن أبو سعد الأزدي عن يزيد بن أبي زياد القرشي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5155","187 - (  5153  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلِمَةَ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ ، يَقُولُ :  مِنْ كُلِّ شَيْءٍ قَدْ أُوتِيَ نَبِيُّكُمْ ، إِلَّا مَفَاتِيحَ الْخَمْسِ  :         {      إِنَّ اللهَ عِنْدَهُ عِلْمُ السَّاعَةِ وَيُنَـزِّلُ الْغَيْثَ وَيَعْلَمُ مَا فِي الْأَرْحَامِ         }      الْآيَةَ كُلَّهَا  .         [9/87]","","Musnad Abi Ya'la al-Mawsili 5153","","عبد الله بن مسعود عن عبد الله بن سلمة الجملي عن عمرو بن مرة المرادي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5156","188 - (  5154  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ  عَنْ  يَحْيَى الْجَابِرِ ،  عَنْ  أَبِي مَاجِدَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ  سَأَلْنَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ السَّيْرِ بِالْجِنَازَةِ فَقَالَ : السَّيْرُ مَا دُونَ  الْخَبَبِ  ، فَإِنْ يَكُنْ خَيْرًا يُعَجَّلْ إِلَيْهِ ، وَإِنْ يَكُ سِوَى ذَلِكَ فَبُعْدًا لِأَهْلِ النَّارِ ، الْجِنَازَةُ مَتْبُوعَةٌ وَلَيْسَ مِنْهَا مَنْ تَقَدَّمَهَا  .","","Musnad Abi Ya'la al-Mawsili 5154","","عبد الله بن مسعود عن عائذ بن نضلة الحنفي عن يحيى بن عبد الله بن الحارث الجابر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5157","189 - (  5155  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  يَحْيَى الْجَابِرِ ،  عَنْ  أَبِي مَاجِدَةَ ،  عَنْ  عَبْدِ اللهِ أَنَّهُ أَنْشَأَ  يُحَدِّثُ  ، قَالَ :  إِنَّ أَوَّلَ رَجُلٍ قُطِعَ  مِنَ الْمُسْلِمِينَ - أَوْ فِي الْمُسْلِمِينَ -  رَجُلٌ مِنَ الْأَنْصَارِ  ، أُتِيَ بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقِيلَ : سَرَقَ ، فَقَالَ : اذْهَبُوا بِصَاحِبِكُمْ فَاقْطَعُوهُ ، فَكَأَنَّمَا أُسْفِيَ وَجْهُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَمَادًا ، فَقَالَ لَهُ بَعْضُ جُلَسَائِهِ :         [9/88]      كَأَنَّ هَذَا قَدْ شَقَّ عَلَيْكَ يَا رَسُولَ اللهِ ؟ قَالَ : وَمَا يَنْبَغِي أَنْ تَكُونُوا أَعْوَانًا لِلشَّيْطَانِ أَوْ لِإِبْلِيسَ ، إِنَّهُ لَا يَنْبَغِي لِوَالِي أَمْرٍ أَنْ يُؤْتَى بِحَدٍّ إِلَّا أَقَامَهُ ، وَاللهُ عَفُوٌّ يُحِبُّ  الْعَفْوَ  ، ثُمَّ قَرَأَ هَذِهِ الْآيَةَ :         {      وَلْيَعْفُوا وَلْيَصْفَحُوا أَلا تُحِبُّونَ أَنْ يَغْفِرَ اللهُ لَكُمْ         }      .","","Musnad Abi Ya'la al-Mawsili 5155","","عبد الله بن مسعود عن عائذ بن نضلة الحنفي عن يحيى بن عبد الله بن الحارث الجابر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5158","190 - (  5156  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ، وَيَحْيَى بْنُ سَعِيدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّهَا سَتَكُونُ بَعْدِي  أَثَرَةٌ  وَأُمُورٌ تُنْكِرُونَهَا  ، قَالُوا : يَا رَسُولَ اللهِ ، كَيْفَ تَأْمُرُ مَنْ أَدْرَكَ ذَلِكَ مِنَّا ؟ قَالَ : تُؤَدُّونَ الْحَقَّ الَّذِي عَلَيْكُمْ ، وَتَسْأَلُونَ اللهَ الَّذِي لَكُمْ  .         [9/89]","","Musnad Abi Ya'la al-Mawsili 5156","","عبد الله بن مسعود عن زيد بن وهب الجهني عن الأعمش عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5159","191 - (  5157  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ الصَّادِقُ الْمَصْدُوقُ :  إِنَّ خَلْقَ أَحَدِكُمْ لَيُجْمَعُ فِي بَطْنِ أُمِّهِ أَرْبَعِينَ يَوْمًا ، ثُمَّ يَكُونُ  عَلَقَةً  مِثْلَ ذَلِكَ  ، ثُمَّ يَكُونُ مُضْغَةً مِثْلَ ذَلِكَ ، ثُمَّ يَبْعَثُ اللهُ الْمَلَكَ بِأَرْبَعِ كَلِمَاتٍ : رِزْقُهُ ، وَعَمَلُهُ ، وَأَجَلُهُ ، وَشَقِيٌّ أَمْ سَعِيدٌ ، فَوَالَّذِي نَفْسِي بِيَدِهِ ، إِنَّ أَحَدَكُمْ لَيَعْمَلُ بِعَمَلِ أَهْلِ الْجَنَّةِ حَتَّى مَا يَكُونُ بَيْنَهُ وَبَيْنَهَا إِلَّا ذِرَاعٌ ، ثُمَّ يُدْرِكُهُ مَا سَبَقَ لَهُ فِي الْكِتَابِ فَيَعْمَلُ بِعَمَلِ أَهْلِ النَّارِ فَيَدْخُلُهَا ، وَإِنَّ أَحَدَكُمْ لَيَعْمَلُ         [9/90]      بِعَمَلِ أَهْلِ النَّارِ حَتَّى مَا يَكُونُ بَيْنَهُ وَبَيْنَهَا إِلَّا ذِرَاعٌ ، ثُمَّ يُدْرِكُهُ مَا سَبَقَ لَهُ فِي الْكِتَابِ فَيَعْمَلُ بِعَمَلِ أَهْلِ الْجَنَّةِ فَيَدْخُلُهَا .         [9/91]","","Musnad Abi Ya'la al-Mawsili 5157","","عبد الله بن مسعود عن زيد بن وهب الجهني عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5160","192 - (  5158  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  بَيْنَمَا نَحْنُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَارٍ إِذْ نَزَلَتْ عَلَيْهِ :         {      وَالْمُرْسَلاتِ عُرْفًا         }      ،  فَتَلَقَّفْنَاهَا  مِنْ فِيهِ ، وَإِنَّ فَاهُ لَرَطْبٌ بِهَا ، إِذْ خَرَجَتْ حَيَّةٌ ، فَقَالَ         [9/92]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اقْتُلُوهَا ، قَالَ : فَابْتَدَرْنَاهَا ، فَسَبَقَتْنَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وُقِيَتْ شَرَّكُمْ وَوُقِيتُمْ شَرَّهَا  .","","Musnad Abi Ya'la al-Mawsili 5158","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5161","193 - (  5159  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَمَّا نَزَلَتْ هَذِهِ الْآيَةُ :         {      الَّذِينَ آمَنُوا وَلَمْ يَلْبِسُوا إِيمَانَهُمْ بِظُلْمٍ         }      شَقَّ عَلَى أَصْحَابِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالُوا : أَيُّنَا لَمْ يَلْبِسْ إِيمَانَهُ بِظُلْمٍ ؟ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَيْسَ بِذَلِكَ ، أَلَمْ تَسْمَعُوا إِلَى قَوْلِ  لُقْمَانَ  :         {      إِنَّ الشِّرْكَ لَظُلْمٌ عَظِيمٌ         }      ؟  .         [9/93]","","Musnad Abi Ya'la al-Mawsili 5159","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5162","194 - (  5160  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  جَاءَ  رَجُلٌ  مِنْ أَهْلِ الْكِتَابِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  إِنَّ اللهَ يُمْسِكُ السَّمَاوَاتِ عَلَى إِصْبَعٍ ، وَالْأَرَضِينَ عَلَى إِصْبَعٍ  ، وَالْجِبَالَ وَالشَّجَرَ عَلَى إِصْبَعٍ ، وَالْمَاءَ         [9/94]      وَالثَّرَى  عَلَى إِصْبَعٍ ، وَالْخَلَائِقَ كُلَّهَا عَلَى إِصْبَعٍ ، ثُمَّ قَالَ : أَنَا الْمَلِكُ . قَالَ : فَضَحِكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى بَدَتْ  نَوَاجِذُهُ  ، ثُمَّ قَرَأَ هَذِهِ الْآيَةَ :         {      وَمَا قَدَرُوا اللهَ حَقَّ قَدْرِهِ وَالأَرْضُ جَمِيعًا قَبْضَتُهُ يَوْمَ الْقِيَامَةِ وَالسَّمَاوَاتُ مَطْوِيَّاتٌ بِيَمِينِهِ         }      ، الْآيَةَ ، فَقُلْتُ  لِإِبْرَاهِيمَ  : أَفِي الدُّنْيَا أَمْ فِي الْآخِرَةِ ؟ فَقَالَ : فِي الدُّنْيَا  .","","Musnad Abi Ya'la al-Mawsili 5160","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5163","[9/95]      195 - (  5161  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ :  أَنَا لَيْلَةَ الْجُمُعَةِ فِي الْمَسْجِدِ إِذْ دَخَلَ  رَجُلٌ مِنَ الْأَنْصَارِ  ، فَقَالَ : لَوْ أَنَّ رَجُلًا وَجَدَ مَعَ امْرَأَتِهِ رَجُلًا ، فَإِنْ تَكَلَّمَ جَلَدْتُمُوهُ ، وَإِنْ قَتَلَ قَتَلْتُمُوهُ ، وَإِنْ سَكَتَ سَكَتَ عَلَى غَيْظٍ ، وَاللهِ لَأَسْأَلَنَّ عَنْهُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَلَمَّا كَانَ مِنَ الْغَدِ ، أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَسَأَلَهُ فَقَالَ :  لَوْ أَنَّ رَجُلًا وَجَدَ مَعَ امْرَأَتِهِ رَجُلًا فَتَكَلَّمَ جَلَدْتُمُوهُ ، أَوْ قَتَلَ قَتَلْتُمُوهُ ، أَوْ سَكَتَ سَكَتَ عَلَى غَيْظٍ ، قَالَ : اللَّهُمَّ افْتَحْ ، وَجَعَلَ يَدْعُو  ، فَنَزَلَتْ آيَةُ اللِّعَانِ :         {      وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ وَلَمْ يَكُنْ لَهُمْ شُهَدَاءُ إِلا أَنْفُسُهُمْ         }      هَذِهِ الْآيَاتُ ، فَابْتُلِيَ بِهِ الرَّجُلُ بَيْنَ النَّاسِ ، فَجَاءَ هُوَ وَامْرَأَتُهُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَتَلَاعَنَا ، فَشَهِدَ الرَّجُلُ أَرْبَعَ شَهَادَاتٍ         [9/96]      بِاللهِ إِنَّهُ لَمِنَ الصَّادِقِينَ ، ثُمَّ لَعَنَ الْخَامِسَةَ : أَنَّ لَعْنَةَ اللهِ عَلَيْهِ إِنْ كَانَ مِنَ الْكَاذِبِينَ ، فَذَهَبَتْ لِتَلْتَعِنَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَهْ ،  فَلَعَنَتْ ، فَلَمَّا أَدْبَرَا ، قَالَ : لَعَلَّهَا أَنْ تَجِيءَ بِهِ أَسْوَدَ جَعْدًا ، فَجَاءَتْ بِهِ أَسْوَدَ جَعْدًا  .","","Musnad Abi Ya'la al-Mawsili 5161","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5164","196 - (  5162  ) -  وَعَنْ  إِبْرَاهِيمَ ،  عَنِ  الْحَارِثِ بْنِ سُوَيْدٍ ،         [9/97]      عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا تَعُدُّونَ  الرَّقُوبَ  فِيكُمْ ؟ قَالَ : قُلْنَا : الَّذِي لَا وَلَدَ لَهُ  ، قَالَ : لَيْسَ ذَلِكَ  بِالرَّقُوبِ  ، وَلَكِنَّ  الرَّقُوبَ  الَّذِي لَمْ يُقَدِّمْ مِنْ وَلَدِهِ شَيْئًا ، قَالَ : وَمَا تَعُدُّونَ  الصُّرَعَةَ  فِيكُمْ ؟ قَالَ : قُلْنَا : الَّذِي لَا تَصْرَعُهُ الرِّجَالُ ، قَالَ : لَيْسَ ذَلِكُمْ ، وَلَكِنَّ الَّذِي يَمْلِكُ نَفْسَهُ عِنْدَ الْغَضَبِ  .","","Musnad Abi Ya'la al-Mawsili 5162","","عبد الله بن مسعود عن الحارث بن سويد الأعور عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5165","197 - (  5163  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنِ  الْحَارِثِ بْنِ سُوَيْدٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّكُمْ مَالُهُ أَحَبُّ إِلَيْهِ         [9/98]      مِنْ مَالِ وَارِثِهِ ؟  قَالُوا : يَا رَسُولَ اللهِ ، مَا مِنَّا مِنْ أَحَدٍ إِلَّا مَالُهُ أَحَبُّ إِلَيْهِ مِنْ مَالِ وَارِثِهِ ، قَالَ : اعْلَمُوا مَا تَقُولُونَ ، قَالُوا : مَا نَعْلَمُ إِلَّا ذَاكَ يَا رَسُولَ اللهِ ، قَالَ : مَا مِنْكُمْ رَجُلٌ إِلَّا مَالُ وَارِثِهِ أَحَبُّ إِلَيْهِ مِنْ مَالِهِ ؟ قَالُوا : كَيْفَ يَا رَسُولَ اللهِ ؟ قَالَ : إِنَّمَا مَالُ أَحَدِكُمْ مَا قَدَّمَ ، وَمَالُ وَارِثِهِ مَا أَخَّرَ  .","","Musnad Abi Ya'la al-Mawsili 5163","","عبد الله بن مسعود عن الحارث بن سويد الأعور عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5166","198 - (  5164  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنِ  الْحَارِثِ بْنِ سُوَيْدٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  دَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يُوعَكُ ،         [9/99]      فَمَسِسْتُهُ بِيَدِي ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّكَ لَتُوعَكُ وَعْكًا شَدِيدًا ، قَالَ رَسُولُ اللهِ : أَجَلْ ، إِنِّي أُوعَكُ كَمَا يُوعَكُ رَجُلَانِ مِنْكُمْ ، فَقُلْتُ : ذَاكَ أَنَّ لَكَ أَجْرَانِ ؟ فَقَالَ رَسُولُ اللهِ : أَجَلْ ، ثُمَّ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ مُسْلِمٍ يُصِيبُهُ أَذًى مِنْ مَرَضٍ فَمَا سِوَاهُ ، إِلَّا حَطَّ اللهُ بِهِ مِنْ سَيِّئَاتِهِ  ، كَمَا تَحُطُّ الشَّجَرَةُ وَرَقَهَا  .         [9/100]","","Musnad Abi Ya'la al-Mawsili 5164","","عبد الله بن مسعود عن الحارث بن سويد الأعور عن إبراهيم بن يزيد بن شريك التيمي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5167","199 - (  5165  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَطَالَ حَتَّى هَمَمْتُ بِأَمْرِ سَوْءٍ  ، قَالَ : وَمَا هَمَمْتَ بِهِ ؟ قَالَ : هَمَمْتُ أَنْ أَجْلِسَ وَأَدَعَهُ  .","","Musnad Abi Ya'la al-Mawsili 5165","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5168","200 - (  5166  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ،  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : يَا رَسُولَ اللهِ ، كَيْفَ تَقُولُ فِي رَجُلٍ أَحَبَّ قَوْمًا وَلَمْ يَلْحَقْ بِهِمْ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمَرْءُ مَعَ مَنْ أَحَبَّ  .         [9/101]","","Musnad Abi Ya'la al-Mawsili 5166","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5169","201 - (  5167  ) -  وَعَنْ  أَبِي وَائِلٍ ،  عَنْ  عَمْرِو بْنِ شُرَحْبِيلَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  قَالَ  رَجُلٌ  :  يَا رَسُولَ اللهِ ، أَيُّ الذَّنْبِ أَكْبَرُ عِنْدَ اللهِ ؟ قَالَ : أَنْ تَدْعُوَ لِلهِ  نِدًّا  وَهُوَ خَلَقَكَ  ، قَالَ : ثُمَّ أَيُّ ؟ قَالَ : ثُمَّ أَنْ تُزَانِيَ  حَلِيلَةَ  جَارِكَ ، قَالَ : فَأَنْزَلَ اللهُ تَصْدِيقَهَا :         {      وَالَّذِينَ لا يَدْعُونَ مَعَ اللهِ إِلَهًا آخَرَ وَلا يَقْتُلُونَ النَّفْسَ الَّتِي حَرَّمَ اللهُ إِلا بِالْحَقِّ         }      الْآيَةَ  .         [9/102]","","Musnad Abi Ya'la al-Mawsili 5167","","عبد الله بن مسعود عن عمرو بن شرحبيل الهمداني عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5170","202 - (  5168  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَا  فَرَطُكُمْ  عَلَى الْحَوْضِ ،  فَلَأُنَازِعَنَّ  رِجَالًا مِنْكُمْ ، ثُمَّ لَأُغْلَبَنَّ عَلَيْهِمْ  ، فَيُقَالُ : إِنَّكَ لَا تَدْرِي مَا أَحْدَثُوا بَعْدَكَ  .         [9/103]","","Musnad Abi Ya'la al-Mawsili 5168","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5171","203 - (  5169  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ أَحَدٌ أَحَبَّ إِلَيْهِ الْمَدْحُ مِنَ اللهِ عَزَّ وَجَلَّ  ، مِنْ أَجْلِ ذَلِكَ مَدَحَ نَفْسَهُ ، وَلَيْسَ أَحَدٌ أَغْيَرَ مِنَ اللهِ ، مِنْ أَجْلِ ذَلِكَ حَرَّمَ الْفَوَاحِشَ  .","","Musnad Abi Ya'la al-Mawsili 5169","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5172","204 - (  5170  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُبَاشِرِ الْمَرْأَةُ الْمَرْأَةَ لِتَنْعَتَهَا لِزَوْجِهَا ، كَأَنَّهُ يَنْظُرُ إِلَيْهَا  .","","Musnad Abi Ya'la al-Mawsili 5170","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5173","205 - (  5171  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ قَالَ :  لَقَدْ سَأَلَنِي الْيَوْمَ رَجُلٌ عَنْ شَيْءٍ مَا دَرَيْتُ مَا أَقُولُ لَهُ ، قَالَ : أَرَأَيْتَ رَجُلًا  مُؤْدِيًا  نَشِيطًا حَرِيصًا عَلَى  الْجِهَادِ  ،  يَعْزِمُ  عَلَيْنَا أُمَرَاؤُنَا فِي أَشْيَاءَ لَا نُحْصِيهَا ، قَالَ : فَقُلْتُ : وَاللهِ مَا أَدْرِي مَا أَقُولُ لَكَ إِلَّا أَنَّا  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَعَلَّهُ أَنْ لَا يَأْمُرَنَا بِشَيْءٍ إِلَّا فَعَلْنَا  ، وَمَا أَشْبَهَ مَا غَبَرَ مِنَ الدُّنْيَا إِلَّا  كَالثَّغَبِ         [9/104]      شُرِبَ صَفْوُهُ وَبَقِيَ كَدَرُهُ وَإِنَّ أَحَدَكُمْ لَنْ يَزَالَ بِخَيْرٍ مَا اتَّقَى اللهَ ، وَإِذَا حَاكَ فِي نَفْسِهِ شَيْءٌ أَتَى رَجُلًا فَسَأَلَهُ فَشَفَاهُ ، وَايْمُ اللهِ  لَيُوشِكَنَّ  أَنْ لَا تَجِدُوهُ  .","","Musnad Abi Ya'la al-Mawsili 5171","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5174","206 - (  5172  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَمْشِي ، فَمَرَرْنَا بِصِبْيَانٍ فِيهِمُ  ابْنُ صَيَّادٍ  ، فَفَرَّ الصِّبْيَانُ وَجَلَسَ  ابْنُ صَيَّادٍ  ، فَكَأَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَرِهَ ذَلِكَ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَرِبَتْ  يَدَاكَ ، أَتَشْهَدُ أَنِّي رَسُولُ اللهِ ؟ قَالَ : لَا ، بَلْ تَشْهَدُ أَنِّي رَسُولُ اللهِ ، قَالَ  عُمَرُ  : تَأْذَنُنِي يَا رَسُولَ اللهِ أَنْ أَقْتُلَهُ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنْ يَكُنِ الَّذِي تَرَى ، فَلَنْ تَسْتَطِيعَ قَتْلَهُ  .","","Musnad Abi Ya'la al-Mawsili 5172","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5175","207 - (  5173  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي رَزِينٍ ،  عَنْ  زِرٍّ ،  قَالَ  ابْنُ مَسْعُودٍ :  نَزَلَتْ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      وَالْمُرْسَلاتِ عُرْفًا         }      وَنَحْنُ فِي غَارٍ ، فَأَقْرَأَنِيهَا  ، فَإِنِّي لَأَقْرَؤُهَا         [9/105]      قَرِيبًا مِمَّا أَقْرَأَنِي ،  فَمَا أَدْرِي بِأَيِّ خَاتِمَتِهَا خَتَمَ :         {      وَإِذَا قِيلَ لَهُمُ ارْكَعُوا لا يَرْكَعُونَ         }      أَوْ         {      فَبِأَيِّ حَدِيثٍ بَعْدَهُ يُؤْمِنُونَ         }      ؟  .","","Musnad Abi Ya'la al-Mawsili 5173","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن مسعود بن مالك الأسدي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5176","208 - (  5174  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ ،  عَنِ  الْأَسْوَدِ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  لَا يَجْعَلَنَّ أَحَدُكُمْ لِلشَّيْطَانِ مِنْ نَفْسِهِ جُزْءًا ، أَنْ يَرَى أَنَّ حَقًّا عَلَيْهِ أَنْ يَنْصَرِفَ عَنْ يَمِينِهِ ، فَلَقَدْ  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكْثَرَ مَا يَنْصَرِفُ عَنْ شِمَالِهِ  ، قَالَ  عُمَارَةُ  : فَأَتَيْتُ  الْمَدِينَةَ  فَرَأَيْتُ مَنَازِلَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ شِمَالِهِ  .         [9/106]","","Musnad Abi Ya'la al-Mawsili 5174","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5177","209 - (  5175  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  دَخَلَ  الْأَشْعَثُ بْنُ قَيْسٍ  عَلَى عَبْدِ اللهِ وَهُوَ يَتَغَدَّى ، فَقَالَ :         [9/107]      ادْنُهْ ، فَقَالَ  الْأَشْعَثُ  : أَلَيْسَ الْيَوْمُ يَوْمَ عَاشُورَاءَ ؟ فَقَالَ  عَبْدُ اللهِ  :  وَمَا يُدْرِيكَ مَا عَاشُورَاءُ ؟ إِنَّمَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَصُومُهُ ، فَلَمَّا نَزَلَ رَمَضَانُ تَرَكَهُ  .","","Musnad Abi Ya'la al-Mawsili 5175","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5178","210 - (  5176  ) -  وَعَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  مَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى صَلَاةً إِلَّا         [9/108]      لِوَقْتِهَا ، إِلَّا صَلَاتَيْنِ  : رَأَيْتُهُ صَلَّى الْمَغْرِبَ وَالْعِشَاءَ جَمِيعًا  بِالْمُزْدَلِفَةِ  ، وَصَلَّى صَلَاةَ الْفَجْرِ قَبْلَ وَقْتِهَا  بِغَلَسٍ  .","","Musnad Abi Ya'la al-Mawsili 5176","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5179","211 - (  5177  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ يَعْنِي  عَنِ  الْحَارِثِ بْنِ سُوَيْدٍ ، قَالَ :  دَخَلْتُ عَلَى عَبْدِ اللهِ أَعُودُهُ وَهُوَ مَرِيضٌ ،  فَحَدَّثَنَا  بِحَدِيثَيْنِ : حَدِيثٍ عَنْ نَفْسِهِ ، وَحَدِيثٍ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :         [9/109]      إِنَّ الْمُؤْمِنَ يَرَى ذُنُوبَهُ كَأَنَّهُ فِي أَصْلِ جَبَلٍ يَخَافُ أَنْ يَقَعَ عَلَيْهِ ، وَإِنَّ الْفَاجِرَ يَرَى ذُنُوبَهُ مِثْلَ ذُبَابٍ مَرَّ عَلَى أَنْفِهِ فَذَبَّهُ عَنْهُ .  قَالَ : وَسَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  لَلَّهُ أَشَدُّ  فَرَحًا  بِتَوْبَةِ عَبْدِهِ الْمُؤْمِنِ مِنْ رَجُلٍ فِي أَرْضٍ  دَوِّيَّةٍ  مَهْلَكَةٍ  ، مَعَهُ رَاحِلَتُهُ عَلَيْهَا طَعَامُهُ وَشَرَابُهُ ، فَنَامَ ، فَاسْتَيْقَظَ وَقَدْ ذَهَبَتْ ، فَقَامَ يَطْلُبُهَا ، فَطَلَبَهَا حَتَّى أَدْرَكَهُ الْعَطَشُ ، ثُمَّ قَالَ : أَرْجِعُ إِلَى مَكَانِي الَّذِي كُنْتُ فِيهِ حَتَّى أَمُوتَ ، قَالَ : فَوَضَعَ رَأْسَهُ عَلَى سَاعِدِهِ لِيَمُوتَ ، فَاسْتَيْقَظَ وَعِنْدَهُ رَاحِلَتُهُ عَلَيْهَا زَادُهُ وَطَعَامُهُ وَشَرَابُهُ ، فَاللهُ أَشَدُّ  فَرَحًا  بِتَوْبَةِ عَبْدِهِ مِنْ هَذَا بِرَاحِلَتِهِ وَزَادِهِ  .","","Musnad Abi Ya'la al-Mawsili 5177","","عبد الله بن مسعود عن الحارث بن سويد الأعور عن عمارة بن عمير التيمي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5180","212 - (  5178  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مَالِكِ بْنِ الْحَارِثِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  قَالَ  عَبْدُ اللهِ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ أَحَدٌ أَحَبَّ إِلَيْهِ الْمَدْحُ مِنَ اللهِ ، مِنْ أَجْلِ ذَلِكَ مَدَحَ نَفْسَهُ  ، وَلَيْسَ أَحَدٌ أَغْيَرَ مِنَ اللهِ ، مِنْ أَجْلِ ذَلِكَ حَرَّمَ الْفَوَاحِشَ ، وَلَيْسَ أَحَدٌ أَحَبَّ إِلَيْهِ الْعُذْرُ مِنَ اللهِ ، مِنْ أَجْلِ ذَلِكَ أَنْزَلَ الْكِتَابَ وَأَرْسَلَ الرُّسُلَ  .         [9/110]","","Musnad Abi Ya'la al-Mawsili 5178","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن مالك بن الحارث السلمي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5181","213 - (  5179  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ الْهَمْدَانِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ نَفْسٍ تُقْتَلُ ظُلْمًا ، إِلَّا كَانَ عَلَى ابْنِ آدَمَ الْأَوَّلِ كِفْلٌ مِنْ دَمِهَا  ، لِأَنَّهُ سَنَّ الْقَتْلَ .         [9/111]","","Musnad Abi Ya'la al-Mawsili 5179","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5182","214 - (  5180  ) -  وَعَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  بَرِئْتُ إِلَى كُلِّ         [9/112]      خَلِيلٍ  مِنْ  خُلَّتِهِ  ، وَلَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  لَاتَّخَذْتُ  أَبَا بَكْرٍ  خَلِيلًا  ، وَإِنَّ صَاحِبَكُمْ  خَلِيلُ  اللهِ .","","Musnad Abi Ya'la al-Mawsili 5180","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عبد الله بن مرة الخارفي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5183","215 - (  5181  ) -  وَعَنْ  جَرِيرٍ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  عَوْسَجَةَ بْنِ الرَّمَّاحِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  اللَّهُمَّ أَحْسَنْتَ خَلْقِي ، فَأَحْسِنْ  خُلُقِي  .","","Musnad Abi Ya'la al-Mawsili 5181","","عبد الله بن مسعود عن عبد الله بن أبي الهذيل الغنوي عن عوسجة بن الرماح الكوفي عن عاصم بن سليمان الأحول عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5184","216 - (  5182  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  عُمَارَةَ بْنِ الْقَعْقَاعِ ،  عَنْ  أَبِي زُرْعَةَ ، قَالَ :  حَدَّثَنَا  صَاحِبٌ لَنَا ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يُعْدِي شَيْءٌ شَيْئًا  ، ثَلَاثَ مَرَّاتٍ ، فَقَالَ  أَعْرَابِيٌّ  فِي  الْقَوْمِ  : يَا رَسُولَ اللهِ ، فَإِنَّ الْبَعِيرَ يَكُونُ فِي الْإِبِلِ الْعَظِيمَةِ فَتَكُونُ بِهِ  النُّقْبَةُ  بِذَنَبِهِ ، أَوْ         [9/113]      بِمِشْفَرِهِ  فَتَجْرَبُ الْإِبِلُ كُلُّهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : فَمَنْ أَجْرَبَ الْأَوَّلَ ؟ ثُمَّ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : لَا  عَدْوَى ،  وَلَا  طِيَرَةَ ،  وَلَا  صَفَرَ ،  وَلَا  هَامَةَ ،  خَلَقَ اللهُ كُلَّ نَفْسٍ وَكَتَبَ حَيَاتَهَا ، وَرِزْقَهَا ، وَمُصِيبَاتِهَا  .","","Musnad Abi Ya'la al-Mawsili 5182","","عبد الله بن مسعود عن صاحب أبو زرعة بن عمرو بن جرير الغلابي عن أبو زرعة بن عمرو بن جرير الغلابي عن عمارة بن القعقاع عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5185","217 - (  5183  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ :  إِنَّ اللهَ لَمْ يُنْزِلْ دَاءً إِلَّا قَدْ جَعَلَ لَهُ شِفَاءً  ، عَلِمَهُ مَنْ عَلِمَهُ ، وَجَهِلَهُ مَنْ جَهِلَهُ  .         [9/114]","","Musnad Abi Ya'la al-Mawsili 5183","","عبد الله بن مسعود عن عبد الله بن عمر بن الخطاب عن شقيق بن سلمة عن عطاء بن السائب عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5186","218 - (  5184  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  خَرَجْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى الْحَاجَةِ ، فَقَضَاهَا ، فَقَالَ :  ابْغِنِي  شَيْئًا أَسْتَنْجِي بِهِ ، وَلَا تُقْرِبْنِي حَائِلًا ، وَلَا رَجِيعًا  ، قَالَ : ثُمَّ تَوَضَّأَ ، فَقَامَ يُصَلِّي ، فَرَأَيْتُهُ كُلَّمَا رَكَعَ حَنَا يَعْنِي طَبَّقَ يَدَيْهِ وَجَعَلَهُمَا بَيْنَ رُكْبَتَيْهِ         [9/115]      قَالَ  لَيْثٌ  :  الْحَائِلُ الْعَظْمُ  .","","Musnad Abi Ya'la al-Mawsili 5184","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5187","219 - (  5185  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  أَبِيهِ ،  قَالَ :  كُنْتُ مَعَ عَبْدِ اللهِ حَتَّى انْتَهَى إِلَى  جَمْرَةِ الْعَقَبَةِ  فَسَبَقْتُهُ ، فَقَالَ : نَاوِلْنِي أَحْجَارًا ، فَنَاوَلْتُهُ سَبْعَةَ أَحْجَارٍ وَهُوَ يُلَبِّي  ، ثُمَّ قَالَ : خُذْ بِزِمَامِ النَّاقَةِ ، فَأَتَى بَطْنَ  الْوَادِي  ،  فَعَاجَ  إِلَى الشَّجَرَةِ ، ثُمَّ قَالَ : اللهُ أَكْبَرُ ، ثُمَّ رَمَى فَجَعَلَ يُكَبِّرُ عِنْدَ كُلِّ حَصَاةٍ حَتَّى رَمَى سَبْعَ حَصَيَاتٍ ، ثُمَّ قَالَ : اللَّهُمَّ اجْعَلْهُ حَجًّا  مَبْرُورًا  ، وَذَنْبًا مَغْفُورًا ، ثُمَّ قَالَ : هَكَذَا فَعَلَ الَّذِي نَزَلَتْ عَلَيْهِ سُورَةُ الْبَقَرَةِ  .","","Musnad Abi Ya'la al-Mawsili 5185","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن محمد بن عبد الرحمن بن يزيد النخعي عن ليث بن أبي سليم عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5188","220 - (  5186  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  حَسَدَ  إِلَّا فِي اثْنَتَيْنِ  : رَجُلٌ آتَاهُ اللهُ مَالًا فَسَلَّطَهُ عَلَى هَلَكَتِهِ فِي الْحَقِّ ، وَآخَرَ آتَاهُ اللهُ الْحِكْمَةَ ، فَهُوَ يَقْضِي بِهَا وَيُعَلِّمُهَا  .         [9/116]","","Musnad Abi Ya'la al-Mawsili 5186","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5189","221 - (  5187  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي عُبَيْدَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  لَمَّا كَانَ  يَوْمُ  بَدْرٍ  ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا تَرَوْنَ فِي هَؤُلَاءِ الْأُسَارَى ؟  قَالَ  عَبْدُ اللهِ بْنُ رَوَاحَةَ  : يَا رَسُولَ اللهِ ، أَنْتَ فِي وَادٍ كَثِيرِ الْحَطَبِ ، فَأَضْرِمِ الْوَادِي عَلَيْهِمْ نَارًا ، ثُمَّ أَلْقِهِمْ فِيهِ ، قَالَ  الْعَبَّاسُ  : قَطَعَ اللهُ رَحِمَكَ ، قَالَ  عُمَرُ  : يَا رَسُولَ اللهِ ، قَادَةُ الْمُشْرِكِينَ وَرُءُوسُهُمْ ، كَذَّبُوكَ ، وَقَاتَلُوكَ ، اضْرِبْ أَعْنَاقَهُمْ ، قَالَ  أَبُو بَكْرٍ  : يَا رَسُولَ اللهِ ، عَشِيرَتُكَ ، وَقَوْمُكَ ، اسْتَحْيِهِمْ يَسْتَنْقِذْهُمُ اللهُ بِكَ مِنَ النَّارِ ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِيَقْضِيَ حَاجَتَهُ ، فَقَالَتْ طَائِفَةٌ : الْقَوْلُ مَا قَالَ  عُمَرُ  ، وَقَالَتْ طَائِفَةٌ : الْقَوْلُ مَا قَالَ  أَبُو بَكْرٍ  ، فَخَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : مَا قَوْلُكُمْ فِي هَذَيْنِ الرَّجُلَيْنِ ؟ إِنَّ مَثَلَهُمْ مَثَلُ إِخْوَةٍ لَهُمْ كَانُوا مِنْ قَبْلِهِمْ ، قَالَ  نُوحٌ  :         {      رَبِّ لا تَذَرْ عَلَى الأَرْضِ مِنَ الْكَافِرِينَ دَيَّارًا             *          إِنَّكَ إِنْ تَذَرْهُمْ يُضِلُّوا عِبَادَكَ         }      ، وَقَالَ  مُوسَى  :         {      رَبَّنَا اطْمِسْ عَلَى أَمْوَالِهِمْ وَاشْدُدْ عَلَى قُلُوبِهِمْ فَلا يُؤْمِنُوا حَتَّى يَرَوُا الْعَذَابَ الأَلِيمَ         }      ،         [9/117]      وَقَالَ  إِبْرَاهِيمُ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      فَمَنْ تَبِعَنِي فَإِنَّهُ مِنِّي وَمَنْ عَصَانِي فَإِنَّكَ غَفُورٌ رَحِيمٌ         }      ، وَقَالَ  عِيسَى  :         {      إِنْ تُعَذِّبْهُمْ فَإِنَّهُمْ عِبَادُكَ وَإِنْ تَغْفِرْ لَهُمْ فَإِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ         }      ، وَأَنْتُمْ قَوْمٌ بِكُمْ عَيْلَةٌ ، فَلَا يَنْقَلِبَنَّ أَحَدٌ مِنْكُمْ إِلَّا بِفِدَاءٍ ، أَوْ بِضَرْبَةِ عُنُقٍ ، قَالَ  عَبْدُ اللهِ  : قُلْتُ : إِلَّا  سَهْلَ بْنَ بَيْضَاءَ  فَلَا يُقْتَلُ ، فَقَدْ سَمِعْتُهُ يَتَكَلَّمُ بِالْإِسْلَامِ ، فَسَكَتَ ، فَمَا أَتَى عَلَيَّ يَوْمٌ كَانَ أَشَدَّ خَوْفًا عِنْدِي أَنْ يُلْقَى عَلَيَّ حِجَارَةٌ مِنَ السَّمَاءِ مِنْ يَوْمِي ذَلِكَ ،         [9/118]      حَتَّى قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِلَّا  سَهْلَ بْنَ بَيْضَاءَ  .","","Musnad Abi Ya'la al-Mawsili 5187","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عمرو بن مرة المرادي عن الأعمش عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5190","222 - (  5188  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كُنَّا نُسَلِّمُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ فِي الصَّلَاةِ فَيَرُدُّ عَلَيْنَا  ، فَلَمَّا رَجَعْنَا مِنْ عِنْدِ  النَّجَاشِيِّ  سَلَّمْنَا عَلَيْهِ فَلَمْ يَرُدَّ عَلَيْنَا ، فَقُلْنَا : يَا رَسُولَ اللهِ ، كُنَّا نُسَلِّمُ عَلَيْكَ فِي الصَّلَاةِ فَتَرُدُّ         [9/119]      عَلَيْنَا ، فَقَالَ : إِنَّ فِي الصَّلَاةِ لَشُغْلًا  .","","Musnad Abi Ya'la al-Mawsili 5188","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن محمد بن فضيل بن غزوان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5191","223 - (  5189  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  حَدَّثَنَا  مُطَرِّفُ بْنُ طَرِيفٍ ،  عَنْ  أَبِي الْجَهْمِ ،  عَنْ  أَبِي الرَّضْرَاضِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كُنَّا نُسَلِّمُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الصَّلَاةِ فَيَرُدُّ عَلَيْنَا  ، فَلَمَّا أَنْ كَانَ ذَاتَ يَوْمٍ سَلَّمْتُ عَلَيْهِ ، فَلَمْ يَرُدَّ عَلَيَّ ، فَوَجَدْتُ فِي نَفْسِي ، فَلَمَّا فَرَغَ قُلْتُ : يَا رَسُولَ اللهِ ، كُنْتُ إِذَا سَلَّمْتُ عَلَيْكَ فِي الصَّلَاةِ رَدَدْتَ عَلَيَّ ؟ قَالَ : فَقَالَ : إِنَّ اللهَ يُحْدِثُ مِنْ أَمْرِهِ مَا شَاءَ  .         [9/120]","","Musnad Abi Ya'la al-Mawsili 5189","","عبد الله بن مسعود عن رضراض بن أسعد عن سليمان بن الجهم الجوزجانى عن مطرف بن طريف عن محمد بن فضيل بن غزوان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5192","224 - (  5190  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  إِنَّ فَضْلَ صَلَاةِ الرَّجُلِ فِي الْجَمَاعَةِ تَزِيدُ عَلَى صَلَاتِهِ وَحْدَهُ  بِضْعًا         [9/121]      وَعِشْرِينَ دَرَجَةً  .","","Musnad Abi Ya'la al-Mawsili 5190","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5193","225 - (  5191  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  حَدَّثَنَا  هَارُونُ بْنُ عَنْتَرَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ، قَالَ :  اسْتَأْذَنَ  عَلْقَمَةُ  ،  وَالْأَسْوَدُ  عَلَى عَبْدِ اللهِ ، وَقَدْ كَانَا أَطَالَا الْقُعُودَ عَلَى بَابِهِ حَتَّى انْتَصَفَ النَّهَارُ ، قَالَ : فَخَرَجْتُ فَاسْتَأْذَنْتُ لَهُمَا ، فَأَذِنَ لَهُمَا ، فَقَالَ لَهُمَا : مَا لَكُمَا لَمْ تَدْخُلَا ؟ قَالَ : قَالَا : كُنَّا نَرَاكَ نَائِمًا ، قَالَ : مَا كُنْتُ أَشْتَهِي أَنْ تَظُنَّا بِي هَذَا ، إِنَّا كُنَّا نَعْدِلُ صَلَاةَ هَذِهِ السَّاعَةِ  بِصَلَاةِ اللَّيْلِ ، أَوْ نَحْوٍ مِنْ صَلَاةِ اللَّيْلِ  ، ثُمَّ قَالَ :  إِنَّكُمْ سَيَلِيكُمْ أُمَرَاءُ يُشْغَلُونَ عَنْ وَقْتِ الصَّلَاةِ ، فَصَلُّوهَا لِوَقْتِهَا  ، ثُمَّ قَامَ فَصَلَّى بَيْنَهُ وَبَيْنَهُ ، ثُمَّ قَالَ : هَكَذَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .         [9/122]","","Musnad Abi Ya'la al-Mawsili 5191","","عبد الله بن مسعود عن عبد الرحمن بن الأسود النخعي عن هارون بن عنترة الشيباني عن محمد بن فضيل بن غزوان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5194","226 - (  5192  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  كُنْتُ أَمْشِي مَعَ عَبْدِ اللهِ  بِمِنًى  فَلَقِيَ  عُثْمَانَ  فَقَامَ مَعَهُ يُحَدِّثُهُ ، فَقَالَ لَهُ  عُثْمَانُ  : يَا  أَبَا عَبْدِ الرَّحْمَنِ  أَلَا نُزَوِّجُكَ جَارِيَةً شَابَّةً لَعَلَّهَا تُذَكِّرُكَ مَا مَضَى مِنْ زَمَانِكَ ؟ قَالَ  عَبْدُ اللهِ  : أَمَا لَئِنْ قُلْتَ ذَاكَ ، لَقَدْ قَالَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا مَعْشَرَ الشَّبَابِ ، مَنِ اسْتَطَاعَ مِنْكُمُ  الْبَاءَةَ  فَلْيَتَزَوَّجْ ، فَإِنَّهُ أَغَضُّ لِلْبَصَرِ وَأَحْصَنُ لِلْفَرْجِ  ، وَمَنْ لَمْ يَسْتَطِعْ فَعَلَيْهِ بِالصَّوْمِ ، فَإِنَّهُ لَهُ  وِجَاءٌ  .","","Musnad Abi Ya'la al-Mawsili 5192","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5195","227 - (  5193  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  قَرَأَ عَبْدُ اللهِ سُورَةَ يُوسُفَ  بِحِمْصَ  ، فَقَالَ  رَجُلٌ  : مَا هَكَذَا أُنْزِلَتْ  ، فَدَنَا مِنْهُ  عَبْدُ اللهِ  ، فَوَجَدَ مِنْهُ رِيحَ الْخَمْرِ ، فَقَالَ تُكَذِّبُ بِالْحَقِّ ، وَتَشْرَبُ الرِّجْسَ ؟ وَاللهِ لَهَكَذَا أَقْرَأَنِيهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَاللهِ لَا أَدَعُكَ حَتَّى أَجْلِدَكَ  حَدًّا  ، قَالَ : فَجَلَدَهُ  الْحَدَّ  .         [9/123]","","Musnad Abi Ya'la al-Mawsili 5193","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5196","228 - (  5194  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ  ، قَالَ :  صَلَّى  عُثْمَانُ  بِمِنًى  أَرْبَعًا ، قَالَ : فَقَالَ لَهُ عَبْدُ اللهِ :  صَلَّيْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمِنًى  رَكْعَتَيْنِ  ، وَمَعَ  أَبِي بَكْرٍ  رَكْعَتَيْنِ ، وَمَعَ  عُمَرَ  رَكْعَتَيْنِ ، ثُمَّ  تَفَرَّقَتْ  بِكُمُ الطُّرُقُ ، وَلَوَدِدْتُ أَنَّ لِي مِنْ أَرْبَعِ رَكَعَاتٍ رَكْعَتَيْنِ مُتَقَبَّلَتَيْنِ  .         [9/124]","","Musnad Abi Ya'la al-Mawsili 5194","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5197","229 - (  5195  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  رَمَى عَبْدُ اللهِ جَمْرَةَ الْعَقَبَةِ مِنْ بَطْنِ الْوَادِي بِسَبْعِ حَصَيَاتٍ ، يُكَبِّرُ مَعَ كُلِّ حَصَاةٍ ، قَالَ : فَقِيلَ لَهُ : إِنَّ نَاسًا يَرْمُونَهَا مِنْ فَوْقِهَا ،  فَقَالَ  عَبْدُ اللهِ  :  هَذَا وَالَّذِي لَا إِلَهَ غَيْرُهُ مَقَامُ الَّذِي أُنْزِلَتْ عَلَيْهِ سُورَةُ الْبَقَرَةِ  .","","Musnad Abi Ya'la al-Mawsili 5195","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5198","230 - (  5196  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِنًى فَانْشَقَّ الْقَمَرُ  ،         [9/125]      حَتَّى ذَهَبَ فِرْقٌ مِنْهُ خَلْفَ الْجَبَلِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اشْهَدُوا  .","","Musnad Abi Ya'la al-Mawsili 5196","","عبد الله بن مسعود عن عبد الله بن سخبرة عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5199","231 - (  5197  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ حَلَفَ عَلَى يَمِينٍ وَهُوَ فِيهَا فَاجِرٌ لِيَقْطَعَ بِهَا مَالَ امْرِئٍ مُسْلِمٍ ، لَقِيَ اللهَ وَهُوَ عَلَيْهِ غَضْبَانُ  ، قَالَ  الْأَشْعَثُ  : فِيَّ وَاللهِ ، كَانَ ذَلِكَ بَيْنِي وَبَيْنَ رَجُلٍ مِنَ الْيَهُودِ أَرْضٌ فَجَحَدَنِي ، فَقَدَّمْتُهُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ لِي رَسُولُ اللهِ : أَلَكَ بَيِّنَةٌ ؟ قَالَ : قُلْتُ : لَا ، قَالَ لِلْيَهُودِيِّ : احْلِفْ ، قَالَ : فَقُلْتُ : يَا رَسُولَ اللهِ ، إِذًا يَحْلِفُ فَيَذْهَبُ بِمَالِي ، فَأَنْزَلَ اللهُ :         {      إِنَّ الَّذِينَ يَشْتَرُونَ بِعَهْدِ اللهِ وَأَيْمَانِهِمْ ثَمَنًا قَلِيلا         }      .         [9/126]","","Musnad Abi Ya'la al-Mawsili 5197","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5200","232 - (  5198  ) -  أَخْبَرَنَا  أَبُو يَعْلَى أَحْمَدُ بْنُ عَلِيِّ بْنِ الْمُثَنَّى الْمَوْصِلِيُّ ،  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَلِمَةً ، وَقُلْتُ أُخْرَى ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ مَاتَ وَهُوَ لَا يُشْرِكُ بِاللهِ شَيْئًا دَخَلَ الْجَنَّةَ  ، قَالَ : وَقُلْتُ أَنَا : وَمَنْ مَاتَ وَهُوَ يُشْرِكُ بِاللهِ شَيْئًا دَخَلَ النَّارَ  .","","Musnad Abi Ya'la al-Mawsili 5198","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5201","233 - (  5199  ) -  وَبِإِسْنَادِهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَا  فَرَطُكُمْ  عَلَى الْحَوْضِ ،  وَلَأُنَازَعَنَّ  أَقْوَامًا ثُمَّ لَأُغْلَبَنَّ عَلَيْهِمْ  ، فَأَقُولُ : يَا رَبِّ أَصْحَابِي ثُمَّ يَقُولُ : إِنَّكَ لَا تَدْرِي مَا أَحْدَثُوا بَعْدَكَ  .","","Musnad Abi Ya'la al-Mawsili 5199","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5202","234 - (  5200  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنْ  شِمْرٍ ،  عَنْ  مُغِيرَةَ بْنِ سَعْدِ بْنِ الْأَخْرَمِ ،  عَنْ  أَبِيهِ ،         [9/127]      عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَتَّخِذُوا  الضَّيْعَةَ  فَتَرْغَبُوا فِي الدُّنْيَا  ، ثُمَّ قَالَ عَبْدُ اللهِ :  وَبِالْمَدِينَةِ  مَا  بِالْمَدِينَةِ  ،  وَبِرَاذَانَ  مَا  بِرَاذَانَ  .","","Musnad Abi Ya'la al-Mawsili 5200","","عبد الله بن مسعود عن سعد بن الأخرم الطائي عن المغيرة بن سعد بن الأخرم الطائي عن شمر بن عطية الكاهلي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5203","235 - (  5201  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ مِنَّا مَنْ لَطَمَ الْخُدُودَ  ، وَشَقَّ الْجُيُوبَ ، وَدَعَا بِدَعْوَى أَهْلِ الْجَاهِلِيَّةِ  .         [9/128]","","Musnad Abi Ya'la al-Mawsili 5201","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5204","236 - (  5202  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَحِلُّ دَمُ امْرِئٍ مُسْلِمٍ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنِّي رَسُولُ اللهِ إِلَّا بِإِحْدَى ثَلَاثٍ  :  الثَّيِّبُ  الزَّانِي ، وَالنَّفْسُ بِالنَّفْسِ ،         [9/129]      وَالتَّارِكُ لِدِينِهِ الْمُفَارِقُ لِلْجَمَاعَةِ  .","","Musnad Abi Ya'la al-Mawsili 5202","","عبد الله بن مسعود عن مسروق بن الأجدع عن عبد الله بن مرة الخارفي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5205","237 - (  5203  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ ،         [9/130]      عَنْ  عَبْدِ اللهِ ، قَالَ :  إِذَا رَكَعَ أَحَدُكُمْ فَلْيَفْتَرِشْ ذِرَاعَيْهِ فَخِذَيْهِ ، وَلْيَجْنَأْ  ، قَالَ : فَكَأَنِّي أَنْظُرُ إِلَى اخْتِلَافِ أَصَابِعِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : ثُمَّ طَبَّقَ كَفَّيْهِ فَأَرَاهُمْ  .","","Musnad Abi Ya'la al-Mawsili 5203","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5206","238 - (  5204  ) -  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  عُمَارَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كُنْتُ مُسْتَتِرًا بِأَسْتَارِ  الْكَعْبَةِ  ، قَالَ : فَجَاءَ ثَلَاثَةُ نَفَرٍ ، كَثِيرٌ شَحْمُ بُطُونِهِمْ ، قَلِيلٌ فِقْهُ قُلُوبِهِمْ ، قَالَ :  قُرَشِيٌّ  وَخَتَنَاهُ  ثَقَفِيَّانِ ، أَوْ ثَقَفِيٌّ  وَخَتَنَاهُ  قُرَشِيَّانِ  ، فَتَكَلَّمُوا بِكَلَامٍ لَمْ أَفْهَمْهُ ، فَقَالَ بَعْضُهُمْ :  أَتُرَوْنَ اللهَ يَسْمَعُ كَلَامَنَا هَذَا ؟ قَالَ الْآخَرُ : إِذَا رَفَعْنَا أَصْوَاتَنَا سَمِعَهُ  ، وَإِذَا لَمْ نَرْفَعْهُ لَمْ يَسْمَعْهُ ، قَالَ الْآخَرُ : إِنْ سَمِعَ مِنْهُ شَيْئًا سَمِعَهُ كُلَّهُ ، قَالَ : فَذَكَرْتُ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَنَزَلَتْ عَلَيْهِ :         {      وَمَا كُنْتُمْ تَسْتَتِرُونَ أَنْ يَشْهَدَ عَلَيْكُمْ سَمْعُكُمْ وَلا أَبْصَارُكُمْ وَلا جُلُودُكُمْ         }      ، إِلَى قَوْلِهِ :         {      فَأَصْبَحْتُمْ مِنَ الْخَاسِرِينَ         }      .         [9/131]","","Musnad Abi Ya'la al-Mawsili 5204","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5207","239 - (  5205  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَأَنِّي أَنْظُرُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَحْكِي نَبِيًّا ضَرَبَهُ قَوْمُهُ  ، وَهُوَ يَمْسَحُ الدَّمَ عَنْ وَجْهِهِ ، وَيَقُولُ : رَبِّ         [9/132]      اغْفِرْ لِقَوْمِي فَإِنَّهُمْ لَا يَعْلَمُونَ  .","","Musnad Abi Ya'la al-Mawsili 5205","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5208","240 - (  5206  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ :  قَسَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَسْمًا ، فَقَالَ  رَجُلٌ مِنَ الْأَنْصَارِ  : إِنَّ هَذِهِ لَقِسْمَةٌ مَا أُرِيدَ بِهَا وَجْهُ اللهِ  ، قَالَ : فَقَالَ  عَبْدُ اللهِ  : فَقُلْتُ : يَا عَدُوَّ اللهِ ، أَنَا لَأُخْبِرَنَّ رَسُولَ اللهِ بِمَا قُلْتَ ، قَالَ : فَذَكَرْتُ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : فَاحْمَرَّ وَجْهُهُ ، وَقَالَ : رَحْمَةُ اللهِ عَلَى  مُوسَى  ، لَقَدْ أُوذِيَ بِأَكْثَرَ مِنْ هَذَا فَصَبَرَ  .","","Musnad Abi Ya'la al-Mawsili 5206","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5209","241 - (  5207  ) -  وَحَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنْ  أَبِي الْأَحْوَصِ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  لَأَنْ أَحْلِفَ بِاللهِ تِسْعًا أَنَّ  ابْنَ صَائِدٍ  هُوَ  الدَّجَّالُ  أَحَبُّ إِلَيَّ مِنْ أَنْ أَحْلِفَ وَاحِدَةً  ، وَلَأَنْ أَحْلِفَ تِسْعَةً : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قُتِلَ قَتْلًا أَحَبُّ إِلَيَّ مِنْ أَنْ أَحْلِفَ وَاحِدَةً ، وَذَلِكَ بِأَنَّ اللهَ اتَّخَذَهُ نَبِيًّا ، وَجَعَلَهُ شَهِيدًا  .         [9/133]","","Musnad Abi Ya'la al-Mawsili 5207","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عبد الله بن مرة الخارفي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5210","242 - (  5208  ) -  وَحَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنِ  ابْنِ أُخْتِ زَيْنَبَ ،  عَنْ  زَيْنَبَ امْرَأَةِ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  إِنَّ الرُّقَى  وَالتَّمَائِمَ  وَالتِّوَلَةَ  شِرْكٌ  ، قَالَتْ : فَقُلْتُ : لِمَ تَقُولُ هَذَا ؟ وَقَدْ كَانَتْ عَيْنِي تَقْذِفُ ، وَكُنْتُ أَخْتَلِفُ إِلَى فُلَانٍ الْيَهُودِيِّ فَيَرْقِيهَا ، كَانَ إِذَا رَقَاهَا سَكَنَتْ ، قَالَ : إِنَّمَا ذَاكَ عَمَلُ الشَّيْطَانِ ، كَانَ يَنْخُسُهَا بِيَدِهِ ، فَإِذَا رَقَيْتِهَا كَفَّ عَنْهَا ، إِنَّمَا كَانَ يَكْفِيكِ أَنْ تَقُولِي كَمَا قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَذْهِبِ الْبَأْسَ رَبَّ النَّاسِ ، وَاشْفِ وَأَنْتَ الشَّافِي شِفَاءً لَا يُغَادِرُ سَقَمًا  .         [9/134]","","Musnad Abi Ya'la al-Mawsili 5208","","عبد الله بن مسعود عن زينب بنت معاوية رائطة عن ابن أخي زينب الثقفية عن يحيى بن الجزار العرني عن عمرو بن مرة المرادي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5211","243 - (  5209  ) -  وَحَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  مُسْلِمٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَشَدَّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ الْمُصَوِّرُونَ  .","","Musnad Abi Ya'la al-Mawsili 5209","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5212","244 - (  5210  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  عَنْ  حَجَّاجٍ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ،  عَنْ  خِشْفِ بْنِ مَالِكٍ ،         [9/135]      عَنْ  عَبْدِ اللهِ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  جَعَلَ الدِّيَةَ فِي  الْخَطَأِ  أَخْمَاسًا  .         [9/136]","","Musnad Abi Ya'la al-Mawsili 5210","","عبد الله بن مسعود عن خشف بن مالك الطائي عن زيد بن جبير الطائي عن حجاج بن أرطاة عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5213","245 - (  5211  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَلْجَنَّةُ أَقْرَبُ إِلَى أَحَدِكُمْ مِنْ  شِرَاكِ  نَعْلِهِ  ، وَالنَّارُ مِثْلُ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 5211","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5214","246 - (  5212  ) -  وَعَنِ  الْأَعْمَشِ ،  عَنِ  الضَّحَّاكِ ، قَالَ :  كُنْتُ مَعَ  مَسْرُوقٍ  فِي صُفَّةٍ فِيهَا تَمَاثِيلُ ، فَنَظَرَ إِلَى تِمْثَالٍ مِنْهَا ، فَقَالُوا :         [9/137]      هَذَا تِمْثَالُ  مَرْيَمَ  ،  فَقَالَ  مَسْرُوقٌ :  قَالَ  عَبْدُ اللهِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَشَدُّ النَّاسِ عَذَابًا يَوْمَ الْقِيَامَةِ الْمُصَوِّرُونَ  .","","Musnad Abi Ya'la al-Mawsili 5212","","عبد الله بن مسعود عن مسروق بن الأجدع عن الضحاك بن شراحيل المشرقي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5215","247 - (  5213  ) -  وَعَنْ  وَكِيعٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ السَّائِبِ ،  عَنْ  زَاذَانَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ لِلهِ مَلَائِكَةً سَيَّاحِينَ فِي الْأَرْضِ يُبَلِّغُونِي عَنْ أُمَّتِي السَّلَامَ  .         [9/138]","","Musnad Abi Ya'la al-Mawsili 5213","","عبد الله بن مسعود عن زاذان الكندي عن عبد الله بن السائب الكندي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5216","248 - (  5214  ) -  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ شِمَالِهِ : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ  ، السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ حَتَّى يُرَى بَيَاضُ خَدِّهِ  .","","Musnad Abi Ya'la al-Mawsili 5214","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5217","249 - (  5215  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَوَّلُ مَا يُقْضَى بَيْنَ النَّاسِ يَوْمَ الْقِيَامَةِ فِي الدِّمَاءِ  .","","Musnad Abi Ya'la al-Mawsili 5215","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5218","250 - (  5216  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ :  كَأَنِّي أَنْظُرُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَحْكِي نَبِيًّا مِنَ الْأَنْبِيَاءِ ضَرَبَهُ قَوْمُهُ فَهُوَ  يَنْضَحُ  الدَّمَ عَنْ وَجْهِهِ  وَيَقُولُ : رَبِّ اغْفِرْ لِقَوْمِي فَإِنَّهُمْ لَا يَعْلَمُونَ  .","","Musnad Abi Ya'la al-Mawsili 5216","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5219","251 - (  5217  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  أَبِيهِ ،         [9/139]      عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ سَأَلَ وَلَهُ مَالٌ يُغْنِيهِ جَاءَتْ يَوْمَ الْقِيَامَةِ  خُدُوشًا ،  كُدُوحًا  فِي وَجْهِهِ  ، قَالُوا : يَا رَسُولَ اللهِ ، وَمَا غِنَاهُ ؟ قَالَ : خَمْسُونَ دِرْهَمًا أَوْ حِسَابُهَا مِنَ الذَّهَبِ  .         [9/140]","","Musnad Abi Ya'la al-Mawsili 5217","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن محمد بن عبد الرحمن بن يزيد النخعي عن حكيم بن جبير الأسدي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5220","252 - (  5218  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ ،  عَنِ  ابْنِ مَسْعُودٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَجَدَ فِي النَّجْمِ وَسَجَدَ الْمُسْلِمُونَ  ، إِلَّا  رَجُلًا مِنْ قُرَيْشٍ  ، أَخَذَ كَفًّا مِنْ تُرَابٍ فَرَفَعَهُ إِلَى جَبْهَتِهِ فَسَجَدَ عَلَيْهِ ، قَالَ  عَبْدُ اللهِ  : فَرَأَيْتُهُ قُتِلَ كَافِرًا  .","","Musnad Abi Ya'la al-Mawsili 5218","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5221","253 - (  5219  ) -  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  عِيسَى بْنِ عَاصِمٍ الْأَسَدِيِّ ،  عَنْ  زِرٍّ ،         [9/141]      عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الطِّيَرَةُ  شِرْكٌ ،  وَمَا مِنَّا إِلَّا ... وَلَكِنَّ اللهَ يُذْهِبُهُ بِالتَّوَكُّلِ  .","","Musnad Abi Ya'la al-Mawsili 5219","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عيسى بن عاصم الأسدي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5222","254 - (  5220  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا كُنْتُمْ ثَلَاثَةً فَلَا  يَتَنَاجَى  اثْنَانِ دُونَ وَاحِدٍ ، فَإِنَّ ذَلِكَ يُحْزِنُهُ  .","","Musnad Abi Ya'la al-Mawsili 5220","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5223","255 - (  5221  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  حَارِثَةَ بْنِ مُضَرِّبٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ  لِابْنِ النَّوَّاحَةِ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  لَوْلَا أَنَّكَ رَسُولٌ لَقَتَلْتُكَ ، فَأَمَّا الْيَوْمَ ، فَلَسْتَ بِرَسُولٍ ، قُمْ يَا  خَرَشَةُ  فَاضْرِبْ عُنُقَهُ  .         [9/142]","","Musnad Abi Ya'la al-Mawsili 5221","","عبد الله بن مسعود عن حارثة بن مضرب العبدي عن أبو إسحاق السبيعي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5224","256 - (  5222  ) -  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  شَقِيقٍ ،  قَالَ  :  جَاءَ رَجُلٌ إِلَى عَبْدِ اللهِ ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، كَيْفَ تَقْرَأُ هَذِهِ الْآيَةَ :         {      مِنْ مَاءٍ غَيْرِ آسِنٍ         }      ؟  قَالَ : فَقَالَ لَهُ  عَبْدُ اللهِ  : كُلَّ الْقُرْآنِ قَدْ  أَحْصَيْتَ  غَيْرَ هَذَا ؟ قَالَ : إِنِّي لَأَقْرَأُ الْمُفَصَّلَ فِي رَكْعَةٍ ، فَقَالَ لَهُ  عَبْدُ اللهِ  :  هَذًّا  كَهَذِّ  الشِّعْرِ ؟ إِنَّ مِنْ أَحْسَنِ الصَّلَاةِ الرُّكُوعَ وَالسُّجُودَ ، وَلَيَقْرَأَنَّ الْقُرْآنَ أَقْوَامٌ لَا يُجَاوِزُ  تَرَاقِيَهُمْ  ، وَلَكِنَّهُ إِذَا قُرِئَ فَرَسَخَ فِي الْقَلْبِ نَفَعَ ،  إِنِّي لَأَعْرِفُ  النَّظَائِرَ  الَّتِي كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ فِي كُلِّ رَكْعَةٍ  ، ثُمَّ قَامَ ، فَدَخَلَ عَلَيْهِ  عَلْقَمَةُ  ، ثُمَّ قَالَ : سَلْهُ لَنَا عَنِ  النَّظَائِرِ  الَّتِي كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ بِهَا ، قَالَ : ثُمَّ خَرَجَ إِلَيْنَا ، فَقَالَ : عِشْرُونَ سُورَةً مِنَ الْمُفَصَّلِ فِي تَأْلِيفِ  عَبْدِ اللهِ  .         [9/143]             [9/144]","","Musnad Abi Ya'la al-Mawsili 5222","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5225","257 - (  5223  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ :  كُنَّا نَمْشِي مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَرَّ  بِابْنِ الصَّيَّادِ  ، فَقَالَ رَسُولُ اللهِ : قَدْ خَبَّأْتُ لَكَ خَبِيئًا  ، فَقَالَ  ابْنُ الصَّيَّادِ  :  الدُّخُّ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اخْسَأْ ، فَلَنْ تَعْدُوَ قَدْرَكَ  .         [9/145]","","Musnad Abi Ya'la al-Mawsili 5223","","عبد الله بن مسعود عن حارثة بن مضرب العبدي عن أبو إسحاق السبيعي عن الأعمش عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5226","258 - (  5224  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ خَازِمٍ ،  عَنْ  حَجَّاجٍ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَنَامُ مُسْتَلْقِيًا حَتَّى         [9/146]      يَنْفُخَ ، ثُمَّ يَقُومُ فَيُصَلِّي وَلَا يَتَوَضَّأُ  .","","Musnad Abi Ya'la al-Mawsili 5224","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن حجاج بن أرطاة عن أبو معاوية الضرير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5227","259 - (  5225  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  إِبْرَاهِيمَ ،  قَالَ  :  صَلَّى بِنَا عَلْقَمَةُ فَصَلَّى خَمْسًا ، فَعَاثَ  الْقَوْمُ  وَعَابُوهُ ، قَالَ : فَقُلْتُ : قَدْ فَعَلْتَ ، قَالَ : وَأَنْتَ يَا  أَعْوَرُ  تَقُولُ ذَلِكَ ؟ قَالَ : فَانْفَتَلَ فَسَجَدَ سَجْدَتَيْنِ ، ثُمَّ  حَدَّثَهُمْ  ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى بِهِمْ خَمْسًا ، فَقِيلَ لَهُ فِي ذَلِكَ ، فَانْفَتَلَ فَسَجَدَ سَجْدَتَيْنِ  ، وَقَالَ : إِنَّمَا أَنَا بَشَرٌ أَنْسَى كَمَا تَنْسَوْنَ  .","","Musnad Abi Ya'la al-Mawsili 5225","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الحسن بن عبيد الله النخعي عن عبد الله بن إدريس الأودي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5228","260 - (  5226  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  ابْنُ إِدْرِيسَ ، قَالَ :  سَمِعْتُ  الْأَعْمَشَ ،  يَذْكُرُ عَنْ  شَقِيقٍ ،  قَالَ  :         [9/147]      كَانَ عَبْدُ اللهِ يَخْرُجُ إِلَيْنَا ، فَيَقُولُ :  إِنِّي لَأُخْبَرُ بِمَكَانِكُمْ ، فَمَا يَمْنَعُنِي أَنْ أَخْرُجَ إِلَيْكُمْ إِلَّا كَرَاهِيَةُ أَنْ أُمِلَّكُمْ  ، إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ  يَتَخَوَّلُنَا  بِالْمَوْعِظَةِ فِي الْأَيَّامِ كَرَاهِيَةَ السَّآمَةِ عَلَيْنَا  .","","Musnad Abi Ya'la al-Mawsili 5226","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن عبد الله بن إدريس الأودي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5229","261 - (  5227  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  حَسَدَ  إِلَّا فِي اثْنَتَيْنِ  : رَجُلٌ آتَاهُ اللهُ مَالًا فَسَلَّطَهُ عَلَى هَلَكَتِهِ فِي الْحَقِّ ، وَرَجُلٍ آتَاهُ اللهُ الْحِكْمَةَ فَهُوَ يَقْضِي بِهَا وَيُعَلِّمُهَا  .","","Musnad Abi Ya'la al-Mawsili 5227","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5230","262 - (  5228  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبِيدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اقْرَأْ عَلَيَّ ، قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، كَيْفَ أَقْرَأُ عَلَيْكَ ، وَإِنَّمَا أُنْزِلَ عَلَيْكَ  ؟ قَالَ : إِنِّي أُحِبُّ أَنْ أَسْمَعَهُ مِنْ غَيْرِي ، قَالَ : فَقَرَأْتُ عَلَيْهِ سُورَةَ النِّسَاءِ ، حَتَّى مَرَرْتُ بِهَذِهِ الْآيَةِ :         {      فَكَيْفَ إِذَا جِئْنَا مِنْ كُلِّ أُمَّةٍ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَى هَؤُلاءِ شَهِيدًا         }      قَالَ : فَنَظَرْتُ إِلَيْهِ وَعَيْنَاهُ تَذْرِفَانِ  .         [9/148]","","Musnad Abi Ya'la al-Mawsili 5228","","عبد الله بن مسعود عن عبيدة بن عمرو السلماني عن إبراهيم النخعي عن الأعمش عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5231","263 - (  5229  ) -  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَا لِي وَلِلدُّنْيَا ، إِنَّمَا مَثَلِي وَمَثَلُ الدُّنْيَا كَمَثَلِ رَاكِبٍ قَالَ فِي ظِلِّ شَجَرَةٍ  فِي يَوْمِ صَيْفٍ فَرَاحَ وَتَرَكَهَا  .","","Musnad Abi Ya'la al-Mawsili 5229","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5232","264 - (  5230  ) -  حَدَّثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَمَّا أُنْزِلَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      إِذَا جَاءَ نَصْرُ اللهِ وَالْفَتْحُ         }      كَانَ يُكْثِرُ إِذَا قَرَأَهَا وَرَكَعَ  أَنْ يَقُولَ : سُبْحَانَكَ اللَّهُمَّ رَبَّنَا  وَبِحَمْدِكَ ،  اللَّهُمَّ اغْفِرْ لِي ، إِنَّكَ أَنْتَ التَّوَّابُ الرَّحِيمُ ، ثَلَاثًا  .         [9/149]","","Musnad Abi Ya'la al-Mawsili 5230","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5233","265 - (  5231  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ :  نَفَّلَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَيْفَ  أَبِي جَهْلٍ  يَوْمَ بَدْرٍ  .","","Musnad Abi Ya'la al-Mawsili 5231","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5234","266 - (  5232  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ، وَيَحْيَى بْنُ سَعِيدٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الرَّكْعَتَيْنِ كَأَنَّهُ عَلَى الْجَمْرِ ، قُلْتُ : حَتَّى يَقُومَ  ؟ قَالَ : حَتَّى يَقُومَ ، قَالَ  وَكِيعٌ  : عَلَى الرَّضْفِ  .         [9/150]","","Musnad Abi Ya'la al-Mawsili 5232","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5235","267 - (  5233  ) -  وَحَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ فِي خُطْبَةِ الْحَاجَةِ :  إِنَّ الْحَمْدَ لِلهِ نَسْتَعِينُهُ وَنَسْتَغْفِرُهُ وَنَعُوذُ بِاللهِ مِنْ شُرُورِ أَنْفُسِنَا ، مَنْ يَهْدِهِ اللهُ فَلَا مُضِلَّ         [9/151]      لَهُ  ، وَمَنْ يُضْلِلْ فَلَا هَادِيَ لَهُ ، وَأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا هُوَ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، ثُمَّ يَقْرَأُ بِآيَاتٍ مِنْ كِتَابِ اللهِ         {      اتَّقُوا اللهَ حَقَّ تُقَاتِهِ وَلا تَمُوتُنَّ إِلا وَأَنْتُمْ مُسْلِمُونَ         }      ،         {      وَاتَّقُوا اللهَ الَّذِي تَسَاءَلُونَ بِهِ وَالأَرْحَامَ إِنَّ اللهَ كَانَ عَلَيْكُمْ رَقِيبًا         }      ،         {      اتَّقُوا اللهَ وَقُولُوا قَوْلا سَدِيدًا             *          يُصْلِحْ لَكُمْ أَعْمَالَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَمَنْ يُطِعِ اللهَ وَرَسُولَهُ فَقَدْ فَازَ فَوْزًا عَظِيمًا         }      .         [9/152]","","Musnad Abi Ya'la al-Mawsili 5233","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5236","268 - (  5234  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ وَأَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 5234","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5237","269 - (  5235  ) -  حَدَّثَنَا  وَكِيعٌ  ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي قَيْسٍ ،  عَنْ  هُزَيْلٍ ، قَالَ :  جَاءَ رَجُلٌ إِلَى أَبِي مُوسَى وَسَلْمَانَ بْنِ رَبِيعَةَ فَسَأَلَهُمَا عَنِ ابْنَةٍ ، وَابْنَةِ ابْنٍ  ، وَأُخْتٍ لِأَبٍ ، وَأُمٍّ ،  فَقَالَا  : لِلِابْنَةِ النِّصْفُ ، وَمَا بَقِيَ فَلِلْأُخْتِ ، فَأَتَى الرَّجُلُ عَبْدَ اللهِ فَسَأَلَهُ ، فَأَخْبَرَهُ بِمَا قَالَا ،  فَقَالَ  :         {      قَدْ ضَلَلْتُ إِذًا وَمَا أَنَا مِنَ الْمُهْتَدِينَ         }      ، وَلَكِنْ أَقْضِي بِمَا قَضَى بِهِ         [9/153]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِلِابْنَةِ النِّصْفُ ، وَلِابْنَةِ الِابْنِ السُّدُسُ ، تَكْمِلَةُ الثُّلُثَيْنِ ، وَمَا بَقِيَ فَلِلْأُخْتِ  .","","Musnad Abi Ya'la al-Mawsili 5235","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5238","270 - (  5236  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَابِعُوا بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ ، فَإِنَّهُمَا يَنْفِيَانِ الْفَقْرَ وَالذُّنُوبَ  ، كَمَا يَنْفِي  الْكِيرُ  خَبَثَ  الْحَدِيدِ وَالذَّهَبِ وَالْفِضَّةِ ، وَلَيْسَ لِلْحَجِّ  الْمَبْرُورِ  ثَوَابٌ إِلَّا الْجَنَّةَ  .","","Musnad Abi Ya'la al-Mawsili 5236","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن عمرو بن قيس الملائي عن سليمان بن حيان الأحمر عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5239","271 - (  5237  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  دَاوُدَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  قُلْتُ  لِابْنِ مَسْعُودٍ : هَلْ صَحِبَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيْلَةَ الْجِنِّ مِنْكُمْ أَحَدٌ ؟ قَالَ : فَقَالَ : مَا صَحِبَهُ مِنَّا أَحَدٌ ، وَلَكِنَّا فَقَدْنَاهُ ذَاتَ لَيْلَةٍ  بِمَكَّةَ  فَقُلْنَا : اغْتِيلَ ،  اسْتُطِيرَ  ، فَبِتْنَا بِشَرِّ لَيْلَةٍ بَاتَ بِهَا قَوْمٌ ، فَلَمَّا كَانَ مِنَ  السَّحَرِ - أَوْ قَالَ : الصُّبْحِ -  إِذَا نَحْنُ بِهِ مِنْ قِبَلِ  حِرَاءٍ  ،         [9/154]      فَقُلْنَا : يَا رَسُولَ اللهِ ، فَذَكَرُوا لَهُ الَّذِي كَانُوا فِيهِ ، فَقَالَ :  إِنَّهُ أَتَانِي دَاعِي الْجِنِّ ، فَأَتَيْتُ فَقَرَأْتُ عَلَيْهِمْ ، فَانْطَلَقَ فَأَرَانَا آثَارَهُمْ وَآثَارَ نِيرَانِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 5237","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن الشعبي عن داود بن أبي هند عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5240","272 - (  5238  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنِ  التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَمْنَعَنَّ أَحَدَكُمْ  أَذَانُ  بِلَالٍ  - أَوْ قَالَ :  نِدَاءُ  بِلَالٍ  -  مِنْ سَحُورِهِ ، فَإِنَّهُ  يُؤَذِّنُ - أَوْ قَالَ : يُنَادِي -  بِلَيْلٍ  ،  لِيَرْجِعَ  قَائِلَكُمْ ، وَيُوقِظَ نَائِمَكُمْ ، وَقَالَ : لَيْسَ أَنْ تَقُولَ هَكَذَا وَهَكَذَا ،  وَصَوَّبَ  يَدَهُ وَرَفَعَهَا حَتَّى يَقُولَ هَكَذَا ، وَفَرَّجَ بَيْنَ أَصَابِعِهِ  .         [9/155]","","Musnad Abi Ya'la al-Mawsili 5238","","عبد الله بن مسعود عن أبو عثمان النهدي عن سليمان بن طرخان عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5241","273 - (  5239  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  حَدَّثَنَا  التَّيْمِيُّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ  تَلَقِّي  السِّلَعِ  .         [9/156]","","Musnad Abi Ya'la al-Mawsili 5239","","عبد الله بن مسعود عن أبو عثمان النهدي عن سليمان بن طرخان عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5242","274 - (  5240  ) -  وَعَنِ  ابْنِ مَسْعُودٍ ،  أَنَّ  رَجُلًا  أَصَابَ مِنِ امْرَأَةٍ قُبْلَةً ، فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَنَزَلَتْ هَذِهِ الْآيَةُ :         {      وَأَقِمِ الصَّلاةَ طَرَفَيِ النَّهَارِ         }      ، فَقَالَ : يَا رَسُولَ اللهِ ، أَلِي هَذِهِ ؟ قَالَ : وَلِمَنْ عَمِلَ بِهَا مِنْ أُمَّتِي  .         [9/157]","","Musnad Abi Ya'la al-Mawsili 5240","","عبد الله بن مسعود عن أبو عثمان النهدي عن سليمان بن طرخان عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5243","275 - (  5241  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُرَّةَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  آكِلُ  الرِّبَا ، وَمُوكِلُهُ ، وَكَاتِبُهُ ، وَشَاهِدَاهُ إِذَا عَلِمُوا بِهِ  ،  وَالْوَاشِمَةُ  وَالْمُوتَشِمَةُ ، وَلَاوِي الصَّدَقَةِ ، وَالْمُرْتَدُّ أَعْرَابِيًّا بَعْدَ هِجْرَتِهِ مَلْعُونُونَ عَلَى لِسَانِ  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .         [9/158]","","Musnad Abi Ya'la al-Mawsili 5241","","عبد الله بن مسعود عن الحارث الأعور عن عبد الله بن مرة الخارفي عن الأعمش عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5244","276 - (  5242  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  سُلَيْمَانُ بْنُ عَتِيقٍ ،  عَنْ  طَلْقِ بْنِ حَبِيبٍ ،  عَنِ  الْأَحْنَفِ بْنِ قَيْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  أَلَا هَلَكَ  الْمُتَنَطِّعُونَ ،  ثَلَاثَ مَرَّاتٍ  .","","Musnad Abi Ya'la al-Mawsili 5242","","عبد الله بن مسعود عن الأحنف بن قيس السعدي عن طلق بن حبيب العنزي عن سليمان بن عتيق المحاربي عن ابن جريج عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5245","277 - (  5243  ) -  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي يَعْلَى ،  عَنِ  الرَّبِيعِ بْنِ خُثَيْمٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  خَطَّ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَطًّا مُرَبَّعًا ، وَخَطَّ وَسَطَهُ خُطُوطًا  هَكَذَا إِلَى جَانِبِ  الْخَطِّ  ، وَخَطَّ خَطًّا خَارِجًا ، فَقَالَ : أَتَدْرُونَ مَا هَذَا ؟ فَقُلْنَا : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ : هَذَا الْإِنْسَانُ -  لِلْخَطِّ الَّذِي وَسَطَ  الْخَطِّ  - ، وَهَذَا الْأَجَلُ ، وَهَذِهِ الْأَعْرَاضُ -  لِلْخُطُوطِ  - تَنْهَشُهُ ، إِذَا أَخْطَأَهُ هَذَا أَصَابَهُ هَذَا ، وَذَلِكَ الْأَمَلُ -  لِلْخَطِّ الْخَارِجِ  - .         [9/159]","","Musnad Abi Ya'la al-Mawsili 5243","","عبد الله بن مسعود عن الربيع بن خثيم الثوري عن المنذر بن يعلى الثوري عن سعيد بن مسروق الثوري عن سفيان الثوري عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5246","278 - (  5244  ) -  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ،  عَنِ  الْحَكَمِ ، وَمَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  أَنَّ أَمِيرًا  بِمَكَّةَ  كَانَ يُسَلِّمُ تَسْلِيمَتَيْنِ ، فَقَالَ عَبْدُ اللهِ : أَنَّى  عَلِقَهَا  ؟ فَقَالَ  الْحَكَمُ  فِي حَدِيثِهِ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَفْعَلُهُ  .         [9/160]","","Musnad Abi Ya'la al-Mawsili 5244","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5247","279 - (  5245  ) -  حَدَّثَنَا  يَحْيَى ،  عَنْ  سُفْيَانَ ،  حَدَّثَنِي  سُلَيْمَانُ ،  عَنْ  عُمَارَةَ ،  عَنْ  وَهْبِ بْنِ رَبِيعَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  إِنِّي لَمُسْتَتِرٌ بِأَسْتَارِ  الْكَعْبَةِ  إِذْ دَخَلَ ثَلَاثَةُ نَفَرٍ : ثَقَفِيٌّ  وَخَتَنَاهُ  قُرَشِيَّانِ  ، فَتَحَدَّثُوا بَيْنَهُمْ بِحَدِيثٍ ، فَقَالَ أَحَدُهُمْ : أَتُرَى اللهَ يَسْمَعُ مَا قُلْنَا ؟ قَالَ أَحَدُهُمْ : يَسْمَعُ إِذَا رَفَعْنَا ، وَلَا يَسْمَعُ إِذَا خَفَضْنَا ، وَقَالَ الْآخَرُ : إِنْ كَانَ يَسْمَعُ مِنَّا شَيْئًا ، فَإِنَّهُ يَسْمَعُهُ كُلَّهُ ، فَأَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرْتُ ذَلِكَ لَهُ ، فَنَزَلَتْ هَذِهِ الْآيَةُ :         {      وَمَا كُنْتُمْ تَسْتَتِرُونَ أَنْ يَشْهَدَ عَلَيْكُمْ         }      الْآيَةَ  .","","Musnad Abi Ya'la al-Mawsili 5245","","عبد الله بن مسعود عن وهب بن ربيعة الكوفي عن عمارة بن عمير التيمي عن الأعمش عن سفيان الثوري عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5248","280 - (  5246  ) -  حَدَّثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  سُفْيَانَ ، قَالَ :  حَدَّثَنِي  مَنْصُورٌ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ ، بِنَحْوِهِ .","","Musnad Abi Ya'la al-Mawsili 5246","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن يحيى القطان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5249","281 - (  5247  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِرَجُلٍ  :  لَوْلَا أَنَّكَ رَسُولٌ         [9/161]      لَقَتَلْتُكَ  -  يَعْنِي : رَسُولَ  مُسَيْلِمَةَ  - .","","Musnad Abi Ya'la al-Mawsili 5247","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5250","282 - (  5248  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا تَقُومُ السَّاعَةُ إِلَّا عَلَى شِرَارِ النَّاسِ  .","","Musnad Abi Ya'la al-Mawsili 5248","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن علي بن الأقمر عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5251","283 - (  5249  ) -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  شُعْبَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ رَجَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَوْ كُنْتُ مُتَّخِذًا  خَلِيلًا  لَاتَّخَذْتُ  أَبَا بَكْرٍ  خَلِيلًا ،  وَلَكِنَّهُ أَخِي وَصَاحِبِي  ، وَقَدِ اتَّخَذَ اللهُ صَاحِبَكُمْ  خَلِيلًا  .","","Musnad Abi Ya'la al-Mawsili 5249","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن عبد الله بن أبي الهذيل الغنوي عن إسماعيل بن رجاء الزبيدي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5252","284 - (  5250  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،         [9/162]      عَنْ  سُفْيَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ رَآنِي فِي الْمَنَامِ فَقَدْ رَآنِي  ، فَإِنَّ الشَّيْطَانَ لَا يَتَمَثَّلُ بِي  .","","Musnad Abi Ya'la al-Mawsili 5250","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5253","285 - (  5251  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا ،  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .         [9/163]","","Musnad Abi Ya'la al-Mawsili 5251","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5254","286 - (  5252  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  زُبَيْدٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَيْسَ مِنَّا مَنْ ضَرَبَ الْخُدُودَ  ، وَشَقَّ الْجُيُوبَ ، وَدَعَا بِدَعْوَى الْجَاهِلِيَّةِ  .","","Musnad Abi Ya'la al-Mawsili 5252","","عبد الله بن مسعود عن مسروق بن الأجدع عن إبراهيم النخعي عن زبيد بن الحارث اليامي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5255","287 - (  5253  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي قَتَادَةَ ،  عَنْ  أُسَيْرِ بْنِ جَابِرٍ ، قَالَ :         [9/164]      هَاجَتْ رِيحٌ وَنَحْنُ عِنْدَ عَبْدِ اللهِ ، فَغَضِبَ  ابْنُ مَسْعُودٍ  حَتَّى عَرَفْنَا الْغَضَبَ فِي وَجْهِهِ ، قَالَ : وَيْحَكَ ! إِنَّ السَّاعَةَ لَا تَقُومُ حَتَّى لَا يُقْسَمَ مِيرَاثٌ ، وَلَا يُفْرَحَ بِغَنِيمَةٍ ، ثُمَّ ضَرَبَ بِيَدِهِ إِلَى  الشَّامِ  ، وَقَالَ : عَدُوٌّ يَجْتَمِعُ لِلْمُسْلِمِينَ مِنْ هَاهُنَا ، فَيَلْتَقُونَ ، فَيَشْتَرِطُ  شُرْطَةً  لِلْمَوْتِ وَلَا تَرْجِعُ إِلَّا وَهِيَ غَالِبَةٌ ، فَيَقْتَتِلُونَ حَتَّى تَغِيبَ الشَّمْسُ مِنْ هَاهُنَا ، فَيَلْتَقُونَ فَيَشْتَرِطُ  شُرْطَةً  لِلْمَوْتِ وَلَا تَرْجِعُ إِلَّا وَهِيَ غَالِبَةٌ ، فَيَقْتَتِلُونَ حَتَّى تَغِيبَ الشَّمْسُ وَكُلٌّ غَيْرُ غَالِبٍ ، وَتَفْنَى الشُّرْطَةُ ، ثُمَّ يَشْتَرِطُ  شُرْطَةً  لِلْمَوْتِ لَا تَرْجِعُ إِلَّا وَهِيَ غَالِبَةٌ ، فَيَقْتَتِلُونَ حَتَّى تَغِيبَ الشَّمْسُ ، فَيَفِيءُ هَؤُلَاءِ وَهَؤُلَاءِ وَكُلٌّ غَيْرُ غَالِبٍ ، وَتَفْنَى الشُّرْطَةُ ، ثُمَّ يَلْتَقُونَ فِي الْيَوْمِ الرَّابِعِ فَيَقْتُلُونَهُمْ وَيَهْزِمُونَهُمْ حَتَّى تَبْلُغَ الدِّمَاءُ ثُنَنَ الْخَيْلِ ، وَيَقْتَتِلُونَ حَتَّى إِنَّ بَنِي الْأَبِ كَانُوا  يَتَعَادُّونَ  عَلَى مِائَةٍ فَيُقْتَلُونَ لَا يَبْقَى مِنْهُمْ رَجُلٌ ، فَأَيُّ مِيرَاثٍ يُقْسَمُ بَعْدَ هَذَا ؟ وَأَيُّ غَنِيمَةٍ يُفْرَحُ بِهَا ؟         [9/165]      ثُمَّ يَسْتَفْتِحُونَ  الْقُسْطَنْطِينَةَ  ، فَبَيْنَا هُمْ يَقْسِمُونَ الدَّنَانِيرَ بِالتِّرَسَةِ إِذْ أَتَاهُمْ فَزَعٌ أَكْبَرُ مِنْ ذَلِكَ : أَنَّ  الدَّجَّالَ  قَدْ خَلَفَ فِي ذَرَارِيكُمْ ، فَيَرْفُضُونَ مَا فِي أَيْدِيهِمْ ، وَيُقْبِلُونَ وَيَبْعَثُونَ طَلِيعَةَ الْفَوَارِسِ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هُمْ يَوْمَئِذٍ خَيْرُ فَوَارِسِ الْأَرْضِ ، إِنِّي لَأَعْلَمُ أَسْمَاءَهُمْ وَأَسْمَاءَ آبَائِهِمْ وَقَبَائِلِهِمْ وَأَلْوَانَ خُيُولِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 5253","","عبد الله بن مسعود عن يسير بن عمرو الكندي عن أبو قتادة العدوي عن حميد بن هلال العدوي عن جرير بن حازم عن وهب بن جرير بن حازم عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5256","288 - (  5254  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  الْمُعْتَمِرُ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  أَبِي عُثْمَانَ ،  عَنِ  ابْنِ مَسْعُودٍ ،  قَالَ :  مَنِ اشْتَرَى  مُحَفَّلَةً  فَرَدَّهَا فَلْيَرُدَّ مَعَهَا         [9/166]      صَاعًا  ،  قَالَ :  وَنَهَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ  تَلَقِّي  السِّلَعِ  .","","Musnad Abi Ya'la al-Mawsili 5254","","عبد الله بن مسعود عن أبو عثمان النهدي عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5257","289 - (  5255  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا كُنْتُمْ ثَلَاثَةً فَلَا         [9/167]      يَتَنَاجَى  اثْنَانِ دُونَ الْآخَرِ ، فَإِنَّ ذَلِكَ يُحْزِنُهُ  .","","Musnad Abi Ya'la al-Mawsili 5255","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن عبد الواحد بن زياد عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5258","290 - (  5256  ) -  حَدَّثَنَا  مُحَمَّدٌ ،  حَدَّثَنَا  الْفُضَيْلُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ مُطَرِّفٍ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ :  مَا كَانَ بَيْنَ إِسْلَامِنَا وَبَيْنَ أَنْ عُوتِبْنَا بِهَذِهِ الْآيَةِ إِلَّا أَرْبَعُ سِنِينَ         {      أَلَمْ يَأْنِ لِلَّذِينَ آمَنُوا أَنْ تَخْشَعَ قُلُوبُهُمْ لِذِكْرِ اللهِ وَمَا نَـزَلَ مِنَ الْحَقِّ         }      وَأَقْبَلَ بَعْضُنَا عَلَى بَعْضٍ : أَيُّ شَيْءٍ أَحْدَثْنَا ؟ أَيُّ شَيْءٍ صَنَعْنَا ؟  .         [9/168]","","Musnad Abi Ya'la al-Mawsili 5256","","عبد الله بن مسعود عن عون بن عبد الله بن عتبة عن سلمة بن دينار الأعرج عن محمد بن مطرف بن داود عن فضيل بن سليمان النميري عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5259","291 - (  5257  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَحْيَى ،  عَنْ  شُعْبَةَ ، وَسُفْيَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ  -  لَمْ يَرْفَعْهُ  سُفْيَانُ  ،  وَرَفَعَهُ  شُعْبَةُ  - قَالَ :  عَلَّمَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خُطْبَةَ الْحَاجَةِ  ، قَالَ  سُفْيَانُ  : إِنَّ الْحَمْدَ لِلهِ وَقَالَ  شُعْبَةُ  : الْحَمْدُ لِلهِ نَحْمَدُهُ وَنَسْتَعِينُهُ ، قَالَ  سُفْيَانُ  : نَعُوذُ بِهِ ، وَقَالَ  شُعْبَةُ  : نَعُوذُ بِاللهِ مِنْ شُرُورِ أَنْفُسِنَا ، مَنْ يَهْدِهِ اللهُ فَلَا مُضِلَّ لَهُ ، وَمَنْ يُضْلِلْ فَلَا هَادِيَ لَهُ ، وَأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، ثُمَّ يَقْرَأُ ثَلَاثَ آيَاتٍ :         {      اتَّقُوا اللهَ حَقَّ تُقَاتِهِ وَلا تَمُوتُنَّ إِلا وَأَنْتُمْ مُسْلِمُونَ         }      ،         {      وَاتَّقُوا اللهَ الَّذِي تَسَاءَلُونَ بِهِ وَالأَرْحَامَ         }      ،         {      اتَّقُوا اللهَ وَقُولُوا قَوْلا سَدِيدًا         }      ، إِلَى قَوْلِهِ :         {      فَوْزًا عَظِيمًا         }      ثُمَّ يَتَكَلَّمُ بِحَاجَتِهِ  .","","Musnad Abi Ya'la al-Mawsili 5257","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن سفيان الثوري عن يحيى القطان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5260","292 - (  5258  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  أَبِيهِ  ،         [9/169]      عَنْ  رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أُرَاهُ عَبْدَ اللهِ  - ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِذَا  اشْتَدَّ  الْحَرُّ  فَأَبْرِدُوا  بِالصَّلَاةِ  - أَوْ عَنِ الصَّلَاةِ  - .         [9/170]","","Musnad Abi Ya'la al-Mawsili 5258","","عبد الله بن مسعود عن الحجاج الباهلي عن حجاج بن حجاج الباهلي الأحول عن شعبة بن الحجاج عن خالد الصدق عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5261","293 - (  5259  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  يَحْيَى ،  عَنِ  ابْنِ عَجْلَانَ  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ :  إِذَا حُدِّثْتُمْ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَظُنُّوا بِرَسُولِ اللهِ الَّذِي هُوَ أَهْيَأُ ، وَأَتْقَى ، وَأَهْدَى  .","","Musnad Abi Ya'la al-Mawsili 5259","","عبد الله بن مسعود عن عون بن عبد الله بن عتبة عن محمد بن عجلان عن يحيى القطان عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5262","294 - (  5260  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  ابْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَوْلَا أَنَّكَ رَسُولٌ لَقَتَلْتُكَ  ،         [9/171]      -  يَعْنِي رَسُولَ  مُسَيْلِمَةَ  -  .","","Musnad Abi Ya'la al-Mawsili 5260","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن سفيان الثوري عن عبد الرحمن بن مهدي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5263","295 - (  5261  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  حَدَّثَنَا  مَالِكُ بْنُ مِغْوَلٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  رَجُلٍ ،  عَنْ  عَبْدِ اللهِ ،  قِيلَ لَهُ : أَسَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  النَّدَمُ تَوْبَةٌ  ؟ قَالَ : نَعَمْ  ، قَالَ  مُجَاهِدٌ  : فِي قَتْلِ النَّفْسِ إِنْ نَدِمَ  .","","Musnad Abi Ya'la al-Mawsili 5261","","عبد الله بن مسعود عن رجل عن خيثمة بن عبد الرحمن الجعفي عن منصور بن المعتمر عن مالك بن مغول الصهيبي عن خالد الصدق عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5264","296 - (  5262  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  خَالِدٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ ، قَالَ :  سَمِعْتُ  النَّزَّالَ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ ، يَقُولُ :  سَمِعْتُ  رَجُلًا  قَرَأَ آيَةً مِنْ كِتَابِ اللهِ كُنْتُ سَمِعْتُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَيْرَهَا ، فَأَخَذْتُ بِيَدِهِ ، فَأَتَيْتُ بِهِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَرَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَغَيَّرُ وَجْهُهُ ، فَقَالَ :  كِلَاكُمَا مُحْسِنٌ ، وَلَا تَخْتَلِفُوا فِيهِ ، فَإِنَّ مَنْ قَبْلَكُمُ اخْتَلَفُوا فِيهِ ، فَذَكَرَ الْهَلَاكَ  .","","Musnad Abi Ya'la al-Mawsili 5262","","عبد الله بن مسعود عن النزال بن سبرة الهلالي عن عبد الملك بن ميسرة الهلالي عن شعبة بن الحجاج عن خالد الصدق عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5265","297 - (  5263  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  عَثَّامُ بْنُ         [9/172]      عَلِيٍّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  انْتَهَيْتُ إِلَى  أَبِي جَهْلٍ  وَهُوَ صَرِيعٌ وَعَلَيْهِ بَيْضَةٌ وَمَعِي سَيْفٌ رَثٌّ  ، فَجَعَلْتُ أَنْقُفُ رَأْسَهُ بِسَيْفِي ، وَأَذْكُرُ نَقْفًا كَانَ يَنْقُفُ رَأْسِي  بِمَكَّةَ  ، حَتَّى ضَعُفَتْ يَدُهُ وَأَخَذْتُ سَيْفَهُ ، فَرَفَعَ رَأْسَهُ ، فَقَالَ : عَلَى مَنْ كَانَتِ  الدَّبْرَةُ  ؟ عَلَيْنَا أَوْ لَنَا ، أَلَسْتَ رُوَيْعِيَنَا  بِمَكَّةَ  ؟ قَالَ : فَقَتَلْتُهُ ، ثُمَّ أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقُلْتُ :  قَتَلْتُ  أَبَا جَهْلٍ  ، قَالَ : اللهِ الَّذِي لَا إِلَهَ إِلَّا هُوَ قَتَلْتَهُ  ؟ فَاسْتَحْلَفَنِي ثَلَاثَ مَرَّاتٍ ، ثُمَّ قَامَ مَعِي إِلَيْهِمْ فَدَعَا عَلَيْهِمْ  .         [9/173]","","Musnad Abi Ya'la al-Mawsili 5263","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو إسحاق السبيعي عن الأعمش عن عثام بن علي الوحيدي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5266","298 - (  5264  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ ،  حَدَّثَنَا  ابْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  مَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى صَلَاةً إِلَّا لِوَقْتِهَا لِمِيقَاتِهَا  ، إِلَّا أَنَّهُ جَمَعَ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ  بِجَمْعٍ  ، وَصَلَّى الصُّبْحَ بِغَيْرِ مِيقَاتِهَا  .","","Musnad Abi Ya'la al-Mawsili 5264","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن عمارة بن عمير التيمي عن الأعمش عن سفيان الثوري عن عبد الرحمن بن مهدي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5267","299 - (  5265  ) -  وَعَنْ  سُفْيَانَ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  إِبْرَاهِيمَ بْنِ سُوَيْدٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدْ أَذِنْتُ لَكَ أَنْ تَرْفَعَ الْحِجَابَ وَتَسْمَعَ  سِوَادِي  حَتَّى أَنْهَاكَ ، قَالَ : بَلَغَنِي أَنَّهَا  السِّرَارُ  .","","Musnad Abi Ya'la al-Mawsili 5265","","عبد الله بن مسعود عن إبراهيم بن سويد الصيرفي الأعور عن الحسن بن عبيد الله النخعي عن سفيان الثوري عن عبد الرحمن بن مهدي عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5268","300 - (  5266  ) -  حَدَّثَنِي  مُحَمَّدٌ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  مَسْرُوقٍ ، قَالَ :         [9/174]      كُنْتُ جَالِسًا عِنْدَ عَبْدِ اللهِ فَقَالَ لَهُ رَجُلٌ :  مَا  السُّحْتُ  ؟  قَالَ  : الرِّشَا ، فَقَالَ : فِي الْحُكْمِ ؟ قَالَ : ذَاكَ الْكُفْرُ  ، ثُمَّ قَرَأَ :         {      وَمَنْ لَمْ يَحْكُمْ بِمَا أَنْـزَلَ اللهُ فَأُولَئِكَ هُمُ الْكَافِرُونَ         }      .         [9/175]","","Musnad Abi Ya'la al-Mawsili 5266","","عبد الله بن مسعود عن مسروق بن الأجدع عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن فطر بن خليفة عن عثمان بن عمر بن فارس عن محمد بن أبي بكر المقدمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5269","301 - (  5267  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  حَدَّثَنَا  أَبُو سَعِيدٍ مَوْلَى بَنِي هَاشِمٍ قَالَ :  حَدَّثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَوْنٍ ،  عَنْ  أَبِي فَاخِتَةَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ قَالَ  إِذَا صَلَّيْتُمْ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَحْسِنُوا الصَّلَاةَ عَلَيْهِ  ، فَإِنَّكُمْ لَا تَدْرُونَ لَعَلَّ ذَلِكَ يُعْرَضُ عَلَيْهِ ، قَالُوا : فَعَلِّمْنَا يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، قَالَ : قُولُوا : اللَّهُمَّ اجْعَلْ صَلَوَاتِكَ وَرَحْمَتَكَ وَبَرَكَاتِكَ عَلَى سَيِّدِ الْمُرْسَلِينَ ، وَإِمَامِ الْمُتَّقِينَ ، وَخَاتَمِ النَّبِيِّينَ  مُحَمَّدٍ  عَبْدِكَ وَرَسُولِكَ إِمَامِ الْخَيْرِ وَقَائِدِ الْخَيْرِ ، وَرَسُولِ الرَّحْمَةِ ، اللَّهُمَّ ابْعَثْهُ مَقَامًا مَحْمُودًا يَغْبِطُهُ بِهِ الْأَوَّلُونَ وَالْآخِرُونَ ، اللَّهُمَّ صَلِّ عَلَى  مُحَمَّدٍ  وَعَلَى  آلِ مُحَمَّدٍ  ، كَمَا صَلَّيْتَ عَلَى  إِبْرَاهِيمَ  وَعَلَى  آلِ إِبْرَاهِيمَ  إِنَّكَ حَمِيدٌ مَجِيدٌ ،  وَبَارِكْ  عَلَى  مُحَمَّدٍ  وَعَلَى  آلِ مُحَمَّدٍ  كَمَا بَارَكْتَ عَلَى  إِبْرَاهِيمَ  وَعَلَى  آلِ إِبْرَاهِيمَ  إِنَّكَ حَمِيدٌ مَجِيدٌ  .         [9/176]","","Musnad Abi Ya'la al-Mawsili 5267","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن سعيد بن علاقة الهاشمي عن عون بن عبد الله بن عتبة عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عبد الرحمن بن عبد الله بن عبيد جردقة عن محمد بن عباد بن الزبرقان المكي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5270","302 - (  5268  ) -  حَدَّثَنَا  أَبُو الرَّبِيعِ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبُو حَنِيفَةَ ،  عَنِ  الْهَيْثَمِ ، قَالَ أَبُو الرَّبِيعِ : يَعْنِي ابْنَ حَبِيبٍ ، قَالَ :  قَالَ  عَبْدُ اللهِ :  مَا كَذَبْتُ مُذْ أَسْلَمْتُ إِلَّا كَذْبَةً ، كُنْتُ أُرَحِّلُ لِرَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَتَى رَجُلٌ مِنَ  الطَّائِفِ  ، فَقَالَ : أَيُّ رَاحِلَةٍ أَعْجَبُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقُلْتُ : الطَّائِفِيَّةُ الْمُنَكَّبَةُ ، قَالَ : وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَكْرَهُهَا ، قَالَ : فَلَمَّا رَحَلَهَا فَأَتَى بِهَا ، قَالَ : مَنْ رَحَلَ لَنَا هَذِهِ ؟ قَالُوا : رَحَلَ لَكَ الَّذِي أَتَيْتَ بِهِ مِنَ  الطَّائِفِ  ، قَالَ : رُدُّوا الرَّاحِلَةَ إِلَى  ابْنِ مَسْعُودٍ  .         [9/177]","","Musnad Abi Ya'la al-Mawsili 5268","","عبد الله بن مسعود عن الهيثم بن حبيب عن أبو حنيفة النعمان عن أبو يوسف يعقوب بن إبراهيم القاضي عن سليمان بن داود العتكي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5271","303 - (  5269  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ عُمَرَ بْنِ شَقِيقٍ ،  حَدَّثَنَا  مَعْرُوفُ بْنُ حَسَّانَ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، أَنَّهُ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا انْفَلَتَتْ دَابَّةُ أَحَدِكُمْ بِأَرْضٍ فَلَاةٍ فَلْيُنَادِ : يَا عِبَادَ اللهِ احْبِسُوا  ، يَا عِبَادَ اللهِ احْبِسُوا ، فَإِنَّ لِلهِ حَاضِرًا فِي الْأَرْضِ سَيَحْبِسُهُ  .","","Musnad Abi Ya'la al-Mawsili 5269","","عبد الله بن مسعود عن عبد الله بن بريدة عن قتادة بن دعامة عن سعيد بن أبي عروبة عن معروف بن حسان السمرقندي عن الحسن بن عمر بن شقيق الجرمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5272","304 - (  5270  ) -  حَدَّثَنَا  الْأَخْنَسِيُّ أَحْمَدُ بْنُ عِمْرَانَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ، وَسَمِعْتُهُ يَقُولُ :  حَدَّثَنَا  إِبْرَاهِيمُ الْهَجَرِيُّ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ اللهَ  وِتْرٌ  يُحِبُّ  الْوِتْرَ ،  فَإِذَا  اسْتَجْمَرْتَ  فَأَوْتِرْ  .         [9/178]","","Musnad Abi Ya'la al-Mawsili 5270","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن محمد بن فضيل بن غزوان عن أحمد بن عمران الأخنسي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5273","305 - (  5271  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ الْبَصْرِيُّ ،  حَدَّثَنَا  أَبُو مِحْصَنٍ حُصَيْنُ بْنُ نُمَيْرٍ ،  عَنْ  حُسَيْنِ بْنِ قَيْسٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنِ  ابْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا تَزُولُ قَدَمَا ابْنِ آدَمَ يَوْمَ الْقِيَامَةِ حَتَّى يُسْأَلَ عَنْ خَمْسٍ  : عَنْ عُمْرِكَ فِيمَا أَفْنَيْتَ ، وَعَنْ شَبَابِكَ فِيمَا أَبْلَيْتَ ، وَعَنْ مَالِكَ مِنْ أَيْنَ كَسِبْتَهُ وَفِيمَا أَنْفَقْتَهُ ، وَمَا عَمِلْتَ فِيمَا عَلِمْتَ  .         [9/179]","","Musnad Abi Ya'la al-Mawsili 5271","","عبد الله بن مسعود عن عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن الحسين بن قيس الرحبي عن حصين بن نمير الأنصاري عن محمد بن بكار العيشي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5274","306 - (  5272  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُرَّةَ الْهَمْدَانِيِّ ،  عَنْ  عَبْدِ اللهِ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  عَجِبَ  رَبُّنَا مِنْ رَجُلَيْنِ : رَجُلٍ ثَارَ مِنْ وِطَائِهِ وَلِحَافِهِ ، مِنْ بَيْنِ حَيِّهِ وَأَهْلِهِ إِلَى صَلَاةٍ رَغْبَةً فِيمَا عِنْدِي  ، وَشَفَقَةً مِمَّا عِنْدِي ، وَرَجُلٍ غَزَا فِي  سَبِيلِ  اللهِ ، فَانْهَزَمَ فَعَلِمَ مَا عَلَيْهِ فِي الِانْهِزَامِ وَمَا لَهُ فِي الرُّجُوعِ ، فَرَجَعَ حَتَّى يُهَرِيقَ دَمُهُ ، فَيَقُولُ اللهُ         [9/180]      لِمَلَائِكَتِهِ : انْظُرُوا إِلَى عَبْدِي ، رَجَعَ رَغْبَةً فِيمَا عِنْدِي وَشَفَقَةً مِمَّا عِنْدِي حَتَّى أُهَرِيقَ دَمُهُ  .","","Musnad Abi Ya'la al-Mawsili 5272","","عبد الله بن مسعود عن مرة بن شراحيل عن عطاء بن السائب عن حماد بن سلمة عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5275","307 - (  5273  ) -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ أَبِي سَمِينَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  حَدَّثَنَا  جَرِيرُ بْنُ أَيُّوبَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  نَافِعِ بْنِ بُرْدَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ،  أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَقُولُ - وَقَدْ أَهَلَّ رَمَضَانُ - :  لَوْ عَلِمَ الْعِبَادُ مَا فِي رَمَضَانَ لَتَمَنَّتْ أُمَّتِي أَنْ يَكُونَ رَمَضَانُ السَّنَةَ كُلَّهَا  ، فَقَالَ  رَجُلٌ مِنْ خُزَاعَةَ  : حَدِّثْنَا بِهِ ، قَالَ : إِنَّ الْجَنَّةَ تَزَّيَّنُ لِرَمَضَانَ مِنْ رَأْسِ الْحَوْلِ إِلَى الْحَوْلِ ، حَتَّى إِذَا كَانَ أَوَّلُ يَوْمٍ مِنْ رَمَضَانَ هَبَّتْ رِيحٌ مِنْ تَحْتِ الْعَرْشِ فَصَفَّقَتْ وَرَقَ الْجَنَّةِ ، فَتَنْظُرُ  الْحُورُ  الْعِينُ  إِلَى ذَلِكَ فَيَقُلْنَ : يَا         [9/181]      رَبِّ اجْعَلْ لَنَا مِنْ عِبَادِكَ فِي هَذَا  الشَّهْرِ  أَزْوَاجًا ، تَقَرُّ أَعْيُنُنَا بِهِمْ وَتَقَرُّ أَعْيُنُهُمْ بِنَا ، قَالَ : فَمَا مِنْ عَبْدٍ يَصُومُ رَمَضَانَ إِلَّا زُوِّجَ زَوْجَةً مِنَ  الْحُورِ  الْعِينِ  فِي خَيْمَةٍ مِنْ دُرٍّ مُجَوَّفَةٍ مِمَّا نَعَتَ اللهُ         {      حُورٌ مَقْصُورَاتٌ فِي الْخِيَامِ         }      عَلَى كُلِّ امْرَأَةٍ مِنْهُنَّ سَبْعُونَ  حُلَّةً  ، لَيْسَ فِيهَا  حُلَّةٌ  عَلَى لَوْنِ الْأُخْرَى ، وَتُعْطَى سَبْعِينَ لَوْنًا مِنَ الطِّيبِ لَيْسَ مِنْهَا لَوْنٌ عَلَى رِيحِ الْآخَرِ ، لِكُلِّ امْرَأَةٍ مِنْهُنَّ سَبْعُونَ سَرِيرًا مِنْ يَاقُوتَةٍ حَمْرَاءَ مُوَشَّحَةٍ بِالدُّرِّ ، عَلَى كُلِّ سَرِيرٍ سَبْعُونَ فِرَاشًا بَطَائِنُهَا مِنْ إِسْتَبْرَقٍ ، وَفَوْقَ السَّبْعِينَ فِرَاشًا سَبْعُونَ أَرِيكَةً ، لِكُلِّ امْرَأَةٍ مِنْهُنَّ سَبْعُونَ أَلْفَ وَصِيفَةٍ لِحَاجَاتِهَا ، وَسَبْعُونَ أَلْفَ وَصِيفٍ ، مَعَ كُلِّ وَصِيفٍ صَحْفَةٌ مِنْ ذَهَبٍ ، فِيهَا لَوْنُ طَعَامٍ يَجِدُ لِآخِرِ لُقْمَةٍ مِنْهَا لَذَّةً لَا يَجِدُ لِأَوَّلِهِ ، وَيُعْطَى زَوْجُهَا مِثْلَ ذَلِكَ عَلَى سَرِيرٍ مِنْ يَاقُوتٍ أَحْمَرَ عَلَيْهِ سِوَارَانِ مِنْ ذَهَبٍ مُوَشَّحٍ بِيَاقُوتٍ أَحْمَرَ ، هَذَا بِكُلِّ يَوْمٍ صَامَ مِنْ رَمَضَانَ سِوَى مَا عَمِلَ مِنَ الْحَسَنَاتِ  .         [9/182]","","Musnad Abi Ya'la al-Mawsili 5273","","عبد الله بن مسعود الغفاري عن نافع بن بردة عن الشعبي عن جرير بن أيوب بن أبي زرعة البجلي عن عبد الله بن رجاء الغداني عن محمد بن يحيى بن أبي سمينة التمار عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5276","308 - (  5274  ) -  حَدَّثَنَا  إِسْحَاقُ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عَمْرِو بْنِ أَبِي عَمْرٍو ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْكُلُ اللَّحْمَ ثُمَّ يَقُومُ إِلَى الصَّلَاةِ  فَمَا يَمَسُّ قَطْرَةَ مَاءٍ  .         [9/183]","","Musnad Abi Ya'la al-Mawsili 5274","","عبد الله بن مسعود عن عبيد الله بن عبد الله بن عتبة بن مسعود عن عمرو بن أبي عمرو المخزومي عن عبد العزيز بن محمد الدراوردي عن إسحاق بن أبي إسرائيل عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5277","309 - (  5275  ) -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  حَدَّثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  ذَهَبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِحَاجَتِهِ ، فَقَالَ : ائْتِنِي بِشَيْءٍ أَسْتَنْجِي بِهِ  ، وَلَا تُقْرِبْنِي حَائِلًا ، وَلَا رَجِيعًا ، قَالَ : فَأَتَيْتُهُ بِوَضُوءٍ ، فَتَوَضَّأَ ثُمَّ صَلَّى  .","","Musnad Abi Ya'la al-Mawsili 5275","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن محمد بن عبد الرحمن بن يزيد النخعي عن ليث بن أبي سليم عن زائدة بن قدامة عن الحسين بن علي الجعفي عن عبد الله بن عمر مشكدانة عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5278","310 - (  5276  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ، قَالَ :  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنْ  زُبَيْدٍ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  سِبَابُ         [9/184]      الْمُسْلِمِ - أَوِ الْمُؤْمِنِ  - فُسُوقٌ ، وَقِتَالُهُ  كُفْرٌ  ، فَقُلْتُ  لِأَبِي وَائِلٍ  : سَمِعْتَ  ابْنَ مَسْعُودٍ  يُحَدِّثُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : نَعَمْ  .","","Musnad Abi Ya'la al-Mawsili 5276","","عبد الله بن مسعود عن شقيق بن سلمة عن زبيد بن الحارث اليامي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5279","311 - (  5277  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُعْجِبُهُ أَنْ نَدْعُوَ ثَلَاثًا ، وَنَسْتَغْفِرَ ثَلَاثًا  .","","Musnad Abi Ya'la al-Mawsili 5277","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5280","312 - (  5278  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا يَنْبَغِي لِأَحَدٍ أَنْ         [9/185]      يَقُولَ : إِنِّي خَيْرٌ مِنْ  يُونُسَ بْنِ مَتَّى  .","","Musnad Abi Ya'la al-Mawsili 5278","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5281","313 - (  5279  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى الظُّهْرَ خَمْسًا  ، فَقِيلَ لَهُ : أَزِيدَ فِي الصَّلَاةِ ؟ فَسَجَدَ سَجْدَتَيْنِ بَعْدَمَا سَلَّمَ  .","","Musnad Abi Ya'la al-Mawsili 5279","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5282","314 - (  5280  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَنْصُورٍ ، وَالْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الْجَنَّةُ أَقْرَبُ إِلَى أَحَدِكُمْ مِنْ  شِرَاكِ  نَعْلِهِ ، وَالنَّارُ مِثْلُ ذَلِكَ  .         [9/186]","","Musnad Abi Ya'la al-Mawsili 5280","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5283","315 - (  5281  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  رِبْعِيٍّ ،  عَنِ  الْبَرَاءِ بْنِ نَاجِيَةَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  تَدُورُ رَحَى الْإِسْلَامِ لِخَمْسٍ ، أَوْ سِتٍّ ، أَوْ سَبْعٍ وَثَلَاثِينَ ، فَإِنْ يَهْلِكُوا فَبِسَبِيلِ مَنْ هَلَكَ  ، وَإِنْ يَقُمْ لَهُمْ دِينُهُمْ يَقُمْ لَهُمْ سَبْعِينَ عَامًا ، قُلْتُ : مِمَّا مَضَى أَوْ مِمَّا بَقِيَ ؟ فَقَالَ : مِمَّا بَقِيَ  .","","Musnad Abi Ya'la al-Mawsili 5281","","عبد الله بن مسعود عن البراء بن ناجية الكاهلي عن ربعي بن حراش العبسي عن منصور بن المعتمر عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5284","316 - (  5282  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  إِسْرَائِيلَ ،  عَنِ  السُّدِّيِّ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  يَدْخُلُ النَّاسُ كُلُّهُمُ النَّارَ ، ثُمَّ يَصْدُرُونَ مِنْهَا بِأَعْمَالِهِمْ  .","","Musnad Abi Ya'la al-Mawsili 5282","","عبد الله بن مسعود عن مرة بن شراحيل عن السدي الكبير عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5285","317 - (  5283  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَنَّهُ  كَانَ يَقُولُ :  اللَّهُمَّ إِنِّي أَسْأَلُكَ الْهُدَى وَالتُّقَى  وَالْعِفَّةَ  وَالْغِنَى  .         [9/187]","","Musnad Abi Ya'la al-Mawsili 5283","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5286","318 - (  5284  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  ذَرٍّ ،  عَنْ  وَائِلِ بْنِ مَهَانَةَ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  أَنَّهُ قَالَ لِلنِّسَاءِ :  تَصَدَّقْنَ فَإِنَّكُنَّ أَكْثَرُ أَهْلِ النَّارِ  ، فَقَالَتِ امْرَأَةٌ لَيْسَتْ مِنْ عِلْيَةِ النِّسَاءِ :  لِمَ - أَوْ فِيمَ أَوْ بِمَ  - نَحْنُ ؟ قَالَ : إِنَّكُنَّ تُكْثِرْنَ اللَّعْنَ ، وَتَكْفُرْنَ  الْعَشِيرَ ،  مَا مِنْ نَاقِصَةِ الْعَقْلِ وَالدِّينِ أَغْلَبُ لِلرِّجَالِ ذَوِي الْأَمْرِ مِنَ النِّسَاءِ ، قِيلَ : فَمَا نُقْصَانُ عَقْلِهَا ؟ قَالَ : جَعَلَ شَهَادَةَ امْرَأَتَيْنِ بِشَهَادَةِ رَجُلٍ ، قِيلَ : فَمَا نُقْصَانُ دِينِهَا ؟ قَالَ : تَلْبَثُ لَا أَدْرِي كَمْ يَوْمٍ لَا تُصَلِّي  .","","Musnad Abi Ya'la al-Mawsili 5284","","عبد الله بن مسعود عن وائل بن مهانة الحضرمي عن ذر بن عبد الله المرهبي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5287","319 - (  5285  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  الْمَسْعُودِيُّ ،  عَنْ  جَامِعِ بْنِ شَدَّادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَلْقَمَةَ ،         [9/188]      عَنْ  عَبْدِ اللهِ ، قَالَ :  لَمَّا رَجَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الْحُدَيْبِيَةِ  نَزَلَ مَنْزِلًا ،  فَعَرَّسَ  فِيهَا ، فَقَالَ : مَنْ يَحْرُسُنَا  ؟ قَالَ  عَبْدُ اللهِ  : فَقُلْتُ : أَنَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّكَ تَنَامُ ، يَقُولُ ذَلِكَ مَرَّتَيْنِ أَوْ ثَلَاثَةً ، ثُمَّ قَالَ : أَنْتَ إِذًا ، فَحَرَسْتُهُمْ حَتَّى إِذَا كَانَ فِي وَجْهِ الصُّبْحِ أَخَذَنِي مَا قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَلَمْ أَسْتَيْقِظْ إِلَّا بِحَرِّ الشَّمْسِ فِي ظُهُورِنَا ، فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَنَعَ كَمَا يَصْنَعُ ، ثُمَّ صَلَّى الصُّبْحَ ، ثُمَّ قَالَ : إِنَّ اللهَ لَوْ شَاءَ لَمْ تَنَامُوا عَنْهَا ، وَلَكِنْ إِنْ يَكُنْ لِمَنْ بَعْدَكُمْ ، فَهَكَذَا لِمَنْ نَامَ أَوْ نَسِيَ  .","","Musnad Abi Ya'la al-Mawsili 5285","","عبد الله بن مسعود عن عبد الرحمن بن علقمة الثقفي عن جامع بن شداد عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5288","320 - (  5286  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنِ  الْوَلِيدِ بْنِ الْعَيْزَارِ ، قَالَ :  سَمِعْتُ  أَبَا عَمْرٍو الشَّيْبَانِيَّ ، يَقُولُ :  حَدَّثَنِي  صَاحِبُ هَذِهِ الدَّارِ - وَأَشَارَ بِيَدِهِ إِلَى دَارِ عَبْدِ اللهِ وَلَمْ يُسَمِّهِ - ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، أَيُّ الْأَعْمَالِ أَحَبُّ إِلَى اللهِ ؟ قَالَ : الصَّلَاةُ عَلَى مَوَاقِيتِهَا  ، قَالَ : قُلْتُ : ثُمَّ أَيُّ ؟ قَالَ : ثُمَّ بِرُّ الْوَالِدَيْنِ ، قَالَ : قُلْتُ : ثُمَّ أَيُّ ؟ قَالَ : ثُمَّ  الْجِهَادُ  فِي  سَبِيلِ  اللهِ  .         [9/189]             [9/190]","","Musnad Abi Ya'la al-Mawsili 5286","","عبد الله بن مسعود عن سعد بن إياس الشيباني عن الوليد بن العيزار بن حريث العبدي عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5289","321 - (  5287  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ، قَالَ :         [9/191]      دَخَلْتُ أَنَا وَعَمِّي عَلَى عَبْدِ اللهِ بْنِ مَسْعُودٍ بِالْهَاجِرَةِ ،  فَأَقَامَ الصَّلَاةَ ، فَتَأَخَّرْنَا خَلْفَهُ ، فَأَخَذَ بِيَدِ أَحَدِنَا بِيَمِينِهِ ، وَالْآخَرَ بِشِمَالِهِ ، فَجَعَلَنَا عَنْ يَمِينِهِ وَعَنْ شِمَالِهِ  ، فَلَمَّا صَلَّى قَالَ : هَكَذَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَصْنَعُ إِذَا كَانُوا ثَلَاثَةً  .","","Musnad Abi Ya'la al-Mawsili 5287","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن محمد بن إسحاق عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5290","322 - (  5288  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  الْمَسْعُودِيُّ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنْ  عَبْدَةَ النَّصْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ لَمْ يُحَرِّمْ  حُرْمَةً  إِلَّا وَقَدْ عَلِمَ أَنَّهُ سَيَطَّلِعُهَا مِنْكُمْ مُطَّلِعٌ  ، أَلَا وَإِنِّي آخِذٌ  بِحُجَزِكُمْ  عَنِ النَّارِ أَنْ تَهَافَتُوا فِيهَا كَتَهَافُتِ  الْفَرَاشِ  أَوِ  الذُّبَابِ  أَوِ الْحُنْظُبِ  .         [9/192]","","Musnad Abi Ya'la al-Mawsili 5288","","عبد الله بن مسعود عن عبدة بن حزن النصري عن الحسن بن سعد مولى علي بن أبي طالب عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5291","323 - (  5289  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  الْحَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  فُضَيْلٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَدْخُلُ الْجَنَّةَ مَنْ         [9/193]      كَانَ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ  مِنْ خَرْدَلٍ مِنْ  كِبْرٍ  .","","Musnad Abi Ya'la al-Mawsili 5289","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن فضيل بن عمرو الفقيمي عن حجاج بن أرطاة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5292","324 - (  5290  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ آخِرَ مَنْ دَخَلَ الْجَنَّةَ لَرَجُلٌ يَمْشِي عَلَى الصِّرَاطِ فَيَنْكَبُّ مَرَّةً وَيَمْشِي مَرَّةً ، تَسْفَعُهُ النَّارُ مَرَّةً  ، فَإِذَا جَاوَزَ الصِّرَاطَ الْتَفَتَ إِلَيْهَا ، فَقَالَ : تَبَارَكَ الَّذِي نَجَّانِي مِنْكِ ، لَقَدْ أَعْطَانِي مَا لَمْ يُعْطِ أَحَدًا مِنَ الْأَوَّلِينَ وَالْآخِرِينَ ، قَالَ : فَتُرْفَعُ لَهُ شَجَرَةٌ فَيَنْظُرُ إِلَيْهَا ، فَيَقُولُ : يَا رَبِّ أَدْنِنِي مِنْ هَذِهِ الشَّجَرَةِ فَأَسْتَظِلَّ بِظِلِّهَا ، وَأَشْرَبَ مِنْ مَائِهَا ، فَيَقُولُ : أَيْ عَبْدِ ، فَلَعَلِّي إِنْ أَدْنَيْتُكَ تَسْأَلُنِي غَيْرَهَا ، فَيَقُولُ : لَا يَا رَبِّ ، فَيُعَاهِدُهُ أَنْ لَا يَسْأَلَهُ غَيْرَهَا ، وَالرَّبُّ تَبَارَكَ وَتَعَالَى يَعْلَمُ أَنَّهُ سَيَسْأَلُهُ لِأَنَّهُ يَرَى مَا لَا صَبْرَ لَهُ ، فَيُدْنِيهِ مِنْهَا ، ثُمَّ تُرْفَعُ لَهُ شَجَرَةٌ هِيَ أَحْسَنُ مِنْهَا ، فَيَقُولُ : يَا رَبِّ أَدْنِنِي مِنْ هَذِهِ الشَّجَرَةِ فَأَسْتَظِلَّ بِظِلِّهَا ، وَأَشْرَبَ مِنْ مَائِهَا ، فَيَقُولُ : أَيْ عَبْدِ ، أَلَمْ تُعَاهِدْنِي أَنْ لَا تَسْأَلَنِي غَيْرَهَا ؟ فَيَقُولُ : يَا رَبِّ هَذِهِ لَا أَسْأَلُكَ غَيْرَهَا ، فَيُدْنِيهِ مِنْهَا ، فَتُرْفَعُ لَهُ         [9/194]      شَجَرَةٌ  عِنْدَ بَابِ الْجَنَّةِ هِيَ أَحْسَنُ مِنْهَا ، فَيَقُولُ : يَا رَبِّ أَدْنِنِي مِنْ هَذِهِ الشَّجَرَةِ فَأَسْتَظِلَّ بِظِلِّهَا ، وَأَشْرَبَ مِنْ مَائِهَا فَيَقُولُ : أَيْ عَبْدِ أَلَمْ تُعَاهِدْنِي أَنْ لَا تَسْأَلَنِي غَيْرَهَا ؟ فَيَقُولُ : يَا رَبِّ هَذِهِ لَا أَسْأَلُكَ غَيْرَهَا ، فَيُعَاهِدُهُ - وَالرَّبُّ يَعْلَمُ أَنَّهُ سَيَسْأَلُهُ غَيْرَهَا لِأَنَّهُ يَرَى مَا لَا صَبْرَ لَهُ - فَيُدْنِيهِ مِنْهَا ، فَيَسْمَعُ أَصْوَاتَ أَهْلِ الْجَنَّةِ فَيَقُولُ : يَا رَبِّ ، الْجَنَّةَ الْجَنَّةَ ، فَيَقُولُ : أَيْ عَبْدِي ، أَلَمْ تُعَاهِدْنِي أَنْ لَا تَسْأَلَنِي غَيْرَهَا ؟ فَيَقُولُ : يَا رَبِّ ، أَدْخِلْنِي الْجَنَّةَ فَيَقُولُ تَبَارَكَ وَتَعَالَى : مَا  يَصْرِينِي  مِنْكَ أَيْ عَبْدِي ، أَيُرْضِيكَ أَنْ أُعْطِيَكَ الدُّنْيَا  وَمِثْلَهَا  مَعَهَا ؟ قَالَ : فَيَقُولُ : أَتَهْزَأُ بِي وَأَنْتَ رَبُّ الْعِزَّةِ ؟ فَضَحِكَ  عَبْدُ اللهِ  حَتَّى بَدَتْ  نَوَاجِذُهُ ،  ثُمَّ قَالَ : أَلَا تَسْأَلُونِي لِمَ ضَحِكْتُ ؟ قَالُوا : لِمَ ضَحِكْتَ ؟ قَالَ : لِضَحِكِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Musnad Abi Ya'la al-Mawsili 5290","","عبد الله بن مسعود عن أنس بن مالك عن ثابت البناني عن حماد بن سلمة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5293","325 - (  5291  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  ابْنُ عَوْنٍ ،  عَنْ  عَمْرِو بْنِ سَعِيدٍ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ الْحِمْيَرِيِّ ،         [9/195]      عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  كُنْتُ  لَا أُحْجَبُ عَنْ ثَلَاثٍ - أَوْ لَا أُحْبَسُ عَنْ ثَلَاثٍ  - عَنِ  النَّجْوَى  ، وَعَنْ كَذَا ، وَعَنْ كَذَا ، قَالَ  عَبْدُ اللهِ  : نَسِيَ عَمِّي وَاحِدَةً ، وَنَسِيتُ أَنَا الْأُخْرَى وَبَقِيَتْ هَذِهِ  ، فَأَتَيْتُهُ وَعِنْدَهُ  مَالِكٌ الرَّهَاوِيُّ  فَأَدْرَكْتُ مِنْ آخِرِ حَدِيثِهِمْ وَهُوَ يَقُولُ : يَا رَسُولَ اللهِ ، إِنِّي امْرُؤٌ قُسِمَ لِي مِنَ الْجَمَالِ مَا تَرَى ، فَمَا أُحِبُّ أَنَّ أَحَدًا فَضَلَنِي بِشِرَاكَيْنِ فَمَا فَوْقَهُمَا ، أَفَمِنَ الْبَغْيِ هُوَ ؟ قَالَ : لَا ،  وَلَكِنَّ الْبَغْيَ مَنْ  سَفِهَ  الْحَقَّ ،  وَغَمَصَ  النَّاسَ  .","","Musnad Abi Ya'la al-Mawsili 5291","","عبد الله بن مسعود عن حميد بن عبد الرحمن الحميري عن عمرو بن سعيد الخولاني عن عبد الله بن عون بن أرطبان عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5294","326 - (  5292  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  حَدَّثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عُمَرَ بْنِ مُرَّةَ  ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  نَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى حَصِيرٍ قَدْ أَثَّرَ فِي جَنْبِهِ ، فَقُلْنَا : يَا رَسُولَ اللهِ ، أَلَا آذَنْتَنَا فَبَسَطْنَا تَحْتَكَ أَلْيَنَ مِنْهُ ؟ فَقَالَ :         [9/196]      مَا لِي وَلِلدُّنْيَا ؟  إِنَّمَا مَثَلِي وَمَثَلُ الدُّنْيَا كَرَاكِبٍ سَارَ فِي يَوْمٍ صَائِفٍ ، فَقَالَ تَحْتَ شَجَرَةٍ ، ثُمَّ رَاحَ وَتَرَكَهَا  .  كذا في طبعة دار المأمون للتراث ، والصواب: (عمرو بن مرة ) كما في مصادر التخريج.","","Musnad Abi Ya'la al-Mawsili 5292","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5295","327 - (  5293  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ،  عَنْ  زُبَيْدٍ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  حَبَسُونَا عَنِ الصَّلَاةِ الْوُسْطَى حَتَّى غَابَتِ الشَّمْسُ ، مَلَأَ اللهُ بُطُونَهُمْ وَقُبُورَهُمْ نَارًا  .","","Musnad Abi Ya'la al-Mawsili 5293","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن محمد بن طلحة بن مصرف الهمداني عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5296","327 - (  5293  ) - مُكَرَّرٌ -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ،  بِإِسْنَادِهِ  مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 5293","","عبد الله بن مسعود عن مرة بن شراحيل عن زبيد بن الحارث اليامي عن محمد بن طلحة بن مصرف الهمداني عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5297","328 - (  5294  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنِي  الْعَوَّامُ بْنُ حَوْشَبٍ ،  حَدَّثَنِي  جَبَلَةُ بْنُ سُحَيْمٍ ،  عَنْ  مُؤْثِرِ بْنِ غَفَارَةَ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَمَّا كَانَ لَيْلَةُ أُسْرِيَ بِالنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، لَقِيَ  إِبْرَاهِيمَ  ،  وَمُوسَى  ،  وَعِيسَى  صَلَوَاتُ اللهِ عَلَيْهِمْ ، فَتَذَاكَرُوا السَّاعَةَ ، مَتَى هِيَ ؟ فَبَدَءُوا  بِإِبْرَاهِيمَ  ، فَسَأَلُوهُ عَنْهَا ، فَلَمْ يَكُنْ عِنْدَهُ مِنْهَا عِلْمٌ ، فَسَأَلُوا  مُوسَى  ، فَلَمْ يَكُنْ عِنْدَهُ مِنْهَا عِلْمٌ ، فَرَدُّوا الْحَدِيثَ إِلَى         [9/197]      عِيسَى  ، فَقَالَ : عَهِدَ اللهُ إِلَيَّ فِيمَا دُونَ وَجْبَتِهَا ، فَأَمَّا  وَجْبَتُهَا  فَلَا يَعْلَمُهَا إِلَّا اللهُ ، فَذَكَرَ مِنْ خُرُوجِ  الدَّجَّالِ  فَأَهْبِطُ فَأَقْتُلُهُ ، فَيَرْجِعُ النَّاسُ إِلَى بِلَادِهِمْ ، فَيَسْتَقْبِلُهُمْ  يَأْجُوجُ  ،  وَمَأْجُوجُ  ،         {      وَهُمْ مِنْ كُلِّ حَدَبٍ يَنْسِلُونَ         }      ، لَا يَمُرُّونَ بِمَاءٍ إِلَّا شَرِبُوهُ ، وَلَا بِشَيْءٍ إِلَّا أَفْسَدُوهُ ، فَيَجْأَرُونَ إِلَيَّ ، فَأَدْعُو اللهَ فَيُمِيتُهُمْ ،  فَتَجْوَى  الْأَرْضُ مِنْ رِيحِهِمْ ، فَأَدْعُو اللهَ أَنْ يُرْسِلَ السَّمَاءَ ، فَتَحْمِلَ أَجْسَامَهُمْ فَتُلْقِيَهَا فِي الْبَحْرِ ، ثُمَّ تُنْسَفُ الْجِبَالُ ، وَتُمَدُّ الْأَرْضُ مَدَّ الْأَدِيمِ ، فَعَهِدَ اللهُ تَبَارَكَ وَتَعَالَى إِلَيَّ أَنَّهُ إِذَا كَانَ ذَلِكَ : أَنَّ السَّاعَةَ مِنَ النَّاسِ كَالْحَامِلِ  الْمُتِمِّ  ، لَا يَدْرِي أَهْلُهَا مَتَى تَفْجَؤُهُمْ بِوِلَادِهَا لَيْلًا أَوْ نَهَارًا ، قَالَ  الْعَوَّامُ  : فَوَجَدْتُ تَصْدِيقَ ذَلِكَ فِي كِتَابِ اللهِ ثُمَّ قَرَأَ :         {      حَتَّى إِذَا فُتِحَتْ يَأْجُوجُ وَمَأْجُوجُ         }      الْآيَةَ  .         [9/198]      كذا في طبعة دار المأمون للتراث ، والصواب : ( مؤثر بن عفازة )","","Musnad Abi Ya'la al-Mawsili 5294","","عبد الله بن مسعود عن مؤثر بن عفازة الشيباني عن جبلة بن سحيم التيمي عن العوام بن حوشب عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5298","329 - (  5295  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  أَبِي قَيْسٍ ،  عَنْ  هُزَيْلِ بْنِ شُرَحْبِيلَ ، قَالَ :  أَتَى رَجُلٌ  أَبَا مُوسَى  ،  وَسَلْمَانَ بْنَ رَبِيعَةَ  فَسَأَلَهُمَا عَنِ ابْنَةٍ ، وَابْنَةِ ابْنٍ ، وَأُخْتٍ لِأَبٍ ، وَأُمٍّ  ، وَذَكَرَ الْحَدِيثَ  .","","Musnad Abi Ya'la al-Mawsili 5295","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن سفيان الثوري عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5299","330 - (  5296  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَضَّرَ  اللهُ امْرَأً سَمِعَ مِنَّا حَدِيثًا فَبَلَّغَهُ كَمَا سَمِعَهُ ، فَإِنَّهُ رُبَّ مُبَلَّغٍ أَوْعَى لَهُ مِنْ سَامِعٍ  .","","Musnad Abi Ya'la al-Mawsili 5296","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن شعبة بن الحجاج عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5300","331 - (  5297  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  أَخْبَرَنَا  أَبُو سَلَمَةَ الْجُهَنِيُّ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،         [9/199]      عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا قَالَ عَبْدٌ قَطُّ إِذَا أَصَابَهُ هَمٌّ  وَحَزَنٌ  : اللَّهُمَّ إِنِّي عَبْدُكَ وَابْنُ عَبْدِكَ ، نَاصِيَتِي بِيَدِكَ  ، مَاضٍ فِيَّ حُكْمُكَ ، عَدْلٌ فِيَّ قَضَاؤُكَ ، أَسْأَلُكَ بِكُلِّ اسْمٍ سَمَّيْتَ بِهِ نَفْسَكَ ، أَوْ أَنْزَلْتَهُ فِي كِتَابِكَ ، أَوْ عَلَّمْتَهُ أَحَدًا مِنْ خَلْقِكَ ، أَوِ  اسْتَأْثَرْتَ  بِهِ فِي عِلْمِ الْغَيْبِ عِنْدَكَ ، أَنْ تَجْعَلَ الْقُرْآنَ  رَبِيعَ  قَلْبِي ، وَنُورَ بَصَرِي ، وَجِلَاءَ حُزْنِي ، وَذَهَابَ هَمِّي ، إِلَّا أَذْهَبَ اللهُ هَمَّهُ ، وَأَبْدَلَهُ مَكَانَ حُزْنِهِ فَرَحًا ، قَالُوا : يَا رَسُولَ اللهِ ، يَنْبَغِي لَنَا أَنْ نَتَعَلَّمَ هَؤُلَاءِ الْكَلِمَاتِ ؟ قَالَ : أَجَلْ ، يَنْبَغِي لِمَنْ سَمِعَهُنَّ أَنْ يَتَعَلَّمَهُنَّ  .         [9/200]             [9/201]","","Musnad Abi Ya'la al-Mawsili 5297","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن أبو سلمة الجهني عن فضيل بن مرزوق الأغر عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5301","332 - (  5298  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ         [9/202]      هَارُونَ ،  أَخْبَرَنَا  الْعَوَّامُ بْنُ حَوْشَبٍ ،  حَدَّثَنِي  أَبُو إِسْحَاقَ الشَّيْبَانِيُّ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَدُورُ رَحَى الْإِسْلَامِ عَلَى رَأْسِ خَمْسٍ وَثَلَاثِينَ ، أَوْ سِتٍّ وَثَلَاثِينَ  ، أَوْ سَبْعٍ وَثَلَاثِينَ ، فَإِنْ يَهْلِكُوا فَبِسَبِيلِ مَنْ هَلَكَ ، وَإِنْ بَقُوا بَقِيَ لَهُمْ دِينُهُمْ سَبْعِينَ عَامًا  .","","Musnad Abi Ya'la al-Mawsili 5298","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن سليمان بن فيروز الشيباني عن العوام بن حوشب عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5302","333 - (  5299  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  حَدَّثَنَا  فَرْقَدٌ السَّبَخِيُّ ،  حَدَّثَنَا  جَابِرُ بْنُ يَزِيدَ ،  أَنَّهُ سَمِعَ  مَسْرُوقًا  يُحَدِّثُ ، عَنْ  عَبْدِ اللهِ -  لَعَلَّهُ قَالَ : عَنِ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  إِنِّي كُنْتُ نَهَيْتُكُمْ عَنْ زِيَارَةِ الْقُبُورِ ، فَزُورُوهَا  ، وَنَهَيْتُكُمْ أَنْ تَحْبِسُوا لُحُومَ الْأَضَاحِيِّ فَوْقَ ثَلَاثٍ ، فَاحْبِسُوا ، وَنَهَيْتُكُمْ عَنْ هَذِهِ الظُّرُوفِ ، فَانْتَبِذُوا فِيهَا ، وَاجْتَنِبُوا كُلَّ مُسْكِرٍ  .         [9/203]","","Musnad Abi Ya'la al-Mawsili 5299","","عبد الله بن مسعود عن مسروق بن الأجدع عن جابر بن يزيد عن فرقد بن يعقوب السبخي عن حماد بن زيد عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5303","334 - (  5300  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  قِيلَ : يَا رَسُولَ اللهِ ، كَيْفَ تَعْرِفُ مَنْ لَمْ تَرَ مِنْ أُمَّتِكَ يَوْمَ الْقِيَامَةِ ؟ قَالَ : هُمْ  غُرٌّ  مُحَجَّلُونَ  بُلْقٌ مِنْ آثَارِ الْوُضُوءِ  .","","Musnad Abi Ya'la al-Mawsili 5300","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5304","335 - (  5301  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  أَبِي فَزَارَةَ ،  عَنْ  أَبِي زَيْدٍ مَوْلَى عَمْرِو بْنِ حُرَيْثٍ ،  عَنْ  عَبْدِ اللهِ :  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَيْلَةَ الْجِنِّ : هَلْ عِنْدَكَ طَهُورٌ ؟  قَالَ : لَا ، إِلَّا شَيْئًا مِنْ نَبِيذٍ فِي  إِدَاوَةٍ  ، فَقَالَ : هَاتِهِ ، تَمْرَةٌ طَيِّبَةٌ ، وَمَاءٌ طَهُورٌ  .","","Musnad Abi Ya'la al-Mawsili 5301","","عبد الله بن مسعود عن أبو زيد المخزومي عن راشد بن كيسان العبسي عن الجراح بن مليح الرؤاسي والد وكيع عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5305","336 - (  5302  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  عَلْقَمَةَ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ :  أَلَا أُصَلِّي بِكُمْ صَلَاةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟         [9/204]      فَصَلَّى بِهِمْ فَلَمْ يَرْفَعْ يَدَيْهِ إِلَّا مَرَّةً  .","","Musnad Abi Ya'la al-Mawsili 5302","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن عبد الرحمن بن الأسود النخعي عن عاصم بن كليب الجرمي عن سفيان الثوري عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5306","337 - (  5303  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  حَدَّثَنَا  مَالِكُ بْنُ مِغْوَلٍ ،  عَنِ  الزُّبَيْرِ بْنِ عَدِيٍّ ،  عَنْ  طَلْحَةَ ،  عَنْ  مُرَّةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَمَّا أُسْرِيَ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، انْتَهَى إِلَى  سِدْرَةِ  الْمُنْتَهَى  ، وَهِيَ فِي السَّمَاءِ السَّادِسَةِ ، وَإِلَيْهَا يَنْتَهِي مَا يُصْعَدُ بِهِ مِنَ الْأَرْضِ ، فَيُقْبَضُ مِنْهَا ، وَإِلَيْهَا يَنْتَهِي مَا يَهْبِطُ مِنْ فَوْقِهَا ، فَيُقْبَضُ مِنْهَا :         {      إِذْ يَغْشَى السِّدْرَةَ مَا يَغْشَى         }      ، قَالَ :  فَرَاشٌ  مِنْ ذَهَبٍ ، قَالَ : فَأُعْطِيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثَلَاثَ خِلَالٍ : الصَّلَوَاتُ الْخَمْسُ ، وَخَوَاتِيمُ سُورَةِ الْبَقَرَةِ ، وَغُفِرَ لِمَنْ لَا يُشْرِكُ بِاللهِ مِنْ أُمَّتِهِ  الْمُقْحِمَاتُ  .         [9/205]","","Musnad Abi Ya'la al-Mawsili 5303","","عبد الله بن مسعود عن مرة بن شراحيل عن طلحة بن مصرف الهمداني عن الزبير بن عدي الهمداني عن مالك بن مغول الصهيبي عن عبد الله بن نمير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5307","338 - (  5304  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ :  أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ فِي  قُبَّةٍ  مِنْ أَدَمٍ فِي نَحْوٍ مِنْ أَرْبَعِينَ رَجُلًا ، فَقَالَ :  إِنَّكُمْ مَفْتُوحٌ عَلَيْكُمْ ، مَنْصُورُونَ وَمُصِيبُونَ ، فَمَنْ أَدْرَكَ ذَلِكَ مِنْكُمْ فَلْيَتَّقِ اللهَ  ، وَلْيَأْمُرْ بِالْمَعْرُوفِ ، وَلْيَنْهَ عَنِ الْمُنْكَرِ ، وَلْيَصِلْ رَحِمَهُ ، وَمَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ ، وَمَثَلُ الَّذِي يُعِينُ قَوْمَهُ عَلَى غَيْرِ الْحَقِّ ، كَمَثَلِ بَعِيرٍ فِي بِئْرٍ فَهُوَ يَنْزِعُ مِنْهَا بِذَنَبِهِ  .         [9/206]","","Musnad Abi Ya'la al-Mawsili 5304","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن سفيان الثوري عن أبو عامر العقدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5308","339 - (  5305  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هَاشِمُ بْنُ الْقَاسِمِ ،  حَدَّثَنَا  شَيْبَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَصُومُ ثَلَاثَةَ أَيَّامٍ مِنْ  غُرَّةِ  كُلِّ هِلَالٍ  ، وَقَلَّ مَا يُفْطِرُ يَوْمَ الْجُمُعَةِ  .","","Musnad Abi Ya'la al-Mawsili 5305","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5309","340 - (  5306  ) -  وَعَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  أَخَّرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيْلَةً صَلَاةَ الْعِشَاءِ ، ثُمَّ خَرَجَ إِلَى الْمَسْجِدِ  ، فَإِذَا النَّاسُ يَنْتَظِرُونَ الصَّلَاةَ ، فَقَالَ : إِنَّهُ لَيْسَ مِنْ أَهْلِ الْأَدْيَانِ أَحَدٌ يَذْكُرُ اللهَ فِي هَذِهِ السَّاعَةِ غَيْرُكُمْ ، قَالَ : وَأُنْزِلَتْ هَؤُلَاءِ الْآيَاتُ :         [9/207]             {      لَيْسُوا سَوَاءً مِنْ أَهْلِ الْكِتَابِ أُمَّةٌ قَائِمَةٌ         }      إِلَى :         {      وَاللهُ عَلِيمٌ بِالْمُتَّقِينَ         }      .","","Musnad Abi Ya'la al-Mawsili 5306","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5310","341 - (  5307  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا ،  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .         [9/208]","","Musnad Abi Ya'la al-Mawsili 5307","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن شيبان بن عبد الرحمن المؤدب عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5311","342 - (  5308  ) -  وَعَنْ  هَاشِمٍ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْ كُنْتُ مِنْ أُمَّتِي مُتَّخِذًا  خَلِيلًا ،  لَاتَّخَذْتُ  أَبَا بَكْرٍ  خَلِيلًا  .","","Musnad Abi Ya'la al-Mawsili 5308","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن هاشم بن القاسم بن مسلم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5312","343 - (  5309  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  سَعِيدٌ ،  عَنْ  عَبْدِ السَّلَامِ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَصُومُ فِي السَّفَرِ وَيُفْطِرُ ، وَيُصَلِّي الرَّكْعَتَيْنِ لَا يَدَعُهَا  ، يَقُولُ : لَا يَزِيدُ عَلَيْهَا ، يَعْنِي : الْفَرِيضَةَ  .         [9/209]","","Musnad Abi Ya'la al-Mawsili 5309","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن عبد السلام بن أبي الجنوب المدني عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5313","344 - (  5310  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  كُنْتُ أَجْتَنِي لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سِوَاكًا مِنْ أَرَاكٍ ، وَكَانَ الرِّيحُ تَكْفَؤُهُ  ، وَكَانَ فِي سَاقَيَّ شَيْءٌ ، فَضَحِكَ  الْقَوْمُ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَا يُضْحِكُكُمْ ؟ قَالُوا : دِقَّةُ         [9/210]      سَاقَيْهِ ، قَالَ : وَالَّذِي نَفْسِي بِيَدِهِ ، لَهُمَا أَثْقَلُ فِي الْمِيزَانِ مِنْ  أُحُدٍ  .","","Musnad Abi Ya'la al-Mawsili 5310","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5314","345 - (  5311  ) -  وَعَنْ  عَبْدِ اللهِ ، قَالَ :  كُنْتُ غُلَامًا يَافِعًا ، وَكُنْتُ أَرْعَى غَنَمًا  لِابْنِ أَبِي مُعَيْطٍ  ،  فَجَاءَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  قَدْ فَرَّا مِنَ الْمُشْرِكِينَ ، فَقَالَا : يَا غُلَامُ ، عِنْدَكَ مِنْ لَبَنٍ تَسْقِينَا  ؟ فَقُلْتُ : نَعَمْ ، وَلَكِنِّي مُؤْتَمَنٌ ، وَلَسْتُ بِسَاقِيكُمَا ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : فَهَلْ عِنْدَكَ شَاةٌ  جَذَعَةٌ  لَمْ يَنْزُ عَلَيْهَا  الْفَحْلُ  ؟ قُلْتُ : نَعَمْ ، فَأَتَيْتُهُ بِهَا ،  فَاعْتَقَلَهَا  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَمَسَحَ الضَّرْعَ وَدَعَا ، فَجَعَلَ اللَّبَنُ يَدِرُّ ، وَأَتَاهُ  أَبُو بَكْرٍ  بِصَخْرَةٍ مُنْقَعِرَةٍ ، فَحَلَبَ فِيهَا فَشَرِبَ ، وَشَرِبَ  أَبُو بَكْرٍ  ، وَشَرِبْتُ ، ثُمَّ قَالَ لِلضَّرْعِ :  اقْلِصْ  ، فَقَلَصَ ، ثُمَّ أَتَيْتُهُ بَعْدَ ذَلِكَ فَقُلْتُ : يَا رَسُولَ اللهِ ،  عَلِّمْنِي مِنْ هَذَا الْقَوْلِ - أَوْ مِنْ هَذَا الْقُرْآنِ  - قَالَ : إِنَّكَ غُلَامٌ  مُعَلَّمٌ  ، وَلَكِنْ عَلَّمَنِي ، فَأَخَذْتُ مِنْ فِيهِ         [9/211]      سَبْعِينَ سُورَةً لَا يُنَازِعُنِي فِيهَا أَحَدٌ  .","","Musnad Abi Ya'la al-Mawsili 5311","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن روح بن عبادة القيسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5315","346 - (  5312  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَعْفَرُ بْنُ عَوْنٍ ،  حَدَّثَنَا  سُفْيَانُ بْنُ سَعِيدٍ الثَّوْرِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي ظِلِّ  الْكَعْبَةِ  ، فَقَالَ  أَبُو جَهْلٍ  وَنَاسٌ مِنْ  قُرَيْشٍ  ، وَقَدْ نَحَرُوا جَزُورًا فِي نَاحِيَةِ  مَكَّةَ  ، فَبَعَثُوا فَجَاءُوا مِنْ  سَلَاهَا  فَطَرَحُوهُ بَيْنَ كَتِفَيْهِ ، فَجَاءَتْ  فَاطِمَةُ  فَطَرَحَتْهُ عَنْهُ ، فَلَمَّا انْصَرَفَ ، قَالَ : وَكَانَ يَسْتَحِبُّ ثَلَاثًا ، قَالَ :  اللَّهُمَّ عَلَيْكَ بِقُرَيْشٍ - ثَلَاثًا -  بِأَبِي جَهْلِ بْنِ هِشَامٍ  ،  وَبِعُتْبَةَ بْنِ رَبِيعَةَ  ،  وَبِشَيْبَةَ بْنِ رَبِيعَةَ  ،  وَبِالْوَلِيدِ بْنِ عُتْبَةَ  ،  وَبِأُمَيَّةَ بْنِ خَلَفٍ  ،  وَبِعُقْبَةَ بْنِ أَبِي مُعَيْطٍ  ، قَالَ  عَبْدُ اللهِ  : فَلَقَدْ رَأَيْتُهُمْ قَتْلَى  فِي  قَلِيبِ بَدْرٍ  - أَوْ فِي  قَلِيبٍ  - ، قَالَ  أَبُو إِسْحَاقَ  : وَنَسِيتُ السَّابِعَ  .         [9/212]","","Musnad Abi Ya'la al-Mawsili 5312","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن سفيان الثوري عن جعفر بن عون المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5316","347 - (  5313  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَعْفَرُ بْنُ عَوْنٍ ،         [9/213]      حَدَّثَنَا  مِسْعَرٌ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  الْمُغِيرَةِ الْيَشْكُرِيِّ ،  عَنِ  الْمَعْرُورِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  قَالَتْ  أُمُّ حَبِيبَةَ  : اللَّهُمَّ بَارِكْ لِي فِي زَوْجِي رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَبِأَبِي  أَبِي سُفْيَانَ  ، وَبِأَخِي  مُعَاوِيَةَ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَقَدْ سَأَلْتِ اللهَ عَنْ آجَالٍ مَضْرُوبَةٍ ، وَأَرْزَاقٍ مَقْسُومَةٍ ، وَآثَارٍ مَبْلُوغَةٍ ، لَا يُعَجَّلُ مِنْهَا شَيْءٌ قَبْلَ حِلِّهِ  ، فَلَوْ سَأَلْتِ اللهَ أَنْ يُعِيذَكِ مِنْ عَذَابِ النَّارِ ، أَوْ عَذَابِ الْقَبْرِ كَانَ خَيْرًا أَوْ كَانَ أَفْضَلَ ، قَالَ : فَذُكِرَتِ الْقِرَدَةُ - قَالَ :  وَأُرَاهُ : الْخَنَازِيرُ  - أَكَانَ مِمَّا مُسِخَ فِي  بَنِي إِسْرَائِيلَ  ؟ قَالَ : إِنَّ اللهَ لَمْ يُهْلِكْ قَوْمًا فَيَتْرُكَ لَهُمْ نَسْلًا وَلَا عَاقِبًا ، وَقَدْ كَانَتِ الْقِرَدَةُ -  وَأُرَاهُ قَالَ : الْخَنَازِيرُ  - قَبْلَ ذَلِكَ  .         [9/214]             [9/215]","","Musnad Abi Ya'la al-Mawsili 5313","","عبد الله بن مسعود عن معرور بن سويد الأسدي عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن علقمة بن مرثد الحضرمي عن مسعر بن كدام عن جعفر بن عون المخزومي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5317","348 - (  5314  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي الْفُرَاتِ ،  عَنْ  مُحَمَّدِ بْنِ زَيْدٍ ،  عَنْ  أَبِي الْأَعْيَنِ الْعَبْدِيِّ ،  عَنْ  أَبِي الْأَحْوَصِ الْجُشَمِيِّ ، أَنَّ ابْنَ مَسْعُودٍ ،  حَدَّثَهُمْ  أَنَّهُمْ سَأَلُوا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْقِرَدَةِ وَالْخَنَازِيرِ : أَمِنْ نَسْلِ الْيَهُودِ هِيَ ؟ فَقَالَ رَسُولُ اللهِ :  إِنَّ اللهَ لَمْ يَلْعَنْ قَوْمًا فَمَسَخَهُمْ فَكَانَ لَهُمْ نَسْلٌ حَتَّى يُهْلِكَهُمْ  ، وَلَكِنَّ هَذَا خَلْقٌ كَانَ ، فَلَمَّا غَضِبَ اللهُ عَلَى الْيَهُودِ مَسَخَهُمْ ، فَكَانُوا أَمْثَالَهُمْ  .         [9/216]","","Musnad Abi Ya'la al-Mawsili 5314","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو الأعين العبدي عن محمد بن زيد بن علي البصري عن داود بن أبي الفرات الكندي عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5318","349 - (  5315  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي الْفُرَاتِ ،  بِإِسْنَادِهِ  مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 5315","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو الأعين العبدي عن محمد بن زيد بن علي البصري عن داود بن أبي الفرات الكندي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5319","350 - (  5316  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  حَدَّثَنَا  زَائِدَةُ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مِنْ شِرَارِ النَّاسِ مَنْ تُدْرِكُهُ السَّاعَةُ وَيَتَّخِذُ  الْقُبُورَ  مَسَاجِدَ  .","","Musnad Abi Ya'la al-Mawsili 5316","","عبد الله بن مسعود عن شقيق بن سلمة عن عاصم بن بهدلة عن زائدة بن قدامة عن عثمان بن عمر بن فارس عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5320","351 - (  5317  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْحَاقُ بْنُ         [9/217]      سُلَيْمَانَ الرَّازِيُّ ، قَالَ :  سَمِعْتُ  بَشِيرًا أَبَا إِسْمَاعِيلَ ، ذَكَرَهُ  عَنْ  سَيَّارٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ نَزَلَتْ بِهِ  فَاقَةٌ  فَأَنْزَلَهَا بِالنَّاسِ لَمْ تُسَدَّ  فَاقَتُهُ  ، وَإِنْ أَنْزَلَهَا بِاللهِ أَوْشَكَ اللهُ لَهُ         [9/218]      بِالْغِنَى : إِمَّا غِنًى عَاجِلٌ ، وَإِمَّا مَوْتٌ آجِلٌ  .","","Musnad Abi Ya'la al-Mawsili 5317","","عبد الله بن مسعود عن طارق بن شهاب الأحمسي عن سيار الكوفي عن بشير بن سلمان عن إسحاق بن سليمان الرازي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5321","352 - (  5318  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  هَمَّامٌ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّ الْأُمَمَ عُرِضَتْ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى عُرِضَتْ أُمَّتُهُ ، فَأَعْجَبَهُ كَثْرَتُهُمْ  فَقِيلَ : إِنَّ مَعَ هَؤُلَاءِ سَبْعِينَ أَلْفًا يَدْخُلُونَ الْجَنَّةَ بِغَيْرِ حِسَابٍ  .         [9/219]","","Musnad Abi Ya'la al-Mawsili 5318","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5322","353 - (  5319  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنِ  ابْنِ مَسْعُودٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا كَانَ ثُلُثُ اللَّيْلِ الْبَاقِي يَهْبِطُ اللهُ إِلَى السَّمَاءِ الدُّنْيَا ، ثُمَّ تُفْتَحُ أَبْوَابُ السَّمَاءِ  ، ثُمَّ تُبْسَطُ ، ثُمَّ يَقُولُ : هَلْ مِنْ سَائِلٍ ؟ فَلَا يَزَالُ كَذَلِكَ حَتَّى يَطْلُعَ الْفَجْرُ  .         [9/220]             [9/221]","","Musnad Abi Ya'la al-Mawsili 5319","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن عبد العزيز بن مسلم الخراساني عن عبد الصمد بن عبد الوارث التنوري عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5323","354 - (  5320  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي الْفُرَاتِ ،  عَنْ  مُحَمَّدِ بْنِ زَيْدٍ ،  عَنْ  أَبِي الْأَعْيَنِ الْعَبْدِيِّ ،  عَنْ  أَبِي الْأَحْوَصِ الْجُشَمِيِّ ، أَنَّهُ  قَالَ  :  بَيْنَمَا ابْنُ مَسْعُودٍ يَخْطُبُ ذَاتَ يَوْمٍ إِذْ هُوَ بِحَيَّةٍ تَمْشِي عَلَى الْجِدَارِ ، فَقَطَعَ خُطْبَتَهُ وَضَرَبَهَا بِعُصَيَّةٍ حَتَّى قَتَلَهَا ، ثُمَّ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ قَتَلَ حَيَّةً فَكَأَنَّمَا قَتَلَ رَجُلًا مُشْرِكًا  .         [9/222]","","Musnad Abi Ya'la al-Mawsili 5320","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو الأعين العبدي عن محمد بن زيد بن علي البصري عن داود بن أبي الفرات الكندي عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5324","355 - (  5321  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي الْفُرَاتِ ،  بِإِسْنَادِهِ  مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 5321","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو الأعين العبدي عن محمد بن زيد بن علي البصري عن داود بن أبي الفرات الكندي عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5325","356 - (  5322  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ، قَالَ :  كُنَّا جُلُوسًا عِنْدَ ابْنِ مَسْعُودٍ لَيْلَةً بَعْدَ الْمَغْرِبِ وَهُوَ يُقْرِئُنَا الْقُرْآنَ ، فَسَأَلَهُ رَجُلٌ :  يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، أَسَأَلْتُمْ رَسُولَ اللهِ كَمْ يَمْلِكُ هَذِهِ الْأُمَّةَ مِنْ  خَلِيفَةٍ  ؟  فَقَالَ  ابْنُ مَسْعُودٍ  : مَا سَأَلَنِي مُذْ قَدِمْتُ  الْعِرَاقَ  قَبْلَكَ ، قَالَ : نَعَمْ ، سَأَلْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : اثْنَا عَشَرَ ، عِدَّةَ نُقَبَاءِ  بَنِي إِسْرَائِيلَ  .         [9/223]","","Musnad Abi Ya'la al-Mawsili 5322","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5326","357 - (  5323  ) -  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  حَمَّادٌ ،  بِإِسْنَادِهِ  نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 5323","","عبد الله بن مسعود عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن حماد بن زيد عن شيبان بن فروخ الحبطي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5327","358 - (  5324  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  حَدَّثَنَا  خَالِدٌ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِيَلِنِي مِنْكُمْ أُولُو  الْأَحْلَامِ  وَالنُّهَى ،  ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ  ، وَلَا  تَخْتَلِفُوا  فَتَخْتَلِفَ  قُلُوبُكُمْ ، وَإِيَّاكُمْ  وَهَوْشَاتِ  الْأَسْوَاقِ  .","","Musnad Abi Ya'la al-Mawsili 5324","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن زياد بن كليب عن خالد الحذاء عن يزيد بن زريع العيشي عن يونس بن محمد بن مسلم البغدادي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5328","359 - (  5325  ) -  حَدَّثَنَا  الْقَوَارِيرِيُّ ،  حَدَّثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، مِثْلَهُ .","","Musnad Abi Ya'la al-Mawsili 5325","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن زياد بن كليب عن خالد الحذاء عن يزيد بن زريع العيشي عن عبيد الله بن عمر القواريري عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5329","360 - (  5326  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنَا  أَبِي  ، قَالَ :  سَمِعْتُ  عَبْدَ الْمَلِكِ بْنَ عُمَيْرٍ  يُحَدِّثُ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .         [9/224]","","Musnad Abi Ya'la al-Mawsili 5326","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن عبد الملك بن عمير القبطي عن جرير بن حازم عن وهب بن جرير بن حازم عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5330","361 - (  5327  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَسَدِيُّ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  كَانَ يَقْرَأُ :         {      فَهَلْ مِنْ مُدَّكِرٍ         }      .         [9/225]","","Musnad Abi Ya'la al-Mawsili 5327","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5331","362 - (  5328  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَسَدِيُّ ،  حَدَّثَنَا  أَبَانُ بْنُ عَبْدِ اللهِ الْبَجَلِيُّ ،  عَنْ  كَرِيمِ بْنِ أَبِي حَازِمٍ ،  عَنْ  سَلْمَى بِنْتِ جَابِرٍ ، أَنَّ زَوْجَهَا اسْتُشْهِدَ ، فَأَتَتْ عَبْدَ اللهِ بْنَ مَسْعُودٍ ، فَقَالَتْ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، إِنَّ زَوْجِي اسْتُشْهِدَ ، وَقَدْ خَطَبَنِي الرِّجَالُ ، فَتَرْجُو إِنْ جَمَعَ اللهُ بَيْنِي وَبَيْنَهُ فِي الْجَنَّةِ أَنْ أَكُونَ مِنْ أَزْوَاجِهِ ؟ قَالَ : نَعَمْ ، فَقَالَ بَعْضُ  الْقَوْمِ  : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، مَا رَأَيْنَاكَ صَنَعْتَ هَذَا بِامْرَأَةٍ غَيْرِ هَذِهِ ؟ قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  إِنَّ أَوَّلَ أُمَّتِي لُحُوقًا بِي فِي الْجَنَّةِ امْرَأَةٌ مِنْ  أَحْمَسَ  .         [9/226]","","Musnad Abi Ya'la al-Mawsili 5328","","عبد الله بن مسعود عن سلمى بنت جابر الأحمسية عن كريم بن أبي حازم البجلي عن أبان بن عبد الله بن أبي حازم عن محمد بن عبد الله بن الزبير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5332","363 - (  5329  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  قُلْنَا :  يَا رَسُولَ اللهِ ، أَيُّ الْأَعْمَالِ أَحَبُّ إِلَى اللهِ ؟ قَالَ : تُصَلِّي الصَّلَوَاتِ لِمَوَاقِيتِهَا  ، قَالَ : قُلْتُ : ثُمَّ أَيُّ ؟ قَالَ : ثُمَّ بِرُّ الْوَالِدَيْنِ ، قَالَ : قُلْتُ : ثُمَّ أَيُّ ؟ قَالَ : ثُمَّ  الْجِهَادُ  فِي  سَبِيلِ  اللهِ ، وَلَوِ اسْتَزَدْتُهُ لَزَادَنِي  .","","Musnad Abi Ya'la al-Mawsili 5329","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن عبد العزيز بن مسلم الخراساني عن أحمد بن إسحاق الحضرمي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5333","364 - (  5330  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  سُلَيْمَانُ الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ،  عَنْ  عَلْقَمَةَ ،         [9/227]      عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَدْخُلُ النَّارَ مَنْ كَانَ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةٍ  مِنْ خَرْدَلٍ مِنْ إِيمَانٍ  ، وَلَا يَدْخُلُ الْجَنَّةَ مَنْ كَانَ فِي قَلْبِهِ  مِثْقَالُ  حَبَّةِ  خَرْدَلٍ مِنْ  كِبْرٍ  .","","Musnad Abi Ya'la al-Mawsili 5330","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن عبد العزيز بن مسلم الخراساني عن أحمد بن إسحاق الحضرمي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5334","365 - (  5331  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ، بِمِثْلِهِ .","","Musnad Abi Ya'la al-Mawsili 5331","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن عبد العزيز بن مسلم الخراساني عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5335","366 - (  5332  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  حَدَّثَنَا  شَيْبَانُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  عَنْ  أَبِيهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قِتَالُ الْمُؤْمِنِ  كُفْرٌ  ،  وَسِبَابُهُ  فُسُوقٌ  .","","Musnad Abi Ya'la al-Mawsili 5332","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن عبد الملك بن عمير القبطي عن شيبان بن عبد الرحمن المؤدب عن يحيى بن أبي بكير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5336","367 - (  5333  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  أَقْرَأَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ( إِنِّي أَنَا الرَّزَّاقُ ذُو الْقُوَّةِ الْمَتِينُ )  .         [9/228]","","Musnad Abi Ya'la al-Mawsili 5333","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن يحيى بن أبي بكير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5337","368 - (  5334  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ، وَحُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَا :  حَدَّثَنَا  زُهَيْرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ، وَعَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  أَنَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يُكَبِّرُ فِي كُلِّ رَفْعٍ ، وَوَضْعٍ ، وَقِيَامٍ ، وَيُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ شِمَالِهِ  : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، حَتَّى أَرَى بَيَاضَ خَدَّيْهِ ، وَرَأَيْتُ  أَبَا بَكْرٍ  وَعُمَرَ  يَفْعَلَانِ ذَلِكَ  .","","Musnad Abi Ya'la al-Mawsili 5334","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن عبد الرحمن بن الأسود النخعي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن حميد بن عبد الرحمن الرؤاسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5338","369 - (  5335  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ ، عَنْ أَبِي الْأَحْوَصِ ،  سَمِعَهُ  مِنْهُ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  قَالَ لِقَوْمٍ يَتَخَلَّفُونَ عَنِ الْجُمُعَةِ :  لَقَدْ هَمَمْتُ أَنْ آمُرَ رَجُلًا يُصَلِّي بِالنَّاسِ ، ثُمَّ أُحَرِّقَ         [9/229]      عَلَى رِجَالٍ يَتَخَلَّفُونَ عَنِ الْجُمُعَةِ بُيُوتَهُمْ  .","","Musnad Abi Ya'la al-Mawsili 5335","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5339","370 - (  5336  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ ، قَالَ : لَيْسَ  أَبُو عُبَيْدَةَ  ذَكَرَهُ ، وَلَكِنْ عَبْدُ الرَّحْمَنِ بْنُ الْأَسْوَدِ ،  أُرَاهُ ،  عَنْ  عَبْدِ اللهِ  ، قَالَ :  أَتَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْغَائِطَ وَأَمَرَنِي أَنْ آتِيَهُ بِثَلَاثَةِ أَحْجَارٍ  ، فَأَخَذْتُ حَجَرَيْنِ وَالْتَمَسْتُ الثَّالِثَ فَلَمْ أَجِدْهُ ، فَأَخَذْتُ رَوْثَةً فَأَتَيْتُ بِهِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَخَذَ الْحَجَرَيْنِ وَأَلْقَى         [9/230]      الرَّوْثَةَ  ، وَقَالَ : هَذِهِ  رِكْسٌ  .","","Musnad Abi Ya'la al-Mawsili 5336","","عبد الله بن مسعود عن عبد الرحمن بن الأسود النخعي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5340","371 - (  5337  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  زُهَيْرٌ ،  حَدَّثَنَا  أَبُو إِسْحَاقَ الشَّيْبَانِيُّ ، قَالَ :  أَتَيْتُ زِرَّ بْنَ حُبَيْشٍ ، قَالَ : فَأُلْقِيَتْ عَلَيَّ مَحَبَّةٌ مِنْهُ ، وَعِنْدَهُ شَبَابٌ ، فَقَالُوا لِي : سَلْهُ -         {      فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَى         }      - فَسَأَلْتُهُ ، فَقَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأَى  جِبْرِيلَ  وَلَهُ سِتُّمِائَةِ جَنَاحٍ  .","","Musnad Abi Ya'la al-Mawsili 5337","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن سليمان بن فيروز الشيباني عن زهير بن معاوية بن حديج عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5341","372 - (  5338  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ، أَنَّ ابْنَ مَسْعُودٍ  حَدَّثَهُمْ  : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  يَكُونُ فِي النَّارِ قَوْمٌ مَا شَاءَ اللهُ ، ثُمَّ يَرْحَمُهُمُ اللهُ فَيَكُونُونَ فِي أَدْنَى الْجَنَّةِ  ، فَيُغَسَّلُونَ فِي نَهَرِ الْحَيَاةِ ، يُسَمِّيهِمْ أَهْلُ الْجَنَّةِ الْجَهَنَّمِيِّينَ ، لَوْ أَضَافَ أَحَدُهُمُ الدُّنْيَا لَأَطْعَمَهُمْ ، وَسَقَاهُمْ ، وَفَرَشَهُمْ ، وَلَحَفَهُمْ - وَأَحْسَبُهُ قَالَ : وَزَوَّجَهُمْ - لَا يَنْقُصُهُ ذَلِكَ شَيْئًا  .         [9/231]","","Musnad Abi Ya'la al-Mawsili 5338","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن عطاء بن السائب عن حماد بن سلمة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5342","373 - (  5339  ) -  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  شَيْبَانُ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عِمْرَانَ بْنِ حُصَيْنٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  تَحَدَّثْنَا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ لَيْلَةٍ حَتَّى أَكْثَرْنَا الْحَدِيثَ ، ثُمَّ رَجَعْنَا إِلَى أَهْلِينَا ، فَلَمَّا غَدَوْنَا عَلَى نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّهَا عُرِضَتْ عَلَيَّ اللَّيْلَةَ الْأَنْبِيَاءُ بِأُمَمِهَا وَأَتْبَاعُهَا مِنْ أُمَمِهَا  ، فَجَعَلَ النَّبِيُّ يَمُرُّ مَعَهُ الثَّلَاثَةُ مِنْ أُمَّتِهِ ، وَالنَّبِيُّ يَمُرُّ مَعَهُ الْعِصَابَةُ مِنْ أُمَّتِهِ ، وَالنَّبِيُّ يَمُرُّ مَعَهُ النَّفَرُ الْيَسِيرُ ، وَالنَّبِيُّ يَمُرُّ مَعَهُ الرَّجُلُ الْوَاحِدُ مِنْ أُمَّتِهِ ، وَالنَّبِيُّ يَمُرُّ مَا مَعَهُ مِنْ قَوْمَهِ أَحَدٌ ، وَقَدْ أَنْبَأَكُمُ اللهُ عَنْ  لُوطٍ  ، وَقَالَ :         {      أَلَيْسَ مِنْكُمْ رَجُلٌ رَشِيدٌ         }      ، قَالَ : حَتَّى أَتَى عَلَيَّ  مُوسَى  فِي  كَبْكَبَةٍ  مِنْ  بَنِي إِسْرَائِيلَ  ، فَلَمَّا رَأَيْتُهُمْ أَعْجَبُونِي ، قَالَ : قُلْتُ : مَنْ هَؤُلَاءِ ؟ قَالَ : هَذَا أَخُوكَ  مُوسَى بْنُ عِمْرَانَ  وَمَنْ تَبِعَهُ مِنْ  بَنِي إِسْرَائِيلَ  ، قَالَ : قُلْتُ : رَبِّ فَأَيْنَ أُمَّتِي ؟ قَالَ : انْظُرْ عَنْ يَمِينِكَ ، فَإِذَا الظِّرَابُ : ظِرَابُ  مَكَّةَ  ، قَدْ سُدَّتْ بِوُجُوهِ الرِّجَالِ ، قَالَ : قُلْتُ : رَبِّ ، مَنْ هَؤُلَاءِ ؟ قَالَ : هَؤُلَاءِ أُمَّتُكَ ، قَالَ لِي : أَرَضِيتَ ؟ قَالَ : قُلْتُ : رَبِّي ، رَضِيتُ ، قَالَ : قِيلَ لِي : انْظُرْ عَنْ يَسَارِكَ ، فَإِذَا الْأُفُقُ قَدْ سُدَّ         [9/232]      بِالرِّجَالِ ، قَالَ : فَإِنَّ مَعَ هَؤُلَاءِ سَبْعِينَ أَلْفًا يَدْخُلُونَ الْجَنَّةَ لَا حِسَابَ عَلَيْهِمْ ، قَالَ : فَأَنْشَأَ  عُكَّاشَةُ بْنُ مِحْصَنٍ  أَخُو  بَنِي أَسَدِ بْنِ خُزَيْمَةَ  ، فَقَالَ : يَا رَسُولَ اللهِ ، ادْعُ رَبَّكَ أَنْ يَجْعَلَنِي مِنْهُمْ ، قَالَ : اللَّهُمَّ اجْعَلْهُ مِنْهُمْ ، قَالَ : فَأَنْشَأَ رَجُلٌ آخَرُ ، فَقَالَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : سَبَقَكَ بِهَا  عُكَّاشَةُ  ، قَالَ : ثُمَّ قَالَ يَوْمَئِذٍ : أَرْجُو أَنْ يَكُونَ مَنْ تَبِعَنِي مِنْ أُمَّتِي رُبُعَ أَهْلِ الْجَنَّةِ ، قَالَ : فَكَبَّرْنَا ، ثُمَّ قَالَ : أَرْجُو أَنْ تَكُونُوا الثُّلُثَ ، قَالَ : ثُمَّ كَبَّرْنَا ، ثُمَّ قَالَ : أَرْجُو أَنْ تَكُونُوا  الشَّطْرَ  ، ثُمَّ قَرَأَ :         {      ثُلَّةٌ مِنَ الأَوَّلِينَ             *          وَثُلَّةٌ مِنَ الآخِرِينَ         }      ، فَذَكَرَ لَنَا أَنَّ رِجَالًا مِنَ الْمُؤْمِنِينَ تَرَاجَعُوا بَيْنَهُمْ ، فَقَالَ : مَا تَرَوْنَ أَتَرَوْنَ عَمَلَ هَؤُلَاءِ السَّبْعِينَ الَّذِينَ يَدْخُلُونَ الْجَنَّةَ لَا حِسَابَ عَلَيْهِمْ حَتَّى صَيَّرُوهُمْ أَنَّهُمْ نَاسٌ وُلِدُوا فِي الْإِسْلَامِ ، ثُمَّ لَمْ يَزَالُوا حَتَّى مَاتُوا عَلَيْهِ ، قَالَ فِيمَا حَدَّثَهُمْ حَتَّى بَلَغَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : لَيْسَ كَذَلِكَ وَلَكِنْ هُمُ الَّذِينَ لَا  يَكْتَوُونَ ،  وَلَا  يَسْتَرْقُونَ ،  وَلَا يَتَطَيَّرُونَ ، وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ ، قَالَ : وَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : يَوْمَئِذٍ إِنِ اسْتَطَعْتُمْ - فِدَاكُمْ أَبِي وَأُمِّي - أَنْ تَكُونُوا مِنَ السَّبْعِينَ فَكُونُوا مِنَ السَّبْعِينَ ، فَإِنْ         [9/233]      عَجَزْتُمْ وَقَصَّرْتُمْ ، فَكُونُوا مِنْ أَهْلِ الظِّرَابِ ، فَإِنْ عَجَزْتُمْ وَقَصَّرْتُمْ فَكُونُوا مِنْ أَهْلِ الْأُفُقِ ، فَإِنِّي رَأَيْتُ عِنْدَهُ نَاسًا يَتَهَوَّشُونَ كَثِيرًا  .","","Musnad Abi Ya'la al-Mawsili 5339","","عبد الله بن مسعود عن عمران بن حصين بن عبيد بن خلف الخزاعي عن الحسن البصري عن قتادة بن دعامة عن شيبان بن عبد الرحمن المؤدب عن الحسن بن موسى الأشيب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5343","374 - (  5340  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ مُوسَى ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنِ  ابْنِ مَسْعُودٍ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  عُرِضَتْ عَلَيَّ الْأُمَمُ بِالْمَوْسِمِ ، فَرَأَيْتُ أُمَّتِي ، ثُمَّ رَأَيْتُهُمْ فَأَعْجَبَنِي كَثْرَتُهُمْ  وَهَيْئَتُهُمْ قَدْ مَلَأُوا السَّهْلَ وَالْجَبَلَ ، فَقَالَ : رَضِيتَ يَا  مُحَمَّدُ  ؟ قَالَ : قُلْتُ : نَعَمْ ، قَالَ : إِنَّ لَكَ مَعَ هَؤُلَاءِ سَبْعِينَ أَلْفًا يَدْخُلُونَ الْجَنَّةَ بِغَيْرِ حِسَابٍ ، هُمُ الَّذِينَ لَا  يَسْتَرْقُونَ  وَلَا  يَكْتَوُونَ  وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ ، فَقَامَ  عُكَّاشَةُ بْنُ مِحْصَنٍ  ، فَقَالَ : يَا رَسُولَ اللهِ ، ادْعُ اللهَ أَنْ يَجْعَلَنِي مِنْهُمْ ، فَدَعَا لَهُ ، ثُمَّ قَامَ آخَرُ ، فَقَالَ : يَا رَسُولَ اللهِ ، ادْعُ اللهَ أَنْ يَجْعَلَنِي مِنْهُمْ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : سَبَقَكَ بِهَا  عُكَّاشَةُ  .         [9/234]","","Musnad Abi Ya'la al-Mawsili 5340","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن الحسن بن موسى الأشيب عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5344","375 - (  5341  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هِشَامُ بْنُ عَبْدِ الْمَلِكِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ ، قَالَ :  سَمِعْتُ  النَّزَّالَ بْنَ سَبْرَةَ ، يَقُولُ :  سَمِعْتُ  عَبْدَ اللهِ ، يَقُولُ :  سَمِعْتُ  رَجُلًا  يَقْرَأُ آيَةً سَمِعْتُ خِلَافَهَا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : فَأَخَذْتُ بِيَدِهِ فَأَتَيْتُ بِهِ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : كِلَاكُمَا مُحْسِنٌ ، قَالَ  شُعْبَةُ  :  وَأَظُنُّهُ قَالَ  :  لَا تَخْتَلِفُوا ، فَإِنَّ مَنْ قَبْلَكُمُ اخْتَلَفُوا فِيهِ فَهَلَكُوا  .","","Musnad Abi Ya'la al-Mawsili 5341","","عبد الله بن مسعود عن النزال بن سبرة الهلالي عن عبد الملك بن ميسرة الهلالي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5345","376 - (  5342  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هِشَامُ بْنُ عَبْدِ الْمَلِكِ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  سُلَيْمَانَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  يُنْصَبُ لِكُلِّ غَادِرٍ  لِوَاءٌ  يَوْمَ الْقِيَامَةِ ، يُقَالُ : هَذِهِ غَدْرَةُ فُلَانٍ  .         [9/235]","","Musnad Abi Ya'la al-Mawsili 5342","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5346","377 - (  5343  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هِشَامُ بْنُ عَبْدِ الْمَلِكِ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ، أَوْ عَلْقَمَةَ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : إِنِّي أَصَبْتُ امْرَأَةً فِي الْبُسْتَانِ  ، فَأَصَبْتُ مِنْهَا كُلَّ شَيْءٍ غَيْرَ أَنِّي لَمْ أَنْكِحْهَا ، فَافْعَلْ بِي مَا شِئْتَ ، فَلَمْ يَقُلْ لَهُ شَيْئًا ، فَذَهَبَ ، ثُمَّ دَعَاهُ فَقَرَأَ عَلَيْهِ :         {      وَأَقِمِ الصَّلاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ         }      .","","Musnad Abi Ya'la al-Mawsili 5343","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن أبو الوليد الطيالسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5347","378 - (  5344  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هِشَامُ بْنُ عَبْدِ         [9/236]      الْمَلِكِ ،  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  آكِلَ  الرِّبَا  ، وَمُوكِلَهُ ، وَشَاهِدَيْهِ ، وَكَاتِبَهُ  .","","Musnad Abi Ya'la al-Mawsili 5344","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن أبو الوليد الطيالسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5348","379 - (  5345  ) -  وَبِهِ  حَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  خَالِدِ بْنِ رِبْعِيٍّ الْأَسَدِيِّ ، قَالَ :  سَمِعْتُ  ابْنَ مَسْعُودٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  إِنَّ صَاحِبَكُمْ  خَلِيلُ  اللهِ  .","","Musnad Abi Ya'la al-Mawsili 5345","","عبد الله بن مسعود عن خالد بن ربعي الأسدي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن أبو الوليد الطيالسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5349","380 - (  5346  ) -  وَحَدَّثَنَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قِتَالُ الْمُسْلِمِ أَخَاهُ  كُفْرٌ  ،  وَسِبَابُهُ  فُسُوقٌ  .","","Musnad Abi Ya'la al-Mawsili 5346","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن أبو الوليد الطيالسي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5350","381 - (  5347  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْفَضْلُ بْنُ دُكَيْنٍ ،  حَدَّثَنَا  سَيْفُ بْنُ أَبِي سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  مُجَاهِدًا ، قَالَ :         [9/237]      حَدَّثَنِي  أَبُو مَعْمَرٍ عَبْدُ اللهِ بْنُ سَخْبَرَةَ ، قَالَ :  سَمِعْتُ  ابْنَ مَسْعُودٍ ، يَقُولُ :  عَلَّمَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  التَّشَهُّدَ  كَفِّي بَيْنَ كَفَّيْهِ  كَمَا يُعَلِّمُنِي السُّورَةَ مِنَ الْقُرْآنِ :  التَّحِيَّاتُ  لِلهِ وَالصَّلَوَاتُ  وَالطَّيِّبَاتُ  ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، وَهُوَ بَيْنَ  ظَهْرَانَيْنَا  ، فَلَمَّا قُبِضَ قُلْنَا : السَّلَامُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Musnad Abi Ya'la al-Mawsili 5347","","عبد الله بن مسعود عن عبد الله بن سخبرة عن مجاهد بن جبر المخزومي عن سيف بن سليمان المخزومي عن الفضل بن دكين عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5351","382 - (  5348  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْفَضْلُ بْنُ دُكَيْنٍ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الرُّكَيْنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ  يَرْفَعُهُ  ، قَالَ :  الرِّبَا وَإِنْ كَثُرَ فَإِنَّ عَاقِبَتَهُ تَصِيرُ إِلَى  قُلٍّ  .","","Musnad Abi Ya'la al-Mawsili 5348","","عبد الله بن مسعود عن الربيع بن عميلة الفزاري عن ركين بن الربيع الفزاري عن شريك بن عبد الله النخعي عن الفضل بن دكين عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5352","383 - (  5349  ) -  حَدَّثَنَا  بِشْرُ بْنُ الْوَلِيدِ ،  حَدَّثَنَا  شَرِيكٌ ،  عَنِ  الرُّكَيْنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ  - أَوْ قَالَ :  عَنِ  ابْنِ مَسْعُودٍ  - ،  رَفَعَهُ  ، قَالَ :  الرِّبَا وَإِنْ كَثُرَ فَإِنَّ عَاقِبَتَهُ تَصِيرُ إِلَى  قُلٍّ  .","","Musnad Abi Ya'la al-Mawsili 5349","","عبد الله بن مسعود عن الربيع بن عميلة الفزاري عن ركين بن الربيع الفزاري عن شريك بن عبد الله النخعي عن بشر بن الوليد الكندي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5353","384 - (  5350  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْفَضْلُ ، وَمُحَمَّدُ بْنُ         [9/238]      عَبْدِ اللهِ الْأَسَدِيُّ ، قَالَا :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  أَبِي قَيْسٍ ،  عَنْ  هُزَيْلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  آكِلَ  الرِّبَا  ، وَمُوكِلَهُ ، وَالْوَاصِلَةَ ، وَالْمَوْصُولَةَ ،  وَالْمُحِلَّ  وَالْمُحَلَّلَ لَهُ  .","","Musnad Abi Ya'la al-Mawsili 5350","","عبد الله بن مسعود عن هزيل بن شرحبيل الأودي عن عبد الرحمن بن ثروان الأودي عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5354","385 - (  5351  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هُشَيْمُ بْنُ بَشِيرٍ ،  حَدَّثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  نَافِعِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ الْمُشْرِكِينَ شَغَلُوا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ الْخَنْدَقِ  عَنْ أَرْبَعِ صَلَوَاتٍ  حَتَّى ذَهَبَ مِنَ اللَّيْلِ مَا شَاءَ اللهُ ، قَالَ : ثُمَّ أَمَرَ  بِلَالًا  فَأَذَّنَ ، ثُمَّ أَقَامَ فَصَلَّى الظُّهْرَ ، ثُمَّ أَقَامَ فَصَلَّى الْعَصْرَ ، ثُمَّ أَقَامَ فَصَلَّى الْمَغْرِبَ ، ثُمَّ أَقَامَ فَصَلَّى الْعِشَاءَ  .","","Musnad Abi Ya'la al-Mawsili 5351","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن نافع بن جبير بن مطعم النوفلي عن أبو الزبير المكي عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5355","386 - (  5352  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  هُشَيْمٌ ،  أَخْبَرَنَا  الْعَوَّامُ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي مُحَمَّدٍ مَوْلًى لِعُمَرَ بْنِ الْخَطَّابِ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ مُسْلِمَيْنِ يَمُوتُ لَهُمَا ثَلَاثٌ إِلَّا كَانُوا لَهُمَا حِصْنًا حَصِينًا مِنَ النَّارِ  ، قَالَ :         [9/239]      فَقُلْنَا : يَا رَسُولَ اللهِ ، وَإِنْ كَانَا اثْنَيْنِ ؟ قَالَ : وَإِنْ كَانَا اثْنَيْنِ ، قَالَ : فَقَالَ  أَبُو ذَرٍّ  : يَا رَسُولَ اللهِ ، لَمْ أُقَدِّمْ إِلَّا اثْنَيْنِ ؟ قَالَ : وَإِنْ كَانَا اثْنَيْنِ ، قَالَ : فَقَالَ  أُبَيُّ بْنُ كَعْبٍ أَبُو الْمُنْذِرِ سَيِّدُ الْقُرَّاءِ  : لَمْ أُقَدِّمْ إِلَّا وَاحِدًا ؟ قَالَ : وَإِنْ كَانَ وَاحِدًا ، قَالَ : إِنَّمَا ذَلِكَ عِنْدَ  الصَّدْمَةِ  الْأُولَى  .","","Musnad Abi Ya'la al-Mawsili 5352","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن أبو محمد مولى عمر بن الخطاب عن العوام بن حوشب عن هشيم بن بشير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5356","387 - (  5353  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  خُصَيْفٍ ،  حَدَّثَنَا  أَبُو عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  صَلَّى بِنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَاةَ الْخَوْفِ ، فَقَامُوا صَفَّيْنِ  ، فَقَامَ صَفٌّ خَلْفَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَصَفٌّ مُسْتَقْبِلٌ الْعَدُوَّ ، فَصَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالصَّفِّ الَّذِينَ يَلُونَهُ رَكْعَةً ، ثُمَّ قَامُوا فَذَهَبُوا فَقَامُوا مَقَامَ أُولَئِكَ مُسْتَقْبِلَ الْعَدُوِّ ، وَجَاءَ أُولَئِكَ فَقَامُوا مَقَامَهُمْ ، فَصَلَّى بِهِمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَلَّمَ ، ثُمَّ قَامُوا فَصَلَّوْا لِأَنْفُسِهِمْ رَكْعَةً ثُمَّ سَلَّمُوا ، ثُمَّ ذَهَبُوا فَقَامُوا مَقَامَ أُولَئِكَ مُسْتَقْبِلِي الْعَدُوِّ ، وَرَجَعَ أُولَئِكَ إِلَى مَقَامِهِمْ فَصَلَّوْا لِأَنْفُسِهِمْ رَكْعَةً ، ثُمَّ سَلَّمُوا  .         [9/240]","","Musnad Abi Ya'la al-Mawsili 5353","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن خصيف الجزري عن محمد بن فضيل بن غزوان عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5357","388 - (  5354  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  سُفْيَانَ ،  عَنْ  عِيسَى بْنِ أَبِي عَزَّةَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَطَعَ فِي قِيمَةِ خَمْسَةِ دَرَاهِمَ  .","","Musnad Abi Ya'la al-Mawsili 5354","","عبد الله بن مسعود عن الشعبي عن عيسى بن أبي عزة الشعبي عن سفيان الثوري عن عبد الرحمن بن مهدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5358","389 - (  5355  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  حَدَّثَنَا  زَائِدَةُ ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَحِقَ بِالنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَبْدٌ أَسْوَدُ فَمَاتَ ، فَأُذِنَ بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  انْظُرُوا هَلْ تَرَكَ شَيْئًا ؟ قَالُوا : تَرَكَ         [9/241]      دِينَارَيْنِ ، قَالَ : كَيَّتَانِ  .","","Musnad Abi Ya'la al-Mawsili 5355","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5359","390 - (  5356  ) -  وَعَنْ  زَائِدَةَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  إِبْرَاهِيمَ بْنِ سُوَيْدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ حَدَّثَهُمْ : أَنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِذْنُكَ عَلَيَّ أَنْ تَرْفَعَ الْحِجَابَ ، وَأَنْ تَسْمَعَ  سِوَادِي  حَتَّى أَنْهَاكَ  ، قَالَ  الْحَسَنُ  :  السِّوَادُ :  السِّرَارُ  .","","Musnad Abi Ya'la al-Mawsili 5356","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن إبراهيم بن سويد الصيرفي الأعور عن الحسن بن عبيد الله النخعي عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5360","391 - (  5357  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُعَاوِيَةُ ،  حَدَّثَنَا  زَائِدَةُ ، قَالَ سُلَيْمَانُ : سَمِعْتُهُمْ يَذْكُرُونَ ،  عَنْ  إِبْرَاهِيمَ بْنِ سُوَيْدٍ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذْنُكَ عَلَيَّ أَنْ تَكْشِفَ السِّتْرَ  .","","Musnad Abi Ya'la al-Mawsili 5357","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم بن سويد الصيرفي الأعور عن الأعمش عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5361","392 - (  5358  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ، قَالَ :  حَدَّثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  حَدَّثَنَا  الْحَارِثُ بْنُ حَصِيرَةَ ،  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،         [9/242]      عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  قَالَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : كَيْفَ أَنْتُمْ وَرُبُعُ أَهْلِ الْجَنَّةِ  ، لَكُمْ رُبُعُهَا وَلِسَائِرِ النَّاسِ ثَلَاثَةُ أَرْبَاعِهَا ؟ قَالَ : فَقَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ : فَكَيْفَ أَنْتُمْ وَثُلُثُهَا ؟ قَالَ : فَيَقُولُونَ : فَذَاكَ الْخَيْرُ ، قَالَ : فَكَيْفَ أَنْتُمْ  وَالشَّطْرُ  ؟ قَالُوا : فَذَاكَ الْخَيْرُ ، قَالَ : فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَهْلُ الْجَنَّةِ يَوْمَ الْقِيَامَةِ عِشْرُونَ وَمِائَةُ صَفٍّ أَنْتُمْ مِنْهَا ثَمَانُونَ صَفًّا  .","","Musnad Abi Ya'la al-Mawsili 5358","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن الحارث بن حصيرة الأزدي عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5362","393 - (  5359  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  أَخْبَرَنَا  عَاصِمُ بْنُ بَهْدَلَةَ ،  عَنْ  زِرٍّ ،         [9/243]      عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ  :  كُنَّا  يَوْمَ بَدْرٍ  كُلُّ ثَلَاثَةٍ عَلَى بَعِيرٍ  ، فَكَانَ  أَبُو لُبَابَةَ  ،  وَعَلِيُّ بْنُ أَبِي طَالِبٍ  زَمِيلَيْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ : فَكَانَ إِذَا حَانَتْ عُقْبَةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَا : نَحْنُ نَمْشِي عَنْكَ ، قَالَ : مَا أَنْتُمَا بِأَقْوَى مِنِّي ، وَمَا أَنَا بِأَغْنَى عَنِ الْأَجْرِ مِنْكُمَا  .","","Musnad Abi Ya'la al-Mawsili 5359","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5363","394 - (  5360  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،         [9/244]      عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  فِي هَذِهِ الْآيَةِ :         {      وَلَقَدْ رَآهُ نَـزْلَةً أُخْرَى         }      ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : رَأَيْتُ  جِبْرِيلَ  عِنْدَ  سِدْرَةِ  الْمُنْتَهَى  عَلَيْهِ سِتُّمِائَةِ جَنَاحٍ ، يَنْتَثِرُ مِنْ رِيشِهِ  التَّهَاوِيلُ  : الدُّرُّ وَالْيَاقُوتُ  .","","Musnad Abi Ya'la al-Mawsili 5360","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5364","395 - (  5361  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادٌ ،  أَخْبَرَنَا  عَطَاءُ بْنُ السَّائِبِ ،  عَنْ  مُرَّةَ الْهَمْدَانِيِّ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  عَجِبَ  رَبُّنَا تَبَارَكَ وَتَعَالَى مِنْ رَجُلَيْنِ  : مِنْ رَجُلٍ ثَارَ مِنْ لِحَافِهِ وَفِرَاشِهِ مِنْ بَيْنِ حَيِّهِ وَأَهْلِهِ إِلَى صَلَاتِهِ ، فَيَقُولُ اللهُ لِمَلَائِكَتِهِ : يَا مَلَائِكَتِي ، انْظُرُوا إِلَى عَبْدِي هَذَا ، قَامَ مِنْ بَيْنِ فِرَاشِهِ وَلِحَافِهِ مِنْ بَيْنِ حَيِّهِ وَأَهْلِهِ إِلَى صَلَاتِهِ ، رَغْبَةً فِيمَا عِنْدِي ، وَشَفَقَةً مِمَّا عِنْدِي ، وَرَجُلٍ غَزَا فِي  سَبِيلِ  اللهِ فَفَرَّ أَصْحَابُهُ ، وَعَلِمَ مَا عَلَيْهِ فِي الْفِرَارِ ، وَمَا لَهُ فِي الرُّجُوعِ ، فَرَجَعَ حَتَّى أُهَرِيقَ دَمُهُ ، فَيَقُولُ اللهُ لِمَلَائِكَتِهِ : انْظُرُوا إِلَى عَبْدِي هَذَا رَجَعَ رَغْبَةً فِيمَا عِنْدِي ، وَشَفَقَةً مِمَّا عِنْدِي  .","","Musnad Abi Ya'la al-Mawsili 5361","","عبد الله بن مسعود عن مرة بن شراحيل عن عطاء بن السائب عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5365","396 - (  5362  ) -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ، وَإِبْرَاهِيمُ         [9/245]      بْنُ الْحَجَّاجِ ، قَالَا :  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُرَّةَ الْهَمْدَانِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ أَوْ نَحْوَهُ .","","Musnad Abi Ya'la al-Mawsili 5362","","عبد الله بن مسعود عن مرة بن شراحيل عن عطاء بن السائب عن حماد بن سلمة عن عبد الواحد بن غياث عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5366","397 - (  5363  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  شُعْبَةُ ،  قَالَ  أَبُو إِسْحَاقَ :  أَنْبَأَنَا  عَنْ  أَبِي الْأَحْوَصِ ، قَالَ :  كَانَ عَبْدُ اللهِ ،  يَقُولُ  :  إِنَّ الْكَذِبَ لَا يَصْلُحُ مِنْهُ جِدٌّ وَلَا هَزْلٌ ، وَلَا يَعِدُ الرَّجُلُ الرَّجُلَ شَيْئًا ثُمَّ لَا يُنْجِزُهُ لَهُ  ، وَإِنَّ  مُحَمَّدًا  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  قَالَ لَنَا : أَلَا أُنَبِّئُكُمْ  بِالْعَضْهِ  ؟ هِيَ النَّمِيمَةُ ،  الْقَالَةُ  بَيْنَ النَّاسِ  ، وَإِنَّ  مُحَمَّدًا  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : لَا يَزَالُ الرَّجُلُ يَصْدُقُ حَتَّى يُكْتَبَ عِنْدَ اللهِ صِدِّيقًا ، وَلَا يَزَالُ الرَّجُلُ يَكْذِبُ حَتَّى يُكْتَبَ عِنْدَ اللهِ كَذَّابًا ، أَلَا تَرَوْنَ أَنَّهُ يُقَالُ لِلصَّادِقِ : صَدَقَ وَبَرَّ ، وَيُقَالُ لِلْكَاذِبِ : كَذَبَ وَفَجَرَ ، وَإِنَّ الصِّدْقَ يَهْدِي إِلَى  الْبِرِّ  ، وَإِنَّ         [9/246]      الْبِرَّ  يَهْدِي إِلَى الْجَنَّةِ ، وَإِنَّ الْكَذِبَ يَهْدِي إِلَى  الْفُجُورِ  ، وَإِنَّ  الْفُجُورَ  يَهْدِي إِلَى النَّارِ  .","","Musnad Abi Ya'la al-Mawsili 5363","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5367","398 - (  5364  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  هَمَّامُ بْنُ يَحْيَى ،  حَدَّثَنَا  عَاصِمٌ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الْعَيْنَانِ تَزْنِيَانِ ، وَالْيَدَانِ تَزْنِيَانِ ، وَالرِّجْلَانِ تَزْنِيَانِ ، وَالْفَرْجُ يَزْنِي  .         [9/247]","","Musnad Abi Ya'la al-Mawsili 5364","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن عاصم بن بهدلة عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5368","399 - (  5365  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَفَّانُ ،  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  حَدَّثَنَا  عَاصِمُ بْنُ بَهْدَلَةَ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  أَنَّهُ كَانَ  يَجْنِي  لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سِوَاكًا مِنْ أَرَاكٍ ، وَكَانَتْ تَكْفَؤُهُ الرِّيحُ ، فَكَانَ فِي سَاقَيْهِ دِقَّةٌ ، فَضَحِكَ  الْقَوْمُ  ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : مَا يُضْحِكُكُمْ ؟ قَالُوا : دِقَّةُ سَاقَيْهِ ، قَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ ، لَهُمَا أَثْقَلُ فِي الْمِيزَانِ مِنْ  أُحُدٍ  .","","Musnad Abi Ya'la al-Mawsili 5365","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5369","400 - (  5366  ) -  وَعَنْ  حَمَّادٍ ،  أَخْبَرَنَا  عَطَاءُ بْنُ السَّائِبِ ،  عَنِ  ابْنِ أُذُنَانِ ،  قَالَ  :  أَسْلَفْتُ عَلْقَمَةَ أَلْفَيْ دِرْهَمٍ ، فَلَمَّا خَرَجَ         [9/248]             [9/249]      عَطَاؤُهُ ، قُلْتُ لَهُ : اقْضِنِي ، قَالَ : أَخِّرْنِي إِلَى قَابِلٍ ، قَالَ : فَأَبَيْتُ عَلَيْهِ ، فَأَخَذْتُهَا مِنْهُ ، قَالَ : فَأَتَيْتُهُ بَعْدَ ذَلِكَ ، فَقَالَ :  بَرَّحْتَ  بِي ، وَقَدْ مَنَعْتَنِي ، فَقُلْتُ : نَعَمْ ، هُوَ عَمَلُكَ ، قَالَ : فَمَا شَأْنِي ؟ قُلْتُ : إِنَّكَ  حَدَّثْتَنِي ، عَنِ  ابْنِ مَسْعُودٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  إِنَّ  السَّلَفَ  يَجْرِي مَجْرَى  شَطْرِ  الصَّدَقَةِ  ، قَالَ : نَعَمْ ، فَهُوَ كَذَلِكَ ، قَالَ : فَخُذِ الْآنَ  .","","Musnad Abi Ya'la al-Mawsili 5366","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن سليم بن أذنان النخعي عن عطاء بن السائب عن حماد بن سلمة عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5370","401 - (  5367  ) -  وَعَنْ  عَفَّانَ ،  حَدَّثَنَا  جَرِيرُ بْنُ حَازِمٍ ، قَالَ :  سَمِعْتُ  أَبَا إِسْحَاقَ يُحَدِّثُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، قَالَ :  حَجَجْنَا مَعَ ابْنِ مَسْعُودٍ حَتَّى إِذَا طَلَعَ أَوَّلُ الْفَجْرِ قَامَ فَصَلَّى الْغَدَاةَ ، قَالَ : فَقُلْتُ لَهُ : مَا كُنْتَ تُصَلِّي هَذِهِ الصَّلَاةَ هَذِهِ السَّاعَةَ ؟ وَكَانَ يُسْفِرُ بِالصَّلَاةِ ، قَالَ :  إِنِّي رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي فِي هَذَا الْيَوْمِ ، فِي هَذَا الْمَكَانِ يُصَلِّي هَذِهِ السَّاعَةَ  ، يَعْنِي :  بِجَمْعٍ  .         [9/250]","","Musnad Abi Ya'la al-Mawsili 5367","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن جرير بن حازم عن عفان بن مسلم الصفار عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5371","402 - (  5368  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  حَدَّثَنَا  عَلِيُّ بْنُ صَالِحٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي ، فَإِذَا سَجَدَ وَثَبَ  الْحَسَنُ  وَالْحُسَيْنُ  عَلَى ظَهْرِهِ  ، فَإِذَا أَرَادُوا أَنْ يَمْنَعُوهُمَا أَشَارَ إِلَيْهِمْ : أَنْ دَعُوهُمَا ، فَلَمَّا قَضَى الصَّلَاةَ وَضَعَهُمَا فِي حِجْرِهِ ، وَقَالَ : مَنْ أَحَبَّنِي فَلْيُحِبَّ هَذَيْنِ  .","","Musnad Abi Ya'la al-Mawsili 5368","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن علي بن صالح بن حي عن عبيد الله بن موسى عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5372","403 - (  5369  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ سَابِقٍ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ الْمُؤْمِنُ بِاللَّعَّانِ ، وَلَا  بِالطَّعَّانِ  ، وَلَا الْفَاحِشِ ، وَلَا الْبَذِيءِ  .","","Musnad Abi Ya'la al-Mawsili 5369","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن سابق التميمي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5373","404 - (  5370  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  حَدَّثَنَا  مَنْصُورُ بْنُ أَبِي الْأَسْوَدِ ، قَالَ :  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنَامُ فِي سُجُودِهِ  ، فَمَا         [9/251]      يُعْرَفُ نَوْمُهُ إِلَّا بِنَفْخِهِ ، ثُمَّ يَقُومُ فِي صَلَاتِهِ  .","","Musnad Abi Ya'la al-Mawsili 5370","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن منصور بن أبي الأسود الليثي عن سعيد بن سليمان سعدويه عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5374","405 - (  5371  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  شُجَاعُ بْنُ الْوَلِيدِ بْنِ قَيْسٍ ،  حَدَّثَنَا  أَبُو خَالِدٍ الدَّالَانِيُّ ،  عَنْ  طَلْقِ بْنِ حَبِيبٍ ،  عَنْ  أَبِي عَقْرَبٍ الْأَسَدِيِّ ، قَالَ :  أَتَيْتُ عَبْدَ اللهِ بْنَ مَسْعُودٍ وَهُوَ عَلَى  إِجَّارٍ  فَقَعَدْتُ عَلَيْهِ وَهُوَ يَقُولُ : صَدَقَ اللهُ وَرَسُولُهُ ، صَدَقَ اللهُ وَرَسُولُهُ ، قَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَبَّأَنَا أَنَّ لَيْلَةَ الْقَدْرِ فِي النِّصْفِ مِنَ السَّبْعِ الْأَوَاخِرِ  ، وَإِنَّ الشَّمْسَ تَطْلُعُ صَبِيحَتَهَا لَيْسَ لَهَا شُعَاعٌ ، فَصَعِدْتُ فَرَأَيْتُهَا كَذَلِكَ ، فَقُلْتُ : صَدَقَ اللهُ وَرَسُولُهُ  .         [9/252]             [9/253]","","Musnad Abi Ya'la al-Mawsili 5371","","عبد الله بن مسعود عن أبو عقرب الأسدي عن طلق بن حبيب العنزي عن أبو خالد الدالاني عن شجاع بن الوليد السكوني عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5375","406 - (  5372  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ الْقَاسِمِ بْنِ الْوَلِيدِ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  وَسَمِعَ  عَبْدُ اللهِ  بِخَسْفٍ ، فَقَالَ : كُنَّا أَصْحَابَ مُحَمَّدٍ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَعُدُّ الْآيَاتِ بَرَكَةً ، وَأَنْتُمْ تَعُدُّونَهَا تَخْوِيفًا ، إِنَّا بَيْنَمَا نَحْنُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَيْسَ مَعَنَا مَاءٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اطْلُبُوا مَنْ مَعَهُ مَاءٌ ، فَفَعَلْنَا ، فَأُتِيَ بِمَاءٍ ، فَصَبَّهُ فِي إِنَاءٍ  ، ثُمَّ وَضَعَ كَفَّهُ فِيهِ فَجَعَلَ الْمَاءُ يَخْرُجُ مِنْ بَيْنِ أَصَابِعِهِ ، ثُمَّ قَالَ : حَيَّ عَلَى الطَّهُورِ الْمُبَارَكِ ، وَالْبَرَكَةُ مِنَ اللهِ ، فَمَلَأْتُ بَطْنِي مِنْهُ ، وَاسْتَقَى وَأُسْقِيَ النَّاسُ ، قَالَ  عَبْدُ اللهِ  : كُنَّا نَسْمَعُ تَسْبِيحَ الطَّعَامِ وَهُوَ يُؤْكَلُ  .         [9/254]","","Musnad Abi Ya'la al-Mawsili 5372","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن إسرائيل بن يونس بن أبي إسحاق عن الوليد بن القاسم الخبذعي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5376","407 - (  5373  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ، بِهَذَا  الْإِسْنَادِ  نَحْوَهُ ، إِلَّا أَنَّهُ لَمْ يَذْكُرْ  عَلْقَمَةَ  .","","Musnad Abi Ya'la al-Mawsili 5373","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5377","408 - (  5374  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  شَيْبَانُ ،  حَدَّثَنَا  مَنْصُورٌ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَارٍ ، فَأُنْزِلَتْ عَلَيْهِ :         {      وَالْمُرْسَلاتِ عُرْفًا         }      فَجَعَلْنَا نَتَلَقَّاهَا مِنْهُ  ، فَخَرَجَتْ حَيَّةٌ مِنْ جَانِبِ الْغَارِ ، فَقَالَ : اقْتُلُوهَا ، فَبَادَرْنَاهَا ، فَسَبَقَتْنَا ، فَقَالَ : إِنَّهَا وُقِيَتْ شَرَّكُمْ كَمَا وُقِيتُمْ شَرَّهَا  .","","Musnad Abi Ya'la al-Mawsili 5374","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن شيبان بن عبد الرحمن المؤدب عن حجاج بن محمد الأعور عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5378","409 - (  5375  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  أَبِي رَزِينٍ ، قَالَ :         [9/255]      قَالَ  عَبْدُ اللهِ ،  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : اقْرَأْ عَلَيَّ سُورَةَ النِّسَاءِ  ، قَالَ : قُلْتُ : أَقْرَأُ عَلَيْكَ وَعَلَيْكَ أُنْزِلَ ؟ قَالَ : إِنِّي أُحِبُّ أَنْ أَسْمَعَهُ مِنْ غَيْرِي ، قَالَ : فَقَرَأْتُ عَلَيْهِ حَتَّى إِذَا بَلَغْتُ :         {      فَكَيْفَ إِذَا جِئْنَا مِنْ كُلِّ أُمَّةٍ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَى هَؤُلاءِ شَهِيدًا         }      فَاضَتْ عَيْنَاهُ  .","","Musnad Abi Ya'la al-Mawsili 5375","","عبد الله بن مسعود عن مسعود بن مالك الأسدي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5379","410 - (  5376  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  إِيَّاكُمْ وَهَذِهِ الشَّهَادَاتِ أَنْ يَقُولَ الرَّجُلُ : قُتِلَ فُلَانٌ  شَهِيدًا  ، وَإِنَّ الرَّجُلَ يُقَاتِلُ حَمِيَّةً  ، وَيُقَاتِلُ وَهُوَ جَرِيءُ الصَّدْرِ ، وَلَا يَدْرِي عَلَامَ يُقَاتِلُ ؟ وَيُقَاتِلُ عَلَى الدُّنْيَا ، وَسَأُحَدِّثُكُمْ عَنْ ذَلِكَ  ، إِنَّ رَسُولَ اللهِ بَعَثَ قَوْمًا سَرِيَّةً ، فَلَمْ يَلْبَثُوا إِلَّا يَسِيرًا حَتَّى قَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَحَمِدَ اللهَ ، وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  إِنَّ إِخْوَانَكُمْ لَقُوا الْعَدُوَّ فَاقْتَطَعُوهُمْ ، فَلَمْ يَتَفَلَّتْ مِنْهُمْ رَجُلٌ  ، وَإِنَّهُمْ لَقُوا رَبَّهُمْ فَقَالُوا : رَبَّنَا أَبْلِغْ قَوْمَنَا أَنَّا قَدْ رَضِينَا وَرُضِيَ عَنَّا ، وَإِنِّي رَسُولُهُمْ إِلَيْكُمْ : أَنْ قَدْ رَضُوا وَرُضِيَ عَنْهُمْ ، فَعَلَى مِثْلِ هَؤُلَاءِ فَاشْهَدُوا  .","","Musnad Abi Ya'la al-Mawsili 5376","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن عطاء بن السائب عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5380","411 - (  5377  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ         [9/256]      مُغِيرَةَ ،  عَنْ  أَصْحَابِهِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ، قَالَ :  كُنْتُ مَعَ  عَبْدِ اللهِ  بِمِنًى  ، فَلَمَّا صَلَّى  عُثْمَانُ  بِهَا أَرْبَعَ رَكَعَاتٍ ، قَالَ  عَبْدُ اللهِ  حِينَ فَرَغَ مِنْ صَلَاتِهِ :  قَدْ صَلَّيْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي هَذَا الْمَكَانِ رَكْعَتَيْنِ  ،  وَصَلَّى  أَبُو بَكْرٍ  رَكْعَتَيْنِ ،  وَصَلَّى  عُمَرُ  رَكْعَتَيْنِ ، قَالَ : فَأُرَاهُ قَدْ ذَكَرَ مَا كَانَ صَلَّى  عُثْمَانُ  رَكْعَتَيْنِ ، ثُمَّ قَالَ : صَلَّى الْيَوْمَ أَرْبَعًا ، قَالَ  الْأَسْوَدُ  : فَقُلْتُ لَهُ :  يَا أَبَا عَبْدِ الرَّحْمَنِ  ، أَلَا سَلَّمْتَ مِنَ الرَّكْعَتَيْنِ الْأُخْرَيَيْنِ وَصَلَّيْتَ الرَّكْعَتَيْنِ الْأُخْرَيَيْنِ بَعْدُ تَسْبِيحًا ؟ قَالَ : الْخِلَافُ شَرٌّ  .         [9/257]","","Musnad Abi Ya'la al-Mawsili 5377","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن أصحاب المغيرة بن مقسم الضبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5381","412 - (  5378  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  رَجُلٍ مِنْ قَوْمِهِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا  سَمَرَ  إِلَّا لِأَحَدِ رَجُلَيْنِ : مُصَلٍّ ، أَوْ مُسَافِرٍ  .         [9/258]","","Musnad Abi Ya'la al-Mawsili 5378","","عبد الله بن مسعود عن رجل من قوم خيثمة بن عبد الرحمن الجعفي عن خيثمة بن عبد الرحمن الجعفي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5382","413 - (  5379  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  حَدَّثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنِ  الْحَسَنِ بْنِ عَمْرٍو الْفُقَمِيِّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ الْمُؤْمِنُ  بِالطَّعَّانِ  ، وَلَا اللَّعَّانِ ، وَلَا الْفَاحِشِ ، وَلَا الْبَذِيءِ  .","","Musnad Abi Ya'la al-Mawsili 5379","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن محمد بن عبد الرحمن بن يزيد النخعي عن الحسن بن عمرو الفقيمي عن أبو بكر بن عياش عن أحمد بن عبد الله اليربوعي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5383","414 - (  5380  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَبُو الْجَوَّابِ الضَّبِّيُّ ،  حَدَّثَنَا  عَمَّارُ بْنُ رُزَيْقٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ كَانَ يَتَعَوَّذُ مِنَ الشَّيْطَانِ الرَّجِيمِ : مِنْ  هَمْزِهِ  وَنَفْثِهِ  وَنَفْخِهِ  ، قَالَ :  هَمْزُهُ  : الْمُوتَةُ ، وَنَفْثُهُ : السِّحْرُ ،  وَنَفْخُهُ  : الْكِبْرُ  .         [9/259]","","Musnad Abi Ya'la al-Mawsili 5380","","عبد الله بن مسعود عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن عمار بن رزيق الضبي عن أحوص بن جواب الضبي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5384","415 - (  5381  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَيُّوبُ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي قَتَادَةَ ،  عَنْ  أُسَيْرِ بْنِ جَابِرٍ ، قَالَ :  هَاجَتْ رِيحٌ سَوْدَاءُ  بِالْكُوفَةِ ،  فَجَاءَ رَجُلٌ لَيْسَ لَهُ  هِجِّيرَى  ، إِلَّا أَيَا عَبْدَ اللهِ بْنَ مَسْعُودٍ جَاءَتِ السَّاعَةُ ، وَكَانَ مُتَّكِئًا فَجَلَسَ ، فَقَالَ : إِنَّ السَّاعَةَ لَا تَقُومُ حَتَّى لَا يُقْسَمَ مِيرَاثٌ وَلَا يُفْرَحَ بِغَنِيمَةٍ ، وَقَالَ : عَدُوٌّ يَجْتَمِعُونَ لِأَهْلِ الْإِسْلَامِ ، وَيَجْمَعُ لَهُمْ أَهْلُ الْإِسْلَامِ ، وَنَحَّى بِيَدِهِ إِلَى  الشَّامِ  ، قُلْتُ :  الرُّومَ  تَعْنِي ؟ قَالَ : نَعَمْ ، قَالَ : وَتَكُونُ عِنْدَ ذَلِكُمُ الْقِتَالِ  رِدَّةٌ  شَدِيدَةٌ ، فَيَشْتَرِطُ لِلْمَوْتِ  شُرْطَةً  لَا تَرْجِعُ إِلَّا غَالِبَةً فَيَقْتَتِلُونَ حَتَّى يَحْجِزَ بَيْنَهُمُ اللَّيْلُ ، فَيَفِيءُ هَؤُلَاءِ وَهَؤُلَاءِ كُلٌّ غَيْرُ غَالِبٍ ، وَتَفْنَى الشُّرْطَةُ ، ثُمَّ يَشْتَرِطُ الْمُسْلِمُونَ  شُرْطَةً  لِلْمَوْتِ لَا تَرْجِعُ إِلَّا غَالِبَةً ، فَيَقْتَتِلُونَ حَتَّى يُمْسُوا : يَحْجِزُ بَيْنَهُمُ اللَّيْلُ ، فَيَفِيءُ هَؤُلَاءِ وَهَؤُلَاءِ كُلٌّ غَيْرُ غَالِبٍ وَتَفْنَى الشُّرْطَةُ ، ثُمَّ يَشْتَرِطُ الْمُسْلِمُونَ  شُرْطَةً  لِلْمَوْتِ لَا تَرْجِعُ إِلَّا غَالِبَةً ، فَيَقْتَتِلُونَ حَتَّى يُمْسُوا ، فَيَفِيءُ هَؤُلَاءِ وَهَؤُلَاءِ كُلٌّ غَيْرُ غَالِبٍ ، وَتَفْنَى الشُّرْطَةُ ، حَتَّى إِذَا كَانَ الْيَوْمُ الرَّابِعُ نَهَضَ إِلَيْهِمْ بَقِيَّةُ أَهْلِ الْإِسْلَامِ فَيَجْعَلُ اللهُ  الدَّبْرَةَ  عَلَيْهِمْ فَيُقْتَلُونَ مَقْتَلَةً - إِمَّا         [9/260]      قَالَ :  لَا يُرَى مِثْلُهَا ، أَوْ قَالَ : لَمْ يُرَ مِثْلُهَا  - حَتَّى إِنَّ الطَّائِرَ لَيَمُرُّ بِجِهَاتِهِمْ مَا  يُخَلِّفُهُمْ  حَتَّى يَخِرَّ مَيِّتًا ،  فَيَتَعَادُّ  بَنُو الْأَبِ كَانُوا مِائَةً فَلَا يَجِدُونَهُ بَقِيَ مِنْهُمْ إِلَّا الرَّجُلُ الْوَاحِدُ ، فَبِأَيِّ غَنِيمَةٍ يُفْرَحُ ، أَوْ أَيُّ مِيرَاثٍ يُقَاسَمُ ؟ فَبَيْنَمَا هُمْ كَذَلِكَ إِذْ سَمِعُوا بِنَاسٍ هُمْ أَكْثَرُ مِنْ ذَلِكَ : جَاءَهُمُ الصَّرِيخُ أَنَّ  الدَّجَّالَ  قَدْ خَلَفَ فِي ذَرَارِيِّهِمْ ، فَيَتْرُكُونَ مَا فِي أَيْدِيهِمْ وَيُقْبِلُونَ فَيَبْعَثُونَ عَشَرَةَ فَوَارِسَ طَلِيعَةً ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنِّي لَأَعْرِفُ أَسْمَاءَهُمْ ، وَأَسْمَاءَ آبَائِهِمْ ، وَأَلْوَانَ خُيُولِهِمْ  ، وَهُمْ  خَيْرُ فَوَارِسَ عَلَى ظَهْرِ الْأَرْضِ يَوْمَئِذٍ - أَوْ قَالَ : هُمْ خَيْرُ فَوَارِسَ عَلَى ظَهْرِ الْأَرْضِ يَوْمَئِذٍ  - .","","Musnad Abi Ya'la al-Mawsili 5381","","عبد الله بن مسعود عن يسير بن عمرو الكندي عن أبو قتادة العدوي عن حميد بن هلال العدوي عن أيوب السختياني عن إسماعيل ابن علية عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5385","416 - (  5382  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ مَسْعُودٍ ، يَقُولُ :  كُنَّا نَغْزُو مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيْسَ لَنَا نِسَاءٌ  ، فَقُلْنَا : يَا رَسُولَ اللهِ ، أَلَا نَسْتَخْصِي ؟ فَنَهَانَا عَنْ ذَلِكَ ، وَأَمَرَنَا أَنْ نَنْكِحَ الْمَرْأَةَ بِالثَّوْبِ ، ثُمَّ قَرَأَ  عَبْدُ اللهِ         [9/261]      :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا لا تُحَرِّمُوا طَيِّبَاتِ مَا أَحَلَّ اللهُ         }      .","","Musnad Abi Ya'la al-Mawsili 5382","","عبد الله بن مسعود عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن مروان بن معاوية الفزاري عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5386","417 - (  5383  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  حَدَّثَنَا  الْمَسْعُودِيُّ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،         [9/262]      عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ  ، قَالَ :  بَيْنَمَا رَجُلٌ فِي مَمْلَكَتِهِ تَذَكَّرَ فَعَلِمَ أَنَّ مَا هُوَ فِيهِ مُنْقَطِعٌ ، وَأَنَّهُ قَدْ شَغَلَهُ عَنْ عِبَادَةِ رَبِّهِ  ، فَانْسَابَ مِنْ قَصْرِهِ لَيْلًا حَتَّى صَارَ إِلَى مَمْلَكَةِ غَيْرِهِ ، فَأَتَى سَاحِلَ الْبَحْرِ فَجَعَلَ يَضْرِبُ اللَّبِنَ فَيَعِيشُ بِهِ وَيَعْبُدُ رَبَّهُ ، فَبَلَغَ الْمَلِكَ الَّذِي هُوَ فِي مَمْلَكَتِهِ عِبَادَتُهُ وَحَالُهُ ، فَأَرْسَلَ إِلَيْهِ ، فَأَبَى أَنْ يَأْتِيَهُ ، فَلَمَّا رَأَى ذَلِكَ رَكِبَ إِلَيْهِ ، فَلَمَّا رَآهُ الْعَابِدُ هَرَبَ مِنْهُ ، فَتَبِعَهُ عَلَى دَابَّتِهِ ، فَقَالَ : يَا  عَبْدَ اللهِ  : إِنَّهُ لَيْسَ عَلَيْكَ مِنِّي بَأْسٌ ، ثُمَّ نَزَلَ إِلَيْهِ فَسَأَلَهُ عَنْ أَمْرِهِ ، فَقَالَ : أَنَا فُلَانٌ صَاحِبُ مَمْلَكَةِ كَذَا وَكَذَا ، تَذَكَّرْتُ فَعَلِمْتُ أَنَّ مَا كُنْتُ فِيهِ مُنْقَطِعٌ ، وَأَنَّهُ قَدْ شَغَلَنِي عَنْ عِبَادَةِ رَبِّي ، قَالَ : فَمَا أَنْتَ بِأَحَقَّ بِمَا صَنَعْتَ مِنِّي ، ثُمَّ خَلَّى سَبِيلَ دَابَّتِهُ وَتَبِعَهُ ، فَكَانَا يَعْبُدَانِ اللهَ جَمِيعًا ، فَسَأَلَا اللهَ أَنْ يُمِيتَهُمَا جَمِيعًا ، فَمَاتَا جَمِيعًا فَدُفِنَا ، قَالَ  عَبْدُ اللهِ  : فَلَوْ كُنْتُ بِرُمَيْلَةِ  مِصْرَ  لَأَرَيْتُكُمْ قُبُورَهُمَا بِالنَّعْتِ الَّذِي نَعَتَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Musnad Abi Ya'la al-Mawsili 5383","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5387","418 - (  5384  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَخْبَرَنَا  شُعْبَةُ  عَنِ  السُّدِّيِّ  عَنْ  مُرَّةَ ،         [9/263]      عَنْ  عَبْدِ اللهِ -  قَالَ  شُعْبَةُ  :  رَفَعَهُ  ، وَأَنَا  لَا أَرْفَعُهُ  لَكَ  -  فِي قَوْلِ اللهِ         {      وَمَنْ يُرِدْ فِيهِ بِإِلْحَادٍ بِظُلْمٍ نُذِقْهُ مِنْ عَذَابٍ أَلِيمٍ         }      قَالَ :  لَوْ أَنَّ رَجُلًا هَمَّ فِيهِ  بِإِلْحَادٍ  وَهُوَ  بِعَدَنِ أَبْيَنَ  لَأَذَاقَهُ اللهُ تَعَالَى عَذَابًا أَلِيمًا  .         [9/264]","","Musnad Abi Ya'la al-Mawsili 5384","","عبد الله بن مسعود عن مرة بن شراحيل عن السدي الكبير عن شعبة بن الحجاج عن يزيد بن هارون عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5388","419 - (  5385  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  عَزْرَةُ بْنُ قَيْسٍ ، قَالَ :  حَدَّثَتْنِي  أُمُّ الْفَيْضِ ، قَالَتْ :  سَمِعْتُ  ابْنَ مَسْعُودٍ ، يَقُولُ : عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ قَالَ لَيْلَةَ عَرَفَةَ هَذِهِ الْعَشْرَ كَلِمَاتٍ أَلْفَ مَرَّةٍ ، لَمْ يَسْأَلِ اللهَ شَيْئًا إِلَّا أَعْطَاهُ إِلَّا قَطِيعَةَ رَحِمٍ أَوْ مَأْثَمًا  : سُبْحَانَ الَّذِي فِي السَّمَاءِ عَرْشُهُ ، سُبْحَانَ الَّذِي فِي الْأَرْضِ مَوْطِئُهُ ، سُبْحَانَ الَّذِي فِي الْبَحْرِ سَبِيلُهُ ، سُبْحَانَ الَّذِي فِي النَّارِ سُلْطَانُهُ ، سُبْحَانَ الَّذِي فِي الْجَنَّةِ رَحْمَتُهُ ، سُبْحَانَ الَّذِي فِي الْقُبُورِ قَضَاؤُهُ ، سُبْحَانَ الَّذِي فِي الْهَوَاءِ رُوحُهُ ، سُبْحَانَ الَّذِي رَفَعَ السَّمَاءَ ، سُبْحَانَ الَّذِي وَضَعَ الْأَرْضَ ، سُبْحَانَ الَّذِي لَا مَنْجَا مِنْهُ إِلَّا إِلَيْهِ  .         [9/265]","","Musnad Abi Ya'la al-Mawsili 5385","","عبد الله بن مسعود عن أم الفيض عن عزرة بن قيس اليحمدي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5389","420 - (  5386  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  أَحْوَصُ بْنُ جَوَّابٍ ،  حَدَّثَنَا  عَمَّارُ بْنُ رُزَيْقٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  حَدَّثَنَا  عَبْدُ اللهِ ، وَنَحْنُ فِي بَيْتِ الْمَالِ ، قَالَ :  خَرَجَ إِلَيْنَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَحْنُ  بِمِنًى  ، فَأَسْنَدَ ظَهْرَهُ إِلَى  قُبَّةٍ  حَمْرَاءَ ، ثُمَّ أَخَذَ يُحَدِّثُنَا ، فَقَالَ :  إِنَّهُ لَنْ يَدْخُلَ الْجَنَّةَ إِلَّا نَفْسٌ مُسْلِمَةٌ  ، ثَلَاثَ مَرَّاتٍ ، ثُمَّ قَالَ : أَمَا تَرْضَوْنَ أَنْ تَكُونُوا رُبُعَ أَهْلِ الْجَنَّةِ ؟ قَالُوا : نَعَمْ ، قَالَ : أَمَا تَرْضَوْنَ أَنْ تَكُونُوا ثُلُثَ أَهْلِ الْجَنَّةِ ؟ قَالُوا : نَعَمْ ، قَالَ : فَوَالَّذِي نَفْسِي بِيَدِهِ إِنِّي لَأَرْجُو أَنْ تَكُونُوا نِصْفَ أَهْلِ الْجَنَّةِ ، وَسَأُنَبِّئُكُمْ عَنْ ذَلِكَ ، إِنَّمَا مَثَلُ الْمُؤْمِنِينَ فِيمَنْ سِوَاهُمْ مَثَلُ الشَّعَرَةِ الْبَيْضَاءِ فِي الثَّوْرِ الْأَسْوَدِ ، أَوِ السَّوْدَاءِ فِي الثَّوْرِ الْأَبْيَضِ  .","","Musnad Abi Ya'la al-Mawsili 5386","","عبد الله بن مسعود عن عمرو بن ميمون الأودي عن أبو إسحاق السبيعي عن عمار بن رزيق الضبي عن أحوص بن جواب الضبي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5390","421 - (  5387  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبِيدَةَ السَّلْمَانِيِّ ،  عَنْ  عَبْدِ اللهِ ،  أَنَّهُ جَاءَ  حَبْرٌ مِنَ الْيَهُودِ  إِلَى رَسُولِ         [9/266]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : إِنَّهُ  إِذَا كَانَ يَوْمُ الْقِيَامَةِ جَعَلَ اللهُ السَّمَاوَاتِ عَلَى إِصْبَعٍ ، وَالْأَرَضِينَ عَلَى إِصْبَعٍ ، وَالْجِبَالَ وَالشَّجَرَ عَلَى إِصْبَعٍ  ، وَالْمَاءَ  وَالثَّرَى  عَلَى إِصْبَعٍ ، وَالْخَلَائِقَ كُلَّهَا عَلَى إِصْبَعٍ ، ثُمَّ يَهُزُّهُنَّ ، ثُمَّ يَقُولُ : أَنَا الْمَلِكُ ، أَنَا الْمَلِكُ ، فَلَقَدْ رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ضَحِكَ حَتَّى بَدَتْ  نَوَاجِذُهُ  تَعَجُّبًا لِمَا قَالَ ، تَصْدِيقًا لَهُ ، ثُمَّ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :         {      وَمَا قَدَرُوا اللهَ حَقَّ قَدْرِهِ         }      إِلَى قَوْلِهِ :         {      عَمَّا يُشْرِكُونَ         }      .","","Musnad Abi Ya'la al-Mawsili 5387","","عبد الله بن مسعود عن عبيدة بن عمرو السلماني عن إبراهيم النخعي عن منصور بن المعتمر عن جرير بن عبد الحميد عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5391","422 - (  5388  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  حُسَيْنُ بْنُ مُحَمَّدٍ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنِ  الْوَلِيدِ بْنِ أَبِي هِشَامٍ ،  عَنْ  زَيْدِ بْنِ زَائِدٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِأَصْحَابِهِ :  لَا يُبَلِّغُنِي أَحَدٌ مِنْ أَصْحَابِي شَيْئًا  ، فَإِنِّي أُحِبُّ أَنْ أَخْرُجَ إِلَيْكُمْ وَأَنَا سَلِيمُ الصَّدْرِ  .         [9/267]","","Musnad Abi Ya'la al-Mawsili 5388","","عبد الله بن مسعود عن زيد بن زائدة عن الوليد بن هشام الهمداني عن إسرائيل بن يونس بن أبي إسحاق عن الحسين بن محمد بن بهرام المروذي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5392","423 - (  5389  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ، وَالْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي لَقِيتُ امْرَأَةً فِي الْبُسْتَانِ ، فَضَمَمْتُهَا إِلَيَّ  فَبَاشَرْتُهَا  وَقَبَّلْتُهَا وَفَعَلْتُ بِهَا كُلَّ شَيْءٍ ، غَيْرَ أَنِّي لَمْ أُجَامِعْهَا ، قَالَ : فَسَكَتَ عَنْهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَنَزَلَتْ هَذِهِ الْآيَةُ :         {      إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ         }      ، قَالَ : فَدَعَاهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَرَأَهَا عَلَيْهِ ، وَقَالَ لَهُ  عُمَرُ  :  يَا رَسُولَ اللهِ ، أَلَهُ خَاصَّةً أَمْ لِلنَّاسِ كَافَّةً ؟ قَالَ : لَا ، بَلْ لِلنَّاسِ كَافَّةً  .","","Musnad Abi Ya'la al-Mawsili 5389","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5393","424 - (  5390  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  الْأَعْمَشُ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،         [9/268]      عَنْ  عَبْدِ اللهِ ، قَالَ :  كُنْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حَرْثٍ  بِالْمَدِينَةِ  ، وَهُوَ مُتَّكِئٌ عَلَى  عَسِيبٍ  لَهُ  ، فَانْتَهَى إِلَى قَوْمٍ مِنَ الْيَهُودِ ، فَقَالَ بَعْضُهُمْ : لَا تَسْأَلُوهُ ، فَسَأَلُوهُ ، فَاتَّكَأَ عَلَى الْعَسِيبِ كَأَنَّهُ يُوحَى إِلَيْهِ ، فَقَالَ :         {      وَيَسْأَلُونَكَ عَنِ الرُّوحِ قُلِ الرُّوحُ مِنْ أَمْرِ رَبِّي وَمَا أُوتِيتُمْ مِنَ الْعِلْمِ إِلا قَلِيلا         }      .         [9/269]","","Musnad Abi Ya'la al-Mawsili 5390","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن وكيع بن الجراح عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5394","425 - (  5391  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ،  حَدَّثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  لَمَّا نَزَلَتْ :         {      لَيْسَ عَلَى الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جُنَاحٌ         }      الْآيَةَ  ، قَالَ رَسُولُ         [9/270]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : قِيلَ لِي : أَنْتَ مِنْهُمْ  .","","Musnad Abi Ya'la al-Mawsili 5391","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن علي بن مسهر القرشي عن سويد بن سعيد الحدثاني عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5395","426 - (  5392  ) -  حَدَّثَنَا  سُوَيْدُ بْنُ سَعِيدٍ ، وَعَبْدُ الْغَفَّارِ ، بِمِثْلِهِ .","","Musnad Abi Ya'la al-Mawsili 5392","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن الأعمش عن علي بن مسهر القرشي عن سويد بن سعيد الحدثاني عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5396","427 - (  5393  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  حَدَّثَنَا  الْمَسْعُودِيُّ ،  عَنْ  سَعِيدِ بْنِ عَمْرِو بْنِ جَعْدَةَ ،  عَنْ  أَبِي عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  سُئِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ لَيْلَةِ الْقَدْرِ ، فَقَالَ : أَيُّكُمْ يَذْكُرُ لَيْلَةَ الصَّهْبَاوَاتِ  ؟ قَالَ : فَقَالَ  عَبْدُ اللهِ  : أَنَا بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ ، وَبِيَدِي تُمَيْرَاتٌ أَتَسَحَّرُ بِهِنَّ ، وَأَنَا مُسْتَتِرٌ مِنَ الْفَجْرِ ، حَتَّى طَلَعَ الْفَجْرُ ، وَذَلِكَ لَيْلَةَ سَبْعٍ وَعِشْرِينَ إِنْ شَاءَ اللهُ  .         [9/271]","","Musnad Abi Ya'la al-Mawsili 5393","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن سعيد ، ويقال عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن يحيى بن أبي بكير عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5397","428 - (  5394  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنَا  الْحَارِثُ بْنُ فُضَيْلٍ الْأَنْصَارِيُّ ثُمَّ الْخَطْمِيُّ ،  عَنْ  سُفْيَانَ بْنِ أَبِي الْعَوْجَاءِ ،  عَنْ  أَبِي شُرَيْحٍ الْخُزَاعِيِّ ، قَالَ :  كَسَفَتِ الشَّمْسُ فِي عَهْدِ  عُثْمَانَ بْنِ عَفَّانَ  ،  وَبِالْمَدِينَةِ  عَبْدُ اللهِ بْنُ مَسْعُودٍ ، قَالَ : فَخَرَجَ  عُثْمَانُ  ، فَصَلَّى بِالنَّاسِ تِلْكَ الصَّلَاةَ رَكْعَتَيْنِ وَسَجْدَتَيْنِ فِي رَكْعَةٍ ، ثُمَّ انْصَرَفَ  عُثْمَانُ  وَدَخَلَ دَارَهُ ، وَجَلَسَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ  إِلَى حُجْرَةِ  عَائِشَةَ  ، وَجَلَسْنَا إِلَيْهِ ،  فَقَالَ  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُنَا بِالصَّلَاةِ عِنْدَ كُسُوفِ الشَّمْسِ أَوِ الْقَمَرِ ، فَإِذَا رَأَيْتُمُوهُ قَدْ أَصَابَهَا  فَافْزَعُوا  إِلَى الصَّلَاةِ  ، فَإِنَّهَا إِنْ كَانَتِ الَّتِي تَحْذَرُونَ كَانَتْ وَأَنْتُمْ عَلَى غَيْرِ غَفْلَةٍ ، وَكُنْتُمْ قَدْ أَصَبْتُمْ خَيْرًا أَوِ اكْتَسَبْتُمُوهُ  .         [9/272]             [9/273]","","Musnad Abi Ya'la al-Mawsili 5394","","عبد الله بن مسعود عن أبو شريح الخزاعي عن سفيان بن أبي العوجاء السلمي عن الحارث بن فضيل الخطمي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5398","429 - (  5395  ) -  حَدَّثَنَا  أَبُو خَيْثَمَةَ ،  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  عِكْرِمَةَ ، قَالَ :  النَّبِيذُ وَضُوءٌ إِذَا لَمْ نَجِدْ غَيْرَهُ  ،         [9/274]      قَالَ  الْأَوْزَاعِيُّ  : إِذَا كَانَ مُسْكِرًا فَلَا يُتَوَضَّأُ بِهِ  .","","Musnad Abi Ya'la al-Mawsili 5395","","عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن زهير بن حرب عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5399","430 - (  5396  ) -  حَدَّثَنَا  دَاوُدُ بْنُ رُشَيْدٍ ،  حَدَّثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  عَلِيِّ بْنِ عَلِيٍّ ،  حَدَّثَنِي  يُونُسُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  جَاءَهُ  رَجُلٌ  ، فَقَالَ : أَسَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ فِي الْخَيْلِ شَيْئًا ؟ قَالَ : نَعَمْ ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، يَقُولُ :  الْخَيْلُ  مَعْقُودٌ  فِي نَوَاصِيهَا الْخَيْرُ إِلَى يَوْمِ الْقِيَامَةِ  ، اشْتَرُوا عَلَى اللهِ ، وَاسْتَقْرِضُوا عَلَى اللهِ ، قِيلَ : يَا رَسُولَ اللهِ ، كَيْفَ نَشْتَرِي عَلَى اللهِ ، وَنَسْتَقْرِضُ عَلَى اللهِ ؟ قَالَ : قُولُوا : أَقْرِضْنَا إِلَى مَقَاسِمِنَا ، وَبِعْنَا إِلَى أَنْ يَفْتَحَ اللهُ لَنَا ، لَا تَزَالُونَ بِخَيْرٍ مَا دَامَ  جِهَادُكُمْ  خَضِرًا ، وَسَيَكُونُ فِي آخِرِ الزَّمَانِ قَوْمٌ يَشُكُّونَ فِي  الْجِهَادِ  ، فَجَاهِدُوا فِي         [9/275]      زَمَانِهِمْ ، ثُمَّ اغْزُوا ، فَإِنَّ الْغَزْوَ يَوْمَئِذٍ أَخْضَرُ  .","","Musnad Abi Ya'la al-Mawsili 5396","","عبد الله بن مسعود عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن يونس بن يزيدالأيلي عن علي بن علي عن بقية بن الوليد عن داود بن رشيد الخوارزمي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
"5400","431 - (  5397  ) -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ أَبُو مُوسَى الْهَرَوِيُّ ،  حَدَّثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  حَدَّثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ النَّاسُ يَجْهَرُونَ بِالْقِرَاءَةِ خَلْفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ لَهُمْ رَسُولُ اللهِ :  خَلَطْتُمْ عَلَيَّ الْقُرْآنَ  .","","Musnad Abi Ya'la al-Mawsili 5397","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن النضر بن شميل عن إسحاق بن إبراهيم الهروي عن أبو يعلى الموصلي","مسند عبد الله بن مسعود"
