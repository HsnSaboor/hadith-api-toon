hadiths[33]{hadithnumber,text}:
"452","। খারিজা ইবনু হুযাফা (রাঃ) হতে বর্ণিত আছে"
"453","। আলী (রাঃ) হতে বর্ণিত আছে"
"454","। সুফিয়ান সাওরী ও অন্যান্যরা আবু ইসহাক হতে"
"456","। মাসরুক (রহঃ) হতে বর্ণিত আছে"
"459","। আয়িশাহ (রাঃ) হতে বর্ণিত আছে"
"460","। আলী (রাঃ) হতে বর্ণিত আছে"
"461","। আনাস ইবনু সীরীন (রহঃ) হতে বর্ণিত আছে"
"462","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"463","। আবদুল আযীয ইবনু জুরাইজ (রহঃ) হতে বর্ণিত আছে"
"464","। আবুল হাওরা (রহঃ) হতে বর্ণিত আছে"
"465","। আবু সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"466","। যাইদ ইবনু আসলাম (রহঃ) হতে বর্ণিত আছে"
"467","। ইবনু উমার (রাঃ) হতে বর্ণিত আছে"
"468","। আবু সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"469","। ইবনু উমার (রাঃ) হতে বর্ণিত আছে"
"470","। তলক ইবনু ‘আলী (রাঃ) হতে বর্ণিত আছে"
"471","। উম্মু সালামা (রাঃ) হতে বর্ণিত আছে"
"472","। সাঈদ ইবনু ইয়াসার (রহঃ) হতে বর্ণিত আছে"
"473","। আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে"
"474","। আবদুর রহমান ইবনু আবু লাইলা (রহঃ) হতে বর্ণিত আছে"
"475","। আবু দারদা ও আবু যার (রাঃ) হতে বর্ণিত আছে"
"476","। আবূ হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"477","। আবূ সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"478","আবদুল্লাহ ইবনুস সায়িব (রাঃ) হতে বর্ণিত আছে"
"479","আবদুল্লাহ ইবনু আবী আওফা (রাঃ) হতে বর্ণিত আছে"
"480","। জাবির ইবনু আবদুল্লাহ (রাঃ) হতে বর্ণিত আছে"
"481","। আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে"
"482","। আবু রাফি (রাঃ) হতে বর্ণিত আছে"
"483","। কাব ইবনু উজরা (রাঃ) হতে বর্ণিত আছে"
"484","। আবদুল্লাহ ইবনু মাসউদ (রাঃ) হতে বর্ণিত আছে"
"485","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"486","। উমার ইবনুল খাত্তাব (রাঃ) হতে বর্ণিত আছে"
"487","। আলা ইবনু আবদুর রহমান ইবনু ইয়াকুব (রহঃ) হতে পর্যায়ক্রমে তার পিতা ও দাদার সূত্রে বর্ণিত। তিনি (ইয়াকুব) বলেন"