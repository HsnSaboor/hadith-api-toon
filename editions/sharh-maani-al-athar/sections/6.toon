hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3001","3202  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ مِنْهَالٍ ، قَالَ :  ثَنَا  سُفْيَانُ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3202","","أبو هريرة الدوسي عن حميد بن عبد الرحمن القرشي عن الزهري عن سفيان بن عيينة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الحكم في من جامع أهله في رمضان متعمدا"
"3002","3203  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  ثَنَا  أَبِي  ، قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ رَاشِدٍ ،  يُحَدِّثُ عَنِ  الزُّهْرِيِّ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3203","","أبو هريرة الدوسي عن حميد بن عبد الرحمن القرشي عن الزهري عن النعمان بن راشد الجزري عن جرير بن حازم عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الحكم في من جامع أهله في رمضان متعمدا"
"3003","3204  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي حَفْصَةَ ،  عَنِ  ابْنِ شِهَابٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3204","","أبو هريرة الدوسي عن حميد بن عبد الرحمن القرشي عن الزهري عن محمد بن أبي حفصة البصري عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الحكم في من جامع أهله في رمضان متعمدا"
"3004","3205  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنِ  الزُّهْرِيِّ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ ، وَقَالَ : ( خَمْسَةَ عَشَرَ صَاعًا تَمْرًا ) وَلَمْ يَشُكَّ .","","Sharh Ma'ani al-Athar 3205","","أبو هريرة الدوسي عن حميد بن عبد الرحمن القرشي عن الزهري عن منصور بن المعتمر عن سفيان بن عيينة عن مؤمل بن إسماعيل العدوي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الحكم في من جامع أهله في رمضان متعمدا"
"3005","3206  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  بِشْرُ بْنُ بَكْرٍ ، قَالَ :  حَدَّثَنِي  الْأَوْزَاعِيُّ ، قَالَ :  سَأَلْتُ  الزُّهْرِيَّ عَنْ رَجُلٍ جَامَعَ امْرَأَتَهُ فِي شَهْرِ رَمَضَانَ .  فَقَالَ :  حَدَّثَنِي  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ :  حَدَّثَنِي  أَبُو هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، فَذَكَرَ نَحْوَهُ ، غَيْرَ أَنَّهُ لَمْ يَذْكُرِ الْآصُعَ .         [2/62]      فَكَانَ مَا رَوَيْنَا فِي هَذَا الْحَدِيثِ قَدْ دَخَلَ فِيهِ مَا فِي الْحَدِيثَيْنِ الْأَوَّلَيْنِ ؛ لِأَنَّ فِيهِ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ : أَتَجِدُ رَقَبَةً ؟ قَالَ : لَا ، قَالَ : فَصُمْ شَهْرَيْنِ مُتَتَابِعَيْنِ .  قَالَ : مَا أَسْتَطِيعُ ، قَالَ فَأَطْعِمْ سِتِّينَ مِسْكِينًا ؟ .  فَكَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا أَمَرَهُ بِكُلِّ صِنْفٍ مِنْ هَذِهِ الْأَصْنَافِ الثَّلَاثَةِ لِمَا لَمْ يَكُنْ وَاجِدًا لِلصِّنْفِ الَّذِي ذَكَرَهُ لَهُ قَبْلَهُ .  فَلَمَّا أَخْبَرَهُ الرَّجُلُ أَنَّهُ غَيْرُ قَادِرٍ عَلَى شَيْءٍ مِنْ ذَلِكَ أُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِعَرَقٍ  فِيهِ تَمْرٌ ، فَكَانَ ذِكْرُ الْعَرَقِ وَمَا كَانَ مِنْ دَفْعِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِيَّاهُ إِلَى الرَّجُلِ ، وَأَمْرِهِ إِيَّاهُ بِالصَّدَقَةِ - هُوَ الَّذِي رَوَتْهُ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا فِي حَدِيثِهَا الَّذِي بَدَأْنَا بِرِوَايَتِهِ .  فَحَدِيثُ  أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ هَذَا أَوْلَى مِنْهُ ؛ لِأَنَّهُ قَدْ كَانَ قَبْلَ الَّذِي فِي حَدِيثِ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا شَيْءٌ قَدْ حَفِظَهُ  أَبُو هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ ، وَلَمْ تَحْفَظْهُ  عَائِشَةُ  ، فَهُوَ أَوْلَى ، لِمَا قَدْ زَادَهُ .  وَأَمَّا حَدِيثُ  مَالِكٍ  وَابْنِ جُرَيْجٍ  ، فَهُمَا عَنِ  الزُّهْرِيِّ  ، عَلَى مَا قَدْ ذَكَرْنَا ، وَقَدْ بَيَّنَّا الْعِلَّةَ فِي ذَلِكَ فِيمَا تَقَدَّمَ مِنْ هَذَا الْبَابِ .  فَثَبَتَ بِمَا ذَكَرْنَا مِنَ الْكَفَّارَةِ فِي الْإِفْطَارِ بِالْجِمَاعِ فِي الصِّيَامِ ، فِي شَهْرِ رَمَضَانَ ، مَا فِي حَدِيثِ  مَنْصُورٍ  ،  وَابْنِ عُيَيْنَةَ  ، وَمَنْ وَافَقَهُمَا ، عَنِ  الزُّهْرِيِّ  ، عَنْ  حُمَيْدٍ  ، عَنْ  أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ قَوْلُ  أَبِي حَنِيفَةَ  ،  وَأَبِي يُوسُفَ  ،  وَمُحَمَّدٍ  ، رَحِمَهُمُ اللهُ تَعَالَى  .","","Sharh Ma'ani al-Athar 3206","","أبو هريرة الدوسي عن حميد بن عبد الرحمن القرشي عن الزهري عن أبو عمرو الأوزاعي عن بشر بن بكر التنيسي عن الربيع بن سليمان المرادي عن الطحاوي","باب الحكم في من جامع أهله في رمضان متعمدا"
"3006","5 - بَابُ الصِّيَامِ فِي السَّفَرِ  3208  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ الْحَسَنِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ الْأَنْصَارِيِّ رَضِيَ اللهُ عَنْهُمَا قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَرَأَى زِحَامًا ،  وَرَجُلًا  قَدْ ظُلِّلَ عَلَيْهِ ، فَسَأَلَ مَا هَذَا ؟  فَقَالُوا : صَائِمٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  أَنْ تَصُومُوا فِي السَّفَرِ  .","","Sharh Ma'ani al-Athar 3208","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن عمرو بن الحسن بن علي بن أبي طالب عن محمد بن عبد الرحمن بن سعد بن زرارة عن شعبة بن الحجاج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3007","3209  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  أَبُو الْوَلِيدِ ، قَالَ :  ثَنَا  شُعْبَةُ ، فَذَكَرَ  بِإِسْنَادِهِ  ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3209","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن عمرو بن الحسن بن علي بن أبي طالب عن محمد بن عبد الرحمن بن سعد بن زرارة عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصيام في السفر"
"3008","3210  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ مَيْمُونٍ الْبَغْدَادِيُّ ، قَالَ :  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، قَالَ :  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، قَالَ :  حَدَّثَنِي  جَابِرُ بْنُ عَبْدِ اللهِ قَالَ :  مَرَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِرَجُلٍ  فِي سَفَرٍ ، فِي ظِلِّ شَجَرَةٍ يُرَشُّ عَلَيْهِ الْمَاءُ ، فَقَالَ : مَا بَالُ هَذَا ؟  قَالُوا : صَائِمٌ يَا رَسُولَ اللهِ ، قَالَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  ، فَعَلَيْكُمْ بِرُخْصَةِ اللهِ الَّتِي رَخَّصَ لَكُمْ فَاقْبَلُوهَا  .","","Sharh Ma'ani al-Athar 3210","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن عبد الرحمن بن ثوبان القرشي عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن محمد بن عبد الله بن ميمون السكري عن الطحاوي","باب الصيام في السفر"
"3009","[2/63]      3211  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ الْأَبْرَشُ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Sharh Ma'ani al-Athar 3211","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن محمد بن حرب الأبرش عن محمد بن مصفى بن بهلول عن علان بن المغيرة عن الطحاوي","باب الصيام في السفر"
"3010","3212  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  ابْنُ شِهَابٍ ، أَنَّ صَفْوَانَ بْنَ عَبْدِ اللهِ بْنِ صَفْوَانَ  أَخْبَرَهُ  ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيْسَ مِنَ  الْبِرِّ  أَنْ تَصُومُوا فِي السَّفَرِ  .","","Sharh Ma'ani al-Athar 3212","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن ابن جريج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3011","3213  -  حَدَّثَنَا  عَلِيٌّ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي حَفْصَةَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Sharh Ma'ani al-Athar 3213","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن محمد بن أبي حفصة البصري عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3012","3214  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النُّعْمَانِ السَّقَطِيُّ ، قَالَ :  ثَنَا  الْحُمَيْدِيُّ ، قَالَ :  ثَنَا  سُفْيَانُ ، قَالَ :  سَمِعْتُ  الزُّهْرِيَّ يَقُولُ : (  أَخْبَرَنِي  صَفْوَانُ بْنُ عَبْدِ اللهِ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ ) .  قَالَ  سُفْيَانُ  : فَذُكِرَ لِي أَنَّ  الزُّهْرِيَّ  كَانَ يَقُولُ ، وَلَمْ أَسْمَعْ أَنَا مِنْهُ : ( لَيْسَ مِنْ أَمْ بِرِّ أَمْ صِيَامُ فِي أَمْ سَفَرِ ) .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى الْإِفْطَارِ فِي  شَهْرِ  رَمَضَانَ فِي السَّفَرِ ، وَزَعَمُوا أَنَّهُ أَفْضَلُ مِنَ الصِّيَامِ ، وَاحْتَجُّوا فِي ذَلِكَ بِهَذِهِ الْآثَارِ ، حَتَّى قَالَ بَعْضُهُمْ : إِنَّ مَنْ صَامَ فِي السَّفَرِ لَمْ يُجْزِهِ الصَّوْمُ ، وَعَلَيْهِ قَضَاؤُهُ فِي أَهْلِهِ ، وَرَوَوْهُ عَنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ  .","","Sharh Ma'ani al-Athar 3214","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن سفيان بن عيينة عن الحميدي عن محمد بن النعمان المقدسي عن الطحاوي","باب الصيام في السفر"
"3013","3215  -  حَدَّثَنَا  ابْنُ أَبِي عَقِيلٍ ، قَالَ :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَاصِمِ بْنِ عَبْدِ اللهِ بْنِ عَاصِمٍ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ  أَنَّ  عُمَرَ رَضِيَ اللهُ عَنْهُ أَمَرَ رَجُلًا صَامَ فِي السَّفَرِ أَنْ يُعِيدَ  ،  وَرَوَوْهُ عَنْ  أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ أَيْضًا .  كذا في طبعة عالم الكتب ، ولعل الصواب : ( عبيد الله )","","Sharh Ma'ani al-Athar 3215","","عمر بن الخطاب عن عبد الله بن عامر بن ربيعة العنزي عن عاصم بن عبيد الله بن عاصم بن عمر بن الخطاب عن سفيان بن عيينة عن عبد الغني بن رفاعة اللخمي عن الطحاوي","باب الصيام في السفر"
"3014","3216  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ النَّهْدِيُّ ، قَالَ :  ثَنَا  زُهَيْرٌ ، قَالَ :  ثَنَا  عَبْدُ الْكَرِيمِ الْجَزَرِيُّ ،  عَنْ  عَطَاءٍ ،  عَنِ  الْمُحَرَّرِ بْنِ أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُمَا قَالَ :  صُمْتُ رَمَضَانَ فِي السَّفَرِ ، فَأَمَرَنِي أَبُو هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ أَنْ أُعِيدَ الصِّيَامَ  فِي أَهْلِي  .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : إِنْ شَاءَ صَامَ ، وَإِنْ شَاءَ أَفْطَرَ ، وَلَمْ يُفَضِّلُوا فِي ذَلِكَ فِطْرًا عَلَى صَوْمٍ ، وَلَا صَوْمًا عَلَى فِطْرٍ .  وَكَانَ مِنَ الْحُجَّةِ لَهُمْ عَلَى أَهْلِ الْمَقَالَةِ الْأُولَى ، فِيمَا احْتَجُّوا بِهِ عَلَيْهِمْ ، فِي قَوْلِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ أَنَّهُ قَدْ يَحْتَمِلُ غَيْرَ مَا حَمَلُوهُ عَلَيْهِ .  يَحْتَمِلُ : ( لَيْسَ مِنَ  الْبِرِّ  الَّذِي هُوَ أَبَرُّ  الْبِرِّ  ، وَأَعْلَى مَرَاتِبِ  الْبِرِّ  ، الصَّوْمُ فِي السَّفَرِ ، وَإِنْ كَانَ الصَّوْمُ فِي السَّفَرِ بِرًّا إِلَّا أَنَّ غَيْرَهُ مِنَ  الْبِرِّ  ، أَبَرُّ مِنْهُ ) .  كَمَا قَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ الْمِسْكِينُ بِالطَّوَّافِ الَّذِي تَرُدُّهُ التَّمْرَةُ وَالتَّمْرَتَانِ  ، وَاللُّقْمَةُ وَاللُّقْمَتَانِ .         [2/64]      قَالُوا : فَمَنِ الْمِسْكِينُ يَا رَسُولَ اللهِ ؟ قَالَ : الَّذِي يَسْتَحْيِي أَنْ يَسْأَلَ ، وَلَا يَجِدُ مَا يُغْنِيهِ ، وَلَا يُفْطَنُ لَهُ فَيُعْطَى  .","","Sharh Ma'ani al-Athar 3216","","أبو هريرة الدوسي عن محرر بن أبي هريرة الدوسي عن عطاء بن أبي رباح عن عبد الكريم الاصطخري عن زهير بن معاوية بن حديج عن مالك بن إسماعيل النهدي عن فهد بن سليمان الدلال عن الطحاوي","باب الصيام في السفر"
"3015","3217  -  حَدَّثَنَا  بِذَلِكَ ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  أَبُو عُمَرَ الْحَوْضِيُّ ، قَالَ :  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنِ  الْهَجَرِيِّ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Sharh Ma'ani al-Athar 3217","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن خالد بن عبد الله الطحان عن حفص بن عمر الحوضى عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصيام في السفر"
"3016","3218  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  قَبِيصَةُ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  إِبْرَاهِيمَ الْهَجَرِيِّ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3218","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن إبراهيم بن مسلم الهجري عن سفيان الثوري عن قبيصة بن عقبة السوائي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3017","3219  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  أَبِي الْوَلِيدِ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ .","","Sharh Ma'ani al-Athar 3219","","أبو هريرة الدوسي عن أبو الوليد مولى عمرو بن خراش عن محمد بن عبد الرحمن بن المغيرة عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيام في السفر"
"3018","3220  -  حَدَّثَنَا  أَبُو أُمَيَّةَ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ عَيَّاشٍ ، قَالَ :  ثَنَا  ابْنُ ثَوْبَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْفَضْلِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3220","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن عبد الله بن الفضل بن العباس الهاشمي عن عبد الرحمن بن ثابت العنسي عن علي بن عياش الألهاني عن محمد بن إبراهيم بن مسلم السجستاني عن الطحاوي","باب الصيام في السفر"
"3019","3221  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  فَلَمْ يَكُنْ مَعْنَى قَوْلِهِ : لَيْسَ الْمِسْكِينُ بِالطَّوَّافِ عَلَى مَعْنَى إِخْرَاجِهِ إِيَّاهُ مِنْ أَسْبَابِ الْمَسْكَنَةِ كُلِّهَا ، وَلَكِنَّهُ أَرَادَ بِذَلِكَ : ( لَيْسَ الْمِسْكِينُ الْمُتَكَامِلَ الْمَسْكَنَةِ ، وَلَكِنَّ الْمِسْكِينَ الْمُتَكَامِلَ الْمَسْكَنَةِ ، الَّذِي لَا يَسْأَلُ النَّاسَ ، وَلَا يُعْرَفُ فَيُتَصَدَّقَ عَلَيْهِ ) .  فَكَذَلِكَ قَوْلُهُ : لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ لَيْسَ ذَلِكَ عَلَى إِخْرَاجِ الصَّوْمِ فِي السَّفَرِ مِنْ أَنْ يَكُونَ بِرًّا ، وَلَكِنَّهُ عَلَى مَعْنَى : ( لَيْسَ مِنَ  الْبِرِّ  الَّذِي هُوَ أَبَرُّ  الْبِرِّ ،  الصَّوْمُ فِي السَّفَرِ ) ؛ لِأَنَّهُ قَدْ يَكُونُ الْإِفْطَارُ هُنَاكَ أَبَرَّ مِنْهُ إِذَا كَانَ عَلَى التَّقَوِّي لِلِقَاءِ الْعَدُوِّ ، وَمَا أَشْبَهَ ذَلِكَ .  فَهَذَا مَعْنًى صَحِيحٌ ، وَهُوَ أَوْلَى مَا حُمِلَ عَلَيْهِ مَعْنَى هَذِهِ الْآثَارِ حَتَّى لَا تَتَضَادَّ هِيَ وَغَيْرُهَا ، مِمَّا قَدْ رُوِيَ فِي هَذَا الْبَابِ أَيْضًا  .  فَإِنَّهُ","","Sharh Ma'ani al-Athar 3221","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيام في السفر"
"3020","3222  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  مَالِكٌ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ إِلَى  مَكَّةَ  عَامَ الْفَتْحِ  فِي رَمَضَانَ ، فَصَامَ حَتَّى بَلَغَ  الْكَدِيدَ  ،  ثُمَّ أَفْطَرَ ، فَأَفْطَرَ النَّاسُ مَعَهُ ، وَكَانُوا يَأْخُذُونَ بِالْأَحْدَثِ فَالْأَحْدَثِ مِنْ أَمْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Sharh Ma'ani al-Athar 3222","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيام في السفر"
"3021","3223  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  مَالِكٌ وَابْنُ جُرَيْجٍ ، قَالَا :  أَنَا  ابْنُ شِهَابٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3223","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن ابن جريج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3022","3224  -  حَدَّثَنَا  عَلِيٌّ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  غَيْرَ أَنَّهُ قَالَ ( حَتَّى أَتَى عُسْفَانَ ) .","","Sharh Ma'ani al-Athar 3224","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن شعبة بن الحجاج عن روح بن عبادة القيسي عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب الصيام في السفر"
"3023","[2/65]      3225  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ ، قَالَ :  ثَنَا  شُعْبَةُ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3225","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن شعبة بن الحجاج عن أبو داود الطيالسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصيام في السفر"
"3024","3226  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو غَسَّانَ ، قَالَ :  ثَنَا  إِسْرَائِيلُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3226","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن إسرائيل بن يونس بن أبي إسحاق عن مالك بن إسماعيل النهدي عن فهد بن سليمان الدلال عن الطحاوي","باب الصيام في السفر"
"3025","3227  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَبُو زُرْعَةَ ، قَالَ :  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ، قَالَ :  ثَنَا  أَبُو الْأَسْوَدِ ،  عَنْ  عِكْرِمَةَ مَوْلَى ابْنِ عَبَّاسٍ ،  حَدَّثَهُ  ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ  عَامَ الْفَتْحِ  فِي رَمَضَانَ ، فَصَامَ حَتَّى بَلَغَ  الْكَدِيدَ  ، فَبَلَغَهُ أَنَّ النَّاسَ شَقَّ عَلَيْهِمُ الصِّيَامُ . فَدَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِقَدَحٍ مِنْ لَبَنٍ ، فَأَمْسَكَهُ فِي يَدِهِ ، حَتَّى رَآهُ النَّاسُ وَهُوَ عَلَى رَاحِلَتِهِ حَوْلَهُ ، ثُمَّ شَرِبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَفْطَرَ ، فَنَاوَلَهُ  رَجُلًا  إِلَى جَنْبِهِ فَشَرِبَ .  فَصَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي السَّفَرِ وَأَفْطَرَ .","","Sharh Ma'ani al-Athar 3227","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن محمد بن عبد الرحمن بن نوفل عن حيوة بن شريح التجيبي عن وهب الله بن راشد المؤذن عن الربيع بن سليمان المرادي عن الطحاوي","باب الصيام في السفر"
"3026","3228  -  حَدَّثَنَا  عَلِيٌّ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَافَرَ فِي رَمَضَانَ ، فَاشْتَدَّ الصَّوْمُ عَلَى رَجُلٍ مِنْ أَصْحَابِهِ  ، فَجَعَلَتْ رَاحِلَتُهُ تَهِيمُ بِهِ تَحْتَ الشَّجَرِ . فَأُخْبِرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِأَمْرِهِ ، فَدَعَا بِإِنَاءٍ ، فَلَمَّا رَآهُ النَّاسُ عَلَى يَدِهِ ، أَفْطَرُوا  .","","Sharh Ma'ani al-Athar 3228","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن حماد بن سلمة عن روح بن أسلم الباهلي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3027","3229  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ وَفَهْدٌ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  ثَنَا  ابْنُ الْهَادِ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  مَكَّةَ  عَامَ الْفَتْحِ  فِي رَمَضَانَ ، فَصَامَ  حَتَّى بَلَغَ  كُرَاعَ  الْغَمِيمِ  ، فَصَامَ النَّاسُ مَعَهُ .  فَبَلَغَهُ أَنَّ النَّاسَ قَدْ شَقَّ عَلَيْهِمُ الصِّيَامُ ، يَنْظُرُونَ فِيمَا فَعَلَ ، فَدَعَا بِقَدَحٍ مِنْ مَاءٍ بَعْدَ الْعَصْرِ ، فَشَرِبَ وَالنَّاسُ يَنْظُرُونَ .  فَبَلَغَهُ أَنَّ نَاسًا صَامُوا بَعْدُ ، فَقَالَ : أُولَئِكَ الْعُصَاةُ  .","","Sharh Ma'ani al-Athar 3229","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن عبد الله بن صالح المصري عن فهد بن سليمان الدلال عن الطحاوي","باب الصيام في السفر"
"3028","3230  -  حَدَّثَنَا  بَحْرُ بْنُ نَصْرٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  عَنْ  قَزَعَةَ ، قَالَ :  سَأَلْتُ  أَبَا سَعِيدٍ عَنْ صِيَامِ رَمَضَانَ فِي السَّفَرِ .  فَقَالَ : خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي رَمَضَانَ  عَامَ الْفَتْحِ  ، فَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُ وَنَصُومُ ، حَتَّى بَلَغَ مَنْزِلًا مِنَ الْمَنَازِلِ ، فَقَالَ :  إِنَّكُمْ قَدْ دَنَوْتُمْ مِنْ عَدُوِّكُمْ ، وَالْفِطْرُ أَقْوَى لَكُمْ  .         [2/66]      فَأَصْبَحْنَا ، مِنَّا الصَّائِمُ ، وَمِنَّا الْمُفْطِرُ ، ثُمَّ سِرْنَا فَنَزَلْنَا مَنْزِلًا ، فَقَالَ : "" إِنَّكُمْ تُصَبِّحُونَ عَدُوَّكُمْ ، وَالْفِطْرُ أَقْوَى لَكُمْ ؛ فَأَفْطِرُوا "" فَكَانَتْ عَزِيمَةً مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  ثُمَّ لَقَدْ رَأَيْتُنِي أَصُومُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَبْلَ ذَلِكَ وَبَعْدَ ذَلِكَ .","","Sharh Ma'ani al-Athar 3230","","أبو سعيد الخدري عن قزعة بن يحيى الحرشي عن ربيعة بن يزيد القصير عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن وهب المصري عن بحر بن نصر بن سابق الخولاني عن الطحاوي","باب الصيام في السفر"
"3029","3231  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  ابْنُ أَبِي مَرْيَمَ ، قَالَ :  أَنَا  يَحْيَى بْنُ أَيُّوبَ ، قَالَ :  حَدَّثَنِي  حُمَيْدٌ الطَّوِيلُ ، أَنَّ بَكْرَ بْنَ عَبْدِ اللهِ  حَدَّثَهُ  ، قَالَ :  سَمِعْتُ  أَنَسًا يَقُولُ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ فِي سَفَرٍ وَمَعَهُ أَصْحَابُهُ ، فَشَقَّ عَلَيْهِمُ الصَّوْمُ ، فَدَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِإِنَاءٍ ، فَشَرِبَ  وَهُوَ عَلَى رَاحِلَتِهِ ، وَالنَّاسُ يَنْظُرُونَ إِلَيْهِ  .","","Sharh Ma'ani al-Athar 3231","","أنس بن مالك عن بكر بن عبد الله المزني عن حميد الطويل عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن فهد بن سليمان الدلال عن الطحاوي","باب الصيام في السفر"
"3030","3232  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  الْقَعْنَبِيُّ ، قَالَ :  ثَنَا  مَالِكٌ ،  عَنْ  سُمَيٍّ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  رَجُلٍ مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْعَرْجِ فِي الْحَرِّ  ، وَهُوَ يَصُبُّ عَلَى رَأْسِهِ الْمَاءَ ، وَهُوَ صَائِمٌ مِنَ  الْعَطَشِ ، أَوْ مِنَ الْحَرِّ  .  ثُمَّ إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا بَلَغَ  الْكَدِيدَ  أَفْطَرَ .","","Sharh Ma'ani al-Athar 3232","","أحد الصحابة عن أبو بكر بن عبد الرحمن راهب قريش عن سمي المخزومي عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصيام في السفر"
"3031","3233  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  ثَنَا  عَطِيَّةُ بْنُ قَيْسٍ ،  عَنْ  قَزَعَةَ بْنِ يَحْيَى ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلَيْلَتَيْنِ مَضَتَا مِنْ رَمَضَانَ ، فَخَرَجْنَا صُوَّامًا حَتَّى بَلَغَ  الْكَدِيدَ  ، فَأَمَرَنَا بِالْإِفْطَارِ ، فَأَصْبَحْنَا ، وَمِنَّا الصَّائِمُ ، وَمِنَّا الْمُفْطِرُ .  فَلَمَّا بَلَغْنَا  مَرَّ  الظَّهْرَانِ  أَعْلَمَنَا بِلِقَاءِ الْعَدُوِّ ، وَأَمَرَنَا بِالْإِفْطَارِ .  قَالَ أَبُو جَعْفَرٍ :  فَفِي هَذِهِ الْآثَارِ ، إِثْبَاتُ جَوَازِ  الصَّوْمِ فِي السَّفَرِ  ، وَأَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا كَانَ تَرْكُهُ إِيَّاهُ إِبْقَاءً عَلَى أَصْحَابِهِ .  أَفَيَجُوزُ لِأَحَدٍ أَنْ يَقُولَ فِي ذَلِكَ الصَّوْمِ : إِنَّهُ لَمْ يَكُنْ بِرًّا ؟ لَا يَجُوزُ هَذَا ، وَلَكِنَّهُ بِرٌّ .  وَقَدْ يَكُونُ الْإِفْطَارُ أَبَرَّ مِنْهُ إِذَا كَانَ يُرَادُ بِهِ الْقُوَّةُ لِلِقَاءِ الْعَدُوِّ ، الَّذِي أَمَرَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْفِطْرِ مِنْ أَجْلِهِ .  وَلِهَذَا الْمَعْنَى قَالَ لَهُمُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاللهُ أَعْلَمُ - : ""  لَيْسَ مِنَ  الْبِرِّ  الصَّوْمُ فِي السَّفَرِ  "" عَلَى هَذَا الْمَعْنَى الَّذِي ذَكَرْنَا .  فَإِنْ قَالَ قَائِلٌ : إِنَّ فِطْرَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَمْرَهُ أَصْحَابَهُ بِذَلِكَ بَعْدَ صَوْمِهِ وَصَوْمِهِمُ الَّذِي لَمْ يَكُنْ يَنْهَاهُمْ عَنْهُ نَاسِخٌ لِحُكْمِ الصَّوْمِ فِي السَّفَرِ أَصْلًا .  قِيلَ لَهُ : وَمَا دَلِيلُكَ عَلَى مَا ذَكَرْتَ ؟ وَفِي حَدِيثِ  أَبِي سَعِيدٍ الْخُدْرِيِّ  - الَّذِي قَدْ ذَكَرْنَاهُ فِي الْفَصْلِ الَّذِي قَبْلَ هَذَا - أَنَّهُ كَانَ يَصُومُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي السَّفَرِ بَعْدَ ذَلِكَ ؟  فَدَلَّ هَذَا الْحَدِيثُ عَلَى أَنَّ الصَّوْمَ فِي السَّفَرِ بَعْدَ إِفْطَارِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَذْكُورِ فِي هَذِهِ الْآثَارِ مُبَاحٌ  .  وَقَدْ قَالَ  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا ، وَهُوَ أَحَدُ مَنْ رُوِيَ عَنْهُ فِي إِفْطَارِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا ذَكَرْنَا مَا .","","Sharh Ma'ani al-Athar 3233","","أبو سعيد الخدري عن قزعة بن يحيى الحرشي عن عطية بن قيس الكلابي عن سعيد بن عبد العزيز التنوخي عن أبو عاصم النبيل عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصيام في السفر"
"3032","حَدَّثَنَا  يُونُسُ ،         [2/67]      قَالَ :  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَبْدِ الْكَرِيمِ بْنِ مَالِكٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  (  إِنَّمَا أَرَادَ اللهُ عَزَّ وَجَلَّ بِالْفِطْرِ فِي السَّفَرِ التَّيْسِيرَ عَلَيْكُمْ  ، فَمَنْ يَسُرَ عَلَيْهِ الصِّيَامُ فَلْيَصُمْ ، وَمَنْ يَسُرَ عَلَيْهِ الْفِطْرُ فَلْيُفْطِرْ )  .","","Sharh Ma'ani al-Athar 3032","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الكريم الاصطخري عن عبيد الله بن عمرو بن أبي الوليد عن علي بن معبد العبدي عن يونس بن عبد الأعلى عن الطحاوي","باب الصيام في السفر"
"3033","3234  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  (  إِنْ شَاءَ صَامَ ، وَإِنْ شَاءَ أَفْطَرَ  )  .  فَهَذَا  ابْنُ عَبَّاسٍ  لَمْ يَجْعَلْ إِفْطَارَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي السَّفَرِ بَعْدَ صِيَامِهِ فِيهِ نَاسِخًا لِلصَّوْمِ فِي السَّفَرِ ، وَلَكِنَّهُ جَعَلَهُ عَلَى جِهَةِ التَّيْسِيرِ .  فَإِنْ قَالَ قَائِلٌ : فَمَا مَعْنَى قَوْلِ  ابْنِ عَبَّاسٍ  فِي حَدِيثِ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ  الَّذِي ذَكَرْتَهُ عَنْهُ فِي ذَلِكَ : ( وَكَانُوا يَأْخُذُونَ بِالْأَحْدَثِ فَالْأَحْدَثِ مِنْ أَمْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ) ؟  قِيلَ لَهُ : مَعْنَى ذَلِكَ - عِنْدَنَا ، وَاللهُ أَعْلَمُ - أَنَّهُمْ لَمْ يَكُونُوا عَلِمُوا قَبْلَ ذَلِكَ أَنَّ لِلْمُسَافِرِ أَنْ يُفْطِرَ فِي السَّفَرِ ، كَمَا لَيْسَ لَهُ أَنْ يُفْطِرَ فِي الْحَضَرِ .  وَكَانَ حُكْمُ الْحَضَرِ وَحُكْمُ السَّفَرِ فِي ذَلِكَ - عِنْدَهُمْ - سَوَاءً حَتَّى أَحْدَثَ لَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَلِكَ الْفِعْلَ الَّذِي أَبَاحَهُ لَهُمُ الْإِفْطَارَ فِي أَسْفَارِهِمْ ، فَأَخَذُوا بِذَلِكَ عَلَى أَنَّ لَهُمُ الْإِفْطَارَ عَلَى الْإِبَاحَةِ ، وَلَهُمْ تَرْكُ الْإِفْطَارِ .  فَهَذَا مَعْنَى حَدِيثِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا هَذَا ، وَيَدُلُّ عَلَى ذَلِكَ مَا قَدْ ذَكَرْنَاهُ عَنْهُ مِنْ قَوْلِهِ الَّذِي وَصَفْنَا ، وَقَدْ ذَكَرْنَا عَنْ  أَنَسِ بْنِ مَالِكٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ قَرِيبًا مِمَّا ذَكَرْنَاهُ عَنِ  ابْنِ عَبَّاسٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  ثُمَّ قَدْ رُوِيَ عَنْ  أَنَسٍ  مَا يَدُلُّ عَلَى أَنَّ مَعْنَى ذَلِكَ عِنْدَهُ ، مِثْلُ مَعْنَاهُ الَّذِي ذَكَرْنَاهُ عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا  .","","Sharh Ma'ani al-Athar 3234","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن شعبة بن الحجاج عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصيام في السفر"
"3034","3235  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ يُونُسَ ، قَالَ :  ثَنَا  أَبُو حُذَيْفَةَ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ - وَهُوَ الْأَحْوَلُ - قَالَ :  سَأَلْتُ  أَنَسَ بْنَ مَالِكٍ عَنْ صَوْمِ  شَهْرِ  رَمَضَانَ فِي السَّفَرِ ، فَقَالَ : (  الصَّوْمُ أَفْضَلُ  ) .","","Sharh Ma'ani al-Athar 3235","","أنس بن مالك عن عاصم بن سليمان الأحول عن سفيان الثوري عن موسى بن مسعود النهدي عن إبراهيم بن محمد بن يونس البصري عن الطحاوي","باب الصيام في السفر"
"3035","3236  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  (  إِنْ أَفْطَرْتَ فَرُخْصَةٌ  ، وَإِنْ صُمْتَ فَالصَّوْمُ أَفْضَلُ ) .","","Sharh Ma'ani al-Athar 3236","","أنس بن مالك عن عاصم بن سليمان الأحول عن الحسن بن صالح بن صالح بن حي عن الفضل بن دكين عن فهد بن سليمان الدلال عن الطحاوي","باب الصيام في السفر"
"3036","3237  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  سَمِعْتُ  عَاصِمًا  يُحَدِّثُ ، عَنْ  أَنَسٍ قَالَ : (  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  ، وَالصَّوْمُ أَفْضَلُ  )  .  وَكَانَ مِمَّا احْتَجَّ بِهِ أَيْضًا أَهْلُ الْمَقَالَةِ الْأُولَى فِي دَفْعِهِمُ الصَّوْمَ فِي السَّفَرِ ، مَا قَدْ ذَكَرْنَاهُ فِي غَيْرِ هَذَا الْمَوْضِعِ ، مِنْ قَوْلِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  إِنَّ اللهَ وَضَعَ عَنِ الْمُسَافِرِ الصِّيَامَ  "" .  قَالُوا : فَلَمَّا كَانَ الصِّيَامُ مَوْضُوعًا عَنْهُ ، كَانَ إِذَا صَامَهُ فَقَدْ صَامَهُ ، وَهُوَ غَيْرُ مَفْرُوضٍ عَلَيْهِ ، فَلَا يُجْزِيهِ .  فَكَانَ مِنَ الْحُجَّةِ لِلْآخَرِينَ عَلَيْهِمْ فِي ذَلِكَ أَنَّهُ قَدْ يَجُوزُ أَنْ يَكُونَ ذَلِكَ الصِّيَامُ الَّذِي وَضَعَهُ عَنْهُ ، هُوَ الصِّيَامَ الَّذِي لَا يَكُونُ لَهُ مِنْهُ بُدٌّ فِي تِلْكَ الْأَيَّامِ ، كَمَا لَا بُدَّ لِلْمُقِيمِ مِنْ ذَلِكَ ، وَفِي هَذَا الْحَدِيثِ مَا قَدْ دَلَّ عَلَى هَذَا الْمَعْنَى .  أَلَا تَرَاهُ يَقُولُ : "" وَعَنِ الْحَامِلِ وَالْمُرْضِعِ "" .         [2/68]      أَفَلَا تَرَى أَنَّ الْحَامِلَ وَالْمُرْضِعَ إِذَا صَامَتَا رَمَضَانَ أَنَّ ذَلِكَ يُجْزِيهِمَا ، أَوْ أَنَّهُمَا لَا تَكُونَانِ ، كَمَنْ صَامَ قَبْلَ وُجُوبِ الصَّوْمِ عَلَيْهِ ، بَلْ جَعَلَ مَا يَجِبُ الصَّوْمُ عَلَيْهِمَا بِدُخُولِ  الشَّهْرِ  ، فَجَعَلَ لَهُمَا تَأْخِيرَهُ لِلضَّرُورَةِ ، وَالْمُسَافِرُ فِي ذَلِكَ مِثْلُهُمَا .  وَهَذَا أَوْلَى مَا حُمِلَ عَلَيْهِ هَذَا الْأَثَرُ ، حَتَّى لَا يُضَادَّ غَيْرَهُ مِنَ الْآثَارِ الَّتِي قَدْ ذَكَرْنَاهَا فِي هَذَا الْبَابِ .  وَكَانَ مِنَ الْحُجَّةِ عَلَى أَهْلِ الْمَقَالَةِ الْأُولَى الَّتِي قَدْ ذَكَرْنَاهَا لِأَهْلِ الْمَقَالَةِ الثَّانِيَةِ ، الَّتِي وَصَفْنَاهَا - أَنَّا قَدْ رَأَيْنَاهُمْ كَانُوا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدَ أَنْ أَبَاحَ لَهُمُ الْإِفْطَارَ فِي السَّفَرِ يَصُومُونَ فِيهِ  .  فَمِمَّا رُوِيَ فِي ذَلِكَ ، مَا","","Sharh Ma'ani al-Athar 3237","","أنس بن مالك عن عاصم بن سليمان الأحول عن شعبة بن الحجاج عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصيام في السفر"
"3037","3238  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، وَرَبِيعٌ الْجِيزِيُّ ، وَصَالِحُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالُوا :  ثَنَا  الْقَعْنَبِيُّ ، قَالَ :  ثَنَا  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  عُثْمَانَ بْنِ حَيَّانَ الدِّمَشْقِيِّ ،  عَنْ  أُمِّ الدَّرْدَاءِ قَالَتْ :  قَالَ  أَبُو الدَّرْدَاءِ  :  لَقَدْ رَأَيْتُنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي بَعْضِ أَسْفَارِهِ فِي يَوْمٍ شَدِيدِ الْحَرِّ ، حَتَّى إِنَّ الرَّجُلَ لَيَضَعُ يَدَهُ عَلَى رَأْسِهِ  مِنْ شِدَّةِ الْحَرِّ ، وَمَا مِنَّا صَائِمٌ إِلَّا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَعَبْدُ اللهِ بْنُ رَوَاحَةَ  .","","Sharh Ma'ani al-Athar 3238","","أبو الدرداء عن هجيمة الأوصابية أم الدرداء الصغرى عن عثمان بن حيان بن معبد المري عن هشام بن سعد المخزومي عن عبد الله بن مسلمة القعنبي عن يزيد بن سنان القزاز عن الطحاوي","باب الصيام في السفر"
"3038","3239  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ يُونُسَ ، قَالَ :  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَمِنَّا الصَّائِمُ ، وَمِنَّا الْمُفْطِرُ  ، فَلَمْ يَكُنْ يَعِيبُ بَعْضُنَا عَلَى بَعْضٍ .","","Sharh Ma'ani al-Athar 3239","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن المنذر بن مالك العوقي عن عاصم بن سليمان الأحول عن أبو معاوية الضرير عن محمد بن عمرو السوسي عن الطحاوي","باب الصيام في السفر"
"3039","3240  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  سَمِعْتُ  قَتَادَةَ  يُحَدِّثُ ، عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ فَتْحِ مَكَّةَ  لِتِسْعَ عَشْرَةَ أَوْ لِسَبْعَ عَشْرَةَ  ، مِنْ رَمَضَانَ ، فَصَامَ صَائِمُونَ ، وَأَفْطَرَ مُفْطِرُونَ  ، فَلَمْ يَعِبْ هَؤُلَاءِ عَلَى هَؤُلَاءِ ، وَلَا هَؤُلَاءِ عَلَى هَؤُلَاءِ .","","Sharh Ma'ani al-Athar 3240","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن شعبة بن الحجاج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3040","3241  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ ، غَيْرَ أَنَّهُ قَالَ : لِاثْنَتَيْ عَشْرَةَ .","","Sharh Ma'ani al-Athar 3241","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3041","3242  -  حَدَّثَنَا  عَلِيٌّ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  هِشَامُ بْنُ أَبِي عَبْدِ اللهِ ،  عَنْ  قَتَادَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ ، غَيْرَ أَنَّهُ قَالَ : لِثَمَانِ عَشْرَةَ .","","Sharh Ma'ani al-Athar 3242","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن هشام الدستوائي عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3042","3243  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  هِشَامٌ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3243","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن هشام الدستوائي عن وهب بن جرير بن حازم عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصيام في السفر"
"3043","3244  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  هِشَامٌ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ ، غَيْرَ أَنَّهُ لَمْ يَذْكُرْ فَتْحَ  مَكَّةَ  .","","Sharh Ma'ani al-Athar 3244","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن هشام الدستوائي عن مسلم بن إبراهيم الشحام عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصيام في السفر"
"3044","3245  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ :  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عَاصِمٍ ،  عَنْ  مُوَرِّقٍ الْعِجْلِيِّ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ قَالَ :  خَرَجْنَا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَنَزَلْنَا فِي يَوْمٍ شَدِيدِ الْحَرِّ ، فَمِنَّا الصَّائِمُ ، وَمِنَّا الْمُفْطِرُ ، فَنَزَلْنَا فِي يَوْمٍ حَارٍّ ، وَأَكْثَرُنَا ظِلًّا صَاحِبُ الْكِسَاءِ ، وَمِنَّا مَنْ يَسْتُرُ الشَّمْسَ بِيَدِهِ ، فَسَقَطَ الصُّوَّامُ ، وَقَامَ الْمُفْطِرُونَ ، فَضَرَبُوا الْأَبْنِيَةَ ، وَسَقَوُا الرِّكَابَ .  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ذَهَبَ الْمُفْطِرُونَ بِالْأَجْرِ الْيَوْمَ  .","","Sharh Ma'ani al-Athar 3245","","أنس بن مالك عن مورق العجلي عن عاصم بن سليمان الأحول عن أبو معاوية الضرير عن محمد بن عمرو السوسي عن الطحاوي","باب الصيام في السفر"
"3045","3246  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  حُمَيْدٍ الطَّوِيلِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ قَالَ :  سَافَرْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي رَمَضَانَ ، فَلَمْ يَعِبِ الصَّائِمُ عَلَى الْمُفْطِرِ  ، وَلَا الْمُفْطِرُ عَلَى الصَّائِمِ .  فَدَلَّ مَا ذَكَرْنَا فِي هَذِهِ الْآثَارِ أَنَّ مَا كَانَ مِنْ إِفْطَارِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَمْرِهِ أَصْحَابَهُ بِذَلِكَ ، لَيْسَ عَلَى الْمَنْعِ مِنَ الصَّوْمِ فِي السَّفَرِ ، وَأَنَّهُ عَلَى الْإِبَاحَةِ لِلْإِفْطَارِ .         [2/69]      وَقَدْ رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ صَامَ فِي السَّفَرِ وَأَفْطَرَ  .","","Sharh Ma'ani al-Athar 3246","","أنس بن مالك عن حميد الطويل عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيام في السفر"
"3046","3247  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  عَبْدِ السَّلَامِ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنِ  ابْنِ مَسْعُودٍ رَضِيَ اللهُ عَنْهُ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَصُومُ فِي السَّفَرِ وَيُفْطِرُ  .","","Sharh Ma'ani al-Athar 3247","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن عبد السلام بن أبي الجنوب المدني عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3047","3248  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحَسَنُ بْنُ بِشْرٍ ، قَالَ :  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  عَنْ  مُغِيرَةَ بْنِ زِيَادٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  صَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي السَّفَرِ وَأَفْطَرَ  .  فَدَلَّ ذَلِكَ عَلَى أَنَّ لِلْمُسَافِرِ أَنْ يَصُومَ ، وَلَهُ أَنْ يُفْطِرَ .  وَقَدْ سَأَلَ  حَمْزَةُ الْأَسْلَمِيُّ  رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الصَّوْمِ فِي السَّفَرِ ، فَقَالَ لَهُ : إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .","","Sharh Ma'ani al-Athar 3248","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن المغيرة بن زياد البجلي عن المعافى بن عمران عن الحسن بن بشر الكاهلي عن فهد بن سليمان الدلال عن الطحاوي","باب الصيام في السفر"
"3048","3249  -  حَدَّثَنَا  بِذَلِكَ عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  سَعِيدٌ ، وَهِشَامُ بْنُ أَبِي عَبْدِ اللهِ ،  عَنْ  قَتَادَةَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ .","","Sharh Ma'ani al-Athar 3249","","حمزة بن عمرو بن عويمر الأسلمي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن قتادة بن دعامة عن هشام الدستوائي عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصيام في السفر"
"3049","3250  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  أَبُو بَكْرٍ الْحَنَفِيُّ ، قَالَ :  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ، قَالَ :  حَدَّثَنِي  عِمْرَانُ بْنُ أَبِي أَنَسٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3250","","حمزة بن عمرو بن عويمر الأسلمي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عمران بن أبي أنس العامري عن عبد الحميد بن جعفر الأوسي عن عبد الكبير بن عبد المجيد الحنفي عن يزيد بن سنان القزاز عن الطحاوي","باب الصيام في السفر"
"3050","3251  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّ  حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ  قَالَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَصُومُ فِي السَّفَرِ ؟ وَكَانَ كَثِيرَ الصِّيَامِ .  فَقَالَ لَهُ النَّبِيُّ :  إِنْ شِئْتَ فَصُمْ ، وَإِنْ شِئْتَ فَأَفْطِرْ  .  فَهَذَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ أَبَاحَ الصَّوْمَ فِي السَّفَرِ لِمَنْ شَاءَ ذَلِكَ ، وَالْفِطْرَ لِمَنْ شَاءَ ذَلِكَ .  فَثَبَتَ بِهَذَا وَبِمَا ذَكَرْنَاهُ قَبْلَهُ أَنَّ صَوْمَ رَمَضَانَ فِي السَّفَرِ جَائِزٌ .  وَذَهَبَ قَوْمٌ إِلَى أَنَّهُ لَا فَضْلَ لِمَنْ صَامَ رَمَضَانَ فِي السَّفَرِ ، عَلَى مَنْ أَفْطَرَ وَقَضَاهُ بَعْدَ ذَلِكَ .  وَقَالُوا : لَيْسَ أَحَدُهُمَا أَفْضَلَ مِنَ الْآخَرِ ، وَاحْتَجُّوا فِي ذَلِكَ بِتَخْيِيرِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حَمْزَةَ بْنَ عَمْرٍو  بَيْنَ الْإِفْطَارِ فِي السَّفَرِ وَالصَّوْمِ ، وَلَمْ يَأْمُرْهُ بِأَحَدِهِمَا دُونَ الْآخَرِ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : الصَّوْمُ فِي السَّفَرِ فِي  شَهْرِ  رَمَضَانَ أَفْضَلُ مِنَ الْإِفْطَارِ .         [2/70]      وَقَالُوا لِأَهْلِ الْمَقَالَةِ الَّتِي ذَكَرْنَا : ( لَيْسَ فِيمَا ذَكَرْتُمُوهُ مِنْ تَخْيِيرِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِحَمْزَةَ  ، بَيْنَ الصَّوْمِ فِي السَّفَرِ وَالْفِطْرِ ، دَلِيلٌ عَلَى أَنَّهُ لَيْسَ أَحَدُهُمَا أَفْضَلَ مِنَ الْآخَرِ ، وَلَكِنْ إِنَّمَا خَيَّرَهُ بِمَا لَهُ أَنْ يَفْعَلَهُ مِنَ الْإِفْطَارِ وَالصَّوْمِ ، وَقَدْ رَأَيْنَا شَهْرَ رَمَضَانَ يَجِبُ بِدُخُولِهِ الصَّوْمُ عَلَى الْمُسَافِرِينَ وَالْمُقِيمِينَ جَمِيعًا إِذَا كَانُوا مُكَلَّفِينَ ) .  فَلَمَّا كَانَ دُخُولُ رَمَضَانَ هُوَ الْمُوجِبَ لِلصِّيَامِ عَلَيْهِمْ جَمِيعًا ، كَانَ مَنْ عَجَّلَ مِنْهُمْ أَدَاءَ مَا وَجَبَ عَلَيْهِ أَفْضَلَ مِمَّنْ أَخَّرَهُ .  فَثَبَتَ بِمَا ذَكَرْنَا أَنَّ الصَّوْمَ فِي السَّفَرِ أَفْضَلُ مِنَ الْفِطْرِ ، وَهُوَ قَوْلُ  أَبِي حَنِيفَةَ  ،  وَأَبِي يُوسُفَ  ،  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ .  وَقَدْ رُوِيَ ذَلِكَ أَيْضًا عَنْ  أَنَسِ بْنِ مَالِكٍ  رَضِيَ اللهُ عَنْهُ ، وَعَنْ نَفَرٍ مِنَ التَّابِعِينَ  .","","Sharh Ma'ani al-Athar 3251","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيام في السفر"
"3051","3252  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَامِرٍ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  حَمَّادٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : (  الصَّوْمُ أَفْضَلُ  ، وَالْإِفْطَارُ رُخْصَةٌ  )  ،  يَعْنِي : فِي السَّفَرِ  .","","Sharh Ma'ani al-Athar 3252","","سعيد بن جبير الأسدي عن حماد بن أبي سليمان عن سفيان الثوري عن أبو عامر العقدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصيام في السفر"
"3052","3253  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ، وَسَعِيدِ بْنِ جُبَيْرٍ ، وَمُجَاهِدٍ (  أَنَّهُمْ قَالُوا فِي الصَّوْمِ فِي السَّفَرِ :  إِنْ شِئْتَ صُمْتَ ، وَإِنْ شِئْتَ أَفْطَرْتَ  ، وَالصَّوْمُ أَفْضَلُ  )  .","","Sharh Ma'ani al-Athar 3253","","إبراهيم النخعي عن حماد بن أبي سليمان عن شعبة بن الحجاج عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصيام في السفر"
"3053","3254  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  حَبِيبٌ ،  عَنْ  عَمْرِو بْنِ هَرِمٍ ، قَالَ :  سُئِلَ  جَابِرُ بْنُ زَيْدٍ عَنْ صِيَامِ رَمَضَانَ فِي السَّفَرِ .  فَقَالَ : (  يَصُومُ مَنْ شَاءَ إِذَا كَانَ يَسْتَطِيعُ ذَلِكَ  ، مَا لَمْ يَتَكَلَّفْ أَمْرًا يَشُقُّ عَلَيْهِ ، وَإِنَّمَا أَرَادَ اللهُ تَعَالَى بِالْإِفْطَارِ التَّيْسِيرَ عَلَى عِبَادِهِ )  .","","Sharh Ma'ani al-Athar 3254","","جابر بن زيد اليحمدي عن عمرو بن هرم الأزدي عن حبيب بن أبي حبيب الأنماطي عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصيام في السفر"
"3054","3255  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  بِشْرُ بْنُ بَكْرٍ ،  عَنِ  الْأَوْزَاعِيِّ قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ، قَالَ :  حَدَّثَنِي  الْقَاسِمُ بْنُ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا  أَنَّهَا كَانَتْ تَصُومُ فِي السَّفَرِ فِي الْحَرِّ  .  فَقُلْتُ : مَا حَمَلَهَا عَلَى ذَلِكَ ؟ فَقَالَ : إِنَّهَا كَانَتْ تُبَادِرُ  .  فَهَذِهِ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا كَانَتْ تَرَى الْمُبَادَرَةَ بِصَوْمِ رَمَضَانَ فِي السَّفَرِ أَفْضَلَ مِنْ تَأْخِيرِ ذَلِكَ إِلَى الْحَضَرِ  .  وَكَانَ أَيْضًا ، مِمَّا احْتَجَّ بِهِ مَنْ كَرِهَ الصَّوْمَ فِي السَّفَرِ ، مَا .","","Sharh Ma'ani al-Athar 3255","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن بشر بن بكر التنيسي عن يونس بن عبد الأعلى عن الطحاوي","باب الصيام في السفر"
"3055","3256  -  حَدَّثَنَا  يُونُسُ رَضِيَ اللهُ عَنْهُ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ . (  ح  ) .  3257  -  وَحَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  شُعَيْبُ بْنُ اللَّيْثِ ، قَالَا :  ثَنَا  اللَّيْثُ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  مَنْصُورٍ الْكَلْبِيِّ ،  أَنَّ  دِحْيَةَ بْنَ خَلِيفَةَ خَرَجَ مِنْ قَرْيَتِهِ  بِدِمَشْقَ ،  إِلَى قَدْرِ  قَرْيَةِ عُقْبَةَ  فِي رَمَضَانَ ، فَأَفْطَرَ وَمَعَهُ أُنَاسٌ ، وَكَرِهَ آخَرُونَ أَنْ يُفْطِرُوا .  فَلَمَّا رَجَعَ إِلَى قَرْيَتِهِ ، قَالَ : (  وَاللهِ لَقَدْ رَأَيْتُ الْيَوْمَ أَمْرًا ، مَا كُنْتُ أَظُنُّ أَنْ أَرَاهُ  : إِنَّ قَوْمًا رَغِبُوا عَنْ هَدْيِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابِهِ ) ، يَقُولُ ذَلِكَ لِلَّذِينَ صَامُوا ، ثُمَّ قَالَ : ( اللَّهُمَّ اقْبِضْنِي إِلَيْكَ ) .  فَكَانَ مِنَ الْحُجَّةِ لِلَّذِينَ اسْتَحَبُّوا الصَّوْمَ فِي السَّفَرِ فِي هَذَا الْحَدِيثِ ، أَنَّ  دِحْيَةَ  إِنَّمَا ذَمَّ مَنْ رَغِبَ عَنْ هَدْيِ         [2/71]      رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابِهِ ، فَمَنْ صَامَ فِي سَفَرِهِ كَذَلِكَ فَهُوَ مَذْمُومٌ ، وَمَنْ صَامَ فِي سَفَرِهِ غَيْرَ رَاغِبٍ عَنْ هَدْيِهِ ، بَلْ عَلَى التَّمَسُّكِ بِهَدْيِهِ فَهُوَ مَحْمُودٌ  .","","Sharh Ma'ani al-Athar 3256","","دحية بن خليفة الكلبي عن منصور بن سعيد بن الأصبغ الكلبي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن شعيب بن الليث المصري عن الربيع بن سليمان المرادي عن الطحاوي","باب الصيام في السفر"
"3056","3258  -  حَدَّثَنَا  رَبِيعٌ الْجِيزِيُّ ، قَالَ :  ثَنَا  أَبُو زُرْعَةَ ، قَالَ :  أَنَا  حَيْوَةُ ، قَالَ :  أَنَا  أَبُو الْأَسْوَدِ ،  أَنَّهُ سَمِعَ  عُرْوَةَ بْنَ الزُّبَيْرِ  يُحَدِّثُ ، عَنْ  أَبِي مُرَاوِحٍ الْأَسْلَمِيِّ ،  عَنْ  حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ ، صَاحِبِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ ، إِنِّي  أَسْرُدُ  الصِّيَامَ ، أَفَأَصُومُ فِي السَّفَرِ ؟  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا هِيَ رُخْصَةٌ مِنَ اللهِ عَزَّ وَجَلَّ لِلْعِبَادِ  ، مَنْ قَبِلَهَا فَحَسَنٌ جَمِيلٌ ، وَمَنْ تَرَكَهَا فَلَا جُنَاحَ عَلَيْهِ  .  قَالَ :  وَكَانَ  حَمْزَةُ  يَصُومُ  الدَّهْرَ فِي السَّفَرِ وَالْحَضَرِ ، وَكَانَ  أَبُو مُرَاوِحٍ  كَذَلِكَ ، وَكَانَ  عُرْوَةُ  كَذَلِكَ .  فَدَلَّ مَا ذَكَرْنَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّ الصَّوْمَ فِي السَّفَرِ أَفْضَلُ مِنَ الْإِفْطَارِ ، وَأَنَّ الْإِفْطَارَ إِنَّمَا هُوَ رُخْصَةٌ  .","","Sharh Ma'ani al-Athar 3258","","حمزة بن عمرو بن عويمر الأسلمي عن واقد بن أبي واقد الأسلمي عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن حيوة بن شريح التجيبي عن وهب الله بن راشد المؤذن عن الربيع بن سليمان الجيزي عن الطحاوي","باب الصيام في السفر"
"3057","3259  -  وَقَدْ  حَدَّثَنَا  رَبِيعٌ الْجِيزِيُّ ، قَالَ :  ثَنَا  أَبُو زُرْعَةَ ، قَالَ :  أَنَا  حَيْوَةُ ، قَالَ :  أَنَا  أَبُو الْأَسْوَدِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  أَنَّ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا كَانَتْ تَصُومُ الدَّهْرَ فِي السَّفَرِ وَالْحَضَرِ  .","","Sharh Ma'ani al-Athar 3259","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن حيوة بن شريح التجيبي عن وهب الله بن راشد المؤذن عن الربيع بن سليمان الجيزي عن الطحاوي","باب الصيام في السفر"
"3058","6 - بَابُ صَوْمِ يَوْمِ عَرَفَةَ  3260  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  بِشْرُ بْنُ بَكْرٍ . (  ح  ) .  وَحَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ . (  ح  ) .  3261  -  وَحَدَّثَنَا  بَكْرُ بْنُ إِدْرِيسَ ، وَصَالِحُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَا :  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، قَالُوا :  ثَنَا  مُوسَى بْنُ عُلَيٍّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُقْبَةَ  .  وَقَالَ  بَكْرٌ  وَصَالِحٌ  فِي حَدِيثِهِمَا : قَالَ :  سَمِعْتُ  أَبِي  يُحَدِّثُ ، عَنْ  عُقْبَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ أَيَّامَ الْأَضْحَى وَأَيَّامَ  التَّشْرِيقِ  ، وَيَوْمَ عَرَفَةَ ، يَوْمَ عِيدِ أَهْلِ الْإِسْلَامِ ، أَيَّامُ أَكْلٍ  وَشُرْبٍ  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى هَذَا الْحَدِيثِ ، فَكَرِهُوا بِهِ صَوْمَ يَوْمِ عَرَفَةَ ، وَجَعَلُوا صَوْمَهُ كَصَوْمِ يَوْمِ النَّحْرِ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : لَا بَأْسَ بِصَوْمِ يَوْمِ عَرَفَةَ .  وَكَانَ مِنَ الْحُجَّةِ لَهُمْ فِي ذَلِكَ أَنَّهُ قَدْ يَجُوزُ أَنْ يَكُونَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا أَرَادَ بِنَهْيِهِ عَنْ صَوْمِ يَوْمِ عَرَفَةَ بِالْمَوْقِفِ ؛ لِأَنَّهُ هُنَاكَ عِيدٌ ، وَلَيْسَ فِي غَيْرِهِ كَذَلِكَ ، وَقَدْ بَيَّنَ ذَلِكَ  أَبُو هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ  .","","Sharh Ma'ani al-Athar 3260","","عقبة بن عامر بن عبس الفرضي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن عبد الله بن يزيد القصير عن صالح بن عبد الرحمن المصري عن الطحاوي","باب صوم يوم عرفة"
"3059","3262  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِدْرِيسَ الْمَكِّيُّ ، وَابْنُ أَبِي دَاوُدَ ، قَالَا :  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ . (  ح  ) .         [2/72]      3263  -  وَحَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ ، قَالَا :  ثَنَا  حَوْشَبُ بْنُ عَقِيلٍ ،  عَنْ  مَهْدِيٍّ الْهَجَرِيِّ ،  عَنْ  عِكْرِمَةَ ، قَالَ : كُنَّا مَعَ أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، فِي بَيْتِهِ ،  فَحَدَّثَنَا  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ صِيَامِ يَوْمِ عَرَفَةَ بِعَرَفَةَ  .  فَأَخْبَرَ  أَبُو هُرَيْرَةَ  أَنَّ النَّهْيَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ صَوْمِ يَوْمِ عَرَفَةَ ، إِنَّمَا هُوَ بِعَرَفَةَ خَاصَّةً  .  فَاحْتَجَّ أَهْلُ الْمَقَالَةِ الْأُولَى لِقَوْلِهِمْ أَيْضًا ، بِمَا  :","","Sharh Ma'ani al-Athar 3262","","أبو هريرة الدوسي عن عكرمة مولى ابن عباس عن مهدي بن حرب الهجري عن حوشب الجرمي عن أبو داود الطيالسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب صوم يوم عرفة"
"3060","3264  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو حُذَيْفَةَ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  لَمْ يَصُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَا  أَبُو بَكْرٍ  ، وَلَا  عُمَرُ  ، وَلَا  عُثْمَانُ  ، وَلَا  عَلِيٌّ  رَضِيَ اللهُ عَنْهُمْ يَوْمَ عَرَفَةَ  .  قِيلَ لَهُمْ :  هَذَا أَيْضًا - عِنْدَنَا - عَلَى الصِّيَامِ يَوْمَ عَرَفَةَ بِالْمَوْقِفِ ، وَقَدْ بَيَّنَ ذَلِكَ  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا فِي غَيْرِ هَذَا الْحَدِيثِ  .","","Sharh Ma'ani al-Athar 3264","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن إسماعيل بن أمية الأموي عن سفيان الثوري عن موسى بن مسعود النهدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عرفة"
"3061","3265  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، وَأَبُو دَاوُدَ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي نَجِيحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  رَجُلٍ  أَنَّ  رَجُلًا سَأَلَ ابْنَ عُمَرَ عَنْ صَوْمِ يَوْمِ عَرَفَةَ بِالْمَوْقِفِ ، فَقَالَ :  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَصُمْهُ  ، وَمَعَ  أَبِي بَكْرٍ  رَضِيَ اللهُ عَنْهُ فَلَمْ يَصُمْهُ ، وَمَعَ  عُمَرَ  رَضِيَ اللهُ عَنْهُ فَلَمْ يَصُمْهُ ، وَمَعَ  عُثْمَانَ  رَضِيَ اللهُ عَنْهُ فَلَمْ يَصُمْهُ ، وَأَنَا لَا أَصُومُهُ ، وَلَا آمُرُكَ وَلَا أَنْهَاكَ ، فَإِنْ شِئْتَ فَلَا تَصُمْهُ .  فَبَيَّنَ هَذَا الْحَدِيثُ أَنَّ مَا رَوَى  نَافِعٌ  عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا هُوَ عَلَى الصَّوْمِ فِي الْمَوْقِفِ  .","","Sharh Ma'ani al-Athar 3265","","عبد الله بن عمر بن الخطاب عن رجل عن يسار الثقفي مولى الأخنس بن شريق عن عبد الله بن أبي نجيح عن شعبة بن الحجاج عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب صوم يوم عرفة"
"3062","3266  -  وَقَدْ رُوِيَ عَنِ  ابْنِ عُمَرَ  فِي الْأَمْرِ بِصَوْمِ يَوْمِ عَرَفَةَ ، مَا  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  سَهْلُ بْنُ بَكَّارٍ ، قَالَ :  ثَنَا  أَبُو عَوَانَةَ ، قَالَ :  ثَنَا  رَقَبَةُ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  سُئِلَ عَنْ صَوْمِ يَوْمِ الْجُمُعَةِ  ، وَيَوْمِ عَرَفَةَ ، فَأَمَرَ بِصِيَامِهِمَا .  وَقَدْ رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ثَوَابِ صَوْمِ يَوْمِ عَرَفَةَ مِنْ حَدِيثِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا ،  وَأَبِي قَتَادَةَ الْأَنْصَارِيِّ  ، مَا قَدْ :","","Sharh Ma'ani al-Athar 3266","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن رقبة بن مصقلة عن الوضاح بن عبد الله اليشكري عن سهل بن بكار الدارمي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب صوم يوم عرفة"
"3063","3267  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  سَمِعْتُ  غَيْلَانَ بْنَ جَرِيرٍ  يُحَدِّثُ ، عَنْ  عَبْدِ اللهِ بْنِ مَعْبَدٍ ،  عَنْ  أَبِي قَتَادَةَ الْأَنْصَارِيِّ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سُئِلَ عَنْ صَوْمِ يَوْمِ عَرَفَةَ ، فَقَالَ :  يُكَفِّرُ السَّنَةَ الْمَاضِيَةَ وَالْبَاقِيَةَ  .","","Sharh Ma'ani al-Athar 3267","","أبو قتادة الأنصاري فارس رسول الله عن عبد الله بن معبد الزماني عن غيلان بن جرير المعولي عن شعبة بن الحجاج عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب صوم يوم عرفة"
"3064","3268  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  أَبِي  ، قَالَ :  سَمِعْتُ  غَيْلَانَ بْنَ جَرِيرٍ  يُحَدِّثُ ، عَنْ  عَبْدِ اللهِ بْنِ مَعْبَدٍ الزِّمَّانِيِّ ،  عَنْ  أَبِي قَتَادَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي أَحْتَسِبُ عَلَى اللهِ فِي صِيَامِ يَوْمِ عَرَفَةَ أَنْ يُكَفِّرَ السَّنَةَ الَّتِي قَبْلَهُ  ، وَالسَّنَةَ الَّتِي بَعْدَهُ  .","","Sharh Ma'ani al-Athar 3268","","أبو قتادة الأنصاري فارس رسول الله عن عبد الله بن معبد الزماني عن غيلان بن جرير المعولي عن جرير بن حازم عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عرفة"
"3065","3269  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  يَحْيَى بْنُ مَعِينٍ ، قَالَ :  ثَنَا  الْمُعْتَمِرُ ، قَالَ :  قَرَأَ عَلَى  الْفُضَيْلِ ، قَالَ :  حَدَّثَنِي  أَبُو حَرِيزٍ ،  أَنَّهُ سَمِعَ  سَعِيدَ بْنَ جُبَيْرٍ يَقُولُ :  سَأَلَ رَجُلٌ ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا عَنْ صَوْمِ يَوْمِ عَرَفَةَ ،  قَالَ  :  كُنَّا وَنَحْنُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَعْدِلُهُ بِصَوْمِ سَنَةٍ  .  فَثَبَتَ بِهَذَا الْأَثَرِ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ التَّرْغِيبُ فِي صَوْمِ يَوْمِ عَرَفَةَ .         [2/73]      فَدَلَّ ذَلِكَ أَنَّ مَا كُرِهَ مِنْ صَوْمِهِ فِي الْآثَارِ الْأُوَلِ ، هُوَ لِلْعَارِضِ الَّذِي ذَكَرْنَا مِنَ الْوُقُوفِ بِعَرَفَةَ ؛ لِشِدَّةِ تَعَبِهِمْ ، وَهَذَا قَوْلُ  أَبِي حَنِيفَةَ  ،  وَأَبِي يُوسُفَ  ،  وَمُحَمَّدٍ  ، رَحِمَهُمُ اللهُ تَعَالَى  .","","Sharh Ma'ani al-Athar 3269","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن عبد الله بن الحسين السجستاني عن فضيل بن ميسرة عن معتمر بن سليمان عن يحيى بن معين عن علان بن المغيرة عن الطحاوي","باب صوم يوم عرفة"
"3066","7 - بَابُ صَوْمِ يَوْمِ عَاشُورَاءَ  3270  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْوَهْبِيُّ ، قَالَ :  ثَنَا  ابْنُ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  حَبِيبِ بْنِ هِنْدِ بْنِ أَسْمَاءَ ،  عَنْ  أَبِيهِ  قَالَ :  بَعَثَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى قَوْمِي مِنْ أَسْلَمَ ، فَقَالَ :  قُلْ لَهُمْ : فَلْيَصُومُوا يَوْمَ عَاشُورَاءَ  ، فَمَنْ وَجَدْتَ مِنْهُمْ قَدْ أَكَلَ مِنْ صَدْرِ يَوْمِهِ ، فَلْيَصُمْ آخِرَهُ .","","Sharh Ma'ani al-Athar 3270","","هند بن أسماء الأسلمي عن حبيب بن هند بن أسماء الأسلمي عن عبد الله بن أبي بكر بن محمد  ابن حزم عن محمد بن إسحاق عن أحمد بن خالد بن موسى الوهبي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب صوم يوم عاشوراء"
"3067","3271  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَلَمَةَ الْخُزَاعِيِّ - هُوَ أَبُو الْمِنْهَالِ -  عَنْ  عَمِّهِ  قَالَ :  غَدَوْنَا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَبِيحَةَ يَوْمِ عَاشُورَاءَ ، وَقَدْ تَغَدَّيْنَا ، فَقَالَ : "" أَصُمْتُمْ هَذَا الْيَوْمَ ؟ فَقُلْنَا : قَدْ تَغَدَّيْنَا ، قَالَ :  فَأَتِمُّوا بَقِيَّةَ يَوْمِكُمْ  .","","Sharh Ma'ani al-Athar 3271","","عم عبد الرحمن بن سلمة الخزاعي عن عبد الرحمن بن مسلمة الخزاعي عن قتادة بن دعامة عن شعبة بن الحجاج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب صوم يوم عاشوراء"
"3068","3272  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ، قَالَ :  سَمِعْتُ  أَبَا الْمِنْهَالِ ، يُحَدِّثُ  عَنْ  عَمِّهِ  ، وَكَانَ مِنْ  أَسْلَمَ  ،  أَنَّ أُنَاسًا أَتَوُا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوْ بَعْضَهُمْ يَوْمَ عَاشُورَاءَ ، فَقَالَ : "" أَصُمْتُمُ الْيَوْمَ ؟ "" فَقَالُوا : لَا ، وَقَدْ أَكَلْنَا ، فَقَالَ :  فَصُومُوا بَقِيَّةَ يَوْمِكُمْ  .  قَالَ أَبُو جَعْفَرٍ :  فَفِي هَذِهِ الْآثَارِ وُجُوبُ صَوْمِ يَوْمِ عَاشُورَاءَ ، وَفِي أَمْرِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِيَّاهُمْ بِصَوْمِهِ ، بَعْدَ مَا أَصْبَحُوا دَلِيلٌ عَلَى أَنَّ مَنْ كَانَ فِي يَوْمٍ عَلَيْهِ صَوْمُهُ بِعَيْنِهِ ؛ وَلَمْ يَكُنْ نَوَى صَوْمَهُ مِنَ اللَّيْلِ ؛ أَنَّهُ يُجْزِيهِ أَنْ يَنْوِيَ صَوْمَهُ بَعْدَ مَا أَصْبَحَ ؛ إِذَا كَانَ ذَلِكَ قَبْلَ الزَّوَالِ ، عَلَى مَا قَالَ أَهْلُ الْعِلْمِ فِي ذَلِكَ .  وَقَدْ رُوِيَ فِي صَوْمِ يَوْمِ عَاشُورَاءَ مَا زَادَ عَلَى مَا ذَكَرْنَا  .","","Sharh Ma'ani al-Athar 3272","","عم عبد الرحمن بن سلمة الخزاعي عن عبد الرحمن بن مسلمة الخزاعي عن قتادة بن دعامة عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن سليمان بن شعيب الكيساني عن الطحاوي","باب صوم يوم عاشوراء"
"3069","3273  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْحِمَّانِيُّ ، قَالَ :  ثَنَا  يُوسُفُ بْنُ يَزِيدَ ، قَالَ :  ثَنَا  خَالِدُ بْنُ ذَكْوَانَ ؛  عَنِ  الرُّبَيِّعِ بِنْتِ مُعَوِّذٍ ؛ قَالَ :  سَأَلْتُهَا عَنْ صَوْمِ يَوْمِ عَاشُورَاءَ .  فَقَالَتْ : بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْأَمْصَارِ :  مَنْ كَانَ أَصْبَحَ صَائِمًا فَلْيَقُمْ عَلَى صَوْمِهِ  ، وَمَنْ كَانَ أَصْبَحَ مُفْطِرًا فَلْيُتِمَّ آخِرَ يَوْمِهِ ، فَلَمْ نَزَلْ نَصُومُهُ بَعْدُ ، وَنُصَوِّمُهُ صِبْيَانَنَا وَهُمْ صِغَارٌ ، وَنَتَّخِذُ لَهُمُ اللُّعْبَةَ مِنَ  الْعِهْنِ  ؛ فَإِذَا سَأَلُونَا الطَّعَامَ أَعْطَيْنَاهُمُ اللُّعْبَةَ .         [2/74]      فَفِي هَذَا الْحَدِيثِ أَنَّهُمْ كَانُوا يَمْنَعُونَ صِبْيَانَهُمُ الطَّعَامَ ، وَيُصَوِّمُونَهُمْ يَوْمَ عَاشُورَاءَ .  وَهَذَا - عِنْدَنَا - غَيْرُ جَائِزٍ ؛ لِأَنَّ الصِّبْيَانَ غَيْرُ مُتَعَبَّدِينَ بِصِيَامٍ وَلَا بِصَلَاةٍ ، وَلَا بِغَيْرِ ذَلِكَ .  وَكَيْفَ يَكُونُونَ مُتَعَبَّدِينَ بِشَيْءٍ مِنْ ذَلِكَ ، وَقَدْ رَفَعَ اللهُ عَزَّ وَجَلَّ عَنْهُمُ الْقَلَمَ .  ؟","","Sharh Ma'ani al-Athar 3273","","الربيع بنت معوذ النجارية عن خالد بن ذكوان المدني عن يوسف بن يزيد البراء عن يحيى بن عبد الحميد عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب صوم يوم عاشوراء"
"3070","3274  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  سُلَيْمَانَ الْأَعْمَشِ ،  عَنْ  أَبِي ظِبْيَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ رَضِيَ اللهُ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  رُفِعَ الْقَلَمُ عَنْ ثَلَاثَةٍ  ، عَنِ الصَّبِيِّ حَتَّى يَكْبَرَ ، وَعَنِ النَّائِمِ حَتَّى يَسْتَيْقِظَ ، وَعَنِ الْمَجْنُونِ حَتَّى يُفِيقَ  .","","Sharh Ma'ani al-Athar 3274","","علي بن أبي طالب عن عبد الله بن عباس عن حصين بن جندب الجنبي عن الأعمش عن جرير بن حازم عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب صوم يوم عاشوراء"
"3071","3275  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عَفَّانُ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  وَقَدْ رُوِيَ فِي نَسْخِ صَوْمِ يَوْمِ عَاشُورَاءَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ آثَارٌ صَحِيحَةٌ  .","","Sharh Ma'ani al-Athar 3275","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن عفان بن مسلم الصفار عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3072","3276  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْوَهْبِيُّ ، قَالَ :  ثَنَا  الْمُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ، قَالَ :  دَخَلْتُ عَلَى ابْنِ مَسْعُودٍ يَوْمَ عَاشُورَاءَ ، وَعِنْدَهُ رُطَبٌ ، فَقَالَ : ( ادْنُهْ  ) ، فَقُلْتُ : إِنَّ هَذَا يَوْمَ عَاشُورَاءَ ، وَأَنَا صَائِمٌ ،  فَقَالَ  : ( إِنَّ هَذَا الْيَوْمَ أُمِرْنَا بِصِيَامِهِ قَبْلَ رَمَضَانَ ) .","","Sharh Ma'ani al-Athar 3276","","عبد الله بن مسعود عن شقيق بن سلمة عن إبراهيم بن عبد الرحمن السكسكي عن مبارك بن فضالة عن أحمد بن خالد بن موسى الوهبي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب صوم يوم عاشوراء"
"3073","3277  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  خَالِدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنْ  قَيْسِ بْنِ السَّكَنِ ،  عَنِ  ابْنِ مَسْعُودٍ ، قَالَ :  أَتَاهُ رَجُلٌ وَهُوَ يَأْكُلُ ، فَقَالَ لَهُ : هَلُمَّ ، فَقَالَ : إِنِّي صَائِمٌ ، فَقَالَ لَهُ  عَبْدُ اللهِ  : (  كُنَّا نَصُومُهُ ، ثُمَّ تُرِكَ )  يَعْنِي : يَوْمَ عَاشُورَاءَ  .","","Sharh Ma'ani al-Athar 3277","","عبد الله بن مسعود عن قيس بن السكن السوائى عن عمارة بن عمير التيمي عن سعيد بن مسروق الثوري عن سفيان الثوري عن خالد بن عبد الرحمن الخراساني عن سليمان بن شعيب الكيساني عن الطحاوي","باب صوم يوم عاشوراء"
"3074","3278  -  حَدَّثَنَا  نَصْرُ بْنُ مَرْزُوقٍ ، وَابْنُ أَبِي دَاوُدَ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  أَخْبَرَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  أَخْبَرَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ، أَنَّ عَائِشَةَ رَضِيَ اللهُ عَنْهَا  أَخْبَرَتْهُ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِصِيَامِ يَوْمِ عَاشُورَاءَ ، قَبْلَ أَنْ يُفْرَضَ رَمَضَانُ ، فَلَمَّا فُرِضَ رَمَضَانُ ، فَقَالَ :  مَنْ شَاءَ صَامَ عَاشُورَاءَ ، وَمَنْ شَاءَ أَفْطَرَ  .","","Sharh Ma'ani al-Athar 3278","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب صوم يوم عاشوراء"
"3075","3279  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ وَشُعَيْبٌ ، قَالَا :  ثَنَا  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ، أَنَّ عِرَاكًا  أَخْبَرَهُ  ، أَنَّ عُرْوَةَ  أَخْبَرَهُ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3279","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عراك بن مالك الغفاري عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب صوم يوم عاشوراء"
"3076","3280  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ ، قَالَ :  ثَنَا  شَيْبَانُ ،  عَنِ  الْأَشْعَثِ ،  عَنْ  جَعْفَرِ بْنِ أَبِي ثَوْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ رَضِيَ اللهُ عَنْهُ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْمُرُنَا بِصَوْمِ عَاشُورَاءَ وَيَحُثُّنَا عَلَيْهِ  وَيَتَعَاهَدُنَا عَلَيْهِ ، فَلَمَّا فُرِضَ رَمَضَانُ ، لَمْ يَأْمُرْنَا ، وَلَمْ يَنْهَنَا ، وَلَمْ يَتَعَاهَدْنَا عَلَيْهِ  .","","Sharh Ma'ani al-Athar 3280","","جابر بن سمرة السوائي عن جعفر بن أبي ثور السوائي عن أشعث بن أبي الشعثاء عن شيبان بن عبد الرحمن المؤدب عن أبو داود الطيالسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3077","3281  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  سَمِعْتُ  شُعْبَةَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنِ  الْقَاسِمِ بْنِ مُخَيْمِرَةَ ،         [2/75]      عَنْ  أَبِي عَمَّارٍ ،  عَنْ  قَيْسِ بْنِ سَعْدِ بْنِ عُبَادَةَ قَالَ : (  أُمِرْنَا بِصَوْمِ عَاشُورَاءَ قَبْلَ أَنْ يُفْرَضَ رَمَضَانُ  ، فَلَمَّا فُرِضَ رَمَضَانُ لَمْ نُؤْمَرْ ، وَلَمْ نُنْهَ عَنْهُ ، وَنَحْنُ نَفْعَلُهُ ) .","","Sharh Ma'ani al-Athar 3281","","قيس بن سعد بن عبادة عن عريب بن حميد الدهني عن القاسم بن مخيمرة عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن روح بن عبادة القيسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3078","3282  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  سَمِعْتُ  الْحَكَمَ ، قَالَ :  سَمِعْتُ  الْقَاسِمَ بْنَ مُخَيْمِرَةَ ،  عَنْ  عَمْرِو بْنِ شُرَحْبِيلَ ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3282","","قيس بن سعد بن عبادة عن عمرو بن شرحبيل الهمداني عن القاسم بن مخيمرة عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب صوم يوم عاشوراء"
"3079","3283  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ عَامِرٍ ،  عَنْ  شُعْبَةَ ،  عَنِ  الْحَكَمِ ،  عَنِ  الْقَاسِمِ بْنِ مُخَيْمِرَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَفِي هَذِهِ الْآثَارِ نَسْخُ وُجُوبِ صَوْمِ يَوْمِ عَاشُورَاءَ ، وَدَلِيلُ أَنَّ صَوْمَهُ قَدْ رُدَّ إِلَى التَّطَوُّعِ ، بَعْدَ أَنْ كَانَ فَرْضًا  .  وَقَدْ رُوِيَتْ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ آثَارٌ أُخَرُ ، فِيهَا دَلِيلٌ عَلَى أَنَّ صَوْمَهُ كَانَ اخْتِيَارًا ، لَا فَرْضًا  .  فَمِنْهَا مَا","","Sharh Ma'ani al-Athar 3283","","قيس بن سعد بن عبادة عن عمرو بن شرحبيل الهمداني عن القاسم بن مخيمرة عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن سعيد بن عامر الضبعي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3080","3284  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، وَعَلِيُّ بْنُ شَيْبَةَ ، قَالَا :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا أَنَّهُ قَالَ :  لَمَّا قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْمَدِينَةَ  ، وَجَدَ الْيَهُودَ يَصُومُونَ يَوْمَ عَاشُورَاءَ ، فَسَأَلَهُمْ ، فَقَالُوا : هَذَا الْيَوْمُ الَّذِي أَظْهَرَ اللهُ عَزَّ وَجَلَّ فِيهِ  مُوسَى  عَلَيْهِ السَّلَامُ عَلَى  فِرْعَوْنَ  .  فَقَالَ :  أَنْتُمْ أَوْلَى  بِمُوسَى  مِنْهُمْ ، فَصُومُوهُ  .  فَفِي هَذَا الْحَدِيثِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِنَّمَا صَامَهُ شُكْرًا لِلهِ عَزَّ وَجَلَّ فِي إِظْهَارِهِ  مُوسَى  عَلَى  فِرْعَوْنَ  ، فَذَلِكَ عَلَى الِاخْتِيَارِ ، لَا عَلَى الْفَرْضِ  .","","Sharh Ma'ani al-Athar 3284","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن شعبة بن الحجاج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب صوم يوم عاشوراء"
"3081","3285  -  وَقَدْ  حَدَّثَنَا  أَبُو بَكْرَةَ ، وَابْنُ مَرْزُوقٍ ، قَالَا :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي يَزِيدَ ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ :  مَا عَلِمْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَتَحَرَّى  صِيَامَ يَوْمٍ عَلَى غَيْرِهِ  ، إِلَّا هَذَا الْيَوْمَ ، يَوْمَ عَاشُورَاءَ ، أَوْ شَهْرَ رَمَضَانَ  .","","Sharh Ma'ani al-Athar 3285","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن ابن جريج عن روح بن عبادة القيسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3082","3286  -  حَدَّثَنَا  رَبِيعٌ الْجِيزِيُّ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْأَزْرَقِيُّ ، قَالَ :  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْوَرْدِ ، قَالَ :  سَمِعْتُ  ابْنَ أَبِي مُلَيْكَةَ يَقُولُ :  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ أَبِي يَزِيدَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَيْسَ لِيَوْمٍ فَضْلٌ عَلَى يَوْمٍ فِي الصِّيَامِ  ، إِلَّا شَهْرَ رَمَضَانَ ، وَيَوْمَ عَاشُورَاءَ  .","","Sharh Ma'ani al-Athar 3286","","عبد الله بن عباس عن عبيد الله بن أبي يزيد الكناني عن ابن أبي مليكة عن عبد الجبار بن الورد المخزومي عن أحمد بن محمد بن الوليد الغساني عن الربيع بن سليمان الجيزي عن الطحاوي","باب صوم يوم عاشوراء"
"3083","3287  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، وَابْنُ مَرْزُوقٍ ، قَالَا :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  حَاجِبُ بْنُ عُمَرَ قَالَ :  سَمِعْتُ  الْحَكَمَ بْنَ الْأَعْرَجِ ، يَقُولُ :  قُلْتُ  لِابْنِ عَبَّاسٍ : أَخْبِرْنِي عَنْ يَوْمِ عَاشُورَاءَ  .  قَالَ : عَنْ أَيِّ بَالِهِ تَسْأَلُ ؟ قُلْتُ : أَسْأَلُ عَنْ صِيَامِهِ ، أَيَّ يَوْمٍ أَصُومُ ؟ قَالَ : إِذَا أَصْبَحْتَ مِنْ تَاسِعَةٍ ، فَأَصْبِحْ صَائِمًا .  قُلْتُ : كَذَلِكَ كَانَ يَصُومُ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : نَعَمْ .  فَهَذَا  ابْنُ عَبَّاسٍ  قَدْ رُوِيَ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ كَانَ يَصُومُ يَوْمَ عَاشُورَاءَ .         [2/76]      وَقَدْ دَلَّ ذَلِكَ عَلَى صَوْمِهِ ذَلِكَ أَنَّهُ كَانَ اخْتِيَارًا لَا فَرْضًا ، مَا قَدْ رَوَاهُ  سَعِيدُ بْنُ جُبَيْرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  فِي إِخْبَارِهِ بِالْعِلَّةِ الَّتِي مِنْ أَجْلِهَا صَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَئِذٍ  .","","Sharh Ma'ani al-Athar 3287","","عبد الله بن عباس عن الحكم بن عبد الله بن إسحاق الأعرج عن حاجب بن عمر الثقفي عن روح بن عبادة القيسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3084","3288  -  وَقَدْ  حَدَّثَنَا  الْحَسَنُ بْنُ عَبْدِ اللهِ بْنِ مَنْصُورٍ ، قَالَ :  ثَنَا  الْهَيْثَمُ بْنُ جَمِيلٍ ، قَالَ :  ثَنَا  شَرِيكٌ ،  عَنْ  جَابِرٍ ،  عَنْ  سَعْدِ بْنِ عُبَيْدَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَصُومُ يَوْمَ عَاشُورَاءَ  .  فَقَدْ يَجُوزُ أَنْ يَكُونَ ذَلِكَ أَيْضًا مِنْ أَجْلِ الْمَعْنَى الَّذِي ذَكَرَهُ  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا  .","","Sharh Ma'ani al-Athar 3288","","علي بن أبي طالب عن عبد الله بن حبيب السلمي عن سعد بن عبيدة السلمي عن جابر الجعفي عن شريك بن عبد الله النخعي عن الهيثم بن جميل الأنطاكي عن الحسن بن عبد الله بن إبراهيم البالسي عن الطحاوي","باب صوم يوم عاشوراء"
"3085","3289  -  وَقَدْ  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو غَسَّانَ ، قَالَ :  ثَنَا  إِسْرَائِيلُ ،  عَنْ  ثُوَيْرٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ يَقُولُ :  هَذَا يَوْمُ عَاشُورَاءَ فَصُومُوهُ  ؛ فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَأْمُرُ بِصَوْمِهِ  .  فَقَدْ يَجُوزُ أَنْ يَكُونَ ذَلِكَ لِلْعِلَّةِ الَّتِي ذَكَرْنَاهَا أَيْضًا  .","","Sharh Ma'ani al-Athar 3289","","عبد الله بن الزبير عن ثوير بن أبي فاختة مولى أم هانئ عن إسرائيل بن يونس بن أبي إسحاق عن مالك بن إسماعيل النهدي عن فهد بن سليمان الدلال عن الطحاوي","باب صوم يوم عاشوراء"
"3086","3290  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  مُسْلِمٌ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ مَيْسَرَةَ الْوَاسِطِيُّ ، قَالَ :  ثَنَا  مَزِيدَةُ بْنُ جَابِرٍ ،  عَنْ  أُمِّهِ  ،  أَنَّ  عُثْمَانَ  اسْتَعْمَلَ أَبَا مُوسَى عَلَى  الْكُوفَةِ  ،  فَقَالَ  يَوْمَ عَاشُورَاءَ : (  صُومُوا هَذَا الْيَوْمَ ؛ فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَصُومُهُ  ) .  فَهَذَا الْحَدِيثُ يَحْتَمِلُ مَا فِي حَدِيثِ  ابْنِ عَبَّاسٍ  أَيْضًا  .","","Sharh Ma'ani al-Athar 3290","","أبو موسى الأشعري عن أم مزيدة بن جابر الهجري عن مزيدة بن جابر الهجري عن عبد الله بن ميسرة الحارثي عن مسلم بن إبراهيم الشحام عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب صوم يوم عاشوراء"
"3087","3291  -  حَدَّثَنَا  رَبِيعٌ الْجِيزِيُّ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  أَبُو عَوَانَةَ ،  عَنِ  الْحُرِّ بْنِ الصَّيَّاحِ ،  عَنْ  هُنَيْدَةَ بْنِ خَالِدٍ ،  عَنِ  امْرَأَتِهِ  ،  عَنْ  بَعْضِ أَزْوَاجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَصُومُ تِسْعَ ذِي الْحِجَّةِ  ، وَيَوْمَ عَاشُورَاءَ ، وَثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ  .  فَهَذَا أَيْضًا مِثْلُ الَّذِي قَبْلَهُ  .","","Sharh Ma'ani al-Athar 3291","","أحد الصحابة عن امرأة هنيدة بن خالد عن هنيدة بن خالد الخزاعي عن حر بن الصياح النخعي عن الوضاح بن عبد الله اليشكري عن أسد السنة عن الربيع بن سليمان الجيزي عن الطحاوي","باب صوم يوم عاشوراء"
"3088","3292  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحِمَّانِيُّ ، قَالَ :  ثَنَا  أَبُو أُسَامَةَ ، قَالَ :  ثَنَا  أَبُو عُمَيْسٍ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنْ  أَبِي مُوسَى ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَدْ كَانَ يَوْمُ عَاشُورَاءَ يَوْمًا يَصُومُهُ الْيَهُودُ  ، وَيَتَّخِذُونَهُ عِيدًا ، فَصُومُوهُ أَنْتُمْ  .  فَفِي هَذَا الْحَدِيثِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِصَوْمِهِ ؛ لِأَنَّ الْيَهُودَ كَانَتْ تَصُومُهُ .  وَقَدْ أَخْبَرَ  ابْنُ عَبَّاسٍ  فِي حَدِيثِهِ بِالْعِلَّةِ الَّتِي مِنْ أَجْلِهَا كَانَتِ الْيَهُودُ تَصُومُهُ ، أَنَّهَا عَلَى الشُّكْرِ مِنْهُمْ لِلهِ تَعَالَى فِي إِظْهَارِهِ  مُوسَى  عَلَى  فِرْعَوْنَ  ، وَأَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَيْضًا صَامَهُ كَذَلِكَ ، وَالصَّوْمُ لِلشُّكْرِ اخْتِيَارٌ ، لَا فَرْضٌ  .","","Sharh Ma'ani al-Athar 3292","","أبو موسى الأشعري عن طارق بن شهاب الأحمسي عن قيس بن مسلم الجدلي عن عتبة بن عبد الله بن عتبة المسعودي عن حماد بن أسامة القرشي عن يحيى بن عبد الحميد عن فهد بن سليمان الدلال عن الطحاوي","باب صوم يوم عاشوراء"
"3089","3293  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُمَرَ وَاللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ أَحَبَّ مِنْكُمْ أَنْ يَصُومَ يَوْمَ عَاشُورَاءَ فَلْيَصُمْهُ  ، وَمَنْ لَمْ يُحِبَّ فَلْيَدَعْهُ  .","","Sharh Ma'ani al-Athar 3293","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الليث بن سعد عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب صوم يوم عاشوراء"
"3090","3294  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْوَهْبِيُّ ، قَالَ :  ثَنَا  ابْنُ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي يَوْمِ عَاشُورَاءَ :  إِنَّ هَذَا يَوْمٌ كَانَتْ  قُرَيْشٌ  تَصُومُهُ فِي الْجَاهِلِيَّةِ  ، فَمَنْ شَاءَ أَنْ يَصُومَهُ فَلْيَصُمْهُ ، وَمَنْ شَاءَ أَنْ يَتْرُكَهُ فَلْيَتْرُكْهُ "" .","","Sharh Ma'ani al-Athar 3294","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن إسحاق عن أحمد بن خالد بن موسى الوهبي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب صوم يوم عاشوراء"
"3091","[2/77]      3295  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  سَمِعْتُ  غَيْلَانَ بْنَ جَرِيرٍ ،  يُحَدِّثُ عَنْ  عَبْدِ اللهِ بْنِ مَعْبَدٍ ،  عَنْ  أَبِي قَتَادَةَ - قُلْتُ : ( الْأَنْصَارِيِّ ؟ ) قَالَ : الْأَنْصَارِيِّ - عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ قَالَ فِي صَوْمِ يَوْمِ عَاشُورَاءَ :  إِنِّي أَحْتَسِبُ عَلَى اللهِ أَنْ يُكَفِّرَ السَّنَةَ الَّتِي قَبْلَهُ  .","","Sharh Ma'ani al-Athar 3295","","أبو قتادة الأنصاري فارس رسول الله عن عبد الله بن معبد الزماني عن غيلان بن جرير المعولي عن شعبة بن الحجاج عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب صوم يوم عاشوراء"
"3092","3296  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  ثَنَا  أَبِي  ، قَالَ :  سَمِعْتُ  غَيْلَانَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3296","","أبو قتادة الأنصاري فارس رسول الله عن عبد الله بن معبد الزماني عن غيلان بن جرير المعولي عن جرير بن حازم عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3093","3297  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ ، قَالَ :  ثَنَا  مَهْدِيُّ بْنُ مَيْمُونٍ ، وَحَمَّادُ بْنُ زَيْدٍ ،  عَنْ  غَيْلَانَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَفِي هَذَا الْحَدِيثِ أَنَّهُ أَمَرَهُمْ بِصَوْمِهِ  احْتِسَابًا  ؛ لِمَا ذَكَرَ فِيهِ مِنَ الْكَفَّارَةِ ، وَلَيْسَ هَذَا بِمُخَالِفٍ - عِنْدَنَا - لِحَدِيثِ  ابْنِ عَبَّاسٍ  ؛ لِأَنَّهُ قَدْ يَجُوزُ أَنْ يَكُونَ كَانَ يَصُومُهُ شُكْرًا لِلهِ ، لَمَّا أَظْهَرَ  مُوسَى  عَلَى  فِرْعَوْنَ  ، فَيَشْكُرُ اللهَ بِهِ ، مَا شَكَرَهُ بِهِ مِنْ ذَلِكَ ، فَيُكَفِّرُ بِهِ عَنِ السَّنَةِ الْمَاضِيَةِ  .","","Sharh Ma'ani al-Athar 3297","","أبو قتادة الأنصاري فارس رسول الله عن عبد الله بن معبد الزماني عن غيلان بن جرير المعولي عن مهدي بن ميمون المعولي عن أبو داود الطيالسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب صوم يوم عاشوراء"
"3094","3298  -  حَدَّثَنَا  أَبُو بَكْرَةَ وَابْنُ مَرْزُوقٍ ، قَالَا :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  مَالِكُ بْنُ أَنَسٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ،  أَنَّهُ سَمِعَ  مُعَاوِيَةَ عَامَ حَجَّ وَهُوَ عَلَى الْمِنْبَرِ يَقُولُ : يَا  أَهْلَ الْمَدِينَةِ  ، أَيْنَ عُلَمَاؤُكُمْ ؟ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي هَذَا الْيَوْمِ :  هَذَا يَوْمُ عَاشُورَاءَ ، وَلَمْ يُكْتَبْ عَلَيْكُمْ صِيَامُهُ ، وَأَنَا صَائِمٌ  ، فَمَنْ شَاءَ فَلْيَصُمْ ، وَمَنْ شَاءَ فَلْيُفْطِرْ  .  فَقَدْ يَجُوزُ أَنْ يَكُونَ أَرَادَ بِقَوْلِهِ : ( وَلَمْ يُكْتَبْ عَلَيْكُمْ صِيَامُهُ ) ، أَيْ : صِيَامُ ذَلِكَ الْيَوْمِ فِي ذَلِكَ الْعَامِ .  وَلَيْسَ فِي هَذَا نَفْيُ أَنْ يَكُونَ قَدْ كَانَ كُتِبَ ذَلِكَ عَلَيْهِمْ فِيمَا تَقَدَّمَ ذَلِكَ الْعَامَ مِنَ الْأَعْوَامِ ، ثُمَّ نُسِخَ بَعْدَ ذَلِكَ عَلَى مَا تَقَدَّمَ مِنَ الْأَحَادِيثِ الْأُوَلِ .  فَقَدْ ثَبَتَ نَسْخُ صَوْمِ يَوْمِ عَاشُورَاءَ الَّذِي كَانَ فَرْضًا ، وَأَمَرَ بِذَلِكَ عَلَى الِاخْتِيَارِ ، وَأَخْبَرَ بِمَا فِي ذَلِكَ مِنَ الثَّوَابِ فَصَوْمُهُ حَسَنٌ ، وَهُوَ الْيَوْمُ الْعَاشِرُ ، قَدْ قَالَ ذَلِكَ  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا فِي حَدِيثِ  الْحَكَمِ بْنِ الْأَعْرَجِ  ، وَذَكَرَ ذَلِكَ أَيْضًا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Sharh Ma'ani al-Athar 3298","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن مالك بن أنس عن روح بن عبادة القيسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3095","3299  - وَقَدْ رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ أَيْضًا مَا  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبَّاسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَئِنْ عِشْتُ الْعَامَ الْقَابِلَ لَأَصُومَنَّ يَوْمَ التَّاسِعِ  ،  يَعْنِي عَاشُورَاءَ  .","","Sharh Ma'ani al-Athar 3299","","عبد الله بن عباس عن عبد الله بن عمير العباسي عن القاسم بن العباس اللهبي عن محمد بن عبد الرحمن بن المغيرة عن أسد السنة عن سليمان بن شعيب الكيساني عن الطحاوي","باب صوم يوم عاشوراء"
"3096","3300  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو عَامِرٍ ، وَأَبُو دَاوُدَ ، قَالَا :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ ، غَيْرَ أَنَّهُ قَالَ :  لَأَصُومَنَّ عَاشُورَاءَ ، يَوْمَ التَّاسِعِ  .         [2/78]","","Sharh Ma'ani al-Athar 3300","","عبد الله بن عباس عن عبد الله بن عمير العباسي عن القاسم بن العباس اللهبي عن محمد بن عبد الرحمن بن المغيرة عن أبو داود الطيالسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب صوم يوم عاشوراء"
"3097","3301  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ وَعَلِيُّ بْنُ شَيْبَةَ ، قَالَا :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ، فَذَكَرَ مِثْلَ حَدِيثِ  سُلَيْمَانَ  .  فَقَوْلُهُ : "" لَأَصُومَنَّ عَاشُورَاءَ يَوْمَ التَّاسِعِ "" إِخْبَارٌ مِنْهُ عَلَى أَنَّهُ يَكُونُ ذَلِكَ الْيَوْمُ ، يَوْمَ عَاشُورَاءَ ، وَقَوْلُهُ : "" لَأَصُومَنَّ يَوْمَ التَّاسِعِ "" يَحْتَمِلُ : ( لَأَصُومَنَّ يَوْمَ التَّاسِعِ مَعَ الْعَاشِرِ ) ، أَيْ : لِئَلَّا أَقْصِدَ بِصَوْمِي إِلَى يَوْمِ عَاشُورَاءَ بِعَيْنِهِ ، كَمَا يَفْعَلُ الْيَهُودُ ، وَلَكِنْ أَخْلِطُهُ بِغَيْرِهِ ، فَأَكُونَ قَدْ صُمْتُهُ ، بِخِلَافِ مَا تَصُومُهُ يَهُودُ  .  وَقَدْ رُوِيَ عَنِ  ابْنِ عَبَّاسٍ  مَا يَدُلُّ عَلَى هَذَا الْمَعْنَى  .","","Sharh Ma'ani al-Athar 3301","","عبد الله بن عباس عن عبد الله بن عمير العباسي عن القاسم بن العباس اللهبي عن محمد بن عبد الرحمن بن المغيرة عن روح بن عبادة القيسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3098","3302  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  عَطَاءٌ ،  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ : (  خَالِفُوا الْيَهُودَ ، وَصُومُوا يَوْمَ التَّاسِعِ وَالْعَاشِرِ  ) .  فَدَلَّ ذَلِكَ عَلَى أَنَّ  ابْنَ عَبَّاسٍ  ، قَدْ صَرَفَ قَوْلَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَئِنْ عِشْتُ إِلَى قَابِلٍ لَأَصُومَنَّ يَوْمَ التَّاسِعِ "" إِلَى مَا صَرَفْنَاهُ إِلَيْهِ  .  وَقَدْ جَاءَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ أَيْضًا مَا .","","Sharh Ma'ani al-Athar 3302","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن روح بن عبادة القيسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3099","3303  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  حَدَّثَنِي  ابْنُ أَبِي لَيْلَى ،  عَنْ  دَاوُدَ بْنِ عَلِيٍّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ابْنِ عَبَّاسٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي صَوْمِ يَوْمِ عَاشُورَاءَ :  صُومُوهُ ، وَصُومُوا قَبْلَهُ يَوْمًا ، أَوْ بَعْدَهُ يَوْمًا  ، وَلَا تَتَشَبَّهُوا بِالْيَهُودِ  .","","Sharh Ma'ani al-Athar 3303","","عبد الله بن عباس عن علي بن عبد الله بن عباس بن عبد المطلب عن داود بن علي الهاشمي عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن فهد بن سليمان الدلال عن الطحاوي","باب صوم يوم عاشوراء"
"3100","3304  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ، قَالَ :  ثَنَا  أَبُو شِهَابٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَثَبَتَ بِهَذَا الْحَدِيثِ مَا ذَكَرْنَاهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا أَرَادَ بِصَوْمِ التَّاسِعِ ، أَنْ يُدْخِلَ صَوْمَهُ يَوْمَ عَاشُورَاءَ ، فِي غَيْرِهِ مِنَ الصِّيَامِ ، حَتَّى لَا يَكُونَ مَقْصُودًا إِلَى صَوْمِهِ بِعَيْنِهِ .  كَمَا جَاءَ عَنْهُ فِي صَوْمِ يَوْمِ الْجُمُعَةِ  .","","Sharh Ma'ani al-Athar 3304","","عبد الله بن عباس عن علي بن عبد الله بن عباس بن عبد المطلب عن داود بن علي الهاشمي عن محمد بن عبد الرحمن بن أبي ليلى عن عبد ربه بن نافع الحناط عن أحمد بن عبد الله اليربوعي عن فهد بن سليمان الدلال عن الطحاوي","باب صوم يوم عاشوراء"
"3101","3305  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ ، قَالَ :  أَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  سَعِيدٍ - وَهُوَ ابْنُ أَبِي عَرُوبَةَ -  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ مُسَيِّبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  دَخَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  جُوَيْرِيَةَ  رَضِيَ اللهُ عَنْهَا يَوْمَ الْجُمُعَةِ ، وَهِيَ صَائِمَةٌ . فَقَالَ لَهَا :  أَصُمْتِ أَمْسِ ؟ قَالَتْ : لَا  . قَالَ : أَفَلَا تَصُومِينَ غَدًا ؟ قَالَتْ : لَا . قَالَ : فَأَفْطِرِي إِذًا  .","","Sharh Ma'ani al-Athar 3305","","عبد الله بن عمرو بن العاص عن سعيد بن المسيب عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبدة بن سليمان الكلابي عن محمد بن سعيد حمدان عن فهد بن سليمان الدلال عن الطحاوي","باب صوم يوم عاشوراء"
"3102","3306  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ، قَالَ :  سَمِعْتُ  أَبَا أَيُّوبَ الْعَتَكِيَّ  يُحَدِّثُ ، عَنْ  جُوَيْرِيَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ دَخَلَ عَلَيْهَا ، ثُمَّ ذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3306","","جويرية بنت الحارث المصطلقية عن أبو أيوب المراغي عن قتادة بن دعامة عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن سليمان بن شعيب الكيساني عن الطحاوي","باب صوم يوم عاشوراء"
"3103","3307  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عَبْدُ الصَّمَدِ ، قَالَ :  ثَنَا  شُعْبَةُ ، وَحَمَّادُ بْنُ سَلَمَةَ ، وَهَمَّامٌ ،  عَنْ  قَتَادَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3307","","جويرية بنت الحارث المصطلقية عن أبو أيوب المراغي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عبد الصمد بن عبد الوارث التنوري عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3104","3308  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تَصُومُوا يَوْمَ الْجُمُعَةِ إِلَّا أَنْ تَصُومُوا قَبْلَهُ يَوْمًا  ، أَوْ بَعْدَهُ يَوْمًا  .","","Sharh Ma'ani al-Athar 3308","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن هشام بن حسان العتكي عن روح بن عبادة القيسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم عاشوراء"
"3105","3309  -  حَدَّثَنَا  بَكْرُ بْنُ إِدْرِيسَ ، قَالَ :  ثَنَا  آدَمُ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  ثَنَا  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ ، قَالَ :  سَمِعْتُ  رَجُلًا مِنْ بَنِي الْحَارِثِ بْنِ كَعْبٍ  يُحَدِّثُ ، عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِمِثْلِ مَعْنَاهُ .","","Sharh Ma'ani al-Athar 3309","","أبو هريرة الدوسي عن رجل من بني الحارث بن كعب عن عبد الملك بن عمير القبطي عن شعبة بن الحجاج عن آدم بن أبي إياس عن بكر بن إدريس بن الحجاج الحجرى عن الطحاوي","باب صوم يوم عاشوراء"
"3106","[2/79]      3310  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ ، قَالَ :  أَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  زِيَادٍ الْحَارِثِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3310","","أبو هريرة الدوسي عن زياد بن النضر الحارثي عن عبد الملك بن عمير القبطي عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن فهد بن سليمان الدلال عن الطحاوي","باب صوم يوم عاشوراء"
"3107","3311  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْقَاسِمُ بْنُ سَلَّامِ بْنِ مِسْكِينٍ ، قَالَ :  ثَنَا  أَبِي  ، قَالَ :  سَأَلْتُ  الْحَسَنَ عَنْ صِيَامِ يَوْمِ الْجُمُعَةِ ، فَقَالَ : ( نُهِيَ عَنْهُ إِلَّا فِي أَيَّامٍ مُتَتَابِعَةٍ ) .  3312  - ثُمَّ قَالَ :  حَدَّثَنِي  أَبُو رَافِعٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ صِيَامِ يَوْمِ الْجُمُعَةِ إِلَّا فِي أَيَّامٍ قَبْلَهُ  ، أَوْ بَعْدَهُ  .","","Sharh Ma'ani al-Athar 3311","","أبو هريرة الدوسي عن نفيع بن رافع الصائغ عن الحسن البصري عن سلام بن مسكين النمري عن القاسم بن سلام النميري عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب صوم يوم عاشوراء"
"3108","3313  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ أَبِي حَبِيبٍ ، أَنَّ أَبَا الْخَيْرِ  حَدَّثَهُ  ، أَنَّ حُذَيْفَةَ الْبَارِقِيَّ  حَدَّثَهُ  ، أَنَّ جُنَادَةَ بْنَ أَبِي أُمَيَّةَ الْأَزْدِيَّ  حَدَّثَهُ  ،  أَنَّهُمْ دَخَلُوا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي يَوْمِ جُمُعَةٍ ، فَقَرَّبَ إِلَيْهِمْ طَعَامًا ، فَقَالَ : كُلُوا . فَقَالُوا : نَحْنُ صِيَامٌ .  فَقَالَ :  أَصُمْتُمْ أَمْسِ . قَالُوا : لَا  . قَالَ : أَفَصَائِمُونَ غَدًا ؟ قَالُوا : لَا . قَالَ : فَأَفْطِرُوا .","","Sharh Ma'ani al-Athar 3313","","جنادة بن أبي أمية الأزدي عن حذيفة البارقي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب صوم يوم عاشوراء"
"3109","3314  -  حَدَّثَنَا  بَحْرُ بْنُ نَصْرٍ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  عَامِرِ بْنِ لُدَيْنٍ الْأَشْعَرِيِّ ،  أَنَّهُ سَأَلَ  أَبَا هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنْ صِيَامِ يَوْمِ الْجُمُعَةِ ، فَقَالَ : عَلَى الْخَبِيرِ وَقَعْتَ ؛ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ يَوْمَ الْجُمُعَةِ عِيدُكُمْ ، فَلَا تَجْعَلُوا يَوْمَ عِيدِكُمْ يَوْمَ صِيَامِكُمْ  ، إِلَّا أَنْ تَصُومُوا قَبْلَهُ ، أَوْ بَعْدَهُ  .  فَكَمَا كُرِهَ أَنْ يُقْصَدَ إِلَى يَوْمِ الْجُمُعَةِ بِعَيْنِهِ بِصِيَامٍ إِلَّا أَنْ يُخْلَطَ بِيَوْمٍ قَبْلَهُ ، أَوْ بِيَوْمٍ بَعْدَهُ ، فَيَكُونَ قَدْ دَخَلَ فِي صِيَامٍ ، حَتَّى صَارَ مِنْهُ .  وَكَذَلِكَ - عِنْدَنَا - سَائِرُ الْأَيَّامِ لَا يَنْبَغِي أَنْ يُقْصَدَ إِلَى صَوْمِ يَوْمٍ مِنْهَا بِعَيْنِهِ ، كَمَا لَا يَنْبَغِي أَنْ يُقْصَدَ إِلَى صَوْمِ يَوْمِ عَاشُورَاءَ ، أَوْ يَوْمِ الْجُمُعَةِ لِأَعْيَانِهِمَا .  وَلَكِنْ يُقْصَدُ إِلَى الصِّيَامِ فِي أَيِّ الْأَيَّامِ كَانَ .  وَإِنَّمَا أُرِيدَ بِمَا ذَكَرْنَا مِنَ الْكَرَاهَةِ الَّتِي وَصَفْنَا التَّفْرِقَةُ بَيْنَ شَهْرِ رَمَضَانَ ، وَبَيْنَ سَائِرِ مَا يَصُومُ النَّاسُ غَيْرَهُ .  لِأَنَّ شَهْرَ رَمَضَانَ مَقْصُودٌ بِصَوْمِهِ إِلَى شَهْرٍ بِعَيْنِهِ ؛ لِأَنَّ فَرِيضَةَ اللهِ عَزَّ وَجَلَّ عَلَى عِبَادِهِ ، صَوْمُهُمْ إِيَّاهُ بِعَيْنِهِ إِلَّا مَنْ عُذِرَ مِنْهُمْ ، بِمَرَضٍ ، أَوْ سَفَرٍ ، وَغَيْرُهُ مِنَ الشُّهُورِ لَيْسَ كَذَلِكَ .  فَهَذَا وَجْهُ مَا رُوِيَ فِي صَوْمِ يَوْمِ عَاشُورَاءَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَدْ بَيَّنَّاهُ فِي هَذَا الْبَابِ وَشَرَحْنَاهُ  .","","Sharh Ma'ani al-Athar 3314","","أبو هريرة الدوسي عن عامر بن لدين الأشعري عن أبو بشر المؤذن عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن وهب المصري عن بحر بن نصر بن سابق الخولاني عن الطحاوي","باب صوم يوم عاشوراء"
"3110","[2/80]      8 - بَابُ صَوْمِ يَوْمِ السَّبْتِ  3315  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ - هُوَ إِبْرَاهِيمُ - قَالَ :  ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُسْرٍ ،  عَنْ  أُخْتِهِ الصَّمَّاءِ  ، قَالَتْ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَصُومُنَّ يَوْمَ السَّبْتِ فِي غَيْرِ مَا افْتُرِضَ عَلَيْكُنَّ  ، وَلَوْ لَمْ تَجِدْ إِحْدَاكُنَّ إِلَّا  لِحَاءَ  شَجَرَةٍ ، أَوْ عُودَ عِنَبٍ ، فَلْتَمْضُغْهُ "" .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى هَذَا الْحَدِيثِ ، فَكَرِهُوا صَوْمَ يَوْمِ السَّبْتِ تَطَوُّعًا .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَلَمْ يَرَوْا بِصَوْمِهِ بَأْسًا .  وَكَانَ مِنَ الْحُجَّةِ عَلَيْهِمْ فِي ذَلِكَ ، أَنَّهُ قَدْ جَاءَ الْحَدِيثُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ نَهَى عَنْ صَوْمِ يَوْمِ الْجُمُعَةِ إِلَّا أَنْ يُصَامَ قَبْلَهُ يَوْمٌ ، أَوْ بَعْدَهُ يَوْمٌ .  وَقَدْ ذَكَرْنَا ذَلِكَ  بِأَسَانِيدِهِ  ، فِيمَا تَقَدَّمَ مِنْ كِتَابِنَا هَذَا ، فَالْيَوْمُ الَّذِي بَعْدَهُ ، هُوَ يَوْمُ السَّبْتِ .  فَفِي هَذِهِ الْآثَارِ الْمَرْوِيَّةِ فِي هَذَا إِبَاحَةُ صَوْمِ يَوْمِ السَّبْتِ تَطَوُّعًا ، وَهِيَ أَشْهَرُ وَأَظْهَرُ فِي أَيْدِي الْعُلَمَاءِ مِنْ هَذَا الْحَدِيثِ الشَّاذِّ الَّذِي قَدْ خَالَفَهَا .  وَقَدْ أَذِنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي صَوْمِ عَاشُورَاءَ وَحَضَّ عَلَيْهِ ، وَلَمْ يَقُلْ : إِنْ كَانَ يَوْمَ السَّبْتِ فَلَا تَصُومُوهُ .  فَفِي ذَلِكَ دَلِيلٌ عَلَى دُخُولِ كُلِّ الْأَيَّامِ فِيهِ .  وَقَدْ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَحَبُّ الصِّيَامِ إِلَى اللهِ عَزَّ وَجَلَّ صِيَامُ  دَاوُدَ  عَلَيْهِ السَّلَامُ ، كَانَ يَصُومُ يَوْمًا ، وَيُفْطِرُ يَوْمًا "" وَسَنَذْكُرُ ذَلِكَ  بِإِسْنَادِهِ  فِي مَوْضِعِهِ مِنْ كِتَابِنَا هَذَا ، إِنْ شَاءَ اللهُ تَعَالَى .  فَفِي ذَلِكَ أَيْضًا التَّسْوِيَةُ بَيْنَ يَوْمِ السَّبْتِ ، وَبَيْنَ سَائِرِ الْأَيَّامِ  .  وَقَدْ أَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَيْضًا بِصِيَامِ أَيَّامِ  الْبِيضِ  ، وَرُوِيَ عَنْهُ فِي ذَلِكَ مَا .","","Sharh Ma'ani al-Athar 3315","","الصماء بنت بسر المازنية عن عبد الله بن بسر بن أبي بسر القيسي عن خالد بن معدان عن ثور بن يزيد الكلاعي عن أبو عاصم النبيل عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم السبت"
"3111","3316  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ وَحَكِيمٍ ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنِ  ابْنِ الْحَوْتَكِيَّةِ ،  عَنْ  أَبِي ذَرٍّ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِرَجُلٍ  أَمَرَهُ بِصِيَامِ ثَلَاثَ عَشْرَةَ  ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ  .","","Sharh Ma'ani al-Athar 3316","","أبو ذر الغفاري عن يزيد بن الحوتكية التميمي عن موسى بن طلحة بن عبيد الله التيمي عن حكيم بن جبير الأسدي عن سفيان بن عيينة عن يونس بن عبد الأعلى عن الطحاوي","باب صوم يوم السبت"
"3112","[2/81]      3317  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  حِبَّانُ ، قَالَ :  ثَنَا  هَمَامٌ  ، قَالَ :  ثَنَا  أَنَسُ بْنُ سِيرِينَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ قَتَادَةَ بْنِ مِلْحَانَ الْقَيْسِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْمُرُنَا أَنْ نَصُومَ لَيَالِيَ  الْبِيضِ  ، ثَلَاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ ، وَقَالَ : "" هِيَ كَهَيْئَةِ الدَّهْرِ  .  وَقَدْ يَدْخُلُ السَّبْتُ فِي هَذِهِ ، كَمَا يَدْخُلُ فِيهَا غَيْرُهُ ، مِنْ سَائِرِ الْأَيَّامِ .  فَفِيهَا أَيْضًا إِبَاحَةُ صَوْمِ يَوْمِ السَّبْتِ تَطَوُّعًا .  وَلَقَدْ أَنْكَرَ  الزُّهْرِيُّ  حَدِيثَ  الصَّمَّاءِ  فِي كَرَاهَةِ صَوْمِ يَوْمِ السَّبْتِ ، وَلَمْ يَعُدَّهُ مِنْ حَدِيثِ أَهْلِ الْعِلْمِ ، بَعْدَ مَعْرِفَتِهِ بِهِ  .  في طبعة عالم الكتب : (حمام ) والمثبت من النسخة الأزهرية .","","Sharh Ma'ani al-Athar 3317","","قتادة بن ملحان القيسي عن عبد الملك بن قتادة بن ملحان القيسي عن أنس بن سيرين عن همام بن يحيى بن دينار عن حبان بن هلال الباهلي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب صوم يوم السبت"
"3113","3318  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حُمَيْدِ بْنِ هِشَامٍ الرُّعَيْنِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  سُئِلَ  الزُّهْرِيُّ عَنْ صَوْمِ يَوْمِ السَّبْتِ  ، فَقَالَ : ( لَا بَأْسَ بِهِ ) .  فَقِيلَ لَهُ : فَقَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي كَرَاهَتِهِ ، فَقَالَ : ذَاكَ حَدِيثٌ حِمْصِيٌّ ، فَلَمْ يَعُدَّهُ  الزُّهْرِيُّ  حَدِيثًا يُقَالُ بِهِ ، وَضَعَّفَهُ  .  وَقَدْ يَجُوزُ عِنْدَنَا ، وَاللهُ أَعْلَمُ ، إِنْ كَانَ ثَابِتًا ، أَنْ يَكُونَ إِنَّمَا نُهِيَ عَنْ صَوْمِهِ ؛ لِئَلَّا يَعْظُمَ بِذَلِكَ ، فَيُمْسَكَ عَنِ الطَّعَامِ وَالشَّرَابِ وَالْجِمَاعِ فِيهِ ، كَمَا يَفْعَلُ الْيَهُودُ .  فَأَمَّا مَنْ صَامَهُ لَا لِإِرَادَتِهِ تَعْظِيمَهُ ، وَلَا لِمَا تُرِيدُ الْيَهُودُ بِتَرْكِهَا السَّعْيَ فِيهِ ، فَإِنَّ ذَلِكَ غَيْرُ مَكْرُوهٍ .  فَإِنْ قَالَ قَائِلٌ : فَقَدْ رَخَّصَ فِي صِيَامِ أَيَّامٍ بِعَيْنِهَا مَقْصُودَةٍ بِالصَّوْمِ ، وَهِيَ أَيَّامُ  الْبِيضِ  ، فَهَذَا دَلِيلٌ عَلَى أَنْ لَا بَأْسَ بِالْقَصْدِ بِالصَّوْمِ إِلَى يَوْمٍ بِعَيْنِهِ .  قِيلَ لَهُ : إِنَّهُ قَدْ قِيلَ : إِنَّ أَيَّامَ  الْبِيضِ  إِنَّمَا أُمِرَ بِصَوْمِهَا ؛ لِأَنَّ الْكُسُوفَ يَكُونُ فِيهَا ، وَلَا يَكُونُ فِي غَيْرِهَا ، وَقَدْ أُمِرْنَا بِالتَّقَرُّبِ إِلَى اللهِ عَزَّ وَجَلَّ بِالصَّلَاةِ وَالْعَتَاقِ ( لَيْلَتَهُ ) وَغَيْرِ ذَلِكَ مِنْ أَعْمَالِ  الْبِرِّ  عِنْدَ الْكُسُوفِ .  فَأَمَرَ بِصِيَامِ هَذِهِ الْأَيَّامِ ؛ لِيَكُونَ ذَلِكَ بِرًّا مَفْعُولًا بِعَقِبِ الْكُسُوفِ ، فَذَلِكَ صِيَامٌ غَيْرُ مَقْصُودٍ بِهِ إِلَى يَوْمٍ بِعَيْنِهِ فِي نَفْسِهِ .  وَلَكِنَّهُ صِيَامٌ مَقْصُودٌ بِهِ فِي وَقْتٍ شُكْرًا لِلهِ عَزَّ وَجَلَّ لِعَارِضٍ كَانَ فِيهِ ، فَلَا بَأْسَ بِذَلِكَ .  وَكَذَلِكَ أَيْضًا يَوْمُ الْجُمُعَةِ إِذَا صَامَهُ رَجُلٌ شُكْرًا لِعَارِضٍ ، مِنْ كُسُوفِ شَمْسٍ أَوْ قَمَرٍ ، أَوْ شُكْرًا لِلهِ عَزَّ وَجَلَّ ، فَلَا بَأْسَ بِذَلِكَ ، وَإِنْ لَمْ يَصُمْ قَبْلَهُ وَلَا بَعْدَهُ يَوْمًا  .","","Sharh Ma'ani al-Athar 3318","","الزهري عن الليث بن سعد عن عبد الله بن صالح المصري عن محمد بن حميد بن هشام الرعيني عن الطحاوي","باب صوم يوم السبت"
"3114","[2/82]      9 - بَابُ الصَّوْمِ بَعْدَ النِّصْفِ مِنْ شَعْبَانَ إِلَى رَمَضَانَ .  3319  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  حِبَّانُ وَيَعْقُوبُ بْنُ إِسْحَاقَ ، قَالَا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ إِبْرَاهِيمَ الْقَاصُّ ، قَالَ :  ثَنَا  الْعَلَاءُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا صَوْمَ بَعْدَ النِّصْفِ مِنْ شَعْبَانَ حَتَّى رَمَضَانَ  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى كَرَاهَةِ الصَّوْمِ بَعْدَ النِّصْفِ مِنْ شَعْبَانَ إِلَى رَمَضَانَ ، وَاحْتَجُّوا فِي ذَلِكَ بِهَذَا الْحَدِيثِ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : لَا بَأْسَ بِصَوْمِ شَعْبَانَ كُلِّهِ ، وَهُوَ حَسَنٌ غَيْرُ مَنْهِيٍّ عَنْهُ  .  وَاحْتَجُّوا فِي ذَلِكَ بِمَا .","","Sharh Ma'ani al-Athar 3319","","أبو هريرة الدوسي عن عبد الرحمن بن يعقوب الجهني عن العلاء بن عبد الرحمن الحرقي عن عبد الرحمن بن إبراهيم القاري عن يعقوب بن إسحاق بن زيد الحضرمي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3115","3320  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  عَمِّي عَبْدُ اللهِ بْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  فُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  لَيْثٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرِنُ شَعْبَانَ بِرَمَضَانَ  .","","Sharh Ma'ani al-Athar 3320","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن ليث بن أبي سليم عن الفضيل بن عياض عن عبد الله بن وهب المصري عن أحمد بن عبد الرحمن بن وهب عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3116","3321  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ يُونُسَ ، قَالَ :  ثَنَا  أَبُو حُذَيْفَةَ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  مَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَامَ شَهْرَيْنِ مُتَتَابِعَيْنِ إِلَّا شَعْبَانَ  وَرَمَضَانَ .","","Sharh Ma'ani al-Athar 3321","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن سفيان الثوري عن موسى بن مسعود النهدي عن إبراهيم بن محمد بن يونس البصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3117","3322  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  الْقَعْنَبِيُّ ، قَالَ :  ثَنَا  أَبُو الْغُصْنِ ثَابِتُ بْنُ قَيْسٍ ،  عَنْ  أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ رَضِيَ اللهُ عَنْهُ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُ يَوْمَيْنِ مِنْ كُلِّ جُمُعَةٍ ، لَا يَدَعُهُمَا ، فَقُلْتُ : يَا رَسُولَ اللهِ ، رَأَيْتُكَ لَا تَدَعُ صَوْمَ يَوْمَيْنِ مِنْ كُلِّ جُمُعَةٍ .  قَالَ : أَيُّ يَوْمَيْنِ ؟ قُلْتُ : يَوْمُ الِاثْنَيْنِ وَيَوْمُ الْخَمِيسِ . قَالَ :  ذَاكَ يَوْمَانِ ، تُعْرَضُ فِيهِمَا الْأَعْمَالُ عَلَى رَبِّ الْعَالَمِينَ  ، فَأُحِبُّ أَنْ يُعْرَضَ عَمَلِي وَأَنَا صَائِمٌ  .","","Sharh Ma'ani al-Athar 3322","","أسامة بن زيد بن حارثة ذو البطين عن أبو سعيد المقبري عن ثابت بن قيس الغفاري عن عبد الله بن مسلمة القعنبي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3118","3323  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَ :  ثَنَا  ثَابِتٌ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  وَزَادَ : قَالَ :  وَمَا رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُ مِنْ شَهْرٍ ، مَا يَصُومُ مِنْ شَعْبَانَ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، رَأَيْتُكَ تَصُومُ مِنْ شَعْبَانَ ، مَا لَا تَصُومُ مِنْ غَيْرِهِ مِنَ الشُّهُورِ . قَالَ :  هُوَ شَهْرٌ يَغْفُلُ النَّاسُ عَنْهُ ، بَيْنَ رَجَبٍ وَرَمَضَانَ ، وَهُوَ شَهْرٌ يُرْفَعُ فِيهِ الْأَعْمَالُ إِلَى رَبِّ الْعَالَمِينَ  ، فَأُحِبُّ أَنْ يُرْفَعَ عَمَلِي وَأَنَا صَائِمٌ  .","","Sharh Ma'ani al-Athar 3323","","أسامة بن زيد بن حارثة ذو البطين عن أبو سعيد المقبري عن ثابت بن قيس الغفاري عن عبد الرحمن بن مهدي عن يزيد بن سنان القزاز عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3119","3324  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  ابْنُ أَبِي مَرْيَمَ ، قَالَ :  أَنَا  نَافِعُ بْنُ يَزِيدَ أَنَّ ابْنَ الْهَادِ  حَدَّثَهُ  ، أَنَّ مُحَمَّدَ بْنَ إِبْرَاهِيمَ  حَدَّثَهُ  ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا أَنَّهَا قَالَتْ :  مَا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُ فِي شَهْرٍ ، مَا كَانَ يَصُومُ فِي شَعْبَانَ  ، كَانَ يَصُومُهُ كُلَّهُ إِلَّا قَلِيلًا ، بَلْ كَانَ يَصُومُهُ كُلَّهُ  .","","Sharh Ma'ani al-Athar 3324","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن نافع بن يزيد الكلاعي عن سعيد بن الحكم الجمحي عن فهد بن سليمان الدلال عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3120","[2/83]      3325  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ، قَالَ :  ثَنَا  هِشَامٌ ،  عَنْ  يَحْيَى ،  عَنْ  أَبِي سَلَمَةَ ، قَالَ :  حَدَّثَتْنِي  عَائِشَةُ رَضِيَ اللهُ عَنْهَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ لَا يَصُومُ مِنَ السَّنَةِ أَكْثَرَ مِنْ صِيَامِهِ فِي شَعْبَانَ  ، فَإِنَّهُ كَانَ يَصُومُهُ كُلَّهُ  .","","Sharh Ma'ani al-Athar 3325","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن أبو داود الطيالسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3121","3326  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  بِشْرٌ ،  عَنِ  الْأَوْزَاعِيِّ ، قَالَ :  حَدَّثَنِي  يَحْيَى ، قَالَ :  حَدَّثَنِي  أَبُو سَلَمَةَ ، قَالَ :  حَدَّثَتْنِي  عَائِشَةُ رَضِيَ اللهُ عَنْهَا ، فَذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3326","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن بشر بن بكر التنيسي عن يونس بن عبد الأعلى عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3122","3327  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  حَدَّثَنَا  عَمِّي ، قَالَ :  ثَنَا  أُسَامَةُ بْنُ زَيْدٍ اللَّيْثِيُّ ، قَالَ :  حَدَّثَنِي  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ قَالَ :  سَأَلْتُ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ صِيَامِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَقَالَتْ :  كَانَ يَصُومُ حَتَّى نَقُولَ : لَا يُفْطِرُ ، وَيُفْطِرُ حَتَّى نَقُولَ : لَا يَصُومُ  ، وَكَانَ يَصُومُ شَعْبَانَ ، أَوْ عَامَّةَ شَعْبَانَ .","","Sharh Ma'ani al-Athar 3327","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن أسامة بن زيد الليثي المدني عن عبد الله بن وهب المصري عن أحمد بن عبد الرحمن بن وهب عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3123","3328  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  ثَنَا  يَزِيدُ الرِّشْكُ ،  عَنْ  مُعَاذَةَ الْعَدَوِيَّةِ قَالَتْ :  سُئِلَتْ  عَائِشَةُ رَضِيَ اللهُ عَنْهَا : أَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَصُومُ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ ؟ قَالَتْ : نَعَمْ  .  فَقِيلَ لَهَا : مِنْ أَيِّهِ ؟ قَالَتْ : مَا كَانَ  يُبَالِي  مِنْ أَيِّ  الشَّهْرِ  صَامَهَا  .  قَالُوا : فَفِي هَذِهِ الْآثَارِ دَلِيلٌ عَلَى أَنْ لَا بَأْسَ بِصَوْمِ شَعْبَانَ كُلِّهِ .  فَكَانَ مِنْ حُجَّةِ الْأَوَّلِينَ عَلَيْهِمْ ، أَنَّ الَّذِي رُوِيَ فِي هَذِهِ الْأَخْبَارِ إِنَّمَا هُوَ إِخْبَارٌ عَنْ فِعْلِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَمَا قَبْلَ ذَلِكَ ، مِمَّا فِيهِ النَّهْيُ ، إِخْبَارٌ عَنْ قَوْلِهِ ، فَكَانَ يَنْبَغِي أَنْ يُصَحَّحَ الْحَدِيثَانِ جَمِيعًا .  فَجُعِلَ مَا فَعَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ مُبَاحًا لَهُ ، وَمَا نَهَى عَنْهُ كَانَ مَحْظُورًا عَلَى غَيْرِهِ ، فَيَكُونُ حُكْمُ غَيْرِهِ فِي ذَلِكَ خِلَافَ حُكْمِهِ حَتَّى يَصِحَّ الْحَدِيثَانِ جَمِيعًا وَلَا يَتَضَادَّانِ .  فَكَانَ مِنَ الْحُجَّةِ عَلَيْهِمْ فِي ذَلِكَ أَنَّ فِي حَدِيثِ  أُسَامَةَ  عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ فِي شَعْبَانَ : "" هُوَ شَهْرٌ يَغْفُلُ النَّاسُ عَنْ صَوْمِهِ "" .  فَدَلَّ ذَلِكَ أَنَّ صَوْمَهُمْ إِيَّاهُ أَفْضَلُ مِنَ الْإِفْطَارِ ، وَقَدْ رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَيْضًا مَا يَدُلُّ عَلَى مَا ذَكَرْنَا  .","","Sharh Ma'ani al-Athar 3328","","عائشة بنت أبي بكر الصديق عن معاذة بنت عبد الله العدوية عن يزيد بن أبي يزيد الرشك عن شعبة بن الحجاج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3124","3329  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ قَالَ :  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  صَدَقَةُ بْنُ مُوسَى ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَفْضَلُ الصِّيَامِ بَعْدَ رَمَضَانَ شَعْبَانُ  .","","Sharh Ma'ani al-Athar 3329","","أنس بن مالك عن ثابت البناني عن صدقة بن موسى الدقيقي عن موسى بن إسماعيل التبوذكي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3125","3330  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  عَنْ  صَدَقَةَ بْنِ مُوسَى  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ قَالَ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَيُّ الصَّوْمِ أَفْضَلُ ؟ يَعْنِي بَعْدَ رَمَضَانَ .  قَالَ :  صَوْمُ شَعْبَانَ تَعْظِيمًا لِرَمَضَانَ  .","","Sharh Ma'ani al-Athar 3330","","أنس بن مالك عن ثابت البناني عن صدقة بن موسى الدقيقي عن يزيد بن هارون عن عبد الرحمن بن صالح العتكي عن أحمد بن داود بن موسى السدوسي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3126","3331  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ التَّيْمِيُّ ، قَالَ :  أَنَا  حَمَّادٌ ،  عَنْ  ثَابِتٍ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ         [2/84]      بْنِ الشِّخِّيرِ ،  عَنْ  عِمْرَانَ بْنِ حُصَيْنٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِرَجُلٍ  :  هَلْ صُمْتَ مِنْ سَرَرِ شَعْبَانَ ؟  قَالَ : لَا .  قَالَ : "" فَإِذَا أَفْطَرْتَ رَمَضَانَ فَصُمْ يَوْمَيْنِ  .","","Sharh Ma'ani al-Athar 3331","","عمران بن حصين بن عبيد بن خلف الخزاعي عن مطرف بن عبد الله بن الشخير الحرشي عن ثابت البناني عن حماد بن سلمة عن ابن عائشة عن أحمد بن داود بن موسى السدوسي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3127","3332  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ ، قَالَ :  أَنَا  حَمَّادٌ ،  عَنِ  الْجُرَيْرِيِّ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ - هُوَ ابْنُ الشِّخِّيرِ -  عَنْ  عِمْرَانَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ . غَيْرَ أَنَّهُ قَالَ : صُمْ يَوْمًا .  قَالَ أَبُو جَعْفَرٍ :  وَهَذَا فِي آخِرِ شَعْبَانَ ، فَفِي هَذِهِ الْآثَارِ مِنْ أَمْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُمَّتَهُ مَا قَدْ وَافَقَ فِعْلَهُ  .  وَقَدْ رُوِيَ عَنْهُ فِي ذَلِكَ أَيْضًا مَا","","Sharh Ma'ani al-Athar 3332","","عمران بن حصين بن عبيد بن خلف الخزاعي عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن حماد بن سلمة عن ابن عائشة عن أحمد بن داود بن موسى السدوسي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3128","3333  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ ، قَالَ :  ثَنَا  هِشَامُ بْنُ أَبِي عَبْدِ اللهِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقَدَّمُوا رَمَضَانَ بِصَوْمِ يَوْمٍ وَلَا يَوْمَيْنِ  إِلَّا أَنْ يَكُونَ رَجُلٌ كَانَ يَصُومُ صِيَامًا فَلْيَصُمْهُ  .","","Sharh Ma'ani al-Athar 3333","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن أبو داود الطيالسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3129","3334  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  هِشَامٌ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3334","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن مسلم بن إبراهيم الشحام عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3130","3335  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  هِشَامٌ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، فَذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3335","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن هشام بن حسان العتكي عن روح بن عبادة القيسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3131","3336  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  عَمْرُو بْنُ أَبِي سَلَمَةَ ، قَالَ :  سَمِعْتُ  الْأَوْزَاعِيَّ ، قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ، قَالَ :  حَدَّثَنِي  أَبُو سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3336","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن عمرو بن أبي سلمة التنيسي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3132","3337  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  حُسَيْنٌ الْمُعَلِّمُ وَهِشَامُ بْنُ أَبِي عَبْدِ اللهِ ،  عَنْ  يَحْيَى ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3337","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن روح بن عبادة القيسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3133","3338  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْوُحَاظِيُّ - يَعْنِي يَحْيَى بْنَ صَالِحٍ - قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3338","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن سليمان بن بلال القرشي عن يحيى بن صالح الوحاظي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3134","3339  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  عَبْدُ الْوَهَّابِ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَلَمَّا قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِلَّا أَنْ يُوَافِقَ ذَلِكَ صَوْمًا كَانَ يَصُومُهُ أَحَدُكُمْ فَلْيَصُمْهُ "" دَلَّ ذَلِكَ عَلَى دَفْعِ مَا قَالَ أَهْلُ الْمَقَالَةِ الْأُولَى وَعَلَى أَنَّ مَا بَعْدَ النِّصْفِ مِنْ شَعْبَانَ إِلَى رَمَضَانَ حُكْمُ صَوْمِهِ حُكْمُ صَوْمِ سَائِرِ الدَّهْرِ الْمُبَاحِ صَوْمُهُ ، فَلَمَّا ثَبَتَ هَذَا الْمَعْنَى الَّذِي ذَكَرْنَا دَلَّ ذَلِكَ أَنَّ النَّهْيَ الَّذِي كَانَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَدِيثِ  أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ الَّذِي ذَكَرْنَاهُ فِي أَوَّلِ هَذَا الْبَابِ لَمْ يَكُنْ إِلَّا عَلَى الْإِشْفَاقِ مِنْهُ عَلَى صُوَّامِ رَمَضَانَ لَا لِمَعْنًى غَيْرِ ذَلِكَ ، وَكَذَلِكَ نَأْمُرُ مَنْ كَانَ الصَّوْمُ بِقُرْبِ رَمَضَانَ ، يَدْخُلُهُ بِهِ ضَعْفٌ يَمْنَعُهُ مِنْ صَوْمِ رَمَضَانَ أَنْ لَا يَصُومَ حَتَّى يَصُومَ رَمَضَانَ ؛ لِأَنَّ صَوْمَ رَمَضَانَ أَوْلَى بِهِ مِنْ صَوْمِ مَا لَيْسَ عَلَيْهِ صَوْمُهُ ،         [2/85]      فَهَذَا هُوَ الْمَعْنَى الَّذِي يَنْبَغِي أَنْ يُحْمَلَ عَلَيْهِ مَعْنَى ذَلِكَ الْحَدِيثِ حَتَّى لَا يُضَادَّ غَيْرَهُ مِنْ هَذِهِ الْأَحَادِيثِ  .  وَقَدْ رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيمَا أَمَرَ بِهِ  عَبْدَ اللهِ بْنَ عَمْرٍو  مَا يَدُلُّ عَلَى ذَلِكَ أَيْضًا  .","","Sharh Ma'ani al-Athar 3339","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الوهاب بن عبد المجيد الثقفي عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3135","3340  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ - رَجُلٍ مِنْ  ثَقِيفَ  -  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحَبُّ الصِّيَامِ إِلَى اللهِ عَزَّ وَجَلَّ صِيَامُ  دَاوُدَ  ؛ كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا  .","","Sharh Ma'ani al-Athar 3340","","عبد الله بن عمرو بن العاص عن عمرو بن أوس بن أبي أوس الثقفي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن يونس بن عبد الأعلى عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3136","3341  -  حَدَّثَنَا  بَكْرُ بْنُ إِدْرِيسَ ، قَالَ :  ثَنَا  آدَمُ . (  ح  ) .  3342  -  وَحَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  زِيَادِ بْنِ الْفَيَّاضِ قَالَ :  سَمِعْتُ  أَبَا عِيَاضٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يُحَدِّثُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3341","","عبد الله بن عمرو بن العاص عن مسلم بن نذير الكوفي عن زياد بن فياض الخزاعي عن شعبة بن الحجاج عن روح بن عبادة القيسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3137","3343  -  حَدَّثَنَا  أَبُو بَكْرَةَ وَعَلِيُّ بْنُ شَيْبَةَ ، قَالَا :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ، أَنَّ عَمْرَو بْنَ أَوْسٍ  أَخْبَرَهُ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  أَحَبُّ الصِّيَامِ إِلَى اللهِ عَزَّ وَجَلَّ صِيَامُ  دَاوُدَ  ، وَكَانَ يَصُومُ نِصْفَ الدَّهْرِ  .","","Sharh Ma'ani al-Athar 3343","","عبد الله بن عمرو بن العاص عن عمرو بن أوس بن أبي أوس الثقفي عن عمرو بن دينار الأثرم عن ابن جريج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3138","3344  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ - يَعْنِي إِبْرَاهِيمَ - قَالَ :  ثَنَا  عَفَّانُ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ، قَالَ :  ثَنَا  ثَابِتٌ ،  عَنْ  شُعَيْبِ بْنِ عَبْدِ اللهِ بْنِ عَمْرٍو  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، أَنَّهُ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ – يَعْنِي - فَسَأَلَهُ عَنِ الصِّيَامِ ، فَقَالَ لَهُ :  صُمْ يَوْمًا ، وَلَكَ عَشَرَةُ أَيَّامٍ  .  قَالَ : زِدْنِي يَا رَسُولَ ؛ فَإِنَّ بِي قُوَّةً . قَالَ : "" صُمْ يَوْمَيْنِ وَلَكَ تِسْعَةُ أَيَّامٍ "" .  قَالَ : زِدْنِي يَا رَسُولَ اللهِ ؛ فَإِنَّ بِي قُوَّةً . قَالَ : "" صُمْ ثَلَاثَةَ أَيَّامٍ ، وَلَكَ ثَمَانِيَةُ أَيَّامٍ  .","","Sharh Ma'ani al-Athar 3344","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن ثابت البناني عن حماد بن سلمة عن عفان بن مسلم الصفار عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3139","3345  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  حُسَيْنٌ الْمُعَلِّمُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنْ حَسْبِكَ أَنْ تَصُومَ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ  ، بِكُلِّ حَسَنَةٍ عَشَرَةُ أَمْثَالِهَا ، فَذَلِكَ صَوْمُ الدَّهْرِ كُلِّهِ "" ، فَشَدَدْتُ عَلَى نَفْسِي فَشُدِّدَ عَلَيَّ . فَقُلْتُ : إِنِّي أُطِيقُ غَيْرَ ذَلِكَ ، أَكْثَرَ مِنْ ذَلِكَ .  فَقَالَ : "" صُمْ صَوْمَ نَبِيِّ اللهِ  دَاوُدَ  "" . قُلْتُ : وَمَا صَوْمُ  دَاوُدَ  نَبِيِّ اللهِ .  قَالَ : "" نِصْفُ الدَّهْرِ  .","","Sharh Ma'ani al-Athar 3345","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن حسين المعلم عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3140","3346  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  بِشْرٌ ،  عَنِ  الْأَوْزَاعِيِّ ، قَالَ :  حَدَّثَنِي  يَحْيَى ، فَذَكَرَ  بِإِسْنَادِهِ  ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3346","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن بشر بن بكر التنيسي عن يونس بن عبد الأعلى عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3141","3347  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي حَفْصَةَ ، قَالَ :  ثَنَا  ابْنُ شِهَابٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، وَأَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  بَلَغَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنِّي أَقُولُ : لَأَصُومَنَّ الدَّهْرَ .  فَقَالَ :  صُمْ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ  . قُلْتُ : فَإِنِّي أُطِيقُ أَفْضَلَ مِنْ ذَلِكَ . قَالَ : "" صُمْ يَوْمًا وَأَفْطِرْ يَوْمَيْنِ "" .         [2/86]      قُلْتُ : فَإِنِّي أُطِيقُ أَفْضَلَ مِنْ ذَلِكَ . قَالَ : "" فَصُمْ يَوْمًا وَأَفْطِرْ يَوْمًا ، فَذَلِكَ صَوْمُ  دَاوُدَ  ، وَهُوَ أَعْدَلُ الصِّيَامِ  .","","Sharh Ma'ani al-Athar 3347","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن الزهري عن محمد بن أبي حفصة البصري عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3142","3348  -  حَدَّثَنَا  نَصْرُ بْنُ مَرْزُوقٍ ، وَابْنُ أَبِي دَاوُدَ قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ، أَنَّ سَعِيدًا  أَخْبَرَهُ  وَأَبَا سَلَمَةَ ،  أَنَّ  عَبْدَ اللهِ بْنَ عَمْرٍو قَالَ : أُخْبِرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3348","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن نصر بن مرزوق المصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3143","3349  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ وَفَهْدٌ قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  ابْنُ الْهَادِ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3349","","عبد الله بن عمرو بن العاص عن أبو سلمة بن عبد الرحمن عن محمد بن إبراهيم بن الحارث التيمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن عبد الله بن صالح المصري عن فهد بن سليمان الدلال عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3144","3350  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ وَرَوْحٌ قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  طَلْحَةَ بْنِ هِلَالٍ - أَوْ : هِلَالِ بْنِ طَلْحَةَ  - قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو يَقُولُ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  عَبْدَ اللهِ  صُمْ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ  ؛ مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا "" .  قُلْتُ : إِنِّي أُطِيقُ أَكْثَرَ مِنْ ذَلِكَ . قَالَ : "" صُمْ صَوْمَ  دَاوُدَ  كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا  .","","Sharh Ma'ani al-Athar 3350","","عبد الله بن عمرو بن العاص عن طلحة بن هلال العامري عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن روح بن عبادة القيسي عن نصر بن مرزوق المصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3145","3351  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  مُعَلَّى بْنُ أَسَدٍ ، قَالَ :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ، قَالَ :  ثَنَا  خَالِدٌ الْحَذَّاءُ ، قَالَ :  حَدَّثَنِي  أَبُو قِلَابَةَ ، قَالَ :  حَدَّثَنِي  أَبُو الْمَلِيحِ ، قَالَ :  دَخَلْتُ مَعَ أَبِيكَ  زَيْدِ بْنِ عَمْرٍو  عَلَى عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ،  فَحَدَّثَنَا  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذُكِرَ لَهُ صَوْمُهُ ، قَالَ : فَدَخَلَ عَلَيَّ فَأَلْقَيْتُ لَهُ وِسَادَةً مِنْ أَدَمٍ حَشْوُهَا لِيفٌ ، فَجَلَسَ عَلَى الْأَرْضِ وَقَالَ لِي :  إِنَّمَا يَكْفِيكَ مِنْ كُلِّ شَهْرٍ ثَلَاثَةُ أَيَّامٍ  .  قُلْتُ : يَا رَسُولَ اللهِ ، قَالَ : "" فَخَمْسَةُ أَيَّامٍ "" . قُلْتُ : يَا رَسُولَ اللهِ . قَالَ : "" فَسَبْعَةُ أَيَّامٍ "" . قُلْتُ : يَا رَسُولَ اللهِ . قَالَ : "" فَتِسْعَةُ أَيَّامٍ "" .  قُلْتُ : يَا رَسُولَ اللهِ ، قَالَ : "" فَأَحَدَ عَشَرَ يَوْمًا "" . قُلْتُ : يَا رَسُولَ اللهِ ، قَالَ :  أَظُنُّهُ قَالَ : "" ثَلَاثَةَ عَشَرَ يَوْمًا  "" . قُلْتُ : يَا رَسُولَ اللهِ ، قَالَ : "" لَا صِيَامَ فَوْقَ صِيَامِ  دَاوُدَ  ،  شَطْرُ  الدَّهْرِ ، صِيَامُ يَوْمٍ ، وَإِفْطَارُ يَوْمٍ .","","Sharh Ma'ani al-Athar 3351","","عبد الله بن عمرو بن العاص عن أبو المليح بن أسامة الهذلي عن أبو قلابة الجرمي عن خالد الحذاء عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3146","3352  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ، قَالَ :  ثَنَا  زَائِدَةُ بْنُ قُدَامَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَيْفَ تَصُومُ ؟ "" قُلْتُ : أَصُومُ فَلَا أُفْطِرُ  . قَالَ : "" صُمْ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ "" . قُلْتُ : إِنِّي أَقْوَى مِنْ ذَلِكَ .  قَالَ : فَلَمْ يَزَلْ يُنَاقِصُنِي وَأُنَاقِصُهُ حَتَّى قَالَ : "" فَصُمْ أَحَبَّ الصِّيَامِ إِلَى اللهِ عَزَّ وَجَلَّ ؛ صَوْمَ  دَاوُدَ  : صَوْمَ يَوْمٍ ، وَإِفْطَارَ يَوْمٍ "" .","","Sharh Ma'ani al-Athar 3352","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن زائدة بن قدامة عن عبد الله بن رجاء الغداني عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3147","[2/87]      3353  -  حَدَّثَنَا  أَبُو أُمَيَّةَ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ قَادِمٍ ، قَالَ :  ثَنَا  مِسْعَرٌ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَمْ أُنَبَّأْ أَنَّكَ تَصُومُ الدَّهْرَ وَتَقُومُ اللَّيْلَ  ؟ ""  قَالَ : قُلْتُ : إِنِّي أَقْوَى .  قَالَ : "" إِنَّكَ إِذَا فَعَلْتَ  نَفِهَتْ  لَهُ النَّفْسُ ،  وَهَجَمَتْ  لَهُ الْعَيْنُ "" . قَالَ : قُلْتُ : إِنِّي أَقْوَى . قَالَ : "" فَصُمْ ثَلَاثَةَ أَيَّامٍ مِنْ كُلِّ شَهْرٍ "" . قَالَ : قُلْتُ : إِنِّي أَقْوَى . قَالَ : "" فَصُمْ صَوْمَ أَخِي  دَاوُدَ  ، كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا ، وَلَا يَفِرُّ إِذَا لَاقَى "" .","","Sharh Ma'ani al-Athar 3353","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن مسعر بن كدام عن علي بن قادم الخزاعي عن محمد بن إبراهيم بن مسلم السجستاني عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3148","3354  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ قَالَ :  سَمِعْتُ  أَبَا الْعَبَّاسِ - رَجُلًا مِنْ  أَهْلِ مَكَّةَ  ،  وَكَانَ شَاعِرًا ، وَكَانَ لَا يُتَّهَمُ فِي الْحَدِيثِ  - قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ عَمْرٍو ، فَذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3354","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن شعبة بن الحجاج عن أسد السنة عن يونس بن عبد الأعلى عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3149","3355  -  حَدَّثَنَا  أَبُو أُمَيَّةَ ، قَالَ :  ثَنَا  سُرَيْجٌ ، قَالَ :  ثَنَا  هُشَيْمٌ ، قَالَ :  أَنَا  حُصَيْنٌ وَمُغِيرَةُ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لَهُ :  صُمْ مِنْ كُلِّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ  ، ثُمَّ ذَكَرَ مِثْلَهُ  .","","Sharh Ma'ani al-Athar 3355","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن سريج بن النعمان الجوهري عن محمد بن إبراهيم بن مسلم السجستاني عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3150","3356  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  سَمِعْتُ  غَيْلَانَ بْنَ جَرِيرٍ  يُحَدِّثُ ، عَنْ  عَبْدِ اللهِ بْنِ مَعْبَدٍ الزِّمَّانِيِّ ،  عَنْ  أَبِي قَتَادَةَ ، قَالَ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَمَّنْ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا  . قَالَ : "" ذَاكَ صَوْمُ  دَاوُدَ  "" . قَالَ : يَا رَسُولَ اللهِ ، فَكَيْفَ مَنْ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمَيْنِ ؟ قَالَ : "" وَدِدْتُ أَنِّي  طُوِّقْتُ  عَلَى ذَلِكَ  .  فَلَمَّا أَبَاحَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي هَذِهِ الْآثَارِ الْمُتَوَاتِرَةِ صَوْمَ يَوْمٍ وَإِفْطَارَ يَوْمٍ مِنْ سَائِرِ الدَّهْرِ ، دَلَّ ذَلِكَ أَنَّ صَوْمَ مَا بَعْدَ النِّصْفِ مِنْ شَعْبَانَ مِمَّا قَدْ دَخَلَ فِي إِبَاحَةِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَبْدِ اللهِ بْنِ عَمْرٍو  ، وَهَذَا قَوْلُ  أَبِي حَنِيفَةَ  ،  وَأَبِي يُوسُفَ  ،  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى  .","","Sharh Ma'ani al-Athar 3356","","أبو قتادة الأنصاري فارس رسول الله عن عبد الله بن معبد الزماني عن غيلان بن جرير المعولي عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصوم بعد النصف من شعبان إلى رمضان"
"3151","[2/88]      10 - بَابُ الْقُبْلَةِ لِلصَّائِمِ  3357  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ، قَالَ :  ثَنَا  إِسْرَائِيلُ ،  عَنْ  زَيْدِ بْنِ جُبَيْرٍ ،  عَنْ  أَبِي يَزِيدَ الضِّنِّيِّ ،  عَنْ  مَيْمُونَةَ بِنْتِ سَعْدٍ ، قَالَتْ :  سُئِلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْقُبْلَةِ لِلصَّائِمِ ، فَقَالَ : "" أَفْطَرَا جَمِيعًا  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى هَذَا ، فَقَالُوا : لَيْسَ لِلرَّجُلِ أَنْ يُقَبِّلَ فِي صَوْمِهِ ، وَإِنْ قَبَّلَ فَقَدْ أَفْطَرَ  .  وَاحْتَجُّوا فِي ذَلِكَ أَيْضًا بِمَا .","","Sharh Ma'ani al-Athar 3357","","ميمونة بنت سعد خادمة النبي عن أبو يزيد الضني عن زيد بن جبير الطائي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن عبد الله بن الزبير عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب القبلة للصائم"
"3152","3358  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ ، قَالَ :  قُلْتُ  لِأَبِي أُسَامَةَ :  أَحَدَّثَكُمْ  عُمَرُ بْنُ حَمْزَةَ ؟ قَالَ :  أَخْبَرَنِي  سَالِمٌ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  قَالَ  عُمَرُ  :  رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَنَامِ ، فَرَأَيْتُهُ لَا يَنْظُرُنِي  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا شَأْنِي ؟ قَالَ : "" أَلَسْتَ الَّذِي تُقَبِّلُ وَأَنْتَ صَائِمٌ "" . فَقُلْتُ : وَالَّذِي بَعَثَكَ بِالْحَقِّ إِنِّي لَا أُقَبِّلُ بَعْدَ هَذَا وَأَنَا صَائِمٌ ، فَأَقَرَّ بِهِ ، ثُمَّ قَالَ : "" نَعَمْ  "" .  وَاحْتَجُّوا فِي ذَلِكَ أَيْضًا بِمَا رُوِيَ عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  رَضِيَ اللهُ عَنْهُ  .","","Sharh Ma'ani al-Athar 3358","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمر بن حمزة بن عبد الله بن عمر بن الخطاب عن حماد بن أسامة القرشي عن إسحاق ابن راهويه عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب القبلة للصائم"
"3153","3359  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  هَانِئٍ ، وَكَانَ يُسَمَّى الْهَزْهَازَ ، قَالَ :  سُئِلَ  عَبْدُ اللهِ ، عَنِ الْقُبْلَةِ لِلصَّائِمِ ، فَقَالَ : ( يَقْضِي يَوْمًا آخَرَ  )  .","","Sharh Ma'ani al-Athar 3359","","عبد الله بن مسعود عن هانئ بن الهزهاز عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب القبلة للصائم"
"3154","3360  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  مُؤَمَّلٌ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالٍ ،  عَنِ  الْهَزْهَازِ ،  عَنْ  عَبْدِ اللهِ ، مِثْلَهُ .  وَاحْتَجُّوا فِي ذَلِكَ أَيْضًا بِمَا رُوِيَ ، عَنْ  عُمَرَ  مِنْ قَوْلِهِ :","","Sharh Ma'ani al-Athar 3360","","عبد الله بن مسعود عن هانئ بن الهزهاز عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن بكار بن قتيبة البكراوي عن الطحاوي","باب القبلة للصائم"
"3155","3361  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَنَّ  عُمَرَ كَانَ يَنْهَى ، عَنِ الْقُبْلَةِ لِلصَّائِمِ  .","","Sharh Ma'ani al-Athar 3361","","عمر بن الخطاب عن سعيد بن المسيب عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن عثمان بن عمر بن فارس عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب القبلة للصائم"
"3156","3362  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  عِمْرَانَ بْنِ مُسْلِمٍ ،  عَنْ  زَاذَانَ ، قَالَ :  قَالَ  عُمَرُ :  لَأَنْ أَعَضَّ عَلَى جَمْرَةٍ أَحَبُّ إِلَيَّ مِنْ أَنْ أُقَبِّلَ وَأَنَا صَائِمٌ  .  وَاحْتَجُّوا فِي ذَلِكَ أَيْضًا بِمَا رُوِيَ ، عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  .","","Sharh Ma'ani al-Athar 3362","","عمر بن الخطاب عن زاذان الكندي عن عمران بن مسلم الجعفي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب القبلة للصائم"
"3157","3363  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  فِي الرَّجُلِ يُقَبِّلُ امْرَأَتَهُ وَهُوَ صَائِمٌ ، فَقَالَ : يُنْقَضُ صَوْمُهُ  .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَلَمْ يَرَوْا بِالْقُبْلَةِ لِلصَّائِمِ بَأْسًا إِذَا لَمْ يُخَفْ مِنْهَا أَنْ تَدْعُوَهُ إِلَى غَيْرِهَا ، مِمَّا يُمْنَعُ مِنْهُ الصَّائِمُ .         [2/89]      وَكَانَ مِنْ حُجَّتِهِمْ فِيمَا احْتَجَّ بِهِ عَلَيْهِمْ أَهْلُ الْمَقَالَةِ الْأُولَى ، أَنَّهُ قَدْ رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي إِبَاحَتِهِ الْقُبْلَةَ لِلصَّائِمِ مَا هُوَ أَظْهَرُ مِنْ حَدِيثِ  مَيْمُونَةَ بِنْتِ سَعْدٍ  ، وَأَوْلَى أَنْ يُؤْخَذَ بِهِ  .  وَهُوَ مَا .","","Sharh Ma'ani al-Athar 3363","","سعيد بن المسيب عن عبد الكريم الاصطخري عن موسى بن أعين الجزري عن علي بن معبد العبدي عن محمد بن حميد بن هشام الرعيني عن الطحاوي","باب القبلة للصائم"
"3158","3364  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  شُعَيْبُ بْنُ اللَّيْثِ ، قَالَ :  ثَنَا  اللَّيْثُ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ سَعِيدٍ الْأَنْصَارِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ، أَنَّهُ قَالَ :  هَشِشْتُ  يَوْمًا ، فَقَبَّلْتُ وَأَنَا صَائِمٌ ، فَأَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : فَعَلْتُ الْيَوْمَ أَمْرًا عَظِيمًا ؛ قَبَّلْتُ وَأَنَا صَائِمٌ .  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَرَأَيْتَ لَوْ تَمَضْمَضْتَ بِمَاءٍ وَأَنْتَ صَائِمٌ  ؟ "" فَقُلْتُ : لَا بَأْسَ بِذَلِكَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَفِيمَ . ؟","","Sharh Ma'ani al-Athar 3364","","عمر بن الخطاب عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الملك بن سعيد بن سويد الأنصاري عن بكير بن عبد الله بن الأشج القرشي عن الليث بن سعد عن شعيب بن الليث المصري عن الربيع بن سليمان المرادي عن الطحاوي","باب القبلة للصائم"
"3159","3365  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  شَبَابَةُ بْنُ سَوَّارٍ ، قَالَ :  أَنَا  لَيْثُ بْنُ سَعْدٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَهَذَا الْحَدِيثُ  صَحِيحُ الْإِسْنَادِ  مَعْرُوفٌ لِلرُّوَاةِ ، وَلَيْسَ كَحَدِيثِ  مَيْمُونَةَ بِنْتِ سَعْدٍ  الَّذِي رَوَاهُ عَنْهَا  أَبُو يَزِيدَ الضَّبِّيُّ  ، وَهُوَ رَجُلٌ لَا يُعْرَفُ ، فَلَا يَنْبَغِي أَنْ يُعَارَضَ حَدِيثُ مَنْ ذَكَرْنَا بِحَدِيثِ مِثْلِهِ ، مَعَ أَنَّهُ قَدْ يَجُوزُ أَنْ يَكُونَ حَدِيثُهُ ذَلِكَ عَلَى مَعْنًى خِلَافِ مَعْنَى حَدِيثِ  عُمَرَ  هَذَا ، وَيَكُونُ جَوَابُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّذِي فِيهِ جَوَابًا لِسُؤَالٍ سُئِلَ فِي صَائِمَيْنِ بِأَعْيَانِهِمَا عَلَى قِلَّةِ ضَبْطِهِمَا لِأَنْفُسِهِمَا ، فَقَالَ ذَلِكَ فِيهِمَا ، أَيْ : أَنَّهُ إِذَا كَانَتِ الْقُبْلَةُ مِنْهُمَا ، فَقَدْ كَانَ مَعَهَا غَيْرُهَا مِمَّا قَدْ يَضُرُّهُمَا .  وَهَذَا أَوْلَى مِمَّا حُمِلَ عَلَيْهِ مَعْنَاهُ حَتَّى لَا يُضَادَّ غَيْرَهُ .  وَأَمَّا حَدِيثُ  عُمَرَ بْنِ حَمْزَةَ  فَلَيْسَ أَيْضًا  إِسْنَادُهُ  كَحَدِيثِ  بُكَيْرٍ  الَّذِي قَدْ ذَكَرْنَا ؛ لِأَنَّ  عُمَرَ بْنَ حَمْزَةَ  لَيْسَ مِثْلَ  بُكَيْرِ بْنِ عَبْدِ اللهِ  فِي جَلَالَتِهِ وَمَوْضِعِهِ مِنَ الْعِلْمِ وَإِتْقَانِهِ مَعَ أَنَّهُمَا لَوْ تَكَافَآ لَكَانَ حَدِيثُ  بُكَيْرٍ  أَوْلَاهُمَا ؛ لِأَنَّهُ قَوْلٌ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْيَقَظَةِ ، وَذَلِكَ قَوْلٌ قَدْ قَامَتْ بِهِ الْحُجَّةُ عَلَى  عُمَرَ  ، وَحَدِيثُ  عُمَرَ بْنِ حَمْزَةَ  إِنَّمَا هُوَ عَلَى قَوْلٍ حَكَاهُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي النَّوْمِ ، وَذَلِكَ مِمَّا لَا تَقُومُ بِهِ الْحُجَّةُ ، فَمَا تَقُومُ بِهِ الْحُجَّةُ أَوْلَى مِمَّا لَا تَقُومُ بِهِ الْحُجَّةُ  .  ثُمَّ هَذَا  ابْنُ عُمَرَ  قَدْ حَدَّثَ عَنْ أَبِيهِ بِمَا حَكَاهُ  عُمَرُ بْنُ حَمْزَةَ  فِي حَدِيثِهِ ، ثُمَّ قَالَ بَعْدَ أَبِيهِ بِخِلَافِ ذَلِكَ  .","","Sharh Ma'ani al-Athar 3365","","عمر بن الخطاب عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الملك بن سعيد بن سويد الأنصاري عن بكير بن عبد الله بن الأشج القرشي عن الليث بن سعد عن شبابة بن سوار المدائني عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب القبلة للصائم"
"3160","3366  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  أَبِي حَمْزَةَ ،  عَنْ  مُوَرِّقٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ سُئِلَ عَنِ الْقُبْلَةِ لِلصَّائِمِ ، فَأَرْخَصَ فِيهَا لِلشَّيْخِ ، وَكَرِهَهَا لِلشَّابِّ  ،  فَدَلَّ ذَلِكَ أَنَّ هَذَا كَانَ - عِنْدَهُ - أَوْلَى مِمَّا حَدَّثَهُ بِهِ  عُمَرُ  ، مِمَّا ذَكَرَهُ  عُمَرُ بْنُ حَمْزَةَ  فِي حَدِيثِهِ .         [2/90]      وَأَمَّا مَا قَدِ احْتَجُّوا بِهِ مِنْ قَوْلِ  ابْنِ مَسْعُودٍ  رَضِيَ اللهُ عَنْهُ ، فَإِنَّهُ قَدْ رُوِيَ عَنْهُ أَيْضًا خِلَافُ ذَلِكَ  .","","Sharh Ma'ani al-Athar 3366","","عبد الله بن عمر بن الخطاب عن مورق العجلي عن ميمون القصاب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب القبلة للصائم"
"3161","3367  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  إِسْرَائِيلُ ،  عَنْ  طَارِقٍ ،  عَنْ  حَكِيمِ بْنِ جَابِرٍ ، قَالَ :  كَانَ ابْنُ مَسْعُودٍ رَضِيَ اللهُ عَنْهُ يُبَاشِرُ امْرَأَتَهُ وَهُوَ صَائِمٌ  .  فَقَدْ تَكَافَأَ هَذَا الْحَدِيثُ وَمَا رَوَى  الْهَزْهَازُ  عَنْ  عَبْدِ اللهِ  ، وَأَمَّا مَا ذَكَرُوهُ مِنْ قَوْلِ  سَعِيدٍ - يَعْنِي ابْنَ الْمُسَيِّبِ  - أَنَّهُ يُنْقَضُ صَوْمُهُ ؛ فَإِنَّ مَا رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ تَشْبِيهِهِ ذَلِكَ بِالْمَضْمَضَةِ أَوْلَى مِنْ قَوْلِ  سَعِيدٍ  ، ثُمَّ قَالَ بِذَلِكَ جَمَاعَةٌ مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، مِمَّا سَنَذْكُرُ ذَلِكَ عَنْهُمْ فِي آخِرِ هَذَا الْبَابِ ، إِنْ شَاءَ اللهُ .  وَقَدْ جَاءَتِ الْآثَارُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُتَوَاتِرَةً  بِأَنَّهُ كَانَ يُقَبِّلُ وَهُوَ صَائِمٌ .  فَمِنْ ذَلِكَ مَا .","","Sharh Ma'ani al-Athar 3367","","عبد الله بن مسعود عن حكيم بن جابر الأحمسي عن طارق بن عبد الرحمن البجلي عن إسرائيل بن يونس بن أبي إسحاق عن الفضل بن دكين عن فهد بن سليمان الدلال عن الطحاوي","باب القبلة للصائم"
"3162","3368  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَطَاءٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ شَقِيقٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصِيبُ مِنَ الرُّءُوسِ وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3368","","عبد الله بن عباس عن عبد الله بن شقيق العقيلي عن أيوب السختياني عن سعيد بن أبي عروبة عن عبد الوهاب بن عطاء الخفاف عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب القبلة للصائم"
"3163","3369  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  عَيَّاشٌ الرَّقَّامُ ، قَالَ :  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  أَيُّوبَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ شَقِيقٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ . فَمَا دَرَيْتُ مَا هُوَ حَتَّى قِيلَ : الْقُبْلَةُ .","","Sharh Ma'ani al-Athar 3369","","عبد الله بن عباس عن عبد الله بن شقيق العقيلي عن أيوب السختياني عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن عياش بن الوليد الرقام عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب القبلة للصائم"
"3164","3370  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْوَهْبِيُّ - هُوَ أَحْمَدُ بْنُ خَالِدٍ - قَالَ :  ثَنَا  شَيْبَانُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ قَالَ :  أَخْبَرَنِي  أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُقَبِّلُهَا وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3370","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن أحمد بن خالد بن موسى الوهبي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب القبلة للصائم"
"3165","3371  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  هِشَامُ بْنُ أَبِي عَبْدِ اللهِ ،  عَنْ  يَحْيَى ،  عَنْ  أَبِي سَلَمَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3371","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن روح بن عبادة القيسي عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب القبلة للصائم"
"3166","3372  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  شُعَيْبُ بْنُ اللَّيْثِ ، قَالَ :  ثَنَا  اللَّيْثُ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي بَكْرِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ  ، أَنَّهَا قَالَتْ :  قَبَّلَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3372","","هند بنت أبي أمية زوج رسول الله عن زينب بنت أبي سلمة المخزومية عن أبو سلمة بن عبد الرحمن عن أبو بكر بن المنكدر بن عبد الله التيمي عن بكير بن عبد الله بن الأشج القرشي عن الليث بن سعد عن شعيب بن الليث المصري عن الربيع بن سليمان المرادي عن الطحاوي","باب القبلة للصائم"
"3167","3373  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  أَنَا  طَلْحَةُ بْنُ يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ فَرُّوخَ ، قَالَ :  أَتَتْ أُمَّ سَلَمَةَ  امْرَأَةٌ  ، فَقَالَتْ : إِنَّ زَوْجِي يُقَبِّلُنِي وَأَنَا صَائِمَةٌ .  فَقَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُنِي وَهُوَ صَائِمٌ وَأَنَا صَائِمَةٌ .","","Sharh Ma'ani al-Athar 3373","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن فروخ مولى آل طلحة بن عبيد الله عن طلحة بن يحيى بن طلحة التيمي عن عبيد الله بن موسى عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب القبلة للصائم"
"3168","3374  -  حَدَّثَنَا  أَبُو بِشْرٍ الرَّقِّيُّ ، قَالَ :  ثَنَا  أَبُو مُعَاوِيَةَ الضَّرِيرُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  شُتَيْرِ بْنِ شَكَلٍ ،  عَنْ  حَفْصَةَ بِنْتِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنَّهُ قَبَّلَ وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3374","","حفصة بنت عمر بن الخطاب عن شتير بن شكل العبسي عن مسلم بن صبيح الهمداني عن الأعمش عن أبو معاوية الضرير عن عبد الملك بن مروان الأهوازي عن الطحاوي","باب القبلة للصائم"
"3169","[2/91]      3375  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُسْلِمٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3375","","حفصة بنت عمر بن الخطاب عن شتير بن شكل العبسي عن مسلم بن صبيح الهمداني عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب القبلة للصائم"
"3170","3376  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  ابْنُ أَبِي مَرْيَمَ ، قَالَ :  أَخْبَرَنِي  ابْنُ أَبِي الزِّنَادِ ، قَالَ :  حَدَّثَنِي  أَبِي  ، أَنَّ عَلِيَّ بْنَ الْحُسَيْنِ  أَخْبَرَهُ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُقَبِّلُهَا وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3376","","عائشة بنت أبي بكر الصديق عن علي بن الحسين زين العابدين عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن الحكم الجمحي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب القبلة للصائم"
"3171","3377  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ الْحُسَيْنِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3377","","عائشة بنت أبي بكر الصديق عن علي بن الحسين زين العابدين عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب القبلة للصائم"
"3172","3378  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  هَارُونُ بْنُ إِسْمَاعِيلَ الْخَزَّازُ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ ، قَالَ :  ثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَرُوبَةَ بْنِ الزُّبَيْرِ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، مِثْلَهُ .  كذا في طبعة عالم الكتب ، والصواب : ( عروة ) .","","Sharh Ma'ani al-Athar 3378","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن علي بن المبارك الهنائي عن هارون بن إسماعيل الخزاز عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب القبلة للصائم"
"3173","3379  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  عَبْدُ الْوَهَّابِ ، قَالَ :  أَنَا  سَعِيدٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3379","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سعيد بن أبي عروبة عن عبد الوهاب بن عطاء الخفاف عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب القبلة للصائم"
"3174","3380  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  هِشَامٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3380","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب القبلة للصائم"
"3175","3381  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  شُجَاعُ بْنُ الْوَلِيدِ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ، قَالَ :  حَدَّثَنِي  الْقَاسِمُ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، مِثْلَهُ . وَزَادَ : (  وَكَانَتْ تَقُولُ :  وَأَيُّكُمْ أَمْلَكُ  لِأَرَبِهِ  مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ؟  )","","Sharh Ma'ani al-Athar 3381","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبيد الله بن عمر العمري عن شجاع بن الوليد السكوني عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب القبلة للصائم"
"3176","3382  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ يَحْيَى الْمُزَنِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ إِدْرِيسَ الشَّافِعِيُّ ، قَالَ :  ثَنَا  سُفْيَانُ ، قَالَ :  قُلْتُ  لِعَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ  :  أَحَدَّثَكَ  أَبُوكَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يُقَبِّلُهَا وَهُوَ صَائِمٌ  ؟ قَالَ : فَطَأْطَأَ (  أَيْ : خَفَضَ  ) رَأْسَهُ ، وَاسْتَحْيَى قَلِيلًا وَسَكَتَ ، ثُمَّ قَالَ : ( نَعَمْ ) .","","Sharh Ma'ani al-Athar 3382","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن سفيان بن عيينة عن الشافعي عن إسماعيل بن يحيى المزني عن الطحاوي","باب القبلة للصائم"
"3177","3383  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ - هُوَ ابْنُ مَيْمُونٍ الْبَغْدَادِيُّ - قَالَ :  ثَنَا  الْوَلِيدُ - هُوَ ابْنُ مُسْلِمٍ - قَالَ :  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  يَحْيَى ، قَالَ :  حَدَّثَنِي  أَبُو سَلَمَةَ :  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُقَبِّلُهَا وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3383","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن محمد بن عبد الله بن ميمون السكري عن الطحاوي","باب القبلة للصائم"
"3178","3384  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  بِشْرٌ - هُوَ ابْنُ بَكْرٍ - قَالَ :  ثَنَا  الْأَوْزَاعِيُّ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3384","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن بشر بن بكر التنيسي عن يونس بن عبد الأعلى عن الطحاوي","باب القبلة للصائم"
"3179","3385  -  حَدَّثَنَا  نَصْرُ بْنُ مَرْزُوقٍ وَابْنُ أَبِي دَاوُدَ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  أَخْبَرَنِي  أَبُو سَلَمَةَ ،  أَنَّ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ ، فَذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3385","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب القبلة للصائم"
"3180","3386  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  عَيَّاشٌ الرَّقَّامُ ، قَالَ :  ثَنَا  عَبْدُ الْأَعْلَى ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  جَمَعَ لِي أَبِي أَهْلِي فِي رَمَضَانَ ، فَأَدْخَلَهُمْ عَلَيَّ ،         [2/92]      فَدَخَلْتُ عَلَى  عَائِشَةَ رَضِيَ اللهُ عَنْهَا فَسَأَلْتُهَا عَنِ الْقُبْلَةِ -  يَعْنِي - لِلصَّائِمِ  ، فَقَالَتْ :  لَيْسَ بِذَلِكَ بَأْسٌ ؛ قَدْ كَانَ مَنْ هُوَ خَيْرُ النَّاسِ يُقَبِّلُ  .","","Sharh Ma'ani al-Athar 3386","","عائشة بنت أبي بكر الصديق عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن عياش بن الوليد الرقام عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب القبلة للصائم"
"3181","3387  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَسَدٍ ، قَالَ :  ثَنَا  يَحْيَى بْنُ حَسَّانَ ،  عَنِ  اللَّيْثِ بْنِ سَعْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُقَبِّلُ وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3387","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن الليث بن سعد عن يحيى بن حسان بن حيان التنيسي عن سعيد بن أسد بن موسى المصري عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب القبلة للصائم"
"3182","3388  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  طَلْحَةَ بْنِ عُبَيْدِ اللهِ بْنِ مَعْمَرٍ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، أَنَّهَا قَالَتْ :  أَرَادَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُقَبِّلَنِي ، فَقُلْتُ : إِنِّي صَائِمَةٌ  ، فَقَالَ : وَأَنَا صَائِمٌ ، فَقَبَّلَنِي  .","","Sharh Ma'ani al-Athar 3388","","عائشة بنت أبي بكر الصديق عن طلحة بن عبد الله بن عثمان التيمي عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب القبلة للصائم"
"3183","3389  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  عُمَرُ بْنُ أَبِي زَائِدَةَ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  مَا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَمْتَنِعُ مِنْ وُجُوهِنَا وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3389","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن عمر بن أبي زائدة الهمداني عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب القبلة للصائم"
"3184","3390  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ، قَالَ :  انْطَلَقْتُ أَنَا  وَعَبْدُ اللهِ بْنُ مَسْعُودٍ  إِلَى عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، نَسْأَلُهَا عَنِ الْمُبَاشَرَةِ ، ثُمَّ خَرَجْنَا وَلَمْ نَسْأَلْهَا .  فَرَجَعْنَا فَقُلْنَا : يَا أُمَّ الْمُؤْمِنِينَ ، أَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُبَاشِرُ وَهُوَ صَائِمٌ ؟ قَالَتْ :  نَعَمْ ، وَكَانَ أَمْلَكَكُمْ  لِأَرَبِهِ  .  فَسُؤَالُ  عَبْدِ اللهِ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا عَنْ هَذَا دَلِيلٌ عَلَى أَنَّهُ لَمْ يَكُنْ عِنْدَهُ فِي ذَلِكَ شَيْءٌ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، حَتَّى أَخْبَرَتْهُ بِهِ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا عَنْهُ .  فَدَلَّ ذَلِكَ عَلَى أَنَّ مَا رُوِيَ عَنْهُ مِمَّا قَدْ وَافَقَ ذَلِكَ كَانَ مُتَأَخِّرًا عَمَّا رُوِيَ عَنْهُ مِمَّا خَالَفَ ذَلِكَ  .","","Sharh Ma'ani al-Athar 3390","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن عبد الله بن عون بن أرطبان عن أبو عاصم النبيل عن بكار بن قتيبة البكراوي عن الطحاوي","باب القبلة للصائم"
"3185","3391  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ وَمَسْرُوقٍ قَالَا :  سَأَلْنَا  عَائِشَةَ رَضِيَ اللهُ عَنْهَا : أَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُبَاشِرُ وَهُوَ صَائِمٌ ؟         [2/93]      فَقَالَتْ :  نَعَمْ ، وَلَكِنَّهُ كَانَ أَمْلَكَ  لِأَرَبِهِ  مِنْكُمَا ، أَوْ لِأَمْرِهِ  .  الشَّكُّ مِنْ  أَبِي عَاصِمٍ  .","","Sharh Ma'ani al-Athar 3391","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن إبراهيم النخعي عن عبد الله بن عون بن أرطبان عن أبو عاصم النبيل عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب القبلة للصائم"
"3186","3392  -  حَدَّثَنَا  أَبُو بِشْرٍ الرَّقِّيُّ ، قَالَ :  ثَنَا  شُجَاعٌ ،  عَنْ  حُرَيْثِ بْنِ عَمْرٍو ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  رُبَّمَا قَبَّلَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَبَاشَرَنِي  وَهُوَ صَائِمٌ  ، وَأَمَّا أَنْتُمْ فَلَا بَأْسَ بِهِ لِلشَّيْخِ الْكَبِيرِ الضَّعِيفِ  .","","Sharh Ma'ani al-Athar 3392","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الشعبي عن حريث بن أبي مطر الفزاري عن شجاع بن الوليد السكوني عن عبد الملك بن مروان الأهوازي عن الطحاوي","باب القبلة للصائم"
"3187","3393  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  شَيْبَانُ أَبُو مُعَاوِيَةَ ،  عَنْ  زِيَادِ بْنِ عِلَاقَةَ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ - هُوَ الْأَوْدِيُّ - قَالَ :  سَأَلْنَا  عَائِشَةَ ، عَنِ الرَّجُلِ يُقَبِّلُ وَهُوَ صَائِمٌ ، فَقَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُ وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3393","","عائشة بنت أبي بكر الصديق عن عمرو بن ميمون الأودي عن زياد بن علاقة الثعلبي عن شيبان بن عبد الرحمن المؤدب عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب القبلة للصائم"
"3188","3394  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ، قَالَ :  ثَنَا  إِسْرَائِيلُ ،  عَنْ  زِيَادٍ ،  عَنْ  عَمْرِو بْنِ مَيْمُونٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُنِي وَأَنَا صَائِمَةٌ  .","","Sharh Ma'ani al-Athar 3394","","عائشة بنت أبي بكر الصديق عن عمرو بن ميمون الأودي عن زياد بن علاقة الثعلبي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب القبلة للصائم"
"3189","3395  -  حَدَّثَنَا  صَالِحُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْمُقْرِئُ ، قَالَ :  ثَنَا  مُوسَى بْنُ عُلَيٍّ ، قَالَ :  سَمِعْتُ  أَبِي  يَقُولُ :  حَدَّثَنِي  أَبُو قَيْسٍ مَوْلَى عَمْرِو بْنِ الْعَاصِ ، قَالَ :  بَعَثَنِي  عَبْدُ اللهِ بْنُ عَمْرٍو  إِلَى أُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : سَلْهَا :  أَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُ وَهُوَ صَائِمٌ  ؟ فَإِنْ قَالَتْ : لَا ، فَقُلْ : إِنَّ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا تُخْبِرُ النَّاسَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يُقَبِّلُ وَهُوَ صَائِمٌ .  فَأَتَيْتُ  أُمَّ سَلَمَةَ  رَضِيَ اللهُ عَنْهَا فَأَبْلَغْتُهَا السَّلَامَ ، عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  وَقُلْتُ : أَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُ وَهُوَ صَائِمٌ ؟ فَقَالَتْ : لَا . فَقُلْتُ : إِنَّ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا تُخْبِرُ النَّاسَ أَنَّهُ كَانَ يُقَبِّلُ وَهُوَ صَائِمٌ ، فَقَالَتْ : لَعَلَّهُ أَنَّهُ لَمْ يَكُنْ يَتَمَالَكُ عَنْهَا حُبًّا ، أَمَّا إِيَّايَ فَلَا  .  وَقَدْ  تَوَاتَرَتْ  هَذِهِ الْآثَارُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ كَانَ يُقَبِّلُ وَهُوَ صَائِمٌ ، فَدَلَّ ذَلِكَ أَنَّ الْقُبْلَةَ غَيْرُ مُفَطِّرَةٍ لِلصَّائِمِ ، فَإِنْ قَالَ قَائِلٌ : كَانَ ذَلِكَ مِمَّا قَدْ  خُصَّ  بِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَلَا تَرَى إِلَى قَوْلِ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا : ( وَأَيُّكُمْ كَانَ أَمْلَكَ  لِأَرَبِهِ  مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ ) قِيلَ لَهُ : إِنَّ قَوْلَ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا هَذَا ، إِنَّمَا هُوَ عَلَى أَنَّهَا لَا تَأْمَنُ عَلَيْهِمْ ، وَلَا يَأْمَنُونَ عَلَى أَنْفُسِهِمْ ، مَا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْمَنُهُ عَلَى نَفْسِهِ ؛ لِأَنَّهُ كَانَ مَحْفُوظًا ، وَالدَّلِيلُ عَلَى أَنَّ الْقُبْلَةَ عِنْدَهَا لَا تُفَطِّرُ الصَّائِمَ مَا قَدْ رُوِّينَا عَنْهَا أَنَّهَا قَالَتْ : ( فَأَمَّا أَنْتُمْ فَلَا بَأْسَ بِهِ لِلشَّيْخِ الْكَبِيرِ الضَّعِيفِ ) . أَرَادَتْ بِذَلِكَ أَنَّهُ لَا يُخَافُ مِنْ أَرَبِهِ . فَدَلَّ ذَلِكَ عَلَى أَنَّ مَنْ لَمْ يَخَفْ مِنَ الْقُبْلَةِ وَهُوَ صَائِمٌ شَيْئًا آخَرَ ، وَأَمِنَ عَلَى نَفْسِهِ أَنَّهَا لَهُ مُبَاحَةٌ ، وَقَدْ ذَكَرْنَا عَنْهَا فِي بَعْضِ هَذِهِ الْآثَارِ أَنَّهَا سُئِلَتْ عَنِ الْقُبْلَةِ لِلصَّائِمِ ، فَقَالَتْ - جَوَابًا لِذَلِكَ السُّؤَالِ : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُ وَهُوَ صَائِمٌ .         [2/94]      فَلَوْ كَانَ حُكْمُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ عِنْدَهَا خِلَافَ حُكْمِ غَيْرِهِ مِنَ النَّاسِ إِذًا لَمَا كَانَ مَا عَلِمَتْهُ مِنْ فِعْلِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَوَابًا لِمَا سُئِلَتْ عَنْهُ مِنْ فِعْلِ غَيْرِهِ ، وَقَدْ سَأَلَهَا  عَبْدُ اللهِ بْنُ عُمَرَ  لَمَّا جَمَعَ لَهُ أَبُوهُ أَهْلَهُ فِي شَهْرِ رَمَضَانَ عَنْ مِثْلِ ذَلِكَ ، فَقَالَتْ : ( كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُ ذَلِكَ ) .  وَهَذَا عِنْدَنَا ؛ لِأَنَّهَا كَانَتْ تَأْمَنُ عَلَيْهِ ، فَدَلَّ مَا ذَكَرْنَا عَلَى اسْتِوَاءِ حُكْمِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَسَائِرِ النَّاسِ - عِنْدَهَا - فِي حُكْمِ الْقُبْلَةِ إِذَا لَمْ يَكُنْ مَعَهَا الْخَوْفُ عَلَى مَا بَعْدَهَا مِمَّا تَدْعُو إِلَيْهِ ، وَهُوَ أَيْضًا فِي النَّظَرِ كَذَلِكَ ؛ لِأَنَّا قَدْ رَأَيْنَا الْجِمَاعَ وَالطَّعَامَ وَالشَّرَابَ قَدْ كَانَ ذَلِكَ كُلُّهُ حَرَامًا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي صِيَامِهِ كَمَا هُوَ حَرَامٌ عَلَى سَائِرِ أُمَّتِهِ فِي صِيَامِهِمْ ، ثُمَّ هَذِهِ الْقُبْلَةُ قَدْ كَانَتْ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَلَالًا فِي صِيَامِهِ ، فَالنَّظَرُ عَلَى مَا ذَكَرْنَا أَنْ يَكُونَ أَيْضًا حَلَالًا لِسَائِرِ أُمَّتِهِ فِي صِيَامِهِمْ أَيْضًا ، وَيَسْتَوِي حُكْمُهُ وَحُكْمُهُمْ فِيهَا ، كَمَا يَسْتَوِي فِي سَائِرِ مَا ذَكَرْنَا .  وَقَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَيْضًا مَا يَدُلُّ عَلَى اسْتِوَاءِ حُكْمِهِ وَحُكْمِ أُمَّتِهِ فِي ذَلِكَ  مَا .","","Sharh Ma'ani al-Athar 3395","","هند بنت أبي أمية زوج رسول الله عن عبد الرحمن بن ثابت السهمي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن عبد الله بن يزيد القصير عن صالح بن عبد الرحمن المصري عن الطحاوي","باب القبلة للصائم"
"3190","3396  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  أَنَّ  رَجُلًا قَبَّلَ امْرَأَتَهُ وَهُوَ صَائِمٌ فَوَجَدَ مِنْ ذَلِكَ وَجْدًا شَدِيدًا ، فَأَرْسَلَ امْرَأَتَهُ تَسْأَلُ لَهُ عَنْ ذَلِكَ ، فَدَخَلَتْ عَلَى أُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَتْ ذَلِكَ لَهَا ، فَأَخْبَرَتْهَا  أُمُّ سَلَمَةَ  رَضِيَ اللهُ عَنْهَا أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يُقَبِّلُ وَهُوَ صَائِمٌ ، فَرَجَعَتْ فَأَخْبَرَتْ بِذَلِكَ زَوْجَهَا فَزَادَهُ شَرًّا ، وَقَالَ : لَسْنَا مِثْلَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يُحِلُّ اللهُ عَزَّ وَجَلَّ لِرَسُولِهِ مَا شَاءَ ، ثُمَّ رَجَعَتِ الْمَرْأَةُ إِلَى  أُمِّ سَلَمَةَ  رَضِيَ اللهُ عَنْهَا فَوَجَدَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَهَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا بَالُ هَذِهِ الْمَرْأَةِ ؟ "" فَأَخْبَرَتْهُ  أُمُّ سَلَمَةَ  ، فَقَالَ : "" أَلَا أَخْبَرْتِيهَا أَنِّي أَفْعَلُ ذَلِكَ "" .  فَقَالَتْ  أُمُّ سَلَمَةَ  رَضِيَ اللهُ عَنْهَا : قَدْ أَخْبَرْتُهَا فَذَهَبَتْ إِلَى زَوْجِهَا فَأَخْبَرَتْهُ ، فَزَادَهُ شَرًّا ، وَقَالَ : يُحِلُّ اللهُ لِرَسُولِهِ مَا شَاءَ ، فَغَضِبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَالَ :  إِنِّي لَأَتْقَاكُمْ لِلهِ عَزَّ وَجَلَّ ، وَأَعْلَمُكُمْ بِحُدُودِهِ  .         [2/95]      فَدَلَّ ذَلِكَ عَلَى مَا ذَكَرْنَا ، فَهَذَا وَجْهُ هَذَا الْبَابِ مِنْ طَرِيقِ الْآثَارِ ، وَهُوَ قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى  .","","Sharh Ma'ani al-Athar 3396","","هند بنت أبي أمية زوج رسول الله عن عطاء بن يسار الهلالي عن زيد بن أسلم عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب القبلة للصائم"
"3191","3397  -  وَقَدْ رُوِيَ عَنِ الْمُتَقَدِّمِينَ فِي ذَلِكَ مَا  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  بِشْرُ بْنُ بَكْرٍ ، قَالَ :  حَدَّثَنِي  الْأَوْزَاعِيُّ ، قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  سَالِمٍ الدَّوْسِيِّ ،  عَنْ  سَعْدِ بْنِ أَبِي وَقَّاصٍ ، وَسَأَلَهُ رَجُلٌ :  أَتُبَاشِرُ وَأَنْتَ صَائِمٌ  ؟ فَقَالَ : ( نَعَمْ )  .","","Sharh Ma'ani al-Athar 3397","","سعد بن أبي وقاص عن سالم بن عبد الله سبلان عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن بشر بن بكر التنيسي عن سليمان بن شعيب الكيساني عن الطحاوي","باب القبلة للصائم"
"3192","3398  -  حَدَّثَنَا  يُونُسُ قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  أَنَّ  عَبْدَ اللهِ بْنَ عَبَّاسٍ سُئِلَ عَنِ  الْقُبْلَةِ لِلصَّائِمِ  ، فَرَخَّصَ فِيهَا لِلشَّيْخِ وَكَرِهَهَا لِلشَّابِّ .","","Sharh Ma'ani al-Athar 3398","","عبد الله بن عباس عن عطاء بن يسار الهلالي عن زيد بن أسلم عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب القبلة للصائم"
"3193","3399  -  حَدَّثَنَا  يُونُسُ قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  أَبِي النَّضْرِ ،  أَنَّ عَائِشَةَ بِنْتَ طَلْحَةَ  أَخْبَرَتْهُ  ، أَنَّهَا كَانَتْ عِنْدَ عَائِشَةَ زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَدَخَلَ عَلَيْهَا زَوْجُهَا  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرٍ  وَهُوَ صَائِمٌ ، فَقَالَتْ لَهُ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا : (  مَا يَمْنَعُكَ أَنْ تَدْنُوَ مِنْ أَهْلِكَ فَتُقَبِّلَهَا  ؟ ) قَالَ : أُقَبِّلُهَا وَأَنَا صَائِمٌ ؟ فَقَالَتْ لَهُ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا : ( نَعَمْ ) .","","Sharh Ma'ani al-Athar 3399","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن سالم بن أبي أمية التيمي عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب القبلة للصائم"
"3194","3400  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  شُعَيْبٌ ، قَالَ :  ثَنَا  اللَّيْثُ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  عَنْ  أَبِي مُرَّةَ مَوْلَى عَقِيلٍ ،  عَنْ  حَكِيمِ بْنِ عِقَالٍ ، أَنَّهُ قَالَ :  سَأَلْتُ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا : (  مَا يَحْرُمُ عَلَيَّ مِنِ امْرَأَتِي وَأَنَا صَائِمٌ ؟ ) قَالَتْ : ( فَرْجُهَا  ) .  فَهَذِهِ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا تَقُولُ فِيمَا يَحْرُمُ عَلَى الصَّائِمِ مِنِ امْرَأَتِهِ ، وَمَا يَحِلُّ لَهُ مِنْهَا مَا قَدْ ذَكَرْنَا ، فَدَلَّ ذَلِكَ عَلَى أَنَّ الْقُبْلَةَ كَانَتْ مُبَاحَةً عِنْدَهَا لِلصَّائِمِ الَّذِي يَأْمَنُ عَلَى نَفْسِهِ ، وَمَكْرُوهَةً لِغَيْرِهِ لَيْسَ لِأَنَّهَا حَرَامٌ عَلَيْهِ ، وَلَكِنَّهُ لِأَنَّهُ لَا يَأْمَنُ إِذَا فَعَلَهَا مِنْ أَنْ تَغْلِبَهُ شَهْوَتُهُ حَتَّى يَقَعَ فِيمَا يَحْرُمُ عَلَيْهِ  .","","Sharh Ma'ani al-Athar 3400","","عائشة بنت أبي بكر الصديق عن حكيم بن عقال القرشي عن يزيد المدني مولى عقيل بن أبي طالب عن بكير بن عبد الله بن الأشج القرشي عن الليث بن سعد عن شعيب بن الليث المصري عن الربيع بن سليمان المرادي عن الطحاوي","باب القبلة للصائم"
"3195","3401  -  وَقَدْ  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  ابْنُ أَبِي مَرْيَمَ ، قَالَ :  أَنَا  يَحْيَى بْنُ أَيُّوبَ ، قَالَ :  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  ثَعْلَبَةَ بْنِ صُعَيْرٍ الْعُذْرِيِّ - هَكَذَا قَالَ  ابْنُ أَبِي مَرْيَمَ  ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ مَسَحَ وَجْهَهُ - أَنَّهُ أَخْبَرَهُ ،  أَخْبَرَهُ  ،  أَنَّهُ سَمِعَ  أَصْحَابَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَنْهَوْنَ الصَّائِمَ عَنِ الْقُبْلَةِ  ، وَيَقُولُونَ : إِنَّهَا تَجُرُّ إِلَى مَا هُوَ أَكْبَرُ مِنْهَا  .  فَقَدْ بَيَّنَ فِي هَذَا الْحَدِيثِ الْمَعْنَى الَّذِي مِنْ أَجْلِهِ كَرِهَهَا مَنْ كَرِهَهَا لِلصَّائِمِ ، وَأَنَّهُ إِنَّمَا هُوَ خَوْفُهُمْ عَلَيْهِ مِنْهَا أَنْ يَجُرَّهُ إِلَى مَا هُوَ أَكْبَرُ مِنْهَا ، فَذَلِكَ دَلِيلٌ عَلَى أَنَّهُ إِذَا ارْتَفَعَ ذَلِكَ الْمَعْنَى الَّذِي مِنْ أَجْلِهِ مَنَعُوهُ مِنْهَا أَنَّهَا لَهُ مُبَاحَةٌ  .","","Sharh Ma'ani al-Athar 3401","","أحد الصحابة عن عبد الله بن ثعلبة بن صعير عن الزهري عن عقيل بن خالد الأيلي عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب القبلة للصائم"
"3196","3402  -  وَقَدْ  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  هِشَامُ بْنُ إِسْمَاعِيلَ الدِّمَشْقِيُّ الْعَطَّارُ ، قَالَ :  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  سَأَلَ  عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ عَلِيَّ بْنَ أَبِي طَالِبٍ رَضِيَ اللهُ عَنْهُ عَنْ  قُبْلَةِ الصَّائِمِ  .         [2/96]      فَقَالَ  عَلِيٌّ  : ( يَتَّقِي اللهَ وَلَا يَعُودُ ) ، فَقَالَ  عُمَرُ  : إِنْ كَانَتْ هَذِهِ لَقَرِيبَةٌ مِنْ هَذِهِ  .  فَقَوْلُ  عَلِيٍّ  :  ( يَتَّقِي اللهَ وَلَا يَعُودُ ) يَحْتَمِلُ : ( وَلَا يَعُودُ لَهَا ثَانِيَةً ) ، أَيْ : لِأَنَّهَا مَكْرُوهَةٌ لَهُ مِنْ أَجْلِ صَوْمِهِ .  وَيَحْتَمِلُ : ( وَلَا يَعُودُ ) ، أَيْ : يُقَبِّلُ مَرَّةً بَعْدَ مَرَّةٍ ، فَيَكْثُرُ ذَلِكَ مِنْهُ ، فَيَتَحَرَّكُ لَهُ شَهْوَتُهُ فَيُخَافُ عَلَيْهِ مِنْ ذَلِكَ مُوَاقَعَةُ مَا حَرَّمَ اللهُ عَلَيْهِ .  وَقَوْلُ  عُمَرَ  : ( هَذِهِ قَرِيبَةٌ مِنْ هَذِهِ ) ، أَيْ : أَنَّ هَذِهِ الَّتِي كَرِهْتُهَا لَهُ قَرِيبَةٌ مِنَ الَّتِي أَبَحْتُهَا لَهُ ، أَوْ إِنَّ هَذِهِ الَّتِي أَبَحْتُهَا لَهُ قَرِيبَةٌ مِنَ الَّتِي كَرِهْتُهَا لَهُ ، فَلَا دَلَالَةَ فِي هَذَا الْحَدِيثِ ، وَلَكِنَّ الدَّلَالَاتِ فِيمَا قَدْ تَقَدَّمَهُ مِمَّا قَدْ ذَكَرْنَاهُ قَبْلَهُ  .","","Sharh Ma'ani al-Athar 3402","","علي بن أبي طالب عن سعيد بن حيان التيمي عن يحيى بن سعيد التيمي عن مروان بن معاوية الفزاري عن هشام بن إسماعيل بن يحيى عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب القبلة للصائم"
"3197","11 - بَابُ الصَّائِمِ يَقِيءُ  3403  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، قَالَ :  ثَنَا  أَبِي  ،  عَنْ  حُسَيْنٍ الْمُعَلِّمِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَمْرٍو الْأَوْزَاعِيِّ ،  عَنْ  يَعِيشَ بْنِ الْوَلِيدِ بْنِ هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَعْدَانَ بْنِ أَبِي طَلْحَةَ ،  عَنْ  أَبِي الدَّرْدَاءِ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَاءَ فَأَفْطَرَ  قَالَ : فَلَقِيتُ ثَوْبَانَ فِي  مَسْجِدِ دِمَشْقَ  ، فَقَالَ : ( صَدَقَ ، أَنَا صَبَبْتُ لَهُ وَضُوءَهُ ) .","","Sharh Ma'ani al-Athar 3403","","ثوبان بن بجدد مولى رسول الله عن معدان بن أبى طلحة اليعمري عن الوليد بن هشام بن معاوية المعيطي عن يعيش بن الوليد بن هشام القرشي عن أبو عمرو الأوزاعي عن يحيى بن أبي كثير عن حسين المعلم عن عبد الوارث بن سعيد بن ذكوان عن عبد الصمد بن عبد الوارث التنوري عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصائم يقيء"
"3198","3404  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  أَبُو مَعْمَرٍ ، قَالَ :  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  حُسَيْنٍ الْمُعَلِّمِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو الْأَوْزَاعِيِّ  ،  عَنْ  يَعِيشَ بْنِ الْوَلِيدِ بْنِ هِشَامٍ ،  عَنْ  مَعْدَانَ بْنِ طَلْحَةَ ،  عَنْ  أَبِي الدَّرْدَاءِ ، ثُمَّ ذَكَرَ مِثْلَهُ .  قَالَ  ابْنُ أَبِي دَاوُدَ  : قَالَ  أَبُو مَعْمَرٍ  : هَكَذَا قَالَ  عَبْدُ الْوَارِثِ :  عَبْدِ اللهِ بْنِ عَمْرٍو  .  كذا في طبعة عالم الكتب ، والصواب : (عبد الرحمن بن عمرو الأوزاعي) . كما في مصادر الترجمة.","","Sharh Ma'ani al-Athar 3404","","أبو الدرداء عن معدان بن أبى طلحة اليعمري عن يعيش بن الوليد بن هشام القرشي عن أبو عمرو الأوزاعي عن يحيى بن أبي كثير عن حسين المعلم عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصائم يقيء"
"3199","3405  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  ثَنَا  أَبُو الْجُودِيِّ ،  عَنْ  بَلْجٍ - رَجُلٍ مِنْ  مَهْرَةَ  -  عَنْ  أَبِي شَيْبَةَ الْمَهْرِيِّ ، قَالَ :  قُلْتُ  لِثَوْبَانَ : حَدِّثْنَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَاءَ فَأَفْطَرَ  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى أَنَّ الصَّائِمَ إِذَا قَاءَ فَقَدْ أَفْطَرَ ، وَاحْتَجُّوا فِي ذَلِكَ بِهَذَا الْحَدِيثِ ، وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : إِنِ  اسْتَقَاءَ  أَفْطَرَ ، وَإِنْ ذَرَعَهُ الْقَيْءُ لَمْ يُفْطِرْ .  وَقَالُوا : قَدْ يَجُوزُ أَنْ يَكُونَ قَوْلُهُ : ( قَاءَ فَأَفْطَرَ ) أَيْ : قَاءَ فَضَعُفَ فَأَفْطَرَ ، وَقَدْ يَجُوزُ هَذَا فِي اللُّغَةِ .  وَاحْتَجَّ الْأَوَّلُونَ لِقَوْلِهِمْ أَيْضًا بِمَا .","","Sharh Ma'ani al-Athar 3405","","ثوبان بن بجدد مولى رسول الله عن أبو شيبة المهري عن بلج بن عبد الله المهري عن أبو الجودي الأسدي عن شعبة بن الحجاج عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصائم يقيء"
"3200","3406  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ، قَالَ :  ثَنَا  يَزِيدُ         [2/97]      بْنُ أَبِي حَبِيبٍ ، قَالَ :  أَخْبَرَنِي  أَبُو مَرْزُوقٍ ،  عَنْ  حَنَشٍ ،  عَنْ  فَضَالَةَ بْنِ عُبَيْدٍ ، قَالَ :  دَعَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِشَرَابٍ ، فَقَالَ لَهُ بَعْضُنَا : أَلَمْ تُصْبِحْ صَائِمًا يَا رَسُولَ اللهِ ؟ قَالَ :  بَلَى ، وَلَكِنِّي قِئْتُ  .","","Sharh Ma'ani al-Athar 3406","","فضالة بن عبيد بن نافذ الأوسي عن حنش بن عبد الله السبائي عن أبو مرزوق التجيبي مولى عقبة بن بجرة عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب الصائم يقيء"
"3201","3407  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ . (  ح  ) .  3408  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ . (  ح  ) .  3409  -  وَحَدَّثَنَا  حُسَيْنُ بْنُ نَصْرٍ ، قَالَ :  ثَنَا  يَحْيَى بْنُ حَسَّانَ ، قَالُوا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي مَرْزُوقٍ ،  عَنْ  حَنَشٍ ،  عَنْ  فَضَالَةَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  قِيلَ لَهُمْ : وَهَذَا أَيْضًا مِثْلُ الْأَوَّلِ يَجُوزُ : "" وَلَكِنِّي قِئْتُ "" فَضَعُفْتُ عَنِ الصَّوْمِ فَأَفْطَرْتُ ، وَلَيْسَ فِي هَذَيْنِ الْحَدِيثَيْنِ دَلِيلٌ عَلَى أَنَّ الْقَيْءَ كَانَ مُفْطِرًا لَهُ ، إِنَّمَا فِيهِ أَنَّهُ قَاءَ ، فَأَفْطَرَ بَعْدَ ذَلِكَ  .  وَقَدْ رُوِيَ فِي حُكْمِ الصَّائِمِ إِذَا قَاءَ أَوِ  اسْتَقَاءَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُفَسَّرًا مَا قَدْ  :","","Sharh Ma'ani al-Athar 3407","","فضالة بن عبيد بن نافذ الأوسي عن حنش بن عبد الله السبائي عن أبو مرزوق التجيبي مولى عقبة بن بجرة عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن حماد بن سلمة عن يحيى بن حسان بن حيان التنيسي عن الحسين بن نصر بن معارك البغدادي عن الطحاوي","باب الصائم يقيء"
"3202","3410  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ، قَالَ :  ثَنَا  مُسَدَّدٌ ، قَالَ :  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ ذَرَعَهُ الْقَيْءُ ، وَهُوَ صَائِمٌ ، فَلَيْسَ عَلَيْهِ قَضَاءٌ  ، وَمَنِ  اسْتَقَاءَ  فَلْيَقْضِ  .  فَبَيَّنَ هَذَا الْحَدِيثُ كَيْفَ حُكْمُ الصَّائِمِ إِذَا ذَرَعَهُ الْقَيْءُ أَوِ  اسْتَقَاءَ  ، وَأَوْلَى الْأَشْيَاءِ بِنَا أَنْ يُحْمَلَ الْآثَارُ عَلَى مَا فِيهِ اتِّفَاقُهَا وَتَصْحِيحُهَا ، لَا عَلَى مَا فِيهِ تَنَافِيهَا وَتَضَادُّهَا ، فَيَكُونُ مَعْنَى الْحَدِيثَيْنِ الْأَوَّلَيْنِ عَلَى مَا وَصَفْنَا حَتَّى لَا يُضَادَّ مَعْنَاهُمَا مَعْنَى هَذَا الْحَدِيثِ ، فَهَذَا حُكْمُ هَذَا الْبَابِ مِنْ طَرِيقِ تَصْحِيحِ مَعَانِي الْآثَارِ ، وَأَمَّا حُكْمُهُ مِنْ طَرِيقِ النَّظَرِ ، فَإِنَّا رَأَيْنَا الْقَيْءَ حَدَثًا فِي قَوْلِ بَعْضِ النَّاسِ ، وَغَيْرَ حَدَثٍ فِي قَوْلِ الْآخَرِينَ ، وَرَأَيْنَا خُرُوجَ الدَّمِ كَذَلِكَ ، وَكُلٌّ قَدْ أَجْمَعَ أَنَّ الصَّائِمَ إِذَا فَصَدَ عِرْقًا أَنَّهُ لَا يَكُونُ بِذَلِكَ مُفْطِرًا ، وَكَذَلِكَ لَوْ كَانَتْ بِهِ عِلَّةٌ فَانْفَجَرَتْ عَلَيْهِ دَمًا مِنْ مَوْضِعٍ مِنْ بَدَنِهِ ، فَكَانَ خُرُوجُ الدَّمِ مِنْ حَيْثُ ذَكَرْنَا مِنْ بَدَنِهِ ، وَاسْتِخْرَاجُهُ إِيَّاهُ سَوَاءً فِيمَا ذَكَرْنَا ، وَكَذَلِكَ هُمَا فِي الطَّهَارَةِ .  وَكَانَ خُرُوجُ الْقَيْءِ مِنْ غَيْرِ اسْتِخْرَاجٍ مِنْ صَاحِبِهِ إِيَّاهُ لَا يَنْقُضُ الصَّوْمَ ، فَالنَّظَرُ عَلَى مَا ذَكَرْنَا أَنْ يَكُونَ خُرُوجُهُ بِاسْتِخْرَاجِ صَاحِبِهِ إِيَّاهُ كَذَلِكَ لَا يَنْقُضُ الصَّوْمَ ، فَلَمَّا كَانَ الْقَيْءُ لَا يُفْطِرُهُ فِي النَّظَرِ كَانَ مَا ذَرَعَهُ مِنَ الْقَيْءِ أَحْرَى أَنْ يَكُونَ كَذَلِكَ ، فَهَذَا حُكْمُ هَذَا الْبَابِ أَيْضًا مِنْ طَرِيقِ النَّظَرِ ، وَلَكِنَّ اتِّبَاعَ مَا رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَوْلَى ، وَهَذَا قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى وَعَامَّةِ الْعُلَمَاءِ  .         [2/98]      وَقَدْ رُوِيَ ذَلِكَ عَنْ جَمَاعَةٍ مِنَ الْمُتَقَدِّمِينَ .","","Sharh Ma'ani al-Athar 3410","","أبو هريرة الدوسي عن محمد بن سيرين عن هشام بن حسان العتكي عن عيسى بن يونس بن أبي إسحاق عن مسدد بن مسرهد عن أحمد بن داود بن موسى السدوسي عن الطحاوي","باب الصائم يقيء"
"3203","3411  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  مَالِكٌ وَصَخْرُ بْنُ جُوَيْرِيَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّهُ قَالَ : (  مَنِ  اسْتَقَاءَ  ، وَهُوَ صَائِمٌ ، فَعَلَيْهِ الْقَضَاءُ  ، وَمَنْ ذَرَعَهُ الْقَيْءُ فَلَيْسَ عَلَيْهِ الْقَضَاءُ  ) .","","Sharh Ma'ani al-Athar 3411","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصائم يقيء"
"3204","3412  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  الْقَعْنَبِيُّ ، قَالَ :  ثَنَا  مَالِكٌ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3412","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصائم يقيء"
"3205","3413  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ - يَعْنِي ابْنَ سَلَمَةَ -  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3413","","إبراهيم النخعي عن حماد بن أبي سليمان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصائم يقيء"
"3206","3414  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  حُمَيْدٍ ،  عَنِ  الْحَسَنِ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3414","","الحسن البصري عن حميد الطويل عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصائم يقيء"
"3207","3415  -  حَدَّثَنَا  مُحَمَّدٌ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  حِبَّانَ السُّلَمِيِّ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3415","","القاسم بن محمد بن أبي بكر الصديق عن حيان السلمي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصائم يقيء"
"3208","12 - بَابُ الصَّائِمِ يَحْتَجِمُ  3416  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  سَعِيدٌ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنْ  أَبِي رَافِعٍ ، قَالَ :  دَخَلْتُ عَلَى  أَبِي مُوسَى ، وَهُوَ يَحْتَجِمُ لَيْلًا ، فَقُلْتُ : لَوْلَا كَانَ هَذَا نَهَارًا ، فَقَالَ : ( أَتَأْمُرُنِي أَنْ أُهَرِيقَ دَمِي وَأَنَا صَائِمٌ ) . وَقَدْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Sharh Ma'ani al-Athar 3416","","أبو موسى الأشعري عن نفيع بن رافع الصائغ عن بكر بن عبد الله المزني عن مطر بن طهمان الوراق عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب الصائم يحتجم"
"3209","3417  -  حَدَّثَنَا  رَبِيعٌ الْجِيزِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Sharh Ma'ani al-Athar 3417","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عمرو بن شعيب عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن الربيع بن سليمان الجيزي عن الطحاوي","باب الصائم يحتجم"
"3210","3418  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ حُمَيْدٍ وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  ابْنُ فُضَيْلٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ قَالَ :  شَهِدَ عِنْدِي  نَفَرٌ مِنْ  أَهْلِ الْبَصْرَةِ  مِنْهُمُ الْحَسَنُ بْنُ أَبِي الْحَسَنِ ،  عَنْ  مَعْقِلٍ الْأَشْجَعِيِّ ، أَنَّهُ قَالَ :  مَرَّ عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا أَحْتَجِمُ لِثَمَانِ عَشْرَةَ لَيْلَةً خَلَتْ مِنْ رَمَضَانَ ، فَقَالَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Sharh Ma'ani al-Athar 3418","","معقل بن سنان بن مظهر الأشجعي عن الحسن البصري عن عطاء بن السائب عن محمد بن فضيل بن غزوان عن أبو بكر ابن أبي شيبة عن فهد بن سليمان الدلال عن الطحاوي","باب الصائم يحتجم"
"3211","3419  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ الْأَشْعَرِيِّ ،  عَنْ  ثَوْبَانَ مَوْلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Sharh Ma'ani al-Athar 3419","","ثوبان بن بجدد مولى رسول الله عن عبد الرحمن بن غنم الأشعري عن شهر بن حوشب عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن عبد الله بن المثنى الخزرجي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصائم يحتجم"
"3212","3420  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ عَامِرٍ ، قَالَ :  ثَنَا  سَعِيدٌ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3420","","ثوبان بن بجدد مولى رسول الله عن عبد الرحمن بن غنم الأشعري عن شهر بن حوشب عن قتادة بن دعامة عن سعيد بن أبي عروبة عن سعيد بن عامر الضبعي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصائم يحتجم"
"3213","3421  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ، قَالَ :  ثَنَا  الْأَوْزَاعِيُّ ، قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ، قَالَ :  حَدَّثَنِي  أَبُو قِلَابَةَ ، قَالَ :  حَدَّثَنِي  أَبُو أَسْمَاءَ الرَّحَبِيُّ ،  عَنْ  ثَوْبَانَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَرَجَ فِي رَمَضَانَ فِي ثَمَانِيَ عَشْرَةَ ، فَمَرَّ بِرَجُلٍ يَحْتَجِمُ ، فَقَالَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Sharh Ma'ani al-Athar 3421","","ثوبان بن بجدد مولى رسول الله عن عمرو بن مرثد الرحبي عن أبو قلابة الجرمي عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن فهد بن سليمان الدلال عن الطحاوي","باب الصائم يحتجم"
"3214","[2/99]      3422  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ مَيْمُونٍ ، قَالَ :  ثَنَا  الْوَلِيدُ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى ، قَالَ :  حَدَّثَنِي  أَبُو قِلَابَةَ ، أَنَّ أَبَا أَسْمَاءَ  حَدَّثَهُ  ،  أَنَّ  ثَوْبَانَ مَوْلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَدَّثَهُ ، ثُمَّ ذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3422","","ثوبان بن بجدد مولى رسول الله عن عمرو بن مرثد الرحبي عن أبو قلابة الجرمي عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن محمد بن عبد الله بن ميمون السكري عن الطحاوي","باب الصائم يحتجم"
"3215","3423  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحَسَنُ بْنُ رَبِيعٍ ، قَالَ :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Sharh Ma'ani al-Athar 3423","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن ليث بن أبي سليم عن سلام بن سليم الحنفي عن الحسن بن الربيع البوراني عن فهد بن سليمان الدلال عن الطحاوي","باب الصائم يحتجم"
"3216","3424  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  عَمْرُو بْنُ عَوْنٍ ، قَالَ :  ثَنَا  هُشَيْمٌ ،  عَنْ  خَالِدٍ وَمَنْصُورٍ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ ،  عَنْ  شَدَّادِ بْنِ أَوْسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ فِي رَمَضَانَ عَلَى  رَجُلٍ  يَحْتَجِمُ ، فَقَالَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Sharh Ma'ani al-Athar 3424","","شداد بن أوس الخزرجي عن شراحيل بن آدة الأبناوي عن أبو قلابة الجرمي عن منصور بن زاذان الثقفي عن هشيم بن بشير عن عمرو بن عون الواسطي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصائم يحتجم"
"3217","3425  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ يُونُسَ ، قَالَ :  ثَنَا  أَبُو حُذَيْفَةَ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي قِلَابَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3425","","شداد بن أوس الخزرجي عن شراحيل بن آدة الأبناوي عن أبو قلابة الجرمي عن عاصم بن سليمان الأحول عن سفيان الثوري عن موسى بن مسعود النهدي عن إبراهيم بن محمد بن يونس البصري عن الطحاوي","باب الصائم يحتجم"
"3218","3426  -  حَدَّثَنَا  فَهْدٌ ،  قَالَ  : الْحَسَنُ بْنُ الرَّبِيعِ ، قَالَ :  ثَنَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ، قَالَ :  قَالَ  أَبُو هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمُسْتَحْجِمُ  .","","Sharh Ma'ani al-Athar 3426","","أبو هريرة الدوسي عن عطاء بن أبي رباح عن ابن جريج عن داود ابن النصراني عن الحسن بن الربيع البوراني عن فهد بن سليمان الدلال عن الطحاوي","باب الصائم يحتجم"
"3219","3427  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ، قَالَ :  ثَنَا  عَمْرُو بْنُ شُعَيْبٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى أَنَّ الْحِجَامَةَ تُفْطِرُ الصَّائِمَ حَاجِمًا كَانَ أَوْ مَحْجُومًا ، وَاحْتَجُّوا فِي ذَلِكَ بِهَذِهِ الْآثَارِ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : لَا يُفْطِرُ الْحِجَامَةُ حَاجِمًا وَلَا مَحْجُومًا .  وَقَالُوا : لَيْسَ فِيمَا رَوَيْتُمُوهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ قَوْلِهِ : ""  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ "" مَا يَدُلُّ أَنَّ ذَلِكَ الْفِطْرَ كَانَ مِنْ أَجْلِ الْحِجَامَةِ .  قَدْ يَجُوزُ أَنْ يَكُونَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَخْبَرَ أَنَّهُمَا أَفْطَرَا بِمَعْنًى آخَرَ وَصَفَهُمَا بِمَا كَانَا يَفْعَلَانِهِ حِينَ أَخْبَرَ عَنْهُمَا بِذَلِكَ .  كَمَا يَقُولُ : ( فَسَقَ الْقَائِمُ ) لَيْسَ إِنَّهُ فَسَقَ بِقِيَامِهِ ، وَلَكِنَّهُ فَسَقَ بِمَعْنًى غَيْرِ الْقِيَامِ .  وَقَدْ رُوِيَ عَنْ  أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ  ، وَهُوَ أَحَدُ مَنْ رَوَى ذَلِكَ الْحَدِيثَ فِي هَذَا الْمَعْنَى  .","","Sharh Ma'ani al-Athar 3427","","أبو هريرة الدوسي عن سعيد بن المسيب عن عمرو بن شعيب عن عبد الله بن لهيعة عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب الصائم يحتجم"
"3220","3428  - حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ  ، قَالَ : ثَنَا  الْوُحَاظِيُّ  ، قَالَ : ثَنَا  يَزِيدُ بْنُ رَبِيعَةَ الدِّمَشْقِيُّ  ، عَنْ  أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ  قَالَ :  إِنَّمَا قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ "" ؛ لِأَنَّهُمَا كَانَا يَغْتَابَانِ ، وَهَذَا الْمَعْنَى مَعْنًى صَحِيحٌ ، وَلَيْسَ إِفْطَارُهُمَا ذَلِكَ كَالْإِفْطَارِ بِالْأَكْلِ وَالشُّرْبِ وَالْجِمَاعِ ، وَلَكِنَّهُ  حَبِطَ  أَجْرُهُمَا بِاغْتِيَابِهِمَا ، فَصَارَا بِذَلِكَ مُفْطِرَيْنِ لَا أَنَّهُ إِفْطَارٌ يُوجِبُ عَلَيْهِمَا الْقَضَاءَ .  وَهَذَا كَمَا قِيلَ : الْكَذِبُ يُفْطِرُ الصَّائِمَ ، لَيْسَ يُرَادُ بِهِ الْفِطْرُ الَّذِي يُوجِبُ الْقَضَاءَ ، إِنَّمَا هُوَ عَلَى حُبُوطِ الْأَجْرِ بِذَلِكَ ، كَمَا يُحْبَطُ بِالْأَكْلِ وَالشُّرْبِ .         [2/100]      وَهَذَا نَظِيرُ مَا حَمَلْنَاهُ نَحْنُ عَلَيْهِ مِنَ التَّأْوِيلِ الَّذِي ذَكَرْنَاهُ ، وَقَدْ رَوَى جَمَاعَةٌ مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ مَعْنًى آخَرَ  .","","Sharh Ma'ani al-Athar 3428","","","باب الصائم يحتجم"
"3221","3429  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ الْكَيْسَانِيُّ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْمُتَوَكِّلِ النَّاجِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : (  إِنَّمَا كَرِهْنَا أَوْ كُرِهَتِ الْحِجَامَةُ لِلصَّائِمِ مِنْ أَجْلِ الضَّعْفِ  ) .","","Sharh Ma'ani al-Athar 3429","","أبو سعيد الخدري عن علي بن داود الناجي عن قتادة بن دعامة عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن سليمان بن شعيب الكيساني عن الطحاوي","باب الصائم يحتجم"
"3222","3430  -  حَدَّثَنَا  سُلَيْمَانُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  حُمَيْدٍ ، قَالَ :  سَأَلَ  ثَابِتٌ الْبُنَانِيُّ أَنَسَ بْنَ مَالِكٍ : ( هَلْ كُنْتُمْ تَكْرَهُونَ الْحِجَامَةَ لِلصَّائِمِ ؟ )  قَالَ  : (  لَا إِلَّا مِنْ أَجْلِ الضَّعْفِ  ) .","","Sharh Ma'ani al-Athar 3430","","أنس بن مالك عن ثابت البناني عن حميد الطويل عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن سليمان بن شعيب الكيساني عن الطحاوي","باب الصائم يحتجم"
"3223","3431  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  أَنَا  حُمَيْدٌ الطَّوِيلُ ، قَالَ :  سُئِلَ  أَنَسُ بْنُ مَالِكٍ عَنِ الْحِجَامَةِ لِلصَّائِمِ ، فَقَالَ : (  مَا كُنْتُ أَرَى الْحِجَامَةَ تُكْرَهُ لِلصَّائِمِ إِلَّا مِنَ  الْجَهْدِ  )  .","","Sharh Ma'ani al-Athar 3431","","أنس بن مالك عن حميد الطويل عن يزيد بن هارون عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصائم يحتجم"
"3224","3432  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  هَدِيَّةُ بْنُ خَالِدٍ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ قَالَ :  (  مَا كُنَّا نَدَعُ الْحِجَامَةَ إِلَّا كَرَاهَةَ  الْجَهْدِ  ) .","","Sharh Ma'ani al-Athar 3432","","أنس بن مالك عن ثابت البناني عن سليمان بن المغيرة القيسي عن هدبة بن خالد عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصائم يحتجم"
"3225","3433  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ ، قَالَ :  أَنَا  شَرِيكٌ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي جَعْفَرٍ وَسَالِمٍ ،  عَنْ  سَعِيدٍ وَمُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ وَلَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ : (  إِنَّمَا كُرِهَتِ الْحِجَامَةُ لِلصَّائِمِ مَخَافَةَ الضَّعْفِ  )  .  فَدَلَّتْ هَذِهِ الْآثَارُ عَلَى أَنَّ الْمَكْرُوهَ مِنْ أَجْلِهِ الْحِجَامَةُ فِي الصِّيَامِ هُوَ الضَّعْفُ الَّذِي يُصِيبُ الصَّائِمَ فَيُفْطِرُ مِنْ أَجْلِهِ بِالْأَكْلِ وَالشُّرْبِ  .  وَقَدْ رُوِيَ نَحْوٌ مِنْ هَذَا الْمَعْنَى عَنْ  أَبِي الْعَالِيَةِ  .","","Sharh Ma'ani al-Athar 3433","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن فهد بن سليمان الدلال عن الطحاوي","باب الصائم يحتجم"
"3226","3434  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ، قَالَ :  أَنَا  عَاصِمٌ الْأَحْوَلُ ،  أَنَّ  أَبَا الْعَالِيَةِ قَالَ : (  إِنَّمَا كُرِهَتْ مَخَافَةَ أَنْ يُغْشَى عَلَيْهِ  ) . قَالَ : فَأَخْبَرْتُ بِذَلِكَ أَبَا قِلَابَةَ . فَقَالَ لِي :  إِنْ غُشِيَ عَلَيْهِ يُسْقَى الْمَاءَ  .  وَقَدْ رُوِيَ هَذَا الْمَعْنَى أَيْضًا بِعَيْنِهِ عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ  .","","Sharh Ma'ani al-Athar 3434","","أبو قلابة الجرمي عن عاصم بن سليمان الأحول عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصائم يحتجم"
"3227","3435  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  ابْنُ أَبِي مَرْيَمَ ، قَالَ :  أَنَا  يَحْيَى بْنُ أَيُّوبَ ، قَالَ :  حَدَّثَنِي  يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  سَمِعْتُ  الْقَاسِمَ بْنَ مُحَمَّدٍ ،  وَهُوَ يَذْكُرُ قَوْلَ النَّاسِ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ .  فَقَالَ  الْقَاسِمُ  :  لَوْ أَنَّ رَجُلًا حَجَمَ يَدَهُ أَوْ بَعْضَ جَسَدِهِ مَا يُفْطِرُهُ ذَلِكَ  .  فَقَالَ  سَالِمٌ :  إِنَّمَا كُرِهَتِ الْحِجَامَةُ لِلصَّائِمِ مَخَافَةَ أَنْ يُغْشَى عَلَيْهِ ، فَيُفْطِرَ  .  وَالْمَعْنَى الَّذِي رُوِيَ فِي تَأْوِيلِ ذَلِكَ عَنْ  أَبِي الْأَشْعَثِ  ، كَأَنَّهُ أَشْبَهُ بِذَلِكَ ؛ لِأَنَّ الضَّعْفَ لَوْ كَانَ هُوَ الْمَقْصُودَ بِالنَّهْيِ إِلَيْهِ لَمَا كَانَ الْحَاجِمُ دَاخِلًا فِي ذَلِكَ ، فَإِذَا كَانَ  الْحَاجِمُ  وَالْمَحْجُومُ قَدْ جُمِعَا فِي ذَلِكَ أَشْبَهَ أَنْ يَكُونَ ذَلِكَ لِمَعْنًى وَاحِدٍ ، هُمَا فِيهِ سَوَاءٌ مِثْلُ الْغِيبَةِ الَّتِي هُمَا فِيهَا سَوَاءٌ ، كَمَا قَالَ  أَبُو الْأَشْعَثِ  .         [2/101]      وَقَدْ رُوِيَ أَيْضًا ، عَنِ  الشَّعْبِيِّ  وَإِبْرَاهِيمَ  أَنَّهُمَا قَالَا : ( إِنَّمَا كُرِهَتْ مِنْ أَجْلِ الضَّعْفِ أَيْضًا  ) .","","Sharh Ma'ani al-Athar 3435","","سالم بن عبد الله بن عمر بن الخطاب عن يحيى بن سعيد الأنصاري عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن فهد بن سليمان الدلال عن الطحاوي","باب الصائم يحتجم"
"3228","3436  -  حَدَّثَنَا  يَزِيدُ - هُوَ ابْنُ سِنَانٍ - قَالَ :  ثَنَا  يَحْيَى الْقَطَّانُ ، قَالَ :  ثَنَا  الْأَعْمَشُ قَالَ :  سَأَلْتُ  إِبْرَاهِيمَ ، عَنِ الْحِجَامَةِ لِلصَّائِمِ ، فَقَالَ : (  إِنَّمَا كُرِهَتْ مِنْ أَجْلِ الضَّعْفِ  ) .","","Sharh Ma'ani al-Athar 3436","","إبراهيم النخعي عن الأعمش عن يحيى القطان عن يزيد بن سنان القزاز عن الطحاوي","باب الصائم يحتجم"
"3229","3437  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ، قَالَ :  أَنَا  دَاوُدُ ،  عَنِ  الشَّعْبِيِّ ،  أَنَّ  الْحُسَيْنَ بْنَ عَلِيٍّ احْتَجَمَ وَهُوَ صَائِمٌ  .  وَقَالَ  الشَّعْبِيُّ : (  إِنَّمَا كُرِهَتِ الْحِجَامَةُ ؛ لِأَنَّهَا تُضْعِفُهُ  ) .  وَقَدْ رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي إِبَاحَةِ الْحِجَامَةِ لِلصَّائِمِ  مَا .","","Sharh Ma'ani al-Athar 3437","","الحسين بن علي عن الشعبي عن داود بن أبي هند عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصائم يحتجم"
"3230","3438  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  أَبُو مَعْمَرٍ ، قَالَ :  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  أَيُّوبَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3438","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن أيوب السختياني عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصائم يحتجم"
"3231","3439  -  حَدَّثَنَا  رَبِيعٌ الْجِيزِيُّ ، قَالَ :  ثَنَا  أَبُو الْأَسْوَدِ - وَهُوَ النَّضْرُ بْنُ عَبْدِ الْجَبَّارِ الْمُرَادِيُّ - قَالَ :  أَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3439","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن الربيع بن سليمان الجيزي عن الطحاوي","باب الصائم يحتجم"
"3232","3440  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْحَسَنِ بْنِ زَيْدٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3440","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن الحسن بن زيد بن الحسن بن علي بن أبي طالب عن محمد بن عبد الرحمن بن المغيرة عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصائم يحتجم"
"3233","3441  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  عَنْ  حَبِيبِ بْنِ الشَّهِيدِ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحْرِمٌ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3441","","عبد الله بن عباس عن ميمون بن مهران الرقي عن حبيب بن الشهيد عن محمد بن عبد الله بن المثنى الخزرجي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصائم يحتجم"
"3234","3442  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  أَبُو غَسَّانَ ، قَالَ :  ثَنَا  مَسْعُودُ بْنُ سَعْدٍ الْجُعْفِيُّ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  احْتَجَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  ، وَهُوَ صَائِمٌ مُحْرِمٌ  .","","Sharh Ma'ani al-Athar 3442","","عبد الله بن عباس عن مقسم بن بجرة عن يزيد بن أبي زياد القرشي عن مسعود بن سعد الجعفي عن مالك بن إسماعيل النهدي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الصائم يحتجم"
"3235","3443  -  حَدَّثَنَا  حُسَيْنُ بْنُ نَصْرٍ ، قَالَ :  ثَنَا  الْفِرْيَابِيُّ . (  ح  ) .  3444  -  وَحَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ وَأَبُو حُذَيْفَةَ قَالُوا :  حَدَّثَنَا  سُفْيَانُ ،  عَنْ  يَزِيدَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3443","","عبد الله بن عباس عن مقسم بن بجرة عن يزيد بن أبي زياد القرشي عن سفيان الثوري عن محمد بن يوسف الفريابي عن الحسين بن نصر بن معارك البغدادي عن الطحاوي","باب الصائم يحتجم"
"3236","3445  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ وَهُوَ صَائِمٌ  .","","Sharh Ma'ani al-Athar 3445","","عبد الله بن عباس عن مقسم بن بجرة عن يزيد بن أبي زياد القرشي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصائم يحتجم"
"3237","3446  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ أَبِي زِيَادٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ . وَزَادَ ،  وَهُوَ صَائِمٌ مُحْرِمٌ  .","","Sharh Ma'ani al-Athar 3446","","عبد الله بن عباس عن مقسم بن بجرة عن يزيد بن أبي زياد القرشي عن عبد العزيز بن مسلم الخراساني عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصائم يحتجم"
"3238","3447  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  حَدَّثَنِي  ابْنُ أَبِي لَيْلَى ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ احْتَجَمَ ، وَهُوَ صَائِمٌ مُحْرِمٌ بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  .","","Sharh Ma'ani al-Athar 3447","","عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن فهد بن سليمان الدلال عن الطحاوي","باب الصائم يحتجم"
"3239","3448  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ، قَالَ :  ثَنَا  الْقَاسِمُ بْنُ مَالِكٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ  أَبَا طَيْبَةَ  حَجَمَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ صَائِمٌ  ، فَأَعْطَاهُ أَجْرَهُ ، وَلَوْ كَانَ حَرَامًا مَا أَعْطَاهُ .         [2/102]      فَدَلَّ فِعْلُهُ هَذَا صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى أَنَّ الْحِجَامَةَ لَا تُفْطِرُ الصَّائِمَ ، وَلَوْ كَانَتْ مِمَّا يُفْطِرُ الصَّائِمَ إِذًا لَمَا احْتَجَمَ وَهُوَ صَائِمٌ ، فَهَذَا وَجْهُ هَذَا الْبَابِ مِنْ طَرِيقِ تَصْحِيحِ الْآثَارِ ، وَأَمَّا وَجْهُهُ مِنْ طَرِيقِ النَّظَرِ ، فَإِنَّا رَأَيْنَا خُرُوجَ الدَّمِ أَغْلَظُ أَحْوَالِهِ أَنْ يَكُونَ حَدَثًا يَنْتَقِضُ بِهِ الطَّهَارَةُ ، وَقَدْ رَأَيْنَا الْغَائِطَ وَالْبَوْلَ خُرُوجُهُمَا حَدَثٌ يُنْتَقَضُ بِهِ الطَّهَارَةُ ، وَلَا يَنْقُضُ الصِّيَامَ ، فَالنَّظَرُ عَلَى ذَلِكَ أَنْ يَكُونَ الدَّمُ كَذَلِكَ ، وَقَدْ رَأَيْنَا الصَّائِمَ لَا يُفْطِرُهُ فَصْدُ الْعِرْقِ ، فَالْحِجَامَةُ فِي النَّظَرِ أَيْضًا كَذَلِكَ ، وَهُوَ قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى  .","","Sharh Ma'ani al-Athar 3448","","أنس بن مالك عن عاصم بن سليمان الأحول عن القاسم بن مالك المزني عن يوسف بن عدي بن رزق الكوفي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصائم يحتجم"
"3240","3449  -  وَقَدْ  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  أَنَّ  سَالِمَ بْنَ عَبْدِ اللهِ وَالْقَاسِمَ بْنَ مُحَمَّدٍ كَانَا لَا يَرَيَانِ بِالْحِجَامَةِ لِلصَّائِمِ بَأْسًا ، وَقَالَا :  أَرَأَيْتَ لَوِ احْتَجَمَ عَلَى ظَهْرِ كَفِّهِ أَكَانَ ذَلِكَ يُفْطِرُهُ  .","","Sharh Ma'ani al-Athar 3449","","سالم بن عبد الله بن عمر بن الخطاب عن يحيى بن سعيد الأنصاري عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصائم يحتجم"
"3241","13 - بَابٌ : الرَّجُلُ يُصْبِحُ فِي يَوْمٍ مِنْ شَهْرِ رَمَضَانَ  جُنُبًا  ، هَلْ يَصُومُ أَمْ لَا ؟  3450  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ : أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  سُمَيٍّ مَوْلَى أَبِي بَكْرٍ ،  أَنَّهُ سَمِعَ  أَبَا بَكْرِ بْنَ عَبْدِ الرَّحْمَنِ يَقُولُ : كُنْتُ أَنَا وَأَبِي عِنْدَ  مَرْوَانَ بْنِ الْحَكَمِ  ، وَهُوَ أَمِيرُ  الْمَدِينَةِ  ، فَذَكَرَ أَنَّ  أَبَا هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ كَانَ يَقُولُ : "" مَنْ أَصْبَحَ  جُنُبًا  أَفْطَرَ ذَلِكَ الْيَوْمَ "" . فَقَالَ  مَرْوَانُ  : أَقْسَمْتُ عَلَيْكَ لَتَذْهَبَنَّ إِلَى أُمَّيِ الْمُؤْمِنِينَ  عَائِشَةَ  وَأُمِّ سَلَمَةَ  رَضِيَ اللهُ عَنْهُمَا فَتَسْأَلَهُمَا عَنْ ذَلِكَ ، قَالَ : فَذَهَبَ  عَبْدُ الرَّحْمَنِ  وَذَهَبْتُ مَعَهُ حَتَّى  دَخَلْنَا عَلَى  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، فَسَلَّمَ عَلَيْهَا  عَبْدُ الرَّحْمَنِ  ، ثُمَّ قَالَ : يَا أُمَّ الْمُؤْمِنِينَ ، إِنَّا كُنَّا عِنْدَ  مَرْوَانَ  ، فَذُكِرَ لَهُ أَنَّ  أَبَا هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ كَانَ يَقُولُ : مَنْ أَصْبَحَ  جُنُبًا  أَفْطَرَ ذَلِكَ الْيَوْمَ ، فَقَالَتْ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا : بِئْسَ مَا قَالَ  أَبُو هُرَيْرَةَ  ، يَا  عَبْدَ الرَّحْمَنِ  ، أَتَرْغَبُ عَمَّا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُ ؟ "" فَقَالَ : لَا وَاللهِ . قَالَتْ : فَأَشْهَدُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ كَانَ يُصْبِحُ  جُنُبًا  مِنْ جِمَاعٍ غَيْرِ احْتِلَامٍ ، ثُمَّ يَصُومُ ذَلِكَ الْيَوْمَ  .         [2/103]      قَالَ : ثُمَّ خَرَجْنَا حَتَّى دَخَلْنَا عَلَى أُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا فَسَأَلَهَا ، عَنْ ذَلِكَ ، فَقَالَتْ كَمَا قَالَتْ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا ، فَخَرَجْنَا حَتَّى جِئْنَا إِلَى  مَرْوَانَ  ، فَذَكَرَ لَهُ  عَبْدُ الرَّحْمَنِ  مَا قَالَتَا ، فَقَالَ  مَرْوَانُ  : أَقْسَمْتُ عَلَيْكَ يَا  أَبَا مُحَمَّدٍ  لَتَرْكَبَنَّ دَابَّتِي ؛ فَإِنَّهَا بِالْبَابِ ، فَلَتَذْهَبَنَّ إِلَى  أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ بِأَرْضِهِ  بِالْعَقِيقِ  ، فَلَتُخْبِرَنَّهُ بِذَلِكَ ، فَرَكِبَ  عَبْدُ الرَّحْمَنِ  وَرَكِبْتُ مَعَهُ حَتَّى أَتَيْنَا  أَبَا هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ ، فَتَحَدَّثَ مَعَهُ  عَبْدُ الرَّحْمَنِ  سَاعَةً ، ثُمَّ ذَكَرَ ذَلِكَ لَهُ ، فَقَالَ  أَبُو هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ : ( لَا عِلْمَ لِي بِذَلِكَ ، إِنَّمَا أَخْبَرَنِيهِ مُخْبِرٌ )  .","","Sharh Ma'ani al-Athar 3450","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن سمي المخزومي عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3242","3451  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ عَوْنٍ ،  عَنْ  رَجَاءِ بْنِ حَيْوَةَ ،  عَنْ  يَعْلَى بْنِ عُقْبَةَ ، قَالَ :  أَصْبَحْتُ  جُنُبًا  وَأَنَا أُرِيدُ الصَّوْمَ ، فَأَتَيْتُ أَبَا هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، فَسَأَلْتُهُ فَقَالَ لِي : "" أَفْطِرْ "" ، فَأَتَيْتُ  مَرْوَانَ  فَسَأَلْتُهُ وَأَخْبَرْتُهُ بِقَوْلِ  أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ ، فَبَعَثَ عَبْدَ الرَّحْمَنِ بْنَ الْحَارِثِ إِلَى عَائِشَةَ رَضِيَ اللهُ عَنْهَا ،  فَسَأَلَهَا  فَقَالَتْ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْرُجُ لِصَلَاةِ الْفَجْرِ وَرَأْسُهُ يَقْطُرُ مِنْ جِمَاعٍ  ، ثُمَّ يَصُومُ ذَلِكَ الْيَوْمَ ، فَرَجَعَ إِلَى  مَرْوَانَ  فَأَخْبَرَهُ ، فَقَالَ : إِيتِ  أَبَا هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ ، فَأَخْبِرْهُ ، فَأَتَاهُ فَأَخْبَرَهُ ، فَقَالَ : ( أَمَا إِنِّي لَمْ أَسْمَعْهُ مِنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِنَّمَا  حَدَّثَنِيهِ  الْفَضْلُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ) .","","Sharh Ma'ani al-Athar 3451","","الفضل بن العباس بن عبد المطلب الهاشمي عن أبو هريرة الدوسي عن يعلى بن عقبة المكي عن رجاء بن حيوة عن عبد الله بن عون بن أرطبان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3243","3452  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  أَنَا  ابْنُ عَوْنٍ ، فَذَكَرَ  بِإِسْنَادِهِ  نَحْوَهُ .  قَالَ  ابْنُ عَوْنٍ  : فَقُلْتُ  لِرَجَاءٍ  : مَنْ حَدَّثَكَ عَنْ  يَعْلَى  ؟ قَالَ : إِيَّايَ حَدَّثَ  يَعْلَى  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ ذَاهِبُونَ إِلَى مَا رَوَى  أَبُو هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ مِنْ ذَلِكَ ، عَنِ  الْفَضْلِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا بِهِ وَقَلَّدُوهُ ، وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : يَغْتَسِلُ وَيَصُومُ يَوْمَهُ ذَلِكَ ، وَذَهَبُوا فِي ذَلِكَ إِلَى مَا رُوِّينَاهُ فِي الْفَصْلِ الْأَوَّلِ عَنْ  عَائِشَةَ  وَأُمِّ سَلَمَةَ  رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Sharh Ma'ani al-Athar 3452","","الفضل بن العباس بن عبد المطلب الهاشمي عن أبو هريرة الدوسي عن يعلى بن عقبة المكي عن رجاء بن حيوة عن عبد الله بن عون بن أرطبان عن يزيد بن هارون عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3244","3453  -  وَإِلَى مَا  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  حَدَّثَنَا  أَبُو دَاوُدَ وَرَوْحٌ قَالَا :  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ، قَالَ :  سَمِعْتُ  أَبَا بَكْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ  يُحَدِّثُ ، عَنْ  أَبِيهِ  ، قَالَ :  دَخَلْتُ عَلَى عَائِشَةَ رَضِيَ اللهُ عَنْهَا زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَأَخْبَرَتْنِي  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصْبِحُ  جُنُبًا  ثُمَّ يَغْتَسِلُ  ، ثُمَّ يَغْدُو إِلَى الْمَسْجِدِ وَرَأْسُهُ يَقْطُرُ ، ثُمَّ يَصُومُ ذَلِكَ الْيَوْمَ فَأَخْبَرْتُهُ  مَرْوَانَ  ، فَقَالَ : إِيتِ  أَبَا هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ فَأَخْبِرْهُ بِذَلِكَ ، فَقُلْتُ : إِنَّهُ لِي صَدِيقٌ فَأَعْفِنِي ، فَقَالَ : عَزَمْتُ عَلَيْكَ لَتَأْتِيَنَّهُ ، فَانْطَلَقْتُ أَنَا وَأَبِي إِلَى  أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ ، فَأَخْبَرْتُ بِذَلِكَ .  فَقَالَ  أَبُو هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ :  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا أَعْلَمُ مِنِّي .         [2/104]      قَالَ  شُعْبَةُ  : وَفِي الصَّحِيفَةِ : "" أَعْلَمُ بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنِّي  .","","Sharh Ma'ani al-Athar 3453","","عائشة بنت أبي بكر الصديق عن عبد الرحمن بن الحارث بن هشام المخزومي عن أبو بكر بن عبد الرحمن راهب قريش عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3245","3454  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  عَبْدُ الْوَهَّابِ ، قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَخِيهِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ  ،  أَنَّهُ كَانَ يَصُومُ وَلَا يُفْطِرُ ، فَدَخَلَ عَلَى أَبِيهِ يَوْمًا وَهُوَ مُفْطِرٌ ، فَقَالَ لَهُ : مَا شَأْنُكَ الْيَوْمَ مُفْطِرًا ؟ قَالَ : إِنِّي أَصَابَتْنِي جَنَابَةٌ فَلَمْ أَغْتَسِلْ حَتَّى أَصْبَحْتُ ، فَأَفْتَانِي  أَبُو هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ أَنْ أُفْطِرَ ، فَأَرْسَلُوا إِلَى عَائِشَةَ رَضِيَ اللهُ عَنْهَا يَسْأَلُونَهَا ،  فَقَالتْ  :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تُصِيبُهُ الْجَنَابَةُ ، فَيَغْتَسِلُ بَعْدَ مَا يُصْبِحُ  ، ثُمَّ يَخْرُجُ وَرَأْسُهُ يَقْطُرُ مَاءً ، فَيُصَلِّي لِأَصْحَابِهِ ، ثُمَّ يَصُومُ ذَلِكَ الْيَوْمَ  .","","Sharh Ma'ani al-Athar 3454","","عائشة بنت أبي بكر الصديق عن أبو بكر بن عبد الرحمن راهب قريش عن عمر بن عبد الرحمن بن الحارث المخزومي عن الشعبي عن داود بن أبي هند عن عبد الوهاب بن عطاء الخفاف عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3246","3455  -  حَدَّثَنَا  عَلِيٌّ ، قَالَ :  ثَنَا  عَبْدُ الْوَهَّابِ ، قَالَ :  ثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ رَبِّهِ ،  عَنْ  أَبِي عِيَاضٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  أَنَّ  مَرْوَانَ بْنَ الْحَكَمِ  بَعَثَهُ إِلَى  أُمِّ سَلَمَةَ  وَعَائِشَةَ  رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  فَلَقِيتُ  غُلَامَهَا نَافِعًا - يَعْنِي - أُمَّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا ، قَالَ : فَأَرْسَلْتُهُ إِلَيْهَا ، فَرَجَعَ إِلَيَّ  فَأَخْبَرَنِي  أَنَّهَا قَالَتْ  : إِنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصْبِحُ  جُنُبًا  مِنْ غَيْرِ احْتِلَامٍ  ، ثُمَّ يُصْبِحُ صَائِمًا ، ثُمَّ أَتَى عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، فَأَرْسَلَ إِلَيْهَا غُلَامَهَا ذَكْوَانَ أَبَا عَمْرٍو ،  فَأَخْبَرَتْهُ  أَنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يُصْبِحُ  جُنُبًا  مِنْ غَيْرِ احْتِلَامٍ ، ثُمَّ يُصْبِحُ صَائِمًا .  فَأَتَيْتُ  مَرْوَانَ بْنَ الْحَكَمِ  فَأَخْبَرْتُهُ بِقَوْلِهِمَا ، فَقَالَ : ( أَقْسَمْتُ عَلَيْكَ لَتَأْتِيَنَّ  أَبَا هُرَيْرَةَ  ، فَلَتُخْبِرَنَّهُ بِقَوْلِهِمَا ، فَأَتَيْتُهُ فَأَخْبَرْتُهُ ) ، فَقَالَ : ( هُنَّ أَعْلَمُ ) .","","Sharh Ma'ani al-Athar 3455","","عائشة بنت أبي بكر الصديق عن ذكوان مولى عائشة بنت أبي بكر عن عبد الرحمن بن الحارث بن هشام المخزومي عن أبو عياض المدني صاحب علي عن عبد ربه بن أبي يزيد عن أبي عياض عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الوهاب بن عطاء الخفاف عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3247","3456  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  سُمَيٍّ ،  عَنْ  أَبِي بَكْرٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصْبِحُ  جُنُبًا  ، ثُمَّ يَصُومُ ذَلِكَ الْيَوْمَ  .","","Sharh Ma'ani al-Athar 3456","","عائشة بنت أبي بكر الصديق عن أبو بكر بن عبد الرحمن راهب قريش عن سمي المخزومي عن سفيان بن عيينة عن يونس بن عبد الأعلى عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3248","3457  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ ، قَالَ :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ :  قَالَتْ  عَائِشَةُ رَضِيَ اللهُ عَنْهَا :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْرُجُ إِلَى صَلَاةِ الْفَجْرِ وَرَأْسُهُ يَقْطُرُ مِنْ  غُسْلِ  الْجَنَابَةِ  ، ثُمَّ يَصُومُ يَوْمَهُ  .","","Sharh Ma'ani al-Athar 3457","","عائشة بنت أبي بكر الصديق عن أبو بكر بن عبد الرحمن راهب قريش عن عمارة بن عمير التيمي عن الأعمش عن سلام بن سليم الحنفي عن الحسن بن الربيع البوراني عن فهد بن سليمان الدلال عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3249","3458  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  ابْنُ شِهَابٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ وَأُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهُمَا زَوْجَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُدْرِكُهُ الْفَجْرُ وَهُوَ  جُنُبٌ  ، ثُمَّ يَصُومُ  .","","Sharh Ma'ani al-Athar 3458","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن الزهري عن ابن جريج عن أبو عاصم النبيل عن بكار بن قتيبة البكراوي عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3250","[2/105]      3459  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو الْوَلِيدِ ، قَالَ :  ثَنَا  لَيْثُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ وَأُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهُمَا زَوْجَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُمَا حَدَّثَتَاهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3459","","هند بنت أبي أمية زوج رسول الله عن عبد الرحمن بن الحارث بن هشام المخزومي عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الملك بن أبي بكر المخزومي عن الزهري عن الليث بن سعد عن أبو الوليد الطيالسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3251","3460  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ وَأُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِهِ ، وَزَادَ : ( فِي رَمَضَانَ ) .","","Sharh Ma'ani al-Athar 3460","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد ربه بن سعيد النجاري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3252","3461  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  سُمَيٍّ ،  عَنْ  أَبِي بَكْرٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3461","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن سمي المخزومي عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3253","3462  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو غَسَّانَ ، قَالَ :  ثَنَا  زُهَيْرٌ ، قَالَ :  ثَنَا  أَبُو إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ .","","Sharh Ma'ani al-Athar 3462","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن مالك بن إسماعيل النهدي عن فهد بن سليمان الدلال عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3254","3463  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ، قَالَ :  ثَنَا  زَائِدَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِذَلِكَ .","","Sharh Ma'ani al-Athar 3463","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن زائدة بن قدامة عن أحمد بن عبد الله اليربوعي عن فهد بن سليمان الدلال عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3255","3464  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ، قَالَ :  أَنَا  عَاصِمُ بْنُ بَهْدَلَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِذَلِكَ .","","Sharh Ma'ani al-Athar 3464","","عائشة بنت أبي بكر الصديق عن ذكوان السمان عن عاصم بن بهدلة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3256","3465  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ ، قَالَ :  ثَنَا  جَعْفَرُ بْنُ عَبْدِ اللهِ بْنِ عُثْمَانَ الْقُرَشِيُّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِذَلِكَ .","","Sharh Ma'ani al-Athar 3465","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن جعفر بن عبد الله بن عثمان الحميدي عن أبو داود الطيالسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3257","3466  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ عَطَاءٍ ، قَالَ :  أَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَامِرِ بْنِ أَبِي أُمَيَّةَ ،  عَنْ  أُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِذَلِكَ أَيْضًا .","","Sharh Ma'ani al-Athar 3466","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الوهاب بن عطاء الخفاف عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3258","3467  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو الْوَلِيدِ ، قَالَ :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3467","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن همام بن يحيى بن دينار عن أبو الوليد الطيالسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3259","3468  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3468","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3260","3469  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ . (  ح  ) .  3470  -  وَحَدَّثَنَا  يَزِيدُ - هُوَ ابْنُ سِنَانٍ - قَالَ :  ثَنَا  يَحْيَى الْقَطَّانُ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  وَزَادَ : ( فَرَدَّ  أَبُو هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ فُتْيَاهُ عَلَى هَذَا الْخَبَرِ ) .  قَالُوا :  فَلَمَّا تَوَاتَرَتِ الْآثَارُ بِمَا ذَكَرْنَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَجُزْ لَنَا خِلَافُ ذَلِكَ إِلَى غَيْرِهِ ، فَكَانَ مِنْ حُجَّةِ أَهْلِ الْمَقَالَةِ الْأُولَى عَلَيْهِمْ فِي ذَلِكَ أَنْ قَالُوا : هَذَا الَّذِي رَوَتْهُ  أُمُّ سَلَمَةَ  وَعَائِشَةُ  رَضِيَ اللهُ عَنْهُمَا ، إِنَّمَا أَخْبَرَتَا بِهِ ، عَنْ فِعْلِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَخْبَرَ  الْفَضْلُ  فِي حَدِيثِ  أَبِي هُرَيْرَةَ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا قَدْ خَالَفَ ذَلِكَ ، فَقَدْ يَجُوزُ أَنْ يَكُونَ كَانَ حُكْمُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ عَلَى مَا ذَكَرَتْ  عَائِشَةُ  وَأُمُّ سَلَمَةَ  رَضِيَ اللهُ عَنْهُمَا فِي حَدِيثِهِمَا ، وَيَكُونُ حُكْمُ سَائِرِ النَّاسِ عَلَى مَا ذَكَرَهُ  الْفَضْلُ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَيَكُونُ الْخَبَرَانِ غَيْرَ مُتَضَادَّيْنِ عَلَى مَا يُخَرَّجُ عَلَيْهِ مَعَانِي الْآثَارِ .  فَكَانَ مِنَ الْحُجَّةِ لِلْآخَرَيْنِ عَلَيْهِمْ أَنَّ  أَبَا هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ هُوَ الَّذِي رَوَى حَدِيثَ الْفَضْلِ ، وَقَدْ رَجَعَ عَنْ فُتْيَاهُ         [2/106]      إِلَى قَوْلِ  عَائِشَةَ  وَأُمِّ سَلَمَةَ  رَضِيَ اللهُ عَنْهُمَا ، وَعَدَّ ذَلِكَ أَوْلَى مِمَّا حَدَّثَهُ  الْفَضْلُ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَهَذَا حُجَّةٌ فِي هَذَا الْبَابِ ، وَحُجَّةٌ أُخْرَى : أَنَّا قَدْ وَجَدْنَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا يَدُلُّ عَلَى حُكْمِ النَّاسِ فِي ذَلِكَ أَيْضًا كَحُكْمِهِ  .","","Sharh Ma'ani al-Athar 3469","","هند بنت أبي أمية زوج رسول الله عن عامر بن أبي أمية المخزومي عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن يحيى القطان عن يزيد بن سنان القزاز عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3261","3471  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  عَبْدِ اللهِ بْنِ مَعْمَرٍ الْأَنْصَارِيِّ ،  عَنْ  أَبِي يُونُسَ مَوْلَى عَائِشَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّ  رَجُلًا  قَالَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ وَاقِفٌ عَلَى الْبَابِ وَأَنَا أَسْمَعُ يَا رَسُولَ اللهِ - : إِنِّي أُصْبِحُ  جُنُبًا  وَأَنَا أُرِيدُ الصَّوْمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَأَنَا أُصْبِحُ  جُنُبًا  ، وَأَنَا أُرِيدُ الصَّوْمَ  ، فَأَغْتَسِلُ وَأَصُومُ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّكَ لَسْتَ مِثْلَنَا ؛ قَدْ غَفَرَ اللهُ لَكَ مَا تَقَدَّمَ مِنْ ذَنْبِكَ وَمَا تَأَخَّرَ ، فَغَضِبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" وَاللهِ إِنِّي لَأَرْجُو أَنْ أَكُونَ أَخْشَاكُمْ لِلهِ وَأَعْلَمَكُمْ بِمَا أَتَّقِي  .  فَلَمَّا كَانَ جَوَابُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِذَلِكَ السَّائِلِ هُوَ إِخْبَارُهُ عَنْ فِعْلِ نَفْسِهِ فِي ذَلِكَ ، ثَبَتَ بِذَلِكَ أَنَّ حُكْمَهُ فِي ذَلِكَ وَحُكْمَ غَيْرِهِ سَوَاءٌ ، فَهَذَا وَجْهُ هَذَا الْبَابِ مِنْ طَرِيقِ تَصْحِيحِ مَعَانِي الْآثَارِ ، وَأَمَّا وَجْهُهُ مِنْ طَرِيقِ النَّظَرِ فِي ذَلِكَ فَإِنَّا قَدْ رَأَيْنَاهُمْ أَجْمَعُوا أَنَّ صَائِمًا لَوْ نَامَ نَهَارًا فَأَجْنَبَ ، أَنَّ ذَلِكَ لَا يُخْرِجُهُ عَنْ صَوْمِهِ ، فَأَرَدْنَا أَنْ نَنْظُرَ أَنَّهُ : هَلْ يَكُونُ دَاخِلًا فِي الصَّوْمِ وَهُوَ كَذَلِكَ ؟ أَوْ يَكُونُ حُكْمُ الْجَنَابَةِ إِذَا طَرَأَتْ عَلَى الصَّوْمِ خِلَافَ حُكْمِ الصَّوْمِ إِذَا طَرَأَ عَلَيْهَا ؟ فَرَأَيْنَا الْأَشْيَاءَ الَّتِي تَمْنَعُ مِنَ الدُّخُولِ فِي الصَّوْمِ مِنَ الْحَيْضِ وَالنِّفَاسِ إِذَا طَرَأَ ذَلِكَ عَلَى الصَّوْمِ أَوْ طَرَأَ عَلَيْهِ الصَّوْمُ ، فَهُوَ سَوَاءٌ ، أَلَا تَرَى أَنَّهُ لَيْسَ لِحَائِضٍ أَنْ تَدْخُلَ فِي الصَّوْمِ وَهِيَ حَائِضٌ ، وَأَنَّهَا لَوْ دَخَلَتْ فِي الصَّوْمِ طَاهِرًا ، ثُمَّ طَرَأَ عَلَيْهَا الْحَيْضُ فِي ذَلِكَ الْيَوْمِ أَنَّهَا بِذَلِكَ خَارِجَةٌ مِنَ الصَّوْمِ ، فَكَانَتِ الْأَشْيَاءُ الَّتِي تَمْنَعُ مِنَ الدُّخُولِ فِي الصَّوْمِ هِيَ الْأَشْيَاءُ الَّتِي إِذَا طَرَأَتْ عَلَى الصَّوْمِ أَبْطَلَتْهُ .         [2/107]      وَكَانَتِ الْجَنَابَةُ إِذَا طَرَأَتْ عَلَى الصَّوْمِ بِاتِّفَاقِهِمْ جَمِيعًا لَمْ تُبْطِلْهُ ، فَالنَّظَرُ عَلَى مَا ذَكَرْنَا أَنْ يَكُونَ كَذَلِكَ إِذَا طَرَأَ عَلَيْهَا الصَّوْمُ لَمْ تَمْنَعْ مِنَ الدُّخُولِ فِيهِ ، فَثَبَتَ بِذَلِكَ مَا قَدْ وَافَقَ مَا رَوَتْهُ  أُمُّ سَلَمَةَ  وَعَائِشَةُ  رَضِيَ اللهُ عَنْهَا ، وَهَذَا قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى  .","","Sharh Ma'ani al-Athar 3471","","عائشة بنت أبي بكر الصديق عن أبو يونس المدني مولى عائشة عن عبد الله بن عبد الرحمن بن معمر الأنصاري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الرجل يصبح في يوم من شهر رمضان جنبا هل يصوم"
"3262","14 - بَابٌ : الرَّجُلُ يَدْخُلُ فِي الصِّيَامِ تَطَوُّعًا ، ثُمَّ يُفْطِرُ  3472  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ . (  ح  ) .  3473  -  وَحَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ . (  ح  ) .  3474  -  وَحَدَّثَنَا  يُونُسُ بْنُ عَبْدِ الْأَعْلَى ، قَالَ :  ثَنَا  يَحْيَى بْنُ حَسَّانَ قَالُوا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  هَارُونَ بْنِ أُمِّ هَانِئٍ أَوِ ابْنِ بِنْتِ أُمِّ هَانِئٍ  ،  عَنْ  أُمِّ هَانِئٍ  قَالَتْ :  دَخَلْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا صَائِمَةٌ ، فَنَاوَلَنِي فَضْلَ شَرَابِهِ فَشَرِبْتُ ، ثُمَّ قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي كُنْتُ صَائِمَةً ، وَإِنِّي كَرِهْتُ أَنْ أَرُدَّ  سُؤْرَكَ  ، فَقَالَ :  إِنْ كَانَ مِنْ قَضَاءِ يَوْمٍ مِنْ رَمَضَانَ فَصُومِي يَوْمًا مَكَانَهُ  ، وَإِنْ كَانَ تَطَوُّعًا فَإِنْ شِئْتِ فَاقْضِيهِ ، وَإِنْ شِئْتِ فَلَا تَقْضِيهِ  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى هَذَا ، فَزَعَمُوا أَنَّ مَنْ دَخَلَ فِي صَوْمٍ تَطَوُّعًا ، ثُمَّ أَفْطَرَ بَعْدَ ذَلِكَ مِنْ عُذْرٍ أَوْ مِنْ غَيْرِ عُذْرٍ ، أَنَّهُ لَا قَضَاءَ عَلَيْهِ ، وَاحْتَجُّوا فِي ذَلِكَ بِهَذَا الْحَدِيثِ ، وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : عَلَيْهِ قَضَاءُ يَوْمٍ مَكَانَهُ ، وَكَانَ مِنَ الْحُجَّةِ لَهُمْ عَلَى أَهْلِ الْمَقَالَةِ الْأُولَى أَنَّ حَدِيثَ  أُمِّ هَانِئٍ  إِنَّمَا رَوَاهُ - كَمَا ذَكَرُوا -  حَمَّادُ بْنُ سَلَمَةَ  ، وَقَدْ رَوَاهُ غَيْرُهُ مِمَّنْ لَيْسَ فِي الضَّبْطِ بِدُونِهِ عَلَى خِلَافِ ذَلِكَ  .","","Sharh Ma'ani al-Athar 3472","","فاختة الهاشمية أخت علي بن أبي طالب عن هارون ابن ابن أم هانئ عن سماك بن حرب البكري عن حماد بن سلمة عن يحيى بن حسان بن حيان التنيسي عن يونس بن عبد الأعلى عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3263","3475  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ، قَالَ :  ثَنَا  مُسَدَّدٌ . (  ح  ) .  3476  -  وَحَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْمُقَدَّمِيُّ ، قَالَا :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  ابْنِ ابْنِ أُمِّ هَانِئٍ ،  عَنْ  جَدَّتِهِ أُمِّ هَانِئٍ  ، سَمِعَهُ مِنْهَا قَالَتْ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ بِشَرَابٍ  يَوْمَ فَتْحِ مَكَّةَ  ، فَنَاوَلَنِي فَشَرِبْتُهُ ، وَكُنْتُ صَائِمَةً ، فَكَرِهْتُ أَنْ أَرُدَّ فَضْلَ  سُؤْرِهِ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي كُنْتُ صَائِمَةً ، فَقَالَ لَهَا :  تَقْضِينَ عَنْكِ شَيْئًا  ؟ قَالَتْ : لَا . قَالَ : فَلَا يَضُرُّكِ  .","","Sharh Ma'ani al-Athar 3475","","فاختة الهاشمية أخت علي بن أبي طالب عن هارون ابن ابن أم هانئ عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن أبي بكر المقدمي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3264","3477  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَ :  ثَنَا  أَبُو عَوَانَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3477","","فاختة الهاشمية أخت علي بن أبي طالب عن هارون ابن ابن أم هانئ عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن أسد السنة عن سليمان بن شعيب الكيساني عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3265","3478  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  الرَّجُلِ         [2/108]      مِنْ آلِ جَعْدَةَ بْنِ هُبَيْرَةَ ،  عَنْ  جَدَّتِهِ أُمِّ هَانِئٍ  ، قَالَتْ :  دَخَلْتُ أَنَا  وَفَاطِمَةُ  رَضِيَ اللهُ عَنْهَا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ  فَتْحِ مَكَّةَ  ، فَجَلَسْتُ عَنْ يَمِينِهِ ، فَدَعَا بِشَرَابٍ فَشَرِبَ ، ثُمَّ نَاوَلَنِي فَشَرِبْتُ وَأَنَا صَائِمَةٌ ، فَقُلْتُ : يَا رَسُولَ اللهِ مَا أُرَانِي إِلَّا قَدْ  أَثِمْتُ ، أَوْ أَتَيْتُ حِنْثًا  ، عَرَضْتَ عَلَيَّ وَأَنَا صَائِمَةٌ فَكَرِهْتُ أَنْ أَرُدَّ عَلَيْكَ . فَقَالَ :  هَلْ كُنْتِ تَقْضِينَ يَوْمًا مِنْ رَمَضَانَ  ؟ "" فَقَالَتْ : لَا . قَالَ : "" فَلَا بَأْسَ "" .","","Sharh Ma'ani al-Athar 3478","","فاختة الهاشمية أخت علي بن أبي طالب عن الرجل من آل جعدة بن هبيرة عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن أسد السنة عن سليمان بن شعيب الكيساني عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3266","3479  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ . (  ح  ) .  3480  -  وَحَدَّثَنَا  رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكٍ ،  عَنِ  ابْنِ أُمِّ هَانِئٍ ،  عَنْ  أُمِّ هَانِئٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ . غَيْرَ أَنَّهُ قَالَ : (  فَلَا يَضُرُّكِ  ) .  فَقَدْ خَالَفَ مَا رَوَى  قَيْسٌ  وَأَبُو عَوَانَةَ  وَأَبُو الْأَحْوَصِ  مَا رَوَى  حَمَّادُ بْنُ سَلَمَةَ  ؛ لِأَنَّ  حَمَّادًا  قَالَ فِي حَدِيثِهِ : إِنْ كَانَ قَضَاءً مِنْ شَهْرِ رَمَضَانَ فَصُومِي يَوْمًا مَكَانَهُ ، وَإِنْ كَانَ تَطَوُّعًا فَإِنْ شِئْتِ فَاقْضِيهِ ، وَإِنْ شِئْتِ فَلَا تَقْضِيهِ .  فَكَانَ ذَلِكَ عَلَى أَنَّهُ لَا يَجِبُ الْقَضَاءُ عَلَيْهَا إِذَا كَانَ تَطَوُّعًا ، وَقَالَ الْآخَرُونَ فِي حَدِيثِهِمْ : أَتَقْضِينَ شَيْئًا مِنْ رَمَضَانَ ؟ قَالَتْ : لَا . قَالَ : فَلَا يَضُرُّكِ ، أَيْ : أَنَّكِ لَسْتِ بِآثِمَةٍ فِي إِفْطَارِكِ مِنْ هَذَا التَّطَوُّعِ ، وَلَيْسَ فِي ذَلِكَ مَا يَنْفِي أَنْ يَكُونَ عَلَيْهَا قَضَاءُ يَوْمٍ مَكَانَهُ ، فَقَدِ  اضْطَرَبَ  حَدِيثُ  سِمَاكٍ  هَذَا ، ثُمَّ نَظَرْنَا هَلْ رَوَى عَنْ غَيْرِهِ مِمَّا فِيهِ دَلَالَةٌ عَلَى شَيْءٍ مِنْ ذَلِكَ  ؟ .","","Sharh Ma'ani al-Athar 3479","","فاختة الهاشمية أخت علي بن أبي طالب عن هارون ابن ابن أم هانئ عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن يوسف بن عدي بن رزق الكوفي عن روح بن الفرج القطان عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3267","3481  -  فَإِذَا رَبِيعٌ الْجِيزِيُّ قَدْ  حَدَّثَنَا  ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ مَسْلَمَةَ الْقَعْنَبِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ الْعُمَرِيُّ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  أَصْبَحْتُ أَنَا  وَحَفْصَةُ  رَضِيَ اللهُ عَنْهَا صَائِمَتَيْنِ مُتَطَوِّعَتَيْنِ ، فَأُهْدِيَ لَنَا طَعَامٌ ، فَأَفْطَرْنَا عَلَيْهِ ، فَدَخَلَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَسَأَلْنَاهُ ، فَقَالَ :  اقْضِيَا يَوْمًا مَكَانَهُ  .  فَفِي هَذَا دَلِيلٌ عَلَى أَنَّ حُكْمَ الْإِفْطَارِ فِي الصَّوْمِ التَّطَوُّعِ أَنَّهُ مُوجِبٌ لِلْقَضَاءِ ، فَكَانَ مِمَّا يَحْتَجُّ بِهِ أَهْلُ الْمَقَالَةِ الْأُولَى فِي فَسَادِ هَذَا الْحَدِيثِ أَنَّ أَصْلَهُ لَيْسَ عَنْ  عُرْوَةَ  ، عَنْ  عَائِشَةَ  ، وَإِنَّمَا أَصْلُهُ  مَوْقُوفٌ  عَلَى مَنْ دُونَ  عُرْوَةَ  .","","Sharh Ma'ani al-Athar 3481","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن عبد الله بن عمر العمري عن عبد الله بن مسلمة القعنبي عن الربيع بن سليمان الجيزي عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3268","3482  - وَذَلِكَ أَنَّ يُونُسَ  حَدَّثَنَا  ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنِ  ابْنِ شِهَابٍ ،  أَنَّ  عَائِشَةَ وَحَفْصَةَ رَضِيَ اللهُ عَنْهُمَا أَصْبَحَتَا صَائِمَتَيْنِ ، ثُمَّ ذَكَرَ مِثْلَهُ .  قَالُوا : فَهَذَا هُوَ أَصْلُ الْحَدِيثِ ، قَالُوا : وَقَدْ سُئِلَ  الزُّهْرِيُّ  عَنْ ذَلِكَ : هَلْ سَمِعَهُ مِنْ  عُرْوَةَ  ؟ فَقَالَ : لَا .  وَذَكَرُوا مَا  3483  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ  ، قَالَ : ثَنَا  نُعَيْمٌ  ، قَالَ : سَمِعْتُ  ابْنَ عُيَيْنَةَ  يَقُولُ : ( سُئِلَ  الزُّهْرِيُّ  ) عَنْ حَدِيثِ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا : ( أَصْبَحْتُ أَنَا  وَحَفْصَةُ  رَضِيَ اللهُ عَنْهَا صَائِمَتَيْنِ ) . فَقِيلَ لَهُ : أَحَدَّثَكَ  عُرْوَةُ  ؟ فَقَالَ : لَا  .","","Sharh Ma'ani al-Athar 3482","","حفصة بنت عمر بن الخطاب عن الزهري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3269","[2/109]      3484  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  قُلْتُ  لِابْنِ شِهَابٍ :  أَحَدَّثَكَ  عُرْوَةُ بْنُ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  مَنْ أَفْطَرَ مِنْ تَطَوُّعِهِ فَلْيَقْضِهِ  ؟  فَقَالَ : لَمْ أَسْمَعْ مِنْ  عُرْوَةَ  فِي ذَلِكَ شَيْئًا ، وَلَكِنْ حُدِّثْتُ فِي خِلَافَةِ  سُلَيْمَانَ بْنِ عَبْدِ الْمَلِكِ  .","","Sharh Ma'ani al-Athar 3484","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن ابن جريج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3270","3485  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ . وَزَادَ : ( وَلَكِنْ حَدَّثَنِي فِي خِلَافَةِ  سُلَيْمَانَ بْنِ عَبْدِ الْمَلِكِ  أُنَاسٌ عَنْ بَعْضِ مَنْ كَانَ يَسْأَلُ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا ) أَنَّهَا قَالَتْ : ( أَصْبَحْتُ أَنَا  وَحَفْصَةُ  رَضِيَ اللهُ عَنْهَا صَائِمَتَيْنِ ) ،  ثُمَّ ذَكَرَ الْحَدِيثَ ، يَعْنِي نَحْوَ حَدِيثِ  رَبِيعٍ الْجِيزِيِّ  .  فَقَدْ فَسَدَ هَذَا الْحَدِيثُ بِمَا قَدْ دَخَلَ فِي  إِسْنَادِهِ  مِمَّا ذَكَرْنَا .  وَقَدْ رُوِيَ فِي ذَلِكَ عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا أَيْضًا مِنْ غَيْرِ هَذَا الْوَجْهِ مَا","","Sharh Ma'ani al-Athar 3485","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن ابن جريج عن روح بن عبادة القيسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3271","3486  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  عَمِّي عَبْدُ اللهِ بْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، فَذَكَرَ مِثْلَ حَدِيثِ  رَبِيعٍ الْجِيزِيِّ  . غَيْرَ أَنَّهُ قَالَ : (  فَبَدَرَتْنِي  حَفْصَةُ  رَضِيَ اللهُ عَنْهَا بِالْكَلَامِ ، وَكَانَتِ ابْنَةَ  أَبِيهَا  ) .","","Sharh Ma'ani al-Athar 3486","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن جرير بن حازم عن عبد الله بن وهب المصري عن أحمد بن عبد الرحمن بن وهب عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3272","3487  -  حَدَّثَنَا  ابْنُ أَبِي عِمْرَانَ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ عِيسَى الْمِصْرِيُّ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَكَانَ مِمَّا احْتَجَّ بِهِ أَهْلُ الْمَقَالَةِ الْأُولَى فِي إِفْسَادِ هَذَا الْحَدِيثِ أَيْضًا أَنَّ  حَمَّادَ بْنَ زَيْدٍ  قَدْ رَوَاهُ ، عَنْ  يَحْيَى بْنِ سَعِيدٍ  مَوْقُوفًا  ، لَيْسَ فِيهِ  عَمْرَةُ  .","","Sharh Ma'ani al-Athar 3487","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن جرير بن حازم عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن أحمد بن أبي عمران البغدادي عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3273","3488  -  حَدَّثَنَا  بِذَلِكَ ابْنُ أَبِي عِمْرَانَ ، قَالَ :  ثَنَا  أَبُو بَكْرَةَ  الرَّمَادِيُّ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ بِذَلِكَ ، يَعْنِي : وَلَمْ يَذْكُرْ  عَمْرَةَ  .  فَهَذَا هُوَ أَصْلُ الْحَدِيثِ .  وَقَدْ رُوِيَ عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا أَيْضًا فِي هَذَا ، مِنْ غَيْرِ هَذَا الْوَجْهِ مَا  كذا في طبعة عالم الكتب ، ولعل الصواب: (أبو بكر ) ، والله أعلم .","","Sharh Ma'ani al-Athar 3488","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن علي ابن المديني عن أحمد بن منصور الرمادي عن أحمد بن أبي عمران البغدادي عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3274","3489  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ يَحْيَى الْمُزَنِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ إِدْرِيسَ الشَّافِعِيُّ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى بْنِ طَلْحَةَ ،  عَنْ  عَمَّتِهِ عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّا قَدْ خَبَأْنَا لَكَ حَيْسًا ، فَقَالَ :  أَمَا إِنِّي كُنْتُ أُرِيدُ الصَّوْمَ ، وَلَكِنْ قَرِّبِيهِ سَأَصُومُ يَوْمًا مَكَانَ ذَلِكَ  .  قَالَ  مُحَمَّدٌ - هُوَ ابْنُ إِدْرِيسَ  - : سَمِعْتُ  سُفْيَانَ  عَامَّةَ مُجَالَسَتِي إِيَّاهُ لَا يَذْكُرُ فِيهِ : سَأَصُومُ يَوْمًا مَكَانَ ذَلِكَ ، ثُمَّ إِنِّي عَرَضْتُ عَلَيْهِ الْحَدِيثَ قَبْلَ أَنْ يَمُوتَ بِسَنَةٍ ، فَأَجَازَ فِيهِ : سَأَصُومُ يَوْمًا مَكَانَ ذَلِكَ .         [2/110]      فَفِي هَذَا الْحَدِيثِ ذَكَرَ وُجُوبَ الْقَضَاءِ ، وَفِي حَدِيثِ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا مَا قَدْ وَافَقَ ذَلِكَ ، وَلَيْسَ فِي حَدِيثِ  أُمِّ هَانِئٍ  مَا يُخَالِفُ مَا قَدْ ذَكَرْنَا ، فَأَقَلُّ أَحْوَالِ حَدِيثِ  عُرْوَةَ  وَعَمْرَةَ  عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا أَنْ يَكُونَ  مَوْقُوفًا  عَلَى مَنْ هُوَ دُونَهُمَا ، وَقَدْ وَافَقَهُ حَدِيثٌ  مُتَّصِلٌ  ، وَهُوَ حَدِيثُ  عَائِشَةَ بِنْتِ طَلْحَةَ  ، فَالْقَوْلُ بِذَلِكَ مِنْ جِهَةِ الْحَدِيثِ أَوْلَى مِنَ الْقَوْلِ بِخِلَافِهِ ، وَأَمَّا النَّظَرُ فِي ذَلِكَ فَإِنَّا قَدْ رَأَيْنَا أَشْيَاءَ تَجِبُ عَلَى الْعِبَادِ بِإِيجَابِهِمْ إِيَّاهَا عَلَى أَنْفُسِهِمْ ؛ مِنْهَا الصَّلَاةُ وَالصَّدَقَةُ وَالصِّيَامُ وَالْحَجُّ وَالْعُمْرَةُ ، فَكَانَ مَنْ أَوْجَبَ شَيْئًا مِنْ ذَلِكَ عَلَى نَفْسِهِ ، فَقَالَ : ( لِلهِ عَلَيَّ كَذَا وَكَذَا ) وَجَبَ عَلَيْهِ الْوَفَاءُ بِذَلِكَ .  وَرَأَيْنَا أَشْيَاءَ يَدْخُلُ فِيهَا الْعِبَادُ فَيُوجِبُونَهَا عَلَى أَنْفُسِهِمْ بِدُخُولِهِمْ فِيهَا ، مِنْهَا الصَّلَاةُ وَالصِّيَامُ وَالْحَجُّ ، وَمَا ذَكَرْنَا .  فَكَانَ مَنْ دَخَلَ فِي حَجَّةٍ أَوْ عُمْرَةٍ ، ثُمَّ أَرَادَ إِبْطَالَهَا وَالْخُرُوجَ مِنْهَا لَمْ يَكُنْ لَهُ ذَلِكَ ، وَكَانَ بِدُخُولِهِ فِيهَا فِي حُكْمِ مَنْ قَالَ : ( لِلهِ عَلَيَّ حَجَّةٌ ) ، فَعَلَيْهِ الْوَفَاءُ بِهَا .  فَإِنْ قَالَ قَائِلٌ : إِنَّمَا مَنَعْنَاهُ مِنَ الْخُرُوجِ مِنْهُمَا ؛ لِأَنَّهُ لَا يُمْكِنُهُ الْخُرُوجُ مِنْهَا إِلَّا بِتَمَامِهَا ، وَلَيْسَتِ الصَّلَاةُ وَالصِّيَامُ كَذَلِكَ ؛ لِأَنَّهُمَا قَدْ يَبْطُلَانِ وَيَخْرُجُ مِنْهُمَا بِالْكَلَامِ وَالطَّعَامِ وَالشَّرَابِ وَالْجِمَاعِ ، قِيلَ لَهُ : إِنَّ الْحَجَّةَ وَالْعُمْرَةَ وَإِنْ كَانَا كَمَا ذَكَرْتَ ، فَإِنَّا قَدْ رَأَيْنَاكَ تَزْعُمُ أَنَّ مَنْ جَامَعَ فِيهِمَا فَعَلَيْهِ قَضَاؤُهُمَا ، وَالْقَضَاءُ يَدْخُلُ فِيهِ بَعْدَ خُرُوجِهِ مِنْهُمَا ، فَقَدْ جَعَلْتَ عَلَيْهِ الدُّخُولَ فِي قَضَائِهِمَا إِنْ شَاءَ أَوْ أَبَى مِنْ أَجْلِ إِفْسَادِهِ لَهُمَا .  فَهَذَا الَّذِي يَقْضِيهِ بَدَلٌ مِنْهُ مِمَّا كَانَ وَجَبَ عَلَيْهِ بِدُخُولِهِ فِيهِ لَا بِإِيجَابٍ كَانَ مِنْهُ قَبْلَ ذَلِكَ ، فَلَوْ كَانَتِ الْعِلَّةُ فِي لُزُومِ الْحَجَّةِ وَالْعُمْرَةِ إِيَّاهُ حِينَ أَحْرَمَ بِهِمَا وَبُطْلَانِ الْخُرُوجِ مِنْهُمَا هِيَ مَا ذَكَرْتَ مِنْ عَدَمِ رَفْضِهِمَا ، وَلَوْلَا ذَلِكَ كَانَ لَهُ الْخُرُوجُ مِنْهُمَا ، كَمَا كَانَ لَهُ الْخُرُوجُ مِنَ الصَّلَاةِ وَالصِّيَامِ بِمَا ذَكَرْنَا مِنَ الْأَشْيَاءِ الَّتِي تَخْرُجُ مِنْهُمَا ، إِذًا لَمَا وَجَبَ عَلَيْهِ قَضَاؤُهُمَا ؛ لِأَنَّهُ غَيْرُ قَادِرٍ عَلَى أَنْ لَا يَدْخُلَ فِيهِ .  فَلَمَّا كَانَ ذَلِكَ غَيْرَ مُبْطِلٍ عَنْهُ وُجُوبَ الْقَضَاءِ ، وَكَانَ فِي ذَلِكَ كَمَنْ عَلَيْهِ قَضَاءُ حَجَّةٍ قَدْ أَوْجَبَهَا لِلهِ عَزَّ وَجَلَّ عَلَى نَفْسِهِ بِلِسَانِهِ ، كَانَ كَذَلِكَ أَيْضًا فِي النَّظَرِ مَنْ دَخَلَ فِي صَلَاةٍ أَوْ صِيَامٍ ، فَأَوْجَبَ ذَلِكَ لِلهِ عَزَّ وَجَلَّ عَلَى نَفْسِهِ بِدُخُولِهِ فِيهِ ، ثُمَّ خَرَجَ مِنْهُ فَعَلَيْهِ قَضَاؤُهُ ، وَيُقَالُ لَهُ أَيْضًا : وَقَدْ رَأَيْنَا الْعُمْرَةَ مِمَّا قَدْ يَجُوزُ رَفْضُهَا بَعْدَ الدُّخُولِ فِيهَا فِي قَوْلِنَا وَقَوْلِكَ ، وَبِذَلِكَ جَاءَتِ السُّنَّةُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي قَوْلِهِ  لِعَائِشَةَ  رَضِيَ اللهُ عَنْهَا : "" دَعِي عَنْكِ الْعُمْرَةَ وَأَهِلِّي بِالْحَجِّ "" . وَسَنَذْكُرُ ذَلِكَ  بِإِسْنَادِهِ  فِي مَوْضِعِهِ مِنْ كِتَابِنَا هَذَا إِنْ شَاءَ اللهُ تَعَالَى .  فَلَمْ يَكُنْ لِلدَّاخِلِ فِي الْعُمْرَةِ إِذَا كَانَ قَادِرًا عَلَى رَفْضِهَا وَالْخُرُوجِ مِنْهَا أَنْ يَخْرُجَ مِنْهَا فَيُبْطِلَهَا ، ثُمَّ لَا يَجِبُ عَلَيْهِ قَضَاؤُهَا .         [2/111]      وَكَانَ مَنْ دَخَلَ فِيهَا بِغَيْرِ إِيجَابٍ مِنْهُ لَهَا قَبْلَ ذَلِكَ ، لَيْسَ لَهُ الْخُرُوجُ مِنْهَا قَبْلَ تَمَامِهَا إِلَّا مِنْ عُذْرٍ ، فَإِنْ خَرَجَ مِنْهَا فَأَبْطَلَهَا بِعُذْرٍ أَوْ بِغَيْرِ عُذْرٍ فَعَلَيْهِ قَضَاؤُهَا .  فَالصَّلَاةُ وَالصَّوْمُ أَيْضًا فِي النَّظَرِ كَذَلِكَ لَيْسَ لِمَنْ دَخَلَ فِيهِمَا الْخُرُوجُ مِنْهُمَا ، وَإِبْطَالُهُمَا إِلَّا مِنْ عُذْرٍ ، وَإِنْ خَرَجَ مِنْهُمَا قَبْلَ إِتْمَامِهِ إِيَّاهُمَا بِعُذْرٍ أَوْ بِغَيْرِ عُذْرٍ فَعَلَيْهِ قَضَاؤُهُمَا .  فَهَذَا هُوَ النَّظَرُ فِي هَذَا الْبَابِ ، وَهُوَ قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ .  وَقَدْ رُوِيَ مِثْلُ ذَلِكَ أَيْضًا ، عَنْ غَيْرِ وَاحِدٍ مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Sharh Ma'ani al-Athar 3489","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن طلحة بن يحيى بن طلحة التيمي عن سفيان بن عيينة عن الشافعي عن إسماعيل بن يحيى المزني عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3275","3490  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  أَيُّوبَ ،  عَنْ  سَعِيدِ بْنِ أَبِي الْحَسَنِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّهُ أَخْبَرَ أَصْحَابَهُ أَنَّهُ صَائِمٌ ، ثُمَّ خَرَجَ عَلَيْهِمْ وَرَأْسُهُ يَقْطُرُ  ، فَقَالُوا : أَوَلَمْ تَكُ صَائِمًا ؟ قَالَ : ( بَلَى ، وَلَكِنِّي مَرَّتْ بِي جَارِيَةٌ لِي ، فَأَعْجَبَتْنِي فَأَصَبْتُهَا ، وَكَانَتْ حَسَنَةً هَمَمْتُ بِهَا ، وَأَنَا قَاضِيهَا يَوْمًا آخَرَ  ) .","","Sharh Ma'ani al-Athar 3490","","عبد الله بن عباس عن سعيد بن أبي الحسن الأنصاري عن أيوب السختياني عن شعبة بن الحجاج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3276","3491  -  حَدَّثَنَا  رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ بُكَيْرٍ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ، قَالَ :  حَدَّثَنِي  زِيَادُ بْنُ الْجَصَّاصِ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ ، قَالَ :  صُمْتُ يَوْمَ عَرَفَةَ فَجَهَدَنِي الصَّوْمُ فَأَفْطَرْتُ ،  فَسَأَلْتُ  عَنْ ذَلِكَ عَبْدَ اللهِ بْنَ عُمَرَ ،  فَقَالَ : ( يَوْمًا آخَرَ مَكَانَهُ )  .","","Sharh Ma'ani al-Athar 3491","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن زياد بن أبي زياد الجصاص عن حماد بن زيد عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطحاوي","باب الرجل يدخل في الصيام تطوعا ثم يفطر"
"3277","15 - بَابٌ : الصَّوْمُ يَوْمَ الشَّكِّ  3492  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  : أَبُو سَعِيدٍ الْأَشَجُّ ، قَالَ :  ثَنَا  أَبُو خَالِدٍ سُلَيْمَانُ بْنُ حَيَّانَ الْأَزْدِيُّ الْأَحْمَرُ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  صِلَةَ ، قَالَ :  كُنَّا عِنْدَ عَمَّارٍ ، فَأُتِيَ بِشَاةٍ  مَصْلِيَّةٍ  ، فَقَالَ لِلْقَوْمِ : كُلُوا ، فَتَنَحَّى رَجُلٌ مِنَ  الْقَوْمِ  ، وَقَالَ : إِنِّي صَائِمٌ . قَالَ  عَمَّارٌ  :  مَنْ صَامَ الْيَوْمَ الَّذِي يُشَكُّ فِيهِ فَقَدْ عَصَى  أَبَا الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  قَالَ أَبُو جَعْفَرٍ :  فَكَرِهَ قَوْمٌ صَوْمَ الْيَوْمِ الَّذِي يُشَكُّ فِيهِ ، وَاحْتَجُّوا فِي ذَلِكَ بِهَذَا الْحَدِيثِ ، وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَلَمْ يَرَوْا بِصَوْمِهِ تَطَوُّعًا بَأْسًا ، قَالُوا : وَإِنَّمَا الصَّوْمُ الْمَكْرُوهُ فِي هَذَا الْحَدِيثِ هُوَ الصَّوْمُ عَلَى أَنَّهُ مِنْ رَمَضَانَ ، فَأَمَّا تَطَوُّعًا فَلَا بَأْسَ بِهِ ، وَاحْتَجُّوا فِي ذَلِكَ بِمَا قَدْ رُوِّينَاهُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غَيْرِ هَذَا الْمَوْضِعِ مِنْ قَوْلِهِ : ""  لَا تَتَقَدَّمُوا رَمَضَانَ بِيَوْمٍ وَلَا بِيَوْمَيْنِ إِلَّا أَنْ يُوَافِقَ ذَلِكَ صَوْمًا كَانَ يَصُومُهُ أَحَدُكُمْ فَلْيَصُمْهُ  ""  .","","Sharh Ma'ani al-Athar 3492","","عمار بن ياسر عن صلة بن زفر العبسي عن أبو إسحاق السبيعي عن عمرو بن قيس الملائي عن سليمان بن حيان الأحمر عن عبد الله بن سعيد الأشج عن فهد بن سليمان الدلال عن الطحاوي","باب الصوم يوم الشك"
"3278","[2/112]      6 - كِتَابُ  مَنَاسِكِ  الْحَجِّ  1 - بَابٌ : الْمَرْأَةُ لَا تَجِدُ  مَحْرَمًا  ، هَلْ يَجِبُ عَلَيْهَا فَرْضُ  الْحَجِّ  أَمْ لَا ؟  3493  -  حَدَّثَنَا  يُونُسُ بْنُ عَبْدِ الْأَعْلَى ، قَالَ :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرٍو ،  سَمِعَ  أَبَا مَعْبَدٍ مَوْلَى ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا يَقُولُ :  قَالَ  ابْنُ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا :  خَطَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ النَّاسَ ، فَقَالَ :  لَا تُسَافِرِ امْرَأَةٌ إِلَّا وَمَعَهَا ذُو  مَحْرَمٍ  ، وَلَا يَدْخُلْ عَلَيْهَا رَجُلٌ إِلَّا وَمَعَهَا ذُو  مَحْرَمٍ  "" . فَقَامَ  رَجُلٌ  ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي قَدِ  اكْتُتِبْتُ  فِي غَزْوَةِ كَذَا وَكَذَا ، وَقَدْ أَرَدْتُ أَنْ أَحُجَّ بِامْرَأَتِي ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" احْجُجْ مَعَ امْرَأَتِكَ  .","","Sharh Ma'ani al-Athar 3493","","عبد الله بن عباس عن نافذ المكي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن يونس بن عبد الأعلى عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3279","3494  -  حَدَّثَنَا  يُونُسُ بْنُ عَبْدِ الْأَعْلَى ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  عَمْرٍو ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3494","","عبد الله بن عباس عن نافذ المكي عن عمرو بن دينار الأثرم عن ابن جريج عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3280","3495  -  حَدَّثَنَا  أَبُو بَكْرَةَ بَكَّارُ بْنُ قُتَيْبَةَ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ، قَالَ :  أَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ،  عَنْ  أَبِي مَعْبَدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3495","","عبد الله بن عباس عن نافذ المكي عن عمرو بن دينار الأثرم عن ابن جريج عن أبو عاصم النبيل عن بكار بن قتيبة البكراوي عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3281","3496  -  حَدَّثَنَا  رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  حَامِدُ بْنُ يَحْيَى ، قَالَ :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ، قَالَ :  ثَنَا  ابْنُ عَجْلَانَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تُسَافِرِ الْمَرْأَةُ إِلَّا وَمَعَهَا ذُو  مَحْرَمٍ  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى أَنَّ الْمَرْأَةَ لَا تُسَافِرُ سَفَرًا قَرِيبًا أَوْ بَعِيدًا إِلَّا مَعَ ذِي  مَحْرَمٍ  ، وَاحْتَجُّوا فِي ذَلِكَ بِهَذِهِ الْآثَارِ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : كُلُّ سَفَرٍ هُوَ دُونَ الْبَرِيدِ ، فَلَهَا أَنْ تُسَافِرَ بِلَا  مَحْرَمٍ  ، وَكُلُّ سَفَرٍ يَكُونُ بَرِيدًا فَصَاعِدًا فَلَيْسَ لَهَا أَنْ تُسَافِرَ إِلَّا  بِمَحْرَمٍ  .  وَاحْتَجُّوا فِي ذَلِكَ بِمَا .","","Sharh Ma'ani al-Athar 3496","","أبو هريرة الدوسي عن سعيد المقبري عن محمد بن عجلان عن سفيان بن عيينة عن حامد بن يحيى البلخي عن روح بن الفرج القطان عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3282","3497  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو عُمَرَ - هُوَ الضَّرِيرُ -  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ، قَالَ :  أَنَا  سُهَيْلُ بْنُ أَبِي صَالِحٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُسَافِرِ امْرَأَةٌ بَرِيدًا إِلَّا مَعَ زَوْجٍ ، أَوْ ذِي رَحِمٍ  مَحْرَمٍ  .","","Sharh Ma'ani al-Athar 3497","","أبو هريرة الدوسي عن سعيد المقبري عن سهيل بن أبي صالح السمان عن حماد بن سلمة عن حفص بن عمر الضرير البصري عن بكار بن قتيبة البكراوي عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3283","3498  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  مُعَلَّى بْنُ أَسَدٍ ، قَالَ :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْمُخْتَارِ ،  عَنْ  سُهَيْلٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  قَالُوا :  فَفِي تَوْقِيتِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْبَرِيدَ مَا يَدُلُّ عَلَى أَنَّ مَا دُونَهُ بِخِلَافِهِ .         [2/113]      وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : إِذَا كَانَ سَفَرٌ هُوَ دُونَ الْيَوْمِ ، فَلَهَا أَنْ تُسَافِرَ بِلَا  مَحْرَمٍ  ، وَكُلُّ سَفَرٍ يَكُونُ يَوْمًا فَصَاعِدًا فَلَيْسَ لَهَا أَنْ تُسَافِرَ إِلَّا  بِمَحْرَمٍ  .  وَاحْتَجُّوا فِي ذَلِكَ بِمَا","","Sharh Ma'ani al-Athar 3498","","أبو هريرة الدوسي عن سعيد المقبري عن سهيل بن أبي صالح السمان عن عبد العزيز بن المختار الدباغ عن معلى بن أسد عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3284","3499  -  حَدَّثَنَا  أَبُو أُمَيَّةَ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  شَيْبَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَعِيدٍ ،  عَنْ  أَبِيهِ ،  أَنَّهُ سَمِعَ  أَبَا هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَحِلُّ لِامْرَأَةٍ تُسَافِرُ يَوْمًا فَمَا فَوْقَهُ إِلَّا وَمَعَهَا ذُو  حُرْمَةٍ  .","","Sharh Ma'ani al-Athar 3499","","أبو هريرة الدوسي عن أبو سعيد المقبري عن سعيد المقبري عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن الفضل بن دكين عن محمد بن إبراهيم بن مسلم السجستاني عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3285","حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَامِرٍ ، قَالَ :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ . غَيْرَ أَنَّهُ لَمْ يَقُلْ : ( فَمَا فَوْقَهُ ) .","","Sharh Ma'ani al-Athar 3285","","أبو هريرة الدوسي عن سعيد المقبري عن محمد بن عبد الرحمن بن المغيرة عن أبو عامر العقدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3286","3501  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3501","","أبو هريرة الدوسي عن سعيد المقبري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3287","3502  -  حَدَّثَنَا  حُسَيْنُ بْنُ نَصْرٍ قَالَ :  سَمِعْتُ  يَزِيدَ بْنَ هَارُونَ ، قَالَ :  أَنَا  ابْنُ أَبِي ذِئْبٍ . (  ح  ) .  3503  -  وَحَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  خَالِدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الْمَقْبُرِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  قَالُوا :  فَفِي تَوْقِيتِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا دَلِيلٌ عَلَى أَنَّ مَا هُوَ أَقَلُّ مِنْهُ بِخِلَافِهِ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : كُلُّ سَفَرٍ هُوَ دُونَ اللَّيْلَتَيْنِ فَلَهَا أَنْ تُسَافِرَهُ بِغَيْرِ  مَحْرَمٍ  ، وَكُلُّ سَفَرٍ يَكُونُ لَيْلَتَيْنِ فَصَاعِدًا فَلَيْسَ لَهَا أَنْ تُسَافِرَهُ بِغَيْرِ  مَحْرَمٍ","","Sharh Ma'ani al-Athar 3502","","أبو هريرة الدوسي عن أبو سعيد المقبري عن سعيد المقبري عن محمد بن عبد الرحمن بن المغيرة عن خالد بن عبد الرحمن الخراساني عن الربيع بن سليمان المرادي عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3288","3504  -  وَاحْتَجُّوا فِي ذَلِكَ بِمَا  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ عَامِرٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  قَزَعَةَ مَوْلَى زِيَادٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا تُسَافِرِ الْمَرْأَةُ  مَسِيرَةَ  لَيْلَتَيْنِ إِلَّا مَعَ زَوْجٍ أَوْ ذِي  مَحْرَمٍ  .","","Sharh Ma'ani al-Athar 3504","","أبو سعيد الخدري عن قزعة بن يحيى الحرشي عن عبد الملك بن عمير القبطي عن شعبة بن الحجاج عن سعيد بن عامر الضبعي عن بكار بن قتيبة البكراوي عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3289","3505  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  عَبْدِ الْمَلِكِ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  قَالُوا :  فَفِي تَوْقِيتِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ لَيْلَتَيْنِ دَلِيلٌ عَلَى أَنَّ حُكْمَ مَا هُوَ دُونَهُمَا بِخِلَافِ حُكْمِهِمَا ، وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : كُلُّ سَفَرٍ يَكُونُ ثَلَاثَةَ أَيَّامٍ فَصَاعِدًا فَلَيْسَ لَهَا أَنْ تُسَافِرَ إِلَّا مَعَ  مَحْرَمٍ  ، وَكُلُّ سَفَرٍ يَكُونُ دُونَ ذَلِكَ فَلَهَا أَنْ تُسَافِرَ بِغَيْرِ  مَحْرَمٍ  .  وَاحْتَجُّوا فِي ذَلِكَ بِمَا","","Sharh Ma'ani al-Athar 3505","","أبو سعيد الخدري عن قزعة بن يحيى الحرشي عن عبد الملك بن عمير القبطي عن عبيد الله بن عمرو بن أبي الوليد عن علي بن معبد العبدي عن يونس بن عبد الأعلى عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3290","3506  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  مُسَدَّدٌ ، قَالَ :  ثَنَا  يَحْيَى ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَحِلُّ لِامْرَأَةٍ أَنْ تُسَافِرَ  مَسِيرَةَ  ثَلَاثَةِ أَيَّامٍ إِلَّا مَعَ  مَحْرَمٍ  .","","Sharh Ma'ani al-Athar 3506","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن مسدد بن مسرهد عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3291","3507  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  ثَنَا  عَبْدُ الْكَرِيمِ بْنُ مَالِكٍ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3507","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن عبد الكريم الاصطخري عن ابن جريج عن مكي بن إبراهيم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3292","[2/114]      3508  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ :  ثَنَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَحِلُّ لِامْرَأَةٍ أَنْ تُسَافِرَ  مَسِيرَةَ  ثَلَاثَةِ أَيَّامٍ إِلَّا مَعَ رَجُلٍ يَحْرُمُ عَلَيْهَا نِكَاحُهُ  .","","Sharh Ma'ani al-Athar 3508","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن محمد بن المنهال عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3293","3509  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ يُونُسَ ، قَالَ :  ثَنَا  يَحْيَى بْنُ عِيسَى وَعَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُسَافِرِ الْمَرْأَةُ سَفَرًا ثَلَاثَةَ أَيَّامٍ فَصَاعِدًا إِلَّا وَمَعَهَا زَوْجُهَا  أَوِ ابْنُهَا أَوْ أَخُوهَا أَوْ ذُو رَحِمٍ  مَحْرَمٍ  مِنْهَا  .  غَيْرَ أَنَّ  ابْنَ نُمَيْرٍ  قَالَ فِي حَدِيثِهِ : ( فَوْقَ ثَلَاثٍ )  .","","Sharh Ma'ani al-Athar 3509","","أبو سعيد الخدري عن ذكوان السمان عن الأعمش عن عبد الله بن نمير عن محمد بن عمرو السوسي عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3294","3510  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  عُمَرُ بْنُ حَفْصٍ ، قَالَ :  ثَنَا  أَبِي ،  عَنِ  الْأَعْمَشِ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ . وَقَالَ : ( سَفَرَ ثَلَاثَةِ أَيَّامٍ ) .","","Sharh Ma'ani al-Athar 3510","","أبو سعيد الخدري عن ذكوان السمان عن الأعمش عن حفص بن غياث النخعي عن عمر بن حفص بن غياث عن فهد بن سليمان الدلال عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3295","3511  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ أَبُو سَلَمَةَ ، قَالَ :  ثَنَا  وُهَيْبُ بْنُ خَالِدٍ ، قَالَ :  ثَنَا  سُهَيْلٌ ،  عَنْ  أَبِيهِ ،  وَعَنِ  الْمَقْبُرِيِّ ،  حَدَّثَاهُ  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ -  رَفَعَهُ  - قَالَ :  لَا تُسَافِرِ امْرَأَةٌ فَوْقَ ثَلَاثِ لَيَالٍ إِلَّا مَعَ  بَعْلٍ  أَوْ ذِي رَحِمٍ  مَحْرَمٍ  .  قَالُوا :  فَفِي تَوْقِيتِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الثَّلَاثَ فِي ذَلِكَ دَلِيلٌ عَلَى أَنَّ حُكْمَ مَا دُونَ الثَّلَاثِ بِخِلَافِ ذَلِكَ ، وَمِمَّنْ قَالَ بِهَذَا الْقَوْلِ  أَبُو حَنِيفَةَ  وَأَبُو يُوسُفَ  وَمُحَمَّدٌ  رَحِمَهُمُ اللهُ تَعَالَى .  فَقَدِ اتَّفَقَتْ هَذِهِ الْآثَارُ كُلُّهَا عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي تَحْرِيمِ السَّفَرِ ثَلَاثَةَ أَيَّامٍ عَلَى الْمَرْأَةِ بِغَيْرِ ذِي  مَحْرَمٍ  .  وَاخْتَلَفَتْ فِيمَا دُونَ الثَّلَاثِ ، فَنَظَرْنَا فِي ذَلِكَ ، فَوَجَدْنَا النَّهْيَ عَنِ السَّفَرِ بِلَا  مَحْرَمٍ  مَسِيرَةَ  ثَلَاثَةِ أَيَّامٍ فَصَاعِدًا ثَابِتًا بِهَذِهِ الْآثَارِ كُلِّهَا ، وَكَانَ تَوْقِيتُهُ ثَلَاثَةَ أَيَّامٍ فِي ذَلِكَ إِبَاحَةَ السَّفَرِ دُونَ الثَّلَاثِ لَهَا بِغَيْرِ  مَحْرَمٍ  ، وَلَوْلَا ذَلِكَ لَمَا كَانَ لِذِكْرِهِ الثَّلَاثَ مَعْنًى .  وَنَهَى نَهْيًا مُطْلَقًا ، وَلَمْ يَتَكَلَّمْ بِكَلَامٍ يَكُونُ فَضْلًا ، وَلَكِنَّهُ ذَكَرَ الثَّلَاثَ ؛ لِيُعْلَمَ أَنَّ مَا دُونَهَا بِخِلَافِهَا ، وَهَكَذَا الْحَكِيمُ يَتَكَلَّمُ بِمَا يَدُلُّ عَلَى غَيْرِهِ لِيُغْنِيَهُ عَنْ ذِكْرِ مَا يَدُلُّ كَلَامُهُ ذَلِكَ عَلَيْهِ ، وَلَا يَتَكَلَّمُ بِالْكَلَامِ الَّذِي لَا يَدُلُّ عَلَى غَيْرِهِ ، وَهُوَ يَقْدِرُ أَنْ يَتَكَلَّمَ بِكَلَامٍ يَدُلُّ عَلَى غَيْرِهِ ، وَهَذَا تَفَضُّلٌ مِنَ اللهِ عَزَّ وَجَلَّ لِنَبِيِّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِذَلِكَ ، إِذْ آتَاهُ  جَوَامِعَ  الْكَلِمِ الَّذِي لَيْسَ فِي طَبْعِ غَيْرِهِ الْقُوَّةُ عَلَيْهِ ، ثُمَّ رَجَعْنَا إِلَى مَا كُنَّا فِيهِ ، فَلَمَّا ذَكَرَ الثَّلَاثَ وَثَبَتَ بِذِكْرِهِ إِيَّاهَا إِبَاحَةُ مَا هُوَ دُونَهَا ، ثُمَّ مَا رُوِيَ عَنْهُ فِي مَنْعِهَا مِنَ السَّفَرِ دُونَ الثَّلَاثِ مِنَ الْيَوْمِ وَالْيَوْمَيْنِ وَالْبَرِيدِ ، فَكُلُّ وَاحِدٍ مِنْ تِلْكَ الْآثَارِ ،         [2/115]      وَمِنَ الْأَثَرِ الْمَرْوِيِّ فِي الثَّلَاثِ مَتَى كَانَ بَعْدَ الَّذِي خَالَفَهُ نَسَخَهُ إِنْ كَانَ النَّهْيُ عَنْ سَفَرِ الْيَوْمِ بِلَا  مَحْرَمٍ  بَعْدَ النَّهْيِ عَنْ سَفَرِ الثَّلَاثِ بِلَا  مَحْرَمٍ  ، فَهُوَ نَاسِخٌ لَهُ ، وَإِنْ كَانَ خَبَرُ الثَّلَاثِ هُوَ الْمُتَأَخِّرُ عَنْهُ فَهُوَ نَاسِخٌ لَهُ ، فَقَدْ ثَبَتَ أَنَّ أَحَدَ الْمَعَانِي الَّتِي دُونَ الثَّلَاثِ نَاسِخَةٌ لِلثَّلَاثِ ، أَوِ الثَّلَاثَ نَاسِخَةٌ لَهَا ، فَلَمْ يَخْلُ خَبَرُ الثَّلَاثِ مِنْ أَحَدِ وَجْهَيْنِ ، إِمَّا أَنْ يَكُونَ هُوَ الْمُتَقَدِّمَ ، أَوْ يَكُونَ هُوَ الْمُتَأَخِّرَ .  فَإِنْ كَانَ هُوَ الْمُتَقَدِّمَ فَقَدْ أَبَاحَ السَّفَرَ أَقَلَّ مِنْ ثَلَاثٍ بِلَا  مَحْرَمٍ  ، ثُمَّ جَاءَ بَعْدَهُ النَّهْيُ عَنْ سَفَرِ مَا هُوَ دُونَ الثَّلَاثِ بِغَيْرِ  مَحْرَمٍ  ، فَحَرَّمَ مَا حَرَّمَ الْحَدِيثُ الْأَوَّلُ ، وَزَادَ عَلَيْهِ  حُرْمَةً  أُخْرَى ، وَهُوَ مَا بَيْنَهُ وَبَيْنَ الثَّلَاثِ ، فَوَجَبَ اسْتِعْمَالُ الثَّلَاثِ عَلَى مَا أَوْجَبَهُ الْأَثَرُ الْمَذْكُورُ فِيهِ .  وَإِنْ كَانَ هُوَ الْمُتَأَخِّرَ وَغَيْرُهُ الْمُتَقَدِّمَ فَهُوَ نَاسِخٌ لِمَا تَقَدَّمَهُ ، وَالَّذِي تَقَدَّمَهُ غَيْرُ  وَاجِبٍ  الْعَمَلُ بِهِ ، فَحَدِيثُ الثَّلَاثِ  وَاجِبٌ  اسْتِعْمَالُهُ عَلَى الْأَحْوَالِ كُلِّهَا ، وَمَا خَالَفَهُ فَقَدْ يَجِبُ اسْتِعْمَالُهُ إِنْ كَانَ هُوَ الْمُتَأَخِّرَ ، وَلَا يَجِبُ إِنْ كَانَ هُوَ الْمُتَقَدِّمَ ، فَالَّذِي قَدْ وَجَبَ عَلَيْنَا اسْتِعْمَالُهُ وَالْأَخْذُ بِهِ فِي كِلَا الْوَجْهَيْنِ أَوْلَى مِمَّا قَدْ يَجِبُ اسْتِعْمَالُهُ فِي حَالٍ وَتَرْكُهُ فِي حَالٍ ، وَفِي ثُبُوتِ مَا ذَكَرْنَا دَلِيلٌ عَلَى أَنَّ الْمَرْأَةَ لَيْسَ لَهَا أَنْ تَحُجَّ إِذَا كَانَ بَيْنَهَا وَبَيْنَ  الْحَجِّ  مَسِيرَةُ  ثَلَاثَةِ أَيَّامٍ إِلَّا مَعَ  مَحْرَمٍ  ، فَإِذَا عَدِمَتِ  الْمَحْرَمَ  ، وَكَانَ بَيْنَهَا وَبَيْنَ  مَكَّةَ  الْمَسَافَةُ الَّتِي ذَكَرْنَا ، فَهِيَ غَيْرُ وَاجِدَةٍ لِلسَّبِيلِ الَّذِي يَجِبُ عَلَيْهَا  الْحَجُّ  بِوُجُودِهِ .  وَقَدْ قَالَ قَوْمٌ : ( لَا بَأْسَ بِأَنْ تُسَافِرَ الْمَرْأَةُ بِغَيْرِ  مَحْرَمٍ  )  ، وَاحْتَجُّوا فِي ذَلِكَ بِمَا .","","Sharh Ma'ani al-Athar 3511","","أبو هريرة الدوسي عن سعيد المقبري عن سهيل بن أبي صالح السمان عن وهيب بن خالد الكرابيسي عن موسى بن إسماعيل التبوذكي عن فهد بن سليمان الدلال عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3296","3512  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ،  أَنَّهَا سَمِعَتْهَا تَقُولُ  فِي الْمَرْأَةِ تَحُجُّ ، وَلَيْسَ مَعَهَا ذُو  مَحْرَمٍ  ، فَقَالَتْ : مَا لِكُلِّهِنَّ ذُو  مَحْرَمٍ  .","","Sharh Ma'ani al-Athar 3512","","عائشة بنت أبي بكر الصديق عن عمرة بنت عبد الرحمن الأنصارية عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3297","3513  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،  عَنِ  اللَّيْثِ ،  أَنَّ ابْنَ شِهَابٍ  حَدَّثَهُ  ،  عَنْ  عَمْرَةَ ، أَنَّ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا  أُخْبِرَتْ  ،  أَنَّ  أَبَا سَعِيدٍ الْخُدْرِيَّ يُفْتِي أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَصْلُحُ لِلْمَرْأَةِ أَنْ تُسَافِرَ إِلَّا وَمَعَهَا  مَحْرَمٌ  . فَقَالتْ : ( مَا لِكُلِّهِنَّ ذُو  مَحْرَمٍ  ) .  فَإِنَّ الْحُجَّةَ عَلَيْهِمْ فِي ذَلِكَ مَا قَدْ  تَوَاتَرَتْ  بِهِ الْآثَارُ الَّتِي قَدْ ذَكَرْنَاهَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَهِيَ حُجَّةٌ عَلَى كُلِّ مَنْ خَالَفَهَا .  فَإِنْ قَالَ قَائِلٌ : إِنَّ  الْحَجَّ  لَمْ يَدْخُلْ فِي السَّفَرِ الَّذِي نُهِيَ عَنْهُ فِي تِلْكَ الْآثَارِ ، فَالْحُجَّةُ عَلَى ذَلِكَ الْقَائِلِ حَدِيثُ  ابْنِ عَبَّاسٍ  الَّذِي بَدَأْنَا بِذِكْرِهِ فِي هَذَا الْبَابِ ؛ إِذْ يَقُولُ :  خَطَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" لَا تُسَافِرِ امْرَأَةٌ إِلَّا مَعَ  مَحْرَمٍ  "" .         [2/116]      فَقَالَ لَهُ رَجُلٌ : إِنِّي أَرَدْتُ أَنْ أَحُجَّ بِامْرَأَتِي ، وَقَدِ  اكْتَتَبْتُ  فِي غَزْوَةِ كَذَا وَكَذَا ، فَقَالَ : "" احْجُجْ بِامْرَأَتِكَ  "" .  فَدَلَّ ذَلِكَ عَلَى أَنَّهَا لَا يَنْبَغِي لَهَا أَنْ تَحُجَّ إِلَّا بِهِ ، وَلَوْلَا ذَلِكَ لَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" وَمَا حَاجَتُهَا إِلَيْكَ ؛ لِأَنَّهَا تَخْرُجُ مَعَ الْمُسْلِمِينَ ، وَأَنْتَ فَامْضِ لِوَجْهِكَ فِيمَا  اكْتَتَبْتَ  "" .  فَفِي تَرْكِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَأْمُرَهُ بِذَلِكَ ، وَأَمْرِهِ أَنْ يَحُجَّ مَعَهَا دَلِيلٌ عَلَى أَنَّهَا لَا يَصْلُحُ لَهَا  الْحَجُّ  إِلَّا بِهِ .  فَإِنْ قَالَ قَائِلٌ : قَدْ رَوَيْتُمْ عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : "" لَا تُسَافِرِ امْرَأَةٌ  مَسِيرَةَ  ثَلَاثَةِ أَيَّامٍ إِلَّا مَعَ ذِي  مَحْرَمٍ  "" .  وَقَدْ رُوِيَ عَنْهُ مِنْ قَوْلِهِ بَعْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خِلَافُ ذَلِكَ  .  فَذَكَرَ مَا .","","Sharh Ma'ani al-Athar 3513","","أبو سعيد الخدري عن عمرة بنت عبد الرحمن الأنصارية عن الزهري عن الليث بن سعد عن عبد الله بن وهب المصري عن الربيع بن سليمان المرادي عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3298","3514  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  ثَنَا  بَكْرُ بْنُ مُضَرَ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  بُكَيْرٍ ، أَنَّ نَافِعًا  حَدَّثَهُ  ،  أَنَّهُ كَانَ يُسَافِرُ مَعَ ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا مَوَالِيَاتٌ لَهُ ، لَيْسَ مَعَهُنَّ ذُو  مَحْرَمٍ  .  قِيلَ لَهُ :  مَا هَذَا بِخِلَافٍ لِمَا رَوَيْنَاهُ عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؛ لِأَنَّا لَمْ نَرْوِ عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهْيًا أَنْ تُسَافِرَ الْمَرْأَةُ سَفَرًا ، أَيَّ سَفَرٍ  كَانَ إِلَّا  بِمَحْرَمٍ  .  وَلَكِنَّا رَوَيْنَا عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ نَهَى أَنْ تُسَافِرَ الْمَرْأَةُ سَفَرًا ثَلَاثَةَ أَيَّامٍ إِلَّا مَعَ ذِي  مَحْرَمٍ ،  فَكَانَ ذَلِكَ نَاهِيًا لَهَا عَنِ السَّفَرِ الَّذِي مِقْدَارُ مَسَافَتِهِ الثَّلَاثُ إِلَّا  بِمَحْرَمٍ  ، وَمُبِيحًا لَمَا هُوَ أَقَلُّ مِنْهُ مَسَافَةً بِغَيْرِ  مَحْرَمٍ  .  فَقَدْ يَجُوزُ أَنْ يَكُونَ السَّفَرُ الَّذِي كَانَ يُسَافِرُهُ مَعَهُ هَؤُلَاءِ الْمَوَالِيَاتُ بِغَيْرِ  مَحْرَمٍ  هُوَ السَّفَرُ الَّذِي لَمْ يَدْخُلْ فِيمَا نَهَى عَنْهُ مَا رَوَيْنَاهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  وَاحْتَجَّ آخَرُونَ فِي إِبَاحَةِ السَّفَرِ لِلْمَرْأَةِ بِغَيْرِ  مَحْرَمٍ  بِمَا رُوِيَ عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا ، أَنَّهَا كَانَتْ تُسَافِرُ بِغَيْرِ  مَحْرَمٍ  .  3515  - فَحَدَّثَنِي بَعْضُ أَصْحَابِنَا ، عَنْ  مُحَمَّدِ بْنِ مُقَاتِلٍ الرَّازِيِّ  ، لَا أَعْلَمُهُ إِلَّا عَنْ  حَكَّامٍ الرَّازِيِّ  ، قَالَ : سَأَلْتُ  أَبَا حَنِيفَةَ  رَحِمَهُ اللهُ : ( هَلْ تُسَافِرُ الْمَرْأَةُ بِغَيْرِ  مَحْرَمٍ  ؟ ) ، فَقَالَ : لَا ، نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تُسَافِرَ امْرَأَةٌ  مَسِيرَةَ  ثَلَاثَةِ أَيَّامٍ فَصَاعِدًا إِلَّا وَمَعَهَا زَوْجُهَا أَوْ أَبُوهَا أَوْ ذُو رَحِمٍ مِنْهَا .  قَالَ  حَكَّامٌ  : فَسَأَلْتٌ  الْعَرْزَمِيَّ  ، فَقَالَ : لَا بَأْسَ بِذَلِكَ .  حَدَّثَنِي  عَطَاءٌ  أَنَّ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا كَانَتْ تُسَافِرُ بِلَا  مَحْرَمٍ ،  قَالَ : فَأَتَيْتُ  أَبَا حَنِيفَةَ  رَحِمَهُ اللهُ فَأَخْبَرْتُهُ بِذَلِكَ .  فَقَالَ  أَبُو حَنِيفَةَ  رَحِمَهُ اللهُ : لَمْ يَدْرِ  الْعَرْزَمِيُّ  مَا رَوَى ، كَانَ النَّاسُ  لِعَائِشَةَ  مَحْرَمًا  ، فَمَعَ أَيِّهِمْ سَافَرَتْ ، فَقَدْ سَافَرَتْ مَعَ  مَحْرَمٍ ،  وَلَيْسَ النَّاسُ لِغَيْرِهَا مِنَ النِّسَاءِ كَذَلِكَ .  وَكُلُّ الَّذِي أَثْبَتْنَا فِي هَذَا الْبَابِ مِنْ مَنْعِ الْمَرْأَةِ مِنَ السَّفَرِ  مَسِيرَةَ  ثَلَاثَةِ أَيَّامٍ إِلَّا مَعَ  مَحْرَمٍ ،  وَمِنْ إِبَاحَةِ مَا دُونَ ذَلِكَ لَهَا مِنَ السَّفَرِ بِغَيْرِ  مَحْرَمٍ ،  وَمِنْ أَنَّ الْمَرْأَةَ لَا يَجِبُ عَلَيْهَا فَرْضُ  الْحَجِّ  إِلَّا بِوُجُودِهَا  الْمَحْرَمَ  مَعَ وُجُودِ سَائِرِ السَّبِيلِ الَّذِي يَجِبُ بِوُجُودِهَا فَرْضُ  الْحَجِّ  قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى .  في طبعة عالم الكتب : ( سفرا ) ، والمثبت من النسخ الخطية.","","Sharh Ma'ani al-Athar 3514","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن بكر بن مضر المصري عن عبد الله بن صالح المصري عن علان بن المغيرة عن الطحاوي","باب المرأة لا تجد محرما هل يجب عليها حج"
"3299","[2/117]      2 - بَابُ الْمَوَاقِيتِ الَّتِي يَنْبَغِي لِمَنْ أَرَادَ الْإِحْرَامَ أَنْ لَا يَتَجَاوَزَهَا  3516  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو حُذَيْفَةَ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا قَالَ :  وَقَّتَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ نَجْدٍ  قَرْنَ  ،  وَلِأَهْلِ الْيَمَنِ  يَلَمْلَمَ  ، وَلَمْ أَسْمَعْهُ مِنْهُ . قِيلَ لَهُ :  فَالْعِرَاقُ  ؟ قَالَ : لَمْ يَكُنْ يَوْمَئِذٍ  عِرَاقٌ  .","","Sharh Ma'ani al-Athar 3516","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن سفيان الثوري عن موسى بن مسعود النهدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3300","3517  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  صَدَقَةَ بْنِ يَسَارٍ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، فَذَكَرَ مِثْلَهُ .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ عَلَى أَنَّ  أَهْلَ الْعِرَاقِ  لَا  وَقْتَ  لَهُمْ فِي الْإِحْرَامِ كَوَقْتِ سَائِرِ الْبُلْدَانِ  .","","Sharh Ma'ani al-Athar 3517","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن جرير بن عبد الحميد عن علي بن معبد العبدي عن فهد بن سليمان الدلال عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3301","3518  -  وَاحْتَجُّوا فِي ذَلِكَ بِهَذَا الْحَدِيثِ ، وَقَالُوا : كَذَلِكَ سَائِرُ الْأَحَادِيثِ الْأُخَرُ الْمَرْوِيَّةُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذِكْرِ مَوَاقِيتِ الْإِحْرَامِ ، لَيْسَ فِي شَيْءٍ مِنْهَا  لِلْعِرَاقِ  ذِكْرٌ .  ثُمَّ ذَكَرُوا فِي ذَلِكَ مَا  حَدَّثَنَا  يُونُسُ وَرَبِيعٌ الْمُؤَذِّنُ ، قَالَا :  ثَنَا  يَحْيَى بْنُ حَسَّانَ ، قَالَ :  ثَنَا  وُهَيْبُ بْنُ خَالِدٍ ، وَحَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَقَّتَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ نَجْدٍ  قَرْنَ  ،  وَلِأَهْلِ الْيَمَنِ  يَلَمْلَمَ  ، ثُمَّ قَالَ :  فَهِيَ لَهُنَّ ، وَلِكُلِّ مَنْ أَتَى عَلَيْهِنَّ مِنْ غَيْرِهِنَّ ، فَمَنْ كَانَ أَهْلُهُ دُونَ الْمِيقَاتِ  ، فَمِنْ حَيْثُ يَشَاءُ حَتَّى يَأْتِيَ ذَلِكَ عَلَى  أَهْلِ مَكَّةَ  .","","Sharh Ma'ani al-Athar 3518","","عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن حماد بن زيد عن يحيى بن حسان بن حيان التنيسي عن الربيع بن سليمان المرادي عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3302","[2/118]      3519  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  كَثِيرُ بْنُ هِشَامٍ ، قَالَ :  ثَنَا  جَعْفَرُ بْنُ بُرْقَانَ ، قَالَ :  سَأَلْتُ  عَمْرَو بْنَ دِينَارٍ ، عَنِ امْرَأَةٍ حَاجَّةٍ مَرَّتْ  بِالْمَدِينَةِ  ، فَأَتَتْ (  ذَا الْحُلَيْفَةِ  ) وَهِيَ حَائِضٌ ، فَقُلْتُ : هَلْ يُجْزِيهَا لَوْ تَقَدَّمَتْ إِلَى  الْجُحْفَةِ  فَأَحْرَمَتْ مِنْهَا ؟ فَقَالَ  عَمْرٌو  : نَعَمْ  ،  حَدَّثَنَا  طَاوُسٌ - وَلَا تَحْسَبَنَّ فِينَا أَحَدًا أَصْدَقَ  لَهْجَةً  مِنْ  طَاوُسٍ  - قَالَ :  قَالَ  ابْنُ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا :  وَقَّتَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، ثُمَّ ذَكَرَ مِثْلَهُ . إِلَّا أَنَّهُ لَمْ يَذْكُرْ مِنْ قَوْلِهِ : ( فَمَنْ كَانَ أَهْلُهُ ) إِلَى آخِرِ الْحَدِيثِ .  قَالُوا :  فَكَذَلِكَ  أَهْلُ الْعِرَاقِ  مَا أَتَوْا عَلَيْهِ مِنْ هَذِهِ الْمَوَاقِيتِ فَهُوَ وَقْتٌ لَهُمْ ، وَمَا سِوَاهَا فَلَيْسَ بِوَقْتٍ لَهُمْ  .","","Sharh Ma'ani al-Athar 3519","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن جعفر بن برقان الكلابي عن كثير بن هشام الكلابي عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3303","3520  - وَذَكَرُوا فِي ذَلِكَ أَيْضًا مَا  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يُهِلُّ  أَهْلُ الْمَدِينَةِ  مِنْ  ذِي الْحُلَيْفَةِ  ،  وَأَهْلُ الشَّامِ  مِنَ  الْجُحْفَةِ  ،  وَأَهْلُ نَجْدٍ  مِنْ  قَرَنٍ  . قَالَ  عَبْدُ اللهِ  : وَبَلَغَنِي أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" يُهِلُّ  أَهْلُ الْيَمَنِ  مِنْ  يَلَمْلَمَ  .","","Sharh Ma'ani al-Athar 3520","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3304","3521  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  شُعْبَةُ . (  ح  ) .  3522  -  وَحَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  سُفْيَانُ قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  3523  - وَقَالَ  سُفْيَانُ  :  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا يَقُولُ :  وَقَّتَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ نَجْدٍ  قَرْنَ  ،  وَلِأَهْلِ الْيَمَنِ  يَلَمْلَمَ  .","","Sharh Ma'ani al-Athar 3521","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن دينار العدوي عن شعبة بن الحجاج عن سفيان الثوري عن الفضل بن دكين عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3305","3524  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا :  بَلْ مِيقَاتُ  أَهْلِ الْعِرَاقِ  ذَاتُ عِرْقٍ  ،  وَقَّتَ  ذَلِكَ لَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، كَمَا  وَقَّتَ  سَائِرَ الْمَوَاقِيتِ لِأَهْلِهَا  .  وَذَكَرُوا فِي ذَلِكَ مَا","","Sharh Ma'ani al-Athar 3524","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3306","3525  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ دَاوُدَ ، قَالَ :  ثَنَا  خَالِدُ بْنُ يَزِيدَ الْقُطْرُبُلِّيُّ ، وَهِشَامُ بْنُ بَهْرَامَ الْمَدَائِنِيُّ قَالَا :  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  عَنْ  أَفْلَحَ بْنِ حُمَيْدٍ ،  عَنِ  الْقَاسِمِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَقَّتَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  وَمِصْرَ  الْجُحْفَةَ  ،  وَلِأَهْلِ الْعِرَاقِ  ذَاتَ  عِرْقٍ  ،  وَلِأَهْلِ الْيَمَنِ  يَلَمْلَمَ  .","","Sharh Ma'ani al-Athar 3525","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن أفلح ابن صفيراء عن المعافى بن عمران عن هشام بن بهرام الصيدلاني عن ابن أخت غزال البغدادي عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3307","3526  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ ، قَالَ :  أَنَا  ابْنُ جُرَيْجٍ قَالَ :  وَأَخْبَرَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ  أَنَّهُ سَمِعَهُ يُسْأَلُ عَنِ الْمُهَلِّ ، فَقَالَ : سَمِعْتُ ، ثُمَّ انْتَهَى أُرَاهُ يُرِيدُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يُهِلُّ  أَهْلُ الْمَدِينَةِ  مِنْ         [2/119]      ذِي الْحُلَيْفَةِ  وَالطَّرِيقُ الْآخَرُ مِنَ  الْجُحْفَةِ  ، وَيُهِلُّ  أَهْلُ الْعِرَاقِ  مِنْ  ذَاتِ عِرْقٍ  ، وَيُهِلُّ  أَهْلُ نَجْدٍ  مِنْ  قَرْنٍ  ، وَيُهِلُّ  أَهْلُ الْيَمَنِ  مِنْ  يَلَمْلَمَ  .","","Sharh Ma'ani al-Athar 3526","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن عثمان بن الهيثم بن جهم الأشج عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3308","3527  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ ، قَالَ :  ثَنَا  حَفْصٌ - هُوَ ابْنُ غِيَاثٍ -  عَنِ  الْحَجَّاجِ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  وَقَّتَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ الْيَمَنِ  يَلَمْلَمَ  ،  وَلِأَهْلِ الْعِرَاقِ  ذَاتَ عِرْقٍ  .","","Sharh Ma'ani al-Athar 3527","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن حجاج بن أرطاة عن حفص بن غياث النخعي عن محمد بن سعيد حمدان عن فهد بن سليمان الدلال عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3309","3528  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ وَعَلِيُّ بْنُ عَبْدِ الرَّحْمَنِ قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَ :  أَخْبَرَنِي  إِبْرَاهِيمُ بْنُ سُوَيْدٍ ، قَالَ :  حَدَّثَنِي  هِلَالُ بْنُ زَيْدٍ ، قَالَ :  أَخْبَرَنِي  أَنَسُ بْنُ مَالِكٍ ،  أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَقَّتَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ الْبَصْرَةِ  ذَاتَ  عِرْقٍ ،  وَلِأَهْلِ الْمَدَائِنِ  الْعَقِيقَ  ، مَوْضِعٌ قُرْبَ  ذَاتِ عِرْقٍ  .  فَقَدْ ثَبَتَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهَذِهِ الْآثَارِ مِنْ وَقْتِ  أَهْلِ الْعِرَاقِ  ، كَمَا ثَبَتَ مِنْ وَقْتِ مَنْ سِوَاهُمْ بِالْآثَارِ الَّتِي قَبْلَهَا .  وَهَذَا  عَبْدُ اللهِ بْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا فَقَدْ رَوَى عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ تَوْقِيتِهِ مَا قَدْ ذَكَرْنَاهُ عَنْهُ فِي الْفَصْلِ الَّذِي قَبْلَ هَذَا  .","","Sharh Ma'ani al-Athar 3528","","أنس بن مالك عن هلال بن زيد بن يسار بن بولا البصري عن إبراهيم بن سويد بن حيان عن سعيد بن الحكم الجمحي عن علان بن المغيرة عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3310","3529  -  ثُمَّ قَدْ قَالَ  عَبْدُ اللهِ بْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا مِنْ بَعْدِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ مَا  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ، قَالَ :  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ، قَالَ :  ثَنَا  وَكِيعٌ ، قَالَ :  ثَنَا  جَعْفَرُ بْنُ بُرْقَانَ ،  عَنْ  مَيْمُونِ بْنِ مِهْرَانَ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَقَّتَ  لِأَهْلِ الْمَدِينَةِ  ذَا الْحُلَيْفَةِ  ،  وَلِأَهْلِ الشَّامِ  الْجُحْفَةَ  ،  وَلِأَهْلِ الْيَمَنِ  يَلَمْلَمَ  ،  وَلِأَهْلِ الطَّائِفِ  قَرْنَ  .  قَالَ  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا : وَقَالَ النَّاسُ  لِأَهْلِ الْمَشْرِقِ  ذَاتُ عِرْقٍ  .  فَهَذَا  ابْنُ عُمَرَ  يُخْبِرُ أَنَّ النَّاسَ قَدْ قَالُوا ذَلِكَ ، وَلَا يُرِيدُ  ابْنُ عُمَرَ  مِنَ النَّاسِ إِلَّا أَهْلَ الْحُجَّةِ وَالْعِلْمِ بِالسُّنَّةِ ، وَمُحَالٌ أَنْ يَكُونُوا قَالُوا ذَلِكَ بِآرَائِهِمْ ؛ لِأَنَّ هَذَا لَيْسَ مِمَّا يُقَالُ مِنْ جِهَةِ الرَّأْيِ ، وَلَكِنَّهُمْ قَالُوا بِمَا أَوْقَفَهُمْ عَلَيْهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ قَائِلٌ : وَكَيْفَ يَجُوزُ أَنْ يَكُونَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَقَّتَ  لِأَهْلِ الْعِرَاقِ  يَوْمَئِذٍ مَا  وَقَّتَ  ،  وَالْعِرَاقُ  إِنَّمَا كَانَتْ بَعْدَهُ ؟ قِيلَ لَهُ : كَمَا  وَقَّتَ  لِأَهْلِ الشَّامِ  مَا  وَقَّتَ  ،  وَالشَّامُ  إِنَّمَا فُتِحَتْ بَعْدَهُ ، فَإِنْ كَانَ يُرِيدُ بِمَا  وَقَّتَ  لِأَهْلِ الشَّامِ  مَنْ كَانَ فِي النَّاحِيَةِ الَّتِي افْتُتِحَتْ حِينَئِذٍ مِنْ قِبَلِ  الشَّامِ  ، فَكَذَلِكَ يُرِيدُ بِمَا  وَقَّتَ  لِأَهْلِ الْعِرَاقِ  مَنْ كَانَ فِي النَّاحِيَةِ الَّتِي افْتُتِحَتْ حِينَئِذٍ مِنْ قِبَلِ  الْعِرَاقِ  ، مِثْلَ  جَبَلِ طَيٍّ  وَنَوَاحِيهَا .         [2/120]      وَإِنْ كَانَ مَا  وَقَّتَ  لِأَهْلِ الشَّامِ  ، إِنَّمَا هُوَ لِمَا عَلِمَ بِالْوَحْيِ أَنَّ  الشَّامَ  سَتَكُونُ دَارَ إِسْلَامٍ ، فَكَذَلِكَ مَا  وَقَّتَ  لِأَهْلِ الْعِرَاقِ  ، إِنَّمَا هُوَ لِمَا عَلِمَ بِالْوَحْيِ أَنَّ  الْعِرَاقَ  سَتَكُونُ دَارَ إِسْلَامٍ ؛ فَإِنَّهُ قَدْ كَانَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَكَرَ مَا سَيَفْعَلُهُ  أَهْلُ الْعِرَاقِ  فِي زَكَوَاتِهِمْ مَعَ ذِكْرِهِ مَا سَيَفْعَلُهُ  أَهْلُ الشَّامِ  فِي زَكَوَاتِهِمْ  .","","Sharh Ma'ani al-Athar 3529","","عبد الله بن عمر بن الخطاب عن ميمون بن مهران الرقي عن جعفر بن برقان الكلابي عن وكيع بن الجراح عن يعقوب بن حميد بن كاسب المدني عن أحمد بن داود بن موسى السدوسي عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3311","3530  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ الْبَغْدَادِيُّ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ . (  ح  ) .  3531  -  وَحَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْوُحَاظِيُّ . (  ح  ) .  3532  -  وَحَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو غَسَّانَ ، قَالُوا :  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنَعَتِ  الْعِرَاقُ  قَفِيزَهَا  وَدِرْهَمَهَا ، وَمَنَعَتِ  الشَّامُ  مُدْيَهَا وَدِينَارَهَا  ، وَمَنَعَتْ  مِصْرُ  إِرْدَبَّهَا  وَدِينَارَهَا ، وَعُدْتُمْ كَمَا  بَدَأْتُمْ  ، وَعُدْتُمْ كَمَا  بَدَأْتُمْ  ، وَعُدْتُمْ كَمَا  بَدَأْتُمْ  "" ، ثُمَّ يَشْهَدُ عَلَى ذَلِكَ لَحْمُ  أَبِي هُرَيْرَةَ  وَدَمُهُ  ، يَزِيدُ بَعْضُهُمْ عَلَى بَعْضٍ فِي قِصَّةِ الْحَدِيثِ .  فَهَذَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ ذَكَرَ مَا سَيَفْعَلُهُ  أَهْلُ الْعِرَاقِ  مِنْ مَنْعِ الزَّكَاةِ قَبْلَ أَنْ يَكُونَ  عِرَاقٌ  ، وَذَكَرَ مِثْلَ ذَلِكَ فِي  أَهْلِ الشَّامِ  وَأَهْلِ مِصْرَ  ، قَبْلَ أَنْ يَكُونَ  الشَّامُ  وَمِصْرُ  لِمَا أَعْلَمَهُ اللهُ تَعَالَى مِنْ كَوْنِهِمَا مِنْ بَعْدِهِ .  فَكَذَلِكَ مَا ذَكَرَهُ مِنَ التَّوْقِيتِ  لِأَهْلِ الْعِرَاقِ  مَعَ ذِكْرِهِ التَّوْقِيتَ لِغَيْرِهِمُ الْمَذْكُورِينَ هُوَ لِمَا أَخْبَرَهُ اللهُ تَعَالَى أَنَّهُ سَيَكُونُ مِنْ بَعْدِهِ .  وَهَذَا الَّذِي ذَكَرْنَاهُ مِنْ تَثْبِيتِ هَذِهِ الْمَوَاقِيتِ الَّتِي وَصَفْنَاهَا  لِأَهْلِ الْعِرَاقِ  وَلِمَنْ ذَكَرْنَا مَعَهُمْ قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى  .","","Sharh Ma'ani al-Athar 3530","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطحاوي","باب المواقيت التي ينبغي لمن أراد الإحرام أن لا يتجاوزها"
"3312","3 - بَابُ الْإِهْلَالِ مِنْ أَيْنَ يَنْبَغِي أَنْ يَكُونَ ؟  3533  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي حَسَّانَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى  بِذِي الْحُلَيْفَةِ  ، ثُمَّ أُتِيَ بِرَاحِلَتِهِ فَرَكِبَهَا فَلَمَّا اسْتَوَتْ بِهِ عَلَى الْبَيْدَاءِ أَهَلَّ  .","","Sharh Ma'ani al-Athar 3533","","عبد الله بن عباس عن مسلم بن عبد الله الأحرد عن قتادة بن دعامة عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3313","3534  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدُ بْنُ مُوسَى ، قَالَ :  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  حَجَّةِ الْوَدَاعِ  رَكِبَ نَاقَتَهُ  الْقَصْوَاءَ  ، فَلَمَّا اسْتَوَتْ بِهِ عَلَى الْبَيْدَاءِ أَهَلَّ  .         [2/121]","","Sharh Ma'ani al-Athar 3534","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن حاتم بن إسماعيل الحارثي عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3314","3535  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ مَيْمُونٍ ، قَالَ :  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، قَالَ :  ثَنَا  أَبُو عَمْرٍو - هُوَ الْأَوْزَاعِيُّ - عَطَاءٍ - هُوَ ابْنُ أَبِي رَبَاحٍ -  أَنَّهُ سَمِعَهُ  يُحَدِّثُ ، عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ يَعْنِي سَمِعَهُ يُخْبِرُ ، عَنْ  إِهْلَالِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  ذِي الْحُلَيْفَةِ  حِينَ اسْتَوَتْ بِهِ رَاحِلَتُهُ  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى هَذَا ، فَاسْتَحَبُّوا الْإِحْرَامَ مِنَ  الْبَيْدَاءِ  لِإِحْرَامِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْهَا ، وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : قَدْ يَجُوزُ أَنْ يَكُونَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحْرَمَ مِنْهَا ، لَا لِأَنَّهُ قَصَدَ أَنْ يَكُونَ إِحْرَامُهُ مِنْهَا خَاصَّةً لِفَضْلٍ فِي الْإِحْرَامِ مِنْهَا عَلَى الْإِحْرَامِ مِمَّا سِوَاهَا ، وَقَدْ رَأَيْنَاهُ فَعَلَ أَشْيَاءَ فِي حَجَّتِهِ فِي مَوَاضِعَ لَا لِفَضْلٍ قَصَدَهُ فِي تِلْكَ الْمَوَاضِعِ مِمَّا يَفْضُلُ بِهِ غَيْرُهَا مِنْ سَائِرِ الْمَوَاضِعِ ، مِنْ ذَلِكَ نُزُولُهُ  بِالْمُحَصَّبِ  مِنْ  مِنًى  ، فَلَمْ يَكُنْ ذَلِكَ ؛ لِأَنَّهُ سُنَّةٌ ، وَلَكِنَّهُ لِمَعْنًى آخَرَ قَدِ اخْتَلَفَ النَّاسُ فِيهِ ، مَا هُوَ ؟  فَرُوِيَ عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا فِي ذَلِكَ مَا .","","Sharh Ma'ani al-Athar 3535","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن محمد بن عبد الله بن ميمون السكري عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3315","3536  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا أَنَّهَا قَالَتْ لَهُ :  إِنَّمَا كَانَ مَنْزِلًا نَزَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؛ لِأَنَّهُ كَانَ أَسْمَحَ لِلْخُرُوجِ  وَلَمْ يَكُنْ  عُرْوَةُ  يَحْصُبُ وَلَا  أَسْمَاءُ بِنْتُ أَبِي بَكْرٍ  رَضِيَ اللهُ عَنْهُمَا  .","","Sharh Ma'ani al-Athar 3536","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أنس بن عياض الليثي عن يونس بن عبد الأعلى عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3316","وَرُوِيَ عَنْ أَبِي رَافِعٍ ، أَنَّهُ قَالَ :  إِنَّمَا أَمَرَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ أَضْرِبَ لَهُ الْخَيْمَةَ  ، وَلَمْ يَأْمُرْنِي بِمَكَانٍ بِعَيْنِهِ ، فَضَرَبْتُهَا  بِالْمُحَصَّبِ  .  3537  -  حَدَّثَنَا  بِذَلِكَ ابْنُ أَبِي عِمْرَانَ ، قَالَ :  ثَنَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أَبِي رَافِعٍ ، .","","Sharh Ma'ani al-Athar 3537","","أبو رافع القبطي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن صالح بن كيسان الدوسي عن سفيان بن عيينة عن إسحاق بن إسماعيل الطالقاني عن أحمد بن أبي عمران البغدادي عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3317","وَرُوِيَ عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا مَا  3538  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  خَالِدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  شُعْبَةَ - يَعْنِي مَوْلَى ابْنِ عَبَّاسٍ -  أَنَّ  ابْنَ عَبَّاسٍ قَالَ : (  إِنَّمَا كَانَ  الْمُحَصَّبُ  ؛ لِأَنَّ الْعَرَبَ كَانَتْ تَخَافُ بَعْضُهَا بَعْضًا فَيَرْتَادُونَ فَيَخْرُجُونَ جَمِيعًا  ، فَجَرَى النَّاسُ عَلَيْهَا  ) .","","Sharh Ma'ani al-Athar 3538","","عبد الله بن عباس عن شعبة بن دينار القرشي عن محمد بن عبد الرحمن بن المغيرة عن خالد بن عبد الرحمن الخراساني عن الربيع بن سليمان المرادي عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3318","3539  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  خَالِدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  صَالِحٍ مَوْلَى التَّوْأَمَةِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، مِثْلَهُ . غَيْرَ أَنَّهُ قَالَ :  قَدْ كَانَتْ  تَمِيمٌ  وَرَبِيعَةُ  يَخَافُ بَعْضُهَا بَعْضًا  "" .","","Sharh Ma'ani al-Athar 3539","","عبد الله بن عباس عن صالح بن نبهان الجمحي عن محمد بن عبد الرحمن بن المغيرة عن خالد بن عبد الرحمن الخراساني عن الربيع بن سليمان المرادي عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3319","[2/122]      3540  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرٍو ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  لَيْسَ  الْمُحَصَّبُ  بِشَيْءٍ ، إِنَّمَا هُوَ مَنْزِلٌ نَزَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  فَلَمَّا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ حَصَّبَ وَلَمْ يَكُنْ ذَلِكَ التَّحْصِيبُ ؛ لِأَنَّهُ سُنَّةٌ ، فَكَذَلِكَ يَجُوزُ أَنْ يَكُونَ أَحْرَمَ حِينَ صَارَ عَلَى الْبَيْدَاءِ لَا ؛ لِأَنَّ ذَلِكَ سُنَّةٌ .  وَقَدْ أَنْكَرَ قَوْمٌ أَنْ يَكُونَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحْرَمَ مِنَ الْبَيْدَاءِ ، وَقَالُوا : مَا أَحْرَمَ إِلَّا مِنْ عِنْدِ الْمَسْجِدِ ، وَرَوَوْا ذَلِكَ عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا .","","Sharh Ma'ani al-Athar 3540","","عبد الله بن عباس عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3320","3541  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ مَسْلَمَةَ ، قَالَ :  قَرَأْتُ عَلَى  مَالِكٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ ،  أَنَّهُ قَالَ :  بَيْدَاؤُكُمْ  هَذِهِ الَّتِي تَكْذِبُونَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيهَا  ، مَا أَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا مِنْ عِنْدِ الْمَسْجِدِ  ،  يَعْنِي  مَسْجِدَ ذِي الْحُلَيْفَةِ  .","","Sharh Ma'ani al-Athar 3541","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن يزيد بن سنان القزاز عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3321","3542  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  مُوسَى ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3542","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3322","3543  -  حَدَّثَنَا  نَصْرُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  الْخَصِيبُ ، قَالَ :  ثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  عَنْ  مُوسَى ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  قَالُوا : وَإِنَّمَا كَانَ ذَلِكَ بَعْدَ مَا رَكِبَ رَاحِلَتَهُ .","","Sharh Ma'ani al-Athar 3543","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن موسى بن عقبة عن وهيب بن خالد الكرابيسي عن الخصيب بن ناصح الحارثي عن نصر بن مرزوق المصري عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3323","3544  - وَذَكَرُوا فِي ذَلِكَ مَا  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  صَالِحُ بْنُ كَيْسَانَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَهَلَّ حِينَ اسْتَوَتْ بِهِ رَاحِلَتُهُ قَائِمَةً  .","","Sharh Ma'ani al-Athar 3544","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن صالح بن كيسان الدوسي عن ابن جريج عن مكي بن إبراهيم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3324","3545  -  حَدَّثَنَا  رَبِيعٌ الْجِيزِيُّ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَنَّهُ  كَانَ يُهِلُّ إِذَا اسْتَوَتْ بِهِ رَاحِلَتُهُ قَائِمَةً  ،  قَالَ : وَكَانَ  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا يَفْعَلُهُ  .","","Sharh Ma'ani al-Athar 3545","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن أسد السنة عن الربيع بن سليمان الجيزي عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3325","3546  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  أَنَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  بَاتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِذِي الْحُلَيْفَةِ  حَتَّى أَصْبَحَ  ، فَلَمَّا رَكِبَ رَاحِلَتَهُ وَاسْتَوَتْ بِهِ أَهَلَّ  .","","Sharh Ma'ani al-Athar 3546","","أنس بن مالك عن محمد بن المنكدر عن ابن جريج عن مكي بن إبراهيم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3326","3547  -  حَدَّثَنَا  صَالِحُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ، قَالَ :  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  ثَنَا  ابْنُ شِهَابٍ ،  عَنْ  أَنَسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  قَالُوا : وَيَنْبَغِي أَنْ يَكُونَ ذَلِكَ بَعْدَ مَا تَنْبَعِثُ بِهِ نَاقَتُهُ ، وَذَكَرُوا فِي ذَلِكَ مَا","","Sharh Ma'ani al-Athar 3547","","أنس بن مالك عن الزهري عن ابن جريج عن عيسى بن يونس بن أبي إسحاق عن حجاج بن إبراهيم الأبناوي عن صالح بن عبد الرحمن المصري عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3327","3548  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  عُبَيْدِ بْنِ جُرَيْجٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا قَالَ :  لَمْ أَرَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُهِلُّ حَتَّى تَنْبَعِثَ بِهِ رَاحِلَتُهُ  .","","Sharh Ma'ani al-Athar 3548","","عبد الله بن عمر بن الخطاب عن عبيد بن جريج التيمي عن سعيد المقبري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3328","3549  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا وَضَعَ رِجْلَهُ فِي  الْغَرْزِ  ، وَانْبَعَثَتْ بِهِ رَاحِلَتُهُ قَائِمَةً أَهَلَّ مِنْ  ذِي الْحُلَيْفَةِ  .  فَلَمَّا اخْتَلَفُوا فِي ذَلِكَ أَرَدْنَا أَنْ نَنْظُرَ مِنْ أَيْنَ جَاءَ اخْتِلَافُهُمْ . ؟","","Sharh Ma'ani al-Athar 3549","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن علي بن مسهر القرشي عن أبو بكر ابن أبي شيبة عن فهد بن سليمان الدلال عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3329","[2/123]      3550  -  فَإِذَا إِسْمَاعِيلُ بْنُ إِسْحَاقَ بْنِ سَهْلٍ الْكُوفِيُّ قَدْ  حَدَّثَنَا  إِمْلَاءً  ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  خُصَيْفٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ :  قِيلَ  لِابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا : كَيْفَ اخْتَلَفَ النَّاسُ فِي إِهْلَالِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟  فَقَالَتْ طَائِفَةٌ : أَهَلَّ فِي مُصَلَّاهُ ، وَقَالَتْ طَائِفَةٌ : حِينَ اسْتَوَتْ بِهِ رَاحِلَتُهُ . وَقَالَتْ طَائِفَةٌ : حِينَ عَلَا عَلَى الْبَيْدَاءِ ، فَقَالَ : سَأُخْبِرُكُمْ عَنْ ذَلِكَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَهَلَّ فِي مُصَلَّاهُ ، فَشَهِدَهُ قَوْمٌ فَأَخْبَرُوا بِذَلِكَ  .  فَلَمَّا اسْتَوَتْ بِهِ رَاحِلَتُهُ أَهَلَّ ، فَشَهِدَهُ قَوْمٌ لَمْ يَشْهَدُوهُ فِي الْمَرَّةِ الْأُولَى ، فَقَالُوا : أَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ السَّاعَةَ ، فَأَخْبَرُوا بِذَلِكَ .  فَلَمَّا عَلَا عَلَى الْبَيْدَاءِ أَهَلَّ ، فَشَهِدَهُ قَوْمٌ لَمْ يَشْهَدُوهُ فِي الْمَرَّتَيْنِ الْأُولَيَيْنِ ، فَقَالُوا : أَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ السَّاعَةَ ، فَأَخْبَرُوا بِذَلِكَ .  وَإِنَّمَا كَانَ إِهْلَالُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي مُصَلَّاهُ  .  فَبَيَّنَ  عَبْدُ اللهِ بْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا الْوَجْهَ الَّذِي مِنْهُ جَاءَ اخْتِلَافُهُمْ ، وَأَنَّ إِهْلَالَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّذِي ابْتَدَأَ  الْحَجَّ  وَدَخَلَ بِهِ فِيهِ كَانَ فِي مُصَلَّاهُ . فَبِهَذَا نَأْخُذُ .  وَيَنْبَغِي لِلرَّجُلِ إِذَا أَرَادَ الْإِحْرَامَ أَنْ يُصَلِّيَ رَكْعَتَيْنِ ، ثُمَّ يُحْرِمَ فِي دُبُرِهِمَا ، كَمَا فَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  وَهَذَا قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى .  وَقَدْ رُوِيَ عَنِ  الْحَسَنِ بْنِ مُحَمَّدٍ  فِي ذَلِكَ شَيْءٌ مِمَّا رُوِيَ عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا  .","","Sharh Ma'ani al-Athar 3550","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن خصيف الجزري عن عبد السلام بن حرب الملائي عن الفضل بن دكين عن ترنجة إسماعيل بن إسحاق مولى قريش عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3330","3551  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ ، قَالَ :  ثَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  حَبِيبُ بْنُ أَبِي ثَابِتٍ ،  أَنَّهُ سَمِعَ  الْحَسَنَ بْنَ مُحَمَّدِ بْنِ عَلِيٍّ يَقُولُ :  كُلُّ ذَلِكَ قَدْ فَعَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَدْ أَهَلَّ حِينَ اسْتَوَتْ بِهِ رَاحِلَتُهُ  ، وَقَدْ أَهَلَّ حِينَ جَاءَ  الْبَيْدَاءَ  .","","Sharh Ma'ani al-Athar 3551","","الحسن بن محمد بن علي بن أبي طالب عن حبيب بن أبي ثابت الكاهلي عن ابن جريج عن عثمان بن الهيثم بن جهم الأشج عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الإهلال في الحج من أين ينبغي أن يكون"
"3331","[2/124]      4 - بَابٌ : التَّلْبِيَةُ كَيْفَ هِيَ ؟  3552  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْمُقَدَّمِيُّ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَبَانَ بْنِ تَغْلِبَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  كَانَتْ تَلْبِيَةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَبَّيْكَ  اللَّهُمَّ  لَبَّيْكَ  ،  لَبَّيْكَ  لَا شَرِيكَ لَكَ  لَبَّيْكَ  ، إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ  .","","Sharh Ma'ani al-Athar 3552","","عبد الله بن مسعود عن عبد الرحمن بن يزيد النخعي عن أبو إسحاق السبيعي عن أبان بن تغلب بن رياح عن حماد بن زيد عن محمد بن أبي بكر المقدمي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب التلبية كيف هي"
"3332","3553  -  حَدَّثَنَا  فَهْدٌ  ، قَالَ :  ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ ، قَالَ :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَارَةَ ،  عَنْ  أَبِي عَطِيَّةَ ، قَالَ :  قَالَتْ  عَائِشَةُ رَضِيَ اللهُ عَنْهَا : (  إِنِّي لَأَحْفَظُ كَيْفَ  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُلَبِّي  ) . فَذَكَرَتْ ذَلِكَ أَيْضًا .  في طبعة عالم الكتب : ( ثهد ) ، والمثبت من النسخ الخطية.","","Sharh Ma'ani al-Athar 3553","","عائشة بنت أبي بكر الصديق عن مالك بن عامر الهمداني عن عمارة بن عمير التيمي عن الأعمش عن سلام بن سليم الحنفي عن الحسن بن الربيع البوراني عن فهد بن سليمان الدلال عن الطحاوي","باب التلبية كيف هي"
"3333","3554  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ تَلْبِيَةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَتْ كَذَلِكَ ، وَزَادَ : "" وَالْمُلْكَ ، لَا شَرِيكَ لَكَ  .","","Sharh Ma'ani al-Athar 3554","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب التلبية كيف هي"
"3334","3555  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ مِنْهَالٍ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ، قَالَ :  أَنَا  أَيُّوبُ وَعُبَيْدُ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3555","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب التلبية كيف هي"
"3335","3556  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ الْمَدِينِيُّ ، قَالَ :  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَبَّى فِي حَجَّتِهِ  كَذَلِكَ أَيْضًا  .","","Sharh Ma'ani al-Athar 3556","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن حاتم بن إسماعيل الحارثي عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب التلبية كيف هي"
"3336","3557  -  حَدَّثَنَا  أَبُو أُمَيَّةَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ زِيَادٍ بْنِ  زِيَادٍ ، قَالَ :  ثَنَا  شَرْقِيُّ بْنُ قُطَامِيٍّ ، قَالَ :  أَنَا  أَبُو طَلْقٍ الْعَائِذِيُّ ، قَالَ :  سَمِعْتُ  شَرَاحِيلَ بْنَ الْقَعْقَاعِ يَقُولُ :  سَمِعْتُ  عَمْرَو بْنَ مَعْدِيكَرِبَ يَقُولُ :  لَقَدْ رَأَيْتُنَا مُنْذُ قَرِيبٍ وَنَحْنُ إِذَا حَجَجْنَا  نَقُولُ :         [2/125]      وَنَحْنُ الْيَوْمَ نَقُولُ كَمَا عَلَّمَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  قَالَ : قُلْتُ : وَكَيْفَ عَلَّمَكُمْ ؟  فَذَكَرَ التَّلْبِيَةَ عَلَى مِثْلِ مَا فِي الْحَدِيثِ الَّذِي قَبْلَ هَذَا .  فَأَجْمَعَ الْمُسْلِمُونَ جَمِيعًا عَلَى أَنَّهُ هَكَذَا يُلَبَّى بِالْحَجِّ .  غَيْرَ أَنَّ قَوْمًا قَالُوا : لَا بَأْسَ لِلرَّجُلِ أَنْ يَزِيدَ فِيهَا مِنَ الذِّكْرِ لِلهِ مَا أَحَبَّ ، وَهُوَ قَوْلُ  مُحَمَّدٍ  وَالثَّوْرِيِّ  وَالْأَوْزَاعِيِّ  .  في طبعة عالم الكتب عن والمثبت هو الصواب ، كذا في بعض النسخ ، وعند المصنف في شرح مشكل الآثار ، وينظر مصادر التخريج.","","Sharh Ma'ani al-Athar 3557","","عمرو بن معد يكرب الزبيدي عن شرحبيل بن القعقاع عن عدي بن حنظلة الزهري عن شرقي بن قطامى الكلبي عن محمد بن زياد بن زبار الكلبي عن محمد بن إبراهيم بن مسلم السجستاني عن الطحاوي","باب التلبية كيف هي"
"3337","- وَاحْتَجُّوا فِي ذَلِكَ بِمَا  3558  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ . (  ح  ) .  3559  -  وَحَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ قَالَا :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللهِ بْنِ أَبِي سَلَمَةَ ،  قَالَ  ابْنُ وَهْبٍ : إِنَّ عَبْدَ اللهِ بْنَ الْفَضْلِ  حَدَّثَهُ  .  وَقَالَ  أَبُو عَامِرٍ  ،  عَنْ  عَبْدِ اللهِ بْنِ الْفَضْلِ ،  عَنْ  عَبْدِ الرَّحْمَنِ الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، أَنَّهُ كَانَ يَقُولُ :  كَانَ مِنْ تَلْبِيَةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَبَّيْكَ إِلَهَ الْحَقِّ لَبَّيْكَ  .","","Sharh Ma'ani al-Athar 3558","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن عبد الله بن الفضل بن العباس الهاشمي عن عبد العزيز بن عبد الله الماجشون عن أبو عامر العقدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب التلبية كيف هي"
"3338","-  وَذَكَرُوا فِي ذَلِكَ أَيْضًا ، عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا  3560  - مَا  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  . (  ح  ) .  3561  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ، قَالَ :  أَنَا  أَيُّوبُ وَعُبَيْدُ اللهِ ، قَالُوا جَمِيعًا :  عَنْ  نَافِعٍ قَالَ :  كَانَ  ابْنُ عُمَرَ رَضِيَ اللهُ عَنْهُمَا يَزِيدُ فِي التَّلْبِيَةِ عَلَى التَّلْبِيَةِ الَّتِي قَدْ ذَكَرْنَاهَا عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَبَّيْكَ  لَبَّيْكَ ،  لَبَّيْكَ  وَسَعْدَيْكَ ،  وَالْخَيْرُ بِيَدَيْكَ ،  لَبَّيْكَ  وَالرَّغْبَاءُ إِلَيْكَ وَالْعَمَلُ  .  قَالُوا :  فَلَا بَأْسَ أَنْ يُزَادَ فِي التَّلْبِيَةِ مِثْلُ هَذَا وَشِبْهُهُ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : لَا يَنْبَغِي أَنْ يُزَادَ فِي التَّلْبِيَةِ عَلَى مَا قَدْ عَلَّمَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ النَّاسَ عَلَى مَا ذَكَرْنَا فِي حَدِيثِ  عَمْرِو بْنِ مَعْدِيكَرِبَ  ، ثُمَّ فَعَلَهُ هُوَ فِي الْحَدِيثِ الْآخَرِ ، وَلَمْ يُعَلِّمْ ذَلِكَ مَنْ عَلَّمَهُ ، وَهُوَ نَاقِصٌ عَنِ التَّلْبِيَةِ ، وَلَا قَالَ لَهُ : ( لَبِّ بِمَا شِئْتَ ) ، مِمَّا هُوَ مِنْ جِنْسِ هَذَا ، بَلْ عَلَّمَهُ كَمَا عَلَّمَ التَّكْبِيرَ فِي الصَّلَاةِ ، وَمِمَّا يَنْبَغِي أَنْ يُفْعَلَ فِيهَا مِمَّا سِوَى التَّكْبِيرِ .  فَكَمَا لَا يَنْبَغِي أَنْ يَتَعَدَّى فِي ذَلِكَ شَيْئًا مِمَّا عَلَّمَهُ ، فَكَذَلِكَ لَا يَنْبَغِي أَنْ يَتَعَدَّى فِي التَّلْبِيَةِ شَيْئًا مِمَّا عَلَّمَهُ .  وَقَدْ رُوِيَ نَحْوٌ مِنْ هَذَا عَنْ  سَعْدٍ  .","","Sharh Ma'ani al-Athar 3560","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب التلبية كيف هي"
"3339","3562  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  أَصْبَغُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي سَلَمَةَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ ،  أَنَّهُ سَمِعَ رَجُلًا يُلَبِّي ، يَقُولُ : ( لَبَّيْكَ ذَا الْمَعَارِجِ لَبَّيْكَ )  .  قَالَ  سَعْدٌ  : مَا هَكَذَا كُنَّا نُلَبِّي عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  فَهَذَا  سَعْدٌ  قَدْ كَرِهَ الزِّيَادَةَ عَلَى مَا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَّمَهُمْ مِنَ التَّلْبِيَةِ ، فَبِهَذَا نَأْخُذُ  .","","Sharh Ma'ani al-Athar 3562","","سعد بن أبي وقاص عن عامر بن سعد بن أبي وقاص عن عبد الله بن أبي سلمة الماجشون عن محمد بن عجلان عن عبد العزيز بن محمد الدراوردي عن أصبغ بن الفرج مولى عمر بن عبد العزيز عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب التلبية كيف هي"
"3340","[2/126]      5 - بَابُ التَّطْيُبِ  عِنْدَ الْإِحْرَامِ  3563  -  حَدَّثَنَا  أَبُو بَكْرَةَ بَكَّارُ بْنُ قُتَيْبَةَ ، قَالَ :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  ثَنَا  أَبِي ،  قَالَ :  سَمِعْتُ  قَيْسَ بْنَ سَعْدٍ  يُحَدِّثُ ، عَنْ  عَطَاءٍ ،  عَنْ  صَفْوَانَ بْنِ يَعْلَى بْنِ أُمَيَّةَ ،  عَنْ  أَبِيهِ ،  أَنَّ  رَجُلًا  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْجِعْرَانَةِ  وَعَلَيْهِ جُبَّةُ صُوفٍ ، وَهُوَ مُصَفِّرٌ لِحْيَتَهُ وَرَأْسَهُ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي قَدْ أَحْرَمْتُ وَأَنَا كَمَا تَرَى .  فَقَالَ :  انْزِعْ عَنْكَ الْجُبَّةَ ، وَاغْسِلْ عَنْكَ الصُّفْرَةَ ، وَمَا كُنْتَ صَانِعًا فِي حَجِّكَ فَاصْنَعْهُ فِي عُمْرَتِكَ  .  فَذَهَبَ قَوْمٌ إِلَى هَذَا الْحَدِيثِ ، فَكَرِهُوا بِهِ التَّطَيُّبَ عِنْدَ الْإِحْرَامِ ، وَقَالُوا بِمَا رُوِيَ عَنْ  عُمَرَ بْنِ الْخَطَّابِ  وَعُثْمَانَ بْنِ عَفَّانَ  رَضِيَ اللهُ عَنْهُمَا  .  في طبعة عالم الكتب : ( التطييب ) والمثبت من النسخ الخطية.","","Sharh Ma'ani al-Athar 3563","","يعلى بن أمية بن أبي عبيدة الحنظلى عن صفوان بن يعلى بن أمية التميمي عن عطاء بن أبي رباح عن قيس بن سعد الحبشي عن جرير بن حازم عن وهب بن جرير بن حازم عن بكار بن قتيبة البكراوي عن الطحاوي","باب التطيب عند الإحرام"
"3341","3564  -  حَدَّثَنَا  نَصْرُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  الْخَصِيبُ بْنُ نَاصِحٍ ، قَالَ :  ثَنَا  وَهْبُ بْنُ خَالِدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُمَا وَجَدَ رِيحَ طِيبٍ ، وَهُوَ  بِذِي الْحُلَيْفَةِ  ، فَقَالَ : مِمَّنْ هَذِهِ الرِّيحُ الطَّيِّبَةُ  .  فَقَالَ مُعَاوِيَةُ : (  مِنِّي  ) ، فَقَالَ  عُمَرُ  : مِنْكَ لَعَمْرِي ، مِنْكَ لَعَمْرِي .  فَقَالَ  مُعَاوِيَةُ  : ( لَا تَعْجَلْ عَلَيَّ يَا أَمِيرَ الْمُؤْمِنِينَ ؛ إِنَّ  أُمَّ حَبِيبَةَ  رَضِيَ اللهُ عَنْهَا طَيَّبَتْنِي وَأَقْسَمَتْ عَلَيَّ ) .  فَقَالَ لَهُ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : ( وَأَنَا أَقْسَمْتُ عَلَيْكَ لَتَرْجِعَنَّ إِلَيْهَا فَتَغْسِلَهُ عِنْدَهَا ، فَرَجَعَ إِلَيْهَا فَغَسَلَهُ فَلَحِقَ النَّاسَ بِالطَّرِيقِ  ) .","","Sharh Ma'ani al-Athar 3564","","معاوية بن أبي سفيان عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن وهب بن خالد الحميري عن الخصيب بن ناصح الحارثي عن نصر بن مرزوق المصري عن الطحاوي","باب التطيب عند الإحرام"
"3342","3565  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3565","","معاوية بن أبي سفيان عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب التطيب عند الإحرام"
"3343","3566  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  نَافِعٍ ،  عَنْ  أَسْلَمَ ،  عَنْ  عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3566","","عمر بن الخطاب عن أسلم العدوي مولى عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب التطيب عند الإحرام"
"3344","3567  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  شُعَيْبُ بْنُ اللَّيْثِ ، قَالَ :  ثَنَا  اللَّيْثُ ،  عَنْ  نَافِعٍ ،  عَنْ  أَسْلَمَ ،  عَنْ  عُمَرَ رَضِيَ اللهُ عَنْهُ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3567","","عمر بن الخطاب عن أسلم العدوي مولى عمر بن الخطاب عن نافع مولى ابن عمر عن الليث بن سعد عن شعيب بن الليث المصري عن الربيع بن سليمان المرادي عن الطحاوي","باب التطيب عند الإحرام"
"3345","3568  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِيهِ  قَالَ :  كُنْتُ مَعَ عُثْمَانَ رَضِيَ اللهُ عَنْهُ  بِذِي الْحُلَيْفَةِ  ، فَرَأَى رَجُلًا يُرِيدُ أَنْ يُحْرِمَ  ، وَقَدْ دَهَنَ رَأْسَهُ ، فَأَمَرَ بِهِ فَغَسَلَ رَأْسَهُ بِالطِّينِ  .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَلَمْ يَرَوْا بِالتَّطَيُّبِ عِنْدَ الْإِحْرَامِ بَأْسًا .  فَقَالُوا : أَمَّا حَدِيثُ  يَعْلَى  فَلَا حُجَّةَ فِيهِ لِمَنْ خَالَفَنَا  ، وَذَلِكَ أَنَّ الطِّيبَ الَّذِي كَانَ عَلَى ذَلِكَ الرَّجُلِ ، إِنَّمَا كَانَ صُفْرَةً ، وَهُوَ خَلُوقٌ ، فَذَلِكَ مَكْرُوهٌ لِلرَّجُلِ لَا لِلْإِحْرَامِ ، وَلَكِنَّهُ لِأَنَّهُ مَكْرُوهٌ فِي نَفْسِهِ فِي حَالِ الْإِحْلَالِ ، وَفِي حَالِ الْإِحْرَامِ ، وَإِنَّمَا أُبِيحَ مِنَ الطِّيبِ عِنْدَ الْإِحْرَامِ مَا هُوَ حَلَالٌ فِي حَالِ الْإِحْلَالِ .  وَقَدْ رُوِيَ عَنْ  يَعْلَى  مَا بَيَّنَ أَنَّ ذَلِكَ الَّذِي أَمَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَلِكَ الرَّجُلَ بِغَسْلِهِ كَانَ خَلُوقًا  .  في طبعة عالم الكتب : ( خالفتا ) ، والمثبت من النسخ الخطية.","","Sharh Ma'ani al-Athar 3568","","عثمان بن عفان عن إبراهيم بن عبد الرحمن بن عوف عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب التطيب عند الإحرام"
"3346","3569  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،         [2/127]      عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنْ  عَطَاءٍ ،  عَنْ  يَعْلَى بْنِ مُنَبِّهٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَأَى  رَجُلًا  لَبَّى بِعُمْرَةٍ وَعَلَيْهِ جُبَّةٌ وَشَيْءٌ مِنْ خَلُوقٍ  ، فَأَمَرَهُ أَنْ يَنْزِعَ الْجُبَّةَ وَيَمْسَحَ خَلُوقَهُ ، وَيَصْنَعَ فِي عُمْرَتِهِ مَا يَصْنَعُ فِي حَجَّتِهِ  .","","Sharh Ma'ani al-Athar 3569","","يعلى بن أمية بن أبي عبيدة الحنظلى عن عطاء بن أبي رباح عن مطر بن طهمان الوراق عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن محمد بن المنهال عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب التطيب عند الإحرام"
"3347","3570  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، أَنَّ عَطَاءَ بْنَ [أَبِي] رَبَاحٍ  حَدَّثَهُ  ،  عَنِ  [ابْنِ] يَعْلَى بْنِ مُنَبِّهٍ  عَنْ  أَبِيهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3570","","يعلى بن أمية بن أبي عبيدة الحنظلى عن صفوان بن يعلى بن أمية التميمي عن عطاء بن أبي رباح عن الليث بن سعد عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب التطيب عند الإحرام"
"3348","3571  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  حَبَّانُ بْنُ هِلَالٍ ، قَالَ :  ثَنَا  هَمَّامٌ ، قَالَ :  ثَنَا  عَطَاءٌ ،  عَنْ  صَفْوَانَ بْنِ يَعْلَى بْنِ أُمَيَّةَ ،  عَنْ  أَبِيهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ . غَيْرَ أَنَّهُ قَالَ :  وَاغْسِلْ عَنْكَ أَثَرَ  الْخَلُوقِ  أَوِ الصُّفْرَةِ  .","","Sharh Ma'ani al-Athar 3571","","يعلى بن أمية بن أبي عبيدة الحنظلى عن صفوان بن يعلى بن أمية التميمي عن عطاء بن أبي رباح عن همام بن يحيى بن دينار عن حبان بن هلال الباهلي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب التطيب عند الإحرام"
"3349","3572  -  حَدَّثَنَا  صَالِحُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، قَالَ :  ثَنَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَبْدُ الْمَلِكِ وَمَنْصُورٌ وَابْنُ أَبِي لَيْلَى ،  عَنْ  عَطَاءٍ ،  عَنْ  يَعْلَى بْنِ أُمَيَّةَ ،  أَنَّ  رَجُلًا  جَاءَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي أَحْرَمْتُ وَعَلَيَّ جُبَّتِي هَذِهِ ، وَعَلَى جُبَّتِهِ رُدُوعٌ مِنْ خَلُوقٍ ، وَالنَّاسُ يَسْخَرُونَ مِنِّي .  فَأَطْرَقَ  عَنْهُ سَاعَةً ، ثُمَّ قَالَ :  اخْلَعْ عَنْكَ هَذِهِ الْجُبَّةَ ، وَاغْسِلْ عَنْكَ هَذَا الزَّعْفَرَانَ  ، وَاصْنَعْ فِي عُمْرَتِكَ مَا كُنْتَ صَانِعًا فِي حَجَّتِكَ  .  فَبَيَّنَتْ لَنَا هَذِهِ الْآثَارُ أَنَّ ذَلِكَ الطِّيبَ الَّذِي أَمَرَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِغَسْلِهِ كَانَ خَلُوقًا ، وَذَلِكَ مَنْهِيٌّ عَنْهُ فِي حَالِ الْإِحْلَالِ وَحَالِ الْإِحْرَامِ .  فَيَجُوزُ أَنْ يَكُونَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرَادَ بِأَمْرِهِ إِيَّاهُ بِغَسْلِهِ لِمَا كَانَ مِنْ نَهْيِهِ أَنْ يَتَزَعْفَرَ الرَّجُلُ ، لَا لِأَنَّهُ طِيبٌ تَطَيَّبَ بِهِ قَبْلَ الْإِحْرَامِ ، ثُمَّ حَرَّمَهُ عَلَيْهِ الْإِحْرَامُ  .","","Sharh Ma'ani al-Athar 3572","","يعلى بن أمية بن أبي عبيدة الحنظلى عن عطاء بن أبي رباح عن محمد بن عبد الرحمن بن أبي ليلى عن هشيم بن بشير عن سعيد بن منصور عن صالح بن عبد الرحمن المصري عن الطحاوي","باب التطيب عند الإحرام"
"3350","3573  -  فَأَمَّا مَا رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي نَهْيِهِ الرِّجَالَ عَنِ التَّزَعْفُرِ  ،  فَإِنَّ ابْنَ أَبِي دَاوُدَ  حَدَّثَنَا  ، قَالَ :  ثَنَا  أَبُو مَعْمَرٍ ، قَالَ :  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَتَزَعْفَرَ الرَّجُلُ  .","","Sharh Ma'ani al-Athar 3573","","أنس بن مالك عن عبد العزيز بن صهيب البناني عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب التطيب عند الإحرام"
"3351","3574  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  مُسَدَّدٌ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، عَنِ التَّزَعْفُرِ لِلرِّجَالِ  .","","Sharh Ma'ani al-Athar 3574","","أنس بن مالك عن عبد العزيز بن صهيب البناني عن حماد بن زيد عن مسدد بن مسرهد عن بكار بن قتيبة البكراوي عن الطحاوي","باب التطيب عند الإحرام"
"3352","3575  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3575","","أنس بن مالك عن عبد العزيز بن صهيب البناني عن حماد بن زيد عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب التطيب عند الإحرام"
"3353","3576  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عُلَيَّةَ ، قَالَ :  ( أَرَاهُ  عَنْ  عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ )  ،  عَنْ  أَنَسٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الرَّجُلَ أَنْ يَتَزَعْفَرَ  .","","Sharh Ma'ani al-Athar 3576","","أنس بن مالك عن عبد العزيز بن صهيب البناني عن إسماعيل ابن علية عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب التطيب عند الإحرام"
"3354","3577  -  حَدَّثَنَا  صَالِحُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، قَالَ :  ثَنَا  هُشَيْمٌ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ التَّزَعْفُرِ  .","","Sharh Ma'ani al-Athar 3577","","أنس بن مالك عن عبد العزيز بن صهيب البناني عن هشيم بن بشير عن سعيد بن منصور عن صالح بن عبد الرحمن المصري عن الطحاوي","باب التطيب عند الإحرام"
"3355","[2/128]      3578  -  حَدَّثَنَا  ابْنُ أَبِي عِمْرَانَ وَابْنُ أَبِي دَاوُدَ قَالَا :  ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالَ :  أَنَا  شُعْبَةُ ، قَالَ :  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ التَّزَعْفُرِ  .  قَالَ  عَلِيٌّ  - فِيمَا ذَكَرَ  ابْنُ أَبِي عِمْرَانَ  خَاصَّةً - :  ثُمَّ لَقِيتُ  إِسْمَاعِيلَ  فَسَأَلْتُهُ عَنْ ذَلِكَ ، وَأَخْبَرْتُهُ أَنَّ  شُعْبَةَ  حَدَّثَنَا بِهِ عَنْهُ ،  فَقَالَ لِي  : لَيْسَ هَكَذَا حَدَّثْتُهُ ، إِنَّمَا حَدَّثْتُهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى أَنْ يَتَزَعْفَرَ الرَّجُلُ .  قَالَ  ابْنُ أَبِي عِمْرَانَ  :  أَرَادَ بِذَلِكَ أَنَّ النَّهْيَ الَّذِي كَانَ مِنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ وَقَعَ عَلَى الرِّجَالِ خَاصَّةً دُونَ النِّسَاءِ  .","","Sharh Ma'ani al-Athar 3578","","أنس بن مالك عن عبد العزيز بن صهيب البناني عن إسماعيل ابن علية عن شعبة بن الحجاج عن علي بن الجعد عن أحمد بن أبي عمران البغدادي عن الطحاوي","باب التطيب عند الإحرام"
"3356","3579  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْمُقَدَّمِيُّ ، قَالَ :  ثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ، قَالَ :  سَمِعْتُ  أَبَا حَفْصِ بْنَ عَمْرٍو  يُحَدِّثُ ، عَنْ  يَعْلَى أَنَّهُ  مَرَّ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ مُتَخَلِّقٌ ، فَقَالَ :  أَلَكَ امْرَأَةٌ ؟ "" فَقَالَ : لَا . فَقَالَ : "" اذْهَبْ فَاغْسِلْهُ  .","","Sharh Ma'ani al-Athar 3579","","يعلى بن مرة الثقفي عن عبد الله بن حفص عن عطاء بن السائب عن شعبة بن الحجاج عن خالد الصدق عن محمد بن أبي بكر المقدمي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب التطيب عند الإحرام"
"3357","3580  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو عَامِرٍ . (  ح  ) .  3581  -  وَحَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  رَوْحٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  رَجُلٍ مِنْ ثَقِيفَ ،  عَنْ  يَعْلَى ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  هَكَذَا قَالَ  أَبُو بَكْرَةَ  فِي حَدِيثِهِ .  وَقَالَ  عَلِيٌّ  فِي حَدِيثِهِ عَنْ  عَطَاءِ بْنِ السَّائِبِ  ، قَالَ : سَمِعْتُ  أَبَا حَفْصِ بْنَ عَمْرٍو  ،  وَأَبَا عَمْرِو بْنَ حَفْصٍ الثَّقَفِيَّ  .","","Sharh Ma'ani al-Athar 3580","","يعلى بن مرة الثقفي عن رجل من ثقيف عن عطاء بن السائب عن شعبة بن الحجاج عن روح بن عبادة القيسي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب التطيب عند الإحرام"
"3358","3582  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  عَيَّاشٌ الرَّقَّامُ ، قَالَ :  ثَنَا  عَبْدُ الْأَعْلَى ، قَالَ :  ثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ - أَوْ مَطَرٍ  -  عَنِ  الْحَسَنِ ،  عَنْ  عِمْرَانَ بْنِ حُصَيْنٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا وَطِيبُ الرِّجَالِ رِيحٌ لَا لَوْنٌ ، أَلَا وَطِيبُ النِّسَاءِ لَوْنٌ لَا رِيحٌ  .","","Sharh Ma'ani al-Athar 3582","","عمران بن حصين بن عبيد بن خلف الخزاعي عن الحسن البصري عن مطر بن طهمان الوراق عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن عياش بن الوليد الرقام عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب التطيب عند الإحرام"
"3359","3583  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَجَّاجِ الْحَضْرَمِيُّ ، قَالَ :  ثَنَا  صَاعِدُ بْنُ عُبَيْدٍ ، قَالَ :  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ، قَالَ :  ثَنَا  حُمَيْدٌ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ .","","Sharh Ma'ani al-Athar 3583","","أنس بن مالك عن حميد الطويل عن زهير بن معاوية بن حديج عن صاعد بن عبيد الحراني عن محمد بن الحجاج بن سليمان الجوهري عن الطحاوي","باب التطيب عند الإحرام"
"3360","3584  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  سَلْمٍ الْعَلَوِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعَلَيْهِ صُفْرَةٌ ، فَلَمَّا قَامَ قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ أَمَرْتُمْ هَذَا يَدَعُ هَذِهِ الصُّفْرَةَ  .  قَالَ : وَكَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يُوَاجِهُ الرَّجُلَ بِشَيْءٍ فِي وَجْهِهِ  .","","Sharh Ma'ani al-Athar 3584","","أنس بن مالك عن سلم بن قيس العلوي عن حماد بن زيد عن سليمان بن حرب الواشحي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب التطيب عند الإحرام"
"3361","3585  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو أَحْمَدَ ، قَالَ :  ثَنَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنِ  الرَّبِيعِ بْنِ أَنَسٍ ،  عَنْ  جَدَّيْهِ  ، قَالَا :  سَمِعْنَا  أَبَا مُوسَى يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُقْبَلُ صَلَاةُ رَجُلٍ وَفِي جَسَدِهِ شَيْءٌ مِنْ خَلُوقٍ  .","","Sharh Ma'ani al-Athar 3585","","أبو موسى الأشعري عن زياد جد الربيع بن أنس عن الربيع بن أنس البكري عن عيسى بن أبي عيسى الرازي عن محمد بن عبد الله بن الزبير عن بكار بن قتيبة البكراوي عن الطحاوي","باب التطيب عند الإحرام"
"3362","3586  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ عَامِرٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  إِسْحَاقَ بْنِ سُوَيْدٍ ،  عَنْ  أُمِّ حَبِيبَةَ رَضِيَ اللهُ عَنْهَا ،  عَنِ  الرَّجُلِ الَّذِي كَانَ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَاجَةٍ وَأَنَا مُتَخَلِّقٌ ، فَقَالَ : "" اذْهَبْ فَاغْتَسِلْ  .         [2/129]      فَذَهَبْتُ فَاغْتَسَلْتُ ، ثُمَّ جِئْتُ ، فَقَالَ : اذْهَبْ فَاغْتَسِلْ ، فَذَهَبْتُ فَأَخَذْتُ شَيْئًا ، فَجَعَلْتُ أَتَتَبَّعُ بِهِ وَضَرَهُ  .  فَنَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الرِّجَالَ فِي هَذِهِ الْآثَارِ كُلِّهَا عَنِ التَّزَعْفُرِ .  فَإِنَّمَا أَمَرَ الرَّجُلَ الَّذِي أَمَرَهُ بِغَسْلِ طِيبِهِ الَّذِي كَانَ عَلَيْهِ فِي حَدِيثِ  يَعْلَى  ؛ لِأَنَّهُ لَمْ يَكُنْ مِنْ طِيبِ الرِّجَالِ .  وَلَيْسَ فِي ذَلِكَ دَلِيلٌ عَلَى حُكْمِ مَنْ أَرَادَ الْإِحْرَامَ ، هَلْ لَهُ أَنْ يَتَطَيَّبَ بِطِيبٍ يَبْقَى عَلَيْهِ بَعْدَ الْإِحْرَامِ أَمْ لَا ؟ وَأَمَّا مَا رَوَوْهُ عَنْ  عُمَرَ  وَعُثْمَانَ  رَضِيَ اللهُ عَنْهُمَا فِي ذَلِكَ ، فَإِنَّهُ قَدْ خَالَفَهُمَا فِي ذَلِكَ  عَبْدُ اللهِ بْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا .","","Sharh Ma'ani al-Athar 3586","","أحد الصحابة عن رملة بنت أبي سفيان زوج رسول الله عن إسحاق بن سويد بن هبيرة العدوي عن شعبة بن الحجاج عن سعيد بن عامر الضبعي عن بكار بن قتيبة البكراوي عن الطحاوي","باب التطيب عند الإحرام"
"3363","3587  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عُثْمَانُ بْنُ عُمَرَ ، قَالَ :  ثَنَا  عُيَيْنَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِيهِ ،  أَنَّهُ قَالَ :  انْطَلَقْتُ حَاجًّا فَرَافَقَنِي عُثْمَانُ بْنُ أَبِي الْعَاصِ . فَلَمَّا كَانَ عِنْدَ الْإِحْرَامِ قَالَ : ( اغْسِلُوا رُءُوسَكُمْ بِهَذَا الْخَطْمِيِّ الْأَبْيَضِ  ، وَلَا يَمَسَّ أَحَدٌ مِنْكُمْ غَيْرَهُ ) ، فَوَقَعَ فِي نَفْسِي مِنْ ذَلِكَ شَيْءٌ . فَقَدِمْتُ مَكَّةَ فَسَأَلْتُ ابْنَ عُمَرَ  وَابْنَ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمْ ، فَأَمَّا ابْنُ عُمَرَ  فَقَالَ  : "" مَا أُحِبُّهُ "" .  وَأَمَّا ابْنُ عَبَّاسٍ ،  فَقَالَ  : أَمَّا أَنَا فَأُضَمِّخُ بِهِ رَأْسِي ، ثُمَّ أُحِبُّ بَقَاءَهُ  ،  فَهَذَا  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا قَدْ خَالَفَ  عُمَرَ  وَعُثْمَانَ  وَابْنَ عُمَرَ  وَعُثْمَانَ بْنَ أَبِي الْعَاصِ  فِي ذَلِكَ .  وَقَدْ رُوِيَ فِي ذَلِكَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا يَدُلُّ عَلَى إِبَاحَتِهِ  .","","Sharh Ma'ani al-Athar 3587","","عبد الله بن عباس عن عبد الرحمن بن جوشن الغطفاني عن عيينة بن عبد الرحمن الغطفاني عن عثمان بن عمر بن فارس عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب التطيب عند الإحرام"
"3364","3588  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ - يَعْنِي إِبْرَاهِيمَ - قَالَ :  ثَنَا  بِشْرُ بْنُ عُمَرَ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  كَأَنِّي أَنْظُرُ إِلَى  وَبِيصِ  الطِّيبِ فِي مَفْرِقِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحْرِمٌ  .","","Sharh Ma'ani al-Athar 3588","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن بشر بن عمر الزهراني عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب التطيب عند الإحرام"
"3365","3589  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ، قَالَ :  أَنَا  شُعْبَةُ ، فَذَكَرَ مِثْلَهُ  بِإِسْنَادِهِ  .","","Sharh Ma'ani al-Athar 3589","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن عبد الله بن رجاء الغداني عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب التطيب عند الإحرام"
"3366","3590  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ وَأَبُو عَامِرٍ الْعَقَدِيُّ قَالَا :  ثَنَا  هِشَامُ بْنُ أَبِي عَبْدِ اللهِ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3590","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن هشام الدستوائي عن أبو عامر العقدي عن بكار بن قتيبة البكراوي عن الطحاوي","باب التطيب عند الإحرام"
"3367","3591  -  حَدَّثَنَا  ابْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  حَمَّادٍ وَعَطَاءِ بْنِ السَّائِبِ ،  عَنْ  إِبْرَاهِيمَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3591","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن عطاء بن السائب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب التطيب عند الإحرام"
"3368","3592  -  حَدَّثَنَا  حُسَيْنُ بْنُ نَصْرٍ ، قَالَ :  ثَنَا  الْفِرْيَابِيُّ ، قَالَ :  ثَنَا  مَالِكُ بْنُ مِغْوَلٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3592","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن مالك بن مغول الصهيبي عن محمد بن يوسف الفريابي عن الحسين بن نصر بن معارك البغدادي عن الطحاوي","باب التطيب عند الإحرام"
"3369","3593  -  حَدَّثَنَا  ابْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ، قَالَ :  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ         [2/130]      بْنِ الْأَسْوَدِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا أَنَّهَا  كَانَتْ تُطَيِّبُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِأَطْيَبِ مَا تَجِدُ مِنَ الطِّيبِ  ، قَالَتْ : حَتَّى إِنِّي لَأَرَى  وَبِيصَ  الطِّيبِ فِي رَأْسِهِ وَلِحْيَتِهِ  .","","Sharh Ma'ani al-Athar 3593","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب التطيب عند الإحرام"
"3370","3595  -  حَدَّثَنَا  ابْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  أَبُو زَيْدٍ عَبْدُ الرَّحْمَنِ بْنُ أَبِي الْعُمُرِ ، قَالَ :  أَنَا  يَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ الزُّهْرِيُّ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا قَالَتْ :  كُنْتُ أُطَيِّبُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْغَالِيَةِ  الْجَيِّدَةِ عِنْدَ إِحْرَامِهِ  .","","Sharh Ma'ani al-Athar 3595","","عائشة بنت أبي بكر الصديق عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن يعقوب بن عبد الرحمن الإسكندراني عن محمد بن أبي عبد الرحمن المكي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب التطيب عند الإحرام"
"3371","3596  -  حَدَّثَنَا  نَصْرُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  الْخَصِيبُ بْنُ نَاصِحٍ ، قَالَ :  ثَنَا  وُهَيْبٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَخِيهِ عُثْمَانَ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ عُرْوَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  طَيَّبْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ إِحْرَامِهِ بِأَطْيَبَ مَا أَجِدُ  .","","Sharh Ma'ani al-Athar 3596","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عثمان بن عروة بن الزبير بن العوام عن هشام بن عروة بن الزبير عن وهيب بن خالد الكرابيسي عن الخصيب بن ناصح الحارثي عن نصر بن مرزوق المصري عن الطحاوي","باب التطيب عند الإحرام"
"3372","3597  -  حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  شُجَاعُ بْنُ الْوَلِيدِ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ، قَالَ :  حَدَّثَنِي  الْقَاسِمُ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  طَيَّبْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِيَدَيَّ لِإِحْرَامِهِ قَبْلَ أَنْ يُحْرِمَ  .","","Sharh Ma'ani al-Athar 3597","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبيد الله بن عمر العمري عن شجاع بن الوليد السكوني عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب التطيب عند الإحرام"
"3373","3598  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  أُسَامَةُ بْنُ زَيْدٍ ، أَنَّ الْقَاسِمَ  حَدَّثَهُ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  طَيَّبْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِحُرْمِهِ  حِينَ أَحْرَمَ  .  3599  - قَالَ  أُسَامَةُ بْنُ زَيْدٍ  :  وَحَدَّثَنِي  أَبُو بَكْرِ بْنُ حَزْمٍ ،  عَنْ  عَمْرَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِذَلِكَ .","","Sharh Ma'ani al-Athar 3598","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن أسامة بن زيد الليثي المدني عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب التطيب عند الإحرام"
"3374","3600  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3600","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب التطيب عند الإحرام"
"3375","3601  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  بِشْرُ بْنُ عُمَرَ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3601","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن شعبة بن الحجاج عن بشر بن عمر الزهراني عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب التطيب عند الإحرام"
"3376","3602  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَامِرٍ ، قَالَ :  ثَنَا  أَفْلَحُ - هُوَ ابْنُ حُمَيْدٍ -  عَنِ  الْقَاسِمِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3602","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن أفلح ابن صفيراء عن أبو عامر العقدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب التطيب عند الإحرام"
"3377","3603  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3603","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن سفيان الثوري عن الفضل بن دكين عن فهد بن سليمان الدلال عن الطحاوي","باب التطيب عند الإحرام"
"3378","3604  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  مُسَدَّدٌ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  طَيَّبْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِحُرْمِهِ  وَلِحِلِّهِ  .","","Sharh Ma'ani al-Athar 3604","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن أيوب السختياني عن حماد بن زيد عن مسدد بن مسرهد عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب التطيب عند الإحرام"
"3379","3605  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عُثْمَانَ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  قَالَ :  سَأَلْتُ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا :  بِأَيِّ شَيْءٍ طَيَّبْتِ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَتْ : بِأَطْيَبِ الطِّيبِ عِنْدَ إِحْلَالِهِ وَقَبْلَ أَنْ يُحْرِمَ  .","","Sharh Ma'ani al-Athar 3605","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عثمان بن عروة بن الزبير بن العوام عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن فهد بن سليمان الدلال عن الطحاوي","باب التطيب عند الإحرام"
"3380","3606  -  حَدَّثَنَا  نَصْرٌ ، قَالَ :  ثَنَا  الْخَصِيبُ ، قَالَ :  ثَنَا  وُهَيْبٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  طَيَّبْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِحُرْمِهِ  وَلِحِلِّهِ  .","","Sharh Ma'ani al-Athar 3606","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن ابن جريج عن وهيب بن خالد الكرابيسي عن الخصيب بن ناصح الحارثي عن نصر بن مرزوق المصري عن الطحاوي","باب التطيب عند الإحرام"
"3381","[2/131]      3607  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ قَالَ :  قَالَتْ  عَائِشَةُ رَضِيَ اللهُ عَنْهَا :  طَيَّبْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلْحِلِّ وَالْإِحْرَامِ  .  قَالَ أَبُو جَعْفَرٍ :  فَقَدْ  تَوَاتَرَتْ  هَذِهِ  الْآثَارُ  عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِإِبَاحَتِهِ الطِّيبَ عِنْدَ الْإِحْرَامِ ، وَأَنَّهُ قَدْ كَانَ يَبْقَى فِي مَفَارِقِهِ بَعْدَ الْإِحْرَامِ .  وَقَدْ رُوِيَ ذَلِكَ أَيْضًا عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا فِيمَا تَقَدَّمَ مِمَّا رَوَيْنَا فِي هَذَا الْبَابِ .  وَقَدْ رُوِيَ فِي ذَلِكَ أَيْضًا عَنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Sharh Ma'ani al-Athar 3607","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن ابن جريج عن أبو عاصم النبيل عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب التطيب عند الإحرام"
"3382","3608  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ تَمَّامٍ أَبُو الْكُرْدُوسِ ، قَالَ :  ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ بُكَيْرٍ ، قَالَ :  حَدَّثَنِي  مَيْمُونُ بْنُ يَحْيَى بْنِ مُسْلِمِ بْنِ الْأَشَجِّ ،  عَنْ  مَخْرَمَةَ بْنِ بُكَيْرٍ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  أُسَامَةَ بْنَ زَيْدٍ يَقُولُ :  سَمِعْتُ  عَائِشَةَ بِنْتَ سَعْدٍ تَقُولُ : (  كُنْتُ أُشْبِعُ رَأْسَ سَعْدِ بْنِ أَبِي وَقَّاصٍ لِحَرَمِهِ بِالطِّيبِ  ) .","","Sharh Ma'ani al-Athar 3608","","سعد بن أبي وقاص عن عائشة بنت سعد بن أبي وقاص عن أسامة بن زيد عن بكير بن عبد الله بن الأشج القرشي عن مخرمة بن بكير المخزومي عن ميمون بن يحيى بن مسلم المدني عن يحيى بن عبد الله بن بكير المخزومي عن محمد بن عمرو بن تمام التدمري عن الطحاوي","باب التطيب عند الإحرام"
"3383","3609  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  حَبَّانُ بْنُ هِلَالٍ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ، قَالَ :  ثَنَا  زَيْدُ بْنُ أَسْلَمَ قَالَ :  حَدَّثَتْنِي  ذَرَّةُ ، قَالَتْ : (  كُنْتُ  أُغَلِّفُ  رَأْسَ عَائِشَةَ رَضِيَ اللهُ عَنْهَا بِالْمِسْكِ وَالْعَنْبَرِ عِنْدَ إِحْرَامِهَا  ) .","","Sharh Ma'ani al-Athar 3609","","عائشة بنت أبي بكر الصديق عن ذرة بنت معاذ عن زيد بن أسلم عن حماد بن زيد عن حبان بن هلال الباهلي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب التطيب عند الإحرام"
"3384","3610  -  حَدَّثَنَا  أَبُو بِشْرٍ الرَّقِّيُّ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ . (  ح  ) .  3611  -  وَحَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ قَالَ :  أَخْبَرَتْنِي  حُكَيْمَةُ - قَالَ  أَبُو عَاصِمٍ  :  ابْنَةُ أَبِي حَكِيمٍ  -  عَنْ  أُمِّهَا ابْنَةِ النَّجَّارِ ،  أَنَّ  أَزْوَاجَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كُنَّ يَجْعَلْنَ  عَصَائِبَ  فِيهِنَّ الْوَرْسُ وَالزَّعْفَرَانُ  ، فَيَعْصِبْنَ بِهَا أَسَافِلَ شُعُورِهِنَّ عَلَى جِبَاهِهِنَّ قَبْلَ أَنْ يُحْرِمْنَ ، ثُمَّ يُحْرِمْنَ  ،  كَذَلِكَ يَزِيدُ أَحَدُهُمَا عَلَى صَاحِبِهِ فِي قِصَّةِ الْحَدِيثِ  .","","Sharh Ma'ani al-Athar 3610","","أحد الصحابة عن أميمة بنت رقيقة التميمية عن حكيمة بنت أميمة عن ابن جريج عن أبو عاصم النبيل عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب التطيب عند الإحرام"
"3385","3612  -  حَدَّثَنَا  نَصْرُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  الْخَصِيبُ بْنُ نَاصِحٍ ، قَالَ :  ثَنَا  وُهَيْبٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ، أَنَّهُ  كَانَ يَتَطَيَّبُ  بِالْغَالِيَةِ  الْجَيِّدَةِ عِنْدَ الْإِحْرَامِ  .  فَهَذَا قَدْ جَاءَ فِي ذَلِكَ عَمَّنْ ذَكَرْنَاهُ فِي هَذِهِ  الْآثَارِ  مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا يُوَافِقُ مَا قَدْ رَوَتْهُ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ تَطْيِيبِهِ عِنْدَ الْإِحْرَامِ . وَبِهَذَا كَانَ يَقُولُ  أَبُو حَنِيفَةَ  وَأَبُو يُوسُفَ  رَحِمَهُمَا اللهُ .  وَأَمَّا  مُحَمَّدُ بْنُ الْحَسَنِ  رَحِمَهُ اللهُ ، فَإِنَّهُ كَانَ يَذْهَبُ فِي ذَلِكَ إِلَى مَا رُوِيَ عَنْ  عُمَرَ  وَعُثْمَانَ بْنِ عَفَّانَ  وَعُثْمَانَ بْنِ الْعَاصِ  وَابْنِ عُمَرَ  مِنْ كَرَاهَتِهِ .         [2/132]      وَكَانَ مِنَ الْحُجَّةِ لَهُ فِي ذَلِكَ أَنَّ مَا ذُكِرَ فِي حَدِيثِ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا مِنْ تَطْيِيبِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ الْإِحْرَامِ إِنَّمَا فِيهِ أَنَّهَا كَانَتْ تُطَيِّبُهُ إِذَا أَرَادَ أَنْ يُحْرِمَ .  فَقَدْ يَجُوزُ أَنْ يَكُونَ كَانَتْ تَفْعَلُ بِهِ هَذَا ، ثُمَّ يَغْتَسِلُ إِذَا أَرَادَ الْإِحْرَامَ ، فَيَذْهَبُ بِغَسْلِهِ عَنْهُ مَا كَانَ عَلَى بَدَنِهِ مِنْ طِيبٍ ، وَيَبْقَى فِيهِ رِيحُهُ .  فَإِنْ قَالَ قَائِلٌ : فَقَدْ قَالَتْ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا فِي حَدِيثٍ : كُنْتُ أَرَى  وَبِيصَ  الطِّيبِ فِي مَفَارِقِهِ بَعْدَ مَا أَحْرَمَ .  قِيلَ لَهُ : قَدْ يَجُوزُ أَنْ يَكُونَ ذَلِكَ وَقَدْ غَسَلَهُ كَمَا ذَكَرْنَا ، وَهَكَذَا الطِّيبُ رُبَّمَا غَسَلَهُ الرَّجُلُ عَنْ وَجْهِهِ أَوْ عَنْ يَدِهِ ، فَيَذْهَبُ وَيَبْقَى  وَبِيصُهُ  .  فَلَمَّا احْتَمَلَ مَا رُوِيَ عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا مِنْ ذَلِكَ مَا ذَكَرْنَا نَظَرْنَا ، هَلْ فِيمَا رُوِيَ عَنْهَا شَيْءٌ يَدُلُّ عَلَى ذَلِكَ . ؟  كذا في طبعة عالم الكتب ، والذي في النسخ الخطية : ( عثمان بن أبي العاص ) .","","Sharh Ma'ani al-Athar 3612","","عبد الله بن الزبير عن عروة بن الزبير عن هشام بن عروة بن الزبير عن وهيب بن خالد الكرابيسي عن الخصيب بن ناصح الحارثي عن نصر بن مرزوق المصري عن الطحاوي","باب التطيب عند الإحرام"
"3386","3613  -  فَإِذَا فَهْدٌ قَدْ -  حَدَّثَنَا  ، قَالَ :  ثَنَا  أَبُو غَسَّانَ ، قَالَ :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ،  عَنْ  أَبِيهِ  قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا عَنِ الطِّيبِ عِنْدَ الْإِحْرَامِ ، فَقَالَ : مَا أُحِبُّ أَنْ أُصْبِحَ مُحْرِمًا  يَنْضَحُ  مِنِّي رِيحُ الطِّيبِ .  فَأَرْسَلَ  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا بَعْضَ بَنِيهِ إِلَى  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا لِيُسْمِعَ أَبَاهُ مَا قَالَتْ . قَالَ :  فَقَالَتْ  عَائِشَةُ رَضِيَ اللهُ عَنْهَا :  أَنَا طَيَّبْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ طَافَ فِي نِسَائِهِ فَأَصْبَحَ مُحْرِمًا  ، فَسَكَتَ  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا  .  قَالَ أَبُو جَعْفَرٍ :  فَدَلَّ هَذَا الْحَدِيثُ عَلَى أَنَّهُ قَدْ كَانَ بَيْنَ إِحْرَامِهِ وَبَيْنَ تَطْيِيبِهَا إِيَّاهُ غُسْلٌ ؛ لِأَنَّهُ لَا يَطُوفُ عَلَيْهِنَّ إِلَّا اغْتَسَلَ .  فَكَأَنَّهَا إِنَّمَا أَرَادَتْ بِهَذِهِ الْأَحَادِيثِ الِاحْتِجَاجَ عَلَى مَنْ كَرِهَ أَنْ يُوجَدَ مِنَ الْمُحْرِمِ بَعْدَ إِحْرَامِهِ رِيحُ الطِّيبِ كَمَا كَرِهَ ذَلِكَ  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا .  فَأَمَّا بَقَاءُ نَفْسِ الطِّيبِ عَلَى بَدَنِ الْمُحْرِمِ بَعْدَ مَا أَحْرَمَ وَإِنْ كَانَ إِنَّمَا تَطَيَّبَ بِهِ قَبْلَ الْإِحْرَامِ ، فَلَا نَتَفَهَّمُ هَذَا الْحَدِيثَ ، فَإِنَّ مَعْنَاهُ مَعْنًى لَطِيفٌ .  فَقَدْ بَيَّنَّا وُجُوهَ هَذِهِ  الْآثَارِ  فَاحْتَجْنَا بَعْدَ ذَلِكَ أَنْ نَعْلَمَ كَيْفَ وَجْهُ مَا نَحْنُ فِيهِ مِنَ الِاخْتِلَافِ مِنْ طَرِيقِ النَّظَرِ .  فَاعْتَبَرْنَا ذَلِكَ ، فَرَأَيْنَا الْإِحْرَامَ يَمْنَعُ مِنْ لُبْسِ الْقَمِيصِ وَالسَّرَاوِيلَاتِ وَالْخِفَافِ وَالْعَمَائِمِ ، وَيَمْنَعُ مِنَ الطِّيبِ ، وَقَتْلِ الصَّيْدِ وَإِمْسَاكِهِ .         [2/133]      ثُمَّ رَأَيْنَا الرَّجُلَ إِذَا لَبِسَ قَمِيصًا أَوْ سَرَاوِيلًا قَبْلَ أَنْ يُحْرِمَ ، ثُمَّ أَحْرَمَ وَهُوَ عَلَيْهِ أَنَّهُ يُؤْمَرُ بِنَزْعِهِ ، وَإِنْ لَمْ يَنْزِعْهُ وَتَرَكَهُ عَلَيْهِ كَانَ كَمَنْ لَبِسَهُ بَعْدَ الْإِحْرَامِ لُبْسًا مُسْتَقْبَلًا ، فَيَجِبُ عَلَيْهِ فِي ذَلِكَ مَا يَجِبُ عَلَيْهِ فِيهِ لَوِ اسْتَأْنَفَ لُبْسَهُ بَعْدَ إِحْرَامِهِ .  وَكَذَلِكَ لَوْ صَادَ صَيْدًا فِي الْحِلِّ وَهُوَ حَلَالٌ فَأَمْسَكَهُ فِي يَدِهِ ، ثُمَّ أَحْرَمَ وَهُوَ فِي يَدِهِ أُمِرَ بِتَخْلِيَتِهِ وَإِنْ لَمْ يُخَلِّهِ ، كَانَ إِمْسَاكُهُ إِيَّاهُ بَعْدَ إِحْرَامِهِ بِصَيْدٍ كَانَ مِنْهُ بَعْدَ إِحْرَامِهِ الْمُتَقَدِّمِ ، كَإِمْسَاكِهِ إِيَّاهُ بَعْدَ إِحْرَامِهِ بِصَيْدٍ كَانَ مِنْهُ بَعْدَ إِحْرَامِهِ .  فَلَمَّا كَانَ مَا ذَكَرْنَا كَذَلِكَ وَكَانَ الطِّيبُ مُحَرَّمًا عَلَى الْمُحْرِمِ بَعْدَ إِحْرَامِهِ  كَحُرْمَةِ  هَذِهِ الْأَشْيَاءِ كَانَ ثُبُوتُ الطِّيبِ عَلَيْهِ بَعْدَ إِحْرَامِهِ ، وَإِنْ كَانَ قَدْ تَطَيَّبَ بِهِ قَبْلَ إِحْرَامِهِ كَتَطْيِيبِهِ بِهِ بَعْدَ إِحْرَامِهِ ، قِيَاسًا وَنَظَرًا عَلَى مَا بَيَّنَّا .  فَهَذَا هُوَ النَّظَرُ فِي هَذَا الْبَابِ ، وَبِهِ نَأْخُذُ ، وَهُوَ قَوْلُ  مُحَمَّدِ بْنِ الْحَسَنِ  رَحِمَهُ اللهُ  .","","Sharh Ma'ani al-Athar 3613","","عائشة بنت أبي بكر الصديق عن محمد بن المنتشر بن الأجدع الوادعي عن إبراهيم بن محمد بن المنتشر الهمداني عن الوضاح بن عبد الله اليشكري عن مالك بن إسماعيل النهدي عن فهد بن سليمان الدلال عن الطحاوي","باب التطيب عند الإحرام"
"3387","6 - بَابُ مَا يَلْبَسُ الْمُحْرِمُ مِنَ الثِّيَابِ  3614  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو الْوَلِيدِ وَسُلَيْمَانُ بْنُ حَرْبٍ . (  ح  ) .  3615  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ زَيْدٍ يَقُولُ :  سَمِعْتُ  ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا يَقُولُ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِعَرَفَةَ  يَقُولُ :  مَنْ لَمْ يَجِدْ إِزَارًا لَبِسَ سَرَاوِيلًا ، وَمَنْ لَمْ يَجِدْ نَعْلَيْنِ لَبِسَ خُفَّيْنِ  .","","Sharh Ma'ani al-Athar 3614","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3388","3616  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ . وَلَمْ يَذْكُرْ (  عَرَفَةَ  ) .","","Sharh Ma'ani al-Athar 3616","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان الثوري عن الفضل بن دكين عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3389","3617  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، قَالَ :  أَنَا  هُشَيْمٌ ، قَالَ :  أَنَا  عَمْرُو بْنُ دِينَارٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3617","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن هشيم بن بشير عن سعيد بن منصور عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3390","3618  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  سَعِيدٌ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ وَسُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَخْطُبُ  ، فَذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3618","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن حماد بن زيد عن سعيد بن منصور عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3391","3619  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، فَذَكَرَ مِثْلَهُ . غَيْرَ أَنَّهُ لَمْ يَقُلْ : ( وَهُوَ يَخْطُبُ ) .","","Sharh Ma'ani al-Athar 3619","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن بكار بن قتيبة البكراوي عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3392","3620  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي الشَّعْثَاءِ ، قَالَ :  أَنَا  ابْنُ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ ، فَذَكَرَ نَحْوَهُ .  قُلْتُ : ( وَلَمْ يَقُلْ : يُقَطِّعُهُمَا ؟ ) . قَالَ : ( لَا ) .","","Sharh Ma'ani al-Athar 3620","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن عمرو بن دينار الأثرم عن ابن جريج عن أبو عاصم النبيل عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3393","[2/134]      3621  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ الْحَكَمِ الْحِبْرِيُّ الْكُوفِيُّ ، قَالَ :  ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ، قَالَ :  ثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَمْ يَجِدِ النَّعْلَيْنِ فَلْيَلْبَسِ الْخُفَّيْنِ ، وَمَنْ لَمْ يَجِدْ إِزَارًا فَلْيَلْبَسْ سَرَاوِيلًا  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ إِلَى هَذِهِ  الْآثَارِ  قَوْمٌ فَقَالُوا : مَنْ لَمْ يَجِدْ إِزَارًا وَهُوَ مُحْرِمٌ لَبِسَ سَرَاوِيلًا ، وَلَا شَيْءَ عَلَيْهِ ، وَمَنْ لَمْ يَجِدْ نَعْلَيْنِ لَبِسَ خُفَّيْنِ ، وَلَا شَيْءَ عَلَيْهِ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : أَمَّا مَا ذَكَرْتُمُوهُ مِنْ لُبْسِ الْمُحْرِمِ الْخُفَّ وَالسَّرَاوِيلَ عَلَى الضَّرُورَةِ ، فَنَحْنُ نَقُولُ بِذَلِكَ ، وَنُبِيحُ لَهُ لُبْسَهُ لِلضَّرُورَةِ الَّتِي هِيَ بِهِ .  وَلَكِنَّا نُوجِبُ عَلَيْهِ - مَعَ ذَلِكَ - الْكَفَّارَةَ ، وَلَيْسَ فِيمَا رَوَيْتُمُوهُ نَفْيٌ لِوُجُوبِ الْكَفَّارَةِ ، وَلَا فِيهِ وَلَا فِي قَوْلِنَا خِلَافٌ لِشَيْءٍ مِنْ ذَلِكَ .  لِأَنَّا لَمْ نَقُلْ : لَا يَلْبَسُ الْخُفَّيْنِ إِذَا لَمْ يَجِدْ نَعْلَيْنِ ، وَلَا السَّرَاوِيلَ إِذَا لَمْ يَجِدْ إِزَارًا .  وَلَوْ قُلْنَا ذَلِكَ كُنَّا مُخَالِفِينَ لِهَذَا الْحَدِيثِ ، وَلَكِنَّا قَدْ أَبَحْنَا لَهُ اللِّبَاسَ كَمَا أَبَاحَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ أَوْجَبْنَا عَلَيْهِ مَعَ ذَلِكَ الْكَفَّارَةَ بِالدَّلَائِلِ الْقَائِمَةِ الْمُوجِبَةِ لِذَلِكَ .  وَقَدْ يُحْتَمَلُ أَيْضًا قَوْلُهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَنْ لَمْ يَجِدْ نَعْلَيْنِ فَلْيَلْبَسْ خُفَّيْنِ عَلَى أَنْ يَقْطَعَهُمَا مِنْ تَحْتِ  الْكَعْبَيْنِ  ، فَيَلْبَسَهُمَا كَمَا يَلْبَسُ النَّعْلَيْنِ .  وَقَوْلُهُ : مَنْ لَمْ يَجِدْ إِزَارًا فَيَلْبَسُ سَرَاوِيلًا ، عَلَى أَنْ يَشُقَّ السَّرَاوِيلَ ، فَيَلْبَسَهُ كَمَا يَلْبَسُ الْإِزَارَ .  فَإِنْ كَانَ هَذَا الْحَدِيثُ أُرِيدَ بِهِ هَذَا الْمَعْنَى فَلَسْنَا نُخَالِفُ شَيْئًا مِنْ ذَلِكَ ، وَنَحْنُ نَقُولُ بِذَلِكَ وَنُثْبِتُهُ .  وَإِنَّمَا وَقَعَ الْخِلَافُ بَيْنَنَا وَبَيْنَكُمْ فِي التَّأْوِيلِ لَا فِي نَفْسِ الْحَدِيثِ ؛ لِأَنَّا قَدْ صَرَفْنَا الْحَدِيثَ إِلَى وَجْهٍ يَحْتَمِلُهُ ، فَاعْرِفُوا مَوْضِعَ خِلَافِ التَّأْوِيلِ مِنْ مَوْضِعِ خِلَافِ الْحَدِيثِ ؛ فَإِنَّهُمَا مُخْتَلِفَانِ ، وَلَا تُوجِبُوا عَلَى مَنْ خَالَفَ تَأْوِيلَكُمْ خِلَافًا لِذَلِكَ الْحَدِيثِ .  وَقَدْ بَيَّنَ  عَبْدُ اللهِ بْنُ عُمَرَ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْضَ ذَلِكَ  .","","Sharh Ma'ani al-Athar 3621","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زهير بن معاوية بن حديج عن مالك بن إسماعيل النهدي عن الحسين بن الحكم الوشاء عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3394","3622  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ هَارُونَ قَالَ : قَالَ  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عُمَرَ بْنِ نَافِعٍ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا نَلْبَسُ مِنَ الثِّيَابِ إِذَا أَحْرَمْنَا ؟ فَقَالَ :  لَا تَلْبَسُوا السَّرَاوِيلَاتِ وَلَا الْعَمَائِمَ وَلَا الْبَرَانِسَ وَلَا الْخِفَافَ  ، إِلَّا أَنْ يَكُونَ أَحَدٌ لَيْسَتْ لَهُ نَعْلَانِ فَلْيَلْبَسْ خُفَّيْنِ أَسْفَلَ مِنَ  الْكَعْبَيْنِ  .","","Sharh Ma'ani al-Athar 3622","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عمر بن نافع مولى ابن عمر عن يحيى بن سعيد الأنصاري عن يزيد بن هارون عن يزيد بن سنان القزاز عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3395","[2/135]      3623  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ يُونُسَ ، قَالَ :  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3623","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن سعيد بن أبي عروبة عن أسباط بن محمد بن ميسرة القرشي عن محمد بن عمرو السوسي عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3396","3624  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَيُّوبَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3624","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3397","3625  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3625","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3398","3626  -  حَدَّثَنَا  عِيسَى بْنُ إِبْرَاهِيمَ الْغَافِقِيُّ ، قَالَ :  ثَنَا  سُفْيَانُ - هُوَ ابْنُ عُيَيْنَةَ -  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3626","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن عيسى بن إبراهيم المثرودي عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3399","3627  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  خَالِدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3627","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن خالد بن عبد الرحمن الخراساني عن الربيع بن سليمان المرادي عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3400","3628  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ . (  ح  ) .  3629  -  وَحَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  قَالَا جَمِيعًا :  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3628","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3401","3630  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ دِينَارٍ ،  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا يَقُولُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  مَنْ لَمْ يَجِدْ نَعْلَيْنِ فَلْيَلْبَسْ خُفَّيْنِ وَلْيَشُقَّهُمَا مِنْ عِنْدِ  الْكَعْبَيْنِ  .  فَهَذَا  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا يُخْبِرُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِلُبْسِ الْخُفَّيْنِ الَّذِي أَبَاحَهُ لِلْمُحْرِمِ ، كَيْفَ هُوَ وَأَنَّهُ بِخِلَافِ مَا يَلْبَسُ الْحَلَالُ .  وَلَمْ يُبَيِّنِ  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا فِي حَدِيثِهِ مِنْ ذَلِكَ شَيْئًا ، فَحَدِيثُ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا أَوْلَاهُمَا .  وَإِذَا كَانَ مَا أَبَاحَ لِلْمُحْرِمِ مِنْ لُبْسِ الْخُفَّيْنِ هُوَ بِخِلَافِ مَا يَلْبَسُ الْحَلَالُ ، فَكَذَلِكَ مَا أَبَاحَ لَهُ مِنْ لُبْسِ السَّرَاوِيلِ هُوَ بِخِلَافِ مَا يَلْبَسُ الْحَلَالُ .  فَهَذَا حُكْمُ هَذَا الْبَابِ مِنْ طَرِيقِ تَصْحِيحِ مَعَانِي  الْآثَارِ  .  وَأَمَّا النَّظَرُ عَلَى ذَلِكَ ، فَإِنَّا رَأَيْنَاهُمْ لَمْ يَخْتَلِفُوا فِيمَنْ وَجَدَ إِزَارًا ، أَنَّ لُبْسَ السَّرَاوِيلِ لَهُ غَيْرُ مُبَاحٍ ؛ لِأَنَّ الْإِحْرَامَ قَدْ مَنَعَهُ مِنْ ذَلِكَ .  وَكَذَلِكَ مَنْ وَجَدَ نَعْلَيْنِ فَحَرَامٌ عَلَيْهِ لُبْسُ الْخُفَّيْنِ مِنْ غَيْرِ ضَرُورَةٍ ، فَأَرَدْنَا أَنْ نَنْظُرَ فِي لُبْسِ ذَلِكَ مِنْ طَرِيقِ الضَّرُورَةِ كَيْفَ هُوَ ؟ وَهَلْ يُوجِبُ كَفَّارَةً أَوْ لَا يُوجِبُهَا ؟ فَاعْتَبَرْنَا ذَلِكَ فَرَأَيْنَا الْإِحْرَامَ يَنْهَى عَنْ أَشْيَاءَ قَدْ كَانَتْ مُبَاحَةً قَبْلَهُ ، مِنْهَا : لُبْسُ الْقَمِيصِ وَالْعَمَائِمِ وَالْخِفَافِ وَالسَّرَاوِيلَاتِ وَالْبَرَانِسِ .         [2/136]      وَكَانَ مَنِ اضْطُرَّ فَوَجَدَ الْحَرَّ فَغَطَّى رَأْسَهُ ، وَوَجَدَ الْبَرْدَ فَلَبِسَ ثِيَابَهُ أَنَّهُ قَدْ فَعَلَ مَا هُوَ مُبَاحٌ لَهُ فِعْلُهُ ، وَعَلَيْهِ الْكَفَّارَةُ مَعَ ذَلِكَ ، وَحَرَّمَ عَلَيْهِ الْإِحْرَامُ أَيْضًا حَلْقَ الرَّأْسِ إِلَّا مِنْ ضَرُورَةٍ .  وَكَانَ مَنْ حَلَقَ رَأْسَهُ مِنْ ضَرُورَةٍ فَقَدْ فَعَلَ مَا هُوَ لَهُ مُبَاحٌ ، وَالْكَفَّارَةُ عَلَيْهِ وَاجِبَةٌ .  فَكَانَ حَلْقُ الرَّأْسِ لِلْمُحْرِمِ - فِي غَيْرِ حَالِ الضَّرُورَةِ - إِذَا أُبِيحَ فِي حَالِ الضَّرُورَةِ ، لَمْ يَكُنْ إِبَاحَتُهُ تُسْقِطُ الْكَفَّارَةَ ، بَلِ الْكَفَّارَةُ فِي ذَلِكَ كُلِّهِ وَاجِبَةٌ فِي حَالِ الضَّرُورَةِ كَهِيَ فِي غَيْرِ حَالِ الضَّرُورَةِ .  وَكَذَلِكَ لُبْسُ الْقَمِيصِ الَّذِي حَرُمَ عَلَيْهِ فِي غَيْرِ حَالِ الضَّرُورَةِ .  فَإِذَا كَانَتِ الضَّرُورَةُ فَأُبِيحَ ذَلِكَ لَهُ لَمْ يَسْقُطْ بِذَلِكَ الضَّمَانُ ، فَكَانَتِ الْكَفَّارَةُ عَلَيْهِ وَاجِبَةً فِي ذَلِكَ كُلِّهِ ، فَلَمْ يَكُنِ الضَّرُورَةُ فِي شَيْءٍ مِمَّا ذَكَرْنَا تُسْقِطُ كَفَّارَةً كَانَتْ تَجِبُ فِي شَيْءٍ فِي غَيْرِ حَالِ الضَّرُورَةِ ، وَإِنَّمَا تُسْقِطُ الْآثَامَ خَاصَّةً .  فَكَذَلِكَ الضَّرُورَاتُ فِي لُبْسِ الْخِفَافِ وَالسَّرَاوِيلَاتِ لَا تُوجِبُ سُقُوطَ الْكَفَّارَاتِ الَّتِي كَانَتْ تَجِبُ لَوْ لَمْ تَكُنْ تِلْكَ الضَّرُورَاتُ ، وَلَكِنَّهَا تَرْفَعُ الْآثَامَ خَاصَّةً .  فَهَذَا هُوَ النَّظَرُ فِي هَذَا الْبَابِ أَيْضًا ، وَهُوَ قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  ،  وَمُحَمَّدٍ  ، رَحِمَهُمُ اللهُ تَعَالَى  .","","Sharh Ma'ani al-Athar 3630","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن شعبة بن الحجاج عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما يلبس المحرم من الثياب"
"3402","7 - بَابُ لُبْسِ الثَّوْبِ الَّذِي قَدْ مَسَّهُ وَرْسٌ أَوْ زَعْفَرَانٌ فِي الْإِحْرَامِ  3631  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ وَأَبُو صَالِحٍ كَاتِبُ اللَّيْثِ ، قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَلْبَسُوا ثَوْبًا مَسَّهُ وَرْسٌ أَوْ زَعْفَرَانٌ  .  يَعْنِي فِي الْإِحْرَامِ  .","","Sharh Ma'ani al-Athar 3631","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن سعد أبو إسحاق الزهري عن عبد الله بن صالح المصري عن يزيد بن سنان القزاز عن الطحاوي","باب لبس الثوب الذي قد مسه ورس أو زعفران في الإحرام"
"3403","3632  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3632","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن سفيان الثوري عن الفضل بن دكين عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب لبس الثوب الذي قد مسه ورس أو زعفران في الإحرام"
"3404","3633  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَحْوَهُ .","","Sharh Ma'ani al-Athar 3633","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب لبس الثوب الذي قد مسه ورس أو زعفران في الإحرام"
"3405","3634  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .         [2/137]      قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى هَذِهِ الْآثَارِ ، فَقَالُوا : كُلُّ ثَوْبٍ مَسَّهُ وَرْسٌ أَوْ زَعْفَرَانٌ ، فَلَا يَحِلُّ لُبْسُهُ فِي الْإِحْرَامِ وَإِنْ غُسِلَ ؛ لِأَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يُبَيِّنْ فِي هَذِهِ الْآثَارِ مَا غُسِلَ مِنْ ذَلِكَ مِمَّا لَمْ يُغْسَلْ فَنَهْيُهُ عَلَى ذَلِكَ كُلِّهِ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ فَقَالُوا : مَا غُسِلَ مِنْ ذَلِكَ حَتَّى صَارَ لَا يَنْفَضُّ ، فَلَا بَأْسَ بِلُبْسِهِ فِي الْإِحْرَامِ ؛ لِأَنَّ الثَّوْبَ الَّذِي صُبِغَ إِنَّمَا نُهِيَ عَنْ لُبْسِهِ فِي الْإِحْرَامِ ، لَمَّا كَانَ قَدْ دَخَلَهُ مِمَّا هُوَ حَرَامٌ عَلَى الْمُحْرِمِ ، فَإِذَا غُسِلَ فَخَرَجَ ذَلِكَ مِنْهُ ذَهَبَ الْمَعْنَى الَّذِي كَانَ لَهُ النَّهْيُ ، وَعَادَ الثَّوْبُ إِلَى أَصْلِهِ الْأَوَّلِ قَبْلَ أَنْ يُصِيبَهُ ذَلِكَ الَّذِي غُسِلَ مِنْهُ .  وَقَالُوا : هَذَا كَالثَّوْبِ الطَّاهِرِ يُصِيبُهُ النَّجَاسَةُ ، فَيَنْجُسُ بِذَلِكَ ، فَلَا تَجُوزُ الصَّلَاةُ فِيهِ ، فَإِذَا غُسِلَ حَتَّى يَخْرُجَ مِنْهُ النَّجَاسَةُ طَهُرَ ، وَحَلَّتِ الصَّلَاةُ فِيهِ .  وَقَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ أَنَّهُ اسْتَثْنَى مِمَّا حَرَّمَهُ عَلَى الْمُحْرِمِ مِنْ ذَلِكَ ، فَقَالَ : إِلَّا أَنْ يَكُونَ غَسِيلًا .","","Sharh Ma'ani al-Athar 3634","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب لبس الثوب الذي قد مسه ورس أو زعفران في الإحرام"
"3406","3635  -  حَدَّثَنَا  بِذَلِكَ فَهْدٌ ، قَالَ :  ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ ، قَالَ :  ثَنَا  أَبُو مُعَاوِيَةَ . (  ح  ) .  3636  -  وَحَدَّثَنَا  ابْنُ أَبِي عِمْرَانَ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ الْأَزْدِيُّ ، قَالَ :  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِ الْحَدِيثِ الَّذِي ذَكَرْنَاهُ فِي أَوَّلِ هَذَا الْبَابِ ، وَزَادَ :  إِلَّا أَنْ يَكُونَ غَسِيلًا  .  قَالَ  ابْنُ أَبِي عِمْرَانَ  : وَرَأَيْتُ  يَحْيَى بْنَ مَعِينٍ  ، وَهُوَ يَتَعَجَّبُ مِنَ  الْحِمَّانِيِّ  أَنْ يُحَدِّثَ بِهَذَا الْحَدِيثِ ، فَقَالَ : لَهُ  عَبْدُ الرَّحْمَنِ  : ( هَذَا عِنْدِي ) .  ثُمَّ وَثَبَ مِنْ فَوْرِهِ فَجَاءَ بِأَصْلِهِ ، فَأَخْرَجَ مِنْهُ هَذَا الْحَدِيثَ عَنْ  أَبِي مُعَاوِيَةَ  ، كَمَا ذَكَرَهُ  يَحْيَى الْحِمَّانِيُّ  ، فَكَتَبَهُ عَنْهُ  يَحْيَى بْنُ مَعِينٍ  .  فَقَدْ ثَبَتَ بِمَا ذَكَرْنَا اسْتِثْنَاءُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْغُسْلَ مِمَّا قَدْ مَسَّهُ وَرْسٌ أَوْ زَعْفَرَانٌ .  وَهَذَا قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  - رَحِمَهُمُ اللهُ تَعَالَى - وَقَدْ رُوِيَ ذَلِكَ عَنْ نَفَرٍ مِنَ الْمُتَقَدِّمِينَ .","","Sharh Ma'ani al-Athar 3635","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن أبو معاوية الضرير عن عبد الرحمن بن صالح العتكي عن أحمد بن أبي عمران البغدادي عن الطحاوي","باب لبس الثوب الذي قد مسه ورس أو زعفران في الإحرام"
"3407","3637  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، أَنَّهُ  أَتَاهُ رَجُلٌ ، فَقَالَ لَهُ : إِنِّي أُرِيدُ أَنْ أُحْرِمَ وَلَيْسَ لِي إِلَّا هَذَا الثَّوْبُ ، ثَوْبٌ مَصْبُوغٌ بِزَعْفَرَانٍ  .  قَالَ : آللهِ مَا تَجِدُ غَيْرَهُ ؟ فَحَلَفَ ، فَقَالَ : ( اغْسِلْهُ وَأَحْرِمْ فِيهِ )  .","","Sharh Ma'ani al-Athar 3637","","سعيد بن المسيب عن جعفر بن إياس اليشكري عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب لبس الثوب الذي قد مسه ورس أو زعفران في الإحرام"
"3408","3638  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَامِرٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ قَالَ :  إِذَا كَانَ فِي الثَّوْبِ زَعْفَرَانٌ أَوْ وَرْسٌ ، فَغُسِلَ فَلَا بَأْسَ أَنْ يُحْرِمَ فِيهِ  .","","Sharh Ma'ani al-Athar 3638","","طاوس بن كيسان عن ليث بن أبي سليم عن سفيان الثوري عن أبو عامر العقدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب لبس الثوب الذي قد مسه ورس أو زعفران في الإحرام"
"3409","3639  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عُمَرَ  ،  عَنْ  سُفْيَانَ ،  عَنِ  الْمُغِيرَةِ ،  عَنْ  إِبْرَاهِيمَ فِي الثَّوْبِ يَكُونُ فِيهِ وَرْسٌ أَوْ زَعْفَرَانٌ ، فَغُسِلَ : ( إِنَّهُ لَمْ يَرَ بَأْسًا أَنْ يُحْرِمَ فِيهِ )  .  كذا في طبعة عالم الكتب ، ولعل الصواب : (أبو عامر).","","Sharh Ma'ani al-Athar 3639","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن سفيان الثوري عن أبو عامر العقدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب لبس الثوب الذي قد مسه ورس أو زعفران في الإحرام"
"3410","[2/138]      8 - بَابٌ : الرَّجُلُ يُحْرِمُ وَعَلَيْهِ قَمِيصٌ ، كَيْفَ يَنْبَغِي لَهُ أَنْ يَخْلَعَهُ ؟  3640  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَطَاءِ بْنِ أَبِي لَبِيبَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ جَابِرٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  كُنْتُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَالِسًا فِي الْمَسْجِدِ فَقَدَّ قَمِيصَهُ مِنْ جَيْبِهِ حَتَّى أَخْرَجَهُ مِنْ رِجْلَيْهِ ، فَنَظَرَ  الْقَوْمُ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  إِنِّي أَمَرْتُ بِبُدْنِي الَّتِي بَعَثْتُ بِهَا أَنْ يُقَلَّدَ الْيَوْمَ ، وَيُشْعَرَ عَلَى كَذَا وَكَذَا  ، فَلَبِسْتُ قَمِيصِي وَنَسِيتُ ، فَلَمْ أَكُنْ لِأُخْرِجَ قَمِيصِي مِنْ رَأْسِي ، وَكَانَ بَعَثَ بِبُدْنِهِ وَأَقَامَ  بِالْمَدِينَةِ  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى هَذَا فَقَالُوا : لَا يَنْبَغِي لِلْمُحْرِمِ أَنْ يَخْلَعَهُ كَمَا يَخْلَعُ الْحَلَالُ قَمِيصَهُ ؛ لِأَنَّهُ إِذَا فَعَلَ ذَلِكَ غَطَّى رَأْسَهُ ، وَذَلِكَ عَلَيْهِ حَرَامٌ فَأَمَرَ بِشَقِّهِ لِذَلِكَ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ فَقَالُوا : بَلْ يَنْزِعُهُ نَزْعًا ، وَاحْتَجُّوا فِي ذَلِكَ بِحَدِيثِ  يَعْلَى بْنِ أُمَيَّةَ  الَّذِي أَحْرَمَ وَعَلَيْهِ جُبَّةٌ ، فَأَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَمَرَهُ أَنْ يَنْزِعَهَا نَزْعًا .  وَقَدْ ذَكَرْنَا ذَلِكَ فِي بَابِ التَّطْيِيبِ عِنْدَ الْإِحْرَامِ .  فَقَدْ خَالَفَ ذَلِكَ  حَدِيثُ  جَابِرٍ  الَّذِي ذَكَرْنَا  وَإِسْنَادُهُ أَحْسَنُ مِنْ إِسْنَادِهِ  .  فَإِنْ كَانَتْ هَذِهِ الْأَشْيَاءُ  تَثْبُتُ  بِصِحَّةِ الْإِسْنَادِ  ، فَإِنَّ حَدِيثَ  يَعْلَى  مَعَهُ مِنْ  صِحَّةِ الْإِسْنَادِ  مَا لَيْسَ مَعَ حَدِيثِ  جَابِرٍ  .  وَأَمَّا وَجْهُ ذَلِكَ مِنْ طَرِيقِ النَّظَرِ ، فَإِنَّا رَأَيْنَا الَّذِينَ كَرِهُوا نَزْعَ الْقَمِيصِ ، إِنَّمَا كَرِهُوا ذَلِكَ لِأَنَّهُ يُغَطِّي رَأْسَهُ إِذَا نَزَعَ قَمِيصَهُ .  فَأَرَدْنَا أَنْ نَنْظُرَ هَلْ يَكُونُ تَغْطِيَةُ الرَّأْسِ فِي الْإِحْرَامِ عَلَى كُلِّ الْجِهَاتِ مَنْهِيًّا عَنْهَا أَمْ لَا ؟  فَرَأَيْنَا الْمُحْرِمَ نُهِيَ عَنْ لُبْسِ الْقَلَانِسِ وَالْعَمَائِمِ وَالْبَرَانِسِ ، فَهِيَ أَنْ يُلْبِسَ رَأْسَهُ شَيْئًا ، كَمَا نُهِيَ أَنْ يُلْبِسَ بَدَنَهُ الْقَمِيصَ .  وَرَأَيْنَا الْمُحْرِمَ لَوْ حَمَلَ عَلَى رَأْسِهِ شَيْئًا ثِيَابًا أَوْ غَيْرَهَا ، لَمْ يَكُنْ بِذَلِكَ بَأْسًا ، وَلَمْ يَدْخُلْ ذَلِكَ فِيمَا قَدْ نُهِيَ  عَنْ تَغْطِيَةِ الرَّأْسِ بِالْقَلَانِسِ ، وَمَا أَشْبَهَهَا ؛ لِأَنَّهُ غَيْرُ لَابِسٍ . فَكَانَ النَّهْيُ إِنَّمَا وَقَعَ مِنْ ذَلِكَ عَلَى تَغْطِيَةِ مَا يُلْبِسُهُ الرَّأْسَ ، لَا عَلَى غَيْرِ ذَلِكَ مِمَّا يُغَطَّى بِهِ .  وَكَذَلِكَ الْأَبْدَانُ نُهِيَ عَنْ إِلْبَاسِهَا الْقَمِيصَ ، وَلَمْ يُنْهَ عَنْ تَجْلِيلِهَا بِالْأُزُرِ .         [2/139]      فَلَمَّا كَانَ مَا وَقَعَ عَلَيْهِ النَّهْيُ مِنْ هَذَا فِي الرَّأْسِ ، إِنَّمَا هُوَ الْإِلْبَاسُ لَا لِتَغْطِيَةِ الَّتِي لَيْسَتْ بِإِلْبَاسٍ ، وَكَانَ إِذَا نَزَعَ قَمِيصَهُ فَلَاقَى ذَلِكَ رَأْسَهُ ، فَلَيْسَ ذَلِكَ بِإِلْبَاسٍ مِنْهُ لِرَأْسِهِ شَيْئًا ، إِنَّمَا ذَلِكَ تَغْطِيَةٌ مِنْهُ لِرَأْسِهِ .  وَقَدْ ثَبَتَ بِمَا ذَكَرْنَا أَنَّ النَّهْيَ عَنْ لُبْسِ الْقَلَانِسِ لَمْ يَقَعْ عَلَى تَغْطِيَةِ الرَّأْسِ ، وَإِنَّمَا وَقَعَ عَلَى إِلْبَاسِ الرَّأْسِ فِي حَالِ الْإِحْرَامِ مَا يُلْبَسُ فِي حَالِ الْإِحْلَالِ .  ، فَلَمَّا خَرَجَ بِذَلِكَ مَا أَصَابَ الرَّأْسَ مِنَ الْقَمِيصِ الْمَنْزُوعِ مِنْ حَالِ تَغْطِيَةِ الرَّأْسِ الْمُنْهَى عَنْهَا ثَبَتَ أَنَّهُ لَا بَأْسَ بِذَلِكَ ، قِيَاسًا وَنَظَرًا عَلَى مَا ذَكَرْنَا .  وَهَذَا قَوْلُ  أَبِي حَنِيفَةَ  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى .  وَقَدِ اخْتَلَفَ الْمُتَقَدِّمُونَ فِي ذَلِكَ  .  في طبعة عالم الكتب : ( فهي ) والمثبت من النسخ الخطية.","","Sharh Ma'ani al-Athar 3640","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الملك بن جابر بن عتيك الأنصاري عن عبد الرحمن بن عطاء الذارع عن حاتم بن إسماعيل الحارثي عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب الرجل يحرم وعليه قميص كيف ينبغي له أن يخلعه"
"3411","3641  -  حَدَّثَنَا  صَالِحُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، قَالَ :  ثَنَا  هُشَيْمٌ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ .","","Sharh Ma'ani al-Athar 3641","","الحسن البصري عن يونس بن عبيد عن هشيم بن بشير عن سعيد بن منصور عن صالح بن عبد الرحمن المصري عن الطحاوي","باب الرجل يحرم وعليه قميص كيف ينبغي له أن يخلعه"
"3412","3642  -  وَأَخْبَرَنَا  مُغِيرَةُ  عَنْ  إِبْرَاهِيمَ وَالشَّعْبِيِّ أَنَّهُمْ قَالُوا :  إِذَا أَحْرَمَ الرَّجُلُ وَعَلَيْهِ قَمِيصٌ ، فَلْيَخْرِقْهُ عَلَيْهِ حَتَّى يَخْرُجَ مِنْهُ  .","","Sharh Ma'ani al-Athar 3642","","الشعبي عن المغيرة بن مقسم الضبي عن سعيد بن منصور عن صالح بن عبد الرحمن المصري عن الطحاوي","باب الرجل يحرم وعليه قميص كيف ينبغي له أن يخلعه"
"3413","3643  -  حَدَّثَنَا  رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ، قَالَ :  ثَنَا  شَرِيكٌ ،  عَنْ  سَالِمٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ رَضِيَ اللهُ عَنْهُ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3643","","سعيد بن جبير الأسدي عن سالم بن عجلان الأفطس عن شريك بن عبد الله النخعي عن يوسف بن عدي بن رزق الكوفي عن روح بن الفرج القطان عن الطحاوي","باب الرجل يحرم وعليه قميص كيف ينبغي له أن يخلعه"
"3414","3644  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنِ  الْمُغِيرَةِ ،  وَحَمَّادٌ  ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  إِذَا أَحْرَمَ الرَّجُلُ وَعَلَيْهِ قَمِيصٌ ، قَالَ أَحَدُهُمَا : يَشُقُّهُ ، وَقَالَ الْآخَرُ : يَخْلَعُهُ مِنْ قِبَلِ رِجْلَيْهِ  .","","Sharh Ma'ani al-Athar 3644","","إبراهيم النخعي عن حماد بن أبي سليمان عن عبد الرحمن بن زياد العراقي عن سليمان بن شعيب الكيساني عن الطحاوي","باب الرجل يحرم وعليه قميص كيف ينبغي له أن يخلعه"
"3415","3645  -  حَدَّثَنَا  سُلَيْمَانُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  أَنَّ رَجُلًا يُقَالُ لَهُ : يَعْلَى بْنُ أُمَيَّةَ أَحْرَمَ وَعَلَيْهِ جُبَّةٌ ، فَأَمَرَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَنْزِعَهَا  .  قَالَ  قَتَادَةُ  : قُلْتُ  لِعَطَاءٍ  : إِنَّمَا كُنَّا نَرَى أَنْ يَشُقَّهَا ، فَقَالَ  عَطَاءٌ  : ( إِنَّ اللهَ لَا يُحِبُّ الْفَسَادَ )  .","","Sharh Ma'ani al-Athar 3645","","يعلى بن أمية بن أبي عبيدة الحنظلى عن عطاء بن أبي رباح عن قتادة بن دعامة عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن سليمان بن شعيب الكيساني عن الطحاوي","باب الرجل يحرم وعليه قميص كيف ينبغي له أن يخلعه"
"3416","3646  -  حَدَّثَنَا  سُلَيْمَانُ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي مَسْلَمَةَ الْأَزْدِيِّ قَالَ :  سَمِعْتُ  عِكْرِمَةَ ، وَسُئِلَ عَنْ رَجُلٍ أَحْرَمَ وَعَلَيْهِ قَبَاءٌ ، قَالَ : يَخْلَعُهُ  .  فَهَذَا  عَطَاءٌ  وَعِكْرِمَةُ  قَدْ خَالَفَ  إِبْرَاهِيمَ  وَالشَّعْبِيَّ  وَسَعِيدَ بْنَ جُبَيْرٍ  ، وَذَهَبَا إِلَى مَا ذَهَبْنَا إِلَيْهِ مِنْ حَدِيثِ  يَعْلَى  .","","Sharh Ma'ani al-Athar 3646","","عكرمة مولى ابن عباس عن سعيد بن يزيد الطاحي عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن سليمان بن شعيب الكيساني عن الطحاوي","باب الرجل يحرم وعليه قميص كيف ينبغي له أن يخلعه"
"3417","9 - بَابُ مَا كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِهِ مُحْرِمًا فِي حَجَّةِ الْوَدَاعِ  3647  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَفْرَدَ  الْحَجَّ  .","","Sharh Ma'ani al-Athar 3647","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبد الرحمن بن القاسم بن محمد بن أبي بكر عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3418","3648  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ - هُوَ ابْنُ مُوسَى - قَالَ :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  خَرَجْنَا وَلَا نَرَى إِلَّا أَنَّهُ  الْحَجُّ  .","","Sharh Ma'ani al-Athar 3648","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن الوضاح بن عبد الله اليشكري عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3419","[2/140]      3649  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  بِشْرُ بْنُ عُمَرَ ، قَالَ :  ثَنَا  مَالِكٌ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ نَوْفَلٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  عَامَ حَجَّةِ الْوَدَاعِ  ، فَمِنَّا مَنْ أَهَلَّ بِعُمْرَةٍ  ، وَمِنَّا مَنْ أَهَلَّ بِحَجٍّ وَعُمْرَةٍ ، وَمِنَّا مَنْ أَهَلَّ بِالْحَجِّ ، وَأَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْحَجِّ .  فَأَمَّا مَنْ أَهَلَّ بِالْعُمْرَةِ ، فَحَلَّ ، وَأَمَّا مَنْ أَهَلَّ بِالْحَجِّ ، أَوْ جَمَعَ بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ ، فَلَمْ يُحِلَّ ، حَتَّى يَوْمِ النَّحْرِ  .","","Sharh Ma'ani al-Athar 3649","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن مالك بن أنس عن بشر بن عمر الزهراني عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3420","3650  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  ابْنُ أَبِي مَرْيَمَ ، قَالَ :  أَخْبَرَنِي  ابْنُ أَبِي الزِّنَادِ ، قَالَ :  حَدَّثَنِي  عَلْقَمَةُ بْنُ أَبِي عَلْقَمَةَ ،  عَنْ  أُمِّهِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَمَرَ النَّاسَ  عَامَ حَجَّةِ الْوَدَاعِ  ، فَقَالَ :  مَنْ أَحَبَّ أَنْ يَبْدَأَ بِالْعُمْرَةِ قَبْلَ  الْحَجِّ  فَلْيَفْعَلْ  ، وَأَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَفْرَدَ  الْحَجَّ  .","","Sharh Ma'ani al-Athar 3650","","عائشة بنت أبي بكر الصديق عن مرجانة المدنية أم علقمة عن علقمة بن أبي علقمة مولى عائشة عن عبد الرحمن بن أبي الزناد عن سعيد بن الحكم الجمحي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3421","3651  -  حَدَّثَنَا  نَصْرُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  الْخَصِيبُ ، قَالَ :  ثَنَا  وُهَيْبٌ ،  عَنْ  مَنْصُورِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أُمِّهِ ،  عَنْ  أَسْمَاءَ رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ مُهِلِّينَ بِالْحَجِّ  .","","Sharh Ma'ani al-Athar 3651","","أسماء بنت أبي بكر عن صفية بنت شيبة الحجبية عن منصور بن عبد الرحمن بن طلحة الحجبي عن وهيب بن خالد الكرابيسي عن الخصيب بن ناصح الحارثي عن نصر بن مرزوق المصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3422","3652  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ فِي حَدِيثِهِ الطَّوِيلِ ، فَقَالَ :  فَأَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالتَّوْحِيدِ  ، وَلَمْ يَزِدْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى النَّاسِ شَيْئًا ، وَلَسْنَا نَنْوِي إِلَّا  الْحَجَّ  ، وَلَا نَعْرِفُ الْعُمْرَةَ  .","","Sharh Ma'ani al-Athar 3652","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن حاتم بن إسماعيل الحارثي عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3423","3653  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  اللَّيْثُ وَابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ قَالَ :  أَقْبَلْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُهِلِّينَ بِالْحَجِّ مُفْرَدًا  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى هَذَا ، فَقَالُوا : الْإِفْرَادُ أَفْضَلُ مِنَ التَّمَتُّعِ وَالْقِرَانِ ، وَقَالُوا : بِهِ كَانَ أَحْرَمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّةِ الْوَدَاعِ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : التَّمَتُّعُ بِالْعُمْرَةِ إِلَى  الْحَجِّ  أَفْضَلُ مِنَ الْإِفْرَادِ وَالْقِرَانِ ، وَقَالُوا : هُوَ الَّذِي كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَلَهُ فِي حَجَّةِ الْوَدَاعِ .  وَذَكَرُوا فِي ذَلِكَ مَا .","","Sharh Ma'ani al-Athar 3653","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3424","3654  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ :  اجْتَمَعَ  عَلِيٌّ  وَعُثْمَانُ رَضِيَ اللهُ عَنْهُمَا بِـ (  عُسْفَانَ  ) ،  وَعُثْمَانُ  رَضِيَ اللهُ عَنْهُ يَنْهَى عَنِ  الْمُتْعَةِ  .  فَقَالَ لَهُ عَلِيٌّ :  مَا تُرِيدُ إِلَى أَمْرٍ قَدْ فَعَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَنْهَى عَنْهُ  .  فَقَالَ : دَعْنَا مِنْكَ ، فَقَالَ : إِنِّي لَا أَسْتَطِيعُ أَنْ أَدَعَكَ ، ثُمَّ أَهَلَّ  عَلِيُّ بْنُ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ بِهِمَا جَمِيعًا  .         [2/141]","","Sharh Ma'ani al-Athar 3654","","علي بن أبي طالب عن سعيد بن المسيب عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3425","3655  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ :  حَجَّ عُثْمَانُ رَضِيَ اللهُ عَنْهُ ، فَقَالَ لَهُ عَلِيٌّ رَضِيَ اللهُ عَنْهُ : أَلَمْ تَسْمَعْ رَسُولَ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَمَتَّعَ ؟ قَالَ : بَلَى  .","","Sharh Ma'ani al-Athar 3655","","علي بن أبي طالب عن سعيد بن المسيب عن عبد الرحمن بن حرملة الأسلمي عن حاتم بن إسماعيل الحارثي عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3426","3656  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلِ بْنِ عَبْدِ الْمُطَّلِبِ ،  أَنَّهُ  حَدَّثَهُ  ،  أَنَّهُ سَمِعَ  سَعْدَ بْنَ أَبِي وَقَّاصٍ  ،  وَالضَّحَّاكَ بْنَ قَيْسٍ  ، عَامَ حَجَّ  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ  ، وَهُمَا يَذْكُرَانِ التَّمَتُّعَ بِالْعُمْرَةِ إِلَى  الْحَجِّ  .  فَقَالَ  الضَّحَّاكُ  : ( لَا يَصْنَعُ ذَلِكَ إِلَّا مَنْ جَهِلَ أَمْرَ اللهِ ) .  فَقَالَ  سَعْدٌ  : ( بِئْسَ مَا قُلْتَ يَا ابْنَ أَخِي ) ، فَقَالَ : الضَّحَّاكُ : ( فَإِنَّ عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ قَدْ نَهَى عَنْ ذَلِكَ ) .  فَقَالَ سَعْدٌ :  قَدْ صَنَعَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَصَنَعْنَاهَا مَعَهُ  .","","Sharh Ma'ani al-Athar 3656","","أبو سعيد الخدري عن الضحاك بن قيس الفهري عن محمد بن عبد الله بن الحارث النوفلي عن الزهري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3427","3657  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  بِشْرُ بْنُ عُمَرَ ، قَالَ :  ثَنَا  مَالِكٌ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3657","","أبو سعيد الخدري عن الضحاك بن قيس الفهري عن محمد بن عبد الله بن الحارث النوفلي عن الزهري عن مالك بن أنس عن بشر بن عمر الزهراني عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3428","3658  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ ، قَالَ  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  غُنَيْمِ بْنِ قَيْسٍ ، قَالَ :  سَأَلْتُ سَعْدَ بْنَ مَالِكٍ عَنْ مُتْعَةِ  الْحَجِّ  ،  فَقَالَ  : فَعَلْنَاهَا وَهُوَ يَوْمَئِذٍ مُشْرِكٌ بِالْعُرُشِ  ،  يَعْنِي  مُعَاوِيَةَ  ، يَعْنِي (  عُرُوشَ  بُيُوتِ  مَكَّةَ  )  .","","Sharh Ma'ani al-Athar 3658","","سعد بن أبي وقاص عن غنيم بن قيس الكعبي عن سليمان بن طرخان عن عبد الله بن المبارك عن محمد بن سعيد حمدان عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3429","3659  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  مُسْلِمٍ - وَهُوَ الْقُرِّيُّ - قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  أَهَلَّ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْحَجِّ ، وَأَهَلَّ هُوَ بِالْعُمْرَةِ ،  فَمَنْ كَانَ مَعَهُ هَدْيٌ لَمْ يَحِلَّ ، وَمَنْ لَمْ يَكُنْ مَعَهُ هَدْيٌ  أَحَلَّ  ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَطَلْحَةُ  مِمَّنْ مَعَهُمَا الْهَدْيُ ، فَلَمْ يُحِلَّا  .","","Sharh Ma'ani al-Athar 3659","","عبد الله بن عباس عن مسلم بن مخراق القطان عن شعبة بن الحجاج عن أبو داود الطيالسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3430","3660  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْمُؤْمِنِ الْمَرْوَزِيُّ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ، قَالَ :  ثَنَا  أَبُو حَمْزَةَ ،  عَنْ  لَيْثٍ - هُوَ ابْنُ أَبِي سُلَيْمٍ . (  ح  ) .  3661  -  وَحَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  خَالِدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  لَيْثٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  تَمَتَّعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى مَاتَ ، وَأَبُو بَكْرٍ رَضِيَ اللهُ عَنْهُ حَتَّى مَاتَ  ، وَعُمَرُ رَضِيَ اللهُ عَنْهُ حَتَّى مَاتَ ، وَعُثْمَانُ رَضِيَ اللهُ عَنْهُ حَتَّى مَاتَ  .  قَالَ  سُلَيْمَانُ  فِي حَدِيثِهِ : ( وَأَوَّلُ مَنْ نَهَى عَنْهَا مُعَاوِيَةُ ) .","","Sharh Ma'ani al-Athar 3660","","عبد الله بن عباس عن طاوس بن كيسان عن ليث بن أبي سليم عن سفيان الثوري عن خالد بن عبد الرحمن الخراساني عن سليمان بن شعيب الكيساني عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3431","3662  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحِمَّانِيُّ ، قَالَ :  ثَنَا  شَرِيكُ بْنُ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ شَرِيكٍ ، قَالَ : تَمَتَّعْتُ فَسَأَلْتُ ابْنَ عُمَرَ وَابْنَ عَبَّاسٍ وَابْنَ الزُّبَيْرِ رَضِيَ اللهُ عَنْهُمْ ،  فَقَالُوا  : (  هُدِيتَ لِسُنَّةِ نَبِيِّكَ ، تَقْدَمُ ، ثُمَّ تَطُوفُ ، ثُمَّ تَحِلُّ  ) .         [2/142]","","Sharh Ma'ani al-Athar 3662","","عبد الله بن الزبير عن عبد الله بن شريك العامري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3432","3663  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو غَسَّانَ ، قَالَ :  ثَنَا  شَرِيكٌ ، فَذَكَرَ  بِإِسْنَادِهِ  نَحْوَهُ ، غَيْرَ أَنَّهُ قَالَ : قَالَ  أَبُو غَسَّانَ  : أَظُنُّهُ قَالَ : (  لِسُنَّةِ نَبِيِّكَ افْعَلْ كَذَا ، ثُمَّ أَحْرِمْ يَوْمَ  التَّرْوِيَةِ  ، وَافْعَلْ كَذَا ، وَافْعَلْ كَذَا  ) .","","Sharh Ma'ani al-Athar 3663","","عبد الله بن الزبير عن عبد الله بن شريك العامري عن شريك بن عبد الله النخعي عن مالك بن إسماعيل النهدي عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3433","3664  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي حَمْزَةَ  ، قَالَ :  تَمَتَّعْتُ فَنَهَانِي نَاسٌ عَنْهَا ، فَسَأَلْتُ  ابْنَ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا ، فَأَمَرَ لِي بِهَا ، فَتَمَتَّعْتُ فَنِمْتُ  ، فَأَتَانِي آتٍ فِي الْمَنَامِ ، فَقَالَ : ( عُمْرَةٌ مُتَقَبَّلَةٌ ، وَحَجٌّ  مَبْرُورٌ  ) .  فَأَتَيْتُ ابْنَ عَبَّاسٍ فَأَخْبَرْتُهُ ،  فَقَالَ  : ( اللهُ أَكْبَرُ  سُنَّةُ  أَبِي الْقَاسِمِ  ، أَوْ سُنَّةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  )  .  كذا في طبعة عالم الكتب ، والصواب : ( أبي جمرة). كما في مصادر التخريج.","","Sharh Ma'ani al-Athar 3664","","عبد الله بن عباس عن نصر بن عمران بن عصام الضبعي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3434","3665  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْوَهْبِيُّ - هُوَ أَحْمَدُ بْنُ خَالِدٍ - قَالَ :  ثَنَا  ابْنُ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ  قَالَ : (  إِنِّي لَجَالِسٌ مَعَ ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا فِي الْمَسْجِدِ إِذْ جَاءَهُ رَجُلٌ مِنْ  أَهْلِ الشَّامِ  ، فَسَأَلَهُ عَنِ التَّمَتُّعِ بِالْعُمْرَةِ إِلَى  الْحَجِّ  ) ،  فَقَالَ  ابْنُ عُمَرَ  : ( حَسَنٌ جَمِيلٌ ) ، فَقَالَ : فَإِنَّ أَبَاكَ كَانَ يَنْهَى عَنْ ذَلِكَ ، فَقَالَ : ( وَيْلَكَ ، فَإِنْ كَانَ أَبِي قَدْ نَهَى عَنْ ذَلِكَ ، وَقَدْ فَعَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَمَرَ بِهِ ، فَبِقَوْلِ أَبِي تَأْخُذُ ، أَمْ بِأَمْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ ) . قَالَ : بِأَمْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : ( قُمْ عَنِّي )  .","","Sharh Ma'ani al-Athar 3665","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن إسحاق عن أحمد بن خالد بن موسى الوهبي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3435","3666  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ وَابْنُ أَبِي دَاوُدَ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  حَدَّثَنِي  سَالِمُ بْنُ عَبْدِ اللهِ ،  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا قَالَ :  تَمَتَّعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  حَجَّةِ الْوَدَاعِ  بِالْعُمْرَةِ إِلَى  الْحَجِّ  ، وَأَهْدَى وَسَاقَ مَعَهُ الْهَدْيَ مِنْ  ذِي الْحُلَيْفَةِ  ، وَبَدَأَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَهَلَّ بِالْعُمْرَةِ ، ثُمَّ أَهَلَّ بِالْحَجِّ ، وَتَمَتَّعَ النَّاسُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْعُمْرَةِ إِلَى  الْحَجِّ  .","","Sharh Ma'ani al-Athar 3666","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3436","3667  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  أَخْبَرَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ، أَنَّ عَائِشَةَ رَضِيَ اللهُ عَنْهَا  أَخْبَرَتْهُ  عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي تَمَتُّعِهِ بِالْعُمْرَةِ إِلَى  الْحَجِّ  ، وَتَمَتُّعِ النَّاسِ مَعَهُ بِمِثْلِ الَّذِي أَخْبَرَنِي بِهِ  سَالِمٌ  ، عَنْ  عَبْدِ اللهِ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  فَإِنْ قَالَ قَائِلٌ : فَقَدْ رَوَيْتُمْ عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا فِي أَوَّلِ هَذَا الْبَابِ خِلَافَ هَذَا .  فَرَوَيْتُمْ ، عَنِ  الْقَاسِمِ  ، عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَفْرَدَ  الْحَجَّ  .  وَرَوَيْتُمْ عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ نَوْفَلٍ  ، عَنْ  عُرْوَةَ  ، عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا ، قَالَتْ :  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَامَ حَجَّةِ الْوَدَاعِ ، فَمِنَّا مَنْ أَهَلَّ بِعُمْرَةٍ ، وَمِنَّا مَنْ أَهَلَّ بِحَجَّةٍ وَعُمْرَةٍ ، وَمِنَّا مَنْ أَهَلَّ بِالْحَجِّ ، وَأَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْحَجِّ  .         [2/143]      وَرَوَيْتُمْ ، عَنْ  أُمِّ عَلْقَمَةَ  ، عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَامَ حَجَّةِ الْوَدَاعِ  أَفْرَدَ  الْحَجَّ  وَلَمْ يَعْتَمِرْ  .  قِيلَ لَهُ : قَدْ يَجُوزُ أَنْ يَكُونَ الْإِفْرَادُ الَّذِي ذَكَرَهُ هَذَا عَلَى مَعْنًى لَا يُخَالِفُ مَعْنَى مَا رَوَى  الزُّهْرِيُّ  ، عَنْ  عُرْوَةَ  ، عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا .  وَذَلِكَ أَنَّهُ قَدْ يَجُوزُ أَنْ يَكُونَ الْإِفْرَادُ الَّذِي ذَكَرَهُ  الْقَاسِمُ  عَنْ  عَائِشَةَ  ، إِنَّمَا أَرَادَتْ بِهِ إِفْرَادَ  الْحَجِّ  فِي وَقْتِ مَا أَحْرَمَ ، وَإِنْ كَانَ قَدْ أَحْرَمَ بَعْدَ خُرُوجِهِ مِنْهُ بِعُمْرَةٍ .  فَأَرَادَتْ أَنَّهُ لَمْ يَخْلِطْهُ فِي وَقْتِ إِحْرَامِهِ بِهِ ، بِإِحْرَامٍ بِعُمْرَةٍ ، كَمَا فَعَلَ غَيْرُهُ مِمَّنْ كَانَ مَعَهُ .  وَأَمَّا حَدِيثُ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ  ، عَنْ  عُرْوَةَ  ، عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا ، فَإِنَّهَا أَخْبَرَتْ أَنَّ مِنْهُمْ مَنْ أَهَلَّ بِعُمْرَةٍ لَا حَجَّةَ مَعَهَا ، وَمِنْهُمْ مَنْ أَهَلَّ بِحَجَّةٍ وَعُمْرَةٍ ، يَعْنِي مَقْرُونَتَيْنِ ، وَمِنْهُمْ مَنْ أَهَلَّ بِالْحَجِّ وَلَمْ يَذْكُرْ فِي ذَلِكَ التَّمَتُّعَ .  فَقَدْ يَجُوزُ أَنْ يَكُونَ الَّذِينَ قَدْ كَانُوا أَحْرَمُوا بِالْعُمْرَةِ ، أَحْرَمُوا بَعْدَهَا بِحَجَّةٍ ، لَيْسَ حَدِيثُهَا هَذَا يَنْفِي مِنْ ذَلِكَ شَيْئًا ، وَأَنَّهَا قَالَتْ :  وَأَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْحَجِّ مُفْرِدًا  . فَقَدْ يَجُوزُ أَنْ يَكُونَ ذَلِكَ  الْحَجُّ  الْمُفْرَدُ بَعْدَ عُمْرَةٍ قَدْ كَانَتْ تَقَدَّمَتْ مِنْهُ مُفْرَدَةً .  فَيَكُونُ قَدْ أَحْرَمَ بِعُمْرَةٍ مُفْرَدَةٍ عَلَى مَا فِي حَدِيثِ  الْقَاسِمِ  ،  وَمُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ  ، عَنْ  عُرْوَةَ  ، ثُمَّ أَحْرَمَ بَعْدَ ذَلِكَ بِحَجَّةٍ ، عَلَى مَا فِي حَدِيثِ  الزُّهْرِيِّ  ، عَنْ  عُرْوَةَ  ، حَتَّى تَتَّفِقَ هَذِهِ  الْآثَارُ  ، وَلَا تَتَضَادَّ .  فَأَمَّا مَعْنَى مَا رَوَتْ  أُمُّ عَلْقَمَةَ  عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَفْرَدَ  الْحَجَّ  وَلَمْ يَعْتَمِرْ  . فَقَدْ يَجُوزُ أَنْ تَكُونَ تُرِيدُ بِذَلِكَ أَنَّهُ لَمْ يَعْتَمِرْ فِي وَقْتِ إِحْرَامِهِ بِالْحَجِّ كَمَا فَعَلَ بَعْضُ مَنْ كَانَ مَعَهُ ، وَلَكِنَّهُ اعْتَمَرَ بَعْدَ ذَلِكَ  .","","Sharh Ma'ani al-Athar 3667","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3437","3668  -  حَدَّثَنَا  رَوْحُ بْنُ الْفَرَجِ ، قَالَ :  ثَنَا  عَمْرُو بْنُ خَالِدٍ ، قَالَ :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ، أَنَّ عَبْدَ اللهِ مَوْلَى أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ الصِّدِّيقِ رَضِيَ اللهُ عَنْهُمَا  حَدَّثَهُ  ،  أَنَّهُ سَمِعَ  أَسْمَاءَ لَمَّا مَرَّتْ  بِالْحَجُونِ  تَقُولُ :  صَلَّى اللهُ عَلَى رَسُولِ اللهِ ، لَقَدْ نَزَلْنَا مَعَهُ هَهُنَا وَنَحْنُ خِفَافُ الْحَقَائِبِ ،  قَلِيلٌ ظُهُورُنَا ، قَلِيلَةٌ أَزْوَادُنَا ، فَاعْتَمَرْتُ أَنَا وَأُخْتِي  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا ،  وَالزُّبَيْرُ  ،  وَفُلَانٌ  وَفُلَانٌ  ، فَلَمَّا  مَسَحْنَا  الْبَيْتَ  أَحْلَلْنَا ، ثُمَّ أَهْلَلْنَا مِنَ الْعَشِيِّ بِالْحَجِّ  .  فَهَذِهِ  أَسْمَاءُ  تُخْبِرُ ، أَنَّ مَنْ كَانَ حِينَئِذٍ ابْتَدَأَ بِعُمْرَةٍ ، فَقَدْ أَحْرَمَ بَعْدَهَا بِحَجَّةٍ ، فَصَارَ بِهَا مُتَمَتِّعًا .","","Sharh Ma'ani al-Athar 3668","","أسماء بنت أبي بكر عن عبد الله بن كيسان مولى أسماء بنت أبي بكر عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن روح بن الفرج القطان عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3438","3669  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  الْخَصِيبُ ، قَالَ :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  عِمْرَانَ ، قَالَ :  تَمَتَّعْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَنَزَلَ فِيهَا الْقُرْآنُ ، فَلَمْ يَنْهَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، وَلَمْ يَنْسَخْهَا شَيْءٌ ، ثُمَّ قَالَ  رَجُلٌ  بِرَأْيِهِ مَا شَاءَ  .","","Sharh Ma'ani al-Athar 3669","","عمران بن حصين بن عبيد بن خلف الخزاعي عن مطرف بن عبد الله بن الشخير الحرشي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن الخصيب بن ناصح الحارثي عن سليمان بن شعيب الكيساني عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3439","[2/144]      3670  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  حُمَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  عِمْرَانَ بْنِ حُصَيْنٍ ، قَالَ :  تَمَتَّعْنَا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُتْعَةَ  الْحَجِّ  ، فَلَمْ يَنْهَنَا عَنْهَا ،  وَلَمْ يُنْزِلِ اللهُ فِيهَا نَهْيًا  .","","Sharh Ma'ani al-Athar 3670","","عمران بن حصين بن عبيد بن خلف الخزاعي عن الحسن البصري عن حميد الطويل عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3440","3671  -  حَدَّثَنَا  سُلَيْمَانُ ، قَالَ :  ثَنَا  الْخَصِيبُ ، قَالَ :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  تَمَتَّعْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَلَمَّا وَلِيَ  عُمَرُ  خَطَبَ النَّاسَ ، فَقَالَ : إِنَّ الْقُرْآنَ هُوَ الْقُرْآنُ ، وَإِنَّ الرَّسُولَ هُوَ الرَّسُولُ ، وَإِنَّهُمَا كَانَتَا مُتْعَتَانِ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مُتْعَةُ  الْحَجِّ  ، فَافْصِلُوا بَيْنَ حَجِّكُمْ وَعُمْرَتِكُمْ ، فَإِنَّهُ أَتَمُّ لِحَجِّكُمْ ، وَأَتَمُّ لِعُمْرَتِكُمْ ، وَالْأُخْرَى مُتْعَةُ النِّسَاءِ ، فَأَنْهَى عَنْهَا وَأُعَاقِبُ عَلَيْهَا  .","","Sharh Ma'ani al-Athar 3671","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن الخصيب بن ناصح الحارثي عن سليمان بن شعيب الكيساني عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3441","3672  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ قَالَ :  (  مُتْعَتَانِ فَعَلْنَاهُمَا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نَهَانَا عَنْهُمَا  عُمَرُ  رَضِيَ اللهُ عَنْهُ فَلَمْ نَعُدْ إِلَيْهِمَا  ) .  وَقَدْ رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ قَوْلِهِ مَا يَدُلُّ عَلَى أَنَّهُ كَانَ كَذَلِكَ أَيْضًا .","","Sharh Ma'ani al-Athar 3672","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن المنذر بن مالك العوقي عن عاصم بن سليمان الأحول عن حماد بن زيد عن سليمان بن حرب الواشحي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3442","3673  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  حَفْصَةَ رَضِيَ اللهُ عَنْهُمْ أَنَّهَا قَالَتْ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا  شَأْنُ  النَّاسِ حَلُّوا بِعُمْرَةٍ ، وَلَمْ تَحْلِلْ أَنْتَ مِنْ عُمْرَتِكَ ؟  فَقَالَ :  إِنِّي  لَبَّدْتُ  رَأْسِي ، وَقَلَّدْتُ هَدْيِي ، فَلَا  أَحِلُّ  حَتَّى أَنْحَرَ  ،  فَدَلَّ هَذَا الْحَدِيثُ أَنَّهُ كَانَ مُتَمَتِّعًا ؛ لِأَنَّ الْهَدْيَ الْمُقَلَّدَ لَا يَمْنَعُ مِنَ الْحِلِّ إِلَّا فِي  الْمُتْعَةِ  خَاصَّةً .  هَذَا إِنْ كَانَ ذَلِكَ الْقَوْلُ مِنْهُ بَعْدَ طَوَافِهِ لِلْعُمْرَةِ ، وَقَدْ يُحْتَمَلُ أَيْضًا أَنْ يَكُونَ هَذَا الْقَوْلُ كَانَ مِنْهُ قَبْلَ أَنْ يُحْرِمَ بِالْحَجِّ ، وَقَبْلَ أَنْ يَطُوفَ لِلْعُمْرَةِ ، فَكَانَ ذَلِكَ حُكْمَهُ ، لَوْلَا سِيَاقُهُ الْهَدْيَ ، يَحِلُّ كَمَا يَحِلُّ النَّاسُ ، بَعْدَ أَنْ يَطُوفَ فَلَمْ يَطُفْ ، حَتَّى أَحْرَمَ بِالْحَجِّ ، فَصَارَ قَارِنًا .  فَلَيْسَ يَخْلُو حَدِيثُ  حَفْصَةَ  رَضِيَ اللهُ عَنْهَا الَّذِي ذَكَرْنَا ، مِنْ أَحَدِ هَذَيْنِ التَّأْوِيلَيْنِ .  وَعَلَى أَيِّهِمَا كَانَ فِي الْحَقِيقَةِ ، فَإِنَّهُ قَدْ نَفَى قَوْلَ مَنْ قَالَ : ( إِنَّهُ كَانَ مُفْرِدًا بِحَجَّةٍ لَمْ يَتَقَدَّمْهَا عُمْرَةٌ ، وَلَمْ يَكُنْ مَعَهَا عُمْرَةٌ ) .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : بَلِ الْقِرَانُ فِي ذَلِكَ بَيْنَ الْعُمْرَةِ وَالْحَجَّةِ أَفْضَلُ مِنْ إِفْرَادِ  الْحَجِّ  ، وَمِنَ التَّمَتُّعِ بِالْعُمْرَةِ إِلَى  الْحَجِّ  .         [2/145]      وَقَالُوا : كَذَلِكَ فَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّةِ الْوَدَاعِ . وَذَكَرُوا فِي ذَلِكَ مَا  :","","Sharh Ma'ani al-Athar 3673","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3443","3674  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  بِشْرُ بْنُ بَكْرٍ ،  عَنِ  الْأَوْزَاعِيِّ قَالَ :  حَدَّثَنِي  عَبْدَةُ بْنُ أَبِي لُبَابَةَ ، قَالَ :  حَدَّثَنِي  شَقِيقُ بْنُ سَلَمَةَ ، قَالَ :  حَدَّثَنِي  رَجُلٌ مِنْ  تَغْلِبَ  - يُقَالُ لَهُ : ابْنُ مَعْبَدٍ - قَالَ :  أَهْلَلْتُ بِالْحَجِّ وَالْعُمْرَةِ جَمِيعًا ، فَلَمَّا قَدِمْتُ عَلَى عُمَرَ بْنِ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ ذَكَرْتُ لَهُ إِهْلَالِي  ،  فَقَالَ  : (  هُدِيتَ لِسُنَّةِ نَبِيِّكَ ، أَوْ : لِسُنَّةِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ) .","","Sharh Ma'ani al-Athar 3674","","عمر بن الخطاب عن صبي بن معبد التغلبي عن شقيق بن سلمة عن عبدة بن أبي لبابة عن أبو عمرو الأوزاعي عن بشر بن بكر التنيسي عن يونس بن عبد الأعلى عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3444","3675  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ ، قَالَ :  أَنَا  شَرِيكٌ ،  عَنْ  مَنْصُورٍ وَالْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3675","","عمر بن الخطاب عن صبي بن معبد التغلبي عن شقيق بن سلمة عن الأعمش عن شريك بن عبد الله النخعي عن محمد بن سعيد حمدان عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3445","3676  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  أَنَا  مَنْصُورٌ ، قَالَ :  سَمِعْتُ  أَبَا وَائِلٍ يُحَدِّثُ ، أَنَّ  الصُّبَيَّ  ، فَذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3676","","عمر بن الخطاب عن صبي بن معبد التغلبي عن شقيق بن سلمة عن منصور بن المعتمر عن شعبة بن الحجاج عن أبو داود الطيالسي عن يزيد بن سنان القزاز عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3446","3677  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ، قَالَ :  أَنَا  سَلَمَةُ بْنُ كُهَيْلٍ ،  عَنْ  أَبِي وَائِلٍ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3677","","عمر بن الخطاب عن صبي بن معبد التغلبي عن شقيق بن سلمة عن سلمة بن كهيل الحضرمي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3447","3678  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنْ  أَبِي وَائِلٍ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3678","","عمر بن الخطاب عن صبي بن معبد التغلبي عن شقيق بن سلمة عن عاصم بن بهدلة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3448","3679  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ، قَالَ :  أَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ، قَالَ :  سَمِعْتُ  أَبَا وَائِلٍ ، فَذَكَرَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3679","","عمر بن الخطاب عن صبي بن معبد التغلبي عن شقيق بن سلمة عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن عبد الله بن رجاء الغداني عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3449","3680  -  حَدَّثَنَا  حُسَيْنُ بْنُ نَصْرٍ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  أَبِي وَائِلٍ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3680","","عمر بن الخطاب عن صبي بن معبد التغلبي عن شقيق بن سلمة عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن الحسين بن نصر بن معارك البغدادي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3450","3681  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحُسَيْنُ بْنُ الرَّبِيعِ  ، قَالَ :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ، قَالَ : قَالَ  الصُّبَيُّ بْنُ مَعْبَدٍ  ، فَذَكَرَ نَحْوَهُ .  فَقَالَ الَّذِينَ أَنْكَرُوا الْقِرَانَ : إِنَّمَا قَوْلُ  عُمَرَ  رَضِيَ اللهُ عَنْهُ : هُدِيتَ لِسُنَّةِ نَبِيِّكَ عَلَى الدُّعَاءِ مِنْهُ لَهُ ، لَا عَلَى تَصْوِيبِهِ إِيَّاهُ فِي فِعْلِهِ .  فَكَانَ مِنَ الْحُجَّةِ عَلَيْهِمْ فِي ذَلِكَ ، مِمَّا يَدُلُّ عَلَى أَنَّ ذَلِكَ لَمْ يَكُنْ مِنْ  عُمَرَ  عَلَى جِهَةِ الدُّعَاءِ  .  كذا في طبعة عالم الكتب ، والصواب : ( الحسن بن الربيع )","","Sharh Ma'ani al-Athar 3681","","عمر بن الخطاب عن صبي بن معبد التغلبي عن شقيق بن سلمة عن الأعمش عن سلام بن سليم الحنفي عن الحسن بن الربيع البوراني عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3451","3682  -  أَنَّ فَهْدًا  حَدَّثَنَا  ، قَالَ :  ثَنَا  عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ ، قَالَ :  ثَنَا  أَبِي  ، قَالَ :  ثَنَا  الْأَعْمَشُ ، قَالَ :  حَدَّثَنِي  شَقِيقٌ ، قَالَ :  حَدَّثَنِي  الصُّبَيُّ بْنُ مَعْبَدٍ ، قَالَ : (  كُنْتُ حَدِيثَ عَهْدٍ بِنَصْرَانِيَّةٍ ، فَلَمَّا أَسْلَمْتُ لَمْ آلُ أَنْ  أَجْتَهِدَ  ، فَأَهْلَلْتُ بِعُمْرَةٍ وَحَجَّةٍ جَمِيعًا  ، فَمَرَرْتُ بِالْعُذَيْبِ  بِسَلْمَانَ بْنِ رَبِيعَةَ  ،  وَزَيْدِ بْنِ صُوحَانَ  ، فَسَمِعَانِي وَأَنَا أُهِلُّ بِهِمَا جَمِيعًا .  فَقَالَ أَحَدُهُمَا لِصَاحِبِهِ : أَبِهِمَا جَمِيعًا ؟ وَقَالَ الْآخَرُ : دَعْهُ فَهُوَ أَضَلُّ مِنْ بَعِيرِهِ .  قَالَ : فَانْطَلَقْتُ ، وَكَانَ بَعِيرِي عَلَى عُنُقِي  .         [2/146]      فَقَدِمْتُ  الْمَدِينَةَ  فَلَقِيتُ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ فَقَصَصْتُ عَلَيْهِ ، فَقَالَ :  إِنَّهُمَا لَمْ يَقُولَا شَيْئًا هُدِيتَ لِسُنَّةِ نَبِيِّكَ  )  .","","Sharh Ma'ani al-Athar 3682","","عمر بن الخطاب عن صبي بن معبد التغلبي عن شقيق بن سلمة عن الأعمش عن حفص بن غياث النخعي عن عمر بن حفص بن غياث عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3452","3683  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْحَنْظَلِيُّ ، قَالَ :  أَنَا  وَكِيعٌ ، قَالَ :  ثَنَا  الْأَعْمَشُ ،  عَنْ  شَقِيقٍ ،  عَنِ  الصُّبَيِّ بْنِ مَعْبَدٍ ، قَالَ : (  أَهْلَلْتُ بِهِمَا جَمِيعًا ، فَمَرَرْتُ  بِسَلْمَانَ بْنِ رَبِيعَةَ  وَزَيْدِ بْنِ صُوحَانَ  ، فَعَابَا ذَلِكَ عَلَيَّ  )  .  فَلَمَّا قَدِمْتُ عَلَى عُمَرَ رَضِيَ اللهُ عَنْهُ ذَكَرْتُ ذَلِكَ لَهُ ،  فَقَالَ  : (  إِنَّهُمَا لَمْ يَقُولَا شَيْئًا هُدِيتَ لِسُنَّةِ نَبِيِّكَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  )  .  فَدَلَّ قَوْلُهُ : ( هُدِيتَ لِسُنَّةِ نَبِيِّكَ ) بَعْدَ قَوْلِهِ : ( إِنَّهُمَا لَمْ يَقُولَا شَيْئًا ) أَنَّ ذَلِكَ كَانَ مِنْهُ عَلَى التَّصْوِيبِ مِنْهُ ، لَا عَلَى الدُّعَاءِ  .  وَقَدْ رُوِيَ عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا ، عَنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ مَا يَدُلُّ عَلَى ذَلِكَ أَيْضًا .","","Sharh Ma'ani al-Athar 3683","","عمر بن الخطاب عن صبي بن معبد التغلبي عن شقيق بن سلمة عن الأعمش عن وكيع بن الجراح عن إسحاق ابن راهويه عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3453","3684  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ مَيْمُونٍ ، قَالَ :  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، قَالَ :  ثَنَا  الْأَوْزَاعِيُّ ، قَالَ :  ثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  عَنْ  عُمَرَ رَضِيَ اللهُ عَنْهُ قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ  بِالْعَقِيقِ  ، يَقُولُ :  أَتَانِي اللَّيْلَةَ آتٍ مِنْ رَبِّي ، فَقَالَ : صَلِّ فِي هَذَا الْوَادِي الْمُبَارَكِ  ، وَقُلْ : عُمْرَةٌ فِي حَجَّةٍ  .","","Sharh Ma'ani al-Athar 3684","","عمر بن الخطاب عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن محمد بن عبد الله بن ميمون السكري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3454","3685  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  هَارُونُ بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ ، قَالَ :  ثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَأَخْبَرَ  عُمَرُ  فِي هَذَا الْحَدِيثِ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ أَتَاهُ آتٍ مِنْ رَبِّهِ ، فَقَالَ لَهُ : قُلْ : عُمْرَةٌ فِي حَجَّةٍ .  فَلَمَّا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ كَانَ أُمِرَ أَنْ يَجْعَلَ عُمْرَةً فِي حَجَّةٍ اسْتَحَالَ أَنْ يَكُونَ مَا فَعَلَ خِلَافًا لِمَا أُمِرَ بِهِ  .  فَإِنْ قَالَ قَائِلٌ : وَكَيْفَ يَجُوزُ أَنْ يُنْقَلَ هَذَا عَنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ وَقَدْ نَهَى عَنِ  الْمُتْعَةِ  ؟ وَقَدْ ذَكَرْتُمْ ذَلِكَ عَنْهُ فِي حَدِيثِ  مَالِكٍ  ، عَنِ  الزُّهْرِيِّ  ، عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ  ؟  وَذَكَرَ فِي ذَلِكَ أَيْضًا مَا","","Sharh Ma'ani al-Athar 3685","","عمر بن الخطاب عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن علي بن المبارك الهنائي عن هارون بن إسماعيل الخزاز عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3455","3686  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  مَالِكٌ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  قَالَ  عُمَرُ رَضِيَ اللهُ عَنْهُ :  مُتْعَتَانِ كَانَتَا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْهَى عَنْهُمَا وَأُعَاقِبُ عَلَيْهِمَا : مُتْعَةُ النِّسَاءِ  ، وَمُتْعَةُ  الْحَجِّ  .","","Sharh Ma'ani al-Athar 3686","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن مكي بن إبراهيم عن يزيد بن سنان القزاز عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3456","3687  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  أَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللهُ عَنْهُ  كَانَ يَنْهَى عَنْ مُتْعَةِ النِّسَاءِ وَمُتْعَةِ  الْحَجِّ  .  قَالُوا : فَكَيْفَ يَجُوزُ أَنْ يُعَاقِبَ أَحَدًا عَلَى أَمْرٍ قَدْ عَلِمَ أَنَّ اللهَ عَزَّ وَجَلَّ قَدْ أَمَرَ بِهِ رَسُولَهُ ؟  قِيلَ لَهُ : لَيْسَتْ هَذِهِ  الْمُتْعَةُ  الَّتِي فِي هَذَا الْحَدِيثِ ، هِيَ  الْمُتْعَةُ  الَّتِي اسْتَحَبَّهَا أَهْلُ الْمَقَالَةِ الَّتِي ذَكَرْنَاهَا فِي الْفَصْلِ الَّذِي قَبْلَ هَذَا ، وَلَكِنَّ هَذِهِ  الْمُتْعَةَ  - عِنْدَنَا وَاللهُ أَعْلَمُ - هِيَ الْإِحْرَامُ الَّذِي كَانَ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحْرَمُوهُ بِحَجَّةٍ ، ثُمَّ طَافُوا لَهَا ، وَسَعَوْا قَبْلَ عَرَفَةَ ، وَحَلَقُوا وَحَلُّوا ، فَتِلْكَ مُتْعَةٌ قَدْ كَانَتْ تُفْعَلُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ نُسِخَتْ ، وَسَنَذْكُرُهَا وَمَا رُوِيَ فِيهَا وَفِي نَسْخِهَا ، فِي غَيْرِ هَذَا الْمَوْضِعِ فِي كِتَابِنَا هَذَا ، إِنْ شَاءَ اللهُ تَعَالَى .         [2/147]      فَهَذِهِ  الْمُتْعَةُ  الَّتِي نَهَى عَنْهَا  عُمَرُ  رَضِيَ اللهُ عَنْهُ وَتَوَعَّدَ مَنْ فَعَلَهَا بِالْعُقُوبَةِ .  فَأَمَّا مُتْعَةٌ قَدْ ذَكَرَهَا اللهُ عَزَّ وَجَلَّ فِي كِتَابِهِ بِقَوْلِهِ :         {      فَمَنْ تَمَتَّعَ بِالْعُمْرَةِ إِلَى الْحَجِّ فَمَا اسْتَيْسَرَ مِنَ الْهَدْيِ         }      . الْآيَةَ . وَفَعَلَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ ؛ فَمُحَالٌ أَنْ يَنْهَى عَنْهَا  عُمَرُ  رَضِيَ اللهُ عَنْهُ بَلْ قَدْ رُوِّينَا عَنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ أَنَّهُ اسْتَحَبَّهَا وَحَضَّ عَلَيْهَا .","","Sharh Ma'ani al-Athar 3687","","عمر بن الخطاب عن سعيد بن المسيب عن داود بن أبي هند عن يزيد بن هارون عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3457","3688  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ، قَالَ :  سَمِعْتُ  طَاوُسًا  يُحَدِّثُ عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  يَقُولُونَ :  إِنَّ  عُمَرَ رَضِيَ اللهُ عَنْهُ نَهَى عَنِ  الْمُتْعَةِ  ، قَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : (  لَوِ اعْتَمَرْتُ فِي عَامٍ مَرَّتَيْنِ ، ثُمَّ حَجَجْتُ لَجَعَلْتُهَا مَعَ حَجَّتِي  )  .","","Sharh Ma'ani al-Athar 3688","","عمر بن الخطاب عن عبد الله بن عباس عن طاوس بن كيسان عن سلمة بن كهيل الحضرمي عن شعبة بن الحجاج عن عبد الرحمن بن زياد العراقي عن سليمان بن شعيب الكيساني عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3458","3689  -  حَدَّثَنَا  حُسَيْنُ بْنُ نَصْرٍ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  سَلَمَةَ ،  عَنْ  طَاؤُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  قَالَ  عُمَرُ رَضِيَ اللهُ عَنْهُ ، فَذَكَرَ مِثْلَهُ .  فَهَذَا  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا قَدْ أَنْكَرَ أَنْ يَكُونَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ نَهَى عَنِ التَّمَتُّعِ ، وَذَكَرَ عَنْهُ أَنَّهُ اسْتَحَبَّ  الْقِرَانَ  ، فَدَلَّ ذَلِكَ أَنَّ  الْمُتْعَةَ  الَّتِي تَوَعَّدَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ مَنْ فَعَلَهَا بِالْعُقُوبَةِ ، هِيَ  الْمُتْعَةُ  الْأُخْرَى  .  فَإِنْ قَالَ قَائِلٌ : رُوِيَ عَنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ أَنَّهُ أَمَرَ بِإِفْرَادِ  الْحَجِّ  ، وَذَكَرَ فِي ذَلِكَ مَا","","Sharh Ma'ani al-Athar 3689","","عمر بن الخطاب عن عبد الله بن عباس عن طاوس بن كيسان عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن الفضل بن دكين عن الحسين بن نصر بن معارك البغدادي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3459","3690  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو نُعَيْمٍ ، قَالَ :  ثَنَا  إِسْرَائِيلُ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ الْأَعْلَى ، قَالَ :  سَمِعْتُ  سُوَيْدًا يَقُولُ :  سَمِعْتُ  عُمَرَ رَضِيَ اللهُ عَنْهُ يَقُولُ : (  أَفْرِدُوا بِالْحَجِّ  )  .  قِيلَ لَهُ : لَيْسَ ذَلِكَ - عِنْدَنَا - عَلَى كَرَاهَتِهِ ، لِمَا سِوَى الْإِفْرَادِ مِنَ التَّمَتُّعِ وَالْقِرَانِ ، وَلَكِنَّهُ لِإِرَادَتِهِ مَعْنًى آخَرَ سِوَى ذَلِكَ ، قَدْ بَيَّنَهُ  عَبْدُ اللهِ بْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا .","","Sharh Ma'ani al-Athar 3690","","عمر بن الخطاب عن سويد بن غفلة المذحجي عن إبراهيم بن عبد الأعلى الجعفي مولاهم عن إسرائيل بن يونس بن أبي إسحاق عن الفضل بن دكين عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3460","3691  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  بِشْرُ بْنُ عُمَرَ ، قَالَ :  ثَنَا  مَالِكٌ . (  ح  ) .  3692  -  وَحَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ قَالَ : (  أَفْصِلُوا بَيْنَ حَجِّكُمْ وَعُمْرَتِكُمْ ، فَإِنَّهُ أَتَمُّ لِحَجِّ أَحَدِكُمْ  ، وَأَتَمُّ لِعُمْرَتِهِ أَنْ يَعْتَمِرَ فِي غَيْرِ أَشْهُرِ  الْحَجِّ  )  .","","Sharh Ma'ani al-Athar 3691","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن بشر بن عمر الزهراني عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3461","3693  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  عُقَيْلٌ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  قُلْتُ  لِسَالِمٍ  ،  لِمَ نَهَى  عُمَرُ  رَضِيَ اللهُ عَنْهُ عَنِ  الْمُتْعَةِ  ، وَقَدْ فَعَلَ ذَلِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَفَعَلَهَا النَّاسُ مَعَهُ ؟  فَقَالَ :  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ  عُمَرَ  رَضِيَ اللهُ عَنْهُ قَالَ : (  إِنَّ أَتَمَّ الْعُمْرَةِ أَنْ تُفْرِدُوهَا مِنْ أَشْهُرِ  الْحَجِّ  ، وَالْحَجُّ أَشْهُرٌ مَعْلُومَاتٌ ، فَأَخْلِصُوا فِيهِنَّ  الْحَجَّ  ، وَاعْتَمِرُوا فِيمَا سِوَاهُنَّ مِنَ الشُّهُورِ  )  .  فَأَرَادَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ بِذَلِكَ تَمَامَ الْعُمْرَةِ ، لِقَوْلِ اللهِ عَزَّ وَجَلَّ :         {      وَأَتِمُّوا الْحَجَّ وَالْعُمْرَةَ لِلهِ         }      .  وَذَلِكَ أَنَّ الْعُمْرَةَ الَّتِي يَتَمَتَّعُ فِيهَا الْمَرْءُ بِالْحَجِّ ، لَا تَتِمُّ إِلَّا بِأَنْ يُهْدِيَ صَاحِبُهَا هَدْيًا ، أَوْ يَصُومَ إِنْ لَمْ يَجِدْ         [2/148]      هَدْيًا ، وَإِنَّ الْعُمْرَةَ فِي غَيْرِ أَشْهُرِ  الْحَجِّ  تَتِمُّ بِغَيْرِ هَدْيٍ وَلَا صِيَامٍ ، فَأَرَادَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ بِالَّذِي أَمَرَ بِهِ مِنْ ذَلِكَ ، أَنْ  : يُزَارُ الْبَيْتُ فِي كُلِّ عَامٍ مَرَّتَيْنِ ، وَكَرِهَ أَنْ يَتَمَتَّعَ النَّاسُ بِالْعُمْرَةِ إِلَى  الْحَجِّ  ، فَيَلْزَمَ النَّاسُ ذَلِكَ ، فَلَا يَأْتُونَ الْبَيْتَ إِلَّا مَرَّةً وَاحِدَةً فِي السَّنَةِ .  فَأَخْبَرَ  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا ، عَنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ فِي هَذَا الْحَدِيثِ ، أَنَّهُ إِنَّمَا أَمَرَ بِإِفْرَادِ الْعُمْرَةِ مِنَ  الْحَجِّ  ؛ لِئَلَّا يَلْزَمَ النَّاسُ ذَلِكَ ، فَلَا يَأْتُونَ  الْبَيْتَ  إِلَّا مَرَّةً وَاحِدَةً فِي السَّنَةِ ، لَا لِكَرَاهَتِهِ  التَّمَتُّعَ ؛ لِأَنَّهُ لَيْسَ مِنَ السُّنَّةِ ، فَأَمَّا قَوْلُهُ : إِنَّهُ أَتَمُّ لِعُمْرَةِ أَحَدِكُمْ وَحَجَّتِهِ أَنْ يُفْرِزَ  كُلَّ وَاحِدَةٍ مِنْ صَاحِبَتِهَا ، فَإِنَّ مَا رُوِّينَا عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا عَنْهُ يَدُلُّ عَلَى خِلَافِ ذَلِكَ  .  وَقَدْ رُوِّينَا عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا مِنْ رَأْيِهِ خِلَافًا لِذَلِكَ أَيْضًا .  في طبعة عالم الكتب : ( أي ) ، والمثبت من النسخ الخطية.  كذا في طبعة عالم الكتب ، والذي في النسخ الخطية : ( لكراهية ) .  كذا في طبعة عالم الكتب ، والذي في النسخ الخطية : ( يفرد ) وأشار إلى ذلك المحقق في الحاشية.","","Sharh Ma'ani al-Athar 3693","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3462","3694  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  ثَنَا  صَدَقَةُ بْنُ يَسَارٍ وَأَبُو يَعْفُورٍ ،  سَمِعَا  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا يَقُولُ : (  لَأَنْ أَعْتَمِرَ فِي الْعَشْرِ الْأُوَلِ مِنْ ذِي الْحِجَّةِ أَحَبُّ إِلَيَّ  مِنْ أَنْ أَعْتَمِرَ فِي الْعَشْرِ الْبَوَاقِي  )  .","","Sharh Ma'ani al-Athar 3694","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن عبيد بن نسطاس الثعلبي عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3463","3695  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  سُفْيَانُ ، قَالَ :  ثَنَا  صَدَقَةُ بْنُ يَسَارٍ ،  سَمِعَ  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا يَقُولُ : (  عُمْرَةٌ فِي الْعَشْرِ الْأُوَلِ مِنْ ذِي الْحِجَّةِ أَحَبُّ إِلَيَّ مِنْ أَنْ أَعْتَمِرَ فِي الْعَشْرِ الْبَوَاقِي  ) .  فَحَدَّثْتُ بِهِ  نَافِعًا  ، فَقَالَ :  نَعَمْ ، عُمْرَةٌ فِيهَا هَدْيٌ أَوْ صِيَامٌ أَحَبُّ إِلَيْهِ مِنْ عُمْرَةٍ  لَيْسَ فِيهَا هَدْيٌ وَلَا صِيَامٌ .","","Sharh Ma'ani al-Athar 3695","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن سفيان بن عيينة عن يونس بن عبد الأعلى عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3464","3696  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  كَثِيرِ بْنِ جُمْهَانَ ، قَالَ :  ( حَجَجْنَا وَفِينَا رَجُلٌ أَعْجَمِيٌّ ، فَلَبَّى بِالْعُمْرَةِ وَالْحَجِّ ، فَعِبْنَا ذَلِكَ عَلَيْهِ .  فَسَأَلْنَا  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، فَقُلْنَا : إِنَّ رَجُلًا مِنَّا لَبَّى بِالْعُمْرَةِ وَالْحَجِّ فَمَا كَفَّارَتُهُ ؟ قَالَ :  رَجَعَ بِأَجْرَيْنِ ، وَتَرْجِعُونَ بِأَجْرٍ وَاحِدٍ  )  .","","Sharh Ma'ani al-Athar 3696","","عبد الله بن عمر بن الخطاب عن كثير بن جمهان السلمي عن عطاء بن السائب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3465","3697  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  صَدَقَةَ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا قَالَ : (  وَاللهِ لَأَنْ أَعْتَمِرَ قَبْلَ  الْحَجِّ  وَأُهْدِيَ ، أَحَبُّ إِلَيَّ  مِنْ أَنْ أَعْتَمِرَ بَعْدَ  الْحَجِّ  فِي ذِي الْحِجَّةِ  )  .  فَهَذَا  عَبْدُ اللهِ بْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا أَيْضًا ، قَدْ فَضَّلَ الْعُمْرَةَ الَّتِي فِي أَشْهُرِ  الْحَجِّ  ، عَلَى الْعُمْرَةِ الَّتِي فِي غَيْرِ أَشْهُرِ  الْحَجِّ  .  فَدَلَّ ذَلِكَ عَلَى صِحَّةِ مَا رَوَى  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا عَنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ ؛ لِأَنَّ  ابْنَ عُمَرَ  رَضِيَ اللهُ عَنْهُ لَوْ كَانَ سَمِعَ ذَلِكَ مِنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ كَمَا فِي حَدِيثِ  عُقَيْلٍ  عَنِ  الزُّهْرِيِّ  ، إِذًا لَمَا قَالَ بِخِلَافِ ذَلِكَ ؛ لِأَنَّهُ قَدْ سَمِعَ أَبَاهُ قَالَهُ بِحَضْرَةِ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَا يُنْكِرُهُ عَلَيْهِ مُنْكِرٌ ، وَلَا يَدْفَعُهُ عَنْهُ دَافِعٌ ، وَهُوَ أَيْضًا ، فَلَا يَدْفَعُهُ عَنْهُ ، وَلَا يَقُولُ لَهُ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ كَانَ فَعَلَ هَذَا .  وَلَكِنَّ الْمَحْكِيَّ فِي ذَلِكَ ، عَنْ  عُمَرَ  رَضِيَ اللهُ عَنْهُ هُوَ إِرَادَةُ  عُمَرَ  رَضِيَ اللهُ عَنْهُ أَنْ يُزَارَ  الْبَيْتُ  ، وَبَاقِي الْكَلَامِ بَعْدَ ذَلِكَ .         [2/149]      فَكَلَامُ  سَالِمٍ  ، خَلَطَهُ  الزُّهْرِيُّ  بِرِوَايَتِهِ ، فَلَمْ يَتَمَيَّزْ .  فَأَمَّا قَوْلُهُ : ( إِنَّ الْعُمْرَةَ فِي أَشْهُرِ  الْحَجِّ  لَا تَتِمُّ إِلَّا بِالْهَدْيِ لِمَنْ يَجِدُ الْهَدْيَ ، أَوْ بِالصِّيَامِ لِمَنْ لَا يَجِدُ الْهَدْيَ ) .  فَثَبَتَ بِذَلِكَ تَمَامُ الْعُمْرَةِ فِي غَيْرِ أَشْهُرِ  الْحَجِّ  إِذَا كَانَ ذَلِكَ غَيْرَ  وَاجِبٍ  فِيهَا ، وَأَوْجَبَ النُّقْصَانَ فِي الْعُمْرَةِ الَّتِي فِي أَشْهُرِ  الْحَجِّ  ، إِذَا كَانَ وَاجِبًا فِيهَا ، وَهَذَا كُلُّهُ إِذَا كَانَ  الْحَجُّ  يَتْلُوهَا .  فَإِنَّ الْحُجَّةَ عَلَى مَنْ ذَهَبَ إِلَى ذَلِكَ - عِنْدَنَا وَاللهُ أَعْلَمُ - أَنَّا رَأَيْنَا الْهَدْيَ الَّذِي يَجِبُ فِي  الْمُتْعَةِ  وَالْقِرَانِ ، يُؤْكَلُ بِاتِّفَاقِ الْمُتَقَدِّمِينَ جَمِيعًا ، وَرَأَيْنَا الْهَدْيَ الَّذِي يَجِبُ لِنُقْصَانٍ فِي الْعُمْرَةِ أَوْ فِي الْحَجَّةِ ، لَا يُؤْكَلُ مِنْهُ بِاتِّفَاقِهِمْ جَمِيعًا .  فَلَمَّا كَانَ الْهَدْيُ الْوَاجِبُ فِي  الْمُتْعَةِ  وَالْقِرَانِ يُؤْكَلُ مِنْهُ ، ثَبَتَ أَنَّهُ غَيْرُ  وَاجِبٍ  ، لِنُقْصَانٍ فِي الْعُمْرَةِ ، أَوْ فِي الْحَجَّةِ الَّتِي بَعْدَهَا ؛ لِأَنَّهُ لَوْ كَانَ لِنُقْصَانٍ لَكَانَ مِنْ أَشْكَالِ الدِّمَاءِ الْوَاجِبَةِ لِلنُّقْصَانِ ، وَلَكَانَ لَا يُؤْكَلُ مِنْهُ ، كَمَا لَا يُؤْكَلُ مِنْهَا ، وَلَكِنَّهُ دَمُ فَضْلٍ ، وَإِصَابَةُ خَيْرٍ  .","","Sharh Ma'ani al-Athar 3697","","عبد الله بن عمر بن الخطاب عن صدقة بن يسار الجزري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3466","3698  - وَقَدْ  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ، قَالَ :  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ، قَالَ :  ثَنَا  وَكِيعٌ . (  ح  ) .  3699  -  وَحَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْخَضِرُ بْنُ مُحَمَّدٍ الْحَرَّانِيُّ ، قَالَ :  أَنَا  عِيسَى بْنُ يُونُسَ وَأَبُو أُسَامَةَ ، قَالُوا جَمِيعًا :  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمٍ الْبَطِينِ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  مَرْوَانَ بْنِ الْحَكَمِ قَالَ : (  كُنَّا نَسِيرُ مَعَ عُثْمَانَ بْنِ عَفَّانَ رَضِيَ اللهُ عَنْهُ ، فَإِذَا رَجُلٌ يُلَبِّي بِالْحَجِّ وَالْعُمْرَةِ  ، فَقَالَ  عُثْمَانُ  رَضِيَ اللهُ عَنْهُ : مَنْ هَذَا ؟ ) . فَقَالُوا : عَلِيٌّ ، فَأَتَاهُ  عُثْمَانُ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ : ( أَلَمْ تَعْلَمْ أَنِّي نَهَيْتُ عَنْ هَذَا ) . فَقَالَ : بَلَى ، وَلَكِنِّي لَمْ أَكُنْ لِأَدَعَ قَوْلَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِقَوْلِكَ  .","","Sharh Ma'ani al-Athar 3698","","علي بن أبي طالب عن مروان بن الحكم بن أبي العاص عن علي بن الحسين زين العابدين عن مسلم بن عمران البطين عن الأعمش عن حماد بن أسامة القرشي عن الخضر بن محمد الجزري عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3467","3700  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  خَلَّادُ بْنُ يَحْيَى ، قَالَ :  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  بُكَيْرِ بْنِ عَطَاءٍ قَالَ :  حَدَّثَنِي  حُرَيْثُ بْنُ سُلَيْمٍ الْعُذْرِيُّ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ  أَنَّهُ لَبَّى بِهِمَا جَمِيعًا ، فَنَهَاهُ عُثْمَانُ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : أَمَا إِنَّكَ قَدْ رَأَيْتَ .  فَهَذَا  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ قَدْ أَخْبَرَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِخِلَافِ النَّهْيِ عَنْ قِرَانِ الْعُمْرَةِ وَالْحَجِّ ، وَفَعَلَ فِي ذَلِكَ خِلَافَ مَا أَمَرَ بِهِ  عُثْمَانُ  رَضِيَ اللهُ عَنْهُ ، وَأَنْكَرَ عَلَى  عُثْمَانَ  رَضِيَ اللهُ عَنْهُ مَا أَمَرَ بِهِ مِنْ ذَلِكَ ، فَدَلَّ هَذَا مِنْ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ أَنَّهُ قَدْ كَانَ عِنْدَهُ تَفْضِيلُ الْقِرَانِ عَلَى الْإِفْرَادِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَوْلَا ذَلِكَ لَمَا أَنْكَرَ عَلَى  عُثْمَانَ  رَضِيَ اللهُ عَنْهُ مَا رَأَى ، وَلَا فَضَّلَ رَأْيَهُ عَلَى رَأْيِ  عُثْمَانَ  رَضِيَ اللهُ عَنْهُ فِي ذَلِكَ ، إِذْ كَانَا كِلَاهُمَا إِنَّمَا أَمَرَا بِمَا أَمَرَا بِهِ مِنْ ذَلِكَ عَنْ شَيْءٍ وَاحِدٍ ، وَهُوَ الرَّأْيُ .  وَلَكِنْ خِلَافُهُ  لِعُثْمَانَ  رَضِيَ اللهُ عَنْهُ فِي ذَلِكَ دَلِيلٌ - عِنْدَنَا - عَلَى أَنَّهُ قَدْ عَلِمَ فَضْلَ الْقِرَانِ عَلَى مَا سِوَاهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  وَقَدْ رُوِيَ عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا أَيْضًا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ  قَرَنَ  فِي حَجَّةِ الْوَدَاعِ .","","Sharh Ma'ani al-Athar 3700","","عثمان بن عفان عن حريث العذري عن بكير بن عطاء الليثي عن سفيان الثوري عن خلاد بن يحيى الأرحبي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3468","3701  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  يَحْيَى بْنُ يَحْيَى ، قَالَ :  ثَنَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،         [2/150]      عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْبَعَ عُمَرٍ : عُمْرَةَ  الْجُحْفَةِ  ، وَعُمْرَتَهُ مِنَ الْعَامِ الْمُقْبِلِ  ، وَعُمْرَتَهُ مِنَ  الْجِعْرَانَةِ  ، وَعُمْرَتَهُ مَعَ حَجَّتِهِ ، وَحَجَّ حَجَّةً وَاحِدَةً  .  فَإِنْ قَالَ قَائِلٌ : فَكَيْفَ تَقْبَلُونَ هَذَا عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا وَقَدْ رَوَيْتُمْ عَنْهُ فِي الْفَصْلِ الْأَوَّلِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَمَتَّعَ ؟ .  قِيلَ لَهُ : قَدْ يَجُوزُ أَنْ يَكُونَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحْرَمَ فِي بَدْءِ أَمْرِهِ بِعُمْرَةٍ ، فَمَضَى فِيهَا مُتَمَتِّعًا بِهَا ، ثُمَّ أَحْرَمَ بِحَجَّةٍ قَبْلَ طَوَافِهِ ، فَكَانَ فِي بَدْءِ أَمْرِهِ مُتَمَتِّعًا ، وَفِي آخِرِهِ قَارِنًا .  فَأَخْبَرَ  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا فِي الْحَدِيثِ الْأَوَّلِ بِتَمَتُّعِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لِيَنْفِيَ قَوْلَ مَنْ كَرِهَ  الْمُتْعَةَ  ، وَأَخْبَرَ فِي هَذَا الْحَدِيثِ الثَّانِي بِقِرَانِهِ عَلَى مَا كَانَ صَارَ إِلَيْهِ أَمْرُهُ بَعْدَ إِحْرَامِهِ بِالْحَجَّةِ .  فَثَبَتَ بِذَلِكَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ كَانَ فِي حَجَّةِ الْوَدَاعِ مُتَمَتِّعًا بَعْدَ إِحْرَامِهِ بِالْعُمْرَةِ ، إِلَى أَنْ أَحْرَمَ بِالْحَجَّةِ ، فَصَارَ بِذَلِكَ قَارِنًا  .","","Sharh Ma'ani al-Athar 3701","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عمرو بن دينار الأثرم عن داود ابن النصراني عن يحيى بن يحيى الحنظلي عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3469","3702  -  وَقَدْ  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  النُّفَيْلِيُّ ، قَالَ :  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ، قَالَ :  ثَنَا  أَبُو إِسْحَاقَ ،  عَنْ  مُجَاهِدٍ قَالَ :  سُئِلَ  ابْنُ عُمَرَ : كَمِ اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ : مَرَّتَيْنِ  .  فَقَالَتْ  عَائِشَةُ رَضِيَ اللهُ عَنْهَا : لَقَدْ عَلِمَ  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدِ اعْتَمَرَ ثَلَاثًا سِوَى عُمْرَتِهِ الَّتِي قَرَنَهَا بِحَجَّتِهِ  .  فَإِنْ قَالَ قَائِلٌ : فَكَيْفَ تَقْبَلُونَ مِثْلَ هَذَا عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا ؟ وَقَدْ رَوَيْتُمْ عَنْهَا فِي أَوَّلِ هَذَا الْبَابِ مَا قَدْ رَوَيْتُمْ مِنْ إِفْرَادِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَتَمَتُّعِهِ عَلَى مَا ذَكَرْتُمْ ؟  قِيلَ لَهُ : ذَلِكَ عِنْدَنَا - وَاللهُ أَعْلَمُ - عَلَى نَظِيرِ مَا صَحَّحْنَا عَلَيْهِ حَدِيثَ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا ، فَيَكُونُ مَا عَلِمَتْ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا مِنْ أَمْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ ابْتَدَأَ فَأَحْرَمَ بِعُمْرَةٍ ، وَلَمْ يَقْرُنْهَا حِينَئِذٍ بِحَجَّةٍ ، فَمَضَى فِيهَا عَلَى أَنْ يَحُجَّ وَقْتَ  الْحَجِّ  ، فَكَانَ فِي ذَلِكَ مُتَمَتِّعًا بِهَا ، ثُمَّ أَحْرَمَ بِحَجَّةٍ مُفْرَدَةٍ فِي إِحْرَامِهِ بِهَا لَمْ يَبْتَدِئْ مَعَهَا إِحْرَامًا بِعُمْرَةٍ ، فَصَارَ بِذَلِكَ قَارِنًا لَهَا إِلَى عُمْرَتِهِ الْمُتَقَدِّمَةِ .  فَقَدْ كَانَ فِي إِحْرَامِهِ عَلَى أَشْيَاءَ مُخْتَلِفَةٍ ، كَانَ فِي أَوَّلِهِ مُتَمَتِّعًا ، ثُمَّ صَارَ مُحْرِمًا بِحَجَّةٍ أَفْرَدَهَا فِي إِحْرَامِهِ ، فَلَزِمَتْهُ مَعَ الْعُمْرَةِ الَّتِي كَانَ قَدَّمَهَا ، فَصَارَ فِي مَعْنَى الْقَارِنِ وَالْمُتَمَتِّعِ ، وَأَرَادَتْ - يَعْنِي  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا - بِذِكْرِهَا الْإِفْرَادَ ، خِلَافًا لِلَّذِينَ يَرَوْنَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَهَلَّ بِهِمَا جَمِيعًا  .","","Sharh Ma'ani al-Athar 3702","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن عبد الله بن محمد النفيلي عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3470","3703  -  وَقَدْ  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ، قَالَ :  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ، قَالَ :  ثَنَا  ابْنُ عُيَيْنَةَ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  نَافِعٍ ،  أَنَّ  ابْنَ عُمَرَ خَرَجَ مِنَ  الْمَدِينَةِ  إِلَى  مَكَّةَ  مُهِلًّا بِالْعُمْرَةِ ، مَخَافَةَ الْحَصْرِ  ، ثُمَّ قَالَ : مَا شَأْنُهُمَا إِلَّا وَاحِدًا ، أُشْهِدُكُمْ أَنِّي قَدْ أَوْجَبْتُ إِلَى عُمْرَتِي هَذِهِ حَجَّةً .  ثُمَّ قَدِمَ فَطَافَ لَهُمَا طَوَافًا وَاحِدًا  ، وَقَالَ : هَكَذَا فَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Sharh Ma'ani al-Athar 3703","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب بن موسى الأموي عن سفيان بن عيينة عن يعقوب بن حميد بن كاسب المدني عن أحمد بن داود بن موسى السدوسي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3471","[2/151]      3704  -  وَقَدْ  حَدَّثَنَا  أَحْمَدُ - هُوَ ابْنُ دَاوُدَ بْنِ مُوسَى - قَالَ :  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدِ بْنِ كَاسِبٍ ، قَالَ :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  أَنَّ  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا أَرَادَ  الْحَجَّ  عَامَ نَزَلَ  الْحَجَّاجُ  بِابْنِ الزُّبَيْرِ  ، فَأَحْرَمَ بِعُمْرَةٍ  ، فَقِيلَ لَهُ : إِنَّ النَّاسَ كَائِنٌ بَيْنَهُمْ قِتَالٌ ، وَإِنَّا نَخَافُ أَنْ نُصَدَّ عَنِ  الْبَيْتِ  . فَقَالَ :         {      لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ         }      إِذًا أَصْنَعُ كَمَا صَنَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أُشْهِدُكُمْ أَنِّي قَدْ أَوْجَبْتُ عُمْرَةً ، ثُمَّ خَرَجَ حَتَّى إِذَا كَانَ بِظَهْرِ  الْبَيْدَاءِ  قَالَ : مَا  شَأْنُ  الْحَجِّ  وَالْعُمْرَةِ إِلَّا وَاحِدًا ، أُشْهِدُكُمْ أَنِّي قَدْ أَوْجَبْتُ حَجًّا مَعَ عُمْرَتِي ، فَانْطَلَقَ يُهِلُّ بِهِمَا جَمِيعًا حَتَّى قَدِمَ  مَكَّةَ  ، فَطَافَ  بِالْبَيْتِ  ، وَبَيْنَ  الصَّفَا  وَالْمَرْوَةِ  وَلَمْ يَزِدْ عَلَى ذَلِكَ ، وَلَمْ يَنْحَرْ ، وَلَمْ يَحْلِقْ ، وَلَمْ يَحِلَّ مِنْ شَيْءٍ حَرُمَ عَلَيْهِ حَتَّى يَوْمِ النَّحْرِ ، فَحَلَقَ وَرَأَى أَنْ قَدْ قَضَى طَوَافَ  الْحَجِّ  بِطَوَافِهِ ذَلِكَ الْأَوَّلِ ، ثُمَّ قَالَ : هَكَذَا صَنَعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Sharh Ma'ani al-Athar 3704","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن عبد العزيز بن محمد الدراوردي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن داود بن موسى السدوسي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3472","3705  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  شُعَيْبُ بْنُ اللَّيْثِ ،  عَنِ  اللَّيْثِ  عَنْ  نَافِعٍ ،  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا أَرَادَ  الْحَجَّ  عَامَ نَزَلَ  الْحَجَّاجُ  بِابْنِ الزُّبَيْرِ  .  فَقِيلَ لَهُ : إِنَّ النَّاسَ كَائِنٌ بَيْنَهُمْ قِتَالٌ ، وَإِنَّا نَخَافُ أَنْ  يَصُدُّوكَ  عَنِ  الْبَيْتِ  . فَقَالَ :         {      لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللهِ أُسْوَةٌ حَسَنَةٌ         }      إِذًا أَصْنَعُ كَمَا صَنَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِنِّي أُشْهِدُكُمْ أَنِّي قَدْ أَوْجَبْتُ حَجًّا مَعَ عُمْرَتِي ، ثُمَّ خَرَجَ ، حَتَّى إِذَا كَانَ بِظَهْرِ  الْبَيْدَاءِ  قَالَ : مَا  شَأْنُ  الْحَجِّ  وَالْعُمْرَةِ إِلَّا وَاحِدًا ، أُشْهِدُكُمْ أَنِّي قَدْ أَوْجَبْتُ حَجًّا مَعَ عُمْرَتِي ، وَأَهْدَى هَدْيًا اشْتَرَاهُ بِقُدَيْدٍ .  فَانْطَلَقَ يُهِلُّ بِهِمَا جَمِيعًا ، حَتَّى قَدِمَ  مَكَّةَ  ، فَطَافَ  بِالْبَيْتِ  وَبَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، وَلَمْ يَزِدْ عَلَى ذَلِكَ ، وَلَمْ يَنْحَرْ ، وَلَمْ يَحْلِقْ ، وَلَمْ يُقَصِّرْ ، وَلَمْ يَحِلَّ مِنْ شَيْءٍ حَرُمَ عَلَيْهِ ، حَتَّى كَانَ يَوْمُ النَّحْرِ ، فَنَحَرَ ، وَحَلَقَ وَرَأَى أَنْ قَدْ قَضَى طَوَافَ  الْحَجِّ  وَالْعُمْرَةِ بِطَوَافِهِ الْأَوَّلِ ، وَكَذَلِكَ فَعَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  فَإِنْ قَالَ قَائِلٌ : فَكَيْفَ تَقْبَلُونَ مِثْلَ هَذَا ، عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا ، وَقَدْ رَوَيْتُمْ عَنْهُ فِيمَا تَقَدَّمَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَمَتَّعَ ؟         [2/152]      فَجَوَابُنَا لَهُ فِي ذَلِكَ مِثْلُ جَوَابِنَا لَهُ فِي حَدِيثِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا  وَعَائِشَةَ  رَضِيَ اللهُ عَنْهَا  .","","Sharh Ma'ani al-Athar 3705","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الليث بن سعد عن شعيب بن الليث المصري عن الربيع بن سليمان المرادي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3473","3706  -  وَقَدْ  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحِمَّانِيُّ ، قَالَ :  ثَنَا  عَبْدُ السَّلَامِ بْنُ حَرْبٍ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ ،  عَنْ  عِمْرَانَ بْنِ الْحُصَيْنِ  أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُلَبِّي بِعُمْرَةٍ وَحَجَّةٍ  .  فَإِنْ قَالَ قَائِلٌ : فَقَدْ رَوَيْتُمْ عَنْ  عِمْرَانَ  أَيْضًا فِيمَا تَقَدَّمَ فِي هَذَا الْبَابِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَمَتَّعَ ، فَكَيْفَ تَقْبَلُونَ عَنْهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَرَنَ ؟  فَجَوَابُنَا لَهُ فِي ذَلِكَ مِثْلُ جَوَابِنَا فِي حَدِيثِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا .","","Sharh Ma'ani al-Athar 3706","","عمران بن حصين بن عبيد بن خلف الخزاعي عن مطرف بن عبد الله بن الشخير الحرشي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد السلام بن حرب الملائي عن يحيى بن عبد الحميد عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3474","3707  -  وَقَدْ  حَدَّثَنَا  نَصْرُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ لَبَّى بِعُمْرَةٍ وَحَجَّةٍ ، وَقَالَ : لَبَّيْكَ بِعُمْرَةٍ وَحَجَّةٍ  .  فَذَكَرَ بَكْرُ بْنُ عَبْدِ اللهِ الْمُزَنِيُّ لِابْنِ عُمَرَ قَوْلَ  أَنَسٍ  رَضِيَ اللهُ عَنْهُ ، قَالَ : دَهَلَ  أَنَسٌ  ، إِنَّمَا أَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْحَجِّ ، وَأَهْلَلْنَا بِهِ مَعَهُ ، فَلَمَّا قَدِمْنَا  مَكَّةَ  قَالَ : مَنْ لَمْ يَكُنْ مَعَهُ هَدْيٌ فَلْيُحِلَّ .  قَالَ  بَكْرٌ  : فَرَجَعْتُ إِلَى  أَنَسٍ  رَضِيَ اللهُ عَنْهُ ، فَأَخْبَرْتُهُ بِقَوْلِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا ، فَلَمْ يَزَلْ يَذْكُرُ ذَلِكَ حَتَّى مَاتَ .","","Sharh Ma'ani al-Athar 3707","","أنس بن مالك عن حميد الطويل عن إسماعيل بن جعفر بن أبي كثير الزرقي عن علي بن معبد العبدي عن نصر بن مرزوق المصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3475","3708  -  حَدَّثَنَا  حُسَيْنُ بْنُ نَصْرٍ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ، قَالَ :  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ، قَالَ :  ثَنَا  حُمَيْدٌ ، قَالَ :  وَحَدَّثَنِي  بَكْرُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، مِثْلَهُ . قَالَ  بَكْرٌ  : فَذَكَرْتُ ذَلِكَ لِابْنِ عُمَرَ ، فَقَالَ :  ذَهَلَ  أَنَسٌ  رَضِيَ اللهُ عَنْهُ ،  إِنَّمَا أَهَلَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْحَجِّ  ، وَأَهْلَلْنَا بِهِ  .","","Sharh Ma'ani al-Athar 3708","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن حميد الطويل عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن الحسين بن نصر بن معارك البغدادي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3476","3709  -  حَدَّثَنَا  حُسَيْنٌ - هُوَ ابْنُ نَصْرٍ - قَالَ :  سَمِعْتُ  يَزِيدَ بْنَ هَارُونَ ، قَالَ :  أَنَا  حُمَيْدٌ ، فَذَكَرَ مِثْلَهُ  بِإِسْنَادِهِ  ، وَزَادَ :  فَلَمَّا قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ لَمْ يَكُنْ مَعَهُ هَدْيٌ فَلْيُحِلَّ  ، وَكَانَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ هَدْيٌ ، فَلَمْ يُحِلَّ  .","","Sharh Ma'ani al-Athar 3709","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن حميد الطويل عن يزيد بن هارون عن الحسين بن نصر بن معارك البغدادي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3477","3710  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  حُمَيْدٍ ،  عَنْ  بَكْرٍ قَالَ :  أَخْبَرْتُ  ابْنَ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا بِقَوْلِ  أَنَسٍ  رَضِيَ اللهُ عَنْهُ ، فَقَالَ : ( نَسِيَ  أَنَسٌ  رَضِيَ اللهُ عَنْهُ ) .  فَلَمَّا رَجَعَ قَالَ  بَكْرٌ  لِأَنَسٍ : إِنَّ  ابْنَ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا يَقُولُ : نَسِيَ ، فَقَالَ : أَنْ تَعْدُونَا  إِلَّا صِبْيَانًا ، بَلْ سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَبَّيْكَ بِعُمْرَةٍ وَحَجَّةٍ مَعًا  .  أَفَلَا تَرَى أَنَّ  ابْنَ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا إِنَّمَا أَنْكَرَ عَلَى  أَنَسٍ  رَضِيَ اللهُ عَنْهُ قَوْلَهُ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَهَلَّ بِهِمَا جَمِيعًا ؟  وَإِنَّمَا كَانَ الْأَمْرُ عِنْدَ  ابْنِ عُمَرَ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَهَلَّ بِحَجَّةٍ ، ثُمَّ صَيَّرَهَا عُمْرَةً بَعْدَ ذَلِكَ ، وَأَضَافَ إِلَيْهَا حَجَّةً ، فَصَارَ حِينَئِذٍ قَارِنًا .  فَأَمَّا فِي بَدْءِ إِحْرَامِهِ ، فَإِنَّهُ كَانَ - عِنْدَهُ - مُفْرِدًا  ، ثُمَّ قَدْ تَوَاتَرَتِ الرِّوَايَاتُ بَعْدَ ذَلِكَ عَنْ  أَنَسٍ  رَضِيَ اللهُ عَنْهُ بِدُخُولِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيهِمَا جَمِيعًا .  في طبعة عالم الكتب : ( يعذونا ) والمثبت من النسخ الخطية ، وينظر مصادر التخريج.","","Sharh Ma'ani al-Athar 3710","","أنس بن مالك عن بكر بن عبد الله المزني عن حميد الطويل عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3478","[2/153]      3711  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  حِبَّانُ ، قَالَ :  ثَنَا  وُهَيْبٌ ، قَالَ :  ثَنَا  أَيُّوبُ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ [عَنْهُ] ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لَمَّا اسْتَوَتْ بِهِ رَاحِلَتُهُ عَلَى  الْبَيْدَاءِ  جَمَعَ بَيْنَهُمَا  .","","Sharh Ma'ani al-Athar 3711","","أنس بن مالك عن أبو قلابة الجرمي عن أيوب السختياني عن وهيب بن خالد الكرابيسي عن حبان بن هلال الباهلي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3479","3712  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ بَكْرٍ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ . (  ح  ) .  3713  -  وَحَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عَبْدُ الصَّمَدِ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي قَزَعَةَ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ قَالَ : سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَبَّيْكَ بِعُمْرَةٍ وَحَجَّةٍ  .","","Sharh Ma'ani al-Athar 3712","","أنس بن مالك عن سويد بن حجير الباهلي عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3480","3714  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ، قَالَ :  ثَنَا  أَبُو شِهَابٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3714","","أنس بن مالك عن ثابت البناني عن محمد بن عبد الرحمن بن أبي ليلى عن عبد ربه بن نافع الحناط عن أحمد بن عبد الله اليربوعي عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3481","3715  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3715","","أنس بن مالك عن حميد الطويل عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3482","3716  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  عَمْرُو بْنُ خَالِدٍ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو - هُوَ الرَّقِّيُّ -  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ وَحُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ ، قَالَ :  كُنْتُ رَدِيفَ  أَبِي طَلْحَةَ  ، وَرُكْبَتِي تَمَسُّ رُكْبَةَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَلَمْ يَزَالُوا يَصْرُخُونَ بِهِمَا جَمِيعًا بِالْحَجِّ وَالْعُمْرَةِ .","","Sharh Ma'ani al-Athar 3716","","أنس بن مالك عن حميد بن هلال العدوي عن أيوب السختياني عن عبيد الله بن عمرو بن أبي الوليد عن عمرو بن خالد بن فروخ عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3483","3717  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  يَحْيَى بْنِ أَبِي إِسْحَاقَ ، قَالَ :  سَمِعْتُ  أَنَسًا يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَبَّيْكَ بِعُمْرَةٍ وَبِحَجَّةٍ مَعًا  .","","Sharh Ma'ani al-Athar 3717","","أنس بن مالك عن يحيى بن أبي إسحاق الحضرمي عن سفيان الثوري عن أبو عاصم النبيل عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3484","3718  -  حَدَّثَنَا  أَبُو أُمَيَّةَ ، قَالَ :  ثَنَا  عَمْرُو بْنُ عَاصِمٍ الْكِلَابِيُّ . (  ح  ) .  3719  -  وَحَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ الْكَيْسَانِيُّ ، قَالَ :  ثَنَا  الْخَصِيبُ ، قَالَا :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ قَالَ :  اعْتَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عُمْرَةً مِنَ  الْجُحْفَةِ  ، وَعُمْرَةً مِنَ الْعَامِ الْمُقْبِلِ ، وَعُمْرَةً مِنَ  الْجِعْرَانَةِ  ، وَعُمْرَةً حَيْثُ قَسَمَ غَنَائِمَ  حُنَيْنٍ  ، وَعُمْرَةً مَعَ حَجَّتِهِ ، وَحَجَّ حَجَّةً وَاحِدَةً  .","","Sharh Ma'ani al-Athar 3718","","أنس بن مالك عن قتادة بن دعامة عن همام بن يحيى بن دينار عن الخصيب بن ناصح الحارثي عن سليمان بن شعيب الكيساني عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3485","3720  -  حَدَّثَنَا  أَبُو أُمَيَّةَ ، قَالَ :  ثَنَا  الْحَسَنُ بْنُ مُوسَى وَابْنُ نُفَيْلٍ قَالَا :  ثَنَا  أَبُو خَيْثَمَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي أَسْمَاءَ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ قَالَ :  خَرَجْنَا نَصْرُخُ بِالْحَجَّةِ ، فَلَمَّا قَدِمْنَا  مَكَّةَ  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَجْعَلَهَا عُمْرَةً وَقَالَ :  لَوِ  اسْتَقْبَلْتُ  مِنْ أَمْرِي مَا اسْتَدْبَرْتُ ، لَجَعَلْتُهَا عُمْرَةً  ، وَلَكِنِّي سُقْتُ الْهَدْيَ ، وَقَرَنْتُ  الْحَجَّ  وَالْعُمْرَةَ .         [2/154]      قَالَ أَبُو جَعْفَرٍ :  فَفِي هَذَا الْحَدِيثِ مِنْ قَوْلِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ  قَرَنَ  الْحَجَّ  وَالْعُمْرَةَ ، فَقَدْ دَلَّ ذَلِكَ عَلَى صِحَّةِ قَوْلِ مَنْ أَخْبَرَ مَنْ فَعَلَهُ بِمَا يُوَافِقُ ذَلِكَ  .","","Sharh Ma'ani al-Athar 3720","","أنس بن مالك عن أبو أسماء الصيقل عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن عبد الله بن محمد النفيلي عن محمد بن إبراهيم بن مسلم السجستاني عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3486","3721  -  وَقَدْ  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ . (  ح  ) .  3722  -  وَحَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  شُعَيْبٌ ، قَالَا :  ثَنَا  اللَّيْثُ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَسْلَمَ أَبِي عِمْرَانَ ، أَنَّهُ قَالَ :  حَجَجْتُ مَعَ مَوَالِيَّ فَدَخَلْتُ عَلَى أُمِّ سَلَمَةَ رَضِيَ اللهُ عَنْهَا ،  فَسَمِعْتُهَا  تَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَهِلُّوا ، يَا  آلَ مُحَمَّدٍ  ، بِعُمْرَةٍ فِي حَجَّةٍ  .  وَهَذَا أَيْضًا مِثْلُ ذَلِكَ  .","","Sharh Ma'ani al-Athar 3721","","هند بنت أبي أمية زوج رسول الله عن أسلم بن يزيد التجيبي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن شعيب بن الليث المصري عن الربيع بن سليمان المرادي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3487","3723  -  وَقَدْ  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحِمَّانِيُّ ، قَالَ :  ثَنَا  أَبُو خَالِدٍ ، وَأَبُو مُعَاوِيَةَ . (  ح  ) .  3724  -  وَحَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  عُمَرُ بْنُ حَفْصٍ ، قَالَ :  ثَنَا  أُبَيٌّ  ، قَالُوا جَمِيعًا :  عَنِ  الْحَجَّاجِ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  عَنْ  أَبِي طَلْحَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  قَرَنَ  بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  .","","Sharh Ma'ani al-Athar 3723","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن الحسن بن سعد مولى علي بن أبي طالب عن حجاج بن أرطاة عن حفص بن غياث النخعي عن عمر بن حفص بن غياث عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3488","3725  -  حَدَّثَنَا  أَبُو بَكْرَةَ وَعَلِيُّ بْنُ مَعْبَدٍ ، قَالَا :  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  دَاوُدُ بْنُ يَزِيدَ الْأَوْدِيُّ ، قَالَ :  سَمِعْتُ  عَبْدَ الْمَلِكِ بْنَ مَيْسَرَةَ الزَّرَّادَ ، قَالَ :  سَمِعْتُ  النَّزَّالَ بْنَ سَبْرَةَ يَقُولُ :  سَمِعْتُ  سُرَاقَةَ بْنَ مَالِكِ بْنِ جُعْشُمٍ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  دَخَلَتِ  الْعُمْرَةُ فِي  الْحَجِّ  إِلَى يَوْمِ الْقِيَامَةِ  . قَالَ : وَقَرَنَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّةِ الْوَدَاعِ  .  فَقَدِ اخْتَلَفُوا عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي إِحْرَامِهِ فِي حَجَّةِ الْوَدَاعِ مَا كَانَ ، فَقَالُوا : مَا رَوَيْنَا ، وَتَنَازَعُوا فِي ذَلِكَ عَلَى مَا قَدْ ذَكَرْنَا . وَقَدْ أَحَاطَ عِلْمُنَا أَنَّهُ لَمْ يَكُنْ إِلَّا عَلَى أَحَدِ تِلْكَ الْمَنَازِلِ الثَّلَاثَةِ : إِمَّا مُتَمَتِّعٌ ، وَإِمَّا مُفْرِدٌ ، وَإِمَّا قَارِنٌ . فَأَوْلَى بِنَا أَنْ نَنْظُرَ إِلَى مَعَانِي هَذِهِ الْآثَارِ وَنَكْشِفَهَا ، لِنَعْلَمَ مِنْ أَيْنَ جَاءَ اخْتِلَافُهُمْ فِيهَا ، وَنَقِفَ مِنْ ذَلِكَ عَلَى إِحْرَامِهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَا كَانَ . فَاعْتَبَرْنَا ذَلِكَ ، فَوَجَدْنَا الَّذِينَ يَقُولُونَ : إِنَّهُ أَفْرَدَ يَقُولُونَ : كَانَ إِحْرَامُهُ بِالْحَجِّ مُفْرِدًا ، لَمْ يَكُنْ مِنْهُ قَبْلَ ذَلِكَ إِحْرَامٌ بِغَيْرِهِ .  وَقَالَ آخَرُونَ : بَلْ قَدْ كَانَ قَبْلَ إِحْرَامِهِ بِتِلْكَ الْحَجَّةِ أَحْرَمَ بِعُمْرَةٍ ، ثُمَّ أَضَافَ إِلَيْهَا هَذِهِ الْحَجَّةَ ، هَكَذَا يَقُولُ الَّذِينَ قَالُوا :  قَرَنَ  .  وَقَدْ أَخْبَرَ  جَابِرٌ  رَضِيَ اللهُ عَنْهُ فِي حَدِيثِهِ ، وَهُوَ أَحَدُ الَّذِينَ قَالُوا : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَفْرَدَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحْرَمَ بِالْحَجَّةِ حِينَ اسْتَوَتْ بِهِ نَاقَتُهُ عَلَى  الْبَيْدَاءِ  .  وَقَالَ  ابْنُ عُمَرَ  : مِنْ عِنْدِ الْمَسْجِدِ ، وَهُوَ أَيْضًا مِمَّنْ قَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَفْرَدَ بِالْحَجِّ فِي أَوَّلِ إِحْرَامِهِ .  فَكَانَ بَدْءُ إِحْرَامِهِ عَلَيْهِ السَّلَامُ عِنْدَ  ابْنِ عُمَرَ  ،  وَجَابِرٍ  رَضِيَ اللهُ عَنْهُمْ بَعْدَ خُرُوجِهِ مِنَ الْمَسْجِدِ .  وَقَدْ بَيَّنَّا عَنْهُ فِيمَا تَقَدَّمَ مِنْ كِتَابِنَا هَذَا أَنَّهُ قَدْ كَانَ أَحْرَمَ فِي دُبُرِ الصَّلَاةِ فِي الْمَسْجِدِ .         [2/155]      فَيُحْتَمَلُ أَنْ يَكُونَ الَّذِينَ قَالُوا : إِنَّهُ  قَرَنَ ،  سَمِعُوا تَلْبِيَتَهُ فِي الْمَسْجِدِ بِالْعُمْرَةِ ، ثُمَّ سَمِعُوا بَعْدَ ذَلِكَ تَلْبِيَتَهُ الْأُخْرَى ، خَارِجًا مِنَ الْمَسْجِدِ بِالْحَجِّ خَاصَّةً .  فَعَلِمُوا أَنَّهُ  قَرَنَ ،  وَسَمِعَهُ الَّذِينَ قَالُوا : إِنَّهُ أَفْرَدَ وَقَدْ لَبَّى بِالْحَجِّ خَاصَّةً ، وَلَمْ يَكُونُوا سَمِعُوا تَلْبِيَتَهُ قَبْلَ ذَلِكَ بِالْعُمْرَةِ ، فَقَالُوا : أَفْرَدَ ، وَسَمِعَهُ قَوْمٌ أَيْضًا وَقَدْ لَبَّى فِي الْمَسْجِدِ بِالْعُمْرَةِ ، وَلَمْ يَسْمَعُوا تَلْبِيَتَهُ بَعْدَ خُرُوجِهِ مِنْهُ بِالْحَجِّ ، ثُمَّ رَأَوْهُ بَعْدَ ذَلِكَ يَفْعَلُ مَا يَفْعَلُ الْحَاجُّ مِنَ الْوُقُوفِ بِعَرَفَةَ وَمَا أَشْبَهَ ذَلِكَ ، وَكَانَ ذَلِكَ - عِنْدَهُمْ - بَعْدَ خُرُوجِهِ مِنَ الْعُمْرَةِ ، فَقَالُوا : تَمَتَّعَ ، فَرَوَى كُلُّ قَوْمٍ مَا عَلِمُوا .  وَقَدْ دَخَلَ جَمِيعُ مَا عَلِمَهُ الَّذِينَ قَالُوا : أَفْرَدَ ، وَمَا عَلِمَهُ الَّذِينَ قَالُوا : إِنَّهُ تَمَتَّعَ فِيمَا عَلِمَ الَّذِينَ قَالُوا : إِنَّهُ  قَرَنَ  ؛ لِأَنَّهُمْ أَخْبَرُوا عَنْ تَلْبِيَتِهِ بِالْعُمْرَةِ ، ثُمَّ عَنْ تَلْبِيَتِهِ بِالْحَجَّةِ بِعَقِبِ ذَلِكَ .  فَصَارَ مَا ذَهَبُوا إِلَيْهِ مِنْ ذَلِكَ وَمَا رَوَوْا أَوْلَى مِمَّا ذَهَبَ إِلَيْهِ مَنْ خَالَفَهُمْ وَمَا رَوَوْا ، ثُمَّ قَدْ وَجَدْنَا بَعْدَ ذَلِكَ أَفْعَالَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَدُلُّ عَلَى أَنَّهُ كَانَ قَارِنًا ، وَذَلِكَ أَنَّهُ عَلَيْهِ السَّلَامُ لَا يَخْتَلِفُ عَنْهُ أَنَّهُ لَمَّا قَدِمَ  مَكَّةَ  أَمَرَ أَصْحَابَهُ أَنْ يُحِلُّوا إِلَّا مَنْ كَانَ سَاقَ مِنْهُمْ هَدْيًا ، وَثَبَتَ هُوَ عَلَى إِحْرَامِهِ ، فَلَمْ يُحِلَّ مِنْهُ إِلَّا فِي وَقْتِ مَا يُحِلُّ الْحَاجُّ مِنْ حَجِّهِ . وَقَالَ : لَوِ  اسْتَقْبَلْتُ  مِنْ أَمْرِي مَا اسْتَدْبَرْتُ مَا سُقْتُ الْهَدْيَ وَلَجَعَلْتُهَا عُمْرَةً ، فَمَنْ كَانَ لَيْسَ مَعَهُ هَدْيٌ فَلْيُحِلَّ ، وَلْيَجْعَلْهَا عُمْرَةً . هَكَذَا حَكَاهُ عَنْهُ  جَابِرُ بْنُ عَبْدِ اللهِ  ، وَهُوَ مِمَّنْ يَقُولُ : إِنَّهُ أَفْرَدَ ، وَسَنَذْكُرُ ذَلِكَ وَمَا رُوِيَ فِيهِ فِي بَابِ  فَسْخِ  الْحَجِّ  إِنْ شَاءَ اللهُ تَعَالَى ، فَلَوْ كَانَ إِحْرَامُهُ ذَلِكَ كَانَ بِحَجَّةٍ لَكَانَ هَدْيُهُ الَّذِي سَاقَهُ تَطَوُّعًا ، فَهَدْيُ التَّطَوُّعِ لَا يَمْنَعُ مِنَ الْإِحْلَالِ الَّذِي يُحِلُّهُ الرَّجُلُ إِذَا لَمْ يَكُنْ مَعَهُ هَدْيٌ ، وَلَكَانَ حُكْمُهُ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَإِنْ كَانَ قَدْ سَاقَ هَدْيًا - كَحُكْمِ مَنْ لَمْ يَسُقْ هَدْيًا ؛ لِأَنَّهُ لَمْ يَخْرُجْ عَلَى أَنْ يَتَمَتَّعَ ، فَيَكُونَ ذَلِكَ الْهَدْيُ لِلْمُتْعَةِ ، فَتَمْنَعَهُ مِنَ الْإِحْلَالِ الَّذِي كَانَ يُحِلُّهُ لَوْ لَمْ يَسُقْ هَدْيًا .  أَلَا تَرَى أَنَّ رَجُلًا لَوْ خَرَجَ يُرِيدُ التَّمَتُّعَ فَأَحْرَمَ بِعُمْرَةٍ ، أَنَّهُ إِذَا طَافَ لَهَا ، وَسَعَى ، وَحَلَقَ ،  حَلَّ  مِنْهَا ، وَلَوْ كَانَ سَاقَ هَدْيًا لِمُتْعَتِهِ لَمْ يُحِلَّ حَتَّى يَوْمِ النَّحْرِ ، وَلَوْ سَاقَ هَدْيًا تَطَوُّعًا  حَلَّ  قَبْلَ يَوْمِ النَّحْرِ بَعْدَ فَرَاغِهِ مِنَ الْعُمْرَةِ .  فَثَبَتَ بِذَلِكَ أَنَّ هَدْيَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا كَانَ قَدْ مَنَعَهُ مِنَ الْإِحْلَالِ ، وَأَوْجَبَ ثُبُوتَهُ عَلَى الْإِحْرَامِ إِلَى يَوْمِ النَّحْرِ ، أَنَّ حُكْمَهُ غَيْرُ حُكْمِ هَدْيِ التَّطَوُّعِ ، فَانْتَفَى بِذَلِكَ قَوْلُ مَنْ قَالَ : إِنَّهُ كَانَ مُفْرِدًا .  وَقَدْ ذَكَرْنَا فِيمَا تَقَدَّمَ مِنْ هَذَا الْبَابِ عَنْ  حَفْصَةَ  ،  أَنَّهَا قَالَتْ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا  شَأْنُ  النَّاسِ حَلُّوا ، وَلَمْ تَحِلَّ أَنْتَ مِنْ عُمْرَتِكَ ؟  فَقَالَ : إِنِّي قَلَّدْتُ هَدْيِي  وَلَبَّدْتُ  رَأْسِي ، فَلَا  أَحِلُّ  حَتَّى أَنْحَرَ  .  فَدَلَّ ذَلِكَ عَلَى مَا ذَكَرْنَا ، وَعَلَى أَنَّ ذَلِكَ الْهَدْيَ كَانَ هَدْيًا بِسَبَبِ عُمْرَةٍ يُرَادُ بِهَا قِرَانٌ أَوْ مُتْعَةٌ .         [2/156]      فَنَظَرْنَا فِي ذَلِكَ ، فَإِذَا  حَفْصَةُ  رَضِيَ اللهُ عَنْهَا قَدْ دَلَّ حَدِيثُهَا هَذَا عَلَى أَنَّ ذَلِكَ الْقَوْلَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ بِمَكَّةَ ؛ لِأَنَّهُ كَانَ مِنْهُ بَعْدَ مَا  حَلَّ  النَّاسُ .  وَقَدْ يَجُوزُ أَنْ يَكُونَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ طَافَ قَبْلَ ذَلِكَ أَوْ لَمْ يَطُفْ.  فَإِنْ كَانَ قَدْ طَافَ قَبْلَ ذَلِكَ ، ثُمَّ أَحْرَمَ بِالْحَجَّةِ مِنْ بَعْدُ ، فَإِنَّمَا كَانَ مُتَمَتِّعًا ، وَلَمْ يَكُنْ قَارِنًا ؛ لِأَنَّهُ إِنَّمَا أَحْرَمَ بِالْحَجَّةِ بَعْدَ فَرَاغِهِ مِنْ طَوَافِ الْعُمْرَةِ .  وَإِنْ لَمْ يَكُنْ طَافَ قَبْلَ ذَلِكَ حَتَّى أَحْرَمَ بِالْحَجَّةِ ، فَقَدْ كَانَ قَارِنًا ؛ لِأَنَّهُ قَدْ لَزِمَتْهُ الْحَجَّةُ قَبْلَ طَوَافِهِ لِلْعُمْرَةِ .  فَلَمَّا احْتَمَلَ ذَلِكَ مَا ذَكَرْنَا ، كَانَ أَوْلَى الْأَشْيَاءِ بِنَا أَنْ نَحْمِلَ هَذِهِ الْآثَارَ عَلَى مَا فِيهِ اتِّفَاقُهَا ، لَا عَلَى مَا فِيهِ تَضَادُّهَا .  فَكَانَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  وَابْنُ عَبَّاسٍ  وَعِمْرَانُ بْنُ حُصَيْنٍ  ،  وَعَائِشَةُ  رَضِيَ اللهُ عَنْهُمْ ، قَدْ رَوَيْنَا عَنْهُمْ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَمَتَّعَ ، وَرَوَيْنَا عَنْهُمْ أَنَّهُ  قَرَنَ ،  وَقَدْ ثَبَتَ مِنْ قَوْلِهِ مَا يَدُلُّ عَلَى أَنَّهُ قَدِمَ  مَكَّةَ  ، وَلَمْ يَكُنْ أَحْرَمَ بِالْحَجِّ قَبْلَ ذَلِكَ ، فَإِنْ جَعَلْنَا إِحْرَامَهُ بِالْحَجَّةِ ، كَانَ قَبْلَ الطَّوَافِ لِلْعُمْرَةِ ، ثَبَتَ الْحَدِيثَانِ جَمِيعًا ، فَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ كَانَ مُتَمَتِّعًا إِلَى أَنْ أَحْرَمَ بِالْحَجَّةِ ، فَصَارَ قَارِنًا .  وَإِنْ جَعَلْنَا إِحْرَامَهُ بِالْحَجَّةِ ، كَانَ بَعْدَ طَوَافِهِ لِلْعُمْرَةِ ، جَعَلْنَاهُ مُتَمَتِّعًا ، وَنَفَيْنَا أَنْ يَكُونَ قَارِنًا ، فَجَعَلْنَاهُ مُتَمَتِّعًا فِي حَالٍ ، وَقَارِنًا فِي حَالٍ .  فَثَبَتَ بِذَلِكَ أَنَّ طَوَافَهُ لِلْعُمْرَةِ كَانَ بَعْدَ إِحْرَامِهِ بِالْحَجَّةِ ، فَثَبَتَ بِذَلِكَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ كَانَ فِي حَجَّةِ الْوَدَاعِ قَارِنًا .  فَقَالَ قَائِلٌ : مِمَّنْ كَرِهَ الْقِرَانَ وَالتَّمَتُّعَ لِمَنِ اسْتَحَبَّهُمَا : اعْتَلَلْتُمْ عَلَيْنَا بِقَوْلِ اللهِ عَزَّ وَجَلَّ :         {      فَمَنْ تَمَتَّعَ بِالْعُمْرَةِ إِلَى الْحَجِّ فَمَا اسْتَيْسَرَ مِنَ الْهَدْيِ         }      فِي إِبَاحَةِ  الْمُتْعَةِ  ، وَلَيْسَ ذَلِكَ كَذَلِكَ ، وَإِنَّمَا تَأْوِيلُ هَذِهِ الْآيَةِ ، مَا رُوِيَ عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  .  فَذَكَرَ مَا .","","Sharh Ma'ani al-Athar 3725","","سراقة بن مالك المدلجي عن النزال بن سبرة الهلالي عن عبد الملك بن ميسرة الهلالي عن داود بن يزيد الزعافري عن مكي بن إبراهيم عن علي بن معبد بن نوح البغدادي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3489","3726  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَجَّاجِ وَنَصْرُ بْنُ مَرْزُوقٍ ، قَالَا :  ثَنَا  الْخَصِيبُ بْنُ نَاصِحٍ ، قَالَ :  ثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  عَنْ  إِسْحَاقَ بْنِ سُوَيْدٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ وَهُوَ يَخْطُبُ يَقُولُ : (  يَا أَيُّهَا النَّاسُ ، أَلَا إِنَّهُ وَاللهِ مَا التَّمَتُّعُ بِالْعُمْرَةِ إِلَى  الْحَجِّ  كَمَا تَصْنَعُونَ  ، وَلَكِنَّ التَّمَتُّعَ بِالْعُمْرَةِ إِلَى  الْحَجِّ  أَنْ يَخْرُجَ الرَّجُلُ حَاجًّا ، فَيَحْبِسَهُ عَدُوٌّ ، أَوْ مَرَضٌ ، أَوْ أَمْرٌ  يُعْذَرُ  بِهِ حَتَّى تَذْهَبَ أَيَّامُ  الْحَجِّ  ، فَيَأْتِيَ الْبَيْتَ فَيَطُوفَ بِهِ سَبْعًا ، وَيَسْعَى بَيْنَ  الصَّفَا  وَالْمَرْوَةِ  ، وَيَتَمَتَّعَ بِحِلِّهِ إِلَى الْعَامِ الْمُقْبِلِ ، فَيَحُجَّ وَيُهْدِيَ  )  .","","Sharh Ma'ani al-Athar 3726","","عبد الله بن الزبير عن إسحاق بن سويد بن هبيرة العدوي عن وهيب بن خالد الكرابيسي عن الخصيب بن ناصح الحارثي عن نصر بن مرزوق المصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3490","3727  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ، قَالَ :  أَنَا  إِسْحَاقُ بْنُ سُوَيْدٍ ، فَذَكَرَ نَحْوَهُ . قَالَ : فَهَذَا تَأْوِيلُ هَذِهِ الْآيَةِ .  قِيلَ لَهُمْ : لَئِنْ وَجَبَ أَنْ يَكُونَ تَأْوِيلُهَا كَذَلِكَ لِقَوْلِ  ابْنِ الزُّبَيْرِ  ، فَإِنَّ تَأْوِيلَهَا أَحْرَى أَنْ لَا يَكُونَ كَذَلِكَ .         [2/157]      لِمَا رَوَيْنَاهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَعَنْ أَصْحَابِهِ مِنْ بَعْدِهِ ، مِثْلِ :  عُمَرَ  ،  وَعَلِيٍّ  رَضِيَ اللهُ عَنْهُمَا وَمَنْ ذَكَرْنَا مَعَهُمَا فِيمَا تَقَدَّمَ مِنْ هَذَا الْبَابِ  .","","Sharh Ma'ani al-Athar 3727","","عبد الله بن الزبير عن إسحاق بن سويد بن هبيرة العدوي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3491","3728  -  وَقَدْ  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ - أَوْ مَالِكِ بْنِ الْحَارِثِ  -  عَنْ  أَبِي نَصْرٍ قَالَ : (  أَهْلَلْتُ بِالْحَجِّ ، فَأَدْرَكْتُ عَلِيًّا رَضِيَ اللهُ عَنْهُ ،  فَقُلْتُ  : إِنِّي أَهْلَلْتُ بِالْحَجِّ ، أَفَأَسْتَطِيعُ أَنْ أَضُمَّ إِلَيْهِ  ؟ )  فَقَالَ : ( لَا ، لَوْ كُنْتَ أَهْلَلْتَ بِالْعُمْرَةِ ، ثُمَّ أَرَدْتَ أَنْ تُضِيفَ إِلَيْهَا  الْحَجَّ  فَعَلْتَ  )  .","","Sharh Ma'ani al-Athar 3728","","علي بن أبي طالب عن أبو نصر بن عمر السلمي عن مالك بن الحارث السلمي عن منصور بن المعتمر عن سفيان بن عيينة عن يونس بن عبد الأعلى عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3492","3729  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنْ  مَرْوَانَ بْنِ الْحَكَمِ ، قَالَ :  كُنَّا مَعَ عُثْمَانَ بْنِ عَفَّانَ ، فَسَمِعْنَا رَجُلًا يَهْتِفُ بِالْحَجِّ وَالْعُمْرَةِ  ،  فَقَالَ  :  عُثْمَانُ  رَضِيَ اللهُ عَنْهُ : ( مَنْ هَذَا ؟ ) . قَالُوا : عَلِيٌّ رَضِيَ اللهُ عَنْهُ فَسَكَتَ .","","Sharh Ma'ani al-Athar 3729","","علي بن أبي طالب عن مروان بن الحكم بن أبي العاص عن علي بن الحسين زين العابدين عن يزيد بن أبي زياد القرشي عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3493","3730  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  الْخَصِيبُ ، قَالَ :  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  جُرَيِّ بْنِ كُلَيْبٍ ، وَعَبْدِ اللهِ بْنِ شَقِيقٍ ،  أَنَّ  عُثْمَانَ رَضِيَ اللهُ عَنْهُ خَطَبَ ، فَنَهَى عَنِ  الْمُتْعَةِ  ، فَقَامَ عَلِيٌّ رَضِيَ اللهُ عَنْهُ فَلَبَّى بِهِمَا  ، فَأَنْكَرَ  عُثْمَانُ  رَضِيَ اللهُ عَنْهُ ذَلِكَ ، فَقَالَ لَهُ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : ( إِنَّ أَفْضَلَنَا فِي هَذَا الْأَمْرِ أَشَدُّنَا اتِّبَاعًا لَهُ )  .","","Sharh Ma'ani al-Athar 3730","","علي بن أبي طالب عن عبد الله بن شقيق العقيلي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن الخصيب بن ناصح الحارثي عن سليمان بن شعيب الكيساني عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3494","3731  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  هُشَيْمٌ ، قَالَ :  ثَنَا  أَبُو بِشْرٍ ،  عَنْ  سُلَيْمَانَ الْيَشْكُرِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ ، قَالَ : (  لَوْ أَهْلَلْتُ بِالْحَجِّ وَالْعُمْرَةِ طُفْتُ لَهُمَا طَوَافًا وَاحِدًا  ، وَلَكُنْتُ مُهْدِيًا  )  .  قَالَ أَبُو جَعْفَرٍ :  فَهَذَا مَنْ ذَكَرْنَا مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ صَرَفَ تَأْوِيلَ قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      فَمَنْ تَمَتَّعَ بِالْعُمْرَةِ إِلَى الْحَجِّ فَمَا اسْتَيْسَرَ مِنَ الْهَدْيِ         }      إِلَى خِلَافِ مَا صَرَفَهُ إِلَيْهِ  عَبْدُ اللهِ بْنُ الزُّبَيْرِ  ، وَهُوَ أَصَحُّ التَّأْوِيلَيْنِ عِنْدَنَا ، وَاللهُ أَعْلَمُ ؛ لِأَنَّ فِي الْآيَةِ مَا يَدُلُّ عَلَى فَسَادِ تَأْوِيلِ  ابْنِ الزُّبَيْرِ  ؛ لِأَنَّ اللهَ عَزَّ وَجَلَّ قَالَ :         {      فَمَنْ تَمَتَّعَ بِالْعُمْرَةِ إِلَى الْحَجِّ فَمَا اسْتَيْسَرَ مِنَ الْهَدْيِ فَمَنْ لَمْ يَجِدْ فَصِيَامُ ثَلاثَةِ أَيَّامٍ فِي الْحَجِّ         }      . وَالصِّيَامُ فِي  الْحَجِّ  لَا يَكُونُ بَعْدَ فَوْتِ  الْحَجِّ  ، وَلَكِنَّهُ قَبْلَ فَوْتِهِ .  ثُمَّ قَالَ :         {      وَسَبْعَةٍ إِذَا رَجَعْتُمْ تِلْكَ عَشَرَةٌ كَامِلَةٌ ذَلِكَ لِمَنْ لَمْ يَكُنْ أَهْلُهُ حَاضِرِي الْمَسْجِدِ الْحَرَامِ         }      ، فَكَانَ اللهُ عَزَّ وَجَلَّ إِنَّمَا جَعَلَ  الْمُتْعَةَ  ، وَأَوْجَبَ فِيهَا مَا أَوْجَبَ عَلَى مَنْ فَعَلَهَا ، إِذَا لَمْ يَكُنْ أَهْلُهُ حَاضِرِي الْمَسْجِدِ الْحَرَامِ .  وَقَدْ أَجْمَعَتِ الْأُمَّةُ أَنَّ مَنْ كَانَ أَهْلُهُ حَاضِرِي الْمَسْجِدِ الْحَرَامِ ، أَوْ غَيْرَ حَاضِرِي الْمَسْجِدِ ، فَفَاتَهُ  الْحَجُّ  ، أَنَّ حُكْمَهُ فِي ذَلِكَ وَحُكْمَ غَيْرِهِ سَوَاءٌ ، وَأَنَّ حَالَهُ بِحُضُورِ أَهْلِهِ الْمَسْجِدَ الْحَرَامَ ، لَا يُخَالِفُ حَالَهُ بِبُعْدِهِمْ عَنِ الْمَسْجِدِ الْحَرَامِ ، فَثَبَتَ بِذَلِكَ أَنَّ  الْمُتْعَةَ  الَّتِي ذَكَرَهَا اللهُ عَزَّ وَجَلَّ فِي هَذِهِ الْآيَةِ ، هِيَ الَّتِي يَفْتَرِقُ فِيهَا مَنْ كَانَ أَهْلُهُ بِحَضْرَةِ الْمَسْجِدِ الْحَرَامِ ، وَمَنْ كَانَ أَهْلُهُ بِغَيْرِ حَضْرَةِ الْمَسْجِدِ الْحَرَامِ ، وَذَلِكَ فِي التَّمَتُّعِ بِالْعُمْرَةِ إِلَى  الْحَجِّ  الَّتِي كَرِهَهَا مُخَالِفُنَا  .","","Sharh Ma'ani al-Athar 3731","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سليمان بن قيس اليشكري عن جعفر بن إياس اليشكري عن هشيم بن بشير عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3495","[2/158]      3732  - وَقَدْ رَوَى  عَبْدُ اللهِ بْنُ عَبَّاسٍ  فِي ذَلِكَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مَا قَدْ  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  الْمُعَلَّى بْنُ أَسَدٍ ، قَالَ :  ثَنَا  وُهَيْبٌ ،  عَنْ  عَبْدِ اللهِ بْنِ طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانُوا يَرَوْنَ أَنَّ الْعُمْرَةَ فِي أَشْهُرِ  الْحَجِّ  مِنْ  أَفْجَرِ  الْفُجُورِ  .  قَالَ : وَكَانُوا يُسَمُّونَ الْمُحَرَّمَ صَفَرًا ، وَيَقُولُونَ : إِذَا بَرَأَ  الدَّبَرُ ،  وَعَفَا  الْأَثَرْ ، وَانْسَلَخَ صَفَرْ ،  حَلَّتِ  الْعُمْرَةُ لِمَنِ اعْتَمَرَ ، فَقَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ صَبِيحَةَ رَابِعِهِ ، وَهُمْ مُلَبُّونَ بِالْحَجِّ ، فَأَمَرَهُمْ أَنْ يَجْعَلُوهَا عُمْرَةً ، قَالُوا : يَا رَسُولَ اللهِ ، أَيُّ  حِلٍّ  نَحِلُّ ؟ قَالَ : الْحِلُّ كُلُّهُ  .  فَهَذَا  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا قَدْ أَخْبَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا فَسَخَ  الْحَجَّ  إِلَى الْعُمْرَةِ ، لِيُعَلِّمَ النَّاسَ خِلَافَ مَا كَانُوا يَكْرَهُونَ فِي الْجَاهِلِيَّةِ ، وَلِيَعْلَمُوا أَنَّ الْعُمْرَةَ فِي أَشْهُرِ  الْحَجِّ  مُبَاحَةٌ ، كَهِيَ فِي غَيْرِ أَشْهُرِ  الْحَجِّ  .  فَإِنْ قَالَ قَائِلٌ : فَقَدْ ثَبَتَ بِهَذَا عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا ، أَنَّ إِحْرَامَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا كَانَ بِحَجَّةٍ مُفْرَدَةٍ ، فَقَدْ خَالَفَ هَذَا مَا رَوَيْتُمْ عَنْهُ مِنْ تَمَتُّعِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقِرَانِهِ .  قِيلَ لَهُ : مَا فِي هَذَا خِلَافٌ لِذَلِكَ ؛ لِأَنَّهُ قَدْ يَجُوزُ أَنْ يَكُونَ إِحْرَامُهُ أَوَّلًا ، كَانَ بِحَجَّةٍ حَتَّى قَدِمَ  مَكَّةَ  فَفَسَخَ ذَلِكَ بِعُمْرَةٍ ، ثُمَّ أَقَامَ عَلَيْهَا عَلَى أَنَّهَا عُمْرَةٌ ، وَقَدْ عَزَمَ أَنْ يُحْرِمَ بَعْدَهَا بِحَجَّةٍ ، فَكَانَ فِي ذَلِكَ مُتَمَتِّعًا ، ثُمَّ لَمْ يَطُفْ لِلْعُمْرَةِ حَتَّى أَحْرَمَ بِالْحَجَّةِ ، فَصَارَ بِذَلِكَ قَارِنًا .  فَهَذِهِ وُجُوهُ أَحَادِيثِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا قَدْ صَحَّتْ وَالْتَأَمَتْ ، عَلَى أَنَّ الْقِرَانَ كَانَ قَبْلَهُ التَّمَتُّعُ وَالْإِفْرَادُ فَلَمْ تَتَضَادَّ ، إِلَّا أَنَّ فِي قَوْلِهِ :  لَوْلَا أَنِّي سُقْتُ الْهَدْيَ لَحَلَلْتُ كَمَا  حَلَّ  أَصْحَابِي  دَلِيلًا عَلَى أَنَّ سِيَاقَهُ الْهَدْيَ قَدْ كَانَتْ         [2/159]      فِي وَقْتٍ قَدْ أَحْرَمَ فِيهِ بِعُمْرَةٍ ، يُرِيدُ بِهَا التَّمَتُّعَ إِلَى الْحَجَّةِ ؛ لِأَنَّهُ لَوْ لَمْ يَكُنْ فَعَلَ ذَلِكَ ، لَكَانَ هَدْيُهُ ذَلِكَ تَطَوُّعًا ، وَالتَّطَوُّعُ مِنَ الْهَدْيِ غَيْرُ مَانِعٍ مِنَ الْإِحْلَالِ الَّذِي يَكُونُ لَوْ لَمْ يَكُنِ الْهَدْيُ ، فَدَلَّ ذَلِكَ عَلَى أَنَّ إِحْرَامَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ أَوَّلًا بِعُمْرَةٍ ، ثُمَّ أَتْبَعَهَا حَجَّةً عَلَى السَّبِيلِ الَّذِي ذَكَرْنَا فِيمَا تَقَدَّمَ مِنْ هَذَا الْبَابِ .  وَلَمَّا ثَبَتَ بِمَا وَصَفْنَا إِبَاحَةُ الْعُمْرَةِ فِي أَشْهُرِ  الْحَجِّ  أَرَدْنَا أَنْ نَنْظُرَ ، هَلِ الْهَدْيُ الْوَاجِبُ فِي الْقِرَانِ كَانَ لِنُقْصَانٍ دَخَلَ الْعُمْرَةَ أَوِ الْحَجَّةَ إِذَا قُرِنَتَا أَمْ لَا ؟  فَرَأَيْنَا ذَلِكَ الْهَدْيَ يُؤْكَلُ مِنْهُ ، وَكَذَلِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَلَهُ  .","","Sharh Ma'ani al-Athar 3732","","عبد الله بن عباس عن عبد الله بن طاووس عن وهيب بن خالد الكرابيسي عن معلى بن أسد عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3496","3733  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ وَفَهْدٌ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  ابْنُ الْهَادِ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ فِي الْحَدِيثِ الطَّوِيلِ ، قَالَ :  وَكَانَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ قَدِمَ مِنَ  الْيَمَنِ  بِهَدْيٍ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكَانَ جَمَاعَةُ الْهَدْيِ الَّذِي قَدِمَ بِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَعَلِيٌّ  مِنَ  الْيَمَنِ  مِائَةَ بَدَنَةٍ ،  فَنَحَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْهَا ثَلَاثًا وَسِتِّينَ بِيَدِهِ  ، وَنَحَرَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ سَبْعَةً وَثَلَاثِينَ ، فَأَشْرَكَ عَلِيًّا فِي هَدْيِهِ ، ثُمَّ أَخَذَ مِنْ كُلِّ بَدَنَةٍ بَضْعَةً فَجُعِلَتْ فِي قِدْرٍ فَطُبِخَتْ ، فَأَكَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعَلِيٌّ رَضِيَ اللهُ عَنْهُ مِنْ لَحْمِهَا وَشَرِبَ مِنْ مَرَقِهَا  .  فَلَمَّا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ ثَبَتَ عَنْهُ بِمَا ذَكَرْنَا قَبْلَ هَذَا الْفَصْلِ أَنَّهُ قَرَنَ ، وَأَنَّهُ كَانَ عَلَيْهِ لِذَلِكَ هَدْيٌ ، ثُمَّ  أَهْدَى  هَذِهِ الْبُدُنَ الَّتِي ذَكَرْنَا ، فَأَكَلَ مِنْ كُلِّ بَدَنَةٍ مَا وَصَفْنَا ثَبَتَ بِذَلِكَ إِبَاحَةُ الْأَكْلِ مِنْ هَدْيِ  الْمُتْعَةِ  وَالْقِرَانِ .  فَلَمَّا كَانَ ذَلِكَ الْهَدْيُ مِمَّا يُؤْكَلُ مِنْهُ ، اعْتَبَرْنَا حُكْمَ الدِّمَاءِ الْوَاجِبَةِ لِلنُّقْصَانِ ، هَلْ هِيَ كَذَلِكَ أَمْ لَا ؟  فَرَأَيْنَا الدَّمَ الْوَاجِبَ مِنْ قَصِّ الْأَظَافِرِ ، وَحَلْقِ الشَّعَرِ ، وَالْجِمَاعِ ، وَكُلَّ دَمٍ يَجِبُ لِتَرْكِ شَيْءٍ مِنَ الْحَجَّةِ لَا يُؤْكَلُ شَيْءٌ مِنْ ذَلِكَ ، فَكَانَ كُلُّ دَمٍ وَجَبَ لِإِسَاءَةٍ أَوْ لِنُقْصَانٍ لَا يُؤْكَلُ مِنْهُ ، وَكَانَ دَمُ  الْمُتْعَةِ  وَالْقِرَانِ يُؤْكَلُ مِنْهُمَا فَثَبَتَ بِذَلِكَ أَنَّهُمَا وَجَبَا لِمَعْنًى خِلَافِ الْإِسَاءَةِ وَالنُّقْصَانِ ، فَهَذِهِ حُجَّةٌ قَاطِعَةٌ عَلَى مَنْ كَرِهَ الْقِرَانَ وَالتَّمَتُّعَ بِالْعُمْرَةِ إِلَى  الْحَجِّ  .  ثُمَّ الْكَلَامُ بَعْدَ ذَلِكَ بَيْنَ الَّذِينَ جَوَّزُوا التَّمَتُّعَ وَالْقِرَانَ ، فِي تَفْضِيلِ بَعْضِهِمُ الْقِرَانَ عَلَى التَّمَتُّعِ ، وَفِي تَفْضِيلِ الْآخَرِينَ التَّمَتُّعَ عَلَى الْقِرَانِ ، فَنَظَرْنَا فِي ذَلِكَ ، فَكَانَ فِي الْقِرَانِ تَعْجِيلُ الْإِحْرَامِ بِالْحَجِّ ، وَفِي التَّمَتُّعِ تَأْخِيرُهُ ، فَكَانَ مَا عُجِّلَ مِنَ الْإِحْرَامِ بِالْحَجِّ ، فَهُوَ أَفْضَلُ وَأَتَمُّ لِذَلِكَ الْإِحْرَامِ  .","","Sharh Ma'ani al-Athar 3733","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن عبد الله بن صالح المصري عن فهد بن سليمان الدلال عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3497","3734  -         [2/160]      وَقَدْ رُوِيَ عَنْ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      وَأَتِمُّوا الْحَجَّ وَالْعُمْرَةَ لِلهِ         }      . قَالَ : ( إِتْمَامُهَا ، أَنْ تُحْرِمَ بِهِمَا مِنْ دُوَيْرَةِ أَهْلِكَ  ) .  حَدَّثَنَا  بِذَلِكَ ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلِمَةَ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ  .  فَلَمَّا كَانَ فِي الْقِرَانِ تَقْدِيمُ الْإِحْرَامِ بِالْحَجِّ عَلَى الْوَقْتِ الَّذِي يُحْرِمُ بِهِ فِي التَّمَتُّعِ ، كَانَ الْقِرَانُ أَفْضَلَ مِنَ التَّمَتُّعِ  ، وَكُلَّمَا أَثْبَتْنَا وَصَحَّحْنَا فِي هَذَا الْبَابِ ، هُوَ قَوْلُ  أَبِي حَنِيفَةَ  ،  وَأَبِي يُوسُفَ ،  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى .","","Sharh Ma'ani al-Athar 3734","","علي بن أبي طالب عن عبد الله بن سلمة الجملي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما كان النبي به محرما في حجة الوداع"
"3498","10 - بَابُ الْهَدْيِ يُسَاقُ لِمُتْعَةٍ أَوْ قِرَانٍ هَلْ يُرْكَبُ أَمْ لَا ؟  3735  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَأَى  رَجُلًا  يَسُوقُ بَدَنَةً قَالَ : ارْكَبْهَا  . فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّهَا بَدَنَةٌ ، قَالَ : ارْكَبْهَا ، وَيْلَكَ  .","","Sharh Ma'ani al-Athar 3735","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3499","3736  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  عَجْلَانَ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3736","","أبو هريرة الدوسي عن عجلان مولى المشمعل عن محمد بن عبد الرحمن بن المغيرة عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3500","3737  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْوَهْبِيُّ ، قَالَ :  ثَنَا  ابْنُ إِسْحَاقَ ،  عَنْ  عَمِّهِ مُوسَى بْنِ يَسَارٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  غَيْرَ أَنَّهُ قَالَ لَهُ فِي الثَّالِثَةِ أَوِ الرَّابِعَةِ : "" ارْكَبْهَا ، وَيْحَكَ "" .","","Sharh Ma'ani al-Athar 3737","","أبو هريرة الدوسي عن موسى بن يسار المطلبي عن محمد بن إسحاق عن أحمد بن خالد بن موسى الوهبي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3501","3738  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ - هُوَ ابْنُ سَلَمَةَ -  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِرَجُلٍ  يَسُوقُ بَدَنَةً ، قَالَ : ارْكَبْهَا  . قَالَ : إِنَّهَا بَدَنَةٌ. قَالَ : ارْكَبْهَا  .","","Sharh Ma'ani al-Athar 3738","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3502","3739  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  مُؤَمَّلٌ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  مُوسَى بْنِ أَبِي عُثْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3739","","أبو هريرة الدوسي عن أبو عثمان التبان عن موسى بن أبي عثمان التبان عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3503","3740  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  الْمُقَدَّمِيُّ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ :  ثَنَا  مُعْتَمِرٌ ،  عَنْ  أَيُّوبَ ،         [2/161]      عَنْ  عِكْرِمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ  رَأَى  رَجُلًا  يَسُوقُ بَدَنَةً . قَالَ : ارْكَبْهَا . قَالَ : إِنَّهَا بَدَنَةٌ  . قَالَ : ارْكَبْهَا بِسَيْرِهَا الَّذِي فِي عُنُقِهَا . قَالَ : فَلَقَدْ رَأَيْتُهُ يُسَايِرُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَفِي عُنُقِهَا نَعْلٌ  .","","Sharh Ma'ani al-Athar 3740","","أبو هريرة الدوسي عن عكرمة مولى ابن عباس عن أيوب السختياني عن معتمر بن سليمان عن يزيد بن زريع العيشي عن محمد بن أبي بكر المقدمي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3504","3741  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ، قَالَ :  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ، قَالَ :  ثَنَا  هُشَيْمٌ ،  عَنْ  حَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  نَافِعٍ ،  أَنَّ  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُ  رَأَى رَجُلًا يَسُوقُ بَدَنَةً ، قَالَ : ( ارْكَبْهَا ، وَمَا أَنْتُمْ بِمُسْتَنِّينَ سُنَّةً أَهْدَى مِنْ سُنَّةِ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ )  .","","Sharh Ma'ani al-Athar 3741","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن حجاج بن أرطاة عن هشيم بن بشير عن يعقوب بن حميد بن كاسب المدني عن أحمد بن داود بن موسى السدوسي عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3505","3742  -  حَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  أَنَا  حُمَيْدٌ الطَّوِيلُ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ رَضِيَ اللهُ عَنْهُ قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِرَجُلٍ  وَهُوَ يَسُوقُ بَدَنَةً قَالَ : ارْكَبْهَا  . قَالَ : إِنَّهَا بَدَنَةٌ . قَالَ : ارْكَبْهَا  .","","Sharh Ma'ani al-Athar 3742","","أنس بن مالك عن حميد الطويل عن يزيد بن هارون عن علي بن شيبة بن الصلت البصري عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3506","3743  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ خُشَيْشٍ الْبَصْرِيُّ ، قَالَ :  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  هِشَامٌ وَشُعْبَةُ ، قَالَا :  ثَنَا  قَتَادَةُ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى أَنَّ الرَّجُلَ إِذَا سَاقَ بَدَنَةً لِمُتْعَةٍ أَوْ قِرَانٍ ، أَنَّ لَهُ أَنْ يَرْكَبَهَا ، وَاحْتَجُّوا فِي ذَلِكَ بِهَذِهِ الْآثَارِ ، وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : إِنَّمَا كَانَ هَذَا مِنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِضُرٍّ رَآهُ مِنَ الرَّجُلِ ، فَأَمَرَهُ بِمَا أَمَرَهُ بِهِ لِذَلِكَ .  وَهَكَذَا نَقُولُ نَحْنُ : لَا بَأْسَ بِرُكُوبِهَا فِي حَالِ الضَّرُورَةِ ، وَلَا يَجُوزُ فِي حَالِ الْوُجُودِ .  فَاحْتَمَلَ أَنْ يَكُونَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِذَلِكَ لِلضَّرُورَةِ كَمَا قَالُوا ، وَاحْتَمَلَ أَنْ يَكُونَ ذَلِكَ لَا لِلضَّرُورَةِ ، وَلَكِنْ لِأَنَّ حُكْمَ الْبُدْنِ كُلِّهَا كَذَلِكَ ، تُرْكَبُ فِي حَالِ الضَّرُورَةِ ، وَفِي حَالِ الْوُجُودِ  .  فَنَظَرْنَا فِي ذَلِكَ  .","","Sharh Ma'ani al-Athar 3743","","أنس بن مالك عن قتادة بن دعامة عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن عبد الله بن محمد بن خشيش عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3507","3744  -  فَإِذَا نَصْرُ بْنُ مَرْزُوقٍ قَدْ :  حَدَّثَنَا  ، قَالَ :  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأَى  رَجُلًا  يَسُوقُ بَدَنَةً وَقَدْ جَهِدَ ، قَالَ : ارْكَبْهَا  . قَالَ : يَا رَسُولَ اللهِ ، إِنَّهَا بَدَنَةٌ ، قَالَ : ارْكَبْهَا .","","Sharh Ma'ani al-Athar 3744","","أنس بن مالك عن حميد الطويل عن إسماعيل بن جعفر بن أبي كثير الزرقي عن علي بن معبد العبدي عن نصر بن مرزوق المصري عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3508","3745  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  أَبُو غَسَّانَ ، وَالنُّفَيْلِيُّ ، قَالَا :  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ، قَالَ :  ثَنَا  حُمَيْدٌ الطَّوِيلُ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ رَضِيَ اللهُ عَنْهُ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَأَى  رَجُلًا  يَسُوقُ بَدَنَةً ، فَكَأَنَّهُ رَأَى بِهِ  جَهْدًا  ، فَقَالَ : ارْكَبْهَا  ، فَقَالَ : إِنَّهَا بَدَنَةٌ ، قَالَ : ارْكَبْهَا ، وَإِنْ كَانَتْ بَدَنَةً  .  وَقَدْ رُوِيَ فِي حَدِيثِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا حَرْفٌ يَدُلُّ عَلَى هَذَا الْمَعْنَى أَيْضًا  .","","Sharh Ma'ani al-Athar 3745","","أنس بن مالك عن ثابت البناني عن حميد الطويل عن زهير بن معاوية بن حديج عن مالك بن إسماعيل النهدي عن فهد بن سليمان الدلال عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3509","3746  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحِمَّانِيُّ ، قَالَ :  ثَنَا  هُشَيْمٌ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّهُ  كَانَ يَقُولُ فِي الرَّجُلِ إِذَا سَاقَ بَدَنَةً فَأُعْيِيَ : ( ارْكَبْهَا  ، وَمَا أَنْتُمْ بِمُسْتَنِّينَ سُنَّةً أَهْدَى مِنْ سُنَّةِ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ) .         [2/162]      فَدَلَّ ذَلِكَ أَيْضًا ، أَنَّ مَا أَمَرَ بِهِ  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُ وَأَخْبَرَ أَنَّهُ سُنَّةُ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ هُوَ رُكُوبُ الْبَدَنَةِ فِي حَالِ الضَّرُورَةِ  ، ثُمَّ الْتَمَسْنَا حُكْمَ رُكُوبِ الْهَدْيِ فِي غَيْرِ حَالِ الضَّرُورَةِ ، هَلْ نَجِدُ لَهُ ذِكْرًا فِي غَيْرِ هَذِهِ الْآثَارِ  .","","Sharh Ma'ani al-Athar 3746","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن حجاج بن أرطاة عن هشيم بن بشير عن يحيى بن عبد الحميد عن فهد بن سليمان الدلال عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3510","3747  -  فَإِذَا فَهْدٌ قَدْ :  حَدَّثَنَا  ، قَالَ :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، قَالَ :  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ارْكَبُوا الْهَدْيَ بِالْمَعْرُوفِ  ، حَتَّى تَجِدُوا ظَهْرًا  .","","Sharh Ma'ani al-Athar 3747","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن سليمان بن حيان الأحمر عن أبو بكر ابن أبي شيبة عن فهد بن سليمان الدلال عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3511","3748  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  ابْنُ أَبِي مَرْيَمَ . (  ح  ) .  3749  -  وَحَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ  فِي رُكُوبِ الْهَدْيِ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  ارْكَبْهَا بِالْمَعْرُوفِ إِذَا أُلْجِئْتَ إِلَيْهَا  ، حَتَّى تَجِدَ ظَهْرًا  .  فَأَبَاحَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي هَذَا الْحَدِيثِ رُكُوبَهَا فِي حَالِ الضَّرُورَةِ ، وَمَنَعَ مِنْ ذَلِكَ إِذَا ارْتَفَعَتِ الضَّرُورَةُ وَوُجِدَ غَيْرُهَا ، فَثَبَتَ بِذَلِكَ أَنَّ هَذَا حُكْمُ الْهَدْيِ مِنْ طَرِيقِ الْآثَارِ ، تُرْكَبُ لِلضَّرُورَاتِ ، وَتُتْرَكُ لِارْتِفَاعِ الضَّرُورَاتِ .  ثُمَّ اعْتَبَرْنَا حُكْمَ ذَلِكَ مِنْ طَرِيقِ النَّظَرِ ، كَيْفَ هُوَ ؟ فَرَأَيْنَا الْأَشْيَاءَ عَلَى ضَرْبَيْنِ ، فَمِنْهَا مَا الْمِلْكُ فِيهِ مُتَكَامِلٌ ، لَمْ يَدْخُلْهُ شَيْءٌ يُزِيلُ عَنْهُ شَيْئًا مِنْ أَحْكَامِ الْمِلْكِ ، كَالْعَبْدِ الَّذِي لَمْ يُدَبِّرْهُ مَوْلَاهُ ، وَكَالْأَمَةِ الَّتِي لَمْ تَلِدْ مِنْ مَوْلَاهَا ، وَكَالْبَدَنَةِ الَّتِي لَمْ يُوجِبْهَا صَاحِبُهَا ، فَكُلُّ ذَلِكَ جَائِزٌ بَيْعُهُ ، وَجَائِزٌ الِانْتِفَاعُ بِهِ ، وَجَائِزٌ تَمْلِيكُ مَنَافِعِهِ بِإِبْدَالٍ ، وَبِلَا إِبْدَالٍ .  وَمِنْهَا مَا قَدْ دَخَلَهُ شَيْءٌ مَنَعَ مِنْ بَيْعِهِ ، وَلَمْ يَزُلْ عَنْهُ حُكْمُ الِانْتِفَاعِ بِهِ ، مِنْ ذَلِكَ أُمُّ الْوَلَدِ الَّتِي لَا يَجُوزُ لِمَوْلَاهَا بَيْعُهَا ، وَالْمُدَبَّرُ فِي قَوْلِ مَنْ لَا يَرَى بَيْعَهُ .  فَذَلِكَ لَا بَأْسَ بِالِانْتِفَاعِ بِهِ وَبِتَمْلِيكِ مَنَافِعِهِ لِلَّذِي يُرِيدُ أَنْ يَنْتَفِعَ بِهَا بِبَدَلٍ ، أَوْ بِلَا بَدَلٍ ، فَكَانَ مَالُهُ أَنْ يَنْتَفِعَ بِهِ ، فَلَهُ أَنْ يَمْلِكَ مَنَافِعَهُ مَنْ شَاءَ بِإِبْدَالٍ ، وَبِلَا إِبْدَالٍ .  ثُمَّ رَأَيْنَا الْبَدَنَةَ إِذَا أَوْجَبَهَا رَبُّهَا ، فَكُلٌّ قَدْ أَجْمَعَ أَنَّهُ لَا يَجُوزُ لَهُ أَنْ يُؤَاجِرَهَا وَلَا يَتَعَوَّضَ بِمَنَافِعِهَا بَدَلًا .  فَلَمَّا كَانَ لَيْسَ لَهُ تَمْلِيكُ مَنَافِعِهَا بِبَدَلٍ ، كَانَ كَذَلِكَ لَيْسَ لَهُ الِانْتِفَاعُ بِهَا ، وَلَا يَكُونُ لَهُ الِانْتِفَاعُ بِشَيْءٍ إِلَّا شَيْءٍ لَهُ التَّعَوُّضُ بِمَنَافِعِهِ إِبْدَالًا مِنْهَا .  فَهَذَا هُوَ النَّظَرُ أَيْضًا ، وَهُوَ قَوْلُ  أَبِي حَنِيفَةَ  ،  وَأَبِي يُوسُفَ  ،  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ .         [2/163]      وَقَدْ رُوِيَ ذَلِكَ عَنْ جَمَاعَةٍ مِنَ الْمُتَقَدِّمِينَ  .","","Sharh Ma'ani al-Athar 3748","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يزيد بن سنان القزاز عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3512","3750  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  بِشْرُ بْنُ عُمَرَ ، قَالَ :  ثَنَا  شُعْبَةُ ، أُرَاهُ  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ، قَالَ :  لَا يَشْرَبُ لَبَنَ الْبَدَنَةِ ، وَلَا يَرْكَبُهَا إِلَّا أَنْ يَضْطَرَّ  إِلَى ذَلِكَ  .","","Sharh Ma'ani al-Athar 3750","","إبراهيم النخعي عن المغيرة بن مقسم الضبي عن شعبة بن الحجاج عن بشر بن عمر الزهراني عن محمد بن محمد بن مرزوق الباهلي عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3513","3751  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  [ حَمَّادٌ ، قَالَ :  ثَنَا  ]  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  قَالَ :  الْبَدَنَةُ إِذَا احْتَاجَ إِلَيْهَا سَائِقُهَا رَكِبَهَا  رُكُوبًا غَيْرَ فَادِحٍ  .","","Sharh Ma'ani al-Athar 3751","","عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3514","3752  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  قَيْسٍ ،  عَنْ  عَطَاءٍ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3752","","عطاء بن أبي رباح عن قيس بن سعد الحبشي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3515","وَقَدْ رُوِيَ عَنِ الْمُتَقَدِّمِينَ فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      لَكُمْ فِيهَا مَنَافِعُ إِلَى أَجَلٍ مُسَمًّى         }      . مَا  حَدَّثَنَا  ابْنُ مَرْزُوقٍ قَالَ :  ثَنَا  أَبُو عَامِرٍ ،  عَنْ  شُعْبَةَ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ . ح .","","Sharh Ma'ani al-Athar 3515","","مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن أبو عامر العقدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3516","3753  -  وَحَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو حُذَيْفَةَ ،  عَنْ  سُفْيَانَ وَحِبَّانَ ،  عَنْ  حَمَّادٍ ، كِلَيْهِمَا  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ :         {      لَكُمْ فِيهَا مَنَافِعُ إِلَى أَجَلٍ مُسَمًّى         }      قَالَ :  فِي ظُهُورِهَا وَأَلْبَانِهَا ، وَأَصْوَافِهَا  ، وَأَوْبَارِهَا ، حَتَّى تَصِيرَ بُدْنًا  .","","Sharh Ma'ani al-Athar 3753","","مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن سفيان الثوري عن موسى بن مسعود النهدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3517","3754  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ، قَالَ :  أَنَا  ابْنُ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ :         {      لَكُمْ فِيهَا مَنَافِعُ إِلَى أَجَلٍ مُسَمًّى         }      . قَالَ :  هِيَ الْإِبِلُ يُنْتَفَعُ بِهَا حَتَّى تُقَلَّدَ  .","","Sharh Ma'ani al-Athar 3754","","مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3518","3755  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ ، قَالَ :  ثَنَا  وَرْقَاءُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ :         {      لَكُمْ فِيهَا مَنَافِعُ إِلَى أَجَلٍ مُسَمًّى         }      . قَالَ :  إِنِ احْتَاجَ إِلَى ظَهْرِهَا رَكِبَ وَإِنِ احْتَاجَ إِلَى لَبَنِهَا شَرِبَ  ، يَعْنِي الْبُدْنَ  .","","Sharh Ma'ani al-Athar 3755","","إبراهيم النخعي عن منصور بن المعتمر عن ورقاء بن عمر عن أبو داود الطيالسي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الهدي يساق لمتعة أو قران هل يركب"
"3519","11 - بَابُ مَا يَقْتُلُ الْمُحْرِمُ مِنَ الدَّوَابِّ  3756  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  ابْنُ أَبِي مَرْيَمَ ، قَالَ :  أَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  مُحَمَّدِ بْنِ الْعَجْلَانِ ،  عَنِ  الْقَعْقَاعِ بْنِ حَكِيمٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِ حَدِيثِ  مَالِكٍ  وَاللَّيْثِ  - يَعْنِي - أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  خَمْسٌ مِنَ الدَّوَابِّ يُقْتَلْنَ فِي الْحَرَمِ  : الْعَقْرَبُ ،  وَالْحِدَأُ  ، وَالْغُرَابُ ،  وَالْفَأْرَةُ  ، وَالْكَلْبُ  الْعَقُورُ  . إِلَّا أَنَّهُ قَالَ فِي حَدِيثِهِ : وَالْحَيَّةُ وَالذِّئْبُ وَالْكَلْبُ  الْعَقُورُ  .","","Sharh Ma'ani al-Athar 3756","","أبو هريرة الدوسي عن ذكوان السمان عن القعقاع بن حكيم الكناني عن محمد بن عجلان عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن علان بن المغيرة عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3520","[2/164]      3757  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  أَبُو حُذَيْفَةَ ، قَالَ :  ثَنَا  زُهَيْرُ بْنُ مُحَمَّدٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ قَالَ : (  الْكَلْبُ  الْعَقُورُ  : الْأَسَدُ  )  .","","Sharh Ma'ani al-Athar 3757","","أبو هريرة الدوسي عن ذكوان السمان عن زيد بن أسلم عن زهير بن محمد التميمي عن موسى بن مسعود النهدي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3521","3758  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، قَالَ :  ثَنَا  حَفْصُ بْنُ مَيْسَرَةَ ، قَالَ :  حَدَّثَنِي  زَيْدُ بْنُ أَسْلَمَ ،  عَنِ  ابْنِ سِيلَانَ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، مِثْلَهُ .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى هَذَا فَقَالُوا : الْكَلْبُ  الْعَقُورُ  الَّذِي أَبَاحَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَتْلَهُ ، هُوَ الْأَسَدُ ، وَكُلُّ سَبُعٍ  عَقُورٍ  ، فَهُوَ دَاخِلٌ فِي ذَلِكَ ، وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَقَالُوا : الْكَلْبُ  الْعَقُورُ  ، هُوَ الْكَلْبُ الْمَعْرُوفُ ، وَلَيْسَ الْأَسَدُ مِنْهُ فِي شَيْءٍ .  وَقَالُوا : لَيْسَ فِي حَدِيثِ  أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّ الْكَلْبَ  الْعَقُورَ  هُوَ الْأَسَدُ ، وَإِنَّمَا ذَلِكَ مِنْ قَوْلِ  أَبِي هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ .  وَقَدْ وَجَدْنَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَيْضًا مَا يَدْفَعُ ذَلِكَ  ، وَهُوَ مَا","","Sharh Ma'ani al-Athar 3758","","أبو هريرة الدوسي عن عيسى بن سيلان المكي عن زيد بن أسلم عن حفص بن ميسرة العقيلي عن سعيد بن منصور عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3522","3759  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ، قَالَ :  أَنَا  ابْنُ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ ، أَنَّ عَبْدَ الرَّحْمَنِ بْنَ أَبِي عَمَّارٍ  أَخْبَرَهُ  ، قَالَ :  سَأَلْتُ  جَابِرَ بْنَ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ عَنِ الضَّبُعِ ، فَقُلْتُ : آكُلُهَا ؟  قَالَ : نَعَمْ . قُلْتُ : أَصَيْدٌ هِيَ ؟ قَالَ : نَعَمْ  . فَقُلْتُ : وَسَمِعْتُ ذَلِكَ مِنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ : نَعَمْ  .","","Sharh Ma'ani al-Athar 3759","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن عبد الله بن أبي عمار الجشمي عن عبد الله بن عبيد بن عمير الجندعي عن ابن جريج عن محمد بن بكر بن عثمان البرساني عن يزيد بن سنان القزاز عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3523","3760  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  حِبَّانُ وَشَيْبَانُ وَهُدْبَةُ ، قَالُوا :  ثَنَا  جَرِيرُ بْنُ حَازِمٍ . (  ح  ) .  3761  -  وَحَدَّثَنَا  عَلِيُّ بْنُ شَيْبَةَ ، قَالَ :  ثَنَا  أَبُو غَسَّانَ . (  ح  ) .  3762  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، قَالَ :  ثَنَا  جَرِيرٌ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ ، قَالَ :  ثَنَا  ابْنُ أَبِي عَمَّارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سُئِلَ عَنِ الضَّبُعِ ، فَقَالَ : هِيَ مِنَ الصَّيْدِ  ، وَجَعَلَ فِيهَا إِذَا أَصَابَهَا الْمُحْرِمُ كَبْشًا  .","","Sharh Ma'ani al-Athar 3760","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن عبد الله بن أبي عمار الجشمي عن عبد الله بن عبيد بن عمير الجندعي عن جرير بن حازم عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3524","3763  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ قَالَ :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  عَنْ  يَحْيَى بْنِ أَيُّوبَ ، قَالَ :  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ أُمَيَّةَ وَابْنُ جُرَيْجٍ ، وَجَرِيرُ بْنُ حَازِمٍ ، أَنَّ عَبْدَ اللهِ بْنَ عُبَيْدِ اللهِ بْنِ عُمَيْرٍ  حَدَّثَهُمْ  ، قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ أَبِي عَمَّارٍ ،  أَنَّهُ سَأَلَ  جَابِرَ بْنَ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ عَنِ الضَّبُعِ ، فَقَالَ : آكُلُهَا  ؟ ، فَقَالَ : نَعَمْ . قُلْتُ : أَصَيْدٌ هِيَ ؟ قَالَ : نَعَمْ . قُلْتُ : أَسَمِعْتَ ذَلِكَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : نَعَمْ  .","","Sharh Ma'ani al-Athar 3763","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الرحمن بن عبد الله بن أبي عمار الجشمي عن عبد الله بن عبيد بن عمير الجندعي عن جرير بن حازم عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن هارون بن كامل المصري عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3525","3764  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  حِبَّانُ . (  ح  ) .         [2/165]      3765  -  وَحَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  أَبُو عُمَرَ الْحَوْضِيُّ ، قَالَا :  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  عَنْ  إِبْرَاهِيمَ الصَّائِغِ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ . وَزَادَ :  وَجَعَلَ فِيهَا إِذَا أَصَابَهَا الْمُحْرِمُ كَبْشًا  مُسِنًّا  ، وَتُؤْكَلُ  .","","Sharh Ma'ani al-Athar 3764","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن إبراهيم بن ميمون الصائغ عن حسان بن إبراهيم الكرماني عن حفص بن عمر الحوضى عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3526","3766  -  حَدَّثَنَا  صَالِحُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ، قَالَ :  ثَنَا  هُشَيْمٌ ،  عَنْ  مَنْصُورِ بْنِ زَاذَانَ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ قَالَ :  قُضِيَ فِي الضَّبُعِ - إِذَا قَتَلَهَا الْمُحْرِمُ - بِكَبْشٍ  .  فَلَمَّا كَانَتِ الضَّبُعُ هِيَ سَبُعٌ ، وَلَمْ يُبِحِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَتْلَهَا ، وَجَعَلَهَا صَيْدًا ، وَجَعَلَ عَلَى قَاتِلِهَا الْجَزَاءَ ، دَلَّنَا ذَلِكَ عَلَى أَنَّ الْكَلْبَ  الْعَقُورَ ،  لَيْسَ هُوَ السَّبُعَ ، وَبَطَلَ بِذَلِكَ مَا ذَهَبَ إِلَيْهِ  أَبُو هُرَيْرَةَ  ، وَكَانَ الْكَلْبُ  الْعَقُورُ ،  هُوَ الْكَلْبُ الَّذِي تَعْرِفُهُ الْعَامَّةُ .  فَإِنْ قَالَ قَائِلٌ : فَلِمَ لَا تُبِيحُونَ قَتْلَ الذِّئْبِ ؟ قِيلَ لَهُ : لِأَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : خَمْسٌ مِنَ الدَّوَابِّ يُقْتَلْنَ فِي الْحِلِّ وَالْحَرَمِ . فَذَكَرَ الْخَمْسَ مَا هُنَّ ؟  فَذِكْرُ الْخَمْسِ يَدُلُّ عَلَى أَنَّ غَيْرَ الْخَمْسِ حُكْمُهُ غَيْرُ حُكْمِهِنَّ ، وَإِلَّا لَمْ يَكُنْ لِذِكْرِهِ الْخَمْسَ مَعْنًى .  فَالَّذِينَ أَبَاحُوا قَتْلَ الذِّئْبِ أَبَاحُوا قَتْلَ جَمِيعِ  السِّبَاعِ  ، وَالَّذِينَ مَنَعُوا قَتْلَ الذِّئْبِ حَظَرُوا قَتْلَ سَائِرِ  السِّبَاعِ  ، غَيْرَ الْكَلْبِ  الْعَقُورِ  خَاصَّةً .  وَقَدْ ثَبَتَ خُرُوجُ الضَّبُعِ مِنَ الْقَتْلِ ، وَلَمْ يَكُنْ كَلْبًا  عَقُورًا  ، وَثَبَتَ أَنَّ الْكَلْبَ  الْعَقُورَ  هُوَ الْكَلْبُ الَّذِي تَعْرِفُهُ الْعَامَّةُ  .  فَأَمَّا مَا رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيمَا يُقْتَلُ فِي الْإِحْرَامِ وَالْحَرَمِ فَمَا .","","Sharh Ma'ani al-Athar 3766","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن منصور بن زاذان الثقفي عن هشيم بن بشير عن سعيد بن منصور عن صالح بن عبد الرحمن المصري عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3527","3767  -  حَدَّثَنَا  عِيسَى بْنُ إِبْرَاهِيمَ الْغَافِقِيُّ ، وَأَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ ، قَالَ :  قَالَتْ  حَفْصَةُ  : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَمْسٌ مِنَ الدَّوَابِّ يَقْتُلُهُنَّ الْمُحْرِمُ  : الْغُرَابُ ،  وَالْحِدَأُ  ،  وَالْفَأْرَةُ  ، وَالْعَقْرَبُ ، وَالْكَلْبُ  الْعَقُورُ  .","","Sharh Ma'ani al-Athar 3767","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن أحمد بن عبد الرحمن بن وهب عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3528","3768  -  حَدَّثَنَا  رَبِيعٌ الْجِيزِيُّ ، قَالَ :  ثَنَا  أَبُو زُرْعَةَ ، قَالَ :  أَنَا  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ قَالَ :  قَالَتْ  حَفْصَةُ  رَضِيَ اللهُ عَنْهَا : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ ذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3768","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن وهب الله بن راشد المؤذن عن الربيع بن سليمان الجيزي عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3529","3769  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  أَبُو عَوَانَةَ ، قَالَ :  ثَنَا  زَيْدُ بْنُ جُبَيْرٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَجُلًا سَأَلَ ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا عَمَّا يَقْتُلُ الْمُحْرِمُ  .  فَقَالَ  :  أَخْبَرَتْنِي  إِحْدَى نِسْوَةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ كَانَ يَأْمُرُ  ، ثُمَّ ذَكَرَ مِثْلَهُ  .","","Sharh Ma'ani al-Athar 3769","","أزواج النبي صلى الله عليه وسلم عن عبد الله بن عمر بن الخطاب عن زيد بن جبير الطائي عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3530","3770  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ :  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا يَقْتُلُ الْمُحْرِمُ  ، فَذَكَرَ مِثْلَهُ  .","","Sharh Ma'ani al-Athar 3770","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن أسباط بن محمد بن ميسرة القرشي عن محمد بن عمرو السوسي عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3531","3771  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ ، قَالَ :  ثَنَا  وُهَيْبٌ ، قَالَ :  ثَنَا  أَيُّوبُ . (  ح  ) .         [2/166]      3772  -  وَحَدَّثَنَا  يَزِيدُ : قَالَ :  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3771","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن سلمة عن موسى بن إسماعيل التبوذكي عن يزيد بن سنان القزاز عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3532","3773  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  شُعَيْبُ بْنُ اللَّيْثِ ، قَالَ :  ثَنَا  اللَّيْثُ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3773","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الليث بن سعد عن شعيب بن الليث المصري عن الربيع بن سليمان المرادي عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3533","3774  -  حَدَّثَنَا  يَزِيدُ ، قَالَ :  ثَنَا  شَيْبَانُ ، قَالَ :  ثَنَا  جَرِيرٌ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3774","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جرير بن حازم عن شيبان بن فروخ الحبطي عن يزيد بن سنان القزاز عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3534","3775  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  مَالِكٌ ،  عَنْ  نَافِعٍ وَعَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3775","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3535","3776  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3776","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3536","3777  -  حَدَّثَنَا  يَزِيدُ ، قَالَ :  ثَنَا  الْقَعْنَبِيُّ ، قَالَ :  قَرَأْتُ عَلَى  مَالِكٍ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3777","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن يزيد بن سنان القزاز عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3537","3778  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ، قَالَ  شُعْبَةُ  : قُلْتُ : عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : ( نَعَمْ ، وَهُوَ مُتَنَاقَلٌ مِثْلُهُ ) .","","Sharh Ma'ani al-Athar 3778","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3538","3779  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3779","","عائشة بنت أبي بكر الصديق عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن أبو عامر العقدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3539","3780  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَ :  ثَنَا  شُعْبَةُ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ . غَيْرَ أَنَّهُ قَالَ :  الْغُرَابُ  الْأَبْقَعُ  .","","Sharh Ma'ani al-Athar 3780","","عائشة بنت أبي بكر الصديق عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن مسلم بن إبراهيم الشحام عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3540","3781  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  الْحَجَّاجُ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  خَمْسُ  فَوَاسِقَ  يُقْتَلْنَ فِي الْحِلِّ وَالْحَرَمِ  : الْكَلْبُ  الْعَقُورُ ،  وَالْفَأْرَةُ  ،  وَالْحِدَأُ  ، وَالْغُرَابُ ، وَالْعَقْرَبُ  .","","Sharh Ma'ani al-Athar 3781","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3541","3782  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ، قَالَ :  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنِ  ابْنِ أَبِي نُعْمٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  يَقْتُلُ الْمُحْرِمُ الْحَيَّةَ ، وَالْعَقْرَبَ  ،  وَالْفَأْرَةَ  الْفُوَيْسِقَةَ  .  قَالَ  يَزِيدُ  : وَعَدَّ غَيْرَ هَذَا ، فَلَمْ أَحْفَظْ .  قَالَ : قُلْتُ : وَلِمَ سُمِّيَتِ  الْفَأْرَةُ  ( الْفُوَيْسِقَةَ ؟ ) قَالَ : اسْتَيْقَظَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ لَيْلَةٍ ، وَقَدْ أَخَذَتْ  فَأْرَةٌ  فَتِيلَةً ، لِتُحَرِّقَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْبَيْتَ .         [2/167]      فَقَامَ إِلَيْهَا فَقَتَلَهَا ، وَأَحَلَّ قَتْلَهَا لِكُلِّ مُحْرِمٍ أَوْ حَلَالٍ .  فَهَذَا مَا أَبَاحَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلْمُحْرِمِ قَتْلَهُ فِي إِحْرَامِهِ ، وَأَبَاحَ لِلْحَلَالِ قَتْلَهُ فِي الْحَرَمِ ، وَعَدَّ ذَلِكَ خَمْسًا .  فَذَلِكَ يَنْفِي أَنْ يَكُونَ حُكْمُ أَشْكَالِ شَيْءٍ مِنْ ذَلِكَ ، كَحُكْمِ هَذِهِ الْخَمْسِ ، إِلَّا مَا اتُّفِقَ عَلَيْهِ مِنْ ذَلِكَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنَاهُ .  فَإِنْ قَالَ قَائِلٌ : فَقَدْ رَأَيْنَا الْحَيَّةَ مُبَاحًا قَتْلُهَا فِي ذَلِكَ كُلِّهِ ، وَكَذَلِكَ جَمِيعُ الْهَوَامِّ ، فَإِنَّمَا ذَكَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ ذَلِكَ الْعَقْرَبَ خَاصَّةً ، فَجَعَلْتُمْ كُلَّ الْهَوَامِّ كَذَلِكَ ، فَمَا تُنْكِرُونَ أَنْ يَكُونَ  السِّبَاعُ  كَذَلِكَ أَيْضًا ، فَيَكُونَ مَا ذُكِرَ إِبَاحَةُ قَتْلِهِ مِنْهُنَّ إِبَاحَةَ مِثْلِهِ لِقَتْلِ جَمِيعِهِنَّ ؟  قِيلَ لَهُ : قَدْ أَوْجَدْنَاكَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَصًّا فِي الضَّبُعِ ، وَهِيَ مِنَ  السِّبَاعِ  ، أَنَّهَا غَيْرُ دَاخِلَةٍ فِيمَا أَبَاحَ قَتْلَهُ مِنَ الْخَمْسِ .  فَثَبَتَ بِذَلِكَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يُرِدْ قَتْلَ سَائِرِ  السِّبَاعِ  بِإِبَاحَتِهِ قَتْلَ الْكَلْبِ  الْعَقُورِ  ، وَإِنَّمَا أَرَادَ بِذَلِكَ خَاصًّا مِنَ  السِّبَاعِ  ، ثُمَّ قَدْ رَأَيْنَاهُ أَبَاحَ مَعَ ذَلِكَ أَيْضًا قَتْلَ الْغُرَابِ  وَالْحِدَأِ  ، وَهُمَا مِنْ ذَوِي الْمِخْلَبِ مِنَ الطَّيْرِ ، وَقَدْ أَجْمَعُوا أَنَّهُ لَمْ يُرِدْ بِذَلِكَ كُلَّ ذِي مِخْلَبٍ مِنَ الطَّيْرِ ؛ لِأَنَّهُمْ قَدْ أَجْمَعُوا أَنَّ الْعُقَابَ وَالصَّقْرَ وَالْبَازِيَ ذُو مِخْلَبٍ ، وَأَنَّهُمْ غَيْرُ مَقْتُولِينَ فِي الْحَرَمِ ، كَمَا يُقْتَلُ الْغُرَابُ  وَالْحِدَأُ  .  وَإِنَّمَا الْإِبَاحَةُ مِنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِقَتْلِ الْغُرَابِ  وَالْحِدَأِ  عَلَيْهِمَا خَاصَّةً ، لَا عَلَى مَا سِوَاهُمَا مِنْ كُلِّ ذِي مِخْلَبٍ مِنَ الطَّيْرِ .  وَأَجْمَعُوا أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَبَاحَ قَتْلَ الْعَقْرَبِ فِي الْإِحْرَامِ وَالْحَرَمِ .  وَأَجْمَعُوا أَنَّ جَمِيعَ الْهَوَامِّ مِثْلُهَا ، وَأَنَّ مُرَادَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِإِبَاحَةِ قَتْلِ الْعَقْرَبِ ، إِبَاحَةُ قَتْلِ جَمِيعِ الْهَوَامِّ ، فَذُو النَّابِ مِنَ  السِّبَاعِ  بِذِي الْمِخْلَبِ مِنَ الطَّيْرِ أَشْبَهُ مِنْهُ بِالْهَوَامِّ مَعَ مَا قَدْ بَيَّنَ ذَلِكَ ، وَشَدَّهُ مَا رَوَاهُ  جَابِرٌ  رَضِيَ اللهُ عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَدِيثِ الضَّبُعِ .  فَإِنْ قَالَ قَائِلٌ : إِنَّمَا جَعَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حُكْمَ الضَّبُعِ كَمَا ذَكَرْتَ ؛ لِأَنَّهَا تُؤْكَلُ ، فَأَمَّا مَا كَانَ لَا يُؤْكَلُ مِنَ  السِّبَاعِ  فَهُوَ كَالْكَلْبِ . قِيلَ لَهُ : قَدْ غَلِطْتَ فِي التَّشْبِيهِ ؛ لِأَنَّا قَدْ رَأَيْنَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ أَبَاحَ قَتْلَ الْغُرَابِ  وَالْحِدَأَةِ  وَالْفَأْرَةِ  ، وَأَكْلُ لُحُومِ هَؤُلَاءِ مُبَاحٌ عِنْدَكُمْ ، فَلَمْ يَكُنْ إِبَاحَةُ أَكْلِهِنَّ مِمَّا يُوجِبُ  حُرْمَةَ  قَتْلِهِنَّ .  فَكَذَلِكَ الضَّبُعُ لَيْسَ إِبَاحَةُ أَكْلِهَا أَوْجَبَ  حُرْمَةَ  قَتْلِهَا ، وَإِنَّمَا مَنَعَ مِنْ قَتْلِهَا أَنَّهَا صَيْدٌ ، وَإِنْ كَانَتْ سَبُعًا فَكُلُّ  السِّبَاعِ  كَذَلِكَ إِلَّا الْكَلْبَ الَّذِي خَصَّهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِمَا خَصَّهُ بِهِ .  فَإِنْ قَالَ قَائِلٌ : فَكَيْفَ تَكُونُ سَائِرُ  السِّبَاعِ  كَذَلِكَ ، وَهِيَ لَا تُؤْكَلُ ؟         [2/168]      قِيلَ لَهُ : قَدْ يَكُونُ مِنَ الصَّيْدِ مَا لَا يُؤْكَلُ ، وَمُبَاحٌ لِلرَّجُلِ صَيْدُهُ لِيُطْعِمَهُ كِلَابَهُ ، إِذَا كَانَ فِي الْحِلِّ حَلَالًا  .  وَقَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي قَتْلِ الْحَيَّةِ أَيْضًا فِي الْحَرَمِ مَا .","","Sharh Ma'ani al-Athar 3782","","أبو سعيد الخدري عن عبد الرحمن بن أبي نعم البجلي عن يزيد بن أبي زياد القرشي عن موسى بن أعين الجزري عن علي بن معبد العبدي عن محمد بن حميد بن هشام الرعيني عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3542","3783  -  حَدَّثَنَا  أَبُو أُمَيَّةَ ، قَالَ :  ثَنَا  مُوسَى بْنُ دَاوُدَ ، قَالَ :  ثَنَا  حَفْصٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَبْدِ اللهِ قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِقَتْلِ الْحَيَّةِ  ، وَنَحْنُ  بِمِنًى  .  فَقَدْ دَلَّ ذَلِكَ أَنَّ سَائِرَ الْهَوَامِّ مُبَاحٌ قَتْلُهُ فِي الْإِحْرَامِ وَالْحَرَمِ  ، وَجَمِيعُ مَا صَحَّحْنَا فِي هَذَا الْبَابِ هُوَ قَوْلُ  أَبِي حَنِيفَةَ  ،  وَأَبِي يُوسُفَ  وَمُحَمَّدٍ  ، رَحِمَهُمُ اللهُ تَعَالَى ، غَيْرَ الذِّئْبِ ؛ فَإِنَّهُمْ جَعَلُوهُ فِي ذَلِكَ كَالْكَلْبِ سَوَاءً .","","Sharh Ma'ani al-Athar 3783","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن حفص بن غياث النخعي عن موسى بن داود الخلقاني عن محمد بن إبراهيم بن مسلم السجستاني عن الطحاوي","باب ما يقتل المحرم من الدواب"
"3543","12 - بَابُ الصَّيْدِ يَذْبَحُهُ الْحَلَالُ فِي الْحِلِّ ، هَلْ لِلْمُحْرِمِ أَنْ يَأْكُلَ مِنْهُ أَمْ لَا ؟  3784  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ . (  ح  ) .  3785  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ  عَنْ  أَبِيهِ  ،  أَنَّ  عُثْمَانَ بْنَ عَفَّانَ  رَضِيَ اللهُ عَنْهُ نَزَلَ  قُدَيْدًا  ، فَأُتِيَ  بِالْحَجَلِ  فِي الْجِفَانِ شَائِلَةً بِأَرْجُلِهَا ، فَأَرْسَلَ إِلَى  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ ، فَجَاءَهُ وَالْخَبَطُ يَتَحَاتُّ مِنْ يَدَيْهِ ، فَأَمْسَكَ عَلِيٌّ رَضِيَ اللهُ عَنْهُ فَأَمْسَكَ النَّاسُ ،  فَقَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : مَنْ هَهُنَا مِنْ  أَشْجَعَ  ؟ هَلْ عَلِمْتُمْ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جَاءَهُ  أَعْرَابِيٌّ  بِبَيْضَاتٍ وَبِتَمِيرٍ -  أَيْ : بِحَمِيرِ وَحْشٍ  - فَقَالَ :  أَطْعِمْهُنَّ أَهْلَكَ ، فَإِنَّا حُرُمٌ  . قَالُوا : نَعَمْ  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى هَذَا الْحَدِيثِ ، فَقَالُوا : لَا يَحِلُّ لِلْمُحْرِمِ أَنْ يَأْكُلَ لَحْمَ صَيْدٍ قَدْ ذَبَحَهُ حَلَالٌ ؛ لِأَنَّ الصَّيْدَ نَفْسَهُ حَرَامٌ عَلَيْهِ ، فَلَحْمُهُ أَيْضًا حَرَامٌ عَلَيْهِ  . وَاحْتَجُّوا فِي ذَلِكَ أَيْضًا بِمَا .","","Sharh Ma'ani al-Athar 3784","","علي بن أبي طالب عن عبد الله بن الحارث بن نوفل عن إسحاق بن عبد الله بن الحارث النوفلي عن علي بن زيد بن جدعان عن حماد بن سلمة عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3544","3786  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ ، قَالَ :  ثَنَا  أُبَيٌّ  ، قَالَ :  ثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُتِيَ بِلَحْمِ صَيْدٍ وَهُوَ مُحْرِمٌ  ، فَلَمْ يَأْكُلْهُ  .","","Sharh Ma'ani al-Athar 3786","","علي بن أبي طالب عن عبد الله بن عباس عن عبد الله بن الحارث بن نوفل عن عبد الكريم بن أبي المخارق عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن فهد بن سليمان الدلال عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3545","3787  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  قَيْسِ بْنِ مُسْلِمٍ الْجَدَلِيِّ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ         [2/169]      رَضِيَ اللهُ عَنْهُ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُهْدِيَ لَهُ  وَشِيقَةُ  ظَبْيٍ وَهُوَ مُحْرِمٌ  ، فَرَدَّهُ  .  قَالَ  يُونُسُ  : سَمِعْتُهُ كُلَّهُ مِنْ  سُفْيَانَ  ، غَيْرَ قَوْلِهِ : (  وَشِيقَةُ  ) ، فَإِنِّي لَمْ أَفْهَمْ ذَلِكَ مِنْهُ ،  وَحَدَّثَنِيهِ  بَعْضُ أَصْحَابِنَا عَنْهُ  .  وَلَيْسَ فِي هَذَا الْحَدِيثِ ذِكْرُ عِلَّةِ رَدِّهِ لَحْمَ الصَّيْدِ مَا هِيَ ؟ فَقَدْ يُحْتَمَلُ أَنْ يَكُونَ ذَلِكَ لِعِلَّةِ الْإِحْرَامِ ، وَيُحْتَمَلُ أَنْ يَكُونَ لِغَيْرِ ذَلِكَ ، فَلَا دَلَالَةَ فِي هَذَا الْحَدِيثِ لِأَحَدٍ .  وَقَدْ رُوِيَ عَنْ  عَائِشَةَ  رَضِيَ اللهُ عَنْهَا مِنْ رَأْيِهَا فِي الصَّيْدِ يَصِيدُهُ الْحَلَالُ فَيَذْبَحُهُ ، أَنَّهُ لَا بَأْسَ بِأَكْلِهِ لِلْمُحْرِمِ .","","Sharh Ma'ani al-Athar 3787","","عائشة بنت أبي بكر الصديق عن الحسن بن محمد بن علي بن أبي طالب عن قيس بن مسلم الجدلي عن عبد الكريم بن أبي المخارق عن سفيان بن عيينة عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3546","3788  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  حَدَّثَنِي  شَيْخٌ كَخَيْرِ الشُّيُوخِ - يُقَالُ لَهُ : ( عُبَيْدُ اللهِ بْنُ عِمْرَانَ الْقَرِيعِيُّ  ) - قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ شَمَّاسٍ ، يَقُولُ :  أَتَيْتُ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، فَسَأَلْتُهَا عَنْ لَحْمِ الصَّيْدِ ، يَصِيدُهُ الْحَلَالُ ثُمَّ يُهْدِيهِ لِلْمُحْرِمِ  .  فَقَالَتِ : اخْتَلَفَ فِيهِ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَمِنْهُمْ مَنْ حَرَّمَهُ ، وَمِنْهُمْ مَنْ أَحَلَّهُ ، وَمَا أَرَى بِشَيْءٍ مِنْهُ بَأْسًا .  في طبعة عالم الكتب : ( الفريغي ) والمثبت من النسخة الأزهرية ، وينظر ترجمته في مغاني الأخيار 3 / 327].","","Sharh Ma'ani al-Athar 3788","","عائشة بنت أبي بكر الصديق عن عبيد الله بن شماس المصري عن عبيد الله بن عمران القريعي عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3547","3789  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبٌ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  عِمْرَانَ بْنِ عُبَيْدِ اللهِ ، أَوْ عُبَيْدِ اللهِ بْنِ عِمْرَانَ  - رَجُلٍ مِنْ  بَنِي تَمِيمٍ  -  عَنْ  عَبْدِ اللهِ بْنِ شَمَّاسٍ ،  عَنْ  عَائِشَةَ رَضِيَ اللهُ عَنْهَا ، مِثْلَهُ .  فَهَذِهِ  عَائِشَةُ  رَضِيَ اللهُ عَنْهَا لَمْ يَكُنْ رَدُّ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَحْمَ الصَّيْدِ عَلَى الْحَلَالِ عِنْدَهَا ، عَلَى مَا قَدْ دَلَّهَا عَلَى  حُرْمَتِهِ  عَلَى الْمُحْرِمِ .  وَاحْتَجُّوا فِي ذَلِكَ أَيْضًا بِمَا","","Sharh Ma'ani al-Athar 3789","","عائشة بنت أبي بكر الصديق عن عبيد الله بن شماس المصري عن عبيد الله بن عمران القريعي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3548","3790  -  حَدَّثَنَا  أَبُو بِشْرٍ الرَّقِّيُّ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، أَنَّهُ قَالَ لِزَيْدِ بْنِ أَرْقَمَ :  حَدَّثْتَنِي  أَنْتَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُهْدِيَ لَهُ عُضْوُ صَيْدٍ ، وَهُوَ مُحْرِمٌ  ، فَلَمْ يَقْبَلْهُ  .","","Sharh Ma'ani al-Athar 3790","","زيد بن أرقم الأنصاري عن عبد الله بن عباس عن طاوس بن كيسان عن الحسن بن مسلم بن يناق عن ابن جريج عن حجاج بن محمد الأعور عن عبد الملك بن مروان الأهوازي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3549","3791  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمٍ ،  عَنْ  طَاوُسٍ ، قَالَ : لَمَّا قَدِمَ  زَيْدُ بْنُ أَرْقَمَ  أَتَاهُ ابْنُ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، فَقَالَ :  أَهْدَى  رَجُلٌ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَحْمَ صَيْدٍ فَرَدَّهُ  ، وَقَالَ : إِنِّي حَرَامٌ  .","","Sharh Ma'ani al-Athar 3791","","عبد الله بن عباس عن طاوس بن كيسان عن الحسن بن مسلم بن يناق عن ابن جريج عن أبو عاصم النبيل عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3550","3792  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَيْسٍ ،  عَنْ  عَطَاءٍ ،  أَنَّ  ابْنَ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ لِزَيْدِ بْنِ أَرْقَمَ :  هَلْ عَلِمْتَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُهْدِيَ لَهُ عُضْوُ صَيْدٍ وَهُوَ مُحْرِمٌ ، فَلَمْ يَقْبَلْهُ ؟  قَالَ : نَعَمْ .  فَهَذَا أَيْضًا مِثْلُ حَدِيثِ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَفِيهِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا رَدَّ ذَلِكَ الْعُضْوَ عَلَى الَّذِي أَهْدَاهُ إِلَيْهِ ؛ لِأَنَّهُ حَرَامٌ .  وَاحْتَجُّوا فِي ذَلِكَ أَيْضًا بِمَا .","","Sharh Ma'ani al-Athar 3792","","زيد بن أرقم الأنصاري عن عطاء بن أبي رباح عن قيس بن سعد الحبشي عن حماد بن سلمة عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3551","3793  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  سُفْيَانُ بْنُ  عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنِ  الصَّعْبِ بْنِ جَثَّامَةَ ، قَالَ :  مَرَّ بِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا  بِالْأَبْوَاءِ  وَبِوَدَّانَ  ،         [2/170]      فَأَهْدَيْتُ لَهُ لَحْمَ حِمَارِ وَحْشٍ ، فَرَدَّهُ عَلَيَّ ، فَلَمَّا رَأَى الْكَرَاهَةَ فِي وَجْهِي ، قَالَ :  لَيْسَ بِنَا رَدٌّ عَلَيْكَ ، وَلَكِنَّا حُرُمٌ  .  في طبعة عالم الكتب : ( سفيان عن عيينة ) والمثبت من النسخة الأزهرية","","Sharh Ma'ani al-Athar 3793","","الصعب بن جثامة الطائفى عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3552","3794  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبٍ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَقِيلَ لَهُمْ :  هَذَا حَدِيثٌ  مُضْطَرِبٌ  ، قَدْ رَوَاهُ قَوْمٌ عَلَى مَا ذَكَرْنَا ، وَرَوَاهُ آخَرُونَ ، فَقَالُوا : إِنَّمَا أَهْدَى إِلَيْهِ حِمَارًا وَحْشِيًّا  .","","Sharh Ma'ani al-Athar 3794","","الصعب بن جثامة الطائفى عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن إسحاق بن راشد الجزري عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن أسد السنة عن سليمان بن شعيب الكيساني عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3553","3795  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ  الصَّعْبَ بْنَ جَثَّامَةَ  أَهْدَى لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِمَارًا وَحْشِيًّا  ، ثُمَّ ذَكَرَ مِثْلَ حَدِيثِهِ عَنْ  سُفْيَانَ  .","","Sharh Ma'ani al-Athar 3795","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3554","3796  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  ابْنُ أَبِي ذِئْبٍ ،  عَنِ  ابْنِ شِهَابٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3796","","الصعب بن جثامة الطائفى عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3555","3797  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  شُعَيْبُ بْنُ اللَّيْثِ ،  عَنْ  أَبِيهِ  ،  عَنِ  الزُّهْرِيِّ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَفِي هَذِهِ الْأَحَادِيثِ أَنَّ الْهَدِيَّةَ الَّتِي رَدَّهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  الصَّعْبِ  مِنْ أَجْلِ أَنَّهُ حَرَامٌ ، كَانَتْ حِمَارًا وَحْشِيًّا .  فَإِنْ كَانَ ذَلِكَ كَذَلِكَ ، فَإِنَّ هَذَا لَا يَخْتَلِفُ أَحَدٌ فِي  حُرْمَتِهِ  عَلَى الْمُحْرِمِ . غَيْرَ أَنَّ  سَعِيدَ بْنَ جُبَيْرٍ  رَضِيَ اللهُ عَنْهُ قَدْ رَوَى هَذَا الْحَدِيثَ عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا ، فَزَادَ فِيهِ حَرْفًا عَلَى مَا رَوَاهُ  عُبَيْدُ اللهِ  ، بَيَّنَ بِذَلِكَ الْحَرْفِ أَنَّ الْحِمَارَ كَانَ مَذْبُوحًا  .","","Sharh Ma'ani al-Athar 3797","","الصعب بن جثامة الطائفى عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن الليث بن سعد عن شعيب بن الليث المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3556","3798  -  حَدَّثَنَا  حُسَيْنُ بْنُ نَصْرٍ ، قَالَ :  ثَنَا  الْفِرْيَابِيُّ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الْهُذَيْلِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ  الصَّعْبَ بْنَ جَثَّامَةَ  أَهْدَى لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِمَارًا وَحْشِيًّا فَرَدَّهُ  ، وَكَانَ مَذْبُوحًا  .","","Sharh Ma'ani al-Athar 3798","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن غالب بن الهذيل الأودي عن سفيان الثوري عن محمد بن يوسف الفريابي عن الحسين بن نصر بن معارك البغدادي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3557","3799  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  أَبُو دَاوُدَ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ  الصَّعْبَ بْنَ جَثَّامَةَ  أَهْدَى لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِمَارًا وَحْشِيًّا يَقْطُرُ دَمًا  ، فَرَدَّهُ عَلَيْهِ ، وَقَالَ : إِنِّي حَرَامٌ  .  فَفِي هَذَا الْحَدِيثِ : أَنَّ ذَلِكَ كَانَ مَذْبُوحًا ، وَقَدْ رَدَّهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؛ لِأَنَّهُ حَرَامٌ . وَقَدْ رُوِيَ أَيْضًا عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  رَضِيَ اللهُ عَنْهُ عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا أَنَّهُ كَانَ عَجُزَ حِمَارِ وَحْشٍ أَوْ فَخِذَ حِمَارٍ .","","Sharh Ma'ani al-Athar 3799","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن حبيب بن أبي ثابت الكاهلي عن شعبة بن الحجاج عن أبو داود الطيالسي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3558","3800  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  حَدَّثَنِي  أَبُو عَامِرٍ ، وَوَهْبٌ ،  عَنْ  شُعْبَةَ ،  عَنِ  الْحَكَمِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ  الصَّعْبَ بْنَ جَثَّامَةَ  أَهْدَى لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَجُزَ حِمَارِ وَحْشٍ  ، وَهُوَ  بِقُدَيْدٍ  ، يَقْطُرُ دَمًا ، فَرَدَّهُ  .","","Sharh Ma'ani al-Athar 3800","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن أبو عامر العقدي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3559","[2/171]      3801  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، قَالَ :  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  مَنْصُورًا  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ . غَيْرَ أَنَّهُ قَالَ : ( رِجْلَ حِمَارٍ ) .","","Sharh Ma'ani al-Athar 3801","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن الحكم بن عتيبة الكندي عن منصور بن المعتمر عن معتمر بن سليمان عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3560","3802  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ، وَحَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ  الصَّعْبَ بْنَ جَثَّامَةَ  أَهْدَى إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، قَالَ أَحَدُهُمَا : عَجُزَ حِمَارٍ ، وَقَالَ الْآخَرُ : فَخِذَ حِمَارِ وَحْشٍ ، يَقْطُرُ دَمًا ، فَرَدَّهُ  .  فَقَدِ اتَّفَقَتْ هَذِهِ الْآثَارُ الْمَرْوِيَّةُ عَنِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا فِي حَدِيثِ  الصَّعْبِ  عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي رَدِّهِ الْهَدِيَّةَ عَلَيْهِ ، أَنَّهَا كَانَتْ فِي لَحْمِ صَيْدٍ غَيْرِ حَيٍّ ، فَذَلِكَ حُجَّةٌ لِمَنْ كَرِهَ لِلْمُحْرِمِ أَكْلَ لَحْمِ الصَّيْدِ ، وَأَنَّهُ كَانَ الَّذِي تَوَلَّى صَيْدَهُ وَذَبَحَهُ حَلَالًا  .  وَقَدْ رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خِلَافُ ذَلِكَ .","","Sharh Ma'ani al-Athar 3802","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن حبيب بن أبي ثابت الكاهلي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أحمد بن داود بن موسى السدوسي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3561","3803  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  ابْنُ وَهْبٍ ، قَالَ :  أَخْبَرَنِي  يَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ ، وَيَحْيَى بْنُ عَبْدِ اللهِ بْنِ سَالِمٍ ،  عَنْ  عَمْرٍو مَوْلَى الْمُطَّلِبِ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَحْمُ الصَّيْدِ حَلَالٌ لَكُمْ ، وَأَنْتُمْ حُرُمٌ  ، مَا لَمْ تَصِيدُوهُ ، أَوْ يُصَادَ لَكُمْ  .","","Sharh Ma'ani al-Athar 3803","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن المطلب بن عبد الله بن حنطب المخزومي عن عمرو بن أبي عمرو المخزومي عن يحيى بن عبد الله بن سالم بن عبد الله بن عمر عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3562","3803  (م)  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  عَمْرِو بْنِ أَبِي عَمْرٍو ،  عَنْ  رَجُلٍ مِنَ الْأَنْصَارِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .","","Sharh Ma'ani al-Athar 3803","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن رجل من الأنصار عن عمرو بن أبي عمرو المخزومي عن عبد العزيز بن محمد الدراوردي عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3563","3804  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  ابْنُ أَبِي مَرْيَمَ ، قَالَ :  أَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ ، قَالَ :  حَدَّثَنِي  عَمْرُو بْنُ أَبِي عَمْرٍو ،  عَنِ  الْمُطَّلِبِ ،  عَنْ  أَبِي مُوسَى ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ .  فَذَهَبَ قَوْمٌ إِلَى هَذَا ، فَقَالُوا : كُلُّ صَيْدٍ صِيدَ مِنْ أَجْلِ مُحْرِمٍ ، وَإِنْ كَانَ الَّذِي صَادَهُ حَلَالًا ، فَهُوَ حَرَامٌ عَلَى ذَلِكَ الْمُحْرِمِ ، كَمَا يَحْرُمُ عَلَيْهِ مَا تَوَلَّى هُوَ صَيْدَهُ بِنَفْسِهِ .  وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ فَقَالُوا : كُلُّ صَيْدٍ صَادَهُ حَلَالٌ ، فَلَحْمُهُ حَلَالٌ لِكُلِّ مُحْرِمٍ وَحَلَالٍ .  وَكَانَ مِنَ الْحُجَّةِ لَهُمْ فِي حَدِيثِ  الْمُطَّلِبِ  الَّذِي ذَكَرْنَا ، أَنَّ قَوْلَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَوْ يُصَادَ لَكُمْ ، يُحْتَمَلُ أَنْ يَكُونَ أَرَادَ بِهِ : "" أَوْ يُصَادَ لَكُمْ بِأَمْرِكُمْ "" ، فَإِنْ كَانَ ذَلِكَ كَذَلِكَ ، فَإِنَّهُمْ أَيْضًا كَذَلِكَ يَقُولُونَ : كُلُّ صَيْدٍ صَادَهُ حَلَالٌ لِمُحْرِمٍ بِأَمْرِهِ ، فَهُوَ حَرَامٌ عَلَى ذَلِكَ الْمُحْرِمِ .  وَقَدْ رُوِيَتْ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَحَادِيثُ جَاءَتْ مَجِيئًا مُتَوَاتِرًا فِي إِبَاحَةِ لَحْمِ الصَّيْدِ الَّذِي قَدْ صَادَهُ الْحَلَالُ لِلْمُحْرِمِ إِذَا لَمْ يَكُنْ صَادَهُ بِأَمْرِهِ ، وَلَا بِمَعُونَتِهِ إِيَّاهُ عَلَيْهِ  .","","Sharh Ma'ani al-Athar 3804","","أبو موسى الأشعري عن المطلب بن عبد الله بن حنطب المخزومي عن عمرو بن أبي عمرو المخزومي عن إبراهيم بن سويد بن حيان عن سعيد بن الحكم الجمحي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3564","3805  -  حَدَّثَنَا  أَبُو بِشْرٍ الرَّقِّيُّ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنْ  مُعَاذِ بْنِ عَبْدِ الرَّحْمَنِ التَّيْمِيِّ ،  عَنْ  أَبِيهِ عَبْدِ الرَّحْمَنِ بْنِ عُثْمَانَ  ، قَالَ :  كُنَّا مَعَ طَلْحَةَ بْنِ عُبَيْدِ اللهِ وَنَحْنُ حُرُمٌ ، فَأُهْدِيَ لَهُ طَيْرٌ ،  وَطَلْحَةُ  رَاقِدٌ ، فَمِنَّا مَنْ أَكَلَ ، وَمِنَّا مَنْ تَوَرَّعَ  .         [2/172]      فَلَمَّا اسْتَيْقَظَ  طَلْحَةُ  ، وَقُدِّمَ بَيْنَ يَدَيْهِ ، أَكَلَهُ فِيمَنْ أَكَلَهُ  ، وَقَالَ : أَكَلْتُهُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Sharh Ma'ani al-Athar 3805","","طلحة بن عبيد الله بن عثمان الفياض عن عبد الرحمن بن عثمان القرشي شارب الذهب عن معاذ بن عبد الرحمن بن عثمان الطلحى عن محمد بن المنكدر عن ابن جريج عن حجاج بن محمد الأعور عن عبد الملك بن مروان الأهوازي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3565","3806  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ قَالَ :  ثَنَا  يَزِيدُ بْنُ هَارُونَ قَالَ :  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  عُمَيْرِ بْنِ سَلَمَةَ ،  عَنْ  رَجُلٍ مِنْ بَهْزٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ  بِالرَّوْحَاءِ  ، فَإِذَا هُوَ بِحِمَارِ وَحْشٍ  عَقِيرٍ  ، فِيهِ  سَهْمٌ  ، قَدْ مَاتَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَعُوهُ حَتَّى يَجِيءَ صَاحِبُهُ  .  فَجَاءَ  الْبَهْزِيُّ  ، فَقَالَ : يَا رَسُولَ اللهِ : هِيَ رَمْيَتِي فَكُلُوهُ ، فَأَمَرَ  أَبَا بَكْرٍ  أَنْ يَقْسِمَهُ بَيْنَ الرِّفَاقِ وَهُمْ مُحْرِمُونَ ، ثُمَّ سَارَ حَتَّى إِذَا كَانَ بِالْأُثَايَةِ ، إِذَا هُوَ بِظَبْيٍ مُسْتَظِلٍّ فِي حُقْفِ جَبَلٍ ، فِيهِ  سَهْمٌ  وَهُوَ حَيٌّ .  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِرَجُلٍ  : قِفْ هَهُنَا لَا يَرَاهُ أَحَدٌ حَتَّى تَمْضِيَ الرِّفَاقُ  .","","Sharh Ma'ani al-Athar 3806","","أحد الصحابة عن عمير بن سلمة الضمري عن عيسى بن طلحة التيمي عن محمد بن إبراهيم بن الحارث التيمي عن يحيى بن سعيد الأنصاري عن يزيد بن هارون عن يزيد بن سنان القزاز عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3566","3807  -  حَدَّثَنَا  يُونُسُ قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ رَضِيَ اللهُ عَنْهُ أَنَّهُ قَالَ :  أَخْبَرَنِي  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ، ثُمَّ ذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3807","","أحد الصحابة عن عمير بن سلمة الضمري عن عيسى بن طلحة التيمي عن محمد بن إبراهيم بن الحارث التيمي عن يحيى بن سعيد الأنصاري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3567","3808  -  حَدَّثَنَا  رَبِيعٌ الْجِيزِيُّ قَالَ :  ثَنَا  أَبُو الْأَسْوَدِ ، قَالَ :  أَنَا  نَافِعُ بْنُ يَزِيدَ ،  عَنِ  ابْنِ الْهَادِ ، أَنَّ مُحَمَّدَ بْنَ إِبْرَاهِيمَ ،  حَدَّثَهُ  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  عُمَيْرِ بْنِ سَلَمَةَ الضَّمْرِيِّ قَالَ :  بَيْنَا نَحْنُ نَسِيرُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِبَعْضِ أَفْنَاءِ  الرَّوْحَاءِ  وَهُوَ مُحْرِمٌ ، إِذَا حِمَارٌ مَعْقُورٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَعُوهُ ،  فَيُوشِكُ  صَاحِبُهُ أَنْ يَأْتِيَهُ  ، فَجَاءَ  رَجُلٌ مِنْ بَهْزٍ  ، هُوَ الَّذِي عَقَرَ الْحِمَارَ ، فَقَالَ : يَا رَسُولَ اللهِ ، شَأْنَكُمْ بِهَذَا الْحِمَارِ ، فَأَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَبَا بَكْرٍ  رَضِيَ اللهُ عَنْهُ فَقَسَّمَهُ بَيْنَ النَّاسِ  .  ثُمَّ ذَكَرَ نَحْوَ مَا فِي حَدِيثِ  يَزِيدَ  عَنْ  يَزِيدَ بْنِ هَارُونَ  .","","Sharh Ma'ani al-Athar 3808","","عمير بن سلمة الضمري عن عيسى بن طلحة التيمي عن محمد بن إبراهيم بن الحارث التيمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن نافع بن يزيد الكلاعي عن النضر بن عبد الجبار المرادي عن الربيع بن سليمان الجيزي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3568","3809  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ وَفَهْدٌ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  ابْنُ الْهَادِ ، ثُمَّ ذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَفِي حَدِيثِ  طَلْحَةَ  وَعُمَيْرِ بْنِ سَلَمَةَ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ أَبَاحَ لِلْمُحْرِمِينَ أَكْلَ لَحْمِ الصَّيْدِ الَّذِي تَوَلَّى صَيْدَهُ الْحَلَالُ .         [2/173]      فَقَدْ خَالَفَ ذَلِكَ حَدِيثَ  عَلِيٍّ  وَزَيْدِ بْنِ أَرْقَمَ  وَالصَّعْبِ بْنِ جَثَّامَةَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . غَيْرَ أَنَّ حَدِيثَ  طَلْحَةَ  ، وَحَدِيثَ  عُمَيْرِ بْنِ سَلَمَةَ  هَذَيْنِ لَيْسَ فِيهِمَا دَلِيلٌ عَلَى حُكْمِ الصَّيْدِ إِذَا أَرَادَ الْحَلَالُ بِهِ الْمُحْرِمَ  .","","Sharh Ma'ani al-Athar 3809","","عمير بن سلمة الضمري عن عيسى بن طلحة التيمي عن محمد بن إبراهيم بن الحارث التيمي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن عبد الله بن صالح المصري عن فهد بن سليمان الدلال عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3569","3810  -  فَنَظَرْنَا فِي ذَلِكَ فَإِذَا ابْنُ أَبِي دَاوُدَ قَدْ  حَدَّثَنَا  قَالَ :  ثَنَا  عَيَّاشُ بْنُ الْوَلِيدِ الرَّقَّامُ ، قَالَ :  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  عُبَيْدِ اللهِ ،  عَنْ  عِيَاضِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَبَا قَتَادَةَ الْأَنْصَارِيَّ  عَلَى الصَّدَقَةِ  ، وَخَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ ، وَهُمْ مُحْرِمُونَ حَتَّى نَزَلُوا  عُسْفَانَ  ، فَإِذَا هُمْ بِحِمَارِ وَحْشٍ .  قَالَ : وَجَاءَ  أَبُو قَتَادَةَ  وَهُوَ  حِلٌّ  ، فَنَكَّسُوا رُءُوسَهُمْ كَرَاهِيَةَ أَنْ يُحِدُّوا أَبْصَارَهُمْ ، فَيَفْطُنَ ، فَرَآهُ فَرَكِبَ فَرَسَهُ وَأَخَذَ الرُّمْحَ ، فَسَقَطَ مِنْهُ ، فَقَالَ : نَاوِلُونِيهِ .  فَقَالُوا : مَا نَحْنُ بِمُعِينِيكَ عَلَيْهِ بِشَيْءٍ ، فَحَمَلَ عَلَيْهِ فَعَقَرَهُ فَجَعَلُوا يَشْوُونَ مِنْهُ ، ثُمَّ قَالُوا : رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ أَظْهُرِنَا . قَالَ : وَكَانَ تَقَدَّمَهُمْ ، فَلَحِقُوهُ ، فَسَأَلُوهُ ، فَلَمْ يَرَ بِذَلِكَ بَأْسًا  .","","Sharh Ma'ani al-Athar 3810","","أبو سعيد الخدري عن عياض بن عبد الله بن سعد العامري عن عبيد الله بن عمر العمري عن عبد الأعلى بن عبد الأعلى القرشي عن عياش بن الوليد الرقام عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3570","3811  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ قَالَ :  ثَنَا  أَبُو عُمَرَ الْحَوْضِيُّ ، قَالَ :  أَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  عَمْرُو بْنُ يَحْيَى ،  عَنْ  عَبَّادِ بْنِ تَمِيمٍ ،  عَنْ  أَبِي قَتَادَةَ ،  أَنَّهُ كَانَ عَلَى فَرَسٍ وَهُوَ حَلَالٌ ، وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ مُحْرِمُونَ  ، فَبَصُرَ بِحِمَارِ وَحْشٍ ، فَنَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُعِينُوهُ ، فَحَمَلَ عَلَيْهِ فَصَرَعَ  أَتَانًا  ، فَأَكَلُوا مِنْهُ  .","","Sharh Ma'ani al-Athar 3811","","أبو قتادة الأنصاري فارس رسول الله عن عباد بن تميم الخزرجي عن عمرو بن يحيى بن عمارة المازني عن خالد بن عبد الله الطحان عن حفص بن عمر الحوضى عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3571","3812  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ قَالَ :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ، قَالَ :  ثَنَا  شُعْبَةُ ، قَالَ :  أَخْبَرَنِي  عُثْمَانُ بْنُ عَبْدِ اللهِ بْنِ مَوْهَبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي قَتَادَةَ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ كَانَ فِي قَوْمٍ مُحْرِمِينَ ، وَلَيْسَ هُوَ مُحْرِمًا وَهُمْ يَسِيرُونَ ، فَرَأَى حِمَارًا ، فَرَكِبَ فَرَسَهُ فَصَرَعَهُ ، فَأَتَوُا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَسَأَلُوهُ عَنْ ذَلِكَ ، فَقَالَ :  أَشَرْتُمْ أَوْ صِدْتُمْ أَوْ قَتَلْتُمْ ؟  قَالُوا : لَا . قَالَ : فَكُلُوا .","","Sharh Ma'ani al-Athar 3812","","أبو قتادة الأنصاري فارس رسول الله عن عبد الله بن أبي قتادة السلمي عن عثمان بن عبد الله بن موهب الأعرج عن شعبة بن الحجاج عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3572","3813  -  حَدَّثَنَا  يُونُسُ قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  نَافِعٍ مَوْلَى أَبِي قَتَادَةَ ،  عَنْ  أَبِي قَتَادَةَ بْنِ رِبْعِيٍّ ،  أَنَّهُ كَانَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، حَتَّى إِذَا كَانَ بِبَعْضِ طَرِيقِ مَكَّةَ تَخَلَّفَ مَعَ أَصْحَابٍ لَهُ مُحْرِمِينَ وَهُوَ غَيْرُ مُحْرِمٍ ، فَرَأَى حِمَارًا وَحْشِيًّا فَاسْتَوَى عَلَى فَرَسِهِ ، ثُمَّ سَأَلَ أَصْحَابَهُ أَنْ يُنَاوِلُوهُ سَوْطَهُ فَأَبَوْا ، فَسَأَلَهُمْ رُمْحَهُ ، فَأَبَوْا ، فَأَخَذَهُ ثُمَّ شَدَّ عَلَى الْحِمَارِ فَقَتَلَهُ ، فَأَكَلَ مِنْهُ بَعْضُ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَبَى بَعْضُهُمْ ، فَلَمَّا أَدْرَكُوا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، سَأَلُوهُ عَنْ ذَلِكَ ، فَقَالَ :  إِنَّمَا هِيَ طُعْمَةٌ أَطْعَمَكُمُوهَا اللهُ  .","","Sharh Ma'ani al-Athar 3813","","أبو قتادة الأنصاري فارس رسول الله عن نافع بن عباس الأقرع عن سالم بن أبي أمية التيمي عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3573","3814  -  حَدَّثَنَا  يُونُسُ قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  عَنْ  زَيْدِ بْنِ أَسْلَمَ  عَنْ  عَطَاءِ بْنِ يَسَارٍ ، أَخْبَرَهُ  عَنْ         [2/174]      أَبِي قَتَادَةَ ، مِثْلَهُ . وَزَادَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  هَلْ مَعَكُمْ مِنْ لَحْمِهِ شَيْءٌ  ؟  فَقَدْ عَلِمْنَا أَنَّ  أَبَا قَتَادَةَ  لَمْ يَصِدْهُ فِي وَقْتِ مَا صَادَهُ إِرَادَةً مِنْهُ أَنْ يَكُونَ لَهُ خَاصَّةً ، وَإِنَّمَا أَرَادَ أَنْ يَكُونَ لَهُ وَلِأَصْحَابِهِ الَّذِينَ كَانُوا مَعَهُ .  فَقَدْ أَبَاحَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَلِكَ لَهُ وَلَهُمْ ، وَلَمْ يُحَرِّمْهُ عَلَيْهِمْ لِإِرَادَتِهِ أَنْ يَكُونَ لَهُمْ مَعَهُ .  وَفِي حَدِيثِ  عُثْمَانَ بْنِ عَبْدِ اللهِ بْنِ مَوْهَبٍ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَأَلَهُمْ ، فَقَالَ : أَشَرْتُمْ ، أَوْ صِدْتُمْ ، أَوْ قَتَلْتُمْ ؟ قَالُوا : لَا . قَالَ : فَكُلُوا .  فَدَلَّ ذَلِكَ أَنَّهُ إِنَّمَا يَحْرُمُ عَلَيْهِمْ إِذَا فَعَلُوا شَيْئًا مِنْ هَذَا ، وَلَا يَحْرُمُ عَلَيْهِمْ بِمَا سِوَى ذَلِكَ .  وَفِي ذَلِكَ دَلِيلٌ أَنَّ مَعْنَى قَوْلِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَدِيثِ  عَمْرٍو مَوْلَى الْمُطَّلِبِ  : أَوْ يُصَادَ لَكُمْ ، أَنَّهُ عَلَى مَا صِيدَ لَهُمْ بِأَمْرِهِمْ  .  فَهَذَا وَجْهُ هَذَا الْبَابِ مِنْ طَرِيقِ الْآثَارِ الْمَرْوِيَّةِ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَدْ قَالَ بِهَذَا الْقَوْلِ أَيْضًا  عُمَرُ بْنُ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ  .","","Sharh Ma'ani al-Athar 3814","","أبو قتادة الأنصاري فارس رسول الله عن عطاء بن يسار الهلالي عن زيد بن أسلم عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3574","3815  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  هَارُونُ بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ ، قَالَ :  ثَنَا  يَحْيَى بْنُ أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَجُلًا مِنْ  أَهْلِ الشَّامِ  اسْتَفْتَاهُ فِي لَحْمِ الصَّيْدِ وَهُوَ مُحْرِمٌ ، فَأَمَرَهُ بِأَكْلِهِ  . قَالَ :  فَلَقِيتُ  عُمَرَ بْنَ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ فَأَخْبَرْتُهُ بِمَسْأَلَةِ الرَّجُلِ ، فَقَالَ : بِمَا أَفْتَيْتَهُ . فَقُلْتُ : بِأَكْلِهِ . فَقَالَ : وَالَّذِي نَفْسِي بِيَدِهِ لَوْ أَفْتَيْتَهُ بِغَيْرِ ذَلِكَ ، لَعَلَوْتُكَ بِالدِّرَّةِ ، إِنَّمَا نُهِيتَ أَنْ تَصْطَادَهُ  .","","Sharh Ma'ani al-Athar 3815","","أبو هريرة الدوسي عن يحيى بن أبي سلمة عن علي بن المبارك الهنائي عن هارون بن إسماعيل الخزاز عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3575","3816  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  أَنَّهُ سَمِعَ  سَعِيدَ بْنَ الْمُسَيِّبِ  يُحَدِّثُ عَنْ  أَبِي هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ ، فَذَكَرَ مِثْلَهُ . غَيْرَ أَنَّهُ قَالَ : (  لَفَعَلْتُ بِكَ  ) . يَتَوَعَّدُهُ  .","","Sharh Ma'ani al-Athar 3816","","أبو هريرة الدوسي عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3576","3817  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  حَدَّثَهُ  ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  أَنَّهُ سَمِعَ  أَبَا هُرَيْرَةَ رَضِيَ اللهُ عَنْهُ  يُحَدِّثُ عَنْ  عُمَرَ رَضِيَ اللهُ عَنْهُ ، فَذَكَرَ مِثْلَهُ .","","Sharh Ma'ani al-Athar 3817","","عمر بن الخطاب عن أبو هريرة الدوسي عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3577","3818  -  حَدَّثَنَا  نَصْرُ بْنُ مَرْزُوقٍ ، وَابْنُ أَبِي دَاوُدَ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  عُقَيْلٌ  عَنِ  ابْنِ شِهَابٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .  فَلَمْ يَكُنْ  عُمَرُ  رَضِيَ اللهُ عَنْهُ لِيُعَاقِبَ رَجُلًا مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي فُتْيَاهُ فِي هَذَا ، بِخِلَافِ مَا يَرَى ، وَالَّذِي عِنْدَهُ فِي ذَلِكَ مِمَّا يُخَالِفُ مَا أَفْتَى بِهِ رَأْيًا .  وَلَكِنَّ ذَلِكَ - عِنْدَنَا - وَاللهُ أَعْلَمُ - لِأَنَّهُ قَدْ كَانَ أَخَذَ عِلْمَ ذَلِكَ مِنْ غَيْرِ جِهَةِ الرَّأْيِ .","","Sharh Ma'ani al-Athar 3818","","عمر بن الخطاب عن أبو هريرة الدوسي عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3578","3819  -  حَدَّثَنَا  أَبُو بَكْرَةَ ، قَالَ :  ثَنَا  مُؤَمَّلٌ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  أَنَّ  كَعْبًا  سَأَلَ عُمَرَ رَضِيَ اللهُ عَنْهُ عَنِ الصَّيْدِ ، يَذْبَحُهُ الْحَلَالُ فَيَأْكُلُهُ الْحَرَامُ ،  فَقَالَ  :  عُمَرُ  رَضِيَ اللهُ عَنْهُ : (  لَوْ تَرَكْتَهُ لَرَأَيْتُكَ لَا تَفْقَهُ شَيْئًا  )  .         [2/175]      وَقَدِ احْتَجَّ فِي ذَلِكَ الْمُخَالِفُونَ لِهَذَا الْقَوْلِ بِمَا .","","Sharh Ma'ani al-Athar 3819","","عمر بن الخطاب عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن بكار بن قتيبة البكراوي عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3579","3820  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كُنَّا مَعَ عُثْمَانَ وَعَلِيٍّ رَضِيَ اللهُ عَنْهُمَا حَتَّى إِذَا كُنَّا بِمَكَانِ كَذَا وَكَذَا ، قُرِّبَ إِلَيْهِمْ طَعَامٌ  ، قَالَ : فَرَأَيْتُ جَفْنَةً كَأَنِّي أَنْظُرُ إِلَى عَرَاقِيبِ الْيَعَاقِيبِ ، فَلَمَّا رَأَى ذَلِكَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ قَامَ ، فَقَامَ مَعَهُ نَاسٌ ، قَالَ : فَقِيلَ : وَاللهِ مَا أَشَرْنَا ، وَلَا أَمَرْنَا ، وَلَا صِدْنَا .  فَقِيلَ  لِعُثْمَانَ  رَضِيَ اللهُ عَنْهُ : مَا قَامَ هَذَا وَمَنْ مَعَهُ إِلَّا كَرَاهِيَةً لِطَعَامِكَ .  فَدَعَاهُ ، فَقَالَ : مَا كَرِهْتَ مِنْ هَذَا ؟ فَقَالَ :  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ :         {      أُحِلَّ لَكُمْ صَيْدُ الْبَحْرِ وَطَعَامُهُ مَتَاعًا لَكُمْ وَلِلسَّيَّارَةِ وَحُرِّمَ عَلَيْكُمْ صَيْدُ الْبَرِّ مَا دُمْتُمْ حُرُمًا         }      ثُمَّ انْطَلَقَ .  قَالَ : فَذَهَبَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ إِلَى أَنَّ الصَّيْدَ وَلَحْمَهُ حَرَامٌ عَلَى الْمُحْرِمِ .  قِيلَ لَهُمْ : فَقَدْ خَالَفَهُ فِي ذَلِكَ  عُمَرُ بْنُ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ  وَطَلْحَةُ بْنُ عُبَيْدِ اللهِ  ،  وَعَائِشَةُ  رَضِيَ اللهُ عَنْهَا ،  وَأَبُو هُرَيْرَةَ  رَضِيَ اللهُ عَنْهُ ، وَقَدْ تَوَاتَرَتِ الرِّوَايَاتُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمَا يُوَافِقُ مَا ذَهَبُوا إِلَيْهِ ، وَقَوْلُ اللهِ عَزَّ وَجَلَّ :         {      وَحُرِّمَ عَلَيْكُمْ صَيْدُ الْبَرِّ مَا دُمْتُمْ حُرُمًا         }      يَحْتَمِلُ مَا حُرِّمَ عَلَيْهِمْ مِنْهُ ، هُوَ أَنْ يَصِيدُوهُ .  أَلَا تَرَى إِلَى قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا لا تَقْتُلُوا الصَّيْدَ وَأَنْتُمْ حُرُمٌ وَمَنْ قَتَلَهُ مِنْكُمْ مُتَعَمِّدًا فَجَزَاءٌ مِثْلُ مَا قَتَلَ مِنَ النَّعَمِ         }      ، فَنَهَاهُمُ اللهُ تَعَالَى فِي هَذِهِ الْآيَةِ عَنْ قَتْلِ الصَّيْدِ ، وَأَوْجَبَ عَلَيْهِمُ الْجَزَاءَ فِي قَتْلِهِمْ إِيَّاهُ .  فَدَلَّ مَا ذَكَرْنَا أَنَّ الَّذِي حُرِّمَ عَلَى الْمُحْرِمِينَ مِنَ الصَّيْدِ هُوَ قَتْلُهُ .  وَقَدْ رَأَيْنَا النَّظَرَ أَيْضًا يَدُلُّ عَلَى هَذَا ، وَذَلِكَ أَنَّهُمْ أَجْمَعُوا أَنَّ الصَّيْدَ يُحَرِّمُهُ الْإِحْرَامُ عَلَى الْمُحْرِمِ ، وَيُحَرِّمُهُ الْحَرَمُ عَلَى الْحَلَالِ .  وَكَانَ مَنْ صَادَ صَيْدًا فِي الْحِلِّ ، فَذَبَحَهُ فِي الْحِلِّ ، ثُمَّ أَدْخَلَهُ الْحَرَمَ ، فَلَا بَأْسَ بِأَكْلِهِ إِيَّاهُ فِي الْحَرَمِ ، وَلَمْ يَكُنْ إِدْخَالُهُ لَحْمَ الصَّيْدِ الْحَرَمَ كَإِدْخَالِهِ الصَّيْدَ نَفْسَهُ وَهُوَ حَيٌّ الْحَرَمَ ؛ لِأَنَّهُ لَوْ كَانَ كَذَلِكَ لَنَهَى عَنْ إِدْخَالِهِ ، وَلَصَنَعَ مِنْ أَكْلِهِ إِيَّاهُ فِيهِ كَمَا يُمْنَعُ مِنَ الصَّيْدِ فِي ذَلِكَ كُلِّهِ ، وَلَكَانَ إِذَا أَكَلَهُ فِي الْحَرَمِ وَجَبَ عَلَيْهِ مَا وَجَبَ فِي قَتْلِ الصَّيْدِ .  فَلَمَّا كَانَ الْحَرَمُ لَا يَمْنَعُ مِنْ لَحْمِ الصَّيْدِ الَّذِي صِيدَ فِي الْحِلِّ ، كَمَا يَمْنَعُ مِنَ الصَّيْدِ الْحَيِّ ، كَانَ النَّظَرُ عَلَى ذَلِكَ         [2/176]      أَنْ يَكُونَ كَذَلِكَ الْإِحْرَامُ أَيْضًا ، يَحْرُمُ عَلَى الْمُحْرِمِ الصَّيْدُ الْحَيُّ ، وَلَا يَحْرُمُ عَلَيْهِ لَحْمُهُ إِذَا تَوَلَّى الْحَلَالُ ذَبْحَهُ ، قِيَاسًا وَنَظَرًا عَلَى مَا ذَكَرْنَا مِنْ حُكْمِ الْمُحْرِمِ ، فَهَذَا هُوَ النَّظَرُ فِي هَذَا الْبَابِ ، وَهُوَ قَوْلُ  أَبِي حَنِيفَةَ  ،  وَأَبِي يُوسُفَ  ،  وَمُحَمَّدٍ  رَحِمَهُمُ اللهُ تَعَالَى  .","","Sharh Ma'ani al-Athar 3820","","علي بن أبي طالب عن الحارث بن نوفل الهاشمي عن عبد الله بن الحارث بن نوفل عن يزيد بن أبي زياد القرشي عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الصيد يذبحه الحلال في الحل هل للمحرم أن يأكل منه"
"3580","13 - بَابُ رَفْعِ الْيَدَيْنِ عِنْدَ رُؤْيَةِ  الْبَيْتِ  3821  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ، قَالَ :  ثَنَا  الْفَضْلُ بْنُ مُوسَى ، قَالَ :  ثَنَا  ابْنُ أَبِي لَيْلَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  وَعَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  تُرْفَعُ الْأَيْدِي فِي سَبْعِ مَوَاطِنَ  : فِي افْتِتَاحِ الصَّلَاةِ ، وَعِنْدَ  الْبَيْتِ  ، وَعَلَى  الصَّفَا  وَالْمَرْوَةِ  ،  وَبِعَرَفَاتٍ  ،  وَبِالْمُزْدَلِفَةِ  ، وَعِنْدَ الْجَمْرَتَيْنِ  .","","Sharh Ma'ani al-Athar 3821","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن عبد الرحمن بن أبي ليلى عن الفضل بن موسى السيناني عن نعيم بن حماد الخزاعي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب رفع اليدين عند رؤية البيت"
"3581","3822  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  الْحِمَّانِيُّ ، قَالَ :  ثَنَا  الْمُحَارِبِيُّ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .  قَالَ أَبُو جَعْفَرٍ :  فَكَانَ هَذَا الْحَدِيثُ مَأْخُوذًا بِهِ ، لَا نَعْلَمُ أَحَدًا  خَالَفَ  شَيْئًا مِنْهُ غَيْرَ رَفْعِ الْيَدَيْنِ عِنْدَ  الْبَيْتِ  ، فَإِنَّ قَوْمًا ذَهَبُوا إِلَى ذَلِكَ ، وَاحْتَجُّوا بِهَذَا الْحَدِيثِ ، وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ ، فَكَرِهُوا رَفْعَ الْيَدَيْنِ عِنْدَ رُؤْيَةِ  الْبَيْتِ  ، وَاحْتَجُّوا فِي ذَلِكَ بِمَا","","Sharh Ma'ani al-Athar 3822","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن عبد الرحمن بن أبي ليلى عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن عبد الحميد عن فهد بن سليمان الدلال عن الطحاوي","باب رفع اليدين عند رؤية البيت"
"3582","3823  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ، قَالَ :  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي قَزَعَةَ الْبَاهِلِيِّ ،  عَنِ  الْمُهَاجِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّهُ سُئِلَ عَنْ رَفْعِ الْأَيْدِي عِنْدَ  الْبَيْتِ  ، فَقَالَ : ذَاكَ شَيْءٌ يَفْعَلُهُ الْيَهُودُ  ، قَدْ حَجَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يَفْعَلْ ذَلِكَ  .  فَهَذَا  جَابِرُ بْنُ عَبْدِ اللهِ  رَضِيَ اللهُ عَنْهُ يُخْبِرُ أَنَّ ذَلِكَ مِنْ فِعْلِ الْيَهُودِ ، وَلَيْسَ مِنْ فِعْلِ أَهْلِ الْإِسْلَامِ ، وَأَنَّهُمْ قَدْ حَجُّوا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يَفْعَلْ ذَلِكَ .         [2/177]      فَإِنْ كَانَ هَذَا الْبَابُ يُؤْخَذُ مِنْ طَرِيقِ  الْإِسْنَادِ  ،  فَإِنَّ هَذَا  الْإِسْنَادَ  أَحْسَنُ مِنْ  إِسْنَادِ  الْحَدِيثِ الْأَوَّلِ  ، وَإِنْ كَانَ ذَلِكَ يُؤْخَذُ مِنْ طَرِيقِ تَصْحِيحِ مَعَانِي الْآثَارِ ، فَإِنَّ  جَابِرًا  قَدْ أَخْبَرَ أَنَّ ذَلِكَ مِنْ فِعْلِ الْيَهُودِ .  فَقَدْ يَجُوزُ أَنْ يَكُونَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِهِ عَلَى الِاقْتِدَاءِ مِنْهُ بِهِمْ ، إِذْ كَانَ حُكْمُهُ أَنْ يَكُونَ عَلَى شَرِيعَتِهِمْ ؛ لِأَنَّهُمْ أَهْلُ كِتَابٍ ، حَتَّى يُحْدِثَ اللهُ عَزَّ وَجَلَّ لَهُ شَرِيعَةً تَنْسَخُ شَرِيعَتَهُمْ ، ثُمَّ حَجَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَخَالَفَهُمْ ، فَلَمْ يَرْفَعْ يَدَيْهِ إِذًا مِنْ مُخَالَفَتِهِمْ .  فَحَدِيثُ  جَابِرٍ  أَوْلَى ؛ لِأَنَّ فِيهِ مَعَ تَصْحِيحِ هَذَيْنِ الْحَدِيثَيْنِ النَّسْخَ لِحَدِيثِ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا  وَابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا ، وَإِنْ كَانَ يُؤْخَذُ مِنْ طَرِيقِ النَّظَرِ فَإِنَّا قَدْ رَأَيْنَا الرَّفْعَ الْمَذْكُورَ فِي هَذَا الْحَدِيثِ عَلَى ضَرْبَيْنِ : فَمِنْهُ رَفْعٌ لِتَكْبِيرِ الصَّلَاةِ ، وَمِنْهُ رَفْعٌ لِلدُّعَاءِ .  فَأَمَّا مَا لِلصَّلَاةِ فَرَفْعُ الْيَدَيْنِ عِنْدَ افْتِتَاحِ الصَّلَاةِ ، وَأَمَّا مَا لِلدُّعَاءِ فَرَفْعُ الْيَدَيْنِ عِنْدَ  الصَّفَا  وَالْمَرْوَةِ  وَبِجُمْعٍ  ، وَ (  عَرَفَةَ  ) ، وَعِنْدَ الْجَمْرَتَيْنِ ، فَهَذَا مُتَّفَقٌ عَلَيْهِ  .  وَقَدْ رُوِيَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَيْضًا فِي رَفْعِ الْيَدَيْنِ  بِعَرَفَةَ  مَا .","","Sharh Ma'ani al-Athar 3823","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن مهاجر بن عكرمة المخزومي عن سويد بن حجير الباهلي عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب رفع اليدين عند رؤية البيت"
"3583","3824  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  أَنَا  حَمَّادٌ ،  عَنْ  بِشْرِ بْنِ حَرْبٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَدْعُو  بِعَرَفَةَ  وَكَانَ يَرْفَعُ يَدَيْهِ نَحْوَ  ثُنْدُوَتِهِ  .  فَأَرَدْنَا أَنْ نَنْظُرَ فِي رَفْعِ الْيَدَيْنِ عِنْدَ رُؤْيَةِ  الْبَيْتِ  ، هَلْ هُوَ كَذَلِكَ أَمْ لَا ؟ فَرَأَيْنَا الَّذِينَ ذَهَبُوا إِلَى ذَلِكَ ذَهَبُوا أَنَّهُ لَا لِعِلَّةِ الْإِحْرَامِ ، وَلَكِنْ لِتَعْظِيمِ  الْبَيْتِ  .  وَقَدْ رَأَيْنَا الرَّفْعَ  بِعَرَفَةَ  وَالْمُزْدَلِفَةِ  ، وَعِنْدَ الْجَمْرَتَيْنِ ، وَعَلَى  الصَّفَا  وَالْمَرْوَةِ  ، إِنَّمَا أَمَرَ بِذَلِكَ مِنْ طَرِيقِ الدُّعَاءِ فِي الْمَوْطِنِ الَّذِي جَعَلَ ذَلِكَ الْوُقُوفَ فِيهِ لِعِلَّةِ الْإِحْرَامِ .  وَقَدْ رَأَيْنَا مَنْ صَارَ إِلَى  عَرَفَةَ  ، أَوْ  مُزْدَلِفَةَ  ، مَوْضِعِ رَمْيِ الْجِمَارِ ، أَوِ  الصَّفَا  وَالْمَرْوَةِ  ، وَهُوَ غَيْرُ مُحْرِمٍ ، أَنَّهُ لَا يَرْفَعُ يَدَيْهِ لِتَعْظِيمِ شَيْءٍ مِنْ ذَلِكَ .  فَلَمَّا ثَبَتَ أَنَّ رَفْعَ الْيَدَيْنِ لَا يُؤْمَرُ بِهِ فِي هَذِهِ الْمَوَاطِنِ إِلَّا لِعِلَّةِ الْإِحْرَامِ ، وَلَا يُؤْمَرُ بِهِ فِي غَيْرِ الْإِحْرَامِ كَانَ كَذَلِكَ ، لَا يُؤْمَرُ بِرَفْعِ الْيَدَيْنِ لِرُؤْيَةِ  الْبَيْتِ  فِي غَيْرِ الْإِحْرَامِ .  فَإِذَا ثَبَتَ أَنْ لَا يُؤْمَرَ بِذَلِكَ فِي غَيْرِ الْإِحْرَامِ ، ثَبَتَ أَنْ لَا يُؤْمَرَ بِهِ أَيْضًا فِي الْإِحْرَامِ .  وَحُجَّةٌ أُخْرَى : أَنَّا قَدْ رَأَيْنَا مَا يُؤْمَرُ بِرَفْعِ الْيَدَيْنِ عِنْدَهُ فِي الْإِحْرَامِ مَا كَانَ مَأْمُورًا بِالْوُقُوفِ عِنْدَهُ مِنَ الْمَوَاطِنِ الَّتِي ذَكَرْنَا .  وَقَدْ رَأَيْنَا جَمْرَةَ الْعَقَبَةِ جَمْرَةً كَغَيْرِهَا مِنَ الْجِمَارِ ؛ غَيْرَ أَنَّهُ لَا يُوقَفُ عِنْدَهَا ، فَلَمْ يَكُنْ هُنَاكَ رَفْعٌ .         [2/178]      فَالنَّظَرُ عَلَى ذَلِكَ أَنْ يَكُونَ  الْبَيْتُ  لَمَّا لَمْ يَكُنْ عِنْدَهُ وُقُوفٌ ، أَنْ لَا يَكُونَ عِنْدَهُ رَفْعٌ ، قِيَاسًا وَنَظَرًا عَلَى مَا ذَكَرْنَا مِنْ ذَلِكَ .  وَهَذَا الَّذِي أَثْبَتْنَاهُ بِالنَّظَرِ ، هُوَ قَوْلُ  أَبِي حَنِيفَةَ  ،  وَأَبِي يُوسُفَ  ،  وَمُحَمَّدٍ  ، رَحِمَهُمُ اللهُ تَعَالَى .  وَقَدْ رُوِيَ فِي ذَلِكَ ، عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ  مَا .","","Sharh Ma'ani al-Athar 3824","","أبو سعيد الخدري عن بشر بن حرب عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب رفع اليدين عند رؤية البيت"
"3584","3825  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ شُعَيْبِ بْنِ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي يُوسُفَ رَضِيَ اللهُ عَنْهُ ،  عَنْ  أَبِي حَنِيفَةَ رَضِيَ اللهُ عَنْهُ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ، قَالَ : (  تُرْفَعُ الْأَيْدِي فِي سَبْعِ مَوَاطِنَ  : فِي افْتِتَاحِ الصَّلَاةِ ، وَفِي التَّكْبِيرِ  لِلْقُنُوتِ  فِي  الْوِتْرِ  ، وَفِي الْعِيدَيْنِ ، وَعِنْدَ اسْتِلَامِ الْحَجَرِ ، وَعَلَى  الصَّفَا  وَالْمَرْوَةِ  ،  وَبِجُمْعٍ  وَعَرَفَاتٍ  ، وَعِنْدَ الْمَقَامَيْنِ عِنْدَ الْجَمْرَتَيْنِ  ) .  قَالَ  أَبُو يُوسُفَ  رَحِمَهُ اللهُ : فَأَمَّا فِي افْتِتَاحِ الصَّلَاةِ فِي الْعِيدَيْنِ ، وَفِي  الْوِتْرِ  ، وَعِنْدَ اسْتِلَامِ الْحَجَرِ ، فَيَجْعَلُ ظَهْرَ كَفَّيْهِ إِلَى وَجْهِهِ ، وَأَمَّا فِي الثَّلَاثِ الْأُخَرِ ، فَيَسْتَقْبِلُ بِبَاطِنِ كَفَّيْهِ وَجْهَهُ .  فَأَمَّا مَا ذَكَرْنَا فِي افْتِتَاحِ الصَّلَاةِ ، فَقَدِ اتَّفَقَ الْمُسْلِمُونَ عَلَى ذَلِكَ جَمِيعًا .  وَأَمَّا التَّكْبِيرَةُ فِي  الْقُنُوتِ  فِي  الْوِتْرِ  ، فَإِنَّهَا تَكْبِيرَةٌ زَائِدَةٌ فِي تِلْكَ الصَّلَاةِ ، وَقَدْ أَجْمَعَ الَّذِينَ يَقْنُتُونَ قَبْلَ الرُّكُوعِ عَلَى الرَّفْعِ مَعَهَا .  فَالنَّظَرُ عَلَى ذَلِكَ أَنْ يَكُونَ كَذَلِكَ كُلُّ تَكْبِيرَةٍ زَائِدَةٍ فِي كُلِّ صَلَاةٍ ، فَتَكْبِيرُ الْعِيدَيْنِ الزَّائِدُ فِيهَا عَلَى سَائِرِ الصَّلَاةِ ، كَذَلِكَ أَيْضًا .  وَأَمَّا عِنْدَ اسْتِلَامِ الْحَجَرِ ، فَإِنَّ ذَلِكَ جُعِلَ تَكْبِيرًا يُفْتَتَحُ بِهِ الطَّوَافُ ، كَمَا يُفْتَتَحُ بِالتَّكْبِيرِ الصَّلَاةُ ، وَأَمَرَ بِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَيْضًا  .","","Sharh Ma'ani al-Athar 3825","","إبراهيم النخعي عن طلحة بن مصرف الهمداني عن أبو حنيفة النعمان عن أبو يوسف يعقوب بن إبراهيم القاضي عن شعيب بن سليمان الكيساني عن سليمان بن شعيب الكيساني عن الطحاوي","باب رفع اليدين عند رؤية البيت"
"3585","3826  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي يَعْفُورٍ الْعَبْدِيِّ ، قَالَ :  سَمِعْتُ  أَمِيرًا كَانَ عَلَى مَكَّةَ ، مِنْ طَرَفِ  الْحَجَّاجِ  عَنْهَا سَنَةَ ثَلَاثٍ وَسَبْعِينَ ، يَقُولُ :  كَانَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ رَجُلًا قَوِيًّا ، وَكَانَ يُزَاحِمُ عَلَى  الرُّكْنِ  ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  أَبَا حَفْصٍ  ، أَنْتَ رَجُلٌ قَوِيٌّ ، وَإِنَّكَ تُزَاحِمُ عَلَى  الرُّكْنِ  ، فَتُؤْذِي الضَّعِيفَ ، فَإِذَا رَأَيْتَ خَلْوَةً  فَاسْتَلِمْهُ  ، وَإِلَّا فَكَبِّرْ وَامْضِ  .","","Sharh Ma'ani al-Athar 3826","","أميرا كان على مكة عن وقدان العبدي أبو يعفور عن سفيان بن عيينة عن يونس بن عبد الأعلى عن الطحاوي","باب رفع اليدين عند رؤية البيت"
"3586","3827  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  حَجَّاجٌ ، قَالَ :  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي يَعْفُورٍ ،  عَنْ  رَجُلٍ مِنْ خُزَاعَةَ ، قَالَ : وَكَانَ  الْحَجَّاجُ  اسْتَعْمَلَهُ عَلَى  مَكَّةَ  ، ثُمَّ ذَكَرَ مِثْلَهُ .  فَلَمَّا جُعِلَ ذَلِكَ التَّكْبِيرُ يُفْتَتَحُ بِهِ  الطَّوَافُ ،  كَالتَّكْبِيرِ الَّذِي جُعِلَ يُفْتَتَحُ بِهِ الصَّلَاةُ أُمِرَ بِالرَّفْعِ فِيهِ ، كَمَا يُؤْمَرُ بِالرَّفْعِ فِي التَّكْبِيرِ لِافْتِتَاحِ الصَّلَاةِ ، وَلَا سِيَّمَا إِذْ قَدْ جَعَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الطَّوَافَ  بِالْبَيْتِ  صَلَاةً  .","","Sharh Ma'ani al-Athar 3827","","رجل من خزاعة عن وقدان العبدي أبو يعفور عن الوضاح بن عبد الله اليشكري عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب رفع اليدين عند رؤية البيت"
"3587","3828  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ . (  ح  ) .  3829  -  وَحَدَّثَنَا  صَالِحُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ قَالَا :  ثَنَا  الْفُضَيْلُ بْنُ عِيَاضٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،         [2/179]      عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  الطَّوَافُ  بِالْبَيْتِ  صَلَاةٌ ، إِلَّا أَنَّ اللهَ عَزَّ وَجَلَّ قَدْ  أَحَلَّ  لَكُمُ الْمَنْطِقَ  ، فَمَنْ نَطَقَ فَلَا يَنْطِقْ إِلَّا بِخَيْرٍ  .  فَهَذِهِ الْعِلَّةُ الَّتِي لَهَا وَجَبَ الرَّفْعُ فِيمَا زَادَ عَلَى مَا فِي الْحَدِيثِ الْأَوَّلِ .  وَأَمَّا الرَّفْعُ عَلَى  الصَّفَا  وَالْمَرْوَةِ  ،  وَبِجُمْعٍ  ، وَ (  عَرَفَاتٍ  ) وَعِنْدَ الْمَقَامَيْنِ عِنْدَ الْجَمْرَتَيْنِ ، فَإِنَّ ذَلِكَ قَدْ جَاءَ مَنْصُوصًا فِي الْخَبَرِ الْأَوَّلِ ، وَهَذَا الَّذِي وَصَفْنَا مِنْ هَذِهِ الْمَعَانِي الَّتِي ثَبَّتْنَاهَا ، قَوْلُ  أَبِي حَنِيفَةَ  ،  وَأَبِي يُوسُفَ  ،  وَمُحَمَّدٍ  ، رَحِمَهُمُ اللهُ تَعَالَى  .","","Sharh Ma'ani al-Athar 3828","","عبد الله بن عباس عن طاوس بن كيسان عن عطاء بن السائب عن الفضيل بن عياض عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب رفع اليدين عند رؤية البيت"
"3588","14 - بَابُ الرَّمَلِ فِي الطَّوَافِ  3830  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَاصِمٍ الْغَنَوِيِّ ،  عَنْ  أَبِي الطُّفَيْلِ ، قَالَ :  قُلْتُ  لِابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا : زَعَمَ قَوْمُكَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ  رَمَلَ  بِالْبَيْتِ  ، وَأَنَّ ذَلِكَ سُنَّةٌ ، قَالَ : صَدَقُوا وَكَذَبُوا . قُلْتُ : مَا صَدَقُوا وَمَا كَذَبُوا ؟ قَالَ : صَدَقُوا :  رَمَلَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْبَيْتِ  ، وَكَذَبُوا : لَيْسَتْ بِسُنَّةٍ ، إِنَّ  قُرَيْشًا  قَالَتْ  زَمَنَ الْحُدَيْبِيَةِ  : دَعُوا  مُحَمَّدًا  وَأَصْحَابَهُ حَتَّى يَمُوتُوا مَوْتَ  النَّغَفِ ،  فَلَمَّا صَالَحُوهُ عَلَى أَنْ يَجِيءَ فِي الْعَامِ الْمُقْبِلِ ، فَيُقِيمَ ثَلَاثَةَ أَيَّامٍ  بِمَكَّةَ  ، فَقَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابُهُ ، وَالْمُشْرِكُونَ عَلَى  جَبَلِ  قُعَيْقِعَانَ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِأَصْحَابِهِ : ارْمُلُوا  بِالْبَيْتِ  ثَلَاثًا وَلَيْسَتْ بِسُنَّةٍ  .  قَالَ أَبُو جَعْفَرٍ :  فَذَهَبَ قَوْمٌ إِلَى أَنَّ الرَّمَلَ فِي الطَّوَافِ لَيْسَ بِسُنَّةٍ ، وَاحْتَجُّوا فِي ذَلِكَ بِهَذَا الْحَدِيثِ ، وَقَالُوا : إِنَّمَا كَانَ الرَّمَلُ لِيَرَى الْمُشْرِكُونَ أَنَّ بِهِمْ قُوَّةً ، وَأَنَّهُمْ لَيْسُوا بِضُعَفَاءَ ، لَا لِأَنَّ ذَلِكَ سُنَّةٌ  ، وَاحْتَجُّوا فِي ذَلِكَ أَيْضًا بِمَا .","","Sharh Ma'ani al-Athar 3830","","عبد الله بن عباس عن عامر بن واثلة عن أبو عاصم الغنوي عن حماد بن سلمة عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب الرمل في الطواف"
"3589","3831  -  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ، قَالَ :  قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَّةَ  وَأَصْحَابُهُ ،         [2/180]      فَقَالَ الْمُشْرِكُونَ : إِنَّهُ يَقْدَمُ عَلَيْكُمْ قَوْمٌ قَدْ  وَهَنَتْهُمْ  حُمَّى  يَثْرِبَ  ، فَلَمَّا قَدِمُوا قَعَدَ الْمُشْرِكُونَ مِمَّا يَلِي  الْحِجْرِ  ، فَأَمَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَصْحَابَهُ أَنْ يَرْمُلُوا  الْأَشْوَاطَ  الثَّلَاثَةَ ، وَأَنْ يَمْشُوا مَا بَيْنَ  الرُّكْنَيْنِ  .  قَالَ  ابْنُ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا وَلَمْ يَمْنَعْهُ أَنْ يَأْمُرَهُمْ بِأَنْ يَرْمُلُوا  الْأَشْوَاطَ  الْأَرْبَعَةَ إِلَّا إِبْقَاءً عَلَيْهِمْ .","","Sharh Ma'ani al-Athar 3831","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أيوب السختياني عن حماد بن زيد عن سليمان بن حرب الواشحي عن إبراهيم بن أبي داود الصوري عن الطحاوي","باب الرمل في الطواف"
"3590","3832  -  حَدَّثَنَا  ابْنُ مَرْزُوقٍ ، قَالَ :  ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ، قَالَ :  ثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  أَبِي الطُّفَيْلِ ، قَالَ :  قُلْتُ  لِابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا : زَعَمَ قَوْمُكَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَمَلَ  بِالْبَيْتِ  وَأَنَّهَا سُنَّةٌ ، قَالَ : صَدَقُوا وَكَذَبُوا ، قَدْ  رَمَلَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْبَيْتِ  وَلَيْسَتْ بِسُنَّةٍ ، وَلَكِنْ قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَّةَ  وَالْمُشْرِكُونَ عَلَى  قُعَيْقِعَانَ  ، وَبَلَغَهُ أَنَّهُمْ يَقُولُونَ : إِنَّ بِهِ وَبِأَصْحَابِهِ هُزَالًا ، فَقَالَ : لِأَصْحَابِهِ  ارْمُلُوا ، أَرُوهُمْ أَنَّ بِكُمْ قُوَّةً  . فَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَرْمُلُ مِنَ  الْحَجَرِ الْأَسْوَدِ  إِلَى  الرُّكْنِ الْيَمَانِيِ  ، فَإِذَا تَوَارَى عَنْهُمْ مَشَى  .  قَالُوا : فَلَا تَرَى أَنَّهُ أَمَرَهُمْ أَنْ يَمْشُوا فِي  الْأَشْوَاطِ  الثَّلَاثَةِ ، فِيمَا بَيْنَ الرُّكْنَيْنِ حَيْثُ لَا يَرَاهُمُ الْمُشْرِكُونَ ، وَأَمَرَهُمْ أَنْ يَرْمُلُوا فِيمَا بَقِيَ مِنْ هَذِهِ  الْأَشْوَاطِ  لِيُرُوهُمْ ، فَلَمَّا كَانَ قَدْ أَمَرَهُمْ بِالرَّمَلِ حَيْثُ يَرَوْنَهُمْ ، وَبِتَرْكِهِ حَيْثُ لَا يَرَوْنَهُمْ ، ثَبَتَ بِذَلِكَ أَنَّ الرَّمَلَ كَانَ مِنْ أَجْلِهِمْ ، لَا مِنْ أَجْلِ أَنَّهُ سُنَّةٌ  .  قَالُوا : وَمِمَّا دَلَّ عَلَى ذَلِكَ أَنَّهُ لَمْ يَفْعَلْ ذَلِكَ لَمَّا حَجَّ ، وَذَكَرُوا فِي ذَلِكَ مَا .","","Sharh Ma'ani al-Athar 3832","","عبد الله بن عباس عن عامر بن واثلة عن فطر بن خليفة عن حجاج بن نصير الفساطيطي عن إبراهيم بن مرزوق بن دينار الأموي عن الطحاوي","باب الرمل في الطواف"
"3591","3833  -  حَدَّثَنَا  فَهْدٌ ، قَالَ :  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَ :  ثَنَا  قَيْسٌ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَمَلَ  فِي الْعُمْرَةِ ، وَمَشَى فِي  الْحَجِّ  .  أَفَلَا تَرَى أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَرْمُلْ فِي حَجِّهِ ، حَيْثُ عُدِمَ الَّذِينَ مِنْ أَجْلِهِمْ  رَمَلَ  فِي عُمْرَتِهِ . وَخَالَفَهُمْ فِي ذَلِكَ آخَرُونَ فَقَالُوا : الرَّمَلُ فِي  الْأَشْوَاطِ  الثَّلَاثَةِ الْأُوَلِ سُنَّةٌ ، لَا يَنْبَغِي تَرْكُهَا فِي  الْحَجِّ  ، وَلَا فِي الْعُمْرَةِ  ، وَاحْتَجُّوا فِي ذَلِكَ بِمَا .","","Sharh Ma'ani al-Athar 3833","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن علاء بن المسيب عن قيس بن الربيع الأسدي عن يحيى بن عبد الحميد عن فهد بن سليمان الدلال عن الطحاوي","باب الرمل في الطواف"
"3592","3834  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ ، قَالَ :  ثَنَا  الْحَجَّاجُ ، قَالَ :  ثَنَا  حَمَّادٌ ،  عَنْ  عَبْدِ اللهِ بْنِ عُثْمَانَ بْنِ خُثَيْمٍ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اعْتَمَرَ مِنَ  الْجِعْرَانَةِ  ، فَرَمَلَ  بِالْبَيْتِ  ثَلَاثًا  ، وَمَشَى أَرْبَعَةَ  أَشْوَاطٍ  .  فَفِي هَذَا الْحَدِيثِ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَمَلَ  الْأَشْوَاطَ  كُلَّهَا ، وَقَدْ كَانَ فِي بَعْضِهَا حَيْثُ يَرَاهُ الْمُشْرِكُونَ ، وَفِي بَعْضِهَا حَيْثُ لَا يَرَوْنَهُ .         [2/181]      فَفِي رَمَلِهِ حَيْثُ لَا يَرَوْنَهُ ، دَلِيلٌ عَلَى أَنَّهُ لَيْسَ مِنْ أَجْلِهِمْ رَمَلَ ، وَلَكِنْ لِمَعْنًى آخَرَ  .","","Sharh Ma'ani al-Athar 3834","","عبد الله بن عباس عن عامر بن واثلة عن عبد الله بن عثمان بن خثيم عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن محمد بن خزيمة بن راشد البصري عن الطحاوي","باب الرمل في الطواف"
"3593","3835  -  وَقَدْ  حَدَّثَنَا  ابْنُ أَبِي دَاوُدَ ، قَالَ :  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ، قَالَ :  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي زِيَادٍ ،  عَنْ  أَبِي الطُّفَيْلِ ، قَالَ :  رَمَلَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنَ  الْحَجَرِ  إِلَى  الْحَجَرِ  .  فَهَذَا الْحَدِيثُ مِثْلُ الَّذِي قَبْلَهُ  .","","Sharh Ma'ani al-Athar 3835","","عامر بن واثلة عن عبيد الله بن أبي زياد القداح عن عبد الله بن المبارك عن سعيد بن سليمان سعدويه عن أبو بكر ابن أبي داود السجستاني عن الطحاوي","باب الرمل في الطواف"
"3594","3836  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ يُونُسَ ، قَالَ :  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ، قَالَ :  كَانَ  ابْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا يَرْمُلُ مِنَ  الْحَجَرِ  إِلَى  الْحَجَرِ  ثَلَاثًا  ، وَيَمْشِي أَرْبَعًا عَلَى  هِينَتِهِ  .  قَالَ  ابْنُ عُمَرَ رَضِيَ اللهُ عَنْهُمَا : وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُهُ  .","","Sharh Ma'ani al-Athar 3836","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن أسباط بن محمد بن ميسرة القرشي عن محمد بن عمرو السوسي عن الطحاوي","باب الرمل في الطواف"
"3595","3837  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ :  ثَنَا  عَفَّانُ ، قَالَ :  ثَنَا  سُلَيْمُ بْنُ أَخْضَرَ ، قَالَ :  ثَنَا  عُبَيْدُ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَرْمُلُ مِنَ  الْحَجَرِ  إِلَى  الْحَجَرِ  .  فَهَذَا مِثْلُ الَّذِي قَبْلَهُ أَيْضًا ،  وَقَدِ اسْتَدَلَّ بِذَلِكَ  عَبْدُ اللهِ بْنُ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا عَلَى مَا ذَكَرْنَا ، فَفَعَلَهُ بَعْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، كَمَا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَعَلَهُ ، إِلَّا أَنَّهُ لَيْسَ فِي ذَلِكَ أَنَّهُ فَعَلَهُ فِي حَجٍّ وَلَا فِي عُمْرَةٍ .  فَقَدْ يَجُوزُ أَنْ يَكُونَ ذَلِكَ كَانَ مِنْهُ وَهُوَ حَاجٌّ ، فَخَالَفَ ذَلِكَ مَا رَوَى عَنْهُ  مُجَاهِدٌ  .  وَقَدْ يَجُوزُ أَنْ يَكُونَ ذَلِكَ كَانَ مِنْهُ فِي عُمْرَةٍ ، فَيَكُونُ مَذْهَبُهُ كَانَ أَنْ يَرْمُلَ فِي الْعُمْرَةِ ، وَلَا يَرْمُلَ فِي الْحَجَّةِ .  وَمِمَّا يَدُلُّ أَيْضًا عَلَى ثُبُوتِ الرَّمَلِ ، وَأَنَّهُ سُنَّةٌ مَاضِيَةٌ فِي  الْحَجِّ  وَالْعُمْرَةِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ فَعَلَهُ فِي حَجَّةِ الْوَدَاعِ ، حَيْثُ لَا عَدُوَّ يُرِيهِ قُوَّتَهُ  فَمَا رُوِيَ عَنْهُ فِي ذَلِكَ مَا .","","Sharh Ma'ani al-Athar 3837","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن سليم بن أخضر البصري عن عفان بن مسلم الصفار عن علان بن المغيرة عن الطحاوي","باب الرمل في الطواف"
"3596","3836  (م)  -  حَدَّثَنَا  يَزِيدُ بْنُ سِنَانٍ ، قَالَ :  ثَنَا  أَبُو بَكْرٍ الْحَنَفِيُّ ، قَالَ :  ثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَعَى ثَلَاثَةً وَمَشَى أَرْبَعَةً  حِينَ قَدِمَ فِي  الْحَجِّ  وَالْعُمْرَةِ ، حِينَ كَانَ اعْتَمَرَ  .","","Sharh Ma'ani al-Athar 3836","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن نافع مولى عبد الله بن عمر عن عبد الكبير بن عبد المجيد الحنفي عن يزيد بن سنان القزاز عن الطحاوي","باب الرمل في الطواف"
"3597","3837  (م)  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ يَحْيَى الْمُزَنِيُّ ، قَالَ :  ثَنَا  مُحَمَّدُ بْنُ إِدْرِيسَ ،  عَنْ  أَنَسِ بْنِ عِيَاضٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِمِثْلِ مَعْنَاهُ .  فَهَذَا خِلَافُ مَا رَوَى  مُجَاهِدٌ  ، عَنِ  ابْنِ عُمَرَ  رَضِيَ اللهُ عَنْهُمَا .  وَقَدْ رُوِيَ عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ  ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ  رَمَلَ  فِي حَجَّةِ الْوَدَاعِ  .","","Sharh Ma'ani al-Athar 3837","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن أنس بن عياض الليثي عن الشافعي عن إسماعيل بن يحيى المزني عن الطحاوي","باب الرمل في الطواف"
"3598","3838  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خُزَيْمَةَ وَفَهْدٌ ، قَالَا :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  حَدَّثَنِي  اللَّيْثُ ، قَالَ :  حَدَّثَنِي  ابْنُ الْهَادِ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ رَضِيَ اللهُ عَنْهُ ، قَالَ :  طَافَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّةِ الْوَدَاعِ سَبْعًا  ،  رَمَلَ  مِنْهَا ثَلَاثًا ، وَمَشَى أَرْبَعًا  .","","Sharh Ma'ani al-Athar 3838","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن عبد الله بن صالح المصري عن فهد بن سليمان الدلال عن الطحاوي","باب الرمل في الطواف"
"3599","3839  -  حَدَّثَنَا  رَبِيعٌ الْمُؤَذِّنُ ، قَالَ :  ثَنَا  أَسَدٌ ، قَالَ :  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ، قَالَ :  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ ، فَذَكَرَ  بِإِسْنَادِهِ  مِثْلَهُ .","","Sharh Ma'ani al-Athar 3839","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن حاتم بن إسماعيل الحارثي عن أسد السنة عن الربيع بن سليمان المرادي عن الطحاوي","باب الرمل في الطواف"
"3600","[2/182]      3840  -  حَدَّثَنَا  يُونُسُ ، قَالَ :  أَنَا  ابْنُ وَهْبٍ ، أَنَّ مَالِكًا  أَخْبَرَهُ  ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ رَضِيَ اللهُ عَنْهُ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ طَافَ سَبْعًا ،  رَمَلَ  فِي ثَلَاثَةٍ مِنْهُنَّ  ، مِنَ  الْحَجَرِ الْأَسْوَدِ  إِلَى  الْحَجَرِ الْأَسْوَدِ  .  فَلَمَّا ثَبَتَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ  رَمَلَ  فِي حَجَّةِ الْوَدَاعِ ، وَلَا عَدُوَّ ثَبَتَ أَنَّهُ لَمْ يَفْعَلْهُ ، إِذَا كَانَ الْعَدْوُ مِنْ أَجْلِ الْعَدُوِّ ، وَلَوْ كَانَ فَعَلَهُ إِذْ كَانُوا مِنْ أَجْلِهِمْ لَمَا فَعَلَهُ فِي وَقْتِ عَدَمِهِمْ ، فَثَبَتَ بِذَلِكَ أَنَّ الرَّمَلَ فِي الطَّوَافِ مِنْ  سُنَنِ  الْحَجِّ  الْمَفْعُولَةِ فِيهِ ، الَّتِي لَا يَنْبَغِي تَرْكُهَا ، وَقَدْ فَعَلَ ذَلِكَ أَيْضًا أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ بَعْدِهِ  .","","Sharh Ma'ani al-Athar 3840","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن مالك بن أنس عن عبد الله بن وهب المصري عن يونس بن عبد الأعلى عن الطحاوي","باب الرمل في الطواف"
