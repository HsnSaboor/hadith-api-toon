hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"7201","7195  - =  وَبِهِ  :  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَمَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ الظُّهْرِ وَالْعَصْرِ  ، وَالْمَغْرِبِ وَالْعِشَاءِ  بِالْمَدِينَةِ  ، وَهُوَ مُقِيمٌ ، فِي غَيْرِ خَوْفٍ وَلَا سَفَرٍ ، إِنَّمَا أَرَادَ بِذَلِكَ السَّعَةَ لِأُمَّتِهِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْعَوَّامِ  إِلَّا  عَبْدُ اللهِ بْنُ خِرَاشٍ  "" .","","Al-Mu'jam al-Awsat 7195","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن أحمد بن المقدام العجلي عن محمد بن محمويه عن الطبراني","محمد بن محمويه الجوهري الأهوازي"
"7202","7196  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَحْمَوَيْهِ الْجَوْهَرِيُّ ،  نَا  مَعْمَرُ بْنُ سَهْلٍ ،  نَا  عُبَيْدُ اللهِ بْنُ تَمَّامٍ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا آوَى إِلَى فِرَاشِهِ قَالَ :  اللَّهُمَّ         [7/174]      إِنِّي أَعُوذُ بِكَ مِنَ الشَّرِّ  وَلُوعًا  ، وَمِنَ الْجُوعِ ضَجِيعًا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْجُرَيْرِيِّ  إِلَّا  عُبَيْدُ اللهِ بْنُ تَمَّامٍ  ،  تَفَرَّدَ بِهِ  :  مَعْمَرُ بْنُ سَهْلٍ  ، وَلَا يُرْوَى عَنْ  عَائِشَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7196","","عائشة بنت أبي بكر الصديق عن عبد الله بن بريدة عن سعيد بن إياس الجريري عن عبيد الله بن تمام السلمي عن معمر بن سهل بن معمر الأهوازي عن محمد بن محمويه الجوهري عن الطبراني","محمد بن محمويه الجوهري الأهوازي"
"7203","7197  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَحْمَوَيْهِ الْجَوْهَرِيُّ ،  ثَنَا  الْحَسَنُ بْنُ سِنَانٍ الْحَنْظَلِيُّ ،  ثَنَا  الْقَاسِمُ بْنُ يَحْيَى الضَّرِيرُ ،  أَخْبَرَنِي  عَبَّادُ بْنُ رَاشِدٍ ،  عَنْ  مُحَمَّدِ بْنِ زِيَادٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَا يَخَافُ الَّذِي يَرْفَعُ رَأْسَهُ قَبْلَ الْإِمَامِ ، وَيَضَعُ رَأْسَهُ  ، أَنْ يُحَوِّلَ اللهُ رَأْسَهُ رَأْسَ حِمَارٍ ؟ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبَّادِ بْنِ رَاشِدٍ  إِلَّا  الْقَاسِمُ بْنُ يَحْيَى  ،  تَفَرَّدَ بِهِ  :  الْحَسَنُ بْنُ سِنَانٍ  "" .","","Al-Mu'jam al-Awsat 7197","","أبو هريرة الدوسي عن محمد بن زياد الجمحي عن عباد بن راشد الكليبى عن القاسم بن يحيى الضرير عن الحسن بن سنان الحنظلي عن محمد بن محمويه الجوهري عن الطبراني","محمد بن محمويه الجوهري الأهوازي"
"7204","7198  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَحْمَوَيْهِ الْجَوْهَرِيُّ ،  ثَنَا  الْحَسَنُ بْنُ سِنَانٍ الْحَنْظَلِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ الْحَكَمِ ،  عَنْ  شَرِيكِ بْنِ عَبْدِ اللهِ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِيهِ  قَالَ  :  رَأَيْتُ عَلِيَّ بْنَ أَبِي طَالِبٍ ، يَعْرِضُ سَيْفًا لَهُ فِي  رَحَبَةِ الْكُوفَةِ  ،  وَيَقُولُ : "" مَنْ يَشْتَرِي مِنِّي سَيْفِي هَذَا ؟ فَوَاللهِ لَقَدْ جَلَوْتُ بِهِ غَيْرَ كُرْبَةٍ عَنْ وَجْهِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَوْ أَنَّ عِنْدِي ثَمَنَ إِزَارٍ مَا بِعْتُهُ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ  إِلَّا  شَرِيكٌ  ، وَلَا رَوَاهُ عَنْ  شَرِيكٍ  إِلَّا  سُلَيْمَانُ بْنُ الْحَكَمِ  ،  تَفَرَّدَ بِهِ  :  الْحَسَنُ بْنُ سِنَانٍ  "" .","","Al-Mu'jam al-Awsat 7198","","علي بن أبي طالب عن الأقمر الوادعي الهمداني عن علي بن الأقمر عن شريك بن عبد الله النخعي عن سليمان بن الحكم بن عوانة الكلبي عن الحسن بن سنان الحنظلي عن محمد بن محمويه الجوهري عن الطبراني","محمد بن محمويه الجوهري الأهوازي"
"7205","7199  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَحْمَوَيْهِ الْجَوْهَرِيُّ ،  ثَنَا  الْحَسَنُ بْنُ سِنَانٍ الْحَنْظَلِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ الْحَكَمِ ،  أَخْبَرَنِي  شَرِيكُ بْنُ عَبْدِ اللهِ النَّخَعِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُلَاثَةَ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ ، يَقُولُ عَلَى الْمِنْبَرِ  بِالْكُوفَةِ  : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُومُ اللَّيْلَ حَتَّى تَتَفَطَّرَ قَدَمَاهُ ، فَقِيلَ لَهُ : يَا رَسُولَ اللهِ ، أَوَلَيْسَ قَدْ غَفَرَ اللهُ لَكَ مَا تَقَدَّمَ مِنْ ذَنْبِكَ وَمَا تَأَخَّرَ ؟ قَالَ :  أَفَلَا أَكُونُ عَبْدًا شَكُورًا  .         [7/175]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ عُلَاثَةَ - وَهُوَ أَبُو مُحَمَّدِ بْنُ عَبْدِ اللهِ بْنِ عُلَاثَةَ -  ، إِلَّا  شَرِيكٌ  ، وَلَا عَنْ  شَرِيكٍ  إِلَّا  سُلَيْمَانُ بْنُ الْحَكَمِ  ،  تَفَرَّدَ بِهِ  الْحَسَنُ بْنُ سِنَانٍ  ، وَلَا يُرْوَى عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 7199","","النعمان بن بشير الأنصاري عن أبيه عن عبد الله بن علاثة عن شريك بن عبد الله النخعي عن سليمان بن الحكم بن عوانة الكلبي عن الحسن بن سنان الحنظلي عن محمد بن محمويه الجوهري عن الطبراني","محمد بن محمويه الجوهري الأهوازي"
"7206","7200  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَحْمَوَيْهِ الْجَوْهَرِيُّ ،  نَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ،  ثَنَا  أَبِي  ،  ثَنَا  آدَمُ بْنُ الْحَكَمِ ،  ثَنَا  أَبُو غَالِبٍ ،  عَنْ  أَبِي أُمَامَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَالَ فِي دُبُرِ صَلَاةِ الْغَدَاةِ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ  ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ ، يُحْيِي وَيُمِيتُ ، بِيَدِهِ الْخَيْرُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، مِائَةَ مَرَّةٍ ، قَبْلَ أَنْ  يَثْنِيَ  رِجْلَيْهِ ، كَانَ يَوْمَئِذٍ أَفْضَلَ أَهْلِ الْأَرْضِ عَمَلًا ، إِلَّا مَنْ قَالَ مِثْلَ مَقَالَتِهِ ، أَوْ زَادَ عَلَى مَا قَالَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي غَالِبٍ  إِلَّا  آدَمُ بْنُ الْحَكَمِ  ، وَلَا رَوَاهُ عَنْ  آدَمَ  إِلَّا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ  "" .","","Al-Mu'jam al-Awsat 7200","","أبو أمامة الباهلي عن أبو غالب البصري صاحب أبي أمامة عن آدم بن الحكم البصري عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن محمد بن محمويه الجوهري عن الطبراني","محمد بن محمويه الجوهري الأهوازي"
"7207","7201  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَحْمَوَيْهِ الْجَوْهَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْقَاسِمِ الْهَاشِمِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ هَانِئٍ أَبُو نُعَيْمٍ النَّخَعِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ يَسِيرٍ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ،  عَنْ  عَلْقَمَةَ بْنِ قَيْسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي صَلَاةِ الْغَدَاةِ يَوْمَ الْجُمُعَةِ :         {      الم             *          تَنْـزِيلُ         }      ،  وَهَلْ أَتَى عَلَى الْإِنْسَانِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِبْرَاهِيمَ  إِلَّا  سُلَيْمَانُ بْنُ يَسِيرٍ  ،  تَفَرَّدَ بِهِ  :  أَبُو نُعَيْمٍ النَّخَعِيُّ  "" .","","Al-Mu'jam al-Awsat 7201","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن سليمان بن يسير النخعي عن عبد الرحمن بن هانئ الحارثي عن عبد الله بن محمد بن قاسم الهاشمي عن محمد بن محمويه الجوهري عن الطبراني","محمد بن محمويه الجوهري الأهوازي"
"7208","7202  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَحْمَوَيْهِ الْجَوْهَرِيُّ ،  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ ،  نَا  أَبُو عَلِيٍّ         [7/176]      الْحَنَفِيُّ ،  نَا  سَلْمُ بْنُ زَرِيرٍ ،  ثَنَا  أَبُو غَالِبٍ ،  عَنْ  أَبِي أُمَامَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  تَفَرَّقَتْ  بَنُو إِسْرَائِيلَ  عَلَى إِحْدَى وَسَبْعِينَ فِرْقَةً  ، وَتَفَرَّقَتِ النَّصَارَى عَلَى اثْنَيْنِ وَسَبْعِينَ فِرْقَةً ، وَأُمَّتِي تَزِيدُ عَلَيْهِمْ فِرْقَةً ، كُلُّهَا فِي النَّارِ إِلَّا السَّوَادَ الْأَعْظَمَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَلْمٍ  إِلَّا  أَبُو عَلِيٍّ الْحَنَفِيُّ  "" .","","Al-Mu'jam al-Awsat 7202","","أبو أمامة الباهلي عن أبو غالب البصري صاحب أبي أمامة عن سلم بن زرير العطاردي عن عبيد الله بن عبد المجيد الحنفي عن معمر بن سهل بن معمر الأهوازي عن محمد بن محمويه الجوهري عن الطبراني","محمد بن محمويه الجوهري الأهوازي"
"7209","7203  -  حَدَّثَنَا  مُحَمَّدُ بْنُ سَعِيدِ بْنِ جَابَانَ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مِهْرَانَ الْجَمَّالُ الرَّازِيُّ ،  نَا  عَلِيُّ بْنُ ثَابِتٍ الْجَزَرِيُّ ،  عَنِ  الْوَازِعِ بْنِ نَافِعٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  بَيْنَمَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي الْعَصْرَ فِي  غَزْوَةِ بَدْرٍ  ، إِذْ تَبَسَّمَ ، فَلَمَّا قَضَى الصَّلَاةَ قِيلَ لَهُ : يَا رَسُولَ اللهِ ، تَبَسَّمْتَ فِي الصَّلَاةِ ؟ قَالَ :  مَرَّ بِي  مِيكَائِيلُ  ، وَعَلَى جَنَاحِهِ الْغُبَارُ ، فَضَحِكَ إِلَيَّ ، فَتَبَسَّمْتُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَابِرٍ  إِلَّا  أَبُو سَلَمَةَ  ، وَلَا عَنْ  أَبِي سَلَمَةَ  إِلَّا  الْوَازِعُ بْنُ نَافِعٍ  ،  تَفَرَّدَ بِهِ  :  عَلِيُّ بْنُ ثَابِتٍ  "" .","","Al-Mu'jam al-Awsat 7203","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو سلمة بن عبد الرحمن عن الوازع بن نافع العقيلي عن علي بن ثابت الجزري عن محمد بن مهران الجمال عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7210","7204  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  ثَنَا  زُنَيْجٌ أَبُو غَسَّانَ الرَّازِيُّ ،  ثَنَا  الْحَكَمُ بْنُ بَشِيرِ بْنِ سَلْمَانَ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ الْمُلَائِيِّ ،  عَنْ  جَبَلَةَ بْنِ سُحَيْمٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ مُتَحَرِّيًا لَيْلَةَ الْقَدْرِ ،  فَلْيَتَحَرَّهَا  فِي الْعَشْرِ الْأَوَاخِرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمْرِو بْنِ قَيْسٍ  إِلَّا  الْحَكَمُ بْنُ بَشِيرٍ  "" .","","Al-Mu'jam al-Awsat 7204","","عبد الله بن عمر بن الخطاب عن جبلة بن سحيم التيمي عن عمرو بن قيس الملائي عن الحكم بن  أبى إسماعيل النهدي عن محمد بن عمرو بن بكر بن سالم عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7211","7205  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  ثَنَا  مُحَمَّدُ بْنُ مِهْرَانَ الْجَمَّالُ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  مُسْلِمِ بْنِ زِيَادٍ مَوْلَى مَيْمُونَةَ زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ رَجُلٍ يَقُولُ إِذَا         [7/177]      أَصْبَحَ : اللَّهُمَّ إِنِّي أَصْبَحْتُ أُشْهِدُكَ  ، وَأُشْهِدُ حَمَلَةَ عَرْشِكَ وَمَلَائِكَتَكَ ، وَجَمِيعَ خَلْقِكَ ، بِأَنَّكَ أَنْتَ اللهُ لَا إِلَهَ إِلَّا أَنْتَ ، وَحْدَكَ لَا شَرِيكَ لَكَ ، وَأَنَّ  مُحَمَّدًا  عَبْدُكَ وَرَسُولُكَ ، إِلَّا غَفَرَ اللهُ لَهُ مَا أَصَابَ مِنْ ذَنْبٍ فِي يَوْمِهِ ذَلِكَ ، وَإِنْ قَالَهَا إِذَا أَمْسَى غَفَرَ اللهُ لَهُ مَا أَصَابَ فِي لَيْلَتِهِ تِلْكَ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَنَسٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  بَقِيَّةُ  "" .","","Al-Mu'jam al-Awsat 7205","","أنس بن مالك عن مسلم بن زياد الحمصي عن بقية بن الوليد عن محمد بن مهران الجمال عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7212","7206  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  ثَنَا  زُنَيْجٌ أَبُو غَسَّانَ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُعَلَّى الرَّازِيُّ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ زُبَيْدٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَةَ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْتِي الصَّفَّ الْأَوَّلَ مِنْ أَوَّلِهِ إِلَى آخِرِهِ يُسَوِّي بَيْنَ الصُّفُوفِ ،  الْقَوْمَ  وَمَنَاكِبَهُمْ ، وَيَقُولُ :  لَا  تَخْتَلِفُوا  فَتَخْتَلِفَ  قُلُوبُكُمْ  ، إِنَّ اللهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى الصُّفُوفِ الْأُوَلِ  .  وَكَانَ يَقُولُ :  مَنْ مَنَحَ مَنِيحَةَ لَبَنٍ ، أَوْ مَنِيحَةَ  وَرِقٍ  ، أَوْ  هَدَى  زُقَاقًا  كَانَ كَعَتَاقِ  نَسَمَةٍ  ، وَمَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ ، وَلَهُ الْحَمْدُ ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، كَانَ كَعَتَاقِ  نَسَمَةٍ  .  وَكَانَ يَقُولُ : ""  زَيِّنُوا  الْقُرْآنَ بِأَصْوَاتِكُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زُبَيْدٍ الْيَامِيِّ  إِلَّا  مُحَمَّدُ بْنُ الْمُعَلَّى ،  وَشُجَاعُ بْنُ الْوَلِيدِ  "" .","","Al-Mu'jam al-Awsat 7206","","البراء بن عازب الأوسي عن عبد الرحمن بن عوسجة النهمي عن طلحة بن مصرف الهمداني عن عبد الرحمن بن زبيد بن الحارث اليامي عن محمد بن المعلى الهمداني عن محمد بن عمرو بن بكر بن سالم عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7213","7207  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ ،  نَا  زُنَيْجٌ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُعَلَّى ،  ثَنَا  أَشْعَثُ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  فَرَضَ  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أَمْوَالِ الْمُسْلِمِينَ مِنْ كُلِّ أَرْبَعِينَ دِرْهَمًا دِرْهَمٌ  ، وَفِي أَمْوَالِ أَهْلِ الذِّمَّةِ مِنْ كُلِّ عِشْرِينَ دِرْهَمًا دِرْهَمٌ ، وَفِي أَمْوَالِ مَنْ لَا ذِمَّةَ لَهُ : مِنْ كُلِّ عَشَرَةِ دَرَاهِمَ دِرْهَمٌ  .         [7/178]      ""  لَا  يُسْنِدُ  هَذَا الْحَدِيثَ إِلَّا  مُحَمَّدُ بْنُ الْمُعَلَّى  ،  تَفَرَّدَ بِهِ  :  زُنَيْجٌ  "" .  وَرَوَاهُ  أَيُّوبُ  ،  وَسَلَمَةُ بْنُ عَلْقَمَةَ  ،  وَيَزِيدُ بْنُ إِبْرَاهِيمَ  ،  وَجَرِيرُ بْنُ حَازِمٍ  ،  وَحَبِيبُ بْنُ الشَّهِيدِ  ،  وَالْهَيْثَمُ الصَّيْرَفِيُّ  ، وَجَمَاعَةٌ ، عَنْ  أَنَسِ بْنِ سِيرِينَ  ، عَنْ  أَنَسِ بْنِ مَالِكٍ  ، أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  فَرَضَ  - فَذَكَرَ الْقَصَّةَ .","","Al-Mu'jam al-Awsat 7207","","أنس بن مالك عن محمد بن سيرين عن أشعث بن سوار عن محمد بن المعلى الهمداني عن محمد بن عمرو بن بكر بن سالم عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7214","7208  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  زُنَيْجٌ ،  نَا  حَكَّامُ بْنُ سَلْمٍ ،  عَنِ  الْمُثَنَّى بْنِ الصَّبَّاحِ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  أَرَادَ  ابْنُ مَسْعُودٍ  أَنْ يَبْنِيَ دَارًا ، فَقَالَتْ  قُرَيْشٌ  : أَلَا نَمْنَعُ  ابْنَ أُمِّ عَبْدٍ  أَنَّ يَبْتَنِيَ دَارًا فِينَا ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ آمُرُ بِذَلِكَ فَأَنَا ظَالِمٌ  ، لَا يُقَدِّسُ اللهُ أُمَّةً لَا يُؤْخَذُ لِضَعِيفِهَا مِنْ شَدِيدِهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي مُلَيْكَةَ  ، عَنْ  عَائِشَةَ  ، إِلَّا  الْمُثَنَّى بْنُ الصَّبَّاحِ  ،  تَفَرَّدَ بِهِ  :  حَكَّامُ بْنُ سَلْمٍ  "" ، وَرَوَاهُ  عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرٍ الْمُلَيْكِيُّ  ، عَنِ  ابْنِ أَبِي مُلَيْكَةَ  ، عَنِ  ابْنِ عَبَّاسٍ  .","","Al-Mu'jam al-Awsat 7208","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن المثنى بن الصباح الأبناوي عن حكام بن سلم الكناني عن محمد بن عمرو بن بكر بن سالم عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7215","7209  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  زُنَيْجٌ أَبُو غَسَّانَ ،  نَا  حَكَّامٌ ،  عَنِ  الْمُثَنَّى بْنِ الصَّبَّاحِ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ عَلَى الْمِنْبَرِ يَقُولُ :  إِذَا  رَاحَ  أَحَدُكُمْ إِلَى الْجُمُعَةِ فَلْيَغْتَسِلْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَيُّوبَ بْنِ مُوسَى  إِلَّا  الْمُثَنَّى بْنُ الصَّبَّاحِ  ،  تَفَرَّدَ بِهِ  :  حَكَّامُ بْنُ سَلْمٍ  "" .","","Al-Mu'jam al-Awsat 7209","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب بن موسى الأموي عن المثنى بن الصباح الأبناوي عن حكام بن سلم الكناني عن محمد بن عمرو بن بكر بن سالم عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7216","7210  -  =  وَبِهِ  :  عَنِ  الْمُثَنَّى ،  عَنْ  عَطَاءِ بْنِ رَبَاحٍ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ لَنَا مَثَلُ السَّوْءِ : الْعَائِدُ فِي         [7/179]      هِبَتِهِ كَالْعَائِدِ فِي قَيْئِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءٍ  إِلَّا  الْمُثَنَّى بْنُ الصَّبَّاحِ  ،  تَفَرَّدَ بِهِ  :  حَكَّامُ بْنُ سَلْمٍ  وَالْمَشْهُورُ : مِنْ حَدِيثِ  عِكْرِمَةَ  "" .  كذا في طبعة دار الحرمين ، ولعل الصواب: (عطاء بن أبي رباح) .","","Al-Mu'jam al-Awsat 7210","","عبد الله بن عباس عن عطاء بن أبي رباح عن المثنى بن الصباح الأبناوي عن حكام بن سلم الكناني عن محمد بن عمرو بن بكر بن سالم عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7217","7211  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  نَا  الْفَضْلُ بْنُ مُوسَى السِّينَانِيُّ ،  عَنْ  يَزِيدَ بْنِ زِيَادِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  سَلَمَةَ بْنِ أَبِي زِيَادٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  أَبِي أُمَامَةَ قَالَ :  جَاءَتِ  امْرَأَةٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَمَعَهَا صَبِيَّانِ ، لَهَا صَبِيٌّ تُرْضِعُهُ ، فَسَأَلَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمْ يَجِدْ شَيْئًا يُعْطِيهَا حَتَّى أَصَابَ ثَلَاثَ تَمَرَاتٍ عِنْدَ بَعْضِ نِسَائِهِ ، فَأَعْطَاهَا ، فَأَعْطَتْ هَذَا تَمْرَةً وَهَذَا تَمْرَةً ، وَأَمْسَكَتْ تَمْرَةً ، فَبَكَى أَحَدُ الصَّبِيَّيْنِ ، فَشَقَّتِ التَّمْرَةَ نِصْفَيْنِ ، فَأَعْطَتْ هَذَا نِصْفًا وَهَذَا نِصْفًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  حَمِلَاتٌ ، وَالِدَاتٌ ، مُرْضِعَاتٌ ، رَحِيمَاتٌ بِأَوْلَادِهِنَّ  ، لَوْلَا مَا يَأْتِينَ إِلَى أَزْوَاجِهِنَّ دَخَلَ مُصَلِّيَاتُهُنَّ الْجَنَّةَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ بْنِ زِيَادِ بْنِ أَبِي الْجَعْدِ  إِلَّا  الْفَضْلُ بْنُ مُوسَى السِّينَانِيُّ  "" .","","Al-Mu'jam al-Awsat 7211","","أبو أمامة الباهلي عن سالم بن أبي الجعد الغطفاني عن سلمة بن زياد عن يزيد بن زياد بن أبي الجعد الغطفاني عن الفضل بن موسى السيناني عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7218","7212  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  مَحْمُودُ بْنُ غَيْلَانَ ،  نَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  نَا  حُمَيْدٌ الطَّوِيلُ ،  عَنْ  طَلْقِ بْنِ حَبِيبٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَرْبَعٌ مَنْ أُعْطِيَهُنَّ فَقَدْ أُعْطِيَ خَيْرَ الدُّنْيَا وَالْآخِرَةِ  : قَلْبًا شَاكِرًا ، وَلِسَانًا ذَاكِرًا ، وَبَدَنًا عَلَى الْبَلَاءِ صَابِرًا ، وَزَوْجَةً لَا تَبْغِيهِ خَوْفًا فِي نَفْسِهَا وَلَا مَالِهِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  طَلْقِ بْنِ حَبِيبٍ  إِلَّا  حُمَيْدٌ الطَّوِيلُ  ، وَلَا رَوَاهُ عَنْ  حُمَيْدٍ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  ، وَلَا رَوَاهُ عَنْ  حَمَّادٍ  إِلَّا  مُوسَى  ،  تَفَرَّدَ بِهِ  :  مَحْمُودُ بْنُ غَيْلَانَ  "" .","","Al-Mu'jam al-Awsat 7212","","عبد الله بن عباس عن طلق بن حبيب العنزي عن حميد الطويل عن حماد بن سلمة عن موسى بن إسماعيل التبوذكي عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7219","[7/180]      7213  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  زُهَيْرٍ ،  عَنْ  جَابِرٍ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّهُمَّ اغْفِرْ  لِلْأَنْصَارِ  ، وَأَبْنَاءِ الْأَنْصَارِ  ، وَالِمَوَالِي الْأَنْصَارِ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَابِرٍ  إِلَّا  زُهَيْرٌ  ،  تَفَرَّدَ بِهِ  :  يَحْيَى بْنُ آدَمَ  "" .","","Al-Mu'jam al-Awsat 7213","","البراء بن عازب الأوسي عن عدي بن ثابت الظفري عن جابر الجعفي عن زهير بن معاوية بن حديج عن يحيى بن آدم عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7220","7214  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  ثَنَا  مُحَمَّدُ بْنُ مِهْرَانَ الْجَمَّالُ ،  نَا  مُحَمَّدُ بْنُ الْمُعَلَّى ،  عَنِ  الْجَرَّاحِ بْنِ الضَّحَّاكِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنَ الْإِيمَانِ أَنْ يُحِبَّ الرَّجُلُ رَجُلًا لَا يُحِبُّهُ إِلَّا لِلهِ  ، مِنْ غَيْرِ مَالٍ أَعْطَاهُ ، فَذَلِكَ الْإِيمَانُ  ""  لَمْ  يَرْفَعْ  هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  الْجَرَّاحُ بْنُ الضَّحَّاكِ  "" .","","Al-Mu'jam al-Awsat 7214","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن الجراح بن الضحاك الكندي عن محمد بن المعلى الهمداني عن محمد بن مهران الجمال عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7221","7215  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  نَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يُوشِكُ  أَنْ  تَدَاعَى  الْأُمَمُ عَلَى أُمَّتِي  كَمَا  تَدَاعَى  عَلَى الثَّرِيدِ أَكَلَتُهُ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْمَاعِيلَ  إِلَّا  عَبْدُ الْعَزِيزِ  ، وَلَا عَنْ  عَبْدِ الْعَزِيزِ  إِلَّا  مُؤَمَّلٌ  ،  تَفَرَّدَ بِهِ  :  مَحْمُودٌ  "" .","","Al-Mu'jam al-Awsat 7215","","أبو هريرة الدوسي عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبد العزيز بن مسلم الخراساني عن مؤمل بن إسماعيل العدوي عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7222","7216  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  نَا  رَوْحُ بْنُ عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي رَافِعٍ  عَنْ  أَبِي هُرَيْرَةَ ، "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ صَوْمِ يَوْمِ الْجُمُعَةِ ، إِلَّا وَمَعَهَا غَيْرُهَا  .","","Al-Mu'jam al-Awsat 7216","","أبو هريرة الدوسي عن نفيع بن رافع الصائغ عن عطاء بن أبي ميمونة البصرى عن روح بن عطاء بن أبي ميمونة البصري عن النضر بن شميل عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7223","7217  -  =  وَبِهِ  :         [7/181]      قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَوَضَّئُوا مِمَّا غَيَّرَتِ النَّارُ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عَطَاءِ بْنِ أَبِي مَيْمُونَةَ  إِلَّا ابْنُهُ  رَوْحٌ  ، وَلَا عَنْ  رَوْحٍ  إِلَّا  النَّضْرُ بْنُ شُمَيْلٍ  ،  تَفَرَّدَ بِهِمَا  :  مَحْمُودُ بْنُ غَيْلَانَ  "" .","","Al-Mu'jam al-Awsat 7217","","أبو هريرة الدوسي عن نفيع بن رافع الصائغ عن عطاء بن أبي ميمونة البصرى عن روح بن عطاء بن أبي ميمونة البصري عن النضر بن شميل عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7224","7218  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  مَحْمُودُ بْنُ غَيْلَانَ ،  نَا  النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  أَبُو عَامِرٍ الْخَزَّازُ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  قُلْتُ : يَا نَبِيَّ اللهِ ، جَارِي بَيْتُهُ حَيْثُ بَيْتِي ، وَبَابُهُ شَاسِعٌ عَنْ بَابِي ، وَآخَرُ بَابُهُ قُبَالَةَ بَابِي ، وَبَيْتُهُ أَبَعْدُ مِنْ بَيْتِ ذَاكَ ، فَبِأَيِّهِمَا أَبْدَأُ ؟ قَالَ :  بِالَّذِي بَابُهُ قُبَالَةَ بَابِكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي عَامِرٍ الْخَزَّازِ  إِلَّا  النَّضْرُ بْنُ شُمَيْلٍ  "" .","","Al-Mu'jam al-Awsat 7218","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن صالح بن رستم الخزاز عن النضر بن شميل عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7225","7219  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ،  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ إِسْحَاقَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ رَبَاحٍ ،  عَنْ  أَبِي قَتَادَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ عَلَى  أَبِي بَكْرٍ  وَهُوَ يُصَلِّي يَخْفِضُ مِنْ صَوْتِهِ ، وَمَرَّ عَلَى  عُمَرَ  وَهُوَ يُصَلِّي وَهُوَ يَرْفَعُ صَوْتَهُ ، فَلَمَّا أَصْبَحَا وَاجْتَمَعَا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ  لِأَبِي بَكْرٍ  :  يَا  أَبَا بَكْرٍ  ، مَرَرْتُ بِكَ وَأَنْتَ تُصَلِّي تَخْفِضُ مِنْ صَوْتِكَ ؟  قَالَ : قَدْ أَسْمَعْتُ مَنْ نَاجَيْتُ قَالَ : "" ارْفَعْ مِنْ صَوْتِكَ شَيْئًا "" .  وَقَالَ  لِعُمَرَ  : "" مَرَرْتُ بِكَ يَا  عُمَرُ  وَأَنْتَ تُصَلِّي تَرْفَعُ مِنْ صَوْتِكِ ؟ "" فَقَالَ : خَشِيتُ الشَّيْطَانَ يَا رَسُولَ اللهِ ، فَقَالَ : "" اخْفِضْ مِنْ صَوْتِكَ شَيْئًا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ -  مَوْصُولًا  - عَنْ  حَمَّادِ بْنِ سَلَمَةَ  إِلَّا  يَحْيَى بْنُ إِسْحَاقَ  ، وَلَا يُرْوَى عَنْ  أَبِي قَتَادَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7219","","أبو قتادة الأنصاري فارس رسول الله عن عبد الله بن رباح الأنصاري عن ثابت البناني عن حماد بن سلمة عن يحيى بن إسحاق السيلحيني عن محمود بن غيلان المروزي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7226","[7/182]      7220  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الضَّعِيفُ ،  ثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  عَنْ  أَيُّوبَ السَّخْتِيَانِيِّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِالنَّاسِ فِي وَجَعِهِ وَهُوَ جَالِسٌ ، فَقَامُوا فَأَوْمَأَ إِلَيْهِمْ ، فَجَلَسُوا ، فَقَالَ :  الْإِمَامُ يُؤْتَمُّ بِهِ ، فَإِذَا رَكَعَ فَارْكَعُوا  ، وَإِذَا سَجَدَ فَاسْجُدُوا ، وَإِذَا صَلَّى قَاعِدًا فَصَلُّوا قُعُودًا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَيُّوبَ  إِلَّا  عَبْدُ الْوَهَّابِ  "" .","","Al-Mu'jam al-Awsat 7220","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أيوب السختياني عن عبد الوهاب بن عبد المجيد الثقفي عن عبد الله بن محمد بن يحيى الضعيف عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7227","7221  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  زُنَيْجٌ أَبُو غَسَّانَ ،  نَا  الْحَكَمُ بْنُ بَشِيرٍ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  أَبِي رَزِينٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  دَخَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَسْجِدَ فَرَأَى النَّاسَ قَلِيلًا ، فَقَالَ :  لَوْ أَنَّ رَجُلًا نَادَى النَّاسَ إِلَى عَرْقٍ وَمِرْمَاةٍ -  يَعْنِي بِالْمِرْمَاةِ : رَغِيفًا  - لَأَجَابُوهُ  ، وَهُمْ يَتَخَلَّفُونَ عَنْ هَذِهِ الصَّلَاةِ ، وَالَّذِي نَفْسِي بِيَدِهِ لَقَدْ هَمَمْتُ أَنْ آمُرَ فِتْيَانًا فَيَجْمَعُونَ حُزَمًا مِنْ حَطَبٍ ، ثُمَّ أُحَرِّقُ عَلَى نَاسٍ بُيُوتَهُمْ ، يَسْمَعُونَ الْمُنَادِي لَا يُجِيبُونَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَاصِمٍ  ، عَنْ  أَبِي رَزِينٍ  إِلَّا  عَمْرُو بْنُ قَيْسٍ  ،  تَفَرَّدَ بِهِ  :  الْحَكَمُ بْنُ بَشِيرٍ  "" .  وَرَوَاهُ النَّاسُ عَنْ  عَاصِمٍ  ، عَنْ  أَبِي صَالِحٍ  ، عَنْ  أَبِي هُرَيْرَةَ  .  وَرُوِيَ عَنْ  عَاصِمٍ  ، عَنْ  زِرٍّ  ، عَنْ  عَبْدِ اللهِ  .","","Al-Mu'jam al-Awsat 7221","","أبو هريرة الدوسي عن مسعود بن مالك الأسدي عن عاصم بن بهدلة عن عمرو بن قيس الملائي عن الحكم بن  أبى إسماعيل النهدي عن محمد بن عمرو بن بكر بن سالم عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7228","7222  -  =  وَبِهِ  :  عَنْ  عَمْرِو بْنِ قَيْسٍ الْمُلَائِيِّ ،  عَنِ  الْحُرِّ بْنِ الصَّيَّاحِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَخْنَسِ ،  عَنْ  سَعِيدِ بْنِ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَبُو بَكْرٍ  فِي الْجَنَّةِ ،  وَعُمَرُ  فِي الْجَنَّةِ ،  وَعُثْمَانُ  فِي الْجَنَّةِ  ،  وَعَلِيٌّ  فِي الْجَنَّةِ ،  وَطَلْحَةُ  وَالزُّبَيْرُ  فِي الْجَنَّةِ ،  وَسَعْدُ بْنُ أَبِي وَقَّاصٍ  فِي الْجَنَّةِ ،  وَعَبْدُ الرَّحْمَنِ  فِي الْجَنَّةِ "" ، وَالتَّاسِعُ لَوْ شِئْتُ         [7/183]      قُلْتُهُ ، قَالُوا : مَنْ هُوَ ؟ قَالَ : هُوَ مَنْ كَانَ ، فَلَمَّا رَدُّوا عَلَيْهِ ، قَالَ : أَنَا ، وَبَكَى  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمْرِو بْنِ قَيْسٍ  إِلَّا  الْحَكَمُ بْنُ بَشِيرٍ  "" .","","Al-Mu'jam al-Awsat 7222","","سعيد بن زيد بن عمرو العدوي عن عبد الرحمن بن الأخنس الكوفي عن حر بن الصياح النخعي عن عمرو بن قيس الملائي عن الحكم بن  أبى إسماعيل النهدي عن محمد بن عمرو بن بكر بن سالم عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7229","7223  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  ثَنَا  مُحَمَّدُ بْنُ مِهْرَانَ الْجَمَّالُ ،  نَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  حُصَيْنِ بْنِ مَالِكٍ الْفَزَارِيِّ قَالَ :  سَمِعْتُ  شَيْخًا - وَكَانَ قَدِيمًا يُكْنَى بِأَبِي مُحَمَّدٍ -  يُحَدِّثُ عَنْ  حُذَيْفَةَ بْنِ الْيَمَانِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اقْرَءُوا الْقُرْآنَ  بِلُحُونِ  الْعَرَبِ  وَأَصْوَاتِهَا ، وَإِيَّاكُمْ  وَلُحُونَ  أَهْلِ الْكِتَابَيْنِ ، وَأَهْلِ الْفِسْقِ ، فَإِنَّهُ سَيَجِيءُ بَعْدِي قَوْمٌ يُرَجِّعُونَ بِالْقُرْآنِ تَرْجِيعَ الْغِنَاءِ وَالرَّهْبَانِيَّةِ وَالنَّوْحِ ، لَا يُجَاوِزُ حَنَاجِرَهُمْ ، مَفْتُونَةٌ قُلُوبُهُمْ ، وَقُلُوبُ مَنْ يُعْجِبُهُمْ شَأْنُهُمْ "" .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  حُذَيْفَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  بَقِيَّةُ  "" .","","Al-Mu'jam al-Awsat 7223","","حذيفة بن اليمان عن شيخ وكان قديما يكنى بأبي محمد عن حصين بن مالك الفزاري عن بقية بن الوليد عن محمد بن مهران الجمال عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7230","7224  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  إِسْحَاقُ بْنُ بُهْلُولٍ الْأَنْبَارِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ الْمَخْزُومِيُّ الْمَدِينِيُّ ،  ثَنَا  الْمُغِيرَةُ بْنُ إِسْمَاعِيلَ بْنِ أَيُّوبَ بْنِ سَلَمَةَ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ الرَّحْمَنِ الزُّهْرِيِّ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الرَّجُلِ يَتْبَعُ الْمَرْأَةَ حَرَامًا ، أَيَنْكِحُ أُمَّهَا ؟ أَوْ يَتْبَعُ الْأُمَّ حَرَامًا ، أَيَنْكِحُ ابْنَتَهَا ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يُحَرِّمُ الْحَرَامُ الْحَلَالَ ،  إِنَّمَا يُحَرِّمُ مَا كَانَ بِنِكَاحٍ حَلَالٍ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  عُثْمَانُ  ،  تَفَرَّدَ بِهِ  عَبْدُ اللهِ بْنُ نَافِعٍ  "" .","","Al-Mu'jam al-Awsat 7224","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن عثمان بن عبد الرحمن بن عمر الوقاصي عن المغيرة بن إسماعيل بن أيوب بن سلمة عن عبد الله بن نافع الصائغ عن إسحاق بن بهلول الأنباري عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7231","[7/184]      7225  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  مُحَمَّدُ بْنُ يَزِيدَ الْمُسْتَمْلِيُّ ،  نَا  يَعْقُوبُ الزُّهْرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ دَاوُدَ ، مَوْلَى الْخُزَاعِيِّينَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ أَبِي الْقَاسِمِ بْنِ عَامِرِ بْنِ نُمَيْرِ بْنِ خَرَشَةَ الثَّقَفِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ نُمَيْرِ بْنِ خَرَشَةَ  قَالَ :  وَفَدْنَا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَدْرَكْنَاهُ  بِالْجُحْفَةِ  ، فَاسْتَبْشَرَ النَّاسُ بِقُدُومِنَا ، فَأَسْلَمْنَا ، وَأَمَرَهُمْ بِالْقَدُّومِ مَعَهُ إِلَى  الْمَدِينَةِ  ، وَكَانَ يَحْضُرُ إِخْوَانُهُمْ مِنَ النَّاسِ كُلَّ عَشِيَّةٍ عَلَيْهِمْ ، وَعَلَى غُرَبَاءِ الْمُسْلِمِينَ الَّذِينَ قَدِمُوا عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ يَحُضُّ عَلَى نَصِيبِهِمْ ، فَيَقُولُ :  إِخْوَانَكُمْ ضِيفَانَكُمْ ، كُلُّ امْرِئٍ بِقَدْرِ مَا وَسَّعَ اللهُ عَلَيْهِ  فَيَقُومُ الرَّجُلُ فَيَأْخُذُ الرَّجُلَ وَالرَّجُلَيْنِ ، وَكَانَ الَّذِي يَأْخُذُ ثَلَاثَةً  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  "" .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  نُمَيْرِ بْنِ خَرَشَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ الزُّهْرِيُّ  "" .","","Al-Mu'jam al-Awsat 7225","","نمير بن خرشة الثقفي عن أبيه عن عبد العزيز بن أبي القاسم بن عامر بن نمير بن خرشة الثقفي عن إسماعيل بن داود مولى الخزاعيين عن يعقوب بن محمد بن عيسى عن محمد بن أحمد بن يزيد الرياحي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7232","7226  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  مُحَمَّدُ بْنُ يَزِيدَ الْمُسْتَمْلِيُّ ،  ثَنَا  أَشْعَثُ بْنُ شُعْبَةَ قَالَ :  سَمِعْتُ  أَرْطَاةَ بْنَ الْمُنْذِرِ يَذْكُرُ ، قَالَ :  سَمِعْتُ  حَكِيمَ بْنَ عُمَيْرٍ  يَذْكُرُ ، عَنِ  الْعِرْبَاضِ بْنِ سَارِيَةَ قَالَ :  نَزَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  خَيْبَرَ  ، وَكَانَ صَاحِبُ  خَيْبَرَ  مَارِدًا  مُنْكَرًا ، فَأَقْبَلَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا  مُحَمَّدُ  ، أَلَكُمْ أَنْ تَذْبَحُوا حُمُرَنَا ، وَتَأْكُلُوا تَمْرَنَا ، وَتَدْخُلُوا بُيُوتَنَا ، وَتَضْرِبُوا نِسَاءَنَا ؟ فَغَضِبَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  يَا  عَبْدَ الرَّحْمَنِ  ، ارْكَبْ فَرَسَكَ فَنَادِ فِي النَّاسِ : إِنَّ الْجَنَّةَ لَا تَحِلُّ إِلَّا لِمُؤْمِنٍ  ، وَأَنِ اجْتَمِعُوا إِلَى الصَّلَاةِ "" ، فَاجْتَمَعُوا ، فَصَلَّى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ : "" إِنَّ اللهَ لَمْ يُحِلَّ         [7/185]      لَكُمْ أَنْ تَدْخُلُوا بُيُوتَ أَهْلِ الْكِتَابِ إِلَّا بِإِذْنٍ ، وَلَا أَكْلَ أَمْوَالِهِمْ ، وَلَا ضَرْبَ نِسَائِهِمْ ، إِذَا أَعْطَوْكُمُ الَّذِي عَلَيْهِمْ ، إِلَّا مَا طَابُوا بِهِ نَفْسًا ، أَيَحْسَبُ امْرُؤٌ قَدْ شَبِعَ حَتَّى بَطِنَ ، وَهُوَ مُتَّكِئٌ عَلَى  أَرِيكَتِهِ  ، لَا يَظُنُّ أَنَّ اللهَ حَرَّمَ شَيْئًا إِلَّا مَا فِي هَذَا الْقُرْآنِ ؟ أَلَا وَإِنِّي قَدْ وَاللهِ حَرَّمْتُ وَأَمَرْتُ ، وَوَعَظْتُ بِأَشْيَاءَ ، إِنَّهَا لَمِثْلُ الْقُرْآنِ ، أَوْ أَكْثَرُ ، أَلَا وَإِنَّهُ لَا يَحِلُّ لَكُمْ مِنَ  السِّبَاعِ  كُلُّ ذِي نَابٍ ، وَلَا الْحُمُرُ  الْأَهْلِيَّةُ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَرْطَاةَ بْنِ الْمُنْذِرِ  إِلَّا  أَشْعَثُ بْنُ شُعْبَةَ  "" .","","Al-Mu'jam al-Awsat 7226","","عرباض بن سارية عن حكيم بن عمير بن الأحوص العنسي عن أرطاة بن المنذر السكوني عن أشعث بن شعبة المصيصي عن محمد بن يزيد المستملي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7233","7227  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  نَا  مُحَمَّدُ بْنُ يَزِيدَ الْمُسْتَمْلِيُّ ،  ثَنَا  أَبُو عَلِيٍّ عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ الْحَنَفِيُّ ،  ثَنَا  زُفَرُ بْنُ الْهُذَيْلِ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  ثَابِتِ بْنِ عُبَيْدٍ ،  عَنْ  أَبِي مَسْعُودٍ الْأَنْصَارِيِّ ،  أَنَّ  رَجُلًا  أَقْبَلَ إِلَى الصَّلَاةِ ، فَاسْتَقْبَلَتْهُ  امْرَأَتُهُ  ، فَأَكَبَّ عَلَيْهَا  ، فَتَنَاوَلَهَا ، فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ ذَلِكَ لَهُ ، فَلَمْ يَنْهَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زُفَرَ  إِلَّا  أَبُو عَلِيٍّ الْحَنَفِيُّ  .","","Al-Mu'jam al-Awsat 7227","","أبو مسعود البدري عن ثابت بن عبيد الأنصاري عن ليث بن أبي سليم عن زفر بن الهذيل الكوفي عن عبيد الله بن عبد المجيد الحنفي عن محمد بن أحمد بن يزيد الرياحي عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7234","7228  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ، وَمُحَمَّدُ بْنُ الْفَرَجِ الْجُنْدَيْسَابُورِيُّ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْبَلْخِيُّ ،  ثَنَا  صَفْوَانُ بْنُ عِيسَى الزُّهْرِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ هَارُونَ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي نَهِيكٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مِنَ السُّنَّةِ إِذَا جَلَسَ الرَّجُلُ أَنْ يَخْلَعَ نَعْلَيْهِ  فَيَضَعَهُمَا بِجَنْبِهِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادِ بْنِ سَعْدٍ  إِلَّا  عَبْدُ اللهِ بْنُ هَارُونَ الزَّبِيبِيُّ  ،  تَفَرَّدَ بِهِ  :  صَفْوَانُ بْنُ عِيسَى  "" .","","Al-Mu'jam al-Awsat 7228","","عبد الله بن عباس عن عثمان بن نهيك الفراهيدي عن زياد بن سعد الخراساني عن عبد الله بن هارون الصوفي عن صفوان بن عيسى عباية عن محمد بن أبى إبراهيم حمدويه عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7235","[7/186]      7229  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ ،  ثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْبَلْخِيُّ ،  ثَنَا  أَيُّوبُ بْنُ سُوَيْدٍ الرَّمْلِيُّ ،  نَا  عُتْبَةُ بْنُ أَبِي حَكِيمٍ ،  عَنْ  أَبِي سُفْيَانَ طَلْحَةَ بْنِ نَافِعٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَبَّاسٍ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعَدَ  الْعَبَّاسَ  ذَوْدًا مِنْ إِبِلٍ  ، فَبَعَثَنِي إِلَيْهِ ، فَبِتُّ عِنْدَهُ ، وَكَانَتْ لَيْلَةَ  مَيْمُونَةَ بِنْتِ الْحَارِثِ  ، فَنَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ غَيْرَ كَثِيرٍ ، فَتَوَسَّدْتُ الْوِسَادَةَ الَّتِي تَوَسَّدَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَامَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَتَوَضَّأَ فَأَسْبَغَ الْوُضُوءَ ، وَأَقَلَّ هَرَاقَةَ الْمَاءِ ، ثُمَّ قَامَ فَافْتَتَحَ الصَّلَاةَ ، وَقُمْتُ فَتَوَضَّأْتُ ، فَقُمْتُ عَنْ يَسَارِهِ ، فَأَخْلَفَ بِيَدِهِ فَأَخَذَ بِأُذُنِي فَأَقَامَنِي عَنْ يَمِينِهِ ، وَكَانَتْ  مَيْمُونَةُ  حَائِضًا ، فَقَامَتْ فَتَوَضَّأَتْ ، ثُمَّ قَعَدَتْ خَلْفَهُ تَذْكُرُ اللهَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُتْبَةَ بْنِ أَبِي حَكِيمٍ  إِلَّا  أَيُّوبُ بْنُ سُوَيْدٍ  "" .","","Al-Mu'jam al-Awsat 7229","","عبد الله بن عباس عن طلحة بن نافع العراقي عن عتبة بن أبي حكيم عن أيوب بن سويد الحميري عن محمد بن أبى إبراهيم حمدويه عن محمد بن جابان الجند يسابوري عن الطبراني","محمد بن سعيد بن جابان الجنديسابوري"
"7236","7230  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُسْلِمِ بْنِ عَبْدِ اللهِ بْنِ مُسْلِمٍ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  شَبَابٌ الْعُصْفُرِيُّ ،  ثَنَا  يُوسُفُ بْنُ خَالِدٍ السَّمْتِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ الْخَطْمِيُّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عُقْبَةَ بْنِ الْفَاكِهِ بْنِ سَعْدٍ الْأَنْصَارِيِّ ،  عَنْ  جَدِّهِ الْفَاكِهِ بْنِ سَعْدٍ  - وَكَانَتْ لَهُ  صُحْبَةٌ  - "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَغْتَسِلُ يَوْمَ الْجُمُعَةِ ، وَيَوْمَ الْفِطْرِ  ، وَيَوْمَ النَّحْرِ ، وَيَوْمَ عَرَفَةَ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنِ  الْفَاكِهِ بْنِ سَعْدٍ  إِلَّا مِنْ حَدِيثِ  أَبِي جَعْفَرٍ الْخَطْمِيِّ  ، وَلَمْ يَرْوِهِ عَنْ  أَبِي جَعْفَرٍ  إِلَّا  يُوسُفُ بْنُ خَالِدٍ ،  وَعَدِيُّ بْنُ الْفَضْلِ  "" .","","Al-Mu'jam al-Awsat 7230","","الفاكه بن سعد الخطمي عن عبد الرحمن بن عقبة بن الفاكه الأنصاري عن عمير بن يزيد بن عمير الخطمي عن يوسف بن خالد السمتي عن خليفة بن خياط عن محمد بن مسلم بن عبد الله بن مسلم الجنديسابوري عن الطبراني","محمد بن مسلم بن عبد الله بن مسلم الجنديسابوري"
"7237","7231  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ الْجُنْدَيْسَابُورِيُّ ،  نَا  عَلِيُّ بْنُ حَرْبٍ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  أَشْعَثُ بْنُ عَطَّافٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ الْعَرْزَمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي مُلَيْكَةَ ،  عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ قَالَ :  رَأَيْتُ  عُمَرَ بْنَ الْخَطَّابِ ، أَتَى  الْحَجَرَ  فَوَضَعَ يَدَيْهِ عَلَى جَنَبَتَيْهِ  ، ثُمَّ قَبَّلَ مَا بَيْنَهُمَا ، ثُمَّ قَالَ : "" أَمَا وَاللهِ إِنِّي لَأَعْلَمُ أَنَّكَ حَجَرٌ ، وَأَنَّكَ لَا تَضُرُّ وَلَا تَنْفَعُ  ، وَلَوْلَا أَنِّي رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُكَ مَا قَبَّلْتُكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ  إِلَّا  ابْنُ أَبِي مُلَيْكَةَ  ، وَلَا عَنِ  ابْنِ أَبِي مُلَيْكَةَ         [7/187]      إِلَّا  الْعَرْزَمِيُّ  ،  تَفَرَّدَ بِهِ  :  أَشْعَثُ بْنُ عَطَّافٍ  "" .","","Al-Mu'jam al-Awsat 7231","","عمر بن الخطاب عن المسور بن مخرمة عن ابن أبي مليكة عن محمد بن عبيد الله بن أبي سليمان العرزمي عن أشعث بن عطاف الكوفي عن علي بن حرب الجند يسابوري عن محمد بن مسلم الجنديسابوري عن الطبراني","محمد بن مسلم بن عبد الله بن مسلم الجنديسابوري"
"7238","7232  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدِ بْنِ مِهْرَانَ الرَّازِيُّ ،  ثَنَا  أَبُو مُطِيعٍ الْبَلْخِيُّ الْحَكَمُ بْنُ عَبْدِ اللهِ ،  عَنْ  خَارِجَةَ بْنِ مُصْعَبٍ ،  عَنْ  حُمَيْدٍ الطَّوِيلِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  سَمِعْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُلَبِّي بِهِمَا جَمِيعًا :  لَبَّيْكَ بِحَجَّةٍ وَعُمْرَةٍ مَعًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خَارَجَةَ  إِلَّا  أَبُو مُطِيعٍ  .","","Al-Mu'jam al-Awsat 7232","","أنس بن مالك عن حميد الطويل عن خارجة الضبعي عن الحكم بن عبد الله بن مسلمة الخراساني عن إبراهيم بن سعيد بن مهران الرازي عن محمد بن مسلم الجنديسابوري عن الطبراني","محمد بن مسلم بن عبد الله بن مسلم الجنديسابوري"
"7239","7233  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدِ بْنِ مِهْرَانَ الرَّازِيُّ ،  ثَنَا  أَبُو مُطِيعٍ الْحَكَمُ بْنُ عَبْدِ اللهِ ،  نَا  مُحَمَّدُ بْنُ قَيْسٍ الْأَسَدِيُّ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  سَأَلْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قُلْتُ :  يَا رَسُولَ اللهِ ، أَيُّ الْأَعْمَالِ أَحَبُّهَا إِلَى اللهِ ، وَأَقْرَبُهَا مِنَ اللهِ ؟ قَالَ : "" الصَّلَاةُ لِوَقْتِهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ قَيْسٍ  إِلَّا  أَبُو مُطِيعٍ  "" .","","Al-Mu'jam al-Awsat 7233","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن عون بن عبد الله بن عتبة عن محمد بن قيس الوالبي عن الحكم بن عبد الله بن مسلمة الخراساني عن إبراهيم بن سعيد بن مهران الرازي عن محمد بن مسلم عن الطبراني","محمد بن مسلم بن عبد الله بن مسلم الجنديسابوري"
"7240","7234  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  ثَنَا  رَوْحُ بْنُ قُرَّةَ الْمُقْرِئُ ،  ثَنَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  صَلَّيْتُ خَلْفَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى قُبِضَ  ، وَخَلْفَ  أَبِي بَكْرٍ  وَعُمَرَ  حَتَّى قُبِضَا ، فَمَا سَمِعْتُ أَحَدًا مِنْهُمْ جَهَرَ بِـ "" بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ "" فِي الصَّلَاةِ ، وَكَانُوا يَفْتَتِحُونَ بِـ "" الْحَمْدُ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ  إِلَّا  الْعَوَّامُ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ اللهِ بْنُ خِرَاشٍ  "" .","","Al-Mu'jam al-Awsat 7234","","أنس بن مالك عن إبراهيم بن يزيد بن شريك التيمي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن روح بن قرة المقرئ عن محمد بن مسلم عن الطبراني","محمد بن مسلم بن عبد الله بن مسلم الجنديسابوري"
"7241","7235  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  نَا  إِبْرَاهِيمُ بْنُ سَلْمِ بْنِ رُشَيْدِ بْنِ الْفَاخِرِ         [7/188]      الْهُجَيْمِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ قَيْسِ بْنِ عَبْدِ الرَّحْمَنِ ،  نَا  حُمَيْدٌ الطَّوِيلُ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَلَّى عَلَيَّ صَلَاةً وَاحِدَةً صَلَّى اللهُ عَلَيْهِ عَشْرًا  ، وَمَنْ صَلَّى عَلَيَّ عَشْرًا صَلَّى اللهُ عَلَيْهِ مِائَةً ، وَمَنْ صَلَّى عَلَيَّ مِائَةً كَتَبَ اللهُ بَيْنَ عَيْنَيْهِ بَرَاءَةً مِنَ النِّفَاقِ ، وَبَرَاءَةً مِنَ النَّارِ ، وَأَسْكَنَهُ اللهُ يَوْمَ الْقِيَامَةِ مَعَ الشُّهَدَاءِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حُمَيْدٍ  إِلَّا  عَبْدُ الْعَزِيزِ بْنُ قَيْسٍ  ،  تَفَرَّدَ بِهِ  :  إِبْرَاهِيمُ بْنُ سَلْمٍ  "" .","","Al-Mu'jam al-Awsat 7235","","أنس بن مالك عن حميد الطويل عن عبد العزيز بن قيس بن عبد الرحمن القرشي عن إبراهيم بن سلم الهجيمي عن محمد بن مسلم عن الطبراني","محمد بن مسلم بن عبد الله بن مسلم الجنديسابوري"
"7242","7236  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ ،  نَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ يَزِيدَ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَيَّامُ  التَّشْرِيقِ  أَيَّامُ أَكْلٍ  وَشُرْبٍ  .  قَالَ مُحَمَّدُ بْنُ يَحْيَى : "" فَأَنْكَرْتُ عَلَى عَبْدِ اللهِ بْنِ عُمَرَ هَذَا الْحَدِيثَ ، فَأَخْرَجَ إِلَيَّ كِتَابًا ، فَقَالَ :  حَدَّثَنِي  عَبْدُ اللهِ بْنُ وَهْبٍ - صَاحِبُ الْبَصْرِيِّ -  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَيَّامُ  التَّشْرِيقِ  أَيَّامُ أَكْلٍ  وَشُرْبٍ  "" .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  قَتَادَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ اللهِ بْنُ عُمَرَ  "" .","","Al-Mu'jam al-Awsat 7236","","عمر بن الخطاب عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الله بن وهب صاحب البصري عن عبد الله بن عمر الأصبهاني عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7243","[7/189]      7237  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  ثَنَا  أَبُو كُرَيْبٍ ،  نَا  عَبْدُ اللهِ بْنُ إِسْمَاعِيلَ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا زَوَّجَ  فَاطِمَةَ  مِنْ  عَلِيٍّ  قَالَ : "" أَعْطِهَا شَيْئًا "" قَالَ : لَيْسَ عِنْدِي ، قَالَ :  وَأَيْنَ دِرْعُكَ  الْحُطَمِيَّةُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  سَعِيدٌ  ، وَلَا عَنْ  سَعِيدٍ  إِلَّا  عَبْدُ اللهِ بْنُ إِسْمَاعِيلَ  ،  تَفَرَّدَ بِهِ  :  أَبُو كُرَيْبٍ  "" .  وَرَوَاهُ  عَبْدَةُ بْنُ سُلَيْمَانَ  ، عَنْ  سَعِيدٍ  ، عَنْ  أَيُّوبَ  .","","Al-Mu'jam al-Awsat 7237","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الله بن إسماعيل بن أبي خالد الكوفي عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7244","7238  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  بَكْرُ بْنُ يُونُسَ بْنِ بُكَيْرٍ ،  عَنْ  مُوسَى بْنِ عُلَيٍّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا أُخْبِرُكُمْ بِخِيَارِ عُمَّالِكُمْ وَشِرَارِهِمْ ؟  قَالُوا : بَلَى يَا رَسُولَ اللهِ ، قَالَ : "" خِيَارُهُمْ خِيَارُهُمْ لَكُمْ ، وَمَنْ تُحِبُّونَهُ وَيُحِبُّكُمْ ، وَتَدْعُونَ اللهَ لَهُ وَيَدْعُو اللهَ لَكُمْ ، وَشِرَارُهُمْ شِرَارُهُمْ لَكُمْ ، مَنْ تُبْغِضُونَهُ وَيُبْغِضُكُمْ ، وَتَدْعُونَ اللهَ عَلَيْهِ وَيَدْعُو اللهَ عَلَيْكُمْ "" فَقَالُوا : أَفَلَا نُقَاتِلُهُمْ يَا رَسُولَ اللهِ ؟ قَالَ : "" لَا ، دَعُوهُمْ مَا صَلَّوْا ، وَصَامُوا  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُوسَى بْنِ عُلَيٍّ  إِلَّا  بَكْرُ بْنُ يُونُسَ  ،  تَفَرَّدَ بِهِ  :  أَبُو كُرَيْبٍ  ، وَلَا يُرْوَى عَنْ  عُقْبَةَ بْنِ عَامِرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7238","","عقبة بن عامر بن عبس الفرضي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن بكر بن يونس الشيباني عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7245","7239  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  ثَنَا  الْقَاسِمُ بْنُ دِينَارٍ ،  نَا  حُسَيْنُ بْنُ عَلِيٍّ الْجُعْفِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  ثَنَا  ابْنُ جُدْعَانَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ  رَجُلًا  كَانَ  يَسُبُّ  أَبَا بَكْرٍ  عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  وَأَبُو بَكْرٍ  سَاكِتٌ ، فَلَمَّا سَكَتَ الرَّجُلُ رَدَّ  أَبُو بَكْرٍ  كَلِمَةً ، فَقَامَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَاتَّبَعَهُ  أَبُو بَكْرٍ  ، فَقَالَ : يَا رَسُولَ اللهِ ، يَسُبُّنِي وَأَنْتَ قَاعِدٌ ،  فَلَمَّا رَدَدْتُ ، أَوِ انْتَصَرْتُ ، أَوْ نَحْوَ هَذَا  ، قُمْتَ ؟ قَالَ :  إِنَّهُ كَانَ مَلَكٌ يَرُدُّ عَلَيْهِ ، وَيَقُولُ : كَذَبْتَ ، فَلَمَّا تَكَلَّمَتَ وَقَعَ الشَّيْطَانُ  ،         [7/190]      فَكَرِهْتُ أَنْ أَجْلِسَ . ثَلَاثٌ يَا  أَبَا بَكْرٍ  كُلُّهُنَّ حَقٌّ : لَيْسَ عَبْدٌ يُظْلَمُ بِمَظْلَمَةٍ فَيُغْضِي ابْتِغَاءَ وَجْهِ اللهِ ، إِلَّا أَعَزَّ اللهُ بِهَا نَصْرَةُ ، وَلَيْسَ عَبْدٌ يَفْتَحُ بَابَ عَطِيَّةٍ ، يَبْتَغِي وَجْهَ اللهِ ، أَوْ صِلَةً إِلَّا زَادَهُ اللهُ بِهَا كَثْرَةً ، وَلَيْسَ عَبْدٌ يَفْتَحُ بَابَ مَسْأَلَةٍ يَبْتَغِي بِهَا كَثْرَةً ، إِلَّا زَادَهُ اللهُ بِهَا قِلَّةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَلِيِّ بْنِ زَيْدٍ  إِلَّا  سُفْيَانُ بْنُ عُيَيْنَةَ  ، وَلَا رَوَاهُ عَنْ  سُفْيَانَ  إِلَّا  حُسَيْنٌ الْجُعْفِيُّ  ،  تَفَرَّدَ بِهِ  :  الْقَاسِمُ بْنُ دِينَارٍ  "" .  وَرَوَاهُ النَّاسُ عَنْ  سُفْيَانَ بْنِ عُيَيْنَةَ  ، عَنِ  ابْنِ عَجْلَانَ  ، عَنْ  سَعِيدٍ الْمَقْبُرِيِّ  ، عَنْ  أَبِي هُرَيْرَةَ  .  "" فَإِنْ كَانَ  حُسَيْنٌ الْجُعْفِيُّ  حَفِظَهُ ، فَهُوَ  غَرِيبٌ  مِنْ حَدِيثِ  عَلِيِّ بْنِ زَيْدٍ  ، عَنِ  ابْنِ الْمُسَيِّبِ  "" .","","Al-Mu'jam al-Awsat 7239","","أبو هريرة الدوسي عن سعيد بن المسيب عن علي بن زيد بن جدعان عن سفيان بن عيينة عن الحسين بن علي الجعفي عن القاسم بن زكريا الطحان عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7246","7240  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  نَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ ،  نَا  رَيْحَانُ بْنُ سَعِيدٍ ،  ثَنَا  عَرْعَرَةُ بْنُ الْبِرِنْدِ ،  نَا  الْمُثَنَّى أَبُو حَاتِمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ الْعَيْزَارِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدِ بْنِ أَبِي بَكْرٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَهَادَوْا تَحَابُّوا ، وَهَاجِرُوا تُوَرِّثُوا أَوْلَادَكُمْ مَجْدًا  ، وَأَقِيلُوا الْكِرَامَ  عَثَرَاتِهِمْ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْقَاسِمِ  إِلَّا  عُبَيْدُ اللهِ بْنُ الْعَيْزَارِ  ،  تَفَرَّدَ بِهِ  :  الْمُثَنَّى أَبُو حَاتِمٍ  "" .","","Al-Mu'jam al-Awsat 7240","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عبيد الله بن العيزار المازني عن المثنى بن بكر العبدي عن عرعرة بن البرند عن ريحان بن سعيد الناجي عن يحيى بن محمد بن السكن البزاز عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7247","7241  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  نَا  أَبُو هَمَّامٍ الْوَلِيدُ بْنُ شُجَاعٍ ،  نَا  سَعِيدُ بْنُ الْفَضْلِ الْقُرَشِيُّ ،  نَا  عُمَرُ بْنُ أَبِي صَالِحٍ الْعَتَكِيُّ ،  عَنْ  أَبِي غَالِبٍ ،  عَنْ  أَبِي أُمَامَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمَّا خَلَقَ اللهُ الْعَقْلَ قَالَ لَهُ : أَقْبِلْ  ،         [7/191]      فَأَقْبَلَ ، ثُمَّ قَالَ لَهُ : أَدْبِرْ ، فَأَدْبَرَ ، فَقَالَ : وَعِزَّتِي مَا خَلَقْتُ خَلْقًا أَعْجَبَ إِلَيَّ مِنْكَ ، بِكَ آخُذُ ، وَبِكَ أُعْطِي ، وَبِكَ الثَّوَابُ ، وَعَلَيْكَ الْعِقَابُ "" .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي أُمَامَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  أَبُو هَمَّامٍ  "" .","","Al-Mu'jam al-Awsat 7241","","أبو أمامة الباهلي عن أبو غالب البصري صاحب أبي أمامة عن عمر بن أبي صالح العتكي عن سعيد بن الفضل القرشي مولاهم عن الوليد بن شجاع عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7248","7242  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  ثَنَا  أَبُو كُرَيْبٍ ،  نَا  خَلَّادُ بْنُ يَزِيدَ الْجُعْفِيُّ ،  عَنْ  زُهَيْرٍ ،  عَنْ  جَابِرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّفَرَ الَّذِينَ أَتَوْا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جِنُّ  نَصِيبِينَ  ، أَتَوْهُ وَهُوَ  بِنَخْلَةَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَابِرٍ  إِلَّا  زُهَيْرٌ  ،  تَفَرَّدَ بِهِ  :  أَبُو كُرَيْبٍ  ، عَنْ  خَلَّادٍ  "" .","","Al-Mu'jam al-Awsat 7242","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن جابر الجعفي عن زهير بن معاوية بن حديج عن خلاد بن يزيد الجعفي عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7249","7243  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عُثْمَانُ بْنُ سَعِيدٍ ،  نَا  الْقَاسِمُ بْنُ مَعْنٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  بِلَالٍ ،  أَنَّهُ قَالَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَسْبِقْنِي  بِآمِينَ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْقَاسِمِ  إِلَّا  عُثْمَانُ بْنُ سَعِيدٍ  ،  تَفَرَّدَ بِهِ  :  أَبُو كُرَيْبٍ  "" .","","Al-Mu'jam al-Awsat 7243","","بلال بن رباح سابق الحبشة عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن القاسم بن معن عن عثمان بن سعيد الزيات عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7250","7244  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  نَا  أَحْمَدُ بْنُ مَنِيعٍ ،  ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ أَبِي يَزِيدَ الْهَمْدَانِيُّ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  مُعَاذِ بْنِ جَبَلٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ عَيَّرَ أَخَاهُ بِذَنْبٍ لَمْ يَمُتْ حَتَّى يَعْمَلَهُ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  مُعَاذٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  أَحْمَدُ بْنُ مَنِيعٍ  "" .","","Al-Mu'jam al-Awsat 7244","","معاذ بن جبل عن خالد بن معدان عن ثور بن يزيد الكلاعي عن محمد بن الحسن المعشاري عن أحمد بن منيع البغوي عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7251","7245  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  ثَنَا  صَالِحُ بْنُ قَطَنٍ الْبُخَارِيُّ ،  نَا  مُحَمَّدُ بْنُ عَمَّارِ بْنِ مُحَمَّدِ بْنِ عَمَّارِ بْنِ يَاسِرٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي         [7/192]      قَالَ :  رَأَيْتُ  عَمَّارَ بْنَ يَاسِرٍ ، صَلَّى بَعْدَ الْمَغْرِبِ سِتَّ رَكَعَاتٍ  ، فَقُلْتُ :  يَا أَبَهْ ، مَا هَذِهِ الصَّلَاةُ ؟ قَالَ : رَأَيْتُ حَبِيبِي رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى بَعْدَ الْمَغْرِبِ سِتَّ رَكَعَاتٍ ، وَقَالَ :  مَنْ صَلَّى بَعْدَ الْمَغْرِبِ سِتَّ رَكَعَاتٍ غُفِرَتْ لَهُ ذُنُوبُهُ  وَإِنْ كَانَتْ مِثْلَ زَبَدِ الْبَحْرِ  "" .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَمَّارٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  صَالِحُ بْنُ قَطَنٍ  "" .","","Al-Mu'jam al-Awsat 7245","","عمار بن ياسر عن محمد بن عمار بن ياسر العنسي عن عمار بن محمد بن عمار بن ياسر عن محمد بن عمار بن محمد بن عمار بن ياسر عن صالح بن قطن عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7252","7246  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  ثَنَا  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ،  نَا  مُوسَى بْنُ عَطِيَّةَ الْبَاهِلِيُّ ،  ثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  خَطَبَنَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ ، فَقَالَ : ""  إِنَّ اللهَ كَتَبَ عَلَيْكُمُ الْجُمُعَةَ فِي مَقَامِي هَذَا  ، فِي سَاعَتِي هَذِهِ ، فِي يَوْمِي هَذَا ، فِي شَهْرِي هَذَا ، فِي عَامِي هَذَا إِلَى يَوْمِ الْقِيَامَةِ ، مَنْ تَرَكَهَا مِنْ غَيْرِ عُذْرٍ مَعَ إِمَامٍ عَادِلٍ أَوْ إِمَامٍ جَائِرٍ فَلَا جُمِعَ لَهُ شَمْلُهُ وَلَا بُورِكَ لَهُ فِي أَمْرِهِ ، أَلَا وَلَا صَلَاةَ لَهُ ، أَلَا وَلَا حَجَّ لَهُ ، أَلَا وَلَا بِرَّ لَهُ ، أَلَا وَلَا صَدَقَةَ لَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطِيَّةَ  إِلَّا  فُضَيْلُ بْنُ مَرْزُوقٍ  ، وَلَا عَنْ  فُضَيْلٍ  إِلَّا  مُوسَى بْنُ عَطِيَّةَ  ،  تَفَرَّدَ بِهِ  :  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ  "" .  وَرَوَاهُ  أَسَدُ بْنُ مُوسَى  ،  وَعَبْدُ اللهِ بْنُ صَالِحٍ الْعِجْلِيُّ  ، عَنْ  فُضَيْلِ بْنِ مَرْزُوقٍ  ، عَنِ  الْوَلِيدِ بْنِ بُكَيْرٍ  ، عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدٍ الْعَدَوِيِّ  ، عَنْ  عَلِيِّ بْنِ زَيْدٍ  ، عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  ، عَنْ  جَابِرٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Al-Mu'jam al-Awsat 7246","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن موسى بن عطية الباهلي عن يحيى بن حبيب الحارثي عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7253","7247  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  نَا  أَحْمَدُ بْنُ يَزِيدَ بْنِ ذَكْوَانَ الْبَصْرِيُّ ،  ثَنَا  أَبُو هَمَّامٍ الصَّلْتُ بْنُ مُحَمَّدٍ الْخَارَكِيُّ ،  عَنِ  الْمُعَلَّى بْنِ رَاشِدٍ ،  عَنْ  جَدَّتِهِ ،  عَنْ  نُبَيْشَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَبَسَ فِي  تُهْمَةٍ  .         [7/193]      ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  نُبَيْشَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  أَحْمَدُ بْنُ يَزِيدَ  "" .","","Al-Mu'jam al-Awsat 7247","","نبيشة بن عبد الله بن عمرو الهذلي عن أم عاصم جدة المعلى بن راشد عن معلى بن راشد النبال عن الصلت بن محمد الخاركي عن أحمد بن يزيد بن ذكوان البصري عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7254","7248  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى ،  حَدَّثَنِي  أَبُو عُبَيْدِ اللهِ ، ابْنُ أَخِي هِلَالٍ الْيَايِّ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْعَطَّارُ ،  نَا  نَاصِحٌ أَبُو الْعَلَاءِ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ قَالَ :  كَانَ اسْمِي فِي الْجَاهِلِيَّةِ  عَبْدَ كُلَالٍ  ، فَسَمَّانِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَبْدَ الرَّحْمَنِ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  أَبُو عُبَيْدِ اللهِ بْنُ هِلَالٍ  "" .","","Al-Mu'jam al-Awsat 7248","","عبد الرحمن بن سمرة العبشمي عن عمار بن أبي عمار الحارثي عن ناصح بن العلاء البصري عن محمد بن إبراهيم العطار عن أبو عبيد الله ابن أخي هلال الياي عن محمد بن يحيى بن مندة عن الطبراني","محمد بن يحيى الأصبهاني"
"7255","7249  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ الْأَصْبَهَانِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ خَالِدٍ الْمِصِّيصِيُّ ،  نَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  احْفَظُونِي فِي أَصْحَابِي ، ثُمَّ الَّذِينَ يَلُونَهُمْ  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ يَظْهَرُ الْكَذِبُ حَتَّى يَشْهَدَ الرَّجُلُ قَبْلَ أَنْ يُسْتَشْهَدَ وَحَتَّى يَحْلِفَ قَبْلَ أَنْ يُسْتَحْلَفَ ، وَيَبْذُلَ نَفْسَهُ بِخُطَبِ الزُّورِ ، فَمَنْ سَرَّهُ  بَحْبُوحَةُ  الْجَنَّةِ فَلْيَلْزَمِ الْجَمَاعَةَ ، فَإِنَّ  يَدَ  اللهِ عَلَى الْجَمَاعَةِ ، وَإِنَّ الشَّيْطَانَ مَعَ الْوَاحِدِ ، وَهُوَ مِنَ الِاثْنَيْنِ أَبَعْدُ ، وَلَا يَخْلُوَنَّ رَجُلٌ بِامْرَأَةٍ ، فَإِنَّ ثَالِثُهُمَا الشَّيْطَانَ ، وَمَنْ سَاءَتْهُ سَيِّئَتُهُ وَسَرَّتْهُ حَسَنَتُهَ فَهُوَ مُؤْمِنٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي نَجِيحٍ  إِلَّا  ابْنُ جُرَيْجٍ  ،  تَفَرَّدَ بِهِ  :  حَجَّاجُ بْنُ مُحَمَّدٍ  "" .","","Al-Mu'jam al-Awsat 7249","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن ابن جريج عن حجاج بن محمد الأعور عن إبراهيم بن عبد الله بن خالد المصيصي عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7256","7250  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  نَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  نَا  إِسْمَاعِيلُ بْنُ قَيْسِ بْنِ سَعْدِ بْنِ زَيْدِ بْنِ ثَابِتٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،         [7/194]      عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَاكِرُوا طَلَبَ الرِّزْقِ وَالْحَوَائِجَ  ، فَإِنَّ الْغُدُوَّ بَرَكَةٌ وَنَجَاحٌ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامٍ  إِلَّا  إِسْمَاعِيلُ  "" .","","Al-Mu'jam al-Awsat 7250","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن إسماعيل بن قيس الأنصاري عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7257","7251  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  نَا  إِبْرَاهِيمُ بْنُ سَعِيدِ بْنِ الْجَوْهَرِيِّ ،  نَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ابْنُ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ مُحَمَّدِ بْنِ مُسْلِمٍ قَالَ :  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ هُرْمُزٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُحَيْنَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِأَصْحَابِهِ ، فَقَالَ :  هَلْ قَرَأَ أَحَدٌ مِنْكُمْ آنِفًا فِي الصَّلَاةِ ؟  قَالُوا : نَعَمْ ، قَالَ : "" إِنِّي أَقُولُ : لَا  أُنَازَعُ  الْقُرْآنَ "" وَانْتَهَى النَّاسُ عَنِ الْقِرَاءَةِ مَعَهُ حِينَ قَالَ ذَلِكَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  ، عَنِ  الْأَعْرَجِ  ، عَنِ  ابْنِ بُحَيْنَةَ  إِلَّا  ابْنُ أَخِي الزُّهْرِيِّ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ  "" .  وَرَوَاهُ النَّاسُ : عَنِ  الزُّهْرِيِّ  ، عَنِ  ابْنِ أُكَيْمَةَ  ، عَنْ  أَبِي هُرَيْرَةَ  .","","Al-Mu'jam al-Awsat 7251","","عبد الله بن مالك بن سعد بن القشب الأزدي عن عبد الرحمن بن هرمز الأعرج عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7258","7252  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  ابْنُ أَبِي عَبْلَةَ ،  عَنِ  ابْنِ بُدَيْلِ بْنِ وَرْقَاءَ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ  بُدَيْلًا  أَنْ يَحْبِسَ السَّبَايَا وَالْأَمْوَالَ  بِالْجِعْرَانَةِ  حَتَّى يَقْدَمَ عَلَيْهِ "" فَحُبِسَتْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِبْرَاهِيمَ بْنِ أَبِي عَبْلَةَ  إِلَّا  مُحَمَّدُ بْنُ إِسْحَاقَ  ،  تَفَرَّدَ بِهِ  :  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ  "" .","","Al-Mu'jam al-Awsat 7252","","بديل بن ورقاء العدوي عن عبد الله بن بديل بن ورقاء الخزاعي عن إبراهيم بن أبي عبلة عن محمد بن إسحاق عن يحيى بن سعيد بن أبان عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7259","7253  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  نَا  حُسَيْنُ بْنُ مُحَمَّدٍ الْمَرُّوذِيُّ ،  عَنْ  سُلَيْمَانَ بْنِ قَرْمٍ ،  عَنْ  أَبِي الْجَحَّافِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ         [7/195]      الزَّمِنِ ،  عَنْ  زَاذَانَ ،  عَنْ  عَلِيٍّ قَالَ :  أَوَّلُ صَلَاةٍ رَكَعْنَا فِيهَا الْعَصْرُ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا هَذَا ؟ قَالَ : "" بِهَذَا أُمِرْتُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الْجَحَّافِ  إِلَّا  سُلَيْمَانُ بْنُ قَرْمٍ  ،  تَفَرَّدَ بِهِ  :  حُسَيْنُ بْنُ مُحَمَّدٍ  "" .","","Al-Mu'jam al-Awsat 7253","","علي بن أبي طالب عن زاذان الكندي عن أبو عبد الرحمن الزمن عن داود بن أبي عوف البرجمي عن سليمان بن قرم الضبي عن الحسين بن محمد بن بهرام المروذي عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7260","7254  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  نَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  نَا  شَبَابَةُ بْنُ سَوَّارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْعَلَاءِ بْنِ زَبْرٍ ،  عَنِ  الْقَاسِمِ ، وَسَالِمٍ ، وَنَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصَلِّي عَلَى رَاحِلَتِهِ حَيْثُ تَوَجَّهَتْ بِهِ تَطَوُّعًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْقَاسِمِ  إِلَّا  عَبْدُ اللهِ بْنُ الْعَلَاءِ  ،  تَفَرَّدَ بِهِ  :  شَبَابَةُ بْنُ سَوَّارٍ  "" .","","Al-Mu'jam al-Awsat 7254","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن العلاء بن زبر عن شبابة بن سوار المدائني عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7261","7255  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  نَا  سَعِيدُ بْنُ مُحَمَّدٍ الْوَرَّاقُ ،  نَا  فُضَيْلُ بْنُ غَزْوَانَ ،  نَا  أَبُو الْمُغِيرَةِ الذُّهْلِيُّ ،  حَدَّثَنِي  فُلْفُلَةُ الْجُعْفِيُّ قَالَ :  سَمِعْتُ  الْحَسَنَ بْنَ عَلِيٍّ  ، يَقُولُ : "" رَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَنَامِ مُتَعَلِّقًا بِالْعَرْشِ ، وَرَأَيْتُ  أَبَا بَكْرٍ  آخِذًا بِحَقْوَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَرَأَيْتُ  عُمَرَ  آخِذًا بِحَقْوَيْ  أَبِي بَكْرٍ  ، وَرَأَيْتُ  عُثْمَانَ  آخِذًا بِحَقْوَيْ  عُمَرَ  ، وَرَأَيْتُ الدَّمَ يَنْصَبُّ مِنَ السَّمَاءِ إِلَى الْأَرْضِ "" ، فَحَدَّثَ  الْحَسَنُ  بِهَذَا الْحَدِيثِ وَعِنْدَهُ قَوْمٌ مِنَ الشِّيعَةِ ، فَقَالُوا : وَمَا رَأَيْتَ  عَلِيًّا  ؟ فَقَالَ  الْحَسَنُ  : "" مَا كَانَ أَحَدٌ أَحَبَّ إِلَيَّ أَنْ أَرَاهُ آخِذًا بِحَقْوَيِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  عَلِيٍّ  ، وَلَكِنَّهَا رُؤْيَا رَأَيْتُهَا "" .  فَقَالَ  أَبُو مَسْعُودٍ : فَإِنَّكُمْ تُحَدِّثُونَ عَنِ  الْحَسَنِ بْنِ عَلِيٍّ  فِي رُؤْيَا رَآهَا ، وَقَدْ كُنَّا         [7/196]      مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غَزَاةٍ ، فَأَصَابَ النَّاسَ  جَهْدٌ  حَتَّى رَأَيْتُ الْكَآبَةَ فِي وُجُوهِ الْمُسْلِمِينَ وَالْفَرَحَ فِي وُجُوهِ الْمُنَافِقِينَ ، فَلَمَّا رَأَى ذَلِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  وَاللهِ لَا تَغِيبُ الشَّمْسُ حَتَّى يَأْتِيَكُمُ اللهُ بِرِزْقٍ  ، فَعَلِمَ  عُثْمَانُ  أَنَّ اللهَ وَرَسُولَهُ سَيَصْدُقَانِ ، فَاشْتَرَى  عُثْمَانُ  أَرْبَعَةَ عَشَرَ رَاحِلَةً بِمَا عَلَيْهَا مِنَ الطَّعَامِ فَوَجَّهَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْهَا بِتِسْعَةٍ ، فَلَمَّا رَأَى ذَلِكَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" مَا هَذَا ؟ "" قَالُوا : أَهْدَى إِلَيْكَ  عُثْمَانُ  ، فَعُرِفَ الْفَرَحُ فِي وُجُوهِ الْمُسْلِمِينَ وَالْكَآبَةُ فِي وُجُوهِ الْمُنَافِقِينَ ، فَرَأَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ رَفَعَ يَدَيْهِ حَتَّى رُئِيَ بَيَاضُ إِبْطَيْهِ يَدْعُو  لِعُثْمَانَ  دُعَاءً مَا سَمِعْتُهُ دَعَا لِأَحَدٍ قَبْلَهُ وَلَا بَعْدَهُ بِمِثْلِهِ : "" اللَّهُمَّ أَعْطِ  عُثْمَانَ  ، اللَّهُمَّ افْعَلْ  لِعُثْمَانَ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي مَسْعُودٍ الْأَنْصَارِيِّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  سَعِيدُ بْنُ مُحَمَّدٍ الْوَرَّاقُ  "" .","","Al-Mu'jam al-Awsat 7255","","أبو مسعود البدري عن فلفلة بن عبد الله الجعفي عن أبو المغيرة عن فضيل بن غزوان عن سعيد بن محمد الوراق عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7262","7256  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  نَا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ قَيْسٍ الْأَسَدِيُّ ،  عَنْ  أَبِي عَوْنٍ الثَّقَفِيِّ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَتْ بَنُو فُلَانٍ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : يَا رَسُولَ اللهِ ، أَسْلَمْنَا وَفَعَلْنَا وَلَمْ نُقَاتِلْكَ وَقَدْ قَاتَلَتْكَ الْعَرَبُ ، فَالْتَفَتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  أَبِي بَكْرٍ  وَعُمَرَ  ، فَقَالَ : "" أَتَقُولَانِ هَكَذَا ؟ "" فَقَالَا : لَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ فِقْهَهُمْ قَلِيلٌ ، وَإِنَّ الشَّيْطَانَ تَقَوَّلَ عَلَى أَلْسِنَتِهِمْ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي عَوْنٍ  إِلَّا  مُحَمَّدُ بْنُ قَيْسٍ  ،  تَفَرَّدَ بِهِ  :  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ  "" .","","Al-Mu'jam al-Awsat 7256","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن محمد بن عبيد الله بن سعيد الثقفي عن محمد بن قيس الوالبي عن يحيى بن سعيد بن أبان عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7263","7257  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ الْأَصْبَهَانِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  أَبُو الْجَوَّابِ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ الْعَبَّاسِ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  مُنْذِرٍ         [7/197]      الثَّوْرِيِّ ،  عَنْ  سَعْدِ بْنِ حُذَيْفَةَ ،  عَنْ  حُذَيْفَةَ قَالَ :  بُعِثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  جَزِيرَةِ  الْعَرَبِ  فَمَلَأَهَا قِسْطًا وَعَدْلًا  "" ثُمَّ ظَعَنَ بِهِمْ أَبُو بَكْرٍ ، فَظَعَنَ بِهِمْ ظَعْنَةً  رَغِيبَةً  "" "" ثُمَّ ظَعَنَ بِهِمْ عُمَرُ ، فَظَعَنَ بِهِمْ ظَعْنَةً  رَغِيبَةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ  إِلَّا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ  "" .","","Al-Mu'jam al-Awsat 7257","","حذيفة بن اليمان عن سعد بن حذيفة بن اليمان العبسي عن المنذر بن يعلى الثوري عن سعيد بن مسروق الثوري عن عبد الجبار بن العباس الشبامي عن أحوص بن جواب الضبي عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7264","7258  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  حُسَيْنُ بْنُ مُحَمَّدٍ الْمَرُّوذِيُّ ،  عَنْ  سُلَيْمَانَ بْنِ قَرْمٍ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ الْعَبَّاسِ ،  عَنْ  عَمَّارٍ الدُّهْنِيِّ ،  عَنْ  عَقْرَبَ  بِنْتِ أَفْعَى ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  كَانَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ يُمْلِي عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمَّارٍ الدُّهْنِيِّ  إِلَّا  عَبْدُ الْجَبَّارِ  ، وَلَا عَنْ  عَبْدِ الْجَبَّارِ  إِلَّا  سُلَيْمَانُ بْنُ قَرْمٍ  ،  تَفَرَّدَ بِهِ  :  حُسَيْنُ بْنُ مُحَمَّدٍ  "" .  كذا في طبعة دار الحرمين ، ومجمع البحرين ، والصواب : ( عمرة ) كما في المعجم الكبير","","Al-Mu'jam al-Awsat 7258","","هند بنت أبي أمية زوج رسول الله عن عمرة بنت الشافع عن عمار بن معاوية الدهني عن عبد الجبار بن العباس الشبامي عن سليمان بن قرم الضبي عن الحسين بن محمد بن بهرام المروذي عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7265","7259  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  نَا  حُسَيْنُ بْنُ مُحَمَّدٍ ،  نَا  سُلَيْمَانُ بْنُ قَرْمٍ ،  عَنْ  أَبِي الْجَحَّافِ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ صُبَيْحٍ ،  عَنْ  جَدِّهِ  ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ قَالَ :  مَرَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى بَيْتٍ فِيهِ  فَاطِمَةُ  وَعَلِيٌّ ،  وَحَسَنٌ  وَحُسَيْنٌ  ، فَقَالَ :  أَنَا حَرْبٌ لِمَنْ حَارَبْتُمْ ، سِلْمٌ لِمَنْ  سَالَمْتُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ  إِلَّا  أَبُو الْجَحَّافِ  ، وَلَا عَنْ  أَبِي الْجَحَّافِ  إِلَّا  سُلَيْمَانُ بْنُ قَرْمٍ  ، وَلَا عَنْ  سُلَيْمَانَ  إِلَّا  حُسَيْنُ بْنُ مُحَمَّدٍ  ،  تَفَرَّدَ بِهِ  :  إِبْرَاهِيمُ بْنُ سَعِيدٍ  "" .","","Al-Mu'jam al-Awsat 7259","","زيد بن أرقم الأنصاري عن صبيح مولى أم سلمة عن إبراهيم بن عبد الرحمن بن صبيح عن داود بن أبي عوف البرجمي عن سليمان بن قرم الضبي عن الحسين بن محمد بن بهرام المروذي عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7266","7260  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  نَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  قَالَ :         [7/198]      قَالَ  أُسَامَةُ بْنُ زَيْدٍ :  كَانَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا  اضْطَمَّ  عَلَيْهِ النَّاسُ أَعْنَقَ ، فَإِذَا وَجَدَ  فَجْوَةً  نَصَّ  ، فَلَمَّا نَظَرَ إِلَى النَّاسِ قَالَ :  يَا أَيُّهَا النَّاسُ ، إِنَّ  الْبِرَّ  لَيْسَ بِالْإِيضَاعِ  .  قَالَ : وَقَالَ أُسَامَةُ :  سَارَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى نَزَلَ  بِالشِّعْبِ  بَيْنَ  الْمُزْدَلِفَةِ  وَعَرَفَةَ  ، فَبَالَ ، فَصَبَبْتُ عَلَيْهِ مِنَ  الْإِدَاوَةِ  فَتَوَضَّأَ ، ثُمَّ قُلْتُ : يَا نَبِيَّ اللهِ ، الصَّلَاةَ ، قَالَ :  الصَّلَاةُ أَمَامَكَ  ، ثُمَّ رَكِبَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى نَزَلَ  بِالْمُزْدَلِفَةِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ عَبَّادٍ  إِلَّا  ابْنُ إِسْحَاقَ  ، وَلَا عَنِ  ابْنِ إِسْحَاقَ  إِلَّا  يَحْيَى بْنُ سَعِيدٍ  وَالْمَشْهُورُ مِنْ حَدِيثِ  هِشَامِ بْنِ عُرْوَةَ  ، عَنْ أَبِيهِ ، عَنْ  أُسَامَةَ  "" .","","Al-Mu'jam al-Awsat 7260","","أسامة بن زيد بن حارثة ذو البطين عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن يحيى بن سعيد بن أبان عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7267","7261  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  حُسَيْنُ بْنُ مُحَمَّدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ ،  عَنْ  قُدَامَةَ بْنِ مُوسَى ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدْعُو : "" اللَّهُمَّ أَصْلِحْ لِي دِينِي الَّذِي جَعَلْتَهُ عِصْمَةَ أَمْرِي  ، وَأَصْلِحْ لِي دُنْيَايَ الَّتِي جَعَلْتَ فِيهَا مَعَاشِي ، وَأَصْلِحْ لِي         [7/199]      آخِرَتِي الَّتِي جَعَلْتَ إِلَيْهَا  مَعَادِي ،  وَاجْعَلِ الْحَيَاةَ زِيَادَةً لِي فِي كُلِّ خَيْرٍ ، وَاجْعَلِ الْمَوْتَ رَاحَةً لِي مِنْ كُلِّ شَرٍّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قُدَامَةَ بْنِ مُوسَى  إِلَّا  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ  ،  تَفَرَّدَ بِهِ  :  أَبُو قَطَنٍ  "" .","","Al-Mu'jam al-Awsat 7261","","أبو هريرة الدوسي عن ذكوان السمان عن قدامة بن موسى الجمحي عن عبد العزيز بن عبد الله الماجشون عن الحسين بن محمد بن بهرام المروذي عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7268","7262  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  الْأَسْوَدُ بْنُ عَامِرٍ - شَاذَانُ -  نَا  جَعْفَرٌ الْأَحْمَرُ ،  عَنْ  عَبْدِ اللهِ بْنِ عَطَاءٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ أَحَبَّ النِّسَاءِ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَاطِمَةُ  ، وَمِنَ الرِّجَالِ  عَلِيٌّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَعْفَرٍ الْأَحْمَرِ  إِلَّا  شَاذَانُ  ، وَلَا رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ عَطَاءٍ  إِلَّا  جَعْفَرٌ الْأَحْمَرُ  ،  وَمِنْدَلُ بْنُ عَلِيٍّ  "" .","","Al-Mu'jam al-Awsat 7262","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عبد الله بن عطاء الطائفي عن جعفر بن زياد الأحمر عن الأسود بن عامر شاذان عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7269","7263  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  نَا  جَعْفَرُ بْنُ عَوْنٍ ،  ثَنَا  أَبُو الْعُمَيْسِ ،  عَنْ  عَبْدِ الْمَجِيدِ بْنِ سُهَيْلٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ قَالَ :  قَالَ لِي  ابْنُ عَبَّاسٍ :  يَا  ابْنَ عُتْبَةَ  ، تَعْلَمُ آخِرَ سُورَةٍ مِنَ الْقُرْآنِ نَزَلَتْ جَمِيعًا ؟  قُلْتُ : نَعَمْ ،         {      إِذَا جَاءَ نَصْرُ اللهِ         }      قَالَ : "" صَدَقْتَ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ  إِلَّا  عَبْدُ الْمَجِيدِ بْنُ سُهَيْلٍ  ، وَلَا عَنْ  عَبْدِ الْمَجِيدِ  إِلَّا  أَبُو الْعُمَيْسِ  ،  تَفَرَّدَ بِهِ  :  جَعْفَرُ بْنُ عَوْنٍ  "" .","","Al-Mu'jam al-Awsat 7263","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن عبد المجيد بن سهيل بن عبد الرحمن بن عوف عن عتبة بن عبد الله بن عتبة المسعودي عن جعفر بن عون المخزومي عن إبراهيم بن سعيد الجوهري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7270","7264  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  نَا  إِبْرَاهِيمُ بْنُ خَالِدٍ الْمِصِّيصِيُّ ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ قَالَ :  قَالَ  ابْنُ جُرَيْجٍ :  قَالَ  خُصَيْفٌ :  سَأَلْتُ  سَعِيدَ بْنَ جُبَيْرٍ ، عَنْ قَوْلِهِ :         {      لا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا إِلا الْمَوَدَّةَ فِي الْقُرْبَى         }      . فَقَالَ :  قَالَ  ابْنُ عَبَّاسٍ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَسَطًا مِنْ  قُرَيْشٍ  ، كُلُّهَا لَهُ رَحِمٌ ، فَقَالَ :         {      قُلْ لا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا إِلا الْمَوَدَّةَ فِي الْقُرْبَى         }      إِلَّا أَنْ تَوَدُّونِي فِي قَرَابَةِ مَا بَيْنِي وَبَيْنَكُمْ  .         [7/200]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  حَجَّاجُ بْنُ مُحَمَّدٍ  ، وَلَا رَوَاهُ عَنْ  خُصَيْفٍ  إِلَّا  ابْنُ جُرَيْجٍ  وَشَرِيكٌ  "" .","","Al-Mu'jam al-Awsat 7264","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن خصيف الجزري عن ابن جريج عن حجاج بن محمد الأعور عن إبراهيم بن عبد الله بن خالد المصيصي عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7271","7265  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  نَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ خَالِدٍ الْمِصِّيصِيُّ ،  نَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِي بَكْرٍ الْهُذَلِيِّ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ، أَنَّ أَبَا هُرَيْرَةَ ،  حَدَّثَهُ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" إِنَّ اللهَ يَقُولُ :  يَا ابْنَ آدَمَ ، إِنَّكَ إِذَا ذَكَرْتَنِي شَكَرْتَنِي  ، وَإِذَا نَسِيتَنِي كَفَرْتَنِي "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الشَّعْبِيِّ  إِلَّا  أَبُو بَكْرٍ الْهُذَلِيُّ  ،  تَفَرَّدَ بِهِ  :  حَجَّاجُ بْنُ مُحَمَّدٍ  "" .","","Al-Mu'jam al-Awsat 7265","","أبو هريرة الدوسي عن الشعبي عن أبو بكر الهذلي عن حجاج بن محمد الأعور عن إبراهيم بن عبد الله بن خالد المصيصي عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7272","7266  - =  وَبِهِ  :  حَدَّثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  نِيَارِ بْنِ مُكْرَمٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْبِضْعُ  مَا بَيْنَ الثَّلَاثِ إِلَى التِّسْعِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  حَجَّاجٌ  "" .","","Al-Mu'jam al-Awsat 7266","","نيار بن مكرم الأسلمي عن عروة بن الزبير عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن ابن جريج عن حجاج بن محمد الأعور عن إبراهيم بن عبد الله بن خالد المصيصي عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7273","7267  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  نَا  عِصَامُ بْنُ رَوَّادِ بْنِ الْجَرَّاحِ ،  ثَنَا  أَبِي  ،  ثَنَا  نَافِعُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، أَنَّهَا سَمِعَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ  أَحْيَا  مَوَاتًا  فَهِيَ لَهُ  ، وَلَيْسَ  لِعِرْقِ  ظَالِمٍ حَقٌّ  .","","Al-Mu'jam al-Awsat 7267","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن رواد بن الجراح عن عصام بن رواد بن الجراح العسقلاني عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7274","7268  - =  وَبِهِ  : قَالَ :  حَدَّثَتْنِي  عَائِشَةُ ، أَنَّهَا سَمِعَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ افْتَرَضَ عَلَى الْعِبَادِ خَمْسَ صَلَوَاتٍ  فِي كُلِّ يَوْمٍ وَلَيْلَةٍ  "" .         [7/201]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعِ بْنِ عُمَرَ  إِلَّا  رَوَّادُ بْنُ الْجَرَّاحِ  "" .","","Al-Mu'jam al-Awsat 7268","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن رواد بن الجراح عن عصام بن رواد بن الجراح العسقلاني عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7275","7269  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  نَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ خَالِدٍ الْمِصِّيصِيُّ ،  نَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِي غَسَّانَ مُحَمَّدِ بْنِ مُطَرِّفٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ  إِدْرِيسَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ صَدِيقًا  لِمَلَكِ الْمَوْتِ  ، فَسَأَلَهُ أَنْ يُرِيَهَ الْجَنَّةَ وَالنَّارَ ، فَصَعِدَ  بِإِدْرِيسَ  فَأَرَاهُ النَّارَ فَفَزِعَ مِنْهَا ، وَكَادَ يُغْشَى عَلَيْهِ ، فَالْتَفَّ عَلَيْهِ  مَلَكُ الْمَوْتِ  بِجَنَاحِهِ ، فَقَالَ  مَلَكُ الْمَوْتِ  : أَلَيْسَ قَدْ رَأَيْتَهَا ؟ فَقَالَ : بَلَى ، وَلَمْ أَرَ كَالْيَوْمِ قَطُّ ، ثُمَّ انْطَلَقَ بِهِ حَتَّى أَرَاهُ الْجَنَّةَ فَدَخَلَهَا ، فَقَالَ لَهُ  مَلَكُ الْمَوْتِ  : أَلَيْسَ قَدْ رَأَيْتَهَا ؟ قَالَ : بَلَى ، هَذِهِ وَاللهِ الْجَنَّةُ ، فَقَالَ لَهُ  مَلَكُ الْمَوْتِ  : فَانْطَلِقْ قَدْ رَأَيْتَهَا ، قَالَ : إِلَى أَيْنَ ؟ قَالَ  مَلَكُ الْمَوْتِ  : حَيْثُ كُنْتَ ، قَالَ  إِدْرِيسُ  : لَا وَاللهِ لَا أَخْرُجُ مِنْهَا بَعْدَ إِذْ دَخَلْتُهَا ، فَقِيلَ  لِمَلَكِ الْمَوْتِ  : أَلَيْسَ أَنْتَ أَدْخَلْتَهُ إِيَّاهَا ، وَإِنَّهُ لَيْسَ لِأَحَدٍ دَخَلَهَا أَنْ يَخْرُجَ مِنْهَا  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أُمِّ سَلَمَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7269","","هند بنت أبي أمية زوج رسول الله عن عبيد الله بن أبي رافع مولى رسول الله عن زيد بن أسلم عن محمد بن مطرف بن داود عن حجاج بن محمد الأعور عن إبراهيم بن عبد الله بن خالد المصيصي عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7276","7270  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  أَحْمَدُ بْنُ الْوَلِيدِ الْكَرْخِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ مُحَمَّدٍ الْفَرْوِيُّ ،  نَا  نَافِعُ بْنُ أَبِي نُعَيْمٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى فَرَّجَ أَصَابِعَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعِ بْنِ أَبِي نُعَيْمٍ  إِلَّا  إِسْحَاقُ الْفَرْوِيُّ  ،  تَفَرَّدَ بِهِ  :  أَحْمَدُ بْنُ الْوَلِيدِ  "" .","","Al-Mu'jam al-Awsat 7270","","أبو هريرة الدوسي عن سعيد المقبري عن نافع بن عبد الرحمن بن أبي نعيم عن إسحاق بن محمد بن إسماعيل الفروي عن أحمد بن الوليد السامري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7277","7271  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ الْأَصْبَهَانِيُّ ،  ثَنَا  مُوسَى بْنُ عَامِرٍ أَبُو عَامِرٍ ،  ثَنَا         [7/202]      عِرَاكُ بْنُ خَالِدِ بْنِ يَزِيدَ ،  عَنْ  إِبْرَاهِيمَ بْنِ أَبِي عَبْلَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رَحِمَ اللهُ مَنْ سَمِعَ مَقَالَتِي هَذِهِ فَحَفِظَهَا حَتَّى يُبَلِّغَهَا غَيْرَهُ  ، ثَلَاثٌ لَا  يُغِلُّ  عَلَيْهِنَّ قَلْبُ امْرِئٍ مُسْلِمٍ : إِخْلَاصُ الْعَمَلِ لِلهِ ، وَالنُّصْحُ لِأَئِمَّةِ الْمُسْلِمِينَ ، وَاللُّزُومُ لِجَمَاعَتِهِمْ ، فَإِنَّ دُعَاءَهُمْ  يُحِيطُ  مِنْ وَرَائِهِمْ ، إِنَّهُ مَنْ تَكُنِ الدُّنْيَا نِيَّتَهُ يَجْعَلِ اللهُ فَقْرَهُ بَيْنَ عَيْنَيْهِ ، وَيُشَتِّتِ اللهُ عَلَيْهِ  ضَيْعَتَهُ  ، وَلَا يَأْتِيهِ مِنْهَا إِلَّا مَا كُتِبَ لَهُ ، وَمَنْ تَكُنِ الْآخِرَةُ نِيَّتَهُ يَجْعَلِ اللهُ غِنَاهُ فِي قَلْبِهِ ، وَيَكْفِيهِ ضَيْعَتَهُ ، وَتَأْتِيهِ الدُّنْيَا وَهِيَ رَاغِمَةٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِبْرَاهِيمَ بْنِ أَبِي عَبْلَةَ  إِلَّا  عِرَاكُ بْنُ خَالِدِ بْنِ يَزِيدَ  "" .","","Al-Mu'jam al-Awsat 7271","","زيد بن ثابت الأنصاري عن عجلان مولى فاطمة بنت عتبة عن محمد بن عجلان عن إبراهيم بن أبي عبلة عن عراك بن خالد الدمشقي عن موسى بن عامر بن عمارة المري عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7278","7272  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ خَالِدٍ الْمِصِّيصِيُّ ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  ثَنَا  أَبُو غَسَّانَ مُحَمَّدُ بْنُ مُطَرِّفٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا دَخَلَ أَهْلُ الْجَنَّةِ الْجَنَّةَ قَامَ  رَجُلٌ  فَقَالَ : يَا رَبِّ ، ائْذَنْ لِي فِي الزَّرْعِ  ، فَيَأْذَنُ لَهُ فَيَبْذُرُ حَبَّهُ ، فَلَا يَلْتَفِتُ حَتَّى تَعُودَ كُلُّ سُنْبُلَةٍ طُولُهَا اثْنَيْ عَشَرَ ذِرَاعًا ، ثُمَّ لَا يَبْرَحُ مَكَانَهُ حَتَّى يَكُونَ مِنْهُ رُكَامٌ أَمْثَالُ الْجِبَالِ "" فَقَالَ  أَعْرَابِيٌّ  : يَا رَسُولَ اللهِ ، لَا تَجِدُ هَذَا الرَّجُلَ إِلَّا قُرَشِيًّا أَوْ أَنْصَارِيًّا ، فَضَحِكَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  ، عَنْ  عَطَاءٍ  ، عَنْ  أَبِي هُرَيْرَةَ  إِلَّا  أَبُو غَسَّانَ  ،  تَفَرَّدَ بِهِ  :  حَجَّاجُ بْنُ مُحَمَّدٍ  "" .","","Al-Mu'jam al-Awsat 7272","","أبو هريرة الدوسي عن عطاء بن يسار الهلالي عن زيد بن أسلم عن محمد بن مطرف بن داود عن حجاج بن محمد الأعور عن إبراهيم بن عبد الله بن خالد المصيصي عن محمد بن أحمد بن راشد الأصبهاني عن الطبراني","محمد بن راشد الأصبهاني"
"7279","7273  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ عَجْلَانَ أَبُو شَيْخٍ الْأَصْبَهَانِيُّ الْأَبْهَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ ،  ثَنَا  سُهَيْلُ بْنُ عَبْدِ اللهِ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،         [7/203]      عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَمْ يَرْضَ بِقَضَاءِ اللهِ وَلَمْ يُؤْمِنْ بِقَدَرِ اللهِ فَلْيَلْتَمِسْ إِلَهًا غَيْرَ اللهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خَالِدٍ الْحَذَّاءِ  إِلَّا  سُهَيْلُ بْنُ عَبْدِ اللهِ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ  "" .","","Al-Mu'jam al-Awsat 7273","","أنس بن مالك عن أبو قلابة الجرمي عن خالد الحذاء عن سهيل بن أبي حزم القطعي عن محمد بن موسى الحرشي عن أبو شيخ الأبهري محمد بن الحسين عن الطبراني","محمد بن الحسن بن عجلان أبو شيخ الأصبهاني"
"7280","7274  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ أَبُو شَيْخٍ  ،  ثَنَا  مُحَمَّدُ بْنُ عَبَادَةَ الْوَاسِطِيُّ ،  ثَنَا  أَبُو سُفْيَانَ الْحِمْيَرِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَنَسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ الْغِنَى عَنْ كَثْرَةِ  الْعَرَضِ  ، إِنَّمَا الْغِنَى غِنَى النَّفْسِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حُمَيْدٍ  إِلَّا  هُشَيْمٌ  ، وَلَا عَنْ  هُشَيْمٍ  إِلَّا  أَبُو سُفْيَانَ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ عَبَادَةَ  "" .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( بن الحسين )","","Al-Mu'jam al-Awsat 7274","","أنس بن مالك عن حميد الطويل عن هشيم بن بشير عن سعيد بن يحيى الحميري عن محمد بن عبادة بن البخترى الأسدي عن أبو شيخ الأبهري محمد بن الحسين عن الطبراني","محمد بن الحسن بن عجلان أبو شيخ الأصبهاني"
"7281","7275  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُصَيْرٍ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تُقَصُّ الرُّؤْيَا إِلَّا عَلَى عَالِمٍ أَوْ نَاصِحٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُبَارَكِ بْنِ فَضَالَةَ  إِلَّا  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7275","","أبو هريرة الدوسي عن محمد بن سيرين عن هشام بن حسان العتكي عن مبارك بن فضالة عن إسماعيل بن عمرو البجلي عن محمد بن نصير بن أبان عن الطبراني","محمد بن نصير الأصبهاني"
"7282","7276  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُصَيْرٍ ،  ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  أَنَا  الْقَاسِمُ بْنُ مَعْنٍ قَالَ :  وَجَدْتُ فِي كِتَابِ  أَخِي بِخَطِّهِ  ،  يُخْبِرُ أَنَّ  فِي كِتَابِ أَبِيهِ  ،  حَدَّثَنِي  زَحْرُ بْنُ رَبِيعَةَ ، أَنَّ عَبْدَ اللهِ بْنَ مَسْعُودٍ  أَخْبَرَهُ  ، أَنَّ رَسُولَ اللهِ قَالَ :  الْقَطْعُ فِي دِينَارٍ ، أَوْ عَشَرَةِ دَرَاهِمَ  .         [7/204]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْقَاسِمِ بْنِ مَعْنٍ  إِلَّا  ابْنُ أَبِي زَائِدَةَ  .","","Al-Mu'jam al-Awsat 7276","","عبد الله بن مسعود عن زحر بن ربيعة عن عبد الملك بن معن المسعودي عن معن بن عبد الرحمن المسعودي عن القاسم بن معن عن يحيى بن زكريا بن أبي زائدة عن الشاذكوني عن محمد بن نصير بن أبان عن الطبراني","محمد بن نصير الأصبهاني"
"7283","7277  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُصَيْرٍ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَرْوَانَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِأَهْلِ النِّعَمِ حُسَّادًا  ، فَاحْذَرُوهُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  مُحَمَّدُ بْنُ مَرْوَانَ  "" .","","Al-Mu'jam al-Awsat 7277","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن محمد بن مروان السدي الصغير عن إسماعيل بن عمرو البجلي عن محمد بن نصير بن أبان عن الطبراني","محمد بن نصير الأصبهاني"
"7284","7278  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُصَيْرٍ الْأَصْبَهَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو ،  ثَنَا  إِسْرَائِيلُ وَأَبُو إِسْرَائِيلَ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كُنْتُ أَنْتَبِذُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي  جَرٍّ  أَخْضَرَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  إِلَّا  حَكِيمُ بْنُ جُبَيْرٍ  ، وَلَا رَوَاهُ عَنْ  حَكِيمٍ  إِلَّا  إِسْرَائِيلُ  وَأَبُو إِسْرَائِيلَ  "" .","","Al-Mu'jam al-Awsat 7278","","عائشة بنت أبي بكر الصديق عن عبد الله بن عباس عن سعيد بن جبير الأسدي عن حكيم بن جبير الأسدي عن إسماعيل بن خليفة الملائي عن إسماعيل بن عمرو البجلي عن محمد بن نصير بن أبان عن الطبراني","محمد بن نصير الأصبهاني"
"7285","7279  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُصَيْرٍ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو ،  نَا  أَبُو مَرْيَمَ عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ ،  نَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  بَيْنَا نَحْنُ جُلُوسٌ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ جَاءَهُ  رَجُلٌ  شَابٌّ لِيَسْتَفْتِيَهُ ، فَذَكَرَ أَنَّهُ لَقِيَ  امْرَأَةً  فَقَبَّلَهَا وَلَمَسَهَا  وَعَالَجَهَا  وَأَرَادَهَا وَلَمْ يَسْتَطِعْ ، فَلَمْ يُفْتِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَيْئًا ، فَلَمَّا انْطَلَقَ أَتْبَعَهُ  رَجُلًا  ، فَدَعَاهُ وَقَرَأَ هَذِهِ الْآيَةَ عَلَيْهِ :         {      وَأَقِمِ الصَّلاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ         }      الْآيَةَ . فَقَالَ الرَّجُلُ : يَا رَسُولَ اللهِ ، أَهِيَ لَهُ وَحْدَهُ أَمْ لِلنَّاسِ كَافَّةً ؟ قَالَ :  بَلْ لِلنَّاسِ كَافَّةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي مَرْيَمَ  إِلَّا  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7279","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن سماك بن حرب البكري عن عبد الغفار بن القاسم الأنصاري عن إسماعيل بن عمرو البجلي عن محمد بن نصير بن أبان عن الطبراني","محمد بن نصير الأصبهاني"
"7286","[7/205]      7280  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُصَيْرٍ ،  ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  نَا  شَرَقِيُّ بْنُ الْقُطَامِيِّ ،  عَنْ  عَمْرِو بْنِ قَيْسٍ ،  عَنْ  مُحِلِّ بْنِ وَدَاعَةَ ،  عَنْ  شُرَيْحِ بْنِ أَبْرَهَةَ قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَبَّرَ فِي أَيَّامِ  التَّشْرِيقِ  مِنْ صَلَاةِ الظُّهْرِ يَوْمَ النَّحْرِ حَتَّى خَرَجَ مِنْ  مِنًى  ، يُكَبِّرُ فِي دُبُرِ كُلِّ صَلَاةٍ مَكْتُوبَةٍ  .  قَالَ  أَبُو أَيُّوبَ الشَّاذَكُونِيُّ  : "" هَذَا عَلَى تَكْبِيرِ  أَهْلِ الْمَدِينَةِ  "" .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  شُرَيْحِ بْنِ أَبْرَهَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  شَرَقِيُّ بْنُ الْقُطَامِيِّ  "" .","","Al-Mu'jam al-Awsat 7280","","شريح بن أبرهة اليافعي عن محل بن وداعة عن عمرو بن قيس عن شرقي بن قطامى الكلبي عن عبد الواحد بن عبد الله الأنصاري عن الشاذكوني عن محمد بن نصير بن أبان عن الطبراني","محمد بن نصير الأصبهاني"
"7287","7281  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُصَيْرٍ ،  أَنَا  الشَّاذَكُونِيُّ ،  ثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الزِّنَادِ  إِلَّا  أَبُو أُمَيَّةَ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  .","","Al-Mu'jam al-Awsat 7281","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن إسماعيل بن يعلى الثقفي عن الشاذكوني عن محمد بن نصير بن أبان عن الطبراني","محمد بن نصير الأصبهاني"
"7288","7282  - =  وَبِهِ  :  حَدَّثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى ،  ثَنَا  نَافِعٌ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ  جَرْعَةٍ  أَعْظَمُ عِنْدَ اللهِ مِنْ  جَرْعَةً  غَيْظٍ  كَظَمَهَا  مُسْلِمٌ  ابْتِغَاءَ وَجْهِ اللهِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعٍ  إِلَّا  أَبُو أُمَيَّةَ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7282","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن إسماعيل بن يعلى الثقفي عن الشاذكوني عن محمد بن نصير بن أبان عن الطبراني","محمد بن نصير الأصبهاني"
"7289","7283  -  حَدَّثَنَا  مُحَمَّدُ بْنُ نُصَيْرٍ ،  ثَنَا  الشَّاذَكُونِيُّ ،  نَا  سَلْمُ بْنُ قُتَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ مِهْزَمٍ ،  عَنْ  عَطِيَّةَ ،         [7/206]      عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَدَأَ الْإِسْلَامُ  غَرِيبًا  ، وَسَيَعُودُ  غَرِيبًا  كَمَا بَدَأَ ،  فَطُوبَى  لِلْغُرَبَاءِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ مِهْزَمٍ  إِلَّا  سَلْمُ بْنُ قُتَيْبَةَ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7283","","أبو سعيد الخدري عن عطية بن سعد العوفي عن محمد بن مهزم البصري عن سلم بن قتيبة الشعيري عن الشاذكوني عن محمد بن نصير بن أبان عن الطبراني","محمد بن نصير الأصبهاني"
"7290","7284  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  ثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ،  وَعَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ، قَالَا :  اشْتَكَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْعُذْرَةَ  حَتَّى صَدَّعَتْهُ ، وَرُئِيَ ذَلِكَ عَلَيْهِ ، فَأَتَاهُ  جِبْرِيلُ  ، فَقَالَ :  إِنَّ رَبَّكَ أَرْسَلَنِي إِلَيْكَ لَأَرْقِيكَ  ، فَحَلَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَأْسَهُ ، فَقَالَ : بِسْمِ اللهِ أَرْقِيكَ ، مِنْ كُلِّ شَيْءٍ يُؤْذِيكَ ، مِنْ شَرِّ عَيْنِ كُلِّ حَاسِدٍ أَرْقِيكَ "" . قَالَ : "" فَرَدَّهَا عَلَيْهِ ثَلَاثَ مِرَارٍ ، فَبَرَأَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ  إِلَّا  مُحَمَّدُ بْنُ أَبَانَ  "" .","","Al-Mu'jam al-Awsat 7284","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن محمد بن أبان بن صالح عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7291","7285  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ ،  ثَنَا  أَبِي  ،  نَا  ثَابِتُ بْنُ يَزِيدَ أَبُو زَيْدٍ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  كُنْتُ قَائِمًا عَلَى عُمُومَتِي أَسْقِيهِمْ مِنْ فَضِيخٍ لَهُمْ  ، فَجَاءَ  رَجُلٌ  فَقَالَ : قَدْ حُرِّمَتِ الْخَمْرُ ، فَقَالُوا : أَكْفِئْهَا ، فَأَكْفَئْتُهَا ، قُلْتُ : مَا كَانَ ؟ قَالَ : بُسْرًا وَرُطَبًا  ""  قَالَ  أَبُو بَكْرٍ  :  إِنَّهُ كَانَتْ خَمْرَهُمْ يَوْمَئِذٍ ،  وَأَنَسٌ  يَسْمَعُ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَاصِمٍ الْأَحْوَلِ  إِلَّا  ثَابِتٌ أَبُو زَيْدٍ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ الْحَسَنِ  "" .","","Al-Mu'jam al-Awsat 7285","","أنس بن مالك عن عاصم بن سليمان الأحول عن ثابت بن يزيد الأحول العطار عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7292","[7/207]      7286  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  نَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ ،  ثَنَا  أَبِي  ،  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ ،  أَنَّ  رَجُلًا  جَاءَ وَقَدْ صَلَّى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَامَ يُصَلِّي وَحْدَهُ ، فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  يَتَّجِرُ  عَلَى هَذَا فَيُصَلِّي مَعَهُ  ؟  = .","","Al-Mu'jam al-Awsat 7286","","أنس بن مالك عن ثابت البناني عن حماد بن سلمة عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7293","7287  - =  وَبِهِ  :  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَمَا يَسْتَطِيعُ أَحَدُكُمْ أَنْ يَقْرَأَ  ثُلُثَ  الْقُرْآنِ فِي كُلِّ لَيْلَةٍ  ؟ "" قَالُوا : وَمَنْ يُطِيقُ ذَاكَ ؟ قَالَ : "" يَقْرَأُ :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  حَمَّادِ بْنِ سَلَمَةَ  إِلَّا  مُحَمَّدُ بْنُ الْحَسَنِ الْأَسَدِيُّ  "" .","","Al-Mu'jam al-Awsat 7287","","أنس بن مالك عن ثابت البناني عن حماد بن سلمة عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7294","7288  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ ،  ثَنَا  أَبِي  ،  ثَنَا  عُتْبَةُ أَبُو عَمْرٍو ،  عَنْ  أَبِي رَوْقٍ قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَائِطِ  رَجُلٍ مِنَ الْأَنْصَارِ  ، فَجَاءَ رَجُلٌ يَسْتَفْتِحُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قُمْ يَا  أَنَسُ  فَافْتَحْ لَهُ وَبَشِّرْهُ بِالْجَنَّةِ ، وَأَخْبِرْهُ أَنَّهُ سَيَلِي أُمَّتِي مِنْ بَعْدِي  ، فَقُمْتُ فَفَتَحْتُ لَهُ ، فَإِذَا  أَبُو بَكْرٍ  ، فَبَشَّرْتُهُ بِالْجَنَّةِ ، فَحَمِدَ اللهَ ثُمَّ دَخَلَ ، ثُمَّ جَاءَ آخَرُ فَدَقَّ الْبَابَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قُمْ يَا  أَنَسُ  فَافْتَحْ لَهُ وَبَشِّرْهُ بِالْجَنَّةِ ، وَأَخْبِرْهُ أَنَّهُ سَيَلِي أُمَّتِي مِنْ بَعْدِ  أَبِي بَكْرٍ  "" ، فَفَتَحْتُ لَهُ ، فَإِذَا  عُمَرُ  ، فَبَشَّرْتُهُ ، فَحَمِدَ اللهَ ثُمَّ دَخَلَ ، فَجَاءَ آخَرُ فَدَقَّ الْبَابَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قُمْ يَا  أَنَسُ  فَافْتَحْ لَهُ وَبَشِّرْهُ بِالْجَنَّةِ ، وَأَخْبِرْهُ أَنَّهُ سَيَلِي أُمَّتِي مِنْ بَعْدَ  أَبِي بَكْرٍ  وَعُمَرَ  ، وَأَنَّهُ سَيَلْقَى مِنَ الرَّعِيَّةِ شِدَّةً حَتَّى يَبْلُغُوا فِي ذَلِكَ دَمَهُ فَآمُرُهُ عِنْدَ ذَلِكَ بِالْكَفِّ "" ، فَفَتَحْتُ لَهُ ، فَإِذَا  عُثْمَانُ بْنُ عَفَّانَ  ، فَبَشَّرْتُهُ بِالْجَنَّةِ ، فَحَمِدَ اللهَ ، ثُمَّ أَخْبَرْتُهُ بِوِلَايَتِهِ ، وَأَنَّهُمْ سَيَبْلُغُوا فِي ذَلِكَ دَمَهُ ،  فَاسْتَرْجَعَ  ثُمَّ دَخَلَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي رَوْقٍ  إِلَّا  عُتْبَةُ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ الْحَسَنِ  "" .","","Al-Mu'jam al-Awsat 7288","","أنس بن مالك عن عطية بن الحارث الهمداني عن عتبة بن يقظان عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7295","7289  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  ثَنَا         [7/208]      يُونُسُ بْنُ مُحَمَّدٍ الْمُؤَدِّبُ ،  نَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ وَعْلَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَيُّمَا  إِهَابٍ  دُبِغَ فَقَدْ طَهُرَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ حَمَّادِ بْنِ زَيْدٍ إِلَّا يُونُسُ بْنُ مُحَمَّدٍ الْمُؤَدِّبُ ،  تَفَرَّدَ بِهِ  : مُحَمَّدُ بْنُ مَنْصُورٍ "" .","","Al-Mu'jam al-Awsat 7289","","عبد الله بن عباس عن عبد الرحمن بن وعلة السبائي عن زيد بن أسلم عن سفيان الثوري عن حماد بن زيد عن يونس بن محمد بن مسلم البغدادي عن محمد بن منصور الطوسي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7296","7290  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  نَا  عَبْدُ اللهِ بْنُ خَالِدِ بْنِ يَزِيدَ اللُّؤْلُؤِيُّ ،  نَا  أَبِي  ،  نَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  سُفْيَانَ بْنِ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ قَالَ :  سَمِعْتُ  جَابِرَ بْنَ عَبْدِ اللهِ قَالَ :  كُنَّا نَتَزَوَّدُ مِنْ لُحُومِ الْهَدْيِ عَلَى عَهْدِ رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  الْمَدِينَةِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَيْسٍ  إِلَّا  خَالِدُ بْنُ يَزِيدَ اللُّؤْلُؤِيُّ  "" .","","Al-Mu'jam al-Awsat 7290","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن قيس بن الربيع الأسدي عن خالد بن يزيد اللؤلؤي عن عبد الله بن خالد بن يزيد اللؤلؤي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7297","7291  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ ،  ثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْأَسَدِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  الْعَلَاءُ بْنُ زُهَيْرٍ ،  عَنْ  وَبَرَةَ بْنِ عَبْدِ الرَّحْمَنِ قَالَ :  كُنَّا عِنْدَ عَبْدِ اللهِ بْنِ عُمَرَ ، حِينَ سَأَلَهُ  رَجُلٌ مِنْ أَهْلِ الْكُوفَةِ  ، فَقَالَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، أَخْبِرْنِي عَنْ  عُثْمَانَ بْنِ عَفَّانَ  هَلْ شَهِدَ  بَدْرًا  ؟ قَالَ : لَا ، قَالَ : اللهُ أَكْبَرُ قَالَ : أَخْبِرْنِي هَلْ كَانَ  عُثْمَانُ  تَوَلَّى يَوْمَ الْتَقَى الْجَمْعَانِ ؟ قَالَ : نَعَمْ ، قَالَ : اللهُ أَكْبَرُ ، قَالَ : أَخْبِرْنِي هَلْ شَهِدَ  عُثْمَانُ  يَوْمَ بَيْعَةِ الرِّضْوَانِ ؟ قَالَ : لَا ، قَالَ : اللهُ أَكْبَرُ ، فَانْطَلَقَ ، فَقُلْتُ لَهُ - مَكَانِي - : إِنَّ الرَّجُلَ مِنْ  أَهْلِ الْكُوفَةِ  وَهُمْ يُحِبُّونَ  عَلِيًّا  وَيُبْغِضُونَ  عُثْمَانَ  ، قَالَ : عَلَيَّ بِالرَّجُلِ ، فَأُتِيَ بِهِ .  فَقَالَ : سَأَلْتَنِي عَنْ  عُثْمَانَ  هَلْ شَهِدَ  بَدْرًا  ؟ فَقُلْتُ لَكَ : لَا ، وَسَأُخْبِرُكَ عَنْ ذَلِكَ ، إِنَّ بِنْتَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَتْ مَرِيضَةً ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَخَلَّفْ عَلَى ابْنَتِي ؟ "" فَقَالَ : مَا أَحْبَبْتَ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَإِنَّهُ أَحَبُّ إِلَيَّ أَنْ  أَتَخَلَّفَ  عَلَيْهَا  ،         [7/209]      وَجَعَلَ لَهُ مِثْلَ أَجْرِ مَنْ شَهِدَهَا وَأَسْهَمَهُ ، قُلْ وَاحِدَةً : اللهُ أَكْبَرُ . وَأَمَّا قَوْلُكَ : إِنَّهُ كَانَ فِيمَنْ تَوَلَّى يَوْمَ الْتَقَى الْجَمْعَانِ ، فَقَدْ أَخْبَرَنَا اللهُ أَنَّهُ قَدْ عَفَا عَنْهُمْ ، قُلْ ثِنْتَيْنِ : اللهُ أَكْبَرُ . وَأَمَّا قَوْلُكَ إِنَّهُ لَمْ يَشْهَدْ بَيْعَةَ الرِّضْوَانِ ، فَإِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَ  عُثْمَانَ  إِلَى  أَهْلِ مَكَّةَ  ، فَلَمَّا أَمَرَ بِالْبَيْعَةِ قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اللَّهُمَّ إِنَّ  عُثْمَانَ  فِي حَاجَتِكَ وَحَاجَةِ رَسُولِكَ ، وَإِنَّ هَذِهِ يَدِي وَهَذِهِ يَدُ  عُثْمَانَ  "" ، وَضَرَبَ بِيَدِهِ عَلَى يَدِهِ الْأُخْرَى فَبَايَعَ لَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  وَبَرَةَ  إِلَّا  الْعَلَاءُ بْنُ زُهَيْرٍ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ الْحَسَنِ  "" .","","Al-Mu'jam al-Awsat 7291","","عبد الله بن عمر بن الخطاب عن وبرة بن عبد الرحمن المسلي عن العلاء بن زهير الأزدي عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7298","7292  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ ،  ثَنَا  أَبِي  ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  قَالَ  الْمُهَاجِرُونَ  لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَقَدْ أَتَيْنَا قَوْمًا مَا رَأَيْنَا قَوْمًا أَحْسَنَ مُوَاسَاةً فِي قَلِيلٍ وَلَا أَحْسَنَ بَذْلًا فِي كَثِيرٍ مِنْهُمْ ، وَاللهِ لَقَدْ كَفَوْنَا الْمُؤْنَةَ وَأَشْرَكُونَا فِي الْمَهْنَأِ ، وَلَقَدْ خَشِينَا أَنْ يَذْهَبُوا بِالْأَجْرِ كُلِّهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَلَّا ، مَا أَثْنَيْتُمْ عَلَيْهِمْ وَدَعَوْتُمْ لَهُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُلَيْمَانَ التَّيْمِيِّ  إِلَّا ابْنُهُ ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ الْحَسَنِ  "" .","","Al-Mu'jam al-Awsat 7292","","أنس بن مالك عن سليمان بن طرخان عن معتمر بن سليمان عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7299","7293  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  ثَنَا  صَالِحُ بْنُ إِسْحَاقَ الْجِهْبِذُ - دَلَّنِي عَلَيْهِ  يَحْيَى بْنُ مَعِينٍ  -  نَا  مَعْرُوفُ بْنُ وَاصِلٍ ،  عَنْ  يَعْقُوبَ بْنِ أَبِي نُبَاتَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ الْأَغَرِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أُنَاسًا مِنْ أَهْلِ لَا إِلَهَ إِلَّا اللهُ يَدْخُلُونَ النَّارَ بِذُنُوبِهِمْ  ، فَيَقُولُ لَهُمْ أَهْلُ  اللَّاتِ  وَالْعُزَّى : مَا أَغْنَى عَنْكُمْ قَوْلُكُمْ : لَا إِلَهَ إِلَّا اللهُ وَأَنْتُمْ مَعَنَا فِي النَّارِ ، فَيَغْضَبُ اللهُ لَهُمْ ، فَيُخْرِجُهُمْ ، فَيُلْقِيهِمْ فِي نَهَرِ الْحَيَاةِ ، فَيَبْرَءُونَ مِنْ حَرْقِهِمْ كَمَا يَبْرَأُ الْقَمَرُ مِنْ كُسُوفِهِ ، فَيَدْخُلُونَ الْجَنَّةَ ، وَيُسَمَّوْنَ         [7/210]      فِيهَا الْجَهَنَّمِيِّينَ "" .  فَقَالَ  رَجُلٌ  : يَا  أَنَسُ  ، أَنْتَ سَمِعْتَ هَذَا مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ  أَنَسٌ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  نَعَمْ ، أَنَا سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ هَذَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَعْرُوفِ بْنِ وَاصِلٍ  إِلَّا  صَالِحُ بْنُ إِسْحَاقَ الْجِهْبِذُ  "" .","","Al-Mu'jam al-Awsat 7293","","أنس بن مالك عن عبد الرحمن الأغر عن يعقوب بن أبي نباتة عن معرف بن واصل السعدي عن صالح بن إسحاق الجهبذ عن محمد بن منصور الطوسي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7300","7294  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  نَا  بَكْرُ بْنُ يَحْيَى بْنِ زَبَّانَ ،  نَا  حِبَّانُ بْنُ عَلِيٍّ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  دَاوُدَ بْنِ عَلِيٍّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَلَدُ الزِّنَا  شَرُّ  الثَّلَاثَةِ ، إِذَا عَمِلَ بِعَمَلِ أَبَوَيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  دَاوُدَ بْنِ عَلِيٍّ  إِلَّا  ابْنُ أَبِي لَيْلَى  ،  تَفَرَّدَ بِهِ  :  بَكْرُ بْنُ يَحْيَى بْنِ زَبَّانَ  "" .","","Al-Mu'jam al-Awsat 7294","","عبد الله بن عباس عن علي بن عبد الله بن عباس بن عبد المطلب عن داود بن علي الهاشمي عن محمد بن عبد الرحمن بن أبي ليلى عن حبان بن علي العنزي عن بكر بن يحيى العنزي عن أبو موسى الزمن عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7301","7295  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  نَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  عَبْدُ اللهِ بْنُ قَيْسٍ الرَّقَاشِيُّ الْخَزَّازُ ،  ثَنَا  حَسَّانُ بْنُ زَرْبِيٍّ النَّهْدِيُّ ،  عَنْ  أَبِي سَعِيدٍ الرَّقَاشِيِّ قَالَ :  دَخَلْتُ عَلَى عَائِشَةَ ،  فَقَالَتْ  :  مَا بَالُ  أَبِي حَسَنٍ  يَقْتُلُ أَصْحَابَهُ الْقُرَّاءَ  ؟ قَالَ : قُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ، إِنَّا وَجَدْنَا فِي الْقَتْلَى  ذَا الثُّدَيَّةِ  ،  فَشَهِقَتْ - أَوْ تَنَفَّسَتْ  - ، ثُمَّ قَالَتْ : إِنَّ كَاتِمَ الشَّهَادَةِ مِثْلُ شَاهِدٍ  بِزُورٍ  ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَقْتُلُ هَذِهِ الْعِصَابَةَ خَيْرُ أُمَّتِي  .         [7/211]      ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي سَعِيدٍ الرَّقَاشِيِّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ الْمُثَنَّى  "" .","","Al-Mu'jam al-Awsat 7295","","عائشة بنت أبي بكر الصديق عن بيان بن جندب الرقاشي عن حسان بن زربي النهدي عن عبد الله بن قيس الرقاشي عن أبو موسى الزمن عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7302","7296  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ ،  نَا  إِسْحَاقُ بْنُ إِدْرِيسَ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ أَحَبَّ أَنْ يُسَوِّرَ وَلَدَهُ بِسِوَارٍ مِنْ نَارٍ فَلْيُسَوِّرْهُ بِسِوَارٍ مِنْ ذَهَبٍ  ، وَلَكِنِ الْفِضَّةُ اعْمَلُوا بِهَا كَيْفَ شِئْتُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي حَازِمٍ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ زَيْدٍ  ، وَلَا عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زَيْدٍ  إِلَّا  إِسْحَاقُ بْنُ إِدْرِيسَ  ،  تَفَرَّدَ بِهِ  :  يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ  "" .","","Al-Mu'jam al-Awsat 7296","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن عبد الرحمن بن زيد بن أسلم عن إسحاق بن إدريس الأسواري عن يحيى بن محمد بن السكن البزاز عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7303","7297  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  عَلِيُّ بْنُ الْمُنْذِرِ الطَّرِيقِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ السَّلُولِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ وَمُعَاوِيَةُ بْنُ إِسْحَاقَ ،  عَنْ  أَبِي صَالِحٍ الْحَنَفِيِّ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ مَثَّلَ بِشَيْءٍ ثُمَّ لَمْ يَتُبْ مِنْهُ ، مُثِّلَ بِهِ يَوْمَ الْقِيَامَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ  إِلَّا  قَيْسٌ  ،  تَفَرَّدَ بِهِ  :  إِسْحَاقُ بْنُ مَنْصُورٍ  "" .","","Al-Mu'jam al-Awsat 7297","","عبد الله بن عمر بن الخطاب عن عبد الرحمن بن قيس الحنفي عن معاوية بن إسحاق بن طلحة التيمي عن إسحاق بن منصور السلولي عن علي بن المنذر العلاف عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7304","7298  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  عَلِيُّ بْنُ حَرْبٍ الْمَوْصِلِيُّ ،  نَا  أَبُو سَعِيدٍ الْهَيْثَمُ بْنُ مَحْفُوظٍ السَّعْدِيُّ ،  ثَنَا  أَبُو إِسْرَائِيلَ ،  عَنِ  السَّرِيِّ بْنِ إِسْمَاعِيلَ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  سَلْمَانَ الْفَارِسِيِّ قَالَ :  نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَنْكِحَ نِسَاءَ الْعَرَبِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي لَيْلَى  إِلَّا  الشَّعْبِيُّ  ، وَلَا رَوَاهُ عَنِ  الشَّعْبِيِّ  إِلَّا  السَّرِيُّ بْنُ إِسْمَاعِيلَ  ، وَلَا رَوَاهُ عَنِ  السَّرِيِّ  إِلَّا  أَبُو إِسْرَائِيلَ  ،  تَفَرَّدَ بِهِ  :  الْهَيْثَمُ بْنُ مَحْفُوظٍ  "" .","","Al-Mu'jam al-Awsat 7298","","سلمان الفارسي عن عبد الرحمن بن أبي ليلى عن الشعبي عن السري بن إسماعيل الهمداني عن إسماعيل بن خليفة الملائي عن الهيثم بن محفوظ عن علي بن حرب الطائي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7305","[7/212]      7299  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  الْفَضْلُ بْنُ يَعْقُوبَ الرُّخَامِيُّ ،  نَا  حَبِيبٌ - كَاتِبُ مَالِكٍ -  نَا  عَبْدُ اللهِ بْنُ عَامِرٍ الْأَسْلَمِيُّ ،  عَنْ  عَمْرِو بْنِ مُسْلِمٍ الْجُنْدَعِيِّ ،  عَنْ  رِفَاعَةَ بْنِ رَافِعٍ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِأَبِي بَكْرٍ  وَعُمَرَ  :  الْحَمْدُ لِلهِ الَّذِي أَيَّدَنِي بِكُمَا ، وَلَوْلَا أَنَّكُمَا تَخْتَلِفَانِ عَلَيَّ مَا خَالَفْتُكُمَا  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنِ  الْبَرَاءِ بْنِ عَازِبٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  حَبِيبٌ - كَاتِبُ مَالِكٍ  "" .","","Al-Mu'jam al-Awsat 7299","","البراء بن عازب الأوسي عن رفاعة بن رافع الزرقي عن عمرو بن مسلم بن عمارة الجندعي عن عبد الله بن عامر الأسلمي عن حبيب بن أبي حبيب الحنفي عن الفضل بن يعقوب الرخامي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7306","7300  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  سُفْيَانُ بْنُ وَكِيعِ بْنِ الْجَرَّاحِ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُصَافِحُوا الْيَهُودَ وَالنَّصَارَى  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُهَيْلٍ  إِلَّا  أَبُو بَكْرِ بْنُ عَيَّاشٍ  "" .","","Al-Mu'jam al-Awsat 7300","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن أبو بكر بن عياش عن سفيان بن وكيع بن الجراح عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7307","7301  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  نَا  صَفْوَانُ بْنُ عِيسَى ،  ثَنَا  زِيَادٌ أَبُو عَمْرٍو ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِقَطْعِ الْمَرَاجِيحِ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَائِشَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  صَفْوَانُ بْنُ عِيسَى  "" .","","Al-Mu'jam al-Awsat 7301","","عائشة بنت أبي بكر الصديق عن صالح بن أبي مريم الضبعي عن زياد بن مسلم الفراء عن صفوان بن عيسى عباية عن يعقوب بن إبراهيم بن كثير عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7308","7302  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  سَمِعْتُ  عَبْدَ الرَّحْمَنِ الْأَعْرَجَ ،  يُحَدِّثُ عَنْ  أَبِي هُرَيْرَةَ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا افْتَتَحَ الصَّلَاةَ قَالَ :         {      الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      ثُمَّ يَسْكُتُ هُنَيْهَةً  .         [7/213]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شُعْبَةَ  إِلَّا  أَبُو دَاوُدَ  "" .","","Al-Mu'jam al-Awsat 7302","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن محمد بن عبد الرحمن بن سعد بن زرارة عن شعبة بن الحجاج عن أبو داود الطيالسي عن الفلاس عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7309","7303  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  الْحَسَنُ بْنُ مُحَمَّدٍ الزَّعْفَرَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ زَكَرِيَّا الْمَدَائِنِيُّ ،  عَنْ  عَنْبَسَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مِنَ  الْبِرِّ  أَنْ تَصِلَ صَدِيقَ أَبِيكَ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَنَسٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ، وَلَمْ يَرْوِ  ابْنُ سَابِطٍ  ، عَنْ  أَنَسٍ  حَدِيثًا غَيْرَ هَذَا  "" .","","Al-Mu'jam al-Awsat 7303","","أنس بن مالك عن عبد الرحمن بن سابط الجمحي عن عنبسة بن عبد الرحمن بن عنبسة الأموي عن سعيد بن زكريا القرشي عن الحسن بن محمد الزعفراني عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7310","7304  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  ثَنَا  هَارُونُ بْنُ مُسْلِمٍ ، صَاحِبُ الْحِنَّاءِ  نَا  الْقَاسِمُ بْنُ عَبْدِ الرَّحْمَنِ الْأَنْصَارِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الرَّكْعَتَيْنِ قَبْلَ الصُّبْحِ وَالرَّكْعَتَيْنِ بَعْدَ الْمَغْرِبِ  :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ  ، عَنْ  عَائِشَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  هَارُونُ بْنُ مُسْلِمٍ  "" .","","Al-Mu'jam al-Awsat 7304","","عائشة بنت أبي بكر الصديق عن أبو جعفر الباقر عن القاسم بن عبد الرحمن المسعودي عن هارون بن مسلم بن هرمز العجلي عن نصر بن علي بن نصر الجهضمي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7311","7305  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يُونُسَ الرَّقِّيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  أَهْدَى  صَاحِبُ الْإِسْكَنْدَرِيَّةِ الْمُقَوْقِسُ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُكْحُلَةَ عِيدَانٍ شَامِيَّةً ، وَمِرْآةً ، وَمُشْطًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  الْوَلِيدُ بْنُ مُسْلِمٍ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الرَّحْمَنِ بْنُ يُونُسَ  "" .","","Al-Mu'jam al-Awsat 7305","","عائشة بنت أبي بكر الصديق عن عطاء بن أبي رباح عن ابن جريج عن الوليد بن مسلم القرشي عن عبد الرحمن بن يونس السراج عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7312","7306  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  الْحَسَنُ بْنُ نَاصِحٍ الْمُخَرِّمِيُّ ،  نَا  رُوَيْمُ بْنُ يَزِيدَ الْمُقْرِئُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ يَحْيَى التَّيْمِيُّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،         [7/214]      عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  رَأَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَبَا الدَّرْدَاءِ  يَمْشِي بَيْنَ يَدَيْ  أَبِي بَكْرٍ الصِّدِّيقِ  ، فَقَالَ :  يَا  أَبَا الدَّرْدَاءِ  ، تَمْشِي قُدَّامَ رَجُلٍ لَمْ تَطْلُعِ الشَّمْسُ بَعْدَ النَّبِيِّينَ عَلَى رَجُلٍ أَفْضَلَ مِنْهُ  ؟ "" "" فَمَا رُئِيَ  أَبُو الدَّرْدَاءِ  بَعْدَ ذَلِكَ يَمْشِي إِلَّا خَلْفَ  أَبِي بَكْرٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  ، عَنْ  عَطَاءٍ  ، عَنْ  جَابِرٍ  إِلَّا  إِسْمَاعِيلُ بْنُ يَحْيَى  ،  تَفَرَّدَ بِهِ  :  رُوَيْمُ بْنُ يَزِيدَ الْمُقْرِئُ  "" .  وَرَوَاهُ غَيْرُهُ ، عَنِ  ابْنِ جُرَيْجٍ  ، عَنْ  عَطَاءٍ  ، عَنْ  أَبِي الدَّرْدَاءِ  .","","Al-Mu'jam al-Awsat 7306","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن ابن جريج عن إسماعيل بن يحيى التيمي عن رويم بن يزيد البغدادي عن الحسن بن ناصح الخلال عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7313","7307  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  مُحَمَّدُ بْنُ حَرْبٍ النَّشَائِيُّ ،  ثَنَا  أَبُو سُفْيَانَ الْحِمْيَرِيُّ ،  ثَنَا  الضَّحَّاكُ بْنُ حُمْرَةَ ،  عَنْ  يَزِيدَ بْنِ خُمَيْرٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عُرِضَتْ عَلَيَّ الْأَيَّامُ ، فَعُرِضَ عَلَيَّ فِيهَا يَوْمُ الْجُمُعَةِ  ، فَإِذَا هِيَ كَمِرْآةٍ حَسْنَاءَ ، وَإِذَا فِي وَسَطِهَا  نُكْتَةٌ  سَوْدَاءُ ، فَقُلْتُ : مَا هَذَا ؟ قِيلَ : السَّاعَةُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ بْنِ خُمَيْرٍ  إِلَّا  الضَّحَّاكُ بْنُ حُمْرَةَ  ،  تَفَرَّدَ بِهِ  :  أَبُو سُفْيَانَ الْحِمْيَرِيُّ  "" .","","Al-Mu'jam al-Awsat 7307","","أنس بن مالك عن يزيد بن خمير الرحبي عن الضحاك بن حمرة الأملوكي عن سعيد بن يحيى الحميري عن محمد بن حرب النشائي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7314","7308  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ النَّشَائِيُّ ،  ثَنَا  عَلِيُّ بْنُ يَزِيدَ الْأَكْفَانِيُّ ،  عَنْ  حَفْصٍ الْغَاضِرِيِّ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  قَالَ  :  سَمِعَ عَلِيُّ بْنُ أَبِي طَالِبٍ ، ضَجَّةً فِي الْمَسْجِدِ ، يَقْرَءُونَ الْقُرْآنَ وَيُقْرِئُونَ ، فَقَالَ :  طُوبَى لِهَؤُلَاءِ ، هَؤُلَاءِ كَانُوا أَحَبَّ النَّاسِ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَاصِمِ بْنِ كُلَيْبٍ  إِلَّا  حَفْصٌ الْغَاضِرِيُّ  ،  تَفَرَّدَ بِهِ  :  عَلِيُّ بْنُ يَزِيدَ  "" .","","Al-Mu'jam al-Awsat 7308","","علي بن أبي طالب عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن حفيص الأسدي عن علي بن يزيد بن سليم الأكفاني عن محمد بن حرب النشائي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7315","7309  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ الْحَجَّاجِ بْنِ الْمِنْهَالِ الْأَنْمَاطِيُّ ،         [7/215]      ثَنَا  أَبِي  ،  ثَنَا  يَزِيدُ بْنُ إِبْرَاهِيمَ التُّسْتَرِيُّ ،  ثَنَا  لَيْثُ بْنُ أَبِي سُلَيْمٍ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ،  عَنِ  الرُّبَيِّعِ بِنْتِ مُعَوِّذٍ ، قَالَتْ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَأْتِينَا وَيَغْشَانَا ، فَإِذَا حَضَرَتِ الصَّلَاةُ وَضَعْنَا لَهُ إِنَاءً  ، حَزَرْنَاهُ يَأْخُذُ مُدًّا أَوْ مُدًّا وَنِصْفًا ، فَيَغْسِلُ كَفَّيْهِ ثَلَاثًا ، وَيَتَمَضْمَضُ ثَلَاثًا ،  وَيَسْتَنْشِقُ  ثَلَاثًا ، وَيَغْسِلُ وَجْهَهُ ثَلَاثًا ، ثُمَّ يَغْسِلُ يَدَيْهِ ثَلَاثًا ثَلَاثًا ، وَيَمْسَحُ رَأْسَهُ مَرَّةً ، وَيَغْسِلُ أُذُنَيْهِ ظَاهِرَهُمَا وَبَاطِنَهُمَا وَغُضُونَهُمَا ، وَيَغْسِلُ رِجْلَيْهِ ثَلَاثًا ثَلَاثًا ، وَيُخَلِّلُ بَيْنَ أَصَابِعِهِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  النُّعْمَانِ بْنِ سَالِمٍ  إِلَّا  لَيْثٌ  ، وَلَا عَنْ  لَيْثٍ  إِلَّا  يَزِيدُ  ، وَلَا عَنْ  يَزِيدَ  إِلَّا  حَجَّاجٌ  ،  تَفَرَّدَ بِهِ  : ابْنُهُ "" .","","Al-Mu'jam al-Awsat 7309","","الربيع بنت معوذ النجارية عن النعمان بن سالم الطائفي عن ليث بن أبي سليم عن يزيد بن إبراهيم التستري عن حجاج بن المنهال الأنماطي عن عبيد الله بن الحجاج بن المنهال الأنماطي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7316","7310  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  الْمِنْهَالُ بْنُ بَحْرٍ ،  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي سِنَانٍ ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عُبَيْدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  - وَكَانَتْ لَهُ صُحْبَةٌ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْإِيمَانُ ثَلَاثُمِائَةٍ وَثَلَاثَةٌ وَثَلَاثُونَ شَرِيعَةً ، مَنْ وَافَى بِوَاحِدَةٍ مِنْهَا دَخَلَ الْجَنَّةَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حَمَّادِ بْنِ سَلَمَةَ  إِلَّا  الْمِنْهَالُ بْنُ بَحْرٍ  ،  تَفَرَّدَ بِهِ  :  أَبُو حَفْصٍ  "" .","","Al-Mu'jam al-Awsat 7310","","عبيد الشامي عن أبو مغيرة بن عبد الرحمن بن عبيد عن مغيرة بن عبد الرحمن بن عبيد عن عيسى بن سنان القسملي عن حماد بن سلمة عن المنهال بن بحر القشيري عن الفلاس عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7317","7311  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  النَّضْرُ بْنُ هِشَامٍ الْأَصْبَهَانِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ حَيَّانَ بْنِ حَكِيمِ بْنِ حَنْظَلَةَ بْنِ سُوَيْدِ بْنِ عَلْقَمَةَ بْنِ سَعْدِ بْنِ مُعَاذٍ الْأَنْصَارِيُّ ،  حَدَّثَنِي  شَرِيكٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَخَلَّلُوا ، فَإِنَّهُ نَظَافَةٌ  ، وَالنَّظَافَةُ تَدْعُو إِلَى الْإِيمَانِ ، وَالْإِيمَانُ مَعَ صَاحِبِهِ فِي الْجَنَّةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُغِيرَةَ  إِلَّا  شَرِيكٌ  ، وَلَا عَنْ  شَرِيكٍ  إِلَّا  إِبْرَاهِيمُ بْنُ حَيَّانَ  ،  تَفَرَّدَ بِهِ  :  النَّضْرُ بْنُ هِشَامٍ  "" .","","Al-Mu'jam al-Awsat 7311","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن المغيرة بن مقسم الضبي عن شريك بن عبد الله بن أبي نمر الكناني عن إبراهيم بن حيان بن حكيم الأشهلي عن النضر بن هشام الأصبهاني عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7318","[7/216]      7312  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ وَاقِدٍ ،  ثَنَا  أَيُّوبُ بْنُ جَابِرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُوتِرُ بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ، وَ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  نَافِعٍ  إِلَّا  أَيُّوبُ بْنُ جَابِرٍ ،  تَفَرَّدَ بِهِ  عَبْدُ الرَّحْمَنِ بْنُ وَاقِدٍ  .  وَرَوَاهُ النَّاسُ عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ  .  وَرَوَاهُ  إِسْرَائِيلُ  عَنْ  أَبِي إِسْحَاقَ  عَنْ  مُسْلِمٍ الْبَطِينِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ  .","","Al-Mu'jam al-Awsat 7312","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أبو إسحاق السبيعي عن أيوب بن جابر السحيمي عن عبد الرحمن بن واقد الواقدي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7319","7313  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  عَلِيُّ بْنُ سَالِمٍ الْبَغْدَادِيُّ  ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا - يَعْنِي ابْنَ أَبِي زَائِدَةَ - ،  عَنِ  الْأَجْلَحِ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ كُهَيْلٍ  ،  عَنْ  عَلِيٍّ قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  بِإِرْتَاجِ  الْبَابِ  ، وَأَنْ  تُخَمِّرَ  الْإِنَاءَ ، وَأَنْ تُوكِئَ السِّقَاءَ ، وَأَنْ تُطْفِئَ السِّرَاجَ  .  لَمْ يَرْوِ  كُهَيْلٌ أَبُو سَلَمَةَ  ، عَنْ  عَلِيٍّ  حَدِيثًا غَيْرَ هَذَا ، وَلَا رَوَاهُ عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ  إِلَّا  الْأَجْلَحُ  ، وَلَا عَنِ  الْأَجْلَحِ  إِلَّا  يَحْيَى بْنُ زَكَرِيَّا  "" .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( علي بن مسلم ) كما في مجمع البحرين","","Al-Mu'jam al-Awsat 7313","","علي بن أبي طالب عن كهيل بن الحصين بن ثمارح عن سلمة بن كهيل الحضرمي عن أجلح بن عبد الله الكندي عن يحيى بن زكريا بن أبي زائدة عن علي بن مسلم الطوسي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7320","7314  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  خَلَّادُ بْنُ أَسْلَمَ ،  ثَنَا  مُحَمَّدُ بْنُ الزِّبْرِقَانِ ،  عَنْ  مَرْوَانَ بْنِ سَالِمٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،         [7/217]      عَنِ  ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الْعَبْدَ إِذَا قَامَ فِي الصَّلَاةِ جُمِعَتْ ذُنُوبُهُ عَلَى رَأْسِهِ ، فَإِذَا رَكَعَ تَفَرَّقَتْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ  إِلَّا  مَرْوَانُ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ الزِّبْرِقَانِ  "" .","","Al-Mu'jam al-Awsat 7314","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن مروان بن سالم الغفاري عن محمد بن الزبرقان الأهوازي عن خلاد بن أسلم الصفار عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7321","7315  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  سَهْلُ بْنُ بَكَّارٍ ،  ثَنَا  وُهَيْبٌ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عُتَيٍّ ،  عَنْ  أُبَيِّ بْنِ كَعْبٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَلَكَ أَهْلُ  الْعُقْدَةِ  وَرَبِّ الْكَعْبَةِ  ، وَاللهِ مَا عَلَيْهِمْ آسَى ، وَلَكِنِّي آسَى عَلَى مَنْ أُهْلِكُوا مِنْ أُمَّةِ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يُونُسَ  إِلَّا  وُهَيْبٌ  ، وَلَا عَنْ  وُهَيْبٍ  إِلَّا  سَهْلُ بْنُ بَكَّارٍ  ،  تَفَرَّدَ بِهِ  :  ابْنُ الْمُثَنَّى  "" .","","Al-Mu'jam al-Awsat 7315","","أبي بن كعب عن عتي بن ضمرة التميمي عن الحسن البصري عن يونس بن عبيد عن وهيب بن خالد الكرابيسي عن سهل بن بكار الدارمي عن أبو موسى الزمن عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7322","7316  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدِ بْنِ فُضَيْلٍ الْجَزَرِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  أَصْبَغُ بْنُ مُحَمَّدٍ الرَّقِّيُّ ،  عَنْ  جَعْفَرِ بْنِ بُرْقَانَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مِنْ أَشْرَاطِ السَّاعَةِ أَنْ يَغْلِبَ عَلَى الدُّنْيَا  لُكَعُ  بْنُ  لُكَعَ  ، فَخَيْرُ النَّاسِ يَوْمَئِذٍ مُؤْمِنٌ بَيْنَ  كَرِيمَيْنِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  جَعْفَرُ بْنُ بُرْقَانَ  ، وَلَا عَنْ  جَعْفَرٍ  إِلَّا  أَصْبَغُ بْنُ مُحَمَّدٍ  ،  تَفَرَّدَ بِهِ  :  عَمْرُو بْنُ عُثْمَانَ  "" .","","Al-Mu'jam al-Awsat 7316","","عمر بن الخطاب عن سعيد بن المسيب عن الزهري عن جعفر بن برقان الكلابي عن أصبغ بن محمد الرقي عن عمرو بن عثمان بن سيار الرقي عن جعفر بن محمد بن الفضيل الرسعني عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7323","7317  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  خَلَّادُ بْنُ أَسْلَمَ ،  ثَنَا  عَبْدُ الْمَجِيدِ بْنُ         [7/218]      عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَحَبُّ الطَّعَامِ إِلَى اللهِ مَا كَثُرَتْ عَلَيْهِ الْأَيْدِي  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  عَبْدُ الْمَجِيدِ  "" .","","Al-Mu'jam al-Awsat 7317","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن عبد المجيد بن عبد العزيز بن أبي رواد عن خلاد بن أسلم الصفار عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7324","7318  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  ثَنَا  عَبَّادُ بْنُ يَعْقُوبَ الْأَسَدِيُّ ،  ثَنَا  عَلِيُّ بْنُ هَاشِمِ بْنِ الْبَرِيدِ ،  نَا  نَاصِحٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَلِيٍّ  :  إِنَّكَ مُؤَمَّرٌ مُسْتَخْلَفٌ ، وَإِنَّكَ مَقْتُولٌ  ، وَهَذِهِ مَخْضُوبَةٌ مِنْ هَذَا "" - لِحْيَتُهُ مِنْ رَأْسِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سِمَاكِ بْنِ حَرْبٍ  إِلَّا  نَاصِحٌ  ، وَلَا عَنْ  نَاصِحٍ  إِلَّا  عَلِيُّ بْنُ هَاشِمٍ  ،  تَفَرَّدَ بِهِ  :  عَبَّادُ بْنُ يَعْقُوبَ  "" .","","Al-Mu'jam al-Awsat 7318","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن علي بن هاشم العائذي عن عباد بن يعقوب الرواجني عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7325","7319  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  نَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِيهِ إِبْرَاهِيمَ  ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَقُولُ :  إِنَّا لِلهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ ، وَيْلٌ لِلْعَرَبِ مِنْ شَرٍّ قَدِ اقْتَرَبَ  ، فُتِحَ مِنْ  رَدْمِ  يَأْجُوجَ  وَمَأْجُوجَ  مِثْلُ هَذِهِ "" ،  وَحَلَّقَ  تِسْعِينَ ، قُلْتُ : يَا رَسُولَ اللهِ ، أَنَهْلِكُ وَفِينَا الصَّالِحُونَ ؟ قَالَ : "" نَعَمْ ، إِذَا كَثُرَ  الْخَبَثُ  "" .  لَمْ يَرْوِ  إِبْرَاهِيمُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  ، عَنْ  أَبِي سَلَمَةَ  حَدِيثًا غَيْرَ هَذَا ،  تَفَرَّدَ بِهِ  :  يَحْيَى بْنُ إِسْحَاقَ  "" .","","Al-Mu'jam al-Awsat 7319","","رملة بنت أبي سفيان زوج رسول الله عن أبو سلمة بن عبد الرحمن عن إبراهيم بن عبد الرحمن بن عوف عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن يحيى بن إسحاق السيلحيني عن محمد بن منصور الطوسي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7326","7320  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  مُحَمَّدُ بْنُ حَرْبٍ النَّشَائِيُّ ،  ثَنَا  عَلِيُّ بْنُ يَزِيدَ الْأَكْفَانِيُّ ،  عَنْ  فُضَيْلِ بْنِ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ         [7/219]      فَلَا يَدْخُلِ الْحَمَّامَ إِلَّا بِمِئْزَرٍ  ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يُدْخِلْ حَلِيلَتَهُ الْحَمَّامَ ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلْيَسْعَ إِلَى الْجُمُعَةِ ، وَمَنِ  اسْتَغْنَى  عَنْهَا  بِلَهْوٍ  وَتِجَارَةٍ  اسْتَغْنَى  اللهُ عَنْهُ ، وَاللهُ غَنِيٌّ حَمِيدٌ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  فُضَيْلِ بْنِ مَرْزُوقٍ  إِلَّا  عَلِيُّ بْنُ يَزِيدَ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ حَرْبٍ  "" .","","Al-Mu'jam al-Awsat 7320","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن علي بن يزيد بن سليم الأكفاني عن محمد بن حرب النشائي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7327","7321  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  نَا  عَبْدُ اللهِ بْنُ خَالِدِ بْنِ يَزِيدَ اللُّؤْلُؤِيُّ ،  ثَنَا  أَبِي  ،  نَا  شَرِيكٌ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  أَبِي الصِّدِّيقِ النَّاجِيِّ وَإِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ نِسَاءَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَأَلْنَهُ عَنِ الذَّيْلِ فَقَالَ : "" اجْعَلْنَهُ شِبْرًا  ، فَقُلْنَ : إِنَّ شِبْرًا لَا يَسْتُرُ مِنْ  عَوْرَةٍ  ، فَقَالَ : "" اجْعَلْنَهُ ذِرَاعًا ، لَا تَزِدْنَ عَلَى ذَلِكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ  إِلَّا  شَرِيكٌ  ، وَلَا عَنْ  شَرِيكٍ  إِلَّا  خَالِدُ بْنُ يَزِيدَ - صَاحِبُ اللُّؤْلُؤِ  - ،  تَفَرَّدَ بِهِ  : ابْنُهُ "" .","","Al-Mu'jam al-Awsat 7321","","عبد الله بن عمر بن الخطاب عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن زيد بن الحواري العمي عن مطرف بن طريف عن شريك بن عبد الله النخعي عن خالد بن يزيد اللؤلؤي عن عبد الله بن خالد بن يزيد اللؤلؤي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7328","7322  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  مُحَمَّدُ بْنُ مَسْعُودِ بْنِ الْعَجَمِيِّ ،  نَا  الْهَيْثَمُ بْنُ جَمِيلٍ ،  نَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنِّي لَأَمْزَحُ ، وَلَا أَقُولُ إِلَّا حَقًّا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْمُبَارَكِ بْنِ فَضَالَةَ  إِلَّا  الْهَيْثَمُ بْنُ جَمِيلٍ  "" .","","Al-Mu'jam al-Awsat 7322","","عبد الله بن عمر بن الخطاب عن بكر بن عبد الله المزني عن مبارك بن فضالة عن الهيثم بن جميل الأنطاكي عن محمد بن مسعود بن يوسف عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7329","7323  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  نَا  عَبْدُ الْوَهَّابِ بْنُ عَبْدِ الْحَكَمِ الْوَرَّاقُ ،  نَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِيَّاكُمْ وَمُحَقَّرَاتِ الذُّنُوبِ ، فَإِنَّمَا مُحَقَّرَاتُ الذُّنُوبِ كَمَثَلِ قَوْمٍ نَزَلُوا بَطْنَ وَادٍ  ، فَجَاءَ ذَا بِعُودٍ ، وَجَاءَ ذَا بِعُودٍ ،         [7/220]      حَتَّى جَمَعُوا مَا أَنْضَجُوا بِهِ خُبْزَهُمْ ، وَإِنَّ مُحَقَّرَاتِ الذُّنُوبِ مَتَى يُؤْخَذْ بِهَا صَاحِبُهَا تُهْلِكْهُ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  سَهْلِ بْنِ سَعْدٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الْوَهَّابِ  "" .","","Al-Mu'jam al-Awsat 7323","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن أنس بن عياض الليثي عن عبد الوهاب بن عبد الحكم الوراق عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7330","7324  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  الْفَضْلُ بْنُ سَهْلٍ الْأَعْرَجُ ،  ثَنَا  إِسْحَاقُ بْنُ مَنْصُورٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ جَلَّ ذِكْرُهُ أَذِنَ لِي أَنْ أُحَدِّثَ عَنْ دِيكٍ قَدْ مَرَقَتْ رِجْلَاهُ الْأَرْضَ  ، وَعُنُقُهُ مُنْثَنٍ تَحْتَ الْعَرْشِ ، وَهُوَ يَقُولُ : سُبْحَانَكَ مَا أَعْظَمَكَ رَبَّنَا ، فَرَدَّ عَلَيْهِ : مَا يَعْلَمُ ذَلِكَ مَنْ حَلَفَ بِي كَاذِبًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ  إِلَّا  إِسْرَائِيلُ  ،  تَفَرَّدَ بِهِ  :  إِسْحَاقُ بْنُ مَنْصُورٍ  "" .","","Al-Mu'jam al-Awsat 7324","","أبو هريرة الدوسي عن سعيد المقبري عن معاوية بن إسحاق بن طلحة التيمي عن إسرائيل بن يونس بن أبي إسحاق عن إسحاق بن منصور السلولي عن الفضل بن سهل الخراساني عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7331","7325  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْأَسْفَاطِيُّ ،  ثَنَا  صَفْوَانُ بْنُ هُبَيْرَةَ ،  نَا  عِيسَى بْنُ الْمُسَيِّبِ الْبَجَلِيُّ الْقَاضِي ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  فُرِغَ إِلَى ابْنِ آدَمَ مِنْ أَرْبَعٍ : مِنَ  الْخَلْقِ  ،  وَالْخُلُقِ  ، وَالرِّزْقِ ، وَالْأَجَلِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ  إِلَّا  عِيسَى بْنُ الْمُسَيِّبِ  ،  تَفَرَّدَ بِهِ  :  صَفْوَانُ بْنُ هُبَيْرَةَ  "" .","","Al-Mu'jam al-Awsat 7325","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن القاسم بن عبد الرحمن المسعودي عن عيسى بن المسيب البجلي عن صفوان بن هبيرة القصير عن محمد بن يزيد بن عبد الملك الأسفاطي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7332","7326  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  ثَنَا  أَحْمَدُ بْنُ خَالِدٍ الْخَلَّالُ ،  نَا  الْحَسَنُ بْنُ بِشْرٍ قَالَ :  وَجَدْتُ فِي كِتَابِ أَبِي  ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي رَوَّادٍ ،  عَنْ  عَطَاءٍ ،         [7/221]      عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ مَشَى فِي حَاجَةِ أَخِيهِ كَانَ خَيْرًا لَهُ مِنِ اعْتِكَافِ عَشْرِ سِنِينَ  ، وَمَنِ اعْتَكَفَ يَوْمًا ابْتِغَاءَ وَجْهِ اللهِ جَعَلَ اللهُ بَيْنَهُ وَبَيْنَ النَّارِ ثَلَاثَ خَنَادِقَ ، كُلُّ خَنْدَقٍ أَبَعْدُ مِمَّا بَيْنَ  الْخَافِقَيْنِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ  إِلَّا  بِشْرُ بْنُ سَلْمٍ الْبَجَلِيُّ  ،  تَفَرَّدَ بِهِ  : ابْنُهُ "" .","","Al-Mu'jam al-Awsat 7326","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد العزيز بن أبي رواد الخراساني عن بشر بن سلم بن المسيب الهمداني عن الحسن بن بشر الكاهلي عن أحمد بن خالد العسكري عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7333","7327  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ يُونُسَ ،  ثَنَا  مَنْصُورُ بْنُ عَمَّارٍ ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  خَرَجَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَدْ عَقَدَ عُقْدَةً بَيْنَ كَتِفَيْهِ ، فَقَالَ لَهُ  أَعْرَابِيٌّ  : مَا هَذِهِ يَا رَسُولَ اللهِ ؟ قَالَ :  وَيْحَكَ يَا أَعْرَابِيُّ ، إِنَّمَا لَبِسْتُهَا لِأَقْمَعَ بِهَا الْكِبْرَ  = .","","Al-Mu'jam al-Awsat 7327","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن منصور بن عمار  الخراساني عن عبد الرحمن بن يونس السراج عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7334","7328  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يُونُسَ قَالَ :  سَمِعْتُ  مَنْصُورَ بْنَ عَمَّارٍ ،  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَزِيدُ ذَا شَرَفٍ عِنْدَهُ وَلَا يَنْقُصُهُ إِلَّا بِالتَّقْوَى  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عُرْوَةَ  إِلَّا  أَبُو الْأَسْوَدِ مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ  ، وَلَا عَنْ  أَبِي الْأَسْوَدِ  إِلَّا  ابْنُ لَهِيعَةَ  ،  تَفَرَّدَ بِهِمَا  :  مَنْصُورُ بْنُ عَمَّارٍ  "" .","","Al-Mu'jam al-Awsat 7328","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن منصور بن عمار  الخراساني عن عبد الرحمن بن يونس السراج عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7335","7329  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ،  نَا  عَلِيُّ بْنُ ثَابِتٍ الدَّهَّانُ ،  ثَنَا  الْحَكَمُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  لَدَغَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَقْرَبٌ وَهُوَ فِي الصَّلَاةِ ، فَقَالَ :  لَعَنَ اللهُ الْعَقْرَبَ ، تَلْدَغُ الْمُصَلِّيَ وَغَيْرَ الْمُصَلِّي ، اقْتُلُوهَا فِي الْحِلِّ وَالْحَرَمِ  .         [7/222]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  الْحَكَمُ بْنُ عَبْدِ الْمَلِكِ  ،  تَفَرَّدَ بِهِ  :  عَلِيُّ بْنُ ثَابِتٍ  "" .","","Al-Mu'jam al-Awsat 7329","","عائشة بنت أبي بكر الصديق عن سعيد بن المسيب عن قتادة بن دعامة عن الحكم بن عبد الملك القرشي عن علي بن ثابت الدهان عن أحمد بن عثمان بن حكيم عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7336","7330  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  ثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ حَنَانٍ ،  ثَنَا  ضَمْرَةُ ،  ثَنَا  عُثْمَانُ بْنُ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  سُلَيْمَانَ ،  عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِأَرْضٍ  لِعَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  فِيهَا زَرْعٌ ، فَقَالَ :  يَا  عَبْدَ الرَّحْمَنِ  ، لَا تَأْكُلِ الرِّبَا وَلَا تُطْعِمْهُ  ، وَلَا تَزْرَعْ إِلَّا فِي أَرْضٍ تَرِثُهَا أَوْ تُوَرِّثُهَا أَوْ تُمْنَحُهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءٍ الْخُرَاسَانِيِّ  إِلَّا ابْنُهُ  عُثْمَانُ  .  وَسُلَيْمَانُ  الَّذِي رَوَى عَنْهُ  عَطَاءٌ  هُوَ  سُلَيْمَانُ بْنُ يَسَارٍ  .","","Al-Mu'jam al-Awsat 7330","","المسور بن مخرمة عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عطاء الخراساني عن عثمان بن عطاء الخراساني عن ضمرة بن ربيعة الفلسطيني عن محمد بن عمرو بن حنان الكلبي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7337","7331  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ يُونُسَ ،  نَا  مُطَرِّفُ بْنُ مَازِنٍ ،  عَنْ  مَعْمَرٍ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  النَّزَّالِ بْنِ سَبْرَةَ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا رَضَاعَ بَعْدَ الْفِطَامِ ، وَلَا يُتْمَ بَعْدَ حُلُمٍ  ، وَلَا صَمْتَ يَوْمٍ إِلَى اللَّيْلِ ، وَلَا طَلَاقَ إِلَّا بَعْدَ نِكَاحٍ "" .  هَكَذَا رَوَى هَذَا الْحَدِيثَ  مُطَرِّفُ بْنُ مَازِنٍ  ، عَنْ  مَعْمَرٍ  ، عَنْ  عَبْدِ الْكَرِيمِ -وَهُوَ ابْنُ أَبِي الْمُخَارِقِ  .  وَرَوَاهُ  عَبْدُ الرَّزَّاقِ  ، عَنْ  مَعْمَرٍ  ، عَنْ  جُوَيْبِرٍ  ، عَنِ  الضَّحَّاكِ  .","","Al-Mu'jam al-Awsat 7331","","علي بن أبي طالب عن النزال بن سبرة الهلالي عن الضحاك بن مزاحم الهلالي عن عبد الكريم الاصطخري عن معمر بن راشد عن مطرف بن مازن الكناني عن عبد الرحمن بن يونس السراج عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7338","7332  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ ،  نَا  الْفَضْلُ بْنُ يَعْقُوبَ ،  نَا  الْهَيْثَمُ بْنُ جَمِيلٍ ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  عَاصِمٍ ،  حَسِبْتُهُ  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  كُنَّا نُعَلَّمُ  الِاسْتِخَارَةَ  كَمَا نُعَلَّمُ السُّورَةَ مِنَ الْقُرْآنِ : إِذَا أَرَادَ الرَّجُلُ أَمْرًا أَنْ يَقُولَ :  اللَّهُمَّ إِنِّي أَسْتَخِيرُكَ بِعِلْمِكَ ،  وَأَسْتَقْدِرُكَ  بِقُدْرَتِكَ  ،         [7/223]      وَأَسْأَلُكَ مِنْ فَضْلِكَ الْوَاسِعِ ، فَإِنَّكَ تَقْدِرُ وَلَا أَقْدِرُ ، وَتَعْلَمُ وَلَا أَعْلَمُ ، وَأَنْتَ عَلَّامُ الْغُيُوبِ ، اللَّهُمَّ إِنْ كَانَ هَذَا الْأَمْرُ الَّذِي أُرِيدُهُ - وَيُسَمِّيهِ - خَيْرًا لِي فِي أَمْرِ دِينِي ، وَخَيْرًا لِي فِي أَمْرِ دُنْيَايَ ، وَخَيْرًا لِي فِي أَمْرِ آخِرَتِي ، وَخَيْرًا لِي فِي عَاقِبَةِ أَمْرِي فَيَسِّرْهُ لِي ، وَبَارِكْ لِي فِيهِ ، وَإِنْ كَانَ شَرًّا لِي فِي أَمْرِ دِينِي ، وَشَرًّا لِي فِي أَمْرِ دُنْيَايَ ، وَشَرًّا لِي فِي عَاقِبَةِ أَمْرِي فَاصْرِفْهُ عَنِّي ، وَيَسِّرْ لِيَ الْخَيْرَ ، وَاقْضِ لِي بِهِ ، ثُمَّ رَضِّنِي بِقَضَائِكَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُبَارَكِ بْنِ فَضَالَةَ  إِلَّا  الْهَيْثَمُ بْنُ جَمِيلٍ  ،  تَفَرَّدَ بِهِ  :  الْفَضْلُ بْنُ يَعْقُوبَ  "" .","","Al-Mu'jam al-Awsat 7332","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن مبارك بن فضالة عن الهيثم بن جميل الأنطاكي عن الفضل بن يعقوب الرخامي عن محمد بن العباس ابن الأخرم عن الطبراني","محمد بن العباس الأخرم"
"7339","7333  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  نَا  أَبُو عَوَانَةَ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  دَخَلَ  أَبُو بَكْرٍ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : كَيْفَ أَصْبَحْتَ يَا رَسُولَ اللهِ ؟ قَالَ :  صَالِحًا بِخَيْرٍ مِنْ رَجُلٍ لَمْ يُصْبِحْ صَائِمًا ، وَلَمْ يَعُدْ مَرِيضًا ، وَلَمْ يَتْبَعْ جِنَازَةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ  إِلَّا  أَبُو عَوَانَةَ  ،  تَفَرَّدَ بِهِ  :  أَبُو دَاوُدَ  "" .","","Al-Mu'jam al-Awsat 7333","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عمر بن أبي سلمة الزهري عن الوضاح بن عبد الله اليشكري عن أبو داود الطيالسي عن الفلاس عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7340","7334  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عِيسَى الدَّامَغَانِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  كُرَيْبٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  يَرْفَعُ الْحَدِيثَ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ مِمَّا خَلَقَ اللهُ لَدِيكًا بَرَاثِنُهُ عَلَى الْأَرْضِ السَّابِعَةِ  ، وَعُرْفُهُ مُنْطَوٍ تَحْتَ الْعَرْشِ ، قَدْ أَحَاطَ جَنَاحَاهُ بِالْأُفُقَيْنِ ، وَإِذَا بَقِيَ ثُلُثُ اللَّيْلِ الْآخِرُ ضَرَبَ بِجَنَاحَيْهِ ، ثُمَّ قَالَ : سَبِّحُوا الْمَلِكَ الْقُدُّوسَ ، سُبْحَانَ رَبِّنَا الْمَلِكِ الْقُدُّوسِ ، لَا إِلَهَ لَنَا غَيْرُهُ "" . قَالَ : "" فَيَسْمَعُهَا مَا بَيْنَ  الْخَافِقَيْنِ  إِلَّا  الثَّقَلَيْنِ  "" قَالَ : "" فَيُرَوْنَ أَنَّ الدِّيَكَةَ إِنَّمَا تَضْرِبُ بِأَجْنِحَتِهَا ، تَصْرُخُ إِذَا سَمِعَتْ ذَلِكَ  .         [7/224]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَنْصُورٍ  إِلَّا  مُحَمَّدُ بْنُ إِسْحَاقَ  ، وَلَا عَنِ  ابْنِ إِسْحَاقَ  إِلَّا  سَلَمَةُ بْنُ الْفَضْلِ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ عِيسَى  "" .","","Al-Mu'jam al-Awsat 7334","","عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن سالم بن أبي الجعد الغطفاني عن منصور بن المعتمر عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن محمد بن عيسى الدامغاني عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7341","7335  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الدَّامَغَانِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مِيكَائِيلَ ،  عَنْ  لَيْثٍ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي ذَرٍّ  قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ  آدَمَ  أَنَبِيًّا كَانَ ؟ قَالَ :  نَعَمْ ، كَانَ نَبِيًّا رَسُولًا ، كَلَّمَهُ اللهُ  قِبَلَهُ  ، قَالَ لَهُ :         {      يَا آدَمُ اسْكُنْ أَنْتَ وَزَوْجُكَ الْجَنَّةَ         }      .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ  إِلَّا  لَيْثٌ  ، وَلَا عَنْ  لَيْثٍ  إِلَّا  مِيكَائِيلُ - شَيْخٌ كُوفِيٌّ  - ، وَلَا عَنْ  مِيكَائِيلَ  إِلَّا  سَلَمَةُ بْنُ الْفَضْلِ  "" .","","Al-Mu'jam al-Awsat 7335","","أبو ذر الغفاري عن يزيد بن شريك بن طارق التيمي عن إبراهيم بن يزيد بن شريك التيمي عن ليث بن أبي سليم عن ميكائيل عن سلمة بن الفضل الأبرش عن محمد بن عيسى الدامغاني عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7342","7336  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  زَيْدُ بْنُ أَخْزَمَ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْهَدَادِيُّ  ،  نَا  حُمَيْدُ بْنُ مِهْرَانَ ،  عَنْ  أَبِي الزِّبْرِقَانِ الْهِلَالِيِّ ،  عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَرَأَ :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      فَكَأَنَّمَا قَرَأَ  ثُلُثَ  الْقُرْآنِ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  بُرَيْدِ بْنِ أَبِي مَرْيَمَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  زَيْدُ بْنُ أَخْزَمَ  "" .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( محمد بن عباد الهنائي ) كما في مسند البزار ، والله أعلم","","Al-Mu'jam al-Awsat 7336","","أنس بن مالك عن بريد بن أبي مريم السلولي عن أبو الزبرقان الهلالي عن حميد بن أبي حميد الخياط عن محمد بن عباد الهنائي عن زيد بن أخزم الطائي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7343","7337  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  زَيْدُ بْنُ أَخْزَمَ ،  نَا  بِشْرُ بْنُ عُمَرَ الزَّهْرَانِيُّ ،  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  النُّعْمَانِ بْنِ مُرَّةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْأَنْصَارُ  تَرِكَتِي وَضَيْعَتِي ، فَاقْبَلُوا         [7/225]      مِنْ مُحْسِنِهِمْ وَتَجَاوَزُوا عَنْ مُسِيئِهِمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ سَعِيدٍ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  ، وَلَا عَنْ  حَمَّادٍ  إِلَّا  بِشْرُ بْنُ عُمَرَ  ،  تَفَرَّدَ بِهِ  :  زَيْدُ بْنُ أَخْزَمَ  "" .","","Al-Mu'jam al-Awsat 7337","","أنس بن مالك عن النعمان بن مرة الزرقي عن يحيى بن سعيد الأنصاري عن حماد بن سلمة عن بشر بن عمر الزهراني عن زيد بن أخزم الطائي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7344","7338  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  أَحْمَدُ بْنُ مَنْصُورٍ الْمَرْوَزِيُّ ،  نَا  يَحْيَى بْنُ نَصْرِ بْنِ حَاجِبٍ ،  عَنْ  وَرْقَاءَ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي أَرَى رُؤْيَاكُمْ قَدْ تَوَاطَأَتْ عَلَى الْعَشْرِ الْأَوَاخِرِ  ، فَالْتَمِسُوهَا فِي الْعَشْرِ الْأَوَاخِرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَيُّوبَ بْنِ مُوسَى  إِلَّا  وَرْقَاءُ  ، وَلَا عَنْ  وَرْقَاءَ  إِلَّا  يَحْيَى بْنُ نَصْرٍ  ،  تَفَرَّدَ بِهِ  :  أَحْمَدُ بْنُ مَنْصُورٍ  "" .","","Al-Mu'jam al-Awsat 7338","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن أيوب السختياني عن ورقاء بن عمر عن يحيى بن نصر المروزي عن زاج ، أحمد بن منصور الحنظلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7345","7339  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  أَبُو مَحْذُورَةَ مُحَمَّدُ بْنُ عُبَيْدِ اللهِ ،  نَا  الْحُسَيْنُ بْنُ الْحَسَنِ الْأَشْقَرُ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْسِمُ غَنَائِمَ  حُنَيْنٍ  وَجِبْرِيلُ  إِلَى جَنْبِهِ  ، فَجَاءَ مَلَكٌ فَقَالَ : إِنَّ رَبَّكَ يَأْمُرُكَ بِكَذَا وَكَذَا ، فَخَشِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَكُونَ شَيْطَانًا ، فَقَالَ  لِجِبْرِيلَ  : "" أَتَعْرِفُهُ ؟ "" قَالَ : هُوَ مَلَكٌ ، وَمَا كُلُّ مَلَائِكَةِ رَبِّكَ أَعْرِفُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  دَاوُدَ  إِلَّا  هُشَيْمٌ  ،  تَفَرَّدَ بِهِ  :  حُسَيْنٌ الْأَشْقَرُ  "" .","","Al-Mu'jam al-Awsat 7339","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن داود بن أبي هند عن هشيم بن بشير عن الحسين بن الحسن الأشقر عن أبو محذورة محمد بن عبيد الله عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7346","7340  -  =  وَبِهِ  :  حَدَّثَنَا  حُسَيْنٌ الْأَشْقَرُ ،  نَا  شَرِيكٌ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَهْلَ الدَّرَجَاتِ الْعُلَى لَيَرَوْنَ مَنْ هُوَ أَسْفَلَ مِنْهُمْ كَمَا  تَرَوْنَ  الْكَوْكَبَ  الدُّرِّيَّ  فِي أُفُقِ السَّمَاءِ  ، وَإِنَّ  أَبَا بَكْرٍ  وَعُمَرَ  مِنْهُمْ  وَأَنْعَمَا  "" .         [7/226]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ  إِلَّا  شَرِيكٌ  ،  تَفَرَّدَ بِهِ  :  حُسَيْنٌ الْأَشْقَرُ  "" .","","Al-Mu'jam al-Awsat 7340","","أبو سعيد الخدري عن عطية بن سعد العوفي عن إبراهيم بن مهاجر بن جابر البجلي عن شريك بن عبد الله النخعي عن الحسين بن الحسن الأشقر عن أبو محذورة محمد بن عبيد الله عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7347","7341  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  أَحْمَدُ بْنُ مَنْصُورٍ الْمَرْوَزِيُّ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ قَيْسٍ الضَّبِّيُّ ،  نَا  هِلَالُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  ذَاكِرُ اللهِ فِي رَمَضَانَ مَغْفُورٌ لَهُ  ، وَسَائِلُ اللهِ فِيهِ لَا يَخِيبُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  إِلَّا  عَلِيُّ بْنُ زَيْدٍ  ، وَلَا عَنْ  عَلِيٍّ  إِلَّا  هِلَالُ بْنُ عَبْدِ الرَّحْمَنِ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الرَّحْمَنِ بْنُ قَيْسٍ  "" .","","Al-Mu'jam al-Awsat 7341","","عمر بن الخطاب عن سعيد بن المسيب عن علي بن زيد بن جدعان عن هلال بن عبد الرحمن الحنفي عن عبد الرحمن بن قيس الزعفراني عن زاج ، أحمد بن منصور الحنظلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7348","7342  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  عَبْدُ اللهِ بْنُ إِسْحَاقَ الْجَوْهَرِيُّ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ الْعُمَرِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي حَبِيبَةَ ،  عَنْ  مُسْلِمِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْمِنْبَرِ وَالنَّاسُ حَوْلَهُ - :  أَيُّهَا النَّاسُ ، اسْتَحْيُوا مِنَ اللهِ حَقَّ الْحَيَاءِ  فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، إِنَّا لَنَسْتَحْيِي مِنَ اللهِ ، فَقَالَ : "" مَنْ كَانَ مِنْكُمْ مُسْتَحْيِيًا فَلَا يَبِيتَنَّ لَيْلَةً إِلَّا وَأَجَلُهُ بَيْنَ عَيْنَيْهِ ، وَلْيَحْفَظِ الْبَطْنَ وَمَا  وَعَى  وَالرَّأْسَ وَمَا حَوَى ، وَلْيَذْكُرِ الْقُبُورَ وَالْبِلَى ، وَلْيَتْرُكْ زِينَةَ الْحَيَاةِ الدُّنْيَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُرْوَةَ  إِلَّا  مُسْلِمُ بْنُ أَبِي مَرْيَمَ  ، وَلَا عَنْ  مُسْلِمٍ  إِلَّا  ابْنُ أَبِي حَبِيبَةَ  ،  تَفَرَّدَ بِهِ  :  خَالِدُ بْنُ يَزِيدَ  ، وَلَا يُرْوَى عَنْ  عَائِشَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7342","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن مسلم بن أبي مريم الأنصاري عن إبراهيم بن إسماعيل الأنصاري عن خالد بن يزيد الحذاء عن عبد الله بن إسحاق الجوهري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7349","7343  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ الْوَضَّاحِ الْهَاشِمِيُّ ،  نَا  رَوْحُ بْنُ عُبَادَةَ ،  نَا  أَبُو عَامِرٍ الْخَزَّازُ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  ثَنَا  نَصْرُ بْنُ عَاصِمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ قُرْطٍ قَالَ :  مَرَرْتُ  بِالْكُوفَةِ  ، فَدَخَلْتُ         [7/227]      الْمَسْجِدَ ، فَإِذَا أَنَا بِقَوْمٍ جُلُوسٍ كَأَنَّمَا قُطِعَتْ رُءُوسُهُمْ ، فَجَلَسْتُ فِي أَدْنَى  الْقَوْمِ  ، فَقُلْتُ  لِرَجُلٍ  : يَا عَبْدَ اللهِ ، مَنْ هَذَا الرَّجُلُ ؟ فَقَالَ : كَأَنَّكَ غَرِيبٌ ، قُلْتُ : نَعَمْ ، قَالَ : أَمَا إِنَّكَ لَوْ كُنْتَ مِنْ أَهْلِهَا لَعَرَفْتَهُ ، هَذَا حُذَيْفَةُ بْنُ الْيَمَانِ .  فَأَنْشَأَ يُحَدِّثُ  الْقَوْمَ  ، فَقَالَ : إِنَّ النَّاسَ كَانُوا يَسْأَلُونَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْخَيْرِ ، وَأَسْأَلُهُ أَنَا عَنِ الشَّرِّ ، حَتَّى أَتَّقِيَهُ ، وَأَعْلَمَ أَنَّ الْخَيْرَ لَنْ يَفُوتَنِي ، قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، هَلْ بَعْدَ هَذَا الْخَيْرِ الَّذِي يَجِيءُ فِيهِ مِنْ شَرٍّ ؟ قَالَ :  يَا  حُذَيْفَةُ  ، تَعَلَّمْ كِتَابَ اللهِ وَاعْمَلْ بِمَا فِيهِ  ، ثُمَّ قَالَ : "" نَعَمْ ، فِتْنَةٌ وَاخْتِلَافٌ "" فَقُلْتُ : أَفَيَكُونُ بَعْدَ ذَلِكَ مِنْ خَيْرٍ ؟ قَالَ : "" نَعَمْ ، جَمَاعَةٌ عَلَى  أَقْذَاءٍ  ،  وَهُدْنَةٌ  عَلَى  دَخَنٍ  "" قُلْتُ : يَا رَسُولَ اللهِ ، أَبَعْدَ ذَلِكَ الْخَيْرِ مِنْ شَرٍّ ؟ قَالَ : "" يَا  حُذَيْفَةُ  ، تَعَلَّمْ كِتَابَ اللهِ وَاعْمَلْ بِمَا فِيهِ "" ، حَتَّى سَأَلْتُهُ أَيْضًا ثَلَاثَ مِرَارٍ ، يَقُولُ مِثْلَ ذَلِكَ ، ثُمَّ قَالَ : "" نَعَمْ ، يَكُونُ فِتْنَةٌ ، عَلَى أَبْوَابِهَا دُعَاةٌ إِلَى النَّارِ ، فَأَنْ تَمُوتَ حِينَ تَمُوتُ وَأَنْتَ عَاضٌّ عَلَى  جِذْلٍ  ، خَيْرٌ مِنْ أَنْ تَتَّبِعَ أَحَدَهُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي عَامِرٍ الْخَزَّازِ  إِلَّا  رَوْحُ بْنُ عُبَادَةَ  "" .","","Al-Mu'jam al-Awsat 7343","","حذيفة بن اليمان عن عبد الرحمن بن قرط عن نصر بن عاصم الليثي عن حميد بن هلال العدوي عن صالح بن رستم الخزاز عن روح بن عبادة القيسي عن محمد بن الوضاح الهاشمي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7350","7344  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عَقِيلٍ الْمُقْرِئُ ،  نَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  نَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  أَشْعَثَ بْنِ جَابِرٍ الْحُدَّانِيِّ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ تَابَ قَبْلَ طُلُوعِ الشَّمْسِ مِنْ مَغْرِبِهَا  تَابَ اللهُ عَلَيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَشْعَثَ  إِلَّا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ  ، وَلَا عَنِ  الْحَسَنِ  إِلَّا  مُسْلِمُ بْنُ إِبْرَاهِيمَ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عَقِيلٍ  "" .","","Al-Mu'jam al-Awsat 7344","","أبو هريرة الدوسي عن محمد بن سيرين عن أشعث بن عبد الله بن جابر الحداني عن الحسن بن أبي جعفر الجفري عن مسلم بن إبراهيم الشحام عن محمد بن عبد الله بن عبيد بن عقيل الهلالي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7351","7345  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  رَوْحُ بْنُ حَاتِمٍ أَبُو غَسَّانَ الْجُذُوعِيُّ ،  نَا  عَمْرُو بْنُ عَاصِمٍ الْكِلَابِيُّ ،  نَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنِ  الْوَلِيدِ بْنِ مَرْوَانَ ،  عَنْ  غَيْلَانَ         [7/228]      بْنِ جَرِيرٍ ،  عَنْ  أَبِي بُرْدَةَ ،  عَنْ  أَبِي مُوسَى  قَالَ :  كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، مِنَّا الصَّائِمُ وَمِنَّا الْمُفْطِرُ  ، فَلَمْ يَعِبِ الصَّائِمُ عَلَى الْمُفْطِرِ ، وَلَا الْمُفْطِرُ عَلَى الصَّائِمِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  غَيْلَانَ بْنِ جَرِيرٍ  إِلَّا  الْوَلِيدُ بْنُ مَرْوَانَ  ، وَلَا عَنِ  الْوَلِيدِ  إِلَّا  مُعْتَمِرٌ  ،  تَفَرَّدَ بِهِ  :  عَمْرُو بْنُ عَاصِمٍ  "" .","","Al-Mu'jam al-Awsat 7345","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن غيلان بن جرير المعولي عن الوليد بن مروان ابن أخي جنادة بن مروان عن معتمر بن سليمان عن عمرو بن عاصم الكلابي عن روح بن حاتم البصري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7352","7346  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ اللَّيْثِ أَبُو الصَّبَّاحِ الْهَدَادِيُّ ،  ثَنَا  بَكْرُ بْنُ يَحْيَى بْنِ زَبَّانَ ،  نَا  مِنْدَلُ بْنُ عَلِيٍّ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ مَرَّةً مَرَّةً  ، ثُمَّ قَامَ فَصَلَّى  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي نَجِيحٍ  إِلَّا  مِنْدَلٌ  ،  تَفَرَّدَ بِهِ  :  بَكْرُ بْنُ يَحْيَى  "" .","","Al-Mu'jam al-Awsat 7346","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن مندل بن علي عن بكر بن يحيى العنزي عن محمد بن الليث السرخسي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7353","7347  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  سَوَّارُ بْنُ سَهْلٍ أَبُو سَهْلٍ الْمَخْزُومِيُّ ،  نَا  سَعِيدُ بْنُ عَامِرٍ الضُّبَعِيُّ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا وَضَعْتُمْ مَوْتَاكُمْ فِي الْقُبُورِ فَقُولُوا : بِسْمِ اللهِ  وَعَلَى مِلَّةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَيُّوبَ  إِلَّا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ  ، وَلَا عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ  إِلَّا  سَعِيدُ بْنُ عَامِرٍ  ، وَلَا عَنْ  سَعِيدٍ  إِلَّا  سَوَّارُ بْنُ سَهْلٍ  "" .","","Al-Mu'jam al-Awsat 7347","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن سعيد بن أبي عروبة عن سعيد بن عامر الضبعي عن سوار بن سهل البصري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7354","7348  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ سُمَيْعٍ أَبُو هَمَّامٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ ،  نَا  عِمْرَانُ أَبُو الْعَوَّامِ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَمَرَ مُنَادِيًا فَنَادَى فِي لَيْلَةٍ مَطِيرَةٍ  ، أَنْ صَلُّوا فِي رِحَالِكُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عِمْرَانَ  إِلَّا  أَبُو عَلِيٍّ الْحَنَفِيُّ عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ  ،         [7/229]      تَفَرَّدَ بِهِ  :  عَبْدُ السَّلَامِ  "" .","","Al-Mu'jam al-Awsat 7348","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن عمران بن داور القطان عن عبيد الله بن عبد المجيد الحنفي عن عبد السلام بن سميع البصري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7355","7349  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ سُمَيْعٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  قَضَى بِالْيَمِينِ مَعَ الشَّاهِدِ الْوَاحِدِ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ  إِلَّا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ السَّلَامِ  "" .","","Al-Mu'jam al-Awsat 7349","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن عبد الله بن عمر العمري عن عبيد الله بن عبد المجيد الحنفي عن عبد السلام بن سميع البصري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7356","7350  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  الْقَاسِمُ بْنُ مُحَمَّدِ بْنِ عَبَّادٍ الْمُهَلَّبِيُّ ،  ثَنَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  النَّدَمُ تَوْبَةٌ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو عَاصِمٍ  ،  تَفَرَّدَ بِهِ  :  الْقَاسِمُ بْنُ مُحَمَّدِ بْنِ عَبَّادٍ  "" .","","Al-Mu'jam al-Awsat 7350","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن أبو عاصم النبيل عن القاسم بن محمد بن عباد المهلبي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7357","7351  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  سَلَمَةُ بْنُ شَبِيبٍ ،  نَا  عَبْدُ اللهِ بْنُ إِبْرَاهِيمَ الْغِفَارِيُّ ،  نَا  حُرُّ بْنُ عَبْدِ اللهِ الْحَذَّاءُ ،  عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَحَبَّ الدِّينِ إِلَى اللهِ الْحَنِيفِيَّةُ السَّمْحَةُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ  إِلَّا  حُرُّ بْنُ عَبْدِ اللهِ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ اللهِ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7351","","أبو هريرة الدوسي عن عطاء بن يسار الهلالي عن صفوان بن سليم القرشي عن حر بن عبد الله الحذاء عن عبد الله بن إبراهيم بن أبي عمرو الغفاري عن سلمة بن شبيب المسمعي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7358","7352  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  الْقَاسِمُ بْنُ مُحَمَّدِ بْنِ عَبَّادٍ الْمُهَلَّبِيُّ ،  ثَنَا         [7/230]      أَبُو عَاصِمٍ ،  نَا  مَنْصُورُ بْنُ دِينَارٍ ،  أَخْبَرَنِي  عَطَاءٌ ،  أَخْبَرَنِي  جَابِرُ بْنُ عَبْدِ اللهِ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ التَّمْرِ وَالْبُسْرِ  ، وَالزَّبِيبِ وَالتَّمْرِ ، أَنْ يُنْبَذَا جَمِيعًا  .","","Al-Mu'jam al-Awsat 7352","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن منصور بن دينار التميمي عن أبو عاصم النبيل عن القاسم بن محمد بن عباد المهلبي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7359","7353  - =  وَبِهِ  :  حَدَّثَنَا  مَنْصُورُ بْنُ دِينَارٍ ،  أَخْبَرَنِي  يَزِيدُ بْنُ أَبِي زِيَادٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَطَافَ  بِالْبَيْتِ  عَلَى رَاحِلَتِهِ ، وَجَعَلَ يَسْتَلِمُ  الرُّكْنَ  بِمِحْجَنِهِ  ، ثُمَّ قَالَ : "" يَا  عَبَّاسُ  ، هَلْ ثَمَّ شَرَابٌ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" مِمَّا خَاضَتْهُ الْحَجِيجُ بِأَيْدِيهَا ، أَوْ مِمَّا فِي  الْبَيْتِ  ؟ "" قَالَ : مِمَّا خَاضَتْهُ الْحَجِيجُ بِأَيْدِيهَا ، فَأَتَى  بِعُسٍّ  فَرَفَعَهُ إِلَى وَجْهِهِ ، فَكَرِهَهُ ، ثُمَّ أَعْرَضَ ، ثُمَّ قَالَ : "" إِنَّ لِزَبِيبِ  الطَّائِفِ  لَعُرَامًا "" ، ثُمَّ قَالَ :  ادْعُ لِيَ بِشَوْلٍ مِنْ مَاءٍ  ، فَأُتِيَ بِشَوْلٍ مِنْ مَاءٍ ،  فَشَنَّهُ  عَلَيْهِ ، ثُمَّ شَرِبَ وَسَقَى أَصْحَابَهُ  .","","Al-Mu'jam al-Awsat 7353","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يزيد بن أبي زياد القرشي عن منصور بن دينار التميمي عن أبو عاصم النبيل عن القاسم بن محمد بن عباد المهلبي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7360","7354  - =  وَبِهِ  :  حَدَّثَنَا  مَنْصُورُ بْنُ دِينَارٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ قَالَ : قُلْتُ لِجَابِرِ بْنِ عَبْدِ اللهِ :  هَلْ كُنْتُمْ تَقُولُونَ لِأَحَدٍ مِنْ أَهْلِ الْقِبْلَةِ : كَافِرٌ  ؟ قَالَ : "" لَا "" ، قُلْتُ : فَكُنْتُمْ تَقُولُونَ : مُشْرِكٌ ؟  قَالَ  : "" مَعَاذَ اللهِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَنْصُورِ بْنِ دِينَارٍ  إِلَّا  أَبُو عَاصِمٍ  "" .","","Al-Mu'jam al-Awsat 7354","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن منصور بن دينار التميمي عن أبو عاصم النبيل عن القاسم بن محمد بن عباد المهلبي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7361","7355  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  عَمَّارُ بْنُ خَالِدٍ الْوَاسِطِيُّ ،  ثَنَا  عَلِيُّ بْنُ غُرَابٍ ،  عَنْ  صَالِحِ بْنِ أَبِي الْأَخْضَرِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ بْنِ السَّبَّاقِ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ هَذَا يَوْمُ عِيدٍ ، جَعَلَهُ اللهُ لِلْمُسْلِمِينَ  ، فَمَنْ جَاءَ الْجُمُعَةَ فَلْيَغْتَسِلْ ، وَإِنْ كَانَ لَهُ طِيبٌ فَلْيَمَسَّ         [7/231]      مِنْهُ ، وَعَلَيْكُمْ بِالسِّوَاكِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  ، عَنْ  عُبَيْدِ بْنِ السَّبَّاقِ  إِلَّا  صَالِحُ بْنُ أَبِي الْأَخْضَرِ  ، وَلَا عَنْ  صَالِحٍ  إِلَّا  عَلِيُّ بْنُ غُرَابٍ  ،  تَفَرَّدَ بِهِ  :  عَمَّارُ بْنُ خَالِدٍ  .  "" وَرَوَاهُ  مُعَاوِيَةُ بْنُ يَحْيَى  ، عَنِ  الزُّهْرِيِّ  ، عَنْ  عَطَاءِ بْنِ يَزِيدَ  ، عَنْ  أَبِي أَيُّوبَ  ، وَرَوَاهُ  ابْنُ لَهِيعَةَ  ، عَنْ  عُقَيْلٍ  ، عَنِ  الزُّهْرِيِّ  ، عَنْ  أَنَسِ بْنِ مَالِكٍ  .","","Al-Mu'jam al-Awsat 7355","","عبد الله بن عباس عن عبيد بن السباق  العبدري عن الزهري عن صالح بن أبي الأخضر اليمامي عن علي بن عبد العزيز الفزاري عن عمار بن خالد بن يزيد التمار عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7362","7356  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  عَمَّارُ بْنُ خَالِدٍ ،  نَا  أَبُو صَيْفِيٍّ قَالَ :  سَمِعْتُ  مُجَاهِدًا أَبَا الْحَجَّاجِ ،  يُحَدِّثُ ، عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ رَجُلًا أُدْخِلَ الْجَنَّةَ فَرَأَى عَبْدَهُ فَوْقَ دَرَجَتِهِ  ، فَقَالَ : يَا رَبِّ ، هَذَا عَبْدِي فَوْقَ دَرَجَتِي فِي الْجَنَّةِ ؟ فَقَالَ لَهُ : نَعَمْ ، جَزَيْتُهُ بِعَمَلِهِ وَجَزَيْتُكَ بِعَمَلِكَ  = .","","Al-Mu'jam al-Awsat 7356","","أبو هريرة الدوسي عن مجاهد بن جبر المخزومي عن بشير بن ميمون الواسطي عن عمار بن خالد بن يزيد التمار عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7363","7357  -  =  وَبِهِ  :  سَمِعْتُ  مُجَاهِدًا أَبَا الْحَجَّاجِ ،  يُحَدِّثُ ، عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَوَّلَ سَائِقٍ إِلَى الْجَنَّةِ مَمْلُوكٌ  ، أَطَاعَ اللهَ ، وَأَطَاعَ  مَوَالِيَهُ "" أَوْ "" سَيِّدَهُ  = .","","Al-Mu'jam al-Awsat 7357","","أبو هريرة الدوسي عن مجاهد بن جبر المخزومي عن بشير بن ميمون الواسطي عن عمار بن خالد بن يزيد التمار عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7364","7358  - =  وَبِهِ  :  سَمِعْتُ  مُجَاهِدًا ،  يُحَدِّثُ ، عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ صَدَقَةٍ أَفْضَلُ مِنْ صَدَقَةٍ تُصُدِّقَ بِهَا عَلَى مَمْلُوكٍ  عِنْدَ مَلِيكِ سَوْءٍ  لَمْ يَرْوِ هَذَهِ الْأَحَادِيثَ عَنْ  مُجَاهِدٍ  إِلَّا  أَبُو صَيْفِيٍّ  "" .","","Al-Mu'jam al-Awsat 7358","","أبو هريرة الدوسي عن مجاهد بن جبر المخزومي عن بشير بن ميمون الواسطي عن عمار بن خالد بن يزيد التمار عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7365","7359  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  أَحْمَدُ بْنُ سِنَانٍ الْوَاسِطِيُّ ،  نَا  مُحَمَّدُ بْنُ حَمَّادٍ الْوَاسِطِيُّ ،  ثَنَا  عُمَرُ أَبُو حَفْصٍ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تُرْكَزُ لَهُ  عَنَزَةٌ  فَيُصَلِّي         [7/232]      إِلَيْهَا  - أَظُنُّهُ قَالَ : وَالظُّعُنُ تَمُرُّ بَيْنَ يَدَيْهِ  = .","","Al-Mu'jam al-Awsat 7359","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن عمر أبو حفص عن محمد بن حماد الواسطي عن أحمد بن سنان القطان عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7366","7360  - =  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  أَحْمَدُ بْنُ سِنَانٍ ،  ثَنَا  مُحَمَّدُ بْنُ حَمَّادٍ ،  نَا  عُمَرُ أَبُو حَفْصٍ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي دُعَائِهِ :  اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ  ، وَعَافِنِي فِيمَنْ عَافَيْتَ ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ ، وَقِنِي شَرَّ مَا قَضَيْتَ ، فَإِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ ، وَإِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ ، تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ "" .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عَلْقَمَةَ  إِلَّا  عُمَرُ أَبُو حَفْصٍ  "" .","","Al-Mu'jam al-Awsat 7360","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن عمر بن سليط الهذلي عن محمد بن حماد الطهراني عن أحمد بن سنان القطان عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7367","7361  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  أَحْمَدُ بْنُ سِنَانٍ ،  نَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عَبْدِ الْأَعْلَى بْنِ أُمَيَّةَ بْنِ وَهْبٍ  ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبَانَ بْنِ عُثْمَانَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَنْكِحُ الْمُحْرِمُ ، وَلَا يَخْطُبُ  ، وَلَا يُخْطَبُ عَلَيْهِ  .  ""  لَمْ يَرْوِهِ عَنْ  عَبْدِ الْأَعْلَى  إِلَّا  عَبْدُ الْعَزِيزِ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ  "" .  كذا في طبعة دار الحرمين ، ومجمع البحرين ، والصواب : ( عبد الأعلى بن نبيه بن وهب )","","Al-Mu'jam al-Awsat 7361","","عثمان بن عفان عن أبان بن عثمان بن عفان عن نبيه بن وهب بن عثمان العبدري عن عبد الأعلى بن نبيه عن عبد العزيز بن محمد الدراوردي عن يعقوب بن محمد بن عيسى عن أحمد بن سنان القطان عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7368","7362  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  أَحْمَدُ بْنُ سِنَانٍ ،  نَا  عَلِيُّ بْنُ عَاصِمٍ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عَبِيدَةَ السَّلْمَانِيِّ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ قَالَ :  شَغَلَنَا  الْأَحْزَابُ  يَوْمَ الْخَنْدَقِ  عَنْ صَلَاةِ الْعَصْرِ ، فَقَالَ :  مَا لَهُمْ ؟ مَلَأَ اللهُ قُبُورَهُمْ وَبُيُوتَهُمْ نَارًا  ، شَغَلُونَا عَنِ الصَّلَاةِ الْوُسْطَى حَتَّى غَرَبَتِ الشَّمْسُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خَالِدٍ الْحَذَّاءِ  إِلَّا  عَلِيُّ بْنُ عَاصِمٍ  "" .","","Al-Mu'jam al-Awsat 7362","","علي بن أبي طالب عن عبيدة بن عمرو السلماني عن محمد بن سيرين عن خالد الحذاء عن علي بن عاصم بن صهيب عن أحمد بن سنان القطان عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7369","7363  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  أَحْمَدُ بْنُ سِنَانٍ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،         [7/233]      نَا  سَلِيمُ بْنُ حَيَّانَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  نَا  جَابِرُ بْنُ عَبْدِ اللهِ ،  أَنَّ  مُعَاذَ بْنَ جَبَلٍ  كَانَ يُصَلِّي مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ يَأْتِي قَوْمَهُ فَيُصَلِّي بِهِمْ ، فَصَلَّى بِهِمْ صَلَاةً فَقَرَأَ بِهِمُ الْبَقَرَةَ ، فَتَجَوَّزَ  رَجُلٌ  فَصَلَّى صَلَاةً خَفِيفَةً ، فَبَلَغَ ذَلِكَ  مُعَاذًا  ، فَقَالَ : إِنَّهُ مُنَافِقٌ ، فَبَلَغَ ذَلِكَ الرَّجُلَ ، فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّا قَوْمٌ نَعْمَلُ بِأَيْدِينَا وَنَسْتَقِي  بِنَوَاضِحِنَا  ، وَإِنَّ  مُعَاذًا  صَلَّى بِنَا الْبَارِحَةَ فَقَرَأَ الْبَقَرَةَ ، فَتَجَوَّزْتُ ، فَزَعَمَ أَنِّي مُنَافِقٌ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  مُعَاذُ  ،  أَفَتَّانٌ  أَنْتَ  ؟ - ثَلَاثًا - يَا  مُعَاذُ  ، اقْرَأْ         {      وَالشَّمْسِ وَضُحَاهَا         }      وَ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَنَحْوَهُمَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَلِيمِ بْنِ حَيَّانَ  إِلَّا  يَزِيدُ بْنُ هَارُونَ  "" .","","Al-Mu'jam al-Awsat 7363","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن سليم بن حيان بن بسطام الهذلي عن يزيد بن هارون عن أحمد بن سنان القطان عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7370","7364  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  نَصْرُ بْنُ عَلِيٍّ ،  نَا  أَبِي  ،  ثَنَا  الْقَاسِمُ بْنُ مَعْنٍ ،  نَا  طَلْحَةُ بْنُ يَحْيَى ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ، وَمُجَاهِدٍ ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَاهَا ، فَقَالَ :  هَلْ عِنْدَكُمْ طَعَامٌ  ؟ "" فَقُلْتُ : لَا ، فَقَالَ : "" إِنِّي صَائِمٌ "" قَالَ : ثُمَّ جَاءَ يَوْمٌ آخَرُ ، فَقَالَتْ  عَائِشَةُ  : يَا رَسُولَ اللهِ ، إِنَّا قَدْ أُهْدِيَ إِلَيْنَا حَيْسٌ ، فَدَعَا بِهِ ، وَقَالَ : "" أَمَا إِنِّي أَصْبَحْتُ الْيَوْمَ صَائِمًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْقَاسِمِ بْنِ مَعْنٍ  إِلَّا  عَلِيُّ بْنُ نَصْرٍ  ،  تَفَرَّدَ بِهِ  :  نَصْرُ بْنُ عَلِيٍّ  "" .","","Al-Mu'jam al-Awsat 7364","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن طلحة بن يحيى بن طلحة التيمي عن القاسم بن معن عن علي بن نصر الجهضمي الكبير عن نصر بن علي بن نصر الجهضمي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7371","7365  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عَبَادَةَ الْوَاسِطِيُّ ،  نَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ،  نَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  حُذَيْفَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا تَشْرَبُوا فِي آنِيَةِ الذَّهَبِ وَالْفِضَّةِ  ، وَلَا تَأْكُلُوا فِيهِمَا  .         [7/234]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي نَجِيحٍ  إِلَّا  جَرِيرُ بْنُ حَازِمٍ  ،  تَفَرَّدَ بِهِ  :  يَحْيَى بْنُ إِسْحَاقَ  "" .","","Al-Mu'jam al-Awsat 7365","","حذيفة بن اليمان عن عبد الرحمن بن أبي ليلى عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن جرير بن حازم عن يحيى بن إسحاق السيلحيني عن محمد بن عبادة بن البخترى الأسدي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7372","7366  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  أَحْمَدُ بْنُ ثَابِتٍ الْجَحْدَرِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عُمَرَ بْنِ سَعِيدٍ ،  عَنْ  أَبِي زُرْعَةَ بْنِ عَمْرِو بْنِ جَرِيرٍ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَرِهَ  الشِّكَالَ  فِي الْخَيْلِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَرَ بْنِ سَعِيدٍ  إِلَّا  سُفْيَانُ بْنُ عُيَيْنَةَ  "" .","","Al-Mu'jam al-Awsat 7366","","أبو هريرة الدوسي عن أبو زرعة بن عمرو بن جرير الغلابي عن عمر بن سعيد بن مسروق عن سفيان بن عيينة عن أحمد بن ثابت الجحدري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7373","7367  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  نَا  عُمَرُ بْنُ حَبِيبٍ الْقَاضِي ،  ثَنَا  سَلَمَةُ بْنُ عَلْقَمَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَعْتَقَ شَقِيصًا فِي مَمْلُوكٍ وَلَهُ مَالٌ  ، فَقَدْ عَتَقَ كُلُّهُ ، وَإِلَّا فَقَدْ عَتَقَ مِنْهُ مَا عَتَقَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَلَمَةَ بْنِ عَلْقَمَةَ  إِلَّا  عُمَرُ بْنُ حَبِيبٍ  "" .","","Al-Mu'jam al-Awsat 7367","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن سلمة بن علقمة التميمي عن عمر بن حبيب بن محمد العدوي عن حفص بن عمرو الربالي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7374","7368  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ خِدَاشٍ ،  نَا  سَلْمُ بْنُ قُتَيْبَةَ ،  نَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  ذُكِرَتِ الطِّيَرَةُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : فِي الدَّارِ ، وَالْمَرْأَةِ ، وَالدَّابَّةِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ كَانَ مِنْهَا شَيْءٌ فَفِي  الْفَأْلِ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  يُونُسُ  ، وَلَا عَنْ  يُونُسَ  إِلَّا  أَبُو قُتَيْبَةَ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ خَالِدِ بْنِ خِدَاشٍ  "" .","","Al-Mu'jam al-Awsat 7368","","هند بنت أبي أمية زوج رسول الله عن أبو سلمة بن عبد الرحمن عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن سلم بن قتيبة الشعيري عن محمد بن خالد بن خداش المهلبي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7375","7369  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  أَحْمَدُ بْنُ ثَابِتٍ الْجَحْدَرِيُّ ،  نَا  مُوسَى بْنُ مَسْعُودٍ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ قَالَ :  سَمِعْتُ  مُجَاهِدًا ، يَقُولُ :         [7/235]      سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : قَالَ :  مَا مِنَ الشَّجَرِ شَجَرَةٌ فِي الشَّجَرِ مَثَلُ الرَّجُلِ الْمُسْلِمِ فِي النَّاسِ  ؟ "" قَالَ  ابْنُ عُمَرَ  : فَلَمْ يَمْنَعْنِي أَنْ أَسْأَلَهُ إِلَّا أَنِّي كُنْتُ أَصْغَرَ  الْقَوْمِ  ، ثُمَّ قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هِيَ النَّخْلَةُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ  إِلَّا  مُحَمَّدُ بْنُ مُسْلِمٍ  ، وَلَا عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ  إِلَّا  أَبُو حُذَيْفَةَ مُوسَى بْنُ مَسْعُودٍ  ،  تَفَرَّدَ بِهِ  :  أَحْمَدُ بْنُ ثَابِتٍ  "" .","","Al-Mu'jam al-Awsat 7369","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن إبراهيم بن ميسرة الطائفي عن محمد بن مسلم بن سوسن الطائفي عن موسى بن مسعود النهدي عن أحمد بن ثابت الجحدري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7376","7370  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  أَحْمَدُ بْنُ ثَابِتٍ ،  نَا  أَبُو حُذَيْفَةَ مُوسَى بْنُ مَسْعُودٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَنْظَلَةَ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عُمَرَ - لَا أَعْلَمُهُ إِلَّا عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الطَّوَافُ صَلَاةٌ ، فَأَقِلُّوا فِيهِ الْكَلَامَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُفْيَانَ  إِلَّا  أَبُو حُذَيْفَةَ  ،  تَفَرَّدَ بِهِ  :  أَحْمَدُ بْنُ ثَابِتٍ  "" .","","Al-Mu'jam al-Awsat 7370","","عبد الله بن عمر بن الخطاب عن طاوس بن كيسان عن حنظلة الجمحي عن سفيان الثوري عن موسى بن مسعود النهدي عن أحمد بن ثابت الجحدري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7377","7371  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عَبَّادِ بْنِ آدَمَ ،  ثَنَا  أَبِي  ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  قَتَادَةَ ، وَأَيُّوبَ ، وَعَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ  كَعْبَ بْنَ مَالِكٍ  سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ  جَارِيَةٍ لَهُ  ذَبَحَتْ شَرِيطَةً  ، فَقَالَ : "" كُلْهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  "" .","","Al-Mu'jam al-Awsat 7371","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن قتادة بن دعامة عن حماد بن سلمة عن عباد بن آدم الهذلي عن محمد بن عباد بن آدم الهذلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7378","7372  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ التَّيْمِيُّ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي زِيَادٍ ،  ثَنَا  سَالِمُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ اقْتَنَى كَلْبًا فَإِنَّهُ يَنْقُصُ مِنْ عَمَلِهِ كُلَّ يَوْمٍ قِيرَاطٌ  .         [7/236]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي زِيَادٍ  إِلَّا  مُحَمَّدُ بْنُ بَكْرٍ  "" .","","Al-Mu'jam al-Awsat 7372","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبيد الله بن أبي زياد القداح عن محمد بن بكر بن عثمان البرساني عن إبراهيم بن محمد بن عبد الله المعمري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7379","7373  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ مُعَاوِيَةَ الْحَذَّاءُ الْوَاسِطِيُّ ،  نَا  أَبِي  ،  نَا  دَاوُدُ بْنُ الزِّبْرِقَانِ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كَسْبِ الْحَجَّامِ  = .","","Al-Mu'jam al-Awsat 7373","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن محمد بن جحادة الأودي عن داود بن الزبرقان عن أبي عن محمد بن عبد الله بن معاوية الحذاء الواسطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7380","7374  - =  وَبِهِ  : عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مَلَكًا يُنَادِي : اللَّهُمَّ عَجِّلْ لِمُنْفِقٍ  خَلَفًا  ، وَلِمُمْسِكٍ تَلَفًا  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ  إِلَّا  دَاوُدُ بْنُ الزِّبْرِقَانِ  ،  تَفَرَّدَ بِهِمَا  :  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ مُعَاوِيَةَ  ، عَنْ أَبِيهِ  "" .","","Al-Mu'jam al-Awsat 7374","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن محمد بن جحادة الأودي عن داود بن الزبرقان عن أبي عن محمد بن عبد الله بن معاوية الحذاء الواسطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7381","7375  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ مَخْلَدٍ الْوَاسِطِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  سَلَّامٌ أَبُو الْمُنْذِرِ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ،  عَنِ  الْمَعْرُورِ بْنِ سُوَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الصَّامِتِ ،  عَنْ  أَبِي ذَرٍّ قَالَ :  سَمِعْتُ الصَّادِقَ الْمَصْدُوقَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُحَدِّثُ عَنْ رَبِّهِ تَبَارَكَ وَتَعَالَى ، قَالَ :  الْحَسَنَةُ عَشْرٌ أَوْ أَزِيدُ  ، وَالسَّيِّئَةُ وَاحِدَةٌ أَوْ أَغْفِرُهَا ، وَمَنْ لَقِيَنِي - لَا يُشْرِكُ بِي شَيْئًا -  بِقُرَابِ  الْأَرْضِ خَطَايَا جَعَلْتُ لَهُ مِثْلَهَا مَغْفِرَةً "" .  ""  لَمْ يُدْخِلْ أَحَدٌ مِمَّنْ رَوَى هَذَا الْحَدِيثَ عَنْ  عَاصِمٍ  بَيْنَ  الْمَعْرُورِ  وَأَبِي ذَرٍّ  ""  عَبْدَ اللهِ بْنَ الصَّامِتِ  "" إِلَّا  سَلَّامٌ أَبُو الْمُنْذِرِ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ عُثْمَانَ  ، عَنْ أَبِيهِ  "" .","","Al-Mu'jam al-Awsat 7375","","أبو ذر الغفاري عن عبد الله بن الصامت الغفاري عن معرور بن سويد الأسدي عن عاصم بن بهدلة عن سلام بن سليمان المزني عن عثمان بن مخلد الواسطي عن محمد بن عثمان بن مخلد الواسطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7382","7376  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ مَخْلَدٍ قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  ،  ثَنَا  سَلَّامٌ أَبُو الْمُنْذِرِ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ الْأَنْصَارِيِّ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَقْبَلَ حَتَّى إِذَا كَانَ  بِالْجِعْرَانَةِ  اجْتَمَعَ النَّاسُ عَلَيْهِ وَتَعَلَّقَ رِدَاؤُهُ بِالشَّجَرَةِ ، فَقَالَ :  رُدُّوا عَلَيَّ رِدَائِي ، أَتَخَافُونَ أَلَّا أَقْسِمَ بَيْنَكُمْ  ؟         [7/237]      لَوْ كَانَ مِثْلُ شَجَرِ  تِهَامَةَ  نَعَمًا لَقَسَمْتُهُ بَيْنَكُمْ ، ثُمَّ لَا تَجِدُونِي جَبَانًا ، وَلَا بَخِيلًا ، وَلَا كَذُوبًا "" .  ثُمَّ قَالَ : "" رُدُّوا  الْخِيَاطَ  وَالْمِخْيَطَ ، فَإِنَّ الْغُلُولَ عَارٌ وَنَارٌ  وَشَنَارٌ  عَلَى أَهْلِهِ يَوْمَ الْقِيَامَةِ "" .  وَقَالَ : "" مَا لِيَ مِنْ هَذَا الْفَيْءِ مِثْلُ هَذِهِ الْوَبَرَةِ - وَأَخَذَهَا مِنْ كَاهِلِ الْبَعِيرِ - إِلَّا الْخُمُسُ ، وَالْخُمُسُ مَرْدُودٌ عَلَيْكُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَلَّامٍ أَبِي الْمُنْذِرِ  إِلَّا  عُثْمَانُ بْنُ مَخْلَدٍ  ،  تَفَرَّدَ بِهِ  : ابْنُهُ  "" .","","Al-Mu'jam al-Awsat 7376","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن يحيى بن سعيد الأنصاري عن سلام بن سليمان المزني عن عثمان بن مخلد الواسطي عن محمد بن عثمان بن مخلد الواسطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7383","7377  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ مَخْلَدٍ الْوَاسِطِيُّ قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي  ، بِخَطِّهِ :  ثَنَا  سَلَّامٌ ،  عَنْ  عَاصِمِ بْنِ بَهْدَلَةَ ، وَعَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ ،  أَنَّ قَاتِلَ  الزُّبَيْرِ بْنِ الْعَوَّامِ  ، جَاءَ يَسْتَأْذِنُ عَلَى عَلِيٍّ ، فَقَالَ : ائْذَنُوا لَهُ وَبَشِّرُوهُ بِالنَّارِ ، سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ لِكُلِّ نَبِيٍّ  حَوَارِيًّا  ، وَإِنَّ  حَوَارِيِّ  الزُّبَيْرُ بْنُ الْعَوَّامِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءِ بْنِ السَّائِبِ  وَعَاصِمٍ  ، عَنْ  أَبِي عَبْدِ الرَّحْمَنِ  إِلَّا  سَلَّامٌ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ مَخْلَدٍ  ، عَنْ أَبِيهِ .  وَرَوَاهُ النَّاسُ ، عَنْ  عَاصِمٍ  ، عَنْ  زِرٍّ  ، عَنْ  عَلِيٍّ  .","","Al-Mu'jam al-Awsat 7377","","علي بن أبي طالب عن عبد الله بن حبيب السلمي عن عطاء بن السائب عن سلام بن سليمان المزني عن عثمان بن مخلد الواسطي عن محمد بن عثمان بن مخلد الواسطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7384","7378  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  أَحْمَدُ بْنُ عَلِيِّ بْنِ شَوْذَبٍ الْوَاسِطِيُّ ،  ثَنَا  أَبُو الْمُسَيِّبِ سَلْمُ بْنُ سَلَّامٍ ،  ثَنَا  لَيْثُ بْنُ سَعْدٍ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ أُسَامَةَ بْنِ الْهَادِ ،  عَنْ  يَعْقُوبَ بْنِ خَالِدٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فَضْلُ مَا بَيْنَ لَذَّةِ الْمَرْأَةِ وَلَذَّةِ الرَّجُلِ  كَأَثَرِ الْمِخْيَطِ فِي الطِّينِ ، إِلَّا أَنَّ اللهَ يَسْتُرُهُنَّ بِالْحَيَاءِ  .         [7/238]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  لَيْثِ بْنِ سَعْدٍ  إِلَّا  أَبُو الْمُسَيِّبِ  "" .","","Al-Mu'jam al-Awsat 7378","","عبد الله بن عمرو بن العاص عن عطاء بن يسار الهلالي عن يعقوب بن خالد بن المسيب المخزومي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن سلم بن سلام بن نصر الواسطي عن أحمد بن على بن شوذب الواسطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7385","7379  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  أَحْمَدُ بْنُ عَلِيِّ بْنِ شَوْذَبٍ ،  نَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْلَا أَنَّ قَوْمَكِ حَدِيثُ عَهْدٍ بِكُفْرٍ لَهَدَمْتُ  الْكَعْبَةَ  ، ثُمَّ أَعَدْتُهَا عَلَى أَسَاسِ  إِبْرَاهِيمَ  ، وَأَدْخَلْتُ فِي  الْبَيْتِ  مِنَ  الْحِجْرِ  أَذْرُعًا ، وَجَعَلْتُ لَهَا بَابَيْنِ ، وَأَلْصَقْتُهُمَا بِالْأَرْضِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا ابْنُهُ ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ  "" .","","Al-Mu'jam al-Awsat 7379","","عائشة بنت أبي بكر الصديق عن عبد الله بن الزبير عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن يعقوب بن محمد بن عيسى عن أحمد بن على بن شوذب الواسطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7386","7380  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  أَحْمَدُ بْنُ عَلِيِّ بْنِ شَوْذَبٍ ،  ثَنَا  أَبُو الْمُسَيِّبِ سَلَّامُ بْنُ مُسْلِمٍ ،  نَا  لَيْثُ بْنُ سَعْدٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  - أَظُنُّهُ مَرْفُوعًا - ، قَالَ :  لَيْسَ مِنَّا مَنْ تَشَبَّهَ بِغَيْرِنَا  ، لَا تَشَبَّهُوا بِالْيَهُودِ وَلَا بِالنَّصَارَى ، فَإِنَّ تَسْلِيمَ الْيَهُودِ الْإِشَارَةُ بِالْأَصَابِعِ ، وَإِنَّ تَسْلِيمَ النَّصَارَى بِالْأَكُفِّ ، وَلَا تَقُصُّوا النَّوَاصِيَ ، وَأَحْفُوا الشَّوَارِبَ ، وَأَعْفُوا اللِّحَى ، وَلَا تَمْشُوا فِي الْمَسَاجِدِ وَالْأَسْوَاقِ ، وَعَلَيْكُمُ الْقُمُصُ إِلَّا وَتَحْتَهَا الْأُزُرُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  لَيْثِ بْنِ سَعْدٍ  إِلَّا  أَبُو الْمُسَيِّبِ  "" .","","Al-Mu'jam al-Awsat 7380","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن أبو المسيب سلام بن مسلم عن أحمد بن على بن شوذب الواسطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7387","7381  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ،  ثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ الطَّائِفِيُّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  مَعْنِ بْنِ مُحَمَّدٍ الْغِفَارِيِّ ،  عَنْ  حَنْظَلَةَ بْنِ عَلِيٍّ الْأَسْلَمِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الطَّاعِمُ الشَّاكِرُ مِثْلُ الصَّائِمِ الصَّابِرِ  .         [7/239]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  مُحَمَّدُ بْنُ مُسْلِمٍ  ، وَلَا عَنْ  مُحَمَّدٍ  إِلَّا  يَعْقُوبُ الْحَضْرَمِيُّ  ،  تَفَرَّدَ بِهِ  :  إِسْحَاقُ بْنُ وَهْبٍ  "" .","","Al-Mu'jam al-Awsat 7381","","أبو هريرة الدوسي عن حنظلة بن علي بن الأسقع الأسلمي عن معن بن محمد بن معن الغفاري عن ابن جريج عن محمد بن مسلم بن سوسن الطائفي عن يعقوب بن إسحاق بن زيد الحضرمي عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7388","7382  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ،  نَا  مُحَمَّدُ بْنُ الْقَاسِمِ الْأَسَدِيُّ ،  نَا  مِسْعَرٌ وَسُفْيَانُ وَفِطْرٌ وَخَطَّابُ بْنُ كَيْسَانَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي جُحَيْفَةَ قَالَ :  قَامَ عَلِيٌّ ، عَلَى مِنْبَرِ  الْكُوفَةِ  ،  قَالَ  :  أَلَا أُنَبِّئُكُمْ بِخَيْرِ هَذِهِ الْأُمَّةِ بَعْدَ نَبِيِّهَا  ؟ أَلَا إِنَّ خَيْرَ هَذِهِ الْأُمَّةِ بَعْدَ نَبِيِّهَا  أَبُو بَكْرٍ  ثُمَّ  عُمَرُ  ، وَلَوْ شِئْتُ أَنْ أُخْبِرَكُمْ بِالثَّالِثِ لَأَخْبَرْتُكُمْ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مِسْعَرٍ ،  وَخَطَّابِ بْنِ كَيْسَانَ  إِلَّا  مُحَمَّدُ بْنُ الْقَاسِمِ  ،  تَفَرَّدَ بِهِ  :  إِسْحَاقُ بْنُ وَهْبٍ  "" .","","Al-Mu'jam al-Awsat 7382","","علي بن أبي طالب عن وهب بن عبد الله السوائي عن أبو إسحاق السبيعي عن خطاب بن كيسان عن محمد بن القاسم الأسدي عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7389","7383  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ،  ثَنَا  عُمَرُ بْنُ يُونُسَ ،  ثَنَا  سُلَيْمَانُ بْنُ أَبِي سُلَيْمَانَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  حَجَّةِ الْوَدَاعِ  :  لَوْلَا أَنِّي أَهْدَيْتُ لَحَلَلْتُ  وَكَانَ أَهَلَّ بِعُمْرَةٍ وَحَجٍّ ، فَيَرَوْنَ أَنَّ الْهَدْيَ كَانَ يَمْنَعُهُ أَنْ يُحِلَّ مِنْ عُمْرَتِهِ قَبْلَ أَنْ يَحُجَّ ، وَقَدْ كَانَ  أَحَلَّ  مِنْ أَصْحَابِهِ مَنْ لَمْ يَكُنْ أَهْدَى .","","Al-Mu'jam al-Awsat 7383","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن يحيى بن أبي كثير عن سليمان بن أبي سليمان اليمامي عن عمر بن يونس بن القاسم عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7390","7384  -  =  وَبِهِ  :  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّهَا أَخْبَرَتْهُ أَنَّهَا أَحْرَمَتْ فِي  حَجَّةِ الْوَدَاعِ  بِعُمْرَةٍ قَبْلَ  الْحَجِّ  ، وَأَنَّهَا حَاضَتْ فَلَمْ تَطْهُرْ فَيَطُوفَ  بِالْبَيْتِ  ، حَتَّى كَانَ يَوْمُ  عَرَفَةَ  ، وَأَنَّهَا ذَكَرَتْ ذَلِكَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  انْقُضِي رَأْسَكِ ثُمَّ امْتَشِطِي  ، ثُمَّ أَهِلِّي بِالْحَجِّ وَاتْرُكِي الْعُمْرَةَ "" . فَفَعَلْتُ حَتَّى قَضَيْتُ حَجِّي ، فَبَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَعِي  عَبْدَ الرَّحْمَنِ بْنَ أَبِي بَكْرٍ  ، وَأَمَرَنِي أَنْ أَعْتَمِرَ مِنَ  التَّنْعِيمِ  مَكَانَ عُمْرَتِي الَّتِي دَهَمَنِي  الْحَجُّ  وَلَمْ أَحْلِلْ مِنْهَا  = .","","Al-Mu'jam al-Awsat 7384","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن يحيى بن أبي كثير عن سليمان بن أبي سليمان اليمامي عن عمر بن يونس بن القاسم عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7391","[7/240]      7385  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ،  ثَنَا  عُمَرُ بْنُ يُونُسَ ،  عَنْ  سُلَيْمَانَ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  نَافِعٍ ،  عَنْ  نُبَيْهِ بْنِ وَهْبٍ ،  عَنْ  أَبَانَ بْنِ عُثْمَانَ قَالَ :  سَمِعْتُ  عُثْمَانَ  يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَنْكِحُ الْمُحْرِمُ ، وَلَا يُنْكِحُ  ، وَلَا يَخْطُبُ "" .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  إِلَّا  سُلَيْمَانُ بْنُ أَبِي سُلَيْمَانَ  ،  تَفَرَّدَ بِهَا  :  عُمَرُ بْنُ يُونُسَ  "" .","","Al-Mu'jam al-Awsat 7385","","عثمان بن عفان عن أبان بن عثمان بن عفان عن نبيه بن وهب بن عثمان العبدري عن نافع مولى ابن عمر عن يحيى بن أبي كثير عن سليمان بن أبي سليمان اليمامي عن عمر بن يونس بن القاسم عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7392","7386  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ،  نَا  يَزِيدُ بْنُ هَارُونَ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مُجَبَّرٍ ،  نَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي صَالِحٍ السَّمَّانِ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَامَ فَدَعَا بِدُعَاءٍ لَمْ يَسْمَعِ النَّاسُ مِثْلَهُ ، وَاسْتَعَاذَ اسْتِعَاذَةً لَمْ يَسْمَعِ النَّاسُ مِثْلَهَا ، فَقَالَ لَهُ بَعْضُ النَّاسِ : كَيْفَ لَنَا يَا رَسُولَ اللهِ أَنْ نَدْعُوَ بِمِثْلِ مَا دَعَوْتَ ، وَأَنْ نَسْتَعِيذَ كَمَا اسْتَعَذْتَ ؟ فَقَالَ : "" قُولُوا :  اللَّهُمَّ إِنَّا نَسْأَلُكَ مِمَّا سَأَلَكَ  مُحَمَّدٌ  عَبْدُكَ وَرَسُولُكَ  ، وَنَسْتَعِيذُ مِمَّا اسْتَعَاذَ مِنْهُ  مُحَمَّدٌ  عَبْدُكَ وَرَسُولُكَ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءِ بْنِ يَسَارٍ  إِلَّا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ  ، وَلَا عَنِ  ابْنِ الْمُنْكَدِرِ  إِلَّا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مُجَبَّرٍ  ،  تَفَرَّدَ بِهِ  :  يَزِيدُ بْنُ هَارُونَ  "" .","","Al-Mu'jam al-Awsat 7386","","أبو هريرة الدوسي عن ذكوان السمان عن عطاء بن يسار الهلالي عن محمد بن المنكدر عن محمد بن عبد الرحمن بن المجبر عن يزيد بن هارون عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7393","7387  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْإِمَامُ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  أَخْطَأَنِي الْعَشَاءُ ذَاتَ لَيْلَةٍ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَخْطَأَنِي أَنْ يَدْعُوَنِي أَحَدٌ مِنْ إِخْوَانِنَا ، فَصَلَّيْتُ الْعِشَاءَ ، ثُمَّ أَرَدْتُ أَنْ أَنَامَ فَلَمْ أَقْدِرْ ، وَأَرَدْتُ أَنْ أُصَلِّيَ فَلَمْ أَقْدِرْ ، فَإِذَا رَجُلٌ عِنْدَ حُجْرَةِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَيْتُهُ فَإِذَا هُوَ رَسُولُ اللهِ         [7/241]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي ، فَصَلَّى ثُمَّ اسْتَنَدَ إِلَى السَّارِيَةِ الَّتِي كَانَ يُصَلِّي إِلَيْهَا ، فَقَالَ : "" مَنْ هَذَا ؟  أَبُو هِرٍّ  ؟ "" قُلْتُ : نَعَمْ ، قَالَ :  أَخْطَأَكَ الْعَشَاءُ مَعَنَا اللَّيْلَةَ  ؟ "" قُلْتُ : نَعَمْ ، قَالَ : "" انْطَلِقْ إِلَى الْمَنْزِلِ فَقُلْ : هَلُمُّوا الطَّعَامَ الَّذِي عِنْدَكُمْ "" ، فَأَعْطَوْنِي صَحْفَةً فِيهَا  عَصِيدَةٌ  بِتَمْرٍ ، فَأَتَيْتُ بِهَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَوَضَعْتُهَا بَيْنَ يَدَيْهِ ، فَقَالَ لِي : "" ادْعُ لِيَ أَهْلَ الْمَسْجِدِ "" ، فَقُلْتُ فِي نَفْسِي : الْوَيْلُ لِي ، مِمَّا أَرَى مِنْ قِلَّةِ الطَّعَامِ ، وَالْوَيْلُ لِي مِنَ الْمَعْصِيَةِ ، فَآتِي الرَّجُلَ وَهُوَ نَائِمٌ فَأُوقِظُهُ ، وَأَقُولُ : أَجِبْ ، وَآتِي الرَّجُلَ وَهُوَ يُصَلِّي ، فَأَقُولُ : أَجِبْ ، حَتَّى اجْتَمَعُوا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَوَضَعَ أَصَابِعَهُ فِيهَا ، وَغَمَزَ نَوَاحِيَهَا ، وَقَالَ : "" كُلُوا بِسْمِ اللهِ "" ، فَأَكَلُوا حَتَّى شَبِعُوا ، وَأَكَلْتُ حَتَّى شَبِعْتُ ، فَقَالَ : "" خُذْهَا يَا  أَبَا هِرٍّ  ، فَارْدُدْهَا إِلَى  آلِ مُحَمَّدٍ  ، فَمَا فِي  آلِ مُحَمَّدٍ  طَعَامٌ يَأْكُلُهُ ذُو كَبِدٍ غَيْرُهُ ، أَهْدَاهَا إِلَيْنَا  رَجُلٌ مِنَ الْأَنْصَارِ  "" ، فَأَخَذْتُ الصَّحْفَةَ فَرَفَعْتُهَا ، فَإِذَا هِيَ كَهَيْئَتِهَا حِينَ وَضَعْتُهَا ، إِلَّا أَنَّ فِيهَا آثَارَ خُطُوطِ أَصَابِعِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَامِرِ بْنِ سَعْدٍ  إِلَّا  جَعْفَرُ بْنُ عَبْدِ اللهِ بْنِ الْحَكَمِ  ، وَلَا عَنْ  جَعْفَرٍ  إِلَّا ابْنُهُ  عَبْدُ الْحَمِيدِ  ، وَلَا عَنْ  عَبْدِ الْحَمِيدِ  إِلَّا  حَفْصُ بْنُ عُمَرَ الْإِمَامُ  ،  تَفَرَّدَ بِهِ  :  إِسْحَاقُ بْنُ وَهْبٍ  "" .","","Al-Mu'jam al-Awsat 7387","","أبو هريرة الدوسي عن عامر بن سعد البجلي عن جعفر بن عبد الله بن الحكم الأوسي عن عبد الحميد بن جعفر الأوسي عن حفص بن عمر الرازي عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7394","7388  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْحَاقُ بْنُ وَهْبٍ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْإِمَامُ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  عَبَّادِ بْنِ أَبِي عَلِيٍّ ،  عَنْ  شَيْبَةَ بْنِ الْمُسَاوِرِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَرَّمَ سِتَّةً  : الْخَمْرَ ، وَالْمَيْسِرَ ، وَالْمَعَازِفَ ، وَالْمَزَامِيرَ ، وَالدُّفَّ ،  وَالْكُوبَةَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شَيْبَةَ بْنِ الْمُسَاوِرِ  إِلَّا  عَبَّادُ بْنُ أَبِي عَلِيٍّ  ، وَلَا عَنْ  عَبَّادٍ  إِلَّا  هِشَامٌ  ،  تَفَرَّدَ بِهِ  :  حَفْصُ بْنُ عُمَرَ  "" .","","Al-Mu'jam al-Awsat 7388","","عبد الله بن عباس عن شيبة بن مساور البصري عن عباد بن أبي علي البصري عن هشام الدستوائي عن حفص بن عمر الرازي عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7395","7389  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْحَاقُ بْنُ وَهْبٍ ،  نَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  ثَنَا  عَمْرُو بْنُ ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ         [7/242]      الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  أُمِّ سَلَمَةَ ، زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّ  الْحَارِثَ بْنَ هِشَامٍ  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّةً يَوْمَ  حَجَّةِ الْوَدَاعِ  ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّكَ تَحُثُّ عَلَى صِلَةِ الرَّحِمِ ، وَالْإِحْسَانِ فِي الْجَارِ ، وَإِيوَاءِ الْيَتِيمِ ، وَإِطْعَامِ الضَّيْفِ ، وَإِطْعَامِ الْمَسَاكِينِ ، وَكُلُّ هَذَا كَانَ  هِشَامُ بْنُ الْمُغِيرَةِ  يَفْعَلُهُ ، فَمَا ظَنُّكَ بِهِ يَا رَسُولَ اللهِ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ قَبْرٍ قُبِرَ لَا يَشْهَدُ صَاحِبُهُ أَنْ لَا إِلَهَ إِلَّا اللهُ فَهُوَ جَذْوَةٌ مِنَ النَّارِ  ، وَقَدْ وَجَدْتُ عَمِّيَ  أَبَا طَالِبٍ  فِي  طَمْطَامٍ  مِنَ النَّارِ ، فَأَخْرَجَهُ اللهُ لِمَكَانِهِ مِنِّي وَإِحْسَانِهِ إِلَيَّ ، فَجَعَلَهُ فِي  ضَحْضَاحٍ  مِنَ النَّارِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ  إِلَّا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَقِيلٍ  ، وَلَا عَنِ  ابْنِ عَقِيلٍ  إِلَّا  عَمْرُو بْنُ ثَابِتٍ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ أَبَانَ  ، وَلَا يُرْوَى عَنْ  أُمِّ سَلَمَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7389","","هند بنت أبي أمية زوج رسول الله عن أبو بكر بن عبد الرحمن راهب قريش عن عبد الله بن محمد بن عقيل بن أبي طالب عن عمرو  بن أبي المقدام عن إسماعيل بن أبان عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7396","7390  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  عَمَّارُ بْنُ خَالِدٍ الْوَاسِطِيُّ ،  ثَنَا  عَبْدُ الْحَكِيمِ بْنُ مَنْصُورٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ قَالَ :  سَمِعْتُ  عَبْدَ الرَّحْمَنِ بْنَ أَبِي لَيْلَى ،  يُحَدِّثُ عَنْ  صُهَيْبٍ قَالَ :  صَلَّيْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِحْدَى صَلَاتَيِ الْعِشَاءِ ، فَلَمَّا انْصَرَفَ أَقْبَلَ إِلَيْنَا بِوَجْهِهِ ضَاحِكًا ، فَقَالَ : "" أَلَا تَسْأَلُونِي مِمَّ ضَحِكْتُ ؟ "" قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ :  عَجِبْتُ مِنْ قَضَاءِ اللهِ لِلْعَبْدِ الْمُسْلِمِ  ، إِنَّ كُلَّ مَا قَضَى اللهُ لَهُ خَيْرٌ ، وَلَيْسَ كُلُّ قَضَاءِ اللهِ خَيْرًا إِلَّا لِلْعَبْدِ الْمُسْلِمِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يُونُسَ بْنِ عُبَيْدٍ  إِلَّا  عَبْدُ الْحَكِيَمِ بْنُ مَنْصُورٍ  ،  تَفَرَّدَ بِهِ  :  عَمَّارُ بْنُ خَالِدٍ  "" .","","Al-Mu'jam al-Awsat 7390","","صهيب بن سنان الرومي عن عبد الرحمن بن أبي ليلى عن ثابت البناني عن يونس بن عبيد عن عبد الحكيم بن منصور الخزاعي عن عمار بن خالد بن يزيد التمار عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7397","[7/243]      7391  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَمَّارُ بْنُ خَالِدٍ ،  ثَنَا  عَلِيُّ بْنُ غُرَابٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنِ  الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَغْلِبَنَّكُمْ أَهْلُ الْبَادِيَةِ عَلَى اسْمِ صَلَاتِكُمْ  ، سَمَّاهَا اللهُ الْعِشَاءَ وَيُسَمُّونَهَا  الْعَتَمَةَ  ؟  .","","Al-Mu'jam al-Awsat 7391","","أبو هريرة الدوسي عن سعيد المقبري عن محمد بن عجلان عن علي بن عبد العزيز الفزاري عن عمار بن خالد بن يزيد التمار عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7398","7392  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبَادَةَ الْوَاسِطِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  نَا  هِشَامُ بْنُ عَبْدِ اللهِ بْنِ عِكْرِمَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  أَصْبَحْتُ أَنَا  وَحَفْصَةُ  صَائِمَتَيْنِ ، فَأُهْدِيَتْ لَنَا هَدِيَّةٌ ، فَأَكَلْنَا مِنْهَا ، فَدَخَلَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَخْبَرْنَاهُ بِذَلِكَ ، فَقَالَ :  اقْضِيَا يَوْمًا مَكَانَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  هِشَامُ بْنُ عِكْرِمَةَ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ  "" .","","Al-Mu'jam al-Awsat 7392","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن هشام بن عبد الله بن عكرمة بن خالد عن يعقوب بن محمد بن عيسى عن محمد بن عبادة بن البخترى الأسدي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7399","7393  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  شُعَيْبُ بْنُ عَبْدِ الْحَمِيدِ الْوَاسِطِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  نَا  عَبْدُ الْمَلِكِ بْنُ الْحُسَيْنِ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْوَلِيمَةُ أَوَّلَ يَوْمٍ حَقٌّ  ، وَالثَّانِي مَعْرُوفٌ ، وَالثَّالِثُ رِيَاءٌ وَسُمْعَةٌ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَنْصُورٍ  إِلَّا  عَبْدُ الْمَلِكِ بْنُ الْحُسَيْنِ  "" .","","Al-Mu'jam al-Awsat 7393","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن منصور بن المعتمر عن ابن ذر ، عبد الملك بن الحسين النخعي عن يزيد بن هارون عن شعيب بن عبد الحميد الواسطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7400","7394  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبَادَةَ الْوَاسِطِيُّ ،  ثَنَا  كَثِيرُ بْنُ هِشَامٍ ،  نَا  كُلْثُومُ بْنُ جَوْشَنٍ الْقُشَيْرِيُّ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  التَّاجِرُ الصَّدُوقُ الْأَمِينُ مَعَ الشُّهَدَاءِ  يَوْمَ الْقِيَامَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَيُّوبَ  إِلَّا  كُلْثُومُ بْنُ جَوْشَنٍ  ،  تَفَرَّدَ بِهِ  :  كَثِيرُ بْنُ هِشَامٍ  "" .","","Al-Mu'jam al-Awsat 7394","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن كلثوم بن جوشن القشيري عن كثير بن هشام الكلابي عن محمد بن عبادة بن البخترى الأسدي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7401","[7/244]      7395  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  شُعَيْبُ بْنُ عَبْدِ الْحَمِيدِ الْوَاسِطِيُّ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ الْجَبُّلِيُّ ،  ثَنَا  هَاشِمُ بْنُ صُبَيْحٍ ،  ثَنَا  أَبُو أَنَسٍ الْمَكِّيُّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا وُلِدَ فِي أَهْلِ بَيْتٍ غُلَامٌ إِلَّا أَصْبَحَ فِيهِمْ عِزٌّ  لَمْ يَكُنْ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو أَنَسٍ الْمَكِّيُّ - وَاسْمُهُ : عِمْرَانُ بْنُ أَنَسٍ -  ، وَلَا رَوَاهُ عَنْ  أَبِي أَنَسٍ  إِلَّا  هَاشِمُ بْنُ صُبَيْحٍ الْوَاسِطِيُّ  ،  تَفَرَّدَ بِهِ  :  مُوسَى بْنُ إِسْمَاعِيلَ الْجَبُّلِيُّ  "" .","","Al-Mu'jam al-Awsat 7395","","عبد الله بن عمر بن الخطاب عن عطاء بن أبي رباح عن ابن جريج عن عمران بن أنس المكي عن هاشم بن صبح عن موسى بن إسماعيل الجبلي عن شعيب بن عبد الحميد الواسطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7402","7396  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  الْحُسَيْنُ بْنُ عَبْدِ اللهِ الْكُوفِيُّ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَثَلُ الرَّجُلِ وَمَثَلُ الْمَوْتِ كَمَثَلِ رَجُلٍ لَهُ ثَلَاثَةُ أَخِلَّاءَ  ، فَقَالَ : اللَّهُمَّ هَذَا مَالِي فَخُذْ مِنْهُ مَا شِئْتَ ، وَأَعْطِ مَا شِئْتَ ، وَدَعْ مَا شِئْتَ . وَقَالَ الْآخَرُ : أَنَا مَعَكَ أَخْدُمُكَ ، فَإِذَا مِتَّ تَرَكْتُكَ . وَقَالَ الْآخَرُ : أَنَا مَعَكَ أَدْخُلُ مَعَكَ وَأَخْرُجُ مَعَكَ ، إِنْ مِتَّ وَإِنْ حَيِيتَ . فَأَمَّا الَّذِي قَالَ : هَذَا مَالِي خُذْ مِنْهُ مَا شِئْتَ وَدَعْ مَا شِئْتَ فَهُوَ مَالُهُ ، وَالْآخَرُ : عَشِيرَتُهُ ، وَالْآخَرُ : عَمَلُهُ يَدْخُلُ مَعَهُ وَيَخْرُجُ مَعَهُ حَيْثُ كَانَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حَمَّادِ بْنِ سَلَمَةَ  إِلَّا  النَّضْرُ بْنُ شُمَيْلٍ  "" .","","Al-Mu'jam al-Awsat 7396","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن حماد بن سلمة عن النضر بن شميل عن الحسين بن عبد الله الكوفي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7403","7397  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ،  ثَنَا  مُحَمَّدُ بْنُ الْقَاسِمِ الْأَسَدِيُّ ،  نَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ يَعْلَمُ النَّاسُ مَا فِي الْوَحْدَةِ مَا أَعْلَمُ         [7/245]      مَا سَارَ رَاكِبٌ وَحْدَهُ بِلَيْلٍ أَبَدًا ، وَلَا نَامَ رَجُلٌ وَحْدَهُ بِلَيْلٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زُهَيْرِ بْنِ مُعَاوِيَةَ  إِلَّا  مُحَمَّدُ بْنُ الْقَاسِمِ  "" .","","Al-Mu'jam al-Awsat 7397","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زهير بن معاوية بن حديج عن محمد بن القاسم الأسدي عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7404","7398  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ هَارُونَ الْغَسَّانِيُّ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا كَذَبَ الْعَبْدُ كَذِبَةً تَبَاعَدَ مِنْهُ الْمَلَكُ  مَسِيرَةَ  مِيلٍ  ، مِنْ نَتْنِ مَا جَاءَ بِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعٍ  إِلَّا  عَبْدُ الْعَزِيزِ بْنُ أَبِي رَوَّادٍ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الرَّحِيمِ بْنُ هَارُونَ  "" .","","Al-Mu'jam al-Awsat 7398","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد العزيز بن أبي رواد الخراساني عن عبد الرحيم بن هارون الغساني عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7405","7399  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَبْدُ اللهِ بْنُ هَارُونَ أَبُو عَلْقَمَةَ الْفَرْوِيُّ ،  ثَنَا  يَحْيَى بْنُ مُحَمَّدٍ الْجَارِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ رَدَّادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ اغْتَسَلَ يَوْمَ الْجُمُعَةِ ، ثُمَّ مَسَّ مِنْ أَطْيَبِ طِيبِهِ  ، وَلَبِسَ مِنْ أَحْسَنِ ثِيَابِهِ ، ثُمَّ  رَاحَ  ، وَلَمْ يُفَرِّقْ بَيْنَ اثْنَيْنِ حَتَّى يَقُومَ مِنْ مَقَامِهِ ، ثُمَّ  أَنْصَتَ  حَتَّى يَفْرُغَ الْإِمَامُ مِنْ خُطْبَتِهِ ، غُفِرَ لَهُ مَا بَيْنَ الْجُمُعَتَيْنِ ، وَزِيَادَةُ ثَلَاثَةِ أَيَّامٍ  .","","Al-Mu'jam al-Awsat 7399","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن محمد بن عبد الرحمن بن الرداد العامري عن يحيى بن محمد بن عبد الله بن مهران الجاري عن عبد الله بن هارون بن موسى الفروي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7406","7400  - =  وَبِهِ  : قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَافِرُوا ،  تَصِحُّوا  وَتَسْلَمُوا  ""  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ  إِلَّا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ رَدَّادٍ  "" .","","Al-Mu'jam al-Awsat 7400","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن محمد بن عبد الرحمن بن الرداد العامري عن يحيى بن محمد بن عبد الله بن مهران الجاري عن عبد الله بن هارون بن موسى الفروي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7407","7401  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَبْدُ اللهِ بْنُ هَارُونَ الْفَرْوِيُّ ،  ثَنَا  يَحْيَى بْنُ         [7/246]      مُحَمَّدٍ الْجَارِيُّ ،  عَنْ  مُحَمَّدِ بْنِ صَدَقَةَ الْفَدَكِيِّ ،  عَنْ  أَبِي ضَمْرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  عَلِيٍّ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْكَفَنُ مِنْ جَمِيعِ الْمَالِ  "" .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَلِيٍّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  يَحْيَى الْجَارِيُّ  "" .","","Al-Mu'jam al-Awsat 7401","","علي بن أبي طالب عن ضمرة بن ربيعة الضمري عن سعد بن ضميرة السلمي عن زياد بن سعد بن ضميرة السلمي عن محمد بن صدقة الفدكي عن يحيى بن محمد بن عبد الله بن مهران الجاري عن عبد الله بن هارون بن موسى الفروي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7408","7402  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  رَوْحُ بْنُ حَاتِمٍ أَبُو غَسَّانَ الْجُذُوعِيُّ ،  نَا  عَمْرُو بْنُ سُفْيَانَ الْقُطَعِيُّ ،  نَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَفْضَلُ الصَّدَقَةِ مَا كَانَ عَنْ  ظَهْرِ  غِنًى  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ  إِلَّا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ  "" .","","Al-Mu'jam al-Awsat 7402","","أبو هريرة الدوسي عن ذكوان السمان عن محمد بن جحادة الأودي عن الحسن بن أبي جعفر الجفري عن عمرو بن سفيان القطيعي عن روح بن حاتم البصري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7409","7403  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدٍ الْحَبْحَابِيُّ ،  نَا  صَالِحُ بْنُ عَبْدِ الْكَبِيرِ ،  حَدَّثَنِي  عَمِّي  عَبْدُ السَّلَامِ بْنُ شُعَيْبٍ الْحَبْحَابِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْأَزْدُ  أَزْدُ اللهِ فِي الْأَرْضِ  ، يُرِيدُ النَّاسُ أَنْ يَضَعُوهُمْ وَيَأْبَى اللهُ إِلَّا أَنْ يَرْفَعَهُمْ ، وَلَيَأْتِيَنَّ عَلَى النَّاسِ زَمَانٌ يَقُولُ الرَّجُلُ : يَا لَيْتَ كَانَ أَبِي أَزْدِيًّا ، يَا لَيْتَ كَانَتْ أُمِّي أَزْدِيَّةً  "" .","","Al-Mu'jam al-Awsat 7403","","أنس بن مالك عن شعيب بن الحبحاب المعولي عن عبد السلام بن شعيب المعولي عن صالح بن عبد الكبير الحبحابي عن عبد القدوس بن محمد الحبحابي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7410","7404  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدٍ ،  حَدَّثَنِي  أَبِي مُحَمَّدُ بْنُ عَبْدِ الْكَبِيرِ بْنِ شُعَيْبٍ  ،  حَدَّثَنِي  عَمِّي  عَبْدُ السَّلَامِ بْنُ شُعَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  أُتِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِقَدَحٍ - أَوْ         [7/247]      بِقَعْبٍ  فِيهِ لَبَنٌ وَعَسَلٌ ، فَقَالَ :  أُدْمَانِ فِي إِنَاءٍ ؟ لَا آكُلُهُ ، وَلَا أُحَرِّمُهُ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  شُعَيْبِ بْنِ الْحَبْحَابِ  إِلَّا ابْنُهُ  عَبْدُ السَّلَامِ  ،  تَفَرَّدَ بِهِمَا  :  عَبْدُ الْقُدُّوسِ  ، عَنْ أَبِيهِ  "" .","","Al-Mu'jam al-Awsat 7404","","أنس بن مالك عن شعيب بن الحبحاب المعولي عن عبد السلام بن شعيب المعولي عن محمد بن عبد الكبير المعولي عن عبد القدوس بن محمد الحبحابي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7411","7405  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدٍ ،  حَدَّثَتْنِي  أُمِّي حَبِيبَةُ بِنْتُ مَنْصُورٍ  ،  حَدَّثَتْنِي  أُمُّ سُلَيْمَةَ بِنْتُ شُعَيْبِ بْنِ الْحَبْحَابِ ،  عَنْ  أَبِيهَا  ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا تَطَيَّبْتِ الْمَرْأَةُ لِغَيْرِ زَوْجِهَا فَإِنَّمَا هُوَ نَارٌ فِي  شَنَارٍ  "" .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  شُعَيْبِ بْنِ الْحَبْحَابِ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الْقُدُّوسِ  "" .","","Al-Mu'jam al-Awsat 7405","","أنس بن مالك عن شعيب بن الحبحاب المعولي عن أم سليمة بنت شعيب بن الحبحاب عن حبيبة بنت منصور عن عبد القدوس بن محمد الحبحابي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7412","7406  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدٍ ،  ثَنَا  سَعِيدُ بْنُ سُوَيْدٍ الْمَعْوَلِيُّ ،  ثَنَا  خَالِدُ بْنُ زِيَادٍ - صَاحِبُ السَّابِرِيِّ -  عَنْ  أَبِي الصِّدِّيقِ النَّاجِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُ تَمَرَاتِكُمُ الْبَرْنِيُّ  ، يُذْهِبُ الدَّاءَ ، وَلَا دَاءَ فِيهِ "" .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي سَعِيدٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الْقُدُّوسِ  "" .","","Al-Mu'jam al-Awsat 7406","","أبو سعيد الخدري عن بكر بن عمرو الناجي عن خالد بن زياد بن جرو الترمذي عن سعيد بن سويد المعولي عن عبد القدوس بن محمد الحبحابي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7413","7407  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدٍ ،  ثَنَا  عَمْرُو بْنُ عَاصِمٍ الْكِلَابِيُّ ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ ، قَاضِي الرَّيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،         [7/248]      عَنْ  أُسَيْدِ بْنِ حُضَيْرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَوَضَّئُوا مِنْ لُحُومِ الْإِبِلِ  ، وَلَا تُصَلُّوا فِي مَنَاخِهَا ، وَلَا تَوَضَّئُوا مِنْ لُحُومِ الْغَنَمِ ، وَصَلُّوا فِي مَرَابِضِهَا  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عِمْرَانَ  إِلَّا  عَمْرُو بْنُ عَاصِمٍ  "" .","","Al-Mu'jam al-Awsat 7407","","أسيد بن حضير الأشهلي عن عبد الرحمن بن أبي ليلى عن عبد الله بن عبد الله الهاشمي عن حجاج بن أرطاة عن عمران بن داور القطان عن عمرو بن عاصم الكلابي عن عبد القدوس بن محمد الحبحابي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7414","7408  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  مُوسَى بْنُ مُطَيْرٍ ،  عَنْ  أَبِي إِسْحَاقَ قَالَ :  قَالَ لِي  الْبَرَاءُ بْنُ عَازِبٍ :  أَلَا أُعَلِّمُكَ دُعَاءً عَلَّمَنِيهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" إِذَا رَأَيْتَ النَّاسَ قَدْ تَنَافَسُوا الذَّهَبَ وَالْفِضَّةَ ، فَادْعُ بِهَذِهِ الدَّعَوَاتِ :  اللَّهُمَّ إِنِّي أَسْأَلُكَ الثَّبَاتَ فِي الْأَمْرِ ، وَأَسْأَلُكَ عَزِيمَةً عَلَى الرُّشْدِ  ، وَأَسْأَلُكَ شُكْرَ نِعْمَتِكَ ، وَالصَّبْرَ عَلَى بَلَائِكَ ، وَأَسْأَلُكَ حُسْنَ عِبَادَتِكَ ، وَالرِّضَا بِقَضَائِكَ ، وَأَسْأَلُكَ قَلْبًا سَلِيمًا ، وَلِسَانًا صَادِقًا ، وَأَسْأَلُكَ مِنْ خَيْرِ مَا تَعْلَمُ ، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا تَعْلَمُ ، وَأَسْتَغْفِرُكَ لِمَا تَعْلَمُ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  مُوسَى بْنُ مُطَيْرٍ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7408","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن موسى بن مطير الكوفي عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7415","7409  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدٍ ،  ثَنَا  نَائِلُ بْنُ نَجِيحٍ ،  نَا  إِسْمَاعِيلُ بْنُ زِيَادٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ يُلْبَسَ السِّلَاحُ فِي بِلَادِ الْإِسْلَامِ فِي الْعِيدَيْنِ  ، إِلَّا أَنْ يَكُونَ بِحَضْرَةِ عَدُوِّهِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  إِسْمَاعِيلُ بْنُ زِيَادٍ  ، وَلَا عَنْ  إِسْمَاعِيلَ  إِلَّا  نَائِلٌ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الْقُدُّوسِ  "" .","","Al-Mu'jam al-Awsat 7409","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن إسماعيل بن زياد السكوني عن نائل بن نجيح الحنفي عن عبد القدوس بن محمد الحبحابي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7416","7410  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  رَوْحُ بْنُ حَاتِمٍ أَبُو غَسَّانَ الْجُذُوعِيُّ ،  ثَنَا  الْمِنْهَالُ بْنُ بَحْرٍ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ الرُّبَيِّعِ ،  ثَنَا  أَبُو الزُّبَيْرِ ،         [7/249]      عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُوجِبَتَانِ : مَنْ مَاتَ لَا يُشْرِكُ بِاللهِ شَيْئًا دَخَلَ الْجَنَّةَ  ، وَمَنْ مَاتَ يُشْرِكُ بِهِ دَخَلَ النَّارَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الْعَزِيزِ بْنِ الرُّبَيِّعِ  إِلَّا  الْمِنْهَالُ بْنُ بَحْرٍ  "" .","","Al-Mu'jam al-Awsat 7410","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد العزيز بن الربيع الباهلي عن المنهال بن بحر القشيري عن روح بن حاتم البصري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7417","7411  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  رَوْحُ بْنُ حَاتِمٍ أَبُو غَسَّانَ ،  نَا  مُوسَى بْنُ مَسْعُودٍ أَبُو حُذَيْفَةَ ،  نَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَبِعْ  حَاضِرٌ  لِبَادٍ  ، وَمَنِ اشْتَرَى  مُصَرَّاةً  فَهُوَ بِخَيْرِ  النَّظَرَيْنِ ،  إِنْ شَاءَ رَدَّهَا وَرَدَّ مَعَهَا صَاعًا مِنْ تَمْرٍ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي نَجِيحٍ  إِلَّا  مُحَمَّدُ بْنُ مُسْلِمٍ  ، وَلَا عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ  إِلَّا  أَبُو حُذَيْفَةَ  ،  تَفَرَّدَ بِهِ  :  رَوْحُ بْنُ حَاتِمٍ  "" .","","Al-Mu'jam al-Awsat 7411","","أبو هريرة الدوسي عن مجاهد بن جبر المخزومي عن عبد الله بن أبي نجيح عن محمد بن مسلم بن سوسن الطائفي عن موسى بن مسعود النهدي عن روح بن حاتم البصري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7418","7412  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِبْرَاهِيمُ بْنُ بِسْطَامٍ الزَّعْفَرَانِيُّ ،  نَا  رَوْحُ بْنُ عُبَادَةَ ،  نَا  أَبُو عَامِرٍ الْخَزَّازُ ،  عَنْ  عَطَاءٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا  اسْتَجْمَرَ  أَحَدُكُمْ فَلْيُوتِرْ  ، فَإِنَّ اللهَ  وِتْرٌ  يُحِبُّ  الْوِتْرَ ،  أَمَا تَرَى السَّمَاوَاتِ سَبْعًا ، وَالْأَيَّامَ ، وَالْأَرَضِينَ سَبْعًا ، وَالطَّوَافَ ، وَالْجِمَارَ "" . وَذَكَرَ أَشْيَاءَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي عَامِرٍ الْخَزَّازِ  إِلَّا  رَوْحٌ  ،  تَفَرَّدَ بِهِ  :  إِبْرَاهِيمُ بْنُ بِسْطَامٍ  .","","Al-Mu'jam al-Awsat 7412","","أبو هريرة الدوسي عن عطاء بن أبي رباح عن صالح بن رستم الخزاز عن روح بن عبادة القيسي عن إبراهيم بن بسطام الزعفراني عن محمد بن أبان عن الطبراني","محمد بن أبان الأصبهاني"
"7419","7413  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ اللَّيْثِ أَبُو الصَّبَّاحِ الْهَدَادِيُّ ،  نَا  مُحَمَّدُ بْنُ عُمَرَ الرُّومِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ سَعِيدٍ أَبُو مُسْلِمٍ ، قَائِدُ الْأَعْمَشِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  زَيْدِ بْنِ وَهْبٍ ،  عَنْ  عَبْدِ اللهِ ، أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  "" سُعِّرَتِ  النَّارُ ، وَأُزْلِفَتِ الْجَنَّةُ يَا أَهْلَ الْحُجُرَاتِ  ، لَوْ تَعْلَمُونَ مَا أَعْلَمُ لَضَحِكْتُمْ قَلِيلًا وَلَبَكَيْتُمْ كَثِيرًا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا  أَبُو مُسْلِمٍ  ،  تَفَرَّدَ بِهِ  :  ابْنُ الرُّومِيِّ  "" .","","Al-Mu'jam al-Awsat 7413","","عبد الله بن مسعود عن زيد بن وهب الجهني عن الأعمش عن عبيد الله بن سعيد بن مسلم الجعفي عن محمد بن عمر بن عبد الله بن فيروز عن محمد بن الليث السرخسي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7420","[7/250]      7414  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ اللَّيْثِ أَبُو الصَّبَّاحِ الْهَدَادِيُّ ،  ثَنَا  أَبُو هَمَّامٍ الدَّلَّالُ ،  نَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا صَدَقَةٌ أَفْضَلُ مِنْ ذِكْرِ اللهِ  .","","Al-Mu'jam al-Awsat 7414","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن داود ابن النصراني عن محمد بن محبب الدلال عن محمد بن الليث السرخسي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7421","7415  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  نَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  نَا  الْحَرِيشُ بْنُ سُلَيْمٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اقْرَأِ الْقُرْآنَ فِي شَهْرٍ  قُلْتُ : إِنَّ لِي قُوَّةً قَالَ : "" فَاقْرَأْهُ فِي ثَلَاثٍ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ  إِلَّا  الْحَرِيشُ بْنُ سُلَيْمٍ  ، وَلَا عَنِ  الْحَرِيشِ  إِلَّا  أَبُو دَاوُدَ  ،  تَفَرَّدَ بِهِ  :  أَبُو حَفْصٍ  "" .","","Al-Mu'jam al-Awsat 7415","","عبد الله بن عمرو بن العاص عن خيثمة بن عبد الرحمن الجعفي عن طلحة بن مصرف الهمداني عن حريش بن سليم الجعفي عن أبو داود الطيالسي عن الفلاس عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7422","7416  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  نَا  عُمَرُ بْنُ أَبِي خَلِيفَةَ ،  حَدَّثَنِي  زِيَادُ بْنُ مِخْرَاقٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ :  بَعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُعَاذَ بْنَ جَبَلٍ  وَأَبَا مُوسَى  إِلَى  الْيَمَنِ  ، فَقَالَ :  تَسَانَدَا ، وَتَطَاوَعَا ، وَيَسِّرَا ، وَلَا تُنَفِّرَا  . فَخَطَبَ النَّاسَ  مُعَاذٌ  ، فَحَثَّهُمْ عَلَى الْإِسْلَامِ ، وَأَمَرَهُمْ بِالتَّفَقُّهِ وَالْقُرْآنِ ، وَقَالَ : "" أُخْبِرُكُمْ بِأَهْلِ الْجَنَّةِ وَأَهْلِ النَّارِ ، إِذَا ذُكِرَ الرَّجُلُ بِخَيْرٍ ، فَهُوَ مِنْ أَهْلِ الْجَنَّةِ ، وَإِذَا ذُكِرَ بِشَرٍّ ، فَهُوَ مِنْ أَهْلِ النَّارِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادِ بْنِ مِخْرَاقٍ  إِلَّا  عُمَرُ بْنُ أَبِي خَلِيفَةَ  "" .","","Al-Mu'jam al-Awsat 7416","","عبد الله بن عمر بن الخطاب عن زياد بن مخراق المزني عن عمر بن أبي خليفة العبدي عن الفلاس عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7423","7417  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  كَامِلٌ أَبُو الْعَلَاءِ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  زَاذَانَ ،         [7/251]      عَنِ  الْبَرَاءِ بْنِ عَازِبٍ قَالَ :  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي جِنَازَةٍ ، فَانْتَهَيْنَا إِلَى الْقَبْرِ وَلَمَّا يُلْحَدْ  ، فَجَلَسَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَجَلَسْنَا حَوْلَهُ - فَذَكَرَ حَدِيثَ عَذَابِ الْقَبْرِ .","","Al-Mu'jam al-Awsat 7417","","البراء بن عازب الأوسي عن زاذان الكندي عن المنهال بن عمرو الأسدي عن كامل بن العلاء التميمي عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7424","7418  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْحَاقُ بْنُ وَهْبٍ الْعَلَّافُ ،  نَا  عُمَرُ بْنُ يُونُسَ الْيَمَامِيُّ ،  نَا  سُلَيْمَانُ بْنُ أَبِي سُلَيْمَانَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  قَزَعَةَ بْنِ يَحْيَى ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ أَنْ تُسَافِرَ الْمَرْأَةُ مَعَ غَيْرِ ذِي رَحِمٍ  مَحْرَمٍ  ، فَوْقَ ثَلَاثَةِ أَيَّامٍ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  إِلَّا  سُلَيْمَانُ  ،  تَفَرَّدَ بِهِ  :  عُمَرُ بْنُ يُونُسَ  "" .","","Al-Mu'jam al-Awsat 7418","","أبو سعيد الخدري عن قزعة بن يحيى الحرشي عن يحيى بن أبي كثير عن سليمان بن أبي سليمان اليمامي عن عمر بن يونس بن القاسم عن إسحاق بن وهب العلاف عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7425","7419  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  رَوْحُ بْنُ حَاتِمٍ أَبُو غَسَّانَ ،  نَا  الْمِنْهَالُ بْنُ بَحْرٍ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ الرُّبَيِّعِ ،  ثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تُعْرَضُ الْأَعْمَالُ يَوْمَ الِاثْنَيْنِ وَالْخَمِيسِ  ، فَمِنْ مُسْتَغْفِرٍ فَيُغْفَرُ لَهُ ، وَمِنْ تَائِبٍ فَيُتَابُ عَلَيْهِ ، وَيُرَدُّ أَهْلُ الضَّغَائِنِ لِضَغَائِنِهِمْ حَتَّى يَتُوبُوا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الْعَزِيزِ بْنِ الرُّبَيِّعِ  إِلَّا  الْمِنْهَالُ بْنُ بَحْرٍ  "" .","","Al-Mu'jam al-Awsat 7419","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد العزيز بن الربيع الباهلي عن المنهال بن بحر القشيري عن روح بن حاتم البصري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7426","7420  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عَبَّادِ بْنِ آدَمَ ،  نَا  أَبِي  ،  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  جُبَيْرَ بْنَ مُطْعِمٍ ، يَقُولُ :  رَأَيْنَا  يَوْمَ حُنَيْنٍ  شَيْئًا أَسْوَدَ يَنْزِلُ بَيْنَ السَّمَاءِ وَالْأَرْضِ  ، فَوَقَعَ إِلَى الْأَرْضِ فَدَبَّ مِثْلَ  الذَّرِّ ،  وَهَزَمَ الْمُشْرِكِينَ ""  .","","Al-Mu'jam al-Awsat 7420","","جبير بن مطعم بن عدي النوفلي عن إسحاق بن يسار المازنى عن محمد بن إسحاق عن حماد بن سلمة عن عباد بن آدم الهذلي عن محمد بن عباد بن آدم الهذلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7427","[7/252]      7421  -  وَبِهِ  :  حَدَّثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَنَسِ بْنِ سِيرِينَ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِنْدَ حُجْرَةِ  عَائِشَةَ  يَدْعُو :  اللَّهُمَّ بَارِكْ لَنَا فِي مُدِّنَا ، وَبَارِكْ لَنَا فِي صَاعِنَا  ، وَبَارِكْ لَنَا فِي شَامِنَا وَيَمَنِنَا "" ، ثُمَّ اسْتَقْبَلَ الْمَشْرِقَ ، فَقَالَ : "" مِنْ هَاهُنَا يَخْرُجُ قَرْنُ الشَّيْطَانِ وَالزَّلَازِلُ وَالْفِتَنُ ، وَمِنْ هَاهُنَا الْفَدَّادُونَ "" .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  حَمَّادِ بْنِ سَلَمَةَ  إِلَّا  عَبَّادُ بْنُ آدَمَ  ،  تَفَرَّدَ بِهِمَا  : ابْنُهُ  "" .","","Al-Mu'jam al-Awsat 7421","","عبد الله بن عمر بن الخطاب عن أنس بن سيرين عن حماد بن سلمة عن عباد بن آدم الهذلي عن محمد بن عباد بن آدم الهذلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7428","7422  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ خَلَفِ بْنِ صَالِحٍ الْبَصْرِيُّ ،  ثَنَا  مُحْرِزُ بْنُ بَشَّارٍ ،  حَدَّثَنِي  صَالِحٌ الْمُرِّيُّ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَرْبَعُونَ  خُلُقًا  يُدْخِلُ اللهُ بِهَا الْجَنَّةَ  ، أَرْفَعُهَا  خُلُقًا  مَنِيحَةُ شَاةٍ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ حَسَّانَ  إِلَّا  صَالِحٌ الْمُرِّيُّ  "" .","","Al-Mu'jam al-Awsat 7422","","أبو هريرة الدوسي عن محمد بن سيرين عن هشام بن حسان العتكي عن صالح بن بشير المري عن محرز بن بشار عن محمد بن خلف التيمي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7429","7423  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عُمَرَ بْنِ حَرْبِ بْنِ سِنَانِ بْنِ جَبَلَةَ الْبَصْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ - غُنْدَرٌ - ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  أَبِي مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَبْعَثُ بِالْهَدْيِ ، فَيَفْتِلُ قَلَائِدَهَا  ، ثُمَّ لَا يُمْسِكُ عَنْ شَيْءٍ مِمَّا يُمْسِكُ عَنْهُ الْمُحْرِمُ  "" .         [7/253]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي مَعْشَرٍ  إِلَّا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ  "" .","","Al-Mu'jam al-Awsat 7423","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن زياد بن كليب عن سعيد بن أبي عروبة عن غندر ربيب شعبة عن محمد بن عمر بن حرب القرشي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7430","7424  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  نَا  إِسْرَائِيلُ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْلَا أَنْ  أَشُقَّ  عَلَى أُمَّتِي لَأَمَرْتُهُمْ بِالسِّوَاكِ  عِنْدَ كُلِّ صَلَاةٍ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْرَائِيلَ  إِلَّا  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7424","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن إسرائيل بن يونس بن أبي إسحاق عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7431","7425  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ أَبُو مَرْيَمَ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ،  عَنْ  هَانِئِ بْنِ هَانِئٍ ، وَهُبَيْرَةَ بْنِ يَرِيمَ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُوقِظُ أَهْلَهُ فِي الْعَشْرِ الْأَوَاخِرِ  مِنْ شَهْرِ رَمَضَانَ ، وَكُلَّ صَغِيرٍ وَكَبِيرٍ يُطِيقُ الصَّلَاةَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  ، عَنْ  هَانِئٍ  إِلَّا  أَبُو مَرْيَمَ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  . وَحَدِيثُ  هُبَيْرَةَ  عِنْدَ  الثَّوْرِيِّ  وَشُعْبَةَ  وَغَيْرِهِمَا "" .","","Al-Mu'jam al-Awsat 7425","","علي بن أبي طالب عن هانئ بن هانئ المرادي عن أبو إسحاق السبيعي عن عبد الغفار بن القاسم الأنصاري عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7432","7426  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ يَزِيدَ الْمُقْرِئُ ،  نَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كُلُّ صَلَاةٍ لَا يُقْرَأُ بِهَا بِفَاتِحَةِ الْكِتَابِ فَهِيَ  خِدَاجٌ  ، فَهِيَ  خِدَاجٌ  ، فَهِيَ  خِدَاجٌ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ  إِلَّا  ابْنُ لَهِيعَةَ  ،  تَفَرَّدَ بِهِ  :  ابْنُ الْمُقْرِئِ  ، عَنْ أَبِيهِ "" .","","Al-Mu'jam al-Awsat 7426","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمارة بن غزية عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن محمد بن أبي عبد الرحمن المكي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7433","7427  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ مُعَاوِيَةَ الْحَذَّاءُ ،  نَا  حَفْصُ بْنُ عُمَرَ التَّمَّارُ ،  نَا  مَنْصُورُ بْنُ أَبِي الْأَسْوَدِ ،  عَنْ  دِثَارٍ الْقَطَّانِ ،  عَنْ         [7/254]      أَبِي عَبْدِ الرَّحِيمِ الْكِنْدِيِّ ،  عَنْ  زَاذَانَ قَالَ :  سَمِعْتُ  عَلِيًّا ، يَقُولُ :  صَلَّيْتُ قَبْلَ النَّاسِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  دِثَارٍ الْقَطَّانِ  إِلَّا  مَنْصُورُ بْنُ أَبِي الْأَسْوَدِ  ،  تَفَرَّدَ بِهِ  :  حَفْصُ بْنُ عُمَرَ التَّمَّارُ  "" .","","Al-Mu'jam al-Awsat 7427","","علي بن أبي طالب عن زاذان الكندي عن أبو عبد الرحيم الكندي عن دثار بن أبي شبيب القطاني عن منصور بن أبي الأسود الليثي عن حفص بن عمر التمار عن محمد بن عبد الله بن معاوية الحذاء عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7434","7428  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  سُلَيْمَانُ الشَّاذَكُونِيُّ ،  نَا  دَاوُدُ بْنُ أَبِي سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  عِمْرَانَ بْنِ كَثِيرٍ ،  عَنْ  أَبِي زُرْعَةَ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بِحَسْبِكَ  مِنْ نِسَاءِ الْعَالَمِ أَرْبَعٌ  :  فَاطِمَةُ بِنْتُ مُحَمَّدٍ  ،  وَخَدِيجَةُ بِنْتُ خُوَيْلِدٍ  ،  وَمَرْيَمُ بِنْتُ عِمْرَانَ  ،  وَآسِيَةُ بِنْتُ مُزَاحِمٍ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ  إِلَّا  دَاوُدُ بْنُ أَبِي سُلَيْمَانَ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7428","","أبو هريرة الدوسي عن أبو زرعة بن عمرو بن جرير الغلابي عن عمران بن كثير عن محمد بن جحادة الأودي عن داود بن أبي سليمان عن الشاذكوني عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7435","7429  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  نَا  دَاوُدُ بْنُ أَبِي سُلَيْمَانَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ اللهَ لَمْ يَأْذَنْ كَأَذَنِهِ لِلْمُتَرَنِّمِ بِالْقُرْآنِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَلِيِّ بْنِ زَيْدٍ  إِلَّا  دَاوُدُ بْنُ أَبِي سُلَيْمَانَ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7429","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن علي بن زيد بن جدعان عن داود بن أبي سليمان عن الشاذكوني عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7436","7430  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  سُلَيْمَانُ الشَّاذَكُونِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  أَيُّوبُ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ حَلَفَ عَلَى يَمِينِ صَبْرٍ         [7/255]      مُتَعَمِّدًا فِيهَا  لِيَقْتَطِعَ  بِهَا مَالَ مُسْلِمٍ بِغَيْرِ حَقٍّ ، لَقِيَ اللهَ وَهُوَ عَلَيْهِ غَضْبَانُ "" .  لَمْ يَرْفَعْ هَذَا الْحَدِيثَ عَنْ  حَمَّادِ بْنِ زَيْدٍ  إِلَّا  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7430","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن حميد بن هلال العدوي عن أيوب السختياني عن حماد بن زيد عن الشاذكوني عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7437","7431  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  الشَّاذَكُونِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ الْحَرَّانِيُّ ،  ثَنَا  أَبُو عَبْدِ الرَّحِيمِ خَالِدُ بْنُ يَزِيدَ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ :  جَاءَ  رَجُلٌ ضَرِيرٌ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنِّي أَسْمَعُ  النِّدَاءَ  ، فَلَعَلِّي لَا أَجِدُ قَائِدًا وَيَشُقُّ عَلَيَّ ، أَفَأَتَّخِذُ مَسْجِدًا فِي دَارِي ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَيَبْلُغُكَ  النِّدَاءُ  ؟ "" قَالَ : نَعَمْ ، قَالَ :  فَإِذَا سَمِعْتَ  النِّدَاءَ  فَأَجِبْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَدِيِّ بْنِ ثَابِتٍ  إِلَّا  زَيْدُ بْنُ أَبِي أُنَيْسَةَ  "" .","","Al-Mu'jam al-Awsat 7431","","كعب بن عجرة عن عبد الرحمن بن أبي ليلى عن عدي بن ثابت الظفري عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن الشاذكوني عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7438","7432  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  حُمَيْدُ بْنُ مَسْعَدَةَ ،  ثَنَا  يُونُسُ بْنُ أَرْقَمَ ،  ثَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كُنَّا نَنْبِذُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  جَرٍّ  أَخْضَرَ  .  لَمْ يُدْخِلْ بَيْنَ  الْحَسَنِ بْنِ صَالِحٍ  ،  وَحَكِيمِ بْنِ جُبَيْرٍ  :  إِبْرَاهِيمَ بْنَ مُهَاجِرٍ  أَحَدٌ مِمَّنْ رَوَى هَذَا الْحَدِيثَ عَنِ  الْحَسَنِ بْنِ صَالِحٍ  إِلَّا  يُونُسُ بْنُ أَرْقَمَ  ،  تَفَرَّدَ بِهِ  :  حُمَيْدُ بْنُ مَسْعَدَةَ  "" .","","Al-Mu'jam al-Awsat 7432","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن حكيم بن جبير الأسدي عن إبراهيم بن مهاجر بن جابر البجلي عن الحسن بن صالح بن صالح بن حي عن يونس بن أرقم الكندي عن حميد السامي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7439","7433  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  مُحَمَّدُ بْنُ يَزِيدَ الْأَسْفَاطِيُّ ،  نَا  أَبُو يَزِيدَ الْكُوفِيُّ بِشْرُ بْنُ عَبْدِ الْمَلِكِ ،  ثَنَا  مُحَمَّدُ بْنُ سَوَاءٍ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْقَاسِمِ بْنِ عَوْفٍ الشَّيْبَانِيِّ ،         [7/256]      عَنْ  زَيْدِ بْنِ أَرْقَمَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَمْنَعُ الْمَرْأَةُ زَوْجَهَا نَفْسَهَا  ، وَإِنْ كَانَتْ عَلَى  قَتَبٍ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ  ، وَلَا عَنْ  سَعِيدٍ  إِلَّا  مُحَمَّدُ بْنُ سَوَاءٍ  ،  تَفَرَّدَ بِهِ  :  الْأَسْفَاطِيُّ  ، عَنْ  بِشْرِ بْنِ عَبْدِ الْمَلِكِ  "" .","","Al-Mu'jam al-Awsat 7433","","زيد بن أرقم الأنصاري عن القاسم بن عوف الشيباني عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن سواء السدوسي عن بشر بن عبد الملك الكوفي عن محمد بن يزيد بن عبد الملك الأسفاطي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7440","7434  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  يَحْيَى بْنُ الْفَضْلِ الْخُرْقِي ،  ثَنَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ بُدَيْلِ بْنِ وَرْقَاءَ الْحَرَّانِيُّ  ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  مَا خُيِّرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ أَمْرَيْنِ إِلَّا اخْتَارَ أَيْسَرَهُمَا  ، مَا لَمْ تَكُنْ فِيهِ مَعْصِيَةٌ ، فَإِذَا كَانَ مَعْصِيَةً فَهُوَ أَبْعَدُ النَّاسِ مِنْهُ "" .  كذا في طبعة دار الحرمين ، ولعل الصواب : (الخزاعي) كما في مصادر ترجمته في كتب التراجم.","","Al-Mu'jam al-Awsat 7434","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن عبد الله بن بديل بن ورقاء الخزاعي عن أبو عامر العقدي عن يحيى بن الفضل بن يحيى عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7441","7435  - =  وَبِهِ  :  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  يَا رَسُولَ اللهِ ، إِنَّ  أَفْلَحَ  اسْتَأْذَنَ عَلَيَّ ، وَإِنَّمَا أَرْضَعَتْنِي  امْرَأَةُ أَخِيهِ  ؟ فَقَالَ :  ائْذَنِي لَهُ ، فَإِنَّهُ عَمُّكِ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنِ  الزُّهْرِيِّ  ، عَنْ  أَبِي سَلَمَةَ  ، عَنْ  عَائِشَةَ  إِلَّا  عَبْدُ اللهِ بْنُ بُدَيْلٍ  ،  تَفَرَّدَ بِهِمَا  :  أَبُو عَامِرٍ الْعَقَدِيُّ  .  "" وَرَوَاهُمَا أَصْحَابُ  الزُّهْرِيِّ  ، عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ  .","","Al-Mu'jam al-Awsat 7435","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن عبد الله بن بديل بن ورقاء الخزاعي عن أبو عامر العقدي عن يحيى بن الفضل بن يحيى عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7442","7436  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  يَحْيَى بْنُ الْفَضْلِ الْخُرْقِي ،  نَا  أَبُو عَامِرٍ الْعَقَدِيُّ ،  أَخْبَرَنِي  عَدِيُّ بْنُ الْفَضْلِ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا  تَغَوَّلَتْ  لَكُمُ الْغُولُ فَنَادُوا بِالْأَذَانِ  ، فَإِنَّ الشَّيْطَانَ إِذَا سَمِعَ  النِّدَاءَ  أَدْبَرَ وَلَهُ  حُصَاصٌ  "" .         [7/257]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ  إِلَّا  عَدِيُّ بْنُ الْفَضْلِ  ،  تَفَرَّدَ بِهِ  :  أَبُو عَامِرٍ  "" .","","Al-Mu'jam al-Awsat 7436","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن عدي بن الفضل التيمي عن أبو عامر العقدي عن يحيى بن الفضل بن يحيى عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7443","7437  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  عَبْدُ اللهِ بْنُ عَبْدِ الْمُؤْمِنِ الْوَاسِطِيُّ ،  ثَنَا  عَتَّابُ بْنُ حَرْبٍ ،  عَنْ  صَالِحِ بْنِ رُسْتُمَ أَبِي عَامِرٍ الْخَزَّازِ ،  عَنِ  الْحَسَنِ ،  عَنْ  مَعْقِلِ بْنِ يَسَارٍ قَالَ :  "" كُنْتُ رَافِعًا عَنْ رَأْسِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ غُصْنًا مِنْ أَغْصَانِ الشَّجَرَةِ وَهُوَ  يُبَايِعُ  النَّاسَ ،  فَلَمْ  يُبَايِعْهُمْ  عَلَى الْمَوْتِ ، بَايَعَهُمْ عَلَى أَنْ لَا يَفِرُّوا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي عَامِرٍ الْخَزَّازِ  إِلَّا  عَتَّابٌ  "" .","","Al-Mu'jam al-Awsat 7437","","معقل بن يسار المزني عن الحسن البصري عن صالح بن رستم الخزاز عن عتاب بن حرب المديني عن عبد الله بن عبد المؤمن بن عثمان الأرحبي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7444","7438  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمَيِّتَ لَيَعْلَمُ مَنْ يُغَسِّلُهُ  ، وَمَنْ يُكَفِّنُهُ ، وَمَنْ يُدَلِّيهِ فِي حُفْرَتِهِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  فُضَيْلِ بْنِ مَرْزُوقٍ  إِلَّا  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7438","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7445","7439  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الْجُذُوعِيُّ ،  ثَنَا  عَامِرُ بْنُ مُدْرِكٍ ،  ثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُعْطِيتُ خَمْسًا لَمْ يُعْطَهَا نَبِيٌّ قَبْلِي : بُعِثْتُ إِلَى  الْأَحْمَرِ  وَالْأَسْوَدِ  ، وَإِنَّمَا كَانَ النَّبِيُّ يُبْعَثُ إِلَى قَوْمِهِ ، وَنُصِرْتُ  بِالرُّعْبِ  مَسِيرَةَ  شَهْرٍ ، وَأُطْعِمْتُ الْمَغْنَمَ ، وَلَمْ يُطْعَمْهُ أَحَدٌ كَانَ قَبْلِي ، وَجُعِلَتْ لِيَ الْأَرْضُ مَسْجِدًا وَطَهُورًا ، وَلَيْسَ مِنْ نَبِيٍّ إِلَّا وَقَدْ أُعْطِيَ دَعْوَةً فَتَعَجَّلَهَا ، وَإِنِّي أَخَّرْتُ دَعْوَتِي شَفَاعَةً لِأُمَّتِي ، وَهِيَ بَالِغَةٌ - إِنْ شَاءَ اللهُ - مَنْ مَاتَ لَا يُشْرِكُ بِاللهِ شَيْئًا  "" .         [7/258]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  فُضَيْلٍ  إِلَّا  عَامِرُ بْنُ مُدْرِكٍ  "" .","","Al-Mu'jam al-Awsat 7439","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن عامر بن مدرك بن أبي الصفيراء الحارثي عن إبراهيم بن سويد الجذوعي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7446","7440  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبَادَةَ الْوَاسِطِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْعَزِيزِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ وَسَعِيدِ بْنِ الْمُسَيِّبِ ، وَعَبْدِ اللهِ بْنِ وَهْبِ بْنِ زَمْعَةَ ، يَزِيدُ بَعْضُهُمْ عَلَى بَعْضٍ  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ لِلْمُسْلِمِينَ  بِمَكَّةَ  حِينَ شَطَّتْ بِهِمْ عَشَائِرُهُمْ :  تَفَرَّقُوا فِي الْأَرْضِ  ، فَتَفَرَّقُوا إِلَى أَرْضٍ  الْحَبَشَةِ  ، فَبَعَثَتْ  قُرَيْشٌ  عَبْدَ اللهِ بْنَ أَبِي رَبِيعَةَ  ،  وَعَمْرَو بْنَ الْعَاصِ  ، فَكَانَ مِمَّا قَالَ  عَمْرٌو  وَعَبْدُ اللهِ  لِلنَّجَاشِيِّ  : إِنَّهُمْ لَا يُحَيُّونَكَ بِالتَّحِيَّةِ الَّتِي يُحَيِّيكَ بِهَا مَنْ دَخَلَ عَلَيْكَ مِنَّا ، فَقَالَ  لِجَعْفَرٍ  ، وَأَصْحَابِهِ : مَا لَكُمْ لَا تُحَيُّونِي كَمَا يُحَيِّي أَصْحَابُكُمْ ؟ قَالُوا : "" نُحَيِّيكَ بِتَحِيَّةِ نَبِيِّنَا صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : السَّلَامُ ، أَخْبَرَنَا نَبِيُّنَا صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهَا تَحِيَّةُ أَهْلِ الْجَنَّةِ  ""  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  ، عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  ،  وَعَبْدِ اللهِ بْنِ وَهْبِ بْنِ زَمْعَةَ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْعَزِيزِ الْأُمَامِيُّ  - مِنْ وَلَدِ  أَبِي أُمَامَةَ بْنِ سَهْلِ بْنِ حُنَيْفٍ الْأَنْصَارِيِّ  - ، وَلَا رَوَاهُ عَنْهُ إِلَّا  إِسْحَاقُ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ  "" .  وَرَوَاهُ  مُحَمَّدُ بْنُ إِسْحَاقَ  : عَنِ  الزُّهْرِيِّ  ، عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ  وَحْدَهُ .","","Al-Mu'jam al-Awsat 7440","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن وهب بن زمعة الغنمي عن الزهري عن عبد الرحمن بن عبد العزيز الأوسي عن إسحاق بن جعفر بن محمد الجعفري الحزين عن يعقوب بن محمد بن عيسى عن محمد بن عبادة بن البخترى الأسدي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7447","7441  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  أَيُّوبُ بْنُ حَسَّانَ الْوَاسِطِيُّ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ الْجَبُّلِيُّ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَخْطُبُ إِلَى خَشَبَةٍ  ، فَلَمَّا اتَّخَذَ الْمِنْبَرَ ذَهَبَ لِيَصْعَدَ ، فَحَنَّتِ الْخَشَبَةُ ، فَنَزَلَ فَمَسَّهَا ، فَسَكَنَتْ  "" .         [7/259]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَسَنِ  إِلَّا  جَرِيرُ بْنُ حَازِمٍ  ، وَلَا عَنْ  جَرِيرٍ  إِلَّا  مُوسَى بْنُ إِسْمَاعِيلَ  "" .","","Al-Mu'jam al-Awsat 7441","","أنس بن مالك عن الحسن البصري عن جرير بن حازم عن موسى بن إسماعيل الجبلي عن أيوب بن حسان الدقاق عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7448","7442  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  نَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ ،  عَنْ  سُلَيْمَانَ بْنِ صُرَدٍ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْتَاكُوا ، وَتَنَظَّفُوا ،  وَأَوْتِرُوا  ، فَإِنَّ اللهَ  وِتْرٌ  يُحِبُّ  الْوِتْرَ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَسَنِ بْنِ صَالِحٍ  إِلَّا  إِسْمَاعِيلُ بْنُ عَمْرٍو  ، وَلَا يُرْوَى عَنْ  سُلَيْمَانَ بْنِ صُرَدٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7442","","سليمان بن صرد الخزاعي عن موسى بن أبي عائشة المخزومي عن الحسن بن صالح بن صالح بن حي عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7449","7443  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ خَلَّادٍ الْوَاسِطِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  نَا  أَبُو الْمِقْدَامِ هِشَامُ بْنُ زِيَادٍ قَالَ :  سَمِعْتُ  مُوسَى بْنَ أَنَسٍ  يُحَدِّثُ ، عَنْ  أَنَسٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ كَانَ فِي نَفْسِهِ مَوَدَّةٌ لِأَخِيهِ ، فَلْيُعْلِمْهُ ذَلِكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُوسَى بْنِ أَنَسٍ  إِلَّا  هِشَامُ بْنُ زِيَادٍ  "" .","","Al-Mu'jam al-Awsat 7443","","أنس بن مالك عن موسى بن أنس بن مالك الأنصاري عن هشام بن زياد بن أبي يزيد العثماني عن يزيد بن هارون عن عبد الله بن محمد بن خلاد العراقي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7450","7444  - =  وَبِهِ  :  حَدَّثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  بَحْرٌ السَّقَّاءُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُوا جَمِيعًا وَلَا تَفَرَّقُوا  ، فَإِنَّ  طَعَامَ  الْوَاحِدِ يَكْفِي الِاثْنَيْنِ ، وَطَعَامَ الِاثْنَيْنِ يَكْفِي الْأَرْبَعَةَ ، اللَّهُمَّ بَارِكْ  لِأَهْلِ الْمَدِينَةِ  فِي صَاعِهِمْ ، وَبَارِكْ لَهُمْ فِي مُدِّهِمْ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمْرِو بْنِ دِينَارٍ  إِلَّا  بَحْرٌ السَّقَّاءُ  ،  تَفَرَّدَ بِهِ  :  يَزِيدُ بْنُ هَارُونَ  "" .","","Al-Mu'jam al-Awsat 7444","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن بحر بن كنيز السقاء عن يزيد بن هارون عن عبد الله بن محمد بن خلاد العراقي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7451","[7/260]      7445  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدٍ ،  نَا  مُوسَى بْنُ دَاوُدَ ،  ثَنَا  مُسْلِمُ بْنُ خَالِدٍ الزَّنْجِيُّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَقَّتَ  لِأَهْلِ الْمَشْرِقِ  الْعَقِيقَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  مُسْلِمٌ  ،  تَفَرَّدَ بِهِ  :  مُوسَى بْنُ دَاوُدَ  "" .","","Al-Mu'jam al-Awsat 7445","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن ابن جريج عن مسلم بن خالد الزنجي عن موسى بن داود الخلقاني عن عبيد الله بن سعد بن إبراهيم الزهري عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7452","7446  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  عَلِيُّ بْنُ حَسَّانَ الْعَطَّارُ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  ثَنَا  قُرَّةُ بْنُ خَالِدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ كَثِيرٍ ،  عَنْ  عَاصِمِ بْنِ لَقِيطِ بْنِ صَبِرَةَ ،  عَنْ  أَبِيهِ - وَافِدِ بَنِي الْمُنْتَفِقِ  - ،  أَنَّهُ أَتَى  عَائِشَةَ  هُوَ  وَصَاحِبٌ لَهُ  يَطْلُبَانِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَجِدَاهُ ، فَأَطْعَمَتْنَا  عَائِشَةُ  غَدَاءً تَمْرًا  وَعَصِيدَةً  ، فَلَمْ يَلْبَثْ أَنْ جَاءَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَتَقَلَّعُ يَتَكَفَّأُ قَالَ : "" طَعِمْتُمَا ؟ "" قُلْنَا : نَعَمْ ، قُلْتُ : يَا رَسُولَ اللهِ ، الصَّلَاةَ ؟ قَالَ :  أَسْبِغِ الْوُضُوءَ ، وَخَلِّلِ الْأَصَابِعَ ، وَبَالِغْ فِي الِاسْتِنْشَاقِ إِلَّا أَنْ تَكُونَ صَائِمًا  .  قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ لِي  امْرَأَةً  - وَذَكَرَ مِنْ  بَذَائِهَا  - قَالَ : "" طَلِّقْهَا "" قُلْتُ : إِنَّهَا ذَاتُ صُحْبَةٍ وَوَلَدٍ ؟ قَالَ : "" فَعِظْهَا إِنْ يَكُنْ فِيهَا خَيْرٌ فَسَتَفْعَلُ ، وَلَا تَضْرِبْ ظَعِينَتَكَ ضَرْبَكَ أَمَتَكَ "" ، فَبَيْنَا نَحْنُ كَذَلِكَ إِذْ رَفَعَ  رَاعِي الْغَنَمِ  عَلَى يَدَيْهِ فِي  الْمُرَاحِ  سَخْلَةً قَالَ : "" أَوَلَدَتْ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" مَاذَا ؟ "" قَالَ :  بَهْمَةً  . قَالَ : "" اذْبَحْ مَكَانَهَا شَاةً "" ، ثُمَّ أَقْبَلَ عَلَيَّ ، فَقَالَ : "" لَا تَحْسِبَنَّ - وَلَمْ يَقُلْ : لَا تَحْسَبَنَّ - أَنَّا إِنَّمَا ذَبَحْنَاهَا مِنْ أَجْلِكَ ، إِنَّ لَنَا غَنَمًا مِائَةً ، لَا نُحِبُّ أَنْ تَزِيدَ عَلَيْهَا ، إِذَا وَلَّدَ الرَّاعِي  بَهْمَةً  أَمَرْنَاهُ فَذَبَحَ مَكَانَهَا شَاةً "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قُرَّةَ بْنِ خَالِدٍ  إِلَّا  يَحْيَى بْنُ سَعِيدٍ  .  تَفَرَّدَ بِهِ  :  عَلِيُّ بْنُ         [7/261]      حَسَّانَ  .  فَإِنْ كَانَ  عَلِيُّ بْنُ حَسَّانَ  حَفِظَهُ فَهُوَ  غَرِيبٌ  مِنْ حَدِيثِ  قُرَّةَ بْنِ خَالِدٍ ؛  لِأَنَّ غَيْرَ  عَلِيِّ بْنِ حَسَّانَ  "" رَوَاهُ عَنْ  يَحْيَى بْنِ سَعِيدٍ  ، عَنِ  ابْنِ جُرَيْجٍ  ، عَنْ  إِسْمَاعِيلَ بْنِ كَثِيرٍ  .","","Al-Mu'jam al-Awsat 7446","","لقيط بن صبرة العقيلي عن عاصم بن لقيط بن صبرة الطائفي عن إسماعيل بن كثير التبالي عن قرة بن خالد السدوسي عن يحيى القطان عن علي بن حسان العطار عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7453","7447  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  كُنَّا نَأْكُلُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَنَسْمَعُ تَسْبِيحَ الطَّعَامِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَنْصُورٍ  إِلَّا  إِسْرَائِيلُ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7447","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن منصور بن المعتمر عن إسرائيل بن يونس بن أبي إسحاق عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7454","7448  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  نَا  أَبُو شِهَابٍ ،  عَنْ  حَبِيبِ بْنِ الشَّهِيدِ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُعَاذِ بْنِ جَبَلٍ ،  أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِدَابَّةٍ يَرْكَبُهَا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الرَّجُلُ أَحَقُّ بِصَدْرِ دَابَّتِهِ  ، فَقَالَ : يَا رَسُولَ اللهِ ، هِيَ لَكَ ، فَرَكِبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَرْدَفَ  مُعَاذًا  خَلْفَهُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حَبِيبِ بْنِ الشَّهِيدِ  ، إِلَّا  أَبُو شِهَابٍ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ  "" .","","Al-Mu'jam al-Awsat 7448","","معاذ بن جبل عن بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن حبيب بن الشهيد عن عبد ربه بن نافع الحناط عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7455","7449  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  رِبْعِيِّ بْنِ حِرَاشٍ ،  عَنْ  أَبِي مَسْعُودٍ الْأَنْصَارِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِمَّا أَدْرَكَ النَّاسُ مِنَ النُّبُوَّةِ  : إِذَا لَمْ  تَسْتَحْيِ  فَاصْنَعْ  مَا شِئْتَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُغِيرَةَ  إِلَّا  جَرِيرٌ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7449","","أبو مسعود البدري عن ربعي بن حراش العبسي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7456","[7/262]      7450  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو ،  ثَنَا  هُشَيْمٌ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي مَرْيَمَ قَالَ :  سَمِعْتُ  أَبَا أُمَامَةَ الْبَاهِلِيَّ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ  فَرَضَ  عَلَيْكُمْ صَوْمَ رَمَضَانَ  ، وَلَمْ يَفْرِضْ عَلَيْكُمْ قِيَامَهُ ، وَإِنَّمَا قِيَامُهُ شَيْءٌ أَحْدَثْتُمُوهُ فَدُومُوا عَلَيْهِ ، فَإِنَّ نَاسًا مِنْ  بَنِي إِسْرَائِيلَ  ابْتَدَعُوا بِدْعَةً فَعَابَهُمُ اللهُ بِتَرْكِهَا ، وَقَالَ :         {      وَرَهْبَانِيَّةً ابْتَدَعُوهَا مَا كَتَبْنَاهَا عَلَيْهِمْ إِلا ابْتِغَاءَ رِضْوَانِ اللهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا         }      - إِلَى آخِرِ الْآيَةِ .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي أُمَامَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  تَفَرَّدَ بِهِ  إِسْمَاعِيلُ بْنُ عَمْرٍو  .","","Al-Mu'jam al-Awsat 7450","","أبو أمامة الباهلي عن زكريا بن أبي مريم الخزاعي عن هشيم بن بشير عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7457","7451  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو ،  نَا  زُهَيْرٌ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا حَضَرَ الطَّعَامُ وَأُقِيمَتِ الصَّلَاةُ  ، فَابْدَءُوا بِالطَّعَامِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ  إِلَّا  زُهَيْرٌ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7451","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن زهير بن معاوية بن حديج عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7458","7452  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو ،  نَا  مِنْدَلٌ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا عَطَسَ  خَمَّرَ  وَجْهَهُ  ، وَخَفَضَ صَوْتَهُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  مِنْدَلٌ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7452","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن ابن جريج عن مندل بن علي عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7459","7453  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو ،  نَا  زَائِدَةُ ،  عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  حُصَيْنِ بْنِ قَبِيصَةَ ،  عَنْ  عَلِيٍّ قَالَ :  كُنْتُ رَجُلًا  مَذَّاءً ،  فَسَأَلْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  إِذَا رَأَيْتَ الْمَذْيَ فَاغْسِلْ ذَكَرَكَ وَتَوَضَّأْ  ، وَإِذَا رَأَيْتَ الْمَاءَ الدَّافِقَ فَاغْتَسِلْ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ  إِلَّا  زَائِدَةُ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ         [7/263]      بْنُ عَمْرٍو  "" وَرَوَاهُ غَيْرُ  إِسْمَاعِيلَ  ، عَنْ  زَائِدَةَ  ، عَنْ  أَبِي حَصِينٍ  ، عَنْ  حُصَيْنِ بْنِ قَبِيصَةَ  .","","Al-Mu'jam al-Awsat 7453","","علي بن أبي طالب عن حصين بن قبيصة الفزاري عن حصين بن عبد الرحمن السلمي عن زائدة بن قدامة عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7460","7454  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْمَاعِيلُ ،  نَا  أَبُو بَكْرٍ النَّهْشَلِيُّ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنِ  ابْنِ مَسْعُودٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِالنَّاسِ خَمْسًا ، قَالُوا :  يَا رَسُولَ اللهِ ، أَزِيدَ فِي الصَّلَاةِ ؟ قَالَ : "" لِمَ ذَلِكَ ؟  قَالُوا : صَلَّيْتَ خَمْسًا ، فَسَجَدَ سَجْدَتَيْنِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَكَمِ  ، عَنْ  إِبْرَاهِيمَ  ، عَنِ  الْأَسْوَدِ  إِلَّا  أَبُو بَكْرٍ النَّهْشَلِيُّ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .  وَرَوَاهُ  أَبُو نُعَيْمٍ  وَالنَّاسُ ، عَنْ  أَبِي بَكْرٍ النَّهْشَلِيِّ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ  ، عَنْ أَبِيهِ .  وَرَوَاهُ  أَبُو عَتَّابٍ الدَّلَّالُ  ،  وَأَبُو غَسَّانَ  ، عَنْ  أَبِي بَكْرٍ النَّهْشَلِيِّ  ، عَنِ  الْهَيْثَمِ  ، عَنِ  الْحَكَمِ  ، عَنْ  إِبْرَاهِيمَ  ، عَنْ  عَلْقَمَةَ  ، عَنْ  عَبْدِ اللهِ  .","","Al-Mu'jam al-Awsat 7454","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الحكم بن عتيبة الكندي عن أبو بكر النهشلي عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7461","7455  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  مُعَاذِ بْنِ جَبَلٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمَّا هَبَطَ  آدَمُ  إِلَى الْأَرْضِ بَكَى عَلَى الْجَنَّةِ مِائَةَ  خَرِيفٍ  ، ثُمَّ نَظَرَ إِلَى سَعَةِ الْأَرْضِ ، فَقَالَ : أَيْ رَبِّ ، أَمَا لِأَرْضِكَ عَامِرٌ يَسْكُنُهَا غَيْرِي ، فَأَوْحَى اللهُ إِلَيْهِ : أَنْ بَلَى ، إِنَّهَا سَتَرْتَفِعُ بُيُوتٌ يُذْكَرُ فِيهَا اسْمِي ، وَسَأُبَوِّئُكَ مِنْهَا بَيْتًا أَخْتَصُّهُ بِكَرَامَتِي ، وَأُحَلِّلُهُ عَظَمَتِي ، وَأُسَمِّيهِ بَيْتِي ،         [7/264]      أُنْطِقُهُ بِعَظَمَتِي ، وَلَسْتُ أَسْكُنُهُ ، وَلَيْسَ يَنْبَغِي لِي أَنْ أَسْكُنَ الْبُيُوتَ وَلَا تَسَعُنِي ، وَلَكِنِّي عَلَى عَرْشِي وَكُرْسِيِّ عَظَمَتِي ، وَلَيْسَ يَنْبَغِي لِشَيْءٍ مِمَّا خَلَقْتُ أَنْ يَخْرُجَ مِنْ قَبْضَتِي ، وَلَا مِنْ قُدْرَتِي ، وَتَعْمُرُهُ يَا  آدَمُ  مَا كُنْتَ حَيًّا ، ثُمَّ تَعْمُرُهُ  الْقُرُونُ  مِنْ بَعْدِكَ أُمَّةً بَعْدَ أُمَّةٍ ، قَرْنًا بَعْدَ قَرْنٍ ، حَتَّى يَنْتَهِيَ إِلَى وَلَدٍ مِنْ أَوْلَادِكَ ، يُقَالُ لَهُ :  إِبْرَاهِيمُ  أَجْعَلُهُ مِنْ عُمَّارِهِ وَسُكَّانِهِ "" .  لَمْ يُرْوَ هَذَا الْحَدِيثُ عَنْ  مُعَاذِ بْنِ جَبَلٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7455","","معاذ بن جبل عن خالد بن معدان عن ثور بن يزيد الكلاعي عن إسماعيل بن عياش الأحول عن إسماعيل بن عمرو البجلي عن محمد بن أبان الأصبهاني عن الطبراني","محمد بن أبان الأصبهاني"
"7462","7456  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْوَشَّاءُ الْأَصْبَهَانِيُّ ،  ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا جُعِلَ الْإِمَامُ لِيُؤْتَمَّ بِهِ  ، فَإِذَا كَبَّرَ فَكَبِّرُوا ، وَإِذَا رَكَعَ فَارْكَعُوا ، وَإِذَا قَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، فَقُولُوا : اللَّهُمَّ رَبَّنَا وَلَكَ الْحَمْدُ ، وَإِذَا سَجَدَ فَاسْجُدُوا ، وَإِذَا صَلَّى قَاعِدًا فَصَلُّوا قُعُودًا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ  إِلَّا  عَبْدُ اللهِ بْنُ رَجَاءٍ الْمَكِّيُّ  ،  تَفَرَّدَ بِهِ  :  زَيْدُ بْنُ الْحَرِيشِ  "" .","","Al-Mu'jam al-Awsat 7456","","أبو هريرة الدوسي عن سعيد المقبري عن عبد الله بن عمر العمري عن عبد الله بن رجاء البصري عن زيد بن الحريش الأهوزاي عن محمد بن إبراهيم بن سعيد الوشاء عن الطبراني","محمد بن إبراهيم الوشاء الأصبهاني"
"7463","7457  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْوَشَّاءُ ،  نَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  مُحَمَّدُ بْنُ الزِّبْرِقَانِ ،  عَنْ  هُدْبَةَ بْنِ الْمِنْهَالِ ،  عَنْ  قَابُوسِ بْنِ أَبِي ظِبْيَانَ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ أَرْسَلَ إِلَى عَائِشَةَ ، فَسَأَلَهَا عَنْ صَلَاةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟  فَقَالَتْ :  كَانَ يُصَلِّي وَيَدَعُ ، وَلَكِنْ لَمْ أَرَهُ تَرَكَ الرَّكْعَتَيْنِ قَبْلَ صَلَاةِ الْفَجْرِ  ، فِي سَفَرٍ وَلَا حَضَرٍ ، وَلَا صِحَّةٍ وَلَا سُقْمٍ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هُدْبَةَ بْنِ الْمِنْهَالِ  إِلَّا  أَبُو هَمَّامٍ  "" .","","Al-Mu'jam al-Awsat 7457","","عائشة بنت أبي بكر الصديق عن حصين بن جندب الجنبي عن قابوس بن أبي ظبيان عن هدبة بن المنهال الأهوازي عن محمد بن الزبرقان الأهوازي عن زيد بن الحريش الأهوزاي عن محمد بن إبراهيم بن سعيد الوشاء عن الطبراني","محمد بن إبراهيم الوشاء الأصبهاني"
"7464","7458  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْوَشَّاءُ ،  نَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  مُحَمَّدُ بْنُ         [7/265]      الْفُضَيْلِ ،  عَنْ  رِشْدِينَ بْنِ كُرَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَا  ابْنَ عَبَّاسٍ  ، رَكْعَتَيْنِ قَبْلَ صَلَاةِ الْغَدَاةِ  : إِدْبَارَ النُّجُومِ ، وَرَكْعَتَيْنِ بَعْدَ الْمَغْرِبِ : أَدْبَارَ السُّجُودِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  رِشْدِينَ بْنِ كُرَيْبٍ  إِلَّا  مُحَمَّدُ بْنُ فُضَيْلٍ  "" .","","Al-Mu'jam al-Awsat 7458","","عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن رشدين بن كريب عن محمد بن فضيل بن غزوان عن زيد بن الحريش الأهوزاي عن محمد بن إبراهيم بن سعيد الوشاء عن الطبراني","محمد بن إبراهيم الوشاء الأصبهاني"
"7465","7459  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْوَشَّاءُ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيعٍ ،  ثَنَا  فُضَيْلُ بْنُ سُلَيْمَانَ ،  نَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ قَالَ :  سَمِعْتُ  أَيُّوبَ بْنَ جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ،  يُحَدِّثُ ، عَنْ  أَبِيهِ جَرِيرٍ  قَالَ :  سَأَلْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمَسْحِ عَلَى الْخُفَّيْنِ ؟ فَقَالَ :  ثَلَاثٌ لِلْمُسَافِرِ ، وَيَوْمٌ وَلَيْلَةٌ لِلْمُقِيمِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَيُّوبَ بْنِ جَرِيرٍ  إِلَّا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ  "" .","","Al-Mu'jam al-Awsat 7459","","جرير بن عبد الله بن جابر يوسف الأمة عن أيوب بن جرير البجلي عن عبد الحميد بن جعفر الأوسي عن فضيل بن سليمان النميري عن محمد بن عبد الله بن بزيع البصري عن محمد بن إبراهيم بن سعيد الوشاء عن الطبراني","محمد بن إبراهيم الوشاء الأصبهاني"
"7466","7460  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْوَشَّاءُ ،  نَا  طَالُوتُ بْنُ عَبَّادٍ ،  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  وَرَّادٍ ، مَوْلَى الْمُغِيرَةِ  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِيَّاكُمْ وَقِيلَ وَقَالَ ، وَمَنْعًا وَهَاتِ  ،  وَعُقُوقَ  الْأُمَّهَاتِ ،  وَوَأْدَ  الْبَنَاتِ ، وَإِضَاعَةَ الْمَالِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءِ بْنِ السَّائِبِ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  "" .","","Al-Mu'jam al-Awsat 7460","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن عطاء بن السائب عن حماد بن سلمة عن طالوت بن عباد الجحدري عن محمد بن إبراهيم بن سعيد الوشاء عن الطبراني","محمد بن إبراهيم الوشاء الأصبهاني"
"7467","7461  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْوَشَّاءُ ،  ثَنَا  أَبُو الْأَشْعَثِ أَحْمَدُ بْنُ الْمِقْدَامِ ،  نَا  أَصْرَمُ بْنُ حَوْشَبٍ ،  نَا  قُرَّةُ بْنُ خَالِدٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنْ  طَاوُسٍ قَالَ :  سَمِعْتُ  أَبَا الدَّرْدَاءِ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ  فَرَضَ         [7/266]      فَرَائِضَ فَلَا تُضَيِّعُوهَا  ، وَحَدَّ حُدُودًا فَلَا تَعْتَدُوهَا ، وَسَكَتَ عَنْ كَثِيرٍ عَنْ غَيْرِ نِسْيَانٍ فَلَا تَكْلَفُوهَا ، رَحْمَةً مِنَ اللهِ فَاقْبَلُوهَا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قُرَّةَ بْنِ خَالِدٍ  إِلَّا  أَصْرَمُ بْنُ حَوْشَبٍ  ،  تَفَرَّدَ بِهِ  :  أَبُو الْأَشْعَثِ  "" .","","Al-Mu'jam al-Awsat 7461","","أبو الدرداء عن طاوس بن كيسان عن الضحاك بن مزاحم الهلالي عن قرة بن خالد السدوسي عن أصرم بن حوشب الهمذاني عن أحمد بن المقدام العجلي عن محمد بن إبراهيم بن سعيد الوشاء عن الطبراني","محمد بن إبراهيم الوشاء الأصبهاني"
"7468","7462  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْوَشَّاءُ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ – غُنْدَرٌ - ،  ثَنَا  شُعْبَةُ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَنَّ  رَجُلًا  جَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّ أَبِي شَيْخٌ كَبِيرٌ ، إِنْ حَمَلْتُهُ لَمْ يَسْتَمْسِكْ ؟ قَالَ :  حُجَّ عَنْ أَبِيكَ  .","","Al-Mu'jam al-Awsat 7462","","سعيد بن المسيب عن داود بن أبي هند عن شعبة بن الحجاج عن غندر ربيب شعبة عن عبد الله بن محمد بن عبد الرحمن المسوري عن محمد بن إبراهيم بن سعيد الوشاء عن الطبراني","محمد بن إبراهيم الوشاء الأصبهاني"
"7469","7463  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْوَشَّاءُ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  نَا  أَبُو عَاصِمٍ ،  نَا  شُعْبَةُ ،  عَنْ  عُمَارَةَ بْنِ أَبِي حَفْصَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، مِثْلَهُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شُعْبَةَ  ، عَنْ  عُمَارَةَ  إِلَّا  أَبُو عَاصِمٍ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الزُّهْرِيُّ  ""  .","","Al-Mu'jam al-Awsat 7463","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عمارة بن أبي حفصة العتكي عن شعبة بن الحجاج عن أبو عاصم النبيل عن عبد الله بن محمد بن عبد الرحمن المسوري عن محمد بن إبراهيم بن سعيد الوشاء عن الطبراني","محمد بن إبراهيم الوشاء الأصبهاني"
"7470","7464  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَالِكٍ الضَّبِّيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  زُنَيْجٌ أَبُو غَسَّانَ ،  نَا  الْحَكَمُ بْنُ بَشِيرِ بْنِ سَلْمَانَ ،  نَا  عَمْرُو بْنُ قَيْسٍ ،  عَنْ  ثَوْرِ بْنِ أَبِي فَاخِتَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَخَذَ عَلِيٌّ بِيَدِي ، فَدَخَلَ عَلَى  الْحَسَنِ بْنِ عَلِيٍّ  وَهُوَ شَاكٍ ، فَإِذَا  أَبُو مُوسَى  عِنْدَهُ ،  فَقَالَ  : أَزَائِرًا أَمْ عَائِدًا ؟ قَالَ : بَلْ عَائِدًا ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ مُسْلِمٍ يَعُودُ مُسْلِمًا إِلَّا وَكَّلَ اللهُ بِهِ سَبْعِينَ أَلْفَ مَلَكٍ يُصَلُّونَ عَلَيْهِ  إِنْ كَانَ مَسَاءً حَتَّى يُصْبِحَ ، وَإِنْ كَانَ صَبَاحًا حَتَّى يُمْسِيَ ، وَجَعَلَ لَهُ غُرَفًا فِي الْجَنَّةِ  .         [7/267]      لَمْ يَرْوِ هَذَا الْحَدِيثَ ، عَنْ  عَمْرِو بْنِ قَيْسٍ  إِلَّا  الْحَكَمُ بْنُ بَشِيرٍ  ""  .","","Al-Mu'jam al-Awsat 7464","","علي بن أبي طالب عن سعيد بن علاقة الهاشمي عن ثوير بن أبي فاختة مولى أم هانئ عن عمرو بن قيس الملائي عن الحكم بن  أبى إسماعيل النهدي عن محمد بن عمرو بن بكر بن سالم عن محمد بن يحيى  بن مالك الأصبهاني عن الطبراني","محمد بن يحيى بن مالك الضبي الأصبهاني"
"7471","7465  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ الْأَصْبَهَانِيُّ ،  نَا  حَفْصُ بْنُ عُمَرَ الْمِهْرِقَانِيُّ ،  ثَنَا  حَمَّادُ بْنُ قِيرَاطٍ ،  عَنْ  أَبِي جَعْفَرٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا رَسُولَ اللهِ ، مَتَى السَّاعَةُ ؟ قَالَ : "" مَا أَعْدَدْتَ لَهَا "" قَالَ : وَاللهِ مَا أَعْدَدْتُ لَهَا كَبِيرَ عَمَلٍ ، إِلَّا أَنِّي أُحِبُّ اللهَ وَرَسُولَهُ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمَرْءُ مَعَ مَنْ أَحَبَّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يُونُسَ بْنِ عُبَيْدٍ  إِلَّا  أَبُو عُمَارَةَ  وَأَبُو جَعْفَرٍ - وَهُوَ : جَسْرُ بْنُ فَرْقَدٍ  ،  تَفَرَّدَ بِهِ  عَنْ  أَبِي عُمَارَةَ  :  عَبْدُ الْحَمِيدِ بْنُ بَيَانٍ  ،  وَتَفَرَّدَ بِهِ  عَنْ  جَسْرٍ حَمَّادُ بْنُ قِيرَاطٍ  ""  .","","Al-Mu'jam al-Awsat 7465","","أنس بن مالك عن الحسن البصري عن يونس بن عبيد عن جسر بن فرقد القصاب عن حماد بن قيراط النيسابوري عن حفص بن عمر المهرقاني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7472","7466  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْمِهْرِقَانِيُّ ،  ثَنَا  النَّجْمُ بْنُ بَشِيرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ سُلَيْمَانَ - أَخِي إِسْحَاقَ بْنِ سُلَيْمَانَ - ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  عَطَاءٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  كُنْتُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَائِطٍ وَقَدْ أُتِيَ بِطَائِرٍ ، فَقَالَ :  اللَّهُمَّ ائْتِنِي بِأَحَبِّ خَلْقِكَ إِلَيَّ يَأْكُلْ مَعِي مِنْ هَذَا الطَّائِرِ  ، فَجَاءَ  عَلِيٌّ  ، فَدَقَّ الْبَابَ ، فَقُلْتُ : مَنْ هَذَا ؟ فَقَالَ : أَنَا  عَلِيٌّ  ، فَقُلْتُ : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى حَاجَةٍ ، فَذَهَبَ ، ثُمَّ جَاءَ فَدَقَّ الْبَابَ ، فَقُلْتُ : مَنْ ذَا ؟ فَقَالَ : أَنَا  عَلِيٌّ  ، قُلْتُ : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى حَاجَةٍ ، ثُمَّ جَاءَ فَدَقَّ الْبَابَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اذْهَبْ فَافْتَحْ "" ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا حَبَسَكَ ، رَحِمَكَ اللهُ ؟ "" فَقَالَ : هَذِهِ ثَلَاثُ عَوْدَاتٍ ، كُلَّ ذَاكَ يَقُولُ لِي  أَنَسٌ  : إِنَّكَ عَلَى حَاجَةٍ ، فَقَالَ : "" يَا  أَنَسُ  ، مَا حَمَلَكَ عَلَى ذَلِكَ ؟ "" قُلْتُ : سَمِعْتُ بِدَعْوَتِكَ ، فَأَرَدْتُ أَنْ يَكُونَ رَجُلًا مِنْ قَوْمِي "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ  ، عَنْ  عَطَاءٍ  ، عَنْ  أَنَسٍ  إِلَّا  إِسْمَاعِيلُ بْنُ سُلَيْمَانَ  ، وَلَا رَوَاهُ عَنْ  إِسْمَاعِيلَ  إِلَّا  النَّجْمُ بْنُ بَشِيرٍ  ،  تَفَرَّدَ         [7/268]      بِهِ  :  حَفْصُ بْنُ عُمَرَ الْمِهْرِقَانِيُّ  ""  .","","Al-Mu'jam al-Awsat 7466","","أنس بن مالك عن عطاء بن أبي رباح عن عبد الملك بن أبي سليمان العرزمي عن إسماعيل بن سليمان الرازي عن نجم بن بشير الدينوري عن حفص بن عمر المهرقاني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7473","7467  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْمِهْرِقَانِيُّ ،  نَا  الْقَاسِمُ بْنُ الْحَكَمِ الْعُرَنِيُّ ،  نَا  عَبْدُ اللهِ بْنُ عَمْرِو بْنِ مُرَّةَ الْجَمَلِيُّ ،  نَا  مُحَمَّدُ بْنُ سُوقَةَ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ خَرَجَ ذَاتَ لَيْلَةٍ وَقَدْ أَخَّرَ صَلَاةَ الْعِشَاءِ حَتَّى ذَهَبَ هُنَيْهَةً أَوْ سَاعَةً ، وَالنَّاسُ يَنْتَظِرُونَهُ فِي الْمَسْجِدِ ، فَقَالَ : "" مَا تَنْتَظِرُونَ ؟ "" قَالُوا : نَنْتَظِرُ الصَّلَاةَ ، قَالَ :  أَمَا إِنَّكُمْ لَنْ تَزَالُوا فِي صَلَاةٍ مَا انْتَظَرْتُمُوهَا  . ثُمَّ قَالَ : "" أَمَا إِنَّهَا صَلَاةٌ لَمْ يُصَلِّهَا أَحَدٌ مِمَّنْ كَانَ قَبْلَكُمْ مِنَ الْأُمَمِ "" ، ثُمَّ رَفَعَ رَأْسَهُ إِلَى السَّمَاءِ ، فَقَالَ : "" النُّجُومُ أَمَانُ السَّمَاءِ ، فَإِذَا طُمِسَتِ النُّجُومُ أَتَى السَّمَاءَ مَا تُوعَدُ ، وَأَنَا أَمَانُ أَصْحَابِي ، فَإِذَا قُبِضْتُ أَتَى أَصْحَابِي مَا يُوعَدُونَ ، وَأَصْحَابِي أَمَانُ أُمَّتِي ، فَإِذَا قُبِضَ أَصْحَابِي أَتَى أُمَّتِي مَا يُوعَدُونَ  .  "" لَمْ يَرْوِهِ عَنْ  مُحَمَّدِ بْنِ سُوقَةَ  إِلَّا  عَبْدُ اللهِ بْنُ عَمْرٍو  ،  تَفَرَّدَ بِهِ  :  الْقَاسِمُ  ""  .","","Al-Mu'jam al-Awsat 7467","","المنكدر بن عبد الله بن الهدير القرشي عن محمد بن المنكدر عن محمد بن سوقة الغنوي عن عبد الله بن عمرو بن مرة الجملي عن القاسم بن الحكم بن كثير عن حفص بن عمر المهرقاني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7474","7468  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ الرَّازِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنِ  الْأَغَرِّ - أَغَرِّ مُزَيْنَةَ - قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ لِي بِجُزْءٍ مِنْ تَمْرٍ عِنْدَ  رَجُلٍ مِنَ الْأَنْصَارِ  ، فَمَطَلَنِي بِهِ ، فَكَلَّمْتُ فِيهِ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  اغْدُ مَعَهُ يَا  أَبَا بَكْرٍ  فَخُذْ لَهُ تَمْرَهُ  قَالَ : "" فَوَعَدَنِي  أَبُو بَكْرٍ  الْمَسْجِدَ إِذَا صَلَّيْنَا الصُّبْحَ ، فَوَجَدْتُهُ حَيْثُ وَعَدَنِي ، فَانْطَلَقْنَا ، فَكُلَّمَا رَأَى  أَبَا بَكْرٍ  رَجُلٌ مِنْ بَعِيدٍ سَلَّمَ عَلَيْهِ ، فَقَالَ  أَبُو بَكْرٍ  : "" أَمَا تَرَى مَا يُصِيبُ  الْقَوْمُ  عَلَيْكَ مِنَ الْفَضْلِ ، لَا يَسْبِقُكَ إِلَى السَّلَامِ أَحَدٌ "" قَالَ : "" فَكُنَّا إِذَا طَلَعَ الرَّجُلُ بَادَرْنَاهُ بِالسَّلَامِ قَبْلَ أَنْ يُسَلِّمَ عَلَيْنَا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعٍ  إِلَّا  مُحَمَّدُ بْنُ إِسْحَاقَ  ،  تَفَرَّدَ بِهِ  :  سَلَمَةُ بْنُ الْفَضْلِ  ""  .","","Al-Mu'jam al-Awsat 7468","","الأغر بن يسار المزني عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7475","[7/269]      7469  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ ،  نَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَتِ امْرَأَةٌ مِنْ  بَنِي قُرَيْظَةَ  يُقَالُ لَهَا :  تَمِيمَةُ  - تَحْتَ  عَبْدِ الرَّحْمَنِ بْنِ الزَّبِيرِ  ، فَطَلَّقَهَا ، فَتَزَوَّجَهَا  رِفَاعَةُ  - رَجُلٌ مِنْ  بَنِي قُرَيْظَةَ  - ، ثُمَّ فَارَقَهَا ، فَأَرَادَتْ أَنْ تَرْجِعَ إِلَى  عَبْدِ الرَّحْمَنِ بْنِ الزَّبِيرِ  ، فَقَالَتْ : يَا رَسُولَ اللهِ ، وَاللهِ مَا ذَاكَ مِنْهُ إِلَّا  كَهُدْبَةِ  ثَوْبِي ، فَقَالَ :  وَاللهِ يَا  تَمِيمَةُ  ، لَا تَرْجِعِينَ إِلَى  عَبْدِ الرَّحْمَنِ  حَتَّى يَذُوقَ  عُسَيْلَتَكِ  رَجُلٌ غَيْرُهُ  ، قَالَتْ : يَا رَسُولَ اللهِ إِنَّهُ قَدْ كَانَ جَاءَنِي هَنَةً "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  إِلَّا  سَلَمَةُ بْنُ الْفَضْلِ  ""  .","","Al-Mu'jam al-Awsat 7469","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7476","7470  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ ،  ثَنَا  أَبُو زُهَيْرٍ عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  عَنْ  عُمَرَ بْنِ عَبْدِ اللهِ بْنِ يَعْلَى بْنِ مُرَّةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ثَلَاثَةٌ يُحِبُّهَا اللهُ  : تَعْجِيلُ الْفِطْرِ ، وَتَأْخِيرُ السُّحُورِ ، وَضَرْبُ الْيَدَيْنِ إِحْدَاهُمَا عَلَى الْأُخْرَى فِي الصَّلَاةِ "" .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  يَعْلَى بْنِ مُرَّةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  أَبُو زُهَيْرٍ  ""  .","","Al-Mu'jam al-Awsat 7470","","يعلى بن مرة الثقفي عن عبد الله بن يعلى بن مرة الثقفي عن عمر بن عبد الله بن يعلى الثقفي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7477","7471  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ ،  ثَنَا  حَمَّادُ بْنُ قِيرَاطٍ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُعْطِيتُ خَمْسًا لَمْ يُعْطَهُنَّ نَبِيٌّ قَبْلِي  أُحِلَّتْ لِيَ الْغَنَائِمُ ، وَلَمْ تَحِلَّ لِنَبِيٍّ قَبْلِي ، وَجُعِلَتْ لِيَ الْأَرْضُ مَسْجِدًا وَطَهُورًا ، وَكَانَ مَنْ قَبْلَنَا يُصَلُّونَ فِي  الْمَحَارِيبِ  ، وَبُعِثْتُ إِلَى كُلِّ أَسْوَدَ وَأَحْمَرَ ، وَكَانَ الرَّجُلُ يُبْعَثُ إِلَى قَوْمِهِ خَاصَّةً ، وَنُصِرْتُ  بِالرُّعْبِ  مَسِيرَةَ  شَهْرٍ بَيْنَ يَدَيَّ ، يَسْمَعُ بِيَ  الْقَوْمُ  بَيْنِي وَبَيْنَهُمْ  مَسِيرَةُ  شَهْرٍ فَيُرْعَبُونَ مِنِّي ، وَجُعِلَ لِيَ الرُّعْبُ نَصْرًا ، وَقِيلَ لِي : سَلْ تُعْطَهْ ، فَجَعَلْتُهَا شَفَاعَةً لِأُمَّتِي ، وَهِيَ نَائِلَةٌ مَنْ شَهِدَ أَنْ لَا إِلَهَ إِلَّا اللهُ لَا يُشْرِكُ بِاللهِ شَيْئًا "" .         [7/270]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ حَسَّانَ  إِلَّا  حَمَّادُ بْنُ قِيرَاطٍ  ""  .","","Al-Mu'jam al-Awsat 7471","","أبو هريرة الدوسي عن محمد بن سيرين عن هشام بن حسان العتكي عن حماد بن قيراط النيسابوري عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7478","7472  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَيْرٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بِحَسْبِ امْرِئٍ مِنَ الْإِيمَانِ أَنْ يَقُولَ : رَضِيتُ بِاللهِ رَبًّا ،  وَبِمُحَمَّدٍ  رَسُولًا ، وَبِالْإِسْلَامِ دِينًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  مُحَمَّدُ بْنُ عُمَيْرٍ الرَّازِيُّ  ""  .","","Al-Mu'jam al-Awsat 7472","","عبد الله بن عباس عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن عمير عن أحمد بن إبراهيم النرمقي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7479","7473  -  حَدَّثَنَا  مُحَمَّدٌ ،  ثَنَا  أَحْمَدُ ،  نَا  عَبْدُ اللهِ بْنُ أَبِي جَعْفَرٍ الرَّازِيُّ ،  عَنْ  أَبِيهِ  ،  عَنِ  الرَّبِيعِ بْنِ أَنَسٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنْ  حُذَيْفَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لَمْ يَهْتَمَّ بِأَمْرِ الْمُسْلِمِينَ فَلَيْسَ مِنْهُمْ  ، وَمَنْ لَمْ يُصْبِحْ وَيُمْسِ نَاصِحًا لِلهِ وَلِرَسُولِهِ وَلِكِتَابِهِ وَلِإِمَامِهِ وَلِعَامَّةِ الْمُسْلِمِينَ فَلَيْسَ مِنْهُمْ "" .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  حُذَيْفَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ اللهِ بْنُ أَبِي جَعْفَرٍ الرَّازِيُّ  ""  .","","Al-Mu'jam al-Awsat 7473","","حذيفة بن اليمان عن رفيع بن مهران عن الربيع بن أنس البكري عن عيسى بن أبي عيسى الرازي عن عبد الله بن أبي جعفر المروزي عن أحمد بن إبراهيم النرمقي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7480","7474  - =  وَبِهِ  :  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَاءَتْهُ سَيِّئَتُهُ فَهُوَ مُؤْمِنٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ الْحَنَفِيَّةِ  إِلَّا  مُحَمَّدُ بْنُ كَعْبٍ  ، وَلَا عَنْ  مُحَمَّدِ بْنِ كَعْبٍ  إِلَّا  مُوسَى بْنُ عُبَيْدَةَ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ اللهِ بْنُ أَبِي جَعْفَرٍ  ""  .","","Al-Mu'jam al-Awsat 7474","","علي بن أبي طالب عن ابن الحنفية عن محمد بن كعب بن سليم القرظي عن موسى بن عبيدة بن نشيط الحميري عن عبد الله بن أبي جعفر المروزي عن أحمد بن إبراهيم النرمقي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7481","7475  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ الدَّشْتَكِيُّ ،  نَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي فُدَيْكٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي عَلِيٍّ اللهَبِيِّ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،         [7/271]      عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَمَّا عُرِجَ  بِإِبْرَاهِيمَ  رَأَى  رَجُلًا  يَفْجُرُ  بِامْرَأَةٍ  فَدَعَا عَلَيْهِ ، فَأُهْلِكَ ، ثُمَّ رَأَى  عَبْدًا  عَلَى مَعْصِيَةٍ فَدَعَا عَلَيْهِ  ، فَأَوْحَى اللهُ إِلَيْهِ : يَا  إِبْرَاهِيمُ ،  إِنَّهُ مَنْ عَبَدَنِي فَإِنَّ قَصْرَهُ مِنِّي خِصَالٌ ثَلَاثٌ : إِمَّا أَنْ يَتُوبَ فَأَتُوبَ عَلَيْهِ ، وَإِمَّا أَنْ يَسْتَغْفِرَنِي فَأَغْفِرَ لَهُ ، وَإِمَّا أَنْ يَخْرُجَ مِنْ صُلْبِهِ مَنْ يَعْبُدُنِي . يَا  إِبْرَاهِيمُ  ، أَمَا عَلِمْتَ أَنَّ مِنْ أَسْمَائِي أَنِّي أَنَا الصَّبُورُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  إِلَّا  عَلِيُّ بْنُ أَبِي عَلِيٍّ  ،  تَفَرَّدَ بِهِ  :  ابْنُ أَبِي فُدَيْكٍ  ""  .","","Al-Mu'jam al-Awsat 7475","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن علي بن أبي علي اللهبي عن محمد بن إسماعيل بن مسلم الديلي عن يعقوب بن إسحاق الدشتكي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7482","7476  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  مُحَمَّدُ بْنُ مُقَاتِلٍ الرَّازِيُّ ،  ثَنَا  حَكَّامُ بْنُ سَلْمٍ ،  عَنْ  أَبِي جَعْفَرٍ الرَّازِيِّ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْعَالِيَةِ قَالَ :  صَلَّى بِنَا أَبُو مُوسَى الْأَشْعَرِيُّ ،  بِأَصْبَهَانَ  صَلَاةَ الْخَوْفِ ، وَمَا كَانَ كَبِيرُ خَوْفٍ ؛ لِيُرِيَنَا صَلَاةَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَقَامَ ، فَكَبَّرَ ، وَكَبَّرَ مَعَهُ طَائِفَةٌ مِنَ  الْقَوْمِ  ، وَطَائِفَةٌ بِإِزَاءِ الْعَدُوِّ ، وَعَلَيْهِمُ السِّلَاحُ ، فَصَلَّى بِهِمْ رَكْعَةً ، فَانْصَرَفُوا ، فَأَتَوْا مَقَامَ إِخْوَانِهِمْ ، فَجَاءَتِ الطَّائِفَةُ الْأُخْرَى ، فَصَلَّى بِهِمْ رَكْعَةً أُخْرَى ، ثُمَّ سَلَّمَ ، فَصَلَّى كُلُّ وَاحِدٍ مِنْهُمُ الرَّكْعَةَ الثَّانِيَةَ  وُحْدَانًا  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  ، عَنْ  أَبِي الْعَالِيَةِ  ، عَنْ  أَبِي مُوسَى  إِلَّا  أَبُو جَعْفَرٍ الرَّازِيُّ  ، وَلَا عَنْ  أَبِي جَعْفَرٍ  إِلَّا  حَكَّامٌ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ مُقَاتِلٍ  ""  .","","Al-Mu'jam al-Awsat 7476","","أبو موسى الأشعري عن رفيع بن مهران عن قتادة بن دعامة عن عيسى بن أبي عيسى الرازي عن حكام بن سلم الكناني عن محمد بن مقاتل الرازي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7483","7477  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  سَعِيدُ بْنُ عَنْبَسَةَ الْقَطَّانُ  ،  ثَنَا  أَبُو عُبَيْدَةَ الْحَدَّادُ ،  نَا  أَبُو هِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَيِّدُ  الْإِدَامِ  فِي الدُّنْيَا وَالْآخِرَةِ اللَّحْمُ  ، وَسَيِّدُ الشَّرَابِ فِي الدُّنْيَا وَالْآخِرَةِ الْمَاءُ ، وَسَيِّدُ الرَّيَاحِينِ فِي الدُّنْيَا وَالْآخِرَةِ  الْفَاغِيَةُ  "" .         [7/272]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  إِلَّا  أَبُو هِلَالٍ  ، وَلَا رَوَاهُ عَنْ  أَبِي هِلَالٍ  إِلَّا  أَبُو عُبَيْدَةَ الْحَدَّادُ  ،  تَفَرَّدَ بِهِ  :  سَعِيدٌ  ""  .  كذا في طبعة دار الحرمين ، ومجمع البحرين ولعل بعض الرواة قلبه ، ولعل الصواب : ( عنبسة بن سعيد ) وينظر ترجمته في التهذيبين . والله أعلم","","Al-Mu'jam al-Awsat 7477","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن محمد بن سليم الراسبي عن عبد الواحد بن واصل عن سعيد بن عنبسة الرازي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7484","7478  - =  وَبِهِ  حَدَّثَنَا  أَبُو عُبَيْدَةَ الْحَدَّادُ ،  ثَنَا  وَاصِلُ بْنُ يَزِيدَ بْنِ وَاصِلٍ ،  حَدَّثَنِي  أَبِي  ، وَعُمُومَتِي ،  عَنْ  مَالِكِ بْنِ عُمَيْرٍ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي رَجُلٌ شَاعِرٌ ، فَمَا تَرَى فِي الشِّعْرِ ؟ فَقَالَ :  لَأَنْ يَمْتَلِئَ مَا بَيْنَ  لَبَّتِكَ  إِلَى عَانَتِكَ  قَيْحًا  وَصَدِيدًا  خَيْرٌ مِنْ أَنْ يَمْتَلِئَ شِعْرًا  .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  مَالِكِ بْنِ عُمَيْرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  سَعِيدُ بْنُ عَنْبَسَةَ  ""  .","","Al-Mu'jam al-Awsat 7478","","مالك بن عمير السلمي عن وعمومتي عن واصل بن يزيد بن واصل عن عبد الواحد بن واصل عن عنبسة بن سعيد الواسطي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7485","7479  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  أَحْمَدُ بْنُ أَبِي سُرَيْجٍ الرَّازِيُّ ،  نَا  عَبْدُ اللهِ بْنُ الْجَهْمِ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  عُمَرَ بْنِ قَيْسٍ الْمَاصِرِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  إِنَّ  قُرَيْشًا  أَهَمَّهُمْ  شَأْنُ  الْمَخْزُومِيَّةِ  الَّتِي سَرَقَتْ ، قَالُوا : مَنْ يُكَلِّمُ فِيهَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالُوا : وَمَنْ يَجْتَرِئُ عَلَيْهِ إِلَّا  أُسَامَةُ بْنُ زَيْدٍ  حِبُّ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَكَلَّمُوهُ فِي ذَلِكَ ، فَأَتَاهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا هَلَكَ الَّذِينَ مِنْ قَبْلِكُمْ ، أَنَّهُ كَانَ إِذَا سَرَقَ الشَّرِيفُ تَرَكُوهُ ، وَإِذَا سَرَقَ الضَّعِيفُ أَقَامُوا عَلَيْهِ  الْحَدَّ  ، وَايْمُ اللهِ ، لَوْ كَانَتْ  فَاطِمَةَ بِنْتَ مُحَمَّدٍ  لَقَطَعْتُ يَدَهَا "" فَقَطَعَ يَدَهَا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَرَ بْنِ قَيْسٍ الْمَاصِرِ  إِلَّا  عَمْرُو بْنُ أَبِي قَيْسٍ  .  وَخَالَفَ  عُمَرُ بْنُ قَيْسٍ  أَصْحَابَ  الزُّهْرِيِّ  فِي  إِسْنَادِ  هَذَا الْحَدِيثِ ، فَقَالَ : عَنْ  عُرْوَةَ  ، عَنْ  أُمِّ سَلَمَةَ  "" .         [7/273]      وَرَوَاهُ أَصْحَابُ  الزُّهْرِيِّ  ، عَنِ  الزُّهْرِيِّ  ، عَنْ  عُرْوَةَ  ، عَنْ  عَائِشَةَ  .","","Al-Mu'jam al-Awsat 7479","","هند بنت أبي أمية زوج رسول الله عن عروة بن الزبير عن الزهري عن عمر بن قيس الماصر عن عمرو بن أبي قيس عن عبد الله بن الجهم الرازي عن أحمد بن الصباح النهشلي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7486","7480  -  حَدَّثَنَا  مُحَمَّدٌ ،  ثَنَا  أَحْمَدُ بْنُ أَبِي سُرَيْجٍ ،  ثَنَا  شُعَيْبُ بْنُ حَرْبٍ ،  نَا  كَامِلٌ أَبُو الْعَلَاءِ ،  ثَنَا  أَبُو صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ امْرَأَةً دَخَلَتِ النَّارَ فِي هِرَّةٍ لَهَا  ، كَانَتْ رَبَطَتْهَا فَلَا تُطْعِمُهَا وَلَا تُخَلِّيهَا تَأْكُلُ مِنْ  خَشَاشِ  الْأَرْضِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  كَامِلٍ أَبِي الْعَلَاءِ  إِلَّا  شُعَيْبُ بْنُ حَرْبٍ  ،  تَفَرَّدَ بِهِ  :  أَحْمَدُ بْنُ أَبِي سُرَيْجٍ  ""  .","","Al-Mu'jam al-Awsat 7480","","أبو هريرة الدوسي عن ذكوان السمان عن كامل بن العلاء التميمي عن شعيب بن حرب الأبناوي عن أحمد بن الصباح النهشلي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7487","7481  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ الرَّازِيُّ ،  ثَنَا  أَبُو زُهَيْرٍ عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  ثَنَا  مُحَمَّدُ بْنُ كُرَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى رَجُلَيْنِ مَقْرُونَيْنِ حَاجَّيْنِ نَذْرًا ، فَقَالَ :  انْزِعَا قِرَانَكُمَا  ، قَالَا : يَا رَسُولَ اللهِ ، إِنَّهُ نَذْرٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" انْزِعَا قِرَانَكُمَا ، ثُمَّ حُجَّا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ كُرَيْبٍ  إِلَّا  أَبُو زُهَيْرٍ  .","","Al-Mu'jam al-Awsat 7481","","عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن محمد بن كريب بن أبي مسلم الهاشمي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7488","7482  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ ،  ثَنَا  أَبُو زُهَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ كُرَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَزْنِي الزَّانِي حِينَ يَزْنِي وَهُوَ  مُؤْمِنٌ  ، وَلَا يَسْرِقُ حِينَ يَسْرِقُ وَهُوَ مُؤْمِنٌ ، وَلَا يَنْتَهِبُ نُهْبَةً يَرْفَعُ الْمُؤْمِنُونَ إِلَيْهِ         [7/274]      رُءُوسَهُمْ وَهُوَ مُؤْمِنٌ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ كُرَيْبٍ  إِلَّا  أَبُو زُهَيْرٍ  ""  .","","Al-Mu'jam al-Awsat 7482","","أبو هريرة الدوسي عن عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن محمد بن كريب بن أبي مسلم الهاشمي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7489","7483  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  يَعْقُوبُ الدَّشْتَكِيُّ ،  ثَنَا  هِشَامُ بْنُ عُبَيْدِ اللهِ السِّنِّيُّ ،  نَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ وَالْأَسْوَدِ ، قَالَا :  قَالَ  عَبْدُ اللهِ :  مَا قَنَتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي شَيْءٍ مِنَ الصَّلَوَاتِ إِلَّا فِي  الْوِتْرِ  ، وَإِنَّهُ كَانَ إِذَا حَارَبَ يَقْنُتُ فِي الصَّلَوَاتِ كُلِّهِنَّ يَدْعُو عَلَى الْمُشْرِكِينَ ، وَمَا قَنَتَ  أَبُو بَكْرٍ  ، وَلَا  عُمَرُ  ، وَلَا  عُثْمَانُ  ، حَتَّى مَاتُوا "" .  "" وَلَا قَنَتَ  عَلِيٌّ  حَتَّى حَارَبَ  أَهْلَ الشَّامِ  ، وَكَانَ يَقْنُتُ فِي الصَّلَوَاتِ كُلِّهِنَّ ، وَكَانَ  مُعَاوِيَةُ  يَدْعُو عَلَيْهِ أَيْضًا ، يَدْعُو كُلُّ وَاحِدٍ مِنْهُمَا عَلَى الْآخَرِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حَمَّادٍ  ، عَنْ  إِبْرَاهِيمَ  ، عَنْ  عَلْقَمَةَ  وَالْأَسْوَدِ  ، عَنْ  عَبْدِ اللهِ  إِلَّا  مُحَمَّدُ بْنُ جَابِرٍ  "" .  وَرَوَاهُ  الْحَسَنُ بْنُ الْحُرِّ  ، عَنْ  حَمَّادٍ  ، عَنْ  إِبْرَاهِيمَ  ، عَنِ  الْأَسْوَدِ  ، عَنْ  عُمَرَ  .","","Al-Mu'jam al-Awsat 7483","","عبد الله بن مسعود عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن محمد بن جابر بن سيار عن هشام بن عبيد الله السني عن يعقوب بن إسحاق الدشتكي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7490","7484  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  الْحُسَيْنُ بْنُ عِيسَى بْنِ مَيْسَرَةَ الرَّازِيُّ ،  نَا  الْفُرَاتُ بْنُ خَالِدٍ ،  نَا  مَالِكُ بْنُ مِغْوَلٍ قَالَ :  سَمِعْتُ  أَبَا عَوْنٍ مُحَمَّدَ بْنَ عُبَيْدِ اللهِ الثَّقَفِيَّ ،  يُحَدِّثُ ، عَنْ  وَرَّادٍ ، مَوْلَى الْمُغِيرَةِ بْنِ شُعْبَةَ .         [7/275]      أَنَّ  مُعَاوِيَةَ  كَتَبَ إِلَيْهِ - يَعْنِي الْمُغِيرَةَ - يَسْأَلُهُ عَمَّا سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَكَتَبَ إِلَيْهِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ اللهَ كَرِهَ لَكُمْ ثَلَاثًا  :  عُقُوقَ  الْأُمَّهَاتِ ،  وَوَأْدَ  الْبَنَاتِ ، وَمَنْعًا وَهَاتِ ، وَقِيلَ وَقَالَ ، وَكَثْرَةَ  السُّؤَالِ  ، وَإِضَاعَةَ الْمَالِ "" .","","Al-Mu'jam al-Awsat 7484","","المغيرة بن شعبة عن وراد الثقفي كاتب المغيرة بن شعبة عن محمد بن عبيد الله بن سعيد الثقفي عن مالك بن مغول الصهيبي عن فرات بن خالد الرازي عن الحسين بن عيسى الحارثي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7491","7485  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  الْحُسَيْنُ بْنُ عِيسَى ،  نَا  الْفُرَاتُ بْنُ خَالِدٍ ،  عَنْ  مَالِكِ بْنِ مِغْوَلٍ قَالَ :  سَمِعْتُ  عَطَاءَ بْنَ السَّائِبِ ،  يَذْكُرُ عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  خَلَّتَانِ هُمَا يَسِيرٌ ، وَمَنْ يَعْمَلُ بِهِمَا قَلِيلٌ  ، لَا يُوَاظِبُ عَلَيْهِمَا أَحَدٌ إِلَّا دَخَلَ الْجَنَّةَ : فِي دُبُرِ كُلِّ صَلَاةٍ عَشْرُ تَكْبِيرَاتٍ ، وَعَشْرُ تَسْبِيحَاتٍ ، وَعَشْرُ تَحْمِيدَاتٍ ، فَهَذِهِ خَمْسُونَ وَمِائَةٌ عَلَى اللِّسَانِ وَأَلْفٌ وَخَمْسُمِائَةٍ فِي الْمِيزَانِ ، وَإِذَا أَوَى إِلَى فِرَاشِهِ سَبَّحَ ثَلَاثًا وَثَلَاثِينَ ، وَحَمِدَ ثَلَاثًا وَثَلَاثِينَ ، وَكَبَّرَ أَرْبَعًا وَثَلَاثِينَ ، فَذَاكَ مِائَةٌ عَلَى اللِّسَانِ وَأَلْفٌ فِي الْمِيزَانِ ، فَأَيُّكُمْ يُذْنِبُ فِي الْيَوْمِ وَاللَّيْلَةِ أَلْفَيْنِ وَخَمْسَمِائَةِ ذَنْبٍ ؟ "" فَقَالَ بَعْضُهُمْ : إِنَّ هَذَا أَمْرٌ الْعَمَلُ فِيهِ يَسِيرٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّ الشَّيْطَانَ يَأْتِي أَحَدَكُمْ إِذَا فَرَغَ مِنْ صَلَاتِهِ فَيَقُولُ : اذْكُرْ حَاجَةَ كَذَا وَحَاجَةَ كَذَا "" .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  مَالِكِ بْنِ مِغْوَلٍ  إِلَّا  الْفُرَاتُ بْنُ خَالِدٍ  وَمُحَمَّدُ بْنُ سَابِقٍ  ""  .","","Al-Mu'jam al-Awsat 7485","","عبد الله بن عمرو بن العاص عن السائب بن مالك الثقفي عن عطاء بن السائب عن مالك بن مغول الصهيبي عن فرات بن خالد الرازي عن الحسين بن عيسى الخلال عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7492","7486  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  الْحُسَيْنُ بْنُ عِيسَى ،  ثَنَا  الْفُرَاتُ بْنُ خَالِدٍ ،  عَنِ  الضَّحَّاكِ بْنِ عُثْمَانَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْأَعْرَجِ ،  عَنِ  ابْنِ بُحَيْنَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَامَ فِي الرَّكْعَتَيْنِ مِنَ الظُّهْرِ ، فَصَفَّقَ النَّاسُ وَسَبَّحُوا بِهِ  ، حَتَّى عَرَفَ أَنَّهُ قَدْ  سَهَا  ، فَمَضَى حَتَّى تَمَّتْ صَلَاتُهُ ، ثُمَّ سَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ قَبْلَ أَنْ يُسَلِّمَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الضَّحَّاكِ بْنِ عُثْمَانَ  إِلَّا  الْفُرَاتُ بْنُ خَالِدٍ  ""  .","","Al-Mu'jam al-Awsat 7486","","عبد الله بن مالك بن سعد بن القشب الأزدي عن عبد الرحمن بن هرمز الأعرج عن يحيى بن سعيد الأنصاري عن الضحاك بن عثمان الحزامي عن فرات بن خالد الرازي عن الحسين بن عيسى الحارثي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7493","7487  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ الرَّازِيُّ ،  نَا  أَبُو زُهَيْرٍ         [7/276]      عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  عَنِ  الْأَجْلَحِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعَلَيْهِ ثِيَابٌ رَدِيئَةٌ ، وَهُوَ سَيِّئُ الْهَيْئَةِ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَلْ لَكَ مَالٌ ؟  قَالَ : نَعَمْ ، مِنْ أَنْوَاعِ الْمَالِ كُلِّهِ ، قَالَ : "" فَلْيُرَ عَلَيْكَ مَا رَزَقَكَ اللهُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَجْلَحِ  إِلَّا  أَبُو زُهَيْرٍ  ""  .","","Al-Mu'jam al-Awsat 7487","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن أجلح بن عبد الله الكندي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7494","7488  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  أَحْمَدُ بْنُ أَبِي سُرَيْجٍ الرَّازِيُّ ،  نَا  عَمْرُو بْنُ مُجَمِّعٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ لَا نَرْمِيَ الْجَمْرَةَ حَتَّى تَطْلُعَ الشَّمْسُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْمَاعِيلَ  إِلَّا  عَمْرُو بْنُ مُجَمِّعٍ  ،  تَفَرَّدَ بِهِ  :  أَحْمَدُ بْنُ أَبِي سُرَيْجٍ  ""  .","","Al-Mu'jam al-Awsat 7488","","عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن إسماعيل بن أبي خالد عن عمرو بن مجمع السكوني عن أحمد بن الصباح النهشلي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7495","7489  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ ،  ثَنَا  أَبُو زُهَيْرٍ ،  نَا  وِقَاءُ بْنُ إِيَاسٍ الْوَالِبِيُّ قَالَ :  سَمِعْتُ  سُهَيْلَ بْنَ ذَكْوَانَ أَبَا صَالِحٍ ،  يَذْكُرُ عَنْ  أَبِيهِ  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  أَتَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَابَ  رَجُلٍ مِنَ الْأَنْصَارِ  فَسَلَّمَ ، وَالْأَنْصَارِيُّ عَلَى امْرَأَتِهِ ، فَرَدَّ عَلَيْهِ وَهُوَ عَلَيْهَا ، ثُمَّ سَلَّمَ الثَّانِيَةَ ، فَرَدَّ عَلَيْهِ وَلَمْ يَقُمْ ، ثُمَّ انْصَرَفَ لَمَّا لَمْ يَأْذَنْ لَهُ ، فَقَامَ الْآخَرُ قَبْلَ أَنْ يَفْرُغَ ، وَخَرَجَ فِي أَثَرِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَطْلُبُهُ ، قَالَ  أَبُو هُرَيْرَةَ  : فَأَتَيْنَا النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ قَائِمٌ ، فَاجْتَمَعْنَا إِلَيْهِ ، وَاغْتَسَلَ الرَّجُلُ فِي نَهَرٍ إِلَى جَانِبِ دَارِهِ ، فَأَقْبَلَ وَقَدِ اغْتَسَلَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَقَدِ اغْتَسَلَ ، وَمَا وَجَبَ عَلَيْهِ الْغُسْلُ  ، فَجَاءَ الرَّجُلُ يَعْتَذِرُ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ بِأَمْرِهِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اغْتَسَلْتَ وَلَمْ يَجِبْ عَلَيْكَ الْغُسْلُ "" .         [7/277]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  وِقَاءٍ  إِلَّا  أَبُو زُهَيْرٍ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ  ""  .","","Al-Mu'jam al-Awsat 7489","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن وقاء بن إياس الوالبي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7496","7490  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ ،  نَا  أَبُو زُهَيْرٍ ،  نَا  مُحَمَّدُ بْنُ كُرَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  سَعْدِ بْنِ عُبَادَةَ قَالَ :  جِئْتُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ : تُوُفِّيَتْ أُمِّي ، وَلَمْ تُوصِ ، وَلَمْ تَتَصَدَّقْ ، فَهَلْ يُقْبَلُ إِنْ تَصَدَّقْتُ عَنْهَا ؟ قَالَ : "" نَعَمْ "" قَالَ : فَهَلْ يَنْفَعُهَا ذَلِكَ ؟ قَالَ :  نَعَمْ ، وَلَوْ بِكُرَاعِ شَاةٍ مُحْتَرِقٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ كُرَيْبٍ  إِلَّا  أَبُو زُهَيْرٍ  ""  .","","Al-Mu'jam al-Awsat 7490","","سعد بن عبادة عن عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن محمد بن كريب بن أبي مسلم الهاشمي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7497","7491  - =  وَبِهِ  :  عَنْ  مُحَمَّدِ بْنِ كُرَيْبٍ ،  عَنْ  أَبِيهِ  قَالَ :  شَهِدْتُ  الْأَحْنَفَ بْنَ قَيْسٍ ،  يُحَدِّثُ عَنْ  عَمِّهِ - وَعَمُّهُ : جَارِيَةُ بْنُ قُدَامَةَ - ، أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ، قُلْ لِي قَوْلًا يَنْفَعُنِي اللهُ بِهِ ، وَأَقْلِلْ لَعَلِّي أَعْقِلُهُ ، قَالَ :  لَا تَغْضَبْ  ، ثُمَّ عَادَ ، فَقَالَ : "" لَا تَغْضَبْ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  كُرَيْبٍ  إِلَّا ابْنُهُ  مُحَمَّدٌ  ،  تَفَرَّدَ بِهِ  :  أَبُو زُهَيْرٍ  .  "" وَالْمَشْهُورُ : مِنْ حَدِيثِ  هِشَامِ بْنِ عُرْوَةَ  عَنْ أَبِيهِ عَنْ  جَارِيَةَ بْنِ قُدَامَةَ  .","","Al-Mu'jam al-Awsat 7491","","جارية بن قدامة بن زهير التميمي عن الأحنف بن قيس السعدي عن كريب بن أبي مسلم الحجازي عن محمد بن كريب بن أبي مسلم الهاشمي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7498","7492  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  عَبْدُ السَّلَامِ بْنُ عَاصِمٍ الرَّازِيُّ ،  نَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  حِطَّانَ بْنِ عَبْدِ اللهِ الرَّقَاشِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  أُعْطِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْكَفِيتُ  .  قِيلَ  لِلْحَسَنِ  : وَمَا  الْكَفِيتُ  ؟ قَالَ : "" الْبِضَاعُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  ، عَنِ  الْحَسَنِ  إِلَّا  هِشَامٌ  ، وَلَا عَنْ  هِشَامٍ  إِلَّا ابْنُهُ ،         [7/278]      تَفَرَّدَ بِهِ  :  عَبْدُ السَّلَامِ بْنُ عَاصِمٍ  ""  .","","Al-Mu'jam al-Awsat 7492","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن حطان بن عبد الله الرقاشي عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن عبد السلام بن عاصم الهسنجاني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7499","7493  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ ،  نَا  أَبُو زُهَيْرٍ ،  نَا  الْحَسَنُ بْنُ سَالِمِ بْنِ أَبِي الْجَعْدِ قَالَ :  سَمِعْتُ  نُعَيْمَ بْنَ أَبِي هِنْدٍ ،  نَا  رِبْعِيُّ بْنُ حِرَاشٍ ،  حَدَّثَنِي  حُذَيْفَةُ بْنُ الْيَمَانِ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أُعْطِيتُ آيَاتٍ مِنْ بَيْتِ كَنْزٍ تَحْتَ الْعَرْشِ  ، لَمْ يُعْطَهُنَّ نَبِيٌّ قَبْلِي ، وَلَا يُعْطَاهَا أَحَدٌ بَعْدِي ، وَجُعِلَتْ لِيَ الْأَرْضُ مَسْجِدًا وَطَهُورًا ، وَجُعِلَتْ صُفُوفُنَا عَلَى مِثْلِ صُفُوفِ الْمَلَائِكَةِ ، وَأُيِّدْتُ  بِالرُّعْبِ  مِنْ  مَسِيرَةِ  شَهْرٍ  ، ثُمَّ قَرَأَ الْآيَاتِ مِنْ آخِرِ الْبَقَرَةِ :         {      لِلهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الأَرْضِ         }      حَتَّى خَتَمَ السُّورَةَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَسَنِ بْنِ سَالِمِ بْنِ أَبِي الْجَعْدِ  إِلَّا  أَبُو زُهَيْرٍ  ""  .","","Al-Mu'jam al-Awsat 7493","","حذيفة بن اليمان عن ربعي بن حراش العبسي عن نعيم بن أبي هند الأشجعي عن الحسن بن سالم عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7500","7494  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الدِّمَشْقِيُّ  ،  نَا  الْحَارِثُ بْنُ مُسْلِمٍ ،  عَنْ  بَحْرٍ السَّقَّاءِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ رَجُلًا مِنْ  ثَقِيفَ  - يُقَالُ لَهُ :  غَيْلَانُ بْنُ سَلَمَةَ  - أَسْلَمَ وَلَهُ عَشْرُ نِسْوَةٍ ، "" فَأَمَرَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يَخْتَارَ مِنْهُنَّ أَرْبَعًا ، وَيَدَعَ سِتًّا  .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( الدشتكي ) كما في المعجم الكبير 18 / 263","","Al-Mu'jam al-Awsat 7494","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن بحر بن كنيز السقاء عن الحارث بن مسلم الرازي المقرئ عن يعقوب بن إسحاق الدشتكي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7501","7495  - =  وَبِهِ  :  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  صُمْنَا يَوْمَ عَاشُورَاءَ قَبْلَ أَنْ يَفْرِضَ اللهُ صِيَامَ رَمَضَانَ ، فَلَمَّا  فَرَضَ  اللهُ صِيَامَ رَمَضَانَ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ شَاءَ مِنْكُمْ فَلْيَصُمْهُ ، وَمَنْ شَاءَ فَلْيَتْرُكْهُ  ، وَكَانَ يَوْمًا تُسْتَرُ فِيهِ  الْكَعْبَةُ  .","","Al-Mu'jam al-Awsat 7495","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن بحر بن كنيز السقاء عن الحارث بن مسلم بن الحارث التميمي عن يعقوب بن إسحاق الدشتكي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7502","7496  - =  وَبِهِ  :  عَنْ  بَحْرٍ السَّقَّاءِ ،  عَنْ  جُوَيْبِرٍ ،  عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  السِّوَاكُ مَطْهَرَةٌ لِلْفَمِ  ، مَرْضَاةٌ لِلرَّبِّ ، وَمَجْلَاةٌ لِلْبَصَرِ "" .  لَمْ يَرْوِ هَذَهِ الْأَحَادِيثَ عَنْ  بَحْرٍ السَّقَّاءِ  إِلَّا  الْحَارِثُ بْنُ مُسْلِمٍ  ""  .","","Al-Mu'jam al-Awsat 7496","","عبد الله بن عباس عن الضحاك بن مزاحم الهلالي عن جويبر بن سعيد عن بحر بن كنيز السقاء عن الحارث بن مسلم بن الحارث التميمي عن يعقوب بن إسحاق الدمشقي عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7503","[7/279]      7497  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  عَبْدُ السَّلَامِ بْنُ عَاصِمٍ الرَّازِيُّ ،  ثَنَا  الصَّبَّاحُ بْنُ مُحَارِبٍ ،  نَا  دَاوُدُ الْأَوْدِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ كَانَ الشُّؤْمُ فِي شَيْءٍ فَفِي الدَّارِ ، وَالْمَرْأَةِ ، وَالْفَرَسِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  دَاوُدَ الْأَوْدِيِّ  إِلَّا  الصَّبَّاحُ بْنُ مُحَارِبٍ  ""  .","","Al-Mu'jam al-Awsat 7497","","أبو هريرة الدوسي عن يزيد بن عبد الرحمن بن الأسود الزعافري عن داود بن يزيد الزعافري عن صباح بن محارب التيمي عن عبد السلام بن عاصم الهسنجاني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7504","7498  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ الرَّازِيُّ ،  نَا  أَبُو زُهَيْرٍ قَالَ : قَالَ الْمُفَضَّلُ بْنُ فَضَالَةَ :  تَذَاكَرْنَا  الْبِرَّ  عِنْدَ أَبِي حَرْبِ بْنِ أَبِي الْأَسْوَدِ الدِّيلِيِّ ، فَقَالَ  أَبُو حَرْبٍ  :  تَذَاكَرْنَا  الْبِرَّ  عِنْدَ عِمْرَانَ بْنِ حُصَيْنٍ ، فَقَالَ :  تَذَاكَرْنَا  الْبِرَّ  عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَنْشَأَ يُحَدِّثُنَا قَالَ :  إِنَّهُ كَانَ فِيمَنْ كَانَ قَبْلَكُمْ مِنَ الْأُمَمِ رَجُلٌ مُتَعَبِّدٌ صَاحِبُ صَوْمَعَةٍ  ، يُقَالُ لَهُ :  جُرَيْجٌ  ، فَكَانَتْ لَهُ  امْرَأَةٌ - أَوْ أُمٌّ -  ، فَكَانَتْ تَأْتِيهِ فَتُنَادِيهِ ، فَيُشْرِفُ عَلَيْهَا فَيُكَلِّمُهَا ، فَأَتَتْهُ يَوْمًا وَهُوَ فِي صَلَاتِهِ مُقْبِلٌ عَلَيْهَا ، فَنَادَتْهُ ، - فَحَكَاهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَوَضَعَ يَدَهُ عَلَى جَبْهَتِهِ - ، فَجَعَلَتْ تُنَادِيهِ رَافِعَةً رَأْسَهَا إِلَيْهِ ، وَاضِعَةً يَدَهَا عَلَى جَبْهَتِهَا : أَيْ  جُرَيْجُ  ، أَيْ  جُرَيْجُ  ، ثَلَاثَ مَرَّاتٍ ، كُلُّ مَرَّةٍ ثَلَاثَ مِرَارٍ ، كُلُّ ذَلِكَ يَقُولُ  جُرَيْجٌ  : أَيْ رَبِّ ، أُمِّي أَمْ صَلَاتِي ؟ فَغَضِبَتْ ، فَقَالَتِ : اللَّهُمَّ لَا يَمُوتَنَّ  جُرَيْجٌ  حَتَّى يَنْظُرَ فِي وُجُوهِ  الْمُومِسَاتِ  "" .  قَالَ : "" وَبَلَغَتْ بِنْتُ مَلِكِ الْقَرْيَةِ ، فَحَمَلَتْ فَوَلَدَتْ غُلَامًا ، فَقَالُوا لَهَا : مَنْ فَعَلَ هَذَا بِكِ ؟ ؟ مَنْ صَاحِبُكِ ؟ قَالَتْ : هُوَ صَاحِبُ الصَّوْمَعَةِ  جُرَيْجٌ  ، فَمَا شَعَرَ  جُرَيْجٌ  حَتَّى سَمِعَ بِالْفُئُوسِ فِي أَصْلِ صَوْمَعَتِهِ ، فَجَعَلَ يَسْأَلُهُمْ ، وَيْلَكُمْ مَا لَكُمْ ؟ فَلَمْ يُجِيبُوهُ ، فَلَمَّا رَأَى ذَلِكَ أَخَذَ الْحَبْلَ فَتَدَلَّى ، فَجَعَلُوا يَجِئُونَ أَنْفَهُ ، وَيَضْرِبُونَهُ ، وَيَقُولُونَ : مُرَاءٍ مُخَادِعٌ النَّاسَ بِعَمَلِكَ ، قَالَ : وَيْلَكُمْ مَا لَكُمْ ؟!         [7/280]      قَالُوا : أَبِنْتُ صَاحِبِ الْقَرْيَةِ بِنْتُ الْمَلِكِ الَّتِي أَحْبَلْتَهَا ؟ قَالَ : فَمَا فَعَلَتْ ؟ قَالُوا : وَلَدَتْ غُلَامًا ، قَالَ : الْغُلَامُ حَيٌّ هُوَ ؟ قَالُوا : نَعَمْ ، قَالَ : فَتَوَلُّوا عَنِّي ، فَتَوَلَّى فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ مَشَى إِلَى شَجَرَةٍ فَأَخَذَ مِنْهَا غُصْنًا ، ثُمَّ أَتَى الْغُلَامَ وَهُوَ فِي مَهْدِهِ ، فَضَرَبَهُ بِذَلِكَ الْغُصْنِ ، وَقَالَ : يَا طَاغِيَةُ ، مَنْ أَبُوكَ ؟ قَالَ : أَبِي فُلَانٌ الرَّاعِي ، قَالُوا : إِنْ شِئْتَ بَنَيْنَا لَكَ صَوْمَعَتَكَ بِذَهَبٍ ، وَإِنْ شِئْتَ بِفِضَّةٍ ، قَالَ : أَعِيدُوهَا كَمَا كَانَتْ .  فَزَعَمَ  أَبُو حَرْبٍ  ، أَنَّهُ لَمْ يَتَكَلَّمْ فِي الْمَهْدِ إِلَّا ثَلَاثَةٌ :  عِيسَى ابْنُ مَرْيَمَ  ، وَشَاهِدُ  يُوسُفَ  ، وَصَاحِبُ  جُرَيْجٍ  ""  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُفَضَّلِ بْنِ فَضَالَةَ - وَهُوَ : أَخُو الْمُبَارَكِ  - إِلَّا  أَبُو زُهَيْرٍ  ، وَلَا يُرْوَى عَنْ  عِمْرَانَ بْنِ حُصَيْنٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ""  .","","Al-Mu'jam al-Awsat 7498","","عمران بن حصين بن عبيد بن خلف الخزاعي عن أبو حرب بن أبي الأسود الديلي عن المفضل بن فضالة بن أبي أمية العمري عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7505","7499  - =  وَبِهِ  :  حَدَّثَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  لَمَّا كَانَ  يَوْمُ أُحُدٍ  حَاصَ  أَهْلُ الْمَدِينَةِ  حَيْصَةً ، قَالُوا : قُتِلَ  مُحَمَّدٌ  ، حَتَّى كَثُرَتِ الصَّوَارِخُ فِي نَاحِيَةِ  الْمَدِينَةِ  ، فَخَرَجَتِ  امْرَأَةٌ مِنَ الْأَنْصَارِ  مُتَحَزِّمَةً ، فَاسْتُقْبِلَتْ بِابْنِهَا وَأَبِيهَا وَزَوْجِهَا وَأَخِيهَا ، لَا أَدْرِي أَيُّهُمُ اسْتُقْبِلَتْ بِهِ أَوَّلَ ، فَلَمَّا مَرَّتْ عَلَى آخِرِهِمْ قَالَتْ : مَنْ هَذَا ؟ قَالُوا : أَبُوكِ ، أَخُوكِ ، زَوْجُكِ ، ابْنُكِ ، تَقُولُ : مَا فَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ يَقُولُونَ : أَمَامَكِ ، حَتَّى دُفِعَتْ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَخَذَتْ بِنَاحِيَةِ ثَوْبِهِ ، ثُمَّ قَالَتْ : بِأَبِي أَنْتَ وَأُمِّي يَا رَسُولَ اللهِ ، لَا  أُبَالِي  إِذْ سَلِمْتَ مَنْ عَطِبَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  ثَابِتٍ  إِلَّا  الْمُفَضَّلُ بْنُ فَضَالَةَ  ،  تَفَرَّدَ بِهِ  :  أَبُو زُهَيْرٍ  ""  .","","Al-Mu'jam al-Awsat 7499","","أنس بن مالك عن ثابت البناني عن المفضل بن فضالة بن أبي أمية العمري عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7506","7500  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ ،  نَا  أَبُو زُهَيْرٍ عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  عَنِ  الْمُفَضَّلِ بْنِ فَضَالَةَ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،         [7/281]      نَا  أَنَسُ بْنُ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ""  إِنَّهُ كَانَ فِيمَنْ سَلَفَ مِنَ الْأُمَمِ رَجُلٌ يُقَالُ لَهُ :  مُوَرِّقٌ  ، وَكَانَ مُتَعَبِّدًا ، فَبَيْنَا هُوَ قَائِمٌ فِي صَلَاتِهِ ذَكَرَ النِّسَاءَ ، فَاشْتَهَاهُنَّ  ، وَانْتَشَرَ حَتَّى قَطَعَ صَلَاتَهُ ، فَغَضِبَ ، فَأَخَذَ قَوْسَهُ ، فَقَطَعَ وَتَرَهُ ، فَعَقَدَهُ بِخُصْيَيْهِ ، وَشَدَّهُ إِلَى عَقِبَيْهِ ، ثُمَّ مَدَّ رِجْلَيْهِ ، فَانْتَزَعَهُمَا ، ثُمَّ أَخَذَ طِمْرَيْهِ وَنَعْلَيْهِ ، حَتَّى أَتَى أَرْضًا لَا أَنِيسَ بِهَا وَلَا وَحْشَ ، فَاتَّخَذَ  عَرِيشًا  ، ثُمَّ قَامَ يُصَلِّي ، فَجَعَلَ كُلَّمَا أَصْبَحَ انْصَدَعَتْ لَهُ الْأَرْضُ ، فَخَرَجَ لَهُ خَارِجٌ مِنْهَا مَعَهُ إِنَاءٌ فِيهِ طَعَامٌ فَيَأْكُلُ حَتَّى يَشْبَعَ ، ثُمَّ يَدْخُلُ فَيَخْرُجُ بِإِنَاءٍ فِيهِ شَرَابٌ فَيَشْرَبُ حَتَّى يَرْوَى ، ثُمَّ يَدْخُلُ وَتَلْتَئِمُ الْأَرْضُ ، فَإِذَا أَمْسَى فَعَلَ مِثْلَ ذَلِكَ "" .  قَالَ : "" وَمَرَّ أُنَاسٌ قَرِيبًا مِنْهُ ، فَأَتَاهُ رَجُلَانِ مِنَ  الْقَوْمِ  فَمَرَّا عَلَيْهِ تَحْتَ اللَّيْلِ ، فَسَأَلَاهُ عَنْ قَصْدِهِمَا فَسَمَتَ لَهُمَا بِيَدِهِ ، قَالَ : هَذَا قَصْدُكُمَا ، وَقَالَ : هَذَا قَصْدُكُمَا حَيْثُ تُرِيدَانِ ، فَسَارَا غَيْرَ بَعِيدٍ ، قَالَ أَحَدُهُمَا : مَا يُسْكِنُ هَذَا الرَّجُلَ هَاهُنَا ، أَرْضٌ لَا أَنِيسَ بِهَا وَلَا وَحْشَ ، لَوْ رَجَعْنَا إِلَيْهِ حَتَّى نَعْلَمَ عِلْمَهُ قَالَ : فَرَجَعَا ، فَقَالَا لَهُ : يَا عَبْدَ اللهِ ، مَا يُقِيمُكَ بِهَذَا الْمَكَانِ بِأَرْضٍ لَا أَنِيسَ بِهَا وَلَا وَحْشَ قَالَ : امْضِيَا لِشَأْنِكُمَا وَدَعَانِي ، فَأَبَيَا وَأَلَحَّا عَلَيْهِ ، قَالَ : فَإِنِّي مُخْبِرُكُمَا عَلَى أَنَّ مَنْ كَتَمَهُ عَلَيَّ مِنْكُمَا أَكْرَمَهُ اللهُ فِي الدُّنْيَا وَالْآخِرَةِ ، وَمَنْ أَظْهَرَ عَلَيَّ مِنْكُمَا أَهَانَهُ اللهُ فِي الدُّنْيَا وَالْآخِرَةِ ، قَالَا : نَعَمْ "" .  قَالَ : فَنَزَلَا ، فَلَمَّا أَصْبَحَا خَرَجَ الْخَارِجُ مِنَ الْأَرْضِ مِثْلَ الَّذِي كَانَ يُخْرِجُ مِنَ الطَّعَامِ وَمِثْلَيْهِ مَعَهُ ، فَأَكَلُوا حَتَّى شَبِعُوا ، ثُمَّ دَخَلَ فَخَرَجَ إِلَيْهِمْ بِشَرَابٍ فِي إِنَاءٍ مِثْلِ الَّذِي كَانَ يَخْرُجُ بِهِ كُلَّ يَوْمٍ وَمِثْلَيْهِ مَعَهُ ، فَشَرِبُوا حَتَّى رَوَوْا ، ثُمَّ دَخَلَ وَالْتَأَمَتِ الْأَرْضُ ، قَالَ : فَنَظَرَ أَحَدُهُمَا إِلَى صَاحِبِهِ ، فَقَالَ : مَا يُعَجِّلُنَا ! هَذَا طَعَامٌ وَشَرَابٌ ، وَقَدْ عَلِمْنَا سَمْتَنَا مِنَ الْأَرْضِ ، امْكُثْ إِلَى الْعَشَاءِ ، فَمَكَثَا فَخَرَجَ إِلَيْهِمْ         [7/282]      مِنَ الْعَشَاءِ مِنَ الطَّعَامِ وَالشَّرَابِ مِثْلُ الَّذِي خَرَجَ أَوَّلَ النَّهَارِ ، فَقَالَ أَحَدُهُمَا لِصَاحِبِهِ : امْكُثْ بِنَا حَتَّى نُصْبِحَ ، فَمَكَثَا ، فَلَمَّا أَصْبَحُوا خَرَجَ إِلَيْهِمَا مِثْلُ ذَلِكَ ، ثُمَّ رَكِبَا فَانْطَلَقَا ، فَأَمَّا أَحَدُهُمَا فَلَزِمَ بَابَ الْمَلِكِ حَتَّى كَانَ مِنْ خَاصَّتِهِ وَسَمَرِهِ ، وَأَمَّا الْآخَرُ فَأَقْبَلَ عَلَى تِجَارَتِهِ وَعَمَلِهِ .  وَكَانَ ذَلِكَ الْمَلِكُ لَا يَكْذِبُ أَحَدٌ فِي زَمَانِهِ مِنْ أَهْلِ مَمْلَكَتِهِ كَذِبَةً يُعْرَفُ بِهَا إِلَّا صَلَبَهُ ، فَبَيْنَا هُمْ لَيْلَةً فِي  السَّمَرِ  يُحَدِّثُونَهُ مِمَّا رَأَوْا مِنَ الْعَجَائِبِ ، أَنْشَأَ ذَلِكَ  الرَّجُلُ  يُحَدِّثُ ، قَالَ : لَأُحَدِّثَنَّكَ أَيُّهَا الْمَلِكُ بِحَدِيثٍ مَا سَمِعْتَ أَعْجَبَ مِنْهُ قَطُّ ، فَحَدَّثَ حَدِيثَ ذَلِكَ الرَّجُلِ الَّذِي رَأَى مِنْ أَمْرِهِ . قَالَ الْمَلِكُ : مَا سَمِعْتُ بِكَذِبٍ قَطُّ أَعْظَمَ مِنْ هَذَا ، وَاللهِ لَتَأْتِيَنِّي عَلَى مَا قُلْتَ بِبَيِّنَةٍ أَوْ لَأَصْلُبَنَّكَ ، قَالَ : بَيِّنَتِي  فُلَانٌ  ، قَالَ : رِضًى ، ائْتُونِي بِهِ ، فَلَمَّا أَتَاهُ قَالَ لَهُ الْمَلِكُ : إِنَّ هَذَا قَالَ : إِنَّكُمَا مَرَرْتُمَا بِرَجُلٍ ، ثُمَّ كَانَ مِنْ أَمْرِهِ كَذَا وَكَذَا ؟ قَالَ الرَّجُلُ : أَيُّهَا الْمَلِكُ ، أَوَلَسْتَ تَعْلَمُ أَنَّ هَذَا كَذِبٌ ، وَهَذَا مَا لَا يَكُونُ ، وَلَوْ أَنِّي حَدَّثْتُكَ بِهَذَا كَانَ عَلَيْكَ فِي الْحَقِّ أَنْ تَصْلُبَنِي عَلَيْهِ ؟ قَالَ : صَدَقْتَ وَبَرَرْتَ "" .  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَأَدْخَلَ الرَّجُلَ الَّذِي كَتَمَ عَلَيْهِ فِي خَاصَّتِهِ وَسَمَرِهِ ، وَأَمَرَ بِالْآخَرِ فَصُلِبَ "" ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" فَأَمَّا الَّذِي كَتَمَ عَلَيْهِ مِنْهُمَا فَقَدْ أَكْرَمَهُ اللهُ فِي الدُّنْيَا وَالْآخِرَةِ ، وَأَمَّا الَّذِي أَظْهَرَ عَلَيْهِ مِنْهُمَا فَقَدْ أَهَانَهُ اللهُ فِي الدُّنْيَا ، وَهُوَ مُهِينُهُ فِي الْآخِرَةِ "" .  ثُمَّ نَظَرَ  بَكْرُ بْنُ عَبْدِ اللهِ  إِلَى  ثُمَامَةَ بْنِ عَبْدِ اللهِ بْنِ أَنَسٍ  ، فَقَالَ : يَا  أَبَا الْمُثَنَّى  ، أَسَمِعْتَ جَدَّكَ يُحَدِّثُ هَذَا عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" نَعَمْ ""  .","","Al-Mu'jam al-Awsat 7500","","أنس بن مالك عن بكر بن عبد الله المزني عن المفضل بن فضالة بن أبي أمية العمري عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","محمد بن شعيب الأصبهاني"
"7507","[7/283]      7501  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ الْأَصْبَهَانِيُّ ،  نَا  عَبْدُ اللهِ بْنُ عِمْرَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  حَدَّثَنِي  هِشَامُ بْنُ زِيَادٍ ،  عَنْ  أَخِيهِ الْوَلِيدِ بْنِ زِيَادٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مِنْ بِرِّ الرَّجُلِ أَبَاهُ بَعْدَ مَوْتِهِ حِفْظُهُ أَهْلَ وُدِّ أَبِيهِ مِنْ بَعْدِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْوَلِيدِ بْنِ زِيَادٍ  إِلَّا أَخُوهُ ،  تَفَرَّدَ بِهِ  :  أَبُو دَاوُدَ  ""  .","","Al-Mu'jam al-Awsat 7501","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الوليد بن أبي هشام القرشي عن هشام بن زياد بن أبي يزيد العثماني عن أبو داود الطيالسي عن عبد الله بن عمران بن أبي علي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7508","7502  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْوَهَّابِ الصَّيْرَفِيُّ ،  نَا  إِسْحَاقُ بْنُ يُوسُفَ الْأَزْرَقُ ،  عَنْ  أَبِي جَنَابٍ الْكَلْبِيِّ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَةَ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ يَوْمًا لَمْ يَخْرِقْهُ كُتِبَتْ لَهُ عَشْرُ حَسَنَاتٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ  إِلَّا  أَبُو جَنَابٍ  ، وَلَا عَنْ  أَبِي جَنَابٍ  إِلَّا  إِسْحَاقُ الْأَزْرَقُ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْوَهَّابِ  ""  .","","Al-Mu'jam al-Awsat 7502","","البراء بن عازب الأوسي عن عبد الرحمن بن عوسجة النهمي عن طلحة بن مصرف الهمداني عن يحيى بن أبي حية عن إسحاق بن يوسف الأزرق عن عبد الرحمن بن عبد الوهاب الصيرفي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7509","7503  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  ثَنَا  عَمْرُو بْنُ مَالِكٍ الرَّاسِبِيُّ ،  نَا  فُضَيْلُ بْنُ سُلَيْمَانَ ،  نَا  يَزِيدُ بْنُ سَعِيدِ بْنِ أَبِي الْيَسَرِ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  قَالَ :  قَالَ  مُعَاذٌ : يَا رَسُولَ اللهِ ، مُرْنِي بِعَمَلٍ يُدْخِلُنِي الْجَنَّةَ قَالَ :  آمِنْ بِاللهِ ، وَقُلْ خَيْرًا يُكْتَبْ لَكَ ، وَلَا تَقُلْ شَرًّا فَيُكْتَبْ عَلَيْكَ  قَالَ : وَإِنَّا لَنُؤَاخَذُ بِمَا نَتَكَلَّمُ بِهِ ؟ فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" وَهَلْ يَكُبُّ النَّاسَ عَلَى مَنَاخِرِهِمْ فِي النَّارِ إِلَّا  حَصَائِدُ  أَلْسِنَتِهِمْ ؟  .         [7/284]      "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي الْيَسَرِ بْنِ عَمْرٍو  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  عَمْرُو بْنُ مَالِكٍ  ""  .","","Al-Mu'jam al-Awsat 7503","","معاذ بن جبل عن كعب بن عمرو بن عباد البدري عن أبي عن يزيد بن سعيد بن أبي اليسر عن فضيل بن سليمان النميري عن عمرو بن مالك بن عمر الراسبي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7510","7504  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  عَمْرُو بْنُ مَالِكٍ الرَّاسِبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ مَسْمُولٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي سَبْرَةَ ،  أَخْبَرَنِي  الْقَاسِمُ بْنُ أَبِي أَشْمَطَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي حِسْلٍ - أَحَدِ بَنِي عَامِرِ بْنِ لُؤَيٍّ -  قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَجَّتِهِ - وَنَحْنُ مَعَهُ - عَلَى  رَجُلٍ  وَقَدْ فَرَغَ مِنْ حَجِّهِ ، فَقَالَ لَهُ :  أَسَلِمَ لَكَ حَجُّكَ ؟  قَالَ : نَعَمْ يَا رَسُولَ اللهِ ، قَالَ : "" ائْتَنِفِ الْعَمَلَ "" .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  حِسْلٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ مَسْمُولٍ  ""  .","","Al-Mu'jam al-Awsat 7504","","حسل العامري عن أبي عن القاسم بن أبي أشمط عن أبو بكر بن عبد الله بن محمد بن أبي سبرة عن محمد بن سليمان المسمولي عن عمرو بن مالك بن عمر الراسبي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7511","7505  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ السَّمَّانُ ،  نَا  زِيَادُ بْنُ مَيْمُونٍ ،  حَدَّثَنِي  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ دُعِيَ إِلَى وَلِيمَةٍ فَلَمْ يُجِبْ فَقَدْ عَصَى اللهَ وَرَسُولَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامٍ  إِلَّا  زِيَادُ بْنُ مَيْمُونٍ  ،  تَفَرَّدَ بِهِ  :  سَعِيدُ بْنُ أَبِي الرَّبِيعِ  ""  .","","Al-Mu'jam al-Awsat 7505","","أبو هريرة الدوسي عن محمد بن سيرين عن هشام بن حسان العتكي عن زياد الفاكهي عن سعيد بن أبى الربيع السمان عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7512","7506  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  هُرَيْمُ بْنُ عَبْدِ الْأَعْلَى  ، نَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  سَمِعْتُ  أَبِي  ،  يُحَدِّثُ ، عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْحَجَّاجِ ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ قَالَ :  جَاءَ رَجُلٌ مَرَّةً فَاسْتَأْذَنَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ائْذَنْ لَهُ ، وَبَشِّرْهُ بِالْجَنَّةِ  ، فَإِذَا هُوَ  أَبُو بَكْرٍ  ، ثُمَّ جَاءَ رَجُلٌ         [7/285]      آخَرُ ، فَقَالَ : "" ائْذَنْ لَهُ ، وَبَشِّرْهُ بِالْجَنَّةِ "" ، فَإِذَا هُوَ  عُمَرُ  ، ثُمَّ جَاءَ آخَرُ فَاسْتَأْذَنَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" ائْذَنْ لَهُ ، وَبَشِّرْهُ بِالْجَنَّةِ فِي بَلْوَى "" - أَوْ كَمَا قَالَ - فَقَالَ  عُثْمَانُ  : "" أَسْأَلُ اللهَ صَبْرًا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  ، عَنْ  أَبِي الْحَجَّاجِ  إِلَّا  سُلَيْمَانُ التَّيْمِيُّ  "" .  وَرَوَاهُ  مَعْمَرٌ  ، عَنْ  قَتَادَةَ  ، عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ  .","","Al-Mu'jam al-Awsat 7506","","أبو موسى الأشعري عن مجاهد بن جبر المخزومي عن قتادة بن دعامة عن سليمان بن طرخان عن معتمر بن سليمان عن هريم بن عبد الأعلى الأسدي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7513","7507  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ السَّمَّانُ ،  نَا  سَعِيدُ بْنُ سَلَمَةَ بْنِ أَبِي الْحُسَامِ ،  نَا  شَرِيكُ بْنُ عَبْدِ اللهِ بْنِ أَبِي نَمِرٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ الْمِيَاهَ كَانَتْ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَلِيلَةً ، وَكَانَ إِذَا كَانَ الصَّيْفُ صَلَّى النَّاسُ الظُّهْرَ ثُمَّ خَرَجُوا يَتَرَوَّحُونَ ، فَصَلَّى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ ، ثُمَّ خَرَجَ وَخَرَجُوا مَعَهُ إِلَى فِنَاءِ الْمَسْجِدِ ، فَمَكَثَ حَتَّى إِذَا كَانَ مَعَ  النِّدَاءِ  أَرْسَلَنِي إِلَى بَيْتِ  أُمِّ سَلَمَةَ  آتِيهِ بِوَضُوءٍ ، فَدَخَلْتُ فَجِئْتُهُ بِقَدَحٍ فِيهِ  ثُلُثَاهُ أَوْ نِصْفُهُ  ، فَتَوَضَّأَ ، فَلَمَّا فَرَغَ مِنْ وُضُوئِهِ فَضَلَ فِي الْقَدَحِ مِنْ وَضُوئِهِ فَضْلٌ ، فَرَفَعَ رَأْسَهُ فَرَأَى النَّاسَ قِيَامًا ، فَقَالَ : "" مَا هَؤُلَاءِ ؟ "" قَالَ  أَنَسٌ  : قُلْتُ :  يَا رَسُولَ اللهِ ، إِنَّهُمْ لَا يَجِدُونَ مَا يَتَوَضَّئُونَ ، قَالَ : "" ادْعُهُمْ  ، فَفَعَلْتُ ، فَجَاءَ النَّاسُ ، فَأَدْخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدَهُ فِي الْقَدَحِ فِي فَضْلِهِ الَّذِي فَضَلَ مِنْ وَضُوئِهِ ، فَوَالَّذِي نَفْسِي بِيَدِهِ مَا بَقِيَ مِنْهُمْ إِنْسَانٌ إِلَّا  تَوَضَّأَ  مِمَّا فِي كَفِّ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَفَضَلَ فِي الْقَدَحِ فَضْلَةٌ ، فَرَجَعْتُ بِهِ إِلَى الْبَيْتِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شَرِيكِ بْنِ أَبِي نَمِرٍ  إِلَّا  سَعِيدُ بْنُ سَلَمَةَ  ""  .","","Al-Mu'jam al-Awsat 7507","","أنس بن مالك عن شريك بن عبد الله بن أبي نمر الكناني عن سعيد بن سلمة السدوسي عن سعيد بن أبى الربيع السمان عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7514","7508  - =  وَبِهِ  :  حَدَّثَنَا  سَعِيدُ بْنُ سَلَمَةَ ،  ثَنَا  يَزِيدُ بْنُ خُصَيْفَةَ ،  عَنِ  ابْنِ سَلَمَةَ بْنِ الْأَكْوَعِ ،  عَنْ  سَلَمَةَ قَالَ :  كُنْتُ أُسَافِرُ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَمَا رَأَيْتُهُ صَلَّى بَعْدَ الْعَصْرِ وَلَا بَعْدَ الصُّبْحِ قَطُّ  .         [7/286]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ سَلَمَةَ  إِلَّا  يَزِيدُ بْنُ خُصَيْفَةَ  ،  تَفَرَّدَ بِهِ  :  سَعِيدُ بْنُ سَلَمَةَ  ""  .","","Al-Mu'jam al-Awsat 7508","","سلمة بن عمرو بن الأكوع الأسلمي عن إياس بن سلمة بن الأكوع الأسلمي عن يزيد بن عبد الله بن خصيفة الكندي عن سعيد بن سلمة السدوسي عن سعيد بن أبى الربيع السمان عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7515","7509  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ السَّمَّانُ ،  نَا  مُحَمَّدُ بْنُ دِينَارٍ ،  ثَنَا  خَالِدُ بْنُ ذَكْوَانَ ،  نَا  بُشَيْرُ بْنُ كَعْبٍ ،  عَنْ  أَبِي ذَرٍّ ،  أَنَّهُ سُئِلَ : هَلْ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَافِحُ ؟ فَقَالَ :  مَا لَقِيَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ مَرَّةٍ فَسَلَّمْتُ عَلَيْهِ إِلَّا صَافَحَنِي  ، غَيْرَ مَرَّةٍ وَاحِدَةٍ وَكَانَتْ أَجْوَدَهَا ، دَخَلْتُ عَلَيْهِ وَهُوَ مَرِيضٌ ، فَأَكْبَبْتُ عَلَيْهِ ، فَالْتَزَمَنِي "" .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي ذَرٍّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  سَعِيدُ بْنُ أَبِي الرَّبِيعِ  ""  .","","Al-Mu'jam al-Awsat 7509","","أبو ذر الغفاري عن بشير بن كعب الحميري عن خالد بن ذكوان المدني عن محمد بن دينار الطاحي عن سعيد بن أبى الربيع السمان عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7516","7510  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ ،  نَا  مُحَمَّدُ بْنُ دِينَارٍ ،  نَا  سَعْدُ بْنُ أَوْسٍ ،  نَا  سَيَّارُ بْنُ مِخْرَاقٍ قَالَ :  سَأَلْتُ  ابْنَ عُمَرَ عَنْ صِيَامِ الْمُسَافِرِ ؟ فَقَالَ :  خَرَجَ رَسُولُ اللهِ لِأَرْبَعَ عَشْرَةَ خَلَتْ مِنْ رَمَضَانَ ، فَأَنَاخَ رَاحِلَتَهُ ، وَوَضَعَ إِحْدَى رِجْلَيْهِ فِي  الْغَرْزِ  وَالْأُخْرَى فِي الْأَرْضِ ، ثُمَّ دَعَا بِلَبَنٍ مِنْ لَبَنِهَا ، فَشَرِبَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَيَّارِ بْنِ مِخْرَاقٍ  إِلَّا  سَعْدُ بْنُ أَوْسٍ  ، وَلَا عَنْ  سَعْدٍ  إِلَّا  مُحَمَّدُ بْنُ دِينَارٍ  ،  تَفَرَّدَ بِهِ  :  سَعِيدُ بْنُ أَبِي الرَّبِيعِ  ""  .","","Al-Mu'jam al-Awsat 7510","","عبد الله بن عمر بن الخطاب عن سيار بن مخراق عن سعد بن أوس زوج نضرة بنت أبي نضرة عن محمد بن دينار الطاحي عن سعيد بن أبى الربيع السمان عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7517","7511  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  سَعِيدُ بْنُ أَبِي الرَّبِيعِ ،  نَا  سَعِيدُ بْنُ سَلَمَةَ بْنِ أَبِي الْحُسَامِ ،  حَدَّثَنِي  يَزِيدُ بْنُ خُصَيْفَةَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ نَزَعَ يَدًا مِنْ جَمَاعَةٍ جَاءَ         [7/287]      يَوْمَ الْقِيَامَةِ وَلَا حُجَّةَ لَهُ  ، وَمَنْ مَاتَ فِي غَيْرِ طَاعَةٍ مَاتَ  مِيتَةً  جَاهِلِيَّةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ بْنِ الْأَصَمِّ  إِلَّا  يَزِيدُ بْنُ خُصَيْفَةَ  ، وَلَا عَنْ  يَزِيدَ  إِلَّا  سَعِيدُ بْنُ سَلَمَةَ  ،  تَفَرَّدَ بِهِ  :  سَعِيدُ بْنُ أَبِي الرَّبِيعِ  ""  .","","Al-Mu'jam al-Awsat 7511","","عبد الله بن عمر بن الخطاب عن يزيد بن الأصم بن عبيد البكائي عن يزيد بن عبد الله بن خصيفة الكندي عن سعيد بن سلمة السدوسي عن سعيد بن أبى الربيع السمان عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7518","7512  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  سُلَيْمَانُ الشَّاذَكُونِيُّ ،  ثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى ،  ثَنَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى أَنْ يُرْكَبَ ثَلَاثَةٌ عَلَى دَابَّةٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  إِلَّا  أَبُو أُمَيَّةَ بْنُ يَعْلَى  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7512","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن إسماعيل بن يعلى الثقفي عن الشاذكوني عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7519","7513  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  الشَّاذَكُونِيُّ ،  ثَنَا  النَّضْرُ بْنُ إِسْمَاعِيلَ الْبَجَلِيُّ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  دَاوُدَ ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ عَبَّاسٍ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْبُزَاقُ فِي الْمَسْجِدِ خَطِيئَةٌ ، وَكَفَّارَتُهُ دَفْنُهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  دَاوُدَ بْنِ عَلِيٍّ  إِلَّا  ابْنُ أَبِي لَيْلَى  ، وَلَا عَنِ  ابْنِ أَبِي لَيْلَى  إِلَّا  النَّضْرُ بْنُ إِسْمَاعِيلَ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7513","","عبد الله بن عباس عن علي بن عبد الله بن عباس بن عبد المطلب عن داود بن علي الهاشمي عن محمد بن عبد الرحمن بن أبي ليلى عن النضر بن إسماعيل بن حازم البجلي عن الشاذكوني عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7520","7514  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  عِيسَى بْنُ مَيْمُونٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ ، -  وَعَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ عُمَرَ - ، قَالَا :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَعْصُوبًا رَأْسُهُ ، فَرَقَى دَرَجَاتِ الْمِنْبَرِ ، فَقَالَ :  مَا هَذِهِ الْكُتُبُ الَّتِي بَلَغَنِي أَنَّكُمْ تَكْتُبُونَهَا  ؟ أَكِتَابٌ مَعَ كِتَابِ اللهِ ؟  يُوشِكُ  أَنْ يَغْضَبَ اللهُ لِكِتَابِهِ فَيُسْرَى عَلَيْهِ لَيْلًا ، فَلَا يَتْرُكَ فِي وَرَقَةٍ وَلَا قَلْبٍ مِنْهُ حَرْفًا إِلَّا ذَهَبَ بِهِ "" فَقَالَ مَنْ حَضَرَ الْمَجْلِسَ :         [7/288]      فَكَيْفَ يَا رَسُولَ اللهِ بِالْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ؟ قَالَ : "" مَنْ أَرَادَ اللهُ بِهِ خَيْرًا أَبْقَى فِي قَلْبِهِ لَا إِلَهَ إِلَّا اللهُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا  عِيسَى بْنُ مَيْمُونٍ  ،  تَفَرَّدَ بِهِ  :  شَيْبَانُ  "" .","","Al-Mu'jam al-Awsat 7514","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن عيسى بن ميمون الواسطي عن شيبان بن فروخ الحبطي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7521","7515  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَرَسٌ ، يُقَالُ لَهُ :  الْمُرْتَجِزُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَدِيٍّ  إِلَّا  إِدْرِيسُ  ، وَلَا عَنْ  إِدْرِيسَ  إِلَّا ابْنُهُ ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7515","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن عدي بن ثابت الظفري عن إدريس بن يزيد الزعافري عن عبد الله بن إدريس الأودي عن الشاذكوني عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7522","7516  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ الْعُرُوقِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  حَدَّثَنِي  إِسْحَاقُ بْنُ جَعْفَرٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْكِنَانِيُّ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِي لُبَابَةَ بْنِ عَبْدِ الْمُنْذِرِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا أَرَادَ دُخُولَ قَرْيَةٍ ، لَمْ يَدْخُلْهَا حَتَّى يَقُولَ :  اللَّهُمَّ رَبَّ السَّمَاوَاتِ السَّبْعِ وَمَا أَظَلَّتْ  ، وَرَبَّ الْأَرَضِينَ السَّبْعِ وَمَا أَقَلَّتْ ، وَرَبَّ الرِّيَاحِ وَمَا أَذْرَتْ ، وَرَبَّ الشَّيَاطِينِ وَمَا أَضَلَّتْ ، إِنِّي أَسْأَلُكَ خَيْرَهَا ، وَخَيْرَ مَا فِيهَا ، وَأَعُوذُ بِكَ مِنْ شَرِّهَا ، وَشَرِّ مَا فِيهَا  .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي لُبَابَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ الْعُرُوقِيُّ  "" .","","Al-Mu'jam al-Awsat 7516","","أبو لبابة بن عبد المنذر الأنصاري عن عامر بن عبد الله بن الزبير بن العوام عن محمد بن عبد الله الكتاني عن إسحاق بن جعفر بن محمد الجعفري الحزين عن يعقوب بن محمد بن عيسى عن إبراهيم بن المستمر العروقي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7523","7517  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  فَاطِمَةَ بِنْتِ الْمُنْذِرِ ،         [7/289]      عَنْ  أُمِّ سَلَمَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يُحَرِّمُ مِنَ الرَّضَاعِ إِلَّا مَا فَتَقَ الْأَمْعَاءَ  ، وَكَانَ فِي الْبَدَنِ مِثْلَ الطَّعَامِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  أَبُو عَوَانَةَ  ،  تَفَرَّدَ بِهِ  :  أَبُو كَامِلٍ  "" .","","Al-Mu'jam al-Awsat 7517","","هند بنت أبي أمية زوج رسول الله عن فاطمة بنت المنذر بن الزبير بن العوام عن هشام بن عروة بن الزبير عن الوضاح بن عبد الله اليشكري عن فضيل بن حسين الجحدري عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7524","7518  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  إِبْرَاهِيمُ بْنُ سَلْمِ بْنِ رُشَيْدٍ ،  نَا  عُمَرُ بْنُ حَبِيبٍ الْقَاضِي ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كُنَّ لَهُ ابْنَتَانِ أَوْ أُخْتَانِ أَوْ عَمَّتَانِ أَوْ خَالَتَانِ  فَعَالَهُنَّ  ، فُتِحَتْ لَهُ الثَّمَانِيَةُ أَبْوَابِ الْجَنَّةِ ، يَا عِبَادَ اللهِ أَغِيثُوهُ ، يَا عِبَادَ اللهِ أَعْطُوهُ ، يَا عِبَادَ اللهِ أَقْرِضُوهُ  .","","Al-Mu'jam al-Awsat 7518","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمر بن حبيب بن محمد العدوي عن إبراهيم بن سلم الهجيمي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7525","7519  - =  وَبِهِ  :  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَدْخَلَ عَلَى أَهْلِ بَيْتٍ مِنَ الْمُسْلِمِينَ سُرُورًا  لَمْ يَرْضَ اللهُ لَهُ ثَوَابًا دُونَ الْجَنَّةِ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  عُمَرُ بْنُ حَبِيبٍ  ،  تَفَرَّدَ بِهِمَا  :  إِبْرَاهِيمُ بْنُ سَلْمٍ  "" .","","Al-Mu'jam al-Awsat 7519","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عمر بن حبيب بن محمد العدوي عن إبراهيم بن سلم الهجيمي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7526","7520  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  إِبْرَاهِيمُ بْنُ سَلْمٍ ،  نَا  هَاشِمُ بْنُ مُوسَى الْخَصَّافُ ،  نَا  سُلَيْمَانُ بْنُ عَلِيِّ بْنِ عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي  قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ أَمْسَى كَالًّا مِنْ عَمَلِ يَدَيْهِ أَمْسَى مَغْفُورًا لَهُ  .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنِ  ابْنِ عَبَّاسٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  إِبْرَاهِيمُ بْنُ سَلْمٍ  "" .","","Al-Mu'jam al-Awsat 7520","","عبد الله بن عباس عن علي بن عبد الله بن عباس بن عبد المطلب عن سليمان بن علي بن عبد الله بن عباس بن عبد المطلب عن هاشم بن موسى الخصاف عن إبراهيم بن سلم الهجيمي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7527","[7/290]      7521  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  زُنَيْجٌ أَبُو غَسَّانَ ،  نَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  عَنِ  الْمُغِيرَةِ بْنِ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَمَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نَسْجُدَ عَلَى سَبْعَةِ أَعْضَاءٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْمُغِيرَةِ بْنِ مُسْلِمٍ  إِلَّا  إِسْحَاقُ بْنُ سُلَيْمَانَ  "" .","","Al-Mu'jam al-Awsat 7521","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن المغيرة بن مسلم القسملي عن إسحاق بن سليمان الرازي عن محمد بن عمرو بن بكر بن سالم عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7528","7522  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  نَا  زُنَيْجٌ ،  ثَنَا  إِسْحَاقُ ،  عَنْ  إِبْرَاهِيمَ بْنِ يَزِيدَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كُنَّا نَأْكُلُ وَنَشْرَبُ وَنُخْرِجُ صَدَقَةَ الْفِطْرِ  ، ثُمَّ نَخْرُجُ إِلَى الْمُصَلَّى  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمْرِو بْنِ دِينَارٍ  إِلَّا  إِبْرَاهِيمُ بْنُ يَزِيدَ  ،  تَفَرَّدَ بِهِ  :  إِسْحَاقُ بْنُ سُلَيْمَانَ  ""  .","","Al-Mu'jam al-Awsat 7522","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عمرو بن دينار الأثرم عن إبراهيم بن يزيد الخوزي عن إسحاق بن سليمان الرازي عن محمد بن عمرو بن بكر بن سالم عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7529","7523  -  حَدَّثَنَا  مُحَمَّدٌ ،  نَا  زُنَيْجٌ ،  ثَنَا  إِسْحَاقُ ،  عَنِ  الْمُغِيرَةِ بْنِ زِيَادٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ الْجُمُعَةِ يَقُومُ عَلَى الْمِنْبَرِ قَوْمَتَيْنِ  ، وَيَجْلِسُ جَلْسَتَيْنِ ، كَانَ إِذَا خَرَجَ جَلَسَ ، فَإِذَا أَذَّنَ الْمُؤَذِّنُ قَامَ فَخَطَبَ ، ثُمَّ جَلَسَ فَاسْتَرَاحَ ، ثُمَّ قَامَ فَخَطَبَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْمُغِيرَةِ بْنِ زِيَادٍ  إِلَّا  إِسْحَاقُ بْنُ سُلَيْمَانَ  .","","Al-Mu'jam al-Awsat 7523","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن المغيرة بن زياد البجلي عن إسحاق بن سليمان الرازي عن محمد بن عمرو بن بكر بن سالم عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7530","7524  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ رُسْتَهْ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِمْرَانَ ،  نَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  حَدَّثَنِي  مَعْمَرُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  ابْنِ قُسَيْطٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  جَاءَ  بِلَالٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُؤْذِنُهُ بِصَلَاةِ الصُّبْحِ ، فَقَالَ :  مُرُوا  أَبَا بَكْرٍ  فَلْيُصَلِّ بِالنَّاسِ  ، فَعَادَ إِلَيْهِ ، فَرَأَى مِنْهُ ثِقْلَةً ، فَقَالَ : "" مُرُوا  أَبَا بَكْرٍ  فَلْيُصَلِّ بِالنَّاسِ "" ، فَذَهَبَ فَأَذَّنَ ، فَزَادَ فِي أَذَانِهِ : الصَّلَاةُ خَيْرٌ مِنَ النَّوْمِ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا هَذَا الَّذِي زِدْتَ فِي أَذَانِكَ ؟ "" قَالَ : رَأَيْتُ مِنْكَ ثِقْلَةً         [7/291]      فَأَحْبَبْتُ أَنْ تَنْشُطَ ، فَقَالَ : "" اذْهَبْ فَزِدْهُ فِي أَذَانِكَ ، وَمُرْ  أَبَا بَكْرٍ  فَلْيُصَلِّ بِالنَّاسِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ قُسَيْطٍ  إِلَّا  مَعْمَرٌ  ، وَلَا عَنْ  مَعْمَرٍ  إِلَّا  عَبْدُ اللهِ بْنُ نَافِعٍ  "" .","","Al-Mu'jam al-Awsat 7524","","أبو هريرة الدوسي عن يزيد بن عبد الله بن قسيط الليثي عن معمر بن عبد الرحمن عن عبد الله بن نافع الصائغ عن عبد الله بن عمران بن رزين العابدي عن محمد بن عبد الله بن رسته الضبي عن الطبراني","محمد بن عبد الله بن رسته الأصبهاني"
"7531","7525  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رَاشِدِ بْنِ يَزِيدَ الْأَصْبَهَانِيُّ  ،  نَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  نَا  شُعْبَةُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَلَا هَذِهِ الْآيَةَ :         {      اتَّقُوا اللهَ حَقَّ تُقَاتِهِ وَلا تَمُوتُنَّ إِلا وَأَنْتُمْ مُسْلِمُونَ         }      فَقَالَ :  لَوْ أَنَّ قَطْرَةً مِنَ  الزَّقُّومِ  قَطَرَتْ فِي بِحَارِ الدُّنْيَا  لَأَفْسَدَتْ عَلَى أَهْلِ الدُّنْيَا مَعَايِشَهُمْ ، فَكَيْفَ مَنْ يَكُونُ طَعَامَهُ ؟ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا  شُعْبَةُ  ""  .  كذا في طبعة دار الحرمين ، ولعل الصواب: ( محمد بن أسد بن يزيد الأصبهاني) كذا هو في المعجم الكبير والصغير.","","Al-Mu'jam al-Awsat 7525","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الأعمش عن شعبة بن الحجاج عن أبو داود الطيالسي عن ابن أسد محمد بن أسد بن يزيد الأصبهاني عن الطبراني","محمد بن راشد بن يزيد الأصبهاني"
"7532","7526  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ شَبِيبٍ الْعَسَّالُ الْأَصْبَهَانِيُّ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  أَبُو مَرْيَمَ عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ ،  نَا  يَزِيدُ بْنُ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى قَالَ :  قَالَ  عَمَّارٌ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  إِلَّا  يَزِيدُ بْنُ أَبِي زِيَادٍ  ،  تَفَرَّدَ بِهِ  :  أَبُو مَرْيَمَ  "" .","","Al-Mu'jam al-Awsat 7526","","عمار بن ياسر عن عبد الرحمن بن أبي ليلى عن يزيد بن أبي زياد القرشي عن عبد الغفار بن القاسم الأنصاري عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7533","7527  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ شَبِيبٍ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  زَائِدَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  وَقَصَتْ  رَجُلًا  مُحْرِمًا نَاقَتُهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اغْسِلُوهُ بِمَاءٍ وَسِدْرٍ ، وَكَفِّنُوهُ فِي ثَوْبَيْهِ  ، وَلَا تُحَنِّطُوهُ ، وَلَا تُغَطُّوا وَجْهَهُ ، فَإِنَّهُ يُبْعَثُ يَوْمَ الْقِيَامَةِ يُلَبِّي "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَنْصُورٍ  إِلَّا  زَائِدَةُ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7527","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن منصور بن المعتمر عن زائدة بن قدامة عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7534","7528  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْعَسَّالُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ الشَّامِيُّ ،  ثَنَا         [7/292]      الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَعْزِيرَ فَوْقَ عَشَرَةِ أَسْيَاطٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَوْزَاعِيِّ  إِلَّا  الْوَلِيدُ  ،  تَفَرَّدَ بِهِ  :  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ الشَّامِيُّ  "" .","","Al-Mu'jam al-Awsat 7528","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن إبراهيم بن محمد الشامي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7535","7529  -  وَبِهِ  :  حَدَّثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ عَبْدٍ أَنْعَمَ اللهُ عَلَيْهِ نِعْمَةً فَأَسْبَغَهَا عَلَيْهِ  ، ثُمَّ جَعَلَ شَيْئًا مِنْ حَوَائِجِ النَّاسِ إِلَيْهِ فَتَبَرَّمَ ، فَقَدْ عَرَّضَ تِلْكَ النِّعْمَةَ لِلزَّوَالِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  الْوَلِيدُ  ،  وَمُحَمَّدُ بْنُ مَرْوَانَ السُّدِّيُّ  ،  تَفَرَّدَ بِهِ  عَنِ  الْوَلِيدِ  :  إِبْرَاهِيمُ بْنُ مُحَمَّدٍ الشَّامِيُّ  "" .","","Al-Mu'jam al-Awsat 7529","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن الوليد بن مسلم القرشي عن إبراهيم بن محمد بن يوسف الفريابي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7536","7530  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْعَسَّالُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بِحَسْبِ أَحَدِكُمْ أَنْ يَضَعَ يَدَهُ عَلَى فَخِذِهِ  ، وَيُسَلِّمَ عَلَى أَخِيهِ عَنْ يَمِينِهِ : السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ ، وَعَنْ شِمَالِهِ         [7/293]      مِثْلُ ذَلِكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سِمَاكٍ  إِلَّا  أَبُو الْأَحْوَصِ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7530","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7537","7531  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْعَسَّالُ ،  نَا  إِسْمَاعِيلُ بْنُ عَمْرٍو ،  ثَنَا  مُحَمَّدُ بْنُ مَرْوَانَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لِكُلِّ شَيْءٍ حِلْيَةٌ ، وَحِلْيَةُ الْقُرْآنِ حُسْنُ الصَّوْتِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  مُحَمَّدُ بْنُ مَرْوَانَ  "" .","","Al-Mu'jam al-Awsat 7531","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن محمد بن مروان السدي الصغير عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7538","7532  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  إِسْمَاعِيلُ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  لَيْثٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَتَمَ عِلْمًا عِنْدَهُ  أَلْجَمَهُ  اللهُ يَوْمَ الْقِيَامَةِ بِلِجَامٍ مِنْ نَارٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  لَيْثٍ  إِلَّا  أَبُو الْأَحْوَصِ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7532","","أبو هريرة الدوسي عن عطاء بن أبي رباح عن ليث بن أبي سليم عن سلام بن سليم الحنفي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7539","7533  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  نَا  إِسْمَاعِيلُ ،  نَا  أَبُو مَرْيَمَ ،  حَدَّثَنِي  إِيَاسُ بْنُ سَلَمَةَ بْنِ الْأَكْوَعِ ،  عَنْ  مُسْلِمِ بْنِ جَرْهَدٍ قَالَ :  مَرِضَ ابْنُ عُمَرَ ، فَقَالَ  رَجُلٌ  : يَا  أَبَا عَبْدِ الرَّحْمَنِ  ، قَدْ أَعْشَبَتِ الْقِفَارُ ، فَلَوِ ابْتَعْتَ أَعْنُزًا فَتَنَزَّهْتَ تَصِحُّ ،  فَقَالَ  :  لَمْ يُؤْذَنْ لِأَحَدٍ مِنَّا فِي الْبَدَاءِ غَيْرَ  أَسْلَمَ  .  لَمْ يَرْوِ  مُسْلِمُ بْنُ جَرْهَدٍ  عَنِ  ابْنِ عُمَرَ  حَدِيثًا غَيْرَ هَذَا ، وَلَا رَوَاهُ عَنْ  مُسْلِمٍ  إِلَّا  إِيَاسُ بْنُ سَلَمَةَ  ،  تَفَرَّدَ بِهِ  :  أَبُو مَرْيَمَ  "" .","","Al-Mu'jam al-Awsat 7533","","عبد الله بن عمر بن الخطاب عن مسلم بن جرهد بن رزاح عن إياس بن سلمة بن الأكوع الأسلمي عن عبد الغفار بن القاسم الأنصاري عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7540","7534  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  نَا  إِسْمَاعِيلُ ،  نَا  حَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  مَنْصُورٍ وَالْأَعْمَشِ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  كُرَيْبٍ ،         [7/294]      عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ أَنَّ أَحَدَكُمْ إِذَا أَتَى أَهْلَهُ قَالَ : اللَّهُمَّ جَنِّبْنَا الشَّيْطَانَ وَجَنِّبِ الشَّيْطَانَ مَا رَزَقْتَنَا  ، فَقُدِّرَ بَيْنَهُمَا وَلَدٌ ، لَمْ يَضُرَّهُ شَيْطَانٌ أَبَدًا  .  "" لَمْ  يَرْفَعْ  هَذَا الْحَدِيثَ أَحَدٌ مِمَّنْ رَوَاهُ عَنِ  الْأَعْمَشِ  إِلَّا  حَمَّادُ بْنُ شُعَيْبٍ  "" .","","Al-Mu'jam al-Awsat 7534","","عبد الله بن عباس عن كريب بن أبي مسلم الحجازي عن سالم بن أبي الجعد الغطفاني عن الأعمش عن حماد بن شعيب الحماني عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7541","7535  -  حَدَّثَنَا  مُحَمَّدٌ ،  ثَنَا  إِسْمَاعِيلُ ،  نَا  شَرِيكٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  أُهْدِيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ غَنَمًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  عَنْ  أَبِي الضُّحَى  إِلَّا  شَرِيكٌ  .  وَرَوَاهُ النَّاسُ : عَنِ  الْأَعْمَشِ  ، عَنْ  إِبْرَاهِيمَ  ، عَنِ  الْأَسْوَدِ  ، عَنْ  عَائِشَةَ  "" .","","Al-Mu'jam al-Awsat 7535","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن شريك بن عبد الله النخعي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7542","7536  -  حَدَّثَنَا  مُحَمَّدٌ ،  ثَنَا  إِسْمَاعِيلُ ،  نَا  شَرِيكٌ ،  عَنْ  يَحْيَى بْنِ هَانِئٍ ،  عَنْ  مَاجِدٍ الْحَنَفِيِّ ،  عَنِ  ابْنِ مَسْعُودٍ قَالَ :  سَأَلْنَا نَبِيَّنَا صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ السَّيْرِ بِالْجِنَازَةِ ، فَقَالَ :  السَّيْرُ بِهَا دُونَ  الْخَبَبِ  ، فَإِنْ يَكُ خَيْرًا تُعَجَّلْ لَهُ ، وَإِنْ يَكُ شَرًّا فَبُعْدًا لِأَصْحَابِ النَّارِ ، وَالْجِنَازَةُ مَتْبُوعَةٌ وَلَيْسَتْ بِتَابِعَةٍ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ هَانِئٍ  إِلَّا  شَرِيكٌ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  ، وَالْمَشْهُورُ مِنْ حَدِيثِ  يَحْيَى بْنِ الْحَارِثِ التَّيْمِيِّ الْجَابِرِ - وَيُقَالُ : الْمُجَبِّرُ  ، كَانَ يُجَبِّرُ - وَقَالَ فِي هَذَا الْحَدِيثِ : عَنْ  مَاجِدٍ  ، وَإِنَّمَا هُوَ :  أَبُو مَاجِدٍ  "" .","","Al-Mu'jam al-Awsat 7536","","عبد الله بن مسعود عن عائذ بن نضلة الحنفي عن يحيى بن هانئ بن عروة المرادي عن شريك بن عبد الله النخعي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7543","7537  -  حَدَّثَنَا  مُحَمَّدٌ ،  ثَنَا  إِسْمَاعِيلُ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عُمَيْرِ بْنِ عَبْدِ اللهِ ،  عَنْ  سَلِيطِ بْنِ عَبْدِ اللهِ ،  عَنْ  ذُهَيْلِ بْنِ عَوْفٍ ،         [7/295]      عَنْ  أَبِي هُرَيْرَةَ قَالَ :  بَيْنَمَا نَحْنُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ نَحْنُ بِإِبِلٍ  مُصَرَّاةٍ  تَلْجَأُ الشَّجَرَ ، لَيْسَ مَعَهَا رَاعٍ ، فَقَالَ بَعْضُنَا : لَوْ قُمْنَا فَحَلَبْنَا ، وَقَالَ بَعْضُهُمْ : كَيْفَ نَحْلُبُهَا وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِينَا لَا نَسْتَأْمِرُهُ ؟ فَقَالَ بَعْضُنَا : قَدْ سَكَتَ وَسُكُوتُهُ إِذْنٌ ، فَقُمْنَا إِلَيْهَا فَدَعَانَا ، فَقَالَ :  أَرَأَيْتُمْ لَوْ أَنَّ قَوْمًا أَتَوْكُمْ وَقَدْ نِمْتُمْ فَأَخَذُوا مَا فِي مَزَاوِدِكُمْ  ، أَضَرُّوا بِكُمْ ؟ "" قَالُوا : نَعَمْ ، قَالَ : "" فَإِنَّ مَا فِي  أَخْلَافِ  هَذِهِ الْإِبِلِ كَمَثَلِ مَا فِي مَزَاوِدِكُمْ "" ، قُلْنَا : يَا رَسُولَ اللهِ ، مَا يَحِلُّ لِلرَّجُلِ مِنْ مَالِ أَخِيهِ إِذَا افْتَقَرَ إِلَيْهِ ؟ قَالَ : "" يَأْكُلُ وَلَا يَحْمِلُ ، وَيَشْرَبُ وَلَا يَحْمِلُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَيْرِ بْنِ عَبْدِ اللهِ  إِلَّا  قَيْسُ بْنُ الرَّبِيعِ  "" .","","Al-Mu'jam al-Awsat 7537","","أبو هريرة الدوسي عن ذهيل بن عوف المجاشعي عن سليط بن عبد الله الطهوي عن عمير بن عبد الله بن بشر الخثعمي عن قيس بن الربيع الأسدي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7544","7538  -  حَدَّثَنَا  مُحَمَّدٌ ،  نَا  إِسْمَاعِيلُ ،  نَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَأَلَ النَّاسَ لِيُثْرِيَ مَالَهُ ، فَإِنَّمَا هُوَ جَمْرٌ مِنْ  جَهَنَّمَ  ، فَمَنْ شَاءَ فَلْيَسْتَكْثِرْ ، وَمَنْ شَاءَ فَلْيَسْتَقِلَّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي حَصِينٍ  إِلَّا  قَيْسٌ  "" .","","Al-Mu'jam al-Awsat 7538","","أبو هريرة الدوسي عن سالم بن أبي الجعد الغطفاني عن عثمان بن عاصم بن حصين عن قيس بن الربيع الأسدي عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7545","7539  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  إِسْمَاعِيلُ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  حَبِيبِ بْنِ حَسَّانَ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى يُتْبِعُ كُلَّ صَلَاةٍ مَكْتُوبَةٍ رَكْعَتَيْنِ  ، إِلَّا صَلَاةَ الصُّبْحِ ، فَإِنَّهُ كَانَ يَجْعَلُهُمَا قَبْلَهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حَبِيبِ بْنِ حَسَّانَ  إِلَّا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ""  .","","Al-Mu'jam al-Awsat 7539","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن حبيب بن أبي الأشرس الكوفي عن عبد الرحيم بن سليمان الأشل عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7546","7540  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْعَسَّالُ ،  نَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  نَا  عُبَيْسُ بْنُ مَيْمُونٍ ،  حَدَّثَنِي  قَتَادَةُ ،  عَنْ  أَنَسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحُمَّى حَظُّ الْمُؤْمِنِ مِنَ النَّارِ  .         [7/296]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  عُبَيْسُ بْنُ مَيْمُونٍ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7540","","أنس بن مالك عن قتادة بن دعامة عن عبيس بن ميمون التيمي عن الشاذكوني عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7547","7541  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  نَا  سُلَيْمَانُ بْنُ دَاوُدَ ،  نَا  خَالِدُ بْنُ نَافِعٍ الْأَشْعَرِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي بُرْدَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي مُوسَى  ، أَنَّ مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ ،  قَالَ لَهُ  :  أَمَا عَلِمْتَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا اخْتَصَمَ إِلَيْهِ الْخَصْمَانِ  ، فَاتَّعَدَا الْمَوْعِدَ ، فَجَاءَ أَحَدُهُمَا وَلَمْ يَأْتِ الْآخَرُ قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلَّذِي جَاءَ عَلَى الَّذِي لَمْ يَجِئْ ""  فَقَالَ  أَبُو مُوسَى : "" إِنَّمَا كَانَ ذَاكَ فِي الدَّابَّةِ وَالشَّاةِ وَالْبَعِيرِ ، وَالَّذِي نَحْنُ فِيهِ أَمْرُ النَّاسِ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدِ بْنِ أَبِي بُرْدَةَ  إِلَّا  خَالِدُ بْنُ نَافِعٍ  "" .","","Al-Mu'jam al-Awsat 7541","","معاوية بن أبي سفيان عن أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن سعيد بن أبي بردة الأشعري عن خالد بن نافع الأشعري عن الشاذكوني عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7548","7542  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  الشَّاذَكُونِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ مَسْمُولٍ الْمَخْزُومِيُّ قَالَ :  سَمِعْتُ  الْقَاسِمَ بْنَ مُخَوَّلٍ الْبَهْزِيَّ ، يَقُولُ :  سَمِعْتُ  أَبِي  يَقُولُ :  أَمْسَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُحَدِّثُنَا ، وَقَالَ :  إِنَّهُ سَيَأْتِي عَلَى النَّاسِ زَمَانٌ يَكُونُ خَيْرَ مَالِ النَّاسِ غَنَمٌ بَيْنَ شَجَرٍ  ، يَأْكُلُ الشَّجَرَ ، وَيَرِدُ الْمِيَاهَ ، يَأْكُلُ أَهْلُهَا مِنْ رِسْلِهَا ، وَيَشْرَبُونَ مِنْ أَلْبَانِهَا ،  وَيَلْبَسُونَ مِنْ أَشْعَارِهَا ، أَوْ قَالَ : مِنْ أَصْوَافِهَا  ، وَالْفِتَنُ  تَرْتَكِسُ  بَيْنَ  جَرَاثِيمِ  الْعَرَبِ ، يُفْتَنُونَ وَاللهِ ، يُفْتَنُونَ وَاللهِ ، يُفْتَنُونَ وَاللهِ "" يَقُولُهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَلَاثًا  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  مُخَوَّلٍ الْبَهْزِيِّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7542","","مخول بن يزيد البهزي عن القاسم بن مخول البهزى عن محمد بن سليمان المسمولي عن الشاذكوني عن محمد بن إبراهيم بن بكير الطيالسي عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7549","7543  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  نَا  الشَّاذَكُونِيُّ ،  نَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  بَابِ بْنِ عُمَيْرٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى صَلَاةَ الْخَوْفِ بِإِحْدَى الطَّائِفَتَيْنِ رَكْعَةً  ،         [7/297]      ثُمَّ أَقْبَلَتِ الطَّائِفَةُ الْأُخْرَى فَصَلَّى بِهِمْ رَكْعَةً ، ثُمَّ سَجَدَ سَجْدَتَيْنِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَوْزَاعِيِّ  إِلَّا  عِيسَى بْنُ يُونُسَ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7543","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن باب بن عمير اليمامي عن أبو عمرو الأوزاعي عن عيسى بن يونس بن أبي إسحاق عن الشاذكوني عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7550","7544  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  الشَّاذَكُونِيُّ ،  ثَنَا  سَلْمُ بْنُ قُتَيْبَةَ ،  نَا  عَبْدُ اللهِ بْنُ عَبْدِ اللهِ الْهَدَادِيُّ ، وَكَانَ  ثِقَةً  ،  عَنْ  أَبِي الْعَلَاءِ ،  سَمِعَ  أَبَا سَعِيدٍ الْخُدْرِيَّ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَفْضَلُ الْمُؤْمِنِينَ رَجُلٌ سَمْحُ الْبَيْعِ  ، سَمْحُ الشِّرَاءِ ، سَمْحُ الْقَضَاءِ ، سَمْحُ الِاقْتَضَاءِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الْعَلَاءِ - هُوَ يَزِيدُ بْنُ عَبْدِ اللهِ بْنِ الشِّخِّيرِ  - إِلَّا  عَبْدُ اللهِ بْنُ عَبْدِ اللهِ الْهَدَادِيِّ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  ""  .","","Al-Mu'jam al-Awsat 7544","","أبو سعيد الخدري عن يزيد بن عبد الله بن الشخير العامري عن عبد الله بن عبد الله الهدادي عن سلم بن قتيبة الشعيري عن الشاذكوني عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7551","7545  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْعَسَّالُ ،  نَا  سُلَيْمَانُ الشَّاذَكُونِيُّ ،  نَا  رَوْحُ بْنُ عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  نَا  حُسَيْنُ بْنُ عِمْرَانَ ،  عَنْ  جَابِرٍ الْجُعْفِيِّ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ  غَسَّلَ  امْرَأً مَيِّتًا فَأَدَّى فِيهِ الْأَمَانَةَ  -  يَعْنِي : أَنْ لَا يُفْشِيَ عَلَيْهِ شَيْئًا ظَهَرَ فِي غُسْلِهِ  - كَانَ مِنْ ذُنُوبِهِ كَيَوْمِ وَلَدَتْهُ أُمُّهُ "" . قَالَ : "" وَيُغَسِّلُهُ أَوْلَى النَّاسِ بِهِ ، وَإِلَّا فَمَنْ تَعْلَمُونَ أَنَّ عِنْدَهُ حَظًّا مِنْ  وَرَعٍ  وَأَمَانَةٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الشَّعْبِيِّ  إِلَّا  جَابِرٌ  ، وَلَا رَوَاهُ عَنْ  جَابِرٍ  إِلَّا  حُسَيْنُ بْنُ عِمْرَانَ  وَسَلَّامُ بْنُ أَبِي مُطِيعٍ  ، وَلَا رَوَاهُ عَنْ  حُسَيْنِ بْنِ عِمْرَانَ  إِلَّا  رَوْحُ بْنُ عَطَاءٍ  ،  تَفَرَّدَ بِهِ  :  الشَّاذَكُونِيُّ  "" .","","Al-Mu'jam al-Awsat 7545","","عائشة بنت أبي بكر الصديق عن يحيى بن الجزار العرني عن الشعبي عن جابر الجعفي عن الحسين بن عمران الجهني عن روح بن عطاء بن أبي ميمونة البصري عن الشاذكوني عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7552","7546  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الْوَهَّابِ الثَّقَفِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كُنَّا نَنْبِذُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سِقَاءٍ  ،  بِوِكَاءٍ  أَعْلَاهُ ، وَلَهُ  عَزْلَاءُ ،         [7/298]      نَنْبِذُ غُدْوَةً فَيَشْرَبُهُ عَشِيَّةً ، وَنَنْبِذُهُ عَشِيَّةً فَيَشْرَبُهُ غُدْوَةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يُونُسَ بْنِ عُبَيْدٍ  إِلَّا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ  "" .","","Al-Mu'jam al-Awsat 7546","","عائشة بنت أبي بكر الصديق عن خيرة مولاة أم سلمة عن الحسن البصري عن يونس بن عبيد عن عبد الوهاب بن عبد المجيد الثقفي عن عثمان بن عبد الوهاب بن عبد المجيد الثقفى عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7553","7547  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  الشَّاذَكُونِيُّ ،  نَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  عَنْ  لَيْثٍ ،  عَنْ  مَكْحُولٍ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُمِّ حَبِيبَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ صَلَّى أَرْبَعَ رَكَعَاتٍ قَبْلَ الظُّهْرِ حَرَّمَهُ اللهُ عَلَى النَّارِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  لَيْثٍ  إِلَّا  حَسَّانُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7547","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن مكحول بن أبي مسلم عن ليث بن أبي سليم عن حسان بن إبراهيم الكرماني عن الشاذكوني عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7554","7548  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الْعَسَّالُ ،  نَا  سَهْلُ بْنُ عُثْمَانَ ،  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  ثَوْبَانَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنْ أُمَّتِي مَنْ لَوْ جَاءَ أَحَدَكُمْ فَسَأَلَهُ دِينَارًا لَمْ يُعْطِهِ  ، وَلَوْ سَأَلَهُ دِرْهَمًا لَمْ يُعْطِهِ ، وَلَوْ سَأَلَهُ فِلْسًا لَمْ يُعْطِهِ ، وَلَوْ سَأَلَ اللهَ الْجَنَّةَ لَأَعْطَاهُ إِيَّاهَا ، ذُو  طِمْرَيْنِ  ، لَا  يُؤْبَهُ  لَهُ ، لَوْ أَقْسَمَ عَلَى اللهِ  لَأَبَرَّهُ  .","","Al-Mu'jam al-Awsat 7548","","ثوبان بن بجدد مولى رسول الله عن سالم بن أبي الجعد الغطفاني عن الأعمش عن أبو معاوية الضرير عن سهل بن عثمان العسكري عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7555","7549  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَمْرٍو الْبَجَلِيُّ ،  نَا  دَاوُدُ بْنُ الزِّبْرِقَانِ ،  نَا  شُعْبَةُ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَفْطَرَ قَالَ : "" بِسْمِ اللهِ  ، اللَّهُمَّ لَكَ صُمْتُ ، وَعَلَى رِزْقِكَ أَفْطَرْتُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شُعْبَةَ  إِلَّا  دَاوُدُ بْنُ الزِّبْرِقَانِ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7549","","أنس بن مالك عن ثابت البناني عن شعبة بن الحجاج عن داود بن الزبرقان عن إسماعيل بن عمرو البجلي عن محمد بن إبراهيم بن شبيب الأصبهاني عن الطبراني","محمد بن إبراهيم بن شبيب العسال الأصبهاني"
"7556","7550  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ نَصْرِ بْنِ شَبِيبٍ الْأَصْبَهَانِيُّ ،  ثَنَا  مَخْلَدُ بْنُ الْحَسَنِ بْنِ أَبِي زُمَيْلٍ ،  نَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي إِسْحَاقَ السَّبِيعِيِّ ،         [7/299]      عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صِيَامُ ثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ صِيَامُ الدَّهْرِ  ، أَيَّامُ  الْبِيضِ  ، ثَلَاثَ عَشْرَةَ ، وَأَرْبَعَ عَشْرَةَ ، وَخَمْسَ عَشْرَةَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  زَيْدُ بْنُ أَبِي أُنَيْسَةَ  "" .","","Al-Mu'jam al-Awsat 7550","","جرير بن عبد الله بن جابر يوسف الأمة عن أبو إسحاق السبيعي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن مخلد بن الحسن بن أبي زميل الحراني عن محمد بن إبراهيم بن نصر الأصبهاني عن الطبراني","محمد بن إبراهيم بن نصر بن شبيب الأصبهاني"
"7557","7551  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ نَصْرِ بْنِ شَبِيبٍ ،  ثَنَا  مَخْلَدُ بْنُ أَبِي زُمَيْلٍ ،  ثَنَا  أَبُو الْمَلِيحِ الْحَسَنُ بْنُ عَمْرٍو الرَّقِّيُّ ،  عَنْ  يَزِيدَ بْنِ يَزِيدَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ قَالَ :  قَالَ  أَبُو هُرَيْرَةَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي لَأَهُمُّ أَنْ آمُرَ فِتْيَانِي فَيَجْمَعُونَ حُزَمًا مِنْ حَطَبٍ  ، ثُمَّ آتِي قَوْمًا يُصَلُّونَ فِي بُيُوتِهِمْ ، لَيْسَتْ بِهِمْ عِلَّةٌ ، فَأُحَرِّقُهَا عَلَيْهِمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ بْنِ يَزِيدَ  إِلَّا  أَبُو الْمَلِيحِ الرَّقِّيُّ  "" .","","Al-Mu'jam al-Awsat 7551","","أبو هريرة الدوسي عن يزيد بن الأصم بن عبيد البكائي عن يزيد بن يزيد بن جابر الأزدي عن الحسن بن عمر الفزاري عن مخلد بن الحسن بن أبي زميل الحراني عن محمد بن إبراهيم بن نصر الأصبهاني عن الطبراني","محمد بن إبراهيم بن نصر بن شبيب الأصبهاني"
"7558","7552  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ نَصْرِ بْنِ شَبِيبٍ الْأَصْبَهَانِيُّ ،  نَا  هَارُونُ بْنُ عَبْدِ اللهِ الْحَمَّالُ ،  نَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  نَا  مُحَمَّدُ بْنُ سَعْدٍ ،  نَا  ابْنُ عَجْلَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْفَضْلِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا كَانَ فِي سَفَرٍ فَزَاغَتِ الشَّمْسُ قَبْلَ أَنْ يَرْتَحِلَ صَلَّى الظُّهْرَ وَالْعَصْرَ جَمِيعًا  ، وَإِنِ ارْتَحَلَ قَبْلَ أَنْ تَزِيغَ الشَّمْسُ جَمَعَ بَيْنَهُمَا فِي أَوَّلِ وَقْتِ الْعَصْرِ ، وَكَانَ يَفْعَلُ ذَلِكَ فِي الْمَغْرِبِ وَالْعِشَاءِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ الْفَضْلِ  إِلَّا  ابْنُ عَجْلَانَ  ، وَلَا عَنِ  ابْنِ عَجْلَانَ  إِلَّا  مُحَمَّدُ بْنُ سَعْدٍ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ  "" .","","Al-Mu'jam al-Awsat 7552","","أنس بن مالك عن عبد الله بن الفضل بن العباس الهاشمي عن محمد بن عجلان عن محمد بن سعد الأشهلي عن يعقوب بن محمد بن عيسى عن هارون بن عبد الله بن مروان الحمال عن محمد بن إبراهيم بن نصر الأصبهاني عن الطبراني","محمد بن إبراهيم بن نصر بن شبيب الأصبهاني"
"7559","[7/300]      7553  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ بْنِ شَبِيبٍ الْمُقْرِئُ الْأَصْبَهَانِيُّ ،  نَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  نَا  حُسَيْنُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ ،  نَا  سُلَيْمَانُ بْنُ قَرْمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَحِلُّ لِمُسْلِمٍ أَنْ يَهْجُرَ أَخَاهُ فَوْقَ ثَلَاثٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا  سُلَيْمَانُ بْنُ قَرْمٍ  ، وَلَا عَنْ  سُلَيْمَانَ  إِلَّا  حُسَيْنُ بْنُ مُحَمَّدٍ  ،  تَفَرَّدَ بِهِ  :  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ  "" .","","Al-Mu'jam al-Awsat 7553","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن سليمان بن قرم الضبي عن الحسين بن محمد بن بهرام المروذي عن إبراهيم بن سعيد الجوهري عن محمد بن عبد الرحيم بن إبراهيم الأصبهاني عن الطبراني","محمد بن عبد الرحيم بن شبيب المقرئ الأصبهاني"
"7560","7554  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ الْأَصْبَهَانِيُّ ،  نَا  سَلَمَةُ بْنُ شَبِيبٍ ،  نَا  الْحَسَنُ بْنُ مُحَمَّدِ بْنِ أَعْيَنَ ،  نَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِي مُرَاوِحٍ ،  عَنْ  حَمْزَةَ بْنِ عَمْرٍو الْأَسْلَمِيِّ ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ ، إِنَّ بِي قُوَّةً عَلَى الصِّيَامِ فِي السَّفَرِ ، فَهَلْ عَلَيَّ جُنَاحٌ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هِيَ رُخْصَةٌ مِنَ اللهِ ، مَنْ شَاءَ أَخَذَ بِهَا فَحَسَنٌ  ، وَمَنْ أَحَبَّ أَنْ يَصُومَ فَلَا جُنَاحَ عَلَيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الْأَسْوَدِ  إِلَّا  عَمْرُو بْنُ الْحَارِثِ  ،  تَفَرَّدَ بِهِ  :  مُوسَى بْنُ أَعْيَنَ  "" .","","Al-Mu'jam al-Awsat 7554","","حمزة بن عمرو بن عويمر الأسلمي عن أبو مراوح الغفاري عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عمرو بن الحارث بن يعقوب عن موسى بن أعين الجزري عن الحسن بن محمد بن أعين الحراني عن سلمة بن شبيب المسمعي عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7561","7555  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ ،  نَا  مُحَمَّدُ بْنُ سُلَيْمَانَ - لُوَيْنٌ - ،  نَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الرَّحْمَنِ الْبَالِسِيُّ ،  عَنْ  خُصَيْفٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يُجْزِئُ فِي الْوَضُوءِ مُدٌّ ، وَفِي الْغُسْلِ صَاعٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خُصَيْفٍ  إِلَّا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الرَّحْمَنِ  ،  تَفَرَّدَ بِهِ  :  لُوَيْنٌ  "" .","","Al-Mu'jam al-Awsat 7555","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن خصيف الجزري عن عبد العزيز بن عبد الرحمن الجزري عن محمد بن سليمان لوين عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7562","7556  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مَالِكٍ ،  نَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي الْحَوَاجِبِ ،  ثَنَا  إِدْرِيسُ بْنُ يَزِيدَ الْأَوْدِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْأَسْوَدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كُنْتُ أَنَا وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي لِحَافٍ وَاحِدٍ ، وَأَنَا طَامِثٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِدْرِيسَ الْأَوْدِيِّ  إِلَّا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي الْحَوَاجِبِ  "" .","","Al-Mu'jam al-Awsat 7556","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن عبد الرحمن بن الأسود النخعي عن إدريس بن يزيد الزعافري عن يحيى بن زكريا بن أبى الحواجب عن إبراهيم بن مالك بن بهبوذ البزاز عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7563","[7/301]      7557  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ ،  ثَنَا  حَمَّادُ بْنُ الْحَسَنِ بْنِ عَنْبَسَةَ الْوَرَّاقُ ،  نَا  حَبَّانُ بْنُ هِلَالٍ ،  ثَنَا  مُجَّاعَةُ بْنُ الزُّبَيْرِ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُغَفَّلٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا يَتَرَجِّلُ الرَّجُلُ إِلَّا غِبًّا أَرْبَعًا أَوْ خَمْسًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُجَّاعَةِ  إِلَّا  حَبَّانُ بْنُ هِلَالٍ  "" .","","Al-Mu'jam al-Awsat 7557","","عبد الله بن مغفل بن عبد نهم المزني عن الحسن البصري عن مجاعة بن الزبير عن حبان بن هلال الباهلي عن حماد بن الحسن بن عنبسة النهشلي عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7564","7558  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ ،  نَا  عَبْدُ اللهِ بْنُ شَبِيبٍ الْمَدَنِيُّ ،  ثَنَا  أَبُو جَابِرٍ مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ،  نَا  شُعْبَةُ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ مِنْكُمْ مُصَلِّيًا بَعْدَ الْجُمُعَةِ فَلْيُصَلِّ أَرْبَعًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شُعْبَةَ  إِلَّا  أَبُو جَابِرٍ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ اللهِ بْنُ شَبِيبٍ  "" .","","Al-Mu'jam al-Awsat 7558","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن شعبة بن الحجاج عن أبو جابر محمد بن عبد الملك الأزدي عن عبد الله بن شبيب الربعي عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7565","7559  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ ،  نَا  عَلِيُّ بْنُ حَرْبٍ الْمَوْصِلِيُّ ،  نَا  سَعِيدُ بْنُ عَامِرٍ الضُّبَعِيُّ ،  عَنْ  أَبِي عَامِرٍ الْخَزَّازِ صَالِحِ بْنِ رُسْتُمَ قَالَ :  قَالَ  أَبُو قِلَابَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَأْتِي عَلَى النَّاسِ زَمَانٌ  يَتَبَاهَوْنَ  بِكَثْرَةِ الْمَسَاجِدِ  ، لَا يَعْمُرُونَهَا إِلَّا قَلِيلًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي عَامِرٍ الْخَزَّازِ  إِلَّا  سَعِيدُ بْنُ عَامِرٍ  "" .","","Al-Mu'jam al-Awsat 7559","","أنس بن مالك عن أبو قلابة الجرمي عن صالح بن رستم الخزاز عن سعيد بن عامر الضبعي عن علي بن حرب الطائي عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7566","7560  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ ،  نَا  عَلِيُّ بْنُ حَرْبٍ الْمَوْصِلِيُّ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ يَحْيَى الْمَدَنِيُّ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ قَالَ :  كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْمَسْجِدِ نَنْتَظِرُ الصَّلَاةَ ، فَقَامَ  رَجُلٌ  ، فَقَالَ : إِنِّي أَصَبْتُ ذَنْبًا ، فَأَعْرَضَ عَنْهُ ، فَلَمَّا قَضَى النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الصَّلَاةَ قَامَ الرَّجُلُ ، فَأَعَادَ الْقَوْلَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَيْسَ قَدْ صَلَّيْتَ مَعَنَا هَذِهِ الصَّلَاةَ  ، وَأَحْسَنْتَ لَهَا الطُّهُورَ ؟ "" قَالَ : بَلَى ، قَالَ : "" فَإِنَّهَا كَفَّارَةُ ذَنْبِكَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  إِسْرَائِيلُ  وَلَا عَنْ  إِسْرَائِيلَ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ يَحْيَى الْمَدَنِيُّ  ،  تَفَرَّدَ بِهِ  :  عَلِيُّ بْنُ حَرْبٍ  ، وَلَا يُرْوَى عَنْ  عَلِيٍّ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7560","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الرحمن بن يحيى العذري عن علي بن حرب الطائي عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7567","[7/302]      7561  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ ،  نَا  عَبْدُ اللهِ بْنُ شَبِيبٍ الْمَدَنِيُّ ،  نَا  دَاوُدُ بْنُ عَبْدِ اللهِ الْجَعْفَرِيُّ ،  نَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنِ  ابْنِ كَعْبِ بْنِ مَالِكٍ ،  عَنْ  أَبِيهِ  قَالَ :  جَاءَتْ  جَارِيَةٌ  تَرْعَى غَنَمًا لِي ، فَأَكَلَ الذِّئْبُ شَاةً ، فَضَرَبْتُ وَجْهَ الْجَارِيَةِ ، فَنَدِمْتُ ، فَأَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، لَوْ أَعْلَمُ أَنَّهَا  مُؤْمِنَةٌ  لَأَعْتَقْتُهَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَنْ أَنَا ؟ "" قَالَتْ : رَسُولُ اللهِ ، قَالَ : "" فَمَنِ اللهُ ؟ "" قَالَتِ : الَّذِي فِي السَّمَاءِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَعْتِقْهَا ، فَإِنَّهَا  مُؤْمِنَةٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ عَجْلَانَ  إِلَّا  حَاتِمٌ  ، وَلَا عَنْ  حَاتِمٍ  إِلَّا  دَاوُدُ الْجَعْفَرِيُّ  ، وَلَا يُرْوَى عَنْ  كَعْبِ بْنِ مَالِكٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7561","","كعب بن مالك الأنصاري عن عبد الله بن كعب بن مالك عن زيد بن أسلم عن محمد بن عجلان عن حاتم بن إسماعيل الحارثي عن داود بن عبد الله الجعفري عن عبد الله بن شبيب الربعي عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7568","7562  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَزِيدَ الْجُعْفِيُّ  ،  حَدَّثَنِي  أَبِي  ،  نَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  زِرٍّ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَقِيلُوا ذَوِي  الْهَيْئَاتِ  زَلَّاتِهِمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَاصِمٍ  إِلَّا  أَبُو بَكْرِ بْنُ عَيَّاشٍ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ اللهِ بْنُ يَزِيدَ بْنِ مُحَمَّدٍ  ، وَلَا يُرْوَى عَنِ  ابْنِ مَسْعُودٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .  كذا في طبعة دار الحرمين ، والصواب : ( الحنفي )","","Al-Mu'jam al-Awsat 7562","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن أبو بكر بن عياش عن محمد بن يزيد الحنفي عن عبد الله بن محمد بن يزيد المروزي عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7569","7563  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ ،  نَا  عَبْدُ اللهِ بْنُ شَبِيبٍ ،  نَا  عُمَرُ بْنُ سَهْلٍ         [7/303]      الْمَازِنِيُّ ،  نَا  عُمَرُ بْنُ صُهْبَانَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  أَبِي حَدْرَدٍ الْأَسْلَمِيِّ قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَقَدْ تَزَوَّجْتُ ، فَقَالَ :  كَمْ أَصْدَقْتَ يَا  أَبَا حَدْرَدٍ  ؟ "" قُلْتُ : خَمْسَةَ أَوَاقٍ ، فَقَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَوْ كُنْتُمْ تَغْرِفُونَ مِنْ  بُطْحَانَ  مَا زِدْتُمْ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا  عُمَرُ بْنُ صُهْبَانَ  ،  تَفَرَّدَ بِهِ  :  عُمَرُ بْنُ سَهْلٍ  .  وَالْمَشْهُورُ مِنْ حَدِيثِ  يَحْيَى بْنِ سَعِيدٍ الْأَنْصَارِيِّ  ، عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ التَّيْمِيِّ  ، عَنْ  أَبِي حَدْرَدٍ  "" .","","Al-Mu'jam al-Awsat 7563","","أبو حدرد الأسلمي عن عطاء بن يسار الهلالي عن زيد بن أسلم عن عمر بن صهبان الهمداني عن عمر بن سهل بن مروان المازني عن عبد الله بن شبيب الربعي عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7570","7564  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَاصِمٍ ،  نَا  عَلِيُّ بْنُ حَرْبٍ ،  نَا  الْحَسَنُ بْنُ كَثِيرٍ ،  حَدَّثَنِي  جَدِّي يَحْيَى بْنُ كَثِيرِ بْنِ يَحْيَى  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ نَجْدَةَ الْحِمْصِيِّ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِيهِ صَالِحِ بْنِ الْمُتَوَكِّلِ  قَالَ :  سَمِعْتُ  مَازِنَ بْنَ الْغَضُوبَةِ ، يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلَيْكُمْ بِالصِّدْقِ ، فَإِنَّهُ يَهْدِي إِلَى الْجَنَّةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَوْزَاعِيِّ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ نَجْدَةَ  ،  تَفَرَّدَ بِهِ  :  عَلِيُّ بْنُ حَرْبٍ  "" .","","Al-Mu'jam al-Awsat 7564","","مازن بن الغضوبة بن غراب النبهاني عن صالح بن المتوكل مولى مازن بن الغضوبة عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن عبد الرحمن بن نجدة عن يحيى بن كثير الطائي عن الحسن بن يحيى بن كثير المصيصي عن علي بن حرب الطائي عن محمد بن عاصم بن يحيى الأصبهاني عن الطبراني","محمد بن عاصم الأصبهاني"
"7571","7565  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْعَبْدِيُّ الْأَصْبَهَانِيُّ ،  حَدَّثَنِي  أَبِي  ،  نَا  الْحُسَيْنُ بْنُ حَفْصٍ ،  نَا  عِكْرِمَةُ بْنُ إِبْرَاهِيمَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتِ :  افْتَتَحَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  خَيْبَرَ  ، فَأَعْطَاهَا أَهْلَهَا الْيَهُودَ عَلَى النِّصْفِ ، فَلَمَّا  أَيْنَعَ  الثَّمَرُ  بَعَثَ إِلَيْهِمْ  عَبْدَ اللهِ بْنَ رَوَاحَةَ  ، فَقَالَ : خُذُوا مِنِّي سِتِّينَ         [7/304]      وَسْقًا مِنْ تَمْرٍ ، وَلَنَا مَا فِي رُءُوسِ النَّخْلِ ، قَالُوا : إِذًا تَظْلِمُنَا قَالَ : فَأَعْطُونِي سِتِّينَ وَسْقًا ، وَلَكُمْ مَا فِي رُءُوسِ النَّخْلِ ، قَالُوا : بِهَذَا قَامَتِ السَّمَاوَاتُ وَالْأَرْضُ ، وَبِهَذَا تُنْصَرُونَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  عِكْرِمَةُ  ،  تَفَرَّدَ بِهِ  :  الْحُسَيْنُ بْنُ حَفْصٍ  "" .","","Al-Mu'jam al-Awsat 7565","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عكرمة بن إبراهيم الباهلى عن الحسين بن حفص الهمداني عن إسماعيل بن عبد الله سمويه عن محمد بن إسماعيل بن عبد الله الأصبهاني عن الطبراني","محمد بن إسماعيل العبدي الأصبهاني"
"7572","7566  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ عَبْدِ اللهِ ،  نَا  أَبِي  ،  نَا  حَاتِمُ بْنُ عُبَيْدِ اللهِ النَّمَرِيُّ ،  ثَنَا  سَلَّامٌ أَبُو الْمُنْذِرِ ،  حَدَّثَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَتَبَ إِلَى عُمَّالِهِ فِي سُنَّةِ الصَّدَقَاتِ  : "" فِي أَرْبَعِينَ شَاةً شَاةٌ إِلَى عِشْرِينَ وَمِائَةٍ ، فَإِنْ زَادَتْ وَاحِدَةً فَفِيهَا شَاتَانِ إِلَى مِائَتَيْنِ ، فَإِذَا زَادَتْ وَاحِدَةً فَفِيهَا ثَلَاثُ  شِيَاهٍ  إِلَى ثَلَاثِمِائَةٍ ، فَإِذَا كَثُرَتِ الْغَنَمُ فَفِي كُلِّ مِائَةِ شَاةٍ شَاةٌ . وَكَتَبَ فِي صَدَقَةِ الْبَقَرِ : "" فِي كُلِّ ثَلَاثِينَ بَقَرَةً  جَذَعَةٌ  ، وَفِي أَرْبَعِينَ بَقَرَةً  مُسِنَّةٌ  وَكَتَبَ فِي صَدَقَاتِ الْإِبِلِ : "" فِي خَمْسٍ مِنَ الْإِبِلِ شَاةٌ ، وَفِي عَشْرٍ شَاتَانِ ، وَفِي خَمْسَ عَشْرَةَ ثَلَاثٌ ، وَفِي عِشْرِينَ أَرْبَعٌ ، وَفِي خَمْسٍ وَعِشْرِينَ بِنْتُ  مَخَاضٍ  إِلَى خَمْسٍ وَثَلَاثِينَ ، فَإِذَا زَادَتْ وَاحِدَةً فَفِيهَا بِنْتُ  لَبُونٍ  إِلَى خَمْسٍ وَأَرْبَعِينَ ، فَإِذَا زَادَتْ وَاحِدَةً فَفِيهَا حِقَّةٌ طَرُوقَةُ الْفَحْلِ إِلَى سِتِّينَ ، فَإِنْ زَادَتْ وَاحِدَةً فَفِيهَا  جَذَعَةٌ  إِلَى خَمْسٍ وَسَبْعِينَ ، فَإِنْ زَادَتْ وَاحِدَةً فَفِيهَا بِنْتَا  لَبُونٍ  إِلَى تِسْعِينَ ، فَإِنْ زَادَتْ وَاحِدَةً فَحِقَّتَانِ إِلَى عِشْرِينَ وَمِائَةٍ ، فَإِنْ كَثُرَتِ الْإِبِلُ فَفِي كُلِّ خَمْسِينَ حِقَّةٌ ، وَفِي كُلِّ أَرْبَعِينَ بِنْتُ  لَبُونٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ  إِلَّا  سَلَّامٌ أَبُو الْمُنْذِرِ  ،  تَفَرَّدَ بِهِ  :  حَاتِمُ بْنُ عُبَيْدِ اللهِ  "" .","","Al-Mu'jam al-Awsat 7566","","أنس بن مالك عن داود بن أبي هند عن سلام بن سليمان المزني عن حاتم بن عبد الله النمري عن إسماعيل بن عبد الله سمويه عن محمد بن إسماعيل بن عبد الله الأصبهاني عن الطبراني","محمد بن إسماعيل العبدي الأصبهاني"
"7573","[7/305]      7567  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ عَامِرٍ الْأَصْبَهَانِيُّ ،  نَا  أَبِي إِبْرَاهِيمُ بْنُ عَامِرٍ ،  عَنْ  جَدِّي عَامِرِ بْنِ إِبْرَاهِيمَ  قَالَ :  سَمِعْتُ  نَهْشَلَ بْنَ سَعِيدٍ التِّرْمِذِيَّ ،  يُحَدِّثُ ، عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  الْحَارِثِ الْأَعْوَرِ ،  عَنْ  عَلِيٍّ قَالَ :  نَدِمْتُ أَنْ لَا أَكُونَ طَلَبْتُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَيُجْعَلُ  الْحَسَنَ  وَالْحُسَيْنَ  مُؤَذِّنَيْنِ  "" .","","Al-Mu'jam al-Awsat 7567","","علي بن أبي طالب عن الحارث الأعور عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7574","7568  -  وَقَالَ  :  سَمِعْتُ  نَهْشَلًا ،  يُحَدِّثُ عَنِ  الضَّحَّاكِ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا صَلَاةَ لِمَنْ لَا  تَشَهُّدَ  لَهُ  .  "" لَا يُرْوَى هَذَانِ الْحَدِيثَانِ عَنِ  الضَّحَّاكِ  ، عَنِ  الْحَارِثِ  ، عَنْ  عَلِيٍّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِمَا  :  عَامِرُ بْنُ إِبْرَاهِيمَ  .","","Al-Mu'jam al-Awsat 7568","","علي بن أبي طالب عن الحارث الأعور عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7575","7569  -  وَبِهِ  : قَالَ :  سَمِعْتُ  نَهْشَلَ بْنَ سَعِيدٍ  يُحَدِّثُ ، عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  بَاذَامَ ،  عَنْ  قَنْبَرٍ ،  عَنْ  عَلِيٍّ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَلَا إِنَّ الْجَنَّةَ اشْتَاقَتْ إِلَى أَرْبَعَةٍ مِنْ أَصْحَابِي  ، فَأَمَرَنِي رَبِّي أَنْ أُحِبَّهُمْ ،  فَانْتَدَبَ  صُهَيْبٌ الرُّومِيُّ  ،  وَبِلَالُ بْنُ رَبَاحٍ  ،  وَطَلْحَةُ  ،  وَالزُّبَيْرُ  ،  وَسَعْدُ بْنُ أَبِي وَقَّاصٍ  ،  وَحُذَيْفَةُ بْنُ الْيَمَانِ  ،  وَعَمَّارُ بْنُ يَاسِرٍ  "" ، فَقَالُوا : يَا رَسُولَ اللهِ ، مَنْ هَؤُلَاءِ الْأَرْبَعَةُ حَتَّى نُحِبَّهُمْ ؟ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  عَمَّارُ  ، أَنْتَ عَرَّفَكَ اللهُ الْمُنَافِقِينَ ، وَأَمَّا هَؤُلَاءِ الْأَرْبَعَةُ فَأَحَدُهُمْ  عَلِيُّ بْنُ أَبِي طَالِبٍ  ، وَالثَّانِي  الْمِقْدَادُ بْنُ الْأَسْوَدِ الْكِنْدِيُّ  ، وَالثَّالِثُ  سَلْمَانُ الْفَارِسِيُّ  ، وَالرَّابِعُ  أَبُو ذَرٍّ الْغِفَارِيُّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا  الضَّحَّاكُ  ، وَلَا يُرْوَى عَنْ  قَنْبَرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7569","","علي بن أبي طالب عن قنبر عن باذام عن الأعمش عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7576","7570  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ عَامِرٍ ،  نَا  أَبِي ،  عَنْ  جَدِّي  ،  عَنْ  نَهْشَلٍ ،         [7/306]      عَنِ  الضَّحَّاكِ ،  عَنْ  سُفْيَانَ ،  عَنْ  بَاذَامَ ،  عَنْ  قَنْبُرٍ ،  عَنْ  عَلِيٍّ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  لَا يَحْفَظُ مُنَافِقٌ سُورَةَ  هُودٍ  ، وَبَرَاءَةٍ وَيس ،  وَالدُّخَانِ  ، وَ         {      عَمَّ يَتَسَاءَلُونَ         }      ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  قَنْبَرٍ  ، عَنْ  عَلِيٍّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  ،  وَسُفْيَانُ  الَّذِي رَوَى عَنْهُ  الضَّحَّاكُ  هُوَ :  سُفْيَانُ بْنُ اللَّيْلِ  ، الَّذِي رَوَى عَنْهُ  الشَّعْبِيُّ  "" .","","Al-Mu'jam al-Awsat 7570","","علي بن أبي طالب عن قنبر عن باذام عن سفيان الثوري عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7577","7571  -  وَبِهِ  :  عَنِ  الضَّحَّاكِ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  كَانَ دُعَاءُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدَ  التَّشَهُّدِ  فِي الْفَرِيضَةِ :  اللَّهُمَّ إِنَّا نَسْأَلُكَ مِنَ الْخَيْرِ كُلِّهِ عَاجِلِهِ وَآجِلِهِ  ، مَا عَلِمْنَا مِنْهُ وَمَا لَمْ نَعْلَمْ ، وَنَعُوذُ بِكَ مِنَ الشَّرِّ كُلِّهِ عَاجِلِهِ وَآجِلِهِ ، مَا عَلِمْنَا مِنْهُ وَمَا لَمْ نَعْلَمِ ، اللَّهُمَّ إِنَّا نَسْأَلُكَ مَا سَأَلَكَ مِنْهُ عِبَادُكَ الصَّالِحُونَ ، وَنَسْتَعِيذُ بِكَ مِمَّا اسْتَعَاذَ مِنْهُ عِبَادُكَ الصَّالِحُونَ ، رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ ، رَبَّنَا إِنَّنَا آمَنَّا فَاغْفِرْ لَنَا ذُنُوبَنَا وَكَفِّرْ عَنَّا سَيِّئَاتِنَا وَتَوَفَّنَا مَعَ الْأَبْرَارِ ، رَبَّنَا وَآتِنَا مَا وَعَدْتَنَا عَلَى رُسُلِكَ وَلَا تُخْزِنَا يَوْمَ الْقِيَامَةِ إِنَّكَ لَا تُخْلِفُ الْمِيعَادَ "" وَيُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ شِمَالِهِ  .","","Al-Mu'jam al-Awsat 7571","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7578","7572  -  وَبِهِ  :  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  كَانَ دُعَاءُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْعِيدَيْنِ "" اللَّهُمَّ إِنَّا نَسْأَلُكَ عِيشَةً تَقِيَّةً  ، وَمِيتَةً سَوِيَّةً ، وَمَرَدًّا غَيْرَ مُخْزٍ وَلَا فَاضِحٍ ، اللَّهُمَّ لَا تُهْلِكْنَا فَجْأَةً ، وَلَا تَأْخُذْنَا بَغْتَةً ، وَلَا تُعْجِلْنَا عَنْ حَقٍّ وَلَا وَصِيَّةٍ ، اللَّهُمَّ إِنَّا نَسْأَلُكَ الْعَفَافَ وَالْغِنَى ، وَالتُّقَى ، وَالْهُدَى ، وَحُسْنَ عَاقِبَةِ الْآخِرَةِ وَالدُّنْيَا ، وَنَعُوذُ بِكَ مِنَ الشَّكِّ وَالشِّقَاقِ ، وَالرِّيَاءِ وَالسُّمْعَةِ فِي دِينِكَ ، يَا مُقَلِّبَ الْقُلُوبِ لَا  تُزِغْ  قُلُوبَنَا بَعْدَ إِذْ         [7/307]      هَدَيْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً ، إِنَّكَ أَنْتَ الْوَهَّابُ  .","","Al-Mu'jam al-Awsat 7572","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7579","7573  -  وَبِهِ  :  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ نَسِيَ مَسْحَ الرَّأْسِ فَذَكَرَ وَهُوَ يُصَلِّي  ، فَوَجَدَ فِي لِحْيَتِهِ بَلَلًا ، فَلْيَأْخُذْ مِنْهُ وَيَمْسَحْ بِهِ رَأْسَهُ ، فَإِنَّ ذَلِكَ يُجْزِئُهُ ، وَإِنْ لَمْ يَجِدْ بَلَلًا فَلْيُعِدِ الْوُضُوءَ وَالصَّلَاةَ  .","","Al-Mu'jam al-Awsat 7573","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7580","7574  -  وَبِهِ  :  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَعْرِبُوا الْقُرْآنَ ، فَإِنَّهُ مَنْ قَرَأَ الْقُرْآنَ فَأَعْرَبَهُ فَلَهُ بِكُلِّ حَرْفٍ عَشْرُ حَسَنَاتٍ  ، وَكَفَّارَةُ عَشْرِ سَيِّئَاتٍ ، وَرَفْعُ عَشْرِ دَرَجَاتٍ  .","","Al-Mu'jam al-Awsat 7574","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7581","7575  -  وَبِهِ  :  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  النَّاسُ رَجُلَانِ ، عَالِمٌ وَمُتَعَلِّمٌ  ، هُمَا فِي الْأَجْرِ سَوَاءٌ ، وَلَا خَيْرَ فِيمَا بَيْنَهُمَا مِنَ النَّاسِ  .","","Al-Mu'jam al-Awsat 7575","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7582","7576  -  وَبِهِ  :  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ لَا يَزُولُ قَدَمَا عَبْدٍ يَوْمَ الْقِيَامَةِ حَتَّى يُسْأَلَ عَنْ أَرْبَعٍ  : عَنْ عُمُرِهِ فِيمَا أَفْنَاهُ ، وَجَسَدِهِ فِيمَا أَبْلَاهُ ، وَمَالِهِ فِيمَا كَسَبَهُ ، وَأَيْنَ وَضَعَهُ ، وَأَيْنَ أَنْفَذَهُ  .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنِ  الضَّحَّاكِ بْنِ مُزَاحِمٍ  ، عَنْ  أَبِي الْأَحْوَصِ  ، عَنْ  عَبْدِ اللهِ  إِلَّا  نَهْشَلُ بْنُ سَعِيدٍ  ،  تَفَرَّدَ بِهَا  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7576","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7583","7577  -  وَبِهِ  :  عَنِ  الضَّحَّاكِ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا دَخَلَ الْعَشْرُ الْأَوَاخِرُ شَدَّ  الْمِئْزَرَ  ،         [7/308]      وَاجْتَنَبَ النِّسَاءَ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الضَّحَّاكِ  ، عَنْ  مَسْرُوقٍ  إِلَّا  نَهْشَلٌ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7577","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن الضحاك بن مزاحم الهلالي عن نهشل بن سعيد بن وردان الورداني عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7584","7578  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ عَامِرٍ ،  ثَنَا  أَبِي ،  عَنْ  جَدِّي  ،  نَا  أَبُو غَالِبٍ النَّضْرُ بْنُ عَبْدِ اللهِ الْأَزْدِيُّ ،  نَا  فُضَيْلُ بْنُ غَزْوَانَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا  جَدَّ  بِهِ السَّيْرُ جَمَعَ بَيْنَ الصَّلَاتَيْنِ  ، الْمَغْرِبِ وَالْعِشَاءِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  فُضَيْلِ بْنِ غَزْوَانَ  إِلَّا  النَّضْرُ بْنُ عَبْدِ اللهِ  ،  تَفَرَّدَ بِهِ  : عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7578","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن فضيل بن غزوان عن النضر بن عبد الله الأزدي عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7585","7579  -  وَبِهِ  :  عَنِ  النَّضْرِ بْنِ عَبْدِ اللهِ ،  ثَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  أَبِي هَارُونَ الْعَبْدِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ لَهُ إِمَامٌ فَقِرَاءَةُ الْإِمَامِ لَهُ قِرَاءَةٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَسَنِ بْنِ صَالِحٍ  ، عَنْ  أَبِي هَارُونَ  إِلَّا  النَّضْرُ بْنُ عَبْدِ اللهِ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7579","","أبو سعيد الخدري عن عمارة بن جوين العبدي عن الحسن بن صالح بن صالح بن حي عن النضر بن عبد الله الأزدي عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7586","7580  -  وَبِهِ  :  عَنِ  النَّضْرِ بْنِ عَبْدِ اللهِ الْأَزْدِيِّ ،  عَنْ  شَيْبَانَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  عَطَسَ رَجُلَانِ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَشَمَّتَ  أَحَدَهُمَا  وَلَمْ يُشَمِّتِ  الْآخَرَ  ، فَقَالَ : يَا رَسُولَ اللهِ ،  شَمَّتَّ  فُلَانًا وَلَمْ تُشَمِّتْنِي ؟ قَالَ :  إِنَّهُ حَمِدَ اللهَ ، وَإِنَّكَ لَمْ تَحْمَدْهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  إِلَّا  شَيْبَانُ  ، وَلَا عَنْ  شَيْبَانَ  إِلَّا  النَّضْرُ بْنُ عَبْدِ اللهِ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7580","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن النضر بن عبد الله الأزدي عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7587","[7/309]      7581  -  وَبِهِ  :  عَنِ  النَّضْرِ ،  عَنْ  بَشِيرٍ أَبِي إِسْمَاعِيلَ ،  ثَنَا  مُجَاهِدٌ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا تَدْخُلُ الْمَلَائِكَةُ دَارًا فِيهَا كَلْبٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بَشِيرٍ  إِلَّا  النَّضْرُ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7581","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن بشير بن سلمان عن النضر بن عبد الله الأزدي عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7588","7582  -  وَبِهِ  :  عَنِ  النَّضْرِ ،  عَنِ  الْحَسَنِ بْنِ صَالِحٍ ،  عَنْ  أَشْعَثَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ دِيَةَ الْمُعَاهِدِ نِصْفُ دِيَةِ الْمُسْلِمِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعٍ  إِلَّا  أَشْعَثُ  ، وَلَا عَنْ  أَشْعَثَ  إِلَّا  الْحَسَنُ بْنُ صَالِحٍ  ، وَلَا عَنِ  الْحَسَنِ  إِلَّا  النَّضْرُ بْنُ عَبْدِ اللهِ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7582","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أشعث بن سوار عن الحسن بن صالح بن صالح بن حي عن النضر بن عبد الله الأزدي عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7589","7583  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ عَامِرٍ ،  ثَنَا  أَبِي ،  عَنْ  جَدِّي  ،  ثَنَا  عَمْرُو بْنُ صَالِحٍ الثَّقَفِيُّ ،  ثَنَا  صَالِحُ بْنُ أَبِي الْأَخْضَرِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  جَاءَ  بِلَالٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُؤْذِنُهُ لِصَلَاةِ الصُّبْحِ  ، فَوَجَدَهُ نَائِمًا ، فَقَالَ : الصَّلَاةُ خَيْرٌ مِنَ النَّوْمِ ، فَأُقِرَّتْ فِي أَذَانِ الصُّبْحِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  صَالِحُ بْنُ أَبِي الْأَخْضَرِ  ، وَلَا عَنْ  صَالِحٍ  إِلَّا  عَمْرُو بْنُ صَالِحٍ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7583","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن صالح بن أبي الأخضر اليمامي عن عمرو بن صالح الثقفي عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7590","7584  -  وَبِهِ  :  حَدَّثَنَا  عَمْرُو بْنُ صَالِحٍ ،  نَا  الْمُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كُفِّنَ فِي ثَلَاثَةِ أَثْوَابٍ  سَحُولِيَّةٍ  ، بِيضٍ ،  كُرْسُفٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُبَارَكٍ  إِلَّا  عَمْرُو بْنُ صَالِحٍ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7584","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مبارك بن فضالة عن عمرو بن صالح الثقفي عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7591","7585  -  وَبِهِ  :  عَنْ  عَمْرِو بْنِ صَالِحٍ ،  نَا  أَبُو حَمْزَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ فِيمَنْ قَبْلَكُمْ  رَجُلٌ  اشْتَرَى         [7/310]      خَمْرًا فَمَزَجَهَا فَجَعَلَ بَعْضَهَا مَاءً  ، ثُمَّ انْطَلَقَ بِهَا فَبَاعَهَا وَأَخَذَ دَنَانِيرَ ، فَجَعَلَهَا فِي كِيسٍ وَرَكِبَ فِي الْبَحْرِ ، وَحَمَلَ مَعَهُ قِرْدًا ، فَلَمَّا كَانُوا فِي الْبَحْرِ أَخَذَ الْقِرْدُ الْكِيسَ فَتَرَقَّى وَصَعِدَ حَتَّى قَعَدَ عَلَى رَأْسِ  الدَّقَلِ  ، ثُمَّ حَلَّ الْكِيسَ ، فَجَعَلَ يُلْقِي دِينَارًا فِي الْبَحْرِ وَدِينَارًا فِي السَّفِينَةِ حَتَّى أَتَى عَلَى مَا فِي الْكِيسِ ، يَفْعَلُ الْقِرْدُ ذَلِكَ لَمَّا  غَشَّ  الرَّجُلُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي حَمْزَةَ  إِلَّا  عَمْرُو بْنُ صَالِحٍ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7585","","أبو هريرة الدوسي عن الحسن البصري عن إسحاق بن الربيع الأبلي عن عمرو بن صالح عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7592","7586  -  وَبِهِ  :  عَنْ  عَمْرِو بْنِ صَالِحٍ ،  عَنْ  أَشْعَثَ ،  عَنِ  ابْنِ سِيرِينَ ،  عَنْ  عَمْرِو بْنِ وَهْبٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ فِي سَفَرٍ فَتَوَضَّأَ هُوَ ،  وَالْمُغِيرَةُ  يَصُبُّ عَلَيْهِ  ، ثُمَّ انْتَهَيْنَا إِلَى  الْقَوْمِ  وَقَدْ أَمَّهُمْ  عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  ، فَصَلَّيْنَا مَا أَدْرَكْنَا ، وَقَضَيْنَا مَا سُبِقْنَا ، قَالَ  الْمُغِيرَةُ  : فَذَهَبْتُ أُؤْذِنُهُ ، فَقَالَ : "" دَعْهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَشْعَثَ  إِلَّا  عَمْرٌو  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7586","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن أشعث بن سوار عن عمرو بن صالح عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7593","7587  -  وَبِهِ  :  عَنْ  عَمْرِو بْنِ صَالِحٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا نَزَلَ مَنْزِلًا لَمْ يَرْتَحِلْ حَتَّى يُصَلِّيَ الظُّهْرَ  ، وَكَانَ يُصَلِّي إِذَا زَالَتِ الشَّمْسُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بَكْرِ بْنِ عَبْدِ اللهِ  إِلَّا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ  ، وَلَا عَنْ  إِسْمَاعِيلَ  إِلَّا  عَمْرُو بْنُ صَالِحٍ  ،  تَفَرَّدَ بِهِ  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7587","","أنس بن مالك عن بكر بن عبد الله المزني عن إسماعيل بن مسلم الكيشي عن عمرو بن صالح الثقفي عن عامر بن إبراهيم الأصبهاني عن إبراهيم بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7594","7588  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ عَامِرٍ ،  نَا  عَمِّي  مُحَمَّدُ بْنُ عَامِرٍ ،  نَا  أَبِي  ،  نَا  زِيَادٌ أَبُو حَمْزَةَ ،  عَنْ  حَمْزَةَ الزَّيَّاتِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ قَالَ :  عَزَائِمُ  السُّجُودِ أَرْبَعٌ :         {      الم             *          تَنْـزِيلُ         }      السَّجْدَةَ  ، وَ         {      حم         }      السَّجْدَةَ ،         {      وَالنَّجْمِ         }      وَ         {      اقْرَأْ بِاسْمِ رَبِّكَ         }      "" .","","Al-Mu'jam al-Awsat 7588","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن حمزة الزيات عن زياد أبو حمزة عن عامر بن إبراهيم الأصبهاني عن محمد بن عامر الأنطاكي عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7595","[7/311]      7589  -  وَبِهِ  :  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُجَامِعُ نِسَاءَهُ ثُمَّ لَا يَمَسُّ مَاءً  ، فَإِنْ أَصْبَحَ فَأَرَادَ أَنْ يُعَاوِدَ عَاوَدَ ، وَإِنْ لَمْ يُرِدِ اغْتَسَلَ  .","","Al-Mu'jam al-Awsat 7589","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن أبو إسحاق السبيعي عن حمزة الزيات عن زياد أبو حمزة عن عامر بن إبراهيم الأصبهاني عن محمد بن عامر الأنطاكي عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7596","7590  -  وَبِهِ  :  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ وَهْبٍ قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  لَنْ يَزَالَ النَّاسُ مُسْتَمْسِكِينَ مَا أَتَاهُمُ الْعِلْمُ مِنْ أَصْحَابِ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَمِنْ أَكَابِرِهِمْ ، فَإِذَا أَتَاهُمْ مِنَ الصِّغَارِ فَعِنْدَ ذَلِكَ هَلَكُوا  "" .","","Al-Mu'jam al-Awsat 7590","","عبد الله بن مسعود عن سعيد بن وهب القراد عن أبو إسحاق السبيعي عن حمزة الزيات عن زياد أبو حمزة عن عامر بن إبراهيم الأصبهاني عن محمد بن عامر الأنطاكي عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7597","7591  -  وَبِهِ  :  عَنْ  حَمْزَةَ الزَّيَّاتِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  عَدِيِّ بْنِ حَاتِمٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّكُمْ يُكَلِّمُهُ رَبُّهُ ، لَيْسَ بَيْنَهُ وَبَيْنَهُ  تَرْجُمَانٌ  ، فَيَنْظُرُ إِلَى أَيْمَنِهِ فَيَرَى مَا قَدَّمَ ، وَإِلَى  أَشْأَمِهِ  فَيَنْظُرُ مَا قَدَّمَ ، وَإِلَى أَمَامِهِ فَإِذَا هُوَ بِالنَّارِ ، فَاتَّقُوا النَّارَ وَلَوْ  بِشِقِّ  تَمْرَةٍ  .  لَمْ يَرْوِ هَذَهِ الْأَحَادِيثَ عَنْ  حَمْزَةَ الزَّيَّاتِ  إِلَّا  زِيَادٌ أَبُو حَمْزَةَ  ،  تَفَرَّدَ بِهَا  :  عَامِرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7591","","عدي بن حاتم بن عبد الله الطائي عن خيثمة بن عبد الرحمن الجعفي عن الأعمش عن حمزة الزيات عن زياد أبو حمزة عن عامر بن إبراهيم الأصبهاني عن محمد بن عامر بن إبراهيم الأصبهاني عن محمد بن إبراهيم بن عامر المديني عن الطبراني","محمد بن إبراهيم بن عامر الأصبهاني"
"7598","7592  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَحْمَدَ بْنِ أُسَيْدٍ الْأَصْبَهَانِيُّ ،  نَا  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ الْعَبْدِيُّ ،  نَا  إِسْمَاعِيلُ بْنُ أَبَانَ ،  ثَنَا  أَبُو مَرْيَمَ عَبْدُ الْغَفَّارِ بْنُ الْقَاسِمِ الْأَنْصَارِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  حُبْشِيِّ بْنِ جُنَادَةَ قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَلِيٍّ  :  أَنْتَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  ، إِلَّا أَنَّهُ لَا نَبِيَّ بَعْدِي  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  أَبُو مَرْيَمَ  ،  تَفَرَّدَ بِهِ  :  إِسْمَاعِيلُ بْنُ أَبَانَ  "" .","","Al-Mu'jam al-Awsat 7592","","حبشي بن جنادة السلولي عن أبو إسحاق السبيعي عن عبد الغفار بن القاسم الأنصاري عن إسماعيل بن أبان عن إسماعيل بن عبد الله سمويه عن محمد بن إسماعيل بن أحمد الأصبهاني عن الطبراني","محمد بن إسماعيل بن أحمد بن أسد الأصبهاني"
"7599","7593  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ ،  نَا  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ ،  نَا  حَاتِمُ بْنُ عُبَيْدِ اللهِ         [7/312]      النَّمَرِيُّ ،  عَنْ  عِيسَى بْنِ مَيْمُونٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  سَهَا  قَبْلَ التَّمَامِ ، فَسَجَدَ سَجْدَتَيِ السَّهْوِ قَبْلَ أَنْ يُسَلِّمَ ، وَقَالَ :  مَنْ  سَهَا  قَبْلَ التَّمَامِ سَجَدَ سَجْدَتَيِ السَّهْوِ قَبْلَ أَنْ يُسَلِّمَ  ، وَإِذَا  سَهَا  بَعْدَ التَّمَامِ سَجَدَ سَجْدَتَيِ السَّهْوِ بَعْدَ أَنْ يُسَلِّمَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ عُرْوَةَ  - بِهَذَا اللَّفْظِ - إِلَّا  عِيسَى بْنُ مَيْمُونٍ  ،  تَفَرَّدَ بِهِ  :  حَاتِمٌ  "" .","","Al-Mu'jam al-Awsat 7593","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عيسى بن ميمون الواسطي عن حاتم بن عبد الله النمري عن إسماعيل بن عبد الله سمويه عن محمد بن إسماعيل بن أحمد الأصبهاني عن الطبراني","محمد بن إسماعيل بن أحمد بن أسد الأصبهاني"
"7600","7594  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْوَلِيدِ الْأَصْبَهَانِيُّ ،  ثَنَا  سَعْدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الْحَكَمِ ،  ثَنَا  قُدَامَةُ بْنُ مُحَمَّدٍ الْأَشْجَعِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ شَيْبَةَ الطَّائِفِيِّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا مِنْ أُمَّتِي أَحَدٌ وَلِيَ مِنْ أَمْرِ النَّاسِ شَيْئًا  ، لَمْ يَحْفَظْهُمْ بِمَا يَحْفَظُ بِهِ نَفْسَهُ وَأَهْلَهُ ، إِلَّا لَمْ  يُرَحْ  رَائِحَةَ الْجَنَّةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  إِسْمَاعِيلُ بْنُ شَيْبَةَ  ،  تَفَرَّدَ بِهِ  :  قُدَامَةُ بْنُ مُحَمَّدٍ  "" .","","Al-Mu'jam al-Awsat 7594","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن إسماعيل بن إبراهيم بن شيبة الطائفي عن قدامة بن محمد بن قدامة الخشرمي عن سعد بن عبد الله بن عبد الحكم المصري عن محمد بن أحمد بن الوليد المديني عن الطبراني","محمد بن أحمد بن الوليد الأصبهاني"
"7601","7595  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْوَلِيدِ ،  نَا  أَحْمَدُ بْنُ شَيْبَانَ الرَّمْلِيُّ ،  نَا  عَبْدُ الْمَجِيدِ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنْ  طَلْحَةَ بْنِ عَمْرٍو ،  عَنْ  عَطَاءٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  ذَنْبٌ يُغْفَرُ ، وَذَنْبٌ لَا يُغْفَرُ ، وَذَنْبٌ يُجَازَى بِهِ  ، فَأَمَّا الذَّنْبُ الَّذِي لَا يُغْفَرُ  فَالشِّرْكُ  بِاللهِ ، وَأَمَّا الذَّنْبُ الَّذِي يُغْفَرُ فَعَمَلُكَ فِيمَا بَيْنَكَ وَبَيْنَ رَبِّكَ ، وَأَمَّا الَّذِي تُجَازَى بِهِ فَظُلْمُكَ أَخَاكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءٍ  إِلَّا  طَلْحَةُ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7595","","أبو هريرة الدوسي عن عطاء بن أبي رباح عن طلحة بن عمرو الحضرمي عن عبد المجيد بن عبد العزيز بن أبي رواد عن أحمد بن شيبان بن الوليد الفزاري عن محمد بن أحمد بن الوليد المديني عن الطبراني","محمد بن أحمد بن الوليد الأصبهاني"
"7602","[7/313]      7596  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْوَلِيدِ ،  نَا  سَعِيدُ بْنُ عَمْرٍو السَّكُونِيُّ ،  نَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  مَحْفُوظِ بْنِ مِسْوَرٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ بَلَغَهُ عَنِّي حَدِيثٌ فَكَذَّبَ بِهِ ، فَقَدْ كَذَّبَ ثَلَاثَةً  : اللهَ ، وَرَسُولَهُ ، وَالَّذِي حَدَّثَ بِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  إِلَّا  مَحْفُوظُ بْنُ مِسْوَرٍ  ،  تَفَرَّدَ بِهِ  :  بَقِيَّةُ  "" .","","Al-Mu'jam al-Awsat 7596","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن محفوظ بن مسور الفهري عن بقية بن الوليد عن سعيد بن عمرو السكوني عن محمد بن أحمد بن الوليد المديني عن الطبراني","محمد بن أحمد بن الوليد الأصبهاني"
"7603","7597  -  حَدَّثَنِي  مُحَمَّدُ بْنُ حَمْزَةَ بْنِ عُمَارَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدِ بْنِ حَاتِمٍ ،  ثَنَا  شَبَابَةُ بْنُ سَوَّارٍ ،  ثَنَا  الْمُغِيرَةُ بْنُ مُسْلِمٍ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْوَلِيدِ بْنِ مُسْلِمٍ ،  عَنْ  جُنْدُبٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا اسْتَأْذَنَ أَحَدُكُمْ ثَلَاثًا فَلَمْ يُؤْذَنْ لَهُ فَلْيَرْجِعْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يُونُسَ  إِلَّا  الْمُغِيرَةُ بْنُ مُسْلِمٍ  ،  تَفَرَّدَ بِهِ  :  شَبَابَةُ  "" .","","Al-Mu'jam al-Awsat 7597","","جندب بن عبد الله البجلي عن الوليد بن مسلم العنبري عن يونس بن عبيد عن المغيرة بن مسلم القسملي عن شبابة بن سوار المدائني عن عباس الدوري عن محمد بن حمزة بن عمارة الأصبهاني عن الطبراني","محمد بن حمزة بن عمارة الأصبهاني"
"7604","7598  -  حَدَّثَنِي  مُحَمَّدُ بْنُ حَمْزَةَ بْنِ عُمَارَةَ ،  نَا  الْعَبَّاسُ بْنُ مُحَمَّدٍ ،  نَا  خَالِدُ بْنُ يَزِيدَ بْنِ زِيَادٍ  ،  ثَنَا  كَامِلٌ أَبُو الْعَلَاءِ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  رُبَّمَا حَكَكْتُ الْمَنِيَّ مِنْ ثَوْبِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ  إِلَّا  طَلْحَةُ بْنُ يَحْيَى  ، وَلَا رَوَاهُ عَنْ  طَلْحَةَ  إِلَّا  كَامِلٌ  ، وَلَا عَنْ  كَامِلٍ  إِلَّا  خَالِدُ بْنُ يَزِيدَ  ،  تَفَرَّدَ بِهِ  :  الْعَبَّاسُ بْنُ مُحَمَّدٍ  ""  .  كذا في طبعة دار الحرمين : ( الطيب ) وهو خطأ والمثبت من المعجم الصغير وينظر ترجمته في التهذيبين وغيرهما والله أعلم","","Al-Mu'jam al-Awsat 7598","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن طلحة بن يحيى بن طلحة التيمي عن كامل بن العلاء التميمي عن خالد بن يزيد الكحال عن عباس الدوري عن محمد بن حمزة بن عمارة الأصبهاني عن الطبراني","محمد بن حمزة بن عمارة الأصبهاني"
"7605","7599  -  وَبِهِ  :  حَدَّثَنَا  كَامِلٌ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا زَنَتِ الْأَمَةُ ، ثُمَّ زَنَتْ ، ثُمَّ زَنَتْ  ، فَبِيعُوهَا وَلَوْ  بِعِقَالٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي يَحْيَى الْقَتَّاتِ  إِلَّا  كَامِلٌ  ، وَلَا رَوَاهُ عَنْ  كَامِلٍ  إِلَّا  خَالِدُ بْنُ يَزِيدَ  ،  تَفَرَّدَ بِهِ  :  الْعَبَّاسُ  "" .","","Al-Mu'jam al-Awsat 7599","","أبو هريرة الدوسي عن مجاهد بن جبر المخزومي عن أبويحيى القتات عن كامل بن العلاء التميمي عن خالد بن يزيد الكحال عن عباس الدوري عن محمد بن حمزة بن عمارة الأصبهاني عن الطبراني","محمد بن حمزة بن عمارة الأصبهاني"
"7606","[7/314]      7600  -  وَبِهِ  :  عَنْ  مُجَاهِدٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  فَاتَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَانِ قَبْلَ الْعَصْرِ  ، فَلَمَّا انْصَرَفَ صَلَّاهُمَا ، ثُمَّ لَمْ يُصَلِّهِمَا بَعْدُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي يَحْيَى الْقَتَّاتِ  إِلَّا  كَامِلٌ  ، وَلَا عَنْ  كَامِلٍ  إِلَّا  خَالِدُ بْنُ يَزِيدَ  ،  تَفَرَّدَ بِهِ  :  الْعَبَّاسُ  "" .","","Al-Mu'jam al-Awsat 7600","","عائشة بنت أبي بكر الصديق عن مجاهد بن جبر المخزومي عن حبيب بن أبي ثابت الكاهلي عن كامل بن العلاء التميمي عن خالد بن يزيد الكحال عن عباس الدوري عن محمد بن حمزة بن عمارة الأصبهاني عن الطبراني","محمد بن حمزة بن عمارة الأصبهاني"
"7607","7601  -  حَدَّثَنِي  مُحَمَّدُ بْنُ حَمْزَةَ ،  ثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدٍ ،  ثَنَا  بُكَيْرُ ابْنُ أَخِي جُوَيْرِيَةَ ،  نَا  جَعْفَرُ بْنُ سُلَيْمَانَ الضُّبَعِيُّ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ كَانَ يَأْمُرُ بِقَتْلِ الْحَيَّاتِ كُلِّهَا ، حَتَّى  أَخْبَرَهُ  أَبُو لُبَابَةَ بْنُ عَبْدِ الْمُنْذِرِ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ قَتْلِ الْحَيَّاتِ الَّتِي تَكُونُ فِي الْبُيُوتِ  ، وَحَدَّثَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ذَهَبَ يَسْتَلِمُ  الْحَجَرَ  ، فَلَدَغَتْهُ عَقْرَبٌ ، فَقَالَ : "" مَا لَكِ ، لَعَنَكِ اللهُ ؟ لَوْ كُنْتِ تَارِكَةً أَحَدًا لَتَرَكْتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامٍ  إِلَّا  جَعْفَرٌ  ، وَلَا عَنْ  جَعْفَرٍ  إِلَّا  بُكَيْرٌ  ،  تَفَرَّدَ بِهِ  :  الْعَبَّاسُ  ، وَلَا يُرْوَى آخِرُ الْحَدِيثِ عَنْ  أَبِي لُبَابَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7601","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن هشام بن حسان العتكي عن جعفر بن سليمان الضبعي عن بكير بن محمد بن أسماء بن عبيد عن عباس الدوري عن محمد بن حمزة بن عمارة الأصبهاني عن الطبراني","محمد بن حمزة بن عمارة الأصبهاني"
"7608","7602  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَرْمَلَةَ الْقَلْزُمِيُّ  ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَعْقُوبَ الدَّارِيُّ ،  ثَنَا  سَعِيدُ بْنُ هَاشِمِ بْنِ صَالِحٍ الْمَخْزُومِيُّ ،  نَا  يَعْقُوبُ بْنُ قَيْسٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَذِنَ فِي قَتْلِ خَمْسٍ مِنَ الدَّوَابِّ لِلْمُحْرِمِ  : الْغُرَابِ ،  وَالْحِدَأَةِ  ، وَالْكَلْبِ  الْعَقُورِ  ، وَالْعَقْرَبِ ،  وَالْفَأْرَةِ  .  كذا في طبعة دار الحرمين ، والصواب : ( محمد بن أبي حرملة القلزمي ) وينظر الحديث الذي بعده","","Al-Mu'jam al-Awsat 7602","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يعقوب بن قيس الكوفي عن سعيد بن هاشم الفيومي عن أحمد بن محمد بن يعقوب الداري عن محمد بن حرملة الحرشي عن الطبراني","محمد بن حرملة القلزمي"
"7609","7603  -  وَبِهِ  :  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَبِيعُوا الثِّمَارَ حَتَّى يَبْدُوَ         [7/315]      صَلَاحُهَا  ، نَهَى الْبَائِعَ وَالْمُبْتَاعَ  .","","Al-Mu'jam al-Awsat 7603","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يعقوب بن قيس الكوفي عن سعيد بن هاشم الفيومي عن أحمد بن محمد بن يعقوب الداري عن محمد بن حرملة القلزمي عن الطبراني","محمد بن حرملة القلزمي"
"7610","7604  -  وَبِهِ  : قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُتَبَايِعَانِ  بِالْخِيَارِ  ، كُلُّ وَاحِدٍ مِنْهُمَا ، مَا لَمْ يَتَفَرَّقَا  ، وَكَانَا جَمِيعًا ، أَوْ يُخَيِّرْ أَحَدُهُمَا صَاحِبَهُ ، فَإِنْ خَيَّرَ أَحَدُهُمَا الْآخَرَ ، فَتَبَايَعَا عَلَى ذَلِكَ فَقَدْ  وَجَبَ  الْبَيْعُ  .","","Al-Mu'jam al-Awsat 7604","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يعقوب بن قيس الكوفي عن سعيد بن هاشم الفيومي عن أحمد بن محمد بن يعقوب الداري عن محمد بن حرملة الحرشي عن الطبراني","محمد بن حرملة القلزمي"
"7611","7605  -  وَبِهِ  : قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَدْخُلُ الْفُقَرَاءُ قَبْلَ الْأَغْنِيَاءِ الْجَنَّةَ بِخَمْسِمِائَةِ عَامٍ  .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنْ  يَعْقُوبَ بْنِ قَيْسٍ  إِلَّا  سَعِيدُ بْنُ هَاشِمٍ  ،  تَفَرَّدَ بِهَا  :  أَحْمَدُ بْنُ مُحَمَّدٍ الدَّارِيُّ - مِنْ وَلَدِ تَمِيمٍ الدَّارِيِّ  - "" .","","Al-Mu'jam al-Awsat 7605","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يعقوب بن قيس الكوفي عن سعيد بن هاشم الفيومي عن أحمد بن محمد بن يعقوب الداري عن محمد بن حرملة الحرشي عن الطبراني","محمد بن حرملة القلزمي"
"7612","7606  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي حَرْمَلَةَ ،  نَا  إِسْحَاقُ بْنُ إِسْمَاعِيلَ بْنِ عَبْدِ الْأَعْلَى الْأَيْلِيُّ ،  نَا  عَمْرُو بْنُ هَاشِمٍ الْبَيْرُوتِيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي قَتَادَةَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَقْبَلُ اللهُ مِنِ امْرَأَةٍ صَلَاةً حَتَّى تُوَارِيَ زِينَتَهَا  ، وَلَا مِنْ جَارِيَةٍ بَلَغَتِ الْمَحِيضَ حَتَّى تَخْتَمِرَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَوْزَاعِيِّ  إِلَّا  عَمْرُو بْنُ هَاشِمٍ  ،  تَفَرَّدَ بِهِ  :  إِسْحَاقُ بْنُ إِسْمَاعِيلَ  "" .","","Al-Mu'jam al-Awsat 7606","","أبو قتادة الأنصاري فارس رسول الله عن عبد الله بن أبي قتادة السلمي عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن عمرو بن هاشم البيروتي عن إسحاق بن إسماعيل الأيلي عن محمد بن حرملة الحرشي عن الطبراني","محمد بن حرملة القلزمي"
"7613","7607  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ - بْنِ شَاذَانَ - ،  ثَنَا  أَبِي  ،  نَا  سَعْدُ بْنُ الصَّلْتِ ،  ثَنَا  الْحَسَنُ بْنُ عَمْرٍو الْفُقَيْمِيُّ ،  عَنْ  يَزِيدَ بْنِ خُصَيْفَةَ ،  عَنْ  ثَوْبَانَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ سِتَّةَ أَيَّامٍ بَعْدَ الْفِطْرِ مُتَتَابِعَةً  ، فَكَأَنَّمَا صَامَ السَّنَةَ  .         [7/316]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَسَنِ بْنِ عَمْرٍو  إِلَّا  سَعْدُ بْنُ الصَّلْتِ  ،  تَفَرَّدَ بِهِ  :  شَاذَانُ  ، وَقَالَ : عَنْ  يَزِيدَ  ، عَنْ  ثَوْبَانَ  وَإِنَّمَا هُوَ :  يَزِيدُ - يَعْنِي ابْنَ خُصَيْفَةَ  - ، عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ  "" .","","Al-Mu'jam al-Awsat 7607","","أبو هريرة الدوسي عن محمد بن عبد الرحمن بن ثوبان القرشي عن يزيد بن عبد الله بن خصيفة الكندي عن الحسن بن عمرو الفقيمي عن سعد بن الصلت بن برد البجلي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق بن إبراهيم بن شاذان عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7614","7608  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ ،  ثَنَا  أَبِي  ،  نَا  سَعْدُ بْنُ الصَّلْتِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّهَا سَمِعَتْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَنْ كَانَ عَلَيْهِ دَيْنٌ يَنْوِي أَدَاءَهُ كَانَ مَعَهُ مِنَ اللهِ عَوْنٌ  ، وَسَبَّبَ اللهُ لَهُ رِزْقًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  سَعْدُ بْنُ الصَّلْتِ  ، وَلَا رَوَاهُ عَنْ  سَعْدٍ  إِلَّا  شَاذَانُ  "" .","","Al-Mu'jam al-Awsat 7608","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سعد بن الصلت بن برد البجلي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق بن إبراهيم عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7615","7609  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبِي  ،  ثَنَا  سَعْدُ بْنُ الصَّلْتِ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ عَلِيِّ بْنِ حُسَيْنٍ  ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَلْبَسُ يَوْمَ الْعِيدِ بُرْدَةً حَمْرَاءَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ  إِلَّا  سَعْدُ بْنُ الصَّلْتِ  ،  تَفَرَّدَ بِهِ  :  شَاذَانُ  "" .","","Al-Mu'jam al-Awsat 7609","","عبد الله بن عباس عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن سعد بن الصلت بن برد البجلي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7616","[7/317]      7610  -  وَبِهِ  :  حَدَّثَنَا  سَعْدُ بْنُ الصَّلْتِ ،  عَنْ  مُبَارَكِ بْنِ فَضَالَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ :  أُتِيَ  عُثْمَانُ بْنُ عَفَّانَ  عَامَ حَجَّ بِثَرِيدَةٍ عَلَيْهَا مِنْ هَذَا الْحَجَلِ ، أَصَابَهُ أَهْلُ الْحِلِّ  ، فَقَالَ بَعْضُ  الْقَوْمِ  : إِنَّ عَلِيًّا يَكْرَهُ هَذَا . فَأَرْسَلَ إِلَى  عَلِيٍّ  ، فَدَعَاهُ ، فَكَانَ يُصْلِحُ خَبَطًا لَهُ ، فَنَفَضَ يَدَهُ ، ثُمَّ جَاءَ ، فَقَالَ لَهُ  عُثْمَانُ  : لَا تَزَالُ تُخَالِفُ فِي شَيْءٍ ، يَزْعُمُونَ أَنَّكَ تَقُولُ لَا يَصْلُحُ هَذَا ، فَغَضِبَ  عَلِيٌّ  ، وَقَالَ : لِهَذَا تَقُولُ لِي تُخَالِفُ ،  أَنْشُدُ  بِاللهِ مَنْ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ عَامَ حَجَّ ، وَأُتِيَ بِرِجْلِ حِمَارٍ وَحْشِيٍّ ، فَقَالَ : "" أَطْعِمُوهُ أَهْلَ الْحِلِّ ، فَإِنَّا مُحْرِمُونَ "" ؟ فَقَامَ غَيْرُ وَاحِدٍ ، فَشَهِدُوا لَهُ ، ثُمَّ قَالَ :  أَنْشُدُ  بِاللهِ مَنْ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ عَامَ حَجَّ ، وَأُتِيَ بِبَيْضِ نَعَامٍ :  أَطْعِمُوهُ أَهْلَ الْحِلِّ ، فَإِنَّا مُحْرِمُونَ  ؟ فَقَامَ غَيْرُ وَاحِدٍ ، فَشَهِدُوا لَهُ ، فَتَفَرَّقُوا عَنْ تِلْكَ الْقَصْعَةِ  .  قَالَ  سَعِيدُ بْنُ الْمُسَيِّبِ  : "" كَأَنِّي أَنْظُرُ إِلَى رِجْلِ ذَاكَ الْحَجَلِ قَائِمًا ، مَا يَأْكُلُهُ أَحَدٌ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُبَارَكِ بْنِ فَضَالَةَ  إِلَّا  سَعْدُ بْنُ الصَّلْتِ  ،  تَفَرَّدَ بِهِ  :  شَاذَانُ  "" .","","Al-Mu'jam al-Awsat 7610","","علي بن أبي طالب عن سعيد بن المسيب عن علي بن زيد بن جدعان عن مبارك بن فضالة عن سعد بن الصلت بن برد البجلي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7617","7611  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ ،  نَا  أَبِي  ،  ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  عَبَّادُ بْنُ رَاشِدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تُعْرَضُ الْأَعْمَالُ عَلَى اللهِ يَوْمَ الْقِيَامَةِ  ، فَتَجِيءُ الصَّلَاةُ ، فَيَقُولُ : يَا رَبِّ أَنَا الصَّلَاةُ ، فَيَقُولُ اللهُ : إِنَّكِ عَلَى خَيْرٍ ، وَتَجِيءُ الصَّدَقَةُ ، فَيَقُولُ : يَا رَبِّ أَنَا الصَّدَقَةُ ، فَيَقُولُ : إِنَّكِ عَلَى خَيْرٍ ، وَيَجِيءُ الصَّوْمُ ، فَيَقُولُ : يَا رَبِّ أَنَا الصَّوْمُ ، فَيَقُولُ : إِنَّكَ عَلَى خَيْرٍ ، حَتَّى يَجِيءَ الْإِسْلَامُ ، فَيَقُولُ : يَا رَبِّ ، أَنْتَ السَّلَامُ ، وَأَنَا الْإِسْلَامُ ، فَيَقُولُ اللهُ : إِنَّكَ عَلَى         [7/318]      خَيْرٍ ، بِكَ آخُذُ الْيَوْمَ ، وَبِكَ أُعْطِي ، فَيَقُولُ اللهُ :         {      إِنَّ الدِّينَ عِنْدَ اللهِ الإِسْلامُ         }             {      وَمَنْ يَبْتَغِ غَيْرَ الإِسْلامِ دِينًا فَلَنْ يُقْبَلَ مِنْهُ وَهُوَ فِي الآخِرَةِ مِنَ الْخَاسِرِينَ         }      .","","Al-Mu'jam al-Awsat 7611","","أبو هريرة الدوسي عن الحسن البصري عن عباد بن راشد الكليبى عن حجاج بن نصير الفساطيطي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7618","7612  -  وَبِهِ  :  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَوَّلُ مَا يُسْأَلُ عَنْهُ الْعَبْدُ يَوْمَ الْقِيَامَةِ صَلَاتُهُ  ، فَيَقُولُ : انْظُرُوا إِلَى صَلَاةِ عَبْدِي ، فَإِنْ كَانَ أَتَمَّهَا قِيلَ : يَا رَبِّ أَتَمَّهَا ، وَإِنْ كَانَ نَقَصَهَا قِيلَ : يَا رَبِّ ، نَقَصَهَا ، فَيَقُولُ اللهُ : انْظُرُوا هَلْ لِعَبْدِي مِنْ تَطَوُّعٍ ؟ فَيُقَالُ نَعَمْ ، كَثِيرٌ ، فَيَقُولُ : فَأَتِمُّوا لِعَبْدِي مِنْ تَطَوُّعِهِ ، ثُمَّ تُؤْخَذُ الْأَعْمَالُ عَلَى قَدْرِ ذَلِكَ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عَبَّادِ بْنِ رَاشِدٍ  إِلَّا  حَجَّاجُ بْنُ نُصَيْرٍ  "" .","","Al-Mu'jam al-Awsat 7612","","أبو هريرة الدوسي عن الحسن البصري عن عباد بن راشد الكليبى عن حجاج بن نصير الفساطيطي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7619","7613  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبِي  ،  ثَنَا  سَعْدُ بْنُ الصَّلْتِ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَلْقَمَةَ اللَّيْثِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَطَاءِ بْنِ يَزِيدَ ،  عَنْ  أَبِي أَيُّوبَ الْأَنْصَارِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَسْتَقْبِلُوا الْقِبْلَةَ وَلَا تَسْتَدْبِرُوهَا لِبَوْلٍ ، وَلَا لِغَائِطٍ  ، وَلَكِنْ  شَرِّقُوا  أَوْ غَرِّبُوا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ عَمْرٍو  إِلَّا  سَعْدُ بْنُ الصَّلْتِ  ،  تَفَرَّدَ بِهِ  :  شَاذَانُ  "" .","","Al-Mu'jam al-Awsat 7613","","أبو أيوب الأنصاري عن عطاء بن يزيد الجندعي عن الزهري عن محمد بن عمرو بن علقمة بن وقاص الليثي عن سعد بن الصلت بن برد البجلي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7620","7614  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبِي  ،  نَا  الْكَرْمَانِيُّ بْنُ عَمْرٍو ،  نَا  سَعِيدُ بْنُ زَرْبِيٍّ الْخُزَاعِيُّ ،  نَا  مُحَمَّدُ بْنُ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  جَاءَتْ  فَاطِمَةُ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِبُرْمَةٍ  لَهَا قَدْ صَنَعَتْ لَهُ حَسَاةً فَحَمَلَتْهَا عَلَى طَبَقٍ ، فَوَضَعَتْهَا بَيْنَ يَدَيْهِ ، فَقَالَ لَهَا :  أَيْنَ ابْنُ عَمِّكِ وَابْنَاكِ ؟  قَالَتْ : فِي الْبَيْتِ ، فَقَالَ : "" اذْهَبِي فَادْعِيهِمْ "" فَجَاءَتْ إِلَى  عَلِيٍّ  ، فَقَالَتْ : أَجِبْ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَابْنَاكَ .         [7/319]      قَالَتْ  أُمُّ سَلَمَةَ  : فَجَاءَ  عَلِيٌّ  يَمْشِي آخِذًا بِيَدِ  الْحَسَنِ  وَالْحُسَيْنِ  ،  وَفَاطِمَةُ  تَمْشِي مَعَهُمْ ، فَلَمَّا رَآهُمْ مُقْبِلِينَ مَدَّ يَدَهُ إِلَى كِسَاءٍ كَانَ عَلَى  الْمَنَامَةِ ،  فَبَسَطَهُ فَأَجْلَسَهُمْ عَلَيْهِ ، وَأَخَذَ بِأَطْرَافِ الْكِسَاءِ الْأَرْبَعَةِ بِشِمَالِهِ ، فَضَمَّهُ فَوْقَ رُءُوسِهِمْ ، وَأَهْوَى بِيَدِهِ الْيُمْنَى إِلَى رَبِّهِ ، فَقَالَ : "" اللَّهُمَّ هَؤُلَاءِ أَهْلُ بَيْتِي ، فَأَذْهِبْ عَنْهُمُ الرِّجْسَ ، وَطَهِّرْهُمْ تَطْهِيرًا "" ثَلَاثَ مَرَّاتٍ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي هُرَيْرَةَ  إِلَّا  مُحَمَّدُ بْنُ سِيرِينَ  ، وَلَا عَنِ  ابْنِ سِيرِينَ  إِلَّا  سَعِيدُ بْنُ زَرْبِيٍّ  ،  تَفَرَّدَ بِهِ  :  الْكَرْمَانِيُّ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7614","","هند بنت أبي أمية زوج رسول الله عن أبو هريرة الدوسي عن محمد بن سيرين عن سعيد بن زربى الخزاعي عن معاوية بن عمرو بن المهلب الأزدي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7621","7615  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  نَا  أَبِي  ،  نَا  سَعْدُ بْنُ الصَّلْتِ ،  نَا  مِسْعَرُ بْنُ كِدَامٍ ،  عَنِ  الْعَبَّاسِ بْنِ ذَرِيحٍ ،  عَنْ  زِيَادِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ  ،  نَا  عَمَّارُ بْنُ يَاسِرٍ ،  أَنَّهُمْ سَأَلُوا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَلْ أَتَيْتَ مِنَ النِّسَاءِ حَرَامًا فِي الْجَاهِلِيَّةِ ؟ قَالَ : "" لَا  ، وَكُنْتُ عَلَى مِيعَادَيْنِ : أَمَّا أَحَدُهُمَا فَغَلَبَتْنِي عَنْهُ عَيْنِي ، وَأَمَّا الْآخَرُ فَحَالَ بَيْنِي وَبَيْنَهُ  سَامِرُ  الْقَوْمِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مِسْعَرٍ  إِلَّا  سَعْدُ بْنُ الصَّلْتِ  ،  تَفَرَّدَ بِهِ  :  شَاذَانُ  ، وَلَا يُرْوَى عَنْ  عَمَّارٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( النخعي )","","Al-Mu'jam al-Awsat 7615","","عمار بن ياسر عن زياد بن عبد الله النخعي عن عباس بن ذريح الكلبي عن مسعر بن كدام عن سعد بن الصلت بن برد البجلي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7622","7616  -  وَبِهِ  :  نَا  سَعْدُ بْنُ الصَّلْتِ ،  نَا  أَبُو الْجَهْمِ هَارُونُ بْنُ الْجَهْمِ الْقُرَشِيُّ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، يُحَدِّثُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الطَّيْرَ لَتَضْرِبُ بِمَنَاقِيرِهَا عَلَى الْأَرْضِ  ، وَتُحَرِّكُ أَذْنَابَهَا مِنْ هَوْلِ يَوْمِ الْقِيَامَةِ ، وَمَا يَتَكَلَّمُ شَاهِدُ  الزُّورِ  ، وَلَا تَقَارُّ         [7/320]      قَدَمَاهُ عَلَى الْأَرْضِ حَتَّى يُقْذَفَ بِهِ فِي النَّارِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  إِلَّا  أَبُو الْجَهْمِ  ، وَلَا عَنْ  أَبِي الْجَهْمِ  إِلَّا  سَعْدُ بْنُ الصَّلْتِ  ،  تَفَرَّدَ بِهِ  :  شَاذَانُ  "" .","","Al-Mu'jam al-Awsat 7616","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عبد الملك بن عمير القبطي عن هارون بن الجهم بن ثوير عن سعد بن الصلت بن برد البجلي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق بن موسى المروزي عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7623","7617  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  نَا  أَبِي  ،  ثَنَا  أَبُو دَاوُدَ الطَّيَالِسِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ بُدَيْلِ بْنِ مَيْسَرَةَ الْعُقَيْلِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَفْتَتِحُ الصَّلَاةَ بِالتَّكْبِيرِ  ، وَالْقِرَاءَةِ بِـ         {      الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      فَإِذَا رَكَعَ لَمْ يَخْفِضْ رَأْسَهُ وَلَمْ يَرْفَعْهُ ، وَلَكِنْ بَيْنَ ذَلِكَ ، وَكَانَ يَقُولُ فِي كُلِّ رَكْعَتَيْنِ  التَّحِيَّاتِ  ، وَكَانَ يَخْتِمُ الصَّلَاةَ بِالتَّسْلِيمِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ بُدَيْلٍ  إِلَّا  أَبُو دَاوُدَ الطَّيَالِسِيُّ  "" .","","Al-Mu'jam al-Awsat 7617","","عائشة بنت أبي بكر الصديق عن أوس بن عبد الله الربعي عن بديل بن ميسرة العقيلي عن عبد الرحمن بن بديل العقيلي عن أبو داود الطيالسي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7624","7618  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبِي  ،  نَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  أَبُو عَامِرٍ الْخَزَّازُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، قَالَتِ :  اسْتَأْذَنَ  رَجُلٌ  عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : ""  بِئْسَ  أَخُو الْعَشِيرَةِ "" فَلَمَّا دَخَلَ عَلَيْهِ أَقْبَلَ عَلَيْهِ بِوَجْهِهِ وَحَدَّثَهُ ، فَلَمَّا خَرَجَ ، قُلْتُ : يَا رَسُولَ اللهِ ، قُلْتَ : ""  بِئْسَ  أَخُو الْعَشِيرَةِ "" ، فَلَمَّا دَخَلَ أَقْبَلْتَ عَلَيْهِ بِوَجْهِكَ وَحَدَّثْتَهُ ؟ فَقَالَ :  إِنَّ مِنْ شِرَارِ النَّاسِ مَنْ يُتَّقَى لِشَرِّهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي عَامِرٍ الْخَزَّازِ  إِلَّا  حَجَّاجُ بْنُ نُصَيْرٍ  ،  تَفَرَّدَ بِهِ  :  شَاذَانُ  "" .","","Al-Mu'jam al-Awsat 7618","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن المنكدر عن صالح بن رستم الخزاز عن حجاج بن نصير الفساطيطي عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7625","7619  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ شَاذَانُ ،  ثَنَا  أَبِي  ،  ثَنَا  مُجَاشِعُ بْنُ عَمْرٍو ،  نَا  ابْنُ لَهِيعَةَ ،  نَا  عُقَيْلُ بْنُ خَالِدٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  مَحَلَ النَّاسُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَتَاهُ الْمُسْلِمُونَ ، فَقَالُوا : يَا رَسُولَ اللهِ ،  قَحَطَ  الْمَطَرُ ، وَيَبِسَ الشَّجَرُ ، وَهَلَكَتِ الْمَوَاشِي ، وَأَسْنَتَ النَّاسُ ، فَاسْتَسْقِ لَنَا رَبَّكَ . فَقَالَ :  إِذَا كَانَ يَوْمُ كَذَا وَكَذَا فَاخْرُجُوا وَاخْرُجُوا مَعَكُمْ بِصَدَقَاتٍ  فَلَمَّا كَانَ ذَلِكَ الْيَوْمُ خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالنَّاسُ ، يَمْشِي وَيَمْشُونَ ،         [7/321]      عَلَيْهِمُ  السَّكِينَةُ  وَالْوَقَارُ  حَتَّى أَتَوُا الْمُصَلَّى ، فَتَقَدَّمَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى بِهِمْ رَكْعَتَيْنِ يَجْهَرُ فِيهِمَا بِالْقِرَاءَةِ . وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الْعِيدَيْنِ وَالِاسْتِسْقَاءِ فِي الرَّكْعَةِ الْأُولَى بِفَاتِحَةِ الْكِتَابِ ، وَ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ، وَفِي الرَّكْعَةِ الثَّانِيَةِ بِفَاتِحَةِ الْكِتَابِ ، وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      فَلَمَّا قَضَى صَلَاتَهُ اسْتَقْبَلَ  الْقَوْمَ  بِوَجْهِهِ ، وَقَلَبَ رِدَاءَهُ ، ثُمَّ  جَثَا  عَلَى رُكْبَتَيْهِ ، وَرَفَعَ يَدَيْهِ ، وَكَبَّرَ تَكْبِيرَةً قَبْلَ أَنْ يَسْتَسْقِيَ ، ثُمَّ قَالَ : "" اللَّهُمَّ اسْقِنَا ،  وَأَغِثْنَا  ، اللَّهُمَّ اسْقِنَا غَيْثًا مُغِيتًا ، رَحْبًا ، رَبِيعًا ، وَجَدًا ،  غَدَقًا ،  طَبَقًا ،  مُغْدِقًا ، هَنِيئًا ،  مَرِيئًا ،  مَرِيعًا  ،  مُرْتِعًا  وَابِلًا ، شَامِلًا ،  مُسْبِلًا  ،  مُجَلَّلًا ،  دَائِمًا  دَرَرًا  ، نَافِعًا غَيْرَ ضَارٍّ ، عَاجِلًا غَيْرَ  رَائِثٍ  ، غَيْثًا ، اللَّهُمَّ تُحْيِي بِهِ الْبِلَادَ ، وَتُغِيثُ بِهِ الْعِبَادَ ، وَتَجْعَلُهُ  بَلَاغًا  لِلْحَاضِرِ مِنَّا وَالْبَادِ ، اللَّهُمَّ أَنْزِلْ عَلَيْنَا فِي أَرْضِنَا  زِينَتَهَا ،  وَأَنْزِلْ فِي أَرْضِنَا  سَكَنَهَا ،  اللَّهُمَّ أَنْزِلْ عَلَيْنَا مِنَ السَّمَاءِ مَاءً طَهُورًا ، فَأَحْيِ بِهِ بَلْدَةً مَيْتَةً ، وَأَسْقِهِ مِمَّا خَلَقْتَ لَنَا أَنْعَامًا وَأَنَاسِيَّ كَثِيرًا "" .  قَالَ : فَمَا بَرِحُوا حَتَّى أَقْبَلَ  قَزَعٌ  مِنَ السَّحَابِ ، فَالْتَأَمَ بَعْضُهُ إِلَى بَعْضٍ ، ثُمَّ مَطَرَتْ عَلَيْهِمْ سَبْعَةَ أَيَّامٍ وَلَيَالِيَهُنَّ ، لَا يُقْلِعُ عَنِ  الْمَدِينَةِ  ، فَأَتَاهُ الْمُسْلِمُونَ فَقَالُوا : يَا رَسُولَ اللهِ ، قَدْ غَرِقَتِ الْأَرْضُ ، وَتَهَدَّمَتِ الْبُيُوتُ ، وَانْقَطَعَتِ السُّبُلُ ، فَادْعُ اللهَ لَنَا أَنْ يَصْرِفَهَا عَنَّا ، قَالَ : فَضَحِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ عَلَى الْمِنْبَرِ حَتَّى بَدَتْ  نَوَاجِذُهُ  تَعَجُّبًا لِسُرْعَةِ مَلَالَةِ بَنِي آدَمَ ، ثُمَّ قَالَ ، "" اللَّهُمَّ  حَوَالَيْنَا  وَلَا عَلَيْنَا ، اللَّهُمَّ عَلَى رُءُوسِ  الظِّرَابِ  ، وَمَنَابِتِ الشَّجَرِ ، وَبُطُونِ الْأَوْدِيَةِ ، وَظُهُورِ الْآكَامِ "" قَالَ : فَتَصَدَّعَتْ عَنِ  الْمَدِينَةِ  ، وَكَانَتْ فِي مِثْلِ التُّرْسِ تُمْطِرُ مَرَاعِيَهَا وَلَا تَقْطُرُ فِيهَا قَطْرَةً "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  عُقَيْلٌ  ، وَلَا عَنْ  عُقَيْلٍ  إِلَّا  ابْنُ لَهِيعَةَ  ، وَلَا عَنِ  ابْنِ لَهِيعَةَ  إِلَّا  مُجَاشِعُ بْنُ عَمْرٍو  ،  تَفَرَّدَ بِهِ  :  شَاذَانُ  "" .","","Al-Mu'jam al-Awsat 7619","","أنس بن مالك عن الزهري عن عقيل بن خالد الأيلي عن عبد الله بن لهيعة عن مجاشع بن عمرو عن شاذان إسحاق بن إبراهيم بن محمد النهشلي عن محمد بن إسحاق بن إبراهيم شاذان عن الطبراني","محمد بن إسحاق بن إبراهيم بن شاذان"
"7626","7620  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ الْأَدَمِيُّ الشِّيرَازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،         [7/322]      نَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنْ  أَشْعَثَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عِيَاضِ بْنِ حِمَارٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّا لَا نَقْبَلُ  زَبَدَ  الْمُشْرِكِينَ  يَعْنِي : هَدَايَاهُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَشْعَثَ بْنِ سَوَّارٍ  إِلَّا  حَفْصٌ  :  تَفَرَّدَ بِهِ  :  سَهْلُ بْنُ عُثْمَانَ  .","","Al-Mu'jam al-Awsat 7620","","عياض بن حمار المجاشعي عن الحسن البصري عن أشعث بن سوار عن حفص بن غياث النخعي عن سهل بن عثمان العسكري عن محمد بن المرزبان الأدمي الشيرازي عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7627","7621  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ الْأَدَمِيُّ الشِّيرَازِيُّ ،  ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  نَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  أَبِي أَيُّوبَ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ :  مَرَّ بِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَنَا فِي غَنَمٍ  لِعُقْبَةَ  ، فَمَسَحَ رَأْسِي ، وَقَالَ :  يَرْحَمُكَ اللهُ ، إِنَّكَ غُلَيِّمٌ  مُعَلَّمٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي أَيُّوبَ  إِلَّا  ابْنُ أَبِي زَائِدَةَ  ،  تَفَرَّدَ بِهِ  : سَهْلُ بْنُ عُثْمَانَ  "" .","","Al-Mu'jam al-Awsat 7621","","عبد الله بن مسعود عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن عبد الله بن علي الأزرق عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن محمد بن المرزبان الأدمي الشيرازي عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7628","7622  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ ،  نَا  سَهْلُ بْنُ عُثْمَانَ ،  نَا  الْمُحَارِبِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  جَابِرٍ ،  عَنْ  مُنْذِرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ قَالَ :  سَأَلْتُ  أَبِي ، وَخَلَوْتُ بِهِ ، قُلْتُ :  يَا أَبَةِ ، مَنْ خَيْرُ هَذِهِ الْأُمَّةِ بَعْدَ نَبِيِّهَا ؟  قَالَ : "" أَبُو بَكْرِ بْنُ أَبِي قُحَافَةَ "" ، قُلْتُ : ثُمَّ مَنْ ؟ قَالَ : "" ثُمَّ عُمَرُ بْنُ الْخَطَّابِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَابِرٍ  إِلَّا  لَيْثٌ  ، وَلَا عَنْ  لَيْثٍ  إِلَّا  الْمُحَارِبِيُّ  ،  تَفَرَّدَ بِهِ  :  سَهْلُ بْنُ عُثْمَانَ  "" .","","Al-Mu'jam al-Awsat 7622","","عمر بن الخطاب عن علي بن أبي طالب عن ابن الحنفية عن المنذر بن يعلى الثوري عن جابر عن ليث بن أبي سليم عن عبد الرحمن بن محمد المحاربي عن سهل بن عثمان العسكري عن محمد بن المرزبان عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7629","7623  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ ،  نَا  مُحَمَّدُ بْنُ حَكِيمٍ الرَّازِيُّ ،  نَا  هِشَامُ بْنُ عُبَيْدِ اللهِ السُّنِّيُّ ،  نَا  أَبُو مُعَاذٍ خَالِدٌ الْبَلْخِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَغْتَسِلُ الْمُسْتَحَاضَةُ مَرَّةً ، ثُمَّ تَتَوَضَّأُ  يَعْنِي : لِكُلِّ صَلَاةٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ  إِلَّا  أَبُو مُعَاذٍ الْبَلْخِيُّ  ،  تَفَرَّدَ بِهِ  :         [7/323]      هِشَامٌ السِّنِّيُّ  "" .","","Al-Mu'jam al-Awsat 7623","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن عجلان عن خالد بن صبيح الخراساني عن هشام بن عبيد الله السني عن محمد بن حكيم الرازي عن محمد بن المرزبان عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7630","7624  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ ،  نَا  مُحَمَّدُ بْنُ حَكِيمٍ الرَّازِيُّ ،  نَا  حَفْصُ بْنُ عُمَرَ الْإِمَامُ ،  عَنْ  صَالِحِ بْنِ أَبِي الْأَخْضَرِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  نَبْهَانَ ، مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُبَاشِرُهَا وَهِيَ طَامِثٌ  ، وَعَلَيْهَا إِزَارٌ إِلَى الرُّكْبَتَيْنِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  صَالِحُ بْنُ أَبِي الْأَخْضَرِ  ،  تَفَرَّدَ بِهِ  :  حَفْصُ بْنُ عُمَرَ الْإِمَامُ  "" .","","Al-Mu'jam al-Awsat 7624","","هند بنت أبي أمية زوج رسول الله عن نبهان المخزومي مولى أم سلمة عن الزهري عن صالح بن أبي الأخضر اليمامي عن حفص بن عمر الرازي عن محمد بن حكيم الرازي عن محمد بن المرزبان عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7631","7625  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ ،  نَا  مُحَمَّدُ بْنُ حَكِيمٍ الرَّازِيُّ ،  نَا  الْحَارِثُ بْنُ مُسْلِمٍ ،  نَا  بَحْرُ بْنُ السَّقَّاءِ  ،  حَدَّثَنِي  الزُّهْرِيُّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُضَاجِعُنِي وَأَنَا حَائِضٌ  ، وَنَغْتَسِلُ جَمِيعًا مِنْ إِنَاءٍ وَاحِدٍ  .  كذا في طبعة دار الحرمين ، والصواب : ( بحر السقاء) ، وليس بن السقاء وينظر مصادر التخريج .","","Al-Mu'jam al-Awsat 7625","","","محمد بن المرزبان الأدمي الشيرازي"
"7632","7626  -  وَبِهِ  :  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  بَحْرٍ السَّقَّاءِ  إِلَّا  الْحَارِثُ بْنُ مُسْلِمٍ  "" .","","Al-Mu'jam al-Awsat 7626","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن بحر بن كنيز السقاء عن الحارث بن مسلم عن محمد بن حكيم الرازي عن محمد بن المرزبان عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7633","7627  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ الْأَدَمِيُّ ،  نَا  نُوحُ بْنُ أَنَسٍ الْمُقْرِئُ الرَّازِيُّ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  نَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنِ  الْفَضْلِ بْنِ عِيسَى الرَّقَاشِيِّ ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  هَذَا رَمَضَانُ قَدْ جَاءَ ، تُفَتَّحُ فِيهِ أَبْوَابُ الْجَنَّةِ  ، وَتُغَلَّقُ فِيهِ أَبْوَابُ النَّارِ ، وَتُغَلُّ فِيهِ الشَّيَاطِينُ ،  بُعْدًا  لِمَنْ أَدْرَكَ رَمَضَانَ وَلَمْ يُغْفَرْ لَهُ ، إِذَا لَمْ يُغْفَرْ لَهُ فِيهِ فَمَتَى ؟  "" .         [7/324]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ  "" .","","Al-Mu'jam al-Awsat 7627","","أنس بن مالك عن يزيد بن أبان الرقاشي عن الفضل بن عيسى الواعظ عن محمد بن إسحاق عن عبد الرحمن بن مغراء الدوسي عن نوح بن أنس الرازي عن محمد بن المرزبان الأدمي عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7634","7628  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ الْأَدَمِيُّ ،  نَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ النَّرْمَقِيُّ ،  نَا  سَهْلُ بْنُ عَبْدِ رَبِّهِ السِّنْدِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْعَلَاءِ بْنِ شَيْبَةَ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  عُقْبَةَ بْنِ عَبْدِ الْغَافِرِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ :  ذُكِرَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  الْعَزْلُ  ، فَقَالَ :  لَا عَلَيْكُمْ أَنْ لَا تَفْعَلُوا ، فَإِنَّمَا هُوَ الْقَدَرُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ عَوْنٍ  إِلَّا  عَبْدُ اللهِ بْنُ الْعَلَاءِ  ،  تَفَرَّدَ بِهِ  :  سَهْلُ بْنُ عَبْدِ رَبِّهِ السِّنْدِيُّ  "" .","","Al-Mu'jam al-Awsat 7628","","أبو سعيد الخدري عن عقبة بن عبد الغافر العوذي عن عبد الله بن عون بن أرطبان عن عبد الله بن العلاء بن شيبة عن سهل بن عبد الرحمن المعروف بالسندي بن عبدويه عن أحمد بن إبراهيم النرمقي عن محمد بن المرزبان الأدمي عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7635","7629  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ ،  نَا  مُحَمَّدُ بْنُ مُقَاتِلٍ الرَّازِيُّ ،  نَا  عِيسَى بْنُ إِبْرَاهِيمَ الْقُرَشِيُّ ،  عَنِ  الْحَكَمِ بْنِ عَبْدِ اللهِ بْنِ سَعْدٍ الْأَيْلِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  عَائِشَةَ ، قَالَتْ : "" إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا دَهَنَ لِحْيَتَهُ بَدَأَ بِعَنْفَقَتِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  الْحَكَمُ بْنُ عَبْدِ اللهِ  ،  تَفَرَّدَ بِهِ  :  عِيسَى بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7629","","عائشة بنت أبي بكر الصديق عن سعيد بن المسيب عن الزهري عن الحكم بن عبد الله بن سعد الأيلي عن عيسى بن إبراهيم بن طهمان الهاشمي عن محمد بن مقاتل الرازي عن محمد بن المرزبان عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7636","7630  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ ،  نَا  مُحَمَّدُ بْنُ مُقَاتِلٍ الرَّازِيُّ ،  نَا  الْفُرَاتُ بْنُ خَالِدٍ ،  عَنْ  مَالِكِ بْنِ مِغْوَلٍ ،  عَنْ  أَبِي دَاوُدَ  قَالَ :  لَقِيَنِي الْبَرَاءُ بْنُ عَازِبٍ ، فَأَخَذَ بِيَدِي وَصَافَحَنِي ، وَضَحِكَ فِي وَجْهِي ، ثُمَّ قَالَ : تَدْرِي لِمَ أَخَذْتُ بِيَدِكَ ؟ قُلْتُ : لَا ، إِلَّا أَنِّي ظَنَنْتُكَ لَمْ تَفْعَلْهُ إِلَّا لِخَيْرٍ ،         [7/325]      فَقَالَ : إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَقِيَنِي فَفَعَلَ بِي ذَلِكَ ، ثُمَّ قَالَ : "" أَتَدْرِي لِمَ فَعَلْتُ بِكَ ذَلِكَ ؟ "" فَقُلْتُ : لَا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمُسْلِمَيْنِ إِذَا الْتَقَيَا وَتَصَافَحَا وَضَحِكَ كُلُّ وَاحِدٍ مِنْهُمَا فِي وَجْهِ صَاحِبِهِ  ، لَا يَفْعَلَانِ ذَلِكَ إِلَّا لِلهِ ، لَمْ يَتَفَرَّقَا حَتَّى يُغْفَرَ لَهُمَا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَالِكِ بْنِ مِغْوَلٍ  إِلَّا  الْفُرَاتُ بْنُ خَالِدٍ  "" .","","Al-Mu'jam al-Awsat 7630","","البراء بن عازب الأوسي عن نفيع بن الحارث الأعمى عن مالك بن مغول الصهيبي عن فرات بن خالد الرازي عن محمد بن مقاتل الرازي عن محمد بن المرزبان عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7637","7631  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ ،  نَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ النَّرْمَقِيُّ ،  نَا  سَلْمُ بْنُ سَالِمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أَبِي أُمَامَةَ الْبَاهِلِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمْ يَكُنْ  شِرْكٌ  مُنْذُ أُهْبِطَ  آدَمُ  مِنَ السَّمَاءِ إِلَى الْأَرْضِ إِلَّا كَانَ بَدْؤُهُ التَّكْذِيبَ بِالْقَدَرِ  ، وَمَا أَشْرَكَتْ أُمَّةٌ إِلَّا بِتَكْذِيبٍ بِالْقَدَرِ ، وَإِنَّكُمْ سَتُبْتَلُونَ بِهِ أَيَّتُهَا الْأُمَّةُ ، فَإِذَا لَقِيتُمُوهُمْ فَكُونُوا أَنْتُمْ سَائِلِينَ ، وَلَا تُمَكِّنُوهُمْ مِنَ الْمِلَّةِ ، فَيُدْخِلُوا عَلَيْكُمُ الشُّبُهَاتِ  .","","Al-Mu'jam al-Awsat 7631","","أبو أمامة الباهلي عن أبو عثمان النهدي عن سليمان بن طرخان عن عبد الرحمن عن سلم بن سالم البلخي عن أحمد بن إبراهيم النرمقي عن محمد بن المرزبان عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7638","7632  -  وَبِهِ  : قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَلَقَ اللهُ الْخَلْقَ ، وَقَضَى الْقَضِيَّةَ ، وَأَخَذَ مِيثَاقَ النَّبِيِّينَ وَعَرْشُهُ عَلَى الْمَاءِ  ، فَأَخَذَ أَهْلَ الْإِيمَانِ بِيَمِينِهِ ، وَأَخَذَ أَهْلَ الشَّقَاءِ بِيَدِهِ الْيُسْرَى ، وَكِلْتَا يَدَيِ الرَّحْمَنِ يَمِينٌ ، فَقَالَ : يَا أَهْلَ الْيَمِينِ ، قَالُوا :  لَبَّيْكَ  وَسَعْدَيْكَ ،  قَالَ : أَلَسْتُ بِرَبِّكُمْ ؟ قَالُوا : بَلَى ، ثُمَّ خَلَطَ بَيْنَهُمْ ، فَقَالَ قَائِلٌ مِنْهُمْ : رَبَّنَا ، لِمَ خَلَطْتَ بَيْنَنَا ؟ فَقَالَ :         {      وَلَهُمْ أَعْمَالٌ مِنْ دُونِ ذَلِكَ هُمْ لَهَا عَامِلُونَ         }             {      أَنْ تَقُولُوا يَوْمَ الْقِيَامَةِ إِنَّا كُنَّا عَنْ هَذَا غَافِلِينَ             *          أَوْ تَقُولُوا إِنَّمَا أَشْرَكَ آبَاؤُنَا مِنْ قَبْلُ وَكُنَّا ذُرِّيَّةً مِنْ بَعْدِهِمْ         }      . فَخَلَقَ اللهُ الْخَلْقَ ، وَقَضَى الْقَضِيَّةَ ، وَأَخَذَ مِيثَاقَ النَّبِيِّينَ وَعَرْشُهُ عَلَى الْمَاءِ ، فَأَهْلُ الْجَنَّةِ أَهْلُهَا ، وَأَهْلُ النَّارِ أَهْلُهَا "" . فَقَالَ  رَجُلٌ  مِنَ  الْقَوْمِ  : فَفِيمَ الْعَمَلُ يَا رَسُولَ اللهِ ؟ فَقَالَ : "" يَعْمَلُ كُلُّ قَوْمٍ         [7/326]      لِمَا خُلِقُوا لَهُ ، أَهْلُ الْجَنَّةِ بِعَمَلِ أَهْلِ الْجَنَّةِ ، وَأَهْلُ النَّارِ بِعَمَلِ أَهْلِ النَّارِ "" فَقَالَ  عُمَرُ بْنُ الْخَطَّابِ  : يَا رَسُولَ اللهِ ، أَرَأَيْتَ أَعْمَالَنَا هَذِهِ أَشَيْءٌ نَبْتَدِعُهُ أَوْ شَيْءٌ قَدْ فُرِغَ مِنْهُ ؟ قَالَ : "" عَلَى شَيْءٍ قَدْ فُرِغَ مِنْهُ "" قَالَ : فَالْآنَ نَجْتَهِدُ فِي الْعِبَادَةِ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  سُلَيْمَانَ التَّيْمِيِّ  إِلَّا  عَبْدُ الرَّحْمَنِ  -أَظُنُّهُ :  ابْنَ عُمَرَ الْمَكِّيَّ  - ،  تَفَرَّدَ بِهِمَا  :  سَلْمُ بْنُ سَالِمٍ  "" .","","Al-Mu'jam al-Awsat 7632","","أبو أمامة الباهلي عن أبو عثمان النهدي عن سليمان بن طرخان عن عبد الرحمن بن مهدي عن سلم بن سالم البلخي عن أحمد بن إبراهيم النرمقي عن محمد بن المرزبان عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7639","7633  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ ،  نَا  مُحَمَّدُ بْنُ مُقَاتِلٍ الرَّازِيُّ ،  نَا  حَكَّامُ بْنُ سَلْمٍ ،  عَنْ  طُعْمَةَ بْنِ عَمْرٍو ،  عَنْ  أَبَانَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  ارْتَدَّ  نَبْهَانُ  ثَلَاثَ مَرَّاتٍ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّهُمَّ أَمْكِنِّي مِنْ  نَبْهَانَ  فِي عُنُقِهِ حَبْلٌ أَسْوَدُ  ، فَالْتَفَتُّ فَإِذَا هُوَ  بِنَبْهَانَ  قَدْ أُخِذَ ، وَجَعَلُوا فِي عُنُقِهِ حَبْلًا أَسْوَدَ ، فَأَتَوْا بِهِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ السَّيْفَ بِيَمِينِهِ ، وَالْحَبْلَ بِشِمَالِهِ لِيَقْتُلَهُ ، فَقَالَ  رَجُلٌ مِنَ الْأَنْصَارِ  : يَا رَسُولَ اللهِ ، لَوْ أَمَطْتَ عَنْكَ ، قَالَ : فَدَفَعَ السَّيْفَ إِلَى  رَجُلٍ  ، فَقَالَ : "" اذْهَبْ فَاضْرِبْ عُنُقَهَ "" قَالَ : فَانْطَلَقَ بِهِ ، فَضَحِكَ  نَبْهَانُ  ، وَقَالَ : أَيَقْتُلُونَ رَجُلًا يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ؟ فَخَلَّى عَنْهُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  طُعْمَةَ بْنِ عَمْرٍو الْجَعْفَرِيِّ  إِلَّا  حَكَّامٌ  "" .","","Al-Mu'jam al-Awsat 7633","","أنس بن مالك عن أبان بن أبي عياش عن طعمة بن عمرو الجعفري عن حكام بن سلم الكناني عن محمد بن مقاتل الرازي عن محمد بن المرزبان عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7640","7634  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ الْأَدَمِيُّ ،  نَا  سَهْلُ بْنُ زَنْجَلَةَ ،  ثَنَا  مَعْنُ بْنُ عِيسَى الْقَزَّازُ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصَلِّي مِنَ اللَّيْلِ رَكْعَتَيْنِ  ، ثُمَّ رَكْعَتَيْنِ ، ثُمَّ رَكْعَتَيْنِ ، ثُمَّ رَكْعَتَيْنِ ، ثُمَّ ثَلَاثًا  .         [7/327]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَالِكٍ  إِلَّا  مَعْنُ بْنُ عِيسَى  "" .","","Al-Mu'jam al-Awsat 7634","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن سعيد المقبري عن مالك بن أنس عن معن بن عيسى عن سهل بن أبي سهل الأشتر عن محمد بن المرزبان الأدمي عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7641","7635  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ الْأَدَمِيُّ ،  ثَنَا  حَمْزَةُ بْنُ فَرُّوخَ الرَّازِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ عَبْدِ الرَّحْمَنِ أَبُو يَحْيَى الْحِمَّانِيُّ ،  نَا  أَبُو كِيرَانَ الْحَسَنُ بْنُ عُقْبَةَ الْمُرَادِيُّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  صَفْوَانَ بْنِ عَسَّالٍ الْمُرَادِيِّ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَخَّصَ فِي الْمَسْحِ عَلَى الْخُفَّيْنِ  ، ثَلَاثَةَ أَيَّامٍ وَلَيَالِيَهُنَّ لِلْمُسَافِرِ ، وَلِلْمُقِيمِ يَوْمًا وَلَيْلَةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمْرِو بْنِ مُرَّةَ  إِلَّا  أَبُو كِيرَانَ  ،  تَفَرَّدَ بِهِ  :  أَبُو يَحْيَى الْحِمَّانِيُّ  "" .","","Al-Mu'jam al-Awsat 7635","","صفوان بن عسال المرادي عن عمرو بن مرة المرادي عن الحسن بن عقبة المرادي عن عبد الحميد بن عبد الرحمن بشمين عن حمزة بن فروخ الرازي عن محمد بن المرزبان الأدمي عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7642","7636  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ ،  نَا  الْحَسَنُ بْنُ جَبَلَةَ الشِّيرَازِيُّ ،  نَا  سَعْدُ بْنُ الصَّلْتِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  وَبَرَةَ بْنِ عَبْدِ الرَّحْمَنِ الْمُسْلِي ،  عَنْ  خَرَشَةَ بْنِ الْحُرِّ قَالَ :  رَأَيْتُ  عُمَرَ بْنَ الْخَطَّابِ ، يَضْرِبُ أَكُفَّ الرِّجَالِ فِي صَوْمِ رَجَبٍ  ، حَتَّى يَضَعُونَهَا فِي الطَّعَامِ ، وَيَقُولُ : "" رَجَبٌ وَمَا رَجَبٌ ؟ إِنَّمَا رَجَبٌ شَهْرٌ كَانَ يُعَظِّمُهُ أَهْلُ الْجَاهِلِيَّةِ ، فَلَمَّا جَاءَ الْإِسْلَامُ تُرِكَ ""  .","","Al-Mu'jam al-Awsat 7636","","عمر بن الخطاب عن خرشة بن الحر الفزاري عن وبرة بن عبد الرحمن المسلي عن الأعمش عن سعد بن الصلت بن برد البجلي عن الحسن بن جبلة الشيرازي عن محمد بن المرزبان عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7643","7637  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمَرْزُبَانِ الْأَدَمِيُّ ،  نَا  الْحَسَنُ بْنُ جَبَلَةَ ،  نَا  سَعْدُ بْنُ الصَّلْتِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شِمْرِ بْنِ عَطِيَّةَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  أُمِّ الدَّرْدَاءِ ، قَالَتْ :  أَتَانِي  سَلْمَانُ الْفَارِسِيُّ  يُسَلِّمُ عَلَيَّ ، وَعَلَيْهِ عَبَاءَةٌ  قَطْوَانِيَّةٌ  مُرْتَدِيًا بِهَا ، فَطَرَحْتُ لَهُ وِسَادَةً ، فَلَمْ يَرُدَّهَا وَلَفَّ عَبَاءَةً ، فَجَلَسَ عَلَيْهَا ، فَقَالَ :  بِحَسْبِكَ  مَا بَلَغَكَ مِنَ الْمَحَلِّ ، ثُمَّ حَمِدَ اللهَ سَاعَةً ، وَكَبَّرَ وَصَلَّى عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ : أَيْنَ صَاحِبُكَ ؟ -  يَعْنِي :  أَبَا الدَّرْدَاءِ  - فَقُلْتُ : هُوَ فِي الْمَسْجِدِ ، فَانْطَلَقَ إِلَيْهِ ، ثُمَّ أَقْبَلَا جَمِيعًا ، وَقَدِ اشْتَرَى  أَبُو الدَّرْدَاءِ  لَحْمًا بِدِرْهَمٍ فَهُوَ         [7/328]      فِي يَدِهِ مُعَلِّقُهُ ، فَقَالَ : يَا  أُمَّ الدَّرْدَاءِ  ، اخْبِزِي وَاطْبُخِي ، فَفَعَلْنَا .  ثُمَّ أَتَيْنَا  سَلْمَانَ  بِالطَّعَامِ ، فَقَالَ  أَبُو الدَّرْدَاءِ  : كُلْ مَعَ  أُمِّ الدَّرْدَاءِ  ، فَإِنِّي صَائِمٌ ، فَقَالَ  سَلْمَانُ  : لَا آكُلُ حَتَّى تَأْكُلَ ، فَأَفْطَرَ  أَبُو الدَّرْدَاءِ  وَأَكَلَ مَعَهُ ، فَلَمَّا كَانَتِ السَّاعَةُ الَّتِي يَقُومُ فِيهَا  أَبُو الدَّرْدَاءِ  ذَهَبَ لِيَقُومَ أَجْلَسَهُ  سَلْمَانُ  ، فَقَالَ  أَبُو الدَّرْدَاءِ  : أَتَنْهَانِي عَنْ عِبَادَةِ رَبِّي ؟ فَقَالَ  سَلْمَانُ  : إِنَّ لِعَيْنِكَ عَلَيْكَ حَقًّا ، وَإِنَّ لَأَهْلِكَ عَلَيْكَ نَصِيبًا ، فَمَنَعَهُ حَتَّى إِذَا كَانَ فِي وَجْهِ الصُّبْحِ قَامَا فَرَكَعَا رَكَعَاتٍ وَأَوْتَرَا ، ثُمَّ خَرَجَا إِلَى صَلَاةِ الصُّبْحِ ، فَذَكَرَا أَمْرَهُمَا لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  مَا  لِسَلْمَانَ  ثَكِلَتْهُ  أُمُّهُ ؟ لَقَدْ أُشْبِعَ مِنَ الْعِلْمِ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنِ  الْأَعْمَشِ  إِلَّا  سَعْدُ بْنُ الصَّلْتِ  ،  تَفَرَّدَ بِهِمَا  :  الْحَسَنُ بْنُ جَبَلَةَ  "" .","","Al-Mu'jam al-Awsat 7637","","هجيمة الأوصابية أم الدرداء الصغرى عن شهر بن حوشب عن شمر بن عطية الكاهلي عن الأعمش عن سعد بن الصلت بن برد البجلي عن الحسن بن جبلة عن محمد بن المرزبان الأدمي عن الطبراني","محمد بن المرزبان الأدمي الشيرازي"
"7644","7638  -  حَدَّثَنَا  مُحَمَّدُ بْنُ سَعْدَانَ الْعَتَايِدِيُّ الشِّيرَازِيُّ ،  حَدَّثَنِي  زَيْدُ بْنُ أَخْزَمَ ،  نَا  سَعِيدُ بْنُ عَامِرٍ ،  عَنْ  أَشْعَثَ ،  عَنْ  عَوْفٍ ،  عَنْ  يَزِيدَ الْفَارِسِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قُلْتُ  لِعُثْمَانَ  : يَا أَمِيرَ الْمُؤْمِنِينَ ، مَا حَمَلَكُمْ عَلَى أَنْ جَعَلْتُمْ بَرَاءَةً مِنَ الْمِئِينَ وَالْأَنْفَالَ مِنَ الْمَثَانِي ، فَقَرَنْتُمُوهُمَا وَجَعَلْتُمُوهُمَا فِي  السَّبْعِ  الطِّوَالِ ، وَلَمْ تَكْتُبُوا بَيْنَهُمَا : بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ؟  فَقَالَ  عُثْمَانُ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ مِمَّا يَنْزِلُ عَلَيْهِ مِنَ السُّوَرِ ذَوَاتُ الْعَدَدِ ، فَكَانَ إِذَا أُنْزِلَتْ عَلَيْهِ الْآيَةُ قَالَ لِبَعْضِ مَنْ يَكْتُبُ :  اجْعَلُوا هَذِهِ الْآيَةَ فِي سُورَةِ كَذَا وَكَذَا  ، وَإِنَّ الْأَنْفَالَ مِنْ أَوَّلِ مَا أُنْزِلَ  بِالْمَدِينَةِ  ، وَكَانَتْ بَرَاءَةٌ آخِرَ الْقُرْآنِ ، فَمَاتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلَمْ يُبَيِّنْ لَنَا  ،  وَرَأَيْتُ قِصَّتَهَا تُشْبِهُ قِصَّتَهَا ، فَلِذَلِكَ ضَمَمْتُهَمَا مَعًا  ، وَلَمْ أَكْتُبْ بَيْنَهُمَا : بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ  ""  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَشْعَثِ  ، عَنْ  عَوْفٍ  إِلَّا  سَعِيدُ بْنُ عَامِرٍ  ،  تَفَرَّدَ بِهِ  :  زَيْدُ بْنُ أَخْزَمَ  "" .","","Al-Mu'jam al-Awsat 7638","","عثمان بن عفان عن عبد الله بن عباس عن يزيد الفارسي كاتب عبيد الله بن زياد عن عوف بن أبي جميلة عن أشعث بن عبد الله السجستاني عن سعيد بن عامر الضبعي عن زيد بن أخزم الطائي عن محمد بن سعدان العتايدي الشيرازي عن الطبراني","محمد بن سعدان العتايدي الشيرازي"
"7645","[7/329]      7639  -  حَدَّثَنَا  مُحَمَّدُ بْنُ سَعْدَانَ ،  ثَنَا  زَيْدُ بْنُ أَخْزَمَ ،  ثَنَا  أَبُو أَحْمَدَ الزُّبَيْرِيُّ ،  ثَنَا  حَنْظَلَةُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُكْبُرَةَ قَالَ :  التَّخَلُّلُ  سُنَّةٌ  "" .         [7/330]      "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ اللهِ بْنِ عُكْبُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  أَبُو أَحْمَدَ الزُّبَيْرِيُّ  "" .","","Al-Mu'jam al-Awsat 7639","","عبد الله بن عكبرة عن مجاهد بن جبر المخزومي عن عبد الكريم بن أبي المخارق عن حنظلة بن أبي المغيرة القاص عن محمد بن عبد الله بن الزبير عن زيد بن أخزم الطائي عن محمد بن سعدان عن الطبراني","محمد بن سعدان العتايدي الشيرازي"
"7646","7640  -  حَدَّثَنَا  مُحَمَّدُ بْنُ سَعْدَانَ ،  ثَنَا  زَيْدُ بْنُ أَخْزَمَ ،  نَا  صَفْوَانُ بْنُ عِيسَى ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدِ بْنِ أَبِي هِنْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  دَخَلْنَا يَوْمَ الْجُمُعَةِ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَبَيْنَ يَدَيْهِ طَعَامٌ ، فَقَالَ : "" ادْنُوا كُلُوا "" ، قُلْنَا : إِنَّا صِيَامٌ ، قَالَ : "" هَلْ صُمْتُمْ أَمْسِ ؟ "" قُلْنَا : لَا ، قَالَ : "" فَتُرِيدُونَ أَنْ تَصُومُوا غَدًا ؟ "" قُلْنَا : لَا ، قَالَ :  فَكُلُوا ، فَإِنَّ يَوْمَ الْجُمُعَةِ لَا يُصَامُ وَحْدَهُ ، يُتَّخَذُ عِيدًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ أَبِي قَتَادَةَ  إِلَّا  سَعِيدُ بْنُ أَبِي هِنْدٍ  ، وَلَا عَنْ  سَعِيدٍ  إِلَّا ابْنُهُ  عَبْدُ اللهِ  ،  تَفَرَّدَ بِهِ  :  صَفْوَانُ بْنُ عِيسَى  "" .","","Al-Mu'jam al-Awsat 7640","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن أبي قتادة السلمي عن سعيد بن أبي هند الفزاري عن عبد الله بن سعيد بن أبي هند الفزاري عن صفوان بن عيسى عباية عن زيد بن أخزم الطائي عن محمد بن سعدان عن الطبراني","محمد بن سعدان العتايدي الشيرازي"
"7647","7641  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  بِشْرُ بْنُ عَلِيٍّ الْكَرْمَانِيُّ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  عَنْ  أَبَانَ بْنِ تَغْلِبٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ قَالَ :  لَيْسَ  الْوِتْرُ  بِحَتْمٍ  ، وَلَكِنَّهَا سُنَّةٌ سَنَّهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Awsat 7641","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن أبان بن تغلب بن رياح عن حسان بن إبراهيم الكرماني عن بشر بن علي الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7648","7642  -  وَبِهِ  :  عَنْ  أَبَانَ بْنِ تَغْلِبٍ ،  عَنِ  الْحَكَمِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  عَبْدِ اللهِ بْنِ عُكَيْمٍ قَالَ :  أَتَانَا كِتَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ  بِأَرْضِ جُهَيْنَةَ  ، أَنْ  لَا تَنْتَفِعُوا مِنَ الْمَيْتَةِ بِإِهَابٍ وَلَا عَصَبٍ  .","","Al-Mu'jam al-Awsat 7642","","عبد الله بن عكيم الجهني عن عبد الرحمن بن أبي ليلى عن الحكم بن عتيبة الكندي عن أبان بن تغلب بن رياح عن حسان بن إبراهيم الكرماني عن بشر بن علي الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7649","7643  -  وَبِهِ  :  حَدَّثَنَا  أَبَانُ بْنُ تَغْلِبٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي رَزِينٍ ،         [7/331]      عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا انْقَطَعَ  شِسْعُ  نَعْلِ أَحَدِكُمْ فَلَا يَمْشِ فِي نَعْلٍ وَاحِدَةٍ  .","","Al-Mu'jam al-Awsat 7643","","أبو هريرة الدوسي عن مسعود بن مالك الأسدي عن الأعمش عن أبان بن تغلب بن رياح عن حسان بن إبراهيم الكرماني عن بشر بن علي الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7650","7644  -  وَبِهِ  :  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي رَزِينٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  طُهُورُ إِنَاءِ أَحَدِكُمْ إِذَا  وَلَغَ  فِيهِ الْكَلْبُ أَنْ يَغْسِلَهُ سَبْعَ مَرَّاتٍ  .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنْ  أَبَانَ بْنِ تَغْلِبٍ  إِلَّا  حَسَّانُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7644","","أبو هريرة الدوسي عن مسعود بن مالك الأسدي عن الأعمش عن أبان بن تغلب بن رياح عن حسان بن إبراهيم الكرماني عن بشر بن علي الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7651","7645  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  إِبْرَاهِيمُ بْنُ عَبَّادٍ الْكَرْمَانِيُّ ،  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  نَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنِ  الرَّبِيعِ بْنِ أَنَسٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَرَأَى فِي الْمَسْجِدِ  رَجُلًا  لَا يُتِمُّ رُكُوعَهُ وَلَا سُجُودَهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُقْبَلُ صَلَاةُ رَجُلٍ لَا يُتِمُّ الرُّكُوعَ وَالسُّجُودَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الرَّبِيعِ بْنِ أَنَسٍ  إِلَّا  أَبُو جَعْفَرٍ الرَّازِيُّ  ، وَلَا عَنْ  أَبِي جَعْفَرٍ  إِلَّا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  "" .","","Al-Mu'jam al-Awsat 7645","","أنس بن مالك عن الربيع بن أنس البكري عن عيسى بن أبي عيسى الرازي عن يحيى بن أبي بكير عن إبراهيم بن عباد الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7652","7646  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  يَحْيَى بْنُ الْعَبَّاسِ الْإِصْطَخْرِيُّ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ الْإِصْطَخْرِيُّ ،  نَا  زَافِرُ بْنُ سُلَيْمَانَ ،  عَنْ  بَكْرِ بْنِ خُنَيْسٍ ،  عَنْ  ضِرَارِ بْنِ عَمْرٍو ،  عَنْ  أَبِي رَافِعٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِذَا خَرَجَ الْغَازِي فِي  سَبِيلِ  اللهِ جُعِلَتْ ذُنُوبُهُ جِسْرًا عَلَى بَابِ بَيْتِهِ  ، فَإِذَا خَلَفَهُ خَلَّفَ ذُنُوبَهُ كُلَّهَا ، فَلَمْ يَبْقَ عَلَيْهِ مِنْهَا مِثْلُ جَنَاحِ بَعُوضَةٍ ، وَتَكَفَّلَ اللهُ لَهُ بِأَرْبَعٍ ، بِأَنْ يَخْلُفَهُ فِيمَا تَخَلَّفَ مِنْ أَهْلٍ وَمَالٍ ، وَأَيُّ مِيتَةٍ مَاتَ بِهَا أَدْخَلَهُ الْجَنَّةَ ، وَإِنْ رَدَّهُ رَدَّهُ سَالِمًا بِمَا أَصَابَ مِنْ غَنِيمَةٍ أَوْ أَجْرٍ ، وَأَنْ لَا تَغْرُبَ شَمْسٌ إِلَّا غَرَبَتْ بِذُنُوبِهِ  .","","Al-Mu'jam al-Awsat 7646","","أبو هريرة الدوسي عن نفيع بن رافع الصائغ عن ضرار بن عمرو الملطي عن بكر بن خنيس الكوفي عن زافر بن سليمان القهستاني عن عصمة بن المتوكل الحنفي عن يحيى بن العباس الإصطخري عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7653","[7/332]      7647  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  نَا  مُحَمَّدُ بْنُ سَهْلِ بْنِ مَخْلَدٍ الْإِصْطَخْرِيُّ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  زَافِرُ بْنُ سُلَيْمَانَ ،  عَنْ  إِسْرَائِيلَ بْنِ يُونُسَ ،  عَنْ  جَابِرٍ ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ تَزَوَّجَ فَقَدِ اسْتَكْمَلَ نِصْفَ الْإِيمَانِ  ، فَلْيَتَّقِ اللهَ فِي النِّصْفِ الْبَاقِي  .","","Al-Mu'jam al-Awsat 7647","","أنس بن مالك عن يزيد بن أبان الرقاشي عن جابر الجعفي عن إسرائيل بن يونس بن أبي إسحاق عن زافر بن سليمان القهستاني عن عصمة بن المتوكل الحنفي عن محمد بن سهل بن مخلد الإصطخري عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7654","7648  -  وَبِهِ  :  حَدَّثَنَا  زَافِرٌ ،  عَنْ  ثَابِتِ بْنِ الْبُنَانِيِّ  ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّ  رَجُلًا  خَرَجَ ، وَأَمَرَ امْرَأَتَهُ أَنْ لَا تَخْرُجَ مِنْ بَيْتِهَا ، وَكَانَ أَبُوهَا فِي أَسْفَلِ الدَّارِ ، وَكَانَتْ فِي أَعْلَاهَا ، فَمَرِضَ أَبُوهَا ، فَأَرْسَلَتْ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَتْ لَهُ ذَلِكَ فَقَالَ :  أَطِيعِي زَوْجَكِ  فَمَاتَ أَبُوهَا ، فَأَرْسَلَتْ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : "" أَطِيعِي زَوْجَكِ "" ، فَأَرْسَلَ إِلَيْهَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّ اللهَ غَفَرَ لِأَبِيهَا بِطَاعَتِهَا لِزَوْجِهَا  .  كذا في طبعة دار الحرمين ، والصواب :( ثابت البناني).","","Al-Mu'jam al-Awsat 7648","","أنس بن مالك عن ثابت البناني عن زافر بن سليمان القهستاني عن عصمة بن المتوكل الحنفي عن محمد بن سهل بن مخلد الإصطخري عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7655","7649  -  وَبِهِ  :  حَدَّثَنَا  زَافِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنْ  سُهَيْلٍ - يَعْنِي : ابْنَ أَبِي حَزْمٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَقَدْ أَصْبَحَ  آلُ مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، تِسْعَةَ أَهْلِ أَبْيَاتٍ - مَا فِيهِمْ صَاعٌ مِنْ طَعَامٍ  .","","Al-Mu'jam al-Awsat 7649","","أنس بن مالك عن قتادة بن دعامة عن سهيل بن أبي حزم القطعي عن أبو رجاء عن زافر بن سليمان القهستاني عن عصمة بن المتوكل الحنفي عن محمد بن سهل بن مخلد الإصطخري عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7656","7650  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  إِسْمَاعِيلُ بْنُ يَحْيَى الْإِصْطَخْرِيُّ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  زَافِرُ بْنُ سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  - لَا أَعْلَمُهُ إِلَّا  رَفَعَهُ  - قَالَ :  صَلَاحُ أَوَّلِ هَذِهِ الْأُمَّةِ بِالزَّهَادَةِ وَالْيَقِينِ ، وَهَلَاكُهَا بِالْبُخْلِ وَالْأَمَلِ  .  لَمْ يَرْوِ هَذَهِ الْأَحَادِيثَ عَنْ  زَافِرِ بْنِ سُلَيْمَانَ  إِلَّا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  "" .","","Al-Mu'jam al-Awsat 7650","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن إبراهيم بن ميسرة الطائفي عن محمد بن مسلم بن سوسن الطائفي عن زافر بن سليمان القهستاني عن عصمة بن المتوكل الحنفي عن إسماعيل بن يحيى بن بحر الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7657","[7/333]      7651  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  يَحْيَى بْنُ الْعَبَّاسِ الْإِصْطَخْرِيُّ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  زَافِرُ بْنُ سُلَيْمَانَ ،  عَنْ  دَاوُدَ الطَّائِيِّ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ :  مَا ضَرَبَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ امْرَأَةً قَطُّ ، وَلَا خَادِمًا لَهُ  ، وَلَا ضَرَبَ بِيَدِهِ شَيْئًا قَطُّ إِلَّا أَنْ يُجَاهِدَ فِي  سَبِيلِ  اللهِ ، وَلَا نِيلَ مِنْهُ شَيْءٌ فَيَنْتَقِمُ مِنْ صَاحِبِهِ ، إِلَّا أَنْ  تُنْتَهَكَ  مَحَارِمُ اللهِ ، فَيَنْتَقِمُ لِلهِ ، وَلَا خُيِّرَ بَيْنَ أَمْرَيْنِ إِلَّا اخْتَارَ أَيْسَرَهُمَا ، حَتَّى يَكُونَ إِثْمًا ، فَإِذَا كَانَ إِثْمًا كَانَ أَبْعَدَ النَّاسِ مِنْهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  دَاوُدَ الطَّائِيِّ  إِلَّا  زَافِرُ بْنُ سُلَيْمَانَ  ،  تَفَرَّدَ بِهِ  :  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  ""  .","","Al-Mu'jam al-Awsat 7651","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن داود بن نصير الطائي عن زافر بن سليمان القهستاني عن عصمة بن المتوكل الحنفي عن يحيى بن العباس الإصطخري عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7658","7652  -  وَبِهِ  :  حَدَّثَنَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْعَجْمَاءُ  جُبَارٌ  ،  وَالْبِئْرُ  جُبَارٌ  ، وَالْمَعْدِنُ  جُبَارٌ  ، وَفِي  الرِّكَازِ  الْخُمُسُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي جَعْفَرٍ الرَّازِيِّ  إِلَّا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  "" .","","Al-Mu'jam al-Awsat 7652","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن عيسى بن أبي عيسى الرازي عن عصمة بن المتوكل الحنفي عن يحيى بن العباس الإصطخري عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7659","7653  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَهْلِ بْنِ مَخْلَدٍ ،  ثَنَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  عَدِيُّ بْنُ الْفَضْلِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنْ  أُمِّ سَلَمَةَ ، "" أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يُصْبِحُ  جُنُبًا  مِنْ وِقِاعٍ غَيْرِ الْحُلُمِ ، فَيَصُومُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ  إِلَّا  عَدِيُّ بْنُ الْفَضْلِ  ،  تَفَرَّدَ بِهِ  :  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  "" .","","Al-Mu'jam al-Awsat 7653","","هند بنت أبي أمية زوج رسول الله عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عدي بن الفضل التيمي عن عصمة بن المتوكل الحنفي عن محمد بن سهل بن مخلد عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7660","7654  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  إِسْمَاعِيلُ بْنُ يَحْيَى الْإِصْطَخْرِيُّ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  ثَنَا  سَوَّارُ بْنُ مُصْعَبٍ الضَّرِيرُ الْكُوفِيُّ ،  عَنْ         [7/334]      عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  صَفْوَانَ بْنِ عَسَّالٍ الْمُرَادِيِّ قَالَ :  كُنَّا نُسَافِرُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَا نَنْزِعُ خِفَافَنَا إِذَا لَبِسْنَاهَا عَلَى وُضُوءٍ  ثَلَاثَةَ أَيَّامٍ ، إِلَّا مِنْ جَنَابَةٍ ، وَلَكِنْ مِنْ غَائِطٍ ، أَوْ بَوْلٍ ، أَوْ نَوْمٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَوَّارِ بْنِ مُصْعَبٍ  إِلَّا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  "" .","","Al-Mu'jam al-Awsat 7654","","صفوان بن عسال المرادي عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن سوار بن مصعب المؤذن عن عصمة بن المتوكل الحنفي عن إسماعيل بن يحيى بن بحر الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7661","7655  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  نَا  مُحَمَّدُ بْنُ سَهْلٍ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  أَبُو يُوسُفَ الْقَاضِي ،  عَنْ  عَبْدِ اللهِ بْنِ عَلِيٍّ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ ، لَوْلَا أَنْ أَشُقَّ عَلَى الْمُؤْمِنِينَ مَا قَعَدْتُ خَلْفَ سَرِيَّةٍ  فِي  سَبِيلِ  اللهِ أَبَدًا ، وَلَكِنْ لَا أَجِدُ مَا أَحْمِلُهُمْ عَلَيْهِ ، وَلَا يَجِدُونَ سَعَةً فَيَتْبَعُونِي ، وَلَا يَطِيبُ أَنْفُسُهُمْ أَنْ يَقْعُدُوا بَعْدِي  .","","Al-Mu'jam al-Awsat 7655","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن عبد الله بن علي الأزرق عن أبو يوسف يعقوب بن إبراهيم القاضي عن عصمة بن المتوكل الحنفي عن محمد بن سهل عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7662","7656  -  وَبِهِ  :  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَوَدِدْتُ أَنِّي أُقَاتِلُ فِي  سَبِيلِ  اللهِ حَتَّى أُقْتَلَ ، ثُمَّ أُحْيَا  ، ثُمَّ أُقْتَلَ ، ثُمَّ أُحْيَا ، ثُمَّ أُقْتَلَ ، ثُمَّ أُحْيَا ، ثُمَّ أُقْتَلَ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عَبْدِ اللهِ بْنِ عَلِيٍّ - وَهُوَ : أَبُو أَيُّوبَ الْأَفْرِيقِيُّ  - إِلَّا  أَبُو يُوسُفَ الْقَاضِي  "" .","","Al-Mu'jam al-Awsat 7656","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن عبد الله بن علي الأزرق عن أبو يوسف يعقوب بن إبراهيم القاضي عن عصمة بن المتوكل الحنفي عن محمد بن سهل عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7663","7657  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  نَا  مُحَمَّدُ بْنُ سَهْلٍ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  عَبْدُ الْأَعْلَى بْنُ أَبِي الْمُسَاوِرِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ ،  عَنْ  عَلِيٍّ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَمْسَى قَالَ :  أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلهِ الْوَاحِدِ الْقَهَّارِ  ، الْحَمْدُ لِلهِ الَّذِي ذَهَبَ بِالنَّهَارِ وَجَاءَ بِاللَّيْلِ وَنَحْنُ مِنْهُ فِي         [7/335]      عَافِيَةٍ ، اللَّهُمَّ هَذَا خَلْقٌ لَكَ جَدِيدٌ قَدْ جَاءَ ، فَمَا عَمِلْتُ فِيهِ مِنْ سَيِّئَةٍ فَتَجَاوَزْ عَنْهَا ، وَمَا عَمِلْتُ فِيهِ مِنْ حَسَنَةٍ فَتُقَبَّلْهَا وَأَضْعِفْهَا أَضْعَافًا مُضَاعَفَةً ، اللَّهُمَّ إِنَّكَ بِجَمِيعِ حَاجَتِي عَالِمٌ ، وَإِنَّكَ عَلَى جَمِيعِ نَجْحِهَا قَادِرٌ ، اللَّهُمَّ  أَنْجِحِ  اللَّيْلَةَ كُلَّ حَاجَةٍ لِي ، وَلَا تَزِدْنِي فِي دُنْيَايَ ، وَلَا تَنْقُصْنِي فِي آخِرَتِي "" وَإِذَا أَصْبَحَ قَالَ مِثْلَ ذَلِكَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  عَبْدُ الْأَعْلَى بْنُ أَبِي الْمُسَاوِرِ  ،  تَفَرَّدَ بِهِ  :  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  "" .","","Al-Mu'jam al-Awsat 7657","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن عبد الأعلى بن أبي المساور الجرار عن عصمة بن المتوكل الحنفي عن محمد بن سهل عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7664","7658  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  مُحَمَّدُ بْنُ سَهْلٍ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  أَبِي هَارُونَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اجْتَنِبُوا هَذِهِ الشَّجَرَةَ الْمُنْكَرَةَ  ، مَنْ أَكْلَهَا فَلَا يَقْرَبَنَّ مَسْجِدَنَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُبَارَكِ بْنِ فَضَالَةَ  إِلَّا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  ""  .","","Al-Mu'jam al-Awsat 7658","","أبو سعيد الخدري عن عمارة بن جوين العبدي عن مبارك بن فضالة عن عصمة بن المتوكل الحنفي عن محمد بن سهل عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7665","7659  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  إِسْمَاعِيلُ بْنُ يَحْيَى الْإِصْطَخْرِيُّ ،  ثَنَا  الْكَرْمَانِيُّ بْنُ عَمْرٍو ،  نَا  مُبَارَكُ بْنُ فَضَالَةَ ،  نَا  عَلِيُّ بْنُ زَيْدٍ  ، حَدَّثَنِي  أَبُو نَضْرَةَ  ، عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  تَقْتَتِلُ  فِئَتَانِ  عَظِيمَتَانِ ، دَعْوَاهُمَا وَاحِدَةٌ  ، فَبَيْنَمَا هُمْ كَذَلِكَ إِذْ مَرَقَتْ مِنْهُمْ  مَارِقَةٌ  ، تَقْتُلُهَا أَوْلَى الطَّائِفَتَيْنِ بِالْحَقِّ  .","","Al-Mu'jam al-Awsat 7659","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن علي بن زيد بن جدعان عن مبارك بن فضالة عن الكرماني بن عمرو الأزدي عن إسماعيل بن يحيى بن بحر الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7666","7660  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  نَا  مُحَمَّدُ بْنُ سَهْلٍ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  أَبِي غَالِبٍ قَالَ :  كُنْتُ  بِالشَّامِ  وَبِهَا أَبُو أُمَامَةَ صُدَيُّ بْنُ عَجْلَانَ ، صَاحِبُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَكَانَ لِي صَدِيقًا ، فَجِيءَ بِرُءُوسٍ مِنْ رُءُوسِ الْحَرُورِيَّةِ ، فَأُلْقِيَتْ بِالدَّرْجِ ، فَجَاءَ  أَبُو أُمَامَةَ  ، فَدَخَلَ الْمَسْجِدَ ، فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ تَوَجَّهَ نَحْوَ الرُّءُوسِ ، فَقُلْتُ : لَأَتْبَعَنَّهُ حَتَّى أَسْمَعَ مَا يَقُولُ ، فَتَبِعْتُهُ حَتَّى وَقَفَ عَلَيْهَا فَبَكَى ،         [7/336]      ثُمَّ  قَالَ  : "" سُبْحَانَ اللهِ ، مَا يَصْنَعُ إِبْلِيسُ بِهَذِهِ الْأُمَّةِ ؟ "" ثُمَّ قَالَ :  كِلَابُ النَّارِ ، كِلَابُ النَّارِ ، كِلَابُ النَّارِ  ، ثُمَّ قَالَ : "" شَرُّ قَتْلَى قُتِلُوا تَحْتَ ظِلِّ السَّمَاءِ ، وَخَيْرُ قَتْلَى قَتَلُوهُمْ "" ، ثُمَّ تَلَا هَذِهِ الْآيَةَ :         {      يَوْمَ تَبْيَضُّ وُجُوهٌ وَتَسْوَدُّ وُجُوهٌ فَأَمَّا الَّذِينَ اسْوَدَّتْ وُجُوهُهُمْ أَكَفَرْتُمْ بَعْدَ إِيمَانِكُمْ         }      ثُمَّ الْتَفَتَ إِلَيَّ فَرَآنِي - فَقَالَ  أَبُو غَالِبٍ  : وَأَخَذَ بِسَاعِدِي - فَقَالَ : "" أَنْتَ بِبِلَادٍ هَؤُلَاءِ بِهِ كَثِيرٌ ؟ "" -  يَعْنِي :  الْعِرَاقَ  - قُلْتُ : أَجَلْ ، قَالَ : "" أَعَاذَكَ اللهُ أَنْ تَكُونَ مِنْهُمْ  "" ، قُلْتُ : يَا  أَبَا أُمَامَةَ  ، أَرَأَيْتَ قَوْلَكَ : كِلَابُ النَّارِ ، قُلْتَهُ بِرَأْيِكَ أَوْ شَيْئًا سَمِعْتَهُ ؟ قَالَ : "" سُبْحَانَ اللهِ ، إِنِّي إِذًا لَجَرِيءٌ ، لَا بَلْ سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَا مَرَّةً ، وَلَا مَرَّتَيْنِ ، وَلَا ثَلَاثًا ، وَلَا أَرْبَعًا ، وَلَا خَمْسًا ، وَلَا سِتًّا ، وَلَا سَبْعًا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُبَارَكٍ  إِلَّا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  "" .","","Al-Mu'jam al-Awsat 7660","","أبو أمامة الباهلي عن أبو غالب البصري صاحب أبي أمامة عن مبارك بن فضالة عن عصمة بن المتوكل الحنفي عن محمد بن سهل عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7667","7661  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  ثَنَا  أَبُو أُسَامَةَ عَبْدُ اللهِ بْنُ أُسَامَةَ الْكَلْبِيُّ ،  نَا  عُبَيْدُ بْنُ إِسْحَاقَ الْعَطَّارُ ،  ثَنَا  عَمَّارُ بْنُ سَيْفٍ  ، عَنِ  الْأَعْمَشِ  ، عَنْ  أَبِي سُفْيَانَ  ، عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَوْحَى اللهُ إِلَى مَلَكٍ مِنَ الْمَلَائِكَةِ أَنِ اقْلِبْ مَدِينَةَ كَذَا وَكَذَا عَلَى أَهْلِهَا  قَالَ : إِنَّ فِيهِ عَبْدَكَ فُلَانًا لَمْ يَعْصِكَ طَرْفَةَ عَيْنٍ ، قَالَ : اقْلِبْهَا عَلَيْهِ وَعَلَيْهِمْ ، فَإِنَّ وَجْهَهُ لَمْ يَتَمَعَّرَ لِي سَاعَةً قَطُّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا  عَمَّارُ بْنُ سَيْفٍ  ،  تَفَرَّدَ بِهِ  :  عُبَيْدُ بْنُ إِسْحَاقَ الْعَطَّارُ  "" .","","Al-Mu'jam al-Awsat 7661","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن عمار بن سيف الضبي عن عبيد بن إسحاق عطار المطلقات عن عبد الله بن أسامة الكلبى عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7668","7662  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  أَبُو أُسَامَةَ عَبْدُ اللهِ بْنُ أُسَامَةَ الْكَلْبِيُّ ،  نَا  عَلِيُّ بْنُ ثَابِتٍ الدَّهَّانُ ،  ثَنَا  يَعْقُوبُ الْقُمِّيُّ ،  عَنْ  جَعْفَرِ بْنِ أَبِي الْمُغِيرَةِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،         [7/337]      عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ أَرْبَعِينَ مِنْ أَصْحَابِ  النَّجَاشِيِّ  قَدِمُوا عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَشَهِدُوا مَعَهُ  أُحُدًا  ، وَكَانَتْ فِيهِمْ جِرَاحَاتٌ ، وَلَمْ يُقْتَلْ مِنْهُمْ أَحَدٌ ، فَلَمَّا رَأَوْا مَا بِالْمُؤْمِنِينَ مِنَ الْحَاجَةِ قَالُوا : يَا رَسُولَ اللهِ ، إِنَّا أَهْلُ مَيْسَرَةٍ ، فَائْذَنْ لَنَا نَجِيءُ بِأَمْوَالِنَا نُواسِي بِهَا الْمُسْلِمِينَ ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ فِيهِمُ :         {      الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ مِنْ قَبْلِهِ هُمْ بِهِ يُؤْمِنُونَ         }      الْآيَةَ         {      أُولَئِكَ يُؤْتَوْنَ أَجْرَهُمْ مَرَّتَيْنِ بِمَا صَبَرُوا         }      ، فَجَعَلَ لَهُمْ أَجْرَيْنِ "" قَالَ :         {      وَيَدْرَءُونَ بِالْحَسَنَةِ السَّيِّئَةَ         }      قَالَ : "" تِلْكَ النَّفَقَةُ الَّتِي وَاسَوْا بِهَا الْمُسْلِمِينَ حَتَّى نَزَلَتْ هَذِهِ الْآيَةُ "" .  قَالَ : "" فَفَخِرَ أَهْلُ الْكِتَابِ عَلَى الْمُسْلِمِينَ حَتَّى نَزَلَتْ هَذِهِ الْآيَةُ ، فَقَالُوا : يَا مَعْشَرَ الْمُسْلِمِينَ ، أَمَّا مَنْ آمَنَ مِنَّا بِكِتَابِكُمْ فَلَهُ أَجْرَانِ ، وَمَنْ لَمْ يُؤْمِنْ بِكِتَابِكُمْ فَلَهُ أَجْرٌ كَأُجُورِكُمْ ، فَأَنْزَلَ اللهُ         {      يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللهَ وَآمِنُوا بِرَسُولِهِ يُؤْتِكُمْ كِفْلَيْنِ مِنْ رَحْمَتِهِ وَيَجْعَلْ لَكُمْ نُورًا تَمْشُونَ بِهِ         }      فَزَادَهُمُ النُّورَ وَالْمَغْفِرَةَ "" وَقَالَ :         {      لِئَلا يَعْلَمَ أَهْلُ الْكِتَابِ أَلا يَقْدِرُونَ عَلَى شَيْءٍ مِنْ فَضْلِ اللهِ         }      .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَعْفَرِ بْنِ أَبِي الْمُغِيرَةِ  إِلَّا  يَعْقُوبُ الْقُمِّيُّ  ،  تَفَرَّدَ بِهِ  :  عَلِيُّ بْنُ ثَابِتٍ  ""  .","","Al-Mu'jam al-Awsat 7662","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن جعفر بن أبي المغيرة عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن علي بن ثابت الدهان عن عبد الله بن أسامة الكلبى عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7669","7663  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  إِسْمَاعِيلُ بْنُ يَحْيَى بْنِ إِسْمَاعِيلَ الْإِصْطَخْرِيُّ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  أَبُو مُعَاوِيَةَ الضَّرِيرُ  ، عَنِ  الْأَعْمَشِ  ، عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ  ، عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  ، عَنِ  ابْنِ عَبَّاسٍ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ  حُنَيْنٍ  ، عَنْ بَيْعِ الْخُمُسِ حَتَّى يُقْسَمَ  ، وَعَنْ أَنْ تُوطَأَ النِّسَاءُ حَتَّى يَضَعْنَ مَا فِي بُطُونِهِنَّ ، إِذَا كُنَّ حَبَالَى  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  ، عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ  ، عَنْ  سَعِيدٍ  ، عَنِ  ابْنِ عَبَّاسٍ  قَالَ : نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، إِلَّا  أَبُو مُعَاوِيَةَ  ،  تَفَرَّدَ بِهِ  :  عِصْمَةُ  "" .","","Al-Mu'jam al-Awsat 7663","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن القاسم بن عبد الرحمن المسعودي عن الأعمش عن أبو معاوية الضرير عن عصمة بن المتوكل الحنفي عن إسماعيل بن يحيى بن بحر الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7670","[7/338]      7664  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  نَا  إِسْمَاعِيلُ بْنُ يَحْيَى ،  نَا  اللَّيْثُ بْنُ حَمَّادٍ  ، عَنْ  غُورَكِ بْنِ الْحِصْرِمِيِّ أَبِي عَبْدِ اللهِ الْجُعْفِيِّ  ، عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  صَدَقَةُ الْفِطْرِ عَلَى كُلِّ إِنْسَانٍ مُدَّانِ مِنْ دَقِيقٍ أَوْ  قَمْحٍ  ، وَمِنَ الشَّعِيرِ صَاعٌ ، وَمِنَ الْحَلْوَاءِ - زَبِيبٍ أَوْ تَمْرٍ - صَاعٌ صَاعٌ  .","","Al-Mu'jam al-Awsat 7664","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن غورك السعدي عن ليث بن حماد الإصطخري عن إسماعيل بن يحيى بن بحر الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7671","7665  -  وَبِهِ  :  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  فِي الْخَيْلِ  السَّائِمَةِ  فِي كُلِّ فَرَسٍ دِينَارٌ  .         [7/339]      لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ  إِلَّا  غُورَكُ الْجُعْفِيُّ  ،  تَفَرَّدَ بِهِمَا  :  اللَّيْثُ بْنُ حَمَّادٍ الْإِصْطَخْرِيُّ  "" .","","Al-Mu'jam al-Awsat 7665","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن غورك السعدي عن ليث بن حماد الإصطخري عن إسماعيل بن يحيى بن بحر الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7672","7666  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  نَا  إِسْمَاعِيلُ بْنُ يَحْيَى الْأَزْدِيُّ الْإِصْطَخْرِيُّ ،  نَا  الْكَرْمَانِيُّ بْنُ عَمْرٍو  ، حَدَّثَنِي  عَبْدُ الْحَمِيدِ بْنُ أَبِي جَعْفَرٍ الْفَرَّاءُ  ، عَنْ  أَبِي جَعْفَرٍ ، مَوْلَى عَلِيٍّ قَالَ :  شَهِدْتُ مَعَ عَلِيٍّ ،  النَّهَرَ  ، فَلَمَّا فَرَغَ مِنْ قَتْلِهِمْ قَالَ : "" اطْلُبُوا  الْمُخْدَجَ  ، فَطَلَبُوهُ ، فَلَمْ يَجِدُوهُ ، وَأَمَرَ أَنْ يُوضَعَ عَلَى كُلِّ قَتِيلٍ قَصَبَةٌ ، فَوَجَدُوهُ فِي وَهْدَةٍ فِي مُسْتَنْقَعِ مَاءٍ ، رَجُلٌ أَسْوَدُ ، مُنْتِنُ الرِّيحِ ، فِي مَوْضِعِ يَدِهِ كَهَيْئَةِ الثَّدْيِ ، عَلَيْهِ شَعَرَاتٌ ، فَلَمَّا نَظَرَ إِلَيْهِ  قَالَ  : "" صَدَقَ اللهُ وَرَسُولُهُ "" ، فَسَمِعَ أَحَدُ ابْنَيْهِ  - يَعْنِي :  الْحَسَنَ  أَوِ  الْحُسَيْنَ  -  يَقُولُ : الْحَمْدُ لِلهِ الَّذِي أَرَاحَ أُمَّةَ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ هَذِهِ الْعِصَابَةِ ، فَقَالَ  عَلِيٌّ  : "" لَوْ لَمْ يُبْقَ مِنْ أُمَّةِ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا ثَلَاثَةٌ لَكَانَ أَحَدُهُمْ عَلَى رَأْيِ هَؤُلَاءِ ، إِنَّهُمْ لَفِي أَصْلَابِ الرِّجَالِ وَأَرْحَامِ النِّسَاءِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي جَعْفَرٍ مَوْلَى عَلِيٍّ  إِلَّا  أَبُو جَعْفَرٍ الْفَرَّاءُ  ، وَلَا عَنْ  أَبِي جَعْفَرٍ  إِلَّا ابْنُهُ  عَبْدُ الْحَمِيدِ  ،  تَفَرَّدَ بِهِ  :  الْكَرْمَانِيُّ بْنُ عَمْرٍو  - أَخُو  مُعَاوِيَةَ بْنِ عَمْرٍو  "" .  كذا في طبعة دار الحرمين ، والذي في مجمع البحرين : ( عبد الحميد بن أبي جعفر الفراء عن أبي جعفر الفراء مولى علي ) وكذا ذكره في مجمع الزوائد عن أبي جعفر الفراء مولى علي ، وما ذكره المصنف عقب الحديث يدل على وجود سقط وأن الصواب : ( عبد الحميد بن أبي جعفر الفراء عن أبي جعفر الفراء عن أبي جعفر مولى علي ) فالله أعلم","","Al-Mu'jam al-Awsat 7666","","علي بن أبي طالب عن أبو جعفر مولى علي عن عبد الحميد بن أبي جعفر الفراء عن الكرماني بن عمرو الأزدي عن إسماعيل بن يحيى بن بحر الكرماني عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7673","7667  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ الطَّلْحِيُّ الْكُوفِيُّ ،  ثَنَا  أَبُو نُعَيْمٍ النَّخَعِيُّ ،  ثَنَا  أَبُو مَالِكٍ النَّخَعِيُّ  ، عَنْ  عَطَاءِ بْنِ السَّائِبِ  ، عَنْ  طَاوُسٍ  ، عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةِ أَعْظُمٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءِ بْنِ السَّائِبِ  ، عَنْ  طَاوُسٍ  إِلَّا  أَبُو مَالِكٍ         [7/340]      "" وَرَوَاهُ  وَرْقَاءُ  ، عَنْ  عَطَاءِ بْنِ السَّائِبِ  ، عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  .","","Al-Mu'jam al-Awsat 7667","","عبد الله بن عباس عن طاوس بن كيسان عن عطاء بن السائب عن ابن ذر ، عبد الملك بن الحسين النخعي عن عبد الرحمن بن هانئ الحارثي عن إبراهيم بن إسماعيل الطلحي عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7674","7668  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  نَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ الطَّلْحِيُّ ،  نَا  طَلْقُ بْنُ غَنَّامٍ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي فَرْوَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُكَيْمٍ قَالَ : جَاءَنَا كِتَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  قَبْلَ أَنْ يُقْبَضَ بِشَهْرَيْنِ  :  أَلَّا تَنْتَفِعُوا مِنَ الْمَيْتَةِ بِإِهَابٍ وَلَا عَصَبٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي فَرْوَةَ  إِلَّا  قَيْسٌ  ، وَلَا عَنْ  قَيْسٍ  إِلَّا  طَلْقُ بْنُ غَنَّامٍ  ،  تَفَرَّدَ بِهِ  :  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ  "" .","","Al-Mu'jam al-Awsat 7668","","عبد الله بن عكيم الجهني عن مسلم بن سالم الجهني عن قيس بن الربيع الأسدي عن طلق بن غنام النخعي عن إبراهيم بن إسماعيل الطلحي عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7675","7669  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  ثَنَا  أَبُو أُسَامَةَ عَبْدُ اللهِ بْنُ أُسَامَةَ الْكَلْبِيُّ ،  نَا  مُضَرُ بْنُ غَسَّانَ بْنِ مُضَرٍ ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ  ، عَنْ  أَبِي الزُّبَيْرِ  ، عَنْ  أَبِي الطُّفَيْلِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كُنْتُ أَنَا وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَغْتَسِلُ فِي الْإِنَاءِ الْوَاحِدِ  ، فَنَشْرَعُ فِيهِ جَمِيعًا ، فَمَا أَزِيدُ عَلَى أَنْ أَحْفِنَ عَلَى رَأْسِي ثَلَاثَ حَفَيَاتٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الزُّبَيْرِ  ، عَنْ  أَبِي الطُّفَيْلِ  إِلَّا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ  ،  تَفَرَّدَ بِهِ  :  مُضَرُ بْنُ غَسَّانَ  .  "" وَرَوَاهُ  أَيُّوبُ السَّخْتِيَانِيُّ  ،  وَحَمَّادُ بْنُ سَلَمَةَ  ،  وَرَوْحُ بْنُ الْقَاسِمِ  ، عَنْ  أَبِي الزُّبَيْرِ  ، عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ  ، عَنْ  عَائِشَةَ  .","","Al-Mu'jam al-Awsat 7669","","عائشة بنت أبي بكر الصديق عن عامر بن واثلة عن أبو الزبير المكي عن الحسن بن أبي جعفر الجفري عن مضر بن غسان النمري عن عبد الله بن أسامة الكلبى عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7676","7670  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  ثَنَا  أَبُو أُسَامَةَ عَبْدُ اللهِ بْنُ أُسَامَةَ الْكَلْبِيُّ ،  ثَنَا  يَحْيَى بْنُ الْمُنْذِرِ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْمُنْذِرِ الْكَاهِلِيِّ ،  عَنْ  عَنْبَسَةَ بْنِ أَبِي سُفْيَانَ ،  عَنْ  أُخْتِهِ أُمِّ حَبِيبَةَ  ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَلَّى فِي يَوْمٍ وَلَيْلَةٍ اثْنَتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  ، عَنِ  الْمُنْذِرِ  إِلَّا  شَرِيكٌ  ،  تَفَرَّدَ بِهِ  :  يَحْيَى بْنُ الْمُنْذِرِ  .         [7/341]      "" وَرَوَاهُ  الثَّوْرِيُّ  ،  وَمُحَمَّدُ بْنُ عَجْلَانَ  ، عَنْ  أَبِي إِسْحَاقَ  ، عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ  .","","Al-Mu'jam al-Awsat 7670","","رملة بنت أبي سفيان زوج رسول الله عن عنبسة بن أبي سفيان الأموي عن المنذر الكاهلي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن يحيى بن المنذر الكوفي عن عبد الله بن أسامة الكلبى عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7677","7671  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  الْحَسَنُ بْنُ كَثِيرِ بْنِ يَحْيَى بْنِ أَبِي كَثِيرٍ الْيَمَامِيُّ ،  نَا  سَعِيدُ بْنُ سُلَيْمَانَ السُّلَمِيُّ ،  نَا  عُيَيْنَةُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ جَوْشَنٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي بَكْرَةَ قَالَ :  كُنَّا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَدِمَ عَلَيْهِ وَفْدُ  بَنِي تَمِيمٍ  ، عَلَيْهِمْ  قَيْسُ بْنُ عَاصِمٍ  ،  وَعَمْرُو بْنُ الْأَهْتَمِ  ،  وَالزِّبْرِقَانُ بْنُ بَدْرٍ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَمْرِو بْنِ الْأَهْتَمِ  :  مَا تَقُولُ فِي  الزِّبْرِقَانِ بْنِ بَدْرٍ  ؟  قَالَ : يَا رَسُولَ اللهِ ، مُطَاعٌ فِي أَنْدِيَتِهِ ، شَدِيدُ  الْعَارِضَةِ  ، مَانِعٌ لِمَا وَرَاءَ ظَهْرِهِ ، قَالَ  الزِّبْرِقَانُ  : يَا رَسُولَ اللهِ ، إِنَّهُ لَيَعْلَمُ أَكْثَرَ مِمَّا وَصَفَنِي بِهِ ، وَلَكِنَّهُ  حَسَدَنِي  ، فَقَالَ  عَمْرٌو  : وَاللهِ يَا رَسُولَ اللهِ ، إِنَّهُ لَزَمِنُ الْمُرُوءَةِ ضَؤُلُ الْعَطَنِ ، لَئِيمُ الْخَالِ ، أَحْمَقُ الْوَالِدِ ، وَاللهِ يَا رَسُولَ اللهِ ، مَا كَذَبْتُ أَوَّلًا ، وَلَقَدْ صَدَقْتُ آخِرًا ، وَلَكِنِّي رَضِيتُ فَقُلْتُ أَحْسَنَ مَا عَلِمْتُ ، وَغَضِبْتُ فَقُلْتُ أَقْبَحَ مَا عَلِمْتُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّ مِنَ  الْبَيَانِ  لَسِحْرًا ،  وَإِنَّ مِنَ الشِّعْرِ  لَحِكَمًا  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُيَيْنَةَ  إِلَّا  سَعِيدُ بْنُ سُلَيْمَانَ  ،  تَفَرَّدَ بِهِ  :  الْحَسَنُ بْنُ كَثِيرٍ  ، وَلَا يُرْوَى عَنْ  أَبِي بَكْرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 7671","","أبو بكرة الثقفي عن عبد الرحمن بن جوشن الغطفاني عن عيينة بن عبد الرحمن الغطفاني عن سعيد بن سليمان السلمي عن الحسن بن كثير بن يحيى بن أبي كثير اليمامي عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7678","7672  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  الْحَسَنُ بْنُ كَثِيرٍ  ، عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  ، عَنْ  عَبْدِ اللهِ بْنِ يَحْيَى بْنِ أَبِي كَثِيرٍ  ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْمُسْلِمَيْنِ إِذَا الْتَقَيَا فَتَصَافَحَا         [7/342]      وَتَسَاءَلَا أَنْزَلَ اللهُ بَيْنَهُمَا مِائَةَ رَحْمَةٍ  ، تِسْعَةً وَتِسْعِينَ لِأَبَشِّهِمَا ، وَأَطْلَقِهِمَا ، وَأَبَرِّهِمَا ، وَأَحْسَنِهِمَا مُسَاءَلَةً بِأَخِيهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  إِلَّا ابْنُهُ  عَبْدُ اللهِ  ، وَلَا رَوَاهُ عَنْ  عَبْدِ اللهِ  إِلَّا  يَحْيَى بْنُ مِسْمَعٍ  ،  تَفَرَّدَ بِهِ  :  الْحَسَنُ بْنُ كَثِيرٍ  "" .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( يحيى بن كثير )","","Al-Mu'jam al-Awsat 7672","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن عبد الله بن يحيى بن أبي كثير اليمامي عن يحيى بن كثير العنبري عن الحسن بن يحيى بن كثير المصيصي عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7679","7673  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  الْحَسَنُ بْنُ كَثِيرٍ ،  نَا  يَحْيَى بْنُ سَعِيدٍ الْيَمَامِيُّ ،  نَا  نَصْرُ بْنُ يَحْيَى بْنِ أَبِي كَثِيرٍ ،  ثَنَا  أَبِي  ،  حَدَّثَنِي  سَعِيدُ بْنُ أَبِي سَعِيدٍ  ، عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَرْبَعَةُ أَجْبَالٍ مِنْ أَجْبَالِ الْجَنَّةِ ، وَأَرْبَعَةُ أَنْهَارٍ مِنْ أَنْهَارِ الْجَنَّةِ  ، فَأَمَّا الْأَجْبَالُ :  فَالطُّورُ  ،  وَلُبْنَانُ  ،  وَطُورُ سَيْنَاءَ  ،  وَطُورُ زَيْتًا  ، وَالْأَنْهَارُ مِنَ الْجَنَّةِ :  الْفُرَاتُ  ،  وَالنِّيلُ  ،  وَسَيْحَانُ  ،  وَجَيْحَانُ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  إِلَّا ابْنُهُ  نَصْرٌ  ، وَلَا رَوَاهُ عَنْ  نَصْرٍ  إِلَّا  يَحْيَى بْنُ أَبِي سَعِيدٍ الْيَمَامِيُّ  ،  تَفَرَّدَ بِهِ  :  الْحَسَنُ بْنُ كَثِيرٍ  "" .","","Al-Mu'jam al-Awsat 7673","","أبو هريرة الدوسي عن سعيد المقبري عن يحيى بن أبي كثير عن نصر بن يحيى بن أبى كثير عن يحيى بن سعيد اليمامي عن الحسن بن كثير عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7680","7674  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  ثَنَا  الْحَسَنُ بْنُ كَثِيرٍ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  نَا  نَصْرُ بْنُ يَحْيَى ،  نَا  أَبِي  قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  إِنَّ أَسْفَلَ أَهْلِ الْجَنَّةِ أَجْمَعِينَ دَرَجَةً لَمَنْ يَقُومُ عَلَى رَأْسِهِ عَشَرَةُ آلَافِ خَادِمٍ  ، بِيَدِ كُلِّ وَاحِدٍ مِنْهُمْ صَحْفَتَانِ ، وَاحِدَةٌ مِنْ ذَهَبٍ وَالْأُخْرَى مِنْ فِضَّةٍ ، فِي كُلِّ وَاحِدَةٍ لَوْنٌ لَيْسَ فِي الْأُخْرَى مِثْلُهُ ، يَأْكُلُ مِنْ آخِرِهَا مِثْلَ مَا يَأْكُلُ مِنْ أَوَّلِهَا ، يَجِدُ لِآخِرِهَا مِنَ الطِّيبِ         [7/343]      وَاللَّذَّةِ مِثْلَ الَّذِي يَجِدُ لِأَوَّلِهَا ، ثُمَّ يَكُونُ ذَلِكَ كَرِيحِ الْمِسْكِ  الْأَذْفَرِ  ، لَا يَبُولُونَ ، وَلَا يَتَغَوَّطُونَ ، وَلَا يَمْتَخِطُونَ ، إِخْوَانًا عَلَى سُرُرٍ مُتَقَابِلِينَ  .","","Al-Mu'jam al-Awsat 7674","","أنس بن مالك عن يحيى بن أبي كثير عن نصر بن يحيى بن أبى كثير عن يحيى بن سعيد بن يزيد اليمامي عن الحسن بن كثير بن يحيى بن أبي كثير عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7681","7675  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  ثَنَا  الْحَسَنُ بْنُ كَثِيرٍ ،  ثَنَا  سَلْمَى بْنُ عُقْبَةَ الْحَنَفِيُّ الْيَمَامِيُّ ،  ثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ  ، عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  ، عَنْ  أَبِي سَلَمَةَ  ، عَنْ  أَبِي هُرَيْرَةَ قَالَ :  قَالَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  : يَا رَسُولَ اللهِ ، أَيُّمَا أَحَبُّ إِلَيْكَ : أَنَا أَمْ  فَاطِمَةُ  ؟ قَالَ :  فَاطِمَةُ  أَحَبُّ إِلَيَّ مِنْكَ ، وَأَنْتَ أَعَزُّ عَلَيَّ مِنْهَا  ، وَكَأَنِّي بِكَ وَأَنْتَ عَلَى حَوْضِي تَذُودُ عَنْهُ النَّاسَ ، وَإِنَّ عَلَيْهِ لَأَبَارِيقَ مِثْلَ عَدَدِ نُجُومِ السَّمَاءِ ، وَإِنِّي وَأَنْتَ  وَالْحَسَنُ  وَالْحُسَيْنُ  وَفَاطِمَةُ  وَعَقِيلٌ  وَجَعْفَرٌ  فِي الْجَنَّةِ إِخْوَانًا عَلَى سُرُرٍ مُتَقَابِلِينَ ، وَأَنْتَ مَعِي وَشِيعَتُكَ فِي الْجَنَّةِ "" ، ثُمَّ قَرَأَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      إِخْوَانًا عَلَى سُرُرٍ مُتَقَابِلِينَ         }      لَا يَنْظُرُ أَحَدُهُمْ فِي قَفَا صَاحِبِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  إِلَّا  عِكْرِمَةُ بْنُ عَمَّارٍ  ، وَلَا رَوَاهُ عَنْ  عِكْرِمَةَ  إِلَّا  سَلْمَى بْنُ عُقْبَةَ  ،  تَفَرَّدَ بِهِ  :  الْحَسَنُ بْنُ كَثِيرٍ  "" .","","Al-Mu'jam al-Awsat 7675","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن عكرمة بن عمار عن سلمى بن عقبة الحنفي اليمامي عن الحسن بن كثير بن يحيى بن أبي كثير عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7682","7676  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  ثَنَا  الْحَسَنُ بْنُ كَثِيرٍ  ، حَدَّثَتْنِي  نَضْرَةُ بِنْتُ جَهْضَمِ بْنِ عَبْدِ اللهِ بْنِ أَبِي الطُّفَيْلِ الْقَيْسِيَّةُ ،  عَنْ  أَبِيهَا  ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  ، عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  قُلْتُ : يَا رَسُولَ اللهِ ، لَيْسَ  الشَّهِيدُ  إِلَّا مَنْ قُتِلَ فِي  سَبِيلِ  اللهِ ، فَقَالَ :  يَا  عَائِشَةُ  ، إِنَّ شُهَدَاءَ أُمَّتِي إِذًا لَقَلِيلٌ  ، مَنْ قَالَ فِي يَوْمٍ خَمْسَةً وَعِشْرِينَ مَرَّةً : اللَّهُمَّ بَارِكْ فِي الْمَوْتِ ، وَفِيمَا بَعْدَ الْمَوْتِ ، ثُمَّ مَاتَ عَلَى فِرَاشِهِ ، أَعْطَاهُ اللهُ أَجْرَ  شَهِيدٍ  .","","Al-Mu'jam al-Awsat 7676","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن جهضم بن عبد الله القيسي عن نضرة بنت جهضم بن عبد الله بن أبي الطفيل القيسية عن الحسن بن كثير بن يحيى بن أبي كثير عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7683","[7/344]      7677  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَهْلِ بْنِ مَخْلَدٍ الْإِصْطَخْرِيُّ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  ، عَنْ  بَحْرٍ السَّقَّاءِ  ، عَنْ  أَبِي الزُّبَيْرِ  ، عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلَيْكُمْ بِالْأَبْكَارِ ، فَإِنَّهُنَّ  أَنْتَقُ  أَرْحَامًا ، وَأَعْذَبُ أَفْوَاهًا  ، وَأَقَلُّ خِبًّا ، وَأَرْضَى بِالْيَسِيرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بَحْرٍ  إِلَّا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  "" .","","Al-Mu'jam al-Awsat 7677","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن بحر بن كنيز السقاء عن عصمة بن المتوكل الحنفي عن محمد بن سهل بن مخلد الإصطخري عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7684","7678  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  نَا  أَبُو أُسَامَةَ عَبْدُ اللهِ بْنُ أُسَامَةَ الْكَلْبِيُّ ،  نَا  حَمَّادُ بْنُ خُوَارٍ ،  نَا  فُضَيْلُ بْنُ مَرْزُوقٍ  ، عَنْ  عَطِيَّةَ  ، عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَرَأَ بِعَشْرِ آيَاتٍ لَمْ يُكْتَبْ مِنَ الْغَافِلِينَ  ، وَمَنْ قَامَ بِمِائَةِ آيَةٍ كُتِبَ مِنَ  الْقَانِتِينَ  ، وَمَنْ قَامَ بِمِائَتَيْ آيَةٍ كُتِبَ مِنَ الْعَابِدِينَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  فُضَيْلِ بْنِ مَرْزُوقٍ  إِلَّا  حَمَّادُ بْنُ حَمَّادِ بْنِ خُوَارٍ - أَخُو حُمَيْدِ بْنِ حَمَّادٍ  ""  .","","Al-Mu'jam al-Awsat 7678","","أبو سعيد الخدري عن عطية بن سعد العوفي عن فضيل بن مرزوق الأغر عن حماد بن أبي الخوار عن عبد الله بن أسامة الكلبى عن محمد بن موسى بن عاصم المصرى عن الطبراني","محمد بن موسى الإصطخري"
"7685","7679  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  نَا  أَبُو أُسَامَةَ عَبْدُ اللهِ بْنُ أُسَامَةَ ،  ثَنَا  عُبَيْدُ بْنُ عَبْدِ الرَّحْمَنِ الْبَزَّارُ ،  نَا  عِيسَى بْنُ طَهْمَانَ  ، عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فِي الْمَسْحِ عَلَى الْخُفَّيْنِ قَالَ :  ثَلَاثَةُ أَيَّامٍ وَلَيَالِيهِنَّ لِلْمُسَافِرِ ، وَلِلْمُقِيمِ يَوْمٌ وَلَيْلَةٌ  "" = .","","Al-Mu'jam al-Awsat 7679","","أنس بن مالك عن عيسى بن طهمان الجشمي عن عبيد بن عبد الرحمن عن عبد الله بن أسامة الكلبى عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7686","7680  -  = وَبِهِ  :         [7/345]      عَنْ  أَنَسٍ قَالَ :  مَرَّ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِقَبْرَيْنِ  لِبَنِي النَّجَّارِ  ، يُعَذَّبَانِ بِالنَّمِيمَةِ وَالْبَوْلِ ، فَأَخَذَ  سَعَفَةً  ، فَشَقَّهَا ، فَوَضَعَ عَلَى هَذَا الْقَبْرِ شَقًّا ، وَعَلَى هَذَا الْقَبْرِ شَقًّا ، وَقَالَ :  لَا يَزَالُ يُخَفَّفُ عَنْهُمَا مَا دَامَتَا رَطْبَتَيْنِ  = .","","Al-Mu'jam al-Awsat 7680","","أنس بن مالك عن عيسى بن طهمان الجشمي عن عبيد بن عبد الرحمن بن عبيد بن سلمة اليمامي عن عبد الله بن أسامة الكلبى عن محمد بن موسى الإصطخري عن الطبراني","محمد بن موسى الإصطخري"
"7687","7681  -  = وَبِهِ  :  عَنْ  أَنَسٍ قَالَ :  مَرَّ  ابْنُ مَسْعُودٍ  ، فَإِذَا هُوَ  بِأَبِي جَهْلٍ  يَجُودُ  بِنَفْسِهِ ، فَجَاءَ حَتَّى قَعَدَ عَلَى صَدْرِهِ  ، فَرَفَعَ  أَبُو جَهْلٍ  رَأْسَهُ ، فَقَالَ : أَلَسْتَ رُوَيْعِنًا بِالْأَمْسِ  بِمَكَّةَ  ، لَقَدْ صَعِدْتَ مَصْعَدًا صَعْبًا ،  فَاحْتَزَّ  رَأْسَهُ ، فَجَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : هَذَا رَأْسُ  أَبِي جَهْلٍ  ، فَقَالَ : "" اللهِ "" قَالَ : اللهِ ، إِنَّهُ رَأْسُهُ ، قَالَ : ثُمَّ أَمَرَ بِهِ إِلَى  الْقَلِيبِ  "" .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنْ  عِيسَى بْنِ طَهْمَانَ  إِلَّا  عُبَيْدُ بْنُ عَبْدِ الرَّحْمَنِ  ،  تَفَرَّدَ بِهَا  :  أَبُو أُسَامَةَ الْكَلْبِيُّ  "" .","","Al-Mu'jam al-Awsat 7681","","أنس بن مالك عن عيسى بن طهمان الجشمي عن عبيد بن عبد الرحمن عن عبد الله بن أسامة الكلبى عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7688","7682  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  نَا  مُحَمَّدُ بْنُ سَهْلٍ ،  نَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  خَارِجَةُ بْنُ مُصْعَبٍ  ، عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  ثَنَا  أَبُو رِفَاعَةَ ،  أَنَّ  أَبَا سَعِيدٍ الْخُدْرِيَّ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : يَا نَبِيَّ اللهِ ، إِنَّ لِي وَلِيدَةً ، وَأَنَا  أَعْزِلُ  عَنْهَا ، وَأَنَا أُرِيدُ مِنْهَا مَا يُرِيدُ الرِّجَالُ ، وَأَكْرَهُ أَنْ تَحْمِلَ ، وَإِنَّ الْيَهُودَ تَزْعُمُ أَنَّ  الْمَوْءُودَةَ  الصُّغْرَى  الْعَزْلُ  ، قَالَ :  كَذَبَتْ يَهُودُ ، لَوْ أَرَادَ اللهُ أَنْ يَخْلُقَهُ لَمْ يَسْتَطِعْ أَحَدٌ أَنْ يَصْرِفَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ سَعِيدٍ  إِلَّا  خَارِجَةُ بْنُ مُصْعَبٍ  ،  تَفَرَّدَ بِهِ  :  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  "" .","","Al-Mu'jam al-Awsat 7682","","أبو سعيد الخدري عن أبو مطيع بن عوف الأنصاري عن يحيى بن سعيد الأنصاري عن خارجة الضبعي عن عصمة بن المتوكل الحنفي عن محمد بن سهل عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7689","7683  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  نَا  الْحُسَيْنُ بْنُ الْعَبَّاسِ الْإِصْطَخْرِيُّ ،  نَا  الْكَرْمَانِيُّ بْنُ عَمْرٍو ،  نَا  مِنْدَلُ بْنُ عَلِيٍّ ،  ثَنَا  لَيْثُ بْنُ أَبِي سُلَيْمٍ  ، عَنْ  عَطَاءٍ  ، عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَيْنَ الْعَبْدِ وَبَيْنَ الْكُفْرِ تَرْكُ الصَّلَاةِ  ، وَبَيْنَ الْعَبْدِ وَبَيْنَ  الشِّرْكِ  تَرْكُ الصَّلَاةِ  .         [7/346]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  لَيْثٍ  ، عَنْ  عَطَاءٍ  إِلَّا  مِنْدَلُ بْنُ عَلِيٍّ  ،  تَفَرَّدَ بِهِ  :  الْكَرْمَانِيُّ بْنُ عَمْرٍو  "" .","","Al-Mu'jam al-Awsat 7683","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن ليث بن أبي سليم عن مندل بن علي عن الكرماني بن عمرو الأزدي عن الحسين بن العباس الإصطخري عن محمد بن موسى بن عاصم المصرى عن الطبراني","محمد بن موسى الإصطخري"
"7690","7684  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  ثَنَا  يَحْيَى بْنُ الْعَبَّاسِ الْإِصْطَخْرِيُّ ،  نَا  الْكَرْمَانِيُّ بْنُ عَمْرٍو ،  نَا  أَبُو كُدَيْنَةَ يَحْيَى بْنُ الْمُهَلَّبِ ،  ثَنَا  أَبُو جَنَابٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  عَدْوَى  ، وَلَا  طِيَرَةَ ،  وَلَا  هَامَةَ  فَقَامَ  أَعْرَابِيٌّ  ، فَقَالَ : بَعِيرٌ أَجْرَبُ  انْسَلَّ  فِي إِبِلِي ، فَأَجْرَبَهَا ، قَالَ : "" ذَلِكَ الْقَدَرُ ، فَمَنْ أَجْرَبَ الْأَوَّلَ ؟  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي جَنَابٍ  إِلَّا  أَبُو كُدَيْنَةَ  ،  تَفَرَّدَ بِهِ  :  الْكَرْمَانِيُّ  "" .","","Al-Mu'jam al-Awsat 7684","","عبد الله بن عمر بن الخطاب عن حيي الكلبي عن يحيى بن أبي حية عن يحيى بن المهلب البجلي عن الكرماني بن عمرو الأزدي عن يحيى بن العباس الإصطخري عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7691","7685  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  ثَنَا  مُحَمَّدُ بْنُ سَهْلِ بْنِ مَخْلَدٍ ،  ثَنَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  نَا  أَبُو جَعْفَرٍ الرَّازِيُّ  ، عَنْ  سَعْدِ بْنِ سَعِيدٍ  ، عَنْ  عُمَرَ بْنِ ثَابِتٍ  ، عَنْ  أَبِي أَيُّوبَ الْأَنْصَارِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَامَ رَمَضَانَ وَأَتْبَعَهُ بِسِتٍّ مِنْ شَوَّالٍ ، فَقَدْ صَامَ الدَّهْرَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي جَعْفَرٍ الرَّازِيِّ  إِلَّا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ  "" .","","Al-Mu'jam al-Awsat 7685","","أبو أيوب الأنصاري عن عمر بن ثابت بن الحارث الخزرجي عن سعد بن سعيد بن قيس الأنصاري عن عيسى بن أبي عيسى الرازي عن عصمة بن المتوكل الحنفي عن محمد بن سهل بن مخلد عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7692","7686  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْإِصْطَخْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَهْلِ بْنِ مَخْلَدٍ ،  ثَنَا  عِصْمَةُ بْنُ الْمُتَوَكِّلِ ،  ثَنَا  أَبُو مُطِيعٍ  ، عَنْ  مُسْلِمِ بْنِ خَالِدٍ  ، عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ  ، عَنِ  ابْنِ عُمَرَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُحْمَلَ الْقُرْآنُ إِلَى أَرْضِ الْعَدُوِّ  ، مَخَافَةَ أَنْ يَنَالَهُ الْعَدُوُّ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ  إِلَّا  مُسْلِمُ بْنُ خَالِدٍ  ،  تَفَرَّدَ بِهِ  :  أَبُو مُطِيعٍ - وَهُوَ : الْحَكَمُ بْنُ عَبْدِ اللهِ الْبَلْخِيُّ  "" .","","Al-Mu'jam al-Awsat 7686","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن مسلم بن خالد الزنجي عن الحكم بن عبد الله بن مسلمة الخراساني عن عصمة بن المتوكل الحنفي عن محمد بن سهل بن مخلد عن محمد بن موسى بن إبراهيم الوتار عن الطبراني","محمد بن موسى الإصطخري"
"7693","7687  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْوَلِيدِ بْنِ أَبَانَ الْبَغْدَادِيُّ ،  نَا  يَحْيَى بْنُ سُلَيْمَانَ         [7/347]      الْجُعْفِيُّ ،  ثَنَا  ابْنُ وَهْبٍ  ، أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ  ، عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ  ، عَنِ  ابْنِ شِهَابٍ ، أَنَّ  ابْنًا لِلنُّعْمَانِ بْنِ بَشِيرٍ ،  حَدَّثَهُ  ،  عَنْ  أَبِيهِ النُّعْمَانِ بْنِ بَشِيرٍ  ،  أَنَّهُ حَضَرَ زَيْدَ بْنَ خَارِجَةَ ، حِينَ تَكَلَّمَ بَعْدَ أَنْ مَاتَ ، وَغُطِّيَ ، قَالَ : أَوَّلُ مَا تَكَلَّمَ بِهِ أَنْ  قَالَ  : ""  مُحَمَّدٌ  رَسُولُ اللهِ  ، أَشْهَدُ حَقًّا ،  أَبُو بَكْرٍ  الضَّعِيفُ فِي أَعْيَنِ النَّاسِ قَوِيٌّ فِي أَمْرِ اللهِ ، أَشْهَدُ حَقًّا ،  عُمَرُ بْنُ الْخَطَّابِ  الْقَوِيُّ الْأَمِينُ ، أَشْهَدُ حَقًّا  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  بُكَيْرٌ  ، وَلَا عَنْ  بُكَيْرٍ  إِلَّا  عَمْرُو بْنُ الْحَارِثِ  ،  تَفَرَّدَ بِهِ  :  ابْنُ وَهْبٍ  "" .","","Al-Mu'jam al-Awsat 7687","","زيد بن خارجة الأنصاري عن النعمان بن بشير الأنصاري عن ابن للنعمان بن بشير عن الزهري عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن يحيى بن سليمان بن يحيى عن محمد بن أحمد بن الوليد البغدادي عن الطبراني","محمد بن أحمد بن الوليد بن أبان البغدادي"
"7694","7688  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْوَلِيدِ ،  نَا  مُحَمَّدُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  مُحَمَّدُ بْنُ حَمْزَةَ بْنِ يُوسُفَ بْنِ عَبْدِ اللهِ بْنِ سَلَامٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَى  الْمِرْبَدِ  ، فَرَأَى  عُثْمَانَ  يَقُودُ نَاقَةً مُحَمَّلَةً دَقِيقًا وَسَمْنًا وَعَسَلًا ،  فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَنِخْ "" فَأَنَاخَ ، فَدَعَا  بِبُرْمَةٍ  ، فَجَعَلَ فِيهَا مِنَ السَّمْنِ وَالْعَسَلِ وَالدَّقِيقِ ، ثُمَّ أَمَرَ فَأُوقِدَ تَحْتَهَا حَتَّى  أَدْرَكَ أَوْ أَنْضَجَ  ، وَقَالَ : "" كُلُوا "" ، وَأَكَلَ مِنْهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ قَالَ : "" إِنَّ هَذَا شَيْءٌ يَدْعُوهُ  أَهْلُ فَارِسٍ  الْخَبِيصَ "" .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  الْوَلِيدُ بْنُ مُسْلِمٍ ""  .","","Al-Mu'jam al-Awsat 7688","","عبد الله بن سلام بن الحارث الإسرائيلي عن حمزة بن يوسف بن عبد الله بن سلام عن محمد بن حمزة الإسرائيلي عن الوليد بن مسلم القرشي عن محمد بن المتوكل بن ابى السرى عن محمد بن أحمد بن الوليد البغدادي عن الطبراني","محمد بن أحمد بن الوليد بن أبان البغدادي"
"7695","[7/348]      7689  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْوَلِيدِ ،  ثَنَا  نَصْرُ بْنُ مُحَمَّدِ بْنِ سُلَيْمَانَ السُّلَمِيُّ الْحِمْصِيُّ ،  ثَنَا  أَبِي مُحَمَّدُ بْنُ سُلَيْمَانَ  ،  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي قَيْسٍ النَّصْرِيُّ قَالَ :  رَأَيْتُ عَبْدَ اللهِ بْنَ الزُّبَيْرِ ، عَلَى مِنْبَرِهِ قَائِمًا  بِمَكَّةَ  ، وَهُوَ  يَخْطُبُ  : ، وَهُوَ يَقُولُ  إِنَّ الْمُؤْمِنَ يَأْكُلُ فِي  مِعًى  وَاحِدٍ ، وَالْكَافِرَ يَأْكُلُ فِي سَبْعَةِ أَمْعَاءٍ  ، هَكَذَا سَمِعْتُ نَبِيَّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Al-Mu'jam al-Awsat 7689","","عبد الله بن الزبير عن عبد الله بن أبي قيس النصري عن محمد بن سليمان بن أبي ضمرة الحمصي عن نصر بن محمد بن سليمان السلمي عن محمد بن أحمد بن الوليد البغدادي عن الطبراني","محمد بن أحمد بن الوليد بن أبان البغدادي"
"7696","7690  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ رَوْحٍ الْبَغْدَاذِيُّ ،  نَا  عَبْدُ الْمَلِكِ بْنُ عَبْدِ رَبِّهِ الطَّائِيُّ ،  نَا  ابْنُ سِمَاكِ بْنِ حَرْبٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ مَسْعُودٍ ،  عَنْ  أَبِيهِ  قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  رَحِمَ اللهُ مَنْ سَمِعَ مِنَّا حَدِيثًا فَبَلَّغَهُ كَمَا سَمِعَهُ  ، فَرُبَّ مُبَلَّغٍ أَوْعَى مِنْ سَامِعٍ  .","","Al-Mu'jam al-Awsat 7690","","عبد الله بن مسعود عن عبد الرحمن بن عبد الله بن مسعود عن سماك بن حرب البكري عن سعيد بن سماك بن حرب عن عبد الملك بن عبد ربه الطائي عن محمد بن أحمد بن روح الصفواني عن الطبراني","محمد بن أحمد بن روح البغدادي"
"7697","7691  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ رَوْحٍ ،  نَا  عَبْدُ الْمَلِكِ بْنُ عَبْدِ رَبِّهِ ،  نَا  ابْنُ السِّمَاكِ بْنِ حَرْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَعْدَةَ بْنِ هُبَيْرَةَ ،  عَنْ  جَدَّتِهِ أُمِّ هَانِئٍ بِنْتِ أَبِي طَالِبٍ ، قَالَتْ :  دَخَلَ عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ فَتْحِ مَكَّةَ  وَأَنَا صَائِمَةٌ ، فَقَالَ :  اشْرَبِي "" قُلْتُ : إِنِّي صَائِمَةٌ ، قَالَ : "" أَصَوْمُ قَضَاءٍ ؟  قُلْتُ : لَا ، قَالَ : "" فَاشْرَبِي "" ، فَشَرِبْتُ "" .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنِ  ابْنِ سِمَاكِ بْنِ حَرْبٍ -وَاسْمُهُ : سَعِيدٌ  - إِلَّا  عَبْدُ الْمَلِكِ بْنُ عَبْدِ رَبِّهِ الطَّائِيُّ  "" .","","Al-Mu'jam al-Awsat 7691","","فاختة الهاشمية أخت علي بن أبي طالب عن جعدة المخزومي عن سماك بن حرب البكري عن سعيد بن سماك بن حرب عن عبد الملك بن عبد ربه الطائي عن محمد بن أحمد بن روح الصفواني عن الطبراني","محمد بن أحمد بن روح البغدادي"
"7698","7692  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ رَوْحٍ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الصَّمَدِ الْأَنْصَارِيُّ ،  ثَنَا  أَبُو سَعْدٍ الْأَشْهَلِيُّ  ، حَدَّثَنِي  مُحَمَّدُ بْنُ عَجْلَانَ  ، عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَلْقَمَةَ  ، عَنْ  مَلِيحِ بْنِ عَبْدِ اللهِ الْخَطْمِيِّ  ، عَنْ  أَبِي هُرَيْرَةَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الَّذِي يَسْجُدُ قَبْلَ الْإِمَامِ ، وَيَرْفَعُ قَبْلَهُ ، إِنَّمَا نَاصِيَتُهُ بِيَدِ شَيْطَانٍ  = .","","Al-Mu'jam al-Awsat 7692","","أبو هريرة الدوسي عن مليح بن عبد الله السعدي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن محمد بن عجلان عن محمد بن سعد الأشهلي عن أحمد بن عبد الصمد النهرواني عن محمد بن أحمد بن روح الصفواني عن الطبراني","محمد بن أحمد بن روح البغدادي"
"7699","[7/349]      7693  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ رَوْحٍ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الصَّمَدِ الْأَنْصَارِيُّ ،  نَا  أَبُو سَعْدٍ الْأَشْهَلِيُّ  ، حَدَّثَنِي  مُحَمَّدُ بْنُ عَجْلَانَ  ، عَنْ  نُعَيْمِ بْنِ عَبْدِ اللهِ الْمُجْمِرِ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  فَضْلُ الْجَمَاعَةِ عَلَى صَلَاةِ الْفَذِّ سَبْعٌ وَعِشْرُونَ دَرَجَةً  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ  إِلَّا  أَبُو سَعْدٍ مُحَمَّدُ بْنُ سَعْدٍ الْأَشْهَلِيُّ  "" .","","Al-Mu'jam al-Awsat 7693","","عبد الله بن عمر بن الخطاب عن نعيم بن عبد الله المجمر عن محمد بن عجلان عن محمد بن سعد الأشهلي عن أحمد بن عبد الصمد النهرواني عن محمد بن أحمد بن روح الصفواني عن الطبراني","محمد بن أحمد بن روح البغدادي"
"7700","7694  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ رَوْحٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ  ، عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ  ، عَنْ  إِسْمَاعِيلَ بْنِ رَافِعٍ  ، عَنْ  مَوْلًى لِسَعِيدِ بْنِ عَبْدِ الْمَلِكِ بْنِ مَرْوَانَ - يُقَالُ لَهُ : دُويْدٌ  .  عَنْ  أُمِّ هَانِئٍ بِنْتِ أَبِي طَالِبٍ ،  أَنَّهَا قَالَتْ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنِّي قَدْ كَبِرْتُ وَضَعُفْتُ ، فَدُلَّنِي عَلَى عَمَلٍ أَعْمَلُهُ ، وَأَنَا جَالِسَةٌ ، فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّكِ إِنْ كَبَّرْتِ اللهَ مِائَةً ، كَانَ خَيْرًا مِنْ مِائَةِ بَدَنَةٍ مُجَلَّلَةٍ مُتَقَبَّلَةٍ  ، وَإِنْ سَبَّحْتِ مِائَةً كَانَتْ خَيْرًا مِنْ مِائَةِ رَقَبَةٍ  تُعْتِقِينَهَا  ، وَإِنْ حَمِدْتِ اللهَ مِائَةَ مَرَّةٍ كَانَتْ خَيْرًا لَكِ مِنْ مِائَةِ فَرَسٍ مُسْرَجٍ مُلْجَمٍ تَحْمِلِينَ عَلَيْهَا فِي  سَبِيلِ  اللهِ ، وَإِنْ هَلَّلْتِ مِائَةَ تَهْلِيلَةٍ لَمْ يَسْبِقْهَا عَمَلٌ ، وَلَمْ يَبْقَ مَعَهَا ذَنْبٌ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ  إِلَّا  حَاتِمٌ  "" .","","Al-Mu'jam al-Awsat 7694","","فاختة الهاشمية أخت علي بن أبي طالب عن دويد بن نافع الأموي عن إسماعيل بن رافع بن عويمر المزني عن محمد بن عجلان عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن محمد بن أحمد بن روح الصفواني عن الطبراني","محمد بن أحمد بن روح البغدادي"
"7701","7695  -  حَدَّثَنَا  مُحَمَّدُ بْنُ دَاوُدَ بْنِ جَابِرٍ الْأَحْمَسِيُّ الْبَغْدَادِيُّ ،  نَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  نَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  بَشِيرٍ أَبِي إِسْمَاعِيلَ ،  عَنْ  سَيَّارٍ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنِ  ابْنِ مَسْعُودٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بَيْنَ يَدَيِ السَّاعَةِ يَظْهَرُ الرِّبَا ، وَالزِّنَا  ، وَالْخَمْرُ  .         [7/350]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بَشِيرٍ أَبِي إِسْمَاعِيلَ  إِلَّا  حَاتِمُ بْنُ إِسْمَاعِيلَ  "" .","","Al-Mu'jam al-Awsat 7695","","عبد الله بن مسعود عن طارق بن شهاب الأحمسي عن سيار الكوفي عن بشير بن سلمان عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن محمد بن داود بن جابر عن الطبراني","محمد بن داود بن جابر الأحمسي البغدادي"
"7702","7696  -  حَدَّثَنَا  مُحَمَّدُ بْنُ دَاوُدَ ،  ثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زِيَادِ بْنِ أَنْعُمَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ ، وَحِبَّانَ بْنِ أَبِي جَبَلَةَ ، وَبَكْرِ بْنِ سَوَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الشِّعْرُ بِمَنْزِلَةِ الْكَلَامِ  ، فَحَسَنُهُ كَحَسَنِ الْكَلَامِ ، وَقَبِيحُهُ كَقَبِيحِ الْكَلَامِ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الرَّحْمَنِ بْنُ زِيَادٍ  "" .","","Al-Mu'jam al-Awsat 7696","","عبد الله بن عمرو بن العاص عن عبد الرحمن بن رافع التنوخي عن عبد الرحمن بن زياد بن أنعم الإفريقي عن إسماعيل بن عياش الأحول عن منصور بن أبي مزاحم عن محمد بن داود بن جابر عن الطبراني","محمد بن داود بن جابر الأحمسي البغدادي"
"7703","7697  -  حَدَّثَنَا  مُحَمَّدُ بْنُ دَاوُدَ ،  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ التَّرْجُمَانِيُّ ،  ثَنَا  صَالِحٌ الْمُرِّيُّ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ أَحَبَّكُمْ إِلَيَّ أَحْسَنُكُمْ  أَخْلَاقًا  ، الْمُوَطَّئُونَ  أَكْنَافًا  ، الَّذِينَ يَأْلَفُونَ وَيُؤْلَفُونَ ، وَأَبْغَضَكُمْ إِلَى اللهِ الْمَشَّاءُونَ بِالنَّمِيمَةِ ، الْمُفَرِّقُونَ بَيْنَ الْأَحِبَّةِ ، الْمُلْتَمِسُونَ لِلْبُرَآءِ  الْعَنَتَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْجُرَيْرِيِّ  إِلَّا  صَالِحٌ الْمُرِّيُّ  "" .","","Al-Mu'jam al-Awsat 7697","","أبو هريرة الدوسي عن أبو عثمان النهدي عن سعيد بن إياس الجريري عن صالح بن بشير المري عن إسماعيل بن إبراهيم الترجماني عن محمد بن داود بن جابر عن الطبراني","محمد بن داود بن جابر الأحمسي البغدادي"
"7704","7698  -  حَدَّثَنَا  مُحَمَّدُ بْنُ دَاوُدَ ،  نَا  سُلَيْمَانُ بْنُ عُمَرَ الْأَقْطَعُ الرَّقِّيُّ ،  نَا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الْأَسْوَدَ إِذَا جَاعَ سَرَقَ ، وَإِذَا شَبِعَ زَنَى  ، وَإِنَّ فِيهِمْ لَخَلَّتَيْ صِدْقٍ : السَّمَاحَةُ ،  وَالنَّجْدَةُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  ، عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ  ""  .","","Al-Mu'jam al-Awsat 7698","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن إسحاق عن يحيى بن سعيد بن أبان عن سليمان بن عمر بن خالد المخرمي عن محمد بن داود بن جابر عن الطبراني","محمد بن داود بن جابر الأحمسي البغدادي"
"7705","[7/351]      7699  -  حَدَّثَنَا  مُحَمَّدُ بْنُ دَاوُدَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ بْنِ أَبَانَ ،  نَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  سُلَيْمَانَ بْنِ مُوسَى ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، "" أَنَّهُ  نَهَى أَنْ يُكْتَبَ عَلَى الْقَبْرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَيْسٍ  إِلَّا  عَبْدُ الرَّحِيمِ ""  .","","Al-Mu'jam al-Awsat 7699","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن سليمان بن موسى الأشدق عن ابن جريج عن قيس بن الربيع الأسدي عن عبد الرحيم بن سليمان الأشل عن عبد الله بن عمر مشكدانة عن محمد بن داود بن جابر عن الطبراني","محمد بن داود بن جابر الأحمسي البغدادي"
"7706","7700  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ إِسْمَاعِيلَ الْبَغْدَادِيُّ ،  ثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  ثَنَا  أَبُو إِسْمَاعِيلَ الْمُؤَدِّبُ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْدِ بْنِ خَالِدٍ الْجُهَنِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  جَهَّزَ  غَازِيًا ، أَوْ فَطَّرَ صَائِمًا ، أَوْ  جَهَّزَ  حَاجًّا  ، كَانَ لَهُ مِثْلُ أَجْرِهِ ، مِنْ غَيْرِ أَنْ يَنْقُصَ مِنْ أَجْرِهِ شَيْئًا  .","","Al-Mu'jam al-Awsat 7700","","زيد بن خالد الجهني عن عطاء بن أبي رباح عن يعقوب بن عطاء بن أبي رباح المكي عن إبراهيم بن سليمان أبو إسماعيل عن منصور بن أبي مزاحم عن محمد بن إسحاق بن إسماعيل عن الطبراني","محمد بن إسحاق بن إسماعيل البغدادي"
"7707","7701  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ إِسْمَاعِيلَ ،  ثَنَا  مَنْصُورٌ ،  ثَنَا  أَبُو إِسْمَاعِيلَ ،  عَنْ  يَعْقُوبَ ،  عَنْ  أَبِيهِ  قَالَ :  اسْتَلَمَ  عُمَرُ ،  الرُّكْنَ  وَقَبَّلَهُ ،  وَقَالَ  : أَمَا إِنِّي أَعْلَمُ أَنَّكَ حَجَرٌ لَا تَضُرُّ وَلَا تَنْفَعُ  ، وَلَوْلَا أَنِّي "" رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَبِّلُكَ "" مَا قَبَّلْتُكَ "" .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ  إِلَّا  أَبُو إِسْمَاعِيلَ  ،  تَفَرَّدَ بِهِمَا  :  مَنْصُورٌ  "" .","","Al-Mu'jam al-Awsat 7701","","عمر بن الخطاب عن عطاء بن أبي رباح عن يعقوب بن عطاء بن أبي رباح المكي عن إبراهيم بن سليمان أبو إسماعيل عن منصور بن أبي مزاحم عن محمد بن إسحاق بن إسماعيل عن الطبراني","محمد بن إسحاق بن إسماعيل البغدادي"
"7708","7702  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ أَبُو السَّائِبِ الْمَخْزُومِيُّ  ،  ثَنَا  أَحْمَدُ بْنُ أَبِي شَيْبَةَ الرَّهَاوِيُّ ،  نَا  مِسْكِينُ بْنُ بُكَيْرٍ ،  نَا  شَيْبَانُ ،  عَنْ  جَابِرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَجْلَسَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي حَجْرِهِ ، فَمَسَحَ رَأْسِي ، وَقَالَ :  اللَّهُمَّ عَلِّمْهُ الْحِكْمَةَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَابِرٍ  إِلَّا  شَيْبَانُ  ،  تَفَرَّدَ بِهِ  :  مِسْكِينُ بْنُ بُكَيْرٍ  ""  .  كذا في طبعة دار الحرمين ، وهو مكرر عند المصنف في أكثر من موضع ، قال الدكتور بشار عواد في حاشيته على « تهذيب الكمال » ( 16 / 457 ) ترجمة عبد الحميد بن محمد بن المستام بن حكيم بن عمرو: جاء في حواشي النسخ تعقيب للمؤلف على صاحب ""الكمال"" نصه: كان في الأصل: وأبو السائب محمد بن عبد الرحمن المخزومي الشيرازي إمام مسجد شيراز. وإنما هو (عبد الرحمن بن أحمد بن إسحاق المسيبي) كما ذكره الخطيب في تاريخه. أ.هـ والله أعلم .","","Al-Mu'jam al-Awsat 7702","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن مسكين بن بكير الحراني عن أحمد بن سليمان بن أبي شيبة عن عبد الرحمن بن أحمد بن محمد الشيرازي عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7709","7703  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  أَحْمَدُ بْنُ أَبِي شَيْبَةَ ،  نَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ - أَخُو أَبِي حُرَّةَ -  حَدَّثَنِي  أَبُو حُرَّةَ .         [7/352]      عَنْ  قَيْسِ بْنِ عَبَّادٍ قَالَ :  أَقَمْتُ الصَّلَاةَ مَعَ  عُمَرَ بْنِ الْخَطَّابِ  ، وَمَشْيَخَةُ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَعَهُ ، فَأَقْبَلَ رَجُلٌ قُدَّامَ الصَّفِّ يَنْظُرُ فِي وُجُوهِ  الْقَوْمِ  ، حَتَّى إِذَا كَانَ بِإِزَائِي دَحَانِي دَحْيَةً وَقَامَ فِي مَقَامِي ، فَلَمَّا سَلَّمَ  عُمَرُ  قَالَ  : "" سَاءَكَ مَا صَنَعْتُ بِكَ ؟ "" قُلْتُ : نَعَمْ قَالَ :  إِنَّا كُنَّا نُؤْمَرُ بِالصَّفِّ الْأَوَّلِ  ، فَنَظَرْتُ فِي وُجُوهِ  الْقَوْمِ  فَلَمْ أُنْكِرْ أَحَدًا غَيْرَكَ "" فَقُلْتُ : مَنْ هَذَا ؟ قَالُوا : أُبَيُّ بْنُ كَعْبٍ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدٍ أَخِي أَبِي حُرَّةَ  إِلَّا  زَيْدُ بْنُ الْحُبَابِ  ""  .","","Al-Mu'jam al-Awsat 7703","","أبي بن كعب عن قيس بن عباد الضبعي عن واصل بن عبد الرحمن البصري عن سعيد بن عبد الرحمن الرقاشي عن زيد بن الحباب العكلي عن أحمد بن سليمان بن أبي شيبة عن محمد بن عبد الرحمن عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7710","7704  - =  وَبِهِ  :  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ  ، حَدَّثَنِي  حُمَيْدٌ ، مَوْلَى عَلْقَمَةَ الْمَكِّيِّ ،  نَا  عَطَاءٌ  ، عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّ نَفَرًا مَرُّوا عَلَى  عِيسَى ابْنِ مَرْيَمَ  عَلَيْهِ السَّلَامُ ، فَقَالَ : يَمُوتُ أَحَدُ هَؤُلَاءِ الْيَوْمَ إِنْ شَاءَ اللهُ  ، فَمَضَوْا ثُمَّ رَجَعُوا عَلَيْهِ بِالْعَشِيِّ ، وَمَعَهُمْ حِزَمُ الْحَطَبِ ، فَقَالَ : ضَعُوا ، فَقَالَ لِلَّذِي قَالَ يَمُوتُ الْيَوْمَ : حِلَّ حَطَبَكَ ، فَحَلَّهُ ، فَإِذَا فِيهِ حَيَّةٌ سَوْدَاءُ ، فَقَالَ : مَا عَمِلْتَ الْيَوْمَ ؟ قَالَ : مَا عَمِلْتُ شَيْئًا ، قَالَ : انْظُرْ مَا عَمِلْتَ ، قَالَ : مَا عَمِلْتُ شَيْئًا ، إِلَّا أَنَّهُ كَانَ مَعِي فِي يَدِي فَلْقَةٌ مِنْ خُبْزٍ فَمَرَّ بِي مِسْكِينٌ ، فَسَأَلَنِي فَأَعْطَيْتُهُ بَعْضَهَا ، فَقَالَ : بِهَا دُفِعَ عَنْكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءٍ  إِلَّا  حُمَيْدٌ مَوْلَى عَلْقَمَةَ  ،  تَفَرَّدَ بِهِ  :  زَيْدُ بْنُ الْحُبَابِ  "" .","","Al-Mu'jam al-Awsat 7704","","أبو هريرة الدوسي عن عطاء بن أبي رباح عن حميد مولى ابن علقمة المكي عن زيد بن الحباب العكلي عن أحمد بن سليمان بن أبي شيبة عن محمد بن عبد الرحمن عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7711","7705  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ أَبُو السَّائِبِ  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ الْمُسْتَامِ الْحَرَّانِيُّ ،  نَا  عِصَامُ بْنُ سَيْفٍ الْحَرَّانِيُّ ،  عَنْ  أَبِي جَعْفَرٍ الرَّازِيِّ ،  عَنْ  قَتَادَةَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُصَلِّيَ أَحَدٌ  مُخْتَصِرًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  أَبُو جَعْفَرٍ الرَّازِيُّ  ، وَلَا عَنْ  أَبِي جَعْفَرٍ  إِلَّا  عِصَامُ بْنُ سَيْفٍ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الْحَمِيدِ بْنُ الْمُسْتَامِ  "" .  كذا في طبعة دار الحرمين ، وهو مكرر عند المصنف في أكثر من موضع ، قال الدكتور بشار عواد في حاشيته على « تهذيب الكمال » ( 16 / 457 ) ترجمة عبد الحميد بن محمد بن المستام بن حكيم بن عمرو: جاء في حواشي النسخ تعقيب للمؤلف على صاحب ""الكمال"" نصه: كان في الأصل: وأبو السائب محمد بن عبد الرحمن المخزومي الشيرازي إمام مسجد شيراز. وإنما هو (عبد الرحمن بن أحمد بن إسحاق المسيبي) كما ذكره الخطيب في تاريخه. أ.هـ والله أعلم .","","Al-Mu'jam al-Awsat 7705","","أبو هريرة الدوسي عن محمد بن سيرين عن قتادة بن دعامة عن عيسى بن أبي عيسى الرازي عن عصام بن سيف الحراني عن عبد الحميد بن محمد مولى حذيفة بن اليمان عن عبد الرحمن بن أحمد بن محمد الشيرازي عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7712","[7/353]      7706  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ أَبُو السَّائِبِ  ،  ثَنَا  أَحْمَدُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  وَحَدَّثَنِي  بَكْرُ بْنُ سَوَادَةَ أَبُو عُبَيْدَةَ النَّاجِيُّ ،  عَنِ  الْحَسَنِ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ،  أَنَّهُ سَلَّمَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَبُولُ ، فَلَمْ يَرُدَّ عَلَيْهِ السَّلَامَ  حَتَّى فَرَغَ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنِ  الْبَرَاءِ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  ابْنُ الْحُبَابِ  ""  .  كذا في طبعة دار الحرمين ، وهو مكرر عند المصنف في أكثر من موضع ، قال الدكتور بشار عواد في حاشيته على « تهذيب الكمال » ( 16 / 457 ) ترجمة عبد الحميد بن محمد بن المستام بن حكيم بن عمرو: جاء في حواشي النسخ تعقيب للمؤلف على صاحب ""الكمال"" نصه: كان في الأصل: وأبو السائب محمد بن عبد الرحمن المخزومي الشيرازي إمام مسجد شيراز. وإنما هو (عبد الرحمن بن أحمد بن إسحاق المسيبي) كما ذكره الخطيب في تاريخه. أ.هـ والله أعلم .","","Al-Mu'jam al-Awsat 7706","","البراء بن عازب الأوسي عن الحسن البصري عن بكر بن سوادة عن زيد بن الحباب العكلي عن أحمد بن سليمان بن أبي شيبة عن عبد الرحمن بن أحمد بن محمد الشيرازي عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7713","7707  - =  وَبِهِ  :  حَدَّثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  نَا  عَبْدُ الْوَاحِدِ بْنُ سَكَنِ بْنِ قَتَادَةَ أَبُو قَتَادَةَ الْحَنْظَلِيُّ ،  نَا  يَحْيَى بْنُ عَبَّادٍ الْحَنْظَلِيُّ  ،  أَنَّ وَفْدًا قَدِمُوا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَسَأَلَهُمْ فَكَذَبَهُ بَعْضُهُمْ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْلَا سَخَاءٌ فِيكَ  وَمَقَكُمُ  اللهُ عَلَيْهِ لَشَرَّدْتُ بِكَ وَافِدَ قَوْمٍ  .  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  زَيْدُ بْنُ الْحُبَابِ  ""  .  قال الهيثمي في المجمع ( 3 / 129 ) رواه الطبراني في الأوسط وكأن الصحابي سقط فإن الأصل سقيم وفيه جماعة لم أعرفهم.","","Al-Mu'jam al-Awsat 7707","","يحيى بن عباد الحنظلي عن عبد الواحد بن سكن بن قتادة أبو قتادة الحنظلي عن زيد بن الحباب العكلي عن أحمد بن سليمان بن أبي شيبة عن عبد الرحمن بن أحمد بن محمد الشيرازي عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7714","7708  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ الْمُسْتَامِ ،  ثَنَا  مَخْلَدُ بْنُ يَزِيدَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  أَبُو بَكْرٍ الْهُذَلِيُّ ،  عَنِ  الْحَسَنِ ،  عَنْ  رَافِعِ بْنِ يَزِيدَ الثَّقَفِيِّ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ الشَّيْطَانَ يُحِبُّ الْحُمْرَةَ ، فَإِيَّاكُمْ وَالْحُمْرَةَ  ، وَكُلَّ ذِي  ثَوْبِ  شُهْرَةٍ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  مَخْلَدُ بْنُ يَزِيدَ  "" .","","Al-Mu'jam al-Awsat 7708","","رافع بن يزيد الثقفي عن الحسن البصري عن أبو بكر الهذلي عن ابن جريج عن مخلد بن يزيد الحراني عن عبد الحميد بن محمد مولى حذيفة بن اليمان عن محمد بن عبد الرحمن عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7715","7709  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  نَا  سُلَيْمَانُ بْنُ سَيْفٍ الْحَرَّانِيُّ ،  ثَنَا  أَبُو عَتَّابٍ الدَّلَّالُ ،  نَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ - أَخُو أَبِي حُرَّةَ -  عَنْ  يَحْيَى بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّهُ كَانَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، هُوَ  وَأَبُو طَلْحَةَ  ،         [7/354]      وَصَفِيَّةُ  رَدِيفَةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَعَثَرَتْ بِهِ نَاقَتُهُ ، فَوَثَبَ  أَبُو طَلْحَةَ  ، فَقَالَ : ضُرِرْتَ ؟ قَالَ : "" لَا ، عَلَيْكَ بِالْمَرْأَةِ "" ، فَأَلْقَيْتُ عَلَى وَجْهِي ثَوْبِي ، فَأَلْقَيْتُهُ عَلَيْهَا ، فَلَمَّا كُنَّا  بِالْحَرَّةِ  أَوْ أَشْرَفْنَا عَلَى  الْمَدِينَةِ  ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  آيِبُونَ ، تَائِبُونَ ، عَابِدُونَ ، إِنْ شَاءَ اللهُ  ، لِرَبِّنَا حَامِدُونَ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدٍ ، - أَخِي أَبِي حُرَّةَ  - إِلَّا  أَبُو عَتَّابٍ الدَّلَّالُ  "" .","","Al-Mu'jam al-Awsat 7709","","أنس بن مالك عن يحيى بن أبي إسحاق الحضرمي عن سعيد بن عبد الرحمن الرقاشي عن سهل بن حماد الدلال عن سليمان بن سيف الطائي عن محمد بن عبد الرحمن عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7716","7710  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  نَا  عَلِيُّ بْنُ غَزْوَانَ الْحَرَّانِيُّ ،  نَا  عَبْدُ الْعَظِيمِ بْنُ رَغْبَانَ الْحِمْصِيُّ ،  ثَنَا  أَبُو مَعْشَرٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَعَلَيْهِ الْجُمُعَةُ  ، إِلَّا عَبْدًا أَوِ امْرَأَةً أَوْ صَبِيًّا ، وَمَنِ  اسْتَغْنَى  بِلَهْوٍ  أَوْ تِجَارَةٍ  اسْتَغْنَى  اللهُ عَنْهُ ، وَاللهُ غَنِيٌّ حَمِيدٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدٍ الْمَقْبُرِيِّ  إِلَّا  أَبُو مَعْشَرٍ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الْعَظِيمِ بْنُ حَبِيبٍ  "" .","","Al-Mu'jam al-Awsat 7710","","أبو هريرة الدوسي عن سعيد المقبري عن نجيح بن عبد الرحمن السندي عن ابن رغبان عبد العظيم بن حبيب الفهري عن علي بن غزوان الحراني عن محمد بن عبد الرحمن عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7717","7711  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ أَبُو السَّائِبِ الْمَخْزُومِيُّ  ،  ثَنَا  عَلِيُّ بْنُ غَزْوَانَ الْحَرَّانِيُّ ،  نَا  عَبْدُ الْعَظِيمِ بْنُ حَبِيبٍ ،  ثَنَا  أَبُو مَعْشَرٍ  ، عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ تَوَاضَعَ لِأَخِيهِ الْمُسْلِمِ رَفَعَهُ اللهُ ،  وَمَنِ ارْتَفَعَ عَلَيْهِ وَضَعَهُ اللهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدٍ الْمَقْبُرِيِّ  إِلَّا  أَبُو مَعْشَرٍ ،  تَفَرَّدَ بِهِ  :  عَبْدُ الْعَظِيمِ  ""  .  كذا في طبعة دار الحرمين ، وهو مكرر عند المصنف في أكثر من موضع ، قال الدكتور بشار عواد في حاشيته على « تهذيب الكمال » ( 16 / 457 ) ترجمة عبد الحميد بن محمد بن المستام بن حكيم بن عمرو: جاء في حواشي النسخ تعقيب للمؤلف على صاحب ""الكمال"" نصه: كان في الأصل: وأبو السائب محمد بن عبد الرحمن المخزومي الشيرازي إمام مسجد شيراز. وإنما هو (عبد الرحمن بن أحمد بن إسحاق المسيبي) كما ذكره الخطيب في تاريخه. أ.هـ والله أعلم .","","Al-Mu'jam al-Awsat 7711","","أبو هريرة الدوسي عن سعيد المقبري عن نجيح بن عبد الرحمن السندي عن ابن رغبان عبد العظيم بن حبيب الفهري عن علي بن غزوان الحراني عن عبد الرحمن بن أحمد بن محمد الشيرازي عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7718","7712  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ أَبُو السَّائِبِ  ،  نَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ كَثِيرٍ الْحَرَّانِيُّ ،  نَا  مُحَمَّدُ بْنُ مُوسَى بْنِ أَعْيَنَ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  عَنْ  أَبِي بَكْرٍ الصِّدِّيقِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا نُورَثُ ، مَا تَرَكْنَا صَدَقَةٌ  ، إِنَّمَا يَأْكُلُ  آلُ مُحَمَّدٍ  مِنْ هَذَا الْمَالِ  .  كذا في طبعة دار الحرمين ، وهو مكرر عند المصنف في أكثر من موضع ، قال الدكتور بشار عواد في حاشيته على « تهذيب الكمال » ( 16 / 457 ) ترجمة عبد الحميد بن محمد بن المستام بن حكيم بن عمرو: جاء في حواشي النسخ تعقيب للمؤلف على صاحب ""الكمال"" نصه: كان في الأصل: وأبو السائب محمد بن عبد الرحمن المخزومي الشيرازي إمام مسجد شيراز. وإنما هو (عبد الرحمن بن أحمد بن إسحاق المسيبي) كما ذكره الخطيب في تاريخه. أ.هـ والله أعلم .","","Al-Mu'jam al-Awsat 7712","","أبو  بكر الصديق عن عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن إسحاق بن راشد الجزري عن موسى بن أعين الجزري عن محمد بن موسى بن أعين الجزري عن محمد بن يحيى بن محمد الحراني عن عبد الرحمن بن أحمد بن محمد الشيرازي عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7719","[7/355]      7713  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  نَا  مُحَمَّدُ بْنُ يَحْيَى ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى ،  حَدَّثَنِي  أَبِي  ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ  ، عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ ،  أَنَّ  عُمَرَ  قَالَ :  إِنْ لَا أَسْتَخْلِفْ فَإِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمْ يَسْتَخْلِفْ  ، وَإِنْ أَسْتَخْلِفْ فَقَدِ اسْتَخْلَفَ  أَبُو بَكْرٍ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ  إِلَّا  مُوسَى بْنُ أَعْيَنَ  ،  تَفَرَّدَ بِهِمَا  :  مُحَمَّدُ بْنُ مُوسَى  ""  .","","Al-Mu'jam al-Awsat 7713","","عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إسحاق بن راشد الجزري عن موسى بن أعين الجزري عن محمد بن موسى بن أعين الجزري عن محمد بن يحيى بن محمد الحراني عن محمد بن عبد الرحمن عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7720","7714  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  سُلَيْمَانُ بْنُ سَيْفٍ أَبُو دَاوُدَ الْحَرَّانِيُّ ،  نَا  مُعَاذُ بْنُ هَانِئٍ ،  ثَنَا  سَعِيدُ بْنُ زَيْدٍ ،  ثَنَا  عُمَرُ بْنُ مُصْعَبِ بْنِ الزُّبَيْرِ ،  نَا  عُرْوَةُ بْنُ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُوتِرُ بِخَمْسٍ  ، لَا يَقْعُدُ بَيْنَهُنَّ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَرَ بْنِ مُصْعَبٍ  إِلَّا  سَعِيدُ بْنُ زَيْدٍ  ،  تَفَرَّدَ بِهِ  :  مُعَاذُ بْنُ هَانِئٍ  ""  .","","Al-Mu'jam al-Awsat 7714","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عمر بن مصعب بن الزبير عن سعيد بن زيد الجهضمي عن معاذ بن هانئ القناد عن سليمان بن سيف الطائي عن محمد بن عبد الرحمن عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7721","7715  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  نَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ كَثِيرٍ ،  نَا  حَبِيبُ بْنُ فَرُّوخَ الْحَدَثِيُّ  ، عَنْ  مُبَارَكِ بْنِ فَضَالَةَ  ، عَنِ  الْحَسَنِ  ، عَنْ  أَبِي بَكْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقُومُ السَّاعَةُ حَتَّى يَسُودَ كُلَّ قَوْمٍ مُنَافِقُوهُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُبَارَكٍ  إِلَّا  حَبِيبُ بْنُ فَرُّوخَ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ يَحْيَى بْنِ كَثِيرٍ  ""  .","","Al-Mu'jam al-Awsat 7715","","أبو بكرة الثقفي عن الحسن البصري عن مبارك بن فضالة عن حبيب بن فروخ الحدثي عن محمد بن يحيى بن محمد الحراني عن محمد بن عبد الرحمن عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7722","7716  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ،  نَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ كَثِيرٍ الْحَرَّانِيُّ ،         [7/356]      نَا  عَلِيُّ بْنُ عَبْدِ الْحَمِيدِ الْمَعْنِيُّ ،  نَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  عَمْرِو بْنِ وَهْبٍ ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا أَرَادَ الْحَاجَةَ  أَبْعَدَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ سِيرِينَ  إِلَّا  جَرِيرُ بْنُ حَازِمٍ  ،  تَفَرَّدَ بِهِ  :  عَلِيُّ بْنُ عَبْدِ الْحَمِيدِ  "" .","","Al-Mu'jam al-Awsat 7716","","المغيرة بن شعبة عن عمرو بن وهب الثقفي عن محمد بن سيرين عن جرير بن حازم عن علي بن عبد الحميد الشيباني عن محمد بن يحيى بن محمد الحراني عن محمد بن عبد الرحمن عن الطبراني","محمد بن عبد الرحمن أبو السائب المخزومي"
"7723","7717  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ السَّكَنِ الْوَاسِطِيُّ ،  نَا  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ بْنِ زُرَارَةَ الرَّقِّيُّ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الرَّحْمَنِ الْبَالِسِيُّ ،  عَنْ  خُصَيْفٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ قَالَ قَبْلَ صَلَاةِ الْغَدَاةِ يَوْمَ الْجُمُعَةِ ثَلَاثَ مِرَارٍ : أَسْتَغْفِرُ اللهَ الَّذِي لَا إِلَهَ إِلَّا هُوَ وَأَتُوبُ إِلَيْهِ  ، غُفِرَتْ ذُنُوبُهُ وَإِنْ كَانَتْ أَكْثَرَ مِنْ زَبَدِ الْبَحْرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خُصَيْفٍ  إِلَّا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الرَّحْمَنِ  ""  .","","Al-Mu'jam al-Awsat 7717","","أنس بن مالك عن خصيف الجزري عن عبد العزيز بن عبد الرحمن الجزري عن إسماعيل بن عبد الله بن زرارة الثغري عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7724","7718  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ السَّكَنِ ،  ثَنَا  أَبُو مَعْمَرٍ الْمُقْعَدُ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  عُمَارَةَ بْنِ عُمَيْرٍ ،  عَنِ  الرَّبِيعِ بْنِ عَمِيلَةَ الْفَزَارِيِّ ،  عَنْ  سَمُرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَحَبُّ الْكَلَامِ إِلَى اللهِ أَرْبَعَةٌ  : سُبْحَانَ اللهِ ، وَالْحَمْدُ لِلهِ ، وَلَا إِلَهَ إِلَّا اللهُ ، وَاللهُ أَكْبَرُ ، لَا يَضُرُّكَ بِأَيِّهِنَّ بَدَأْتَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ  إِلَّا  عَبْدُ الْوَارِثِ  "" .","","Al-Mu'jam al-Awsat 7718","","سمرة بن جندب عن الربيع بن عميلة الفزاري عن عمارة بن عمير التيمي عن منصور بن المعتمر عن محمد بن جحادة الأودي عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7725","7719  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ السَّكَنِ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ الْجَبُّلِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى بْنُ أَبِي الْمُسَاوِرِ ،  عَنْ  حَمَّادٍ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  نُهِينَا أَنْ نُتْبِعَ أَبْصَارَنَا الْكَوْكَبَ إِذَا انْقَضَّ  ، وَأُمِرْنَا أَنْ نَقُولَ عِنْدَ ذَلِكَ : مَا شَاءَ اللهُ ، لَا قُوَّةَ إِلَّا بِاللهِ  "" .         [7/357]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حَمَّادٍ  إِلَّا  عَبْدُ الْأَعْلَى بْنُ أَبِي الْمُسَاوِرِ  ،  تَفَرَّدَ بِهِ  :  مُوسَى بْنُ إِسْمَاعِيلَ الْجَبُّلِيُّ  ""  .","","Al-Mu'jam al-Awsat 7719","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن حماد بن أبي سليمان عن عبد الأعلى بن أبي المساور الجرار عن موسى بن إسماعيل الجبلي عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7726","7720  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ السَّكَنِ ،  نَا  مُوسَى بْنُ إِسْمَاعِيلَ الْمِنْقَرِيُّ ،  نَا  جَرِيرُ بْنُ حَازِمٍ ،  حَدَّثَنِي  عَمِّي جَرِيرُ بْنُ زَيْدٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ بْنِ عُمَرَ قَالَ :  سَمِعْتُ  أَبَا هُرَيْرَةَ ، يُحَدِّثُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَيْنَمَا رَجُلٌ يَمْشِي بَيْنَ بُرْدَيْنِ ، مُعْجَبٌ بِنَفْسِهِ ، إِذْ خَسَفَ اللهُ بِهِ الْأَرْضَ  ، فَهُوَ  يَتَجَلْجَلُ  فِيهَا إِلَى يَوْمِ الْقِيَامَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَالِمٍ  إِلَّا  جَرِيرُ بْنُ زَيْدٍ  ،  تَفَرَّدَ بِهِ  :  جَرِيرُ بْنُ حَازِمٍ  "" .","","Al-Mu'jam al-Awsat 7720","","أبو هريرة الدوسي عن سالم بن عبد الله بن عمر بن الخطاب عن جرير بن زيد بن عبد الله بن شجاع الأزدي عن جرير بن حازم عن موسى بن إسماعيل التبوذكي عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7727","7721  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ السَّكَنِ ،  نَا  عُبَيْدُ اللهِ بْنُ مُحَمَّدٍ ابْنُ عَائِشَةَ التَّيْمِيُّ ،  نَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  أَبُو فَرْوَةَ مُسْلِمُ بْنُ سَالِمٍ قَالَ :  سَمِعْتُ  عَبْدَ الرَّحْمَنِ بْنَ أَبِي لَيْلَى ، يَقُولُ :  سَمِعْتُ  عُمَرَ ، يَقُولُ :  أَقْضَانَا  عَلِيٌّ  ،  وَأُبَيٌّ  أَقْرَؤُنَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي فَرْوَةَ  إِلَّا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ  "" .","","Al-Mu'jam al-Awsat 7721","","عمر بن الخطاب عن عبد الرحمن بن أبي ليلى عن مسلم بن سالم الجهني عن عبد الواحد بن زياد عن ابن عائشة عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7728","7722  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ السَّكَنِ ،  ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  عَنِ  ابْنِ أَبِي فُدَيْكٍ ،  عَنِ  الضَّحَّاكِ بْنِ عُثْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ  مَحَاشِّ  النِّسَاءِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الضَّحَّاكِ بْنِ عُثْمَانَ  إِلَّا  ابْنُ أَبِي فُدَيْكٍ  ،  تَفَرَّدَ بِهِ  :  عَلِيُّ بْنُ بَحْرٍ  ""  .","","Al-Mu'jam al-Awsat 7722","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن الضحاك بن عثمان الحزامي عن محمد بن إسماعيل بن مسلم الديلي عن علي بن بحر بن بري القطان عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7729","[7/358]      7723  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى ،  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  نَا  أَبِي  ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  أَبِي الزُّبَيْرِ  ، عَنْ  جَابِرٍ قَالَ :  أَقَمْنَا  بِالْمَدِينَةِ  سَنَتَيْنِ قَبْلَ أَنْ يَقْدَمَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، نُقِيمُ الصَّلَاةَ  ، وَنَعْمُرُ الْمَسَاجِدَ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الزُّبَيْرِ  إِلَّا  ابْنُ أَبِي لَيْلَى  "" .","","Al-Mu'jam al-Awsat 7723","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عيسى بن شيبة السدوسي عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7730","7724  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى ،  نَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  عَلِيٍّ ،  أَنَّ رَسُولَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أُهْدِيَ لَهُ لَحْمُ صَيْدٍ وَهُوَ مُحْرِمٌ ، فَرَدَّهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  هَمَّامٌ  ""  .","","Al-Mu'jam al-Awsat 7724","","علي بن أبي طالب عن عبد الله بن الحارث بن نوفل عن قتادة بن دعامة عن همام بن يحيى بن دينار عن موسى بن إسماعيل التبوذكي عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7731","7725  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ السَّكَنِ ،  نَا  مُوسَى بْنُ إِسْمَاعِيلَ الْجَبُّلِيُّ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  مُجَاهِدٍ  ، عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  أَبِي قَتَادَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تُكْرَهُ الصَّلَاةُ فِي نِصْفِ النَّهَارِ  ، إِلَّا يَوْمَ الْجُمُعَةِ ، فَإِنَّ  جَهَنَّمَ  لَا  تُسْجَرُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي قَتَادَةَ  إِلَّا  أَبُو الْخَلِيلِ  "" .","","Al-Mu'jam al-Awsat 7725","","أبو قتادة الأنصاري فارس رسول الله عن صالح بن أبي مريم الضبعي عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن حسان بن إبراهيم الكرماني عن موسى بن إسماعيل التبوذكي عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7732","7726  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ السَّكَنِ ،  ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ الْجَبُّلِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  خَارِجَةَ بْنِ مُصْعَبٍ ،  عَنْ  عُثْمَانَ بْنِ سَعْدٍ الْكَاتِبِ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا عَلَى أَحَدِكُمْ إِذَا  تَصَدَّقَ  بِصَدَقَةٍ تَطَوُّعًا أَنْ يَجْعَلَهَا عَنْ أَبَوَيْهِ  ، فَيَكُونَ لَهُمَا أَجْرُهَا ، وَلَا يُنْقَصُ مِنْ أَجْرِهِ شَيْءٌ  .         [7/359]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُثْمَانَ بْنِ سَعْدٍ  إِلَّا  خَارِجَةُ بْنُ مُصْعَبٍ  "" .","","Al-Mu'jam al-Awsat 7726","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن عثمان بن سعد التميمي عن خارجة الضبعي عن الوليد بن مسلم القرشي عن موسى بن إسماعيل الجبلي عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7733","7727  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ السَّكَنِ ،  نَا  مُحَمَّدُ بْنُ سِنَانٍ ،  نَا  سَلِيمُ بْنُ حَيَّانَ ،  عَنْ  سَعِيدِ بْنِ مِينَاءَ ،  عَنْ  جَابِرٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى عَلَى  النَّجَاشِيِّ  ، وَكَبَّرَ عَلَيْهِ أَرْبَعًا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدِ بْنِ مِينَاءَ  إِلَّا  سَلِيمُ بْنُ حَيَّانَ  "" .","","Al-Mu'jam al-Awsat 7727","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن سعيد بن مينا الحجازي عن سليم بن حيان بن بسطام الهذلي عن محمد بن سنان الباهلي عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7734","7728  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى ،  نَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  يَحْيَى بْنِ وَثَّابٍ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ -  رَفَعَ  الْحَدِيثَ - قَالَ :  إِنَّ السَّيِّئَ لَا يُكَفِّرُ السَّيِّئَ  ، وَلَكِنَّ الطَّيِّبَ يُكَفِّرُ السَّيِّئَ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي حَصِينٍ  إِلَّا  قَيْسٌ  "" .","","Al-Mu'jam al-Awsat 7728","","عبد الله بن مسعود عن مسروق بن الأجدع عن يحيى بن وثاب الأصبهاني عن عثمان بن عاصم بن حصين عن قيس بن الربيع الأسدي عن عاصم بن علي الواسطي عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7735","7729  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى ،  نَا  الْحَارِثُ بْنُ مَنْصُورٍ ،  نَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَطَبَ ، فَقَالَ فِي خُطْبَتِهِ :  إِنَّ الْحَلَالَ بَيِّنٌ ، وَالْحَرَامَ بَيِّنٌ  ، وَبَيْنَهُمَا أُمُورٌ مُشْتَبِهَةٌ ، وَإِنَّهُ مَنْ يَرْعَ حَوْلَ الْحِمَى  يُوشِكْ  أَنْ يُخَالِطَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سِمَاكٍ  إِلَّا  إِسْرَائِيلُ  "" .","","Al-Mu'jam al-Awsat 7729","","النعمان بن بشير الأنصاري عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن الحارث بن منصور الواسطي عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7736","7730  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ السَّكَنِ ،  نَا  الْحَارِثُ بْنُ مَنْصُورٍ ،  نَا  سُفْيَانُ الثَّوْرِيُّ  ، عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي حُمَيْدٍ السَّاعِدِيِّ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ اسْتَعْمَلَ رَجُلًا مِنَ  الْأَنْصَارِ  - يُقَالُ لَهُ :  ابْنُ اللُّتْبِيَّةِ  - عَلَى الصَّدَقَةِ ، فَلَمَّا قَدِمَ بَعَثَ إِلَيْهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِيُحَاسِبَهُ ، فَقَالَ : هَذَا لَكُمْ وَهَذَا أُهْدِيَ إِلَيَّ ، فَبَلَغَ ذَلِكَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّا نَسْتَعْمِلُ مِنْكُمْ رِجَالًا عَلَى مَا وَلَّانَا اللهُ  ، فَإِذَا قَدِمَ أَحَدُهُمْ         [7/360]      قَالَ : هَذَا لَكُمْ وَهَذَا أُهْدِيَ إِلَيَّ ، فَهَلَّا جَلَسَ فِي بَيْتِ أَبِيهِ وَأُمِّهِ فَيَنْظُرُ مَا يُهْدَى إِلَيْهِ ، مَنْ عَمِلَ لَنَا مِنْكُمْ فَلْيَأْتِنَا بِقَلِيلِهِ وَكَثِيرِهِ ، وَلِيَحْذَرْ أَحَدُكُمْ أَنْ يَأْتِيَ يَوْمَ الْقِيَامَةِ بِبَعِيرٍ يَحْمِلُهُ عَلَى رَقَبَتِهِ لَهُ  رُغَاءٌ ،  أَوْ بَقَرَةٍ لَهَا  خُوَارٌ ،  أَوْ شَاةٍ تَيْعَرُ "" - أَوْ قَالَ - : "" لَهَا  يُعَارٌ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُفْيَانَ  إِلَّا  الْحَارِثُ بْنُ مَنْصُورٍ  ""  .","","Al-Mu'jam al-Awsat 7730","","أبو حميد الساعدي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن سفيان الثوري عن الحارث بن منصور الواسطي عن محمد بن عيسى ابن أبي قماش عن الطبراني","محمد بن عيسى بن السكن الواسطي"
"7737","7731  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ الْخَطِيبُ الْأَهْوَازِيُّ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ ،  نَا  أَبُو عِمْرَانَ الْحَرَّانِيُّ يُوسُفُ بْنُ يَعْقُوبَ ،  نَا  ابْنُ جُرَيْجٍ  ، عَنْ  عَطَاءٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ  خُزَيْمَةَ بْنَ ثَابِتٍ  - وَلَيْسَ بِالْأَنْصَارِيِّ - كَانَ فِي  عِيرٍ  لِخَدِيجَةَ  ، وَأَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ مَعَهُ فِي تِلْكَ  الْعِيرِ  ، فَقَالَ لَهُ : يَا  مُحَمَّدُ  ، إِنِّي أَرَى فِيكَ خِصَالًا ، وَأَشْهَدُ أَنَّكَ النَّبِيَّ الَّذِي يَخْرُجُ مِنْ  تِهَامَةَ  ، وَقَدْ آمَنْتُ بِكَ ، فَإِذَا سَمِعْتُ بِخُرُوجِكَ أَتَيْتُكَ ، فَأَبْطَأَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى كَانَ يَوْمُ  فَتْحِ مَكَّةَ  ، ثُمَّ أَتَاهُ ، فَلَمَّا رَآهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَرْحَبًا بِالْمُهَاجِرِ الْأَوَّلِ  قَالَ : يَا رَسُولَ اللهِ ، مَا مَنَعَنِي أَنْ أَكُونَ مِنْ أَوَّلِ مَنْ أَتَاكَ ، وَأَنَا مُؤْمِنٌ بِكَ غَيْرُ مُنْكِرٍ لِبَيْعَتِكَ ، وَلَا  نَاكِثٍ  لِعَهْدِكَ ، وَآمَنْتُ بِالْقُرْآنِ ، وَكَفَرْتُ بِالْوَثَنِ ، إِلَّا أَنَّهُ أَصَابَتْنَا بَعْدَكَ سَنَوَاتٌ شِدَادٌ مُتَوَالِيَاتٌ ، تَرَكَتِ الْمُخَّ  رِزَامًا  وَالْمَطِيَّ  هَامًا  ،  غَاضَتْ  لَهَا  الدَّرَّةُ ،  وَنَبَعَتْ لَهَا  التَّرَةُ  ، وَعَادَ لَهَا  النِّقَادُ  مُتَجَرْثِمًا وَالْقَنِطَةُ أَوِ  الْعِضَاهُ  مُسْتَحْلِفًا ،  وَالْوَشِيجُ  مُسْتَحْنِكًا  ، يَبِسَتْ بِأَرْضِ  الْوَدِيسِ  ، وَاجْتَاحَتِ جَمِيعَ الْيَبِيسِ وَأَفْنَتْ أُصُولَ  الْوَشِيجِ  ، حَتَّى قُطَّتِ  الْقَنِطَةُ  ، أَتَيْتُكَ غَيْرَ  نَاكِثٍ  لِعَهْدِي ، وَلَا مُنْكِرٍ لِبَيْعَتِي .         [7/361]      فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" خُذْ عَنْكَ ، إِنَّ اللهَ تَبَارَكَ وَتَعَالَى بَاسِطٌ يَدَهُ بِاللَّيْلِ لِمُسِيءِ النَّهَارِ لِيَتُوبَ ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، وَبَاسِطٌ يَدَهُ بِالنَّهَارِ لِمُسِيءِ اللَّيْلِ لِيَتُوبَ ، فَإِنْ تَابَ تَابَ اللهُ عَلَيْهِ ، وَإِنَّ الْحَقَّ ثَقِيلٌ كَثِقَلِهِ يَوْمَ الْقِيَامَةِ ، وَإِنَّ الْبَاطِلَ خَفِيفٌ كَخِفَّتِهِ يَوْمَ الْقِيَامَةِ ، وَإِنَّ الْجَنَّةَ مَحْظُورٌ عَلَيْهَا بِالْمَكَارِهِ ، وَإِنَّ النَّارَ مَحْظُورٌ عَلَيْهَا بِالشَّهَوَاتِ .  فَقَالَ : يَا رَسُولَ اللهِ ، أَخْبِرْنِي عَنْ ضَوْءِ النَّهَارِ ، وَعَنْ ظُلْمَةِ اللَّيْلِ ، وَعَنْ حَرِّ الْمَاءِ فِي الشِّتَاءِ ، وَعَنْ بَرْدِهِ فِي الصَّيْفِ ، وَعَنِ الْبَلَدِ الْأَمِينِ ، وَعَنْ مَنْشَأِ السَّحَابِ ، وَعَنْ مَخْرَجِ الْجَرَادِ ، وَعَنِ الرَّعْدِ وَالْبَرْقِ ، وَعَمَّا لِلْوَلَدِ مِنَ الرَّجُلِ ، وَمَا لِلْمَرْأَةِ .  فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَمَّا ظُلْمَةُ اللَّيْلِ ، وَضَوْءُ النَّهَارِ : فَإِنَّ الشَّمْسَ إِذَا سَقَطَتْ سَقَطَتْ تَحْتَ الْأَرْضِ ، فَأَظْلَمَ اللَّيْلُ لِذَلِكَ ، وَإِذَا أَضَاءَ الصُّبْحُ ابْتَدَرَهَا سَبْعُونَ أَلْفَ مَلَكٍ ، وَهِيَ  تَقَاعَسُ  كَرَاهَةَ أَنْ تُعْبَدَ مِنْ دُونِ اللهِ ، حَتَّى تَطْلُعَ فَتُضِيءَ ، فَبِطُولِ اللَّيْلِ يَطُولُ مُكْثُهَا ، فَيَسْخُنَ الْمَاءُ لِذَلِكَ ، وَإِذَا كَانَ الصَّيْفُ قَلَّ مُكْثُهَا فَبَرَدَ الْمَاءُ لِذَلِكَ . وَأَمَّا الْجَرَادُ : فَإِنَّهُ  نَثْرَةُ  حُوتٍ فِي الْبَحْرِ ، يُقَالُ لَهُ : الْإِيوَانُ ، وَفِيهِ يَهْلَكُ ، وَأَمَّا مَنْشَأُ السَّحَابِ : فَإِنَّهُ يَنْشَأُ مِنْ  قِبَلِ  الْخَافِقَيْنِ  - أَوْ مِنْ بَيْنِ  الْخَافِقَيْنِ  - تُلْحِمُهُ الصَّبَا وَالْجَنُوبُ وَتُسْدِيهِ الشَّمَالُ  وَالدَّبُورُ  . وَأَمَّا الرَّعْدُ : فَإِنَّهُ مَلَكٌ بِيَدِهِ مِخْرَاقٌ يُدْنِي  الْقَاصِيَةَ  وَيُؤَخِّرُ الدَّانِيَةَ ، وَإِذَا رَفَعَ بَرَقَتْ ، وَإِذَا  زَجَرَ  رَعَدَتْ ، وَإِذَا ضَرَبَ  صَعِقَتْ  . وَأَمَّا مَا لِلرَّجُلِ مِنَ الْوَلَدِ ، وَمَا لِلْمَرْأَةِ : فَإِنَّ لِلرَّجُلِ الْعِظَامَ ، وَالْعُرُوقَ ، وَالْعَصَبَ ، وَلِلْمَرْأَةِ اللَّحْمَ ، وَالدَّمَ ، وَالشَّعْرَ ، وَأَمَّا الْبَلَدُ الْأَمِينُ :  فَمَكَّةُ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو عِمْرَانَ الْحَرَّانِيُّ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ  ""  .","","Al-Mu'jam al-Awsat 7731","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن ابن جريج عن يوسف بن يعقوب الحراني عن محمد بن عبد الرحمن السلمي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7738","7732  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ الْخَطِيبُ ،  ثَنَا  عِيسَى بْنُ أَبِي حَرْبٍ الصَّفَّارُ ،         [7/362]      نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ الْكَرْمَانِيُّ ،  نَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  حَدَّثَنِي  بُدَيْلُ بْنُ مَيْسَرَةَ الْعُقَيْلِيُّ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمٍ ،  عَنْ  صَفِيَّةَ بِنْتِ شَيْبَةَ ،  عَنْ  أُمِّ عُثْمَانَ ،  عَنْ  أُمِّ سَلَمَةَ - زَوْجِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ :  الْمُتَوَفَّى عَنْهَا زَوْجُهَا لَا تَلْبَسُ الْمُعَصْفَرَ مِنَ الثِّيَابِ  ، وَلَا  الْمُمَشَّقَ  ، وَلَا الْحُلِيَّ ، وَلَا تَخْتَضِبُ ، وَلَا تَكْتَحِلُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بُدَيْلٍ الْعُقَيْلِيِّ  إِلَّا  إِبْرَاهِيمُ بْنُ طَهْمَانَ  ""  .","","Al-Mu'jam al-Awsat 7732","","هند بنت أبي أمية زوج رسول الله عن أم عثمان بنت سفيان عن صفية بنت شيبة الحجبية عن الحسن بن مسلم بن يناق عن بديل بن ميسرة العقيلي عن إبراهيم بن طهمان عن يحيى بن أبي بكير عن عيسى بن موسى بن أبي حرب الصفار عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7739","7733  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ الْخَطِيبُ ،  نَا  عِيسَى بْنُ أَبِي حَرْبٍ ،  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ الْكَرْمَانِيُّ ،  نَا  عُمَرُ بْنُ أَبِي زَائِدَةَ ،  نَا  زَكَرِيَّا ، وَعَبْدُ اللهِ بْنُ أَبِي السَّفَرِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ  ، وَالْمُهَاجِرُ مَنْ هَجَرَ مَا نَهَى اللهُ عَنْهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَرَ بْنِ أَبِي زَائِدَةَ  إِلَّا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  "" .","","Al-Mu'jam al-Awsat 7733","","عبد الله بن عمرو بن العاص عن الشعبي عن زكريا بن أبي زائدة الوادعي عن عمر بن أبي زائدة الهمداني عن يحيى بن أبي بكير عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7740","7734  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ الْخَطِيبُ ،  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ أَبُو يُوسُفَ الْقُلُوسِيُّ ،  ثَنَا  الصَّلْتُ بْنُ مُحَمَّدٍ أَبُو هَمَّامٍ الْخَارَكِيُّ ،  نَا  مَنْصُورُ بْنُ سَعْدٍ ،  عَنْ  عُثْمَانَ بْنِ عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَعَنَ اللهُ قَوْمًا اتَّخَذُوا  قُبُورَ  أَنْبِيَائِهِمْ مَسَاجِدَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُثْمَانَ بْنِ عُرْوَةَ  إِلَّا  مَنْصُورُ بْنُ سَعْدٍ  ،  تَفَرَّدَ بِهِ  :  أَبُو هَمَّامٍ الْخَارَكِيُّ  ""  .","","Al-Mu'jam al-Awsat 7734","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عثمان بن عروة بن الزبير بن العوام عن منصور بن سعد اللؤلؤي عن الصلت بن محمد الخاركي عن يعقوب بن إسحاق القلوسي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7741","7735  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  ثَنَا  مُعَلَّى بْنُ رَاشِدٍ  الْعَمِّيُّ ،  نَا  عَبْدُ اللهِ بْنُ الْمُثَنَّى ،  حَدَّثَنِي  ثَابِتٌ الْبُنَانِيُّ ، وَثُمَامَةُ  ، عَنْ  أَنَسٍ قَالَ :  مَاتَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلَمْ يَجْمَعِ الْقُرْآنَ غَيْرُ أَرْبَعَةٍ  :  أَبُو الدَّرْدَاءِ  ،  وَمُعَاذٌ  ،  وَأَبُو زَيْدٍ  ،  وَزَيْدُ بْنُ ثَابِتٍ  "" .         [7/363]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  ثُمَامَةَ  إِلَّا  عَبْدُ اللهِ بْنُ الْمُثَنَّى  ، وَلَا عَنْ  عَبْدِ اللهِ  إِلَّا  مُعَلَّى بْنُ رَاشِدٍ  ،  تَفَرَّدَ بِهِ  :  أَبُو يُوسُفَ  ""  .  كذا في طبعة دار الحرمين ، ولعل الصواب (أسد).","","Al-Mu'jam al-Awsat 7735","","أنس بن مالك عن ثمامة بن عبد الله بن أنس بن مالك عن عبد الله بن المثنى عن معلى بن أسد عن يعقوب بن إسحاق القلوسي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7742","7736  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  الْحَسَنُ بْنُ عَنْبَسَةَ الْوَرَّاقُ ،  نَا  عَلِيُّ بْنُ غُرَابٍ ،  نَا  عُمَرُ بْنُ عَبْدِ اللهِ بْنِ يَعْلَى بْنِ مُرَّةَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ مِنْكُمْ مُصَلِّيًا يَوْمَ الْجُمُعَةِ فَلْيُصَلِّ أَرْبَعًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الْأَحْوَصِ  إِلَّا  عُمَرُ بْنُ عَبْدِ اللهِ  ، وَلَا عَنْ  عُمَرَ  إِلَّا  عَلِيُّ بْنُ غُرَابٍ  ، وَلَا عَنْ  عَلِيٍّ  إِلَّا  الْحَسَنُ  ،  تَفَرَّدَ بِهِ  :  أَبُو يُوسُفَ  ""  .","","Al-Mu'jam al-Awsat 7736","","أبو هريرة الدوسي عن عوف بن مالك بن نضلة الجشمي عن عمر بن عبد الله بن يعلى الثقفي عن علي بن عبد العزيز الفزاري عن الحسن بن عنبسة الوراق عن يعقوب بن إسحاق القلوسي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7743","7737  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  عَلِيُّ بْنُ حُمَيْدٍ الدَّهَكِيُّ ،  نَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ ، خَتَنُ أَبِي الْمُعَلَّى الْعَطَّارِ ،  عَنْ  أَبِي الْمُعَلَّى - وَاسْمُهُ : يَحْيَى بْنُ مَيْمُونٍ - ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ .         [7/364]      عَنِ  ابْنِ عَبَّاسٍ قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ :  عَلِّمْنِي - أَوْ دُلَّنِي  - عَلَى عَمَلٍ يُدْخِلُنِي الْجَنَّةَ قَالَ :  كُنْ مُؤَذِّنًا  قَالَ : لَا أَسْتَطِيعُ ، قَالَ : "" كُنْ إِمَامًا "" قَالَ : لَا أَسْتَطِيعُ ، قَالَ : "" فَقُمْ بِإِزَاءِ الْإِمَامِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  إِلَّا  أَبُو الْمُعَلَّى  ، وَلَا عَنْ  أَبِي الْمُعَلَّى  إِلَّا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ  ،  تَفَرَّدَ بِهِ  :  عَلِيُّ بْنُ حُمَيْدٍ  "" .","","Al-Mu'jam al-Awsat 7737","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن يحيى بن ميمون العطار عن محمد بن إسماعيل البصري عن علي بن حميد الدهكي عن يعقوب بن إسحاق القلوسي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7744","7738  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  عَلِيُّ بْنُ حُمَيْدٍ ،  نَا  عُمَرُ بْنُ فَرْقَدٍ الْبَزَّارُ ،  عَنْ  عَبْدِ اللهِ بْنِ الْمُخْتَارِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَالَ دُبُرَ كُلِّ صَلَاةٍ : أَسْتَغْفِرُ اللهَ الَّذِي لَا إِلَهَ إِلَّا هُوَ الْحَيَّ الْقَيُّومَ وَأَتُوبُ إِلَيْهِ غُفِرَ لَهُ  ، وَإِنْ فَرَّ مِنَ  الزَّحْفِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  عَبْدُ اللهِ بْنُ الْمُخْتَارِ  ، وَلَا عَنْ  عَبْدِ اللهِ بْنِ الْمُخْتَارِ  إِلَّا  عُمَرُ بْنُ فَرْقَدٍ  ، وَلَا عَنْ  عُمَرَ بْنِ فَرْقَدٍ  إِلَّا  عَلِيُّ بْنُ حُمَيْدٍ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ بْنُ إِسْحَاقَ  "" .","","Al-Mu'jam al-Awsat 7738","","البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن عبد الله بن المختار البصري عن عمر بن فرقد الباهلي عن علي بن حميد عن يعقوب بن إسحاق القلوسي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7745","7739  - =  وَبِهِ  :  حَدَّثَنَا  عُمَرُ بْنُ فَرْقَدٍ ،  عَنْ  مُحَمَّدِ بْنِ وَاسِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الصَّامِتِ ،  عَنْ  أَبِي ذَرٍّ قَالَ :  أَوْصَانِي  خَلِيلِي  أَبُو الْقَاسِمِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِسَبْعٍ  : حُبِّ الْمَسَاكِينِ ، وَالدُّنُوِّ مِنْهُمْ ، وَأَنْ أَصِلَ الرَّحِمَ وَإِنْ أَدْبَرَتْ ، وَأَنْ أَقُولَ لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، فَإِنَّهَا         [7/365]      مِنْ كُنُوزِ الْجَنَّةِ ، وَأَوْصَانِي أَنْ لَا أَخَافَ فِي اللهِ لَوْمَةَ لَائِمٍ ، وَأَوْصَانِي أَنْ أَقُولَ الْحَقَّ وَإِنْ كَانَ مُرًّا ، وَأَوْصَانِي أَنْ أَنْظُرَ إِلَى مَنْ هُوَ دُونِي ، وَلَا أَنْظُرَ إِلَى مَنْ هُوَ فَوْقِي ، وَأَوْصَانِي أَنْ لَا آخُذَ مِنَ النَّاسِ شَيْئًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَرَ بْنِ فَرْقَدٍ  إِلَّا  عَلِيُّ بْنُ حُمَيْدٍ الدَّهَكِيُّ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ الْحَضْرَمِيُّ  ""  .","","Al-Mu'jam al-Awsat 7739","","أبو ذر الغفاري عن عبد الله بن الصامت الغفاري عن محمد بن واسع بن جابر عن عمر بن فرقد الباهلي عن علي بن حميد عن يعقوب بن إسحاق القلوسي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7746","7740  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  ثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  نَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  السُّجُودُ عَلَى سَبْعَةِ أَعْضَاءٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدٍ الْمَقْبُرِيِّ  إِلَّا  أَبُو أُمَيَّةَ بْنُ يَعْلَى  ،  تَفَرَّدَ بِهِ  :  حَجَّاجُ بْنُ نُصَيْرٍ  ""  .","","Al-Mu'jam al-Awsat 7740","","أبو هريرة الدوسي عن سعيد المقبري عن إسماعيل بن يعلى الثقفي عن حجاج بن نصير الفساطيطي عن يعقوب بن إسحاق القلوسي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7747","7741  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  يَحْيَى بْنُ رَاشِدٍ ،  نَا  عَبْدُ النُّورِ بْنُ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ سِنَانٍ الْقَيْسِيِّ ،  عَنْ  هَارُونَ بْنِ سَعْدٍ ،  عَنْ  ثُمَامَةَ بْنِ عُقْبَةَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ قَالَ :  بَيْنَا نَحْنُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ أَقْبَلَ رَجُلٌ مِنَ الْيَهُودِ - يُقَالُ لَهُ :  ثَعْلَبَةُ بْنُ الْحَارِثِ  - فَقَالَ :  السَّامُ  عَلَيْكَ يَا  مُحَمَّدُ  ، فَقَالَ : "" وَعَلَيْكُمْ "" ، فَقَالَ لَهُ الْيَهُودِيُّ : تَزْعُمُ أَنَّ فِي الْجَنَّةِ طَعَامًا وَشَرَابًا وَأَزْوَاجًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" نَعَمْ ، تُؤْمِنُ بِشَجَرَةِ الْمِسْكِ ؟ "" قَالَ : نَعَمْ ، قَالَ : "" وَتَجِدُهَا فِي كِتَابِكُمْ ؟ "" قَالَ : نَعَمْ ، قَالَ :  فَإِنَّ الْبَوْلَ وَالْجَنَابَةَ عَرَقٌ يَسِيلُ مَنْ تَحْتِ ذَوَائِبِهِمْ إِلَى أَقْدَامِهِمْ مِسْكٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هَارُونَ بْنِ سَعْدٍ  إِلَّا  عَبْدُ اللهِ بْنُ سِنَانٍ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ النُّورِ         [7/366]      بْنُ عَبْدِ اللهِ  ""  .","","Al-Mu'jam al-Awsat 7741","","زيد بن أرقم الأنصاري عن ثمامة بن عقبة المحلمي عن هارون بن سعد العجلي عن عبد الله بن سنان القيسي عن عبد النور بن عبد الله المسمعي عن يحيى بن راشد المازني عن يعقوب بن إسحاق القلوسي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7748","7742  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  أَبُو الْأَشْعَثِ أَحْمَدُ بْنُ الْمِقْدَامِ ،  نَا  عُبَيْدُ بْنُ الْقَاسِمِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ  عَمْرَةَ بِنْتَ الْجَوْنِ  تَعَوَّذَتْ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حِينَ أُدْخِلَتْ عَلَيْهِ ، فَقَالَ :  لَقَدْ  عُذْتِ  بِمَعَاذٍ  ، وَطَلَّقْهَا ، وَأَمَرَ  أُسَامَةَ  فَمَتَّعَهَا  بِثَلَاثَةِ أَثْوَابٍ  لَمْ يَرْوِ هَذَا الْحَدِيثَ -  مَوْصُولًا  - عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  عُبَيْدُ بْنُ الْقَاسِمِ  "" .","","Al-Mu'jam al-Awsat 7742","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبيد بن القاسم الأسدي عن أحمد بن المقدام العجلي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7749","7743  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ الْخَطِيبُ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  نَا  كَهْمَسُ بْنُ الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ فِي أَصْدَاغِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خِضَابَ الْحِنَّاءِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  كَهْمَسٍ  إِلَّا  الْأَنْصَارِيُّ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ  ""  .","","Al-Mu'jam al-Awsat 7743","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن كهمس بن الحسن النمري عن محمد بن عبد الله بن المثنى الخزرجي عن محمد بن عبد الرحمن السلمي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7750","7744  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ ،  نَا  مُوسَى بْنُ سَعِيدِ بْنِ سَلْمٍ الْبَاهِلِيُّ ،  نَا  أَبِي سَعِيدُ بْنُ سَلْمٍ  ،  نَا  ابْنُ عَوْنٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ :  كَانَ لِعُثْمَانَ بْنِ عَفَّانَ آذِنٌ ، فَكَانَ يَخْرُجُ بَيْنَ يَدَيْهِ إِلَى الصَّلَاةِ  ، قَالَ : "" فَخَرَجَ يَوْمًا فَصَلَّى وَالْآذِنُ بَيْنَ يَدَيْهِ ، ثُمَّ جَاءَ فَجَلَسَ الْآذِنُ نَاحِيَةً ، وَلَفَّ رِدَاءَهُ فَوَضَعَهُ تَحْتَ رَأْسِهِ ، وَاضْطَجَعَ ، وَوَضَعَ الدِّرَّةَ بَيْنَ يَدَيْهِ ، فَأَقْبَلَ عَلِيٌّ فِي إِزَارٍ وَرِدَاءٍ ، وَبِيَدِهِ عَصًا ، فَلَمَّا رَآهُ الْآذِنُ مِنْ بَعِيدٍ قَالَ : هَذَا  عَلِيٌّ  قَدْ أَقْبَلَ ، فَجَلَسَ  عُثْمَانُ  ، فَأَخَذَ عَلَيْهِ رِدَاءَهُ ، فَجَاءَ حَتَّى قَامَ عَلَى رَأْسِهِ ، وَقَالَ : اشْتَرَيْتَ ضَيْعَةَ آلِ فُلَانٍ وَلِوَقْفِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي مَائِهَا حَقٌّ ، أَمَا إِنِّي قَدْ عَلِمْتُ أَنَّهُ لَا يَشْتَرِيهَا غَيْرُكَ ، فَقَامَ  عُثْمَانُ  ، وَجَرَى بَيْنَهُمَا كَلَامٌ لَا أَرُدُّهُ حَتَّى أَلْقَى اللهَ .         [7/367]      وَجَاءَ  الْعَبَّاسُ  فَدَخَلَ بَيْنَهُمَا ، وَرَفَعَ  عُثْمَانُ  عَلَى  عَلِيٍّ  الدِّرَّةَ ، وَرَفَعَ  عَلِيٌّ  عَلَى  عُثْمَانَ  الْعَصَا ، فَجَعَلَ  الْعَبَّاسُ  يُسَكِّنُهُمَا ، وَيَقُولُ  لِعَلِيٍّ  : أَمِيرُ الْمُؤْمِنِينَ ، وَيَقُولُ  لِعُثْمَانَ  : ابْنُ عَمِّكَ ، فَلَمْ يَزَلْ حَتَّى سَكَنَا ، فَلَمَّا أَنْ كَانَ بِالْعَشِيِّ مِنَ الْغَدِ ، رَأَيْتُهُمَا وَكُلُّ وَاحِدٍ مِنْهُمَا آخِذٌ بَيْدِ صَاحِبِهِ ، وَهُمَا يَتَحَدَّثَانِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ عَوْنٍ  إِلَّا  سَعِيدُ بْنُ سَلْمٍ  ، وَلَا عَنْ  سَعِيدٍ  إِلَّا ابْنُهُ ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ  ""  .","","Al-Mu'jam al-Awsat 7744","","علي بن أبي طالب عن سعيد بن المسيب عن الحسن البصري عن عبد الله بن عون بن أرطبان عن سعيد بن سلم بن قتيبة الباهلي عن موسى بن سعيد بن سلم الباهلي عن محمد بن عبد الرحمن السلمي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7751","7745  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ،  نَا  شُعْبَةُ  ، عَنْ  ثَابِتٍ الْبُنَانِيِّ  ، عَنْ  أَبِي رَافِعٍ  ، عَنْ  أَبِي هُرَيْرَةَ قَالَ :  مَا رَأَيْتُ أَحَدًا أَشْبَهَ صَلَاةً بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنِ ابْنِ أُمِّ سُلَيْمٍ  "" -  يَعْنِي :  أَنَسَ بْنَ مَالِكٍ  "" .  لَمْ يُدْخِلْ أَحَدٌ مِمَّنْ رَوَى هَذَا الْحَدِيثَ عَنْ  شُعْبَةَ  عَنْ  ثَابِتٍ  ،  وَأَبِي هُرَيْرَةَ  :  أَبَا رَافِعٍ  إِلَّا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ  "" .","","Al-Mu'jam al-Awsat 7745","","أنس بن مالك عن أبو هريرة الدوسي عن نفيع بن رافع الصائغ عن ثابت البناني عن شعبة بن الحجاج عن محمد بن عبد الله بن المثنى الخزرجي عن محمد بن عبد الرحمن زيتونة عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7752","7746  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  نَا  يَحْيَى بْنُ مَيْمُونٍ الْقُرَشِيُّ ،  نَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ قَالَ :  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ ، عَلِّمْنِي دُعَاءً أُصِيبُ مِنْهُ خَيْرًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قُلِ : اللَّهُمَّ اعْفُ عَنِّي ، فَإِنَّكَ عَفُوٌّ كَرِيمٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَلِيِّ بْنِ زَيْدٍ  إِلَّا  يَحْيَى بْنُ مَيْمُونٍ  "" .","","Al-Mu'jam al-Awsat 7746","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن علي بن زيد بن جدعان عن يحيى بن ميمون بن عطاء التمار عن حفص بن عمرو الربالي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7753","7747  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  عَبْدَةُ بْنُ عَبْدِ اللهِ الصَّفَّارُ ،  نَا  جَعْفَرُ بْنُ عَوْنٍ ،  نَا  عُمَرُ بْنُ رَاشِدٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا بَعَثْتُمْ رَسُولًا فَابْعَثُوهُ حَسَنَ         [7/368]      الْوَجْهِ  ، حَسَنَ الِاسْمِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ  إِلَّا  عُمَرُ بْنُ رَاشِدٍ  "" .","","Al-Mu'jam al-Awsat 7747","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن عمر بن راشد بن شجرة اليمامي عن جعفر بن عون المخزومي عن عبدة بن عبد الله بن عبدة الخزاعي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7754","7748  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  ثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ،  نَا  أَبُو هَمَّامٍ الدَّلَّالُ ،  نَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  مَنْصُورٍ ،  عَنْ  رِبْعِيِّ بْنِ حِرَاشٍ ،  عَنِ  الْمَعْرُورِ بْنِ سُوَيْدٍ ،  عَنْ  أَبِي ذَرٍّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَقُولُ اللهُ تَبَارَكَ وَتَعَالَى :  ابْنَ آدَمَ ، لَوْ عَمِلْتَ  قُرَابَ  الْأَرْضِ خَطِيئَةً  ، مَا لَمْ تُشْرِكْ بِي شَيْئًا ، جَعَلْتُ لَكَ  قُرَابَ  الْأَرْضِ مَغْفِرَةً  .  ""  لَمْ يُجَوِّدْ  إِسْنَادَ  هَذَا الْحَدِيثِ عَنْ  مَنْصُورٍ  إِلَّا  إِبْرَاهِيمُ بْنُ طَهْمَانَ  ،  وَخَارِجَةُ بْنُ مُصْعَبٍ  "" .","","Al-Mu'jam al-Awsat 7748","","أبو ذر الغفاري عن معرور بن سويد الأسدي عن ربعي بن حراش العبسي عن منصور بن المعتمر عن إبراهيم بن طهمان عن محمد بن محبب الدلال عن عبدة بن عبد الله بن عبدة الخزاعي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7755","7749  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  زِيَادُ بْنُ يَحْيَى أَبُو الْخَطَّابِ ،  نَا  سَهْلُ بْنُ حَمَّادٍ أَبُو عَتَّابٍ الدَّلَّالُ ،  نَا  جَرِيرُ بْنُ أَيُّوبَ الْبَجَلِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا مِنْ عَبْدٍ أَصْبَحَ صَائِمًا إِلَّا فُتِحَتْ لَهُ أَبْوَابُ السَّمَاءِ  ، وَسَبَّحَتْ أَعْضَاؤُهُ ، وَاسْتَغْفَرَ لَهُ أَهْلُ السَّمَاءِ الدُّنْيَا ، إِلَى أَنْ تُوَارَى بِالْحِجَابِ ، فَإِنْ صَلَّى رَكْعَةً أَوْ رَكْعَتَيْنِ تَطَوُّعًا أَضَاءَتْ لَهُ السَّمَاوَاتُ نُورًا ، وَقُلْنَ أَزْوَاجُهُ مِنَ الْحُورِ  الْعِينِ  : اللَّهُمَّ اقْبِضْهُ إِلَيْنَا ، فَقَدِ اشْتَقْنَا إِلَى رُؤْيَتِهِ ، وَإِنْ هُوَ هَلَّلَ أَوْ سَبَّحَ أَوْ كَبَّرَ ، تَلَقَّاهُ سَبْعُونَ أَلْفَ مَلَكٍ ، يَكْتُبُونَهَا إِلَى أَنْ تُوَارَى  بِالْحِجَابِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  ، وَلَا رَوَاهُ عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ  إِلَّا  جَرِيرُ بْنُ أَيُّوبَ  ، وَلَا رَوَاهُ عَنْ  جَرِيرٍ  إِلَّا  أَبُو عَتَّابٍ  ،  تَفَرَّدَ بِهِ  :  زِيَادُ بْنُ يَحْيَى  ""  .","","Al-Mu'jam al-Awsat 7749","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن أبو إسحاق السبيعي عن محمد بن عبد الرحمن بن أبي ليلى عن جرير بن أيوب بن أبي زرعة البجلي عن سهل بن حماد الدلال عن زياد بن يحيى الحساني عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7756","[7/369]      7750  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  أَبُو الْخَطَّابِ زِيَادُ بْنُ يَحْيَى ،  ثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  نَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كُنْتُ آتِي النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُعْتَكِفٌ فِي الْمَسْجِدِ  ، وَأَنَا حَائِضٌ ، فَيُخْرِجُ إِلَيَّ رَأْسَهُ مِنَ الْمَسْجِدِ ، فَأُرَجِّلُهُ وَأَدْهِنُهُ وَأَنَا حَائِضٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ حَسَّانَ  إِلَّا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ  "" .","","Al-Mu'jam al-Awsat 7750","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن هشام بن حسان العتكي عن عبد الوهاب بن عبد المجيد الثقفي عن زياد بن يحيى الحساني عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7757","7751  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  زِيَادُ بْنُ يَحْيَى ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  نَا  سَعِيدٌ ، وَرَوْحُ بْنُ الْقَاسِمِ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ ،  عَنْ  مَعْدَانَ بْنِ أَبِي طَلْحَةَ ،  عَنْ  ثَوْبَانَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ فَارَقَ الرُّوحُ الْجَسَدَ ، وَهُوَ بَرِيءٌ مِنْ ثَلَاثٍ دَخَلَ الْجَنَّةَ  : الْكِبْرِ ، وَالْغُلُولِ ، وَالدَّيْنِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  رَوْحِ بْنِ الْقَاسِمِ  إِلَّا  يَزِيدُ بْنُ زُرَيْعٍ  ،  تَفَرَّدَ بِهِ  :  زِيَادُ بْنُ يَحْيَى  "" .","","Al-Mu'jam al-Awsat 7751","","ثوبان بن بجدد مولى رسول الله عن معدان بن أبى طلحة اليعمري عن سالم بن أبي الجعد الغطفاني عن قتادة بن دعامة عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن زياد بن يحيى الحساني عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7758","7752  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  زِيَادُ بْنُ يَحْيَى ،  نَا  عَبْدُ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عِمْرَانَ بْنِ أَبِي أَنَسٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، وَأَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّهُمَا  حَدَّثَاهُ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  حَاضَتْ  صَفِيَّةُ بِنْتُ حُيَيٍّ  وَهِيَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، كَانَتْ  أَفَاضَتْ  قَبْلَ ذَلِكَ ، فَلَمَّا صَدَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ  مِنًى  قِيلَ لَهُ : إِنَّ  صَفِيَّةَ  قَدْ حَاضَتْ ، قَالَ :  فَعَسَى أَنْ تَحْبِسَنَا  ، قَالُوا : يَا رَسُولَ اللهِ ، إِنَّهَا قَدْ  أَفَاضَتْ  ؟ قَالَ : "" فَلْتَنْفِرْ "" . قَالَ : فَصَدَرَ بِهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهِيَ فِي دَمِهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ  إِلَّا  عِمْرَانُ بْنُ أَبِي أَنَسٍ  ، وَلَا عَنْ  عِمْرَانَ  إِلَّا  مُحَمَّدُ بْنُ إِسْحَاقَ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ الْأَعْلَى  "" .","","Al-Mu'jam al-Awsat 7752","","عائشة بنت أبي بكر الصديق عن سليمان بن يسار مولى ميمونة زوج رسول الله عن عمران بن أبي أنس العامري عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن زياد بن يحيى الحساني عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7759","7753  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  إِسْحَاقُ بْنُ الضَّيْفِ ،  نَا  مَنْصُورُ بْنُ أَبِي نُوَيْرَةَ ،         [7/370]      ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي حُمَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِيَّاكُمْ وَالطَّمَعَ ، فَإِنَّهُ هُوَ الْفَقْرُ الْحَاضِرُ  ، وَإِيَّاكُمْ وَمَا يُعْتَذَرُ مِنْهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  إِلَّا  مُحَمَّدُ بْنُ أَبِي حُمَيْدٍ  ، وَلَا عَنْ  مُحَمَّدٍ  إِلَّا  أَبُو بَكْرِ بْنُ عَيَّاشٍ  ،  تَفَرَّدَ بِهِ  :  مَنْصُورُ بْنُ أَبِي نُوَيْرَةَ  "" .","","Al-Mu'jam al-Awsat 7753","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن محمد بن أبي حميد الزرقي عن أبو بكر بن عياش عن منصور بن يعقوب بن أبي نويرة العلاف عن إسحاق بن الضيف الباهلي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7760","7754  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  ثَنَا  إِسْحَاقُ بْنُ الضَّيْفِ ،  نَا  مَنْصُورُ بْنُ أَبِي نُوَيْرَةَ ،  نَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا اخْتَلَفَتْ أُمَّةٌ بَعْدَ نَبِيِّهَا إِلَّا ظَهَرَ أَهْلُ بَاطِلِهَا  عَلَى أَهْلِ حَقِّهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ  إِلَّا  مُوسَى بْنُ عُبَيْدَةَ  ، وَلَا عَنْ  مُوسَى  إِلَّا  أَبُو بَكْرِ بْنُ عَيَّاشٍ  ،  تَفَرَّدَ بِهِ  :  مَنْصُورُ بْنُ أَبِي نُوَيْرَةَ  "" .","","Al-Mu'jam al-Awsat 7754","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن موسى بن عبيدة بن نشيط الحميري عن أبو بكر بن عياش عن منصور بن يعقوب بن أبي نويرة العلاف عن إسحاق بن الضيف الباهلي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7761","7755  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  أَبُو الْأَشْعَثِ أَحْمَدُ بْنُ الْمِقْدَامِ ،  ثَنَا  يُوسُفُ بْنُ الْحَجَّاجِ ،  نَا  الْمُعَارِكُ بْنُ عَبَّادٍ ،  عَنْ  يَحْيَى بْنِ أَبِي الْفَضْلِ ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ أَمَّ قَوْمًا فَلْيَتَّقِ اللهَ  ، وَلْيَعْلَمْ أَنَّهُ ضَامِنٌ مَسْئُولٌ كَمَا ضَمِنَ ، فَإِنْ أَحْسَنَ كَانَ لَهُ مِنَ الْأَجْرِ مِثْلُ أَجْرِ مَنْ صَلَّى خَلْفَهُ ، مِنْ غَيْرِ أَنْ يَنْتَقِصَ مِنْ أُجُورِهِمْ شَيْئًا ، وَمَا كَانَ مِنْ نَقْصٍ فَهُوَ عَلَيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الْجَوْزَاءِ  إِلَّا  يَحْيَى بْنُ أَبِي الْفَضْلِ  ، وَلَا رَوَاهُ عَنْ  يَحْيَى  إِلَّا  الْمُعَارِكُ  ،  تَفَرَّدَ بِهِ  :  يُوسُفُ بْنُ الْحَجَّاجِ  "" .","","Al-Mu'jam al-Awsat 7755","","عبد الله بن عمر بن الخطاب عن أوس بن عبد الله الربعي عن يحيى بن أبي الفضل عن معارك بن عباد القيسي عن يوسف بن الحجاج عن أحمد بن المقدام العجلي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7762","7756  - =  وَبِهِ  :  حَدَّثَنَا  الْمُعَارِكُ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  جَدِّهِ  ،         [7/371]      عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ مِنْ إِتْمَامِ إِيمَانِ الْعَبْدِ أَنْ يَسْتَثْنِيَ  فِي كُلِّ حَدِيثٍ  .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي هُرَيْرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  الْمُعَارِكُ بْنُ عَبَّادٍ  "" .","","Al-Mu'jam al-Awsat 7756","","أبو هريرة الدوسي عن أبو سعيد المقبري عن عبد الله بن سعيد بن أبي سعيد المقبري عن معارك بن عباد القيسي عن يوسف بن الحجاج عن أحمد بن المقدام العجلي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7763","7757  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  نَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ،  نَا  عَبْدُ الْحَكِيمِ بْنُ عَبْدِ اللهِ بْنِ أَبِي فَرْوَةَ قَالَ :  سَمِعْتُ  عَوْفَ بْنَ الْحَارِثِ بْنِ الطُّفَيْلِ ، يَقُولُ :  سَمِعْتُ  عَائِشَةَ ، تَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَنْشَأَتِ السَّمَاءُ بَحْرِيَّةً ، ثُمَّ  تَشَاءَمَتْ  فَهُوَ  عَيْنٌ  غُدَيْقَةٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَوْفِ بْنِ الْحَارِثِ  إِلَّا  عَبْدُ الْحَكِيمِ  ،  تَفَرَّدَ بِهِ  :  الْوَاقِدِيُّ  "" .","","Al-Mu'jam al-Awsat 7757","","عائشة بنت أبي بكر الصديق عن عوف بن الحارث بن الطفيل الأزدي عن عبد الحكيم بن عبد الله بن أبي فروة عن الواقدي عن حفص بن عمرو الربالي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7764","7758  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  نَا  الْمُنْذِرُ بْنُ زِيَادٍ الطَّائِيُّ ،  نَا  عَمْرُو بْنُ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  فَرَضَ  عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَدَقَةَ رَمَضَانَ صَاعًا مِنْ شَعِيرٍ  ، أَوْ صَاعًا مِنْ تَمْرٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمْرِو بْنِ دِينَارٍ  إِلَّا  الْمُنْذِرُ بْنُ زِيَادٍ  "" .","","Al-Mu'jam al-Awsat 7758","","عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن منذر بن زياد الطائي عن حفص بن عمرو الربالي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7765","7759  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  حَفْصُ بْنُ عَمْرٍو ،  نَا  الْمُنْذِرُ بْنُ زِيَادٍ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، "" أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا  جَدَّ  بِهِ السَّيْرُ جَمَعَ  بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  ثَابِتٍ  إِلَّا  الْمُنْذِرُ بْنُ زِيَادٍ  .","","Al-Mu'jam al-Awsat 7759","","أنس بن مالك عن ثابت البناني عن منذر بن زياد الطائي عن حفص بن عمرو الربالي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7766","[7/372]      7760  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ السُّلَمِيُّ ،  نَا  أَبُو عُبَيْدَةَ مَعْمَرُ بْنُ الْمُثَنَّى ،  حَدَّثَنِي  أَخِي يَزِيدُ بْنُ الْمُثَنَّى  ،  حَدَّثَنِي  لَبَطَةُ بْنُ الْفَرَزْدَقِ ،  عَنْ  أَبِيهِ  قَالَ :  قَالَ  لِي أَبُو هُرَيْرَةَ : يَا  فَرَزْدَقُ  ، إِنِّي أَرَاكَ صَغِيرَ الْقَدَمَيْنِ ، فَإِنْ أَمْكَنَكَ أَنْ يَكُونَ لَهُمَا عِنْدَ الْحَوْضِ مَكَانٌ فَافْعَلْ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  حَوْضِي مَا بَيْنَ  عُمَانَ  وَأَيْلَةَ  ، مَاؤُهُ أَشَدُّ بَيَاضًا  مِنَ اللَّبَنِ ، وَأَحْلَى مِنَ الْعَسَلِ ، آنِيَتُهُ مِثْلُ عَدَدِ نُجُومِ السَّمَاءِ ، مَنْ شَرِبَ مِنْهُ شَرْبَةً لَمْ يَظْمَأْ أَبَدًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  لَبَطَةَ بْنِ الْفَرَزْدَقِ  إِلَّا  يَزِيدُ بْنُ الْمُثَنَّى  ، وَلَا رَوَاهُ عَنْ  يَزِيدَ  إِلَّا أَخُوهُ  أَبُو عُبَيْدَةَ  "" .","","Al-Mu'jam al-Awsat 7760","","أبو هريرة الدوسي عن الفرزدق الشاعر عن لبطة بن الفرزدق المجاشعي عن يزيد بن المثنى عن معمر بن المثنى البصري عن محمد بن عبد الرحمن زيتونة عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7767","7761  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  ثَنَا  أَبُو الْأَشْعَثِ ،  ثَنَا  أَصْرَمُ بْنُ حَوْشَبٍ ،  ثَنَا  إِسْحَاقُ بْنُ وَاصِلٍ ،  عَنْ  أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيٍّ قَالَ :  قُلْنَا لِعَبْدِ اللهِ بْنِ جَعْفَرٍ :  حَدِّثْنَا  بِمَا سَمِعْتَ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَرَأَيْتَ مِنْهُ ، وَلَا تُحَدِّثْنَا عَنْ غَيْرِكَ ، وَإِنْ كَانَ ثِقَةً .  قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  مَا بَيْنَ السُّرَّةِ إِلَى الرُّكْبَةِ  عَوْرَةٌ  .  وَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الصَّدَقَةُ تُطْفِئُ غَضَبَ الرَّبِّ  .  وَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  شِرَارُ أُمَّتِي قَوْمٌ وُلِدُوا فِي النَّعِيمِ وَغُذُّوا بِهِ  ، يَأْكُلُونَ مِنَ الطَّعَامِ أَلْوَانًا ، يَتَشَدَّقُونَ فِي الْكَلَامِ  .  وَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَا  بَنِي هَاشِمٍ  ، إِنِّي قَدْ سَأَلْتُ اللهَ لَكُمْ أَنْ يَجْعَلَكُمْ  نُجَبَاءَ  رُحَمَاءَ  ، وَسَأَلْتُهُ أَنْ يَهْدِيَ ضَالَّكُمْ ، وَيُؤَمِّنَ خَائِفَكُمْ ، وَيُشْبِعَ جَائِعَكُمْ  .  ""  وَرَأَيْتُ فِي يَمِينِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قِثَّاءَةً  ، وَفِي شِمَالِهِ رُطَبَاتٍ ، وَهُوَ يَأْكُلُ مِنْ ذَا مَرَّةً ، وَمِنْ ذَا مَرَّةً  .  وَأُهْدِيَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَاةٌ وَأَرْغِفَةٌ  ، فَجَعَلَ يَأْكُلُ وَيَأْكُلُونَ ،         [7/373]      وَسَمِعْتُهُ يَقُولُ :  عَلَيْكُمْ بِلَحْمِ الظَّهْرِ ، فَإِنَّهُ مِنْ أَطْيَبِهِ  .  ""  وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقْرَأُ فِي الرَّكْعَتَيْنِ قَبْلَ الْفَجْرِ  ، وَالرَّكْعَتَيْنِ بَعْدَ الْمَغْرِبِ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .  وَكَانَ مَهْرُ  فَاطِمَةَ  بُدْنَ حَدِيدٍ  .  وَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَتَاهُ  الْعَبَّاسُ  ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي انْتَهَيْتُ إِلَى قَوْمٍ يَتَحَدَّثُونَ ، فَلَمَّا رَأَوْنِي سَكَتُوا ، وَمَا ذَاكَ إِلَّا أَنَّهُمْ يَبْغَضُونَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَوَقَدْ فَعَلُوهَا ، وَالَّذِي نَفْسِي بِيَدِهِ لَا يُؤْمِنُ أَحَدُهُمْ حَتَّى يُحِبَّكُمْ  ، أَيَرْجُونَ أَنْ يَدْخُلُوا الْجَنَّةَ بِشَفَاعَتِي وَلَا يَرْجُوهَا  بَنُو عَبْدِ الْمُطَّلِبِ  .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  أَبُو الْأَشْعَثِ  "" .","","Al-Mu'jam al-Awsat 7761","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن أبو جعفر الباقر عن إسحاق بن واصل عن أصرم بن حوشب الهمذاني عن أحمد بن المقدام العجلي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7768","7762  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  أَبُو الْأَشْعَثِ ،  نَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَصْلُحُ الْمَسْأَلَةُ لِغَنِيٍّ  ، إِلَّا مِنْ ذِي رَحِمٍ ، أَوْ سُلْطَانٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَمُرَةَ  إِلَّا  شَهْرُ بْنُ حَوْشَبٍ  ، وَلَا عَنْ  شَهْرٍ  إِلَّا  الْعَوَّامُ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ اللهِ بْنُ خِرَاشٍ  "" .","","Al-Mu'jam al-Awsat 7762","","سمرة بن جندب عن شهر بن حوشب عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن أحمد بن المقدام العجلي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7769","7763  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  أَبُو الْأَشْعَثِ ،  نَا  عَبْدُ اللهِ بْنُ خِرَاشٍ ،  عَنِ  الْعَوَّامِ بْنِ حَوْشَبٍ ،  عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ اقْتَطَعَ مَالَ امْرِئٍ مُسْلِمٍ بِيَمِينٍ صَبْرٍ  ، لَقِيَ اللهَ وَهُوَ عَلَيْهِ غَضْبَانُ  .         [7/374]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِبْرَاهِيمَ التَّيْمِيِّ  إِلَّا  الْعَوَّامُ  ،  تَفَرَّدَ بِهِ  :  عَبْدُ اللهِ بْنُ خِرَاشٍ  "" .","","Al-Mu'jam al-Awsat 7763","","عبد الله بن مسعود عن يزيد بن شريك بن طارق التيمي عن إبراهيم بن يزيد بن شريك التيمي عن العوام بن حوشب عن عبد الله بن خراش بن حوشب الحوشبي عن أحمد بن المقدام العجلي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7770","7764  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  نَا  بِشْرُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنِي  الْحَجَّاجُ بْنُ حَسَّانَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا انْتَهَى أَحَدُكُمْ إِلَى الصَّفِّ وَقَدْ تَمَّ ، فَلْيَجْذِبْ إِلَيْهِ رَجُلًا  يُقِيمُهُ إِلَى جَنْبِهِ  .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  بِشْرُ بْنُ إِبْرَاهِيمَ  "" .","","Al-Mu'jam al-Awsat 7764","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن حجاج بن حسان القيسي عن بشر بن إبراهيم المفلوج عن حفص بن عمرو الربالي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7771","7765  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  نَا  حَفْصُ بْنُ عُمَرَ الرَّازِيُّ ،  نَا  أَبُو حُرَّةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ تَوَضَّأَ يَوْمَ الْجُمُعَةِ فَبِهَا  وَنِعْمَتْ  وَمَنِ اغْتَسَلَ فَالْغُسْلُ أَفْضَلُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي حُرَّةَ  إِلَّا  حَفْصُ بْنُ عُمَرَ الْإِمَامُ النَّجَّارُ الرَّازِيُّ  "" .","","Al-Mu'jam al-Awsat 7765","","عبد الرحمن بن سمرة العبشمي عن الحسن البصري عن واصل بن عبد الرحمن البصري عن حفص بن عمر الرازي عن حفص بن عمرو الربالي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7772","7766  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  ثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْقُلُوسِيُّ ،  ثَنَا  الْحَارِثُ بْنُ مُحَمَّدٍ ،  ثَنَا  حُلْوُ بْنُ السَّرِيِّ الْأَوْدِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  عَبْدِ اللهِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  أُلْفِيَنَّ  أَحَدَكُمْ يَضَعُ إِحْدَى رِجْلَيْهِ عَلَى الْأُخْرَى  ، ثُمَّ  يَتَغَنَّى ،  وَيَدَعُ أَنْ يَقْرَأَ سُورَةَ الْبَقَرَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حُلْوِ بْنِ السَّرِيِّ  إِلَّا  الْحَارِثُ بْنُ مُحَمَّدٍ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ بْنُ إِسْحَاقَ  "" .","","Al-Mu'jam al-Awsat 7766","","عبد الله بن مسعود عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن حلو بن السري الكوفي عن الحارث بن محمد المعكوف عن يعقوب بن إسحاق القلوسي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7773","7767  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  الْحَسَنُ بْنُ عَنْبَسَةَ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الْكُوفِيُّ ،  عَنْ  أَبِي الْعَلَاءِ الْخَفَّافِ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  حَبَّةَ الْعُرَنِيِّ ،         [7/375]      عَنْ  عَلِيٍّ قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا سُئِلَ شَيْئًا فَأَرَادَ أَنْ يَفْعَلَهُ قَالَ : "" نَعَمْ "" ، وَإِذَا أَرَادَ أَنْ لَا يَفْعَلَ سَكَتَ ، وَكَانَ لَا يَقُولُ لِشَيْءٍ : لَا ، فَأَتَاهُ  أَعْرَابِيٌّ  ، فَسَأَلَهُ ، فَسَكَتَ ، ثُمَّ سَأَلَهُ فَسَكَتَ ، ثُمَّ سَأَلَهُ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَهَيْئَةِ الْمُنْتَهِرِ : "" سَلْ مَا شِئْتَ يَا  أَعْرَابِيُّ  "" ، فَغَبِطْنَاهُ ، فَقُلْنَا : الْآنَ يَسْأَلُ الْجَنَّةَ ، فَقَالَ  الْأَعْرَابِيُّ  : أَسْأَلُكَ رَاحِلَةً ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَكَ ذَاكَ "" ، ثُمَّ قَالَ : "" سَلْ "" ، قَالَ : أَسْأَلُكَ زَادًا ، قَالَ : "" وَلَكَ ذَاكَ "" ، قَالَ : فَتَعَجَّبْنَا مِنْ ذَلِكَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَمْ بَيْنَ مَسْأَلَةِ  الْأَعْرَابِيِّ  وَعَجُوزِ  بَنِي إِسْرَائِيلَ  .  ثُمَّ قَالَ : "" إِنَّ  مُوسَى  لَمَّا أُمِرَ أَنْ يَقْطَعَ الْبَحْرَ فَانْتَهَى إِلَيْهِ ، فَضُرِبَتْ وُجُوهُ الدَّوَابِّ ، فَرَجَعَتْ ، فَقَالَ  مُوسَى  : مَا لِي يَا رَبِّ ، قَالَ لَهُ : إِنَّكَ عِنْدَ قَبْرِ  يُوسُفَ  ، فَاحْتَمِلْ عِظَامَهُ مَعَكَ ، وَقَدِ اسْتَوَى الْقَبْرُ بِالْأَرْضِ ، فَجَعَلَ  مُوسَى  لَا يَدْرِي أَيْنَ هُوَ ، قَالُوا : إِنْ كَانَ أَحَدٌ مِنْكُمْ يَعْلَمُ أَيْنَ هُوَ ، فَعَجُوزُ  بَنِي إِسْرَائِيلَ  لَعَلَّهَا تَعْلَمُ أَيْنَ هُوَ ، فَأَرْسَلَ إِلَيْهَا  مُوسَى  عَلَيْهِ السَّلَامُ ، قَالَ : هَلْ تَعْلَمِينَ أَيْنَ قَبْرُ  يُوسُفَ  عَلَيْهِ السَّلَامُ ؟ قَالَتْ : نَعَمْ ، قَالَ : فَدُلِّينِي عَلَيْهِ ، قَالَتْ : لَا وَاللهِ حَتَّى تُعْطِيَنِي مَا أَسْأَلُكَ ، قَالَ : ذَاكَ لَكِ ، قَالَتْ : فَإِنِّي أَسْأَلُكَ أَنْ أَكُونَ مَعَكَ فِي الدَّرَجَةِ الَّتِي تَكُونُ فِيهَا فِي الْجَنَّةِ . قَالَ : سَلِي الْجَنَّةَ ، قَالَتْ : لَا وَاللهِ أَنْ أَكُونَ مَعَكَ ، فَجَعَلَ  مُوسَى  يُرَادُّهَا ، فَأَوْحَى اللهُ تَبَارَكَ وَتَعَالَى إِلَيْهِ : أَنْ أَعْطِهَا ذَلِكَ ، فَإِنَّهُ لَا يَنْقُصُكَ شَيْئًا ، فَأَعْطَاهَا وَدَلَّتْهُ عَلَى الْقَبْرِ ، فَأَخْرَجَ الْعِظَامَ وَجَاوَزَ الْبَحْرَ  "" .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ بْنُ إِسْحَاقَ الْقُلُوسِيُّ  "" .","","Al-Mu'jam al-Awsat 7767","","علي بن أبي طالب عن حبة بن جوين العرني عن المنهال بن عمرو الأسدي عن خالد بن طهمان السلولي عن محمد بن كثير القرشي عن الحسن بن عنبسة الوراق عن يعقوب بن إسحاق الجيزي عن محمد بن يعقوب الأصم عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7774","7768  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  ثَنَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  نَا  مُحَمَّدُ بْنُ         [7/376]      عُمَرَ الْوَاقِدِيُّ ،  نَا  كَثِيرُ بْنُ زَيْدٍ ،  عَنْ  عُمَرَ بْنِ عَبْدِ اللهِ بْنِ سُرَاقَةَ الْعَدَوِيِّ  ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ - رَضِيَ اللهُ عَنْهَا - قَالَتْ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ اقْتَطَعَ حَقَّ امْرِئٍ بِيَمِينٍ يَحْلِفُهَا عَلَى مِنْبَرِي بِغَيْرِ حَقٍّ  ،  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُرْوَةَ  إِلَّا  عُمَرُ بْنُ عَبْدِ اللهِ  ، وَلَا رَوَاهُ عَنْ  عُمَرَ  إِلَّا  كَثِيرُ بْنُ زَيْدٍ  ،  تَفَرَّدَ بِهِ  :  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ  "" .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( عثمان بن عبد الله بن سراقة العدوي )","","Al-Mu'jam al-Awsat 7768","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عثمان بن عبد الله بن سراقة القرشي عن كثير بن زيد السهمي عن الواقدي عن حفص بن عمرو الربالي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7775","7769  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  نَا  بَهْزُ بْنُ أَسَدٍ ،  نَا  يَزِيدُ بْنُ إِبْرَاهِيمَ التُّسْتَرِيُّ ،  نَا  الْحَسَنُ قَالَ :  قَالَ  سَمُرَةُ بْنُ جُنْدُبٍ :  مَا قَامَ فِينَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا أَمَرَنَا بِالصَّدَقَةِ  ، وَنَهَانَا عَنِ  الْمُثْلَةِ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ بْنِ إِبْرَاهِيمَ  إِلَّا  بَهْزُ بْنُ أَسَدٍ  ،  تَفَرَّدَ بِهِ  :  الرَّبَالِيُّ  "" .","","Al-Mu'jam al-Awsat 7769","","سمرة بن جندب عن الحسن البصري عن يزيد بن إبراهيم التستري عن بهز بن أسد عن حفص بن عمرو الربالي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7776","7770  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  نَا  الْحَسَنُ بْنُ حَبِيبِ بْنِ نَدَبَةَ ،  نَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَبَيْنَ يَدَيْهِ طَعَامٌ ، فَقَالَ :  ادْنُهْ ، وَكُلْ وَسَمِّ اللهَ ، وَكُلْ بِيَمِينِكَ  ، وَكُلْ مِمَّا يَلِيكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  رَوْحِ بْنِ الْقَاسِمِ  إِلَّا  الْحَسَنُ بْنُ حَبِيبٍ  .","","Al-Mu'jam al-Awsat 7770","","عمر بن أبي سلمة المخزومي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن روح بن القاسم العنبري عن الحسن بن حبيب بن ندبة التميمي عن حفص بن عمرو الربالي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7777","7771  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  ثَنَا  حَفْصُ بْنُ عَمْرٍو ،  نَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  نَا  الْحَارِثُ بْنُ حَصِيرَةَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  كَثِيرِ بْنِ نَمِرٍ قَالَ :  دَخَلْتُ  مَسْجِدَ الْكُوفَةِ  عَشِيَّةَ جُمُعَةٍ ، وَعَلِيٌّ يَخْطُبُ النَّاسَ  ، فَقَامُوا مِنْ نَوَاحِي الْمَسْجِدِ يُحَكِّمُونَ ، فَقَالَ بِيَدِهِ هَكَذَا ، ثُمَّ  قَالَ  : "" كَلِمَةُ حَقٍّ يُبْتَغَى بِهَا بَاطِلٌ ، حُكْمَ اللهِ أَنْتَظِرُ فِيكُمْ ، أَنْ أَحْتَكِمَ بِكِتَابِ اللهِ وَسُنَّةِ نَبِيِّهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَأَقْسِمَ بَيْنَكُمْ بِالسَّوِيَّةِ ، وَلَا يَمْنَعُكُمْ مِنْ هَذَا الْمَسْجِدِ أَنْ تُصَلُّوا فِيهِ مَا كَانَتْ أَيْدِيكُمْ مَعَ أَيْدِينَا ، وَلَا نُقَاتِلُكُمْ حَتَّى تُقَاتِلُونَا  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَارِثِ بْنِ حَصِيرَةَ  إِلَّا  مُحَمَّدُ بْنُ كَثِيرٍ الْكُوفِيُّ  .","","Al-Mu'jam al-Awsat 7771","","علي بن أبي طالب عن كثير بن نمر الحضرمي عن سلمة بن كهيل الحضرمي عن الحارث بن حصيرة الأزدي عن محمد بن كثير القرشي عن حفص بن عمرو الربالي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7778","[7/377]      7772  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  عِيسَى بْنُ أَبِي حَرْبٍ الصَّفَّارُ ،  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  نَا  عُمَرُ بْنُ يَزِيدَ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ أَسْلَمَ فَلَا جِزْيَةَ عَلَيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَارِبِ بْنِ دِثَارٍ  إِلَّا  عُمَرُ بْنُ يَزِيدَ  ، وَلَا عَنْ  عُمَرَ  إِلَّا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  ،  تَفَرَّدَ بِهِ  :  عِيسَى بْنُ أَبِي حَرْبٍ  "" .","","Al-Mu'jam al-Awsat 7772","","عبد الله بن عمر بن الخطاب عن محارب بن دثار عن عمر بن زيد الصنعاني عن يحيى بن أبي بكير عن عيسى بن موسى بن أبي حرب الصفار عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7779","7773  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  ثَنَا  عِيسَى بْنُ أَبِي حَرْبٍ ،  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  نَا  شُعْبَةُ ،  عَنْ  حُصَيْنٍ وَسُلَيْمَانَ ،  عَنْ  أَبِي الضُّحَى ،  عَنْ  مَسْرُوقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَشَدُّ النَّاسِ عَذَابًا الْمُصَوِّرُونَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شُعْبَةَ  ، عَنْ  حُصَيْنٍ  إِلَّا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  "" .","","Al-Mu'jam al-Awsat 7773","","عبد الله بن مسعود عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن الأعمش عن شعبة بن الحجاج عن يحيى بن أبي بكير عن عيسى بن موسى بن أبي حرب الصفار عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7780","7774  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  نَا  يَحْيَى بْنُ مَيْمُونٍ ،  نَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ الْأَنْصَارِيِّ قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَائِمًا يُصَلِّي ، فَذَهَبَتْ شَاةٌ تَمُرُّ بَيْنَ يَدَيْهِ ، فَسَاعَاهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى أَلْزَقَهَا بِالْحَائِطِ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَقْطَعُ الصَّلَاةَ شَيْءٌ ، وَادْرَءُوا مَا اسْتَطَعْتُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  إِلَّا  جَرِيرُ بْنُ حَازِمٍ  ،  تَفَرَّدَ بِهِ  :  يَحْيَى بْنُ مَيْمُونٍ  "" .","","Al-Mu'jam al-Awsat 7774","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن جرير بن حازم عن يحيى بن ميمون بن عطاء التمار عن حفص بن عمرو الربالي عن محمد بن يعقوب الكرابيسي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7781","7775  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْقُلُوسِيُّ ،  ثَنَا  عَلِيُّ بْنُ عِيسَى الْهُذَلِيُّ ،  ثَنَا  يَزِيدُ بْنُ عَبْدِ اللهِ الْقُرَشِيُّ ،  نَا  جَوْنَةُ - مَوْلَاةُ أَبِي الطُّفَيْلِ - قَالَتْ :  سَمِعْتُ  أَبَا الطُّفَيْلِ  ، يُحَدِّثُ ، عَنْ  أَبِي الدَّرْدَاءِ قَالَ :  قُلْنَا : يَا رَسُولَ اللهِ ، إِنَّ أُمُورَ  مِنًى  لَعَجَبٌ ، هِيَ ضَيِّقَةٌ ،         [7/378]      فَإِذَا نَزَلَهَا النَّاسُ اتَّسَعَتْ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا مَثَلُ  مِنًى  كَالرَّحِمِ  ، هِيَ ضَيِّقَةٌ ، فَإِذَا حَمَلَتْ وَسَّعَهَا اللهُ  .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي الدَّرْدَاءِ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  يَعْقُوبُ بْنُ إِسْحَاقَ  "" .","","Al-Mu'jam al-Awsat 7775","","أبو الدرداء عن عامر بن واثلة عن جونة عن يزيد بن عبد الله بن وهب بن زمعة عن علي بن عيسى الهذلي عن يعقوب بن إسحاق القلوسي عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7782","7776  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ ،  نَا  عِيسَى بْنُ أَبِي حَرْبٍ الصَّفَّارُ ،  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  نَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  سُلَيْمَانَ التَّيْمِيِّ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَرْجِعُوا بَعْدِي  كُفَّارًا  ، يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُفْيَانَ  إِلَّا  يَحْيَى بْنُ أَبِي بُكَيْرٍ  ،  تَفَرَّدَ بِهِ  :  عِيسَى بْنُ أَبِي حَرْبٍ  "" .","","Al-Mu'jam al-Awsat 7776","","أسامة بن زيد بن حارثة ذو البطين عن أبو عثمان النهدي عن سليمان بن طرخان عن سفيان الثوري عن يحيى بن أبي بكير عن عيسى بن موسى بن أبي حرب الصفار عن محمد بن يعقوب الأهوازي عن الطبراني","محمد بن يعقوب الخطيب الأهوازي"
"7783","7777  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ سَامٍ الْقَاضِي ،  ثَنَا  أَبُو مَعْمَرٍ الْقَطِيعِيُّ ،  ثَنَا  أَبُو إِسْمَاعِيلَ الْمُؤَدِّبُ وَعِيسَى بْنُ يُونُسَ - كِلَاهُمَا -  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِي حَوْضًا ، وَأَنَا  فَرَطُكُمْ  عَلَيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الشَّعْبِيِّ  إِلَّا  مُجَالِدٌ  ، وَلَا عَنْ  مُجَالِدٍ  إِلَّا  أَبُو إِسْمَاعِيلَ  وَعِيسَى بْنُ يُونُسَ  ،  تَفَرَّدَ بِهِ  :  أَبُو مَعْمَرٍ  "" .","","Al-Mu'jam al-Awsat 7777","","أنس بن مالك عن الشعبي عن مجالد بن سعيد عن إبراهيم بن سليمان أبو إسماعيل عن إسماعيل بن إبراهيم المقعد عن محمد بن جعفر بن سام عن الطبراني","محمد بن جعفر بن سلام القاضي"
"7784","7778  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ سَامٍ ،  نَا  الزُّبَيْرُ بْنُ بَكَّارٍ ،  ثَنَا  عَبْدُ الْمَجِيدِ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  حَدَّثَنِي  رَجُلٌ مِنْ  بَنِي قُشَيْرٍ  - يُقَالُ لَهُ :  بَهْزُ بْنُ حَكِيمٍ ،  عَنْ  أَبِيهِ .         [7/379]      عَنْ  جَدِّهِ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  فِي كُلِّ خَمْسِ ذَوْدٍ  سَائِمَةٍ  صَدَقَةٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَعْمَرٍ  ، عَنِ  الزُّهْرِيِّ  إِلَّا  عَبْدُ الْمَجِيدِ  ،  تَفَرَّدَ بِهِ  :  الزُّبَيْرُ  "" وَرَوَاهُ  عَبْدُ الرَّزَّاقِ  ، عَنْ  مَعْمَرٍ  ، عَنْ  بَهْزٍ  .","","Al-Mu'jam al-Awsat 7778","","معاوية بن حيدة القشيري عن حكيم بن معاوية بن حيدة القشيري عن بهز بن حكيم عن الزهري عن معمر بن راشد عن عبد المجيد بن عبد العزيز بن أبي رواد عن الزبير بن بكار عن محمد بن جعفر بن سام عن الطبراني","محمد بن جعفر بن سلام القاضي"
"7785","7779  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ سَامٍ ،  ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  نَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  نَا  زَيْدُ بْنُ عُمَرَ بْنِ عَاصِمٍ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا أَهَلَّ مُهِلٌّ قَطُّ إِلَّا بُشِّرَ  ، وَلَا كَبَّرَ مُكَبِّرٌ قَطُّ إِلَّا بُشِّرَ "" قِيلَ : يَا رَسُولَ اللهِ ، بِالْجَنَّةِ ؟ قَالَ : "" نَعَمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ عُمَرَ بْنِ عَاصِمٍ  إِلَّا  مُعْتَمِرٌ  "" .","","Al-Mu'jam al-Awsat 7779","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن زيد بن عمر بن عاصم عن معتمر بن سليمان عن عبد الأعلى بن حماد النرسي عن محمد بن جعفر بن سام عن الطبراني","محمد بن جعفر بن سلام القاضي"
"7786","7780  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ سَامٍ ،  نَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  نَا  الْمُطَّلِبُ بْنُ زِيَادٍ ،  عَنِ  السُّدِّيِّ ،  عَنْ  عَبْدِ خَيْرٍ ،  عَنْ  عَلِيٍّ ،  فِي قَوْلِهِ :         {      إِنَّمَا أَنْتَ مُنْذِرٌ وَلِكُلِّ قَوْمٍ هَادٍ         }      قَالَ : "" رَسُولُ اللهِ الْمُنْذِرُ ، وَالْهَادِ : رَجُلٌ مِنْ بَنِي هَاشِمٍ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  السُّدِّيِّ  ، إِلَّا  الْمُطَّلِبُ بْنُ زِيَادٍ  ،  تَفَرَّدَ بِهِ  :  عُثْمَانُ  "" .","","Al-Mu'jam al-Awsat 7780","","علي بن أبي طالب عن عبد خير بن يزيد الخيواني عن السدي الكبير عن المطلب بن زياد الثقفي عن عثمان ابن أبي شيبة عن محمد بن جعفر بن سام عن الطبراني","محمد بن جعفر بن سلام القاضي"
"7787","[8/5]      بَابُ مَنِ اسْمُهُ : مَحْمُودٌ  7781  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  نَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ  ، نَا  ثَابِتٌ أَبُو حَمْزَةَ ،  ثَنَا  كَثِيرٌ النَّوَّاءُ ،  عَنْ  رِفَاعَةَ الْفِتْيَانِيِّ قَالَ :  دَخَلْتُ عَلَى  الْمُخْتَارِ  ، فَلَمَّا أَنْ أَرَدْتُ أَنْ أَخْرُجَ قَالَ : يَا  أَبَا عُمَرَ  أَلَا تُعِينُنَا عَلَى هَذَا الْكُرْسِيِّ ، فَإِنَّهُ قَامَ عَنْهُ  جِبْرِيلُ  آنِفًا ، قُلْتُ : بَلَى ، أُعِينُكَ عَلَى أَنْ تُحَرِّقَهُ وَتَنْسِفَهُ فِي الْيَمِّ نَسْفًا ، قَالَ  رِفَاعَةُ  : فَأَهْوَيْتُ بِيَدِي إِلَى قَائِمِ سَيْفِي ، فَقُلْتُ فِي نَفْسِي : أَلَا أَقْتُلُ هَذَا الْكَذَّابَ ، حَتَّى  ذَكَرْتُ  كَلِمَةَ أَخِي عَمْرِو بْنِ الْحَمِقِ أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  مَنِ ائْتَمَنَ رَجُلًا عَلَى دَمِهِ فَقَتَلَهُ فَأَنَا مِنَ الْقَاتِلِ بَرِيءٌ  ، وَإِنْ كَانَ الْمَقْتُولُ كَافِرًا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  كَثِيرٍ النَّوَّاءِ  إِلَّا  ثَابِتٌ أَبُو حَمْزَةَ  ،  تَفَرَّدَ بِهِ  زَحْمَوَيْهِ  .","","Al-Mu'jam al-Awsat 7781","","عمرو بن الحمق بن الكاهن الخزاعي عن رفاعة بن شداد القتباني عن كثير بن إسماعيل النواء عن ثابت بن أبي صفية الثمالي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7788","7782  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  نَا  الْقَاسِمُ بْنُ عِيسَى الطَّائِيُّ ،  ثَنَا  رَحْمَةُ بْنُ مُصْعَبٍ الْبَاهِلِيُّ ،  عَنْ  عُثْمَانَ بْنِ سَعِيدٍ الْكَاتِبِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  كُنَّا نَجْلِسُ عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَأَنَّمَا عَلَى رُؤُوسِنَا الطَّيْرُ  مَا يَتَكَلَّمُ مِنَّا أَحَدٌ ، إِلَّا  أَبُو بَكْرٍ  ،  وَعُمَرُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُثْمَانَ بْنِ سَعِيدٍ  ، إِلَّا  رَحْمَةُ بْنُ مُصْعَبٍ  ،  تَفَرَّدَ بِهِ  الْقَاسِمُ بْنُ عِيسَى  ""  .","","Al-Mu'jam al-Awsat 7782","","أنس بن مالك عن عثمان بن سعد التميمي عن رحمة بن مصعب الواسطي عن القاسم بن عيسى بن إبراهيم الطائي عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7789","[8/6]      7783  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  نَا  أَبُو بَكْرِ بْنُ خَلَّادٍ الْبَاهِلِيُّ ،  ثَنَا  أَزْهَرُ بْنُ سَعْدٍ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  كُنَّا نُؤْمَرُ أَنْ نَنْقُضَ مَزَاوِدَنَا بَعْدَ ثَلَاثٍ  يَعْنِي : الْأَضَاحِيِّ  ""  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ عَوْنٍ  إِلَّا  أَزْهَرُ  ،  تَفَرَّدَ بِهِ  :  أَبُو بَكْرِ بْنُ خَلَّادٍ  .","","Al-Mu'jam al-Awsat 7783","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عون بن أرطبان عن أزهر بن سعد السمان عن محمد بن خلاد الباهلي عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7790","7784  -  حَدَّثَنَا  مَحْمُودٌ  نَا  الْقَاسِمُ بْنُ عِيسَى الطَّائِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ ثَابِتٍ ،  ثَنَا  نَافِعٌ قَالَ :  انْطَلَقْتُ مَعَ  ابْنِ عُمَرَ  فِي حَاجَةٍ إِلَى  ابْنِ عَبَّاسٍ  ، فَقَضَى ابْنُ عُمَرَ حَاجَتَهُ مِنِ  ابْنِ عَبَّاسٍ  ، وَكَانَ حَدِيثُهُ يَوْمَئِذٍ أَنْ قَالَ : مَرَّ  رَجُلٌ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سِكَّةٍ مِنَ السِّكَكِ ، وَقَدْ خَرَجَ مِنْ بَوْلٍ وَغَائِطٍ ، فَسَلَّمَ عَلَيْهِ ، فَلَمْ يَرُدَّ عَلَيْهِ السَّلَامَ ، حَتَّى إِذَا كَادَ الرَّجُلُ أَنْ يَتَوَارَى فِي السِّكَّةِ "" ضَرَبَ بِيَدِهِ عَلَى الْحَائِطِ ، فَمَسَحَ وَجْهَهُ ، ثُمَّ ضَرَبَ ضَرْبَةً أُخْرَى بِيَدِهِ عَلَى الْحَائِطِ ، فَمَسَحَ ذِرَاعَيْهِ ، ثُمَّ رَدَّ عَلَى الرَّجُلِ السَّلَامَ "" قَالَ :  إِنَّهُ لَمْ يَمْنَعْنِي أَنْ أَرُدَّ عَلَيْكَ السَّلَامَ إِلَّا أَنِّي لَمْ أَكُنْ عَلَى طُهْرٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ عُمَرَ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَمْ يَذْكُرِ التَّيَمُّمَ إِلَّا  نَافِعٌ  .","","Al-Mu'jam al-Awsat 7784","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن ثابت العبدي عن القاسم بن عيسى بن إبراهيم الطائي عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7791","7785  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ :  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ  ثَنَا  صَالِحُ بْنُ عُمَرَ ،  عَنْ  مُطَرِّفِ بْنِ طَرِيفٍ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:  إِذَا بَلَغَ  بَنُو الْحَكَمِ  ثَلَاثِينَ اتَّخَذُوا دِينَ اللهِ  دَغَلًا  ، وَعِبَادَ اللهِ  خَوَلًا  ، وَمَالَ اللهِ  دُوَلًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُطَرِّفٍ  إِلَّا  صَالِحُ بْنُ عُمَرَ  ،  تَفَرَّدَ بِهِ  زَحْمَوَيْهِ  .","","Al-Mu'jam al-Awsat 7785","","أبو سعيد الخدري عن عطية بن سعد العوفي عن مطرف بن طريف عن صالح بن عمر الواسطي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7792","7786  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ :  نَا  زَكَرِيَّا بْنُ يَحْيَى         [8/7]      زَحْمَوَيْهِ ،  ثَنَا  صَالِحُ بْنُ عُمَرَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الرَّحْمَنِ الْهَاشِمِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْيَمِينُ فِي الْبَيْعِ  مَنْفَقَةٌ  مَمْحَقَةٌ  لِلْكَسْبِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ  إِلَّا  صَالِحُ بْنُ عُمَرَ  ،  تَفَرَّدَ بِهِ  :  زَحْمَوَيْهِ  .","","Al-Mu'jam al-Awsat 7786","","أبو هريرة الدوسي عن عباس بن عبد الرحمن الهاشمي عن داود بن أبي هند عن صالح بن عمر الواسطي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7793","7787  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ قَالَ :  جَاءَ  رَجُلٌ مِنَ الْأَنْصَارِ  يَسْعَى عَلَى بَعِيرٍ لَهُ ، فَلَمَّا أُقِيمَتْ صَلَاةُ الْمَغْرِبِ أَتَى الْمَسْجِدَ ، فَوَجَدَ  مُعَاذَ بْنَ جَبَلٍ  يَؤُمُّهُمْ ، فَافْتَتَحَ سُورَةَ  الْبَقَرَةِ أَوْ آلِ عِمْرَانَ  ، فَلَمَّا رَأَى ذَلِكَ الرَّجُلُ انْصَرَفَ فَصَلَّى نَاحِيَةً ، ثُمَّ لَحِقَ بِبَعِيرِهِ ، فَقَالَ  أَهْلُ الْمَدِينَةِ  : نَافَقَ فُلَانٌ ، فَلَمَّا سَمِعَ ذَلِكَ الرَّجُلُ أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ ، فَدَعَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مُعَاذًا  ، فَقَالَ :  أَفَتَّانٌ  أَنْتَ ، أَفَلَا قَرَأْتَ بِـ         {      وَالشَّمْسِ وَضُحَاهَا         }      ، وَ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الشَّيْبَانِيِّ  ، إِلَّا  خَالِدٌ  .","","Al-Mu'jam al-Awsat 7787","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محارب بن دثار عن سليمان بن فيروز الشيباني عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7794","7788  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  ثَنَا  خَالِدٌ ،  عَنِ  الشَّيْبَانِيِّ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَخِيهِ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ  ، قَالَ :  قَالَ  أَبُو هُرَيْرَةَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِنَّ فِي الْجُمُعَةِ لَسَاعَةً مَا يَسْأَلُ اللهَ فِيهَا عَبْدٌ شَيْئًا قَطُّ إِلَّا أَعْطَاهُ اللهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الشَّيْبَانِيِّ  إِلَّا  خَالِدٌ  .","","Al-Mu'jam al-Awsat 7788","","أبو هريرة الدوسي عن عبيد الله بن عبد الله بن عتبة بن مسعود عن عون بن عبد الله بن عتبة عن سليمان بن فيروز الشيباني عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7795","7789  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ  نَا         [8/8]      سِنَانُ بْنُ هَارُونَ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّيْبَانِيِّ قَالَ :  قُلْتُ لِابْنِ عُمَرَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  إِنَّ قَوْمًا يَأْمُرُونَا أَنْ نَصْعَدَ عَلَى الْمَنَابِرِ فَنَتَكَلَّمَ ، فَإِذَا نَزَلْنَا فَوَاللهِ لَأَنْ يَخِرَّ أَحَدُنَا مِنَ السَّمَاءِ أَحَبُّ إِلَيْهِ مِنْ أَنْ يَثْبُتَ عَلَى شَيْءٍ مِنْهَا  قَالَ  :  كَانَ هَذَا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نِفَاقًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُجَالِدٍ  إِلَّا  سِنَانُ بْنُ هَارُونَ  ،  تَفَرَّدَ بِهِ  :  زَحْمَوَيْهِ  .","","Al-Mu'jam al-Awsat 7789","","عبد الله بن عمر بن الخطاب عن الشعبي عن مجالد بن سعيد عن سنان بن هارون البرجمي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7796","7790  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ  ثَنَا  زَكَرِيَّا  ، نَا  شَرِيكٌ ،  عَنْ  عَامِرِ بْنِ شَقِيقٍ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ قَالَ :  رَمَقْتُ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَقْطَعِ التَّلْبِيَةَ حَتَّى رَمَى  جَمْرَةَ الْعَقَبَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَامِرِ بْنِ شَقِيقٍ  إِلَّا  شَرِيكٌ  ،  تَفَرَّدَ بِهِ  :  زَحْمَوَيْهِ  .","","Al-Mu'jam al-Awsat 7790","","عبد الله بن مسعود عن شقيق بن سلمة عن عامر بن شقيق الأسدي عن شريك بن عبد الله النخعي عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7797","7791  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ ،  ثَنَا  زَكَرِيَّا ،  ثَنَا  هُشَيْمٌ ،  عَنْ  طَلْحَةَ أَبِي مُحَمَّدٍ ، مَوْلَى بَاهِلَةَ ،  ثَنَا  قَتَادَةُ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ،  عَنْ  عَمْرِو بْنِ خَارِجَةَ الْأَشْعَرِيِّ قَالَ :  شَهِدْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  حَجَّتَهُ ،  إِنِّي لَبَيْنَ  جِرَانِ  نَاقَةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَهِيَ  تَقْصَعُ  بِجِرَّتِهَا  ، وَلُعَابُهَا يَسِيلُ بَيْنَ كَتِفَيَّ ، فَسَمِعْتُهُ يَقُولُ :  أَلَا إِنَّ اللهَ قَدْ أَعْطَى كُلَّ ذِي  حَقٍّ  حَقَّهُ ،  لَا وَصِيَّةَ لِوَارِثٍ ، وَالْوَلَدُ  لِلْفِرَاشِ ،  وَلِلْعَاهِرِ  الْحَجَرُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  طَلْحَةَ بْنِ عَبْدِ الرَّحْمَنِ  إِلَّا  هُشَيْمٌ  .","","Al-Mu'jam al-Awsat 7791","","عمرو بن خارجة بن المنتفق الأسدي عن عبد الرحمن بن غنم الأشعري عن شهر بن حوشب عن قتادة بن دعامة عن طلحة أبي محمد مولى باهلة عن هشيم بن بشير عن زكريا بن يحيى زحمويه عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7798","7792  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  أَبُو مُصْعَبٍ أَحْمَدُ بْنُ أَبِي بَكْرٍ الزُّهْرِيُّ :  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  عَنِ  ابْنِ أَخِي ابْنِ شِهَابٍ ،  عَنْ  عَمِّهِ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  قَالَ :  "" سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكْثَرَ مِنْ أَرْبَعِينَ صَبَاحًا فِي  غَزْوَةِ تَبُوكَ  يَقْرَأُ فِي الرَّكْعَتَيْنِ قَبْلَ الْفَجْرِ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }             [8/9]      وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا ابْنُ أَخِيهِ ، وَلَا عَنِ  ابْنِ أَخِي الزُّهْرِيِّ  ، إِلَّا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ  ،  تَفَرَّدَ بِهِ  :  أَبُو مُصْعَبٍ  ""  .","","Al-Mu'jam al-Awsat 7792","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن أحمد بن أبي بكر العوفى عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7799","7793  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ ،  نَا  الصَّلْتُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ ،  نَا  أَبُو صَيْفِيٍّ  نَا  عُبَيْدُ بْنُ هَمَّامٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  مِنَ السُّنَّةِ إِذَا دَعَا الرَّجُلُ أَخَاهُ أَنْ يَقُومَ مَعَهُ حَتَّى يَخْرُجَ  ""  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عِكْرِمَةَ  إِلَّا  عُبَيْدُ بْنُ هَمَّامٍ  ، وَلَا عَنْ  عُبَيْدٍ  إِلَّا  أَبُو صَيْفِيٍّ  ،  تَفَرَّدَ بِهِ  :  الصَّلْتُ  .","","Al-Mu'jam al-Awsat 7793","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عبيد بن همام عن بشير بن ميمون الواسطي عن الصلت بن مسعود الجحدري عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
"7800","7794  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ ،  ثَنَا  الْقَاسِمُ بْنُ سَعِيدِ بْنِ الْمُسَيِّبِ بْنِ شَرِيكٍ  ، نَا  شُجَاعُ بْنُ الْوَلِيدِ قَالَ :  سَمِعْتُ  عَبْدَ الْمَلِكِ بْنَ أَبْجَرَ قَالَ :  سَمِعْتُ  زِرَّ بْنَ حُبَيْشٍ قَالَ :  كَانَ أُبَيُّ بْنُ كَعْبٍ يَحْلِفُ بِاللهِ ، "" إِنَّ لَيْلَةَ الْقَدْرِ لَيْلَةُ سَبْعٍ وَعِشْرِينَ  لَا يَسْتَثْنِي ، قَالَ : قُلْنَا لَهُ : مِنْ أَيْنَ عَرَفْتَ ذَلِكَ ؟ قَالَ : بِالْآيَةِ الَّتِي أَخْبَرَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَحَسَبْنَا وَحَفِظْنَا أَنَّهَا لَيْلَةُ سَبْعٍ وَعِشْرِينَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبْجَرَ  إِلَّا  شُجَاعُ بْنُ وَلِيدٍ  ،  تَفَرَّدَ بِهِ  :  الْقَاسِمُ بْنُ سَعِيدٍ  .","","Al-Mu'jam al-Awsat 7794","","أبي بن كعب عن زر بن حبيش الثعلبي عن عبد الملك بن سعيد بن حيان عن شجاع بن الوليد السكوني عن القاسم بن سعيد بن المسيب التميمي عن محمود بن محمد بن منويه المفيد عن الطبراني","محمود بن محمد الواسطي"
