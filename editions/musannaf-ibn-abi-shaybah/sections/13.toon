hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"12025","(۱۲۰۲۵) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، أَنَّ عُمَرَ صَلَّی عَلَی عِظَامٍ بِالشَّامِ۔","Da'if","Musannaf Ibn Abi Shaybah 12025","","","كتاب الجنائز"
"12026","(۱۲۰۲۶) حدَّثَنَا مَرْوَانُ ، عَنْ صَاعِدٍ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ سُئِلَ عَنْ قَتِیلٍ وُجِدَ فِی ثَلاَثَۃِ أَحْیَائَ رَأْسُہُ فِی حَیٍّ ، وَوَسَطُہُ فِی حَیٍّ وَرِجْلُہُ فِی حَیٍّ ، قَالَ یُصَلَّی عَلَی الْوَسَطِ۔","","Musannaf Ibn Abi Shaybah 12026","","","كتاب الجنائز"
"12027","(۱۲۰۲۷) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، عَنْ عَامِرِ بْنِ رَبِیعَۃَ ، یَبْلُغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا رَأَیْتُمُ الْجِنَازَۃَ فَقُومُوا لَہَا حَتَّی تُخَلِّفَکُمْ ، أَوْ تُوضَعَ۔ (بخاری ۱۳۰۷۔ ابوداؤد ۳۱۶۴)","Sahih","Musannaf Ibn Abi Shaybah 12027","","","كتاب الجنائز"
"12028","(۱۲۰۲۸) حدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عَامِرِ بْنِ رَبِیعَۃ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَ حَدِیثِ سُفْیَانَ ، عَنِ الزُّہْرِیِّ ، أَوْ نَحْوَہُ۔ (بخاری ۱۳۰۸۔ مسلم ۷۵)","Sahih","Musannaf Ibn Abi Shaybah 12028","","","كتاب الجنائز"
"12029","(۱۲۰۲۹) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مُرَّ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِجِنَازَۃٍ فَقَامَ ، وَقَالَ لِمَنْ مَعَہُ ، قُومُوا فَإِنَّ لِلْمَوْتِ فَزَعًا۔ (ابن ماجہ ۱۵۴۳۔ احمد ۲/۲۸۷)","Hasan","Musannaf Ibn Abi Shaybah 12029","","","كتاب الجنائز"
"12030","(۱۲۰۳۰) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ : عَنْ خَارِجَۃَ بْنِ زَیْدٍ ، عَنْ عَمِّہِ یَزِیدَ بْنِ ثَابِتٍ ، أَنَّہُ کَانَ جَالِسًا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی أَصْحَابِہِ فَطَلَعَتْ جِنَازَۃٌ ، فَلَمَّا رَآہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَارَ وَثَارَ أَصْحَابُہُ فَلَمْ یَزَالُوا قِیَامًا حَتَّی تَعَدَّتْ ، وَاللَّہِ مَا أَدْرِی مِنْ تَأَذُّ بِہَا ، أَوْ مِنْ تَضَایُقِ الْمَکَانِ وَمَا أَحْسَبُہَا إِلاَّ یَہُودِیۃ ، أَوْ یَہُودِیًّا ، وَمَا سَأَلْنَاہُ عَنْ قِیَامِہِ۔ (احمد ۴/۳۸۸۔ حاکم ۵۹۱)","","Musannaf Ibn Abi Shaybah 12030","","","كتاب الجنائز"
"12031","(۱۲۰۳۱) حدَّثَنَا مُعَاوِیَۃُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی مَعْمَرٍ عَبْدِ اللہِ بْنِ سَخْبَرَۃَ ، أَنَّ أَبَا مُوسَی أَخْبَرَہُمْ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا مَرَّتْ بِہِ جِنَازَۃٌ قَامَ حَتَّی تُجَاوِزَہُ۔ (ابویعلی ۲۶۶)","Da'if","Musannaf Ibn Abi Shaybah 12031","","","كتاب الجنائز"
"12032","(۱۲۰۳۲) حدَّثَنَا الْفَضْلُ ، وَکَثِیرُ بْنُ ہِشَامٍ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا رَأَیْتُمُ الْجِنَازَۃَ فَقُومُوا۔","Sahih","Musannaf Ibn Abi Shaybah 12032","","","كتاب الجنائز"
"12033","(۱۲۰۳۳) حدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ : عَنْ أَبِی سَعِیدٍ ، أَنَّہُ مَرَّتْ بِہِ جِنَازَۃٌ فَقَامَ ، فَقَالَ لَہُ مَرْوَانُ : اجْلِسْ ، فَقَالَ : إنِّی رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّتْ بِہِ جِنَازَۃٌ فَقَامَ ، فَقَامَ مَرْوَانُ۔n(نسائی ۲۰۴۶۔ احمد ۳/۵۳)","","Musannaf Ibn Abi Shaybah 12033","","","كتاب الجنائز"
"12034","(۱۲۰۳۴) حدَّثَنَا وَکِیعٌ، عَنْ زَکَرِیَّا، عَنِ الشَّعْبِیِّ، عَنِ ابْنِ أَبِی لَیْلَی، أَنَّ قَیْسًا وَأَبَا مَسْعُودٍ مَرَّتْ بِہِمَا جِنَازَۃٌ فَقَامَا۔","","Musannaf Ibn Abi Shaybah 12034","","","كتاب الجنائز"
"12035","(۱۲۰۳۵) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : قالُوا لِعَلِیٍّ : إنَّ أَبَا مُوسَی أَمَرَ بِذَلِکَ ، وَقَالَ : إنَّ الْمَلاَئِکَۃَ یَکُونُونَ مَعَہَا فَقُومُوا لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 12035","","","كتاب الجنائز"
"12036","(۱۲۰۳۶) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا عَلِمْت أَحَدًا کَانَ یَقُومُ إذَا مَرُّوا عَلَیْہِ بِالْجِنَازَۃِ غَیْرَ عَمْرِو بْنِ مَیْمُونٍ۔","","Musannaf Ibn Abi Shaybah 12036","","","كتاب الجنائز"
"12037","(۱۲۰۳۷) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بشر ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ شَہِدَہ وَسَالِمِ بْنِ عَبْدِ اللہِ وَمَرَّتْ بِہِمَا جِنَازَۃٌ فَقَامَ سَالِمٌ ، وَلَمْ یَقُمْ سَعِیدٌ۔","","Musannaf Ibn Abi Shaybah 12037","","","كتاب الجنائز"
"12038","(۱۲۰۳۸) حدَّثَنَا وَکِیعٌ ، عَنِ الْوَلِیدِ بْنِ الْمُہَاجِرِ ، قَالَ : رَأَیْتُ الشَّعْبِیَّ مَرَّتْ بِہِ جِنَازَۃٌ فَقَامَ۔","","Musannaf Ibn Abi Shaybah 12038","","","كتاب الجنائز"
"12039","(۱۲۰۳۹) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ الْحَسَنُ بْنُ عَلِیٍّ جَالِسًا فَمُرَّ عَلَیْہِ جِنَازَۃٌ فَقَامَ النَّاسُ حِینَ طَلَعَتِ الْجِنَازَۃُ ، فَقَالَ : الْحَسَنُ بْنُ عَلِیٍّ إنَّمَا مُرَّ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِجِنَازَۃِ یَہُودِیٍّ وَکَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی طَرِیقِہَا جَالِسًا فَکَرِہَ أَنْ یَعْلُوَ رَأْسَہُ جِنَازَۃُ یَہُودِیّۃ فَقَامَ۔ (نسائی ۲۰۵۴۔ احمد ۱/۲۰۱)","Sahih","Musannaf Ibn Abi Shaybah 12039","","","كتاب الجنائز"
"12040","(۱۲۰۴۰) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، أَنَّ قَیْسَ بْنَ سَعْدٍ وَسَہْلَ بْنَ حُنَیْفٍ کَانَا بِالْقَادِسِیَّۃِ ، فَمَرَّتْ بِہِمَا جِنَازَۃٌ فَقَامَا ، فَقِیلَ لَہُمَا : إِنَّہَا مِنْ أَہْلِ الأَرْضِ فَقَالاَ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّتْ بِہِ جِنَازَۃٌ فَقَامَ فَقِیلَ لَہُ ، أَنَّہُ یَہُودِیٌّ ، فَقَالَ : أَلَیْسَتْ نَفْسًا۔ (بخاری ۱۳۱۲۔ مسلم ۶۶۱)","Sahih","Musannaf Ibn Abi Shaybah 12040","","","كتاب الجنائز"
"12041","(۱۲۰۴۱) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی مَعْمَرٍ ، عَنْ عَلِیٍّ ، قَالَ : کُنَّا جُلُوسًا فَمَرَّتْ جِنَازَۃٌ فَقُمْنَا ، فَقَالَ : مَا ہَذَا فَقُلْنَا ہَذَا أَمْرُ أَبِی مُوسَی ، فَقَالَ : إنَّمَا قَامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّۃً ، ثُمَّ لَمْ یَعُدْ۔ (احمد ۱۴۲۔ نسائی ۲۰۵۰)","Sahih","Musannaf Ibn Abi Shaybah 12041","","","كتاب الجنائز"
"12042","(۱۲۰۴۲) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : کُنَّا مَعَ عَلِیٍّ فَمُرَّ عَلَیْنَا بِجِنَازَۃٍ ، فَقَامَ رَجُلٌ ، فَقَالَ عَلِیٌّ : مَا ہَذَا لکَأنَ ہَذَا مِنْ صَنِیعِ الْیَہُودِ۔","Da'if","Musannaf Ibn Abi Shaybah 12042","","","كتاب الجنائز"
"12043","(۱۲۰۴۳) حدَّثَنَا عبد الوہاب الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ ، وَابْنِ عَبَّاسٍ أَنَّہُمَا رَأَیَا جِنَازَۃً فَقَامَ أَحَدُہُمَا وَقَعَدَ الآخَرُ ، فَقَالَ الَّذِی قَامَ لِلَّذِی لَمْ یَقُمْ أَلَمْ یَقُمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : بَلَی ، ثُمَّ قَعَدَ۔ (نسائی ۲۰۵۲۔ طبرانی ۲۷۴۷)","Sahih","Musannaf Ibn Abi Shaybah 12043","","","كتاب الجنائز"
"12044","(۱۲۰۴۴) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ أَصْحَابُ عَلِیٍّ وَأَصْحَابُ عَبْدِ اللہِ لاَ یَقُومُونَ لِلْجَنَائِزِ إذَا مَرَّتْ بِہِمْ۔","","Musannaf Ibn Abi Shaybah 12044","","","كتاب الجنائز"
"12045","(۱۲۰۴۵) حدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ تَمُرُّ بِہِمُ الْجَنَائِزُ فَلاَ یَقُومُ مِنْہُمْ أَحَدٌ۔","","Musannaf Ibn Abi Shaybah 12045","","","كتاب الجنائز"
"12046","(۱۲۰۴۶) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَمْ یَکُونُوا یَقُومُوا لِلْجَنَائِزِ إذَا مَرَّتْ بِہِمْ۔","","Musannaf Ibn Abi Shaybah 12046","","","كتاب الجنائز"
"12047","(۱۲۰۴۷) حدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، قَالَ : کَانَ عَطَائٌ وَمُجَاہِدٌ یَرَیَانِ الْجِنَازَۃَ ، فَلاَ یَقُومَانِ إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 12047","","","كتاب الجنائز"
"12048","(۱۲۰۴۸) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ مَسْعُودِ بْنِ الْحَکَمِ ، قَالَ : قَالَ عَلِیٌّ قَامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْجِنَازَۃِ فَقُمْنَا ، ثُمَّ جَلَسَ فَجَلَسْنَا۔ (ابوداؤد ۳۱۶۷۔ ترمذی ۱۰۴۴)","Sahih","Musannaf Ibn Abi Shaybah 12048","","","كتاب الجنائز"
"12049","(۱۲۰۴۹) حدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ أَرْطَاۃَ بْنِ الْمُنْذِرِ ، أَنَّ أَبَا الدَّرْدَائِ عَادَ جَارًا لَہُ یَہُودِیًّا۔","","Musannaf Ibn Abi Shaybah 12049","","","كتاب الجنائز"
"12050","(۱۲۰۵۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ عَنِ الأَعْمَشِ ، عَنْ یَحْیَی بْنِ عُمَارَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ أَبَا طَالِبٍ مَرِضَ فَعَادَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ترمذی ۳۲۳۲۔ حاکم ۴۳۲)","Da'if","Musannaf Ibn Abi Shaybah 12050","","","كتاب الجنائز"
"12051","(۱۲۰۵۱) حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، عَنْ عَبْدِ اللہِ بْنِ جُبَیْرٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ شَابٌّ یَہُودِیٌّ یَخْدُمُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَرِضَ فَأَتَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعُودُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 12051","","","كتاب الجنائز"
"12052","(۱۲۰۵۲) حدَّثَنَا أَبُو أسامۃ ، عَنِ الأَعْمَشِ ، قَالَ : حدَّثَنَا عَبَّادٌ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ أَبَا طَالِبٍ مَرِضَ فَعَادَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 12052","","","كتاب الجنائز"
"12053","(۱۲۰۵۳) حدَّثَنَا ہُشَیْمٌ وَحَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عَبَّاسٍ : قَالَ : صَلَّی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی قَبْرٍ بَعْدَ مَا دُفِنَ۔ (بخاری ۱۳۱۹۔ ابوداؤد ۵۳)","Sahih","Musannaf Ibn Abi Shaybah 12053","","","كتاب الجنائز"
"12054","(۱۲۰۵۴) حدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عُثْمَانُ بْنُ حَکِیمٍ ، أَخْبَرَنَا خَارِجَۃُ بْنُ زَیْدٍ ، عَنْ عَمِّہِ یَزِیدَ بْنِ ثَابِتٍ وَکَانَ أَکْبَرَ مِنْ زَیْدٍ ، قَالَ : خَرَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا وَرَدْنَا الْبَقِیعَ إذَا ہُوَ بِقَبْرٍ جَدِیدٍ فَسَأَلَ عَنْہُ فَقَالُوا : ہَذِہِ فُلاَنَۃٌ فَعَرَفَہَا ، فَأَتَی الْقَبْرَ وَصَفَفْنَا خَلْفَہُ ، فَکَبَّرَ عَلَیْہَا أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 12054","","","كتاب الجنائز"
"12055","(۱۲۰۵۵) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، أَنَّ الْبَرَائَ بْنَ مَعْرُورٍ تُوُفِّیَ قَبْلَ قُدُومِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَدِینَۃَ ، فَلَمَّا قَدِمَ صَلَّی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 12055","","","كتاب الجنائز"
"12056","(۱۲۰۵۶) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، حدَّثَنَا سُفْیَان ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی مَیِّتٍ بَعْدَ مَا دُفِنَ۔ (ابویعلی ۲۵۱۷)","","Musannaf Ibn Abi Shaybah 12056","","","كتاب الجنائز"
"12057","(۱۲۰۵۷) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّ أُمَّ سَعْدِ بْنِ عُبَادَۃَ مَاتَتْ وَہُوَ غَائِبٌ ، فَلَمَّا قَدِمَ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ إنِّی أُحِبُّ أَنْ تُصَلِّیَ عَلَی أُمِّ سَعْدٍ فَأَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَبْرَہَا فَصَلَّی عَلَیْہَا۔ (ترمذی ۱۰۳۸۔ بیہقی ۴۸)","","Musannaf Ibn Abi Shaybah 12057","","","كتاب الجنائز"
"12058","(۱۲۰۵۸) حدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَتَی الْبَقِیعَ فَرَأَی قَبْرًا جَدِیدًا ، فَقَالَ : مَا ہَذَا الْقَبْرُ ؟ فَقِیلَ : فُلاَنَۃُ مَوْلاَۃُ بَنِی غَنْمٍ الَّتِی کَانَتْ تَقُمُّ الْمَسْجِدَ فَصَلَّی عَلَیْہَا۔n(عبدالرزاق ۶۵۴۱)","","Musannaf Ibn Abi Shaybah 12058","","","كتاب الجنائز"
"12059","(۱۲۰۵۹) حدَّثَنَا ہُشَیْمٌ ، أَخبَرَنَا أَشْعَثُ ، عَنِ الشَّعْبِیِّ ، قَالَ : جَائَ قَرَظَۃُ بْنُ کَعْبٍ فِی رَہْطٍ مَعَہُ ، وَقَدْ صلَّی عَلِیٌّ علی ابْنِ حُنَیْفٍ وَدُفِنَ ، فَأَمَرَہُ عَلِیٌّ أَنْ یُصَلِّیَ ہُوَ وَأَصْحَابُہُ عَلَی الْقَبْرِ ، فَفَعَلَ۔","","Musannaf Ibn Abi Shaybah 12059","","","كتاب الجنائز"
"12060","(۱۲۰۶۰) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : جَائَ سَلْمَانُ بْنُ رَبِیعَۃَ وَقَدْ صَلَّی عَبْدُ اللہِ عَلَی جِنَازَۃٍ ، فَقَالَ لَہُ عَبْدُ اللہِ : تَقَدَّمْ فَصَلِّ عَلَی أَخِیک بِأَصْحَابِک۔","","Musannaf Ibn Abi Shaybah 12060","","","كتاب الجنائز"
"12061","(۱۲۰۶۱) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبَانٍَ الْعَطَّارِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ أَنَّہ بَلَغَہُ أَنَّ أَنَسًا صَلَّی عَلَی جِنَازَۃٍ بعد أَنَّ صُلِّیَ عَلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 12061","","","كتاب الجنائز"
"12062","(۱۲۰۶۲) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ تُوُفِّیَ عَبْدُ الرَّحْمَنِ بْنُ أَبِی بَکْرٍ فِی مَنْزِلٍ کَانَ فِیہِ فَحَمَلْنَاہُ عَلَی رِقَابِنَا سِتَّۃَ أَمْیَالٍ إلَی مَکَّۃَ وَعَائِشَۃُ غَائِبَۃٌ فَقَدِمَتْ بَعْدَ ذَلِکَ ، فَقَالَتْ أَرُونِی قَبْرَہُ فَأَرُوہَا فَصَلَّتْ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 12062","","","كتاب الجنائز"
"12063","(۱۲۰۶۳) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ تُوُفِّیَ عَاصِمُ بْنُ عُمَرَ ، وَابْنُ عُمَرَ غَائِبٌ فَقَدِمَ بَعْدَ ذَلِکَ ، قَال أَیُّوبُ أَحْسَبُہُ ، قَالَ بِثَلاَثٍ ، قَالَ : فَقَالَ : أَرُونِی قَبْرَ أَخِی فَأَرُوہُ فَصَلَّی عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 12063","","","كتاب الجنائز"
"12064","(۱۲۰۶۴) حدَّثَنَا ہُشَیْمٌ ، أَخْبَرَنَا أَبُو حُرَّۃَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ یَقُولُ إذَا سُبِقَ الرّجلُ بِالْجِنَازَۃِ فلیُصَلّ عَلَی الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 12064","","","كتاب الجنائز"
"12065","(۱۲۰۶۵) حدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، قَالَ : کُنْتُ مَعَ ابْنِ سِیرِینَ وَنَحْنُ نُرِیدُ جِنَازَۃً فَسُبِقْنَا بِہَا حَتَّی دُفِنَتْ ، قَالَ : فَقَالَ ابْنُ سِیرِینَ : تَعَالَ حَتَّی نَصْنَعَ کَمَا صَنَعُوا ، قَالَ : فَکَبَّرَ عَلَی الْقَبْرِ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 12065","","","كتاب الجنائز"
"12066","(۱۲۰۶۶) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، حدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ الْمُرَادِیِّ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ خَیْثَمَۃَ ، أَنَّ أَبَا مُوسَی صَلَّی عَلَی الْحَارِثِ بْنِ قَیْسٍ بَعْدَ مَا صُلِّیَ عَلَیْہِ ، أَدْرَکَہُمْ فِی الْجَبَّانَۃِ ، فَصَلَّی عَلَیْہِ بَعْدَ مَا صُلِّیَ عَلَیْہِ ، قَالَ یَحْیَی : وَقَالَ شَرِیکٌ مَرَّۃً : أَمَّ أَبُو مُوسَی عَلَیْہِ وَاسْتَغْفَرَ لَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 12066","","","كتاب الجنائز"
"12067","(۱۲۰۶۷) حدَّثَنَا أَبُو دَاوُدَ ، عَنِ الْمُثَنَّی بْنِ سَعِیدٍ ، عَنْ قَتَادَۃَ ، أَنَّ بُشَیْرَ بْنَ کَعْبٍ انْتَہَی إلَی جِنَازَۃٍ وَقَدْ صُلِّیَ عَلَیْہَا فَصَلَّی۔","","Musannaf Ibn Abi Shaybah 12067","","","كتاب الجنائز"
"12068","(۱۲۰۶۸) حدَّثَنَا سَعِیدُ بْنُ یَحْیَی ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَعُودُ فُقَرَائَ أَہْلِ الْمَدِینَۃِ ، وَیَشْہَدُ جَنَائِزَہُمْ إذَا مَاتُوا ، قَالَ : فَتُوُفِّیَتِ امْرَأَۃٌ مِنْ أَہْلِ الْعَوَالِی فَدَفَنَّاہَا ، قَالَ : فَمَشَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی قَبْرِہَا ، فَصَلَّی عَلَیْہَا وَکَبَّرَ أَرْبَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 12068","","","كتاب الجنائز"
"12069","(۱۲۰۶۹) حدَّثَنَا دَاوُد بْنُ عَبْدِ اللہِ ، حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ ، عَنْ مُحَمَّدِ بْنِ زَیْدِ بْنِ الْمُہَاجِرِ بْنِ قُنْفُذٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ، عَنْ أَبِیہِ ، قَالَ : مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِقَبْرٍ حَدِیثٍ ، فَقَالَ : مَا ہَذَا الْقَبْرُ ؟ فَقَالُوا : قَبْرُ فُلاَنَۃٍ ، قَالَ : فَہَلاَّ آذَنْتُمُونِی ، فَصَفَّ عَلَیْہِ فَصَلَّی ۔(ابن ماجہ ۱۵۲۹۔ احمد ۳/۴۴۴)","Sahih","Musannaf Ibn Abi Shaybah 12069","","","كتاب الجنائز"
"12070","(۱۲۰۷۰) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُصَلَّی عَلَی الْمَیِّتِ مَرَّتَیْنِ۔","","Musannaf Ibn Abi Shaybah 12070","","","كتاب الجنائز"
"12071","(۱۲۰۷۱) حدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو حُرَّۃَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ إذَا سُبِقَ بِالْجِنَازَۃِ یَسْتَغْفِرُ لَہَا وَیَجْلِسُ ، أَوْ یَنْصَرِفُ۔","","Musannaf Ibn Abi Shaybah 12071","","","كتاب الجنائز"
"12072","(۱۲۰۷۲) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ لاَ یَرَی أَنْ یُصَلِّی عَلَی الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 12072","","","كتاب الجنائز"
"12073","(۱۲۰۷۳) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : إنَّ أَخًا لَکُمْ قَدْ مَاتَ ، فَقُومُوا فَصَلُّوا عَلَیْہِ ، یَعْنِی النَّجَاشِیَّ۔ (ترمذی ۱۰۳۹۔ مسلم ۶۷)","Sahih","Musannaf Ibn Abi Shaybah 12073","","","كتاب الجنائز"
"12074","(۱۲۰۷۴) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ أَخَاکُمُ النَّجَاشِیَّ قَدْ مَاتَ فَصَلُّوا عَلَیْہِ۔ (احمد ۴/۴۴۱)","Sahih","Musannaf Ibn Abi Shaybah 12074","","","كتاب الجنائز"
"12075","(۱۲۰۷۵) حدَّثَنَا عَفَّانَ ، حدَّثَنَا بِشْرُ بْنُ مُفَضَّلٍ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِنَحْوٍ مِنْ حَدِیثِ عَبْدِ الأَعْلَی۔ (ترمذی ۱۰۳۹۔ نسائی ۲۱۰۲)","Sahih","Musannaf Ibn Abi Shaybah 12075","","","كتاب الجنائز"
"12076","(۱۲۰۷۶) حدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ حُمْرَانَ بْنِ أَنَسٍ ، عَنْ أَبِی الطُّفَیْلِ ، عَنْ ابن جاریۃ الأَنْصَارِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ أَخَاکُمُ النَّجَاشِیَّ قَدْ مَاتَ فَصَلُّوْا عَلَیْہِ۔n(ابن ماجہ ۱۵۳۶۔ احمد ۴/۶۴)","Da'if","Musannaf Ibn Abi Shaybah 12076","","","كتاب الجنائز"
"12077","(۱۲۰۷۷) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إنَّ النَّجَاشِیَّ قَدْ مَاتَ ، فَخَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَی الْبَقِیعِ وأصحابہ فَصَفَفْنَا خَلْفَہُ وَتَقَدَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَکَبَّرَ أَرْبَعَ تَکْبِیرَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12077","","","كتاب الجنائز"
"12078","(۱۲۰۷۸) حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الشَّعْبِیِّ ، عَنْ جَرِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ أَخَاکُمُ النَّجَاشِیَّ قَدْ مَاتَ فَاسْتَغْفِرُوا لَہُ۔n(احمد ۴/۳۶۳۔ طبرانی ۲۳۴۷)","Hasan","Musannaf Ibn Abi Shaybah 12078","","","كتاب الجنائز"
"12079","(۱۲۰۷۹) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخبرَنَا سَلِیمُ بْنُ حَیَّانَ ، حدَّثَنَا سَعِیدُ بْنُ مِینَائَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ : أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہَ وَسَلَّمَ صَلَّی عَلَی أَصْحَمَۃَ النَّجَاشِیِّ وَکَبَّرَ عَلَیْہِ أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 12079","","","كتاب الجنائز"
"12080","(۱۲۰۸۰) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی عَلَی النَّجَاشِیِّ ، وَقَالَ الْحَسَنُ إنَّمَا دَعَا لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 12080","","","كتاب الجنائز"
"12081","(۱۲۰۸۱) حدَّثَنَا مُعَمَّرُ بْنُ سُلَیْمَانَ الرَّقِّیُّ ، عَنْ حَجَّاجٍ ، عَنْ دَاوُدَ بْنِ الْحُصَیْنِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ الرجُلُ أَحَقُّ بِغُسْلِ امْرَأَتِہِ وَالصَّلاَۃِ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 12081","","","كتاب الجنائز"
"12082","(۱۲۰۸۲) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ إذَا سُبِقَ بِالْجِنَازَۃِ الأَبُ أَحَقُّ بِالصَّلاَۃِ عَلَی الْمَرْأَۃِ ، ثُمَّ الزَّوْجُ ، ثُمَّ الأَخُ۔","","Musannaf Ibn Abi Shaybah 12082","","","كتاب الجنائز"
"12083","(۱۲۰۸۳) حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ ، قَالَ : الرَّجُلُ أَحَقُّ بِامْرَأَتِہِ حَتَّی یُوَارِیَہَا۔","","Musannaf Ibn Abi Shaybah 12083","","","كتاب الجنائز"
"12084","(۱۲۰۸۴) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ یَزِیدَ بْنِ أَبِی سُلَیْمَانَ ، عَنْ مَسْرُوقٍ ، قَالَ : مَاتَتِ امْرَأَۃٌ لِعُمَرَ ، فَقَالَ : أَنَا کُنْت أَوْلَی بِہَا إذْ کَانَتْ حَیَّۃً ، أَمَّا الآنَ فَأَنْتُمْ أَوْلَی بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 12084","","","كتاب الجنائز"
"12085","(۱۲۰۸۵) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا أَیُّہُمَا أَحَقُّ بِالصَّلاَۃِ عَلَی المرأۃ ، فَقَالَ الْحَکَمُ : الأَخُ ، وَقَالَ حَمَّادٌ : قَالَ إبْرَاہِیمُ : الإِمَامُ ، فَإِنْ تَدَارَوْا فَالْوَلِیُّ ، ثُمَّ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 12085","","","كتاب الجنائز"
"12086","(۱۲۰۸۶) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا مَاتَتِ الْمَرْأَۃُ انْقَطَعَتْ عِصْمَۃُ مَا بَیْنَہَا وَبَیْنَ زَوْجِہَا۔","","Musannaf Ibn Abi Shaybah 12086","","","كتاب الجنائز"
"12087","(۱۲۰۸۷) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : الأَبُ وَالاِبْنُ وَالأَخُ أَحَقُّ بِالصَّلاَۃِ عَلَی الْمَرْأَۃِ مِنَ الزَّوْجِ۔","","Musannaf Ibn Abi Shaybah 12087","","","كتاب الجنائز"
"12088","(۱۲۰۸۸) حدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ أَبِی عَرُوبَۃَ، عَنْ قَتَادَۃَ، أَنَّہُ کَانَ یَقُولُ: الأَوْلِیَائُ أَحَقُّ بِالصَّلاَۃِ عَلَیْہَا مِنَ الزَّوْجِ۔","","Musannaf Ibn Abi Shaybah 12088","","","كتاب الجنائز"
"12089","(۱۲۰۸۹) حدَّثَنَا ابْنُ أَبِی غَنِیۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إذَا مَاتَتِ الْمَرْأَۃُ فَقَدِ انْقَطَعَ مَا بَیْنَہَا وَبَیْنَ زَوْجِہَا ، وَأَوْلِیَاؤُہَا أَحَقُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 12089","","","كتاب الجنائز"
"12090","(۱۲۰۹۰) حدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الزَّوْجُ أَحَقُّ مِنَ الأَخِ۔","","Musannaf Ibn Abi Shaybah 12090","","","كتاب الجنائز"
"12091","(۱۲۰۹۱) حدَّثَنَا شَبَابَۃُ ، حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی کَعْبٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ أَبِی بَکْرَۃَ ، قَالَ : کَانَتِ امْرَأَۃٌ مِنْ بَنِی تَمِیمٍ ، امْرَأَۃً لأَبِی بَکْرَۃَ ، فَمَاتَتْ فَتَنَازَعُوا فِی الصَّلاَۃِ عَلَیْہَا ، فَصَلَّی عَلَیْہَا أَبُو بَکْرَۃَ ، وَقَالَ : لَوْلاَ أَنِّی أَحَقّکُم بِالصَّلاَۃِ عَلَیْہَا مَا صَلَّیْت عَلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 12091","","","كتاب الجنائز"
"12092","(۱۲۰۹۲) حدَّثَنَا حَفْصٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : مَا صُلِّیَ عَلَی أَبِی بَکْرٍ إِلاَّ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 12092","","","كتاب الجنائز"
"12093","(۱۲۰۹۳) حدَّثَنَا وَکِیعٌ ، عَنْ کَثِیرِ بْنِ زَیْدٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ ، قَالَ : صُلِّیَ عَلَی أَبِی بَکْرٍ وَعُمَرَ تُجَاہَ الْمِنْبَرِ۔","","Musannaf Ibn Abi Shaybah 12093","","","كتاب الجنائز"
"12094","(۱۲۰۹۴) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ مَالِکِ بْنِ أَنَسٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، أَنَّ عُمَرَ صُلِّیَ عَلَیْہِ فِی الْمَسْجِدِ۔","Sahih","Musannaf Ibn Abi Shaybah 12094","","","كتاب الجنائز"
"12095","(۱۲۰۹۵) حدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، حدَّثَنَا فُلَیْحُ بْنُ سُلَیْمَانَ ، عَنْ صَالِحِ بْنِ الْعَجْلاَنِ ، عَنْ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ: عَنْ عَائِشَۃَ قَالَتْ : وَاللَّہِ مَا صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی سُہَیْلِ ابْنِ بَیْضَائَ إِلاَّ فِی الْمَسْجِدِ۔ (مسلم ۱۰۰۔ ترمذی ۱۰۳۳)","Da'if","Musannaf Ibn Abi Shaybah 12095","","","كتاب الجنائز"
"12096","(۱۲۰۹۶) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، حدَّثَنَا أَشْیَاخُنَا ، أَنَّ عُمَرَ صُلِّیَ عَلَیْہِ عِنْدَ الْمِنْبَرِ فَجَعَلَ النَّاسُ یُصَلُّونَ عَلَیْہِ أَفْوَاجًا۔","Da'if","Musannaf Ibn Abi Shaybah 12096","","","كتاب الجنائز"
"12097","(۱۲۰۹۷) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی عَلَی جِنَازَۃٍ فِی الْمَسْجِدِ فَلاَ صلاۃ لَہُ ، قَالَ : وَکَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا تَضَایَقَ بِہِمُ الْمَکَانُ رَجَعُوا ، وَلَمْ یُصَلُّوا۔ (ابوداؤد ۳۱۸۴۔ ابن ماجہ ۱۵۱۷)","","Musannaf Ibn Abi Shaybah 12097","","","كتاب الجنائز"
"12098","(۱۲۰۹۸) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ عَمَّنْ أَدْرَکَ أَبَا بَکْرٍ وَعُمَرَ أَنَّہُمْ کَانُوا إذَا تَضَایَقَ بِہِمُ الْمُصَلَّی انْصَرَفُوا ، وَلَمْ یُصَلُّوا عَلَی الْجِنَازَۃِ فِی الْمَسْجِدِ۔","Da'if","Musannaf Ibn Abi Shaybah 12098","","","كتاب الجنائز"
"12099","(۱۲۰۹۹) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ سَعِیدِ بْنِ أَیمَن ، عَنْ کَثِیرِ بْنِ ْعَبَّاسٍ ، قَالَ : لاَ أَعْرِفَنَّ مَا صَلَّیْت عَلَی جِنَازَۃٍ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 12099","","","كتاب الجنائز"
"12100","حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، حدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ۔n(۱۲۱۰۰) حدَّثَنَا سَلاَّمٌ أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، قَالَ : کَانَ عَلِیٌّ إذَا انْتَہَی إلَیْہِ نَعْیُ الرَّجُلِ ، قَالَ : إنَّا لِلَّہِ وَإِنَّا إلَیْہِ رَاجِعُونَ ، اللَّہُمَّ ارْفَعْ دَرَجَتَہُ فِی الْمُہْتَدِینَ ، وَاخْلُفْہُ فِی عَقِبِہِ فِی الْغَابِرِینَ ، وَنَحْتَسِبُہُ عِنْدَکَ رَبَّ الْعَالَمِینَ ، لاَ تُضِلَّنَا بَعْدَہُ ، وَلاَ تَحْرِمْنَا أَجْرَہُ۔","","Musannaf Ibn Abi Shaybah 12100","","","كتاب الجنائز"
"12101","(۱۲۱۰۱) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی إِسْحَاقَ ، أَخْبَرَنَا أَبُو مَیْسَرَۃَ : أَنَّہُ لَمَّا أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَتْلُ زَیْدٍ وَجَعْفَرٍ ، وَعَبْدِ اللہِ بْنِ رَوَاحَۃَ ذَکَرَ أَمْرَہُمْ ، فَقَالَ : اللَّہُمَّ اغْفِرْ لِزَیْدٍ اللَّہُمَّ اغْفِرْ لِزَیْدٍ اللَّہُمَّ اغْفِرْ لِزَیْدٍ اللَّہُمَّ اغْفِرْ لِجَعْفَرٍ ، وَعَبْدِ اللہِ بْنِ رَوَاحَۃَ۔ (ابن سعد ۴۶)","","Musannaf Ibn Abi Shaybah 12101","","","كتاب الجنائز"
"12102","(۱۲۱۰۲) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ حُرَیْثِ بْنِ ظُہَیْرٍ ، قَالَ : لَمَّا نُعِیَ عَبْدُ اللہِ إلَی أَبِی الدَّرْدَائِ ، قَالَ : مَا خَلَّفَ بَعْدَہُ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 12102","","","كتاب الجنائز"
"12103","(۱۲۱۰۳) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، قَالَ : أَخْبَرْتُ الْحَسَنَ بِمَوْتِ الشَّعْبِیِّ ، فَقَالَ : رحمہ اللہ ، وَاللَّہِ إِنْ کَانَ مِنَ الإِسْلاَمِ لَبِمَکَانٍ۔","","Musannaf Ibn Abi Shaybah 12103","","","كتاب الجنائز"
"12104","(۱۲۱۰۴) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ ابنِ أَبْجَر ، قَالَ : أَخْبَرْتُ الشَّعْبِیَّ بِمَوْتِ إبْرَاہِیمَ ، فَقَالَ : یرحمہ اللہ أَمَا إِنَّہُ لَمْ یُخَلِّفْ خَلْفَہُ مِثْلَہُ ، أَمَا إِنَّہُ مَیِّتًا أَفْقَہُ مِنْہُ حَیًّا۔","","Musannaf Ibn Abi Shaybah 12104","","","كتاب الجنائز"
"12105","(۱۲۱۰۵) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : مَرُّوا بِجِنَازَۃِ أَبِی عَبْدِ الرَّحْمَنِ عَلَی أَبِی جُحَیْفَۃَ ، قَالَ : اسْتَرَاحَ ، وَاسْتُرِیحَ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 12105","","","كتاب الجنائز"
"12106","(۱۲۱۰۶) حدَّثَنَا أَبُو أُسَامَۃَ ، حدَّثَنَا شُعْبَۃُ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : أَتَیْتُ عُمَرَ بِنَعْیِ النُّعْمَانِ بْنِ مُقَرِّنٍ ، قَالَ : فَوَضَع یَدَہُ عَلَی رَأْسِہِ ، وَجَعَلَ یَبْکِی۔","Da'if","Musannaf Ibn Abi Shaybah 12106","","","كتاب الجنائز"
"12107","(۱۲۱۰۷) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ فِی السُّوقِ فَنُعِیَ إلَیْہِ وَائِلُ بْنُ حُجْرٍ فَأَطْلَقَ حُبْوَتَہُ ، وَقَامَ وَغَلَبَہُ النَّحِیبُ۔","Sahih","Musannaf Ibn Abi Shaybah 12107","","","كتاب الجنائز"
"12108","(۱۲۱۰۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَان ، عَنْ سَالِمِ بْنِ أَبِی حَفْصَۃَ ، عَنْ رَجُلٍ یُقَالُ لَہُ أبو کُلْثُوم ، قَالَ : سَمِعْتُ ابْنَ الْحَنَفِیَّۃِ یَقُولُ فِی جِنَازَۃِ ابْنِ عَبَّاسٍ الْیَوْمَ مَاتَ ربانی الْعِلْمِ۔ (حاکم ۵۳۵)","","Musannaf Ibn Abi Shaybah 12108","","","كتاب الجنائز"
"12109","(۱۲۱۰۹) حدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَمَّارٍ مَوْلَی بَنِی ہَاشِمٍ ، قَالَ : جَلَسْنَا فِی ظِلِّ الْقَصْرِ مَعَ ابْنِ عَبَّاسٍ فِی جِنَازَۃِ زَیْدِ بْنِ ثَابِتٍ ، فَقَالَ : لَقَدْ دُفِنَ الْیَوْمَ عِلْمٌ کَثِیرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 12109","","","كتاب الجنائز"
"12110","(۱۲۱۱۰) حدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ : قَالَ نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ سَبِّ الْمَوْتَی۔ (ترمذی ۱۹۸۲۔ احمد ۴/۲۵۲)","Sahih","Musannaf Ibn Abi Shaybah 12110","","","كتاب الجنائز"
"12111","(۱۲۱۱۱) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی أَیُّوبَ مَوْلَی بَنِی ثَعْلَبَۃَ ، عَنْ قُطْبَۃَ بْنِ مَالِکٍ ، قَالَ : سَبَّ أَمِیرٌ مِنَ الأُمَرَائِ عَلِیًّا ، فَقَامَ إلَیْہِ زَیْدُ بْنُ أَرْقَمَ ، فَقَالَ : أَمَا إنِّی قَدْ عَلِمْت أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَدْ نَہَی عَنْ سَبِّ الْمَوْتَی ، فَلِمَ تَسُبُّ عَلِیًّا وَقَدْ مَاتَ۔ (احمد ۴/۳۶۹۔ طبرانی ۴۹۷۴)","Da'if","Musannaf Ibn Abi Shaybah 12111","","","كتاب الجنائز"
"12112","(۱۲۱۱۲) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : سَمِعْتُ ہِلاَلَ بْنَ یَسَافٍ یُحَدِّثُ عَنْ عُمَرَ بْنِ الْخَطَّابِ ، أَنَّہُ خَطَبَ بِمِنًی عَلَی جَبَلٍ ، فَقَالَ : لاَ تَسُبُّوا الأَمْوَاتَ فَإِنَّ مَا یُسَبُّ بِہِ الْمَیت یُؤْذَی بِہِ الْحَیُّ۔","","Musannaf Ibn Abi Shaybah 12112","","","كتاب الجنائز"
"12113","(۱۲۱۱۳) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍوَ قَالَ : سَابُّ الْمَیِّتِ کَالْمُشْرِفِ عَلَی الْہَلَکَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 12113","","","كتاب الجنائز"
"12114","(۱۲۱۱۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورِ بْنِ صَفِیَّۃَ ، عَنْ أُمِّہِ ، عَنْ عَائِشَۃَ قَالَتْ : لاَ تَذْکُرُوا مَوْتَاکُمْ إِلاَّ بِخَیْرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12114","","","كتاب الجنائز"
"12115","(۱۲۱۱۵) حدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : أَذَی الْمُؤْمِنِ فِی مَوْتِہِ کَأَذَاہُ فِی حَیَاتِہِ۔","","Musannaf Ibn Abi Shaybah 12115","","","كتاب الجنائز"
"12116","(۱۲۱۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامِ بْنِ یَحْیَی ، عَنْ قَتَادَۃَ ، قَالَ : شَہِدْت جِنَازَۃً فِی الأَسَاوِرَۃِ ، فَازْدَحَمُوا عَلَی الْجِنَازَۃِ ، فَقَالَ أَبُو السِّوّارِ الْعَدَوِیُّ : تُرَی ہَؤُلاَئِ أَفْضَلَ أَوْ أَصْحَابَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ أَحَدُہُمْ إن رَأَی مَحْمَلاً حَمَلَ وَإِلاَّ اعْتَزَلَ ، فَلَمْ یُؤْذُوا أَحَدًا۔","","Musannaf Ibn Abi Shaybah 12116","","","كتاب الجنائز"
"12117","(۱۲۱۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیٍّ ، عَنْ رَجُلٍ یُقَالُ لَہُ إسْمَاعِیلُ الْجَحْدَرِیُّ ، قَالَ : خَرَجْنَا فِی جِنَازَۃٍ فَشَہِدَہَا الْحَسَنُ ، قَالَ : فَرَأَی قَوْمًا ازْدَحَمُوا عَلَی السَّرِیرِ ، فَقَالَ الْحَسَنُ : مَا شَأْنُ ہَؤُلاَئِ إنِّی لأَظُنُّ الشَّیْطَانُ حَسَّ مِنَ النَّاسِ فَاتَّبَعَہُمْ لِیُحْبِطَ أُجُورَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 12117","","","كتاب الجنائز"
"12118","(۱۲۱۱۸) حدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ صُہَیْبٍ البُنَانِی ، عَنِ الْحَسَنِ : قَالَ : مَرَّتْ جِنَازَۃٌ بِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأُثْنِیَ عَلَیْہَا خَیْرًا حَتَّی تَتَابَعَتِ الأَلْسُنُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَجَبَتْ ، قَالَ : وَمَرَّتْ بِہِ جِنَازَۃٌ فَأُثْنِیَ عَلَیْہَا شَرًّا حَتَّی تَتَابَعَتِ الأَلْسُنُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَجَبَتْ ، فَقَالَ : عُمَرُ بْنُ الْخَطَّابِ یَا رَسُولَ اللہِ قُلْتَ فِی الْجِنَازَۃِ الأُولَی حَیْثُ أُثْنِیَ عَلَیْہَا خَیْرًا وَجَبَتْ ، وَقُلْتَ فِی الثَّانِیَۃِ کَذَلِکَ ، فَقَالَ : إنَّکُمْ شُہُودُ اللہِ فِی الأَرْضِ مَرَّتَیْنِ ، أَوْ ثَلاَثًا۔","Hasan","Musannaf Ibn Abi Shaybah 12118","","","كتاب الجنائز"
"12119","(۱۲۱۱۹) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ ، قَالَ : مُرَّ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِجِنَازَۃِ رَجُلٍ مِنَ الأَنْصَارِ فَأُثْنِیَ عَلَیْہَا خَیْرًا ، فَقَالَ : وَجَبَتْ ، ثُمَّ مُرَّ عَلَیْہِ بِجِنَازَۃٍ أُخْرَی فَأُثْنِیَ عَلَیْہَا دُونَ ذَلِکَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَجَبَتْ فَقَالُوا : یَا رَسُولَ اللہِ وَمَا وَجَبَتْ ، قَالَ : الْمَلاَئِکَۃُ شُہُودُ اللہِ فِی السَّمَائِ وَأَنْتُمْ شُہُودُ اللہِ فِی الأَرْضِ۔ (طبرانی ۶۲۶۲)","Da'if","Musannaf Ibn Abi Shaybah 12119","","","كتاب الجنائز"
"12120","(۱۲۱۲۰) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَرُّوا عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِجِنَازَۃٍ فَأُثْنِیَ عَلَیْہَا خَیْرًا فِی مَنَاقِبِ الْخَیْرِ ، فَقَالَ : وَجَبَتْ ، ثُمَّ مَرُّوا بِأُخْرَی فَأُثْنِیَ عَلَیْہَا شَرًّا فِی مَنَاقِبِ الشَّرِّ ، فَقَالَ : وَجَبَتْ إنَّکُمْ شُہَدَائُ اللہِ فِی الأَرْضِ۔ (احمد ۲/۲۶۱۔ ابویعلی ۵۹۷۹)","Hasan","Musannaf Ibn Abi Shaybah 12120","","","كتاب الجنائز"
"12121","(۱۲۱۲۱) حدَّثَنَا عَفَّانُ ، حدَّثَنَا دَاوُد بْنُ أَبِی الْفُرَاتِ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنْ أَبِی الأَسْوَد الدِّیْلِیِّ ، قَالَ : قَدِمْت الْمَدِینَۃَ وَقَدْ وَقَعَ بِہَا مَرَضٌ ، فَجَلَسْت إلَی عُمَرَ بْنِ الْخَطَّابِ ، فَمَرَّتْ بِہِمْ جِنَازَۃٌ ، فَأُثْنِیَ عَلَی صَاحِبہَا خَیْرا ، فَقَالَ عُمَرُ : وَجَبَتْ ، ثُمَّ مُرَّ بِأُخْرَی فَأُثْنِیَ عَلَیْہَا شَرًّا ، فَقَالَ عُمَرُ : وَجَبَتْ ، فَقَالَ أَبُو الأَسْوَد : فَقُلْت وَمَا وَجَبَتْ یَا أَمِیرَ الْمُؤْمِنِینَ ؟ قَالَ : قُلْتُ کَمَا قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَیُّمَا مُسْلِمٍ یَشْہَدُ لَہُ أَرْبَعَۃٌ بِخَیْرٍ أَدْخَلَہُ اللَّہُ الْجَنَّۃَ ، فَقُلْنَا وَثَلاَثَۃٌ ؟ قَالَ : وَثَلاَثَۃٌ ، فَقُلْنَا وَاثْنَانِ ، قَالَ وَاثْنَانِ ، ثُمَّ لَمْ نَسْأَلْہُ عَنِ الْوَاحِدِ۔ بخاری ۱۳۶۸۔ ترمذی ۱۰۵۹","Sahih","Musannaf Ibn Abi Shaybah 12121","","","كتاب الجنائز"
"12122","(۱۲۱۲۲) حدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ خَیْثَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : انْظُرُوا النَّاسَ عِنْدَ مَضَاجِعِہِمْ فَإِذَا رَأَیْتُمُ الْعَبْدَ یَمُوتُ عَلَی خَیْرٍ مَا تَرَوْنَہُ فَارْجُوا لَہُ الْخَیْرَ ، وَإِذا رَأَیْتُمُوہُ یَمُوتُ عَلَی شَرٍّ مَا تَرَوْنَہُ فَخَافُوا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 12122","","","كتاب الجنائز"
"12123","(۱۲۱۲۳) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حدَّثَنَا مِسْعر ، قَالَ : حَدَّثَنِی إبْرَاہِیمُ بْنُ عَامِرِ بْنِ مَسْعُودٍ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : تُوُفِّیَ رَجُلٌ فَذُکِرَ عِنْدَ النَّبِیِّ فَأُثْنِیَ عَلَیْہِ خَیْرٌ ، فَقَالَ : وَجَبَتْ وَتُوُفِّیَ آخَرُ فَذُکِرَ مِنْہُ شَرٌّ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَبَتْ ، فَقَالَ بَعْضُ الْقَوْمِ : عَجَبٌ مِنْ قَوْلِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَبَتْ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بَعْضٌ شُہَدَائُ عَلَی بَعْضٍ۔","Hasan","Musannaf Ibn Abi Shaybah 12123","","","كتاب الجنائز"
"12124","(۱۲۱۲۴) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخبرنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَنْ غَسَّلَ مَیِّتًا فَلْیَغْتَسِلْ وَمَنْ حَمَلَ جِنَازَۃً فَلْیَتَوَضَّأْ۔","Hasan","Musannaf Ibn Abi Shaybah 12124","","","كتاب الجنائز"
"12125","(۱۲۱۲۵) حدَّثَنَا شَبابَۃُ ، حدَّثَنَا ابْن أَبِی ذِئْبٍ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، عَنْ أَبِی ہُرَیْرَۃَ : عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ غَسَّلَ مَیِّتًا فَلْیَغْتَسِلْ وَمَنْ حَمَلَہُ فَلْیَتَوَضَّأْ۔","Da'if","Musannaf Ibn Abi Shaybah 12125","","","كتاب الجنائز"
"12126","(۱۲۱۲۶) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ عُثْمَانَ ، قَالَ : مَنْ حَمَلَ جِنَازَۃً فَلْیَتَوَضَّأْ۔","Da'if","Musannaf Ibn Abi Shaybah 12126","","","كتاب الجنائز"
"12127","(۱۲۱۲۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ عن عُرْوَۃَ ، قَالَ : کَانَ ابْنُ الزُّبَیْرِ إذَا مَاتَ لَہُ الْمَیِّتُ مِنْ أَہْلِہِ ، قَالَ : عَجِّلُوا عَجِّلُوا ، أَخْرِجُوا أَخْرِجُوا ، قَالَ : فَیَخْرُجُ أَیَّۃَ سَاعَۃٍ کَانَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 12127","","","كتاب الجنائز"
"12128","(۱۲۱۲۸) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : مَاتَ أَبُو بَکْرٍ لَیْلَۃَ الثُّلاَثَائِ، وَدُفِنَ لَیْلَۃَ الثُّلاَثَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 12128","","","كتاب الجنائز"
"12129","(۱۲۱۲۹) حدَّثَنَا عَبْدُالرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ مُجَالِدٍ، عَنِ الشَّعْبِیِّ، قَالَ: کَانَ یُقَالُ اقْتِرَابُ السَّاعَۃِ مَوْتُ الْفَجْأۃِ۔","","Musannaf Ibn Abi Shaybah 12129","","","كتاب الجنائز"
"12130","(۱۲۱۳۰) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ بَعْضِ أَصْحَابِ عَبْدِ اللہِ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَوْتُ الْفَجْأۃِ رَاحَۃٌ عَلَی الْمُؤْمِنِینَ وَتَحَیُّفٌ عَلَی الْکَافِرِ۔","Da'if","Musannaf Ibn Abi Shaybah 12130","","","كتاب الجنائز"
"12131","(۱۲۱۳۱) حدَّثَنَا ابْنُ نُمَیْرٍ ، حدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ طَلْحَۃَ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : مَاتَ مِنَّا رَجُلٌ بَغْتَۃً ، فَقَالَ رَجُلٌ مِن أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخْذَۃَ غَضَبٍ ، فَذَکَرْتُہُ لإِبْرَاہِیمَ ، وَقَلَّ مَا کُنَّا نَذْکُرُ لإِبْرَاہِیمَ حَدِیثًا إِلاَّ وَجَدْنَا عِنْدَہُ فِیہِ ، فَقَالَ : کَانُوا یَکْرَہُونَ أَخْذَۃً کَأَخْذَۃِ الأَسِفِ۔","","Musannaf Ibn Abi Shaybah 12131","","","كتاب الجنائز"
"12132","(۱۲۱۳۲) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، حدَّثَنَا أَبُو شِہَابٍ ، عَنِ الأَعْمَشِ ، عَنْ زُبَیْدٍ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ وَعَائِشَۃَ قَالاَ : مَوْتُ الْفَجْأۃِ رَأْفَۃٌ بِالْمُؤْمِنِ وَأَسَفٌ عَلَی الْفَاجِرِ۔","Sahih","Musannaf Ibn Abi Shaybah 12132","","","كتاب الجنائز"
"12133","(۱۲۱۳۳) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : سَمِعْتُ مُجَاہِدَ بْنَ أَبِی رَاشِدٍ ، قَالَ : قَالَ مُجَاہِدٌ : مِنْ أَشْرَاطِ السَّاعَۃِ مَوْتُ الْبِدَارِ۔","","Musannaf Ibn Abi Shaybah 12133","","","كتاب الجنائز"
"12134","(۱۲۱۳۴) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ مَوْتَ الْفَجْأۃِ۔","","Musannaf Ibn Abi Shaybah 12134","","","كتاب الجنائز"
"12135","(۱۲۱۳۵) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ عُبَیْدِ بْنِ خَالِدٍ ، رَجُلٍ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فِی مَوْتِ الْفُجَائَ ۃِ ، قَالَ أَخْذَۃُ أَسَفٍ۔ (ترمذی ۹۸۲۔ احمد ۳/۴۲۴)","Sahih","Musannaf Ibn Abi Shaybah 12135","","","كتاب الجنائز"
"12136","(۱۲۱۳۶) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، قَالَ : کَانُوا عِنْدَ رَجُلٍ مِنْ أَصْحَابِ عَبْدِ اللہِ وَہُوَ مَرِیضٌ ، فَعَرِقَ جَبِینُہُ ، فَذَہَبَ رَجُلٌ یَمْسَحُ عَنْ جَبِینِہِ الْعَرَقَ ، فَضَرَبَ یَدَہُ ، قَالَ سُفْیَانُ : إنَّہُمْ کَانُوا یَسْتَحِبُّونَ الْعَرَقَ لِلْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 12136","","","كتاب الجنائز"
"12137","(۱۲۱۳۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، أَنَّہُ دَخَلَ عَلَی صَدِیقٍ لَہُ مِنَ النَّخَعِ یَعُودُہُ ، فَمَسَحَ جَبِینَہُ فَوَجَدَہُ یَرْشَحُ فَضَحِکَ ، فَقَالَ لَہُ بَعْضُ الْقَوْمِ : مَا یَضْحَکُک یَا أَبَا شِبْلٍ ؟ قَالَ : ضَحِکْت مِنْ قَوْلِ عَبْدِ اللہِ : إنَّ نَفْسَ الْمُؤْمِنِ تَخْرُجُ رَشْحًا ، وَإِنَّہُ یَکُونُ قَدْ عَمِلَ السَّیِّئَۃَ فَیُشَدَّدُ عَلَیْہِ عِنْدَ الْمَوْتِ لِیَکُونَ بِہَا ، وَإِنَّ نَفْسَ الْکَافِرِ أوِ الْفَاجِرِ لَتَخْرُجُ مِنْ شِدْقِہِ کَمَا یَخْرُجُ نَفْسُ الْحِمَارِ ، وَإِنَّہُ یَکُونُ قَدْ عَمِلَ الْحَسَنَۃَ فَیُہَوَّنُ عَلَیْہِ عِنْدَ الْمَوْتِ لِیَکُونَ بِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 12137","","","كتاب الجنائز"
"12138","(۱۲۱۳۸) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُنْزَعُ عَنِ الْقَتِیلِ الْفَرْوُ ، وَالْجَوْرَبَانِ ، وَالْموْزَجَانِ ، والأفرہیجان إِلاَّ أَنْ یَکُونَ الجَوْرَبَانِ یُکَمِلان وترًا فَیُتْرَکَانِ عَلَیْہِ ، وَیُدْفَنُ بثِیَابِہِ۔","","Musannaf Ibn Abi Shaybah 12138","","","كتاب الجنائز"
"12139","(۱۲۱۳۹) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یُدْفَنُ مَعَ الْقَتِیلِ خُفٌّ ، وَلاَ نَعْلٌ۔","","Musannaf Ibn Abi Shaybah 12139","","","كتاب الجنائز"
"12140","(۱۲۱۴۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُخَوَّلٍ ، عَنِ الْعَیْزَارِ بْنِ حُرَیْثٍ الْعَبْدِیِّ ، قَالَ : قَالَ زَیْدُ بْنُ صُوحَانَ : لاَ تَنْزِعُوا عَنِّی ثَوْبًا إِلاَّ الْخُفَّیْنِ فَإِنِّی مُحَاجٌّ أُحَاجُّ۔","Sahih","Musannaf Ibn Abi Shaybah 12140","","","كتاب الجنائز"
"12141","(۱۲۱۴۱) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ الْمَقْبُرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ ، قَالَ : أُتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِجِنَازَۃٍ لِیُصَلِّیَ عَلَیْہَا ، فَقَالَ : عَلَیْہِ دَیْنٌ ؟ قَالُوا : نَعَمْ دِینَارَانِ ، قَالَ : تَرَکَ لَہُمَا وَفَائً ؟ قَالُوا : لاَ ، قَالَ : فَصَلُّوا عَلَی صَاحِبِکُمْ ، قَالَ أَبُو قَتَادَۃَ : ہُمَا عَلَیَّ یَا رَسُولَ اللہِ ، فَصَلَّی عَلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ترمذی ۱۰۶۹۔ دارمی ۲۵۹۳)","Hasan","Musannaf Ibn Abi Shaybah 12141","","","كتاب الجنائز"
"12142","(۱۲۱۴۲) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِجَِنَازَۃِ رَجُلٍ مِنَ الأَنْصَارِ لِیُصَلِّیَ عَلَیْہِ ، فَقَالَ : ہَلْ تَرَکَ شَیْئًا ؟ قَالُوا : لاَ ، قَالَ : ہَلْ عَلَیْہِ دَیْنٌ ؟ قَالُوا : نَعَمْ ، عَلَیْہِ دِینَارَانِ ، قَالَ : صَلُّوا عَلَی صَاحِبِکُمْ ، قَالَ أَبُو قَتَادَۃَ : ہُمَا عَلَیَّ یَا رَسُولَ اللہِ ، قَالَ : فَصَلَّی عَلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَأَخْبَرَنِی إیَاسِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إِذَا لَقِیَہُ أَبُو قَتَادَۃَ ، قَالَ : مَا فَعَلَ الدِّینَارَانِ ؟ حَتَّی قَضَاہُمَا۔ (بخاری ۲۲۸۹۔ احمد ۴/۴۷)","Da'if","Musannaf Ibn Abi Shaybah 12142","","","كتاب الجنائز"
"12143","(۱۲۱۴۳) حدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : مَاتَ رَجُلٌ فَأَتَیْنَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِیُصَلِّیَ عَلَیْہِ فَخَطَا [corrupt]ُطًی ، قَالَ : عَلَیْہِ دَیْنٌ ؟ فقُلْنَا : نَعَمْ عَلَیْہِ دِینَارَانِ ، قَالَ : صَلُّوا عَلَی صَاحِبِکُمْ۔ (احمد ۳/۳۳۰۔ بیہقی ۷۵)","Da'if","Musannaf Ibn Abi Shaybah 12143","","","كتاب الجنائز"
"12144","(۱۲۱۴۴) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، حدَّثَنَا أَبُو کَثِیرٍ مَوْلَی اللَّیْثِیِّینَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ جَحْشٍ : أَنَّ رَجُلاً جَائَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ مَا لِی إِنْ قُتِلْت فِی سَبِیلِ اللہِ ، قَالَ : الْجَنَّۃُ ، فَلَمَّا وَلَّی ، قَالَ : إِلاَّ الدَّیْنَ سَارَّنِی بِہِ جِبْرِیلُ آنِفًا۔ (احمد ۴/۳۵۰۔ طبرانی ۵۵۷)","Hasan","Musannaf Ibn Abi Shaybah 12144","","","كتاب الجنائز"
"12145","(۱۲۱۴۵) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوٍ مِنْہُ ، إِلاَّ أَنَّہُ قَالَ : قَالَ لِی جِبْرِیلُ علیہ السلام۔ (مسلم ۱۱۷۔ ترمذی ۱۷۱۲)","Sahih","Musannaf Ibn Abi Shaybah 12145","","","كتاب الجنائز"
"12146","(۱۲۱۴۶) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أُتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِجِنَازَۃِ رَجُلٍ مِنَ الأَنْصَارِ فَصَلَّی عَلَیْہِ ، ثُمَّ قَالَ : مَا تَرَکَ ؟ قَالُوا : تَرَکَ دِینَارَیْنِ ، أَوْ ثَلاَثَۃً ، قَالَ ، تَرَکَ کَیَّتَیْنِ ، أَوْ ثَلاَثَ کَیَّاتٍ۔ (احمد ۲/۴۲۹۔ بزار ۳۶۴۹)","Sahih","Musannaf Ibn Abi Shaybah 12146","","","كتاب الجنائز"
"12147","(۱۲۱۴۷) حدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، حدَّثَنَا شُعْبَۃُ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْعَدَّاء ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ یُحَدِّثُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی رَجُلٍ مَاتَ وَتَرَکَ دینار أو دِینَارَیْنِ ، قَالَ : کَیَّۃً ، أَوْ کَیَّتَیْنِ۔ (احمد ۵/۲۵۲۔ طبرانی ۸۰۰۸)","Hasan","Musannaf Ibn Abi Shaybah 12147","","","كتاب الجنائز"
"12148","(۱۲۱۴۸) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : لَحِقَ بِالنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَبْدٌ أَسْوَدُ فَمَاتَ ، فَأُودَنَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : انْظُرُوا ہَلْ تَرَکَ شَیْئًا ؟ فَقَالُوا : تَرَکَ دِینَارَیْنِ ، قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَیَّتَانِ۔ (احمد ۱/۴۰۵۔ ابویعلی ۵۰۱۵)","Da'if","Musannaf Ibn Abi Shaybah 12148","","","كتاب الجنائز"
"12149","(۱۲۱۴۹) حدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ ، حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، حدَّثَنَا عُتَیْبَۃُ ، عَنْ بُرَید بْنِ أَصْرَمَ ، قَالَ : سَمِعْتُ عَلِیًّا یَقُولُ : مَاتَ رَجُلٌ مِنْ أَہْلِ الصُّفَّۃِ ، فَقَالُوا : یَا رَسُولَ اللہِ ، تَرَکَ دِینَارًا ، وَدِرْہَمًا ، فَقَالَ : کَیَّتَانِ ، فَقَالَ : صَلُّوا عَلَی صَاحِبِکُمْ۔ (بخاری ۱۹۷۴)","Da'if","Musannaf Ibn Abi Shaybah 12149","","","كتاب الجنائز"
"12150","(۱۲۱۵۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ مَسْرُوقٍ : عَنْ عَائِشَۃَ ، قَالَتْ : دَخَلَتْ عَلَیْہَا یَہُودِیَّۃٌ فَوَہَبَتْ لَہَا طِیبًا ، فَقَالَتْ : أَجَارَک اللَّہُ مِنْ عَذَابِ الْقَبْرِ ، قَالَتْ : فَوَقَعَ فِی نَفْسِی مِنْ ذَلِکَ ، فَلَمَّا جَائَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قُلْتُ : یَا رَسُولَ اللہِ إنَّ فِی الْقَبْرِ عَذَابًا ؟ قَالَ : نَعَمْ ، إنَّہُمْ لَیُعَذَّبُونَ فِی قُبُورِہِمْ عَذَابًا تَسْمَعُہُ الْبَہَائِمُ۔ (بخاری ۶۳۶۶۔ مسلم ۱۲۵)","Sahih","Musannaf Ibn Abi Shaybah 12150","","","كتاب الجنائز"
"12151","(۱۲۱۵۱) حدَّثَنَا عَبِیْدَۃُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوِ حَدِیثِ أَبِی مُعَاوِیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 12151","","","كتاب الجنائز"
"12152","(۱۲۱۵۲) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَعَوَّذُوا بِاَللَّہِ مِنْ جَہَنَّمَ ، تَعَوَّذُوا بِاَللَّہِ مِنْ عَذَابِ الْقَبْرِ ، تَعَوَّذُوا بِاَللَّہِ مِنْ فِتْنَۃِ الْمَسِیحِ الدَّجَّالِ ، تَعَوَّذُوا بِاَللَّہِ مِنْ فِتْنَۃِ الْمَحْیَا وَالْمَمَاتِ۔ (ترمذی ۳۶۰۴)","Sahih","Musannaf Ibn Abi Shaybah 12152","","","كتاب الجنائز"
"12153","(۱۲۱۵۳) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : حدَّثَنَا زَیْدُ بْنُ ثَابِتٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ إنَّ ہَذِہِ الأُمَّۃَ تُبْتَلَی فِی قُبُورِہَا فَلَوْلاَ أَنْ لاَ تَدَافَنُوا لَدَعَوْت اللَّہَ أَنْ یُسْمِعَکُمْ مِنْ عَذَابِ الْقَبْرِ الَّذِی أَسْمَعُ مِنْہُ ، ثُمَّ أَقْبَلَ عَلَیْنَا بِوَجْہِہِ ، فَقَالَ : تَعَوَّذُوا بِاللَّہِ مِنْ عَذَابِ الْقَبْرِ قُلْنَا نَعُوذُ بِاللَّہِ مِنْ عَذَابِ الْقَبْرِ۔ (مسلم ۶۷۔ احمد ۵/۱۹۰)","Sahih","Musannaf Ibn Abi Shaybah 12153","","","كتاب الجنائز"
"12154","(۱۲۱۵۴) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ الْمُغِیرَۃِ بْنِ عَبْدِ اللہِ الْیَشْکُرِیِّ ، عَنِ الْمَعْرُورِ بْنِ سُوَیْد ، عَنْ عَبْدِ اللہِ ، قَالَ : قالَتْ أُمُّ حَبِیبَۃَ زَوْجُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اللَّہُمَّ أَمْتِعْنِی بِزَوْجِی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَبِأَبِی أَبِی سُفْیَانَ ، وَبِأَخِی مُعَاوِیَۃَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّک قَدْ سَأَلْت اللَّہَ لآجَالٍ مَضْرُوبَۃٍ ، وَأَیَّامٍ مَعْدُودَۃٍ ، وَأَرْزَاقٍ مَقْسُومَۃٍ ، لَنْ یُعَجِّل شَیْئًا قَبْلَ حَِلِہِ أو یُؤَخِّرَ شَیْئًا عَنْ حَِلِہِ ، وَلَوْ کُنْت سَأَلْت اللَّہَ أَنْ یُعِیذَک مِنْ عَذَابٍ فِی النَّارِ ، أَوْ عَذَابٍ فِی الْقَبْرِ کَانَ خَیْرًا وَأَفْضَلَ۔ (مسلم ۲۰۵۰۔ احمد ۱/۳۹۰)","Sahih","Musannaf Ibn Abi Shaybah 12154","","","كتاب الجنائز"
"12155","(۱۲۱۵۵) حدَّثَنَا وَکِیعٌ ، عَنْ عُثْمَانَ الشَّحَّامِ ، عَنْ مُسْلِمِ بْنِ أَبِی بَکْرَۃَ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ کَانَ یَدْعُو فِی إِثْرِ الصَّلاَۃِ یقول : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْکُفْرِ وَالْفَقْرِ وَعَذَابِ الْقَبْرِ۔ (احمد ۵/۳۶۔ ترمذی ۳۵۰۳)","Hasan","Musannaf Ibn Abi Shaybah 12155","","","كتاب الجنائز"
"12156","(۱۲۱۵۶) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَعَوَّذُ بِاللَّہِ مِنَ الْجُبْنِ وَالْبُخْلِ وَعَذَابِ الْقَبْرِ ، وَفِتْنَۃِ الصَّدْرِ۔ (احمد ۱/۲۲۔ بزار ۳۲۴)","Sahih","Musannaf Ibn Abi Shaybah 12156","","","كتاب الجنائز"
"12157","(۱۲۱۵۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ وَابْنِ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ زَاذَانَ : عَنِ الْبَرَائِ ، قَالَ : خَرَجْنَا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی جِنَازَۃِ رَجُلٍ مِنَ الأَنْصَارِ فَانْتَہَیْنَا إلَی الْقَبْرِ وَلَمَّا یُلْحَدْ ، فَجَلَسَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَلَسْنَا حَوْلَہُ ، کَأَنَّمَا عَلَی رُؤُوسِنَا الطَّیْرُ ، وَفِی یَدِہِ عُودٌ یَنْکُتُ بِہِ فِی الأَرْضِ ، فَرَفَعَ رَأْسَہُ، فَقَالَ: اسْتَعِیذُوا بِاللَّہِ مِنْ عَذَابِ الْقَبْرِ، إِلاَّ أَنَّ ابْنَ نُمَیْرٍ، قَالَ حدَّثَنَا الأَعْمَشُ، قَالَ: حدَّثَنَا الْمِنْہَالُ۔","Sahih","Musannaf Ibn Abi Shaybah 12157","","","كتاب الجنائز"
"12158","(۱۲۱۵۸) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمِ ، عَنْ أَبِی عُثْمَانَ ، وَعَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ زَیْدِ بْنِ أَرْقَمَ ، قَالَ : لاَ أَقُولُ لَکُمْ إِلاَّ مَا سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : اللَّہُمَّ إنِّی أَعُوذُ بِکَ مِنَ الْعَجْزِ وَالْکَسَلِ وَالْجُبْنِ وَالْبُخْلِ وَعَذَابِ الْقَبْرِ۔ (مسلم ۲۰۸۸۔ ترمذی ۳۵۷۲)","Sahih","Musannaf Ibn Abi Shaybah 12158","","","كتاب الجنائز"
"12159","(۱۲۱۵۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ : عَنْ أُمِّ مُبَشِّرٍ قَالَتْ : دَخَلَ عَلَیَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا فِی حَائِطٍ مِنْ حَوَائِطِ بَنِی النَّجَّارِ فِیہِ قُبُورٌ مِنْہُمْ قَدْ مُوِّتُوا فِی الْجَاہِلِیَّۃِ ، قَالَ : فَخَرَجَ فَسَمِعْتُہُ یَقُولُ : اسْتَعِیذُوا بِاللَّہِ مِنْ عَذَابِ الْقَبْرِ قُلْتُ یَا رَسُولَ اللہِ وَلِلْقَبْرِ عَذَابٌ ، قَالَ : إنَّہُمْ لَیُعَذَّبُونَ فِی قُبُورِہِمْ عَذَابًا تَسْمَعُہُ الْبَہَائِمُ۔ (طبرانی ۲۵۔ احمد ۶/۳۶۲)","Hasan","Musannaf Ibn Abi Shaybah 12159","","","كتاب الجنائز"
"12160","(۱۲۱۶۰) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، عَنْ أَبِی أَیُّوبَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَمِعَ صَوْتًا حِینَ غَرَبَتِ الشَّمْسُ ، فَقَالَ : ہَذِہِ أَصْوَاتُ الْیَہُودِ تُعَذَّبُ فِی قُبُورِہَا۔ (بخاری ۱۳۷۵۔ مسلم ۶۹)","Sahih","Musannaf Ibn Abi Shaybah 12160","","","كتاب الجنائز"
"12161","(۱۲۱۶۱) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَعَوَّذُ مِنَ الْجُبْنِ وَالْبُخْلِ وَفِتْنَۃِ الْمَحْیَا وَالْمَمَاتِ وَعَذَابِ الْقَبْرِ۔ (نسائی ۷۸۸۱۔ احمد ۳/۲۰۸)","Sahih","Musannaf Ibn Abi Shaybah 12161","","","كتاب الجنائز"
"12162","(۱۲۱۶۲) حدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، حدَّثَنَا مُوسَی بْنُ عُقْبَۃَ ، عَنْ أُمِّ خَالِدٍ بِنْتِ خَالِدٍ ، أَنَّہَا سَمِعَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَتَعَوذُ مِنْ عَذَابِ الْقَبْرِ۔ (بخاری ۱۳۷۶۔ احمد ۶/۳۶۵)","Sahih","Musannaf Ibn Abi Shaybah 12162","","","كتاب الجنائز"
"12163","(۱۲۱۶۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : وَقَدْ أُوحِیَ إلَیَّ أَنَّکُمْ تُفْتَنُونَ فِی الْقُبُورِ مِثْلَ ، أَوْ قَرِیبًا مِنْ فِتْنَۃِ الْمَسِیحِ الدَّجَّالِ ، ثُمَّ یُؤْتَی أَحَدُکُمْ فَیُقَالُ لہ مَا عِلْمُک بِہَذَا الرَّجُلِ ، قَالَ فَأَمَّا الْمُؤْمِنُ فَیَقُولُ : ہو مُحَمَّدٌ ہُوَ رَسُولُ اللہِ ، جَائَنَا بِالْبَیِّنَاتِ وَالْہُدَی ، فَأَجَبْنَا وَاتَّبَعْنَا ، فَیُقَالُ : نَمْ صَالِحًا فَقَدْ عَلِمْنَا أَنَّک مُؤْمِنٌ بِاللَّہِ ، وَأَمَّا الْمُنَافِقُ ، أَوِ الْمُرْتَابُ لاَ أَدْرِی أَیَّ ذَلِکَ قَالَتْ أَسْمَائُ فَیَقُولُ لاَ أَدْرِی ، سَمِعْت النَّاسَ قَالُوا قَوْلاً فَقُلْتُہُ۔ (بخاری ۸۶۔ مسلم ۱۲)","Sahih","Musannaf Ibn Abi Shaybah 12163","","","كتاب الجنائز"
"12164","(۱۲۱۶۴) حدَّثَنَا وَکِیعٌ، وَأَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، قَالَ: سَمِعْتُ مُجَاہِدًا یُحَدِّثُ عَنْ طَاوُوسٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی قَبْرَیْنِ، فَقَالَ: إنَّہُمَا لَیُعَذَّبَانِ وَمَا یُعَذَّبَانِ فِی کَبِیرٍ أَمَّا أَحَدُہُمَا، فَکَانَ یَمْشِی بِالنَّمِیمَۃِ وَأَمَّا الآخَرُ، فَکَانَ لاَ یَسْتَبْرِئُ مِنْ بَوْلِہِ، وَلَمْ یَقُلْ أَبُو مُعَاوِیَۃَ سَمِعْت مُجَاہِدًا۔","Sahih","Musannaf Ibn Abi Shaybah 12164","","","كتاب الجنائز"
"12165","(۱۲۱۶۵) حدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَسَنَۃَ ، قَالَ : کُنت أَنَا وَعَمْرُو بْنُ الْعَاصِ جَالِسَیْنِ ، فَخَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَعَہُ دَرَقَۃٌ ، أَوْ شَبَہُہَا ، فَاسْتَتَرَ بِہَا ، ثُمَّ بَالَ وَہُوَ جَالِسٌ ، فَقُلْنَا : تَبُول یَا رَسُولَ اللہِ کَمَا تَبُولُ الْمَرْأَۃُ ، قَالَ : فَجَائَنَا ، فَقَالَ : أَوَمَا عَلِمْتُمْ مَا أَصَابَ صَاحِبَ بَنِی إسْرَائِیلَ ، کَانَ الرَّجُلُ مِنْہُمْ إذَا أَصَابَہُ الشَّیئُ مِنَ الْبَوْلِ قَرَضَہُ بِالْمِقْرَاضِ فَنَہَاہُمْ عَنْ ذَلِکَ فَعُذِّبَ فِی قَبْرِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 12165","","","كتاب الجنائز"
"12166","(۱۲۱۶۶) حدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ سَعْدٍ ، أَنَّہُ قَالَ لِبَنِیہِ أی بَنِیَّ تَعَوَّذُوا بِاللَّہِ بِکَلِمَاتٍ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَعَوَّذُ بِہِنَّ ۔۔۔ ، فَذَکَرَ عَذَابَ الْقَبْرِ۔ (بخاری ۶۳۷۴۔ ترمذی ۳۵۶۷)","Sahih","Musannaf Ibn Abi Shaybah 12166","","","كتاب الجنائز"
"12167","(۱۲۱۶۷) حدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْر ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ سَعْدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ۔ (بخاری ۶۳۷۴)","Sahih","Musannaf Ibn Abi Shaybah 12167","","","كتاب الجنائز"
"12168","(۱۲۱۶۸) حدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، حدَّثَنَا یَزِیدُ بْنُ کَیْسَانَ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی قَبْرٍ فَوَقَفَ عَلَیْہِ ، فَقَالَ : ائْتُونِی بِجَرِیدَتَیْنِ ، فَجَعَلَ إحْدَاہُمَا عِنْدَ رَأْسِہِ ، وَالأُخْرَی عِنْدَ رِجْلَیْہِ ، فَقِیلَ لَہُ : یَا رَسُولَ اللہِ أَیَنْفَعُہُ ذَلِکَ ؟ فَقَالَ : لَعَلَّہُ یُخَفِّفُ عَنْہُ بَعْضَ عَذَابِ الْقَبْرِ مَا فِیہِ نُدُوَّۃٌ۔ (احمد ۲/۴۴۱)","Hasan","Musannaf Ibn Abi Shaybah 12168","","","كتاب الجنائز"
"12169","(۱۲۱۶۹) حدَّثَنَا وَکِیعٌ ، عَنِ الأَسْوَد بْنِ شَیْبَانَ ، قَالَ : حدَّثَنِی بَحْرُ بْنُ مَرَّارٍ ، عَنْ جَدِّہِ أَبِی بَکْرَۃَ ، قَالَ : کُنْتُ أَمْشِی مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَرَّ عَلَی قَبْرَیْنِ ، فَقَالَ : إنَّہُمَا لَیُعَذَّبَانِ مَنْ یَأْتِینِی بِجَرِیدَۃٍ ؟ فَاسْتَبَقْتُ أَنَا وَرَجُلٌ فَأَتَیْنَا بِہَا ، قَالَ : فَشَقَّہَا مِنْ رَأْسِہَا ، فَغَرَسَ عَلَی ہَذَا وَاحِدَۃً ، وَعَلَی ہَذَا وَاحِدَۃً ، وَقَالَ : لَعَلَّہ یُخَفَّفُ عَنْہُمَا مَا بَقِیَ فِیہِمَا مِنْ بُلُولَتِہِمَا شَیْئٌ ، إن یُعَذَّبَانِ لفِی الْغِیبَۃِ وَالْبَوْلِ۔","","Musannaf Ibn Abi Shaybah 12169","","","كتاب الجنائز"
"12170","(۱۲۱۷۰) حدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، حدَّثَنَا أَبُو سَلَمَۃَ حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ ، عَنْ حَبِیبِ بْنِ أَبِی جَبِیرَۃَ ، عَنْ یَعْلَی بْنِ سِیَابَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِقَبْرٍ یُعَذَّبُ صَاحِبُہُ ، فَقَالَ : إنَّ صَاحِبَ ہَذَا الْقَبْرِ یُعَذَّبُ فِی غَیْرِ کَبِیرٍ ، ثُمَّ دَعَا بِجَرِیدَۃٍ فَوَضَعَہَا عَلَی قَبْرِہِ ، ثُمَّ قَالَ : لَعَلَّہُ یُخَفِّفُ عَنْہُ مَا کَانَتْ رَطْبَۃً۔ (مسندہ ۵۹۵۔ احمد ۴/۱۷۲)","Da'if","Musannaf Ibn Abi Shaybah 12170","","","كتاب الجنائز"
"12171","(۱۲۱۷۱) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَرَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِقَبْرَیْنِ ، فَقَالَ : إنَّہُمَا لَیُعَذَّبَانِ وَمَا یُعَذَّبَانِ فِی کَبِیرٍ أَمَّا أَحَدُہُمَا ، فَکَانَ لاَ یَسْتَتِرُ مِنَ الْبَوْلِ، وَأَمَّا الآخَرُ ، فَکَانَ یَمْشِی بِالنَّمِیمَۃِ ، ثُمَّ أَخَذَ جَرِیدَۃً رَطْبَۃً فَشَقَّہَا نِصْفَیْنِ ، ثُمَّ غَرَسَ فِی کُلِّ قَبْرٍ وَاحِدَۃً ، فَقَالُوا : یَا رَسُولَ اللہِ لِمَ فَعَلْت ہَذَا ؟ قَالَ : لَعَلَّہُ أن یُخَفِّفُ عَنْہُمَا مَا لَمْ یَیْبَسَا۔","Sahih","Musannaf Ibn Abi Shaybah 12171","","","كتاب الجنائز"
"12172","(۱۲۱۷۲) حدَّثَنَا وَکِیعٌ ، حدَّثَنَا الأَعْمَشُ ، سَمِعْتُ مُجَاہِدًا یُحَدِّثُ عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ ، إِلاَّ أَنَّ وَکِیعًا ، قَالَ : فَدَعَا بِعَسِیبٍ رَطْبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12172","","","كتاب الجنائز"
"12173","(۱۲۱۷۳) حدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا أُدْخِلَ الرَّجُلُ قَبْرَہُ ، فَإِنْ کَانَ مِنْ أَہْلِ السَّعَادَۃِ ثَبَّتَہُ اللَّہُ بِالْقَوْلِ الثَّابِتِ فَیُسْأَلُ مَا أَنْتَ فَیَقُولُ أَنَا عَبْدُ اللہِ حَیًّا وَمَیِّتًا وَأَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ وَأَشْہَدُ أَنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، قَالَ فَیُقَالُ کَذَلِکَ کُنْت ، قَالَ فَیُوَسَّعُ عَلَیْہِ قَبْرُہُ مَا شَائَ اللَّہُ وَیُفْتَحُ لَہُ بَابٌ إلَی الْجَنَّۃِ وَیُدْخَلُ عَلَیْہِ مِنْ رَوْحُہَا وَرِیحُہَا حَتَّی یُبْعَثَ ، وَأَمَّا الآخَرُ فَیُؤْتَی فِی قَبْرِہِ فَیُقَالُ لَہُ مَا أَنْتَ ثَلاَثُ مَرَّاتٍ فَیَقُولُ لاَ أَدْرِی فَیُقَال لَہُ لاَ دَرَیْت ثَلاَثَ مَرَّاتٍ ، ثُمَّ یُضَیَّقُ عَلَیْہِ قَبْرُہُ حَتَّی تَخْتَلِفَ أَضْلاَعُہُ ، أَوْ تَمَاسَّ وَتُرْسَلُ عَلَیْہِ حَیَّاتٌ مِنْ جَانِبِ الْقَبْرِ فَتَنْہَشُہُ وَتَأْکُلُہُ کُلَّمَا جَزِعَ وَصَاحَ قُمِعَ بِقِمَاعٍ مِنْ حَدِیدٍ ، أَوْ مِنْ نَارٍ وَیُفْتَحُ لَہُ بَابٌ إلَی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 12173","","","كتاب الجنائز"
"12174","(۱۲۱۷۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ {یُثَبِّتُ اللَّہُ الَّذِینَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِی الْحَیَاۃِ الدُّنْیَا} ، قَالَ : التَّثْبِیتُ فِی الْحَیَاۃِ الدُّنْیَا إذَا جَائَ الْمَلَکَانِ إلَی الرَّجُلِ فِی الْقَبْرِ فَقَالاَ لَہُ : مَنْ رَبُّک ؟ فَقَالَ : رَبِّی اللَّہُ ، قَالاَ : وَمَا دِینُک ؟ قَالَ : دِینِی الإِسْلاَمُ قَالاَ : وَمَنْ نَبِیُّک ؟ قَالَ نَبِیِّی مُحَمَّدٌ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَلِکَ التَّثْبِیتُ فِی الْحَیَاۃِ الدُّنْیَا۔ (بخاری ۱۳۶۹۔ ابوداؤد ۴۷۱۷)","Sahih","Musannaf Ibn Abi Shaybah 12174","","","كتاب الجنائز"
"12175","(۱۲۱۷۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ رَفَعَہُ ، قَالَ : إِنَّہُ لَیَسْمَعُ خَفْقَ نِعَالِہِمْ إذَا وَلَّوْا مُدْبِرِینَ۔ (ابن حبان ۳۱۱۸۔ بزار ۸۷۳)","Da'if","Musannaf Ibn Abi Shaybah 12175","","","كتاب الجنائز"
"12176","(۱۲۱۷۶) حدَّثَنَا ابْنُ نُمَیْرٍ ، حدَّثَنَا سُفْیَانَ ، عَنِ الأَسْوَد بْنِ قَیْسٍ ، عَنْ نُبَیْحٍ ، قَالَ : سَمِعْتُ أَبَا سَعِیدٍ یَقُولُ مَا مِنْ جِنَازَۃٍ إِلاَّ تُنَاشِدُ حَمَلَتَہَا إِنْ کَانَتْ مُؤْمِنَۃً وَاللَّہُ عَنْہَا رَاضٍ قَالَتْ أَسْرِعُوا بِی وَإِنْ کَانَتْ کَافِرَۃً وَاللَّہُ عَنْہَا سَاخِطٌ قَالَتْ رُدُّونِی فَمَا شَیْئٌ إِلاَّ یَسْمَعُہُ إِلاَّ الثَّقَلَیْنِ وَلَوْ سَمِعَہُ الإِنْسَان جَزِعَ وَخَرِع۔ (عبدالرزاق ۶۲۵۰)","Sahih","Musannaf Ibn Abi Shaybah 12176","","","كتاب الجنائز"
"12177","(۱۲۱۷۷) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ تَمِیمٍ ، عَنْ غَیْلاَنَ بْنِ سَلَمَۃَ ، قَالَ : جَائَ رَجُلٌ إلَی أَبِی الدَّرْدَائِ وَہُوَ مَرِیضٌ ، فَقَالَ : یَا أَبَا الدَّرْدَائِ إنَّک قَدْ أَصْبَحْتَ عَلَی جَنَاحِ فِرَاقِ الدُّنْیَا ، فَمُرْنِی بِأَمْرٍ یَنْفَعُنِی اللَّہُ بِہِ ، وَأَذْکُرُک بِہِ ، قَالَ : إنَّک مِنْ أُمَّۃٍ مُعَافَاۃٍ ، فَأَقِمِ الصَّلاَۃَ ، وَأَدِّ زَکَاۃَ مَالِکِ ، إِنْ کَانَ لَکَ ، وَصُمْ رَمَضَانَ وَاجْتَنِبِ الْفَوَاحِشَ ، ثُمَّ أَبْشِرْ ، قَالَ : ثُمَّ أَعَادَ الرَّجُلُ عَلَی أَبِی الدَّرْدَائِ ، فَقَالَ لَہُ مِثْلَ ذَلِکَ ، قَالَ شُعْبَۃُ : وَأَحْسَبُہُ أَعَادَ عَلَیْہِ ثَلاَثَ مَرَّاتٍ ، وَرَدَّ عَلَیْہِ أَبُو الدَّرْدَائِ ثَلاَثَ مَرَّاتٍ ، فَنَفَضَ الرَّجُلُ رِدَائَہُ ، وَقَالَ : {إنَّ الَّذِینَ یَکْتُمُونَ مَا أَنْزَلْنَا مِنَ الْبَیِّنَاتِ وَالْہُدَی مِنْ بَعْدِ مَا بَیَّنَّاہُ لِلنَّاسِ فِی الْکِتَابِ} إلَی قَوْلِہِ {وَیَلْعَنَہُمَ اللاَّعِنْونَ} فَقَالَ أَبُو الدَّرْدَائِ : عَلَیَّ الرَّجُلَ ، فَجَائَ فَقَالَ أَبُو الدَّرْدَائِ : مَا قُلْتَ ، قَالَ : کُنْتُ رَجُلاً مُعَلَّمًا عِنْدَکَ مِنَ الْعِلْمِ مَا لَیْسَ عِنْدِی ، فَأَرَدْت أَنْ تُحَدِّثَنِی بِمَا یَنْفَعُنِی اللَّہُ بِہِ ، فَلَمْ تَرُدَّ عَلَیَّ إِلاَّ قَوْلاً وَاحِدًا ، فَقَالَ لہ أَبُو الدَّرْدَائِ : اجْلِسْ ، ثُمَّ اعْقِلْ مَا أَقُولُ ، أَیْنَ أَنْتَ مِنْ یَوْمٍ لَیْسَ لَکَ مِنَ الأَرْضِ إِلاَّ عَرْضُ ذِرَاعَیْنِ فِی طُولِ أَرْبَعَۃِ أَذْرُعٍ ، أَقَبْلَ بِکَ أَہْلُک الَّذِینَ کَانُوا لاَ یُحِبُّونَ فِرَاقَک ، وَجُلَسَاؤُک ، وَإِخْوَانُک فَأَتْقَنوا عَلَیْک البُنْیَان ، ثُمَّ أَکْثَرُوا عَلَیْک التُّرَابَ ، ثُمَّ تَرَکُوک لِمَتَلِّکَ ذَلِکَ ، ثُمَّ جَائَک مَلَکَانِ أَسْوَدَانِ أَزْرَقَانِ جَعْدَانِ ، اسْمَاہُمَا مُنْکَرٌ وَنَکِیرٌ فَأَجْلَسَاک ، ثُمَّ سَأَلاَک مَا أَنْتَ أَمْ عَلَی مَاذَا کُنْت ؟ أم مَاذَا تَقُولُ فِی ہَذَا، فَإِنْ قُلْتَ: وَاللَّہِ مَا أَدْرِی ، سَمِعْتُ النَّاسَ قَالُوا قَوْلاً ، فَقُلْتُ ، فَقَد وَاللَّہِ رَدِیتَ ، وخَزِیتَ، وَہَوِیتَ ، وَإِنْ قُلْتَ : مُحَمَّدٌ رَسُولُ اللہِ ، أَنْزَلَ اللَّہُ عَلَیْہِ کِتَابَہُ ، فآمَنْتُ بِہِ ، وَبِمَا جَائَ بِہِ ، فَقَدْ وَاللَّہِ نَجَوْتَ ، وَہُدِیتَ ، وَلَمْ تَسْتَطِعْ ذَلِکَ إِلاَّ بِتَثْبِیتٍ مِنَ اللہِ ، مَعَ مَا تَرَی مِنَ الشِّدَّۃِ وَالْخَوْفِ۔","Hasan","Musannaf Ibn Abi Shaybah 12177","","","كتاب الجنائز"
"12178","(۱۲۱۷۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَطْفَالُ الْمُسْلِمِینَ فِی جَبَلٍ بَیْنَ إبْرَاہِیمَ وَسَارَۃَ یَکْفُلُونَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 12178","","","كتاب الجنائز"
"12179","(۱۲۱۷۹) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، قَالَ : سَمِعْتُ الْبَرَائَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَمَّا مَاتَ إبْرَاہِیمُ ، قَالَ : أَمَا إنَّ لَہُ مُرْضِعًا فِی الْجَنَّۃِ۔ (احمد ۴/۳۰۰۔ ابن سعد ۱۳۹)","Sahih","Musannaf Ibn Abi Shaybah 12179","","","كتاب الجنائز"
"12180","(۱۲۱۸۰) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ لَہُ مُرْضِعًا فِی الْجَنَّۃِ تُتِمُّ بَقِیَّۃَ رَضَاعَتِہِ۔ (عبدالرزاق ۱۴۰۱۳۔ احمد ۴/۲۹۷)","","Musannaf Ibn Abi Shaybah 12180","","","كتاب الجنائز"
"12181","(۱۲۱۸۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، أَنَّ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صلی علیہ وَہُوَ ابْنُ سِتَّۃَ عَشَرَ شَہْرًا۔ (ابوداؤد ۳۱۸۰)","Da'if","Musannaf Ibn Abi Shaybah 12181","","","كتاب الجنائز"
"12182","(۱۲۱۸۲) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، أَنَّہُ لَمْ یَکُنْ لاَ یَرَی بَأْسًا بِرَشِّ الْمَائِ عَلَی الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 12182","","","كتاب الجنائز"
"12183","(۱۲۱۸۳) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ بَأْسَ بِرَشِّ الْمَائِ عَلَی الْقَبْرِ۔","","Musannaf Ibn Abi Shaybah 12183","","","كتاب الجنائز"
"12184","(۱۲۱۸۴) حدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ ، عَنْ عَبْدِ اللہِ بْنِ بَکْرٍ ، قَالَ : کُنْتُ فِی جِنَازَۃٍ وَمَعَنَا زِیَادُ بْنُ جُبَیْرِ بْنُ حَیَّۃَ ، فَلَمَّا سَوَّوُا الْقَبْرَ صُبَّ عَلَیْہِ الْمَائَ ، فَذَہَبَ رَجُلٌ یَمَسُّہُ وَیُصْلِحُہُ ، فَقَالَ : زِیَادٌ یُکْرَہُ أَنْ تَمَسَّ الأَیْدِی الْقَبْرَ بَعْدَ مَا یُرَشُّ عَلَیْہِ الْمَائُ۔","","Musannaf Ibn Abi Shaybah 12184","","","كتاب الجنائز"
"12185","(۱۲۱۸۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ زَاذَانَ : عَنِ الْبَرَائِ ، قَالَ : خَرَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی جِنَازَۃِ رَجُلٍ مِنَ الأَنْصَارِ ، فَانْتَہَیْنَا إلَی الْقَبْرِ وَلَمَّا یُلْحَدْ ، فَجَلَسَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَلَسْنَا حَوْلَہُ کَأَنَّمَا عَلَی رُؤُوسِنَا الطَّیْرُ ، وَفِی یَدِہِ عُودٌ یَنْکُتُ بِہِ ، فَرَفَعَ رَأْسَہُ ، فَقَالَ : اسْتَعِیذُوا بِاللَّہِ مِنْ عَذَابِ الْقَبْرِ ثَلاَثَ مَرَّاتٍ ، أَوْ مَرَّتَیْنِ ، ثُمَّ قَالَ : إنَّ الْعَبْدَ الْمُؤْمِنَ إذَا کَانَ فِی انْقِطَاعٍ مِنَ الدُّنْیَا وَإِقْبَالٍ مِنَ الآخِرَۃِ نَزَلَ إلَیْہِ مِنَ السَّمَائِ مَلاَئِکَۃٌ بِیضُ الْوُجُوہِ ، کَأَنَّ وُجُوہَہُمُ الشَّمْسُ ، حَتَّی یَجْلِسُونَ مِنْہُ مَدَّ الْبَصَرِ ، مَعَہُمْ کَفَنٌ مِنْ أَکْفَانِ الْجَنَّۃِ ، وَحَنُوطٌ مِنْ حَنُوطِ الْجَنَّۃِ ، ثُمَّ یَجِیئُ مَلَکُ الْمَوْتِ فَیَقْعُدُ عِنْدَ رَأْسِہِ فَیَقُولُ : أَیَّتُہَا النَّفْسُ الطَّیِّبَۃُ اخْرُجِی إلَی مَغْفِرَۃٍ مِنَ اللہِ وَرِضْوَانٍ ، فَتَخْرُجُ تَسِیلُ کَمَا تَسِیلُ الْقَطْرَۃُ مِنْ فِی السِّقَائِ فَیَأخذہا ، فَإِذَا أَخَذُوہَا لَمْ یَدَعُوہَا فِی یَدِہِ طَرْفَۃَ عَیْنٍ حَتَّی یَأْخُذُوہَا فَیَجْعَلُوہَا فِی ذَلِکَ الْکَفَنِ ، وَذَلِکَ الْحَنُوطِ ، فَیَخْرُجُ مِنْہَا کَأَطْیَبِ نَفْخَۃِ مِسْکٍ وُجِدَتْ عَلَی وَجْہِ الأَرْضِ ، فَیَصْعَدُونَ بِہَا فَلاَ یَمُرُّونَ بِہَا عَلَی مَلَکٍ مِنَ الْمَلاَئِکَۃِ إِلاَّ قَالُوا : مَا ہَذَا الرُّوحُ الطَّیِّبُ ؟ فَیَقُولُونَ: ہَذَا فُلاَنُ بْنُ فُلاَنٍ بِأَحْسَنِ أَسْمَائِہِ الَّتِی کَانَ یُسَمَّی بِہَا فِی الدُّنْیَا ، حَتَّی یَنْتَہُوا بِہَا إلَی السَّمَائِ الدُّنْیَا ، فَیَسْتَفْتِحُ فَیُفْتَحُ لَہُمْ ، فَیَسْتَقْبِلُہُ مِنْ کُلِّ سَمَائٍ مُقَرَّبُوہَا إلَی السَّمَائِ الَّتِی تَلِیہَا ، حَتَّی یَنْتَہِیَ بِہِ إلَی السَّمَائِ السَّابِعَۃِ ، قَالَ: فَیَقُولُ اللَّہُ تعالی اکْتُبُوا کِتَابَ عَبْدِی فِی عِلِّیِّینَ فِی السَّمَائِ الرَّابِعَۃِ، وَأَعِیدُوہُ إلَی الأَرْضِ، فَإِنِّی مِنْہَا خَلَقْتُہُمْ ، وَفِیہَا أُعِیدُہُمْ ، وَمِنْہَا أُخْرِجُہُمْ تَارَۃً أُخْرَی ، فَیُعَادُ رُوحُہُ فِی جَسَدِہِ ، وَیَأْتِیہِ مَلَکَانِ فَیُجْلِسَانِہِ فَ[corrupt]َقُولاَنِ لَہُ : مَنْ رَبُّک ؟ فَیَقُولُ : رَبِّی اللَّہُ فَیَقُولاَنِ لَہُ : مَا دِینُک ؟ فَیَقُولُ دِینِی الإِسْلاَمُ ، فَیَقُولاَنِ لَہُ : مَا ہَذَا الرَّجُلُ الَّذِی بُعِثَ فِیکُمْ ؟ فَیَقُولُ : ہُوَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَیَقُولاَنِ : مَا عَمَلُک بہ ؟ فَیَقُولُ : قَرَأْت کِتَابَ اللہِ وَآمَنْت بِہِ وَصَدَقْت بِہِ ، فَیُنَادِی مُنَادٍ مِنَ السَّمَائِ أَنْ صَدَقَ عَبْدِی فَأَفْرِشُوہُ مِنَ الْجَنَّۃِ ، وَأَلْبِسُوہُ مِنَ الْجَنَّۃِ ، وَافْتَحُوا لَہُ بَابًا إلَی الْجَنَّۃِ ، فَیَأْتِیہِ مِنْ طِیبِہَا وَرَوْحِہَا ، وَیُفْسَحُ لَہُ فِی قَبْرِہِ مَدَّ بَصَرِہِ ، وَیَأْتِیہِ رَجُلٌ حَسَنُ الْوَجْہِ ، حَسَنُ الثِّیَابِ ، طَیِّبُ الرِّیحِ ، فَیَقُولُ : أَبْشِرْ بِالَّذِی یَسُرُّک ، ہَذَا یَوْمُک الَّذِی کُنْت تُوعَدُ ، فَیَقُولُ : وَمَنْ أَنْتَ ؟ فَوَجْہُک الْوَجْہُ یَجِیئُ بِالْخَیْرِ ، فَیَقُولُ : أَنَا عَمَلُک الصَّالِحُ ، فَیَقُولُ : رَبِّ أَقِمِ السَّاعَۃَ ، رَبِّ أَقِمِ السَّاعَۃَ ، حَتَّی أَرْجِعَ إلَی أَہْلِی وَمَالِی ، وَإِنَّ الْعَبْدَ الْکَافِرَ إذَا کَانَ فِی انْقِطَاعٍ مِنَ الدُّنْیَا ، وَإِقْبَالٍ مِنَ الآخِرَۃِ ، نَزَلَ إلَیْہِ مِنَ السَّمَائِ مَلاَئِکَۃٌ سُودُ الْوُجُوہِ ، مَعَہُمَ الْمُسُوحُ ، حَتَّی یَجْلِسُونَ مِنْہُ مَدَّ الْبَصَرِ ، قَالَ : ثُمَّ یَجِیئُ مَلَکُ الْمَوْتِ ، حَتَّی یَجْلِسَ عِنْدَ رَأْسِہِ ، فَیَقُولُ : یَا أَیَّتُہَا النَّفْسُ الْخَبِیثَۃُ ، اخْرُجِی إلَی سَخَطِ اللہِ وَغَضَبِہِ ، قَالَ : فَتَفْرَّقُ فِی جَسَدِہِ ، قَالَ : فَتَخْرُجُ تُقَطَّعُ مَعَہَا الْعُرُوقُ وَالْعَصَبُ ، کَمَا تُنْزَعُ السَّفُّودَ مِنَ الصُّوفِ الْمَبْلُولِ ، فَیَأْخُذُوہَا فَإِذَا أَخَذُوہَا لَمْ یَدَعُوہَا فِی یَدِہِ طَرْفَۃَ عَیْنٍ حَتَّی یَأْخُذُوہَا فَیَجْعَلُوہَا فِی تِلْکَ الْمُسُوحِ ، فَیَخْرُجُ مِنْہَا کَأَنْتَنِ جِیفَۃٍ وُجِدَتْ عَلَی ظَہْرِ الأَرْضِ ، فَیَصْعَدُونَ بِہَا ، فَلاَ یَمُرُّونَ بِہَا عَلَی مَلَکٍ مِنَ الْمَلاَئِکَۃِ إِلاَّ قَالُوا : مَا ہَذَا الرُّوحُ الْخَبِیثُ ؟ فَیَقُولُونَ : فُلاَنُ بْنُ فُلاَنٍ ، بِأَقْبَحِ أَسْمَائِہِ الَّتِی کَانَ یُسَمَّی بِہَا فِی الدُّنْیَا حَتَّی یُنْتَہی بِہَا إلَی السَّمَائِ الدُّنْیَا ، فَیَسْتَفْتِحُونَ فَلاَ یُفْتَحُ لَہُ ، ثُمَّ قَرَأَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : {لاَ تُفَتَّحُ لَہُمْ أَبْوَابُ السَّمَائِ وَلاَ یَدْخُلُونَ الْجَنَّۃَ حَتَّی یَلِجَ الْجَمَلُ فِی سَمِّ الْخِیَاطِ} قَالَ : فَیَقُولُ اللَّہُ عَزَّ وَجَلَّ : اکْتُبُوا کِتَابَ عَبْدِی فِی سِجِّینٍ فِی الأَرْضِ السُّفْلَی ، وَأَعِیدُوہُ إلَی الأَرْضِ ، فَإِنِّی مِنْہَا خَلَقْتُہُمْ وَفِیہَا أُعِیدُہُمْ ، وَمِنْہَا أُخْرِجُہُمْ تَارَۃً أُخْرَی ، قَالَ : فَیُطْرَحُ رُوحُہُ طَرْحًا ، قَالَ : ثُمَّ قَرَأَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : {وَمَنْ یُشْرِکْ بِاَللَّہِ فَکَأَنَّمَا خَرَّ مِنَ السَّمَائِ فَتَخْطَفُہُ الطَّیْرُ أَوْ تَہْوِی بِہِ الرِّیحُ فِی مَکَان سَحِیقٍ} قَالَ : فَیُعَادُ رُوحُہُ فِی جَسَدِہِ ، وَیَأْتِیہِ مَلَکَانِ ، فَیُجْلِسَانِہِ فَیَقُولاَنِ لَہُ : مَنْ رَبُّک ؟ فَیَقُولُ : ہَاہَا لاَ أَدْرِی ، وَیَقُولاَنِ : لَہُ وَمَا دِینُک ، فَیَقُولُ : ہَاہَا لاَ أَدْرِی ، قَالَ : فَیُنَادِی مُنَادٍ مِنَ السَّمَائِ ، أفْرِشُوا لَہُ مِنَ النَّارِ ، وَأَلْبِسُوہُ مِنَ النَّارِ ، وَافْتَحُوا لَہُ بَابًا إلَی النَّارِ ، قَالَ : فَیَأْتِیہِ مِنْ حَرِّہَا وَسَمُومِہَا ، وَیُضَیَّقُ عَلَیْہِ قَبْرُہُ حَتَّی تَخْتَلِفَ فیہ أَضْلاَعُہُ ، وَیَأْتِیہِ رَجُلٌ قَبِیحُ الْوَجْہِ ، وَقَبِیحُ الثِّیَابِ ، مُنْتِنُ الرِّیحِ ، فَیَقُولُ : أَبْشِرْ بِالَّذِی یَسُوؤُک ، ہَذَا یَوْمُک الَّذِی کُنْت تُوعَدُ ، فَیَقُولُ : مَنْ أَنْتَ فَوَجْہُک الْوَجْہُ الَّذِی یَجِیئُ بِالشَّرِّ ؟ فَیَقُولُ : أَنَا عَمَلُک الْخَبِیثُ ، فَیَقُولُ : رَبِّ لاَ تُقِمِ السَّاعَۃَ ، رَبِّ لاَ تُقِمِ السَّاعَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 12185","","","كتاب الجنائز"
"12186","(۱۲۱۸۶) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حدَّثَنَا الأَعْمَشُ حدَّثَنَا الْمِنْہَالُ ، عَنْ زَاذَانَ ، عَنِ الْبَرَائِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوِہِ وَزَادَ فِیہِ : وَالسِّجِّینُ تَحْتَ الأَرْضِ السُّفْلَی۔","Da'if","Musannaf Ibn Abi Shaybah 12186","","","كتاب الجنائز"
"12187","(۱۲۱۸۷) حدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ شَقِیقٍ ، عَنْ أَبِی مُوسَی ، قَالَ تَخْرُجُ نَفْسُ الْمُؤْمِنِ وَہِیَ أَطْیَبُ رِیحًا مِنَ الْمِسْکِ ، قَالَ فَتَصْعَدُ بِہَا الْمَلاَئِکَۃُ الَّذِینَ یَتَوَفَّوْنَہَا فَتَلْقَاہُمْ مَلاَئِکَۃٌ دُونَ الْمَائِ فَیَقُولُونَ مَنْ ہَذَا مَعَکُمْ فَیَقُولُونَ فُلاَنُ بْنُ فُلاَنٍ وَیَذْکُرُونَہُ بِأَحْسَنِ عَمَلِہِ فَیَقُولُونَ حَیَّاکُمُ اللَّہُ وَحَیَّا مَنْ مَعَکُمْ ، قَالَ فَتُفْتَحُ لَہُ أَبْوَابُ السَّمَائِ ، قَالَ فَیُشْرِقُ وَجْہُہُ ، قَالَ فَیَأْتِی الرَّبَّ وَلِوَجْہِہِ بُرْہَانٌ مِثْلُ الشَّمْسِ ، قَالَ وَأَمَّا الآخَرُ فَتَخْرُجُ نَفْسُہُ وَہِیَ أَنْتَنُ مِنَ الْجِیفَۃِ فَیَصْعَدُ بِہَا الَّذِینَ یَتَوَفَّوْنَہَا ، قَالَ فَتَلْقَاہُمَ مَلاَئِکَۃُ دُونَ السَّمَائِ فَیَقُولُونَ مَنْ ہَذَا مَعَکُمْ فَیَقُولُونَ ہَذَا فُلاَنٌ وَیَذْکُرُونَہُ بِأَسْوَإِ عَمَلِہِ ، قَالَ فَیَقُولُونَ رُدُّوہُ فَمَا ظَلَمَہُ اللَّہُ شَیْئًا وَقَرَأَ أَبُو مُوسَی ، (وَلاَ یَدْخُلُونَ الْجَنَّۃَ حَتَّی یَلِجَ الْجَمَلُ فِی سَمِّ الْخِیَاطِ)۔","Da'if","Musannaf Ibn Abi Shaybah 12187","","","كتاب الجنائز"
"12188","(۱۲۱۸۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إنَّ الْمَیِّتَ لَیَسْمَعَ خَفْقَ نِعَالِہِمْ حِینَ یُوَلُّونَ عَنْہُ مُدْبِرِینَ ، فَإِنْ کَانَ مُؤْمِنًا کَانَتِ الصَّلاَۃُ عِنْدَ رَأْسِہِ وَکَانَتِ الزَّکَاۃُ عَنْ یَمِینِہِ وَکَانَ الصِّیَامُ عَنْ یَسَارِہِ وَکَانَ فِعْلُ الْخَیْرَاتِ مِنَ الصَّدَقَۃِ وَالصِّلَۃِ وَالْمَعْرُوفِ وَالإِحْسَانِ إلَی النَّاسِ عِنْدَ رِجْلَیْہِ فَیَؤتَی مِنْ قِبَلِ رَأْسِہِ فَتَقُولُ الصَّلاَۃُ مَا قِبَلِی مَدْخَلٌ وَیَأْتِی عَنْ یَمِینِہِ فَتَقُولُ الزَّکَاۃُ مَا قِبَلِی مَدْخَلٌ وَیَأْتِی عَنْ یَسَارِہِ فَیَقُولُ الصِّیَامُ مَا قِبَلِی مَدْخَل وَیَأْتِی مِنْ قِبَلِ رِجْلَیْہِ فَیَقُولُ فِعْلُ الْخَیْرِ مِنَ الصَّدَقَۃِ وَالصِّلَۃِ وَالْمَعْرُوفِ وَالإِحْسَانِ إلَی النَّاسِ مَا قِبَلِی مَدْخَلٌ ، قَالَ فَیُقَالُ لَہُ اجْلِسْ فَیَجْلِس قَدْ مُثِّلَتْ لَہُ الشَّمْسُ تَدَانَتْ لِلْغُرُوبِ فَیُقَالُ لَہُ أَخْبِرْنَا عَنْ مَا نَسْأَلُک عَنْہُ فَیَقُولُ دَعَوْنِی حَتَّی أُصَلِّیَ فَیُقَالُ لَہُ إنَّک سَتَفْعَلُ فَأَخْبِرْنَا عَمَّا نَسْأَلُک فَیَقُولُ وَعَمَّ تَسْأَلُونِی فَیَقُولُونَ أَرَأَیْت ہَذَا الرَّجُلَ الَّذِی کَانَ فِیکُمْ مَا تَقُولُ فِیہِ وَمَا تَشْہَدُ بِہِ عَلَیْہِ ، قَالَ فَیَقُولُ مُحَمَّدٌ فَیُقَالُ لَہُ نَعَمْ فَیَقُولُ أَشْہَدُ ، أَنَّہُ رَسُولُ اللہِ وَأَنَّہُ جَائَ بِالْبَیِّنَاتِ مِنْ عِنْدِ اللہِ فَصَدَّقْنَاہُ فَیُقَالُ لَہُ عَلَی ذَلِکَ حَیِیتَ وَعَلَی ذَلِکَ مُتَّ وَعَلَی ذَلِکَ تُبْعَثُ إِنْ شَائَ اللَّہُ تَعَالَی ، ثُمَّ یُفْسَحُ لَہُ فِی قَبْرِہِ سَبْعُونَ ذِرَاعًا وَیُنَوَّرُ لَہُ فِیہِ ، ثُمَّ یُفْتَحُ لَہُ بَابٌ إلَی الْجَنَّۃِ فَیُقَالُ لَہُ انْظُرْ إلَی مَا أَعَدَّ اللَّہُ لَکَ فِیہَا فَیَزْدَادُ غِبْطَۃً وَسُرُورًا ، ثُمَّ یُفْتَحُ لَہُ بَابٌ إلَی النَّارِ ، فَیُقَالُ لَہُ : ذَلِکَ مَقْعَدُک وَمَا أَعَدَّ اللَّہُ لَکَ فِیہَا لَو عَصَیتہ فَیَزْدَادُ غِبْطَۃً وَسُرُورًا ثُمَّ یُجْعَلُ نَسَمَۃً فی النَّسْمِ الطَّیِّبِ وَہِیَ طَیْرٌ خُضْرٌ تَعَلَّقَ بِشَجَرِ الْجَنَّۃِ وَیُعَادُ الْجِسْمُ إلَی مَا بُدِأَ مِنْہُ مِنَ التُّرَابِ فَذَلِکَ قَوْلُ اللہِ تَعَالَی : {یُثَبِّتُ اللَّہُ الَّذِینَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِی الْحَیَاۃِ الدُّنْیَا ، وَفِی الآخِرَۃِ} قَالَ مُحَمَّدٌ ، قَالَ عُمَرُ بْنُ الْحَکَمِ بْنِ ثَوْبَانَ : ثُمَّ یُقَالُ لَہُ نَمْ فَیَنَامُ نَوْمَۃَ الْعَرُوسِ لاَ یُوقِظُہُ إِلاَّ أَحَبُّ أَہْلِہِ إلَیْہِ ، حَتَّی یَبْعَثَہُ اللَّہُ عَزَّ وَجَلَّ ، قَالَ مُحَمَّدٌ ، قَالَ أَبُو سَلَمَۃَ ، قَالَ أَبُو ہُرَیْرَۃَ ، وَإِنْ کَانَ کَافِرًا فَیؤْتَی مِنْ قِبَلِ رَأْسِہِ ، فَلاَ یُوجَدُ لَہُ شَیْئٌ ، ثُمَّ یَأْتِی عَنْ یَمِینِہِ فَلاَ یُوجَدُ لَہُ شَیْئٌ ، ثُمَّ یَأْتِی عَنْ شِمَالِہِ فَلاَ یُوجَدُ لَہُ شَیْئٌ ، ثُمَّ یَأْتِی مِنْ قِبَلِ رِجْلَیْہِ فَلاَ یُوجَدُ لَہُ شَیْئٌ ، فَیُقَالُ لَہُ : اجْلِسْ فَیَجْلِسُ فَزِعًا مَرْعُوبًا ، فَیُقَالُ لَہُ : أَخْبِرْنَا عَمَّا نَسْأَلُک عَنْہُ ؟ فَیَقُولُ : وَعَمَّ تَسْأَلُونِی ؟ فَیُقَالُ : أَرَأَیْت ہَذَا الرَّجُلَ الَّذِی کَانَ فِیکُمْ مَاذَا تَقُولُ فِیہِ وَمَاذَا تَشْہَدُ بِہِ عَلَیْہِ ، قَالَ : فَیَقُولُ : أَیُّ رَجُلٍ ؟ قَالَ : فَیُقَالُ الَّذِی فِیکُمْ فَلاَ یَہْتَدِی لاِسْمِہِ فَیُقَالُ : مُحَمَّدٌ فَیَقُولُ : لاَ أَدْرِی سَمِعْت النَّاسَ یَقُولُونَ قَوْلاً فَقُلْت کَمَا قَالُوا : فَیُقَالُ عَلَی ذَلِکَ حَیِیتَ ، وَعَلَی ذَلِکَ مُتَّ ، وَعَلَی ذَلِکَ تَبْعَثُ إِنْ شَائَ اللَّہُ ، ثُمَّ یُفْتَحُ لَہُ بَابٌ إلَی النَّارِ ، فَیُقَالُ لَہُ ذَلِکَ مَقْعَدُک وَمَا أَعَدَّ اللَّہُ لَکَ فِیہَا ، فَیَزْدَادُ حَسْرَۃً وَثُبُورًا ، ثُمَّ یُفْتَحُ لَہُ بَابٌ إلَی الجَنَّۃَ فَیُقَالُ لَہُ ذَلِکَ مَقْعَدُک مِنْہَا فَیَزْدَاد حَسْرَۃً وَثُبُورًا ، ثُمَّ یُضَیَّقُ عَلَیْہِ قَبْرُہُ حَتَّی تَخْتَلِفَ أَضْلاَعُہُ ، وَہِیَ الْمَعِیشَۃُ الضَّنْکُ الَّتِی قَالَ اللَّہُ تَعَالَی : {فَإِنَّ لَہُ مَعِیشَۃً ضَنْکًا وَنَحْشُرُہُ یَوْمَ الْقِیَامَۃِ أَعْمَی}۔ (عبدالرزاق ۶۷۰۳)","Hasan","Musannaf Ibn Abi Shaybah 12188","","","كتاب الجنائز"
"12189","(۱۲۱۸۹) حدَّثَنَا وَکِیعٌ ، حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ عَبْدِ الرَّحْمَنِ السَّرَّاجِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ سَمِعَ رَجُلاً فِی جِنَازَۃٍ یَقُولُ : ارْفَعُوا عَلَی اسْمِ اللہِ ، فَقَالَ ابْنُ عُمَرَ : لاَ تَقُولُوا ارْفَعُوا عَلَی اسْمِ اللہِ فَإِنَّ اسْمَ اللہِ عَلَی کُلِّ شَیْئٍ ، وَقُولُوا : ارْفَعُوا بِسْمِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 12189","","","كتاب الجنائز"
"12190","(۱۲۱۹۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ الْمُزَنِیّ ، قَالَ : إذَا حَمَلْت السَّرِیرَ فَقُلْ : بِسْمِ اللہِ وَسَبِّحْ۔","","Musannaf Ibn Abi Shaybah 12190","","","كتاب الجنائز"
"12191","(۱۲۱۹۱) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ أَبِیہِ، عَنْ بَکْرِ بْنِ عَبْدِاللہِ قَالَ إذَا حَمَلَ، فَقَالَ: بِسْمِ اللہِ وَسَبَّحَ مَا حَمَلَ۔","","Musannaf Ibn Abi Shaybah 12191","","","كتاب الجنائز"
"12192","(۱۲۱۹۲) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنْ عَائِشَۃَ ، وَابْنِ عَبَّاسٍ ، أَنَّ أَبَا بَکْرٍ قَبَّلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدَ مَوْتِہِ۔ (بخاری ۵۷۱۱۔ ترمذی ۳۹۰)","Sahih","Musannaf Ibn Abi Shaybah 12192","","","كتاب الجنائز"
"12193","(۱۲۱۹۳) حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَۃَ قَالَتْ : قَبَّّلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عُثْمَانَ بْنَ مَظْعُونٍ وَہُوَ مَیِّتٌ فَرَأَیْت دُمُوعَہُ تَسِیلُ عَلَی خَدَّیْہِ۔ (ترمذی۹۸۹۔ ابوداؤد۳۱۵۵)","Da'if","Musannaf Ibn Abi Shaybah 12193","","","كتاب الجنائز"
"12194","(۱۲۱۹۴) حدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ أَبِی عِمْرَانَ الْجَوْنِیِّ ، عَنْ یَزِیدَ بْنِ بَابَنُوسَ ، عَنْ عَائِشَۃَ ، أَنَّ أَبَا بَکْرٍ قَبَّلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدَ مَوْتِہِ۔ (ابن سعد ۲۶۵)","Hasan","Musannaf Ibn Abi Shaybah 12194","","","كتاب الجنائز"
"12195","(۱۲۱۹۵) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنْ عَبْدِ اللہِ الْبَہِیِّ مَوْلَی آلِ الزُّبَیْرِ ، أَنَّ أَبَا بَکْرٍ جَائَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْدَ مَا قُبِضَ فَکَشَفَ عَنْ وَجْہِہِ فَأَکَبَّ عَلَیْہِ فَقَبَّلَہُ ، وَقَالَ : بِأَبِی أَنْتَ وَأُمِّی مَا أَطْیَبَ حَیَاتَکَ وَأَطْیَبَ مِیتَتُکَ۔","","Musannaf Ibn Abi Shaybah 12195","","","كتاب الجنائز"
"12196","(۱۲۱۹۶) حدَّثَنَا عَفَّانُ ، حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَاصِمُ بْنُ بَہْدَلَۃَ ، قَالَ : لَمَّا مَاتَ أَبُو وَائِلٍ قَبَّلَ أَبُو بُرْدَۃَ جَبْہَتَہُ۔","","Musannaf Ibn Abi Shaybah 12196","","","كتاب الجنائز"
"12197","(۱۲۱۹۷) حدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ زَائِدَۃَ بْنِ نَشِیطٍ ، عَنْ حُسَیْنِ بْنِ أَبِی عَائِشَۃَ ، عَنْ أَبِی خَالِدٍ الْوَالِبِیِّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَزَّی رَجُلاً ، فَقَالَ : یَرْحَمُہُ اللَّہُ وَیَأْجُرُک۔","Da'if","Musannaf Ibn Abi Shaybah 12197","","","كتاب الجنائز"
"12198","(۱۲۱۹۸) حدَّثَنَا یَحْیَی بْنُ یَمَانَ، عَنْ أَشْعَثَ، عَنْ شِمُر، أَنَّہُ کَانَ إذَا عَزَّی مُصَابًا ، قَالَ: اصْبِرْ لِحُکْمِ اللہِ رَبِّک۔","Hasan","Musannaf Ibn Abi Shaybah 12198","","","كتاب الجنائز"
"12199","(۱۲۱۹۹) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَوْدُودَ ، عَنْ طَلْحَۃَ بْنِ عُبَیْدِ اللہِ بْنِ کَرِیزٍ ، قَالَ : قَالَ مَنْ عَزَّی مُصَابًا کَسَاہُ اللَّہُ رِدَائً یُحْبَرُ بِہِ یَعْنِی یُغْبَطُ بِہِ۔","","Musannaf Ibn Abi Shaybah 12199","","","كتاب الجنائز"
"12200","(۱۲۲۰۰) حدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ دَاوُدَ بْنِ نَافِذٍ ، قَالَ : قُلْتُ لعبید اللہِ بْنِ عُبَیْدٍ کَیْفَ کَانَا ہَذَانِ الشَّیْخَانِ یُعَزِّیَانِ یَعْنِی ابْنَ الزُّبَیْرِ ، وعبید بْنَ عُمَیر ، قَالَ : کَانَا یَقُولاَنِ أَعْقَبَک اللَّہُ عُقْبَی الْمُتَّقِینَ صَلَوَاتٍ مِنْہُ وَرَحْمَۃٍ ، وَجَعَلَک مِنَ الْمُہْتَدِینَ ، وَأَعْقَبَک کَمَا أَعْقَبَ عِبَادَہُ الأَنْبِیَائَ وَالصَّالِحِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 12200","","","كتاب الجنائز"
"12201","(۱۲۲۰۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورِ بْنِ صَفِیَّۃَ ، قَالَ : سَمِعْتُ رَجُلاً یُقَالُ لَہُ یُوسُفُ یُحَدِّثُ أُمِّی ، قَالَ : مَنْ کَفَّنَ مَیِّتًا کَانَ کَمَنْ کَفَلَہُ صَغِیرًا حَتَّی یَکُونَ کَبِیرًا۔","","Musannaf Ibn Abi Shaybah 12201","","","كتاب الجنائز"
"12202","(۱۲۲۰۲) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی رَافِعٍ ، قَالَ : أَخْبَرَنِی مُخْبِرٌ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَفَّنَ مَیِّتًا کَسَاہُ اللَّہُ مِنْ سُنْدُسِ الْجَنَّۃِ وَحَرِیرِہَا۔ (حاکم ۳۵۴)","Da'if","Musannaf Ibn Abi Shaybah 12202","","","كتاب الجنائز"
"12203","(۱۲۲۰۳) حدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ أُمِّی افْتَتَلتْ نَفْسَہَا ، وَأَنَّہَا لَوْ تَکَلَّمَتْ تَصَدَّقَتْ ، فَہَلْ لَہَا مِنْ أَجْرٍ إِنْ تَصَدَّقْت عَنْہَا ، قَالَ : نَعَمْ۔ (بخاری ۲۷۶۰۔ مسلم ۵۱)","Sahih","Musannaf Ibn Abi Shaybah 12203","","","كتاب الجنائز"
"12204","(۱۲۲۰۴) حدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَنَّہُ سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ إنَّ الْعَاصِ بْنَ وَائِلٍ کَانَ یَأْمُرُ فِی الْجَاہِلِیَّۃِ أَنْ تُنْحَرَ مِئَۃ بَدَنَۃٍ ، وَإِنَّ ہِشَامَ بْنَ الْعَاصِ نَحَرَ حِصَّتَہُ مِنْ ذَلِکَ خَمْسِینَ بَدَنَۃً ، أَفَأَنْحَرُ عَنْہُ ، فَقَالَ : إنَّ أَبَاک لَوْ کَانَ أَقَرَّ بِالتَّوْحِیدِ فَصُمْت عَنْہُ ، أَوْ تَصَدَّقْت عَنْہُ ، أَوْ أَعْتَقْتَ عَنْہُ بَلَغَہُ ذَلِکَ۔ (بیہقی ۲۷۹)","Hasan","Musannaf Ibn Abi Shaybah 12204","","","كتاب الجنائز"
"12205","(۱۲۲۰۵) حدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، قَالَ : لَوْ تَصَدَّقَ ، عَنِ الْمَیِّتِ بِکُرَاعٍ لَتَبِعَہُ۔","","Musannaf Ibn Abi Shaybah 12205","","","كتاب الجنائز"
"12206","(۱۲۲۰۶) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ سَعْدَ بْنَ عُبَادَۃَ اسْتَفْتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی نَذْرٍ کَانَ عَلَی أُمِّہِ تُوُفِّیَتْ قَبْلَ أَنْ تَقْضِیَہُ ، فَقَالَ : اقْضِہِ عَنْہَا۔n(بخاری ۶۶۹۸۔ مسلم ۱۲۶۰)","Sahih","Musannaf Ibn Abi Shaybah 12206","","","كتاب الجنائز"
"12207","(۱۲۲۰۷) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ عَاصِمٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ الرَّجُلَ لَیُرْقَی الدَّرَجَۃَ ، فَیَقُولُ : مَا ہَذَا فَیُقَالُ بِاسْتِغْفَارِ وَلَدِکَ مِنْ بَعْدِکَ لَک۔ (احمد ۲/۵۰۹۔ بیہقی ۷۹)","Sahih","Musannaf Ibn Abi Shaybah 12207","","","كتاب الجنائز"
"12208","(۱۲۲۰۸) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إنَّ الرَّجُلَ لَیُرْفَعُ بِدُعَائِ وَلَدِہِ لَہُ مِنْ بَعْدِہِ۔","","Musannaf Ibn Abi Shaybah 12208","","","كتاب الجنائز"
"12209","(۱۲۲۰۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عَطَائٍ ، وعَنْ َسُفْیَانَ عن زَیْدِ بْنِ أَسْلَمَ قَالا : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ أُعْتِقُ عَنْ أَبِی وَقَدْ مَاتَ ؟ قَالَ : نَعَمْ۔ (عبدالرزاق ۱۶۳۴۰)","","Musannaf Ibn Abi Shaybah 12209","","","كتاب الجنائز"
"12210","(۱۲۲۱۰) حدَّثَنَا وَکِیعٌ ، حدَّثَنَا ابْنُ رَوَّادٍ ، حدَّثَنَا شَرِیکٌ ، عَنِ الْحَجَّاجِ بْنِ دِینَارٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ مِنَ الْبِرِّ بَعْدَ الْبِرِّ أَنْ تُصَلِّیَ عَلَیْہِمَا مَعَ صَلاَتِکَ ، وَأَنْ تَصُومَ عْنہُمَا مَعَ صِیَامِکَ ، وَأَنْ تَصَدَّقَ عَنْہُمَا مَعَ صَدَقَتِک۔","","Musannaf Ibn Abi Shaybah 12210","","","كتاب الجنائز"
"12211","(۱۲۲۱۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ یُقْضَی ، عَنِ الْمَیِّتِ أَرْبَعٌ الْعِتْقُ وَالصَّدَقَۃُ وَالْحَجُّ وَالْعُمْرَۃُ۔","","Musannaf Ibn Abi Shaybah 12211","","","كتاب الجنائز"
"12212","(۱۲۲۱۲) حدَّثَنَا وَکِیعٌ، عَنْ أَبِیہِ، عَنْ عَبْدِالْکَرِیمِ، عَنْ عَطَائٍ، قَالَ: یَتْبَعُ الْمَیِّتَ بَعْدَ مَوْتِہِ الْعِتْقُ وَالْحَجُّ وَالصَّدَقَۃُ۔","","Musannaf Ibn Abi Shaybah 12212","","","كتاب الجنائز"
"12213","(۱۲۲۱۳) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ اللہِ بْنِ عَطَائٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذْ جَائَتْہُ امْرَأَۃٌ ، فَقَالَتْ : إِنَّہُ کَانَ عَلَی أُمِّی صَوْمُ شَہْرَیْنِ أَفَیَجْزِی عَنْہَا أَنْ أَصُومَ عَنْہَا ، قَالَ : نَعَمْ قَالَتْ فَإِنَّ أُمِّی لَمْ تَحُجَّ قَطُّ أَفَیَجْزِی أَنْ أَحُجَّ عَنْہَا ، قَالَ : نَعَمْ۔ n(مسلم ۱۵۸۔ احمد۳۵۱)","Sahih","Musannaf Ibn Abi Shaybah 12213","","","كتاب الجنائز"
"12214","(۱۲۲۱۴) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ اللہِ بْنِ عَطَائٍ ، عَنْ أَبِی جَعْفَرٍ ، أَنَّ الْحَسَنَ وَالْحُسَیْنَ کَانَا یُعْتِقَانِ ، عَنْ عَلِیٍّ بَعْدَ مَوْتِہِ۔","","Musannaf Ibn Abi Shaybah 12214","","","كتاب الجنائز"
"12215","(۱۲۲۱۵) حدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَبِی حَبِیبٍ ، عَنْ سَعْدِ بْنِ سِنَان ، عَنْ أَنَسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الصَّبْرُ فِی الصَّدْمَۃِ الأُولَی۔ (ترمذی ۹۸۷۔ ابن ماجہ ۱۵۹۶)","Da'if","Musannaf Ibn Abi Shaybah 12215","","","كتاب الجنائز"
"12216","(۱۲۲۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ، عَنْ مُجَاہِدٍ، قَالَ: کَانَ یُقَالُ إنَّمَا الصَّبْرُ عِنْدَ الصَّدْمَۃِ الأُولَی۔","","Musannaf Ibn Abi Shaybah 12216","","","كتاب الجنائز"
"12217","(۱۲۲۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ الْعُقَیْلِیِّ ، عَنْ أَبِی سَلَمَۃَ الْحِمْصِیِّ ، قَالَ الصَّبْرُ عِنْدَ الصَّدْمَۃِ الأُولَی۔","","Musannaf Ibn Abi Shaybah 12217","","","كتاب الجنائز"
"12218","(۱۲۲۱۸) حدَّثَنَا یَحْیَی بْنُ أبی بُکَیْر ، عَنْ شُعْبَۃَ ، عَنْ ثَابِتٍ ، قَالَ : سَمِعْتُ أَنَسًا یَقُولُ إنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ الصَّبْرَ فِی أَوْ عِنْدَ الصَّدْمَۃِ الأُولَی۔ (بخاری ۱۲۵۲۔ ابوداؤد ۳۱۱۵)","Sahih","Musannaf Ibn Abi Shaybah 12218","","","كتاب الجنائز"
"12219","(۱۲۲۱۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الصَّبْرُ عِنْدَ الصَّدْمَۃِ الأُولَی۔","","Musannaf Ibn Abi Shaybah 12219","","","كتاب الجنائز"
"12220","(۱۲۲۲۰) حدَّثَنَا ابْنُ عُلَیَّۃُ ، عَنْ حَبِیبِ بْنِ الشَّہِیدِ ، عَنِ ابْنِ سِیرِینَ ، أَنَّ زَیْدَ بْنَ ثَابِتٍ اسْتَأْذَنَ عُثْمَانَ فِی نَبْشِ قُبُورٍ کَانَتْ فِی مَسْجِدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَذِنَ لَہُ فَنَبَشَہَا وَأَخْرَجَہَا مِنَ الْمَسْجِدِ ، قَالَ وَإِنَّمَا کَانَتْ تُرِکَتْ فِی الْمَسْجِدِ لأَنَّہُ کَانَ فِی أَرَقَّائِ النَّاسِ قِلَّۃٌ۔","","Musannaf Ibn Abi Shaybah 12220","","","كتاب الجنائز"
"12221","(۱۲۲۲۱) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی التَّیَّاحِ ، عَنْ أَنَسٍ ، أَنَّ مَسْجِدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ لِبَنِی النَّجَّارِ ، فَقَالَ لَہُم رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَامِنُونِی بِہِ فَقَالُوا : لاَ نَلْتَمِسُ بِہِ ثَمَنًا إِلاَّ عِنْدَ اللہِ وَکَانَ فِیہِ قُبُورٌ مِنْ قُبُورِ الْمُشْرِکِینَ وَنَخْلٌ وَحَرْثٌ فَأَمَرَ بِالْحَرْثِ فحرث وَبِالنَّخْلِ فَقُطِعَ وَبِالْقُبُورِ فَنُبِشَتْ۔ (بخاری ۴۲۸۔ مسلم ۱۰)","Sahih","Musannaf Ibn Abi Shaybah 12221","","","كتاب الجنائز"
"12222","(۱۲۲۲۲) حدَّثَنَا أَبُو أُسَامَۃَ، أَخْبَرَنَا إسْمَاعِیلُ، أَخْبَرَنَا قَیْسٌ، قَالَ رَمَی مَرْوَانُ طَلْحَۃَ یَوْمَ الْجَمَلِ بِسَہْمٍ فِی رُکْبَتِہِ فَمَاتَ فَدَفَنَّاہُ عَلَی شَاطِیئِ الْکَلاَّئِ فَرَأَی بَعْضُ أَہْلِہِ ، أَنَّہُ قَالَ أَلاَ تُرِیحُونِی مِنْ ہَذَا الْمَائِ فَإِنِّی قد غَرِقْت ثَلاَثَ مَرَّاتٍ یَقُولُہَا ، قَالَ فَنَبَشُوہُ فَاشْتَرَوْا لَہُ دَارًا مِنْ دور آلِ أَبِی بَکْرَۃَ بِعَشْرَۃِ آلاَفٍ فَدَفَنُوہُ فِیہَا۔","","Musannaf Ibn Abi Shaybah 12222","","","كتاب الجنائز"
"12223","(۱۲۲۲۳) حدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، حدَّثَنَا شُعْبَۃُ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنِ ابْنِ عُمَرَ ، عَنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْمَیِّتُ یُعَذَّبُ فِی قَبْرِہِ بِالنِّیَاحَۃِ۔ (بخاری ۱۲۹۲۔ مسلم ۶۳۹)","Sahih","Musannaf Ibn Abi Shaybah 12223","","","كتاب الجنائز"
"12224","(۱۲۲۲۴) حدَّثَنَا وَکِیعٌ ، حدَّثَنَا سَعِیدُ بْنُ عُبَیْدٍ وَمُحَمَّدُ بْنُ قَیْسٍ الأَسَدِیُّ ، سَمِعَاہ مِنْ عَلِیِّ بْنِ رَبِیعَۃَ الْوَالِبِیِّ ، قَالَ أَوَّلُ مَنْ نِیحَ عَلَیْہِ بِالْکُوفَۃِ قَرَظَۃُ بْنُ کَعْبٍ الأَنْصَارِیُّ فَقَامَ الْمُغِیرَۃُ بْنُ شُعْبَۃَ ، فَقَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ نِیحَ عَلَیْہِ ، فَإِنَّہُ یُعَذَّبُ فِی قَبْرِہِ بِمَا نِیحَ عَلَیْہِ۔n(بخاری ۱۲۹۱۔ مسلم ۶۴۴)","Sahih","Musannaf Ibn Abi Shaybah 12224","","","كتاب الجنائز"
"12225","(۱۲۲۲۵) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ ، عَنْ عُبَادَۃَ بْنِ الْوَلِیدِ بْنِ عُبَادَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ نِیحَ عَلَیْہِ ، فَإِنَّہُ یُعَذَّبُ بِمَا نِیحَ عَلَیْہِ یَوْمَ الْقِیَامَۃِ۔ (احمد ۶۱)","Sahih","Musannaf Ibn Abi Shaybah 12225","","","كتاب الجنائز"
"12226","(۱۲۲۲۶) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ حَفْصَۃَ ، عَنْ أُمِّ عَطِیَّۃَ قَالَتْ لَمَّا نَزَلَتْ {إذَا جَائَک الْمُؤْمِنَاتُ یُبَایِعْنَکَ) إلَی قَوْلِہِ : {وَلاَ یَعْصِینَک فِی مَعْرُوفٍ} قَالَتْ : کان مِنْہُ النِّیَاحَۃَ فَقُلْتُ : یَا رَسُولَ اللہِ إِلاَّ آلَ فُلاَنٍ فَإِنَّہُمْ قَدْ کَانُوا أَسْعَدُونِی فِی الْجَاہِلِیَّۃِ ، فَقَالَ : إِلاَّ آلَ فُلاَنٍ۔ (بخاری ۴۸۹۲۔ مسلم ۳۲)","Sahih","Musannaf Ibn Abi Shaybah 12226","","","كتاب الجنائز"
"12227","(۱۲۲۲۷) حدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ - مَوْلَی الصَّہْبَائِ - عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أُمِّ سَلَمَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، {وَلاَ یَعْصِینَک فِی مَعْرُوفٍ} قَالَ : النَّوْحُ۔ (ترمذی ۳۳۰۷۔ احمد ۳۲۰)","Da'if","Musannaf Ibn Abi Shaybah 12227","","","كتاب الجنائز"
"12228","(۱۲۲۲۸) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ مِمَّا بِالنَّاسِ کُفْرًا النِّیَاحَۃُ وَالطَّعَنُ فِی الأَنْسَابِ۔ (مسلم ۱۲۱۔ ترمذی ۱۰۰۱)","Sahih","Musannaf Ibn Abi Shaybah 12228","","","كتاب الجنائز"
"12229","(۱۲۲۲۹) حدَّثَنَا عَفَّانُ ، حدَّثَنَا أَبَانٌ الْعَطَّارُ ، حدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ زَیْدِ عن أَبِی سَلاَّمٍ ، عَنْ أَبِی مَالِکٍ الأَشْعَرِیِّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَرْبَعٌ فِی أُمَّتِی مِنَ الْجَاہِلِیَّۃِ لاَ یَتْرُکُونَہُنَّ الْفَخْرُ فِی الأَحْسَابِ ، وَالطَّعَنُ فِی الأَنْسَابِ وَالاِسْتِسْقَائُ بِالنُّجُومِ وَالنِّیَاحَۃُ ، وَالنَّائِحَۃُ إذَا لَمْ تَتُبْ مِنْ قَبْلِ مَوْتِہَا تُقَامُ یَوْمَ الْقِیَامَۃِ عَلَیْہَا سِرْبَالٌ مِنْ قَطِرَانٍ وَدِرْعٌ مِنْ جَرَبٍ۔ (مسلم ۲۹۔ احمد ۵/۳۴۲)","Sahih","Musannaf Ibn Abi Shaybah 12229","","","كتاب الجنائز"
"12230","(۱۲۲۳۰) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ نُہِیَ عَنِ النَّوْحِ۔ (ابوداؤد ۲۰۶۹۔ عبدالرزاق ۱۰۷۹)","Da'if","Musannaf Ibn Abi Shaybah 12230","","","كتاب الجنائز"
"12231","(۱۲۲۳۱) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ، عَنْ عَلِیٍّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ نَہَی عَنِ النَّوْحِ۔","Da'if","Musannaf Ibn Abi Shaybah 12231","","","كتاب الجنائز"
"12232","(۱۲۲۳۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمٍ : (وَلاَ یَعْصِینَک فِی مَعْرُوفٍ) قَالَ : النَّوْحُ۔","","Musannaf Ibn Abi Shaybah 12232","","","كتاب الجنائز"
"12233","(۱۲۲۳۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِلاَلِ بْنِ خَبَّابٍ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : النَّوْحُ عَلَی الْمَیِّتِ مِنْ أَمْرِ الْجَاہِلِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 12233","","","كتاب الجنائز"
"12234","(۱۲۲۳۴) حدَّثَنَا وَکِیعٌ ، حدَّثَنَا إِسْحَاقُ بْنُ عُثْمَانَ الْکِلاَبِیُّ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَطِیَّۃَ الأَنْصَارِیِّ، عَنْ أُمِّہِ ، قَالَ : قُلْتُ لَہَا مَا الْمَعْرُوفُ الَّذِی نُہِیتُنَّ عَنْہُ قَالَتِ : النِّیَاحَۃُ۔ (احمد ۵/۸۵۔ ابوداؤد ۱۱۳۲)","Da'if","Musannaf Ibn Abi Shaybah 12234","","","كتاب الجنائز"
"12235","(۱۲۲۳۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ : (وَلاَ یَعْصِینَک فِی مَعْرُوفٍ) قَالَ : لاَ یَشْقُقْنَ جَیْبًا ، وَلاَ یَخْمُشْنَ وَجْہًا ، وَلاَ یَنْشُرْنَ شَعْرًا ، وَلاَ یَدْعُونَ وَیْلاً۔","","Musannaf Ibn Abi Shaybah 12235","","","كتاب الجنائز"
"12236","(۱۲۲۳۶) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ ، عَنْ أَبِی الْعَالِیَۃِ (وَلاَ یَعْصِینَک فِی مَعْرُوفٍ) قَالَ : فِی کُلِّ أَمْرٍ وَافَقَ لِلَّہِ طَاعَۃً وَلَمْ یَرْضَ لِنَبِیِّہِ أَنْ یُطَاعَ فِی مَعْصِیَۃِ اللہِ۔","","Musannaf Ibn Abi Shaybah 12236","","","كتاب الجنائز"
"12237","(۱۲۲۳۷) حدَّثَنَا وَکِیعٌ ، عَنْ قَاسِمٍ الْجُعْفِیِّ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ لُعِنَتِ النَّائِحَۃُ وَالْمُمْسِکَۃُ۔","","Musannaf Ibn Abi Shaybah 12237","","","كتاب الجنائز"
"12238","(۱۲۲۳۸) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، وَوَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّمَا نَہَیتُ عَنِ النَّوْحِ۔ (ترمذی ۱۰۰۵)","Da'if","Musannaf Ibn Abi Shaybah 12238","","","كتاب الجنائز"
"12239","(۱۲۲۳۹) حدَّثَنَا شَرِیکٌ، عَنْ یَعْلَی، عَنْ عَطَائِ بْنِ السَّائِبِ، قَالَ: کَانَ أَبُو الْبَخْتری رَجُلاً رَقِیقا وَکَانَ یَسْمَعُ النَّوْحَ۔","","Musannaf Ibn Abi Shaybah 12239","","","كتاب الجنائز"
"12240","(۱۲۲۴۰) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ صَالِحٍ ، قَالَ أَرَاہُ عَنْ أَبِی وَائِلٍ ، أَنَّہُ کَانَ یَسْتَمِعُ النَّوْحَ وَیَبْکِی۔","","Musannaf Ibn Abi Shaybah 12240","","","كتاب الجنائز"
"12241","(۱۲۲۴۱) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ لَمَّا أُصِیبَ عُمَرُ جَعَلَ صُہَیْبٌ یَقُولُ وَا أَخَاہُ ، قَالَ : فَقَالَ لَہُ عُمَرُ یَا صُہَیْبُ أَمَا عَلِمْت ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ الْمَیِّتَ لَیُعَذَّبُ بِبُکَائِ الْحَیِّ۔ (بخاری ۱۲۹۰۔ مسلم ۱۹)","Sahih","Musannaf Ibn Abi Shaybah 12241","","","كتاب الجنائز"
"12242","(۱۲۲۴۲) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، حدَّثَنَا عُبَیْدِ اللہِ بْنُ عُمَرُ، عَنْ نَافِعٍ، عَنْ عَبْدِ اللہِ، أَنَّ حَفْصَۃَ بَکَتْ عَلَی عُمَرَ، فَقَالَ: مَہْلاً یَا بُنَیَّۃَ أَلَمْ تَعْلَمِی أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: إنَّ الْمَیِّتَ لَیُعَذَّبُ بِبُکَائِ أَہْلِہِ عَلَیْہِ۔n(مسلم ۱۶۔ احمد ۱/۳۶)","Sahih","Musannaf Ibn Abi Shaybah 12242","","","كتاب الجنائز"
"12243","(۱۲۲۴۳) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ صُبَیْحٍ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ سِیرِینَ ، قَالَ ذَکَرُوا عِنْدَ عِمْرَانَ بْنِ الْحُصَیْنِ الْمَیِّتَ یُعَذَّبُ بِبُکَائِ الْحَیِّ قَالُوا : وَکَیْفَ یُعَذَّبُ بِبُکَائِ الْحَیِّ ، قَالَ قَدْ قَالَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۴/۴۳۷)","Hasan","Musannaf Ibn Abi Shaybah 12243","","","كتاب الجنائز"
"12244","(۱۲۲۴۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الْمَیِّتَ لَیُعَذَّبُ بِبُکَائِ الْحَیِّ۔ (بخاری ۱۲۸۶۔ مسلم ۲۴)","Sahih","Musannaf Ibn Abi Shaybah 12244","","","كتاب الجنائز"
"12245","(۱۲۲۴۵) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ أَبِیہِ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ قَالَتْ أُمُّ سَلَمَۃَ لَمَّا مَاتَ أَبُو سَلَمَۃَ قُلْتُ غَرِیبۃ وَفِی أَرْضِ غُرْبَۃٍ لأبکینہ بُکَائً یُتَحَدَّثُ عَنْہُ ، فَکُنْت تَہَیَّأْت لِلْبُکَائِ إذْ أَقْبَلَتِ امْرَأَۃٌ مِنَ الصعید تُرِیدُ أَنْ تُسْعِدَنِی فَاسْتَقْبَلَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : تُرِیدِینَ أَنْ تُدْخِلِی الشَّیْطَانَ بَیْتًا أَخْرَجَہُ اللَّہُ مِنْہُ مَرَّتَیْنِ قَالَتْ : فَسَکَتُّ عَنِ الْبُکَائِ فَلَمْ أَبْکِ۔ (مسلم ۱۰۔ احمد ۶/۲۸۹)","Sahih","Musannaf Ibn Abi Shaybah 12245","","","كتاب الجنائز"
"12246","(۱۲۲۴۶) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : لَمَّا أَتَتْ وَفَاۃُ جَعْفَرٍ عَرَفْنَا فِی وَجْہِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْحُزْنَ فَدَخَلَ عَلَیْہِ رَجُلٌ ، فَقَالَ : یَا رَسُولَ اللہِ إنَّ النِّسَائَ یَبْکِینَ ، قَالَ : فَارْجِعْ إلَیْہِنَّ فَأَسْکِتْہُنَّ ، فَإِنْ أَبَیْنَ فَاحْثُ فِی وُجُوہِہِنَّ التُّرَابَ قَالَ: قَالَتْ عَائِشَۃُ : فَقُلْت فِی نَفْسِی وَاللَّہِ لاَ تَرَکْت نَفْسَک ، وَلاَ أَنْتَ مُطِیعٌ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۱۲۹۹۔ مسلم ۶۴۴)","Hasan","Musannaf Ibn Abi Shaybah 12246","","","كتاب الجنائز"
"12247","(۱۲۲۴۷) حدَّثَنَا ابْنُ نُمَیْرٍ ، حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّہَا قِیلَ لَہَا إنَّ ابْنَ عُمَرَ یَرْفَعُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الْمَیِّتَ یُعَذَّبُ بِبُکَائِ الْحَیِّ ، فَقَالَتْ وَہَلَ أَبُو عَبْدِ الرَّحْمَنِ إنَّمَا قَالَ : إنَّ أَہْلَ الْمَیِّتِ لَیَبْکُونَ عَلَیْہِ ، وَإِنَّہُ لَیُعَذَّبُ بِجُرْمِہِ۔ (بخاری ۳۹۷۸۔ مسلم ۲۵)","Sahih","Musannaf Ibn Abi Shaybah 12247","","","كتاب الجنائز"
"12248","(۱۲۲۴۸) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حدَّثَنَا مِسْعَرٌ ، عَنِ الْہَجَرِیِّ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : رَأَی النِّسَائَ یَتَرَثَّیْنَ ، فَقَالَ : لاَ تَتَرَثَّیْنَ فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَانَا ، أَن نَتَرَاثی۔ (ابن ماجہ ۱۵۹۲۔ طیالسی ۸۲۵)","Da'if","Musannaf Ibn Abi Shaybah 12248","","","كتاب الجنائز"
"12249","(۱۲۲۴۹) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، حدَّثَنَا إسْرَائِیلُ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، عَنْ جَبْرِ بْنِ عَتِیکٍ ، عَنْ عَمِّہِ ، قَالَ دَخَلْت مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی رَجُلٍ مِنَ الأَنْصَارِ وَأَہْلُہُ یَبْکُونَ فَقُلْت أَتَبْکُونَ عَلَیْہِ وَہَذَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : دَعْہُم یَبْکِینَ مَا دَامَ عِنْدَہُنَّ فَإِذَا وَجَبَ لَمْ یَبْکِینَ۔ (ابوداؤد ۳۱۰۲۔ احمد ۵/۴۴۶)","","Musannaf Ibn Abi Shaybah 12249","","","كتاب الجنائز"
"12250","(۱۲۲۵۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، قَالَ دَمَعَتْ عَیْنُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ أُتِیَ بِابْنَۃِ زَیْنَبَ وَنَفْسُہَا تَقَعْقَعُ: کأَنَّہَا فِی شَنٍّ ، قَالَ فَبَکَی ، قَالَ: فَقَالَ لَہُ: رَجُلٌ تَبْکِی وَقَدْ نَہَیْتَ عَنِ الْبُکَائِ ، فَقَالَ: إنَّمَا ہَذِہِ رَحْمَۃٌ جَعَلَہَا اللَّہُ فِی قُلُوبِ عِبَادِہِ وَإِنَّمَا یَرْحَمُ اللَّہُ مِنْ عِبَادِہِ الرُّحَمَائَ۔ (مسلم ۶۳۶۔ احمد ۵/۲۰۴)","Sahih","Musannaf Ibn Abi Shaybah 12250","","","كتاب الجنائز"
"12251","(۱۲۲۵۱) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ أَخَذَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِیَدِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ فَخَرَجَ بِہِ إلَی النَّخْلِ فَأُتِیَ بِإِبْرَاہِیمَ وَہُوَ یَجُودُ بِنَفْسِہِ فَوُضِعَ فِی حَجْرِہِ ، فَقَالَ : یَا بُنَیَّ لاَ أَمْلِکُ لَکَ مِنَ اللہِ شَیْئًا وَذَرَفَتْ عَیْنَاہُ ، فَقَالَ لَہُ عَبْدُ الرَّحْمَنِ تَبْکِی یَا رَسُولَ اللہِ أَوَ لَمْ تَنْہَ عَنِ الْبُکَائِ ، قَالَ : إنَّمَا نَہَیْتُ عَنِ النَّوْحِ ، عَنْ صَوْتَیْنِ أَحْمَقَیْنِ فَاجِرَیْنِ ، صَوْتٍ عِنْدَ نِغمَۃ لَہْوٍ وَلَعِبٍ ، وَمَزَامِیرِ شَیْطَانٍ ، وَصَوْتٍ عِنْدَ مُصِیبَۃٍ ، خَمْشِ وُجُوہٍ ، وَشَقِّ جُیُوبٍ ، وَرَنَّۃِ شَیْطَانٍ ، إنَّمَا ہَذِہِ رَحْمَۃٌ ، وَمَنْ لاَ یَرْحَمْ لاَ یُرْحَمْ ، یَا إبْرَاہِیمَ لَوْلا أَنَّہُ أَمْرٌ حَقٌّ ، وَوَعْدٌ صِدْقٌ ، وَسَبِیلٌ مَأتِیَّۃٌ ، وَأَنَّ أُخْرَانَا سَیََلْحَقَ أُولنَا لَحَزِنَّا عَلَیْک حُزْنًا أَشَدَّ مِنْ ہَذَا ، وَإِنَّا بِکَ لَمَحْزُونُونَ ، تَبْکِی الْعَیْنُ وَیَحْزَنُ الْقَلْبُ ، وَلاَ نَقُولُ مَا یُسْخِطُ الرَّبَّ۔","Da'if","Musannaf Ibn Abi Shaybah 12251","","","كتاب الجنائز"
"12252","(۱۲۲۵۲) حدَّثَنَا وَکِیعٌ ، حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَ ذُکِرَ لَہَا حَدِیثُ ابْنِ عُمَرَ ، إنَّ الْمَیِّتَ لَیُعَذَّبُ بِبُکَائِ الْحَیِّ ، فَقَالَتْ : وَہَلَ أَبُو عَبْدِ الرَّحْمَنِ کَمَا وَہَلَ یَوْمَ قَلِیبِ بَدْرٍ إنَّمَا قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّہُ لَیُعَذَّبُ وَإِنَّ أَہْلَہُ لَیَبْکُونَ عَلَیْہِ۔ (احمد ۶/۲۰۹)","Sahih","Musannaf Ibn Abi Shaybah 12252","","","كتاب الجنائز"
"12253","(۱۲۲۵۳) حدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، حدَّثَنَا سُلَیْمَانُ بْنُ الْمُغِیرَۃِ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وُلِدَ لِی اللَّیْلَۃَ غُلاَمٌ فَسَمَّیْتُہُ بِاسْمِ أَبِی إبْرَاہِیمَ ، قَالَ ، ثُمَّ دَفَعَہُ إلَی أُمِّ سَیْفٍ امْرَأَۃِ قَیْنٍ بِالْمَدِینَۃِ یُقَالُ لَہُ أَبُو سَیْفٍ ، فَانْطَلَقَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَانْطَلَقْتُ مَعَہُ ، فَصَادَفْنَا أَبَا سَیْفٍ یَنْفُخُ فِی کِیرِہِ ، وَقَدِ امْتَلأَ الْبَیْتُ دُخَانًا ، فَأَسْرَعْت الْمَشْیَ بَیْنَ یَدَیِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی انْتَہِیَ إلَی أَبِی سَیْفٍ، فَقُلْت: یَا أَبَا سَیْفٍ أَمْسِکْ أَمْسِکْ جَائَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَمْسَکَ، فَدَعَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالصَّبِیِّ فَضَمَّہُ إلَیْہِ ، وَقَالَ مَا شَائَ اللَّہُ أَنْ یَقُولَ ، قَالَ أَنَسٌ : فَلَقَدْ رَأَیْتُہُ یَکِیدُ بِنَفْسِہِ ، قَالَ : فَدَمَعَتْ عَیْنَا النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَدْمَعُ الْعَیْنُ وَیَحْزَنُ الْقَلْبُ ، وَلاَ نَقُولُ إِلاَّ مَا یرضی رَبَّنَا وَإِنَّا بِکَ یَا إبْرَاہِیمَ لَمَحْزُونُونَ۔ (مسلم ۶۲۔ ابوداؤد ۳۱۱۸)","Sahih","Musannaf Ibn Abi Shaybah 12253","","","كتاب الجنائز"
"12254","(۱۲۲۵۴) حدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : رَجَعَ رَسُولُ اللہِ یَوْمَ أُحُدٍ فَسَمِعَ نِسَائَ بَنِی عَبْدِ الأَشْہَلِ یَبْکِینَ عَلَی ہَلْکَاہُنَّ ، فَقَالَ : لَکِنَّ حَمْزَۃَ لاَ بَوَاکِیَ لَہُ فَجِئْنَ نِسَائُ الأَنْصَارِ فَبَکَیْنَ عَلَی حَمْزَۃَ فَرَقَدَ فَاسْتَیْقَظَ ، فَقَالَ : یَا وَیْحَہنَّ إنَّہُنَّ لَہَاہُنَا حَتَّی الآنَ مُرُوہُنَّ فَلْیَرْجِعْنَ ، وَلاَ یَبْکِینَ عَلَی ہَالِکٍ بَعْدَ الْیَوْمِ۔ (احمد ۲/۴۰۔ حاکم ۱۹۴)","Hasan","Musannaf Ibn Abi Shaybah 12254","","","كتاب الجنائز"
"12255","(۱۲۲۵۵) حدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : حدَّثَنِی عَطَائُ بْنُ السَّائِبِ حدَّثَنَا عِکْرِمَۃُ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ یَقُولُ احْفَظُوا ہَذَا الْحَدِیثَ إنَّ إحْدَی بَنَاتِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَتْ فِی الْمَوْتِ قَالَ: فَوَضَعَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی یَدَیْہِ ، وَوَضَعَ رَأْسَہَا عَلَی ثَدْیَیْہِ وَہِیَ تَسُوقُ حَتَّی قضت فَوَضَعَہَا وَہُوَ یَبْکِی ، قَالَ : فَصَاحَتْ أُمُّ أَیْمَنَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ أَرَاک تَبْکِین عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَتْ : أَوَلاَ أَرَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَبْکِی ، قَالَ : إنِّی لَمْ أَبْکِ وَلَکِنَّہَا رَحْمَۃٌ۔ (احمد ۱/۲۷۳)","Da'if","Musannaf Ibn Abi Shaybah 12255","","","كتاب الجنائز"
"12256","(۱۲۲۵۶) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، حدَّثَنِی أَبِی ، عَنْ عَلْقَمَۃَ بْنِ وَقَّاصٍ ، عَنْ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ قَالَتْ : حَضَرَہ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبُو بَکْرٍ ، وَعُمَرُ یَنْعِی سَعْدَ بْنَ مُعَاذٍ فَوَالَّذِی نَفْسُ مُحَمَّدٍ بِیَدِہِ إنِّی لأَعْرِفُ بُکَائَ عُمَرَ مِنْ بُکَائِ أَبِی بَکْرٍ وَإِنِّی لَفِی حُجْرَتِی ، قَالَتْ : فَکَانُوا کَمَا قَالَ اللَّہُ {رُحَمَائُ بَیْنَہُمْ} ، قَالَ عَلْقَمَۃُ : أَیْ أُمَّاہُ کَیْفَ کَانَ یَصْنَعُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کَانَتْ عَیْنُہُ لاَ تَدْمَعُ عَلَی أَحَدٍ وَلَکِنَّہُ کَانَ إذَا وَجَدَ فَإِنَّمَا ہُوَ آخِذٌ بِلِحْیَتِہِ۔(احمد ۶/۱۴۱۔ ابن حبان ۶۴۳۹)","Da'if","Musannaf Ibn Abi Shaybah 12256","","","كتاب الجنائز"
"12257","(۱۲۲۵۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : أَتَیْتُ عُمَرَ بِنَعْیِ النُّعْمَانِ بْنِ مُقَرِّنٍ فَوَضَعَ یَدَہُ عَلَی رَأْسِہِ ، وَجَعَلَ یَبْکِی۔","Da'if","Musannaf Ibn Abi Shaybah 12257","","","كتاب الجنائز"
"12258","(۱۲۲۵۸) حدَّثَنَا شَرِیکٌ ، عَنِ الْہَجَرِیِّ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : إِنْ بَکَتْ بَاکِیَۃٌ ، أَوْ دَمَعَتْ عَیْنٌ فَلاَ بَأْسَ وَلَکِنْ قَدْ نُہِینَا ، عَنِ التَّرَثِّی۔","Da'if","Musannaf Ibn Abi Shaybah 12258","","","كتاب الجنائز"
"12259","(۱۲۲۵۹) حدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عن ابن عون ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ فِی السُّوقِ فَنُعِیَ إلَیْہِ حُجْرٌ فَأَطْلَقَ حَبْوَتَہُ وَقَامَ وغلبہ النَّحِیبُ۔","Sahih","Musannaf Ibn Abi Shaybah 12259","","","كتاب الجنائز"
"12260","(۱۲۲۶۰) حدَّثَنَا وَکِیعٌ ، حدَّثَنَا إسْرَائِیلُ ، عَنْ أبی إِسْحَاقَ ، عَنْ عَامِرِ بْنِ سَعْدٍ الْبَجَلِیِّ ، عَنْ أَبِی مَسْعُودٍ وَثَابِتِ بْنِ یَزِیدٍ وَقَرَظَۃَ بْنِ کَعْبٍ قَالُوا : رُخِّصَ لَنَا فِی الْبُکَائِ عَلَی الْمَیِّتِ فِی غَیْرِ نَوْحٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12260","","","كتاب الجنائز"
"12261","(۱۲۲۶۱) حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، قَالَ دَخَلْت عَلَی أَبِی مَسْعُودٍ وَقَرَظَۃَ بْنِ کَعْبٍ فَقَالاَ : إنَّہُ رُخِّصَ لَنَا فِی الْبُکَائِ عِنْدَ الْمُصِیبَۃِ۔ (حاکم ۱۸۴۔ طبرانی ۸۲)","Hasan","Musannaf Ibn Abi Shaybah 12261","","","كتاب الجنائز"
"12262","(۱۲۲۶۲) حدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَامِرِ بْنِ سَعْدٍ، عَنْ أَبِی مَسْعُودٍ وَثَابِتِ بْنِ یَزَیْدٍ نَحْوَہُ۔ (حاکم ۱۸۴)","Sahih","Musannaf Ibn Abi Shaybah 12262","","","كتاب الجنائز"
"12263","(۱۲۲۶۳) حدَّثَنَا عَفَّانُ ، حدَّثَنَا وُہَیْبٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنْ سَلَمَۃَ بْنِ الأَزْرَقِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مُرَّ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِجِنَازَۃٍ یُبْکَی عَلَیْہَا وَأَنَا مَعَہُ ، وَعُمَرُ بْنُ الْخَطَّابِ فَانْتَہَرَ عُمَرُ اللاَّتِی یَبْکِینَ مَعَ الْجِنَازَۃِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : دَعْہُنَّ یَا ابْنَ الْخَطَّابِ فَإِنَّ النَّفْسَ مُصَابَۃٌ وَالْعَیْنَ دَامِعَۃٌ وَالْعَہْدَ قَرِیبٌ۔ (احمد ۲/۴۰۸۔ عبدالرزاق ۶۶۷۴)","Da'if","Musannaf Ibn Abi Shaybah 12263","","","كتاب الجنائز"
"12264","(۱۲۲۶۴) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 12264","","","كتاب الجنائز"
"12265","(۱۲۲۶۵) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الأَسْوَد بْنِ قَیْسٍ ، عَنْ نُبَیْحٍ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ أَنْ یَرُدوا الْقَتْلَی إلَی مَصَارِعِہِمْ۔ (ابوداؤد ۳۱۵۷۔ ترمذی ۱۷۱۷)","Sahih","Musannaf Ibn Abi Shaybah 12265","","","كتاب الجنائز"
"12266","(۱۲۲۶۶) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ السَّائِبِ ، قَالَ : سَمِعْتُ شَیْخًا فِی بَنِی عَامِرٍ أَحَدِ بَنِی سُوَاء ۃ یُقَالُ لَہُ عَبْدُ اللہِ بْنُ مَعِیَّۃَ ، قَالَ : أُصِیبَ رَجُلاَنِ مِنَ الْمُسْلِمِینَ یَوْمَ الطَّائِفِ ، قَالَ : فَحُمِلاَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَبَلَغَہُ ذَلِکَ فَبَعَثَ أَنْ یُدْفَنَا حَیْثُ أُصِیبَا ، أَوْ لُقِیَا۔","","Musannaf Ibn Abi Shaybah 12266","","","كتاب الجنائز"
"12267","(۱۲۲۶۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورِ بْنِ صَفِیَّۃَ ، عَنْ أُمِّہِ قَالَتْ أَتَیْتُ عَائِشَۃَ أُعَزِّیہَا بِأَخٍ لَہَا مَاتَ فِی مَکَان فَحُمِلَ وَہُوَ مَیِّتٌ فَدُفِنَ فِی مَکَان أُخَرَ ، فَقَالَتْ فِی نَفْسِی مِنْہُ شَیْئٌ إِلاَّ إنِّی وَدِدْت ، أَنَّہُ کَانَ دُفِنَ حَیْثُ مَاتَ۔","Sahih","Musannaf Ibn Abi Shaybah 12267","","","كتاب الجنائز"
"12268","(۱۲۲۶۸) حدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ یَزِیدَ ، عَنِ ابْنِ بُہْمَانَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُدْفَنُ الأَجْسَادُ حَیْثُ تُقْبَضُ الأَرْوَاحُ۔ (ابن سعد ۲۹۳)","Da'if","Musannaf Ibn Abi Shaybah 12268","","","كتاب الجنائز"
"12269","(۱۲۲۶۹) حدَّثَنَا وَکِیعٌ ، حدَّثَنَا الأَسْوَد بْنُ شَیْبَانَ ، عَنْ خَالِدِ بْنِ سُمَیْرٍ ، عَنْ بَشِیرِ بْنِ نَہِیکٍ ، عَنْ بَشِیرِ بْنِ الْخَصَاصِیَۃِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی رَجُلاً یَمْشِی بَیْنَ الْقُبُورِ فِی نَعْلَیْہِ ، فَقَالَ : یَا صَاحِبَ السِّبْتِیَّتَیْنِ أَلْقِہِمَا۔ (نسائی ۲۱۷۵۔ ابوداؤد ۳۲۲۲)","Sahih","Musannaf Ibn Abi Shaybah 12269","","","كتاب الجنائز"
"12270","(۱۲۲۷۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : رَأَیْتُ الْحَسَنَ ، وَابْنَ سِیرِینَ یَمْشِیَانِ بَیْنَ الْقُبُورِ فِی نِعَالِہِمَا۔","","Musannaf Ibn Abi Shaybah 12270","","","كتاب الجنائز"
"12271","(۱۲۲۷۱) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ رَجُلٍ یُقَالُ لَہُ النُّعْمَانُ الْجَنَدِیُّ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَرِہَ أَنْ یُسْتَسْقَی مِنَ الآبَارِ الَّتِی تَکُونُ بَیْنَ ظَہْرَانَیِ الْمَقَابِرِ۔","","Musannaf Ibn Abi Shaybah 12271","","","كتاب الجنائز"
"12272","حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ ، قَالَ :n(۱۲۲۷۲) حدَّثَنَا إسْمَاعِیلُ بْنُ إبْرَاہِیمَ بْنِ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ الْحُصَیْنِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ نَذْرَ فِی مَعْصِیَۃِ اللہِ ، وَلاَ فِیمَا لاَ یَمْلِکُ الْعَبْدُ۔n(ابوداؤد ۳۰۰۔ احمد ۴/۴۳۳)","Sahih","Musannaf Ibn Abi Shaybah 12272","","","كتاب الأيمان والنذور والكفارات"
"12273","(۱۲۲۷۳) عَبْدُ اللہِ بْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ طَلْحَۃَ بْنِ عَبْدِ الْمَلِکِ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ مَنْ نَذَرَ أَنْ یُطِیعَ اللَّہَ فَلْیُطِعْہُ ، وَمَنْ نَذَرَ أَنْ یَعْصِیَ اللَّہَ ، فَلاَ یَعْصِہِ۔ (بخاری ۶۶۹۶۔ ابوداؤد ۳۲۸۲)","Sahih","Musannaf Ibn Abi Shaybah 12273","","","كتاب الأيمان والنذور والكفارات"
"12274","(۱۲۲۷۴) حدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ زَیْدِ بْنِ رُفَیْعٍ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّ النَّذْرَ لاَ یُقَدِّمُ شَیْئًا ، وَلاَ یُؤَخِّرُہُ ، وَلَکِنَّ اللَّہَ یَسْتَخْرِجُ بِہِ مِنَ الْبَخِیلِ ، فَلاَ وَفَائَ بِالنَّذْرِ فِی مَعْصِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 12274","","","كتاب الأيمان والنذور والكفارات"
"12275","(۱۲۲۷۵) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الدَّالاَنِیِّ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : لاَ وَفَائَ لِنَذْرٍ فِی مَعْصِیَۃٍ۔ (عبدالرزاق ۱۵۸۲۳۔ احمد ۲۹۷)","","Musannaf Ibn Abi Shaybah 12275","","","كتاب الأيمان والنذور والكفارات"
"12276","(۱۲۲۷۶) حدَّثَنَا مُحَمَّد بْنُ فُضَیْلٍ ، عَنِ النُّعْمَانِ بْنِ قَیْسٍ ، عَنْ خَالَتِہِ مُلَیْکَۃَ ، عَنْ عَبِیدَۃَ ، قَالَتْ : سَأَلْتُہُ عَنِ النَّذْرِ ، فَقَالَ : مَا کَانَ مِنْ نَذْرٍ ہُوَ فِی شَیْئٍ مِنْ طَاعَۃِ اللہِ فَأَمْضُوہُ ، وَمَا کَانَ مِنْ نَذْرٍ فِی شَیْئٍ مِنْ طَاعَۃِ الشَّیْطَانِ فَلاَ تُجِیزُوہُ۔","","Musannaf Ibn Abi Shaybah 12276","","","كتاب الأيمان والنذور والكفارات"
"12277","(۱۲۲۷۷) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، قَالَ : النَّذْرُ نَذْرَانِ ، فَنَذْرُ اللہِ وَنَذْرُ الشَّیْطَانِ ، فَمَا کَانَ لِلَّہِ فَفِیہِ الْوَفَائُ وَالْکَفَّارَۃُ ، وَمَا کَانَ لِلشَّیْطَانِ فَلاَ وَفَائَ فِی[corrupt]ِ ، وَلاَ کَفَّارَۃَ۔","","Musannaf Ibn Abi Shaybah 12277","","","كتاب الأيمان والنذور والكفارات"
"12278","(۱۲۲۷۸) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٌ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : النَّذْرُ نَذْرَانِ فَمَا کَانَ لِلَّہِ فَفِ بِہِ ، وَمَا کَانَ فِی مَعْصِیَۃٍ ، فَلاَ تَفِ بہ ، وَعَلَیْکَ الْکَفَّارَۃُ۔","","Musannaf Ibn Abi Shaybah 12278","","","كتاب الأيمان والنذور والكفارات"
"12279","(۱۲۲۷۹) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَن عِمَارَۃَ بْنِ الْقَعْقَاعِ، عَنْ إبْرَاہِیمَ، قَالَ: لاَ نَذْرَ فِی مَعْصِیَۃٍ ، کَفِّرْ یَمِینَک۔","","Musannaf Ibn Abi Shaybah 12279","","","كتاب الأيمان والنذور والكفارات"
"12280","(۱۲۲۸۰) حدَّثَنَا أَبُو بَکْرٍ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : جَائَ رَجُلٌ إلَی ابْنِ عَبَّاسٍ ، فَقَالَ : إنِّی نَذَرْت أَنْ أَقُومَ عَلَی قُعَیْقِعَانَ عُرْیَانًا إلَی اللَّیْلِ ، فَقَالَ : أَرَادَ الشَّیْطَانُ أَنْ یُبْدِیَ عَوْرَتَکَ ، وَأَنْ یَضْحَکَ النَّاسَ بِکَ ، الْبَسْ ثِیَابَک وَصَلِّ عِنْدَ الْحِجْرِ رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 12280","","","كتاب الأيمان والنذور والكفارات"
"12281","(۱۲۲۸۱) حدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبَانُ الْعَطَّارُ ، قَالَ : حدَّثَنَا یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ ثَابِتِ بْنِ الضَّحَّاکِ الأَنْصَارِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَیْسَ عَلَی رَجُلٍ نَذْرٌ فِیمَا لاَ یَمْلِکُ۔n(بخاری ۶۰۴۷۔ مسلم ۱۷۴)","Sahih","Musannaf Ibn Abi Shaybah 12281","","","كتاب الأيمان والنذور والكفارات"
"12282","(۱۲۲۸۲) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ ثَابِتٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنْ نَذْرِ الْمَعْصِیَۃِ فِیہِ وَفَائٌ ؟ قَالَ : لاَ۔","Sahih","Musannaf Ibn Abi Shaybah 12282","","","كتاب الأيمان والنذور والكفارات"
"12283","(۱۲۲۸۳) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ قَیْسٍ ، قَالَ : دَخَلَ أَبُو بَکْرٍ عَلَی امْرَأَۃٍ مِنْ أَحْمَسَ مُصْمِتَۃٍ فِی خبائہا ، فَجَعَلَتْ تُشِیرُ إلَیْہِ ، وَلاَ تُکَلِّمُہُ ، فَقَالَ : مَا لَہَا لاَ تَتَکَلَّمُ ؟ فَقَالُوا : أَنَّہَا نَذَرَتْ أَنْ تَحُجَّ مُصْمِتَۃً ، فَقَالَ : تَکَلَّمِی فَإِنَّ ہَذَا لاَ یَحِلُّ لَکَ إنَّمَا ہَذَا مِنْ عَمَلِ الْجَاہِلِیَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 12283","","","كتاب الأيمان والنذور والكفارات"
"12284","(۱۲۲۸۴) شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی الحویرثۃ ، أَوْ عَنِ أبی الْجُوَیْرِیَۃِ ، الشَّکُّ مِنْ أَبِی بَکْرٍ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ بَدْرٍ یَذْکُرُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ نَذْرَ فِی مَعْصِیَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12284","","","كتاب الأيمان والنذور والكفارات"
"12285","(۱۲۲۸۵) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی فَرْوَۃَ یَزِیدَ بْنِ سِنَانٍ ، عَنْ عُرْوَۃَ بْنِ رُوَیْمٍ ، عَنْ أَبِی ثَعْلَبَۃَ الْخُشَنِیِّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ وَفَائَ لِنَذْرٍ فِی مَعْصِیَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 12285","","","كتاب الأيمان والنذور والكفارات"
"12286","(۱۲۲۸۶) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ رضی اللَّہُ عَنْہُما ؛ فِی الرَّجُلِ یَحْلِفُ بِالنَّذْرِ وَالْحَرَامِ ، قَالَ : لَمْ یَأْلُ أَنْ یُغَلِّظَ عَلَی نَفْسِہِ ، یَعْتِقُ رَقَبَۃً ، أَوْ یَصُومُ شَہْرَیْنِ ، أَوْ یُطْعِمُ سِتِّینَ مِسْکِینًا ، قَالَ : فَسَأَلْت إبْرَاہِیمَ وَمُجَاہِدًا ، فَقَالا : إِنْ لَمْ یَجِدْ أَطْعَمَ عَشَرَۃَ مَسَاکِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 12286","","","كتاب الأيمان والنذور والكفارات"
"12287","(۱۲۲۸۷) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ : سَمِعْتُ ابْنَ الزُّبَیْرِ یَقُولُ : أَوْفُوا بِالنُّذُورِ۔","Sahih","Musannaf Ibn Abi Shaybah 12287","","","كتاب الأيمان والنذور والكفارات"
"12288","(۱۲۲۸۸) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ زَیْدِ بْنِ رُفَیْعٍ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : لاَ وَفَائَ لِنَذْرٍ فِی مَعْصِیَۃِ اللہِ ، وَکَفَّارَتُہُ کَفَّارَۃُ یَمِینٍ۔","","Musannaf Ibn Abi Shaybah 12288","","","كتاب الأيمان والنذور والكفارات"
"12289","(۱۲۲۸۹) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ یَزِیدَ الدَّالاَنِیِّ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : کفاریہ کَفَّارَۃُ یَمِینٍ۔","","Musannaf Ibn Abi Shaybah 12289","","","كتاب الأيمان والنذور والكفارات"
"12290","(۱۲۲۹۰) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : سُئِلَ عَنْ رَجُلٍ نَذَرَ أَنْ لاَ یَدْخُلَ عَلَی أُخْتِہِ أَوْ أَخِیہِ ، فَقَالَ : یَدْخُلُ وَیَتَصَدَّقُ عَلَی عَشَرَۃِ مَسَاکِینَ۔","","Musannaf Ibn Abi Shaybah 12290","","","كتاب الأيمان والنذور والكفارات"
"12291","(۱۲۲۹۱) حدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی الْمُعَلِّمِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : النَّذْرُ یَمِینٌ۔","","Musannaf Ibn Abi Shaybah 12291","","","كتاب الأيمان والنذور والكفارات"
"12292","(۱۲۲۹۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : النَّذْرُ یَمِینٌ۔","","Musannaf Ibn Abi Shaybah 12292","","","كتاب الأيمان والنذور والكفارات"
"12293","(۱۲۲۹۳) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إنَّ قَوْمًا یَقُولُونَ : النَّذْرُ یَمِینٌ مُغَلَّظَۃٌ ، إنَّمَا ہِیَ یَمِینٌ یُکَفِّرُہَا۔","","Musannaf Ibn Abi Shaybah 12293","","","كتاب الأيمان والنذور والكفارات"
"12294","(۱۲۲۹۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : النَّذْرُ یَمِینٌ۔","","Musannaf Ibn Abi Shaybah 12294","","","كتاب الأيمان والنذور والكفارات"
"12295","(۱۲۲۹۵) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدٍ الْحَنْظَلِیِّ ، عَنْ أَبِیہِ ، عَنْ عِمْرَانَ بْنِ الْحُصَیْنِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ وَفَائَ لنذر فِی غَضَبٍ ، وَکَفَّارَتُہُ کَفَّارَۃُ یَمِینٍ۔ (طیالسی ۸۳۹)","Da'if","Musannaf Ibn Abi Shaybah 12295","","","كتاب الأيمان والنذور والكفارات"
"12296","(۱۲۲۹۶) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنُ الزبیر الحنظلی ، عَنْ عِمْرَانَ بْنِ الحُصَیْنِ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 12296","","","كتاب الأيمان والنذور والكفارات"
"12297","(۱۲۲۹۷) حدَّثَنَا مُعْتَمِرٌ قُلْتُ لِابْنِ الزُّبَیْرِ: حَدَّثَکَہُ مَنْ سَمِعَہُ مِنْ عِمْرَانَ، قَالَ: لاَ وَلَکِنْ حَدَّثَنِیہِ رَجُلٌ، عَنْ عِمْرَانَ۔","","Musannaf Ibn Abi Shaybah 12297","","","كتاب الأيمان والنذور والكفارات"
"12298","(۱۲۲۹۸) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسعَر ، عَنْ أَبِی حَصِینٍ ، عَنْ عَبْدِ اللہِ بْنِ معقل ، قَالَ : النَّذْرُ الْیَمِینُ الْغَلْظَائُ۔","","Musannaf Ibn Abi Shaybah 12298","","","كتاب الأيمان والنذور والكفارات"
"12299","(۱۲۲۹۹) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ عن سَوَّارٍ ، عَنِ الْحَسَنِ ، قَالَ : کَفَّارَۃُ النَّذْرِ إذَا کَانَ فِی مَعْصِیَۃٍ ، إطْعَامُ عَشَرَۃِ مَسَاکِینَ۔","","Musannaf Ibn Abi Shaybah 12299","","","كتاب الأيمان والنذور والكفارات"
"12300","(۱۲۳۰۰) عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، عَنْ طَلْحَۃَ الْیَامِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ حَلَفَ بِنَذْرٍ عَلَی یَمِینٍ فَحَنِثَ ، فَعَلَیْہِ کَفَّارَۃُ یَمِینٍ مُغَلَّظَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 12300","","","كتاب الأيمان والنذور والكفارات"
"12301","(۱۲۳۰۱) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا قَالَ الرَّجُلُ : عَلَیَّ نَذْرٌ : فَلَمْ یَمْضِ بِالْیَمِینِ فَسَکَتَ ، فَعَلَیْہِ نَذْرٌ۔","","Musannaf Ibn Abi Shaybah 12301","","","كتاب الأيمان والنذور والكفارات"
"12302","(۱۲۳۰۲) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : النَّذْرُ شَیْئٌ یُسْتَخْرَجُ بِہِ مِنَ الْبَخِیلِ۔","","Musannaf Ibn Abi Shaybah 12302","","","كتاب الأيمان والنذور والكفارات"
"12303","(۱۲۳۰۳) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : النَّذْرُ یَمِینٌ مُغَلَّظَۃٌ۔","","Musannaf Ibn Abi Shaybah 12303","","","كتاب الأيمان والنذور والكفارات"
"12304","(۱۲۳۰۴) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : النَّذْرُ إذَا لَمْ یُسَمَّ أَغْلَظُ الْیَمِینِ ، وَعَلَیْہِ أَغْلَظُ الْکَفَّارَات۔","Sahih","Musannaf Ibn Abi Shaybah 12304","","","كتاب الأيمان والنذور والكفارات"
"12305","(۱۲۳۰۵) حدَّثَنَا ابْنِ فُضَیْلٍ ، عَنْ لَیث ، عَنِ الْحَکَمِ ، عَنِ ابْنِ معقل ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، قَالَ : مَنْ جَعَلَ لِلَّہِ عَلَیْہِ نَذْرًا لَمْ یُسَمِّ ، فَعَلَیْہِ نَسَمَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 12305","","","كتاب الأيمان والنذور والكفارات"
"12306","(۱۲۳۰۶) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا قَالَ : عَلَیَّ نَذْرٌ ، وَلَمْ یُسَمِّہِ ، فَعَلَیْہِ کَفَّارَۃُ التی تلیہ ثم التی تلیہ ثم التی تلیہ۔","Sahih","Musannaf Ibn Abi Shaybah 12306","","","كتاب الأيمان والنذور والكفارات"
"12307","(۱۲۳۰۷) حدَّثَنَا أَبُو بَکْرٍ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَفَّارَۃُ النَّذْرِ غَیْرُ الْمُسَمَّی ، کَفَّارَۃُ الْیَمِینِ۔","","Musannaf Ibn Abi Shaybah 12307","","","كتاب الأيمان والنذور والكفارات"
"12308","(۱۲۳۰۸) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ: إذَا قَالَ: عَلَیَّ نَذْرٌ فَعَلَیْہِ نَذْرٌ","","Musannaf Ibn Abi Shaybah 12308","","","كتاب الأيمان والنذور والكفارات"
"12309","(۱۲۳۰۹) قَالَ جَابِرُ بْنُ زَیْدٍ : إذَا قَالَ : عَلَیَّ نَذْرٌ ، فَإِنْ سَمَّی فَہُوَ مَا سَمَّی وَإِنْ نَوَی فہو مَا نَوَی ، فَإِنْ لَمْ یَکُنْ سَمَّی شَیْئًا صَامَ یَوْمًا ، أَوْ صَلَّی رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 12309","","","كتاب الأيمان والنذور والكفارات"
"12310","(۱۲۳۱۰) حدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِذَا قَالَ عَلَیَّ نَذْرٌ ، وَلَمْ یُسَمِّ ، فَہِیَ یَمِینٌ مُغَلَّظَۃٌ ، یُحَرِّرُ رَقَبَۃً ، أَوْ یَصُومُ شَہْرَیْنِ ، أَوْ یُطْعِمُ سِتِّینَ مِسْکِینًا ، قَالَ : وَقَالَ الْحَسَنُ : ہِیَ یَمِینٌ یُکَفِّرُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 12310","","","كتاب الأيمان والنذور والكفارات"
"12311","(۱۲۳۱۱) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ رَافِعٍ ، عَنْ خَالِدِ بْنِ یَزِیدَ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ رضی اللَّہُ عَنْہُ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ نَذَرَ نَذْرًا فَلَمْ یُسَمِّہِ ، فَعَلَیْہِ کَفَّارَۃُ یَمِینٍ۔n(مسلم ۱۳۔ ابوداؤد ۳۳۱۶)","Da'if","Musannaf Ibn Abi Shaybah 12311","","","كتاب الأيمان والنذور والكفارات"
"12312","(۱۲۳۱۲) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، قَالَ : سَأَلْتُہمَا عَنْ رَجُلٍ جَعَلَ عَلَیْہِ نَذْرًا لَمْ یُسَمِّہِ ، قَالاَ: عَلَیْہِ الْکَفَّارَۃُ۔","","Musannaf Ibn Abi Shaybah 12312","","","كتاب الأيمان والنذور والكفارات"
"12313","(۱۲۳۱۳) وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدِ بْنِ أَبِی ہِنْدٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ رضی اللَّہُ عَنْہُما ، قَالَ : النُّذُورُ أَرْبَعَۃٌ : مَنْ نَذَرَ نَذْرًا لَمْ یُسَمِّہِ فَکَفَّارَتُہُ کَفَّارَۃُ یَمِینٍ ، وَمَنْ نَذَرَ فِی مَعْصِیَۃٍ ، فَکَفَّارَتُہُ کَفَّارَۃُ یَمِینٍ ، وَمَنْ نَذَرَ نَذْرًا فِیمَا لاَ یُطِیقُ ، فَکَفَّارَتُہُ کَفَّارَۃُ یَمِینٍ ، وَمَنْ نَذَرَ نَذْرًا فِیمَا یُطِیقُ ، فَلْیُوفِ بِنَذْرِہِ۔ (ابوداؤد ۳۳۱۵۔ دارقطنی ۲)","Hasan","Musannaf Ibn Abi Shaybah 12313","","","كتاب الأيمان والنذور والكفارات"
"12314","(۱۲۳۱۴) حدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ خُصَیْفٍ ، عَنْ عِکْرِمَۃَ فِی النَّذْرِ لاَ یُسَمِّی کَفَّارَۃً ، قَالَ : یَمِینٌ مُغَلَّظَۃٌ۔","","Musannaf Ibn Abi Shaybah 12314","","","كتاب الأيمان والنذور والكفارات"
"12315","(۱۲۳۱۵) حدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنِ ابْنِ عَوْنٍ ، عَنْ زِیَادِ بْنِ جُبَیْرٍ ، قَالَ : جَائَ رَجُلٌ إلَی ابْنِ عُمَرَ ، فَسَأَلَہُ ، عَنْ رَجُلٍ نَذَرَ أَنْ یَصُومَ یَوْمًا فَوَافَقَ یَوْمَ فِطْرٍ ، أَوْ أَضْحَی ، فَقَالَ ابْنُ عُمَرَ : أَمَرَ اللَّہُ وَفَائَ النَّذْرِ ، وَنَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ صَوْمِ ہَذَا الْیَوْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 12315","","","كتاب الأيمان والنذور والكفارات"
"12316","(۱۲۳۱۶) حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ نَذَرَ أَنْ یَصُومَ یوم الاِثْنَیْنِ وَالْخَمِیسَ ، فَأَتَی عَلَی ذَلِکَ یَوْمُ فِطْرٍ ، أَوْ أَضْحَی ، قَالَ : یُفْطِرُ وَیَصُومُ یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 12316","","","كتاب الأيمان والنذور والكفارات"
"12317","(۱۲۳۱۷) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ ِإِبْرَاہِیمَ قَالَ : یَصُومُ یَوْمًا مَکَانَہُ ، وَیُکَفِّرُ یَمِینَہُ۔","","Musannaf Ibn Abi Shaybah 12317","","","كتاب الأيمان والنذور والكفارات"
"12318","(۱۲۳۱۸) حدَّثَنَا عُقْبَۃُ بْنُ خَالِدٍ السَّکُونِیُّ ، عَنْ شُعْبَۃَ ، عَنْ خَالَتِہِ ، أَنَّہَا جَعَلَتْ عَلَیْہَا أَنْ تصُومَ کُلَّ جُمُعَۃٍ فَوَافَقَ ذَلِکَ الْیَوْمُ یَوْمَ فِطْرٍ ، أَوْ أَضْحَی ، فَسَأَلَتْ جَابِرَ بْنَ زَیْدٍ ، فَقَالَ : أَطْعِمِی مِسْکِینًا۔","","Musannaf Ibn Abi Shaybah 12318","","","كتاب الأيمان والنذور والكفارات"
"12319","(۱۲۳۱۹) حدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنِ امْرَأَۃٍ نَذَرَتْ أَنْ تَصُومَ کُلَّ جُمُعَۃٍ فَوَافَقَ ذَلِکَ الْیَوْمُ یَوْمَ فِطْرٍ ، أَوْ أَضْحَی ، فَقَالاَ : تَقْضِی یَوْمًا مَکَانَہُ وَتُکَفِّرُہُ۔","","Musannaf Ibn Abi Shaybah 12319","","","كتاب الأيمان والنذور والكفارات"
"12320","(۱۲۳۲۰) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ سُلَیْمَانَ بْنِ أَبِی دَاوُد ، قَالَ : سُئِلَ عَطَائُ بْنُ أَبِی رَبَاحٍ ، عَنْ رَجُلٍ جَعَلَ عَلَیْہِ صِیَامَ شَہْرَیْنِ مُتَتَابِعَیْنِ ، فَیُدْرِکُہُ أَضْحَی ، أَوْ فِطْرٌ ، فَقَالَ : یُفْطِرُ ، ثُمَّ یَبْنِی عَلَی صِیَامِہِ۔","","Musannaf Ibn Abi Shaybah 12320","","","كتاب الأيمان والنذور والكفارات"
"12321","(۱۲۳۲۱) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ ، قَالَ : کَفَّارَۃُ الْیَمِینِ إطْعَامُ عَشَرَۃِ مَسَاکِینَ ، کُلُّ مِسْکِینٍ نِصْفُ صَاعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 12321","","","كتاب الأيمان والنذور والكفارات"
"12322","(۱۲۳۲۲) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ وَأَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ عَنْ حَوْطٍ عَمَّنْ حَدَّثَہُ عَنْ عَائِشَۃَ قَالَتْ : إنَّا نُطْعِمُ نِصْفَ صَاعٍ مِنْ بُرٍّ ، أَوْ صَاعًا مِنْ تَمْرٍ فِی کَفَّارَۃِ الْیَمِینِ۔","Da'if","Musannaf Ibn Abi Shaybah 12322","","","كتاب الأيمان والنذور والكفارات"
"12323","(۱۲۳۲۳) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ یَسَارِ بْنِ نُمَیْرٍ ، قَالَ : قَالَ لِی عُمَرُ : إنِّی أَحْلِفُ أَلاَّ أُعْطِی أَقْوَامًا شَیْئًا ، ثُمَّ یَبْدُو لِی فَأُعْطِیہِمْ ، فَإِذَا فَعَلْتُ ذَلِکَ فَأَطْعِمْ عَنِّی عَشَرَۃَ مَسَاکِینَ ، بَیْنَ کُلِّ مِسْکِینَیْنِ صَاعٌ مِنْ بُرٍّ ، أَوْ صَاعٌ مِنْ تَمْرٍ لِکُلِّ مِسْکِینٍ۔","Hasan","Musannaf Ibn Abi Shaybah 12323","","","كتاب الأيمان والنذور والكفارات"
"12324","(۱۲۳۲۴) حدَّثَنَا عبد الرحیم بن سلیمان عَنْ سَعِیدِ ، عَنْ قَتَادَۃَ ، عن ابْنِ الْمُسَیَّبِ فِی کَفَّارَۃِ الْیَمِینِ ، قَالَ : مُدَّانِ لِکُلِّ مِسْکِینٍ۔","","Musannaf Ibn Abi Shaybah 12324","","","كتاب الأيمان والنذور والكفارات"
"12325","(۱۲۳۲۵) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَفَّارَۃُ الْیَمِینِ وَالظِّہَارِ نِصْفُ صَاعٍ لِکُلِّ مِسْکِینٍ۔","","Musannaf Ibn Abi Shaybah 12325","","","كتاب الأيمان والنذور والكفارات"
"12326","(۱۲۳۲۶) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کل کَفَّارَۃ فِی ظِہَارٍ ، أَوْ غَیْرِہِ ، فَفِیہِ نِصْفُ صَاعٍ مِنْ بُرٍّ کَفَّارَتُہُ۔","","Musannaf Ibn Abi Shaybah 12326","","","كتاب الأيمان والنذور والكفارات"
"12327","(۱۲۳۲۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَوْفٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَفَّارَۃُ الْیَمِینِ : مدان ، أَوْ أَکْلَۃٌ مَأْدُومَۃٌ۔","","Musannaf Ibn Abi Shaybah 12327","","","كتاب الأيمان والنذور والكفارات"
"12328","(۱۲۳۲۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قُلْتُ : أَجْمَعُہُمْ ؟ قَالَ : لاَ ، أَعْطِہِمْ مُدًّین مُدًّا لِطَعَامِہِمْ وَمُدًّا لإِدَامِہِمْ۔","","Musannaf Ibn Abi Shaybah 12328","","","كتاب الأيمان والنذور والكفارات"
"12329","(۱۲۳۲۹) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، أَنَّہُ قَالَ فِی إطْعَامِ الْمَسَاکِینِ فِی کَفَّارَۃِ الظِّہَارِ قَالَ : لِکُلِّ مِسْکِینٍ مُدُّ حِنْطَۃٍ وَمُدُّ تَمْرٍ۔","","Musannaf Ibn Abi Shaybah 12329","","","كتاب الأيمان والنذور والكفارات"
"12330","(۱۲۳۳۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لِکُلِّ مِسْکِینٍ مُدًّا مِنْ حِنْطَۃٍ۔","","Musannaf Ibn Abi Shaybah 12330","","","كتاب الأيمان والنذور والكفارات"
"12331","(۱۲۳۳۱) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سَأَلْتُ جَابِرَ بْنَ زَیْدٍ عَنْ کَفَّارَۃِ الْیَمِینِ ، قَالَ : إطْعَامُ عَشَرَۃِ مَسَاکِینَ ، مَکُّوکٌ مَکُّوکٌ لِکُلِّ إنْسَانٍ۔","","Musannaf Ibn Abi Shaybah 12331","","","كتاب الأيمان والنذور والكفارات"
"12332","(۱۲۳۳۲) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ فِی کَفَّارَۃِ الْیَمِینِ : مَکُّوکٌ طَعَامُہُ وَمَکُّوکٌ إدَامُہُ۔","","Musannaf Ibn Abi Shaybah 12332","","","كتاب الأيمان والنذور والكفارات"
"12333","(۱۲۳۳۳) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَلْحَۃَ ، عَنْ یَسَارِ بْنِ نُمَیْرٍ ، قَالَ: قَالَ: إنِّی أَلِی مِنْ أَمْرِ الْمُسْلِمِینَ، فَإِذَا رَأَیْتَنِی قَدْ حَلَفْتُ عَلَی یَمِینٍ لَمْ أُمْضِہَا ، فَأَطْعِمْ عَنِّی عَشَرَۃَ مَسَاکِینَ لِکُلِّ مِسْکِینٍ نِصْفُ صَاعٍ مِنْ بُرٍّ ، أَوْ صَاعٌ مِنْ شَعِیرٍ ، أَوْ صَاعٌ مِنْ تَمْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 12333","","","كتاب الأيمان والنذور والكفارات"
"12334","(۱۲۳۳۴) حدَّثَنَا ابْنُ فُضَیْلٍ، وَابْنُ إدْرِیسَ، عَنْ دَاوُدَ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ فِی کَفَّارَۃِ الْیَمِینِ: مُدٌّ رَیْعُہُ إدَامُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 12334","","","كتاب الأيمان والنذور والكفارات"
"12335","(۱۲۳۳۵) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : مُدٌّ مِنْ حِنْطَۃٍ لِکُلِّ مِسْکِینٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12335","","","كتاب الأيمان والنذور والكفارات"
"12336","(۱۲۳۳۶) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا حَنِثَ أَطْعَمَ عَشَرَۃَ مَسَاکِینَ ، لِکُلِّ مِسْکِینٍ مُدٌّ مِنْ حِنْطَۃٍ بِالْمُدِّ الأَوَّلِ۔","Sahih","Musannaf Ibn Abi Shaybah 12336","","","كتاب الأيمان والنذور والكفارات"
"12337","(۱۲۳۳۷) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : مُدٌّ۔","","Musannaf Ibn Abi Shaybah 12337","","","كتاب الأيمان والنذور والكفارات"
"12338","(۱۲۳۳۸) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ وَیزِیْدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، قَالَ فِی کَفَّارَۃِ الْیَمِینِ مُدٌّ مِنْ بُرٍّ۔","","Musannaf Ibn Abi Shaybah 12338","","","كتاب الأيمان والنذور والكفارات"
"12339","(۱۲۳۳۹) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ وَسَالِمٍ فِی کَفَّارَۃِ الْیَمِینِ ، قَالاَ : مُدٌّ لِکُلِّ مِسْکِینٍ۔","","Musannaf Ibn Abi Shaybah 12339","","","كتاب الأيمان والنذور والكفارات"
"12340","(۱۲۳۴۰) حدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو، عَنْ أَبِی سَلَمَۃَ فِی إطْعَامِ الْمِسَاکِینِ: مُدٌّ مِنْ قَمْحٍ۔","","Musannaf Ibn Abi Shaybah 12340","","","كتاب الأيمان والنذور والكفارات"
"12341","(۱۲۳۴۱) حدَّثَنَا حدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ عَطَائٍ ، قَالَ : مُدٌّ۔","","Musannaf Ibn Abi Shaybah 12341","","","كتاب الأيمان والنذور والكفارات"
"12342","(۱۲۳۴۲) حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : وَجْبَۃٌ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 12342","","","كتاب الأيمان والنذور والكفارات"
"12343","(۱۲۳۴۳) حدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ قَالَ فِی کَفَّارَۃِ الْمَسَاکِینِ : یَجْمَعُہُمْ مَرَّۃً فَیُشْبِعُہُمْ۔","","Musannaf Ibn Abi Shaybah 12343","","","كتاب الأيمان والنذور والكفارات"
"12344","(۱۲۳۴۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدِ بْنِ یَزِیدَ أبی مَسْلَمَۃَ ، قَالَ : سَأَلْتُ جَابِرَ بْنَ زَیْدٍ ، عَنْ إطْعَامِ الْمِسْکِینِ فِی کَفَّارَۃِ الْیَمِینِ ، فَقَالَ : أَکْلَۃٌ ، قُلْتُ : إنَّ الْحَسَنَ یَقُولُ : مَکُّوکٌ ، فَقُلْت : مَا تَرَی فِی مَکُّوکِ بُرٍ ؟ فَقَالَ : إنَّ مَکُّوکَ بُرٍّ لاَ یُجْزِئُ۔","","Musannaf Ibn Abi Shaybah 12344","","","كتاب الأيمان والنذور والكفارات"
"12345","(۱۲۳۴۵) حدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ فِی کَفَّارَۃِ الْیَمِینِ : یُطْعِمُ عَشَرَۃَ مَسَاکِینَ کَمَا قَالَ اللَّہُ تَعَالَی حَتَّی یُشْبِعَہُمْ۔","","Musannaf Ibn Abi Shaybah 12345","","","كتاب الأيمان والنذور والكفارات"
"12346","(۱۲۳۴۶) حدَّثَنَا یَحْیَی بْنُ إِسْحَاقَ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ أَیُّوبَ ، عَنْ حمید ؛ أَنَّ أَنَسًا مَرِضَ قَبْلَ أَنْ یَمُوتَ ، فَلَمْ یَسْتَطِعْ أَنْ یَصُومَ ، فَکَانَ یَجْمَعُ ثَلاَثِینَ مِسْکِینًا ، فَیُطْعِمُہُمْ خُبْزًا وَلَحْمًا أَکْلَۃً وَاحِدَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 12346","","","كتاب الأيمان والنذور والكفارات"
"12347","(۱۲۳۴۷) حدَّثَنَا مُعْتَمِرٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی کَفَّارَۃِ الْیَمِینِ ، فَقَالَ : یُطْعِمُ خُبْزًا وَلَحْمًا مَرَّۃً وَاحِدَۃً حَتَّی یُشْبِعَہُم۔","","Musannaf Ibn Abi Shaybah 12347","","","كتاب الأيمان والنذور والكفارات"
"12348","(۱۲۳۴۸) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : یُغَدِّیہِمْ وَیُعَشِّیہِمْ۔","","Musannaf Ibn Abi Shaybah 12348","","","كتاب الأيمان والنذور والكفارات"
"12349","(۱۲۳۴۹) حدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ ، عَنِ الشَّعْبِیِّ ، قَالَ : غَدَائٌ وَعَشَائٌ۔","","Musannaf Ibn Abi Shaybah 12349","","","كتاب الأيمان والنذور والكفارات"
"12350","(۱۲۳۵۰) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لِامْرَأَۃٍ أَنْتِ عَلَیَّ کَظَہْرِ امْرَأَۃِ فُلاَنٍ ، فَلَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 12350","","","كتاب الأيمان والنذور والكفارات"
"12351","(۱۲۳۵۱) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حبیب ، عَنْ عَمْرِو بْنِ ہرْمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنْ رَجُلٍ ، قَالَ : لِامْرَأَتِہِ : أَنْتِ عَلَیَّ کَبَطْنِ أُمِّی ، قَالَ : الْبَطْنُ وَالظَّہْرُ بِمَنْزِلَۃٍ وَاحِدَۃٍ فِی الظِّہار۔","","Musannaf Ibn Abi Shaybah 12351","","","كتاب الأيمان والنذور والكفارات"
"12352","(۱۲۳۵۲) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُہ ، عَنِ امْرَأَۃٍ ثَقِیلَۃِ الرَّأْسِ نَامَتْ وَمَعَہَا ابْنُہَا فَأَصْبَحَ مَیِّتًا ، قَالَ : أَطْیَبُ لِنَفْسِہَا أَنْ تُکَفِّرَ بِعِتْقِ رَقَبَۃٍ ، أَوْ تَصُومَ شَہْرَیْنِ مُتَتَابِعَیْنِ قُلْتُ : فَإِنْ حَاضَتْ قَالَ : ذَلِکَ مَا لاَ بُدَّ لِلنِّسَائِ مِنْہُ تَقْضِی أَیَّامَ حَیْضِہَا إذَا فَرَغَتْ۔","","Musannaf Ibn Abi Shaybah 12352","","","كتاب الأيمان والنذور والكفارات"
"12353","(۱۲۳۵۳) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَتَلَتِ الْمَرْأَۃُ نَفْسًا خَطَأً فَصَامَتْ ، ثُمَّ حَاضَتْ قَضَتْ یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 12353","","","كتاب الأيمان والنذور والكفارات"
"12354","(۱۲۳۵۴) حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِی ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی أَیُّوبَ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ أَبِی حَبِیبٍ ، عَنِ ابْنِ شِہَابٍ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : أَمَّا الْمَرْأَۃُ فَتَصُومُ ، فَإِذَا حَاضَتْ تُتِمُّ مَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 12354","","","كتاب الأيمان والنذور والكفارات"
"12355","(۱۲۳۵۵) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی امْرَأَۃٍ جَعَلَتْ عَلَیْہَا أَنْ تَعْتَکِفَ فَأَدْرَکَہَا الْحَیْضُ ، قَال : تَقْضِی مَا حَاضَتْ مِنْ عِدَّۃِ أَیَّامٍ أُخَر۔","","Musannaf Ibn Abi Shaybah 12355","","","كتاب الأيمان والنذور والكفارات"
"12356","(۱۲۳۵۶) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا صَامَتِ الْمَرْأَۃُ فِی کَفَّارَۃِ الْیَمِینِ ثَلاَثَۃَ أَیَّامٍ ، فَحَاضَتْ قَبْلَ أَنْ تُتِمَّ صَوْمَہَا فَلْتَسْتَقْبِلْ صَوْمَ ثَلاَثَۃِ أَیَّامٍ۔","","Musannaf Ibn Abi Shaybah 12356","","","كتاب الأيمان والنذور والكفارات"
"12357","(۱۲۳۵۷) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ حَلَفَ بِسُورَۃٍ مِنَ الْقُرْآنِ فَعَلَیْہِ بِکُلِّ آیَۃٍ مِنْہَا یَمِینُ صَبْرٍ ، فَمَنْ شَائَ بَرَّ وَمَنْ شَائَ فَجَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 12357","","","كتاب الأيمان والنذور والكفارات"
"12358","(۱۲۳۵۸) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ ، عَنْ أَبِی کَنَفٍ ، قَالَ : کُنْتُ أَمْشِی مَعَ عَبْدِ اللہِ فِی سُوقِ الرقِق فَسَمِعَ رَجُلاً یَحْلِفُ : کَلاَّ وَسُورَۃِ الْبَقَرَۃِ ، فَقَالَ عَبْدُ اللہِ : أَمَا إنَّ عَلَیْہِ بِکُلِّ آیَۃٍ مِنْہَا یَمِین۔","Da'if","Musannaf Ibn Abi Shaybah 12358","","","كتاب الأيمان والنذور والكفارات"
"12359","(۱۲۳۵۹۸) حدَّثَنَا ابْنُ فُضَیْلٍ ، وَوَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، عَنْ عَبْدِ اللہِ بْنِ حَنظَلَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : مَنْ حَلَفَ بِسُورَۃٍ مِنَ الْقُرْآنِ فَعَلَیْہِ بِکُلِّ آیَۃٍ مِنْہَا یَمِین۔","Sahih","Musannaf Ibn Abi Shaybah 12359","","","كتاب الأيمان والنذور والكفارات"
"12360","(۱۲۳۶۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ سَہل بْنِ مِنْجَابٍ قَالَ : مَنْ حَلَفَ بِسُورَۃٍ مِنَ الْقُرْآنِ لَقِیَ اللَّہَ بِعَدَدِ آیِہَا خَطَایَا۔","","Musannaf Ibn Abi Shaybah 12360","","","كتاب الأيمان والنذور والكفارات"
"12361","(۱۲۳۶۱) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مَنْ حَلَفَ بِسُورَۃٍ مِنَ الْقُرْآنِ فَعَلَیْہِ بِکُلِّ آیَۃٍ مِنْہَا یَمِینٌ ، وَمَنْ کَفَرَ بِآیَۃٍ مِنْہُ کَفَرَ بِہِ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 12361","","","كتاب الأيمان والنذور والكفارات"
"12362","(۱۲۳۶۲) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ حَلَفَ بِالْقُرْآنِ فَعَلَیْہِ بِکُلِّ آیَۃٍ یَمِینٌ۔","","Musannaf Ibn Abi Shaybah 12362","","","كتاب الأيمان والنذور والكفارات"
"12363","(۱۲۳۶۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ : مَنْ کَانَتْ عَلَیْہِ رَقَبَۃٌ ، فَاشْتَرَی نَسَمَۃً ، قَالَ : إذَا أَنْفَذَہَا مِنْ عَمَلٍ إلَی عَمَلٍ أَجْزَأَہُ ، وَلاَ یُجْزِئہ مَنْ لاَ یَعْمَلُ فَأَمَّا الَّذِی یَعْمَلُ فَالأَعْوَرُ وَنَحْوُہُ ، وَأَمَّا الَّذِی لاَ یَعْمَلُ فَالأَعْمَی وَالْمُقْعَدُ۔","","Musannaf Ibn Abi Shaybah 12363","","","كتاب الأيمان والنذور والكفارات"
"12364","(۱۲۳۶۴) حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَکْرَہُ الأَعْرَجَ وَالْمُخَبَّلَ فِی الرَّقَبَۃِ الْوَاجِبَۃِ۔","","Musannaf Ibn Abi Shaybah 12364","","","كتاب الأيمان والنذور والكفارات"
"12365","(۱۲۳۶۵) حدَّثَنَا مُحَمَّدُ بْنُ مَرْوَانَ ، عَنْ عُمَارَۃَ ، عَنْ عِکْرِمَۃَ ، قَالَ : سَأَلَہُ رَجُلٌ أَیُجْزِئُ فِی عِتْقِ الرَّقَبَۃِ الْوَاجِبَۃِ الأَعْوَرُ ؟ فَقَالَ : رُبَّ أَعْوَرَ ثُمَّ ثم دَارَ فَقَالَ : یُجْزِئُ الأَعْرَجَ قَالَ : فَقَالَ : السَّاعَۃ تجیء بِالْمُقْعَدِ۔","","Musannaf Ibn Abi Shaybah 12365","","","كتاب الأيمان والنذور والكفارات"
"12366","(۱۲۳۶۶) حدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُجْزِئُ الأَعْوَرُ۔","","Musannaf Ibn Abi Shaybah 12366","","","كتاب الأيمان والنذور والكفارات"
"12367","(۱۲۳۶۷) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : الْمَجْنُونُ لاَ یُجْزِئُ فِی الَّذِی عَلَیْہِ الرَّقَبَۃُ۔","","Musannaf Ibn Abi Shaybah 12367","","","كتاب الأيمان والنذور والكفارات"
"12368","(۱۲۳۶۸) حدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَیَجُوزُ فِی قَتْلِ النَّفْسِ رَقَبَۃٌ مُؤْمِنَۃٌ غَیْرُ سَوِیَّۃٍ وَہُوَ یَنْتَفِعُ بِہَا أَعْرَجُ ، أَوْ أَشَلُّ ؟ فَأَبَی وَاسْتَحَبَّ السَّوِیَّۃَ۔","","Musannaf Ibn Abi Shaybah 12368","","","كتاب الأيمان والنذور والكفارات"
"12369","(۱۲۳۶۹) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُجْزِئُ الأَعْمَی فِی الْکَفَّارَۃِ۔","","Musannaf Ibn Abi Shaybah 12369","","","كتاب الأيمان والنذور والكفارات"
"12370","(۱۲۳۷۰) حدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : سَأَلْتُہ عَنِ الأَعْمَی وَالْمُقْعَدِ ، فَقَالَ : لاَ یُجْزِئُ۔","","Musannaf Ibn Abi Shaybah 12370","","","كتاب الأيمان والنذور والكفارات"
"12371","(۱۲۳۷۱) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ أَنَّہُمَا قَالاَ : لاَ یُجْزِئُ فِی شَیْئٍ مِنَ الْوَاجِبِ وَلَدُ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 12371","","","كتاب الأيمان والنذور والكفارات"
"12372","(۱۲۳۷۲) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : تُوُفِّیَ رَجُلٌ مِنْ أَہْلِی فَأَوْصَی بِنَسَمَۃٍ ، فَوَجَدْت نَسَمَۃً قَدْ تَزَوَّجَ أَبُوہُ أُمَّہُ بِغَیْرِ إذْنِ مَوْلاَہُ ، فَسَأَلْت عَطَائً ، فَقَالَ : أَکْرَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 12372","","","كتاب الأيمان والنذور والكفارات"
"12373","(۱۲۳۷۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ فُلانِ بن عَمْرٍو قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ ، عَنْ عِتْقِ وَلَدِ الزِّنَا فِی کَفَّارَۃِ الْیَمِینِ ، فَقَالَ: یُجْزِئُ۔","","Musannaf Ibn Abi Shaybah 12373","","","كتاب الأيمان والنذور والكفارات"
"12374","(۱۲۳۷۴) حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، أَنَّہُ کَانَ یَقُولُ : یُجْزِئُ فِی الْوَاجِبِ ، وَلاَ یَفْضُلُہُ الَّذِی لرِشدۃٍ إلاَّ بِتَقْوًی۔","Sahih","Musannaf Ibn Abi Shaybah 12374","","","كتاب الأيمان والنذور والكفارات"
"12375","(۱۲۳۷۵) حدَّثَنَا وَکِیعٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ طَاوُوسٍ ، قَالَ : یُجْزِئُ وَلَدُ الزِّنَا فِی الرَّقَبَۃِ۔","","Musannaf Ibn Abi Shaybah 12375","","","كتاب الأيمان والنذور والكفارات"
"12376","(۱۲۳۷۶) حدَّثَنَا أَبُو بَکْرٍ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُجْزِئُ مِنَ الرَّقَبَۃِ الْوَاجِبَۃِ۔","","Musannaf Ibn Abi Shaybah 12376","","","كتاب الأيمان والنذور والكفارات"
"12377","(۱۲۳۷۷) حدَّثَنَا حَفْصٌ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، وَعَبْدُ اللہِ بْنُ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ : أَتَتِ امْرَأَۃٌ أَبَا ہُرَیْرَۃَ ، فَسَأَلَتْہُ عَنِ ابْنِ جَارِیَۃٍ لَہَا مِنْ غَیْرِ رِشْدَۃٍ وَعَلَیْہَا رَقَبَۃٌ ، أَیُجْزِئُہَا ؟ قَالَ : نَعَمْ۔","Da'if","Musannaf Ibn Abi Shaybah 12377","","","كتاب الأيمان والنذور والكفارات"
"12378","(۱۲۳۷۸) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی عِتْقَ الْکَافِرِ فِی شَیْئٍ مِنَ الْکَفَّارَاتِ۔","","Musannaf Ibn Abi Shaybah 12378","","","كتاب الأيمان والنذور والكفارات"
"12379","(۱۲۳۷۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ طَاوُوسٍ ، قَالَ : یُجْزِئُ الْیَہُودِیُّ وَالنَّصْرَانِیُّ فِی کَفَّارَۃِ الْیَمِینِ۔","","Musannaf Ibn Abi Shaybah 12379","","","كتاب الأيمان والنذور والكفارات"
"12380","(۱۲۳۸۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُجْزِئُ عِتْقُ أَہْلِ الْکُفْرِ۔","","Musannaf Ibn Abi Shaybah 12380","","","كتاب الأيمان والنذور والكفارات"
"12381","(۱۲۳۸۱) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُجْزِئُ الْیَہُودِیُّ وَالنَّصْرَانِیُّ فِی الرَّقَبَۃِ الْوَاجِبَۃِ۔","","Musannaf Ibn Abi Shaybah 12381","","","كتاب الأيمان والنذور والكفارات"
"12382","(۱۲۳۸۲) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَرَی عِتْقَ الْمُدَبَّرِ فِی الْکَفَّارَاتِ کُلِّہا۔","","Musannaf Ibn Abi Shaybah 12382","","","كتاب الأيمان والنذور والكفارات"
"12383","(۱۲۳۸۳) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوس : قَالَ : یُجْزِئُ عِتْقُ الْمُدَبَّرِ فِی الْکَفَّارَۃِ۔","","Musannaf Ibn Abi Shaybah 12383","","","كتاب الأيمان والنذور والكفارات"
"12384","(۱۲۳۸۴) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : تُجْزِئُ الْمُدَبَّرَۃ۔","","Musannaf Ibn Abi Shaybah 12384","","","كتاب الأيمان والنذور والكفارات"
"12385","(۱۲۳۸۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یُجْزِئُ الْمُعْتَقُ عَنْ دُبُرِ فِی الْکَفَّارَۃِ۔","","Musannaf Ibn Abi Shaybah 12385","","","كتاب الأيمان والنذور والكفارات"
"12386","(۱۲۳۸۶) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ مُہَاجِرِ بْنِ شَمَّاسٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَمَّا الْمُدَبَّرَۃُ فَلاَ تُجْزِئُ۔","","Musannaf Ibn Abi Shaybah 12386","","","كتاب الأيمان والنذور والكفارات"
"12387","(۱۲۳۸۷) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ بَشِیرٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یُجْزِئُ الْمُدَبَّرُ۔","","Musannaf Ibn Abi Shaybah 12387","","","كتاب الأيمان والنذور والكفارات"
"12388","(۱۲۳۸۸) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : أَمَّا الْمُدَبَّرُ فَلاَ یُجْزِئُ۔","","Musannaf Ibn Abi Shaybah 12388","","","كتاب الأيمان والنذور والكفارات"
"12389","(۱۲۳۸۹) حدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : تُجْزِئُ أُمُّ الْوَلَدِ فِی الظِّہَارِ۔","","Musannaf Ibn Abi Shaybah 12389","","","كتاب الأيمان والنذور والكفارات"
"12390","(۱۲۳۹۰) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ مُہَاجِرِ بْنِ شَمَّاسٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : تُجْزِئُ أُمُّ الْوَلَدِ فِی الظِّہَارِ۔","","Musannaf Ibn Abi Shaybah 12390","","","كتاب الأيمان والنذور والكفارات"
"12391","(۱۲۳۹۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : تُجْزِئُ فِی الظِّہَارِ۔","","Musannaf Ibn Abi Shaybah 12391","","","كتاب الأيمان والنذور والكفارات"
"12392","(۱۲۳۹۲) حدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ یُونُسَ ، عَنِ ہِشَامٍ","","Musannaf Ibn Abi Shaybah 12392","","","كتاب الأيمان والنذور والكفارات"
"12393","(۱۲۳۹۳) وابْنُ إدْرِیسَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، وعَنْ اللَیْثٍ، عَنْ طَاوُوسٍ، قَالَ: لاَ تُجْزِئُ أُمُّ الْوَلَدِ فِی الظِّہَارِ۔","","Musannaf Ibn Abi Shaybah 12393","","","كتاب الأيمان والنذور والكفارات"
"12394","(۱۲۳۹۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ تُجْزِئُ أُمُّ الْوَلَدِ فِی الْکَفَّارَۃِ۔","","Musannaf Ibn Abi Shaybah 12394","","","كتاب الأيمان والنذور والكفارات"
"12395","(۱۲۳۹۵) حدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تُجْزِئُ أُمُّ الْوَلَدِ فِی الظِّہَارِ۔","","Musannaf Ibn Abi Shaybah 12395","","","كتاب الأيمان والنذور والكفارات"
"12396","(۱۲۳۹۶) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی عِتْقَ أُمِّ الْوَلَدِ فِی شَیْئٍ مِنَ الْکَفَّارَاتِ۔","","Musannaf Ibn Abi Shaybah 12396","","","كتاب الأيمان والنذور والكفارات"
"12397","(۱۲۳۹۷) حدَّثَنَا أَبُو قطَن ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ فِی أُمِّ الْوَلَدِ فِی کَفَّارَۃِ الظِّہَارِ ، قَالَ : لاَ تُجْزِئہ ، وَقَالَ : الْحَکَمُ: غَیْرُہَا أَحَبُّ إلَیَّ مِنْہَا ، وَأَرْجُو۔","","Musannaf Ibn Abi Shaybah 12397","","","كتاب الأيمان والنذور والكفارات"
"12398","(۱۲۳۹۸) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ ، قَالاَ : لاَ تُجْزِئُ أُمُّ الْوَلَدِ مِنَ الرَّقَبَۃِ۔","","Musannaf Ibn Abi Shaybah 12398","","","كتاب الأيمان والنذور والكفارات"
"12399","(۱۲۳۹۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ ، قَالَ : تُجْزِئُ أُمُّ الْوَلَدِ مِنَ الرَّقَبَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 12399","","","كتاب الأيمان والنذور والكفارات"
"12400","(۱۲۴۰۰) حدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، أَنَّ رَجُلاً کَانَ عَلَیْہِ نَسَمَۃٌ فَأَرَادَ أَنْ یُعْتِقَ وَلَدَ مُکَاتَبَۃٍ لَہُمْ ، فَقَالَ : لاَ أَعْتِقْ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 12400","","","كتاب الأيمان والنذور والكفارات"
"12401","(۱۲۴۰۱) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُجْزِئُ فِی ألظِّہَارِ ، وَلاَ التَّحْرِیرِ ، وَلاَ الْقَتْلِ وَلَدُ مُکَاتَبَۃٍ۔","","Musannaf Ibn Abi Shaybah 12401","","","كتاب الأيمان والنذور والكفارات"
"12402","(۱۲۴۰۲) حدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَحَجَّاجٍ ، عَنْ عَطَائٍ ، أَنَّہُمْ قَالُوا : فِیمَنْ أَصَابَ جَنِینًا : إنَّ عَلَیْہِ عِتْقَ رَقَبَۃٍ مَعَ الْغُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 12402","","","كتاب الأيمان والنذور والكفارات"
"12403","(۱۲۴۰۳) غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنِ الْحَکَمِ، قَالَ: سَمِعْتُہُ یَقُولُ: إذَا ضُرِبَتِ الْمَرْأَۃُ وَأَلْقَتْ جَنِینًا، قَالَ: صَاحِبُہُ یُعْتِقُ۔","","Musannaf Ibn Abi Shaybah 12403","","","كتاب الأيمان والنذور والكفارات"
"12404","(۱۲۴۰۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، وَوَکِیعٌ ، عَنْ عُمَر بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ : أَنَّ رَجُلاً مَسَحَ بَطْنَ امْرَأَۃٍ ، فَأَلْقَتْ جَنِینًا ، فَأَمَرَہُ عُمَرُ بْنُ الْخَطَّابِ أَنْ یُعْتِقَ۔","","Musannaf Ibn Abi Shaybah 12404","","","كتاب الأيمان والنذور والكفارات"
"12405","(۱۲۴۰۵) عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ عَلَیْہِ إطْعَامُ مَسَاکِینَ فِی کَفَّارَۃِ الظِّہَارِ فَأَطْعَمَ عَشَرَۃً، ثُمَّ أَرَادَ أَنْ یُعِیدَ عَلَیْہِمْ حَتَّی یَسْتَکْمِلَ ، قَالَ : لاَ ، حَتَّی یُطْعِمَ سِتِّینَ مِسْکِینًا۔","","Musannaf Ibn Abi Shaybah 12405","","","كتاب الأيمان والنذور والكفارات"
"12406","(۱۲۴۰۶) حدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ یَعْقُوبَ ، عَنْ قَیْسٍ ، عَنِ الشَّعْبِیِّ بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 12406","","","كتاب الأيمان والنذور والكفارات"
"12407","(۱۲۴۰۷) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ سَمِعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عُمَرَ وہو یَقُولُ : وَأَبِی وَأَبِی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ یَنْہَاکُمْ أَنْ تَحْلِفُوا بِآبَائِکُمْ ، فَقَالَ : عُمَرُ : وَاللَّہِ لاَ حَلَفْت بِہَا لاَ ذَاکِرًا ، وَلاَ آثِرًا۔ (بخاری ۶۶۴۷۔ مسلم ۲)","Sahih","Musannaf Ibn Abi Shaybah 12407","","","كتاب الأيمان والنذور والكفارات"
"12408","(۱۲۴۰۸) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَدْرَکَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عُمَرَ فِی بَعْضِ أَسْفَارِہِ وَہُوَ یَقُولُ : وَأَبِی ، وَأَبِی ، فَقَالَ : إنَّ اللَّہَ یَنْہَاکُمْ أَنْ تَحْلِفُوا بِآبَائِکُمْ ، مَنْ حَلَفَ فَلْیَحْلِفْ بِاللَّہِ ، أَوْ لِیَسْکُتْ۔ (ابوداؤد ۳۲۴۴۔ ترمذی ۱۵۳۴)","Sahih","Musannaf Ibn Abi Shaybah 12408","","","كتاب الأيمان والنذور والكفارات"
"12409","(۱۲۴۰۹) عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَحْلِفُوا بِآبَائِکُمْ ، وَلاَ بِالطَّوَاغِیتِ۔ (مسلم ۶۔ احمد ۵/۶۲)","Sahih","Musannaf Ibn Abi Shaybah 12409","","","كتاب الأيمان والنذور والكفارات"
"12410","(۱۲۴۱۰) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : قَالَ عُمَرُ : حَدَّثْت قَوْمًا حَدِیثًا ، فَقُلْت : لاَ وَأَبِی ، فَقَالَ رَجُلٌ مِنْ خَلْفِی : لاَ تَحْلِفُوا بِآبَائِکُمْ ، قَالَ : فَالْتَفَتُّ ، فَإِذَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : لَوْ أَنَّ أَحَدَکُمْ حَلَفَ بِالْمَسِیحِ لَہَلَکَ ، وَالْمَسِیحُ خَیْرٌ مِنْ آبَائِکُمْ۔ (عبدالرزاق ۱۵۹۲۵)","","Musannaf Ibn Abi Shaybah 12410","","","كتاب الأيمان والنذور والكفارات"
"12411","(۱۲۴۱۱) حدَّثَنَا عَمْرُو بْنُ طَلْحَۃَ ، عَنْ أَسْبَاطِ بْنِ نَصْرٍ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ عُمَرَ ، أَنَّہُ قَالَ : حلَفْت بِأَبِی ، فَإِذَا رَجُلٌ مِنْ خَلْفِی یَقُولُ : لاَ تَحْلِفُوا بِآبَائِکُمْ ، فَالْتَفَتُّ فَإِذَا ہُوَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۱۹)","","Musannaf Ibn Abi Shaybah 12411","","","كتاب الأيمان والنذور والكفارات"
"12412","(۱۲۴۱۲) حدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، قَالَ : کُنَّا مَعَ ابن عُمَرَ فِی حَلْقَۃٍ ، فَسَمِعَ رَجُلاً یَقُول : لاَ ، وَأَبِی ، فَرَمَاہُ بِالْحَصَی ، وَقَالَ : إِنَّہَا کَانَتْ یَمِین عمر ، فَنَہَاہ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْہَا، وَقَالَ : إِنَّہَا شِرْکٌ۔ (احمد ۲/۵۸۔ طحاوی ۸۲۵)","Da'if","Musannaf Ibn Abi Shaybah 12412","","","كتاب الأيمان والنذور والكفارات"
"12413","(۱۲۴۱۳) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنِ الحسن بْنِ مُحَمَّدٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لیس منا مَنْ حَلَفَ بِغَیْر اللہِ ، أو قَالَ بِغَیْر الإسلام۔","","Musannaf Ibn Abi Shaybah 12413","","","كتاب الأيمان والنذور والكفارات"
"12414","(۱۲۴۱۴) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ وَبَرۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : لأَنْ أَحْلِفَ بِاللَّہِ کَاذِبًا أَحَبُّ إلَیَّ مِنْ أَنْ أَحْلِفَ بِغَیْرِہِ وَأَنَا صَادِقٌ۔","Sahih","Musannaf Ibn Abi Shaybah 12414","","","كتاب الأيمان والنذور والكفارات"
"12415","(۱۲۴۱۵) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : مَرَّ عُمَرُ بِالزُّبَیْرِ وَہُوَ یَقُولُ : لاَ وَالْکَعْبَۃِ ، فَرَفَعَ عَلَیْہِ الدِّرَّۃَ ، وَقَالَ : الْکَعْبَۃُ لاَ أُمَّ لَکَ تُطْعِمُک وَتَسْقِیک؟۔","Hasan","Musannaf Ibn Abi Shaybah 12415","","","كتاب الأيمان والنذور والكفارات"
"12416","(۱۲۴۱۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ کَعْبٌ : إنَّکُمْ تُشْرِکُونَ ، قَالُوا : وَکَیْفَ یَا أَبَا إِسْحَاقَ ؟ قَالَ : یَحْلِف الرَّجُلُ لاَ وَأَبِی ، لاَ وَأَبِیک ، لاَ لَعَمْرِی ، لاَ وَحَیَاتِکَ ، لاَ وَحُرْمَۃِ الْمَسْجِدِ ، لاَ وَالإِسْلاَمِ ، وَأَشْبَاہِہِ مِنَ الْقَوْلِ۔","","Musannaf Ibn Abi Shaybah 12416","","","كتاب الأيمان والنذور والكفارات"
"12417","(۱۲۴۱۷) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لَقَدْ أَدْرَکْت النَّاسَ ، وَلَوْ أَنَّ رَجُلاً رَکِبَ رَاحِلَتَہُ لاَنْضَاہَا قَبْل أَنْ یَسْمَعَ رَجُلاً یَحْلِفُ بِغَیْرِ اللہِ۔","","Musannaf Ibn Abi Shaybah 12417","","","كتاب الأيمان والنذور والكفارات"
"12418","(۱۲۴۱۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الحسن ، قَالَ : لاَ تَحْلِفُوا بِآبَائِکُمْ ، وَلاَ بِالطَّوَاغِیتِ۔","Hasan","Musannaf Ibn Abi Shaybah 12418","","","كتاب الأيمان والنذور والكفارات"
"12419","(۱۲۴۱۹) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ إسْمَاعِیلَ بْنِ ہِشَامٍ ، عَنِ الْقَاسِمِ بْنِ مُخَیْمِرَۃَ ، قَالَ : مَا أُبَالِی حَلَفْت بِحَیَاۃِ رَجُلٍ ، أَوْ بِالصَّلیبِ۔","","Musannaf Ibn Abi Shaybah 12419","","","كتاب الأيمان والنذور والكفارات"
"12420","(۱۲۴۲۰) حدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ : لاَ وَحَیَاتِک۔","","Musannaf Ibn Abi Shaybah 12420","","","كتاب الأيمان والنذور والكفارات"
"12421","(۱۲۴۲۱) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : إنَّ اللَّہَ تَعَالَی یُقْسِمُ بِمَا شَائَ مِنْ خَلْقِہِ ، وَلَیْسَ لأَحَدٍ أَنْ یُقْسِمَ إلاَّ بِاللَّہِ ، وَمَنْ أَقْسَمَ باللہ فَلاَ یَکْذِبُ۔","","Musannaf Ibn Abi Shaybah 12421","","","كتاب الأيمان والنذور والكفارات"
"12422","(۱۲۴۲۲) حدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ جَعْفَرٍ ، عَنْ أُمِّ بَکْرٍ بِنْتِ الْمِسْوَرِ ، أَنَّ الْمِسْوَرَ سَمِعَ ابْنًا لَہُ وَہُوَ یَقُولُ : أَشْرَکْت بِاَللَّہِ ، أَوْ کَفَرْت بِاللَّہِ فَضَرَبَہُ ، ثُمَّ قَالَ : قُلْ : اَسْتَغْفِرُ اللَّہَ آمَنْت بِاللَّہِ ، ثَلاَثًا۔","Da'if","Musannaf Ibn Abi Shaybah 12422","","","كتاب الأيمان والنذور والكفارات"
"12423","(۱۲۴۲۳) حدَّثَنَا عُبَیْدُ اللہِ ، قَالَ أَخْبَرَنَا إسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ أبِیہِ ، أَنَّہُ قَالَ : حَلَفْت بِاللاَّتِ وَالْعُزَّی ، فَأَتَیْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْت : إنِّی حَلَفْت بِاللاَّتِ وَالْعُزَّی ، قَالَ : قُلْ : لاَ إلَہَ إلاَّ اللَّہُ ، ثَلاَثًا ، وَانْفُثْ عَنْ شِمَالِکَ ثَلاَثًا ، وَتَعَوَّذْ بِاللَّہِ مِنَ الشَّیْطَانِ ، ثُمَّ لاَ تَعُدْ۔n(ابن ماجہ ۲۰۹۷۔ احمد ۱۸۶)","Sahih","Musannaf Ibn Abi Shaybah 12423","","","كتاب الأيمان والنذور والكفارات"
"12424","(۱۲۴۲۴) حدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِالرَّحْمَنِ، عَنْ أَبِیہِ، قَالَ: کَانَتْ یَمِینُ عُثْمَانَ بْنِ أَبِی الْعَاصِ: لَعَمْرِی۔","Sahih","Musannaf Ibn Abi Shaybah 12424","","","كتاب الأيمان والنذور والكفارات"
"12425","(۱۲۴۲۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : نبئت أن أَبَا السَّوَّارِ الْعَدَوِیَّ ، قَالَ : إذَا سَمِعْتُمُونِی أقول : لاَہَا اللہِ إذًا ، أوْ لَعَمْرِی ، فَذَکِّرُونِی۔","","Musannaf Ibn Abi Shaybah 12425","","","كتاب الأيمان والنذور والكفارات"
"12426","(۱۲۴۲۶) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَالَ الرَّجُلُ : لَعَمْرِی لاَ أَفْعَلُ کَذَا کَذَا ، إِنْ حَنِثَ فَعَلَیْہِ الْکَفَّارَۃُ۔","","Musannaf Ibn Abi Shaybah 12426","","","كتاب الأيمان والنذور والكفارات"
"12427","(۱۲۴۲۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَعَمْرِی لَغْوٌ۔","","Musannaf Ibn Abi Shaybah 12427","","","كتاب الأيمان والنذور والكفارات"
"12428","(۱۲۴۲۸) حدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ : لَعَمْرِی۔","","Musannaf Ibn Abi Shaybah 12428","","","كتاب الأيمان والنذور والكفارات"
"12429","(۱۲۴۲۹) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ کَعْبٌ : إنَّکُمْ تُشْرِکُونَ ، قَالُوا : وَکَیْفَ یَا أَبَا إِسْحَاقَ ؟ قَالَ : یَقُولُ أَحَدُکُمْ : لاَ ولَعَمْرِی ، لاَ وَحَیَاتِک۔","","Musannaf Ibn Abi Shaybah 12429","","","كتاب الأيمان والنذور والكفارات"
"12430","(۱۲۴۳۰) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قِیلَ لِلرَّجُلِ حَلَفْت أن لاَ تَفْعَلْ کَذَا وَکَذَا ؟ فَیَقُولُ : نَعَمْ ، وَلَمْ یَحْلِفْ ، قَالَ : عَلَیْہِ کَفَّارَۃُ یَمِینٍ۔","","Musannaf Ibn Abi Shaybah 12430","","","كتاب الأيمان والنذور والكفارات"
"12431","(۱۲۴۳۱) حدَّثَنَا أبُو أُسَامَۃَ ، عَنْ ہُشَام ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَالَ : عَلَیَّ یَمِینٌ ، ثُمَّ حَنِثَ فَعَلَیْہِ الْکَفَّارَۃُ۔","","Musannaf Ibn Abi Shaybah 12431","","","كتاب الأيمان والنذور والكفارات"
"12432","(۱۲۴۳۲) حدَّثَنَا غنْدَرٌ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ، قَالَ: إذَا قَالَ: قَدْ حَلَفْت ، وَلَمْ یَکُنْ حَلَفَ ، فَلَیْسَ عَلَیْہِ الکَفَّارَۃ۔","","Musannaf Ibn Abi Shaybah 12432","","","كتاب الأيمان والنذور والكفارات"
"12433","(۱۲۴۳۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ : الرَّجُلُ حَلَفْت ، وَلَمْ یَحْلِفْ فَقَدْ کَذَبَ وَحَلَفَ ، وَإذَا قَالَ : قَد حَلَفْت وَکَذَبْت ، فَقَدْ کَذَبَ۔","","Musannaf Ibn Abi Shaybah 12433","","","كتاب الأيمان والنذور والكفارات"
"12434","(۱۲۴۳۴) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ تَمِیمِ بْنِ طُرْفَۃَ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ حَلَفَ عَلَی یَمِینٍ فَرَأَی خَیْرًا مِنْہَا فَلْیَدَعْ یَمِینَہُ ، وَلْیَأْتِ الَّذِی ہُوَ خَیْرٌ ، وَلْیُکَفِّرْ یَمِینَہُ۔ (مسلم ۱۲۷۲۔ احمد ۴/۲۵۶)","Sahih","Musannaf Ibn Abi Shaybah 12434","","","كتاب الأيمان والنذور والكفارات"
"12435","(۱۲۴۳۵) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ زَیْدِ بْنِ جُدْعَانَ ، قَالَ : حدَّثَنَا الْحَسَنُ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ سَمُرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا حَلَفْت عَلَی یَمِینٍ ، فَرَأَیْت مَا ہُوَ خَیْرٌ مِنْہَا فَاْتِ الَّذِی ہُوَ خَیْرٌ وَکَفِّرْ یَمِینَک۔ (بخاری ۶۶۲۲۔ ابوداؤد ۳۲۷۱)","Da'if","Musannaf Ibn Abi Shaybah 12435","","","كتاب الأيمان والنذور والكفارات"
"12436","(۱۲۴۳۶) حدَّثَنَا أبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أُذَیْنَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ حَلَفَ عَلَی یَمِینٍ فَرَأَی مَا ہُوَ خَیْرٌ مِنْہَا فَلْیَأْتِ الَّذِی ہُوَ خَیْرٌ وَلْیُکَفِّرْ عَنْ یَمِینِہِ۔ (طبرانی ۸۷۳۔ طیالسی ۱۳۷۰)","","Musannaf Ibn Abi Shaybah 12436","","","كتاب الأيمان والنذور والكفارات"
"12437","(۱۲۴۳۷) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ رضی اللَّہُ عَنْہَا ، قَالَتْ : إنَّ أَبَا بَکْرٍ کَانَ لاَ یَحْلِفُ عَلَی یَمِینٍ فَیَحْنَثُ فِیہَا ، حَتَّی نَزَلَتْ کَفَّارَۃُ الْیَمِینِ ، قَالَ : لاَ أَحْلِفُ عَلَی یَمِینٍ فَأَرَی غَیْرَہَا خَیْرًا مِنْہَا إلاَّ أَتَیْتُ الَّذِی ہُوَ خَیْرٌ ، وَکَفَّرْت یَمِینِی۔","Sahih","Musannaf Ibn Abi Shaybah 12437","","","كتاب الأيمان والنذور والكفارات"
"12438","(۱۲۴۳۸) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ أَبُو بَکْرٍ رضی اللَّہُ عَنْہُ إذَا حَلَفَ لَمْ یَحْنَثْ حَتَّی نَزَلَتْ ہَذِہِ الآیَۃُ : {لاَ یُؤَاخِذُکُمَ اللَّہُ بِاللَّغْوِ فِی أَیْمَانِکُمْ} ، فَکَانَ إذَا حَلَفَ عَلَی یَمِینٍ ، فَرَأَی غَیْرَہَا خَیْرًا مِنْہَا أَتَی الَّذِی ہُوَ خَیْرٌ وَکَفَّرَ عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 12438","","","كتاب الأيمان والنذور والكفارات"
"12439","(۱۲۴۳۹) حدَّثَنَا أبو أسامۃ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَقُولُونَ : مَنْ حَلَفَ عَلَی یَمِینٍ فَرَأَی مَا ہُوَ خَیْرٌ مِنْہَا فَلْیَدَعْ یَمِینَہُ وَلْیَأْتِ الَّذِی ہُوَ خَیْرٌ ، وَلْیُکَفِّرْ عَنْ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 12439","","","كتاب الأيمان والنذور والكفارات"
"12440","(۱۲۴۴۰) حدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ : حَلَفْت عَلَی أَمْرٍ غَیْرُہُ خَیْرٌ مِنْہُ أدعہ وأُکَفِّرُ یَمِینِی ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 12440","","","كتاب الأيمان والنذور والكفارات"
"12441","(۱۲۴۴۱) حدَّثَنَا الفَضْلُ بْنُ دُکَیْنٍ ، عَنْ شَرِیکٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ قَبِیصَۃَ بْنِ جَابِرٍ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ : مَنْ حَلَفَ عَلَی یَمِینٍ فَرَأَی خَیْرًا مِنْہَا فَلْیَأْتِ الَّذِی ہُوَ خَیْرٌ وَلْیُکَفِّرْ عَنْ یَمِینِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 12441","","","كتاب الأيمان والنذور والكفارات"
"12442","(۱۲۴۴۲) حدَّثَنَا أبُو دَاوُد الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمِ بْنِ الْمُنْذِرِ ، قَالَ : سَأَلْتُ عُبَیْدَ بْنَ عُمَیْرٍ ، عَنْ رَجُلٍ نَذَرَ أَنْ لاَ یَدْخُلَ عَلَی خَالَتِہِ ، قَالَ : یَدْخُلُ عَلَیْہَا وَیُکَفِّرُ یَمِینَہُ۔","","Musannaf Ibn Abi Shaybah 12442","","","كتاب الأيمان والنذور والكفارات"
"12443","(۱۲۴۴۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، قَالَ أُتِیَ عَبْدُ اللہِ بِضَرْعٍ وَنَحْنُ عِنْدَہُ فَاعْتَزَلَ رَجُلٌ مِنَ الْقَوْمِ ، فَقَالَ عَبْدُ اللہِ : ادْنُ ، فَقَالَ لَہُ : الرَّجُلُ : إنِّی حَلَفْت أَنْ لاَ آکُلَ ضَرْعَ نَاقَۃٍ ، فَقَالَ: ادْنُ فَکُلْ۔","Sahih","Musannaf Ibn Abi Shaybah 12443","","","كتاب الأيمان والنذور والكفارات"
"12444","(۱۲۴۴۴) حدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ رضی اللَّہُ عَنْہ ، أَنَّہُ کَانَ یُکَفِّرُ قَبْلَ أَنْ یَحْنَثَ۔","Sahih","Musannaf Ibn Abi Shaybah 12444","","","كتاب الأيمان والنذور والكفارات"
"12445","(۱۲۴۴۵) حدَّثَنَا مُعْتَمِرٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدِ أن مَسْلَمَۃَ بن مَخَلَّد وَسَلْمَانَ کَانَا یَرَیَانِ أَنْ یُکَفِّرَ قَبْلَ أَنْ یَحْنَثَ۔","","Musannaf Ibn Abi Shaybah 12445","","","كتاب الأيمان والنذور والكفارات"
"12446","(۱۲۴۴۶) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّ أَبَا الدَّرْدَائِ رضی اللَّہُ عَنْہُ دَعَا غُلاَمًا لَہُ فَأَعْتَقَہُ ، ثُمَّ حَنِثَ فَصَنَعَ الَّذِی حَلَفَ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 12446","","","كتاب الأيمان والنذور والكفارات"
"12447","(۱۲۴۴۷) حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یُکَفِّرُ قَبْلَ أَنْ یَحْنَثَ۔","","Musannaf Ibn Abi Shaybah 12447","","","كتاب الأيمان والنذور والكفارات"
"12448","(۱۲۴۴۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ أَنَّہُ کَانَ یُکَفِّرُ قَبْلَ أَنْ یَحْنَثَ۔","","Musannaf Ibn Abi Shaybah 12448","","","كتاب الأيمان والنذور والكفارات"
"12449","(۱۲۴۴۹) حدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یُکَفِّرُ قَبْلَ أَنْ یَحْنَثَ ، وَکَانَ الْحَسَنُ یَقُولُ : یَحْنَثُ ، ثُمَّ یُکَفِّرُ۔","","Musannaf Ibn Abi Shaybah 12449","","","كتاب الأيمان والنذور والكفارات"
"12450","(۱۲۴۵۰) حدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ کَثِیرٍ ، أَنَّہُ سَمِعَ رَجُلاً سَأَلَ جَابِرَ بْنَ زَیْدٍ ، قَالَ : حلَفْت عَلَی یَمِینٍ غَیْرُہَا خَیْرٌ مِنْہَا ، قَالَ : کَفِّرْ یَمِینَک وَاعْمِد إلی الَّذِی ہُوَ خَیْرٌ۔","","Musannaf Ibn Abi Shaybah 12450","","","كتاب الأيمان والنذور والكفارات"
"12451","(۱۲۴۵۱) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ ، قَالَ : یَمِینٌ لاَ تُکَفَّرُ ، الرَّجُلُ یَحْلِفُ عَلَی الْکَذِبِ یَتَعَمَّدُہُ ، فَذَلِکَ إلَی اللہِ ، إِنْ شَائَ عَذَّبَہُ ، وَإِنْ شَائَ غَفَرَ لَہُ۔","","Musannaf Ibn Abi Shaybah 12451","","","كتاب الأيمان والنذور والكفارات"
"12452","(۱۲۴۵۲) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ؛ فِی الرَّجُلِ یَحْلِفُ عَلَی الشَّیْئِ یَتَعَمَّدُہُ ، قَالَ حَمَّادٌ : لَیْسَ لِہَذَا کَفَّارَۃٌ ، وَقَالَ : الْحَکَمُ : الْکَفَّارَۃُ خَیْرٌ۔","","Musannaf Ibn Abi Shaybah 12452","","","كتاب الأيمان والنذور والكفارات"
"12453","(۱۲۴۵۳) حدَّثَنَا حَفْصٌ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَحْلِفُ عَلَی الشَّیْئِ عِنْدَہُ ، وَلاَ یَدْرِی ثم یدری أَنَّہُ عِنْدَہُ ، قَالَ : یُکَفِّرُ یَمِینَہُ ، قَالَ : وَقَالَ عَطَائٌ وَالْحَکَمُ فِی التی لاَ تُکَفَّرُ : کَفِّرْ۔","","Musannaf Ibn Abi Shaybah 12453","","","كتاب الأيمان والنذور والكفارات"
"12454","(۱۲۴۵۴) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الأَیْمَانُ أَرْبَعَۃٌ ، فَیَمِینَانِ یُکَفَّرَانِ وَیَمِینَانِ لاَ یُکَفَّرَانِ: وَاللَّہِ لاَ أفْعَلُ وَاللَّہِ لأَفْعَلَنَّ ، قَالَ : فَہُمَا تُکَفَّرَانِ ، وَاللہِ مَا فَعَلْتُہُ وَاللہِ لَقَدْ فَعَلْتُ ، فَلاَ تُکَفَّرَانِ۔","","Musannaf Ibn Abi Shaybah 12454","","","كتاب الأيمان والنذور والكفارات"
"12455","(۱۲۴۵۵) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، وَوَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الْقَسَمُ یَمِینٌ۔","Da'if","Musannaf Ibn Abi Shaybah 12455","","","كتاب الأيمان والنذور والكفارات"
"12456","(۱۲۴۵۶) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ، قَالَ : الْقَسَمُ یَمِینٌ ، ثُمَّ قَرَأَ : { وَأَقْسَمُوا بِاللَّہِ جَہْدَ أَیْمَانِہِمْ }۔","","Musannaf Ibn Abi Shaybah 12456","","","كتاب الأيمان والنذور والكفارات"
"12457","(۱۲۴۵۷) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَقْسَمْت یَمِینٌ۔","","Musannaf Ibn Abi Shaybah 12457","","","كتاب الأيمان والنذور والكفارات"
"12458","(۱۲۴۵۸) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : أَقْسَمَ رَجُلٌ أَنْ لاَ یَشْرَبَ مِنْ لَبَنِ شَاۃِ امْرَأَتِہِ ، قَالَ عَبْدُ اللہِ : أَطْیَبُ لِنَفْسِہِ أَنْ یُکَفِّرَ یَمِینَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 12458","","","كتاب الأيمان والنذور والكفارات"
"12459","(۱۲۴۵۹) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ أَقْسَمَ عَلَی رَجُلٍ فَأَحْنَثَہُ ، قَالَ : أَحَبُّ إلَیَّ أَنْ یُکَفِّرَ یَمِینَہُ۔","","Musannaf Ibn Abi Shaybah 12459","","","كتاب الأيمان والنذور والكفارات"
"12460","(۱۲۴۶۰) حدَّثَنَا ہُشَیْمٌ ، عَنْ عَوْفٍ ، عَنْ أَبِی الْمِنْہَالِ ، أَنَّ رَجُلاً أَقْسَمَ عَلَی رَجُلٍ فَأَحْنَثَہُ ، قَالَ أَبُو العَالیۃ : کَفِر یَمیِنک۔","","Musannaf Ibn Abi Shaybah 12460","","","كتاب الأيمان والنذور والكفارات"
"12461","(۱۲۴۶۱) حدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الحَسَن قَال : کَان لاَ یَری عَلَیہ کَفَّارَۃٌ إِذَا أَقْسَمَ عَلَی غَیرہ فَأَحْنَثَہُ قَالَ : إلاَّ أَنْ یُقْسِمَ ہُوَ ، فَإِذَا أَقْسَمَ ہُوَ فَحَنِثَ فَعَلَیْہِ الْکَفَّارَۃُ۔","","Musannaf Ibn Abi Shaybah 12461","","","كتاب الأيمان والنذور والكفارات"
"12462","(۱۲۴۶۲) حدَّثَنَا یَحْیَی ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنِ الْحَکَمِ ، قَالَ : الْقَسَمُ یَمِینٌ۔","","Musannaf Ibn Abi Shaybah 12462","","","كتاب الأيمان والنذور والكفارات"
"12463","(۱۲۴۶۳) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ شَرِیکٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْقَسَمُ یَمِینٌ۔","Da'if","Musannaf Ibn Abi Shaybah 12463","","","كتاب الأيمان والنذور والكفارات"
"12464","(۱۲۴۶۴) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ بَکْرٍ ، قَالَ : إذَا أَقْسَمَ الرَّجُلُ عَلَی الرَّجُلِ فَأَحْنَثَہُ فَالإِثْم عَلَی الَّذِی أَحْنَثَہُ ، لأَنَّہُ إنَّمَا أَقْسَمَ عَلَیْہِ ثقۃً بِہِ۔","","Musannaf Ibn Abi Shaybah 12464","","","كتاب الأيمان والنذور والكفارات"
"12465","(۱۲۴۶۵) حدَّثَنَا ابْنُ مَہْدِیٍّ ، وَعُبَیْدُ اللہِ ، عَنْ شَیْبَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : الْقَسَمُ یَمِینٌ۔","","Musannaf Ibn Abi Shaybah 12465","","","كتاب الأيمان والنذور والكفارات"
"12466","(۱۲۴۶۶) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ الرَّجُلُ : أَقْسَمْت عَلَیْک ، فَلَیْسَ بِشَیْئٍ ، فَإذَا قَالَ : أُقْسِمُ عَلَیْکَ بِاللَّہِ ، فَہِیَ کَفَّارَۃُ یَمِینٍ۔","","Musannaf Ibn Abi Shaybah 12466","","","كتاب الأيمان والنذور والكفارات"
"12467","(۱۲۴۶۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : لاَ یَکُونُ الْقَسَمُ یَمِینًا حَتَّی یَقُولَ : أُقْسِمُ بِاللَّہِ۔","","Musannaf Ibn Abi Shaybah 12467","","","كتاب الأيمان والنذور والكفارات"
"12468","(۱۲۴۶۸) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَالَ الرَّجُلُ : أَقْسَمْت ، أَوْ أشہد ، وَلَمْ یَقُلْ : بِاللَّہِ ، فَلَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 12468","","","كتاب الأيمان والنذور والكفارات"
"12469","(۱۲۴۶۹) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا قَالَ : الرَّجُلُ أَقْسَمْت ، أَوْ أَشْہَدُ أو أَحْلِفُ ، فَلَیْسَ بِیَمِینٍ حَتَّی یَقُولَ : بِاللَّہِ۔","","Musannaf Ibn Abi Shaybah 12469","","","كتاب الأيمان والنذور والكفارات"
"12470","(۱۲۴۷۰) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیل ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَعَنْ رَجُلٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالاَ : إذَا قَالَ الرَّجُلُ : أَقْسَمْت فَلَیْسَ بِیَمِینٍ حَتَّی یَقُولَ : بِاللَّہِ۔","","Musannaf Ibn Abi Shaybah 12470","","","كتاب الأيمان والنذور والكفارات"
"12471","(۱۲۴۷۱) حدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : إذَا قَالَ الرَّجُلُ : لِلَّہِ عَلَیَّ، أَوْ عَلَیہ حَجَّۃٌ فَسَوَائٌ ، وَإذَا قَالَ : لِلَّہِ عَلَیَّ نَذْرٌ ، أَوْ عَلَیہ نَذْرٌ فَسَوَائٌ ، وَإذَا قَالَ : أَقْسَمْت بِاللَّہِ ، أَوْ أُقْسِمُ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 12471","","","كتاب الأيمان والنذور والكفارات"
"12472","(۱۲۴۷۲) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : سَوَائٌ عَلَی الرَّجُلِ أَنْ یَقُولَ : أُقْسِمُ ، أَوْ أُقْسِمُ بِاللَّہِ عَلَیَّ حَجَّۃٌ ، أَوْ َعلَیَّ حَجَّۃٌ لِِلَّہِ ، أَوْ عَلَیَّ نَذْرٌ ، أَوْ عَلَیَّ نَذْرٌ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 12472","","","كتاب الأيمان والنذور والكفارات"
"12473","(۱۲۴۷۳) حدَّثَنَا أَبُو أسَامَۃُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الرَّجُلِ یَقُولُ : عَلَیَّ الْمَشْیُ إلَی الْکَعْبَۃِ ، قَالَ : ہَذَا نَذْرٌ فَلیَمْشِ۔","Sahih","Musannaf Ibn Abi Shaybah 12473","","","كتاب الأيمان والنذور والكفارات"
"12474","(۱۲۴۷۴) حدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ محمد بْنِ ہِلاَلٍ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : مَنْ قَالَ عَلَیَّ الْمَشْیُ إلَی الْکَعْبَۃِ ، فَلَیْسَ بِشَیْئٍ إلاَّ أَنْ یَقُولَ : عَلَیَّ نَذْرُ مَشْیٍ۔","","Musannaf Ibn Abi Shaybah 12474","","","كتاب الأيمان والنذور والكفارات"
"12475","(۱۲۴۷۵) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : جَعَلَ رَجُلٌ مِنَّا عَلَیْہِ الْمَشْیَ إلَی بَیْتِ اللہِ فِی شَیْئٍ فَأَتَی الْقَاسِمَ فَسَأَلَہُ عَنْ ذَلِکَ ، فَقَالَ : یَمْشِی إلَی الْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 12475","","","كتاب الأيمان والنذور والكفارات"
"12476","(۱۲۴۷۶) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، قَالَ : سَأَلْتُ عَطَائً ، عَنْ رَجُلٍ ، قَالَ : لِلَّہِ عَلَیَّ یَمِینٌ ، قَالَ : یُکَفِّرُہَا۔","","Musannaf Ibn Abi Shaybah 12476","","","كتاب الأيمان والنذور والكفارات"
"12477","(۱۲۴۷۷) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا حَلَفَ أَطْعَمَ مُدًّا وَإِنْ وَکَّد أَعْتَقَ ، قَالَ: فَقُلْت لِنَافِعٍ : مَا التَّوْکِیدُ ؟ قَالَ : یُرَدِّدُ الْیَمِینَ فِی الشَّیْئِ الْوَاحِدِ۔","Sahih","Musannaf Ibn Abi Shaybah 12477","","","كتاب الأيمان والنذور والكفارات"
"12478","(۱۲۴۷۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ الدَستَوائی ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ الرَّجُلُ لِلرَّجُلِ وَلَہُ عَلَیْہِ مَالٌ : إِنْ لَمْ تَقْضِنِی یَوْمَ کَذَا وَکَذَا فَہُوَ عَلَیْک صَدَقَۃٌ ، فَلَیْسَ بِشَیْئٍ ، وَإن قَالَ : وَإِنْ لَمْ تُعْطِنِی إلَی یَوْمِ کَذَا وَکَذَا فَہُوَ فِی الْمَسَاکِینِ صَدَقَۃٌ ، فَہُوَ کَمَا قَالَ۔","","Musannaf Ibn Abi Shaybah 12478","","","كتاب الأيمان والنذور والكفارات"
"12479","(۱۲۴۷۹) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مَنْصُورِ بن عَبْدِ الرَّحْمَنِ ، عَنْ أُمِّہِ ، أَنَّہَا سَأَلَتْ عَائِشَۃَ رضی اللَّہُ عَنْہُا مَا یُکَفِّرُ قَوْلَ الإِنْسَانِ : کُلُّ مَالِی فِی سَبِیلِ اللہِ ، أَوْ فِی رتَاجِ الْکَعْبَۃِ ، فَقَالَتْ : یُکَفِّرُہَا مَا یُکَفِّرُ الْیَمِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 12479","","","كتاب الأيمان والنذور والكفارات"
"12480","(۱۲۴۸۰) حدَّثَنَا عَبْدُ الرَّحِیمِ ووَکِیعٌ ، عَنْ مِسْعَرٍ ، قَالَ : سَمِعْتُ ہُبَیْرَۃَ یُحَدِّثُ الْحَکَمَ بْنَ عُتَیْبَۃَ مُنْذُ ثَلاَثِینَ سَنَۃً، قَالَ إنَّ امْرَأَۃً مِنَّا جَعَلَتْ دَارَہَا ہَدِیَّۃً فَأَمَرَہَا ابْنُ عَبَّاسٍ تُہْدِی ثَمَنَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 12480","","","كتاب الأيمان والنذور والكفارات"
"12481","(۱۲۴۸۱) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یُہْدِی دَارَہُ إلَی بَیْتِ اللہِ ، قَالَ : یَبِیعُہَا وَیَبْعَثُ ثَمَنَہَا إلَی مَکَّۃَ ، أَوْ یَنْطَلِقُ یَتَصَدَّقُ بِہِ بِمَکَّۃَ ، أَوْ یَشْتَرِی ذَبَائِحَ فَیَذْبَحُہَا بِمَکَّۃَ ، وَیَتَصَدَّقُ بِہَا۔","","Musannaf Ibn Abi Shaybah 12481","","","كتاب الأيمان والنذور والكفارات"
"12482","(۱۲۴۸۲) حدَّثَنَا أبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَقُولُ لِمَمْلُوکِہِ : ہُوَ ہَدِیَّۃٌ ، قَالَ : یُہْدِی قِیمَتَہُ۔","","Musannaf Ibn Abi Shaybah 12482","","","كتاب الأيمان والنذور والكفارات"
"12483","(۱۲۴۸۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ عَتِیقٍ فِی رَجُلٍ أَہْدَی مَمْلُوکَہُ وَمَمْلُوکَتَہُ ، قَالَ الشَّعْبِیُّ : یُہْدِی قِیمَتَہُمَا وَقَالَ عَطَائٌ : یُہْدِی کَبْشًا۔","","Musannaf Ibn Abi Shaybah 12483","","","كتاب الأيمان والنذور والكفارات"
"12484","(۱۲۴۸۴) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الرَّجُلِ یَقُولُ : ہُوَ یُہْدِی غُلاَمَہُ ، قَالَ : یُہْدِی کَبْشًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 12484","","","كتاب الأيمان والنذور والكفارات"
"12485","(۱۲۴۸۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَامِعِ بْنِ أَبِی رَاشِدٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُہْدِی دَارَہُ ، قَالَ : کَفَّارَۃُ یَمِینٍ۔","","Musannaf Ibn Abi Shaybah 12485","","","كتاب الأيمان والنذور والكفارات"
"12486","(۱۲۴۸۶) حدَّثَنَا دَاوُد بْنُ کَثِیرٍ الْجُزرِیِّ ، عَنْ طَارِقِ بن أَبِی مُرَّۃَ ، قَالَ : حلفت لِامْرَأَتِی فِی جَارِیَۃٍ لَہَا إِنْ أَنَا وَطِئْتہَا فَہِیَ ہَدِیَّۃٌ إلَی بَیْتِ اللہِ فَوَطِئْتہَا ، فَسَأَلْت سَعِیدَ بْنَ جُبَیْرٍ ، فَقَالَ : اشْتَرِ بِثَمَنِہَا بُدْنًا ، ثُمَّ انْحَرْہَا۔","","Musannaf Ibn Abi Shaybah 12486","","","كتاب الأيمان والنذور والكفارات"
"12487","(۱۲۴۸۷) حدَّثَنَا حمید بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ؛ فِی الرَّجُلِ یُہْدِی الدَّارَ ، قَالَ : یُہْدِی قِیمَتَہَا۔","","Musannaf Ibn Abi Shaybah 12487","","","كتاب الأيمان والنذور والكفارات"
"12488","(۱۲۴۸۸) حدَّثَنَا کثیر بْنُ ہِشَامٍ ، عَنْ فُرَات ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ، قَالَ إذَا قَالَ لِشَیْئٍ : ہُوَ عَلَیْہِ ہَدْیٌ، فَکَفَّارَۃُ یَمِینٍ ہُوَ مِنْ خَطَرَاتِ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 12488","","","كتاب الأيمان والنذور والكفارات"
"12489","(۱۲۴۸۹) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ : ہُوَ یُہْدِی سَارِیَۃً مِنْ سَوَارِی الْمَسْجِدِ ، یُہْدِی قِیمَتَہَا ، أَوْ ، ثَمَنَہَا ، فَإِنْ لَمْ یَجِدْ أَہْدَی مَا بَلَغَ مَالَہُ وَکَفَّرَ یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 12489","","","كتاب الأيمان والنذور والكفارات"
"12490","(۱۲۴۹۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَسْتَحِبُّ إذَا أَہْدَی الرَّجُلُ الشَّیْئَ أَنْ یُمْضِیَہُ۔","","Musannaf Ibn Abi Shaybah 12490","","","كتاب الأيمان والنذور والكفارات"
"12491","(۱۲۴۹۱) حدَّثَنَا أبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : أَنَا أَمْشِی بِرِدَائِی ہَذَا حَتَّی أَسِیرَ بِہِ إلَی الْکَعْبَۃِ إِنْ کَلَّمت صَاحِبًا لِی ، قَالَ : فَنَدِمْت ؟ قُلْتُ نَعَمْ ، قَالَ : اذْہَبْ فَالْبَسْ ثَوْبَک ، فَمَا أَغْنَی الْکَعْبَۃَ ، عَنْ ثَوْبِکَ وَعَنْک ، وَقل : سَعِید أَمَرَنِی فَأَتَیْت الْقَاسِمَ بْنَ مُحَمَّدٍ ، فَقَالَ لِی مِثْلَ مَا قَالَ سَعِیدٌ ، فَلَمَّا خَرَجْت مِنْ عِنْدِہِ أَدْرَکَنِی رَسُولُہُ فَقَالُ : عِنْدَک دِرْہَمٌ ؟ قُلْتُ : نَعَمْ ، قَالَ : تَصَدَّقْ بِہِ ، وََقُل : أَمَرَنِی بِہِ الْقَاسِمُ۔","","Musannaf Ibn Abi Shaybah 12491","","","كتاب الأيمان والنذور والكفارات"
"12492","(۱۲۴۹۲) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ حَمَّاد ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ ، قَالَ : ہُوَ یُہْدِی الْفُرَاتَ وَمَا سَمَّی ، قَالَ : یُہْدِی مَا یَمْلِکُ۔","","Musannaf Ibn Abi Shaybah 12492","","","كتاب الأيمان والنذور والكفارات"
"12493","(۱۲۴۹۳) حدَّثَنَا حَفْصٌ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ عَطَائٍ ، قَالَ : کَفَّارَۃُ یَمِینٍ۔","","Musannaf Ibn Abi Shaybah 12493","","","كتاب الأيمان والنذور والكفارات"
"12494","(۱۲۴۹۴) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیث ، عَنْ طَاوُوس ، وَعَطَائٍ ، وَمُجَاہِدٍ ، قَالُوا : مَا کَانَ من ہَدْیٍ إلَی الْبَیْتِ فَلْیَشْتَرِ بِہِ بُدْنًا فَیَتَصَدَّقْ بِہَا۔","","Musannaf Ibn Abi Shaybah 12494","","","كتاب الأيمان والنذور والكفارات"
"12495","(۱۲۴۹۵) حدَّثَنَا عَبْدُ الرَّحِیمِ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ، قَالَ: سَأَلْتُ عَطَائً عَنْ سبعۃ دَرَاہِمَ بَعَثَتْ بِہَا امْرَأَتُہُ ہَدِیَّۃً إلَی الْبَیْتِ، قَالَ عَطَائٌ: إنَّ بَیْتَکُمْ ہَذَا غَنِیٌّ عَنْ دَرَاہِمِکُمْ، وَلَکِنْ أَعْطُوہَا فُقَرَائَ کُمْ، إنَّمَا الْبُدْنُ ہَدَایَا الْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 12495","","","كتاب الأيمان والنذور والكفارات"
"12496","(۱۲۴۹۶) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، أَنَّ امْرَأَۃً ، قَالَتْ : کُنْت عِنْدَ عَائِشَۃَ أُمِّ الْمُؤْمِنِینَ فَأَتَتْہَا امْرَأَۃٌ، بحُلِیٍّ فَقَالَتْ : إنِّی جِئْت بِہَذَا ہَدِیَّۃً إلَی الْکَعْبَۃِ ، فَقَالَتْ لَہَا عَائِشَۃُ : لَوْ أَعْطَیْتہ فِی سَبِیلِ اللہِ وَالْیَتَامَی وَالْمَسَاکِینِ ، إنَّ ہَذَا الْبَیْتَ یُعْطَی وَیُنْفَقُ عَلَیْہِ مِنْ مَالِ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 12496","","","كتاب الأيمان والنذور والكفارات"
"12497","(۱۲۴۹۷) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی الْعَنْبَسِ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، قَالَتْ : لأَنْ أَتَصَدَّقَ بِخَاتَمِی ہَذَا أَحَبُّ إلَیَّ مِنْ أَنْ أُہْدِیَ إلَی الْکَعْبَۃِ أَلْفًا۔","Sahih","Musannaf Ibn Abi Shaybah 12497","","","كتاب الأيمان والنذور والكفارات"
"12498","(۱۲۴۹۸) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنْ ہِشَامٍ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ، قَالَ: سَمِعْتُہُ یَقُولُ: لأَنْ أَتَصَدَّقَ بِدِرْہَمٍ أَحَبُّ إلَیَّ مِنْ أَنْ أُہْدِیَ إلَی البَیْتِ مِئَۃ أَلْفِ دِرْہَمٍ ، وَلَوْ سَالَ عَلَیَّ وَادِی مَالٍ مَا أَہْدَیْت إلَی الْبَیْتِ مِنْہُ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 12498","","","كتاب الأيمان والنذور والكفارات"
"12499","(۱۲۴۹۹) حدَّثَنَا مَحْبُوبٌ الْقَوَارِیرِیُّ ، عَنْ مَالِکِ بنِ حَبِیبٍ ، عَنْ سَالِمٍ ، قَالَ : سَأَلَہُ رَجُلٌ عَنْ ہَدِیَّۃِ الْکَعْبَۃِ ، فَقَالَ : إنَّ الْکَعْبَۃَ لَغَنِیَّۃٌ عَنْ ہَدِیَّتِکَ ، أُنْظُر إنْسَانًا فَقِیرًا أَو مِسْکِینًا فَأَطعِمہ کِسرَۃ۔","","Musannaf Ibn Abi Shaybah 12499","","","كتاب الأيمان والنذور والكفارات"
"12500","(۱۲۵۰۰) حدَّثَنَا مُعَمَّرُ بْنُ سُلَیْمَانَ الرَّقِّیُّ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ لاَ یُفَرِّقُ صِیَامَ الْیَمِینِ الثَّلاَثَۃِ أَیَّامٍ۔","Da'if","Musannaf Ibn Abi Shaybah 12500","","","كتاب الأيمان والنذور والكفارات"
"12501","(۱۲۵۰۱) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَن صِیَامِ الثَّلاَثَۃِ أَیَّامٍ فِی کَفَّارَۃِ الْیَمِینِ ، قَالَ فِی قِرَائَتِنَا : {فَصِیَامُ ثَلاَثَۃِ أَیَّامٍ مُتَتَابِعَاتٍ}۔","","Musannaf Ibn Abi Shaybah 12501","","","كتاب الأيمان والنذور والكفارات"
"12502","(۱۲۵۰۲) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کُلُّ صِیَامٍ فِی الْقُرْآنِ مُتَتَابِعٌ إلاَّ قَضَائَ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 12502","","","كتاب الأيمان والنذور والكفارات"
"12503","(۱۲۵۰۳) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَعْفَرٍ ، عَنِ الرَّبِیعِ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : کَانَ أُبَی یَقْرَؤُہَا : {فَصِیَامُ ثَلاَثَۃِ أَیَّامٍ مُتَتَابِعَاتٍ}۔","Hasan","Musannaf Ibn Abi Shaybah 12503","","","كتاب الأيمان والنذور والكفارات"
"12504","(۱۲۵۰۴) حدَّثَنَا وَکِیعٌ، عَنْ سُفیان، عَنْ جابر، عَنْ عامر قَالَ: فی قراء ۃ عبداللہ: {فَصِیَامُ ثَلاَثَۃِ أَیَّامٍ مُتَتَابِعَاتٍ}۔","Da'if","Musannaf Ibn Abi Shaybah 12504","","","كتاب الأيمان والنذور والكفارات"
"12505","(۱۲۵۰۵) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ فِی صَوْمِ کَفَّارَۃِ الْیَمِینِ : یَصُومُہُ مُتَتَابِعًا ، فَإِنْ أَفْطَرَ مِنْ عُذْرٍ قَضَی یَوْمًا مَکَانَ یَوْمٍ۔","","Musannaf Ibn Abi Shaybah 12505","","","كتاب الأيمان والنذور والكفارات"
"12506","(۱۲۵۰۶) حدَّثَنَا حمید بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ لَیْثٍ ، عَنْ عَطَاء ، وطَاوُوس ، وَمُجَاہِدٍ ، قَالُوا : مَا کَانَ سِوَی رَمَضَانَ فَلاَ إلاَّ مُتَتَابِعًا۔","","Musannaf Ibn Abi Shaybah 12506","","","كتاب الأيمان والنذور والكفارات"
"12507","(۱۲۵۰۷) حدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ خُصَیْفٍ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ یَرْفَعُہُ ، قَالَ : أَتَاہُ رَجُلٌ ، فَقَالَ : إنِّی وَقَعْت عَلَی امْرَأَتِی وَہِیَ حَائِضٌ ، فَقَالَ : تَصَدَّقْ بِنِصْفِ دِینَارٍ۔ (ابوداؤد ۲۷۰۔ بیہقی ۳۱۶)","Da'if","Musannaf Ibn Abi Shaybah 12507","","","كتاب الأيمان والنذور والكفارات"
"12508","(۱۲۵۰۸) حدَّثَنَا ہُشَیْمٌ، عَنْ حَجَّاجٍ، عَنْ عَبْدِالْکَرِیمِ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ یَرْفَعُہُ : یَتَصَدَّقُ بِنِصْفِ دِینَارٍ۔","","Musannaf Ibn Abi Shaybah 12508","","","كتاب الأيمان والنذور والكفارات"
"12509","(۱۲۵۰۹) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ رضی اللَّہُ عَنْہُما ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ یَتَصَدَّقُ بِدِینَارٍ ، أَوْ نِصْفِ دِینَارٍ۔n(ابوداؤد ۲۶۸۔ نسائی ۲۸۲)","Sahih","Musannaf Ibn Abi Shaybah 12509","","","كتاب الأيمان والنذور والكفارات"
"12510","(۱۲۵۱۰) حدَّثَنَا مُعْتَمِرٌ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : أَتَی رَجُلٌ أَبَا بَکْرٍ ، فَقَالَ : إنِّی رَأَیْت فِی النَّوْمِ کَأَنِّی أَبُولُ دَمًا ، فَقَالَ : أَرَاک تَأْتِی الْمَرْأَۃَ وَہِیَ حَائِضٌ ، قَالَ : نَعَمْ ، قَالَ : اتَّقِ اللَّہَ ، وَلاَ تَعُدْ۔","","Musannaf Ibn Abi Shaybah 12510","","","كتاب الأيمان والنذور والكفارات"
"12511","(۱۲۵۱۱) حدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَقَعُ عَلَی امْرَأَتِہِ وَہِیَ حَائِضٌ ، قَالَ : یَتَصَدَّقُ بِدِینَارٍ ، أَوْ نِصْفِ دِینَارٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12511","","","كتاب الأيمان والنذور والكفارات"
"12512","(۱۲۵۱۲) حدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ یَعْقُوبَ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یَسْتَغْفِرُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 12512","","","كتاب الأيمان والنذور والكفارات"
"12513","(۱۲۵۱۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَأْتِی امْرَأَتَہُ وَہِیَ حَائِضُ ، قَالَ : ذَنْبٌ أَتَاہُ ، یَسْتَغْفِرُ اللَّہَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 12513","","","كتاب الأيمان والنذور والكفارات"
"12514","(۱۲۵۱۴) حدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إسْمَاعِیلُ ، عَنِ الشَّعْبِیِّ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 12514","","","كتاب الأيمان والنذور والكفارات"
"12515","(۱۲۵۱۵) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : یَسْتَغْفِرُ اللَّہَ ، قَالَ : وَکَانَ الْحَسَنُ یَرَی عَلَیْہِ مَا یَرَی عَلَی الْمُظَاہِرِ۔","","Musannaf Ibn Abi Shaybah 12515","","","كتاب الأيمان والنذور والكفارات"
"12516","(۱۲۵۱۶) حدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : مَنْ وَطِئَ امْرَأَتَہُ وَہِیَ حَائِضٌ ، نَرَی عَلَیْہِ مَا عَلَی الْمُظَاہِرِ۔","","Musannaf Ibn Abi Shaybah 12516","","","كتاب الأيمان والنذور والكفارات"
"12517","(۱۲۵۱۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ؛ فِی الرَّجُلِ یَأْتِی امْرَأَتَہُ وَہِیَ حَائِضٌ ، قَالَ : یَعْتَذِرُ ، ویَتُوبُ إلَی اللہِ۔","","Musannaf Ibn Abi Shaybah 12517","","","كتاب الأيمان والنذور والكفارات"
"12518","(۱۲۵۱۸) حدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُثَنًّی ، عَنْ عَطَائٍ ، قَالَ : یَسْتَغْفِرُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 12518","","","كتاب الأيمان والنذور والكفارات"
"12519","(۱۲۵۱۹) حدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لِابْنِ عَبَّاسٍ : الرَّجُلُ یَقَعُ عَلَی امْرَأَتِہِ وَہِیَ حَائِضٌ ، قَالَ : یَتَصَدَّقُ بِدِینَارٍ۔","Da'if","Musannaf Ibn Abi Shaybah 12519","","","كتاب الأيمان والنذور والكفارات"
"12520","(۱۲۵۲۰) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ ، وَلَکِنْ لاَ یَعُدْ۔","","Musannaf Ibn Abi Shaybah 12520","","","كتاب الأيمان والنذور والكفارات"
"12521","(۱۲۵۲۱) حدَّثَنَا غنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، قَالَ : ذَنْبٌ یَسْتَغْفِرُ اللَّہَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 12521","","","كتاب الأيمان والنذور والكفارات"
"12522","(۱۲۵۲۲) حدَّثَنَا حمید بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی بِشْرٍ الحُبلی ، عَنْ أَبِی حُرَّۃَ ، أَنَّ عُمَرَ سَأَلَ عَلِیًّا مَا تَرَی فِی رَجُلٍ وَقَعَ عَلَی امْرَأَتِہِ وَہِیَ حَائِضٌ ؟ قَالَ : لَیْسَ عَلَیْہِ کَفَّارَۃٌ إلاَّ أَنْ یَتُوبَ۔","Da'if","Musannaf Ibn Abi Shaybah 12522","","","كتاب الأيمان والنذور والكفارات"
"12523","(۱۲۵۲۳) حدَّثَنَا أبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ حَلَفَ أَنْ لاَ یَصِلَ رَحِمَہُ ، قَالَ : یَصِلُ رَحِمَہُ وَیُکَفِّرُ یَمِینَہُ ، قَالَ : وَقَالَ الشَّعْبِیُّ : یَصِلُ رَحِمَہُ ، وَلاَ یُکَفِّرُ یَمِینَہُ ، وَلَوْ أَمَرْتہ أَنْ یُکَفِّرَ یَمِینَہُ ، أَمَرْتہ أَنْ یُتِمَّ عَلَی قَوْلِہِ۔","","Musannaf Ibn Abi Shaybah 12523","","","كتاب الأيمان والنذور والكفارات"
"12524","(۱۲۵۲۴) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ کَثِیرِ بْنِ نَبَاتَۃَ سَمِعَہُ یُحَدِّثُ ، أَنَّ أَخَوَیْنِ کَانَا شَرِیکَیْنِ ، وَأَنَّ أَحَدَہُمَا أَرَادَ مُفَارَقَۃَ أَخِیہِ ، فَقَالَ : کل مَمْلُوکٌ لَہُ حُرٌّ ، أَوْ عَتِیقٌ إِنْ لَمْ یُفَارِقْ أَخَاہُ وَإِنَّ أُمَّہُ أَمَرَتْہُ أَنْ لاَ یُفَارِقَ أَخَاہُ ، فَسَأَلْت الْحَسَنَ ، أَوْ سُئِلَ وَہُوَ یَسْمَعُ ذَلِکَ ، فَقَالَ : لِیُکَفِّرْ یَمِینَہُ وَیَصِلْ رَحِمَہُ ویُشَارِکُ أَخَاہُ ، أَوْ کَمَا قَالَ : قَالَ أَبُو الْعَلاَئِ کَثِیرٌ : فَحَدَّثت بِہِ الْحَکَمُ بْنُ أَبَانَ ، فَقَالَ : ہَذَا قَوْلُ طَاوُوس۔","","Musannaf Ibn Abi Shaybah 12524","","","كتاب الأيمان والنذور والكفارات"
"12525","(۱۲۵۲۵) حدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ حَلَفَ أن لاَ یُکَلِّمُ أَبَاہُ وَأَخَاہُ شَہْرَیْنِ ، قَالَ : یلطفہ وَیَدْخُلُ عَلَیْہِ ، وَلاَ یُکَلِّمُہُ۔","","Musannaf Ibn Abi Shaybah 12525","","","كتاب الأيمان والنذور والكفارات"
"12526","(۱۲۵۲۶) حدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، وَعَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَأْتِی امْرَأَتَہُ وَہِیَ تَقْضِی شَہْرَ رَمَضَانَ ، قَالاََ : لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 12526","","","كتاب الأيمان والنذور والكفارات"
"12527","(۱۲۵۲۷) حدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، عَنْ شُرَیْحٍ ، أَنَّ رَجُلاً اسْتَوْدَعَہُ مَالاً وَکَانَ لِلسُّلْطَانِ عِنْدَ ذَلِکَ الرَّجُلِ بُغْیَۃٌ ، فَقَالَ لِشُرَیْحٍ : إنَّا نَسْتَحْلِفُک ، قَالَ : کُنْتُ أَدْفَعُ ، عَنْ مَالِہِ مَا اسْتَطَعْت مَا لَمَ اضطَرَّ إلَی الْیَمِینِ۔","","Musannaf Ibn Abi Shaybah 12527","","","كتاب الأيمان والنذور والكفارات"
"12528","(۱۲۵۲۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَسْتَحْلِفُہُ السُّلْطَانُ عَلَی أَنْ یَدُلَّ عَلَی رَجُلٍ مُسْلِمٍ ، أَوْ عَلَی مَالِہِ ، فَقَالَ : یَحْلِفُ وَیُکَفِّرُ یَمِینَہُ۔","","Musannaf Ibn Abi Shaybah 12528","","","كتاب الأيمان والنذور والكفارات"
"12529","(۱۲۵۲۹) حدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یُحَلِّلُ یَمِینَہُ بِضَرْبٍ دُونَ ضَرْبٍ ، أَوْ ضَرْبٍ أَدْنَی مِنْ ضَرْبٍ۔","","Musannaf Ibn Abi Shaybah 12529","","","كتاب الأيمان والنذور والكفارات"
"12530","(۱۲۵۳۰) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ الأَحْوَلِ ، عَنْ أَبِی مَعْبَدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ حَلَفَ عَلَی مِلْکِ یَمِینِہِ لَیَضْرِبَنَّہُ فَکَفَّارَتُہُ تَرْکُہُ وَلَہُ مِنَ الْکَفَّارَۃِ حَسنَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 12530","","","كتاب الأيمان والنذور والكفارات"
"12531","(۱۲۵۳۱) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ فِی رَجُلٍ نَذَرَ أَنْ یَضْرِبَ غُلاَمَہُ ثَلاَثِینَ سَوْطًا ، أَوْ أَکْثَرَ ، قَالَ : یَجْمَعُہَا فَیَضْرِبُہُ ضَرْبَۃً وَاحِدَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 12531","","","كتاب الأيمان والنذور والكفارات"
"12532","(۱۲۵۳۲) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ فِی الْمُظَاہِرِ جَامَعَ فِی آخِرِ اللَّیْلِ ، أَوِ النَّہَارِ ، قَالَ : یَسْتَقْبِلُ الصَّوْمَ۔","","Musannaf Ibn Abi Shaybah 12532","","","كتاب الأيمان والنذور والكفارات"
"12533","(۱۲۵۳۳) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ ابن رَبَاحٍ، عَنْ مُجَاہِدٍ فِی رَجُلٍ حَلَفَ بِالإِحْرَامِ، قَالَ: لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 12533","","","كتاب الأيمان والنذور والكفارات"
"12534","(۱۲۵۳۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْمِنْہَالِ ، عَنْ أَبِی وَائِلٍ ، قَالَ : کفارۃ یَمِینٍ۔","","Musannaf Ibn Abi Shaybah 12534","","","كتاب الأيمان والنذور والكفارات"
"12535","(۱۲۵۳۵) مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ حَسَّانَ بْنِ أَبِی یَحْیَی ، قَالَ : سَمِعْتُ عِکْرِمَۃَ وَسَأَلَہُ رَجُلٌ ، فَقَالَ : إنِّی حَلَفْت لِامْرَأَتِی بِعَشْرِ حِجَجٍ إِنْ أَنَا وَطِئْت جَارِیَۃً لِی ، فَقَالَ : عِکْرِمَۃُ : لَوْ وفیت بِہَا کَانَتْ لِلشیْطَانِ ، اذْہَبْ فَإِنَّمَا ہِیَ یمین تُکَفِّرُہَا۔","","Musannaf Ibn Abi Shaybah 12535","","","كتاب الأيمان والنذور والكفارات"
"12536","(۱۲۵۳۶) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ وَجَابِرِ بْنِ زَیْدٍ ، قَالاَ : إذَا قَالَ : ہُوَ مُحْرِمٌ بِحَجَّۃٍ کَفَّرَ یَمِینَہُ۔","","Musannaf Ibn Abi Shaybah 12536","","","كتاب الأيمان والنذور والكفارات"
"12537","(۱۲۵۳۷) حدَّثَنَا الْمُحَارِبِیُّ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ؛ فِی رَجُلٍ ، قَالَ: عَلَیْہِ أَلْفُ حَجَّۃٍ ، قَالَ : عَلَیْہِ کَفَّارَۃُ یَمِینٍ۔","","Musannaf Ibn Abi Shaybah 12537","","","كتاب الأيمان والنذور والكفارات"
"12538","(۱۲۵۳۸) حدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَقُولُ : ہُوَ مُحْرِمٌ بِأَلْفِ حَجَّۃٍ ، یَحُجُّ مَا اسْتَطَاعَ۔","","Musannaf Ibn Abi Shaybah 12538","","","كتاب الأيمان والنذور والكفارات"
"12539","حدَّثَنَا عَبْدُ اللہِ بْنُ مُحَمَّدٍ ، قَالَ :n(۱۲۵۳۹) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ أَنْ یَقُولَ : وَإِنِّی سَآتِیک وَاللَّہِ حَیْثُ کَانَ ، قَالَ : فَإِنَّ اللَّہُ بِکُلِّ مَکَان۔","","Musannaf Ibn Abi Shaybah 12539","","","كتاب الأيمان والنذور والكفارات"
"12540","(۱۲۵۴۰) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، أَنَّ ابْنَ عُمَرَ کَانَ یَکْرَہُ أَنْ یَسْمَعَ الرَّجُلَ یَقُولُ : لاَ وَاللَّہِ حَیْثُ کَانَ ، فَإِنَّہُ بِکُلِّ مَکَان۔","Sahih","Musannaf Ibn Abi Shaybah 12540","","","كتاب الأيمان والنذور والكفارات"
"12541","(۱۲۵۴۱) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، عَنْ أَبِی الْبَخْتَرِیِّ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ : لاَ یَأْتِی شانئک۔","","Musannaf Ibn Abi Shaybah 12541","","","كتاب الأيمان والنذور والكفارات"
"12542","(۱۲۵۴۲) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : لاَ یَقُلْ أَحَدُکُمْ بِأَبِی رَبی، فَإِنَّہُ لاَ یَفْدِیہِ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 12542","","","كتاب الأيمان والنذور والكفارات"
"12543","(۱۲۵۴۳) حدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ رَجُلٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو فِی رَجُلٍ نَذَرَ أَنْ یَزُمَّ أَنْفَہُ ، قَالَ : یُکَفِّرُ عَنْ یَمِینِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 12543","","","كتاب الأيمان والنذور والكفارات"
"12544","(۱۲۵۴۴) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ الضُّبَعِیِّ ، أَنَّ رَجُلاً مِنْ بَنِی سُلَیْمٍ نَذَرَ أَنْ یَزُمَّ أَنْفَہُ ، فَقَالَ : ابْنُ عَبَّاسٍ ، النَّذْرُ نَذْرَانِ ، فَمَا کَانَ لِلَّہِ فَفِیہِ الْوَفَائُ ، وَمَا کَانَ لِلشَّیْطَانِ فَفِیہِ الْکَفَّارَۃُ ، أَطْلِقْ زِمَامَک وَکَفِّرْ یَمِینَک۔","Sahih","Musannaf Ibn Abi Shaybah 12544","","","كتاب الأيمان والنذور والكفارات"
"12545","(۱۲۵۴۵) حدَّثَنَا أبُو أُسَامَۃَ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سَأَلْتُ جَابِرَ بْنَ زَیْدٍ ، عَنْ رَجُلٍ نَذَرَ أَنْ یَجْعَلَ فِی أَنْفِہِ حَلَقَۃً مِنْ ذَہَبٍ ؟ قَالَ : لاَ یَزَالُ عَاصِیًا مَا دَامَتْ عَلَیْہِ ، فَمُرْہُ فَلْیُکَفِّرْ یَمِینَہُ۔","","Musannaf Ibn Abi Shaybah 12545","","","كتاب الأيمان والنذور والكفارات"
"12546","(۱۲۵۴۶) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَجْعَلُ عَلَی أَنْفِہِ أَنْ یَزُمَّہَا وَیَحُجَّ مَاشِیًا ، قَالَ : قدْ نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُثْلَۃِ ، انْزِعْ ہَذَا وَحُجَّ رَاکِبًا وَانْحَرْ بَدَنَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 12546","","","كتاب الأيمان والنذور والكفارات"
"12547","(۱۲۵۴۷) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؟ قَالَ : لاَ زِمَامَ ، وَلاَ خِزَامَ ، وَلاَ نِیَاحَۃَ ، یَعْنِی فِی الإِسْلاَمِ۔","","Musannaf Ibn Abi Shaybah 12547","","","كتاب الأيمان والنذور والكفارات"
"12548","(۱۲۵۴۸) حدَّثَنَا أبُو خَالِدٍ الأَحْمَرِِ ، وَابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ زَحْرٍ ، عَنْ أَبِی سَعِیدٍ الرُّعَیْنِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مَالِکٍ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ الْجُہَنِیِّ ، قَالَ : نَذَرَتْ أُخْتِی أَنْ تَمْشِیَ حَافِیَۃً إلَی بَیْتِ اللہِ غَیْرَ مُخْتَمِرَۃٍ ، فَسَأَلَتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : مُرْ أُخْتَکَ فَلْتَخْتَمِرْ وَلْتَرْکَبْ وَلْتَصُمْ ثَلاَثَۃَ أَیَّامٍ۔ (بخاری ۱۸۶۶۔ مسلم ۱۲۶۴)","Hasan","Musannaf Ibn Abi Shaybah 12548","","","كتاب الأيمان والنذور والكفارات"
"12549","(۱۲۵۴۹) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ رَأَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یُہَادَی بَیْنَ ابْنَیْہِ ، فَقَالَ : مَا ہَذَا ؟ فَقَالُوا : نَذَرَ أَنْ یَمْشِیَ إلَی بَیْتِ اللہِ ، فَقَالَ : إنَّ اللَّہَ لَغَنِیٌّ ، عَنْ تَعْذِیبِ ہَذَا نَفْسَہُ ، ثُمَّ أَمَرَہُ فَرَکِبَ۔ (بخاری ۱۸۶۵۔ مسلم ۹)","Sahih","Musannaf Ibn Abi Shaybah 12549","","","كتاب الأيمان والنذور والكفارات"
"12550","(۱۲۵۵۰) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، وَعَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ عُرْوَۃَ بْنِ أُذَیْنَۃَ ، قَالَ عُبَیْدُ اللہِ جَدّتَہُ ، وَقَالَ : مَالِکٌ : إنَّ أُمَّہُ جَعَلَتْ عَلَیْہَا الْمَشْیَ فَمَشَتْ حَتَّی انْتَہَتْ إلَی السُّقْیَا ، ثُمَّ عَجَزَتْ فَمَا مَشَتْ ، فَسَأَلْت ابْنَ عُمَرَ ، فَقَالَ : مُرُوہَا أَنْ تَعُودَ مِنَ الْعَامِ الْمُقْبِلِ فَتَمْشِیَ مِنْ حَیْثُ عَجَزَتْ۔","Hasan","Musannaf Ibn Abi Shaybah 12550","","","كتاب الأيمان والنذور والكفارات"
"12551","(۱۲۵۵۱) حدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ سُئِلَ عَنْ رَجُلٍ نَذَرَ أَنْ یَمْشِیَ إلَی الْکَعْبَۃِ ، فَمَشَی نِصْفَ الطَّرِیقِ وَرَکِبَ نِصْفَہُ قَالَ : فَقَالَ عامر : قَالَ ابْنُ عَبَّاسٍ : یَرْکَبُ مَا مَشَی وَیَمْشِی مَا رَکِبَ مِنْ قَابِلٍ ، وَیُہْدِی بَدَنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 12551","","","كتاب الأيمان والنذور والكفارات"
"12552","(۱۲۵۵۲) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ عَلِیٍّ ، قَالَ : من قَالَ عَلَیْہِ الْمَشْیُ إِنْ شَائَ رَکِبَ وَأَہْدَی۔","Sahih","Musannaf Ibn Abi Shaybah 12552","","","كتاب الأيمان والنذور والكفارات"
"12553","(۱۲۵۵۳) حدَّثَنَا عَبْدُ الرَّحِیمِ ، وَأَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ؛ فِی الرَّجُلِ یَجْعَلُ عَلَیْہِ الْمَشْیَ إلَی بَیْتِ اللہِ ، قَالَ عَبْدُ الرَّحِیمِ : یَرْکَبُ وَیُہْرِیقُ دَمًا ، وَقَالَ : أَبُو خَالِدٍ : یُہْدِی بَدَنَۃً۔","","Musannaf Ibn Abi Shaybah 12553","","","كتاب الأيمان والنذور والكفارات"
"12554","(۱۲۵۵۴) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنِ الأَجْلَحِ ، عَنْ عَمْرِو بْنِ سَعِیدٍ الْبَجَلِیِّ ، قَالَ : کُنْتُ تَحْتَ مِنْبَرِ ابْنِ الزُّبَیْرِ وَہُوَ عَلَیْہِ ، فَجَائَ رَجُلٌ ، وَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ إنِّی نَذَرْت أَنْ أَحُجَّ مَاشِیًا ، حَتَّی إذَا کَانَ کَذَا وَکَذَا ومَشَیْت خَشِیت أَنْ یَفُوتَنِی الْحَجُّ ، رَکِبْت ، قَالَ : لاَ خَطَأَ عَلَیْک ، ارْجِعْ عَامَ قَابِلٍ فَامْشِ مَا رَکِبْت وَارْکَبْ مَا مَشَیْت۔","Da'if","Musannaf Ibn Abi Shaybah 12554","","","كتاب الأيمان والنذور والكفارات"
"12555","(۱۲۵۵۵) حدَّثَنَا أبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ نَذَرَ أَنْ یَحُجَّ مَاشِیًا ، قَالَ : یَمْشِی ، فَإِنَ انْقَطَعَ رَکِبَ وَأَہْدَی بَدَنَۃً۔","","Musannaf Ibn Abi Shaybah 12555","","","كتاب الأيمان والنذور والكفارات"
"12556","(۱۲۵۵۶) حدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : سَمِعْتُ الْقَاسِمَ وَسُئِلَ عَنْ رَجُلٍ حَلَفَ أَنْ یَمْشِیَ إلَی الْبَیْتِ ، فَمَشَی ، فَعَیِیَ فَرَکِبَ ، قَالَ : إذَا کَانَ قَابِلٌ فَلْیَمْشِ مَا رَکِبَ وَلیَرْکَبْ مَا مَشَی ، قَالَ : وَسَمِعْت یَزِیدَ بْنَ عَبْدِ اللہِ بْنِ قُسَیْطٍ یَقُولُ : یَرْکَبُ وَیُہْدِی بَدَنَۃً۔","","Musannaf Ibn Abi Shaybah 12556","","","كتاب الأيمان والنذور والكفارات"
"12557","(۱۲۵۵۷) حدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ یَکُونُ عَلَیْہِ مَشْیٌ إلَی الْبَیْتِ ، فَیَمْشِی ، ثُمَّ یُعَیِّی ، قَالَ : یَرْکَبُ ، فَإِذَا کَانَ قَابِلٌ رَکِبَ مَا مَشَی ، وَمَشَی مَا رَکِبَ۔","","Musannaf Ibn Abi Shaybah 12557","","","كتاب الأيمان والنذور والكفارات"
"12558","(۱۲۵۵۸) حدَّثَنَا أبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الرَّجُلِ یَقُولُ عَلَیَّ الْمَشْیُ إلَی الْکَعْبَۃِ ، قَالَ : ہَذَا نَذْرٌ ، فَلْیَمْشِ۔","Sahih","Musannaf Ibn Abi Shaybah 12558","","","كتاب الأيمان والنذور والكفارات"
"12559","(۱۲۵۵۹) حدَّثَنَا حمَّادُ بْنُ خَالِدٍ الْخَیَّاطُ ، عَنْ مُحَمَّدِ بْنِ ہِلاَلٍ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : مَنْ قَالَ عَلَیَّ الْمَشْیُ إلَی بَیْتِ اللہِ ، فَلَیْسَ بِشَیْئٍ إلاَّ أَنْ یَقُولَ : عَلَیَّ نَذْرُ مَشْیٍ إلَی الْکَعْبَۃِ۔","","Musannaf Ibn Abi Shaybah 12559","","","كتاب الأيمان والنذور والكفارات"
"12560","(۱۲۵۶۰) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : جَعَلَ رَجُلٌ مِنَّا عَلَیْہِ الْمَشْیَ إلَی الْبَیْتِ فی شَیء فَأَتَی الْقَاسِمَ فَسَأَلَہُ عَنْ ذَلِکَ ، فَقَالَ : یَمْشِی إلَی الْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 12560","","","كتاب الأيمان والنذور والكفارات"
"12561","(۱۲۵۶۱) حدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ یَزِیدَ أبی إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : إذَا قَالَ الرَّجُلُ : لِلَّہِ عَلَیَّ ، أَوْ عَلَیْہِ حَجَّۃٌ فَسَوَائٌ ، وَإذَا قَالَ : لِلَّہِ عَلَیَّ نَذْرٌ ، أو عَلَیَّ للہ ، فَسَوَائٌ۔","","Musannaf Ibn Abi Shaybah 12561","","","كتاب الأيمان والنذور والكفارات"
"12562","(۱۲۵۶۲) حدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ عُمَرَ بْنِ زَیْدٍ ، قَالَ : جَائَ رَجُلاَنِ إلَی الْقَاسِمِ فَسَأَلاَہُ وَأَنَا أَسْمَعُ ، عَنْ رَجُلٍ جَعَلَ عَلَیْہِ الْمَشْیَ إلَی بَیْتِ اللہِ ، قَالَ : فَقَالَ الْقَاسِمُ : أَنَذْرٌ ؟ قَالَ : لاَ قَالَ : فَلْیُکَفِّرْ یَمِینَہُ۔","","Musannaf Ibn Abi Shaybah 12562","","","كتاب الأيمان والنذور والكفارات"
"12563","(۱۲۵۶۳) حدَّثَنَا حفص ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ رضی اللَّہُ عَنْہُ ، قَالَ : نَذَرْت نَذْرًا فِی الْجَاہِلِیَّۃِ ، ثُمَّ أَسْلَمْت ، فَسَأَلْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَمَرَنِی أَنْ أُوفِی نَذْرِی۔n(بخاری ۲۰۴۲۔ ابوداؤد ۳۳۱۸)","Sahih","Musannaf Ibn Abi Shaybah 12563","","","كتاب الأيمان والنذور والكفارات"
"12564","(۱۲۵۶۴) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ قَالَ : کُلُّ یَمِینٍ حلف بہا ہی للہ برۃ یوفی بہا فی الإسلام۔","","Musannaf Ibn Abi Shaybah 12564","","","كتاب الأيمان والنذور والكفارات"
"12565","(۱۲۵۶۵) حدَّثَنَا حَفْص ، عَنْ لَیْثٍ ، عَنْ طَاوُوس فِی رَجُلٍ نَذَرَ فِی الْجَاہِلِیَّۃِ ، ثُمَّ أَسْلَمَ ، قَالَ : یُوفِی بنذْرِہِ۔","","Musannaf Ibn Abi Shaybah 12565","","","كتاب الأيمان والنذور والكفارات"
"12566","(۱۲۵۶۶) حدَّثَنَا وَکِیعٌ ، عَنِ الْہُذَلِیِّ ، أَنَّ امْرَأَۃً نَذَرَتْ أَنْ تُسْرج فِی بَیْعَۃٍ وَہِیَ نَصْرَانِیَّۃٌ ، فَأَسْلَمَتْ فَأَرَادَتْ أَنْ تُوْفِیَ بنذْرِہَا ، قَالَ الْحَسَنُ وَقَتَادَۃُ : تُسْرج فِی مَسَاجِدِ الْمُسْلِمِینَ ، وَقَالَ ابْنُ سِیرِینَ : لَیْسَ عَلَیْہَا شَیْئٌ ، فَعَرَضْت أَقَاوِیلَہُمْ عَلَی الشَّعْبِیِّ ، فَقَالَ : أَصَابَ الأَصَمُّ وَأَخْطَأَ صَاحِبَاکَ ، ہَدَمَ الإِسْلاَمُ مَا کَانَ قَبْلَہُ۔","","Musannaf Ibn Abi Shaybah 12566","","","كتاب الأيمان والنذور والكفارات"
"12567","(۱۲۵۶۷) حدَّثَنَا غنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ نَہَی عَنِ النَّذْرِ ، وَقَالَ : أَنَّہُ لاَ یَأْتِی بِخَیْرٍ ، وَإِنَّمَا یُسْتَخْرَجُ بِہِ مِنَ الْبَخِیلِ۔ (بخاری ۶۶۰۸۔ مسلم ۲)","Sahih","Musannaf Ibn Abi Shaybah 12567","","","كتاب الأيمان والنذور والكفارات"
"12568","(۱۲۵۶۸) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ جَدِّہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إیَّاکُمْ وَالنَّذْرَ ، فَإِنَّ اللَّہَ لاَ یُنْعِمُ نِعْمَۃً عَلَی الرُّشَا ، وَإِنَّمَا ہُوَ شَیْئٌ یُسْتَخْرَجُ بِہِ مِنَ الْبَخِیلِ۔ (بخاری ۶۶۹۴۔ ابوداؤد ۳۲۸۱)","Da'if","Musannaf Ibn Abi Shaybah 12568","","","كتاب الأيمان والنذور والكفارات"
"12569","(۱۲۵۶۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّہُ قَالَ : لاَ أَنْذِرُ نَذْرًا أَبَدًا۔","Da'if","Musannaf Ibn Abi Shaybah 12569","","","كتاب الأيمان والنذور والكفارات"
"12570","(۱۲۵۷۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَتَلَ الْمُسْلِمُ الذِّمِّیَّ فَلَیْسَ عَلَیْہِ کَفَّارَۃٌ۔","","Musannaf Ibn Abi Shaybah 12570","","","كتاب الأيمان والنذور والكفارات"
"12571","(۱۲۵۷۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عن قیس ، عَنِ الشَّعْبِیِّ فِی الْمُسْلِمِ یَقْتُلُ الذِّمِّیَّ خَطَأً ، قَالَ : کَفَّارَتُہُمَا سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 12571","","","كتاب الأيمان والنذور والكفارات"
"12572","(۱۲۵۷۲) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا دَاوُد بْنُ أَبِی ہِنْدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ: مَرَّتْ رُفْقَۃٌ مِنْ أَہْلِ الشَّامِ، فَاشْتَرَوْا جَارِیَۃً فَأَعْتَقُوہَا ، فَطَرَحَتْ طُنًّا مِنْ قَصَبٍ عَلَی صَبِیٍّ فَقَتَلَتْہُ ، فَأُتِیَ بِہَا مَسْرُوقٌ ، فَقَالَ : الْتَمِسُوا أَوْلِیَائَہَا ، فَلَمْ یَجِدُوا أَحَدًا ، فَنَظَرَ سَاعَۃً وَتَفَکَّرَ ، وَقَالَ : قَالَ اللَّہُ : {فَمَنْ لَمْ یَجِدْ فَصِیَامُ شَہْرَیْنِ مُتَتَابِعَیْنِ} اذْہَبِی فَصُومِی شَہْرَیْنِ مُتَتَابِعَیْنِ ، وَلاَ شَیْئَ لَہُمْ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 12572","","","كتاب الأيمان والنذور والكفارات"
"12573","(۱۲۵۷۳) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : طَرَحَتْ جَارِیَۃٌ طُنًّا مِنْ قَصَبٍ عَلَی صَبِیٍّ فَقَتَلَتْہُ ، فَأُتِیَ مَسْرُوقٌ فی ذَلِکَ ، فَقَالَ : ہَلْ یعلم لَہَا مِنْ مَوَالٍ ؟ قَالُوا : لاَ نَدْرِی مَنْ مَوَالِیہَا ، قَالَ : فَہَلْ لَہَا مَالٌ ؟ قَالُوا : مَا یعْلَمُ لَہَا مَالاً ، قَالَ : فَمُرُوہَا أَنْ تَصُومَ شَہْرَیْنِ مُتَتَابِعَیْنِ۔","","Musannaf Ibn Abi Shaybah 12573","","","كتاب الأيمان والنذور والكفارات"
"12574","(۱۲۵۷۴) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : سُئِلَ مَسْرُوقٌ ، عَنْ ہَذِہِ الآیَۃِ : {وَمَنْ قَتَلَ مُؤْمِنًا خَطَأً فَتَحْرِیرُ رَقَبَۃٍ مُؤْمِنَۃٍ وَدِیَۃٌ مُّسَلَّمَۃٌ إلَی أَہْلِہِ} {فَمَنْ لَمْ یَجِدْ فَصِیَامُ شَہْرَیْنِ مُتَتَابِعَیْنِ} : فَسُئِلَ عَنْ صِیَامِ شَہْرَیْنِ عَنِ الرَّقَبَۃِ وَحْدَہَا ، أَوْ عَنِ الدِّیَۃِ وَالرَّقَبَۃِ ، فَقَالَ : مَنْ لَمْ یَجِدْ فَہُوَ عن الدِّیَۃِ وَالرَّقَبَۃِ۔","","Musannaf Ibn Abi Shaybah 12574","","","كتاب الأيمان والنذور والكفارات"
"12575","(۱۲۵۷۵) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ الْفَزَارِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَانِ الطَّائِفِیِّ ، عَنْ مَیْمُونَۃَ بِنْتِ کَرَدْمِ الْیَسَارِیَّۃِ ، أَنَّ أَبَاہَا لَقِیَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہِیَ رَدِیفَۃٌ لَہُ ، فَسَأَلَہُ ، فَقَالَ : إنِّی نَذَرْت أَنْ أَنْحَرَ بِبُوَانَۃَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَلْ بِہَا وَثَنٌ ؟ قَالَتْ : قَالَ أَبِی : لاَ ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَأَوْفِ نَذْرِکَ حَیْثُ نذَرْتَ۔ (ابوداؤد ۳۳۰۲۔ احمد ۶/۳۶۶)","","Musannaf Ibn Abi Shaybah 12575","","","كتاب الأيمان والنذور والكفارات"
"12576","(۱۲۵۷۶) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَبِیبٍ الْمُعَلِّمِ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، أَنَّ رَجُلاً نَذَرَ أَنْ یُصَلِّیَ فِی بَیْتِ الْمَقْدِسِ ، فَسَأَلَ عَنْ ذَلِکَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ لَہُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلِّ ہُنَا ، یَعْنِی فِی الْمَسْجِدِ الْحَرَامِ ، فَأَعَادَ عَلَیْہِ ثَلاَثًا ، فَقَالَ : صَلِّ حَیْثُ قلت۔n(ابوداؤد ۳۲۹۸۔ احمد ۳/۳۶۳)","Sahih","Musannaf Ibn Abi Shaybah 12576","","","كتاب الأيمان والنذور والكفارات"
"12577","(۱۲۵۷۷) حدَّثَنَا حفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : سُئِلَ عَنْ رَجُلٍ نَذَرَ أَنْ یَأْتِیَ بَیْتَ الْمَقْدِسِ ، فَقَالَ : إِنْ عَدَلَہُ إلَی الْمَسْجِدِ الْحَرَامِ کَانَ أَوْفَی۔","","Musannaf Ibn Abi Shaybah 12577","","","كتاب الأيمان والنذور والكفارات"
"12578","(۱۲۵۷۸) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ نَذَرَ أَنْ یَحُجَّ إلَی الْمَدَائِنِ، قَالَ : لِیُکَفِّرْ عَنْ یَمِینِہِ ، وَلاَ یَذْہَبْ إلَی الْمَدَائِنِ۔","","Musannaf Ibn Abi Shaybah 12578","","","كتاب الأيمان والنذور والكفارات"
"12579","(۱۲۵۷۹) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ فِی رَجُلٍ نَذَرَ أَنْ یَمْشِیَ إلَی الرُّسْتَاقِ ، قَالَ : یَمْشِی۔","","Musannaf Ibn Abi Shaybah 12579","","","كتاب الأيمان والنذور والكفارات"
"12580","(۱۲۵۸۰) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، قَالَ : سُئِلَ عَطَائٌ ، عَنْ رَجُلٍ جَعَلَ عَلَیْہِ أَنْ یُصَلِّیَ فِی مَسْجِدِ إیلِیَائَ کَذَا وَکَذَا رَکْعَۃً ، قَالَ : لِیُصَلِّ عَدَدَ ذَلِکَ فِی الْمَسْجِدِ الْحَرَامِ ، فَإِنَّہُ یُجْزِئُ عَنْہُ ، وَالصَّلاَۃُ فِی الْمَسْجِدِ الْحَرَامِ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 12580","","","كتاب الأيمان والنذور والكفارات"
"12581","(۱۲۵۸۱) حدَّثَنَا أبُو أُسَامَۃَ ، عَنِ أَشْعَث ، عَنِ الْحَسَنِ ؛ فِی امْرَأَۃٍ نَذَرَتْ أَنْ تَأْتِیَ مَکَانًا قَدْ سَمتہُ ، قَالَ : لِتَنْظُرَ قَدْرَ نَفَقَتِہَا ، فَتَصَدَّقَ بہ ، وَلاَ تَأْتِیہِ۔","","Musannaf Ibn Abi Shaybah 12581","","","كتاب الأيمان والنذور والكفارات"
"12582","(۱۲۵۸۲) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَرْوَانَ بْنِ مَاہَانَ التَّیْمِیِّ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ وَسُئِلَ عَنِ امْرَأَۃٍ نَذَرَتْ أَنْ تَنْحَرَ بَقَرَۃً ، أَلَہَا أَنْ تَبِیعَ جِلْدَہَا ؟ فَقَالَ : نَعَمْ ، فَقَالَ ابْنُ أَشْوَعَ : لَکِنِّی لَسْت أَدْرِی ذَلِکَ ، فَقَالَ الشَّعْبِیُّ : لَوْ قُلْتُ لَحْمُہَا لَمْ یَکُنْ بِہِ بَأْسٌ ، إنَّمَا نَذَرَتْ دَمَہَا فَقَدْ أَہْرَقَتْ دَمَہَا۔","","Musannaf Ibn Abi Shaybah 12582","","","كتاب الأيمان والنذور والكفارات"
"12583","(۱۲۵۸۳) حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی ہِلاَلٍ ، قَالَ : نَذَرَتْ أُمِّی إِنْ رَأَتْ فِی وَجْہِی شَعَرَۃً أَنْ تَنْحَرَ بَدَنَۃً ، أَوْ قَالَ : ہَدْیًا ، قَالَ : وَکَانَ الْحَیُّ یَذْبَحُونَ الْبَقَرَۃَ ، قَالَ : فَأَتَیْت شُرَیْحًا فَسَأَلْتُہُ فَسَوَّی بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 12583","","","كتاب الأيمان والنذور والكفارات"
"12584","(۱۲۵۸۴) حدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ جَعَلَ عَلَیْہِ بَدَنَۃً لِلْمَسَاکِینِ ، قَالَ : یُجْزِیہِ بَقَرَۃٌ۔","","Musannaf Ibn Abi Shaybah 12584","","","كتاب الأيمان والنذور والكفارات"
"12585","(۱۲۵۸۵) حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِیُّ ، عَنْ مُوسَی بْنِ مَعبَد ، أَنَّہُ کَانَ عَلَی امْرَأَۃٍ مِنْ أَہْلِہِ اعْتِکَافَ شَہْر فِی الْمَسْجِدِ ، فَاعْتَکَفَتْ تِسْعَۃً وَعِشْرِینَ یَوْمًا ، ثُمَّ حَاضَتْ فَرَجَعَتْ إلَی أَہْلِہَا ، ثُمَّ طَہُرَتْ فَوَقَعَ عَلَیْہَا زَوْجُہَا ، قَالَ : فَجِئْت سَالِمًا وَالْقَاسِمَ ، فَقَالا : اذْہَبْ إلَی سَعِیدِ بْنِ الْمُسَیَّبِ ، ثُمَّ ائْتِنَا ، قَالَ : فَذَہَبْت إلَی سَعِیدٍ فَسَأَلْتُہُ ، فَقَالَ : خانا حَدًّا مِنْ حُدُودِ اللہِ ، وَأَخْطَاَ السُّنَّۃَ ، وَعَلَیْہَا أَنْ تَسْتَأْنِفَ ، قَالَ : فَرَجَعْت إلَی الْقَاسِمِ وَسَالِمٍ فَأَخْبَرْتُہُمَا بِمَا قَالَ : فَقَالاَ : ذَلِکَ رَأْیُنَا۔","","Musannaf Ibn Abi Shaybah 12585","","","كتاب الأيمان والنذور والكفارات"
"12586","(۱۲۵۸۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ مُجَاہِدٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: إذَا جَامَعَ الْمُعْتَکِفُ أَبْطَلَ اعْتِکَافَہُ وَاسْتَأْنَفَ۔","Sahih","Musannaf Ibn Abi Shaybah 12586","","","كتاب الأيمان والنذور والكفارات"
"12587","(۱۲۵۸۷) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ مُجَاہِدٍ فِی الْمُعْتَکِفِ إذَا جَامَعَ ، قَالَ : یَتَصَدَّقُ بِدِینَارَیْنِ۔","","Musannaf Ibn Abi Shaybah 12587","","","كتاب الأيمان والنذور والكفارات"
"12588","(۱۲۵۸۸) حدَّثَنَا أبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ غَشِیَ امْرَأَتَہُ وَہُوَ مُعْتَکِفٌ : أَنَّہُ بِمَنْزِلَۃِ الَّذِی غَشِیَ فِی رَمَضَانَ ، عَلَیْہِ مَا عَلَی الَّذِی غَشِیَ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 12588","","","كتاب الأيمان والنذور والكفارات"
"12589","(۱۲۵۸۹) حدَّثَنَا حفْصٌ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ ، قَالَ : یَقْضِی اعْتِکَافَہُ۔","","Musannaf Ibn Abi Shaybah 12589","","","كتاب الأيمان والنذور والكفارات"
"12590","(۱۲۵۹۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ الضَّحَّاکِ ، قَالَ : کَانُوا یُجَامِعُونَ وَہُمْ مُعْتَکِفُونَ، حَتَّی نَزَلَتْ : {وَلاَ تُبَاشِرُوہُنَّ وَأَنْتُمْ عَاکِفُونَ فِی الْمَسَاجِدِ}۔","","Musannaf Ibn Abi Shaybah 12590","","","كتاب الأيمان والنذور والكفارات"
"12591","(۱۲۵۹۱) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : مَنْ أَصَابَ امْرَأَتَہُ وَہُوَ مُعْتَکِفٌ فَعَلَیْہِ مِن الْکَفَّارَۃِ مِثْلُ مَا عَلَی الَّذِی یُصِیبُ فِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 12591","","","كتاب الأيمان والنذور والكفارات"
"12592","(۱۲۵۹۲) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا جَامَعَ الْمُعْتَکِفُ اسْتَقْبَلَ۔","","Musannaf Ibn Abi Shaybah 12592","","","كتاب الأيمان والنذور والكفارات"
"12593","(۱۲۵۹۳) حدَّثَنَا ابْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ فِی امْرَأَۃٍ نَذَرَتْ أَنْ تَعْتَکِفَ خَمْسِینَ یَوْمًا ، فَاعْتَکَفَتْ أَرْبَعِینَ یَوْمًا ، ثُمَّ جَائَ زَوْجُہَا فَأَرْسَلَ إلَیْہَا ، فَأَتَتْہُ ، قَالَ : تُتِمُّ مَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 12593","","","كتاب الأيمان والنذور والكفارات"
"12594","(۱۲۵۹۴) حدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَغْشَی امْرَأَتَہُ وَہُوَ مُعْتَکِف ، قَالَ : یُحَرِّرُ مُحَرَّرًا۔","","Musannaf Ibn Abi Shaybah 12594","","","كتاب الأيمان والنذور والكفارات"
"12595","(۱۲۵۹۵) حدَّثَنَا حفص ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کُلُّ شَیْئٍ فِی الْقُرْآنِ : أَوْ أَوْ فَہُوَ فِیہِ مُخَیَّرٌ ، وَکُلُّ شَیْئٍ فِیہِ : (فَمَنْ لَمْ یَجِدْ) فَالَّذِی یَلِیہِ ، فَإِنْ لَمْ یَجِدْ فَالَّذِی یَلِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 12595","","","كتاب الأيمان والنذور والكفارات"
"12596","(۱۲۵۹۶) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عِکْرِمَۃَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 12596","","","كتاب الأيمان والنذور والكفارات"
"12597","(۱۲۵۹۷) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْمَسْعُودِیِّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا کَانَ فِی الْقُرْآنِ : أَوْ أَوْ فَصَاحِبُہُ مُخَیَّرٌ۔","","Musannaf Ibn Abi Shaybah 12597","","","كتاب الأيمان والنذور والكفارات"
"12598","(۱۲۵۹۸) حدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلَیْنِ قَتَلاَ قَتِیلاً جَمِیعًا، قَالَ : عَلَیْہِمَا کَفَّارَتَانِ۔","","Musannaf Ibn Abi Shaybah 12598","","","كتاب الأيمان والنذور والكفارات"
"12599","(۱۲۵۹۹) حدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ عُمَرَ رضی اللَّہُ عَنْہُ ، قَالَ : عَلَیْہِمَا کَفَّارَۃٌ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 12599","","","كتاب الأيمان والنذور والكفارات"
"12600","(۱۲۶۰۰) حدَّثَنَا أبُو دَاوُد ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَلاَ تَرَی لَوْ أَنَّ قَوْمًا قَتَلُوا رَجُلاً اشْتَرَکُوا فِی قَتْلِہِ ، کان عَلَی کُلِّ وَاحِدٍ مِنْہُمْ کَفَّارَۃٌ۔","","Musannaf Ibn Abi Shaybah 12600","","","كتاب الأيمان والنذور والكفارات"
"12601","(۱۲۶۰۱) حدَّثَنَا أبُو دَاوُد ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَوْ أَنَّ قَوْمًا اجْتَمَعُوا عَلَی قَتْلِ رَجُلٍ کَانَ عَلَی کُلِّ وَاحِدٍ مِنْہُمْ کَفَّارَۃٌ ، یَعْنِی خَطَأً ، قَالَ : وَکَانَ الْحَکَمُ یَرَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 12601","","","كتاب الأيمان والنذور والكفارات"
"12602","(۱۲۶۰۲) ابْنُ نُمَیْرٍ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَتَلَ الْقَوْمُ الرَّجُلَ فَعَلَی کُلِّ وَاحِدٍ مِنْہُمُ التَّحْرِیرُ۔","","Musannaf Ibn Abi Shaybah 12602","","","كتاب الأيمان والنذور والكفارات"
"12603","(۱۲۶۰۳) حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ بُرْدٍ أَبِی الْعَلاَئِ ، عَنْ مَکْحُولٍ فِی الْقَوْمِ یَقْتُلُونَ الرَّجُلَ ، قَالَ : عَلَی کُلِّ رَجُلٍ مِنْہُمْ کَفَّارَۃٌ ، وَعَلَیْہِمْ جَمِیعًا الدِّیَۃُ۔","","Musannaf Ibn Abi Shaybah 12603","","","كتاب الأيمان والنذور والكفارات"
"12604","(۱۲۶۰۴) حدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، عَنْ مِسْعَرٍ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، عَنِ ابْنِ مَعْقِلٍ ، قَالَ : کَانَ عَلَی عَائِشَۃَ رَقَبَۃٌ ، أَوْ نَسَمَۃٌ تُعْتِقُہَا مِنْ وَلَدِ إسْمَاعِیلَ ، قَالَ : فَقَدِمَ بسَبْی مِنَ الْیَمَنِ ، قَالَ مِسْعَرٌ : أَرَاہُ مِنْ قَبِیلَۃٍ، یُقَالُ لَہَا : خَوْلاَنُ ، قَالَ : فَنَہَاہَا أَنْ تُعْتِقَ مِنْہُمْ ، قَالَ : فَقَدِمَ بسَبْی مِنْ مُضَرَ ، أَرَاہُ ، قَالَ : مِنْ بَنِی الْعَنْبَرِ ، فَأَمَرَہَا أَنْ تُعْتِقَ مِنْہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 12604","","","كتاب الأيمان والنذور والكفارات"
"12605","(۱۲۶۰۵) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، قَالَ : سُئِلَ عَامِرٌ ، عَنْ رَجُلٍ جَعَلَ عَلَیْہِ مُحَرَّرِینَ مِنْ وَلَدِ إسْمَاعِیلَ إِنْ دَخَلَ بَیْتَ فُلاَنٍ ، فَدَخَلَہُ ، قَالَ : لَیْسَ لَہَا کَفَّارَۃٌ ، قَالَ : الرَّجُلُ : فإنِّی لاَ أَجِدُہُمَا قَالَ : فصُمْ أَرْبَعَۃَ أَشْہُرٍ مُتَتَابِعَاتٍ ، عَنْ کُلِّ رَقَبَۃٍ شَہْرَیْنِ لَعَلَّہُ أَنْ یُکَفِّرَ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 12605","","","كتاب الأيمان والنذور والكفارات"
"12606","(۱۲۶۰۶) حدَّثَنَا أبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ أَبِی ظَبْیَانَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: الْحِینُ قَدْ یَکُونُ غَدْوَۃً وَعَشِیَّۃً۔","Sahih","Musannaf Ibn Abi Shaybah 12606","","","كتاب الأيمان والنذور والكفارات"
"12607","(۱۲۶۰۷) حدَّثَنَا أبُو الأَحْوَص، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ رَجُلٍ مِنْہُمْ ، قَالَ: سَأَلْتُ ابْنَ عبَّاسٍ، قُلْتُ: إنِّی حَلَفْت أن لاَ أُکَلِّمَ رَجُلاً حِینًا ، قَالَ : فَقَرَأَ ابْنُ عَبَّاسٍ : {تُؤْتِی أُکُلَہَا کُلَّ حِینٍ بِإِذْنِ رَبِّہَا} ، قَالَ : الْحِینُ سَنَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 12607","","","كتاب الأيمان والنذور والكفارات"
"12608","(۱۲۶۰۸) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ ، قَالَ : الْحِینُ سِتَّۃُ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 12608","","","كتاب الأيمان والنذور والكفارات"
"12609","(۱۲۶۰۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ إبْرَاہِیمَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، قَالَ : الْحِینُ سِتَّۃُ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 12609","","","كتاب الأيمان والنذور والكفارات"
"12610","(۱۲۶۱۰) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ وَسَأَلَہُ رَجُلٌ ، فَقَالَ : إنِّی حَلَفْت عَلَی امْرَأَتِی أَنْ لاَ تَدْخُلَ علی أَہْلِہَا حِینًا ، فَقَالَ : الْحِینُ مَا بَیْنَ أَنْ تَطْلُعَ النَّخْلُ إلَی أَنْ تُثْمِرَ ، وَمَا بَیْنَ أَنْ تُثْمِرَ إلَی أَنْ تُطْلعَ ، فَقَالَ لَہُ سَعِیدٌ : {ضَرَبَ اللَّہُ مَثَلاً کَلِمَۃً} إلَی قَوْلِہِ : {تُؤْتِی أُکُلَہَا کُلَّ حِینٍ بِإِذْنِ رَبِّہَا}۔","","Musannaf Ibn Abi Shaybah 12610","","","كتاب الأيمان والنذور والكفارات"
"12611","(۱۲۶۱۱) حدَّثَنَا غنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ رَجُلٍ حَلَفَ أَنْ لاَ یُکَلِّمَ رَجُلاً حِینًا ، فَقَالاَ : الْحِینُ سَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 12611","","","كتاب الأيمان والنذور والكفارات"
"12612","(۱۲۶۱۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ طَارِق ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْحِینُ سِتَّۃُ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 12612","","","كتاب الأيمان والنذور والكفارات"
"12613","(۱۲۶۱۳) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ: الْحِینُ شَہْرَانِ ، إن النَّخْلَۃَ تُطْعِمُ السَّنَۃَ کُلَّہَا إلاَّ شَہْرَیْنِ۔","","Musannaf Ibn Abi Shaybah 12613","","","كتاب الأيمان والنذور والكفارات"
"12614","(۱۲۶۱۴) حدَّثَنَا مُعَاوِیَۃُ بْنُ عَمْرٍو ، عَنْ زَائِدَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : الْحِینُ سِتَّۃُ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 12614","","","كتاب الأيمان والنذور والكفارات"
"12615","(۱۲۶۱۵) حدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ عَاصِمِ بْنِ شُمَیْخٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا اجْتَہَدَ فِی الْیَمِینِ ، قَالَ : لاَ وَالَّذِی نَفْسُ أَبِی الْقَاسِمِ بِیَدِہِ۔n(ابوداؤد ۳۲۵۹۔ احمد ۳/۴۸)","Da'if","Musannaf Ibn Abi Shaybah 12615","","","كتاب الأيمان والنذور والكفارات"
"12616","(۱۲۶۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَتْ یَمِینُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الّتِی یَحْلِفُ عَلَیْہَا : لاَ وَمُقَلِّبِ الْقُلُوبِ۔ (بخاری ۷۳۹۱۔ ابوداؤد ۳۲۵۸)","Sahih","Musannaf Ibn Abi Shaybah 12616","","","كتاب الأيمان والنذور والكفارات"
"12617","(۱۲۶۱۷) حدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مُحَمَّدِ بْنِ ہِلاَلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : کَانَتْ یَمِینُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ وَأَسْتَغْفِرُ اللَّہَ۔ (ابوداؤد ۳۲۶۰۔ احمد ۲/۲۸۸)","Da'if","Musannaf Ibn Abi Shaybah 12617","","","كتاب الأيمان والنذور والكفارات"
"12618","(۱۲۶۱۸) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ جَالِسًا مَعَ ابْنِ مَسْعُودٍ فَوْقَ بَیْتِہِ ، فَوَجَبَتِ الشَّمْسُ ، فَقَالَ عَبْدُ اللہِ : ہَذَا وَالَّذِی لاَ إلَہَ غَیْرُہُ حِینَ أَفْطَرَ الصَّائِمُ۔","Sahih","Musannaf Ibn Abi Shaybah 12618","","","كتاب الأيمان والنذور والكفارات"
"12619","(۱۲۶۱۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی الْمِنْہَالِ ، عَنْ عَبَّادِ بْنِ عَبْدِ اللہِ ، قَالَ : کَانَ عَلِیٌّ رضی اللَّہُ عَنْہُ یَخْطُبُ ، فَقَالَ : لاَ وَالَّذِی فَلَقَ الْحَبَّۃَ وَبَرَأَ النَّسَمَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 12619","","","كتاب الأيمان والنذور والكفارات"
"12620","(۱۲۶۲۰) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ یَحْیَی بْنِ جَعْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : لاَ وَرَبِّ ہَذِہِ الْکَعْبَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 12620","","","كتاب الأيمان والنذور والكفارات"
"12621","(۱۲۶۲۱) حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ زِیَادِ الْحَارِثِیِّ ، قَالَ : قَالَ رَجُلٌ لأَبِی ہُرَیْرَۃَ : أَنْتَ الَّذِی تَنْہَی عَنْ صَوْمِ یَوْمِ الْجُمُعَۃِ ؟ فَقَالَ : لاَ وَرَبِّ ہَذِہِ الْحُرْمَۃِ ، أَوْ ہَذِہِ الْبِنْیَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 12621","","","كتاب الأيمان والنذور والكفارات"
"12622","(۱۲۶۲۲) حدَّثَنَا حفْصٌ وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ قَالَ : وَالَّذِی لاَ إلَہَ غَیْرُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 12622","","","كتاب الأيمان والنذور والكفارات"
"12623",") حدَّثَنَا أبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، عَنْ مَسْرُوقٍ ، أَنَّ عَائِشَۃَ ، قَالَتْ فِی شَیْئٍ حَلَفْت عَلَیْہِ: لاَ وَالَّذِی آمَنَ بِہِ الْمُؤْمِنُونَ وَکَفَرَ بِہِ الْکَافِرُونَ۔ (ابن سعد ۸۲)","Sahih","Musannaf Ibn Abi Shaybah 12623","","","كتاب الأيمان والنذور والكفارات"
"12624","(۱۲۶۲۴) حدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ ہِلاَلِ بْنِ أَبِی مَیْمُونَۃَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ رِفَاعَۃَ الْجُہَنِیِّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا حَلَف ، قَالَ : وَالَّذِی نَفْسُ مُحَمَّدٍ بِیَدِہِ۔ (احمد ۱۶)","Sahih","Musannaf Ibn Abi Shaybah 12624","","","كتاب الأيمان والنذور والكفارات"
"12625","(۱۲۶۲۵) حدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی أَبُو الزُّبَیْرِ ، أَنَّہُ سَمِعَ سَعِیدَ بْنَ جُبَیْرٍ قَالَ : قَالَ ابْنُ عَبَّاسٍ : إِنْ فَائَ کَفَّرَ ، وَإِنْ لَمْ یَفْعَلْ فَہِیَ وَاحِدَۃٌ وَہِیَ أَحَقُّ بِنَفْسِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 12625","","","كتاب الأيمان والنذور والكفارات"
"12626","(۱۲۶۲۶) حدَّثَنَا أبُو دَاوُد الطَّیَالِسِیُّ ، عَنْ ہَارُونَ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبْدِ اللہِ بْنِ جُبَیْرٍ ، أَنَّ زَیَادًا أَبْصَرَ أَبَا مُوسَی کَئِیبًا ، فَقَالَ لَہُ : مَا لَکَ ؟ فَذَکَرَ أَنَّہُ آلَی مِنِ امْرَأَتِہِ ، فَأَمَرَہُ أَنْ یُکَفِّرَ ، فَفَعَلَ۔","","Musannaf Ibn Abi Shaybah 12626","","","كتاب الأيمان والنذور والكفارات"
"12627","(۱۲۶۲۷) حدَّثَنَا غنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی الشَّعْثَائِ ، عَنْ عَلْقَمَۃَ ، وَأَصْحَابُ عَبْدِ اللہِ ، أَنَّہُمْ قَالُوا : ؛ فِی الرَّجُلِ إذَا آلَی مِنِ امْرَأَتِہِ ، ثُمَّ أَتَاہَا قَبْلَ أَنْ تَبَرَّ یَمِینَہُ ، قَالَ : یُکَفِّرُ یَمِینَہُ۔","","Musannaf Ibn Abi Shaybah 12627","","","كتاب الأيمان والنذور والكفارات"
"12628","(۱۲۶۲۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی الشَّعْثَائِ ، عَنْ عَلْقَمَۃَ ، قَالَ : إذَا فَائَ المُولَی کَفَّرَ۔","","Musannaf Ibn Abi Shaybah 12628","","","كتاب الأيمان والنذور والكفارات"
"12629","(۱۲۶۲۹) حدَّثَنَا الثَّقَفِیُّ، عَنْ خَالِدٍ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ، قَالَ: إذَا آلَی الرَّجُلُ مِنِ امْرَأَتِہِ، ثُمَّ فَائَ فَعَلَیْہِ الْکَفَّارَۃُ۔","","Musannaf Ibn Abi Shaybah 12629","","","كتاب الأيمان والنذور والكفارات"
"12630","(۱۲۶۳۰) حدَّثَنَا أبُو دَاوُد ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ لاَ یَرَی عَلَیْہِ الْکَفَّارَۃَ فِی یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 12630","","","كتاب الأيمان والنذور والكفارات"
"12631","(۱۲۶۳۱) ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أنہ کَانَ یَقُولُ : فَیؤُہُ کَفَّارَۃ۔","","Musannaf Ibn Abi Shaybah 12631","","","كتاب الأيمان والنذور والكفارات"
"12632","(۱۲۶۳۲) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی الَّذِی یُولِی مِنِ امْرَأَتِہِ فَیَفِیئُ ، قَالَ : کَانَ بَعْضُہُمْ یَقُولُ : فَیؤُہُ کَفَّارَۃ۔","","Musannaf Ibn Abi Shaybah 12632","","","كتاب الأيمان والنذور والكفارات"
"12633","(۱۲۶۳۳) حدَّثَنَا غنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَحْلِفُ أن لاَ یَقْرَبُ امْرَأَتَہُ عَشَرَۃَ أَیَّامٍ ، ثُمَّ قَرُبَہَا قَبْلَ الْعَشَرَۃِ ، قَالَ : لاَ کَفَّارَۃَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 12633","","","كتاب الأيمان والنذور والكفارات"
"12634","(۱۲۶۳۴) حدَّثَنَا ہُشَیْمٌ، عَنْ یُونُسَ، عَنِ الْحَسَنِ؛ فِی رَجُلٍ جَعَلَ عَلَیْہِ صَوْمَ شَہْرٍ، قَالَ: إن سَمَّی شَہْرًا مَعْلُومًا فَلْیَصُمْہُ وَلْیُتَابِعْ ، وَإِذَا لَمْ یُسَمِّ شَہْرًا مَعْلُومًا ، أو لَمْ یَنْوِہِ فَلْیَسْتَقْبِلِ الأَیَّامَ ، فَلْیَصُمْ ثَلاَثِینَ یَوْمًا ، وَإِنْ صَامَ عَلَی الْہِلاَلِ ، وَأَفْطَرَ عَلَی رُؤْیَتِہِ فَکَانَتْ تِسْعَۃً وَعِشْرِینَ یَوْمًا أَجْزَأَہُ ذَلِکَ ، وَإِنْ فَرَّقَ إذًا اسْتَقْبَلَ الأَیَّامَ۔","","Musannaf Ibn Abi Shaybah 12634","","","كتاب الأيمان والنذور والكفارات"
"12635","(۱۲۶۳۵) حدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ؛ فِی الرَّجُلِ یَجْعَلُ عَلَیْہِ صَوْمَ شَہْرٍ ، قَالَ : ہُوَ أَعْلَمُ بِمَا جَعَلَ، وَجَعَلہ یَمِینَہُ۔","","Musannaf Ibn Abi Shaybah 12635","","","كتاب الأيمان والنذور والكفارات"
"12636","(۱۲۶۳۶) حدَّثَنَا ابن نُمَیرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، وَعَنْ حَمَّاد ، عَنْ إبْرَاہِیمَ ، قَالاَ : إذَا جَعَلَ الرَّجُلُ عَلَیْہِ صَوْمَ شَہْرٍ ، وَلَمْ یُسَمِّ شَہْرًا مِنَ الشُّہُورِ ، قَالَ : إِنْ شَائَ تَابَعَ ، وَإِنْ شَائَ فَرَّقَ۔","","Musannaf Ibn Abi Shaybah 12636","","","كتاب الأيمان والنذور والكفارات"
"12637","(۱۲۶۳۷) حدَّثَنَا کثیر بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : النَّذْرُ فِی الصِّیَامِ مُتَتَابِعٌ۔","","Musannaf Ibn Abi Shaybah 12637","","","كتاب الأيمان والنذور والكفارات"
"12638","(۱۲۶۳۸) حدَّثَنَا حفْصٌ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً ، وَحَدَّثَنِی مَنْ سَأَلَ إِبْرَاہِیمَ ، عَن رَجُلٍ نَذَرَ أَنْ یَصُومَ شَہْرًا ، قالا یَصُوم ثَلاَثِینَ ، یَعْنِی مُتَفَرِّقًا۔","","Musannaf Ibn Abi Shaybah 12638","","","كتاب الأيمان والنذور والكفارات"
"12639","(۱۲۶۳۹) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا أَنْ یُطْعِمَ مِسْکِینًا وَاحِدًا عَشْرَ مَرَّاتٍ فِی کَفَّارَۃِ الْیَمِینِ۔","","Musannaf Ibn Abi Shaybah 12639","","","كتاب الأيمان والنذور والكفارات"
"12640","(۱۲۶۴۰) حدَّثَنَا حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ یُجْزِئُ فِی کَفَّارَۃِ الْیَمِینِ إلاَّ إطْعَامُ عَشَرَۃِ مَسَاکِینَ۔","","Musannaf Ibn Abi Shaybah 12640","","","كتاب الأيمان والنذور والكفارات"
"12641","(۱۲۶۴۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ لاَ یَجِدُ مَسَاکِینَ مُسْلِمِینَ ، فَیُعْطِی الْیَہُودَ وَالنَّصَارَی ، فَقَالَ الشَّعْبِیُّ : یُجْزِیہِ ، وَقَالَ الْحَکَمُ : لاَ یُجْزِیہِ ، وَقَالَ إبْرَاہِیمُ : فَإِنِّی أَرْجُو إذَا لَمْ یَجِدْ غَیْرَہُمْ یُجْزِیہِ۔","","Musannaf Ibn Abi Shaybah 12641","","","كتاب الأيمان والنذور والكفارات"
"12642","(۱۲۶۴۲) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ عَمَّنْ حَدَّثَہُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانَتْ لَہُ عِشْرُونَ کَفَّرَ۔","","Musannaf Ibn Abi Shaybah 12642","","","كتاب الأيمان والنذور والكفارات"
"12643","(۱۲۶۴۳) حدَّثَنَا مُعْتَمِرٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَانَا لاَ یُوَقِّتَانِ فِی ذَلِکَ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 12643","","","كتاب الأيمان والنذور والكفارات"
"12644","(۱۲۶۴۴) حدَّثَنَا مُعْتَمِرٌ ، قَالَ : قُلْتُ لِمَعْمَرٍ : ؛ الرَّجُلُ یَحْلِفُ وَلَیْسَ عِنْدَہُ مِنَ الطَّعَامِ إلاَّ مَا یُکَفِّرُ ، قَالَ : کَانَ قَتَادَۃُ یَقُولُ : یَصُومُ ثَلاَثَۃَ أَیَّامٍ۔","","Musannaf Ibn Abi Shaybah 12644","","","كتاب الأيمان والنذور والكفارات"
"12645","(۱۲۶۴۵) حدَّثَنَا عَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی الرَّجُلِ یَحْلِفُ وَلَیْسَ لَہُ إلاَّ ثَلاَثَۃُ دَرَاہِمَ فَیَحْنَثُ ، قَالَ : یُکَفِّرُ۔","","Musannaf Ibn Abi Shaybah 12645","","","كتاب الأيمان والنذور والكفارات"
"12646","(۱۲۶۴۶) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِی ، عَنْ سَعِیدٍ ، عَنْ فَرْقَدٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانَ لَہُ عِشْرُونَ دِرْہَمًا فَعَلَیْہِ الْکَفَّارَۃُ۔","","Musannaf Ibn Abi Shaybah 12646","","","كتاب الأيمان والنذور والكفارات"
"12647","(۱۲۶۴۷) حدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ سُفْیَانَ ، عَنْ سَعِیدٍ بْنِ أَبِی عَرُوبَۃَ ، عَنْ فَرْقَدٍ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 12647","","","كتاب الأيمان والنذور والكفارات"
"12648","(۱۲۶۴۸) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ : إذَا حَلَفَ عَلَی اللَّبَنِ فَلاَ یَأْکُلَ الزُّبْدَ ، فَإِنَّہُ مِنَ اللَّبَنِ ، وَإِذَا حَلَفَ عَلَی الزُّبْدِ فَلْیَأْکُلِ اللَّبَنَ ، وَإِذَا حَلَفَ عَلَی اللَّحْمِ فَلاَ یَأْکُلُ الشَّحْمَ ، وَإِذَا حَلَفَ عَلَی الشَّحْمِ فَلْیَأْکُلِ اللَّحْمَ۔","","Musannaf Ibn Abi Shaybah 12648","","","كتاب الأيمان والنذور والكفارات"
"12649","(۱۲۶۴۹) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ أَصْحَابُنَا یَقُولُونَ : إذَا حَلَفَ عَلَی اللَّبَنِ فَلاَ یَأْکُلُ مِنَ السَّمْنِ ، وَلاَ مِنَ الْجُبْنِ ، وَإِذَا حَلَفَ عَلَی السَّمْنِ وَالْجُبْنِ أَکَلَ مِنَ اللَّبَنِ۔","","Musannaf Ibn Abi Shaybah 12649","","","كتاب الأيمان والنذور والكفارات"
"12650","(۱۲۶۵۰) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ سُئِلَ عَنْ رَجُلٍ ، قَالَ: لِامْرَأَتِہِ ، إِنْ أَکَلَ لَحْمًا فَامْرَأَتُہُ طَالِقٌ فَأَکَلَ سَمَکًا ، قَالَ : ہِیَ طَالِقٌ ، قَالَ اللَّہُ تَعَالَی : {تَأْکُلُونَ لَحْمًا طَرِیًّا}۔","","Musannaf Ibn Abi Shaybah 12650","","","كتاب الأيمان والنذور والكفارات"
"12651","(۱۲۶۵۱) حدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یَحْنَثُ ، قَالَ اللَّہُ تَعَالَی : {تَأْکُلُونَ لَحْمًا طَرِیًّا}۔","","Musannaf Ibn Abi Shaybah 12651","","","كتاب الأيمان والنذور والكفارات"
"12652","(۱۲۶۵۲) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ عَامِرٍ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عَبَّاسٍ ، عَنْ رَجُلٍ نَذَرَ أَنْ یَنْحَرَ ابْنَہُ ، قَالَ : یَنْحَرُ مِئَۃ مِنَ الإِبِلِ کَمَا فَدَی بِہَا عَبْدُ الْمُطَّلِبِ ابْنَہُ ، قَالَ : وقال غَیْرُہُ : کَبْشًا کَمَا فَدَی إبْرَاہِیمُ ابْنَہُ إِسْحَاقَ ، فَسَأَلْت مَسْرُوقًا ، فَقَالَ : ہَذَا مِنْ خَطوَاتِ الشَّیْطَانِ ، لاَ کَفَّارَۃَ فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 12652","","","كتاب الأيمان والنذور والكفارات"
"12653","(۱۲۶۵۳) حدَّثَنَا عَبَّادٌ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَقُولُ : ہُوَ یَنْحَرُ ابْنَہُ ، قَالَ : کَبْشٌ کَمَا فَدَی إبْرَاہِیمُ إِسْحَاقَ۔","Sahih","Musannaf Ibn Abi Shaybah 12653","","","كتاب الأيمان والنذور والكفارات"
"12654","(۱۲۶۵۴) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، قَالَ : کُنْتُ عِنْدَ ابْنِ عَبَّاسٍ ، فَجَائَتْہُ امْرَأَۃٌ ، فَقَالَتْ : إنِّی نَذَرْت أَنْ أَنْحَرَ ابْنِی ، فَقَالَ : ابْنُ عَبَّاسٍ : لاَ تَنْحَرِی ابْنَک وَکَفِّرِی عَنْ یَمِینِکِ ، قَالَ : فَقَالَ رَجُلٌ عِنْدَ ابْنِ عَبَّاسٍ : إِنَّہُ لاَ وَفَائَ لِنَذْرٍ فِی مَعْصِیَۃٍ ، فَقَالَ : ابْنُ عَبَّاسٍ : أَلَیْسَ قَدْ قَالَ : اللَّہُ فِی الظِّہَارِ : {إنَّہُمْ لَیَقُولُونَ مُنْکَرًا مِنَ الْقَوْلِ وَزُورًا} ثَمَّ قَالَ فِیہِ مِنَ الْکَفَّارَۃِ مَا سَمِعْت۔","Sahih","Musannaf Ibn Abi Shaybah 12654","","","كتاب الأيمان والنذور والكفارات"
"12655","(۱۲۶۵۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ فِی رَجُلٍ نَذَرَ أَنْ یَنْحَرَ ابْنَہُ ، قَالَ : یُہْدِی دِیَتَہُ۔","","Musannaf Ibn Abi Shaybah 12655","","","كتاب الأيمان والنذور والكفارات"
"12656","(۱۲۶۵۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ: إذَا قَالَ: ہُوَ یَنْحَرُ ولدہُ ، قَالَ یُحِجُّہُ۔","","Musannaf Ibn Abi Shaybah 12656","","","كتاب الأيمان والنذور والكفارات"
"12657","(۱۲۶۵۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ ، قَالَ : إذَا قَالَ : ہُوَ یَنْحَرُہُ فَبَدَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 12657","","","كتاب الأيمان والنذور والكفارات"
"12658","(۱۲۶۵۸) حدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی ، عَنْ عِکْرِمَۃَ فِی رَجُلٍ نَذَرَ أَنْ یَنْحَرَ ابْنَہُ ، قَالَ : یَذْبَحُ کَبْشًا فَیَتَصَدَّقُ بِلَحْمِہِ ، ثُمَّ قَالَ : لَقَدْ کَانَ لَکُمْ فِی إبْرَاہِیمَ أُسْوَۃٌ حَسَنَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 12658","","","كتاب الأيمان والنذور والكفارات"
"12659","(۱۲۶۵۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ نَذَرَ أَنْ یَنْحَرَ ابْنَہُ ، قَالَ : یُحِجُّہُ وَیَنْحَرُ بَدَنَۃً۔","","Musannaf Ibn Abi Shaybah 12659","","","كتاب الأيمان والنذور والكفارات"
"12660","(۱۲۶۶۰) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الرَّجُلِ یَقُولُ : ہُوَ یَنْحَرُ ابْنَہُ ، قَالَ : یُہْدِی دِیَتَہُ ، أَوْ کَبْشًا۔","Sahih","Musannaf Ibn Abi Shaybah 12660","","","كتاب الأيمان والنذور والكفارات"
"12661","(۱۲۶۶۱) حدَّثَنَا أبُو أُسَامَۃَ ، عَنْ أَبِی غِفَارِ الْمُثَنَّی بن سَعِید ، قَالَ : سَأَلْتُ جَابِرَ بْنَ زَیْدٍ ، عَنْ رَجُلٍ ، قَالَ لِرَجُلٍ ہُوَ یُہْدِیک إِنْ لَمْ یَسْرِ أَہْلُک ، قَالَ : یُہْدِی کَبْشًا۔","","Musannaf Ibn Abi Shaybah 12661","","","كتاب الأيمان والنذور والكفارات"
"12662","(۱۲۶۶۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ ، قَالَ : إذَا قَالَ : ہُوَ یُہْدِی ابْنَہُ ، فَکَبْشٌ۔","","Musannaf Ibn Abi Shaybah 12662","","","كتاب الأيمان والنذور والكفارات"
"12663","(۱۲۶۶۳) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ قَالَ : ہُوَ یُہْدِی ابْنَہُ فَکَبْشٌ۔","","Musannaf Ibn Abi Shaybah 12663","","","كتاب الأيمان والنذور والكفارات"
"12664","(۱۲۶۶۴) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ : ہُوَ یُہْدِیہِ حَافِیًا رَاجِلاً ، قَالَ : یُحِجُّہُ ، وَیَمْشِی ہُوَ حَافِیًا ، وَلاَ یَرْکَبُ وَلَکِنْ یَحْمِلُ الَّذِی حَلَفَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 12664","","","كتاب الأيمان والنذور والكفارات"
"12665","(۱۲۶۶۵) حدَّثَنَا عَبْدُ الرَّحِیمِ ، وَوَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ؛ فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ أَنَا أُہْدِیک ، وَقَالَ وَکِیعٌ : قَالَ لاِبْنِہِ ، قَالَ : یُہْدِی دِیَتَہُ۔","","Musannaf Ibn Abi Shaybah 12665","","","كتاب الأيمان والنذور والكفارات"
"12666","(۱۲۶۶۶) عَبْدُ الرَّحْمَنِ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُحِجُّہُ۔","","Musannaf Ibn Abi Shaybah 12666","","","كتاب الأيمان والنذور والكفارات"
"12667","(۱۲۶۶۷) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشعَث ، عَنْ حَمَّاد ، عَنْ إبْرَاہِیمَ ، قَالَ : عَلَیْہِ أَنْ یُحِجَّہُ۔","","Musannaf Ibn Abi Shaybah 12667","","","كتاب الأيمان والنذور والكفارات"
"12668","(۱۲۶۶۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ عُثْمَانَ بْنِ حَاضِرٍ ، عَنِ ابْنِ عَبَّاسٍ، وَابْنِ عُمَرَ، قَالاَ : یُہْدِی جَزُورًا۔","Hasan","Musannaf Ibn Abi Shaybah 12668","","","كتاب الأيمان والنذور والكفارات"
"12669","(۱۲۶۶۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سِمَاکٍ ، عَنْ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ مَسْرُوقٍ ، قَالَ : یُہْدِی کَبْشًا۔","","Musannaf Ibn Abi Shaybah 12669","","","كتاب الأيمان والنذور والكفارات"
"12670","(۱۲۶۷۰) حدَّثَنَا عَبَّادٌ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، قَالَ : سَأَلْتُ الْحَسَنَ ، وَابْنَ سِیرِینَ ، عَنْ رَجُلٍ ظَاہَرَ مِنَ امْرَأَتِہِ ، وَلَمْ یُکَفِّرْ وتَہَاوَن بِذَلِکَ ، قَالاَ : تَسْتَعْدِی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 12670","","","كتاب الأيمان والنذور والكفارات"
"12671","(۱۲۶۷۱) حدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : إذَا قَالَ الْمُظَاہِرُ : لاَ حَاجَۃَ لِی بِہَا لَمْ یُتْرَکْ حَتَّی یُطَلِّقَ ، أَوْ یُکَفِّرَ۔","","Musannaf Ibn Abi Shaybah 12671","","","كتاب الأيمان والنذور والكفارات"
"12672","(۱۲۶۷۲) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی امْرَأَۃٍ جَعَلَتْ عَلَی نَفْسِہَا أوْ نَذَرَتْ أَنْ تصَلِّیَ فِی خَمْسِینَ مَسْجِدًا وَأَنْ تَصَدَّقَ مِنْ خَمْسِینَ بَیْتًا وَأَنْ تَصَدَّقَ بِہِ ، فَأَمَرَہَا أَنْ لاَ تَصَدَّقَ فَإِنَّہَا مَعْصِیَۃٌ تُکَفِّرُ یَمِینَہَا وَتُصَلِّی فِی خَمْسِینَ مَسْجِدًا لأَنَّ الصَّلاَۃَ مِنْ طَاعَۃِ اللہِ۔","","Musannaf Ibn Abi Shaybah 12672","","","كتاب الأيمان والنذور والكفارات"
"12673","(۱۲۶۷۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی امْرَأَۃٍ نَذَرَتْ عَلَیْہَا أَنْ تُصَلِّیَ إلَی کُلِّ سَارِیَۃٍ مِنْ سِوَارِی مَسْجِدِ الْبَصْرَۃِ ، قَالَ : تُصَلِّی بِعَدَدِ سِوَارِی الْمَسْجِدِ فِی مَقَامٍ وَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 12673","","","كتاب الأيمان والنذور والكفارات"
"12674","(۱۲۶۷۴) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنِ مُرَّۃَ ، قَالَ : دَخَلْت الْمَسْجِدَ وَأَنَا أُحَدِّثُ نَفْسِی أَنْ أُصَلِّیَ عِنْدَ کُلِّ أُسْطُوَانَۃٍ رَکْعَتَیْنِ ، وَرَجُلٌ یَرْمُقُنِی لاَ أَشْعُرُ بِہِ ، فَلَمَّا جَلَسْت نَظَرْت فَإِذَا عَبْدُ اللہِ جَالِسًا ، فَأَتَیْتُہُ فَجَلَسْت إلَیْہِ ، فَإِذَا الرَّجُلُ الَّذِی یَرْمُقُنِی عِنْدَہُ ، قَالَ : وَلاَ یَشْعُرُ بِمَکَانِی قَالَ: یَا أَبَا عَبْدِ الرَّحْمَنِ ، إنَّ رَجُلاً دَخَلَ الْمَسْجِدَ فَجَعَلَ یُصَلِّی عِنْدَ کُلِّ أُسْطُوَانَۃٍ رَکْعَتَیْنِ ، فَقَالَ : لَوْ عَلِمَ ، أَنَّ اللَّہَ عِنْدَ الأُسْطُوَانَۃٍ لَمْ یَتَحَوَّلْ حَتَّی یَقْضِیَ صَلاَتَہُ ، قَالَ : فَتَرَکْت بَقِیَّۃَ مَا أَرَدْت أَنْ أُصَلِّیَ۔","Da'if","Musannaf Ibn Abi Shaybah 12674","","","كتاب الأيمان والنذور والكفارات"
"12675","(۱۲۶۷۵) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ أَعْتَقَ وَلَدَ الزِّنَا وَأُمَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 12675","","","كتاب الأيمان والنذور والكفارات"
"12676","(۱۲۶۷۶) حدَّثَنَا ابْنُ نُمَیْرٍ ، عن عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ أَعْتَقَ وَلَدَ زِنَا وَأُمَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 12676","","","كتاب الأيمان والنذور والكفارات"
"12677","(۱۲۶۷۷) أبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ لاَ یَرَی بِعِتْقِ وَلَدِ الزِّنَا بَأْسًا۔","","Musannaf Ibn Abi Shaybah 12677","","","كتاب الأيمان والنذور والكفارات"
"12678","(۱۲۶۷۸) وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ فِی عِتْقِ وَلَدِ الزِّنَا ، قَالَ لَہُ : مَا احْتَسَبَ۔","","Musannaf Ibn Abi Shaybah 12678","","","كتاب الأيمان والنذور والكفارات"
"12679","(۱۲۶۷۹) حدَّثَنَا أَسْبَاطٌ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سُئِلَ عَطَائٌ عَنْ عِتْقِ وَلَدِ الزِّنَا أَعْتِقُہُ ؟ قَالَ : نَعَمْ عِتْقُہُ حَسَنٌ۔","","Musannaf Ibn Abi Shaybah 12679","","","كتاب الأيمان والنذور والكفارات"
"12680","(۱۲۶۸۰) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ یَزِیدَ بْنِ أَبِی حَرِیزٍ ، عَنْ مَرْیَمَ بِنْتِ أَبِی یَزِیدَ ، عَنْ أُمِّ نُجَیْدٍ ، أَنَّہَا سَأَلَتْ أَبَا أُمَامَۃَ ، عَنْ وَلَدِ الزِّنَا تُعْتِقُہُ ، قَالَ : ہُوَ کَالدِّرْہَمِ الزَّائِفِ ، تَصَدَّقِی بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 12680","","","كتاب الأيمان والنذور والكفارات"
"12681","(۱۲۶۸۱) حدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرِ الشَّامِیِّ ، عَنْ عُمَر بن عَبْدِ الرَّحْمَنِ بْنِ سَعْدٍ ، قَالَ : جَائَ رَجُلٌ إلَی ابْنِ عَبَّاسٍ ، فَقَالَ : إنَّ لِی غُلاَمَیْنِ ، أَحَدُہُمَا رَشْدَۃٌ وَالآخَرُ غِیَّۃٌ وَإِنِّی أُرِیدُ أَنْ أُعْتِقَ أَحَدَہُمَا ، فَأَیُّہُمَا تَرَی أَنْ أُعْتِقَ ؟ قَالَ : انظر أَکْثَرُہُمَا ثَمَنًا فوجدوا ولد وَلَدَ الزِّنا أکثرہما ثمنا فأمرہم بہ۔","Da'if","Musannaf Ibn Abi Shaybah 12681","","","كتاب الأيمان والنذور والكفارات"
"12682","(۱۲۶۸۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَعْتِقْ أَکْثَرَہُمَا ثَمَنًا۔","","Musannaf Ibn Abi Shaybah 12682","","","كتاب الأيمان والنذور والكفارات"
"12683","(۱۲۶۸۳) حدَّثَنَا وَکِیعٌ ، قَالَ حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّہَا سُئِلَتْ ، عَنْ وَلَدِ الزِّنَا ، فَقَالَتْ ، لَیْسَ عَلَیْہِ مِنْ خَطِیئَۃِ أَبَوَیْہِ شَیْئٌ ، {لاَ تَزِرُ وَازِرَۃٌ وِزْرَ أُخْرَی}۔","Sahih","Musannaf Ibn Abi Shaybah 12683","","","كتاب الأيمان والنذور والكفارات"
"12684","(۱۲۶۸۴) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِیسَی الْخَبَّاطُ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : وَلَدُ الزِّنَا خَیْرُ الثَّلاَثَۃِ ، إنَّمَا ہذا شَیْئٌ قَالَہُ کَعْبٌ ہُوَ شَرُّ الثَّلاَثَۃِ۔","","Musannaf Ibn Abi Shaybah 12684","","","كتاب الأيمان والنذور والكفارات"
"12685","(۱۲۶۸۵) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّ عُمَرَ ، قَالَ : لأَنْ أَحْمِلَ عَلَی نَعْلَیْنِ فِی سَبِیلِ اللہِ أَحَبُّ إلَیَّ مِنْ أَنْ أُعْتِقَ وَلَدَ زِنًا۔","","Musannaf Ibn Abi Shaybah 12685","","","كتاب الأيمان والنذور والكفارات"
"12686","(۱۲۶۸۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنْ عَائِشَۃَ ، قَالَتْ ، لأَنْ أَتَصَدَّقَ بِثَلاَثَۃِ نَوَیَاتٍ ، أَوْ أُمَتِّعَ بِسَوْطٍ فِی سَبِیلِ اللہِ أَحَبُّ إلَیَّ مِنْ أَنْ أُعْتِقَ وَلَدَ الزِّنَا۔","Da'if","Musannaf Ibn Abi Shaybah 12686","","","كتاب الأيمان والنذور والكفارات"
"12687","(۱۲۶۸۷) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُجَاہِدٍ ، قَالَ أَعْتَقَ الْعَبَّاسُ بَعْضَ رَقِیقِہِ فِی مَرَضِہِ ، فَرَدَّ ابْنُ عَبَّاسٍ مِنْہُمَا اثْنَیْنِ کَانُوا یَرَوْنَ أَنَّہُمَا أَوْلاَدُ زِنًا۔","","Musannaf Ibn Abi Shaybah 12687","","","كتاب الأيمان والنذور والكفارات"
"12688","(۱۲۶۸۸) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَنَّ عَمْرَو بْنَ الْعَاصِ أَعْتَقَ رَقِیقَہُ فِی مَرَضِہِ ، فَرَدَّ عَبْدُ اللہِ بْنُ عَمْرٍو مِنْہُمْ سِتَّۃً کَانُوا یَرَوْنَ أَنَّہُمَا أَوْلاَدُ الزِّنَا۔","Da'if","Musannaf Ibn Abi Shaybah 12688","","","كتاب الأيمان والنذور والكفارات"
"12689","(۱۲۶۸۹) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، عَنْ عَلِیٍّ ، أَنَّہُ کَرِہَ عِتْقَ وَلَدِ الزِّنَا۔","Sahih","Musannaf Ibn Abi Shaybah 12689","","","كتاب الأيمان والنذور والكفارات"
"12690","(۱۲۶۹۰) حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ أُسَّقٍ ، قَالَ : کُنْتُ مَمْلُوکًا لِعُمَرَ ، فَکَانَ یَعْرِضُ عَلَیْہِ الإِسْلاَمَ وَیَقُولُ : {لاَ إکْرَاہَ فِی الدِّینِ} فَلَمَّا حُضِرَ أَعْتَقَہ۔","Da'if","Musannaf Ibn Abi Shaybah 12690","","","كتاب الأيمان والنذور والكفارات"
"12691","(۱۲۶۹۱) حدَّثَنَا شَرِیکٌ ، عَنْ عُبَیْدَۃَ ، عَنْ عَامِرٍ ، أَنَّ عُمَرَ أَعْتَقَ یَہُودِیًّا ، أَوْ نَصْرَانِیًّا۔","Da'if","Musannaf Ibn Abi Shaybah 12691","","","كتاب الأيمان والنذور والكفارات"
"12692","(۱۲۶۹۲) حدَّثَنَا شَرِیکٌ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّ عَلِیًّا أَعْتَقَ نَصْرَانِیًّا ، أَوْ یَہُودِیًّا۔","","Musannaf Ibn Abi Shaybah 12692","","","كتاب الأيمان والنذور والكفارات"
"12693","(۱۲۶۹۳) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ برد ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ أَعْتَقَ غُلاَمًا لَہُ نَصْرَانِیًّا کَانَ وَہَبَہُ لِبَعْضِ أَہْلِہِ ، فَرَجَعَ إلَیْہِ فِی مِیرَاثٍ فَأَعْتَقَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 12693","","","كتاب الأيمان والنذور والكفارات"
"12694","(۱۲۶۹۴) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ أَعْتَقَ غُلاَمًا لَہُ نَصْرَانِیًّا۔","","Musannaf Ibn Abi Shaybah 12694","","","كتاب الأيمان والنذور والكفارات"
"12695","(۱۲۶۹۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَرِہَ أَنْ یُعْتَقَ النَّصْرَانِیُّ۔","","Musannaf Ibn Abi Shaybah 12695","","","كتاب الأيمان والنذور والكفارات"
"12696","(۱۲۶۹۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَعْلَی بْنِ عَطَائٍ عَمَّنْ سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ : إنَّمَا الصَّوْمُ فِی کَفَّارَۃِ الْیَمِینِ عَلَی مَنْ لَمْ یَجِدْ۔","Da'if","Musannaf Ibn Abi Shaybah 12696","","","كتاب الأيمان والنذور والكفارات"
"12697","(۱۲۶۹۷) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالاَ : إذَا وَجَدْت فَلاَ تَصُمْ۔","","Musannaf Ibn Abi Shaybah 12697","","","كتاب الأيمان والنذور والكفارات"
"12698","(۱۲۶۹۸) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ عَامِرِ بْنِ مُصْعَبٍ ، أَنَّ عَائِشَۃَ اعْتَکَفَتْ عَنْ أَخِیہَا بَعْدَ مَا مَاتَ۔","Hasan","Musannaf Ibn Abi Shaybah 12698","","","كتاب الأيمان والنذور والكفارات"
"12699","(۱۲۶۹۹) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، قَالَ : سُئِلَ طَاوُوس ، عَنِ امْرَأَۃٍ مَاتَتْ وَعَلَیْہَا أَنْ تَعْتَکِفَ سَنَۃً فِی الْمَسْجِدِ الْحَرَامِ ، وَلَہَا أَرْبَعَۃُ بَنُونَ کُلُّہُمْ یُحِبُّ أَنْ یَقْضِیَ عَنْہَا ، قَالَ طَاوُوس : اعْتَکِفُوا ، أَرْبَعَتُکُمْ فِی الْمَسْجِدِ الْحَرَامِ ثَلاَثَۃَ أَشْہُرٍ وَصُومُوا۔","","Musannaf Ibn Abi Shaybah 12699","","","كتاب الأيمان والنذور والكفارات"
"12700","(۱۲۷۰۰) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عُبَیْدِ اللہ بن عَبْدِ اللہِ بْنِ عُتْبَۃَ ، أَنَّ امْرَأَۃً نَذَرَتْ أَنْ تَعْتَکِفَ عَشَرَۃَ أَیَّامٍ ، فَمَاتَتْ وَلَمْ تَعْتَکِفْ ، فَقَالَ : ابْنُ عَبَّاسٍ : اعْتَکِفْ عَنْ أُمِّک۔","","Musannaf Ibn Abi Shaybah 12700","","","كتاب الأيمان والنذور والكفارات"
"12701","(۱۲۷۰۱) حدَّثَنَا وَکِیعٌ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُقْضَی ، عَنْ مَیِّتٍ اعْتِکَافٌ۔","","Musannaf Ibn Abi Shaybah 12701","","","كتاب الأيمان والنذور والكفارات"
"12702","(۱۲۷۰۲) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ طَاوُوس یَقُولُ فِی النَّذْرِ عَلَی الْمَیِّتِ : یَقْضِیہِ وَرَثَتُہُ بَیْنَہُمْ : إِنْ کَانَ عَلَی رَجُلٍ صَوْمُ سَنَۃٍ إِنْ شَاؤُوا صَامُوا کُلُّ إنْسَانٍ ثَلاَثَۃَ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 12702","","","كتاب الأيمان والنذور والكفارات"
"12703","(۱۲۷۰۳) عن ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ أَنْ یُطْعِمَ الرَّجُلُ مِنْ لَحْمِ أُضْحِیَّتِہِ الْمَسَاکِینَ فِی کَفَّارَۃِ الْیَمِینِ۔","","Musannaf Ibn Abi Shaybah 12703","","","كتاب الأيمان والنذور والكفارات"
"12704","(۱۲۷۰۴) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ الرَّجُلُ لِلرَّجُلِ ہُوَ یُہْدِیہِ عَلَی أشْفَارِ عَیْنَیْہِ ، قَالَ : یُحِجُّہُ ، وَیَنْحَرُ بَدَنَۃً۔","","Musannaf Ibn Abi Shaybah 12704","","","كتاب الأيمان والنذور والكفارات"
"12705","(۱۲۷۰۵) جَرِیرٌ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ سُئِلَ عَنِ امْرَأَۃٍ أَہْدَتْ کُلَّ شَیْئٍ تَأْکُلُہُ من شیء تصنعہ خَادِمہَا ، قَالَ : لَہَا مِنْہَا بد تَبِیعُہَا۔","","Musannaf Ibn Abi Shaybah 12705","","","كتاب الأيمان والنذور والكفارات"
"12706","(۱۲۷۰۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یُفْطِرُ أَیَّامًا فِی رَمَضَانَ ، قَالَ : عَلَیْہِ فِی کُلِّ یَوْمٍ کَفَّارَۃٌ۔","","Musannaf Ibn Abi Shaybah 12706","","","كتاب الأيمان والنذور والكفارات"
"12707","(۱۲۷۰۷) ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَتَی رَجُلٌ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : ہَلَکْت ، فَقَالَ : وَمَا أَہْلَکَک ؟ قَالَ : وَقَعْت عَلَی امْرَأَتِی فِی رَمَضَانَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَعْتِقْ رَقَبَۃً ، قَالَ : لاَ أَجِدُہَا ، فَقَالَ : صُمْ شَہْرَیْنِ مُتَتَابِعَیْنِ ، قَالَ : لاَ أَقْوَی ، قَالَ : فَأَطْعِمْ سِتِّینَ مِسْکِینًا ، قَالَ : لاَ أَجِدُ ، فَقَالَ : اجْلِسْ فَجَلَسَ فَبَیْنَمَا ہُوَ کَذَلِکَ إذْ أُتِیَ بِعَرْقٍ فِیہِ تَمْرٌ ، فَقَالَ لَہُ : النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اذْہَبْ فَتَصَدَّقْ بِہِ ، فَقَالَ : یَا رَسُولَ اللہِ وَالَّذِی بَعَثَک بِالْحَقِّ مَا بَیْنَ لاَبَتَیْہَا أَہْلُ بَیْتٍ أَحْوَجُ إلَیْہِ مِنَّا ، قَالَ : فَضَحِکَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی بَدَتْ أَنْیَابُہُ ، ثُمَّ قَالَ : انْطَلِقْ فَأَطْعِمْہُ عِیَالَک۔","Sahih","Musannaf Ibn Abi Shaybah 12707","","","كتاب الأيمان والنذور والكفارات"
"12708","(۱۲۷۰۸) حدَّثَنَا أبُو خَالِدٍ الأَحمر ، عَنِ ابْنِ عَجْلاَنَ ، عَنِ الْمُطَّلِبِ بْنِ السَّائِبِ بْنِ أَبِی وَدَاعَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنِّی أَفْطَرْت یَوْمًا مِنْ رَمَضَانَ ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَصَدَّقْ وَاسْتَغْفِرِ اللَّہَ وَصُمْ یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 12708","","","كتاب الأيمان والنذور والكفارات"
"12709","(۱۲۷۰۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنِ ابْنِ الْمُطَوِّسِ ، عَنِ الْمُطَوِّسِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ مِنْ غَیْرِ رُخْصَۃٍ لَمْ یُجْزِہِ صِیَامُ الدَّہْرِ۔ (ترمذی ۷۲۳۔ ابن ماجہ ۱۶۷۲)","Da'if","Musannaf Ibn Abi Shaybah 12709","","","كتاب الأيمان والنذور والكفارات"
"12710","(۱۲۷۱۰) حدَّثَنَا أبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ الْمُغِیرَۃِ بْنِ عَبْدِ اللہِ الْیَشْکُرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ قَالَ : قَالَ عَبْد اللہِ : مَنْ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ مُتَعَمِّدًا مِنْ غَیْرِ سَفَرٍ ، وَلاَ مَرَضٍ لَمْ یَقْضِہِ أَبَدًا وَإِنْ صَامَ الدَّہْرَ کُلَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 12710","","","كتاب الأيمان والنذور والكفارات"
"12711","(۱۲۷۱۱) حدَّثَنَا أبُو مُعَاوِیَۃَ ، عَنْ عُمَرَ بْنِ یَعْلَی الثَّقَفِیِّ ، عَنْ عَرْفَجَۃَ ، عَنْ عَلِیٍّ ، قَالَ : مَنْ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ مُتَعَمِّدًا لَمْ یَقْضِہِ أَبَدًا طُولَ الدَّہْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 12711","","","كتاب الأيمان والنذور والكفارات"
"12712","(۱۲۷۱۲) حدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَعَنِ ابْنِ أَبِی خَالِدٍ ، عَنْ عَامِرٍ فِی الَّذِی یُفْطِرُ یَوْمًا مِنْ رَمَضَانَ متعمدا ، قَالاَ : یَسْتَغْفِرُ اللَّہَ وَیَتُوبُ إلَیْہِ ، وَلاَ یَعُدْ وَیَقْضِی یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 12712","","","كتاب الأيمان والنذور والكفارات"
"12713","(۱۲۷۱۳) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشِامٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ؛ فِی الرَّجُلِ یُفْطِرُ یَوْمًا مِنْ رَمَضَانَ مُتَعَمِّدًا ، قَالَ : عَلَیْہِ صِیَامُ شَہْرٍ۔","","Musannaf Ibn Abi Shaybah 12713","","","كتاب الأيمان والنذور والكفارات"
"12714","(۱۲۷۱۴) وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : عَلَیْہِ صِیَامُ ثَلاَثَۃِ آلاَفِ یَوْمٍ۔","","Musannaf Ibn Abi Shaybah 12714","","","كتاب الأيمان والنذور والكفارات"
"12715","(۱۲۷۱۵) حدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ الْحَذَّائِ ، قَالَ : قَالَ عَاصِمٌ : سَأَلْت جَابِرَ بْنَ زَیْدٍ أَبَا الشَّعْثَائَ فَقُلْت : أَبَلَغَکَ فِی مَنْ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ ، مَاذَا عَلَیْہِ ؟ قَالَ : لاَ وَلَکِنْ لِیَصُمْ یَوْمًا مَکَانَہُ وَیَصْنَعُ مِنْ ذَلِکَ مَعْرُوفًا۔","","Musannaf Ibn Abi Shaybah 12715","","","كتاب الأيمان والنذور والكفارات"
"12716","(۱۲۷۱۶) حدَّثَنَا أبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَتُوبُ وَیَسْتَغْفِرُ وَیَصُومُ یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 12716","","","كتاب الأيمان والنذور والكفارات"
"12717","(۱۲۷۱۷) حدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فِی رَجُلٍ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ مُتَعَمِّدًا ، قَالَ : یَسْتَغْفِرُ اللَّہَ مِنْ ذَلِکَ وَیَتُوبُ إلَیْہِ وَیَقْضِی یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 12717","","","كتاب الأيمان والنذور والكفارات"
"12718","(۱۲۷۱۸) حدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قُلْتُ لَہُ : رَجُلٌ أَفْطَرَ یَوْمًا مِنْ رَمَضَانَ مُتَعَمِّدًا مَا کَفَّارَتُہُ ؟ قَالَ : مَا أَدْرِی مَا کَفَّارَتُہُ ، ذَنْبٌ أَصَابَہُ ، یَسْتَغْفِرُ اللَّہَ وَیَقْضِی یَوْمًا مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 12718","","","كتاب الأيمان والنذور والكفارات"
"12719","(۱۲۷۱۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَقْضِی یَوْمًا مَکَانَہُ وَیَسْتَغْفِرُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 12719","","","كتاب الأيمان والنذور والكفارات"
"12720","(۱۲۷۲۰) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَیْرِ ، عَنْ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ عَائِشَۃَ ، قَالَتْ : أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ ، فَذَکَرَ أَنَّہُ احْتَرَقَ ، فَسَأَلَہُ عَنْ أَمْرِہِ ، فَذَکَرَ أَنَّہُ وَقَعَ عَلَی امْرَأَتِہِ فِی رَمَضَانَ ، فَأُتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِکْتَلٍ یُدْعَی الْعَرَقُ فِیہِ تَمْرٌ ، فَقَالَ : أَیْنَ الْمُحْتَرِقُ ؟ فَقَامَ الرَّجُلُ ، فَقَالَ : تَصَدَّقْ بِہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 12720","","","كتاب الأيمان والنذور والكفارات"
"12721","(۱۲۷۲۱) حدَّثَنَا وَکِیعٌ ، عَنْ سَلاَّمِ بْنِ مِسْکِینٍ ، أَنَّہُ سَأَلَ جَابِرَ بْنَ زَیْدٍ وَالْحَسَنَ ، عَنِ امْرَأَۃٍ جَعَلْت عَلَیْہَا ہَدْیًا ، فَقَالَ جَابِرُ بْنُ زَیْدٍ : إِنْ کَانَتْ مُوسِرَۃً فَبَقَرَۃٌ ، وَإِنْ کَانَتْ مُعْسِرَۃً فَشَاۃٌ ، وَقَالَ الْحَسَنُ : کَفَّارَۃُ یَمِینٍ تَصُومُ ثَلاَثَۃَ أَیَّامٍ۔","","Musannaf Ibn Abi Shaybah 12721","","","كتاب الأيمان والنذور والكفارات"
"12722","(۱۲۷۲۲) حدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ یُونُسَ، عَنِ الْحَسَنِ، أَنَّہُ قَالَ؛ فِی الرَّجُلِ یَقُولُ عَلَیَّ ہَدْیٌ، أَوْ علَیَّ نَذْرٌ، قَالَ یَمِینٌ۔","","Musannaf Ibn Abi Shaybah 12722","","","كتاب الأيمان والنذور والكفارات"
"12723","(۱۲۷۲۳) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَلَمَۃَ أَبِی بِشرٍ ، عَنْ عِکْرِمَۃَ ؛ فِی الرَّجُلِ یَحْلِفُ بِالبدن وَالْہَدْیِ ، قَالَ : مِنْ خطوَاتِ الشّیطَانِ۔","","Musannaf Ibn Abi Shaybah 12723","","","كتاب الأيمان والنذور والكفارات"
"12724","(۱۲۷۲۴) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ فِی رَجُلٍ قَالَ عَلَیَّ ہَدْیٌ ، قَالَ : لاَ أَقَلُّ مِنْ شَاۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12724","","","كتاب الأيمان والنذور والكفارات"
"12725","(۱۲۷۲۵) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، قَالاَ ، إذَا قَالَ : عَلَیَّ ہَدْیٌ ، وَلَمْ یُسَمِّ شَیئًا قَالاَ : یَمِینٌ۔","","Musannaf Ibn Abi Shaybah 12725","","","كتاب الأيمان والنذور والكفارات"
"12726","(۱۲۷۲۶) حدَّثَنَا عَبد الوہاب ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ قَالَ : إذَا قَالَ عَلَیَّ ہَدْیٌ ، وَلَمْ یُسَمِّ فَلْیُہْدِ مَا شَائَ وَلَوْ کُبَّۃ مِنْ غَزْلٍ۔","","Musannaf Ibn Abi Shaybah 12726","","","كتاب الأيمان والنذور والكفارات"
"12727","(۱۲۷۲۷) حدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، قَالَ : أَتَتِ امْرَأَۃٌ شُرَیْحًا ، فَقَالَتْ : إنِّی نَذَرْت أَنْ أَعْتَکِفَ فِی الْمَسْجِدِ ، وَإنَّ السُّلْطَانَ منعَنی ، قَالَ : فَکَفِّرِی عَنْ یَمِینِک۔","","Musannaf Ibn Abi Shaybah 12727","","","كتاب الأيمان والنذور والكفارات"
"12728","(۱۲۷۲۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنِ امْرَأَۃٍ جَعَلَتْ عَلَیْہَا أَنْ تَعْتَکِفَ شَہْرًا فِی الْمَسْجِدِ الْجَامِعِ ، فَطلب إلیہا أمر لاَ تَسْتَطِیعُ أَنْ تَظْہرَ ، قَالَ : تَعْتَکِفُ فِی مَسْجِدٍ تأمن بِہِ۔","","Musannaf Ibn Abi Shaybah 12728","","","كتاب الأيمان والنذور والكفارات"
"12729","(۱۲۷۲۹) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُسْتَحْلَفُ بِالطَّلاَقِ فَیَحْلِفُ ، قَالَ : الْیَمِینُ عَلَی مَا اسْتَحْلَفَہُ الذی یَستَحْلِفہ ، وَلَیْسَ نِیَّۃُ الْحَالِفِ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 12729","","","كتاب الأيمان والنذور والكفارات"
"12730","(۱۲۷۳۰) حدَّثَنَا مُعْتَمِرٌ ، عَنْ عِمْرَانَ ، عَنِ الْحَسَنِ ، قَالَ : مَنْ حَلَفَ لِرَجُلٍ عَلَی یَمِینٍ یَرَی أنہا لَیْسَتْ بِیَمِینٍ فَہِیَ یَمِینٌ عَاقِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 12730","","","كتاب الأيمان والنذور والكفارات"
"12731","(۱۲۷۳۱) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ أَبِی الْعَلاَئِ، عَنْ أَبِی ہَاشِمٍ، عَنْ إبْرَاہِیمَ، قَالَ: الْیَمِینُ عَلَی نِیَّۃِ الْمُسْتَحْلِفِ۔","","Musannaf Ibn Abi Shaybah 12731","","","كتاب الأيمان والنذور والكفارات"
"12732","(۱۲۷۳۲) حدَّثَنَا یَزِیدُ ، قَالَ : حدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا عَبَّادُ بْنُ أَبِی صَالِحٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْیَمِینُ عَلَی نِیَّۃِ الْمُسْتَحْلِفِ۔ (مسلم ۲۲۔ ابوداؤد ۳۲۵۰)","Hasan","Musannaf Ibn Abi Shaybah 12732","","","كتاب الأيمان والنذور والكفارات"
"12733","(۱۲۷۳۳) حدَّثَنَا یَزِیدُ ، قَالَ حدَّثَنَا أَبُو مَعْشَرٍ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، عَنِ ابْنِ فَغْوَائِ ، قَالَ : قَالَ عُمَرُ ، یَمِینُک عَلَی مَا صَدَّقک صَاحِبُک۔","Da'if","Musannaf Ibn Abi Shaybah 12733","","","كتاب الأيمان والنذور والكفارات"
"12734","(۱۲۷۳۴) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانَ مَظْلُومًا فَلَہُ أَنْ یُوَرِّکَ بِیَمِینٍ ، فَإِنْ کَانَ ظَالِمًا فَلَیْسَ لَہُ أَنْ یُوَرِّکَ۔","","Musannaf Ibn Abi Shaybah 12734","","","كتاب الأيمان والنذور والكفارات"
"12735","(۱۲۷۳۵) حدَّثَنَا حفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ: إذَا قَالَ: لَمْ أَحْلِفْ ، قَالَ: یَمِینٌ یُکَفِّرُہَا۔","","Musannaf Ibn Abi Shaybah 12735","","","كتاب الأيمان والنذور والكفارات"
"12736","(۱۲۷۳۶) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : کَانَ إبْرَاہِیمُ فِی أَصْحَابِ الْمَلاَء ، فَسُئِلَ عَنْ رَجُلٍ جَعَلَ عَلَیْہِ الْمَشْیَ إلَی الْکَعْبَۃِ إِنْ دَخَلَ عَلَی ابنہ فاحْتَمَلَہُ أَصْحَابُہُ فَأَدْخَلُوہُ ، فَقَالَ إبْرَاہِیمُ بِیَدِہِ احْتَمَلُوہُ فَأَدْخَلُوہُ ، لْیَمْشِ۔","","Musannaf Ibn Abi Shaybah 12736","","","كتاب الأيمان والنذور والكفارات"
"12737","(۱۲۷۳۷) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ سَعْدَ بْنَ عُبَادَۃَ اسْتَفْتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی نَذْرٍ کَانَ عَلَی أُمِّہِ تُوُفِّیَتْ قَبْلَ أَنْ تَقْضِیَہُ ، فَقَالَ : اقْضِہِ عَنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 12737","","","كتاب الأيمان والنذور والكفارات"
"12738","(۱۲۷۳۸) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ الْحَکَمِ الْبُنَانِیِّ ، عَنْ مَیْمُونٍ ، عَنِ ابْنِ عَبَّاسٍ رضی اللَّہُ عَنْہُما سُئِلَ عَنْ رَجُلٍ مَاتَ وَعَلَیْہِ نَذْرٌ ، فَقَالَ : یُصَامُ عَنْہُ النَّذْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 12738","","","كتاب الأيمان والنذور والكفارات"
"12739","(۱۲۷۳۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ مَرَّۃً ، عَنِ ابْنِ عَبَّاسٍ : إذَا مَاتَ وَعَلَیْہِ نَذْرٌ قَضَی عَنْہُ وَلِیُّہُ۔","","Musannaf Ibn Abi Shaybah 12739","","","كتاب الأيمان والنذور والكفارات"
"12740","(۱۲۷۴۰) حدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنْ أَبِیہِ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ مَاتَ وَعَلَیْہِ نَذْرُ صَوْمٍ، قَالَ: یُطْعَمُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 12740","","","كتاب الأيمان والنذور والكفارات"
"12741","(۱۲۷۴۱) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ نَذَرَ أَنْ یَصُومَ ، فَمَاتَ قَبْلَ أَنْ یَصُومَ ، قَالَ : کَانَ یُعْجِبُہُ أَنْ یُقْضَی عَنْہُ الصَّوْمُ صَوْمًا۔","","Musannaf Ibn Abi Shaybah 12741","","","كتاب الأيمان والنذور والكفارات"
"12742","(۱۲۷۴۲) حدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ طَاوُوس فِی النَّذْرِ عَلَی الْمَیِّتِ ، قَالَ : یَقْضِیہِ وَرَثَتُہُ بَیْنَہُمْ ، إِنْ کَانَ عَلَی رَجُلٍ صَوْمُ سَنَۃٍ ، إِنْ شَائَ صَامَ کُلُّ إنْسَانٍ منہم ثَلاَثَۃَ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 12742","","","كتاب الأيمان والنذور والكفارات"
"12743","(۱۲۷۴۳) حدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ کُرَیْبٍ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ رضی اللَّہُ عَنْہُما ، عَنْ سِنَانِ بْنِ عَبْدِ اللہِ الْجُہَنِیِّ ، أَنَّہُ حَدَّثَتْہُ عَمَّتُہُ ، أَنَّہَا أَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، تُوُفِّیَتْ أُمِّی وَعَلَیْہَا مَشْیٌ إلَی الْکَعْبَۃِ نَذْرٌ ، فَقَالَ : ہَلْ تَسْتَطِیعِینَ أَنْ تَمْشِیَ عَنْہَا ؟ فَقَالَتْ : نَعَمْ ، فَقَالَ : فَامْشِ عَنْ أُمِّکَ ، فَقَالَتْ : أَیُجْزِئُ ذَلِکَ عَنْہَا ؟ فَقَالَ : نعم ، أَرَأَیْت لَوْ کَانَ عَلَیْہَا دَیْنٌ فَقَضَیْتہ ، ہَلْ کَانَ یُقْبَلُ مِنْک؟ قَالَتْ: نَعَمْ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اللَّہُ أَحَقُّ بِذَلِکَ۔ (بخاری ۲۳۳۶)","Da'if","Musannaf Ibn Abi Shaybah 12743","","","كتاب الأيمان والنذور والكفارات"
"12744","(۱۲۷۴۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ اللہِ بن عَطَاء ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذْ جَائَتْہُ امْرَأَۃٌ ، فَقَالَتْ : إنہ کَانَ عَلَی أُمِّی صَوْمُ شَہْرَیْنِ ، أَفَیُجْزِی عَنْہَا أَنْ نَصُومَ عنہَا؟ قَالَ : نَعَمْ۔","Hasan","Musannaf Ibn Abi Shaybah 12744","","","كتاب الأيمان والنذور والكفارات"
"12745","(۱۲۷۴۵) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ ، قَالَ : الْیَمِینُ الَّتِی لاَ تُکَفَّرُ : الرَّجُلُ یَحْلِفُ لِلرَّجُلِ عَلَی مَالِ رَجُلٍ مُسْلِمٍ فَیَقْتَطِعُہُ ظَالِمًا وَہُوَ فِیہِ کَاذِبٌ۔","","Musannaf Ibn Abi Shaybah 12745","","","كتاب الأيمان والنذور والكفارات"
"12746","(۱۲۷۴۶) حدَّثَنَا أبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، وَمُحَمَّدٍ ، وَالْحَسَنِ فِی قَوْلِہِ : {إنَّ الَّذِینَ یَشْتَرُونَ بِعَہْدِ اللہِ وَأَیْمَانِہِمْ ثَمَنًا قَلِیلاً} ، قَالُوا : ہُوَ الرَّجُلُ یَقْتَطِعُ مَالَ الرَّجُلِ بِیَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 12746","","","كتاب الأيمان والنذور والكفارات"
"12747","(۱۲۷۴۷) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ ، وَعَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالُوا : إذا ظَاہَرَ مِنْہَا ظِہَارًا ، وَلَمْ یَدْخُلْ فِیہ ؛ إِنْ غَشِیتُکِ ، فَلاَ حَدَّ فِی ذَلِکَ وَلاَ وَقْتَ ، إذَا کَفَّرَ غَشِیَہَا۔","","Musannaf Ibn Abi Shaybah 12747","","","كتاب الأيمان والنذور والكفارات"
"12748","(۱۲۷۴۸) حدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ کُرَیْبٍ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : سَمِعْتُہُ وَعِنْدَہُ الْمِسْوَرُ بْنُ مَخْرَمَۃَ ، وَعَبْدُ اللہِ بْنُ شَدَّادِ بْنِ الْہَادِ ، وَنَافِعُ بْنُ جُبَیْرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاَثَۃٌ لاَ یَمِینَ فِیہِنَّ : لاَ یَمِینَ لِلْوَلَدِ عَلَی وَالِدِہِ ، وَلا لِلْمَرْأَۃِ عَلَی زَوْجِہَا ، وَلاَ لِلْعَبْدِ عَلَی سَیِّدِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 12748","","","كتاب الأيمان والنذور والكفارات"
"12749","(۱۲۷۴۹) حدَّثَنَا زَیْدُ بْنُ حُبَابِ ، عَنِ ابْنِ لَہِیعَۃَ ، عَنْ خَالِدِ بْنِ أَبِی عِمْرَانَ ، قَالَ : سَأَلْتُ الْقَاسِمَ وَسَالِمًا ، عَنْ رَجُلٍ ظَاہَرَ مِنْ أ[corrupt]مَتِہِ فَلَمْ یَجِدْ مَا یُعْتِقُ ، أَیُعْتِقُہَا ؟ قَالاَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 12749","","","كتاب الأيمان والنذور والكفارات"
"12750","(۱۲۷۵۰) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ فِی الظِّہَارِ مِنَ الأَمَۃِ إذَا لَمْ یَجِدْ مَا یُعْتِقُ ، وَلَمْ یَسْتَطِعَ الصَّوْمَ فَأَرَادَ أَنْ یَتَزَوَّجَہَا جَعَلَ عِتْقَہَا مَہْرَہَا ، فَکَانَ عِتْقُہَا کَفَّارَۃَ الظِّہَارِ ، وَکَانَتِ امْرَأَتَہُ۔","","Musannaf Ibn Abi Shaybah 12750","","","كتاب الأيمان والنذور والكفارات"
"12751","(۱۲۷۵۱) حدَّثَنَا أبُو خَالِدٍ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ؛ فِی الرَّجُلِ یُظَاہِرُ مِنْ أَمَتِہِ ، قَالَ : یُجْزِیئہ أَنْ یُعْتِقَہَا۔","","Musannaf Ibn Abi Shaybah 12751","","","كتاب الأيمان والنذور والكفارات"
"12752","(۱۲۷۵۲) حدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ شَیْبَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوس ؛ فِی الرَّجُلِ یُظَاہِرُ مِنْ أُمِّ وَلَدِہِ ، وَلاَ یَجِدُ مَا یُکَفِّرُ ، قَالَ : یُعْتِقُہَا فَیَکُونُ عِتْقُہَا کَفَّارَۃً لِیَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 12752","","","كتاب الأيمان والنذور والكفارات"
"12753","(۱۲۷۵۳) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، وَالْحَسَنِ ؛ فِی الرَّجُلِ یُحَرِّمُ فِی الْغَضَبِ ، قَالَ : مِنْ نَزَعَاتِ الشَّیْطَانِ ، یُطْعِمُ عَشَرَۃَ مَسَاکِینَ ، وَإِنْ کَانَ فِی طَاعَۃِ اللہِ فَلیَفِ۔","","Musannaf Ibn Abi Shaybah 12753","","","كتاب الأيمان والنذور والكفارات"
"12754","(۱۲۷۵۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ زَاذَانَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ أَعْتَقَ عَبْدًا لَہُ ، ثُمَّ أَخَذَ مِنَ الأَرْضِ شَیْئًا ، فَقَالَ : مَا لِی مِنْ أَجْرِہِ مِثْلَ ہَذَا ، سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ لَطَمَ خَادِمًا لَہُ فَکَفَّارَتُہُ عِتْقُہُ۔ (احمد ۲۵۔ مسلم ۱۲۷۹)","Sahih","Musannaf Ibn Abi Shaybah 12754","","","كتاب الأيمان والنذور والكفارات"
"12755","(۱۲۷۵۵) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، قَالَ : عَجِلَ شَیْخٌ فَلَطَمَ خَادِمًا لَہُ ، فَقَالَ : سُوَیْد بْنُ مُقَرِّنٍ : أَعَجَزَ عَلَیْک إلاَّ حُرُّ وَجْہِہَا ؟ لَقَدْ رَأَیْتُنِی سَابِعَ سَبْعَۃٍ مِنْ بَنِی مُقَرِّنٍ مَا لَنَا خَادِمٌ إلاَّ وَاحِدَۃً لَطَمَہَا أَصْغَرُنَا ، فَأَمَرَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ نُعْتِقَہَا۔ (ابوداؤد ۵۱۲۳۔ مسلم ۳۳)","Sahih","Musannaf Ibn Abi Shaybah 12755","","","كتاب الأيمان والنذور والكفارات"
"12756","(۱۲۷۵۶) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ بَشَّارِ بْنِ کِدَامٍ السُّلَمِیِّ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَلِفُ حِنْثٌ ، أَوْ نَدَمٌ۔ (بخاری ۱۹۳۰۔ ابن حبان ۴۳۵۶)","Da'if","Musannaf Ibn Abi Shaybah 12756","","","كتاب الأيمان والنذور والكفارات"
"12757","(۱۲۷۵۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمِ بْنِ مُحَمَّدٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : إنَّ الْیَمِینَ مَأْثمۃٌ ، أَوْ مَنْدَمَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 12757","","","كتاب الأيمان والنذور والكفارات"
"12758","(۱۲۷۵۸) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، وَمُجَاہِدٍ ؛ فِی الرَّجُلِ یَقُولُ عَلَیَّ غَضَبُ اللہِ ، قَال : لَیْسَ عَلَیْہِ کَفَّارَۃٌ ، ہُوَ أَشَدُّ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 12758","","","كتاب الأيمان والنذور والكفارات"
"12759","(۱۲۷۵۹) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ ؛ فِی الرَّجُلِ یَقُولُ : قطَعَ اللَّہُ ظَہْرِی ، قَطَعَ اللَّہُ صُلْبِی، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 12759","","","كتاب الأيمان والنذور والكفارات"
"12760","(۱۲۷۶۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، قَالَ : یُکَفِّرُ۔","","Musannaf Ibn Abi Shaybah 12760","","","كتاب الأيمان والنذور والكفارات"
"12761","(۱۲۷۶۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنْ طَاوُوسٍ ، قَالَ : یُکَفِّرُ۔","","Musannaf Ibn Abi Shaybah 12761","","","كتاب الأيمان والنذور والكفارات"
"12762","(۱۲۷۶۲) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَغْشَی امْرَأَتَہُ وَیَأْکُلُ فِی رَمَضَانَ فِی یَوْمٍ وَاحِدٍ ، قَالَ : کَفَّارَۃٌ وَاحِدَۃٌ یُحَرِّرُ مُحَرَّرًا۔","","Musannaf Ibn Abi Shaybah 12762","","","كتاب الأيمان والنذور والكفارات"
"12763","(۱۲۷۶۳) حدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : الْمُظَاہِرُ یُکَفِّرُ وَإِنْ بَرَّ۔","","Musannaf Ibn Abi Shaybah 12763","","","كتاب الأيمان والنذور والكفارات"
"12764","(۱۲۷۶۴) حدَّثَنَا الضَّحَّاکُ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: إذَا بَرَّ الْمُظَاہِرُ لَمْ یُکَفِّرْ، وَقَالَ: الضَّحَّاکُ: وَبِہِ نَقُولُ۔","","Musannaf Ibn Abi Shaybah 12764","","","كتاب الأيمان والنذور والكفارات"
"12765","(۱۲۷۶۵) حدَّثَنَا وَکِیعٌ ، عَنْ أَسْلَمَ مَوْلَی عَنْبَسَۃَ ، أَنَّہُ قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ امْرَأَۃٍ حَلَفَتْ لاَ تَشْرَبُ مِنْ لَبَنِ عَنْزٍ لِزَوْجِہَا ، فَشَرِبَتْ ، قَالَ : لَیْسَ عَلَیْہَا شَیْئٌ ، لَیْسَ فِی الطَّعَامِ وَالشَّرَابِ یَمِینٌ۔","","Musannaf Ibn Abi Shaybah 12765","","","كتاب الأيمان والنذور والكفارات"
"12766","(۱۲۷۶۶) حدَّثَنَا جَعْفَرٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : کَانَ رَجُلٌ لَہُ أَعَنْزٌ ، فَحَلَفَ أَنْ لاَ یَشْرَبَ مِنْ أَلْبَانَّہَا ، فَلَمَّا رَأَتِ امْرَأَتُہُ ذَلِکَ حَلَفَتْ أَنْ لاَ تَشْرَبَ مِنْ أَلْبَانَّہَا ، فَجافَوُا الأَعَنْزَ وَضَیَّعُوہُنَّ ، فَأَتَی عَبْدَ اللہِ فَذَکَرَ لَہُ ذَلِکَ ، فَقَالَ : إنَّمَا ذَا مِنَ الشَّیْطَانِ ارْجِعَا إلَی أَحْسَنِ مَا کُنْتُمَا عَلَیْہِ وَاشْرَبَا۔","Sahih","Musannaf Ibn Abi Shaybah 12766","","","كتاب الأيمان والنذور والكفارات"
"12767","(۱۲۷۶۷) حدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ لِرَجُلٍ مِنَ الأَنْصَارِ ضَیْفٌ ، فَأَبْطَأَ عَنْ أَہْلِہِ ، فَقَالَ : عَشَّیْتُمْ ضیفی ، قَالُوا : لاَ ، قَالَ : لاَ وَاللَّہِ لاَ أَطْعَمُ اللَّیْلَۃَ مِنْ عَشَائِکُمْ ، فَقَالَتِ امْرَأَتُہُ : إذًا وَاللَّہِ لاَ أَطْعَمُہُ ، قَالَ : فَقَالَ الضَّیْفُ : وَأنا وَاللَّہِ لاَ أَطْعَمُہُ أَیْضًا ، قَالَ : فَقَالَ : یَبِیتُ ضَیْفِی بِغَیْرِ طَعَامٍ ، قَرِّبُوا طَعَامَکُمْ ، فَأَکَلُوا مَعَہُ ، فَلَمَّا أَصْبَحَ غَدَا إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرَہُ بِذَلِکَ ، فَقَالَ : أَطَعْت اللَّہَ وَعَصَیْت الشَّیْطَانَ۔","","Musannaf Ibn Abi Shaybah 12767","","","كتاب الأيمان والنذور والكفارات"
"12768","(۱۲۷۶۸) حدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، حَدَّثَنِی یَعْلَی بْنُ حَکِیمٍ ، عَنِ الزُّبَیْرِ بْنِ الْخِرِّیتِ ، عَنْ عِکْرِمَۃَ ، قَالَ : مَا أفتیت بِرَأْیِی شَیْئًا قطُّ غیر ہَذِہِ ، سَأَلَتْنِی امْرَأَۃٌ نَذَرَتْ أَنْ تَطُوفَ بِالْبَیْتِ عَلَی أَرْبَعِ قَوَائِمَ، فَقُلْت لَہَا : طُوفِی لِکُلِّ قَائِمَۃٍ سَبْعًا۔","","Musannaf Ibn Abi Shaybah 12768","","","كتاب الأيمان والنذور والكفارات"
"12769","(۱۲۷۶۹) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ عَطَائً وَسُئِلَ عَنِ امْرَأَۃٍ حَلَفَتْ بِعِتْقِ جَارِیَتِہَا أَنْ لاَ تُکَلِّمَ جَارَتَہَا أَرْبَعَ سِنِینَ ، فَمَاتَتْ جَارِیَتُہَا ، وَأَحَبَّتْ أَنْ تُکَلِّمَ جَارَتَہَا ، قَالَ : تُکَلِّمُہَا وَتَصَدَّقُ بِشَیْئٍ ، وَقَالَ : ابْنُ أَبِی مُلَیْکَۃَ : لاَ أَرَی عَلَیْہَا حِنْثًا۔","","Musannaf Ibn Abi Shaybah 12769","","","كتاب الأيمان والنذور والكفارات"
"12770","(۱۲۷۷۰) حدَّثَنَا ابْنُ یَمَانٍ، عَنْ سُفْیَانَ، عَنْ جابر، عَنْ عَامِرٍ؛ فِی الرَّجُلِ یَقُولُ: أَلْقَانِی اللَّہُ فِی النَّارِ، قَالَ: یُکَفِّرُ۔","","Musannaf Ibn Abi Shaybah 12770","","","كتاب الأيمان والنذور والكفارات"
"12771","(۱۲۷۷۱) حدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، وَطَاوُوس ، قَالاَ : لاَ یُکَفِّرُ۔","","Musannaf Ibn Abi Shaybah 12771","","","كتاب الأيمان والنذور والكفارات"
"12772","(۱۲۷۷۲) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ؛ فِی الرَّجُلِ یَحْلِفُ أن لاَ یَأْکُلُ مِنْ ہَذَا الطَّعَامِ فَیَبِیعُہُ ، قَالَ : یَأْکُلُ ثَمَنَہُ وَیَشْتَرِی بِہِ۔","","Musannaf Ibn Abi Shaybah 12772","","","كتاب الأيمان والنذور والكفارات"
"12773","(۱۲۷۷۳) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ حَمَّاد ، عَنْ إِبرَہیم قَالَ : لاَ یَبِیعُہُ وَلاَ یَشْتَرِی بِہِ طَعَامًا فَیَأْکُلُہُ۔","","Musannaf Ibn Abi Shaybah 12773","","","كتاب الأيمان والنذور والكفارات"
"12774","(۱۲۷۷۴) حدَّثَنَا أبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ شُرَحْبِیلَ بْنِ السِّمْطِ ، قَالَ : قلْنَا لِکَعْبِ بْنِ مُرَّۃَ : یَا کَعْب بْنِ مُرَّۃَ ، حدَّثَنَا عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَاحْذَرْ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ أَعْتَقَ امْرَئًا مُسْلِمًا کَانَ فَکَاکُہُ مِنَ النَّارِ، یُجْزِی بِکُلُّ عَظْمٍ مِنْہُ عَظْمًا مِنْہُ ، وَمَنْ أَعْتَقَ امْرَأَتَیْنِ مُسْلِمَتَیْنِ کَانَتَا فَکَاکُہُ مِنَ النَّارِ ، یُجْزِی بکل عظمین مِنْہُمَا عَظْمٌ مِنْہُ۔ (نسائی ۲۸۸۱۔ احمد ۴/۲۳۵)","","Musannaf Ibn Abi Shaybah 12774","","","كتاب الأيمان والنذور والكفارات"
"12775","(۱۲۷۷۵) حدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ ، عَنْ عُمَرَ بْنِ عَلِیِّ بْنِ حُسَیْنٍ ، عَنْ سَعِیدِ بْنِ مَرْجَانَۃَ ، قَالَ : سَمِعْتُہُ یُحَدِّثُ عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ أَعْتَقَ رَقَبَۃً مُؤْمِنَۃً أَعْتَقَ اللَّہُ بِکُلِّ عُضْوٍ مِنْہُ عُضْوًا مِنَ النَّارِ حَتَّی یُعْتِقَ فَرْجَہُ بِفَرْجِہِ۔n(بخاری ۲۵۱۷۔ مسلم ۱۱۴۷)","Sahih","Musannaf Ibn Abi Shaybah 12775","","","كتاب الأيمان والنذور والكفارات"
"12776","(۱۲۷۷۶) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا الْحَکَمُ بْنُ عَبْدِ الرَّحْمَنِ ابْنِ أَبِی نُعْمٍ ، قَالَ : حَدَّثَتْنِی فَاطِمَۃُ بِنْتُ عَلِیٍّ ، قَالَتْ : قَالَ : أَبِی عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَعْتَقَ نَسَمَۃً مُسْلِمَۃً ، أَوْ مُؤْمِنَۃً وَقَی اللَّہُ بِکُلِّ عُضْوٍ مِنْہُ عُضْوًا مِنَ النَّارِ۔ (نسائی ۴۸۷۷)","Da'if","Musannaf Ibn Abi Shaybah 12776","","","كتاب الأيمان والنذور والكفارات"
"12777","(۱۲۷۷۷) حدَّثَنَا عَبْدَۃُ ، عَنْ صَالِحِ بْنِ حَیٍّ ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَتْ لَہُ جَارِیَۃٌ فَأَدَّبَہَا فَأَحْسَنَ تَأْدِیبَہَا ، وَعَلَّمَہَا فَأَحْسَنَ تَعْلِیمَہَا ، ثُمَّ أَعْتَقَہَا وَتَزَوَّجَہَا فَلَہُ أَجْرَانِ۔ (بخاری ۲۵۴۴۔ ابوداؤد ۲۰۴۶)","Sahih","Musannaf Ibn Abi Shaybah 12777","","","كتاب الأيمان والنذور والكفارات"
"12778","(۱۲۷۷۸) حدَّثَنَا عَبْدَۃُ ، عَنْ عبد الملک ، عَنْ عَطَائٍ ؛ فِی امْرَأَۃٍ نَذَرَتْ أَنْ تَعْتَکِفَ شَہْرَیْنِ ، فَجَعَلَتْ تقطع ، قَالَ : إذَا أَکْمَلَتِ الْعِدَّۃَ أَجْزَأَ عَنْہَا۔","","Musannaf Ibn Abi Shaybah 12778","","","كتاب الأيمان والنذور والكفارات"
"12779","(۱۲۷۷۹) حدَّثَنَا أبُو خَالِدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرِو بْنِ عَبْدِ اللہِ الأَنْصَارِیِّ ، أَنَّ رَجُلاً نَذَرَ أَنْ یَنْحَرَ بَدَنَۃً ، فَأَتَی عَبْدَ اللہِ بْنَ مُحَمَّدِ بْنِ عَلِیٍّ ، فَقَالَ : الْبُدْنُ مِنَ الإِبِلِ ، وَلاَ تُنْحَرُ إلاَّ بِمَکَّۃَ ، إلاَّ إِنْ نَوَی مَنْحَرًا فَحَیْثُ نَوَی ، فَإِنْ لَمْ یَجِدْ فَسَبْعٌ مِنَ الْغَنَمِ ، قَالَ : وَسَأَلْت سَالِمًا فَقَالَ مِثْلَ ذَلِکَnقَالَ : وَسَأَلْت سَعِیدَ بْنَ الْمُسَیَّبِ ، فَقَالَ : مِثْلَ ذَلِکَ ، إلاَّ إِنَّہُ قَالَ : فَإِنْ لَمْ یَجِدْ فَعَشَرَۃٌ مِنَ الْغَنَمِ ، قَالَ : وَسَأَلْت خَارِجَۃَ بْنَ زَیْدٍ وَأَخْبَرتہُ بِمَا قَالَ الْقَوْمُ ، فَقَالَ : مَا أَدْرَکْت أَصْحَابَنَا یَعُدُّونَہَا إلاَّ سَبْعًا مِنَ الْغَنَمِ۔","","Musannaf Ibn Abi Shaybah 12779","","","كتاب الأيمان والنذور والكفارات"
"12780","(۱۲۷۸۰) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ سُلَیْمَانُ بْنُ حَیَّانَ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنْ عَاصِمٍ ، عَنْ شَقِیقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَابِعُوا بَیْنَ الْحَجِّ وَالْعُمْرَۃِ ، فَإِنَّہُمَا یَنْفِیَانِ الْفَقْرَ وَالذُّنُوبَ ، کَمَا یَنْفِی الْکِیرُ خَبَثَ الْحَدِیدِ وَالذَّہَبِ وَالْفِضَّۃِ ، وَلَیْسَ لِحَجَّۃٍ مَبْرُورَۃٍ جزائٌ إلاَّ الْجَنَّۃُ۔n(ترمذی ۸۱۰۔ احمد ۱/۳۸۷)","Hasan","Musannaf Ibn Abi Shaybah 12780","","","كتاب الحج"
"12781","(۱۲۷۸۱) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ، عَنْ عُمَرَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَابِعُوا بَیْنَ الْحَجِّ وَالْعُمْرَۃِ ، فَإِنَّہُمَا یَنْفِیَانِ الْفَقْرَ وَالذُّنُوبَ کَمَا یَنْفِی الْکِیرُ خَبَثَ الْحَدِیدِ۔ (ابن ماجہ ۲۸۸۷۔ احمد ۱/۲۵)","Da'if","Musannaf Ibn Abi Shaybah 12781","","","كتاب الحج"
"12782","(۱۲۷۸۲) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ سُمَیٍّ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعُمْرَۃُ إلَی الْعُمْرَۃِ کَفَّارَۃٌ لِمَا بَیْنَہُمَا ، وَالْحَجُّ الْمَبْرُورُ لَیْسَ لَہُ جَزَائٌ إِلاَّ الْجَنَّۃُ۔n(بخاری ۱۷۷۳۔ مسلم ۹۸۳)","Sahih","Musannaf Ibn Abi Shaybah 12782","","","كتاب الحج"
"12783","(۱۲۷۸۳) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، وَسُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ حَجَّ فَلَمْ یَرْفُثْ ، وَلَمْ یَفْسُقْ رَجَعَ کَمَا وَلَدَتْہُ أُمُّہُ۔n(بخاری ۱۸۲۰۔ ترمذی ۸۱۱)","Sahih","Musannaf Ibn Abi Shaybah 12783","","","كتاب الحج"
"12784","(۱۲۷۸۴) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی الضُّحَی ؛ أَخْبَرَہُ شَیْخٌ فِی ہَذَا الْمَسْجِدِ ؛ أَنَّ عُمَرَ خَطَبَہُمْ عِنْدَ بَابِ الْکَعْبَۃِ ، وَقَالَ : مَا مِنْ أَحَدٍ یَجِیئُ إلَی ہَذَا الْبَیْتِ ، لاَ یَنْہَزُہُ غَیْرُ صَلاَۃٍ فِیہِ حَتَّی یَسْتَلِمَ الْحَجَرَ ، إِلاَّ کُفِّرَ عَنْہُ مَا کَانَ قَبْلَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 12784","","","كتاب الحج"
"12785","(۱۲۷۸۵) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی الضُّحَی ، عَنْ شَیْخٍ ، قَالَ ، قَالَ عُمَرُ بْنُ الْخَطَّابِ : مَنْ حَجَّ ہَذَا الْبَیْتَ لاَ یُرِیدُ غَیْرَہُ ، خَرَجَ مِنْ ذُنُوبِہِ کَیَوْمِ وَلَدَتْہُ أُمُّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 12785","","","كتاب الحج"
"12786","(۱۲۷۸۶) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی صَالِحٍ ، قَالَ : کَانَتِ امْرَأَۃٌ مِنَ الْمُہَاجِرَاتِ تَحُجُّ ، فَإِذَا رَجَعَتْ مَرَّتْ عَلَی عُمَرَ ، فَیَقُولُ لَہَا : أَنْقبْتِ ؟ فَتَقُولُ : نَعَمْ ، فَیَقُولُ لَہَا : اسْتَأْنِفِی الْعَمَلَ۔","","Musannaf Ibn Abi Shaybah 12786","","","كتاب الحج"
"12787","(۱۲۷۸۷) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مُجَاہِدٍ ، قَالَ : بَیْنَمَا عُمَرُ جَالِسًا عِنْدَ الْبَیْتِ إذْ قَدِمَ رِجَالٌ مِنَ الْعِرَاقِ حُجَّاجًا ، فَطَافُوا بِالْبَیْتِ ، وَسَعَوْا بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، فَدَعَاہُمْ عُمَرُ ، فَقَالَ : أَنْہَزَکُمْ إلَیْہِ غَیْرُہُ ؟ فَقَالُوا : لاَ ، فَقَالَ : أَنْقبْتُمْ ؟ قَالُوا : نَعَمْ ، فَقَالَ : أَدْبَرْتُمْ ؟ قَالُوا : نَعَمْ ، قَالَ : إِمَّا لاَ ، فَاسْتَأْنِفُوا الْعَمَلَ۔","Da'if","Musannaf Ibn Abi Shaybah 12787","","","كتاب الحج"
"12788","(۱۲۷۸۸) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ حَبِیبٍ ؛ أَنَّ قَوْمًا مَرُّوا بِأَبِی ذَرٍّ بِالرَّبَذَۃِ ، فَقَالَ لَہُم : مَا أَنْصَبکُمْ إِلاَّ الْحَجُّ ؟ اسْتَأْنِفُوا الْعَمَلَ۔","","Musannaf Ibn Abi Shaybah 12788","","","كتاب الحج"
"12789","(۱۲۷۸۹) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ ابْنَ مَسْعُودٍ قَالَ ذَلِکَ لِقَوْمٍ۔","","Musannaf Ibn Abi Shaybah 12789","","","كتاب الحج"
"12790","(۱۲۷۹۰) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ حُسَیْنٍ ، عَنْ کَعْبٍ ، قَالَ : رَأَی قَوْمًا مِنَ الْحَاجِّ ، فَقَالَ : لَ[corrupt]ْ یَعْلَمُ ہَؤُلاَئِ مَا لَہُمْ بَعْدَ الْمَغْفِرَۃِ ، لَقَرَّتْ عُیُونُہُمْ۔","","Musannaf Ibn Abi Shaybah 12790","","","كتاب الحج"
"12791","(۱۲۷۹۱) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَبِیبِ بْنِ الزُّبَیْرِ ، قَالَ : قُلْتُ لِعَطَائٍ : أَبَلَغَکَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اسْتَقْبِلُوا الْعَمَلَ بَعْدَ الْحَجِّ ؟ قَالَ : لاَ ، وَلَکِنْ عُثْمَانَ ، وَأَبُو ذَرٍّ۔","","Musannaf Ibn Abi Shaybah 12791","","","كتاب الحج"
"12792","(۱۲۷۹۲) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَنْ مَنْصُورٍ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ ، عَنْ کَعْبٍ ، قَالَ: إذَا کَبَّرَ الْحَاجُّ ، وَالْمُعْتَمِرُ ، وَالْغَازِی ، کَبَّرَ الرَّبْو الَّذِی یَلِیہ ، ثم الَّذِی یَلِیہِ ، ثم الَّذِی یَلِیہِ، حَتَّی یَنْقَطِعَ فِی الأُفُقِ۔","","Musannaf Ibn Abi Shaybah 12792","","","كتاب الحج"
"12793","(۱۲۷۹۳) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ مِرْدَاسَ بْنِ عَبْدِ الرَّحْمَنِ اللَّیْثِیِّ ، قَالَ : دَخَلْنَا عَلَی عَبْدِ اللہِ بْنِ عَمْرٍو فَحدَّثَنَا ، قَالَ : مَا مِنْ أَحَدٍ یُہِلُّ إِلاَّ قَالَ اللَّہُ لَہُ : أَبْشِرْ ، فَقَالَ مِرْدَاسُ : یَا أَبَا مُحَمَّدٍ ، فَوَاللَّہِ مَا یُبَشِّرُ اللَّہُ إِلاَّ بِالْجَنَّۃِ ، قَالَ : مَنْ أَنْتَ یَا ابْنَ أَخِی ؟ قَالَ : أَنَا مِرْدَاسُ ، قَالَ : قد کَانَ خِیَارُنَا یَتَتَابَعُونَ عَلَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 12793","","","كتاب الحج"
"12794","(۱۲۷۹۴) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أُسَامَۃَ بْنِ سَعِیدٍ ، عَنْ مُوسَی بْنِ سَعْدٍ ، قَالَ : قَالَ عُمَرُ : تَلَقَّوُا الْحُجَّاجَ، وَالْعُمَّارَ ، وَالْغُزَاۃَ ، فَلْیَدْعُوا لَکُمْ قَبْلَ أَنْ یَتَدَنَّسُوا۔","Da'if","Musannaf Ibn Abi Shaybah 12794","","","كتاب الحج"
"12795","(۱۲۷۹۵) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ ضَمْرَۃَ السَّلُولِیِّ ، عَنْ کَعْبٍ ، قَالَ : الْحَاجُّ ، وَالْمُعْتَمِرُ ، وَالْمُجَاہِدُ فِی سَبِیلِ اللہِ وَفْدُ اللہِ ، سَأَلُوا فَأُعْطُوا ، وَدَعَوْا فَأُجِیبُوا۔","","Musannaf Ibn Abi Shaybah 12795","","","كتاب الحج"
"12796","(۱۲۷۹۶) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ أَبِی یَعْلَی ؛ أَنَّ الْحُسَیْنَ بْنَ عَلِیٍّ لَقِیَ قَوْمًا حُجَّاجًا ، فَقَالُوا : إنَّا نُرِیدُ مَکَّۃَ ، فَقَالَ : إنَّکُمْ مِنْ وَفْدِ اللہِ ، فَإِذَا قَدِمْتُمْ مَکَّۃَ فَاجْمَعُوا حَاجَاتِکُمْ ، فَسَلُوہَا اللَّہَ۔","","Musannaf Ibn Abi Shaybah 12796","","","كتاب الحج"
"12797","(۱۲۷۹۷) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ حَبِیبِ بْنِ أبِی ثَابِتٍ ، قَالَ : کُنَّا نَتَلَقَّی الْحَاجَّ بِالْقَادِسِیَّۃِ ، فَنُصَافِحُہُمْ قَبْلَ أَنْ یُقَارِفُوا۔","","Musannaf Ibn Abi Shaybah 12797","","","كتاب الحج"
"12798","(۱۲۷۹۸) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ عَائِشَۃَ ابْنَۃِ طَلْحَۃَ ، عَنْ عَائِشَۃَ ،n قَالَتْ : قُلْتُ یَا رَسُولَ اللہِ ، عَلَی النِّسَائِ جِہَادٌ ؟ قَالَ : نَعَمْ ، جِہَادٌ لاَ قِتَالَ فِیہِ : الْحَجُّ وَالْعُمْرَۃُ۔n(بخاری ۲۸۷۵۔ احمد ۶/۱۶۵)","Sahih","Musannaf Ibn Abi Shaybah 12798","","","كتاب الحج"
"12799","(۱۲۷۹۹) حدَّثَنَا وَکِیعٌ ، عَنِ الْقَاسِمِ بْنِ الْفَضْلِ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَجُّ جِہَادُ کُلِّ ضَعِیفٍ۔ (احمد ۶/۳۰۳۔ طیالسی ۱۵۹۹)","","Musannaf Ibn Abi Shaybah 12799","","","كتاب الحج"
"12800","(۱۲۸۰۰) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : یُغْفَرُ لِلْحَاجِّ ، وَلِمَنِ اسْتَغْفَرَ لَہُ الْحَاجُّ ، بَقِیَّۃَ ذِی الْحِجَّۃِ ، وَالْمُحَرَّمِ ، وَصَفَرًا ، وَعَشْرًا مِنْ شَہْرِ رَبِیعِ الأَوَّلِ۔","Da'if","Musannaf Ibn Abi Shaybah 12800","","","كتاب الحج"
"12801","(۱۲۸۰۱) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : اللَّہُمَّ اغْفِرْ لِلْحَاجِّ ، وَلِمَنِ اسْتَغْفَرَ لَہُ الْحَاجُّ۔ (حاکم ۴۴۱)","Da'if","Musannaf Ibn Abi Shaybah 12801","","","كتاب الحج"
"12802","(۱۲۸۰۲) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْحَاجُّ وَفْدُ اللہِ ، وَالْحَاجُّ وَافِدُ أَہْلِہِ۔ (ابن ماجہ ۲۸۹۳۔ ابن حبان ۴۶۱۳)","","Musannaf Ibn Abi Shaybah 12802","","","كتاب الحج"
"12803","(۱۲۸۰۳) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبَّادٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : النَّفَقَۃُ فِی الْحَجِّ کَالنَّفَقَۃِ فِی سَبِیلِ اللہِ ، الدِّرْہَمُ بِسَبْعِ مِئَۃٍ۔ (احمد ۵/۳۵۴)","","Musannaf Ibn Abi Shaybah 12803","","","كتاب الحج"
"12804","(۱۲۸۰۴) حدَّثَنَا شَرِیکٌ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَابِعُوا بَیْنَ الْحَجِّ وَالْعُمْرَۃِ ، فَإِنَّہُمَا یَنْفِیَانِ الذُّنُوبَ والْفَقْرَ ، کَمَا یَنْفِی الْکِیرُ خَبَثَ الْحَدِیدِ۔ (احمد ۱/۲۵)","Da'if","Musannaf Ibn Abi Shaybah 12804","","","كتاب الحج"
"12805","(۱۲۸۰۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ سُوقَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَا أَتَی ہَذَا الْبَیْتَ طَالِبٌ حَاجَۃً لِدِینٍ ، أَوْ دُنْیَا ، إِلاَّ رَجَعَ بِحَاجَتِہِ۔","","Musannaf Ibn Abi Shaybah 12805","","","كتاب الحج"
"12806","(۱۲۸۰۶) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ طَافَ بِالْبَیْتِ لَمْ یَرْفَعْ قَدَمًا ، وَلَمْ یَضَعْ أُخْرَی ، إِلاَّ کُتِبَتْ لَہُ بَہَا حَسَنَۃٌ ، وَحُطَّتْ عَنْہُ بَہَا خَطِیئَۃٌ ، وَرُفِعَتْ لَہُ بِہَا دَرَجَۃٌ ، وَسَمِعْتُہُ یَقُولُ : مَنْ أَحْصَی سُبُوعًا کَانَ کَعَدْلِ رَقَبَۃٍ۔ (ترمذی ۹۵۹۔ احمد ۲/۹۵)","Da'if","Musannaf Ibn Abi Shaybah 12806","","","كتاب الحج"
"12807","(۱۲۸۰۷) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حُرَیْثِ بْنِ السَّائِبِ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ طَافَ بِالْبَیْتِ سُبُوعًا لَمْ یَلْغُ فِیہِ ، کَانَ کَعَدْلِ رَقَبَۃٍ یُعْتِقُہَا۔n(طبرانی ۸۴۵۔ حاکم ۴۵۷)","Da'if","Musannaf Ibn Abi Shaybah 12807","","","كتاب الحج"
"12808","(۱۲۸۰۸) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ الرُّؤَاسِیُّ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ طَافَ بِالْبَیْتِ خَمْسِینَ سُبُوعًا ، خَرَجَ مِنَ الذُّنُوبِ کَیَوْمِ وَلَدَتْہُ أُمُّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 12808","","","كتاب الحج"
"12809","(۱۲۸۰۹) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ عَطَائٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : مَنْ طَافَ بِالْبَیْتِ سُبُوعًا ، وَصَلَّی رَکْعَتَیْنِ ، کَانَ مِثْلَ یَوْمِ وَلَدَتْہُ أُمُّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 12809","","","كتاب الحج"
"12810","(۱۲۸۱۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : مَنْ طَافَ الْبَیْتَ کَانَ کَعَدْلِ رَقَبَۃٍ۔","","Musannaf Ibn Abi Shaybah 12810","","","كتاب الحج"
"12811","(۱۲۸۱۱) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ رَجُلٍ قَدْ سَمَّاہُ ، قَالَ : قَالَ أَبُو سَعِیدٍ : لأَنْ أَطُوفَ بِالْبَیْتِ طَوَافًا ، أَحَبُّ إلَیّ[corrupt] مِنْ أَنْ أَعْتِقَ طَہْمَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 12811","","","كتاب الحج"
"12812","(۱۲۸۱۲) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ مَوْلًی لأَبِی سَعِیدٍ ، عَنْ أَبِی سَعِیدٍ ؛ بِمِثْلِ حَدِیثِ أَبِی مُعَاوِیَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 12812","","","كتاب الحج"
"12813","(۱۲۸۱۳) قَالَ ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُجَاہِدٍ ، قَالَ : طَوَافٌ ، أَوِ الطَّوَافُ أَفْضَلُ مِنْ عُمْرَۃٍ بَعْدَ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 12813","","","كتاب الحج"
"12814","(۱۲۸۱۴) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ ابْنَ عَامِرٍ أَحْرَمَ مِنْ خُرَاسَانَ۔","","Musannaf Ibn Abi Shaybah 12814","","","كتاب الحج"
"12815","(۱۲۸۱۵) حدَّثَنَا وَکِیعٌ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَمْرِو بْنِ الْعَاصِ ، قَالَ : حجَجْتُ مَرَّۃً ، فَوَافَقْتُ عُثْمَانَ بْنَ أَبِی الْعَاصِ ، فَأَحْرَمَ مِنَ الْمَنْجَشانیۃ ، وَہِیَ قَرِیبَۃٌ مِنَ الْبَصْرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 12815","","","كتاب الحج"
"12816","(۱۲۸۱۶) حدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ: خَرَجْنَا إلَی مَکَّۃَ وَمَعَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ، فَأَحْرَمْنَا مِنَ الدَّارَاتِ۔","","Musannaf Ibn Abi Shaybah 12816","","","كتاب الحج"
"12817","(۱۲۸۱۷) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنْ مُسْلِمَ بْنَ یَسَارٍ أَحْرَمَ مِنَ الضَّرِیَّۃ۔","","Musannaf Ibn Abi Shaybah 12817","","","كتاب الحج"
"12818","(۱۲۸۱۸) حدَّثَنَا ابْنُ عُلیۃ، عَنِ ابْنِ أَبِی عَرُوبَۃَ، عَنْ قَتَادَۃَ، عَنِ الْحَسَنِ؛ أَنَّ عِمْرَانَ بْنَ الْحُصَیْنِ، أَحْرَمَ مِن الْبَصْرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 12818","","","كتاب الحج"
"12819","(۱۲۸۱۹) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ أَحْرَمَ مِنْ بَیْتِ الْمَقْدِسِ۔","Sahih","Musannaf Ibn Abi Shaybah 12819","","","كتاب الحج"
"12820","(۱۲۸۲۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ سُوقَۃَ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ؛ أَنَّ أبَا مَسْعُودٍ أَحْرَمَ مِنَ السِّیْلِحِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 12820","","","كتاب الحج"
"12821","(۱۲۸۲۱) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یُحِبُّونَ لِلرَّجُلِ أَوَّلَ مَا یَحُجُّ أَنْ یُہِلَّ مِنْ بَیْتِہِ۔","","Musannaf Ibn Abi Shaybah 12821","","","كتاب الحج"
"12822","(۱۲۸۲۲) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو الْفُقَیْمِیِّ ، عَنْ حَمْزَۃَ الْقُرَشِیِّ ، عَنْ أَبِیہِ ؛ أَنَّ ابْنَ عَبَّاسٍ أَحْرَمَ مِنَ الشَّامِ فِی بَرْدٍ شَدِیدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12822","","","كتاب الحج"
"12823","(۱۲۸۲۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِلاَلِ بْنِ خَبَّابٍ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْت مَعَ سَعِیدِ بْنِ جُبَیْرٍ مُحْرِمًا مِنَ الْکُوفَۃِ۔","","Musannaf Ibn Abi Shaybah 12823","","","كتاب الحج"
"12824","(۱۲۸۲۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، عَنِ الْحَارِثِ بْنِ قَیْسٍ ، قَالَ : خَرَجْت فِی نَفَرٍ مِنْ أَصْحَابِ عَبْدِ اللہِ نُرِیدُ مَکَّۃَ ، فَلَمَّا خَرَجْنَا مِنَ الْبُیُوتِ حَضَرَتِ الصَّلاَۃُ ، فَصَلَّوْا رَکْعَتَیْنِ ، ثُمَّ أَہَلُّوا فَأَہْلَلْتُ مَعَہُمْ ، وَلَمْ أََکُنْ أُرِیدُ ، وَلَکِنِّی کَرِہْتُ الْخِلاَفَ۔","","Musannaf Ibn Abi Shaybah 12824","","","كتاب الحج"
"12825","(۱۲۸۲۵) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ الأَسْوَدُ یُحْرِمُ مِنْ بَیْتِہِ۔","","Musannaf Ibn Abi Shaybah 12825","","","كتاب الحج"
"12826","(۱۲۸۲۶) حدَّثَنَا وَکِیعٌ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی قَیْسَ بْنَ عُبَادٍ أَحْرَمَ مِنْ مِرْبَدِ الْبَصْرَۃِ۔","","Musannaf Ibn Abi Shaybah 12826","","","كتاب الحج"
"12827","(۱۲۸۲۷) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلْقَمَۃُ إذَا خَرَجَ حَاجًّا ، أَحْرَمَ مِنَ النَّجَفِ وَقَصَرَ ، وَکَانَ الأَسْوَدُ یُحْرِمُ مِنَ الْقَادِسِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 12827","","","كتاب الحج"
"12828","(۱۲۸۲۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْجُوَیْرِیَۃِ ، قَالَ : رَأَیْتُ الأَسْوَدَ أَحْرَمَ مِنْ بَاجُمَیْرَی ، قَرْیَۃٍ مِنْ قُرَی السَّوَادِ۔","","Musannaf Ibn Abi Shaybah 12828","","","كتاب الحج"
"12829","(۱۲۸۲۹) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ الأَسْوَدَ أَحْرَمَ مِنَ الْکُوفَۃِ۔","","Musannaf Ibn Abi Shaybah 12829","","","كتاب الحج"
"12830","(۱۲۸۳۰) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَارَۃَ بْنِ زَاذَانَ ، عَنْ مَکْحُولٍ الأَزْدِیِّ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : الرَّجُلُ یُحْرِمُ مِنْ سَمَرْقَنْدَ ، وَمِنَ الْبَصْرَۃِ ، وَمِنَ الْکُوفَۃِ ، فَقَالَ : یَا لَیْتَنَا نَنْفَلِتُ مِنَ الْوَقْتِ الَّذِی وُقِّتَ لَنَا۔","Hasan","Musannaf Ibn Abi Shaybah 12830","","","كتاب الحج"
"12831","(۱۲۸۳۱) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، قَالَ : خَرَجْتُ مَعَ الْقَاسِمِ ، فَأَحْرَمَ مِنَ الرَّبَذَۃِ۔","","Musannaf Ibn Abi Shaybah 12831","","","كتاب الحج"
"12832","(۱۲۸۳۲) حدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ ابن أَبِی لَیْلَی ؛ أَنَّ عَلِیًّا أحْرَمَ مِنَ الْمَدِینَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 12832","","","كتاب الحج"
"12833","(۱۲۸۳۳) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، قَالَ : رَأَیْتُ الْحَارِثَ بْنَ سُوَیْد التَّیْمِیَّ ، وَعَمْرَو بْنَ مَیْمُونٍ أَحْرَمَا مِنَ الْکُوفَۃِ۔","","Musannaf Ibn Abi Shaybah 12833","","","كتاب الحج"
"12834","(۱۲۸۳۴) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ؛ أَنَّ عَلِیًّا سُئِلَ عَنْ قَوْلِ اللہِ عَزَّ وَجَلَّ : (وَأَتِمُّوا الْحَجَّ وَالْعُمْرَۃَ لِلَّہِ) قَالَ : أَنْ تُحْرِمَ مِنْ دُوَیْرَۃِ أَہْلِک۔","Hasan","Musannaf Ibn Abi Shaybah 12834","","","كتاب الحج"
"12835","(۱۲۸۳۵) حدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنْ طَاوُوسٍ ، قَالَ : إِتْمَامُہُمَا إفْرَادُہُمَا ، مُؤْتَنِفَتَانِ مِنْ أَہْلِک۔","","Musannaf Ibn Abi Shaybah 12835","","","كتاب الحج"
"12836","(۱۲۸۳۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ، عَنِ الْحَسَنِ بْنِ عَمْرٍو، عَنْ أَبی حَمْزَۃَ الْقُرَشِیّ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ؛ أَنَّہُ أَحْرَمَ مِنَ الشَّامِ فِی شِتَائٍ شَدِیدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12836","","","كتاب الحج"
"12837","(۱۲۸۳۷) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ سُلَیْمَانَ بْنِ سُحَیْمٍ ، عَنْ أُمِّ حَکِیمٍ بِنْتِ أُمَیَّۃَ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ أَہَلَّ بِعُمْرَۃٍ مِنْ بَیْتِ الْمَقْدِسِ غُفِرَ لَہُ۔n(ابوداؤد ۱۷۳۸۔ احمد ۶/۲۹۹)","Da'if","Musannaf Ibn Abi Shaybah 12837","","","كتاب الحج"
"12838","(۱۲۸۳۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ ابْنَ عَامِرٍ أَحْرَمَ مِنْ خُرَاسَانَ ، فَعَابَ ذَلِکَ عَلَیْہِ عُثْمَانُ بْنُ عَفَّانَ وَغَیْرُہُ ، وَکَرِہُوہ۔","Hasan","Musannaf Ibn Abi Shaybah 12838","","","كتاب الحج"
"12839","(۱۲۸۳۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : اِسْتَمْتِعُوا بِثِیَابِکُمْ ، فَإِنَّ رِکَابَکُمْ لاَ تُغْنِی عَنْکُمْ مِنَ اللہِ شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 12839","","","كتاب الحج"
"12840","(۱۲۸۴۰) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلْقَمَۃُ یَسْتَمْتِعُ مِنْ ثِیَابِہِ۔","","Musannaf Ibn Abi Shaybah 12840","","","كتاب الحج"
"12841","(۱۲۸۴۱) حدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ شَیْخٍ یُقَالُ لَہُ : مُسْلِمٌ ؛ أَنَّ عُمَرَ رَأَی رَجُلاً قَدْ أَحْرَمَ مِنْ قَطْرٍ سَیِّئَ الْہَیْئَۃِ ، فَقَالَ : اُنْظُرُوا إلَی مَا صَنَعَ ہَذَا بِنَفْسِہِ ، وَقَدْ یَسَّرَ اللَّہُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 12841","","","كتاب الحج"
"12842","(۱۲۸۴۲) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ أَنَّ عِمْرَانَ بْنَ حُصَیْنٍ أَحْرَمَ مِنَ الْبَصْرَۃِ ، فَقَدِمَ عَلَی عُمَرَ ، فَأَغْلَظَ لَہُ وَقَالَ : یَتَحَدَّثُ النَّاسُ أَنَّ رَجُلاً مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحْرَمَ مِنْ مِصْرَ مِنَ الأَمْصَارِ۔","Sahih","Musannaf Ibn Abi Shaybah 12842","","","كتاب الحج"
"12843","(۱۲۸۴۳) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ مُسْلِمٍ أَبِی سَلْمَانَ؛ أَنَّ رَجُلاً أَحْرَمَ مِنَ الْکُوفَۃِ ، فَرَآہُ عُمَرُ سَیِّئَ الْہَیْئَۃِ ، فَأَخَذَ بِیَدِہِ وَجَعَلَ یَدُورُ بِہِ فِی الْحِلَقِ ، وَیَقُولُ : اُنْظُرُوا إلَی مَا صَنَعَ ہَذَا بِنَفْسِہِ ، وَقَدْ وَسَّعَ اللَّہُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 12843","","","كتاب الحج"
"12844","(۱۲۸۴۴) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْکِینُ أَبُو ہُرَیْرَۃَ ، قَالَ : سَمِعْتُ مُجَاہِدًا وَسَأَلَہُ رَجُلٌ : أَیُّہُمَا أَفْضَلُ أُحْرِمُ مِنْ بَیْتِی ، أَوْ مِنْ مَسْجِدِ قَوْمِی ، أَوْ مِنْ مَسْجِدِ مِصْرِی ، أَوْ مِنَ الْوَقْتِ ؟ فَقَالَ مُجَاہِدٌ : إنِّی لأَحْرِمُ یَوْمَ التَّرْوِیَۃِ ، فَأَخَافُ أَنْ لاَ أُحِلَّ حَتَّی أُحْرِجَ إِحْرَامِی۔","","Musannaf Ibn Abi Shaybah 12844","","","كتاب الحج"
"12845","(۱۲۸۴۵) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا قلّد الْہَدْیُ ،وَصَاحِبُہُ یُرِیدُ الْعُمْرَۃَ ، أَوِ الْحَجَّ فَقَدْ أَحْرَمَ۔","Da'if","Musannaf Ibn Abi Shaybah 12845","","","كتاب الحج"
"12846","(۱۲۸۴۶) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قلّد الْہَدْیَُ ، وَصَاحِبُہُ یُرِیدُ الإِحْرَامَ ، فَقَدْ وَجَبَ الإِحْرَامُ۔","","Musannaf Ibn Abi Shaybah 12846","","","كتاب الحج"
"12847","(۱۲۸۴۷) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : رَأَیْتُ رَجُلاً بِالْقَادِسِیَّۃِ قَدْ قَلَّدَ ہَدْیَہُ ، وَعَلَیْہِ قبَاؤہُ وَعِمَامَتُہُ ، فَأَمَرْتُہُ أَنْ یَنْزِعَ عِمَامَتَہُ ، وَقَالَ : إنَّ الرَّجُلَ إذَا قَلَّدَ ، أَوْ جَلَّلَ فَقَدْ أَحْرَمَ۔","","Musannaf Ibn Abi Shaybah 12847","","","كتاب الحج"
"12848","(۱۲۸۴۸) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی الشَّعْثَائِ ، قَالَ : إذَا قَلَّدَ الْحَاجُّ أَحْرَمَ۔","","Musannaf Ibn Abi Shaybah 12848","","","كتاب الحج"
"12849","(۱۲۸۴۹) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ الْحَجَّاجِ ، عَنْ عَطَائٍ ، وَابْنِ الأَسْوَدِ ، قَالاَ : لَیْسَ لَہُ أَنْ یُقَلِّدَ ، وَلاَ یُحْرِمَ ، إِلاَّ أَنْ یَشَائَ یَوْمًا ، أَوْ یَوْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 12849","","","كتاب الحج"
"12850","(۱۲۸۵۰) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : رَأَی رَجُلاً قَدْ قَلَّدَ ، فَقَالَ : أَمَّا ہَذَا فَقَدْ أَحْرَمَ۔","","Musannaf Ibn Abi Shaybah 12850","","","كتاب الحج"
"12851","(۱۲۸۵۱) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٌ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ جَلَّلَ ، أَوْ قَلَّدَ فَقَدْ وَجَبَ عَلَیْہِ الإِحْرَامُ۔","Da'if","Musannaf Ibn Abi Shaybah 12851","","","كتاب الحج"
"12852","(۱۲۸۵۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْن أَبِی ثَابِتٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ قَلَّدَ ، أَوْ جَلَّلَ ، أَوْ أَشْعَرَ ، فَقَدْ أَحْرَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 12852","","","كتاب الحج"
"12853","(۱۲۸۵۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَسُلَیْمَانَ بْنِ یَسَارٍ قَالاَ : خَرَجَ سَعْدُ بْنُ قَیْسٍ ، حَتَّی إذَا کَانَ بِذِی الْحُلَیْفَۃِ وَامْرَأَتُہُ تُرَجِّلُہُ ، إذَا ہُوَ بِبَدَنَتِہِ قَدْ قُلِّدَتْ ، فَنَزَعَ رَأْسَہُ مِنْ یَدِ الْمَرْأَۃِ ، وَقَالَ : مَنْ قَلَّدَ ہَذِہِ الْبُدْنَ تَمَّ عَلَی إحْرَامِہِ۔","","Musannaf Ibn Abi Shaybah 12853","","","كتاب الحج"
"12854","(۱۲۸۵۴) حدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وطَاوُوسٍ ، وَمُجَاہِدٍ ، قَالُوا : إذَا قَلَّدَ ہَدْیَہُ ، أَوْ جَلَّلَہُ وَہُوَ یُرِیدُ الإِحْرَامَ ، فَقَدْ أَحْرَمَ۔","","Musannaf Ibn Abi Shaybah 12854","","","كتاب الحج"
"12855","(۱۲۸۵۵) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ مَیْمُونِ بْنِ أبی شَبِیبٍ قَالَ : إذَا قَلَّدَ ، أَوْ جَلَّلَ، أَوْ أَشْعَرَ فَقَدْ أَحْرَمَ۔","","Musannaf Ibn Abi Shaybah 12855","","","كتاب الحج"
"12856","(۱۲۸۵۶) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یُشْعِرُ الْہَدْیَ ؟ فَقَالَ : إذا أَشْعَرَ الْہَدْیَ، وَقَلَّدَ فِی أَشْہُرِ الْحَجِّ ، فَقَدْ وَجَبَ عَلَیْہِ الْحَجُّ ، وَإِنْ فَعَلَ ذَلِکَ فِی غَیْرِ أَشْہُرِ الْحَجِّ لَمْ یجِبْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 12856","","","كتاب الحج"
"12857","(۱۲۸۵۷) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنِ الرَّجُلِ یُقَلِّدُ بَدَنَتَہُ ؟ قَالَ : إِنْ شَائَ لَمْ یُحْرِمْ۔","","Musannaf Ibn Abi Shaybah 12857","","","كتاب الحج"
"12858","(۱۲۸۵۸) حدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ قَلَّدَ فَقَدْ أَحْرَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 12858","","","كتاب الحج"
"12859","(۱۲۸۵۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کُنْت أَفْتِلُ الْقَلاَئِدَ لِہَدْیِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَیُقَلِّدُ ہَدْیَہُ ، ثُمَّ یَبْعَثُ بِہِ ، ثُمَّ یُقِیمُ ، لاَ یَجْتَنِبُ شَیْئًا مِمَّا یَجْتَنِبُ الْمُحْرِمُ۔ (بخاری۱۷۰۲۔ مسلم ۳۶۵)","Sahih","Musannaf Ibn Abi Shaybah 12859","","","كتاب الحج"
"12860","(۱۲۸۶۰) حدَّثَنَا غُنْدَرٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَبْعَثُ بِالْہَدْیِ ، ثُمَّ لاَ یُمْسِکُ عَنْ شَیْئٍ مِمَّا کَانَ یُمْسِکُ عَنْہُ الْمُحْرِمُ۔","Sahih","Musannaf Ibn Abi Shaybah 12860","","","كتاب الحج"
"12861","(۱۲۸۶۱) حدَّثَنَا غُنْدَرٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَنْ بَعَثَ بِہَدْیِہِ ، فَإِنَّہُ لاَ یُمْسِکُ عَنْ شَیْئٍ مِمَّا یُمْسِکُ عَنْہُ الْمُحْرِمُ ، إِلاَّ لَیْلَۃَ جَمْعٍ ، فَإِنَّہُ یُمْسِکُ عَنِ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 12861","","","كتاب الحج"
"12862","(۱۲۸۶۲) حدَّثَنَا غُنْدَرٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُفْتِی بِذَلِکَ ، وَیَقُولُ : لاَ یُمْسِکُ عَنْ شَیْئٍ مِمَّا یُمْسِکُ عَنْہُ الْمُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 12862","","","كتاب الحج"
"12863","(۱۲۸۶۳) حدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ عَمْرَۃَ، عَنْ عَائِشَۃَ، قَالَتْ: إنَّمَا یُحْرِمُ مَنْ أَہَلَّ، وَمَنْ لَبَّی۔","Sahih","Musannaf Ibn Abi Shaybah 12863","","","كتاب الحج"
"12864","(۱۲۸۶۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : بَعَثَ مَعِیْ عَبْدُ اللہِ بِہَدْیِہِ ، وَلَمْ یُحْرِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 12864","","","كتاب الحج"
"12865","(۱۲۸۶۵) حدَّثَنَا غُنْدَرٌ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یَبْعَثُ بِالْہَدْیِ ، وَلاَ یُمْسِکُ عَمَّا یُمْسِکُ عَنْہُ الْمُحْرِمُ۔","Sahih","Musannaf Ibn Abi Shaybah 12865","","","كتاب الحج"
"12866","(۱۲۸۶۶) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ ، وَعَلِیًّا ، وَابْنَ عَبَّاسٍ ، کَانُوا یَقُولُونَ فِی الرَّجُلِ یُرْسِلُ بِبَدَنَتِہِ : إِنَّہُ یُمْسِکُ عَمَّا یُمْسِکُ عَنْہُ الْمُحْرِمُ ، لَیْسَ أَنْ لاَ یُلَبِّی ، قَالَ جَعْفَرٌ : یُوَاعِدُہُمْ یَوْمًا ، فَإِذَا کَانَ ذَلِکَ الْیَوْمُ الَّذِی یُوَاعِدُہُمْ أَنْ یُشْعِرَ ، أَمْسَکَ عَمَّا یُمْسِکُ عَنْہُ الْمُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 12866","","","كتاب الحج"
"12867","(۱۲۸۶۷) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ إذَا بَعَثَ بِالْہَدْیِ ، یُمْسِکُ عَمَّا یُمْسِکُ عَنْہُ الْمُحْرِمُ ، غَیْرَ أَنْ لاَ یُلَبِّیَ۔","Sahih","Musannaf Ibn Abi Shaybah 12867","","","كتاب الحج"
"12868","(۱۲۸۶۸) حدَّثَنَا الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : أَخْبَرَنِی مُحَمَّدُ بْنُ إبْرَاہِیمَ ، أَنَّ رَبِیعَۃَ بْنَ عَبْدِ اللہِ بْنِ الْہَدِیرِ أَخْبَرَہُ ؛ أَنَّہُ رَأَی ابْنَ عَبَّاسٍ وَہُوَ أَمِیرٌ عَلَی الْبَصْرَۃِ ، فِی زَمَانِ عَلِیِّ بْنِ أَبِی طَالِبٍ ، مُتَجَرِّدًا عَلَی مِنْبَرِ الْبَصْرَۃِ ، فَسَأَلَ النَّاسَ عَنْہُ ؟ فَقَالوا : إِنَّہُ أَمَرَ بِہَدْیِہِ أَنْ یُقَلَّدَ ، فَلِذَلِکَ تَجَرَّدَ ، فَلَقِیتُ ابْنَ الزُّبَیْرِ ، فَذَکَرْتُ ذَلِکَ لَہُ ، فَقَالَ : بِدْعَۃٌ وَرَبِّ الْکَعْبَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 12868","","","كتاب الحج"
"12869","(۱۲۸۶۹) حدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی، عَنْ ہِشَامٍ، عَنْ مُحَمَّدٍ، قَالَ: إذَا بَعَثَ الرَّجُلُ بِالْہَدْیِ، أَمَرَ الَّذِی یَبْعَثُ بِہِ مَعَہُ أَنْ یُقَلِّدَ یَوْمَ کَذَا وَکَذَا مِنْ ذَلِکَ الْیَوْمِ ، ثُمَّ یُمْسِکُ عَنِ أَشیَائٍ مِمَّا یُمْسِکُ عَنْہَا الْمُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 12869","","","كتاب الحج"
"12870","(۱۲۸۷۰) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ قَتَادَۃَ ، عَنْ مُعَاذََۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : حَلَّتِ الْعُمْرَۃُ الدَّہْرَ ، إِلاَّ ثَلاَثَۃَ أَیَّامٍ؛ یَوْمَ النَّحْرِ ، وَیَوْمَیْنِ مِنْ أَیَّامِ التَّشْرِیقِ۔","Sahih","Musannaf Ibn Abi Shaybah 12870","","","كتاب الحج"
"12871","(۱۲۸۷۱) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ سُئِلَ عَنِ الْعُمْرَۃِ ؟ فَقَالَ : إذَا مَضَتْ أَیَّامُ التَّشْرِیقِ ، فَاعْتَمِرْ مَتَی شِئْتَ إلَی قَابِلٍ۔","","Musannaf Ibn Abi Shaybah 12871","","","كتاب الحج"
"12872","(۱۲۸۷۲) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عَلِیٌّ : فِی کُلِّ شَہْرٍ عُمْرَۃٌ ، وَقَالَ سَعِیدُ بْنُ جُبَیْرٍ : فِی کُلِّ سَنَۃٍ عُمْرَۃٌ۔","","Musannaf Ibn Abi Shaybah 12872","","","كتاب الحج"
"12873","(۱۲۸۷۳) حدَّثَنَا عَبَّادٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، قَالَ : اعْتَمِرْ مَا أَمْکَنَکَ الْمُوسَی۔","","Musannaf Ibn Abi Shaybah 12873","","","كتاب الحج"
"12874","(۱۲۸۷۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی حُسَیْنٍ ، عَنْ بَعْضِ وَلَدِ أَنَسِ بْنِ مَالِکٍ ، قَالَ : کَانَ أَنَسُ بْنُ مَالِکٍ یَعْتَمِرُ ہَاہنَا بِمَکَّۃَ ، وَکُلَّمَا حَمَّمَ رَأْسُہُ خَرَجَ فَاعْتَمَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 12874","","","كتاب الحج"
"12875","(۱۲۸۷۵) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَعْتَمِرُ فِی کُلِّ سَنَۃٍ عُمْرَۃً ، إِلاَّ عَامَ الْقِتَالِ ، فَإِنَّہُ اعْتَمَرَ فِی شَوَّالٍ وَفِی رَجَبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12875","","","كتاب الحج"
"12876","(۱۲۸۷۶) حدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ لاَ یَرَی الْعُمْرَۃَ إِلاَّ فِی السَّنَۃِ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 12876","","","كتاب الحج"
"12877","(۱۲۸۷۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ صَدَقَۃَ، عَنِ الْقَاسِمِ؛ أَنَّہُ کَرِہَ أَنْ یُعْتَمَرَ فِی کُلِّ شَہْرٍ مَرَّتَیْنِ۔","","Musannaf Ibn Abi Shaybah 12877","","","كتاب الحج"
"12878","(۱۲۸۷۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا کَانُوا یَعْتَمِرُونَ فِی السَّنَۃِ ، إِلاَّ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 12878","","","كتاب الحج"
"12879","(۱۲۸۷۹) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ حَجَّاجٍ، قَالَ: سَأَلْتُ عَطَائً عَنِ الْعُمْرَۃِ فِی الشَّہْرِ مَرَّتَیْنِ؟ قَالَ: لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 12879","","","كتاب الحج"
"12880","(۱۲۸۸۰) حدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو قَالَ : کَانَ الْحَسَنُ لاَ یَرَی الْعُمْرَۃَ إِلاَّ فِی کُلِّ سَنَۃٍ۔","","Musannaf Ibn Abi Shaybah 12880","","","كتاب الحج"
"12881","(۱۲۸۸۱) حدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : رَأَی ابْنُ عَبَّاسٍ رَجُلاً وَہُوَ یَسُبُّ امْرَأَتَہُ ، فَقَالَ : مَا لَکَ ؟ فَقَالَ : إنِّی أَمْذَیْتُ ، أَوْ أَمْنَیْتُ ، فَقَالَ ابْنُ عَبَّاسٍ : لاَ تََسُبَّہَا ، وَأَہْرِقْ لِذَلِکَ دَمًا۔","Hasan","Musannaf Ibn Abi Shaybah 12881","","","كتاب الحج"
"12882","(۱۲۸۸۲) حدَّثَنَا جَرِیرٌ، عَنْ أَبَانَ بْنِ تَغْلِبَ، عَنِ الْحَکَمِ، قَالَ: أَقْبَلَ رَجُلٌ مِنْ أَہْلِ الطَّائِفِ مُحْرِمًا بِحَجَّۃٍ ، فَرَأَی نِسْوَۃً فِی بُسْتَانٍ ، فَأَدَامَ النَّظَرَ إلَیْہِنَّ حَتَّی أَمْذَی ، فَسَأَلَ سَعِیدَ بْنَ جُبَیْرٍ ؟ فَقَالَ : أَہْرِقْ دَمًا ، وَتِمَّ حَجَّکَ۔","","Musannaf Ibn Abi Shaybah 12882","","","كتاب الحج"
"12883","(۱۲۸۸۳) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ ہُبَیْرَۃَ الضَّبِّیِّ، قَالَ: خَرَجْتُ إلَی مَکَّۃَ وَمَعِی امْرَأَتِی، فَحَدَّثْتہَا فَأَمْذَیْتُ، فَسَأَلْتُ عَطَائً ؟ فَقَالَ : شَاۃ۔","","Musannaf Ibn Abi Shaybah 12883","","","كتاب الحج"
"12884","(۱۲۸۸۴) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَفْسُدُ الْحَجُّ حَتَّی یَلْتَقِیَ الْخِتَانَانِ ، فَإِذَا الْتَقَی الْخِتَانَانِ فَسَدَ الْحَجُّ وَوَجَبَ الْغُرْمُ۔","","Musannaf Ibn Abi Shaybah 12884","","","كتاب الحج"
"12885","(۱۲۸۸۵) حدَّثَنَا أَبُو الأَحْوَصِِ، عَنْ زَیْدِ بْنِ جُبَیْرٍ، قَالَ: کُنْتُ عِنْدَ ابْنِ عُمَرَ قَاعِدًا، فَأَتَتْہُ امْرَأَۃٌ، فَقَالَتْ: إنِّی نَذَرْت أَنْ أَحُجَّ ، وَلَمْ أَحُجَّ قَبْلَ ہَذِہِ الْحَجَّۃِ قَطُّ ؟ قَالَ : ہَذِہِ حَجَّۃُ الإِسْلاَمِ ، فَالْتَمِسِی مَا تُوفِیَنَ بِہِ عَنْ نَذْرِک۔","Sahih","Musannaf Ibn Abi Shaybah 12885","","","كتاب الحج"
"12886","(۱۲۸۸۶) حدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنْ وَاصِلٍ مَوْلَی أَبِی عُیَیْنَۃَ ، قَالَ : حدَّثَنِی شَیْخٌ سَمِعَ ابْنَ عَبَّاسٍ ، وَأَتَتْہُ امْرَأَۃٌ ، فَقَالَتْ : إنِّی نَذَرْت أَنْ أَحُجَّ ، وَلَمْ أَحُجَّ حَجَّۃَ الإِسْلاَمِ ، فَقَالَ ابْنُ عَبَّاسٍ : قَضَیْتِہِمَا وَرَبِّ الْکَعْبَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 12886","","","كتاب الحج"
"12887","(۱۲۸۸۷) حدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ رَجُلاً نَذَرَ أَنْ یَحُجَّ ، وَلَمْ یَحُجَّ ، قَالَ : یُجْزِئُ عَنْہُ الْفَرِیضَۃَ وَالنَّذْرَ۔","","Musannaf Ibn Abi Shaybah 12887","","","كتاب الحج"
"12888","(۱۲۸۸۸) حدَّثَنَا الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ فِی رَجُلٍ کَانَتْ عَلَیْہِ یَمِینٌ فِی الْحَجِّ ، وَلَمْ یَحُجَّ حَجَّۃَ الإِسْلاَمِ ، فَیُسِّرلَہُ الْحَجُّ ، قَالَ : یُجْزِئُ مِنْہُمَا ، فَإِنْ قَدَرَ عَلَی شَیْئٍ فَلْیَحُجَّ۔","","Musannaf Ibn Abi Shaybah 12888","","","كتاب الحج"
"12889","(۱۲۸۸۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الرَّبِیعِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ (ح) وَعَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالاَ: یُجْزِئُہُ حَجَّۃُ الإِسْلاَمِ مِنْ حَجِّہِ وَنَذْرِہِ۔","","Musannaf Ibn Abi Shaybah 12889","","","كتاب الحج"
"12890","(۱۲۸۹۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ لَہُ رَجُلٌ : إنَّ عَلَیَّ نَذْرًا بِالْحَجِّ ، وَلَمْ أَحُجَّ حَجَّۃَ الإِسْلاَمِ ، فَبِأَیِّہِمَا أَبْدَأُ ؟ قَالَ : ابْدَأْ بِحَجَّۃِ الإِسْلاَمِ۔","","Musannaf Ibn Abi Shaybah 12890","","","كتاب الحج"
"12891","(۱۲۸۹۱) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی سُلَیْمَانَ ، قَالَ : سَمِعْتُ أَنْسَاً یَقُولُ فِی رَجُلٍ نَذَرَ أَنْ یَحُجَّ ، وَلَمْ یَحُجَّ حَجَّۃَ الإِسْلاَمِ ، قَالَ : یَبْدَأُ بِالْفَرِیضَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 12891","","","كتاب الحج"
"12892","(۱۲۸۹۲) حدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ خُصَیْفٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحْرَمَ دُبُرَ الصَّلاَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 12892","","","كتاب الحج"
"12893","(۱۲۸۹۳) حدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحْرَمَ فِی دُبُرِ صَلاَۃِ الظُّہْرِ ، وَکَانَ الْحَسَنُ یَسْتَحِبُّ أَنْ یُحْرِمَ دُبُرَ الظُّہْرِ ، فَإِنْ لَمْ یَفْعَلْ فَفِی دُبُرِ صَلاَۃِ الْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 12893","","","كتاب الحج"
"12894","(۱۲۸۹۴) حدَّثَنَا أَبُو خَالِدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنِ ابْنِ سَابِطٍ، قَالَ: کَانَ سلَفُکَ یَسْتَحِبُّ التَّلْبِیَۃَ فِی أَرْبَعَۃِ مَوَاضِعَ؛ فِی دُبُرِ الصَّلاَۃِ ، وَإِذَا ہَبَطُوا وَادِیًا ، أَوْ عَلَوْہُ ، وَعِنْدَ انْضِمَامِ الرِّفَاقِ۔","","Musannaf Ibn Abi Shaybah 12894","","","كتاب الحج"
"12895","(۱۲۸۹۵) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تُسْتَحَبُّ التَّلْبِیَۃُ فِی مَوَاطِنَ ؛ فِی دُبُرِ الصَّلاَۃِ الْمَکْتُوبَۃِ، وَحِینَ تَصْعَدُ شَرَفًا ، وَحِینَ تَہْبِطُ وَادِیًا ، وَکُلَّمَا اسْتَوَی بِکَ بَعِیرُکَ قَائِمًا ، وَکُلَّمَا لَقِیتَ رُفْقَۃً۔","","Musannaf Ibn Abi Shaybah 12895","","","كتاب الحج"
"12896","(۱۲۸۹۶) حدَّثَنَا شَرِیکٌ، عَنْ جَابِرٍ، عَنْ عَبْدِالرَّحْمَنِ بْنِ الأَسْوَد، عَنْ أَبِیہِ؛ أَنَّہُ کَانَ یُحْرِمُ فِی دُبُرِ الصَّلاَۃِ الْمَکْتُوبَۃِ۔","","Musannaf Ibn Abi Shaybah 12896","","","كتاب الحج"
"12897","(۱۲۸۹۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ التَّلْبِیَۃَ عِنْدَ سِتٍّ ؛ دُبُرَ الصَّلاَۃِ، وَإِذَا اسْتَقَلَّتْ بِالرَّجُلِ رَاحِلَتُہُ ، وَإِذَا صَعِدَ شَرَفًا ، وَإِذَا ہَبَطَ وَادِیًا ، وَإِذَا لَقِیَ بَعْضُہُمْ بَعْضًا۔","","Musannaf Ibn Abi Shaybah 12897","","","كتاب الحج"
"12898","(۱۲۸۹۸) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سَأَلْتُ عَطَائً عَنِ التَّلْبِیَۃِ ، إذَا أَرَادَ الرَّجُلُ یُحْرِمُ ؟ قَالَ : إِنْ شِئْتَ فَفِی دُبُرِ الصَّلاَۃِ ، وَإِنْ شِئْتَ فَإِذَا انْبَعَثَتْ بِکَ النَّاقَۃُ تَبْدَأُ حِینَ تَرْکَبُ ، فَتَقُولُ : {سُبْحَانَ الَّذِی سَخَّرَ لَنَا ہَذَا ، وَمَا کُنَّا لَہُ مُقْرِنِینَ}۔","","Musannaf Ibn Abi Shaybah 12898","","","كتاب الحج"
"12899","(۱۲۸۹۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ حَیَّانَ ، عَنْ أَبِی الشَّعْثَائِ جَابِرِ بْنِ زَیْدٍ ، قَالَ : إِنْ کَانَ بَعْضُہُمْ لَیُحْرِمُ وَہُوَ رَاکِبٌ ، وَإِنْ کَانَ بَعْضُہُمْ لَیُحْرِمُ وَہُوَ یَأْکُلُ۔","","Musannaf Ibn Abi Shaybah 12899","","","كتاب الحج"
"12900","(۱۲۹۰۰) حدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، قَالَ : کَانَ الْقَاسِمُ یُلَبِّی دُبُرَ کُلِّ صَلاَۃٍ ؛ تَطَوُّعٍ وَفَرِیضَۃٍ۔","","Musannaf Ibn Abi Shaybah 12900","","","كتاب الحج"
"12901","(۱۲۹۰۱) حدَّثَنَا عَبْدُ السَّلاَمِ بْنِ حَرْبٍ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی الْمُحْرِمِ یَنْکَسِرُ ظُفُرُہُ ، قَالَ : إِنْ آذَاکَ فَارْمِ بِہِ عَنْکَ۔","Sahih","Musannaf Ibn Abi Shaybah 12901","","","كتاب الحج"
"12902","(۱۲۹۰۲) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : إِن کَانَت شَظِیّۃً فَہُوَ یَقْلِمُہَا۔","","Musannaf Ibn Abi Shaybah 12902","","","كتاب الحج"
"12903","(۱۲۹۰۳) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا انْکَسَرَ ظُفُرُ الْمُحْرِمِ فَلْیَقُصَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 12903","","","كتاب الحج"
"12904","(۱۲۹۰۴) حدَّثَنَا جَرِیرٌ ، عَنْ یَزِیدَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إذَا انْکَسَرَ ظُفُرُ الْمُحْرِمِ أَلْقَاہُ۔","","Musannaf Ibn Abi Shaybah 12904","","","كتاب الحج"
"12905","(۱۲۹۰۵) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی مَرْیَمَ ، قَالَ : اِشْتَکَیْتُ ظُفُرِی وَأَنَا مُحْرِمٌ ، فَآذَانِی فَقَطَعْتُہُ ، فَسَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، فَقَالَ : آذَاکَ ؟ فَقُلْتُ : نَعَمْ ، فَقَالَ : فَاقْطَعْہُ یَا ابْنَ أَخِی ، {یُرِیدُ اللَّہُ بِکُمُ الْیُسْرَ وَلاَ یُرِیدُ بِکُمُ الْعُسْرَ}۔","","Musannaf Ibn Abi Shaybah 12905","","","كتاب الحج"
"12906","(۱۲۹۰۶) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ؛ فِی الْمُحْرِم إذَا انْکَسَرَ ظُفُرُہُ قَلَمَہُ مِنْ حَیْثُ انْکَسَرَ ، وَلَیْسَ عَلَیْہِ شَیْئٌ ، فَإِنْ قَلَمَہُ مِنْ غیر أَنْ یَنْکَسِرَ فَعَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12906","","","كتاب الحج"
"12907","(۱۲۹۰۷) حدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ ، قَالَ : یَنْزِعُ الْمُحْرِمُ ظُفُرَہُ۔","","Musannaf Ibn Abi Shaybah 12907","","","كتاب الحج"
"12908","(۱۲۹۰۸) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : الْمُحْرِمُ یَبْجِسُ الْقُرْحَۃَ ، وَیَقطَعُ الظُّفُرَ ، وَیَقطَعُ اللَّحْمَ النَّاتِیء ، وَیَنْزِِعُ الضِّرْسَ ، وَیُدَاوِی الْقُرْحَۃَ۔","","Musannaf Ibn Abi Shaybah 12908","","","كتاب الحج"
"12909","(۱۲۹۰۹) حدَّثَنَا عَبَّادُ بْنُ العَوَّامِ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الْمُحْرِمِ : یَبُطُّ الْجُرْحَ ، وَیَعْصِرُ الْقُرْحَۃَ ، وَیَقُصُّ الظُّفُرَ إذَا انْکَسَرَ ، وَیَجْبُرُ الْکَسْرَ۔","","Musannaf Ibn Abi Shaybah 12909","","","كتاب الحج"
"12910","(۱۲۹۱۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ أَنْ یَقْطَعَ الْمُحْرِمُ الْجِلْدَۃَ۔","","Musannaf Ibn Abi Shaybah 12910","","","كتاب الحج"
"12911","(۱۲۹۱۱) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ بَأْسَ بِالسِّوَاکِ لِلْمُحْرِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 12911","","","كتاب الحج"
"12912","(۱۲۹۱۲) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ، قَالَ : کَانُوا یَسْتَحِبُّونَ السِّوَاکَ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 12912","","","كتاب الحج"
"12913","(۱۲۹۱۳) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، قَالاَ : لاَ بَأْسَ بِالسِّوَاکِ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 12913","","","كتاب الحج"
"12914","(۱۲۹۱۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَاکَ الْمُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 12914","","","كتاب الحج"
"12915","(۱۲۹۱۵) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ، عَنْ أَبِی بَکْرٍ، قَالَ: قُلْتُ لِعِکْرِمَۃَ: ہَلْ یَسْتَاکُ الْمُحْرِمُ؟ قَالَ: نَعَمْ، السِّوَاکُ طَہَارَۃٌ۔","","Musannaf Ibn Abi Shaybah 12915","","","كتاب الحج"
"12916","(۱۲۹۱۶) حدَّثَنَا وَکِیعٌ ، عَنِ ابن نافع ، عَنْ أَبِیِہِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَسْتَاکَ وَہُوَ مُحْرِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 12916","","","كتاب الحج"
"12917","(۱۲۹۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ مُحَمَّدَ بْنَ عَلِیٍّ ، وَعَامِرًا ، وَعَطَائً ، وَطَاوُوسًا ، وَمُجَاہِدًا ، وَسَالِمًا ، وَالْقَاسِمَ ، وَعَبْدَ الرَّحْمَنِ بْنَ الأَسْوَدِ ؟ فَلَمْ یَرَوْا بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 12917","","","كتاب الحج"
"12918","(۱۲۹۱۸) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، وَمُجَاہِدٍ قَالاَ : إذَا اشْتَکَی الْمُحْرِمُ ضِرْسَہُ نَزَعَہُ ، وَإِذَا انْکَسَرَ نَزَعَہُ ۔ قَالَ مَنْصُورٌ : وَلاَ شَیْئَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 12918","","","كتاب الحج"
"12919","(۱۲۹۱۹) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِنِ اشْتَکَی الْمُحْرِمُ ضِرْسَہُ نَزَعَہُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 12919","","","كتاب الحج"
"12920","(۱۲۹۲۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَمَّنْ أَخْبَرَہُ عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْمُحْرِمُ یَنْزِعُ ضِرْسَہُ ، وَیُدَاوِی الْقُرْحَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 12920","","","كتاب الحج"
"12921","(۱۲۹۲۱) حدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ عَنْبَسَۃَ قَاضِی الرَّیِّ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ؛ فِی مُحْرِمٍ نَزَعَ ضِرْسَہُ ، قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12921","","","كتاب الحج"
"12922","(۱۲۹۲۲) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : یَنْزِعُ الضِّرْسَ ، یَعْنِی الْمُحْرِمَ۔","","Musannaf Ibn Abi Shaybah 12922","","","كتاب الحج"
"12923","(۱۲۹۲۳) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ مَالِکٍ ، قَالَ : تَمَتَّعْتُ فَأَتَیْتُ ابْنَ عَبَّاسٍ ، فَقُلْتُ لَہُ : إنِّی تَمَتَّعْتُ ، فَقَالَ : {مَا اسْتَیْسَرَ مِنَ الْہَدْیِ} ، فَقُلْتُ : شَاۃٌ ؟ فَقَالَ : شَاۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 12923","","","كتاب الحج"
"12924","(۱۲۹۲۴) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ النُّعْمَانِ بْنِ قَیْسٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : {مَا اسْتَیْسَرَ مِنَ الْہَدْیِ} ، شَاۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 12924","","","كتاب الحج"
"12925","(۱۲۹۲۵) حدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ (ح) وَعَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : {مَا اسْتَیْسَرَ مِنَ الْہَدْیِ} ، مَا بَیْنَ الرُّخْصِ إلَی الْغَلاَئِ۔","Sahih","Musannaf Ibn Abi Shaybah 12925","","","كتاب الحج"
"12926","(۱۲۹۲۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : {مَا اسْتَیْسَرَ مِنَ الْہَدْیِ} : شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 12926","","","كتاب الحج"
"12927","(۱۲۹۲۷) حدَّثَنَا ہُشَیْمٌ ، قَالَ : سَمِعْتُ الزُّہْرِیَّ ، وَسُئِلَ عَنْ {مَا اسْتَیْسَرَ مِنَ الْہَدْیِ} ؟ فَقَالَ : کَانَ ابْنُ عُمَرَ یَقُولُ : مِنَ الإِبِلِ وَالْبَقَرِ ، وَکَانَ ابْنُ عَبَّاسٍ یَقُولُ : مِنَ الْغَنَمِ۔","","Musannaf Ibn Abi Shaybah 12927","","","كتاب الحج"
"12928","(۱۲۹۲۸) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 12928","","","كتاب الحج"
"12929","(۱۲۹۲۹) حدَّثَنَا عَبْدُاللہِ بْنُ نُمَیْرٍ، عَنْ إسْمَاعِیلَ، عَنْ وَبَرَۃَ، عَنِ ابْنِ عُمَرَ، قَالَ: إذَا قَرَنَ الرَّجُلُ الْحَجَّ وَالْعُمْرَۃَ، فَعَلَیْہِ بَدَنَۃٌ ، فَقِیلَ لَہُ : إنَّ ابْنَ مَسْعُودٍ کَانَ یَقُولُ : شَاۃٌ ؟ فَقَالَ ابْنُ عُمَرَ : الصِّیَامُ أَحَبُّ إلَیَّ مِنْ شَاۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12929","","","كتاب الحج"
"12930","(۱۲۹۳۰) حدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ؛ أَنَّ عَائِشَۃَ ، وَابْنَ عُمَرَ کَانَا یَقُولاَنِ : الْہَدْیُ مِنَ الإِبِلِ وَالْبَقَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 12930","","","كتاب الحج"
"12931","(۱۲۹۳۱) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِی ، عَنْ مُحَمَّدٍ عُبَیْدِ بْنِ أَوسٍ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : ذَاتُ جَوفٍ مِنْ إبِلٍ ، أَوْ بَقَرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 12931","","","كتاب الحج"
"12932","(۱۲۹۳۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : قدْ تُسْتَیْسِرُ الْجَزُورُ وَالْبَقَرَۃُ۔","","Musannaf Ibn Abi Shaybah 12932","","","كتاب الحج"
"12933","(۱۲۹۳۳) حدَّثَنَا وَکِیعٌ ، عَنْ دَلْہَم بْنِ صَالِحٍ ، عَنْ أَبِی جَعْفَرٍ قَالَ : شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 12933","","","كتاب الحج"
"12934","(۱۲۹۳۴) حدَّثَنَا وَکِیعٌ ، عَنِ البَخْتَری بْنِ الْمُخَتَارِ ، قَالَ : سَمِعْتُ عَطَائً یَقُولُ : شاۃ۔","","Musannaf Ibn Abi Shaybah 12934","","","كتاب الحج"
"12935","(۱۲۹۳۵) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، قَالَ: سَمِعْتُ الشَّعْبِیَّ یَقُولُ: تُجْزِئُ شَاۃٌ فِی التَّمَتُّعِ۔","","Musannaf Ibn Abi Shaybah 12935","","","كتاب الحج"
"12936","(۱۲۹۳۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : {مَا اسْتَیْسَرَ مِنَ الْہَدْیِ} شَاۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 12936","","","كتاب الحج"
"12937","(۱۲۹۳۷) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ وَبَرَۃَ بن عَبْدِ الرَّحْمَنِ قَالَ : أَتَیْتُ ابْنَ عُمَرَ ، فَقُلْتُ : إنَّ عَلَیَّ ہَدْیًا ، فَمَا تَأْمُرُنِی ؟ فَقَالَ : بَدَنَۃً مِنَ الْبَقَرِ ، وَإِلاَّ فَإِنَّ صَوْمَ ثَلاَثَۃِ أَیَّامٍ ، وَسَبْعَۃٍ إذَا رَجَعْتَ إلَی أَہْلِکَ أَحَبُّ إلَیَّ مِنْ شَاۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 12937","","","كتاب الحج"
"12938","(۱۲۹۳۸) حدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : {مَا اسْتَیْسَرَ مِنَ الْہَدْیِ} : شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 12938","","","كتاب الحج"
"12939","(۱۲۹۳۹) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ الْقَاسِمِ ؛ أَنَّ عَائِشَۃَ ، وَابْنَ عُمَرَ لَمْ یَکُونَا یَرَیَانِ {مَا اسْتَیْسَرَ مِنَ الْہَدْیِ} إِلاَّ مِنَ الإِبِلِ وَالْبَقَرِ ، وَکَانَ ابْنُ عَبَّاسٍ یَقُولُ : {مَا اسْتَیْسَرَ مِنَ الْہَدْیِ} شَاۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 12939","","","كتاب الحج"
"12940","(۱۲۹۴۰) حدَّثَنَا یَعْلَی ، وَابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا نَتَمَتَّعُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَنَذْبَحُ الْبَقَرَۃَ عَنْ سَبْعَۃٍ۔ (مسلم ۳۵۵۔ ابوداؤد ۲۸۰۰)","Sahih","Musannaf Ibn Abi Shaybah 12940","","","كتاب الحج"
"12941","(۱۲۹۴۱) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یُجْزِئُ الْمُتَمَتِّعَ أَنْ یُشَارَکَ فِی دَمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 12941","","","كتاب الحج"
"12942","(۱۲۹۴۲) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : تُجْزِئُ النَّاقَۃُ وَالْبَقَرَۃُ عَنْ سَبْعَۃٍ مُتَمَتِّعِینَ۔","","Musannaf Ibn Abi Shaybah 12942","","","كتاب الحج"
"12943","(۱۲۹۴۳) حدَّثَنَا أَبُو خَالِدٍ، عَنْ حَجَّاجٍ، عَنْ عَطَائٍ، قَالَ: یَشْتَرِکُ الْمَحْصُورُونَ وَالْمُتَمَتِّعُونَ فِی الْبَدَنَۃِ، عَنْ سَبْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 12943","","","كتاب الحج"
"12944","(۱۲۹۴۴) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا لِلْمُتَمَتِّعِ أَنْ یَدْخُلَ فِی شِرْکٍ فِی جَزُورٍ ، أَوْ بَقَرَۃٍ۔","","Musannaf Ibn Abi Shaybah 12944","","","كتاب الحج"
"12945","(۱۲۹۴۵) حدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، قَالَ: سَأَلْتُ الْحَکَمَ، وَحَمَّادًا عَنِ الْقَوْمِ یَشْتَرِکُونَ فِی الْہَدْیِ؟ فَکَرِہَا ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 12945","","","كتاب الحج"
"12946","(۱۲۹۴۶) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، وَلَیْثٌ ، عَنْ مُجَاہِدٍ ؛ فِی الرَّجُلِ یَجْمَعُ بَیْنَ الْعُمْرَۃِ وَالْحَجِّ فَیُحْصَرُ ، قَالَ: یَبْعَثُ بِہَدْیٍ یَحِلُّ بِہِ ، ثُمَّ یَجِیئُ مِنْ قَابِلٍ بِمَا کَانَ أَہَلَّ بِہِ۔","","Musannaf Ibn Abi Shaybah 12946","","","كتاب الحج"
"12947","(۱۲۹۴۷) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، وَسَعِیدِ بْنِ جُبَیْرٍ قَالاَ : عَلَیْہِ عُمْرَتَانِ وَحَجَّۃٌ۔","","Musannaf Ibn Abi Shaybah 12947","","","كتاب الحج"
"12948","(۱۲۹۴۸) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ؛ فِی رَجُلٍ أَہَلَّ بِعُمْرَۃٍ وَحَجَّۃٍ فَأُحْصِرَ ، قَالَ : یَبْعَثُ بِالْہَدْیِ ، فَإِذَا بَلَغَ الْہَدْیُ مَحِلَّہُ حَلَّ ۔ قَالَ : وَعَلَیْہِ حَجَّۃٌ وَعُمْرَتَانِ ، وَقَالَ الْحَکَمُ : عَلَیْہِ حَجَّۃٌ وَثَلاَثُ عُمَرَ۔","","Musannaf Ibn Abi Shaybah 12948","","","كتاب الحج"
"12949","(۱۲۹۴۹) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : ہَدْیَانِ۔","","Musannaf Ibn Abi Shaybah 12949","","","كتاب الحج"
"12950","(۱۲۹۵۰) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 12950","","","كتاب الحج"
"12951","(۱۲۹۵۱) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، وَمَنْصُورٌ ، عَنْ مُجَاہِدٍ ، قَالَ : یَبْعَثُ بِہَدْیٍ وَیَحِلُّ بِہِ۔","","Musannaf Ibn Abi Shaybah 12951","","","كتاب الحج"
"12952","(۱۲۹۵۲) حدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : عَلَیْہِ ہَدْیٌ۔","","Musannaf Ibn Abi Shaybah 12952","","","كتاب الحج"
"12953","(۱۲۹۵۳) حدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، وَعَطَائٍ قَالاَ : إذَا جَمَعَ بَیْنَ عُمْرَۃٍ وَحَجٍّ فَحَبَسَہُ مَرَضٌ ، أَجْزَأَہُ لَہُمَا ہَدْیٌ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 12953","","","كتاب الحج"
"12954","(۱۲۹۵۴) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ : مَنْ أَدْرَکَہُ الْمَسَائُ بِمِنًی ، وَہُوَ فِی الْیَوْمِ الثَّانِی مِنْ أَیَّامِ التَّشْرِیقِ ، فَلاَ یَنْفِرُ حَتَّی الْغَدِ مِنَ الْیَوْمِ الثَّالِثِ۔","","Musannaf Ibn Abi Shaybah 12954","","","كتاب الحج"
"12955","(۱۲۹۵۵) حدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، وَیُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 12955","","","كتاب الحج"
"12956","(۱۲۹۵۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، أَنَّہُ کَانَ یَقُولُ : لاَ یَنْفِرُ حَتَّی یَکُونَ مِنَ الْغَدِ۔","","Musannaf Ibn Abi Shaybah 12956","","","كتاب الحج"
"12957","(۱۲۹۵۷) حدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْمَلِکِ ، وَحَجَّاجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یَقُولُ : یَنْفِرُ مَا لَمْ تَغِبِ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 12957","","","كتاب الحج"
"12958","(۱۲۹۵۸) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : مَنْ أَمْسَی بِمِنًی یَوْمَ النَّفْرِ الأَوَّلِ ، وَہُوَ یُرِیدُ النَّفْرَ فِی ذَلِکَ الْیَوْمِ ، فَلاَ یَنْفِرُ حَتَّی الْغَدِ۔","","Musannaf Ibn Abi Shaybah 12958","","","كتاب الحج"
"12959","(۱۲۹۵۹) حدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا أَدْرَکَہُ الْمَسَائُ فِی الْیَوْمِ الثَّانِی ، فَلاَ یَنْفِرُ حَتَّی الْغَدِ وَتَزُولَ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 12959","","","كتاب الحج"
"12960","(۱۲۹۶۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: الطَّوَافُ بِالْبَیْتِ صَلاَۃٌ، وَلَکِنَّ اللَّہَ تَعَالَی أَحَلَّ فِیہِ الْمَنْطِقَ ، فَمَنْ نَطَقَ فَلاَ یَنْطِقُ إِلاَّ بِخَیْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 12960","","","كتاب الحج"
"12961","(۱۲۹۶۱) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ مَوْلًی لأَبِی سَعِیدٍ ، عَنْ أَبِی سَعِیدٍ ، أَنَّہُ کَانَ یَأْمُرُ بَنِیہِ إذَا طَافُوا أَنْ لاَ یَلْغَوْا فِی طَوَافِہِمْ ، وَلاَ یَہْجُروا ، وَلاَ یَقْضُوا حَاجَۃً ، وَلاَ یُکَلِّمُوا أَحَدًا حَتَّی یَقْضُوا طَوَافَہُمْ إنِ اسْتَطَاعُوا۔","Da'if","Musannaf Ibn Abi Shaybah 12961","","","كتاب الحج"
"12962","(۱۲۹۶۲) حدَّثَنَا أَبُو سَعْدٍ مُحَمَّدِ بْنِ مَیْسَرَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : طُفْتُ وَرَائَ ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ، فَلَمْ أَسْمَعْ وَاحِدًا مِنْہُمَا یَتَکَلَّمُ فِی الطَّوَافِ۔","Da'if","Musannaf Ibn Abi Shaybah 12962","","","كتاب الحج"
"12963","(۱۲۹۶۳) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الطَّوَافُ بِالْبَیْتِ صَلاَۃٌ ، فَأَقِلُّوا الْکَلاَمَ فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 12963","","","كتاب الحج"
"12964","(۱۲۹۶۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إِبْرَاہِیمَ بْنِ نَافِعٍ ، قَالَ : طُفْتُ مَعَ طَاوُوسٍ ، فَلَمْ أَسْمَعْہُ یَبْدَأُ إنْسَانًا بِالْکَلاَمِ ، إِلاَّ أَنْ یُکَلِّمَہُ فَیُجِیبَہُ۔","","Musannaf Ibn Abi Shaybah 12964","","","كتاب الحج"
"12965","(۱۲۹۶۵) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُوسَی بْنِ أَبِی الْفُرَاتِ ، قَالَ : قَالَ طَاوُوسٌ : إنِّی لأَعُدَّہَا غَنِیمَۃً ، أَنْ أَطُوفَ بِالْبَیْتِ سُبُوعًا لاَ یُکَلِّمُنِی أَحَدٌ۔","","Musannaf Ibn Abi Shaybah 12965","","","كتاب الحج"
"12966","(۱۲۹۶۶) حدَّثَنَا جَرِیرٌ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : کُنْتُ أَطُوفُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ ، وَہُوَ یُحَدِّثُنِی۔","","Musannaf Ibn Abi Shaybah 12966","","","كتاب الحج"
"12967","(۱۲۹۶۷) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ شُرَیْحٌ یَطُوفُ بِالْبَیْتِ فَسَأَلَہُ رَجُلٌ ، فَأَفْتَاہُ۔","","Musannaf Ibn Abi Shaybah 12967","","","كتاب الحج"
"12968","(۱۲۹۶۸) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یَطُوفُ بِالْبَیْتِ ، یُحَدِّثُ أَصْحَابَہُ وَیُفْتِی۔","","Musannaf Ibn Abi Shaybah 12968","","","كتاب الحج"
"12969","(۱۲۹۶۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : کَانَ مُجَاہِدٌ ، وَسَعِیدُ بْنُ جُبَیْرٍ ، وَعَلِیُّ بْنُ عَبْدِ اللہِ بْنِ الْعَبَّاسِ ، وَالْحُسَیْنُ بْنُ الْحَسَنِ ، وَأَبُو جَعْفَرٍ یَتَکَلَّمُونَ وَہُمْ یَطُوفُونَ بِالْبَیْتِ ، وَبَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","","Musannaf Ibn Abi Shaybah 12969","","","كتاب الحج"
"12970","(۱۲۹۷۰) حدَّثَنَا عَائِذُ بْنُ حَبِیبٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی الزُّبَیْرِ، عَنْ طَاوُوسٍ ، قَالَ: لَمَّا تَفَرَّقَ أَبُو مُوسَی وَعَمْرُو بْنُ الْعَاصِ عَنِ الْحُکُومَۃِ ، قَدِمَ أَبُو مُوسَی مُعْتَمِرًا ، فَکُنْتُ أَطُوفُ أَنَا وَہُوَ بِالْبَیْتِ إذَا عَرَضَ لَہُ رَجُلٌ ، فَقَالَ : یَا أَبَا مُوسَی ، ہَذِہِ الْفِتْنَۃُ الَّتِی کَانَتْ تُذْکَرُ ؟ قَالَ : مَا ہَذِہِ إِلاَّ حَیْصَۃٌ مِنْ حَیْصَاتِ الْفِتَنِ۔","Sahih","Musannaf Ibn Abi Shaybah 12970","","","كتاب الحج"
"12971","(۱۲۹۷۱) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ النَّضْرِ بْنِ مَعْبَدٍ ، قَالَ : رَأَیْتُ أَبَا قِلاَبَۃَ یَتَکَلَّمُ فِی الطَّوَافِ۔","","Musannaf Ibn Abi Shaybah 12971","","","كتاب الحج"
"12972","(۱۲۹۷۲) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : لَقِیتُ أَبَا مَسْعُودٍ فَسَأَلْتُہُ وَہُوَ یَطُوفُ بِالْبَیْتِ ؟ فَقَالَ لِی ، ثُمَّ ذَکَرَ حَدِیثًا۔","Sahih","Musannaf Ibn Abi Shaybah 12972","","","كتاب الحج"
"12973","(۱۲۹۷۳) حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ عَلِیٍّ ، قَالَ : إذَا قَبَّلَ الْمُحْرِمُ امْرَأَتَہُ فَعَلَیْہِ دَمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 12973","","","كتاب الحج"
"12974","(۱۲۹۷۴) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12974","","","كتاب الحج"
"12975","(۱۲۹۷۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12975","","","كتاب الحج"
"12976","(۱۲۹۷۶) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12976","","","كتاب الحج"
"12977","(۱۲۹۷۷) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12977","","","كتاب الحج"
"12978","(۱۲۹۷۸) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الْمُحْرِمِ یُقَبِّلُ امْرَأَتَہُ ، أَوْ یَغْمِزُ امْرَأَتَہُ لِشَہْوَۃٍ ، قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12978","","","كتاب الحج"
"12979","(۱۲۹۷۹) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا قَبَّلَ ، أَوْ غَمَزَ فَعَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12979","","","كتاب الحج"
"12980","(۱۲۹۸۰) حدَّثَنَا عَبَّادُ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ : مِثْلَہُ ، وَزَادَ فِیِہِ أَوْ جَرَّدَ۔","","Musannaf Ibn Abi Shaybah 12980","","","كتاب الحج"
"12981","(۱۲۹۸۱) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : یَسْتَغْفِرُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 12981","","","كتاب الحج"
"12982","(۱۲۹۸۲) حدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12982","","","كتاب الحج"
"12983","(۱۲۹۸۳) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ خُثَیْمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12983","","","كتاب الحج"
"12984","(۱۲۹۸۴) حدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12984","","","كتاب الحج"
"12985","(۱۲۹۸۵) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، قَالَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12985","","","كتاب الحج"
"12986","(۱۲۹۸۶) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ شَیْبَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، وَعَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ قَالاَ : عَلَیْہِ دَمٌ۔","","Musannaf Ibn Abi Shaybah 12986","","","كتاب الحج"
"12987","(۱۲۹۸۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا لَمَسَ الْمُحْرِمُ ، أَوْ غَمَزَ امْرَأَتَہُ ، فَعَلَیْہِ کَفَّارَۃٌ یَتَصَدَّقُ بِہَا۔","","Musannaf Ibn Abi Shaybah 12987","","","كتاب الحج"
"12988","(۱۲۹۸۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی اللَّمْسَۃِ وَالْجَسَّۃِ مِنْ وَرَائِ الثَّوْبِ لَیْسَ فِیہَا شَیْئٌ ، وَفِی جَسَّاتٍ وَمَسَّاتٍ دَمٌ۔","Hasan","Musannaf Ibn Abi Shaybah 12988","","","كتاب الحج"
"12989","(۱۲۹۸۹) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ بَاشَرَ وَہُوَ مُحْرِمٌ ؟ قَالَ : عَلَیْہِ بَدَنَۃٌ ، قُلْتُ : فَإِنْ أَنْزَلَ الْمَائَ الأَعْظَمَ ؟ قَالَ : کَانَ الْحَسَنُ یَقُولُ : ہُوَ بِمَنْزِلَۃِ الْمُجَامِعِ ، عَلَیْہِ الْحَجُّ مِنْ قَابِلٍ۔","","Musannaf Ibn Abi Shaybah 12989","","","كتاب الحج"
"12990","(۱۲۹۹۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ غَیْلاَنَ بْنِ جَرِیرٍ ، قَالَ : کُنْتُ أَنَا وَحَکِیمُ بْنُ الدُّرَیْمِ ، فَأَتَانَا رَجُلٌ ، فَقَالَ : إنِّی وَضَعْتُ یَدِی مِنَ امْرَأَتِی مَوْضِعًا ، فَلَمْ أَرْفَعْہَا حَتَّی أَجْنَبْتُ ، فَقُلْنَا : مَا لَنَا بِہَا عِلْمٌ ، فَانْطَلِقُوا بِنَا إلَی عَلِیِّ بْنِ عَبْدِ اللہِ الْبَارِقِیِّ ، فَأَتَیْنَاہُ فَسَأَلْنَاہُ ؟ فَقَالَ : مَا لِی بِہَذَا عِلْمٌ ، فَبَیْنَا نَحْنُ کَذَلِکَ ، إذَا نَحْنُ بِجَابِرِ بْنِ زَیْدٍ ، فَقُلْتُ : ذَاکَ أَبُو الشَّعْثَائِ ، اِئْتِہِ فَسَلْہُ ، ثُمَّ ارْجِعْ إلَیْنَا فَأَخْبِرْنَا ، فَأَتَاہُ فَسَأَلَہُ ، ثُمَّ رَجَعَ إلَیْنَا ، یُعْرَفُ فِی وَجْہِہِ الْبِشْرُ ، فَقَالَ : إِنَّہُ اسْتَکْتَمَنِی ، فَظَنَنَّا أَنَّہُ أَمَرَہُ بِدَمٍ۔","","Musannaf Ibn Abi Shaybah 12990","","","كتاب الحج"
"12991","(۱۲۹۹۱) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ؛ فِی رَجُلٍ یَلْمِسُ امْرَأَتَہُ فَیُنْزِلُ ، قَالاَ : عَلَیْہِ بَدَنَۃٌ ، وَالْحَجُّ مِنْ قَابِلٍ۔","","Musannaf Ibn Abi Shaybah 12991","","","كتاب الحج"
"12992","(۱۲۹۹۲) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی مُحْرِمٍ بَاشَرَ حَتَّی أَنْزَلَ ، قَالَ : أَرَاہُ قَدْ وَجَبَ عَلَیْہِ مَا وَجَبَ عَلَی الْمُجَامِعِ۔","","Musannaf Ibn Abi Shaybah 12992","","","كتاب الحج"
"12993","(۱۲۹۹۳) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِالْمِرْآۃِ لِلْمُحْرِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 12993","","","كتاب الحج"
"12994","(۱۲۹۹۴) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَنْظُرَ فِیہَا ، یُمِیطُ عَنْہُ الأَذَی۔","","Musannaf Ibn Abi Shaybah 12994","","","كتاب الحج"
"12995","(۱۲۹۹۵) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ لَمْ یَرَ بَأْسًا أَنْ یَنْظُرَ الْمُحْرِمُ فِی الْمِرْآۃِ۔","","Musannaf Ibn Abi Shaybah 12995","","","كتاب الحج"
"12996","(۱۲۹۹۶) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَمَّنْ حَدَّثَہُ عَنِ ابْنِ عَبَّاسٍ (ح) وَعَنْ حَجَّاجٍ ، عَنْ عَطَائٍ قَالاَ : لاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 12996","","","كتاب الحج"
"12997","(۱۲۹۹۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ مُسْلِمٍ ، عَنْ طَاوُوسٍ ، وَعِکْرِمَۃَ قَالاَ : لاَ بَأْسَ أَنْ یَنْظُرَ الْمُحْرِمُ فِی الْمِرْآۃِ۔","","Musannaf Ibn Abi Shaybah 12997","","","كتاب الحج"
"12998","(۱۲۹۹۸) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَنْظُرَ الْمُحْرِمُ فِی الْمِرْآۃِ۔","","Musannaf Ibn Abi Shaybah 12998","","","كتاب الحج"
"12999","(۱۲۹۹۹) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : حدَّثَنَا الزُّبَیْرُ بْنُ خِرِّیتٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ لاَ یَرَی بَأْسًا لِلْمُحْرِمِ أَنْ یَحْلِقَ عَنِ الشَّجَّۃِ ، وَأَنْ یَنْظُرَ فِی الْمِرْآۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 12999","","","كتاب الحج"
"13000","(۱۳۰۰۰) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ یَنْظُرُ الْمُحْرِمُ فِی الْمِرْآۃِ ، وَلاَ یَدْعُو عَلَی أَحَدٍ وَإِنْ ظَلَمَہُ۔","","Musannaf Ibn Abi Shaybah 13000","","","كتاب الحج"
"13001","(۱۳۰۰۱) حدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، أَنَّہُ کَرِہَ أَنْ یَنْظُرَ الْمُحْرِمُ فِی الْمِرْآۃِ۔","","Musannaf Ibn Abi Shaybah 13001","","","كتاب الحج"
"13002","(۱۳۰۰۲) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ حُنَیْنٍ ، عَنْ أَبِیہِ ، قَالَ : اخْتَلَفَ ابْنُ عَبَّاسٍ وَالْمِسْوَرُ بْنُ مَخْرَمَۃَ فِی الْمُحْرِمِ یَغْسِلُ رَأْسَہُ ، قَالَ : فَأَرْسَلُونِی إلَی أَبِی أَیُّوبَ ، فَأَتَیْتُہُ وَہُوَ بَیْنَ قَرْنَیِ الْبِئْرِ یَغْتَسِلُ ، فَقُلْتُ : إنَّ ابْنَ أَخِیکَ ابْنَ عَبَّاسٍ أَرْسَلَنِی إلَیْکَ یَقُولُ : کَیْفَ رَأَیْتَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَغْسِلُ رَأْسَہُ وَہُوَ مُحْرِمٌ ؟ فَأَخَذَ مِنَ الْمَائِ فَصَبَّہُ عَلَی رَأْسِہِ ، ثُمَّ أَقْبَلَ وَأَدْبَرَ ، ثُمَّ قَالَ: ہَکَذَا رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَغْسِلُ رَأْسَہُ وَہُوَ مُحْرِمٌ ، فَرَجَعْتُ إلَیْہِمَا فَأَخْبَرْتُہُمَا بِقَوْلِہِ، فَقَالَ الْمِسْوَرُ : لاَ أُخَالِفُکَ أَبَدًا۔","Sahih","Musannaf Ibn Abi Shaybah 13002","","","كتاب الحج"
"13003","(۱۳۰۰۳) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ لِی عُمَرُ : تَعَالَ حَتَّی أُبَاقِیَک فِی الْمَائِ أَیُّنَا أَصْبَرُ ؟ وَنَحْنُ مُحْرِمُونَ۔ (بخاری ۱۸۴۰۔ ابوداؤد ۱۸۳۶)","Sahih","Musannaf Ibn Abi Shaybah 13003","","","كتاب الحج"
"13004","(۱۳۰۰۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الْعَبَّاسِ بْنِ عَبْدِ اللہِ بْنِ مَعْبَدٍ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْت مَعَ خَالَتِی مَیْمُونَۃَ فَلَبَّدْتُ بِعَسَلٍ رَأْسِی ، أَوْ بِغَرائٍ وَأَنَا مُحْرِمٌ ، فَشَقَّ عَلَیَّ فَسَأَلْتُہَا ؟ فَقَالَتْ : اغْمِسْ رَأْسَک فِی الْمَائِ مِرَارًا۔","Sahih","Musannaf Ibn Abi Shaybah 13004","","","كتاب الحج"
"13005","(۱۳۰۰۵) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُسْلِمٍ الْقُرِّیِّ ، قَالَ : قُلْتُ لابْنِ عَبَّاسٍ : أَصُبّ عَلَی رَأْسِی الْمَائَ وَأَنَا مُحْرِمٌ ؟ قَالَ : لاَ بَأْسَ بِہِ ، إنَّ اللَّہَ تَعَالَی یَقُولُ : (إنَّ اللَّہَ یُحِبُّ التَّوَّابِینَ وَیُحِبُّ الْمُتَطَہِّرِینَ)۔","Hasan","Musannaf Ibn Abi Shaybah 13005","","","كتاب الحج"
"13006","(۱۳۰۰۶) حدَّثَنَا جَرِیرٌ ، عَنْ عَطَائٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ أَنْ یَغْتَسِلَ الْمُحْرِمُ فِی الْمَائِ۔","","Musannaf Ibn Abi Shaybah 13006","","","كتاب الحج"
"13007","(۱۳۰۰۷) حدَّثَنَا عَبَّادٌ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی أُمَامَۃَ التَّیْمِیِّ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ أَیَغْتَسِلُ الْمُحْرِمُ؟ فَقَالَ : وَہَلْ یَزِیدُہُ ذَلِکَ إِلاَّ شَعَثًا۔","Sahih","Musannaf Ibn Abi Shaybah 13007","","","كتاب الحج"
"13008","(۱۳۰۰۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : لاَ بَأْسَ أَنْ یَغْسِلَ الْمُحْرِمُ رَأْسَہُ وَیَتَغَطَّسَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 13008","","","كتاب الحج"
"13009","(۱۳۰۰۹) حدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : الْمُحْرِمُ یَغْتَسِلُ بِالْمَائِ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 13009","","","كتاب الحج"
"13010","(۱۳۰۱۰) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَغْتَسِلَ الْمُحْرِمُ بِالْمَائِ مِنْ غَیْرِ جَنَابَۃٍ۔","","Musannaf Ibn Abi Shaybah 13010","","","كتاب الحج"
"13011","(۱۳۰۱۱) حدَّثَنَا عَبْدَۃُ، عَنْ عُبیْدِ اللہِ بْنِ عُمَرَ، قَالَ: صَبَبْتُ عَلَی سَالِمٍ مَائً وَہُوَ مُحْرِمٌ، فَنَہَانِی أَنْ أَصُبَّ عَلَی رَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 13011","","","كتاب الحج"
"13012","(۱۳۰۱۲) حدَّثَنَا أبو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَن ، قَالَ : لاَ بَأْسَ أَنْ یَغْتَسِلَ الْمُحْرِمُ مِنْ غَیْرِ جَنَابَۃٍ۔","","Musannaf Ibn Abi Shaybah 13012","","","كتاب الحج"
"13013","(۱۳۰۱۳) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنَّا نَکُونُ بِالْخَلِیجِ مِنَ الْبَحْرِ بِالْجُحْفَۃِ ، فَنَتَغَامَسُ فِیہِ ، وَعُمَرُ یَنْظُرُ إلَیْنَا ، فَمَا یَعِیبُ ذَلِکَ عَلَیْنَا وَنَحْنُ مُحْرِمُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 13013","","","كتاب الحج"
"13014","(۱۳۰۱۴) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ حُسَیْنٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَخَّصَ فِی الثَّوْبِ الْمَصْبُوغِ لِلْمُحْرِمِ مَا لَمْ یَکُنْ لَہُ نَفْضٌ ، وَلاَ رَدْعٌ۔ (احمد ۱/۳۶۲۔ ابویعلی ۲۵۷۲)","Da'if","Musannaf Ibn Abi Shaybah 13014","","","كتاب الحج"
"13015","(۱۳۰۱۵) حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : أَحْرَمَ عَقِیلُ بْنُ أَبِی طَالِبٍ فِی ثَوْبَیْنِ وَرْدِیَّیْنِ ، فَرَآہُ عُمَرُ ، فَقَالَ : مَا ہَذَا ؟ فَقَالَ لَہُ عَلِیٌّ : إنَّ أَحَدًا لاَ یُعْلِمُنَا بِالسُّنَّۃِ۔","","Musannaf Ibn Abi Shaybah 13015","","","كتاب الحج"
"13016","(۱۳۰۱۶) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ زِیَادِ بْنِ سَعْدٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لاَ بَأْسَ بِالْمُضَرَّجِ لِلْمُحْرِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 13016","","","كتاب الحج"
"13017","(۱۳۰۱۷) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ أَنَّہُ کَانَ یَلْبَسُ الثِّیابَ الْمُوَرَّدَۃَ ، وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 13017","","","كتاب الحج"
"13018","(۱۳۰۱۸) حدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ عَبْدِ اللہِ بن عَبْدِ اللہِ ، قَالَ : کَانَ الْفِتْیَانُ یُحْرِمُونَ مَعَ ابْنِ عُمَرَ فِی الْمُوَرَّدَۃِ فَلاَ یَنْہَاہُمْ ، وَلاَ یُنْکِرُ عَلَیْہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 13018","","","كتاب الحج"
"13019","(۱۳۰۱۹) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ، عَنْ سُفْیَانَ، عَنْ یَزِیدَ، عَنْ مِقْسَمٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لاَ بَأْسَ بِالْمُوَرَّدَۃِ لِلْمُحْرِمِ۔","Da'if","Musannaf Ibn Abi Shaybah 13019","","","كتاب الحج"
"13020","(۱۳۰۲۰) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ مُحَمَّدٍ ، قَالَ : رَأَیْتُ عَلَی سَالِمٍ ثَوْبًا مُوَرَّدًا ، یَعْنِی وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 13020","","","كتاب الحج"
"13021","(۱۳۰۲۱) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، رَفَعَہُ ، قَالَ : لاَ یَلْبَسُ الْمُحْرِمُ ثَوْبٌ مَسَّہُ وَرْسٌ، وَلاَ زَعْفَرَانٌ۔ (بخاری ۵۷۹۴۔ احمد ۲/۴)","Sahih","Musannaf Ibn Abi Shaybah 13021","","","كتاب الحج"
"13022","(۱۳۰۲۲) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَائِشَۃَ ، قَالَتْ : یُکْرَہُ الثَّوْبُ الْمَصْبُوغُ بِالزَّعْفَرَانِ أَوْ الْمُشْبَعَۃِ بِالْعُصْفُرِ لِلرِّجَالِ وَالنِّسَائِ ، إِلاَّ أَنْ یَکُونَ ثَوْبًا غَسِیلاً۔","","Musannaf Ibn Abi Shaybah 13022","","","كتاب الحج"
"13023","(۱۳۰۲۳) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ وَبَرَۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ نَہَی أَنْ یُحْرِمَ الْمُحْرِمُ فِی الثَّوْبِ الْمَصْبُوغِ بِالْوَرْسِ وَالزَّعْفَرَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 13023","","","كتاب الحج"
"13024","(۱۳۰۲۴) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وطَاوُوس ، وَمُجَاہِدٍ ؛ أَنَّہُمْ کَرِہُوا الْعُرُوقَ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 13024","","","كتاب الحج"
"13025","(۱۳۰۲۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ الْمُعَصْفَرَ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 13025","","","كتاب الحج"
"13026","(۱۳۰۲۶) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُحْرِمَ الرَّجُلُ فِی الْمُعَصْفَرِ۔","","Musannaf Ibn Abi Shaybah 13026","","","كتاب الحج"
