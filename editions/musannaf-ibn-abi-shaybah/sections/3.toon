hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2005","(۲۰۰۵) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : الْجَوْرَبَانِ وَالنَّعْلاَنِ بِمَنْزِلَۃِ الْخُفَّیْنِ ، وَکَانَ لاَ یَرَی أَنْ یُمْسَح عَلَی وَاحِدٍ مِنْہُمَا دُونَ صَاحِبِہِ۔","","Musannaf Ibn Abi Shaybah 2005","","","كتاب الطهارة"
"2006","(۲۰۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا أَبُو جَعْفَرٍ الرَّازِیُّ ، عَنْ یَحْیَی الْبَکَّائِ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : الْمَسْحُ عَلَی الْجَوْرَبَیْنِ کَالْمَسْحِ عَلَی الْخُفَّیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 2006","","","كتاب الطهارة"
"2007","(۲۰۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ زَیْدٍ ؛ أَنَّ عَلِیًّا بَالَ وَمَسَحَ عَلَی النَّعْلَیْنِ۔","","Musannaf Ibn Abi Shaybah 2007","","","كتاب الطهارة"
"2008","(۲۰۰۸) حَدَّثَنَا أَبُو بَکْرٍ قَالَ : عَنْ حَسَنٍ ، عَنِ سَدِیرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ یُمْسَحُ عَلَی النَّعْلَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 2008","","","كتاب الطهارة"
"2009","(۲۰۰۹) حَدَّثَنَا شَرِیکٌ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ أَوْسِ بْنِ أَبِی أَوْسٍ قَالَ : انْتَہَیْتُ مَعَ أَبِی إِلَی مَائٍ مِنْ مِیَاہِ الأَعْرَابِ ، فَتَوَضَّأَ وَمَسَحَ عَلَی نَعْلَیْہِ ، فَقُلْتُ لَہُ ؟ فَقَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ۔n(ابوداؤد ۱۶۱۔ احمد ۴/۱۰۔ ابن حبان ۱۳۳۹)","","Musannaf Ibn Abi Shaybah 2009","","","كتاب الطهارة"
"2010","(۲۰۱۰) حَدَّثَنَا أَبُو بَکْرٍ ، عَنِ ابْنِ إِدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی ظَبْیَانَ ، قَالَ : رَأَیْتُ عَلِیًّا بَالَ قَائِمًا ، ثُمَّ تَوَضَّأَ وَمَسَحَ عَلَی نَعْلَیْہِ ، ثُمَّ أَقَامَ الْمُؤَذِّنُ فَخَلَعَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 2010","","","كتاب الطهارة"
"2011","(۲۰۱۱) حَدَّثَنَا وَکِیعٌ ، عَنِ سُفْیَان ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ أُکَیْلٍ ، عَنْ سُوَیْدِ بْنِ غَفَلَۃَ ؛ أَنَّ عَلِیًّا بَالَ وَمَسَحَ عَلَی النَّعْلَیْنِ۔","Majhul","Musannaf Ibn Abi Shaybah 2011","","","كتاب الطهارة"
"2012","(۲۰۱۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ أَبِی ظَبْیَانَ ؛ أَنَّہُ رَأَی عَلِیًّا بَالَ فِی الرَّحْبَۃِ ، ثُمَّ تَوَضَّأَ وَمَسَحَ عَلَی نَعْلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2012","","","كتاب الطهارة"
"2013","(۲۰۱۳) حَدَّثَنَا أَبُو بَکْرٍ ، عَنِ ابْنِ إِدْرِیسَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : رَأَیْتُ عَلَی إِبْرَاہِیمَ جُرْمَوْقَیْنِ مِنْ لُبُودٍ، یَمْسَحُ عَلَیْہِمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 2013","","","كتاب الطهارة"
"2014","(۲۰۱۴) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ ابْنِ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، فِی الْجُنُبِ یَعْرَقُ فِی الثَّوْبِ حَتَّی یَتَعَصَّر ؟ قَالَ : یُصَلِّی فِیہِ۔","","Musannaf Ibn Abi Shaybah 2014","","","كتاب الطهارة"
"2015","(۲۰۱۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِعَرَقِ الْجُنُبِ وَالْحَائِضِ۔","Sahih","Musannaf Ibn Abi Shaybah 2015","","","كتاب الطهارة"
"2016","(۲۰۱۶) حَدَّثَنَا ہُشیمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِعَرَقِ الْجُنُبِ وَالْحَائِضِ۔","","Musannaf Ibn Abi Shaybah 2016","","","كتاب الطهارة"
"2017","(۲۰۱۷) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنَ خُثَیْمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی الْجُنُبِ یَعْرَقُ فِی الثَّوْبِ ، فَیَأْخُذُ عَرَقُہُ ، فَیَتَمَسَّحُ بِہِ : لَمْ یَرَ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 2017","","","كتاب الطهارة"
"2018","(۲۰۱۸) حَدَّثَنَا ابْنُ مُبَارَکٍ، عَنْ ہِشَامٍ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِعَرَقِ الْجُنُبِ وَالْحَائِضِ۔","Sahih","Musannaf Ibn Abi Shaybah 2018","","","كتاب الطهارة"
"2019","(۲۰۱۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنِ الْقَاسِمِ، عَنْ عَائِشَۃَ؛ أَنَّہَا کَانَتْ لاَ تَرَی بِعَرَقِ الْجُنُبِ بَأْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 2019","","","كتاب الطهارة"
"2020","(۲۰۲۰) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ لاَ یَرَی بِعَرَقِ الْجُنُبِ بَأْسًا فِی الثَّوْبِ ، وَلَیْسَ عَلَیْہِ فِیہِ نَجَاسَۃٌ۔","","Musannaf Ibn Abi Shaybah 2020","","","كتاب الطهارة"
"2021","(۲۰۲۱) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنِ الْعَلاَئِ ؛ سَأَلْتُ حَمَّادًا عَنِ الْحَائِضِ تَعْرَقُ فِی ثِیَابِہَا ، أَتَغْسِلُ ثِیابَہَا ؟ قَالَ : إِنَّمَا یَفْعَلُ ذَلِکَ الْمَجُوسُ۔","","Musannaf Ibn Abi Shaybah 2021","","","كتاب الطهارة"
"2022","(۲۰۲۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَعْرَقُ فِی الثَّوْبِ وَہُوَ جُنُبٌ ، ثُمَّ یُصَلِّی فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2022","","","كتاب الطهارة"
"2023","(۲۰۲۳) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِعَرَقِ الْجُنُبِ فِی ثِیَابِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2023","","","كتاب الطهارة"
"2024","(۲۰۲۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ بَأْسَ بِعَرَقِ الْجُنُبِ فِی الثَّوْبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2024","","","كتاب الطهارة"
"2025","(۲۰۲۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْجُنُبِ یَعْرَقُ فِی الثَّوْبِ ؟ قَالَ : لاَ یَضُرُّہُ ، وَلاَ یَنْضَحَہُ بِالْمَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2025","","","كتاب الطهارة"
"2026","(۲۰۲۶) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ زُبَیْدٍ ، وَالأَعْمَشِ ، قَالاَ : کَانَ إِبْرَاہِیمُ یَنْتَہِی إِلَی بَابِ الْمَسْجِدِ فِی نَعْلَیْہِ، أَوْ فِی خُفَّیْہِ السَّرْقِیْنُ ، فَیَمْسَحُہُمَا ثُمَّ یَدْخُلُ فَیُصَلِّی۔","","Musannaf Ibn Abi Shaybah 2026","","","كتاب الطهارة"
"2027","(۲۰۲۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمِ بْنِ الْمُنْذِرِ ؛ سَأَلْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ عَنِ الرَّوْثِ یُصِیبُ النَّعْلَ ؟ قَالَ : امْسَحْہُ وَصَلِّ فِیہِ۔","","Musannaf Ibn Abi Shaybah 2027","","","كتاب الطهارة"
"2028","(۲۰۲۸) حَدَّثَنَا وَکِیعٌ عَنْ مِسْعَرٍ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، قَالَ : رَأَیْتَہُ یَحِکُّ نَعْلَہُ ، أَوْ خُفَّہُ عَلَی بَابِ الْمَسْجِدِ ، قَالَ : یَذْکُرُ أَنَّہُ طَہُورٌ","No Data Available","Musannaf Ibn Abi Shaybah 2028","","","كتاب الطهارة"
"2029","(۲۰۲۹) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : کَانُوا یَشْتَدُّونَ فِی الرَّوْثِ الرَّطْبِ إِذَا کَانَ فِی الْخُفِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 2029","","","كتاب الطهارة"
"2030","(۲۰۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْکَرِیمِ قَالَ : کَانَ عَزِیزًا عَلَی طَاوُوسَ إِذَا دَخَلَ الْمَسْجِدَ ، أَنْ لاَ یَقْلِبَ خُفَّہُ ، أَوْ نَعْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2030","","","كتاب الطهارة"
"2031","(۲۰۳۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حَجَّاجٌ ، عَنْ أَبِی جَعْفَرٍ ، وَعَطَائٍ ؛ أَنَّہُمَا لَمْ یَرَیَا بِدَمِ الْبَرَاغِیثِ وَالْبَعُوضِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 2031","","","كتاب الطهارة"
"2032","(۲۰۳۲) حَدَّثَنَا ہِشَامٌ ، قَالَ : أَخْبَرَنَا أَشْعَثُ بْنُ سَوَّارٍ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ : کَانَ الْحَسَنُ لاَ یَرَی بِدَمِ الذُّبَابِ وَالْبَعُوضِ وَالْبَرَاغِیثِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 2032","","","كتاب الطهارة"
"2033","(۲۰۳۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : صَلَّیْتُ وَفِی ثَوْبِی دَمُ ذُبَابٍ ، فَقُلْتُ لأَبِی ؟ فَقَالَ : لاَ یَضُرُّکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2033","","","كتاب الطهارة"
"2034","(۲۰۳۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَعَطَائٍ ، قَالاَ : لاَ بَأْسَ بِدَمِ الْبَرَاغِیثِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2034","","","كتاب الطهارة"
"2035","(۲۰۳۵) حَدَّثَنَا زَاجِرُ بْنُ الصَّلْتِ ، عَنِ الْحَارِثِ بْنِ مَالِکٍ ، قَالَ : انْطَلَقْتُ إِلَی مَنْزِلِ الْحَسَنِ ، فَجَائَ رَجُلٌ فَسَأَلَہُ، فَقَالَ : یَا أَبَا سَعِیدٍ ، الرَّجُلُ یَبِیتُ فِی الثَّوْبِ ، فَیُصْبِحُ وَفِیہِ مِنْ دَمِ الْبَرَاغِیثِ شَیْئٌ کَثِیرٌ یَغْسِلُہُ ، أَوْ یَنْضَحُہُ ، أَوْ یُصَلِّی فِیہِ ؟ قَالَ : لاَ یَنْضَحُہُ ، وَلاَ یَغْسِلُہُ ، یُصَلِّی فِیہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2035","","","كتاب الطهارة"
"2036","(۲۰۳۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حَدَّثَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِدَمِ السَّمَکِ ، إِلاَّ أَنْ تَقْذَرَہُ۔","","Musannaf Ibn Abi Shaybah 2036","","","كتاب الطهارة"
"2037","(۲۰۳۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : اغْسِلْ مَا أَصَابَکَ مِنْ دَمِ الصَّیْدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2037","","","كتاب الطهارة"
"2038","(۲۰۳۸) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا أَشْعَثُ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ فِی مُتَیَمِّمٍ مَرَّ بِمَائٍ غَیْرَ مُحْتَاجٍ إِلَی الْوُضُوئِ فَجَاوَزَہُ ، فَحَضَرَتِ الصَّلاَۃُ وَلَیْسَ مَعَہُ مَائٌ ، قَالَ : یُعِیدُ التَّیَمُّمَ ، لأَنَّ قُدْرَتَہُ عَلَی الْمَائِ تُنْقِضُ تَیَمُّمَہُ الأَوَّلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2038","","","كتاب الطهارة"
"2039","(۲۰۳۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : الْقَیْئُ وَالْخَمْرُ وَالدَّمُ بِمَنْزِلَۃٍ ، یَعْنِی : فِی الثَّوْبِ","","Musannaf Ibn Abi Shaybah 2039","","","كتاب الطهارة"
"2040","(۲۰۴۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنِ مُحَمَّدِ الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِذَا أَصَابَ ثَوْبَکَ خَمْرٌ فَاغْسِلْہُ ہُوَ أَشَدُّ مِنَ الدَّمِ۔","","Musannaf Ibn Abi Shaybah 2040","","","كتاب الطهارة"
"2041","(۲۰۴۱) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، أَنَّہُمَا قَالاَ : لاَ بَأْسَ أَنْ یَرُشَّ الْجُنُبُ وَالْحَائِضُ الْمَسْجِدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2041","","","كتاب الطهارة"
"2042","(۲۰۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَنَسٍ ؛ أَنَّ أَعْرَابِیًّا بَالَ فِی الْمَسْجِدِ ، فَدَعَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِذَنُوبٍ مِنْ مَائٍ ، فَصَبَّہُ عَلَی بَوْلِہِ۔ (بخاری ۲۲۱۔ مسلم ۲۳۶)","Sahih","Musannaf Ibn Abi Shaybah 2042","","","كتاب الطهارة"
"2043","(۲۰۴۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنَا إِسْمَاعِیلُ ، عَنْ قَیْسٍ قَالَ : بَالَ أَعْرَابِیٌّ فِی الْمَسْجِدِ ، فَأَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصُبَّ عَلَی بَوْلِہِ مَائٌ۔","","Musannaf Ibn Abi Shaybah 2043","","","كتاب الطهارة"
"2044","(۲۰۴۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : دَخَلَ أَعْرَابِیٌّ الْمَسْجِدَ وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیہِ ، فَبَالَ ، فَأَمَرَ بِسَجْلٍ مِنْ مَائٍ ، فَأَفْرَغَ عَلَی بَوْلِہِ۔n(احمد ۲/۵۰۳۔ ابن حبان ۹۸۵)","Hasan","Musannaf Ibn Abi Shaybah 2044","","","كتاب الطهارة"
"2045","(۲۰۴۵) حَدَّثَنَا یَحْیَی بْنُ عِیسَی الرَّمْلِیُّ ، عَنْ رَزِینٍ قَالَ : جَائَ رَجُلٌ إِلَی أَبِی جَعْفَرٍ ، فَقَالَ لَہُ : إِنِّی أَخْرُجُ فِی اللَّیْلَۃِ الْمَطِیرَۃِ فَأَدُوسُ الطِّینَ ؟ قَالَ : صَلِّ ، قَالَ : إِنِّی أَخَافُ أَنْ یَکُونَ فِیہَا النَّتَنُ وَالْقَذَرَۃُ ، فَکَأَنَّہُ غَضَبَ ، فَقَالَ : أَنْ کُنْتُ تَدُوسُ النَّتَننَ بِرِجْلَیْکَ ، فَخُذْ مَعَکَ مَائً فَاغْسِلْ بِہِ رِجْلَیْکَ۔","","Musannaf Ibn Abi Shaybah 2045","","","كتاب الطهارة"
"2046","(۲۰۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیِّبِ ، أَنَّہُ قَالَ لِرَجُلٍ :أَلاَ مَسَحْتَہُمَا وَدَخَلْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2046","","","كتاب الطهارة"
"2047","(۲۰۴۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ قَالَ : کَانَ عَلِیٌّ یَخُوضُ طِینَ الْمَطَرِ وَیَدْخُلُ الْمَسْجِدَ ، فَیُصَلِّی وَلاَ یَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 2047","","","كتاب الطهارة"
"2048","(۲۰۴۸) حَدَّثَنَا شَرِیکٌ ، عَنْ حَکِیمِ بْنِ الدَّیْلَمِ ، قَالَ : رَأَیْتُ ابْنَ مَعْقِلٍٍ فِی یَوْمٍ مَطِیرٍ ، قَائِمًا یُصَلِّی إِلَی سَارِیَۃٍ فِی الْمَسْجِدِ ، وَعَلَی رِجْلَیْہِ مِثْلُ الْخَلْخَالَیْنِ أَوِ الْحِجَالَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 2048","","","كتاب الطهارة"
"2049","(۲۰۴۹) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : رَأَیْتُ عَلْقَمَۃَ ، وَالأَسْوَدَ یَخُوضَانِ مَائَ الْمَطَرِ ، وَأَنَّ الْمَیَازِیبَ تَنْثَعِبُ ، ثُمَّ دَخَلاَ الْمَسْجِدَ ، فَصَلَّیَا وَلَمْ یَتَوَضَّآ۔","","Musannaf Ibn Abi Shaybah 2049","","","كتاب الطهارة"
"2050","(۲۰۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ إِذَا دَخَلَ الْمَسْجِدَ فِی الأَمْطَارِ نَظَرَ إِلَی خُفَّیْہِ ، فَإِنْ کَانَ فِیہِمَا طِینٌ قَلِیلٌ مَسَحَہُ ، ثُمَّ دَخَلَ فَصَلَّی ، وَإِنْ کَانَ کَثِیرًا خَلَعَہُمَا وَأَمَرَ بِہِمَا فَغَسَلاَ۔","","Musannaf Ibn Abi Shaybah 2050","","","كتاب الطهارة"
"2051","(۲۰۵۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ قَالَ : کَانَ أَصْحَابُنَا یَخُوضُونَ الْمَائَ وَالطِّینَ إِلَی مَسَاجِدِہِمْ ، وَیصَلُّونَ وَلاَ یَغْسِلونَ أَرْجُلَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2051","","","كتاب الطهارة"
"2052","(۲۰۵۲) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ الْمُخْتَارِ بْنِ سَعْدٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ دَخَلَ الْمَسْجِدَ یَوْمَ مَطَرٍ، وَلَمْ یَغْسِلْ رِجْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 2052","","","كتاب الطهارة"
"2053","(۲۰۵۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، قَالَ : کُنْتُ أَخَوضُ الْمَطَرَ ، فَسَأَلْتُ الْحَکَمَ ؟ فَقَالَ : صَلِّہْ ، صَلِّہْ۔n قَالَ : وَسَمِعْتُ أَبَا إِسْحَاقَ ، یَقُولُ : کَانُوا یَخُوضُونَ ثُمَّ یُصَلُّونَ ، وَلاَ یَحْمِلُونَ مَعَہُمُ الأَکْوَازَ۔","","Musannaf Ibn Abi Shaybah 2053","","","كتاب الطهارة"
"2054","(۲۰۵۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ عَمْرِو بْنِ عَبْدِ اللہِ ، قَالَ : کَانَ ہُذَیْلٌ یَخُوضُ الرِّدَاغَ فِی خُفَّیْہِ ، ثُمَّ یُصَلِّی فِیہِمَا۔","","Musannaf Ibn Abi Shaybah 2054","","","كتاب الطهارة"
"2055","(۲۰۵۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : مَرَرْتُ مَعَ ابْنِ سِیرِینَ فِی طَرِیقٍ ، فقَطَرَ عَلَیْہِ مِیزَابٌ ، فَسَأَلَ عَنْہُ ، فَقِیلَ : إِنَّہُ نَظِیفٌ ، فَلَمْ یَلْتَفِتْ إِلَیْہِ ، وَلَمْ یُبَالِ۔","","Musannaf Ibn Abi Shaybah 2055","","","كتاب الطهارة"
"2056","(۲۰۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَلِیِّ بْنِ مَسْعَدَۃَ ، قَالَ : حَدَّثَنَا عَبْدُ اللہِ الرُّومِیُّ قَالَ : کَانَ عُثْمَانُ یَقُومُ مِنَ اللَّیْلِ فَیَلِی طَہُورَہُ بِنَفْسِہِ ، فَیُقَالُ لَہُ : لَوْ أَمَرْتَ بَعْضَ الْخَدَمِ ، فَقَالَ : إِنِّی أُحِبُّ أَنْ أَلِیَہُ بِنَفْسِی۔","Majhul","Musannaf Ibn Abi Shaybah 2056","","","كتاب الطهارة"
"2057","(۲۰۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنِ الْعَبَّاسِ بْنِ عَبْدِ الرَّحْمَنِ الْمَدَنِیِّ قَالَ : خَصْلَتَانِ لَمْ یَکُنْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَکِلْہُمَا إِلَی أَحَدٍ مِنْ أَہْلِہِ ، کَانَ یُنَاوِلُ الْمِسْکِینَ بِیَدِہِ ، وَیَضَعُ الطَّہُورَ مِنَ اللَّیْلِ وَیُخَمِّرُہُ۔ (ابن ماجہ ۳۶۲)","Da'if","Musannaf Ibn Abi Shaybah 2057","","","كتاب الطهارة"
"2058","(۲۰۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنْ مُصْعَبِ بْنِ شَیْبَۃَ ، عَنْ طَلْقٍ ، عَنِ ابْنِ الزُّبَیْرِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَشْرٌ مِنَ الْفِطْرَۃِ : قَصُّ الشَّارِبِ ، وَإِعْفَائُ اللِّحْیَۃِ ، وَالسِّوَاکُ ، وَالإِسْتِنْشَاقُ بِالْمَائِ ، وَقَصُّ الأَظْفَارِ ، وَغَسْلُ الْبَرَاجمِ ، وَنَتْفُ الإِبِطِ ، وَحَلْقُ الْعَانَۃِ ، وَانْتقَاصُ الْمَائِ ۔ قَالَ مُصْعَبٌ : وَنَسِیتُ الْعَاشِرَۃَ ، إِلاَّ أَنْ تَکونَ الْمَضْمَضَۃَ۔ (مسلم ۲۲۳۔ ابن ماجہ ۲۹۳)","Hasan","Musannaf Ibn Abi Shaybah 2058","","","كتاب الطهارة"
"2059","(۲۰۵۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : خمْسٌ مِنَ الْفِطْرَۃِ : الْخِتَانُ ، وَالْاِسْتِحْدَادُ ، وَتَقْلِیمُ الأَظْفَارِ ، وَنَتْفُ الإِبِطِ ، وَقَصُّ الشَّارِبِ۔n(بخاری ۵۸۸۹۔ مسلم ۲۲۱)","Sahih","Musannaf Ibn Abi Shaybah 2059","","","كتاب الطهارة"
"2060","(۲۰۶۰) حَدَّثَنَا قَبِیصَۃُ بْنُ عُقْبَۃَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ سَلَمَۃَ بْنِ مُحَمَّدٍ ، عَنْ عَمَّارِ بْنِ یَاسِرٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْفِطْرَۃُ الْمَضْمَضَۃُ ، وَالْاِسْتِنْشَاقُ ، وَالسِّوَاکُ ، وَقَصُّ الشَّارِبِ ، وَنَتْفُ الإِبِطِ ، وَغَسْلُ الْبَرَاجِمِ ، وَتَقْلِیمُ الأَظْفَارِ ، وَالْاِنْتِضَاحُ بِالْمَائِ ، وَالْخِتَانُ۔n(ابوداؤد ۵۵۔ ابن ماجہ ۲۹۴)","Majhul","Musannaf Ibn Abi Shaybah 2060","","","كتاب الطهارة"
"2061","(۲۰۶۱) حَدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : سِتٌّ مِنْ فِطْرَۃِ إِبْرَاہِیمَ عَلَیْہِ السَّلاَمُ : قَصُّ الشَّارِبِ ، وَالسِّوَاکُ، وَالْفَرْقُ، وَقَصُّ الأَظْفَارِ، وَالْاِسْتِنْجَائُ، وَحَلْقُ الْعَانَۃِ۔ قَالَ: ثَلاَثَۃٌ فِی الرَّأْسِ، وَثَلاَثَۃٌ فِی الْجَسَدِ۔","","Musannaf Ibn Abi Shaybah 2061","","","كتاب الطهارة"
"2062","(۲۰۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدیُّ ، وَأُسَامَۃَ ، قَالاَ : حَدَّثَنَا مِسْعَرٌ ، عَنْ عُمَرَ بْنِ أَیُّوبَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِنَّ لِلشَّیْطَانِ زُفَّۃً ، یَعْنِی : بِلَّۃَ طَرْفِ الإِحْلِیلِ","","Musannaf Ibn Abi Shaybah 2062","","","كتاب الطهارة"
"2063","(۲۰۶۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنَا مِسْعَرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَا تَفَقَّدہُ إِنْسَانٌ إِلاَّ رَأَی مَا یَکْرَہُ ، أَوْ یَسُوئُہُ ، یَعْنِی : بِلَّۃَ طَرْفِ الإِحْلِیلِ","No Data Available","Musannaf Ibn Abi Shaybah 2063","","","كتاب الطهارة"
"2064","(۲۰۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنَا مِسْعَرٌ ، عَنْ مَنْصُورٍ ، قَالَ : إِنَّہُ یبلُّ طَرْفَ الإِحْلِیلِ۔","","Musannaf Ibn Abi Shaybah 2064","","","كتاب الطهارة"
"2065","(۲۰۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنَا مِسْعَرٌ ، عَنْ رَجُلٍ مِنْ قُرَیْشٍ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلٍ ، قَالَ : کَانُوا لاَ یَتَفَقَّدُونَ ذَلِکَ التَّفقُّدَ۔","Majhul","Musannaf Ibn Abi Shaybah 2065","","","كتاب الطهارة"
"2066","(۲۰۶۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنَا مِسْعَرٌ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، قَالَ : مَا وَسَاوِسُہُ بِأَوْلَعَ مِمَّنْ یَرَاہَا تَعْمَلُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 2066","","","كتاب الطهارة"
"2067","(۲۰۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ مُسْلِم بْنِ عَطِیَّۃَ ، قَالَ : قَالَ طَاوُوسٌ : وَلِمَ تَنْظرُ إلی ذَکَرِکَ۔","","Musannaf Ibn Abi Shaybah 2067","","","كتاب الطهارة"
"2068","(۲۰۶۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی بَکْرِ بْنِ رُوَیْبَۃَ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلٍ ، قَالَ : مَا تَفَقَّدَ رَجُلٌ ذَکَرَہُ ذَلِکَ التَّفقُّدَ إِلاَّ رَأَی مَا یَکْرَہُ۔","","Musannaf Ibn Abi Shaybah 2068","","","كتاب الطهارة"
"2069","(۲۰۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُفَضَّلِ بْنِ مُہَلْہَلٍ ، عَنْ مَنْصُورٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : قَالَ ابْنُ الزُّبَیْرِ : إِنَّ الشَّیْطَانَ یَأْتِی الإِنْسَانَ مِنْ قِبَلِ الْوُضُوئِ وَالشَّعَرِ وَالظُّفْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 2069","","","كتاب الطهارة"
"2070","(۲۰۷۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ؛ فِیمَنْ نَسِیَ الْمَضْمَضَۃَ فِی الْوُضُوئِ أَوِالْاِسْتِنْشَاقِ ، قَالَ : یُمَضْمِضُ وَیَسْتَنْشِقُ وَیُعِیدُ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 2070","","","كتاب الطهارة"
"2071","(۲۰۷۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ حَجَّاجٍ، عَنْ عَائِشَۃَ بِنْتِ عَجْرَدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِذَا صَلَّی الرَّجُلُ فَنَسِیَ أَنْ یُمَضْمِضَ وَیَسْتَنْشِقَ مِنْ جَنَابَۃٍ ، أَعَادَ الْمَضْمَضَۃَ وَالْاِسْتِنْشَاقَ۔","Majhul","Musannaf Ibn Abi Shaybah 2071","","","كتاب الطهارة"
"2072","(۲۰۷۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مُثنَّی ، عَنْ عَطَائٍ ؛ فِیمَنْ نَسِیَ الْمَضْمَضَۃَ وَالْاِسْتِنْشَاقَ حَتَّی صَلَّی ، قَالَ : لَیْسَ عَلَیْہِ إِعَادَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 2072","","","كتاب الطهارة"
"2073","(۲۰۷۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَنْسَی الْمَضْمَضَۃَ ، قَالَ : إِنْ کَانَ دَخَلَ فِی الصَّلاَۃِ فَلْیُمْضِ ، وَإِنْ لَمْ یَکُنْ دَخَلَ فِی الصَّلاَۃِ فَلْیُمَضْمِضْ وَلْیَسْتَنْشِقْ۔","No Data Available","Musannaf Ibn Abi Shaybah 2073","","","كتاب الطهارة"
"2074","(۲۰۷۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ قَالَ : یُعِیدُ الرَّجُلُ الصَّلاَۃَ مِنْ نِسْیَانِ الْمَضْمَضَۃِ وَالْاِسْتِنْشَاقِ۔","","Musannaf Ibn Abi Shaybah 2074","","","كتاب الطهارة"
"2075","(۲۰۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا ، وَقَتَادَۃَ ، عَنِ الرَّجُلِ یَنْسَی الْمَضْمَضَۃَ وَالْاِسْتِنْشَاقَ حَتَّی یَقُومَ فِی الصَّلاَۃِ ، قَالَ الْحَکَمُ وَقَتَادَۃُ : یَمْضِی ، وَقَالَ حَمَّادٌ : یَنْصَرِفُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2075","","","كتاب الطهارة"
"2076","(۲۰۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا نَسِیَ الْمَضْمَضَۃَ وَالْاِسْتِنْشَاقَ فِی الْجَنَابَۃِ أَعَادَ ، وَإِذَا نَسِیَ فِی الْوُضُوئِ أَجْزَأَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2076","","","كتاب الطهارة"
"2077","(۲۰۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، ؛ فِی الرَّجُلِ نَسِیَ الْمَضْمَضَۃَ وَالْاِسْتِنْشَاقَ حَتَّی صَلَّی، قَالَ : لاَ یَعْتَدُّ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 2077","","","كتاب الطهارة"
"2078","(۲۰۷۸) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، وَأَبِی الْہَیْثَمِ ، عَنْ إِبْرَاہِیمَ قَالَ : لَیْسَ الْاِسْتِنْشَاقُ بِوَاجِبٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 2078","","","كتاب الطهارة"
"2079","(۲۰۷۹) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ قَالَ : إِذَا نَسِیَ الرَّجُلُ الْمَضْمَضَۃَ وَالْاِسْتِنْشَاقَ فَلاَ یُعِیدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2079","","","كتاب الطهارة"
"2080","(۲۰۸۰) حَدَّثَنَا حَسَنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : الرَّجُلُ یَنْسَی الْاِسْتِنْشَاقِ ، فَیَذْکُرُ فِی الصَّلاَۃِ أَنَّہُ نَسِیَ؟ قَالَ إِبْرَاہِیمُ: یَمْضِی فِی صَلاَتِہِ، قَالَ: وَقَالَ مَنْصُورٌ: وَالْمَضْمَضَۃُ مِثْلُ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 2080","","","كتاب الطهارة"
"2081","(۲۰۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : إِنْ کَانَ بَعْضُ أُمَّہَاتِ الْمُؤْمِنِینَ لَتَقْرُصُ الدَّمَ مِنْ ثَوْبِہَا بِرِیقِہَا۔","","Musannaf Ibn Abi Shaybah 2081","","","كتاب الطهارة"
"2082","(۲۰۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ یَزِیدَ بْنِ زِیَادٍ ، أَنَّ الْحَسَنَ بْنَ عَلِیٍّ رَأَی فِی قَمِیصِہِ دَمًا ، فَبَزَقَ فِیہِ ، ثُمَّ دَلَکَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 2082","","","كتاب الطهارة"
"2083","(۲۰۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حُسَیْنِ بْنِ جَعْفَرٍ ، قَالَ : حَدَّثَنِی سَلِیطُ بْنُ عَبْدِ اللہِ بْنِ یَسَارٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ رَأَی فِی جُِرْبَانِہِ دَمًا ، فَبَزَقَ فِیہِ ، ثُمَّ دَلَکَہُ۔","Majhul","Musannaf Ibn Abi Shaybah 2083","","","كتاب الطهارة"
"2084","(۲۰۸۴) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : رَأَیْتُ مَیْمُونَ بْنَ مِہْرَانَ یَوْمًا وَہُوَ یُصَلِّی ، فَرَأَی فِی ثَوْبِہِ دَمًا ، فَقَالَ بِہِ ہَکَذَا ، یَعْنِی : بِرِیقِہِ ، ثُمَّ فَرَکَہُ بِیَدِہِ۔","","Musannaf Ibn Abi Shaybah 2084","","","كتاب الطهارة"
"2085","(۲۰۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ، وَعَامِرٍ، وَعَطَائٍ، قَالُوا: لاَ یُغْسَلُ الدَّمُ بِالْبُزَاقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2085","","","كتاب الطهارة"
"2086","(۲۰۸۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ رَأَی فِی ثَوْبِہِ دَمًا فَغَسَلَہُ ، فَبَقِیَ أَثَرُہُ أَسْوَدَ ، وَدَعَا بِمِقَصٍّ فَقَصَّہُ فَقَرَضَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2086","","","كتاب الطهارة"
"2087","(۲۰۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا غَسَلْتَ الدَّمَ فَبَقِیَ أَثَرُہُ فَلاَ یَضُرُّکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2087","","","كتاب الطهارة"
"2088","(۲۰۸۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الْفَضْلِ بْنِ دَلْہَمٍ ، عَنِ الْحَسَنِ ، مِثْلَہُ","No Data Available","Musannaf Ibn Abi Shaybah 2088","","","كتاب الطهارة"
"2089","(۲۰۸۹) حَدَّثَنَا وَکِیعٌ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ، عَنْ کَرِیمَۃَ ابْنَۃِ ہَمَّامٍ، قَالَتْ: سَمِعْتُ عَائِشَۃَ، وَسُئِلَتْ عَنْ دَمِ الْمَحِیضِ یُصِیبُ الثَّوْبَ ؟ فَقَالَتْ : اغْسِلِیہِ ، فَقَالَتْ : غَسَلْتُہُ فَلَمْ یَذْہَبْ أَثَرُہُ ، فَقَالَتْ : اغْسِلِیہِ فَإِنَّ الْمَائَ طَہُورٌ۔","","Musannaf Ibn Abi Shaybah 2089","","","كتاب الطهارة"
"2090","(۲۰۹۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ غُشِیَ عَلَیْہِ وَہُوَ جَالِسٌ، قَالَ: یَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 2090","","","كتاب الطهارة"
"2091","(۲۰۹۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا أَفَاقَ الْمُصَابُ تَوَضَّأَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2091","","","كتاب الطهارة"
"2092","(۲۰۹۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، قَالَ : حَدَّثَنِی عُبَیْدُ اللہِ بْنُ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : أَتَیْتُ عَائِشَۃَ ، فَقُلْتُ : حَدِّثِینِی عَنْ مَرَضِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : نَعَمْ ، مَرِضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَثَقُلَ ، فَأُغْمِیَ عَلَیْہِ ، فَأَفَاقَ فَقَالَ : ضَعُوا لِی مَائً فِی الْمِخْضَبِ ، قَالَتْ: فَفَعَلْنَا ، قَالَتْ : فَاغْتَسَلَ ، فَذَہَبَ لِینُوئَ فَأُغْمِیَ عَلَیْہِ ، ثُمَّ أَفَاقَ فَقَالَ : ضَعُوا لِی مَائً فِی الْمِخْضَبِ ، قَالَتْ : فَفَعَلْنَا ، قَالَتْ : فَاغْتَسَلَ ، فَذَہَبَ لِینُوئَ فَأُغْمِیَ عَلَیْہِ ، ثُمَّ أَفَاقَ فَقَالَ :ضَعُوا لِی مَائً فِی الْمِخْضَبِ ، فَاغْتَسَلَ حَتَّی فَعَلَہُ مِرَارًا۔ (بخاری ۶۸۷۔ مسلم ۳۱۱)","Sahih","Musannaf Ibn Abi Shaybah 2092","","","كتاب الطهارة"
"2093","(۲۰۹۳) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمِ بْنِ بَہْدَلَۃَ ، عَنْ مُوسَی بْنِ طَلْحَۃَ؛ أَنَّ عُثْمَانَ کَانَ یَغْتَسِلُ فِی کُلِّ یَوْمٍ مَرَّۃً۔","Hasan","Musannaf Ibn Abi Shaybah 2093","","","كتاب الطهارة"
"2094","(۲۰۹۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ، عَنْ عَلِیٍّ ، قَالَ : إِنِّی لَأَغْتَسِلُ فِی اللَّیْلَۃِ الْبَارِدَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 2094","","","كتاب الطهارة"
"2095","(۲۰۹۵) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَغْتَسِلُ فِی کُلِّ یَوْمٍ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 2095","","","كتاب الطهارة"
"2096","(۲۰۹۶) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَغْتَسِلُ فِی کُلِّ یَوْمٍ مَرَّۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 2096","","","كتاب الطهارة"
"2097","(۲۰۹۷) حَدَّثَنَا وَکِیعٌ ، وَحُمَیْدٌ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلَمَۃَ ، قَالَ : قَالَ عَلِیٌّ : إِنِّی لَأَغْتَسِلُ فِی اللَّیْلَۃِ الْبَارِدَۃِ مِنْ غَیْرِ جَنَابَۃٍ ، لأَتَجَلَّدَ بِہِ وَأَتَطَہَّرَ۔","Hasan","Musannaf Ibn Abi Shaybah 2097","","","كتاب الطهارة"
"2098","(۲۰۹۸) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ أَبِی صَخْرَۃَ جَامِعِ بْنِ شَدَّادٍ، قَالَ: سَمِعْتُ حُمْرَانَ بْنَ أَبَانَ، مَوْلَی عُثْمَانَ بْنِ عَفَّانَ یَقُولُ : کُنْتُ أَضَعُ لِعُثْمَانَ طَہُورَہُ ، فَمَا أَتَی عَلَیْہِ یَوْمٌ إِلاَّ وَہُوَ یُفِیضُ عَلَیْہِ فِیہِ نُطْفَۃً مِنْ مَائٍ۔","Sahih","Musannaf Ibn Abi Shaybah 2098","","","كتاب الطهارة"
"2099","(۲۰۹۹) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی فَرْوَۃَ ، قَالَ : ذَہَبْتُ مَعَ ابْنِ أَبِی لَیْلَی إِلَی الْفُرَاتِ ، فَدَخَلَہُ بِثَوْبٍ ، أَوْ قَالَ : بِمِئْزَرٍ ، وَقَالَ : إِنَّ لَہُ لَسَاکِنًا۔","","Musannaf Ibn Abi Shaybah 2099","","","كتاب الطهارة"
"2100","(۲۱۰۰) حَدَّثَنَا الْمُحَارِبِیُّ، عَنْ لَیْثٍ، قَالَ: أَخْبَرَنِی مَنْ رَأَی حُسَیْنَ بْنَ عَلِیٍّ دَخَلَ الْمَائَ بِإِزَارٍ، وَقَالَ: إِنَّ لَہُ سَاکِنًا۔","Da'if","Musannaf Ibn Abi Shaybah 2100","","","كتاب الطهارة"
"2101","(۲۱۰۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، قَالَ : حَدَّثَنِی مَنْ رَأَی عُمَرَ مُسْتَنْقِعًا فِی الْمَائِ وَعَلَیْہِ قَمِیصٌ ، ثُمَّ خَرَجَ فَدَعَا بِمِلْحَفَۃٍ فَلَبِسَہا فَوْقَ الْقَمِیصِ۔","Majhul","Musannaf Ibn Abi Shaybah 2101","","","كتاب الطهارة"
"2102","(۲۱۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنَا ہشَامُ بْنُ سَعْدٍ ، قَالَ : حَدَّثَنَا زَیْدُ بْنُ أَسْلَمَ ، عَنْ عَمْرِو بْنِ سَعْدٍ الْجَارِی ، وَکَانَ مَوْلَی عُمَرَ ، قَالَ : أَتَانَا عُمَرُ صَادِرًا عَنِ الْحَجِّ ، فِی نَفَرٍ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا سَعْدُ ، أَبْغِنَا مَنَادِیلَ ، فَأُتِیَ بِمَنَادِیلَ ، فَقَالَ : اغْتَسِلُوا فِیہِ ، فَإِنَّہُ مُبَارَکٌ۔","Majhul","Musannaf Ibn Abi Shaybah 2102","","","كتاب الطهارة"
"2103","(۲۱۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ عِیسَی بْنِ ہِلاَلٍ ، عَنْ کَثِیرٍ ، مَوْلَی سَلَمَۃَ ، قَالَ : مَنْ ذَبَحَ ذَبِیحَۃً فَلْیَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 2103","","","كتاب الطهارة"
"2104","(۲۱۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، ؛ فِی الرَّجُلِ یَذْبَحُ الْبَعِیرَ أَوِالشَّاۃَ ، قَالَ : إِنْ أَصَابَہُ دَمٌ غَسَلَہُ ، وَلَیْسَ عَلَیْہِ وُضُوئٌ۔","","Musannaf Ibn Abi Shaybah 2104","","","كتاب الطهارة"
"2105","(۲۱۰۵) حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ ، عَنْ زَائِدَۃَ ، عَنِ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا تَوَضَّأَ الرَّجُلُ ثُمَّ ذَبَحَ شَاۃً لَمْ یَقْطَعْ ذَلِکَ طَہُورَہُ ، وَإِنْ أَصَابَہُ دَمٌ غَسَلَہُ ، وَإِنْ لَمْ یُصِبْہُ دَمٌ فَلاَ شَیْئَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 2105","","","كتاب الطهارة"
"2106","(۲۱۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ دَخَلَ الْخَلاَئَ وَعَلَیْہِ خُفَّاہُ ، ثُمَّ خَرَجَ فَتَوَضَّأَ ، وَمَسَحَ عَلَیْہِمَا۔","","Musannaf Ibn Abi Shaybah 2106","","","كتاب الطهارة"
"2107","(۲۱۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا عُمَرُ بْنُ ذَرٍّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ الْحَارِثِ ، قَالَ : دَعَوْتُ إِبْرَاہِیمَ النَّخَعِیَّ ، وَإِبْرَاہِیمَ التَّیْمِیَّ ، فَدَخَلاَ الْخَلاَئَ فِی أَخْفَافِہِمَا ، ثُمَّ خَرَجَا ، فَتَوَضَّئَا وَمَسَحَا عَلَی خِفَافِہِمَا ، ثُمَّ صَلَّیَا۔","No Data Available","Musannaf Ibn Abi Shaybah 2107","","","كتاب الطهارة"
"2108","(۲۱۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ، عَنْ إِبْرَاہِیمَ ، وَالْحَکَمِ ؛ أَنَّہُمَا کَانَا إِذَا أَرَادَا أَنْ یَبُولاَ لَبِسَا خِفَافَہُمَا کَیْ یَمْسَحَا۔","","Musannaf Ibn Abi Shaybah 2108","","","كتاب الطهارة"
"2109","(۲۱۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : لَیْسَ عَلَی الثَّوْبِ جَنَابَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 2109","","","كتاب الطهارة"
"2110","(۲۱۱۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الثَّوْبُ لاَ یُجْنِبُ۔","","Musannaf Ibn Abi Shaybah 2110","","","كتاب الطهارة"
"2111","(۲۱۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الثَّوْبُ لاَ یُجْنِبُ۔","Sahih","Musannaf Ibn Abi Shaybah 2111","","","كتاب الطهارة"
"2112","(۲۱۱۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَتَوَضَّأُ فَیَجِفُّ وضوئہ ، قَالَ : إِنْ کَانَ فِی عَمَلِ الْوُضُوئِ غَسَلَ رِجْلَیْہِ ، وَإِنْ کَانَ فِی غَیْرِ عَمَلِ الْوُضُوئِ اسْتَأْنَفَ الْوُضُوئَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2112","","","كتاب الطهارة"
"2113","(۲۱۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَأَلْتُ سُفْیَانَ عَنْ ذَلِکَ ؟ فَقَالَ : یَغْسِلُ قَدَمَیْہِ ، قُلْتُ : وَإِنْ جَفَّ وُضُوئُہُ ؟ قَالَ: وَإِنْ جَفَّ الْوُضُوئُ ، قَالَ : وَکَذَلِکَ نَقُولُ","No Data Available","Musannaf Ibn Abi Shaybah 2113","","","كتاب الطهارة"
"2114","(۲۱۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ (ح) وَعَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُمَا کَرِہَا أَنْ یَکْتُبَ الْجُنُبُ : بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2114","","","كتاب الطهارة"
"2115","(۲۱۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا لاَ یَرَوْنَ بَأْسًا أَنْ یَکْتُبَ الرَّجُلُ الرِّسَالَۃَ وَہُوَ عَلَی غَیْرِ وُضُوئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 2115","","","كتاب الطهارة"
"2116","(۲۱۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ أَبِی سِنَانٍ ضِرَارِ بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ الْعَنْزِیِّ ، قَالَ : کَانُوا یَذْکُرُونَ اللَّہَ عَلَی کُلِّ حَالٍ إِلاَّ الْجَنَابَۃِ۔","","Musannaf Ibn Abi Shaybah 2116","","","كتاب الطهارة"
"2117","(۲۱۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، وَعَامِرٍ ، وَعَطَائٍ ، قَالُوا : لَیْسَ فِی شَیْئٍ مِنَ الشَّرَابِ وُضُوئٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 2117","","","كتاب الطهارة"
"2118","(۲۱۱۸) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ عَبْدِ الْوَہَّابِ الثَّقَفِیِّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّہُ سَقَاہُمْ مَرَّۃً نَبِیذًا فَتَوَضَّؤوا۔","No Data Available","Musannaf Ibn Abi Shaybah 2118","","","كتاب الطهارة"
"2119","(۲۱۱۹) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی الأَقْطَعِ إِذَا قُطِعَتْ رِجْلُہُ مِنَ الْمِفْصَلِ فَأَرَادَ أَنْ یَتَوَضَّأَ : غَسَلَ الْقَطْعَ ، وَإِذَا قُطِعَتِ الْکَفُّ غَسَلَ إِلَی الْمِرْفَقِ۔","","Musannaf Ibn Abi Shaybah 2119","","","كتاب الطهارة"
"2120","(۲۱۲۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ زَیْدَ بْنَ ثَابِتٍ أَصَابَہُ سَلَسٌ مِنْ بَوْلٍ ، فَکَانَ یُصَلِّی وَہُوَ لاَ یَرْقَأُ۔","Da'if","Musannaf Ibn Abi Shaybah 2120","","","كتاب الطهارة"
"2121","(۲۱۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنْ مُحَمَّدٍ ، قَالَ : نُبِّئْتُ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَتْ تُرَجِّلُہُ الْحَائِضُ ، وَیَقُولُ : إِنَّ حَیْضَتَہَا لَیْسَتْ فِی یَدِہَا۔","","Musannaf Ibn Abi Shaybah 2121","","","كتاب الطهارة"
"2122","(۲۱۲۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَیَعْلَی بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : کُنْتُ أُرَجِّلُ رَأْسَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا حَائِضٌ ، وَہُوَ عَاکِفٌ۔ n(نسائی ۳۳۸۳۔ احمد ۶/۳۲)","Sahih","Musannaf Ibn Abi Shaybah 2122","","","كتاب الطهارة"
"2123","(۲۱۲۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : رُبَّمَا وَضَّأَتْہُ جَارِیَۃٌ مِنْ جَوَارِیہِ وَہِیَ حَائِضٌ تَغْسِلُ قَدَمَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2123","","","كتاب الطهارة"
"2124","(۲۱۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ جَارِیَۃً کَانَتْ تَغْسِلُ رِجْلَیْہِ وَہِیَ حَائِضٌ۔","Sahih","Musannaf Ibn Abi Shaybah 2124","","","كتاب الطهارة"
"2125","(۲۱۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُدْنِی رَأْسَہُ إِلَیَّ وَأَنَا حَائِضٌ ، وَہُوَ مُجَاوِرٌ ، تَعْنِی : مُعْتَکِفًا ، فَیَضَعُہُ فِی حِجْرِی ، فأَغْسِلُہُ وَأُرَجِّلُہُ وَأَنَا حَائِضٌ۔n(بخاری ۲۹۶۔ مسلم ۲۴۴)","Sahih","Musannaf Ibn Abi Shaybah 2125","","","كتاب الطهارة"
"2126","(۲۱۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ؛ أَنَّ أَبَا ظَبْیَانَ سَأَلَ إِبْرَاہِیمَ عَنِ الْحَائِضِ تُوَضِّیُٔ الْمَرِیضَ ؟ قَالَ: لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2126","","","كتاب الطهارة"
"2127","(۲۱۲۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ تَغْسِلَ الْحَائِضُ رَأْسَ الرَّجُلِ وَتُرَجِّلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2127","","","كتاب الطهارة"
"2128","(۲۱۲۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مَنْبُوذٍ ، عَنْ أُمِّہِ ، قَالَتْ : دَخَلَ ابْنُ عَبَّاسٍ عَلَی مَیْمُونَۃَ ، فَقَالَتْ : أَیْ بُنَیَّ ، مَا لِی أَرَاکَ شَعْثًا رَأْسُکَ ؟ قَالَ : إِنَّ أُمَّ عَمَّارٍ مُرَجِّلَتِی حَائِضٌ ، قَالَتْ : أَیْ بُنَیَّ ، وَأَیْنَ الْحَیْضَۃُ مِنَ الْیَدِ ؟ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَضَعُ رَأْسَہُ فِی حِجْرِ إِحْدَانَا وَہِیَ حَائِضٌ۔n(نسائی ۲۶۷۔ احمد ۶/۳۳۱)","No Data Available","Musannaf Ibn Abi Shaybah 2128","","","كتاب الطهارة"
"2129","(۲۱۲۹) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ الْمَوْصِلِیُّ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الْمَرِیضِ لاَ یَسْتَطِیعُ أَنْ یَتَوَضَّأَ ، قَالَ : یَتَیَمَّمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2129","","","كتاب الطهارة"
"2130","(۲۱۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَمُجَاہِدٍ ، قَالاَ فِی الْمَرِیضِ تُصِیبُہُ الْجَنَابَۃُ فَیَخَافُ عَلَی نَفْسِہِ ، قَالَ : ہُوَ بِمَنْزِلَۃِ الْمُسَافِرِ الَّذِی لاَ یَجِدُ الْمَائَ یَتَیَمَّمُ ۔ وَسَأَلْتُ عَطَائً ، فَقَالَ : لاَ بُدَّ مِنَ الْمَائِ وَیُسَخَّنُ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2130","","","كتاب الطهارة"
"2131","(۲۱۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا الأَعْمَشُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : حَدَّثَنَا أَصْحَابُ مُحَمَّد صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّ عَبْدَ اللہِ بْنَ زَیْدٍ الأَنْصَارِیَّ جَائَ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ , فَقَالَ : یَا رَسُولَ اللہِ ، رَأَیْتُ فِی الْمَنَامِ کَأَنَّ رَجُلاً قَامَ وَعَلَیْہِ بُرْدَانِ أَخْضَرَانِ عَلَی جِذْمَۃِ حَائِطٍ ، فَأَذَّنَ مَثْنَی ، وَأَقَامَ مَثْنَی ، وَقَعَدَ قَعْدَۃً ، قَالَ : فَسَمِعَ ذَلِکَ بِلاَلٌ ، فَقَامَ فَأَذَّنَ مَثْنَی ، وَأَقَامَ مَثْنَی ، وَقَعَدَ قَعْدَۃً۔ (ابوداؤد ۵۰۷۔ ابن خزیمۃ ۳۸۰)","No Data Available","Musannaf Ibn Abi Shaybah 2131","","","كتاب الأذان والإقامة"
"2132","(۲۱۳۲) حَدَّثَنَا عَفَّانُ ، قَالَ حَدَّثَنَا ہَمَّامُ بْنُ یَحْیَی ، عَنْ عَامِرٍ الأَحْوَلِ ، أَنَّ مَکْحُولاً حَدَّثَہُ ، أَنَّ عَبْدَ اللہِ بْنَ مُحَیْرِیزٍ حَدَّثَہُ ، أَنَّ أَبَا مَحْذُورَۃَ حَدَّثَہُ ، قَالَ عَلَّمَنِی النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ الأَذَانَ تِسْعَ عَشْرَۃَ کَلِمَۃً وَالإِقَامَۃَ سَبْعَ عَشْرَۃَ کَلِمَۃً ، الأَذَانُ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، حَیَّ عَلَی الصَّلاَۃِ ، حَیَّ عَلَی الصَّلاَۃِ ، حَیَّ عَلَی الْفَلاَحِ ، حَیَّ عَلَی الْفَلاَحِ ، اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إلَہَ إِلاَّ اللَّہُ۔n وَالإِقَامَۃُ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ اللَّہُ أَکْبَرُ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنْ لاَ إلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، حَیَّ عَلَی الصَّلاَۃِ ، حَیَّ عَلَی الصَّلاَۃِ ، حَیَّ عَلَی الْفَلاَحِ ، حَیَّ عَلَی الْفَلاَحِ ، قَدْ قَامَتِ الصَّلاَۃُ ، قَدْ قَامَتِ الصَّلاَۃُ ، اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إلَہَ إِلاَّ اللَّہُ۔ (ابوداؤ۹ ۵۰۳۔ ترمذی ۱۹۲)","Hasan","Musannaf Ibn Abi Shaybah 2132","","","كتاب الأذان والإقامة"
"2133","(۲۱۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ أَذَانُ ابْنِ عُمَرَ ، اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ، اللَّہُ أَکْبَرُ ، شَہِدْتُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ ، شَہِدْتُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ ، شَہِدْتُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ ، ثَلاَثًا ، شَہِدْتُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ، شَہِدْتُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، شَہِدْتُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، ثَلاَثًا ، حَیَّ عَلَی الصَّلاۃِ، ثَلاَثًا ، حَیَّ عَلَی الْفَلاَحِ ، ثَلاَثًا ، اللَّہُ أَکْبَرُ ، أَحْسِبُہُ قَالَ : لاَ إِلَہَ إِلاَّ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2133","","","كتاب الأذان والإقامة"
"2134","(۲۱۳۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ الأَذَانُ أَنْ یَقُولَ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، أَشْہَدُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، حَیَّ عَلَی الصَّلاَۃِ ، حَیَّ عَلَی الصَّلاَۃِ ، حَیَّ عَلَی الْفَلاَحِ ، حَیَّ عَلَ?? الْفَلاَحِ ، اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2134","","","كتاب الأذان والإقامة"
"2135","(۲۱۳۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ : کَانَ الْحَسَنُ ، یَقُولُ : اللَّہُ أَکْبَرُ ، أَشْہَدُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، حَیَّ عَلَی الصَّلاَۃِ ، حَیَّ عَلَی الْفَلاَحِ ، ثُمَّ یَرْجِعُ فَیَقُولُ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، أَشْہَدُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، حَیَّ عَلَی الصَّلاَۃِ ، حَیَّ عَلَی الْفَلاَحِ ، مَرَّتَیْنِ ، اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 2135","","","كتاب الأذان والإقامة"
"2136","(۲۱۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخبرنَا سُلَیْمَانُ التَّیْمِیُّ ، عَنْ حَبِیبِ بْنِ قَیْسٍ ، عَنِ ابْنِ أَبِی مَحْذُورَۃَ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَخْفِضُ صَوْتَہُ بِالأَذَانِ مَرَّۃً مَرَّۃً ، حَتَّی إِذَا انْتَہَی إِلَی قَوْلِہِ : أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ، أَشْہَدُ أَنَّ مُحَمَّدًا رَسُولُ اللہِ ، رَجَعَ إِلَی قَوْلِہِ : أَشْہَدُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ ، فَرَفَعَ بِہَا صَوْتَہُ مَرَّتَیْنِ مَرَّتَیْنِ ، حَتَّی إِذَا انْتَہَی إِلَی : حَیَّ عَلَی الصَّلاَۃِ ، قَالَ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ ، فِی الأَذَانِ الأَوَّلِ مِنَ الْفَجْرِ۔n(ابوداؤد ۵۰۲۔ احمد ۳/۴۰۹)","Sahih","Musannaf Ibn Abi Shaybah 2136","","","كتاب الأذان والإقامة"
"2137","(۲۱۳۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : حَدَّثَنَا أَصْحَابُنَا ؛ أَنَّ رَجُلاً مِنَ الأَنْصَارِ جَائَ فَقَالَ : یَا رَسُولَ اللہِ ، إِنِّی لَمَّا رَجَعْتُ الْبَارِحَۃَ وَرَأَیْتُ مِنِ اہْتِمَامِکَ ، رَأَیْتُ کَأَنَّ رَجُلاً قَائِمًا عَلَی الْمَسْجِدِ عَلَیْہِ ثَوْبَانِ أَخْضَرَانِ فَأَذَّنَ ، ثُمَّ قَعَدَ قَعْدَۃً ، ثُمَّ قَامَ فَقَالَ مِثْلَہَا ، غَیْرَ أَنَّہُ قَالَ : قَدْ قَامَتِ الصَّلاَۃُ ، وَلَوْلاَ أَنْ تَقُولُوا لَقُلْتُ : إِنِّی کُنْتُ یَقْظَانًا غَیْرَ نَائِمٍ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَقَدْ أَرَاکَ اللَّہُ خَیْرًا ، فَقَالَ عُمَرُ : أَمَا إِنِّی قَدْ رَأَیْتُ مِثْلَ الَّذِی رَأَی ، غَیْرَ أَنِّی لَمَّا سُبِقْتُ اسْتَحْیَیْتُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مُرُوا بِلاَلاً فَلْیُؤَذِّنْ۔ (ابوداؤد ۵۰۷)","Sahih","Musannaf Ibn Abi Shaybah 2137","","","كتاب الأذان والإقامة"
"2138","(۲۱۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِنَحْوٍ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 2138","","","كتاب الأذان والإقامة"
"2139","(۲۱۳۹) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ أَبِی مَحْذُورَۃَ ؛ أَنَّ أَذَانَہُ کَانَ مَثْنَی ، وَأَنَّ إِقَامَتَہُ کَانَتْ وَاحِدَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 2139","","","كتاب الأذان والإقامة"
"2140","(۲۱۴۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الْمُثَنَّی ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ بِلاَلٌ یَشْفَعُ الأَذَانَ ، وَیُوتِرُ الإِقَامَۃَ۔ (ابوداؤد ۵۱۱۔ نسائی ۱۵۹۳)","","Musannaf Ibn Abi Shaybah 2140","","","كتاب الأذان والإقامة"
"2141","(۲۱۴۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : أَظُنُّہُ عَنْ أَنَسٍ ، قَالَ : أُمِرَ بِلاَلٌ أَنْ یَشْفَعَ الأَذَانَ ، وَیُوتِرَ الإِقَامَۃَ۔ (مسلم ۲۸۶۔ احمد ۳/۱۰۳)","Sahih","Musannaf Ibn Abi Shaybah 2141","","","كتاب الأذان والإقامة"
"2142","(۲۱۴۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَنَسٍ ، قَالَ : أُمِرَ بِلاَلٌ أَنْ یَشْفَعَ الأَذَانَ ، وَیُوتِرَ الإِقَامَۃَ۔ (بخاری ۶۰۷۔ مسلم ۲۸۶)","Sahih","Musannaf Ibn Abi Shaybah 2142","","","كتاب الأذان والإقامة"
"2143","(۲۱۴۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ أَبَاہُ کَانَ یَشْفَعُ الأَذَانَ ، وَیُوتِرُ الإِقَامَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 2143","","","كتاب الأذان والإقامة"
"2144","(۲۱۴۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : الأَذَانُ مَثْنَی ، وَالإِقَامَۃُ وَاحِدَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 2144","","","كتاب الأذان والإقامة"
"2145","(۲۱۴۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، قَالَ : حدَّثَنِی رَجُلٌ فِی مَسْجِدِ الْکُوفَۃِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الإِقَامَۃُ وَاحِدَۃٌ ، قَالَ : کَذَلِکَ أَذَانُ بِلاَلٍ۔","Majhul","Musannaf Ibn Abi Shaybah 2145","","","كتاب الأذان والإقامة"
"2146","(۲۱۴۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : الإِقَامَۃُ مَرَّۃً مَرَّۃً ، فَإِذَا قَالَ : قَدْ قَامَتِ الصَّلاَۃُ ، قَالَ : مَرَّتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2146","","","كتاب الأذان والإقامة"
"2147","(۲۱۴۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ مَکْحُولٍ ، قَالَ : أَقَمْتُ مَعَہُ بِدَابِقٍ ، فَلَمْ یَکُنْ یَزِیدُ عَلَی إِقَامَۃٍ ، وَلاَ یُؤَذِّنُ ، وَیَجْعَلُہَا وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 2147","","","كتاب الأذان والإقامة"
"2148","(۲۱۴۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ إِسْمَاعِیلَ ، عَنْ أَبِی الْمُثَنَّی ؛ أَنَّ ابْنَ عُمَرَ کَانَ یَأْمُرُ الْمُؤَذِّنَ أَنْ یَشْفَعَ الأَذَانَ ، وَیُوتِرَ الإِقَامَۃَ ، لِیَعْلَمَ الْمَارُّ الأَذَانَ مِنَ الإِقَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 2148","","","كتاب الأذان والإقامة"
"2149","(۲۱۴۹) حَدَّثَنَا ہُشَیْمٌ ، عَنِ عَبْدِ الرَّحْمَنِ بْنِ یَحْیَی ، عَنِ الہَجَنَّع بْنِ قَیْسٍ؛ أَنَّ عَلِیًّا کَانَ یَقُولُ: الأَذَانُ مَثْنَی وَالإِقَامَۃُ ، وَأَتَی عَلَی مُؤَذِّنٍ یُقِیمُ مَرَّۃً مَرَّۃً ، فَقَالَ : أَلاَ جَعَلْتَہَا مَثْنَی ؟ لاَ أُمَّ لِلْآخَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 2149","","","كتاب الأذان والإقامة"
"2150","(۲۱۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ ، عَنْ عُبَیْدٍ مَوْلَی سَلَمَۃَ بْنِ الأَکْوَعِ ؛ أَنَّ سَلَمَۃَ بْنَ الأَکْوَعِ کَانَ یُثَنِّی الإِقَامَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 2150","","","كتاب الأذان والإقامة"
"2151","(۲۱۵۱) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ زَیْدٍ الأَنْصَارِیُّ مُؤَذِّنُ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَشْفَعُ الأَذَانَ وَالإِقَامَۃَ۔n(ترمذی ۱۹۴۔ دار قطنی ۲۴۱)","Da'if","Musannaf Ibn Abi Shaybah 2151","","","كتاب الأذان والإقامة"
"2152","(۲۱۵۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ شُعَیْبٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : إِذَا جَعَلْتَہَا إِقَامَۃً فَأَثْنِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 2152","","","كتاب الأذان والإقامة"
"2153","(۲۱۵۳) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ تَدَعُ أَنْ تُثَنِّیَ الإِقَامَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2153","","","كتاب الأذان والإقامة"
"2154","(۲۱۵۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، قَالَ : حَدَّثَنَا الْحَجَّاجُ بْنُ أَرْطَاۃَ ، قَالَ : حَدَّثَنَا أَبُو إِسْحَاقَ ، قَالَ : کَانَ أَصْحَابُ عَلِیٍّ ، وَأَصْحَابُ عَبْدِ اللہِ یَشْفَعُونَ الأَذَانَ وَالإِقَامَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 2154","","","كتاب الأذان والإقامة"
"2155","(۲۱۵۵) حَدَّثَنَا أَبُو أُسَامَۃُ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِنَّ بِلاَلاً کَانَ یُثَنِّی الأَذَانَ وَالإِقَامَۃَ۔n(عبدالرزاق ۱۷۹۱۔ دار قطنی ۳۵)","","Musannaf Ibn Abi Shaybah 2155","","","كتاب الأذان والإقامة"
"2156","(۲۱۵۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ آخِرُ أَذَانِ بِلاَلٍ : لاَ إِلَہَ إِلاَّ اللَّہُ۔ (نسائی ۱۶۱۵۔ دار قطنی ۲۴۴)","Sahih","Musannaf Ibn Abi Shaybah 2156","","","كتاب الأذان والإقامة"
"2157","(۲۱۵۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، وَالشَّعْبِیِّ ، قَالاَ : کَانَ آخِرُ أَذَانِ بِلاَلٍ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 2157","","","كتاب الأذان والإقامة"
"2158","(۲۱۵۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی مَحْذُورَۃَ : أَنَّہُ أَذَّنَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، وَلأَبِی بَکْرٍ ، وَعُمَرَ ، وَکَانَ آخِرُ أَذَانِہِ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 2158","","","كتاب الأذان والإقامة"
"2159","(۲۱۵۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، قَالَ : حَدَّثَنِی قَائِدُ أَبِی مَحْذُورَۃَ ، بِمِثْلِہِ","Majhul","Musannaf Ibn Abi Shaybah 2159","","","كتاب الأذان والإقامة"
"2160","(۲۱۶۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ عَابِسٍ ، قَالَ : سَمِعْتُ أَبَا مَحْذُورَۃَ یَقُولُ فِی آخِرِ أَذَانِہِ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ ، إِلاَّ أَنَّ أَذَانَہُ کَانَ مَثْنَی ، وَأَنَّ إِقَامَتَہُ کَانَتْ وَاحِدَۃً ، وَخَاتِمَۃُ أَذَانِہِ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2160","","","كتاب الأذان والإقامة"
"2161","(۲۱۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ أَبِی مَحْذُورَۃَ ، بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 2161","","","كتاب الأذان والإقامة"
"2162","(۲۱۶۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَجْعَلُ آخِرَ أَذَانِہِ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2162","","","كتاب الأذان والإقامة"
"2163","(۲۱۶۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ عَابِسٍ ، قَالَ : سَمِعْتُ أَبَا مَحْذُورَۃَ ، یَقُولُ فِی آخِرِ أَذَانِہِ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 2163","","","كتاب الأذان والإقامة"
"2164","(۲۱۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ : سَمِعْتُ إِبْرَاہِیمَ ، یَقُولُ : آخِرَ الأَذَانِ اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 2164","","","كتاب الأذان والإقامة"
"2165","(۲۱۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیْدَ ، عَنْ أَبِی صَادِقٍ ؛ أَنَّہُ کَانَ یَجْعَلُ آخِرَ أَذَانِہِ : لاَ إِلَہَ إِلاَّ اللَّہُ ، وَاللَّہُ أَکْبَرُ ، وَقَالَ : ہَکَذَا کَانَ آخِرَ أَذَانِ بِلاَلٍ۔","","Musannaf Ibn Abi Shaybah 2165","","","كتاب الأذان والإقامة"
"2166","(۲۱۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ عَنْ أَبِی مَحْذُورَۃَ ، قَالَ : کَانَ آخِرُ الأَذَانِ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔ (نسائی ۱۶۱۶)","Sahih","Musannaf Ibn Abi Shaybah 2166","","","كتاب الأذان والإقامة"
"2167","(۲۱۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ بِلاَلٍ ، قَالَ : کَانَ آخِرُ الأَذَانِ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔ (نسائی ۱۶۱۴)","Sahih","Musannaf Ibn Abi Shaybah 2167","","","كتاب الأذان والإقامة"
"2168","(۲۱۶۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، قَالَ : کَانَ آخِرُ أَذَانِ أَبِی مَحْذُورَۃَ ، وَکَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلَ لَہُ أَذَانَ مَکَّۃَ ، وَکَانَ آخِرُ أَذَانِہِ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ، لاَ إِلَہَ إِلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 2168","","","كتاب الأذان والإقامة"
"2169","(۲۱۶۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی سَہْلٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ آخِرُ أَذَانِ بِلاَلٍ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 2169","","","كتاب الأذان والإقامة"
"2170","(۲۱۷۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی مَحْذُورَۃَ (ح) وَعَنْ طَلْحَۃَ ، عَنْ سُوَیْدٍ ، عَنْ بِلاَلٍ ؛ أَنَّہُ کَانَ آخِرُ تَثْوِیبِہِمَا : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ۔ (ابوداؤد ۵۰۵۔ ابن خزیمۃ)","","Musannaf Ibn Abi Shaybah 2170","","","كتاب الأذان والإقامة"
"2171","(۲۱۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْدِ بْنِ غَفَلَۃَ ؛ أَنَّہُ أَرْسَلَ إِلَی مُؤَذِّنِہِ : إِذَا بَلَغْتَ حَیَّ عَلَی الْفَلاَحِ ، فَقُلِ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ ، فَإِنَّہُ أَذَانُ بِلاَلٍ۔","Sahih","Musannaf Ibn Abi Shaybah 2171","","","كتاب الأذان والإقامة"
"2172","(۲۱۷۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ رَجُلٍ یُقَالُ لَہُ : إِسْمَاعِیلُ ، قَالَ : جَائَ الْمُؤَذِّنُ یُؤْذِن عُمَرَ بِصَلاَۃِ الصُّبْحِ ، فَقَالَ: الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ ، فَأُعْجِبَ بِہِ عُمَرُ ، وَقَالَ لِلْمُؤَذِّنِ : أَقِرَّہَا فِی أَذَانِکَ۔","Majhul","Musannaf Ibn Abi Shaybah 2172","","","كتاب الأذان والإقامة"
"2173","(۲۱۷۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقُولُ فِی أَذَانِہِ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 2173","","","كتاب الأذان والإقامة"
"2174","(۲۱۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : قَالَ : لَیْسَ مِنَ السُّنَّۃِ أَنْ یَقُولَ فِی صَلاَۃِ الْفَجْرِ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ۔ (ابن خزیمۃ ۳۸۶۔ دار قطنی ۳۸)","Sahih","Musannaf Ibn Abi Shaybah 2174","","","كتاب الأذان والإقامة"
"2175","(۲۱۷۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیِّبِ ، قَالَ : جَائَ بِلاَلٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُؤْذِنُہُ بِالصَّلاَۃِ ، فَقِیلَ لَہُ : إِنَّہُ نَائِمٌ ، فَصَرَخَ بِلاَلٌ بِأَعْلَی صَوْتِہِ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ ، فَأُدْخِلَتْ فِی الأَذَانِ۔ (ابن ماجہ ۷۱۶)","","Musannaf Ibn Abi Shaybah 2175","","","كتاب الأذان والإقامة"
"2176","(۲۱۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ أَبَاہُ کَانَ یَقُولُ فِی أَذَانِہِ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ ، الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ ، اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، لاَ إِلَہَ إِلاَّ اللَّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2176","","","كتاب الأذان والإقامة"
"2177","(۲۱۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الْقَاسِمِ بْنِ أَبِی مُخَیْمِرَۃَ ، أَنَّہُ کَانَ یَقُولُ فِی أَذَانِہِ فِی التَّثْوِیبِ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ ، الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ۔","","Musannaf Ibn Abi Shaybah 2177","","","كتاب الأذان والإقامة"
"2178","(۲۱۷۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ، قَالَ : کَانَ التَّثْوِیبُ عِنْدَہُمَا أَنْ یَقُولَ : حَیَّ عَلَی الصَّلاَۃِ ، الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ۔","","Musannaf Ibn Abi Shaybah 2178","","","كتاب الأذان والإقامة"
"2179","(۲۱۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، عَنْ عِمْرَانَ بْنِ أَبِی الْجَعْدِ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ؛ أَنَّہُ سَمِعَ مُؤَذِّنًا یَقُولُ فِی الْفَجْرِ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ ، فَقَالَ : لاَ تَزِیدنَّ فِی الأَذَانِ مَا لَیْسَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 2179","","","كتاب الأذان والإقامة"
"2180","(۲۱۸۰) حَدَّثَنَا أَبُوخَالِدٍ الأَحْمَرُ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی مَحْذُورَۃَ ؛ أَنَّہُ أَذَّنَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلأَبِی بَکْرٍ ، وَعُمَرَ ، فَکَانَ یَقُولُ فِی أَذَانِہِ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ۔","","Musannaf Ibn Abi Shaybah 2180","","","كتاب الأذان والإقامة"
"2181","(۲۱۸۱) حَدَّثَنَا یَحْیَی بْنُ أَبِی بَکْرٍ ، قَالَ : حَدَّثَنَا یَعلی بْنُ الْحَارِثِ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، قَالَ : سَمِعْتُ مُؤَذِّنَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، یَقُولُ : الصَّلاَۃُ خَیْرٌ مِنَ النَّوْمِ۔","","Musannaf Ibn Abi Shaybah 2181","","","كتاب الأذان والإقامة"
"2182","(۲۱۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زُبَیْدٍ ، عَنْ خَیْثَمَۃَ ، قَالَ : کَانُوا یُثَوِّبُونَ فِی الْعِشَائِ وَالْفَجْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2182","","","كتاب الأذان والإقامة"
"2183","(۲۱۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ الأَصْبَہَانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : مَا ابْتَدَعُوا بِدْعَۃً أَحَبَّ إِلَیَّ مِنَ التَّثْوِیبِ فِی الصَّلاَۃِ ، یَعْنِی : الْعِشَائَ وَالْفَجْرَ","","Musannaf Ibn Abi Shaybah 2183","","","كتاب الأذان والإقامة"
"2184","(۲۱۸۴) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی مَحْذُورَۃَ (ح) وَعَنْ طَلْحَۃَ ، عَنْ سُوَیْدٍ ، عَنْ بِلاَلٍ ؛ أَنَّہُمَا کَانَا لاَ یُثَوِّبَانِ إِلاَّ فِی الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 2184","","","كتاب الأذان والإقامة"
"2185","(۲۱۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْدِ بْنِ غَفَلَۃَ ؛ أَنَّہُ أَرْسَلَ إِلَی مُؤَذِّنٍ لَہُ یُقَالُ لَہُ رَبَاحٌ : أَنْ لاَ یُثَوِّبَ إِلاَّ فِی الْفَجْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2185","","","كتاب الأذان والإقامة"
"2186","(۲۱۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُثَوِّبُونَ فِی الْعِشَائِ وَالْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 2186","","","كتاب الأذان والإقامة"
"2187","(۲۱۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُثَوَّبُ فِی الْعِشَائِ وَالْفَجْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2187","","","كتاب الأذان والإقامة"
"2188","(۲۱۸۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُثَوِّبُونَ فِی الْعَتَمَۃِ وَالْفَجْرِ ، وَکَانَ مُؤَذِّنُ إِبْرَاہِیمَ یُثَوِّبُ فِی الظُّہْرِ وَالْعَصْرِ ، فَلاَ یَنْہَاہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 2188","","","كتاب الأذان والإقامة"
"2189","(۲۱۸۹) حَدَّثَنَا عَبَّادُ بْنُ العَوَّامٍ ، عَنْ حَجَّاجٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ بِلاَلاً رَکَزَ الْعَنَزَۃَ وَأَذَّنَ ، فَرَأَیْتُہُ یَدُورُ فِی أَذَانِہِ۔ (ترمذی ۱۹۷۔ احمد ۴/۳۰۸)","","Musannaf Ibn Abi Shaybah 2189","","","كتاب الأذان والإقامة"
"2190","(۲۱۹۰) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : إذَا أَذَّنَ الْمُؤَذِّنُ اسْتَقْبَلَ الْقِبْلَۃَ ، وَکَانَ یَکْرَہُ أَنْ یَسْتَدِیرَ فِی الْمَنَارَۃِn وَکَانَ الْحَسَنُ یَقُولُ : یَسْتَقْبِلُ الْقِبْلَۃَ ، فَإذَا قَالَ : حَیَّ عَلَی الصَّلاَۃِ دَارَ ، فَإِذَا أَرَادَ أَنْ یَقُولَ : اللَّہُ أَکْبَرُ ، اسْتَقْبَلَ الْقِبْلَۃَ۔","","Musannaf Ibn Abi Shaybah 2190","","","كتاب الأذان والإقامة"
"2191","(۲۱۹۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ (ح) وَعَنْ أَبِیہِ ، عَنِ الْمُغِیرَۃِ ، عَنْ إِبْرَاہِیمَ ، قَالاَ : الْمُؤَذِّنُ لاَ یُزِیلُ قَدَمَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 2191","","","كتاب الأذان والإقامة"
"2192","(۲۱۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالأَبْطَحِ ، فَخَرَجَ بِلاَلٌ فَأَذَّنَ ، قَالَ : فَکَأَنِّی أَنْظُرُ إِلَیْہِ یتبع فَاہُ ہَاہُنَا وَہَاہُنَا ، یَعْنِی : یَمِینًا وَشِمَالاً۔n(بخاری ۶۳۴۔ مسلم ۳۶۰)","Sahih","Musannaf Ibn Abi Shaybah 2192","","","كتاب الأذان والإقامة"
"2193","(۲۱۹۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ طَلْحَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یَسْتَقْبِلُ الْمُؤَذِّنُ بِالأَذَانِ وَالشَّہَادَۃِ وَالإِقَامَۃِ الْقِبْلَۃَ۔","","Musannaf Ibn Abi Shaybah 2193","","","كتاب الأذان والإقامة"
"2194","(۲۱۹۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حُلاَّمِ بْنِ صَالِحٍ ، عَنْ فَائِدِ بْنِ بُکَیْرٍ ، قَالَ : خَرَجْتُ مَعَ حُذَیْفَۃَ إِلَی الْمَسْجِدِ صَلاَۃَ الْفَجْرِ ، وَابْنُ التَّیَّاحِ مُؤَذِّنُ الْوَلِیدِ بْنِ عُقْبَۃَ یُؤَذِّنُ ، وَہُوَ یَقُولُ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، أَشْہَدُ أَنْ لاَ إِلَہَ إِلاَّ اللَّہُ ، یَہْوِی بِأَذَانِہِ یَمِینًا وَشِمَالاً ، فَقَالَ حُذَیْفَۃُ : مَنْ یُرِدِ اللَّہُ أَنْ یَجْعَلَ رِزْقَہُ فِی صَوْتِہِ : فَعَلَ۔","Majhul","Musannaf Ibn Abi Shaybah 2194","","","كتاب الأذان والإقامة"
"2195","(۲۱۹۵) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ قَالَ فِی الْمُؤَذِّنِ : یَضمُّ رِجْلَیْہِ ، وَیَسْتَقْبِلُ الْقِبْلَۃَ، فَإِذَا قَالَ : قَدْ قَامَتِ الصَّلاَۃُ ، قَالَ بِوَجْہِہِ عَنْ یَمِینِہِ وَشِمَالِہِ۔","","Musannaf Ibn Abi Shaybah 2195","","","كتاب الأذان والإقامة"
"2196","(۲۱۹۶) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ الحَجَّاجٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ بِلاَلاً ، رَکَزَ الْعَنَزَۃَ ، ثُمَّ أَذَّنَ ، وَوَضَعَ إِصْبَعَیْہِ فِی أُذُنَیْہِ۔","","Musannaf Ibn Abi Shaybah 2196","","","كتاب الأذان والإقامة"
"2197","(۲۱۹۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : إِذَا أَذَّنَ الْمُؤَذِّنُ اسْتَقْبَلَ الْقِبْلَۃَ ، وَوَضَعَ إِصْبَعَیْہِ فِی أُذُنَیْہِ۔","","Musannaf Ibn Abi Shaybah 2197","","","كتاب الأذان والإقامة"
"2198","(۲۱۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ نُسَیْرٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یُؤَذِّنُ عَلَی بَعِیرہ ، قَالَ سُفْیَانُ : قُلْتُ لَہُ: رَأَیْتُہُ یَجْعَلُ إِصْبَعَیْہِ فِی أُذُنَیْہِ ؟ قَالَ : لاَ۔","Sahih","Musannaf Ibn Abi Shaybah 2198","","","كتاب الأذان والإقامة"
"2199","(۲۱۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ الأَذَانُ أَنْ یَقُولَ : اللَّہُ أَکْبَرُ ، اللَّہُ أَکْبَرُ ، ثُمَّ یَجْعَلُ إصْبَعَیْہِ فِی أُذُنَیْہِ ، وَأَوَّلُ مَنْ تَرَکَ إحْدَی إصْبَعَیْہِ فِی أُذُنَیْہِ ابْنُ الأَصَمِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 2199","","","كتاب الأذان والإقامة"
