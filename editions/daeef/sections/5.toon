hadiths[493]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1009","السلام تحية لملتنا و أمان لذمتنا","","Majmu'a Da'eef Ahadith 1009","","","Salam is our community’s gift"
"1010","المغتاب والمستمع شريكان فى الاثم","","Majmu'a Da'eef Ahadith 1010","","","Backbiting and listening are equal"
"1011","كفارة من اغتبته ان تستغفرله","","Majmu'a Da'eef Ahadith 1011","","","Expiation for backbiting"
"1012","ليس مني ذو حسد ولا نميمة","","Majmu'a Da'eef Ahadith 1012","","","Prophet disowned envier and slanderer"
"1013","الغضب من الشيطان وان الشيطان خلق من النار و انما تطفا النار بالما ٔ فاذا غضب احدكم فليتوضا","","Majmu'a Da'eef Ahadith 1013","","","Anger is from Satan"
"1014","","","Majmu'a Da'eef Ahadith 1014","","","Anger is a burning coal"
"1015","","","Majmu'a Da'eef Ahadith 1015","","","Believer is quick to anger and quick to please"
"1016","","","Majmu'a Da'eef Ahadith 1016","","","Best are those who quickly return from anger"
"1017","","","Majmu'a Da'eef Ahadith 1017","","","Great betrayal"
"1018","","","Majmu'a Da'eef Ahadith 1018","","","Lying removes faith"
"1019","","","Majmu'a Da'eef Ahadith 1019","","","Prohibition of drinking all water at once"
"1020","","","Majmu'a Da'eef Ahadith 1020","","","Respect for father"
"1021","","","Majmu'a Da'eef Ahadith 1021","","","Punishment for disobeying parents in this world"
"1022","","","Majmu'a Da'eef Ahadith 1022","","","Benefit of maintaining family ties"
"1023","","","Majmu'a Da'eef Ahadith 1023","","","Benefit of maintaining family ties"
"1024","","","Majmu'a Da'eef Ahadith 1024","","","Benefit of maintaining family ties"
"1025","","","Majmu'a Da'eef Ahadith 1025","","","Pray for brother after Friday"
"1026","","","Majmu'a Da'eef Ahadith 1026","","","Gift removes mutual hatred"
"1027","","","Majmu'a Da'eef Ahadith 1027","","","Gift removes heart diseases"
"1028","تصافحوا يذهب الغل عن قلوبكم","","Majmu'a Da'eef Ahadith 1028","","","Benefit of shaking hands"
"1029","اذا التقى المسلمان فتصافحا و حمدا الله و استغفرا غفرلهما","","Majmu'a Da'eef Ahadith 1029","","","Benefit of shaking hands"
"1030","اذا صافح المؤمن المؤمن نزلت عليهما مائة رحمة . . .","","Majmu'a Da'eef Ahadith 1030","","","Benefit of shaking hands"
"1031","لا تمار اخاك ولا تمازحه ولا تعده موعدا فتخلفه","","Majmu'a Da'eef Ahadith 1031","","","Prohibition of arguing and joking with Muslims"
"1032","خصلتان لا يجتمعان فى مؤمن : البخل و سوء الخلق","","Majmu'a Da'eef Ahadith 1032","","","Two traits do not combine in a believer"
"1033","لا يدخل الجنة خب ولا بخيل ولا سىء الملكة","","Majmu'a Da'eef Ahadith 1033","","","Miser and ill-tempered will not enter Paradise"
"1034","الشوم سوء الخلق","","Majmu'a Da'eef Ahadith 1034","","","Bad character causes misfortune"
"1035","اللهم كما حسنت خلقي فحسن خلقي","","Majmu'a Da'eef Ahadith 1035","","","Supplication when looking in mirror"
"1036","ما أكرم شاب شيخا لسنه الا قيض الله من يكرمه عند سنه","","Majmu'a Da'eef Ahadith 1036","","","Benefit of honoring the elderly"
"1037","كان جالسا يوما فأقبل أبوه من الرضاعة فوضع له بعض ثوبه فقعد عليه ثم اقبلت امه فوضع لها شق ثوبه من جانب الاخر فجلست عليه . . .","","Majmu'a Da'eef Ahadith 1037","","","Prophet honored his foster parents"
"1038","لا يأبى الكرامة الا حمار","","Majmu'a Da'eef Ahadith 1038","","","Only a donkey rejects honor and respect"
"1039","لو كان الحياء رجلا لكان رجلا صالحا ولو كان الفحش رجلا لكان رجلا","","Majmu'a Da'eef Ahadith 1039","","","If modesty and shamelessness were people"
"1040","ملعون على لسان محمد صلی اللہ علیہ وسلم من جلس وسط الحلقة","","Majmu'a Da'eef Ahadith 1040","","","Cursed is one who sits in people’s circle"
"1041","جمال الرجل فصاحة لسانه","","Majmu'a Da'eef Ahadith 1041","","","A man's beauty is his eloquence"
"1042","لا تحدثو امتي من أحاديثي الا ما تحمله عقولهم","","Majmu'a Da'eef Ahadith 1042","","","Narrate only what people can understand"
"1043","كان صلى الله عليه وسلم لا يحدث بحديث الا تبسم","","Majmu'a Da'eef Ahadith 1043","","","Always smile when narrating hadith"
"1044","لست من دد ولا الدد مني","","Majmu'a Da'eef Ahadith 1044","","","No relation with play and amusement"
"1045","لا تروعوا المسلم فان روعة المسلم ظلم عظيم","","Majmu'a Da'eef Ahadith 1045","","","Prohibition of frightening a Muslim brother"
"1046","احب الاعمال الي الله بعد الفرأئض ادخال السرور على المسلم","","Majmu'a Da'eef Ahadith 1046","","","Virtue of bringing happiness to a Muslim"
"1047","من أدخل على اهل بيت من المسلمين سرورا لم يرض الله له ثوابا دون الجنة","","Majmu'a Da'eef Ahadith 1047","","","Virtue of bringing happiness to a Muslim"
"1048","انه لم يتثاؤب قط","","Majmu'a Da'eef Ahadith 1048","","","The Prophet never yawned"
"1049","ان الله يكره رفع الصوت بالعطاس والتثاؤب","","Majmu'a Da'eef Ahadith 1049","","","Dislike of loud sounds when yawning or sneezing"
"1050","من عطس أو تجشأ أو سمع عطسة أو جشاء فقال : الحمد لله على كل حال من الأحوال ، صرف الله عنه سبعين داء أهوانها الجذام","","Majmu'a Da'eef Ahadith 1050","","","Virtue of saying Alhamdulillah when sneezing"
"1051","ما من مسلم يعطس عطسة فقال الحمد لله الا خلق الله من عطاسه ملكا يحمد الله عز و جل الي يوم القيامة","","Majmu'a Da'eef Ahadith 1051","","","Virtue of saying Alhamdulillah when sneezing"
"1052","اياكم والتعرى فان معكم من لا يفارقكم الا عند الله الغائط و حين يفضى الرجل الي أهله","","Majmu'a Da'eef Ahadith 1052","","","Avoid being naked"
"1053","كلام اهل الجنة بالعربية . . .","","Majmu'a Da'eef Ahadith 1053","","","People of Paradise will speak Arabic"
"1054","ثلاث لا ينجو منهن أحد ؛ الظن والطيرة والحسد","","Majmu'a Da'eef Ahadith 1054","","","Three things never succeed"
"1055","رد جواب الكتاب حق كرد السلام","","Majmu'a Da'eef Ahadith 1055","","","Replying to a letter is obligatory like replying to salam"
"1056","من نظر كتاب أخيه بغير اذنه فكانما ينظر فى النار","","Majmu'a Da'eef Ahadith 1056","","","Reading a brother's letter without permission is like looking at fire"
"1057","الدنيا جيفة وطلابها كلاب","","Majmu'a Da'eef Ahadith 1057","","","Seekers of the world are like dogs"
"1058","من كثر شيئه كثر شغله ومن كثر شغله شغله حرصه ومن اشتد حرصه كثر همه ومن كثر همه نسي ربه","","Majmu'a Da'eef Ahadith 1058","","","Abundance of things leads to neglect of Allah's remembrance"
"1059","ان أردت أن تلقى الله وهو عنك راض فلا تخبأ شيئا رزقته ولا تمنع شيئا سئلته","","Majmu'a Da'eef Ahadith 1059","","","Do not hide what Allah has given"
"1060","من أصبح وهمه الدنيا فليس من الله فى شىء","","Majmu'a Da'eef Ahadith 1060","","","Whoever wakes up concerned about the world"
"1061","لا خير فيمن لا يجمع المال . . . يصل به رحمہ ويؤدى به عن أمانته ويستغنى به عن خلق ربه","","Majmu'a Da'eef Ahadith 1061","","","Encouragement to gather wealth for kinship, etc."
"1062","لعن الله فقيرا تواضع لغني من أجل ماله","","Majmu'a Da'eef Ahadith 1062","","","Humbling oneself before others due to wealth"
"1063","من تواضع لغنى لأجل غناه ذهب ثلثا دينه","","Majmu'a Da'eef Ahadith 1063","","","Humbling oneself before others due to wealth"
"1064","لكل أمة مفتاح و مفتاح الجنة المساكين والفقراء ، هم جلساء الله يوم القيامة","","Majmu'a Da'eef Ahadith 1064","","","The key to Paradise is for the poor"
"1065","لا قونى بنياتكم ولا تلاقونى بأعمالكم","","Majmu'a Da'eef Ahadith 1065","","","Meeting with intentions"
"1066","لا تنظر الي صغر المعصية ولكن انظر الي عظمة من تعصيه","","Majmu'a Da'eef Ahadith 1066","","","Look at whom you are disobeying"
"1067","اتقوا مواضع التهم","","Majmu'a Da'eef Ahadith 1067","","","Avoid even places of suspicion"
"1068","اذا تواضع العبد رفعه الله الی السماء السابعة","","Majmu'a Da'eef Ahadith 1068","","","The humble servant is raised to the seventh heaven"
"1069","تمعددوا و اخشوشنوا و انتضلوا و امشوا حفاة","","Majmu'a Da'eef Ahadith 1069","","","Adopting a tough life"
"1070","الدعاء مخ العبادة","","Majmu'a Da'eef Ahadith 1070","","","Dua is the essence of worship"
"1071","لا تعجزوا فى الدعاء فانه لن يهلك مع الدعاء أحد","","Majmu'a Da'eef Ahadith 1071","","","Do not be lazy in making dua"
"1072","الدعاء سلاح المؤمن وعماد الدين ونور السماوات والأرض","","Majmu'a Da'eef Ahadith 1072","","","Dua is the weapon of the believer"
"1073","ولا يوم قوما فيخص نفسه بدعوة دونهم فان فعل فقد خانهم","","Majmu'a Da'eef Ahadith 1073","","","Imam cannot supplicate only for himself during prayer"
"1074","ليسأل أحدكم ربه حاجته كلها حتى يسأل تسع نعله اذا انقطع","","Majmu'a Da'eef Ahadith 1074","","","Ask even for a shoelace from your Lord"
"1075","كان رسول الله صلی اللہ علیہ وسلم اذا مد يديه فى الدعاء لم يردهما حتى يمسح بهما وجهه","","Majmu'a Da'eef Ahadith 1075","","","Wiping the face after dua"
"1076","سلوا الله ببطون أكفكم ولا تسألوه بظهورها فاذا فرغتم فامسحوا بها وجوهكم","","Majmu'a Da'eef Ahadith 1076","","","Wiping the face after dua"
"1077","ان الله يحب المحلين فى الدعاء","","Majmu'a Da'eef Ahadith 1077","","","Those who persist in dua are beloved to Allah"
"1078","لا اله الا الله وحده لا شريك له له الملك وله الحمد وهو على كل شىء قدير","","Majmu'a Da'eef Ahadith 1078","","","Dua upon waking up"
"1079","الحمد لله الذى خلق النوم واليقظة ، الحمد لله الذى بعثنى سالما سويا ، أشهد أن الله يحى الموتى وهو على كل شىء قدير","","Majmu'a Da'eef Ahadith 1079","","","Dua upon waking up"
"1080","","","Majmu'a Da'eef Ahadith 1080","","","Reciting Surah Hashr before sleep equals martyr's reward"
"1081","","","Majmu'a Da'eef Ahadith 1081","","","Morning and evening adhkar"
"1082","اللهم انى اصبحت اشهدك واشهد حملة عرشك و ملائكتك و جميع خلقك ، أنت الله لا اله الا انت وأن محمدا عبدك ورسولك","","Majmu'a Da'eef Ahadith 1082","","","Morning and evening adhkar"
"1083","فسبحان الله حين تمسون وحين تصبحون ، وله الحمد فى السموات والارض وعشيا وحين تظهرون ، يخرج الحي من الميت ويخرج الميت من الحي ويحي الارض بعد موتها وكذلك تخرجون","","Majmu'a Da'eef Ahadith 1083","","","Morning and evening adhkar"
"1084","سبحان الله وبحمده لا قوة الا بالله ما شاء الله كان وما لم يشأ لم يكن","","Majmu'a Da'eef Ahadith 1084","","","Morning and evening adhkar"
"1085","","","Majmu'a Da'eef Ahadith 1085","","","Morning and evening adhkar"
"1086","","","Majmu'a Da'eef Ahadith 1086","","","Morning and evening adhkar"
"1087","أصبحنا وأصبح الملك لله والحمد لله والكبرياء والعظمة لله والخلق والأمر واليل والنهار وما سكن فيهما لله ، اللهم اجعل أول هذا النهار صلاحا و أوسطه نجاحا واخره فلاحا ، يا أرحم الراحمين","","Majmu'a Da'eef Ahadith 1087","","","Morning and evening adhkar"
"1088","اللهم أسألك من فجأة الخير وأعوذبك من فجأة الشر","","Majmu'a Da'eef Ahadith 1088","","","Morning and evening adhkar"
"1089","باسم الله على نفسى وأهلي ومالي فانه لا يذهب لك شىء","","Majmu'a Da'eef Ahadith 1089","","","Morning and evening adhkar"
"1090","استغفر الله الذى لا اله الا هو الحى القيوم وأتوب اليه","","Majmu'a Da'eef Ahadith 1090","","","Morning and evening adhkar"
"1091","اللهم غارت النجوم وهدأت العيون وأنت حي قيوم لا تأخذك سنة ولا نوم يا حي يا قيوم أهدىء ليلى وانى عيني","","Majmu'a Da'eef Ahadith 1091","","","Dua for sleeplessness"
"1092","اللهم أني أعوذبك من الرجس النجس الخبيث المخبث : الشيطان الرجيم","","Majmu'a Da'eef Ahadith 1092","","","Dua when entering the toilet"
"1093","الحمد لله الذى اذهب عني الاذي وعافاني","","Majmu'a Da'eef Ahadith 1093","","","Dua when leaving the toilet"
"1094","الحمد لله الذى أذاقني لذته وأبقي فى قوته ودفع عني أذاه","","Majmu'a Da'eef Ahadith 1094","","","Dua when leaving the toilet"
"1095","أشهد أن لا اله الا الله وحده لا شريك له وأشهد أن محمدا عبده ورسوله","","Majmu'a Da'eef Ahadith 1095","","","Dua after wudu while looking at the sky"
"1096","اللهم اجعلنا من المفلحين","","Majmu'a Da'eef Ahadith 1096","","","Reply to ""Hayya 'ala al-falah"""
"1097","فض الله فاك","","Majmu'a Da'eef Ahadith 1097","","","Curse upon one who recites poetry in the mosque"
"1098","من قرأ اية الكرسي فى دبر الصلاة المكتوبة كان فى ذمة الله الي الصلاة الأخرى","","Majmu'a Da'eef Ahadith 1098","","","Whoever recites Ayat al-Kursi after prayer is under Allah's protection"
"1099","أشهد أن لا اله الا الله الرحمن الرحيم ، اللهم أذهب عنى الهم والحزن","","Majmu'a Da'eef Ahadith 1099","","","Wiping the forehead after prayer and making dua"
"1100","اللهم انى أسألك برحمتك التى وسعت كل شىء أن تغفرلي","","Majmu'a Da'eef Ahadith 1100","","","Dua at the time of iftar"
"1101","يا مالك يوم الدين اياك نعبد واياك أستعين","","Majmu'a Da'eef Ahadith 1101","","","Dua when meeting the enemy"
"1102","وعليك السلام ورحمة االله وبركاته ومغفرته ورضوانه","","Majmu'a Da'eef Ahadith 1102","","","Adding ""wa maghfiratuhu"" in salam"
"1103","اللهم أني أسألك خير المولج و خير المخرج بسم الله ولجنا وبسم الله خرجنا وعلي الله ربنا توكلنا","","Majmu'a Da'eef Ahadith 1103","","","Dua when entering the house"
"1104","اللهم اجعلها رحمة ولا تجعلها عذابا ، اللهم اجعلها رياحا ولا تجعلها ريحا","","Majmu'a Da'eef Ahadith 1104","","","Dua when strong winds blow"
"1105","اللهم لا تقتلنا بغضبك ولا تهلكنا بعذابك وعافنا قبل ذٰلك","","Majmu'a Da'eef Ahadith 1105","","","Dua when clouds thunder"
"1106","سبحان الله وبحمده","","Majmu'a Da'eef Ahadith 1106","","","Glorifications when distressed, looking at the sky"
"1107","حسبي الله ونعم الوكيل","","Majmu'a Da'eef Ahadith 1107","","","Dua when overwhelmed by a task"
"1108","الله اكبر","","Majmu'a Da'eef Ahadith 1108","","","Dua upon seeing fire"
"1109","اذا دخلت على مريض فمره أن يدعو لك فان دعاءه كدعاء الملائكة","","Majmu'a Da'eef Ahadith 1109","","","The prayer of the sick is the prayer of angels"
"1110","الحمد لله الذى كساني ما اواري به عورتي وأتجمل به فى حياتي","","Majmu'a Da'eef Ahadith 1110","","","Dua when wearing new clothes"
"1111","بسم الله مجريها و مرساها ان ربي لغفور رحيم ، وما قدروا الله حق قدره . . .","","Majmu'a Da'eef Ahadith 1111","","","Dua when boarding a boat"
"1112","اللهم اني أسألك علما نافعا ورزقا واسعا وشفاء من كل داء","","Majmu'a Da'eef Ahadith 1112","","","Dua when drinking Zamzam"
"1113","ألا أدلكم على دائكم و دوائكم ، ألا ان دائكم الذنوب و دوائكم الاستغفار","","Majmu'a Da'eef Ahadith 1113","","","Your illness and its cure"
"1114","من لزم الاستغفار جعل الله له من كل ضيق مخرجا ومن كل هم فرجا ورزقه من حيث لا يحتسب","","Majmu'a Da'eef Ahadith 1114","","","Istighfar makes every difficulty easy"
"1115","ما أصر من استغفر وان عاد فى اليوم سبعين مرة","","Majmu'a Da'eef Ahadith 1115","","","Benefit of seeking forgiveness after sin"
"1116","لا وضوء لمن لم يصل على النبى","","Majmu'a Da'eef Ahadith 1116","","","No wudu without sending salawat"
"1117","من صلى على يوم الجمعة ثمانين مرة غفر الله له ذنوب ثمانين عاما","","Majmu'a Da'eef Ahadith 1117","","","Virtue of sending salawat on Friday"
"1118","الصلاة على النبى صلی اللہ علیہ وسلم أفضل من عتق الرقاب","","Majmu'a Da'eef Ahadith 1118","","","Salawat is better than freeing a slave"
"1119","اذا صليتم على فعموا","","Majmu'a Da'eef Ahadith 1119","","","Include everyone in salawat"
"1120","زينوا مجالسكم بالصلاة على فان صلاتكم على نور لكم يوم القيامة","","Majmu'a Da'eef Ahadith 1120","","","Beautify gatherings with salawat"
"1121","الصلاة على النبى صلى الله عليه وسلم لا ترد","","Majmu'a Da'eef Ahadith 1121","","","Salawat is never rejected"
"1122","من صلى على فى كل يوم الجمعة أربعين مرة محا الله عزوجل عنه ذنوب أربعين سنة","","Majmu'a Da'eef Ahadith 1122","","","Virtue of sending salawat forty times on Friday"
"1123","اذا ذكر الخليل و ذكرت فصلوا عليه ثم صلوا على واذا ذكر الأنبياء فصلو على ثم عليهم","","Majmu'a Da'eef Ahadith 1123","","","Sending salawat on Khalilullah before me"
"1124","ان الله عزوجل بعثنى رحمة وهدى للعالمين وأمرنى أن أمحق المزامير والمعازف","","Majmu'a Da'eef Ahadith 1124","","","Command to destroy musical instruments"
"1125","الغناء ينبت النفاق فى القلب كما ينبت الماء البقل","","Majmu'a Da'eef Ahadith 1125","","","Music breeds hypocrisy"
"1126","من استمع قينة صب فى أذنيه الانك يوم القيامة","","Majmu'a Da'eef Ahadith 1126","","","Listener of music will be punished with molten lead on Judgment Day"
"1127","الغناء رقية الزنا","","Majmu'a Da'eef Ahadith 1127","","","Music is the incantation of adultery"
"1128","زامر الحي لا يطرب","","Majmu'a Da'eef Ahadith 1128","","","Flute player will never be happy"
"1129","من استمع الى صوت غناء لم يؤذن له أن يسمع الروحانيين فى الجنة","","Majmu'a Da'eef Ahadith 1129","","","Listener of music deprived of spiritual voices"
"1130","اللهم اركسهما فى الفتنة اللهم دعهما فى النار","","Majmu'a Da'eef Ahadith 1130","","","Prophet's curse on singers"
"1131","لعن الله الغناء والمغنى","","Majmu'a Da'eef Ahadith 1131","","","Curse on music and musicians"
"1132","العشق من غير ريبة كفارة للذنوب","","Majmu'a Da'eef Ahadith 1132","","","Love expiates sins"
"1133","رجل عشق امراة . . .","","Majmu'a Da'eef Ahadith 1133","","","A man fell in love with a woman"
"1134","لا تستشيروا أهل العشق فليس لهم رأي أما ان قلوبهم محترقة وعقولهم مسلوبة","","Majmu'a Da'eef Ahadith 1134","","","Prohibition of consulting lovers"
"1135","حبك الشىء يعمى ويصم","","Majmu'a Da'eef Ahadith 1135","","","Love makes one blind and deaf"
"1136","ما ضاق مجلس بمتحابين","","Majmu'a Da'eef Ahadith 1136","","","No constriction in gatherings of lovers"
"1137","ادفعوا الحدود ما وجدتم لها مدفعها","","Majmu'a Da'eef Ahadith 1137","","","Trying to move away the limits (hudud)"
"1138","ادرووا الحدود عن المسلمين ما استطعتم","","Majmu'a Da'eef Ahadith 1138","","","Trying to move away the limits (hudud)"
"1139","لا يغرم السارق اذا أقيم عليه الحد","","Majmu'a Da'eef Ahadith 1139","","","A thief punished with hadd is not liable for the stolen property"
"1140","لا تقتل المرأة اذا ارتدت","","Majmu'a Da'eef Ahadith 1140","","","Prohibition of killing an apostate woman"
"1141","الزناة تشتعل وجوههم نارا","","Majmu'a Da'eef Ahadith 1141","","","Faces of adulterers will be burned"
"1142","لا تزنوا فتذهب لذة نسائكم . . .","","Majmu'a Da'eef Ahadith 1142","","","Adultery removes pleasure from wives"
"1143","من زنا بيهودية أو نصرانية أحرقه الله فى قبره","","Majmu'a Da'eef Ahadith 1143","","","Consequence of adultery with a Jewish or Christian woman"
"1144","الزاني بحليلة جاره لا ينظر الله اليه يوم القيامة ولا يزكيه ويقول له : ادخل النار مع الداخلين","","Majmu'a Da'eef Ahadith 1144","","","Consequence of adultery with a neighbor"
"1145","من زنى زنى به ولو بحيطان داره","","Majmu'a Da'eef Ahadith 1145","","","Adultery against the house wall is still adultery"
"1146","اولاد الزنا يحشرون يوم القيامة فى صورة القردة والخنازير","","Majmu'a Da'eef Ahadith 1146","","","Children of adultery will be resurrected as apes and pigs"
"1147","ما أنفق عبد درهما فى زنا الا فقد ستمائة درهم","","Majmu'a Da'eef Ahadith 1147","","","Loss of spending money for adultery"
"1148","ان عمر أقام الحد على ولد له يكني أبا شحمة بعد موته . . .","","Majmu'a Da'eef Ahadith 1148","","","Umar punished his son with hadd even after his death"
"1149","اللوطى اذا مات ولم يتب مسخ فى قبره خنزيرا","","Majmu'a Da'eef Ahadith 1149","","","Consequence of sodomy"
"1150","من قبل غلاما لشهوة لعنه الله ، فان صافحه لشهوة لم يقبل من صلاته فان عانقه لشهوة ضرب بسياط من نار جهنم فان فسق به أدخله النار","","Majmu'a Da'eef Ahadith 1150","","","Kissing a child out of lust, etc."
"1151","لا امرؤ اقل حياء من امرئ مكن من دبره","","Majmu'a Da'eef Ahadith 1151","","","The greatest shamelessness is anal intercourse"
"1152","من نظر الي عورة أخيه المسلم متعمدا لم يقبل الله له صلاة أربعين يوما","","Majmu'a Da'eef Ahadith 1152","","","Harm of deliberately looking at a Muslim's private parts"
"1153","من ملأ عينه من الحرام ملأ الله عينه من جمر جهنم","","Majmu'a Da'eef Ahadith 1153","","","Harm of looking at the forbidden"
"1154","قدم وفد عبد القيس على رسول الله صلى الله عليه وسلم وفيهم غلام ظاهر الوضائة فأجلسه النبى صلى الله عليه وسلم وراء ظهره وقال كان خطيئة داود النظر","","Majmu'a Da'eef Ahadith 1154","","","David's sin of the gaze"
"1155","لا تجالسوا أولاد الأغنياء فان فتنتهم أشد من فتنة العذاري","","Majmu'a Da'eef Ahadith 1155","","","Do not sit with the rich people's children"
"1156","من لعب بالشطرنج فهو ملعون","","Majmu'a Da'eef Ahadith 1156","","","Chess player is accursed"
"1157","اللاعب بالشطرنج كالاكل من لحم الخنزير . . .","","Majmu'a Da'eef Ahadith 1157","","","Chess player is like one who eats pork"
"1158","صلاة الرجل متقلدا سيفه تفضل على صلاته غير متقلد سبعمائة ضعف","","Majmu'a Da'eef Ahadith 1158","","","Virtue of prayer for one who hangs a sword on his neck"
"1159","لا تزال الملائكة تصلى على الغازى ما دام حمائل سيفه فى عنقه","","Majmu'a Da'eef Ahadith 1159","","","Angels pray for the mujahid"
"1160","من اتخذ مغفرا ليجاهد فى سبيل الله غفر الله له . . .","","Majmu'a Da'eef Ahadith 1160","","","Forgiveness for one who arms himself for jihad"
"1161","من خاف على نفسه النار فليرابط على الساحل أربعين يوما","","Majmu'a Da'eef Ahadith 1161","","","Guarding for forty days averts Hellfire"
"1162","من كبر تكبيرة فى سبيل الله كانت صخرة فى ميزانه اثقل من السموات السبع","","Majmu'a Da'eef Ahadith 1162","","","Virtue of saying takbir in Allah's path"
"1163","ان القوم اذا أسلموا أحرزوا دمائهم و أموالهم","","Majmu'a Da'eef Ahadith 1163","","","Islam protects blood and wealth"
"1164","من أدخل فرسا بين فرسين وهو لا يأمن أن يسبق فلا بأس به فان أمن فهو قمار","","Majmu'a Da'eef Ahadith 1164","","","Entering a third horse in a two-horse race"
"1165","انما السلطان ظل الله ورمحه فى الارض","","Majmu'a Da'eef Ahadith 1165","","","Ruler is Allah's shade"
"1166","اذا أراد الله أن يخلق خلقا للخلافة مسح على ناصيته بيمينه","","Majmu'a Da'eef Ahadith 1166","","","Creation of people destined for caliphate"
"1167","الناس على دين ملوكهم","","Majmu'a Da'eef Ahadith 1167","","","People follow the religion of their kings"
"1168","سيكون فى اخر الزمان أمراء جورة فمن خاف سوطهم وسيفهم فلا يأمرهم ولا ينهاهم","","Majmu'a Da'eef Ahadith 1168","","","How to avoid oppressive rulers"
"1169","يستجاب للمظلومين ما لم يكونوا اكثر من الظالمين فان كانوا اكثر منهم فلا يستجاب لهم","","Majmu'a Da'eef Ahadith 1169","","","Condition for acceptance of the oppressed's prayer"
"1170","من أعان ظالما سلطه الله عليه","","Majmu'a Da'eef Ahadith 1170","","","Consequence for helping an oppressor"
"1171","الجلاوزة والشرط وأعوان الظلمه كلاب النار","","Majmu'a Da'eef Ahadith 1171","","","Helpers of oppressors are dogs of the Fire"
"1172","اشتد غضب الله على من ظلم من لا يجد ناصرا غير الله","","Majmu'a Da'eef Ahadith 1172","","","Result of oppressing the helpless"
"1173","يا أبا هريرة ! لا تلعن الولاة فان الله أدخل أمة جهنم بلعنهم ولاتهم","","Majmu'a Da'eef Ahadith 1173","","","Avoid cursing rulers"
"1174","الفراعنة اثنا عشر، خمسة فى الامم و سبعة فى أمتى","","Majmu'a Da'eef Ahadith 1174","","","There are twelve Pharaohs"
"1175","ما وقى به المرء عرضه فهو له صدقة","","Majmu'a Da'eef Ahadith 1175","","","Charity that protects one's honor"
"1176","من أذى ذميا فأنا يوم القيامة","","Majmu'a Da'eef Ahadith 1176","","","Whoever harms a dhimmi is my adversary"
"1177","ان لقيتم عشارا فاقتلوه","","Majmu'a Da'eef Ahadith 1177","","","Kill the tax collector"
"1178","يقول الرب عز و جل من شغله القران وذكرى عن مسألتى أعطيته أفضل ما اعطى السائلين وفضل كلام الله على سائر الكلام كفضل الله على خلقه","","Majmu'a Da'eef Ahadith 1178","","","Virtue of the Speech of Allah over all speech"
"1179","فاتحة الكتاب تجزى ما لا يجزى شىء من القران ولو أن فاتحة الكتاب جعلت فى كفة الميزان وجعل القران فى الكفة الأخرى لفضلت فاتحة الكتاب على القران سبع مرات","","Majmu'a Da'eef Ahadith 1179","","","Surah Al-Fatiha"
"1180","فاتحة الكتاب شفاء من السلم","","Majmu'a Da'eef Ahadith 1180","","","Surah Al-Fatiha"
"1181","اذا وضعت جنبك على الفراش و قرأت فاتحة الكتاب و قل هو الله أحد فقد أمنت من كل شىء الا الموت","","Majmu'a Da'eef Ahadith 1181","","","Surah Al-Fatiha"
"1182","فاتحة الكتاب واية الكرسى لا يقرؤهما عبد فى دار فيصيبهم ذالك اليوم عين انس أو جن","","Majmu'a Da'eef Ahadith 1182","","","Surah Al-Fatiha"
"1183","فاتحة الكتاب تعدل بثلثى القران","","Majmu'a Da'eef Ahadith 1183","","","Surah Al-Fatiha"
"1184","آيتان هما قران وهما يشفعان وهما مما يحبهما الله الايتان فى اخر سورة البقرة","","Majmu'a Da'eef Ahadith 1184","","","Surah Al-Baqarah"
"1185","من قرأ سورة البقرة توج بتاج فى الجنة","","Majmu'a Da'eef Ahadith 1185","","","Surah Al-Baqarah"
"1186","ان لكل شىء سناما وان سنام القران سورة البقرة . . .","","Majmu'a Da'eef Ahadith 1186","","","Surah Al-Baqarah"
"1187","من قرأ السورة التى يذكر فيها آل عمران يوم الجمعة صلى الله و عليه و ملائكته حتي تغيب لشمس","","Majmu'a Da'eef Ahadith 1187","","","Surah Aal Imran"
"1188","اسم الله الاعظم الذى اذا دعى به اجاب فى هذه الاية من آل عمران : قل اللهم مالك الملك تؤتى الملك من تشاء . . . الخ","","Majmu'a Da'eef Ahadith 1188","","","Surah Aal Imran"
"1189","ما من رجل يكون على دابة صعبة فيقول فى اذنها : ” افغير دين الله يبغون وله اسلم من فى السموات والأرض طوعا وكرها واليه يرجعون“ الا وقفت لاذن الله تعالىٰ .","","Majmu'a Da'eef Ahadith 1189","","","Surah Aal Imran"
"1190","ما خيب الله تعالىٰ عبدا قام فى جوف الليل فافتتح سورة البقرة و آل عمران ونعم كنز المرء البقرة وآل عمران","","Majmu'a Da'eef Ahadith 1190","","","Surah Aal Imran"
"1191","اقرئوا سورة هود يوم الجمعة","","Majmu'a Da'eef Ahadith 1191","","","Surah Hud"
"1192","شيبتني سورة هود و أخواتها الواقعة ، و القارعة ، و الحاقة ، و اذا الشمس كورت ، وسأل سائل","","Majmu'a Da'eef Ahadith 1192","","","Surah Hud"
"1193","سورة الكهف تدعى فى التوراة : الحائلة ؛ تحول بين قارئها وبين النار","","Majmu'a Da'eef Ahadith 1193","","","Surah Kahf"
"1194","من قرأ ثلاث آيات من أول الكهف عصم من فتنة الدجال","","Majmu'a Da'eef Ahadith 1194","","","Surah Kahf"
"1195","ألا أخبركم بسورة ملأت عظمتها ما بين السماء والأرض ؟ و لقارئها من الأجر مثل ذالك ومن قرأها غفر له ما بينه و بين الجمعة الأخري و زيادة ثلاثة أيام ؟ قالوا بلى قال : سورة الكهف","","Majmu'a Da'eef Ahadith 1195","","","Surah Kahf"
"1196","ان الله تبارك و تعالىٰ قراء طه و يس قبل أن يخلق السمٰوات و الارض بألف عام فلما سمعت الملائكة القران قال طوبى لأمة ينزل هذا عليها","","Majmu'a Da'eef Ahadith 1196","","","Surah Yaseen"
"1197","من قراء يس ابتغاء وجه الله غفر الله له ما تقدم من ذنبه","","Majmu'a Da'eef Ahadith 1197","","","Surah Yaseen"
"1198","من قراء يس صدر النهار قضيت حوائجه","","Majmu'a Da'eef Ahadith 1198","","","Surah Yaseen"
"1199","من قراء سورة الدخان فى ليلة الجمعة غفر له","","Majmu'a Da'eef Ahadith 1199","","","Surah Dukhan"
"1200","من قراء حم الدخان فى ليلة أصبح يستغفر له سبعون ألف ملك","","Majmu'a Da'eef Ahadith 1200","","","Surah Dukhan"
"1201","من قراء الدخان كلها وأول حم غافر الي ” واليه المصير“ وآية الكرسى حين يمسى حفظ بها حتي يصبح ومن قراءها حين يصبح حفظ بها حتي يمسى","","Majmu'a Da'eef Ahadith 1201","","","Surah Dukhan"
"1202","من قال حين يصبح ثلاث مرات : أعوذ بالله السميع العليم من الشيطان الرجيم وقراء ثلاث آيات من آخر سورة الحشر وكل الله به سبعين ألف ملك يصلون عليه حتي يمسي وان مات فى ذالك اليوم مات شهيدا ومن قالها حين يمسى كان بتلك المنزلة","","Majmu'a Da'eef Ahadith 1202","","","Surah Hashr"
"1203","من قراء خواتيم الحشر من ليل أو نهار فقبض فى ذٰلك اليوم أو اليلة فقد أوجب الجنة","","Majmu'a Da'eef Ahadith 1203","","","Surah Hashr"
"1204","اسم الله الاعظم فى ست آيات من آخر سورة الحشر","","Majmu'a Da'eef Ahadith 1204","","","Surah Hashr"
"1205","اذا أخذت مضجعك فاقراء سورة الحشر ان مت مت شهيدا","","Majmu'a Da'eef Ahadith 1205","","","Surah Hashr"
"1206","علموا نسائكم سورة الواقعة فانها سورة الغنى","","Majmu'a Da'eef Ahadith 1206","","","Surah Waqi'ah"
"1207","من قراء سورة الواقعة وتعلمها لم يكتب من الغافلين ولم يفتقر هو وأهل بيته","","Majmu'a Da'eef Ahadith 1207","","","Surah Waqi'ah"
"1208","من قراء سورة الواقعة فى كل ليلة لم تصبه فاقة ابدا","","Majmu'a Da'eef Ahadith 1208","","","Surah Waqi'ah"
"1209","اذا زلزلت تعدل نصف القران","","Majmu'a Da'eef Ahadith 1209","","","Surah Zalzalah"
"1210","من قراء فى الفجر ب ألم نشرح وألم تر كيف لم يرمد","","Majmu'a Da'eef Ahadith 1210","","","Surah Sharh and Surah Fil"
"1211","قراءة سورة انا أنزلناه عقب الوضوء","","Majmu'a Da'eef Ahadith 1211","","","Surah Qadr"
"1212","من قراء فى اثر وضوئه انا أنزلناه فى ليلة القدر مرة واحدة كان من الصديقين ومن قراها مرتين كتب فى ديوان الشهداء ومن قراها ثلاثا حشره الله محشر الأنبياء","","Majmu'a Da'eef Ahadith 1212","","","Surah Qadr"
"1213","من قراء قل هو الله احد فى مرضه الذى يموت فيه لم يفتن فى قبره","","Majmu'a Da'eef Ahadith 1213","","","Surah Ikhlas and Mu'awwidhatayn"
"1214","من قراء قل هو الله احد عشرين مرة بني الله له قصرا فى الجنة","","Majmu'a Da'eef Ahadith 1214","","","Surah Ikhlas and Mu'awwidhatayn"
"1215","من قراء قل هو الله احد مائتي مرة غفر الله له ذنوب مائتي سنة","","Majmu'a Da'eef Ahadith 1215","","","Surah Ikhlas and Mu'awwidhatayn"
"1216","من قراء فى يوم قل هو الله احد مائتي مرة كتب الله له ألفا و خمسمائة حسنة الا أن يكون عليه دين","","Majmu'a Da'eef Ahadith 1216","","","Surah Ikhlas and Mu'awwidhatayn"
"1217","من مر بالمقابر فقراء قل هو الله احد احدي عشرة مرة ثم وهب أجره للأموات أعطي من الأجر بعدد الأموات","","Majmu'a Da'eef Ahadith 1217","","","Surah Ikhlas and Mu'awwidhatayn"
"1218","من قراء بعد صلاة الجمعة قل هو الله احد و قل أعوذ برب الفلق و قل أعوذ برب الناس سبع مرات أجاره الله بها من السوء الي الجمعة الأخري","","Majmu'a Da'eef Ahadith 1218","","","Surah Ikhlas and Mu'awwidhatayn"
"1219","كل سبب و نسب منقطع يوم القيامة الا سببي ونسبي","","Majmu'a Da'eef Ahadith 1219","","","Statement about the Prophet"
"1220","هبط جبريل على فقال ان الله يقرئك السلام ويقول اني حرمت النار على صلب أنزلك وبطن حملك و حجر كفلك . . .","","Majmu'a Da'eef Ahadith 1220","","","Statement about the Prophet"
"1221","هبط على جبريل فقال يا محمد ان الله يقرا عليك السلام ويقول يا حبيبي اني كسوت حسن يوسف من نور الكرسي و كسوت حسن و جهك من نور عرشي","","Majmu'a Da'eef Ahadith 1221","","","Statement about the Prophet"
"1222","أن جبريل أتي النبى صلى الله عليه وسلم بقطف فقال ان الله يقرئك السلام وبعثني اليك بهذا القطف لتأكله","","Majmu'a Da'eef Ahadith 1222","","","Statement about the Prophet"
"1223","شفعت فى هؤلاء النفرفي أبى وعمي أبى طالب وأخي من الرضاعة يعني ابن السعدية","","Majmu'a Da'eef Ahadith 1223","","","Statement about the Prophet"
"1224","ان الله أعطي موسي الكلام و أعطاني الرؤية فضلني بالمقام المحمود والحوض المورود","","Majmu'a Da'eef Ahadith 1224","","","Statement about the Prophet"
"1225","أنه صلى الله عليه وسلم أعطي رجلا عرق ذراعيه وجعله فى قارورة حتي امتلأت فجعل يتطيب به فيشم منه أهل المدينة ريحا طيبة . . .","","Majmu'a Da'eef Ahadith 1225","","","Statement about the Prophet"
"1226","لما نزل اذا جاء نصر الله والفتح قال محمد يا جبريل نفسي قد نعيت . . .","","Majmu'a Da'eef Ahadith 1226","","","Statement about the Prophet"
"1227","من صلى عليك فى اليوم واليلة مائة مرة صليت عليه ألفي صلاة وتقضي له ألف حاجة","","Majmu'a Da'eef Ahadith 1227","","","Statement about the Prophet"
"1228","من صلى على عند قبري سمعته . . .","","Majmu'a Da'eef Ahadith 1228","","","Statement about the Prophet"
"1229","كنت أول النبيين فى الخلق وآخرهم فى البعث","","Majmu'a Da'eef Ahadith 1229","","","Statement about the Prophet"
"1230","ما مات رسول الله صلى الله عليه وسلم حتي قراء وكتب","","Majmu'a Da'eef Ahadith 1230","","","Statement about the Prophet"
"1231","اسمي فى القران محمد وفي الانجيل احمد وفي التوراة أحيد","","Majmu'a Da'eef Ahadith 1231","","","Statement about the Prophet"
"1232","نهي عن الصرف قبل موته بشهرين","","Majmu'a Da'eef Ahadith 1232","","","Statement about the Prophet"
"1233","تعبد رسول الله صلى الله عليه وسلم قبل موته بشهرين واعتزل النساء","","Majmu'a Da'eef Ahadith 1233","","","Statement about the Prophet"
"1234","المعرفة رأس مالي والعقل أصل ديني والحسب أساسي . . .","","Majmu'a Da'eef Ahadith 1234","","","Statement about the Prophet"
"1235","ان سبابة النبى صلى الله عليه وسلم كانت أطول من الوسطي","","Majmu'a Da'eef Ahadith 1235","","","Statement about the Prophet"
"1236","ولدت فى زمن الملك العادل","","Majmu'a Da'eef Ahadith 1236","","","Statement about the Prophet"
"1237","لا تجعلوني كقدح الراكب","","Majmu'a Da'eef Ahadith 1237","","","Statement about the Prophet"
"1238","اذا سميتم الولد محمدا فعظموه و وقروه . . .","","Majmu'a Da'eef Ahadith 1238","","","Statement about the Prophet"
"1239","آل محمد شجرة النبوة وآل الرحمة وموضع الرسالة","","Majmu'a Da'eef Ahadith 1239","","","Statement about the family and household of Muhammad"
"1240","من أبغضنا أهل البيت حشره الله يهوديا وان صام وصلي","","Majmu'a Da'eef Ahadith 1240","","","Statement about the family and household of Muhammad"
"1241","ان شيعتنا يخرجون من قبورهم يوم القيامة على ما بهم من الذنوب والعيوب ، وجوههم كالقمر ليلة البدر","","Majmu'a Da'eef Ahadith 1241","","","Statement about the family and household of Muhammad"
"1242","اشتد غضب الله على من أهراق دمي و اذاني فى عترتي","","Majmu'a Da'eef Ahadith 1242","","","Statement about the family and household of Muhammad"
"1243","ان الله جعل ذرية كل نبي من صلبه وجعل ذريتي من صلب على","","Majmu'a Da'eef Ahadith 1243","","","Statement about the family and household of Muhammad"
"1244","لو عاش ابراهيم لكان نبيا","","Majmu'a Da'eef Ahadith 1244","","","Statement about Ibrahim bin Muhammad"
"1245","ان الله يقول لك تزوج ابنة أبى بكر . . .","","Majmu'a Da'eef Ahadith 1245","","","Statement about Aisha"
"1246","اسقطت من النبى صلى الله عليه وسلم سقطا فسماه عبد الله وكناني ام عبد الله","","Majmu'a Da'eef Ahadith 1246","","","Statement about Aisha"
"1247","يا عائشه أنت اطيب من اللبن . . .","","Majmu'a Da'eef Ahadith 1247","","","Statement about Aisha"
"1248","كيف حبك لي قال كعقد الحبل","","Majmu'a Da'eef Ahadith 1248","","","Statement about Aisha"
"1249","خذوا شطر دينكم عن الحميراء","","Majmu'a Da'eef Ahadith 1249","","","Statement about Aisha"
"1250","ان الله امرني ان اتخذ أبابكر والدا وعمر مشيرا وعثمان سندا و أنت يا على ظهيرا","","Majmu'a Da'eef Ahadith 1250","","","Statement about the four caliphs"
"1251","ينادي مناد يوم القيامة من تحت العرش أين أصحاب محمد فيوتي بأبي بكر و عمر و عثمان و على","","Majmu'a Da'eef Ahadith 1251","","","Statement about the four caliphs"
"1252","ابوبكر وزيري والقائم فى أمتي من بعدي و عمر حبيبي ينطق عن لساني و عثمان مني و على أخي وصاحب لوائي","","Majmu'a Da'eef Ahadith 1252","","","Statement about the four caliphs"
"1253","ان الله يتجلي للخلق يوم القيامة عامة ويتجلي لك خاصة","","Majmu'a Da'eef Ahadith 1253","","","Statement about Abu Bakr"
"1254","أبشر يا أبابكر ان الذى وضاك للصلاة جبريل","","Majmu'a Da'eef Ahadith 1254","","","Statement about Abu Bakr"
"1255","ان الله لما خلق الأرواح اختار روح ابي بكر من بين الأرواح فجعل ترابها من الجنة . . .","","Majmu'a Da'eef Ahadith 1255","","","Statement about Abu Bakr"
"1256","ان الله اتخذ لأبي بكر فى أعلي عليين قبة من ياقوتة بيضاء","","Majmu'a Da'eef Ahadith 1256","","","Statement about Abu Bakr"
"1257","لما ولد ابوبكر الصديق أقبل الله على جنة عدن فقال و عزتي و جلالي لأدخلك الا من يجب هٰذا المولود","","Majmu'a Da'eef Ahadith 1257","","","Statement about Abu Bakr"
"1258","ان الله جعل أبابكر خليفتي على دين الله و وحيه فأطيعوه . . .","","Majmu'a Da'eef Ahadith 1258","","","Statement about Abu Bakr"
"1259","انه فى السماء اشهر منه فى الارض","","Majmu'a Da'eef Ahadith 1259","","","Statement about Abu Bakr"
"1260","من مثل أبى بكر كذبني الناس وصدقني وامن بي . . .","","Majmu'a Da'eef Ahadith 1260","","","Statement about Abu Bakr"
"1261","اذا كان يوم القيامة . . . نصب لأبي بكر كرسي فيجلس عليه","","Majmu'a Da'eef Ahadith 1261","","","Statement about Abu Bakr"
"1262","عرج بي الي السماء فما مررت بسماء الا وجدت فيها اسمي مكتوبا محمد رسول الله و أبو بكر الصديق خلفي","","Majmu'a Da'eef Ahadith 1262","","","Statement about Abu Bakr"
"1263","لا ينبغي لقوم فيهم ابوبكر أن يومهم غيره","","Majmu'a Da'eef Ahadith 1263","","","Statement about Abu Bakr"
"1264","لو وزن ايمان أبى بكر بايمان أهل الأرض لرجع","","Majmu'a Da'eef Ahadith 1264","","","Statement about Abu Bakr"
"1265","ما صب الله فى صدري شيئا الا صبه فى صدر أبى بكر","","Majmu'a Da'eef Ahadith 1265","","","Statement about Abu Bakr"
"1266","قول عمر كان النبى صلى الله عليه وسلم یتكلم مع أبى بكر وكنت بينهما كالز نجي","","Majmu'a Da'eef Ahadith 1266","","","Statement about Abu Bakr"
"1267","ان الله يكره فى السماء ان يخطأ أبو بكر الصديق","","Majmu'a Da'eef Ahadith 1267","","","Statement about Abu Bakr"
"1268","لو لم أبعث فيكم لبعث عمر","","Majmu'a Da'eef Ahadith 1268","","","Statement about Umar"
"1269","لما أسري بي رأيت فى السماء خيلا موقوفة . . . فقلت لجبريل لمن هذه فقال هذه لمحبي ابي بكر و عمر","","Majmu'a Da'eef Ahadith 1269","","","Statement about Umar"
"1270","اول من يعطي كتابه بيمينه من هذه الأمة عمر بن الخطاب . . .","","Majmu'a Da'eef Ahadith 1270","","","Statement about Umar"
"1271","يا أبا الحسن أحبهما فبحبهما تدخل الجنة","","Majmu'a Da'eef Ahadith 1271","","","Statement about Umar"
"1272","ان فى السماء الدنيا ثمانين ألف ملك يستغفرون الله لمن أحب أبابكر و عمر","","Majmu'a Da'eef Ahadith 1272","","","Statement about Umar"
"1273","من شتم عمر فمأ واه سقر","","Majmu'a Da'eef Ahadith 1273","","","Statement about Umar"
"1274","من سب أبا بكر و عمر قتل ولا يستتاب","","Majmu'a Da'eef Ahadith 1274","","","Statement about Umar"
"1275","رأيت ليلة أسري بي فى العرش جريدة خضراء فيها مكتوب بنور أبيض لا اله الا الله محمد رسول الله أبو بكر الصديق عمر الفاروق","","Majmu'a Da'eef Ahadith 1275","","","Statement about Umar"
"1276","لمن أنت قالت للمقتول شهيدا عثمان بن عفان","","Majmu'a Da'eef Ahadith 1276","","","Statement about Uthman"
"1277","انه كان يبغض عثمان فأبغضه الله","","Majmu'a Da'eef Ahadith 1277","","","Statement about Uthman"
"1278","ان عثمان ليتحول من منزل الي منزل فتبرق له الجنة","","Majmu'a Da'eef Ahadith 1278","","","Statement about Uthman"
"1279","أن النبى صلى الله عليه وسلم نهض الي عثمان فاعتنقه ثم قال أنت ولي فى الدنيا والأخرة","","Majmu'a Da'eef Ahadith 1279","","","Statement about Uthman"
"1280","لكل نبي خليل فى امته وان خليلي عثمان بن عفان","","Majmu'a Da'eef Ahadith 1280","","","Statement about Uthman"
"1281","ما فى الجنة شجرة الا مكتوب على كل ورقة منها . . . عثمان ذو النورين","","Majmu'a Da'eef Ahadith 1281","","","Statement about Uthman"
"1282","خلقت أنا و هارون بن عمران و يحي بن زكريا و على بن أبى طالب من طينة واحدة","","Majmu'a Da'eef Ahadith 1282","","","Statement about Ali"
"1283","خلقت أنا وعلي من نور واحد","","Majmu'a Da'eef Ahadith 1283","","","Statement about Ali"
"1284","قول على : أنا عبد الله و أخو رسول الله و أنا الصديق الأكبر . . .","","Majmu'a Da'eef Ahadith 1284","","","Statement about Ali"
"1285","أنت أول من آمن بي وأنت أول من يصافحني يوم القيامه وأنت الصديق الأكبر وأنت الفاروق . . .","","Majmu'a Da'eef Ahadith 1285","","","Statement about Ali"
"1286","لئن اطاعوه ليدخلن الجنة اجمعين اكتعين","","Majmu'a Da'eef Ahadith 1286","","","Statement about Ali"
"1287","ان أخي و وزيري و خليفتي من أهلي و خير من أترك بعدي يقضي ديني و ينجز موعدي على","","Majmu'a Da'eef Ahadith 1287","","","Statement about Ali"
"1288","اولكم و رودا على الحوض أولكم اسلاما : على بن أبى طالب","","Majmu'a Da'eef Ahadith 1288","","","Statement about Ali"
"1289","من لم يقل على خير الناس فقد كفر","","Majmu'a Da'eef Ahadith 1289","","","Statement about Ali"
"1290","علي خير البرية","","Majmu'a Da'eef Ahadith 1290","","","Statement about Ali"
"1291","أنا دار الحكمة وعلي بابها","","Majmu'a Da'eef Ahadith 1291","","","Statement about Ali"
"1292","كان رسول الله صلى الله عليه وسلم يوحي اليه ورأسه فى حجر على . . .","","Majmu'a Da'eef Ahadith 1292","","","Statement about Ali"
"1293","أنت مني بمنزلة هارون من موسيٰ","","Majmu'a Da'eef Ahadith 1293","","","Statement about Ali"
"1294","النظر الي على عبادة","","Majmu'a Da'eef Ahadith 1294","","","Statement about Ali"
"1295","امر رسول الله صلى الله عليه وسلم بسد الأبواب الشارعة فى المسجد وترك باب على","","Majmu'a Da'eef Ahadith 1295","","","Statement about Ali"
"1296","يا على ! لا يحل لاحد ان يجنب فى هذا المسجد غيري و غيرك","","Majmu'a Da'eef Ahadith 1296","","","Statement about Ali"
"1297","حب على يأكل الحسنات كما تأكل النار الحطب","","Majmu'a Da'eef Ahadith 1297","","","Statement about Ali"
"1298","من أراد أن ينظر الي آدم فى علمه والي نوح فى فهمه والي ابراهيم فى حلمه والي يحي بن زكريا فى زهده والي موسي بن عمران فى بطشه فلينظر الي على بن ابي طالب","","Majmu'a Da'eef Ahadith 1298","","","Statement about Ali"
"1299","اسمي فى القرآن والشمس وضحاها واسم على والقمر اذا تلاها","","Majmu'a Da'eef Ahadith 1299","","","Statement about Ali"
"1300","خير من اخلف بعدي على","","Majmu'a Da'eef Ahadith 1300","","","Statement about Ali"
"1301","قول على بايع الناس لأبي بكر وأنا والله أولي منه وأحق بها منه","","Majmu'a Da'eef Ahadith 1301","","","Statement about Ali"
"1302","اول من يدخل من هذا الباب امير المؤمنين و سيد المرسلين . . . اذ جاء على","","Majmu'a Da'eef Ahadith 1302","","","Statement about Ali"
"1303","من مات وفي قلبه بغض لعلي بن أبى طالب فليمت يهوديا أو نصرانيا","","Majmu'a Da'eef Ahadith 1303","","","Statement about Ali"
"1304","انه يمنع المطر عن هذه الأمة ببغضهم على بن ابي طالب","","Majmu'a Da'eef Ahadith 1304","","","Statement about Ali"
"1305","من احب أن يتمسك بالقضيب الرطب الذى غرسه الله بيده فليتمسك بحب علي","","Majmu'a Da'eef Ahadith 1305","","","Statement about Ali"
"1306","من يحمل رايتك يوم القيامة قال على","","Majmu'a Da'eef Ahadith 1306","","","Statement about Ali"
"1307","اللهم أعط عليا فضيلة لم تعطها أحدا قبله ولا بعده","","Majmu'a Da'eef Ahadith 1307","","","Statement about Ali"
"1308","انها نزلت فى على ثلاثمائة اية","","Majmu'a Da'eef Ahadith 1308","","","Statement about Ali"
"1309","يا على ! ان الله غفرلك و ذريتك و لولدك ولأهلك ولشيعتك ولمحبي شيعتك","","Majmu'a Da'eef Ahadith 1309","","","Statement about Ali"
"1310","من أحبني فليحب عليا ومن أبغض عليا فقد أبغضني . . .","","Majmu'a Da'eef Ahadith 1310","","","Statement about Ali"
"1311","لن يموت هذا الا مقتولا يعني عليا","","Majmu'a Da'eef Ahadith 1311","","","Statement about Ali"
"1312","قول على غسلت النبى صلى الله عليه وسلم فشربت ماء محاجر عينيه فورثت علم الأولين والأخرين","","Majmu'a Da'eef Ahadith 1312","","","Statement about Ali"
"1313","اذا كان يوم القيامة قال الله لي ولعلي بن أبى طالب . . .","","Majmu'a Da'eef Ahadith 1313","","","Statement about Ali"
"1314","يا على ! أنت و شيعتك فى الجنة","","Majmu'a Da'eef Ahadith 1314","","","Statement about Ali"
"1315","مثلي مثل شجرة أنا أصلها وعلي فرعها","","Majmu'a Da'eef Ahadith 1315","","","Statement about Ali"
"1316","ان الله أمر النبى أن يأكل من طبق جاء به اليه جبريل من رطب الجنة وأمره أن يواقع خديجة فحملت بفاطمة","","Majmu'a Da'eef Ahadith 1316","","","Statement about Fatimah"
"1317","لما اسري بي الي السماء أدخلني جبريل الجنة فناولني تفاحة فأكلتها فصارت نطفة فى صلبي فلما نزلت واقعت خديجة ففاطمة من تلك النطفة","","Majmu'a Da'eef Ahadith 1317","","","Statement about Fatimah"
"1318","انا و فاطمة و على فى حظيرة القدس فى قبة بيضاء سقفها عرش الرحمٰن","","Majmu'a Da'eef Ahadith 1318","","","Statement about Fatimah"
"1319","ان الله أمرني أن ازوج فاطمة من على ففعلت . . .","","Majmu'a Da'eef Ahadith 1319","","","Statement about Fatimah"
"1320","يا على ان الله زوجك فاطمة وجعل صداقها الأرض فمن مشي عليها مبغضا لك يمشي حراما","","Majmu'a Da'eef Ahadith 1320","","","Statement about Fatimah"
"1321","خطب النبى صلى الله عليه وسلم حين زوج فاطمة بعلي فقال الحمد لله المحمود بنعمته المعبود بقدرته . . .","","Majmu'a Da'eef Ahadith 1321","","","Statement about Fatimah"
"1322","ان جبريل خطب فى السماء فزوج فاطمة من على . . .","","Majmu'a Da'eef Ahadith 1322","","","Statement about Fatimah"
"1323","لما زفت فاطمة الي على كان النبى صلى الله عليه وسلم امامها و جبريل عن يمينها و ميكائيل عن يسارها و سبعون الف ملك خلفها يسبحون الله و يقدسونه حتي طلع الفجر","","Majmu'a Da'eef Ahadith 1323","","","Statement about Fatimah"
"1324","ابنتي فاطمة حوراء آدمية لم تحض ولم تطمث وانما سماها فاطمة لأن الله فطمها و محبيها من النار","","Majmu'a Da'eef Ahadith 1324","","","Statement about Fatimah"
"1325","ان فاطمه احصنت فرجها فحرمها الله و ذريتها على النار","","Majmu'a Da'eef Ahadith 1325","","","Statement about Fatimah"
"1326","احكم بيني وبين قاتل ولدي","","Majmu'a Da'eef Ahadith 1326","","","Statement about Fatimah"
"1327","اذا كان يوم القيامة نادي مناد من وراء الحجب يا أهل الجمع غضوا أبصاركم عن فاطمة بنت محمد حتي تمر","","Majmu'a Da'eef Ahadith 1327","","","Statement about Fatimah"
"1328","أتاني جبريل فليحب عليا ومن أحب عليا فليحب فاطمة . . .","","Majmu'a Da'eef Ahadith 1328","","","Statement about Fatimah"
"1329","من احبني فليحب عليا ومن أحب عليا فليحب فاطمة . . .","","Majmu'a Da'eef Ahadith 1329","","","Statement about Fatimah"
"1330","قالت الجنة يا رب أليس وعدتني أن تزينني بركنين من أركانك قال أولم أزينك بالحسن والحسين","","Majmu'a Da'eef Ahadith 1330","","","Statement about Hasan and Husayn"
"1331","يا جبريل فديت الحسين بابراهيم","","Majmu'a Da'eef Ahadith 1331","","","Statement about Hasan and Husayn"
"1332","لعن الله قاتلك قال فقلت من قاتله قال رجل من امتي يبغض عترتي ولا تناله شفاعتي","","Majmu'a Da'eef Ahadith 1332","","","Statement about Hasan and Husayn"
"1333","العباس بن عبد المطلب ابي و عمي و وصيي و وارثي","","Majmu'a Da'eef Ahadith 1333","","","Statement about Abbas"
"1334","عمي العباس حصن فرجه فى الجاهلية والاسلام فحرم الله بدنه على النار","","Majmu'a Da'eef Ahadith 1334","","","Statement about Abbas"
"1335","قد رأيت عبدالرحمٰن بن عوف يدخل الجنة حبوا","","Majmu'a Da'eef Ahadith 1335","","","Statement about Abdur Rahman bin Awf"
"1336","أنه صلى الله عليه وسلم أخذ القلم من يد على فدفعه الي معاوية","","Majmu'a Da'eef Ahadith 1336","","","Statement about Muawiyah"
"1337","أن جماعة من بني هاشم سألوا رسول الله صلى الله عليه وسلم أن يحول الكتابة من معاوية فنزل الوحي باختياره","","Majmu'a Da'eef Ahadith 1337","","","Statement about Muawiyah"
"1338","اول من يختصم من هذه الأمة بين يدي الرب على و معاوية","","Majmu'a Da'eef Ahadith 1338","","","Statement about Muawiyah"
"1339","حبيبي قد اهديت هذا القلم من فوق عرشي الي معاوية . . .","","Majmu'a Da'eef Ahadith 1339","","","Statement about Muawiyah"
"1340","فاستشار جبريل فقال استكتبه فانه امين","","Majmu'a Da'eef Ahadith 1340","","","Statement about Muawiyah"
"1341","الامناء عند الله ثلاثة : أنا و جبريل و معاوية","","Majmu'a Da'eef Ahadith 1341","","","Statement about Muawiyah"
"1342","ادعوا لي معاوية . . . فانه قوي امين","","Majmu'a Da'eef Ahadith 1342","","","Statement about Muawiyah"
"1343","أن النبى صلى الله عليه وسلم ناول معاوية سهما وقال خذ هٰذا السهم حتي تلقاني به فى الجنة","","Majmu'a Da'eef Ahadith 1343","","","Statement about Muawiyah"
"1344","فأعطي معاوية ثلاث سفر جلات وقال تلقاني بهن فى الجنة","","Majmu'a Da'eef Ahadith 1344","","","Statement about Muawiyah"
"1345","يبعث معاوية يوم القيامة وعليه رداء من نور الايمان","","Majmu'a Da'eef Ahadith 1345","","","Statement about Muawiyah"
"1346","لكل امة فرعون و فرعون هذه الأمة معاوية","","Majmu'a Da'eef Ahadith 1346","","","Statement about Muawiyah"
"1347","اذا رأيتم معاوية يخطب على منبري فاقتلوا","","Majmu'a Da'eef Ahadith 1347","","","Statement about Muawiyah"
"1348","معاوية بن ابي سفيان أحلم امتي وأجودها","","Majmu'a Da'eef Ahadith 1348","","","Statement about Muawiyah"
"1349","انما حر جهنم على امتي كحر الحمام","","Majmu'a Da'eef Ahadith 1349","","","Statement about the Ummah of Muhammad"
"1350","الجنة محرمة على جميع الامم حتي ادخلها انا وامتي","","Majmu'a Da'eef Ahadith 1350","","","Statement about the Ummah of Muhammad"
"1351","امتي امة مرحومة لا عذاب عليها عجل عقابها فى الدنيا الزلازل و الفتن","","Majmu'a Da'eef Ahadith 1351","","","Statement about the Ummah of Muhammad"
"1352","أحبوا العرب لثلاث لأني عربي و القران عربي و كلام أهل الجنة عربي","","Majmu'a Da'eef Ahadith 1352","","","Love Arabs for three reasons"
"1353","خير الناس العرب و خير العرب قريش و خير قريش بنو هاشم","","Majmu'a Da'eef Ahadith 1353","","","Best people are the Arabs"
"1354","ان الله فى السماء جنودا وفي الأرض جنودا فجنده فى السماء الملائكة وجنده فى الارض أهل خراسان","","Majmu'a Da'eef Ahadith 1354","","","Allah's armies are in the heavens and the earth"
"1355","أبغض الكلام الي الله الفارسية . . .","","Majmu'a Da'eef Ahadith 1355","","","Worst language"
"1356","ان الله تعالىٰ اذا رضي أنزل الوحي بالعربية و اذا غضب أنزل الوحي بالفارسية","","Majmu'a Da'eef Ahadith 1356","","","Revelation descended in Arabic for pleasure"
"1357","من أحسن منكم أن يتكلم بالعربية فلا يتكلمن بالفارسية فانه يورث النفاق","","Majmu'a Da'eef Ahadith 1357","","","Speak Arabic, avoid Persian"
"1358","اميتوا سنة العجم وأحيوا سنة العرب","","Majmu'a Da'eef Ahadith 1358","","","Revive the ways of the Arabs"
"1359","من أدخل بيته حبشيا أدخل الله فى بيته بركة","","Majmu'a Da'eef Ahadith 1359","","","Benefit of letting an Abyssinian into the house"
"1360","الزجي اذا شبع زني و اذا جاع سرق","","Majmu'a Da'eef Ahadith 1360","","","A hungry Abyssinian steals"
"1361","اتقوا اليهود و الهنود ولو بسبعين بطنا","","Majmu'a Da'eef Ahadith 1361","","","Beware of Jews and Hindus"
"1362","ان الله ملائكة تنقل الاموات","","Majmu'a Da'eef Ahadith 1362","","","Angels who transfer the dead"
"1363","ان الله ملكا ما بين شفري عينيه مسيرة خمسمائة عام","","Majmu'a Da'eef Ahadith 1363","","","A great angel of Allah"
"1364","ان الله ملكا نصف جسده الاعلي ثلج ونصفه الاسفل نار . . .","","Majmu'a Da'eef Ahadith 1364","","","A wondrous angel of Allah"
"1365","مؤذن أهل السمٰوات جبريل و امامهم ميكائيل . . .","","Majmu'a Da'eef Ahadith 1365","","","The caller and imam of the heavens"
"1366","اثتزروا كما رأيت الملائكة تأتزر عند ربها الي أنصاف سوقها","","Majmu'a Da'eef Ahadith 1366","","","Tie your lower garment like the angels"
"1367","اخضبوا لحاكم فان الملائكة تستبشر بخضاب المؤمن","","Majmu'a Da'eef Ahadith 1367","","","Angels rejoice at a believer's dye"
"1368","اذا أتي أحدكم أهله فليستتر فانه اذا لم يستتر استحيت الملائكة و خرجت و حضر الشيطان فاذا كان بينهما ولد للشيطان فيه شريك","","Majmu'a Da'eef Ahadith 1368","","","Angels are shy at exposure during intercourse"
"1369","اذا أحب الله عبدا قذف حبه فى قلوب الملائكة . . .","","Majmu'a Da'eef Ahadith 1369","","","Angels love the servant in their hearts"
"1370","اذا عطس أحدكم فقال : الحمد لله قالت الملائكة : رب العالمين ، فاذا قال : رب العالمين قالت الملائكة : رحمك الله","","Majmu'a Da'eef Ahadith 1370","","","Angels reply when one sneezes"
"1371","اذا كان يوم الجمعة غدت الشيطان براياتها الي الاسواق فيرمون الناس بالربائث ويثبطونهم عن الجمعة وتغدو والملائكة فتجلس على ابواب المساجد . . .","","Majmu'a Da'eef Ahadith 1371","","","On Friday, angels stand at mosque doors"
"1372","اذا مات الميت تقول الملائكة : ما قدم ؟ وتقول الناس : ما خلف","","Majmu'a Da'eef Ahadith 1372","","","Angels' statement at a servant's death"
"1373","من أكثر الدعاء قالت الملائكة صوت معروف و دعاء مستجاب و حاجة مقضية","","Majmu'a Da'eef Ahadith 1373","","","Angels' statement for one who makes much dua"
"1374","اصطفوا وليتقدمكم فى الصلاة أفضلكم فان الله عز وجل يصطفي من الملائكة رسلا ومن الناس","","Majmu'a Da'eef Ahadith 1374","","","Allah chooses a messenger from among the angels"
"1375","افضل الرباط الصلاة ولزوم مجالس الذكر وما من عبد يصلي ثم يقعد فى مصلاه الا لم تزل الملائكة تصلي عليه حتي يحدث أو يقوم","","Majmu'a Da'eef Ahadith 1375","","","Angels pray for those sitting in the place of prayer"
"1376","الحد آدم و غسل بالماء وترا فقالت الملائكة : هذه سنة ولد آدم من بعده","","Majmu'a Da'eef Ahadith 1376","","","Angels' statement at Adam's burial"
"1377","ان آدم غسلته الملائكة بماء وسدر وكفنوه وألحدوا وقالوا هذه سنتكم يا بني آدم موتاكم","","Majmu'a Da'eef Ahadith 1377","","","Angels' statement at Adam's burial"
"1378","الصائم اذا اكل عنده صلت عليه الملائكة","","Majmu'a Da'eef Ahadith 1378","","","Angels pray for the fasting person when food is eaten near him"
"1379","يا بلال أن الصائم تسبه عظامه وتستغفرله الملائكة ما اكل عنده","","Majmu'a Da'eef Ahadith 1379","","","Angels pray for the fasting person when food is eaten near him"
"1380","ان الله يباهي بالشباب العابد الملائكة يقول انظروا الي عبدي ترك شهوته أجلي","","Majmu'a Da'eef Ahadith 1380","","","Angels boast of a young worshipper"
"1381","ان الملائكة لتصافح ركاب الحجاج وتعتنق المشاة","","Majmu'a Da'eef Ahadith 1381","","","Angels shake hands with pilgrims' mounts"
"1382","ان الملائكة لتفرح بذهاب الشتاء رحمة لما يدخل على فقراء المسلمين من الشدة","","Majmu'a Da'eef Ahadith 1382","","","Angels rejoice at the end of winter"
"1383","لا تزال الملائكة تصلي على أحدكم ما دامت مائدته موضوعة","","Majmu'a Da'eef Ahadith 1383","","","Angels pray as long as the tablecloth is spread"
"1384","ان الملائكة لا تنزل على قوم فيهم قاطع رحم","","Majmu'a Da'eef Ahadith 1384","","","Severing ties prevents angels' descent"
"1385","ان الناس يحشرون ئوم القيامة على ثلاثة أفواج . . . وفوج تسحبهم الملائكة على وجوههم","","Majmu'a Da'eef Ahadith 1385","","","On Judgment Day, angels will drag some by their faces"
"1386","فنأتي سوقا قد صفت به الملائكة ما لم تنطر العيون الي مثله ولم تسمع الآذان ولم يخطر على القلوب","","Majmu'a Da'eef Ahadith 1386","","","Angels line up in a market in Paradise"
"1387","اني رأيت الملائكة تغسل حنظلة بن أبى عامر بين السماء والأرض بماء المزن فى صحاف الفضة","","Majmu'a Da'eef Ahadith 1387","","","Angels washed Hanzalah with silver vessels"
"1388","لقد رأيت الملائكة تغسل حمزة","","Majmu'a Da'eef Ahadith 1388","","","Angels washed Hamza"
"1389","ايما وال ولي أمر امتي بعدي اقيم على الصراط ونشرت الملائكة صحيفته فان كان عادلا نجاه الله بعدله . . .","","Majmu'a Da'eef Ahadith 1389","","","On the Bridge, angels open the records for rulers"
"1390","تحفه الملائكة تجمير المساجد","","Majmu'a Da'eef Ahadith 1390","","","Angels' gift is to perfume mosques"
"1391","ثلاثة أصوات يباهي الله بهن الملائكة : الاذان و التكبير فى سبيل الله ورفع الصوت بالتلبيه","","Majmu'a Da'eef Ahadith 1391","","","Angels boast of three voices"
"1392","الحور العين خلقن من تسبيح الملائكة","","Majmu'a Da'eef Ahadith 1392","","","Creation of houris from angels' glorification"
"1393","رأيت اكثر من رأيت من الملائكة معتمين","","Majmu'a Da'eef Ahadith 1393","","","Most angels wear turbans"
"1394","سألت ربي أن يكتب على امتي سبحة الضحي فقال تلك صلاة الملائكة ؛ من شاء صلاها ومن شاء تركها","","Majmu'a Da'eef Ahadith 1394","","","Angels' prayer"
"1395","سموا بأسماء الأنبياء ولا تسموا بأسماء الملائكة","","Majmu'a Da'eef Ahadith 1395","","","Do not name after angels"
"1396","طعام المؤمنين فى زمن الدجال طعام الملائكة : التسبيح والتقديس","","Majmu'a Da'eef Ahadith 1396","","","In Dajjal's time, believers' food will be like angels"
"1397","اذا بلغ (عبدي) سبعين سنة أحبته الملائكة . . . واذا بلغ تسعين سنة قالت الملائكة أسير الله فى ارضه فغفرله ما تقدم من ذنبه وما تأخر ويشفع فى أهله","","Majmu'a Da'eef Ahadith 1397","","","Angels love a seventy-year-old"
"1398","كانت سيما الملائكة يوم بدر عمائم سود و يوم احد عمائم حمر","","Majmu'a Da'eef Ahadith 1398","","","Angels' sign at Badr and Uhud"
"1399","للمصلي ثلاث خصال . . . تحف به الملائكة من لدن قدميه الي عنان السماء","","Majmu'a Da'eef Ahadith 1399","","","Angels surround the worshipper up to the sky"
"1400","ما تشهد الملائكة من لهوكم الا الرهان والنضال","","Majmu'a Da'eef Ahadith 1400","","","Angels attend only two types of games"
"1401","ما من أهل بيت تروح عليهم ثلة من الغنم الا باتت الملائكة تصلي عليهم حتي تصبح","","Majmu'a Da'eef Ahadith 1401","","","Angels pray for households with goats"
"1402","من باع عيبا لم يبينه لم يزل فى مقت الله ولم تزل الملائكة تلعنه","","Majmu'a Da'eef Ahadith 1402","","","Angels curse the seller of defective goods"
"1403","من ختم القران أول النهار صلت عليه الملائكة حتي يمسي ومن ختمه اخر النهار صلت عليه الملائكة حتي يصبح","","Majmu'a Da'eef Ahadith 1403","","","Angels pray for one who completes the Quran"
"1404","من دعا رجلا بغير اسمه لعنته الملائكة","","Majmu'a Da'eef Ahadith 1404","","","Angels curse calling someone without their name"
"1405","المومن اكرم على الله من بعض الملائكة","","Majmu'a Da'eef Ahadith 1405","","","Believer more honored than some angels before Allah"
"1406","لا تدخل الملائكة بيتا فيه جرس","","Majmu'a Da'eef Ahadith 1406","","","Angels do not enter a house with a bell"
"1407","من غدا طلب العلم عليه الملائكة و بورك له فى معاشه","","Majmu'a Da'eef Ahadith 1407","","","Angels pray for the seeker of knowledge"
"1408","يا ابا هريرة علم الناس القران و تعلمه فانك ان مت وأنت كذالك زارت الملائكة قبرك كما يزار البيت العتيق","","Majmu'a Da'eef Ahadith 1408","","","Angels visit the grave of one who taught or learned Quran"
"1409","من فطر صائما فى رمضان من كسب حلال صلت عليه الملائكة ليالي رمضان كلها . . .","","Majmu'a Da'eef Ahadith 1409","","","Angels pray for the one who gives iftar"
"1410","عليكم بالسواك فنعم الشئ السواك . . . تحمده الملائكة و يرضي الرب و يسخط الشيطان","","Majmu'a Da'eef Ahadith 1410","","","Praise from angels for using miswak"
"1411","لا تصلي الملائكة على نائحة","","Majmu'a Da'eef Ahadith 1411","","","Wailing woman deprived of angels’ prayers"
"1412","اذا كان عيد الفطر قامت الملائكة على افواه الطرق . . .","","Majmu'a Da'eef Ahadith 1412","","","Angels spread out on Eid al-Fitr roads"
"1413","لما حملت حواء طاف بها ابليس وكان لا يعيش لها ولد فقال : سميه عبد الحارث فسمته عبد الحارث فعاش","","Majmu'a Da'eef Ahadith 1413","","","Hawwa conceived by obeying Satan"
"1414","اياكم الكبر فان ابليس حمله الكبر على أن لا يسجد لآدم . . .","","Majmu'a Da'eef Ahadith 1414","","","Iblis refused to prostrate due to arrogance"
"1415","ان عدو الله ابليس لما علم أن الله قد استجاب دعائي وغفر لأمتي أخذ التراب فجعل يحثوه على رأسه","","Majmu'a Da'eef Ahadith 1415","","","Iblis’ state at the forgiveness of Muhammad’s ummah"
"1416","ما من شيء اقطع لظهر ابليس من عالم يخرج فى قبيله","","Majmu'a Da'eef Ahadith 1416","","","Scholar breaks Iblis’ back"
"1417","الثوم والبصل والكراث من سك ابليس","","Majmu'a Da'eef Ahadith 1417","","","Satan’s scent"
"1418","ان أحدكم اذا أراد أن يضرج من المسجد تداعت جنود ابليس . . .","","Majmu'a Da'eef Ahadith 1418","","","Seeking refuge from Iblis’ armies when leaving mosque"
"1419","عليكم بلا اله الا الله والاستغفار فاكثروا منها ، فان ابليس قال : أهلكت الناس بالذنوب وأهلكوني بلا اله الا الله والاستغار","","Majmu'a Da'eef Ahadith 1419","","","Iblis destroyed by La ilaha illallah and istighfar"
"1420","ان ابليس يبعث أشد أصحابه وأقوي أصحابه الي من تصنع المعروف فى ماله","","Majmu'a Da'eef Ahadith 1420","","","Satan targets those who spend wealth properly"
"1421","الشعر من مزامير ابليس","","Majmu'a Da'eef Ahadith 1421","","","Poetry is Satan’s instrument"
"1422","اتقوا الدنيا واتقوا النساء فان ابليس طلاع رصاد وما هو بشيء من فخوخه بأوثق لصيده فى الأتقياء من النساء","","Majmu'a Da'eef Ahadith 1422","","","Satan’s strongest trap is for hunting"
"1423","فان ابليس لربه عز وجل يا رب قد أهبط آدم . . .","","Majmu'a Da'eef Ahadith 1423","","","Iblis’ book, food, and house"
"1424","اول من يكسي حلة من النار ابليس . . .","","Majmu'a Da'eef Ahadith 1424","","","Iblis will wear Hell’s garment first"
"1425","كان ابليس أول من ناح و أول من تغني","","Majmu'a Da'eef Ahadith 1425","","","Iblis was the first to wail"
"1433","اذا توضأتم فلا تنفضوا أيديكم فانها مراوح الشيطان","","Majmu'a Da'eef Ahadith 1433","","","Satan’s fans"
"1434","النساء حبالة الشيطان","","Majmu'a Da'eef Ahadith 1434","","","Satan’s snare"
"1435","امنع الصفوف من الشيطان الصف الأول","","Majmu'a Da'eef Ahadith 1435","","","Row that most prevents Satan"
"1436","الفحش والبذاء من الشيطان وهما يقربان من النار ويباعدان من الجنة","","Majmu'a Da'eef Ahadith 1436","","","Indecency and foul speech from Satan"
"1437","ان الشيطان حساس لحاس ، فاحذروه على أنفسكم ، من بات وفي يده ريح غمر ، فأصابه شيء فلا يلومن الا نفسه","","Majmu'a Da'eef Ahadith 1437","","","Satan is very sensitive and licks much"
"1438","ان الشيطان ذئب الانسان كذئب الغنم يأخذ الشاة القاصية . . .","","Majmu'a Da'eef Ahadith 1438","","","Satan is the wolf of humans"
"1439","ان الشيطان يهم بالواحد ويهم بالاثنين فاذا كانوا ثلاثة لم يهم بهم","","Majmu'a Da'eef Ahadith 1439","","","Satan cannot sadden three people"
"1440","ان الشيطان لم يلق عمر منذ اسلم الا خر لوجهه","","Majmu'a Da'eef Ahadith 1440","","","Satan falls on his face seeing Umar"
"1441","ان الشيطان واضع خطمه على قلب ابن آدم فان ذكر الله خنس وان نسي التقم قلبه","","Majmu'a Da'eef Ahadith 1441","","","Satan’s bridle on human heart"
"1442","ان الشيطان يحب الحمرة فاياكم والحمرة وكل ثوب ذي شهرة","","Majmu'a Da'eef Ahadith 1442","","","Satan loves red color"
"1443","اياكم والحمرة فانها أحب الزينة الي الشيطان","","Majmu'a Da'eef Ahadith 1443","","","Satan loves red color"
"1444","الحمرة من زينة الشيطان","","Majmu'a Da'eef Ahadith 1444","","","Satan loves red color"
"1445","ان الذى يحفض ويرفع قبل الامام انما ناصيته بيد الشيطان","","Majmu'a Da'eef Ahadith 1445","","","Forehead of one who precedes imam in Satan’s hand"
"1446","الاكل بأصبع واحدة أكل الشيطان وباثنين أكل الجبابرة وبالثلاث أكل الأنبياء","","Majmu'a Da'eef Ahadith 1446","","","Eating with one finger is Satanic"
"1447","البكاء من الرحمة والصراخ من الشيطان","","Majmu'a Da'eef Ahadith 1447","","","Screaming is from Satan"
"1448","التثاؤب الشديد والعطسة الشديدة من الشيطان","","Majmu'a Da'eef Ahadith 1448","","","Excessive yawning and sneezing from Satan"
"1449","القهقهة من الشيطان والتبسم من الله","","Majmu'a Da'eef Ahadith 1449","","","Loud laughter is from Satan"
"1450","ما احتلم نبي قط انما الاحتلام من الشيطان","","Majmu'a Da'eef Ahadith 1450","","","Nocturnal emission from Satan"
"1451","التسويف شعار الشيطان يلقيه فى قلوب المؤمنين","","Majmu'a Da'eef Ahadith 1451","","","Procrastination is Satan’s habit"
"1452","الصلاة تسود وجه الشيطان","","Majmu'a Da'eef Ahadith 1452","","","Satan’s face blackened by prayer"
"1453","اخزن لسانك الا من خير فانك بذالك تغلب الشيطان","","Majmu'a Da'eef Ahadith 1453","","","Way to overcome Satan"
"1454","عليكم بقلة الكلام ولا يستهوينكم الشيطان","","Majmu'a Da'eef Ahadith 1454","","","Avoiding Satan’s deception by less talk"
"1455","العين حق يحضرها الشيطان وحسد ابن آدم","","Majmu'a Da'eef Ahadith 1455","","","Evil eye and envy from Satan"
"1456","لن يزال العبد فى فسحة من دينه ما لم يشرب الخمر ، فاذا شربها خرق الله عنه ستره وكان الشيطان وليه وسمعه وبصره ورجله يسوقه الي كل شر ويصرفه عن كل خير","","Majmu'a Da'eef Ahadith 1456","","","Satan is guardian of the drinker"
"1457","نهي عن العب نفسا واحدا وقال : ذالك شرب الشيطان","","Majmu'a Da'eef Ahadith 1457","","","Drinking all water at once is Satanic"
"1458","والله ما زال الشيطان يأكل معه حتي سمي . . .","","Majmu'a Da'eef Ahadith 1458","","","Satan eats with one who omits Bismillah"
"1459","كل دار فيها ديك أبيض لا يقربها الشيطان ولا ساحر","","Majmu'a Da'eef Ahadith 1459","","","Protection from Satan through white rooster"
"1460","خللوا لحاكم وأظفاركم ، ان الشيطان يجري ما بين اللحم والظفر","","Majmu'a Da'eef Ahadith 1460","","","Satan runs between meat and nail"
"1461","لما أخذ جعفر بن أبى طالب الراية جاءه الشيطان فمناه الحياة الدنيا . . .","","Majmu'a Da'eef Ahadith 1461","","","Satan tried to mislead Ja’far"
"1462","ان للشيطان مصالي وفخوخا وان مصالي الشيطان وفخوخه ، البطر بأنعم الله ، والفخر باعطاء الله والكبر على عباد الله . . .","","Majmu'a Da'eef Ahadith 1462","","","Satan’s traps and Dajjal"
"1463","فضل العالم على العابد سبعين درجة . . . وذلك ان الشيطان يضع البدعة للناس فيعرفها العالم فينهي عنها . . .","","Majmu'a Da'eef Ahadith 1463","","","Satan invents innovations"
"1464","نهي أن تترك القمامة فى الحجرة فانها مجلس الشيطان","","Majmu'a Da'eef Ahadith 1464","","","Garbage is Satan’s seat"
"1465","من سره أن لا يجد الشيطان عنده طعاما ولا مقيلا فليسلم اذا دخل بيته وليسم على طعامه","","Majmu'a Da'eef Ahadith 1465","","","Avoiding Satan at meals and siesta"
"1466","اذا نام ابن آدم قال الملك للشيطان : أعطني صحيفتك فيعطيه . . .","","Majmu'a Da'eef Ahadith 1466","","","Erasing evils from Satan’s scroll"
"1467","سوء الخلق زمام من عذاب الله فى أنف صاحبه والزام بيد الشيطان والشيطان يجره الي الشر والشر يجره الي النار","","Majmu'a Da'eef Ahadith 1467","","","Bridle of ill-mannered in Satan’s hand"
"1468","لا تشربوا فى الثملة التى تكون فى القدح ، فان الشيطان يشرب من ذالك","","Majmu'a Da'eef Ahadith 1468","","","Satan drinks from broken part of vessel"
"1469","العنكبوت شيطان مسخه الله فاقتلوه","","Majmu'a Da'eef Ahadith 1469","","","Spider is Satan"
"1470","لا تقولوا قوس قزح ، فان قزح شيطان ولكن قولوا قوس الله","","Majmu'a Da'eef Ahadith 1470","","","Qazah is Satan’s name"
"1471","الحباب شيطان","","Majmu'a Da'eef Ahadith 1471","","","Habbab is Satan’s name"
"1472","ان شهاب اسم شيطان","","Majmu'a Da'eef Ahadith 1472","","","Shihab is Satan’s name"
"1473","فضلت على آدم بخصلتين : كان شيطاني كافرا فأعانني الله عليه حتي أسلم وكن أزواجي عونالي ، وكان شيطان آدم كافرا وكانت زوجته عونا على خطيئته","","Majmu'a Da'eef Ahadith 1473","","","Adam’s Satan was a disbeliever"
"1474","ما فى السماء ملك الا وهو يوقر عمر ولا فى الارض شيطان الا وهو يفرق من عمر","","Majmu'a Da'eef Ahadith 1474","","","Every Satan fears Umar"
"1475","ما قعد يتيم على قصعة قوم فيقرب قصعتهم شيطان","","Majmu'a Da'eef Ahadith 1475","","","Satan sits with orphan at bowl"
"1476","أنت اذا من اخوان الشيطان","","Majmu'a Da'eef Ahadith 1476","","","Unmarried despite ability is brother of devils"
"1477","ان الشيطان تغدو براياتها الي الاسواق فيدخلون مع أول داخل ويخرجون مع آخر خارج","","Majmu'a Da'eef Ahadith 1477","","","Devils in marketplaces"
"1478","ان لابليس مردة من الشيطان يقول لهم : عليكم بالحجاج والمجاهدين فأضلوهم عن السبيل","","Majmu'a Da'eef Ahadith 1478","","","Iblis commands rebellious devils"
"1479","فاذا دخلتم حجركم فسلموا ، يخرج ساكنها من الشيطان","","Majmu'a Da'eef Ahadith 1479","","","Devils flee when greeted entering rooms"
"1480","نوروا بيوتكم ما استطعتم ، فان البيت الذى يقرأ فيه القران ؛ يتسع على أهله ويكثر خيره وتحضره الملائكة وتهجره الشيطان . . .","","Majmu'a Da'eef Ahadith 1480","","","Devils flee house when Quran is recited"
"1481","ان لله شيطان فى البر ليس لهم على ما فى البحر سلطان و شياطين فى البحر ليس لهم ما فى البر سلطان . . .","","Majmu'a Da'eef Ahadith 1481","","","Sea and land devils"
"1482","اذا قام العبد الي صلاته قام معه سبعة شياطين","","Majmu'a Da'eef Ahadith 1482","","","Seven devils with the worshipper"
"1483","اذا ركبتم هذه الدواب فأعطوها حظها من المنازل ولا تكونوا عليها شياطين","","Majmu'a Da'eef Ahadith 1483","","","Not resting mounts is like being Satan"
"1484",". . . ويبعث الله معه شياطين تكلم الناس . . .","","Majmu'a Da'eef Ahadith 1484","","","Dajjal will have devils with him"
"1485","يا أبا ذر ! تعوذ بالله من شر شياطين الجن والانس ، قلت أو للانس شياطين ؟ قال : نعم","","Majmu'a Da'eef Ahadith 1485","","","Seeking refuge from human and jinn devils"
"1486","جاء ابليس الي النبى صلى الله عليه وسلم وهو فى المسجد مع جماعة من أصحابه و سأله عن اشياء كثيرة","","Majmu'a Da'eef Ahadith 1486","","","Satan’s questions to the Prophet"
"1487","موت عالم أحب الي ابليس من موت سبعين عابدا","","Majmu'a Da'eef Ahadith 1487","","","Scholar’s death pleases Iblis more than 70 worshippers"
"1488","نهي عن ذبائح الجن","","Majmu'a Da'eef Ahadith 1488","","","Prohibition of jinn sacrifices"
"1489","أتاني جبريل فقال : ان عفريتا من الجن يكيدك فاذا أويت الي فراشك فاقرأ آية الكرسي","","Majmu'a Da'eef Ahadith 1489","","","A rebellious jinn’s evil intent toward the Prophet"
"1490","اختصم عندي الجن المسلمون و الجن المشركون و سألوني أن أسكنهم فأسكنت المسلمين الجلس و أسكنت المشركين الغور","","Majmu'a Da'eef Ahadith 1490","","","Dispute between Muslim and polytheist jinn before Prophet"
"1491","أمسكوا انفسكم و أهليكم فى البيوت عند فورة العشاء الاولي فان فيها تعم الجن","","Majmu'a Da'eef Ahadith 1491","","","Jinn roam at dusk"
"1492","خلق الله عزوجل الجن ثلاثة أصناف : صنف حيات و عقارب و خشاش الأرض و صنف كالريح فى الهواء و صنف عليهم الحساب و العقاب","","Majmu'a Da'eef Ahadith 1492","","","Three types of jinn"
"1493","الغيلان سحرة الجن","","Majmu'a Da'eef Ahadith 1493","","","Ghilan are jinn magicians"
"1494","ما من شيء الا يعلم أني رسول الله الا كفرة الجن و الانس","","Majmu'a Da'eef Ahadith 1494","","","All but disbelieving jinn and humans know Prophet’s message"
"1495","الطاعون وخز اخوانكم من الجن","","Majmu'a Da'eef Ahadith 1495","","","Plague is jinn’s blow"
"1496","الخبث سبعون جزء فجزء فى الجن والانس وتسع وستون فى البرير","","Majmu'a Da'eef Ahadith 1496","","","Only a part of filth is in jinn and humans"
"1497","ان المرأة اذا خرجت من بيتها و زوجها كاره لذالك لعنها كل ملك فى السماء وكل شيء مرت عليه غير الجن والانس حتي ترجع","","Majmu'a Da'eef Ahadith 1497","","","Woman leaving without permission cursed by all but jinn and humans"
"1498","لو أن الانس والجن والشيطان والملائكه منذ خلقوا الي يوم القيامة صفوا صفا واحدا ما احاطوا بالله أبدا","","Majmu'a Da'eef Ahadith 1498","","","All jinn, devils, and angels cannot encompass Allah"
"1499","أتدرون ما خرافة ؟ ان خرافة كان رجلا من بني عذرة ، أسرته الجن ، فمكث فيهم دهرا طويلا . . .","","Majmu'a Da'eef Ahadith 1499","","","Jinn imprisoned a man"
"1500","الجن لا تخبل أحدا بيته عتيق من الخيل","","Majmu'a Da'eef Ahadith 1500","","","Good horse at home protects from jinn"
"1501","ما من عبد يدخل الجنة الا جلس عند رأسه وعند رجليه ثنتان من الحور العين يغنيانه بأحسن صوت سمعته الجن والانس","{ «ضعیف جدا» } : [السلسلة الضعيفة 5028]","Majmu'a Da'eef Ahadith 1501","","","Jinn and humans will hear houris’ singing"
"1502","لا تقوم الساعة حتي تكثر فيكم أولاد الجن من نسائكم . . .","{ «منكر جدا» } : [السلسلة الضعيفة 5776]","Majmu'a Da'eef Ahadith 1502","","","Jinn offspring among humans"
"1503",". . . فهذه الكلاب السود هي من الجن","{ «ضعیف جدا» } : [السلسلة الضعيفة 6049]","Majmu'a Da'eef Ahadith 1503","","","Black dogs are jinn"
"1504","ان مؤمني الجن لهم ثواب و عليهم عقاب . . .","{ «موضوع» } : [السلسلة الضعيفة 6113]","Majmu'a Da'eef Ahadith 1504","","","Believing jinn get reward and punishment"
"1505","يا عم ان الله قد عصمني من الجن والانس","","Majmu'a Da'eef Ahadith 1505","","","Prophet protected from evil of jinn and humans"
"1506","نهي عن نكاح الجن","{ «منكر» } : [السلسلة الضعيفة 6559]","Majmu'a Da'eef Ahadith 1506","","","Marriage with jinn is forbidden"
"1507","شياطين الانس تغلب شياطين الجن","","Majmu'a Da'eef Ahadith 1507","","","Human devils overpower jinn devils"
"1508","في كتاب اللي ثماني آيات للعين ، لا يقرأها عبد فى دار فيصيبهم ذالك اليوم عين انس أو جن : فاتحة الكتاب سبع آيات وآية الكرسي آية","","Majmu'a Da'eef Ahadith 1508","","","How to avoid evil eye of jinn"
