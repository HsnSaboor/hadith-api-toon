hadiths[25]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3425","«ذاق طعم الإيمان من رضي بالله ربا وبالإسلام دينا وبمحمد رسولا»","صحيح","Sahih al-Jami al-Saghir 3425","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3426","«ذبوا عن أعراضكم بأموالكم»","صحيح","Sahih al-Jami al-Saghir 3426","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3427","«ذبح الرجل أن تزكيه في وجهه»","صحيح","Sahih al-Jami al-Saghir 3427","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3428","«ذراري المسلمين يكفلهم إبراهيم»","صحيح","Sahih al-Jami al-Saghir 3428","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3429","«ذر الناس يعملون فإن الجنة مائة درجة ما بين كل درجتين كما بين السماء والأرض والفردوس أعلاها درجة وأوسطها وفوقها عرش الرحمن ومنها تفجر أنهار الجنة فإذا سألتم الله فاسألوه الفردوس»","صحيح","Sahih al-Jami al-Saghir 3429","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3430","ذروني ما تركتكم فإنما هلك من كان قبلكم بكثرة سؤالهم واختلافهم على أنبيائهم فإذا أمرتكم بشيء فأتوا منه ما استطعتم وإذا نهيتكم عن شيء فدعوه","صحيح","Sahih al-Jami al-Saghir 3430","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3431","«ذكاة الجنين ذكاة أمه»","صحيح","Sahih al-Jami al-Saghir 3431","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3432","«ذكاة الميتة دباغها»","صحيح","Sahih al-Jami al-Saghir 3432","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3433","«ذكاة كل مسك دباغه»","صحيح","Sahih al-Jami al-Saghir 3433","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3434","«ذكرت وأنا في الصلاة تبرا عندنا فكرهت أن يبيت عندنا فأمرت بقسمته»","صحيح","Sahih al-Jami al-Saghir 3434","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3435","«ذمة المسلمين واحدة فإن جارت عليهم جائرة فلا تخفروها فإن لكل غادر لواء يعرف به يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 3435","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3436","«ذهب المفطرون اليوم بالأجر»","صحيح","Sahih al-Jami al-Saghir 3436","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3437","«ذهب أهل الهجرة بما فيها»","صحيح","Sahih al-Jami al-Saghir 3437","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3438","ذهبت النبوة فلا نبوة بعدي إلا المبشرات: الرؤيا الصالحة يراها الرجل أو ترى له","حسن","Sahih al-Jami al-Saghir 3438","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3439","«ذهبت النبوة وبقيت المبشرات»","صحيح","Sahih al-Jami al-Saghir 3439","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3440","«ذيل المرأة شبر»","صحيح","Sahih al-Jami al-Saghir 3440","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3441","«ذيلك ذراع»","صحيح","Sahih al-Jami al-Saghir 3441","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3442","«الذباب كله في النار إلا النحل»","صحيح","Sahih al-Jami al-Saghir 3442","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3443","«الذهب بالذهب تبره وعينه والفضة بالفضة تبرها وعينها والبر بالبر مدين بمدين والشعير بالشعير مدين بمدين والتمر بالتمر مدين بمدين والملح بالملح مدين بمدين فمن زاد أو ازداد فقد أربى ولا بأس ببيع الذهب بالفضة والفضة أكثرهما يدا بيد وأما نسيئة فلا ولا بأس ببيع البر بالشعير والشعير أكثرهما يدا بيد وأما نسيئة فلا»","صحيح","Sahih al-Jami al-Saghir 3443","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3444","«الذهب بالذهب مثلا بمثل والفضة بالفضة مثلا بمثل والتمر بالتمر مثلا بمثل والبر بالبر مثلا بمثل والملح بالملح مثلا بمثل والشعير بالشعير مثلا بمثل فمن زاد أو ازداد فقد أربى بيعوا الذهب بالفضة كيف شئتم يدا بيد وبيعوا الشعير بالتمر كيف شئتم يدا بيد»","صحيح","Sahih al-Jami al-Saghir 3444","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3445","«الذهب بالذهب والفضة بالفضة والبر بالبر والشعير بالشعير والتمر بالتمر والملح بالملح مثلا بمثل سواء بسواء يدا بيد فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يدا بيد»","صحيح","Sahih al-Jami al-Saghir 3445","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3446","«الذهب بالذهب والفضة بالفضة والبر بالبر والشعير بالشعير والتمر بالتمر والملح بالملح مثلا بمثل يدا بيد فمن زاد أو استزاد فقد أربى والآخذ والمعطي سواء»","صحيح","Sahih al-Jami al-Saghir 3446","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3447","«الذهب بالذهب وزنا بوزن مثلا بمثل والفضة بالفضة وزنا بوزن مثلا بمثل فمن زاد أو استزاد فهو ربا»","صحيح","Sahih al-Jami al-Saghir 3447","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3448","«الذهب بالورق ربا إلا هاء وهاء والبر بالبر ربا إلا هاء وهاء والتمر بالتمر ربا إلا هاء وهاء والشعير بالشعير ربا إلا هاء وهاء»","صحيح","Sahih al-Jami al-Saghir 3448","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
"3449","«الذهب والحرير حل لإناث أمتي وحرام على ذكورها»","صحيح","Sahih al-Jami al-Saghir 3449","","","الأحاديث المبدوءة بحرف الذال Hadith Beginning with the Letter Dhal (ذ)"
