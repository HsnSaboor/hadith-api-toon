hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"16033","(۱۶۰۳۳) حَدَّثَنَا أبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْمُرَقِّعِ ، عَنْ أَبِی ذَرٍّ قَالَ لَیْسَ لأَحَدٍ أَنْ یُہِلَّ بِالْحَجِّ ثُمَّ یَجْعَلُہَا عُمْرَۃً إلا لِلرَّکْبِ الَّذِینَ کَانُوا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Hasan","Musannaf Ibn Abi Shaybah 16033","","","كتاب الحج"
"16034","(۱۶۰۳۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ ابْنُ الزُّبَیْرِ : أَفْرِدُوا الْحَجَّ وَدَعُوا قَوْلَ أَعْمَاکُمْ ہَذَا ، فَبَلَغَ ذَلِکَ ابْنَ عَبَّاسٍ ، فَقَالَ : إنَّ الَّذِی عَمَی اللَّہُ قَلْبَہُ وَعَیْنَیْہِ لأَنْتَ ، أَلاَ تَسْأَلُ أُمَّکَ فَسَأَلَہَا ، فَقَالَتْ: قَدِمْنَا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حُجَّاجًا فَأَمَرَنَا فَأَحْلَلْنَا الْحَلاَلَ کُلَّہُ حَتَّی تَسَطَّعَتِ الْمَجَامِرُ بَیْنَ الرِّجَالِ وَالنِّسَائِ۔ (احمد ۶/۳۴۴۔ طبرانی ۲۴۴)","Da'if","Musannaf Ibn Abi Shaybah 16034","","","كتاب الحج"
"16035","(۱۶۰۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا عَبْدُ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ فِی حَمَامِ الْحَرَامِ : إذَا خَرَجْنَ مِنَ الْحَرَمِ فَصِدْہُنَّ إِنْ شِئْت۔","","Musannaf Ibn Abi Shaybah 16035","","","كتاب الحج"
"16036","(۱۶۰۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا بِصَیْدِ حَمَامِ الْحَرَمِ إذَا خَرَجْنَ مِنَ الْحَرَمِ۔","","Musannaf Ibn Abi Shaybah 16036","","","كتاب الحج"
"16037","(۱۶۰۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، قَالاَ فِی الرَّجُلِ طَافَ ، ثَمَانیَۃَ أَشْوَاطٍ ، قَالَ : إِنْ ذَکَرَہَا قَبْلَ أَنْ یُصَلِّیَ رَکْعَتَیْنِ طَافَ سِتَّۃَ أَطْوَافٍ ، وَصَلَّی أَرْبَعَ رَکَعَاتٍ ، وَإِنْ ذَکَرَ بَعْدَ مَا یُصَلِّی رَکْعَتَیْنِ ، طَافَ سِتَّۃَ أَطْوَافٍ ، ثُمَّ صَلَّی رَکْعَتَیْنِ ، وَإِنْ شَائَ لَمْ یَعُتَدْ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16037","","","كتاب الحج"
"16038","(۱۶۰۳۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا طَافَ بِالْبَیْتِ ، ثَمَانیَۃَ أَشْوَاطٍ صَلَّی رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16038","","","كتاب الحج"
"16039","(۱۶۰۳۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ السُّلَمِیِّ ، قَالَ : سُئِلَ سَعِیدُ بْنُ جُبَیْرٍ ، عَنِ التَمْرِ لِلْمُحْرِمِ ، فَقَالَ : وَمَا بَأْسُہُ ؟ قَالَ فِیہِ الدواب ، قَالَ : فَکُلِ التَّمْر ، وَلاَ تَأْکُلِ الدَّوَابَّ۔","","Musannaf Ibn Abi Shaybah 16039","","","كتاب الحج"
"16040","(۱۶۰۴۰) حَدَّثَنَا حَفْصُ بْن غِیَاثٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنِ الْحَکَمِ وَحَمَّادٍ فِی الْمُحْرِمِ یَتَوَشَّحُ ، کَرِہَہُ أَحَدُہُمَا وَلَمْ یَرَ الآخَرُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 16040","","","كتاب الحج"
"16041","(۱۶۰۴۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ سُئِلَ عَنْ رَجُلٍ طَافَ سِتًّا وَصَلَّی رَکْعَتَیْنِ ؟ قَالَ : یَطُوفُ طَوَافًا آخَرَ وَیُصَلِّی رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16041","","","كتاب الحج"
"16042","(۱۶۰۴۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ بِشْرِ بْنِ مَنْصُورٍ ، عَنْ شُعَیْبٍ ، قَالَ : سُئِلَ الْحَسَنُ ، عَنْ رَجُلٍ طَافَ سِتًّا ؟ قَالَ: یَطُوفُ طَوَافًا آخَرَ۔","","Musannaf Ibn Abi Shaybah 16042","","","كتاب الحج"
"16043","(۱۶۰۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدٍ الْمُکْتِبِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا اسْتَلَمْت الْحَجَرَ فَقُلْ : لاَ إلَہَ إِلاَّ اللَّہُ وَاللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 16043","","","كتاب الحج"
"16044","(۱۶۰۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ وَہْبِ بْنِ وَہْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ ، أَنَّہُ کَانَ یَقُولُ إذَا اسْتَلَمَ : آمَنْتُ بِاَللَّہِ وَکَفَرْتُ بِالطَّاغُوتِ۔","","Musannaf Ibn Abi Shaybah 16044","","","كتاب الحج"
"16045","(۱۶۰۴۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ عَلِیٌّ إذَا اسْتَلَمَ الْحَجَرَ یَقُولُ : اللَّہُمَّ تَصْدِیقًا بِکِتَابِکَ وَسُنَّۃِ نَبِیِّک۔","","Musannaf Ibn Abi Shaybah 16045","","","كتاب الحج"
"16046","(۱۶۰۴۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْمَسْعُودِیِّ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ مِثْلَ حَدِیثِ وَکِیعٍ ، عَنِ الْمَسْعُودِیِّ۔","Da'if","Musannaf Ibn Abi Shaybah 16046","","","كتاب الحج"
"16047","(۱۶۰۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ کَثِیرِ بْنِ شِنْظِیرٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا اسْتَلَمْت الْحَجَرَ فَقَبِّلْ یَدَیْک ، وَلاَ تُصَوِّتْ بِالْقُبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 16047","","","كتاب الحج"
"16048","(۱۶۰۴۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، أَنَّہُ کَانَ یَسْتَحِبُّ أَنْ لاَ یَکُونَ تَحْتَ الْجَوَالِیقِین شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 16048","","","كتاب الحج"
"16049","(۱۶۰۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ خَالِدٍ الأَعْوَرِ ، قَالَ : خَالَفَنِی ذَرٌّ الْہَمْدَانِیُّ فِی الْحَجِّ عَلَی الْمَحْمِلِ وَالْقَتَبِ أَیُّہُمَا أَفْضَلُ ؟ قَالَ ذَرٌّ : الْمَحْمِلُ ، قَالَ : فَسَأَلْت إبْرَاہِیمَ ، فَقَالَ : الْقَتَبُ۔","","Musannaf Ibn Abi Shaybah 16049","","","كتاب الحج"
"16050","(۱۶۰۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْحَاقُ بْنُ سَعِیدٍ الْقُرَشِیُّ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ رَأَی رُفْقَۃً مِنْ أَہْلِ الْیَمَنِ ، رِحَالُہُمَ الأَدَم ، فَقَالَ : مَنْ أَحَبَّ أَنْ یَنْظُرَ إلَی أَشْبَہِ رُفْقَۃٍ بِأَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلْیَنْظُرْ إلَی ہَؤُلاَئِ۔","Sahih","Musannaf Ibn Abi Shaybah 16050","","","كتاب الحج"
"16051","(۱۶۰۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَحُجُّ عَلَی رَحْلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 16051","","","كتاب الحج"
"16052","(۱۶۰۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ: حَجُّ الأَبْرَارِ عَلَی الرِّحَالِ۔","","Musannaf Ibn Abi Shaybah 16052","","","كتاب الحج"
"16053","(۱۶۰۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا رَبِیعٌ ، عَنْ یَزِیدَ بْنِ أَبَانَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : حَجَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی رَحْلٍ وَقَطِیفَۃٍ تَسْوی ، أَوْ قَالَ : لاَ تَسْوی إِلاَّ أَرْبَعَۃِ دَرَاہِمَ ، ثُمَّ قَالَ : اللَّہُمَّ حَجَّۃٌ لاَ رِیَائَ فِیہَا ، وَلاَ سُمْعَۃَ۔ (ترمذی ۳۳۴۔ ابن ماجہ ۲۸۹۰)","Da'if","Musannaf Ibn Abi Shaybah 16053","","","كتاب الحج"
"16054","(۱۶۰۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَجَّ عَلَی رَحْلٍ فَاہْتَزَّ ، وَقَالَ : مَرَّۃً : فَاجْتَنَحَ ، فَقَالَ : لَبَّیْکَ إنَّ الْعَیْشَ عَیْشُ الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 16054","","","كتاب الحج"
"16055","(۱۶۰۵۵) حَدَّثَنَا قُرَّۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ یُکْرَہُ الْحَجُّ عَلَی الْمَحْمِلِ فَیَقُولُ : إنَّمَا کَانَ النَّاسُ یَحُجُّونَ عَلَی الأَقْتَابِ وَالرِّحَالِ۔","","Musannaf Ibn Abi Shaybah 16055","","","كتاب الحج"
"16056","(۱۶۰۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا وَدَّعَ فَلاَ یَعْمَلُ عَمَلاً حَتَّی یَخْرُجَ إلَی الأَبْطَحِ ، فَإِذَا خَرَجَ إلَی الأَبْطَحِ ، قَالَ : لاَ بَأْسَ أَنْ یُقِیمَ۔","","Musannaf Ibn Abi Shaybah 16056","","","كتاب الحج"
"16057","(۱۶۰۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ یَزِیدَ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی مُغِیثٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ وَدَّعَ ، فَأَتَی رَجُلٌ مِنْ قُرَیْشٍ فَعَادَہُ ، فَأَعَادَ الْوَدَاعَ۔","","Musannaf Ibn Abi Shaybah 16057","","","كتاب الحج"
"16058","(۱۶۰۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ لَمْ یَکُنْ یُسَمِّیہِ ، عَنْ عُمَرَ بْنِ عبْدِ الْعَزِیزِ ، أَنَّہُ وَدَّعَ ، فَکَتَبَ کِتَابًا فَأَعَادَ الْوَدَاعَ۔","","Musannaf Ibn Abi Shaybah 16058","","","كتاب الحج"
"16059","(۱۶۰۵۹) حَدَّثَنَا حَکَّامٌ الرَّازِیّ ، قَالَ : سَمِعْتُ رَجُلاً سَأَلَ حُمَیْدًا مَا کَانَ قَوْلُ الْحَسَن ، أَوْ رَأَیُ الْحَسَن فِی الرَّجُلِ إذَا وَدَّعَ ؟ قَالَ : کَانَ لاَ یَرَی بَأْسًا إذَا عَرَضَ لَہُ الشَّیئُ أَنْ یَشْتَرِیَہُ۔","","Musannaf Ibn Abi Shaybah 16059","","","كتاب الحج"
"16060","(۱۶۰۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، أَنَّ أَبَا قِلاَبَۃَ ، لَقِیَ رَجُلاً قَدِمَ مِنَ الْعُمْرَۃِ ، فَقَالَ : بَرَّ الْعَمَلُ ، بَرَّ الْعَمَلُ۔","","Musannaf Ibn Abi Shaybah 16060","","","كتاب الحج"
"16061","(۱۶۰۶۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مَالِکٍ ، قَالَ : لَقِیَ طَلْحَۃُ حَمَّادًا ، فَقَالَ : بَرَّ نُسُکُکَ۔","","Musannaf Ibn Abi Shaybah 16061","","","كتاب الحج"
"16062","(۱۶۰۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَمَّنْ سَمِعَ ابْنَ عُمَرَ یَقُولُ لِلْحَاجِّ إذَا قَدِمَ : تَقَبَّلَ اللَّہُ نُسُکَک ، وَأَعْظَمَ أَجْرَک ، وَأَخْلَفَ نَفَقَتَک۔","Da'if","Musannaf Ibn Abi Shaybah 16062","","","كتاب الحج"
"16063","(۱۶۰۶۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ یَحْیَی بْنِ عُبَیْدٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ السَّائِبِ ، قَالَ: سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ بَیْنَ الرُّکْنِ وَالْحَجَرِ : {رَبَّنَا آتِنَا فِی الدُّنْیَا حَسَنَۃً وَفِی الآخِرَۃِ حَسَنَۃً وَقِنَا عَذَابَ النَّارِ}۔ (ابوداؤد ۱۸۸۷۔ احمد ۳/۴۱۱)","Da'if","Musannaf Ibn Abi Shaybah 16063","","","كتاب الحج"
"16064","(۱۶۰۶۴) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: کَانَ مِنْ دُعَائِ ابْنِ عَبَّاسٍ الَّذِی لاَ یَدَعُ بَیْنَ الرُّکْنِ وَالْمَقَامِ أَنْ یَقُولَ: رَبِّ قَنِّعْنِی بِمَا رَزَقْتنِی ، وَبَارِکْ لی فِیہِ ، وَاخْلُفْ عَلَی کُلَّ غَائِبَۃٍ لِی بِخَیْرٍ۔n(ابن خزیمۃ ۲۷۲۸)","Da'if","Musannaf Ibn Abi Shaybah 16064","","","كتاب الحج"
"16065","(۱۶۰۶۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَجُوزٍ مِنْ أَہْلِ مَکَّۃَ ، قَالَتْ : قدْ أُصِیبَ ابْنُ عَفَّانَ وَأَنَا ابْنَۃُ أَرْبَعَ عَشْرَۃَ سَنَۃً ، قَالَتْ : وَلَقَدْ رَأَیْت الْبَیْتَ ، وَمَا عَلَیْہِ کِسْوَۃٌ ، إِلاَّ مَا یَکْسُوہُ النَّاسُ الْکِسَائُ الأَحْمَر یُطْرَحُ عَلَیْہِ ، وَالثَّوْبُ الأَبْیَضُ ، وَالْکِسَائُ الصُّوفُ ، وَمَا کُسِیَ مِنْ شَیْئٍ عُلِّقَ عَلَیْہِ ، وَلَقَدْ رَأَیْتُہُ ، وَمَا عَلَیْہِ ذَہَبٌ ، وَلاَ فِضَّۃٌ ، قَالَ مُحَمَّدٌ : إنَّ الْبَیْتَ لَمْ یَکُنْ یُکْسَی عَلَی عَہْدِ أَبِی بَکْرٍ ، وَلاَ عُمَرَ ، وَإِنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَساہُ الْوَصَائِلَ وَالْقَبَاطِیَّ ، وَالْوَصَائِلُ ثِیَابٌ یَمَانِیَّۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 16065","","","كتاب الحج"
"16066","(۱۶۰۶۶) حَدَّثَنَا سُرَیْجُ بْنُ النُّعْمَانِ ، قَالَ : حدَّثَنَا فُلَیْحٌ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یُجَلِّلُ بُدْنَہُ قَبْلَ أَنْ تُکْسَی الْکَعْبَۃُ الجَلَل وَالأَنْمَاطَ وَالْقَبَاطِیَّ ، ثُمَّ یَنْزِعُہَا قَبْلَ أَنْ یَنْحَرَہَا فَیُرْسِلُ بِہَا إلَی خَزَنَۃِ الْکَعْبَۃِ کِسْوَۃَ لِلْکَعْبَۃِ ، فَلَمَّا کُسِیَتِ الْکَعْبَۃُ تَرَکَ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 16066","","","كتاب الحج"
"16067","(۱۶۰۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، قَالَ : کَانَ کِسْوَۃُ الْکَعْبَۃِ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الأَنْطَاعَ وَالْمُسُوحَ۔","","Musannaf Ibn Abi Shaybah 16067","","","كتاب الحج"
"16068","(۱۶۰۶۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا إذَا أَتَوُا الْمَرِیضَ لَمْ یَحُجَّ أَمَرُوہُ أَنْ یَنْحَرَ بَدَنَہُ۔","","Musannaf Ibn Abi Shaybah 16068","","","كتاب الحج"
"16069","(۱۶۰۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إذَا لَمْ یَکُنْ حَجَّ أَنْ یُوصِیَ بِہَدْیٍ۔","","Musannaf Ibn Abi Shaybah 16069","","","كتاب الحج"
"16070","(۱۶۰۷۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی رَکْعَتَیِ الطَّوَافِ(قُلْ یَا أَیُّہَا الْکَافِرُونَ) وَ(قُلْ ہُوَ اللَّہُ أَحَدٌ) ۔ (ترمذی ۸۶۹۔ احمد ۳/۳۲۰)","","Musannaf Ibn Abi Shaybah 16070","","","كتاب الحج"
"16071","(۱۶۰۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ یَعْقُوبَ بْنِ زَیْدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَأَ فِی رَکْعَتَیِ الطَّوَافِ (قُلْ یَا أَیُّہَا الْکَافِرُونَ) وَ(قُلْ ہُوَ اللَّہُ أَحَدٌ)۔","Da'if","Musannaf Ibn Abi Shaybah 16071","","","كتاب الحج"
"16072","(۱۶۰۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ فِی الْمُحْرِمِ یُصِیبُ الْقِرْدَ ، قَالَ : یُحْکَمُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16072","","","كتاب الحج"
"16073","(۱۶۰۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ مَکَّۃَ مِنْ ثَنِیَّۃِ الْعُلْیَا۔","Da'if","Musannaf Ibn Abi Shaybah 16073","","","كتاب الحج"
"16074","(۱۶۰۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : مَا أُبَالِی لَوْ دَخَلْت مِنْ أَسْفَلِ مَکَّۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 16074","","","كتاب الحج"
"16075","(۱۶۰۷۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَدْخُلُ مِنَ الثَّنِیَّۃِ الْعُلْیَا وَیَخْرُجُ مِنَ الثَّنِیَّۃِ السُّفْلَی۔ (بخاری ۱۵۷۶۔ مسلم ۹۱۸)","Da'if","Musannaf Ibn Abi Shaybah 16075","","","كتاب الحج"
"16076","(۱۶۰۷۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کان إذَا خَرَجَ خَرَجَ مِنْ طَرِیقٍ بِالشَّجَرَۃِ ، وَإِذَا دَخَلَ دَخَلَ مِنْ طَرِیقِ الْمُعَرَّسِ ، وَإِذَا دَخَلَ مَکَّۃَ دَخَلَ مِنَ الثَّنِیَّۃِ الْعُلْیَا ، وَإِذَا خَرَجَ خَرَجَ مِنَ الثَّنِیَّۃِ السُّفْلَی۔ (بخاری ۱۵۳۳۔ مسلم ۹۱۸)","Sahih","Musannaf Ibn Abi Shaybah 16076","","","كتاب الحج"
"16077","(۱۶۰۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ نَصْرِ بْنِ عَدِیٍّ ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ : إنَّمَا سُمِّیَ الْبَیْتُ الْعَتِیقُ لأَنَّہُ أُعْتِقَ مِنَ الْجَبَابِرَۃِ ، فَلَیْسَ جَبَّارٌ یَدَّعِی أَنَّہُ لَہُ۔","","Musannaf Ibn Abi Shaybah 16077","","","كتاب الحج"
"16078","(۱۶۰۷۸) حَدَّثَنَا وَکِیعٌ ، وَغُنْدَرٌ وَشُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ عِکْرِمَۃَ ، وَعَطَائٍ ، وَطَاوُوس : {فَاجْعَلْ أَفْئِدَۃً مِنَ النَّاسِ تَہْوِی إلَیْہِمْ} قَالُوا : تَہْوِی إلَیْہِ قُلُوبُہُمْ یَأْتُونَہُ یَعْنِی الْبَیْتَ۔","","Musannaf Ibn Abi Shaybah 16078","","","كتاب الحج"
"16079","(۱۶۰۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی الْہَیْثَمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : {جَعَلَ اللَّہُ الْکَعْبَۃَ الْبَیْتَ الْحَرَامَ قِیَامًا لِلنَّاسِ} قَالَ : شِدَّۃً لِدِینِہِمْ۔","","Musannaf Ibn Abi Shaybah 16079","","","كتاب الحج"
"16080","(۱۶۰۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إنَّمَا سُمِّیَتِ الْکَعْبَۃُ لأَنَّہَا مُرَبَّعَۃٌ ، وَإِنَّمَا سُمِّیَتِ الْبُدْنُ مِنْ أَجْلِ السَّمَّانَۃِ۔","","Musannaf Ibn Abi Shaybah 16080","","","كتاب الحج"
"16081","(۱۶۰۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سفیان ، عَنْ غَالِبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : {وَإِذْ جَعَلْنَا الْبَیْتَ مَثَابَۃً لِلنَّاسِ} قَالَ: یَحُجُّونَ ، ثُمَّ یَعُودُونَ۔","","Musannaf Ibn Abi Shaybah 16081","","","كتاب الحج"
"16082","(۱۶۰۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ عَطَائٍ ، قَالَ : یَحُجُّونَہُ ، وَلاَ یَقْضُونَ مِنْہُ وَطَرًا۔","","Musannaf Ibn Abi Shaybah 16082","","","كتاب الحج"
"16083","(۱۶۰۸۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَوْلا أَنَّہُ قَالَ : {فَاجْعَلْ أَفْئِدَۃً مِنَ النَّاسِ} لاَزْدَحَمَتْ عَلَیْہِ فَارِسٌ وَالرُومٌ۔","","Musannaf Ibn Abi Shaybah 16083","","","كتاب الحج"
"16084","(۱۶۰۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : إنَّمَا سُمِّیَتْ أَیَّامَ التَّشْرِیقِ إنَّہُمْ کَانُوا یَتَشَرَّقُونَ فِی الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 16084","","","كتاب الحج"
"16085","(۱۶۰۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَسْلَمَ الْمُنْقِرِیِّ ، قَالَ : قُلْتُ لِعَطَائٍ : أَخْرُجُ إلَی الْمَدِینَۃِ أُہِلُّ بِعُمْرَۃٍ مِنْ مِیقَاتِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : طَوَافُک بِالْبَیْتِ أَحَبُّ إلَیَّ مِنْ سَفَرِکَ إلَی الْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 16085","","","كتاب الحج"
"16086","(۱۶۰۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَمْرُو بْنُ ذَرٍّ ، عَنْ مُجَاہِدٍ ، قَالَ : طَوَافُک بِالْبَیْتِ أَحَبُّ إلَیَّ مِنْ سَفَرِکَ إلَی الْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 16086","","","كتاب الحج"
"16087","(۱۶۰۸۷) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ: الطَّوَافُ بِالْبَیْتِ أَحَبُّ إلَیَّ مِنَ الْخُرُوجِ إلَی الْعُمْرَۃِ۔","","Musannaf Ibn Abi Shaybah 16087","","","كتاب الحج"
"16088","(۱۶۰۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إنَّمَا سُمِّیَتِ الْمُتْعَۃَ لأَنَّہُمْ کَانُوا یَتَمَتَّعُونَ مِنَ النِّسَائِ وَالثِّیَابِ۔","","Musannaf Ibn Abi Shaybah 16088","","","كتاب الحج"
"16089","(۱۶۰۸۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَنْ رَجُلٍ ، قَالَ: رَأَیْتُ شَیْبَۃَ یَأْخُذُ مَا وَقَعَ مِنْ کِسْوَۃِ الْکَعْبَۃِ فَیَضَعُہَا فِی الْفُقَرَائِ ، قَالَ سُفْیَانُ : لاَ بَأْسَ بِشِرَائِہَا مِنَ الْفُقَرَائِ إذَا أَعْطَاہُمْ إیَّاہُ۔","","Musannaf Ibn Abi Shaybah 16089","","","كتاب الحج"
"16090","(۱۶۰۹۰) حَدَّثَنَا شَاذَانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الْحَکَمِ بْنِ عُتَیْبَۃَ ، قَالَ : کَانَ یُسْتَحَبُّ أو یستحب الْغُسْلُ أَیَّامَ التَّشْرِیقِ إذَا رَاحَ إلَی الْمَسْجِدِ ، أَوْ إلَی الْجِمَارِ۔","","Musannaf Ibn Abi Shaybah 16090","","","كتاب الحج"
"16091","(۱۶۰۹۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : سَمِعْتُ سُفْیَانَ سُئِلَ عَمَّنْ أَسْلَمَ فَحَجَّ ، ثُمَّ ارْتَدَّ ، ثُمَّ رَجَعَ إلَی الإِسْلاَمِ وَجَبَ عَلَیْہِ الْحَجُّ أَمْ تُجْزِئُہُ تِلْکَ الْحَجَّۃُ ؟ قَالَ : إذَا ارْتَدَّ ہَدَمَ الْکُفْرُ کُلَّ شَیْئٍ کَانَ قَبْلَہُ ، فَعَلَیْہِ أَنْ یَحُجَّ ، وَلاَ یَعْتَدَّ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16091","","","كتاب الحج"
"16092","(۱۶۰۹۲) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، وَعَطَائٍ ، وَطَاوُوس ، قَالَ : جَلِّلْ أَیَّ لَوْنٍ شِئْت۔","","Musannaf Ibn Abi Shaybah 16092","","","كتاب الحج"
"16093","(۱۶۰۹۳) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ جَلَّلَ بِنَمَطٍ۔","Hasan","Musannaf Ibn Abi Shaybah 16093","","","كتاب الحج"
"16094","(۱۶۰۹۴) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یُجَلِّلُ بَدْنَہُ تِلْکَ الْجِلاَلِ الْعَوَالِ۔","Sahih","Musannaf Ibn Abi Shaybah 16094","","","كتاب الحج"
"16095","(۱۶۰۹۵) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، أنَّ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ : جَلَّلَ بِالْحِبَر۔","Da'if","Musannaf Ibn Abi Shaybah 16095","","","كتاب الحج"
"16096","(۱۶۰۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، قَالَ : سَمِعْتُ الْحَسَنَ بْنَ مُسْلِمٍ سَأَلَ طَاوُوسًا ، عَنِ الْجُعَلِ وَالْوَزَغِ یَقْتُلُہُ الْمُحْرِمُ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16096","","","كتاب الحج"
"16097","(۱۶۰۹۷) حَدَّثَنَا وَکِیعٌ، عَنْ إبْرَاہِیمَ، قَالَ: سَأَلْتُ عَطَائً، عَنِ الْوَزَغِ یُقْتَلُ فِی الْحَرَمِ؟ فَقَالَ: إذَا آذَاک فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16097","","","كتاب الحج"
"16098","(۱۶۰۹۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : اُقْتُلُوا الْوَزَغَ فِی الْحِلِّ وَالْحَرَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 16098","","","كتاب الحج"
"16099","(۱۶۰۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شِبْلِ بْنِ عَبَّادٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَرِہَ السِّجْنَ بِمَکَّۃَ ، قَالَ : لاَ یَنْبَغِی لِبَیْتِ عَذَابٍ أَنْ یَکُونَ فِی بَیْتِ رَحْمَۃٍ۔","","Musannaf Ibn Abi Shaybah 16099","","","كتاب الحج"
"16100","(۱۶۱۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَأَلْتُ سُفْیَانَ ، عَنْ رَجُلٍ نَسِیَ أَنْ یَطُوفَ الطَّوَافَ الْوَاجِبَ فَطَافَ طَوَافَ الصَّدَرِ، ثُمَّ نَفَرَ ؟ فَقَالَ : سُفْیَانُ : طَوَافُ الصَّدَرِ ہُوَ الْوَاجِبُ ، وَعَلَیْہِ دمٌ لِطَوَافِ الصَّدْرِ ، وَقَالَ : الْحَسَنُ بْنُ صَالِحٍ: لاَ یُجْزِئُہُ ، کَأَنَّہُ لَمْ یَطُفْ ، وَفِی قَارِنٍ قَدِمَ فَطَافَ لِلْحَجِّ قَبلَ العُمْرَۃَ قَالَ : یُجْعَل الطَّوَافَ الذِی طَافَہ للحَج ہُوَ لِلْعُمْرَۃِ وَعَلَیْہِ طَوَافُ الْحَجِّ ، وَقَالَ : الْحَسَنُ بْنُ صَالِحٍ : لاَ یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 16100","","","كتاب الحج"
"16101","(۱۶۱۰۱) سَمِعْتُ وَکِیعًا ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : إذَا اجْتَمَعَ عَلَیْہِ السَّہْوُ وَالتَّلْبِیَۃُ وَالتَّکْبِیرُ یَبْدَأُ بِالسَّہْوِ ، ثُمَّ التَّلْبِیَۃِ ، ثُمَّ التَّکْبِیرِ۔","","Musannaf Ibn Abi Shaybah 16101","","","كتاب الحج"
"16102","(۱۶۱۰۲) حَدَّثَنَا حَفْصُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ یَقُولُ : فِی الدَّجَاجَۃِ السَّنْدِیَّۃِ حُکُومَۃٌ۔","","Musannaf Ibn Abi Shaybah 16102","","","كتاب الحج"
"16103","(۱۶۱۰۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی الْمَمْلُوکِ یَتَمَتَّعُ ، قَالَ : یَذْبَحُ عَنْہُ مَوْلاَہُ شَاۃً۔","","Musannaf Ibn Abi Shaybah 16103","","","كتاب الحج"
"16104","(۱۶۱۰۴) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ، قَالَ: رَآنِی عَطَائٌ، وَطَاوُوس وَمُجَاہِدٌ وَأَنَا أَطُوفُ حَوْلَ الْمَقَامِ فَنَہَوْنِی۔","","Musannaf Ibn Abi Shaybah 16104","","","كتاب الحج"
"16105","(۱۶۱۰۵) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، عَنْ مُجَاہِدٍ ، قَالَ : رَأَیْتُہُ وَبِیَدِہِ سَعْفَۃٌ وَہُوَ یَطْرُدُ بِہَا حَمَامَ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 16105","","","كتاب الحج"
"16106","(۱۶۱۰۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ یُونُسَ بْنِ مِسْمَارٍ ، قَالَ : رَأَیْتُ عَطَائً فَذَکَرَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 16106","","","كتاب الحج"
"16107","(۱۶۱۰۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدِ الْمُکْتِبِ ، عَنْ مُجَاہِدٍ فِی الصَّیْدِ یُدْخَلُ بِہِ الْحَرَمَ فَیُذْبَحُ فِیہِ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16107","","","كتاب الحج"
"16108","(۱۶۱۰۸) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنْ عِکْرِمَۃَ ، قَالَ : یُکْتَبُ حَاجُّ بَیْتِ اللہِ فِی لَیْلَۃِ الْقَدْرِ بِأَسْمَائِہِمْ وَأَسْمَائِ آبَائِہِمْ ، فَمَا یُغَادَرُ مِنْہُمْ أَحَدٌ ، وَلاَ یُزَادُ فِیہِمْ أَحَدٌ۔","","Musannaf Ibn Abi Shaybah 16108","","","كتاب الحج"
"16109","(۱۶۱۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ بَأْسَ أَنْ یُلَبِّیَ الْجُنُبُ۔","","Musannaf Ibn Abi Shaybah 16109","","","كتاب الحج"
"16110","(۱۶۱۱۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ قَالَ : لَبِّ عَلَی کُلِّ حَالٍ۔","","Musannaf Ibn Abi Shaybah 16110","","","كتاب الحج"
"16111","(۱۶۱۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ أَنْ تُہْدَی الْبَدَنَۃُ ذَاتُ الدَّرِّ۔","","Musannaf Ibn Abi Shaybah 16111","","","كتاب الحج"
"16112","(۱۶۱۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : عَلَیْہِ الْجَزَائُ وَقِیمَۃُ مَا أَکَلَ إذَا أَعْطَی جَزَائً ، ثُمَّ أَکَلَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 16112","","","كتاب الحج"
"16113","(۱۶۱۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ طَارِقِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : سَمِعْتُ ابْنَ أَبِی أَوْفَی یُسْأَلُ ، عَنِ الرَّجُلِ یَسْتَقْرِضُ وَیَحُجُّ ؟ قَالَ : یَسْتَرْزِقُ اللَّہَ ، وَلاَ یَحُجُّ۔","Sahih","Musannaf Ibn Abi Shaybah 16113","","","كتاب الحج"
"16114","(۱۶۱۱۴) حَدَّثَنَا مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدَرِ ، أَنَّہُ کَانَ یَسْتَقْرِضُ وَیَحُجُّ ، فَقِیلَ لَہُ : تَسْتَقْرِضُ وَتَحُجُّ ؟ فَقَالَ : إنَّ الْحَجَّ أَقْضَی لِلدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 16114","","","كتاب الحج"
"16115","(۱۶۱۱۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَ[corrupt]ِ ابْنِ سُوقَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدَرِ ، قَالَ : الْحَجُّ أَقْضَی لِلدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 16115","","","كتاب الحج"
"16116","(۱۶۱۱۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، قَالَ : کَانَ الْحَکَمُ وَأَصْحَابُنَا یَقُولُونَ فِی الْمُحْرِمِ یَکُونُ بِہِ الْقُرُوحُ فِی جَسَدِہِ وَرَأْسِہِ فَیُدَاوِیہَا بِالطِّیبِ ؟ قَالُوا : فِیہِ کَفَّارَتَانِ ، کَفَّارَۃٌ فِی رَأْسِہِ وَکَفَّارَۃٌ فِی جَسَدِہِ۔","","Musannaf Ibn Abi Shaybah 16116","","","كتاب الحج"
"16117","(۱۶۱۱۷) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، قَالَ : عَلَیْہِ کَفَّارَۃٌ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 16117","","","كتاب الحج"
"16118","(۱۶۱۱۸) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عَلِیٌّ مَنِ اضْطُرَّ إلَی ثَوْبٍ وَہُوَ مُحْرِمٌ ، فَلَمْ یَکُنْ لَہُ إِلاَّ قَبَاء فَلْیُنَکِّسْہُ ، یَجْعَلُ أَعْلاَہُ أَسْفَلَہُ ، ثُمَّ لِیَلْبِسْہُ۔","","Musannaf Ibn Abi Shaybah 16118","","","كتاب الحج"
"16119","(۱۶۱۱۹) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَمُجَاہِدٍ ، قَالاَ : لاَ یُدْخِلُ الْمُحْرِمُ مَنْکِبَیْہِ فِی الْقَبَاء ، وَلاَ بَأْسَ أَنْ یَرْتَدِیَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16119","","","كتاب الحج"
"16120","(۱۶۱۲۰) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ ، قَالَ: لاَ یُدْخِلُ الْمُحْرِمُ مَنْکِبَیْہِ فِی الْقَبَائ، وَلاَ بَأْسَ أَنْ یَرْتَدِیَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16120","","","كتاب الحج"
"16121","(۱۶۱۲۱) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَلْبَسَ الْمُحْرِمُ الْقَبَائَ ، مَا لم یُدْخِل مَنْکِبَیْہِ فِیہِ۔","","Musannaf Ibn Abi Shaybah 16121","","","كتاب الحج"
"16122","(۱۶۱۲۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی مَسْلَمَۃَ ، قَالَ : سُئِلَ عِکْرِمَۃُ ، عَنْ مُحْرِمٍ لَبِسَ قَبَائً ، قَالَ : یَخْلَعُہُ۔","","Musannaf Ibn Abi Shaybah 16122","","","كتاب الحج"
"16123","(۱۶۱۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، عَنْ أَبِی سَلَمَۃَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ وَعَائِشَۃَ کَانَا إذَا قَدِمَا مَکَّۃَ لَمْ یَنْزِلاَ الْمَنْزِلَ الَّذِی ہَاجَرَا مِنْہُ۔","Hasan","Musannaf Ibn Abi Shaybah 16123","","","كتاب الحج"
"16124","(۱۶۱۲۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَکَرِیَّا ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ إذَا قَدِمَ مَکَّۃَ حَاجًّا کَرِہَ أَنْ یَنْزِلَ بَیْتَہُ الَّذِی ہَاجَرَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 16124","","","كتاب الحج"
"16125","(۱۶۱۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ طَیْسَلَۃَ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ نَزَلَ الأَرَاکَ بِعَرَفَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 16125","","","كتاب الحج"
"16126","(۱۶۱۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، عَنِ ابْنِ مَسْعُودٍ ، أَنَّہُ نَزَلَ الأَرَاکَ۔","Da'if","Musannaf Ibn Abi Shaybah 16126","","","كتاب الحج"
"16127","(۱۶۱۲۷) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ضُرِبَتْ لَہُ القُبَّۃُ بِنَمِرَۃَ فَجَائَ فَنَزَلَ۔","Sahih","Musannaf Ibn Abi Shaybah 16127","","","كتاب الحج"
"16128","(۱۶۱۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ نَزَلَ الْحِیَاضَ بِعَرَفَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 16128","","","كتاب الحج"
"16129","(۱۶۱۲۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی أَبُو مَوْدُودٍ ، قَالَ : حَدَّثَنِی یَزِیدُ بْنُ عَبْدِ اللہ بْنِ قُسَیْطٍ ، قَالَ : رَأَیْتُ نَفَرًا مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا خَلاَ لَہُمَ الْمَسْجِدُ قَامُوا إِلَی رُمَّانَۃِ الْمِنْبَرِ الْقَرْعَاء فَمَسَحُوہَا وَدَعَوَا ، قَالَ : وَرَأَیْت یَزِیدَ یَفْعَلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16129","","","كتاب الحج"
"16130","(۱۶۱۳۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ اللَّیْثِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ کَرِہَ أَنْ یَضَعَ یَدَہُ عَلَی الْمِنْبَرِ۔","","Musannaf Ibn Abi Shaybah 16130","","","كتاب الحج"
"16131","(۱۶۱۳۱) حَدَّثَنَا معَنْ بْنُ عِیسَی ، عَنْ ثَابِتِ بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ أَبَا بَکْرٍ إذَا رَقِیَ عَلَی الْمِنْبَرِ خَلَعَ نَعْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16131","","","كتاب الحج"
"16132","(۱۶۱۳۲) حَدَّثَنَا مَعْنِ بْنِ عِیسَی ، عَنْ ماَلِکَ ، قَالَ : سُئِلَ الزُہَرِی ہَلْ تُقَلِّد المَرْأَۃُ أَوْ تُشْعِرُ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16132","","","كتاب الحج"
"16133","(۱۶۱۳۳) حَدَّثَنَا معَنْ بْنُ عِیسَی ، عَنْ مُحَمَّدِ بْنِ ہِلاَلٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ إذَا رَقِیَ مِنْبَرَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَلَعَ نَعْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16133","","","كتاب الحج"
"16134","(۱۶۱۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مَہْدِیٍّ ، قَالَ : حدَّثَنِی شُعَیْبُ بْنُ الْحَبْحَابِ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : إنَّمَا جَعَلَ اللَّہُ ہَذِہِ الْمَنَاسِکَ لِیُکَفِّرَ بِہَا خَطَایَا بَنِی آدَمَ۔","","Musannaf Ibn Abi Shaybah 16134","","","كتاب الحج"
"16135","(۱۶۱۳۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: قُلْتُ لَہُ: کَیْفَ یَدْفَعُ الْمَاشِی؟ قَالَ: کَیْف تَیَسَّرَ۔","","Musannaf Ibn Abi Shaybah 16135","","","كتاب الحج"
"16136","(۱۶۱۳۶) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، أَنَّہُ کَرِہَ لِلْمُحْرِمِ إذَا مَرَّ بِرِیحٍ مُنْتِنَۃٍ أَنْ یَضَعَ ثَوْبَہُ عَلَی أَنْفِہِ یُمْسِکُہُ۔","","Musannaf Ibn Abi Shaybah 16136","","","كتاب الحج"
"16137","(۱۶۱۳۷) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16137","","","كتاب الحج"
"16138","(۱۶۱۳۸) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ، عَنْ إسْرَائِیلَ، عَنْ لَیْثٍ، عَنْ عَطَائٍ، وَطَاوُوس، وَمُجَاہِدٍ، قَالُوا: لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16138","","","كتاب الحج"
"16139","(۱۶۱۳۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : رَجُلٌ رَمَی الْعَقَبَۃَ ، وَلَمْ یَحْلِقْ أَیَحْلِقُ النَّاسُ ؟ قَالَ: نَعَمْ۔","","Musannaf Ibn Abi Shaybah 16139","","","كتاب الحج"
"16140","(۱۶۱۴۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَرِہَ أَنْ یَبِیعَ شَعَرَہُ إذَا حَلَقَہُ یَعْنِی الْمُحْرِمَ۔","","Musannaf Ibn Abi Shaybah 16140","","","كتاب الحج"
"16141","(۱۶۱۴۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ فِی کُلِّ ذَات کَرِشٍ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 16141","","","كتاب الحج"
"16142","(۱۶۱۴۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْحَسَنِ ، قَالَ فِی کُلِّ ذَاتِ کَرِشٍ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 16142","","","كتاب الحج"
"16143","(۱۶۱۴۳) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الْعَدَنِیِّ ، قَالَ : رَأَیْتُ مُحَمَّدَ بْنَ عَلِیٍّ یَرْمُلُ بَیْنَ الرُّکْنِ الْیَمَانِیِّ وَالْحَجَرِ وَہُوَ مُضْطَبِعٌ۔","","Musannaf Ibn Abi Shaybah 16143","","","كتاب الحج"
"16144","(۱۶۱۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ یَعْلَی ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَطُوفُ بِالْبَیْتِ مُضْطَبِعًا۔ (ابوداؤد ۱۸۷۸۔ احمد ۴/۲۲۳)","Da'if","Musannaf Ibn Abi Shaybah 16144","","","كتاب الحج"
"16145","(۱۶۱۴۵) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْحَمِیدِ ، عَنِ ابن یَعْلَی ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 16145","","","كتاب الحج"
"16146","(۱۶۱۴۶) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ طَافَ بِالْبَیْتِ مُضْطَبِعًا۔","","Musannaf Ibn Abi Shaybah 16146","","","كتاب الحج"
"16147","(۱۶۱۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مجلز فِی قَوْلہ : (حُرِّمَ عَلَیْکُمْ صَیْدُ الْبَرِّ مَا دُمْتُمْ حُرُمًا) قَالَ : مَا کَانَ یَعِیشُ فِی الْبَرِّ والبحر فَلاَ تَصِدْہُ ، وَمَا کَانَ یَعِیشُ فِی الْبَحْرِ فَذَاکَ۔","","Musannaf Ibn Abi Shaybah 16147","","","كتاب الحج"
"16148","(۱۶۱۴۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ، عَنْ سَعِیدٍ التَّمَّارِ، قَالَ: رَأَیْتُ ابْنَ الْحَنَفِیَّۃِ جَالِسًا عَلَی حشیۃ حَمْرَائَ وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 16148","","","كتاب الحج"
"16149","(۱۶۱۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ بَأْسَ أَنْ یَجْلِسَ عَلَی الْفِرَاشِ الْمَصْبُوغِ بِالزَّعْفَرَانِ وَہُوَ مُحْرِمٌ۔","","Musannaf Ibn Abi Shaybah 16149","","","كتاب الحج"
"16150","(۱۶۱۵۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16150","","","كتاب الحج"
"16151","(۱۶۱۵۱) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، قَالَ نُبِّئْت ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَجْلِسَ الْمُحْرِمُ عَلَی الْفِرَاشِ الْمَصْبُوغِ بِالزَّعْفَرَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 16151","","","كتاب الحج"
"16152","حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ ، قَالَ :n(۱۶۱۵۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مَیْمُونٍ أَبِی المُغَلِّسِ ، عَنْ أَبِی نَجِیحٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَ مُوسِرًا لأَنْ یَنْکِحَ فَلَمْ یَنْکِحْ فَلَیْسَ مِنَّا۔ (ابوداؤد ۲۰۲۔ عبدالرزاق ۱۰۳۷۶)","Da'if","Musannaf Ibn Abi Shaybah 16152","","","كتاب النكاح"
"16153","(۱۶۱۵۳) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : عَنْ سَعْدٍ ، أَنَّ رَسُولَ اللّٰہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَدَّ عَلَی عُثْمَانَ بْنِ مَظْعُونٍ التَّبَتُّلَ ، وَلَوْ أَذِنَ لَہُ لاَخْتَصَیْنَا۔ (مسلم ۱۰۲۰۔ احمد ۱/۱۷۶)","Sahih","Musannaf Ibn Abi Shaybah 16153","","","كتاب النكاح"
"16154","(۱۶۱۵۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ قَالَ : کُنْتُ أَمْشِی مَعَ عَبْدِ اللہِ بِمِنًی ، فَلَقِیَہُ عُثْمَانُ فَقَامَ مَعَہُ یُحَدِّثُہُ ، فَقَالَ لہ عُثْمَانُ : یَا أَبَا عَبْدِ الرَّحْمَنِ ، أَلاَ أُزَوِّجُک جَارِیَۃً شَابَّۃً لَعَلَّہَا تُذَکِّرُک بَعْضَ مَا مَضَی مِنْ زَمَانِکَ ؟ فَقَالَ عَبْدُ اللہِ أَمَا لَئِنْ قُلْتُ ذَلِکَ لَقَدْ قَالَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: یَا مَعْشَرَ الشَّبَابِ ، مَنِ اسْتَطَاعَ مِنْکُمُ الْبَائَۃَ فَلْیَتَزَوَّجْ ، فَإِنَّہُ أَغَضُّ لِلْبَصَرِ ، وَمَنْ لَمْ یَسْتَطِعْ فَعَلَیْہِ بِالصَّوْمِ ، فَإِنَّہُ لَہُ وِجَائٌ۔ (بخاری ۵۰۶۵۔ مسلم ۱۰۱۸)","Sahih","Musannaf Ibn Abi Shaybah 16154","","","كتاب النكاح"
"16155","(۱۶۱۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ قَالَ: قَالَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا مَعْشَرَ الشَّبَابِ ، مَنِ اسْتَطَاعَ مِنْکُمُ الْبَائَۃَ فَلْیَتَزَوَّجْ ، فَإِنَّہُ أَغَضُّ لِلْبَصَرِ وَأَحْصَنُ لِلْفَرْجِ ، وَمَنْ لَمْ یَسْتَطِعْ فَعَلَیْہِ بِالصَّوْمِ ، فَإِنَّہُ لَہُ وِجَائٌ۔ (بخاری ۵۰۶۶۔ مسلم ۱۰۱۹)","Sahih","Musannaf Ibn Abi Shaybah 16155","","","كتاب النكاح"
"16156","(۱۶۱۵۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ أَبِی رَجَائٍ ، عَنْ عُثْمَانَ بْنِ خَالِدٍ ، عَنِ الزُّہْرِیِّ : عَنْ شَدَّادِ بْنِ أَوْسٍ ، وَکَانَ قَدْ ذَہَبَ بَصَرُہُ قَالَ : زَوِّجُونِی فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَوْصَانِی أَنْ لاَ أَلْقَی اللَّہَ أَعْزَبًا۔","Da'if","Musannaf Ibn Abi Shaybah 16156","","","كتاب النكاح"
"16157","(۱۶۱۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ أَبِی رَجَائٍ ، عَنِ الْحَکَمِ بْنِ زَیْدٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ مُعَاذُ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ : زَوِّجُونِی إنِّی أَکْرَہُ أَنْ أَلْقَی اللَّہَ أَعْزَبًا۔","Da'if","Musannaf Ibn Abi Shaybah 16157","","","كتاب النكاح"
"16158","(۱۶۱۵۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، قَالَ : قَالَ لِی طَاوُوسٌ : لَتَنْکِحَنَّ ، أَوْ لأَقُولَنَّ لَکَ مَا قَالَ عُمَرُ لأَبِی الزَّوَائِد : مَا یَمْنَعُک مِنَ النِّکَاحِ إلاَّ عَجْزٌ ، أَوْ فُجُورٌ۔","","Musannaf Ibn Abi Shaybah 16158","","","كتاب النكاح"
"16159","(۱۶۱۵۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ ہِشَامِ بْنِ حُجَیرٍ ، عَنْ طَاوُوسٍ قَالَ : لاَ یَتِمُّ نُسُکُ الشَّابِّ حَتَّی یَتَزَوَّجَ۔","","Musannaf Ibn Abi Shaybah 16159","","","كتاب النكاح"
"16160","(۱۶۱۶۰) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنْ أَبِی الْحَکَمِ سَیَّارٍ ، عَنْ أَبِی وَائِلٍ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : لَوْ لَمْ أَعِشْ أَوَ لو لَمْ أَکُنْ فِی الدُّنْیَا إلاَّ عَشْرًا لأَحْبَبْت أَنْ یَکُونَ عِنْدِی فِیہِنَّ امْرَأَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 16160","","","كتاب النكاح"
"16161","(۱۶۱۶۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَزَوَّجُوا النِّسَائَ فَإِنَّہُنَّ یَأْتِینَکُمْ بِالْمَالِ۔","","Musannaf Ibn Abi Shaybah 16161","","","كتاب النكاح"
"16162","(۱۶۱۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، قَالَ : قَالَ عُمَرُ ابْتَغُوا الْغِنَی فِی الْبَائَۃ۔","","Musannaf Ibn Abi Shaybah 16162","","","كتاب النكاح"
"16163","(۱۶۱۶۳) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَمْ یُرَ لِلْمُتَحَابَّیْنِ مِثْلَ النِّکَاحِ۔ (بیہقی ۷۸)","","Musannaf Ibn Abi Shaybah 16163","","","كتاب النكاح"
"16164","(۱۶۱۶۴) حَدَّثَنَا عَبْد اللہِ قَالَ : حدَّثَنَا إسْرَائِیلُ عن أبی إسحاق ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ قَالَ : لَوْ لَمْ یَبْقَ مِنَ الدَّہْرِ إلاَّ لَیْلَۃً لأَحْبَبْت أَنْ یَکُونَ لِی فِی تِلْکَ اللَّیْلَۃِ امْرَأَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 16164","","","كتاب النكاح"
"16165","(۱۶۱۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قَیْسٍ ، عَنْ عَبْدِ اللہِ قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ شَبَابٌ ، فَقُلْنَا یَا رَسُولَ اللہِ أَلاَ نَسْتَخْصِی ؟ قَالَ : لاَ ، ثُمَّ رَخَّصَ لَنَا أَنْ نَنْکِحَ الْمَرْأَۃَ بِالثَّوْبِ إلَی الأَجَلِ ، ثُمَّ قَرَأَ عَبْدُ اللہِ {یَا أَیُّہَا الَّذِینَ آمَنُوا لاَ تُحَرِّمُوا طَیِّبَاتِ مَا أَحَلَّ اللَّہُ لَکُمْ}۔n(بخاری ۴۶۱۵۔ مسلم ۱۱)","Sahih","Musannaf Ibn Abi Shaybah 16165","","","كتاب النكاح"
"16166","(۱۶۱۶۶) حَدَّثَنَا صَاحِبٌ لَنَا یُکَنَّی بِأَبِی بَکْرٍ قَالَ : حدَّثَنَا ابْنُ ہِشَامٍ الدَّسْتَوَائِیُّ ، عَنْ أَبِیہِ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی ، عَنِ التَّبَتُّلِ۔ (ترمذی ۱۰۸۲۔ احمد ۵/۱۷)","Hasan","Musannaf Ibn Abi Shaybah 16166","","","كتاب النكاح"
"16167","(۱۶۱۶۷) حدَّثَنَا مُعَاذٌ قَالَ : أَخْبَرَنَا ابْنُ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّمَا امْرَأَۃٍ لَمْ یُنْکِحْہَا الْوَلِیُّ ، أَوِ الْوُلاَۃُ فَنِکَاحُہَا بَاطِلٌ فَنِکَاحُہَا بَاطِلٌ ، قَالَہَا ثَلاَثًا ، فَإِنْ أَصَابَہَا فَلَہَا مَہْرُہَا بِمَا أصاب مِنْہَا ، فَإِنَ اشْتَجَرُوا فَالسُّلْطَانُ وَلِیُّ مَنْ لاَ وَلِیَّ لَہُ۔ (ابوداؤد ۲۰۷۶۔ احمد ۶/۱۶۵)","Sahih","Musannaf Ibn Abi Shaybah 16167","","","كتاب النكاح"
"16168","(۱۶۱۶۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ أَخٍ لِعُبَیْدِ بْنِ عُمَیْرٍ ، عنْ عَبْدِ الرَّحْمَنِ بْنِ مَعْبَد أَنَّ عُمَر رَدَّ نِکَاحَ امْرَأَۃٍ نُکِحَتْ بِغَیْرِ إذْنِ وَلِیِّہَا۔","Da'if","Musannaf Ibn Abi Shaybah 16168","","","كتاب النكاح"
"16169","(۱۶۱۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنْ عُمَرَ ، قَالَ : لاَ نِکَاحَ إلاَّ بِوَلِیٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 16169","","","كتاب النكاح"
"16170","(۱۶۱۷۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ قَالَ : مَا کَانَ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَشَدَّ فِی النِّکَاحِ بِغَیْرِ وَلِیٍّ مِنْ عَلِیٍّ حَتَّی کَانَ یَضْرِبُ فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 16170","","","كتاب النكاح"
"16171","(۱۶۱۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ خُثَیْمٍ ، عَنْ سَعِیدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ نِکَاحَ إلاَّ بِوَلِیٍّ ، أَوْ سُلْطَانٍ مُرْشِدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 16171","","","كتاب النكاح"
"16172","(۱۶۱۷۲) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، قَالَ: سَمِعْتُ الْوَضَّاحَ، قَالَ: سَمِعْتُ جَابِرَ بْنَ زَیْدٍ یَقُولُ: لاَ نِکَاحَ إلاَّ بِوَلِیٍّ وَشَاہِدَیْنِ۔","","Musannaf Ibn Abi Shaybah 16172","","","كتاب النكاح"
"16173","(۱۶۱۷۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ نِکَاحَ إلاَّ بِوَلِیٍّ۔","","Musannaf Ibn Abi Shaybah 16173","","","كتاب النكاح"
"16174","(۱۶۱۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : لاَ نِکَاحَ إلاَّ بِوَلِیٍّ ، أَوْ سُلْطَانٍ۔","","Musannaf Ibn Abi Shaybah 16174","","","كتاب النكاح"
"16175","(۱۶۱۷۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ قَالَ : لاَ تُنْکَحُ الْمَرْأَۃُ إلاَّ بِإِذْنِ وَلِیِّہَا ، فَإِنْ لَمْ یَکُنْ لَہَا وَلِیٌّ فَالسُّلْطَانُ۔","","Musannaf Ibn Abi Shaybah 16175","","","كتاب النكاح"
"16176","(۱۶۱۷۶) حَدَّثَنَا یَزِیدُ ، عَنْ أَشْعَثَ ، عَنْ أَصْحَابِہِ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 16176","","","كتاب النكاح"
"16177","(۱۶۱۷۷) حَدَّثَنَا عُبَیْدُ اللہ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَمْرِو بْنِ أَبِی سُفْیَانَ ، قَالَ : قَالَ عُمَرُ : لاَ تُنْکَحُ الْمَرْأَۃُ إلاَّ بِإِذْنِ وَلِیِّہَا ، وَإِنْ نَکَحَتْ عَشَرَۃً ، أَوْ بِإِذْنِ سُلْطَانٍ۔","Sahih","Musannaf Ibn Abi Shaybah 16177","","","كتاب النكاح"
"16178","(۱۶۱۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَیُّوبَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ فِی الْمَرْأَۃِ مِنْ أَہْلِ السَّوَادِ لَیْسَ لَہَا وَلِیٌّ ، قَالَ : الْحَسَنُ السُّلْطَانُ ، وَقَالَ ابْنُ سِیرِینَ : رَجُلٌ مِنَ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 16178","","","كتاب النكاح"
"16179","(۱۶۱۷۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ وَالشُّعَبِیِّ قَالاَ : لاَ تُنْکَحُ الْمَرْأَۃُ إلاَّ بِإِذْنٍ وَلِیہَا ، وَلاَ یُنْکِحُہَا وَلِیُّہَا إلاَّ بِإِذْنِہَا۔","","Musannaf Ibn Abi Shaybah 16179","","","كتاب النكاح"
"16180","(۱۶۱۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ قَالَ : أُتِیَ عُمَرُ بِامْرَأَۃٍ قَدْ حَمَلَتْ ، فَقَالَتْ : تَزَوَّجَنِی بِشَہَادَۃٍ مِنْ أُمِّی وَأُخْتِی ، فَفَرَّقَ بَیْنَہُمَا وَدَرَأَ عَنْہُمَا الْحَدَّ ، وَقَالَ : لاَ نِکَاحَ إلاَّ بِوَلِیٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 16180","","","كتاب النكاح"
"16181","(۱۶۱۸۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ قَالَ : لاَ نِکَاحَ إلاَّ بِوَلِیٍّ وَلاَ نِکَاحَ إلاَّ بِشُہُودٍ۔","Da'if","Musannaf Ibn Abi Shaybah 16181","","","كتاب النكاح"
"16182","(۱۶۱۸۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ نِکَاحَ إلاَّ بِوَلِیٍّ وَالسُّلْطَانُ وَلِیُّ مَنْ لاَ وَلِیَّ لَہُ۔ (احمد ۱/۲۵۰۔ ابن ماجہ ۱۸۸۰)","","Musannaf Ibn Abi Shaybah 16182","","","كتاب النكاح"
"16183","(۱۶۱۸۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَزِیدَ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : لاَ نِکَاحَ إلاَّ بِوَلِیٍّ وَشَاہِدَی عَدْلٍ وَبِصَدُقَۃٍ مَعْلُومَۃٍ وَشُہُودٍ وعَلاَنِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 16183","","","كتاب النكاح"
"16184","(۱۶۱۸۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ قَالَ : قُلْتُ لِلْحَسَنِ جَارِیَۃٌ مِنْ أَہْلِ الأَرْضِ یَعْنِی لَیْسَ لَہَا مَوْلًی ، خَطَبَہَا رَجُلٌ، أَیُزَوِّجُہَا رَجُلٌ مِنْ جِیرَانِہَا ، قَالَ : تَأْتِی الأَمِیرَ قَالَ : فَإِنَّہَا أَضْعَفُ مِنْ ذَلِکَ ، قَالَ : فَتُکَلِّمُ رَجُلاً یُکَلِّمُ لَہَا الأَمِیرُ ، قَالَ : فَإِنَّہَا أَضْعَفُ مِنْ ذَلِکَ ؟ قَالَ : لاَ أَعْلَمُ إلاَّ ذَلِکَ ، قَالَ : قُلْتُ لَہُ : فَالْقَاضِی ؟ قَالَ : فَالْقَاضِی إذًا، إلاَّ أَنَّہُ یَجْعَلُ الْقَاضِی رُخْصَۃً۔","","Musannaf Ibn Abi Shaybah 16184","","","كتاب النكاح"
"16185","(۱۶۱۸۵) حَدَّثَنَا عَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنْ زِیَادٍ قَالَ : إذَا اتَّفَقَ الْوَلِیُّ وَالأُمُّ تَزَوَّجَا ، وَإِنِ اخْتَلَفَا فَالْوَلِیُّ۔","","Musannaf Ibn Abi Shaybah 16185","","","كتاب النكاح"
"16186","(۱۶۱۸۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ نِکَاحَ إلاَّ بِوَلِیٍّ۔ (ابوداؤد ۲۰۷۸۔ احمد ۳۹۴)","Sahih","Musannaf Ibn Abi Shaybah 16186","","","كتاب النكاح"
"16187","(۱۶۱۸۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی یَحْیَی ، عَنْ رَجُلٍ یُقَالُ لَہُ الْحَکَمُ بْنُ مِینَائَ ، عَنِ ابْنِ عَبَّاسٍ : أَدْنَی مَا یَکُونُ فِی النِّکَاحِ أَرْبَعَۃٌ : الَّذِی یُزَوِّجُ وَالَّذِی یَتَزَوَّجُ وَشَاہِدَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 16187","","","كتاب النكاح"
"16188","(۱۶۱۸۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ نِکَاحَ إلاَّ بِوَلِیٍّ۔","","Musannaf Ibn Abi Shaybah 16188","","","كتاب النكاح"
"16189","(۱۶۱۸۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ أَرَادَ أَنْ یَتَزَوَّجَ فَذَہَبَ ہُوَ وَرَجُلٌ وَجَائَ الْوَلِیُّ وَرَجُلٌ۔","Da'if","Musannaf Ibn Abi Shaybah 16189","","","كتاب النكاح"
"16190","(۱۶۱۹۰) حَدَّثَنَا وَکِیعٌ ، أَوْ غَیْرُہُ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : أَدْنَی مَا یَکُونُ فِی النِّکَاحِ أَرْبَعَۃٌ : الَّذِی یَتَزَوَّجُ وَالَّذِی یُزَوِّجُ وَشَاہِدَانِ۔","","Musannaf Ibn Abi Shaybah 16190","","","كتاب النكاح"
"16191","(۱۶۱۹۱) حدَّثَنَا إسماعیل ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ قَالَ : جَمَعَتِ الطَّرِیقُ رَکْبًا ، فَجَعَلَتِ امْرَأَۃٌ مِنْہُمْ ثَیِّبٌ أَمْرَہَا إلَی رَجُلٍ مِنَ الْقَوم غَیْرِ وَلِیِّہَا ، فَأَنْکَحَہَا رَجُلاً ، قَالَ : فَجَلَدَ عُمَرُ النَّاکِحَ وَالْمُنْکِحَ وَفَرَّقَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 16191","","","كتاب النكاح"
"16192","(۱۶۱۹۲) حَدَّثَنَا أَبُودَاوُدَ الطَّیَالِسِیُّ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ قَتَادَۃَ، عَنِ سعید بْنِ الْمُسَیَّبِ، وَالْحَسَنِ فِی امْرَأَۃٍ تَزَوَّجَتْ بِغَیْرِ إذْنِ وَلِیِّہَا ، قَالَ : یُفَرَّقُ بَیْنَہُمَا ، وَقَالَ الْقَاسِمُ بْنُ مُحَمَّدٍ : إِنْ أَجَازَہُ الأَوْلِیَائُ فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 16192","","","كتاب النكاح"
"16193","(۱۶۱۹۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ مُصْعَبٍ قَالَ : سَأَلْتُ إبْرَاہِیمَ ، عَنِ امْرَأَۃٍ تَزَوَّجَتْ بِغَیْرِ وَلِیٍّ فَسَکَتَ، وَسَأَلْت سَالِمَ بْنَ أَبِی الْجَعْدِ ، فَقَالَ : لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 16193","","","كتاب النكاح"
"16194","(۱۶۱۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سفیان عن ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : إذَا نُکِحَتِ الْمَرْأَۃُ بِغَیْرِ وَلِیٍّ ، ثُمَّ أَجَازَ الْوَلِیُّ جَازَ۔","","Musannaf Ibn Abi Shaybah 16194","","","كتاب النكاح"
"16195","(۱۶۱۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ بَکْرٍ قَالَ : تَزَوَّجَتِ امْرَأَۃٌ بِغَیْرِ وَلِیٍّ وَلاَ بَیِّنَۃٍ فَکَتَبَ إِلی عُمَرَ فَکَتَبَ أَنْ تُجْلَدَ مِئَۃً ، وَکَتَبَ إلَی الأَمْصَارِ ، أَیُّمَا امْرَأَۃٍ تَزَوَّجَتْ بِغَیْرِ وَلِیٍّ فَہِیَ بِمَنْزِلَۃِ الزَّانِیَۃِ۔","","Musannaf Ibn Abi Shaybah 16195","","","كتاب النكاح"
"16196","(۱۶۱۹۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ مِنْ أَہْلِ الْجَزِیرَۃِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ أَنَّ رَجُلاً زَوَّجَ امْرَأَۃً وَلَہَا وَلِیٌّ ہُوَ أَوْلَی مِنْہُ بِدُرُوبِ الرُّومِ ، فَرَدَّ عُمَرُ النِّکَاحَ وَقَالَ : الْوَلِیُّ وَإِلاَّ فَالسُّلْطَانُ۔","","Musannaf Ibn Abi Shaybah 16196","","","كتاب النكاح"
"16197","(۱۶۱۹۷) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أُمِّہِ ، عَنْ بَحَرِیَّۃَ بِنْتِ ہَانِیئٍ قَالَتْ : تَزَوَّجْت الْقَعْقَاعَ بْنَ شَوْرٍ فَسَأَلَنِی وَجَعَلَ لِی مُذْہَبًا مِنْ جَوْہَرٍ عَلَی أَنْ یَبِیتَ عِنْدِی لَیْلَۃً فَبَاتَ ، فَوَضَعْت لَہُ تَوْرًا فِیہِ خَلُوقٌ فَأَصْبَحَ وَہُوَ مُتَضَمِّخٌ بِالْخَلُوقِ ، فَقَالَ لِی : فَضَحْتِنِی ، فَقُلْتُ لَہُ : مِثْلِی یَکُونُ سِرًّا ؟ فَجَائَ أَبِی مِنَ الأَعْرَابِ ، فَاسْتَعْدَی عَلَیْہِ عَلِیًّا ، فَقَالَ عَلِیٌّ لِلْقَعْقَاعِ : أَدَخَلْتَ ؟ فَقَالَ : نَعَمْ ، فَأَجَازَ النِّکَاحَ۔","Da'if","Musannaf Ibn Abi Shaybah 16197","","","كتاب النكاح"
"16198","(۱۶۱۹۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ مُصْعَبٍ قَالَ : سَأَلْتُ مُوسی بْنَ عَبْدِ اللہِ بْنِ یَزِیدَ ، فَقَالَ : یَجُوزُ فِی الْمَرْأَۃِ تَزْوِیجٌ بِغَیْرِ وَلِیٍّ۔","","Musannaf Ibn Abi Shaybah 16198","","","كتاب النكاح"
"16199","(۱۶۱۹۹) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ مَعْمَرٍ قَالَ: سَأَلْتُ الزُّہْرِیَّ، عَنِ امْرَأَۃٍ تُزَوَّجُ بِغَیْرِ وَلِیٍّ، فَقَالَ: إِنْ کَانَ کُفُؤًا جَازَ۔","","Musannaf Ibn Abi Shaybah 16199","","","كتاب النكاح"
"16200","(۱۶۲۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا کَانَ کُفُؤًا جَازَ۔","","Musannaf Ibn Abi Shaybah 16200","","","كتاب النكاح"
"16201","(۱۶۲۰۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی قَیْسٍ الأَوْدِیِّ ، عَمَّنْ حَدَّثَہُ عَنْ عَلِیٍّ أَنَّہُ أَجَازَ نِکَاحَ امْرَأَۃٍ بِغَیْرِ وَلِیٍّ أَنْکَحَتْہَا أُمُّہَا بِرِضَاہَا۔","Da'if","Musannaf Ibn Abi Shaybah 16201","","","كتاب النكاح"
"16202","(۱۶۲۰۲) حَدَّثَنَا سَلاَّمٌ وَجَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ قَالَ : جَائَتِ امْرَأَۃٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إنَّ عَمَّ وَلَدِی خَطَبَنِی فَرَدَّہُ أَبِی وَزَوَّجَنِی وَأَنَا کَارِہَۃٌ، قَالَ : فَدَعَا أَبَاہَا ، فَسَأَلَہُ ، عَنْ ذَلِکَ ، فَقَالَ : إنِّی أَنْکَحْتُہَا وَلَمْ آلُوہَا خَیْرًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ نِکَاحَ لَکِ ، اذْہَبِی فَانْکِحِی مَنْ شِئْتِ۔ (عبدالرزاق ۱۰۳۰۳)","","Musannaf Ibn Abi Shaybah 16202","","","كتاب النكاح"
"16203","(۱۶۲۰۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ أَنَّ الْقَاسِمَ بْنَ مُحَمَّدٍ أَخْبَرَہُ أَنَّ عَبْدَ الرَّحْمَنِ بْنَ یَزِیدَ وَمُجَمِّع بْنَ یَزِیدَ الأَنْصَارِیَّیْنِ أَخْبَرَاہُ أَنَّ رَجُلاً مِنْہُمْ یُدْعَی خِذَامًا أَنْکَحَ ابْنَۃً لَہُ ، فَکَرِہَتْ نِکَاحَ أَبِیہَا فَأَتَتْ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَتْ ذَلِکَ لَہُ فَرَدَّ عَنْہَا نِکَاحَ أَبِیہَا ، فَخُطِبَتْ فَنَکَحَتْ أَبَا لُبَابَۃَ بْنَ عَبْدِ الْمُنْذِرِ ، وَذَکَرَ یَحْیَی أَنَّہُ بَلَغَہُ أَنَّہَا کَانَتْ ثَیِّبًا۔ (بخاری ۵۱۳۹۔ ابوداؤد ۲۰۹۴)","Sahih","Musannaf Ibn Abi Shaybah 16203","","","كتاب النكاح"
"16204","(۱۶۲۰۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ أَنَّ عَائِشَۃَ أَنْکَحَتْ حَفْصَۃَ ابْنَۃَ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ الْمُنْذِرَ بْنَ الزُّبَیْرِ وَعَبْدُ الرَّحْمَنِ غَائِبٌ فَلَمَّا قَدِمَ عَبْدُ الرَّحْمَنِ غَضِبَ وَقَالَ : أَی عِبَادَ اللہِ ، أَمِثْلِی یُفْتَاتُ عَلَیْہِ فِی بَنَاتِہِ ؟ فَغَضِبَتْ عَائِشَۃُ وَقَالَتْ : أَیُرْغَبُ ، عَنِ الْمُنْذِرِ۔","Sahih","Musannaf Ibn Abi Shaybah 16204","","","كتاب النكاح"
"16205","(۱۶۲۰۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ قَالَ : رُفِعَتْ إلَی عَلِیٍّ امْرَأَۃٌ زَوَّجَہَا خَالُہَا وأمہا ، قَالَ : فَأَجَازَ عَلِیٌّ النِّکَاحَ ، قَالَ : وَقَالَ سُفْیَانُ : لاَ یَجُوزُ لأَنَّہُ غَیْرُ وَلِیٍّ ، وَقَالَ عَلِیُّ بْنُ صَالِحٍ : ہُوَ جَائِزٌ لأَنَّ عَلِیًّا حِینَ أَجَازَہُ کَانَ بِمَنْزِلَۃِ الْوَلِیِّ۔","Hasan","Musannaf Ibn Abi Shaybah 16205","","","كتاب النكاح"
"16206","(۱۶۲۰۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ قَالَ : کَانَ عَلِیٌّ إذَا رُفِعَ إلَیْہِ رَجُلٌ تَزَوَّجَ امْرَأَۃً بِغَیْرِ وَلِیٍّ فَدَخَلَ بِہَا أَمْضَاہُ۔","","Musannaf Ibn Abi Shaybah 16206","","","كتاب النكاح"
"16207","(۱۶۲۰۷) حدَّثَنَا محمد بْنُ فُضَیْلٍ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ قَالَ: لَیْسَ الْعَقْدُ بِیَدِ النِّسَائِ، إِنَّمَا الْعَقْدُ بِیَدِ الرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 16207","","","كتاب النكاح"
"16208","(۱۶۲۰۸) حَدَّثَنَا ابن إدْرِیس ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ قَالَ : لاَ أَعْلَمُہُ إلاَّ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ الْفَتَی مِنْ بَنِی أَخِیہَا إذَا ہَوَی الْفَتَاۃَ مِنْ بنات أَخِیہَا ضَرَبَتْ بَیْنَہُمَا سِتْرًا وَتَکَلَّمَتْ ، فَإِذَا لَمْ یَبْقَ إلاَّ النِّکَاحَ قَالَتْ : یَا فُلاَنُ ، أَنْکِحْ ، فَإِنَّ النِّسَائَ لاَ یَنْکِحْنَ۔","","Musannaf Ibn Abi Shaybah 16208","","","كتاب النكاح"
"16209","(۱۶۲۰۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : لاَ تُزَوِّجُ الْمَرْأَۃُ الْمَرْأَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 16209","","","كتاب النكاح"
"16210","(۱۶۲۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ قَالَ : لاَ تُنْکِحُ الْمَرْأَۃُ الْمَرْأَۃَ۔","","Musannaf Ibn Abi Shaybah 16210","","","كتاب النكاح"
"16211","(۱۶۲۱۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : تُزَوِّجُ الْمَرْأَۃُ أَمَتَہَا ، فَإِذَا أَعْتَقَتْہَا لَمْ تُزَوِّجْہَا۔","","Musannaf Ibn Abi Shaybah 16211","","","كتاب النكاح"
"16212","(۱۶۲۱۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنِی ابْنُ أَبِی ذِئْبٍ ، عَنْ مَوْلَی بَنِی ہَاشِمٍ ، عَنْ عَلِیٍّ قَالَ : لاَ تَشْہَدُ الْمَرْأَۃُ ، یَعْنِی الْخِطْبَۃَ وَلاَ تُنْکِحُ۔","Da'if","Musannaf Ibn Abi Shaybah 16212","","","كتاب النكاح"
"16213","(۱۶۲۱۳) حدَّثَنَا غَسَّانُ بْنُ مُضَرَ ، عَنْ سَعِیدِ بْنِ یَزِیدَ قَالَ : جَائَتِ امْرَأَۃٌ إلَی جَابِرِ بْنِ زَیْدٍ ، فَقَالَتْ : إنِّی زَوَّجْت نَفْسِی ، فَقَالَ : إنَّک لِتُحَدِّثِینِی أَنَّک زَنَیْت ؟ فَسَفَعَتْ برنَّۃ ثُمَّ انْطَلَقَتْ۔","","Musannaf Ibn Abi Shaybah 16213","","","كتاب النكاح"
"16214","(۱۶۲۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ قَالَ : لاَ تُنْکِحُ الْمَرْأَۃُ نَفْسَہَا ، وَکَانُوا یَقُولُونَ : إنَّ الزَّانِیَۃَ ہِیَ الَّتِی تُنْکِحُ نَفْسَہَا۔","","Musannaf Ibn Abi Shaybah 16214","","","كتاب النكاح"
"16215","(۱۶۲۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 16215","","","كتاب النكاح"
"16216","(۱۶۲۱۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّ الْبَغَایَا اللاَّئی یُنْکِحْنَ أَنْفُسَہُنَّ بِغَیْرِ بَیِّنَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 16216","","","كتاب النكاح"
"16217","(۱۶۲۱۷) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ أَبِی عَمْرٍو مَوْلَی عَائِشَۃَ ، عَنْ عَائِشَۃَ قَالَتْ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُسْتَأْمَرُ النِّسَائُ فِی أَبْضُعِہِنَّ ، قَالَتْ قُلْتُ : یَا رَسُولَ اللہِ ، إنَّہُنَّ یَسْتَحْیِینَ ، قَالَ : الأَیِّمُ أَحَقُّ بِنَفْسِہَا ، وَالْبِکْرُ تُسْتَأْمَرُ فَسُکاتُہَا إقْرَارُہَا۔(بخاری ۶۹۴۶۔ مسلم ۶۵)","Sahih","Musannaf Ibn Abi Shaybah 16217","","","كتاب النكاح"
"16218","(۱۶۲۱۸) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ وَمَالِکِ بْنِ أَنَسٍ، عَنْ عَبْدِ اللہِ بْنِ الْفَضْلِ، عَنْ نَافِعِ بْنِ جُبَیْرٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الأَیِّمُ أَحَقُّ بِنَفْسِہَا مِنْ وَلِیِّہَا ، وَالْبِکْرُ تُسْتَأْمَرُ وَصَمْتُہَا إقْرَارُہَا۔ (ترمذی ۱۱۰۸۔ ابوداؤد ۲۰۹۱)","Sahih","Musannaf Ibn Abi Shaybah 16218","","","كتاب النكاح"
"16219","(۱۶۲۱۹) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا خُطِبَ أَحَدٌ مِنْ بَنَاتِہِ جَلَسَ إلَی جَنْبِ خِدْرِہَا ، فَقَالَ : إنَّ فُلاَنًا یَخْطُبُ فُلاَنَۃً فَإِنْ سَکَتَتْ بِہِ زَوَّجَہَا ، وَإِنْ طَعَنَتْ بِیَدِہَا وَأَشَارَ حَفْصٌ بِیَدِہِ السَّبَّابَۃِ أَی یَطْعَنُ فِی فَخِذِہ لَمْ یُزَوِّجْہَا۔ (عبدالرزاق ۱۰۲۷۹۔ بزار ۱۴۲۱)","","Musannaf Ibn Abi Shaybah 16219","","","كتاب النكاح"
"16220","(۱۶۲۲۰) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، قَالَ : قَالَ عَلِیٌّ لاَ یُزَوِّجُ الرَّجُلُ ابنتہ حَتَّی یَسْتَأْمِرَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 16220","","","كتاب النكاح"
"16221","(۱۶۲۲۱) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ: إذَا کَانَتِ الْمَرْأَۃُ فِی عِیَالِ أَبِیہَا لَمْ یَسْتَأْمِرْہَا، وَإِنْ کَانَتْ فِی غَیْرِ عِیَالِہِ اسْتَأْمَرَہَا إذَا أَرَادَ أَنْ یُنْکِحَہَا۔","","Musannaf Ibn Abi Shaybah 16221","","","كتاب النكاح"
"16222","(۱۶۲۲۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ عاصم، عَنِ الشَّعْبِیِّ قَالَ: یَسْتَأْمِرُ الرَّجُلُ ابْنَتَہُ فِی النِّکَاحِ الْبِکْرَ وَالثَّیِّبَ۔","","Musannaf Ibn Abi Shaybah 16222","","","كتاب النكاح"
"16223","(۱۶۲۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : نِکَاحُ الأَبِ جَائِزٌ عَلَی ابْنَتِہِ ، بِکْرًا کَانَ ، أَوْ ثَیِّبًا ، کَرِہَتْ ، أَوْ لَمْ تَکْرَہْ۔","","Musannaf Ibn Abi Shaybah 16223","","","كتاب النكاح"
"16224","(۱۶۲۲۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ قَالَ : لاَ یُکْرِہُ الرَّجُلُ ابْنَتَہُ الثَّیِّبَ عَلَی نِکَاحٍ ہِیَ تَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 16224","","","كتاب النكاح"
"16225","(۱۶۲۲۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ قَالَ : کَانَ الْقَاسِمُ وَسَالِمٌ یَقُولاَنِ : إذَا زَوَّجَ أَبُو الْبِکْرِ الْبِکْرَ فَہُوَ لاَزِمٌ لَہَا ، وَإِنْ کَرِہَتْ۔","","Musannaf Ibn Abi Shaybah 16225","","","كتاب النكاح"
"16226","(۱۶۲۲۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : إِنَّ أَبُو الْبِکْرِ دَعَاہَا إلَی رَجُلٍ وَدَعَتْ ہِیَ إلَی آخَرَ ، قَالَ : یَتْبَعُ ہَوَاہَا إذَا لَمْ یَکُنْ بِہِ بَأْسٌ ، وَإِنْ کَانَ الَّذِی دَعَاہَا إلَیْہِ أَبُوہَا أَسْنی فِی الصَّدَاقِ أَخْشَی أَنْ یَقَعَ فِی نَفْسِہَا ، وَإِنْ أَکْرَہَہَا أَبُوہَا فَہُوَ أَحَقُّ۔","","Musannaf Ibn Abi Shaybah 16226","","","كتاب النكاح"
"16227","(۱۶۲۲۷) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : لاَ یُجْبِرُ عَلَی النِّکَاحِ إلاَّ الأَبُ۔","","Musannaf Ibn Abi Shaybah 16227","","","كتاب النكاح"
"16228","(۱۶۲۲۸) حَدَّثَنَا عَفَّانُ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ عُثْمَانَ بْنَ عَفَّانَ کَانَ إذَا أَرَادَ أَنْ یُزَوِّجَ أَحَدًا مِنْ بَنَاتِہِ قَعَدَ إلَی خِدْرِہَا ، فَقَالَ إنَّ فُلاَنًا یَذْکُرُک۔","","Musannaf Ibn Abi Shaybah 16228","","","كتاب النكاح"
"16229","(۱۶۲۲۹) حَدَّثَنَا عَمْرُو بْنُ مُحَمَّدٍ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ قَالَ : تُسْتَأْمَرُ الْبِکْرُ ، وَإِنْ کَانَتْ بَیْنَ أَبَوَیْہَا۔","","Musannaf Ibn Abi Shaybah 16229","","","كتاب النكاح"
"16230","(۱۶۲۳۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ کَہْمَسٍ ، عَنِ ابْنِ بُرَیْدَۃَ قَالَ : جَائَتْ فَتَاۃٌ إلَی عَائِشَۃَ ، فَقَالَتْ : إنَّ أَبِی زَوَّجَنِی من ابْنِ أَخِیہِ لِیَرْفَعَ بی خَسِیسَتَہُ وَإِنِّی کَرِہْت ذَلِکَ ، فَقَالَتْ لَہَا عَائِشَۃُ : انْتَظِرِی حَتَّی یَأْتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَمَّا جَائَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْسَلَ إلَی أَبِیہَا ، فَجَعَلَ الأَمْرَ إلَیْہَا ، فَقَالَتْ : أَمَّا إذَا کَانَ الأَمْرُ إلَیَّ فَقَدْ أَجَزْت مَا صَنَعَ أَبِی ، إنَّمَا أَرَدْت أَنْ أَعْلَمَ ہَلْ لِلنِّسَائِ مِنَ الأَمْرِ شَیْئ؟۔ (احمد ۶/۱۳۶۔ دارقطنی ۴۵)","","Musannaf Ibn Abi Shaybah 16230","","","كتاب النكاح"
"16231","(۱۶۲۳۱) حدَّثَنَا سُفیَان بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ : عَنْ سَعِیدٍ یَبْلُغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُسْتَأْمَرُ الْیَتِیمَۃُ فِی نَفْسِہَا وَصَمْتُہَا إقْرَارُہَا۔ (عبدالرزاق ۱۰۲۹۵)","","Musannaf Ibn Abi Shaybah 16231","","","كتاب النكاح"
"16232","(۱۶۲۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْیَتِیمَۃُ تُسْتَأْمَرُ فِی نَفْسِہَا ، فَإِنْ قَبِلَتْ فَہُوَ إذْنُہَا ، وَإِنْ أَبَتْ فَلاَ جَوَازَ عَلَیْہَا۔n(ابوداؤد ۲۰۸۶۔ احمد ۲/۲۵۹)","Hasan","Musannaf Ibn Abi Shaybah 16232","","","كتاب النكاح"
"16233","(۱۶۲۳۳) حَدَّثَنَا سَلاَّمٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّمَا یَتِیمَۃٍ خُطِبَتْ فَلاَ تُنْکَحُ حَتَّی تُسْتَأْمَرَ ، فَإِنْ ہِیَ أَقَرَّتْ فَلْتَنْکِحْ وَإِقْرَارُہَا سُکُوتُہَا ، وَإِنْ أَنْکَرَتْ فَلاَ تُنْکَحُ۔ (احمد ۴/۴۰۸۔ دارقطنی ۷۷)","","Musannaf Ibn Abi Shaybah 16233","","","كتاب النكاح"
"16234","(۱۶۲۳۴) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: قَالَ عُمَرُ: تُسْتَأْمَرُ الْیَتِیمَۃُ فِی نَفْسِہَا، فَرِضَاہَا أَنْ تَسْکُتَ۔","","Musannaf Ibn Abi Shaybah 16234","","","كتاب النكاح"
"16235","(۱۶۲۳۵) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عُمَرَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 16235","","","كتاب النكاح"
"16236","(۱۶۲۳۶) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ وَعُمَرَ وَشُرَیْحٍ قَالُوا : تُسْتَأْمَرُ الْیَتِیمَۃُ فِی نَفْسِہَا ، وَرِضَاہَا أَنْ تَسْکُتَ۔","Da'if","Musannaf Ibn Abi Shaybah 16236","","","كتاب النكاح"
"16237","(۱۶۲۳۷) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ أَنَّہُ کَانَ یَقُولُ إذَا زُوّجَت الْیَتِیمَۃُ فَإِنْ سَکَتَتْ فَہُوَ رِضَاہَا ، وَإِنْ کَرِہَتْ لَمْ تُزَوَّجْ۔","Da'if","Musannaf Ibn Abi Shaybah 16237","","","كتاب النكاح"
"16238","(۱۶۲۳۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ عن شریح قَالَ : إِنْ سَکَتَتْ وَرَضِیَتْ فَقَدْ سَلَّمَتْ ، وَإِنْ کَرِہَتْ ومعضت لَمْ تُنْکَحْ۔","","Musannaf Ibn Abi Shaybah 16238","","","كتاب النكاح"
"16239","(۱۶۲۳۹) حَدَّثَنَا ہُشَیْمٌ وَجَرِیرٌ کِلاَہُمَا ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی الْیَتِیمَۃِ إذَا زُوِّجَتْ قَالَ : فَإِنْ سَکَتَتْ ، أَوْ بَکَتْ فَہُوَ رِضَاہَا ، وَإِنْ کَرِہَتْ لَمْ تَزَوَّجْ ، وَلَمْ یَذْکُرْ جَرِیرٌ کَرِہَتْ۔ (احمد ۴/۳۹۴۔ ابن حبان ۴۰۸۵)","","Musannaf Ibn Abi Shaybah 16239","","","كتاب النكاح"
"16240","(۱۶۲۴۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُہُ یَقُولُ فِی الْیَتِیمَۃِ : إذَا زُوِّجَتْ فَضَحِکَتْ ، أَوْ بَکَتْ ، أَوْ سَکَتَتْ فَہُوَ رِضَاہَا۔","","Musannaf Ibn Abi Shaybah 16240","","","كتاب النكاح"
"16241","(۱۶۲۴۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ قَالَ : حدَّثَنَا أَبُو بُرْدَۃَ ، قَالَ : قَالَ أَبُو مُوسَی : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُسْتَأْمَرُ الْیَتِیمَۃُ فِی نَفْسِہَا ، فَإِنْ سَکَتَتْ فَقَدْ أَذِنَتْ ، وَإِنْ أَنْکَرَتْ لَمْ تُنْکَحْ۔","Hasan","Musannaf Ibn Abi Shaybah 16241","","","كتاب النكاح"
"16242","(۱۶۲۴۲) حَدَّثَنَا حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَنْکَحَ الْوَلِیَّانِ فَہِیَ لِلأَوَّلِ۔ (مسلم ۷۔ ابن ماجہ ۲۱۹۰)","Hasan","Musannaf Ibn Abi Shaybah 16242","","","كتاب النكاح"
"16243","(۱۶۲۴۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃَ : ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إذَا أَنْکَحَ الْوَلِیَّانِ فَہِیَ لِلأَوَّلِ۔ (ابوداؤد ۲۰۸۱۔ ابن ماجہ ۲۱۹۱)","Da'if","Musannaf Ibn Abi Shaybah 16243","","","كتاب النكاح"
"16244","(۱۶۲۴۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ أَنَّ امْرَأَۃً زَوَّجَہَا وَلِیٌّ لَہَا بِالْکُوفَۃِ عُبَیْدُ اللہِ ، وَتَزَوَّجَہَا بِالشَّامِ رَجُلٌ آخَرُ قَبْلَ عُبَیْدِ اللہِ ، قَالَ : فَقَدِمَ الرَّجُلُ ، فَخَاصَمَ عُبَیْدَ اللہِ إلَی عَلِیٍّ فَقَضَی بِہَا علی لِلأَوَّلِ بَعْدَ مَا ولدت للآخَرِ۔","","Musannaf Ibn Abi Shaybah 16244","","","كتاب النكاح"
"16245","(۱۶۲۴۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : اِلأَوَّلِ عُبَیْدِ اللہِ۔","","Musannaf Ibn Abi Shaybah 16245","","","كتاب النكاح"
"16246","(۱۶۲۴۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ وَأَشْعَثَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ قَالَ : إذَا أَنْکَحَ الْوَلِیَّانِ فَالنِّکَاحُ لِلأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 16246","","","كتاب النكاح"
"16247","(۱۶۲۴۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ ہَارُونَ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ فِی الْوَلِیَّیْنِ یُزَوِّجَانِ ، قَالَ: تُخَیَّرُ۔","","Musannaf Ibn Abi Shaybah 16247","","","كتاب النكاح"
"16248","(۱۶۲۴۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ قَالَ : إذَا أَنْکَحَ مُجِیزَانِ فَہِیَ لِلأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 16248","","","كتاب النكاح"
"16249","(۱۶۲۴۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ ثَابِتِ بْنِ قَیْسٍ الْغِفَارِیِّ قَالَ : کَتَبْت إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی جَارِیَۃٍ مِنْ جُہَیْنَۃَ زَوَّجَہَا وَلِیُّہَا رَجُلاً مِنْ قَیْسٍ ، وَزَوَّجَہَا أخوہا رَجُلاً مِنْ جُہَیْنَۃَ ، فَکَتَبَ عُمَرُ بْنُ عَبْدَ الْعَزِیزِ أَنْ أَدْخِلْ عَلَیْہَا شُہُودًا عُدُولاً ثم خَیِّرْہَا ، فَأَیَّہُمَا اخْتَارَتْ فَہُوَ زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 16249","","","كتاب النكاح"
"16250","(۱۶۲۵۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عن سفیان ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ فِی أَخَوَیْنِ زَوَّجَا أُخْتًا لَہُمَا قَالَ تُخَیَّرَ۔","","Musannaf Ibn Abi Shaybah 16250","","","كتاب النكاح"
"16251","(۱۶۲۵۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ فِی الْوَلِیَّیْنِ إِذَا زَوَّجَا قَالَ أَیّہُمَا رَضِیَتْ فَہُوَ زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 16251","","","كتاب النكاح"
"16252","(۱۶۲۵۲) حدَّثَنَا مُعْتَمِرٌ عن سلیمان ، عَنْ سَلْمِ بْنِ أَبِی الذَّیَّالِ قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فِی الْیَتِیمَیْنِ : إذَا زُوِّجَا وَہُمَا صَغِیرَانِ أَنَّہُمَا بِالْخِیَارِ۔","","Musannaf Ibn Abi Shaybah 16252","","","كتاب النكاح"
"16253","(۱۶۲۵۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : لَہَا الْخِیَارُ۔","","Musannaf Ibn Abi Shaybah 16253","","","كتاب النكاح"
"16254","(۱۶۲۵۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : ہِیَ بِالْخِیَارِ۔","","Musannaf Ibn Abi Shaybah 16254","","","كتاب النكاح"
"16255","(۱۶۲۵۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ زَمْعَۃَ، عَنِ ابْنِ طَاوُوسٍ، عَنْ أَبِیہِ قَالَ: فِی الصَّغِیرَتَیْنِ، قَالَ: ہُمَا بِالْخِیَارِ إذَا شَبَّا۔","","Musannaf Ibn Abi Shaybah 16255","","","كتاب النكاح"
"16256","(۱۶۲۵۶) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ فِی وَلِیِّ الْیَتِیمَۃِ إذَا زَوَّجَہَا وَہِیَ صَغِیرَۃٌ قَالَ : النِّکَاحُ جَائِزٌ ، وَلَہَا الْخِیَارُ۔","","Musannaf Ibn Abi Shaybah 16256","","","كتاب النكاح"
"16257","(۱۶۲۵۷) حَدَّثَنَا عَبَّادٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ قَالَ : النِّکَاحُ جَائِزٌ وَلاَ خِیَارَ لَہَا۔","","Musannaf Ibn Abi Shaybah 16257","","","كتاب النكاح"
"16258","(۱۶۲۵۸) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ قَالَ : خَطَبَ رَجُلٌ سَیِّدَۃً مِنْ بَنِی لَیْثٍ ثَیِّبًا ، فَأَبَی أَبُوہَا أَنْ یُزَوِّجَہَا ، فَکَتَبْت إلَی عُثْمَانَ ، فَکَتَبَ عُثْمَانُ : إِنْ کُفُؤًا فَقُولُوا لأَبِیہَا أَنْ یُزَوِّجَہَا ، فَإِنْ أَبَی أَبُوہَا فَزَوِّجُوہَا۔","","Musannaf Ibn Abi Shaybah 16258","","","كتاب النكاح"
"16259","(۱۶۲۵۹) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ قَالَ : إذَا اخْتَلَفَ الْوَلِیُّ وَالْمَرْأَۃُ نَظَرَ السُّلْطَانُ ، فَإِنْ کَانَ الْوَلِیُّ مُضَارًّا زَوَّجَہَا وَإِلاَّ رُدَّ أَمْرُہَا إلَی وَلِیِّہَا۔","","Musannaf Ibn Abi Shaybah 16259","","","كتاب النكاح"
"16260","(۱۶۲۶۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی جَعْفَرٍ الأَشْجَعِیِّ أَنَّ امْرَأَۃً أَتَتْ شُرَیْحًا مَعَہَا أُمُّہَا وَعَمُّہَا ، فَأَرَادَتِ الأُمُّ رَجُلاً وَأَرَادَ الْعَمُّ رَجُلاً ، فَخَیَّرَہَا شُرَیْحٌ ، فَاخْتَارَتِ الَّذِی اخْتَارَتْ أُمُّہَا ، فَقَالَ شُرَیْحٌ لِلْعَمِّ : تَأْذَنْ ؟ قَالَ : لاَ وَاللَّہِ لاَ آذَنُ قَالَ : أَتَأْذَنُ قَبْلَ أَنْ لاَ یَکُونَ لَکَ إذْنٌ ؟ قَالَ : لاَ وَاللَّہِ لاَ آذَنُ ، قَالَ شُرَیْحٌ : اذْہَبِی فأَنْکِحِی ابْنَتَکَ مَنْ شِئْت۔","","Musannaf Ibn Abi Shaybah 16260","","","كتاب النكاح"
"16261","(۱۶۲۶۱) حدَّثَنَا ابْنُ عَیَّاشٍ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَمَّنْ حَدَّثَہُ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَنْکَحَ الرَّجُلُ ابْنَہُ وَہُوَ کَارِہٌ فَلَیْسَ بِنِکَاحٍ ، وَإِذَا زَوَّجَہُ وَہُوَ صَغِیرٌ جَازَ نِکَاحُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 16261","","","كتاب النكاح"
"16262","(۱۶۲۶۲) حدَّثَنَا مُطَرِّفٌ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ قَالَ : إذَا زَوَّجَ الرَّجُلُ ابْنَہُ ، أَوِ ابْنَتَہُ فَالْخِیَارُ لَہُمَا إذَا شَبَّا۔","","Musannaf Ibn Abi Shaybah 16262","","","كتاب النكاح"
"16263","(۱۶۲۶۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، وَالْحَسَنِ وَقَتَادَۃَ قَالُوا : إذَا أَنْکَحَ الصِّغَارَ آبَاؤُہُمْ جَازَ نِکَاحُہُمْ۔","","Musannaf Ibn Abi Shaybah 16263","","","كتاب النكاح"
"16264","(۱۶۲۶۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : إذَا زَوَّجَ الرَّجُلُ ابْنَہُ وَہُوَ صَغِیرٌ فَتَزْوِیجُہُ جَائِزٌ عَلَیْہِ ، وَالصَّدَاقُ عَلَی الابْنِ۔","","Musannaf Ibn Abi Shaybah 16264","","","كتاب النكاح"
"16265","(۱۶۲۶۵) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : لاَ یُجْبِرُ عَلَی النِّکَاحِ إلاَّ الأَبُ۔","","Musannaf Ibn Abi Shaybah 16265","","","كتاب النكاح"
"16266","(۱۶۲۶۶) حَدَّثَنَا عُبَیْدِ اللہِ بْنُ مُوسَی ، عَنِ الْحَسَنِ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ قَالَ : إذَا أَنْکَحَ الرَّجُلُ ابْنَہُ وَہُوَ صَغِیرٌ فَنِکَاحُہُ جَائِزٌ وَلاَ طَلاَقَ لَہُ۔","","Musannaf Ibn Abi Shaybah 16266","","","كتاب النكاح"
"16267","(۱۶۲۶۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ، قَالَ : قَالَ شُرَیْحٌ : إذَا أَنْکَحَ الرَّجُلُ ابْنَہُ وَہُوَ صَغِیرٌ جَازَ عَلَیْہِ فَإِذَا بَلَغَ فَإِنْ طَلَّقَ فَنِصْفُ الْمَہْرِ عَلَی الَّذِی کَفَلَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16267","","","كتاب النكاح"
"16268","(۱۶۲۶۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : الصَّدَاقُ عَلَی الابْنِ۔","","Musannaf Ibn Abi Shaybah 16268","","","كتاب النكاح"
"16269","(۱۶۲۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنِ الرَّجُلِ یُزَوِّجُ ابْنَہُ وَہُوَ صَغِیرٌ ، قَالَ الْحَکَمُ: ہو عَلَی اِلابْنِ، وَقَالَ حَمَّادٌ: ہُوَ عَلَی الأَبِ ، وَقَالَ قَتَادَۃُ : قَالَ ابْنُ عُمَرَ ہُوَ عَلَی الَّذِی أَنْکَحْتُمُوہُ، یَعْنِی : الصَّدَاقَ عَلَی اِلابْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 16269","","","كتاب النكاح"
"16270","(۱۶۲۷۰) حَدَّثَنَا حُمَیْدٌ ، عَنِ الْحَسَنِ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ قَالَ : ہُوَ عَلَی الأَبِ۔","","Musannaf Ibn Abi Shaybah 16270","","","كتاب النكاح"
"16271","(۱۶۲۷۱) حدَّثَنَا ہُشَیْمٌ ، عَنْ عَوْفٍ ، عَنْ أَنَسٍ قَالَ : کَانَ إذَا زَوَّجَ امْرَأَۃً مِنْ بَنَاتِہِ ، أَوِ امْرَأَۃً مِنْ بَعْضِ أَہْلِہِ قَالَ لِزَوْجِہَا : أُزَوِّجُک تُمْسِکُ بِمَعْرُوفٍ ، أَوْ تُسَرِّحُ بِإِحْسَانٍ۔","","Musannaf Ibn Abi Shaybah 16271","","","كتاب النكاح"
"16272","(۱۶۲۷۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ أَنَّ ابْنَ عَبَّاسٍ کَانَ إذَا زَوَّجَ اشْتَرَطَ : {إمْسَاکٌ بِمَعْرُوفٍ ، أَوْ تَسْرِیحٌ بإحسان}۔","Sahih","Musannaf Ibn Abi Shaybah 16272","","","كتاب النكاح"
"16273","(۱۶۲۷۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ أَنَّ ابْنَ عُمَرَ کَانَ إذَا أَنْکَحَ قَالَ : أُنْکِحُک عَلَی مَا قَالَ اللَّہُ : {إمْسَاکٌ بِمَعْرُوفٍ ، أَوْ تَسْرِیحٌ بِإِحْسَانٍ}۔","Sahih","Musannaf Ibn Abi Shaybah 16273","","","كتاب النكاح"
"16274","(۱۶۲۷۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ قَالَ : أَخْبَرَنِی سُلَیْمَانُ أَنَّہُ خَطَبَ إلَی ابْنِ عُمَرَ مَوْلاَۃً لَہُ ، فَقَالَ لَہُ مِثْلَ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 16274","","","كتاب النكاح"
"16275","(۱۶۲۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : سَأَلْتُہ ، فَقُلْتُ : أَکَانُوا یَشْتَرِطُونَ عِنْدَ عُقْدَۃِ النِّکَاحِ : {إمْسَاکٌ بِمَعْرُوفٍ ، أَوْ تَسْرِیحٌ بِإِحْسَانٍ} ؟ قَالَ ، فَقَالَ : ذَلِکَ لَہُمْ ، وَإِنْ لَمْ یَشْتَرِطُوا مَا کَانَ أَصْحَابُنَا یَشْتَرِطُونَ۔","","Musannaf Ibn Abi Shaybah 16275","","","كتاب النكاح"
"16276","(۱۶۲۷۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ جُوَیْبر ، عَنِ الضَّحَّاکِ {وَأَخَذْنَ مِنْکُمْ مِیثَاقًا غَلِیظًا} قَالَ : {إمْسَاکٌ بِمَعْرُوفٍ، أَوْ تَسْرِیحٌ بِإِحْسَانٍ}۔","","Musannaf Ibn Abi Shaybah 16276","","","كتاب النكاح"
"16277","(۱۶۲۷۷) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ {وَأَخَذْنَ مِنْکُمْ مِیثَاقًا غَلِیظًا} قَالَ: {إمْسَاکٌ بِمَعْرُوفٍ ، أَوْ تَسْرِیحٌ بِإِحْسَانٍ}۔","","Musannaf Ibn Abi Shaybah 16277","","","كتاب النكاح"
"16278","(۱۶۲۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ، عَنْ سَالِمٍ ، عَنْ مُجَاہِدٍ {وَأَخَذْنَ مِنْکُمْ مِیثَاقًا غَلِیظًا} قَالَ: عُقْدَۃُ النِّکَاحِ، قَالَ : قَوْلُہُ : قَدْ نکحت۔","","Musannaf Ibn Abi Shaybah 16278","","","كتاب النكاح"
"16279","(۱۶۲۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عِکْرِمَۃَ ، وَمُجَاہِدٍ {وَأَخَذْنَ مِنْکُمْ مِیثَاقًا غَلِیظًا} قَالَ : أَخَذْتُمُوہُنَّ بِأَمَانَۃِ اللہِ وَاسْتَحْلَلْتُمْ فُرُوجَہُنَّ بِکَلِمَۃِ اللہِ۔","","Musannaf Ibn Abi Shaybah 16279","","","كتاب النكاح"
"16280","(۱۶۲۸۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنِ ابْنِ عَبَّاسٍ {وَأَخَذْنَ مِنْکُمْ مِیثَاقًا غَلِیظًا} قَالَ : {إمْسَاکٌ بِمَعْرُوفٍ ، أَوْ تَسْرِیحٌ بِإِحْسَانٍ}۔","Sahih","Musannaf Ibn Abi Shaybah 16280","","","كتاب النكاح"
"16281","(۱۶۲۸۱) حدَّثَنَا ہُشَیْمٌ، عَنْ مَنْصُورٍ، عَنِ الْحَسَنِ قَالَ: کَانَ لاَ یَرَی بَأْسًا أنْ یُزَوِّجَ الرَّجُلُ عَبْدَہُ أَمَتَہُ بِغَیْرِ مَہْرٍ وَلاَ بَیِّنَۃٍ۔","","Musannaf Ibn Abi Shaybah 16281","","","كتاب النكاح"
"16282","(۱۶۲۸۲) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ فِی الرَّجُلِ یُزَوِّجُ عَبْدَہُ أَمَتَہُ بِغَیْرِ شُہُودٍ قَالَ : یُشْہِد أَحَبُّ إلَیَّ ، وَإِنْ لَمْ یَفْعَلْ فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 16282","","","كتاب النكاح"
"16283","(۱۶۲۸۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : کَانُوا یُکْرِہُونَ الْمَمْلُوکَیْنِ عَلَی النِّکَاحِ وَیُغْلِقُونَ عَلَیْہِمَا الْبَابَ۔","","Musannaf Ibn Abi Shaybah 16283","","","كتاب النكاح"
"16284","(۱۶۲۸۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ یُزَوِّجَ الرَّجُلُ أَمَتَہُ عَبْدَہُ بِغَیْرِ مَہْرٍ۔","","Musannaf Ibn Abi Shaybah 16284","","","كتاب النكاح"
"16285","(۱۶۲۸۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی فَاطِمَۃَ قَالَ : سَأَلْتُ ابْنَ سِیرِینَ قَالَ : قُلْتُ : رَجُلٌ قَالَ لِمَمْلُوکِہِ : دُونَک جَارِیَتِی ہَذِہِ فُلاَنَۃُ ، فَإِنْ أَحْبَبْت أَنْ تَتَّخِذَہَا لِنَفْسِکَ وَإِلاَّ فَبِعْہَا وَرُدَّ عَلَیَّ ثَمَنَہَا ، قَالَ : اکْسُہَا ثَوْبًا۔","","Musannaf Ibn Abi Shaybah 16285","","","كتاب النكاح"
"16286","(۱۶۲۸۶) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ أَنَّ عَلِیًّا کَانَ یَقُولُ : لاَ یَنْکِحُ الْعَبْدُ فَوْقَ اثْنَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16286","","","كتاب النكاح"
"16287","(۱۶۲۸۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ فِی الْعَبْدِ قَالَ : یَتَزَوَّجُ أَرْبَعًا ، وَقَالَ عَطَائٌ : اثْنَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16287","","","كتاب النكاح"
"16288","(۱۶۲۸۸) حَدَّثَنَا جَرِیرٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : لاَ یَتَزَوَّجُ الْمَمْلُوکُ إلاَّ امْرَأَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16288","","","كتاب النكاح"
"16289","(۱۶۲۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : یَتَزَوَّجُ اثْنَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16289","","","كتاب النكاح"
"16290","(۱۶۲۹۰) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یُونُسَ ، عَنْ مُحَمَّدٍ فِی الرَّجُلِ الْمَمْلُوکِ : یُکْرَہُ لَہُ أَنْ یَجْمَعَ أَکْثَرَ مِنَ اثْنَتَیْنِ ، وَلاَ یُذْکَرُ إمَائً کُنَّ ، أَوْ حَرَائِرَ ، إِنَّمَا مَالُہُ مَالُ مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 16290","","","كتاب النكاح"
"16291","(۱۶۲۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : یَتَزَوَّجُ اثْنَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16291","","","كتاب النكاح"
"16292","(۱۶۲۹۲) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ قَالَ : إذَا أَذِنَ الرَّجُلُ لِعَبْدِہِ فِی الْجَارِیَۃِ یَشْتَرِیہَا أَنْ یَطَأَہَا فَہُوَ نِکَاحٌ مِنَ السَّیِّدِ ، وَلاَ یَطَأُ فَوْقَ اثْنَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16292","","","كتاب النكاح"
"16293","(۱۶۲۹۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : قَالَ عُمَرُ : مَنْ یَعْلَمُ مَا یَحِلُّ لِلْمَمْلُوکِ مِنَ النِّسَائِ ؟ قَالَ رَجُلٌ : أَنَا ، قَالَ : کَمْ ؟ قَالَ : امْرَأَتَیْنِ ، فَسَکَتَ۔","","Musannaf Ibn Abi Shaybah 16293","","","كتاب النكاح"
"16294","(۱۶۲۹۴) حَدَّثَنَا زیدُ بْنُ حُبَابٍ ، عَنِ ابْنِ لَہِیعَۃَ ، عَنْ خَالِدِ بْنِ أَبِی عِمْرَانَ قَالَ : سَأَلْتُ سالِمًا وَالْقَاسِمَ ، عَنِ الْعَبْدِ ، کَمْ یَتَزَوَّجُ ؟ فَقَالاَ : أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 16294","","","كتاب النكاح"
"16295","(۱۶۲۹۵) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ قَالَ : أَجْمَعَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی أَنَّ الْمَمْلُوکَ لاَ یَجْمَعُ مِنَ النِّسَائَ فَوْقَ اثْنَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 16295","","","كتاب النكاح"
"16296","(۱۶۲۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : یَتَزَوَّجُ الْمَمْلُوکُ فَوْقَ اثْنَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16296","","","كتاب النكاح"
"16297","(۱۶۲۹۷) حدَّثَنَا وَکِیعُ بن الجرَّاح ، عَنْ سُفیَان ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالاَ : إذَا تَزَوَّجَ الْعَبْدُ بِغَیْرِ إذْنِ مَوْلاَہُ ثُمَّ أَذِنَ الْمَوْلَی فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 16297","","","كتاب النكاح"
"16298","(۱۶۲۹۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ قَالَ : إذَا أَجَازَہُ الْمَوْلَی فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 16298","","","كتاب النكاح"
"16299","(۱۶۲۹۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ فِی الْعَبْدِ یَتَزَوَّجُ بِغَیْرِ إذْنِ سَیِّدِہِ ، قَالاَ : إِنْ شَائَ أَجَازَ النِّکَاحَ سَیِّدُہُ ، وَإِنْ شَائَ رَدَّہُ۔","","Musannaf Ibn Abi Shaybah 16299","","","كتاب النكاح"
"16300","(۱۶۳۰۰) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : قَالَ : إِنْ أَجَازَہُ المولی جَازَ ، وَقَالَ حَمَّادُ : یَسْتَأْنِفُ النِّکَاحَ۔","","Musannaf Ibn Abi Shaybah 16300","","","كتاب النكاح"
"16301","(۱۶۳۰۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ قَالَ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ ثُمَّ تَزَوَّجَہَا عَبْدٌ بِغَیْرِ إذْنِ مَوَالِیہِ فَدَخَلَ بِہَا ، قَالَ الْحَسَنُ : لَیْسَ بِزَوْجٍ۔","","Musannaf Ibn Abi Shaybah 16301","","","كتاب النكاح"
"16302","(۱۶۳۰۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ مِثْلَ قَوْلِ الْحَسَنِ ، وَقَالَ الْحَکَمُ : ہُوَ زَوْجٌ وَلَہُ أَنْ یُرَاجِعَہَا۔","","Musannaf Ibn Abi Shaybah 16302","","","كتاب النكاح"
"16303","(۱۶۳۰۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی الْمَرْأَۃِ تُطْلَقُ ثَلاَثًا فَیَتَزَوَّجُہَا عَبْدٌ بِغَیْرِ إذْنِ مَوَالِیہِ ، قَالَ : قَالَ عَطَائٌ : کُلُّ نِکَاحٍ عَلَی غَیْرِ وَجْہِ نِکَاحٍ فَإِنَّہَا لاَ تَرْجِعُ إلَی زَوْجِہَا الأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 16303","","","كتاب النكاح"
"16304","(۱۶۳۰۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنِ الْحَارِثِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تَرْجِعُ إلَیْہِ ، لأَنَّہُ نِکَاحٌ لَیْسَ رِشْدَۃً۔","","Musannaf Ibn Abi Shaybah 16304","","","كتاب النكاح"
"16305","(۱۶۳۰۵) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ جَریر ، عَنْ حَمَّادٍ قَالَ : لاَ یَحِلُّ لَہَا أنْ تَرْجِعَ بِہِ إلَی زَوْجِہَا الأَوَّلِ حَتَّی تُنْکَحَ نِکَاحَ الْمُسْلِمِینَ الَّذِی یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 16305","","","كتاب النكاح"
"16306","(۱۶۳۰۶) حَدَّثَنَا عَفَّانَ قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ قَالَ : حدَّثَنَا لَیْثٌ ، عَنْ طَاوُوسٍ قَالَ : کُلُّ نِکَاحٍ کَانَ بِغَیْرِ سُنَّۃٍ فَإِنَّ الْمَرْأَۃَ لاَ تَحِلُّ لِزَوْجِہَا الأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 16306","","","كتاب النكاح"
"16307","(۱۶۳۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ فِی الْعَبْدِ وَالْخَصِیِّ قَالَ : ہُوَ زَوْجٌ۔","","Musannaf Ibn Abi Shaybah 16307","","","كتاب النكاح"
"16308","(۱۶۳۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فِی الْحُرِّ یَتَزَوَّجُ الأَمَۃَ قَالَ : مَا ازْلَحَفَّ ، عَنِ الزِّنَا إلاَّ قَلِیلاً لِقَوْلِہِ : {وَأَنْ تَصْبِرُوا خَیْرٌ لَکُمْ} قَالَ : یَقُول ، عَنْ نِکَاحِ الأَمَۃِ۔","","Musannaf Ibn Abi Shaybah 16308","","","كتاب النكاح"
"16309","(۱۶۳۰۹) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ، عَمَّنْ حَدَّثَہُ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا تَزَحَّفَ ، عَنِ الزِّنَا إلاَّ قَلِیلاً۔","Da'if","Musannaf Ibn Abi Shaybah 16309","","","كتاب النكاح"
"16310","(۱۶۳۱۰) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَکْرَہُ تَزْوِیج الأَمَۃِ مَا قَدَرَ عَلَی الْحُرَّۃِ إلاَّ أَنْ یَخْشَی الْعَنَتَ۔","","Musannaf Ibn Abi Shaybah 16310","","","كتاب النكاح"
"16311","(۱۶۳۱۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو قَالَ : سَأَلَ عَطَائٌ جَابِرًا ، عَنِ نِکَاحِ الأَمَۃِ ، فَقَالَ : لاَ یَصْلُحُ الْیَوْمَ۔","Sahih","Musannaf Ibn Abi Shaybah 16311","","","كتاب النكاح"
"16312","(۱۶۳۱۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ قَالَ : لاَ یَصْلُحُ لِلْحُرِّ أَنْ یَتَزَوَّجَ الأَمَۃَ إلاَّ أَنْ لاَ یَجِدَ طَوْلاً۔","","Musannaf Ibn Abi Shaybah 16312","","","كتاب النكاح"
"16313","(۱۶۳۱۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عُمَارَۃَ بْنَ حَیَّانَ أَنَّ امْرَأَۃً أَتَتْ جَابِرَ بْنَ زَیْدٍ ، فَقَالَتْ : إنَّ رَجُلاً یَخْطُبُ عَلَیَّ أَمَتِی ، قَالَ : لاَ تُزَوِّجِیہِ قَالَتْ : فَإِنَّہُ یَخْشَی عَلَی نَفْسِہِ ، قَالَ : لاَ تُزَوِّجِیہِ ، قَالَتْ : فَإِنَّہُ یَخْشَی أَنْ یَزْنِیَ بِہَا ، قَالَ : فَزَوِّجِیہِ۔","","Musannaf Ibn Abi Shaybah 16313","","","كتاب النكاح"
"16314","(۱۶۳۱۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمَ وَحَمَّادٍ سُئِلاَ ، عَنْ نِکَاحِ الأَمَۃِ فَقَالاَ : {لِمَنْ خَشِیَ الْعَنَتَ مِنْکُمْ}۔","","Musannaf Ibn Abi Shaybah 16314","","","كتاب النكاح"
"16315","(۱۶۳۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : إنَّہُ مِمَّا وُسِّعَ بِہِ عَلَی ہَذِہِ الأُمَّۃِ ، نِکَاحُ الأَمَۃِ وَالنَّصْرَانِیَّۃ۔","","Musannaf Ibn Abi Shaybah 16315","","","كتاب النكاح"
"16316","(۱۶۳۱۶) حَدَّثَنَا عبد اللہ بْنُ إدْرِیسَ ، عَنْ یحیی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ عُمَرُ : أَیُّمَا عَبْدٍ نَکَحَ حُرَّۃً فَقَدْ أُعْتِقَ نِصْفُہُ ، وَأَیُّمَا حُرٍّ نَکَحَ أَمَۃً فَقَدْ أَرِقَ نِصْفَہُ۔","","Musannaf Ibn Abi Shaybah 16316","","","كتاب النكاح"
"16317","(۱۶۳۱۷) حَدَّثَنَا الْفَضْلُ ، عَنْ شَرِیکٍ ، عَنْ خُصَیفِ ، عَنْ عَامِرٍ قَالَ : نِکَاحُ الأَمَۃِ کَالْمَیْتَۃِ وَالدَّمِ وَلَحْمِ الْخِنْزِیرِ، لاَ یَحِلُّ إلاَّ لِلْمُضْطَرِّ۔","","Musannaf Ibn Abi Shaybah 16317","","","كتاب النكاح"
"16318","(۱۶۳۱۸) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ عَطَائٍ وَخُصَیْفٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یَتَزَوَّجُ الْحُرُّ مِنَ الإِمَائِ إلاَّ وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 16318","","","كتاب النكاح"
"16319","(۱۶۳۱۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی ہَاشِمٍ ، عَنِ الْحَارِثِ قَالَ : قَالَ : یَتَزَوَّجُ الْحُرُّ مِنَ الإِمَائِ أَرْبَعَۃً ، وَقَالَ حَمَّادٌ : ثِنْتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16319","","","كتاب النكاح"
"16320","(۱۶۳۲۰) حَدَّثَنَا رُوحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ: یَتَزَوَّجُ الْحُرُّ أَرْبَعَ إمَائٍ وَأَرْبَعَ نَصْرَانِیَّاتٍ، وَالْعَبْدُ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16320","","","كتاب النكاح"
"16321","(۱۶۳۲۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ قَالَ : إنَّمَا أَحَلَّ اللَّہُ وَاحِدَۃً لِمَنْ خَشِیَ الْعَنَتَ عَلَی نَفْسِہِ وَلَمْ یَجِدُ طَوْلاً۔","","Musannaf Ibn Abi Shaybah 16321","","","كتاب النكاح"
"16322","(۱۶۳۲۲) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامِ الدَّسْتَوَائِیِّ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی أَنْ تُنْکَحَ الأَمَۃ عَلَی الْحُرَّۃِ۔ (عبدالرزاق ۱۳۰۹۹۔ طبرانی ۱۷)","Da'if","Musannaf Ibn Abi Shaybah 16322","","","كتاب النكاح"
"16323","(۱۶۳۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : لاَ یَنْکِحُ الأَمَۃَ عَلَی الْحُرَّۃِ فَإِنْ فَعَلَ ذَلِکَ لَمْ یُتْرَکْ۔","","Musannaf Ibn Abi Shaybah 16323","","","كتاب النكاح"
"16324","(۱۶۳۲۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ قَالَ : لاَ یَتَزَوَّجُ الرَّجُلُ الأَمَۃَ عَلَی الْحُرَّۃِ ، وَیَتَزَوَّجُ الْحُرَّۃَ عَلَی الأَمَۃِ۔","","Musannaf Ibn Abi Shaybah 16324","","","كتاب النكاح"
"16325","(۱۶۳۲۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْمِنْہَالِ ، عَنْ زِرٍّ أَو عَبَّادِ بْنِ عَبْدِ اللہِ ، عَنْ عَلِیٍّ قَالَ : لاَ تُنْکَحُ الأَمَۃُ عَلَی الْحُرَّۃِ ، وَتُنْکَحُ الْحُرَّۃُ عَلَی الأَمَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 16325","","","كتاب النكاح"
"16326","(۱۶۳۲۶) حَدَّثَنَا وَکِیعٌ، عَنْ إسْمَاعِیلَ، عَنِ الشَّعْبِیِّ، عَنْ مَسْرُوقٍ قَالَ: لاَ یَنْکِحُ الأَمَۃَ عَلَی الْحُرَّۃِ إلاَّ الْمَمْلُوکُ۔","","Musannaf Ibn Abi Shaybah 16326","","","كتاب النكاح"
"16327","(۱۶۳۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ قَالَ : إلاَّ الْمَمْلُوکَ۔","Da'if","Musannaf Ibn Abi Shaybah 16327","","","كتاب النكاح"
"16328","(۱۶۳۲۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ ابْنِ الْمُسَیَّبِ قَالَ : یَتَزَوَّجُ الْحُرَّۃَ عَلَی الأَمَۃِ ، وَلاَ یَتَزَوَّجُ الأَمَۃَ عَلَی الْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 16328","","","كتاب النكاح"
"16329","(۱۶۳۲۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الملک ، عَنْ عَطَائٍ فِی الرَّجُلِ یَنْکِحُ الْحُرَّۃَ عَلَی الأَمَۃِ قَالَ : حسَنٌ۔","","Musannaf Ibn Abi Shaybah 16329","","","كتاب النكاح"
"16330","(۱۶۳۳۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ قَالَ : قُلْتُ لأَبِی : رَجُلٌ نَکَحَ أَمَۃً عَلَی حُرَّۃٍ وَإِنَّہُ یُزْعَمُ إِنَّہُ قَدْ حَرُمَتْ عَلَیْہِ ؟ قَالَ : صَدَقُوا۔","","Musannaf Ibn Abi Shaybah 16330","","","كتاب النكاح"
"16331","(۱۶۳۳۱) حَدَّثَنَا عَبدَۃ بن سلیمان ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ فِی الرَّجُلِ یَتَزَوَّجُ الأَمَۃَ عَلَی الْحُرَّۃِ قَالاَ : یُفَرَّقُ بَیْنَہُ وَبَیْنَ الأَمَۃِ۔","","Musannaf Ibn Abi Shaybah 16331","","","كتاب النكاح"
"16332","(۱۶۳۳۲) حَدَّثَنَا حَکَّامٌ الرَّازِیّ ، عَنْ مُثَنَّی ، عَنِ الزُّہْرِیِّ فِی رَجُلٍ تَزَوَّجَ أَمَۃً عَلَی حُرَّۃٍ قَالَ : یُوجَعُ ظَہْرُہُ وَتُنْزَعُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 16332","","","كتاب النكاح"
"16333","(۱۶۳۳۳) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا تَزَوَّجَ الرَّجُلُ الْحُرَّۃَ عَلَی الأَمَۃِ فُرِّقَ بَیْنَہُ وَبَیْنَہَا إلاَّ أَنْ یَکُونَ لَہَا مِنْہُ وَلَدٌ۔","","Musannaf Ibn Abi Shaybah 16333","","","كتاب النكاح"
"16334","(۱۶۳۳۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نِکَاحُ الْحُرَّۃِ عَلَی الأَمَۃِ طَلاَقُ الأَمَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 16334","","","كتاب النكاح"
"16335","(۱۶۳۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ مِثْلَہُ إلاَّ أَنَّہُ قَالَ : ہِیَ کَالْمَیْتَۃِ یُضْطَرُّ إلَیْہَا ، فَإِذَا أَغْنَاک اللَّہُ فَاسْتَغْنِ۔","","Musannaf Ibn Abi Shaybah 16335","","","كتاب النكاح"
"16336","(۱۶۳۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ قَالَ : نِکَاحُ الْحُرَّۃِ عَلَی الأَمَۃِ طَلاَقُ الأَمَۃِ۔","","Musannaf Ibn Abi Shaybah 16336","","","كتاب النكاح"
"16337","(۱۶۳۳۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا تَزَوَّجَ الْحُرَّۃَ عَلَی الأَمَۃِ فَہُوَ لِلْمَمْلُوکَۃِ طَلاَقٌ۔","Sahih","Musannaf Ibn Abi Shaybah 16337","","","كتاب النكاح"
"16338","(۱۶۳۳۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، وَالْحَسَنِ فِی الرَّجُلِ یَتَزَوَّجُ الْمَمْلُوکَۃَ عَلَی الْیَہُودِیَّۃِ وَالنَّصْرَانِیَّۃ قَالاَ : یُفَرَّقُ بَیْنَہُ وَبَیْنَ الْمَمْلُوکَۃِ۔","","Musannaf Ibn Abi Shaybah 16338","","","كتاب النكاح"
"16339","(۱۶۳۳۹) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ فِی الرَّجُلِ تَکُونُ تَحْتَہُ الْمَرْأَۃُ النَّصْرَانِیَّۃُ : لاَ یَتَزَوَّجُ عَلَیْہَا أَمَۃً مُسْلِمَۃً۔","","Musannaf Ibn Abi Shaybah 16339","","","كتاب النكاح"
"16340","(۱۶۳۴۰) حدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یَتَزَوَّجُ الْیَہُودِیَّۃَ وَالنَّصْرَانِیَّۃ عَلَی الْمُسْلِمَۃِ یَعْنِی الْمُسْلِمَ۔","Hasan","Musannaf Ibn Abi Shaybah 16340","","","كتاب النكاح"
"16341","(۱۶۳۴۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنِ الْمِنْہَالِ ، عَنْ زِرٍّ ، عَنْ عَلِیٍّ قَالَ : إذَا تَزَوَّجَ الْحُرَّۃَ عَلَی الأَمَۃِ قَسَمَ لِذِہِ یَوْمًا وَلِذِہِ یَوْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 16341","","","كتاب النكاح"
"16342","(۱۶۳۴۲) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْمِنْہَالِ ، عَنْ زِرٍّ ، عَنْ عَلِیٍّ قَالَ : إذَا تَزَوَّجَ الْحُرَّۃَ عَلَی الأَمَۃِ قَسَمَ لِلأَمَۃِ یَوْمًا وَلِلْحُرَّۃِ یَوْمَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 16342","","","كتاب النكاح"
"16343","(۱۶۳۴۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 16343","","","كتاب النكاح"
"16344","(۱۶۳۴۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لِلْحُرَّۃِ یَوْمَانِ وَلَیْلَتَانِ ، وَلِلأَمَۃِ یَوْمٌ وَلَیْلَۃٌ۔","","Musannaf Ibn Abi Shaybah 16344","","","كتاب النكاح"
"16345","(۱۶۳۴۵) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ قَالَ : إذَا اجْتَمَعَتَا قَسَمَ لِلْحُرَّۃِ الثُّلُثَیْنِ مِنْ نَفْسِہِ وَمَالِہِ۔","","Musannaf Ibn Abi Shaybah 16345","","","كتاب النكاح"
"16346","(۱۶۳۴۶) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ وَعَنْ فِرَاسٍ ، عَنْ عَامِرٍ قَالاَ : یَتَزَوَّجُ الْحُرَّۃَ عَلَی الأَمَۃِ وَیُقَسِّمُ یَوْمًا ویومین۔","","Musannaf Ibn Abi Shaybah 16346","","","كتاب النكاح"
"16347","(۱۶۳۴۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : إذَا نُکِحَتِ الْحُرَّۃُ عَلَی الأَمَۃِ فُضِّلَتِ الْحُرَّۃُ ، فی الْقَسَمِ ، لِلْحُرَّۃِ لَیْلَتَانِ وَلِلأَمَۃِ لَیْلَۃٌ۔","","Musannaf Ibn Abi Shaybah 16347","","","كتاب النكاح"
"16348","(۱۶۳۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا نَکَحَ الأَمَۃَ ثُمَّ وَجَدَ مَا یَنْکِحُ الْحُرَّۃَ إِنْ شَائَ أَمْسَکَہَا وَیَقْسِمُ لَیْلَتَیْنِ وَلَیْلَۃً۔","","Musannaf Ibn Abi Shaybah 16348","","","كتاب النكاح"
"16349","(۱۶۳۴۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ قَالَ : یَقْسِمُ لِلْحُرَّۃِ یَوْمَیْنِ وَلِلأَمَۃِ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 16349","","","كتاب النكاح"
"16350","(۱۶۳۵۰) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : لِلْحُرَّۃِ یَوْمَانِ وَلِلأَمَۃِ یَوْمٌ۔","","Musannaf Ibn Abi Shaybah 16350","","","كتاب النكاح"
"16351","(۱۶۳۵۱) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : لِلْحُرَّۃِ یَوْمَانِ وَلِلأَمَۃِ یَوْمٌ۔","","Musannaf Ibn Abi Shaybah 16351","","","كتاب النكاح"
"16352","(۱۶۳۵۲) حَدَّثَنَا عَبدَۃ بن سلیمان ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، وَالْحَسَنِ فِیمَنْ یَتَزَوَّجُ الْیَہُودِیَّۃَ وَالنَّصْرَانِیَّۃ عَلَی الْمُسْلِمَۃِ قَالاَ : یَقْسِمُ بَیْنَہُمَا سَوَائً۔","","Musannaf Ibn Abi Shaybah 16352","","","كتاب النكاح"
"16353","(۱۶۳۵۳) حَدَّثَنَا مَعْنُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ : قسْمَتُہُمَا سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 16353","","","كتاب النكاح"
"16354","(۱۶۳۵۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ یَقْسِمُ لَہَا کَمَا یَقْسِمُ لِلْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 16354","","","كتاب النكاح"
"16355","(۱۶۳۵۵) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ فِی الرَّجُلِ یَتَزَوَّجُ الْمُسْلِمَۃَ وَالْیَہُودِیَّۃَ ، أَوِ النَّصْرَانِیَّۃَ قَالَ : یُسَوِّی بَیْنَہُمَا فِی الْقِسْمَۃِ مِنْ مَالِہِ وَنَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 16355","","","كتاب النكاح"
"16356","(۱۶۳۵۶) حَدَّثَنَا أَبُو خَالِدٍ وَلَیْسَ بِالأَحْمَرِ، عَنْ سَعِیدٍ قَالَ: سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنہُ فَقَالاَ: ہُمَا فِی الْقِسْمَۃِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 16356","","","كتاب النكاح"
"16357","(۱۶۳۵۷) حَدَّثَنَا ہُشَیْمٌ قَالَ : حدَّثَنَا یُونُسُ ، عَنِ الْحَسَنِ أَنَّہُ قَالَ : فِی صَدَاقِ السِّرِّ : إذَا أَعْلَنَ أَکْثَرَ مِنْہُ یُؤْخَذُ بِالسِّرِّ وَتَبْطُلُ الْعَلاَنِیَۃُ۔","","Musannaf Ibn Abi Shaybah 16357","","","كتاب النكاح"
"16358","(۱۶۳۵۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ قَالَ : یُؤْخَذُ بِالسِّرِّ وَتَبْطُلُ الْعَلاَنِیَۃُ۔","","Musannaf Ibn Abi Shaybah 16358","","","كتاب النكاح"
"16359","(۱۶۳۵۹) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : الأَمْرُ عَلَی السِّرِّ۔","","Musannaf Ibn Abi Shaybah 16359","","","كتاب النكاح"
"16360","(۱۶۳۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَنْصُورٍ قَالَ : سَأَلْتُ الْحَکَمَ بْنَ عُتَیبَۃَ ، عَنِ الرَّجُلِ أَصْدَقَ أَلْفًا فِی السِّرِّ وَأَعْلَنَ أَلْفَیْنِ قَالَ : یُؤْخَذُ بِالسِّرِّ لأَنَّہُ الْحَقُّ ، وَتُبْطَلُ الْعَلاَنِیَۃُ۔","","Musannaf Ibn Abi Shaybah 16360","","","كتاب النكاح"
"16361","(۱۶۳۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی عَوْنٍ ، عَنْ شُرَیْحٍ قَالَ : یُؤْخَذُ بِالأَوَّلِ مِنہُمَا۔","","Musannaf Ibn Abi Shaybah 16361","","","كتاب النكاح"
"16362","(۱۶۳۶۲) حدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ قَالَ : یُؤْخَذُ بِالْعَلاَنِیَۃِ۔","","Musannaf Ibn Abi Shaybah 16362","","","كتاب النكاح"
"16363","(۱۶۳۶۳) حَدَّثَنَا ابْنُ مُسْہِرٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : یُؤْخَذُ بِالْعَلاَنِیَۃِ۔","","Musannaf Ibn Abi Shaybah 16363","","","كتاب النكاح"
"16364","(۱۶۳۶۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَنْصُورِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ : لَقِیتُ الشَّعْبِیَّ فَسَأَلْتُہُ ، عَنْ ذَلِکَ ، فَقَالَ قَالَ : شُرَیْحٌ ، ہَدَمَ الْعَلاَنِیَۃُ السِّرَّ۔","","Musannaf Ibn Abi Shaybah 16364","","","كتاب النكاح"
"16365","(۱۶۳۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ شُعَیب ، عَنْ أَبِی قِلاَبَۃَ قَالَ : یُؤْخَذُ بِالْعَلاَنِیَۃِ۔","","Musannaf Ibn Abi Shaybah 16365","","","كتاب النكاح"
"16366","(۱۶۳۶۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ والشَّعْبِیِّ قَالاَ : إذَا کَانَتِ الأَمَۃُ تَحْتَ الْحُرِّ فَاشْتَرَاہَا قَالاَ : النِّکَاحُ مُنْہَدِم ، وَتَکُونُ جَارِیَۃً لَہُ یَطَؤُہَا إِنْ شَائَ[corrupt]","","Musannaf Ibn Abi Shaybah 16366","","","كتاب النكاح"
"16367","(۱۶۳۶۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ تکون تحتہ الأَمَۃَ ثُمَّ یَشْتَرِیہَا قَالَ : أَذْہَبَ الرِّقُّ عُقْدَتَہَا۔","","Musannaf Ibn Abi Shaybah 16367","","","كتاب النكاح"
"16368","(۱۶۳۶۸) حَدَّثَنَا وَکِیعٌ بن الجراح ، عَنِ عَلِی بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مَکْحُولٍ فِی الرَّجُلِ یَتَزَوَّجُ الأَمَۃَ ثُمَّ یَشْتَرِیہَا قَالَ : یَطَؤُہَا بِالْمِلْکِ۔","","Musannaf Ibn Abi Shaybah 16368","","","كتاب النكاح"
"16369","(۱۶۳۶۹) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ قَالَ : یَطَؤُہَا بِالْمِلْکِ۔","","Musannaf Ibn Abi Shaybah 16369","","","كتاب النكاح"
"16370","(۱۶۳۷۰) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ قَالَ : سَأَلْتُ عَطَائً ، عَنِ الرَّجُلِ تَکُونُ تَحْتَہُ الأَمَۃُ فَیَشْتَرِیہَا قَالَ : ہِیَ أَمَتُہُ یَصْنَعُ بِہَا مَا شَائَ ، قَالَ : وَسَأَلْت الزُّہْرِیَّ ، فَقَالَ مِثْلِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16370","","","كتاب النكاح"
"16371","(۱۶۳۷۱) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ قَالَ : سَأَلْتُ الزُّہْرِیَّ ، عَنْ رَجُلٍ کَانَتْ تَحْتَہُ أَمَۃٌ فَاشْتَرَاہَا، قَالَ : ہَدَمَ الشِّرَائُ النِّکَاحَ ، قَالَ جَعْفَرٌ : وَسَأَلْت مَیْمُونَ بْنَ مِہْرَانَ ، عَنْ ذَلِکَ قَالَ : تَحِلُّ لَہُ مِنْ قِبَلِ بابین ، مِنْ قِبَلِ التَّزْوِیجِ وَمِنْ قِبَلِ الشِّرَائِ۔","","Musannaf Ibn Abi Shaybah 16371","","","كتاب النكاح"
"16372","(۱۶۳۷۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنْ رَجُلٍ کَانَتْ تَحْتَہُ أَمَۃٌ فَطَلَّقَہَا تَطْلِیقَۃً ثُمَّ أَعْتَقَ الْعَبْدَ فَاشْتَرَی امْرَأَتَہُ ، مَا مَنْزِلتُہَا ؟ قَالَ : إذَا اشْتَرَاہَا فَہِیَ بِمَنْزِلَۃِ السُّرِّیۃِ ، وَقَدْ أَفْتَی بِذَلِکَ عِکْرِمَۃُ وَالْحَسَنُ بن أبی الحسن۔","","Musannaf Ibn Abi Shaybah 16372","","","كتاب النكاح"
"16373","(۱۶۳۷۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَمَّنْ حَدَّثَہُ عَنْ عُثْمَانَ بْنِ عَفَّانَ وَزَیْدِ بْنِ ثَابِتٍ أَنَّہُمَا قَالاَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 16373","","","كتاب النكاح"
"16374","(۱۶۳۷۴) حَدَّثَنَا عَبَّاد بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ : قرَأْت کِتَابَ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ : إنَّہَا لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 16374","","","كتاب النكاح"
"16375","(۱۶۳۷۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 16375","","","كتاب النكاح"
"16376","(۱۶۳۷۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 16376","","","كتاب النكاح"
"16377","(۱۶۳۷۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عَوْنٍ ، عَنْ أَبِی صَالِحٍ الْحَنَفِیِّ ، عَنْ عَلِیٍّ قَالَ لاَ یَطَؤُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16377","","","كتاب النكاح"
"16378","(۱۶۳۷۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 16378","","","كتاب النكاح"
"16379","(۱۶۳۷۹) حَدَّثَنَا جَرِیرٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی الضُّحَی وَالشَّعْبِیِّ قَالاَ : لاَ تَحِلُّ لَہُ إلاَّ مِنْ حَیْثُ حُرِّمَتْ عَلَیْہِ ، حَتَّی تزوج زَوْجًا غَیْرَہُ وَیَدْخُلَ بِہَا۔","","Musannaf Ibn Abi Shaybah 16379","","","كتاب النكاح"
"16380","(۱۶۳۸۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ تَحِلُّ لَہُ إلاَّ مِنْ حَیْثُ حُرِّمَتْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16380","","","كتاب النكاح"
"16381","(۱۶۳۸۱) حَدَّثَنَا عَبَّادُ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 16381","","","كتاب النكاح"
"16382","(۱۶۳۸۲) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 16382","","","كتاب النكاح"
"16383","(۱۶۳۸۳) حَدَّثَنَا عبد اللہ بْنُ إدْرِیسَ ، عَنْ مَالِکٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ أَبَا عَبْدِ الرَّحْمَنِ سَأَلَ زَیْدَ بْنَ ثَابِتٍ عن مَمْلُوکَۃٍ کَانَتْ تَحْتَ رَجُلٍ فَطَلَّقَہَا فَبَتَّہَا ثُمَّ اشْتَرَاہَا ؟ قَالَ : لاَ تَحِلُّ لَہُ إلاَّ مِنْ حَیْثُ حُرِّمَتْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16383","","","كتاب النكاح"
"16384","(۱۶۳۸۴) حدَّثَنَا ابْنُ إدْرِیسُ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ قَالَ : لاَ تَحِلُّ لَہُ إلاَّ مِنْ حَیْثُ حُرِّمَتْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16384","","","كتاب النكاح"
"16385","(۱۶۳۸۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَبِیبٍ، عَنْ عَمْرٍو، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ: لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 16385","","","كتاب النكاح"
"16386","(۱۶۳۸۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمَ ، عَنْ إبْرَاہِیمَ قَالَ : سَأَلْتُ عَنْہُ عَبِیْدَۃَ ، فَأَبَی ذَلِکَ عَلَیَّ۔","","Musannaf Ibn Abi Shaybah 16386","","","كتاب النكاح"
"16387","(۱۶۳۸۷) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ قَالَ : ہِیَ مَا مَلَکَتْ یَمِینُہُ۔","","Musannaf Ibn Abi Shaybah 16387","","","كتاب النكاح"
"16388","(۱۶۳۸۸) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : یَطَؤُہَا بِمِلْکِ الْیَمِینِ۔","","Musannaf Ibn Abi Shaybah 16388","","","كتاب النكاح"
"16389","(۱۶۳۸۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ : أَحَلَّتْہَا آیَۃٌ وَحَرَّمَتْہَا آیَۃٌ أُخْرَی ، وَلاَ آمُرُک وَلاَ أَنْہَاک۔","","Musannaf Ibn Abi Shaybah 16389","","","كتاب النكاح"
"16390","(۱۶۳۹۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لَیسَ لَہُ أَنْ یَغْشَاہَا بِمِلْکِ الْیَمِینِ ، وَإِنْ شَائَ أَعْتَقَہَا وَزَوَّجَہَا ، وَکَانَتْ عِنْدَہُ عَلَی وَاحِدَۃٍ ، وَکَانَ قَتَادَۃُ یَأْخُذُ بِہِ۔","","Musannaf Ibn Abi Shaybah 16390","","","كتاب النكاح"
"16391","(۱۶۳۹۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرٍ وَأَبِی سَلَمَۃَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 16391","","","كتاب النكاح"
"16392","(۱۶۳۹۲) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عَبْدِ الصَّمَدِ الْعَمِّیُّ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ إبْرَاہِیمَ أَنَّ ابْنَ مَسْعُودٍ قَالَ : فِی رَجُلٍ یَعْنِی عَبْدٍ طَلَّقَ امْرَأَتَہُ تَطْلِیقَتَیْنِ وَہِیَ مَمْلُوکَۃٌ فَأُعْتِقَا ، فَقَالَ ابْنُ مَسْعُودٍ : لاَ یَتَزَوَّجُہَا حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 16392","","","كتاب النكاح"
"16393","(۱۶۳۹۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ وَعَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ فِی الأَمَۃِ تَکُونُ تَحْتَ الْعَبْدِ فَیُطَلِّقُہَا تَطْلِیقَتَیْنِ فَیُعْتَقَانِ جَمِیعًا قَالاَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 16393","","","كتاب النكاح"
"16394","(۱۶۳۹۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عَامِرٍ فِی الْعَبْدِ یُطَلِّقُ الأَمَۃَ تَطْلِیقَتَیْنِ فَیُعْتَقَانِ جَمِیعًا قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 16394","","","كتاب النكاح"
"16395","(۱۶۳۹۵) حَدَّثَنَا عَبْدَۃُ بن سلیمان ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَمَّنْ حَدَّثَہُ عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی الْحَسَنِ مَوْلًی لِبَنِی نَوْفَلٍ قَالَ : کُنْتُ أَنَا وَامْرَأَتِی مَمْلُوکَیْنِ فَطَلَّقْتُہَا تَطْلِیقَتَیْنِ ثُمَّ أُعْتِقْنَا بَعْدَ ذَلِکَ فَأَرَدْت مُرَاجَعَتَہَا فَسَأَلْت ابْنَ عَبَّاسٍ ، فَقَالَ : إِنْ رَاجَعْتہَا فَہِیَ عِنْدَکَ عَلَی وَاحِدَۃٍ وَمَضَتِ اثْنَتَانِ ، قَضَی بِذَلِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 16395","","","كتاب النكاح"
"16396","(۱۶۳۹۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا شَیْبَانَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عُمَر بْنِ مُعَتِّبٍ ، عَنْ أَبِی الْحَسَنِ مَوْلًی لِبَنِی نَوْفَلٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ n(ابوداؤد ۲۱۸۱۔ احمد ۱/۲۲۹)","Da'if","Musannaf Ibn Abi Shaybah 16396","","","كتاب النكاح"
"16397","(۱۶۳۹۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی سَلَمَۃَ وَجَابِرِ بْنِ عَبْدِ اللہِ قَالاَ : إذَا أُعْتِقَتْ فِی عِدَّتِہَا ، فَإِنَّہُ یَتَزَوَّجُہَا إِنْ شَائَ وَتَکُونُ عِنْدَہُ عَلَی وَاحِدَۃٍ۔","","Musannaf Ibn Abi Shaybah 16397","","","كتاب النكاح"
"16398","(۱۶۳۹۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ تَزَوَّجَ أَمَۃً بَیْنَ رَجُلَیْنِ فَاشْتَرَی نَصِیبَ أَحَدِہِمَا قَالَ : یَکُفُّ عَنْہَا حَتَّی یَشْتَرِیَ نَصِیبَ الآخَرِ۔","","Musannaf Ibn Abi Shaybah 16398","","","كتاب النكاح"
"16399","(۱۶۳۹۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ صَاحِبٍ لَہُ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 16399","","","كتاب النكاح"
"16400","(۱۶۴۰۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنْ قَتَادَۃَ قَالَ : لَمْ یَزِدْہُ مِلْکُہُ مِنہَا إلاَّ قُرْبًا۔","","Musannaf Ibn Abi Shaybah 16400","","","كتاب النكاح"
"16401","(۱۶۴۰۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ أَنَّہُ کَانَ یَقُولُ : إذَا اشْتَرَی الرَّجُل مِنَ امْرَأَتہِ نَصِیبًا فَلاَ یَقْرَبُہَا حَتَّی یَسْتَخْلِصَہَا۔","","Musannaf Ibn Abi Shaybah 16401","","","كتاب النكاح"
"16402","(۱۶۴۰۲) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلَ عِتْقَ صَفِیَّۃَ صَدَاقَہَا۔ (بخاری ۳۷۱۔ ابوداؤد ۲۹۹۱)","Sahih","Musannaf Ibn Abi Shaybah 16402","","","كتاب النكاح"
"16403","(۱۶۴۰۳) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ قَالَ : قَالَ عَلِیٌّ : إِن شَاء الرَّجُل أَعْتَقَ أُمَّ وَلَدِہِ وَجَعَلَ عِتْقَہَا مَہْرَہَا۔","","Musannaf Ibn Abi Shaybah 16403","","","كتاب النكاح"
"16404","(۱۶۴۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : قَالَ سَعِیدُ بْنُ الْمُسَیَّبِ : مَنْ أَعْتَقَ وَلِیدَتَہُ ، أَوْ أُمَّ وَلَدِہِ وَجَعَلَ عِتْقَہَا صَدَاقَہَا رَأَیْت ذَلِکَ جَائِزًا لَہُ۔","","Musannaf Ibn Abi Shaybah 16404","","","كتاب النكاح"
"16405","(۱۶۴۰۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ أَنَّہُ کَانَ یَقُولُ : إذَا أَعْتَقَ الرَّجُلُ أَمَتَہُ وَجَعَلَ عِتْقَہَا صَدَاقَہَا ، إنَّ ذَلِکَ جَائِزٌ لَہُ۔","","Musannaf Ibn Abi Shaybah 16405","","","كتاب النكاح"
"16406","(۱۶۴۰۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ عُمَرَ فِی الرَّجُلِ یَعْتِقُ الأَمَۃَ وَیَجْعَلُ عِتْقَہَا صَدَاقَہَا قَالَ : ہُوَ کَالرَّاکِبِ بَدَنَتَہُ۔","","Musannaf Ibn Abi Shaybah 16406","","","كتاب النكاح"
"16407","(۱۶۴۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الْکَنُودِ ، عَنْ عَبْدِ اللہِ قَالَ : مَثَلُ الَّذِی یَعْتِقُ أَمَتَہُ وَیَتَزَوَّجُہَا مَثَلُ الرَّجُلِ یَرْکَبُ بَدَنَتَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 16407","","","كتاب النكاح"
"16408","(۱۶۴۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ أَنَّہُ کَانَ یَقُولُ إذَا جَعَلَ عِتْقَ أَمَتِہِ صَدَاقَہَا کَانَ یُحِبُّ أَنْ یَجْعَلَ لَہَا شَیْئًا مَعَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16408","","","كتاب النكاح"
"16409","(۱۶۴۰۹) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی رَجُلٍ قَالَ لأَمَتِہِ : قَدْ أَعْتَقْتُکِ وَتَزَوَّجْتُکِ ، قَالَ : ہِیَ حُرَّۃٌ إِنْ شَائَتْ تَزَوَّجْتہ ، وَإِنْ شَائَتْ لَمْ تَزَوَّجْہُ۔","","Musannaf Ibn Abi Shaybah 16409","","","كتاب النكاح"
"16410","(۱۶۴۱۰) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ أَنَّہُمَا قَالاَ : إذَا أَعْتَقَہَا لِلَّہِ تَعَالَی فَلاَ یَعُودُ فِیہَا ، وَلاَ یَرَیَانِ بَأْسًا أَنْ یَعْتِقَہَا لِیَتَزَوَّجَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16410","","","كتاب النكاح"
"16411","(۱۶۴۱۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ شُعْبَۃَ ، عَنْ سَعِیدٍ ، عَنِ النَّخَعِیِّ ، أَنَّہُ کَرِہَ إذَا أَعْتَقَہَا لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 16411","","","كتاب النكاح"
"16412","(۱۶۴۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یَعْتِقَہَا ثُمَّ یَتَزَوَّجَہَا۔","","Musannaf Ibn Abi Shaybah 16412","","","كتاب النكاح"
"16413","(۱۶۴۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّہُ کَرِہَ أَنْ یَعْتِقَہَا لِوَجْہِ اللہِ تَعَالَی ثُمَّ یَتَزَوَّجَہَا۔","","Musannaf Ibn Abi Shaybah 16413","","","كتاب النكاح"
"16414","(۱۶۴۱۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّ بُشَیْرَ بْنَ کَعْبٍ قَرَأَ ہَذِہِ الآیَۃَ : {فَامْشُوا فِی مَنَاکِبِہَا} ، فَقَالَ لِجَارِیَتِہِ: إِنْ دَرَیْت مَا مَنَاکِبُہَا فَأَنْتِ حُرَّۃٌ لِوَجْہِ اللہِ، قَالَتْ: فَإِنَّ مَنَاکِبَہَا جِبَالُہَا ، فَکأَنَّمَا سُفِعَ وَجْہَہُ، وَرَغِبَ فِی جَارِیَتِہِ فَجَعَلَ یَسْأَلُ ، عَنْ ذَلِکَ فَمِنْہُمْ مَنْ یَأْمُرُہُ وَمِنْہُمْ مَنْ یَنْہَاہُ حَتَّی لَقِیَ أَبَا الدَّرْدَائِ فَذَکَرَ ذَلِکَ لَہُ ، فَقَالَ : دَعْ مَا یَرِیبُک إلَی مَا لاَ یَرِیبُک فَإِنَّ الْخَیْرَ فِی طُمَأْنِینَۃٍ وَإِنَّ الشَّرَّ فِی رِیبَۃٍ ، فترَکَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16414","","","كتاب النكاح"
"16415","(۱۶۴۱۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّ الْحَسَنَ ، وَعَطَائً کَانَا لاَ یَرَیَانِ بِذَلِکَ بَأْسًا ، وَإِنْ أَعْتَقَہَا لِلَّہِ وَیَقُولاَنِ : ہُوَ أَعْظَمُ لِلأَجْرِ۔","","Musannaf Ibn Abi Shaybah 16415","","","كتاب النكاح"
"16416","(۱۶۴۱۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ إذَا سُئِلَ عَنِ الرَّجُلِ یَعْتِقُ جَارِیَتَہُ وَیَتَزَوَّجُہَا أنہ کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا ، وَإِنْ أَعْتَقَہَا لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 16416","","","كتاب النكاح"
"16417","(۱۶۴۱۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ الصَّلْتِ بْنِ بَہْرَامَ ، عَنْ شَقِیقٍ قَالَ : تَزَوَّجَ حُذَیْفَۃُ یَہُودِیَّۃً فَکَتَبَ إلَیْہِ عُمَرُ أَنْ خَلِّ سَبِیلَہَا ، فَکَتَبَ إلَیْہِ : إِنْ کَانَتْ حَرَامًا خَلَّیْت سَبِیلَہَا ، فَکَتَبَ إلَیْہِ : إنِّی لاَ أَزْعُمُ أَنَّہَا حَرَامٌ وَلَکِنِّی أَخَافُ أَنْ تَعَاطَوا الْمُومِسَاتِ مِنْہُنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 16417","","","كتاب النكاح"
"16418","(۱۶۴۱۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَبْدِ الْمَلِکِ قَالَ : سَأَلْتُ عَطَائً ، عَنْ نِکَاحِ الْیَہُودِیَّاتِ وَالنَّصْرَانِیَّات فَکَرِہَہُ وَقَالَ : کَانَ ذَلِکَ وَالْمُسْلِمَاتُ قَلِیلٌ۔","","Musannaf Ibn Abi Shaybah 16418","","","كتاب النكاح"
"16419","(۱۶۴۱۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ کَانَ یَکْرَہُ نِکَاحَ نِسَائِ أَہْلِ الْکِتَابِ ، وَلاَ یَرَی بِطَعَامِہِنَّ بَأْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 16419","","","كتاب النكاح"
"16420","(۱۶۴۲۰) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، عَنِ ابْنِ عُمَرَ أَنَّہُ کَرِہَ نِکَاحَ نِسَائِ أَہْلِ الْکِتَابِ وَقَرَأَ : {وَلاَ تَنْکِحُوا الْمُشْرِکَاتِ حَتَّی یُؤْمِنَّ}۔","Sahih","Musannaf Ibn Abi Shaybah 16420","","","كتاب النكاح"
"16421","(۱۶۴۲۱) حدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، عَنْ عَلِیٍّ قَالَ : تَزَوَّجَ رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَہُودِیَّۃً۔","Hasan","Musannaf Ibn Abi Shaybah 16421","","","كتاب النكاح"
"16422","(۱۶۴۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ أَنَّ طَلْحَۃَ تَزَوَّجَ نَصْرَانِیَّۃً۔","Hasan","Musannaf Ibn Abi Shaybah 16422","","","كتاب النكاح"
"16423","(۱۶۴۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنْ أَشْعَثَ، عَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ قَالَ: شَہِدْنَا الْقَادِسِیَّۃَ مَعَ سَعْدٍ وَنَحْنُ یَوْمَئِذٍ لاَ نَجِدُ سَبِیلاً إلَی الْمُسْلِمَاتِ فَتَزَوَّجْنَا الْیَہُودِیَّاتِ وَالنَّصْرَانِیَّات فَمِنَّا مَنْ طَلَّقَ وَمِنَّا مَنْ أَمْسَکَ۔","Da'if","Musannaf Ibn Abi Shaybah 16423","","","كتاب النكاح"
"16424","(۱۶۴۲۴) حَدَّثَنَا عبد اللہ بْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ جَارٍ لِحُذَیْفَۃَ ، عَنْ حُذَیْفَۃَ أَنَّہُ نَکَحَ یَہُودِیَّۃً وَعِنْدَہُ عَرَبِیَّتَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 16424","","","كتاب النكاح"
"16425","(۱۶۴۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : لاَ بَأْسَ بِنِکَاحِ النَّصْرَانِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 16425","","","كتاب النكاح"
"16426","(۱۶۴۲۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالنِّکَاحِ فِی أَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 16426","","","كتاب النكاح"
"16427","(۱۶۴۲۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ أَبِی عِیَاضٍ قَالَ : لاَ بَأْسَ بِنِکَاحِ الْیَہُودِیَّاتِ وَالنَّصْرَانِیَّات إلاَّ أَہْلَ الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 16427","","","كتاب النكاح"
"16428","(۱۶۴۲۸) حدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، وَالْحَسَنِ قَالاَ : لاَ بَأْسَ أَنْ یَتَزَوَّجَ الرَّجُلُ أَرْبَعًا مِنْ أَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 16428","","","كتاب النكاح"
"16429","(۱۶۴۲۹) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الرَّبِیعِ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ قَالَ : لاَ بَأْسَ أَنْ یَجْمَعَ الرَّجُلُ أَرْبَعًا مِنْ أَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 16429","","","كتاب النكاح"
"16430","(۱۶۴۳۰) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزہری قَالَ : یَتَزَوَّجُ الْحُرُّ أرْبَعَ إمَائٍ وَأَرْبَعَ نَصْرَانِیَّاتٍ وَالْعَبْدُ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16430","","","كتاب النكاح"
"16431","(۱۶۴۳۱) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یَحِلُّ نِکَاحُ نِسَائِ أَہْلِ الْکِتَابِ إذَا کَانُوا حَرْبًا ، قَالَ الْحَکَمُ : فَحَدَّثْت بِہِ إبْرَاہِیمَ فَأَعْجَبَہُ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 16431","","","كتاب النكاح"
"16432","(۱۶۴۳۲) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بن مُحَمَّد الْمُحَارِبِیُّ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ أَبِی عِیَاضٍ قَالَ : نِسَائُ أَہْلُ الْکِتَابِ لَنَا حَلاَلٌ إلاَّ أَہْلَ الْحَرْبِ فَإِنَّ نِسَائَہُمْ وَذَبَائِحَہُمْ عَلَیْکُمْ حَرَامٌ۔","","Musannaf Ibn Abi Shaybah 16432","","","كتاب النكاح"
"16433","(۱۶۴۳۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ ابْنِ أَبِی غَنِیَۃَ ، عَنِ الْحَکَمِ قَالَ : إنَّ مِنْ أَہْلِ الْکِتَابِ مَنْ لاَ یَحِلُّ لَنَا مُنَاکَحَتُہُ وَلاَ ذَبِیحَتُہُ ، أَہْلُ الْحَرْبِ۔","","Musannaf Ibn Abi Shaybah 16433","","","كتاب النكاح"
"16434","(۱۶۴۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ بُکر ، عَنِ ابْنِ جُرَیْجٍ قَالَ : أَخْبَرَنِی أَبُو بَکْرٍ بْنُ عَبْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو الْعتوَارِیِّ ، وَیَحْیَی بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ وَعَنْ عَمْرِو بْنِ سُلَیْمٍ الزُّرَقِیِّ ، عَنِ ابْنِ الْمُسَیَّبِ وَعَنْ أَبِی النَّضْرِ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ أَنَّہُمْ قَالُوا فِی الْمَرْأَۃِ مِنْ أَہْلِ الْکِتَابِ ، إذَا دَخَلَتْ مِنْ أَرْضِ الْحَرْبِ تَدْخُلُ أَرْضَ الْعَرَبِ بِأَمَانٍ ، إِنْ أَظْہَرَتِ السُّکُونَ فِی أَرْضِ الْعَرَبِ فَلاَ بَأْسَ أَنْ یَنْکِحَہَا الْمُسْلِمُ ، وَإِنْ لَمْ تُظْہِرْ ذَلِکَ إلاَّ عِنْدَ الْخِطْبَۃِ لَمْ تُنْکَحْ۔","","Musannaf Ibn Abi Shaybah 16434","","","كتاب النكاح"
"16435","(۱۶۴۳۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَیْسَرَۃَ قَالَ : إمَائُ أَہْلِ الْکِتَابِ بِمَنْزِلَۃِ حَرَائِرِہِمْ۔","","Musannaf Ibn Abi Shaybah 16435","","","كتاب النكاح"
"16436","(۱۶۴۳۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ أَنَّہُ قَالَ : إنَّمَا رُخِّصَ لِہَذِہِ الأَمَۃِ فِی نِسَائِ أَہْلِ الْکِتَابِ وَلَمْ یُرَخَّصْ فِی الإِمَائِ۔","","Musannaf Ibn Abi Shaybah 16436","","","كتاب النكاح"
"16437","(۱۶۴۳۷) حَدَّثَنَا عُثْمَانُ ، عَنْ ثَوْرٍ ، عَنْ مَکْحُولٍ أَنَّہُ کَرِہَ نِکَاحَ أَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 16437","","","كتاب النكاح"
"16438","(۱۶۴۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : {مِنْ فَتَیَاتِکُمَ الْمُؤْمِنَاتِ} ، قَالَ : لاَ یَنْبَغِی لِلْحُرِّ الْمُسْلِمِ أَنْ یَنْکِحَ أَمَۃً مِنْ أَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 16438","","","كتاب النكاح"
"16439","(۱۶۴۳۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ عَن مسور أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ : إذَا دَخَلَ الرَّجُلُ بِالْمَرْأَۃِ فَقَدْ وَجَبَ الْعَاجِلُ وَالآجِلُ إلاَّ أَنْ تَشْتَرِطَ فِی الآجِلِ۔","","Musannaf Ibn Abi Shaybah 16439","","","كتاب النكاح"
"16440","(۱۶۴۴۰) حَدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلِ یَتَزّوَّجُ الْمَرْأَۃَ إلَی مَیْسَرَۃٍ ، قَالَ : کَانَ یَقُولُ : إلَی مَوْتٍ ، أَوْ فِرَاقٍ۔","","Musannaf Ibn Abi Shaybah 16440","","","كتاب النكاح"
"16441","(۱۶۴۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ فِی الآجِلِ مِنَ الْمَہْرِ : ہُوَ حَالٌّ إلاَّ أَنْ تَکُونَ لَہُ مُدَّۃٌ مَعْلُومَۃٌ۔","","Musannaf Ibn Abi Shaybah 16441","","","كتاب النكاح"
"16442","(۱۶۴۴۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ قَالَ : تَزَوَّجَ رَجُلٌ امْرَأَۃً بِآجِلٍ وَعَاجِلٍ إلَی مَیْسَرَۃَ فَقَدَّمَتْہُ إلَی شُرَیْحٍ ، فَقَالَ ، دُلّیْنَا عَلَی مَیْسَرَۃٍ نَأْخُذُہُ لَکِ۔","","Musannaf Ibn Abi Shaybah 16442","","","كتاب النكاح"
"16443","(۱۶۴۴۳) حَدَّثَنَا أَزْہَرُ السَّمَّانُ، عَنِ ابْنِ عَوْنٍ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ قَالَ: إذَا دَخَلَ بِہَا فَلاَ دَعْوَی لَہَا فِی الآجِلِ۔","","Musannaf Ibn Abi Shaybah 16443","","","كتاب النكاح"
"16444","(۱۶۴۴۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ قَالَ : الْعَاجِلُ آجِلٌ إلَی مَوْتٍ ، أَوْ فُرْقَۃٍ۔","","Musannaf Ibn Abi Shaybah 16444","","","كتاب النكاح"
"16445","(۱۶۴۴۵) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، قَالَ : سَمِعْتُ حَمَّادًا یَقُولُ : ہُوَ حَالٌّ تَأْخُذْہُ إذَا شِئْتِ۔","","Musannaf Ibn Abi Shaybah 16445","","","كتاب النكاح"
"16446","(۱۶۴۴۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ وَالزُّہْرِیِّ قَالاَ : فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَدَخَلَ بِہَا فَرَأَی بِہَا جُنُونًا ، أَوْ جُذَامًا ، أَوْ بَرَصًا ، أَوْ عَفَلاً إنَّہَا تُرَدُّ مِنْ ہَذَا وَلَہَا الصَّدَاقُ الَّذِی اسْتَحَلَّ بِہِ فَرْجَہَا الْعَاجِلُ وَالآجِلُ وَصَدَاقُہُ عَلَی مَنْ غَرَّہُ۔","","Musannaf Ibn Abi Shaybah 16446","","","كتاب النكاح"
"16447","(۱۶۴۴۷) حَدَّثَنَا عَبدَۃ بن سلیمان ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلِیٍّ أَنَّہُ کَانَ یَکْرَہُ ذَبَائِحَ نَصَارَی بَنِی تَغْلِبَ وَنِسَائَہُمْ وَیَقُولُ : ہُمْ مِنَ الْعَرَبِ۔","","Musannaf Ibn Abi Shaybah 16447","","","كتاب النكاح"
"16448","(۱۶۴۴۸) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا وَیَقُولُ : انْتَحَلُوا دِینًا فَذَلِکَ دِینُہُمْ۔","","Musannaf Ibn Abi Shaybah 16448","","","كتاب النكاح"
"16449","(۱۶۴۴۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنْ نَصَارَی الْعَرَبِ ہَلْ تَحِلُّ نِسَاؤُہُمْ لِلْمُسْلِمِینَ قَالَ : لَیْسُوا مِنْ أَہْلِ الْکِتَابِ وَلاَ تَحِلُّ نِسَاؤُہُمْ وَلاَ طَعَامُہُمْ لِلْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 16449","","","كتاب النكاح"
"16450","(۱۶۴۵۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عِمْرَانَ بْنِ حُدَیر ، قَالَ : قَالَ عِکْرِمَۃُ : {وَمَنْ یَتَوَلَّہُمْ مِنْکُمْ فَإِنَّہُ مِنْہُمْ} قَالَ : نصاری الْعَرَب فِی ذَبَائِحِہِمْ وَفِی نِسَائِہِمْ۔","","Musannaf Ibn Abi Shaybah 16450","","","كتاب النكاح"
"16451","(۱۶۴۵۱) حَدَّثَنَا عَفَّانَ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عبَّاسٍ قَالَ : کُلُوا ذَبَائِحَ بَنِی ثَعْلَبَۃَ وَتَزَوَّجُوا نِسَائَہُمْ فَإِنَّ اللَّہَ تَعَالَی یَقُولُ : {یَا أَیُّہَا الَّذِینَ آمَنُوا لاَ تَتَّخِذُوا الْیَہُودَ وَالنَّصَارَی أَوْلِیَائَ بَعْضُہُمْ أَوْلِیَائُ بَعْضٍ} فَلَوْ لَمْ یَکُونُوا مِنْہُمْ إلاَّ بِالْوِلاَیَۃِ لَکَانُوا مِنْہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 16451","","","كتاب النكاح"
"16452","(۱۶۴۵۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مِعْشَرٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلِیٍّ أَنَّہُ کَرِہَ ذَبَائِحَ نَصَارَی الْعَرَبِ وَنِسَائَہُمْ۔","","Musannaf Ibn Abi Shaybah 16452","","","كتاب النكاح"
"16453","(۱۶۴۵۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مِعْشَرٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ۔","","Musannaf Ibn Abi Shaybah 16453","","","كتاب النكاح"
"16454","(۱۶۴۵۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16454","","","كتاب النكاح"
"16455","(۱۶۴۵۵) حَدَّثَنَا جَرِیرٌ، عَنْ عَبْدِ الحمید ، عَنْ مُغِیرَۃَ ، عَنْ سِمَاکِ بْنِ سَلَمَۃَ أَنَّ شُرَیْحًا أَجَازَ نِکَاحَ وَصِیِّ وَصِیٍّ۔","","Musannaf Ibn Abi Shaybah 16455","","","كتاب النكاح"
"16456","(۱۶۴۵۶) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنِ الْحَارِثِ قَالَ: یُشَاوِر الْوَلِیُّ الْوَصِیَّ فِی النِّکَاحِ وَیلِیَ عُقْدَۃُ النِّکَاحِ الْوَلِیُّ۔","","Musannaf Ibn Abi Shaybah 16456","","","كتاب النكاح"
"16457","(۱۶۴۵۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ فِی وَصِیٍّ زَوَّجَ یَتِیمَۃً صَغِیرَۃً فِی حِجْرِہِ قَالَ : جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 16457","","","كتاب النكاح"
"16458","(۱۶۴۵۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الْوَصِیِّ یُزَوِّجُ قَالَ : ہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 16458","","","كتاب النكاح"
"16459","(۱۶۴۵۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَارِثٍ ، عَنِ الشَّعْبِیِّ وَعَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالاَ : مَا صَنَعَ الْوَصِیُّ فَہُوَ جَائِزٌ إلاَّ النِّکَاحَ۔","","Musannaf Ibn Abi Shaybah 16459","","","كتاب النكاح"
"16460","(۱۶۴۶۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ أَنَّہُ کَانَ لاَ یَجْعَلُ لِلْوَصِیِّ من أَمْرِ النِّکَاحِ شَیْئًا إلاَّ أَنْ یَکُونَ قَالَ : أَنْتَ وَصِیِّی فِی نِکَاحِ أخواتی وبناتی فَإِنْ فَعَلَ فَالْوَصِیُّ أَحَقُّ مِنَ الْوَلِیِّ وَإِلاَّ فَالْوَلِیُّ أَحَقُّ مِنَ الْوَصِیِّ۔","","Musannaf Ibn Abi Shaybah 16460","","","كتاب النكاح"
"16461","(۱۶۴۶۱) حدَّثَنَا وَکِیعٌ، عَنْ إسْمَاعِیلَ، عَنِ الشَّعْبِیِّ فِی امْرْأَۃٍ تَزَوَّجَتْ رَجُلاً عَلَی أَنَّہُ حُرٌّ فَوُجِدَ عَبْدًا قَالَ: تُخَیَّرُ۔","","Musannaf Ibn Abi Shaybah 16461","","","كتاب النكاح"
"16462","(۱۶۴۶۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ أَنَّہُ سُئِلَ عَنْ رَجُلٍ دَلَّسَ نَفْسَہُ لأَمْرَأَۃٍ فَزَعَمَ أَنَّہُ حُرٌّ وَہوَ عَبْدٌ قَالَ : تُخَیَّرُ۔","","Musannaf Ibn Abi Shaybah 16462","","","كتاب النكاح"
"16463","(۱۶۴۶۳) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ فِی امْرَأَۃٍ غُرَّتْ بِعَبْدٍ وَکَانَتْ تَحْسَبُہُ حُرًّا قَالَ ابْنُ شِہَابٍ : تُخَیَّرُ۔","","Musannaf Ibn Abi Shaybah 16463","","","كتاب النكاح"
"16464","(۱۶۴۶۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنْ عَبْدٍ أَتَی قَوْمًا فَأَخْبَرَہُمْ أَنَّہُ حُرٌّ فَأَنْکَحُوہُ امْرَأَۃً حُرَّۃً ثُمَّ عَلِمُوا بَعْدَ ذَلِکَ أَنَّہُ عَبْدٌ غُرَّتْ بِہِ قَالَ : إذَا عَلِمَتْ بِہِ فَإِنْ شَائَتْ مَکَثَتْ بِہِ، وَإِنْ شَائَتْ فَارَقَتْہُ وَلاَ حَقَّ لَہُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 16464","","","كتاب النكاح"
"16465","(۱۶۴۶۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ قَالَ : أَیُّمَا عَبْدٍ جَائَ إلَی حُرَّۃٍ فَزَوَّجَتْہُ فَعَلِمَتْ بَعْدَ ذَلِکَ أَنَّہُ مَمْلُوکٌ فَإِنْ شَائَتِ اسْتَقَرَّتْ عِنْدَہُ ، وَإِنْ شَائَتْ فَارَقَتْہُ۔","","Musannaf Ibn Abi Shaybah 16465","","","كتاب النكاح"
"16466","(۱۶۴۶۶) حَدَّثَنَا وَکِیعُ بْنُ الجَرَّاحِ عن سفیان ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ قَالَ : إذَا تَزَوَّجَ الابْنُ لَمْ تَحِلَّ لِلأَبِ دَخَلَ بِہَا ، أَوْ لَمْ یَدْخُلْ بہا وَإِذَا تزوج الأَبُ لَمْ تَحِلَّ لِلابْنِ دَخَلَ بِہَا ، أَوْ لَمْ یَدْخُلْ بِہَا۔","","Musannaf Ibn Abi Shaybah 16466","","","كتاب النكاح"
"16467","(۱۶۴۶۷) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنِ الزُّہْرِیِّ قَالَ : مَنْ مَلَکَ عُقْدَۃَ امْرَأَۃٍ فَقَدْ حُرِّمَتْ عَلَی ابْنِہِ وعلی أَبِیہِ وَأَیُّہُمَا جَرَّدَ فَنَظَرَ إلَی الْعَوْرَۃِ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16467","","","كتاب النكاح"
"16468","(۱۶۴۶۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ عن أبی بکر ، عَنْ مَکْحُولٍ قَالَ : أَیُّہُمَا مَلَکَ عُقْدَۃَ امْرَأَۃٍ حُرِّمَتْ عَلَی الآخَرِ۔","","Musannaf Ibn Abi Shaybah 16468","","","كتاب النكاح"
"16469","(۱۶۴۶۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَطَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا أَیَتَزَوَّجُہَا أَبُوہُ فَکَرِہَ وَقَالَ اللَّہُ تَعَالَی : {وَحَلاَئِلُ أَبْنَائِکُمْ}۔","","Musannaf Ibn Abi Shaybah 16469","","","كتاب النكاح"
"16470","(۱۶۴۷۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ قَالاَ : ثَلاَثُ آیَاتٍ مُبْہَمَاتٌ : {وَحَلاَئِلُ أَبْنَائِکُمْ} وَ{مَا نَکَحَ آبَاؤُکُمْ} وَ{وَأُمَّہَاتُ نِسَائِکُمْ} قَالَ : أَشْعَثُ : وَہَذِہِ الرَّابِعَۃُ لَیْسَتْ بِمُبْہَمَۃٍ {وَرَبَائِبُکُمَ اللاَّتِی فِی حُجُورِکُمْ مِنْ نِسَائِکُمْ} فَقَرَأَہَا مُعَاذٌ إلَی آخِرِہَا۔","","Musannaf Ibn Abi Shaybah 16470","","","كتاب النكاح"
"16471","(۱۶۴۷۱) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ عُبَیْدَۃَ، عَنْ إبْرَاہِیمَ قَالَ: إذَا تَزَوَّجَ الرَّجُلُ الْمَرْأَۃَ فَلَمْ یَدْخُلْ بِہَا لَمْ تَحِلَّ لأَبِیہِ۔","","Musannaf Ibn Abi Shaybah 16471","","","كتاب النكاح"
"16472","(۱۶۴۷۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَکْحُولٍ أَنَّ عُمَرَ جَرَّدَ جَارِیَتَہُ فَسَأَلَہُ إیَّاہَا بَعْضُ بَنِیہِ ، فَقَالَ : إنَّہَا لاَ تَحِلُّ لَک۔","","Musannaf Ibn Abi Shaybah 16472","","","كتاب النكاح"
"16473","(۱۶۴۷۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ أَنَّ عُمَرَ جَرَّدَ جَارِیَۃً لَہُ فَطَلَبَہَا إلَیْہِ بَعْضُ بَنِیہِ ، فَقَالَ : إنَّہَا لاَ تَحِلُّ لَک۔","","Musannaf Ibn Abi Shaybah 16473","","","كتاب النكاح"
"16474","(۱۶۴۷۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ أَنَّہُ جَرَّدَ جَارِیَۃً لَہُ ثُمَّ سَأَلَہُ إیَّاہَا بَعْضُ وَلَدِہِ ، فَقَالَ إنَّہَا لاَ تَحِلُّ لَک۔","","Musannaf Ibn Abi Shaybah 16474","","","كتاب النكاح"
"16475","(۱۶۴۷۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، سُلَیْمَانَ بْنِ حَیَّانَ ، عَنِ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ أَنَّ أَبَاہُ حِینَ حَضَرَتْہُ الْوَفَاۃُ نَہَی بَنِیہِ ، عَنْ جَارِیَۃٍ لَہُ أَنْ یَطَأَہَا أَحَدٌ مِنْہُمْ قَالَ : وَمَا نَعْلَمُہُ وَطِئَہَا إلاَّ أَنْ یَکُونَ اطَّلَعَ مِنْہَا عَلَی أَمْرٍ کَرِہَ أَنْ یَطَّلِعَ وَلَدُہُ مُطَّلَعَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 16475","","","كتاب النكاح"
"16476","(۱۶۴۷۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ أَنَّ عُمَرَ جَرَّدَ جَارِیَۃً لَہُ وَنَظَرَ إلَیْہَا فَسَأَلَہُ إیَّاہَا بَعْضُ وَلَدِہِ ، فَقَالَ : إنَّہَا لاَ تَحِلُّ لَک۔","","Musannaf Ibn Abi Shaybah 16476","","","كتاب النكاح"
"16477","(۱۶۴۷۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ بِمِثْلِ ہَذَا۔","","Musannaf Ibn Abi Shaybah 16477","","","كتاب النكاح"
"16478","(۱۶۴۷۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : قَالَ مَسْرُوقٌ حِینَ حَضَرَتْہُ الْوَفَاۃُ : إنِّی لَمْ أُصِبْ مِنْ جَارِیَتِی ہَذِہِ إلاَّ مَا یُحَرِّمُہَا عَلَی وَلَدِی الْمَسَّ وَالنَّظَرَ۔","","Musannaf Ibn Abi Shaybah 16478","","","كتاب النكاح"
"16479","(۱۶۴۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ قَالَ مُجَاہِدٌ : إذَا مَسَّ الرَّجُلُ فَرْجَ الأَمَۃِ ، أَوْ مَسَّ فَرْجُہُ فَرْجَہَا ، أَوْ بَاشَرَہَا فَإِنَّ ذَلِکَ یُحَرِّمُہَا عَلَی أَبِیہِ وَعَلَی ابْنِہِ۔","","Musannaf Ibn Abi Shaybah 16479","","","كتاب النكاح"
"16480","(۱۶۴۸۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ سَأَلَ عَنْ رَجُلٍ جَرَّدَ جَارِیَتَہُ ہَلْ تَحِلُّ لابْنِہِ ، أَوْ لأَبِیہِ أَنَّہُ کَانَ یَکْرَہُ ذَلِکَ إذَا قَبَّلَہَا ، أَوْ جَرَّدَہَا لِشَہْوَۃٍ۔","","Musannaf Ibn Abi Shaybah 16480","","","كتاب النكاح"
"16481","(۱۶۴۸۱) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ مُثَنًّی ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ قَالَ : أَیُّمَا رَجُلٍ جَرَّدَ جَارِیَۃً فَنَظَرَ مِنْہَا إلَی ذَلِکَ الأَمْرِ فَإِنَّہَا لاَ تَحِلُّ لابْنِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 16481","","","كتاب النكاح"
"16482","(۱۶۴۸۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ سَأَلَ عَنْہُ الشَّعْبِیَّ ، فَقَالَ : قدْ زَعَمُوا أَنَّ رَجُلاً اشْتَرَی جَارِیَۃً فَخَشِیَتِ امْرَأَتُہُ أَنْ یَتَّخِذَہَا فَأَمَرَتِ ابْنًا لَہَا غُلاَمًا أَنْ یَضْطَجِعَ عَلَیْہَا لِیُحَرِّمَہَا عَلَی زَوْجِہَا۔","","Musannaf Ibn Abi Shaybah 16482","","","كتاب النكاح"
"16483","(۱۶۴۸۳) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ کَرِہَ أَنْ یَطَأَ الرَّجُلُ امْرَأَۃً قَبَّلَہَا أَبُوہُ ، أَوْ نَظَرَ إلَی مَحَاسِرِہَا۔","","Musannaf Ibn Abi Shaybah 16483","","","كتاب النكاح"
"16484","(۱۶۴۸۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِی بَکْرٍ ، عَنْ مَکْحُولٍ قَالَ : أَیُّمَا رَجُلٍ جَرَّدَ جَارِیَۃً حُرِّمَتْ عَلَی ابْنِہِ وَعَلَی أَبِیہِ۔","","Musannaf Ibn Abi Shaybah 16484","","","كتاب النكاح"
"16485","(۱۶۴۸۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنْ جَارِیَۃٍ کَانَتْ لِرَجُلٍ فَمَسَّ قُبُلَہَا بِیَدِہِ ، أَوْ أَبْصَرَ عَوْرَتَہَا ثُمَّ وَہَبَہَا لاِبْنٍ لَہُ أَیُصْلِحُّ لہ أَنْ یَتَّطِئَہَا قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 16485","","","كتاب النكاح"
"16486","(۱۶۴۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنِ الشَّعْبِیِّ قَالَ : کَتَبَ مَسْرُوقٌ إلَی أَہْلِہِ : اُنْظُرُوا جَارِیَتِی فَلاَ تَبِیعُوہَا فَإِنِّی لَمْ أُصِبْ مِنْہَا إلاَّ مَا یُحَرِّمُہَا عَلَی وَلَدِی اللَّمْسَ وَالنَّظَرَ۔","","Musannaf Ibn Abi Shaybah 16486","","","كتاب النكاح"
"16487","(۱۶۴۸۷) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ الْحُصَیْنِ فِی الرَّجُلِ یَقَعُ عَلَی أُمِّ امْرَأَتِہِ قَالَ : تَحْرُمُ عَلَیْہِ امْرَأَتُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 16487","","","كتاب النكاح"
"16488","(۱۶۴۸۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ یَحْیَی بْنِ یَعْمَُرَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : حرْمَتَانِ أَنْ تَخْطّاہُمَا وَلاَ یُحَرِّمْہَا ذَلِکَ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 16488","","","كتاب النكاح"
"16489","(۱۶۴۸۹) حَدَّثَنَا حَفْص بن غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : لاَ یَنْظُرُ اللَّہُ إلَی رَجُلٍ نَظَرَ إلَی فَرْجِ امْرَأَۃٍ وَابْنَتَہَا۔ (دارقطنی ۹۲)","Da'if","Musannaf Ibn Abi Shaybah 16489","","","كتاب النكاح"
"16490","(۱۶۴۹۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی ہَانِیئٍ قَالَ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ نَظَرَ إلَی فَرْجِ امْرَأَۃٍ لَمْ تَحِلَّ لَہُ أُمُّہَا وَلاَ ابْنَتُہَا۔ (بیہقی ۱۷۰)","","Musannaf Ibn Abi Shaybah 16490","","","كتاب النكاح"
"16491","(۱۶۴۹۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَعَامِرٍ فِی رَجُلٍ وَقَعَ عَلَی ابْنَۃِ امْرَأَتِہِ قَالاَ : حرِّمَتَا عَلَیْہِ کِلاَہُمَا، وَقَالَ إبْرَاہِیمُ ، وَکَانُوا یَقُولُونَ إذَا اطَّلَعَ الرَّجُلُ عَلَی الْمَرْأَۃِ عَلَی مَا لاَ یَحِلُّ لَہُ ، أَوْ لَمَسَہَا لِشَہْوَۃٍ فَقَدْ حُرِّمَتَا عَلَیْہِ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 16491","","","كتاب النكاح"
"16492","(۱۶۴۹۲) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ قَالَ : إذَا أَتَی الرَّجُلُ الْمَرْأَۃَ حَرَامًا حُرِّمَتْ عَلَیْہِ ابْنَتُہَا ، وَإِنْ أَتَی ابْن[corrupt]تَہَا حُرِّمَتْ عَلَیْہِ أُمُّہَا۔","","Musannaf Ibn Abi Shaybah 16492","","","كتاب النكاح"
"16493","(۱۶۴۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ مسبحٍ قَالَ : سَأَلْتُ إبْرَاہِیمَ ، عَنْ رَجُلٍ فَجَرَ بِأَمَۃٍ ثم أَرَادَ أَنْ یَتَزَوَّجَ أُمَّہَا قَالَ : لاَ یَتَزَوَّجُہَا۔","","Musannaf Ibn Abi Shaybah 16493","","","كتاب النكاح"
"16494","(۱۶۴۹۴) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنْ رَجُلٍ زَنَی بِأُمِّ امْرَأَتِہِ ، قَالاَ : أَحَبُّ إِلَیْنَا أَنْ یُفَارِقَہَا۔","","Musannaf Ibn Abi Shaybah 16494","","","كتاب النكاح"
"16495","(۱۶۴۹۵) حَدَّثَنَا حَفْص بن غِیَاثٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا غَمَزَ الرَّجُلُ الْجَارِیَۃَ بِشَہْوَۃٍ لَمْ یَتَزَوَّجْ أُمَّہَا وَلاَ ابْنَتَہَا۔","","Musannaf Ibn Abi Shaybah 16495","","","كتاب النكاح"
"16496","(۱۶۴۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ قَالاَ : إذَا فَجَرَ الرَّجُلُ بِالْمَرْأَۃِ فَإِنَّہَا تَحِلُّ لَہُ وَلاَ یَحِلُّ لَہُ شَیْئٌ مِنْ بَنَاتِہَا۔","","Musannaf Ibn Abi Shaybah 16496","","","كتاب النكاح"
"16497","(۱۶۴۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ قَالَ : کَانَ جَابِرُ بْنُ زَیْدٍ وَالْحَسَنُ یَکْرَہَانِ أَنْ یَمَسَّ الرَّجُلُ امْرَأَتَہُ یَعْنِی فِی الرَّجُلِ یَقَعُ عَلَی أُمِّ امْرَأَتِہِ۔","","Musannaf Ibn Abi Shaybah 16497","","","كتاب النكاح"
"16498","(۱۶۴۹۸) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یَزِیدَ الرِّشْکِ قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ ، عَنْ رَجُلٍ یَفْجُرُ بِأُمِّ امْرَأَتِہِ ، فَقَالَ : أَمَّا الأُمُّ فَحَرَامٌ ، وَأَمَّا الْبِنْتُ فَحَلاَلٌ۔","","Musannaf Ibn Abi Shaybah 16498","","","كتاب النكاح"
"16499","(۱۶۴۹۹) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ أَبِیہِ قَالَ : سُئِلَ عُمَرُ ، عَنْ جَمْعِ الأُمِّ وَابْنَتِہَا مِنْ مِلْکِ الْیَمِینِ ، فَقَالَ : لاَ أُحِبُّ أَنْ یخبرہما جَمِیعًا۔","Sahih","Musannaf Ibn Abi Shaybah 16499","","","كتاب النكاح"
"16500","(۱۶۵۰۰) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ طَارِقٍ ، عَنْ قَیْسٍ بن أبی حازم قَالَ : قُلْتُ لاِبْنِ عَبَّاسٍ الرَّجُلُ یَقَعُ عَلَی الْجَارِیَۃِ وَابْنَتِہَا تَکُونَانِ عِنْدَہُ مَمْلُوکَتَیْنِ ، فَقَالَ : حَرَّمَتْہُمَا آیَۃٌ وَأَحَلَّتْہُمَا آیَۃٌ أُخْرَی وَلَمْ أَکُنْ لأَفْعَلَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 16500","","","كتاب النكاح"
"16501","(۱۶۵۰۱) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِی الزِّنَادِ ، عَنْ عَبْدِ اللہِ بْنِ نِیَار الأَسْلَمِیِّ قَالَ : کَانَتْ عِنْدِی جَارِیَۃٌ کُنْت أتَّطِئُہَا وَکَانَتْ مَعَہَا ابْنَۃٌ لَہَا فَأَدْرَکَتِ ابْنَتُہَا فَأَرَدْت أَنْ أمسک عَنْہَا وأتطی ابْنَتَہَا فَقَلتُ : لاَ أَفْعَلُ ذَلِکَ حَتَّی أَسْأَلَ عُثْمَانَ بْنَ عَفَّانَ ، فَسَأَلَتْہُ عَنْ ذَلِکَ ، فَقَالَ : أَمَّا أَنَا فَلَمْ أَکُنْ لنطلع مِنْہُما مُطَّلَعًا وَاحِدًا۔","","Musannaf Ibn Abi Shaybah 16501","","","كتاب النكاح"
"16502","(۱۶۵۰۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ أَنَّ مُعَاذَ بْنَ عُبَیْدِ اللہِ بْنِ مَعْمَرٍ سَأَلَ عَائِشَۃَ ، فَقَالَ : إنَّ عِنْدِی جَارِیَۃً أَصِیب مِنْہَا وَلَہَا ابْنَۃٌ قَدْ أَدْرَکَتْ فأصیب مِنْہَا ؟ فَنَہَتْہُ ، فَقَالَ : لاَ حَتَّی تَقُولِی ہِیَ حَرَامٌ ، فَقَالَتْ : لاَ یَفْعَلُہُ أَحَدٌ مِنْ أَہْلِی وَلاَ مِمَّنْ أَطَاعَنِی وَسَأَلْت ابْنَ عُمَرَ فَنَہَانِی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 16502","","","كتاب النكاح"
"16503","(۱۶۵۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ قَالَ : کَانَتْ لِرَجُلٍ مِنْ ہَمْدَانَ وَلِیدَۃٌ وَابْنَتُہَا ، فَکَانَ یَقَعُ عَلَیْہِمَا فَأُخْبِرَ بِذَلِکَ عَلِیٌّ فَسَأَلَہُ ، فَقَالَ : نَعَمْ ، فَقَالَ لَہُ عَلِیٌّ : إذَا أَحَلَّتْ لک آیَۃٌ وَحَرَّمَتْ عَلَیْک أُخْرَی فَإِنَّ أَمْلَکَہُمَا آیَۃُ الْحَرَامِ۔","Da'if","Musannaf Ibn Abi Shaybah 16503","","","كتاب النكاح"
"16504","(۱۶۵۰۴) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ مُنَبِّہٍ قَالَ : فِی التَّوْرَاۃِ الَّتِی أَنْزَلَ اللَّہُ عَلَی مُوسَی إِنَّہُ لاَ یَکْشِفُ رَجُلٌ فَرْجَ امْرَأَۃٍ وَابْنَتِہَا إلاَّ مَلْعُونٌ ، مَا فَصَّلَ لَنَا حُرَّۃً وَلاَ مَمْلُوکَۃً۔","","Musannaf Ibn Abi Shaybah 16504","","","كتاب النكاح"
"16505","(۱۶۵۰۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ قَالَ : جَاء َ رَجُلٌ إلَی عُمَرَ قَالَ : إنَّ لِی وَلِیدَۃً وَابْنَتَہَا وَإِنَّہُمَا قَدْ أَعْجَبَتانِی أَفَأَطَؤُہُمَا ؟ قَالَ : آیَۃٌ أَحَلَّتْ وَآیَۃٌ حَرَّمَتْ ، أَمَّا أَنَا فَلَمْ أَکُنْ أَقْرَبُ ہَذَا۔","","Musannaf Ibn Abi Shaybah 16505","","","كتاب النكاح"
"16506","(۱۶۵۰۶) حَدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدٍ قَالَ : لاَ یَجْمَعُ الرَّجُلُ بَیْنَ الْمَرْأَۃِ وَابْنَتِہَا وَلاَ بَیْنَ الْمَرْأَۃِ وَأُخْتِہَا۔","","Musannaf Ibn Abi Shaybah 16506","","","كتاب النكاح"
"16507","(۱۶۵۰۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ مُوسَی بْنِ أَیُّوبَ ، عَنْ عَمِّہِ ، عَنْ عَلِیٍّ قَالَ : سَأَلْتُہ ، عَنْ رَجُلٍ لَہُ أَمَتَانِ أُخْتَانِ وَطِئَ إحْدَاہُمَا ثُمَّ أَرَادَ أَنْ یَطَأَ الأُخْرَی قَالَ : لاَ حَتَّی یُخْرِجَہَا مِنْ مِلْکِہِ ، قَالَ : قُلْتُ : فَإِنَّہ زَوَّجَہَا عَبْدَہُ ؟ قَالَ : لاَ حَتَّی یُخْرِجَہَا من مِلْکِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 16507","","","كتاب النكاح"
"16508","(۱۶۵۰۸) حَدَّثَنَا عَبْدُ اللہِ بْنِ إدْرِیسَ ، وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عَوْنٍ ، عَنْ أَبِی صَالِحٍ الْحَنَفِیِّ أَنَّ ابْنَ الْکَوَّائِ سَأَلَ عَلِیًّا ، عَنِ الْجَمْعِ بَیْنَ الأُخْتَیْنِ ، فَقَالَ : حرَّمَتْہُمَا آیَۃٌ وَأَحَلَّتْہُمَا أُخْرَی وَلَسْت أَفْعَلُ أَنَا وَلاَ أَہْلِی۔","Sahih","Musannaf Ibn Abi Shaybah 16508","","","كتاب النكاح"
"16509","(۱۶۵۰۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : أَغْضَبُوا ابْنَ مَسْعُودٍ فِی الأُخْتَیْنِ الْمَمْلُوکَتَیْنِ ، فَغَضِبَ وَقَالَ : جَمَلَ أَحَدُکُمْ مِمَّا مَلَکَتْ یَمِینُہُ۔","","Musannaf Ibn Abi Shaybah 16509","","","كتاب النكاح"
"16510","(۱۶۵۱۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ فِی رَجُلٍ تَکُونُ لَہُ الأَمَتَانِ الأُخْتَانِ فَیَطَأُ إحْدَاہُمَا قَالَ : لاَ یَطَأُ الأُخْرَی حَتَّی یُخْرِجَہَا من مِلْکِہِ۔","","Musannaf Ibn Abi Shaybah 16510","","","كتاب النكاح"
"16511","(۱۶۵۱۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی الْجَہْمِ ، عَنْ أَبِی الأَخْضَرِ ، عَنْ عَمَّارٍ قَالَ : مَا حَرَّمَ اللَّہُ مِنَ الْحَرَائِرِ شَیْئًا إلاَّ وَقَدْ حَرَّمَہُ مِنَ الإِمَائِ إلاَّ أَنَّ الرَّجُلَ قَدْ یَجْمَعُ مَا شَاء َ مِ[corrupt]َ الإِمَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 16511","","","كتاب النكاح"
"16512","(۱۶۵۱۲) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ مَالِکِ بْنِ أَنَسَ ، عَنِ الزُّہْرِیِّ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ قَالَ : سُئِلَ عُثْمَانُ بْنُ عَفَّانَ ، عَنِ الأُخْتَیْنِ من مِلْکِ الْیَمِینِ یَجْمَعُ بَیْنَہُمَا ، فَقَالَ : أَحَلَّتْہُمَا آیَۃٌ مِنْ کِتَابِ اللہِ وَحَرَّمَتْہَا آیَۃٌ ، وَأَمَّا أَنَا فَمَا أُحِبُّ أَنْ أَفْعَلَ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 16512","","","كتاب النكاح"
"16513","(۱۶۵۱۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ مَیْمُونٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ سُئِلَ عَنْ رَجُلٍ لَہُ أَمَتَانِ أُخْتَانِ وَقَعَ عَلَی إحْدَاہُمَا أَیَقَعُ عَلَی الأُخْرَی؟ قَالَ: فَقَالَ ابْنُ عُمَرَ: لاَ یَقَعُ عَلَی الأُخْرَی مَا دَامَتِ الَّتِی وَقَعَ عَلَیْہَا فِی مِلْکِہِ۔","","Musannaf Ibn Abi Shaybah 16513","","","كتاب النكاح"
"16514","(۱۶۵۱۴) حَدَّثَنَا أَبُو بَکْرٍ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ قَالَ : سَأَلْتُ ابْنَ الْحَنَفِیَّۃِ ، عَنْ رَجُلٍ عِنْدَہُ أَمَتَانِ أختان أَیَطَؤُہُمَا ؟ فَقَالَ : أَحَلَّتْہُمَا آیَۃٌ وَحَرَّمَتْہُمَا آیَۃٌ ، ثُمَّ أَتَیْتُ ابْنَ الْمُسَیَّبِ ، فَقَالَ مِثْلَ قَوْلِ مُحَمَّدٍ ، ثُمَّ سَأَلْت ابْنَ مُنَبِّہٍ ، فَقَالَ : أَشْہَدُ أَنَّہُ فِیمَا أَنْزَلَ اللَّہُ عَلَی مُوسَی أَنَّہُ مَلْعُونٌ مَنْ جَمَعَ بَیْنَ الأُخْتَیْنِ قَالَ : فَمَا فَصَّلَ لَنَا حُرَّتَیْنِ وَلاَ مَمْلُوکَتَیْنِ قَالَ : فَرَجَعْت إلَی ابْنِ الْمُسَیَّبِ فَأَخْبَرْتہ ، فَقَالَ : اللَّہُ أَکْبَرُ۔","","Musannaf Ibn Abi Shaybah 16514","","","كتاب النكاح"
"16515","(۱۶۵۱۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ مُبَارَکٍ ، عَنِ ابْنِ ثَوْبَانَ ، عَنْ عَائِشَۃَ أَنَّہَا کَرِہَتْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 16515","","","كتاب النكاح"
"16516","(۱۶۵۱۶) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ یُونُسَ، عَنِ الْحَسَنِ؛ فِی رَجُلٍ لَہُ أَمَتَانِ أُخْتَانِ فَغَشِیَ إحْدَاہُمَا ثُمَّ أَمْسَکَ عَنْہَا ہَلْ لَہُ أَنْ یَغْشَی الأُخْرَی ، قَالَ : کَانَ یُعْجِبُہُ أَنْ لاَ یَغْشَاہَا حَتَّی یُخْرِجَ عَنْہُ ہَذِہِ الَّتِی غَشِیَ مِنْ مِلْکِہِ۔","","Musannaf Ibn Abi Shaybah 16516","","","كتاب النكاح"
"16517","(۱۶۵۱۷) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنِ الْحَکَمِ وَحَمَّادٍ قَالاَ: إذَا کَانَتْ عِنْدَ الرَّجُلِ أُخْتَانِ فَلاَ یَقْرَبَنَّ وَاحِدَۃً مِنْہُمَا۔","","Musannaf Ibn Abi Shaybah 16517","","","كتاب النكاح"
"16518","(۱۶۵۱۸) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَابْنِ سِیرِینَ قَالاَ : یَحْرُمُ مِنْ جَمْعِ الإِمَائِ مَا یَحْرُمُ مِنْ جَمْعِ الْحَرَائِرِ إلاَّ الْعَدَدَ۔","","Musannaf Ibn Abi Shaybah 16518","","","كتاب النكاح"
"16519","(۱۶۵۱۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ قَالَ : سَأَلَ رَجُلٌ عُثْمَانَ ، عَنِ الأُخْتَیْنِ یَجْمَعُ بَیْنَہُمَا ، فَقَالَ : أَحَلَّتْہُمَا آیَۃٌ وَحَرَّمَتْہُمَا آیَۃٌ وَلاَ آمُرُک وَلاَ أَنْہَاک فَلَقِیَ عَلِیًّا بِالْبَابِ ، فَقَالَ : عَمَّ سَأَلْتَہُ ؟فَأَخْبَرَہُ ، فَقَالَ : لَکِنِّی أَنْہَاک وَلَوْ کَانَ لِی عَلَیْک سَبِیلٌ ثُمَّ فَعَلْت ذَلِکَ لأَوْجَعْتُک۔","","Musannaf Ibn Abi Shaybah 16519","","","كتاب النكاح"
"16520","(۱۶۵۲۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ عُمَرَ ، عَنْ قَتَادَۃَ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ أَنَّ حَیًّا مِنْ أَحْیَائِ الْعَرَبِ سَأَلُوا مُعَاوِیَۃَ ، عَنْ الأُخْتَیْنِ مِمَّا مَلَکَتِ الْیَمِینُ ، یَکُونَانِ عِنْدَ الرَّجُلِ فَیَطَؤُہُمَا قَالَ : لَیْسَ بِذَلِکَ بَأْسٌ ، فَسَمِعَ بِذَلِکَ النُّعْمَانُ بْنُ بَشِیرٍ ، فَقَالَ أَفْتَیْت بِکَذَا وَکَذَا قَالَ : نَعَمْ ، قَالَ : أَرَأَیْت لَوْ کَانَتْ عِنْدَ رَجُلٍ أُخْتُہُ مَمْلُوکَۃً کَانَ یَجُوزُ لَہُ أَنْ یَطَأَہَُا ؟ فَقَالَ : أَمَا وَاللَّہِ إنَّمَا رَدَدْتنِی أَدْرِکْ فَقُلْ لَہُمَ اجْتَنِبُوا ذَلِکَ ، فَإِنَّہُ لاَ یَنْبَغِی لَہُمْ ، قَالَ : قُلْتُ : إنَّمَا ہِیَ الرَّحِمُ مِنَ الْعَتَاقَۃِ وَغَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 16520","","","كتاب النكاح"
"16521","(۱۶۵۲۱) حدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ ثُمَّ یُطَلِّقُہَا قَبْلَ أَنْ یَدْخُلَ بِہَا ، أَیَتَزَوَّجُ أُمَّہَا ؟ قَالَ : قَالَ عَلِیٌّ : ہِیَ بِمَنْزِلَۃِ الرَّبِیبَۃِ۔","","Musannaf Ibn Abi Shaybah 16521","","","كتاب النكاح"
"16522","(۱۶۵۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ عَلِیٍّ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 16522","","","كتاب النكاح"
"16523","(۱۶۵۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ زَیْدِ بْنِ ثَابِتٍ أَنَّہُ کَانَ لاَ یَرَی بِہِ بَأْسًا إذَا طَلَّقَہَا وَیَکْرَہُہَا إذَا مَاتَتْ عِنْدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 16523","","","كتاب النكاح"
"16524","(۱۶۵۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ أَبِی بَکْرٍ بْنِ حَفْصِ بْنِ عُمَرَ بْنِ سَعْدٍ أَنَّ مُسْلِمَ بْنَ عُوَیْمِرِ بْنِ الأَجْدَعِ مِنْ بَنِی بَکْرِ بْنِ کِنَانَۃَ أَخْبَرَہُ أَنَّ أَبَاہُ أَنْکَحَہُ امْرَأَۃً بِالطَّائِفِ ، قَالَ : فَلَمْ أُجَامِعْہَا حَتَّی تُوُفِّیَ عَمِی ، عَنْ أُمِّہَا ، وَأُمُّہَا ذَاتُ مَالٍ کَثِیرٍ ، فَقَالَ لِی أبی ہَلْ لَکَ فِی أُمِّہَا ؟ فَقُلْتُ : وَدِدْت وَکَیْفَ وَقَدْ نَکَحَتِ ابْنَتَہَا، قَالَ : فَسَأَلْت ابْنَ عَبَّاسٍ ، فَقَالَ انْکِحْہَا ، وَسَأَلْت ابْنَ عُمَرَ ، فَقَالَ : لاَ تَنْکِحْہَا : قَالَ : فَکَتَبَ أَبِی عُوَیْمِرٍ فِی ذَلِکَ إلَی مُعَاوِیَۃَ وَأَخْبَرَہُ فِی کِتَابِہِ بِمَا قَالَ ابْنُ عَبَّاسٍ وَبِمَا قَالَ ابْنُ عُمَرَ فَکَتَبَ إلَیْہِ مُعَاوِیَۃُ : لاَ أُحِلُّ مَا حَرَّمَ اللَّہُ وَلاَ أُحَرِّمُ مَا أَحَلَّ اللَّہُ وَأَنْتَ وَذَاکَ وَالنِّسَائُ کَثِیرٌ قَالَ : فَلَمْ یَنْہَنِی وَلَمْ یَأْذَنْ وَانْصَرَفَ أَبِی عَنْہَا فَلَمْ نُنْکِحْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 16524","","","كتاب النكاح"
"16525","(۱۶۵۲۵) حَدَّثَنَا وَکِیع بن الجراح ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَرْوَۃَ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ أَنَّہُ أَفْتَی فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَطَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا ، أَوْ مَاتَتْ عِنْدَہُ ، فَقَالَ : لاَ بَأْسَ أَنْ یَتَزَوَّجَ أُمَّہَا ثُمَّ أَتَی الْمَدِینَۃَ فَرَجَعَ فَأَتَاہُمْ فَنَہَاہُمْ وَقَدْ وَلَدَتْ أَوْلاَدًا۔","Sahih","Musannaf Ibn Abi Shaybah 16525","","","كتاب النكاح"
"16526","(۱۶۵۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ابن جریج قَالَ : أخبرنی دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ فِی {أُمَّہَاتِ نِسَائِکُمْ} قَالَ : مَا أَرْسَلَ اللَّہُ فَأَرْسِلُوا ، وَمَا بَیَّنَ فَاتَّبِعُوا۔","","Musannaf Ibn Abi Shaybah 16526","","","كتاب النكاح"
"16527","(۱۶۵۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ قَالَ : أَخْبَرَنِی عِکْرِمَۃُ ، عَنْ مُجَاہِدٍ أَنَّہُ قَالَ فِی {وَأُمَّہَاتُ نِسَائِکُمْ وَرَبَائِبُکُمَ اللاَّتِی فِی حُجُورِکُمْ} : أُرِیدَ بِہِمَا جَمْعُہُمَا۔","","Musannaf Ibn Abi Shaybah 16527","","","كتاب النكاح"
"16528","(۱۶۵۲۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ قَالَ : قُلْتُ لِعَطَائٍ : الرَّجُلُ یَتَزَوَّجُ الْمَرْأَۃَ ثُمَّ لاَ یَرَاہَا وَلاَ یُجَامِعُہَا حَتَّی یُطَلِّقَہَا أَیَتَزَوَّجُ أُمَّہَا ؟ قَالَ : لاَ ہِیَ مُرْسَلَۃٌ۔","","Musannaf Ibn Abi Shaybah 16528","","","كتاب النكاح"
"16529","(۱۶۵۲۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ أَنَّہُ کَانَ یَکْرَہُ إذَا مَلَکَ الرَّجُلُ عُقْدَۃَ امْرَأَۃٍ أَنْ یَتَزَوَّجَہَا۔","","Musannaf Ibn Abi Shaybah 16529","","","كتاب النكاح"
"16530","(۱۶۵۳۰) حَدَّثَنَا عَفَّانَ قَالَ : حدَّثَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ قَالَ : أَخْبَرَنِی عَاصِمُ بْنُ سَعِیدٍ الْہُذَلِیُّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ زَیْدَ بْنَ ثَابِتٍ کَانَ یَکْرَہُ أَنْ یَتَزَوَّجَ بِنْتَ امْرَأَۃٍ مَاتَتْ أُمُّہَا عِنْدَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 16530","","","كتاب النكاح"
"16531","(۱۶۵۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ قَالَ : قُلْتُ لاِبْنِ أَبِی نَجِیحٍ : الرَّجُلُ یَتَزَوَّجُ الْمَرْأَۃَ ثُمَّ یُطَلِّقُہَا قَبْلَ أَنْ یَدْخُلَ بِہَا أَیَتَزَوَّجُ أُمَّہَا ؟ فَقَالَ : سَمِعْتُ عِکْرِمَۃَ یَنْہَی عَنْہَا وَعَطَائً۔","","Musannaf Ibn Abi Shaybah 16531","","","كتاب النكاح"
"16532","(۱۶۵۳۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ الْحُصَیْنِ فِی {أُمَّہَاتِ نِسَائِکُمْ} قَالَ : ہِیَ مُبْہَمَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 16532","","","كتاب النكاح"
"16533","(۱۶۵۳۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زمعۃ عن ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، أَنَّہُ کَرِہَہَا ، وَقَالَ ہِیَ مُبْہَمَۃٌ۔","","Musannaf Ibn Abi Shaybah 16533","","","كتاب النكاح"
"16534","(۱۶۵۳۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہِیَ مُبْہَمَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 16534","","","كتاب النكاح"
"16535","(۱۶۵۳۵) حدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ قَالَ : کَانَ ابْنُ عُمَرَ یَرَی عَبْدَہُ یَتَسَرَّی فِی مَالِہِ فَلاَ یَعِیبُ ذَلِکَ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 16535","","","كتاب النكاح"
"16536","(۱۶۵۳۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ قَالَ : کَتَبَ إلَیَّ نَافِعٌ إِنَّ الْعَبْدَ یَتَسَرَّی فِی مَالِہِ وَلاَ یَتَسَرَّی فِی مَالِ سَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 16536","","","كتاب النكاح"
"16537","(۱۶۵۳۷) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : کَانَ لاَ یَرَی بَأْسًا أَنْ یَتَسَرَّی الْعَبْدُ بِإِذْنِ سَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 16537","","","كتاب النكاح"
"16538","(۱۶۵۳۸) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ سَعْدِ بْنِ إبْرَاہِیمَ، عَنْ عُمَرَ بْنِ عَبْدِالْعَزِیزِ قَالَ: لاَ بَأْسَ أَنْ یَتَسَرَّی الْعَبْدُ۔","","Musannaf Ibn Abi Shaybah 16538","","","كتاب النكاح"
"16539","(۱۶۵۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16539","","","كتاب النكاح"
"16540","(۱۶۵۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16540","","","كتاب النكاح"
"16541","(۱۶۵۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا، عَنِ الشَّعْبِیِّ قَالَ: إذَا أَذِنَ الْمَوْلَی لِعَبْدِہِ فِی التَّسَرِّی ، فَلْیَتَّخِذْ مِنْہُنَّ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 16541","","","كتاب النكاح"
"16542","(۱۶۵۴۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ قَالَ: لَمْ نَکُنْ نَرَی بِتَسَرِّی الْعَبْدِ فِی مَالِ سَیِّدِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 16542","","","كتاب النكاح"
"16543","(۱۶۵۴۳) حَدَّثَنَا عَبْدَۃُ بن سلیمان ، عَنْ إسْمَاعِیلَ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16543","","","كتاب النكاح"
"16544","(۱۶۵۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْعَبَّاسِ بْنِ عبد اللہِ بْنِ مَعْبَدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ لَہُ غُلاَمٌ تَاجِرٌ ، وَکَانَ یَأْذَنُ لَہُ فَیَتَسَرَّی السِّتَّ وَالسَّبْعَ۔","","Musannaf Ibn Abi Shaybah 16544","","","كتاب النكاح"
"16545","(۱۶۵۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنَ کُہَیْلٍ ، عَنِ الْحَکَمِ قَالَ : یَتَزَوَّجُ وَلاَ یَتَسَرَّی۔","","Musannaf Ibn Abi Shaybah 16545","","","كتاب النكاح"
"16546","(۱۶۵۴۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ أَنَّہُ کَانَ یُحِبُّ أَنْ یُزَوِّجَہُ۔","","Musannaf Ibn Abi Shaybah 16546","","","كتاب النكاح"
"16547","(۱۶۵۴۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ حَمَّادًا ، عَنْ ذَلِکَ ، فَقَالَ : أَلَمْ تَسْمَعِ وَلَکِنَّ اللَّہَ یَقُولُ : {إلاَّ عَلَی أَزْوَاجِہِمْ أَوْ مَا مَلَکَتْ أَیْمَانُہُمْ}۔","","Musannaf Ibn Abi Shaybah 16547","","","كتاب النكاح"
"16548","(۱۶۵۴۸) حَدَّثَنَا حَفْص بن غیاث، عَنْ أَشْعَثَ، عَنِ الْحَکَمِ، وَابْنِ سِیرِینَ أَنَّہُمَا کَرِہَا أَنْ یَتَسَرَّی، وَإِنْ أَذِنَ لَہُ مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 16548","","","كتاب النكاح"
"16549","(۱۶۵۴۹) حَدَّثَنَا عَبْدَۃُ بن سلیمان ، عَنْ إسْمَاعِیلَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَتَسَرَّی الْعَبْدُ۔","","Musannaf Ibn Abi Shaybah 16549","","","كتاب النكاح"
"16550","(۱۶۵۵۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، عَنْ عُمَرَ، قَالَ: مَنْ تَزَوَّجَ امْرَأَۃً وَبِہَا بَرَصٌ ، أَوْ جُذَامٌ ، أَوْ جُنُونٌ فَدَخَلَ بِہَا فَلَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا وَذَلِکَ غُرْمٌ عَلَی وَلِیِّہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16550","","","كتاب النكاح"
"16551","(۱۶۵۵۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ قَالَ : کَانَ عَلِیٌّ یَقُولُ فِی الْمَجْنُونَۃِ وَالْبَرْصَائِ : إِنْ دَخَلَ فَہِیَ امْرَأَتُہُ ، وَإِنْ لَمْ یَدْخُلْ فُرِّقَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 16551","","","كتاب النكاح"
"16552","(۱۶۵۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : أَرْبَعٌ لاَ یَجُوزُنَ فِی بَیْعٍ وَلاَ نِکَاحٍ : الْبَرْصَائُ وَالْمَجْنُونَۃُ وَالْمَجْذُومَۃُ وَذَاتُ الْقَرَنِ۔","","Musannaf Ibn Abi Shaybah 16552","","","كتاب النكاح"
"16553","(۱۶۵۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ أَنَّ رَجُلاً تَزَوَّجَ امْرَأَۃً فَدَخَلَ بِہَا ثُمَّ وَجَدَ بِہَا عَیْبًا فَکَتَبَ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی ذَلِکَ ، فَکَتَبَ أَنَّہُ قَدْ اتَّمَنَہُمْ عَلَی مَا ہُوَ أَعْظَمُ مِنْ ذَلِکَ فَأَجَازَہَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16553","","","كتاب النكاح"
"16554","(۱۶۵۵۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ سُئِلَ عَنِ الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ فَیَدْخُلُ بِہَا فَیَظْہَرُ عَلَیْہَا دَائٌ أَنَّہُ کَانَ یُوجِبُہَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16554","","","كتاب النكاح"
"16555","(۱۶۵۵۵) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ عَمْرِو بْنِ مَیْمُونٍ، عَنْ عُمَرَ بْنِ عَبْدِالْعَزِیزِ قَالَ: لَیْسَ لَہُ إلاَّ أَمَانَۃُ أَصْہَارِہِ۔","","Musannaf Ibn Abi Shaybah 16555","","","كتاب النكاح"
"16556","(۱۶۵۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : الْحُرَّۃُ لاَ تُرَدُّ مِنْ عَیْبٍ۔","","Musannaf Ibn Abi Shaybah 16556","","","كتاب النكاح"
"16557","(۱۶۵۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ أَنَّہُ کَانَ یُعَوِّضُ الْبَرْصَاء َ۔","","Musannaf Ibn Abi Shaybah 16557","","","كتاب النكاح"
"16558","(۱۶۵۵۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ وَالزُّہْرِیِّ قَالاَ : فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَدَخَلَ فَرَأَی بِہَا جُنُونًا ، أَوْ جُذَامًا ، أَوْ بَرَصًا ، أَوْ عَفَلاً : إنَّہَا تُرَدُّ مِنْ ہَذَا وَلَہَا الصَّدَاقُ الَّذِی اسْتَحَلَّ بِہِ فَرْجَہَا الْعَاجِلُ وَالآجِلُ وَصَدَاقُہَ عَلَی مَنْ غَرَّہُ۔","","Musannaf Ibn Abi Shaybah 16558","","","كتاب النكاح"
"16559","(۱۶۵۵۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ جَمِیلٍ ، عَنْ عَبْدِ اللہِ بْنِ کَعْبٍ ، أَوْ کَعْبِ بْنِ عَبْدِ اللہِ قَالَ : تَزَوَّجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ امْرَأَۃً مِنْ غِفَارٍ فَقَعَدَ مِنْہَا مَقْعَدَ الرَّجُلِ مِنَ الْمَرْأَۃِ فَأَبْصَرَ بِکَشْحِہَا بَرَصًا فَقَامَ عَنْہَا ، فَقَالَ : سَوِّی عَلَیْک ثِیَابَک وَارْجِعِی إلَی بَیْتِک۔","Da'if","Musannaf Ibn Abi Shaybah 16559","","","كتاب النكاح"
"16560","(۱۶۵۶۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَن عَبْدِ اللہِ قَالَ : لاَ تُرَدُّ الْحُرَّۃُ مِنْ عَیْبٍ۔","","Musannaf Ibn Abi Shaybah 16560","","","كتاب النكاح"
"16561","(۱۶۵۶۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ أَنَّہُ قَالَ : إذَا تَزَوَّجَ الرَّجُلُ الْمَرْأَۃَ وَبِالرَّجُلِ عَیْبٌ لَمْ تَعْلَمْ بِہِ ، جُنُونٌ ، أَوْ جُذَامٌ ، أَوْ بَرَصٌ خُیِّرَتْ۔","","Musannaf Ibn Abi Shaybah 16561","","","كتاب النكاح"
"16562","(۱۶۵۶۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ أَنَّہُ قَالَ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ وَبِہِ الْبَرَصُ قَالَ : کَانَ لاَ یَرَاہُ مِنَ الرَّجُلِ شَیْئًا ، وَأَمَّا الْجُذَامُ فَإِنْ شَاء َتْ أَقَرَّتْ مَعَہُ ، وَإِنْ شَاء َتْ فَارَقَتْہُ۔","","Musannaf Ibn Abi Shaybah 16562","","","كتاب النكاح"
"16563","(۱۶۵۶۳) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ وَہُوَ أَیُّوبُ ، عَنْ قَتَادَۃَ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً وَبِہِ جُنُونٌ ، أَوْ دَائٌ عُضَالٌ لاَ تعْلَمُ بِہِ قَالَ : ہِیَ بِالْخِیَارِ إذَا عَلِمَتْ وَقَالَ أَبُو ہَاشِمٍ : ہِیَ امْرَأَتُہُ إِنْ شَاء َ أَمْسَکَ ، وَإِنْ شَاء َ طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 16563","","","كتاب النكاح"
"16564","(۱۶۵۶۴) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ قَالَ : سَأَلْتُ مُرَّۃَ ، عَنِ الرَّجُلِ یَشْتَرِی ، أَوْ یَسْبِی الْجَارِیَۃَ الْمَجُوسِیَّۃَ ثُمَّ یَقَعُ عَلَیْہَا قَبْلَ أَنْ تَعْلَمَ الإِسْلاَمَ قَالَ لاَ یَصْلُحُ ، وَسَأَلْت سَعِیدَ بْنَ جُبَیْرٍ ، فَقَالَ : مَا ہُوَ بِأَخْیَرَ مِنْہَا إذَا فَعَلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16564","","","كتاب النكاح"
"16565","(۱۶۵۶۵) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ بُرْدٍ، عَنْ مَکْحُولٍ قَالَ: إذَا کَانَتْ وَلِیدَۃً مَجُوسِیَّۃً، فَإِنَّہُ لاَ یَنْکِحُہَا حَتَّی تُسْلِمَ۔","","Musannaf Ibn Abi Shaybah 16565","","","كتاب النكاح"
"16566","(۱۶۵۶۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ قَالَ سَمِعْتُہُ یَقُولُ : لاَ تَقْرَبِ الْمَجُوسِیَّۃَ حَتَّی تَقُولَ لاَ إلَہَ إلاَّ اللَّہُ ، فَإِذَا قَالَتْ ذَلِکَ فَہُوَ مِنْہَا إسْلاَمٌ۔","","Musannaf Ibn Abi Shaybah 16566","","","كتاب النكاح"
"16567","(۱۶۵۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ سِمَاکٍ ، عَنْ أَبِی سَلَمَۃَ فِی الْمَجُوسِیَّۃِ قَالَ : لاَ تَقْرَبْہَا مَتَی تُسْلِمُ۔","","Musannaf Ibn Abi Shaybah 16567","","","كتاب النكاح"
"16568","(۱۶۵۶۸) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الْمَجُوسِیَّۃِ تَکُونُ عِنْدَ الرَّجُلِ قَالَ : لاَ یَطَؤُہَا۔","","Musannaf Ibn Abi Shaybah 16568","","","كتاب النكاح"
"16569","(۱۶۵۶۹) حَدَّثَنَا جَرِیر بن عبد لحمید ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا سُبِیَتِ الْمَجُوسِیَّاتُ وَعَبَدَۃُ الأَوْثَانِ عُرِضَ عَلَیْہِنَّ الإِسْلاَمُ وجبرن فَإِنْ أَسْلَمْنَ وُطِئْنَ وَاسْتُخْدِمْنَ ، وَإِنْ أَبَیْنَ أَنْ یُسْلِمْنَ اسْتُخْدِمْنَ وَلَمْ یُوطَئْنَ۔","","Musannaf Ibn Abi Shaybah 16569","","","كتاب النكاح"
"16570","(۱۶۵۷۰) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ مُثَنَّی ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لاَ بَأْسَ أَنْ یَشْتَرِیَ الرَّجُلُ الْجَارِیَۃَ الْمَجُوسِیَّۃَ فَیَتَسَرَّاہَا۔","","Musannaf Ibn Abi Shaybah 16570","","","كتاب النكاح"
"16571","(۱۶۵۷۱) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ مُثَنَّی قَالَ : کَانَ عَطَائٌ وَطَاوُسٌ وَعَمْرُو بْنُ دِینَارٍ لاَ یَرَوْنَ بَأْسًا أَنْ یَتَسَرَّی الرَّجُلُ الْمَجُوسِیَّۃَ وَکَرِہَہُ سَعِیدُ بْنُ الْمُسَیِّبِ۔","","Musannaf Ibn Abi Shaybah 16571","","","كتاب النكاح"
"16572","(۱۶۵۷۲) حَدَّثَنَا شَاذَانُ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ بَکْرِ بْنِ مَاعِزٍ ، عَنْ رَبِیعِ بْنِ خُثَیْمٍ قَالَ : إذَا أَصَبْت الأَمَۃَ الْمُشْرِکَۃَ فَلاَ تَأْتِیہَا حَتَّی تُسْلِمَ وَتَغْتَسِلَ۔","","Musannaf Ibn Abi Shaybah 16572","","","كتاب النكاح"
"16573","(۱۶۵۷۳) حَدَّثَنَا جَرِیر بن عبد لحمید ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا سُبِیَتِ الْیَہُودِیَّاتُ وَالنَّصْرَانِیَّات عُرِضَ عَلَیْہِنَّ الإِسْلاَمُ وَجُبِرْنَ عَلَیْہِ فَإِنْ أَسْلَمْنَ ، أَوْ لَمْ یُسْلِمْنَ وطِئْنَ وَاسْتُخْدِمْنَ۔","","Musannaf Ibn Abi Shaybah 16573","","","كتاب النكاح"
"16574","(۱۶۵۷۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ فِی الرَّجُلِ إذَا کَانَتْ لَہُ وَلِیدَۃٌ یَہُودِیَّۃٌ ، أَوْ نَصْرَانِیَّۃٌ ، فَإِنَّہُ یَتَّطِؤُہَا۔","","Musannaf Ibn Abi Shaybah 16574","","","كتاب النكاح"
"16575","(۱۶۵۷۵) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ الْیَہُودِیَّۃُ وَالنَّصْرَانِیَّۃُ یَتَّطئہما۔","","Musannaf Ibn Abi Shaybah 16575","","","كتاب النكاح"
"16576","(۱۶۵۷۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : إذَا أَصَابَ الرَّجُلُ الْجَارِیَۃَ الْمُشْرِکَۃَ فَلْیُقْرِرْہَا بِشَہَادَۃِ لاَ إلَہَ إلاَّ اللَّہُ فَإِنْ أَبَتْ أن تُقِرَّ لَمْ یَمْنَعْہُ ذَلِکَ أَنْ یَقَعَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 16576","","","كتاب النكاح"
"16577","(۱۶۵۷۷) حَدَّثَنَا عَبدَۃ بن سلیمان، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ قَالَ، کَانَ عَبْدُاللہِ یَکْرَہُ أَمَتَہُ مُشْرِکَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 16577","","","كتاب النكاح"
"16578","(۱۶۵۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : إذَا کَانَتْ لَہُ أَمَۃٌ مِنْ أَہْلِ الْکِتَابِ فَلَہُ أَنْ یَغْشَاہَا إِنْ شَاء َ وَیُکْرِہَہَا عَلَی الْغُسْلِ۔","","Musannaf Ibn Abi Shaybah 16578","","","كتاب النكاح"
"16579","(۱۶۵۷۹) حَدَّثَنَا مُعْتَمِر بن سلیمان ، عَنْ نَاجِیَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ مَسْعُودٍ فِی الْمَسْبِیَّۃِ : لاَ یَطَؤُہَا حَتَّی تُہَلِّلَ وَتُسْلِمَ۔","","Musannaf Ibn Abi Shaybah 16579","","","كتاب النكاح"
"16580","(۱۶۵۸۰) حَدَّثَنَا یَزِیدُ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنِ الرَّجُلِ یَشْتَرِی الْجَارِیَۃَ مِنَ السَّبْیِ فَیَقَعُ عَلَیْہَا قَالَ : لاَ حَتَّی یُعَلِّمَہَا الصَّلاَۃَ وَالْغُسْلَ مِنَ الْجَنَابَۃِ وَحَلْقَ الْعَانَۃِ۔","","Musannaf Ibn Abi Shaybah 16580","","","كتاب النكاح"
"16581","(۱۶۵۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنِ الْحَسَنِ بْنِ مُحَمَّدٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَتَبَ إلَی مَجُوسِ أَہْلِ ہَجَرَ یَعْرِضُ عَلَیْہِمَ الإِسْلاَمَ فَمَنْ أَسْلَمَ قَبِلَ مِنْہُ وَمَنْ لَمْ یُسْلِمْ ضَرَبَ عَلَیْہِ الْجِزْیَۃَ غَیْرَ نَاکِحِی نِسَائِہِمْ وَلاَ آکِلِی ذَبَائِحِہِمْ۔ (عبدالرزاق ۱۰۰۲۸۔ بیہقی ۲۸۵)","","Musannaf Ibn Abi Shaybah 16581","","","كتاب النكاح"
"16582","(۱۶۵۸۲) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ قَالَ ، أَخْبَرَنِی مَنْ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یُکْرَہُ أَنْ یَطْلُبَ الرَّجُلُ الْوَلَدَ مِنَ الأَمَۃِ إذَا کَانَتْ وَلَدَ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 16582","","","كتاب النكاح"
"16583","(۱۶۵۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرٍ ، عَنْ أَبِی جَعْفَرٍ قَالَ : یَتَسَرَّی وَلَدَ الزِّنَا وَلاَ یَطْلُبُ وَلَدَہَا۔","","Musannaf Ibn Abi Shaybah 16583","","","كتاب النكاح"
"16584","(۱۶۵۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُثْمَانَ بْنِ الْحَارِثِ ، عَنْ أَبِی الرُّوَاعِ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ ، عَنْ وَلَدِ الزِّنَا ، فَقَالَ : النِّسَائُ کَثِیرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 16584","","","كتاب النكاح"
"16585","(۱۶۵۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ إبْرَاہِیمَ قَالَ لاَ بَأْسَ أَنْ یَتَسَرَّاہَا۔","","Musannaf Ibn Abi Shaybah 16585","","","كتاب النكاح"
"16586","(۱۶۵۸۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَکُونُ تَحْتَہُ الأَمَۃُ لِزِنْیَۃ قَالَ : ہِیَ کَعَرَضِ مَالِہِ یَتَّطِؤُہَا۔","","Musannaf Ibn Abi Shaybah 16586","","","كتاب النكاح"
"16587","(۱۶۵۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : لاَ بَأْسَ أَنْ یَشْتَرِیَ الرَّجُلُ وَلَدَ الزِّنْیَۃِ یَتَسَرَّاہَا۔","","Musannaf Ibn Abi Shaybah 16587","","","كتاب النكاح"
"16588","(۱۶۵۸۸) حَدَّثَنَا مُعْتَمِر بن سلیمان ، عَنْ أَبِیہِ ، عَنْ سَیّار مَوْلًی لِمُعَاوِیَۃَ قَالَ : أَرَادَ رَجُل أَنْ یَتَزَوَّجَ بِنْتَ زِنْیَۃٍ فَسَأَلَ عَنْ ذَلِکَ رَجُلاً مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : لاَ ، إذا أَتَزَوَّجَ أُمَّہَا أَحَبُّ إلَیَّ مِنْ أَنْ أَتَزَوَّجَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 16588","","","كتاب النكاح"
"16589","(۱۶۵۸۹) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ فِی الرَّجُلِ یَتَسَرَّی وَلَدَ الزِّنَا قَالَ : وَمَا ذَنْبُہُ فِیمَا عَمِلَ أَبَوَاہُ۔","","Musannaf Ibn Abi Shaybah 16589","","","كتاب النكاح"
"16590","(۱۶۵۹۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ اللہِ بْنِ حَبِیبٍ ، قَالَ : سَمِعْتُ الْحَکَمَ یَقُولُ : لَوْ کَانَتْ لِی جَارِیَۃُ وَلَدِ الزِّنَا لَمْ أُبَالِی أَنْ أَطَأَہَا۔","","Musannaf Ibn Abi Shaybah 16590","","","كتاب النكاح"
"16591","(۱۶۵۹۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمرو ، عَنْ أَبِی مَعْبَدٍ ؛ أَنَّ ابْنَ عَبَّاسٍ وَطِیئَ جَارِیَۃً بَعْدَ مَا أَنْکَرَ وَلَدَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16591","","","كتاب النكاح"
"16592","(۱۶۵۹۲) حَدَّثَنَا حَفْص بن غیاث ، عَنْ لَیْثٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی لبابۃ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَطَأَ الرَّجُلُ أَمَتہ إذَا فَجَرَتْ ، وَیَرَی أَنَّ ذَلِکَ تَحْصِینٌ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 16592","","","كتاب النكاح"
"16593","(۱۶۵۹۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ مُحَمَّدِ بْنِ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ أَنَّہُ وَطِیئَ جَارِیَۃً لَہُ بَعْدَ مَا فَجَرَتْ۔","","Musannaf Ibn Abi Shaybah 16593","","","كتاب النكاح"
"16594","(۱۶۵۹۴) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ فِی الرَّجُلِ یَطَأُ أَمَتَہُ وَقَدْ زَنَتْ قَالَ : ہُوَ بِالْخِیَارِ إِنْ شَاء َ وَطِئَہَا ، وَإِنْ شَاء َ أَمْسَکَ۔","","Musannaf Ibn Abi Shaybah 16594","","","كتاب النكاح"
"16595","(۱۶۵۹۵) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ قَالَ : کَانَ عَبْدُ اللہِ یَکْرَہُ أَمَتہ قَدْ زَنَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 16595","","","كتاب النكاح"
"16596","(۱۶۵۹۶) حَدَّثَنَا الْفَضْلُ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : سَمِعْتُہُ وَسُئِلَ عَنِ الرَّجُلِ یَرَی أَمَتَہُ تَفْجُرُ أَیَطَؤُہَا ؟ قَالَ : لاَ وَلاَ کَرَامَۃَ۔","","Musannaf Ibn Abi Shaybah 16596","","","كتاب النكاح"
"16597","(۱۶۵۹۷) حَدَّثَنَا حَفْص بن غیاث ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ وَعَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالاَ : إذَا رَأَی الرَّجُلُ امْرَأَتَہُ تَفْجُرُ لَمْ یُحَرِّمْہَا ذَلِکَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16597","","","كتاب النكاح"
"16598","(۱۶۵۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ فِی الرَّجُلِ یری تَزْنِی امْرَأَتُہُ قَالَ : لاَ یُحَرِّمُہَا ذَلِکَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16598","","","كتاب النكاح"
"16599","(۱۶۵۹۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ مَسْلَمَۃَ ، عَنْ عِمْرَانَ بْنِ عَبْدِ اللہِ ، عَنْ سَالِمٍ قَالَ لَہُ رَجُلٌ : إنِّی رَأَیْت مَعَ امْرَأَتِی رَجُلاً ، قَالَ : تَطِیبُ نَفْسُک ، أَوْ کَیْفَ تَطِیبُ نَفْسُک أَنْ تُمْسِکَہَا وَقَدْ رَأَیْت مَا رَأَیْت وَلَمْ تَحْرُمْ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 16599","","","كتاب النكاح"
"16600","(۱۶۶۰۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَرَی مِنِ امْرَأَتِہِ فَاحِشَۃً أَنَّہُ یَکْرَہُ أَنْ یُمْسِکَہَا۔","","Musannaf Ibn Abi Shaybah 16600","","","كتاب النكاح"
"16601","(۱۶۶۰۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیْدِ بْنِ جَابِرٍ ، عَنْ مَکْحُولٍ قَالَ : إذَا أطَّلَعَ الرَّجُلُ عَلَی امْرَأَتِہِ أَنَّہَا تَفْجُرُ لَمْ یَحِلَّ لَہُ أَنْ یُمْسِکَہَا ، وَإِذَا فَجَرَ ہُوَ ، لَمْ یَحِلَّ لَہَا أَنْ تُقِیمَ مَعَہُ۔","","Musannaf Ibn Abi Shaybah 16601","","","كتاب النكاح"
"16602","(۱۶۶۰۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنِ الشَّیْبَانِیِّ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ قَالَ: کُنْتُ جَالِسًا مَعَ ابْنِ عَبَّاسٍ فِی زَمْزَمَ فَأَتَاہُ رَجُلٌ فَذَکَر لہ أَنَّہُ تَسَقَّط امْرَأَتَہُ فَزَعَمَتْ أَنَّہَا فَجَرَتْ ، فَقَالَ لَہُ ابْنُ عَبَّاسٍ : فَبِئْسَ مَا صَنَعْت إِنْ کُنْت فَعَلْت مِثْلَ الَّذِی أَقَرَّتْ بِہِ عَلَی نَفْسِہَا ، فَأَمْسِکَ علیک امْرَأَتَکَ، وَإِنْ کَانَتْ لَمْ تَفْعَلْ فَخَلِّ سَبِیلَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16602","","","كتاب النكاح"
"16603","(۱۶۶۰۳) حَدَّثَنَا عَبدَۃ بن سلیمان ، عَنْ سَعِیدٍ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ ، إذَا رَأَی أَحَدُکُمَ امْرَأَتَہُ ، أَوْ أُمَّ وَلَدِہِ عَلَی فَاحِشَۃٍ فَلاَ یَقْرَبْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16603","","","كتاب النكاح"
"16604","(۱۶۶۰۴) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَام قَالَ: کُنْتُ جَالِسًا عِنْدَ طَاوُوسٍ ، فَقَالَ لَہُ رَجُلٌ: إنِّی وَجَدْت فِی مَجْلِسِی رَجُلاً ، فَقَالَ طَاوُوسٌ: إِنْ طَابَتْ نَفْسُک أَنْ تُمْسِکَہَا وَقَدْ رَأَیْت مَا رَأَیْت فَأَنْتَ أَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 16604","","","كتاب النكاح"
"16605","(۱۶۶۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَاء َ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ عِنْدِی امْرَأَۃً أَحَبُّ النَّاسِ إلَیَّ ، وَإِنَّہَا لاَ تَمْنَعُ یَدَ لاَمِسٍ ، قَالَ : طَلِّقْہَا قَالَ : لاَ أَصْبِرُ عَنْہَا ، قَالَ : فَاسْتَمْتِعْ بِہَا۔n(ابوداؤد ۲۰۴۲۔ بیہقی ۱۵۵)","Da'if","Musannaf Ibn Abi Shaybah 16605","","","كتاب النكاح"
"16606","(۱۶۶۰۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ، عَنِ اب[corrupt]نِ عَبَّاسٍ ، قَالَ : جَاوَزَ حُرْمَتَیْنِ إلَی حُرْمَۃٍ وإن لَمْ تَحْرُمْ عَلَیْہِ امْرَأَتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 16606","","","كتاب النكاح"
"16607","(۱۶۶۰۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ إذَا زَنَی الرَّجُلُ بِأُخْتِ امْرَأَتِہِ فَإِنَّہَا لاَ تَحْرُمُ عَلَیْہِ ، لاَ یُحَرِّمُ حَرَامٌ حَلاَلاً۔","","Musannaf Ibn Abi Shaybah 16607","","","كتاب النكاح"
"16608","(۱۶۶۰۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثقفی ، عَنْ عُثْمَانَ الْبَتِّیِّ ، عَنِ ابْنِ أَشْوَعَ أَنَّہُ سُئِلَ عَنْہَا ، فَقَالَ لاَ یُحَرِّمُ الْحَرَامُ الْحَلاَلَ ، جَسَرْتُ عَلَیْہَا ، وَہَابَہَا إبْرَاہِیمُ وَالشَّعْبِیُّ۔","","Musannaf Ibn Abi Shaybah 16608","","","كتاب النكاح"
"16609","(۱۶۶۰۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ حَرُمَتْ عَلَیْہِ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 16609","","","كتاب النكاح"
"16610","(۱۶۶۱۰) وَحَدَّثَنَا سَعِیدٌ قَالَ قَتَادَۃُ: لاَ یُحَرِّمُہَا ذَلِکَ عَلَیْہِ غَیْرَ أَنَّہُ لاَ یَغْشَی امْرَأَتَہُ حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی بَنَی بِہَا۔","","Musannaf Ibn Abi Shaybah 16610","","","كتاب النكاح"
"16611","(۱۶۶۱۱) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ جَابِرِ بْنِ زَیْدٍ، وَالْحَسَنِ أَنَّہُمَا قَالاَ: حرُمَتْ عَلَیْہِ امْرَأَتُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 16611","","","كتاب النكاح"
"16612","(۱۶۶۱۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ النَّخَعِیِّ : مِثْلَ قَوْلِ قَتادۃ ، وَإِنْ کَانَتْ حَامِلاً فَحَتی تَضَعَ حَمْلَہَا۔","","Musannaf Ibn Abi Shaybah 16612","","","كتاب النكاح"
"16613","(۱۶۶۱۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ صَاحِبٍ لَہُ ، عَنْ عَطَائٍ قَالَ : لاَ یُحَرِّمُہَا ذَلِکَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16613","","","كتاب النكاح"
"16614","(۱۶۶۱۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ أَنَّہُ بَلَغَہُ عَنِ الشَّعْبِیِّ قَالَ : لاَ یُحَرِّمُہَا ذَلِکَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16614","","","كتاب النكاح"
"16615","(۱۶۶۱۵) حَدَّثَنَا أبو عَبْد الصَّمَدِ الْعَمِّیُّ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ قَالَ: حرُمَتْ عَلَیْہِ امْرَأَتُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 16615","","","كتاب النكاح"
"16616","(۱۶۶۱۶) حَدَّثَنَا أبو عَبْد الصَّمَدِ الْعَمِّیُّ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ یَحْیَی بْنِ یَعْمَُرَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَمْ تَحْرُمَ امْرَأَتُہُ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 16616","","","كتاب النكاح"
"16617","(۱۶۶۱۷) حَدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عَبْدِ الصَّمَدِ الْعَمِّیُّ ، عَنْ بُدَیْلِ بْنِ مَیْسَرَۃَ الْعُقَیْلِیِّ ، عَنِ أَبِی الْوَضِینِ أَنَّ رَجُلاً تَزَوَّجَ إلَی رَجُلٍ مِنْ أَہْلِ الشَّامِ بنتا لَہُ ابْنَۃَ مَہِیرَۃٍ فَزَوَّجَہُ وَزَفَّ إلَیْہِ ابْنَۃً لَہُ أُخْرَی بنت فَتَاۃ فَسَأَلَہَا الرَّجُلُ بَعْدَ مَا دَخَلَ بِہَا : ابْنَۃُ مَنْ أَنْتِ ؟ قَالَتْ : ابْنَۃُ الفَتَاۃِ تَعْنِی فُلاَنَۃً ، فَقَالَ : إنَّمَا تَزَوَّجْت إلَی أبیک ابنتہ ابْنَۃِ الْمَہِیرَۃِ فَارْتَفَعُوا إلَی مُعَاوِیَۃَ بْنِ أَبِی سُفْیَانَ ، فَقَالَ : امْرَأَۃٌ بِامْرَأَۃٍ وَسَأَلَ مَنْ حَوْلَہُ مِنْ أَہْلِ الشَّامِ ، فَقَالَ : امْرَأَۃٌ بِامْرَأَۃٍ ، فَقَالَ الرَّجُلُ : لمُعَاوِیَۃُ ، ارْفَعْنَا إلَی عَلِیِّ بْنِ أَبِی طَالِبٍ ، فَقَالَ : اذْہَبُوا إلَیْہِ فَأَتَوْا عَلِیًّا فَرَفَعَ عَلِیٌّ مِنَ الأَرْضِ شَیْئًا ، فَقَالَ : الْقَضَائُ فِی ہَذَا أَیْسَرُ مِنْ ہَذَا ، لِہَذِہِ مَا سُقْتَ إلَیْہَا بِمَا اسْتَحْلَلْتَ مِنْ فَرْجِہَا وَعَلَی أَبِیہَا أَنْ یجہز الأُخْرَی بِمَا سُقْتَ إلَی ہَذِہِ وَلاَ تَقْرَبْہَا حَتَّی تَنْقَضِیَ عِدَّۃُ ہَذِہِ الأُخْرَی ، قَالَ: وَأَحْسَبُ أَنَّہُ جَلَدَ أَبَاہَا ، أَوْ أَرَادَ أَنْ یَجْلِدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 16617","","","كتاب النكاح"
"16618","(۱۶۶۱۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ المُغِیرَۃَ الطَّائِفِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ ابن البیلمَانِی مَوْلَی عُمَرَ قَالَ : خَطَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَنْکِحُوا الأَیَامَی مِنْکُمْ فَقَامَ إلَیْہِ رَجُلٌ ، فَقَالَ : یَا رَسُولَ اللہِ ، مَا الْعَلاَئِقُ بَیْنَہُمْ ؟ قَالَ : مَا تَرَاضَی عَلَیْہِ أَہْلُوہُمْ۔n(بیہقی ۲۳۹۔ ابن عدی ۲۱۸۸)","Da'if","Musannaf Ibn Abi Shaybah 16618","","","كتاب النكاح"
"16619","(۱۶۶۱۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَبِیبۃَ ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنِ اسْتَحَلَّ بِدِرْہَمٍ فَقَدِ اسْتَحَلَّ قَالَ : وَسَمِعْت وَکِیعًا یُفْتِی بِہِ یَقُولُ : یَتَزَوَّجُہَا بِدِرْہَمٍ۔ (ابویعلی ۹۳۹)","Da'if","Musannaf Ibn Abi Shaybah 16619","","","كتاب النكاح"
"16620","(۱۶۶۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ، عَنْ أَبِیہِ أَنَّ رَجُلاً تَزَوَّجَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی نَعْلَیْنِ فَأَجَازَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نِکَاحَہُ۔ (ترمذی ۱۱۱۳۔ احمد ۳/۴۴۵)","Da'if","Musannaf Ibn Abi Shaybah 16620","","","كتاب النكاح"
"16621","(۱۶۶۲۱) حَدَّثَنَا حُسَیْنِ بْنِ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنُ سعْدٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ زَوَّجَ رَجُلاً امْرَأَۃً عَلَی أَنْ یُعَلِّمَہَا سُورَۃً مِنَ الْقُرْآنِ۔ (بخاری ۲۳۱۰۔ مسلم ۷۷)","Sahih","Musannaf Ibn Abi Shaybah 16621","","","كتاب النكاح"
"16622","(۱۶۶۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لَوْ رَضِیَتْ بِسَوْطٍ کَانَ مَہْرَہَا۔","","Musannaf Ibn Abi Shaybah 16622","","","كتاب النكاح"
"16623","(۱۶۶۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ قَالَ : تَزَوَّجَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ عَلَی وَزْنِ نَوَاۃٍ مِنْ ذَہَبٍ قُوِّمَتْ ثَلاَثَۃَ دَرَاہِمَ وَثُلُثًا۔","","Musannaf Ibn Abi Shaybah 16623","","","كتاب النكاح"
"16624","(۱۶۶۲۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ قَالَ: مَا تَرَاضَی عَلَیْہِ الزَّوْجُ وَالْمَرْأَۃُ مِنْ شَیْئٍ فَہُوَ مَہْرٌ۔","","Musannaf Ibn Abi Shaybah 16624","","","كتاب النكاح"
"16625","(۱۶۶۲۵) حَدَّثَنَا عبد اللہ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، فِی الرَّجُلِ یَتَزَوَّجُ عَلَی عَشَرَۃِ دَرَاہِمَ قَالَ : قدْ کَانَ الْمُسْلِمُونَ یَتَزَوَّجُونَ عَلَی أَقَلَّ مِنْ ذَلِکَ وَأَکْثَرَ۔","","Musannaf Ibn Abi Shaybah 16625","","","كتاب النكاح"
"16626","(۱۶۶۲۶) حَدَّثَنَا إسماعیل ابْنُ عُلَیَّۃَ ، عَنْ صَالِحِ بْنِ مُسْلِمٍ قَالَ : قُلْتُ لِلشَّعْبِیِّ : رَجُلٌ تَزَوَّجَ امْرَأَۃً بِدِرْہَمٍ قَالَ : لاَ یَصْلُحُ إلاَّ بِثَوْبٍ ، أَوْ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 16626","","","كتاب النكاح"
"16627","(۱۶۶۲۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ عَوْنٍ قَالَ : سَأَلْتُ الْحَسَنَ مَا أَدْنَی مَا یَتَزَوَّجُ الرَّجُلُ عَلَیْہِ ؟ قَالَ : نَوَاۃٌ مِنْ ذَہَبٍ ، أَوْ وَزْنُ نَوَاۃٍ مِنْ ذَہَبٍ۔","","Musannaf Ibn Abi Shaybah 16627","","","كتاب النكاح"
"16628","(۱۶۶۲۸) حَدَّثَنَا حَفْص بن غیاث ، عَنْ أَشْعَثَ وَہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی الْعَجْفَائِ السُّلَمِیِّ ، عَنْ عُمَرَ ، قَالَ : لاَ تُغَالُوا فِی مُہُورِ النِّسَائِ فَإِنَّہَا لَوْ کَانَتْ مَکْرُمَۃً فِی الدُّنْیَا ، أَوْ تَقْوَی عِنْدَ اللہِ لَکَانَ أَحَقَّکُمْ بِہَا مُحَمَّدًا صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَوْلاَکُمْ ، مَا زَوَّجَ بِنْتًا مِنْ بَنَاتِہِ وَلاَ تَزَوَّجَ شَیْئًا مِنْ نِسَائِہِ إلاَّ عَلَی اثْنَتَی عَشْرَۃَ أُوقِیَّۃً۔ (ابوداؤد ۲۰۹۹۔ احمد ۱/۴۰)","Sahih","Musannaf Ibn Abi Shaybah 16628","","","كتاب النكاح"
"16629","(۱۶۶۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی الْعَجْفَائِ السُّلَمِی قَالَ قَالَ عُمَرُ : لاَ تُغَالُوا صُدُقَ النِّسَائِ ثُمَّ ذَکَرَ مِثْلَ حَدِیثِ حَفْصٍ۔ (ابن ماجہ ۱۸۸۷)","Sahih","Musannaf Ibn Abi Shaybah 16629","","","كتاب النكاح"
"16630","(۱۶۶۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : حَدَّثَنِی مُحَمَّدُ بْنُ إبْرَاہِیمَ قَالَ : کَانَ صَدَاقُ بَنَاتِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَصَدَاقُ نِسَائِہِ خَمْسَ مِئَۃِ دِرْہَمٍ۔ (ابوداؤد ۲۰۹۸۔ عبدالرزاق ۱۰۴۰۷)","","Musannaf Ibn Abi Shaybah 16630","","","كتاب النكاح"
"16631","(۱۶۶۳۱) حَدَّثَنَا شَرِیک عَبْدِاللہِ، عَنْ دَاوُدَ الزعَافِری، عَنِ الشَّعْبِیِّ قَالَ: قَالَ عَلِیٌّ: لاَ مَہْرَ بِأَقَلَّ مِنْ عَشَرَۃِ دَرَاہِمَ۔","Da'if","Musannaf Ibn Abi Shaybah 16631","","","كتاب النكاح"
"16632","(۱۶۶۳۲) حَدَّثَنَا وَکِیع بن الجراح ، عَنِ ابن أَبِی رَوَّادٍ ، عَنْ نَافِعٍ ، أَنَّ عُمَرَ نَہَی أَنْ یُزَادَ النِّسَاء عَلَی أَرْبَعِ مِئَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 16632","","","كتاب النكاح"
"16633","(۱۶۶۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یُتَزَوَّجَ عَلَی أَقَلَّ مِنْ أرْبَعِینَ ، وَکَانَ الْحَکَمُ لاَ یَرَی بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 16633","","","كتاب النكاح"
"16634","(۱۶۶۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ قَالَ : تَزَوَّجَ ابْنُ عُمَرَ صَفِیَّۃَ عَلَی أَرْبَعِ مِئَۃِ دِرْہَمٍ فَأَرْسَلَتْ إلَیْہِ إِنَّ ہَذَا لاَ یَکْفِینَا فَزَادَہَا مِئَتَیْنِ سِرًّا مِنْ عُمَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 16634","","","كتاب النكاح"
"16635","(۱۶۶۳۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : السُّنَّۃُ فِی النِّکَاحِ اثْنَا عَشَرَ أُوقِیَّۃً وَنِصْفَ فَذَلِکَ خَمْسُ مِئَۃِ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 16635","","","كتاب النكاح"
"16636","(۱۶۶۳۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ أَبِی ہَارُونَ ، عَنْ أَبِی سَعِیدٍ قَالَ : لَیْسَ عَلَی الرَّجُلِ جُنَاحٌ أَنْ یَتَزَوَّجَ بِقَلِیلٍ مِنْ مَالِہِ ، أَوْ کَثِیرٍ إذَا تَرَاضَوْا وَأَشْہَدُوا۔","Da'if","Musannaf Ibn Abi Shaybah 16636","","","كتاب النكاح"
"16637","(۱۶۶۳۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بن مُوسَی ، عَنِ ابْنِ قُسَیْطٍ أَنَّ سَعِیدَ بْنَ الْمُسَیَّبِ قَالَ : لَوْ أَصْدَقَہَا سَوْطًا لَحَلَّتْ لَہُ۔","","Musannaf Ibn Abi Shaybah 16637","","","كتاب النكاح"
"16638","(۱۶۶۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : حدَّثَنِی مُوسَی بْنُ عَبْدِ اللہِ قَالَ : حدَّثَنَا إِسْحَاقُ بْنُ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ الأَنْصَارِیُّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَزَوَّجَ سَوْدَۃَ بِنْتَ زَمْعَۃَ عَلَی بَیْتٍ وَرِثَہُ مِنْ بَعْضِ نِسَائِہِ۔","","Musannaf Ibn Abi Shaybah 16638","","","كتاب النكاح"
"16639","(۱۶۶۳۹) حَدَّثَنَا أَبُو خَالِد الأحمر ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَتَزَوَّجَ الرَّجُلُ عَلَی الدِّرْہَمِ وَالدِّرْہَمَین مِثْلِ مَہْرِ الْبَغِیِّ۔","","Musannaf Ibn Abi Shaybah 16639","","","كتاب النكاح"
"16640","(۱۶۶۴۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شعبۃ عن أَبِی سَلَمَۃَ ، عَنِ الشَّعْبِیِّ قَالَ : سَمِعَہُ یَقُولُ : کَانُوا یَکْرَہُونَ أَنْ یُتَزَوَّجَ عَلَی أَقَلَّ مِنْ ثَلاَثِ أَوَاقٍ۔","","Musannaf Ibn Abi Shaybah 16640","","","كتاب النكاح"
"16641","(۱۶۶۴۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنِ ابْنِ سَخْبَرَۃَ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَعْظَمُ النِّسَائِ بَرَکَۃً أَیْسَرُہُنَّ مُؤْنَۃً۔ (احمد ۶/۱۴۵۔ حاکم ۱۷۸)","Da'if","Musannaf Ibn Abi Shaybah 16641","","","كتاب النكاح"
"16642","(۱۶۶۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ التَّیْمِیِّ أَنَّ أَبَا حَدْرَدٍ الأَسْلَمِیَّ اسْتَعَانَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَہْرِ امْرَأَۃٍ نَکَحَہَا فَسَأَلَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَمْ أَصْدَقْتہَا ؟ فَقَالَ : مِئَتَی دِرْہَمٍ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ کُنْتُمْ تَغْرِفُونَ مِنْ بَطْحَانَ مَا زِدْتُمْ۔ (احمد ۳/۴۴۸۔ طبرانی ۸۸۴)","","Musannaf Ibn Abi Shaybah 16642","","","كتاب النكاح"
"16643","(۱۶۶۴۳) حَدَّثَنَا عَبْدَۃ بن سلیمان ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ أَنَّ النَّجَاشِیَّ زَوَّجَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُمَّ حَبِیبَۃَ عَلَی أَرْبَعِ مِئَۃِ دِینَارٍ۔ (ابوداؤد ۲۱۰۰۔ ابن سعد ۹۸)","","Musannaf Ibn Abi Shaybah 16643","","","كتاب النكاح"
"16644","(۱۶۶۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ أَنَّ عُمَرَ تَزَوَّجَ أُمَّ کُلْثُومٍ عَلَی أَرْبَعِینَ أَلْفِ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 16644","","","كتاب النكاح"
"16645","(۱۶۶۴۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی أَنَّ عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ تَزَوَّجَ امْرَأَۃً عَلَی ثَلاَثِینَ أَلْفًا۔","Da'if","Musannaf Ibn Abi Shaybah 16645","","","كتاب النكاح"
"16646","(۱۶۶۴۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْمُغِیرَۃِ بْنِ حَکِیمٍ قَالَ : أَوَّلُ مَنْ سَنَّ الصَّدَاقَ أَرْبَعَ مِئَۃِ دِینَارٍ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ۔","","Musannaf Ibn Abi Shaybah 16646","","","كتاب النكاح"
"16647","(۱۶۶۴۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ تَزَوَّجَ شُمیلۃ السُّلمیۃ عَلَی عَشَرَۃِ آلاَفٍ۔","","Musannaf Ibn Abi Shaybah 16647","","","كتاب النكاح"
"16648","(۱۶۶۴۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ أَنَّ ابْنَ عُمَرَ کَانَ یُزَوِّجُ الْمَرْأَۃَ مِنْ بَنَاتِہِ عَلَی عَشَرَۃِ آلاَفٍ۔n(ابویوسف ۱۰۲۱)","Sahih","Musannaf Ibn Abi Shaybah 16648","","","كتاب النكاح"
"16649","(۱۶۶۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مَہْدِیٍّ ، عَنْ غَیْلاَنَ ، عَنْ مُطَرِّفٍ أَنَّہُ أَصْدَقَ امْرَأَۃً تَزَوَّجَہَا مِنْ بَنِی عُقَیْلٍ عِشْرِینَ أَلْفًا۔","","Musannaf Ibn Abi Shaybah 16649","","","كتاب النكاح"
"16650","(۱۶۶۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ أَنَّ عُمَرَ رَخَّصَ أَنْ تُصْدَق الْمَرْأَۃَ أَلْفَیْنِ وَرَخَّصَ عُثْمَانُ فِی أَرْبَعَۃِ آلاَفٍ۔","Da'if","Musannaf Ibn Abi Shaybah 16650","","","كتاب النكاح"
"16651","(۱۶۶۵۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ کُرَیْبِ بْنِ ہِشَامٍ ، وَکَانَ مِنْ أَصْحَابِ عَبْدِ اللہِ أَنَّہُ تَزَوَّجَ امْرَأَۃً عَلَی أَرْبَعَۃِ آلاَفٍ۔","","Musannaf Ibn Abi Shaybah 16651","","","كتاب النكاح"
"16652","(۱۶۶۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : خَطَبَ عَمْرُو بْنُ حُرَیْثٍ إلَی عَدِیِّ بْنِ حَاتِمٍ ابْنَتَہُ فَأَبَی إلاَّ عَلَی حُکْمِہِ فَحَکَّمَ عَدِیٌّ سُنَّۃَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَمَانِینَ وَأَرْبَعَ مِئَۃٍ فَبَعَثَ إلَیْہِ عَمْرٌو بِعَشَرَۃِ آلاَفٍ ، فَقَالَ : جَہِّزْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 16652","","","كتاب النكاح"
"16653","(۱۶۶۵۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ أَنَّ الْحَسَنَ بْنَ عَلِیٍّ تَزَوَّجَ امْرَأَۃً فَأَرْسَلَ إلَیْہَا مِئَۃَ جَارِیَۃٍ مَعَ کُلِّ جَارِیَۃٍ أَلْفُ دِرْہَمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 16653","","","كتاب النكاح"
"16654","(۱۶۶۵۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّ رَجُلاً تَزَوَّجَ امْرَأَۃً فَأَسَرَّ ذَلِکَ ، فَکَانَ یَخْتَلِفُ إلَیْہَا فِی مَنْزِلِہَا فَرَآہُ جَارٌ لَہَا یَدْخُلُ عَلَیْہَا فَقَذَفَہُ بِہَا فَخَاصَمَہُ إلَی عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، ہَذَا کَانَ یَدْخُلُ عَلَی جَارِیَۃٍ وَلاَ أَعْلَمُہُ تَزَوَّجَہَا ، فَقَالَ لَہُ : مَا تَقُولُ ؟ فَقَالَ : تَزَوَّجْت امْرَأَۃً عَلَی شَیْئٍ دُونٍ فَأَخْفَیْتُ ذَلِکَ ، قَالَ : فَمَنْ شَہِدَکُمْ ؟ قَالَ : أَشْہَدْت بَعْضَ أَہْلِہَا ، قَالَ : فَدَرَأَ الْحَدَّ ، عَنْ قَاذِفِہِ وَقَالَ: أَعْلِنُوا ہَذَا النِّکَاحَ وَحَصِّنُوا ہَذِہِ الْفُرُوجَ۔","Hasan","Musannaf Ibn Abi Shaybah 16654","","","كتاب النكاح"
"16655","(۱۶۶۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ ہِشَامٍ قَالَ کَانَ أَبِی یَقُولُ : لاَ یَصْلُحُ نِکَاحُ السِّرِّ۔","","Musannaf Ibn Abi Shaybah 16655","","","كتاب النكاح"
"16656","(۱۶۶۵۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ دَاوُدَ بْنِ قیس ، قَالَ : سَمِعْتُ نَافِعًا مَوْلَی ابْنِ عُمَرَ یَقُولُ : لَیْسَ فِی الإِسْلاَمِ نِکَاحُ السِّرِّ۔","","Musannaf Ibn Abi Shaybah 16656","","","كتاب النكاح"
"16657","(۱۶۶۵۷) حَدَّثَنَا أَبُو نُعَیْمٍ، عَنْ سُفْیَانَ، عَنْ زِیَادِ بْنِ فَیَّاضٍ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ قَالَ، أَشَرُّ النِّکَاحِ نکاح السِّرُّ۔","Sahih","Musannaf Ibn Abi Shaybah 16657","","","كتاب النكاح"
"16658","(۱۶۶۵۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ قَالَ : مُرَّ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِعَرُوسٍ ، فَقَالَ : لَوْ کَانَ مَعَ ہَذَا لَہْوٌ۔ (بخاری ۵۱۶۲۔ حاکم ۱۸۴)","Da'if","Musannaf Ibn Abi Shaybah 16658","","","كتاب النكاح"
"16659","(۱۶۶۵۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ قَالَ : نُبِّئْت أَنَّ عُمَرَ کَانَ إذَا اسْتَمَعَ صَوْتًا أَنْکَرَہُ وَسَأَلَ عَنْہُ ، فَإِنْ قِیلَ عُرْسٌ ، أَوْ خِتَانٌ أَقَرَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 16659","","","كتاب النكاح"
"16660","(۱۶۶۶۰) حَدَّثَنَا وَکِیع بن الجراح ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ شَیْخٍ مِنْ بَنِی سَلِمَۃَ ، عَنْ أبی قَتَادَۃَ أَنَّہُ قَالَ لِجَارِیَۃٍ فِی عُرْسٍ تَضْرِبُ بِالدُّفِّ : ارْعَفِی ارْعَفِی۔","Da'if","Musannaf Ibn Abi Shaybah 16660","","","كتاب النكاح"
"16661","(۱۶۶۶۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ قَالَ : لَقَدْ ضُرِبَ لَیْلَۃَ الملک بِالدُّفِّ وَغُنِّیَ عَلَی رَأْسِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ۔","Da'if","Musannaf Ibn Abi Shaybah 16661","","","كتاب النكاح"
"16662","(۱۶۶۶۲) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَامِرِ بْنِ سَعْدٍ قَالَ : دَخَلْتُ عَلَی أَبِی مَسْعُود وَقَرَظَۃَ بْنِ کَعْبٍ وَعِنْدَہُمَا جَوَارٍ یُغَنِّینَ ، فَقُلْتُ : أَتَفْعَلُونَ ہَذَا وَأَنْتُمْ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ ، فَقَالَ : إنَّہُ رُخِّصَ لَنَا فِی اللَّہْوِ عِنْدَ الْعُرْسِ۔ (بیہقی ۲۸۹۔ طبرانی ۶۹۰)","Hasan","Musannaf Ibn Abi Shaybah 16662","","","كتاب النكاح"
"16663","(۱۶۶۶۳) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بَلْجٍ ، عَنْ مُحَمَّدِ بْنِ حَاطِبٍ قَالَ قَالَ رَسُولُ اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصْلُ مَا بَیْنَ الْحَلاَلِ وَالْحَرَامِ الصَّوْتُ یَعْنِی الضَّرْبَ بِالدُّفِّ۔ (ترمذی ۱۰۸۸۔ احمد ۳/۴۱۸)","","Musannaf Ibn Abi Shaybah 16663","","","كتاب النكاح"
"16664","(۱۶۶۶۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ أَبَا إِسْحَاقَ یُحَدِّثُ ، عَنْ عامر بن سعد أَنَّہُ قَالَ : کُنْتُ مَعَ ثَابِتِ بْنِ وَدِیعَۃَ وَقَرَظَۃَ بْنِ کَعْبٍ فِی عُرْسٍ فَسَمِعْت صَوْتَ غِنَائٍ ، فَقُلْتُ : أَلاَ تَسْمَعَانِ ؟ فَقَالاَ : إنَّہُ قَدْ رُخِّصَ لَنَا فِی الْغِنَائِ عِنْدَ الْعُرْسِ وَالْبُکَائِ عَلَی الْمَیِّتِ مِنْ غَیْرِ نِیَاحَۃٍ۔ (حاکم ۱۸۴۔ طیالسی ۱۲۲۱)","Da'if","Musannaf Ibn Abi Shaybah 16664","","","كتاب النكاح"
"16665","(۱۶۶۶۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ قَالَ : حدَّثَنَا ابْنُ عَوْنٍ قَالَ : کَانَ فِی آلِ مُحَمَّدٍ مِلاَکٌ فَلَمَّا أَنْ فَرَغُوا وَرَجَعَ مُحَمَّدٌ إلَی مَنْزِلِہِ قَالَ لَہُنَّ : فَأَیْنَ صفاقتکن قَالَ ابْنُ عَوْنٍ : یَعْنِیَ الدُّفَّ۔","","Musannaf Ibn Abi Shaybah 16665","","","كتاب النكاح"
"16666","(۱۶۶۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ قَالَ : دَخَلَ ابْنُ مَسْعُودٍ عُرْسًا فِیہِ مَزَامِیرُ وَلَہْوٌ فَقَعَدَ وَلَمْ یَنْہَ عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 16666","","","كتاب النكاح"
"16667","(۱۶۶۶۷) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ حین خَتَنَ بَنِیہِ فَدَعَا اللاَّعِبِینَ فَأَعْطَاہُمْ أَرْبَعَۃَ دَرَاہِمَ ، أَوْ قَالَ : ثَلاَثَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 16667","","","كتاب النكاح"
"16668","(۱۶۶۶۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ مَغْرَاء َ العمی ، عَنْ شُرَیْحٍ أَنَّہُ سَمِعَ صَوْتَ دُفٍّ ، فَقَالَ : الْمَلاَئِکَۃُ لاَ یَدْخُلُونَ بَیْتًا فِیہِ دُفٌّ۔","","Musannaf Ibn Abi Shaybah 16668","","","كتاب النكاح"
"16669","(۱۶۶۶۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عِمْرَانَ بْنِ مُسلِم ، قَالَ : قَالَ لِی خَیْثَمَۃُ : أما سَمِعْت سُوَیْدًا یَقُولُ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ دُفٌّ۔","","Musannaf Ibn Abi Shaybah 16669","","","كتاب النكاح"
"16670","(۱۶۶۷۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یَسْتَقْبِلُونَ الْجَوَارِیَ فِی الأَزِفَّۃِ مَعَہُنَّ الدُّفُّ فَیَشُقُّونَہَا۔","","Musannaf Ibn Abi Shaybah 16670","","","كتاب النكاح"
"16671","حدثنا أبو عبد الرحمن بقی بن مخلد ، قَالَ : حدثنا أبو بکر قَالَ :n(۱۶۶۷۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنِ القاسم ، أَنَّ عَبْدَ اللہِ بْنَ جَعْفَرٍ جَمَعَ بَیْنَ ابْنَۃِ عَلِیٍّ وَامْرَأَتِہِ یَعْنِی مِنْ غَیْرِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 16671","","","كتاب النكاح"
"16672","(۱۶۶۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ أَنَّ عَبْدَ اللہِ بْنَ صَفْوَانَ تَزَوَّجَ امْرَأَۃَ رَجُلٍ مِنْ ثَقِیفٍ وَابْنَتَہُ یَعْنِی مِنْ غَیْرِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16672","","","كتاب النكاح"
"16673","(۱۶۶۷۳) حَدَّثَنَا ابْنِ عُلَیَّۃَ ، عَنْ أَیُّوبَ : سُئِلَ عَنْ ذَلِکَ مُحَمَّدُ بْنُ سِیرِینَ فَلَمْ یَرَ بِہِ بَأْسًا وَقَالَ : نُبِّئْت أَنْ جبَلَۃ رَجُلٌ کَانَ یَکُونُ بِمِصْرٍ تَزَوَّجَ أُمَّ وَلَدِ رَجُلٍ وَابْنَتَہُ یَعْنِی مِنْ غَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 16673","","","كتاب النكاح"
"16674","(۱۶۶۷۴) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ قَالَ : نُبِّئْت ، عَنْ سَعْدِ بْنِ قَرْحَاء رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَمَعَ بَیْنَ امْرَأَۃِ رَجُلٍ وَابْنَتِہِ مِنْ غَیْرِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 16674","","","كتاب النكاح"
"16675","(۱۶۶۷۵) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : لاَ بَأْسَ أَنْ یَجْمَعَ الرَّجُلُ بَیْنَ أُمِّ وَلَدِ رَجُلٍ وَابْنَتِہِ یَعْنِی مِنْ غَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 16675","","","كتاب النكاح"
"16676","(۱۶۶۷۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : لاَ بَأْسَ أَنْ یَجْمَعَ الرَّجُلُ بَیْنَ امْرَأَۃِ الرَّجُلِ وَابْنَتِہِ یَعْنِی مِنْ غَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 16676","","","كتاب النكاح"
"16677","(۱۶۶۷۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : لاَ بَأْسَ أَنْ یَجْمَعَ الرَّجُلُ بَیْنَ ابْنَۃِ الرَّجُلِ وَامْرَأَۃِ أَبِیہَا ، وَإِنَّ الْحَسَنَ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 16677","","","كتاب النكاح"
"16678","(۱۶۶۷۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ قَالَ : سُئِلَ الْحَسَنُ ، عَنْ ذَلِکَ فَکَرِہَہُ ، فَقَالَ لَہُ بَعْضُہم : یَا أَبَا سَعِیدٍ ، ہَلْ تَرَی بَیْنَہُمَا شَیْئًا ؟ فنظر ، فَقَالَ : لاَ أَرَی بَیْنَہُمَا شَیْئًا۔","","Musannaf Ibn Abi Shaybah 16678","","","كتاب النكاح"
"16679","(۱۶۶۷۹) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثٍ بن سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ أَنَّہُ کَانَ یَقُولُ : لاَ بَأْسَ أَنْ یَجْمَعَ الرَّجُلُ بَیْنَ الْمَرْأَۃِ وَبَیْنِ امْرَأَۃِ أَبِیہَا۔","","Musannaf Ibn Abi Shaybah 16679","","","كتاب النكاح"
"16680","(۱۶۶۸۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ قَالَ : سَأَلْتُ مُحَمَّدًا ، فَقَالَ لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 16680","","","كتاب النكاح"
"16681","(۱۶۶۸۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ قَالَ : سُئِلَ الْحَسَنُ ، عَنِ الرَّجُلِ یَتَزَوَّجُ امْرَأَۃَ الرَّجُلِ وَابْنَتَہُ فَکَرِہَ ذَلِکَ یَعْنِی مِنْ غَیْرِہَا۔","","Musannaf Ibn Abi Shaybah 16681","","","كتاب النكاح"
"16682","(۱۶۶۸۲) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ فُضَیْلٍ ، عَنِ أَبِی حَرِیز ، عَنْ عِکْرِمَۃَ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَجْمَعَ الرَّجُلُ بَیْنَ الْمَرْأَۃِ وَامْرَأَۃِ أَبِیہَا۔","","Musannaf Ibn Abi Shaybah 16682","","","كتاب النكاح"
"16683","(۱۶۶۸۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مُحَمَّدِ بْنِ عُثَِیم ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ البیلَمَانِیِّ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ قَالَ : سُئِلَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا یَجُوزُ فِی الرَّضَاعِ مِنَ الشُّہُودِ ؟ قَالَ رَجُلٌ وَامْرَأَۃٌ۔n(احمد ۲/۱۰۹۔ بیہقی ۴۶۴)","Da'if","Musannaf Ibn Abi Shaybah 16683","","","كتاب النكاح"
"16684","(۱۶۶۸۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُمَرَ بْنِ سَعِیدِ بْنِ أَبِی حُسَیْنٍ قَالَ : حدَّثَنِی عَبْدُ اللہِ بْنُ أَبِی مُلَیْکَۃَ ، قَالَ: حَدَّثَنِی عُقْبَۃُ بْنُ الْحَارِثِ قَالَ : تَزَوَّجْت ابْنَۃَ أَبِی إہَابٍ التّمَِیْمِیِّ فَلَمَّا کَانَتْ صَبِیحَۃُ مِلْکِہَا جَائَتْ مَوْلاَۃٌ لأَہْلِ مَکَّۃَ ، فَقَالَتْ : إنِّی أَرْضَعْتُکُمَا فَرَکِبَ عُقْبَۃُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ بِالْمَدِینَۃِ فَذَکَرَ ذَلِکَ لَہُ وَقَدْ سَأَلْت أَہْلَ الْجَارِیَۃِ فَأَنْکَرُوا ، فَقَالَ : کَیْفَ وَقَدْ قِیلَ فَفَارَقَہَا وَنَکَحَتْ غَیْرَہُ۔n(بخاری ۸۸۔ ابوداؤد ۳۵۹۸)","Sahih","Musannaf Ibn Abi Shaybah 16684","","","كتاب النكاح"
"16685","(۱۶۶۸۵) حَدَّثَنَا عَبدَۃ بن سلیمان ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ إذَا کَانَتِ الْمَرْأَۃُ مَرْضِیَّۃً جَازَتْ شَہَادَتُہَا فِی الرَّضَاعَۃِ وَیُؤْخَذُ بِیَمِینِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16685","","","كتاب النكاح"
"16686","(۱۶۶۸۶) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ أَنَّ عُمَرَ رَدَّ شَہَادَۃَ امْرَأَۃٍ فِی رِضَاعٍ۔","Da'if","Musannaf Ibn Abi Shaybah 16686","","","كتاب النكاح"
"16687","(۱۶۶۸۷) حَدَّثَنَا حَفْصٌ ، عَنْ حلام بْنِ صَالِحٍ ، عَنْ بُکَیرِ بْنِ فَائِدٍ أَنَّ امْرَأَۃً جَاء َتْ إلَی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَزَعَمَتْ أَنَّہَا قَدْ أَرْضَعَتْہُمَا ، فَأَتَی عَلِیًّا فَسَأَلَہُ ، فَقَالَ : ہِیَ امْرَأَتُک لَیْسَ أَحَدٌ یُحَرِّمُہَا عَلَیْک ، وَإِنْ تَنَزَّہْتَ فَہُوَ أَفْضَلُ ، وَسَأَلَ ابْنَ عَبَّاسٍ ، فَقَالَ مِثْلَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 16687","","","كتاب النكاح"
"16688","(۱۶۶۸۸) ، عَنْ مَعْنِ بْنِ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ : نُبِّئْت أَنَّ امْرَأَۃً فِی زَمَانِ عُثْمَانَ جَاء َتْ إلَی أَہْلِ بَیْتٍ ، فَقَالَتْ : قَدْ أَرْضَعْتُکُمْ فَفَرَّقَ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 16688","","","كتاب النكاح"
"16689","(۱۶۶۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : کَانَتِ الْقُضَاۃُ یُفَرِّقُونَ بَیْنَ الرَّجُلِ وَامْرَأَتِہِ بِشَہَادَۃِ الْمَرْأَۃِ فِی الرَّضَاعِ۔","","Musannaf Ibn Abi Shaybah 16689","","","كتاب النكاح"
"16690","(۱۶۶۹۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ قَالَ: شَہَادَۃُ الْمَرْأَۃِ الْعَاقِلَۃِ تَجُوزُ فِی الرَّضَاعَۃِ۔","","Musannaf Ibn Abi Shaybah 16690","","","كتاب النكاح"
"16691","(۱۶۶۹۱) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ طَلْحَۃَ ، عَنْ خَیْثَمَۃَ قَالَ : زَوَّجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً مِنَ الْمُسْلِمِینَ لَمْ یَکُنْ لَہُ شَیْئٌ فَأَمَرَ بِامْرَأَتِہِ أَنْ تَدْخُلَ عَلَیْہِ فَصَارَ ذَلِکَ الرَّجُلُ بَعْدُ مِنْ أَشْرَافِ الْمُسْلِمِینَ۔ (ابوداؤد ۲۱۲۱۔ ابن ماجہ ۱۹۹۲)","","Musannaf Ibn Abi Shaybah 16691","","","كتاب النكاح"
"16692","(۱۶۶۹۲) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ أَبِی مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الرُّکَیْنِ ، عَنْ أَبِیہِ قَالَ : تَزَوَّجَ فُلاَنُ بْنُ ہَرِمٍ لَیْلَی بِنْتَ الْعَجْمَائِ فِی زَمَنِ عُمَرَ فَدَخَلَ بِہَا وَلَمْ یُعْطِہَا شَیْئًا مِنْ صَدَاقِہَا۔","","Musannaf Ibn Abi Shaybah 16692","","","كتاب النكاح"
"16693","(۱۶۶۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ کُرَیْبِ بْنِ ہِشَامٍ ، وَکَانَ مِنْ أَصْحَابِ عَبْدِ اللہِ أَنَّہُ زَوَّجَ امْرَأَۃً عَلَی أَرْبَعَۃِ آلاَفٍ ثُمَّ دَخَلَ بِہَا قَبْلَ أَنْ یُعْطِیَہَا شَیْئًا مِنْ صَدَاقِہَا۔","","Musannaf Ibn Abi Shaybah 16693","","","كتاب النكاح"
"16694","(۱۶۶۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : اخْتَلَفَ فِیہِ أَہْلُ الْمَدِینَۃِ فَمِنْہُمْ مَنْ کَرِہَہُ وَمِنْہُمْ مَنْ رَخَّصَ فِیہِ وَأَیُّ ذَلِکَ فُعِلَ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 16694","","","كتاب النكاح"
"16695","(۱۶۶۹۵) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : إذَا کَانَتْ بِہِ رَاضِیَۃٌ لَمْ نَرَ بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 16695","","","كتاب النكاح"
"16696","(۱۶۶۹۶) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16696","","","كتاب النكاح"
"16697","(۱۶۶۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ الْمُبَارَکِ ، عَنْ یَحْیَی ، عَنْ عِکْرِمَۃَ ؛ أَنَّ عَلِیًّا لَمَّا أَرَادَ أَنْ یَبْنِیَ بِفَاطِمَۃَ قَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قدِّمْ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 16697","","","كتاب النكاح"
"16698","(۱۶۶۹۸) حَدَّثَنَا ہُشَیْمُ ، عَنْ أَبِی حَمْزَۃَ قَالَ : شَہِدْت ابْنَ عَبَّاسٍ وَسَأَلَہُ رَجُلٌ أَنَّہُ تَزَوَّجَ امْرَأَۃً فَعَسِرَ ، عَنْ صَدَاقِہَا ، فَقَالَ لَہُ ابْنُ عَبَّاسٍ : إن لَمْ تَجِدْ إلاَّ نَعْلَک فَأَعْطِہَا إیَّاہَا ثُمَّ ادْخُلْ بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 16698","","","كتاب النكاح"
"16699","(۱۶۶۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خُصَیْفٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : یُعْطِیہَا وَلَوْ خِمَارًا۔","","Musannaf Ibn Abi Shaybah 16699","","","كتاب النكاح"
"16700","(۱۶۷۰۰) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : کَانَ یَقُولُ : یُلْقِی عَلَیْہَا وَلَوْ ثَوْبًا ثُمَّ یَدْخُلُ بِہَا۔","","Musannaf Ibn Abi Shaybah 16700","","","كتاب النكاح"
"16701","(۱۶۷۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ وَعَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ أَنَّہُمَا کَرِہَا أَنْ یَدْخُلَ بِہَا وَلَمْ یُعْطِہَا مِنْ صَدَاقِہَا شَیْئًا۔","","Musannaf Ibn Abi Shaybah 16701","","","كتاب النكاح"
"16702","(۱۶۷۰۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ قَالَ : سُئِلَ الزُّہْرِیُّ ، عَنْ رَجُلٍ تَزَوَّجَ امْرَأَۃً وَہُوَ مَلِیئٌ بِصَدَاقِہَا أَیَدْخُلُ بِہَا وَلَمْ یُعْطِہَا شَیْئًا ؟ قَالَ : مَضَتِ السُّنَّۃُ أَنْ لاَ یَدْخُلَ بِہَا حَتَّی یُعْطِیَہَا ولو شَیْئًا۔","","Musannaf Ibn Abi Shaybah 16702","","","كتاب النكاح"
"16703","(۱۶۷۰۳) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ قَالَ : یُہْدِی شَیْئًا۔","","Musannaf Ibn Abi Shaybah 16703","","","كتاب النكاح"
"16704","(۱۶۷۰۴) حَدَّثَنَا شبابۃ قَالَ : حدَّثَنَا ہِشَام بْنِ الغَاز ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ یَحِلُّ لِمُسْلِمٍ أَنْ یَدْخُلَ عَلَی امْرَأَۃٍ حَتَّی یَقْدُمَ إلیہا ما قَلَّ ، أَوْ کَثُرَ۔","Sahih","Musannaf Ibn Abi Shaybah 16704","","","كتاب النكاح"
"16705","(۱۶۷۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِعَلِیٍّ : أَعْطِہَا دِرْعَک الْحُطَمِیَّۃَ۔ (عبدالرزاق ۱۰۴۲۹۔ احمد ۱/۸۰)","","Musannaf Ibn Abi Shaybah 16705","","","كتاب النكاح"
"16706","(۱۶۷۰۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَزِیدَ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ إسْمَاعِیلَ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، عَنْ عُمَرَ ، قَالَ : لَہَا شَرْطُہَا ، قَالَ رَجُلٌ : إذًا یُطَلِّقْنَنَا ، فَقَالَ عُمَرُ : إنَّ مَقَاطِعَ الْحُقُوقِ عِنْدَ الشَّرْطِ۔","Sahih","Musannaf Ibn Abi Shaybah 16706","","","كتاب النكاح"
"16707","(۱۶۷۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ إسْمَاعِیلَ بْنِ عُبَیْدِ اللہِ ، عَنِ ابْنِ غَنْمٍ عن عمر ، قَالَ : لَہَا شَرْطُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16707","","","كتاب النكاح"
"16708","(۱۶۷۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی الْخَیْرِ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ أَحَقَّ الشَّرْط أَنْ یُوَفَّی بِہِ مَا اسْتَحْلَلْتُمْ بِہِ الْفُرُوجَ۔n(بخاری ۵۱۵۱۔ ابوداؤد ۲۱۳۲)","Sahih","Musannaf Ibn Abi Shaybah 16708","","","كتاب النكاح"
"16709","(۱۶۷۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ أَبِی عُبَیْدَۃَ أَنَّ مُعَاوِیَۃَ سَأَلَ عَنْہَا عَمْرَو بْنَ الْعَاصِ ، فَقَالَ : لَہَا شَرْطُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16709","","","كتاب النكاح"
"16710","(۱۶۷۱۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَمْرِو ، عَنْ أَبِی الشَّعْثَائِ ، قَالَ: إذَا شَرَطَ لَہَا دَارَہَا فَہُوَ بِمَا یَسْتَحِلُّ مِنْ فَرْجِہَا۔","","Musannaf Ibn Abi Shaybah 16710","","","كتاب النكاح"
"16711","(۱۶۷۱۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی حَیَّانَ قَالَ : حدَّثَنَا أَبُو الزِّنَادِ أَنَّ امْرَأَۃً خَاصَمَتْ زَوْجَہَا إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ قَدْ شَرَطَ لَہَا دَارَہَا حِینَ تَزَوَّجَہَا فَأَرَادَ أَنْ یُخْرِجَہَا مِنْہَا فَقَضَی عُمَرُ أَنَّ لَہَا دَارَہَا ، لاَ یُخْرِجُہَا مِنْہَا وَقَالَ : وَالَّذِی نَفْسُ عُمَرَ بِیَدِہِ لَوِ اسْتَحْلَلْت فَرْجَہَا بِزِنَۃِ أُحُدٍ ذَہَبًا لأَخَذَتُ مَا بِہِ لَہَا۔","","Musannaf Ibn Abi Shaybah 16711","","","كتاب النكاح"
"16712","(۱۶۷۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عَاصِمٍ ، عَنْ عِیسَی بْنِ حِطَّانَ ، عَنْ مُجَاہِدٍ ، وَسَعِیدِ بْنِ جُبَیْرٍ قَالاَ : یُخْرِجُہَا ، فَقَالَ یَحْیَی بْنُ الْجَزَّارِ : فَبِأَیِّ شَیْئٍ یَسْتَحِلُّ الْفَرْجَ فَبِأَیِّ کَذَا وَکَذَا فَرَجَعَا ؟۔","","Musannaf Ibn Abi Shaybah 16712","","","كتاب النكاح"
"16713","(۱۶۷۱۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْمِنْہَالِ ، عَنْ عَبَّادِ بْنِ عَبْدِ اللہِ ، عَنْ عَلِیٍّ بن أبی طالب فِی الَّتِی شُرِطَ لَہَا دَارُہَا قَالَ : شَرْطُ اللہِ قَبْلَ شَرْطِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 16713","","","كتاب النكاح"
"16714","(۱۶۷۱۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی ذُبَابٍ ، عَنْ مُسْلِمِ بْنِ یَسَارٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ وَیَشْتَرِطُ لَہَا دَارَہَا قَالَ : یُخْرِجُہَا إِنْ شَاء َ۔","","Musannaf Ibn Abi Shaybah 16714","","","كتاب النكاح"
"16715","(۱۶۷۱۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ شُرَیْحٍ أَنَّ امْرَأَۃً جَاء َتْ ، فَقَالَتْ : شَرَطَ لَہَا دَارَہَا ، فَقَالَ : شَرْطُ اللہِ قَبْلَ شَرْطِہَا۔","","Musannaf Ibn Abi Shaybah 16715","","","كتاب النكاح"
"16716","(۱۶۷۱۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالاَ : یُخْرِجُہَا إِنْ شَاء َ۔","","Musannaf Ibn Abi Shaybah 16716","","","كتاب النكاح"
"16717","(۱۶۷۱۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : یَذْہَبُ بِہَا حَیْثُ شَاء َ وَالشَّرْطُ بَاطِلٌ۔","","Musannaf Ibn Abi Shaybah 16717","","","كتاب النكاح"
"16718","(۱۶۷۱۸) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً وَشَرَطَ لَہَا دَارَہَا قَالَ : لاَ شَرْطَ لَہَا۔","","Musannaf Ibn Abi Shaybah 16718","","","كتاب النكاح"
"16719","(۱۶۷۱۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَبِیبِ بْنِ جَُرَیٍّ ، قَالَ : سَمِعْتُ طَاوُوسًا وَسُئِلَ عَنِ الرَّجُلِ یَخْطُبُ الْمَرْأَۃَ فَتَشْرُطُ عَلَیْہِ أَشْیَاء َ ، قَالَ : لَیْسَ الشَّرْطُ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 16719","","","كتاب النكاح"
"16720","(۱۶۷۲۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ أَنَّ رَجُلاً زَوَّجَ ابْنَتَہُ عَلَی أَلْفِ دِینَارٍ وَشَرَطَ لِنَفْسِہِ أَلْفَ دِینَارٍ فَقَضَی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ لِلْمَرْأَۃِ بِأَلْفَیْنِ دُونَ الأَبِ۔","","Musannaf Ibn Abi Shaybah 16720","","","كتاب النكاح"
"16721","(۱۶۷۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ قَالَ : إِنْ کَانَ ہُوَ الَّذِی یُنْکَحُ فَہُوَ لَہُ۔","","Musannaf Ibn Abi Shaybah 16721","","","كتاب النكاح"
"16722","(۱۶۷۲۲) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ مُثَنَّی ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عُرْوَۃَ وَسَعِیدٍ قَالاَ : أَیُّمَا امْرَأَۃٍ أُنْکِحَتْ عَلَی صَدَاقٍ ، أَوْ عِدَۃٍِ لأَہْلِہَا کَانَ قَبْلَ عِصْمَۃِ النِّکَاحِ فَہُوَ لَہَا ، وَمَا کَانَ مِنْ حِبَائٍِ لأَہْلِہَا فَہُوَ لَہُمْ۔","","Musannaf Ibn Abi Shaybah 16722","","","كتاب النكاح"
"16723","(۱۶۷۲۳) حَدَّثَنَا شَرِیکٌ، عَنْ أَبِی إِسحاق أَنَّ مَسْرُوقًا زَوَّجَ ابْنَتَہُ فَاشْتَرَطَ عَلَی زَوْجِہَا عَشَرَۃَ آلاَفٍ سِوَی الْمَہْرِ۔","","Musannaf Ibn Abi Shaybah 16723","","","كتاب النكاح"
"16724","(۱۶۷۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَمِعْتُ الزُّہْرِیَّ یَقُولُ : لِلْمَرْأَۃِ مَا اسْتُحِلَّ بِہِ فَرْجُہَا۔","","Musannaf Ibn Abi Shaybah 16724","","","كتاب النكاح"
"16725","(۱۶۷۲۵) ، عَنِ الضَّحَّاکِ بْنِ الْمَخْلَدِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : مَا اشْتَرَطَ من حِبَائٍِ لأَخِیہَا ، أَوْ أَبِیہَا فَہِی أَحَقُّ بِہِ إِنْ تَکَلَّمَتْ فِیہِ۔","","Musannaf Ibn Abi Shaybah 16725","","","كتاب النكاح"
"16726","(۱۶۷۲۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ رَافِعَ بْنَ خَدِیجٍ کَانَتْ تَحْتَہُ بِنْتُ مُحَمَّدِ بْنِ مَسْلَمَۃَ فَکَرِہَ مِنْ أَمْرِہَا إمَّا کِبَرًا ، أَوْ غَیْرَہُ فَأَرَادَ أَنْ یُطَلِّقَہَا ، فَقَالَتْ : لاَ تُطَلِّقْنِی وَاقْسِمْ لِی مَا شِئْت فَجَرَتِ السُّنَّۃُ بِذَلِکَ فَنَزَلَتْ : {وَإِنِ امْرَأَۃٌ خَافَتْ مِنْ بَعْلِہَا نُشُوزًا أَوْ إعْرَاضًا}۔(طبرانی ۳۰۹۔ حاکم ۳۰۸)","","Musannaf Ibn Abi Shaybah 16726","","","كتاب النكاح"
"16727","(۱۶۷۲۷) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ عن أبیہ ، عَنْ عَائِشَۃَ {وَإِنِ امْرَأَۃٌ خَافَتْ مِنْ بَعْلِہَا نُشُوزًا أَوْ إعْرَاضًا} الآیَۃَ قَالَتْ : نَزَلَتْ فِی الْمَرْأَۃِ تَکُونُ عِنْدَ الرَّجُلِ فَتَطُولُ صُحْبَتُہَا فَیُرِیدُ أَنْ یُطَلِّقَہَا فَتَقُولُ : لاَ تُطَلِّقْنِی وَأَمْسِکْنِی وَأَنْتَ فِی حِلٍّ مِنِّی فَنَزَلَتْ ہَذِہِ الآیَۃُ فِیہِمَا۔ (بخاری ۲۴۵۰۔ مسلم ۲۳۱۶)","Sahih","Musannaf Ibn Abi Shaybah 16727","","","كتاب النكاح"
"16728","(۱۶۷۲۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَرْبِ بْنِ شَدَّادٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ قَالَ : حدَّثَنَا أَبُو النَّجَاشِیِّ مَوْلَی رَافِعِ بْنِ خَدِیجٍ : أَنَّ رَافِعَ بْنِ خَدِیجٍ تَزَوَّجَ امْرَأَۃً عَلَی امْرَأَتِہِ ، فَقَالَ لاِمْرَأَتِہِ الأُولَی : إِنْ شِئْتِ أَنْ أُمْسِکَکِ وَلاَ أَقْسِمُ لَکَ ، وَإِنْ شِئْتِ طَلَّقْتُکِ ، فَاخْتَارَتْ أَنْ یُمْسِکَہَا وَلاَ یُطَلِّقَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16728","","","كتاب النكاح"
"16729","(۱۶۷۲۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَرْبِ بْنِ شَدَّادٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ بْنِ الْحَارِثِ أَنَّ بِنْتَ عَبْدِ اللہِ بْنِ جَعْفَرٍ کَانَتْ تَحْتَ رَجُلٍ مِنْ قُرَیْشٍ فَخَیَّرَہَا بَیْنَ أَنْ یُمْسِکَہَا وَلاَ یَقْسِمُ لَہَا وَبَیْنَ أَنْ یُطَلِّقَہَا فَاخْتَارَتْ أَنْ یُمْسِکَہَا وَلاَ یُطَلِّقَہَا۔","","Musannaf Ibn Abi Shaybah 16729","","","كتاب النكاح"
"16730","(۱۶۷۳۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثقفی ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ عبیدۃ قَالَ : سَأَلْتُہ ، عَنْ ہَذِہِ الآیَۃِ : {وَإِنِ امْرَأَۃ خَافَتْ مِنْ بَعْلِہَا نُشُوزًا أَوْ إعْرَاضًا} قَالَ : ہُوَ رَجُلٌ تَکُونُ لَہُ الْمَرْأَۃُ قَدْ خَلاَ مِنْ سَہْمِہَا فَیُصَالِحُہَا مِنْ حَقِّہَا عَلَی شَیْئٍ فَہُوَ لَہُ مَا رَضِیَتْ فَإِذَا کَرِہَتْ فَلَہُ أَنْ یَعْدِلَ عَلَیْہَا ، أَوْ یُرْضِیَہَا من حَقِّہَا ، أَوْ یُطَلِّقَہَا۔","","Musannaf Ibn Abi Shaybah 16730","","","كتاب النكاح"
"16731","(۱۶۷۳۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ خَالِدِ بْنِ عَرْعَرَۃَ ، عَنْ عَلِیٍّ قَالَ : أَتَاہُ رَجُلٌ یَسْتَفْتِیہِ فِی {امْرَأَۃ خَافَتْ مِنْ بَعْلِہَا نُشُوزًا أَوْ إعْرَاضًا} ، فَقَالَ : ہِیَ الْمَرْأَۃُ تَکُونُ عِنْدَ الرَّجُلِ فَتَنبو عَیْنَاہُ مِنْ دَمَامَتہَا ، أَوْ فَقْرِہَا ، أَوْ سُوئِ خُلُقِہَا فَتَکْرَہُ فِرَاقَہُ فَإِنْ وَضَعَتْ لَہُ مِنْ مہرہا شَیْئًا حَلَّتْ لَہُ ، وَإِنْ جَعَلَتْ مِنْ أَیَّامِہَا شَیْئًا فَلاَ حَرَجَ۔","Hasan","Musannaf Ibn Abi Shaybah 16731","","","كتاب النكاح"
"16732","(۱۶۷۳۲) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ أَنَّ سَوْدَۃَ لَمَّا أَسَنَّتْ وَہَبَتْ یَوْمَہَا لِعَائِشَۃَ حَتَّی لَقِیَتِ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 16732","","","كتاب النكاح"
"16733","(۱۶۷۳۳) حَدَّثَنَا عُقْبَۃُ بْنُ خَالِدٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 16733","","","كتاب النكاح"
"16734","(۱۶۷۳۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنِ أَبِی رَزِینٍ فِی قولہ تعالی : {تُرْجِی مَنْ تَشَائُ مِنْہُنَّ وَتُؤْوِی إلَیْک مَنْ تَشَائُ} فَکَانَ مِمَّنْ آوَی عَائِشَۃُ وَأُمُّ سَلَمَۃَ وَزَیْنَبُ وَحَفْصَۃُ ، فَکَانَ قسمتہن مِنْ نَفْسِہِ وَمَالِہِ فیہن سَوَائً ، وَکَانَ مِمَّنْ أَرْجَی سَوْدَۃُ وَجُوَیْرِیَۃُ وَأُمُّ حَبِیبَۃَ وَمَیْمُونَۃُ وَصْفِیَّۃُ ، فَکَانَ یَقْسِمُ لَہُنَّ مَا شَاء َ ، وَکَانَ أَرَادَ أَنْ یُفَارِقَہُنَّ فَقُلْنَ لَہُ : اقْسِمْ لَنَا مِنْ نَفْسِکَ مَا شِئْت وَدَعْنَا نَکُونُ عَلَی حَالِنَا۔ (ابن جریر ۲۵)","","Musannaf Ibn Abi Shaybah 16734","","","كتاب النكاح"
"16735","(۱۶۷۳۵) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ عَطَائِ بْنِ السَّائِبِ أَنَّ امْرَأَۃً مَلَکَتْ مِنْ زَوْجِہَا قِیمَۃَ سَبْعَۃ دَرَاہِمِ فَسُئِلَ مَیْسَرَۃُ ، عَنْ ذَلِکَ ، فَقَالَ : حرُمَتْ عَلَیْہِ وَلاَ أَدْرِی مِنْ أَیْنَ تَحِلُّ لَہُ ؟ فَلَقِیت الشَّعْبِیَّ فَسَأَلْتُہُ ، فَقَالَ : الْقَ أَبَا بَکْرِ بْنَ أَبِی مُوسَی فَاسْأَلْہُ وَہُوَ یَوْمَئِذٍ قَاضٍ فَأَتَیْتہ فَسَأَلْتُہُ ، فَقَالَ : إذَا لَمْ تَسْتَطِعْ شَیْئًا فَدَعْہُ إلَی مَا تَسْتَطِیعُ فَأَتَیْت الشَّعْبِیَّ فَذَکَرْت ذَلِکَ لَہُ فَضَحِکَ وَقَالَ : اذْہَبْ إلَی عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ فَأَتَیْتہ فَسَأَلْتُہُ ، فَقَالَ ، حَرُمَتْ عَلَیْہِ ، فَقُلْتُ ، مِنْ أَیْنَ تَحِلُّ لَہُ ؟ فقَالَ : تَہَبُ ، أَوْ تُعْتِقُ ، أَوْ تَبِیعُ فَرَجَعْت إلَی الشَّعْبِیِّ فَسَأَلْتُہُ ، فَقَالَ : ارْجِعْ إلَیْہِ فَاسْأَلْہُ أَتَعْتَدُّ مِنْہُ ؟ فَأَتَیْتہ ، فَقَالَ : لاَ ، إنَّمَا ہُوَ مَاؤُہُ فَرَجَعْت إلَی الشَّعْبِیِّ فَأَخْبَرْتہ ، فَقَالَ : طَابَقَ الْفَتْوَی فَأَتَیْت ابْنَ مَعقِلٍ فَسَأَلْتُہُ ، فَقَالَ عَبْدُ السَّلاَمِ : فَلَمْ أَحْفَظْ مَا قَالَ فَأَخْبَرَنِی عَمَّارُ بْنُ رُزَیْقٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ ابْنِ مَعْقِلٍ قَالَ : یَسْتَقْبِلاَنِ لِلنِّکَاحِ۔","","Musannaf Ibn Abi Shaybah 16735","","","كتاب النكاح"
"16736","(۱۶۷۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ قَالَ سَأَلْتُ مَیْسَرَۃَ ، عَنِ امْرَأَۃٍ وَرِثَتْ مِنْ زَوْجِہَا شَیْئًا قَالَ : حَرُمَتْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16736","","","كتاب النكاح"
"16737","(۱۶۷۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی امْرَأَۃٍ مَلَکَتْ مِنْ زَوْجِہَا شَیْئًا فقَالَ : حرُمَتْ عَلَیْہِ إلاَّ أَنْ تُعْتِقَہُ سَاعَۃَ تَمْلِکُہُ۔","","Musannaf Ibn Abi Shaybah 16737","","","كتاب النكاح"
"16738","(۱۶۷۳۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ أَنَّ عُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ بْنِ عُتْبَۃَ قَالَہُ۔","","Musannaf Ibn Abi Shaybah 16738","","","كتاب النكاح"
"16739","(۱۶۷۳۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ أَنَّہُ قَالَ : حَرُمَتْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16739","","","كتاب النكاح"
"16740","(۱۶۷۴۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یونس ، عَنِ الْحَسَنِ قَالَ : قد حرُمَتْ عَلَیْہِ فَلْیَسْتَأْنِفْ نِکَاحَہَا إِنْ أَرَادَہَا۔","","Musannaf Ibn Abi Shaybah 16740","","","كتاب النكاح"
"16741","(۱۶۷۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ قَالَ : وَقَالَ ذَلِکَ الشَّعْبِیُّ۔","","Musannaf Ibn Abi Shaybah 16741","","","كتاب النكاح"
"16742","(۱۶۷۴۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ طَاوُوسٍ أَنَّہُ سُئِلَ عَنِ امْرَأَۃٍ وَقَعَ لَہَا فِی زَوْجِہَا شِرْکٌ فَأَعْتَقَتْہُ سَاعَۃَ مَلَکَتْہُ ، فَقَالَ : لَوْ کَانَ قَدر ذُبَابٍ فَرِّقَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 16742","","","كتاب النكاح"
"16743","(۱۶۷۴۳) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ : حرُمَتْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16743","","","كتاب النكاح"
"16744","(۱۶۷۴۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنِ الْمَرْأَۃِ تَرِثُ مِنْ زَوْجِہَا سَہْمًا قَالاَ : حرُمَتْ عَلَیْہِ ، وَإِنْ تَزَوَّجَہَا فَإِنَّہَا عِنْدَہُ عَلَی ثَلاَثِ تَطْلِیقَاتٍ۔","","Musannaf Ibn Abi Shaybah 16744","","","كتاب النكاح"
"16745","(۱۶۷۴۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ إِنْ أُعْتِقَ بعد تَزَوَّجَہَا فَإِنَّہَا عِنْدَہُ عَلَی ثَلاَثِ تَطْلِیقَاتٍ لَمْ تَکُنْ فرقتہما طَلاَقًا۔","","Musannaf Ibn Abi Shaybah 16745","","","كتاب النكاح"
"16746","(۱۶۷۴۶) حَدَّثَنَا إِسْحَاقَ بْنِ مَنْصُورٍ، عَنْ شَرِیکٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ مَیْسَرَۃَ، عَنْ عَلِیٍّ قَالَ: حرُمَتْ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 16746","","","كتاب النكاح"
"16747","(۱۶۷۴۷) حَدَّثَنَا الثَّقَفِیُّ، عَنْ خَالِدٍ، عَنْ مُحَمَّدٍ فِی الْمَرْأَۃِ تَمْلِکُ زَوْجَہَا قَالَ: إِنْ أَعْتَقَتْہُ مَکَانَہَا فَہُمَا عَلَی نِکَاحِہِمَا۔","","Musannaf Ibn Abi Shaybah 16747","","","كتاب النكاح"
"16748","(۱۶۷۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا کَانَ لِلْمَمْلُوکِ امْرَأَۃٌ حرۃ فَمَاتَ مَوْلَی الْمَمْلُوکِ فَوَرِثَتِ امْرَأَتُہُ نَصِیبًا مِنْہُ فَإِنْ أَعْتَقَتْہُ مَکَانَہَا فَہُمَا عَلَی نِکَاحِہِمَا الأَوَّلِ ، وَإِنْ لَمْ تُعْتِقْہُ حَرُمَتْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 16748","","","كتاب النكاح"
"16749","(۱۶۷۴۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ خَالِدِ بْنِ کَثِیرٍ ، عَنِ الضَّحَّاکِ ، عَنْ عَلِیٍّ قَالَ : یُؤَجَّلُ سَنَۃً فَإِنْ وَصَلَ ، وَإِلاَّ فُرِّقَ بَیْنَہُمَا فَالْتَمَسَا مِنْ فَضْلِ اللہِ یَعْنِی الْعِنِّینَ۔","","Musannaf Ibn Abi Shaybah 16749","","","كتاب النكاح"
"16750","(۱۶۷۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الرُّکَیْنِ ، عَنْ أَبِیہِ وَحُصَیْنُ بْنُ قَبِیصَۃَ ، عَنْ عَبْدِ اللہِ أَنَّہُ قَالَ : یُؤَجَّلُ الْعِنِّینُ سَنَۃً فَإِنْ جَامَعَ ، وَإِلاَّ فُرِّقَ بَیْنَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 16750","","","كتاب النكاح"
"16751","(۱۶۷۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الرُّکَیْنِ ، عَنْ أَبِی حَنْظَلَۃَ النعمان ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ أَنَّہُ أَجَّلَ الْعِنِّینَ سَنَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 16751","","","كتاب النكاح"
"16752","(۱۶۷۵۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، عَنْ عُمَرَ ، قَالَ : یُؤَجَّلُ الْعِنِّینُ سَنَۃً ، فَإِنْ وَصَلَ إلَیْہَا ، وَإِلاَّ فُرِّقَ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 16752","","","كتاب النكاح"
"16753","(۱۶۷۵۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَتَبَ إلَی شُرَیْحٍ أَنْ یُؤَجِّلَ الْعِنِّینِ سَنَۃً مِنْ یَوْمِ یُرْفَعُ إلیہ۔","Da'if","Musannaf Ibn Abi Shaybah 16753","","","كتاب النكاح"
"16754","(۱۶۷۵۴) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْمُغِیرَۃِ ، عَنِ الشَّعْبِیِّ أَنَّ الْحَارِثَ بْنَ عَبْدِ اللہِ بْنِ أَبِی رَبِیعَۃَ أَجَّلَ رَجُلاً عَشَرَۃَ أَشْہُرٍ لَمْ یَصِلْ إلَی أَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 16754","","","كتاب النكاح"
"16755","(۱۶۷۵۵) حَدَّثَنَا جَرِیرٌ عَنْ مَنْصُورٍ عَنْ إبْرَاہِیمَ قَالَ: إذَا لَمْ یَصِلَ الرَّجُلُ إلَی امْرَأَتِہِ أُجِّلَ سَنَۃً أَو عَشَرَۃَ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 16755","","","كتاب النكاح"
"16756","(۱۶۷۵۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ وَعَنْ الْمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالاَ : یُؤَجَّلُ الْعِنِّینُ مِنْ یَوْمِ یُرْفَعُ إلَی السُّلْطَانِ قَالَ یُونُسُ ، عَنِ الْحَسَنِ : یُؤَجَّلُ سَنَۃً وَقَالَ مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ : لاَ أَحْفَظُ الْوَقْتَ وَلَکِنَّہُ یُؤَجَّلُ مِنْ یَوْمِ یُرْفَعُ إلَی السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 16756","","","كتاب النكاح"
"16757","(۱۶۷۵۷) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ الشعبی أَنَّہُ کَانَ یَقُولُ بِقَوْلِ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یُؤَجَّلُ الْعِنِّینُ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 16757","","","كتاب النكاح"
"16758","(۱۶۷۵۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ قَالَ : یُؤَجَّلُ الْعِنِّینُ سَنَۃً فَإِنْ وَصَلَ إلَیْہَا ، وَإِلاَّ فُرِّقَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 16758","","","كتاب النكاح"
"16759","(۱۶۷۵۹) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : یَسْتَقْبِلُ بِہَا مِنْ یَوْمِ تُخَاصِمُہُ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 16759","","","كتاب النكاح"
"16760","(۱۶۷۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنِ سعید بْنِ الْمُسَیَّبِ قَالَ : یُؤَجَّلُ الْعِنِّینُ وَالَّذِی یُؤْخَذُ ، عَنِ امْرَأَتِہِ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 16760","","","كتاب النكاح"
"16761","(۱۶۷۶۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ قَالَ : یُؤَجَّلُ الْعِنِّینُ سَنَۃً فَإِنْ وَصَلَ إلَیْہَا ، وَإِلاَّ فُرِّقَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 16761","","","كتاب النكاح"
"16762","(۱۶۷۶۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ بَعْضِ أَشْیَاخِہِمْ أَنَّ أَبَا حَلِیمَۃَ مُعَاذًا الْقَارِیَّ تَزَوَّجَ ابْنَۃَ حارثۃ بْنِ النُّعْمَانِ الأَنْصَارِیِّ فَلَمْ یَصِلْ إلَیْہَا فَأَجَّلَہُ عُمَرُ سَنَۃً ، قَالَ یَحْیَی : فَأَخْبَرَنِی عَبْدُ الرَّحْمَنِ الأَنْصَارِیُّ أَنَّہُ حَیْثُ حَالَ عَلَیْہِ الْحَوْلُ فُرِّقَ بَیْنَہُمَا وَقَالَ : الْحَمْدُ لِلَّہِ الَّذِی کَفَّ عَلَی حارثۃ ابْنَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 16762","","","كتاب النكاح"
"16763","(۱۶۷۶۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، عَنْ عُمَرَ، أَنَّہُ أَجَّلَ الْعِنِّینَ سَنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 16763","","","كتاب النكاح"
"16764","(۱۶۷۶۴) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَانَ یَقُولُ : یُؤَجَّلُ سَنَۃً لاَ أَعْلَمُہُ إلاَّ مِنْ یَوْمِ یُرْفَعُ إلَی السُّلْطَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 16764","","","كتاب النكاح"
"16765","(۱۶۷۶۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ نُسَِیرٍ قَالَ : کُنْتُ عِنْدَ عَبْدِ الْمَلِکِ بْنِ مَرْوَانَ فَأُتِیَ بِعِنِّینٍ فَإِذَا إنْسَانٌ ضَرِیرٌ فَأَجَّلَہُ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 16765","","","كتاب النكاح"
"16766","(۱۶۷۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ شِمْر ، عَنِ الشَّعْبِیِّ قَالَ : یُؤَجَّلُ الْعِنِّینُ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 16766","","","كتاب النكاح"
"16767","(۱۶۷۶۷) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ وَعُبَیدَۃَ ، عَنْ إبْرَاہِیمَ قَالاَ : تُخَیَّرُ فِی رَأْسِ الْحَوْلِ فَإِنْ شَائَتْ أَقَامَتْ ، وَإِنْ شَائَتْ فَارَقَتْہُ۔","","Musannaf Ibn Abi Shaybah 16767","","","كتاب النكاح"
"16768","(۱۶۷۶۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ قَالَ : کَتَبَ إلَیَّ عُمَرُ أَنْ أَجِّلْہُ سَنَۃً فَإِنَ اسْتَطَاعَہَا ، وَإِلاَّ خَیِّرْہَا فَإِنْ شَائَتْ أَقَامَتْ ، وَإِنْ شَائَتْ فَارَقَتْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 16768","","","كتاب النكاح"
"16769","(۱۶۷۶۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : یُؤَجَّلُ الْعِنِّینُ أَجَلاً فَإِنْ وَصَلَ ، وَإِلاَّ خُیِّرَتْ فَإِنَ اخْتَارَتْہُ فَلَیْسَ لَہَا خِیَارٌ بَعْدَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16769","","","كتاب النكاح"
"16770","(۱۶۷۷۰) حَدَّثَنَا یَزِیدَ بْنِ ہَارُونَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ ، أَنَّہُ أَجَّلَ الْعِنِّینَ سَنَۃً فَإِنْ أَتَاہَا ، وَإِلاَّ فُرِّقَ بَیْنَہُمَا وَلَہَا الصَّدَاقُ کَامِلاً۔","Sahih","Musannaf Ibn Abi Shaybah 16770","","","كتاب النكاح"
"16771","(۱۶۷۷۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ أَنَّہُ کَانَ یَقُولُ فِی الْعِنِّینِ إذَا لَمْ یَصِلْ إلَی امْرَأَتِہِ : إنَّ عَلَیْہِ نِصْفَ صَدَاقٍ۔","","Musannaf Ibn Abi Shaybah 16771","","","كتاب النكاح"
"16772","(۱۶۷۷۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : عَلَیْہِ الصَّدَاقَ۔","","Musannaf Ibn Abi Shaybah 16772","","","كتاب النكاح"
"16773","(۱۶۷۷۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : لَہَا الْمَہْرُ۔","","Musannaf Ibn Abi Shaybah 16773","","","كتاب النكاح"
"16774","(۱۶۷۷۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ قَالاَ : أَجَّلَہُ عُمَرُ سَنَۃً فَإِنْ وَصَلَ ، وَإِلاَّ فُرِّقَ بَیْنَہُمَا وَلَہَا الصَّدَاقُ۔","Da'if","Musannaf Ibn Abi Shaybah 16774","","","كتاب النكاح"
"16775","(۱۶۷۷۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لَہَا الصَّدَاقُ۔","","Musannaf Ibn Abi Shaybah 16775","","","كتاب النكاح"
"16776","(۱۶۷۷۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ قَالَ : لَہَا الصَّدَاقُ۔","","Musannaf Ibn Abi Shaybah 16776","","","كتاب النكاح"
"16777","(۱۶۷۷۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ قَالَ : لَہَا نِصْفُ صَدَاقٍ۔","","Musannaf Ibn Abi Shaybah 16777","","","كتاب النكاح"
"16778","(۱۶۷۷۸) حَدَّثَنَا عبد اللہ بْنِ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ إذَا وَصَلَ إلَیْہَا مَرَّۃً لَمْ یُفَرَّقْ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 16778","","","كتاب النكاح"
"16779","(۱۶۷۷۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : إذَا قَدَرَ عَلَیْہَا مَرَّۃً فَہِیَ امْرَأَتُہُ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 16779","","","كتاب النكاح"
"16780","(۱۶۷۸۰) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : إذَا أَصَابَہَا مَرَّۃً فَلاَ کَلاَمَ لَہَا وَلاَ خُصُومَۃَ۔","","Musannaf Ibn Abi Shaybah 16780","","","كتاب النكاح"
"16781","(۱۶۷۸۱) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ قَالَ : مَا زِلْنَا نَسْمَعُ أَنَّہُ إذَا أَصَابَہَا مَرَّۃً فَلاَ کَلاَمَ لَہَا وَلاَ خُصُومَۃَ۔","","Musannaf Ibn Abi Shaybah 16781","","","كتاب النكاح"
"16782","(۱۶۷۸۲) حَدَّثَنَا عُمَرُ، عَنِ ابْنِ جُرَیْجٍ، عَنِ ابْنِ طَاوُوسٍ، عَنْ أَبِیہِ قَالَ: إذَا أَصَابَہَا مَرَّۃً فَلاَ کَلاَمَ لَہَا وَلاَ خُصُومَۃَ۔","","Musannaf Ibn Abi Shaybah 16782","","","كتاب النكاح"
"16783","(۱۶۷۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ وَأَبِی ہَاشِمٍ قَالاَ : إِنْ تَزَوَّجَہَا ثُمَّ وَطِئَہَا مَرَّۃً ثُمَّ لَمْ یَسْتَطِعْ أَنْ یَغْشَاہَا ، فَإِنَّہُ لاَ خِیَارَ لَہَا بَعْدَ تِلْکَ الْمَرَّۃِ۔","","Musannaf Ibn Abi Shaybah 16783","","","كتاب النكاح"
"16784","(۱۶۷۸۴) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا وَطِئَہَا مَرَّۃً فَلَیْسَ لَہَا خِیَارٌ۔","","Musannaf Ibn Abi Shaybah 16784","","","كتاب النكاح"
"16785","(۱۶۷۸۵) حَدَّثَنَا حَکَّام الرَّازِیّ، عَنْ خَلِیلِ بْنِ زُرَارَۃَ، عَنْ مُطَرِّفٍ، عَنِ الشَّعْبِیِّ قَالَ: مَنْ زَوَّجَ فَاسِقًا فَقَدْ قَطَعَ رَحِمَہُ۔","","Musannaf Ibn Abi Shaybah 16785","","","كتاب النكاح"
"16786","(۱۶۷۸۶) حَدَّثَنَا ابْنُ مُبَارَکٍ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنِ ابْنِ الْمُسَیَّبِ وَسُلَیْمَان بْنِ یَسَارٍ ، وَالْحَسَنِ ، وَعِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ خِیَارَ لَہَا عَلَی الْحُرِّ۔","","Musannaf Ibn Abi Shaybah 16786","","","كتاب النكاح"
"16787","(۱۶۷۸۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : قُلْتُ لَہُ : لَہَا خِیَارٌ عَلَی الْحُرِّ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 16787","","","كتاب النكاح"
"16788","(۱۶۷۸۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ قَالَ : لَیْسَ لَہَا خِیَارٌ مِنَ الْحُرِّ وَلَہَا خِیَارٌ مِنَ الْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 16788","","","كتاب النكاح"
"16789","(۱۶۷۸۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : لاَ خِیَارَ لِلأَمَۃِ إذَا أُعْتِقَتْ وَزَوْجُہَا حُرٌّ۔","","Musannaf Ibn Abi Shaybah 16789","","","كتاب النكاح"
"16790","(۱۶۷۹۰) حَدَّثَنَا عبد اللہ بْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ أَنَّ صَفِیَّۃَ بِنْتَ أَبِی عُبَیْدٍ کَانَ لَہَا عَبْدٌ فَزَوَّجَتْہُ جَارِیَۃً لہا بِکْرًا فَکَانَتْ تَکْرَہُ زَوْجَہَا وَکَانَتْ تُرِیدُ عِتْقَہَا فَخَافَت أَنْ تُعْتِقَ الْوَلِیدَۃَ فَتُفَارِقَ زَوْجَہَا فَأَعْتَقَتِ الْعَبْدَ حَتَّی إذَا أُثْبِتَ الْعَتِیقُ أَعْتَقَتِ الْوَلِیدَۃَ بَعْدَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16790","","","كتاب النكاح"
"16791","(۱۶۷۹۱) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ أَنَّہَا اشْتَرَتْ بَرِیرَۃَ فَأَعْتَقَتْہَا فَخَیَّرَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَ لَہَا زَوْجٌ حُرٌّ۔ (بخاری ۶۷۵۱۔ ابوداؤد ۲۲۲۸)","Sahih","Musannaf Ibn Abi Shaybah 16791","","","كتاب النكاح"
"16792","(۱۶۷۹۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ قَالَ : تُخَیَّرُ ، وَإِنْ کَانَتْ تَحْتَ رَجُلٍ مِنْ قُرَیْشٍ۔","","Musannaf Ibn Abi Shaybah 16792","","","كتاب النكاح"
"16793","(۱۶۷۹۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : لَہَا الْخِیَارُ حُرًّا کَانَ زَوْجُہَا ، أَوْ عَبْدًا۔","","Musannaf Ibn Abi Shaybah 16793","","","كتاب النكاح"
"16794","(۱۶۷۹۴) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : تُخَیَّرُ حُرًّا کَانَ زَوْجُہَا ، أَوْ عَبْدًا۔","","Musannaf Ibn Abi Shaybah 16794","","","كتاب النكاح"
"16795","(۱۶۷۹۵) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَرْبِ بْنِ أَبِی الْعَالِیَۃِ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ قَالَ : لَہَا الْخِیَارُ ، وَإِنْ کَانَتْ تَحْتَ أَمِیرِ الْمُؤْمِنِینَ۔","","Musannaf Ibn Abi Shaybah 16795","","","كتاب النكاح"
"16796","(۱۶۷۹۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ وَعَنِ ابْنِ جُرَیْجٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنْ طَاوُوسٍ قَالَ : لَہَا الْخِیَارُ عَلَی الْحُرِّ وَالْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 16796","","","كتاب النكاح"
"16797","(۱۶۷۹۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ فِی الْمَمْلُوکَۃِ تَکُونُ تَحْتَ الْعَبْدِ فَتُعْتَقُ قَالَ : لَہَا الْخِیَارُ مَا لَمْ یَمَسَّہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16797","","","كتاب النكاح"
"16798","(۱۶۷۹۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَنْظَلَۃَ قَالَ سَمِعْت طَاوُوسًا وَسُئِلَ عَنِ الأَمَۃِ تُعْتَقُ وَلَہَا زَوْجٌ حُرٌّ تُخَیَّرُ ؟ فَقَالَ : لاَ عِلْمَ لِی ، وَلَکِنَّہَا إذَا کَانَتْ تَحْتَ عَبْدٍ خُیِّرَتْ۔","","Musannaf Ibn Abi Shaybah 16798","","","كتاب النكاح"
"16799","(۱۶۷۹۹) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : تُخَیَّرُ حُرًّا کَانَ زَوْجُہَا ، أَوْ عَبْدًا۔","","Musannaf Ibn Abi Shaybah 16799","","","كتاب النكاح"
"16800","(۱۶۸۰۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ خَالِدٍ، عَنْ أَبِی قِلاَبَۃَ، عَنْ عُمَرَ، قَالَ: إذَا أُعْتِقَتِ الأَمَۃُ فَلَہَا الْخِیَارُ مَا لَمْ یَطَأْہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 16800","","","كتاب النكاح"
"16801","(۱۶۸۰۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : إذَا قَرَبَہَا فَلاَ خِیَارَ لَہَا قَدْ أَقَرَّتْ۔","Sahih","Musannaf Ibn Abi Shaybah 16801","","","كتاب النكاح"
"16802","(۱۶۸۰۲) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّ حَفْصَۃَ زَوْجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْتَقَتْ جَارِیَۃً لَہَا ، فَقَالَتْ : إِنْ وَطِئَک زَوْجُک فَلاَ خِیَارَ لَک۔","","Musannaf Ibn Abi Shaybah 16802","","","كتاب النكاح"
"16803","(۱۶۸۰۳) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ قَالَ : إذَا غَشِیَہَا زَوْجُہَا فَلاَ خِیَارَ لَہَا۔","","Musannaf Ibn Abi Shaybah 16803","","","كتاب النكاح"
"16804","(۱۶۸۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، وَنَافِعٍ قَالاَ : لَہَا الْخِیَارُ مَا لَمْ یَغْشَہَا۔","","Musannaf Ibn Abi Shaybah 16804","","","كتاب النكاح"
"16805","(۱۶۸۰۵) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا أُعْتِقَتِ الأَمَۃُ فَلَہَا الْخِیَارُ مَا لَمْ یَطَأْہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 16805","","","كتاب النكاح"
"16806","(۱۶۸۰۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَمَّادٍ قَالَ : إذَا أُعْتِقَتِ الأَمَۃُ ثُمَّ وَطِئَہَا وَہِیَ لاَ تَعْلَمُ أَنَّ لَہَا الْخِیَارَ فَلَہَا الْخِیَارُ قَالَ : وَبَلَغَنِی ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16806","","","كتاب النكاح"
"16807","(۱۶۸۰۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ قَالَ : بَلَغَنِی ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّہُ قَالَ : لَہَا الْخِیَارُ وَقَالَ : لَوْ کَانَ لِی عَلَیْہِ سُلْطَانٌ لَضَرَبْتہ۔","","Musannaf Ibn Abi Shaybah 16807","","","كتاب النكاح"
"16808","(۱۶۸۰۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ فِیمَا قُرِیئَ عَلَیْہِ قَالَ : وَقَالَ ابْنُ عُمَرَ : إِنْ أَصَابَہَا وَلاَ تَعْلَمُ فَلَہَا الْخِیَارُ إذَا عَلِمَتْ وَلَوْ أَصَابَہَا مِنْہَا مِئَۃَ مَرَّۃٍ۔","","Musannaf Ibn Abi Shaybah 16808","","","كتاب النكاح"
"16809","(۱۶۸۰۹) حَدَّثَنَا ابْنِ الْمُبَارَکِ ، عَنِ ابْنِ جُرَیْجٍ قَالَ : قُلْتُ لِعَطَائٍ ، إذَا أُعْتِقَتِ الأَمَۃُ فَأَصَابَہَا مُبَادِرًا قَالَ : بِئْسَ مَا صَنَعَ ، قَالَ : قُلْتُ : لَہَا خِیَارٌ عَلَی الْحُرِّ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 16809","","","كتاب النكاح"
"16810","(۱۶۸۱۰) حَدَّثَنَا وَکِیعٌ، عَنْ شعبۃ، عَنِ الْحَکَمِ قَالَ: إذَا وَطِئَہَا وَہِیَ لاَ تَعْلَمُ أَنَّ لَہَا الْخِیَارَ فَلَہَا الْخِیَارُ إذَا عَلِمَتْ۔","","Musannaf Ibn Abi Shaybah 16810","","","كتاب النكاح"
"16811","(۱۶۸۱۱) حَدَّثَنَا حَفْصٌ ، عَنْ بَعْضِ أَصْحَابِ حَمَّادٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا وَقَعَ عَلَیْہَا وَلَمْ تَعْلَمْ أَنَّ لَہَا الْخِیَارَ فَلَہَا الْخِیَارُ إذَا عَلِمَتْ۔","","Musannaf Ibn Abi Shaybah 16811","","","كتاب النكاح"
"16812","(۱۶۸۱۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ جُوَِیبرٍ ، عَنِ الضَّحَّاکِ قَالَ إذَا وَطِئَہَا وَہِیَ تَعْلَمُ أَنَّ لَہَا الْخِیَارَ فَذَاکَ مِنْہَا رِضًا۔","","Musannaf Ibn Abi Shaybah 16812","","","كتاب النكاح"
"16813","(۱۶۸۱۳) حَدَّثَنَا حَفْصٌ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ قَالَ: إذَا وَقَعَ عَلَیْہَا زَوْجُہَا وَقَدْ عَلِمَتْ أَنَّ لَہَا الْخِیَارَ فَلاَ خِیَارَ لَہَا۔","","Musannaf Ibn Abi Shaybah 16813","","","كتاب النكاح"
"16814","(۱۶۸۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : إذَا غَشِیَہَا قَبْلَ أَنْ تَخْتَارَ اُسْتُحْلِفَت أَنَّہَا لَمْ تَعْلَمْ أَنَّ لَہَا الْخِیَارَ ثُمَّ خُیِّرَتْ إذَا کَانَتْ تَحْتَ عَبْدٍ۔","","Musannaf Ibn Abi Shaybah 16814","","","كتاب النكاح"
"16815","(۱۶۸۱۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، عَنْ رَجُلٍ کَانَتْ عِنْدَہُ امْرَأَۃٌ فَأُعْتِقَتْ فَغَشِیَہَا بَعْدَ الْعِتْقِ ، فَقَالَتْ : لَمْ أَشْعُرْ أَنَّ لِی خِیَارًا ، قَالَ : تُسْتَحْلَفُ أَنَّہَا لَمْ تَعْلَمْ أَنَّ لَہَا الْخِیَارَ ثُمَّ تُخَیَّرُ وَسَأَلْت حَمَّادًا، فَقَالَ : ہِیَ امْرَأَتُہُ وَلاَ تُخَیَّرُ۔","","Musannaf Ibn Abi Shaybah 16815","","","كتاب النكاح"
"16816","(۱۶۸۱۶) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ قَالَ: أَخْبَرَنِی الْہَیْثَمُ ، عَنْ حَمَّادٍ أَنَّہُ قَالَ: تُسْتَحْلَفُ أَنَّہَا لَمْ تَعْلَمْ أَنَّ لَہَا الْخِیَارَ۔","","Musannaf Ibn Abi Shaybah 16816","","","كتاب النكاح"
"16817","(۱۶۸۱۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ معمر عن رَجُلٍ ، عَنْ جَابِرٍ بْنِ زَیْدٍ قَالَ فِی الْمُکَاتَبَۃِ قَالَ : تُخَیَّرُ۔","","Musannaf Ibn Abi Shaybah 16817","","","كتاب النكاح"
"16818","(۱۶۸۱۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنْ عَامِرٍ قَالَ : تُخَیَّرُ الْمُکَاتَبَۃُ۔","","Musannaf Ibn Abi Shaybah 16818","","","كتاب النكاح"
"16819","(۱۶۸۱۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مَنْصُورٍ وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا کَاتَبت المْرَأَۃ أَعَانَہَا زَوْجُہَا عَلَی مُکَاتَبَتِہَا ثُمَّ أُعْتِقَتْ فَلاَ خِیَارَ لَہَا۔","","Musannaf Ibn Abi Shaybah 16819","","","كتاب النكاح"
"16820","(۱۶۸۲۰) حَدَّثَنَا شَرِیکٌ، عَنْ جَابِرٍ، عَنْ عَامِرٍ فِی الْمُکَاتَبَۃِ: تَسْعَی وَمَعَہَا زَوْجُہَا قَالَ: لَہَا الْخِیَارُ، وَإِنْ سَعَی مَعَہَا۔","","Musannaf Ibn Abi Shaybah 16820","","","كتاب النكاح"
"16821","(۱۶۸۲۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ وَمَنْصُورٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِتَزْوِیجِ النَّہَارِیَّاتِ۔","","Musannaf Ibn Abi Shaybah 16821","","","كتاب النكاح"
"16822","(۱۶۸۲۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ أَنَّہُ کَانَ یَکْرَہُ نِکَاحَ النَّہَارِیَّاتِ وَکَانَ الْحَسَنُ لاَ یَرَی بہ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 16822","","","كتاب النكاح"
"16823","(۱۶۸۲۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 16823","","","كتاب النكاح"
"16824","(۱۶۸۲۴) حَدَّثَنَا جَرِیرٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ وَحَمَّادٍ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً وَشَرَطَ لَہَا : مَا قَسَمْتُ لَکَ مِنْ لَیْلٍ ، أَوْ نَہَارٍ رَضِیتِ بِہِ ، قالا : ہَذَا شَرْطٌ فَاسِدٌ۔","","Musannaf Ibn Abi Shaybah 16824","","","كتاب النكاح"
"16825","(۱۶۸۲۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : کَانَ یُسْأَلُ ، عَنِ الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ فَیَشْتَرِطُ عَلَیْہَا أَنْ لاَ یَأْتِیَہَا کَذَا وَکَذَا ، وَلاَ یُنْفِقُ عَلَیْہَا إلاَّ شَیْئًا مَعْلُومًا ، قَالَ : إنَّمَا الصُّلْحُ الَّذِی أَمَرَ اللَّہُ بِہِ بَعْدَ الدُّخُولِ ، فَکَانَ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 16825","","","كتاب النكاح"
"16826","(۱۶۸۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ قَالَ : سُئِلَ یُونُسُ ، عَنِ الشَّرْطِ فِی النِّکَاحِ ، فَقَالَ : کَانَ الْحَسَنُ لاَ یَرَی بِہِ بَأْسًا إذَا کَانَتْ عَلاَنِیَۃً ، وَکَانَ ابْنُ سِیرِینَ یَکْرَہُ ابْتِدَائَہُ وَلاَ یَرَی بِہِ بَأْسًا بَعْدَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16826","","","كتاب النكاح"
"16827","(۱۶۸۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : سَأَلْتُہ عَنِ الرَّجُلِ تَکُونُ لَہُ امْرَأَۃٌ فَیَتَزَوَّجُ الْمَرْأَۃَ فَیَشْتَرِطُ لِہَذِہِ یَوْمًا وَلِہَذِہِ یَوْمَیْنِ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 16827","","","كتاب النكاح"
"16828","(۱۶۸۲۸) حَدَّثَنَا إسْمَاعِیلَ بْنِ عَیَّاشٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَاشْتَرَطُوا عَلَیْہِ : إِنْ جِئْت بِمَہْرِہَا إلَی کَذَا وَکَذَا ، وَإِلاَّ فَلاَ نِکَاحَ بَیْنَنَا ، قَالَ ابْنُ عَبَّاسٍ : لاَ بَأْسَ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 16828","","","كتاب النكاح"
"16829","(۱۶۸۲۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : ہُوَ جَائِزٌ وَکَأَنَّہُ جَعَلَہُ حَلِفًا ، وَکَانَ الْحَسَنُ یَقُولُ : قَدْ جَازَ النِّکَاحُ وَبَطَلَ الشَّرْطُ۔","","Musannaf Ibn Abi Shaybah 16829","","","كتاب النكاح"
"16830","(۱۶۸۳۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : کُلُّ شَرْطٍ فِی النِّکَاحِ فَالنِّکَاحُ یَہْدِمُہُ إلاَّ الطَّلاَقَ۔","","Musannaf Ibn Abi Shaybah 16830","","","كتاب النكاح"
"16831","(۱۶۸۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنْ جَدَّتِہِ أَنَّ أَبَاہَا تَزَوَّجَ امْرَأَۃً بِخَادِمٍ لَہَا فَخَاصَمَتْ أَبَاہَا إلَی شُرَیْحٍ فَقَضَی لَہَا بِالْخَادِمٍ وَقَضَی لِلْمَرْأَۃِ بِقِیمَۃِ الْخَادِمِ۔","","Musannaf Ibn Abi Shaybah 16831","","","كتاب النكاح"
"16832","(۱۶۸۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی أَنْ یُعْتِقَ أَبَاہَا فَلَمْ یَقْدِرْ عَلَیْہِ ، قَالَ : عَلَیْہِ قِیمَۃُ الأَبِ۔","","Musannaf Ibn Abi Shaybah 16832","","","كتاب النكاح"
"16833","(۱۶۸۳۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلِ یَتَزَوَّجُ المرأۃ عَلَی أَنْ یُحِجَّہَا قَالَ ہُوَ جائز۔","","Musannaf Ibn Abi Shaybah 16833","","","كتاب النكاح"
"16834","(۱۶۸۳۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ فِی الرَّجُلِ یَتَزَوَّجُ امْرَأَۃً عَلَی أَنَّ صَدَاقَہَا عِتْقُ أَبِیہَا فَلَمْ یُبَعْہُ قَالَ : لَہَا قِیمَۃُ الأَبِ۔","","Musannaf Ibn Abi Shaybah 16834","","","كتاب النكاح"
"16835","(۱۶۸۳۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی أَنْ یُحِجَّہَا ثُمَّ طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا قَالَ : لَہَا نِصْفُ أَدْنَی مَا یَحُجُّ بِہِ إنْسَانٌ۔","","Musannaf Ibn Abi Shaybah 16835","","","كتاب النكاح"
"16836","(۱۶۸۳۶) حَدَّثَنَا ، عَنْ عَبْدِ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : إذَا خَطَبَ الرَّجُلُ عَلَی الرَّجُلِ فَزَوَّجَہُ فَأَنْکَرَ عَلَیْہِ الآخَرُ فَحَقُّہَا ثَابِتٌ عَلَی ہَذَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 16836","","","كتاب النكاح"
"16837","(۱۶۸۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ فِی رَجُلٍ کَتَبَ إلَی أَبِیہِ ، أَوْ إلَی مَوْلاَہُ أَنْ یُزَوِّجَہُ فَزَوَّجَہُ فَجَائَ فَأَنْکَرَ عَلَیْہِ قَالَ الشَّعْبِیُّ : إِنْ أَجَازَ الزَّوْجُ النِّکَاحَ فَہُوَ جَائِزٌ ، وَإِنْ لَمْ یُجِزْہُ فَلَیْسَ بِشَیْئٍ وَلَیْسَ عَلَی وَاحِدٍ مِنْہُمَا صَدَاقٌ إِنْ لَمْ یَکُنْ دَخَلَ بِہَا۔","","Musannaf Ibn Abi Shaybah 16837","","","كتاب النكاح"
"16838","(۱۶۸۳۸) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی رَجُلٍ زَوَّجَ أَبَاہُ وَہُوَ غَائِبٌ فَلَمْ یَرْضَ الأَبُ قَالَ : الصَّدَاقُ عَلَی الابْنِ فَإِنْ زَوَّجَ الأَبُ الابْنَ فَلَمْ یَرْضَ الابْنُ فَالصَّدَاقُ عَلَی الأَبِ۔","","Musannaf Ibn Abi Shaybah 16838","","","كتاب النكاح"
"16839","(۱۶۸۳۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ قَالَ : کُنَّا نَعْزِلُ وَالْقُرْآنُ یَنْزِلُ۔(بخاری ۵۲۰۷۔ مسلم ۱۳۷)","Sahih","Musannaf Ibn Abi Shaybah 16839","","","كتاب النكاح"
"16840","(۱۶۸۴۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزِّنَادِ ، عَنْ خَارِجَۃَ بْنِ زَیْدٍ أَنَّ زَیْدًا کَانَ یَعْزِلُ عَنْ جَارِیَۃٍ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 16840","","","كتاب النكاح"
"16841","(۱۶۸۴۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عِکْرِمَۃَ ؛ أَنَّ زَیْدًا وَسَعْدًا کَانَا یَعْزِلاَنِ۔","","Musannaf Ibn Abi Shaybah 16841","","","كتاب النكاح"
"16842","(۱۶۸۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ إسْمَاعِیلَ الشَّیْبَانِیِّ أَنَّہُ خَلَفَ عَلَی امْرَأَۃِ رَافِعِ بْنِ خَدِیجٍ فَأَخْبَرَتْہُ أَنَّہُ کَانَ یَعْزِلُ ، أَوْ تَعْزِلُ مِنْ قُرُوحٍ بِہَا کَی لاَ تَغْتَسِلَ۔","Da'if","Musannaf Ibn Abi Shaybah 16842","","","كتاب النكاح"
"16843","(۱۶۸۴۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ زَائِدَۃَ بن عُمَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ : {نِسَاؤُکُمْ حَرْثٌ لَکُمْ} قَالَ : مَنْ شَائَ أَنْ یَعْزِلَ فَلْیَعْزِلْ وَمَنْ شَائَ أَنْ لاَ یَعْزِلَ فَلاَ یَعْزِلْ۔","Sahih","Musannaf Ibn Abi Shaybah 16843","","","كتاب النكاح"
"16844","(۱۶۸۴۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ یَحْیَی بْنِ عَبَّادٍ أَنَّ خَبَّابًا کَانَ یَعْزِلُ ، عَنْ سَرَارِیہِ۔","","Musannaf Ibn Abi Shaybah 16844","","","كتاب النكاح"
"16845","(۱۶۸۴۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، عَنِ ابْنِ سَعدٍ - یَعْنِی عَامِرًا - أَنَّ سَعْدًا کَانَ یَعْزِلُ۔","Sahih","Musannaf Ibn Abi Shaybah 16845","","","كتاب النكاح"
"16846","(۱۶۸۴۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الْعَزْلِ : اخْتَلَفَ فِیہِ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : فَکَانَ زَیْدٌ وَأَنَسُ بْنُ مَالِکٍ یَعْزِلاَنِ۔","Sahih","Musannaf Ibn Abi Shaybah 16846","","","كتاب النكاح"
"16847","(۱۶۸۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ أَنَّ زَیْدًا وَسَعْدًا کَانَا یَعْزِلاَنِ۔","Sahih","Musannaf Ibn Abi Shaybah 16847","","","كتاب النكاح"
"16848","(۱۶۸۴۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الضَّحَّاکِ بن عُثْمَانَ ، عَنْ سَالِمٍ أَبِی النَّضْرِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَفْلَحَ قَالَ : نَکَحْت أُمَّ وَلَدِ أَبِی أَیُّوبَ فَأَخْبَرَتْنِی أَنَّ أَبَا أَیُّوبَ کَانَ یَعْزِلُ وَأَخْبَرَتْنِی أُمُّ وَلَدِ زَیْدِ بْنِ ثَابِتٍ أَنَّہُ کَانَ یَعْزِلُ عَنْہَا وَقَالَ سَالِمٌ ، عَنْ عَائِشَۃَ ابْنَۃِ سَعْدٍ إِنَّ سَعْدًا کَانَ یَعْزِلُ ، عَنْ أُمَّہَاتِ أَوْلاَدِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 16848","","","كتاب النكاح"
"16849","(۱۶۸۴۹) حَدَّثَنَا عَبْدَۃ بن سلیمان ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : کَانَتِ الأَنْصَارُ لاَ یَرَوْنَ بَأْسًا بِالْعَزْلِ ، وَکَانَ مِمَّنْ یَقُولُ ذَلِکَ زَیْدٌ ، وَأَبُو أَیُّوبَ وَأُبَیُّ۔","","Musannaf Ibn Abi Shaybah 16849","","","كتاب النكاح"
"16850","(۱۶۸۵۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ أَنَّ عَلْقَمَۃَ وَأَصْحَابَ عَبْدِ اللہِ کَانُوا یَعْزِلُونَ۔","","Musannaf Ibn Abi Shaybah 16850","","","كتاب النكاح"
"16851","(۱۶۸۵۱) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ عَلِیِّ بْنِ حُسَیْنٍ أَنَّہُ کَانَ یَعْزِلُ وَیَتَأَوَّلُ ہَذِہِ الآیَۃَ : {وَإِذْ أَخَذَ رَبُّک مِنْ بَنِی آدَمَ مِنْ ظُہُورِہِمْ ذُرِّیَّاتِہِمْ}۔","","Musannaf Ibn Abi Shaybah 16851","","","كتاب النكاح"
"16852","(۱۶۸۵۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی عِمْرَانَ ، قَالَ : سَمِعْتُ امْرَأَۃً تَقُولُ : کَانَ الْحَسَنُ بْنُ عَلِیٍّ یَعْزِلُ عَنِّی۔","Da'if","Musannaf Ibn Abi Shaybah 16852","","","كتاب النكاح"
"16853","(۱۶۸۵۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدٍ سُئِلَ عَنِ الْعَزْلِ فَلَمْ یَرَ بِہِ بَأْسًا ، وَقَالَ : ہُوَ حَرْثُک إِنْ شِئْتَ أَعْطَشْتہ ، وَإِنْ شِئْتَ أَسْقَیْتہ۔","","Musannaf Ibn Abi Shaybah 16853","","","كتاب النكاح"
"16854","(۱۶۸۵۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مَسْعُودِ بْنِ عَلِیٍّ قَالَ : قُلْتُ لِعِکْرِمَۃَ : أَعْزِلُ ، عَنْ جَارِیَۃٍ لِی ؟ قَالَ : ہُوَ حَرْثُک فَإِنْ شِئْتَ فَأَعْطِشْہُ ، وَإِنْ شِئْتَ فَأَرْوِہِ۔","","Musannaf Ibn Abi Shaybah 16854","","","كتاب النكاح"
"16855","(۱۶۸۵۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الزِّبْرِقَانِ السَّرَّاجِ قَالَ : سَأَلْتُ ابْنَ مَعْقِلٍ ، عَنِ الْعَزْلِ ، فَقَالَ : قَدْ فَعَلَ ذَلِکَ مَنْ ہُوَ خَیْرٌ مِنِّی وَمِنْک سَعْدٌ۔","Sahih","Musannaf Ibn Abi Shaybah 16855","","","كتاب النكاح"
"16856","(۱۶۸۵۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْحَسَنِ بْنِ ذَکْوَانَ ، عَنِ الْحَسَنِ ، عَنْ جَابِرٍ قَالَ : کُنَّا نَعْزِلُ وَالْقُرْآنُ یَنْزِلُ فَلاَ نُنْہَی۔","Da'if","Musannaf Ibn Abi Shaybah 16856","","","كتاب النكاح"
"16857","(۱۶۸۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ بشر ، عَنْ مِسْعَرٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنْ رَجُلٍ ، عَنْ أمہ ، عَنْ سُرِّیَّۃٍ لِعُمَرَ أَنَّہُ کَانَ یَعْزِلُ۔","Da'if","Musannaf Ibn Abi Shaybah 16857","","","كتاب النكاح"
"16858","(۱۶۸۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ بشر حَدَّثَنَا مِسْعَرٌ ، عَنِ الْوَلِیدِ بْنِ أَبِی مَالِکٍ ، عَنْ قَزَعَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ قَالَ : إن ابْنَتِی ہَذِہِ الَّتِی فِی الْخِدْرِ مِنَ الْعَزْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 16858","","","كتاب النكاح"
"16859","(۱۶۸۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ سَالِمٍ ، عَنْ جَابِرٍ قَالَ : أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ ، فَقَالَ : إنَّ لِی خَادِمًا تَسْتَقِی عَلَی نَاضِحٍ لِی وَأَنَا أَعْزِلُ عَنْہَا ، فَجَائَتْ بِوَلَدٍ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا قَدَّرَ اللَّہُ مِنْ نَفْسٍ أَنْ یَخْلُقَہَا إلاَّ وَہِیَ کَائِنَۃٌ۔ (مسلم ۶۴۔ ابن ماجہ ۸۹)","Sahih","Musannaf Ibn Abi Shaybah 16859","","","كتاب النكاح"
"16860","(۱۶۸۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ بشر ، عَنْ مِسْعَرٍ قَالَ : أَخْبَرَنِی الْحَسَنُ بن سَعْدٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ أَنَّ ابْنَ عَبَّاسٍ سُئِلَ عَنِ الْعَزْلِ فَدَعَا جَارِیَۃً لَہُ ، فَقَالَ : عَزَلْتُ عَنْکِ أَمْسِ۔","Hasan","Musannaf Ibn Abi Shaybah 16860","","","كتاب النكاح"
"16861","(۱۶۸۶۱) حَدَّثَنَا مُحَمَّدُ بْنُ بشر ، عَنْ مِسْعَرٍ قَالَ : حدَّثَنِی عَبْدُ الْمَلِکِ بْنُ عُمَیْرٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ أَنَّ سَعْدًا کَانَ یَعْزِلُ ، عَنِ الأَمَۃِ إذَا خَشِیَ أَنْ تَحْمِلَ۔","Sahih","Musannaf Ibn Abi Shaybah 16861","","","كتاب النكاح"
"16862","(۱۶۸۶۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ أَبَا بَکْرٍ وَعُمَرَ کَانَا یَکْرَہَانِ الْعَزْلَ وَیَأْمُرَانِ النَّاسَ بِالْغُسْلِ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 16862","","","كتاب النكاح"
"16863","(۱۶۸۶۳) حَدَّثَنَا عَبْدَۃُ بن سلیمان ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ رِجَالاً مِنَ الْمُہَاجِرِینَ کَانُوا یَکْرَہُونَ الْعَزْلَ ، مِنْہُمْ فُلاَنٌ وَفُلاَنٌ وَعُثْمَانُ بْنُ عَفَّانَ۔","Sahih","Musannaf Ibn Abi Shaybah 16863","","","كتاب النكاح"
"16864","(۱۶۸۶۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَلِیٍّ قَالَ : الْعَزْلُ الْوَأْدُ الْخَفِیُّ۔","Da'if","Musannaf Ibn Abi Shaybah 16864","","","كتاب النكاح"
"16865","(۱۶۸۶۵) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ قَالَ : حدَّثَنَا مَیْمُونُ بْنُ مِہْرَانَ أَنَّ ابْنَ عُمَرَ اشْتَرَی جَارِیَۃً لِبَعْضِ بَنِیہِ ، فَقَالَ : مَا لِی لاَ أَرَاہَا تَحْمِلُ ، لَعَلَّک تَعْزِلُ عَنْہَا لَوْ أَعْلَمُ ذَلِکَ لأَوْجَعْت ظَہْرَک۔","Sahih","Musannaf Ibn Abi Shaybah 16865","","","كتاب النكاح"
"16866","(۱۶۸۶۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ بْنِ خُمَیْرٍ ، عَنْ سُلَیْمِ بْنِ عَامِرٍ ، عَنْ أَبِی أُمَامَۃَ فِی الْعَزْلِ قَالَ : مَا کُنْت أَرَی۷أَنَّ مُسْلِمًا یصنعہ۔","Sahih","Musannaf Ibn Abi Shaybah 16866","","","كتاب النكاح"
"16867","(۱۶۸۶۷) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ عَبْدِ الْوَاحِدِ الْمَالِکِیِّ ، عَنْ سَالِمٍ فِی الْعَزْلِ ، قَالَ: ہِیَ الْمَوْؤُودَۃُ الْخَفِیَّۃُ۔","","Musannaf Ibn Abi Shaybah 16867","","","كتاب النكاح"
"16868","(۱۶۸۶۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ أَنَّہُ کَانَ یَکْرَہُ الْعَزْلَ۔","","Musannaf Ibn Abi Shaybah 16868","","","كتاب النكاح"
"16869","(۱۶۸۶۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِنْدلِ بْنِ عَلِیِّ ، عَنْ جَعْفَرِ بْنِ أَبِی مُغِیرَۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، عَنْ جَرِیرٍ قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، مَا خَلُصْت إلَیْک مِنَ الْمُشْرِکِینَ إلاَّ بِقَیْنَۃٍ ، وَأَنَا أَعْزِلُ عَنْہَا ، أُرِیدُ بِہَا السُّوقَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : جَائَہَا مَا قُدِّرَ۔ (طبرانی ۲۳۷۰۔ مسند ۱۶۱۱)","Da'if","Musannaf Ibn Abi Shaybah 16869","","","كتاب النكاح"
"16870","(۱۶۸۷۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ وَأَبِی أُمَامَۃَ بْنِ سَہْلٍ عَنْہُمَا جَمِیعًا ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ قَالَ : لَمَّا أَصَبْنَا سَبْیَ بَنِی الْمُصْطَلِقِ اسْتَمْتَعْنَا من النساء وَعَزَلْنَا عَنْہُنَّ قَالَ ثم : إنی وَقفْت عَلَی جَارِیَۃٍ فِی سُوقِ بَنِی قَیْنُقَاعَ قَالَ : فَمَرَّ بِی رَجُلٌ مِنْ یَہُودَ ، فَقَالَ : مَا ہَذِہِ الْجَارِیَۃُ یَا أَبَا سَعِیدٍ ، قُلْتُ : جَارِیَۃٌ لِی أَبِیعُہَا ، قَالَ : ہَلْ کُنْت تُصِیبُہَا ؟ قَالَ ، قُلْتُ : نَعَمْ ، قَالَ : فَلَعَلَّک تَبِیعُہَا وَفِی بَطْنِہَا مِنْک سَخْلَۃٌ ؟ قَالَ : قُلْتُ : کُنْت أَعْزِلُ عَنْہَا ، قَالَ تِلْکَ الْمَوْؤُودَۃُ الصُّغْرَی ، قَالَ : فَجِئْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرْت ذَلِکَ لَہُ ، فَقَالَ : کَذَبَتْ یَہُودُ کَذَبَتْ یَہُودُ۔ (نسائی ۹۰۸۴۔ طحاوی ۳۲)","","Musannaf Ibn Abi Shaybah 16870","","","كتاب النكاح"
"16871","(۱۶۸۷۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَیْرِیزٍ قَالَ : دَخَلْت أَنَا ، وَأَبُو صرمۃ الْمَازِنِیُّ فَوَجَدْنَا أَبَا سَعِیدٍ یُحَدِّثُ کَمَا یُحَدِّثُ أَبُو سَلَمَۃَ ، وَأَبُو أُمَامَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : کَذَبَتْ یَہُودُ ، وَقَالَ فِی آخِرِ الْحَدِیثِ : وَمَا عَلَیْکُمْ أَنْ لاَ تَفْعَلُوا وَقَدْ قَدَّرَ اللَّہُ مَا ہُوَ خَالِقٌ مِنْ خَلْقِہِ إلَی یَوْمِ الْقِیَامَۃِ۔ (بخاری ۴۱۳۸۔ مسلم ۱۲۷)","","Musannaf Ibn Abi Shaybah 16871","","","كتاب النكاح"
"16872","(۱۶۸۷۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ وَعَمْرِو بْنِ مُرَّۃَ قَالاَ: یُعْزَلُ ، عَنِ الأَمَۃِ وَتُسْتَأْمَرُ الْحُرَّۃَ۔","","Musannaf Ibn Abi Shaybah 16872","","","كتاب النكاح"
"16873","(۱۶۸۷۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 16873","","","كتاب النكاح"
"16874","(۱۶۸۷۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 16874","","","كتاب النكاح"
"16875","(۱۶۸۷۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ حُمَیْدٍ الأَعْرَجِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : لاَ یُعْزَلُ ، عَنِ الْحُرَّۃِ إلاَّ بِإِذْنِہَا۔","","Musannaf Ibn Abi Shaybah 16875","","","كتاب النكاح"
"16876","(۱۶۸۷۶) حَدَّثَنَا عبد الرحمن بْنُ مَہْدِیٍّ وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ سَوَّارٍ الْکُوفِیِّ ، عَنْ عَبْدِ اللہِ قَالَ : تُسْتَأْمَرُ الْحُرَّۃَ یُعْزَلُ ، عَنِ الأَمَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 16876","","","كتاب النكاح"
"16877","(۱۶۸۷۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : لاَ یُعْزَلُ ، عَنِ الْحُرَّۃِ إلاَّ بِإِذْنِہَا۔","","Musannaf Ibn Abi Shaybah 16877","","","كتاب النكاح"
"16878","(۱۶۸۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ وَعَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ وَعَنْ سُفْیَانَ ، عَنْ أَبِی سُعَادَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالُوا : تُسْتَأْمَرُ الْحُرَّۃُ وَلاَ تُسْتَأْمَرُ الأَمَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 16878","","","كتاب النكاح"
"16879","(۱۶۸۷۹) حَدَّثَنَا أَسْبَاطُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ قَالَ : سُئِلَ عَنِ الأَمَۃِ یُعَزَلُ عَنْہَا ، قَالَ : نَعَمْ ، وَأَمَّا الْحُرَّۃُ فَیَسْتَأْمِرُہَا۔","","Musannaf Ibn Abi Shaybah 16879","","","كتاب النكاح"
"16880","(۱۶۸۸۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ أَنَّہُ کَانَ یَعْزِلُ ، عَنِ الأَمَۃِ وَلاَ یَقُولُ فِی الْحُرَّۃِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 16880","","","كتاب النكاح"
"16881","(۱۶۸۸۱) حَدَّثَنَا عَبْدِ الْوَہَّابِ الثَّقَفِیِّ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ فِی الرَّجُلِ یَشْتَرِی الأَمَۃَ الْعَذْرَائَ قَالَ : لاَ یَقْرَبَنَّ مَا دُونَ رَحِمِہَا حَتَّی یَسْتَبْرِئَہَا۔","","Musannaf Ibn Abi Shaybah 16881","","","كتاب النكاح"
"16882","(۱۶۸۸۲) حَدَّثَنَا إبْرَاہِیمُ بْنُ صَدَقَۃَ، عَنْ یُونُسَ، عَنِ الْحَسَنِ؛ فِی رَجُلٍ اشْتَرَی جَارِیَۃً عَذْرَائَ قَالَ: یَسْتَبْرِئُ رَحِمَہَا۔","","Musannaf Ibn Abi Shaybah 16882","","","كتاب النكاح"
"16883","(۱۶۸۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ قَالَ : یَسْتَبْرِئُہَا ، وَإِنْ کَانَتْ بِکْرًا۔","","Musannaf Ibn Abi Shaybah 16883","","","كتاب النكاح"
"16884","(۱۶۸۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عِکْرِمَۃَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 16884","","","كتاب النكاح"
"16885","(۱۶۸۸۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی رَجُلٍ اشْتَرَی جَارِیَۃً بَیْنَ أَبَوَیْہَا عَذْرَائَ قَالَ : یَسْتَبْرِئُہَا بِحَیْضَتَیْنِ ، وَإِنْ لاَ تَحِیضُ فَبِخَمْسَۃٍ وَأَرْبَعِینَ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 16885","","","كتاب النكاح"
"16886","(۱۶۸۸۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ، عَنْ سَعِیدٍ، عَنْ أَیُّوبَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ قَالَ: إنِ اشْتَرَی أَمَۃً عَذْرَائَ فَلاَ یَسْتَبْرِئُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16886","","","كتاب النكاح"
"16887","(۱۶۸۸۷) حَدَّثَنَا عَبَّادُ بْنِ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مَکْحُولٍ قَالَ : قُلْتُ لِلزُّہْرِیِّ : أَمَا عَلِمْت أن عُمَرَ حتی انْقَضَاء أَجَلِہِ ، وَابْنَ مَسْعُودٍ بِالْعِرَاقِ حتی انْقَضَاء أَجَلِہِ وَعُثْمَانَ بْنَ عَفَّانَ کَانُوا یَسْتَبْرِئُونَ الأَمَۃ بِحَیْضَۃٍ حَتَّی کَانَ مُعَاوِیَۃُ ، فَکَانَ یَقُولُ : حَیْضَتَانِ ، فَقَالَ الزُّہْرِیُّ : وَأَنَا أَزِیدُک عُبَادَۃَ بْنَ الصَّامِتِ۔","","Musannaf Ibn Abi Shaybah 16887","","","كتاب النكاح"
"16888","(۱۶۸۸۸) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ فِرَاسٍ، عَنِ الشَّعْبِیِّ، عَنْ عَلْقَمَۃَ، عَنْ عَبْدِ اللہِ قَالَ: تسْتَبْرَأُ الأَمَۃَ بِحَیْضَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 16888","","","كتاب النكاح"
"16889","(۱۶۸۸۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ وَقُثَمٍ وَنَاجِیَۃَ قَالوا : أَیُّمَا رَجُلٍ اشتری جَارِیَۃً فَلاَ یَقْرَبْہَا حَتَّی تَحِیضَ۔","","Musannaf Ibn Abi Shaybah 16889","","","كتاب النكاح"
"16890","(۱۶۸۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ فِی الأَمَۃِ الَّتِی تُوطَأُ قَالَ : إذَا بِیعَتْ ، أَوْ أُعْتِقَتْ فَلِتُسْتَبْرأ بِحَیْضَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 16890","","","كتاب النكاح"
"16891","(۱۶۸۹۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : سَأَلْتُہ ، عَنْ رَجُلٍ اشْتَرَی جَارِیَۃً لَہَا زَوْجٌ ، قَالَ : یَسْتَبْرِئُ رَحِمَہَا بِحَیْضَۃٍ۔","","Musannaf Ibn Abi Shaybah 16891","","","كتاب النكاح"
"16892","(۱۶۸۹۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطِیَّۃَ ، عَنِ ابْنِ عُمَرَ قَالَ : مَنِ اشْتَرَی جَارِیَۃً فَلاَ یَقْرَبْہَا حَتَّی یَسْتَبْرِئہَا بِحَیْضَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 16892","","","كتاب النكاح"
"16893","(۱۶۸۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : بِحَیْضَۃٍ۔","","Musannaf Ibn Abi Shaybah 16893","","","كتاب النكاح"
"16894","(۱۶۸۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ قَالَ : تُسْتَبْرَأ الأَمَۃَ بِحَیْضَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 16894","","","كتاب النكاح"
"16895","(۱۶۸۹۵) حَدَّثَنَا حَاتِمٌ بن وردان، عَنْ بُرد، عَنْ مَکْحُولٍ قَالَ: إذا اشْتَرَیْت الأَمَۃَ قَالَ: یَسْتَبْرِئُہَا بِحَیْضَۃٍ وَاحِدَۃٍ۔","","Musannaf Ibn Abi Shaybah 16895","","","كتاب النكاح"
"16896","(۱۶۸۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ وَطَاوُسٍ قَالاَ : تُسْتَبْرَأ الأَمَۃَ بِحَیْضَۃٍ۔","","Musannaf Ibn Abi Shaybah 16896","","","كتاب النكاح"
"16897","(۱۶۸۹۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَطَائٍ ، قَالَ : قَالَ عُمَرُ : مَنِ اشْتَرَی جَارِیَۃً فَلِیَسْتَبْرِئہَا بِحَیْضَۃٍ۔","","Musannaf Ibn Abi Shaybah 16897","","","كتاب النكاح"
"16898","(۱۶۸۹۸) حَدَّثَنَا ہُشَیْمٍ، عَنْ یُونُسَ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ: إذَا اشْتَرَاہَا وَہِیَ حَائِضٌ فَلِیَسْتَبْرِئہَا بِحَیْضَۃٍ أُخْرَی۔","","Musannaf Ibn Abi Shaybah 16898","","","كتاب النكاح"
"16899","(۱۶۸۹۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إِنْ شَائَ اجْتَزَأَ بِہَذِہِ الْحَیْضَۃِ۔","","Musannaf Ibn Abi Shaybah 16899","","","كتاب النكاح"
"16900","(۱۶۹۰۰) حَدَّثَنَا ہِشَامٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا اشْتَرَاہَا مِنَ امْرَأَۃٍ فَلِیَسْتَبْرِئہَا بِحَیْضَۃٍ۔","","Musannaf Ibn Abi Shaybah 16900","","","كتاب النكاح"
"16901","(۱۶۹۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : إذَا اشْتَرَاہَا مِنَ امْرَأَۃٍ اسْتَبْرَأَہَا۔","","Musannaf Ibn Abi Shaybah 16901","","","كتاب النكاح"
"16902","(۱۶۹۰۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، وَابْنِ سِیرِینَ فِی الرَّجُلِ یستبرء الأَمَۃَ الَّتِی لَمْ تَحِضْ قَال : کَانَا لاَ یَرَیَانِ أَنَّ ذَلِکَ یَتَبَیَّنُ فِی أَقَلَّ مِنْ ثَلاَثَۃِ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 16902","","","كتاب النكاح"
"16903","(۱۶۹۰۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ یَستَبرئہا بِثَلاَثَۃِ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 16903","","","كتاب النكاح"
"16904","(۱۶۹۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ لَیث، عَنْ عَطَائٍ وَطَاوُسٍ قَالاَ: تُسْتَبْرَأ بِحَیْضَۃٍ، وَإِنْ کَانَتْ لاَ تَحِیضُ فَثَلاَثَۃُ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 16904","","","كتاب النكاح"
"16905","(۱۶۹۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ قَالَ ثَلاَثَۃُ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 16905","","","كتاب النكاح"
"16906","(۱۶۹۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ وَسُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ قَالَ : بِثَلاَثَۃِ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 16906","","","كتاب النكاح"
"16907","(۱۶۹۰۷) حَدَّثَنَا مُعْتَمِرٌ بن سلیمان ، عَنْ مَعْمَرٍ ، عَنْ صَدَقَۃَ بْنِ یَسَارٍ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ قَالَ: ثَلاَثَۃُ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 16907","","","كتاب النكاح"
"16908","(۱۶۹۰۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ، عَنْ أَبِی قِلاَبَۃَ أَنَّہُ کَانَ یَقُولُ فِی اسْتِبْرَائِ الأَمَۃِ الَّتِی لَمْ تَحِضْ : خَمْسَۃٌ وَأَرْبَعُونَ۔","","Musannaf Ibn Abi Shaybah 16908","","","كتاب النكاح"
"16909","(۱۶۹۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ شَہْرٌ وَنِصْفٌ۔","","Musannaf Ibn Abi Shaybah 16909","","","كتاب النكاح"
"16910","(۱۶۹۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ شَہْرٌ وَنِصْف۔","","Musannaf Ibn Abi Shaybah 16910","","","كتاب النكاح"
"16911","(۱۶۹۱۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ النُّعْمَانِ ، عَنْ قَتَادَۃَ ، وَعَطَائٍ قَالاَ : تُسْتَبْرَأ الْجَارِیَۃَ الَّتِی لَمْ تَحِضْ بِخَمْسَۃٍ وَأَرْبَعِینَ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 16911","","","كتاب النكاح"
"16912","(۱۶۹۱۲) حَدَّثَنَا عبدالرحمن بن محمد الْمُحَارِبِیُّ، عَنِ الشَّیْبَانِیِّ، عَنْ حَمَّادٍ قَالَ: یَسْتَبْرِئُہَا بِخَمْسَۃٍ وَأَرْبَعِینَ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 16912","","","كتاب النكاح"
"16913","(۱۶۹۱۳) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ، عَنْ عَطَائٍ، قَالَ: قَالَ عُمَرُ: إِنْ کَانَتْ لاَ تَحِیضُ فَأَرْبَعُونَ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 16913","","","كتاب النكاح"
"16914","(۱۶۹۱۴) حَدَّثَنَا عَبدَۃ بن سلیمان ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ وَعَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالاَ : شَہْرٌ وَنِصْفٌ۔","","Musannaf Ibn Abi Shaybah 16914","","","كتاب النكاح"
"16915","(۱۶۹۱۵) حَدَّثَنَا عَبدَۃ بن سلیمان ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ عَن سعید بْنِ الْمُسَیَّبِ وَعَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالاَ : تُسْتَبْرَأُ الأَمَۃ بِحَیْضَتَیْنِ إذَا کَانَتْ تَحِیضُ۔","","Musannaf Ibn Abi Shaybah 16915","","","كتاب النكاح"
"16916","(۱۶۹۱۶) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ قَالَ : وُضِعَت عِنْدِی أَمَۃً تُسْتَبْرَأ فَحَاضَتْ حَیْضَۃً ثُمَّ ظَہَرَ لَہَا حَمْلٌ ، فَکَانَ یَسْتَبْرِئُہَا بِحَیْضَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 16916","","","كتاب النكاح"
"16917","(۱۶۹۱۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ قَالَ سئلَ یُونُسَ، عَنِ الرَّجُلِ یَشْتَرِی الأَمَۃَ فَیَسْتَبْرِئُہَا، یُصِیبُ مِنْہَا الْقُبْلَۃَ وَالْمُبَاشَرَۃَ؟ قَالَ ابْنُ سِیرِینَ : یُکْرَہُ أَنْ یُصِیبَ مِنْہَا مَا یَحْرُمُ عَلَیْہِ مِنْ غَیْرِہَا حَتَّی یَسْتَبْرِئَہَا ، وَیَذْکُرُ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ لاَ یَرَی بِالْقُبْلَۃِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 16917","","","كتاب النكاح"
"16918","(۱۶۹۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ الْمُبَارَکِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عِکْرِمَۃَ فِی الرَّجُلِ یَشْتَرِی الْجَارِیَۃَ الصَّغِیرَۃَ وَہِیَ أَصْغَرُ مِنْ ذَلِکَ قَالَ : لاَ بَأْسَ أَنْ یَمَسَّہَا قَبْلَ أَنْ یَسْتَبْرِئَہَا۔","","Musannaf Ibn Abi Shaybah 16918","","","كتاب النكاح"
"16919","(۱۶۹۱۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ فِی رَجُلٍ اشْتَرَی جَارِیَۃً صَغِیرَۃً لاَ یُجَامَعُ مِثْلُہَا ؟ قَالَ : لاَ بَأْسَ أَنْ یَطَأَہَا وَلاَ یَسْتَبْرِئُہَا۔","","Musannaf Ibn Abi Shaybah 16919","","","كتاب النكاح"
"16920","(۱۶۹۲۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّہُ کَرِہَ أَنْ یُقَبِّلَہَا حَتَّی یَسْتَبْرِئَہَا۔","","Musannaf Ibn Abi Shaybah 16920","","","كتاب النكاح"
"16921","(۱۶۹۲۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ أَیُّوبَ اللَّخْمِیِّ قَالَ : وَقَعَتْ لابْنِ عُمَرَ جَارِیَۃٌ یَوْمَ جَلُولاَئَ فِی سَہْمِہِ ، کَأَنَّ فِی عُنُقِہَا إبْرِیقَ فِضَّۃٍ قَالَ : فَمَا مَلَکَ نَفْسَہُ أَنْ جَعَلَ یُقَبِّلُہَا وَالنَّاسُ یَنْظُرُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 16921","","","كتاب النكاح"
"16922","(۱۶۹۲۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَسْلَمَ الْمُنْقِرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ قَالَ : بَاعَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ جَارِیَۃً لَہُ کَانَ یَقَعُ عَلَیْہَا قَبْلَ أَنْ یَسْتَبْرِئَہَا فَظَہَرَ بِہَا حَمْلٌ عِنْدَ الَّذِی اشْتَرَاہَا فَخَاصَمَہُ إلَی عُمَرَ ، فَقَالَ عُمَرُ : کُنْت تَقَعُ عَلَیْہَا ؟ قَالَ : نَعَمْ ، قَالَ : فَبِعْتہَا قَبْلَ أَنْ تَسْتَبْرِئَہَا ؟ قَالَ : نَعَمْ ، قَالَ : مَا کُنْت لِذَلِکَ بِخَلِیقٍ ، فَدَعَا الْقَافَۃَ فَنَظَرُوا إلَیْہِ فَأَلْحَقُوہُ بِہِ۔","","Musannaf Ibn Abi Shaybah 16922","","","كتاب النكاح"
"16923","(۱۶۹۲۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ یَسْتَبْرِئُ الرَّجُلُ أَمَتَہُ إذَا بَاعَہَا بِحَیْضَۃٍ ، وَإِذَا اشْتَرَاہَا بِحَیْضَۃٍ۔","","Musannaf Ibn Abi Shaybah 16923","","","كتاب النكاح"
"16924","(۱۶۹۲۴) حَدَّثَنَا مُعْتَمِر بن سلیمان ، عَنْ کَثِیرِ بْنِ نُبَاتَۃ ، عَنِ ابْنِ سِیرِینَ قَالَ : إذَا اشْتَرَی الرَّجُلُ الْوَصِیفَۃَ فَلَمْ تَبْلُغِ الْحَیْضَ اسْتَبْرَأَہَا بِثَلاَثَۃِ أَشْہُرٍ فَإِذَا غَشِیَہَا فَأَرَادَ بَیْعَہَا فَلِیَسْتَبْرِئہَا أَیْضًا بِثَلاَثَۃِ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 16924","","","كتاب النكاح"
"16925","(۱۶۹۲۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ إسْرَائِیلَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا أَرَادَ أَنْ یَبِیعَہَا فَلِیَسْتَبْرِئہَا۔","","Musannaf Ibn Abi Shaybah 16925","","","كتاب النكاح"
"16926","(۱۶۹۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ فِی الأَمَۃِ الَّتِی تُوطَأُ : إذَا بِیعَتْ ، أَوْ وُہِبَتْ ، أَوْ أُعْتِقَتْ فَلْتُسْتَبْرَأْ بِحَیْضَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 16926","","","كتاب النكاح"
"16927","(۱۶۹۲۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ الْمُنْکَدِرِ سَمِعَ جَابِرًا یَقُولُ : کَانَتِ الْیَہُودُ تَقُولُ : إذَا أَتَی الرَّجُلُ امْرَأَتَہُ فِی قُبُلِہَا مِنْ دُبُرِہَا کَانَ الْوَلَدُ أَحْوَلَ فَنَزَلَتْ { نِسَاؤُکُمْ حَرْثٌ لَکُمْ}۔ (بخاری ۴۵۲۸۔ ۱۰۵۸)","Sahih","Musannaf Ibn Abi Shaybah 16927","","","كتاب النكاح"
"16928","(۱۶۹۲۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ زَائِدَۃَ بْنِ عُمَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ : (نِسَاؤُکُمْ حَرْثٌ لَکُمْ) قَالَ : مَنْ شَائَ أَنْ یَعْزِلَ فَلْیَع[corrupt]زِلْ وَمَنْ شَائَ أَنْ لاَ یَعْزِلَ فَلاَ یَعْزِلْ۔","Sahih","Musannaf Ibn Abi Shaybah 16928","","","كتاب النكاح"
"16929","(۱۶۹۲۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ قَالَ : یَأْتِیہَا کَیْفَ شَائَ قَائِمٌ وَقَاعِدٌ وَعَلَی کُلِّ حَالٍ یَأْتِیہَا مَا لَمْ یَکُنْ فِی دُبُرِہَا۔","","Musannaf Ibn Abi Shaybah 16929","","","كتاب النكاح"
"16930","(۱۶۹۳۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی صَالِحٍ {نِسَاؤُکُمْ حَرْثٌ لَکُمْ فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ} قَالَ : إِنْ شِئْتَ فَأْتِہَا مُسْتَلْقِیَۃً ، وَإِنْ شِئْتَ فَمُتَحَرِّکَۃً ، وَإِنْ شِئْتَ فَبَارِکَۃً۔","","Musannaf Ibn Abi Shaybah 16930","","","كتاب النكاح"
"16931","(۱۶۹۳۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الزِّبْرِقَانِ ، عَنْ أَبِی رَزِینٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : {فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ} قَالَ : مِنْ قِبَلِ الطُّہْرِ وَلاَ تَأْتُوہُنَّ مِنْ قِبَلِ الْحَیْضِ۔","","Musannaf Ibn Abi Shaybah 16931","","","كتاب النكاح"
"16932","(۱۶۹۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ نُبَیْطٍ ، عَنِ الضَّحَّاکِ فِی قَوْلِہِ : (نِسَاؤُکُمْ حَرْثٌ لَکُمْ فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ) قَالَ : طُہْرًا غَیْرَ حُیَّضٍ۔","","Musannaf Ibn Abi Shaybah 16932","","","كتاب النكاح"
"16933","(۱۶۹۳۳) حَدَّثَنَا عبد الرحمن بن محمد الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : (نِسَاؤُکُمْ حَرْثٌ لَکُمْ فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ) قَالَ : ظَہْرٌ بِبَطْنٍ کَیْفَ شِئْت إلاَّ فِی دُبُرٍ ، أَوْ مَحِیضٍ۔","","Musannaf Ibn Abi Shaybah 16933","","","كتاب النكاح"
"16934","(۱۶۹۳۴) حَدَّثَنَا قَبِیصَۃُ قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیْمٍ ، عَنِ ابْنِ سَابِطٍ ، عَنْ حَفْصَۃَ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : لَمَّا قَدِمَ الْمُہَاجِرُونَ الْمَدِینَۃَ تَزَوَّجُوا فِی الأَنْصَارِ فَکَانُوا یُجَبُّونَہُنَّ ، وَکَانَتِ الأَنْصَارُ لاَ تَفْعَلُ ذَلِکَ ، فَقَالَتِ امْرَأَۃٌ مِنْہُنَّ لِزَوْجِہَا : حَتَّی أَسْأَلَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَاسْتَحْیَتْ أَنْ تَسْأَلَہُ فَسَأَلْتُہُ ؟ فَدَعَاہَا فَقَرَأَ عَلَیْہَا : {نِسَاؤُکُمْ حَرْثٌ لَکُمْ فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ} صِمَامًا وَاحِدًا۔n(ترمذی ۲۹۷۹۔ احمد ۶/۳۱۰)","Hasan","Musannaf Ibn Abi Shaybah 16934","","","كتاب النكاح"
"16935","(۱۶۹۳۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الْحُصَیْنِ ، عَنْ مُرَّۃَ الْہَمْدَانِیِّ أَنَّ بَعْضَ الْیَہُودِ لقی بَعْضَ الْمُسْلِمِینَ قَالَ : تَأْتُونَ النِّسَائَ وَرَائَہُنَّ ؟ قَالَ : کَأَنَّہُ کَرِہَ الإِبْرَاکَ قَالَ : فَذَکَرُوا ذَلِکَ فَنَزَلَتْ ہَذِہِ الآیَۃُ : {نِسَاؤُکُمْ حَرْثٌ لَکُمْ فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ} فَرَخَّصَ اللَّہُ لِلْمُسْلِمِینَ أَنْ یَأْتُوا النِّسَائَ فِی الْفُرُوجِ کَیْفَ شَاؤُوا وأنی شَاؤُوا مِنْ بَیْنِ أَیْدِیہِنَّ ، وَإِنْ شَاؤُوا مِنْ خَلْفِہِنَّ۔","","Musannaf Ibn Abi Shaybah 16935","","","كتاب النكاح"
"16936","(۱۶۹۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ مُرَّۃَ : {فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ} قَالَ : کَانَتِ الْیَہُودُ یَسْخَرُونَ مِنَ الْمُسْلِمِینَ فِی إتْیَانِہِمَ النِّسَائَ فَأَنْزَلَ اللَّہُ تَبَارَکَ وَتَعَالَی : {نِسَاؤُکُمْ حَرْثٌ لَکُمْ فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ} فِی الْفُرُوجِ أَنَّی شِئْتُمْ۔","","Musannaf Ibn Abi Shaybah 16936","","","كتاب النكاح"
"16937","(۱۶۹۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فِی قولہ تعالی : {نِسَاؤُکُمْ حَرْثٌ لَکُمْ فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ} قَالَ : یَأْتِیہَا مِنْ بَیْنِ یَدَیْہَا وَمِنْ خَلْفِہَا مَا لَمْ یَکُنْ فِی الدُّبُرِ","","Musannaf Ibn Abi Shaybah 16937","","","كتاب النكاح"
"16938","(۱۶۹۳۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لیث عن عِیسَی بْنِ سِنَان ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی قَوْلِہِ : {نِسَاؤُکُمْ حَرْثٌ لَکُمْ فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ} قَالَ : إِنْ شِئْتَ فَاعْزِلْ ، وَإِنْ شِئْتَ فَلاَ تَعْزِلْ۔","","Musannaf Ibn Abi Shaybah 16938","","","كتاب النكاح"
"16939","(۱۶۹۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ عَلِیٍّ قَالَ سَمِعْت الْحَسَنَ یَقُولُ : کَانَ الْمُشْرِکُونَ لاَ یَأْلُونَ مَا شَدَّدُوا عَلی الْمُسْلِمِینَ وَیَقُولُونَ : لاَ یَحِلُّ لَکُمْ أَنْ تَأْتُوا النِّسَائَ إلاَّ مِنْ وَجْہٍ وَاحِدٍ فَأَنْزَلَ اللَّہُ تَعَالَی : { فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ}۔","Hasan","Musannaf Ibn Abi Shaybah 16939","","","كتاب النكاح"
"16940","(۱۶۹۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ خَالِدِ بْنِ رَبَاحٍ ، عَنْ عِکْرِمَۃَ قَالَ : مِنْ قِبَلِ الْفَرْجِ۔","","Musannaf Ibn Abi Shaybah 16940","","","كتاب النكاح"
"16941","(۱۶۹۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ کَثِیرٍ الرَّمَّاحِ ، عَنْ أَبِی ذِرَاعٍ قَالَ : سَأَلْتُ ابْنَ عُمَرَ ، عَنْ قَوْلِہِ : (فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ) قَالَ : إِنْ شِئْتَ عَزْلاً ، وَإِنْ شِئْتَ غَیْرُ عَزْلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 16941","","","كتاب النكاح"
"16942","(۱۶۹۴۲) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ فِی قولہ تعالی : (فَأْتُوا حَرْثَکُمْ أَنَّی شِئْتُمْ) قَالَ : آتُوا النِّسَائَ فِی أَقْبَالِہِنَّ عَلَی کُلِّ نَحْوٍ۔","","Musannaf Ibn Abi Shaybah 16942","","","كتاب النكاح"
"16943","(۱۶۹۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ : {فَأْتُوہُنَّ مِنْ حَیْثُ أَمَرَکُمُ اللَّہُ} قَالَ : مِنْ حَیْثُ أَمَرَکُمْ أَنْ تَعْتَزِلُوا۔","","Musannaf Ibn Abi Shaybah 16943","","","كتاب النكاح"
"16944","(۱۶۹۴۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ یَزِیدَ بْنِ الْوَلِیدِ ، عَنْ إبْرَاہِیمَ {فَأْتُوہُنَّ مِنْ حَیْثُ أَمَرَکُمُ اللَّہُ} قَالُوا: فِی الْفُرُوجِ۔","","Musannaf Ibn Abi Shaybah 16944","","","كتاب النكاح"
"16945","(۱۶۹۴۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ قَالَ : مِنْ حَیْثُ أَمَرَکُمَ اللَّہُ أَنْ تَعْتَزِلُوہُنَّ فِی الْمَحِیضِ۔","","Musannaf Ibn Abi Shaybah 16945","","","كتاب النكاح"
"16946","(۱۶۹۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ الأَزْرَقِ ، عَنِ ابْنِ الْحَنَفِیَّۃِ : {فَأْتُوْھُنَّ مِنْ حَیْثُ أَمَرَکُمُ اللّٰہُ} قَالَ : مِنْ قِبَلِ التَّزْوِیجِ ، مِنْ قِبَلِ الْحَلاَلِ۔","","Musannaf Ibn Abi Shaybah 16946","","","كتاب النكاح"
"16947","(۱۶۹۴۷) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : {فَأْتُوْھُنَّ مِنْ حَیْثُ أَمَرَکُمُ اللّٰہُ} قَالَ : أُمِرُوا بِاعْتِزَالِ النِّسَائِ فِی الْمَحِیضِ ، فَأْتُوہُنَّ مِنْ حَیْثُ أَمَرَکُمَ اللَّہُ إذَا تَطَہَّرْنَ مِنْ حَیْثُ نُہُوا عَنْہُنَّ فِی مَحِیضِہِنَّ۔","","Musannaf Ibn Abi Shaybah 16947","","","كتاب النكاح"
"16948","(۱۶۹۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی رَزِینٍ : {فَأْتُوْھُنَّ مِنْ حَیْثُ أَمَرَکُمُ اللّٰہُ} قَالَ : مِنْ قِبَلِ الطُّہْرِ۔","","Musannaf Ibn Abi Shaybah 16948","","","كتاب النكاح"
"16949","(۱۶۹۴۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابن أَبِی مُلَیْکَۃَ قَالَ : نَزَلَتْ ہَذِہِ الآیَۃُ : {وَلَنْ تَسْتَطِیعُوا أَنْ تَعْدِلُوا بَیْنَ النِّسَائِ وَلَوْ حَرَصْتُمْ} فِی عَائِشَۃَ۔","","Musannaf Ibn Abi Shaybah 16949","","","كتاب النكاح"
"16950","(۱۶۹۵۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، عَنْ عَبِیْدَۃَ قَالَ : الْحُبُّ وَالْجِمَاعُ۔","","Musannaf Ibn Abi Shaybah 16950","","","كتاب النكاح"
"16951","(۱۶۹۵۱) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرِو بْنِ الْحَسَنِ قَالَ : فِی الْحُبِّ {فَلاَ تَمِیلُوا کُلَّ الْمَیْلِ} قَالَ : فِی الْغَشَیَانِ {فَتَذَرُوہَا کَالْمُعَلَّقَۃِ} قَالَ : لاَ أَیِّمَ وَلاَ ذَاتَ زَوْجٍ۔","","Musannaf Ibn Abi Shaybah 16951","","","كتاب النكاح"
"16952","(۱۶۹۵۲) حَدَّثَنَا عَلِیُّ بْنُ حَسَن بْنُ شَقِیقٍ قَالَ : أَخْبَرَنَا حُسَیْنُ بْنُ وَاقِدٍ قَالَ : حدَّثَنَا یَزِیدُ النَّحْوِیُّ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ : {فَتَذَرُوہَا کَالْمُعَلَّقَۃِ} قَالَ : لاَ مُطَلَّقَۃً وَلاَ ذَاتَ بَعْلٍ۔","Sahih","Musannaf Ibn Abi Shaybah 16952","","","كتاب النكاح"
"16953","(۱۶۹۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ : إذَا أَغْلَقُوا بَابًا وَأَرْخَوْا سِتْرًا ، أَوْ کَشَفُوا خِمَارًا فَقَدْ وَجَبَ الصَّدَاقُ۔","","Musannaf Ibn Abi Shaybah 16953","","","كتاب النكاح"
"16954","(۱۶۹۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عُمَرَ بِمِثْلِہِ ، زَادَ فِیہِ : وَخَلاَ بِہَا۔","","Musannaf Ibn Abi Shaybah 16954","","","كتاب النكاح"
"16955","(۱۶۹۵۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَنْ عَبَّادِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ عَلِیٌّ : إذَا أَرْخَی سِتْرًا عَلَی امْرَأَتِہِ وَأَغْلَقَ بَابًا وَجَبَ الصَّدَاقُ۔","Da'if","Musannaf Ibn Abi Shaybah 16955","","","كتاب النكاح"
"16956","(۱۶۹۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَنْ حَیَّانَ بْنِ مَرْثَدٍ ، عَنْ عَلِیٍّ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 16956","","","كتاب النكاح"
"16957","(۱۶۹۵۷) حَدَّثَنَا عَبدَۃ بن سلیمان ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنِ الأَحْنَفِ أَنَّ عُمَرَ وَعَلِیًّا قَالاَ : إذَا أَغْلَقَ بَابًا ، أَوْ أَرْخَی سِتْرًا فَلَہَا الصَّدَاقُ وَعَلَیْہَا الْعِدَّۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 16957","","","كتاب النكاح"
"16958","(۱۶۹۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزِّنَادِ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ أَنَّ رَجُلاً تَزَوَّجَ امْرَأَۃً ، فَقَالَ عِنْدَہَا فَأَرْسَلَ مَرْوَانُ إلَی زَیْدٍ ، فَقَالَ : لَہَا الصَّدَاقُ کَامِلاً ، فَقَالَ مَرْوَانُ : إنَّہُ مِمَّنْ لاَ یُتَّہَمُ ، فَقَالَ لَہُ زَیْدٌ : لَوْ أَنَّہَا جَائَتْ بِحَمْلٍ ، أَوْ بِوَلَدٍ أَکُنْت تُقِیمُ عَلَیْہَا الْحَدَّ ؟۔","Sahih","Musannaf Ibn Abi Shaybah 16958","","","كتاب النكاح"
"16959","(۱۶۹۵۹) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ حَجَّاجٍ، عَنْ مَکْحُولٍ قَالَ: اجْتَمَعَ نَفَرٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عُمَرُ وَمُعَاذٌ : أَنَّہُ إذَا أَغْلَقَ الْبَابَ وَأَرْخَی السِّتْرَ فَقَدْ وَجَبَ الصَّدَاقُ۔","","Musannaf Ibn Abi Shaybah 16959","","","كتاب النكاح"
"16960","(۱۶۹۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، قَالَ : سَمِعْتُہُ یَقُولُ : قضَی الْخُلَفَائُ الرَّاشِدُونَ الْمَہْدِیُّونَ أَنَّہُ مَنْ أَغْلَقَ بَابًا ، أَوْ أَرْخَی سِتْرًا فَقَدْ وَجَبَ الْمَہْرُ وَوَجَبَتِ الْعِدَّۃُ۔","","Musannaf Ibn Abi Shaybah 16960","","","كتاب النكاح"
"16961","(۱۶۹۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ عُمَرُ : إذَا أُرْخِیَتِ السُّتُورُ فَقَدْ وَجَبَ الصَّدَاقُ۔","Hasan","Musannaf Ibn Abi Shaybah 16961","","","كتاب النكاح"
"16962","(۱۶۹۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ قَالَ : حدَّثَنِی نَافِعُ بْنُ جُبَیْرِ بْنِ مُطْعِمٍ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إذَا أَرْخَی سِتْرًا ، أَوْ أَغْلَقَ بَابًا فَقَدْ وَجَبَ الصَّدَاقُ۔","Da'if","Musannaf Ibn Abi Shaybah 16962","","","كتاب النكاح"
"16963","(۱۶۹۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرٍ الأَحْمَرِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنْ عَلِیٍّ قَالَ : إذَا أَغْلَقَ بَابًا أو أَرْخَی سِتْرًا أو خَلَی فَلَہَا الصَّدَاقُ۔","Da'if","Musannaf Ibn Abi Shaybah 16963","","","كتاب النكاح"
"16964","(۱۶۹۶۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابن سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عُمَرَ وَعَلِیٍّ قَالاَ : إذَا أَرْخَی سِتْرًا ، أَوْ خَلَی وَجَبَ الْمَہْرُ وَعَلَیْہَا الْعِدَّۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 16964","","","كتاب النكاح"
"16965","(۱۶۹۶۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنْ حیان ، عَنْ جَابِرٍ أنہ قَالَ : إذَا نَظَرَ إلَی فَرْجِہَا ثُمَّ طَلَّقَہَا فَلَہَا الصَّدَاقُ وَعَلَیْہَا الْعِدَّۃُ۔","","Musannaf Ibn Abi Shaybah 16965","","","كتاب النكاح"
"16966","(۱۶۹۶۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : إذَا أُجِیفَت الأَبْوَابُ وَأُرْخِیَت السُّتُورُ وَجَبَ الصَّدَاقُ۔","Hasan","Musannaf Ibn Abi Shaybah 16966","","","كتاب النكاح"
"16967","(۱۶۹۶۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا اطَّلَعَ مِنْہَا عَلَی مَا لاَ یَحِلُّ لِغَیْرِہِ وَجَبَ لہا الصَّدَاقُ وَعَلَیْہَا الْعِدَّۃُ۔","","Musannaf Ibn Abi Shaybah 16967","","","كتاب النكاح"
"16968","(۱۶۹۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ أَنَّ رَجُلاً اجْتَلَی امْرَأَتَہُ فِی طَرِیقٍ فَجَعَلَ لَہَا عُمَرُ الصَّدَاقَ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 16968","","","كتاب النكاح"
"16969","(۱۶۹۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : لَہَا نِصْفُ الصَّدَاقِ ، وَإِنْ جَلَسَ بَیْنَ رِجْلَیْہَا۔","","Musannaf Ibn Abi Shaybah 16969","","","كتاب النكاح"
"16970","(۱۶۹۷۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا طَلَّقَ قَبْلَ أَنْ یَدْخُلَ فَلَہَا نِصْفُ الصَّدَاقِ ، وَإِنْ کَانَ قَدْ خَلَی بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 16970","","","كتاب النكاح"
"16971","(۱۶۹۷۱) حَدَّثَنَا وَکِ[corrupt]عٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَہَا نِصْفُ الصَّدَاقِ۔","Da'if","Musannaf Ibn Abi Shaybah 16971","","","كتاب النكاح"
"16972","(۱۶۹۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنِ الشَّعْبِیِّ أَنَّ رَجُلاً قَالَ لِشُرَیْحٍ : إنِّی تَزَوَّجْت امْرَأَۃً فَمَکَثَتْ عِنْدِی ثَمَانَ سِنِینَ ثُمَّ طَلَّقْتُہَا وَہِیَ عَذْرَائُ قَالَ : لَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 16972","","","كتاب النكاح"
"16973","(۱۶۹۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ قَالَ : لَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 16973","","","كتاب النكاح"
"16974","(۱۶۹۷۴) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ أَبِی بَکْرِ بْنِ عَیَّاشٍ ، عَنِ مَنصُور ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ قَالَ : إذَا فَقَدَتْ زَوْجَہَا لَمْ تُزَوَّجْ حَتَّی یقبل أَو أن یَمُوتَ۔","","Musannaf Ibn Abi Shaybah 16974","","","كتاب النكاح"
"16975","(۱۶۹۷۵) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ سَعِیدٍ، عَنْ أَیُّوبَ، عَنْ أَبِی قِلاَبَۃَ قَالَ: لَیْسَ لَہَا أَنْ تُزَوَّجَ حَتَّی تَبَیَّنَ لَہَا مَوْتُہُ۔","","Musannaf Ibn Abi Shaybah 16975","","","كتاب النكاح"
"16976","(۱۶۹۷۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی امْرَأَۃٍ تَفْقِدُ زَوْجَہَا ، أَوْ یَأْخُذُہُ الْعَدُوُّ ، قَالَ : تَصْبِرُ فَإِنَّمَا ہِیَ امْرَأَتُہُ ، یُصِیبُہَا مَا أَصَابَ النِّسَائَ حَتَّی یَجِیئَ زَوْجُہَا ، أَوْ یَبْلُغَہَا إِنَّہُ مَاتَ۔","","Musannaf Ibn Abi Shaybah 16976","","","كتاب النكاح"
"16977","(۱۶۹۷۷) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنِ الشَّعْبِیِّ قَالَ: لاَ تُزَوَّجُ امْرَأَۃُ الْمَفْقُودِ حَتَّی یَرْجِعَ، أَوْ یَمُوتَ۔","","Musannaf Ibn Abi Shaybah 16977","","","كتاب النكاح"
"16978","(۱۶۹۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَانِئٍ قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنِ امْرَأَۃٍ غَابَ زَوْجُہَا عَنْہَا زَمَانًا لاَ تَعْلَمُ لَہُ بِمَوْتٍ وَلاَ حَیَاۃٍ قَالَ : تَرَبَّصُ حَتَّی تَعْلَمَ حَیٌّ ہُوَ أَمْ مَیِّتٌ۔","","Musannaf Ibn Abi Shaybah 16978","","","كتاب النكاح"
"16979","(۱۶۹۷۹) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنْ مُحَمَّدٍ قَالَ: لاَ تُزَوَّجُ امْرَأَۃُ الْمَفْقُودِ حَتَّی یَأْتِیَہَا یَقِینُ مَوْتِ زَوْجِہَا۔","","Musannaf Ibn Abi Shaybah 16979","","","كتاب النكاح"
"16980","(۱۶۹۸۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ فِی امْرَأَۃِ الْمَفْقُودِ قَالاَ : لاَ تُزَوِّجُ أَبَدًا حَتَّی یَأْتِیَہَا الْخَبَرُ۔","","Musannaf Ibn Abi Shaybah 16980","","","كتاب النكاح"
"16981","(۱۶۹۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 16981","","","كتاب النكاح"
"16982","(۱۶۹۸۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ عُمَرَ بْنَ الْخَطَّابِ وَعُثْمَانَ بْنَ عَفَّانَ قَالاَ : فِی امْرَأَۃِ الْمَفْقُودِ : تَرَبَّصُ أَرْبَعَ سِنِینَ وَتَعْتَدُّ أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 16982","","","كتاب النكاح"
"16983","(۱۶۹۸۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ قَالَ : حدَّثَنَا مُجَاہِدٌ فِی غرقۃ الْمِنْہَالِ بْنِ عَمْرٍو ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عُمَرَ بْنِ الْخَطَّابِ أَنَّہُ قَالَ فِی امْرَأَۃِ الْمَفْقُودِ : تَرَبَّصُ أربع سِنِینَ ثُمَّ یُدْعَی وَلِیُّہُ فَیُطَلِّقُہَا فَتَعْتَدُّ بَعْدَ ذَلِکَ أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 16983","","","كتاب النكاح"
"16984","(۱۶۹۸۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الْفَقِیدِ بَیْنَ الصَّفَّیْنِ قَالَ : تَعْتَدُّ امْرَأَتُہُ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 16984","","","كتاب النكاح"
"16985","(۱۶۹۸۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ یَحْیَی بْنِ جَعْدَۃَ أَنَّ رَجُلاً انتَسَفَتْہُ الْجِنُّ عَلَی عَہْدِ عُمَرَ فَأَتَتِ امْرَأَتُہُ عُمَرَ فَأَمَرَہَا أَنْ تَرَبَّصَ أَرْبَعَ سِنِینَ ثُمَّ أَمَرَ وَلِیَّہُ بَعْدَ أَرْبَعِ سِنِینَ أَنْ یُطَلِّقَہَا ثُمَّ أَمَرَہَا أَنْ تَعْتَدَّ فَإِذَا انْقَضَتْ عِدَّتُہَا تَزَوَّجَتْ فَإِنْ جَائَ زَوْجُہَا خُیِّرَ بَیْنَ امْرَأَتِہِ وَالصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 16985","","","كتاب النكاح"
"16986","(۱۶۹۸۶) حَدَّثَنَا حَفْصٌ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الْفَقِیدِ بَیْنَ الصَّفَّیْنِ : تَرَبَّصُ امْرَأَتُہُ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 16986","","","كتاب النكاح"
"16987","(۱۶۹۸۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی قَالَ : شَہِدْت عُمَرَ خَیَّرَ مَفْقُودًا تَزَوَّجَتِ امْرَأَتُہُ بَیْنَہَا وَبَیْنَ الْمَہْرِ الَّذِی سَاقَہُ إلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 16987","","","كتاب النكاح"
"16988","(۱۶۹۸۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ عُمَرَ وَعُثْمَانَ بْنَ عَفَّانَ قَالاَ : إِنْ جَائَ زَوْجُہَا خُیِّرَ بَیْنَ امْرَأَتِہِ وَبَیْنَ الصَّدَاقِ الأَوَّلِ۔","Sahih","Musannaf Ibn Abi Shaybah 16988","","","كتاب النكاح"
"16989","(۱۶۹۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ سُئِلَ عُمَرُ ، عَنْ رَجُلٍ غَابَ ، عَنِ امْرَأَتِہِ فَبَلَغَہَا أَنَّہُ مَاتَ فَتَزَوَّجَتْ ثُمَّ جَائَ الزَّوْجُ الأَوَّلُ ، فَقَالَ عُمَرُ : یُخَیَّرُ الزَّوْجُ الأَوَّلُ بَیْنَ الصَّدَاقِ وَامْرَأَتِہِ فَإِنَ اخْتَارَ الصَّدَاقَ تَرَکَہَا مَعَ الزَّوْجِ الآخَرِ ، وَإِنْ شَائَ اخْتَارَ امْرَأَتَہُ وَقَالَ عَلِیٌّ : لَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ الآخَرُ مِنْ فَرْجِہَا وَیُفَرَّقُ بَیْنَہُ وَبَیْنَہَا ثُمَّ تَعْتَدُّ ثَلاَثَ حِیَضٍ ثُمَّ تُرَدُّ عَلَی الأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 16989","","","كتاب النكاح"
"16990","(۱۶۹۹۰) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ قَالَ : جَائَ رَجُلٌ إلَی إبْرَاہِیمَ ، فَقَالَ : إنَّہُ تَزَوَّجَ امْرَأَۃً کَانَ نُعِیَ إلَیْہَا زَوْجُہَا ، إِنَّہُ جَائَ کِتَابٌ مِنْہُ أَنَّہُ حَیٌّ ، فَقَالَ لہ إبْرَاہِیمُ : اعْتَزِلْہَا فَإِذَا قَدِمَ فَإِنْ شَائَ اخْتَارَ الَّذِی أَصْدَقَہَا وکَانَت امْرَأَتَکَ عَلَی حَالِہَا ، وَإِنِ اخْتَارَ الْمَرْأَۃَ فَإِذا انْقَضَتْ عِدَّتُہَا مِنْک فَہِیَ أمْرَأَۃُ الأَوَّلِ وَلَہَا مَا أَصْدَقَہَا بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا قَالَ : فَأُواکِلُہَا ؟ قَالَ : نَعَمْ وَلاَ تَدْخُلُ عَلَیْہَا حَتَّی تُؤْذِنَہَا۔","","Musannaf Ibn Abi Shaybah 16990","","","كتاب النكاح"
"16991","(۱۶۹۹۱) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ حَدَّثَنَا ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْمَلِیحِ ، عَنْ سُہَیۃَ ابْنَۃِ عُمَیْرٍ الشَّیْبَانِیَّۃِ قَالَتْ : نُعِیَ إلَیَّ زَوْجِی مِنْ قَنْدَابِیلَ فَتَزَوَّجْت بَعْدَہُ الْعَبَّاسَ بْنَ طَرِیفٍ أَخَا بَنِی قَیْسٍ ، فَقَدِمَ زَوْجِی الأَوَّلُ فَانْطَلَقْنَا إلَی عُثْمَانَ وَہُوَ مَحْصُورٌ ، فَقَالَ : کَیْفَ أَقْضِی بَیْنَکُمْ وأنا عَلَی حَالِی ہَذِہِ ؟ قُلْنَا : قَدْ رَضِینَا بِقَضَائِکَ فَخَیَّرَ الزَّوْجَ بَیْنَ الصَّدَاقِ وَبَیْنَ الْمَرْأَۃِ فَلَمَّا أُصِیبَ عُثْمَانُ انْطَلَقْنَا إلَی عَلِیٍّ وَقَصَصْنَا عَلَیْہِ الْقِصَّۃَ فَخَیَّرَ الزَّوْجَ الأَوَّلَ بَیْنَ الصَّدَاقِ وَبَیْنَ الْمَرْأَۃِ فَاخْتَارَ الصَّدَاقَ فَأَخَذَ مِنِّی أَلْفَیْنِ وَمِنَ الآخَرِ أَلْفَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 16991","","","كتاب النكاح"
"16992","(۱۶۹۹۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَیَّارٍ ، عَنِ الشَّعْبِیِّ قَالَ : امْرَأَۃُ الْمَفْقُودِ امْرَأَۃُ الأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 16992","","","كتاب النكاح"
"16993","(۱۶۹۹۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ ، قَالَ : سَمِعْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ یَقُولُ : قَضَی فِینَا ابْنُ الزُّبَیْرِ فِی مَوْلاَۃٍ لَہُمْ کَانَ زَوْجُہَا قَدْ نُعِیَ فَزُوِّجَتْ ثُمَّ جَائَ زَوْجُہَا ، فَقَضَی أَنَّ زَوْجَہَا الأَوَّلَ یُخَیَّرُ إِنْ شَائَ امْرَأَتَہُ، وَإِنْ شَائَ صَدَاقَہُ ، قَالَ عُمَرُ : وَکَانَ الْقَاسِمُ یَقُولُ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 16993","","","كتاب النكاح"
"16994","(۱۶۹۹۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الْعَبَّاسِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ حُمَید بْنِ عَبْدِ الرَّحْمَنِ أَنَّ عُمَرَ خَیَّرَ الْمَفْقُودَ وَقَدْ تَزَوَّجَتِ امْرَأَتُہُ ، فَاخْتَارَ الْمَالَ فَجَعَلَہُ عَلَی زَوْجِہَا الأَحْدَثِ قَالَ حُمَیْدٌ : فَدَخَلْتُ عَلَی الْمَرْأَۃِ الَّتِی قَضَی فِیہَا ہَذَا ، فَقَالَتْ : فَأَعَنْتُ زَوْجِی الآخَرَ بِوَلِیدَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 16994","","","كتاب النكاح"
"16995","(۱۶۹۹۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ أَنَّ عَلِیًّا قَالَ : لَیْسَ بِزَوْجٍ یَعْنِی السَّیِّدَ۔","","Musannaf Ibn Abi Shaybah 16995","","","كتاب النكاح"
"16996","(۱۶۹۹۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ قَالَ سَمِعْت الشَّعْبِیَّ یَقُولُ : لَیْسَ بِزَوْجٍ۔","","Musannaf Ibn Abi Shaybah 16996","","","كتاب النكاح"
"16997","(۱۶۹۹۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ یَقُولُ : لَیْسَ بِزَوْجٍ۔","","Musannaf Ibn Abi Shaybah 16997","","","كتاب النكاح"
"16998","(۱۶۹۹۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنْ زَیْدٍ قَالَ : ہُوَ زَوْجٌ إذَا لَمْ یُرِدِ الإِحْلاَلَ۔","Hasan","Musannaf Ibn Abi Shaybah 16998","","","كتاب النكاح"
"16999","(۱۶۹۹۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ مَرْوَانَ الأَصْفَرِ ، عَنْ أَبِی رَافِعٍ أَنَّ عُثْمَانَ بْنَ عَفَّانَ سُئِلَ عَنْ ذَلِکَ وَعِنْدَہُ عَلِیٌّ وَزَیْدُ بْنُ ثَابِتٍ ، قَالَ : فَرَخَّصَ فِی ذَلِکَ عُثْمَانُ وَزَیْدٌ ، قَالاَ : ہُوَ زَوْجٌ ، فَقَامَ عَلِیٌّ مُغْضَبًا کَارِہًا لِمَا قَالاَ۔","Sahih","Musannaf Ibn Abi Shaybah 16999","","","كتاب النكاح"
"17000","(۱۷۰۰۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : ہُوَ زَوْجٌ یقول السَّیِّدَ۔","","Musannaf Ibn Abi Shaybah 17000","","","كتاب النكاح"
"17001","(۱۷۰۰۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ حَمَّادًا ، عَنْ رَجُلٍ تَحْتَہُ أَمَۃٌ فَطَلَّقَہَا تَطْلِیقَتَیْنِ ثُمَّ یَغْشَاہَا سَیِّدُہَا ، ہَلْ تَرْجِعُ إلَی زَوْجِہَا ؟ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17001","","","كتاب النكاح"
"17002","(۱۷۰۰۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنْ رَجُلٍ کَانَتْ لَہُ امْرَأَۃٌ مَمْلُوکَۃٌ فَطَلَّقَہَا ثُمَّ إنَّ سَیِّدَہَا تَسَرَّاہَا ثُمَّ تَرَکَہَا ، أَتَحِلُّ لِزَوْجِہَا الَّذِی طَلَّقَہَا أَن یراجعہا ؟ قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 17002","","","كتاب النكاح"
"17003","(۱۷۰۰۳) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ أن زَیْدِ بْنِ ثَابِتٍ وَالزُّبَیْرِ بْنِ الْعَوَّامِ ، کَانَا لاَ یَرَیَانِ بَأْسًا إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ وَہِیَ أَمَۃٌ تَطْلِیقَتَیْنِ ثُمَّ غَشِیَہَا سَیِّدُہَا غشیانا لاَ یُرِیدُ بِذَلِکَ مُخَادَعَۃً وَلاَ إحْلاَلاً أَنْ تَرْجِعَ إلَی زَوْجِہَا بخطبۃ۔","Hasan","Musannaf Ibn Abi Shaybah 17003","","","كتاب النكاح"
"17004","(۱۷۰۰۴) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبرَاہِیمَ فِی الأَمَۃِ یُطَلِّقُہَا زَوْجُہَا تَطْلِیقَتَیْنِ ثُمَّ یَغْشَاہَا سَیِّدُہَا : إنَّہَا لاَ تَحِلُّ لِزَوْجِہَا حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 17004","","","كتاب النكاح"
"17005","(۱۷۰۰۵) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ قَالَ : إذَا طَلَّقَہَا تَطْلِیقَتَیْنِ ثُمَّ وَطِئَہَا السَّیِّدُ تَزَوَّجَہَا إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 17005","","","كتاب النكاح"
"17006","(۱۷۰۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزِّنَادِ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ أَنَّ مَرْوَانَ سَأَلَہُ عَنْہَا فَکَرِہَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 17006","","","كتاب النكاح"
"17007","(۱۷۰۰۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَبْدِالْکَرِیمِ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ: لاَ یَتَزَوَّجُ حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 17007","","","كتاب النكاح"
"17008","(۱۷۰۰۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیْدَۃَ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ وَلَہُ أَرْبَعُ نِسْوَۃٍ قَالَ : لاَ یَحِلُّ لَہُ أَنْ یَتَزَوَّجَ الْخَامِسَۃَ حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 17008","","","كتاب النكاح"
"17009","(۱۷۰۰۹) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ حَجَّاجٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ قَالَ : لاَ یَتَزَوَّجُ خَامِسَۃً حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 17009","","","كتاب النكاح"
"17010","(۱۷۰۱۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ قَالَ : لاَ یَتَزَوَّجُ حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ ، قَالَ عَطَائٌ : إذَا لَمْ یَکُنْ بَیْنَہُمَا مِیرَاثٌ وَلَمْ یَکُنْ عَلَیْہَا رَجْعَۃٌ فَلاَ بَأْسَ أَنْ یَتَزَوَّجَ۔","","Musannaf Ibn Abi Shaybah 17010","","","كتاب النكاح"
"17011","(۱۷۰۱۱) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ أَنَّہُ سُئِلَ عَنْ رَجُلٍ کَانَ لَہُ أَرْبَعُ نِسْوَۃٍ فَطَلَّقَ إحْدَاہُنَّ ثَلاَثًا ، أَیَتَزَوَّجُ خَامِسَۃً ؟ قَالَ : لاَ حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 17011","","","كتاب النكاح"
"17012","(۱۷۰۱۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ قَالَ : لاَ یَتَزَوَّجُ حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ ، وَقَالَ عَطَائٌ : إذَا لَمْ یَکُنْ بَیْنَہُمَا مِیرَاثٌ وَلَمْ یَکُنْ لَہُ عَلَیْہَا رَجْعَۃٌ فَلاَ بَأْسَ أَنْ یَتَزَوَّجَ۔","","Musannaf Ibn Abi Shaybah 17012","","","كتاب النكاح"
"17013","(۱۷۰۱۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَتَزَوَّجَ حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 17013","","","كتاب النكاح"
"17014","(۱۷۰۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ التَّیْمِیِّ أَنَّ عُتْبَۃَ بْنَ أَبِی سُفْیَانَ کَانَتْ عِنْدَہُ أَرْبَعُ نِسْوَۃٍ فَطَلَّقَ إحْدَاہُنَّ ثُمَّ تَزَوَّجَ خَامِسَۃً قَبل أَن تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ فَسَأَلَ مَرْوَانُ ابْنَ عَبَّاسٍ ، فَقَالَ : لاَ حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 17014","","","كتاب النكاح"
"17015","(۱۷۰۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَبِی صَادِقٍ قَالَ : لاَ یَتَزَوَّجُ خَامِسَۃً حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 17015","","","كتاب النكاح"
"17016","(۱۷۰۱۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا کَانَتْ تَحْتَ الرَّجُلِ أَرْبَعُ نِسْوَۃٍ فَطَلَّقَ إحْدَاہُنَّ فَلاَ یَتَزَوَّجُ خَامِسَۃً حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ فَإِنْ مَاتَتْ فَإِنْ شَائَ فَلْیَتَزَوَّجْ مِنْ یَوْمِہِ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17016","","","كتاب النكاح"
"17017","(۱۷۰۱۷) حَدَّثَنَا حَمَّاد بن خالد ، عَنْ مَالِکِ بن أَنس ، عَنْ رَبِیعَۃَ ، عَنِ الْقَاسِمِ وَعُرْوَۃَ بْنِ الزُّبَیْرِ أَنَّہُمَا قَالاَ : فِی الَّذِی عِنْدَہُ أَرْبَعُ نِسْوَۃٍ فَطَلَّقَ إحْدَاہُنَّ : یَتَزَوَّجُ مَتَی ما شَائَ۔","","Musannaf Ibn Abi Shaybah 17017","","","كتاب النكاح"
"17018","(۱۷۰۱۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ أَنَّہُ سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ فَلَمْ تَنْقَضِ عِدَّتُہَا حَتَّی تَزَوَّجَ أُخْتَہَا ، فَفَرَّقَ عَلِیٌّ بَیْنَہُمَا وَجَعَلَ لَہَا الصَّدَاقَ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا وَقَالَ : تُکْمِلُ الأُخْرَی عِدَّتَہَا وَہُوَ خَاطِبٌ فإنْ کَانَ دَخَلَ بِہَا فَلَہَا الصَّدَاقُ کَامِلاً وَعَلَیْہَا الْعِدَّۃُ کَامِلَۃً وَتَعْتَدَّانِ مِنْہُ جَمِیعًا ، کُلُّ وَاحِدَۃٍ ثَلاَث قُرُوئٍ ، فَإِنْ کَانَتَا لاَ تَحِیضَانِ فَثَلاَثَۃَ أَشْہُرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 17018","","","كتاب النكاح"
"17019","(۱۷۰۱۹) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ قَالَ طَلَّقَ رَجُلٌ امْرَأَۃً ثُمَّ تَزَوَّجَ أُخْتَہَا قَالَ ابْنُ عَبَّاسٍ لِمَرْوَانَ فَرِّقْ بَیْنَہُ وَبَیْنَہَا حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 17019","","","كتاب النكاح"
"17020","(۱۷۰۲۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا نَکَحَ الرَّجُلُ الْمَرْأَۃَ ثُمَّ طَلَّقَہَا ثُمَّ تَزَوَّجَ أُخْتَہَا فِی عِدَّتِہَا ، قَالَ : نِکَاحُہُما حَرَامٌ وَیُفَرَّقُ بَیْنَہُمَا وَلاَ صَدَاقَ لَہَا وَلاَ عِدَّۃَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17020","","","كتاب النكاح"
"17021","(۱۷۰۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا قَالَ : سُئِلَ عَامِرٌ ، عَنْ رَجُلٍ نَکَحَ امْرَأَۃً ثُمَّ طَلَّقَہَا ثُمَّ تَزَوَّجَ أُخْتَہَا فِی عِدَّتِہَا ، قَالَ : یُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17021","","","كتاب النكاح"
"17022","(۱۷۰۲۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : کَانَ یَکْرَہُ إذَا کَانَت لَہُ امْرَأَۃٌ فَطَلَّقَہَا ثَلاَثًا کَرِہَ أَنْ یَتَزَوَّجَ أُخْتَہَا حَتَّی تَنْقَضِیَ عِدَّۃُ الَّتِی طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 17022","","","كتاب النكاح"
"17023","(۱۷۰۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ یَتَزَوَّجُ الْمَرْأَۃَ فِی عِدَّۃِ أُخْتِہَا مِنْہُ۔","","Musannaf Ibn Abi Shaybah 17023","","","كتاب النكاح"
"17024","(۱۷۰۲۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ ثَلاَثًا أَنْ یَتَزَوَّجَ أُخْتَہَا فِی عِدَّتِہَا۔","","Musannaf Ibn Abi Shaybah 17024","","","كتاب النكاح"
"17025","(۱۷۰۲۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ وَخِلاَسٍ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا وَہِیَ حَامِلٌ ، قَالُوا : لاَ بَأْسَ أَنْ یَتَزَوَّجَ أُخْتَہَا فِی عِدَّتِہَا ، قَالَ : وَکَانَ عُبَیْدُ بْنُ نُضَیلَۃَ یَکْرَہُہُ حَتَّی ذُکِرَ ذلک لِلْحَسَنِ فَکَأَنَّہُ نَزَعَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 17025","","","كتاب النكاح"
"17026","(۱۷۰۲۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُنْکَحُ الْمَرْأَۃُ عَلَی عَمَّتِہَا وَلاَ خَالَتِہَا۔ (بخاری ۵۱۰۸۔ احمد ۳/۳۳۸)","Sahih","Musannaf Ibn Abi Shaybah 17026","","","كتاب النكاح"
"17027","(۱۷۰۲۷) حَدَّثَنَا عبد اللہ بْنُ نُمَیْرٍ ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ یَعْقُوبَ بْنِ عُتْبَۃَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ تُنْکَحُ الْمَرْأَۃُ عَلَی خَالَتِہَا وَلاَ عَلَی عَمَّتِہَا۔","","Musannaf Ibn Abi Shaybah 17027","","","كتاب النكاح"
"17028","(۱۷۰۲۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ یَحْیَی ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ قَالَ : لاَ تُنْکَحُ الْمَرْأَۃُ عَلَی عَمَّتِہَا وَلاَ عَلَی خَالَتِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 17028","","","كتاب النكاح"
"17029","(۱۷۰۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ قَالَ : لاَ تُنْکَحُ الْمَرْأَۃُ عَلَی عَمَّتِہَا وَلاَ عَلَی خَالَتِہَا۔","","Musannaf Ibn Abi Shaybah 17029","","","كتاب النكاح"
"17030","(۱۷۰۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُنْکَحُ الْمَرْأَۃُ عَلَی عَمَّتِہَا وَلاَ عَلَی خَالَتِہَا وَلاَ تُنْکَحُ الْعَمَّۃُ عَلَی بِنْتِ أخیہا وَلاَ الْخَالَۃُ عَلَی بِنْتِ أُخْتِہَا وَلاَ تُزَوَّجُ الصُّغْرَی عَلَی الْکُبْرَی وَلاَ الْکُبْرَی عَلَی الصُّغْرَی۔ (ترمذ ی۱۱۲۶۔ ابوداؤد ۲۰۵۸)","Sahih","Musannaf Ibn Abi Shaybah 17030","","","كتاب النكاح"
"17031","(۱۷۰۳۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُنْکَحُ الْمَرْأَۃُ عَلَی عَمَّتِہَا وَلاَ عَلَی خَالَتِہَا۔","","Musannaf Ibn Abi Shaybah 17031","","","كتاب النكاح"
"17032","(۱۷۰۳۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ نُہی أَنْ تُنْکَحَ الْمَرْأَۃُ عَلَی عَمَّتِہَا أو عَلَی خَالَتِہَا أو یَطَأُ الرجل امْرَأَۃً فِی بَطْنِہَا جَنِینٌ لِغَیْرِہِ۔ (مالک ۲۱)","","Musannaf Ibn Abi Shaybah 17032","","","كتاب النكاح"
"17033","(۱۷۰۳۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : لاَ یَتَزَوَّجُ الرَّجُلُ عَمَّۃَ امْرَأَتِہِ وَلاَ خَالَتَہَا فَإِنْ طَلَّقَہَا فَلاَ یَتَزَوَّجُ وَاحِدَۃً مِنْہُنَّ حَتَّی تَنْقَضِیَ عِدَّتُہَا۔","","Musannaf Ibn Abi Shaybah 17033","","","كتاب النكاح"
"17034","(۱۷۰۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ قَالَ : سَأَلْتُہُ ، عَنِ امْرَأَۃٍ نُکِحَتْ عَلَی خَالَتِہَا مِنَ الرَّضَاعَۃِ قَالَ: یُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17034","","","كتاب النكاح"
