hadiths[12]{hadithnumber,text}:
"472","[AI-translation] ((அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — கூறினார்கள்: ""அல்லாஹ் என் உம்மத்திற்கு இதயங்களில் தோன்றுவதை மன்னித்துவிட்டான் — அதன்படி செயல்படாத அல்லது அது பற்றிப் பேசாதவரை.""))"
"473","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""அடிமை தன் இறைவனுக்கும் எஜமானுக்கும் கீழ்ப்படிந்தால் அவருக்கு இரண்டு நன்மைகள்."" அறிவிப்பாளர் கூறுகிறார்கள்: அபூ ராஃபிஉ விடுதலை செய்யப்பட்டபோது அழத் தொடங்கினார்கள். கேட்கப்பட்டார்கள்: ஏன் அழுகிறீர்? பதிலளித்தார்கள்: எனக்கு இரண்டு நன்மைகள் இருந்தன — இப்போது அந்த நன்மைகளில் ஒன்று சென்றுவிட்டது.))"
"474","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) கூறுகிறார்கள்: அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) கூறினார்கள்: ""உங்களில் ஒருவரின் பணியாள் (அடிமை) அவருக்கு உணவு கொண்டுவந்து, அவரைத் தன்னுடன் அமரவைக்காவிட்டால் அவருக்கு ஒன்றிரண்டு கவளங்கள் கொடுக்கட்டும் — அதைத் தயாரிப்பதில் கஷ்டத்தையும் வெப்பத்தையும் தாங்கியுள்ளார்.""))"
"475","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — கூறினார்கள்: ""உங்களில் ஒருவரின் பணியாள் உணவு கொண்டுவந்தால் அவரைத் தன்னுடன் அமரவைத்து ஒரு கவளம் கொடுக்கட்டும் — சமையல் கஷ்டத்தையும் நெருப்பு வெப்பத்தையும் தாங்கியுள்ளார்.""))"
"476","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""யார் கூட்டாக உடைமையான அடிமையில் தன் பங்கை விடுதலை செய்கிறாரோ அவருக்குச் செல்வம் இருந்தால் தன் செல்வத்திலிருந்து அடிமைக்கு முழு விடுதலை வழங்குவது கடமை. செல்வம் இல்லாவிட்டால் அடிமையின் மதிப்பு நீதியாக மதிப்பிடப்பட்டு, விடுதலை செய்யப்படாத பங்கு பற்றி அடிமையிடம் உழைத்துச் சம்பாதித்து விடுதலை பெறுமாறு கூறப்படும் — ஆனால் கஷ்டம் சுமத்தப்படாது.""))"
"477","[AI-translation] ((உர்வா இதே சங்கிலியிலிருந்து அதே அறிவிப்பை அறிவித்தார்கள் — கூறினார்கள்: விடுதலை செய்யாத கூட்டாளியின் பங்கு பற்றி: அடிமையிடம் உழைத்துச் சம்பாதித்து விடுதலை பெறுமாறு கூறப்படும். ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""செல்வம் இருந்தால் செல்வத்திலிருந்து விடுதலை செய்யப்படுவார்; செல்வம் இல்லாவிட்டால் அடிமை உழைத்துச் சம்பாதித்து விடுதலை பெறுவார்.""))"
"478","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து வறியவரிடம் அதே நிலையில் தன் செல்வத்தைக் காணும் மனிதர் பற்றி அறிவித்தார்கள்; மற்றவர் அனைவரையும் விட அவர் அதிக உரிமையுடையவர். உம்ரா அனுமதி. இருவருக்குக் கூட்டாக உடைமையான அடிமையை ஒருவர் தன் கூட்டாளிக்காக (இணை உடைமையாளர்) தன் பங்கை விடுதலை செய்யும்போது.))"
"479","[AI-translation] ((ஸய்யிதுனா அபூ ஹுரைரா (ரழியல்லாஹு அன்ஹு) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""யார் கூட்டாக உடைமையான அடிமையில் தன் பங்கை விடுதலை செய்து, செல்வம் இருந்து உடன் கூட்டாளி இல்லாவிட்டால் செல்வத்திலிருந்து விடுதலை செய்வது அவர் மீது கடமையாகிறது.""))"
"480","[AI-translation] ((அதே (முந்தைய) அறிவிப்புச் சங்கிலியுடன் அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவிக்கப்பட்டது — கூறினார்கள்: ""அடிமை தன் இறைவனை நன்கு வணங்கி எஜமானுக்கும் உண்மையாக இருக்கும் நிலையில் இறந்தால் அல்லாஹ் அவரை (நரகிலிருந்து) விடுவிக்கிறான்.""))"
"481","[AI-translation] ((இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) அறிவித்தார்கள்: பரீராவின் கணவர் அபிசீனிய அடிமை — பெயர் முகீஸ். மதீனா தெருக்களில் அவருக்குப் (பரீரா, ரழியல்லாஹு அன்ஹா) பின்னால் சுற்றுவதைக் காண்பது போலுள்ளது.))"
"482","[AI-translation] ((ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) அறிவித்தார்கள்: அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) (அன்பு மகன்) இப்ராஹீம் (ரழியல்லாஹு அன்ஹு) அவர்களின் தாயார் (மாரியா அல்-கிப்திய்யா, ரழியல்லாஹு அன்ஹா) அவரைப் பெற்றபோது கூறினார்கள்: ""அவர் மகன் அவரை விடுவித்துவிட்டார்.""))"
"483","[AI-translation] ((ஸய்யிதுனா இப்னு அப்பாஸ் (ரழியல்லாஹு அன்ஹுமா) அல்லாஹ்வின் தூதர் (ஸல்லல்லாஹு அலைஹி வஸல்லம்) அவர்களிடமிருந்து அறிவித்தார்கள் — அவர்கள் கூறினார்கள்: ""எந்த அடிமைப் பெண் எஜமானிடமிருந்து குழந்தை பெறுகிறாரோ அவர் அவர் (எஜமான்) இறப்புக்குப் பிறகு விடுதலையாவார்.""))"
