hadiths[58]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"2441","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، أَخْبَرَنَا مَالِكٌ، عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ، عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ، عَنِ ابْنِ مُحَيْرِيزٍ، قَالَ رَأَيْتُ أَبَا سَعِيدٍ ـ رضى الله عنه ـ فَسَأَلْتُهُ فَقَالَ خَرَجْنَا مَعَ رَسُولِ اللَّهِ صلى الله عليه وسلم فِي غَزْوَةِ بَنِي الْمُصْطَلِقِ فَأَصَبْنَا سَبْيًا مِنْ سَبْىِ الْعَرَبِ، فَاشْتَهَيْنَا النِّسَاءَ فَاشْتَدَّتْ عَلَيْنَا الْعُزْبَةُ وَأَحْبَبْنَا الْعَزْلَ، فَسَأَلْنَا رَسُولَ اللَّهِ صلى الله عليه وسلم فَقَالَ ‏ ‏ مَا عَلَيْكُمْ أَنْ لاَ تَفْعَلُوا، مَا مِنْ نَسَمَةٍ كَائِنَةٍ إِلَى يَوْمِ الْقِيَامَةِ إِلاَّ وَهْىَ كَائِنَةٌ ‏""""‏‏.‏""","Default: Sahih","","","Narrated Ibn Muhairiz:","Manumission of Slaves"
"2442","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ، حَدَّثَنَا جَرِيرٌ، عَنْ عُمَارَةَ بْنِ الْقَعْقَاعِ، عَنْ أَبِي زُرْعَةَ، عَنْ أَبِي هُرَيْرَةَ ـ رضى الله عنه ـ قَالَ لاَ أَزَالُ أُحِبُّ بَنِي تَمِيمٍ‏.‏ وَحَدَّثَنِي ابْنُ سَلاَمٍ أَخْبَرَنَا جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ عَنِ الْمُغِيرَةِ عَنِ الْحَارِثِ عَنْ أَبِي زُرْعَةَ عَنْ أَبِي هُرَيْرَةَ‏.‏ وَعَنْ عُمَارَةَ عَنْ أَبِي زُرْعَةَ عَنْ أَبِي هُرَيْرَةَ قَالَ مَا زِلْتُ أُحِبُّ بَنِي تَمِيمٍ مُنْذُ ثَلاَثٍ سَمِعْتُ مِنْ رَسُولِ اللَّهِ صلى الله عليه وسلم يَقُولُ فِيهِمْ، سَمِعْتُهُ يَقُولُ ‏""‏ هُمْ أَشَدُّ أُمَّتِي عَلَى الدَّجَّالِ ‏""‏‏.‏ قَالَ وَجَاءَتْ صَدَقَاتُهُمْ، فَقَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏""‏ هَذِهِ صَدَقَاتُ قَوْمِنَا ‏""‏‏.‏ وَكَانَتْ سَبِيَّةٌ مِنْهُمْ عِنْدَ عَائِشَةَ‏.‏ فَقَالَ ‏""‏ أَعْتِقِيهَا فَإِنَّهَا مِنْ وَلَدِ إِسْمَاعِيلَ ‏""‏‏.‏","Default: Sahih","","2442","Narrated Abu Huraira:","Manumission of Slaves"
"2443","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ، سَمِعَ مُحَمَّدَ بْنَ فُضَيْلٍ، عَنْ مُطَرِّفٍ، عَنِ الشَّعْبِيِّ، عَنْ أَبِي بُرْدَةَ، عَنْ أَبِي مُوسَى ـ رضى الله عنه ـ قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ ‏ مَنْ كَانَتْ لَهُ جَارِيَةٌ فَعَالَهَا، فَأَحْسَنَ إِلَيْهَا ثُمَّ أَعْتَقَهَا وَتَزَوَّجَهَا، كَانَ لَهُ أَجْرَانِ ‏""""‏‏.‏""","Default: Sahih","","","Narrated Abu Musa:","Manumission of Slaves"
"2444","حَدَّثَنَا آدَمُ بْنُ أَبِي إِيَاسٍ، حَدَّثَنَا شُعْبَةُ، حَدَّثَنَا وَاصِلٌ الأَحْدَبُ، قَالَ سَمِعْتُ الْمَعْرُورَ بْنَ سُوَيْدٍ، قَالَ رَأَيْتُ أَبَا ذَرٍّ الْغِفَارِيَّ ـ رضى الله عنه ـ وَعَلَيْهِ حُلَّةٌ وَعَلَى غُلاَمِهِ حُلَّةٌ فَسَأَلْنَاهُ عَنْ ذَلِكَ فَقَالَ إِنِّي سَابَبْتُ رَجُلاً فَشَكَانِي إِلَى النَّبِيِّ صلى الله عليه وسلم، فَقَالَ لِيَ النَّبِيُّ صلى الله عليه وسلم ‏""‏ أَعَيَّرْتَهُ بِأُمِّهِ ‏""‏‏.‏ ثُمَّ قَالَ ‏""‏ إِنَّ إِخْوَانَكُمْ خَوَلُكُمْ جَعَلَهُمُ اللَّهُ تَحْتَ أَيْدِيكُمْ، فَمَنْ كَانَ أَخُوهُ تَحْتَ يَدِهِ فَلْيُطْعِمْهُ مِمَّا يَأْكُلُ، وَلْيُلْبِسْهُ مِمَّا يَلْبَسُ، وَلاَ تُكَلِّفُوهُمْ مَا يَغْلِبُهُمْ، فَإِنْ كَلَّفْتُمُوهُمْ مَا يَغْلِبُهُمْ فَأَعِينُوهُمْ ‏""‏‏.‏","Default: Sahih","","2444","Narrated Al-Ma'rur bin Suwaid:","Manumission of Slaves"
"2445","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، عَنْ مَالِكٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ ـ رضى الله عنهما ـ أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ ‏ الْعَبْدُ إِذَا نَصَحَ سَيِّدَهُ وَأَحْسَنَ عِبَادَةَ رَبِّهِ كَانَ لَهُ أَجْرُهُ مَرَّتَيْنِ ‏""""‏‏.‏""","Default: Sahih","","","Narrated Ibn `Umar:","Manumission of Slaves"
"2446","حَدَّثَنَا مُحَمَّدُ بْنُ كَثِيرٍ، أَخْبَرَنَا سُفْيَانُ، عَنْ صَالِحٍ، عَنِ الشَّعْبِيِّ، عَنْ أَبِي بُرْدَةَ، عَنْ أَبِي مُوسَى الأَشْعَرِيِّ ـ رضى الله عنه ـ قَالَ النَّبِيُّ صلى الله عليه وسلم ‏ ‏ أَيُّمَا رَجُلٍ كَانَتْ لَهُ جَارِيَةٌ فَأَدَّبَهَا فَأَحْسَنَ تَأْدِيبَهَا، وَأَعْتَقَهَا وَتَزَوَّجَهَا، فَلَهُ أَجْرَانِ، وَأَيُّمَا عَبْدٍ أَدَّى حَقَّ اللَّهِ وَحَقَّ مَوَالِيهِ، فَلَهُ أَجْرَانِ ‏""""‏‏.‏""","Default: Sahih","","","Narrated Abu Musa Al-Ash`ari:","Manumission of Slaves"
"2447","حَدَّثَنَا بِشْرُ بْنُ مُحَمَّدٍ، أَخْبَرَنَا عَبْدُ اللَّهِ، أَخْبَرَنَا يُونُسُ، عَنِ الزُّهْرِيِّ، سَمِعْتُ سَعِيدَ بْنَ الْمُسَيَّبِ، يَقُولُ قَالَ أَبُو هُرَيْرَةَ ـ رضى الله عنه ـ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ ‏ لِلْعَبْدِ الْمَمْلُوكِ الصَّالِحِ أَجْرَانِ، وَالَّذِي نَفْسِي بِيَدِهِ لَوْلاَ الْجِهَادُ فِي سَبِيلِ اللَّهِ وَالْحَجُّ وَبِرُّ أُمِّي، لأَحْبَبْتُ أَنْ أَمُوتَ وَأَنَا مَمْلُوكٌ ‏""""‏‏.‏""","Default: Sahih","takhreej: لقوله جل ذكره ‏ {‏ لا يحب الله الجهر بالسوء من القول إلا من ظلم وكان الله سميعا عليما‏}‏‏.‏ ‏ {‏ والذين إذا أصابهم البغى هم ينتصرون‏}‏‏.‏ قال إبراهيم كانوا يكرهون أن يستذلوا ،‏‏‏‏ ‏‏‏‏ فإذا قدروا عفوا‏.‏ لقوله تعالى ‏ {‏ إن تبدوا خيرا أو تخفوه أو تعفوا عن سوء فإن الله كان عفوا قديرا‏}‏ ‏ {‏ وجزاء سيئة سيئة مثلها فمن عفا وأصلح فأجره على الله إنه لا يحب الظالمين * ولمن انتصر بعد ظلمه فأولئك ما عليهم من سبيل * إنما السبيل على الذين يظلمون الناس ويبغون في الأرض بغير الحق أولئك لهم عذاب أليم * ولمن صبر وغفر إن ذلك لمن عزم الأمور‏}‏ ‏ {‏ وترى الظالمين لما رأوا العذاب يقولون هل إلى مرد من سبيل ‏}‏","","Narrated Abu Huraira:","Manumission of Slaves"
"2448","حَدَّثَنَا إِسْحَاقُ بْنُ نَصْرٍ، حَدَّثَنَا أَبُو أُسَامَةَ، عَنِ الأَعْمَشِ، حَدَّثَنَا أَبُو صَالِحٍ، عَنْ أَبِي هُرَيْرَةَ ـ رضى الله عنه ـ قَالَ قَالَ النَّبِيُّ صلى الله عليه وسلم ‏ ‏ نِعْمَ مَا لأَحَدِهِمْ يُحْسِنُ عِبَادَةَ رَبِّهِ وَيَنْصَحُ لِسَيِّدِهِ ‏""""‏‏.‏""","Default: Sahih","","","Narrated Abu Huraira:","Manumission of Slaves"
"2449","حَدَّثَنَا مُسَدَّدٌ، حَدَّثَنَا يَحْيَى، عَنْ عُبَيْدِ اللَّهِ، حَدَّثَنِي نَافِعٌ، عَنْ عَبْدِ اللَّهِ ـ رضى الله عنه ـ عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ ‏ إِذَا نَصَحَ الْعَبْدُ سَيِّدَهُ، وَأَحْسَنَ عِبَادَةَ رَبِّهِ، كَانَ لَهُ أَجْرُهُ مَرَّتَيْنِ ‏""""‏‏.‏""","Default: Sahih","","","Narrated `Abdullah:","Manumission of Slaves"
"2450","حَدَّثَنَا مُحَمَّدُ بْنُ الْعَلاَءِ، حَدَّثَنَا أَبُو أُسَامَةَ، عَنْ بُرَيْدٍ، عَنْ أَبِي بُرْدَةَ، عَنْ أَبِي مُوسَى ـ رضى الله عنه ـ عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ ‏ الْمَمْلُوكُ الَّذِي يُحْسِنُ عِبَادَةَ رَبِّهِ، وَيُؤَدِّي إِلَى سَيِّدِهِ الَّذِي لَهُ عَلَيْهِ مِنَ الْحَقِّ وَالنَّصِيحَةِ وَالطَّاعَةِ، لَهُ أَجْرَانِ ‏""""‏‏.‏""","Default: Sahih","","","Narrated Abu Musa:","Manumission of Slaves"
"2451","حَدَّثَنَا مُحَمَّدٌ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ، أَخْبَرَنَا مَعْمَرٌ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ ـ رضى الله عنه ـ يُحَدِّثُ عَنِ النَّبِيِّ صلى الله عليه وسلم أَنَّهُ قَالَ ‏ ‏ لاَ يَقُلْ أَحَدُكُمْ أَطْعِمْ رَبَّكَ، وَضِّئْ رَبَّكَ، اسْقِ رَبَّكَ‏.‏ وَلْيَقُلْ سَيِّدِي مَوْلاَىَ‏.‏ وَلاَ يَقُلْ أَحَدُكُمْ عَبْدِي أَمَتِي‏.‏ وَلْيَقُلْ فَتَاىَ وَفَتَاتِي وَغُلاَمِي ‏""""‏‏.‏""","Default: Sahih","","","Narrated Abu Huraira:","Manumission of Slaves"
"2452","حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا جَرِيرُ بْنُ حَازِمٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ ـ رضى الله عنهما ـ قَالَ قَالَ النَّبِيُّ صلى الله عليه وسلم ‏ ‏ مَنْ أَعْتَقَ نَصِيبًا لَهُ مِنَ الْعَبْدِ، فَكَانَ لَهُ مِنَ الْمَالِ مَا يَبْلُغُ قِيمَتَهُ، يُقَوَّمُ عَلَيْهِ قِيمَةَ عَدْلٍ، وَأُعْتِقَ مِنْ مَالِهِ، وَإِلاَّ فَقَدْ عَتَقَ مِنْهُ ‏""""‏‏.‏""","Default: Sahih","","","Narrated Ibn `Umar:","Manumission of Slaves"
"2453","حَدَّثَنَا مُسَدَّدٌ، حَدَّثَنَا يَحْيَى، عَنْ عُبَيْدِ اللَّهِ، قَالَ حَدَّثَنِي نَافِعٌ، عَنْ عَبْدِ اللَّهِ ـ رضى الله عنه ـ أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ ‏ كُلُّكُمْ رَاعٍ فَمَسْئُولٌ عَنْ رَعِيَّتِهِ، فَالأَمِيرُ الَّذِي عَلَى النَّاسِ رَاعٍ وَهْوَ مَسْئُولٌ عَنْهُمْ، وَالرَّجُلُ رَاعٍ عَلَى أَهْلِ بَيْتِهِ وَهْوَ مَسْئُولٌ عَنْهُمْ، وَالْمَرْأَةُ رَاعِيَةٌ عَلَى بَيْتِ بَعْلِهَا وَوَلَدِهِ وَهْىَ مَسْئُولَةٌ عَنْهُمْ، وَالْعَبْدُ رَاعٍ عَلَى مَالِ سَيِّدِهِ وَهْوَ مَسْئُولٌ عَنْهُ، أَلاَ فَكُلُّكُمْ رَاعٍ وَكُلُّكُمْ مَسْئُولٌ عَنْ رَعِيَّتِهِ ‏""""‏‏.‏""","Default: Sahih","","","Narrated `Abdullah:","Manumission of Slaves"
"2454","حَدَّثَنَا مَالِكُ بْنُ إِسْمَاعِيلَ، حَدَّثَنَا سُفْيَانُ، عَنِ الزُّهْرِيِّ، حَدَّثَنِي عُبَيْدُ اللَّهِ، سَمِعْتُ أَبَا هُرَيْرَةَ، وَزَيْدَ بْنَ خَالِدٍ، رضى الله عنهما عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ ‏ إِذَا زَنَتِ الأَمَةُ فَاجْلِدُوهَا، ثُمَّ إِذَا زَنَتْ فَاجْلِدُوهَا، ثُمَّ إِذَا زَنَتْ فَاجْلِدُوهَا، فِي الثَّالِثَةِ أَوِ الرَّابِعَةِ بِيعُوهَا وَلَوْ بِضَفِيرٍ ‏""""‏‏.‏""","Default: Sahih","","","Narrated Abu Huraira and Zaid bin Khalid:","Manumission of Slaves"
"2455","حَدَّثَنَا حَجَّاجُ بْنُ مِنْهَالٍ، حَدَّثَنَا شُعْبَةُ، قَالَ أَخْبَرَنِي مُحَمَّدُ بْنُ زِيَادٍ، سَمِعْتُ أَبَا هُرَيْرَةَ ـ رضى الله عنه ـ عَنِ النَّبِيِّ صلى الله عليه وسلم ‏ ‏ إِذَا أَتَى أَحَدَكُمْ خَادِمُهُ بِطَعَامِهِ، فَإِنْ لَمْ يُجْلِسْهُ مَعَهُ، فَلْيُنَاوِلْهُ لُقْمَةً أَوْ لُقْمَتَيْنِ أَوْ أُكْلَةً أَوْ أُكْلَتَيْنِ، فَإِنَّهُ وَلِيَ عِلاَجَهُ ‏""""‏‏.‏""","Default: Sahih","","","Narrated Abu Huraira:","Manumission of Slaves"
"2456","حَدَّثَنَا أَبُو الْيَمَانِ، أَخْبَرَنَا شُعَيْبٌ، عَنِ الزُّهْرِيِّ، قَالَ أَخْبَرَنِي سَالِمُ بْنُ عَبْدِ اللَّهِ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ـ رضى الله عنهما ـ أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صلى الله عليه وسلم يَقُولُ ‏""‏ كُلُّكُمْ رَاعٍ وَمَسْئُولٌ عَنْ رَعِيَّتِهِ، فَالإِمَامُ رَاعٍ وَمَسْئُولٌ عَنْ رَعِيَّتِهِ، وَالرَّجُلُ فِي أَهْلِهِ رَاعٍ وَهْوَ مَسْئُولٌ عَنْ رَعِيَّتِهِ، وَالْمَرْأَةُ فِي بَيْتِ زَوْجِهَا رَاعِيَةٌ وَهْىَ مَسْئُولَةٌ عَنْ رَعِيَّتِهَا، وَالْخَادِمُ فِي مَالِ سَيِّدِهِ رَاعٍ وَهْوَ مَسْئُولٌ عَنْ رَعِيَّتِهِ ‏""‏‏.‏ قَالَ فَسَمِعْتُ هَؤُلاَءِ مِنَ النَّبِيِّ صلى الله عليه وسلم وَأَحْسِبُ النَّبِيَّ صلى الله عليه وسلم قَالَ ‏""‏ وَالرَّجُلُ فِي مَالِ أَبِيهِ رَاعٍ وَمَسْئُولٌ عَنْ رَعِيَّتِهِ، فَكُلُّكُمْ رَاعٍ وَكُلُّكُمْ مَسْئُولٌ عَنْ رَعِيَّتِهِ ‏""‏‏.‏","Default: Sahih","","2456","Narrated `Abdullah bin `Umar:","Manumission of Slaves"
"2457","حَدَّثَنَا مُحَمَّدُ بْنُ عُبَيْدِ اللَّهِ، حَدَّثَنَا ابْنُ وَهْبٍ، قَالَ حَدَّثَنِي مَالِكُ بْنُ أَنَسٍ، قَالَ وَأَخْبَرَنِي ابْنُ فُلاَنٍ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ، عَنْ أَبِيهِ، عَنْ أَبِي هُرَيْرَةَ ـ رضى الله عنه ـ عَنِ النَّبِيِّ صلى الله عليه وسلم وَحَدَّثَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدٍ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ، أَخْبَرَنَا مَعْمَرٌ، عَنْ هَمَّامٍ، عَنْ أَبِي هُرَيْرَةَ ـ رضى الله عنه ـ عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ ‏ إِذَا قَاتَلَ أَحَدُكُمْ فَلْيَجْتَنِبِ الْوَجْهَ ‏""""‏‏.‏""","Default: Sahih","","","Narrated Abu Huraira:","Manumission of Slaves"
"2517","حَدَّثَنَا أَحْمَدُ بْنُ يُونُسَ ، حَدَّثَنَا عَاصِمُ بْنُ مُحَمَّدٍ ، قَالَ : حَدَّثَنِي وَاقِدُ بْ","Default: Sahih","takhreej: وقوله تعالى ‏ {‏ فك رقبة * أو إطعام في يوم ذي مسغبة * يتيما ذا مقربة ‏}‏","2517","","Manumission of Slaves"
"2518","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ أَبِي مُر","Default: Sahih","Book 49"," Hadith 2","2518",""
"2519","حَدَّثَنَا مُوسَى بْنُ مَسْعُودٍ ، حَدَّثَنَا زَائِدَةُ بْنُ قُدَامَةَ ، عَنْ هِشَامِ بْنِ عُرْوَةَ","Default: Sahih","Book 49"," Hadith 3","2519",""
"2520","حَدَّثَنَا مُحَمَّدُ بْنُ أَبِي بَكْرٍ ، حَدَّثَنَا عَثَّامٌ ، حَدَّثَنَا هِشَامٌ ، عَنْ فَاطِمَةَ ب","Default: Sahih","Book 49"," Hadith 4","2520",""
"2521","حَدَّثَنَا عَلِيُّ بْنُ عَبْدِ اللَّهِ ، حَدَّثَنَا سُفْيَانُ ، عَنْ عَمْرٍو ، عَنْ سَالِمٍ ، عَنْ أ","Default: Sahih","Book 49"," Hadith 5","2521",""
"2522","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ ، أَخْبَرَنَا مَالِكٌ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ بْ","Default: Sahih","Book 49"," Hadith 6","2522",""
"2523","حَدَّثَنَا عُبَيْدُ بْنُ إِسْمَاعِيلَ ، عَنْ أَبِي أُسَامَةَ ، عَنْ عُبَيْدِ اللَّهِ ، عَنْ نَافِعٍ","Default: Sahih","Book 49"," Hadith 7","2523",""
"2524","حَدَّثَنَا أَبُو النُّعْمَانِ ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَن","Default: Sahih","Book 49"," Hadith 8","2524",""
"2525","حَدَّثَنَا أَحْمَدُ بْنُ مِقْدَامٍ ، حَدَّثَنَا الْفُضَيْلُ بْنُ سُلَيْمَانَ ، حَدَّثَنَا مُوسَى بْن","Default: Sahih","Book 49"," Hadith 9","2525",""
"2526","حَدَّثَنَا أَحْمَدُ ابْنُ أَبِي رَجَاءٍ ، حَدَّثَنَا يَحْيَى بْنُ آدَمَ ، حَدَّثَنَا جَرِيرُ بْنُ حَ","Default: Sahih","Book 49"," Hadith 10","2526",""
"2527","حَدَّثَنَا مُسَدَّدٌ ، حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ ، حَدَّثَنَا سَعِيدٌ ، عَنْ قَتَادَةَ ، عَنِ","Default: Sahih","Book 49"," Hadith 11","2527",""
"2528","حَدَّثَنَا الْحُمَيْدِيُّ ، حَدَّثَنَا سُفْيَانُ ، حَدَّثَنَا مِسْعَرٌ ، عَنْ قَتَادَةَ ، عَنْ زُرَا","Default: Sahih","takhreej: ولا عتاقة إلا لوجه الله‏.‏ وقال النبي صلى الله عليه وسلم ‏""‏ لكل امرئ ما نوى ‏""‏ ولا نية للناسي والمخطئ‏.‏","2528","","Manumission of Slaves"
"2529","حَدَّثَنَا مُحَمَّدُ بْنُ كَثِيرٍ ، عَنْ سُفْيَانَ ، حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ ، عَنْ مُحَمَّد","Default: Sahih","Book 49"," Hadith 13","2529",""
"2530","حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، عَنْ مُحَمَّدِ بْنِ بِشْرٍ ، عَنْ إِسْمَاعِ","Default: Sahih","Book 49"," Hadith 14","2530",""
"2531","حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، حَدَّثَنَا أَبُو أُسَامَةَ ، حَدَّثَنَا إِسْمَاعِيلُ ، عَ","Default: Sahih","Book 49"," Hadith 15","2531",""
"2532","حَدَّثَنَا شِهَابُ بْنُ عَبَّادٍ ، حَدَّثَنَا إِبْرَاهِيمُ بْنُ حُمَيْدٍ ، عَنْ إِسْمَاعِيلَ ، عَنْ","Default: Sahih","Book 49"," Hadith 16","2532",""
"2533","حَدَّثَنَا أَبُو الْيَمَانِ ، أَخْبَرَنَا شُعَيْبٌ ، عَنْ الزُّهْرِيِّ ، قَالَ : حَدَّثَنِي عُرْوَةُ","Default: Sahih","takhreej: قال أبو هريرة عن النبي صلى الله عليه وسلم ‏""‏ من أشراط الساعة أن تلد الأمة ربها ‏""‏‏.‏","2533","","Manumission of Slaves"
"2534","حَدَّثَنَا آدَمُ بْنُ أَبِي إِيَاسٍ ، حَدَّثَنَا شُعْبَةُ ، حَدَّثَنَا عَمْرُو بْنُ دِينَارٍ ، سَمِع","Default: Sahih","Book 49"," Hadith 18","2534",""
"2535","حَدَّثَنَا أَبُو الْوَلِيدِ ، حَدَّثَنَا شُعْبَةُ ، قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ دِينَارٍ","Default: Sahih","Book 49"," Hadith 19","2535",""
"2536","حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، حَدَّثَنَا جَرِيرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ ،","Default: Sahih","Book 49"," Hadith 20","2536",""
"2537","حَدَّثَنَا إِسْمَاعِيلُ بْنُ عَبْدِ اللَّهِ ، حَدَّثَنَا إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ بْنِ عُقْبَة","Default: Sahih","takhreej: وقال أنس قال العباس للنبي صلى الله عليه وسلم فاديت نفسي ،‏‏‏‏ وفاديت عقيلا‏.‏ وكان علي له نصيب في تلك الغنيمة التي أصاب من أخيه عقيل وعمه عباس‏.","2537","","Manumission of Slaves"
"2538","حَدَّثَنَا عُبَيْدُ بْنُ إِسْمَاعِيلَ ، حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ هِشَامٍ ، أَخْبَرَنِي أَبِ","Default: Sahih","Book 49"," Hadith 22","2538",""
"2540","حَدَّثَنَا ابْنُ أَبِي مَرْيَمَ ، قَالَ : أَخْبَرَنَا اللَّيْثُ ، عَنْ عُقَيْلٍ ، عَنِ ابْنِ شِهَابٍ","Default: Sahih","takhreej: وقوله تعالى ‏ {‏ ضرب الله مثلا عبدا مملوكا لا يقدر على شىء ومن رزقناه منا رزقا حسنا فهو ينفق منه سرا وجهرا هل يستوون الحمد لله بل أكثرهم لا يعلمون ‏}‏‏.‏","2540","","Manumission of Slaves"
"2541","حَدَّثَنَا عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ، أَخْبَرَنَا عَبْدُ اللَّهِ ، أَخْبَرَنَا ابْنُ عَوْ","Default: Sahih","Book 49"," Hadith 24","2541",""
"2542","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ ، أَخْبَرَنَا مَالِكٌ ، عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرّ","Default: Sahih","Book 49"," Hadith 25","2542",""
"2543","حَدَّثَنَا زُهَيْرُ بْنُ حَرْبٍ ، حَدَّثَنَا جَرِيرٌ ، عَنْ عُمَارَةَ بْنِ الْقَعْقَاعِ ، عَنْ أَبِي","Default: Sahih","Book 49"," Hadith 26","2543",""
"2544","حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، سَمِعَ مُحَمَّدَ بْنَ فُضَيْلٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشّ","Default: Sahih","Book 49"," Hadith 27","2544",""
"2545","حَدَّثَنَا آدَمُ بْنُ أَبِي إِيَاسٍ ، حَدَّثَنَا شُعْبَةُ ، حَدَّثَنَا وَاصِلٌ الْأَحْدَبُ ، قَالَ :","Default: Sahih","takhreej: وقوله تعالى ‏ {‏ واعبدوا الله ولا تشركوا به شيئا وبالوالدين إحسانا وبذي القربى واليتامى والمساكين والجار ذي القربى والجار الجنب والصاحب بالجنب وابن السبيل وما ملكت أيمانكم إن الله لا يحب من كان مختالا فخورا‏}‏‏.‏ ذي القربى القريب ،‏‏‏‏ والجنب الغريب ،‏‏‏‏ الجار الجنب يعني الصاحب في السفر‏.‏","2545","","Manumission of Slaves"
"2546","حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ ، عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ رَضِيَ ا","Default: Sahih","Book 49"," Hadith 29","2546",""
"2547","حَدَّثَنَا مُحَمَّدُ بْنُ كَثِيرٍ ، أَخْبَرَنَا سُفْيَانُ ، عَنْ صَالِحٍ ، عَنِ الشَّعْبِيِّ ، عَنْ","Default: Sahih","Book 49"," Hadith 30","2547",""
"2548","حَدَّثَنَا بِشْرُ بْنُ مُحَمَّدٍ ، أَخْبَرَنَا عَبْدُ اللَّهِ ، أَخْبَرَنَا يُونُسُ ، عَنِ الزُّهْرِ","Default: Sahih","Book 49"," Hadith 31","2548",""
"2549","حَدَّثَنَا إِسْحَاقُ بْنُ نَصْرٍ ، حَدَّثَنَا أَبُو أُسَامَةَ ، عَنِ الْأَعْمَشِ ، حَدَّثَنَا أَبُو","Default: Sahih","Book 49"," Hadith 32","2549",""
"2550","حَدَّثَنَا مُسَدَّدٌ ، حَدَّثَنَا يَحْيَى ، عَنْ عُبَيْدِ اللَّهِ ، حَدَّثَنِي نَافِعٌ ، عَنْ عَبْدِ","Default: Sahih","takhreej: وقال الله تعالى ‏ {‏ والصالحين من عبادكم وإمائكم‏}‏ وقال ‏ {‏ عبدا مملوكا‏}‏ ‏ {‏ وألفيا سيدها لدى الباب‏}‏ وقال ‏ {‏ من فتياتكم المؤمنات‏}‏ وقال النبي صلى الله عليه وسلم ‏""‏ قوموا إلى سيدكم ‏""‏‏.‏ و‏ {‏ اذكرني عند ربك‏}‏ سيدك ‏""‏ ومن سيدكم ‏""‏‏.‏","2550","","Manumission of Slaves"
"2551","حَدَّثَنَا مُحَمَّدُ بْنُ الْعَلَاءِ ، حَدَّثَنَا أَبُو أُسَامَةَ ، عَنْ بُرَيْدٍ ، عَنْ أَبِي بُرْد","Default: Sahih","Book 49"," Hadith 34","2551",""
"2552","حَدَّثَنَا مُحَمَّدٌ ، حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، أَخْبَرَنَا مَعْمَرٌ ، عَنْ هَمَّامِ بْنِ مُن","Default: Sahih","Book 49"," Hadith 35","2552",""
"2553","حَدَّثَنَا أَبُو النُّعْمَانِ ، حَدَّثَنَا جَرِيرُ بْنُ حَازِمٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ر","Default: Sahih","Book 49"," Hadith 36","2553",""
"2554","حَدَّثَنَا مُسَدَّدٌ ، حَدَّثَنَا يَحْيَى ، عَنْ عُبَيْدِ اللَّهِ ، قَالَ : حَدَّثَنِي نَافِعٌ ، عَن","Default: Sahih","Book 49"," Hadith 37","2554",""
"2555","حَدَّثَنَا مَالِكُ بْنُ إِسْمَاعِيلَ ، حَدَّثَنَا سُفْيَانُ ، عَنِ الزُّهْرِيِّ ، حَدَّثَنِي عُبَيْد","Default: Sahih","Book 49"," Hadith 38","2555",""
"2557","حَدَّثَنَا حَجَّاجُ بْنُ مِنْهَالٍ ، حَدَّثَنَا شُعْبَةُ ، قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ زِيَاد","Default: Sahih","Book 49"," Hadith 39","2557",""
"2558","حَدَّثَنَا أَبُو الْيَمَانِ ، أَخْبَرَنَا شُعَيْبٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : أَخْبَرَنِي سَالِمُ","Default: Sahih","Book 49"," Hadith 40","2558",""
"2559","حَدَّثَنَا مُحَمَّدُ بْنُ عُبَيْدِ اللَّهِ ، حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : حَدَّثَنِي مَالِكُ بْ","Default: Sahih","Book 49"," Hadith 41","2559",""
