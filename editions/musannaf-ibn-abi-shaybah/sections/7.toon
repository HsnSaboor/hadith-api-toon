hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"6013","(۶۰۱۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُصَلِّی بعدہا أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 6013","","","كتاب الجمعة"
"6014","(۶۰۱۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمرَ بْنِ حَمْزَۃَ ، عَنْ شَرِیکِ بْنِ أَبِی نَمِرٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ؛ أَنَّہُ کَانَ یُصَلِّی بَعْدَہَا أَرْبَعًا ، لاَ یُطِیلُ فِیہِنَّ۔","","Musannaf Ibn Abi Shaybah 6014","","","كتاب الجمعة"
"6015","(۶۰۱۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الأَصْبَغِ بْنِ زَیْدٍ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یُصَلِّی بَعْدَہَا أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 6015","","","كتاب الجمعة"
"6016","(۶۰۱۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الأَصْبَغُ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا ثَوْرُ بْنُ یَزِیدَ ، عَمَّنْ أَخْبَرَہُ ؛ أَنَّ أَبَا ذَرٍّ ، قَالَ : صَلِّ بَعْدَ الظُّہْرِ أَرْبَعًا ، فَإِنْ نَسِیتَ الْعَصْرَ کَانَتْ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 6016","","","كتاب الجمعة"
"6017","(۶۰۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُصَلِّی بَعْدَہَا أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 6017","","","كتاب الجمعة"
"6018","(۶۰۱۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ بْنِ ضَمْرَۃَ ، قَالَ : قَالَ نَاسٌ مِنْ أَصْحَابِ عَلِیٍّ لِعَلِیٍّ: أَلاَ تُحَدِّثُنَا بِصَلاَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالنَّہَارِ التَّطَوُّعِ ؟ قَالَ : فَقَالَ عَلِیٌّ : إِنَّکُمْ لَنْ تُطِیقُوہَا۔ قَالَ: فَقَالُوا : أَخْبِرْنَا بِہَا نَأْخُذْ مِنْہَا مَا أَطَقْنَا ۔ قَالَ : فَقَالَ : کَانَ إِذَا ارْتَفَعَتِ الشَّمْسُ مِنْ مَشْرِقِہَا ، فَکَانَتْ کَہَیْئَتِہَا مِنَ الْمَغْرِبِ مِنْ صَلاَۃِ الْعَصْرِ صَلَّی رَکْعَتَیْنِ ، فَإِذَا کَانَتْ مِنَ الْمَشْرِقِ کَہَیْئَتِہَا مِنَ الظُّہْرِ مِنَ الْمَغْرِبِ ، صَلَّی أَرْبَعَ رَکَعَاتٍ ، وَصَلَّی قَبْلَ الظُّہْرِ أَرْبَعَ رَکَعَاتٍ ، وَبَعْدَ الظُّہْرِ رَکْعَتَیْنِ ، وَصَلَّی قَبْلَ الْعَصْرِ أَرْبَعَ رَکَعَاتٍ ، یُسَلِّمُ فِی کُلِّ رَکْعَتَیْنِ عَلَی الْمَلاَئِکَۃِ الْمُقَرَّبِینَ وَالنَّبِیِّینَ وَمَنْ تَبِعَہُمْ مِنَ الْمُؤْمِنِینَ وَالْمُسْلِمِینَ۔ (ترمذی ۴۲۴۔ احمد ۱۴۳)","Hasan","Musannaf Ibn Abi Shaybah 6018","","","كتاب الجمعة"
"6019","(۶۰۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : حفِظْتُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَمَانَ رَکَعَاتٍ ؛ رَکْعَتَیْنِ قَبْلَ الظُّہْرِ ، وَرَکْعَتَیْنِ بَعْدَہَا ، وَرَکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، وَرَکْعَتَیْنِ بَعْدَ الْعِشَائِ ، وَحَدَّثَتْنِی حَفْصَۃُ بِرَکْعَتَیْنِ قَبْلَ الْفَجْرِ۔ (ترمذی ۴۳۲۔ ابوداؤد ۱۲۴۶)","Sahih","Musannaf Ibn Abi Shaybah 6019","","","كتاب الجمعة"
"6020","(۶۰۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ مُغِیرَۃَ بْنِ سَلْمَانَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : حفِظْتُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَشْرَ رَکَعَاتٍ ، فَذَکَرَ مِثْلَ حَدِیثِ جَعْفَرَ ، إِلاَّ أَنَّہُ لَمْ یَقُلْ حَدَّثَتْنِی حَفْصَۃُ۔ (بخاری ۱۱۸۰۔ عبدالرزاق ۴۸۱۱)","Hasan","Musannaf Ibn Abi Shaybah 6020","","","كتاب الجمعة"
"6021","(۶۰۲۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مَیْسَرَۃَ ، وَزَاذَانَ ، قَالاَ : کَانَ عَلِیٌّ یُصَلِّی مِنَ التَّطَوُّعِ أَرْبَعًا قَبْلَ الظُّہْرِ ، وَرَکْعَتَیْنِ بَعْدَہَا ، وَرَکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، وَأَرْبَعًا بَعْدَ الْعِشَائِ ، وَرَکْعَتَیْنِ قَبْلَ الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 6021","","","كتاب الجمعة"
"6022","(۶۰۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : کَانَتْ صَلاَۃُ عَبْدِ اللہِ الَّتِی لاَ یَدَعُ مِنَ التَّطَوُّعِ ؛ أَرْبَعًا قَبْلَ الظُّہْرِ ، وَرَکْعَتَیْنِ بَعْدَہَا ، وَرَکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، وَرَکْعَتَیْنِ بَعْدَ الْعِشَائِ ، وَرَکْعَتَیْنِ قَبْلَ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6022","","","كتاب الجمعة"
"6023","(۶۰۲۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَن ، وَابْنِ سِیرِینَ ؛ أَنَّہُما قَالاَ : التَّطَوعُ عَشَرَ رَکَعَاتٍ ؛ رَکْعَتَیْنِ قَبْلَ الظُّہْرِ ، وَرَکْعَتَیْنِ بَعْدَہَا ، وَرَکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، وَرَکْعَتَیْنِ بَعْدَ الْعِشَائِ ، وَرَکْعَتَیْنِ قَبْلَ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6023","","","كتاب الجمعة"
"6024","(۶۰۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَعُدُّونَ مِنَ السُّنَّۃِ ؛أَرْبَعًا قَبْلَ الظُّہْرِ، وَرَکْعَتَیْنِ بَعْدَہَا ، وَرَکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، وَرَکْعَتَیْنِ بَعْدَ الْعِشَائِ ، وَرَکْعَتَیْنِ قَبْلَ الْفَجْرِ ۔ قَالَ إِبْرَاہِیمُ : وَکَانُوا یَسْتَحِبُّونَ رَکْعَتَیْنِ قَبْلَ الْعَصْرِ ، إِلاَّ أَنَّہُمْ لَمْ یَکُونُوا یَعُدُّونَہَا مِنَ السُّنَّۃِ۔","","Musannaf Ibn Abi Shaybah 6024","","","كتاب الجمعة"
"6025","(۶۰۲۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : کَانَتْ صَلاَۃُ عَبْدِ اللہِ الَّتِی لاَ یَدَعُ ؛ أَرْبَعًا قَبْلَ الظُّہْرِ ، وَرَکْعَتَیْنِ بَعْدَہَا ، وَرَکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، وَرَکْعَتَیْنِ بَعْدَ الْعِشَائِ ، وَرَکْعَتَیْنِ قَبْلَ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6025","","","كتاب الجمعة"
"6026","(۶۰۲۶) حَدَّثَنَا شَرِیکٌ ، عَنْ ہِلاَلِ الْوَزَّانِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا فَاتَتْہُ أَرْبَعٌ قَبْلَ الظُّہْرِ صَلاَّہَا بَعْدَہَا۔ (ترمذی ۴۲۶۔ ابن ماجہ ۱۱۵۸)","","Musannaf Ibn Abi Shaybah 6026","","","كتاب الجمعة"
"6027","(۶۰۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ رَجُلٍ مِنْ بَنِی أَوْدٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : مَنْ فَاتَتْہُ أَرْبَعٌ قَبْلَ الظُّہْرِ صَلاَّہَا بَعْدَہَا۔","","Musannaf Ibn Abi Shaybah 6027","","","كتاب الجمعة"
"6028","(۶۰۲۸) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ ثَابَرَ عَلَی اثْنَتَیْ عَشْرَۃَ رَکْعَۃً مِنَ السُّنَّۃِ بَنَی اللَّہُ لَہُ بَیْتًا فِی الْجَنَّۃِ ؛ أَرْبَعًا قَبْلَ الظُّہْرِ ، وَرَکْعَتَیْنِ بَعْدَہَا ، وَرَکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، وَرَکْعَتَیْنِ بَعْدَ الْعِشَائِ ، وَرَکْعَتَیْنِ قَبْلَ الْفَجْرِ۔ (ترمذی ۴۱۴۔ ابو یعلی ۴۵۰۸)","Hasan","Musannaf Ibn Abi Shaybah 6028","","","كتاب الجمعة"
"6029","(۶۰۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ عَنْبَسَۃَ بْنِ أَبِی سُفْیَانَ ، عَنْ أُمِّ حَبِیبَۃَ ابْنَۃِ أَبِی سُفْیَانَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ صَلَّی فِی یَوْمٍ وَلَیْلَۃٍ ثِنْتَیْ عَشْرَۃَ سَجْدَۃً سِوَی الْمَکْتُوبَۃِ ، بُنِیَ لَہُ بَیْتٌ فِی الْجَنَّۃِ۔ (ترمذی ۴۱۵۔ احمد ۶/۳۲۶)","Sahih","Musannaf Ibn Abi Shaybah 6029","","","كتاب الجمعة"
"6030","(۶۰۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ عَنْبَسَۃَ بْنِ أَبِی سفْیَانَ ، عَنْ أُمِّ حَبِیبَۃَ بِنْتِ أَبِی سُفْیَانَ ، وَلَمْ تَرْفَعْہُ ، قَالَتْ : مَنْ صَلَّی فِی یَوْمٍ ثِنْتَیْ عَشْرَۃَ سِوَی الْمَکْتُوبَۃِ ، بُنِیَ لَہُ بَیْتٌ فِی الْجَنَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 6030","","","كتاب الجمعة"
"6031","(۶۰۳۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ کَعْبٍ ، قَالَ : ثِنْتَا عَشَرَۃَ رَکْعَۃً ، مَنْ صَلاَّہَا فِی یَوْمٍ سِوَی الْمَکْتُوبَۃِ دَخَلَ الْجَنَّۃَ ، أَوْ بُنِیَ لَہُ بَیْتٌ فِی الْجَنَّۃِ ؛ رَکْعَتَانِ قَبْلَ الْغَدَاۃِ ، وَرَکْعَتَانِ مِنَ الضُّحَی ، وَأَرْبَعُ رَکَعَاتٍ قَبْلَ الظُّہْرِ ، وَرَکْعَتَانِ بَعْدَہَا ، وَرَکْعَتَانِ بَعْدَ الْمَغْرِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 6031","","","كتاب الجمعة"
"6032","(۶۰۳۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی عُثْمَانَ ، مَوْلَی الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ: مَا مِنْ عَبْدٍ مُسْلِمٍ یُصَلِّی فِی یَوْمٍ اثْنَتَیْ عَشْرَۃَ رَکْعَۃً ، إِلاَّ بَنَی اللَّہُ لَہُ بَیْتًا فِی الْجَنَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 6032","","","كتاب الجمعة"
"6033","(۶۰۳۳) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ ، عَنْ عَمْرِو بْنِ أَوْسٍ ، عَنْ عَنْبَسَۃَ بْنِ أَبِی سُفْیَانَ ، عَنْ أُمِّ حَبِیبَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی [corrupt]للَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی فِی یَوْمٍ ثِنْتَیْ عَشْرَۃَ سَجْدَۃً تَطَوُّعًا ، بُنِیَ لَہُ بَیْتٌ فِی الْجَنَّۃِ۔ (مسلم ۵۰۳۔ ابوداؤد ۱۲۴۴)","Sahih","Musannaf Ibn Abi Shaybah 6033","","","كتاب الجمعة"
"6034","(۶۰۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُعَرِّفِ بْنِ وَاصِلٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَنْ صَلَّی أَوَّلَ النَّہَارِ ثِنْتَیْ عَشَرَۃَ رَکْعَۃً ، بُنِیَ لَہُ بَیْتٌ فِی الْجَنَّۃِ۔","","Musannaf Ibn Abi Shaybah 6034","","","كتاب الجمعة"
"6035","(۶۰۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ سُلَیْمَانَ الأَصْبَہَانِیُّ ، عَنْ سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَلَّی فِی یَوْمٍ اثْنَتَیْ عَشْرَۃَ رَکْعَۃً ، بُنِیَ لَہُ بَیْتٌ فِی الْجَنَّۃِ ؛ رَکْعَتَیْنِ قَبْلَ الْفَجْرِ ، وَرَکْعَتَیْنِ قَبْلَ الظُّہْرِ ، وَرَکْعَتَیْنِ بَعْدَ الظُّہْرِ ، وَرَکْعَتَیْنِ ، أَظُنُّہُ قَالَ : قَبْلَ الْعَصْرِ ، وَرَکْعَتَیْنِ بَعْدَ الْمَغْرِبِ ، وَأَظُنُّہُ قَالَ : وَرَکْعَتَیْنِ بَعْدَ الْعِشَائِ۔ (ابوداؤد ۱۲۶۳۔ نسائی ۱۴۸۱)","Da'if","Musannaf Ibn Abi Shaybah 6035","","","كتاب الجمعة"
"6036","(۶۰۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الشُّعَیثیُّ، عَنْ أَبِیہِ ، عَنْ عَنْبَسَۃَ بْنِ أَبِی سُفْیَانَ، عَنْ أُمِّ حَبِیبَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ صَلَّی أَرْبَعًا قَبْلَ الظُّہْرِ ،وَأَرْبَعًا بَعْدَہَا حَرَّمَہُ اللَّہُ عَلَی النَّارِ۔","Da'if","Musannaf Ibn Abi Shaybah 6036","","","كتاب الجمعة"
"6037","(۶۰۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ ، قَالَ : لَمَّا حُضِرَ مُعَاذٌ ، قَالَ : لَیْسَ أَحَدٌ یُصَلِّی أَرْبَعَ رَکَعَاتٍ تَطَوُّعَا بَعْدَ صَلاَۃٍ مَکْتُوبَۃٍ ، فَیَلْحَقُہُ یَوْمئِذٍ ذَنْبٌ إِلاَّ الشِّرْکَ بِاللَّہِ ، حَتَّی تَغْرُبَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 6037","","","كتاب الجمعة"
"6038","(۶۰۳۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزَّعْرَائِ؛ أَنَّ أَبَا الأَحْوَص کَانَ لاَ یَرْکَعُ الرَّکْعَتَیْنِ قَبْلَ الْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 6038","","","كتاب الجمعة"
"6039","(۶۰۳۹) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ الْحَسَنُ یُؤَذِّنُ الْمُؤَذِّنُ الْعَصْرَ ، فَلاَ یُصَلِّی حَتَّی یُصَلِّی الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 6039","","","كتاب الجمعة"
"6040","(۶۰۴۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ إِسْمَاعِیلَ ، قَالَ : صَلَّیْتُ مَعَ قَیْسٍ الظُّہْرَ ، ثُمَّ جَلَسَ فَلَمْ یُصَلِّ شَیْئًا حَتَّی صَلَّی الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 6040","","","كتاب الجمعة"
"6041","(۶۰۴۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنِی إِسْمَاعِیلُ ، عَنْ عَامِرٍ ؛ أَنَّہُ سُئِلَ عَنِ الرَّکْعَتَیْنِ قَبْلَ الْعَصْرِ ؟ فَقَالَ: إِنْ کُنْتَ تَعْلَمُ أَنَّک تُصَلِّیہَا قَبْلَ أَنْ یُقِیمَ فَصَلِّ۔","","Musannaf Ibn Abi Shaybah 6041","","","كتاب الجمعة"
"6042","(۶۰۴۲) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا أَبِی ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ لاَ یُصَلِّی قَبْلَ الْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 6042","","","كتاب الجمعة"
"6043","(۶۰۴۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ حَفْصِ بْنِ سُلَیْمَانَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : کَانَ حُذَیْفَۃُ إِذَا فَاتَتْہُ الصَّلاَۃُ فِی مَسْجِدِ قَوْمِہِ ، یُعَلِّقُ نَعْلَیْہِ وَیَتَّبِعُ الْمَسَاجِدَ ، حَتَّی یُصَلِّیَہَا فِی جَمَاعَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6043","","","كتاب الجمعة"
"6044","(۶۰۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ؛ أَنَّہُ کَانَ إِذَا فَاتَتْہُ الصَّلاَۃُ فِی مَسْجِدِ قَوْمِہِ ، ذَہَبَ إِلَی مَسْجِدٍ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 6044","","","كتاب الجمعة"
"6045","(۶۰۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الرَّبِیعِ بْنِ أَبِی رَاشِدٍ ، قَالَ : جَائَنَا سَعِیدُ بْنُ جُبَیْرٍ وَنَحْنُ فِی آخِرِ الصَّلاَۃ ، فَسَمِعَ مُؤَذِّنًا فَأَتَاہُ۔","","Musannaf Ibn Abi Shaybah 6045","","","كتاب الجمعة"
"6046","(۶۰۴۶) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِذَا فَاتَتْک الصَّلاَۃ فِی مَسْجِدِکَ ، فَلاَ تَتَّبِعِ الْمَسَاجِدَ ، صَلِّ فِی مَسْجِدِک۔","","Musannaf Ibn Abi Shaybah 6046","","","كتاب الجمعة"
"6047","(۶۰۴۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا فَاتَتِ الرَّجُلُ الصَّلاَۃ فِی مَسْجِدِ قَوْمِہِ لَمْ یَتَّبِعِ الْمَسَاجِدَ۔","","Musannaf Ibn Abi Shaybah 6047","","","كتاب الجمعة"
"6048","(۶۰۴۸) حَدَّثَنَا جَرِیرٌ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : کَانَ تَفُوتُہُ الصَّلاَۃ فِی مَسْجِدِ قَوْمِہِ ، فَیَجِیئُ إِلَی الْمَسْجِدِ فَیَدْخُلُہُ ، فَیُصَلِّی فِیہِ وَہُوَ یَسْمَعُ الأَذَانَ مِنَ الْمَسْجِدِ فَلاَ یَأْتِیہِمْ۔","","Musannaf Ibn Abi Shaybah 6048","","","كتاب الجمعة"
"6049","(۶۰۴۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ السَّرِیِّ بْنِ یَحْیَی ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ تَفُوتُہُ الصَّلاَۃ فِی مَسْجِدِ قَوْمِہِ ، فَیَأْتِی مَسْجِدًا آخَرَ ؟ فَقَالَ الْحَسَنُ : مَا رَأَیْنَا الْمُہَاجِرِینَ یَفْعَلُونَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 6049","","","كتاب الجمعة"
"6050","(۶۰۵۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ : لاَ یُصَلَّی بَعْدَ الصَّلاَۃِ مِثْلُہَا۔","","Musannaf Ibn Abi Shaybah 6050","","","كتاب الجمعة"
"6051","(۶۰۵۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَابْنُ إِدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن سُلَیْمَانَ بْنِ مُسْہِرٍ ، عَنْ خَرَشَۃَ ، قَالَ : کَانَ عُمَرُ یَکْرَہُ أَنْ یُصَلَّی خَلْفَ صَلاَۃٍ مِثْلُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 6051","","","كتاب الجمعة"
"6052","(۶۰۵۲) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ ، وَالشَّعْبِیِّ ، قَالاَ : قَالَ عَبْدُ اللہِ : لاَ یُصَلَّی عَلَی إِثْرِ صَلاَۃٍ مِثْلُہَا۔","","Musannaf Ibn Abi Shaybah 6052","","","كتاب الجمعة"
"6053","(۶۰۵۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ أَصْحَابِ عَبْدِ اللہِ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُصَلَّی بَعْدَ الْمَکْتُوبَۃِ مِثْلُہَا۔","Da'if","Musannaf Ibn Abi Shaybah 6053","","","كتاب الجمعة"
"6054","(۶۰۵۴) حَدَّثَنَا سَلاَّم أَبُو الأَحْوَصِ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ یَکْرَہُ أَنْ یُصَلَّی بَعْدَ الْمَکْتُوبَۃِ مِثْلُہَا۔","Da'if","Musannaf Ibn Abi Shaybah 6054","","","كتاب الجمعة"
"6055","(۶۰۵۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یُصَلُّوا بَعْدَ الْمَکْتُوبَۃِ مِثْلَہَا۔","","Musannaf Ibn Abi Shaybah 6055","","","كتاب الجمعة"
"6056","(۶۰۵۶) حَدَّثَنَا ہُشَیْمٌ، عَنِ الْعَوَّامِ، قَالَ: حَدَّثَنَا الْمُسَیَّبُ بْنِ رَافِعٍ ، قَالَ: کَانُوا یَکْرَہُونَ أَنْ یُصَلُّوا بَعْدَ الْمَکْتُوبَۃِ مِثْلَہَا۔","","Musannaf Ibn Abi Shaybah 6056","","","كتاب الجمعة"
"6057","(۶۰۵۷) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الأَعْمَشِ ، عَنْ سُلَیْمَانَ بْنِ مُسْہِرٍ ، عَنْ خَرَشَۃَ بْنِ الْحُرِّ ، عَنْ عُمَرَ ؛ أَنَّہُ کَرِہَ أَنْ یُصَلَّی بَعْدَ الْمَکْتُوبَۃِ مِثْلُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 6057","","","كتاب الجمعة"
"6058","(۶۰۵۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مِہْرَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَعْدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الأَبْعَدُ فَالأَبْعَدُ مِنَ الْمَسْجِدِ ، أَعْظَمُ أَجْرًا۔ (ابوداؤد ۵۵۷۔ احمد ۲/۳۵۱)","Hasan","Musannaf Ibn Abi Shaybah 6058","","","كتاب الجمعة"
"6059","(۶۰۵۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الأَسْوَدِ بْنِ الْعَلاَئِ بْنِ جَارِیَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِنْ حِینِ یَخْرُجُ أَحَدُکُمْ مِنْ مَسْجِدِہِ إِلَی بَیْتِہِ ، فَرِجْلٌ تَکْتُبُ لَہُ حَسَنَۃً ، وَالأُخْرَی تَحُطُّ عَنْہُ سَیِّئَۃً۔ (احمد ۲/۴۷۸۔ ابن حبان ۱۶۲۲)","","Musannaf Ibn Abi Shaybah 6059","","","كتاب الجمعة"
"6060","(۶۰۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَخِیہِ ، عَنْ جَابِرٍ ، قَالَ : کَانَتْ مَنَازِلُنَا قَاصِیَۃً ، فَأَرَدْنَا أَنْ نَتَقَرَّبَ مِنْ مَسْجِدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَذَکَرْنَا ذَلِکَ لَہُ ، فَقَالَ : لاَ تَفْعَلُوہَا ، ائْتُوہَا کَمَا کُنْتُمْ ، مَا مِنْ مُؤْمِنٍ یَتَوَضَّأُ فَیُحْسِنُ الْوُضُوئَ ، ثُمَّ یَخْرُجُ إِلَی الْمَسْجِدِ ، إِلاَّ کَتَبَ اللَّہُ لَہُ بِکُلِّ خُطْوَۃٍ حَسَنَۃً ، وَحَطَّ عَنْہُ بِہَا سَیِّئَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 6060","","","كتاب الجمعة"
"6061","(۶۰۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ الطَّوِیلُ ، عَنْ أَنَسِ بْنِ مَالِکٍ ؛ أَنَّ بَنِی سَلِمَۃَ أَرَادُوا أَنْ یَتَحَوَّلُوا عَنْ مَنَازِلِہِمْ ، فَیَبنوا قَرِیبًا مِنَ الْمَسْجِدِ ، فَکَرِہَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُعْرَی الْمَدِینَۃُ ، فَقَالَ : یَا بَنِی سَلِمَۃَ ، أَلاَ تَحْتَسِبُونَ آثَارَکُمْ ؟ قَالُوا : بَلَی ، فَثَبَتُوا۔ (بخاری ۶۵۵۔ احمد ۳/۱۰۶)","Sahih","Musannaf Ibn Abi Shaybah 6061","","","كتاب الجمعة"
"6062","(۶۰۶۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ بَنِی سَلِمَۃَ کَانَتْ دُورُہُمْ قَاصِیَۃً عَنِ الْمَسْجِدِ ، فَہَمُّوا أَنْ یَتَحَوَّلُوا قَرِیبًا مِنَ الْمَسْجِدِ ، فَیَشْہَدُونَ الصَّلاَۃَ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ لَہُم النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلاَ تَحْتَسِبُونَ آثَارَکُمْ یَا بَنِی سَلِمَۃَ ؟ فَثَبَتُوا فِی دِیَارِہِمْ۔","","Musannaf Ibn Abi Shaybah 6062","","","كتاب الجمعة"
"6063","(۶۰۶۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ ، عَنْ أُبَیِّ بْنِ کَعْبٍ ، قَالَ : کَانَ رَجُلٌ بِالْمَدِینَۃِ ، مَا أَعْلَمُ أَحَدًا مِنْ أَہْلِ الْمَدِینَۃِ مِمَّنْ یُصَلِّی الْقِبْلَۃَ أَبْعَدَ مَنْزِلاً مِنَ الْمَسْجِدِ مِنْہُ ، فَکَانَ یَشْہَدُ الصَّلاَۃَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقِیلَ : لو ابْتَغَیْتَ حِمَارًا تَرْکَبُہُ فِی الرَّمْضَائِ وَالظُّلْمَۃِ ؟ فَقَالَ: وَاللَّہِ مَا یَسُرُّنِی أَنَّ مَنْزِلِی بِلَزْقِ الْمَسْجِدِ ، فَذُکِرَ ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ، کَیْمَا یُکْتَبُ خُطَایَ وَإِقْبَالِی ، وَإِدْبَارِی ، وَرُجُوعِی إِلَی أَہْلِی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنْطَاکَ اللَّہُ ذَلِکَ ، وَأَعْطَاک مَا احْتَسَبْت أَجْمَعَ ، أَوْ کَمَا قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔(مسلم ۴۶۰۔ ابوداؤد ۵۵۸)","Sahih","Musannaf Ibn Abi Shaybah 6063","","","كتاب الجمعة"
"6064","(۶۰۶۴) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، قَالَ : سَأَلْتُ ابْنَ أَبِی لَیْلَی ، فَقُلْتُ : بَنُو سَلِمَۃَ أَرَادُوا أَنْ یَتَحَوَّلُوا قَرِیبًا مِنَ الْمَسْجِدِ ؟ فَذُکِرَ عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَإِنَّ بِکُلِّ خُطْوَۃٍ حَسَنَۃً۔ (مسلم ۴۶۱)","Da'if","Musannaf Ibn Abi Shaybah 6064","","","كتاب الجمعة"
"6065","(۶۰۶۵) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن لَیْثٍ ، عَنِ الْحَجَّاجِ بْنِ عُبَیْدٍ ، عَنْ إِبْرَاہِیمَ بْنِ إِسْمَاعِیلَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَیَعْجَزُ أَحَدُکُمْ إِذَا صَلَّی أَنْ یَتَقَدَّمَ ، أَوْ یَتَأَخَّرَ ، أَوْ عَنْ یَمِینِہِ ، أَوْ عَنْ شِمَالِہِ ، یَعْنِی السَّبْحَۃَ۔ (ابوداؤد ۹۹۸۔ احمد ۲/۴۲۵)","Da'if","Musannaf Ibn Abi Shaybah 6065","","","كتاب الجمعة"
"6066","(۶۰۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَطَائٍ ، عَن ابْنِ عَبَّاسٍ ، قَالَ : یَتَقَدَّمَ ، أَوْ یَتَأَخَّرَ۔","Sahih","Musannaf Ibn Abi Shaybah 6066","","","كتاب الجمعة"
"6067","(۶۰۶۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیِہِ ، عَنْ رَجُلٍ ، عَنْ عَطَائٍ ؛ أَنَّ ابْنَ عَبَّاسٍ ، وَابْنَ الزُّبَیْرِ وَأَبَا سَعِیدٍ ، وَابْنَ عُمَرَ ، کَانُوا یَقُولُونَ : لاَ یَتَطَوَّعُ حَتَّی یَتَحَوَّلَ مِنْ مَکَانِہِ الَّذِی صَلَّی فِیہِ الْفَرِیضَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 6067","","","كتاب الجمعة"
"6068","(۶۰۶۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ یَتَطَوَّعُ حَتَّی یَنْہَزَ خُطْوَۃً ، أَوْ خُطْوَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6068","","","كتاب الجمعة"
"6069","(۶۰۶۹) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ أَبِی إِذَا صَلَّی الْمَکْتُوبَۃَ نَکَّبَ عَنْ مَکَانِہِ فَسَبَّحَ۔","","Musannaf Ibn Abi Shaybah 6069","","","كتاب الجمعة"
"6070","(۶۰۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی بَحْرٍ ، عَنْ شَیْخٍ ، قَالَ : سُئِلَ ابْنُ مَسْعُودَ عَنِ الرَّجُلِ یُصَلِّی فِی مَکَانِہِ الَّذِی صَلَّی فِیہِ الْفَرِیضَۃَ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 6070","","","كتاب الجمعة"
"6071","(۶۰۷۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُصَلِّی سُبْحَتَہُ مَکَانَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 6071","","","كتاب الجمعة"
"6072","(۶۰۷۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : رَأَیْتُ الْقَاسِمَ ، وَسَالِمًا یُصَلِّیَانِ الْفَرِیضَۃَ ، ثُمَّ یَتَطَوَّعَانِ فِی مَکَانِہِمَا۔ قَالَ : وَأَنْبَأَنِی نَافِعٌ ؛ أَنَّ ابْنَ عُمَرَ کَانَ لاَ یَرَی بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 6072","","","كتاب الجمعة"
"6073","(۶۰۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، قَالَ: سَأَلْتُ عَطَائً عَنِ الرَّجُلِ یَتَطَوَّعُ فِی مَکَانِہِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 6073","","","كتاب الجمعة"
"6074","(۶۰۷۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا یُصَلِّیَانِ التَّطَوُّعَ فِی مَکَانِہِمَا الَّذِی یُصَلِّیَانِ فِیہِ الْفَرِیضَۃَ۔","","Musannaf Ibn Abi Shaybah 6074","","","كتاب الجمعة"
"6075","(۶۰۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : غَیْرُ الإِمَامِ إِنْ شَائَ لَمْ یَتَحَوَّلْ۔","","Musannaf Ibn Abi Shaybah 6075","","","كتاب الجمعة"
"6076","(۶۰۷۶) حَدَّثَنَا شَرِیکٌ ، عَنْ مَیْسَرَۃَ ، عَنِ الْمِنْہَالِ ، عَنْ عَبَّاد بْنِ عَبْدِ اللہِ ، عَنْ عَلِیٍّ ، قَالَ : إِذَا سَلَّمَ الإِمَامُ لَمْ یَتَطَوَّعْ حَتَّی یَتَحَوَّلَ مِنْ مَکَانِہِ ، أَوْ یَفْصِلَ بَیْنَہُمَا بِکَلاَمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6076","","","كتاب الجمعة"
"6077","(۶۰۷۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَرِہَ إِذَا صَلَّی الإِمَامُ أَنْ یَتَطَوَّعَ فِی مَکَانِہِ ، وَلَمْ یَرَ بِہِ لِغَیْرِ الإِمَامِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 6077","","","كتاب الجمعة"
"6078","(۶۰۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ؛ أَنَّہُ کَرِہَ لِلإِمَامِ أَنْ یُصَلِّیَ فِی مَکَانِہِ الَّذِی صَلَّی فِیہِ الْفَرِیضَۃَ۔","","Musannaf Ibn Abi Shaybah 6078","","","كتاب الجمعة"
"6079","(۶۰۷۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ أَبِی لَیْلَی ؛ أَنَّہُ کَانَ یَسْتَحِبُّ لِلإِمَامِ إِذَا صَلَّی أَنْ لاَ یَتَطَوَّعَ فِی مَکَانِہِ الَّذِی صَلَّی فِیہِ ۔ أَوَ قَالَ : کَانَ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 6079","","","كتاب الجمعة"
"6080","(۶۰۸۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ؛ أَنَّہُمَا کَانَا یُعْجِبُہُمَا إِذَا سَلَّمَ الإِمَامُ أَنْ یَتَقَدَّمَ۔","","Musannaf Ibn Abi Shaybah 6080","","","كتاب الجمعة"
"6081","(۶۰۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُکْرَہُ لِلإِمَامِ أَنْ یَتَطَوَّعَ فِی مَکَانِہِ الَّذِی صَلَّی فِیہِ الْفَرِیضَۃَ۔","","Musannaf Ibn Abi Shaybah 6081","","","كتاب الجمعة"
"6082","(۶۰۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَیْسَرَۃَ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَنْ عَبَّادِ بْنِ عَبْدِ اللہِ ، عَنْ عَلِیٍّ ، قَالَ: لاَ یَتَطَوَّعُ الإِمَامُ فِی الْمَکَانِ الَّذِی أَمَّ فِیہِ الْقَوْمَ حَتَّی یَتَحَوَّلَ ، أَوْ یَفْصِلَ بِکَلاَمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6082","","","كتاب الجمعة"
"6083","(۶۰۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الإِمَام یَتَحَوَّلُ۔","","Musannaf Ibn Abi Shaybah 6083","","","كتاب الجمعة"
"6084","(۶۰۸۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا صَلَّی الإِمَام الْمَکْتُوبَۃَ ، ثُمَّ أَرَادَ أَنْ یُصَلِّیَ التَّطَوُّعَ، تَنَحَّی مِنْ مَکَانِہِ الَّذِی صَلَّی فِیہِ الْفَرِیضَۃَ۔","","Musannaf Ibn Abi Shaybah 6084","","","كتاب الجمعة"
"6085","(۶۰۸۵) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ خَالِدٍ، عَنْ أَبِی قِلاَبَۃَ، قَالَ: کَانُوا یَسْتَحِبُّونَ أَنْ یَتَقَدَّمُوا فِی الصَّلاَۃ، وَلاَ یَتَأَخَّرُوا۔","","Musannaf Ibn Abi Shaybah 6085","","","كتاب الجمعة"
"6086","(۶۰۸۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِمُحَمَّدٍ : الرَّجُلُ یَتَقَدَّمُ إِلَی الصَّفِّ فِی الصَّلاَۃ؟ قَالَ: لاَ أَعْلَمُ بَأْسًا أَنْ یَتَقَدَّمَ خُطْوَۃً ، أَوْ خُطْوَتَیْنِ ۔ وَقَالَ فِی الَّذِی یَصِل الصَّفَّ مُعْتَرِضًا : لاَ أَدْرِی مَا ہُوَ ؟۔","","Musannaf Ibn Abi Shaybah 6086","","","كتاب الجمعة"
"6087","(۶۰۸۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَکُونُ مَعَہُ الشَّیئُ فَیَضَعُہُ فَیُصَلِّیَ ، ثُمَّ یَبْدُو لَہُ أَنْ یَتَقَدَّمَ ، قَالَ : لاَ بَأْسَ أَنْ یَأْخُذَہُ ، ثُمَّ یَتَقَدَّمَ۔","","Musannaf Ibn Abi Shaybah 6087","","","كتاب الجمعة"
"6088","(۶۰۸۸) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، وَسُفْیَانَ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ، عَن عُرْوَۃَ، قَالَ: کَانَ یُقَالُ: تَقَدَّمُوا، تَقَدَّمُوا۔","","Musannaf Ibn Abi Shaybah 6088","","","كتاب الجمعة"
"6089","(۶۰۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إِسْمَاعِیلَ بْنِ سَالِمٍ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنْ رَجُلٍ کَانَ یُصَلِّی وَبَیْنَ یَدَیْہِ قَوْمٌ یُصَلُّونَ ، فَانْصَرَفُوا ؟ قَالَ : یَتَقَدَّمُ إِلَی الْحَائِطِ بَیْنَ یَدَیْہِ ۔ قَالَ : قُلْتُ : أَفَیَقْرَأُ وَہُوَ یَمْشِی ؟ قَالَ : لاَ ، حَتَّی یَنْتَہِیَ إِلَی الْمَکَانِ الَّذِی یَقُومُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 6089","","","كتاب الجمعة"
"6090","(۶۰۹۰) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ ثَابِتٍ الْبُنَانِیِّ ، عَنِ ابْنِ أَبِی لَیْلَی ، عن أَبِی لَیْلَی ، قَالَ : صَلَّیْتُ إِلَی جَنْبِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یُصَلِّی بِاللَّیْلِ تَطَوُّعًا ، فَمَرَّ بِآیَۃٍ ، فَقَالَ : أَعُوذُ بِاللَّہِ مِنَ النَّارِ، وَوَیْلٌ لأَہْلِ النَّارِ۔ (ابوداؤد ۸۷۷۔ احمد ۴/۳۴۷)","Da'if","Musannaf Ibn Abi Shaybah 6090","","","كتاب الجمعة"
"6091","(۶۰۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا مَرَّتْ بِہَذِہِ الأَیَۃِ : {فَمَنَّ اللَّہُ عَلَیْنَا وَوَقَانَا عَذَابَ السَّمُومِ}فَقَالَتْ : اللَّہُمَّ مُنَّ عَلَیْنَا وَقِنَا عَذَابَ السَّمُومِ ، إِنَّک أَنْتَ الْبَرُّ الرَّحِیمُ۔ فَقِیلَ لِلأَعْمَشِ : فِی الصَّلاَۃِ ؟ فَقَالَ : فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 6091","","","كتاب الجمعة"
"6092","(۶۰۹۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَبْدِ الْوَہَّابِ ، عَنْ جَدِّہِ عَبَّادِ بْنِ حَمْزَۃَ ، قَالَ : دَخَلْتُ عَلَی أَسْمَائَ وَہِیَ تَقْرَأُ : {فَمَنَّ اللَّہُ عَلَیْنَا وَوَقَانَا عَذَابَ السَّمُومِ} قَالَ : فَوَقَفَتْ عَلَیْہَا ، فَجَعَلَتْ تَسْتَعِیذُ وَتَدْعُو ۔ قَالَ عَبَّادُ : فَذَہَبْتُ إِلَی السُّوقِ ، فَقَضَیْتُ حَاجَتِی ، ثُمَّ رَجَعْتُ ، وَہِیَ فِیہَا بَعْدُ تَسْتَعِیذُ وَتَدْعُو۔","Hasan","Musannaf Ibn Abi Shaybah 6092","","","كتاب الجمعة"
"6093","(۶۰۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : إِذَا مَرَّ أَحَدُکُمْ فِی الصَّلاَۃ بِذِکْرِ النَّارِ ، فَلْیَسْتَعِذْ بِاللَّہِ مِنَ النَّارِ ، وَإِذَا مَرَّ بِذِکْرِ الْجَنَّۃِ ، فَلْیَسْأَلِ اللَّہَ الْجَنَّۃَ۔","","Musannaf Ibn Abi Shaybah 6093","","","كتاب الجمعة"
"6094","(۶۰۹۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا إِذَا مَرَّ بِآیَۃٍ أَنْ یَسْأَلَ ، وَأَنَّ ابْنَ سِیرِینَ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 6094","","","كتاب الجمعة"
"6095","(۶۰۹۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ الْمُسْتَوْرِدِ بْنِ الأَحْنَفِ ، عَنْ صِلَۃ ، عَنْ حُذَیْفَۃَ ، قَالَ : صَلَّیْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَکَانَ إِذَا مَرَّ بِآیَۃٍ فِیہَا تَسْبِیحٌ سَبَّحَ ، وَإِذَا مَرَّ بِسُؤَالٍ سَأَلَ ، وَإِذَا مَرَّ بِتَعَوُّذٍ تَعَوَّذَ۔","Sahih","Musannaf Ibn Abi Shaybah 6095","","","كتاب الجمعة"
"6096","(۶۰۹۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : أَسْمَعُ الرَّجُلَ وَأَنَا أُصَلِّی یَقُولُ : {إِنَّ اللَّہَ وَمَلاَئِکَتَہُ یُصَلُّونَ عَلَی النَّبِیِّ} ، أَأُصَلِّی عَلَیْہِ ؟ قَالَ : نَعَمْ ، إِنْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 6096","","","كتاب الجمعة"
"6097","(۶۰۹۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا قَالَ الرَّجُلُ فِی الصَّلاَۃ : {إِنَّ اللَّہَ وَمَلاَئِکَتَہُ یُصَلُّونَ عَلَی النَّبِیِّ ، یَا أَیُّہَا الَّذِینَ آمَنُوا صَلُّوا عَلَیْہِ وَسَلِّمُوا تَسْلِیمَا} ، فَلْیُصَلِّ عَلَیْہِ۔ قَالَ: وَقَالَ ابْنُ سِیرِینَ : کَانُوا إِذَا قَرَؤُوا الْقُرْآنَ لَمْ یَخْلِطُوا بِہِ مَا لَیْسَ مِنْہُ ، وَیَمْضُونَ کَمَا ہُمْ۔","","Musannaf Ibn Abi Shaybah 6097","","","كتاب الجمعة"
"6098","(۶۰۹۸) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : قُلْتُ لَہُ : الرَّجُلُ یَمُرُّ بِہَذِہِ الآیَۃِ فِی الصَّلاَۃ : {إِنَّ اللَّہَ وَمَلاَئِکَتَہُ یُصَلُّونَ عَلَی النَّبِیِّ} ، أَیُصَلِّی عَلَیْہِ ؟ قَالَ : یَمُرُّ۔","","Musannaf Ibn Abi Shaybah 6098","","","كتاب الجمعة"
"6099","(۶۰۹۹) حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ ، وَعَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ؛ فِی الْحَامِلِ تَرَی الدَّمَ ، لاَ یَمْنَعُہَا ذَلِکَ مِنَ الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 6099","","","كتاب الجمعة"
"6100","(۶۱۰۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَامِعِ بْنِ أَبِی رَاشِدٍ، عَنْ عَطَائٍ؛ فِی الْحَامِلِ تَرَی الدَّمَ، قَالَ: تَوَضَّأُ وَتُصَلِّی۔","","Musannaf Ibn Abi Shaybah 6100","","","كتاب الجمعة"
"6101","(۶۱۰۱) حَدَّثَنَا إِسْمَاعِیلُ ، عَنْ أَیُّوبَ ، قَالَ: کَتَبْتُ إِلَی نَافِعٍ أَسْأَلُہُ عَنِ الْحَامِلِ تَرَی الدَّمَ ؟ فَکَتَبَ إِلَیَّ : سَأَلْتُ سُلَیْمَانَ بْنَ یَسَارٍ عَنِ الْمَرْأَۃِ تَرَی الدَّمَ فِی غَیْرِ حَیْضٍ ، وَلاَ نِفَاسٍ؟ فَقَالَ: تَغْتَسِلُ ، وَتَسْتَثْفِرُ بِثَوْبٍ ، وَتُصَلِّی۔","","Musannaf Ibn Abi Shaybah 6101","","","كتاب الجمعة"
"6102","(۶۱۰۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ لَیْثٍ، عَنِ الشَّعْبِیِّ، وَعَطَائٍ؛ فِی الْحُبْلَی تَرَی الدَّمَ عَبِیطًا ، تَغْتَسِلُ وَتُصَلِّی۔","","Musannaf Ibn Abi Shaybah 6102","","","كتاب الجمعة"
"6103","(۶۱۰۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ یُونُسَ، عَنِ الْحَسَنِ؛ فِی الْحَامِلِ تَرَی الدَّمَ، قَالَ: تَصْنَعُ کَمَا تَصْنَعُ الْمُسْتَحَاضَۃُ۔","","Musannaf Ibn Abi Shaybah 6103","","","كتاب الجمعة"
"6104","(۶۱۰۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْحَامِلِ تَرَی الدَّمَ ، قَالَ : إِنْ کَانَتْ تَرَاہُ کَمَا کَانَتْ تَرَاہُ قَبْلَ ذَلِکَ فِی أَقْرَائِہَا ؛ تَرَکَتِ الصَّلاَۃ ، وَإِنْ کَانَ إِنَّمَا ہُوَ فِی الْیَوْمِ وَالْیَوْمَیْنِ ، لَمْ تَدَعِ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6104","","","كتاب الجمعة"
"6105","(۶۱۰۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ الْحَکَمِ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا رَأَتْہُ وَہِیَ حُبْلَی فَلْتَوَضَّأْ وَلْتُصَلِّ ، فَإِنَّہُ لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 6105","","","كتاب الجمعة"
"6106","(۶۱۰۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ فِی الْحَامِلِ تَرَی الدَّمَ ، قَالَ : لَیْسَ بِشَیْئٍ۔ وَقَالَ حَمَّادٌ : ہِیَ بِمَنْزِلَۃِ الْمُسْتَحَاضَۃِ۔","","Musannaf Ibn Abi Shaybah 6106","","","كتاب الجمعة"
"6107","(۶۱۰۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنِ الْحَامِلِ تَرَی الدَّمَ ، أَیَمْنَعُہَا ذَلِکَ مِنَ الصَّلاَۃ ؟ فَقَالَ : إِنَّمَا یَمْنَعُ مِنَ الصَّلاَۃ وَالصَّوْمِ ؛ الْحَیْضُ ، وَہَذَا الْغَیْضُ۔","","Musannaf Ibn Abi Shaybah 6107","","","كتاب الجمعة"
"6108","(۶۱۰۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ عَنِ الْحَامِلِ تَرَی الدَّمَ ؟ قَالَ : تَکُفُّ عَنِ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6108","","","كتاب الجمعة"
"6109","(۶۱۰۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مِنْدَلٍ ، عَنِ ابْنِ أَبِی إِسْحَاقَ ، عَنْ عِکْرِمَۃَ ، وَالْحَکَمِ ، وَحَمَّادٍ ؛ قَالُوا : لاَ یَجْتَمِعُ حَبَلٌ وَحَیْضٌ ، فَإِذَا رَأَتِ الْحَامِلُ الدَّمَ فَلْتُصَلِّ۔","","Musannaf Ibn Abi Shaybah 6109","","","كتاب الجمعة"
"6110","(۶۱۱۰) حَدَّثَنَا ہُشَیْمٌ، عَنْ یُونُسَ، عَنِ الْحَسَنِ؛ أَنَّہُ کَانَ یَقُولُ: إِذَا رَأَتِ الدَّمَ عَلَی الْوَلَدِ ،أَمْسَکَتْ عَنِ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6110","","","كتاب الجمعة"
"6111","(۶۱۱۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی الْمَرْأَۃِ تَرَی الدَّمَ وَہِیَ تُطْلَقُ ، قَالَ : تَصْنَعُ مَا تَصْنَعُ الْمُسْتَحَاضَۃُ۔","","Musannaf Ibn Abi Shaybah 6111","","","كتاب الجمعة"
"6112","(۶۱۱۲) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنِ الْحَسَنِ بْنِ الْحَکَمِ، عَنِ الْحَکَمِ، عَنْ إِبْرَاہِیمَ؛ فِی الْمَرْأَۃِ تَرَی الدَّمَ وَہِیَ تَمْخُضُ، قَالَ : ہُوَ حَیْضٌ لاَ تُصَلِّی۔","","Musannaf Ibn Abi Shaybah 6112","","","كتاب الجمعة"
"6113","(۶۱۱۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہَمَّامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا رَأَتِ الدَّمَ عَلَی رَأْسِ الْوَلَدِ ، أَمْسَکَتْ عَنِ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6113","","","كتاب الجمعة"
"6114","(۶۱۱۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی بَدْرٍ ، فَاسْتَخْلَفَ ابْنَ أُمِّ مَکْتُومٍ عَلَی الْمَدِینَۃِ ، فَکَانَ یَؤُمُّہُمْ وَہُوَ أَعْمَی۔","Da'if","Musannaf Ibn Abi Shaybah 6114","","","كتاب الجمعة"
"6115","(۶۱۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اسْتَخْلَفَ ابْنَ أُمِّ مَکْتُومٍ ، فَکَانَ یَؤُمُّ النَّاسَ وَہُوَ أَعْمَی۔ (ابوداؤد ۵۹۵۔ احمد ۳/۱۹۲)","","Musannaf Ibn Abi Shaybah 6115","","","كتاب الجمعة"
"6116","(۶۱۱۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ أُنَاسًا مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانُوا یَؤُمُّونَ وَہُمْ عُمْیَانٌ مِنْہُمْ ؛ عِتْبَانُ بْنُ مَالِکٍ ، وَمُعَاذُ بْنُ عَفْرَائَ ، وَابْنُ أُمِّ مَکْتُومٍ۔","","Musannaf Ibn Abi Shaybah 6116","","","كتاب الجمعة"
"6117","(۶۱۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ نَاسٌ مِنْ أَہْلِ بَدْرٍ یَؤُمُّونَ فِی مَسَاجِدِہِمْ ، بَعْدَ مَا ذَہَبَتْ أَبْصَارُہُمْ۔","","Musannaf Ibn Abi Shaybah 6117","","","كتاب الجمعة"
"6118","(۶۱۱۸) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : دَخَلْنَا عَلَی جَابِرِ بْنِ عَبْدِ اللہِ وَہُوَ أَعْمَی ، فَجَائَ وَقْتُ الصَّلاَۃ ، فَقَامَ فِی نِسَاجَۃٍ مُلْتَحِفًا بِہَا ، کُلَّمَا وَضَعَہَا عَلَی مَنْکِبَیْہِ رَجَعَ طَرَفَاہَا إِلَیْہِ مِنْ صِغَرِہَا ، وَرِدَاؤُہُ إِلَی جَنْبِہِ عَلَی الْمِشْجَبِ ، فَصَلَّی بِنَا۔ (مسلم ۱۴۷)","Sahih","Musannaf Ibn Abi Shaybah 6118","","","كتاب الجمعة"
"6119","(۶۱۱۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی عَامِرٍ ؛ أَنَّ رَجُلاً سَأَلَ الْحَسَنَ ، أَؤُمُّ قَوْمِی وَأَنَا أَعْمَی ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 6119","","","كتاب الجمعة"
"6120","(۶۱۲۰) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ؛ سُئِلَ عَنِ الأَعْمَی یَؤُمُّ؟ قَالَ: فَقَالَ: إِذَا کَانَ أَفْقَہَہُمْ۔","","Musannaf Ibn Abi Shaybah 6120","","","كتاب الجمعة"
"6121","(۶۱۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَؤُمَّ الأَعْمَی۔","","Musannaf Ibn Abi Shaybah 6121","","","كتاب الجمعة"
"6122","(۶۱۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مُہَاجِرٍ ، قَالَ : کَانَ الْبَرَائُ یُصَلِّی بِنَا وَہُوَ أَعْمَی۔","Da'if","Musannaf Ibn Abi Shaybah 6122","","","كتاب الجمعة"
"6123","(۶۱۲۳) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : أَمَّنَا ابْنُ عَبَّاسٍ وَہُوَ أَعْمَی۔","Da'if","Musannaf Ibn Abi Shaybah 6123","","","كتاب الجمعة"
"6124","(۶۱۲۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنِ ابْنٍ لَعُمَیرٍ ، عَنْ أَبِیہِ ؛ أَنَّ رَجُلاً أَعْمَی کَانَ یَؤُمُّ بَنِی خَطْمَۃَ فِی زَمَنِ عُمَرَ۔","","Musannaf Ibn Abi Shaybah 6124","","","كتاب الجمعة"
"6125","(۶۱۲۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ مَحْمُودِ بْنِ رَبِیعٍ ، عَنْ عِتْبَانَ بْنِ مَالِکٍ ؛ أَنَّہُ کَانَ یَؤُمُّ قَوْمَہُ وَہُوَ أَعْمَی۔","Sahih","Musannaf Ibn Abi Shaybah 6125","","","كتاب الجمعة"
"6126","(۶۱۲۶) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا مَالِکُ بْنُ أَنَسٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ مَحْمُودِ بْنِ الرَّبِیعِ ، عَنْ عِتْبَانَ بْنِ مَالِکٍ ؛ أَنَّہُ کَانَ یَؤُمُّ قَوْمَہُ وَہُوَ أَعْمَی۔ (بخاری ۶۶۷۔ نسائی ۸۶۳)","Hasan","Musannaf Ibn Abi Shaybah 6126","","","كتاب الجمعة"
"6127","(۶۱۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، قَالَ : کَانَ إِمَامُ بَنِی خَطْمَۃَ أَعْمَی۔","","Musannaf Ibn Abi Shaybah 6127","","","كتاب الجمعة"
"6128","(۶۱۲۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ، عَنْ عَمْرٍو، عَنْ أَبِی جَعْفَرٍ، قَالَ: أَمَّنَا جَابِرٌ بَعْدَ مَا ذَہَبَ بَصَرُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 6128","","","كتاب الجمعة"
"6129","(۶۱۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : سَأَلَ الْحَکَمُ بْنُ عُتَیْبَۃَ الْقَاسِمَ عَنِ الأَعْمَی یَؤُمُّ ، وَتَجُوزُ شَہَادَتُہُ ؟ فَقَالَ : مَا یَمْنَعُہُ أَنْ یَؤُمَّ وَتَجُوزُ شَہَادَتُہُ۔","","Musannaf Ibn Abi Shaybah 6129","","","كتاب الجمعة"
"6130","(۶۱۳۰) حَدَّثَنَا ابْنُ مَہْدِیّ ، عَنْ عُمَر بْنِ عَطِیَّۃَ ، قَالَ : أَمَّنَا الْمُسَیَّبُ وَہُوَ أَعْمَی۔","","Musannaf Ibn Abi Shaybah 6130","","","كتاب الجمعة"
"6131","(۶۱۳۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ شَیْخٍ یُکَنَّی أَبَا عَبْدِ اللہِ ؛ أَنَّ ابْنَ أَبِی أَوْفَی أَمَّہُمْ وَہُوَ أَعْمَی۔","Da'if","Musannaf Ibn Abi Shaybah 6131","","","كتاب الجمعة"
"6132","(۶۱۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَیْفَ أَؤُمُّہُمْ وَہُمْ یَعْدِلُونِی إِلَی الْقِبْلَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 6132","","","كتاب الجمعة"
"6133","(۶۱۳۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَسَنِ بْنِ أَبِی الْحَسْنَائِ ، عَنْ زِیَادِ النُّمَیْرِیِّ ، قَالَ : سَأَلْتُ أَنَسًا عَنِ الأَعْمَی ، یَؤُمُّ ؟ فَقَالَ : مَا أَفْقَرَکُمْ إِلَی ذَلِکَ ؟۔","Da'if","Musannaf Ibn Abi Shaybah 6133","","","كتاب الجمعة"
"6134","(۶۱۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ وَاصِلٍ الأَحْدَبِ ، عَنْ قَبِیصَۃَ بْنِ بُرْمَۃَ الأَسَدِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : مَا أُحِبُّ أَنْ یَکُونَ مُؤَذِّنِیکُمْ عُمْیَانُکُمْ ۔ قَالَ : أَحْسِبُہُ ، قَالَ : وَلاَ قُرَّائَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 6134","","","كتاب الجمعة"
"6135","(۶۱۳۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ إِسْرَائِیلَ ، عَنْ مَرْزُوقٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ قَالَ : الأَعْمَی لاَ یَؤُمُّ۔","","Musannaf Ibn Abi Shaybah 6135","","","كتاب الجمعة"
"6136","(۶۱۳۶) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ مِنْ طَیئٍ ؛ أَنَّ ابْنَ مَسْعُودٍ حَجَّ ، فَصَلَّی خَلْفَ أَعْرَابِیٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 6136","","","كتاب الجمعة"
"6137","(۶۱۳۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ کَہَمْسٍ ، عَنِ الْعَبَّاسِ الْجُرَیْرِیِّ ؛ أَنَّ أَبَا مِجْلَزٍ کَرِہَ إِمَامَۃَ الأَعْرَابِیِّ ، وَأَنَّ الْحَسَنَ لَمْ یَرَ بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 6137","","","كتاب الجمعة"
"6138","(۶۱۳۸) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ، عَنْ دَارِمٍ ، قَالَ : سَأَلْتُ سَالِمًا : أَیَؤُمُّ الأَعْرَابِیُّ الْمُہَاجِرَ ؟ قَالَ : وَمَا عَلَیْک إِذَا کَانَ رَجُلاً صَالِحًا۔","","Musannaf Ibn Abi Shaybah 6138","","","كتاب الجمعة"
"6139","(۶۱۳۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ سُئِلَ عَنْ إِمَامَۃِ الْعَبْدِ وَالأَعْرَابِیِّ ؟ فَقَالَ : الْعَبْدُ إِذَا فَقُہَ أَحَبَّہُمَا إِلَیَّ۔","","Musannaf Ibn Abi Shaybah 6139","","","كتاب الجمعة"
"6140","(۶۱۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَؤُمَّ الأَعْرَابِیُّ۔","","Musannaf Ibn Abi Shaybah 6140","","","كتاب الجمعة"
"6141","(۶۱۴۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ ابْنَ مَسْعُودٍ صَلَّی خَلْفَ أَعْرَابِیٍّ۔","","Musannaf Ibn Abi Shaybah 6141","","","كتاب الجمعة"
"6142","(۶۱۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ بُرْدٍ أَبِی الْعَلاَئِ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ أَئِمَّۃٌ مِنْ ذَلِکَ الْعَمَلِ، یَعْنِی أَوْلاَدَ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 6142","","","كتاب الجمعة"
"6143","(۶۱۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَؤُمَّ وَلَدُ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 6143","","","كتاب الجمعة"
"6144","(۶۱۴۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ زُہَیْرِ بْنِ أَبِی ثَابِتٍ الْعَبْسِیِّ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ ، یَقُولُ : تَجُوزُ شَہَادَتُہُ ، وَیَؤُمُّ۔","","Musannaf Ibn Abi Shaybah 6144","","","كتاب الجمعة"
"6145","(۶۱۴۵) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُطَرِّفٍ، عَنِ الشَّعْبِیِّ؛ أَنَّہُ سُئِلَ عَنْ إِمَامَۃِ وَلَدِ الزِّنَا؟ فَقَالَ: إِنَّ لَنَا إِمَامًا مَا یُعْرَفُ لَہُ أَبٌ۔","","Musannaf Ibn Abi Shaybah 6145","","","كتاب الجمعة"
"6146","(۶۱۴۶) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَؤُمَّ وَلَدُ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 6146","","","كتاب الجمعة"
"6147","(۶۱۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو حَنِیفَۃَ ، قَالَ : سَأَلْتُ عَطَاء ً عَنْ وَلَدِ الزِّنَا ، یَؤُمُّ الْقَوْمَ ؟ فَقَالَ : لاَ بَأْسَ بِہِ، أَلَیْسَ مِنْہُمْ مَنْ ہُوَ أَکْثَرُ صَوْمًا وَصَلاَۃً مِنَّا۔","","Musannaf Ibn Abi Shaybah 6147","","","كتاب الجمعة"
"6148","(۶۱۴۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَؤُمَّ وَلَدُ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 6148","","","كتاب الجمعة"
"6149","(۶۱۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : وَلَدُ الزِّنَا وَغَیْرُہُ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 6149","","","كتاب الجمعة"
"6150","(۶۱۵۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الرَّبِیعِ بْنِ الْمُنْذِرِ الثَّوْرِیِّ ، قَالَ : سَأَلْتُ الْحَارِثَ الْعُکْلِیَّ عَنْ وَلَدِ الزِّنَا یَؤُمُّ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 6150","","","كتاب الجمعة"
"6151","(۶۱۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ إِذَا سُئِلَتْ عَنْ وَلَدِ الزِّنَا؟ قَالَتْ : لَیْسَ عَلَیْہِ مِنْ خَطِیئَۃِ أَبَوَیْہِ شَیْئٌ ، لاَ تَزِرُ وَازِرَۃٌ وِزْرَ أُخْرَی۔","Sahih","Musannaf Ibn Abi Shaybah 6151","","","كتاب الجمعة"
"6152","(۶۱۵۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنَ سَعِیدٍ ، قَالَ : بَلَغَنِی أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ قَالَ لِرَجُلٍ ، کَانَ یَؤُمُّ قَوْمًا بِالْعَقِیقِ ، لاَ یُعْرَفُ مَنْ وَلَدُہُ ، فَنَہَاہُ أَنْ یَؤُمَّہُمْ۔","","Musannaf Ibn Abi Shaybah 6152","","","كتاب الجمعة"
"6153","(۶۱۵۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَرِہَ أَنْ یَؤُمَّ وَلَدُ زِنَیً ، وَصَاحِبُ نَمِیمَۃٍ۔","","Musannaf Ibn Abi Shaybah 6153","","","كتاب الجمعة"
"6154","(۶۱۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا دَاوُد بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنِی عَمْرُو بْنُ یَحْیَی الْمَازِنِیُّ ؛ أَنَّ رَجُلاً حُدَّ فِی فِرْیَۃٍ ، فَکَانَ یَؤُمُّ أَصْحَابَہُ ، فَسَأَلُوا عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، فَقَالَ : کَیْفَ رَأَیْتُمُوہُ ؟ فَقَالُوا : قَدْ کَانَ مِنْہُ مَا کَانَ ، فَأَثْنَوْا عَلَیْہِ خَیْرًا ، فَأَمَرَہُ أَنْ یَؤُمَّہُمْ۔","","Musannaf Ibn Abi Shaybah 6154","","","كتاب الجمعة"
"6155","(۶۱۵۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عِمْرَانَ الْجَوْنِیِّ ، عَنْ عَبْدِ اللہِ بْنِ الصَّامِتِ ، عَنْ أَبِی ذَرٍّ ؛ أَنَّہُ قَدِمَ وَعَلَی الرَّبَذَۃِ عَبْدٌ حَبَشِیٌّ ، فَأُقِیمَتِ الصَّلاَۃ ، فَقَالَ : تَقَدَّمْ۔","Sahih","Musannaf Ibn Abi Shaybah 6155","","","كتاب الجمعة"
"6156","(۶۱۵۶) حَدَّثَنَا یَزِیدُ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ أَبَا ذَرٍّ قَدَّمَ مَمْلُوکًا۔","","Musannaf Ibn Abi Shaybah 6156","","","كتاب الجمعة"
"6157","(۶۱۵۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ذَرٍّ ؛ أَنَّہُ صَلَّی خَلْفَ عَبْدٍ حَبَشِیٍّ۔","","Musannaf Ibn Abi Shaybah 6157","","","كتاب الجمعة"
"6158","(۶۱۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَ یَؤُمُّہَا مُدَبَّرٌ لَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 6158","","","كتاب الجمعة"
"6159","(۶۱۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَان ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ القَاسِم بن مُحَمَّد ، عَن أَبِیہِ ؛ أَنَّ عَائِشَۃَ صَلّتْ خَلْفَ مَملُوکٍ لَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 6159","","","كتاب الجمعة"
"6160","(۶۱۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ مَوْلَی أَبِی أَسِیْد ، قَالَ : تَزَوَّجْتُ وَأَنَا عَبْدٌ مَمْلُوکٌ ، فَدَعَوْتُ أُنَاسًا مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیہِمْ ؛ أَبُو ذَرٍّ ، وَابْنُ مَسْعُودٍ ، وَحُذَیْفَۃُ ، فَأُقِیمَتِ الصَّلاَۃ ، فَتَقَدَّمَ أَبُو ذَرٍّ ، فَقَالَ : وَرَائَک ، فَالْتَفَتَ إِلَی أَصْحَابِہِ ، فَقَالَ : کَذَلِکَ ؟ قَالَ : نَعَمْ ، قَالَ : فَقَدَّمُونِی ، فَصَلَّیْتُ بِہِمْ وَأَنَا عَبْدٌ مَمْلُوکٌ۔","Sahih","Musannaf Ibn Abi Shaybah 6160","","","كتاب الجمعة"
"6161","(۶۱۶۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ إِبْرَاہِیمَ بْنِ أَبِی حَبِیبَۃَ ، عَنْ دَاوُدَ بْنِ الْحُصَیْنِ ، عَنْ أَبِی سُفْیَانَ ؛ أَنَّہُ کَانَ یَؤُمُّ بَنِی عَبْدِ الأَشْہَلِ وَہُوَ مُکَاتَبٌ ، وَفِیہِمْ رِجَالٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مُحَمَّدُ بْنُ مَسْلَمَۃَ ، وَسَلَمَۃُ بْنُ سَلاَمَۃَ ، فَأَرَادُوا تَأْخِیرَہُ ، فَلَمَّا سَمِعَا قِرَائَتَہُ ، قَالاَ : أَمِثْلُ ہَذَا یُؤَخَّرُ ؟۔","Hasan","Musannaf Ibn Abi Shaybah 6161","","","كتاب الجمعة"
"6162","(۶۱۶۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالاَ : لاَ بَأْسَ أَنْ یَؤُمَّ الْعَبْدُ۔","","Musannaf Ibn Abi Shaybah 6162","","","كتاب الجمعة"
"6163","(۶۱۶۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَؤُمَّ الْعَبْدُ۔","","Musannaf Ibn Abi Shaybah 6163","","","كتاب الجمعة"
"6164","(۶۱۶۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ بَیَانٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ أَنْ یَؤُمَّ الْعَبْدُ۔","","Musannaf Ibn Abi Shaybah 6164","","","كتاب الجمعة"
"6165","(۶۱۶۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ شَہْرٍ ، قَالَ : لاَ بَأْسَ أَنْ یَؤُمَّ الْعَبْدُ إِذَا کَانَ أَفْقَہَہُمْ۔","","Musannaf Ibn Abi Shaybah 6165","","","كتاب الجمعة"
"6166","(۶۱۶۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زِیَادٍ مَوْلَی أُمِّ الْحَسَنِ ، قَالَ : صَلَّی خَلْفِی سَالِمُ بْنُ عَبْدِ اللہِ ، وَأَنَا عَبْدٌ۔","","Musannaf Ibn Abi Shaybah 6166","","","كتاب الجمعة"
"6167","(۶۱۶۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ کَہَمْسٍ ، عَنِ الْعَبَّاسِ الْجُرَیْرِیِّ ؛ أَنَّ أَبَا مِجْلَزٍ کَرِہَ إِمَامَۃَ الْعَبْدِ ، وَأَنَّ الْحَسَنَ لَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 6167","","","كتاب الجمعة"
"6168","(۶۱۶۸) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، قَالَ : أَخْبَرَنِی ابْنُ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ اللہِ بْنِ أَبِی مُلَیْکَۃَ ؛ أَنَّہُمْ کَانُوا یَأْتُونَ عَائِشَۃَ ، أَبُوہُ ، وَعُبَیْدُ بْنُ عُمَیْرٍ ، وَالْمِسْوَرُ بْنُ مَخْرَمَۃَ ، وَأُنَاسٌ کَثِیرٌ فَیَؤُمُّہُمْ أَبُو عَمْرٍو مَوْلًی لِعَائِشَۃَ ، وَأَبُو عَمْرٍو حِینَئِذٍ غُلاَمٌ لَمْ یُعْتَقْ۔","","Musannaf Ibn Abi Shaybah 6168","","","كتاب الجمعة"
"6169","(۶۱۶۹) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ یَؤُمُّنَا فِی مَسْجِدِنَا ہَذَا عَبْدٌ أَرْبَعِینَ سَنَۃً ، مَسْجِدٍ کَانَ یُصَلِّی فِیہِ شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 6169","","","كتاب الجمعة"
"6170","(۶۱۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ بَشَّارِ بْنِ کِدَامٍ السُّلَمِیِّ ، عَنْ عَمْرِو بْنِ مَیْسَرَۃَ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ ؛ أَنَّہُ صَلَّی خَلْفَ مَمْلُوکٍ فِی حَائِطٍ مِنْ حِیطَانِہِ ، وَنَاسٌ مِنْ أَہْلِ بَیْتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 6170","","","كتاب الجمعة"
"6171","(۶۱۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا بَشِیر بْن سَلْمَانَ ، عَنْ یَحْیَی بْنِ بِسْطَامٍ التَّمِیمِیِّ ، عَنِ الضِّحَّاکِ ، قَالَ : لاَ یَؤُمُّ الْمَمْلُوکُ وَفِیہِمْ حُرٌّ ، وَلاَ یَؤُمُّ مَنْ لَمْ یَحُجَّ ، وَفِیہِمْ مَنْ قَدْ حَجَّ۔","","Musannaf Ibn Abi Shaybah 6171","","","كتاب الجمعة"
"6172","(۶۱۷۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی إِبْرَاہِیمُ بْنُ أَبِی حَبِیبَۃَ ، قَالَ : حَدَّثَنِی عَبْدُ اللہِ بْنُ أَبِی سُفْیَانَ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْتُ مَعَ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، وَحُسَیْنِ بْنِ عَلِیٍّ ، وَابْنِ أَبِی أَحْمَدَ إِلَی یَنْبُعَ ، فَحَضَرَتِ الصَّلاَۃ ، فَقَدَّمُونِی ، فَصَلَّیْت بِہِمْ۔","Hasan","Musannaf Ibn Abi Shaybah 6172","","","كتاب الجمعة"
"6173","(۶۱۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ سُلَیْمَانَ بْنِ الْغَسِیلِ ، قَالَ : حَدَّثَنِی الْمُنْذِرُ بْنُ أَبِی أُسَیْدِ الأَنْصَارِیِّ ، قَالَ : کَانَ أَبِی یُصَلِّی خَلْفِی ، فَرُبَّمَا قَالَ لِی : یَا بُنَیَّ طَوَّلْتَ بِنَا الْیَوْمَ۔","Hasan","Musannaf Ibn Abi Shaybah 6173","","","كتاب الجمعة"
"6174","(۶۱۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا إِبْرَاہِیمُ بْنُ یَزِیدَ الْمَکِّیُّ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَؤُمُّ الرَّجُلُ أَبَاہُ۔","","Musannaf Ibn Abi Shaybah 6174","","","كتاب الجمعة"
"6175","(۶۱۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبَانُ بْنُ یَزِیدَ الْعَطَّارُ ، عَنْ بُدَیْلِ بْنِ مَیْسَرَۃَ الْعُقَیْلِیِّ ، عَنْ أَبِی عَطِیَّۃَ رَجُلٌ مِنْہُمْ ، قَالَ : کَانَ مَالِکُ بْنُ الْحُوَیْرِثِ یَأْتِینَا فِی مُصَلاَّنَا ہَذَا نَتَحَدَّثُ ، فَحَضَرَتِ الصَّلاَۃُ ، فَقُلْنَا لَہُ : تَقَدَّمْ ، فَقَالَ : لاَ ، لِیَتَقَدَّمُ بَعْضُکُمْ حَتَّی أُحَدِّثَـکُمْ لِمَ لاَ أَتَقَدَّمُ ، سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَقُولُ : مَنْ زَارَ قَوْمًا فَلاَ یَؤُمُّہُمْ ، وَلْیَؤُمَّہُمْ رَجُلٌ مِنْہُمْ۔ (ابوداؤد ۵۹۶۔ احمد ۳/۴۳۶)","Da'if","Musannaf Ibn Abi Shaybah 6175","","","كتاب الجمعة"
"6176","(۶۱۷۶) حَدَّثَنَا جَرِیرٌ ، وَہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ سِمَاکِ بْنِ سَلَمَۃَ الضَّبِّیِّ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ ، وَابْنَ عَبَّاسٍ وَہُمَا مُتَرَبِّعَانِ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 6176","","","كتاب الجمعة"
"6177","(۶۱۷۷) حَدَّثَنَا حَفْصٌ ، عَنْ عُقْبَۃَ ، قَالَ : رَأَیْتُ أَنَسًا یُصَلِّی مُتَرَبِّعًا۔","Hasan","Musannaf Ibn Abi Shaybah 6177","","","كتاب الجمعة"
"6178","(۶۱۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ الطَّائِیِّ ، عَنْ أَخِیہِ ، قَالَ : رَأَیْتُ أَنَسًا یُصَلِّی مُتَرَبِّعًا۔","Hasan","Musannaf Ibn Abi Shaybah 6178","","","كتاب الجمعة"
"6179","(۶۱۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُمَرَ الأَنْصَارِیِّ ، قَالَ : رَأَیْتُ أَنَسًا یُصَلِّی مُتَرَبِّعًا عَلَی طِنْفُسَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6179","","","كتاب الجمعة"
"6180","(۶۱۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ ، قَالَ : رَأَیْتُ سَالِمًا یُصَلِّی مُتَرَبِّعًا۔","","Musannaf Ibn Abi Shaybah 6180","","","كتاب الجمعة"
"6181","(۶۱۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ رَجَائٍ ، عَنْ مُجَاہِدٍ ، قَالَ : یُصَلِّی مُتَرَبِّعًا۔","","Musannaf Ibn Abi Shaybah 6181","","","كتاب الجمعة"
"6182","(۶۱۸۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حُمَیْدٍ ، قَالَ : رَأَیْتُ أَبَا بَکْرٍ یُصَلِّی مُتَرَبِّعًا وَمُتَّکِئًا۔","","Musannaf Ibn Abi Shaybah 6182","","","كتاب الجمعة"
"6183","(۶۱۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ عَطَائً یُصَلِّی مُتَرَبِّعًا۔","","Musannaf Ibn Abi Shaybah 6183","","","كتاب الجمعة"
"6184","(۶۱۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یُصَلِّی مُتَرَبِّعًا۔","","Musannaf Ibn Abi Shaybah 6184","","","كتاب الجمعة"
"6185","(۶۱۸۵) حَدَّثَنَا عُبَیْدُاللہِ بْنُ مُوسَی، عَنْ إِسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرَ؛ أَنَّہُ کَانَ یَجْلِسُ فِی الصَّلاَۃ مُتَرَبِّعًا۔","","Musannaf Ibn Abi Shaybah 6185","","","كتاب الجمعة"
"6186","(۶۱۸۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الْفَضْلِ بْنِ دَلْہَمٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یُصَلِّیَ فِی التَّطَوُّعِ مُتَرَبِّعًا۔","","Musannaf Ibn Abi Shaybah 6186","","","كتاب الجمعة"
"6187","(۶۱۸۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنِ الْہَیْثُمِ بْنِ شِہَابٍ ؛ أَنَّہُ رَأَی رَجُلاً مِنْ قَوْمِہِ وَہُوَ یُصَلِّی قَاعِدًا مُتَرَبِّعًا فَنَہَاہُ ، فَأَبَی أَنْ یُطِیعَہُ ، فَقَالَ الْہَیْثُمِ : سَمِعْتُ عَبْدَ اللہِ بْنَ مَسْعُودٍ ، یَقُولُ : لأَنْ أَقْعُدَ عَلَی رَضْفَتَیْنِ أَحَبُّ إِلَیَّ مِنْ أَنْ أَقْعُدَ مُتَرَبِّعًا فِی الصَّلاَۃ۔","Da'if","Musannaf Ibn Abi Shaybah 6187","","","كتاب الجمعة"
"6188","(۶۱۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ التَّرَبُّعِ فِی الصَّلاَۃِ ؟ فَکَأَنَّہُ کَرِہَہُ ۔ قَالَ : وَأَحْسِبُہُ قَالَ : کَرِہَہُ ابْنُ عَبَّاسٍ۔","","Musannaf Ibn Abi Shaybah 6188","","","كتاب الجمعة"
"6189","(۶۱۸۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنْ حَجَّاجٍ، عَنْ حَمَّادٍ، عَنْ إِبْرَاہِیمَ؛ أَنَّہُ کَرِہَ أَنْ یُصَلِّیَ مُتَرَبِّعًا، وَقَالَ: اجْلِسْ غَیْرَ جِلْسَتِکَ لِلْحَدِیثِ۔","","Musannaf Ibn Abi Shaybah 6189","","","كتاب الجمعة"
"6190","(۶۱۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یَجْلِسَ فِی الصَّلاَۃ جِلْسَۃَ الرَّجُلِ یُحَدِّثُ أَصْحَابَہُ۔","","Musannaf Ibn Abi Shaybah 6190","","","كتاب الجمعة"
"6191","(۶۱۹۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حَدَّثَنَا جَرِیرُ بْنُ حَازِمٍ، عَنِ الْمُغِیرَۃِ بْنِ حَکِیمٍ الصَّنْعَانِیِّ، قَالَ: رَأَیْتُ ابْنَ عُمَرَ مُتَرَبِّعًا فِی آخَرِ صَلاَتِہِ ، حِینَ رَفَعَ رَأْسَہُ مِنَ السَّجْدَۃِ الآخِرَۃِ ، فَلَمَّا صَلَّی ، قُلْتُ لَہُ ؟ فَقَالَ : إِنِّی أَشْتَکِی رِجْلِی۔","Sahih","Musannaf Ibn Abi Shaybah 6191","","","كتاب الجمعة"
"6192","(۶۱۹۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ صَلَّی مُتَرَبِّعًا مِنْ وَجَعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6192","","","كتاب الجمعة"
"6193","(۶۱۹۳) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ یُکْرَہُ أَنْ یَتَرَبَّعَ الرَّجُلُ فِی صَلاَتِہِ حَتَّی یَتَشَہَّدَ۔","","Musannaf Ibn Abi Shaybah 6193","","","كتاب الجمعة"
"6194","(۶۱۹۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ؛ نُبِّئْتُ أَنَّ ابْنَ عُمَرَ صَلَّی مُتَرَبِّعًا ، وَقَالَ : إِنَّہُ لَیْسَ بِسُنَّۃٍ، إِنَّمَا أَفْعَلُہُ مِنْ وَجَعٍ۔","","Musannaf Ibn Abi Shaybah 6194","","","كتاب الجمعة"
"6195","(۶۱۹۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَرِہَ التَّرَبُّعَ ، وَقَالَ : جِلْسَۃُ مَمْلَکَۃٍ۔","","Musannaf Ibn Abi Shaybah 6195","","","كتاب الجمعة"
"6196","(۶۱۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا صَلَّی قَاعِدًا جَعَلَ قِیَامَہُ مُتَرَبِّعًا۔","","Musannaf Ibn Abi Shaybah 6196","","","كتاب الجمعة"
"6197","(۶۱۹۷) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنْ سُلَیْمَانَ بْنِ بَزِیعٍ ، قَالَ : دَخَلْتُ عَلَی سَالِمٍ وَہُوَ یُصَلِّی جَالِسًا ، فَإِذَا کَانَ الجُلُوس جَثَا لرُکْبَتَیہِ ، وَإِذَا کَانَ القِیام تَرَبَّعَ۔","","Musannaf Ibn Abi Shaybah 6197","","","كتاب الجمعة"
"6198","(۶۱۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : قَالَ سُفْیَانُ : إِذَا صَلَّی جَالِسًا جَعَلَ قِیَامَہُ مُتَرَبِّعًا ، فَإِذَا أَرَادَ أَنْ یَرْکَعَ رَکَعَ وَہُوَ مُتَرَبِّعٌ ، فَإِذَا أَرَادَ أَنْ یَسْجُدَ ثَنَی رِجْلَہُ۔","","Musannaf Ibn Abi Shaybah 6198","","","كتاب الجمعة"
"6199","(۶۱۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ حَمَّادٍ ، عَنْ مُجَاہِدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إِذَا صَلَّی مُتَرَبِّعًا ، قَالَ مِسْعَرٌ : أَوْ کَمَا قَالَ ، یَجْلِسُ ، فَإِذَا أَرَادَ أَنْ یَرْکَعَ ، أَوْ یَسْجُدَ ثَنَی رِجْلَہُ۔","","Musannaf Ibn Abi Shaybah 6199","","","كتاب الجمعة"
"6200","(۶۲۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : یُصَلِّی مُتَرَبِّعًا ، فَإِذَا أَرَادَ أَنْ یَرْکَعَ ثَنَی رِجْلَہُ۔","","Musannaf Ibn Abi Shaybah 6200","","","كتاب الجمعة"
"6201","(۶۲۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنٌ ، عَنْ أَبِی حَفْصٍ ، قَالَ : رَأَیْتُ أَنَسًا یُصَلِّی مُتَرَبِّعًا ، فَإِذَا أَرَادَ أَنْ یَرْکَعَ ثَنَی رِجْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 6201","","","كتاب الجمعة"
"6202","(۶۲۰۲) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَدْخُلُ الْمَسْجِدَ وَقَدْ تَمَّ الصَّفُّ ، قَالَ : إِنِ اسْتَطَاعَ أَنْ یَدْخُلَ فِی الصَّفِّ دَخَلَ ، وَإِلاَّ أَخَذَ بِیَدِ رَجُلٍ فَأَقَامَہُ مَعَہُ ، وَلَمْ یَقُمْ وَحْدَہُ۔","","Musannaf Ibn Abi Shaybah 6202","","","كتاب الجمعة"
"6203","(۶۲۰۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : أَجِیئُ إِلَی الصَّفِّ وَقَدِ امْتَلأَ ؟ قَالَ : مُرْ رَجُلاً ، فَأَقِمْہُ مَعَک ، فَإِنْ صَلَّیْتَ وَحْدَک فَأَعِدْ۔","","Musannaf Ibn Abi Shaybah 6203","","","كتاب الجمعة"
"6204","(۶۲۰۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَعَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَؤُمُّ نِسَائَہُ فِی الْمَکْتُوبَۃِ ، لَیْسَ مَعَہُنَّ رَجُلٌ۔","","Musannaf Ibn Abi Shaybah 6204","","","كتاب الجمعة"
"6205","(۶۲۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، قَالَ : جَعَلَ عُمَرُ بْنُ الْخَطَّابَ لِلنَّاسِ قَارِئِینَ فِی رَمَضَانَ ، فَکَانَ أُبَیٌّ یُصَلِّی بِالنَّاسِ ، وَابْنُ أَبِی حَثْمَۃَ یُصَلِّی بِالنِّسَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 6205","","","كتاب الجمعة"
"6206","(۶۲۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ غَالِبٍ أَبِی الْہُذَیْلِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کُنْتُ أُصَلِّی فِی الْحَیِّ فِی زَمَنِ الْحَجَّاجِ ، وَمَا خَلْفِی إِلاَّ امْرَأَۃٌ۔","","Musannaf Ibn Abi Shaybah 6206","","","كتاب الجمعة"
"6207","(۶۲۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ ، وَعَطَائً عَنِ الرَّجُلِ یَؤُمُّ النِّسَائَ ، لَیْسَ مَعَہُنَّ رَجُلٌ ؟ فَقَالاَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 6207","","","كتاب الجمعة"
"6208","(۶۲۰۸) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ اللہِ الثَّقَفِیِّ ، قَالَ : حدَّثَنَا عَرْفَجَۃُ ، قَالَ : کَانَ عَلِیٌّ یَأْمُرُ النَّاسَ بِقِیَامِ رَمَضَانَ ، وَکَانَ یَجْعَلُ لِلرِّجَالِ إِمَامًا ، وَلِلنِّسَائِ إِمَامًا ۔ قَالَ عَرْفَجَۃُ : فَأَمَرَنِی عَلِیٌّ ، فَکُنْتُ إِمَامَ النِّسَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 6208","","","كتاب الجمعة"
"6209","(۶۲۰۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : سُئِلَ عَنِ الرَّجُلِ یَؤُمُّ النِّسْوَۃَ فِی رَمَضَانَ ؟ قَالَ: کَانَ لاَ یَرَی بِہِ بَأْسًا إِذَا کَانَ الرَّجُلُ لاَ بَأْسَ بِہِ ، قَالَ : ، وَإِنْ کَانَ الرَّجُلُ لَیَخْرُجُ فَتَفُوتُہُ الصَّلاَۃ فِی جَمَاعَۃٍ ، فَیَرْجِعُ إِلَی أَہْلِہِ ، فَیَجْمَعُہُمْ فَیُصَلِّی بِہِمْ۔","","Musannaf Ibn Abi Shaybah 6209","","","كتاب الجمعة"
"6210","(۶۲۱۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُطَہَّرِ بْنِ جُوَیْرِیَۃَ ، قَالَ : رَأَیْتُ أَبَا مِجْلَزٍ وَلَہُ مَسْجِدٌ فِی دَارِہِ ، فَرُبَّمَا جَمَّعَ بِأَہْلِہِ وَغِلْمَانِہِ۔","","Musannaf Ibn Abi Shaybah 6210","","","كتاب الجمعة"
"6211","(۶۲۱۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ نُعَیْمٍ ، قَالَ : قَالَ عُمَرُ : إِذَا کَانَ بَیْنَہُ وَبَیْنَ الإِمَام طَرِیقٌ ، أَوْ نَہْرٌ ، أَوْ حَائِطٌ فَلَیْسَ مَعَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 6211","","","كتاب الجمعة"
"6212","(۶۲۱۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُصَلِّیَ بِصَلاَۃِ الإِمَام إِذَا کَانَ بَیْنَہُمَا طَرِیقٌ ، أَوْ نِسَائٌ۔","","Musannaf Ibn Abi Shaybah 6212","","","كتاب الجمعة"
"6213","(۶۲۱۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ إِسْرَائِیلَ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلْتُُہُ عَنِ الْمَرْأَۃِ تَأْتَمُّ بِالإِمَام ، وَبَیْنَہُمَا طَرِیقٌ ؟ فَقَالَ : لَیْسَ ذَلِکَ لَہَا۔","","Musannaf Ibn Abi Shaybah 6213","","","كتاب الجمعة"
"6214","(۶۲۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ ، قَالَ : کَانَ أَنَسُ یُجَمِّعُ مَعَ الإِمَامِ ، وَہُوَ فِی دَارِ نَافِعِ بْنِ عَبْدِ الْحَارِثِ ، بَیْتٌ مُشْرِفٌ عَلَی الْمَسْجِدِ ، لَہُ بَابٌ إِلَی الْمَسْجِدِ ، فَکَانَ یُجَمِّعُ فِیہِ وَیَأْتَمُّ بِالإِمَام۔","","Musannaf Ibn Abi Shaybah 6214","","","كتاب النكاح"
"6215","(۶۲۱۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، قَالَ : صَلَّیْتُ مَعَ أَبِی ہُرَیْرَۃَ فَوْقَ الْمَسْجِدِ بِصَلاَۃِ الإِمَام ، وَہُوَ أَسْفَلُ۔","Hasan","Musannaf Ibn Abi Shaybah 6215","","","كتاب النكاح"
"6216","(۶۲۱۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ أَبِی مِجْلَزٍ ؛ فِی الْمَرْأَۃِ تُصَلِّی وَبَیْنَہَا وَبَیْنَ الإِمَام حَائِطٌ ، قَالَ : إِذَا کَانَتْ تَسْمَعُ التَّکْبِیرَ أَجْزَأَہَا ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 6216","","","كتاب النكاح"
"6217","(۶۲۱۷) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ سَعِیدِ بْنِ مُسْلِمٍ ، قَالَ : رَأَیْتُ سَالِمَ بْنَ عَبْدِ اللہِ یُصَلِّی فَوْقَ ظَہْرِ الْمَسْجِدِ صَلاَۃَ الْمَغْرِبِ ، وَمَعَہُ رَجُلٌ آخَرَ ، یَعْنِی وَیَأْتَمُّ بِالإِمَام۔","","Musannaf Ibn Abi Shaybah 6217","","","كتاب النكاح"
"6218","(۶۲۱۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : کَانَ إِلَی جَنْبِ مَسْجِدِنَا سَطْحٌ ، عَنْ یَمِینِ الْمَسْجِدِ ، أَسْفَلُ مِنَ الإِمَام ، فَکَانَ قَوْمٌ ہَارِبِینَ فِی إِمَارَۃِ الْحَجَّاجِ ، وَبَیْنَہُمْ وَبَیْنَ الْمَسْجِدِ حَائِطٌ طَوِیلٌ ، یُصَلُّونَ عَلَی ذَلِکَ السَّطْحِ ، وَیَأْتَمُّونَ بِالإِمَام ، فَذَکَرْتُہُ لإِبْرَاہِیمَ ، فَرَآہُ حَسَنًا۔","","Musannaf Ibn Abi Shaybah 6218","","","كتاب النكاح"
"6219","(۶۲۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُئِلَ مُحَمَّدٌ عَنِ الرَّجُلِ یَکُونُ عَلَی ظَہْرِ بَیْتٍ ، یُصَلِّی بِصَلاَۃِ الإِمَام فِی رَمَضَانَ ؟ فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا ، إِلاَّ أَنْ یَکُونَ بَیْنَ یَدَیِ الإِمَام۔","","Musannaf Ibn Abi Shaybah 6219","","","كتاب النكاح"
"6220","(۶۲۲۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ عُرْوَۃَ کَانَ یُصَلِّی بِصَلاَۃِ الإِمَامِ ، وَہُوَ فِی دَارِ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ ، وَبَیْنَہُمَا وَبَیْنَ الْمَسْجِدِ طَرِیقٌ۔","","Musannaf Ibn Abi Shaybah 6220","","","كتاب النكاح"
"6221","(۶۲۲۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : سُئِلَ عَنِ الْمُؤَذِّنِ یُقِیمُ فِی الْمِئْذَنَۃِ ، وَیُصَلِّی بِصَلاَۃِ الإِمَام ؟ قَالَ : یُجْزِئُہُ۔","","Musannaf Ibn Abi Shaybah 6221","","","كتاب الجمعة"
"6222","(۶۲۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : سَأَلْتُُہُ عَنْ صَلاَۃِ الْمُؤَذِّنِینَ فَوْقَ الْمَسْجِدِ یَوْمَ الْجُمُعَۃِ بِصَلاَۃِ الإِمَام وَہُوَ أَسْفَلُ ؟ قَالَ : یُجْزِئُہُمْ۔","","Musannaf Ibn Abi Shaybah 6222","","","كتاب الجمعة"
"6223","(۶۲۲۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : سَأَلْتُُہُ عَنِ الْمُؤَذِّنِ یُصَلِّی فِی صَوْمَعَتِہِ ، وَیَأْتَمُّ بِالإِمَام ؟ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 6223","","","كتاب الجمعة"
"6224","(۶۲۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ عُمَرُ : تُصَلِّی الْمَرْأَۃُ فِی ثَلاَثَۃِ أَثْوَابٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6224","","","كتاب الجمعة"
"6225","(۶۲۲۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَکْحُولٍ ، قَالَ : سُئِلَتْ عَائِشَۃُ : فِی کَمْ تُصَلِّی الْمَرْأَۃُ ؟ فَقَالَتْ : ائْتِ عَلِیًّا فَاسْأَلْہُ ثُمَّ ارْجِعْ إِلَیَّ ، فَأَتَی عَلِیًّا فَسَأَلَہُ ، فَقَالَ : فِی دِرْعٍ سَابِغٍ وَخِمَارٍ ، فَرَجَعَ إِلَیْہَا فَأَخْبَرَہَا، فَقَالَتْ : صَدَقَ۔","","Musannaf Ibn Abi Shaybah 6225","","","كتاب الجمعة"
"6226","(۶۲۲۶) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ بُکَیْرِ بْنِ الأَشَجِّ ، عَنْ عُبیدِ اللہِ الْخَوْلاَنِیِّ ، قَالَ : رَأَیْتُ مَیْمُونَۃَ زَوْجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تُصَلِّی فِی دِرْعٍ وَاحِدٍ فَضْلاً ، وَقَدْ وَضَعَتْ بَعْضَ کُمِّہَا عَلَی رَأْسِہَا ۔ قَالَ : وَکَانَ عُبَیْدُ اللہِ یَتِیمًا فِی حِجْرِہَا۔","","Musannaf Ibn Abi Shaybah 6226","","","كتاب الجمعة"
"6227","(۶۲۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَالِکُ بْنُ أَنَسٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ عُبَیْدِ اللہِ الْخَوْلاَنِیِّ، عَنْ مَیْمُونَۃَ بِنْتِ الْحَارِثِ ، زَوْجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہَا صَلَّتْ فِی دِرْعٍ وَخِمَارٍ۔","","Musannaf Ibn Abi Shaybah 6227","","","كتاب الجمعة"
"6228","(۶۲۲۸) أَخْبَرَنَا حَفْصٌ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، قَالَ : حدَّثَتْنِی أُمِّی ؛ أَنَّہَا سَأَلَتْ أُمَّ سَلَمَۃَ ، زَوْجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی أَیِّ شَیْئٍ تُصَلِّی الْمَرْأَۃُ ؟ فَقَالَتْ : تُصَلِّی فِی دِرْعٍ سَابِغٍ ، یُغَطِّی قَدَمَیْہَا وَالْخِمَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 6228","","","كتاب الجمعة"
"6229","(۶۲۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ بن مُہَاجِرِ بْنِ قُنْفُذٍ ، عَنْ أُمِّہِ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : تُصَلِّی الْمَرْأَۃُ فِی الدِّرْعِ السَّابِغِ وَالْخِمَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 6229","","","كتاب الجمعة"
"6230","(۶۲۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ أُمِّ ثَوْرٍ ، عَنْ زَوْجِہَا بِشْرٍ ؛ أَنَّہُ سَأَلَ ابْنَ عَبَّاسٍ : فِی کَمْ تُصَلِّی الْمَرْأَۃُ ؟ فَقَالَ : فِی دِرْعٍ وَخِمَارٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6230","","","كتاب الجمعة"
"6231","(۶۲۳۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إِذَا صَلَّتِ الْمَرْأَۃُ ، فَلْتُصَلِّ فِی ثِیَابِہَا کُلِّہَا ؛ الدِّرْعُ ، وَالْخِمَارُ ، وَالْمِلْحَفَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 6231","","","كتاب الجمعة"
"6232","(۶۲۳۲) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ، عَنْ مُحَمَّدٍ، عَنْ عَبِیدَۃَ، قَالَ: تُصَلِّی الْمَرْأَۃُ فِی الدِّرْعِ وَالْخِمَارِ وَالْحَقْوٗ۔n قَالَ أَشْعَثُ ، عَنْ مُحَمَّدٍ ، مِثْلَہُ ، فَقُلْتُ لَہُ : مَا ہَذِہِ الْخُمُرُ ؟ فَقَالَ : الْخِمَارُ مَا خَمَّرَ ، وَکَانَتِ الأَنْصَارُ تُسَمِّی الإِزَارَ الْحَقْوَ۔","","Musannaf Ibn Abi Shaybah 6232","","","كتاب الجمعة"
"6233","(۶۲۳۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : تُصَلِّی الْمَرْأَۃُ فِی ثَلاَثَۃِ أَثْوَابٍ۔","","Musannaf Ibn Abi Shaybah 6233","","","كتاب الجمعة"
"6234","(۶۲۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَسْتَحِبُّ أَنْ تُصَلِّیَ الْمَرْأَۃُ فِی ثَلاَثَۃِ أَثْوَابٍ ؛ فِی الدِّرْعِ ، وَالْخِمَارِ ، وَالْحَقْوِ۔","","Musannaf Ibn Abi Shaybah 6234","","","كتاب الجمعة"
"6235","(۶۲۳۵) حَدَّثَنَا أَبُوالأَحْوَصِ، عَنْ مُغِیرَۃَ، عَنْ إِبْرَاہِیمَ؛ أَنَّہُ کَانَ یُرَخِّصُ لِلْمَرْأَۃِ أَنْ تُصَلِّیَ فِی الدِّرْعِ وَالْجِلْبَابِ۔","","Musannaf Ibn Abi Shaybah 6235","","","كتاب الجمعة"
"6236","(۶۲۳۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : قالَتِ امْرَأَۃٌ لأَبِی : إِنِّی امْرَأَۃٌ حُبْلَی ، وَإِنَّہُ یَشُقُّ عَلَیَّ أَنْ أُصَلِّیَ فِی الْمِنْطَقِ ، أَفَأُصَلِّی فِی دِرْعٍ وَخِمَارٍ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 6236","","","كتاب الجمعة"
"6237","(۶۲۳۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ عِکْرِمَۃَ ، قَالَ : تُصَلِّی الْمَرْأَۃُ فِی دِرْعٍ وَخِمَارِ حَصِیْفٍ۔","","Musannaf Ibn Abi Shaybah 6237","","","كتاب الجمعة"
"6238","(۶۲۳۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : تُصَلِّی الْمَرْأَۃُ فِی دِرْعٍ صَفِیقٍ ، وَخِمَارٍ صَفِیقٍ۔","","Musannaf Ibn Abi Shaybah 6238","","","كتاب الجمعة"
"6239","(۶۲۳۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : قَالَ عَطَائٌ : فِی دِرْعٍ وَخِمَارٍ۔","","Musannaf Ibn Abi Shaybah 6239","","","كتاب الجمعة"
"6240","(۶۲۴۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، فَقَالَ : فِی دِرْعٍ وَخِمَارٍ ، وَسَأَلْتُ حَمَّادًا ، فَقَالَ : تُصَلِّی فِی دِرْعٍ ، وَمِلْحَفَۃٍ تُغَطِّی رَأْسَہَا۔","","Musannaf Ibn Abi Shaybah 6240","","","كتاب الجمعة"
"6241","(۶۲۴۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تُصَلِّی الْمَرْأَۃُ فِی أَقَلَّ مِنْ أَرْبَعَۃِ أَثْوَابٍ۔","","Musannaf Ibn Abi Shaybah 6241","","","كتاب الجمعة"
"6242","(۶۲۴۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ مُعَاذَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا قَامَتْ تُصَلِّی فِی دِرْعٍ وَخِمَارٍ ، فَأَتَتْہَا الأَمَۃُ ، فَأَلْقَتْ عَلَیْہَا ثَوْبًا۔","Hasan","Musannaf Ibn Abi Shaybah 6242","","","كتاب الجمعة"
"6243","(۶۲۴۳) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابن عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : تَتَّزِرُ بِہِ۔","","Musannaf Ibn Abi Shaybah 6243","","","كتاب الجمعة"
"6244","(۶۲۴۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، قَالَ : سَأَلْتُ مُجَاہِدًا ، وَعَطَائً عَنِ الْمَرْأَۃِ تَحْضُرُہَا الصَّلاَۃ ، وَلَیْسَ لَہَا إِلاَّ ثَوْبٌ وَاحِدٌ ؟ قَالاَ : تَتَّزِرُ بِہِ۔","","Musannaf Ibn Abi Shaybah 6244","","","كتاب الجمعة"
"6245","(۶۲۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ ذَرٍّ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الْمَرْأَۃِ لاَ یَکُونُ لَہَا إِلاَّ الثَّوْبُ الْوَاحِدُ؟ قَالَ : تَتَّزِرُ بِہِ ۔n قَالَ وَکِیعٌ : یَعْنِی إِذَا کَانَ صَغِیرًا۔","","Musannaf Ibn Abi Shaybah 6245","","","كتاب الجمعة"
"6246","(۶۲۴۶) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا عِکْرِمَۃُ بْنُ عَمَّارٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ؛ أَنَّہُ أَمَّہُمْ فِی قَمِیصٍ وَاحِدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6246","","","كتاب الجمعة"
"6247","(۶۲۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا أَبَانُ بْنُ صَمْعَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃ فِی الْقَمِیصِ الْوَاحِدِ ، إِذَا کَانَ صَفِیقًا۔","Da'if","Musannaf Ibn Abi Shaybah 6247","","","كتاب الجمعة"
"6248","(۶۲۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إِسْمَاعِیلَ السَّرَّاجِ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ صَلَّی فِی قَمِیصٍ لَیْسَ عَلَیْہِ شَیْئٌ غَیْرُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 6248","","","كتاب الجمعة"
"6249","(۶۲۴۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ مُوسَی بْنِ یَزِیدَ ، قَالَ : وَسَمِعْتُ أَبَا أُمَامَۃَ وَسُئِلَ عَنِ الصَّلاَۃ فِی الْقَمِیصِ الْوَاحِدِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ ۔ وَفِی الرَّیْطَۃِ ؟ إِذَا تَوَشَّحْتَ بِہَا فَلاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 6249","","","كتاب الجمعة"
"6250","(۶۲۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی الضُّحَی ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ عَنِ الصَّلاَۃ فِی الْقَمِیصِ الْوَاحِدِ ؟ فَقَالَ : رُبَّ رَجُلٍ لَیْسَ لَہُ إِلاَّ قَمِیصٌ۔","Sahih","Musannaf Ibn Abi Shaybah 6250","","","كتاب الجمعة"
"6251","(۶۲۵۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إِبْرَاہِیمَ، قَالَ: لاَ بَأْسَ بِالصَّلاَۃِ فِی الْقَمِیصِ الْوَاحِدِ إِذَا کَانَ صَفِیقًا۔","","Musannaf Ibn Abi Shaybah 6251","","","كتاب الجمعة"
"6252","(۶۲۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، قَالَ : أَمَّنَا مُعَاوِیَۃُ فِی قَمِیصٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6252","","","كتاب الجمعة"
"6253","(۶۲۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ صَلَّی فِی قَمِیصٍ۔","","Musannaf Ibn Abi Shaybah 6253","","","كتاب الجمعة"
"6254","(۶۲۵۴) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ، عَنْ سَعِیدِ بْنِ أَبِی ہِنْدٍ، قَالَ: بَعَثْتُ غُلاَمًا لِی کَاتِبًا حَاسِبًا إِلَی سَعِیدِ بْنِ الْمُسَیَّبِ، یَسْأَلُہُ عَنِ الصَّلاَۃ فِی قَمِیصٍ لَیْسَ تَحْتَہُ إِزَارٌ؟ قَالَ: لَیْسَ بِہِ بَأْسٌ إِذَا لَمْ یَشِفَّ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 6254","","","كتاب الجمعة"
"6255","(۶۲۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنِ الْجُرَیْرِیِّ، عَنْ عِکْرِمَۃَ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالصَّلاَۃِ فِی الْقَمِیصِ الْوَاحِدِ حَصِیفًا۔","","Musannaf Ibn Abi Shaybah 6255","","","كتاب الجمعة"
"6256","(۶۲۵۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الْہُذَیْلِ بْنِ بِلاَلٍ الْفَزَارِیِّ ، قَالَ : حدَّثَنِی زِیَادُ بْنُ عُثْمَانَ الأَحْمَریُّ ، قَالَ: رَأَیْتُ عَلْقَمَۃَ یُصَلِّی فِی قَمِیصٍ صَفِیقٍ قَصِیرٍ۔","","Musannaf Ibn Abi Shaybah 6256","","","كتاب الجمعة"
"6257","(۶۲۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعَوَّامُ ، عَنْ عَطَائِ بْنِ أَبِی رَبَاحٍ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃ فِی ثَوْبٍ وَاحِدٍ إِذَا کَانَ صَفِیقًا۔","","Musannaf Ibn Abi Shaybah 6257","","","كتاب الجمعة"
"6258","(۶۲۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو إِسْرَائِیلَ إِسْمَاعِیلُ ، عَنْ فُضَیْلِ بْنِ عَمْرٍوَ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃ فِی الْقَمِیصِ الْوَاحِدِ إِذَا کَانَ صَفِیقًا۔","","Musannaf Ibn Abi Shaybah 6258","","","كتاب الجمعة"
"6259","(۶۲۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : أَمَّنَا الْحَکَمُ فِی قَمِیصٍ غَلِیظٍ ، وَقَالَ الْحَکَمُ : لاَ بَأْسَ بِالصَّلاَۃ فِی الْقَمِیصِ الْوَاحِدِ إِذَا کَانَ صَفِیقًا۔","","Musannaf Ibn Abi Shaybah 6259","","","كتاب الجمعة"
"6260","(۶۲۶۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنِ ابْنِ لَہِیعَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ نَوْفَلٍ ، قَالَ : رَأَیْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ یُصَلِّی فِی قَمِیصٍ ، لَیْسَ عَلَیْہِ غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 6260","","","كتاب الجمعة"
"6261","(۶۲۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنِ الرَّجُلِ یُصَلِّی فِی جُبَّۃٍ وَحْدَہَا ، أَوْ قَمِیصٍ صَفِیقٍ ، یُوَارِی عَوْرَتَہُ ، لَیْسَ عَلَیْہِ غَیْرُہُ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 6261","","","كتاب الجمعة"
"6262","(۶۲۶۲) حَدَّثَنَا أَبُوبَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، قَالَ : حدَّثَتْنِی مُلَیْکَۃُ بِنْتُ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّ أَبَاہَا کَانَ یُصَلِّی فِی قَمِیصٍ تَطَوُّعًا بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 6262","","","كتاب الجمعة"
"6263","(۶۲۶۳) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ؛ أَنَّ سَعْدًا صَلَّی بِالنَّاسِ فِی مُسْتُقَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6263","","","كتاب الجمعة"
"6264","(۶۲۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبَانُ بْنُ صَمْعَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃِ فِی الْجُبَّۃِ الْوَاحِدَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 6264","","","كتاب الجمعة"
"6265","(۶۲۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَائِدَۃُ بْنُ قُدَامَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ الصَّلاَۃ فِی الْجُبَّۃِ ؟ قَالَ : وَفِی الْقَمِیصِ إِذَا کَانَ صَفِیقًا۔","","Musannaf Ibn Abi Shaybah 6265","","","كتاب الجمعة"
"6266","(۶۲۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : أَخْبَرَنَا الرَّبِیعُ بْنُ صَبِیحٍ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یُصَلِّی فِی جُبَّۃٍ طَیَالِسَۃٍ ، لَیْسَ عَلَیْہِ إِزَارٌ۔","","Musannaf Ibn Abi Shaybah 6266","","","كتاب الجمعة"
"6267","(۶۲۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحِلٍّ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ یُصَلِّی فِی مُسْتُقَۃٍ ، لاَ یُخْرِجُ یَدَیْہِ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 6267","","","كتاب الجمعة"
"6268","(۶۲۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَیُّمَا امْرَأَۃٍ صَلَّتْ وَلَمْ تُغَطِّ شَعْرَہَا ، لَمْ تُقْبَلْ لَہَا صَلاَۃٌ۔","","Musannaf Ibn Abi Shaybah 6268","","","كتاب الجمعة"
"6269","(۶۲۶۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، رَفَعَہُ ، قَالَ : إِذَا حَاضَتِ الْجَارِیَۃُ ، لَمْ تُقْبَلْ لَہَا صَلاَۃٌ إِلاَّ بِخِمَارٍ۔ (ترمذی ۳۷۷۔ ابوداؤد ۶۴۱)","","Musannaf Ibn Abi Shaybah 6269","","","كتاب الجمعة"
"6270","(۶۲۷۰) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ؛ أَنَّہُ أَرْسَلَ امْرَأَۃً إِلَی عَائِشَۃَ ، فَرَأَتْ جَارِیَۃً لَہَا جَمَّۃٌ ، فَقَالَتْ : لَوِ اسْتَتَرَتْ ہَذِہِ کَانَ أَخْیَرَ ، فَقَالَتْ : إِنَّہَا لَمْ تَحِضْ ، وَلاَ بَدَا بَعْدُ الْحَیْضُ۔","Da'if","Musannaf Ibn Abi Shaybah 6270","","","كتاب الجمعة"
"6271","(۶۲۷۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّ عَائِشَۃَ ، قَالَتْ : دَخَلَ عَلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَعِنْدِی فَتَاۃٌ ، فَأَلْقَی إِلَیَّ حِقْوَہُ ، فَقَالَ : شُقِّیہِ بَیْنَ ہَذِہِ الْفَتَاۃِ وَبَیْنَ الَّتِی عِنْد[corrupt] أُمِّ سَلَمَۃَ ، فَإِنِّی لاَ أُرَاہُمَا إِلاَّ قَدْ حَاضَتَا۔ (ابوداؤد ۶۴۲۔ احمد ۶/۲۳۸)","","Musannaf Ibn Abi Shaybah 6271","","","كتاب الجمعة"
"6272","(۶۲۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ عَلَیْہَا ، فَاخْتَبَأَتْ مَوْلاَۃٌ لَہُمْ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَاضَتْ ؟ فَقَالُوا : نَعَمْ ، فَشَقَّ لَہَا مِنْ عِمَامَتِہِ ، فَقَالَ : اخْتَمِرِی بِہَذَا۔ (ابن ماجہ ۶۵۴)","Da'if","Musannaf Ibn Abi Shaybah 6272","","","كتاب الجمعة"
"6273","(۶۲۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عُثْمَانَ الثَّقَفِیِّ ، عَنْ مَاہَانَ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : إِذَا حَاضَتِ الْجَارِیَۃُ وَجَبَ عَلَیْہَا مَا وَجَبَ عَلَی أُمِّہَا مِنَ التَّسَتُّرِ۔","Hasan","Musannaf Ibn Abi Shaybah 6273","","","كتاب الجمعة"
"6274","(۶۲۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَرْزُوقُ بْنُ عَبْدِ اللہِ مَوْلَی بَنِی زُہْرَۃَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ : مَتَی تُکْتَبُ عَلَی الْجَارِیَۃِ الصَّلاَۃُ ؟ فَقَالَ : إِذَا حَاضَتْ۔","","Musannaf Ibn Abi Shaybah 6274","","","كتاب الجمعة"
"6275","(۶۲۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا حَاضَتِ الْجَارِیَۃُ وَجَبَ عَلَیْہَا مَا وَجَبَ عَلَی أُمِّہَا مِنَ التَّسَتُّرِ۔","","Musannaf Ibn Abi Shaybah 6275","","","كتاب الجمعة"
"6276","(۶۲۷۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا رَبِیعٌ، عَنِ الْحَسَنِ، قَالَ: إِذَا حَاضَتِ الْجَارِیَۃُ لَمْ تُقْبَلْ لَہَا صَلاَۃٌ إِلاَّ بِخِمَارٍ۔","","Musannaf Ibn Abi Shaybah 6276","","","كتاب الجمعة"
"6277","(۶۲۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِذَا حَاضَتِ الْجَارِیَۃُ لَمْ تُقْبَلْ لَہَا صَلاَۃٌ إِلاَّ بِخِمَارٍ۔","","Musannaf Ibn Abi Shaybah 6277","","","كتاب الجمعة"
"6278","(۶۲۷۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مَاہَانَ أَبِی سَالِمٍ ، قَالَ : قالَتْ عَائِشَۃُ : إِذَا احْتَلَمَتِ الْجَارِیَۃُ وَجَبَ عَلَیْہَا مَا وَجَبَ عَلَی أُمِّہَا ۔ یَعْنِی مِنَ التَّسَتُّرِ۔","Sahih","Musannaf Ibn Abi Shaybah 6278","","","كتاب الجمعة"
"6279","(۶۲۷۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ صَفِیَّۃَ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَقْبَلُ اللَّہُ صَلاَۃَ حَائِضٍ إِلاَّ بِخِمَارٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6279","","","كتاب الجمعة"
"6280","(۶۲۸۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا بَلَغَتِ الْمَرْأَۃُ الْحَیْضَ ، وَلَمْ تُغَطِّ أُذُنَیْہَا وَرَأْسَہَا ، لَمْ تُقْبَلْ لَہَا صَلاَۃٌ۔","","Musannaf Ibn Abi Shaybah 6280","","","كتاب الجمعة"
"6281","(۶۲۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، قَالَ : تُصَلِّی کَمَا تَخْرُجُ۔","","Musannaf Ibn Abi Shaybah 6281","","","كتاب الجمعة"
"6282","(۶۲۸۲) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ؛ أَنَّ عَلِیًّا ، وَشُرَیْحًا کَانَا یَقُولاَنِ : تُصَلِّی الأَمَۃُ کَمَا تَخْرُجُ۔","","Musannaf Ibn Abi Shaybah 6282","","","كتاب الجمعة"
"6283","(۶۲۸۳) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ إِبْرَاہِیمَ، قَالَ: تُصَلِّی أُمُّ الْوَلَدِ بِغَیْرِ خِمَارٍ، وَإِنْ کَانَتْ قَدْ بَلَغَتْ سِتِّینَ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 6283","","","كتاب الجمعة"
"6284","(۶۲۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی الأَمَۃِ خِمَارٌ ، وَإِنْ کَانَتْ عَجُوزًا۔","","Musannaf Ibn Abi Shaybah 6284","","","كتاب الجمعة"
"6285","(۶۲۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لَیْسَ عَلَی الأَمَۃِ خِمَارٌ۔","","Musannaf Ibn Abi Shaybah 6285","","","كتاب الجمعة"
"6286","(۶۲۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، قَالَ : تُصَلِّی الأَمَۃُ کَمَا تَخْرُجُ۔","","Musannaf Ibn Abi Shaybah 6286","","","كتاب الجمعة"
"6287","(۶۲۸۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ ، قَالَ : تُصَلِّی الأَمَۃُ کَمَا تَخْرُجُ۔","","Musannaf Ibn Abi Shaybah 6287","","","كتاب الجمعة"
"6288","(۶۲۸۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُجَالِدٍ، عَنِ الشَّعْبِیِّ، عَنْ شُرَیْحٍ ، قَالَ : تُصَلِّی الأَمَۃُ کَمَا تَخْرُجُ۔","","Musannaf Ibn Abi Shaybah 6288","","","كتاب الجمعة"
"6289","(۶۲۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ عَلَی الأَمَۃِ خِمَارٌ ، وَإِنْ وَلَدَتْ مِنْ سَیِّدِہَا۔","","Musannaf Ibn Abi Shaybah 6289","","","كتاب الجمعة"
"6290","(۶۲۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ الأَمَۃَ قَدْ أَلْقَتْ فَرْوَۃَ رَأْسِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 6290","","","كتاب الجمعة"
"6291","(۶۲۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : رَأَی عُمَرُ أَمَۃً لَنَا مُتَقَنِّعَۃً ، فَضَرَبَہَا ، وَقَالَ : لاَ تَتَشَبَّہِینَ بِالْحَرَائِرِ۔","Sahih","Musannaf Ibn Abi Shaybah 6291","","","كتاب الجمعة"
"6292","(۶۲۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : ِإنَّ الأَمَۃَ قَدْ أَلْقَتْ فَرْوَۃَ رَأْسِہَا مِنْ وَرَائِ الْجِدَارِ۔","","Musannaf Ibn Abi Shaybah 6292","","","كتاب الجمعة"
"6293","(۶۲۹۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ الْمَخْزُومِیِّ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، بِمِثْلِ حَدِیثِ وَکِیعٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ۔","","Musannaf Ibn Abi Shaybah 6293","","","كتاب الجمعة"
"6294","(۶۲۹۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَنَسٍ ، قَالَ : رَأَی عُمَرُ جَارِیَۃً مُتَقَنِّعَۃً فَضَرَبَہَا ، وَقَالَ : لاَ تَشَبَّہِینَ بِالْحَرَائِرِ۔","Sahih","Musannaf Ibn Abi Shaybah 6294","","","كتاب الجمعة"
"6295","(۶۲۹۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الْمُخْتَارِ بْنِ فُلْفُلٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : دَخَلَتْ عَلَی عُمَرَ بْنِ الْخَطَّابِ أَمَۃٌ ، قَدْ کَانَ یُعَرِّفُہَا لِبَعْضِ الْمُہَاجِرِینَ ، أَوِ الأَنْصَارِ وَعَلَیْہَا جِلْبَابٌ ، مُتَقَنِّعَۃً بِہِ ، فَسَأَلَہَا : عَتَقْتِ ؟ قَالَتْ : لاَ ، قَالَ : فَمَا بَالُ الْجِلْبَابِ ؟ ضَعِیہِ عَنْ رَأْسِکَ ، إِنَّمَا الْجِلْبَابُ عَلَی الْحَرَائِرِ مِنْ نِسَائِ الْمُؤْمِنِینَ ، فَتَلَکَّأَتْ فَقَامَ إِلَیْہَا بِالدِّرَّۃِ ، فَضَرَبَ بِہَا رَأْسَہَا حَتَّی أَلْقَتْہُ عَنْ رَأْسِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 6295","","","كتاب الجمعة"
"6296","(۶۲۹۶) حَدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلَہُ أَبُو ہُبَیْرَۃَ : کَیْفَ تُصَلِّی الأَمَۃُ ؟ قَالَ : تُصَلِّی کَمَا تَخْرُجُ۔","Da'if","Musannaf Ibn Abi Shaybah 6296","","","كتاب الجمعة"
"6297","(۶۲۹۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : کَانَ عُمَرُ بْنُ الْخَطَّابِ لاَ یَدَعُ فِی خِلاَفَتِہِ أَمَۃً تَقَنَّعُ ۔ قَالَ : وَقَالَ عُمَرُ : إِنَّمَا الْقِنَاعُ لِلْحَرَائِرِ ، لَکَیْ لاَ یُؤْذَیْنَ۔","","Musannaf Ibn Abi Shaybah 6297","","","كتاب الجمعة"
"6298","(۶۲۹۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: حدَّثَنَا عَوْفٌ ، قَالَ: قَدِمَ عَامِلٌ لِمُعَاوِیَۃَ ، وَکَانَ بَعَثَہُ عَلَی الصَّدَقَاتِ ، فَنَزَلَ مَنْزِلاً، فَإِذَا ہُوَ بِمَسْجِدَیْنِ ، قَالَ : أَیُّہُمَا أَقْدَمُ ؟ فَأُخْبِرَ بِہِ ، فَأَتَی الَّذِی ہُوَ أَقْدَمُہُمَا۔","","Musannaf Ibn Abi Shaybah 6298","","","كتاب الجمعة"
"6299","(۶۲۹۹) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ لَیْثٍ ؛ أَنَّ أَبَا وَائِلٍ فَاتَتْہُ الصَّلاَۃ فِی مَسْجِدِ کَذَا وَکَذَا ، فَصَلَّی فِی مَسْجِدِ کَذَا وَکَذَا ، وَبَیْنَہُمَا مَسَاجِدُ کَثِیرَۃٌ مُحْدَثَۃٌ ، لَمْ یُصَلِّ فِیہَا۔","","Musannaf Ibn Abi Shaybah 6299","","","كتاب الجمعة"
"6300","(۶۳۰۰) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عُمَارَۃَ الصَّیْدَلاَنِیِّ ، عَنْ ثَابِتٍ الْبُنَانِیِّ ، قَالَ : کُنْتُ أَکُونُ مَعَ أَنَسٍ ، فَیَأْتِی عَلَی الْمَسْجِدِ فَیَسْمَعُ الأَذَانَ ، فَیَقُولُ : مُحْدَثٌ ہَذَا ؟ فَإِذَا قَالُوا : نَعَمْ ، تَجَاوَزَہُ إِلَی غَیْرِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 6300","","","كتاب الجمعة"
"6301","(۶۳۰۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَتَجَاوَزُ الْمَسَاجِدَ الْمُحْدَثَۃَ إِلَی الْقَدِیمَۃِ۔","","Musannaf Ibn Abi Shaybah 6301","","","كتاب الجمعة"
"6302","(۶۳۰۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عَوْفٍ ، قَالَ : أَخْبَرَنِی رَجُلٌ مِنْ أَہْلِ الْبَادِیَۃِ ، قَالَ : قَدِمَ عَلَیْنَا مُصَدِّقٌ مِنَ الْمَدِینَۃِ ، لَیَالِی مُعَاوِیَۃَ ، فَبَیْنَمَا ہُوَ عَلَی مَائٍ لَنَا ذَاتَ یَوْمٍ ، قَالَ : وَحَضَرَتِ الصَّلاَۃُ ، وَعَلَی الْمَائِ مَسْجِدَانِ مِنْ مَسَاجِدِ أَہْلِ الْبَادِیَۃِ ، قَالَ : أَیُّہُمَا بُنِیَ أَوَّلاً ؟ فَقِیلَ : ہَذَا ، فَقَصَدَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 6302","","","كتاب الجمعة"
"6303","(۶۳۰۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَدَعُ مَسْجِدَ قَوْمِہِ وَیَأْتِی غَیْرَہُ؟ قَالَ: فَقَالَ الْحَسَنُ : کَانُوا یُحِبُّونَ أَنْ یُکَثِّرَ الرَّجُلُ قَوْمَہُ بِنَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 6303","","","كتاب الجمعة"
"6304","(۶۳۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ؛ أَنْ عُمَر دَخَلَ الْمَسْجِد فَرَکَعَ فِیہِ رَکْعَۃً ، فَقَالُوا لَہُ ؟ فَقَالَ : إِنَّمَا ہُوَ تَطَوُّعٌ ، فَمَنْ شَائَ زَاد ، وَمَن شَائَ نَقَصَ۔","Da'if","Musannaf Ibn Abi Shaybah 6304","","","كتاب الجمعة"
"6305","(۶۳۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَابُوسَ بْنِ أَبِی ظَبْیَانَ ، عَنْ أَبِیہِ ؛ أَنْ عُمَرَ بْنَ الْخَطَّابِ مَرَّ فِی الْمَسْجِدِ فَرَکَعَ رَکْعَۃً ، فَقِیلَ لَہُ : إِنَّمَا رَکَعْتَ رَکْعَۃً ؟ فَقَالَ : إِنَّمَا ہُوَ تَطَوُّعٌ ، وَکَرِہْتُ أَنْ أَتَّخِذَہُ طَرِیقًا۔","Da'if","Musannaf Ibn Abi Shaybah 6305","","","كتاب الجمعة"
"6306","(۶۳۰۶) حَدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، قَالَ : حدَّثَنِی مَنْ رَأَی طَلْحَۃَ بْنَ عُبَیْدِ اللہِ مَرَّ فِی الْمَسْجِدِ فَرَکَعَ رَکْعَۃً ، ثُمَّ خَرَجَ۔","Da'if","Musannaf Ibn Abi Shaybah 6306","","","كتاب الجمعة"
"6307","(۶۳۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، قَالَ : أَخْبَرَنَا مَنْ رَأَی طَلْحَۃَ بْنَ عُبَیْدِ اللہِ مَرَّ فِی الْمَسْجِدِ ، فَسَجَدَ سَجْدَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 6307","","","كتاب الجمعة"
"6308","(۶۳۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سَیْفِ بْنِ مَیْسَرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : رَأَیْتُ الزُّبَیْرَ بْنَ الْعَوَّامِ خَرَجَ مِنْ الْقَصْرِ ، فَمَرَّ بِالْمَسْجِدِ فَرَکَعَ رَکْعَۃً ، أَوْ سَجَدَ سَجْدَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 6308","","","كتاب الجمعة"
"6309","(۶۳۰۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَحْوَص بْنِ حَکِیمٍ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلُّونَ وَعَلَیْہِمْ قِسِیُّہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 6309","","","كتاب الجمعة"
"6310","(۶۳۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَحْوَص بْنِ حَکِیمٍ ، قَالَ : حدَّثَنِی رَاشِدُ بْنُ سَعْدٍ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، قَالَ : کَانَ یُقَالُ : السُّیُوفُ أَرْدِیَۃُ الْغُزَاۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 6310","","","كتاب الجمعة"
"6311","(۶۳۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَرَوْنَ أَنَّ السُّیُوفَ بِمَنْزِلَۃِ الرِّدَائِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6311","","","كتاب الجمعة"
"6312","(۶۳۱۲) حَدَّثَنَا ہُشَیمٌ ، عَنْ مُغِیرَۃ ، عَنْ إِبْرَاہِیمَ ، قَالَ : السَیف بِمَنْزِلَۃِ الرِّدَائِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6312","","","كتاب الجمعة"
"6313","(۶۳۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ إِسْرَائِیلَ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ التَّیْمِیَّ یُصَلِّی وَلَیْسَ عَلَیْہِ رِدَائٌ إِلاَّ سَیْفُہُ۔","","Musannaf Ibn Abi Shaybah 6313","","","كتاب الجمعة"
"6314","(۶۳۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُبَیْدَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلُّونَ فِی السُّیُوفِ ، عَلَیْہَا الْکِیْمُخْتُ مِنْ جُلُودِ الْمَیْتَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 6314","","","كتاب الجمعة"
"6315","(۶۳۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ ، عَنِ الْحَسَنِ ، قَالَ : السُّیُوفُ أَرِدْیَۃُ الْغُزَاۃِ۔","","Musannaf Ibn Abi Shaybah 6315","","","كتاب الجمعة"
"6316","(۶۳۱۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، قَالَ : الْقَوْسُ لاَ یُجْزِئُ مَکَانَ الرِّدَائِ۔","","Musannaf Ibn Abi Shaybah 6316","","","كتاب الجمعة"
"6317","(۶۳۱۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عُبَیْدَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْقَوْسُ بِمَنْزِلَۃِ الرِّدَائِ۔","","Musannaf Ibn Abi Shaybah 6317","","","كتاب الجمعة"
"6318","(۶۳۱۸) حَدَّثَنَا عُقْبَۃُ بْنُ خَالِدٍ ، عَنْ مُوسَی بْنِ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، قَالَ : أَخْبَرَنِی أَبِی ، عَنْ سَلَمَۃَ بْنِ الأَکْوَعِ ؛ أَنَّہُ سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الصَّلاَۃ فِی الْقَوْسِ وَالْقَرْنِ ؟ فَقَالَ : صَلِّ فِی الْقَوْسِ ، وَاطْرَحِ الْقَرْنَ۔ (ابویعلی ۳۷۹ )","Da'if","Musannaf Ibn Abi Shaybah 6318","","","كتاب الجمعة"
"6319","(۶۳۱۹) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ إِذَا کَانَ لَیْلَۃٌ مَطِیرَۃٌ ، أَوْ شَدِیدَۃُ الرِّیحِ ، أَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُنَادِیًا فَنَادَی : أَنْ صَلُّوا فِی رِحَالِکُمْ۔ (بخاری ۶۶۶۔ مسلم ۴۸۴)","Da'if","Musannaf Ibn Abi Shaybah 6319","","","كتاب الجمعة"
"6320","(۶۳۲۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ أَبِی الْمَلِیحِ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَامَ الْحُدَیْبِیَۃِ ، أَوْ حُنَیْنٍ فَأَصَابَنَا مَطَرٌ لَمْ یَبُلَّ أَسَافِلَ نِعَالِنَا ، فَنَادَی مُنَادِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنْ صَلُّوا فِی رِحَالِکُمْ۔ (ابوداؤد ۱۰۵۰۔ احمد ۵/۷۵)","Sahih","Musannaf Ibn Abi Shaybah 6320","","","كتاب الجمعة"
"6321","(۶۳۲۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَوْفٌ ، عَنْ أَبِی رَجَائٍ ، قَالَ : أَصَابَنَا مَطَرٌ فِی یَوْمِ جُمُعَۃٍ فِی عَہْدِ ابْنِ عَبَّاسٍ ، فَأَمَرَ مُنَادِیًا فَنَادَی : أَنْ صَلُّوا فِی رِحَالِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 6321","","","كتاب الجمعة"
"6322","(۶۳۲۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمَلِیحِ ، قَالَ : خَرَجْتُ ذَاتَ لَیْلَۃٍ مَطِیرَۃٍ إِلَی الْمَسْجِدِ ، فَلَمَّا رَجَعْتُ اسْتَفْتَحْتُ ، قَالَ أَبِی : مَنْ ہَذَا ؟ قَالُوا : أَبُو الْمَلِیحِ ، قَالَ : لَقَدْ رَأَیْتُنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الْحُدَیْبِیَۃِ ، وَأَصَابَتْنَا سَمَائٌ لَمْ تَبُلَّ أَسَافِلَ نِعَالِنَا ، فَنَادَی مُنَادِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنْ صَلُّوا فِی رِحَالِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 6322","","","كتاب الجمعة"
"6323","(۶۳۲۳) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃَ ؛ أَنَّ یَوْمَ حَنِینٍ کَانَ یَوْمًا مَطِیرًا، فَأَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُنَادِیَہُ : إِنَّ الصَّلاَۃَ فِی الرِّحَالِ۔ (بخاری ۶۱۵۔ احمد ۵/۷۴)","Hasan","Musannaf Ibn Abi Shaybah 6323","","","كتاب الجمعة"
"6324","(۶۳۲۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، قَالَ : کَانَ أُمَرَاؤُنَا إِذَا کَانَتْ لَیْلَۃٌ مَطِیرَۃٌ أَبْطَؤُوا بِالْمَغْرِبِ ، وَعَجَّلُوا الْعِشَائَ قَبْلَ أَنْ یَغِیبَ الشَّفَقُ ، فَکَانَ ابْنُ عُمَرَ یُصَلِّی مَعَہُمْ لاَ یَرَی بِذَلِکَ بَأْسًا ۔ قَالَ عُبَیْدُ اللہِ : وَرَأَیْتُ الْقَاسِمَ وَسَالِمًا یُصَلِّیَانِ مَعَہُمْ فِی مِثْلِ تِلْکَ اللَّیْلَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 6324","","","كتاب الجمعة"
"6325","(۶۳۲۵) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یُصَلِّی مَعَ الأَئِمَّۃِ حِینَ یَجْمَعُونَ بَیْنَ الْمَغْرِبِ وَالْعِشَائِ فِی اللَّیْلَۃِ الْمَطِیرَۃِ۔","","Musannaf Ibn Abi Shaybah 6325","","","كتاب الجمعة"
"6326","(۶۳۲۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ ہِشَامِ بْنِ عَرُوَۃَ ، قَالَ : رَأَیْتُ أَبَانَ بْنَ عُثْمَانَ یَجْمَعُ بَیْنَ الصَّلاَتَیْنِ فِی اللَّیْلَۃِ الْمَطِیرَۃِ ؛ الْمَغْرِبِ وَالْعِشَائِ ، فَیُصَلِّیہِمَا مَعہ عُرْوَۃُ بْنُ الزُّبَیْرِ وَسَعِیدُ بْنُ الْمُسَیَّبِ ، وَأَبُو بَکْرِ بْنُ عَبْدِ الرَّحْمَنِ ، وَأَبُو سَلَمَۃَ بْنُ عَبْدِ الرَّحْمَنِ ، لاَ یُنْکِرُونَہُ۔","","Musannaf Ibn Abi Shaybah 6326","","","كتاب الجمعة"
"6327","(۶۳۲۷) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ أَبِی مَوْدُودٍ عَبْدِ الْعَزِیزِ بْنِ أَبِی سُلَیْمَانَ ، قَالَ : صَلَّیْتُ مَعَ أَبِی بَکْرِ بْنِ مُحَمَّدٍ الْمَغْرِبَ وَالْعِشَائَ ، فَجَمَعَ بَیْنَہُمَا فِی لَیْلَۃٍ مَطِیرَۃٍ۔","","Musannaf Ibn Abi Shaybah 6327","","","كتاب الجمعة"
"6328","(۶۳۲۸) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یُصَلِّی مَعَ مَرْوَانَ ، وَکَانَ مَرْوَانُ إِذَا کَانَتْ لَیْلَۃٌ مَطِیرَۃٌ جَمَعَ بَیْنَ الْمَغْرِبِ وَالْعِشَائِ ، وَکَانَ ابْنُ عُمَرَ یُصَلِّیہِمَا مَعَہُ۔","","Musannaf Ibn Abi Shaybah 6328","","","كتاب الجمعة"
"6329","(۶۳۲۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : أَخْبَرَنِی مَالِکُ بْنُ أَنَسٍ ، عَنْ دَاوُدَ بْنِ حُصَیْنٍ ، قَالَ : أَخْبَرَنِی مُخْبِرٌ ، عَنِ ابْنِ عَبَّاسٍ ؛ فِی قَوْلِہِ تَبَارَکَ وَتَعَالَی : {لِدُلُوکِ الشَّمْسِ} قَالَ : إِذَا فَائَ الْفَیئُ۔ {وَاللَّیْلِ وَمَا وَسَقَ} قَالَ : وَمَا جَمَعَ۔","Da'if","Musannaf Ibn Abi Shaybah 6329","","","كتاب الجمعة"
"6330","(۶۳۳۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : {دُلُوکُ الشَّمْسِ} مَیْلُہَا بَعْدَ نِصْفِ النَّہَارِ۔","Sahih","Musannaf Ibn Abi Shaybah 6330","","","كتاب الجمعة"
"6331","(۶۳۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ : {أَقِمِ الصَّلاَۃ لِدُلُوکِ الشَّمْسِ إِلَی غَسَقِ اللَّیْلِ} قَالَ : دُلُوکُہَا غُرُوبُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 6331","","","كتاب الجمعة"
"6332","(۶۳۳۲) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا إِبْرَاہِیمُ بْنُ نَافِعٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ : {أَقِمِ الصَّلاَۃ لِدُلُوکِ الشَّمْسِ} قَالَ : دُلُوکُہَا قَبْلَ أَنْ تَغِیبَ۔","","Musannaf Ibn Abi Shaybah 6332","","","كتاب الجمعة"
"6333","(۶۳۳۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ بْنُ عَبْدِ الْمَلِکِ ، قَالَ : حَدَّثَنِی یُونُسُ بْنُ خَبَّابٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کُنْتُ أَقُودُ مَوْلاَیَ السَّائِبَ ، وَہُوَ أَعْمَی ، فَیَقُولُ لِی : یَا مُجَاہِدُ ، أَدَلَکَتِ الشَّمْسُ ؟ فَإِذَا قُلْتُ نَعَمْ ، قَامَ فَصَلَّی الظُّہْرَ۔","","Musannaf Ibn Abi Shaybah 6333","","","كتاب الجمعة"
"6334","(۶۳۳۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ جَالِسًا مَعَ عَبْدِ اللہِ فِی بَیْتِہِ ، فَوَجَبَتِ الشَّمْسُ ، فَقَالَ عَبْدُ اللہِ : {أَقِمِ الصَّلاَۃ لِدُلُوکِ الشَّمْسِ إِلَی غَسَقِ اللَّیْلِ} ثُمَّ قَالَ : ہَذَا وَاللَّہِ الَّذِی لاَ إِلَہَ غَیْرُہُ حِینَ أَفْطَرَ الصَّائِمُ ، وَبَلَغَ وَقْتُ ہَذِہِ الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 6334","","","كتاب الجمعة"
"6335","(۶۳۳۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : دُلُوکُہَا مَیْلُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 6335","","","كتاب الجمعة"
"6336","(۶۳۳۶) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ یَعْقُوبَ الْقُمِّیِّ ، عَنْ جَعْفَرِ بْنِ أَبِی الْمُغِیرَۃِ ، قَالَ : دُلُوکُہَا زَوَالُہَا۔","","Musannaf Ibn Abi Shaybah 6336","","","كتاب الجمعة"
"6337","(۶۳۳۷) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ أَبِی کُدَیْنَۃَ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : دُلُوکُہَا زَوَالُہَا۔","","Musannaf Ibn Abi Shaybah 6337","","","كتاب الجمعة"
"6338","(۶۳۳۸) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : دُلُوکُ الشَّمْسِ حَتَّی تَزِیغَ ، وَغَسَقُ اللَّیْلِ غُرُوبُ الشَّمْسِ۔","Sahih","Musannaf Ibn Abi Shaybah 6338","","","كتاب الجمعة"
"6339","(۶۳۳۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حَدَّثَنَا أَبو العُمَیْس ، قَالَ : حَدَّثَنِی وَبَرَۃ ، عَنْ سَعِیدِ بن جُبَیرٍ ، عَنْ عَبْدِ اللہِ ، وَابْنِ عَبَّاسٍ ، قَالاَ : دُلُوکُہَا حِینَ تَغْرُبُ۔","Sahih","Musannaf Ibn Abi Shaybah 6339","","","كتاب الجمعة"
"6340","(۶۳۴۰) حدَّثَنَا إِسْحَاقُ بن سُلَیْمَان ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلِیٍّ ، قَالَ : دُلُوکُہَا غُرُوبُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 6340","","","كتاب الجمعة"
"6341","(۶۳۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْقَاسِمِ ؛ قَالَ : ذَہَبَ بَصَرُ عُبَیْدِ اللہِ بْنِ عُتْبَۃَ فَأَتَی الطَّبِیبُ ، فَقَالَ : أُدَاوِیَکَ عَلَی أَنْ تَسْتَلْقِیَ سَبْعَۃَ أَیَّامٍ ، وَلاَ تُصَلِّی إِلاَّ مُضْطَجِعًا ، فَأَبَی وَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 6341","","","كتاب الجمعة"
"6342","(۶۳۴۲) حَدَّثَنَا ابن مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ؛ أَنَّہُ وَقَع فِی عَیْنَیْہِ الْمَائُ، فَقِیلَ لَہُ: تَسْتَلْقِی سَبْعًا ، فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 6342","","","كتاب الجمعة"
"6343","(۶۳۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَمَّا کُفَّ بَصَرُہُ أَتَاہُ رَجُلٌ ، فَقَالَ لَہُ : إِنْ صَبَرْتَ لِی سَبْعًا لاَ تُصَلِّی إِلاَّ مُسْتَلْقِیًا دَاوَیْتُک ، وَرَجَوْتُ أَنْ تَبْرَأَ عَیْنُک ۔ قَالَ: فَأَرْسَلَ ابْنُ عَبَّاسٍ إِلَی عَائِشَۃَ ، وَأَبِی ہُرَیْرَۃَ ، وَغَیْرِہِمَا مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: فَکُلُّہُمْ یَقُولُونَ: أَرَأَیْتَ إِنْ مِتَّ فِی ہَذِہِ السَّبْعِ، کَیْفَ تَصْنَعُ بِالصَّلاَۃ؟ قَالَ: فَتَرَکَ عَیْنَیْہِ، فَلَمْ یُدَاوِہَا۔","","Musannaf Ibn Abi Shaybah 6343","","","كتاب الجمعة"
"6344","(۶۳۴۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی الضُّحَی ؛ أَنَّ ابْنَ عَبَّاسٍ أُوقِعَ فِی عَیْنَیْہِ الْمَائُ ، فَقِیلَ لَہُ : أَتَسْتَلْقِی سَبْعًا ، وَلاَ تُصَلِّی إِلاَّ مُسْتَلْقِیًا ؟ فَبَعَثَ إِلَی عَائِشَۃَ ، وَأَمِّ سَلَمَۃَ ، فَسَأَلَہُمَا ، فَنَہَتَاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 6344","","","كتاب الجمعة"
"6345","(۶۳۴۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ إِسْمَاعِیلَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ، قَالَ : إِذَا کَانَ یَوْمُ الْغَیْمِ ، فَعَجِّلُوا الْعَصْرَ وَأَخِّرُوا الظُّہْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 6345","","","كتاب الجمعة"
"6346","(۶۳۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَجِّلُوا صَلاَۃَ النَّہَارِ فِی یَوْمِ الْغَیْمِ ، وَأَخِّرُوا الْمَغْرِبَ۔","","Musannaf Ibn Abi Shaybah 6346","","","كتاب الجمعة"
"6347","(۶۳۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا قَیْسٌ ، عَنْ أَبِی حَصِینٍ ، عَنْ حِزَامِ بْنِ جَابِرٍ ، قَالَ : سَمِعْتُ ابْنَ مَسْعُودٍ ، یَقُولُ : إِذَا کَانَ یَوْمُ الْغَیْمِ فَعَجِّلُوا الظُّہْرَ ، وَأَخِّرُوا الْعَصْرَ ، وَأَخِّرُوا الْمَغْرِبَ۔","Da'if","Musannaf Ibn Abi Shaybah 6347","","","كتاب الجمعة"
"6348","(۶۳۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَوْزَاعِیُّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَاجِرِ ، عَنْ بُرَیْدَۃَ الأَسْلَمِیِّ ، قَالَ : کُنَّا مَعَہُ فِی غُزَاۃٍ ، فَقَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : بَکِّرُوا بِالصَّلاَۃ فِی الْیَوْمِ الْغَیْمِ ، فَإِنَّہُ مَنْ فَاتَتْہُ صَلاَۃُ الْعَصْرِ حَبِطَ عَمَلُہُ۔ (ابن ماجہ ۶۹۴۔ احمد ۳۶۱)","Sahih","Musannaf Ibn Abi Shaybah 6348","","","كتاب الجمعة"
"6349","(۶۳۴۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ یَحْیَی ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمَلِیحِ ، عَنْ بُرَیْدَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِنَحْوٍ مِنْہُ۔ (بخاری ۵۹۴۔ احمد ۵/۴۳۹)","Sahih","Musannaf Ibn Abi Shaybah 6349","","","كتاب الجمعة"
"6350","(۶۳۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ بَکْرِ بْنِ مَاعِزٍ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ، أَنَّہُ قَالَ لِمُؤَذِّنِہِ : إِذَا کَانَ یَوْمُ الْغَیْمِ فَاغْسِقْ بِالْمَغْرِبِ۔","","Musannaf Ibn Abi Shaybah 6350","","","كتاب الجمعة"
"6351","(۶۳۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یُعْجِبُہُ فِی یَوْمِ الْغَیْمِ أَنْ یُؤَخِّرَ الظُّہْرَ ، وَیُعَجِّلَ الْعَصْرَ۔","","Musannaf Ibn Abi Shaybah 6351","","","كتاب الجمعة"
"6352","(۶۳۵۲) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، قَالَ : یُعَجَّلُ الْعَصْرُ یَوْمَ الْغَیْمِ ، وَیُؤَخَّرُ الْمَغْرِبُ۔","","Musannaf Ibn Abi Shaybah 6352","","","كتاب الجمعة"
"6353","(۶۳۵۳) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُعَجَّلُ الْعَصْرُ وَیُؤَخَّرُ الْمَغْرِبُ۔","","Musannaf Ibn Abi Shaybah 6353","","","كتاب الجمعة"
"6354","(۶۳۵۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 6354","","","كتاب الجمعة"
"6355","(۶۳۵۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ؛ (کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ) قَالَ : لاَ یَنَامُونَ عَنِ الْعِشَائِ الآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 6355","","","كتاب الجمعة"
"6356","(۶۳۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ؛ {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ ، وَبِالأَسْحَارِ ہُمْ یَسْتَغْفِرُونَ} قَالَ : صَلَّوْا ، فَلَمَّا کَانَ السَّحَرُ اسْتَغْفَرُوا۔","","Musannaf Ibn Abi Shaybah 6356","","","كتاب الجمعة"
"6357","(۶۳۵۷) حَدَّثَنَا حُمَیْدٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ اللہِ بْنِ رَوَاحَۃَ ؛ {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ} قَالَ : ہَجَعُوا قَلِیلاً ، ثُمَّ مَدُّوہَا إِلَی السَّحَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 6357","","","كتاب الجمعة"
"6358","(۶۳۵۸) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ} ، قَالَ : ذَلِکَ إِذْ أُمِرُوا بِقِیَامِ اللَّیْلِ ، فَکَانَ أَبُو ذَرٍّ یَحْتَجِزُ احْتِجَازَہُ ، وَیَأْخُذُ الْعَصَا فَیَعْتَمِدُ عَلَیْہَا ، فَکَانُوا کَذَلِکَ حَتَّی نَزَلَتِ الرُّخْصَۃُ: {فَاقَرَؤُوا مَا تَیَسَّرَ مِنْہُ}۔","","Musannaf Ibn Abi Shaybah 6358","","","كتاب الجمعة"
"6359","(۶۳۵۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا بُکَیْر بْنُ أَبِی السُّمَیْطِ ، قَالَ : حَدَّثَنَا قَتَادَۃُ ؛ فِی قَوْلِہِ تَعَالَی : {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ} قَالَ : کَانَ الْحَسَنُ ، یَقُولُ : قَلِیلاً مِنَ اللَّیْلِ مَا یَنَامُونَ ۔ وَکَانَ مُطَرِّفُ بْنُ عَبْدِ اللہِ ، یَقُولُ : کَانُوا قَلَّ لَیْلَۃٍ إِلاَّ یُصِیبُونَ مِنْہَا ۔ وَکَانَ مُحَمَّدُ بْنُ عَلِیٍّ ، یَقُولُ : لاَ یَنَامُونَ حَتَّی یُصَلُّوا الْعَتَمَۃَ۔","","Musannaf Ibn Abi Shaybah 6359","","","كتاب الجمعة"
"6360","(۶۳۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، قَالَ : قلَّ لَیْلَۃٍ أَتَتْ عَلَیْہِمْ ہَجَعُوہَا کُلَّہَا۔","","Musannaf Ibn Abi Shaybah 6360","","","كتاب الجمعة"
"6361","(۶۳۶۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ أَبِی بِسْطَامٍ ، عَنِ الضَّحَّاکِ ، قَالَ : {الْمُتَّقِینَ} ہُمُ الْقَلِیلُ۔","","Musannaf Ibn Abi Shaybah 6361","","","كتاب الجمعة"
"6362","(۶۳۶۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ؛ {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ} قَالَ : ہَجَعُوا قَلِیلاً ، ثُمَّ مَدُّوہَا إِلَی السَّحَرِ۔","","Musannaf Ibn Abi Shaybah 6362","","","كتاب الجمعة"
"6363","(۶۳۶۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَوْفٍ ، عَنْ سَعِیدِ بْنِ أَبِی الْحَسَنِ ، قَالَ : قلَّ لَیْلَۃً أَتَتْ عَلَیْہِمْ ہَجَعُوہَا۔","","Musannaf Ibn Abi Shaybah 6363","","","كتاب الجمعة"
"6364","(۶۳۶۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانُوا لاَ یَنَامُونَ کُلَّ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 6364","","","كتاب الجمعة"
"6365","(۶۳۶۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ} قَالَ : قلَّ لَیْلَۃً تَمُرُّ بِہِمْ إِلاَّ صَلَّوْا فِیہَا۔","Da'if","Musannaf Ibn Abi Shaybah 6365","","","كتاب الجمعة"
"6366","(۶۳۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنِ الضَّحَّاکِ ، قَالَ : {کَانُوا} مِنَ النَّاسِ قَلِیلٌ۔","","Musannaf Ibn Abi Shaybah 6366","","","كتاب الجمعة"
"6367","(۶۳۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ؛ {کَانُوا قَلِیلاً مِنَ اللَّیْلِ مَا یَہْجَعُونَ} قَالَ : مَا یَنَامُونَ۔","","Musannaf Ibn Abi Shaybah 6367","","","كتاب الجمعة"
"6368","(۶۳۶۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ؛ قَالَ : {کَانُوا قَلِیلاً ما یَنَا[corrupt]ُونَ لَیْلَۃً حَتَّی الصَّبَاحِ}۔","","Musannaf Ibn Abi Shaybah 6368","","","كتاب الجمعة"
"6369","(۶۳۶۹) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، قَالَ : سَمِعْتُ الْحَسَنَ ، وَسُئِلَ عَنِ الثَّوْبِ یَخْرُجُ مِنَ النَّسَّاجِ ، یُصَلَّی فِیہِ ؟ قَالَ : نَعَمْ ۔ قَالَ : وَسَمِعْتُ ابْنَ سِیرِینَ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 6369","","","كتاب الجمعة"
"6370","(۶۳۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا رَبِیعٌ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِالصَّلاَۃ فِی رِدَائِ الْیَہُودِیِّ وَالنَّصْرَانِیِّ۔","","Musannaf Ibn Abi Shaybah 6370","","","كتاب الجمعة"
"6371","(۶۳۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَلِیُّ بْنُ صَالِحٍ ، عَنْ عَطَائٍ أَبِی مُحَمَّدٍ ، قَالَ : رَأَیْتُ عَلَی عَلِیٍّ قَمِیصًا مِنْ ہَذِہِ الْکَرَابِیسِ ، غَیْرَ غَسِیلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6371","","","كتاب الجمعة"
"6372","(۶۳۷۲) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ جَابِرَ بْنِ عَبْدِ اللہِ صَلَّی فِی ثَوْبٍ نَسِیجٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6372","","","كتاب الجمعة"
"6373","(۶۳۷۳) حَدَّثَنَا أَبُو مَالِکٍ الْجَنْبِیُّ عَمْرُو بْنُ ہَاشِمٍ ، عَنْ عَبْدِ اللہِ ، عَنْ عَطَائٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرَ عَنِ الثَّوْبِ یَحُوکُہُ الْیَہُودِیُّ وَالنَّصْرَانِیُّ ، یُصَلَّی فِیہِ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 6373","","","كتاب الجمعة"
"6374","(۶۳۷۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ تَمِیمِ بْنِ طَرَفَۃَ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیَنْتَہِیَنَّ أَقْوَامٌ یَرْفَعُونَ أَبْصَارَہُمْ إِلَی السَّمَائِ فِی الصَّلاَۃ ، أَوْ لاَ تَرْجِعُ إِلَیْہِمْ۔ (مسلم ۱۱۷۔ احمد ۵/۱۰۸)","Sahih","Musannaf Ibn Abi Shaybah 6374","","","كتاب الجمعة"
"6375","(۶۳۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : مَا بَالُ أَقْوَامٍ یَرْفَعُونَ أَبْصَارَہُمْ إِلَی السَّمَائِ فِی صَلاَتِہِمْ ، فَاشْتَدَّ فِی ذَلِکَ حَتَّی قَالَ : لَیَنْتَہُنَّ عَنْ ذَلِکَ ، أَوْ لَتُخْطَفَنَّ أَبْصَارُہُمْ۔ (بخاری ۷۵۰۔ ابوداؤد ۹۱۰)","Sahih","Musannaf Ibn Abi Shaybah 6375","","","كتاب الجمعة"
"6376","(۶۳۷۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمَّارٍ الْعَبْسِیِّ ، قَالَ : سَمِعْتُ ابْنَ یَسَارٍ ، یَقُولُ : قَالَ حُذَیْفَۃُ : أَمَا یَخْشَی أَحَدُکُمْ إِذَا رَفَعَ بَصَرَہُ إِلَی السَّمَائِ أَنْ لاَ یَرْجِعَ إِلَیْہِ بَصَرُہُ ۔ یَعْنِی وَہُوَ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 6376","","","كتاب الجمعة"
"6377","(۶۳۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، وَسُفْیَانَ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : لَیَنْتَہِیَنَّ أَقْوَامٌ یَرْفَعُونَ أَبْصَارَہُمْ إِلَی السَّمَائِ فِی الصَّلاَۃ ، أَوْ لاَ تَرْجِعُ إِلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 6377","","","كتاب الجمعة"
"6378","(۶۳۷۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ؛ أَنَّہُ رَأَی رَجُلاً رَافِعًا بَصَرَہُ إِلَی السَّمَائِ ، فَقَالَ عَبْدُ اللہِ : مَا یَدْرِی ہَذَا ؟ لَعَلَّ بَصَرَہُ سَیَلْتَمِعُ قَبْلَ أَنْ یَرْجِعَ إِلَیْہِ۔","","Musannaf Ibn Abi Shaybah 6378","","","كتاب الجمعة"
"6379","(۶۳۷۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ عُتْبَۃَ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ رَأَی رَجُلاً قَدْ رَفَعَ یَدَہُ وَبَصَرَہُ إِلَی السَّمَائِ ، فَقَالَ : اُکْفُفْ یَدَک ، وَاخْفِضْ مِنْ بَصَرِکَ ، فَإِنَّک لَنْ تَرَاہُ ، وَلَنْ تَنَالَہُ۔","","Musannaf Ibn Abi Shaybah 6379","","","كتاب الجمعة"
"6380","(۶۳۸۰) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِمَّا یَنْظُرُ إِلَی الشَّیْئِ فِی الصَّلاَۃ ، فَیَرْفَعُ بَصَرَہُ حَتَّی نَزَلَتْ آیَۃٌ ، إِنْ لَمْ تَکُنْ ہَذِہِ فَلاَ أَدْرِی مَا ہِیَ : {الَّذِینَ ہُمْ فِی صَلاَتِہِمْ خَاشِعُونَ} ، قَالَ : فَوَضَعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأْسَہُ۔ (ابوداؤد ۴۵۔ عبدالرزاق ۳۲۶۲)","","Musannaf Ibn Abi Shaybah 6380","","","كتاب الجمعة"
"6381","(۶۳۸۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَا رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسْرِعُ إِلَی شَیْئٍ مِنَ النَّوَافِلِ ، مِثْلَ إِسْرَاعِہِ إِلَی رَکْعَتَیِ الْفَجْرِ ، وَلاَ إِلَی غَنِیمَۃٍ۔ (بخاری ۱۱۶۹۔ ابوداؤد ۱۲۴۸)","Sahih","Musannaf Ibn Abi Shaybah 6381","","","كتاب الجمعة"
"6382","(۶۳۸۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ عَبْدِ رَبِّہِ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : لاَ تَدَعْ رَکْعَتَیِ الْفَجْرِ ، وَلَوْ طَرَقَتْک الْخَیْلُ۔","Da'if","Musannaf Ibn Abi Shaybah 6382","","","كتاب الجمعة"
"6383","(۶۳۸۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ قَالَ : یَا حُمْرَانُ ، لاَ تَدَعْ رَکْعَتَیْنِ قَبْلَ الْفَجْرِ ، فَإِنَّ فِیہِمَا الرَّغَائِبُ۔","Sahih","Musannaf Ibn Abi Shaybah 6383","","","كتاب الجمعة"
"6384","(۶۳۸۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قَالَ عُمَرُ فِی الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ : لَہُمَا أَحَبُّ إِلَیَّ مِنْ حُمْرِ النَّعَمِ۔","","Musannaf Ibn Abi Shaybah 6384","","","كتاب الجمعة"
"6385","(۶۳۸۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ مَیْمُونٍ ، یَقُولُ : کَانُوا لاَ یَتْرُکُونَ أَرْبَعًا قَبْلَ الظُّہْرِ ، وَرَکْعَتَیْنِ قَبْلَ الْفَجْرِ عَلَی حَالٍ۔","","Musannaf Ibn Abi Shaybah 6385","","","كتاب الجمعة"
"6386","(۶۳۸۶) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : بَلَغَنِی أَنَّ عَائِشَۃَ کَانَتْ تَقُولُ : حَافِظُوا عَلَی رَکْعَتَیِ الْفَجْرِ ، فَإِنَّ فِیہِمَا الْخَیْرُ وَالرَّغَائِبُ۔","Da'if","Musannaf Ibn Abi Shaybah 6386","","","كتاب الجمعة"
"6387","(۶۳۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا صَلاَّہُمَا ، أَوْ أَحَدَہُمَا ثُمَّ مَاتَ ، أَجْزَأَہُ مِنْ رَکْعَتَیِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6387","","","كتاب الجمعة"
"6388","(۶۳۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : إِذَا صَلَّی رَکْعَتَیِ الْفَجْرِ ثُمَّ مَاتَ ، فَکَأَنَّمَا صَلَّی الْفَجْرَ۔","","Musannaf Ibn Abi Shaybah 6388","","","كتاب الجمعة"
"6389","(۶۳۸۹) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ یَرَی الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ وَاجِبَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6389","","","كتاب الجمعة"
"6390","(۶۳۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ سَعدِ بْنِ ہِشَامٍ ، عَنْ عَائِشَۃَ ، قَالَتْ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَکْعَتَا الْفَجْرِ خَیْرٌ مِنَ الدُّنْیَا وَمَا فِیْہَا۔ (مسلم ۵۰۱۔ ترمذی ۴۱۶)","Sahih","Musannaf Ibn Abi Shaybah 6390","","","كتاب الجمعة"
"6391","(۶۳۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی الرَّکْعَتَیْنِ عِنْدَ الإِقَامَۃِ ، بَیْنَ الأَذَانِ وَالإِقَامَۃِ۔ (بخاری ۶۱۹۔ مسلم ۵۰۱)","","Musannaf Ibn Abi Shaybah 6391","","","كتاب الجمعة"
"6392","(۶۳۹۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، وَشَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی الرَّکْعَتَیْنِ عِنْدَ الأَذَانِ۔ قَالَ أَحَدُہُمَا: وَیُوتِرُ عِنْدَ الإِقَامَۃِ۔ (ابن ماجہ ۱۱۴۷۔ احمد ۱/۷۷)","Da'if","Musannaf Ibn Abi Shaybah 6392","","","كتاب الجمعة"
"6393","(۶۳۹۳) حَدَّثَنَا عَلِیُّ بْنُ الْجَعْدِ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی رَکْعَتَیِ الْفَجْرِ ، وَکَأَنَّ الأَذَانُ عِنْدَ أُذُنَیْہِ۔ (بخاری ۹۹۵۔ ترمذی ۴۶۱)","Sahih","Musannaf Ibn Abi Shaybah 6393","","","كتاب الجمعة"
"6394","(۶۳۹۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَکْثَرَ مِنْ عِشْرِینَ مَرَّۃً ، یَقْرَأُ فِی الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ وَالرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔ (عبدالرزاق ۴۷۹۰۔ نسائی۱۰۶۴)","Sahih","Musannaf Ibn Abi Shaybah 6394","","","كتاب الجمعة"
"6395","(۶۳۹۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی رَکْعَتَیِ الْفَجْرِ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ} یُسِرُّ فِیہِمَا الْقِرَائَۃَ۔ (احمد ۶/۱۸۴۔ عبدالرزاق ۴۷۸۸)","","Musannaf Ibn Abi Shaybah 6395","","","كتاب الجمعة"
"6396","(۶۳۹۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ سَعِیدِ بْنِ یَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی رَکْعَتَیِ الْفَجْرِ ، فِی الأُولَی : {قُولُوا آمَنَّا بِاللَّہِ وَمَا أُنْزِلَ إِلَیْنَا} الآیَۃَ ، وَفِی الثَّانِیَۃِ : {تَعَالَوْا إِلَی کَلِمَۃٍ سَوَائٍ بَیْنَنَا وَبَیْنَکُمْ}۔ (مسلم ۱۰۰۔ ابوداؤد ۱۲۵۳)","Hasan","Musannaf Ibn Abi Shaybah 6396","","","كتاب الجمعة"
"6397","(۶۳۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، وَغُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ یَقْرَأُ فِی الرَّکْعَتَیْنِ قَبْلَ صَلاَۃِ الصُّبْحِ ۔ أَوَ قَالَ : قَبْلَ الْغَدَاۃِ بـ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ} ۔ زَادَ غُنْدَرٌ : وَفِی الرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ۔","","Musannaf Ibn Abi Shaybah 6397","","","كتاب الجمعة"
"6398","(۶۳۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی السَّلِیلِ ، عَنْ غُنَیْمِ بْنِ قَیْسٍ ، قَالَ : کُنَّا نُؤْمَرُ أَنْ نُنَابِذَ الشَّیْطَانَ فِی الرَّکْعَتَیْنِ قَبْلَ الصُّبْحِ ، أَوْ قَبْلَ الْغَدَاۃِ بِـ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","","Musannaf Ibn Abi Shaybah 6398","","","كتاب الجمعة"
"6399","(۶۳۹۹) حَدَّثَنَا عَبَّادٌ ، عَنْ حُصَیْنٍ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أنَّہُ کَانَ یَقْرَأُ فِی الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ وَالرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ : بـ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","","Musannaf Ibn Abi Shaybah 6399","","","كتاب الجمعة"
"6400","(۶۴۰۰) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : حدَّثَنِی عَبْدُ اللَّہِ بْنِ مُحَمَّدِ بْنِ سِیرِینَ ؛ عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","","Musannaf Ibn Abi Shaybah 6400","","","كتاب الجمعة"
"6401","(۶۴۰۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَقْرَؤُونَ فِیہِمَا بِـ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","","Musannaf Ibn Abi Shaybah 6401","","","كتاب الجمعة"
"6402","(۶۴۰۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یَقْرَؤُونَ فِی الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ ، وَالرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ : {قُلْ لِّلَّذِینَ کَفَرُوا} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","","Musannaf Ibn Abi Shaybah 6402","","","كتاب الجمعة"
"6403","(۶۴۰۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ حَکِیمٍ الْحَضْرَمِیِّ ، عَنْ طَلْحَۃَ ، عَنْ سُویْدِ بْنِ غَفَلَۃَ ؛ أنَّہُ کَانَ یَقْرَأُ فِی الرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ بِـ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","","Musannaf Ibn Abi Shaybah 6403","","","كتاب الجمعة"
"6404","(۶۴۰۴) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الرَّکْعَتَیْنِ قَبْلَ الصُّبْحِ : {إِذَا زُلْزِلَت} وَ{الْعَادِیَاتِ} ، وَفِی الرَّکْعَتَیْنِ بَعْدَ الْعِشَائِ : {آمَنَ الرَّسُولُ۔۔۔} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","","Musannaf Ibn Abi Shaybah 6404","","","كتاب الجمعة"
"6405","(۶۴۰۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ وَالرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ : {قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","","Musannaf Ibn Abi Shaybah 6405","","","كتاب الجمعة"
"6406","(۶۴۰۶) حَدَّثَنَا وَکِیعٌ ، حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُخَفِّفُ رَکْعَتَیِ الْفَجْرِ۔ (بخاری ۶۲۶۔ مسلم ۵۰۰)","Sahih","Musannaf Ibn Abi Shaybah 6406","","","كتاب الجمعة"
"6407","(۶۴۰۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إِذَا طَلَعَ الْفَجْرُ صَلَّی رَکْعَتَیْنِ خَفِیفَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 6407","","","كتاب الجمعة"
"6408","(۶۴۰۸) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن خَالِدٍ ، عَنْ مُحَمَّدٍ ، قَالَ : قالَتْ عَائِشَۃُ : کَانَ قِیَامُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الرَّکْعَتَیْنِ قَبْلَ صَلاَۃِ الصُّبْحِ ، قَدْرَ فَاتِحَۃِ الْکِتَابِ۔ (احمد ۲۱۷)","","Musannaf Ibn Abi Shaybah 6408","","","كتاب الجمعة"
"6409","(۶۴۰۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَبِی یَعْفُورٍ ، عَنْ إِبْرَاہِیمَ، عَن صِلَۃَ، قَالَ: أَتَیْتُ حُذَیْفَۃَ فِی دَارِہِ، ثُمَّ أَتَیْنَا الْمَسْجِدَ ، فَصَلَّی رَکْعَتَیْنِ خَفِیفَتَیْنِ ، ثُمَّ أُقِیمَتِ الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 6409","","","كتاب الجمعة"
"6410","(۶۴۱۰) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا لاَ یَزِیدَانِ إِذَا طَلَعَ الْفَجْرُ عَلَی رَکْعَتَیْنِ خَفِیفَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6410","","","كتاب الجمعة"
"6411","(۶۴۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی لَبِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَتَا تُخَفِّفَانِ الرَّکْعَتَانِ قَبْلَ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6411","","","كتاب الجمعة"
"6412","(۶۴۱۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ حَفْصَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّی إِذَا طَلَعَ الْفَجْرُ رَکْعَتَیْنِ خَفِیفَتَیْنِ۔ (حمیدی ۲۸۸)","Da'if","Musannaf Ibn Abi Shaybah 6412","","","كتاب الجمعة"
"6413","(۶۴۱۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَخْبَرَتْنِی حَفْصَۃُ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُصَلِّیہِمَا سَجْدَتَیْنِ خَفِیفَتَیْنِ ، إِذَا طَلَعَ الْفَجْرُ۔ (بخاری ۱۱۷۳۔ مسلم ۸۹)","Sahih","Musannaf Ibn Abi Shaybah 6413","","","كتاب الجمعة"
"6414","(۶۴۱۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أُمِّہِ عَمْرَۃَ ، عَنْ عَائِشَۃَ، قَالَتْ : إِنْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَیُصَلِّی الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ ، فَیُخَفِّفُہُمَا حَتَّی إِنْ کُنْتُ لأَقُولُ : أَقَرَأَ فِیہِمَا بِأُمِّ الْکِتَابِ ؟۔(بخاری ۱۱۷۱۔ احمد ۶/۲۳۵)","Sahih","Musannaf Ibn Abi Shaybah 6414","","","كتاب الجمعة"
"6415","(۶۴۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو حُمَیْدٍ ، سَمِعَہُ مِنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِیہِ ، قَالَ : مَا رَأَیْتُ أَبِی یُصَلِّیہِمَا قَطُّ ، إِلاَّ وَکَأَنَّہُ یُبَادِرُ حَاجَۃً۔","","Musannaf Ibn Abi Shaybah 6415","","","كتاب الجمعة"
"6416","(۶۴۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ شَیْخٍ مِنَ الأَنْصَارِ ، قَالَ مِسْعَرٌ : أُرَاہُ عُثْمَانَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رُبَّمَا أَطَالَ رَکْعَتَیِ الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 6416","","","كتاب الجمعة"
"6417","(۶۴۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لیث أَبِی الْمَشْرَفِیِّ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یُطِیلَ رَکْعَتَیِ الْفَجْرِ ، یَقْرَأُ فِیہِمَا مِنْ حِزْبِہِ إِذَا فَاتَہُ۔","","Musannaf Ibn Abi Shaybah 6417","","","كتاب الجمعة"
"6418","(۶۴۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ أَنْ یُطِیلَ رَکْعَتَیِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6418","","","كتاب الجمعة"
"6419","(۶۴۱۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَنِ الرَّجُلِ یُوتِرُ مِنْ آخِرِ اللَّیْلِ ، وَقَدْ بَقِیَ عَلَیْہِ مِنَ اللَّیْلِ؟ فَلْیَسْتَفْتِحْ فَلْیَقْرَأْ ، فَإِذَا طَلَعَ الْفَجْرُ رَکَعَ رَکْعَۃً ، ثُمَّ یَضُمُّ إِلَیْہَا أُخْرَی ، فَتَکُونُ رَکْعَتَیِ الْفَجْرِ۔ قَالَ: فَذَکَرْت ذَلِکَ لِمُحَمَّدِ بْنِ سِیرِینَ ، فَقَالَ : مَا أَدْرِی مَا ہَذَا ؟۔","","Musannaf Ibn Abi Shaybah 6419","","","كتاب الجمعة"
"6420","(۶۴۲۰) حَدَّثَنَا کثیر بْنُ ہِشَامٍ ، عَنْ جَعْفَرَ بْنِ بُرْقَانَ ، قَالَ : قُلْتُ لِمَیْمُونٍ : أَقْرَأُ مِنَ اللَّیْلِ بِسُورَۃٍ طَوِیلَۃٍ ، فَیُدْرِکُنِی الصُّبْحُ حَتَّی أُسْفِرَ جِدًّا ، فَأُضِیفُ إِلَیْہَا أُخْرَی ، فَأَجْعَلُہَا رَکْعَتَیِ الْفَجْرِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 6420","","","كتاب الجمعة"
"6421","(۶۴۲۱) حَدَّثَنَا یَزِیدُ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِنْ شَائَ الرَّجُلُ افْتَتَحَ رَکْعَۃً مِنْ آخِرِ اللَّیْلِ یُطَوِّلُ فِیہَا ، حَتَّی إِذَا أَصْبَحَ رَکَعَ ، ثُمَّ ضَمَّ إِلَیْہَا أُخْرَی ، ثُمَّ اعْتَدَّ بِہِمَا مِنْ رَکْعَتَیِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6421","","","كتاب الجمعة"
"6422","(۶۴۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ سَالِمٍ أَبِی النَّضْرِ ، عَنْ بُسْرِ بْنِ سَعِیدٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفْضَلُ الصَّلاَۃ صَلاَۃُ الْمَرْئِ فِی بَیْتِہِ إِلاَّ الْمَکْتُوبَۃَ۔ (بخار ی۶۱۱۳۔ ابوداؤد ۱۴۴۲)","Sahih","Musannaf Ibn Abi Shaybah 6422","","","كتاب الجمعة"
"6423","(۶۴۲۳) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : رَأَیْتُ السَّائِبَ بْنَ یَزِیدَ یُصَلِّی فِی الْمَسْجِدِ ، ثُمَّ یَخْرُجُ قَبْلَ أَنْ یُصَلِّیَ فِیہِ شَیْئًا ۔ یَعْنِی لاَ یَتَطَوَّعُ۔","Sahih","Musannaf Ibn Abi Shaybah 6423","","","كتاب الجمعة"
"6424","(۶۴۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : سُئِلَ حُذَیْفَۃُ عَنِ التَّطَوُّعِ فِی الْمَسْجِدِ ؟ یَعْنِی بَعْدَ الْفَرِیضَۃِ ، فَقَالَ : إِنِّی لأَکْرَہہُ ، بَیْنَمَا ہُمْ جَمِیعًا فِی الصَّلاَۃ إِذَا اخْتَلَفُوا۔","","Musannaf Ibn Abi Shaybah 6424","","","كتاب الجمعة"
"6425","(۶۴۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : مَا رَأَیْتُ إِبْرَاہِیمَ مُتَطَوِّعًا فِی مَسْجِدِ قَوْمِہِ۔","","Musannaf Ibn Abi Shaybah 6425","","","كتاب الجمعة"
"6426","(۶۴۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ نُسَیر بْن ذَعْلُوقٍ ، قَالَ : مَا رَأَیْتُ الرَّبِیعَ بْنَ خُثَیْمٍ مُتَطَوِّعًا فِی مَسْجِدِ الْحَیِّ قَطُّ۔","","Musannaf Ibn Abi Shaybah 6426","","","كتاب الجمعة"
"6427","(۶۴۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی مَعْمَرٍ ، قَالَ : إِذَا صُلِّیَتِ الْمَکْتُوبَۃُ فَبَیْتُک۔","","Musannaf Ibn Abi Shaybah 6427","","","كتاب الجمعة"
"6428","(۶۴۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ النُّعْمَانِ بْنِ قَیْسٍ ، قَالَ : مَا رَأَیْتُ عَبِیدَۃَ مُتَطَوِّعًا فِی مَسْجِدِ الْحَیِّ إِلاَّ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 6428","","","كتاب الجمعة"
"6429","(۶۴۲۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، قَالَ : کَانَ سُوَیْدُ بْنُ غَفَلَۃَ لاَ یُصَلِّی تَطَوُّعًا بَعْدَ صَلاَۃٍ ، حَتَّی یَنْفَتِلَ حِینَ یُسَلِّمُ إِلَی بَیْتِہِ۔","","Musannaf Ibn Abi Shaybah 6429","","","كتاب الجمعة"
"6430","(۶۴۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنِ النُّعْمَانِ بْنِ قَیْسٍ، عَنْ عَبِیدَۃَ، قَالَ: کَانَ لاَ یُصَلِّی فِی مَسْجِدِہِ شَیْئًا بَعْدَ الْفَرِیضَۃِ۔","","Musannaf Ibn Abi Shaybah 6430","","","كتاب الجمعة"
"6431","(۶۴۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، وَالْعُمَرِیُّ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ فِی بَیْتِہِ۔ (بخاری ۱۱۸۰۔ ترمذی ۴۳۲)","Sahih","Musannaf Ibn Abi Shaybah 6431","","","كتاب الجمعة"
"6432","(۶۴۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، قَالَ : کَانَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ یُصَلِّی الرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ فِی بَیْتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 6432","","","كتاب الجمعة"
"6433","(۶۴۳۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَۃَ ، عَنْ مَحْمُودِ بْنِ لَبِیدٍ ، قَالَ: أَتَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَسْجِدَ بَنِی عبد الأَشْہَلِ ، فَصَلَّی بِہِمُ الْمَغْرِبَ ، فَلَمَّا سَلَّمَ ، قَالَ : ارْکَعُوا ہَاتَیْنِ الرَّکْعَتَیْنِ فِی بُیُوتِکُمْ ، قَالَ : فَلَقَدْ رَأَیْتُ مَحْمُودًا ، وَکَانَ إِمَامَ قَوْمِہِ یُصَلِّی بِہِمُ الْمَغْرِبَ ، ثُمَّ یَخْرُجُ فَیَجْلِسُ بِفِنَائِ الْمَسْجِدِ ، حَتَّی یَقُومَ قَبْلَ الْعَتَمَۃِ ، فَیَدْخُلَ بَیْتَہُ فَیُصَلِّیہِمَا۔ (ابن ماجہ ۱۱۶۵۔ احمد ۵/۴۲۷)","Hasan","Musannaf Ibn Abi Shaybah 6433","","","كتاب الجمعة"
"6434","(۶۴۳۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ ابْنِ إِسْحَاقَ ، قَالَ : حدَّثَنَا الْعَبَّاسُ بْنُ سَہْلِ السَّاعِدِیُّ ، قَالَ : لَقَدْ أَدْرَکْتُ زَمَانَ عُثْمَانَ بْنِ عَفَّانَ ، وَإِنَّہُ لَیُسَلِّمُ مِنَ الْمَغْرِبِ ، فَمَا أَرَی رَجُلاً وَاحِدًا یُصَلِّیہِمَا فِی الْمَسْجِدِ ، یَبْتَدِرُونَ أَبْوَابَ الْمَسْجِدِ حَتَّی یَخْرُجُوا ، فَیُصَلُّونَہَا فِی بُیُوتِہِمْ۔","Hasan","Musannaf Ibn Abi Shaybah 6434","","","كتاب الجمعة"
"6435","(۶۴۳۵) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرَ ، عَنْ مَیْمُونٍ ، قَالَ : کَانُوا یَسْتَحِبُّونَ ہَاتَیْنِ الرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ فِی بُیُوتِہِمْ۔","","Musannaf Ibn Abi Shaybah 6435","","","كتاب الجمعة"
"6436","(۶۴۳۶) حَدَّثَنَا عُمْرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرَ بْنِ بُرْقَانَ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : صَلَّی حُذَیْفَۃُ الْمَغْرِبَ فِی جَمَاعَۃٍ ، فَلَمَّا سَلَّمَ الإِمَامُ قَامَ رَجُلٌ إِلَی جَنْبِہِ ، فَأَرَادَ أَنْ یُصَلِّیَ الرَّکْعَتَیْنِ ، فَجَذَبَہُ حُذَیْفَۃُ ، فَقَالَ : اجْلِسْ ، لاَ عَلَیْک أَنْ تُؤَخِّرَ ہَاتَیْنِ الرَّکْعَتَیْنِ ، انْتَظِرْ قَلِیلاً۔","","Musannaf Ibn Abi Shaybah 6436","","","كتاب الجمعة"
"6437","(۶۴۳۷) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرَ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، قَالَ : کَانُوا یُحِبُّونَ تَأْخِیرَ الرَّکْعَتَیْنِ بَعْدَ الْمَغْرِبِ حَتَّی تَشْتَبِکَ النُّجُومُ۔","","Musannaf Ibn Abi Shaybah 6437","","","كتاب الجمعة"
"6438","(۶۴۳۸) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ رَجَائُ بْنُ حَیْوَۃَ إِذَا صَلَّی الْمَغْرِبَ ) ، لَمْ یُصَلِّ بَعْدَہَا شَیْئًا حَتَّی یَغِیبَ الشَّفَقُ۔","","Musannaf Ibn Abi Shaybah 6438","","","كتاب الجمعة"
"6439","(۶۴۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إِذَا صَلَّی السَّجْدَتَیْنِ قَبْلَ الْفَجْرِ اضْطَجَعَ۔ (بخاری ۶۳۱۰۔ ابوداؤد ۱۳۳۱)","Hasan","Musannaf Ibn Abi Shaybah 6439","","","كتاب الجمعة"
"6440","(۶۴۴۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا مَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ أَبَا مُوسَی الأَشْعَرِیَّ ، وَرَافِعَ بْنِ خَدِیجٍ ، وَأَنْسَ بْنَ مَالِکٍ کَانُوا یَضْطَجِعُونَ بَعْدَ رَکْعَتَیِ الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 6440","","","كتاب الجمعة"
"6441","(۶۴۴۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ؛ أَنَّ أَبَا مُوسَی ، وَرَافِعَ بْنَ خَدِیجٍ ، وَأَنَسًا کَانُوا یَفْعَلُونَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 6441","","","كتاب الجمعة"
"6442","(۶۴۴۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا غَیْلاَنُ بْنُ عَبْدِاللہِ، قَالَ: رَأَیْتُ ابْنَ عُمَرَ صَلَّی رَکْعَتَیِ الْفَجْرِ، ثُمَّ اضْطَجَعَ۔","Hasan","Musannaf Ibn Abi Shaybah 6442","","","كتاب الجمعة"
"6443","(۶۴۴۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُجَاہِدٍ ؛ أَنَّ مَرْوَانَ سَأَلَ أَبَا ہُرَیْرَۃَ عَنِ الإِضْطِجَاعِ بَعْدَ رَکْعَتَیِ الْفَجْرِ ؟ فَقَالَ : لاَ ، حَتَّی تَضْطَجِعَ۔","Sahih","Musannaf Ibn Abi Shaybah 6443","","","كتاب الجمعة"
"6444","(۶۴۴۴) حَدَّثَنَا حَسَنُ بْنُ عَبْدِ الرَّحْمَنِ الحارِثیُّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ إِذَا صَلَّی رَکْعَتَیِ الْفَجْرِ اضْطَجَعَ۔","","Musannaf Ibn Abi Shaybah 6444","","","كتاب الجمعة"
"6445","(۶۴۴۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ؛ أَنَّ عُرْوَۃَ دَخَلَ الْمَسْجِدَ وَالنَّاسُ فِی الصَّلاَۃ ، فَرَکَعَ رَکْعَتَیْنِ ، ثُمَّ أَمَسَّ جَنْبَہُ الأَرْضَ ، ثُمَّ قَامَ فَدَخَلَ مَعَ النَّاسِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6445","","","كتاب الجمعة"
"6446","(۶۴۴۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا حُصَیْنٌ ، عَنْ مُجَاہِدٍ ، قَالَ : صَحِبْتُ ابْنَ عُمَرَ فِی السَّفَرِ وَالْحَضَرِ ، فَمَا رَأَیْتُہُ اضْطَجَعَ بَعْدَ رَکْعَتَیِ الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 6446","","","كتاب الجمعة"
"6447","(۶۴۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : کَانَ إِبْرَاہِیمُ یَکْرَہُ الضِّجْعَۃَ بَعْدَ مَا یُصَلِّی الرَّکْعَتَیْنِ اللَّتَیْنِ قَبْلَ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6447","","","كتاب الجمعة"
"6448","(۶۴۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدَرِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : رَأَی عُمَرُ رَجُلاً اضْطَجَعَ بَعْدَ الرَّکْعَتَیْنِ ، فَقَالَ : احْصِبُوہُ ، أَوْ أَلاَ حَصَّبْتُمُوہُ ؟۔","Sahih","Musannaf Ibn Abi Shaybah 6448","","","كتاب الجمعة"
"6449","(۶۴۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَا بَالُ الرَّجُلِ إِذَا صَلَّی الرَّکْعَتَیْنِ یَتَمَعَّکُ کَمَا تَتَمَعَّکُ الدَّابَّۃُ وَالْحِمَارُ ؟ إِذَا سَلَّمَ فَقَدْ فَصَلَ۔","","Musannaf Ibn Abi Shaybah 6449","","","كتاب الجمعة"
"6450","(۶۴۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنْ ضِجْعَۃِ الرَّجُلِ عَلَی یَمِینِہِ بَعْدَ الرَّکْعَتَیْنِ قَبْلَ صَلاَۃِ الْفَجْرِ ؟ فَقَالَ : یَتَلَعَّبُ بِکُمُ الشَّیْطَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 6450","","","كتاب الجمعة"
"6451","(۶۴۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ تَضْطَجِعْ بَعْدَ الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ ، وَاضْطَجِعْ بَعْدَ الْوِتْرِ۔","","Musannaf Ibn Abi Shaybah 6451","","","كتاب الجمعة"
"6452","(۶۴۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِیسَی الْخَبَّاطُ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ ، یَقُولُ : مَا بَالُ أَحَدِکُمْ إِذَا صَلَّی الرَّکْعَتَیْنِ یَتَمَرَّغُ ؟ یَکْفِیہِ التَّسْلِیمُ۔","","Musannaf Ibn Abi Shaybah 6452","","","كتاب الجمعة"
"6453","(۶۴۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عُبَیْد اللہ ، عَنْ إِبْرَاہِیمَ ، قَالَ : ہِیَ ضَجْعَۃُ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 6453","","","كتاب الجمعة"
"6454","(۶۴۵۴) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یُعْجِبُہُ أَنْ یَضْطَجِعَ بَعْدَ رَکْعَتَیِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6454","","","كتاب الجمعة"
"6455","(۶۴۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ زَیْدٍ الْعَمِّیِّ ، عَنْ أَبِی الصِّدِّیقِ النَّاجِی ، قَالَ : رَأَی ابْنُ عُمَرَ قَوْمًا اضْطَجَعُوا بَعْدَ رَکْعَتَیِ الْفَجْرِ ، فَأَرْسَلَ إِلَیْہِمْ فَنَہَاہُمْ ، فَقَالُوا : نُرِیدُ بِذَلِکَ السُّنَّۃَ ، فَقَالَ ابْنُ عُمَرَ : ارْجِعْ إِلَیْہِمْ فَأَخْبِرْہُمْ أَنَّہَا بِدْعَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 6455","","","كتاب الجمعة"
"6456","(۶۴۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ؛ أَنَّہُ کَانَ إِذَا صَلَّی رَکْعَتَیِ الْفَجْرِ احْتَبَی۔","","Musannaf Ibn Abi Shaybah 6456","","","كتاب الجمعة"
"6457","(۶۴۵۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، وَمُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ عَبْدُ اللہِ : مَا ہَذَا التَّمَرُّغُ بَعْدَ رَکْعَتَیِ الْفَجْرِ کَتَمَرُّغِ الْحِمَارِ۔","","Musannaf Ibn Abi Shaybah 6457","","","كتاب الجمعة"
"6458","(۶۴۵۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی النَّضْرِ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا صَلَّی رَکْعَتَیِ الْفَجْرِ ، فَإِنْ کُنْت مُسْتَیْقِظَۃً حَدَّثَنِی ، وَإِلاَّ اضْطَجَعَ۔ (بخاری ۱۱۶۱۔ مسلم ۵۱۱)","Sahih","Musannaf Ibn Abi Shaybah 6458","","","كتاب الجمعة"
"6459","(۶۴۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ نَافِعٍ ، قَالَ : رُبَّمَا تَکَلَّمَ ابْنُ عُمَرَ بَعْدَ رَکْعَتَیِ الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 6459","","","كتاب الجمعة"
"6460","(۶۴۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یُسَلِّمَ وَیَتَکَلَّمَ بِالْحَاجَۃِ بَعْدَ رَکْعَتَیِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6460","","","كتاب الجمعة"
"6461","(۶۴۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ إِسْمَاعِیلَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِالْکَلاَمِ بَعْدَ رَکْعَتَیِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6461","","","كتاب الجمعة"
"6462","(۶۴۶۲) حَدَّثَنَا مُعتَمِر بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : رَأَی ابْنُ مَسْعُودَ رَجُلاً یُکَلِّمُ آخَرَ بَعْدَ رَکْعَتَیِ الْفَجْرِ ، فَقَالَ : إِمَّا أَنْ تَذْکُرَ اللَّہَ وَإِمَّا أَنْ تَسْکُتَ۔","Da'if","Musannaf Ibn Abi Shaybah 6462","","","كتاب الجمعة"
"6463","(۶۴۶۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : مَا مِنْ أَحَدٍ أَکْرَہُ إِلَیْہِ الْکَلاَمَ بَعْدَ رَکْعَتَیِ الْفَجْرِ حَتَّی یُصَلِّیَ الْغَدَاۃَ مِنِ ابْنِ مَسْعُودٍ۔","","Musannaf Ibn Abi Shaybah 6463","","","كتاب الجمعة"
"6464","(۶۴۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : کَانَ عَبْدُ اللہِ یَعِزُّ عَلَیْہِ أَنْ یُسْمَعَ مُتَکَلِّمٌ بَعْدَ الْفَجْرِ ، یَعْنِی بَعْدَ الرَّکْعَتَیْنِ ، إِلاَّ بِالْقُرْآنِ ، أَوْ بِذِکْرِ اللہِ ، حَتَّی یُصَلِّیَ۔","","Musannaf Ibn Abi Shaybah 6464","","","كتاب الجمعة"
"6465","(۶۴۶۵) حَدَّثَنَا مُعَمَّرُ بْنُ سُلَیْمَانَ الرَّقِّیُّ ، عَنْ خُصَیْفٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یَکْرَہُ الْکَلاَمَ بَعْدَ رَکْعَتَیِ الْفَجْرِ ، إِلاَّ أَنْ یُذْکَرَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 6465","","","كتاب الجمعة"
"6466","(۶۴۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ خُصَیْفٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنْ آیَۃٍ بَعْدَ رَکْعَتَیِ الْفَجْرِ ؟ فَلَمْ یُجِبْنِی ، فَلَمَّا صَلَّی ، قَالَ : إِنَّ الْکَلاَمَ یُکْرَہُ بَعْدَہُمَا۔","","Musannaf Ibn Abi Shaybah 6466","","","كتاب الجمعة"
"6467","(۶۴۶۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ تَکَلُّمَ بَعْدَ رَکْعَتَیِ الْفَجْرِ وَالْفَجْرِ ، إِلاَّ أَنْ تَکُونَ لَکَ حَاجَۃً۔","","Musannaf Ibn Abi Shaybah 6467","","","كتاب الجمعة"
"6468","(۶۴۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ: کَانُوا یَکْرَہُونَ الْکَلاَمَ بَعْدَ رَکْعَتَیِ الْفَجْرِ۔ قَالَ : قُلْتُ لإِبْرَاہِیمَ : قَوْلُ الرَّجُلِ لأَہْلِہِ : الصَّلاَۃ ؟ قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 6468","","","كتاب الجمعة"
"6469","(۶۴۶۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ (ح) وعَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُمْ کَرِہُوا الْکَلاَمَ بَعْدَ رَکْعَتَیِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6469","","","كتاب الجمعة"
"6470","(۶۴۷۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ قَرَظَۃَ ، عَنْ مُجَاہِدٍ ، قَالَ: رَأَیْتُ ابْنَ عُمَرَ صَلَّی رَکْعَتَیِ الْفَجْرِ ثُمَّ احْتَبَی ، فَلَمْ یَتَکَلَّمْ حَتَّی صَلَّی الْغَدَاۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 6470","","","كتاب الجمعة"
"6471","(۶۴۷۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ : ہَلْ یُفَرَّقُ بَیْنَ صَلاَۃِ الْفَجْرِ وَبَیْنَ الرَّکْعَتَیْنِ قَبْلَہُمَا بِکَلاَمٍ ؟ قَالَ : لاَ ، إِلاَّ أَنْ یَتَکَلَّمَ بِحَاجَۃٍ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 6471","","","كتاب الجمعة"
"6472","(۶۴۷۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا حُصَیْنٌ ، وَابْنُ عَوْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ دَخَلَ الْمَسْجِدَ وَالْقَوْمُ فِی صَلاَۃِ الْغَدَاۃِ ، وَلَمْ یَکُنْ صَلَّی الرَّکْعَتَیْنِ ، فَصَلاَّہُمَا فِی نَاحِیَۃٍ ، ثُمَّ دَخَلَ مَعَ الْقَوْمِ فِی صَلاَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 6472","","","كتاب الجمعة"
"6473","(۶۴۷۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسِ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : یَُصَلیہِمَا فِی نَاحِیَۃٍ ، ثُمَّ دَخَلَ مَعَ الْقَوْمِ فِی صَلاَتِہِمْ۔","","Musannaf Ibn Abi Shaybah 6473","","","كتاب الجمعة"
"6474","(۶۴۷۴) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ حُصَیْنٍ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ جَائَ إِلَی الْمَسْجِدِ وَالإِمَامُ فِی صَلاَۃِ الْفَجْرِ ، فَصَلَّی الرَّکْعَتَیْنِ قَبْلَ أَنْ یَلِجَ الْمَسْجِدَ ، عِنْدَ بَابِ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 6474","","","كتاب الجمعة"
"6475","(۶۴۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : حدَّثَنِی أَبُو عُثْمَانَ ، قَالَ : قَدْ رَأَیْتُ الرَّجُلَ یَجِیئُ وَعُمَرُ بْنُ الْخَطَّابِ فِی صَلاَۃِ الْفَجْرِ ، فَیُصَلِّی الرَّکْعَتَیْنِ فِی جَانِبِ الْمَسْجِدِ ، ثُمَّ یَدْخُلُ مَعَ الْقَوْمِ فِی صَلاَتِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 6475","","","كتاب الجمعة"
"6476","(۶۴۷۶) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ ؛ أَنَّ ابْنَ مَسْعُودٍ وَأَبَا مُوسَی خَرَجَا مِنْ عِنْدِ سَعِیدِ بْنِ الْعَاصِ ، فَأُقِیمَتِ الصَّلاَۃُ ، فَرَکَعَ ابْنُ مَسْعُودٍ رَکْعَتَیْنِ ، ثُمَّ دَخَلَ مَعَ الْقَوْمِ فِی الصَّلاَۃ ، وَأَمَّا أَبُو مُوسَی فَدَخَلَ فِی الصَّفِّ۔","","Musannaf Ibn Abi Shaybah 6476","","","كتاب الجمعة"
"6477","(۶۴۷۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ دَاوُدَ بْنِ إِبْرَاہِیمَ ، قَالَ : قُلْتُ لِطَاوُوسٍ : أَرْکَعُ الرَّکْعَتَیْنِ وَالْمُقِیمُ یُقِیمُ ؟ قَالَ : ہَلْ تَسْتَطِیعُ ذَلِکَ ؟۔","","Musannaf Ibn Abi Shaybah 6477","","","كتاب الجمعة"
"6478","(۶۴۷۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنِ الْحَکَمِ بْنِ أَبَانَ ، عَنْ عِکْرِمَۃَ ، قَالَ : اقْرَأْ ، وَلاَ تَقْرَأْ ، وَإِنْ قَرَأْتَ فَخَفِّفْ ، صَلِّہمَا وَلَوْ بِالطَّرِیقِ ، یَعْنِی رَکْعَتَیِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6478","","","كتاب الجمعة"
"6479","(۶۴۷۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : إِذَا دَخَلْتَ الْمَسْجِدَ وَالنَّاسُ فِی صَلاَۃِ الصُّبْحِ ، وَلَمْ تَرْکَعْ رَکْعَتَیِ الْفَجْرِ فَارْکَعْہُمَا ، وَإِنْ ظَنَنْتَ أَنَّ الرَّکْعَۃَ الأُولَی تَفُوتُک۔","","Musannaf Ibn Abi Shaybah 6479","","","كتاب الجمعة"
"6480","(۶۴۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ دَلْہَمِ بْنِ صَالِحٍ ، عَنْ وَبَرَۃَ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَفْعَلُہُ ، وَحَدَّثَنِی مَنْ رَآہُ فَعَلَہُ مَرَّتَیْنِ ؛ جَائَ مَرَّۃً وَہُمْ فِی الصَّلاَۃ ، فَصَلاَّہُمَا فِی جَانِبِ الْمَسْجِدِ ، ثُمَّ دَخَلَ مَرَّۃً أُخْرَی فَصَلَّی مَعَہُمْ ، وَلَمْ یُصَلِّہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 6480","","","كتاب الجمعة"
"6481","(۶۴۸۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ إِذَا جَائَ وَالإِمَامُ فِی صَلاَۃِ الْفَجْرِ أَنْ یُصَلِّیَہُمَا فِی الْمَسْجِدِ ، وَقَالَ : یُصَلِّیہِمَا عَلَی بَابِ الْمَسْجِدِ ، أَوْ فِی نَاحِیَتِہِ۔","","Musannaf Ibn Abi Shaybah 6481","","","كتاب الجمعة"
"6482","(۶۴۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنِ الْوَلِیدِ بْنِ أَبِی مَالِکٍ ، عَنْ أَبِی عُبَیْدِ اللہِ ، عَنْ أَبِی الدَّرْدَائِ ، قَالَ : إِنِّی لأَجِیئُ إِلَی الْقَوْمِ وَہُمْ صُفُوفٌ فِی صَلاَۃِ الْفَجْرِ ، فَأُصَلِّی الرَّکْعَتَیْنِ ، ثُمَّ أَنْضَمُّ إِلَیْہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 6482","","","كتاب الجمعة"
"6483","(۶۴۸۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ بْنُ عُبَیْدٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ یَقُولُ فِی الرَّجُلِ إِذَا دَخَلَ الْمَسْجِدَ ، وَالْقَوْمُ یُصَلُّونَ الْغَدَاۃَ ، قَالَ : یَدْخُلُ مَعَ الْقَوْمِ فِی صَلاَتِہِمْ ، وَلاَ یُصَلِّی الرَّکْعَتَیْنِ ، فَإِنَّ مَا یَفُوتُہُ مِنَ الْمَکْتُوبَۃِ أَعْظَمُ مِنَ الرَّکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6483","","","كتاب الجمعة"
"6484","(۶۴۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذَکَرْتُہُ لإِبْرَاہِیمَ ، فَقَالَ : الْمَکْتُوبَۃُ تُقْضَی ، وَمُرَّ فِی التَّطَوُّعِ۔","","Musannaf Ibn Abi Shaybah 6484","","","كتاب الجمعة"
"6485","(۶۴۸۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مَا یَفُوتُہُ مِنْ صَلاَۃِ الإِمَام أَفْضَلُ مِمَّا یَطْلُبُ فِی تَیْنِکَ الرَّکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6485","","","كتاب الجمعة"
"6486","(۶۴۸۶) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنْ حَمَّادٍ ، قَالَ : لاَ تَدْخُلِ الْمَسْجِدَ حَتَّی تُصَلِّیَ رَکْعَتَیْنِ قَبْلَ الْفَجْرِ ، وَلَوْ عَلَی کُنَاسَۃٍ۔","","Musannaf Ibn Abi Shaybah 6486","","","كتاب الجمعة"
"6487","(۶۴۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرِ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، قَالَ : رَأَیْتُ ابْنَ مَعْقِلٍ صَلَّی الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ فِی السُّدَّۃِ۔","","Musannaf Ibn Abi Shaybah 6487","","","كتاب الجمعة"
"6488","(۶۴۸۸) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ بُشَیْرِ بْنِ فَرّوخَ ، قَالَ : حدَّثَنِی أَیُّوبُ بْنُ عُتْبَۃَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : مَنْ أَتَی الْمَسْجِدَ وَقَدْ أُقِیمَتِ الصَّلاَۃُ ، فَلِیُؤَخِّرِ الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ حَتَّی یُصَلِّیَہُمَا ضُحًی۔","","Musannaf Ibn Abi Shaybah 6488","","","كتاب الجمعة"
"6489","(۶۴۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إِنْ کَانَ فِی مَکَانٍ صَلاَّہُمَا ، وَإِنْ کَانَ فِی الْمَسْجِدِ لَمْ یُصَلِّہِمَا۔","","Musannaf Ibn Abi Shaybah 6489","","","كتاب الجمعة"
"6490","(۶۴۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ خَشِیَ فَوْتَ رَکْعَۃٍ دَخَلَ مَعَہُمْ ، وَلَمْ یُصَلِّہِمَا۔","","Musannaf Ibn Abi Shaybah 6490","","","كتاب الجمعة"
"6491","(۶۴۹۱) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : دَخَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَسْجِدَ وَأَخَذَ بِلاَلٌ فِی الإِقَامَۃِ ، فَقَامَ ابْنُ بُحَینۃَ یُصَلِّی رَکْعَتَیْنِ ، فَضَرَبَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَنْکِبَہُ ، وَقَالَ : یَا ابْنَ الْقِشْبِ ، تُصَلِّی الصُّبْحَ أَرْبَعًا۔ (بیہقی ۴۸۲)","","Musannaf Ibn Abi Shaybah 6491","","","كتاب الجمعة"
"6492","(۶۴۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن حَفْصٍ ، عَنِ ابْنُ بُحَینۃَ ، قَالَ : أُقِیمَتْ صَلاَۃُ الصُّبْحِ ، فَقَامَ رَجُلٌ یُصَلِّی الرَّکْعَتَیْنِ ، فَلَمَّا صَلَّی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَثَ النَّاسُ حَوْلَہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلَّذِی صَلَّی الرَّکْعَتَیْنِ : أَتُصَلِّی الصُّبْحَ أَرْبَعًا ؟۔ (بخاری ۶۶۳۔ مسلم ۴۹۳)","Sahih","Musannaf Ibn Abi Shaybah 6492","","","كتاب الجمعة"
"6493","(۶۴۹۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا أَبُو عَامِرِ الْمُزَنِیُّ صَالِحُ بْنُ رُسْتُم ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أُقِیمَتْ صَلاَۃُ الصُّبْحِ ، فَقَام[corrupt] رَجُلٌ یُصَلِّی الرَّکْعَتَیْنِ ، فَجَذَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِثَوْبِہِ ، وَقَالَ : أَتُصَلِّی الصُّبْحَ أَرْبَعًا ؟۔ (احمد ۱/۳۵۵۔ ابویعلی ۲۵۶۸)","Hasan","Musannaf Ibn Abi Shaybah 6493","","","كتاب الجمعة"
"6494","(۶۴۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی الْہَیْثُمِ ، قَالَ : قَالَ إِبْرَاہِیمُ : لأَنْ أُدْرِکَ مَا فَاتَنِی مِنَ الْمَکْتُوبَۃِ أَحَبُّ إِلَیَّ مِنْ أَنْ أُصَلِّیَہُمَا۔","","Musannaf Ibn Abi Shaybah 6494","","","كتاب الجمعة"
"6495","(۶۴۹۵) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا مُغِیرَۃُ، عَنْ إِبْرَاہِیمَ، قَالَ: کَانُوا یَکْرَہُونَ التَّسَانُدَ إِلَی الْقِبْلَۃِ بَعْدَ رَکْعَتَیِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6495","","","كتاب الجمعة"
"6496","(۶۴۹۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْمَسْعُودِیُّ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ؛ أَنَّ ابْنَ مَسْعُودٍ دَخَلَ الْمَسْجِدَ فَرَأَی أُنَاسًا قَدْ تَسَانَدُوا إِلَی الْقِبْلَۃِ ۔ قَالَ : فَقَالَ لَہُم عَبْدُ اللہِ : ہَکَذَا ، عَنْ وُجُوہِ الْمَلاَئِکَۃِ ؟۔","","Musannaf Ibn Abi Shaybah 6496","","","كتاب الجمعة"
"6497","(۶۴۹۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إِذَا طَلَعَ الْفَجْرُ صَلَّی رَکْعَتَیْنِ ، ثُمَّ یَحْتَبِی وَنَحْنُ حَوْلَہُ ، فَإِنْ رَأَی أَحَدًا مِنَّا نَعَسَ حَرَّکَہُ ، قَالَ: وَکَانَ یَنْعَسُ وَہُوَ مُحْتَبٍ ، ثُمَّ تُقَامُ الصَّلاَۃُ فَیَنْہَضُ وَیُصَلِّی۔","Sahih","Musannaf Ibn Abi Shaybah 6497","","","كتاب الجمعة"
"6498","(۶۴۹۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : دَخَلَ عَبْدُ اللہِ الْمَسْجِدَ لِصَلاَۃِ الْفَجْرِ، فَإِذَا قَوْمٌ قَدْ أَسْنَدُوا ظُہُورَہُمْ إِلَی الْقِبْلَۃِ ، فَقَالَ : تَنَحَّوْا عَنِ الْقِبْلَۃِ ، لاَ تَحُولُوا بَیْنَ الْمَلاَئِکَۃِ وَبَیْنَ صَلاَتِہَا، وَإِنَّ ہَاتَیْنِ الرَّکْعَتَیْنِ صَلاَۃُ الْمَلاَئِکَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 6498","","","كتاب الجمعة"
"6499","(۶۴۹۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ مَکْحُولٍ ، عَنْ أَبِی الدَّرْدَائِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ مَشَی فِی ظُلْمَۃِ اللَّیْلِ إِلَی الْمَسْجِدِ ، لَقِیَ اللَّہَ بِنُورٍ یَوْمَ الْقِیَامَۃِ۔ (دارمی ۱۴۲۲۔ ابن حبان ۲۰۴۶)","","Musannaf Ibn Abi Shaybah 6499","","","كتاب الجمعة"
"6500","(۶۵۰۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَرَوْنَ الْمَشْیَ فِی اللَّیْلَۃِ الْمُظْلِمَۃِ مُوجِبَۃً۔","","Musannaf Ibn Abi Shaybah 6500","","","كتاب الجمعة"
"6501","(۶۵۰۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَعدِ بْنِ سَعِیدٍ ، قَالَ : حدَّثَنِی مُحَمَّدُ بْنُ إِبْرَاہِیمَ ، عَن قَیْسِ بْنِ عَمرو ، قَالَ : رَأَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً یُصَلِّی بَعْدَ صَلاَۃِ الصُّبْحِ رَکْعَتَیْنِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَصَلاَۃُ الصُّبْحِ مَرَّتَیْنِ ؟ فَقَالَ الرَّجُلُ : إِنِّی لَمْ أَکُنْ صَلَّیْتُ الرَّکْعَتَیْنِ اللَّتَیْنِ قَبْلَہُمَا ، فَصَلَّیْتُہُمَا الأَنَ ، فَسَکَتَ۔ (ترمذی ۴۲۲۔ ابوداؤد ۱۲۶۱)","","Musannaf Ibn Abi Shaybah 6501","","","كتاب الجمعة"
"6502","(۶۵۰۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّ رَجُلاً صَلَّی مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃَ الصُّبْحِ ، فَلَمَّا قَضَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الصَّلاَۃَ ، قَامَ الرَّجُلُ فَصَلَّی رَکْعَتَیْنِ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا ہَاتَانِ الرَّکْعَتَانِ ؟ فَقَالَ : یَا رَسُولَ اللہِ ، جِئْتُ وَأَنْتَ فِی الصَّلاَۃ ، وَلَمْ أَکُنْ صَلَّیْتُ الرَّکْعَتَیْنِ قَبْلَ الْفَجْرِ ، فَکَرِہْتُ أَنْ أُصَلِّیَہُمَا وَأَنْتَ تُصَلِّی ، فَلَمَّا قَضَیْتَ الصَّلاَۃَ ، قُمْتُ فَصَلَّیْتُ الصَّلاَۃَ ، فَضَحِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمْ یَأْمُرْہُ ، وَلَمْ یَنْہَہُ۔ (طبرانی ۹۳۹)","","Musannaf Ibn Abi Shaybah 6502","","","كتاب الجمعة"
"6503","(۶۵۰۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا شَیْخٌ ، یُقَالُ لَہُ : مِسْمَعُ بْنُ ثَابِتٍ ، قَالَ : رَأَیْتُ عَطَائً فَعَلَ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 6503","","","كتاب الجمعة"
"6504","(۶۵۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِذَا فَاتَتْہُ رَکْعَتَا الْفَجْرِ صَلاَّہُمَا بَعْدَ صَلاَۃِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6504","","","كتاب الجمعة"
"6505","(۶۵۰۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : سَمِعْتُ الْقَاسِمَ ، یَقُولُ : لَوْ لَمْ أُصَلِّہِمَا حَتَّی أُصَلِّیَ الْفَجْرَ ، صَلَّیْتُہُمَا بَعْدَ طُلُوعِ الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 6505","","","كتاب الجمعة"
"6506","(۶۵۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ جَائَ إِلَی الْقَوْمِ وَہُمْ فِی الصَّلاَۃ ، وَلَمْ یَکُنْ صَلَّی الرَّکْعَتَیْنِ فَدَخَلَ مَعَہُمْ ، ثُمَّ جَلَسَ فِی مُصَلاَّہُ ، فَلَمَّا أَضْحَی قَامَ فَقَضَاہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 6506","","","كتاب الجمعة"
"6507","(۶۵۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، وَرَبِیعٌ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ صَلاَّہُمَا بَعْدَ مَا أَضْحَی۔","Sahih","Musannaf Ibn Abi Shaybah 6507","","","كتاب الجمعة"
"6508","(۶۵۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ تُقْضَی رَکْعَتَا الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6508","","","كتاب الجمعة"
"6509","(۶۵۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلِ بْنِ مَرْزُوقٍ ، عَنْ عَطِیَّۃَ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ قَضَاہُمَا حِینَ سَلَّمَ الإِمَامُ۔","Da'if","Musannaf Ibn Abi Shaybah 6509","","","كتاب الجمعة"
"6510","(۶۵۱۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ زَیْدِ بْنِ خَالِدٍ الْجُہَنِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلُّوا فِی بُیُوتِکُمْ ، وَلاَ تَتَّخِذُوہَا قُبُورًا۔ (عبد بن حمید ۲۷۵۔ بزار ۷۰۶)","","Musannaf Ibn Abi Shaybah 6510","","","كتاب الجمعة"
"6511","(۶۵۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا قَضَی أَحَدُکُمُ الصَّلاَۃ فِی مَسْجِدِہِ ، فَلْیَجْعَلْ لِبَیْتِہِ نَصِیبًا مِنْ صَلاَتِہِ ، فَإِنَّ اللَّہَ جَاعِلٌ فِی بَیْتِہِ مِنْ صَلاَتِہِ خَیْرًا۔ (مسلم ۵۳۹۔ احمد ۳/۳۱۶)","Hasan","Musannaf Ibn Abi Shaybah 6511","","","كتاب الجمعة"
"6512","(۶۵۱۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی سَعِیدٍ ؛ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِمِثْلِ حَدِیثِ أَبِی مُعَاوِیَۃَ۔ (احمد ۳/۵۹۔ عبدالرزاق ۴۸۳۷)","Hasan","Musannaf Ibn Abi Shaybah 6512","","","كتاب الجمعة"
"6513","(۶۵۱۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : صَلُّوا فِی بُیُوتِکُمْ ، وَلاَ تَتَّخِذُوہَا قُبُورًا۔ (بخاری ۱۱۸۷۔ مسلم ۵۳۸)","Sahih","Musannaf Ibn Abi Shaybah 6513","","","كتاب الجمعة"
"6514","(۶۵۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ سَالِمٍ أَبِی النَّضْرِ ، عَنْ بُسْرِ بْنِ سَعِیدٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَفْضَلُ الصَّلاَۃِ صَلاَۃُ الْمَرْئِ فِی بَیْتِہِ ، إِلاَّ الْمَکْتُوبَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 6514","","","كتاب الجمعة"
"6515","(۶۵۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَتْ أَفْضَلُ صَلاَۃِ عَبْدِ اللہِ فِی بَیْتِہِ۔","","Musannaf Ibn Abi Shaybah 6515","","","كتاب الجمعة"
"6516","(۶۵۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ ضَمْرَۃَ بْنِ حَبِیبٍ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : تَطَوُّعُ الرَّجُلِ فِی بَیْتِہِ یَزِیدُ عَلَی تَطَوُّعِہِ عِنْدَ النَّاسِ ، کَفَضْلِ صَلاَۃِ الرَّجُلِ فِی الْجَمَاعَۃِ عَلَی صَلاَتِہِ وَحْدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 6516","","","كتاب الجمعة"
"6517","(۶۵۱۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ شُرَیْحٌ ، وَمَسْرُوقٌ کِلاَہُمَا لَہُ بَیْتٌ یُطِیلُ فِیہِ الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6517","","","كتاب الجمعة"
"6518","(۶۵۱۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ، قَالَ: صَلاَۃُ الرَّجُلِ عِنْدَ أَہْلِہِ مِنَ السِّرِّ۔","","Musannaf Ibn Abi Shaybah 6518","","","كتاب الجمعة"
"6519","(۶۵۱۹) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَجْعَلُوا بُیُوتَکُمْ مَقَابِرَ۔ (مسلم ۵۳۹۔ ترمذی ۲۸۷۷)","Sahih","Musannaf Ibn Abi Shaybah 6519","","","كتاب الجمعة"
"6520","(۶۵۲۰) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ صَالِحٍ مَوْلَی التَّوْأَمَۃِ ، عَنِ السَّائِبِ بْنِ خَبَّابٍ ، قَالَ : کُنْتُ لاَ أُصَلِّی إِلاَّ فِی الْمَسْجِدِ ، فَقَالَ لِی زَیْدُ بْنُ ثَابِتٍ : صَلاَۃُ الرَّجُلِ فِی بَیْتِہِ أَفْضَلُ مِنْ صَلاَتہٍ فِی الْمَسْجِدِ إِلاَّ الْمَکْتُوبَۃَ ، وَصَلاَۃُ الرَّجُلِ فِی بَیْتِہِ نُورٌ۔","Da'if","Musannaf Ibn Abi Shaybah 6520","","","كتاب الجمعة"
"6521","(۶۵۲۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ طَارِقٍ ، عَنْ عَاصِمِ بْنِ عَمْرٍو ؛ أَنَّ نَفَرًا مِنْ أَہْلِ الْعِرَاقِ قَدِمُوا عَلَی عُمَرَ ، فَسَأَلُوہُ عَنْ صَلاَۃِ الرَّجُلِ فِی بَیْتِہِ ؟ فَقَالَ عُمَرُ : مَا سَأَلَنِی عَنْہَا أَحَدٌ مُذْ سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْہَا ، فَقَالَ : صَلاَۃُ الرَّجُلِ فِی بَیْتِہِ نُورٌ ، فَنَوِّرُوا بُیُوتَکُمْ۔","","Musannaf Ibn Abi Shaybah 6521","","","كتاب الجمعة"
"6522","(۶۵۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ، قَالَ : کَانَ أصْحَابُ عَبْدِ اللہِ یَقُولُونَ : الصَّفُّ الْمُقَدَّمُ الَّذِی یَلِی الْمَقْصُورَۃَ۔","","Musannaf Ibn Abi Shaybah 6522","","","كتاب الجمعة"
"6523","(۶۵۲۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، قَالَ : سَمِعْتُ أَبَا عُبَیْدَۃَ یَقُولُ : الصَّفُّ الأَوَّلُ الَّذِی یَلِی الْمَقْصُورَۃَ۔","","Musannaf Ibn Abi Shaybah 6523","","","كتاب الجمعة"
"6524","(۶۵۲۴) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : رَأَیْتُ أَبَا عَبْدِ الرَّحْمَنِ ، وَزِرَّ بْنَ حُبَیْشٍ ، وَعَمْرَو بْنَ مَیْمُونٍ یُصَلُّونَ عَنْ یَمِینِ الْمَقْصُورَۃِ ، وَقَالَ حَفْصٌ مَرَّۃً : مَا بَیْنَ الأُسْطُوَانَۃِ إِلَی الْحَائِطِ۔","","Musannaf Ibn Abi Shaybah 6524","","","كتاب الجمعة"
"6525","(۶۵۲۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، قَالَ : قُلْتُ لِلْحَسَنِ : إِنَّہُمْ یَقُولُونَ : الصَّفُّ الأَوَّلُ الَّذِی یَلِی الْمَقْصُورَۃَ ، فَقَالَ : ہُوَ الَّذِی یَلِی الْحَائِطَ۔","Da'if","Musannaf Ibn Abi Shaybah 6525","","","كتاب الجمعة"
"6526","(۶۵۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ وَرْدَانَ ، قَالَ : رَأَیْتُ أَنَسًا یُصَلِّی عِنْدَ الْحَجَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 6526","","","كتاب الجمعة"
"6527","(۶۵۲۷) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، یَرْفَعُہُ ، قَالَ : لاَ تَأْتَمُّ بِنَائِمٍ ، وَلاَ مُتَحَدِّثٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6527","","","كتاب الجمعة"
"6528","(۶۵۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْکَرِیمِ أَبِی أُمَیَّۃَ ، عَنْ مُجَاہِدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی أَنْ یُصَلِّیَ خَلْفَ النُّوَّامِ وَالْمُتَحَدِّثِینَ۔ (طبرانی۵۲۴۲)","Da'if","Musannaf Ibn Abi Shaybah 6528","","","كتاب الجمعة"
"6529","(۶۵۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : حدَّثَنَا یُوسُفَ بْنُ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : کُنْتُ جَالِسًا إِلَی جَنْبِ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، فَالْتَفَتَ ، فَإِذَا رَجُلٌ یُصَلِّی خَلْفَہُ ، فَقَالَ لَہُ : إِمَّا أَنْ تَحَوَّلَ عَنِّی ، وَإِمَّا أَنْ أَقُومَ عَنک۔","","Musannaf Ibn Abi Shaybah 6529","","","كتاب الجمعة"
"6530","(۶۵۳۰) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَعِیدِ بْنِ وَہْبٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ مَسْعُودٍ ؛ أَنَّہُ کَرِہَ أَنْ یَأْتَمَّ بِقَوْمٍ یَتَحَدَّثُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 6530","","","كتاب الجمعة"
"6531","(۶۵۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مَعْدِی کَرِبَ ، عَنْ عَبْدِ اللہِ ، قَالَ : لاَ تَأْتَمْ بِقَوْمٍ یَمْتَرُونَ ، أَوْ یَلْغُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 6531","","","كتاب الجمعة"
"6532","(۶۵۳۲) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، قَالَ : کَانَ ابْنُ عُمَرَ لاَ یُصَلِّی خَلْفَ رَجُلٍ لاَ یُصَلِّی ، إِلاَّ یَوْمَ جُمُعَۃٍِ ۔ قَالَ : فَذَکَرْتُ ذَلِکَ لِعَبْدِ الْکَرِیمِ ، فَقَالَ : کَانَ ابْنُ عُمَرَ لاَ یُصَلِّی خَلْفَ رَجُلٍ یَتَکَلَّمُ إِلاَّ یَوْمَ الْجُمُعَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 6532","","","كتاب الجمعة"
"6533","(۶۵۳۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إِذا کَانُوا یَتَحَدَّثُونَ بِذِکْرِ اللہِ فَلاَ بَأْسَ أَنْ یَأْتَمَّ بِہِمْ۔","","Musannaf Ibn Abi Shaybah 6533","","","كتاب الجمعة"
"6534","(۶۵۳۴) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : أُصَلِّی وَرَائَ قاعِدٍ أَحَبُّ إِلَیَّ مِنْ أَنْ أُصَلِّیَ وَرَائَ نَائِمٍ۔","","Musannaf Ibn Abi Shaybah 6534","","","كتاب الجمعة"
"6535","(۶۵۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ بْنُ صَبِیحٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَرِہَ أَنْ یَأْتَمَّ بِنَائِمٍ۔","","Musannaf Ibn Abi Shaybah 6535","","","كتاب الجمعة"
"6536","(۶۵۳۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ بْنُ عُبَیْدٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ رَأَی رَجُلاً یُصَلِّی وَعَلَیْہِ قَلَنْسُوَۃٌ ، بِطَانَتُہَا مِنْ جُلُودِ الثَّعَالِبِ ، قَالَ : فَأَلْقَاہَا عَنْ رَأْسِہِ ، وَقَالَ : مَا یُدْرِیَک لَعَلَّہُ لَیْسَ بِذَکِیٍّ ؟۔","Sahih","Musannaf Ibn Abi Shaybah 6536","","","كتاب الجمعة"
"6537","(۶۵۳۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ؛ أَنَّہُ کَانَ یَکْرَہُ الصَّلاَۃ فِی جُلُودِ الثَّعَالِبِ۔","","Musannaf Ibn Abi Shaybah 6537","","","كتاب الجمعة"
"6538","(۶۵۳۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ (ح) وَعَنْ أَشْعَثَ بْنِ عَبْدِ الْمَلِکِ ، عَنِ الْحَسَنِ ، أَنَّہُمَا قَالاَ : اِلْبَسْ جُلُودَ الثَّعَالِبِ ، وَلاَ تُصَلِّ فِیہَا۔","","Musannaf Ibn Abi Shaybah 6538","","","كتاب الجمعة"
"6539","(۶۵۳۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا إِذَا دُبِغَتْ۔","","Musannaf Ibn Abi Shaybah 6539","","","كتاب الجمعة"
"6540","(۶۵۴۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا یُونُسُ ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، قَالَ : رَأَیْتُ أَبَا الْعَالِیَۃَ دَخَلَ الْمَسْجِدَ فَصَلَّی فِیہِ ، وَعَلَیْہِ قَلَنْسُوَۃٌ بِطَانَتُہَا جُلُودُ ثَعَالِبَ ، فَأَخَذَہَا مِنْ رَأْسِہِ وَوَضَعَہَا فِی کُمِّہِ ، فَلَمَّا قَضَی صَلاَتَہُ ، قَالَ : قُلْتُ لَہُ : رَأَیْتُک أَخَذْتَ قَلَنْسُوَتَکَ مِنْ رَأْسِکَ فَوَضَعْتَہَا فِی کُمِّکَ ؟ فَقَالَ : إِنِّی کَرِہْتُ أَنْ أُصَلِّیَ فِیہَا ، وَکَرِہْتُ أَنْ أَضَعَہَا فَتُسْرَقَ ، فَلِذَلِکَ جَعَلْتُہَا فِی کُمِّ قَمِیصِی۔","","Musannaf Ibn Abi Shaybah 6540","","","كتاب الجمعة"
"6541","(۶۵۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَدِیرٍ الصَّیْرَفِیِّ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ لِعَلِیِّ بْنِ الْحُسَیْنِ سَبَنجُونَ ثَعَالِبَ یَلْبَسُہُ ، فَإِذَا صَلَّی نَزَعَہُ۔","","Musannaf Ibn Abi Shaybah 6541","","","كتاب الجمعة"
"6542","(۶۵۴۲) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن خَالِدٍ الْحَذَّائِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَعِیدِ بْنِ وَہْبٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا رَأَی قَوْمًا یُصَلُّونَ وَقَدْ سَدَلُوا ، فَقَالَ : کَأَنَّہُمُ الْیَہُودُ خَرَجُوا مِنْ فِہْرِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 6542","","","كتاب الجمعة"
"6543","(۶۵۴۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الْحَسَنِ بْنِ عُبیْدِ اللہِ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یَسْدُلَ الرَّجُلُ ثَوْبَہُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6543","","","كتاب الجمعة"
"6544","(۶۵۴۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کُرِہَ السَّدْلُ۔","","Musannaf Ibn Abi Shaybah 6544","","","كتاب الجمعة"
"6545","(۶۵۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَرِہَ السَّدْلَ فِی الصَّلاَۃ ، مُخَالَفَۃً لِلْیَہُودِ ، وَقَالَ : إِنَّہُمْ یَسْدُلُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 6545","","","كتاب الجمعة"
"6546","(۶۵۴۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، وَہُشَیْمٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ السَّدْلَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6546","","","كتاب الجمعة"
"6547","(۶۵۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَعَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُمَا کَرِہَا السَّدْلَ فِی الصَّلاَۃ ۔ قَالَ وَکِیعٌ : وَنَحْنُ نَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 6547","","","كتاب الجمعة"
"6548","(۶۵۴۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عِسْلِ بْنِ سُفْیَانَ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ السَّدْلِ فِی الصَّلاَۃ۔ (ترمذی ۳۷۸۔ احمد ۲/۲۹۵)","Da'if","Musannaf Ibn Abi Shaybah 6548","","","كتاب الجمعة"
"6549","(۶۵۴۹) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بِالسَّدْلِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 6549","","","كتاب الجمعة"
"6550","(۶۵۵۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَکْثَرُ مَا رَأَیْتُ عَطَائً یَسْدُلُ۔","","Musannaf Ibn Abi Shaybah 6550","","","كتاب الجمعة"
"6551","(۶۵۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ لاَ یَرَی بِہِ بَأْسًا ، إِذَا کَانَ عَلَیْہِ قَمِیصٌ۔","","Musannaf Ibn Abi Shaybah 6551","","","كتاب الجمعة"
"6552","(۶۵۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مُحَارِبٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَسْدُلُ فِی الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 6552","","","كتاب الجمعة"
"6553","(۶۵۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا أَبُو شِہَابٍ مُوسَی بْنُ ثَابِتٍ ، قَالَ: رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یَسْدُلُ فِی التَّطَوُّعِ، وَعَلَیْہِ مُسْتُقَۃٌ مُکَفَّفَۃٌ۔","","Musannaf Ibn Abi Shaybah 6553","","","كتاب الجمعة"
"6554","(۶۵۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ؛ أَنَّہُ کَانَ یَسْدُلُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6554","","","كتاب الجمعة"
"6555","(۶۵۵۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ حُمَیْدٍ، قَالَ: رَأَیْتُ الْحَسَنَ مَا لاَ أُحْصِی فِی الصَّلاَۃ یَسْدُلُ، وَأَنَا أَرَی ظَہْرَہُ۔","","Musannaf Ibn Abi Shaybah 6555","","","كتاب الجمعة"
"6556","(۶۵۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إِبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِالسَّدْلِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6556","","","كتاب الجمعة"
"6557","(۶۵۵۷) حَدَّثَنَا مُعَاذٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، قَالَ : رَأَیْتُ مُحَمَّدًا یُصَلِّی وَقَدْ سَدَلَ ثَوْبَہُ ، فَلاَ أَدْرِی عَلَی الإِزَارِ کَانَ ، أَوْ عَلَی الْقَمِیصِ۔","","Musannaf Ibn Abi Shaybah 6557","","","كتاب الجمعة"
"6558","(۶۵۵۸) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یَسْدُلُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6558","","","كتاب الجمعة"
"6559","(۶۵۵۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : رَأَیْتُ مَکْحُولاً یَسْدُلُ طَیْلَسَانَۃً عَلَیْہِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6559","","","كتاب الجمعة"
"6560","(۶۵۶۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا۔","","Musannaf Ibn Abi Shaybah 6560","","","كتاب الجمعة"
"6561","(۶۵۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، قَالَ : رَأَیْتُ الْحَسَنَ یَسْدُلُ عَلَی الْقَبَائِ۔","","Musannaf Ibn Abi Shaybah 6561","","","كتاب الجمعة"
"6562","(۶۵۶۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : سَأَلْتُ مُسْلِمَ بْنَ یَسَارٍ : أَیْنَ مُنْتَہَی الْبَصَرِ فِی الصَّلاَۃ ؟ فَقَالَ : إِنْ حَیْثُ تَسْجُدُ فَحَسَنٌ۔","Hasan","Musannaf Ibn Abi Shaybah 6562","","","كتاب الجمعة"
"6563","(۶۵۶۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْعَوَّامُ ، عَنْ إِبْرَاہِیمَ النَّخَعِیِّ ؛ أَنَّہُ کَانَ یُحِبُّ لِلْمُصَلِّی أَنْ لاَ یُجَاوِزَ بَصَرُہُ مَوْضِعَ سُجُودِہِ۔","","Musannaf Ibn Abi Shaybah 6563","","","كتاب الجمعة"
"6564","(۶۵۶۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حُرَّۃَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یُحِبُّ أَنْ یَضَعَ الرَّجُلُ بَصَرَہُ حِذَائَ مَوْضِعِ سُجُودِہِ ، فَإِنْ لَمْ یَفْعَلْ ، أَوْ کَلِمَۃً نَحْوَہَا فَلْیُغْمِضْ عَیْنَیْہِ۔","","Musannaf Ibn Abi Shaybah 6564","","","كتاب الجمعة"
"6565","(۶۵۶۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَرِہَ أَنْ یُصَلِّیَ الرَّجُلُ وَہُوَ مُغْمِضُ الْعَیْنِ۔","","Musannaf Ibn Abi Shaybah 6565","","","كتاب الجمعة"
"6566","(۶۵۶۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا جَمِیلُ بْنُ عُبَیْدٍ ، قَالَ : سَمِعْتُ الْحَسَنَ ، وَسَأَلَہُ رَجُلٌ : أُغْمِضُ عَیْنِی إِذَا سَجَدْتُ ؟ فَقَالَ : إِنْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 6566","","","كتاب الجمعة"
"6567","(۶۵۶۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ جَمِیلٍ ، قَالَ : سَمِعْتُ الْحَسَنَ ، وَسُئِلَ عَنِ الرَّجُلِ یُغْمِضُ عَیْنَیْہِ وَہُوَ سَاجِدٌ فِی الصَّلاَۃ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 6567","","","كتاب الجمعة"
"6568","(۶۵۶۸) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ بُرْدِ بْنِ أَبِی زِیَادٍ ، عَنْ أَبِی فَاخِتَۃَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : شُدَّ حَقْوَک فِی الصَّلاَۃ ، وَلَوْ بِعِقَالٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6568","","","كتاب الجمعة"
"6569","(۶۵۶۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یُصَلَّی إِلاَّ وَہُوَ مُؤْتَزِرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 6569","","","كتاب الجمعة"
"6570","(۶۵۷۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، قَالَ: رَأَیْتُ سَالِمَ بْنَ عَبْدِاللہِ یُصَلِّی وَہُوَ مُؤْتَزِرٌ فَوْقَ قَمِیصِہِ، أَوْ قَالَ: جُبَّتِہِ۔","","Musannaf Ibn Abi Shaybah 6570","","","كتاب الجمعة"
"6571","(۶۵۷۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ أَبِی مَالِکٍ؛ أَنَّہُ کَانَ یَشُدُّ حِقْوَہُ فِی الصَّلاَۃ بِخَیْطٍ، أَوْ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 6571","","","كتاب الجمعة"
"6572","(۶۵۷۲) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی الْہَیْثُمِ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : أُصَلِّی بِاللَّیْلِ فِی الْقَمِیصِ وَالْقَبَائِ ؟ قَالَ : شُدَّ حِقْوَک بِالإِزَارِ۔","","Musannaf Ibn Abi Shaybah 6572","","","كتاب الجمعة"
"6573","(۶۵۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : شُدَّ حِقْوَک وَلَوْ بِعِقَالٍ۔","","Musannaf Ibn Abi Shaybah 6573","","","كتاب الجمعة"
"6574","(۶۵۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عَطَائٍ الْبَکَّائِیِّ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، قَالَ : کَانَ یُقَالُ : شُدَّ حِقْوَک وَلَوْ بِعِقَالٍ۔","","Musannaf Ibn Abi Shaybah 6574","","","كتاب الجمعة"
"6575","(۶۵۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ شُعْبَۃَ ، عَنْ وَضَّاحٍ ؛ أَنَّہُمْ سَافَرُوا مَعَ جَابِرِ بْنِ زَیْدٍ ، فَکَانَ یَؤُمُّہُمْ مُؤْتَزِرًا فَوْقَ الْقَمِیصِ۔","","Musannaf Ibn Abi Shaybah 6575","","","كتاب الجمعة"
"6576","(۶۵۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنِ ابْنِ عَوْنٍ، عَنْ مُحَمَّدٍ؛ أَنَّہُ کَانَ یَکْرَہُ لِلرَّجُلِ وَالْمَرْأَۃِ یُصَلِّیَانِ بِغَیْرِ إزَارٍ۔","","Musannaf Ibn Abi Shaybah 6576","","","كتاب الجمعة"
"6577","(۶۵۷۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ جُہَیْرِ بْنِ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ ؛ سَأَلْتُُہُ عَنِ الرَّجُلِ یُصَلِّی مُؤْتَزِرًا فَوْقَ الْقَمِیصِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 6577","","","كتاب الجمعة"
"6578","(۶۵۷۸) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ عَبْدِ الرَّحْمَنِ الأَشْجَعِیِّ ، عَنِ ابْنِ مَعْقِلٍ ، قَالَ : شُدَّ حِقْوَک ، وَلَوْ بِعِقَالٍ۔","","Musannaf Ibn Abi Shaybah 6578","","","كتاب الجمعة"
"6579","(۶۵۷۹) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : شُدَّ حِقْوَک بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 6579","","","كتاب الجمعة"
"6580","(۶۵۸۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنِ الْحَارِثِ بْنِ ثَقِیفٍ ، عَنِ الْحَسَنِ ، قَالَ : شُدَّ حِقْوَک ، وَلَوْ بِعِقَالٍ۔","","Musannaf Ibn Abi Shaybah 6580","","","كتاب الجمعة"
"6581","(۶۵۸۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنِ ابْنِ الأَسْوَدِ ، وَإِبْرَاہِیمَ ؛ أَنَّہُمَا کَانَا یَؤُمَّانِ بِغَیْرِ إِزَارٍ۔","","Musannaf Ibn Abi Shaybah 6581","","","كتاب الجمعة"
"6582","(۶۵۸۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُجَالِدٌ ؛ أَنَّ أَبَا ہُبَیْرَۃَ الأَنْصَارِیَّ سَأَلَ الشَّعْبِیَّ ، فَقَالَ : أَشُدُّ حِقْوِی إِذَا قُمْتُ أُصَلِّی ؟ فَقَالَ لَہُ الشَّعْبِیُّ : إِنَّمَا یَفْعَلُ ذَلِکَ الْمَجُوسُ۔","","Musannaf Ibn Abi Shaybah 6582","","","كتاب الجمعة"
"6583","(۶۵۸۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ ، قَالَ : إِذَا ضَمَمْتَ عَلَیْک الْقَبَائَ ، أَجْزَأَکَ مَجْزَأَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 6583","","","كتاب الجمعة"
"6584","(۶۵۸۴) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الرَّبِیعِ بْنِ حَسَّانٍ ، قَالَ : رَأَیْتُ أَبَا الْبَخْتَرِیَّ یُصَلِّی فِی قَبَائٍ۔","","Musannaf Ibn Abi Shaybah 6584","","","كتاب الجمعة"
"6585","(۶۵۸۵) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إِسْرَائِیلَ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إِبْرَاہِیمَ بْنِ سُوَیْد ، قَالَ : قدِمَ الأَسْوَدُ مِنْ سَفَرٍ ، فَصَلَّی وَعَلَیْہِ قَبَائٌ۔","","Musannaf Ibn Abi Shaybah 6585","","","كتاب الجمعة"
"6586","(۶۵۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن ہَمَّامٍ ، قَالَ : صَلَّی حُذَیْفَۃُ عَلَی دُکَّانٍ وَہُمْ أَسْفَلُ مِنْہُ ، قَالَ : فَجَذَبَہُ سَلْمَانُ حَتَّی أَنْزَلَہُ ، فَلَمَّا انْصَرَفَ ، قَالَ لَہُ : أَمَا عَلِمْتَ أَنَّ أَصْحَابَک کَانُوا یَکْرَہُونَ أَنْ یُصَلِّیَ الإِمَامُ عَلَی الشَّیْئِ ، وَہُمْ أَسْفَلُ مِنْہُ ؟ قَالَ : فَقَالَ حُذَیْفَۃُ : بَلَی ، قَدْ ذَکَرْتُ حِینَ مَدَدْتَنِی۔","Sahih","Musannaf Ibn Abi Shaybah 6586","","","كتاب الجمعة"
"6587","(۶۵۸۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : صَلَّی حُذَیْفَۃُ عَلَی دُکَّانٍ بِالْمَدَائِنِ ، أَرْفَعَ مِنْ أَصْحَابِہِ ، فَمَدَّہُ أَبُو مَسْعُودٍ ، فَقَالَ لَہُ : أَمَّا عَلِمْتَ أَنْ ہَذَا یُکْرَہُ ؟ قَالَ : أَلَمْ تَرَ أَنَّک لَمَّا ذَکَّرْتَنِی ذَکَرْتُ۔","","Musannaf Ibn Abi Shaybah 6587","","","كتاب الجمعة"
"6588","(۶۵۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَرِہَ أَنْ یَرْتَفِعَ الإِمَامُ عَلَی أَصْحَابِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 6588","","","كتاب الجمعة"
"6589","(۶۵۸۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ شَاذَرْوَانُ الْقَصْرِ یَقُومُ عَلَیْہِ الإِمَامُ ۔ قَالَ : فَکَرِہَہُ عَبْدُ اللہِ ، وَأَمَرَ بِہِ فَکُسِرَ۔","","Musannaf Ibn Abi Shaybah 6589","","","كتاب الجمعة"
"6590","(۶۵۹۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَکُونَ مَکَانُ الإِمَامِ أَرْفَعَ مِنْ مَکَانِ الْقَوْمِ ، وَکَانَ یَکْرَہُ أَنْ یَرْفَعَ الرَّجُلُ فِی مُصَلاَّہُ شَیْئًا یَسْجُدُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 6590","","","كتاب الجمعة"
"6591","(۶۵۹۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ بِلاَلٍ الْعَبْسِیِّ ، قَالَ : رَأَی عَمَّارٌ رَجُلاً یُصَلِّی عَلَی رَابِیَۃٍ ، فَأَخَذَ بِقَفَاہُ ، فَحَطَّہُ إِلَی الأَرْضِ ، فَقَالَ : صَلِّ ہَاہُنَا۔","","Musannaf Ibn Abi Shaybah 6591","","","كتاب الجمعة"
"6592","(۶۵۹۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُثْمَانُ بْنِ أَبِی ہِنْدٍ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یُصَلِّی فَوْقَ کَنِیسَۃٍ بِالشَّامِ ، وَالنَّاسُ أَسْفَلَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 6592","","","كتاب الجمعة"
"6593","(۶۵۹۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا أَنْ یُصَلِّیَ الإِمَامُ عَلَی مَکَان أَرْفَعَ مِنْ أَصْحَابِہِ۔","","Musannaf Ibn Abi Shaybah 6593","","","كتاب الجمعة"
"6594","(۶۵۹۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، وَمُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِمَامُ الْقَوْمِ ضَامِنٌ ، فَلاَ یَخُصُّ نَفْسَہُ بِشَیْئٍ مِنَ الدُّعَائِ دُونَہُمْ۔","","Musannaf Ibn Abi Shaybah 6594","","","كتاب الجمعة"
"6595","(۶۵۹۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، قَالَ : قَالَ أَبُو قِلاَبَۃَ : تَدْرِی لِمَ کُرِہَتِ الإِمَامۃُ ؟ قَالَ : لاَ ، وَلَکِنَّہَا کُرِہَتْ أَنَّہُ لَیْسَ لإِمَامٍ أَنْ یَخُصَّ نَفْسَہُ بِدُعَائٍ مِنْ دُونِ مَنْ وَرَائَہُ۔","","Musannaf Ibn Abi Shaybah 6595","","","كتاب الجمعة"
"6596","(۶۵۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یُکْرَہُ أَنْ یَخُصَّ الإِمَام نَفْسَہُ بِشَیْئٍ مِنْ دُونِ أصْحَابِہِ۔","","Musannaf Ibn Abi Shaybah 6596","","","كتاب الجمعة"
"6597","(۶۵۹۷) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہَارُونَ بْنِ إِبْرَاہِیمَ ، قَالَ : قُلْتُ لاِبْنِ سِیرِینَ : لِلإِمَامِ أَنْ یَخُصَّ بِشَیْئٍ مِنَ الدُّعَائِ ؟ قَالَ : لاَ ، فَلْیَدْعُ لَہُمْ کَمَا یَدْعُو لِنَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 6597","","","كتاب الجمعة"
"6598","(۶۵۹۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، ومُجَاہِدٍ ، قَالَ : لاَ یَنْبَغِینَّ لِلإِمَامِ أَنْ یَخُصَّ نَفْسَہُ بِدُعَائٍ مِنْ دُونِ الْقَوْمِ۔","","Musannaf Ibn Abi Shaybah 6598","","","كتاب الجمعة"
"6599","(۶۵۹۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنْ کُرْدُوسٍ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَانَ یَکْرَہُ إِذَا کَانَ الرَّجُلُ فِی الْقَوْمِ أَنْ یَخُصَّ نَفْسَہُ بِشَیْئٍ مِنَ الدُّعَائِ دُونَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 6599","","","كتاب الجمعة"
"6600","(۶۶۰۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَا أُبَالِی نَفَخْتُ ، أَوْ تَکَلَّمْتُ ۔ وَقَالَ : النَّفْخُ فِی الصَّلاَۃ کَلاَمٌ۔","","Musannaf Ibn Abi Shaybah 6600","","","كتاب الجمعة"
"6601","(۶۶۰۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ؛ أَنَّہُ کَانَ یَکْرَہُ النَّفْخَ فِی الصَّلاَۃ ، وَقَالَ: نَحِّہِ بِثَوْبِکَ، أَوْ بِکُمِّ قَمِیصِکَ ۔ وَکُرِہَ النَّفْخُ۔","","Musannaf Ibn Abi Shaybah 6601","","","كتاب الجمعة"
"6602","(۶۶۰۲) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ ابْنِ أَبِی الْہُذَیْلِ ، قَالَ : لأَنْ أَسْجُدَ عَلَی الرَّضْفِ أَحَبُّ إِلَیَّ أَنْ أَنْفُخَ فِی صَلاَتِی۔","","Musannaf Ibn Abi Shaybah 6602","","","كتاب الجمعة"
"6603","(۶۶۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، قَالَ : لأَنْ أَضَعَ جَبْہَتِی عَلَی جَمْرَۃٍ حَتَّی تُطْفَأَ ، أَحَبُّ إِلَیَّ مِنْ أَنْ أَنْفُخَ فِی صَلاَتِی ، ثُمَّ أَسْجُدَ۔","","Musannaf Ibn Abi Shaybah 6603","","","كتاب الجمعة"
"6604","(۶۶۰۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : النَّفْخُ فِی الصَّلاَۃ کَلاَمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 6604","","","كتاب الجمعة"
"6605","(۶۶۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ أَبِی الضُّحَی ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : النَّفْخُ فِی الصَّلاَۃِ یَقْطَعُ الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 6605","","","كتاب الجمعة"
"6606","(۶۶۰۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ النَّفْخَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6606","","","كتاب الجمعة"
"6607","(۶۶۰۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یَکْرَہُ النَّفْخَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6607","","","كتاب الجمعة"
"6608","(۶۶۰۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ إِسْرَائِیلَ ، عَنْ أَبِی حَصِینٍ ؛ أَنَّ أَبَا عَبْدِ الرَّحْمَنِ کَرِہَ النَّفْخَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6608","","","كتاب الجمعة"
"6609","(۶۶۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ کَہَمْسٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ : کَانَ یُقَالُ : مِنَ الْجَفَائِ أَنْ یَنْفُخَ الرَّجُلُ فِی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 6609","","","كتاب الجمعة"
"6610","(۶۶۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ سُفْیَانَ الْعُصْفُرِیِّ ، قَالَ : صَلَّیْتُ فِی حُجْرَۃِ الشَّعْبِیِّ فَنَفَخْتُ ، فَنَہَانِی ، وَقَالَ : إِنْ رَأَیْتَ أَذًی فَامْسَحْہُ بِیَدِک۔","","Musannaf Ibn Abi Shaybah 6610","","","كتاب الجمعة"
"6611","(۶۶۱۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ أَبِی صَالِحٍ؛ أَنَّ قَرِیبًا لأُمِّ سَلَمَۃَ صَلَّی فَنَفَخَ ، فَقَالَتْ أُمُّ سَلَمَۃَ: لاَ تَفْعَلْ ، فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِغُلاَمٍ لَنَا أَسْوَدَ ، یُقَالُ لَہُ : رَبَاحٌ : تَرِّبْ یَا رَبَاحُ وَجْہَک۔ (ترمذی ۳۸۲۔ احمد ۶/۳۲۳)","Da'if","Musannaf Ibn Abi Shaybah 6611","","","كتاب الجمعة"
"6612","(۶۶۱۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ؛ أَنَّہُ کَرِہَ النَّفْخَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6612","","","كتاب الجمعة"
"6613","(۶۶۱۳) حَدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ؛ أَنَّہُ رَأَی مُجَاہِدًا یَتَرَوَّحُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6613","","","كتاب الجمعة"
"6614","(۶۶۱۴) حَدَّثَنَا وَکِیعٌ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ، عَنْ أَبِی السَّفَرِ، قَالَ: أَدْرَکْنَا أَشْیَاخَ الْحَیِّ وَالشَّبَابَ یُرَوِّحُونَہُمْ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6614","","","كتاب الجمعة"
"6615","(۶۶۱۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ عُبَیْدَۃَ ابْنَۃِ نَابِلٍ ، مَوْلاَۃِ عَائِشَۃَ ابْنَۃِ سَعْدٍ ، قَالَتْ : رَأَیْتُ عَائِشَۃَ ابْنَۃَ سَعْدٍ تَنْفُضُ دِرْعَہَا فِی الصَّلاَۃ ۔ أَیْ تُرَوِّحُ بِہِ۔","","Musannaf Ibn Abi Shaybah 6615","","","كتاب الجمعة"
"6616","(۶۶۱۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ ہَارُونَ بْنِ إِبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ بَأْسَ بِالتَّرَوُّحِ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6616","","","كتاب الجمعة"
"6617","(۶۶۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ مُبَارَکٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَہُ عَبَثًا ، وَلَمْ یَرَ بِہِ فِی شِدَّۃِ الْحَرِّ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 6617","","","كتاب الجمعة"
"6618","(۶۶۱۸) حَدَّثَنَا عَبْدُاللہِ بْنُ مُبَارَکٍ، وَوَکِیعٌ، عَنْ عَبْدِاللہِ بْنِ مُسْلِمِ بْنِ یَسَارٍ، عَنْ أَبِیہِ؛ أَنَّہُ کَرِہَ التَّرَوُّحَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6618","","","كتاب الجمعة"
"6619","(۶۶۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ عَبْدِ الْکَرِیمِ أَبِی أُمَیَّۃَ ، عَنْ عُمَیْرٍ ، قَالَ : تَرَوَّحْتُ بَیْنَ أَبِی الْعَالِیَۃِ وَمُسْلِمِ بْنِ یَسَارٍ ، فَنَہَیَانِی۔","","Musannaf Ibn Abi Shaybah 6619","","","كتاب الجمعة"
"6620","(۶۶۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ رَجُلٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ التَّرَوُّحَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6620","","","كتاب الجمعة"
"6621","(۶۶۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، وَسُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ السُّلَمِیِّ؛ أَنَّہُ کَرِہَ التَّرَوُّحَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6621","","","كتاب الجمعة"
"6622","(۶۶۲۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کُنَّا نَغْزُو مَعَ جُنَادَۃَ بْنِ أَبِی أُمَیَّۃَ الْبَحْرَ ، فَکُنَّا نُصَلِّی فِی السَّفِینَۃِ قُعُودًا۔","","Musannaf Ibn Abi Shaybah 6622","","","كتاب الجمعة"
"6623","(۶۶۲۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، أَنَّ ابْنَ سِیرِینَ ، قَالَ : خَرَجْتُ مَعَ أَنَسٍ إِلَی بَنِی سِیرِینَ فِی سَفِینَۃٍ عَظِیمَۃٍ۔ قَالَ : فَأَمَّنَا ، فَصَلَّی بِنَا فِیہَا جُلُوسًا رَکْعَتَیْنِ ، ثُمَّ صَلَّی بِنَا رَکْعَتَیْنِ أُخْرَاوَیْنِ۔","","Musannaf Ibn Abi Shaybah 6623","","","كتاب الجمعة"
"6624","(۶۶۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالصَّلاَۃ فِی السَّفِینَۃِ جَالِسًا۔","","Musannaf Ibn Abi Shaybah 6624","","","كتاب الجمعة"
"6625","(۶۶۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خُزَیْمَۃَ ، عن َطَاوُوسٍ ، قَالَ : صَلِّ فِیہَا قَاعِدًا۔","","Musannaf Ibn Abi Shaybah 6625","","","كتاب الجمعة"
"6626","(۶۶۲۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ حُمَیْدٍ ، قَالَ : سُئِلَ أَنَسٌ عَنِ الصَّلاَۃ فِی السَّفِینَۃِ ؟ فَقَالَ عَبْدُ اللہِ بْنُ أَبِی عُتْبَۃَ مَوْلَی أَنَسٍ ، وَہُوَ مَعَنَا جَالِسٌ : سَافَرْتُ مَعَ أَبِی سَعِیدٍ الْخُدْرِیِّ ، وَأَبِی الدَّرْدَائِ ، وَجَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ حُمَیْدُ : وَأُنَاسٍ قَدْ سَمَّاہُمْ ، فَکَانَ إِمَامُنَا یُصَلِّی بِنَا فِی السَّفِینَۃِ قَائِمًا ، وَنُصَلِّی خَلْفَہُ قِیَامًا ، وَلَوْ شِئْنَا لأَرْفَأنَا وَخَرَجْنَا۔","Sahih","Musannaf Ibn Abi Shaybah 6626","","","كتاب الجمعة"
"6627","(۶۶۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ بْنِ یَسَارٍ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَاہُ کَانَ یَنْصِبُ عَلَمًا فِی السَّفِینَۃِ ، یُصَلِّی قَائِمًا ، وَإِنَّہَا لَمَرْفُوعَۃٌ شِرَاعُہَا تَجْرِی۔","","Musannaf Ibn Abi Shaybah 6627","","","كتاب الجمعة"
"6628","(۶۶۲۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، وَالْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالُوا : صَلِّ فِی السَّفِینَۃِ قَائِمًا ۔ وَقَالَ الْحَسَنُ : لاَ تَشُقَّ عَلَی أَصْحَابِک۔","","Musannaf Ibn Abi Shaybah 6628","","","كتاب الجمعة"
"6629","(۶۶۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ قَالَ فِی الصَّلاَۃ فِی السَّفِینَۃِ : إِنْ شِئْتَ قَائِمًا ، وَإِنْ شِئْتَ قَاعِدًا ، وَالْقِیَامُ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 6629","","","كتاب الجمعة"
"6630","(۶۶۳۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ قَالَ : یُصَلِّی فِی السَّفِینَۃِ قَائِمًا ، فَإِنْ لَمْ یَسْتَطِعْ فَقَاعِدًا ، وَاسْجُدْ عَلَی قَرَارٍ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 6630","","","كتاب الجمعة"
"6631","(۶۶۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : صَلِّ فِیہَا قَائِمًا۔","","Musannaf Ibn Abi Shaybah 6631","","","كتاب الجمعة"
"6632","(۶۶۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : صَلِّ فِی السَّفِینَۃِ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 6632","","","كتاب الجمعة"
"6633","(۶۶۳۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَنِ الصَّلاَۃ فِی السَّفِینَۃِ ؟ فَقَالَ : إِنِ اسْتَطَاعَ أَنْ یَخْرُجَ فَلْیَخْرُجْ ، وَإِلاَّ فَلَیُصَلِّ قَائِمًا ، فَإِنِ اسْتَطَاعَ ، وَإِلاَّ فَلْیُصَلِّ قَاعِدًا وَیَسْتَقْبِلَ الْقِبْلَۃَ کُلَّمَا تَحَرَّفَتْ۔","","Musannaf Ibn Abi Shaybah 6633","","","كتاب الجمعة"
"6634","(۶۶۳۴) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : یُصَلِّی فِیہَا قَائِمًا ، فَإِنْ لَمْ یَسْتَطِعْ فَقَاعِدًا ، وَإِنِ اسْتَطَاعَ أَنْ یَخْرُجَ إِلَی الْجُدِّ فَلْیَخْرُجْ۔","","Musannaf Ibn Abi Shaybah 6634","","","كتاب الجمعة"
"6635","(۶۶۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ، قَالَ : یَنْصِبُ عَلَمًا فِی السَّفِینَۃِ ثُمَّ یَتَّبِعْہُ۔","","Musannaf Ibn Abi Shaybah 6635","","","كتاب الجمعة"
"6636","(۶۶۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعَلاَئُ بْنُ قَیْسٍ الْکَاہِلِیُّ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الصَّلاَۃ فِی السَّفِینَۃِ ؟ فَقَالَ : لاَ تُصَلُّوا فِیہَا مَا وَجَدْتُمْ جُدًّا۔","","Musannaf Ibn Abi Shaybah 6636","","","كتاب الجمعة"
"6637","(۶۶۳۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یَسْتَقْبِلُ الْقِبْلَۃَ کُلَّمَا تَحَرَّفَتْ۔","","Musannaf Ibn Abi Shaybah 6637","","","كتاب الجمعة"
"6638","(۶۶۳۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یَدُورُونَ مَعَ الْقِبْلَۃِ حَیْثُ دَارَتِ السَّفِینَۃُ۔","","Musannaf Ibn Abi Shaybah 6638","","","كتاب الجمعة"
"6639","(۶۶۳۹) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ، عَنْ أَبِیہِ، عَنِ الْحَکَمِ ، قَالَ : تَیَمَّمِ الْقِبْلَۃَ حَیْثُ دَارَتِ السَّفِینَۃُ۔","","Musannaf Ibn Abi Shaybah 6639","","","كتاب الجمعة"
"6640","(۶۶۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ بْنُ صَبِیحٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالاَ : یُصَلُّونَ فِیہَا قِیَامًا جَمَاعَۃً ، وَیَدُورُونَ مَعَ الْقِبْلَۃِ حَیْثُ دَارَتْ۔","","Musannaf Ibn Abi Shaybah 6640","","","كتاب الجمعة"
"6641","(۶۶۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، قَالَ : سَمِعْتُ عَطَائً ، وَسُئِلَ عَنْ مَلاَّحٍ یَکُونُ فِی سَفِینَۃٍ ، وَمَعَہُ فِیہَا أَہْلُہُ ، وَہِیَ مَنْزِلُہُ ، یُسَافِرُ فِیہَا ؟ قَالَ : یُصَلِّی فِیہَا أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 6641","","","كتاب الجمعة"
"6642","(۶۶۴۲) حَدَّثَنَا حَفْصٌ ، عَنْ إِسْمَاعِیلَ ، قَالَ : سُئِلَ الْحَسَنُ عَنِ الْمَلاَّحِینَ یَکُونُونَ فِی السَّفِینَۃِ فِی أَہَالِیہمْ ، یُتِمُّونَ الصَّلاَۃ ؟ قَالَ : نَعَمْ ، ہِیَ مَنَازِلُہُمْ۔","","Musannaf Ibn Abi Shaybah 6642","","","كتاب الجمعة"
"6643","(۶۶۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِیَاسُ بْنُ دَغْفَلٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الصَّلاَۃ فِی السَّفِینَۃِ ؟ فَقَالَ : ہُمْ مُطْمَئِنُّونَ۔","","Musannaf Ibn Abi Shaybah 6643","","","كتاب الجمعة"
"6644","(۶۶۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ حَوْشَبِ بْنِ عَقِیلٍ الْعَبْدِیِّ ، قَالَ : سُئِلَ الْحَسَنُ عَنِ الْمَلاَّحِ الْمَجُوسِیِّ یَکُونُ بَیْنَ یَدَیِ الْقَوْمِ فِی السَّفِینَۃِ وَہُمْ یُصَلُّونَ ، وَہُوَ قَائِمٌ ؟ قَالَ : یُصَلَّی خَلْفَہُ ، وَإِنْ کَانَ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 6644","","","كتاب الجمعة"
"6645","(۶۶۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مَطَرٍ ، عَنْ عَطَائِ ؛ فِی الْمَلاَّحِینَ الْمَجُوسِیِّینَ یَکُونُونَ بَیْنَ یَدَیِ الْقَوْمِ فِی السَّفِینَۃِ وَہُمْ یُصَلُّونَ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 6645","","","كتاب الجمعة"
"6646","(۶۶۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ السُّدِّیِّ ، عَنْ رَجُلٍ ، یُقَالُ لَہُ : یَزِیدُ ، عَنْ عَمَّارِ بْنِ یَاسِرٍ ؛ أَنَّہُ أُغْمِیَ عَلَیْہِ الظُّہْرَ ، وَالْعَصْرَ ، وَالْمَغْرِبَ ، وَالْعِشَائَ ، فَأَفَاقَ فِی بَعْضِ اللَّیْلِ فَقَضَاہُنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 6646","","","كتاب الجمعة"
"6647","(۶۶۴۷) حَدَّثَنَا حَفْصٌ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : قیلَ لِعِمْرَانَ بْنِ حُصَیْنٍ : إِنَّ سَمُرَۃَ بْنَ جُنْدُبٍ یَقُولُ فِی الْمُغْمَی عَلَیْہِ : یَقْضِی مَعَ کُلِّ صَلاَۃٍ مِثْلَہَا ، فَقَالَ عِمْرَانُ : لَیْسَ کَمَا قَالَ ، یَقْضِیہِنَّ جَمِیعًا۔","Sahih","Musannaf Ibn Abi Shaybah 6647","","","كتاب الجمعة"
"6648","(۶۶۴۸) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، وَأَشْعَثَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ أُغْمِیَ عَلَیْہِ أَیَّامًا ، فَأَعَادَ صَلاَۃَ یَوْمِہِ الَّذِی أَفَاقَ فِیہِ ، وَلَمْ یُعِدْ شَیْئًا مِمَّا مَضَی۔","","Musannaf Ibn Abi Shaybah 6648","","","كتاب الجمعة"
"6649","(۶۶۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ أُغْمِیَ عَلَیْہِ ، قَالَ وَکِیعٌ : أُرَاہُ قَالَ : شَہْرًا ، فَصَلَّی صَلاَۃَ یَوْمِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 6649","","","كتاب الجمعة"
"6650","(۶۶۵۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ، أَنَّہُمْ قَالُوا فِی الْمُغْمَی عَلَیْہِ : یَقْضِی صَلاَتَہُ کَمَا یَقْضِی رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 6650","","","كتاب الجمعة"
"6651","(۶۶۵۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یَقْضِی صَلاَۃَ یَوْمِہِ الَّذِی أَفَاقَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 6651","","","كتاب الجمعة"
"6652","(۶۶۵۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : سَأَلْتُُہُ عَنِ الْمُغْمَی عَلَیْہِ إِذَا أَفَاقَ ؟ قَالَ : یَقْضِی صَلاَۃَ یَوْمِہِ الَّذِی أَفَاقَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 6652","","","كتاب الجمعة"
"6653","(۶۶۵۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : إِذَا أُغْمِیَ عَلَی الرَّجُلِ صَلاَتَیْنِ لَمْ یُعِدْ ، وَإِذَا أُغْمِیَ عَلَیْہِ صَلاَۃٌ وَاحِدَۃٌ أَعَادَہَا۔","","Musannaf Ibn Abi Shaybah 6653","","","كتاب الجمعة"
"6654","(۶۶۵۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَارِثِ ، عَنْ إِبْرَاہِیمِ ، قَالَ : کَانَ یَقُولُ فِی الْمُغْمَی عَلَیْہِ : إِذَا أُغْمِیَ عَلَیْہِ یَوْمٌ وَلَیْلَۃٌ أَعَادَ ، وَإِذَا کَانَ أَکْثَرَ مِنْ ذَلِکَ لَمْ یُعِدْ۔","","Musannaf Ibn Abi Shaybah 6654","","","كتاب الجمعة"
"6655","(۶۶۵۵) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إِذَا أُغْمِیَ عَلَی الرَّجُلِ أَیَّامًا ثُمَّ أَفَاقَ ، قَضَی صَلاَۃَ یَوْمِہِ وَلَیْلَتِہِ۔","","Musannaf Ibn Abi Shaybah 6655","","","كتاب الجمعة"
"6656","(۶۶۵۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مِجْشَرٍ ؛ أَنَّ مَیْمُونًا کَانَ یَرَی أَنْ یَقْضِیَ الرَّجُلُ الْمُغْمَی عَلَیْہِ الصَّلاَۃ کَمَا یَقْضِی الصَّوْمَ۔","","Musannaf Ibn Abi Shaybah 6656","","","كتاب الجمعة"
"6657","(۶۶۵۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ بْنُ عُبَیْدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أُغْمِیَ علَیْہِ أَیَّامًا فَلَمْ یُعِدْ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 6657","","","كتاب الجمعة"
"6658","(۶۶۵۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا جُوَیْبِرٌ ، عَنِ الضَّحَّاکِ ، قَالَ : أُغْمِیَ عَلَیْہِ صَلَوَاتٌ ، فَقِیلَ لَہُ : إِنَّہُ قَدْ ذَہَبَ مُنْذُ کَذَا وَکَذَا صَلاَۃٌ ، قَالَ : فَقَالَ : لَمْ یَذْہَبْ مِنِّی شَیْئٌ ، وَلَمْ یُعِدْ۔","","Musannaf Ibn Abi Shaybah 6658","","","كتاب الجمعة"
"6659","(۶۶۵۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : الْمُغْمَی عَلَیْہِ یَقْضِی الصِّیَامَ ، وَلاَ یَقْضِی الصَّلاَۃ ، کَمَا أَنَّ الْحَائِضَ تَقْضِی الصِّیَامَ وَلاَ تَقْضِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6659","","","كتاب الجمعة"
"6660","(۶۶۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : الْمُغْمَی عَلَیْہِ لاَ یَقْضِی ، اسْتَنَّ بِأُمَّہَاتِ الْمُؤْمِنِینَ ، لَمْ یَکُنْ یَقْضِینَ فِی حَیْضَتِہِنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 6660","","","كتاب الجمعة"
"6661","(۶۶۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الْمُغْمَی عَلَیْہِ لاَ یَقْضِی ۔ قَالَ : وَأُغْمِیَ عَلَی ابْنِ سِیرِینَ أَیَّامًا فَلَمْ یَقْضِ۔","","Musannaf Ibn Abi Shaybah 6661","","","كتاب الجمعة"
"6662","(۶۶۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ أُغْمِیَ عَلَیْہِ یَوْمَیْنِ فَلَمْ یَقْضِ۔","Da'if","Musannaf Ibn Abi Shaybah 6662","","","كتاب الجمعة"
"6663","(۶۶۶۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ فِی الْمُغْمَی عَلَیْہِ ، قَالَ : لَیْسَ عَلَیْہِ إِعَادَۃٌ۔","","Musannaf Ibn Abi Shaybah 6663","","","كتاب الجمعة"
"6664","(۶۶۶۴) حَدَّثَنَا وَکِیعٌ ، وَالَّذِی یَأْخُذُ بِہِ النَّاسُ : الَّذِی یُغْمَی عَلَیْہِ أَیَّامًا ، لاَ یَقْضِی إِلاَّ صَلاَۃَ یَوْمِہِ الَّذِی أَفَاقَ فِیہِ مِثْلُ الْحَائِضِ ، وَالَّذِی یُغْمَی عَلَیْہِ یَوْمًا وَاحِدًا یَقْضِی صَلاَۃَ ذَلِکَ الْیَوْمِ۔","","Musannaf Ibn Abi Shaybah 6664","","","كتاب الجمعة"
"6665","(۶۶۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إِبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : نُـبِّئْتُ أَنَّ مَسْرُوقًا کَانَ یَحْمِلُ مَعَہُ لَبِنَۃً فِی السَّفِینَۃِ ، یَعْنِی یَسْجُدُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 6665","","","كتاب الجمعة"
"6666","(۶۶۶۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حَدَّثَنَا ابْنُ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّ مَسْرُوقًا کَانَ إِذَا سَافَرَ حَمَلَ مَعَہُ فِی السَّفِینَۃِ لَبِنَۃً یَسْجُدُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 6666","","","كتاب الجمعة"
"6667","(۶۶۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَسْجُدَ عَلَی الْخَشَبَتَیْنِ الْمَقْرُونَتَیْنِ فِی السَّفِینَۃِ۔","","Musannaf Ibn Abi Shaybah 6667","","","كتاب الجمعة"
"6668","(۶۶۶۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو عَامِرٍ الْمُزَنِیُّ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلُّوا مِنَ اللَّیْلِ أَرْبَعًا ، صَلُّوا وَلَوْ رَکْعَتَیْنِ ، مَا مِنْ أَہْلِ بَیْتٍ یُعْرَفُ لَہُمْ صَلاَۃٌ مِنَ اللَّیْلِ إِلاَّ نَادَاہُمْ مُنَادٍ: یَا أَہْلَ الْبَیْتِ : قُومُوا لِصَلاَتِکُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 6668","","","كتاب الجمعة"
"6669","(۶۶۶۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : رَحِمَ اللَّہُ رَجُلاً قَامَ مِنَ اللَّیْلِ فَصَلَّی ، ثُمَّ أَیْقَظَ أَہْلَہُ فَصَلَّوْا ، رَحِمَ اللَّہُ امْرَأَۃً قَامَتْ مِنَ اللَّیْلِ فَصَلَّتْ ، ثُمَّ أَیْقَظَتْ زَوْجَہَا فَصَلَّی۔ (ابوداؤد ۱۴۴۵۔ احمد ۲/۲۵۰)","Hasan","Musannaf Ibn Abi Shaybah 6669","","","كتاب الجمعة"
"6670","(۶۶۷۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : صَلُّوا مِنَ اللَّیْلِ وَلَوْ قَدْرَ حَلْبِ شَاۃٍ۔","","Musannaf Ibn Abi Shaybah 6670","","","كتاب الجمعة"
"6671","(۶۶۷۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَسْتَحِبُّ أَنْ لاَ یَتْرُکَ الرَّجُلُ قِیَامَ اللَّیْلِ ، وَلَوْ قَدْرَ حَلْبِ شَاۃٍ۔","","Musannaf Ibn Abi Shaybah 6671","","","كتاب الجمعة"
"6672","(۶۶۷۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ مِسْعَرٍ ، عَنْ زُبَیْدٍ ، عَنْ مُرَّۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : فَضْلُ صَلاَۃِ اللَّیْلِ عَلَی صَلاَۃِ النَّہَارِ ، کَفَضْلِ صَدَقَۃِ السِّرِّ عَلَی صَدَقَۃِ الْعَلاَنِیَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 6672","","","كتاب الجمعة"
"6673","(۶۶۷۳) حَدَّثَنَا حَمَّادُ بن خَالِدٍ ، عَنِ الزُّبَیْرِ بْنِ عَبْدِ اللہِ بْنِ رُہَیْمَۃَ ، عَنْ جَدَّتِہِ ، قَالَتْ : کَانَ عُثْمَانُ یَصُومُ الدَّہْرَ ، وَیَقُومُ اللَّیْلَ إِلاَّ ہَجْعَۃً مِنْ أَوَّلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 6673","","","كتاب الجمعة"
"6674","(۶۶۷۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : ذُکِرَ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ ، فَقِیلَ : یَا رَسُولَ اللہِ ، إِنَّ فُلاَنًا نَامَ اللَّیْلَ حَتَّی أَصْبَحَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ذَاکَ رَجُلٌ بَالَ الشَّیْطَانُ فِی أُذُنِہِ ، أَوْ أُذُنَیْہِ۔ (بخار ی۱۱۴۴۔ مسلم ۵۳۷)","Sahih","Musannaf Ibn Abi Shaybah 6674","","","كتاب الجمعة"
"6675","(۶۶۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنِ الأَغَرِّ أَبِی مُسْلِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، وَأَبِی سَعِیدٍ ، قَالاَ : إِذَا أَیْقَظَ الرَّجُلُ امْرَأَتَہُ مِنَ اللَّیْلِ فَصَلَّیَا ، کُتِبَا مِنَ الذَّاکِرِینَ اللَّہَ کَثِیرًا وَالذَّاکِرَاتِ۔","Sahih","Musannaf Ibn Abi Shaybah 6675","","","كتاب الجمعة"
"6676","(۶۶۷۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ : أَیُّ اللَّیْلِ أَفْضَلُ ؟ فَقَالَ : جَوْفُ اللَّیْلِ الأَوْسَطُ۔","Hasan","Musannaf Ibn Abi Shaybah 6676","","","كتاب الجمعة"
"6677","(۶۶۷۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ ؛ أَنَّ رَجُلاً سَأَلَ أَبَا ذَرٍّ : أَیُّ اللَّیْلِ أَسْمَعُ ؟ قَالَ : جَوْفُ اللَّیْلِ الأَوْسَطُ ، قَالَ : وَمَنْ یُطِیقُ ذَلِکَ ؟ قَالَ : مَنْ خَافَ أَدْلَجَ۔","Hasan","Musannaf Ibn Abi Shaybah 6677","","","كتاب الجمعة"
"6678","(۶۶۷۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ مُعَاذًا قَالَ لأَبِی مُوسَی : کَیْفَ تَقْرَأُ الْقُرْآنَ ؟ قَالَ : أَتَفَوَّقُہُ تَفَوُّقًا ۔ فَقَالَ لَہُ أَبُو مُوسَی : فَکَیْفَ تَقْرَؤُہُ أَنْتَ ، یَا مُعَاذُ ؟ قَالَ : أَنَامُ أَوَّلَ اللَّیْلِ ، أَتَقَوَّی بِہِ عَلَی آخِرِہِ ، وَإِنِّی لأَرْجُو الأَجْرَ فِی رَقْدَتِی کَمَا أَرْجُوہُ فِی یَقَظَتِی۔ (بخاری ۴۳۴۱۔ مسلم ۱۵)","","Musannaf Ibn Abi Shaybah 6678","","","كتاب الجمعة"
"6679","(۶۶۷۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ مِسْعَرٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : کَانَ عَبْدُ اللہِ إِذَا ہَدَأَتِ الْعُیُونُ قَامَ ، فَسَمِعْتُ لَہُ دَوِیًّا کَدَوِیِّ النَّحْلِ ، حَتَّی یُصْبِحَ۔","","Musannaf Ibn Abi Shaybah 6679","","","كتاب الجمعة"
"6680","(۶۶۸۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ سَلَمَۃَ بْنِ یَحْیَی بْنِ طَلْحَۃَ ، عَنْ عَمَّتِہِ أُمِّ إِسْحَاقَ بِنْتِ طَلْحَۃَ ، قَالَتْ : کَانَ الْحَسَنُ بْنُ عَلِیٍّ یَأْخُذُ نَصِیبَہُ مِنْ قِیَامِ اللَّیْلِ مِنْ أَوَّلِ اللَّیْلِ ، وَکَانَ الْحُسَیْنُ یَأْخُذُ نَصِیبَہُ مِنْ آخِرِ اللَّیْلِ۔","Da'if","Musannaf Ibn Abi Shaybah 6680","","","كتاب الجمعة"
"6681","(۶۶۸۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ ابْنُ عُمَرَ کُلَّمَا اسْتَیْقَظَ مِنَ اللَّیْلِ صَلَّی۔","Sahih","Musannaf Ibn Abi Shaybah 6681","","","كتاب الجمعة"
"6682","(۶۶۸۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حَدَّثَنَا أَبُو حُرَّۃَ ، قَالَ : حَدَّثَنَا الْحَسَنُ ، عَنْ سَعْدِ بْنِ ہِشَامٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا قَامَ مِنَ اللَّیْلِ یُصَلِّی ، افْتَتَحَ صَلاَتَہُ بِرَکْعَتَیْنِ خَفِیفَتَیْنِ۔ (مسلم ۱۹۷۔ احمد ۶/۳۰)","Sahih","Musannaf Ibn Abi Shaybah 6682","","","كتاب الجمعة"
"6683","(۶۶۸۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : إِذَا قَامَ أَحَدُکُمْ مِنَ اللَّیْلِ، فَلْیَفْتَتِحْ بِرَکْعَتَیْنِ خَفِیفَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 6683","","","كتاب الجمعة"
"6684","(۶۶۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : مَا رَأَیْتُہُ افْتَتَحَ صَلاَۃَ تَطَوُّعٍ إِلاَّ بِرَکْعَتَیْنِ خَفِیفَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6684","","","كتاب الجمعة"
"6685","(۶۶۸۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَفْتَتِحُ صَلاَتَہُ مِنَ اللَّیْلِ بِرَکْعَتَیْنِ خَفِیفَتَیْنِ۔ (مسلم ۱۹۸۔ ابوداؤد ۱۳۱۷)","Hasan","Musannaf Ibn Abi Shaybah 6685","","","كتاب الجمعة"
"6686","(۶۶۸۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : صَلاَۃُ اللَّیْلِ مَثْنَی مَثْنَی۔ (بخاری ۱۱۳۷۔ مسلم ۱۴۶)","Sahih","Musannaf Ibn Abi Shaybah 6686","","","كتاب الجمعة"
"6687","(۶۶۸۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : صَلاَۃُ اللَّیْلِ مَثْنَی مَثْنَی۔ (بخاری ۹۹۰۔ ابوداؤد ۱۳۲۰)","Sahih","Musannaf Ibn Abi Shaybah 6687","","","كتاب الجمعة"
"6688","(۶۶۸۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : صَلاَۃُ اللَّیْلِ مَثْنَی مَثْنَی۔ (مسلم ۱۴۸۔ احمد ۲/۵۸)","Sahih","Musannaf Ibn Abi Shaybah 6688","","","كتاب الجمعة"
"6689","(۶۶۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ مَوْلَی آلِ طَلْحَۃَ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُسَلِّمُ فِی کُلِّ رَکْعَتَیْنِ مِنْ صَلاَۃِ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 6689","","","كتاب الجمعة"
"6690","(۶۶۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: فِی کُلِّ رَکْعَتَیْنِ فَصْلٌ۔","","Musannaf Ibn Abi Shaybah 6690","","","كتاب الجمعة"
"6691","(۶۶۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ الْوَلِیدِ الشَّنِّیِّ ، عَنْ عِکْرِمَۃَ ، قَالَ : بَیْنَ کُلِّ رَکْعَتَیْنِ تَسْلِیمَۃٌ۔","","Musannaf Ibn Abi Shaybah 6691","","","كتاب الجمعة"
"6692","(۶۶۹۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنْ سَالِمٍ ، أَنَّہُ قَالَ : صَلاَۃُ اللَّیْلِ مَثْنَی مَثْنَی۔","","Musannaf Ibn Abi Shaybah 6692","","","كتاب الجمعة"
"6693","(۶۶۹۳) حَدَّثَنَا مُحَمَّد بن أَبِی عَدِی ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : صَلاَۃُ اللَّیْلِ مَثْنَی مَثْنَی۔","","Musannaf Ibn Abi Shaybah 6693","","","كتاب الجمعة"
"6694","(۶۶۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : صَلاَۃُ اللَّیْلِ مَثْنَی مَثْنَی۔","","Musannaf Ibn Abi Shaybah 6694","","","كتاب الجمعة"
"6695","(۶۶۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ رَجَائٍ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ ، قَالَ : مَرَّ عَلَیَّ أَبُو ہُرَیْرَۃَ وَأَنَا أُصَلِّی ، فَقَالَ : اِفْصِلْ ، فَلَمْ أَدْرِ مَا قَالَ ، فَلَمَّا انْصَرَفْتُ قُلْتُ : مَا أَفْصِلُ ؟ قَالَ : اِفْصِلْ بَیْنَ صَلاَۃِ اللَّیْلِ وَصَلاَۃِ النَّہَارِ۔","Sahih","Musannaf Ibn Abi Shaybah 6695","","","كتاب الجمعة"
"6696","(۶۶۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَن صَلاَۃِ اللَّیْلِ ؟ فَقَالَ : یَکْفِیَک التَّشَہُّدُ فِی کُلِّ رَکْعَتَیْنِ ، إِلاَّ أَنْ تَکُونَ لَکَ حَاجَۃٌ۔","","Musannaf Ibn Abi Shaybah 6696","","","كتاب الجمعة"
"6697","(۶۶۹۷) حَدَّثَنَا وَکِیعٌ ، وَغُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ عَلِیٍّ الأَزْدِیِّ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : صَلاَۃُ اللَّیْلِ وَالنَّہَارِ رَکْعَتَانِ رَکْعَتَانِ ۔ إِلاَّ أَنَّ غُنْدَرًا قَالَ : مَثْنَی مَثْنَی۔ (نسائی ۴۷۲۔ احمد ۲۶)","Hasan","Musannaf Ibn Abi Shaybah 6697","","","كتاب الجمعة"
"6698","(۶۶۹۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُصَلِّی بِالنَّہَارِ أَرْبَعًا أَرْبَعًا۔","Sahih","Musannaf Ibn Abi Shaybah 6698","","","كتاب الجمعة"
"6699","(۶۶۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی ، أَنَّہُ قَالَ : أَرْبَعٌ أَرْبَعٌ۔","","Musannaf Ibn Abi Shaybah 6699","","","كتاب الجمعة"
"6700","(۶۷۰۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حَجَّاجٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : صَلاَۃُ النَّہَارِ أَرْبَعٌ أَرْبَعٌ ۔ ہَذَا فِی التَّطَوُّعِ۔","","Musannaf Ibn Abi Shaybah 6700","","","كتاب الجمعة"
"6701","(۶۷۰۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ نَافِعًا عَنِ التَّطَوُّعِ بِالنَّہَارِ ؟ فَقَالَ : أَمَّا أَنَا فَأُصَلِّی أَرْبَعًا ۔ فَذَکَرْتُہُ لِمُحَمَّدٍ ، فَقَالَ: أَلَیْسَ یُصَلِّی رَکْعَتَیْنِ ؟ اِحْفَظْ۔","","Musannaf Ibn Abi Shaybah 6701","","","كتاب الجمعة"
"6702","(۶۷۰۲) حَدَّثَنَا إِبْرَاہِیمُ بْنُ صَدَقَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : صَلاَۃُ اللَّیْلِ وَالنَّہَارِ مَثْنَی مَثْنَی۔","","Musannaf Ibn Abi Shaybah 6702","","","كتاب الجمعة"
"6703","(۶۷۰۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَنْظَلَۃَ بْنِ عَبْدِ الْکَرِیمِ ، قَالَ : سَأَلْتُ حَمَّادًا عَنْ صَلاَۃِ النَّہَارِ ؟ فَقَالَ : رَکْعَتَانِ رَکْعَتَانِ۔","","Musannaf Ibn Abi Shaybah 6703","","","كتاب الجمعة"
"6704","(۶۷۰۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، قَالَ : کَانَ سَعِیدُ بْنُ جُبَیْرٍ یُصَلِّی بِاللَّیْلِ وَالنَّہَارِ مَثْنَی مَثْنَی۔","","Musannaf Ibn Abi Shaybah 6704","","","كتاب الجمعة"
"6705","(۶۷۰۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَعْلَی بْنُ عَطَائٍ ، قَالَ : حَدَّثَنِی جَابِرُ بْنُ یَزِیدَ بْنِ الأَسْوَدِ الْعَامِرِیُّ ، عَنْ أَبِیہِ، قَالَ: شَہِدْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَجَّتَہُ ، قَالَ : فَصَلَّیْتُ مَعَہُ الْغَدَاۃَ فِی مَسْجِدِ الْخَیْفِ،n فَلَمَّا قَضَی صَلاَتَہُ وَانْحَرَفَ ، إِذَا ہُوَ بِرَجُلَیْنِ فِی آخِرِ الْقَوْمِ لَمْ یُصَلِّیَا مَعَہُ ، قَالَ : فَقَالَ : عَلَیَّ بِہِمَا ، فَأُتِیَ بِہِمَا تَرْعَدُ فَرَائِصُہُمَا ، فَقَالَ : مَا مَنَعَکُمَا أَنْ تُصَلِّیَا مَعَنَا ؟ فَقَالاَ : یَا رَسُولَ اللہِ ، کُنَّا قَدْ صَلَّیْنَا فِی رِحَالِنَا ، قَالَ : فَلاَ تَفْعَلاَ ، إِذَا صَلَّیْتُمَا فِی رِحَالِکُمَا ثُمَّ أَتَیْتُمَا مَسْجِدَ جَمَاعَۃٍ فَصَلِّیَا مَعَہُمْ ، فَإِنَّہُمَا لَکُمَا نَافِلَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 6705","","","كتاب الجمعة"
"6706","(۶۷۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعَۃَ بْنِ عُثْمَانَ ، وَأَبِی الْعُمَیْسِ ، عَنْ عُثْمَانَ بْنِ عَبُیدِ اللہِ بْنِ أَبِی رَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : صَلاَتُہُ الأُولَی۔","Hasan","Musannaf Ibn Abi Shaybah 6706","","","كتاب الجمعة"
"6707","(۶۷۰۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : صَلاَتُہُ الأُولَی ، ہِیَ الْفَرِیضَۃُ ، وَہَذِہِ نَافِلَۃٌ۔","","Musannaf Ibn Abi Shaybah 6707","","","كتاب الجمعة"
"6708","(۶۷۰۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ بْنُ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُہُ قَالَ ذَلِکَ أَیْضًا۔","","Musannaf Ibn Abi Shaybah 6708","","","كتاب الجمعة"
"6709","(۶۷۰۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَکَمِ بْنِ الأَعْرَجِ ، قَالَ : أَتَیْتُ عَلَی ابْنِ عُمَرَ ، وَالنَّاسُ فِی صَلاَۃِ الظُّہْرِ ، فَظَنَنْتُہُ عَلَی غَیْرِ طُہْرٍ ، فَقُلْتُ لَہُ : یَا أَبَا عَبْدِ الرَّحْمَنِ ، آتِیکَ بِطُہْرٍ ؟ قَالَ : إِنِّی عَلَی طَہَارَۃٍ وَقَدْ صَلَّیْت ، فَبِأَیِّہِمَا أَحْتَسِبُ ؟۔ قَالَ یُونُسُ : فَذَکَرْتُ ذَلِکَ لِلْحَسَنِ ، فَقَالَ : یَرْحَمُ اللَّہُ أَبَا عَبْدِ الرَّحْمَنِ ، فَجَعَلَ الأُولَی الْمَکْتُوبَۃَ وَہَذِہِ نَافِلَۃٌ۔","","Musannaf Ibn Abi Shaybah 6709","","","كتاب الجمعة"
"6710","(۶۷۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا صَلَّی الرَّجُلُ وَحْدَہُ، ثُمَّ صَلَّی فِی جَمَاعَۃٍ ، فَالْفَرِیضَۃُ ہِیَ الأُولَی۔","","Musannaf Ibn Abi Shaybah 6710","","","كتاب الجمعة"
"6711","(۶۷۱۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لَوْ صَلَّیْتُ فِی مَنْزِلِی ، ثُمَّ أَتَیْتُ مَسْجِدَ جَمَاعَۃٍ ، ثُمَّ أَدْرَکْتُ مَعَہُ رَکْعَۃً وَاحِدَۃً ، کَانَتْ أَحَبَّ إِلَیَّ مِنْ صَلاَتِی الَّتِی صَلَّیْتُ وَحْدِی۔","","Musannaf Ibn Abi Shaybah 6711","","","كتاب الجمعة"
"6712","(۶۷۱۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا دَاوُد ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : صَلاَتُہُ الَّتِی صَلَّی فِی الْجَمَاعَۃِ۔","","Musannaf Ibn Abi Shaybah 6712","","","كتاب الجمعة"
"6713","(۶۷۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبَاحِ بْنِ أَبِی مَعْرُوفٍ ، عَنْ عَطَائٍ ، قَالَ : إِذَا صَلَّی فِی جَمَاعَۃٍ وَقَدْ کَانَ صَلَّی وَحْدَہُ، فَصَلاَتُہُ الآخِرَۃُ۔","","Musannaf Ibn Abi Shaybah 6713","","","كتاب الجمعة"
"6714","(۶۷۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ رَجُلٍ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : الْفَرِیضَۃُ ہِیَ الْجَمَاعَۃُ فِی الْمَسْأَلَۃِ الأُولَی۔","","Musannaf Ibn Abi Shaybah 6714","","","كتاب الجمعة"
"6715","(۶۷۱۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ ، قَالَ: صَلاَتُہُ الأُولَی۔","Da'if","Musannaf Ibn Abi Shaybah 6715","","","كتاب الجمعة"
"6716","(۶۷۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ سَعدِ بْنِ عُبَیْدَۃَ ، عَنْ صِلَۃ بْنِ زُفَرَ ، قَالَ : أَعَدْتُ الصَّلَوَاتِ کُلَّہَا مَعَ حُذَیْفَۃَ ، وَشَفَعَ فِی الْمَغْرِبَ بِرَکْعَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6716","","","كتاب الجمعة"
"6717","(۶۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی السَّوْدَائِ النَّہْدِیِّ ، قَالَ : صَلَّیْتُ الْمَغْرِبَ ثُمَّ صَلَّیْتُہَا فِی جَمَاعَۃٍ ، فَلَمَّا سَلَّمَ الإِمَامُ قُمْتُ فَشَفَعْتُ بِرَکْعَۃٍ ، فَسَأَلْتُ عَطَائً ؟ فَقَالَ : أَکِیستَ۔","","Musannaf Ibn Abi Shaybah 6717","","","كتاب الجمعة"
"6718","(۶۷۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا صَلَّی الْمَغْرِبَ وَحْدَہُ ، ثُمَّ صَلَّی فِی جَمَاعَۃٍ شَفَعَ بِرَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 6718","","","كتاب الجمعة"
"6719","(۶۷۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَمْرو بْنُ حَسَّانَ الْمُسْلِیُّ ، عَنْ وَبَرَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : صَلَّیْتُ أَنَا ، وَإِبْرَاہِیمُ النَّخَعِیُّ ، وَعَبْدُ الرَّحْمَن بْنُ الأَسْوَدِ الْمَغْرِبَ ، ثُمَّ جِئْنَا إِلَی الْمَسْجِدِ وَہُمْ فِی صَلاَۃِ الْمَغْرِبِ ، فَدَخَلْنَا مَعَہُمْ فَصَلَّیْنَا ، فَلَمَّا سَلَّمَ الإِمَامُ اِرتبکت أَنَا وَعَبْدُ الرَّحْمَن بْنُ الأَسْوَدِ ، وَقَامَ إِبْرَاہِیمُ فَشَفَعَ بِرَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 6719","","","كتاب الجمعة"
"6720","(۶۷۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ نُعَیْمٍ ، عَنْ صِلَۃ ، عَنْ حُذَیْفَۃَ ؛ أَنَّہُ صَلَّی الظُّہْرَ مَرَّتَیْنِ ، وَالْعَصْرَ مَرَّتَیْنِ ، وَالْمَغْرِبَ مَرَّتَیْنِ ، وَشَفَعَ فِی الْمَغْرِبِ بِرَکْعَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6720","","","كتاب الجمعة"
"6721","(۶۷۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ صَلَّی الْمَغْرِبَ وَحْدَہُ ، ثُمَّ أَعَادَہَا فِی جَمَاعَۃٍ ؟ قَالَ : یُضِیفُ إِلَیْہَا رَکْعَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 6721","","","كتاب الجمعة"
"6722","(۶۷۲۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : یَشْفَعُ بِرَکْعَۃٍ ، یَعْنِی إِذَا أَعَادَ الْمَغْرِبَ۔","Da'if","Musannaf Ibn Abi Shaybah 6722","","","كتاب الجمعة"
"6723","(۶۷۲۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا خَصِیْبُ بْنُ زَیدٍ التَّمِیمِیُّ ، قَالَ : حَدَّثَنَا الْحَسَنُ ؛ أَنَّ رَجُلاً دَخَلَ الْمَسْجِدَ وَقَدْ صَلَّی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَلاَ رَجُلٌ یَقُومُ إِلَی ہَذَا فَیُصَلِّی مَعَہُ ؟ فَقَامَ أَبُو بَکْرٍ فَصَلَّی مَعَہُ ، وَقَدْ کَانَ صَلَّی تِلْکَ الصَّلاَۃ۔","Hasan","Musannaf Ibn Abi Shaybah 6723","","","كتاب الجمعة"
"6724","(۶۷۲۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ النُّعْمَانُ بْنُ مُقَرِّنٍ عَلَی جُنْدِ أَہْلِ الْکُوفَۃِ ، وَأَبُو مُوسَی الأَشْعَرِیُّ عَلَی جُنْدِ أَہْلِ الْبَصْرَۃِ ، وَکُنْتُ بَیْنَہُمَا ، فَاتَّعَدَا أَنْ یَلْتَقِیَا عِنْدِی غَدْوَۃً ، فَصَلَّی أَحَدُہُمَا صَلاَۃَ الْغَدَاۃِ بِأَصْحَابِہِ ، ثُمَّ جَائَ وَأَنَا أُصَلِّی فَصَلَّی مَعِی۔","Sahih","Musannaf Ibn Abi Shaybah 6724","","","كتاب الجمعة"
"6725","(۶۷۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ، عَنْ نَافِعٍ؛ أَنَّ ابْنَ عُمَرَ اشْتَغَلَ بِبِنَائٍ لَہُ فَصَلَّی الظُّہْرَ، ثُمَّ مَرَّ بِمَسْجِدِ بَنِی عَوْفٍ وَہُمْ یُصَلُّونَ فَصَلَّی مَعَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 6725","","","كتاب الجمعة"
"6726","(۶۷۲۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إِذَا صَلَّی الرَّجُلُ فِی بَیْتِہِ ، ثُمَّ أَدْرَکَ جَمَاعَۃً صَلَّی مَعَہُمْ ، إِلاَّ الْمَغْرِبَ وَالْفَجْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 6726","","","كتاب الجمعة"
"6727","(۶۷۲۷) حَدَّثَنَا حَفْصٌ، عَنْ عَاصِمٍ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ الْمُزَنِیِّ ، قَالَ: سُئِلَ ابْنُ عَبَّاسٍ عَنْ ثَلاَثَۃٍ صَلُّوا الْعَصْرَ، ثُمَّ مَرُّوا بِمَسْجِدٍ ، فَدَخَلَ أَحَدُہُمْ فَصَلَّی ، وَمَضَی وَاحِدٌ ، وَجَلَسَ وَاحِدٌ عَلَی الْبَابِ ؟ فَقَالَ ابْنُ عَبَّاسٍ: أَمَّا الَّذِی صَلَّی فَزَادَ خَیْرًا إِلَی خَیْرٍ، وَأَمَّا الَّذِی مَضَی فَمَضَی لِحَاجَتِہِ، وَأَمَّا الَّذِی جَلَسَ عَلَی الْبَابِ فَأَخَسُّہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 6727","","","كتاب الجمعة"
"6728","(۶۷۲۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، قَالَ : خَرَجْتُ مَعَ ابْنِ سِیرِینَ ، وَقَدْ صَلَّی الْجُمُعَۃَ وَالْعَصْرَ ، فَمَرَّ بِمَسْجِدٍ یُصَلَّی فِیہِ الْعَصْرُ ، فَدَخَلَ فَصَلَّی فِیہِ مَعَہُمْ۔","","Musannaf Ibn Abi Shaybah 6728","","","كتاب الجمعة"
"6729","(۶۷۲۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ : یُعِیدُ الصَّلاَۃَ کُلَّہَا إِلاَّ الْمَغْرِبَ ، فَإِنْ خَافَ سُلْطَانًا فَلْیُصَلِّ مَعَہُ ، فَإِذَا فَرَغَ فَلْیَشْفَعْ بِرَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 6729","","","كتاب الجمعة"
"6730","(۶۷۳۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : صَلَّیْتُ الْعَصْرَ فِی أَہْلِی ، ثُمَّ خَرَجْتُ مَعَ ابْنِ الأَسْوَدِ ، فَمَرَرْتُ بِمَسْجِدٍ یُصَلَّی فِیہِ ، فَقَالَ : اُدْخُلْ بِنَا نُصَلِّ ۔ فَقَالَ : إِنِّی قَدْ صَلَّیْتُ ، قَالَ : وَإِنْ کُنْتَ۔","","Musannaf Ibn Abi Shaybah 6730","","","كتاب الجمعة"
"6731","(۶۷۳۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ؛ فِی الرَّجُلِ یُصَلِّی الظُّہْرَ ، أَوِ الْعَصْرَ ثُمَّ یُدْرِکْہُمَا فِی جَمَاعَۃٍ ، قَالَ : مَا أُحِبُّ أَنْ یَتَعَرَّضَ لَہَا ، وَإِنْ أُقِیمَتْ وَہُوَ فِی الْمَسْجِدِ فَلْیُصَلِّ۔","","Musannaf Ibn Abi Shaybah 6731","","","كتاب الجمعة"
"6732","(۶۷۳۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : صَلَّیْتُ فِی مَنْزِلِی الظُّہْرَ ، ثُمَّ أَتَیْتُ الْمَسْجِدَ وَہُمْ یُصَلُّونَ ، فَسَأَلْتُ سَالِمًا ؟ فَقَالَ : صَلِّ مَعَہُمْ۔","","Musannaf Ibn Abi Shaybah 6732","","","كتاب الجمعة"
"6733","(۶۷۳۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : تُعَادُ الصَّلاَۃُ کُلُّہَا إِلاَّ الْمَغْرِبَ ، فَإِنَّہَا وِتْرٌ ، فَلاَ تَجْعَلُوہَا شَفْعًا۔","","Musannaf Ibn Abi Shaybah 6733","","","كتاب الجمعة"
"6734","(۶۷۳۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ لَمْ یَکْرَہْ أَنْ تُعَادَ الْعَصْرُ۔","","Musannaf Ibn Abi Shaybah 6734","","","كتاب الجمعة"
"6735","(۶۷۳۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنِ الرَّجُلِ یُصَلِّی الْمَکْتُوبَۃَ ، ثُمَّ یَأْتِی الْمَسْجِدَ وَالْقَوْمُ یُصَلُّونَ تِلْکَ الصَّلاَۃ ؟ قَالَ : یُصَلِّی مَعَہُمْ مَا خَلاَ ہَاتَیْنِ الصَّلاَتَیْنِ ؛ الْفَجْرِ وَالْعَصْرِ۔","","Musannaf Ibn Abi Shaybah 6735","","","كتاب الجمعة"
"6736","(۶۷۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُعِیدُ الصَّلاَۃَ کُلَّہَا۔","","Musannaf Ibn Abi Shaybah 6736","","","كتاب الجمعة"
"6737","(۶۷۳۷) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِإِعَادَۃِ الصَّلاَۃَ کُلِّہَا إِذَا لَمْ یُصَلِّہِنَّ فِی جَمَاعَۃٍ ، إِلاَّ صَلاَۃَ الْفَجْرِ ، فَإِنَّہُ کَانَ یَکْرَہُ إِعَادَۃَ صَلاَۃِ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6737","","","كتاب الجمعة"
"6738","(۶۷۳۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُسَیْنٍ الْمُکْتِبِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، قَالَ : أَتَیْتُ عَلَی ابْنِ عُمَرَ وَہُوَ جَالِسٌ عَلَی الْبَلاَطِ ۔ قَالَ : وَنَاسٌ یُصَلُّونَ ، فَقُلْنَا : یَا أَبَا عَبْدَ الرَّحْمَن ، أَلاَ تُصَلِّی؟ فَقَالَ : إِنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَقُولُ : لاَ تُصَلَّی صَلاَۃٌ فِی یَوْمٍ مَرَّتَیْنِ۔ (ابوداؤد ۵۸۰۔ احمد ۱۹)","Sahih","Musannaf Ibn Abi Shaybah 6738","","","كتاب الجمعة"
"6739","(۶۷۳۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَنْ مُجَاہِدٍ ، قَالَ : خَرَجْتُ مَعَ ابْنِ عُمَرَ مِنْ دَارِ عَبْدِ اللہِ بْنِ خَالِدٍ ، حَتَّی إِذَا نَظَرْنَا إِلَی بَابِ الْمَسْجِدِ، إِذْ النَّاسُ فِی صَلاَۃِ الْعَصْرِ ، فَلَمْ یَزَلْ وَاقِفًا حَتَّی صَلَّی النَّاسُ، وَقَالَ: إِنِّی صَلَّیْتُ فِی الْبَیْتِ۔","Hasan","Musannaf Ibn Abi Shaybah 6739","","","كتاب الجمعة"
"6740","(۶۷۴۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، وَمِسْعَرٌ، عَنْ زِیَادِ بْنِ فَیَّاضٍ، عَنْ أَبِی عِیَاضٍ: قَالَ: قَالَ عُمَرُ: لاَ تُعَادُ الصَّلاَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 6740","","","كتاب الجمعة"
"6741","(۶۷۴۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ شَقِیقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : جَدَبَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ السَّمَرَ بَعْدَ صَلاَۃِ الْعَتَمَۃِ۔ (احمد ۱/۴۱۰۔ ابن حبان ۲۰۳۱)","Da'if","Musannaf Ibn Abi Shaybah 6741","","","كتاب الجمعة"
"6742","(۶۷۴۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ سَلْمَانَ ، یَعْنِی ابْنَ رَبِیعَۃَ ، قَالَ : قَالَ لِی عُمَرُ : یَا سَلْمَانُ ، إِنِّی أَذُمُّ لَکَ الْحَدِیثَ بَعْدَ صَلاَۃِ الْعَتَمَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 6742","","","كتاب الجمعة"
"6743","(۶۷۴۳) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ سَلْمَانَ بْنِ رَبِیعَۃَ ، قَالَ : کَانَ عُمَرُ بْنُ الْخَطَّابِ یَجْدُبُ لَنَا السَّمَرَ بَعْدَ صَلاَۃِ النَّوْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 6743","","","كتاب الجمعة"
"6744","(۶۷۴۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ سُلَیْمَانَ بْنِ مُسْہِرٍ ، عَنْ خَرَشَۃَ بْنِ الْحُرِّ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ یَضْرِبُ النَّاسَ عَلَی الْحَدِیثِ بَعْدَ الْعِشَائِ ، وَیَقُولُ : أَسَمَرٌ أَوَّلَ اللَّیْلِ وَنَوْمٌ آخِرَہُ ؟۔","Sahih","Musannaf Ibn Abi Shaybah 6744","","","كتاب الجمعة"
"6745","(۶۷۴۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ یَحْیَی بْنِ مَیْسَرَۃَ ، قَالَ : حدَّثَنَا الْعَلاَئُ بْنُ بَدْرٍ ، عَمَّنْ سَمِعَ سَلْمَانَ ، یَقُولُ : إِیَّاکُمْ وَسَمَرَ أَوَّلَ اللَّیْلِ ، فَإِنَّہُ مَہْدَنَۃٌ ، أَوْ مُذْہِبَۃٌ لآخِرِہِ ، فَمَنْ فَعَلَ ذَلِکَ فَلْیُصَلِّ رَکْعَتَیْنِ ، قَبْلَ أَنْ یَأْوِیَ إِلَی فِرَاشِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 6745","","","كتاب الجمعة"
"6746","(۶۷۴۶) حَدَّثَنَا عَبْدَۃُ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ؛ کَانُوا یَسْتَحِبُّونَ إِذَا أَوْتَرَ الرَّجُلُ أَنْ یَنَامَ۔","","Musannaf Ibn Abi Shaybah 6746","","","كتاب الجمعة"
"6747","(۶۷۴۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ ، قَالَ : کُنْتُ أَکُونُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ فَأُصَلِّیَ بَعْدَ الْعِشَائِ أَرْبَعَ رَکَعَاتٍ ، فَأُکَلِّمُہُ فَلاَ یُکَلِّمُنِی حَتَّی یَنَامَ۔","","Musannaf Ibn Abi Shaybah 6747","","","كتاب الجمعة"
"6748","(۶۷۴۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ الْکَلاَمَ بَعْدَ الْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 6748","","","كتاب الجمعة"
"6749","(۶۷۴۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی وَائِلٍ ، وَإِبْرَاہِیمَ ، قَالاَ : جَائَ رَجُلٌ إِلَی حُذَیْفَۃَ ، فَدَقَّ الْبَابَ فَخَرَجَ إِلَیْہِ حُذَیْفَۃُ ، فَقَالَ : مَا جَائَ بِکَ ؟ فَقَالَ : جِئْت لِلْحَدِیثِ ، فَسَفَقَ حُذَیْفَۃُ الْبَابَ دُونَہُ ، ثُمَّ قَالَ : إِنَّ عُمَرَ جَدَبَ لَنَا السَّمَرَ بَعْدَ صَلاَۃِ الْعِشَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 6749","","","كتاب الجمعة"
"6750","(۶۷۵۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ ، عَنِ أَبی الْمِنْہَالِ ، عَنْ أَبِی بَرْزَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ النَّوْمِ قَبْلَہَا ، وَعَنِ الْحَدِیثِ بَعْدَہَا۔ (بخاری ۷۷۱۔ ابوداؤد ۴۱۰)","Sahih","Musannaf Ibn Abi Shaybah 6750","","","كتاب الجمعة"
"6751","(۶۷۵۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ رَجُلٍ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ النَّوْمِ قَبْلَہَا ، وَعَنِ الْحَدِیثِ بَعْدَہَا۔ (احمد ۲۵۔ ابویعلی ۴۰۳۹۔ عبدالرزاق۲۱۳۷)","Da'if","Musannaf Ibn Abi Shaybah 6751","","","كتاب الجمعة"
"6752","(۶۷۵۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عُمَرَ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْمُرُ عِنْدَ أَبِی بَکْرٍ اللَّیْلَۃَ کَذَاکَ فِی الأَمْرِ مِنْ أَمْرِ الْمُسْلِمِینَ وَأَنَا مَعَہُ ، وَإِنَّہُ سَمَرَ عِنْدَہُ ذَاتَ لَیْلَۃٍ وَأَنَا مَعَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 6752","","","كتاب الجمعة"
"6753","(۶۷۵۳) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْمِنْہَالِ ، وَالْحَکَمِ ، وَعِیسَی ، وَعَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ؛ أَنَّ أَبَا لَیْلَی سَمَرَ عِنْدَ عَلِیٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 6753","","","كتاب الجمعة"
"6754","(۶۷۵۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ زِیَادٍ أَبِی یَحْیَی ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ وَالْمِسْوَرُ بْنُ مَخْرَمَۃَ سَمَرَا۔","Sahih","Musannaf Ibn Abi Shaybah 6754","","","كتاب الجمعة"
"6755","(۶۷۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُعَاوِیَۃَ بْنِ إِسْحَاقَ الطَّلْحِیِّ ، عَنْ عَائِشَۃَ ابْنَۃِ طَلْحَۃَ ؛ أَنَّ الْحَسَنَ بْنَ عَلِیٍّ سَمَرَ ہُوَ وَرَجُلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 6755","","","كتاب الجمعة"
"6756","(۶۷۵۶) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ لَیْثٍ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی مُوسَی ؛ أَنَّ أَبَا مُوسَی أَتَی عُمَرَ بْنَ الْخَطَّابِ بَعْدَ الْعِشَائِ ، قَالَ : فَقَالَ لَہُ عُمَرُ بْنُ الْخَطَّابِ : مَا جَائَ بِکَ ؟ قَالَ : جِئْت أَتَحَدَّثُ إِلَیْک ،n قَالَ : ہَذِہِ السَّاعَۃَ ؟ قَالَ : إِنَّہُ فِقْہٌ ، فَجَلَسَ عُمَرُ ، فَتَحَدَّثَا لَیْلاً طَوِیلاً ، حَسِبْتُہُ قَالَ : ثُمَّ إِنَّ أَبَا مُوسَی ، قَالَ : الصَّلاَۃ یَا أَمِیرَ الْمُؤْمِنِینَ ؟ قَالَ : إِنَّا فِی صَلاَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6756","","","كتاب الجمعة"
"6757","(۶۷۵۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ حُذَیْفَۃَ ، وَابْنَ مَسْعُودٍ سَمَرَا عِنْدَالْوَلِیدِ بْنِ عُقْبَۃَ۔","","Musannaf Ibn Abi Shaybah 6757","","","كتاب الجمعة"
"6758","(۶۷۵۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَسْمُرُ بَعْدَ الْعِشَائِ حَتَّی تَقُولَ عَائِشَۃُ : قدْ أَصْبَحْتُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 6758","","","كتاب الجمعة"
"6759","(۶۷۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : سَمَرَ ابْنُ عَبَّاسٍ عِنْدَ مُعَاوِیَۃَ حَتَّی ذَہَبَ ہَزِیعٌ مِنَ اللَّیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 6759","","","كتاب الجمعة"
"6760","(۶۷۶۰) حَدَّثَنَا وَکِیعٌ ، عَنِ السَّائِبِ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ؛ أَنَّ قَوْمًا مِنْ قُرَیْشٍ کَانُوا یَسْمُرُونَ ، فَتُرْسِلُ إِلَیْہِمْ عَائِشَۃُ : انْقَلِبُوا إِلَی أَہْلِیکُمْ ، فَإِنَّ لَہُمْ فِیکُمْ نَصِیبًا۔","Sahih","Musannaf Ibn Abi Shaybah 6760","","","كتاب الجمعة"
"6761","(۶۷۶۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَتَحَدَّثُ بَعْدَ الْعِشَائِ۔","","Musannaf Ibn Abi Shaybah 6761","","","كتاب الجمعة"
"6762","(۶۷۶۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِالسَّمَرِ فِی الْفِقْہِ۔","","Musannaf Ibn Abi Shaybah 6762","","","كتاب الجمعة"
"6763","(۶۷۶۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ لَہُ سُمَّارٌ۔","","Musannaf Ibn Abi Shaybah 6763","","","كتاب الجمعة"
"6764","(۶۷۶۴) حَدَّثَنَا أَبُوخَالِدٍ الأَحْمَرِِ، عَنْ یَحْیَی بْنِ سَعِیدٍ، قَالَ: کَانَ الْقَاسِمُ وَأَصْحَابُہُ یَجْلِسُونَ بَعْدَ الْعِشَائِ یَتَحَدَّثُونَ۔","","Musannaf Ibn Abi Shaybah 6764","","","كتاب الجمعة"
"6765","(۶۷۶۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اجْعَلُوا آخِرَ صَلاَتِکُمْ بِاللَّیْلِ وِتْرًا۔ (بخاری ۹۹۸۔ مسلم ۵۱۷)","Sahih","Musannaf Ibn Abi Shaybah 6765","","","كتاب الجمعة"
"6766","(۶۷۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الْحَمِیدِ بْنُ بَہْرَامَ ، عْن شَہْرِ بْنِ حَوْشَبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : النَّوْمُ عَلَی وِتْرٍ خَیْرٌ۔","","Musannaf Ibn Abi Shaybah 6766","","","كتاب الجمعة"
"6767","(۶۷۶۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ الْعَوَّامِ ، عَنْ سُلَیْمَانَ بْنِ أَبِی سُلَیْمَانَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أَوْصَانِی خَلِیلِی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنْ لاَ أَنَامَ إِلاَّ عَلَی وِتْرٍ۔ (مسلم ۸۶۔ ابوداؤد ۱۴۲۸)","Da'if","Musannaf Ibn Abi Shaybah 6767","","","كتاب الجمعة"
"6768","(۶۷۶۸) حَدَّثَنَا ابْنُ مُسْہِرٍ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: أَوْصَانِی خَلِیلِی أَنْ لاَ أَنَامَ إِلاَّ عَلَی وِتْرٍ۔ (احمد ۴۹۷)","Da'if","Musannaf Ibn Abi Shaybah 6768","","","كتاب الجمعة"
"6769","(۶۷۶۹) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: أَمَّا أَنَا فَإِنِّی أُوتِرُ قَبْلَ أَنْ أَنَامَ۔","","Musannaf Ibn Abi Shaybah 6769","","","كتاب الجمعة"
"6770","(۶۷۷۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَ أَبُو بَکْرٍ یُوتِرُ أَوَّلَ اللَّیْلِ ، وَکَانَ عُمَرُ یُوتِرُ آخِرَ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 6770","","","كتاب الجمعة"
"6771","(۶۷۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، وَحَفْصٌ، عَنِ الأَعْمَشِ، عَنْ أَبِی سُفْیَانَ، عَنْ جَابِرٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ خَافَ أَنْ لاَ یَقُومَ آخِرَ اللَّیْلِ فَلْیُوتِرْ أَوَّلہ، وَمَنْ طَمِعَ أَنْ یَقُومَ آخِرَ اللَّیْلِ فَلْیُوتِرْ آخِرَ اللَّیْلِ ، فَإِنَّ صَلاَۃَ آخِرِ اللَّیْلِ مَشْہُودَۃٌ ۔ وَقَالَ أَبُو مُعَاوِیَۃَ : مَحْضُورَۃٌ ، وَذَلِکَ أَفْضَلُ۔(مسلم ۱۶۲۔ احمد ۳/۳۰۰)","Hasan","Musannaf Ibn Abi Shaybah 6771","","","كتاب الجمعة"
"6772","(۶۷۷۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَبِی بَکْرٍ : مَتَی تُوتِرُ ؟ قَالَ : مِنْ أَوَّلِ اللَّیْلِ بَعْدَ الْعَتَمَۃِ ، قَبْلَ أَنْ أَنَامَ، وَقَالَ لِعُمَرَ: مَتَی تُوتِرُ ؟ قَالَ : مِنْ آخِرِ اللَّیْلِ ، قَالَ لأَبِی بَکْرٍ : أَخَذْتَ بِالْحَزْمِ ، وَقَالَ لِعُمَرَ: أَخَذْتَ بِالْقُوَّۃِ۔ (احمد ۳/۳۳۰۔ ابو یعلی ۱۸۱۵)","Da'if","Musannaf Ibn Abi Shaybah 6772","","","كتاب الجمعة"
"6773","(۶۷۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : صَلاَۃُ الْمَغْرِبِ وِتْرُ النَّہَارِ۔ (نسائی ۱۳۸۲۔ احمد ۲/۸۳)","Sahih","Musannaf Ibn Abi Shaybah 6773","","","كتاب الجمعة"
"6774","(۶۷۷۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَائِشَۃَ ، قَالَتْ : أَوَّلُ مَا فُرِضَتِ الصَّلاَۃ رَکْعَتَیْنِ ، إِلاَّ الْمَغْرِبَ فَإِنَّہَا وِتْرُ النَّہَارِ۔ (احمد ۶/۲۴۱)","","Musannaf Ibn Abi Shaybah 6774","","","كتاب الجمعة"
"6775","(۶۷۷۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَبِیبٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : صَلاَۃُ اللَّیْلِ عَلَیْہَا وِتْرٌ ، وَصَلاَۃُ النَّہَارِ عَلَیْہَا وِتْرٌ ۔ یَعْنِی الْمَغْرِبَ آخِرَ الصَّلَوَاتِ۔","Hasan","Musannaf Ibn Abi Shaybah 6775","","","كتاب الجمعة"
"6776","(۶۷۷۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ أَعْلَمُہُمْ یَخْتَلِفُونَ أَنَّ الْمَغْرِبَ وِتْرُ صَلاَۃِ النَّہَارِ۔","","Musannaf Ibn Abi Shaybah 6776","","","كتاب الجمعة"
"6777","(۶۷۷۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : الْمَغْرِبُ وِتْرُ النَّہَارِ۔","","Musannaf Ibn Abi Shaybah 6777","","","كتاب الجمعة"
"6778","(۶۷۷۸) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ خَالِدٍ النِّیلِیِّ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃُ الْمَغْرِبِ وِتْرُ صَلاَۃِ النَّہَارِ ، فَأَوْتِرُوا صَلاَۃَ اللَّیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 6778","","","كتاب الجمعة"
"6779","(۶۷۷۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : قَالَ عَبْدُ اللہِ : الْوِتْرُ ثَلاَثٌ ، کَصَلاَۃِ الْمَغْرِبِ وِتْرُ النَّہَارِ۔","Sahih","Musannaf Ibn Abi Shaybah 6779","","","كتاب الجمعة"
"6780","(۶۷۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ، عَنْ أَبِی مِجْلَزٍ؛ أَنَّہُ کَانَ لاَ یُصَلِّی بَعْدَ الْوِتْرِ، إِلاَّ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6780","","","كتاب الجمعة"
"6781","(۶۷۸۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ سُئِلَ عَنِ الرَّکْعَتَیْنِ بَعْدَ الْوِتْرِ ؟ فَحَلَفَ بِاللَّہِ إِنَّہُمَا لَبِدْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 6781","","","كتاب الجمعة"
"6782","(۶۷۸۲) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : سَأَلَ رَجُلٌ مِنْ أَہْلِ الْیَمَنِ عَنْہُمَا عَطَائً ؟ فَقَالَ : أَنْتُمْ تَفْعَلُونَہُمَا ؟۔","","Musannaf Ibn Abi Shaybah 6782","","","كتاب الجمعة"
"6783","(۶۷۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِنِ اسْتَطَعْتَ أَنْ لاَ تُصَلِّی صَلاَۃً إِلاَّ سَجَدْتَ بَعْدَہَا سَجْدَتَیْنِ ، فَافْعَلْ۔","Hasan","Musannaf Ibn Abi Shaybah 6783","","","كتاب الجمعة"
"6784","(۶۷۸۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی الْعَالِیَۃِ الْبَرَائِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : رَأَیْتُہُ یَسْجُدُ بَعْدَ وِتْرِہِ سَجْدَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 6784","","","كتاب الجمعة"
"6785","(۶۷۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَوْنُ بْنُ صَالِحٍ الْبَارِقِیُّ ، عَنْ عَطِیَّۃَ الْعَوْفِی ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ؛ أَنَّہُ کَرِہَ الصَّلاَۃ بَعْدَ الْوِتْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 6785","","","كتاب الجمعة"
"6786","(۶۷۸۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ قَیْسِ بْنِ عُبَادٍ ، قَالَ : لأَنْ أَقْعُدَ بَعْدَ الْوِتْرِ فَأَقْرَأُ ، أَحَبُّ إِلَیَّ مِنْ صَلاَۃٍ بَعْدَ الْوِتْرِ۔","","Musannaf Ibn Abi Shaybah 6786","","","كتاب الجمعة"
"6787","(۶۷۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ قَیْسِ بْنِ عُبَادٍ ، قَالَ : إِذَا أَوْتَرْتَ ثُمَّ قُمْتَ ، فَاقْرَأْ وَأَنْتَ جَالِسٌ۔","","Musannaf Ibn Abi Shaybah 6787","","","كتاب الجمعة"
"6788","(۶۷۸۸) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ سُئِلَ عَنِ السَّجْدَتَیْنِ بَعْدَ الْوِتْرِ ؟ فَقَالَ : ہَذَا شَیْئٌ قَدْ تُرِکَ۔","","Musannaf Ibn Abi Shaybah 6788","","","كتاب الجمعة"
"6789","(۶۷۸۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا سُلَیْمَانُ التَّیْمِیُّ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَقُولُ : إِذَا أَوْتَرَ الرَّجُلُ مِنْ أَوَّلِ اللَّیْلِ ثُمَّ قَامَ مِنْ آخِرِ اللَّیْلِ ، فَلْیَشْفَعْ وَتْرَہُ بِرَکْعَۃٍ ، ثُمَّ لِیُصَلِّ ، ثُمَّ لِیُوتِرْ آخِرَ صَلاَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 6789","","","كتاب الجمعة"
"6790","(۶۷۹۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَفْعَلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 6790","","","كتاب الجمعة"
"6791","(۶۷۹۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا الشَّیْبَانِیُّ ، عَنْ أَبِی قَیْسٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ؛ أَنَّہُ کَانَ یَقُولُ ذَلِکَ أَیْضًا۔","","Musannaf Ibn Abi Shaybah 6791","","","كتاب الجمعة"
"6792","(۶۷۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّ أُسَامَۃَ بْنَ زَیْدٍ ، وَابْنَ عَبَّاسٍ ، قَالاَ: إِذَا أَوْتَرْتَ مِنْ أَوَّلِ اللَّیْلِ ثُمَّ قُمْتَ تُصَلِّی ، فَصَلِّ مَا بَدَا لَکَ وَاشْفَعْ ، ثُمَّ أَوْتِرْ بِرَکْعَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6792","","","كتاب الجمعة"
"6793","(۶۷۹۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُوتِرُ أَوَّلَ اللَّیْلِ ، فَإِذَا قَامَ شَفَعَ۔","","Musannaf Ibn Abi Shaybah 6793","","","كتاب الجمعة"
"6794","(۶۷۹۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، وَشُعْبَۃُ، عَنْ عَبْدِالْمَلِکِ بْنِ عُمَیْرٍ، عَنْ مُوسَی بْنِ طَلْحَۃَ، عَنْ عُثْمَانَ؛ أَنَّہُ کَانَ یَشْفَعُ بِرَکْعَۃٍ ، وَیَقُولُ : مَا أُشَبِّہُہَا إِلاَّ بِالْغَرِیبَۃِ مِنَ الإِبِلِ۔","Sahih","Musannaf Ibn Abi Shaybah 6794","","","كتاب الجمعة"
"6795","(۶۷۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی قَیْسٍ الأَوْدِیِّ عَبْدِ الرَّحْمَنِ بْنِ ثَرَوَانِ ، قَالَ : سَأَلْتُ عَمْرَو بْنَ مَیْمُونٍ عَنِ الرَّجُلِ یُوتِرُ ، ثُمَّ یَسْتَیْقِظُ ؟ قَالَ : یَشْفَعُ بِرَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 6795","","","كتاب الجمعة"
"6796","(۶۷۹۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : إِذَا أَوْتَرَ ثُمَّ قَامَ یُصَلِّی ، صَلَّی شَفْعًا شَفْعًا۔","","Musannaf Ibn Abi Shaybah 6796","","","كتاب الجمعة"
"6797","(۶۷۹۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ کُلَیْبٍ الْجَرْمِیِّ ، عَنْ سَعْدٍ ، قَالَ : أَمَّا أَنَا فَإِذَا أَوْتَرْتُ ثُمَّ قُمْتُ ، صَلَّیْتُ رَکْعَتَیْنِ رَکْعَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 6797","","","كتاب الجمعة"
"6798","(۶۷۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃٌ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسِ بْنِ عَمْرٍو الْہَجَرِیِّ ، عَنْ عَمَّارٍ ، قَالَ : أَمَّا أَنَا فَأُوتِرُ ، فَإِذَا قُمْتُ صَلَّیْتُ مَثْنَی مَثْنَی ، وَتَرَکْتُ وِتْرِی الأَوَّلَ کَمَا ہُوَ۔","Sahih","Musannaf Ibn Abi Shaybah 6798","","","كتاب الجمعة"
"6799","(۶۷۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی جَمْرَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، وَعَائِذِ بْنِ عَمْرٍو ، قَالاَ : إِذَا أَوْتَرْتَ أَوَّلَ اللَّیْلِ ، فَلاَ تُوتِرْ آخِرَہُ ، وَإِذَا أَوْتَرْتَ آخِرَہُ ، فَلاَ تُوتِرْ أَوَّلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 6799","","","كتاب الجمعة"
"6800","(۶۸۰۰) حَدَّثَنَا حَفْصٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرٍ ؛ أَنَّہُ کَانَ یُوتِرُ أَوَّلَ اللَّیْلِ ، وَکَانَ إِذَا قَامَ یُصَلِّی ، صَلَّی رَکْعَتَیْنِ رَکْعَتَیْنِ ۔ وَکَانَ سَعِیدٌ یَفْعَلُہُ۔","","Musannaf Ibn Abi Shaybah 6800","","","كتاب الجمعة"
"6801","(۶۸۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ بِشْرِ بْنِ حَرْبٍ أَبِی عَمْرٍو ، قَالَ : سَمِعْتُ رَافِعَ بْنَ خَدِیجٍ ، قَالَ : أَمَّا أَنَا فَأُوتِرُ ، فَإِذَا قُمْتُ صَلَّیْتُ مَثْنَی مَثْنَی ، وَتَرَکْتُ وِتْرِی۔","Da'if","Musannaf Ibn Abi Shaybah 6801","","","كتاب الجمعة"
"6802","(۶۸۰۲) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ أَوْتَرَ أَوَّلَ اللَّیْلِ ثُمَّ قَامَ ، فَلْیُصَلِّ رَکْعَتَیْنِ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6802","","","كتاب الجمعة"
"6803","(۶۸۰۳) حَدَّثَنَا حَفْصٌ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 6803","","","كتاب الجمعة"
"6804","(۶۸۰۴) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 6804","","","كتاب الجمعة"
"6805","(۶۸۰۵) حَدَّثَنَا حَفْصٌ، عَنْ حَجَّاجٍ، عَنْ طَلْقِ بْنِ مُعَاوِیَۃَ، عَنْ عَلْقَمَۃَ؛ أَنَّہُ سَأَلَہُ؟ فَقَالَ: یُصَلِّی رَکْعَتَیْنِ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6805","","","كتاب الجمعة"
"6806","(۶۸۰۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ وِقَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یُصَلِّی مَثْنَی مَثْنَی۔","","Musannaf Ibn Abi Shaybah 6806","","","كتاب الجمعة"
"6807","(۶۸۰۷) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی قَیْسٍ ، قَالَ : لَقِیتُ عَلْقَمَۃَ فَذَکَرْتُ ذَلِکَ لَہُ ، فَقَالَ : صَلِّ رَکْعَتَیْنِ رَکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6807","","","كتاب الجمعة"
"6808","(۶۸۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی قَیْسٍ ، قَالَ : سَأَلْتُ عَلْقَمَۃَ ؟ فَقَالَ : إِذَا أَوْتَرْتَ ثُمَّ قُمْتَ، فَاشْفَعْ بِرَکْعَۃٍ حَتَّی تُصْبِحَ۔","","Musannaf Ibn Abi Shaybah 6808","","","كتاب الجمعة"
"6809","(۶۸۰۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، عَن عَائِشَۃَ ؛ أَنَّہَا سُئِلَتْ عَنِ الَّذِی یَنْقُضُ وَتْرَہُ ؟ فَقَالَتْ : ہَذَا یَلْعَبُ بِوِتْرِہِ۔","","Musannaf Ibn Abi Shaybah 6809","","","كتاب الجمعة"
"6810","(۶۸۱۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا دَاوُدُ ، عَنِ الشَّعْبِ[corrupt]ِّ ، قَالَ : سَأَلْتُُہُ عَنِ الَّذِی یَنْقُضُ وِتْرَہُ ؟ فَقَالَ : إِنَّمَا أُمِرْنَا بِالإِبْرَامِ ، وَلَمْ نُؤْمَرْ بِالنَّقْضِ۔","","Musannaf Ibn Abi Shaybah 6810","","","كتاب الجمعة"
"6811","(۶۸۱۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا أَوْتَرَ ثُمَّ قَامَ وَعَلَیْہِ لَیْلٌ ؟ قَالَ : یُصَلِّی شَفْعًا شَفْعًا۔","","Musannaf Ibn Abi Shaybah 6811","","","كتاب الجمعة"
"6812","(۶۸۱۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : إِذَا أَوْتَرَ الرَّجُلُ مِنْ أَوَّلِ اللَّیْلِ ، ثُمَّ بَدَا لَہُ أَنْ یُصَلِّیَ مِنْ آخِرِ اللَّیْلِ ، فَلْیُصَلِّ رَکْعَتَیْنِ رَکْعَتَیْنِ حَتَّی یُصْبِحَ۔","","Musannaf Ibn Abi Shaybah 6812","","","كتاب الجمعة"
"6813","(۶۸۱۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إِبْرَاہِیمَ ، قَالَ : سَأَلْتُُہُ عَنِ الرَّجُلِ یُوتِرُ ثُمَّ یَسْتَیْقِظُ ؟ قَالَ : یُصَلِّی مَثْنَی مَثْنَی ، وَکَانُوا یَسْتَحِبُّونَ أَنْ یَکُونَ آخِرُ صَلاَتِہِمْ وِتْرًا۔","","Musannaf Ibn Abi Shaybah 6813","","","كتاب الجمعة"
"6814","(۶۸۱۴) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، عَنْ قَیْسِ بْنِ طَلْقٍ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یَقُولُ : لاَ وِتْرَانِ فِی لَیْلَۃٍ۔ (ترمذی ۴۷۰۔ ابوداؤد ۱۴۳۴)","Hasan","Musannaf Ibn Abi Shaybah 6814","","","كتاب الجمعة"
"6815","(۶۸۱۵ ) حَدَّثَنَا سَلاَّمُ بْنُ سُلَیْمٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ (ح) وَحَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوتِرُ عِنْدَ الأَذَانِ ، وَیُصَلِّی الرَّکْعَتَیْنِ مَعَ الإِقَامَۃِ ۔","Da'if","Musannaf Ibn Abi Shaybah 6815","","","كتاب الجمعة"
"6816","(۶۸۱۶) حَدَّثَنَا سَلاَّمُ بْنُ سُلَیْمٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ (ح) وَحَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوتِرُ عِنْدَ الأَذَانِ ، وَیُصَلِّی الرَّکْعَتَیْنِ مَعَ الإِقَامَۃِ ۔ زَادَ سَلاَّمُ : الأَذَانَ الأَوَّلَ ، قَالَ سَلاَّمُ : وَسَمِعْت أَبَا إِسْحَاقَ مَرَّۃً ، قَالَ : یُوتِرُ عِنْدَ طُلُوعِ الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 6816","","","كتاب الجمعة"
"6817","(۶۸۱۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ الْحَذَّائُ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : رُبَّمَا أَوْتَرْتُ وَإِنَّ الإِمَام لَصَافٍ فِی صَلاَۃِ الصُّبْحِ۔","","Musannaf Ibn Abi Shaybah 6817","","","كتاب الجمعة"
"6818","(۶۸۱۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : جَائَ رَجُلٌ إِلَی ابْنِ مَسْعُودٍ ، قَالَ : أُوتِرُ وَالْمُؤَذِّنُ یُقِیمُ؟ قَالَ : نَعَمْ ، فَأَوْتِرْ۔","Sahih","Musannaf Ibn Abi Shaybah 6818","","","كتاب الجمعة"
"6819","(۶۸۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ یُوتِرُ عِنْدَ الإِقَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 6819","","","كتاب الجمعة"
"6820","(۶۸۲۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، قَالَ : حدَّثَنَا أَبُو ظَبْیَانَ ، قَالَ : کَانَ عَلِیٌّ یَخْرُجُ إِلَیْنَا وَنَحْنُ نَنْظرُ إِلَی تَبَاشِیرَ الصُّبْحِ ، فَیَقُولُ : الصَّلاَۃُ الصَّلاَۃُ ، نِعْمَ سَاعَۃُ الْوِتْرِ ہَذِہِ ، فَإِذَا طَلَعَ الْفَجْرُ صَلَّی رَکْعَتَیْنِ ، ثُمَّ أُقِیمَتِ الصَّلاَۃ فَصَلَّی۔","","Musannaf Ibn Abi Shaybah 6820","","","كتاب الجمعة"
"6821","(۶۸۲۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، عَنْ مَسْرُوقٍ ، قَالَ : سَأَلْتُ عَائِشَۃَ عَنْ وِتْرِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَتْ: کُلُّ اللَّیْلِ قَدْ أَوْتَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ؛ أَوَّلَہُ، وَأَوْسَطَہُ ، فَانْتَہَی وِتْرُہُ حِینَ مَاتَ فِی السَّحَرِ۔ (ترمذی ۴۵۶۔ احمد ۶/۱۲۹)","Sahih","Musannaf Ibn Abi Shaybah 6821","","","كتاب الجمعة"
"6822","(۶۸۲۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَہُ۔ (بخاری ۹۹۶۔ ابوداؤد ۱۴۳۰)","Sahih","Musannaf Ibn Abi Shaybah 6822","","","كتاب الجمعة"
"6823","(۶۸۲۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَلْقَمَۃَ ، قَالَ : صَلَّیْتُ مَعَ عَبْدِ اللہِ لَیْلَۃً کُلَّہَا ، فَکَانَ یَرْفَعُ صَوْتَہُ یَقْرَأُ قِرَائَۃً یُسْمِعُ أَہْلَ الْمَسْجِدِ ، یُرَتِّلُ ، وَلاَ یَرْجِعُ حَتَّی إِذَا کَانَ قَبْلَ أَنْ یَطْلُعَ الْفَجْرُ بِمِقْدَارِ مَا بَیْنَ أَذَانِ الْمَغْرِبِ إِلَی الاِنْصِرَافِ مِنْہَا أَوْتَرَ۔","","Musannaf Ibn Abi Shaybah 6823","","","كتاب الجمعة"
"6824","(۶۸۲۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ: الْوِتْرُ مَا بَیْنَ الصَّلاَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 6824","","","كتاب الجمعة"
"6825","(۶۸۲۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قُلْتُ : أَیُّ سَاعَۃٍ أَحَبُّ إِلَیْک أَنْ أُوتِرَ ؟ قَالَ: إِذَا نعَبَ الْمُؤَذِّنُونَ۔","","Musannaf Ibn Abi Shaybah 6825","","","كتاب الجمعة"
"6826","(۶۸۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إِبْرَاہِیمَ ، قَالَ : سَأَلْتُ عَبِیْدَۃَ عَنِ الرَّجُلِ یَسْتَیْقِظُ عِنْدَ الإِقَامَۃِ ؟ قَالَ : یُوتِرُ۔","Sahih","Musannaf Ibn Abi Shaybah 6826","","","كتاب الجمعة"
"6827","(۶۸۲۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَیَانَ ، عَنْ وَبَرَۃَ ، قَالَ : جَائَ ابْنُ عُمَرَ مَعَ الْفَجْرِ ، فَأَوْتَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 6827","","","كتاب الجمعة"
"6828","(۶۸۲۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُطَرِّفٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ بَعْضِ أَصْحَابِ عَلِیٍّ ، قَالَ : قَالَ عَلِیٌّ : مِنْ کُلِّ اللَّیْلِ قَدْ أَوْتَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِنْ أَوَّلِہِ ، وَأَوْسَطِہِ ، وَآخِرِہِ ، وَلَکِنْ ثَبَتَ الْوِتْرُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ آخِرِ اللَّیْلِ۔ (احمد ۷۸)","Da'if","Musannaf Ibn Abi Shaybah 6828","","","كتاب الجمعة"
"6829","(۶۸۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یُوتِرُ إِذَا بَقِیَ مِنَ اللَّیْلِ مِثْلُ مَا ذَہَبَ مِنْہُ إِلَی صَلاَۃِ الْمَغْرِبِ۔","Hasan","Musannaf Ibn Abi Shaybah 6829","","","كتاب الجمعة"
"6830","(۶۸۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، قَالَ: سُئِلَ عَبْدُ اللہِ عَنِ الْوِتْرِ بَعْدَ الأَذَانِ ؟ فَقَالَ : نَعَمْ ، وَبَعْدَ الإِقَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 6830","","","كتاب الجمعة"
"6831","(۶۸۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ؛ أَنَّ أَبَا مَیْسَرَۃَ کَانَ یَؤُمُّ قَوْمَہُ ، فَأَبْطَأَ عَلَیْہِمْ ، فَقَالَ : إِنِّی کُنْتُ أُوتِرُ۔","","Musannaf Ibn Abi Shaybah 6831","","","كتاب الجمعة"
"6832","(۶۸۳۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی عَبْدِ اللہِ الْجَدَلِیِّ ، عَنْ أَبِی مَسْعُودٍ ، قَالَ: مِنْ کُلِّ اللَّیْلِ قَدْ أَوْتَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَسَلَّمَ ؛ مِنْ أَوَّلِہِ ، وَوَسَطِہِ، وَآخِرِہِ ، فَانْتَہَی وِتْرُہُ إِلَی السَّحَرِ۔ (احمد ۵/۲۷۲۔ طبرانی ۶۸۱)","Hasan","Musannaf Ibn Abi Shaybah 6832","","","كتاب الجمعة"
"6833","(۶۸۳۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : أَوْتِرُوا قَبْلَ أَنْ تُصْبِحُوا۔ (مسل[corrupt] ۵۱۹۔ احمد ۳/۳۷)","Sahih","Musannaf Ibn Abi Shaybah 6833","","","كتاب الجمعة"
"6834","(۶۸۳۴) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُحِبُّونَ أَنْ یُوتِرُوا مِنْ آخِرِ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 6834","","","كتاب الجمعة"
"6835","(۶۸۳۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْوِتْرُ بِلَیْلٍ ، وَالسُّحُورُ بِلَیْلٍ۔","","Musannaf Ibn Abi Shaybah 6835","","","كتاب الجمعة"
"6836","(۶۸۳۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْوِتْرُ مِنْ أَوَّلِ اللَّیْلِ حَسَنٌ ،وَأَفْضَلُہُ آخِرُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 6836","","","كتاب الجمعة"
"6837","(۶۸۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ (ح) وَعَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالُوا : الْوِتْرُ بِاللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 6837","","","كتاب الجمعة"
"6838","(۶۸۳۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : لأَنْ أُوتِرَ بِلَیْلٍ أَحَبُّ إِلَیَّ مِنْ أَنْ أُحْیِیَ لَیْلَتِی ، ثُمَّ أُوتِرُ بَعْدَ مَا أُصْبِحُ۔","Hasan","Musannaf Ibn Abi Shaybah 6838","","","كتاب الجمعة"
"6839","(۶۸۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبِی حَبِیبٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : أَیُّ سَاعَۃٍ ، قَالَ عَلِیٌّ : نِعْمَ سَاعَۃِ الْوِتْرِ ہَذِہِ ، قَالَ : بِغَلَسٍ قَبْلَ الْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 6839","","","كتاب الجمعة"
"6840","(۶۸۴۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی ہَارُونَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : نَادَی مُنَادِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنْ لاَ وِتْرَ بَعْدَ طُلُوعِ الْفَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 6840","","","كتاب الجمعة"
"6841","(۶۸۴۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِی ہَارُونَ ، عَنْ أَبِی سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِنَحْوِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 6841","","","كتاب الجمعة"
"6842","(۶۸۴۲) حَدَّثَنَا ہُشَیْمٌ، قَالَ: أَخْبَرَنَا یُونُسُ، وَمَنْصُورٌ، عَنِ الْحَسَنِ، قَالَ: إِذَا صَلَّیْتَ الْغَدَاۃَ وَطَلَعَتِ الشَّمْسُ، فَقَدْ ذَہَبَ الْوِتْرُ۔","","Musannaf Ibn Abi Shaybah 6842","","","كتاب الجمعة"
"6843","(۶۸۴۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ (ح) وَعَبْدُ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُمَا قَالاَ : إِذَا صَلَّیْتَ الْغَدَاۃَ وَطَلَعَتِ الشَّمْسُ فَلاَ وِتْرَ۔","","Musannaf Ibn Abi Shaybah 6843","","","كتاب الجمعة"
"6844","(۶۸۴۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ وِتْرَ بَعْدَ الْغَدَاۃِ۔","","Musannaf Ibn Abi Shaybah 6844","","","كتاب الجمعة"
"6845","(۶۸۴۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَنْ صَلَّی الْغَدَاۃَ وَلَمْ یُوتِرْ ، فَلاَ وَتْرَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 6845","","","كتاب الجمعة"
"6846","(۶۸۴۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : مَنْ أَصْبَحَ وَلَمْ یُوتِرْ ، فَلاَ وَتْرَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 6846","","","كتاب الجمعة"
"6847","(۶۸۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إِذَا طَلَعَ الْفَجْرُ فَلاَ تُوتِرُ ، کَیْفَ تَجْعَلُ صَلاَۃَ اللَّیْلِ فِی صَلاَۃِ النَّہَارِ ؟۔","","Musannaf Ibn Abi Shaybah 6847","","","كتاب الجمعة"
"6848","(۶۸۴۸) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَکَمِ ، قَالَ : رُبَّمَا قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِیَدِہِ ہَکَذَا ؛ وَمَسَحَ لِحْیَتَہُ بِیَدِہِ فِی الصَّلاَۃ۔","Hasan","Musannaf Ibn Abi Shaybah 6848","","","كتاب الجمعة"
"6849","(۶۸۴۹) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ مُجَاہِدٍ، قَالَ: کَانَ یُقَالُ: لِیَمَسَّ الرَّجُلُ لِحْیَتَہُ مَرَّۃً فِی الصَّلاَۃ، أَوْ لِیَدَعْ۔","","Musannaf Ibn Abi Shaybah 6849","","","كتاب الجمعة"
"6850","(۶۸۵۰) حَدَّثَنَا أَبُو بَحْرٍ الْبَکْرَاوِیُّ ، عَنْ یُونُسَ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یَمَسُّ لِحْیَتَہُ وَہُوَ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 6850","","","كتاب الجمعة"
"6851","(۶۸۵۱) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مُخْتَارِ بْنِ سَعْدٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ یَوْمًا وَہُوَ یُصَلِّی ، قَبَضَ عَلَی لِحْیَتِہِ۔","","Musannaf Ibn Abi Shaybah 6851","","","كتاب الجمعة"
"6852","(۶۸۵۲) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لَہُ : رَأَیْتَ مُحَمَّدَ بْنَ سِیرِینَ یَمَسَّ لِحْیَتَہُ وَہُوَ فِی الصَّلاَۃ ؟ قَالَ: مَا أَکْثَرَ مَا رَأَیْتُہُ یَمَسَّ لِحْیَتَہُ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6852","","","كتاب الجمعة"
"6853","(۶۸۵۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عَمْرِو بْنِ حُوَیْرِثٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ رُبَّمَا مَسَّ لِحْیَتَہُ وَہُوَ یُصَلِّی۔ (ابوداؤد ۴۸۔ عبدالرزاق ۳۳۱۷)","Da'if","Musannaf Ibn Abi Shaybah 6853","","","كتاب الجمعة"
"6854","(۶۸۵۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، قَالَ : رَأَی سَعِیدُ بْنُ الْمُسَیَّبِ رَجُلاً وَہُوَ یَعْبَثُ بِلِحْیَتِہِ فِی الصَّلاَۃ ، فَقَالَ : لَوْ خَشَعَ قَلْبُ ہَذَا لَخَشَعَتْ جَوَارِحُہُ۔","","Musannaf Ibn Abi Shaybah 6854","","","كتاب الجمعة"
"6855","(۶۸۵۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ سَعِیدٍ الزُّبَیْدِیِّ ، قَالَ : سَمِعْتُ إِبْرَاہِیمَ یَقُولُ : مَنْ أَنَّ فِی صَلاَتِہِ ، فَقَدْ فَسَدَتْ عَلَیْہِ صَلاَتُہُ۔","","Musannaf Ibn Abi Shaybah 6855","","","كتاب الجمعة"
"6856","(۶۸۵۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ التَّأَوُّہَ فِی الصَّلاَۃ۔","","Musannaf Ibn Abi Shaybah 6856","","","كتاب الجمعة"
"6857","(۶۸۵۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ کَانَ یَکْرَہُ الزَّفِرَ فِی الصَّلاَۃ ، وَقَالَ : یُشَبَّہُ بِالْکَلاَمِ۔","","Musannaf Ibn Abi Shaybah 6857","","","كتاب الجمعة"
"6858","(۶۸۵۸) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ تَدَعْ وِتْرَک وَلَوْ بِنِصْفِ النَّہَارِ۔","","Musannaf Ibn Abi Shaybah 6858","","","كتاب الجمعة"
"6859","(۶۸۵۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ لَیْثٍ ، عَنِ الشَّعْبِیِّ ، وَعَطَائٍ ، وَالْحَسَنِ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ، قَالُوا : لاَ تَدَعِ الْوِتْرَ ، وَإِنْ طَلَعَتِ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 6859","","","كتاب الجمعة"
"6860","(۶۸۶۰) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، أَنَّہُمَا قَالاَ : مَنْ لَمْ یُوتِرْ حَتَّی تَطْلُعَ الشَّمْسُ فَلْیُوتِرْ۔","","Musannaf Ibn Abi Shaybah 6860","","","كتاب الجمعة"
"6861","(۶۸۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ وَبَرَۃَ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنْ رَجُلٍ أَصْبَحَ ، وَلَمْ یُوتِرْ ؟ قَالَ : أَرَأَیْتَ لَوْ نِمْتَ عَنِ الْفَجْرِ حَتَّی تَطْلُعَ الشَّمْسُ ، أَلَیْسَ کُنْتَ تُصَلِّی ؟ ۔ کَأَنَّہُ یَقُولُ : یُوتِرُ۔","Sahih","Musannaf Ibn Abi Shaybah 6861","","","كتاب الجمعة"
"6862","(۶۸۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنِ جُبَیْرٍ ، وَسُئِلَ عَنْ رَجُلٍ نَامَ عَنِ الْوِتْرِ حَتَّی أَصْبَحَ ؟ فَقَالَ : یُوتِرُ مِنَ الْقَابِلَۃِ وِتْرَیْنِ۔","","Musannaf Ibn Abi Shaybah 6862","","","كتاب الجمعة"
"6863","(۶۸۶۳) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مَالِکٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، قَالَ : أَوْتَرَ أَبِی وَقَدْ طَلَعَ الْفَجْرُ۔","","Musannaf Ibn Abi Shaybah 6863","","","كتاب الجمعة"
"6864","(۶۸۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : قُلْتُ لَہُ : الرَّجُلُ یَنَامُ فَیُصْبِحُ ، یُوتِرُ بَعْدَ مَا یُصْبِحُ بِرَکْعَۃٍ ؟ قَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 6864","","","كتاب الجمعة"
"6865","(۶۸۶۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنْ رَجُلٍ لَمْ یُوتِرْ حَتَّی طَلَعَتِ الشَّمْسُ ؟ فَقَالَ : أَحَبُّ إِلَیَّ أَنْ یُوتِرَ۔وَسَأَلْت الْحَکَمَ ؟ فَقَالَ : إِنْ شَائَ لَمْ یُوتِرْ۔","","Musannaf Ibn Abi Shaybah 6865","","","كتاب الجمعة"
"6866","(۶۸۶۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ خَالِدِ بْنِ أَبِی کَرِیمَۃَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : جَائَ رَجُلٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنِّی أَصْبَحْتُ وَلَمْ أُوتِرْ ؟ فَقَالَ : إِنَّمَا الْوِتْرُ بِاللَّیْلِ ، ثُمَّ قَالَ : یَا رَسُولَ اللہِ ، إِنِّی أَصْبَحْتُ وَلَمْ أُوتِرْ ؟ فَقَالَ : إِنَّمَا الْوِتْرُ بِاللَّیْلِ ، ثُمَّ قَالَ : إِنِّی أَصْبَحْتَ وَلَمْ أُوتِرْ ؟ قَالَ فِی الثَّالِثَۃِ ، أَوِ الرَّابِعَۃِ : فَأَوْتِرْ۔ (عبدالرزاق ۴۶۰۷)","","Musannaf Ibn Abi Shaybah 6866","","","كتاب الجمعة"
"6867","(۶۸۶۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ (ح) وَعَبْدُ الْمَلِکِ ، عَنْ عَطَائٍ ، أَنَّہُمْ قَالُوا : إِنْ لَمْ تَفْعَلْ وَطَلَعَ الْفَجْرُ ، فَأَوْتِرْ ، مَا لَمْ تُصَلِّ الْغَدَاۃَ۔","","Musannaf Ibn Abi Shaybah 6867","","","كتاب الجمعة"
"6868","(۶۸۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : یُوتِرُ وَإِنْ أَدْرَکَتْہُ صَلاَۃُ الصُّبْحِ۔","","Musannaf Ibn Abi Shaybah 6868","","","كتاب الجمعة"
"6869","(۶۸۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ نُعَیْمِ بْنِ حَکِیمٍ ، عَنْ أَبِی مَرْیَمَ ، قَالَ : جَائَ رَجُلٌ إِلَی عَلِیٍّ ، فَقَالَ : إِنِّی نِمْتُ وَنَسِیتُ الْوِتْرَ حَتَّی طَلَعَتِ الشَّمْسُ ؟ فَقَالَ : إِذَا اسْتَیْقَظْتَ وَذَکَرْتَ ، فَصَلِّ۔","Da'if","Musannaf Ibn Abi Shaybah 6869","","","كتاب الجمعة"
"6870","(۶۸۷۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَلاَۃُ اللَّیْلِ مَثْنَی مَثْنَی ، فَإِذَا خَشِیتَ الصُّبْحَ فَأَوْتِرْ بِرَکْعَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6870","","","كتاب الجمعة"
"6871","(۶۸۷۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُوتِرُ بِرَکْعَۃٍ ، وَکَانَ یَتَکَلَّمُ بَیْنَ الرَّکْعَتَیْنِ وَالرَّکْعَۃِ ۔ (ابوداؤد ۱۳۳۰۔ احمد ۶/۷۴)","Sahih","Musannaf Ibn Abi Shaybah 6871","","","كتاب الجمعة"
"6872","(۶۸۷۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا خَالِدٌ ، عَنْ عَبْدِ اللہِ بْنِ شَقِیقٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : صَلاَۃُ اللَّیْلِ مَثْنَی مَثْنَی ، وَالْوِتْرُ وَاحِدَۃٌ ، وَسَجْدَتَانِ قَبْلَ صَلاَۃِ الصُّبْحِ۔","Sahih","Musannaf Ibn Abi Shaybah 6872","","","كتاب الجمعة"
"6873","(۶۸۷۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، وَابْنُ عَوْنٍ ، وَغَیْرُہُمَا ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَجُلاً سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ صَلاَۃِ اللَّیْلِ ؟ قَالَ : مَثْنَی مَثْنَی ، فَإِذَا حَسِسْتَ الصُّبْحَ ، أَوْ خَشِیتَ الصُّبْحَ ، فَصَلِّ لَکَ رَکْعَۃً ، تُوتِرُ لَکَ صَلاَتَک۔ (بخاری۹۹۰۔ مسلم ۱۴۵)","Sahih","Musannaf Ibn Abi Shaybah 6873","","","كتاب الجمعة"
"6874","(۶۸۷۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا مَنْصُورٌ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ الْمُزَنِیِّ؛ أَنَّ ابْنَ عُمَرَ صَلَّی رَکْعَتَیْنِ ثُمَّ سَلَّمَ، ثُمَّ قَالَ: أَدْخِلُوا إِلَیَّ نَاقَتِی فُلاَنَۃً ، ثُمَّ قَامَ فَأَوْتَرَ بِرَکْعَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6874","","","كتاب الجمعة"
"6875","(۶۸۷۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو بِشْرٍ ، عَنِ ابْنِ شَقِیقٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : صَلاَۃُ اللَّیْلِ مَثْنَی مَثْنَی ، وَالْوِتْرُ وَاحِدَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 6875","","","كتاب الجمعة"
"6876","(۶۸۷۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُوتِرُ بِرَکْعَۃٍ ، قَالَ : فَقِیلَ لَہُ ؟ فَقَالَ : إِنَّمَا اسْتَقْصَرْتُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 6876","","","كتاب الجمعة"
"6877","(۶۸۷۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا الْحَجَّاجُ ، عَنْ عَطَائٍ ؛ أَنَّ مُعَاوِیَۃَ أَوْتَرَ بِرَکْعَۃٍ ، فَأُنْکِرَ ذَلِکَ عَلَیْہِ ، فَسُئِلَ ابْنُ عَبَّاسٍ ؟ فَقَالَ : أَصَابَ السُّنَّۃَ۔","","Musannaf Ibn Abi Shaybah 6877","","","كتاب الجمعة"
"6878","(۶۸۷۸) حَدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَمَرَ ابْنُ مَسْعُودٍ ،وَحُذَیْفَۃُ عِنْدَ الْوَلِیدِ بْنِ عُقْبَۃَ ، ثُمَّ خَرَجَا فَتَقَاوَمَا ، فَلَمَّا أَصْبَحَا رَکَعَ کُلُّ وَاحِدٍ مِنْہُمَا رَکْعَۃً۔","","Musannaf Ibn Abi Shaybah 6878","","","كتاب الجمعة"
"6879","(۶۸۷۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : سَأَلْتُ عَطَائً ، أُوتِرُ بِرَکْعَۃٍ ؟ فَقَالَ : نَعَمْ ، إِنْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 6879","","","كتاب الجمعة"
"6880","(۶۸۸۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ آلُ سَعْدٍ ، وَآلُ عَبْدِ اللہِ بْنِ عُمَرَ یُسَلِّمُونَ فِی رَکْعَتَیِ الْوِتْرِ ، وَیُوتِرُونَ بِرَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 6880","","","كتاب الجمعة"
"6881","(۶۸۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ الْحَسَنُ یُسَلِّمُ فِی رَکْعَتَیِ الْوِتْرِ۔","","Musannaf Ibn Abi Shaybah 6881","","","كتاب الجمعة"
"6882","(۶۸۸۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنِ ، عَنْ سَعِیدٍ ، وَنَافِعٍ ، قَالَ : رَأَیْنَا مُعَاذًا الْقَارِیئَ یُسَلِّمُ فِی رَکْعَتَیِ الْوِتْرِ۔","","Musannaf Ibn Abi Shaybah 6882","","","كتاب الجمعة"
"6883","(۶۸۸۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ؛ أَنَّ أَبَا بَکْرٍ أَوْتَرَ بِرَکْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 6883","","","كتاب الجمعة"
"6884","(۶۸۸۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا مَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَتْ نَائِلَۃُ ابْنَۃُ فُرَافِصَۃَ الْکَلْبِیَّۃُ : إِنْ تقْتُلُوہُ، أَوْ تَدَعُوہُ فَقَدْ کَانَ یُحْیِی اللَّیْلَ بِرَکْعَۃٍ یَجْمَعُ فِیہَا الْقُرْآنَ ، تَعْنِی یُوتِرُ بِہَا ، تَعْنِی عُثْمَانَ رَضِیَ اللَّہُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 6884","","","كتاب الجمعة"
"6885","(۶۸۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ، عَنْ عَائِشَۃَ ، قَالَت : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوتِرُ بِتِسْعٍ ، فَلَمَّا أَسَنَّ وَثَقُلَ أَوْتَرَ بِسَبْعٍ۔ (ابوداؤد ۱۳۴۳۔ احمد ۶/۳۲)","Sahih","Musannaf Ibn Abi Shaybah 6885","","","كتاب الجمعة"
"6886","(۶۸۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ یَحْیَی بْنِ الْجَزَّارِ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوتِرُ بِثَلاَثَ عَشَرَۃَ ، فَلَمَّا کَبِرَ وَضَعُفَ ، أَوْتَرَ بِسَبْعٍ۔ (ترمذی ۴۵۷۔ احمد ۳۲۲)","","Musannaf Ibn Abi Shaybah 6886","","","كتاب الجمعة"
"6887","(۶۸۸۷) حَدَّثَنَا ہُشَیْمٌ ، عَنِ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ (ح) قَالَ ہُشَیْمٌ : وَأَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، قَالاَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوتِرُ بِتِسْعِ رَکَعَاتٍ ، فَلَمَّا أَسَنَّ وَبَدُنَ ، أَوْتَرَ بِسَبْعٍ، وَرَکْعَتَیْنِ وَہُوَ جَالِسٌ۔","","Musannaf Ibn Abi Shaybah 6887","","","كتاب الجمعة"
"6888","(۶۸۸۸) حَدَّثَنَا ہُشَیْمٌ ، عَنِ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ (ح) قَالَ ہُشَیْمٌ : وَأَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، قَالاَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوتِرُ بِتِسْعِ رَکَعَاتٍ ، فَلَمَّا أَسَنَّ وَبَدُنَ ، أَوْتَرَ بِسَبْعٍ، وَرَکْعَتَیْنِ وَہُوَ جَالِسٌ۔","","Musannaf Ibn Abi Shaybah 6888","","","كتاب الجمعة"
"6889","(۶۸۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن الأَعْمَش ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : قَالَ عَبْدُ اللہِ : الْوِتْرُ ثَلاَثُ رَکَعَاتٍ کَصَلاَۃِ الْمَغْرِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 6889","","","كتاب الجمعة"
"6890","(۶۸۹۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : ذَکَرْتُ لِسَعِیدِ بْنِ جُبَیْرٍ قَوْلَ عَبْدِ اللہِ ، الْوِتْرُ بِسَبْعٍ ، أَوْ بِخَمْسٍ ، وَلاَ أَقَلَّ مِنْ ثَلاَثٍ ، فَقَالَ سَعِیدٌ : قَالَ ابْنُ عَبَّاسٍ : إِنِّی لأَکْرَہُ أَنْ یَکُونَ ثَلاَثًا بُتْرًا ، وَلَکِنْ سَبْعًا ، أَوْ خَمْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 6890","","","كتاب الجمعة"
"6891","(۶۸۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیج ، عَنْ إِسْمَاعِیلَ بْنِ مُحَمَّدِ بْنِ سَعدٍ ، عَنِ ابْنِ السَّبَّاقِ ؛ أَنَّ عُمَرَ دَفَنَ أَبَا بَکْرٍ لَیْلاً ، ثُمَّ دَخَلَ الْمَسْجِدَ فَأَوْتَرَ بِثَلاَثٍ۔","","Musannaf Ibn Abi Shaybah 6891","","","كتاب الجمعة"
"6892","(۶۸۹۲) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ إِسْمَاعِیلَ بْنِ زَیْدٍ ، قَالَ : کَانَ زَیْدُ بْنُ ثَابِتٍ یُوتِرُ بِخَمْسِ رَکَعَاتٍ ، لاَ یَنْصَرِفُ فِیہَا۔","","Musannaf Ibn Abi Shaybah 6892","","","كتاب الجمعة"
"6893","(۶۸۹۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یُوتِرُ بِثَلاَثِ رَکَعَاتٍ۔","","Musannaf Ibn Abi Shaybah 6893","","","كتاب الجمعة"
"6894","(۶۸۹۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا عَبْدُالرَّحْمَنِ بْنُ إِسْحَاقٍ ، عَنْ عَبْدِالْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ: کَانَ ابْنُ مَسْعُودٍ یُوتِرُ بِثَلاَثٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6894","","","كتاب الجمعة"
"6895","(۶۸۹۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی سُلَیْمَانَ ، عَنْ أَبِی عَبْدِ الرَّحِیمِ ، عَنْ زَاذَانَ أَبِی عُمَرَ ؛ أَنَّ عَلِیًّا کَانَ یَفْعَلُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 6895","","","كتاب الجمعة"
"6896","(۶۸۹۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُلَیْمَانَ بْنِ حَیَّانَ ، عَنْ أَبِی غَالِبٍ ، قَالَ : کَانَ أَبُو أُمَامَۃَ یُوتِرُ بِثَلاَثِ رَکَعَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6896","","","كتاب الجمعة"
"6897","(۶۸۹۷) حَدَّثَنَا عَبْدَۃُ بن سُلَیمَان ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ عُثْمَانَ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُوتِرُ بِخَمْسٍ ، لاَ یَنْصَرِفُ فِیہَا۔","","Musannaf Ibn Abi Shaybah 6897","","","كتاب الجمعة"
"6898","(۶۸۹۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : لاَ تُوتَرُ بِثَلاَثٍ بُتْرٍ ، صَلِّ قَبْلَہَا رَکْعَتَیْنِ ، أَوْ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 6898","","","كتاب الجمعة"
"6899","(۶۸۹۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سَمِعْتُ جَابِرَ بْنَ زَیْدٍ ، یَقُولُ : الْوِتْرُ ثَلاَثٌ۔","","Musannaf Ibn Abi Shaybah 6899","","","كتاب الجمعة"
"6900","(۶۹۰۰) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ طَلْقِ بْنِ مُعَاوِیَۃَ ، عَنْ عَلْقَمَۃَ ، قَالَ : الْوِتْرُ ثَلاَثٌ۔","","Musannaf Ibn Abi Shaybah 6900","","","كتاب الجمعة"
"6901","(۶۹۰۱) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ مَکْحُولٍ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ؛ أَنَّہُ أَوْتَرَ بِثَلاَثِ رَکَعَاتٍ، لَمْ یَفْصِلْ بَیْنَہُنَّ بِسَلاَمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 6901","","","كتاب الجمعة"
"6902","(۶۹۰۲) حَدَّثَنَا ہُشَیْمٌ، عَنِ الْعَوَّامِ، قَالَ: حُدِّثْنَا عَنْ إِبْرَاہِیمَ التَّیْمِیِّ، قَالَ: کَانُوا یَکْرَہُونَ أَنْ یُشَبِّہُوا الْوِتْرَ بِالْمَغْرِبِ۔","","Musannaf Ibn Abi Shaybah 6902","","","كتاب الجمعة"
"6903","(۶۹۰۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُوتِرُونَ بِإِحْدَی عَشْرَۃَ ، وَبِتِسْعٍ ، وَبِسَبْعٍ ، وَبِخَمْسٍ ، وَکَانَ یُقَالُ : لاَ وِتْرَ بِأَقَلَّ مِنْ ثَلاَثٍ۔","","Musannaf Ibn Abi Shaybah 6903","","","كتاب الجمعة"
"6904","(۶۹۰۴) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : أَجْمَعَ الْمُسْلِمُونَ عَلَی أَنَّ الْوِتْرَ ثَلاَثٌ ، لاَ یُسَلِّمُ إِلاَّ فِی آخِرِہِنَّ۔","","Musannaf Ibn Abi Shaybah 6904","","","كتاب الجمعة"
"6905","(۶۹۰۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ إِسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ یُوتِرُ بِثَلاَثٍ ، وَیَقْنُتُ فِی الْوِتْرِ قَبْلَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 6905","","","كتاب الجمعة"
"6906","(۶۹۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یُوتِرُ بِثَلاَثٍ ، لاَ یُسَلِّمُ إِلاَّ فِی آخِرِہِنَّ۔","","Musannaf Ibn Abi Shaybah 6906","","","كتاب الجمعة"
"6907","(۶۹۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ یُسَلَّمُ فِی الرَّکْعَتَیْنِ مِنَ الْوِتْرِ۔","","Musannaf Ibn Abi Shaybah 6907","","","كتاب الجمعة"
"6908","(۶۹۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، قَالَ : نَہَانِی إِبْرَاہِیمُ أَنْ أُسَلِّمَ فِی الرَّکْعَتَیْنِ مِنَ الْوِتْرِ۔","","Musannaf Ibn Abi Shaybah 6908","","","كتاب الجمعة"
"6909","(۶۹۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ زِیَادِ بْنِ أَبِی مُسْلِمٍ ، قَالَ : سَأَلْتُ أَبَا الْعَالِیَۃِ ، وَخِلاَسًا عَنِ الْوِتْرِ ؟ فَقَالاَ : اَصْنَعُ فِیہِ کَمَا تَصْنَعُ فِی الْمَغْرِبِ۔","","Musannaf Ibn Abi Shaybah 6909","","","كتاب الجمعة"
"6910","(۶۹۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ أَوْتَرَ بِثَلاَثٍ ، لَمْ یُسَلِّمْ إِلاَّ فِی آخِرِہِنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 6910","","","كتاب الجمعة"
"6911","(۶۹۱۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ أَصْحَابُ عَلِیٍّ ، وَأَصْحَابُ عَبْدِ اللہِ لاَ یُسَلِّمُونَ فِی رَکْعَتَیِ الْوِتْرِ۔","","Musannaf Ibn Abi Shaybah 6911","","","كتاب الجمعة"
"6912","(۶۹۱۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ زُرَارَۃَ ، عَنْ سَعدِ بْنِ ہِشَامٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یُسَلِّمُ فِی رَکْعَتَیِ الْوِتْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 6912","","","كتاب الجمعة"
"6913","(۶۹۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ مَوْلَی آلِ طَلْحَۃَ ، عَنْ أَبِی سَلَمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُوتِرُ بِثَلاَثٍ۔","","Musannaf Ibn Abi Shaybah 6913","","","كتاب الجمعة"
"6914","(۶۹۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ سَالِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ زَاذَانَ ؛ أَنَّ عَلِیًّا کَانَ یُوتِرُ بِثَلاَثٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6914","","","كتاب الجمعة"
"6915","(۶۹۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، وَشُعْبَۃَ ، عَنْ عُمَر بْنِ مُرَّۃ ، عَنْ أَبِی عُبَیْدَۃ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہ کَانَ یُوتِرُ بِثَلاَثٍ مِنْ آخِرِ اللَّیْلِ ، قَاعِدًا۔","","Musannaf Ibn Abi Shaybah 6915","","","كتاب الجمعة"
"6916","(۶۹۱۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَطَائِ بْنِ یَزِیدَ اللَّیْثِیِّ ، عَنْ أَبِی أَیُّوبَ ، قَالَ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْتِرْ بِخَمْسٍ ، فَإِنْ لَمْ تَسْتَطِعْ فَبِثَلاَثٍ ، فَإِنْ لَمْ تَسْتَطِعْ فَبِوَاحِدَۃٍ ، فَإِنْ لَمْ تَسْتَطِعْ فَأَوْمِئْ إِیمَائً۔ (احمد ۴۱۸۔ دارمی ۱۵۸۲)","Da'if","Musannaf Ibn Abi Shaybah 6916","","","كتاب الجمعة"
"6917","(۶۹۱۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَطَائِ بْنِ یَزِیدَ ، عَنْ أَبِی أَیُّوبَ ؛ نَحْوَہُ ، وَلَمْ یَرْفَعْہُ۔ (نسائی ۱۴۰۲۔ طحاوی ۲۹۱)","Sahih","Musannaf Ibn Abi Shaybah 6917","","","كتاب الجمعة"
"6918","(۶۹۱۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ عَبْدِ الْحَکِیمِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : سَنَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْوِتْرَ کَمَا سَنَّ الْفِطْرَ وَالأَضْحَی۔","","Musannaf Ibn Abi Shaybah 6918","","","كتاب الجمعة"
"6919","(۶۹۱۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَۃَ ، قَالَ : قَالَ عَلِیٌّ : الْوِتْرُ لَیْسَ بِحَتْمٍ کَالصَّلاَۃ الْمَکْتُوبَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 6919","","","كتاب الجمعة"
"6920","(۶۹۲۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْوِتْرُ سُنَّۃٌ۔","","Musannaf Ibn Abi Shaybah 6920","","","كتاب الجمعة"
"6921","(۶۹۲۱) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُسْلِمٍ مَوْلًی لِعَبْدِ الْقَیْسِ ، قَالَ : قَالَ رَجُلٌ لْاِبْنِ عُمَرَ : أَرَأَیْتَ الْوِتْرَ ، سُنَّۃٌ ہُوَ ؟ قَالَ : فَقَالَ : مَا سُنَّۃٌ ؟ أَوْتَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ،وَأَوْتَرَ الْمُسْلِمُونَ ، قَالَ : لاَ، أُسُنَّۃُ ہُوَ ؟ قَالَ : مَہْ ، أَتَغْفُلُ ، أَوْتَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَوْتَرَ الْمُسْلِمُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 6921","","","كتاب الجمعة"
"6922","(۶۹۲۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، قَالَ : قیلَ لَہُ : الْوِتْرُ ، فَرِیضَۃٌ ہِیَ ؟ فَقَالَ : قَدْ أَوْتَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَثَبَتَ عَلَیْہِ الْمُسْلِمُونَ۔ (احمد ۱/۱۲۰)","","Musannaf Ibn Abi Shaybah 6922","","","كتاب الجمعة"
"6923","(۶۹۲۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، أَنَّ مُحَمَّدَ بْنَ یَحْیَی بْنِ حَبَّانَ أَخْبَرَہُ ، عَنِ ابْنِ مُحَیْرِیزٍ الْقُرَشِیِّ ، أَنَّہُ أَخْبَرَہُ ، عَنِ الْمُخْدَجِیِّ ، رَجُلٍ مِنْ بَنِی کِنَانَۃَ ، أَنَّہُ أَخْبَرَہُ ؛ أَنَّ رَجُلاً مِنَ الأَنْصَارِ کَانَ بِالشَّامِ ، یُکَنَّی : أَبَا مُحَمَّدٍ ، وَکَانَتْ لَہُ صُحْبَۃٌ ، وَکَانَ یَقُولُ : الْوِتْرُ وَاجِبٌ ، فَذَکَرَ الْمُخْدَجِیُّ أَنَّہُ رَاحَ إِلَی عُبَادَۃَ بْنِ الصَّامِتِ فَذَکَرَ ذَلِکَ لَہُ ، فَقَالَ عُبَادَۃُ : کَذَبَ أَبُو مُحَمَّدٍ ، سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، یَقُولُ : خَمْسُ صَلَوَاتٍ ، کَتَبَہُنَّ اللَّہُ عَلَی الْعِبَادِ ، مَنْ جَائَ بِہِنَّ لَمْ یُضَیِّعْ مِنْ حَقِّہِنَّ شَیْئًا ، جَائَ وَلَہُ عِنْدَ اللہِ عَہْدٌ أَنْ یُدْخِلَہُ اللَّہُ الْجَنَّۃَ ، وَمَنِ انْتَقَصَ مِنْ حَقِّہِنَّ شَیْئًا ، جَائَ وَلَیْسَ لَہُ عِنْدَ اللہِ عَہْدٌ ، إِنْ شَائَ عَذَّبَہُ ، وَإِنْ شَائَ أَدْخَلَہُ الْجَنَّۃَ۔ (ابوداؤد ۱۴۱۵۔ ابن حبان ۱۷۳۲)","Da'if","Musannaf Ibn Abi Shaybah 6923","","","كتاب الجمعة"
"6924","(۶۹۲۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ یَنْسَی الْوِتْرَ ؟ قَالَ : لاَ یَضُرُّہُ ، کَأَنَّمَا ہُوَ فَرِیضَۃٌ۔","","Musannaf Ibn Abi Shaybah 6924","","","كتاب الجمعة"
"6925","(۶۹۲۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی الْوِتْرَ فَرِیضَۃً۔","","Musannaf Ibn Abi Shaybah 6925","","","كتاب الجمعة"
"6926","(۶۹۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ ، وَمُحَمَّدِ بْنِ عَلِیٍّ ، قَالاَ : الأَضْحَی وَالْوَتْرُ سُنَّۃٌ۔","","Musannaf Ibn Abi Shaybah 6926","","","كتاب الجمعة"
"6927","(۶۹۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَاصِمٍ ، عَنْ عَلِیٍّ ، قَالَ : الْوِتْرُ لَیْسَ بِحَتْمٍ ، وَلَکِنَّہُ سَنَّہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (نسائی ۱۳۸۵۔ احمد ۱/۸۶)","Hasan","Musannaf Ibn Abi Shaybah 6927","","","كتاب الجمعة"
"6928","(۶۹۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ عَبْدِ اللہِ بْنِ رَاشِدٍ الزَّوْفِیِّ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ الزَّوْفِیِّ ، عَنْ خَارِجَۃَ بْنِ حُذَافَۃَ الْعَدَوِیِّ ، قَالَ : خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلاَۃَ الْغَدَاۃِ ، فَقَالَ : لَقَدْ أَمَدَّکُمُ اللَّہُ اللَّیْلَۃَ بِصَلاَۃٍ ، ہِیَ خَیْرٌ لَکُمْ مِنْ حُمْرِ النَّعَمِ ۔ قَالَ : قُلْنَا: وَمَا ہِیَ یَا رَسُولَ اللہِ ؟ قَالَ : الْوِتْرُ ، فِیمَا بَیْنَ صَلاَۃِ الْعِشَائِ إِلَی طُلُوعِ الْفَجْرِ۔(ترمذی ۴۵۲۔ ابوداؤد ۱۴۱۳)","Da'if","Musannaf Ibn Abi Shaybah 6928","","","كتاب الجمعة"
"6929","(۶۹۲۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ اللَّہَ زَادَکُمْ صَلاَۃً إِلَی صَلاَتِکُمْ ، وَہِیَ الْوِتْرُ۔ (احمد ۲/۲۰۶۔ دار قطنی ۳)","","Musannaf Ibn Abi Shaybah 6929","","","كتاب الجمعة"
"6930","(۶۹۳۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَنِ الزُّہْرِیِّ، عَنْ عَطَائِ بْنِ یَزِیدَ ، عَنْ أَبِی أَیُّوبَ ، قَالَ: الْوِتْرُ حَقٌّ ، أَوْ وَاجِبٌ۔","Sahih","Musannaf Ibn Abi Shaybah 6930","","","كتاب الجمعة"
"6931","(۶۹۳۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ مُجَاہِدٍ ، قَالَ : ہُوَ وَاجِبٌ ، وَلَم یُکْتَبْ۔","","Musannaf Ibn Abi Shaybah 6931","","","كتاب الجمعة"
"6932","(۶۹۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ خَلِیلِ بْنِ مُرَّۃَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ لَمْ یُوتِرْ فَلَیْسَ مِنَّا۔ (احمد ۲/۴۴۳۔ راھویہ ۹۷)","Da'if","Musannaf Ibn Abi Shaybah 6932","","","كتاب الجمعة"
"6933","(۶۹۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، قَالَ : أَخْبَرَنِی مُخْبِرٌ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : مَا أُحِبُّ أَنِّی تَرَکْتُ الْوِتْرَ ، وَلَوْ أَنَّ لِی حُمْرَ النِّعَمِ۔ (عبدالرزاق ۴۵۷۸)","Da'if","Musannaf Ibn Abi Shaybah 6933","","","كتاب الجمعة"
"6934","(۶۹۳۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : حدَّثَنَا أَبُو الْمُنِیبِ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْوِتْرُ حَقٌّ ، فَمَنْ لَمْ یُوتِرْ فَلَیْسَ مِنَّا۔ (ابوداؤد ۱۴۱۴۔ احمد ۵/۳۵۷)","Da'if","Musannaf Ibn Abi Shaybah 6934","","","كتاب الجمعة"
"6935","(۶۹۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ اللَّہَ وِتْرٌ ، یُحِبُّ الْوِتْرَ۔ (بخاری ۶۴۱۰۔ مسلم ۲۰۶۲)","Sahih","Musannaf Ibn Abi Shaybah 6935","","","كتاب الجمعة"
"6936","(۶۹۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ وَہِشَامٌ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : أَوْتَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلَیْسَ عَلَیْک ، قُلْتُ : لِمَنْ ؟ قَالَ : إِنَّمَا قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْتِرُوا یَا أَہْلَ الْقُرْآنِ۔ (ترمذی ۴۵۳۔ ابوداؤد ۱۴۱۱)","","Musannaf Ibn Abi Shaybah 6936","","","كتاب الجمعة"
"6937","(۶۹۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو سِنَانٍ سَعِیدُ بْنُ سِنَانٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوْتِرُوا یَا أَہْلَ الْقُرْآنِ ، فَإِنَّ اللَّہَ وِتْرٌ یُحِبُّ الْوِتْرَ ۔ فَقَالَ أَعْرَابِیٌّ : مَا یَقُولُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : إِنَّہَا لَیْسَتْ لَکَ ، وَلاَ لأَصْحَابِک۔ (عبدالرزاق ۴۵۷۱)","","Musannaf Ibn Abi Shaybah 6937","","","كتاب الجمعة"
"6938","(۶۹۳۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا جُوَیْبِرٌ ، عَنِ الضَّحَّاکِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ اللَّہَ وِتْرٌ ، یُحِبُّ الْوِتْرَ ، فَأَوْتِرُوا یَا أَہْلَ الْقُرْآنِ۔","Da'if","Musannaf Ibn Abi Shaybah 6938","","","كتاب الجمعة"
"6939","(۶۹۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عِمْرَانَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : إِنَّمَا الْوِتْرُ عَلَی أَہْلِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 6939","","","كتاب الجمعة"
"6940","(۶۹۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَمَّارِ بْنِ مُعَاوِیَۃَ الدَّہْنِیِّ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ حُذَیْفَۃَ ، قَالَ : إِنَّمَا الْوِتْرُ عَلَی أَہْلِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 6940","","","كتاب الجمعة"
"6941","(۶۹۴۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاہِیمَ، قَالَ: کَانَ یُقَالُ: إِنَّمَا الْوِتْرُ عَلَی أَہْلِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 6941","","","كتاب الجمعة"
"6942","(۶۹۴۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّمَا الْوِتْرُ عَلَی أَہْلِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 6942","","","كتاب الجمعة"
"6943","(۶۹۴۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ ، عَنْ زُبَیْدٍ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْرَأُ فِی وِتْرِہِ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ} فَإِذَا سَلَّمَ ، قَالَ : سُبْحَانَ الْمَلِکِ الْقُدُّوسِ ، ثَلاَثَ مَرَّاتٍ۔(نسائی ۱۰۵۸۰۔ احمد ۳/۴۰۷)","Sahih","Musannaf Ibn Abi Shaybah 6943","","","كتاب الجمعة"
"6944","(۶۹۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زُبَیْدٍ ، عَنْ ذِرٍّ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُوتِرُ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ} وَیَقُولُ فِی آخِرِ صَلاَتِہِ إِذَا جَلَسَ : سُبْحَانَ الْمَلِکِ الْقُدُّوسِ ،ثَلاَثًا ، یَمُدُّ بِہَا صَوْتَہُ فِی الآخِرَۃِ۔ (نسائی ۱۴۳۰۔ احمد ۳/۴۰۷)","Sahih","Musannaf Ibn Abi Shaybah 6944","","","كتاب الجمعة"
"6945","(۶۹۴۵) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃٌ ، عَنْ قَتَادَۃَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُوتِرُ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی}۔ (نسائی ۱۷۴۳)","Sahih","Musannaf Ibn Abi Shaybah 6945","","","كتاب الجمعة"
"6946","(۶۹۴۶) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ، عَنْ أَنَسِ بْنِ سِیرِینَ، عَنْ عُمَرَ؛ کَانَ یَقْرَأُ بِالْمُعَوِّذَتَیْنِ فِی الْوِتْرِ۔","","Musannaf Ibn Abi Shaybah 6946","","","كتاب الجمعة"
"6947","(۶۹۴۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ یُوتِرُ بِثَلاَثٍ ، یَقْرَأُ فِی کُلِّ رَکْعَۃٍ مِنْہُنَّ بِثَلاَثِ سُوَرٍ ، مِنْ آخِرِ الْمُفَصَّلِ ، مِنْ تَأْلِیفِ عَبْدِ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 6947","","","كتاب الجمعة"
"6948","(۶۹۴۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ بْنُ أَبِی سُلَیْمَانَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ زَاذَانَ ؛ أَنَّ عَلِیًّا کَانَ یَفْعَلُ ذَلِکَ أَیْضًا۔","Hasan","Musannaf Ibn Abi Shaybah 6948","","","كتاب الجمعة"
"6949","(۶۹۴۹) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: کَانَ یَقْرَأُ فِی الْوِتْرِ بِثَلاَثٍ۔","Sahih","Musannaf Ibn Abi Shaybah 6949","","","كتاب الجمعة"
"6950","(۶۹۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یُوتِرُ بِثَلاَثٍ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","Sahih","Musannaf Ibn Abi Shaybah 6950","","","كتاب الجمعة"
"6951","(۶۹۵۱) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا یُونُسُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُوتِرُ بِثَلاَثٍ ، یَقْرَأُ فِیہِنَّ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔ (ترمذی ۴۶۲۔ احمد ۲۹۹)","Sahih","Musannaf Ibn Abi Shaybah 6951","","","كتاب الجمعة"
"6952","(۶۹۵۲) حَدَّثَنَا شاَذَانُ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ مُخَوَّلٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِنَحْوِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 6952","","","كتاب الجمعة"
"6953","(۶۹۵۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ عُثْمَانُ یَقْرَأُ الْقُرْآنَ کُلَّہُ ، یُوتِرُ بِہِ۔","","Musannaf Ibn Abi Shaybah 6953","","","كتاب الجمعة"
"6954","(۶۹۵۴) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجِ بْنِ دِینَارٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ ، مَا یَقْرَأُ فِی الرَّکْعَتَیْنِ مِنَ الْوِتْرِ ؟ قَالَ : لَیْسَ شَیْئٌ مِنَ الْقُرْآنِ مَہْجُورًا ، فَاقْرَأْ بِمَا شِئْتَ۔","","Musannaf Ibn Abi Shaybah 6954","","","كتاب الجمعة"
"6955","(۶۹۵۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عُیَیْنَۃُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ نَافِعٍ ، عَنْ ابْنِ عُمَرٍ ؛ أَنَّہُ کَانَ یَقْرَأُ فِی وِتْرِہِ مِنْ آخِرِ حِزْبِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 6955","","","كتاب الجمعة"
"6956","(۶۹۵۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : أَقْرَأُ فِی وَتْرِی مِنْ آخِرِ حِزْبِی {آمَنَ الرَّسُولُ بِمَا أُنْزِلَ إِلَیْہِ مِنْ رَّبِّہِ} إِلَی آخِرِ السُّورَۃِ ؟ قَالَ : نَعَمْ ، إِنْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 6956","","","كتاب الجمعة"
"6957","(۶۹۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : اِقْرَأْ فِی الْوِتْرِ بِالْمُعَوِّذَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 6957","","","كتاب الجمعة"
"6958","(۶۹۵۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : وَدِدْتُ أَنِّی أَقْدِرُ أَنْ أُوتِرَ بِالْبَقَرَۃِ۔","","Musannaf Ibn Abi Shaybah 6958","","","كتاب الجمعة"
"6959","(۶۹۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحِلٍّ ، عَنْ إِبْرَاہِیمَ ، قَالَ : اِقْرَأْ فِی الرَّکْعَتَیْنِ الأُولَیَیْنِ مِنَ الْوِتْرِ بِسُورَتَیْنِ ، وَفِی الآخِرَۃِ : {آمَنَ الرَّسُولُ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ}۔","","Musannaf Ibn Abi Shaybah 6959","","","كتاب الجمعة"
"6960","(۶۹۶۰) حَدَّثَنَا مُحَمَّدُ بْنِ أَبِی عُبَیْدَۃ ، قَالَ : حدَّثَنِی أَبِی ، عَنِ الأَعْمَشِ ، عَنْ طَلْحَۃَ ، عَنْ ذَِرٍّ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ، عَنْ أُبَیِّ بْنِ کَعْبٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُوتِرُ بِـ : {سَبِّحِ اسْمَ رَبِّکَ الأَعْلَی} ، وَ{قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، وَ{قُلْ ہُوَ اللَّہُ أَحَدٌ} ، وَیَقُولُ فِی آخِرِ صَلاَتِہِ : سُبْحَانَ الْمَلِکِ الْقُدُّوسِ ، ثَلاَثًا۔ (ابوداؤد ۱۴۱۸۔ ابن حبان ۲۴۳۶)","Sahih","Musannaf Ibn Abi Shaybah 6960","","","كتاب الجمعة"
"6961","(۶۹۶۱) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ بُرَیْدِ بْنِ أَبِی مَرْیَمَ ، عْن أَبِی الْحَوْرَائِ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ ، قَالَ : عَلَّمَنِی جَدِّی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَلِمَاتٍ أَقُولُہُنَّ فِی قُنُوتِ الْوِتْرِ : اللَّہُمَّ اہْدِنِی فِیمَنْ ہَدَیْتَ ، وَعَافِنِی فِیمَنْ عَافَیْتَ ، وَتَوَلَّنِی فِیمَنْ تَوَلَّیْتَ ، وَبَارِکْ لِی فِیمَا أَعْطَیْتَ ، وَقِنِی شَرَّ مَا قَضَیْتَ ، فَإِنَّک تَقْضِی وَلاَ یُقْضَی عَلَیْکَ، إِنَّہُ لاَ یَذِلُّ مَنْ وَالَیْتَ، تَبَارَکْتَ رَبَّنَا وَتَعَالَیْتَ۔ (ابن ماجہ ۱۱۷۸۔ ابو یعلی ۶۷۶۵)","Sahih","Musannaf Ibn Abi Shaybah 6961","","","كتاب الجمعة"
"6962","(۶۹۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَارُونَ بْنِ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَقُولُ فِی قُنُوتِ الْوِتْرِ : لَکَ الْحَمْدُ مِلْئَ السَّمَاوَاتِ السَّبْعِ ، وَمِلْئَ الأَرْضِینَ السَّبْعِ ، وَمِلْئَ مَا بَیْنَہُمَا مِنْ شَیْئٍ بَعْدُ، أَہْلَ الثَّنَائِ وَالْمَجْدِ ، حَقَّ مَا قَالَ الْعَبْدُ ، کُلُّنَا لَکَ عَبْدٌ ، لاَ مَانِعَ لِمَا أَعْطَیْتَ ، وَلاَ مُعْطِیَ لِمَا مَنَعْتَ ، وَلاَ یَنْفَعُ ذَا الْجَدِّ مِِنْکَ الْجَدُّ۔","Sahih","Musannaf Ibn Abi Shaybah 6962","","","كتاب الجمعة"
"6963","(۶۹۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مَنْصُورٍ ، عَنْ شَیْخٍ ، یُکَنَّی : أَبَا مُحَمَّدٍ ؛ أَنَّ الْحُسَیْنَ بْنَ عَلِیٍّ کَانَ یَقُولُ فِی قُنُوتِ الْوِتْرِ : اللَّہُمَّ إِنَّکَ تَرَی وَلاَ تُرَی ، وَأَنْتَ بِالْمَنْظَرِ الأَعْلَی ، وَإِنَّ إِلَیْکَ الرُّجْعَی ، وَإِنَّ لَکَ الآخِرَۃَ وَالأُولَی ، اللَّہُمَّ إِنَّا نَعُوذُ بِکَ أَنْ نَذِلَّ وَنَخْزَی۔","Da'if","Musannaf Ibn Abi Shaybah 6963","","","كتاب الجمعة"
"6964","(۶۹۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قُلْ فِی قُنُوتِ الْوِتْرِ : اللَّہُمَّ إِنَّا نَسْتَعِینُکَ وَنَسْتَغْفِرُکَ۔","","Musannaf Ibn Abi Shaybah 6964","","","كتاب الجمعة"
"6965","(۶۹۶۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : عَلَّمَنَا ابْنُ مَسْعُودٍ أَنْ نَقْرَأَ فِی الْقُنُوتِ : اللَّہُمَّ إِنَّا نَسْتَعِینُکَ وَنَسْتَغْفِرُکَ ، وَنُثْنِی عَلَیْکَ الْخَیْرَ ، وَلاَ نَکْفُرُکَ ، وَنَخْلَعُ وَنَتْرُکُ مَنْ یَفْجُرُکَ ، اللَّہُمَّ إِیَّاکَ نَعْبُدُ ، وَلَکَ نُصَلِّی وَنَسْجُدُ ، وَإِلَیْکَ نَسْعَی وَنَحْفِدُ ، نَرْجُو رَحْمَتَکَ وَنَخْشَی عَذَابَکَ ، إِنَّ عَذَابَکَ الْجِدَّ بِالْکُفَّارِ مُلْحِقٌ۔","Da'if","Musannaf Ibn Abi Shaybah 6965","","","كتاب الجمعة"
"6966","(۶۹۶۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَیْسَ فِی قُنُوتِ الْوِتْرِ شَیْئٌ مُؤقَّتٌ ، إِنَّمَا ہُوَ دُعَائٌ وَاسْتِغْفَارٌ۔","","Musannaf Ibn Abi Shaybah 6966","","","كتاب الجمعة"
"6967","(۶۹۶۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لَیْسَ عَلَی الْمُسَافِرِ وِتْرٌ۔","","Musannaf Ibn Abi Shaybah 6967","","","كتاب الجمعة"
"6968","(۶۹۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الْوِتْرِ ؟ فَقَالَ : أَرَأَیْتَ إِنْ سَافَرْتُ ؟ قَالَ : رَکْعَۃٌ مِنْ آخِرِ اللَّیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 6968","","","كتاب الجمعة"
"6969","(۶۹۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنْ شَیْخٍ ، قَالَ : صَحِبْتُ ابْنَ عَبَّاسٍ فِی سَفَرٍ ، فَلاَ أَحْفَظُ أَنَّہُ أَوْتَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 6969","","","كتاب الجمعة"
"6970","(۶۹۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ طَارِقٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ أَوْتَرَ فِی السَّفَرِ۔","Hasan","Musannaf Ibn Abi Shaybah 6970","","","كتاب الجمعة"
"6971","(۶۹۷۱) حَدَّثَنَا وَکِیعٌ، عَنْ إِسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، عَنِ ابْنِ عُمَرَ، وَابْنِ عَبَّاسٍ، قَالَ: الْوِتْرُ فِی السَّفَرِ سُنَّۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 6971","","","كتاب الجمعة"
"6972","(۶۹۷۲) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَارِثِ الْعُکْلِیِّ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ بْنِ یَزِیدَ ؛ أَنَّ عُمَرَ قَنَتَ فِی الْوِتْرِ قَبْلَ الرُّکُوعِ۔","Sahih","Musannaf Ibn Abi Shaybah 6972","","","كتاب الجمعة"
"6973","(۶۹۷۳) حَدَّثَنَا شَرِیکٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا کَانَ یَقْنُتُ فِی الْوِتْرِ بَعْدَ الرُّکُوعِ۔","Da'if","Musannaf Ibn Abi Shaybah 6973","","","كتاب الجمعة"
"6974","(۶۹۷۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَطَائُ بْنُ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّ عَلِیًّا کَانَ یَقْنُتُ فِی الْوِتْرِ بَعْدَ الرُّکُوعِ۔","Da'if","Musannaf Ibn Abi Shaybah 6974","","","كتاب الجمعة"
"6975","(۶۹۷۵) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّ عَبْدَ اللہِ کَانَ یُوتِرُ ، فَیَقْنُتُ قَبْلَ الرُّکُوعِ۔","Da'if","Musannaf Ibn Abi Shaybah 6975","","","كتاب الجمعة"
"6976","(۶۹۷۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا لَیْثٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ لاَ یَقْنُتُ فِی شَیْئٍ مِنَ الصَّلَوَاتِ ، إِلاَّ فِی الْوِتْرِ قَبْلَ الرُّکُوعِ۔","Da'if","Musannaf Ibn Abi Shaybah 6976","","","كتاب الجمعة"
"6977","(۶۹۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ أَبِیہِ ، رَفَعَہُ ؛ أَنَّہُ کَانَ یَقْنُتُ فِی الْوِتْرِ قَبْلَ الرَّکْعَۃِ۔","","Musannaf Ibn Abi Shaybah 6977","","","كتاب الجمعة"
"6978","(۶۹۷۸) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبیدِ اللہِ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : مَرَّضْتُہُ فَأَوْتَرَ ، فَلَمَّا فَرَغَ مِنَ الْقِرَائَۃِ حَنیْتُہُ لِیَرْکَعَ ، فَلَمْ یَفْعَلْ حَتَّی قَنَتَ ، ثُمَّ رَکَعَ۔","","Musannaf Ibn Abi Shaybah 6978","","","كتاب الجمعة"
"6979","(۶۹۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ؛ أَنَّہُ کَانَ یَقْنُتُ فِی الْوِتْرِ قَبْلَ الرَّکْعَۃِ۔","","Musannaf Ibn Abi Shaybah 6979","","","كتاب الجمعة"
"6980","(۶۹۸۰) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ : الْقُنُوتُ بَعْدَ مَا یَفْرُغُ مِنَ الْقِرَائَۃِ۔","","Musannaf Ibn Abi Shaybah 6980","","","كتاب الجمعة"
"6981","(۶۹۸۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یَقُولُ فِی قُنُوتِ الْوِتْرِ : قَبْلَ الرُّکُوعِ إِذَا فَرَغَ مِنَ الْقِرَائَۃِ۔","","Musannaf Ibn Abi Shaybah 6981","","","كتاب الجمعة"
"6982","(۶۹۸۲) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ إِسْمَاعِیلَ بْنِ عَبْدِالْمَلِکِ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ؛ أَنَّہُ کَانَ یَقْنُتُ فِی الْوِتْرِ قَبْلَ الرُّکُوعِ۔","","Musannaf Ibn Abi Shaybah 6982","","","كتاب الجمعة"
"6983","(۶۹۸۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّ ابْنَ مَسْعُودٍ، وَأَصْحَابَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانُوا یَقْنُتُونَ فِی الْوِتْرِ قَبْلَ الرُّکُوعِ۔","Hasan","Musannaf Ibn Abi Shaybah 6983","","","كتاب الجمعة"
"6984","(۶۹۸۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا أَبَانُ بْنُ أَبِی عَیَّاشٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقْنُتُ فِی الْوِتْرِ قَبْلَ الرُّکُوعِ ۔ قَالَ : ثُمَّ أَرْسَلْتُ أُمِّیَ أُمَّ عَبْدٍ ، فَبَاتَتْ عِنْدَ نِسَائِہِ ، فَأَخْبَرَتْنِی أَنَّہُ قَنَتَ فِی الْوِتْرِ قَبْلَ الرُّکُوعِ۔(دارقطنی ۳۲۔ بیہقی ۴۱)","Da'if","Musannaf Ibn Abi Shaybah 6984","","","كتاب الجمعة"
"6985","(۶۹۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ أَبَانَ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ قَنَتَ قَبْلَ الرُّکُوعِ فِی الْوِتْرِ ۔ (دارقطنی۵۔ بیہقی ۴۱)","Da'if","Musannaf Ibn Abi Shaybah 6985","","","كتاب الجمعة"
"6986","(۶۹۸۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ الْقَاسِمَ عْن رَجُلٍ یُوتِرُ عَلَی رَاحِلَتِہِ ؟ فَقَالَ : زَعَمُوا أَنَّ عُمَرَ کَانَ یُوتِرُ بِالأَرْضِ۔","","Musannaf Ibn Abi Shaybah 6986","","","كتاب الجمعة"
"6987","(۶۹۸۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ عُمَرُ یُوتِرُ بِالأَرْضِ۔","","Musannaf Ibn Abi Shaybah 6987","","","كتاب الجمعة"
"6988","(۶۹۸۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ إِذَا أَرَادَ أَنْ یُوتِرَ ، نَزَلَ فَأَوْتَرَ بِالأَرْضِ۔","Sahih","Musannaf Ibn Abi Shaybah 6988","","","كتاب الجمعة"
"6989","(۶۹۸۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یُصَلُّونَ عَلَی رَوَاحِلِہِمْ وَدَوَابِّہِمْ ، حَیْثُ مَا کَانَتْ وُجُوہُہُمْ ، إِلاَّ الْمَکْتُوبَۃَ وَالْوِتْرَ ، فَإِنَّہُمْ کَانُوا یُصَلُّونَہُمَا عَلَی الأَرْضِ۔","","Musannaf Ibn Abi Shaybah 6989","","","كتاب الجمعة"
"6990","(۶۹۹۰) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یُصَلِّی عَلَی رَاحِلَتِہِ حَیْثُ مَا تَوَجَّہَتْ بِہِ ، فَإِذَا أَرَادَ أَنْ یُوتِرَ نَزَلَ۔","","Musannaf Ibn Abi Shaybah 6990","","","كتاب الجمعة"
"6991","(۶۹۹۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی الْہَزْہَازِ ، عَنِ الضَّحَّاکِ ، قَالَ : إِذَا أَرَادَ أَنْ یُوتِرَ ، نَزَلَ فَأَوْتَرَ۔","","Musannaf Ibn Abi Shaybah 6991","","","كتاب الجمعة"
"6992","(۶۹۹۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ ہَارُونَ بْنِ إِبْرَاہِیمَ ، قَالَ : سَأَلْتُ الْحَسَنَ ، قُلْتُ: أُصَلِّی عَلَی دَابَّتِی؟ فَقَالَ: صَلِّ عَلَیْہَا ، قُلْتُ : أُوتِرُ عَلَی دَابَّتِی ؟ قَالَ : لاَ۔ وَقَالَ ابْنُ سِیرِینَ : أَوْتِرْ بِالأَرْضِ۔","","Musannaf Ibn Abi Shaybah 6992","","","كتاب الجمعة"
"6993","(۶۹۹۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ صَلَّی عَلَی رَاحِلَتِہِ ، فَأَوْتَرَ عَلَیْہَا ، وَقَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَفْعَلُہُ۔ (بخاری ۱۰۹۵۔ احمد ۲/۱۳)","Hasan","Musannaf Ibn Abi Shaybah 6993","","","كتاب الجمعة"
"6994","(۶۹۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ثُوَیْرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا کَانَ یُوتِرُ عَلَی رَاحِلَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 6994","","","كتاب الجمعة"
"6995","(۶۹۹۵) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ أَوْتَرَ ، وَقَالَ : الْوِتْرُ عَلَی الرَّاحِلَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 6995","","","كتاب الجمعة"
"6996","(۶۹۹۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُمَرَ بْنِ نَافِعٍ ؛ أَنَّ أَبَاہُ کَانَ یُوتِرُ عَلَی الْبَعِیرِ۔","","Musannaf Ibn Abi Shaybah 6996","","","كتاب الجمعة"
"6997","(۶۹۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ، قَالَ: کَانَ الْحَسَنُ لاَ یَرَی بَأْسًا أَنْ یُوتِرَ الرَّجُلُ عَلَی رَاحِلتِہِ۔","","Musannaf Ibn Abi Shaybah 6997","","","كتاب الجمعة"
"6998","(۶۹۹۸) حَدَّثَنَا عَمْرُو بْنُ مُحَمَّدٍ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ مُوسَی بْنِ عُقْبَۃَ ، قَالَ : صَحِبْتُ سَالِمًا ، فَتَخَلَّفْتُ عَنْہُ بِالطَّرِیقِ ، فَقَالَ : مَا خَلَّفَکَ ؟ قَالَ : قُلْتُ : أَوْتَرْتُ ، قَالَ : فَہَلاَّ أَوْتَرْتَ عَلَی رَاحِلَتِکَ ؟۔","","Musannaf Ibn Abi Shaybah 6998","","","كتاب الجمعة"
"6999","(۶۹۹۹) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّ رَجُلاً سَأَلَہُ عَنِ الرَّجُلِ یُوتِرُ ، ثُمَّ یُصَلِّی ؟ فَقَالَ : یَنَامُ ، ثُمَّ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 6999","","","كتاب الجمعة"
"7000","(۷۰۰۰) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ أَنْ یُوتِرَ ، ثُمَّ یُصَلِّیَ عَلَی إِثْرِ وِتْرِہِ۔","","Musannaf Ibn Abi Shaybah 7000","","","كتاب الجمعة"
"7001","(۷۰۰۱) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا بْنِ سَلاَّمٍ ، عَنِ الْعَلاَئِ بْنِ بَدْرٍ ؛ أَنَّ سَعْدًا کَانَ یُوتِرُ ، ثُمَّ یُصَلِّی۔","","Musannaf Ibn Abi Shaybah 7001","","","كتاب الجمعة"
"7002","(۷۰۰۲) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ الضَّجْعَۃَ بَیْنَ الْوِتْرِ وَبَیْنَ الرَّکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7002","","","كتاب الجمعة"
"7003","(۷۰۰۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، وَجَہْمٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الَّذِی یَشُکُّ فِی وِتْرِہِ ، قَالَ : یَشْفَعُ بِرَکْعَۃٍ ، وَیَسْتَقْبِلُ الْوِتْرَ۔","","Musannaf Ibn Abi Shaybah 7003","","","كتاب الجمعة"
"7004","(۷۰۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، قَالَ : سَأَلْتُہُ عَنِ الرَّجُلِ یَشُکُّ فِی الرَّکْعَۃِ مِنَ الْوِتْرِ ، أَیَسْتَقْبِلُ أَمْ لاَ ؟ قَالَ : لاَ ، وَلَکِنْ یَقْضِی الرَّکْعَۃَ ، وَیَسْجُدُ سَجْدَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 7004","","","كتاب الجمعة"
"7005","(۷۰۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ لاَ یَقْنُتُ إِلاَّ فِی النِّصْفِ۔ یَعْنِی مِنْ رَمَضَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 7005","","","كتاب الجمعة"
"7006","(۷۰۰۶) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ بِنَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 7006","","","كتاب الجمعة"
"7007","(۷۰۰۷) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ؛ أَنَّہُ کَانَ یَقْنُتُ فِی النِّصْفِ مِنْ رَمَضَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 7007","","","كتاب الجمعة"
"7008","(۷۰۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ أَنَّ أُبَیًّا أَمَّ النَّاسَ فِی خِلاَفَۃِ عُمَرَ، فَصَلَّی بِہِمُ النِّصْفَ مِنْ رَمَضَانَ لاَ یَقْنُتُ ، فَلَمَّا مَضَی النِّصْفُ قَنَتَ بَعْدَ الرُّکُوعِ ، فَلَمَّا دَخَلَتِ الْعَشْرُ أَبَقَ وَخَلاَ عَنْہُمْ ، فَصَلَّی بِہِمُ الْعَشْرَ مُعَاذٌ الْقَارِیئُ فِی خِلاَفَۃِ عُمَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 7008","","","كتاب الجمعة"
"7009","(۷۰۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الْقُنُوتُ فِی شَہْرِ رَمَضَانَ ؟ قَالَ : عُمَرُ أَوَّلُ مَنْ قَنَتَ ، قُلْتُ : النِّصْفُ الآخَرُ أَجْمَعُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 7009","","","كتاب الجمعة"
"7010","(۷۰۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبَّادِ بْنِ رَاشِدٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَقْنُتُ فِی النِّصْفِ مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7010","","","كتاب الجمعة"
"7011","(۷۰۱۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْمُہَلَّبِ بْنِ أَبِی حَبِیبَۃَ ، قَالَ : سَأَلْت سَعِیدَ بْنَ أَبِی الْحَسَنِ عَنِ الْقُنُوتِ ؟ فَقَالَ : فِی النِّصْفِ مِنْ رَمَضَانَ ، کَذَلِکَ عُلِّمْنَا۔","","Musannaf Ibn Abi Shaybah 7011","","","كتاب الجمعة"
"7012","(۷۰۱۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی ، قَالَ : کَانَ یُصَلِّی وَلاَ یَقْنُتُ فِی الْوِتْرِ حَتَّی النِّصْفِ ۔ یَعْنِی مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7012","","","كتاب الجمعة"
"7013","(۷۰۱۳) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَقُولُ : الْقُنُوتُ فِی السَّنَۃِ کُلِّہَا ۔ قَالَ : وَکَانَ ابْنُ سِیرِینَ لاَ یَرَاہُ إِلاَّ فِی النِّصْفِ مِنْ رَمَضَانَ۔","","Musannaf Ibn Abi Shaybah 7013","","","كتاب الجمعة"
"7014","(۷۰۱۴) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ؛ أَنَّ عُمَرَ حَیْثُ أَمَرَ أُبَیًّا أَنْ یُصَلِّیَ بِالنَّاسِ فِی رَمَضَانَ، وَأَمَرَہُ أَنْ یَقْنُتَ بِہِمْ فِی النِّصْفِ الْبَاقِی لَیْلَۃَ سِتَّ عَشْرَۃَ ۔n قَالَ : وَکَانَ الْحَسَنُ یَقُولُ : إِذَا کَانَ إِمَامًا قَنَتَ فِی النِّصْفِ ، وَإِذَا لَمْ یَکُنْ إِمَامًا قَنَتَ الشَّہْرَ کُلَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 7014","","","كتاب الجمعة"
