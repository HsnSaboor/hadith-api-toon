hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4201","4199  -  حَدَّثَنَا  الْمُقَدَّمُ بْنُ دَاوُدَ  ، ثَنَا  أَبُو الْأَسْوَدِ النَّضْرُ بْنُ عَبْدِ الْجَبَّارِ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُوسَى بْنِ جُبَيْرٍ ، أَنَّ عَبْدَ اللهِ بْنَ عَيَّاشٍ ،  حَدَّثَهُ  عَنْ  خَالِدِ بْنِ يَزِيدَ بْنِ مُعَاوِيَةَ ،  عَنْ  دِحْيَةَ الْكَلْبِيِّ ، قَالَ :  أَخَذَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  قَبَاطِيَّ  فَأَعْطَانِي  قُبْطِيَّةً  فَقَالَ :  اصْدَعْهَا  صَدْعَتَيْنِ فَاقْطَعْ أَحَدَهُمَا قَمِيصًا وَأَعْطِ الْآخَرَ امْرَأَتَكَ لِتَخْتَمِرَ بِهَا ، فَلَمَّا أَدْبَرْتُ قَالَ :  مُرِ امْرَأَتَكَ أَنْ تَجْعَلَ تَحْتَ صَدْعَتِهَا ثَوْبًا لَا تَصِفُهَا  .","","Al-Mu'jam al-Kabir 4199","","دحية بن خليفة الكلبي عن خالد بن يزيد الأموي عن عبد الله بن عياش عن موسى بن جبير الأنصاري عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن المقدام بن داود الرعيني عن الطبراني","دحية بن خليفة الكلبي"
"4202","4200  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ         [4/226]      حُمَيْدٍ الرَّازِيُّ ،  ثَنَا  يَحْيَى بْنُ الضُّرَيْسِ ،  عَنْ  عَنْبَسَةَ بْنِ سَعِيدٍ ،  عَنْ  جَابِرٍ ،  عَنْ  عَامِرٍ ،  عَنْ  دِحْيَةَ الْكَلْبِيِّ ، قَالَ :  أَهْدَيْتُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ جُبَّةَ صُوفٍ وَخُفَّيْنِ فَلَبِسَهُمَا حَتَّى تَخَرَّقَا وَلَمْ يَسْأَلْ عَنْهُمَا ذَكَّيْنَاهُمَا أَمْ لَا  .","","Al-Mu'jam al-Kabir 4200","","دحية بن خليفة الكلبي عن الشعبي عن جابر الجعفي عن عنبسة بن سعيد بن الضريس عن يحيى بن الضريس عن محمد بن حميد الرازي عن محمد بن يحيى بن مندة عن الطبراني","دحية بن خليفة الكلبي"
"4203","408 -  دَغْفَلُ بْنُ حَنْظَلَةَ  4201  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ  عَنْ  أَبِي هِلَالٍ الرَّاسِبِيِّ ،  ثَنَا  عَبْدُ اللهِ بْنُ بُرَيْدَةَ ،  أَنَّ  مُعَاوِيَةَ رَضِيَ اللهُ عَنْهُ أَرْسَلَ إِلَى  دَغْفَلٍ  فَسَأَلَهُ عَنِ الْعَرَبِيَّةِ وَعَنْ أَنْسَابِ النَّاسِ  ، وَسَأَلَهُ عَنِ النُّجُومِ ، فَإِذَا عَالِمٌ فَقَالَ : يَا  دَغْفَلُ  مِنْ أَيْنَ حَفِظْتَ هَذَا ؟ فَقَالَ : حَفِظْتُ هَذَا بِلِسَانٍ سَئُولٍ وَقَلْبٍ عَقُولٍ ، وَإِنَّ آفَةَ الْعِلْمِ النِّسْيَانُ ، قَالَ : فَاذْهَبْ  بِيَزِيدَ  فَعَلِّمْهُ الْعَرَبِيَّةَ وَأَنْسَابَ  قُرَيْشٍ  وَالنُّجُومَ  .","","Al-Mu'jam al-Kabir 4201","","معاوية بن أبي سفيان عن عبد الله بن بريدة عن محمد بن سليم الراسبي عن شيبان بن فروخ الحبطي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","دغفل بن حنظلة"
"4204","4202  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ، (  ح  )  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، وَمُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ، قَالُوا :  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  دَغْفَلِ بْنِ حَنْظَلَةَ ، قَالَ :  تُوُفِّيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ ابْنُ خَمْسٍ وَسِتِّينَ سَنَةً  .","","Al-Mu'jam al-Kabir 4202","","دغفل بن حنظلة السدوسي عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","دغفل بن حنظلة"
"4205","4203  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ، وَجَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ، قَالَا :  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ، (  ح  )         [4/227]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو هِشَامٍ الرِّفَاعِيُّ ، قَالَا :  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ  ، عَنْ  دَغْفَلِ بْنِ حَنْظَلَةَ ، قَالَ :  كَانَ عَلَى النَّصَارَى صَوْمُ شَهْرِ رَمَضَانَ فَكَانَ عَلَيْهِمْ  مَلِكٌ  فَمَرِضَ ، فَقَالَ : لَئِنْ شَفَاهُ اللهُ لَيَزِيدَنَّ عَشْرًا  ، ثُمَّ كَانَ عَلَيْهِمْ  مَلِكٌ  بَعْدَهُ ، فَأَكَلَ اللَّحْمَ فَوَجِعَ ، فَقَالَ : لَئِنْ شَفَاهُ اللهُ لَيَزِيدَنَّ ثَمَانِيَةَ أَيَّامٍ ، ثُمَّ كَانَ  مَلِكٌ  بَعْدَهُ ، فَقَالَ : مَا نَدَعُ مِنْ هَذِهِ الْأَيَّامِ أَنْ نُتِمَّهَا وَنَجْعَلُ صَوْمَنَا فِي الرَّبِيعِ ، فَفَعَلَ فَصَارَتْ خَمْسِينَ يَوْمًا  .","","Al-Mu'jam al-Kabir 4203","","دغفل بن حنظلة السدوسي عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","دغفل بن حنظلة"
"4206","409 -  دَيْلَمُ بْنُ فَيْرُوزَ الْحِمْيَرِيُّ  4204  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْحَسَنِ الْمِصْرِيُّ  ، ثَنَا  أَبُو عَاصِمٍ ، (  ح  )  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  أَحْمَدُ بْنُ حَنْبَلٍ ، قَالَا :  ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ الْحَنَفِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ،  أَخْبَرَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ، أَنَّ دَيْلَمَ الْحِمْيَرِيَّ  أَخْبَرَهُمْ  أَنَّهُ سَأَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ إِنَّا بِبَلَدٍ بَارِدٍ ، وَإِنَّا نَشْرَبُ شَرَابًا نَتَقَوَّى بِهِ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فَهَلْ يُسْكِرُ ؟ قَالَ : نَعَمْ ، قَالَ : فَلَا تَقْرَبُوهُ ، ثُمَّ أَعَادَ عَلَيْهِ الْمَسْأَلَةَ ، فَقَالَ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : يُسْكِرُ ؟ فَقَالَ : نَعَمْ ، فَقَالَ : لَا تَقْرَبُوهُ ، قَالَ :  فَإِنَّهُمْ لَنْ يَصْبِرُوا عَنْهُ قَالَ : فَمَنْ لَمْ يَصْبِرْ عَنْهُ فَاقْتُلُوهُ  .","","Al-Mu'jam al-Kabir 4204","","ديلم بن أبي ديلم الجيشاني عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عبد الحميد بن جعفر الأوسي عن عبيد الله بن عبد المجيد الحنفي عن أحمد بن حنبل عن موسى بن هارون الحمال عن الطبراني","ديلم بن فيروز الحميري"
"4207","4205  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  هَنَّادُ بْنُ السَّرِيِّ ، وَأَبُو كُرَيْبٍ ، قَالَا :  حَدَّثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ،  عَنْ  دَيْلَمٍ الْحِمْيَرِيِّ ، قَالَ :  سَأَلْتُ رَسُولَ اللهِ         [4/228]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ : يَا رَسُولَ اللهِ شَرَابًا مِنْ هَذَا  الْقَمْحِ  نَتَقَوَّى بِهِ عَلَى أَعْمَالِنَا وَعَلَى بَرْدِ بِلَادِنَا ، قَالَ : هَلْ يُسْكِرُ ؟ قُلْتُ : نَعَمْ ، قَالَ : فَاجْتَنِبُوهُ ، ثُمَّ جِئْتُهُ مِنْ بَيْنِ يَدَيْهِ ، فَقُلْتُ لَهُ مِثْلَ ذَلِكَ قَالَ : هَلْ يُسْكِرُ ؟ قُلْتُ : نَعَمْ ، قَالَ : فَاجْتَنِبُوهُ قُلْتُ : إِنَّ النَّاسَ غَيْرُ تَارِكِيهِ قَالَ :  فَإِنْ لَمْ يَتْرُكُوهُ فَاقْتُلُوهُمْ  .","","Al-Mu'jam al-Kabir 4205","","ديلم بن أبي ديلم الجيشاني عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن عبدة بن سليمان الكلابي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ديلم بن فيروز الحميري"
"4208","4206  -  حَدَّثَنَا  عَبْدَانُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ، وَعَيَّاشِ بْنِ عَبَّاسٍ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  دَيْلَمٍ الْجَيْشَانِيِّ ، قَالَ :  أَتَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقُلْتُ : يَا رَسُولَ اللهِ إِنَّا بِأَرْضٍ بَارِدَةٍ شَدِيدَةِ الْبَرْدِ نَصْنَعُ بِهَا شَرَابًا مِنَ  الْقَمْحِ  أَفَيَحِلُّ شُرْبُهُ ؟ قَالَ :  أَيُسْكِرُكُمْ ؟ قُلْتُ : بَلَى ، قَالَ : فَإِنَّهُ خَمْرٌ  .","","Al-Mu'jam al-Kabir 4206","","ديلم بن أبي ديلم الجيشاني عن مرثد بن عبد الله اليزني عن عياش بن عباس القتباني عن عبد الله بن لهيعة عن قتيبة بن سعيد عن عبدان بن محمد الجنوجردى عن الطبراني","ديلم بن فيروز الحميري"
"4209","410 -  دُكَيْنُ بْنُ سَعِيدٍ الْمُزَنِيُّ  4207  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ، قَالَ :  سَمِعْتُ  قَيْسًا ، يَقُولُ :  حَدَّثَنِي  دُكَيْنُ بْنُ سَعِيدٍ ، قَالَ :  أَتَيْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أَرْبَعِمِائَةِ رَاكِبٍ نَسْأَلُهُ الطَّعَامَ ، فَقَالَ : يَا  عُمَرُ  اذْهَبْ فَأَطْعِمْهُمْ وَأَعْطِهِمْ  فَقَالَ : يَا رَسُولَ اللهِ مَا عِنْدِي إِلَّا آصُعٌ مِنْ تَمْرٍ مَا يَقْتَاتُهُنَّ عِيَالِي ، فَقَالَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ : اسْمَعْ وَأَطِعْ ، فَقَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : سَمْعٌ وَطَاعَةٌ ، فَانْطَلَقَ  عُمَرُ  حَتَّى أَتَى  عِلِّيَّةً  فَأَخْرَجَ مِفْتَاحًا مِنْ  حُجْزَتِهِ  فَفَتَحَهَا ، فَقَالَ لِلْقَوْمِ : ادْخُلُوا ، فَدَخَلُوا وَكُنْتُ آخِرَ  الْقَوْمِ  دُخُولًا فَأَخَّرْتُ ثُمَّ الْتَفَتُّ فَإِذَا مِثْلُ الْفَصِيلِ مِنَ التَّمْرِ  .","","Al-Mu'jam al-Kabir 4207","","دكين بن سعيد المزني عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","دكين بن سعيد المزني"
"4210","4208  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي         [4/229]      نُمَيْرٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  دُكَيْنِ بْنِ سَعِيدٍ الْمُزَنِيِّ ، قَالَ : جِئْنَا إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَسْأَلُهُ الطَّعَامَ وَنَحْنُ أَرْبَعُمِائَةِ رَاكِبٍ ، فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 4208","","دكين بن سعيد المزني عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","دكين بن سعيد المزني"
"4211","4209  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عِقَالٍ الْحَرَّانِيُّ ،  حَدَّثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  دُكَيْنِ بْنِ سَعِيدٍ الْمُزَنِيِّ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4209","","دكين بن سعيد المزني عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن عيسى بن يونس بن أبي إسحاق عن عبد الله بن محمد النفيلي عن أحمد بن عبد الرحمن بن يزيد الحراني عن الطبراني","دكين بن سعيد المزني"
"4212","4210  -  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  دُكَيْنِ بْنِ سَعِيدٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 4210","","دكين بن سعيد المزني عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن محمد بن عبيد بن أبي أمية عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","دكين بن سعيد المزني"
"4213","411 -  دِرْهَمٌ أَبُو مُعَاوِيَةَ  4211  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ ،  عَنْ  مُعَاوِيَةَ بْنِ دِرْهَمٍ ،  أَنَّ  دِرْهَمًا جَاءَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : جِئْتُكَ أَسْتَفْتِيكَ فِي الْغَزْوِ ، قَالَ :  لَكَ أُمٌّ ؟ قَالَ : نَعَمْ ، قَالَ : فَالْزَمْهَا  .","","Al-Mu'jam al-Kabir 4211","","جاهمة بن العباس السلمي عن معاوية بن جاهمة المحاربي عن محمد بن طلحة بن عبد الله القرشي عن سليمان بن حرب الواشحي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","درهم أبو معاوية"
"4214","بَابُ الذَّالِ  مَنِ اسْمُهُ ذُؤَيْبٌ  412 -  ذُؤَيْبُ بْنُ قَبِيصَةَ الْخُزَاعِيُّ أَبُو قَبِيصَةَ بْنُ ذُؤَيْبٍ الْفَقِيهُ  4212  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الشِّبَامِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  سِنَانِ بْنِ سَلَمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  ذُؤَيْبٍ الْخُزَاعِيِّ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعَثَ مَعَهُ بِبَدَنَةٍ فَقَالَ :  إِنْ عَطِبَ مِنْهَا شَيْءٌ فَخَشِيتَ مَوْتَهَا فَانْحَرْهَا ثُمَّ اغْمِسْ نَعْلَهَا فِي دَمِهَا  ، ثُمَّ اضْرِبْ بِهَا صَفْحَتَهَا وَلَا تَطْعَمْ مِنْهَا أَنْتَ وَلَا أَحَدٌ مِنْ أَهْلِ رُفْقَتِكَ وَاقْسِمْهَا  .","","Al-Mu'jam al-Kabir 4212","","ذؤيب بن حلحلة القميري عن عبد الله بن عباس عن سنان بن سلمة بن المحبق الهذلي عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عبد الله الشبامي عن الطبراني","ذؤيب بن قبيصة الخزاعي"
"4215","[4/230]      4213  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ رُزَيْقِ بْنِ جَامِعٍ الْمِصْرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ هِشَامٍ السَّدُوسِيُّ ،  ثَنَا  خَالِدُ بْنُ الْحَارِثِ ، (  ح  )  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ، وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ، قَالُوا :  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  سِنَانِ بْنِ سَلَمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ ذُؤَيْبًا الْخُزَاعِيَّ  حَدَّثَهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَبْعَثُ مَعَهُ بِالْبُدْنِ ثُمَّ يَقُولُ :  إِنْ عَطِبَ مِنْهَا شَيْءٌ فَخَشِيتَ مَوْتًا فَانْحَرْهَا ثُمَّ اغْمِسْ نَعْلَهَا فِي دَمِهَا  ، ثُمَّ اضْرِبْ بِهَا صَفْحَتَهَا وَلَا تَطْعَمْ مِنْهَا أَنْتَ وَلَا أَحَدٌ مِنْ أَهْلِ رُفْقَتِكَ وَاقْسِمْهَا  .  وَاللَّفْظُ لِحَدِيثِ  يَزِيدَ بْنِ زُرَيْعٍ  وَقَالَ  خَالِدُ بْنُ الْحَارِثِ  :  ذُؤَيْبُ بْنُ قَبِيصَةَ  .","","Al-Mu'jam al-Kabir 4213","","ذؤيب بن حلحلة القميري عن عبد الله بن عباس عن سنان بن سلمة بن المحبق الهذلي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن بشر بن الفرافصة عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ذؤيب بن قبيصة الخزاعي"
"4216","4214  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  حَمْزَةَ الزَّيَّاتِ ،  عَنْ  أَبِي إِسْحَاقَ ،  حَدَّثَنِي  ذُؤَيْبٌ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا حَضَرَ قَالَتْ  صَفِيَّةُ  :  يَا رَسُولَ اللهِ لِكُلِّ امْرَأَةٍ مِنْ نِسَائِكَ أَهْلٌ يُلْجَأُ إِلَيْهِمْ  وَإِنَّكَ أَجْلَيْتَ أَهْلِي ، فَإِنْ حَدَثَ حَدَثٌ فَإِلَى مَنْ ؟ قَالَ : إِلَى  عَلِيِّ بْنِ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 4214","","ذؤيب بن حلحلة القميري عن أبو إسحاق السبيعي عن حمزة الزيات عن معاوية بن هشام القصار عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذؤيب بن قبيصة الخزاعي"
"4217","[4/231]      413 -  ذُؤَيْبٌ الْعَنْبَرِيُّ  4215  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  عَطَاءُ بْنُ خَالِدِ بْنِ الزُّبَيْرِ بْنِ عَبْدِ اللهِ بْنِ رُدَيْحِ بْنِ ذُؤَيْبٍ الْعَنْبَرِيُّ ،  بِالْبَصْرَةِ  ،  حَدَّثَنِي  أَبِي خَالِدٌ ،  عَنْ  أَبِيهِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ رُدَيْحٍ ،  عَنْ  أَبِيهِ ذُؤَيْبٍ ،  أَنَّ وَفْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرُّوا  بِأُمِّ زُبَيْبٍ  ، فَأَخَذُوا زَرْبِيَّتَهَا فَلَحِقَ  زُبَيْبٌ  بِالنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا نَبِيَّ اللهِ أَخَذَ الْوَفْدُ  زَرْبِيَّةَ  أُمِّي ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  رُدُّوا عَلَيْهِ  زَرْبِيَّةَ  أُمِّهِ  ، فَأَخَذَ مِنَ الَّذِيِ أَخَذَ  زَرْبِيَّةَ  أُمِّهِ صَاعًا مِنْ شَعِيرٍ وَسَيْفَهُ وَمِنْطَقَتَهُ ، ثُمَّ رَفَعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدَهُ فَمَسَحَ بِهَا رَأْسَ  زُبَيْبٍ  ثُمَّ قَالَ : بَارَكَ اللهُ فِيكَ يَا غُلَامُ وَبَارَكَ لِأُمِّكَ  .  قَالَ  مُوسَى بْنُ هَارُونَ  :  الزَّرْبِيَّةُ : مَفْرَشٌ أَثْقَلُ مِنَ الزَّيْلَوِيَّةِ ، قَالَ اللهُ عَزَّ وَجَلَّ :         {      وَزَرَابِيُّ مَبْثُوثَةٌ         }      يَعْنِي مَبْسُوطَةً  .","","Al-Mu'jam al-Kabir 4215","","ذؤيب بن شعثم العنبري عن رديح بن ذؤيب العنبري عن عبد الله عن الزبير عن خالد بن الزبير بن عبد الله العنبري عن عطاء بن خالد ابن شعثم بن قرط عن موسى بن هارون الحمال عن الطبراني","ذؤيب العنبري"
"4218","4216  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  حَدَّثَنَا  عَطَاءُ بْنُ خَالِدٍ ،  حَدَّثَنِي  أَبِي خَالِدٌ ،  عَنْ  أَبِيهِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ رُدَيْحٍ ،  عَنْ  أَبِيهِ ذُؤَيْبٍ ،  أَنَّ  عَائِشَةَ  قَالَتْ : يَا نَبِيَّ اللهِ إِنِّي أُرِيدُ عَتِيقًا مِنْ وَلَدِ  إِسْمَاعِيلَ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَصْدًا ، فَقَالَ لَهَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  انْتَظِرِي حَتَّى يَجِيءَ فَيْءُ الْعَنْبَرِ غَدًا  فَجَاءَ فَيْءُ الْعَنْبَرِ ، فَقَالَ لَهَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : خُذِي مِنْهُمْ أَرْبَعَةَ غِلْمَةٍ صُبَاحٍ مُلَاحٍ لَا تُخْبَأُ مِنْهُمُ الرُّءُوسُ .  قَالَ  عَطَاءُ بْنُ خَالِدٍ  : فَأَخَذَتْ جَدِّي  رُدَيْحًا  وَأَخَذَتِ ابْنَ عَمِّي  سَمُرَةَ  وَأَخَذَتِ ابْنَ عَمِّي  رُخَيًّا  وَأَخَذَتْ خَالِي  زُبَيْبًا  ، ثُمَّ رَفَعَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَدَهُ فَمَسَحَ بِهَا رُءُوسَهُمْ  وَبَرَّكَ  عَلَيْهِمْ ثُمَّ قَالَ : هَؤُلَاءِ يَا  عَائِشَةُ  مِنْ وَلَدِ  إِسْمَاعِيلَ  قَصْدًا  .","","Al-Mu'jam al-Kabir 4216","","ذؤيب بن شعثم العنبري عن رديح بن ذؤيب العنبري عن عبد الله عن الزبير عن خالد بن الزبير بن عبد الله العنبري عن عطاء بن خالد ابن شعثم بن قرط عن موسى بن هارون الحمال عن الطبراني","ذؤيب العنبري"
"4219","[4/232]      414 -  ذَكْوَانُ مَوْلَى رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَقَدِ اخْتُلِفَ فِي اسْمِهِ فَقِيلَ  مِهْرَانُ  وَقِيلَ  طَهْمَانُ  4217  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  حَدَّثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ، قَالَ : أُوصِيَ إِلَيَّ بِشَيْءٍ  لِبَنِي هَاشِمٍ  فَأَتَيْتُ أَبَا جَعْفَرٍ  بِالْمَدِينَةِ  فَبَعَثَنِي إِلَى امْرَأَةٍ مِنْهُمُ ابْنَةٌ لِعَلِيٍّ عَجُوزٌ كَبِيرَةٌ ، فَقَالَ :  حَدَّثَنِي  مَوْلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُقَالُ لَهُ  طَهْمَانُ ، أَوْ ذَكْوَانُ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الصَّدَقَةَ لَا تَحِلُّ لِي  وَلَا  لِأَهْلِ بَيْتِي  وَإِنَّ  مَوْلَى  الْقَوْمِ  مِنْ أَنْفُسِهِمْ  .","","Al-Mu'jam al-Kabir 4217","","ذكوان مولى رسول الله صلى الله عليه وسلم عن أبو جعفر الباقر عن عطاء بن السائب عن شريك بن عبد الله النخعي عن منجاب بن الحارث التميمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكوان مولى رسول الله صلى الله عليه وسلم"
"4220","415 -  ذَكْوَانُ بْنُ عَبْدِ قَيْسٍ الْأَنْصَارِيُّ  بَدْرِيٌّ اسْتُشْهِدَ  يَوْمَ أُحُدٍ  .  4218  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ،  عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  :  فِي تَسْمِيَةِ مَنْ شَهِدَ  الْعَقَبَةَ  مِنَ  الْأَنْصَارِ  ،  ثُمَّ مِنْ  بَنِي زُرَيْقٍ  ذَكْوَانُ بْنُ عَبْدِ قَيْسِ بْنِ خَلْدَةَ  .","","Al-Mu'jam al-Kabir 4218","","","ذكوان بن عبد قيس الأنصاري"
"4221","4219  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ،  عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  :  فِي تَسْمِيَةِ مَنْ شَهِدَ  الْعَقَبَةَ  مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي زُرَيْقٍ  ذَكْوَانُ بْنُ عَبْدِ قَيْسِ بْنِ خَلْدَةَ  ، وَكَانَ خَرَجَ مِنَ  الْمَدِينَةِ  إِلَى  مَكَّةَ  مُهَاجِرًا إِلَى اللهِ وَقَدْ شَهِدَ  بَدْرًا  .","","Al-Mu'jam al-Kabir 4219","","","ذكوان بن عبد قيس الأنصاري"
"4222","4220  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ،  عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  :  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [4/233]      يَوْمَ أُحُدٍ  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي زُرَيْقٍ  ذَكْوَانُ بْنُ عَبْدِ قَيْسٍ  .","","Al-Mu'jam al-Kabir 4220","","","ذكوان بن عبد قيس الأنصاري"
"4223","4221  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ،  عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  :  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ أُحُدٍ  مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي زُرَيْقٍ  ذَكْوَانُ بْنُ عَبْدِ قَيْسٍ  .","","Al-Mu'jam al-Kabir 4221","","","ذكوان بن عبد قيس الأنصاري"
"4224","416 -  ذَرْعٌ أَبُو طَلْحَةَ الْخَوْلَانِيُّ  وَقَدِ اخْتُلِفَ فِي  صُحْبَتِهِ  4222  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْوَرَّاقُ ،  ثَنَا  أَبُو عُمَرَ الضَّرِيرُ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي سِنَانٍ عِيسَى ،  عَنْ  أَبِي طَلْحَةَ الْخَوْلَانِيِّ وَاسْمُهُ ذَرْعٌ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَكُونُ جُنُودٌ أَرْبَعَةٌ ، فَعَلَيْكُمْ  بِالشَّامِ  ،  فَإِنَّ اللهَ عَزَّ وَجَلَّ قَدْ تَكَفَّلَ لِي  بِالشَّامِ  .","","Al-Mu'jam al-Kabir 4222","","أبو طلحة  الخولاني عن عيسى بن سنان القسملي عن حماد بن سلمة عن حفص بن عمر الضرير البصري عن جعفر بن محمد الوراق عن عبد الله بن أحمد الجواليقي عن الطبراني","ذرع أبو طلحة الخولاني"
"4225","417 -  ذُو الْيَدَيْنِ وَيُقَالُ اسْمُهُ الْخِرْبَاقُ وَيُكَنَّى أَبَا الْعُرْيَانِ  4223  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  حَدَّثَنَا  أَبُو شَيْبَةَ ،  عَنِ  الْحَكَمِ ، قَالَ :  قَالَ  عَمَّارٌ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثَلَاثَةً ، كُلُّنَا أَضْبَطُ  . قِيلَ  لِأَبِي شَيْبَةَ  :  مَا  الْأَضْبَطُ  ؟ قَالَ : الَّذِي يَعْمَلُ بِيَدَيْهِ  ،  ذُو الشِّمَالَيْنِ  وَعُمَرُ بْنُ الْخَطَّابِ  ،  وَأَبُو لَيْلَى  .","","Al-Mu'jam al-Kabir 4223","","عمار بن ياسر عن الحكم بن عتيبة الكندي عن إبراهيم بن عثمان أبو شيبة العبسي عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذو اليدين"
"4226","4224  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  مَعْدِيُّ بْنُ سُلَيْمَانَ ،  ثَنَا  شُعَيْبُ بْنُ مُطَيْرٍ ،  عَنْ  أَبِيهِ مُطَيْرٍ  ،  وَمُطَيْرٌ  حَاضِرٌ يُصَدِّقُهُ بِمَقَالَتِهِ قَالَ :  كَيْفَ كُنْتُ أَخْبَرْتُكَ ؟ قَالَ : يَا أَبَتَاهُ  أَخْبَرْتَنِي  أَنَّهُ لَقِيَكَ ذُو الْيَدَيْنِ  بِذِي خَشَبٍ  ،  فَأَخْبَرَكَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَّى بِهِمْ إِحْدَى صَلَاتَيِ  الْعَشِيِّ  ، وَهِيَ         [4/234]      الْعَصْرُ فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ سَلَّمَ وَخَرَجَ  سَرَعَانُ  النَّاسِ ، وَهُمْ يَقُولُونَ :  قَصُرَتِ  الصَّلَاةُ وَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَاتَّبَعَهُ  أَبُو بَكْرٍ  وَعُمَرُ  رَحِمَهُمَا اللهُ ، فَلَحِقَهُ  ذُو الْيَدَيْنِ  ، فَقَالَ : يَا رَسُولَ اللهِ  أَقَصُرَتِ  الصَّلَاةُ أَمْ نَسِيتَ ؟ فَقَالَ :  مَا  قَصُرَتِ  الصَّلَاةُ وَمَا نَسِيتُ  ثُمَّ أَقْبَلَ عَلَى  أَبِي بَكْرٍ  ،  وَعُمَرَ  رَضِيَ اللهُ عَنْهُمَا فَقَالَ : مَا يَقُولُ  ذُو الْيَدَيْنِ  ؟ فَقَالَا : صَدَقَ يَا رَسُولَ اللهِ ، فَرَجَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَثَابَ النَّاسُ ، فَصَلَّى رَكْعَتَيْنِ ثُمَّ سَلَّمَ ثُمَّ سَجَدَ سَجْدَتَيِ السَّهْوِ  .","","Al-Mu'jam al-Kabir 4224","","ذو اليدين السلمى عن مطير بن سليم الوادى عن شعيث بن مطير الوادي عن معدي بن سليمان الصفدي عن أبو موسى الزمن عن الحسين بن إسحاق التستري عن الطبراني","ذو اليدين"
"4227","4225  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَبِي الْمُهَلَّبِ ،  عَنْ  عِمْرَانَ بْنِ حُصَيْنٍ ، قَالَ :  سَلَّمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ثَلَاثِ رَكَعَاتٍ مِنَ الْعَصْرِ ، فَدَخَلَ فَقَالَ لَهُ رَجُلٌ يُقَالُ لَهُ  الْخِرْبَاقُ  وَكَانَ طَوِيلَ الْيَدَيْنِ فَقَالَ :  أَقَصُرَتِ  الصَّلَاةُ يَا رَسُولَ اللهِ ؟ فَخَرَجَ مُغْضَبًا يَجُرُّ رِدَاءَهُ  فَقَالَ : أَصَدَقَ ؟ قَالُوا : نَعَمْ ، فَقَامَ فَصَلَّى تِلْكَ الرَّكْعَةَ  ،  فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 4225","","عمران بن حصين بن عبيد بن خلف الخزاعي عن أبو المهلب الجرمي عن أبو قلابة الجرمي عن خالد الحذاء عن يزيد بن زريع العيشي عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذو اليدين"
"4228","4226  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  قَطَنُ بْنُ نُسَيْرٍ ،  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ ،  ثَنَا  الْمُعَلَّى بْنُ زِيَادٍ الْقُرْدُوسِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ صُهَيْبٍ ، قَالَ : كُنْتُ مَعَ الْحَسَنِ فَمَرَّ بِهِ رَجُلٌ  فَحَدَّثَهُ  ، قَالَ :  قَالَ  ذُو الْيَدَيْنِ :  يَا مَعْشَرَ  الْأَنْصَارِ  أَلَيْسَ  أَمَرَكُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تَصْبِرُوا حَتَّى تَلْقَوْهُ .  ؟","","Al-Mu'jam al-Kabir 4226","","ذو اليدين السلمى عن رجل عن عبد العزيز بن صهيب البناني عن معلى بن زياد القردوسي عن جعفر بن سليمان الضبعي عن قطن بن نسير الغبري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذو اليدين"
"4229","418 -  ذُو مِخْمَرٍ ، وَيُقَالُ : مِخْبَرٌ ، ابْنُ أَخِي النَّجَاشِيِّ  4227  -  حَدَّثَنَا  أَبُو زَيْدٍ أَحْمَدُ بْنُ يَزِيدَ الْحَوْطِيُّ ،  ثَنَا  أَبُو الْيَمَانِ الْحَكَمُ بْنُ نَافِعٍ ،  ثَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  عَنْ  رَاشِدِ بْنِ سَعْدٍ ،  عَنْ  أَبِي حَيٍّ الْمُؤَذِّنِ ،  عَنْ  ذِي مِخْبَرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَانَ هَذَا الْأَمْرُ فِي  حِمْيَرَ  فَنَزَعَهُ اللهُ مِنْهُمْ فَصَيَّرَهُ فِي  قُرَيْشٍ  .","","Al-Mu'jam al-Kabir 4227","","ذو مخبر الحبشي عن شداد بن حي الحمصي عن راشد بن سعد المقرائي عن حريز بن عثمان الرحبي عن أبو اليمان الحكم بن نافع عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","ذو مخمر"
"4230","[4/235]      4228  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ ،  ثَنَا  قَيْسُ بْنُ حَفْصٍ الدَّارِمِيُّ ،  ثَنَا  مَسْلَمَةُ بْنُ عَلْقَمَةَ الْمَازِنِيُّ ،  ثَنَا  دَاوُدُ بْنُ أَبِي هِنْدٍ ،  عَنِ  الْعَبَّاسِ بْنِ عَبْدِ الرَّحْمَنِ ، مَوْلَى بَنِي هَاشِمٍ ،  ثَنَا  ذُو مِخْمَرٍ ابْنُ أَخِي النَّجَاشِيِّ ، قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غَزَاةٍ فَسَرَّوْا مِنَ اللَّيْلِ مَا سَرَّوْا ، ثُمَّ نَزَلُوا ، فَأَتَانِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا  ذَا مِخْمَرٍ  ، قُلْتُ :  لَبَّيْكَ  رَسُولَ اللهِ  وَسَعْدَيْكَ  فَأَخَذَ بِرَأْسِ نَاقَتِي وَقَالَ :  اقْعُدْ هَهُنَا وَلَا تَكُونَنَّ  لَكَاعًا  اللَّيْلَةَ  فَأَخَذْتُ بِرَأْسِ النَّاقَةِ ، فَغَلَبَتْنِي عَيْنَايَ ، فَنِمْتُ  وَانْسَلَّتِ  النَّاقَةُ ، فَذَهَبَتْ فَلَمْ أَسْتَيْقِظْ إِلَّا بِحَرِّ الشَّمْسِ ، فَأَتَانِي النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : يَا  ذَا مِخْمَرٍ  ، قُلْتُ :  لَبَّيْكَ  يَا رَسُولَ اللهِ  وَسَعْدَيْكَ  قَالَ : كُنْتَ وَاللهِ اللَّيْلَةَ لُكَعَ كَمَا قُلْتُ ، فَتَنَحَّيْنَا عَنْ ذَلِكَ الْمَكَانِ فَصَلَّى بِنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا قَضَى الصَّلَاةَ دَعَا أَنْ تُرَدَّ النَّاقَةُ ، فَجَاءَتْ بِهَا عِصَارُ رِيحٍ تَسُوقُهَا ، فَلَمَّا كَانَ مِنَ الْغَدِ حِينَ بَرَقَ الْفَجْرُ أَمَرَ  بِلَالًا  فَأَذَّنَ ، ثُمَّ أَمَرَهُ فَأَقَامَ ثُمَّ صَلَّى بِنَا ، فَلَمَّا قَضَى الصَّلَاةَ قَالَ : هَذِهِ صَلَاتُنَا بِالْأَمْسِ ثُمَّ ائْتَنَفَ صَلَاةَ يَوْمِهِ ذَلِكَ  .","","Al-Mu'jam al-Kabir 4228","","ذو مخبر الحبشي عن عباس بن عبد الرحمن الهاشمي عن داود بن أبي هند عن مسلمة بن علقمة المازني عن قيس بن حفص الدارمي عن أحمد بن داود بن موسى السدوسي عن الطبراني","ذو مخمر"
"4231","4229  -  حَدَّثَنَا  مُوسَى بْنُ عِيسَى بْنِ الْمُنْذِرِ الْحِمْصِيُّ ،  ثَنَا  أَبِي ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  صَفْوَانَ بْنِ عَمْرٍو ، قَالَ :  حَدَّثَنِي  رَاشِدُ بْنُ سَعْدٍ ،  حَدَّثَنِي  ذُو مِخْمَرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تُصَالِحُونَ  الرُّومَ  صُلْحًا آمِنًا حَتَّى تَغْزُونَ أَنْتُمْ  وَهُمْ عَدُوًّا فَتُنْصَرُونَ فَتَنْزِلُونَ فِي مَرْجٍ ذِي تُلُولٍ  .","","Al-Mu'jam al-Kabir 4229","","ذو مخبر الحبشي عن راشد بن سعد المقرائي عن صفوان بن عمرو السكسكي عن بقية بن الوليد عن عيسى بن المنذر السلمي عن موسى بن عيسى بن المنذر الحمصي عن الطبراني","ذو مخمر"
"4232","4230  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  حَسَّانَ بْنِ عَطِيَّةَ ،  ثَنَا  خَالِدُ بْنُ مَعْدَانَ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  ذِي مِخْبَرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  سَتُصَالِحُونَ  الرُّومَ         [4/236]      صُلْحًا آمِنًا  ، ثُمَّ تَغْزُونَ أَنْتُمْ وَهُمْ عَدُوًّا ، فَتُنْصَرُونَ وَتَغْنَمُونَ وَتَسْلَمُونَ ، ثُمَّ تَنْصَرِفُونَ حَتَّى تَنْزِلُوا مَرْجًا ذِي تُلُولٍ فَيَرْفَعُ رَجُلٌ مِنْ أَهْلِ النَّصْرَانِيَّةِ صَلِيبًا فَيَقُولُ غَلَبَ الصَّلِيبُ فَيَغْضَبُ رَجُلٌ مِنَ الْمُسْلِمِينَ فَيَقُومُ إِلَيْهِ فَيَدُقُّهُ فَعِنْدَ ذَلِكَ تَغْدِرُ  الرُّومُ  وَيَجْتَمِعُونَ  لِلْمَلْحَمَةِ  .","","Al-Mu'jam al-Kabir 4230","","ذو مخبر الحبشي عن جبير بن نفير بن مالك الحضرمي عن خالد بن معدان عن حسان بن عطية المحاربي عن أبو عمرو الأوزاعي عن عيسى بن يونس بن أبي إسحاق عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ذو مخمر"
"4233","4231  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ ،  ثَنَا  أَبِي  ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  يَحْيَى بْنِ أَبِي عَمْرٍو السَّيْبَانِيِّ ،  عَنْ  ذِي مِخْبَرٍ ابْنِ أَخِي النَّجَاشِيِّ أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  تُصَالِحُونَ  الرُّومَ  عَشْرَ سِنِينَ صُلْحًا آمِنًا  ، يَفُونَ سَنَتَيْنِ وَيَغْدِرُونَ فِي الثَّالِثَةِ ، أَوْ يَفُونَ أَرْبَعًا وَيَغْدِرُونَ فِي الْخَامِسَةِ ، فَيَنْزِلُ جَيْشًا مِنْكُمْ فِي مَدِينَتِهِمْ فَتَغْزُونَ أَنْتُمْ وَهُمْ عَدُوًّا مِنْ وَرَائِكُمْ وَوَرَائِهِمْ ، فَتُقَاتِلُونَ ذَلِكَ الْعَدُوَّ ، فَيَفْتَحُ اللهُ لَكُمْ ، فَتَنَصْرِفُونَ بِمَا أَصَبْتُمْ مِنْ أَجْرٍ وَغَنِيمَةٍ فَتَنْزِلُونَ بِمَرْجٍ ذِي تُلُولٍ ، فَيَقُولُ قَائِلُكُمُ : اللهُ غَلَبَ ، وَيَقُولُ قَائِلُهُمُ : الصَّلِيبُ غَلَبَ ، فَيَتَدَاوَلُونَهَا فَيَغْضَبُ الْمُسْلِمُونَ ، وَصَلِيبُهُمْ مِنْهُمْ غَيْرُ بَعِيدٍ ، فَيَثُورُ ذَلِكَ الْمُسْلِمُ إِلَى صَلِيبِهِمْ فَيَدُقُّهُ ، وَيَبْرُزُونَ إِلَى كَاسِرِ صَلِيبِهِمْ فَيَضْرِبُونَ عُنُقَهُ ، فَتَثُورُ تِلْكَ الْعِصَابَةُ مِنَ الْمُسْلِمِينَ إِلَى أَسْلِحَتِهِمْ ، وَيَثُورُ  الرُّومُ  إِلَى أَسْلِحَتِهِمْ ، فَيَقْتُلُونَ تِلْكَ الْعِصَابَةَ مِنَ الْمُسْلِمِينَ يُسْتَشْهَدُونَ ، فَيَأْتُونَ مَلِكَهُمْ فَيَقُولُونَ : قَدْ كَفَيْنَاكَ حَدَّ الْعَرَبِ وَبَأْسَهُمْ ، فَمَاذَا نَنْتَظِرُ ؟ فَيَجْمَعُ لَكُمْ حَمْلَ امْرَأَةٍ ثُمَّ يَأْتُونَكُمْ تَحْتَ ثَمَانِينَ  غَايَةً  تَحْتَ كُلِّ  غَايَةٍ  اثْنَا عَشَرَ أَلْفًا  .","","Al-Mu'jam al-Kabir 4231","","ذو مخبر الحبشي عن يحيى بن أبي عمرو السيباني عن إسماعيل بن عياش الأحول عن عبد الوهاب بن نجدة عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","ذو مخمر"
"4234","4232  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ رَافِعٍ ،  عَنِ  ابْنِ مُحَيْرِيزٍ ،  عَنْ  ذِي مِخْبَرٍ ابْنِ أَخِي النَّجَاشِيِّ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 4232","","ذو مخبر الحبشي عن عبد الله بن محيريز الجمحي عن إسماعيل بن رافع بن عويمر المزني عن إسماعيل بن عياش الأحول عن عبد الوهاب بن نجدة عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","ذو مخمر"
"4235","4233  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ، (  ح  )         [4/237]      وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، قَالَا :  ثَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  عَنْ  يَزِيدَ بْنِ صُلَيْحٍ ،  عَنْ  ذِي مِخْبَرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4233","","ذو مخبر الحبشي عن يزيد بن صالح الرحبي عن حريز بن عثمان الرحبي عن الوليد بن مسلم القرشي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","ذو مخمر"
"4236","4234  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي الْمِصِّيصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَوْفٍ الْحِمْصِيُّ ،  ثَنَا  هَاشِمُ بْنُ عَمْرٍو الْحِمْصِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  حَدَّثَنِي  سَعِيدُ بْنُ سِنَانٍ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  ذِي مِخْبَرٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ اطَّلَعَ إِلَى  أَهْلِ الْمَدِينَةِ  وَهِيَ بَطْحَاءُ قَبْلَ أَنْ تُعَمَّرَ لَيْسَ فِيهَا مَدَرَةٌ وَلَا وَبَرٌ ، فَقَالَ :  يَا  أَهْلَ يَثْرِبَ  إِنِّي مُشْتَرِطٌ عَلَيْكُمْ ثَلَاثًا  وَسَائِقٌ إِلَيْكُمْ مِنْ كُلِّ  الثَّمَرَاتِ  لَا تَعْصِي وَلَا تَغَلِّي وَلَا تَكَبَّرِي ، فَإِنْ فَعَلْتِ شَيْئًا مِنْ ذَلِكَ تَرَكْتُكِ  كَالْجَزُورِ  لَا يَمْتَنِعُ مِنْ أَكْلِهِ  .","","Al-Mu'jam al-Kabir 4234","","ذو مخبر الحبشي عن أبو الزاهرية حدير بن كريب عن سعيد بن سنان الحمصي عن إسماعيل بن عياش الأحول عن هاشم بن عمرو الحمصي عن محمد بن عوف بن سفيان عن يحيى بن عبد الباقي الثغري عن الطبراني","ذو مخمر"
"4237","419 -  ذُو اللِّحْيَةِ الْكِلَابِيُّ بْنُ عَمْرِو بْنِ قُرْطِ بْنِ أَبِي بَكْرِ بْنِ عَبْدِ اللهِ بْنِ كِلَابٍ  4235  -  حَدَّثَنَا  مُحَمَّدُ بْنُ حَمُّويَهْ أَبُو سَيَّارٍ التُّسْتَرِيُّ  ،  ثَنَا  شَبَابٌ الْعُصْفُرِيُّ ،  ثَنَا  سَهْلُ بْنُ أَسْلَمَ الْعَدَوِيُّ ،  ثَنَا  يَزِيدُ بْنُ أَبِي مَنْصُورٍ ،  عَنْ  ذِي اللِّحْيَةِ الْكِلَابِيِّ ،  أَنَّهُ سَأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَعْمَلُ فِي أَمْرٍ مُسْتَأْنَفٍ أَوْ أَمْرٍ قَدْ فُرِغَ مِنْهُ ؟ قَالَ : بَلْ فِي أَمْرٍ قَدْ فُرِغَ مِنْهُ قَالَ : فَفِيمَ الْعَمَلُ ؟ قَالَ :  اعْمَلُوا فَكُلٌّ  مُيَسَّرٌ  لِمَا خُلِقَ لَهُ  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: (أحمد بن حموية ) ، والله أعلم .","","Al-Mu'jam al-Kabir 4235","","ذو اللحية الكلابي عن يزيد بن أبي منصور الأزدي عن سهل بن أسلم العدوي عن خليفة بن خياط عن أحمد بن حمويه التستري عن الطبراني","ذو اللحية الكلابي بن عمرو بن قرط بن أبي بكر بن عبد الله بن كلاب"
"4238","4236  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  أَبُو عُبَيْدَةَ الْحَدَّادُ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  عَنْ  يَزِيدَ  بْنِ أَبِي مَنْصُورٍ ،  عَنْ  ذِي اللِّحْيَةِ الْكِلَابِيِّ ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ أَنَعْمَلُ فِي أَمْرٍ مُسْتَأْنَفٍ أَوْ أَمْرٍ قَدْ فُرِغَ مِنْهُ ؟ قَالَ : لَا ، بَلْ فِي أَمْرٍ قَدْ فُرِغَ مِنْهُ قَالَ : فَفِيمَ الْعَمَلُ ؟ قَالَ :  اعْمَلُوا فَكُلٌّ  مُيَسَّرٌ  لِمَا خُلِقَ لَهُ  .  : في طبعة مكتبة ابن تيمية : ( زيد ) والمثبت من النسخة الخطية","","Al-Mu'jam al-Kabir 4236","","ذو اللحية الكلابي عن يزيد بن أبي منصور الأزدي عن عبد العزيز بن مسلم الخراساني عن عبد الواحد بن واصل عن يحيى بن معين عن عبد الله بن أحمد بن حنبل عن الطبراني","ذو اللحية الكلابي بن عمرو بن قرط بن أبي بكر بن عبد الله بن كلاب"
"4239","[4/238]      420 -  ذُو الْأَصَابِعِ وَهُوَ ذُو الزَّوَائِدِ  4237  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  عُثْمَانُ بْنُ عَطَاءٍ ، أَنَّ زِيَادَ بْنَ أَبِي سَوْدَةَ  حَدَّثَهُ  ،  عَنْ  أَبِي عِمْرَانَ ،  عَنْ  ذِي الْأَصَابِعِ ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ إِنِ ابْتُلِينَا بِالْبَقَاءِ بَعْدَكَ فَمَا تَأْمُرُنَا ؟ فَقَالَ :  عَلَيْكَ  بِبَيْتِ الْمَقْدِسِ  لَعَلَّ اللهَ أَنْ يَرْزُقَكَ  ذُرِّيَّةً  تَغْدُو إِلَيْهِ وَتَرُوحُ  .","","Al-Mu'jam al-Kabir 4237","","ذو الأصابع الجهني عن أبو عمران مولى أم الدرداء عن زياد بن أبي سودة المقدسى عن عثمان بن عطاء الخراساني عن محمد بن شعيب بن شابور القرشي عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","ذو الأصابع"
"4240","4238  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  الْحَكَمُ بْنُ مُوسَى ،  ثَنَا  ضَمْرَةُ بْنُ رَبِيعَةَ ،  عَنْ  عُثْمَانَ بْنِ عَطَاءٍ ،  عَنْ  أَبِي عِمْرَانَ ،  عَنْ  ذِي الْأَصَابِعِ ، قَالَ :  قُلْنَا يَا رَسُولَ اللهِ إِنِ ابْتُلِينَا بَعْدَكَ بِالْبَقَاءِ أَيْنَ تَأْمُرُنَا ؟ قَالَ :  عَلَيْكُمْ  بِبَيْتِ الْمَقْدِسِ  ، فَلَعَلَّهُ أَنْ يَنْشَأَ لَكُمْ  ذُرِّيَّةٌ  يَغْدُونَ إِلَى ذَلِكَ الْمَسْجِدِ وَيَرُوحُونَ  .","","Al-Mu'jam al-Kabir 4238","","ذو الأصابع الجهني عن أبو عمران مولى أم الدرداء عن عثمان بن عطاء الخراساني عن ضمرة بن ربيعة الفلسطيني عن الحكم بن موسى بن أبي زهير النسائي عن عبد الله بن أحمد بن حنبل عن الطبراني","ذو الأصابع"
"4241","4239  -  حَدَّثَنَا  أَبُو عَامِرٍ مُحَمَّدُ بْنُ إِبْرَاهِيمَ النَّحْوِيُّ الصُّورِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  سُلَيْمُ بْنُ مُطَيْرٍ مِنْ أَهْلِ وَادِي الْقُرَى ،  عَنْ  أَبِيهِ  ،  سَمِعْتُ  ذَا الزَّوَائِدِ ، يَقُولُ :  سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَامَ حَجَّةِ الْوَدَاعِ  أَمَرَ النَّاسَ وَنَهَاهُمْ ثُمَّ قَالَ : هَلْ بَلَّغْتُ ؟ قَالُوا : اللَّهُمَّ نَعَمْ ، قَالَ : اللَّهُمَّ اشْهَدْ ثُمَّ قَالَ :  خُذُوا الْعَطَاءَ مَا دَامَ غَضًّا فَإِذَا  تَجَاحَفَتْ  قُرَيْشٌ  بَيْنَهَا الْمُلْكَ وَصَارَ الْعَطَاءُ رُشَاءً عَنْ دِينِكُمْ فَدَعُوهُ  .","","Al-Mu'jam al-Kabir 4239","","ذو الزوائد الجهني عن مطير بن سليم الوادى عن سليم بن مطير الوادي عن هشام بن عمار عن محمد بن إبراهيم الصوري عن الطبراني","ذو الأصابع"
"4242","بَابُ الرَّاءِ  مَنِ اسْمُهُ [رَافِعٌ]  421 -  رَافِعُ بْنُ خَدِيجِ بْنِ رَافِعٍ الْأَنْصَارِيُّ يُكْنَى أَبَا عَبْدِ اللهِ  مِنْ أَخْبَارِهِ  4240  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ         [4/239]      الْحَسَنِ الْأَسَدِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  عُثْمَانَ بْنِ عُبَيْدِ اللهِ بْنِ رَافِعٍ ، قَالَ :  رَأَيْتُ  رَافِعَ بْنَ خَدِيجٍ يَخْضِبُ بِالصُّفْرَةِ  .","","Al-Mu'jam al-Kabir 4240","","رافع بن خديج الأنصاري عن عثمان بن عبيد الله بن أبي رافع المديني عن إبراهيم بن طهمان عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","من أخباره"
"4243","4241  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  يَعْقُوبُ بْنُ حُمَيْدِ بْنِ كَاسِبٍ ،  ثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ حُسَيْنٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ  أَنَّهُ خَرَجَ  يَوْمَ أُحُدٍ  ، فَأَرَادَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَدَّهُ فَاسْتَصْغَرَهُ ، فَقَالَ لَهُ عَمِّي : يَا رَسُولَ اللهِ إِنَّهُ رَامٍ فَأَخْرَجَهُ فَأَصَابَهُ سَهْمٌ فِي  صَدْرِهِ أَوْ نَحْرِهِ  ، فَأَتَى عَمُّهُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : إِنَّ ابْنَ أَخِي أُصِيبَ بِسَهْمٍ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ تَدَعْهُ فِيهِ فَيَمُوتَ مَاتَ  شَهِيدًا  . قَالَ  عَبْدُ اللهِ بْنُ حُسَيْنٍ  :  وَحَدَّثَتْنِي  امْرَأَتُهُ  أَنَّهَا كَانَتْ تَرَاهُ يَغْتَسِلُ فَيَتَحَرَّكُ فِي صَدْرِهِ  .","","Al-Mu'jam al-Kabir 4241","","رافع بن خديج الأنصاري عن ثابت بن أنس بن ظهير الأنصاري عن بشير بن ثابت الأنصاري عن عبد الله بن حسين عن محمد بن طلحة بن عبد الرحمن عن يعقوب بن حميد بن كاسب المدني عن عبد الله بن أحمد بن حنبل عن الطبراني","من أخباره"
"4244","4242  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْحَجَّاجُ بْنُ الْمِنْهَالِ (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ ،  ثَنَا  أَبُو الْوَلِيدِ ، وَمُحَمَّدُ بْنُ كَثِيرٍ ، قَالُوا :  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ الْوَاشِجِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  جَدَّتِهِ وَهِيَ امْرَأَةُ رَافِعٍ ،  أَنَّ رَافِعًا  رُمِيَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  يَوْمَ أُحُدٍ  أَوْ  يَوْمَ خَيْبَرَ  - شَكَّ  عَمْرٌو  - بِسَهْمٍ فِي  ثَنْدُوَتِهِ  فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : يَا رَسُولَ اللهِ انْزِعِ السَّهْمَ قَالَ :  يَا  رَافِعُ  إِنْ شِئْتَ نَزَعْتُ السَّهْمَ  وَالْقُطْبَةَ  جَمِيعًا  ، وَإِنْ شِئْتَ نَزَعْتُ السَّهْمَ وَتَرَكْتُ  الْقُطْبَةَ  وَشَهِدْتُ لَكَ يَوْمَ الْقِيَامَةِ أَنَّكَ شَهِيدٌ ، قَالَ : فَنَزَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ السَّهْمَ وَتَرَكَ  الْقُطْبَةَ  فَعَاشَ بِهَا حَتَّى كَانَ فِي خِلَافَةِ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُ ، فَانْتَقَضَ بِهِ الْجُرْحُ ، فَمَاتَ بَعْدَ الْعَصْرِ ، فَأَتَى  ابْنُ عُمَرَ  فَقِيلَ : يَا  أَبَا عَبْدِ الرَّحْمَنِ  مَاتَ  رَافِعُ بْنُ خَدِيجٍ  ، فَتَرَحَّمَ عَلَيْهِ قَالَ : إِنَّ مِثْلَ  رَافِعٍ  لَا يُخْرَجُ بِهِ حَتَّى يُؤْذَنَ مَنْ حَوْلَ  الْمَدِينَةِ  مِنَ الْقُرَى ، فَلَمَّا خَرَجْنَا بِجِنَازَتِهِ ، فَصُلِّيَ عَلَيْهِ ، جَاءَ  ابْنُ عُمَرَ  حَتَّى جَلَسَ عَلَى رَأْسِ الْقَبْرِ ، فَصَرَخَتْ  مَوْلَاةٌ  لَنَا فَقَالَ  ابْنُ عُمَرَ  : مَا لِلسَّفِيهَةِ مِنْ أَحَدٍ ؟ لَا تُؤْذِي الشَّيْخَ فَإِنَّهُ لَا يَدِينُ لَهُ بِعَذَابِ اللهِ  .","","Al-Mu'jam al-Kabir 4242","","رافع بن خديج الأنصاري عن أم عبد الحميد بن رافع بن خديج عن يحيى بن عبد الحميد بن رافع بن خديج عن عمرو بن مرزوق الواشحي عن محمد بن كثير العبدي عن محمد بن محمد بن حيان التمار عن الطبراني","من أخباره"
"4245","[4/240]      4243  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  أَحْمَدُ بْنُ سِنَانٍ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  رِفَاعَةُ بْنُ هُرَيْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  حَدَّثَنَا  جَدِّي ،  عَنْ  أَبِيهِ  قَالَ :  جِئْتُ أَنَا وَعَمِّي إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُرِيدُ  بَدْرًا  ، فَقُلْتُ : يَا رَسُولَ اللهِ إِنِّي أُرِيدُ أَنْ أَخْرُجَ مَعَكَ فَجَعَلَ يَقْبِضُ يَدَهُ وَيَقُولُ :  إِنِّي أَسْتَصْغِرُكَ وَلَا أَدْرِي مَا تَصْنَعُ إِذَا لَقِيتَ  الْقَوْمَ  ؟ فَقُلْتُ : أَتَعْلَمُ أَنِّي أَرْمَى مَنْ رَمَى ؟ فَرَدَّنِي  .","","Al-Mu'jam al-Kabir 4243","","رافع بن خديج الأنصاري عن عبد الرحمن بن رافع بن خديج الأنصاري عن رفاعة بن هرير المديني عن يعقوب بن محمد بن عيسى عن أحمد بن سنان القطان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","من أخباره"
"4246","4244  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ الْهَدَادِيُّ ،  حَدَّثَنِي  أَبُو عَمْرٍو ،  أَنَّهُ شَهِدَ جِنَازَةَ  رَافِعِ بْنِ خَدِيجٍ  وَنِسَاءٌ يَبْكِينَ ، فَقَامَ  عَبْدُ اللهِ بْنُ عُمَرَ  فَقَالَ :  إِنَّ رَافِعَ بْنَ خَدِيجٍ شَيْخٌ كَبِيرٌ لَا طَاقَةَ لَهُ بِعَذَابِ اللهِ  .","","Al-Mu'jam al-Kabir 4244","","رافع بن خديج الأنصاري عن بشر بن حرب عن خالد بن يزيد اللؤلؤي عن فضيل بن حسين الجحدري عن عبد الله بن أحمد بن حنبل عن الطبراني","من أخباره"
"4247","4245  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ، قَالَ :  تُوُفِّيَ  رَافِعُ بْنُ خَدِيجٍ  سَنَةَ ثَلَاثٍ وَسَبْعِينَ  بِالْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 4245","","","من أخباره"
"4248","4246  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ ، فُسْتُقَةُ  ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ  ،  عَنِ  الْوَاقِدِيِّ  ، قَالَ :  وَفِيهَا مَاتَ  رَافِعُ بْنُ خَدِيجٍ  فِي أَوَّلِ هَذِهِ السَّنَةِ  وَحَضَرَ  ابْنُ عُمَرَ  رَحِمَهُ اللهُ جِنَازَتَهُ -  يَعْنِي سَنَةَ ثَلَاثٍ وَسَبْعِينَ  - وَكَانَ  لِرَافِعٍ  يَوْمَ مَاتَ سِتٌّ وَثَمَانُونَ  .","","Al-Mu'jam al-Kabir 4246","","","من أخباره"
"4249","4247  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ  ، قَالَ :  مَاتَ  رَافِعُ بْنُ خَدِيجٍ  فِي سَنَةِ أَرْبَعٍ وَسَبْعِينَ فِي أَوَّلِهَا  .","","Al-Mu'jam al-Kabir 4247","","","من أخباره"
"4250","وَمَا  أَسْنَدَ  رَافِعُ بْنُ خَدِيجٍ  عَبْدُ اللهِ بْنُ عُمَرَ  عَنْ  رَافِعٍ  4248  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَمْرِو         [4/241]      بْنِ دِينَارٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ يَقُولُ :  مَا كُنَّا نَكْرَهُ الْمُزَارَعَةَ حَتَّى  سَمِعْتُ  رَافِعَ بْنَ خَدِيجٍ ، يَقُولُ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمُزَارَعَةِ  .","","Al-Mu'jam al-Kabir 4248","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عمر عن رافع"
"4251","4249  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ، قَالَا :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا نُخَابِرُ وَلَا نَرَى بَأْسًا  حَتَّى زَعَمَ رَافِعُ بْنُ خَدِيجٍ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهُ ، وَتَرَكْنَاهُ مِنْ أَجْلِ قَوْلِهِ  .","","Al-Mu'jam al-Kabir 4249","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","عبد الله بن عمر عن رافع"
"4252","4250  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ :  كُنَّا لَا نَرَى بِالْخِبْرِ بَأْسًا حَتَّى كَانَ عَامَ أَوَّلٍ  ، فَزَعَمَ رَافِعُ بْنُ خَدِيجٍ أَنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهُ  .","","Al-Mu'jam al-Kabir 4250","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن حماد بن زيد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن عمر عن رافع"
"4253","4251  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، قَالَا :  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَيُّوبُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ، قَالَ :  سَمِعْتُ  ابْنَ عُمَرَ ، يَقُولُ :  مَا كُنَّا نَرَى بِالْخِبْرِ بَأْسًا  ، حَتَّى زَعَمَ رَافِعُ بْنُ خَدِيجٍ عَامَ أَوَّلٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهُ  .","","Al-Mu'jam al-Kabir 4251","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن أيوب السختياني عن إسماعيل ابن علية عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن عمر عن رافع"
"4254","4252  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ أَبِي خَيْثَمَةَ ،  ثَنَا  عُمَرُ بْنُ يَحْيَى الْأُبُلِّيُّ  ثَنَا  عَبْدُ الْوَارِثِ ،  ثَنَا  أَيُّوبُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كُنَّا لَا نَرَى بِالْخِبْرِ بَأْسًا ،  فَقَالَ رَافِعُ بْنُ خَدِيجٍ : نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Al-Mu'jam al-Kabir 4252","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن عمرو بن دينار الأثرم عن أيوب السختياني عن عبد الوارث بن سعيد بن ذكوان عن عمر بن يحيى الأبلي عن محمد بن أحمد بن أبي خيثمة النسائي عن الطبراني","عبد الله بن عمر عن رافع"
"4255","4253  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  قَالَ  ابْنُ عُمَرَ :  لَقَدْ مَنَعَنَا  رَافِعُ بْنُ خَدِيجٍ  نَفْعَ أَرْضِنَا  .","","Al-Mu'jam al-Kabir 4253","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن صالح بن أبي مريم الضبعي عن أيوب السختياني عن حماد بن زيد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن عمر عن رافع"
"4256","4254  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ نَاجِيَةَ ،  ثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَبُو عَاصِمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [4/242]      نَهَى عَنْ كِرَاءِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4254","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن سفيان الثوري عن أبو عاصم النبيل عن أحمد بن منصور الرمادي عن عبد الله بن محمد بن ناجية البربري عن الطبراني","عبد الله بن عمر عن رافع"
"4257","4255  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ مُكْرَمٍ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  أَنَا  أَشْعَثُ ،  عَنِ  ابْنِ سِيرِينَ ،  أَنَّ  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا قَالَ :  كُنَّا لَا نَرَى بِكِرَاءِ الْأَرْضِ بَأْسًا حَتَّى  حَدَّثَنَا  رَافِعُ بْنُ خَدِيجٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كِرَاءِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4255","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن محمد بن سيرين عن أشعث الحمراني عن النضر بن شميل عن محمود بن غيلان المروزي عن محمد بن الحسين بن مكرم البارع عن الطبراني","عبد الله بن عمر عن رافع"
"4258","أُسَيْدُ بْنُ ظُهَيْرٍ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4256  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أُسَيْدِ بْنِ ظُهَيْرٍ ، قَالَ :  جَاءَنَا رَافِعُ بْنُ خَدِيجٍ فَذَكَرَ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنِ  الْمُحَاقَلَةِ  وَقَالَ :  مَنْ كَانَ لَهُ أَرْضٌ فَاسْتَغْنَى عَنْهَا  فَلْيَمْنَحْهَا  أَخَاهُ  .  وَنَهَى عَنِ  الْمُزَابَنَةِ  .","","Al-Mu'jam al-Kabir 4256","","رافع بن خديج الأنصاري عن أسيد بن ظهير الحارثي عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","أسيد بن ظهير عن رافع بن خديج"
"4259","السَّائِبُ بْنُ يَزِيدَ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4257  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَبْدِ الْأَعْلَى الْبَوْسِيُّ الصَّنْعَانِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ قَارِظٍ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .","","Al-Mu'jam al-Kabir 4257","","رافع بن خديج الأنصاري عن السائب بن يزيد الكندي عن إبراهيم بن عبد الله بن قارظ الكناني عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن الحسن بن عبد الأعلى البوسي عن الطبراني","السائب بن يزيد عن رافع بن خديج"
"4260","4258  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الشِّبَامِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ قَارِظٍ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَسْبُ الْحَجَّامِ         [4/243]      خَبِيثٌ  ، وَمَهْرُ  الْبَغِيِّ  خَبِيثٌ  ، وَثَمَنُ الْكَلْبِ خَبِيثٌ  .","","Al-Mu'jam al-Kabir 4258","","رافع بن خديج الأنصاري عن السائب بن يزيد الكندي عن إبراهيم بن عبد الله بن قارظ الكناني عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عبد الله الشبامي عن الطبراني","السائب بن يزيد عن رافع بن خديج"
"4261","4259  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ ،  ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ قَارِظٍ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ ،  عَنْ  رَافِعٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كَسْبُ الْحَجَّامِ خَبِيثٌ  ، وَمَهْرُ  الْبَغِيِّ  خَبِيثٌ  ، وَثَمَنُ الْكَلْبِ خَبِيثٌ  .","","Al-Mu'jam al-Kabir 4259","","رافع بن خديج الأنصاري عن السائب بن يزيد الكندي عن إبراهيم بن عبد الله بن قارظ الكناني عن يحيى بن أبي كثير عن هشام الدستوائي عن حجاج بن نصير الفساطيطي عن إبراهيم بن صالح الشيرازي عن الطبراني","السائب بن يزيد عن رافع بن خديج"
"4262","4260  -  حَدَّثَنَا  زَكَرِيَّا بْنُ حَمْدَوَيْهِ الصَّفَّارُ ،  ثَنَا  عَفَّانُ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ قَارِظٍ ،  عَنِ  السَّائِبِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كَسْبُ الْحَجَّامِ خَبِيثٌ  ، وَمَهْرُ  الْبَغِيِّ  خَبِيثٌ  ، وَثَمَنُ الْكَلْبِ خَبِيثٌ  .","","Al-Mu'jam al-Kabir 4260","","رافع بن خديج الأنصاري عن السائب بن يزيد الكندي عن إبراهيم بن عبد الله بن قارظ الكناني عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن عفان بن مسلم الصفار عن زكريا بن حمدويه الصفار عن الطبراني","السائب بن يزيد عن رافع بن خديج"
"4263","4261  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  مُحَمَّدِ بْنِ يُوسُفَ الْأَعْرَجِ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بِئْسَ الْكَسْبُ مَهْرُ  الْبَغِيِّ  ، وَثَمَنُ الْكَلْبِ ، وَكَسْبُ الْحَجَّامِ  .","","Al-Mu'jam al-Kabir 4261","","رافع بن خديج الأنصاري عن السائب بن يزيد الكندي عن محمد بن يوسف بن عبد الله الأعرج عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن عبد الله بن أحمد بن حنبل عن الطبراني","السائب بن يزيد عن رافع بن خديج"
"4264","4262  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ، قَالُوا :  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يُوسُفَ ، قَالَ :  سَمِعْتُ  السَّائِبَ بْنَ يَزِيدَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  بِئْسَ الْكَسْبُ مَهْرُ  الْبَغِيِّ  ، وَثَمَنُ الْكَلْبِ ، وَكَسْبُ الْحَجَّامِ  .","","Al-Mu'jam al-Kabir 4262","","رافع بن خديج الأنصاري عن السائب بن يزيد الكندي عن محمد بن يوسف بن عبد الله الأعرج عن يحيى القطان عن محمد بن أبي بكر المقدمي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن عبد الله بن أحمد بن حنبل عن الطبراني","السائب بن يزيد عن رافع بن خديج"
"4265","4263  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَابَانَ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ حُرَيْثٍ ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  ثَنَا  جُعَيْدُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  يَزِيدَ بْنِ خُصَيْفَةَ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ يَقُولُ :  شَرُّ الْكَسْبِ كَسْبُ الْحَجَّامِ  ، وَثَمَنُ الْكَلْبِ ، وَمَهْرُ  الْبَغِيِّ  .","","Al-Mu'jam al-Kabir 4263","","رافع بن خديج الأنصاري عن السائب بن يزيد الكندي عن يزيد بن عبد الله بن خصيفة الكندي عن الجعد بن عبد  الرحمن بن أوس الكندي عن الفضل بن موسى السيناني عن الحسين بن حريث الخزاعي عن محمد بن جابان الجند يسابوري عن الطبراني","السائب بن يزيد عن رافع بن خديج"
"4266","سَالِمُ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4264  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  ثَنَا         [4/244]      جُوَيْرِيَةُ بْنُ أَسْمَاءَ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنِ  الزُّهْرِيِّ ،  أَنَّ  سَالِمَ بْنَ عَبْدِ اللهِ  ،  خَبَّرَهُ  ، وَسَأَلَهُ عَنْ كَرْيِ الْمَزَارِعِ ، فَقَالَ :  أَخْبَرَ  رَافِعُ بْنُ خَدِيجٍ  عَبْدَ اللهِ بْنَ عُمَرَ  ، أَنَّ عَمَّيْهِ وَكَانَا شَهِدَا  بَدْرًا  حَدَّثَاهُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كَرْيِ الْمَزَارِعِ  . فَتَرَكَ  عَبْدُ اللهِ بْنُ عُمَرَ  كِرَاءَهَا وَقَدْ كَانَ يُكْرِيهَا قَبْلَ ذَلِكَ  ،  قَالَ  الزُّهْرِيُّ  : فَقُلْتُ  لِسَالِمٍ  : أَتَكْرِيهَا أَنْتَ ؟ قَالَ : نَعَمْ ، قُلْتُ : فَأَيْنَ حَدِيثُ  رَافِعِ بْنِ خَدِيجٍ  ؟ قَالَ  سَالِمٌ  : إِنَّ  رَافِعًا  أَكْثَرَ عَلَى نَفْسِهِ .","","Al-Mu'jam al-Kabir 4264","","ظهير بن رافع الأوسي عن رافع بن خديج الأنصاري عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن مالك بن أنس عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سالم بن عبد الله بن عمر عن رافع بن خديج"
"4267","4265  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  ثَنَا  أَبُو أُوَيْسٍ عَبْدُ اللهِ بْنُ عَبْدِ اللهِ ،  عَنِ  الزُّهْرِيِّ ، قَالَ :  سَأَلْتُ  سَالِمَ بْنَ عَبْدِ اللهِ ، عَنْ كِرَاءِ الْمَزَارِعِ ؟ فَقَالَ :  أَخْبَرَنِي  رَافِعُ بْنُ خَدِيجٍ عِنْدَ  عَبْدِ اللهِ بْنِ عُمَرَ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كِرَاءِ الْمَزَارِعِ  .","","Al-Mu'jam al-Kabir 4265","","رافع بن خديج الأنصاري عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عبد الله بن عبد الله بن أويس عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سالم بن عبد الله بن عمر عن رافع بن خديج"
"4268","4266  -  حَدَّثَنَا  أَحْمَدُ بْنُ طَاهِرِ بْنِ حَرْمَلَةَ بْنِ يَحْيَى ،  ثَنَا  جَدِّي ،  ثَنَا  إِدْرِيسُ بْنُ يَحْيَى الْخَوْلَانِيُّ ،  حَدَّثَنِي  حَيْوَةُ بْنُ شُرَيْحٍ ،  عَنْ  عُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  أَخْبَرَنِي  سَالِمٌ  ،  أَنَّ أَبَاهُ كَانَ يَفْعَلُ ذَلِكَ حَتَّى بَلَغَهُ  أَنَّ  رَافِعَ بْنَ خَدِيجٍ قَالَ :  نَهَى رَسُولُ اللهِ عَنْ كِرَاءِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4266","","رافع بن خديج الأنصاري عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن عقيل بن خالد الأيلي عن حيوة بن شريح التجيبي عن إدريس بن يحيى الخولاني عن حرملة بن يحيى التجيبي عن أحمد بن طاهر بن حرملة التجيبي عن الطبراني","سالم بن عبد الله بن عمر عن رافع بن خديج"
"4269","سَعِيدُ بْنُ الْمُسَيِّبِ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4267  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  ثَنَا  أَبُو جَعْفَرٍ الْخَطْمِيُّ ، قَالَ :  أَتَيْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ ، فَقُلْتُ : بَلَغَنَا عَنْكَ شَيْءٌ فِي الْمُزَارَعَةِ ،  فَقَالَ  : كَانَ  ابْنُ عُمَرَ  لَا يَرَى بِهِ بَأْسًا حَتَّى ذَكَرَ لَهُ  رَافِعُ بْنُ خَدِيجٍ  فِيهِ حَدِيثًا ، فَأَتَى  رَافِعًا  فَأَخْبَرَهُ  رَافِعٌ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَتَى  بَنِي حَارِثَةَ  فَرَأَى زَرْعًا فِي أَرْضِ  ظُهَيْرٍ  ، فَقَالَ :  مَا أَحْسَنَ زَرْعَ  ظُهَيْرٍ  !  فَقَالُوا : لَيْسَتْ  لِظُهَيْرٍ  قَالَ : أَلَيْسَتْ أَرْضَ  ظُهَيْرٍ  ؟ قَالُوا : بَلَى ، وَلَكِنَّهُ زَرْعُ         [4/245]      فُلَانٍ ، قَالَ : فَرُدُّوا عَلَيْهِ نَفَقَتَهُ وَخُذُوا زَرْعَكُمْ قَالَ  رَافِعٌ  : فَرَدَدْنَا عَلَيْهِ نَفَقَتَهُ وَأَخَذْنَا زَرْعَنَا  .","","Al-Mu'jam al-Kabir 4267","","رافع بن خديج الأنصاري عن سعيد بن المسيب عن عمير بن يزيد بن عمير الخطمي عن يحيى القطان عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سعيد بن المسيب عن رافع بن خديج"
"4270","4268  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ الْأَنْمَاطِيُّ ،  ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ،  ثَنَا  أَبُو جَعْفَرٍ عُمَيْرُ بْنُ يَزِيدَ الْأَنْصَارِيُّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 4268","","رافع بن خديج الأنصاري عن سعيد بن المسيب عن عمير بن يزيد بن عمير الخطمي عن مروان بن معاوية الفزاري عن يحيى بن معين عن محمد بن الحسين الأنماطي عن الطبراني","سعيد بن المسيب عن رافع بن خديج"
"4271","4269  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ، (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  مَالِكُ بْنُ زِيَادٍ الْكُوفِيُّ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  أَبُو الْأَحْوَصِ ،  ثَنَا  طَارِقُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْمُحَاقَلَةِ  وَالْمُزَابَنَةِ  ، وَقَالَ : إِنَّمَا يَزْرَعُ ثَلَاثَةٌ : رَجُلٌ لَهُ أَرْضٌ فَيَزْرَعُهَا ، وَرَجُلٌ مُنِحَ أَرْضًا فَهُوَ يَزْرَعُ ، وَرَجُلٌ اسْتَكْرَى بِذَهَبٍ أَوْ فِضَّةٍ  .","","Al-Mu'jam al-Kabir 4269","","رافع بن خديج الأنصاري عن سعيد بن المسيب عن طارق بن عبد الرحمن البجلي عن سلام بن سليم الحنفي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سعيد بن المسيب عن رافع بن خديج"
"4272","4270  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ الْكَرْمَانِيُّ عَمُّ عَطِيَّةَ بْنِ عَطِيَّةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ، قَالَ :  كُنْتُ عِنْدَ سَعِيدِ بْنِ الْمُسَيِّبِ جَالِسًا فَذَكَرُوا أَنَّ أَقْوَامًا يَقُولُونَ قَدَّرَ اللهُ كُلَّ شَيْءٍ مَا خَلَا الْأَعْمَالِ ، قَالَ : فَوَاللهِ مَا رَأَيْتُ  سَعِيدَ بْنَ الْمُسَيِّبِ  غَضِبَ غَضَبًا أَشَدَّ مِنْهُ حَتَّى هَمَّ بِالْقِيَامِ ، ثُمَّ سَكَنَ فَقَالَ : تَكَلَّمُوا بِهِ ؟ أَمَا وَاللهِ لَقَدْ سَمِعْتُ فِيهِمْ حَدِيثًا كَفَاهُمْ بِهِ شَرًّا ، وَيْحَهُمْ أَوَيَعْلَمُونَ ؟ فَقُلْتُ : يَرْحَمُكَ اللهُ يَا  أَبَا مُحَمَّدٍ  وَمَا هُوَ ؟ قَالَ : فَنَظَرَ إِلَيَّ وَقَدْ سَكَنَ بَعْضُ غَضَبِهِ ، فَقَالَ :  حَدَّثَنِي  رَافِعُ بْنُ خَدِيجٍ أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَكُونُ قَوْمٌ مِنْ أُمَّتِي يَكْفُرُونَ بِاللهِ وَبِالْقُرَآنِ وَهُمْ لَا يَشْعُرُونَ  كَمَا كَفَرَتِ الْيَهُودُ وَالنَّصَارَى ، قَالَ : قُلْتُ : جُعِلْتُ فِدَاكَ يَا رَسُولَ اللهِ وَكَيْفَ ذَاكَ ؟ قَالَ : يُقِرُّونَ بِبَعْضِ         [4/246]      الْقَدَرِ وَيَكْفُرُونَ بِبَعْضِهِ قَالَ : قُلْتُ : ثُمَّ مَا يَقُولُونَ ؟ قَالَ : يَقُولُونَ : الْخَيْرُ مِنَ اللهِ وَالشَّرُّ مِنْ إِبْلِيسَ ، فَيُقِرُّونَ عَلَى ذَلِكَ كِتَابَ اللهِ وَيَكْفُرُونَ بِالْقُرْآنِ بَعْدَ الْإِيمَانِ وَالْمَعْرِفَةِ ، فَمَا يَلْقَى أُمَّتِي مِنْهُمْ مِنَ الْعَدَاوَةِ وَالْبَغْضَاءِ وَالْجِدَالِ أُولَئِكَ زَنَادِقَةُ هَذِهِ الْأُمَّةِ فِي زَمَانِهِمْ يَكُونُ ظُلْمُ السُّلْطَانِ ، فَيَنَالُهُمْ مِنْ ظُلْمٍ وَحَيْفٍ وَأَثَرَةٍ ، ثُمَّ يَبْعَثُ اللهُ عَزَّ وَجَلَّ طَاعُونًا فَيُفْنِي عَامَّتَهُمْ ، ثُمَّ يَكُونُ الْخَسْفُ فَمَا أَقَلَّ مَا يَنْجُو مِنْهُمُ ، الْمُؤْمِنُ يَوْمَئِذٍ قَلِيلٌ فَرَحُهُ ، شَدِيدٌ غَمُّهُ ، ثُمَّ يَكُونُ الْمَسْخُ فَيَمْسَخُ اللهُ عَزَّ وَجَلَّ عَامَّةَ أُولَئِكَ قِرَدَةً وَخَنَازِيرَ ، ثُمَّ يَخْرُجُ  الدَّجَّالُ  عَلَى أَثَرِ ذَلِكَ قَرِيبًا ثُمَّ بَكَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى بَكَيْنَا لِبُكَائِهِ ، قُلْنَا : مَا يُبْكِيكَ ؟ قَالَ : رَحْمَةً ، لَهُمُ الْأَشْقِيَاءِ ، لِأَنَّ فِيهِمُ الْمُتَعَبِّدَ ، وَمِنْهُمُ الْمُجْتَهِدَ ، مَعَ أَنَّهُمْ لَيْسُوا بِأَوَّلِ مَنْ سَبَقَ إِلَى هَذَا الْقَوْلِ ، وَضَاقَ بِحَمْلِهِ  ذَرْعًا  ، إِنَّ عَامَّةَ مَنْ هَلَكَ مِنْ  بَنِي إِسْرَائِيلَ  بِالتَّكْذِيبِ بِالْقَدَرِ قُلْتُ : جُعِلْتُ فِدَاكَ يَا رَسُولَ اللهِ فَقُلْ لِي كَيْفَ الْإِيمَانُ بِالْقَدَرِ ؟ قَالَ : تُؤْمِنُ بِاللهِ وَحْدَهُ وَأَنَّهُ لَا يَمْلِكُ مَعَهُ أَحَدٌ ضَرًّا وَلَا نَفْعًا ، وَتُؤْمِنُ بِالْجَنَّةِ وَالنَّارِ وَتَعْلَمُ أَنَّ اللهَ عَزَّ وَجَلَّ خَالِقُهُمَا قَبْلَ خَلْقِ الْخَلْقِ ، ثُمَّ خَلَقَ خَلْقَهُ فَجَعَلَهُمْ مَنْ شَاءَ مِنْهُمْ لِلْجَنَّةِ ، وَمَنْ شَاءَ مِنْهُمْ لِلنَّارِ ، عَدْلًا ذَلِكَ مِنْهُ ، وَكُلٌّ يَعْمَلُ لِمَا فُرِغَ لَهُ وَهُوَ صَائِرٌ إِلَى مَا فُرِغَ مِنْهُ قُلْتُ : صَدَقَ اللهُ وَرَسُولُهُ  .","","Al-Mu'jam al-Kabir 4270","","رافع بن خديج الأنصاري عن سعيد بن المسيب عن عمرو بن شعيب عن عطاء بن أبي رباح عن حسان بن إبراهيم الكرماني عن حجاج بن نصير الفساطيطي عن أبو مسلم الكجي عن الطبراني","سعيد بن المسيب عن رافع بن خديج"
"4273","4271  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  عَبْدُ الرَّحْمَنِ الْمُقْرِي ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .","","Al-Mu'jam al-Kabir 4271","","رافع بن خديج الأنصاري عن سعيد بن المسيب عن عمرو بن شعيب عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","سعيد بن المسيب عن رافع بن خديج"
"4274","4272  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِي ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِهِ .","","Al-Mu'jam al-Kabir 4272","","رافع بن خديج الأنصاري عن سعيد بن المسيب عن عمرو بن شعيب عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن سليمان بن داود العتكي عن الساجي عن الطبراني","سعيد بن المسيب عن رافع بن خديج"
"4275","4273  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا         [4/247]      صَدَقَةُ بْنُ خَالِدٍ ،  عَنْ  عُمَرَ بْنِ قَيْسٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدِ بْنِ خَالِدِ بْنِ الزُّبَيْرِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَكَلَ ذِرَاعًا  ، فَلَمَّا فَرَغَ أَمَرَّ أَصَابِعَهُ عَلَى الْجِدَارِ ، ثُمَّ صَلَّى الْعَصْرَ وَالْمَغْرِبَ وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 4273","","رافع بن خديج الأنصاري عن سعيد بن المسيب عن إبراهيم بن محمد بن خالد بن الزبير عن عمر بن قيس سندل عن صدقة بن خالد السمين عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","سعيد بن المسيب عن رافع بن خديج"
"4276","4274  -  حَدَّثَنَا  أَبُو عَقِيلٍ أَنَسُ بْنُ سَلْمٍ الْخَوْلَانِيُّ ،  ثَنَا  أَبُو الْأَصْبَغِ الْحَرَّانِيُّ عَبْدُ الْعَزِيزِ بْنُ يَحْيَى ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  عَنِ  الْأَحْوَصِ بْنِ حَكِيمٍ ،  عَنْ  أَبِي عَوْنٍ الْأَنْصَارِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ أَنَّ النَّبِيَّ  نَهَى عَنْ كِرَاءِ الْأَعَاجِمِ وَشِرَائِهَا  .","","Al-Mu'jam al-Kabir 4274","","رافع بن خديج الأنصاري عن سعيد بن المسيب عن عبد الله بن أبي عبد الله الشامي الأعور عن أحوص بن حكيم عن عيسى بن يونس بن أبي إسحاق عن عبد العزيز بن يحيى البكائي عن أنس بن سلم الأنطرسوسي عن الطبراني","سعيد بن المسيب عن رافع بن خديج"
"4277","أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4275  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  إِسْحَاقُ بْنُ عَبْدِ اللهِ بْنِ حُمْرَانَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ،  عَنِ  الْأَسْوَدِ بْنِ الْعَلَاءِ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ  نَهَى عَنِ  الْمُحَاقَلَةِ  وَالْمُزَابَنَةِ  .","","Al-Mu'jam al-Kabir 4275","","رافع بن خديج الأنصاري عن أبو سلمة بن عبد الرحمن عن الأسود بن العلاء الثقفي عن عبد الحميد بن جعفر الأوسي عن عبد الله بن حمران مولى عثمان بن عفان عن إسحاق بن عبد الله بن حمران عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو سلمة بن عبد الرحمن بن عوف عن رافع بن خديج"
"4278","الْقَاسِمُ بْنُ مُحَمَّدٍ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4276  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ ،  ثَنَا  عَمْرُو بْنُ أَبِي عَاصِمٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عُثْمَانُ بْنُ مُرَّةَ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كَرْيِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4276","","رافع بن خديج الأنصاري عن القاسم بن محمد بن أبي بكر الصديق عن عثمان بن مرة البصري عن أبو عاصم النبيل عن عمرو بن الضحاك بن مخلد عن الحسن بن علي بن شبيب المعمري عن الطبراني","القاسم بن محمد عن رافع بن خديج"
"4279","4277  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ النَّسَائِيُّ ،  أَنَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ خَلِيٍّ الْحِمْصِيُّ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  سَلَمَةَ بْنِ عَبْدِ الْمَلِكِ الْعَوْضِيِّ ،  عَنِ  الْحَسَنِ بْنِ صَالِحٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4277","","رافع بن خديج الأنصاري عن القاسم بن محمد بن أبي بكر الصديق عن يحيى بن سعيد الأنصاري عن الحسن بن صالح بن صالح بن حي عن سلمة بن عبد الملك العوصي عن خالد بن خلي الكلاعي عن محمد بن خالد بن خلي الكلاعي عن النسائي عن الطبراني","القاسم بن محمد عن رافع بن خديج"
"4280","[4/248]      -  سُلَيْمَانُ بْنُ يَسَارٍ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4278  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ، قَالَ :  كَتَبَ إِلَيَّ  يَعْلَى بْنُ حَكِيمٍ ،  وَسَمِعْتُهُ مِنْهُ  بَعْدُ قَالَ :  سَأَلْتُ  سُلَيْمَانَ بْنَ يَسَارٍ فَقَالَ  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ :  كُنَّا نُحَاقِلُ الْأَرْضَ فَنُكْرِيهَا عَلَى الثُّلُثِ وَالرُّبُعِ وَالطَّعَامِ الْمُسَمَّى  فَأَمَرَنَا بِالْأَرْضِ أَنْ نَزْرَعَهَا أَوْ نُزْرِعَهَا وَكَرِهَ كِرَاءَهَا وَمَا سِوَى ذَلِكَ  .","","Al-Mu'jam al-Kabir 4278","","رافع بن خديج الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يعلى بن حكيم الثقفي عن أيوب السختياني عن حماد بن زيد عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سليمان بن يسار عن رافع بن خديج"
"4281","4279  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ، قَالَ :  كَتَبَ إِلَيَّ  يَعْلَى بْنُ حَكِيمٍ : إِنِّي  سَمِعْتُ  سُلَيْمَانَ بْنَ يَسَارٍ ،  يُحَدِّثُ عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ :  كُنَّا نُحَاقِلُ الْأَرْضَ فَنُكْرِيهَا بِالثُّلُثِ وَالرُّبُعِ وَالطَّعَامِ الْمُسَمَّى فَدَخَلَ عَلَيَّ بَعْضُ عُمُومَتِي  فَقَالَ  : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَانَا الْيَوْمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا وَطَاعَةُ اللهِ وَرَسُولِهِ أَنْفَعُ ، كُنَّا نُحَاقِلُ الْأَرْضَ فَنُكْرِيهَا بِالثُّلُثِ وَالرُّبُعِ وَالطَّعَامِ الْمُسَمَّى ،  فَنَهَانَا أَنْ نُكْرِيَهَا بِالرُّبُعِ وَالثُّلُثِ وَالطَّعَامِ الْمُسَمَّى  ، وَأَمَرَ رَبَّ الْأَرْضِ أَنْ يَزْرَعَهَا أَوْ يُزْرِعَهَا  .","","Al-Mu'jam al-Kabir 4279","","أحد الصحابة عن رافع بن خديج الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يعلى بن حكيم الثقفي عن أيوب السختياني عن حماد بن زيد عن محمد بن عبيد بن حساب الغبري عن عبد الله بن أحمد الجواليقي عن الطبراني","سليمان بن يسار عن رافع بن خديج"
"4282","4280  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَيُّوبُ ،  عَنْ  يَعْلَى بْنِ حَكِيمٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا نُحَاقِلُ بِالْأَرْضِ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنُكْرِيهَا عَلَى الثُّلُثِ وَالرُّبُعِ وَالطَّعَامِ الْمُسَمَّى ، فَجَاءَنَا ذَاتَ يَوْمٍ رَجُلٌ مِنْ عُمُومَتِي ، فَقَالَ : نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَطَوَاعِيَةُ اللهِ وَرَسُولِهِ أَنْفَعُ لَنَا ،  نَهَانَا أَنْ نُحَاقِلَ الْأَرْضَ  ، أَنْ نُكْرِيَهَا عَلَى الثُّلُثِ وَالرُّبُعِ وَالطَّعَامِ الْمُسَمَّى ، وَأَمَرَ رَبَّ الْأَرْضِ أَنْ يَزْرَعَهَا أَوْ يُزْرِعَهَا ، وَكَرِهَ كِرَاءَهَا وَمَا سِوَى ذَلِكَ  .","","Al-Mu'jam al-Kabir 4280","","ظهير بن رافع الأوسي عن رافع بن خديج الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يعلى بن حكيم الثقفي عن أيوب السختياني عن إسماعيل ابن علية عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سليمان بن يسار عن رافع بن خديج"
"4283","4281  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدَةُ بْنُ سُلَيْمَانَ ، (  ح  )  وَحَدَّثَنَا  إِسْحَاقُ بْنُ خَالَوَيْهِ الْوَاسِطِيُّ ،  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  يَعْلَى بْنِ حَكِيمٍ ،         [4/249]      عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا نُحَاقِلُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَالْمُحَاقَلَةُ أَنْ يُعْطِيَ الرَّجُلُ أَرْضَهُ عَلَى الثُّلُثِ أَوِ الرُّبُعِ أَوْ عَلَى طَعَامٍ مُسَمًّى ، فَأَتَانَا بَعْضُ عُمُومَتِي  فَقَالَ  : نَهَانَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَطَوَاعِيَةُ اللهِ وَطَوَاعِيَةُ رَسُولِهِ أَنْفَعُ لَنَا ، قُلْنَا : وَمَا ذَاكَ ؟ قَالَ : قَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا أَوْ لِيُزْرِعْهَا أَخَاهُ وَلَا يُكَارِيهَا بِثُلُثٍ أَوْ رُبُعٍ وَلَا بِطَعَامٍ مُسَمًّى  .","","Al-Mu'jam al-Kabir 4281","","ظهير بن رافع الأوسي عن رافع بن خديج الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يعلى بن حكيم الثقفي عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن العباس بن الوليد النرسي عن إسحاق بن خالويه البابسيري عن الطبراني","سليمان بن يسار عن رافع بن خديج"
"4284","4282  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  أَحْمَدُ بْنُ عِيسَى الْمِصْرِيُّ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  يَعْلَى بْنِ حَكِيمٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا نُحَاقِلُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَالْمُحَاقَلَةُ أَنْ يُكْرِيَ الرَّجُلُ أَرْضَهُ بِالثُّلُثِ أَوِ الرُّبُعِ أَوْ بِطَعَامٍ مُسَمًّى فَأَتَى بَعْضُ عُمُومَتِهِ فَقَالَ : نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَطَوَاعِيَةُ اللهِ وَرَسُولِهِ أَنْفَعُ لَنَا ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا أَوْ لِيُزْرِعْهَا أَخَاهُ وَلَا يُكْرِيهَا بِالثُّلُثِ وَالرُّبُعِ وَلَا بِطَعَامٍ مُسَمًّى  .","","Al-Mu'jam al-Kabir 4282","","رافع بن خديج الأنصاري عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يعلى بن حكيم الثقفي عن جرير بن حازم عن عبد الله بن وهب المصري عن أحمد بن عيسى بن حسان التستري عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سليمان بن يسار عن رافع بن خديج"
"4285","مَحْمُودُ بْنُ لَبِيدٍ الْأَنْصَارِيُّ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4283  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَسْفِرُوا  بِالْفَجْرِ  ، فَإِنَّهُ أَعْظَمُ  لِلْأَجْرِ أَوْ لِأَجْرِكُمْ  .","","Al-Mu'jam al-Kabir 4283","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن عجلان عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4286","4284  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ، وَابْنِ عُيَيْنَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَسْفِرُوا  بِصَلَاةِ         [4/250]      الْغَدَاةِ  فَإِنَّهُ أَعْظَمُ لِلْأَجْرِ  .","","Al-Mu'jam al-Kabir 4284","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن عجلان عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4287","4285  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  ثَنَا  مُحَمَّدُ بْنُ جَارِيَةَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَصْبِحُوا  بِالصُّبْحِ ، فَإِنَّهُ أَعْظَمُ لِلْأَجْرِ  .","","Al-Mu'jam al-Kabir 4285","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن جارية عن إسماعيل بن عياش الأحول عن عبد الوهاب بن نجدة عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4288","4286  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أَسْفِرُوا  بِالصُّبْحِ  ، فَإِنَّهُ أَعْظَمُ لِلْأَجْرِ  .","","Al-Mu'jam al-Kabir 4286","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن شعبة بن الحجاج عن حفص بن عمر الحوضى عن محمد بن يحيى بن المنذر القزاز عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4289","4287  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُغِيرَةِ ،  ثَنَا  النُّعْمَانُ بْنُ عَبْدِ السَّلَامِ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ وَمُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَسْفِرُوا  بِصَلَاةِ الصُّبْحِ  ، فَإِنَّهُ أَعْظَمُ لِلْأَجْرِ  .","","Al-Mu'jam al-Kabir 4287","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن عجلان عن سفيان الثوري عن النعمان بن عبد السلام عن محمد بن المغيرة ابن أبي مريم الأصبهاني عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4290","4288  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ حَمْدَانَ الْحَنَفِيُّ الْأَصْبَهَانِيُّ ،  ثَنَا  مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ،  ثَنَا  حُسَيْنُ بْنُ عَلِيٍّ ،  عَنْ  زَائِدَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 4288","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن زائدة بن قدامة عن الحسين بن علي الجعفي عن موسى بن عبد الرحمن بن سعيد المسروقي عن العباس بن حمدان الأصبهاني عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4291","4289  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  يَزِيدُ بْنُ عِيَاضٍ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعَامِلُ  عَلَى الصَّدَقَةِ بِالْحَقِّ كَالْغَازِي فِي  سَبِيلِ  اللهِ  حَتَّى يَرْجِعَ  .","","Al-Mu'jam al-Kabir 4289","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن يزيد بن عياض بن جعدبة الليثي عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4292","4290  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ         [4/251]      خَدِيجٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَسْفِرُوا  بِالصُّبْحِ فَإِنَّهُ أَعْظَمُ لِلْأَجْرِ  .","","Al-Mu'jam al-Kabir 4290","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن يزيد بن زريع العيشي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4293","4291  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ رَاشِدٍ الْأَدَمِيُّ ،  حَدَّثَنَا  مُعَلَّى بْنُ عَبْدِ الرَّحْمَنِ  ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَسْفِرُوا  بِالصُّبْحِ فَإِنَّهُ أَعْظَمُ لِلْأَجْرِ  .  زاد بعده في طبعة مكتبة ابن تيمية : ( عن عبد الرحمن ) وكذا في النسخة الخطية غير أنه ضرب عليها ، وقد أخرجه أبو نعيم في المعرفة ( 2655 ) عن المصنف وليست فيه تلك الزيادة . والله أعلم","","Al-Mu'jam al-Kabir 4291","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن عبد الحميد بن جعفر الأوسي عن معلى بن عبد الرحمن الواسطي عن إبراهيم بن راشد بن سليمان الآدمي عن محمد بن عبدوس السراج عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4294","4292  -  حَدَّثَنَا  أَبُو مَعْنٍ ثَابِتُ بْنُ نُعَيْمٍ الْهَوْجِيُّ ،  حَدَّثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي دَاوُدَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  نَوِّرُوا بِالْفَجْرِ فَإِنَّهُ أَعْظَمُ لِلْأَجْرِ  .","","Al-Mu'jam al-Kabir 4292","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن زيد بن أسلم عن أبو داود المديني عن شعبة بن الحجاج عن آدم بن أبي إياس عن ثابت بن نعيم الهوجي عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4295","4293  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  شُعْبَةَ بْنِ الْحَجَّاجِ ،  حَدَّثَنِي  دَاوُدُ النَّصْرِيُّ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  أَسْفِرُوا  بِصَلَاةِ الْفَجْرِ فَإِنَّهُ أَعْظَمُ لِلْأَجْرِ  .","","Al-Mu'jam al-Kabir 4293","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن زيد بن أسلم عن داود النصري عن شعبة بن الحجاج عن بقية بن الوليد عن عبد الوهاب بن نجدة عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4296","4294  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْقَطَّانُ الْمِصْرِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  أَبُو غَسَّانَ مُحَمَّدُ بْنُ مُطَرِّفٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَجُلٍ مِنَ الْأَنْصَارِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَا  أَسْفَرْتُمْ  بِالْفَجْرِ فَإِنَّهُ أَعْظَمُ لِلْأَجْرِ  .","","Al-Mu'jam al-Kabir 4294","","أحد الصحابة عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن زيد بن أسلم عن محمد بن مطرف بن داود عن سعيد بن الحكم الجمحي عن إسحاق بن إبراهيم بن جابر التجيبي عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4297","4295  -  حَدَّثَنَا  أَبُو زَيْدٍ الْحَوْطِيُّ ،  ثَنَا  أَبُو الْيَمَانِ الْحَكَمُ بْنُ نَافِعٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ :  أَتَانَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  بَنِي عَبْدِ الْأَشْهَلِ  فَصَلَّى بِنَا الْمَغْرِبَ فِي مَسْجِدِنَا ثُمَّ قَالَ :  ارْكَعُوا هَاتَيْنِ الرَّكْعَتَيْنِ فِي بُيُوتِكُمْ  .","","Al-Mu'jam al-Kabir 4295","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن إسماعيل بن عياش الأحول عن أبو اليمان الحكم بن نافع عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4298","[4/252]      4296  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  الْهَيْثَمُ بْنُ خَارِجَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَحَبَّ اللهُ عَزَّ وَجَلَّ عَبْدًا حَمَاهُ  الدُّنْيَا كَمَا يَظَلُّ أَحَدُكُمْ يَحْمِي سَقِيمَهُ الْمَاءَ  .","","Al-Mu'jam al-Kabir 4296","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن إسماعيل بن عياش الأحول عن الهيثم بن خارجة الخراساني عن موسى بن هارون الحمال عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4299","4297  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْبَكْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  قَالَ  نُعَيْمَانُ  : يَا رَسُولَ اللهِ بِي وَعْكٌ شَدِيدٌ مِنَ الْحُمَّى ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فَأَيْنَ أَنْتَ يَا  نُعَيْمَانُ  مِنْ  مَهْيَعَةَ  وَكَانَتْ أَرْضَ وَبِيئَةٍ  .","","Al-Mu'jam al-Kabir 4297","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن عبد الله بن يزيد البكري عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4300","4298  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو عُبَيْدٍ الْقَاسِمُ بْنُ سَلَّامٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعَامِلُ  عَلَى الصَّدَقَةِ بِالْحَقِّ كَالْغَازِي فِي  سَبِيلِ  اللهِ حَتَّى يَرْجِعَ إِلَى بَيْتِهِ  .","","Al-Mu'jam al-Kabir 4298","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن إسماعيل بن جعفر بن أبي كثير الزرقي عن أبو عبيد القاسم بن سلام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4301","4299  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْعَامِلُ  عَلَى الصَّدَقَةِ كَالْغَازِي حَتَّى يَرْجِعَ إِلَى بَيْتِهِ  .","","Al-Mu'jam al-Kabir 4299","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4302","4300  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ ،  ثَنَا  أَحْمَدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْعَامِلُ  عَلَى الصَّدَقَةِ بِالْحَقِّ كَالْغَازِي فِي         [4/253]      سَبِيلِ  اللهِ  .","","Al-Mu'jam al-Kabir 4300","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن أحمد بن خالد بن موسى الوهبي عن أبو زرعة الدمشقي عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4303","4301  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ مُحَمَّدِ بْنِ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ شَبِيبٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  عَمْرِو بْنِ أَبِي عَمْرٍو ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ أَخْوَفَ مَا أَخَافُ عَلَيْكُمُ  الشِّرْكُ  الْأَصْغَرُ  قَالُوا : يَا رَسُولَ اللهِ وَمَا  الشِّرْكُ  الْأَصْغَرُ ؟ قَالَ : الرِّيَاءُ يُقَالُ لِمَنْ يَفْعَلُ ذَلِكَ إِذَا جَاءَ النَّاسُ بِأَعْمَالِهِمُ : اذْهَبُوا إِلَى الَّذِينَ كُنْتُمْ تُرَاءُونَ فَاطْلُبُوا ذَلِكَ عِنْدَهُمْ  .","","Al-Mu'jam al-Kabir 4301","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن عمرو بن أبي عمرو المخزومي عن عبد العزيز بن محمد الدراوردي عن إسماعيل بن أبي أويس عن عبد الله بن شبيب الربعي عن محمد بن أحمد بن محمد المقدمي عن الطبراني","محمود بن لبيد الأنصاري عن رافع بن خديج"
"4304","نَافِعٌ مَوْلَى ابْنِ عُمَرَ  عَنْ  رَافِعٍ  4302  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ، (  ح  )  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ قَالَ :  كَانَ  ابْنُ عُمَرَ  يُكْرِي مَزَارِعَهُ عَلَى عَهْدِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَأَبِي بَكْرٍ  وَعُمَرَ  وَعُثْمَانَ  وَصَدْرٍ مِنْ إِمَارَةِ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُمْ ، فَأَتَاهُ  رَجُلٌ  فَقَالَ :  إِنَّ  رَافِعَ بْنَ خَدِيجٍ يَزْعُمُ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كَرْيِ الْمَزَارِعِ ، قَالَ  نَافِعٌ  : فَانْطَلَقَ  ابْنُ عُمَرَ  إِلَى  رَافِعٍ  ، فَانْطَلَقْتُ مَعَهُ فَقَالَ  ابْنُ عُمَرَ  : مَا الَّذِي بَلَغَنِي عَنْكَ تَذْكُرُ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي كَرْيِ الْمَزَارِعِ ؟ فَقَالَ : نَعَمْ  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كَرْيِ الْمَزَارِعِ  . فَكَانَ  عَبْدُ اللهِ  إِذَا سُئِلَ بَعْدَ ذَلِكَ عَنْ كَرْيِ الْمَزَارِعِ قَالَ : زَعَمَ  رَافِعُ بْنُ خَدِيجٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهُ  .","","Al-Mu'jam al-Kabir 4302","","رافع بن خديج الأنصاري عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن زيد عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","نافع مولى بن عمر عن رافع"
"4305","4303  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، (  ح  )  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَا :  ثَنَا  أَيُّوبُ ،  عَنْ  نَافِعٍ  أَنَّ  رَافِعَ بْنَ خَدِيجٍ يُحَدِّثُ  عَبْدَ اللهِ بْنَ عُمَرَ  ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَنْهَى عَنْ كَرْيِ الْمَزَارِعِ  ، فَتَرَكَهَا  ابْنُ عُمَرَ  وَكَانَ إِذَا سُئِلَ عَنْهَا قَالَ : زَعَمَ  رَافِعٌ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهُ  .","","Al-Mu'jam al-Kabir 4303","","رافع بن خديج الأنصاري عن نافع مولى ابن عمر عن أيوب السختياني عن يزيد بن زريع العيشي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","نافع مولى بن عمر عن رافع"
"4306","4304  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ، قَالَ :  كَانَ  ابْنُ عُمَرَ  يُكْرِي الْمَزَارِعَ ، فَبَلَغَهُ  أَنَّ         [4/254]      رَافِعَ بْنَ خَدِيجٍ يَأْثُرُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَدِيثًا ، فَخَرَجَ إِلَيْهِ  بِالْبَلَاطِ  فَسَأَلَهُ : فَأَخْبَرَهُ  رَافِعٌ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كَرْيِ الْمَزَارِعِ  فَتَرَكَ  عَبْدُ اللهِ  كِرَاءَهَا  .","","Al-Mu'jam al-Kabir 4304","","رافع بن خديج الأنصاري عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","نافع مولى بن عمر عن رافع"
"4307","4305  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ جَعْفَرٍ الْقَتَّاتُ الْكُوفِيُّ ،  ثَنَا  مِنْجَابُ بْنُ الْحَارِثِ ،  ثَنَا  عَلِيُّ بْنُ مُسْهِرٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ :  أَنَّهُ كَانَ يُكْرِي مَزَارِعَ لَهُ  حَتَّى  حَدَّثَهُ  رَافِعُ بْنُ خَدِيجٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كَرْيِ الْمَزَارِعِ  فَتَرَكَهُ  ابْنُ عُمَرَ  .","","Al-Mu'jam al-Kabir 4305","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن علي بن مسهر القرشي عن منجاب بن الحارث التميمي عن الحسين بن جعفر القتات عن الطبراني","نافع مولى بن عمر عن رافع"
"4308","4306  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  كَثِيرُ بْنُ فَرْقَدٍ ،  عَنْ  نَافِعٍ ،  أَنَّ  ابْنَ عُمَرَ  كَانَ يُكْرِي الْمَزَارِعَ حَتَّى بَلَغَهُ  أَنَّ  رَافِعَ بْنَ خَدِيجٍ يَأْثُرُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ نَهَى عَنْ ذَلِكَ ، قَالَ  نَافِعٌ  : فَخَرَجَ إِلَيْهِ  عَبْدُ اللهِ بْنُ عُمَرَ  بِالْبَلَاطِ  وَأَنَا مَعَهُ ، فَسَأَلَهُ فَقَالَ  رَافِعٌ  : نَعَمْ  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كَرْيِ الْمَزَارِعِ  فَتَرَكَ ذَلِكَ  عَبْدُ اللهِ  .","","Al-Mu'jam al-Kabir 4306","","رافع بن خديج الأنصاري عن نافع مولى ابن عمر عن كثير بن فرقد المدني عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","نافع مولى بن عمر عن رافع"
"4309","4307  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى كَاتِبُ الْعُمَرِيِّ ،  حَدَّثَنَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ سُلَيْمَانَ الطَّوِيلِ ،  عَنْ  نَافِعٍ ،  أَنَّ  ابْنَ عُمَرَ  كَانَ يُكْرِي الْمَزَارِعَ ، وَأَنَّ  رَافِعَ بْنَ خَدِيجٍ  يَأْثُرُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ نَهَى عَنْ ذَلِكَ قَالَ  نَافِعٌ  : فَخَرَجَ إِلَيْهِ  عَبْدُ اللهِ  عَلَى  الْبَلَاطِ  وَأَنَا مَعَهُ  فَسَأَلَهُ  فَقَالَ رَافِعٌ : نَعَمْ  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كَرْيِ الْمَزَارِعِ  . فَتَرَكَ إِكْرَاءَهَا  عَبْدُ اللهِ  .","","Al-Mu'jam al-Kabir 4307","","رافع بن خديج الأنصاري عن نافع مولى ابن عمر عن عبد الله بن سليمان بن زرعة الحميري عن المفضل بن فضالة عن زكريا بن يحيى القضاعي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","نافع مولى بن عمر عن رافع"
"4310","4308  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  ثَنَا  جُوَيْرِيَةُ ،  عَنْ  نَافِعٍ ،  أَنَّ  رَافِعَ بْنَ خَدِيجٍ الْأَنْصَارِيَّ حَدَّثَ  عَبْدَ اللهِ بْنَ عُمَرَ  رَضِيَ اللهُ عَنْهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ كَرْيِ الْمَزَارِعِ  .","","Al-Mu'jam al-Kabir 4308","","رافع بن خديج الأنصاري عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن موسى بن هارون الحمال عن الطبراني","نافع مولى بن عمر عن رافع"
"4311","4309  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  حَدَّثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،         [4/255]      أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ ،  حَدَّثَنِي  نَافِعٌ ،  أَنَّهُ سَمِعَ  ابْنَ عُمَرَ ، يَقُولُ :  كُنَّا نُكْرِي أَرْضَنَا  حَتَّى  سَمِعْنَا  حَدِيثَ رَافِعِ بْنِ خَدِيجٍ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 4309","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","نافع مولى بن عمر عن رافع"
"4312","4310  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  سَعِيدُ بْنُ عَمْرٍو ،  ثَنَا  عَبْثَرٌ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمُزَارَعَةِ  .","","Al-Mu'jam al-Kabir 4310","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أشعث بن سوار عن عبثر بن القاسم الزبيدي عن سعيد بن عمرو بن سهل الأشعثي عن محمد بن عثمان بن أبي شيبة عن الطبراني","نافع مولى بن عمر عن رافع"
"4313","4311  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا  أَنَّهُ كَانَ يُزَارِعُ أَرْضَهُ ، فَلَقِي  رَافِعَ بْنَ خَدِيجٍ  فَحَدَّثَهُ  رَافِعٌ وَنَهَاهُ عَنْ ذَلِكَ وَقَالَ :  إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كَرْيِ الْمَزَارِعِ  .","","Al-Mu'jam al-Kabir 4311","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أشعث بن سوار عن محمد بن فضيل بن غزوان عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","نافع مولى بن عمر عن رافع"
"4314","4312  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْحُسَيْنِ الْقَصْرِيُّ  بِقَصْرِ ابْنِ هُبَيْرَةَ  ،  ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  أَبُو خُلَيْدٍ عُتْبَةُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ ثَوْبَانَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ كَرْيِ الْمَزَارِعِ  .","","Al-Mu'jam al-Kabir 4312","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع بن جبير بن مطعم النوفلي عن عبد الرحمن بن ثابت العنسي عن عتبة بن حماد بن خليد عن سليمان بن أحمد الواسطي عن أحمد بن الحسين بن مدرك القصري عن الطبراني","نافع مولى بن عمر عن رافع"
"4315","4313  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْوَاحِدِ الْكَلَاعِيُّ ،  ثَنَا  زَيْنُ بْنُ شُعَيْبٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  نَافِعٍ ،  أَنَّ  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا لَمَّا سَمِعَ حَدِيثَ  رَافِعِ بْنِ خَدِيجٍ  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كَرْيِ الْأَرْضِ  .  قَالَ  ابْنُ عُمَرَ  : إِنَّمَا كُنَّا نُكْرِيهَا عَلَى  رَبِيعِ  السَّاقِي وَبِبَعْضِ مَا يَخْرُجُ مِنْهَا مِنَ التِّبْنِ  .","","Al-Mu'jam al-Kabir 4313","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أسامة بن زيد الليثي المدني عن زين بن شعيب المعافري عن عبد الأعلى بن عبد الواحد الكلاعي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","نافع مولى بن عمر عن رافع"
"4316","4314  -  حَدَّثَنَا  بِشْرَانُ بْنُ عَبْدِ الْمَلِكِ الْمَوْصِلِيُّ ،  ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ،  ثَنَا  ثَابِتُ بْنُ يَزِيدَ ،  عَنْ  بُرْدِ بْنِ سِنَانٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا :  أَنَّهُ كَانَ يُؤَاجِرُ أَرْضَهُ حَتَّى  حَدَّثَهُ  رَافِعُ بْنُ خَدِيجٍ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كَرْيِ الْأَرْضِ  فَتَرَكَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 4314","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن برد بن سنان عن ثابت بن يزيد الأحول العطار عن غسان بن الربيع الأزدي عن بشران بن عبد الملك الخزاعي عن الطبراني","نافع مولى بن عمر عن رافع"
"4317","4315  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْجَهْمِ السِّمَّرِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ عَمْرِو بْنِ سُكَيْنٍ ،  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ السِّلْعِيُّ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  نَافِعٍ ،  أَنَّ ابْنَ عُمَرَ         [4/256]      كَانَ يَأْخُذُ كَرْيَ الْأَرْضِ حَتَّى  حَدَّثَهُ  رَافِعُ بْنُ خَدِيجٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ كَرْيِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4315","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عون بن أرطبان عن يوسف بن يعقوب بن أبي القاسم السلعي عن الوليد بن عمرو بن السكين الضبعي عن أحمد بن محمد بن الجهم السمري عن الطبراني","نافع مولى بن عمر عن رافع"
"4318","4316  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  حَدَّثَنِي  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  حَفْصُ بْنُ عِنَانٍ ، عَنْ نَافِعٍ مَوْلَى ابْنِ عُمَرَ أَنَّهُ  حَدَّثَهُ  قَالَ :  كَانَ  عَبْدُ اللهِ بْنُ عُمَرَ  يُكْرِي أَرْضَهُ بِبَعْضِ مَا يَخْرُجُ مِنْهَا ، فَبَلَغَهُ أَنَّ رَافِعَ بْنَ خَدِيجٍ يَذْكُرُ غَيْرَ ذَلِكَ ، وَقَالَ : نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ ، وَقَالَ : قَدْ كُنَّا نُكْرِي الْأَرْضَ قَبْلَ أَنْ نَعْرِفَ حَدِيثَ  رَافِعِ بْنِ خَدِيجٍ  ، ثُمَّ وَجَدَ فِي نَفْسِهِ ، فَوَضَعَ يَدَهُ عَلَى مَنْكِبِي حَتَّى دُفِعْنَا إِلَى  رَافِعِ بْنِ خَدِيجٍ  ، فَقَالَ لَهُ  عَبْدُ اللهِ بْنُ عُمَرَ  : سَمِعْتَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَنْهَى عَنْ كَرْيِ الْأَرْضِ ؟ فَقَالَ  رَافِعٌ  : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَإِلَّا فَأَعْمَى اللهُ هَاتَيْنِ يَقُولُ :  لَا تُكْرُوا الْأَرْضَ بِشَيْءٍ  .","","Al-Mu'jam al-Kabir 4316","","رافع بن خديج الأنصاري عن نافع مولى ابن عمر عن حفص بن عنان اليمامي عن أبو عمرو الأوزاعي عن يحيى بن حمزة بن البتلهي عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","نافع مولى بن عمر عن رافع"
"4319","4317  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ ،  ثَنَا  حَكِيمُ بْنُ سَيْفٍ الْحَرَّانِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ كَرْيِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4317","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الحكم بن عتيبة الكندي عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن حكيم بن سيف بن حكيم الرقي عن أحمد بن النضر بن بحر العسكري عن الطبراني","نافع مولى بن عمر عن رافع"
"4320","4318  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَبُو الْأَشْعَثِ ،  ثَنَا  الْفُضَيْلُ بْنُ سُلَيْمَانَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ  ،  أَنَّ  رَافِعَ بْنَ خَدِيجٍ أَخْبَرَ  عَبْدَ اللهَ بْنَ عُمَرَ  وَهُوَ مُتَّكِئٌ عَلَى يَدَيَّ  أَنَّ  عُمُومَتَهُ جَاءُوا إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثُمَّ رَجَعُوا إِلَى  رَافِعٍ  بَعْدَمَا رَوَوْا أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ كَرْيِ الْمَزَارِعِ  .","","Al-Mu'jam al-Kabir 4318","","أحد الصحابة عن رافع بن خديج الأنصاري عن نافع مولى ابن عمر عن موسى بن عقبة عن فضيل بن سليمان النميري عن أحمد بن المقدام العجلي عن عبد الله بن أحمد الجواليقي عن الطبراني","نافع مولى بن عمر عن رافع"
"4321","4319  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ سَعِيدٍ الْقَطَّانُ ،  ثَنَا  سُوَيْدُ بْنُ عَمْرٍو الْكَلْبِيُّ ،  ثَنَا  زُهَيْرٌ ،  عَنِ  الْحَسَنِ بْنِ الْحُرِّ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ كَانَ يُكْرِي أَرْضَهُ  حَتَّى  لَقِيَهُ  رَافِعٌ فَأَخْبَرَهُ بِنَهْيِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ  .  قَالَ  نَافِعٌ  : وَأَنَا مَعَ  ابْنِ عُمَرَ  حِينَ سَأَلَ  رَافِعًا  .","","Al-Mu'jam al-Kabir 4319","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الحسن بن الحر النخعي عن زهير بن معاوية بن حديج عن سويد بن عمرو الكلبي عن أحمد بن محمد بن يحيى القطان عن عبد الله بن أحمد الجواليقي عن الطبراني","نافع مولى بن عمر عن رافع"
"4322","4320  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  عَبْدِ اللهِ ،  عَنْ  نَافِعٍ ،  أَنَّ ابْنَ عُمَرَ كَانَ يُكْرِي الْمَزَارِعَ حَتَّى  حَدَّثَهُ  رَافِعُ بْنُ خَدِيجٍ  عَنْ  بَعْضِ عُمُومَتِهِ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كَرْيِ الْأَرْضِ  ، فَتَرَكَهُ  ابْنُ عُمَرَ  .","","Al-Mu'jam al-Kabir 4320","","ظهير بن رافع الأوسي عن رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عون بن أرطبان عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن عبد الله بن أحمد الجواليقي عن الطبراني","نافع مولى بن عمر عن رافع"
"4323","[4/257]      4321  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَعْقُوبَ بْنِ سَوْرَةَ ،  ثَنَا  الْهَيْثَمُ بْنُ خَارِجَةَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  عَنْ  إِبْرَاهِيمَ بْنِ أَبِي عَبْلَةَ ،  أَنَا  أَبَانُ بْنُ صَالِحٍ ،  عَنْ  نَافِعٍ ، قَالَ :  خَرَجْتُ مَعَ  طَاوُسٍ  إِلَى رَافِعِ بْنِ خَدِيجٍ فَسَأَلَهُ  طَاوُسٌ  عَنْ كَرْيِ الْأَرْضِ  فَقَالَ  :  كُنَّا نُعْطِي الْأَرْضَ بِالنِّصْفِ وَالثُّلُثِ عَلَى مَا فِي الرَّبِيعِ وَعَلَى مَا فِي  الْبَعْلِ  ، فَنَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ  ، فَلَمَّا انْصَرَفَ ضَرَبَ  طَاوُسٌ  عَلَى يَدَيَّ فَقَالَ : إِنْ كَانَتْ لَكَ أَرْضٌ  - فَذَكَرَ الْحَدِيثَ -  .","","Al-Mu'jam al-Kabir 4321","","رافع بن خديج الأنصاري عن نافع مولى ابن عمر عن أبان بن صالح بن عمير عن إبراهيم بن أبي عبلة عن محمد بن حمير القضاعي عن الهيثم بن خارجة الخراساني عن محمد بن يعقوب بن سورة البغدادي عن الطبراني","نافع مولى بن عمر عن رافع"
"4324","4322  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّهُ لَمْ يَزَلْ يُكْرِي أَرْضَهُ حَتَّى بَلَغَهُ حَدِيثُ رَافِعِ بْنِ خَدِيجٍ  فَأَتَاهُ  فَسَأَلَهُ  فَأَخْبَرَهُ فَتَرَكَ  عَبْدُ اللهِ بْنُ عُمَرَ  أَنْ يُكْرِيَهَا  .","","Al-Mu'jam al-Kabir 4322","","رافع بن خديج الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","نافع مولى بن عمر عن رافع"
"4325","نَافِعُ بْنُ جُبَيْرِ بْنِ مُطْعِمٍ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4323  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  عَنْ  عُتْبَةَ بْنِ مُسْلِمٍ ،  عَنْ  نَافِعِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَرَّمَ مَا بَيْنَ  لَابَتَيِ  الْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 4323","","رافع بن خديج الأنصاري عن نافع بن جبير بن مطعم النوفلي عن عتبة بن أبي عتبة المدني عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","نافع بن جبير بن مطعم عن رافع بن خديج"
"4326","4324  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  عُتْبَةَ بْنِ مُسْلِمٍ ،  عَنْ  نَافِعِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَرَّمَ مَا بَيْنَ  لَابَتَيِ  الْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 4324","","رافع بن خديج الأنصاري عن نافع بن جبير بن مطعم النوفلي عن عتبة بن أبي عتبة المدني عن سليمان بن بلال القرشي عن عبد الله بن مسلمة القعنبي عن معاذ بن المثنى العنبري عن الطبراني","نافع بن جبير بن مطعم عن رافع بن خديج"
"4327","عَبْدُ اللهِ بْنُ عَمْرِو بْنِ عُثْمَانَ بْنِ عَفَّانَ  عَنْ  رَافِعٍ  4325  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،         [4/258]      حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  ابْنُ الْهَادِ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ  أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَذَكَرَ  مَكَّةَ  فَقَالَ :  إِنَّ  إِبْرَاهِيمَ  حَرَّمَ  مَكَّةَ  ،  وَإِنِّي أُحَرِّمُ مَا بَيْنَ  لَابَتَيْهَا  يُرِيدُ  الْمَدِينَةَ  .","","Al-Mu'jam al-Kabir 4325","","رافع بن خديج الأنصاري عن عبد الله بن عمرو بن عثمان بن عفان المطرف عن أبو بكر بن محمد الخزرجي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عبد الله بن عمرو بن عثمان بن عفان عن رافع"
"4328","4326  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ الْمِصْرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ، قَالَا :  ثَنَا  بَكْرُ بْنُ مُضَرَ ،  عَنِ  ابْنِ الْهَادِ ،  عَنْ  أَبِي بَكْرِ بْنِ حَزْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ،  أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَذَكَرَ  مَكَّةَ  فَقَالَ :  إِنَّ  إِبْرَاهِيمَ  عَلَيْهِ السَّلَامُ حَرَّمَ  مَكَّةَ  ، وَإِنِّي أُحَرِّمُ مَا بَيْنَ  لَابَتَيْهَا  يُرِيدُ  الْمَدِينَةَ  .","","Al-Mu'jam al-Kabir 4326","","رافع بن خديج الأنصاري عن عبد الله بن عمرو بن عثمان بن عفان المطرف عن أبو بكر بن محمد الخزرجي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن بكر بن مضر المصري عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عبد الله بن عمرو بن عثمان بن عفان عن رافع"
"4329","4327  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ أَبِي حَازِمٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  أَبِي بَكْرِ بْنِ حَزْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُثْمَانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ،  أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَذَكَرَ  مَكَّةَ  فَقَالَ :  إِنَّ  إِبْرَاهِيمَ  حَرَّمَ  مَكَّةَ  ، وَأَنَا أُحَرِّمُ مَا بَيْنَ  لَابَتَيْهَا  لِلْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 4327","","رافع بن خديج الأنصاري عن عبد الله بن عمرو بن عثمان بن عفان المطرف عن أبو بكر بن محمد الخزرجي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن أبي حازم المخزومي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","عبد الله بن عمرو بن عثمان بن عفان عن رافع"
"4330","4328  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 4328","","رافع بن خديج الأنصاري عن عبد الله بن عمرو بن عثمان بن عفان المطرف عن أبو بكر بن محمد الخزرجي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن عبد العزيز بن محمد الدراوردي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عبد الله بن عمرو بن عثمان بن عفان عن رافع"
"4331","حَنْظَلَةُ بْنُ قَيْسٍ  عَنْ  رَافِعٍ  4329  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ، (  ح  )  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ، كُلُّهُمْ  عَنْ  مَالِكٍ ،  عَنْ  رَبِيعَةَ ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ ،  أَنَّهُ سَأَلَ  رَافِعَ بْنَ خَدِيجٍ عَنْ كَرْيِ الْأَرْضِ ؟  فَقَالَ  :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كَرْيِ الْأَرْضِ  ، فَقُلْتُ : بِالذَّهَبِ         [4/259]      وَالْوَرِقِ ؟ فَقَالَ : أَمَّا بِالذَّهَبِ وَالْوَرِقِ فَلَا بَأْسَ .","","Al-Mu'jam al-Kabir 4329","","رافع بن خديج الأنصاري عن حنظلة بن قيس بن عمرو الزرقي عن ربيعة الرأي عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حنظلة بن قيس عن رافع"
"4332","4330  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  رَبِيعَةَ ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ  أَنَّهُ سَأَلَ  رَافِعَ بْنَ خَدِيجٍ ، عَنْ كَرْيِ الْأَرْضِ ؟ فَقَالَ :  نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كَرْيِ الْأَرْضِ بِمَا يَخْرُجُ مِنْهَا  .","","Al-Mu'jam al-Kabir 4330","","رافع بن خديج الأنصاري عن حنظلة بن قيس بن عمرو الزرقي عن ربيعة الرأي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","حنظلة بن قيس عن رافع"
"4333","4331  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  رَبِيعَةَ ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ ، قَالَ :  سَأَلْتُ  رَافِعَ بْنَ خَدِيجٍ عَنْ كَرْيِ الْأَرْضِ  الْبَيْضَاءِ  بِالذَّهَبِ وَالْفِضَّةِ  ؟ فَقَالَ : لَا بَأْسَ ، إِنَّمَا نَهَاهُمْ عَنِ الْأَرْمَاثِ  .","","Al-Mu'jam al-Kabir 4331","","رافع بن خديج الأنصاري عن حنظلة بن قيس بن عمرو الزرقي عن ربيعة الرأي عن سفيان الثوري عن موسى بن مسعود النهدي عن حفص بن عمر سنجة ألف عن الطبراني","حنظلة بن قيس عن رافع"
"4334","4332  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَسْعُودٍ الْمَقْدِسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الصَّنْعَانِيُّ ،  حَدَّثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا نُؤَاجِرُ أَرْضَنَا بِالْمَاذِيَانَاتِ  وَأَقْبَالِ  الْجَدَاوِلِ فَيَسْلَمُ هَذَا وَيَهْلِكُ هَذَا  ، فَنُهِينَا عَنْ ذَلِكَ وَلَا بَأْسَ بِأَجْرٍ مُسَمًّى  .","","Al-Mu'jam al-Kabir 4332","","رافع بن خديج الأنصاري عن حنظلة بن قيس بن عمرو الزرقي عن ربيعة الرأي عن أبو عمرو الأوزاعي عن محمد بن كثير بن أبي عطاء عن أحمد بن مسعود المقدسي عن الطبراني","حنظلة بن قيس عن رافع"
"4335","4333  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  مُوسَى بْنُ أَعْيَنَ ، قَالَا :  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  رَبِيعَةَ ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا نُكْرِي الْأَرْضَ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الْمَاذِيَانَاتِ  وَأَقْبَالِ  الْجَدَاوِلِ فَيَهْلِكُ هَذَا وَيَسْلَمُ هَذَا ، فَنَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 4333","","رافع بن خديج الأنصاري عن حنظلة بن قيس بن عمرو الزرقي عن ربيعة الرأي عن أبو عمرو الأوزاعي عن موسى بن أعين الجزري عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","حنظلة بن قيس عن رافع"
"4336","4334  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْوَاحِدِ الْكَلَاعِيُّ ،  ثَنَا  زَيْنُ بْنُ شُعَيْبٍ ،  عَنْ  أَبِي مَعْدَانَ عَامِرِ بْنِ مُرَّةَ الْمَكِّيِّ ،  عَنْ  رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا نُكْرِي الْأَرْضَ  ، فَنَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 4334","","رافع بن خديج الأنصاري عن حنظلة بن قيس بن عمرو الزرقي عن ربيعة الرأي عن أبو معدان المكي عن زين بن شعيب المعافري عن عبد الأعلى بن عبد الواحد الكلاعي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","حنظلة بن قيس عن رافع"
"4337","4335  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  رَبِيعَةَ ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا نُكْرِي الْأَرْضَ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  عَلَى  رَبِيعِ  السَّاقِي وَالْمَاذِيَانَاتِ وَطَائِفَةٍ مِنَ التِّبْنِ ، فَكَرِهَ ذَلِكَ النَّبِيُّ  .","","Al-Mu'jam al-Kabir 4335","","رافع بن خديج الأنصاري عن حنظلة بن قيس بن عمرو الزرقي عن ربيعة الرأي عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","حنظلة بن قيس عن رافع"
"4338","[4/260]      4336  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  حَدَّثَنِي  حَنْظَلَةُ بْنُ قَيْسٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ :  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَانَا أَنْ نُكْرِيَ أَرْضَنَا  وَلَمْ يَكُنْ يَوْمَئِذٍ ذَهَبٌ وَلَا فِضَّةٌ وَكُنَّا نُكْرِي أَرْضَنَا عَلَى الرُّبُعِ وَاللَّامَعْلُومَةِ فَرُبَّمَا هَلَكَ ذَا وَسَلِمَ ذَا  .","","Al-Mu'jam al-Kabir 4336","","رافع بن خديج الأنصاري عن حنظلة بن قيس بن عمرو الزرقي عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن سليمان بن داود العتكي عن الحسين بن إسحاق التستري عن الطبراني","حنظلة بن قيس عن رافع"
"4339","4337  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا  بَنِي حَارِثٍ  أَكْثَرَ  أَهْلِ الْمَدِينَةِ  حَقْلًا  ، وَكُنَّا نُكْرِي الْأَرْضَ وَنَشْتَرِطُ عَلَى الْأُكْرَةِ أَنَّ مَا سَقَى الْمَاذِيَانَاتُ وَالرَّبِيعُ فَلَنَا وَمَا سَقَتِ الْجَدَاوِلُ فَهُوَ لَكُمْ ، فَرُبَّمَا هَلَكَ هَذَا وَسَلِمَ هَذَا ، وَرُبَّمَا سَلِمَ هَذَا وَهَلَكَ هَذَا ، فَنَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ ، وَلَمْ يَكُنْ عِنْدَنَا يَوْمَئِذٍ ذَهَبٌ وَلَا فِضَّةٌ فَنَعْلَمُ ذَلِكَ  .","","Al-Mu'jam al-Kabir 4337","","رافع بن خديج الأنصاري عن حنظلة بن قيس بن عمرو الزرقي عن يحيى بن سعيد الأنصاري عن حماد بن سلمة عن عبد الواحد بن غياث عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","حنظلة بن قيس عن رافع"
"4340","4338  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  حَدَّثَنِي  حَنْظَلَةُ بْنُ قَيْسٍ الزُّرَقِيُّ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  لَمْ يَنْهَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كِرَائِهَا -  يَعْنِي الْأَرْضَ بِالذَّهَبِ وَالْوَرِقِ  -  وَلَكِنَّا كُنَّا نُكْرِيهَا ثُمَّ نَزْرَعُ وَيَكُونُ لَنَا هَذَا الشِّقُّ وَلَهُمْ هَذَا الشِّقُّ فَمَا أَخْرَجَ اللهُ عَزَّ وَجَلَّ مِنْ هَذَا فَلِهَذَا ، وَمَا أَخْرَجَ اللهُ عَزَّ وَجَلَّ مِنْ هَذَا لِهَذَا ، فَنَهَانَا عَنْ ذَلِكَ  .","","Al-Mu'jam al-Kabir 4338","","رافع بن خديج الأنصاري عن حنظلة بن قيس بن عمرو الزرقي عن يحيى بن سعيد الأنصاري عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","حنظلة بن قيس عن رافع"
"4341","مُحَمَّدُ بْنُ يَحْيَى بْنِ حَبَّانَ  عَنْ  رَافِعٍ  4339  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4339","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن يزيد بن هارون عن إدريس بن جعفر العطار عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4342","4340  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4340","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4343","[4/261]      4341  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ، (  ح  )  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ، (  ح  )  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ كُلُّهُمْ  عَنْ  مَالِكٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  أَنَّ  عَبْدًا  سَرَقَ  وَدِيًّا  مِنْ حَائِطِ  رَجُلٍ  فَجَعَلَهُ فِي حَائِطِ سَيِّدِهِ ، فَخَرَجَ صَاحِبُ  الْوَدِيِّ  يَلْتَمِسُ  وَدِيَّهُ  فَأَخَذَهُ ، فَاسْتَعْدَى عَلَى الْعَبْدِ  مَرْوَانَ بْنَ الْحَكَمِ  فَسَجَنَ الْعَبْدَ وَأَرَادَ قَطْعَ يَدِهِ ، فَانْطَلَقَ سَيِّدُ الْعَبْدِ إِلَى رَافِعِ بْنِ خَدِيجٍ فَسَأَلَهُ عَنْ ذَلِكَ ، فَأَخْبَرَ أَنَّهُ سَمِعَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4341","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4344","4342  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ، وَيُوسُفُ الْقَاضِي ، قَالَا :  ثَنَا  مُسَدَّدٌ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4342","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن مسدد بن مسرهد عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4345","4343  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4343","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4346","4344  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  (  ح  ) ،  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ، قَالَا :  ثَنَا  زُهَيْرٌ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4344","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن زهير بن معاوية بن حديج عن أحمد بن عبد الله اليربوعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4347","4345  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، حَدَّثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَمْرٍو ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4345","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن عبيد الله بن عمرو بن أبي الوليد عن عبد الله بن جعفر بن غيلان عن أبو شعيب الحراني عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4348","4346  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  سَعِيدُ بْنُ حَفْصٍ النُّفَيْلِيُّ ،  أَنَا  يُونُسُ بْنُ رَاشِدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4346","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن يونس بن راشد الجزري عن سعيد بن حفص بن عمر الهذلي عن أحمد بن النضر بن بحر العسكري عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4349","[4/262]      4347  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  مَنْصُورُ بْنُ كُلْثُومٍ ،  عَنْ  زَائِدَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4347","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن زائدة بن قدامة عن منصور بن كلثوم عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4350","4348  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4348","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4351","4349  -  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ النَّوْفَلِيُّ الْمَدَنِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُنْذِرٍ الْحِزَامِيُّ ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4349","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن أنس بن عياض الليثي عن إبراهيم بن المنذر الحزامي عن جعفر بن سليمان النوفلي عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4352","4350  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4350","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن سليمان بن حيان الأحمر عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4353","4351  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4351","","رافع بن خديج الأنصاري عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4354","4352  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  عَمَّةٍ لَهُ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا قَطْعَ فِي  ثَمَرٍ  وَلَا  كَثَرٍ  .","","Al-Mu'jam al-Kabir 4352","","رافع بن خديج الأنصاري عن عمة محمد بن يحيى بن حبان عن محمد بن يحيى بن حبان عن يحيى بن سعيد الأنصاري عن الليث بن سعد عن عبد الله بن صالح المصري عن يوسف بن يزيد القراطيسي عن الطبراني","محمد بن يحيى بن حبان عن رافع"
"4355","ابْنُ رَافِعِ بْنِ خَدِيجٍ  عَنْ أَبِيهِ وَالِاخْتِلَافُ عَلَى  مُجَاهِدٍ  فِي رِوَايَتِهِ  4353  -  حَدَّثَنَا  أَحْمَدُ بْنُ خُلَيْدٍ الْحَلَبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  ثَنَا         [4/263]      أَبُو عَوَانَةَ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  مُجَاهِدٍ ،  حَدَّثَنِي  ابْنُ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا  ، وَأَمْرُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الرَّأْسِ وَالْعَيْنِ ، نَهَانَا أَنْ نُعْمِلَ الْأَرْضَ بِبَعْضِ خَرَاجِهَا وَبِوَرِقٍ مَنْقُودَةٍ ، وَنَهَانَا عَنْ كَسْبِ الْحَجَّامِ  .","","Al-Mu'jam al-Kabir 4353","","رافع بن خديج الأنصاري عن رفاعة بن رافع بن خديج عن مجاهد بن جبر المخزومي عن عثمان بن عاصم بن حصين عن الوضاح بن عبد الله اليشكري عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن أحمد بن خليد بن يزيد الحلبي عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4356","4354  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الْجَبَّارِ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  أَبُو حَنِيفَةَ ،  عَنْ  أَبِي حَصِينٍ ،  عَنِ  ابْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  رَافِعٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ مَرَّ بِحَائِطٍ فَأَعْجَبَهُ فَقَالَ : لِمَنْ هَذَا ؟  قُلْتُ : هُوَ لِي ، قَالَ : مِنْ أَيْنَ لَكَ هَذَا ؟ قُلْتُ : اسْتَأْجَرْتُهُ ، قَالَ : لَا تَسْتَأْجِرْهُ بِشَيْءٍ  .","","Al-Mu'jam al-Kabir 4354","","رافع بن خديج الأنصاري عن رفاعة بن رافع بن خديج عن عثمان بن عاصم بن حصين عن أبو حنيفة النعمان عن عبيد الله بن موسى عن سليمان بن عبد الجبار الخياط عن عبد الله بن أحمد الجواليقي عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4357","4355  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ ، وَعُبَادَةُ بْنُ زِيَادٍ ، قَالَا :  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  قَيْسِ بْنِ رِفَاعَةَ ،  عَنْ  جَدِّهِ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَأَمْرُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى الرَّأْسِ وَالْعَيْنَيْنِ ، نَهَانَا أَنْ نُكْرِيَ أَرْضَنَا بِبَعْضِ مَا يَخْرُجُ مِنْهَا وَبِوَرِقٍ مَنْقُودَةٍ ، وَقَالَ :  مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا أَوْ  لِيَمْنَحْهَا  أَخَاهُ  .","","Al-Mu'jam al-Kabir 4355","","رافع بن خديج الأنصاري عن قيس بن رفاعة عن عثمان بن عاصم بن حصين عن قيس بن الربيع الأسدي عن عباد بن زياد  بن موسى الساجي عن محمد بن عثمان بن أبي شيبة عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4358","4356  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  نَهَانَا رَسُولُ اللهِ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، نَهَانَا إِذَا كَانَ لِأَحَدِنَا أَرْضٌ أَنْ يُعْطِيَهَا بِبَعْضِ خَرْجِهَا بِثُلُثٍ أَوْ بِنِصْفٍ وَقَالَ :  مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا أَوْ  لِيَمْنَحْهَا  أَخَاهُ  .","","Al-Mu'jam al-Kabir 4356","","رافع بن خديج الأنصاري عن مجاهد بن جبر المخزومي عن عثمان بن عاصم بن حصين عن أبو بكر بن عياش عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4359","4357  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَاهَانَ الْأُبُلِّيُّ  ، ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الشَّهِيدِيُّ ،  ثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  عَنْ  خُصَيْفٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ : أَخَذْتُ بِيَدِ  طَاوُسٍ  حَتَّى أَدْخَلْتُهُ عَلَى  ابْنِ رَافِعِ بْنِ خَدِيجٍ  فَحَدَّثَهُ  عَنْ  أَبِيهِ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ  نَهَى عَنْ كَرْيِ الْأَرْضِ  الْبَيْضَاءِ  .","","Al-Mu'jam al-Kabir 4357","","رافع بن خديج الأنصاري عن رفاعة بن رافع بن خديج عن مجاهد بن جبر المخزومي عن خصيف الجزري عن عتاب بن بشير عن إسحاق بن إبراهيم الشهيدي عن محمد بن أحمد بن إسماعيل بن ماهان الأبلي عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4360","4358  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  أَبِيهِ  ، عَنْ رَسُولِ اللهِ أَنَّهُ  نَهَى عَنْ كَرْيِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4358","","رافع بن خديج الأنصاري عن ابن رافع بن خديج عن مجاهد بن جبر المخزومي عن عبد الكريم الاصطخري عن عبيد الله بن عمرو بن أبي الوليد عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4361","[4/264]      4359  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ الْكَرِيمِ بْنِ أَبِي الْمُخَارِقِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  رَاحَ إِلَيْنَا خَالَايَ فَقَالَا : نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَطَاعَةُ اللهِ وَطَاعَةُ رَسُولِهِ لَنَا أَنْفَعُ قَالَ :  مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا أَوْ  لِيَمْنَحْهَا  أَخَاهُ  .","","Al-Mu'jam al-Kabir 4359","","رافع بن خديج الأنصاري عن مجاهد بن جبر المخزومي عن عبد الكريم بن أبي المخارق عن سفيان الثوري عن علي ابن المديني عن الحسن بن علي بن شبيب المعمري عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4362","4360  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  عَمْرِو بْنِ ذَرٍّ  ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  جَاءَنَا  رَافِعٌ  مِنْ عِنْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ يَرْفُقُ بِنَا ، وَطَاعَةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْفَقُ بِنَا ،  نَهَانَا أَنْ نَزْرَعَ أَرْضًا إِلَّا أَرْضًا يَمْلِكُ أَحَدُنَا رَقَبَتَهَا أَوْ مَنِيحَةً  يَمْنَحُهَا  رَجُلٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : (عمر بن ذر) .","","Al-Mu'jam al-Kabir 4360","","رافع بن خديج الأنصاري عن ابن رافع بن خديج عن مجاهد بن جبر المخزومي عن عمر بن ذر عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4363","4361  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  أَنَّ  أُسَيْدَ بْنَ ظُهَيْرٍ ، قَالَ :  كَانَ أَحَدُنَا إِذَا اسْتَغْنَى عَنْ أَرْضِهِ أَعْطَاهَا بِالثُّلُثِ وَالرُّبُعِ وَالنِّصْفِ وَيَشْتَرِطُ ثُلُثَهُ جَدَاوِلَ وَالْقَصَّابِينَ وَمَا سَقَى  الرَّبِيعُ  ، قَالَ : وَكُنَّا نَعْمَلُ بِالْحَدِيدِ وَمَا شَاءَ اللهُ ، وَنُصِيبُ مِنْهَا مَنْفَعَةً ، حَتَّى جَاءَنَا رَافِعُ بْنُ خَدِيجٍ ، فَقَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَنْهَاكُمْ عَنْ أَمْرٍ كَانَ لَكُمْ نَافِعًا ، وَطَاعَةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْفَعُ لَكُمْ :  إِذَا اسْتَغْنَى أَحَدُكُمْ عَنْ أَرْضِهِ  فَلْيَمْنَحْهَا  أَخَاهُ أَوْ يَدَعْ  ، وَيَنْهَاكُمْ عَنِ  الْمُزَابَنَةِ  .  وَالْمُزَابَنَةُ  أَنْ يَكُونَ الْمَالُ الْعَظِيمُ مِنَ النَّخْلِ فَيَقُولُ : قَدْ أَخَذْتُهُ بِكَذَا وَكَذَا وَسْقًا مِنْ تَمْرٍ  .","","Al-Mu'jam al-Kabir 4361","","رافع بن خديج الأنصاري عن أسيد بن ظهير الحارثي عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن سفيان الثوري عن محمد بن كثير العبدي عن الفضل بن الحباب الجمحي عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4364","4362  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  مُفَضَّلِ بْنِ مُهَلْهَلٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أُسَيْدِ بْنِ ظُهَيْرٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ : أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الْمُزَابَنَةِ  .","","Al-Mu'jam al-Kabir 4362","","رافع بن خديج الأنصاري عن أسيد بن ظهير الحارثي عن مجاهد بن جبر المخزومي عن منصور بن المعتمر عن المفضل بن مهلهل السعدي عن يحيى بن آدم عن أبو كريب محمد بن العلاء عن محمد بن يحيى بن مندة عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4365","4363  -  حَدَّثَنَا  زَكَرِيَّا بْنُ حَمْدَوَيْهِ الْبَغْدَادِيُّ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ الرَّحْمَنِ الزُّبَيْدِيِّ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أُسَيْدٍ ابْنِ أَخِي رَافِعِ بْنِ خَدِيجٍ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا اسْتَغْنَى أَحَدُكُمْ أَرْضَهُ  فَلْيَمْنَحْهَا  أَخَاهُ  أَوْ يَدَعْ وَنَهَى عَنِ  الْمُزَابَنَةِ  .","","Al-Mu'jam al-Kabir 4363","","أسيد بن ظهير الحارثي عن مجاهد بن جبر المخزومي عن سعيد بن عبد الرحمن الزبيدي عن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن زكريا بن حمدويه الصفار عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4366","[4/265]      4364  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي غَنِيَّةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَكَمِ ،  عَنْ  رَجُلٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْمُحَاقَلَةِ  وَالْمُزَابَنَةِ  .","","Al-Mu'jam al-Kabir 4364","","رافع بن خديج الأنصاري عن رجل عن الحكم بن عتيبة الكندي عن عبد الملك بن حميد الخزاعي عن يحيى بن عبد الملك بن حميد عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4367","4365  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  نَهَانَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْحَقْلِ  .  وَالْحَقْلُ : الثُّلُثُ وَالرُّبُعُ  .","","Al-Mu'jam al-Kabir 4365","","رافع بن خديج الأنصاري عن مجاهد بن جبر المخزومي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4368","4366  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ، قَالَا :  أَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ فَنَهَانَا عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَأَمْرُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَيْرٌ قَالَ :  مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا أَوْ  لِيَمْنَحْهَا  أَوْ لِيَذَرْهَا  ، فَذُكِرَ ذَلِكَ  لِطَاوُسٍ  ، فَقَالَ : إِنَّ  ابْنَ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُ كَانَ أَعْلَمَ ، قَالَ : قَالَ  ابْنُ عَبَّاسٍ  : لَأَنْ  يَمْنَحَ  الرَّجُلُ أَخَاهُ أَرْضَهُ خَيْرٌ لَهُ  .","","Al-Mu'jam al-Kabir 4366","","رافع بن خديج الأنصاري عن مجاهد بن جبر المخزومي عن عبد الملك بن ميسرة الهلالي عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4369","4367  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  حَفْصُ بْنُ عَمْرٍو الرَّبَالِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِأَرْضِ  رَجُلٍ مِنَ الْأَنْصَارِ  يَزْرَعُ وَقَدْ عَرَفَ أَنَّهُ مُحْتَاجٌ ، فَقَالَ : لِمَنْ هَذِهِ ؟ فَقَالَ :  لِفُلَانٍ  أَعْطَانِيهَا بِالْأَجْرِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَوْ مَنَحَهَا أَخَاهُ  .","","Al-Mu'jam al-Kabir 4367","","رافع بن خديج الأنصاري عن مجاهد بن جبر المخزومي عن إبراهيم بن مهاجر بن جابر البجلي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن عبد المجيد الحنفي عن حفص بن عمرو الربالي عن عبد الله بن أحمد الجواليقي عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4370","4368  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الرَّبَالِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ ،  ثَنَا  رَبَاحُ بْنُ أَبِي مَعْرُوفٍ ،  عَنْ  قَيْسِ بْنِ سَعِيدٍ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  سَمِعْتُ  رَافِعَ بْنَ خَدِيجٍ يَقُولُ :  رَاحَ عُمُومَتِي إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ثُمَّ رَجَعُوا إِلَيْنَا ، فَقَالُوا : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَاكُمْ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَطَاعَةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَكُمْ أَنْفَعُ قَالَ :  لِيَزْرَعْ أَحَدُكُمْ أَرْضَهُ أَوْ  لِيَمْنَحْهَا  أَوْ يَدَعْهَا بَوَارًا  .","","Al-Mu'jam al-Kabir 4368","","ظهير بن رافع الأوسي عن رافع بن خديج الأنصاري عن مجاهد بن جبر المخزومي عن قيس بن سعد الحبشي عن رباح بن أبي معروف المكي عن عبيد الله بن عبد المجيد الحنفي عن حفص بن عمرو الربالي عن عبد الله بن أحمد الجواليقي عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4371","[4/266]      4369  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ الْبَرَاءُ  ، ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّهُ أَتَى قَوْمَهُ فَقَالَ :  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ نَهَاكُمْ عَنْ أَمْرٍ كَانَ بِكُمْ  رَافِقًا  ، وَلَكِنْ طَاعَةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيمَا شَقَّ عَلَيْكُمْ خَيْرٌ مِنْ مَعْصِيَتِهِ فِيمَا رَفَقَ بِكُمْ ، نَهَاكُمْ أَنْ تُعْطُوا أَرْضَكُمْ بِالثُّلُثِ وَالرُّبُعِ ، وَلَكِنْ لِيَزْرَعْهَا أَوْ لِيُزْرِعْهَا أَخَاهُ ، فَقَالُوا : إِذَنْ يَكُونُ  بَوْرًا  ، فَقَالَ :  ذَرُوهَا تَكُونُ  بَوْرًا  .","","Al-Mu'jam al-Kabir 4369","","رافع بن خديج الأنصاري عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن محمد بن أحمد بن البراء العبدي عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4372","4370  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  مُوسَى بْنُ سُفْيَانَ الْجُنْدَيْسَابُورِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَاصِمٍ ،  ثَنَا  مُحَمَّدُ بْنُ رَاشِدٍ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  دَخَلْتُ عَلَى  طَاوُسٍ  فَحَدَّثْتُهُ مَا سَمِعْتُ مِنْ  رَافِعِ بْنِ خَدِيجٍ  مِنَ النَّهْيِ عَنِ  الْمُحَاقَلَةِ  ، فَضَرَبَ طَاوُسٌ فِي صَدْرِي وَقَالَ : تُحَدِّثُنِي عَنْ  رَافِعٍ  وَقَدْ  عَمِلَ بِهَا مُعَاذُ بْنُ جَبَلٍ عَلَى عَهْدِ رَسُولِ اللهِ فَأَعْطَى الْأَرْضَ بِالنِّصْفِ وَالثُّلُثِ .  ؟","","Al-Mu'jam al-Kabir 4370","","معاذ بن جبل عن طاوس بن كيسان عن مجاهد بن جبر المخزومي عن خالد الحذاء عن محمد بن راشد المكحولي عن عبد الله بن عاصم الحماني عن موسى بن سفيان الجند يسابوري عن عبد الله بن أحمد الجواليقي عن الطبراني","ابن رافع بن خديج عن أبيه والاختلاف على مجاهد في روايته"
"4373","أُسَيْدُ بْنُ رَافِعِ بْنِ خَدِيجٍ  عَنْ أَبِيهِ  4371  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أُسَيْدِ بْنِ رَافِعٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  نَهَانَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نُكْرِيَ الْأَرْضَ بِبَعْضِ مَا فِيهَا  .","","Al-Mu'jam al-Kabir 4371","","رافع بن خديج الأنصاري عن أسيد بن رافع الأنصاري عن الزهري عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن الحسين بن إسحاق التستري عن الطبراني","أسيد بن رافع بن خديج عن أبيه"
"4374","4372  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ، أَنَّ بُكَيْرًا  حَدَّثَهُ  أَنَّ  أُسَيْدَ بْنَ رَافِعٍ  حَدَّثَهُ  أَنَّ  رَافِعًا  أَتَى عَشِيرَتَهُ فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ بِنَا  رَافِقًا  ، وَفِي أَمْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَرَكَةٌ وَرُشْدٌ ، فَقَالُوا : وَمَا ذَاكَ ؟ قَالَ : الْحَقْلُ . فَقُلْتُ  لِأُسَيْدٍ  : وَمَا الْحَقْلُ ؟ قَالَ : كَرْيُ الْأَرْضِ ، فَقُلْتُ : وَكَيْفَ كَانُوا يُكْرُونَهَا ؟ قَالَ :  بِالْأَرْبِعَاءِ  وَبِالشَّيْءِ مِنَ  الْحَصِيدِ  .","","Al-Mu'jam al-Kabir 4372","","رافع بن خديج الأنصاري عن أسيد بن رافع الأنصاري عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","أسيد بن رافع بن خديج عن أبيه"
"4375","رِفَاعَةُ بْنُ رَافِعِ بْنِ خَدِيجٍ  عَنْ أَبِيهِ  4373  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  ثَنَا  عُتْبَةُ بْنُ أَبِي حَكِيمٍ ، أَنَّ عَبْدَ الرَّحْمَنِ بْنَ أَبِي قَيْسٍ  حَدَّثَهُ  عَنْ  رِفَاعَةَ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قُلْتُ :  يَا رَسُولَ اللهِ أَنَا أَكْثَرُ  الْأَنْصَارِ  أَرْضًا قَالَ :         [4/267]      ازْرَعْ  ، قُلْتُ : هِي أَكْثَرُ مِنْ ذَلِكَ ، قَالَ : فَبَوِّرْ  .","","Al-Mu'jam al-Kabir 4373","","رافع بن خديج الأنصاري عن رفاعة بن رافع بن خديج عن عبد الرحمن بن أبي قيس عن عتبة بن أبي حكيم عن يحيى بن حمزة بن البتلهي عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","رفاعة بن رافع بن خديج عن أبيه"
"4376","سَهْلُ بْنُ رَافِعِ بْنِ خَدِيجٍ  عَنْ أَبِيهِ  4374  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رُزَيْقِ بْنِ جَامِعٍ الْمِصْرِيُّ  ، ثَنَا  أَبُو طَاهِرِ بْنُ السَّرْحِ ،  ثَنَا  رِشْدِينُ بْنُ سَعْدٍ ،  عَنْ  مُوسَى بْنِ أَيُّوبَ ،  عَنْ  سَهْلِ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ بِهِ ، فَنَادَاهُ فَخَرَجَ إِلَيْهِ ، فَمَشَى مَعَهُ حَتَّى أَتَى الْمَسْجِدَ ، ثُمَّ انْصَرَفَ فَاغْتَسَلَ ، ثُمَّ رَجَعَ فَرَآهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَثَرَ الْغُسْلِ فَسَأَلَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ غُسْلِهِ ، فَقَالَ : سَمِعْتُ  نِدَاءَكَ  وَأَنَا أُجَامِعُ امْرَأَتِي ، فَقُمْتُ قَبْلَ أَنْ أَفْرُغَ فَاغْتَسَلْتُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا الْمَاءُ مِنَ الْمَاءِ  ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَعْدَ ذَلِكَ : إِذَا جَاوَزَ الْخِتَانُ الْخِتَانَ فَقَدْ وَجَبَ الْغُسْلُ  .","","Al-Mu'jam al-Kabir 4374","","رافع بن خديج الأنصاري عن سهل بن رافع بن خديج البلوي عن موسى بن أيوب بن عامر الغافقي عن رشدين بن سعد المهري عن أحمد بن عمرو بن بن السرح المصري عن محمد بن رزيق بن جامع العدل عن الطبراني","سهل بن رافع بن خديج عن أبيه"
"4377","4375  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ الْبَزَّازُ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي يُوسُفَ الْمِسْكِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَعْلَى زُنْبُورٌ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  عِيسَى بْنِ سَهْلِ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْمُحَاقَلَةِ  وَالْمُزَابَنَةِ  وَالْمُنَابَذَةِ  وَنَهَى أَنْ يَقُولَ الرَّجُلُ لِلرَّجُلِ ابْتَعْ هَذَا بِنَقْدٍ وَاشْتَرِهِ  بِنَسِيئَةٍ  حَتَّى يَبْتَاعَهُ وَيُحْرِزَهُ ، وَعَنْ  كَالِئٍ  بِكَالئٍ  وَدَيْنٍ بِدَيْنٍ  .","","Al-Mu'jam al-Kabir 4375","","رافع بن خديج الأنصاري عن سهل بن رافع بن خديج البلوي عن عيسى بن سهل بن رافع بن خديج عن موسى بن عبيدة بن نشيط الحميري عن زنبور ، محمد بن يعلى السلمي عن محمد بن أبي يوسف المسكي عن أحمد بن عبد الله البزاز عن الطبراني","سهل بن رافع بن خديج عن أبيه"
"4378","عَبْدُ اللهِ بْنُ رَافِعِ بْنِ خَدِيجٍ  عَنْ أَبِيهِ  4376  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  حَدَّثَنِي  حَرَمِيُّ بْنُ عُمَارَةَ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ نُفَيْعِ بْنِ عَلِيٍّ الْكِلَابِيُّ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  أَبِيهِ  : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَأْمُرُ بِتَأْخِيرِ الْعَصْرِ  .","","Al-Mu'jam al-Kabir 4376","","رافع بن خديج الأنصاري عن عبد الله بن رافع بن خديج الأنصاري عن عبد الواحد بن الرماح الكلاعي عن حرمي بن عمارة العتكي عن عبيد الله بن عمر القواريري عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن رافع بن خديج عن أبيه"
"4379","[4/268]      عَبْدُ الرَّحْمَنِ بْنُ رَافِعِ بْنِ خَدِيجٍ  عَنْ أَبِيهِ  4377  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الصَّوَّافُ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  رِفَاعَةُ بْنُ الْهُرَيْرِ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَكْذِبُوا عَلَيَّ فَإِنَّهُ لَيْسَ كَذِبٌ عَلَيَّ كَكَذِبٍ عَلَى أَحَدٍ  .","","Al-Mu'jam al-Kabir 4377","","رافع بن خديج الأنصاري عن عبد الرحمن بن رافع بن خديج الأنصاري عن رفاعة بن هرير المديني عن يعقوب بن محمد بن عيسى عن إسحاق بن إبراهيم بن محمد الصواف عن الساجي عن الطبراني","عبد الرحمن بن رافع بن خديج عن أبيه"
"4380","4378  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْقِرْمِطِيُّ الْبَغْدَادِيُّ  ، ثَنَا  عُثْمَانُ بْنُ يَعْقُوبَ الْعُثْمَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ طَلْحَةَ التَّيْمِيُّ ،  عَنْ  مُحَمَّدِ بْنِ سَهْلِ بْنِ أَبِي حَثْمَةَ ،  عَنْ  هُرَيْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ :  لَمَّا كَانَ  يَوْمُ الْخَنْدَقِ  لَمْ يَكُنْ حِصْنٌ أَحْصَنَ مِنْ حِصْنِ  بَنِي حَارِثٍ  ، فَجَعَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ النِّسَاءَ وَالصِّبْيَانَ وَالذَّرَارِي فِيهِ فَقَالَ :  إِنْ أَلَمَّ بِكُنَّ أَحَدٌ فَأَلْمِعْنَ بِالسَّيْفِ  ، فَجَاءَهُنَّ رَجُلٌ مِنْ  بَنِي ثَعْلَبَةَ بْنِ سَعْدٍ  يُقَالُ لَهُ  بُجْدَانُ  أَحَدُ  بَنِي جَحَّاشٍ  عَلَى فَرَسٍ حَتَّى كَانَ فِي أَصْلِ الْحِصْنِ ثُمَّ جَعَلَ يَقُولُ لِلنِّسَاءِ : انْزِلَنْ إِلَيَّ خَيْرٌ لَكُنَّ ، فَحَرَّكْنَ السَّيْفَ فَأَبْصَرَهُ أَصْحَابُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَابْتَدَرَ الْحِصْنَ قَوْمٌ فِيهِمْ رَجُلٌ مِنْ  بَنِي حَارِثَةَ  يُقَالُ لَهُ  ظُهَيْرُ بْنُ رَافِعٍ  ، فَقَالَ : يَا  بُجْدَانُ  أَبْرِزْ فَبَرَزَ إِلَيْهِ ، فَحَمَلَ عَلَيْهِ فَرَسَهُ فَقَتَلَهُ وَأَخَذَ رَأْسَهُ ، فَذَهَبَ بِهِ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 4378","","رافع بن خديج الأنصاري عن عبد الرحمن بن رافع بن خديج الأنصاري عن هرير بن عبد الرحمن بن رافع بن خديج عن محمد بن سهل بن أبي حثمة الأوسي عن محمد بن طلحة بن عبد الرحمن عن عثمان بن يعقوب العثماني عن القرمطي محمد بن عبد الله العدوي عن الطبراني","عبد الرحمن بن رافع بن خديج عن أبيه"
"4381","سَعِيدُ بْنُ أَبِي رَافِعِ بْنِ خَدِيجٍ  عَنْ أَبِيهِ عَنْ جَدِّهِ  4379  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عُثْمَانُ عَبْدُ الرَّحْمَنِ الطَّرَائِفِيُّ ،  ثَنَا  أَبَانُ بْنُ الْمُحَبَّرِ ،  عَنْ  سَعِيدِ بْنِ رَافِعِ بْنِ         [4/269]      خَدِيجٍ  ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْتَمِسُوا الْجَارَ قَبْلَ الدَّارِ  وَالرَّفِيقَ قَبْلَ الطَّرِيقِ  .  كذا في طبعة مكتبة ابن تيمية ، والنسخة الخطية والجامع للخطيب ، والصواب : ( سعيد بن معروف بن رافع ) كما في مسند الشهاب وتاريخ ابن أبي خيثمة وغيرهما ، ولعله نسبه لجده أو سقط : ( بن معروف ) ، والله أعلم","","Al-Mu'jam al-Kabir 4379","","خديج بن رافع بن عدي الأوسي عن رافع بن خديج الأنصاري عن سعيد بن معروف بن رافع بن خديج عن أبان بن المحبر عن عثمان بن عبد الرحمن الطرائفي عن عبد الوهاب بن نجدة عن أحمد بن عبد الوهاب بن نجدة عن الطبراني","سعيد بن أبي رافع بن خديج عن أبيه عن جده"
"4382","عَبَايَةُ بْنُ رِفَاعَةَ بْنِ رَافِعِ بْنِ خَدِيجٍ  عَنْ جَدِّهِ  رَافِعٍ  4380  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ بْنِ رَافِعٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِذِي الْحُلَيْفَةِ  مِنْ  تِهَامَةَ  ، فَأَصَابَ  الْقَوْمُ  إِبِلًا وَغَنَمًا ، فَعَجِلُوا فَأَغْلَوْا بِهِ الْقُدُورَ ، فَانْتَهَى إِلَيْهِمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَمَرَ بِالْقُدُورِ فَكُفِئَتْ ، فَعَدَلَ عَشَرَةً مِنَ الْغَنَمِ بِجَزُورٍ ، قَالَ :  وَنَدَّ  مِنْهَا بَعِيرٌ فَرَمَاهُ  رَجُلٌ  بِسَهْمٍ فَحَبَسَهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِهَذِهِ الْبَهَائِمِ  أَوَابِدَ  كَأَوَابِدِ  الْوَحْشِ ، فَمَا غَلَبَكُمْ مِنْهَا فَاصْنَعُوا بِهِ هَكَذَا  ، ثُمَّ أَتَاهُ  رَافِعُ بْنُ خَدِيجٍ  فَقَالَ : يَا رَسُولَ اللهِ  إِنَّا نَخَافُ أَوْ نَرْجُو  أَنْ نَلْقَى الْعَدُوَّ وَلَيْسَ مَعَنَا مُدًى أَفَنَذْبَحُ بِالْقَصَبِ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا  أَنْهَرَ  الدَّمَ وَذُكِرَ عَلَيْهِ اسْمُ اللهِ فَكُلُوا لَيْسَ السِّنَّ وَالظُّفُرَ ، وَسَأُحَدِّثُكُمْ عَنْ ذَلِكَ ، أَمَّا السِّنُّ فَعَظْمٌ ، وَأَمَّا الظُّفُرُ فَمُدَى الْحَبَشِ . قَالَ  رَافِعٌ  : ثُمَّ إِنَّ  نَاضِحًا  تَرَدَّى فِي بِئْرٍ  بِالْمَدِينَةِ  ، فَذُكِّيَ مِنْ قِبَلِ شَاكِتَلِهِ -  يَعْنِي  خَاصِرَتَهُ  - ، فَأَخَذَ مِنْهُ  عُمَرُ  عَشِيرًا بِدِرْهَمٍ  .","","Al-Mu'jam al-Kabir 4380","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4383","4381  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَزْهَرُ بْنُ مَرْوَانَ الرَّقَاشِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  سُفْيَانَ بْنِ سَعِيدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  قُلْنَا : يَا رَسُولَ اللهِ ، إِنَّا نَرْجُو أَنْ نَلْقَى عَدُوَّنَا ، فَعَسَى أَنْ لَا يَكُونَ مَعَنَا بَعْضُ الْعِدَّةِ مِمَّا يُصْلِحُنَا ، أَفَنَأْكُلُ كُلَّ ذَبِيحَةِ الْقَصَبَةِ ؟ قَالَ :  نَعَمْ كُلُّ مَا  أَنْهَرَ  الدَّمَ ذَكَاةٌ إِلَّا السِّنَّ وَالظُّفُرَ  .","","Al-Mu'jam al-Kabir 4381","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن سفيان الثوري عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن أزهر بن مروان الرقاشي عن عبد الله بن أحمد الجواليقي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4384","4382  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  رَحِمَهُ اللهُ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ         [4/270]      رَافِعِ بْنِ خَدِيجٍ ،  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ إِنَّا لَاقُو الْعَدُوِّ غَدًا وَلَيْسَ مَعَنَا مُدًى قَالَ :  مَا  أَنْهَرَ  الدَّمَ وَذُكِرَ اسْمُ اللهِ عَلَيْهِ فَكُلْ ، لَيْسَ السِّنَّ وَالظُّفُرَ  ، وَسَأُحَدِّثُكُمْ ، أَمَّا السِّنُّ فَعَظْمٌ ، وَأَمَّا الظُّفُرُ فَمُدَى  الْحَبَشَةِ ،  وَأَصَابَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِبِلًا  فَنَدَّ  بَعِيرٌ مِنْهَا ، فَرَمَاهُ  رَجُلٌ  مِنَ  الْقَوْمِ  بِسَهْمٍ فَحَبَسَهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ لِهَذِهِ الْإِبِلِ  أَوَابِدَ  كَأَوَابِدِ  الْوَحْشِ ، فَإِذَا غَلَبَكُمْ شَيْءٌ مِنْهَا فَاصْنَعُوا بِهِ هَكَذَا ، قَالَ : وَكَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَجْعَلُ فِي قَسْمِ الْغَنَائِمِ عَشْرًا مِنَ الشَّاءِ بِبَعِيرٍ  ، قَالَ :  وَحَدَّثَنِي  سُفْيَانُ عَنْهُ ، قَالَ مُحَمَّدٌ : وَقَدْ سَمِعْتُ مِنْ سُفْيَانَ هَذَا الْحَرْفَ  .","","Al-Mu'jam al-Kabir 4382","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4385","4383  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  زَائِدَةُ ،  ثَنَا  سَعِيدُ بْنُ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  بَيْنَمَا نَحْنُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِذِي الْحُلَيْفَةِ  مِنْ  تِهَامَةَ  وَقَدْ جَاعَ  الْقَوْمُ  فَأَصَابُوا غَنَمًا وَإِبِلًا ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أُخْرَيَاتِ النَّاسِ ، فَعَجِلُوا وَذَبَحُوا فَصَنَعُوا الْقُدُورَ ، فَانْتَهَى إِلَيْهِمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَمَرَ بِالْقُدُورِ فَكُفِئَتْ ، ثُمَّ قَسَمَ فَعَدَلَ عَشَرَةً مِنَ الْغَنَمِ بِبَعِيرٍ ، وَكَانَ فِي  الْقَوْمِ  جَمَلٌ  فَنَدَّ  فَطَلَبُوهُ فَأَعْيَاهُمْ ، فَأَهْوَى إِلَيْهِ  رَجُلٌ  بِسَهْمٍ فَحَبَسَهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِهَذِهِ الْبَهَائِمِ  أَوَابِدَ  كَأَوَابِدِ  الْوَحْشِ فَمَا  نَدَّ  عَلَيْكُمْ مِنْهَا فَاصْنَعُوا بِهِ هَكَذَا  ، فَقُلْنَا :  إِنَّا نَخَافُ أَوْ نَرْجُو  أَنْ نَلْقَى الْعَدُوَّ غَدًا وَلَيْسَ مَعَنَا مُدًى أَفَنَذْبَحُ بِالْقَصَبِ ؟ فَقَالَ : مَا  أَنْهَرَ  الدَّمَ وَذُكِرَ اسْمُ اللهِ عَلَيْهِ فَكُلْ ، لَيْسَ السِّنَّ وَالظُّفُرَ ، وَسَأُخْبِرُكُمْ عَنْ ذَلِكَ ، أَمَّا السِّنُّ فَعَظْمٌ ، وَأَمَّا الظُّفُرُ فَمُدَى الْحَبَشَةِ  .","","Al-Mu'jam al-Kabir 4383","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن زائدة بن قدامة عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4386","4384  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  جَدِّهِ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِذِي الْحُلَيْفَةِ  ، فَأُصِيبَ إِبِلٌ وَغَنَمٌ ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أُخْرَيَاتِ النَّاسِ ، فَعَجِلُوا وَذَبَحُوا فَصَنَعُوا الْقُدُورَ فَدَفَعَ إِلَيْهِمُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَمَرَ بِالْقُدُورِ فَأُكْفِئَتْ ، ثُمَّ قَسَمَ فَعَدَلَ عَشَرَةً مِنَ الْغَنَمِ بِبَعِيرٍ ، وَكَانَ فِي  الْقَوْمِ  جَمَلٌ يَسْتَنُّ فَطَلَبُوهُ فَأَعْيَاهُمْ ، فَأَهْوَى إِلَيْهِ  رَجُلٌ  بِسَهْمٍ         [4/271]      فَحَبَسَهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ هَذِهِ الْبَهَائِمَ لَهَا  أَوَابِدُ  كَأَوَابِدِ  الْوَحْشِ ، فَمَا  نَدَّ  عَلَيْكُمْ مِنْهَا فَاصْنَعُوا بِهِ هَكَذَا  ، قَالَ جَدِّي :  إِنَّا لَنَرْجُو أَوْ نَخَافُ  أَنْ نَلْقَى الْعَدُوَّ غَدًا وَلَيْسَ مَعَنَا مُدًى أَفَنَذْبَحُ بِالْقَصَبِ ؟ فَقَالَ : مَا  أَنْهَرَ  الدَّمَ وَذُكِرَ اسْمُ اللهِ تَعَالَى عَلَيْهِ فَكُلْ ، لَيْسَ السِّنَّ وَالظُّفُرَ ، وَسَأُخْبِرُكُمْ عَنْ ذَلِكَ أَمَّا السِّنُّ فَعَظْمٌ وَأَمَّا الظُّفُرُ فَمُدَى  الْحَبَشَةِ  .","","Al-Mu'jam al-Kabir 4384","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4387","4385  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ رَافِعِ بْنِ خَدِيجٍ  ، قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ إِنَّا نَلْقَى الْعَدُوَّ غَدًا وَلَيْسَ مَعَنَا مُدًى فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا  أَنْهَرَ  الدَّمَ وَذُكِرَ اسْمُ اللهِ عَلَيْهِ فَكُلُوا  مَا لَمْ يَكُنْ سِنٌّ وَلَا ظُفُرٌ وَسَأُحَدِّثُكُمْ عَنْ ذَلِكَ ، أَمَّا السِّنُّ فَعَظْمٌ ، وَأَمَّا الظُّفُرُ فَمُدَى  الْحَبَشَةِ  .","","Al-Mu'jam al-Kabir 4385","","رافع بن خديج الأنصاري عن رفاعة بن رافع بن خديج عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4388","4386  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  حَدَّثَنِي  دَاوُدُ بْنُ عِيسَى الْكُوفِيُّ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  جَدِّهِ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِذِي الْحُلَيْفَةِ  فَأَصَبْنَا إِبِلًا وَغَنَمًا ، فَانْطَلَقَ أُنَاسٌ فِي  سَرَعَانِ  النَّاسِ ، فَذَبَحُوا وَنَصَبُوا قُدُورَهُمْ قَبْلَ أَنْ يُقْسَمَ ، فَمَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَكَانَ فِي أُخْرَيَاتِ النَّاسِ ، فَرَأَى الْقُدُورَ قَدْ نُصِبَتْ ، فَقَالَ : مَا هَذَا ؟ فَقِيلَ : يَا رَسُولَ اللهِ ذَبَحُوا وَطَبَخُوا ، فَأَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِالْقُدُورِ فَكُفِئَتْ ، ثُمَّ أَمَرَ بِالْغَنَائِمِ فَقُسِمَتْ ، فَجَعَلَ مَكَانَ كُلِّ بَعِيرٍ عَشْرَ  شِيَاهٍ  ، قَالَ : فَبَيْنَا نَحْنُ عَلَى ذَلِكَ إِذْ  نَدَّ  بَعِيرٌ مِنْهَا ، فَطَلَبَهُ  رَجُلٌ  مِنَ النَّاسِ فَرَمَاهُ  رَجُلٌ  بِسَهْمٍ فَحَبَسَهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِهَذِهِ الْإِبِلِ  أَوَابِدَ  كَأَوَابِدِ  الْوَحْشِ ، فَمَا غَلَبَكُمْ مِنْهَا فَافْعَلُوا بِهِ هَكَذَا  ، ثُمَّ قَالَ جَدِّي : يَا رَسُولَ اللهِ إِنَّا نَخَافُ أَنْ نَلْقَى الْمُشْرِكِينَ غَدًا ، وَلَيْسَتْ مَعَنَا مُدًى فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا  أَنْهَرَ  الدَّمَ وَذُكِرَ اسْمُ اللهِ عَلَيْهِ فَكُلْ ، إِلَّا سِنًّا أَوْ ظُفُرًا ، وَسَأُحَدِّثُكُمْ عَنْ ذَلِكَ ، أَمَّا السِّنُّ فَعَظْمٌ ، وَأَمَّا الظُّفُرُ فَمُدَى  الْحَبَشَةِ  .","","Al-Mu'jam al-Kabir 4386","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن داود بن عيسى النخعي عن يحيى بن حمزة بن البتلهي عن محمد بن يحيى بن حمزة الحضرمي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4389","[4/272]      4387  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، حَدَّثَنَا  أَحْمَدُ بْنُ الْحُبَابِ الْحِمْيَرِيُّ ،  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ ،  ثَنَا  أَبُو حَنِيفَةَ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّ بَعِيرًا مِنْ إِبِلِ الصَّدَقَةِ  نَدَّ  فَطَلَبُوهُ ، فَلَمَّا أَعْيَاهُمْ أَنْ يَأْخُذُوهُ رَمَاهُ  رَجُلٌ  بِسَهْمٍ ، فَأَصَابَ مَقْتَلَهُ ، فَسَأَلُوهُ عَنْ أَكْلِهِ ، فَأَمَرَهُمْ بِأَكْلِهِ فَقَالَ :  إِنَّ لَهَا  أَوَابِدَ  كَأَوَابِدِ  الْوَحْشِ  ، فَإِذَا خَشِيتُمْ مِنْهَا شَيْئًا فَاصْنَعُوا بِهِ مِثْلَ مَا صَنَعْتُمْ بِهَذَا ثُمَّ كُلُوهُ  .","","Al-Mu'jam al-Kabir 4387","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن أبو حنيفة النعمان عن مكي بن إبراهيم عن أحمد بن الحباب بن حمزة البلخي عن عبد الله بن أحمد الجواليقي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4390","4388  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حُبَيْبُ بْنُ حَبِيبٍ ،  ثَنَا  سَعِيدُ بْنُ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا غُزَاةً مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ  رَجُلٌ  مِنَ  الْقَوْمِ  : يَا رَسُولَ اللهِ إِنَّا نُصَبِّحُ الْعَدُوَّ غَدًا وَلَيْسَ مَعَنَا مُدًى أَفَنَذْبَحُ بِالْقَصَبِ وَالْمَرْوَةِ ؟ قَالَ :  نَعَمِ ، اذْكُرِ اسْمَ اللهِ عَلَيْهِ وَكُلْ إِلَّا السِّنَّ وَالظُّفُرَ  فَأَمَّا السِّنُّ فَعَظْمٌ ، وَأَمَّا الظُّفُرُ فَمُدَى  الْحَبَشَةِ  .","","Al-Mu'jam al-Kabir 4388","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن حبيب بن حبيب الكوفي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4391","4389  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيغٍ ، وَدَاهِرُ بْنُ نُوحٍ ، قَالَا :  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  سَعِيدُ بْنُ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4389","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن حسان بن إبراهيم الكرماني عن داهر بن نوح الأهوازي عن عبد الله بن أحمد الجواليقي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4392","4390  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4390","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4393","4391  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  حَامِدُ بْنُ يَحْيَى ،  ثَنَا  سُفْيَانُ ،  ثَنَا  عُمَرُ بْنُ سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ بْنِ خَدِيجٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  أَصَبْنَا إِبِلًا  فَنَدَّ  مِنْهَا بَعِيرٌ فَرَمَيْنَاهُ بِالنَّبْلِ ، فَسَأَلْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  إِنَّ لِهَذِهِ الْإِبِلِ  أَوَابِدَ  كَأَوَابِدِ  الْوَحْشِ ، فَمَا  نَدَّ  مِنْهَا فَاصْنَعُوا بِهِ ذَلِكَ وَكُلُوهُ  .","","Al-Mu'jam al-Kabir 4391","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن عمر بن سعيد بن مسروق عن سفيان بن عيينة عن حامد بن يحيى البلخي عن الحسين بن إسحاق التستري عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4394","4392  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  مِنْدَلُ بْنُ عَلِيٍّ ،         [4/273]      وَعُمَرُ بْنُ عُبَيْدٍ ، وَحَمَّادُ بْنُ شُعَيْبٍ الْحِمَّانِيُّ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِذِي الْحُلَيْفَةِ  ، فَأَصَابَ النَّاسَ جُوعٌ فَأَصَبْنَا إِبِلًا وَغَنَمًا ، وَكَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي أُخْرَيَاتِ النَّاسِ ، فَعَجِلَ  سَرَعَانُ  النَّاسِ ، فَذَبَحُوا وَنَحَرُوا وَنَصَبُوا الْقُدُورَ ، فَدَفَعَ إِلَيْهِمُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالْقُدُورُ تَغْلِي ،  فَأَمَرَ بِهَا فَأُكْفِئَتْ ثُمَّ قَسَمَ ، فَعَدَلَ عَشَرَةً مِنَ الْغَنَمِ بِبَعِيرٍ ،  فَنَدَّ  بَعِيرٌ فَطَلَبُوهُ فَأَعْيَاهُمْ فَأَهْوَى لَهُ  رَجُلٌ  بِسَهْمٍ فَحَبَسَهُ  فَذَكَرَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 4392","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن حماد بن شعيب الحماني عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4395","4393  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  حَجَّاجُ بْنُ إِبْرَاهِيمَ الْأَزْرَقُ ،  حَدَّثَنَا  مُبَارَكُ بْنُ سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : كُنَّا مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 4393","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن المبارك بن سعيد بن مسروق الثوري عن حجاج بن إبراهيم الأبناوي عن يوسف بن يزيد القراطيسي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4396","4394  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  يُوسُفُ بْنُ خَالِدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غَزَاةٍ فَقُلْنَا : إِنَّا نُصَبِّحُ الْعَدُوَّ غَدًا وَلَيْسَ مَعَنَا مُدًى ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُّ شَيْءٍ  أَنْهَرَ  الدَّمَ وَذُكِرَ اسْمُ اللهِ عَلَيْهِ فَكُلُوهُ مَا لَمْ يَكُنْ سِنًّا أَوْ ظُفُرًا  ، فَإِنَّ السِّنَّ عَظْمٌ ، وَإِنَّ الظُّفُرَ مُدَى  الْحَبَشَةِ  .","","Al-Mu'jam al-Kabir 4394","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن يوسف بن خالد السمتي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4397","4395  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  لَيْثٌ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ رَافِعٍ  ، قَالَ :  أَصَبْنَا غَنَمًا فَقَسَمْنَاهَا  بِذِي الْحُلَيْفَةِ  ،  فَنَدَّ  مِنْهَا بَعِيرٌ ، فَاتَّبَعَهُ  رَجُلٌ  عَلَى فَرَسِهِ فَطَعَنَهُ  بِرُمْحٍ أَوْ ضَرَبَهُ بِالسَّيْفِ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِهَذِهِ الْإِبِلِ  أَوَابِدَ  كَأَوَابِدِ  الْوَحْشِ ، فَإِذَا  نَدَّ  مِنْهَا شَيْءٌ فَاصْنَعُوا بِهِ هَكَذَا  ، فَقَالَ  رَجُلٌ  : كُنَّا نَذْبَحُ بِالْمَرْوَةِ وَشِقَّةِ الْعِصِيِّ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَنْهِرِ الدَّمَ بِمَا شِئْتَ مَا لَمْ يَكُنْ سِنٌّ أَوْ ظُفُرٌ فَإِنَّ السِّنَّ عَظْمٌ ، وَإِنَّ الظُّفُرَ مُدَى  الْحَبَشَةِ  .","","Al-Mu'jam al-Kabir 4395","","رافع بن خديج الأنصاري عن رفاعة بن رافع بن خديج عن عباية بن رفاعة الزرقي عن ليث بن أبي سليم عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن عبد الله بن أحمد الجواليقي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4398","4396  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عُمَرَ بْنِ سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ         [4/274]      خَدِيجٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَعْطَى  أَبَا سُفْيَانَ  وَصَفْوَانَ بْنَ أُمَيَّةَ  ،  وَعُيَيْنَةَ بْنَ حِصْنٍ  ،  وَالْأَقْرَعَ بْنَ حَابِسٍ ،  الْحَدِيثَ  .","","Al-Mu'jam al-Kabir 4396","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن عمر بن سعيد بن مسروق عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن معاذ بن المثنى العنبري عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4399","4397  -  حَدَّثَنَا  عَمْرُو بْنُ ثَوْرٍ الْجُذَامِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحُمَّى مِنْ  فَيْحِ  جَهَنَّمَ  فَأَبْرِدُوهَا بِالْمَاءِ  .","","Al-Mu'jam al-Kabir 4397","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن سفيان الثوري عن محمد بن يوسف الفريابي عن عمرو بن ثور بن عمرو القيسراني عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4400","4398  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْحُمَّى مِنْ  فَوْرِ  جَهَنَّمَ  فَأَبْرِدُوهَا بِالْمَاءِ  .","","Al-Mu'jam al-Kabir 4398","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن سفيان الثوري عن عبد الرحمن بن مهدي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4401","4399  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالَا :  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحُمَّى مِنْ  فَيْحِ  جَهَنَّمَ  فَأَطْفِئُوهَا بِالْمَاءِ الْبَارِدِ  .","","Al-Mu'jam al-Kabir 4399","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن سلام بن سليم الحنفي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4402","4400  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  مُصْعَبُ بْنُ الْمِقْدَامِ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْحُمَّى مِنْ  فَيْحِ  جَهَنَّمَ  فَأَبْرِدُوهَا بِالْمَاءِ  .","","Al-Mu'jam al-Kabir 4400","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن إسرائيل بن يونس بن أبي إسحاق عن مصعب بن المقدام الخثعمي عن محمد بن عبد الله بن نمير عن عبد الله بن أحمد الجواليقي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4403","4401  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  مُصْعَبُ بْنُ الْمِقْدَامِ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  ابْنِ نُعَيْمَانَ  فَجَعَلَ يَقُولُ :  أَذْهِبِ الْبَأْسَ رَبَّ النَّاسِ إِلَهَ النَّاسِ  .","","Al-Mu'jam al-Kabir 4401","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن إسرائيل بن يونس بن أبي إسحاق عن مصعب بن المقدام الخثعمي عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4404","4402  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  جُبَارَةُ بْنُ الْمُغَلِّسِ ،  ثَنَا  حَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الصَّدَقَةُ تَسُدُّ سَبْعِينَ بَابًا مِنَ السُّوءِ  .","","Al-Mu'jam al-Kabir 4402","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن حماد بن شعيب الحماني عن جبارة بن المغلس عن عبيد العجل عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4405","[4/275]      4403  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  جُبَارَةُ بْنُ مُغَلِّسٍ ،  ثَنَا  حَمَّادُ بْنُ شُعَيْبٍ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَدُ الْمُعْطِي  الْعُلْيَا  وَيَدُ الْآخِذِ السُّفْلَى إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 4403","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن سعيد بن مسروق الثوري عن حماد بن شعيب الحماني عن جبارة بن المغلس عن عبيد العجل عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4406","4404  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  جُبَارَةُ بْنُ الْمُغَلِّسِ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  حَكِيمِ بْنِ جُبَيْرٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْمُسْلِمُونَ عِنْدَ شُرُوطِهِمْ فِيمَا أُحِلَّ  .","","Al-Mu'jam al-Kabir 4404","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن حكيم بن جبير الأسدي عن قيس بن الربيع الأسدي عن جبارة بن المغلس عن علي بن سعيد بن بشير عليك عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4407","4405  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ ، وَالْحَسَنُ بْنُ الْمُتَوَكِّلِ ، قَالَا :  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  يَحْيَى بْنِ أَبِي سُلَيْمٍ ، قَالَ :  سَمِعْتُ  عَبَايَةَ بْنَ رِفَاعَةَ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  جَدِّهِ ،  أَنَّهُ تَرَكَ حِينَ مَاتَ  جَارِيَةً  وَنَاضِحًا  وَعَبْدًا  حَجَّامًا وَأَرْضًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي الْجَارِيَةِ :  نَهَى عَنْ كَسْبِهَا  ، وَقَالَ فِي الْحَجَّامِ : مَا أَصَابَ فَاعْلِفْهُ  النَّاضِحَ  ، وَقَالَ فِي الْأَرْضِ : ازْرَعْهَا  .","","Al-Mu'jam al-Kabir 4405","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن أبو بلج يحيى بن سليم الفزاري عن شعبة بن الحجاج عن عاصم بن علي الواسطي عن الحسن بن علي بن المتوكل البغدادي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4408","4406  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بَلْجٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ، قَالَ :  مَاتَ  رِفَاعَةُ  عَلَى عَهْدِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَتَرَكَ  عَبْدًا  حَجَّامًا وَجَمَلًا  نَاضِحًا  وَأَرْضًا ، فَقَالَ :  أَمَّا الْحَجَّامُ فَلَا تَأْكُلُوا مِنْ  كَسْبِهِ  وَأَطْعِمُوهُ  النَّاضِحَ  ،  قَالُوا :  الْأَمَةُ  تَكْسِبُ ؟ قَالَ : لَا تَأْكُلْ مِنْ كَسْبِ الْأَمَةِ فَإِنِّي أَخَافُ أَنْ تَبْتَغِيَ بِفَرْجِهَا  .","","Al-Mu'jam al-Kabir 4406","","عباية بن رفاعة الزرقي عن أبو بلج يحيى بن سليم الفزاري عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4409","4407  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  حُصَيْنُ بْنُ نُمَيْرٍ ،  ثَنَا  أَبُو بَلْجٍ يَحْيَى بْنُ أَبِي سُلَيْمٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  مَاتَ أَبِي وَتَرَكَ أَرْضًا وَتَرَكَ  جَارِيَةً  وَغُلَامًا  حَجَّامًا  وَنَاضِحًا  ، فَأَتَوْا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي ذَلِكَ ، فَقَالَ لَهُمْ فِي الْأَرْضِ :  ازْرَعُوهَا أَوِ امْنَحُوهَا وَنَهَاهُمْ عَنْ كَسْبِ الْأَمَةِ  وَقَالَ : أَعْلِفُوا كَسْبَ الْحَجَّامِ  النَّاضِحَ  .","","Al-Mu'jam al-Kabir 4407","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن أبو بلج يحيى بن سليم الفزاري عن حصين بن نمير الأنصاري عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4410","4408  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  شُجَاعُ بْنُ مَخْلَدٍ ، وَأَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ، وَاللَّفْظُ  لِشُجَاعٍ  ، قَالَا :  ثَنَا  هُشَيْمٌ ،  أَنَا  أَبُو بَلْجٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  أَنَّ جَدَّهُ         [4/276]      تُوُفِّيَ وَتَرَكَ  أَمَةً  تُغِلُّ ، فَذَكَرُوا ذَلِكَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَكَرِهَ كَسْبَ الْأَمَةِ وَقَالَ :  لَعَلَّهَا لَا تَجِدُ شَيْئًا فَتَبْتَغِيَ بِنَفْسِهَا  . وَقَالَ  ابْنُ أَبِي شَيْبَةَ  فِي  إِسْنَادِهِ  :  ثَنَا  هُشَيْمٌ ،  عَنْ  أَبِي بَلْجٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ بْنِ رَافِعٍ الْأَنْصَارِيِّ .","","Al-Mu'jam al-Kabir 4408","","عباية بن رفاعة الزرقي عن أبو بلج يحيى بن سليم الفزاري عن هشيم بن بشير عن شجاع بن مخلد الفلاس عن موسى بن هارون الحمال عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4411","4409  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّازُ  ، ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْحَرَشِيُّ ،  ثَنَا  مَيْمُونُ بْنُ زَيْدٍ ،  عَنْ  لَيْثٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا رَأَى الْهِلَالَ قَالَ :  هِلَالُ خَيْرٍ وَرُشْدٍ ،  ثُمَّ قَالَ : اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ خَيْرِ هَذَا - ثَلَاثًا - اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ خَيْرِ هَذَا  الشَّهْرِ  ، وَخَيْرِ الْقَدَرِ ، وَأَعُوذُ بِكَ مِنْ شَرِّهِ ، ثَلَاثَ مَرَّاتٍ  .","","Al-Mu'jam al-Kabir 4409","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن ليث بن أبي سليم عن ميمون بن زيد الحارثي عن محمد بن موسى الحرشي عن البزار عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4412","4410  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ  ، ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ الْحِمْصِيُّ ، (  ح  )  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، حَدَّثَنِي  عَطِيَّةُ بْنُ بَقِيَّةَ ، (  ح  )  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ حَنَانٍ الْحِمْصِيُّ ، (  ح  )  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ، قَالُوا :  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  ثَنَا  ابْنُ ثَوْبَانَ ،  حَدَّثَنِي  أَبُو مُدْرِكٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  تَحَدَّثُوا  وَلْيَتَبَوَّأْ  مَنْ كَذَبَ عَلَيَّ مَقْعَدَهُ مِنْ  جَهَنَّمَ  ، قُلْتُ : يَا رَسُولَ اللهِ إِنَّا نَسْمَعُ مِنْكَ أَشْيَاءَ فَنَكْتُبُهَا ؟ فَقَالَ : اكْتُبُوا وَلَا حَرَجَ  .","","Al-Mu'jam al-Kabir 4410","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن عبد الله بن مدرك بن عبد الله الأزدي عن عبد الرحمن بن ثابت العنسي عن بقية بن الوليد عن محمد بن مصفى بن بهلول عن عبد الله بن أحمد الجواليقي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4413","4411  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ هُودٍ         [4/277]      الْوَاسِطِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  الْمَسْعُودُ  ،  عَنْ  وَائِلِ بْنِ دَاوُدَ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  جَدِّهِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ سُئِلَ : أَيُّ الْكَسْبِ أَفْضَلُ ؟ قَالَ :  عَمَلُ الرَّجُلِ بِيَدِهِ وَكُلُّ بَيْعٍ مَبْرُورٍ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب المسعودي كما رواه المصنف في موضع آخر من الأوسط .","","Al-Mu'jam al-Kabir 4411","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن وائل بن داود التيمي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن يزيد بن هارون عن إسماعيل بن إبراهيم بن هود عن محمود بن محمد بن منويه المفيد عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4414","4412  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، أَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  جَاءَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ أَوْ مَلَكٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  كَيْفَ تَعُدُّونَ  أَهْلَ بَدْرٍ  فِيكُمْ  ؟ قَالَ : هُمْ أَفَاضِلُ النَّاسِ قَالَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ : وَكَذَلِكَ مَنْ شَهِدَ  بَدْرًا  مِنَ الْمَلَائِكَةِ  .","","Al-Mu'jam al-Kabir 4412","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن يحيى بن سعيد التيمي عن سفيان الثوري عن وكيع بن الجراح عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4415","4413  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْوَاسِطِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  أَبِي حَيَّانَ التَّيْمِيِّ ،  عَنْ  عَبَايَةَ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  أَصْبَحَ  رَجُلٌ مِنَ الْأَنْصَارِ  مَقْتُولًا  بِخَيْبَرَ  فَانْطَلَقَ أَوْلِيَاؤُهُ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرُوا ذَلِكَ لَهُ ، فَقَالَ :  لَكُمْ شَاهِدَانِ يَشْهَدَانِ عَلَى قَاتِلِ صَاحِبِكُمْ ؟  قَالُوا : يَا رَسُولَ اللهِ لَمْ يَكُنْ ثَمَّ أَحَدٌ مِنَ الْمُسْلِمِينَ وَإِنَّمَا هُمْ يَهُودُ وَهُمْ يَجْتَرِئُونَ عَلَى مَا هُوَ أَعْظَمُ مِنْ هَذَا ، قَالَ : فَاخْتَارُوا مِنْهُمْ خَمْسِينَ فَاسْتَحْلَفُوهُمْ ،  فَوَدَاهُمْ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ عِنْدِهِ  .","","Al-Mu'jam al-Kabir 4413","","رافع بن خديج الأنصاري عن عباية بن رفاعة الزرقي عن يحيى بن سعيد التيمي عن هشيم بن بشير عن الحسن بن علي بن راشد الواسطي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","عباية بن رفاعة بن رافع بن خديج عن جده رافع"
"4416","هُرَيْرُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ رَافِعِ بْنِ خَدِيجٍ  عَنْ جَدِّهِ  رَافِعٍ  4414  -  حَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ، قَالَا :  ثَنَا  أَبُو إِسْمَاعِيلَ الْمُؤَدِّبُ ،  ثَنَا  هُرَيْرُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ رَافِعِ بْنِ خَدِيجٍ الْأَنْصَارِيُّ ،  عَنْ         [4/278]      جَدِّهِ رَافِعِ بْنِ خَدِيجٍ ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِبِلَالٍ  :  نَوِّرْ  بِالْفَجْرِ قَدْرَ مَا يُبْصِرُ  الْقَوْمُ  مَوَاقِعَ نَبْلِهِمْ  .","","Al-Mu'jam al-Kabir 4414","","رافع بن خديج الأنصاري عن هرير بن عبد الرحمن بن رافع بن خديج عن إبراهيم بن سليمان أبو إسماعيل عن محمد بن بكار الرصافي عن عبد الله بن أحمد بن حنبل عن الطبراني","هرير بن عبد الرحمن بن رافع بن خديج عن جده رافع"
"4417","4415  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ رَافِعِ بْنِ خَدِيجٍ ، يَقُولُ :  سَمِعْتُ  رَافِعَ بْنَ خَدِيجٍ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  نَوِّرُوا بِالْفَجْرِ قَدْرَ مَا يُبْصِرُ  الْقَوْمُ  مَوَاقِعَ نَبْلِهِمْ  .","","Al-Mu'jam al-Kabir 4415","","رافع بن خديج الأنصاري عن عبد الرحمن بن رافع بن خديج الأنصاري عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","هرير بن عبد الرحمن بن رافع بن خديج عن جده رافع"
"4418","4416  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ الْمِصْرِيُّ ، وَإِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ، (  ح  )  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  جَعْفَرُ بْنُ مُسَافِرٍ ، قَالَا :  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  أَخْبَرَنِي  عُبَيْدُ اللهِ بْنُ هُرَيْرٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ رَافِعٍ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ عَلَيْهِ وَهُوَ مُزْدَرِعٌ ، فَسَأَلَهُ عَنْهَا فَأَخْبَرَهُ أَنَّ الْأَرْضَ  لِآلِ أَسِيدٍ  ، فَكَارَاهَا مِنْهُمْ ، فَأَمَرَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَنْ يَأْخُذَ كِرَاءَهُ مِنْهُمْ وَيُؤَدِّيَ إِلَيْهِمْ إِتَاءَ أَرْضِهِمْ  .  وَاللَّفْظُ  لِأَحْمَدَ بْنِ صَالِحٍ  .  قَالَ  أَحْمَدُ بْنُ صَالِحٍ  :  وَالْإِتَاءُ : هُوَ الْقِيمَةُ ، قِيمَةُ مَا يَخْرُجُ  .","","Al-Mu'jam al-Kabir 4416","","رافع بن خديج الأنصاري عن هرير بن عبد الرحمن بن رافع بن خديج عن عبيد الله بن هرير الحارثي عن محمد بن إسماعيل بن مسلم الديلي عن جعفر بن مسافر التنيسي عن عبد الله بن أحمد الجواليقي عن الطبراني","هرير بن عبد الرحمن بن رافع بن خديج عن جده رافع"
"4419","4417  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ شَيْبَانَ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  رِفَاعَةُ بْنُ هُرَيْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  حَدَّثَنِي  جَدِّي ،  عَنْ  أَبِيهِ  ، قَالَ :  جِئْتُ أَنَا  وِالْخَطْمِيُّ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يُرِيدُ  بَدْرًا  ، فَقُلْتُ : يَا رَسُولَ اللهِ إِنِّي أُرِيدُ أَنْ أَخْرُجَ مَعَكَ ، فَجَعَلَ يَقْبِضُ يَدَهُ وَيَقُولُ :  إِنِّي أَسْتَصْغِرُكَ ، وَلَا أَدْرِي مَا تَصْنَعُ إِذَا لَقِيتَ  الْقَوْمَ  ؟  فَقُلْتُ : أَتَعْلَمُ أَنَا أَرْمَى مَنْ رَمَى ؟ فَرَدَّنِي فَلَمْ أَشْهَدْ  بَدْرًا  .","","Al-Mu'jam al-Kabir 4417","","رافع بن خديج الأنصاري عن عبد الرحمن بن رافع بن خديج الأنصاري عن رفاعة بن هرير المديني عن يعقوب بن محمد بن عيسى عن أحمد بن سنان القطان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","هرير بن عبد الرحمن بن رافع بن خديج عن جده رافع"
"4420","عِيسَى بْنُ سَهْلِ بْنِ رَافِعٍ  عَنْ  رَافِعٍ  4418  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  سَعِيدُ بْنُ يَعْقُوبَ الطَّالْقَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  سَعِيدِ بْنِ يَزِيدَ بْنِ أَبِي شُجَاعٍ ،  ثَنَا  عِيسَى بْنُ سَهْلِ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  قَالَ : إِنِّي لَيَتِيمٌ فِي حِجْرِ جَدِّي رَافِعِ بْنِ خَدِيجٍ فَحَجَجْتُ مَعَهُ ، فَجَاءَهُ أَخِي  عِمْرَانُ بْنُ سَهْلِ بْنِ رَافِعٍ  فَقَالَ لَهُ :         [4/279]      يَا أَبَتَاهُ إِنَّا قَدْ أَكْرَيْنَا أَرْضَنَا فُلَانًا بِمِائَتَيْ دِرْهَمٍ ، فَقَالَ : يَا بُنَيَّ دَعْ عَنْكَ ذَلِكَ ، فَإِنَّ اللهَ سَيَجْعَلُ لَكُمْ زَرْعًا غَيْرَهُ ،  إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كَرْيِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4418","","رافع بن خديج الأنصاري عن عيسى بن سهل بن رافع بن خديج عن سعيد بن يزيد الحميري عن عبد الله بن المبارك عن سعيد بن يعقوب الطالقاني عن لحية الليف محمد بن العباس عن الطبراني","عيسى بن سهل بن رافع عن رافع"
"4421","عَمْرُو بْنُ عُبَيْدِ اللهِ بْنِ رَافِعٍ  عَنْ  رَافِعٍ  4419  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  حَامِدُ بْنُ يَحْيَى ،  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ،  ثَنَا  خَارِجَةُ بْنُ عَبْدِ اللهِ بْنِ سُلَيْمَانَ بْنِ زَيْدِ بْنِ ثَابِتٍ ،  عَنْ  عَمْرِو بْنِ عُبَيْدِ اللهِ بْنِ رَافِعٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْوُدُّ الَّذِي يَتَوَارَثُ فِي أَهْلِ الْإِسْلَامِ  .","","Al-Mu'jam al-Kabir 4419","","رافع بن خديج الأنصاري عن عمرو بن عبيد الله بن رافع عن خارجة بن عبد الله النجاري عن الواقدي عن حامد بن يحيى البلخي عن روح بن الفرج القطان عن الطبراني","عمرو بن عبيد الله بن رافع عن رافع"
"4422","يَحْيَى بْنُ إِسْحَاقَ ابْنِ أَخِي رَافِعٍ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4420  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدَنِيِّ  ، (  ح  )  وَحَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَا :  ثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  ثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  يَحْيَى بْنِ إِسْحَاقَ ابْنِ أَخِي رَافِعٍ ،  عَنْ  رَافِعٍ ، أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا اضْطَجَعَ أَحَدُكُمْ عَلَى جَنْبِهِ الْأَيْمَنِ ثُمَّ قَالَ : اللَّهُمَّ أَسْلَمْتُ نَفْسِي إِلَيْكَ  ، وَأَلْجَأْتُ ظَهْرِي إِلَيْكَ ،  وَفَوَّضْتُ  أَمْرِي إِلَيْكَ ، لَا مَنْجَا مِنْكَ إِلَّا إِلَيْكَ ، وَأُومِنُ رَبَّنَا بِكَ وَبِرُسُلِكَ ، فَإِنْ مَاتَ مِنْ لَيْلَتِهِ دَخَلَ الْجَنَّةَ  .  كذا في طبعة مكتبة ابن تيمية ، وصوابه : ( علي بن المديني) .","","Al-Mu'jam al-Kabir 4420","","رافع بن خديج الأنصاري عن يحيى بن إسحاق الأنصاري ابن أخي رافع بن خديج عن يحيى بن أبي كثير عن علي بن المبارك الهنائي عن عثمان بن عمر بن فارس عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","يحيى بن إسحاق ابن أخي رافع عن رافع بن خديج"
"4423","أَبُو النَّجَاشِيِّ عَطَاءُ بْنُ صُهَيْبٍ مَوْلَى رَافِعٍ  عَنْ  رَافِعٍ  4421  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ، (  ح  )  وَحَدَّثَنَا  أَحْمَدُ بْنُ مَسْعُودٍ الْمَقْدِسِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الصَّنْعَانِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ، قَالُوا :  ثَنَا         [4/280]      الْأَوْزَاعِيُّ ،  حَدَّثَنِي  أَبُو النَّجَاشِيِّ ،  حَدَّثَنِي  رَافِعُ بْنُ خَدِيجٍ ، قَالَ :  كُنَّا نُصَلِّي مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَلَاةَ الْعَصْرِ  ، ثُمَّ نَنْحَرُ  الْجَزُورَ  فَنَقْسِمُ ثُمَّ نَطْبُخُ فَنَأْكُلُ لَحْمًا نَضِيجًا قَبْلَ أَنْ تَغِيبَ الشَّمْسُ  .","","Al-Mu'jam al-Kabir 4421","","رافع بن خديج الأنصاري عن عطاء بن صهيب مولى رافع بن خديج عن أبو عمرو الأوزاعي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","أبو النجاشي عطاء بن صهيب مولى رافع عن رافع"
"4424","4422  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ، قَالُوا :  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  أَبُو النَّجَاشِيِّ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا نُصَلِّي الْمَغْرِبَ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فَيَنْصَرِفُ أَحَدُنَا وَإِنَّهُ لَيَنْظُرُ إِلَى مَوَاقِعِ نَبْلِهِ  .","","Al-Mu'jam al-Kabir 4422","","رافع بن خديج الأنصاري عن عطاء بن صهيب مولى رافع بن خديج عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","أبو النجاشي عطاء بن صهيب مولى رافع عن رافع"
"4425","4423  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنِ  الْأَوْزَاعِيِّ ،  حَدَّثَنِي  أَبُو النَّجَاشِيِّ عَطَاءُ بْنُ صُهَيْبٍ ، مَوْلَى رَافِعِ بْنِ خَدِيجٍ ، قَالَ : صَحِبْتُ رَافِعَ بْنَ خَدِيجٍ سِتَّ سِنِينَ  فَحَدَّثَنِي  ،  عَنْ  عَمِّهِ ظُهَيْرِ بْنِ رَافِعٍ ، أَنَّهُ لَقِيَهُ يَوْمًا ، فَقَالَ لَهُ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَانَا عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، قَالَ  رَافِعٌ  : فَقُلْتُ : مَا قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَهُوَ الْحَقُّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَرَأَيْتَ مَحَاقِلَتَكُمْ مَاذَا تَصْنَعُونَ بِهَا ؟  قُلْنَا : نُؤْجِرُهَا عَلَى الرُّبُعِ وَعَلَى الْأَوْسُقِ مِنَ التَّمْرِ وَالشَّعِيرِ ، قَالَ : فَلَا تَفْعَلُوا ، ازْرَعُوهَا أَوْ أَزْرِعُوهَا أَوْ أَمْسِكُوهَا  .","","Al-Mu'jam al-Kabir 4423","","ظهير بن رافع الأوسي عن رافع بن خديج الأنصاري عن عطاء بن صهيب مولى رافع بن خديج عن أبو عمرو الأوزاعي عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","أبو النجاشي عطاء بن صهيب مولى رافع عن رافع"
"4426","4424  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ الْعَنْبَرِيُّ ،  ثَنَا  الْمَنْصُورُ بْنُ مُحَمَّدٍ ،  ثَنَا  عِكْرِمَةُ بْنُ عَمَّارٍ ،  حَدَّثَنِي  أَبُو النَّجَاشِيِّ ،  حَدَّثَنِي  رَافِعُ بْنُ خَدِيجٍ ، قَالَ :  قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْمَدِينَةَ وَهُمْ  يُؤَبِّرُونَ  النَّخْلَ - يَقُولُ  يُلَقِّحُونَ  - قَالَ : مَا تَصْنَعُونَ ؟ قَالُوا : كُنَّا نَصْنَعُهُ قَالَ : لَوْ لَمْ تَفْعَلُوا كَانَ خَيْرًا فَتَرَكُوهَا فَشِيصَتْ فَذُكِرَ ذَلِكَ لَهُ ، فَقَالَ :  إِنَّمَا أَنَا بَشَرٌ ، فَإِذَا أَمَرْتُكُمْ بِشَيْءٍ مِنْ دِينِكُمْ فَخُذُوا بِهِ  ، وَإِذَا أَمَرْتُكُمْ بِشَيْءٍ مِنْ دُنْيَاكُمْ فَإِنَّمَا أَنَا بَشَرٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( النضر بن محمد )","","Al-Mu'jam al-Kabir 4424","","رافع بن خديج الأنصاري عن عطاء بن صهيب مولى رافع بن خديج عن عكرمة بن عمار عن النضر بن محمد بن موسى الجرشي عن عباس بن عبد العظيم العنبري عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو النجاشي عطاء بن صهيب مولى رافع عن رافع"
"4427","[4/281]      بُشَيْرُ بْنُ يَسَارٍ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4425  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  رَحِمَهُ اللهُ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنِ  الْوَلِيدِ بْنِ كَثِيرٍ ،  عَنْ  بُشَيْرِ بْنِ يَسَارٍ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، وَسَهْلِ بْنِ أَبِي حَثْمَةَ  حَدَّثَاهُ  : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنِ  الْمُزَابَنَةِ  ،  وَالْمُزَابَنَةُ  التَّمْرُ بِالتَّمْرِ إِلَّا أَصْحَابَ الْعَرَايَا فَإِنَّهُ قَدْ أَذِنَ لَهُمْ  .","","Al-Mu'jam al-Kabir 4425","","سهل بن أبي حثمة الخزرجي عن بشير بن يسار الحارثي عن الوليد بن كثير المخزومي عن حماد بن أسامة القرشي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","بشير بن يسار عن رافع بن خديج"
"4428","4426  -  حَدَّثَنَا  إِبْرَاهِيمُ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ، (  ح  )  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  دُحَيْمٌ ، قَالَا :  أَنْبَأَ  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  يَحْيَى بْنِ سَعِيدِ بْنِ بُشَيْرِ بْنِ يَسَارٍ  ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الرُّطَبِ بِالتَّمْرِ  وَرَخَّصَ فِي  الْعَرِيَّةِ  أَنْ يَشْتَرِيَهَا أَهْلُهَا  بِخَرْصِهَا  بِتَمْرٍ يَأْكُلُونَهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( يحيى بن سعيد ( عن ) بشير بن يسار )","","Al-Mu'jam al-Kabir 4426","","رافع بن خديج الأنصاري عن بشير بن يسار الحارثي عن يحيى بن سعيد الأنصاري عن سويد بن عبد العزيز السلمي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","بشير بن يسار عن رافع بن خديج"
"4429","4427  -  حَدَّثَنَا  مُحَمَّدُ بْنُ فَضَالَةَ الْجَوْهَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُبَيْدِ بْنِ حِسَابٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  بُشَيْرِ بْنِ يَسَارٍ ،  عَنْ  سَهْلِ بْنِ أَبِي حَثْمَةَ ، وَرَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  فِي  الْقَسَامَةِ  .","","Al-Mu'jam al-Kabir 4427","","رافع بن خديج الأنصاري عن بشير بن يسار الحارثي عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن محمد بن عبيد بن حساب الغبري عن محمد بن قضاء الجوهري عن الطبراني","بشير بن يسار عن رافع بن خديج"
"4430","4428  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  بُشَيْرِ بْنِ يَسَارٍ ،  عَنْ  سَهْلِ بْنِ أَبِي حَثْمَةَ ، وَرَافِعِ بْنِ خَدِيجٍ ، قَالَا :  خَرَجَ  عَبْدُ اللهِ بْنُ سَهْلِ بْنِ زَيْدٍ  وَمُحَيِّصَةُ بْنُ مَسْعُودٍ  حَتَّى إِذَا كَانَا  بِخَيْبَرَ  ، تَفَرَّقَا فِي بَعْضِ مَا هُنَاكَ ، فَإِذَا  عَبْدُ اللهِ بْنُ سَهْلٍ  قَتِيلٌ ، فَدَفَنَهُ  مُحَيِّصَةُ  ثُمَّ أَقْبَلَ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ هُوَ  وَحُوَيِّصَةُ ابْنَا مَسْعُودٍ  ،  وَعَبْدُ الرَّحْمَنِ بْنُ سَهْلٍ  ، فَذَهَبَ  عَبْدُ الرَّحْمَنِ  يَتَكَلَّمُ وَكَانَ أَصْغَرَ  الْقَوْمِ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : الْكِبْرَ ، فَتَكَلَّمَ صَاحِبَاهُ وَتَكَلَّمَ مَعَهُمَا ، ثُمَّ ذَكَرُوا لَهُ مَقْتَلَ  عَبْدِ اللهِ بْنِ سَهْلٍ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَتَحْلِفُونَ خَمْسِينَ أَنَّهُ قَاتِلُ صَاحِبِكُمْ ؟  قَالُوا : كَيْفَ نَحْلِفُ عَلَى مَا لَمْ نَشْهَدْ ؟ قَالَ : فَتُبَرِّئُكُمْ يَهُودُ         [4/282]      بِخَمْسِينَ يَمِينًا ، قَالُوا : كَيْفَ نَقْبَلُ أَيْمَانَ قَوْمٍ كُفَّارٍ ؟  فَوَدَاهُ  النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا رَأَى ذَلِكَ  .","","Al-Mu'jam al-Kabir 4428","","رافع بن خديج الأنصاري عن بشير بن يسار الحارثي عن يحيى بن سعيد الأنصاري عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","بشير بن يسار عن رافع بن خديج"
"4431","عُبَيْدُ بْنُ رِفَاعَةَ الزُّرَقِيُّ  عَنْ  رَافِعٍ  4429  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  خَالِدُ بْنُ يَزِيدَ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  أَبِي أُمَيَّةَ الْأَنْصَارِيِّ ،  عَنْ  عُبَيْدِ بْنِ رِفَاعَةَ الزُّرَقِيِّ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  دَخَلْتُ يَوْمًا عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَعِنْدَهُمْ قِدْرٌ  تَفُورُ  لَحْمًا ، فَأَعْجَبَتْنِي  شَحْمَةٌ  فَأَخَذْتُهَا فَازْدَرَتُّهَا ، فَاشْتَكَيْتُ عَلَيْهَا سَنَةً ، ثُمَّ إِنِّي ذَكَرْتُهُ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَ :  إِنَّهُ كَانَ فِيهَا نَفْسُ سَبْعَةِ أَنَاسِيَّ  ثُمَّ مَسَحَ بَطْنِي فَأَلْقَيْتُهَا خَضْرَاءَ فَوَالَّذِي بَعَثَهُ بِالْحَقِّ مَا اشْتَكَيْتُ بَطْنِي حَتَّى السَّاعَةِ  .","","Al-Mu'jam al-Kabir 4429","","رافع بن خديج الأنصاري عن عبيد بن رفاعة بن رافع الزرقي عن أبو أمية الأنصاري عن سعيد بن أبي هلال الليثي عن خالد بن يزيد الجمحي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","عبيد بن رفاعة الزرقي عن رافع"
"4432","سَعِيدٌ الْمَقْبُرِيُّ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4430  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَلِيُّ بْنُ أَبِي طَالِبٍ ،  ثَنَا  غِيَاثُ بْنُ إِبْرَاهِيمَ الْكُوفِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْحَارِثِ بْنِ عَيَّاشِ بْنِ أَبِي رَبِيعَةَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  رَأَيْتُ فِي يَدِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَيْطًا  ، فَقُلْتُ : مَا هَذَا ؟ قَالَ : أَسْتَذْكِرُ بِهِ  .","","Al-Mu'jam al-Kabir 4430","","رافع بن خديج الأنصاري عن سعيد المقبري عن عبد الرحمن بن الحارث المخزومي عن غياث بن إبراهيم النخعي عن علي بن أبي طالب البزاز عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سعيد المقبري عن رافع بن خديج"
"4433","4431  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَبْدُ الْجَبَّارِ بْنُ عَاصِمٍ ،         [4/283]      ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  أَبُو عَبْدِ الرَّحْمَنِ ، مَوْلَى بَنِي تَمِيمٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَرْبِطُ الْخَيْطَ فِي خَاتَمِهِ يَسْتَذْكِرُ بِهِ  .","","Al-Mu'jam al-Kabir 4431","","رافع بن خديج الأنصاري عن سعيد المقبري عن أبو عبدالرحمن التميمي الشامي عن بقية بن الوليد عن عبد الجبار بن عاصم الخراساني عن محمد بن عبدوس السراج عن الطبراني","سعيد المقبري عن رافع بن خديج"
"4434","مُعَاوِيَةُ بْنُ عَبْدِ اللهِ بْنِ جَعْفَرٍ  عَنْ  رَافِعٍ  4432  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هِشَامٍ الْبَغَوِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ،  ثَنَا  الْحُسَيْنُ بْنُ يَزِيدَ ،  عَنْ  مُعَاوِيَةَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  أَكَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عُضْوًا ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 4432","","رافع بن خديج الأنصاري عن معاوية بن عبد الله بن جعفر بن أبي طالب عن الحسين بن يزيد بن يحيى الطحان عن الواقدي عن الشاذكوني عن إبراهيم بن هاشم البغوي عن الطبراني","معاوية بن عبد الله بن جعفر عن رافع"
"4435","مُحَمَّدُ بْنُ سَهْلِ بْنِ أَبِي حَثْمَةَ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4433  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  الْحَسَنُ بْنُ جُمْهُورٍ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُوحٍ ،  عَنْ  مُحَمَّدِ بْنِ سَهْلِ بْنِ أَبِي حَثْمَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  قَدِمَتْ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وُفُودُ الْعَرَبِ  ، فَلَمْ يَقْدَمْ عَلَيْنَا وَفْدٌ أَقْسَى قُلُوبًا وَلَا أَحْرَى أَنْ يَكُونَ الْإِسْلَامُ لَمْ يَقَرَّ فِي قُلُوبِهِمْ مِنْ  بَنِي حَنِيفَةَ  .","","Al-Mu'jam al-Kabir 4433","","رافع بن خديج الأنصاري عن محمد بن سهل بن أبي حثمة الأوسي عن عبد الله بن نوح المكي عن الواقدي عن الحسن بن جمهور القمي عن عبد الله بن أحمد الجواليقي عن الطبراني","محمد بن سهل بن أبي حثمة عن رافع بن خديج"
"4436","4434  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  الْحُسَيْنُ بْنُ جُمْهُورٍ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُوحٍ ،  عَنْ  مُحَمَّدِ بْنِ سَهْلِ بْنِ أَبِي حَثْمَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كَانَ  بِالرَّجَّالِ بْنِ غَنْمَوَيْهِ  مِنَ الْخُشُوعِ وَاللُّزُومِ لِقِرَاءَةِ الْقُرْآنِ وَالْخَيْرِ فِيمَا يَرَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ شَيْءٌ  عَجَبٌ  ، فَخَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمًا  وَالرَّجَّالُ  مَعَنَا جَالِسٌ مَعَ نَفَرٍ فَقَالَ :  أَحَدُ هَؤُلَاءِ النَّفَرِ فِي النَّارِ  ،         [4/284]      قَالَ  رَافِعٌ  : فَنَظَرْتُ فِي  الْقَوْمِ  ، فَإِذَا  بِأَبِي هُرَيْرَةَ الدَّوْسِيِّ  وَأَبِي أَرْوَى الدَّوْسِيِّ  وَالطُّفَيْلِ بْنِ عَمْرٍو الدَّوْسِيِّ  وَرَجَّالُ بْنُ غَنْمَوَيْهِ  ، فَجَعَلْتُ أَنْظُرُ وَأَتَعَجَّبُ وَأَقُولُ مَنْ هَذَا الشَّقِيُّ ؟ وَلَمَّا تُوُفِّيَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَجَعَتْ  بَنُو حَنِيفَةَ  ، فَسَأَلَتْ مَا فَعَلَ  الرَّجَّالُ بْنُ غَنْمَوَيْهِ  ؟ فَقَالُوا : فُتِنَ هُوَ الَّذِي شَهِدَ  لمُسَيْلِمَةَ  عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ أَشْرَكَهُ فِي أَمْرِهِ مِنْ بَعْدِهِ ، فَقُلْتُ : مَا قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَهُوَ حَقٌّ وَسُمِعَ  الرَّجَّالُ  يَقُولُ : كَبْشَانِ انْتَطَحَا فَأَحَبُّهُمَا إِلَيْنَا كَبْشُنَا  .","","Al-Mu'jam al-Kabir 4434","","رافع بن خديج الأنصاري عن محمد بن سهل بن أبي حثمة الأوسي عن عبد الله بن نوح المكي عن الواقدي عن الحسن بن جمهور القمي عن عبد الله بن أحمد الجواليقي عن الطبراني","محمد بن سهل بن أبي حثمة عن رافع بن خديج"
"4437","جَعْفَرُ بْنُ مِقْلَاصٍ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4435  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنْ  أَبِي بَكْرٍ الدِّيرِيِّ ،  عَنْ  جَعْفَرِ بْنِ مِقْلَاصٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  يَوْمَ بَدْرٍ  :  وَالَّذِي نَفْسِي بِيَدِهِ لَوْ أَنَّ مَوْلُودًا وُلِدَ فِي فُقْهِ أَرْبَعِينَ سَنَةً  مِنْ أَهْلِ الدِّينِ يَعْمَلُ بِطَاعَةِ اللهِ كُلِّهَا ، وَيَجْتَنِبُ الْمَعَاصِيَ كُلَّهَا إِلَى أَنْ يُرَدَّ إِلَى  أَرْذَلِ  الْعُمُرِ ، أَوْ يُرَدَّ إِلَى أَنْ لَا يَعْلَمَ بَعْدَ عَلْمٍ شَيْئًا ، لَمْ يَبْلُغْ أَحَدُكُمْ هَذِهِ اللَّيْلَةَ وَقَالَ : إِنَّ لِلْمَلَائِكَةِ الَّذِينَ شَهِدُوا  بَدْرًا  لَفَضْلًا عَلَى مَنْ تَخَلَّفَ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 4435","","رافع بن خديج الأنصاري عن جعفر بن مقلاص عن أبو بكر الديري عن يحيى بن زكريا بن أبي زائدة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","جعفر بن مقلاص عن رافع بن خديج"
"4438","أَبُو عُفَيْرٍ الْأَنْصَارِيُّ  عَنْ  رَافِعٍ  4436  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي عُفَيْرٍ الْأَنْصَارِيِّ ،  أَنَّ  رَافِعَ بْنَ خَدِيجٍ كَانَ يَقُولُ :  مَنَعَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ نُكْرِيَ الْمَحَاقِلَ  ،  وَالْمَحَاقِلُ : فُضُولٌ يَكُونُ مِنَ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4436","","رافع بن خديج الأنصاري عن أبو عفير الأنصاري مولى رافع بن خديج عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","أبو عفير الأنصاري عن رافع"
"4439","عَطَاءُ بْنُ أَبِي رَبَاحٍ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4437  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ، (  ح  )         [4/285]      وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ شَيْبَةَ الْجُدِّيُّ ، (  ح  )  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ، (  ح  )  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ، (  ح  )  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ، (  ح  )  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عُزَيْزٍ الْمَوْصِلِيُّ  ، ثَنَا  غَسَّانُ بْنُ الرَّبِيعِ ، (  ح  )  وَحَدَّثَنَا  أَبُو حَصِينٍ الْقَاضِي  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ، قَالُوا :  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنْ زَرَعَ فِي أَرْضِ قَوْمٍ بِغَيْرِ إِذْنِهِمْ فَلَيْسَ لَهُ مِنَ الزَّرْعِ شَيْءٌ  ، وَتُرَدُّ عَلَيْهِ نَفَقَتُهُ  .","","Al-Mu'jam al-Kabir 4437","","رافع بن خديج الأنصاري عن عطاء بن أبي رباح عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","عطاء بن أبي رباح عن رافع بن خديج"
"4440","4438  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَحْمَدُ بْنُ أَبِي عُبَيْدِ اللهِ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  ثَنَا  عَبَّادُ بْنُ مَنْصُورٍ ،  عَنْ  عَطَاءٍ ، قَالَ :  كَانَ  عَبْدُ اللهِ بْنُ عُمَرَ  يَكْرَهُ أَنْ يُكْرِيَ الْأَرْضَ بِالثُّلُثِ وَالرُّبُعِ إِذَا كَانَ فِيهَا نَخْلٌ ، وَكَانَ يُكْرِي الْأَرْضَ  الْبَيْضَاءَ  بِالذَّهَبِ وَالْوَرِقِ ، فَلَقِيَهُ رَافِعُ بْنُ خَدِيجٍ فَقَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ كَرْيِ الْأَرْضِ ، وَعَنِ  الْمُحَاقَلَةِ  وَالْمُزَابَنَةِ  .","","Al-Mu'jam al-Kabir 4438","","رافع بن خديج الأنصاري عن عطاء بن أبي رباح عن عباد بن منصور الناجي عن عبد الأعلى بن عبد الأعلى القرشي عن أحمد بن أبي عبيد الله السليمي عن عبد الله بن أحمد الجواليقي عن الطبراني","عطاء بن أبي رباح عن رافع بن خديج"
"4441","4439  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ مَيْسَرَةَ ،  عَنْ  طَاوُسٍ ، وَعَطَاءٍ ، وَمُجَاهِدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  خَرَجَ إِلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَنَهَانَا عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَأَمْرُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَيْرٌ لَنَا مِمَّا نَهَانَا عَنْهُ ، قَالَ :  مَنْ كَانَتْ لَهُ أَرْضٌ أَوْ لِيَزْرَعْهَا أَخَاهُ أَوْ  لِيَمْنَحْهَا  .  قَالَ  شُعْبَةُ  : وَكَانَ  عَبْدُ الْمَلِكِ  يَجْمَعُ بِقُولِ  طَاوُسٍ  ،  وَعَطَاءٍ  ،  وَمُجَاهِدٍ  .  قَالَ  شُعْبَةُ  : وَكَأَنَّ الَّذِي يُحَدِّثُ عَنْهُ  مُجَاهِدٌ  . قَالَ :  شُعْبَةُ  صَاحِبُ الْحَدِيثِ  .","","Al-Mu'jam al-Kabir 4439","","رافع بن خديج الأنصاري عن مجاهد بن جبر المخزومي عن عبد الملك بن ميسرة الهلالي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عطاء بن أبي رباح عن رافع بن خديج"
"4442","إِيَاسُ بْنُ خَلِيفَةَ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4440  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ ، وَالْحُسَيْنُ بْنُ إِسْحَاقَ         [4/286]      التُّسْتَرِيُّ ، قَالَا :  ثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  إِيَاسِ بْنِ خَلِيفَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ،  أَنَّ  عَلِيًّا  رَضِيَ اللهُ عَنْهُ أَخْبَرَ  عَمَّارًا  أَنْ يَسْأَلَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمَذْيِ فَقَالَ :  يَغْسِلُ مَذَاكِيرَهُ وَيَتَوَضَّأُ  .","","Al-Mu'jam al-Kabir 4440","","رافع بن خديج الأنصاري عن إياس بن خليفة البكري عن عطاء بن أبي رباح عن عبد الله بن أبي نجيح عن روح بن القاسم العنبري عن يزيد بن زريع العيشي عن أمية بن بسطام عن الحسين بن إسحاق التستري عن الطبراني","إياس بن خليفة عن رافع بن خديج"
"4443","4441  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  حَفْصُ بْنُ عَمْرٍو  ، وَالرَّبَالِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ نَافِعٍ الْمَكِّيُّ ،  عَنِ  ابْنِ أَبِي نَجِيحٍ ،  عَنْ  عَطَاءٍ ،  عَنْ  إِيَاسِ بْنِ خَلِيفَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  سُئِلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمَذْيِ ؟ فَقَالَ :  اغْسِلْ ذَكَرَكَ وَتَوَضَّأْ وُضُوءَكَ لِلصَّلَاةِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( حفص بن عمرو الربالي )","","Al-Mu'jam al-Kabir 4441","","رافع بن خديج الأنصاري عن إياس بن خليفة البكري عن عطاء بن أبي رباح عن عبد الله بن أبي نجيح عن إبراهيم بن نافع المخزومي عن الواقدي عن حفص بن عمرو الربالي عن عبد الله بن أحمد الجواليقي عن الطبراني","إياس بن خليفة عن رافع بن خديج"
"4444","عَبْدُ الرَّحْمَنِ بْنُ أَبِي نُعْمٍ  عَنْ  رَافِعٍ  4442  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  الْحَكَمُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي نُعْمٍ ، قَالَ :  سَمِعْتُ  أَبِي  يَذْكُرُ عَنْ  رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ  نَهَى عَنِ الْمُزَارَعَةِ  .","","Al-Mu'jam al-Kabir 4442","","رافع بن خديج الأنصاري عن عبد الرحمن بن أبي نعم البجلي عن الحكم بن عبد الرحمن بن أبي نعم البجلي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الرحمن بن أبي نعم عن رافع"
"4445","4443  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  بُكَيْرُ بْنُ عَامِرٍ الْبَجَلِيُّ ،  ثَنَا  ابْنُ أَبِي نُعْمٍ ،  ثَنَا  رَافِعُ بْنُ خَدِيجٍ ،  أَنَّهُ زَرَعَ أَرْضًا فَمَرَّ بِهِ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَسْقِيهَا فَقَالَ :  لِمَنِ الزَّرْعُ وَلِمَنِ الْأَرْضُ  ؟ فَقَالَ : زَرْعِي بِيَدِي وَعَمَلِي مِنَ  الشَّطْرِ  وَلِبَنِي فُلَانٍ  الشَّطْرُ  فَقَالَ : أَرْبَيْتَ فَرُدَّ الْأَرْضَ إِلَى أَهْلِهَا وَخُذْ نَفَقَتَكَ  .","","Al-Mu'jam al-Kabir 4443","","رافع بن خديج الأنصاري عن عبد الرحمن بن أبي نعم البجلي عن بكير بن عامر البجلي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الرحمن بن أبي نعم عن رافع"
"4446","أَبُو الْبَخْتَرِيِّ الطَّائِيُّ وَاسْمُهُ سَعِيدُ بْنُ فَيْرُوزَ  عَنْ  رَافِعٍ  4444  -  حَدَّثَنَا  عُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي الْبَخْتَرِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : قَالَ النَّبِيُّ         [4/287]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  النَّاسُ حَيِّزٌ وَأَصْحَابِي حَيِّزٌ  . فَقَالَ زَيْدُ بْنُ ثَابِتٍ وَرَافِعُ بْنُ خَدِيجٍ : صَدَقَ وَهُمْ عِنْدَ  مَرْوَانَ بْنِ الْحَكَمِ  .","","Al-Mu'jam al-Kabir 4444","","رافع بن خديج الأنصاري عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن عمرو بن مرزوق الباهلي عن عثمان بن عمر الضبي عن الطبراني","أبو البختري الطائي واسمه سعيد بن فيروز عن رافع"
"4447","أَبُو الْعَالِيَةِ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4445  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الضَّبِّيُّ الْبَصْرِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  يُونُسُ بْنُ مُحَمَّدٍ ،  عَنْ  مُصْعَبِ بْنِ حَيَّانَ ،  عَنْ  أَخِيهِ مُقَاتِلِ بْنِ حَيَّانَ  ، عَنِ  الرَّبِيعِ بْنِ أَنَسٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَقُومُ مِنْ مَجْلِسٍ حَتَّى يَقُولَ :  سُبْحَانَكَ اللَّهُمَّ  وَبِحَمْدِكَ  أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ  ثُمَّ يَقُولُ : إِنَّهَا كَفَّارَةٌ لِمَا يَكُونُ فِي الْمَجْلِسِ  .","","Al-Mu'jam al-Kabir 4445","","رافع بن خديج الأنصاري عن رفيع بن مهران عن الربيع بن أنس البكري عن مقاتل بن حيان عن مصعب بن حيان النبطي عن يونس بن محمد بن مسلم البغدادي عن علي ابن المديني عن عبد الله بن محمد بن العباس الجمرى عن الطبراني","أبو العالية عن رافع بن خديج"
"4448","الْقَاسِمُ بْنُ عَاصِمٍ الشَّيْبَانِيُّ  عَنْ  رَافِعِ بْنِ خَدِيجٍ  4446  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  حُمَيْدٍ الطَّوِيلِ ،  عَنِ  الْقَاسِمِ بْنِ عَاصِمٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَرَّ بِزَرْعٍ فَقَالَ : لِمَنْ هَذَا الزَّرْعُ ؟ قَالُوا :  لِفُلَانٍ  وَالْأَرْضُ  لِفُلَانٍ  فَنَهَى عَنْ ذَلِكَ وَقَالَ :  مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا أَوْ  لِيَمْنَحْهَا  أَخَاهُ  .","","Al-Mu'jam al-Kabir 4446","","رافع بن خديج الأنصاري عن القاسم بن عاصم الكليني عن حميد الطويل عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن عبد الله بن أحمد الجواليقي عن الطبراني","القاسم بن عاصم الشيباني عن رافع بن خديج"
"4449","مُحَمَّدُ بْنُ سِيرِينَ  عَنْ  رَافِعٍ  4447  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ حَمَّادٍ الشُّعَيْثِيُّ ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ : أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ كَرْيِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4447","","رافع بن خديج الأنصاري عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن عبد الرحمن بن حماد الشعيثي عن أبو مسلم الكجي عن الطبراني","محمد بن سيرين عن رافع"
"4450","4448  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  أَبُو هِلَالٍ ، قَالَ :  سَأَلْتُ  مُحَمَّدَ بْنَ سِيرِينَ ، عَنْ كَرْيِ الْأَرْضِ ، فَقَالَ :  قَالَ  رَافِعُ بْنُ خَدِيجٍ :  نَهَانَا نَبِيُّنَا صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَوْ نَهَى نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَنْ كَرْيِ الْأَرْضِ  .","","Al-Mu'jam al-Kabir 4448","","رافع بن خديج الأنصاري عن محمد بن سيرين عن محمد بن سليم الراسبي عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن سيرين عن رافع"
"4451","[4/288]      رَجُلٌ لَمْ يُسَمَّ عَنْ  رَافِعٍ  4449  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنِ  الْوَلِيدِ بْنِ كَثِيرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  عَطَاءٍ ،  عَنْ  رَجُلٍ مِنْ بَنِي حَارِثَةَ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ قَالَ :  خَرَجْنَا مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرٍ ، فَرَأَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى رَوَاحِلِنَا أَكْسِيَةً فِيهَا خُيُوطٌ حُمْرٌ عُرْضٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا أَرَى الْحُمْرَةَ قَدْ غَلَبَتْكُمْ ؟  قَالَ : فَقُمْنَا سِرَاعًا لِقَوْلِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَتَّى نَفَرَ بَعْضُ إِبِلِنَا ، فَأَخَذْنَا الْأَكْسِيَةَ فَنَزَعْنَاهَا مِنْهَا  .","","Al-Mu'jam al-Kabir 4449","","رافع بن خديج الأنصاري عن رجل من بني حارثة عن عطاء بن يسار الهلالي عن محمد بن عمرو بن عطاء العامري عن الوليد بن كثير المخزومي عن حماد بن أسامة القرشي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","رجل لم يسم عن رافع"
"4452","عَمْرَةُ بِنْتُ عَبْدِ الرَّحْمَنِ ،  عَنْ  رَافِعٍ  4450  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ رَدَّادٍ الْعَامِرِيُّ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ الْأَنْصَارِيِّ ،  عَنْ  عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّهُ  كَانَ جَالِسًا عِنْدَ مِنْبَرِ  مَرْوَانَ بْنِ الْحَكَمِ  بِمَكَّةَ  ،  وَمَرْوَانُ  يَخْطُبُ النَّاسَ ، فَذَكَرَ  مَرْوَانُ  مَكَّةَ  وَفَضْلَهَا ، وَلَمْ يَذْكُرِ  الْمَدِينَةَ  ، فَوَجَدَ  رَافِعٌ  فِي نَفْسِهِ مِنْ ذَلِكَ ، وَكَانَ قَدْ أَسَنَّ ، فَقَامَ إِلَيْهِ فَقَالَ : أَيُّهَا ذَا الْمُتَكَلِّمُ أَرَاكَ قَدْ أَطْنَبْتَ فِي  مَكَّةَ  ، وَذَكَرْتَ مِنْهَا فَضْلًا ، وَمَا سَكَتَّ عَنْهُ مِنْ فَضْلِهَا أَكْبَرُ وَلَمْ تَذْكُرِ  الْمَدِينَةَ  وَإِنِّي أَشْهَدُ لَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْمَدِينَةُ  خَيْرٌ مِنْ  مَكَّةَ  .  انْتَهَى الْجُزْءُ الرَّابِعُ  وَيَلِيهِ الْجُزْءُ الْخَامِسُ وَأَوَّلُهُ 422 -  رَافِعُ بْنُ مُكَيْثٍ .","","Al-Mu'jam al-Kabir 4450","","رافع بن خديج الأنصاري عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن محمد بن عبد الرحمن بن الرداد العامري عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","عمرة بنت عبد الرحمن عن رافع"
"4453","[5/17]      422 -  رَافِعُ بْنُ مَكِيثٍ الْجُهَنِيُّ  4451  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  عُثْمَانَ بْنِ زُفَرَ ،  عَنْ  بَعْضِ بَنِي رَافِعِ بْنِ مَكِيثٍ ،  عَنْ  رَافِعِ بْنِ مَكِيثٍ - وَكَانَ مِمَّنْ شَهِدَ  الْحُدَيْبِيَةَ  - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  حُسْنُ  الْمَلَكَةِ  نَمَاءٌ ، وَسُوءُ  الْخُلُقِ  شُؤْمٌ  ، وَالْبِرُّ زِيَادَةٌ فِي الْعُمُرِ ، وَالصَّدَقَةُ تَمْنَعُ مِيتَةَ السُّوءِ  .","","Al-Mu'jam al-Kabir 4451","","رافع بن مكيث الحديبي عن بعض بني رافع بن مكيث عن عثمان بن زفر الجهني عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","رافع بن مكيث الجهني"
"4454","423 -  رَافِعُ بْنُ مَالِكِ بْنِ الْعَجْلَانِ أَبُو رِفَاعَةَ الزُّرَقِيُّ الْأَنْصَارِيُّ ،  عَقَبِيٌّ نَقِيبٌ  4452  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَنْصَارِيُّ الْأَصْفَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  فِي تَسْمِيَةِ مَنْ شَهِدَ الْعَقَبَةَ ،  رَافِعُ بْنُ مَالِكٍ الزُّرَقِيُّ  .","","Al-Mu'jam al-Kabir 4452","","","رافع بن مالك بن العجلان"
"4455","4453  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  أَخْبَرَنِي  مُحَمَّدُ بْنُ إِسْحَاقَ ،  أَخْبَرَنِي  مَعْبَدُ بْنُ كَعْبِ بْنِ مَالِكِ بْنِ الْقَيْنِ أَخُو  بَنِي سَلَمَةَ  ،  عَنْ  أَخِيهِ عُبَيْدِ اللهِ  ،  عَنْ  أَبِيهِ كَعْبِ بْنِ مَالِكٍ قَالَ :  خَرَجْنَا فِي الْحَجَّةِ الَّتِي بَايَعْنَا فِيهَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  بِالْعَقَبَةِ ،  وَكَانَ نَقِيبُ  بَنِي زُرَيْقٍ  رَافِعَ بْنَ مَالِكِ بْنِ الْعَجْلَانِ  "" .","","Al-Mu'jam al-Kabir 4453","","كعب بن مالك الأنصاري عن عبيد الله بن كعب بن مالك الأنصاري عن معبد بن كعب بن مالك الأنصاري عن محمد بن إسحاق عن يونس بن بكير عن محمد بن عبد الله بن نمير عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رافع بن مالك بن العجلان"
"4456","4454  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ  ، ثَنَا  حَمَّادُ بْنُ زَيْدٍ  ، عَنْ  يَحْيَى بْنِ سَعِيدٍ  ، حَدَّثَنِي  مُعَاذُ بْنُ رِفَاعَةَ بْنِ رَافِعٍ  ، ""  وَكَانَ  رِفَاعَةُ  بَدْرِيًّا ، وَكَانَ  رَافِعُ بْنُ مَالِكٍ  مِنْ  أَصْحَابِ الْعَقَبَةِ  وَلَمْ يَشْهَدْ  بَدْرًا  "" .","","Al-Mu'jam al-Kabir 4454","","","رافع بن مالك بن العجلان"
"4457","4455  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ  ، ثَنَا  يَحْيَى بْنُ         [5/18]      بُكَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  رِفَاعَةَ بْنِ رَافِعِ بْنِ مَالِكٍ قَالَ :  سَمِعْتُ  أَبِي  يَقُولُ :  إِنَّ  جِبْرِيلَ  قَالَ لِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : كَيْفَ  أَهْلُ بَدْرٍ  فِيكُمْ ؟ قَالَ : "" هُمْ أَفَاضِلُنَا  ، قَالَ  جِبْرِيلُ  : وَمَنْ شَهِدَ مِنَ الْمَلَائِكَةِ  بَدْرًا  فَهُمْ أَفَاضِلُنَا  .","","Al-Mu'jam al-Kabir 4455","","رافع بن مالك بن العجلان العقبي عن رفاعة بن رافع الزرقي عن يحيى بن سعيد الأنصاري عن عمارة بن غزية عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","رافع بن مالك بن العجلان"
"4458","424 -  رَافِعُ بْنُ عَمْرٍو الْمُزَنِيُّ  4456  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  بَكْرُ بْنُ خَلَفٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ قَالَ :  سَمِعْتُ  الْمُشْمَعِلَّ بْنَ إِيَاسٍ يَقُولُ :  سَمِعْتُ  عَمْرَو بْنَ سُلَيْمٍ الْمُزَنِيَّ يَقُولُ :  سَمِعْتُ  رَافِعَ بْنَ عَمْرٍو الْمُزَنِيَّ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الشَّجَرَةُ  وَالْعَجْوَةُ  مِنَ الْجَنَّةِ  .  قَالَ أَبُو الْقَاسِمِ : ""  هُوَ  الْمُشْمَعِلُّ بْنُ عَمْرِو بْنِ إِيَاسٍ  "" .","","Al-Mu'jam al-Kabir 4456","","رافع بن عمرو المزني عن عمرو بن سليم المزني عن مشمعل بن إياس المزني عن عبد الرحمن بن مهدي عن بكر بن خلف عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رافع بن عمرو المزني"
"4459","4457  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  ثَنَا  الْمُشْمَعِلُّ بْنُ عَمْرٍو ،  وَحَدَّثَنِي  عَمْرُو بْنُ سُلَيْمٍ الْمُزَنِيُّ قَالَ :  سَمِعْتُ  رَافِعَ بْنَ عَمْرٍو الْمُزَنِيَّ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا وَصِيفٌ يَقُولُ :  الشَّجَرَةُ  وَالْعَجْوَةُ  مِنَ الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 4457","","رافع بن عمرو المزني عن عمرو بن سليم المزني عن مشمعل بن إياس المزني عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","رافع بن عمرو المزني"
"4460","4458  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  حَدَّثَنِي  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ (  ح  ) .  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَعْلَى بْنُ عُبَيْدٍ - قَالُوا :  ثَنَا  هِلَالُ بْنُ عَامِرٍ الْمُزَنِيُّ ،  عَنْ  رَافِعِ بْنِ عَمْرٍو الْمُزَنِيِّ قَالَ :  أَقْبَلْتُ مَعَ أَبِي وَأَنَا غُلَامٌ - قَالَ  يَحْيَى بْنُ سَعِيدٍ  فِي حَدِيثِهِ :  وَصِيفٌ أَوْ فَوْقَ ذَلِكَ  . وَقَالَ         [5/19]      يَعْلَى  :  خُمَاسِيٌّ  أَوْ سُدَاسِيٌّ  -  فِي حَجَّةِ الْوَدَاعِ  ،  فَإِذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ النَّاسَ عَلَى بَغْلَةٍ شَهْبَاءَ  وَعَلِيُّ بْنُ أَبِي طَالِبٍ  - رَضِيَ اللهُ عَنْهُ - يُعَبِّرُ عَنْهُ  ، وَالنَّاسُ مِنْ بَيْنِ جَالِسٍ وَقَائِمٍ ، فَجَلَسَ أَبِي ، وَتَخَلَّلْتُ الرِّكَابَ حَتَّى أَتَيْتُ الْبَغْلَةَ فَأَخَذْتُ بِرِكَابِهِ ، وَوَضَعْتُ يَدِي عَلَى رُكْبَتِهِ فَمَسَحْتُ حَتَّى السَّاقِ حَتَّى بَلَغْتُ بِهَا الْقَدَمَ ، ثُمَّ أَدْخَلْتُ كَفِّي بَيْنَ النَّعْلِ وَالْقَدَمِ ، فَيُخَيَّلُ إِلَيَّ السَّاعَةَ أَنِّي أَجِدُ بَرْدَ قَدَمَيْهِ عَلَى كَفِّي  .  وَاللَّفْظُ لِحَدِيثِ  الْأُمَوِيِّ  .","","Al-Mu'jam al-Kabir 4458","","رافع بن عمرو المزني عن هلال بن عامر بن عمرو المزني عن يعلى بن عبيد الطنافسي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","رافع بن عمرو المزني"
"4461","425 -  رَافِعُ بْنُ عَمْرٍو الْغِفَارِيُّ  4459  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ النَّضْرِ الْأَزْدِيُّ وَعُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ قَالَا :  ثَنَا  عَاصِمُ بْنُ عَلِيٍّ - قَالَا :  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  ثَنَا  ابْنُ أَبِي الْحَكَمِ الْغِفَارِيُّ ،  حَدَّثَنِي  جَدِّي ،  عَنْ  عَمِّ أَبِي رَافِعِ بْنِ عَمْرٍو الْغِفَارِيِّ قَالَ :  كُنْتُ أَرْمِي نَخْلًا  لِلْأَنْصَارِ  وَأَنَا غُلَامٌ ، فَأَتَوْا بِي النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا غُلَامُ ، لِمَ تَرْمِي النَّخْلَ ؟ "" قُلْتُ : آكُلُ ! قَالَ : "" فَلَا تَرْمِ النَّخْلَ  ، وَكُلْ مِمَّا يَسْقُطُ فِي أَسَافِلِهَا "" ، ثُمَّ مَسَحَ رَأْسِي وَقَالَ : "" اللَّهُمَّ أَشْبِعْ بَطْنَهُ "" .","","Al-Mu'jam al-Kabir 4459","","رافع بن عمرو بن مجدع الغفاري عن جد ابن أبي الحكم الغفاري عن ابن أبي الحكم الغفاري عن معتمر بن سليمان عن عاصم بن علي الواسطي عن محمد بن أحمد بن النضر النضري عن الطبراني","رافع بن عمرو الغفاري"
"4462","4460  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  مُعَاذُ بْنُ أَسَدٍ ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  ثَنَا  صَالِحُ بْنُ أَبِي جُبَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  رَافِعِ بْنِ عَمْرٍو قَالَ :  كُنْتُ أَرْمِي نَخْلًا  لِلْأَنْصَارِ ،  فَأَخَذُونِي فَذَهَبُوا بِي إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالُوا : هَذَا يَرْمِي نَخْلَنَا ! فَقَالَ : "" يَا  رَافِعُ ،  لِمَ تَرْمِي نَخْلَهُمْ "" ؟ فَقُلْتُ : يَا رَسُولَ اللهِ أَجُوعُ ! قَالَ :  كُلْ مِمَّا وَقَعَ ، أَشْبَعَكَ اللهُ وَأَرْوَاكَ  .","","Al-Mu'jam al-Kabir 4460","","رافع بن عمرو بن مجدع الغفاري عن أبو جبير الغفارى عن صالح بن أبي جبير الغفاري عن الفضل بن موسى السيناني عن معاذ بن أسد الغنوي عن أحمد بن داود بن موسى السدوسي عن الطبراني","رافع بن عمرو الغفاري"
"4463","4461  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ (  ح  ) .  وَحَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سِنَانَ الْعَوْفِيُّ -         [5/20]      قَالَا :  ثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  عَنْ  حُمَيْدِ بْنِ هِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الصَّامِتِ ،  عَنْ  أَبِي ذَرٍّ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  سَيَكُونُ بَعْدِي مِنْ أُمَّتِي قَوْمٌ يَقْرَأُونَ الْقُرْآنَ لَا يُجَاوِزُ حَلَاقِيمَهُمْ ،  يَخْرُجُونَ مِنَ  الدِّينِ  كَمَا يَخْرُجُ السَّهْمُ مِنَ  الرَّمِيَّةِ  ثُمَّ لَا يَعُودُونَ فِيهِ ، شَرُّ  الْخَلْقِ  وَالْخَلِيقَةِ "" ، قَالَ  سُلَيْمَانُ  :  وَأَكْثَرُ ظَنِّي أَنَّهُ قَالَ : ""  سِيمَاهُمُ  التَّحْلِيقِ  "" . قَالَ  ابْنُ الصَّامِتِ  :  فَلَقِيتُ  رَافِعَ بْنَ عَمْرٍو أَخَا  الْحَكَمِ بْنِ عَمْرٍو الْغِفَارِيِّ  فَقُلْتُ لَهُ : مَا حَدِيثٌ سَمِعْتُهُ مِنْ  أَبِي ذَرٍّ  يَقُولُ كَذَا وَكَذَا ، فَذَكَرْتُ لَهُ هَذَا الْحَدِيثَ . قَالَ : "" وَمَا أَعْجَبَكَ مِنْ هَذَا ، وَأَنَا سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 4461","","رافع بن عمرو بن مجدع الغفاري عن عبد الله بن الصامت الغفاري عن حميد بن هلال العدوي عن سليمان بن المغيرة القيسي عن محمد بن سنان الباهلي عن حفص بن عمر سنجة ألف عن الطبراني","رافع بن عمرو الغفاري"
"4464","426 -  رَافِعُ بْنُ الْمُعَلَّى ، أَبُو سَعِيدٍ الْأَنْصَارِيُّ  4462  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  يَقُولُ : ""  أَبُو سَعِيدِ بْنُ الْمُعَلَّى  حَدَّثَنِي  رَجُلٌ مِنْ وَلَدِهِ اسْمُهُ  رَافِعُ بْنُ الْمُعَلَّى الْأَنْصَارِيُّ  مِنْ  بَنِي خُبَيْبِ بْنِ عَبْدِ حَارِثَةَ بْنِ مَالِكٍ  "" .","","Al-Mu'jam al-Kabir 4462","","","رافع بن المعلى الأنصاري"
"4465","4463  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ  ، عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  ""  فِيمَنِ اسْتُشْهِدَ  يَوْمَ بَدْرٍ  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الْمُسْلِمِينَ مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي خُبَيْبِ بْنِ عَبْدِ حَارِثَةَ ،  رَافِعُ بْنُ الْمُعَلَّى  "" .","","Al-Mu'jam al-Kabir 4463","","","رافع بن المعلى الأنصاري"
"4466","4464  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ،  رَافِعُ بْنُ الْمُعَلَّى بْنِ لَوْذَانَ بْنِ حَارِثَةَ بْنِ عَدِيِّ بْنِ زَيْدِ بْنِ ثَعْلَبَةَ بْنِ زَيْدِ بْنِ مَنَاةَ بْنِ خُبَيْبِ بْنِ حَارِثَةَ بْنِ غَضْبِ بْنِ جُشَمِ بْنِ الْخَزْرَجِ  ، اسْتُشْهِدَ  يَوْمَ بَدْرٍ  .","","Al-Mu'jam al-Kabir 4464","","","رافع بن المعلى الأنصاري"
"4467","4465  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي زُرَيْقٍ  رَافِعُ بْنُ الْمُعَلَّى بْنِ لَوْذَانَ ،  اسْتُشْهِدَ  يَوْمَ بَدْرٍ  .","","Al-Mu'jam al-Kabir 4465","","","رافع بن المعلى الأنصاري"
"4468","[5/21]      427 -  رَافِعُ بْنُ أَبِي رَافِعٍ الطَّائِيُّ ، وَاسْمُ أَبِي رَافِعٍ عَمْرٌو  4466  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ الْحَكَمِ بْنِ أَبِي زِيَادٍ الْقَطَوَانِيُّ ،  ثَنَا  عِصَامُ بْنُ عَمْرٍو أَبُو أَحْمَدَ الطَّائِيُّ ،  ثَنَا  عَمْرُو بْنُ حَيَّانَ الطَّائِيُّ  قَالَ  :  كَانَ رَافِعُ بْنُ عَمِيرَةَ السِّنْبِسِيُّ يُغَدِّي أَهْلَ ثَلَاثَةِ مَسَاجِدَ  وَيَسْقِيهِمُ الْقُرْطُمَةَ -  يَعْنِي الْحَيْسَ  - وَمَا لَهُ إِلَّا قَمِيصٌ ، وَهُوَ لِلْبَيْتِ ، وَهُوَ لِلْجُمُعَةِ  "" .","","Al-Mu'jam al-Kabir 4466","","رافع بن عمرو السنبسي عن عمرو بن حيان الطائي عن عصام بن عمرو أبو أحمد الطائي عن عبد الله بن الحكم القطواني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رافع بن أبي رافع الطائي"
"4469","4467  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  إِسْرَائِيلُ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنْ  رَافِعِ بْنِ عَمْرٍو الطَّائِيِّ قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَمْرَو بْنَ الْعَاصِّ  عَلَى جَيْشِ  ذَاتِ السَّلَاسِلِ  ،  وَبَعَثَ مَعَهُ فِي ذَلِكَ الْجَيْشِ  أَبَا بَكْرٍ  وَعُمَرَ  رَضِيَ اللهُ عَنْهُمَا  وَسَرَاةَ  أَصْحَابِهِ ، فَانْطَلَقُوا حَتَّى نَزَلُوا  جَبَلَ طَيٍّ ،  فَقَالَ  عَمْرٌو  : انْظُرُوا إِلَى رَجُلٍ دَلِيلٍ بِالطَّرِيقِ ، فَقَالُوا : مَا نَعْلَمُهُ إِلَّا  رَافِعَ بْنَ عَمْرٍو ،  فَإِنَّهُ كَانَ  رَبِيلًا  فِي الْجَاهِلِيَّةِ -  فَسَأَلْتُ  طَارِقًا  : مَا  الرَّبِيلُ  ؟ قَالَ : اللِّصُّ الَّذِي يَغْزُو  الْقَوْمَ  وَحْدَهُ فَيَسْرِقُ  - قَالَ  رَافِعٌ  : فَلَمَّا قَضَيْنَا غَزَاتَنَا وَانْتَهَيْتُ إِلَى الْمَكَانِ الَّذِي كُنَّا خَرَجْنَا مِنْهُ تَوَسَّمْتُ  أَبَا بَكْرٍ  رَضِيَ اللهُ عَنْهُ فَأَتَيْتُهُ ، فَقُلْتُ : يَا صَاحِبَ الْخِلَالِ إِنِّي تَوَسَّمْتُكَ مِنْ بَيْنِ أَصْحَابِكَ ، فَائْتِنِي بِشَيْءٍ إِذَا حَفِظْتُهُ كُنْتُ مِثْلَكُمُ ! فَقَالَ : "" أَتَحْفَظُ أَصَابِعَكَ الْخَمْسَ ؟ "" قُلْتُ : نَعَمْ . قَالَ : "" تَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ ، وَتُقِيمُ الصَّلَوَاتِ الْخَمْسَ ، وَتُؤْتِي الزَّكَاةَ إِنْ كَانَ لَكَ ، وَتَحُجُّ الْبَيْتَ ، وَتَصُومُ رَمَضَانَ ، حَفِظْتَ ؟ "" قُلْتُ : نَعَمْ . قَالَ : "" وَأُخْرَى ؛ لَا تُؤَمَّرَنَّ عَلَى اثْنَيْنِ "" ، قُلْتُ : هَلْ تَكُونُ الْإِمْرَةُ إِلَّا فِيكُمْ  أَهْلَ بَدْرٍ  ؟ قَالَ : ""  يُوشِكَ  أَنْ تَفْشُوَ حَتَّى تَبْلُغَكَ         [5/22]      وَمَنْ هُوَ دُونَكَ ، إِنَّ اللهَ - عَزَّ وَجَلَّ - لَمَّا بَعَثَ نَبِيَّهُ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ النَّاسُ فِي الْإِسْلَامِ ، فَمِنْهُمْ مَنْ دَخَلَ فَهَدَاهُ اللهُ ، وَمِنْهُمْ مَنْ أَكْرَهَهُ السَّيْفُ ، فَهُوَ عَوَّادُ اللهِ ، وَجِيرَانُ اللهِ فِي خِفَارَةِ اللهِ ، إِنَّ الرَّجُلَ إِذَا كَانَ أَمِيرًا فَتَظَالَمَ النَّاسُ بَيْنَهُمْ فَلَمْ يَأْخُذْ لِبَعْضِهِمْ مِنْ بَعْضٍ انْتَقَمَ اللهُ مِنْهُ ، إِنَّ الرَّجُلَ لَتُؤْخَذُ شَاةُ جَارِهِ فَيَظَلُّ نَاتِئَ  عَضَلَتِهِ  غَضَبًا لِجَارِهِ ، وَاللهُ مِنْ وَرَاءِ جَارِهِ "" . قَالَ  رَافِعٌ  : فَمَكَثْتُ سَنَةً ، ثُمَّ إِنَّ  أَبَا بَكْرٍ  اسْتُخْلِفَ ، فَرَكِبْتُ إِلَيْهِ فَقُلْتُ : أَنَا  رَافِعٌ ،  كُنْتُ لَقِيتُكَ يَوْمَ كَذَا وَكَذَا مَكَانَ كَذَا وَكَذَا ! قَالَ : "" عَرَفْتُ "" ، قُلْتُ : كُنْتَ نَهَيْتَنِي عَنِ الْإِمَارَةِ ، ثُمَّ رَكِبْتَ بِأَعْظَمَ مِنْ ذَلِكَ أُمَّةَ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ! قَالَ : "" نَعَمْ ، فَمَنْ لَمْ يَقُمْ فِيهِمْ بِكِتَابِ اللهِ فَعَلَيْهِ  بَهْلَةُ  اللهِ "" ؛  يَعْنِي لَعْنَةَ اللهِ  .","","Al-Mu'jam al-Kabir 4467","","رافع بن عمرو السنبسي عن طارق بن شهاب الأحمسي عن إبراهيم بن مهاجر بن جابر البجلي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن الحسين بن إسحاق التستري عن الطبراني","رافع بن أبي رافع الطائي"
"4470","4468  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَلِيُّ بْنُ حَكِيمٍ الْأَوْدِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  رَافِعِ بْنِ عَمْرٍو الطَّائِيِّ قَالَ :  مَرُّوا بِي أَصْحَابُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي غَزْوَةٍ أَوْ حَجٍّ ،  فَتَأَمَّلْتُهُمْ  فَلَمْ أَرَ مِنْهُمْ أَحَدًا أَحْسَنَ هَيْأَةً مِنْ أَبِي بَكْرٍ رَضِيَ اللهُ عَنْهُ ، وَقَدْ جَلَّلَ عَلَيْهِ كِسَاءٌ مِنَ الْحَرِّ وَالْبَرْدِ  "" ، وَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 4468","","أبو  بكر الصديق عن رافع بن عمرو السنبسي عن قيس بن أبي حازم عن إبراهيم بن مهاجر بن جابر البجلي عن شريك بن عبد الله النخعي عن علي بن حكيم بن ذبيان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رافع بن أبي رافع الطائي"
"4471","4469  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي مُعَاوِيَةَ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سُلَيْمَانَ بْنِ مَيْسَرَةَ ،  عَنْ  طَارِقِ بْنِ شِهَابٍ ،  عَنْ  رَافِعِ بْنِ أَبِي رَافِعٍ الطَّائِيِّ قَالَ :  لَمَّا كَانَتْ  غَزْوَةُ ذَاتِ السَّلَاسِلِ  اسْتَعْمَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  عَمْرَو بْنَ الْعَاصِّ  عَلَى جَيْشٍ فِيهِمْ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 4469","","رافع بن عمرو السنبسي عن طارق بن شهاب الأحمسي عن سليمان بن ميسرة الأحمسي عن الأعمش عن أبو معاوية الضرير عن إبراهيم بن أبي معاوية عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رافع بن أبي رافع الطائي"
"4472","428 -  رَافِعُ بْنُ يَزِيدَ الْأَنْصَارِيُّ ، بَدْرِيٌّ ، وَيُقَالُ سَهْلٌ ، وَيُقَالُ ابْنُ زَيْدٍ  4470  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ         [5/23]      لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  زَعْوَرِ بْنِ عَبْدِ الْأَشْهَلِ  ،  رَافِعُ بْنُ يَزِيدَ  .","","Al-Mu'jam al-Kabir 4470","","","رافع بن يزيد الأنصاري"
"4473","4471  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ ،  ثُمَّ مِنْ  بَنِي عَبْدِ الْأَشْهَلِ ،  رَافِعُ بْنُ سَهْلٍ ، وَيُقَالُ : رَافِعُ بْنُ زَيْدٍ  .","","Al-Mu'jam al-Kabir 4471","","","رافع بن يزيد الأنصاري"
"4474","429 -  رَافِعٌ ، أَبُو الْبَهِيِّ ، مَوْلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  4472  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ سَعِيدٍ  أَنَّ عَبْدًا كَانَ بَيْنَ  بَنِي سَعِيدٍ  فَأَعْتَقُوهُ إِلَّا وَاحِدًا مِنْهُمْ  ، فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْتَشْفِعُ بِهِ عَلَى  الرَّجُلِ  وَكَلَّمَهُ فِيهِ ، فَوَهَبَ الرَّجُلُ نَصِيبَهُ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" فَأَعْتَقَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" ، وَكَانَ يَقُولُ : أَنَا مَوْلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ اسْمُهُ  رَافِعًا أَبَا الْبَهِيِّ  .","","Al-Mu'jam al-Kabir 4472","","محمد بن عمرو بن سعيد الأموي عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","رافع أبو البهي"
"4475","430 -  رَافِعُ بْنُ جُعْدُبَةَ الْأَنْصَارِيُّ ، بَدْرِيٌّ  4473  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  رَافِعُ بْنُ جُعْدُبَةَ  .","","Al-Mu'jam al-Kabir 4473","","","رافع بن جعدبة الأنصاري"
"4476","431 -  رَافِعُ بْنُ الْحَارِثِ بْنِ سَوَّادِ بْنِ زَيْدِ بْنِ ثَعْلَبَةَ الْأَنْصَارِيُّ ، بَدْرِيُّ  4474  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ،  رَافِعُ         [5/24]      بْنُ الْحَارِثِ بْنِ سَوَّادِ بْنِ زَيْدِ بْنِ ثَعْلَبَةَ  .","","Al-Mu'jam al-Kabir 4474","","","رافع بن الحارث بن سواد"
"4477","4475  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي النَّجَّارِ ،  رَافِعُ بْنُ الْحَارِثِ بْنِ سَوَّادٍ  .","","Al-Mu'jam al-Kabir 4475","","","رافع بن الحارث بن سواد"
"4478","432 -  رَافِعُ بْنُ عُنْجُدَةَ الْأَنْصَارِيُّ ، بَدْرِيٌّ  4476  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي الْأَوْسِ ،  ثُمَّ مِنْ  بَنِي عَمْرِو بْنِ عَوْفٍ ،  ثُمَّ مِنْ  بَنِي أُمَيَّةَ بْنِ زَيْدٍ ،  رَافِعُ بْنُ عُنْجُدَةَ  .","","Al-Mu'jam al-Kabir 4476","","","رافع بن عنجدة الأنصاري"
"4479","433 -  رَافِعُ بْنُ عُمَيْرٍ  4477  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ قُتَيْبَةَ الْعَسْقَلَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَيُّوبَ بْنِ سُوَيْدٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي عَبْلَةَ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  رَافِعِ بْنِ عُمَيْرٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  قَالَ اللهُ - عَزَّ وَجَلَّ -  لِدَاوُدَ  عَلَيْهِ السَّلَامُ : ابْنِ لِي بَيْتًا فِي الْأَرْضِ  ! فَبَنَى  دَاوُدُ  بَيْتًا لِنَفْسِهِ قَبْلَ الْبَيْتِ الَّذِي أُمِرَ بِهِ ، فَأَوْحَى اللهُ - عَزَّ وَجَلَّ - إِلَيْهِ : يَا  دَاوُدُ ،  نَصَبْتَ بَيْتَكَ قَبْلَ بَيْتِي ! قَالَ : يَا رَبِّ ، هَكَذَا قُلْتَ فِيمَا قَضَيْتَ : مَنْ مَلَكَ  اسْتَأْثَرَ  - ثُمَّ أَخَذَ فِي بِنَاءِ الْمَسْجِدِ ، فَلَمَّا تَمَّ السُّورُ سَقَطَ ثُلُثَاهُ ، فَشَكَا ذَلِكَ إِلَى اللهِ - عَزَّ وَجَلَّ - فَأَوْحَى اللهُ - عَزَّ وَجَلَّ - إِلَيْهِ أَنَّهُ لَا يَصْلُحُ أَنْ تَبْنِيَ لِي بَيْتًا ، قَالَ : أَيْ رَبِّ وَلِمَ ؟ قَالَ : لِمَا جَرَتْ عَلَى         [5/25]      يَدَيْكَ مِنَ الدِّمَاءِ ! قَالَ : أَيْ رَبِّ ، أَوَلَمْ يَكُنْ فِي هَوَاكَ وَمَحَبَّتِكَ ؟ قَالَ : بَلَى ، وَلَكِنَّهُمْ عِبَادِي وَأَنَا أَرْحَمُهُمْ ! فَشَقَّ ذَلِكَ عَلَيْهِ ، فَأَوْحَى اللهُ إِلَيْهِ : لَا تَحْزَنْ ، فَإِنِّي سَأَقْضِي بِنَاءَهُ عَلَى يَدَيِ ابْنِكَ  سُلَيْمَانَ .  فَلَمَّا مَاتَ  دَاوُدُ  أَخَذَ  سُلَيْمَانُ  فِي بِنَائِهِ ، فَلَمَّا تَمَّ قَرَّبَ الْقَرَابِينَ وَذَبَحَ الذَّبَائِحَ وَجَمَعَ  بَنِي إِسْرَائِيلَ ،  فَأَوْحَى اللهُ - عَزَّ وَجَلَّ - إِلَيْهِ : قَدْ أَرَى سُرُورًا بِبُنْيَانِ بَيْتِي ، فَسَلْنِي أُعْطِكَ ! قَالَ : أَسْأَلُكَ ثَلَاثَ خِصَالٍ ؛ حُكْمًا يُصَادِفُ حُكْمَكَ ، وَمُلْكًا لَا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِي ، وَمَنْ أَتَى هَذَا الْبَيْتَ لَا يُرِيدُ إِلَّا الصَّلَاةَ فِيهِ خَرَجَ مِنْ ذُنُوبِهِ كَيَوْمِ وَلَدَتْهُ أُمُّهُ "" . قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَمَّا اثْنَتَيْنِ فَقَدْ أُعْطِيَهُمَا ، وَأَنَا أَرْجُو أَنْ يَكُونَ قَدْ أُعْطِيَ الثَّالِثَةَ "" .","","Al-Mu'jam al-Kabir 4477","","رافع بن عمير عن أبو الزاهرية حدير بن كريب عن إبراهيم بن أبي عبلة عن أيوب بن سويد الحميري عن محمد بن أيوب بن سويد الرملي عن محمد بن الحسن بن قتيبة اللخمي عن الطبراني","رافع بن عمير"
"4480","434 -  رُوَيْفِعُ بْنُ ثَابِتٍ الْأَنْصَارِيُّ  4478  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ،  عَنِ  اللَّيْثِ  قَالَ : ""  فِي سَنَةِ سِتٍّ وَأَرْبَعِينَ أُمِّرَ  رُوَيْفِعٌ  عَلَى  أَطْرَابُلْسَ  "" .","","Al-Mu'jam al-Kabir 4478","","","رويفع بن ثابت الأنصاري"
"4481","4479  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  رَافِعُ بْنُ يَزِيدَ ،  حَدَّثَنِي  رَبِيعَةُ بْنُ سُلَيْمٍ مَوْلَى عَبْدِ الرَّحْمَنِ بْنِ حَسَّانَ التُّجِيبِيِّ  أَنَّهُ سَمِعَ  حَنَشًا الصَّنْعَانِيَّ  يُحَدِّثُ عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ فِي غَزْوَةِ أُنَاسٍ قِبَلَ الْمَغْرِبِ يَقُولُ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  فِي  غَزْوَةِ خَيْبَرَ  :  إِنَّهُ بَلَغَنِي أَنَّكُمْ تَتَبَايَعُونَ  الْمِثْقَالَ  بِالنِّصْفِ أَوِ الثُّلُثَيْنِ  ، وَإِنَّهُ لَا يَصْلُحُ إِلَّا  الْمِثْقَالُ  بِالْمِثْقَالِ  وَالْوَزْنُ بِالْوَزْنِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( نافع بن يزيد )","","Al-Mu'jam al-Kabir 4479","","رويفع بن ثابت الأنصاري عن حنش بن عبد الله السبائي عن ربيعة بن سليم التجيبي عن نافع بن يزيد الكلاعي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","رويفع بن ثابت الأنصاري"
"4482","4480  -  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى بْنِ بُكَيْرٍ الْمِصْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ         [5/26]      لَهِيعَةَ ،  عَنْ  بَكْرِ بْنِ سَوَادَةَ ،  عَنْ  زِيَادِ بْنِ نُعَيْمٍ ،  عَنْ  وَفَاءِ بْنِ شُرَيْحٍ الْحَضْرَمِيِّ ،  عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ الْأَنْصَارِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَالَ : اللَّهُمَّ صَلِّ عَلَى  مُحَمَّدٍ  وَأَنْزِلْهُ الْمَقْعَدَ الْمُقَرَّبَ عِنْدَكَ  يَوْمَ الْقِيَامَةِ - وَجَبَتْ لَهُ شَفَاعَتِي "" .","","Al-Mu'jam al-Kabir 4480","","رويفع بن ثابت الأنصاري عن وفاء بن شريح الخولاني عن زياد بن ربيعة الحضرمي عن بكر بن سوادة عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن عبد الملك بن يحيى المخزومي عن الطبراني","رويفع بن ثابت الأنصاري"
"4483","4481  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  ابْنُ هُبَيْرَةَ ،  عَنْ  زِيَادِ بْنِ نُعَيْمٍ ،  عَنْ  وَفَاءِ بْنِ شُرَيْحٍ ،  عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ قَالَ : اللَّهُمَّ صَلِّ عَلَى  مُحَمَّدٍ  وَأَنْزِلْهُ الْمَقْعَدَ الْمُقَرَّبَ عِنْدَكَ  يَوْمَ الْقِيَامَةِ - شَفَعْتُ لَهُ  .","","Al-Mu'jam al-Kabir 4481","","رويفع بن ثابت الأنصاري عن وفاء بن شريح الخولاني عن زياد بن ربيعة الحضرمي عن عبد الله بن هبيرة السبئي عن عبد الله بن لهيعة عن عبد الله بن يزيد القصير عن بشر بن موسى بن صالح الأسدي عن الطبراني","رويفع بن ثابت الأنصاري"
"4484","4482  -  حَدَّثَنَا  مُوسَى بْنُ عِيسَى بْنِ الْمُنْذِرِ الْحِمْصِيُّ  ، ثَنَا  أَحْمَدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي مَرْزُوقٍ مَوْلَى تُجِيبَ ،  حَدَّثَنِي  حَنَشٌ الصَّنْعَانِيُّ قَالَ :  غَزَوْنَا  الْمَغْرِبَ  وَعَلَيْنَا رُوَيْفِعُ بْنُ ثَابِتٍ الْأَنْصَارِيُّ ، فَافْتَتَحْنَا قَرْيَةً يُقَالُ لَهَا  جَرْبَةُ ،  فَقَامَ فِينَا  رُوَيْفِعٌ  خَطِيبًا فَقَالَ : إِنِّي لَا أَقُومُ فِيكُمْ إِلَّا مَا سَمِعْتُ رَسُولَ اللهِ قَامَ فِينَا  يَوْمَ حُنَيْنٍ  حِينَ افْتَتَحْنَاهَا فَقَالَ :  مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يَسْقِ مَاءَهُ زَرْعَ غَيْرِهِ  ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يَأْتِ  ثَيِّبًا  مِنَ السَّبْيِ حَتَّى يَسْتَبْرِئَهَا ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يَبِيعَنَّ مَغْنَمًا حَتَّى يُقْسَمَ ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يَرْكَبَنَّ دَابَّةً مِنْ فَيْءِ الْمُسْلِمِينَ حَتَّى إِذَا  أَعْجَفَهَا  رَدَّهَا فِيهِ ، وَمَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يَلْبَسْ ثَوْبًا مِنْ فَيْءِ الْمُسْلِمِينَ حَتَّى إِذَا أَخْلَقَهُ رَدَّهُ فِيهِ "" .","","Al-Mu'jam al-Kabir 4482","","رويفع بن ثابت الأنصاري عن حنش بن عبد الله السبائي عن أبو مرزوق التجيبي مولى عقبة بن بجرة عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن أحمد بن خالد بن موسى الوهبي عن موسى بن عيسى بن المنذر الحمصي عن الطبراني","رويفع بن ثابت الأنصاري"
"4485","4483  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  نَافِعُ بْنُ يَزِيدَ ،  حَدَّثَنِي  رَبِيعَةُ بْنُ أَبِي سُلَيْمٍ التُّجِيبِيُّ  أَنَّهُ سَمِعَ  حَنَشًا الصَّنْعَانِيَّ  يُحَدِّثُ عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ الْأَنْصَارِيِّ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يَرْكَبْ دَابَّةً  مِنَ         [5/27]      الْمَغَانِمِ حَتَّى إِذَا أَنْقَضَهَا رَدَّهَا فِي الْمَغَانِمِ ، وَلَا ثَوْبًا يَلْبَسُهُ حَتَّى إِذَا خَلَقَ رَدَّهُ فِي الْمَغَانِمِ "" . وَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ فَلَا يَسْقِي مَاءَهُ وَلَدَ غَيْرِهِ "" .","","Al-Mu'jam al-Kabir 4483","","رويفع بن ثابت الأنصاري عن حنش بن عبد الله السبائي عن ربيعة بن سليم التجيبي عن نافع بن يزيد الكلاعي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","رويفع بن ثابت الأنصاري"
"4486","4484  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  أَبِي مَرْزُوقٍ التُّجِيبِيِّ ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ ،  عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 4484","","رويفع بن ثابت الأنصاري عن حنش بن عبد الله السبائي عن أبو مرزوق التجيبي مولى عقبة بن بجرة عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","رويفع بن ثابت الأنصاري"
"4487","4485  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ أَيُّوبَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي مَرْزُوقٍ ،  عَنْ  حَنَشٍ قَالَ :  شَهِدْتُ مَعَ رُوَيْفِعِ بْنِ ثَابِتٍ حِينَ فَتَحَ  جَرْبَةَ ،  فَلَمَّا فَتَحَهَا قَامَ فِينَا خَطِيبًا فَقَالَ : لَا أَقُولُ لَكُمْ إِلَّا مَا قَالَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ حُنَيْنٍ ،  قَالَ :  لَا يَحِلُّ لِامْرِئٍ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ أَنْ يَبِيعَ مَغْنَمًا حَتَّى يُقْسَمَ  ، وَلَا يَحِلُّ لِامْرِئٍ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ أَنْ يَرْكَبَ دَابَّةً مِنْ فَيْءِ الْمُسْلِمِينَ حَتَّى إِذَا  أَعْجَفَهَا  رَدَّهَا ، وَلَا يَلْبَسُ ثَوْبًا حَتَّى إِذَا خَلَقَهُ رَدَّهُ فِيهِ "" .","","Al-Mu'jam al-Kabir 4485","","رويفع بن ثابت الأنصاري عن حنش بن عبد الله السبائي عن أبو مرزوق التجيبي مولى عقبة بن بجرة عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن أحمد بن محمد بن أيوب عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","رويفع بن ثابت الأنصاري"
"4488","4486  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْحَسَنُ بْنُ بِشْرٍ الْكُوفِيُّ ،  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي مَرْزُوقٍ ،  عَنْ  حَنَشٍ ،  عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 4486","","رويفع بن ثابت الأنصاري عن حنش بن عبد الله السبائي عن أبو مرزوق التجيبي مولى عقبة بن بجرة عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن زهير بن معاوية بن حديج عن الحسن بن بشر الكاهلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","رويفع بن ثابت الأنصاري"
"4489","4487  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ وَالْحَضْرَمِيُّ ، قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  زِيَادٍ الْمِنْقَرِيِّ ،  عَنِ  الْحَسَنِ ،  حَدَّثَنِي  ثَابِتُ بْنُ رُوَيْفِعٍ مِنْ  أَهْلِ مِصْرَ  - وَكَانَ يُؤَمَّرُ عَلَى السَّرَايَا - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِيَّايَ وَالْغُلُولَ وَالرَّجُلَ يَنْكِحُ الْمَرْأَةَ قَبْلَ أَنْ يُقْسَمَ الْفَيْءُ ثُمَّ يَرُدُّهَا  إِلَى الْمَغْنَمِ ، وَيَلْبَسُ الثَّوْبَ حَتَّى يَخْلَقَ ثُمَّ يَرُدُّهُ إِلَى الْمَغْنَمِ "" .","","Al-Mu'jam al-Kabir 4487","","ثابت بن رويفع الأنصاري عن الحسن البصري عن زياد بن أبى عثمان المصفر عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رويفع بن ثابت الأنصاري"
"4490","4488  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ         [5/28]      (  ح  ) .  وَحَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ الْفَهْمِيُّ ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  الْحَارِثُ بْنُ يَزِيدَ ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ قَالَ :  فَتَحْنَا حِصْنًا وَمَعَنَا  رُوَيْفِعُ بْنُ ثَابِتٍ  فِي غَزْوَةِ  جَرْبَةَ ،  فَأَتَى عَلَيْنَا رُوَيْفِعُ بْنُ ثَابِتٍ فَقَالَ لَنَا : مَنْ أَصَابَ مِنْكُمْ مِنْ هَذَا السَّبْيِ فَلَا يَطَأْهَا حَتَّى تَحِيضَ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَحِلُّ لِرَجُلٍ أَنْ يَسْقِيَ مَاءَهُ وَلَدَ غَيْرِهِ  .","","Al-Mu'jam al-Kabir 4488","","رويفع بن ثابت الأنصاري عن حنش بن عبد الله السبائي عن الحارث بن سعيد العتقي عن عبد الله بن لهيعة عن البيطارى عبد الله بن محمد بن إسحاق عن روح بن الفرج القطان عن الطبراني","رويفع بن ثابت الأنصاري"
"4491","4489  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  بَكْرُ بْنُ مُضَرَ ،  ثَنَا  جَعْفَرُ بْنُ رَبِيعَةَ ،  عَنْ  أَبِي مَرْزُوقٍ التُّجِيبِيِّ ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ ،  عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ الْأَنْصَارِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَحِلُّ لِأَحَدٍ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ - أَوْ مَنْ كَانَ يُؤْمِنُ بِاللهِ وَالْيَوْمِ الْآخِرِ  فَلَا يَسْقِي مَاءَهُ وَلَدَ غَيْرِهِ  .","","Al-Mu'jam al-Kabir 4489","","رويفع بن ثابت الأنصاري عن حنش بن عبد الله السبائي عن أبو مرزوق التجيبي مولى عقبة بن بجرة عن جعفر بن ربيعة الكندي عن بكر بن مضر المصري عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","رويفع بن ثابت الأنصاري"
"4492","4490  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ زَكَرِيَّا الْإِيَادِيُّ  ، ثَنَا  عَبْدُ الْوَهَّابِ بْنُ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ الْوَلِيدِ الزُّبَيْدِيُّ ،  عَنْ  إِسْحَاقَ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ اللهِ الْعَدَوِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي حُذَيْفَةَ ،  عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ قَالَ :  سَمِعْتُ رَسُولَ اللهِ يَنْهَى أَنْ تُوطَأَ الْحَامِلُ حَتَّى تَضَعَ ، وَقَالَ :  إِنَّ أَحَدَكُمْ يَزِيدُ فِي سَمْعِهِ وَفِي بَصَرِهِ  ، وَأَنْ تُوطَأَ السَّبَايَا حَتَّى يَطْهُرْنَ . ثُمَّ قَالَ : "" إِيَّاكُمْ وَرِبَا الْغُلُولِ "" ، قُلْنَا : وَمَا رِبَا الْغُلُولِ يَا رَسُولَ اللهِ ؟ قَالَ : "" أَنْ يُصِيبَ أَحَدُكُمُ الثَّوْبَ فَيَلْبَسَهُ حَتَّى يَذْهَبَ عَيْنُهُ ثُمَّ يُلْقِيهِ فِي الْمَغْنَمِ ، وَالدَّوَابَّ يَرْكَبُهَا حَتَّى  يَحْسِرَهَا  ثُمَّ يَأْتِي بِهَا إِلَى الْمَغْنَمِ "" .","","Al-Mu'jam al-Kabir 4490","","رويفع بن ثابت الأنصاري عن عبد الله بن أبي حذيفة العدوي عن حميد بن عبد الله المدني عن محمد بن إسحاق عن محمد بن الوليد بن عامر الزبيدي عن بقية بن الوليد عن عبد الوهاب بن نجدة عن أحمد بن زياد الإيادي عن الطبراني","رويفع بن ثابت الأنصاري"
"4493","4491  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  الْمُفَضَّلُ بْنُ فَضَالَةَ ،  حَدَّثَنِي  عَيَّاشُ بْنُ عَبَّاسٍ الْقِتْبَانِيُّ أَنَّ شُيَيْمَ بْنَ بَيْتَانَ  أَخْبَرَهُ  أَنَّهُ سَمِعَ  شَيْبَانَ بْنَ قَيْسٍ الْقِتْبَانِيَّ يَقُولُ :  اسْتَخْلَفَ  مُحَمَّدُ بْنُ مَخْلَدٍ  رُوَيْفِعَ بْنَ ثَابِتٍ  عَلَى أَسْفَلِ الْأَرْضِ ، قَالَ  شَيْبَانُ بْنُ قَيْسٍ  : فَسِرْنَا         [5/29]      مَعَهُ ، قَالَ :  فَأَخْبَرَنِي  رُوَيْفِعُ بْنُ ثَابِتٍ قَالَ : كَانَ أَحَدُنَا فِي زَمَانِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْخُذُ  نِضْوَ  أَخِيهِ عَلَى أَنْ يُعْطِيَهُ النِّصْفَ مِمَّا يَغْنَمُ وَلَهُ النِّصْفُ ، حَتَّى إِنَّ أَحَدَنَا  لَيَطِيرُ  لَهُ النَّصْلُ وَالرِّيشُ وَالْآخَرَ الْقِدْحُ ، ثُمَّ قَالَ لِي  رُوَيْفِعٌ  : قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  رُوَيْفِعُ ،  لَعَلَّ الْحَيَاةَ سَتَطُولُ بِكَ بَعْدِي  ، فَأَخْبِرِ النَّاسَ أَنَّهُ مَنْ  عَقَدَ  لِحْيَتَهُ أَوْ تَقَلَّدَ  وَتَرًا  أَوِ اسْتَنْجَى  بِرَجِيعِ  دَابَّتِهِ أَوْ بِعَظْمٍ فَإِنَّ  مُحَمَّدًا  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَرِيءٌ مِنْهُ "" .","","Al-Mu'jam al-Kabir 4491","","رويفع بن ثابت الأنصاري عن شيبان بن أمية القتباني عن شييم بن بيتان القتباني عن عياش بن عباس القتباني عن المفضل بن فضالة عن سعيد بن الحكم الجمحي عن يحيى بن عثمان بن صالح عن الطبراني","رويفع بن ثابت الأنصاري"
"4494","4492  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ وَحَرْمَلَةُ بْنُ يَحْيَى قَالَا :  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  بَكْرِ بْنِ سَوَادَةَ ،  أَخْبَرَهُ  أَنَّ سُحَيْمًا  حَدَّثَهُ  عَنْ  رُوَيْفِعِ بْنِ ثَابِتٍ قَالَ :  قُرِّبَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَمْرٌ وَرُطَبٌ ، فَأَكَلُوا مِنْهُ حَتَّى لَمْ يُبْقُوا شَيْئًا إِلَّا نَوًى وَمَا لَا خَيْرَ فِيهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" تَدْرُونَ مَا هَذَا ؟ "" قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ ! قَالَ :  تَذْهَبُونَ الْخَيِّرُ فَالْخَيِّرُ ، حَتَّى لَا يَبْقَى مِنْكُمْ إِلَّا مِثْلُ هَذَا  .","","Al-Mu'jam al-Kabir 4492","","رويفع بن ثابت الأنصاري عن سحيم مولى بني زهرة عن بكر بن سوادة عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","رويفع بن ثابت الأنصاري"
"4495","4493  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  أَبِي الْخَيْرِ قَالَ :  سَمِعْتُ  رُوَيْفِعَ بْنَ ثَابِتٍ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  صَاحِبُ  الْمَكْسِ  فِي النَّارِ  ؛  يَعْنِي الْعَاشِرَ  .","","Al-Mu'jam al-Kabir 4493","","رويفع بن ثابت الأنصاري عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","رويفع بن ثابت الأنصاري"
"4496","435 -  رِفَاعَةُ بْنُ عَبْدِ الْمُنْذِرِ ، أَبُو لُبَابَةَ الْأَنْصَارِيُّ ، مِنْ بَنِي عَمْرِو بْنِ عَوْفٍ ثُمَّ مِنْ بَنِي أُمَيَّةَ بْنِ زَيْدٍ ، وَيُقَالُ بِشْرُ بْنُ عَبْدِ الْمُنْذِرِ ، وَيُقَالُ بَشِيرُ بْنُ عَبْدِ الْمُنْذِرِ  4494  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ  أَنَّ  بَشِيرَ بْنَ عَبْدِ الْمُنْذِرِ بْنِ الزِّنْبِرِ  وَالْحَارِثَ         [5/30]      بْنَ حَاطِبٍ  خَرَجَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  بَدْرٍ  فَأَرْجَعَهُمَا ،  وَأَمَّرَ  أَبَا لُبَابَةَ  عَلَى  الْمَدِينَةِ ،  وَضَرَبَ لَهُمَا بِسَهْمَيْنِ مَعَ  أَصْحَابِ بَدْرٍ  "" .","","Al-Mu'jam al-Kabir 4494","","عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4497","4495  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ،  ثُمَّ مِنَ  الْأَوْسِ ،  ثُمَّ مِنْ  بَنِي عَمْرِو بْنِ عَوْفٍ ،  ثُمَّ مِنْ  بَنِي أُمَيَّةَ بْنِ زَيْدٍ  أَبُو لُبَابَةَ بَشِيرُ بْنُ عَبْدِ الْمُنْذِرِ  .","","Al-Mu'jam al-Kabir 4495","","","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4498","4496  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  يَقُولُ :  ""  أَبُو لُبَابَةَ رِفَاعَةُ بْنُ عَبْدِ الْمُنْذِرِ  ""  .","","Al-Mu'jam al-Kabir 4496","","","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4499","4497  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ، ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  أَبُو لُبَابَةَ بْنُ عَبْدِ الْمُنْذِرِ بْنِ زِنْبِرِ بْنِ أُمَيَّةَ بْنِ زَيْدِ بْنِ مَالِكِ بْنِ عَوْفِ بْنِ عَمْرِو بْنِ عَوْفِ بْنِ مَالِكِ بْنِ الْأَوْسِ  ،  كَانَ خَرَجَ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  بَدْرٍ  فَرَدَّهُ  وَأَمَّرَهُ عَلَى  الْمَدِينَةِ ،  وَضَرَبَ لَهُ بِسَهْمِهِ وَأَخْرَجَهُ مَعَ  أَهْلِ بَدْرٍ  .","","Al-Mu'jam al-Kabir 4497","","محمد بن إسحاق عن زياد بن عبد الله البكائي عن عبد الملك بن هشام الذهلي عن عبد الرحيم بن عبد الله البرقي عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4500","4498  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  اقْتُلُوا الْحَيَّاتِ ، اقْتُلُوا ذَا  الطُّفْيَتَيْنِ  وَالْأَبْتَرَ فَإِنَّهُمَا يُسْقِطَانِ الْحَبَلَ وَيَطْمِسَانِ الْبَصَرَ  .  قَالَ  ابْنُ عُمَرَ  : فَرَآنِي  أَبُو لُبَابَةَ أَوْ زَيْدُ بْنُ الْخَطَّابِ  وَأَنَا  أُطَارِدُ  حَيَّةً لِأَقْتُلَهَا فَنَهَانِي ، فَقُلْتُ : "" إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ أَمَرَ بِقَتْلِهِنَّ "" ،  فَقَالَ  :  إِنَّهُ قَدْ نَهَى بَعْدَ ذَلِكَ عَنْ قَتْلِ ذَوَاتِ الْبُيُوتِ  .  قَالَ  الزُّهْرِيُّ  :  وَهُنَّ  الْعَوَامِرُ  .","","Al-Mu'jam al-Kabir 4498","","زيد بن الخطاب أخو عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4501","[5/31]      4499  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُجَمِّعٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اقْتُلُوا الْحَيَّاتِ  . قَالَ  ابْنُ عُمَرَ  : فَرَآنِي أَبُو لُبَابَةَ وَزَيْدُ بْنُ الْخَطَّابِ وَأَنَا أَقْتُلُ حَيَّةً مِنْ ذَوَاتِ الْبُيُوتِ ، وَكُنَّا نَدْعُوهُنَّ  الْجِنَّانَ  ،  فَقَالَا  : يَا  عَبْدَ اللهِ ،  "" إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ تُقْتَلَ ذَوَاتُ الْبُيُوتِ  .","","Al-Mu'jam al-Kabir 4499","","زيد بن الخطاب أخو عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن إسماعيل بن مجمع عن حاتم بن إسماعيل الحارثي عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4502","4500  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  نَافِعٍ ،  عَنْ  أَبِي لُبَابَةَ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ قَتْلِ  الْجِنَّانِ  الَّتِي فِي الْبُيُوتِ ،  إِلَّا أَنْ تَكُونَ ذَا  الطُّفْيَتَيْنِ  وَالْأَبْتَرَ فَإِنَّهُمَا يَخْطِفَانِ الْبَصَرَ وَيَطْرَحَانِ مَا فِي بُطُونِ النِّسَاءِ  .","","Al-Mu'jam al-Kabir 4500","","أبو لبابة بن عبد المنذر الأنصاري عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4503","4501  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  نَافِعٌ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  أَبِي لُبَابَةَ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ قَتْلِ  الْجِنَّانِ  الَّتِي فِي الْبُيُوتِ  .","","Al-Mu'jam al-Kabir 4501","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4504","4502  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  ثَنَا  جُوَيْرِيَةُ بْنُ أَسْمَاءَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ أَبَا لُبَابَةَ  أَخْبَرَهُ  "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ قَتْلِ  الْجِنَّانِ  الَّتِي تَكُونُ فِي الْبُيُوتِ  .","","Al-Mu'jam al-Kabir 4502","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن موسى بن هارون الحمال عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4505","4503  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  أَبِي لُبَابَةَ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ قَتْلِ  الْجِنَّانِ  الَّتِي فِي الْبُيُوتِ  .","","Al-Mu'jam al-Kabir 4503","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4506","4504  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  أَبِي لُبَابَةَ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ قَتْلِ  الْجِنَّانِ  الَّتِي تَكُونُ فِي الْبُيُوتِ  .","","Al-Mu'jam al-Kabir 4504","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن سليمان بن بلال القرشي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4507","4505  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  ثَنَا  عُبَيْدُ اللهِ بْنُ         [5/32]      عُمَرَ ،  حَدَّثَنِي  نَافِعٌ  أَنَّهُ سَمِعَ  أَبَا لُبَابَةَ يُخْبِرُ  ابْنَ عُمَرَ  "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ قَتْلِ  الْجِنَّانِ  .","","Al-Mu'jam al-Kabir 4505","","أبو لبابة بن عبد المنذر الأنصاري عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4508","4506  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  أَبُو مُصْعَبٍ ،  ثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ دِينَارٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ أَنَّ أَبَا لُبَابَةَ  أَخْبَرَهُ  "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ قَتْلِ  الْجِنَّانِ  الَّتِي فِي الْبُيُوتِ "" ، وَقَالَ :  كُلُّكُمْ مَسْؤُولٌ عَنْ رَعِيَّتِهِ  ، أَلَا فَالْأَمِيرُ الَّذِي عَلَى النَّاسِ  رَاعٍ  وَهُوَ مَسْؤُولٌ عَنْ رَعِيَّتِهِ ، وَالرَّجُلُ  رَاعٍ  عَلَى أَهْلِهِ وَهُوَ مَسْؤُولٌ عَنْهُمْ ، وَامْرَأَةُ الرَّجُلِ رَاعِيَةٌ عَلَى بَيْتِ زَوْجِهَا وَهِيَ مَسْؤُولَةٌ عَنْهُ ، وَعَبْدُ الرَّجُلِ عَلَى مَالِ سَيِّدِهِ وَهُوَ مَسْؤُولٌ عَنْهُ  .","","Al-Mu'jam al-Kabir 4506","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن محمد بن إبراهيم صندل عن أحمد بن أبي بكر العوفى عن علي بن سعيد بن بشير عليك عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4509","4507  -  حَدَّثَنَا  مُوسَى بْنُ سَهْلٍ أَبُو عِمْرَانَ الْجَوْنِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ رُمْحٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ أَنَّ بُكَيْرَ بْنَ عَبْدِ اللهِ  أَخْبَرَهُ  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمَا  أَنَّهُ "" كَانَ - بَعْدَمَا أَخْبَرَهُ  أَبُو لُبَابَةَ  عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمَا أَخْبَرَهُ -  إِذَا رَآهُ تَوَعَّدَ وَتَقَدَّمَ إِلَيْهِ ، وَرُبَّمَا أَمَرَنَا مَعًا نَحْمِلُهُ حَتَّى نُلْقِيَهُ  "" .","","Al-Mu'jam al-Kabir 4507","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن بكير بن عبد الله بن الأشج القرشي عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن محمد بن رمح بن المهاجر التجيبي عن موسى بن سهل الجوني عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4510","4508  -  حَدَّثَنَا  عَبَّاسُ بْنُ أَحْمَدَ بْنِ أَبِي عَقِيلٍ الْبَغْدَادِيُّ  ، ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  ثَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ  أَنَّ  ابْنَ عُمَرَ رَضِيَ اللهُ عَنْهُمَا كَانَ يَقْتُلُ  الْجِنَّانَ  كُلَّهَا الَّتِي فِي الْبُيُوتِ  حَتَّى  أَخْبَرَهُ  أَبُو لُبَابَةَ بْنُ عَبْدِ الْمُنْذِرِ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ قَتْلِ  الْجِنَّانِ  الَّتِي فِي الْبُيُوتِ  ، "" فَتَرَكَهَا بَعْدُ ، وَكَانَ يَقْتُلُ مَا سِوَى ذَلِكَ  .","","Al-Mu'jam al-Kabir 4508","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن هشام بن حسان العتكي عن محمد بن بكر بن عثمان البرساني عن محمود بن غيلان المروزي عن العباس بن أحمد بن عقيل البغدادي عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4511","4509  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي حَفْصَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  الْحُسَيْنِ بْنِ السَّائِبِ بْنِ         [5/33]      أَبِي لُبَابَةَ ،  عَنْ  أَبِيهِ  قَالَ  : لَمَّا تَابَ اللهُ عَلَى  أَبِي لُبَابَةَ  قَالَ  أَبُو لُبَابَةَ  :  جِئْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ لَهُ : يَا رَسُولَ اللهِ ، إِنِّي أَهْجُرُ دَارَ قَوْمِي الَّتِي أَصَبْتُ بِهَا الذَّنْبَ ،  وَأَنْخَلِعُ  مِنْ مَالِي صَدَقَةً لِلهِ وَلِرَسُولِهِ ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  أَبَا لُبَابَةَ ،  يُجْزِئُ عَنْكَ الثُّلُثُ  ، قَالَ : فَتَصَدَّقْتُ بِالثُّلُثِ  .","","Al-Mu'jam al-Kabir 4509","","أبو لبابة بن عبد المنذر الأنصاري عن السائب بن أبي لبابة الأنصاري عن الحسين بن السائب الأوسي عن الزهري عن محمد بن أبي حفصة البصري عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن يحيى بن عثمان بن صالح عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4512","4510  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ  ، ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُوسَى التَّمِيمِيُّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنِ  ابْنِ شِهَابٍ ،  حَدَّثَنِي  بَعْضُ ابْنِ السَّائِبِ بْنِ أَبِي لُبَابَةَ ،  عَنْ  أَبِي لُبَابَةَ  أَنَّهُ قَالَ : يَا رَسُولَ اللهِ ، إِنَّ مِنْ تَوْبَتِي أَنْ أَهْجُرَ دَارَ قَوْمِي الَّتِي أَصَبْتُ فِيهَا الذَّنْبَ ،  وَأَنْخَلِعُ  مِنْ مَالِي صَدَقَةً إِلَى اللهِ وَرَسُولِهِ ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُجْزِئُ عَنْكَ الثُّلُثُ مِنْ مَالِكِ  .","","Al-Mu'jam al-Kabir 4510","","أبو لبابة بن عبد المنذر الأنصاري عن الحسين بن السائب الأوسي عن الزهري عن أسامة بن زيد الليثي المدني عن عبد الله بن موسى بن إبراهيم الطلحي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4513","4511  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ  ، ثَنَا  أَبُو حُذَيْفَةَ ،  ثَنَا  زُهَيْرُ بْنُ مُحَمَّدٍ (  ح  ) .  [  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ] (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ بَحْرٍ وَعُثْمَانُ بْنُ أَبِي شَيْبَةَ - قَالُوا :  ثَنَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ،  ثَنَا  زُهَيْرٌ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَارِيَةَ ،  عَنْ  أَبِي لُبَابَةَ بْنِ عَبْدِ الْمُنْذِرِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ يَوْمَ الْجُمُعَةِ سَيِّدُ الْأَيَّامِ وَأَعْظَمُهَا عِنْدَ اللهِ مِنْ يَوْمِ الْأَضْحَى وَيَوْمِ الْفِطْرِ  ، فِيهِ خَمْسُ خِلَالٍ : خَلَقَ اللهُ فِيهِ  آدَمَ  ، وَأَهْبَطَ اللهُ فِيهِ  آدَمَ  إِلَى الْأَرْضِ ، وَفِيهِ تَوَفَّى اللهُ  آدَمَ  ، وَفِيهِ سَاعَةٌ لَا يَسْأَلُ اللهَ الْعَبْدُ فِيهَا شَيْئًا إِلَّا أَعْطَاهُ مَا لَمْ يَسْأَلْ حَرَامًا ، وَفِيهِ تَقُومُ السَّاعَةُ ، مَا مِنْ مَلَكٍ مُقَرَّبٍ وَلَا سَمَاءٍ وَلَا أَرْضٍ وَلَا بَحْرٍ إِلَّا وَهُوَ مُشْفِقٌ مِنْ يَوْمِ الْجُمُعَةِ "" .","","Al-Mu'jam al-Kabir 4511","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الرحمن بن يزيد بن جارية الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن زهير بن محمد التميمي عن يحيى بن أبي بكير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4514","4512  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ ،  ثَنَا  عَمْرُو بْنُ ثَابِتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَارِيَةَ ،  عَنْ  أَبِي لُبَابَةَ بْنِ عَبْدِ الْمُنْذِرِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَوْمُ الْجُمُعَةِ سَيِّدُ الْأَيَّامِ  -  فَذَكَرَ مِثْلَهُ .","","Al-Mu'jam al-Kabir 4512","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الرحمن بن يزيد بن جارية الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن عمرو  بن أبي المقدام عن عبد الله بن محمد بن المغيرة المصري عن المقدام بن داود الرعيني عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4515","[5/34]      4513  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَابِهْرَامَ الْإِيذَجِيُّ  ، ثَنَا  إِسْحَاقُ بْنُ زِيَادٍ الْقَطَّانُ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ ،  ثَنَا  عَاصِمُ بْنُ سُوَيْدٍ ،  ثَنَا  مُحَمَّدُ بْنُ الْحَجَّاجِ بْنِ حُسَيْنِ بْنِ السَّائِبِ بْنِ أَبِي لُبَابَةَ قَالَ :  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ بَدْرٍ  :  كَيْفَ تُقَاتِلُونَ  الْقَوْمَ  إِذَا لَقِيتُمُوهُمْ  ؟ "" فَقَامَ  عَاصِمُ بْنُ ثَابِتٍ  فَقَالَ : يَا رَسُولَ اللهِ ، إِذَا كَانَ  الْقَوْمُ  مِنَّا حَيْثُ يَنَالُهُمُ النَّبْلُ كَانَتِ الْمُرَامَاةُ بِالنَّبْلِ ، فَإِذَا اقْتَرَبُوا حَتَّى يَنَالَنَا وَإِيَّاهُمُ الْحِجَارَةُ كَانَتِ  الْمُرَاضَخَةُ  بِالْحِجَارَةِ ، فَأَخَذَ ثَلَاثَةَ أَحْجَارٍ فِي يَدَهِ وَحَجَرَيْنِ فِي حِزْمَتِهِ ، فَإِذَا اقْتَرَبُوا حَتَّى يَنَالَنَا وَإِيَّاهُمُ الرِّمَاحُ كَانَتِ  الْمُدَاعَسَةُ  بِالرِّمَاحِ ، فَإِذَا انْقَضَتِ الرِّمَاحُ كَانَتِ الْجِلَادُ بِالسُّيُوفِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" بِهَذَا أُنْزِلَتِ الْحَرْبُ ، مَنْ قَاتَلَ فَلْيُقَاتِلْ قِتَالَ  عَاصِمٍ  "" .","","Al-Mu'jam al-Kabir 4513","","أبو لبابة بن عبد المنذر الأنصاري عن حجاج بن السائب بن أبي لبابة الأنصاري عن محمد بن الحجاج بن حسين بن السائب بن أبي لبابة عن عاصم بن سويد بن عامر بن يزيد الأنصاري عن يعقوب بن محمد بن عيسى عن إسحاق بن زياد القطان عن أحمد بن الحسين بن مابهرام الأيذجي عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4516","4514  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ الْوَرْدِ قَالَ :  سَمِعْتُ  ابْنَ أَبِي مُلَيْكَةَ يَقُولُ :  سَمِعْتُ  عُبَيْدَ اللهِ بْنَ أَبِي نَهِيكٍ يَقُولُ :  بَيْنَمَا أَنَا وَاقِفٌ  وَعَبْدُ اللهِ بْنُ السَّائِبِ بْنِ أَبِي السَّائِبِ  إِذْ مَرَّ بِنَا أَبُو لُبَابَةَ ، فَاتَّبَعْنَاهُ حَتَّى دَخَلَ بَيْتَهُ ، فَاسْتَأْذَنَّاهُ فَأَذِنَ لَنَا ، فَإِذَا  رَثُّ  الْمَتَاعِ  رَثُّ  الْحَالِ ، فَقَالَ : مَنْ أَنْتُمْ ؟ فَانْتَسَبْنَا لَهُ ، فَقَالَ : مَرْحَبًا وَأَهْلًا تُجَّارٌ كَسَبَةٌ ،  فَسَمِعْتُهُ  يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَّا مَنْ لَمْ  يَتَغَنَّ  بِالْقُرْآنِ  ، قُلْتُ  لِابْنِ أَبِي مُلَيْكَةَ  :  يَا  أَبَا مُحَمَّدٍ  ، أَرَأَيْتَ إِنْ لَمْ يَكُنْ حَسَنَ الصَّوْتِ ؟ قَالَ : "" يُحَسِّنُهُ مَا اسْتَطَاعَ  .","","Al-Mu'jam al-Kabir 4514","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الله بن أبي نهيك المخزومي عن ابن أبي مليكة عن عبد الجبار بن الورد المخزومي عن عبد الأعلى بن حماد النرسي عن موسى بن هارون الحمال عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4517","4515  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  أَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ قَالَ :  سَمِعْتُ  أَنَسَ بْنَ مَالِكٍ - رَضِيَ اللهُ عَنْهُ - يَقُولُ  :  كَانَ أَبْعَدُ النَّاسِ مَنْزِلًا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجُلَيْنِ مِنَ  الْأَنْصَارِ ،  أَبُو لُبَابَةَ بْنُ عَبْدِ الْمُنْذِرِ  وَمَنْزِلُهُ  بِقُبَاءَ ،  وَأَبُو يَحْيَى  فِي  بَنِي         [5/35]      حَارِثَةَ ،  وَكَانَ يُصَلِّيَانِ مَعَهُ الْعَصْرَ ثُمَّ يَأْتِيَانِ قَوْمَهُمَا وَلَمْ يُصَلُّوا ؛ لِتَبْكِيرِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالْعَصْرِ  .","","Al-Mu'jam al-Kabir 4515","","أنس بن مالك عن عاصم بن عمر الظفري عن محمد بن إسحاق عن يونس بن بكير عن عقبة بن مكرم عن عبد الله بن أحمد الجواليقي عن الطبراني","رفاعة بن عبد المنذر أبو لبابة الأنصاري"
"4518","436 -  رِفَاعَةُ بْنُ رَافِعٍ الزُّرَقِيُّ الْأَنْصَارِيُّ ،  عَقَبِيُّ بَدْرِيٌّ  4516  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  فِي تَسْمِيَةِ  أَصْحَابِ الْعَقَبَةِ  مِنَ  الْأَنْصَارِ ،  ثُمَّ مِنْ  بَنِي زُرَيْقٍ ،  رِفَاعَةُ بْنُ رَافِعِ بْنِ مَالِكِ بْنِ عَجْلَانَ بْنِ عَمْرِو بْنِ زُرَيْقٍ ،  وَهُوَ نَقِيبٌ ، وَقَدْ شَهِدَ  بَدْرًا  .","","Al-Mu'jam al-Kabir 4516","","","رفاعة بن رافع الزرقي"
"4519","4517  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي زُرَيْقٍ ،  رِفَاعَةُ بْنُ رَافِعِ بْنِ مَالِكِ بْنِ عَجْلَانَ  .","","Al-Mu'jam al-Kabir 4517","","","رفاعة بن رافع الزرقي"
"4520","4518  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ الْبَرْقِيُّ  ، ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ  ، ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ،  ثُمَّ مِنَ  الْخَزْرَجِ ،  ثُمَّ مِنْ  بَنِي زُرَيْقٍ ،  رِفَاعَةُ بْنُ رَافِعِ بْنِ مَالِكِ بْنِ الْعَجْلَانِ بْنِ عَمْرِو بْنِ عَاصِمِ بْنِ زُرَيْقِ بْنِ عَبْدِ حَارِثَةَ بْنِ مَالِكِ بْنِ غَضْبِ بْنِ جُشَمِ بْنِ الْخَزْرَجِ  .","","Al-Mu'jam al-Kabir 4518","","","رفاعة بن رافع الزرقي"
"4521","4519  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  ضِرَارُ بْنُ صُرَدٍ  ، ثَنَا  عَلِيُّ بْنُ هَاشِمٍ  ، عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ  ،  عَنْ  أَبِيهِ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ مَعَ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - مِنْ أَصْحَابِ النَّبِي  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رِفَاعَةُ بْنُ رَافِعٍ ،  بَدْرِيٌّ ، مِنْ  بَنِي زُرَيْقٍ  .","","Al-Mu'jam al-Kabir 4519","","","رفاعة بن رافع الزرقي"
"4522","4520  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  دَاوُدُ         [5/36]      بْنُ قَيْسٍ ،  ثَنَا  عَلِيُّ بْنُ يَحْيَى بْنِ خَلَّادِ بْنِ رَافِعِ بْنِ مَالِكٍ الزُّرَقِيُّ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  عَمِّهِ - وَكَانَ بَدْرِيًّا - قَالَ :  بَيْنَا نَحْنُ جُلُوسٌ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْمَسْجِدِ إِذْ دَخَلَ  رَجُلٌ  فَصَلَّى رَكْعَتَيْنِ وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَرْمُقُهُ  ، ثُمَّ جَاءَ فَسَلَّمَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَدَّ عَلَيْهِ ، ثُمَّ قَالَ :  ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ  ، قَالَ : فَرَجَعَ فَصَلَّى ، ثُمَّ جَاءَ فَسَلَّمَ فَرَدَّ عَلَيْهِ السَّلَامَ ، ثُمَّ قَالَ : "" ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ "" ، فَأَعَادَ عَلَيْهِ الثَّالِثَةَ أَوِ الرَّابِعَةَ ، وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ قَوْلَهُ الْأَوَّلَ ، قَالَ : أَيْ رَسُولَ اللهِ ، بِأَبِي أَنْتَ وَأُمِّي ، وَالَّذِي أَنْزَلَ عَلَيْكَ الْكِتَابَ لَقَدِ اجْتَهَدْتُ وَحَرَصْتُ ، فَأَرِنِي وَعَلِّمْنِي ! قَالَ : "" إِذَا أَرَدْتَ أَنْ تُصَلِّيَ فَتَوَضَّأْ فَأَحْسِنْ وُضُوءَكَ ، ثُمَّ اسْتَقْبِلِ الْقِبْلَةَ فَكَبِّرْ وَاقْرَأْ ، ثُمَّ ارْكَعْ حَتَّى تَطْمَئِنَّ رَاكِعًا ، ثُمَّ ارْفَعْ حَتَّى تَعْتَدِلَ رَافِعًا ، ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا ، ثُمَّ ارْفَعْ حَتَّى تَطْمَئِنَّ قَاعِدًا ، ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا ، ثُمَّ ارْفَعْ ، فَإِذَا أَتْمَمْتَ عَلَى هَذَا صَلَاتَكَ فَقَدْ أَتْمَمْتَ ، وَمَا نَقَصْتَ مِنْ هَذَا فَإِنَّمَا تَنْقُصُهُ مِنْ نَفْسِكَ "" .","","Al-Mu'jam al-Kabir 4520","","رفاعة بن رافع الزرقي عن يحيى بن خلاد بن رافع الزرقي عن علي بن يحيى بن خلاد عن داود بن قيس الدباغ عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","رفاعة بن رافع الزرقي"
"4523","4521  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  عَلِيِّ بْنِ يَحْيَى بْنِ خَلَّادٍ الزُّرَقِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمِّهِ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْمَسْجِدِ فَإِذَا  رَجُلٌ  يُصَلِّي فِي نَاحِيَةِ الْمَسْجِدِ ، قَالَ : وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَرْمُقُهُ  وَلَا يَفْطِنُ لَهُ ، فَلَمَّا صَلَّى أَقْبَلَ حَتَّى وَقَفَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَلَّمَ عَلَيْهِ ، فَرَدَّ عَلَيْهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ :  ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ  ، فَرَجَعَ فَصَلَّى ثُمَّ أَقْبَلَ فَسَلَّمَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَدَّ عَلَيْهِ ، ثُمَّ قَالَ : "" ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ "" ، فَصَنَعَ ذَلِكَ  مَرَّتَيْنِ أَوْ ثَلَاثًا  ، قَالَ الرَّجُلُ : وَالَّذِي أَنْزَلَ عَلَيْكَ الْكِتَابَ بِالْحَقِّ لَقَدْ جَهَدْتُ وَحَرَصْتُ ، فَأَرِنِي يَا رَسُولَ اللهِ وَعَلِّمْنِي ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِذَا أَرَدْتَ أَنْ تُصَلِّيَ فَتَوَضَّأْ وَأَحْسِنْ وُضُوءَكَ كَمَا أَمَرَ اللهُ ، ثُمَّ اقْرَأْ ، ثُمَّ ارْكَعْ حَتَّى تَطْمَئِنَّ رَاكِعًا ، ثُمَّ ارْفَعْ حَتَّى تَعْتَدِلَ قَائِمًا ، ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا ، ثُمَّ ارْفَعْ حَتَّى تَسْتَوِيَ قَاعِدًا ، ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ         [5/37]      سَاجِدًا ، ثُمَّ قُمْ ، فَإِنْ أَتْمَمْتَ صَلَاتَكَ عَلَى هَذَا فَقَدْ تَمَّتْ ، وَإِنِ انْتَقَصْتَ مِنْ ذَلِكَ فَإِنَّمَا تَنْقُصُهُ مِنْ صَلَاتِكَ  .","","Al-Mu'jam al-Kabir 4521","","رفاعة بن رافع الزرقي عن يحيى بن خلاد بن رافع الزرقي عن علي بن يحيى بن خلاد عن محمد بن عجلان عن سليمان بن بلال القرشي عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","رفاعة بن رافع الزرقي"
"4524","4522  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَجْلَانَ ،  عَنْ  عَلِيِّ بْنِ يَحْيَى مِنْ  آلِ رِفَاعَةَ بْنِ رَافِعٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمٍّ لَهُ بَدْرِيٍّ حَدَّثَهُ  أَنَّ  رَجُلًا  دَخَلَ الْمَسْجِدَ فَصَلَّى وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَرْمُقُهُ  وَهُوَ لَا يَشْعُرُ ، فَلَمَّا فَرَغَ أَقْبَلَ فَسَلَّمَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ لَهُ :  ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ  ، فَرَجَعَ فَصَلَّى ثُمَّ أَقْبَلَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُ : "" ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ "" ، فَرَجَعَ فَصَلَّى -  مَرَّتَيْنِ أَوْ ثَلَاثًا  ، قَالَ الرَّجُلُ : وَالَّذِي أَكْرَمَكَ يَا رَسُولَ اللهِ لَقَدْ جَهَدْتُ فَعَلِّمْنِي ! قَالَ لَهُ : "" إِذَا قُمْتَ تُرِيدُ الصَّلَاةَ فَتَوَضَّأْ فَأَحْسِنْ وُضُوءَكَ ، ثُمَّ اسْتَقْبِلِ الْقِبْلَةَ ، ثُمَّ اقْرَأْ ، ثُمَّ ارْكَعْ فَاطْمَئِنَّ ، ثُمَّ اسْجُدْ فَاطْمَئِنَّ سَاجِدًا ، ثُمَّ ارْفَعْ حَتَّى تَطْمَئِنَّ قَاعِدًا ، ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا ، ثُمَّ ارْفَعْ ، ثُمَّ افْعَلْ ذَلِكَ حَتَّى تَفْرُغَ مِنْ صَلَاتِكَ "" .","","Al-Mu'jam al-Kabir 4522","","رفاعة بن رافع الزرقي عن يحيى بن خلاد بن رافع الزرقي عن علي بن يحيى بن خلاد عن محمد بن عجلان عن الليث بن سعد عن عبد الله بن صالح المصري عن يحيى بن عثمان بن صالح عن الطبراني","رفاعة بن رافع الزرقي"
"4525","4523  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنِ  ابْنِ عَجْلَانَ ،  حَدَّثَنِي  عَلِيُّ بْنُ يَحْيَى بْنِ خَلَّادٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمِّهِ - وَكَانَ بَدْرِيًّا - قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْمَسْجِدِ فَدَخَلَ  رَجُلٌ  فَصَلَّى  - ثُمَّ ذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4523","","رفاعة بن رافع الزرقي عن يحيى بن خلاد بن رافع الزرقي عن علي بن يحيى بن خلاد عن محمد بن عجلان عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","رفاعة بن رافع الزرقي"
"4526","4524  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنِ  ابْنِ عَجْلَانَ ،  عَنْ  عَلِيِّ بْنِ يَحْيَى بْنِ خَلَّادٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمِّهِ - وَكَانَ بَدْرِيًّا - قَالَ :  كُنَّا جُلُوسًا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَ  رَجُلٌ  يُصَلِّي  ، فَصَلَّى صَلَاةً خَفِيفَةً لَا يُتِمُّ رُكُوعَهَا وَلَا سُجُودَهَا ، وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَرْمُقُهُ  . فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4524","","رفاعة بن رافع الزرقي عن يحيى بن خلاد بن رافع الزرقي عن علي بن يحيى بن خلاد عن محمد بن عجلان عن سليمان بن حيان الأحمر عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","رفاعة بن رافع الزرقي"
"4527","4525  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ حَيَّانَ الْمَازِنِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ - قَالَا :  ثَنَا  هَمَّامٌ ،  أَنَا  إِسْحَاقُ بْنُ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  حَدَّثَنِي  عَلِيُّ بْنُ يَحْيَى بْنِ خَلَّادٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمِّهِ رِفَاعَةَ بْنِ رَافِعٍ - زَادَ  أَبُو الْوَلِيدِ  فِي حَدِيثِهِ : وَكَانَ  رِفَاعَةُ  وَمَالِكٌ  أَخَوَيْنِ مِنْ  أَهْلِ بَدْرٍ  - قَالَ :  بَيْنَمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَالِسٌ نَظَرَ حَوْلَهُ ، فَإِذَا  رَجُلٌ         [5/38]      فَاسْتَقْبَلَ الْقِبْلَةَ فَصَلَّى رَكْعَتَيْنِ - وَقَالَ  حَجَّاجٌ  فِي حَدِيثِهِ : كُنْتُ جَالِسًا عِنْدَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذْ جَاءَ رَجُلٌ فَدَخَلَ الْمَسْجِدَ - فَلَمَّا قَضَى صَلَاتَهُ جَاءَ فَسَلَّمَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَى  الْقَوْمِ  ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  وَعَلَيْكَ ، ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ  ، قَالَ : فَرَجَعَ فَصَلَّى ، فَجَعَلَ  يَرْمُقُ  صَلَاتَهُ لَا يَدْرِي مَا يَعِيبُ مِنْهَا ، فَلَمَّا قَضَى صَلَاتَهُ جَاءَ فَسَلَّمَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَسَلَّمَ عَلَى  الْقَوْمِ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ "" ، قَالَ :  وَذَكَرَ إِمَّا مَرَّتَيْنِ وَإِمَّا ثَلَاثًا  ، فَقَالَ الرَّجُلُ : مَا أَدْرِي مَا عِبْتَ عَلَيَّ ! قَالَ : فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا تَتِمُّ صَلَاةُ أَحَدِكُمْ حَتَّى يُسْبِغَ الْوُضُوءَ كَمَا أَمَرَهُ اللهُ ، يَغْسِلُ وَجْهَهُ وَيَدَيْهِ إِلَى الْمِرْفَقَيْنِ ، وَيَمْسَحُ رَأْسَهُ وَرِجْلَيْهِ إِلَى  الْكَعْبَيْنِ  ، ثُمَّ يُكَبِّرُ اللهَ وَيَحْمَدُهُ وَيَقْرَأُ مِنَ الْقُرْآنِ مَا أَذِنَ اللهُ لَهُ فِيهِ وَيَسَّرَ ، ثُمَّ يُكَبِّرُ فَيَرْكَعُ فَيَضَعُ كَفَّيْهِ عَلَى رُكْبَتَيْهِ حَتَّى تَطْمَئِنَّ مَفَاصِلُهُ وَتَسْتَرْخِيَ ، ثُمَّ يَقُولُ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، فَيَسْتَوِي قَائِمًا حَتَّى يَأْخُذَ كُلُّ عَظْمٍ مَأْخَذَهُ وَيُقِيمَ صُلْبَهُ ، ثُمَّ يُكَبِّرُ فَيَسْجُدُ  فَيُمَكِّنُ جَبْهَتَهُ - قَالَ  هَمَّامٌ  : وَرُبَّمَا قَالَ فَيُمَكِّنُ وَجْهَهُ - مِنَ الْأَرْضِ  حَتَّى تَطْمَئِنَّ مَفَاصِلُهُ وَتَسْتَرْخِيَ ، ثُمَّ يُكَبِّرُ فَيَرْفَعُ رَأْسَهُ فَيَسْتَوِي قَاعِدًا عَلَى مَقْعَدَتِهِ وَيُقِيمُ صُلْبَهُ "" فَوَصَفَ الصَّلَاةَ هَكَذَا حَتَّى فَرَغَ ، ثُمَّ قَالَ : "" لَا تَتِمُّ صَلَاةُ أَحَدِكُمْ حَتَّى يَفْعَلَ ذَلِكَ "" ،  وَاللَّفْظُ لِحَدِيثِ  حَجَّاجٍ  .","","Al-Mu'jam al-Kabir 4525","","رفاعة بن رافع الزرقي عن يحيى بن خلاد بن رافع الزرقي عن علي بن يحيى بن خلاد عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن همام بن يحيى بن دينار عن أبو الوليد الطيالسي عن محمد بن حيان المازني عن الطبراني","رفاعة بن رافع الزرقي"
"4528","4526  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجٌ ،  ثَنَا  حَمَّادٌ ،  ثَنَا  إِسْحَاقُ بْنُ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  عَلِيِّ بْنِ يَحْيَى بْنِ خَلَّادٍ ،  عَنْ  عَمِّهِ  أَنَّ  رَجُلًا  دَخَلَ الْمَسْجِدَ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَالِسٌ ، فَصَلَّى ، فَأَمَرَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَأَعَادَ مَرَّتَيْنِ أَوْ ثَلَاثًا  ، فَقَالَ : يَا رَسُولَ اللهِ ، مَا أَلَوْتُ بَعْدَ  مَرَّتَيْنِ أَوْ ثَلَاثٍ  أَنْ أُتِمَّ صَلَاتِي ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّهُ لَا تَتِمُّ صَلَاةٌ لِأَحَدٍ مِنَ النَّاسِ حَتَّى يَتَوَضَّأَ فَيَضَعَ الْوُضُوءَ مَوَاضِعَهُ  ، ثُمَّ يَقُولُ : اللهُ أَكْبَرُ ، ثُمَّ يَحْمَدُ اللهَ تَعَالَى وَيُثْنِي عَلَيْهِ وَيَقْرَأُ مَا تَيَسَّرَ مِنَ الْقُرْآنِ ، ثُمَّ يُكَبِّرُ حَتَّى تَطْمَئِنَّ مَفَاصِلُهُ ، ثُمَّ يَقُولُ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ حَتَّى يَسْتَوِيَ قَائِمًا ، ثُمَّ يُكَبِّرُ وَيَسْجُدُ حَتَّى تَطْمَئِنَّ مَفَاصِلُهُ ، ثُمَّ يَرْفَعُ         [5/39]      رَأْسَهُ حَتَّى يَسْتَوِيَ قَاعِدًا ، ثُمَّ يَسْجُدُ حَتَّى تَطْمَئِنَّ مَفَاصِلُهُ ، فَإِذَا لَمْ يَفْعَلْ ذَلِكَ لَمْ تَتِمَّ صَلَاتُهُ "" .","","Al-Mu'jam al-Kabir 4526","","رفاعة بن رافع الزرقي عن علي بن يحيى بن خلاد عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","رفاعة بن رافع الزرقي"
"4529","4527  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ رِشْدِينَ الْمِصْرِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِلَالٍ ،  عَنْ  يَحْيَى بْنِ عَلِيِّ بْنِ يَحْيَى ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  رِفَاعَةَ بْنِ رَافِعٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأَى  رَجُلًا  يُصَلِّي فِي الْمَسْجِدِ فَقَالَ :  ارْجِعْ فَصَلِّ  ، قَالَهَا  مَرَّتَيْنِ أَوْ ثَلَاثًا  ، ثُمَّ قَالَ : يَا رَسُولَ اللهِ عَلِّمْنِي ! فَقَالَ : "" إِذَا قُمْتَ إِلَى الصَّلَاةِ فَتَوَضَّأْ كَمَا أَمَرَكَ اللهُ ، ثُمَّ قُمْ فَاسْتَقْبِلِ الْقِبْلَةَ فَكَبِّرْ ، فَإِنْ كَانَ مَعَكَ قُرْآنٌ فَاقْرَأْ ، وَإِلَّا فَسَبِّحِ اللهَ وَكَبِّرْهُ ، ثُمَّ ارْكَعْ فَأَمْكِنْ كَفَّيْكَ مِنْ رُكْبَتَيْكَ ، ثُمَّ ارْفَعْ حَتَّى يَعْتَدِلَ صُلْبُكَ ، ثُمَّ اسْجُدْ فَأَمْكِنْ جَبْهَتَكَ مِنَ الْأَرْضِ ، ثُمَّ اصْنَعْ ذَلِكَ ، فَإِذَا صَنَعْتَ ذَلِكَ فَقَدْ تَمَّتْ صَلَاتُكَ ، وَمَا نَقَصْتَ مِنْ ذَلِكَ فَقَدْ نَقَصْتَ مِنْ صَلَاتِكَ  .","","Al-Mu'jam al-Kabir 4527","","رفاعة بن رافع الزرقي عن يحيى بن خلاد بن رافع الزرقي عن علي بن يحيى بن خلاد عن يحيى بن علي بن يحيى بن خلاد الزرقي عن سعيد بن أبي هلال الليثي عن عمرو بن الحارث بن يعقوب عن رشدين بن سعد المهري عن حجاج بن رشدين المصري عن محمد بن الحجاج بن رشدين المهري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","رفاعة بن رافع الزرقي"
"4530","4528  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  عَلِيُّ بْنُ يَحْيَى بْنِ خَلَّادِ بْنِ رَافِعٍ الْأَنْصَارِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَمِّهِ رِفَاعَةَ بْنِ رَافِعٍ قَالَ :  بَيْنَمَا نَحْنُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ أَقْبَلَ  رَجُلٌ مِنَ الْأَنْصَارِ  بَعْدَ أَنْ فَرَغَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الصَّلَاةِ فَصَلَّى ، ثُمَّ أَقْبَلَ فَسَلَّمَ عَلَيْهِ فَقَالَ :  وَعَلَيْكَ السَّلَامُ ، ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ  ، قَالَ : يَا رَسُولَ اللهِ ، قَدْ جَهَدْتُ فَبَيِّنْ لِي ! قَالَ : "" إِذَا أَنْتَ قُمْتَ فِي صَلَاتِكَ فَكَبِّرِ اللهَ ، ثُمَّ اقْرَأْ مَا تَيَسَّرَ عَلَيْكَ مِنَ الْقُرْآنِ ، ثُمَّ إِذَا أَنْتَ رَكَعْتَ فَأَثْبِتْ يَدَيْكَ عَلَى رُكْبَتَيْكَ حَتَّى يَطْمَئِنَّ كُلُّ عَظْمٍ مِنْكَ ، ثُمَّ إِذَا رَفَعْتَ رَأْسَكَ فَاعْتَدِلْ حَتَّى يَرْجِعَ كُلُّ عَظْمٍ مِنْكَ ، ثُمَّ إِذَا سَجَدْتَ فَاطْمَئِنَّ حَتَّى يَعْتَدِلَ كُلُّ عَظْمٍ مِنْكَ ، ثُمَّ إِذَا رَفَعْتَ رَأْسَكَ فَاثْبُتْ حَتَّى يَرْجِعَ كُلُّ عَظْمٍ إِلَى مَوْضِعِهِ ، ثُمَّ مِثْلَ ذَلِكَ ، فَإِذَا جَلَسْتَ فِي وَسَطِ صَلَاتِكَ فَاطْمَئِنَّ وَافْتَرِشْ فَخِذَكَ الْيُسْرَى ثُمَّ تَشَهَّدْ ، ثُمَّ إِذَا قُمْتَ فَمِثْلَ ذَلِكَ حَتَّى تَفْرُغَ         [5/40]      مِنْ صَلَاتِكَ "" .","","Al-Mu'jam al-Kabir 4528","","رفاعة بن رافع الزرقي عن يحيى بن خلاد بن رافع الزرقي عن علي بن يحيى بن خلاد عن محمد بن إسحاق عن إسماعيل ابن علية عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","رفاعة بن رافع الزرقي"
"4531","4529  -  حَدَّثَنَا  بَكْرُ بْنُ مُحَمَّدٍ الْقَزَّازُ الْبَصْرِيُّ ،  ثَنَا  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ،  ثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  عَلِيِّ بْنِ يَحْيَى ،  عَنْ  رِفَاعَةَ بْنِ رَافِعٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 4529","","رفاعة بن رافع الزرقي عن علي بن يحيى بن خلاد عن محمد بن عمرو بن علقمة بن وقاص الليثي عن عبد الوهاب بن عبد المجيد الثقفي عن يحيى بن حبيب الحارثي عن بكر بن محمد بن عبد الوهاب القزاز عن الطبراني","رفاعة بن رافع الزرقي"
"4532","4530  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ (  ح  ) .  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدٍ ،  ثَنَا  عَمِّي ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  شَرِيكٌ ،  عَنْ  عَبْدِ اللهِ بْنِ عَوْنٍ ،  عَنْ  عَلِيِّ بْنِ يَحْيَى بْنِ خَلَّادٍ ،  عَنْ  رِفَاعَةَ بْنِ رَافِعٍ - وَكَانَ بَدْرِيًّا - قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ جَالِسٌ فِي الْمَسْجِدِ فَصَلَّى قَرِيبًا مِنْهُ ، ثُمَّ انْصَرَفَ فَوَقَفَ فَسَلَّمَ عَلَيْهِ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَعِدْ صَلَاتَكَ ، فَإِنَّكَ لَمْ تُصَلِّ  ، فَصَلَّى نَحْوًا مِمَّا صَلَّى ، ثُمَّ انْصَرَفَ فَوَقَفَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَعِدْ صَلَاتَكَ فَإِنَّكَ لَمْ تُصَلِّ "" ، قَالَ : يَا نَبِيَّ اللهِ عَلِّمْنِي ! قَالَ : "" إِذَا تَوَجَّهْتَ إِلَى الْقِبْلَةِ فَكَبِّرْ ، ثُمَّ اقْرَأْ بِمَا شَاءَ اللهُ أَنْ تَقْرَأَ ، فَإِذَا رَكَعْتَ فَاجْعَلْ رَاحَتَيْكَ عَلَى رُكْبَتَيْكَ وَامْدُدْ ظَهْرَكَ وَمَكِّنْ لِرُكُوعِكَ ، فَإِذَا رَفَعْتَ فَأَقِمْ صُلْبَكَ حَتَّى تَرْجِعَ الْعِظَامُ إِلَى مَفَاصِلِهَا ، فَإِذَا سَجَدْتَ فَمَكِّنْ سُجُودَكَ ، فَإِذَا رَفَعْتَ فَاجْلِسْ عَلَى فَخِذِكَ الْيُسْرَى ، وَافْعَلْ مِثْلَ ذَلِكَ فِي كُلِّ رَكْعَةٍ وَسَجْدَةٍ "" .","","Al-Mu'jam al-Kabir 4530","","رفاعة بن رافع الزرقي عن علي بن يحيى بن خلاد عن عبد الله بن عون بن أرطبان عن شريك بن عبد الله النخعي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","رفاعة بن رافع الزرقي"
"4533","4531  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ - كُلُّهُمْ  عَنْ  مَالِكٍ ،  عَنْ  نُعَيْمٍ الْمُجْمِرِ ،  عَنْ  عَلِيِّ بْنِ يَحْيَى الزُّرَقِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  رِفَاعَةَ بْنِ رَافِعٍ قَالَ :  كُنَّا يَوْمًا نُصَلِّي وَرَاءَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَإِذَا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ وَقَالَ ""  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ "" قَالَ  رَجُلٌ  مِنْ وَرَائِهِ : رَبَّنَا وَلَكَ الْحَمْدُ حَمْدًا         [5/41]      كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ . فَلَمَّا انْصَرَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" مَنِ الْمُتَكَلِّمُ آنِفًا ؟ "" فَقَالَ الرَّجُلُ : أَنَا يَا رَسُولَ اللهِ ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَقَدْ رَأَيْتُ بِضْعَةً وَثَلَاثِينَ مَلَكًا يَبْتَدِرُونَهَا أَيُّهُمْ يَكْتُبُهَا أَوَّلًا  .","","Al-Mu'jam al-Kabir 4531","","رفاعة بن رافع الزرقي عن يحيى بن خلاد بن رافع الزرقي عن علي بن يحيى بن خلاد عن نعيم بن عبد الله المجمر عن مالك بن أنس عن إسماعيل بن أبي أويس عن علي بن محمد بن عبد الله الصنعاني عن الطبراني","رفاعة بن رافع الزرقي"
"4534","4532  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ الْكَرَابِيسِيُّ - قَالَا :  ثَنَا  رِفَاعَةُ بْنُ يَحْيَى إِمَامُ مَسْجِدِ بَنِي زُرَيْقٍ بِالْمَدِينَةِ قَالَ :  سَمِعْتُ  مُعَاذَ بْنَ رِفَاعَةَ بْنِ رَافِعٍ ،  عَنْ  أَبِيهِ رِفَاعَةَ  أَنَّهُ صَلَّى مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمَغْرِبَ ، فَعَطَسَ  رِفَاعَةُ  فَقَالَ : الْحَمْدُ لِلهِ حَمْدًا كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ مُبَارَكًا عَلَيْهِ كَمَا يُحِبُّ رَبُّنَا وَيَرْضَى ! فَلَمَّا صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَيْنَ الْمُتَكَلِّمُ فِي الصَّلَاةِ ؟  قَالَ  رِفَاعَةُ  : وَدِدْتُ أَنِّي غَرِمْتُ غُرَّةً مِنْ مَالٍ وَإِنِّي لَمْ أَشْهَدْ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تِلْكَ الصَّلَاةَ حِينَ قَالَ : "" أَيْنَ الْمُتَكَلِّمُ ؟ "" ، فَقُلْتُ : أَنَا يَا رَسُولَ اللهِ ! قَالَ : "" كَيْفَ قُلْتَ ؟ "" قَالَ : قُلْتُ : الْحَمْدُ لِلهِ حَمْدًا كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ مُبَارَكًا عَلَيْهِ كَمَا يُحِبُّ رَبُّنَا وَيَرْضَى ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" وَالَّذِي نَفْسِي بِيَدِهِ لَقَدِ ابْتَدَرَهَا بِضْعَةٌ وَثَلَاثُونَ مَلَكًا أَيُّهُمْ يَصْعَدُ بِهَا "" .","","Al-Mu'jam al-Kabir 4532","","رفاعة بن رافع الزرقي عن معاذ بن رفاعة بن رافع الزرقي عن رفاعة بن يحيى الزرقي عن سعيد بن عبد الجبار الكرابيسي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رفاعة بن رافع الزرقي"
"4535","4533  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ يَحْيَى الشَّجَرِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  عُبَيْدِ بْنِ يَحْيَى ،  عَنْ  مُعَاذِ بْنِ رِفَاعَةَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّهُمَّ اغْفِرْ  لِلْأَنْصَارِ  وَلِأَبْنَاءِ  الْأَنْصَارِ  وَلِأَبْنَاءِ أَبْنَاءِ  الْأَنْصَارِ  وَلِذَرَارِيِّهِمْ وَلِجِيرَانِهِمْ "" .","","Al-Mu'jam al-Kabir 4533","","رفاعة بن رافع الزرقي عن معاذ بن رفاعة بن رافع الزرقي عن عبيد بن يحيي عن يحيى بن محمد بن عباد الشجري عن إبراهيم بن يحيى الشجري عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","رفاعة بن رافع الزرقي"
"4536","4534  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ أَبِي عَرْعَرَةَ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ - قَالَا :  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا         [5/42]      هِشَامُ بْنُ هَارُونَ الْمَدَنِيُّ الْأَنْصَارِيُّ ،  حَدَّثَنِي  مُعَاذُ بْنُ رِفَاعَةَ بْنِ رَافِعٍ الْأَنْصَارِيُّ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللَّهُمَّ اغْفِرْ  لِلْأَنْصَارِ  وَلِأَبْنَاءِ  الْأَنْصَارِ  وَلِذَرَارِيِّهِمْ وَلِجِيرَانِهِمْ  .","","Al-Mu'jam al-Kabir 4534","","رفاعة بن رافع الزرقي عن معاذ بن رفاعة بن رافع الزرقي عن هشام بن هارون الأنصاري عن زيد بن الحباب العكلي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","رفاعة بن رافع الزرقي"
"4537","4535  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  ثَنَا  رِفَاعَةُ بْنُ يَحْيَى ،  عَنْ  مُعَاذِ بْنِ رِفَاعَةَ ،  عَنْ  رَافِعٍ قَالَ :  لَمَّا كَانَ  يَوْمُ بَدْرٍ  تَجَمَّعَ النَّاسُ عَلَى  أُمَيَّةَ بْنِ خَلَفٍ  ، أَقْبَلْتُ فَنَظَرْتُ إِلَى قِطْعَةٍ مِنْ دِرْعِهِ قَدِ انْقَطَعَتْ مِنْ تَحْتِ إِبْطِهِ ، قَالَ : فَأَطْعَنُهُ بِالسَّيْفِ طَعْنَةً فَقَتَلْتُهُ ، وَرُمِيتُ بِسَهْمٍ  يَوْمَ بَدْرٍ  فَفُقِئَتْ  عَيْنِي ، فَبَسَقَ فِيهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَدَعَا لِي فَمَا آذَانِي مِنْهَا شَيْءٌ  .","","Al-Mu'jam al-Kabir 4535","","رافع بن مالك بن العجلان العقبي عن معاذ بن رفاعة بن رافع الزرقي عن رفاعة بن يحيى الزرقي عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","رفاعة بن رافع الزرقي"
"4538","4536  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  مَعْمَرِ بْنِ أَبِي حَبِيبَةَ ،  عَنْ  عُبَيْدِ بْنِ رِفَاعَةَ  أَنَّ  زَيْدَ بْنَ ثَابِتٍ  كَانَ يَقُصُّ ، فَقَالَ فِي قَصَصِهِ : إِذَا خَالَطَ الرَّجُلُ الْمَرْأَةَ فَلَمْ يُمْنِ فَلَيْسَ عَلَيْهِ غُسْلٌ ،  فَلْيَغْسِلْ فَرْجَهُ وَلْيَتَوَضَّأْ . فَقَامَ  رَجُلٌ  مِنَ الْمَجْلِسِ فَذَكَرَ ذَلِكَ  لِعُمَرَ بْنِ الْخَطَّابِ ،  فَقَالَ  عُمَرُ  رَضِيَ اللهُ عَنْهُ : ائْتِنِي بِهِ لِأَكُونَ عَلَيْهِ شَهِيدًا ! فَلَمَّا جَاءَهُ قَالَ لَهُ : يَا عَدُوَّ نَفْسِهِ ! أَنْتَ تُضِلُّ النَّاسَ بِغَيْرِ عِلْمٍ . قَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ ، أَمَا وَاللهِ مَا ابْتَدَعْتُهُ ، وَلَكِنِّي  سَمِعْتُ  ذَلِكَ مِنْ أَعْمَامِي ! قَالَ : أَيُّ أَعْمَامِكَ ؟ قَالَ :  أُبَيُّ بْنُ كَعْبٍ  ،  وَرِفَاعَةُ بْنُ رَافِعٍ  ،  وَأَبُو أَيُّوبَ  . فَقَالَ رِفَاعَةُ وَكَانَ حَاضِرًا : لَا تَنْهَرْهُ يَا أَمِيرَ الْمُؤْمِنِينَ ، فَقَدْ كُنَّا وَاللهِ نَصْنَعُ هَذَا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَقَالَ : هَلْ عَلِمْتُمْ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اطَّلَعَ عَلَى شَيْءٍ مِنْ ذَلِكَ ؟ فَقَالَ : لَا .  فَقَالَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  : يَا أَمِيرَ الْمُؤْمِنِينَ ، إِنَّ هَذَا الْأَمْرَ لَا يَصْلُحُ .  فَقَالَ : مَنْ أَسْأَلُ بَعْدَكُمْ يَا  أَهْلَ بَدْرٍ         [5/43]      الْأَخْيَارَ ؟ فَقَالَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ : أَرْسِلْ إِلَى أُمَّهَاتِ الْمُؤْمِنِينَ ! فَأَرْسَلَ إِلَى  حَفْصَةَ  رَضِيَ اللهُ عَنْهَا ، فَقَالَتْ : لَا عِلْمَ لِي . فَأَرْسَلَ إِلَى عَائِشَةَ رَضِيَ اللهُ عَنْهَا فَقَالَتْ :  إِذَا جَاوَزَ الْخِتَانُ الْخِتَانَ فَقَدْ وَجَبَ الْغُسْلُ  ثُمَّ  أَفَاضُوا  فِي ذِكْرِ  الْعَزْلِ  فَقَالُوا : لَا بَأْسَ ، فَسَارَّ  رَجُلٌ  صَاحِبَهُ فَقَالَ : مَا هَذِهِ الْمُنَاجَاةُ ؟ أَحَدُهُمَا يَزْعُمُ أَنَّهَا الْمَوْؤُودَةُ الصُّغْرَى ! فَقَالَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ :  إِنَّهَا لَا تَكُونُ  مَوْءُودَةً  حَتَّى تَمُرَّ بِسَبْعِ تَارَاتٍ  ، قَالَ اللهُ عَزَّ وَجَلَّ :         {      وَلَقَدْ خَلَقْنَا الإِنْسَانَ مِنْ سُلالَةٍ مِنْ طِينٍ             *          ثُمَّ جَعَلْنَاهُ نُطْفَةً فِي قَرَارٍ مَكِينٍ             *          ثُمَّ خَلَقْنَا النُّطْفَةَ عَلَقَةً فَخَلَقْنَا الْعَلَقَةَ مُضْغَةً فَخَلَقْنَا الْمُضْغَةَ عِظَامًا فَكَسَوْنَا الْعِظَامَ لَحْمًا ثُمَّ أَنْشَأْنَاهُ خَلْقًا آخَرَ فَتَبَارَكَ اللهُ أَحْسَنُ الْخَالِقِينَ         }      ، فَتَفَرَّقُوا عَلَى قَوْلِ  عَلِيِّ بْنِ أَبِي طَالِبٍ  أَنَّهُ لَا بَأْسَ بِهِ  .","","Al-Mu'jam al-Kabir 4536","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن معمر بن أبي حبيبة العدوي عن يزيد بن أبي حبيب الأزدي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","رفاعة بن رافع الزرقي"
"4539","4537  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ وَعَبْدُ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَعْمَرِ بْنِ أَبِي حَبِيبَةَ ،  عَنْ  عُبَيْدِ بْنِ رِفَاعَةَ ،  عَنْ  أَبِيهِ قَالَ :  كُنَّا نَفْعَلُهُ عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَإِذَا لَمْ نُنْزِلْ لَمْ نَغْتَسِلْ "" .","","Al-Mu'jam al-Kabir 4537","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن معمر بن أبي حبيبة العدوي عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رفاعة بن رافع الزرقي"
"4540","4538  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  عَنْ  خَلَّادِ بْنِ السَّائِبِ ،  عَنْ  رِفَاعَةَ الْأَنْصَارِيِّ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يُقْرَأُ فِي الصُّبْحِ بِدُونِ عِشْرِينَ آيَةً ، وَلَا يُقْرَأُ فِي الْعِشَاءِ بِدُونِ عَشْرِ آيَاتٍ  .","","Al-Mu'jam al-Kabir 4538","","رفاعة بن رافع الزرقي عن خلاد بن السائب الخزرجي عن بكير بن عبد الله بن الأشج القرشي عن عبيد الله بن أبي جعفر الكناني عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","رفاعة بن رافع الزرقي"
"4541","4539  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ         [5/44]      مَعْمَرٍ ،  عَنْ  أَبِي خُثَيْمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عُبَيْدِ بْنِ رِفَاعَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  خَرَجْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى السُّوقِ فَقَالَ : "" يَا مَعْشَرَ التُّجَّارِ ! "" فَرَفَعَ إِلَيْهِ التُّجَّارُ أَبْصَارَهُمْ وَاسْتَجَابُوا لَهُ ، فَقَالَ :  إِنَّ  التُّجَّارَ  يُبْعَثُونَ يَوْمَ الْقِيَامَةِ  فُجَّارًا  إِلَّا مَنِ اتَّقَى وَبَرَّ وَصَدَقَ  .","","Al-Mu'jam al-Kabir 4539","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن إسماعيل بن عبيد العجلاني عن عبد الله بن عثمان بن خثيم عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","رفاعة بن رافع الزرقي"
"4542","4540  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَبْدِ اللهِ بْنِ عُثْمَانَ بْنِ خُثَيْمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عُبَيْدِ بْنِ رِفَاعَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  الْبَقِيعِ  فَقَالَ : "" يَا مَعْشَرَ التُّجَّارِ ! "" ، حَتَّى اشْرَأَبُّوا ، قَالَ :  إِنَّ  التُّجَّارَ  يُحْشَرُونَ يَوْمَ الْقِيَامَةِ  فُجَّارًا  إِلَّا مَنِ اتَّقَى وَبَرَّ وَصَدَقَ  .","","Al-Mu'jam al-Kabir 4540","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن إسماعيل بن عبيد العجلاني عن عبد الله بن عثمان بن خثيم عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","رفاعة بن رافع الزرقي"
"4543","4541  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ وَإِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ عُبَيْدِ بْنِ رِفَاعَةَ بْنِ رَافِعٍ الزُّرَقِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْمَدِينَةِ  فَوَجَدَ النَّاسَ يَتَبَايَعُونَ ، فَنَادَى : "" يَا مَعْشَرَ التُّجَّارِ ! "" ، فَاسْتَجَابُوا لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَرَفَعُوا أَبْصَارَهُمْ إِلَيْهِ ، فَقَالَ :  إِنَّ  التُّجَّارَ  يُبْعَثُونَ  فُجَّارًا  إِلَّا مَنِ اتَّقَى وَبَرَّ وَصَدَقَ  .","","Al-Mu'jam al-Kabir 4541","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن إسماعيل بن عبيد العجلاني عن عبد الله بن عثمان بن خثيم عن إسماعيل ابن علية عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","رفاعة بن رافع الزرقي"
"4544","4542  -  حَدَّثَنَا  خَلَفُ بْنُ عَمْرٍو الْعُكْبَرِيُّ  ، ثَنَا  الْحَسَنُ بْنُ الرَّبِيعِ الْكُوفِيُّ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو حَبِيبٍ يَحْيَى بْنُ نَافِعٍ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ - قَالُوا :  ثَنَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ،  عَنْ  عَبْدِ اللهِ بْنِ عُثْمَانَ بْنِ خُثَيْمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عُبَيْدِ بْنِ رِفَاعَةَ الْأَنْصَارِيِّ ثُمَّ الزُّرَقِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّهُ خَرَجَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى الْمُصَلَّى  بِالْمَدِينَةِ  فَوَجَدَ النَّاسَ يَتَبَايَعُونَ ، فَقَالَ : "" يَا مَعْشَرَ التُّجَّارِ ! "" ، فَاسْتَجَابُوا وَرَفَعُوا إِلَيْهِ أَعْنَاقَهُمْ وَأَبْصَارَهُمْ ، فَقَالَ :  إِنَّ  التُّجَّارَ  يُبْعَثُونَ يَوْمَ الْقِيَامَةِ  فُجَّارًا  إِلَّا مَنِ اتَّقَى وَصَدَقَ وَبَرَّ  .","","Al-Mu'jam al-Kabir 4542","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن إسماعيل بن عبيد العجلاني عن عبد الله بن عثمان بن خثيم عن داود ابن النصراني عن سعيد بن الحكم الجمحي عن يحيى بن نافع بن خالد المصري عن الطبراني","رفاعة بن رافع الزرقي"
"4545","4543  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا         [5/45]      بِشْرُ بْنُ الْمُفَضَّلِ ،  ثَنَا  ابْنُ خُثَيْمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عُبَيْدِ بْنِ رِفَاعَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ ،  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 4543","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن إسماعيل بن عبيد العجلاني عن عبد الله بن عثمان بن خثيم عن بشر بن المفضل عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","رفاعة بن رافع الزرقي"
"4546","4544  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  ثَنَا  عَبْدُ اللهِ بْنُ خُثَيْمٍ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ عُبَيْدِ بْنِ رِفَاعَةَ بْنِ رَافِعٍ ،  عَنْ  أَبِيهِ عُبَيْدٍ ،  عَنْ  رِفَاعَةَ بْنِ رَافِعٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِعُمَرَ بْنِ الْخَطَّابِ  رَضِيَ اللهُ عَنْهُ : "" اجْمَعْ لِي قَوْمَكَ يَا  عُمَرُ  "" ، فَجَمَعَهُمْ ، فَلَمَّا أَنْ حَضَرُوا بَابَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَيْهِ  عُمَرُ  فَقَالَ : قَدْ جَمَعْتُ لَكَ قَوْمِي ! فَسَمِعَ ذَلِكَ  الْأَنْصَارُ ،  فَقَالَ : قَدْ نَزَلَ فِي  قُرَيْشٍ  الْوَحْيُ ، فَجَاءَ الْمُسْتَمِعُ وَالنَّاظِرُ مَا يَقُولُ لَهُمْ ؟ فَخَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَامَ بَيْنَ أَظْهُرِهِمْ ، فَقَالَ : "" هَلْ فِيكُمْ مِنْ غَيْرِكُمْ ؟ "" قَالُوا : نَعَمْ ، فِينَا حَلِيفُنَا وَابْنُ أُخْتِنَا وَمَوْلَانَا . فَقَالَ رَسُولُ اللهِ :  حَلِيفُنَا مِنَّا ، وَابْنُ أُخْتِنَا مِنَّا ، وَمَوْلَانَا مِنَّا ، أَنْتُمْ تَسْمَعُونَ ، إِنَّ أَوْلِيَائِي يَوْمَ الْقِيَامَةِ الْمُتَّقُونَ  ، فَإِنْ كُنْتُمْ أُولَئِكَ فَذَاكَ ، وَإِلَّا فَانْظُرُوا ، لَا يَأْتِ النَّاسُ بِالْأَعْمَالِ يَوْمَ الْقِيَامَةِ وَتَأْتُونَ بِالْأَثْقَالِ فَيُعْرَضُ عَنْكُمْ "" ، ثُمَّ نَادَى فَقَالَ : "" أَيُّهَا النَّاسُ ، إِنَّ  قُرَيْشًا  أَهْلُ أَمَانَةٍ ، مَنْ بَغَاهُمُ  الْغَوَائِرَ أَوِ الْعَوَاثِرَ - قَالَ  زُهَيْرٌ  : وَأَظُنُّهَا الْعَوَاثِرَ  - كَبَّهُ اللهُ  لِمَنْخِرِهِ  "" ، قَالَ ذَلِكَ ثَلَاثَ مَرَّاتٍ  .","","Al-Mu'jam al-Kabir 4544","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن إسماعيل بن عبيد العجلاني عن عبد الله بن عثمان بن خثيم عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","رفاعة بن رافع الزرقي"
"4547","4545  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ عُبَيْدِ بْنِ رِفَاعَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِعُمَرَ  رَضِيَ اللهُ عَنْهُ : "" اجْمَعْ قَوْمَكَ "" ، فَجَمَعَهُمْ عِنْدَ بَيْتِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ دَخَلَ عَلَيْهِ ، فَقَالَ : يَا رَسُولَ اللهِ ، أُدْخِلُهُمْ عَلَيْكَ أَوْ تَخْرُجُ إِلَيْهِمْ ؟ فَقَالَ : "" لَا ، بَلْ أَخْرُجُ إِلَيْهِمْ "" ، فَأَتَاهُمْ فَقَامَ عَلَيْهِمْ فَقَالَ : "" هَلْ فِيكُمْ غَيْرُكُمْ ؟ "" فَقَالُوا : نَعَمْ ؛ فِينَا حُلَفَاؤُنَا ، وَفِينَا أَبْنَاءُ إِخْوَتِنَا ، وَفِينَا مَوَالِينَا . فَقَالَ :  حَلِيفُنَا مِنَّا ، وَابْنُ أَخِينَا مِنَّا "" . قَالَ : "" أَنْتُمْ تَسْمَعُونَ ، إِنَّ أَوْلِيَائِي مِنْكُمُ الْمُتَّقُونَ  ، فَإِنْ كُنْتُمْ أُولَئِكَ فَذَلِكَ ، وَإِلَّا فَانْظُرُوا ، لَا يَأْتِ         [5/46]      النَّاسُ بِالْأَعْمَالِ يَوْمَ الْقِيَامَةِ وَتَأْتُونَ بِأَثْقَالٍ فَأُعْرِضُ عَنْكُمْ "" ، ثُمَّ رَفَعَ يَدَيْهِ وَهُوَ قَائِمٌ وَهُمْ قُعُودٌ فَقَالَ : "" يَا أَيُّهَا النَّاسُ ، إِنَّ  قُرَيْشًا  أَهْلُ أَمَانَةٍ ، وَمَنْ بَغَاهُمُ الْعَوَاثِرَ أَكَبَّهُ اللهُ  لِمَنْخِرِهِ  "" ، قَالَهَا ثَلَاثًا  .","","Al-Mu'jam al-Kabir 4545","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن إسماعيل بن عبيد العجلاني عن عبد الله بن عثمان بن خثيم عن بشر بن المفضل عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","رفاعة بن رافع الزرقي"
"4548","4546  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ عُبَيْدِ بْنِ رِفَاعَةَ بْنِ رَافِعٍ الزُّرَقِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِعُمَرَ  : اجْمَعْ قَوْمَكَ  - ثُمَّ ذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4546","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن إسماعيل بن عبيد العجلاني عن عبد الله بن عثمان بن خثيم عن إسماعيل ابن علية عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","رفاعة بن رافع الزرقي"
"4549","4547  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُثْمَانَ بْنِ خُثَيْمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عُبَيْدِ بْنِ رِفَاعَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِعُمَرَ  : "" اجْمَعْ لِي قَوْمَكَ "" ، فَجَمَعَهُمْ فَكَانُوا بِالْبَابِ ، فَقَالَ : "" هَلْ فِيكُمْ أَحَدٌ مِنْ غَيْرِكُمْ ؟ "" قَالُوا : لَا ، ابْنُ أُخْتِنَا وَمَوْلَانَا . فَقَالَ : "" ابْنُ أُخْتِكُمْ وَمَوْلَاكُمْ مِنْكُمْ "" . فَقَالَ :  إِنَّ أَوْلِيَائِي مِنْكُمُ الْمُتَّقُونَ  ، إِيَّاكُمْ أَنْ يَأْتُونِي النَّاسُ بِالْأَعْمَالِ وَتَجِيئُونِي بِالْأَثْقَالِ تَحْمِلُونَهَا عَلَى ظُهُورِكُمْ "" ، ثُمَّ قَالَ : "" إِنَّ  قُرَيْشًا  أَهْلُ صَبْرٍ وَأَمَانَةٍ ، فَمَنْ بَغَى لَهُمُ الْعَوَاثِرَ أَكَبَّهُ اللهُ لِوَجْهِهِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 4547","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن إسماعيل بن عبيد العجلاني عن عبد الله بن عثمان بن خثيم عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","رفاعة بن رافع الزرقي"
"4550","4548  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ أَبُو مَعْشَرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ عُبَيْدِ بْنِ رِفَاعَةَ بْنِ رَافِعِ بْنِ مَالِكِ بْنِ عَجْلَانَ الْأَنْصَارِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  أَقْبَلْنَا  يَوْمَ بَدْرٍ  ، فَفَقَدْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَنَادَتِ الرِّفَاقُ بَعْضُهَا بَعْضًا : أَفِيكُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَوَقَفُوا حَتَّى جَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَعَهُ  عَلِيُّ بْنُ أَبِي طَالِبٍ  رَضِيَ اللهُ عَنْهُ ، فَقَالُوا : يَا رَسُولَ اللهِ فَقَدْنَاكَ ! فَقَالَ :  إِنَّ  أَبَا حَسَنٍ  وَجَدَ  مَغَصًا  فِي بَطْنِهِ فَتَخَلَّفْتُ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 4548","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن إبراهيم بن عبيد بن رفاعة الزرقي عن عاصم بن علي أبو معشر عن عمر بن حفص السدوسي عن الطبراني","رفاعة بن رافع الزرقي"
"4551","[5/47]      4549  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  دَاوُدُ بْنُ عُمَرَ الضَّبِّيُّ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ - قَالُوا :  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ أَيْمَنَ ،  عَنْ  عُبَيْدِ بْنِ رِفَاعَةَ الزُّرَقِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  لَمَّا كَانَ  يَوْمُ أُحُدٍ  وَانْكَفَأَ الْمُشْرِكُونَ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْتَوُوا حَتَّى أُثْنِيَ عَلَى رَبِّي  ، قَالَ : فَصَارُوا خَلْفَهُ صُفُوفًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اللَّهُمَّ لَكَ الْحَمْدُ كُلُّهُ ، لَا قَابِضَ لِمَا بَسَطْتَ ، وَلَا بَاسِطَ لِمَا قَبَضْتَ ، وَلَا هَادِيَ لِمَا أَضْلَلْتَ ، وَلَا مُضِلَّ لِمَنْ هَدَيْتَ ، وَلَا مُقَرِّبَ لِمَا بَاعَدْتَ ، وَلَا مُبَاعِدَ لِمَا قَرَّبْتَ ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ ، وَلَا مَانِعَ لِمَا أَعْطَيْتَ ، اللَّهُمَّ ابْسُطْ عَلَيْنَا مِنْ بَرَكَاتِكَ وَرَحْمَتِكَ وَفَضْلِكَ وَرِزْقِكَ ، اللَّهُمَّ إِنِّي أَسْأَلُكَ النَّعِيمَ الْمُقِيمَ يَوْمَ الْعَيْلَةِ وَالْأَمْنَ يَوْمَ الْخَوْفِ ، اللَّهُمَّ عَائِذٌ بِكَ مِنْ شَرِّ مَا أَعْطَيْتَنَا وَشَرِّ مَا مَنَعْتَ مِنَّا ، اللَّهُمَّ تَوَفَّنَا مُسْلِمِينَ وَأَلْحِقْنَا بِالصَّالِحِينَ غَيْرَ خَزَايَا وَلَا مَفْتُونِينَ ، اللَّهُمَّ قَاتِلِ الْكَفَرَةَ الَّذِينَ  يَصُدُّونَ  عَنْ سَبِيلِكَ وَيُكَذِّبُونَ رُسُلَكَ ، اللَّهُمَّ قَاتِلِ الْكَفَرَةَ الَّذِينَ أُوتُوا الْكِتَابَ إِلَهَ الْحَقِّ "" .","","Al-Mu'jam al-Kabir 4549","","رفاعة بن رافع الزرقي عن عبيد بن رفاعة بن رافع الزرقي عن عبد الواحد بن أيمن المخزومي عن مروان بن معاوية الفزاري عن داود بن عمرو المسيبي عن عبد الله بن أحمد بن حنبل عن الطبراني","رفاعة بن رافع الزرقي"
"4552","4550  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ مُنْذِرٍ الْحِزَامِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ قَالَ :  حَدَّثَنِي  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  عَبْدِ رَبِّهِ بْنِ سَعِيدِ بْنِ قَيْسٍ الْأَنْصَارِيِّ  ، عَنْ  رِفَاعَةَ بْنِ رَافِعٍ قَالَ :  لَمَّا رَأَى إِبْلِيسُ مَا تَفْعَلُ الْمَلَائِكَةُ بِالْمُشْرِكِينَ  يَوْمَ بَدْرٍ  أَشْفَقَ أَنْ يَخْلُصَ الْقَتْلُ إِلَيْهِ  ، فَتَشَبَّثَ بِهِ  الْحَارِثُ بْنُ هِشَامٍ  وَهُوَ يَظُنُّ أَنَّهُ  سُرَاقَةُ بْنُ مَالِكٍ ،  فَوَكَزَ  فِي صَدْرِ  الْحَارِثِ  فَأَلْقَاهُ ثُمَّ خَرَجَ هَارِبًا حَتَّى أَلْقَى نَفْسَهُ فِي الْبَحْرِ وَرَفَعَ يَدَيْهِ ، فَقَالَ : إِنِّي         [5/48]      أَسْأَلُكَ نَظْرَتَكَ إِيَّايَ ! وَخَافَ أَنْ يَخْلُصَ إِلَيْهِ الْقَتْلُ ، فَأَقْبَلَ  أَبُو جَهْلِ بْنُ هِشَامٍ  فَقَالَ : يَا مَعْشَرَ النَّاسِ ، لَا يَهْزِمَنَّكُمْ خِذْلَانُ  سُرَاقَةَ  إِيَّاكُمْ ، فَإِنَّهُ كَانَ عَلَى مِيعَادٍ مِنْ  مُحَمَّدٍ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَلَا يَهُولَنَّكُمْ قَتْلُ  عُتْبَةَ  وَشَيْبَةَ  وَالْوَلِيدِ  فَإِنَّهُمْ قَدْ عَجَّلُوا ،  فَوَاللَّاتِ  وَالْعُزَّى لَا نَرْجِعُ حَتَّى نُقَرِّنَهُمْ بِالْحِبَالِ ، وَلَا أُلْفِيَنَّ رَجُلًا مِنْكُمْ قَتَلَ مِنْهُمْ رَجُلًا ، وَلَكِنْ خُذُوهُمْ أَخْذًا حَتَّى تُعَرِّفُوهُمْ سُوءَ صَنِيعِهِمْ مِنْ مُفَارَقَتِهِمْ إِيَّاكُمْ وَرَغْبَتِهِمْ عَنِ  اللَّاتِ  وَالْعُزَّى . ثُمَّ قَالَ  أَبُو جَهْلٍ  مُتَمَثِّلًا :  سِنِّي","","Al-Mu'jam al-Kabir 4550","","رفاعة بن رافع الزرقي عن عبد ربه بن سعيد النجاري عن هشام بن سعد المخزومي عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","رفاعة بن رافع الزرقي"
"4553","437 -  رِفَاعَةُ بْنُ عَمْرِو بْنِ زَيْدِ بْنِ عَمْرِو بْنِ ثَعْلَبَةَ بْنِ مَالِكِ بْنِ سَالِمٍ ،  عَقَبِيٌّ بَدْرِيٌّ ، اسْتُشْهِدَ  يَوْمَ أُحُدٍ  4551  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ  أَصْحَابِ الْعَقَبَةِ  رِفَاعَةُ بْنُ عَمْرِو بْنِ زَيْدِ بْنِ عَمْرِو بْنِ قَيْسِ بْنِ ثَعْلَبَةَ بْنِ مَالِكِ بْنِ سَالِمِ بْنِ غَانِمِ بْنِ عَوْفِ بْنِ الْخَزْرَجِ  ، وَقَدْ شَهِدَ  بَدْرًا ،  وَهُوَ مِمَّنْ خَرَجَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُهَاجِرًا  .","","Al-Mu'jam al-Kabir 4551","","","رفاعة بن عمرو بن زيد"
"4554","4552  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ الْعَقَبَةَ مِنَ  الْأَنْصَارِ  ،  ثُمَّ مِنْ  بَنِي الْحُبْلَى ،  رِفَاعَةُ بْنُ عَمْرٍو ،  وَشَهِدَ  بَدْرًا  .","","Al-Mu'jam al-Kabir 4552","","","رفاعة بن عمرو بن زيد"
"4555","4553  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ         [5/49]      يَوْمَ أُحُدٍ  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي سَوَاءٍ ،  رِفَاعَةُ بْنُ عَمْرٍو  .","","Al-Mu'jam al-Kabir 4553","","","رفاعة بن عمرو بن زيد"
"4556","438 -  رِفَاعَةُ بْنُ عَبْدِ الْمُنْذِرِ بْنِ رِفَاعَةَ بْنِ دِينَارٍ الْأَنْصَارِيُّ ،  عَقَبِيٌّ بَدْرِيُّ  4554  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ الْعَقَبَةَ مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي ظَفَرٍ  وَاسْمُ ظَفَرٍ  كَعْبُ بْنُ الْخَزْرَجِ  ، رِفَاعَةُ بْنُ الْمُنْذِرِ بْنِ رِفَاعَةَ بْنِ دِينَارِ بْنِ زَيْدِ بْنِ أُمَيَّةَ بْنِ مَالِكِ بْنِ عَوْفِ بْنِ عَمْرِو بْنِ عَوْفٍ  ، وَقَدْ شَهِدَ  بَدْرًا  .","","Al-Mu'jam al-Kabir 4554","","","رفاعة بن عبد المنذر"
"4557","4555  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي الْأَوْسِ ،  ثُمَّ مِنْ  بَنِي عَمْرِو بْنِ عَوْفٍ ،  ثُمَّ مِنْ  بَنِي أُمَيَّةَ بْنِ زَيْدٍ ،  رِفَاعَةُ بْنُ عَبْدِ الْمُنْذِرِ  .","","Al-Mu'jam al-Kabir 4555","","","رفاعة بن عبد المنذر"
"4558","439 -  رِفَاعَةُ بْنُ عَرَابَةَ الْجُهَنِيُّ  عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  4556  -  حَدَّثَنَا  مُحَمَّدُ بْنُ سَهْلِ بْنِ الْمُهَاجِرِ الرَّقِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُصْعَبٍ الْقُرْقُسَائِيُّ (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَمْرُو بْنُ هَاشِمٍ الْبَيْرُوتِيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ - قَالُوا :  ثَنَا         [5/50]      الْأَوْزَاعِيُّ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  هِلَالِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  رِفَاعَةَ بْنِ عَرَابَةَ قَالَ :  صَدَرْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلَ نَاسٌ يَسْتَأْذِنُونَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَعَلَ يَأْذَنُ لَهُمْ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا بَالُ شِقِّ الشَّجَرَةِ الَّتِي تَلِي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - أَبْغَضُ إِلَيْكُمْ مِنَ الشِّقِّ الْآخَرِ ؟ "" قَالَ : فَلَا تَرَى مِنَ  الْقَوْمِ  إِلَّا بَاكِيًا ! قَالَ : يَقُولُ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ : إِنَّ الَّذِي يَسْتَأْذِنُكَ فِي نَفْسِي بَعْدَهَا لَسَفِيهٌ ، فَقَامَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، وَقَالَ : "" أَشْهَدُ عِنْدَ اللهِ - وَكَانَ إِذَا حَلَفَ قَالَ : وَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ - مَا مِنْكُمْ مَنْ يُؤْمِنُ بِاللهِ ثُمَّ  يُسَدِّدُ  إِلَّا سُلِكَ بِهِ فِي الْجَنَّةِ ، وَلَقَدْ وَعَدَنِي رَبِّي - عَزَّ وَجَلَّ - أَنْ يُدْخِلَ مِنْ أُمَّتِي الْجَنَّةَ سَبْعِينَ أَلْفًا لَا حِسَابَ عَلَيْهِمْ وَلَا عَذَابَ ، وَإِنِّي لَأَرْجُو أَنْ لَا يَدْخُلُوهَا حَتَّى  تَتَبَوَّءُوا  أَنْتُمْ وَمَنْ صَلَحَ مِنْ أَزْوَاجِكُمْ وَذُرِّيَّاتِكُمْ مَسَاكِنَ فِي الْجَنَّةِ "" . ثُمَّ قَالَ : ""  إِذَا مَضَى  شَطْرُ  اللَّيْلِ - أَوْ قَالَ : ثُلُثَاهُ -  يَنْزِلُ  اللهُ عَزَّ وَجَلَّ إِلَى السَّمَاءِ الدُّنْيَا فَيَقُولُ : لَا أَسْأَلُ عَنْ عِبَادِي غَيْرِي ، مَنْ ذَا الَّذِي يَسْأَلُنِي أُعْطِيهِ ؟ مَنْ ذَا الَّذِي يَدْعُونِي أَسْتَجِيبُ لَهُ ؟ مَنْ ذَا الَّذِي يَسْتَغْفِرُنِي أَغْفِرُ لَهُ ؟ حَتَّى يَنْصَدِعَ الْفَجْرُ  .","","Al-Mu'jam al-Kabir 4556","","رفاعة بن عرابة الجهني عن عطاء بن يسار الهلالي عن هلال بن علي بن أسامة عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن محمد بن مصعب القرقساني عن محمد بن سهل بن المهاجر الرقي عن الطبراني","رفاعة بن عرابة الجهني"
"4559","4557  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ كَيْسَانَ الْمِصِّيصِيُّ  ، ثَنَا  حَبَّانُ بْنُ هِلَالٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ  ، ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ - قَالَا :  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  ثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  ثَنَا  هِلَالُ بْنُ أَبِي مَيْمُونَةَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ أَنَّ رِفَاعَةَ بْنَ عَرَابَةَ الْجُهَنِيَّ  حَدَّثَهُ  قَالَ :  أَقْبَلْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلَ نَاسٌ يَسْتَأْذِنُونَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَأْذَنُ لَهُمْ ، فَقَالَ :  مَا بَالُ شِقِّ الشَّجَرَةِ الَّتِي تَلِي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَبْغَضُ إِلَيْكُمْ مِنَ الشِّقِّ الْآخَرِ ؟  قَالَ : فَلَا تَرَى فِي  الْقَوْمِ  إِلَّا بَاكِيًا ! فَقَالَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ : إِنَّ الَّذِي يَسْتَأْذِنُكَ فِي نَفْسِي بَعْدَهَا لَسَفِيهٌ ! فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ وَقَالَ : "" أَشْهَدُ عِنْدَ اللهِ - وَكَانَ إِذَا حَلَفَ قَالَ : وَالَّذِي نَفْسِي بِيَدِهِ - مَا مِنْكُمْ مِنْ أَحَدٍ يُؤْمِنُ بِاللهِ ثُمَّ  يُسَدِّدُ  إِلَّا سُلِكَ بِهِ فِي الْجَنَّةِ ، وَلَقَدْ وَعَدَنِي رَبِّي أَنْ يُدْخِلَ الْجَنَّةَ مِنْ أُمَّتِي         [5/51]      سَبْعِينَ أَلْفًا لَا حِسَابَ عَلَيْهِمْ وَلَا عَذَابَ ، وَإِنِّي لَأَرْجُو أَنْ لَا يَدْخُلُوهَا حَتَّى  تَتَبَوَّءُوا  أَنْتُمْ وَمَنْ صَلَحَ مِنْ أَزْوَاجِكُمْ وَذَرَارِيِّكُمْ مَسَاكِنَ فِي الْجَنَّةِ "" . ثُمَّ قَالَ : ""  إِذَا مَضَى نِصْفُ اللَّيْلِ - أَوْ قَالَ : ثُلُثُ اللَّيْلِ  -  يَنْزِلُ  اللهُ عَزَّ وَجَلَّ إِلَى السَّمَاءِ الدُّنْيَا فَيَقُولُ : مَنْ هَذَا الَّذِي يَسْتَغْفِرُنِي فَأَغْفِرَ لَهُ ؟ مَنْ هَذَا الَّذِي يَدْعُونِي فَأَسْتَجِيبَ لَهُ ؟ مَنْ هَذَا الَّذِي يَسْأَلُنِي فَأُعْطِيَهُ ؟ حَتَّى يَنْفَجِرَ الْفَجْرُ  .","","Al-Mu'jam al-Kabir 4557","","رفاعة بن عرابة الجهني عن عطاء بن يسار الهلالي عن هلال بن علي بن أسامة عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن موسى بن إسماعيل التبوذكي عن محمد بن يحيى بن المنذر القزاز عن الطبراني","رفاعة بن عرابة الجهني"
"4560","4558  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُعَاذٍ الْحَلَبِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  حَرْبُ بْنُ شَدَّادٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  حَدَّثَنِي  هِلَالُ بْنُ أَبِي مَيْمُونَةَ أَنَّ عَطَاءَ بْنَ يَسَارٍ  حَدَّثَهُ  أَنَّ رِفَاعَةَ الْجُهَنِيَّ  حَدَّثَهُ  قَالَ :  أَقْبَلْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى إِذَا كُنَّا  بِالْكَدِيدِ  جَعَلُوا يَسْتَأْذِنُونَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى أَهَالِيهِمْ فَيَأْذَنُ لَهُمْ ، فَقَالَ :  مَا بَالُ شِقِّ الشَّجَرَةِ الَّتِي تَلِي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَبْغَضُ إِلَيْكُمْ مِنَ الشِّقِّ الْآخَرِ ؟  فَلَمْ يُرَ بَعْدَ ذَلِكَ مِنَ  الْقَوْمِ  إِلَّا بَاكٍ ! فَقَالَ  رَجُلٌ مِنَ الْقَوْمِ  : يَا رَسُولَ اللهِ ، إِنَّ الَّذِي يَسْتَأْذِنُكَ بَعْدَ هَذَا لَسَفِيهٌ ! فَحَمِدَ اللهَ وَأَثْنَى خَيْرًا ، ثُمَّ قَالَ : "" أَشْهَدُ عِنْدَ اللهِ لَا يَمُوتُ عَبْدٌ شَهِدَ شَهَادَةَ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  رَسُولُ اللهِ صِدْقًا مِنْ قَلْبِهِ ثُمَّ  يُسَدِّدُ  إِلَّا سُلِكَ بِهِ فِي الْجَنَّةِ ، وَلَقَدْ وَعَدَنِي رَبِّي أَنْ يُدْخِلَ الْجَنَّةَ مِنْ أُمَّتِي سَبْعِينَ أَلْفًا لَا حِسَابَ عَلَيْهِمْ وَلَا عَذَابَ ، وَإِنِّي لَأَرْجُو أَنْ لَا تَدْخُلُوا حَتَّى  تَتَبَوَّءُوا  أَنْتُمْ وَمَنْ صَلَحَ مِنْ أَزْوَاجِكُمْ وَذَرَارِيِّكُمْ مَسَاكِنَ فِي الْجَنَّةِ "" . وَقَالَ : "" إِذَا مَضَى  نِصْفُ اللَّيْلِ أَوْ ثُلُثُ اللَّيْلِ  يَنْزِلُ  اللهُ - عَزَّ وَجَلَّ - إِلَى السَّمَاءِ الدُّنْيَا فَيَقُولُ : لَا أَسْأَلُ عَنْ عِبَادِي غَيْرِي ، مَنْ ذَا الَّذِي يَسْتَغْفِرُنِي أَغْفِرُ لَهُ ؟ مَنْ ذَا الَّذِي يَدْعُونِي أَسْتَجِيبُ لَهُ ؟ مَنْ ذَا الَّذِي يَسْأَلُنِي أُعْطِيهِ ؟ حَتَّى يَنْفَجِرَ الصُّبْحُ  .","","Al-Mu'jam al-Kabir 4558","","رفاعة بن عرابة الجهني عن عطاء بن يسار الهلالي عن هلال بن علي بن أسامة عن يحيى بن أبي كثير عن حرب بن شداد اليشكري عن عبد الله بن رجاء الغداني عن محمد بن معاذ بن سفيان العنزي عن الطبراني","رفاعة بن عرابة الجهني"
"4561","4559  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  هِلَالِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  رِفَاعَةَ بْنِ عَرَابَةَ - قَالَ  أَبُو مُوسَى  : هَكَذَا قَالَ  مُعَاذُ بْنُ         [5/52]      هِشَامٍ ،  وَهُوَ  ابْنُ عَرَابَةَ  - أَنَّهُ حَدَّثَهُ قَالَ :  أَقْبَلْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى إِذَا كُنَّا  بِالْكَدِيدِ  - أَوْ قَالَ  بِقُدَيْدٍ  - جَعَلَ رِجَالٌ مِنَّا يَسْتَأْذِنُونَ إِلَى أَهَالِيهِمْ ، فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْذَنُ لَهُمْ  . ثُمَّ ذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4559","","رفاعة بن عرابة الجهني عن عطاء بن يسار الهلالي عن هلال بن علي بن أسامة عن يحيى بن أبي كثير عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن أبو موسى الزمن عن الساجي عن الطبراني","رفاعة بن عرابة الجهني"
"4562","4560  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  أَبُو أُمَيَّةَ الْحَبَطِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  هِلَالِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنْ  رِفَاعَةَ بْنِ عَرَابَةَ قَالَ :  أَقْبَلْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى إِذَا كُنَّا  بِالْكَدِيدِ  . ثُمَّ ذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4560","","رفاعة بن عرابة الجهني عن عطاء بن يسار الهلالي عن هلال بن علي بن أسامة عن يحيى بن أبي كثير عن أيوب بن خوط الحبطي عن شيبان بن فروخ الحبطي عن الحسين بن إسحاق التستري عن الطبراني","رفاعة بن عرابة الجهني"
"4563","440 -  رِفَاعَةُ بْنُ أَوْسٍ الْأَنْصَارِيُّ ،  اسْتُشْهِدَ  يَوْمَ أُحُدٍ  4561  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ أُحُدٍ  مِنَ  الْأَنْصَارِ ،  رِفَاعَةُ بْنُ أَوْسِ بْنِ زَعْوَرِ بْنِ عَبْدِ الْأَشْهَلِ  .","","Al-Mu'jam al-Kabir 4561","","","رفاعة بن أوس الأنصاري"
"4564","441 -  رِفَاعَةُ بْنُ زَيْدٍ الْجُذَامِيُّ  4562  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  قَدِمَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي هُدْنَةِ الْحُدَيْبِيَةِ  رِفَاعَةُ بْنُ زَيْدٍ الْجُذَامِيُّ  ، فَأَهْدَى لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غُلَامًا ، وَأَسْلَمَ فَحَسُنَ إِسْلَامُهُ ، وَكَتَبَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى قَوْمِهِ كِتَابًا فِيهِ :  بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ ، هَذَا كِتَابٌ مِنْ  مُحَمَّدٍ  رَسُولِ اللهِ  لِرِفَاعَةَ بْنِ زَيْدٍ ؛  إِنِّي بَعَثْتُهُ إِلَى قَوْمِهِ عَامَّةً  وَمَنْ دَخَلَ فِيهِمْ ، يَدْعُوهُمْ إِلَى اللهِ وَإِلَى رَسُولِهِ ، فَمَنْ أَقْبَلَ فَفِي حِزْبِ اللهِ وَرَسُولِهِ ، وَمَنْ أَدْبَرَ فَلَهُ أَمَانُ شَهْرَيْنِ "" ، فَلَمَّا قَدِمَ  رِفَاعَةُ  إِلَى قَوْمِهِ أَجَابُوا وَأَسْلَمُوا .","","Al-Mu'jam al-Kabir 4562","","محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","رفاعة بن زيد الجذامي"
"4565","442 -  رِفَاعَةُ بْنُ قَرَظَةَ الْقَرَظِيُّ         [5/53]      4563  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ ،  عَنْ  رِفَاعَةَ الْقَرَظِيِّ قَالَ :  نَزَلَتْ هَذِهِ الْآيَةُ فِي عَشَرَةِ رَهْطٍ أَنَا أَحَدُهُمْ ؛         {      وَلَقَدْ وَصَّلْنَا لَهُمُ الْقَوْلَ لَعَلَّهُمْ يَتَذَكَّرُونَ         }      .","","Al-Mu'jam al-Kabir 4563","","رفاعة بن قرظة الأنصاري عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن عبد الله بن أحمد بن حنبل عن الطبراني","رفاعة بن قرظة القرظي"
"4566","4564  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  الْأَسْوَدُ بْنُ عَامِرٍ شَاذَانُ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ  أَنَّ  رِفَاعَةَ بْنَ قَرَظَةَ قَالَ :  نَزَلَتْ هَذِهِ الْآيَةُ فِي عَشَرَةٍ أَنَا أَحَدُهُمْ ؛         {      وَلَقَدْ وَصَّلْنَا لَهُمُ الْقَوْلَ         }      إِلَى آخِرِ الْآيَةِ  .","","Al-Mu'jam al-Kabir 4564","","رفاعة بن قرظة الأنصاري عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن حماد بن سلمة عن الأسود بن عامر شاذان عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رفاعة بن قرظة القرظي"
"4567","443 -  رِفَاعَةُ بْنُ سَمَوْأَلٍ الْقَرَظِيُّ  4565  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنِ  الزُّبَيْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الزَّبِيرِ ،  عَنْ  أَبِيهِ  .","","Al-Mu'jam al-Kabir 4565","","عبد الرحمن بن الزبير بن باطا القرظي عن الزبير بن عبد الرحمن بن الزبير القرظي عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","رفاعة بن سموأل القرظي"
"4568","4566  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ الْمِصْرِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ الْحَارِثِ بْنِ نَوْفَلٍ أَنَّ عَبْدَ الْمُطَّلِبِ بْنَ رَبِيعَةَ بْنِ الْحَارِثِ بْنِ عَبْدِ الْمُطَّلِبِ  أَخْبَرَهُ  أَنَّ أَبَاهُ  رَبِيعَةَ بْنَ الْحَارِثِ بْنِ عَبْدِ الْمُطَّلِبِ  وَعَبَّاسَ بْنَ عَبْدِ الْمُطَّلِبِ  قَالَا  لِعَبْدِ الْمُطَّلِبِ بْنِ رَبِيعَةَ  وَالْفَضْلِ بْنِ عَبَّاسٍ  : ائْتِيَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُولَا : يَا رَسُولَ اللهِ ، قَدْ بَلَغْنَا مَا تَرَى مِنَ السِّنِّ ، فَأَحْبَبْنَا أَنْ نَتَزَوَّجَ ، وَأَنْتَ يَا رَسُولَ اللهِ أَبَرُّ النَّاسِ وَأَوْصَلُهُمْ ، وَلَيْسَ عِنْدَ أَبَوَيْنَا مَا  يُصْدِقَانِ  عَنَّا ، فَاسْتَعْمِلْنَا يَا رَسُولَ اللهِ عَلَى الصَّدَقَاتِ ، فَلْنُؤَدِّ إِلَيْكَ مَا يُؤَدِّي الْعُمَّالُ ، وَلْنُصِبْ مَا كَانَ فِيهَا مِنْ مَرْفَقٍ ! قَالَ : فَأَتَى  عَلِيُّ بْنُ أَبِي طَالِبٍ  وَنَحْنُ عَلَى تِلْكَ الْحَالِ ، فَقَالَ لَنَا : لَا ، وَاللهِ لَا يَسْتَعْمِلُ مِنْكُمْ أَحَدًا عَلَى الصَّدَقَةِ ! فَقَالَ لَهُ  رَبِيعَةُ بْنُ الْحَارِثِ  : هَذَا مِنْ  حَسَدِكَ  وَبَغْيِكَ ، وَقَدْ نِلْتَ  صِهْرَ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَلَمْ نَحْسُدْكَ عَلَيْهِ ،         [5/55]      فَأَلْقَى  عَلِيٌّ  رِدَاءَهُ ثُمَّ اضْطَجَعَ عَلَيْهِ ، ثُمَّ قَالَ : أَنَا  أَبُو الْحَسَنِ  الْيَوْمَ ، وَاللهِ لَا أُدِيمُ مَقَامِي هَذَا حَتَّى يَرْجِعَ إِلَيْكُمَا ابْنَاكُمَا بِجَوَابِ مَا بَعَثْتُمَا بِهِ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . قَالَ  عَبْدُ الْمُطَّلِبِ  : فَانْطَلَقْتُ أَنَا  وَالْفَضْلُ  حَتَّى نُوَافِقَ صَلَاةَ الظُّهْرِ قَدْ قَامَتْ ، فَصَلَّيْنَا مَعَ النَّاسِ ، ثُمَّ أَسْرَعْتُ أَنَا  وَالْفَضْلُ  إِلَى بَابِ حُجْرَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَوْمَئِذٍ عِنْدَ  زَيْنَبَ بِنْتِ جَحْشٍ  ، فَقُمْنَا بِالْبَابِ حَتَّى أَتَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَخَذَ بِأُذُنِي وَأُذُنِ  الْفَضْلِ  فَقَالَ : "" اخْرُجَا مَا  تُصَرِّرَانِ  "" ، ثُمَّ دَخَلَ فَأَذِنَ لِي  وَلِلْفَضْلِ  فَدَخَلْنَا ،  فَتَوَاكَلْنَا  الْكَلَامَ قَلِيلًا ، ثُمَّ  كَلَّمْتُهُ أَوْ كَلَّمَهُ  الْفَضْلُ  -  قَدْ شَكَّ فِي ذَلِكَ  عَبْدُ اللهِ  - فَكَلَّمْنَاهُ بِالَّذِي أَمَرَنَا بِهِ أَبَوَانَا ، فَسَكَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ رَفَعَ بَصَرَهُ قِبَلَ سَقْفِ الْبَيْتِ حَتَّى طَالَ عَلَيْنَا أَنَّهُ لَا يَرْجِعُ إِلَيْنَا شَيْئًا ، وَحَتَّى رَأَيْنَا  زَيْنَبَ  تُلْمِعُ  مِنْ وَرَاءِ الْحِجَابِ بِيَدِهَا تُرِيدُ أَنْ لَا نَعْجَلَ ، وَأَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَمْرِنَا ، ثُمَّ خَفَضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأْسَهُ فَقَالَ لَنَا :  إِنَّ هَذِهِ الصَّدَقَةَ إِنَّمَا هِيَ أَوْسَاخُ النَّاسِ ، وَإِنَّهَا لَا تَحِلُّ  لِمُحَمَّدٍ  وَلَا  لِآلِ مُحَمَّدٍ  ، ادْعُوا لِي  نَوْفَلَ بْنَ الْحَارِثِ  "" ، فَدُعِيَ لَهُ  نَوْفَلُ بْنُ الْحَارِثِ  فَقَالَ : "" يَا  نَوْفَلُ ،  أَنْكِحْ  عَبْدَ الْمُطَّلِبِ  "" ، قَالَ : فَأَنْكَحَنِي  نَوْفَلٌ ،  ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" ادْعُوا لِي  مَحْمِيَةَ بْنَ جَزْءٍ  "" ، وَهُوَ رَجُلٌ مِنْ  بَنِي زُبَيْدٍ  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَعْمَلَهُ عَلَى الْأَخْمَاسِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِمَحْمِيَةَ  : "" أَنْكِحِ  الْفَضْلَ  "" ، فَأَنْكَحَهُ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" قُمْ فَأَصْدِقْ عَنْهُمَا مِنَ الْخُمُسِ كَذَا وَكَذَا  "" ،  لَمْ يَسْمَعْهُ  عَبْدُ اللهِ بْنُ الْحَارِثِ  .","","Al-Mu'jam al-Kabir 4566","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن الحارث بن نوفل عن الزهري عن يونس بن يزيدالأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن هارون بن كامل المصري عن الطبراني","ربيعة بن الحارث بن عبد المطلب بن هاشم"
"4569","4567  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِي ،  ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ الْحَارِثِ  أَنَّ  عَبْدَ الْمُطَّلِبِ بْنَ رَبِيعَةَ  أَخْبَرَهُ  قَالَ :  اجْتَمَعَ  رَبِيعَةُ بْنُ الْحَارِثِ  وَالْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ  -  فَذَكَرَ نَحْوَ حَدِيثِ  يُونُسَ  بِطُولِهِ  .","","Al-Mu'jam al-Kabir 4567","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن عبد الله بن عبد الله بن الحارث بن نوفل الهاشمي عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن علي ابن المديني عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","ربيعة بن الحارث بن عبد المطلب بن هاشم"
"4570","4568  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  أَزْهَرُ بْنُ مَرْوَانَ الرَّقَاشِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ نَوْفَلٍ ،  عَنْ  عَبْدِ الْمُطَّلِبِ بْنِ رَبِيعَةَ قَالَ :  اجْتَمَعَ  رَبِيعَةُ بْنُ الْحَارِثِ  وَالْعَبَّاسُ بْنُ         [5/56]      عَبْدِ الْمُطَّلِبِ  -  فَذَكَرَ مِثْلَ حَدِيثِ  يُونُسَ  .  وَرَوَى  الزُّهْرِيُّ  هَذَا الْحَدِيثَ عَنْ  ثَلَاثَةِ إِخْوَةٍ : عَنْ  عَبْدِ اللهِ  ،  وَعُبَيْدِ اللهِ  ،  وَمُحَمَّدٍ  - وَهُمْ بَنُو  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ  .","","Al-Mu'jam al-Kabir 4568","","عبد المطلب بن ربيعة ابن ابن عم رسول الله عن محمد بن عبد الله بن الحارث النوفلي عن الزهري عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن أزهر بن مروان الرقاشي عن موسى بن هارون الحمال عن الطبراني","ربيعة بن الحارث بن عبد المطلب بن هاشم"
"4571","445 -  رَبِيعَةُ بْنُ كَعْبٍ الْأَسْلَمِيُّ ، يُكْنَى أَبَا فِرَاسٍ  4569  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  رَبِيعَةَ بْنِ كَعْبٍ الْأَسْلَمِيِّ قَالَ :  كُنْتُ أَنَامُ فِي حُجْرَةِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكُنْتُ أَسْمَعُهُ إِذَا قَامَ مِنَ اللَّيْلِ يُصَلِّي ، يَقُولُ :         {      الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      الْهَوِيَّ  ، ثُمَّ يَقُولُ : "" سُبْحَانَ رَبِّيَ الْعَظِيمِ وَبِحَمْدِهِ ""  الْهَوِيَّ  ،  قُلْتُ : مَا  الْهَوِيُّ  ؟ فَقَالَ : "" يَدْعُو سَاعَةً  .","","Al-Mu'jam al-Kabir 4569","","ربيعة بن كعب الأسلمي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ربيعة بن كعب الأسلمي"
"4572","4570  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  ثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  رَبِيعَةَ بْنِ كَعْبٍ قَالَ :  كُنْتُ أَبِيتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَآتِيهِ بِوَضُوئِهِ وَحَاجَتِهِ ، فَكَانَ يَقُومُ مِنَ اللَّيْلِ فَيَقُولُ : "" سُبْحَانَ رَبِّي وَبِحَمْدِهِ ، سُبْحَانَ رَبِّي وَبِحَمْدِهِ ""  الْهَوِيَّ  ، "" سُبْحَانَ رَبِّ الْعَالَمِينَ ، سُبْحَانَ رَبِّ الْعَالَمِينَ ""  الْهَوِيَّ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هَلْ لَكَ حَاجَةٌ ؟ "" ، قُلْتُ : يَا رَسُولَ اللهِ ، مُرَافَقَتُكَ فِي الْجَنَّةِ ! قَالَ :  فَأَعِنِّي عَلَى نَفْسِكَ بِكَثْرَةِ السُّجُودِ  .","","Al-Mu'jam al-Kabir 4570","","ربيعة بن كعب الأسلمي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","ربيعة بن كعب الأسلمي"
"4573","4571  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  رَبِيعَةَ بْنِ كَعْبٍ الْأَسْلَمِيِّ قَالَ :  كُنْتُ أَبِيتُ عِنْدَ بَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكُنْتُ أَسْمَعُهُ  الْهَوِيَّ  مِنَ اللَّيْلِ يَقُولُ :         {      الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      ، وَكُنْتُ أَسْمَعُهُ  الْهَوِيَّ  مِنَ اللَّيْلِ يَقُولُ : "" سُبْحَانَ رَبِّي وَبِحَمْدِهِ  .         [5/57]","","Al-Mu'jam al-Kabir 4571","","ربيعة بن كعب الأسلمي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن هشام الدستوائي عن حجاج بن نصير الفساطيطي عن أبو مسلم الكجي عن الطبراني","ربيعة بن كعب الأسلمي"
"4574","4572  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  رَبِيعَةَ بْنِ كَعْبٍ الْأَسْلَمِيِّ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 4572","","ربيعة بن كعب الأسلمي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن علي بن المبارك الهنائي عن حجاج بن نصير الفساطيطي عن أبو مسلم الكجي عن الطبراني","ربيعة بن كعب الأسلمي"
"4575","4573  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدَةَ الْمِصِّيصِيُّ  ، ثَنَا  أَبُو تَوْبَةَ الرَّبِيعُ بْنُ نَافِعٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى بْنُ بِشْرٍ الْحَرِيرِيُّ - قَالَا :  ثَنَا  مُعَاوِيَةُ بْنُ سَلَّامٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  حَدَّثَنِي  أَبُو سَلَمَةَ أَنَّ رَبِيعَةَ بْنَ كَعْبٍ  أَخْبَرَهُ  أَنَّهُ كَانَ يَبِيتُ عِنْدَ بَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَكَانَ يَسْمَعُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ مِنَ اللَّيْلِ : "" سُبْحَانَ اللهِ رَبِّ الْعَالَمِينَ  الْهَوِيَّ  ، ثُمَّ يَقُولُ : "" سُبْحَانَ رَبِّي وَبِحَمْدِهِ  نَحْوَ ذَلِكَ .","","Al-Mu'jam al-Kabir 4573","","ربيعة بن كعب الأسلمي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن معاوية بن سلام عن يحيى بن بشر بن كثير الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ربيعة بن كعب الأسلمي"
"4576","4574  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ  ، ثَنَا  آدَمُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  رَبِيعَةَ بْنِ كَعْبٍ الْأَسْلَمِيِّ قَالَ :  كُنْتُ أَبِيتُ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَكُنْتُ أَسْمَعُهُ  الْهَوِيَّ  مِنَ اللَّيْلِ يَقُولُ :         {      الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      ، ثُمَّ يَقُولُ : "" سُبْحَانَ رَبِّي وَبِحَمْدِهِ ""  الْهَوِيَّ  .","","Al-Mu'jam al-Kabir 4574","","ربيعة بن كعب الأسلمي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن آدم بن أبي إياس عن جعفر بن محمد القلانسي عن الطبراني","ربيعة بن كعب الأسلمي"
"4577","4575  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  حُسَيْنٍ الْمُعَلِّمِ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ أَنَّ أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ  أَخْبَرَهُ  أَنَّهُ سَمِعَ  رَبِيعَةَ بْنَ كَعْبٍ يَقُولُ :  بِتُّ عِنْدَ بَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَمِعْتُهُ يَقُولُ إِذَا قَامَ مِنَ اللَّيْلِ :  سُبْحَانَ رَبِّ الْعَالَمِينَ ""  الْهَوِيَّ  ،  ثُمَّ يَقُولُ : "" سُبْحَانَ رَبِّي وَبِحَمْدِهِ ""  الْهَوِيَّ  .","","Al-Mu'jam al-Kabir 4575","","ربيعة بن كعب الأسلمي عن أبو سلمة بن عبد الرحمن عن يحيى بن أبي كثير عن حسين المعلم عن عبد الوارث بن سعيد بن ذكوان عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","ربيعة بن كعب الأسلمي"
"4578","4576  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  أَحْمَدُ بْنُ عَبْدِ الْمَلِكِ بْنِ وَاقِدٍ الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَاءٍ ،  عَنْ  نُعَيْمٍ الْمُجْمِرِ ،  عَنْ  رَبِيعَةَ بْنِ كَعْبٍ قَالَ :  كُنْتُ أَخْدُمُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَارِي ، فَإِذَا كَانَ اللَّيْلُ أَوَيْتُ إِلَى بَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَبِتُّ عِنْدَهُ ، فَلَا         [5/58]      أَزَالُ أَسْمَعُهُ يَقُولُ : "" سُبْحَانَ اللهِ ، سُبْحَانَ رَبِّي "" ، حَتَّى أَمَلَّ أَوْ تَغْلِبَنِي عَيْنِي فَأَنَامُ ، فَقَالَ ذَاتَ يَوْمٍ : "" يَا  رَبِيعَةُ ،  سَلْنِي فَأُعْطِيَكَ "" ، قُلْتُ : أَنْظِرْنِي حَتَّى أَنْظُرَ ! وَتَذَكَّرْتُ أَنَّ الدُّنْيَا فَانِيَةٌ مُنْقَطِعَةٌ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، أَسْأَلُكَ أَنْ تَدْعُوَ اللهَ أَنْ يُجَنِّبَنِي مِنَ النَّارِ وَيُدْخِلَنِي الْجَنَّةَ ! فَسَكَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ : "" مَنْ أَمَرَكَ بِهَذَا ؟ "" ، قُلْتُ : مَا أَمَرَنِي بِهِ أَحَدٌ ، وَلَكِنِّي عَلِمْتُ أَنَّ الدُّنْيَا مُنْقَطِعَةٌ فَانِيَةٌ ، وَأَنْتَ مِنَ اللهِ بِالْمَكَانِ الَّذِي أَنْتَ بِهِ أَحْبَبْتُ أَنْ تَدْعُوَ اللهَ ! قَالَ :  إِنِّي فَاعِلٌ ، فَأَعِنِّي بِكَثْرَةِ السُّجُودِ  .","","Al-Mu'jam al-Kabir 4576","","ربيعة بن كعب الأسلمي عن نعيم بن عبد الله المجمر عن محمد بن عمرو بن عطاء العامري عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن أحمد بن عبد الملك بن واقد الحراني عن محمد بن أحمد بن النضر النضري عن الطبراني","ربيعة بن كعب الأسلمي"
"4579","4577  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ - قَالَا :  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  ثَنَا  أَبُو عِمْرَانَ الْجَوْنِيُّ ،  عَنْ  رَبِيعَةَ الْأَسْلَمِيِّ قَالَ :  كُنْتُ أَخْدُمُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَأَعْطَانِي أَرْضًا وَأَعْطَى  أَبَا بَكْرٍ  أَرْضًا ، وَجَاءَتِ الدُّنْيَا ، فَاخْتَلَفْنَا فِي  عِذْقِ  نَخْلَةٍ ؛ فَقَالَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ : هِيَ فِي حَدِّ أَرْضِي ! وَقُلْتُ أَنَا : هِيَ فِي حَدِّي ! وَكَانَ بَيْنِي وَبَيْنَ  أَبِي بَكْرٍ  كَلَامٌ ، فَقَالَ لِي  أَبُو بَكْرٍ  كَلِمَةً كَرِهْتُهَا وَنَدِمَ ، فَقَالَ لِي : يَا  رَبِيعَةُ ،  رُدَّ عَلَيَّ مِثْلَهَا حَتَّى يَكُونَ قِصَاصًا ! قُلْتُ : لَا أَفْعَلُ ! فَقَالَ  أَبُو بَكْرٍ  : لَتَقُولَنَّ أَوْ لَأَسْتَعْدِيَنَّ عَلَيْكَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ! قُلْتُ : مَا أَنَا بِفَاعِلٍ ! قَالَ : وَرَفَضَ الْأَرْضَ ، فَانْطَلَقَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَانْطَلَقْتُ أَتْلُوهُ ، فَجَاءَ أُنَاسٌ مِنْ  أَسْلَمَ  فَقَالُوا : رَحِمَ اللهُ  أَبَا بَكْرٍ !  فِي أَيِّ شَيْءٍ يَسْتَعْدِي عَلَيْكَ رَسُولَ اللهِ وَهُوَ الَّذِي قَالَ لَكَ مَا قَالَ ؟ فَقُلْتُ : أَتَدْرُونَ مَنْ هَذَا ؟ هَذَا  أَبُو بَكْرٍ الصِّدِّيقُ  ، وَهُوَ ثَانِي اثْنَيْنِ ، هُوَ ذُو شَيْبَةِ الْمُسْلِمِينَ ، فَإِيَّاكُمْ ، يَلْتَفِتُ فَيَرَاكُمْ تَنْصُرُونِي عَلَيْهِ فَيَغْضَبُ ، فَيَأْتِيَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَيَغْضَبَ لِغَضَبِهِ ، فَيَغْضَبُ اللهُ لِغَضَبِهِمَا فَيَهْلِكُ  رَبِيعَةُ !  قَالُوا : فَمَا تَأْمُرُنَا ؟ قَالَ : ارْجِعُوا ! فَانْطَلَقَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَتَبِعْتُهُ وَحْدِي ، وَجَعَلْتُ أَتْلُو حَتَّى أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَحَدَّثَهُ الْحَدِيثَ كَمَا كَانَ ، فَرَفَعَ إِلَيَّ رَأْسَهُ فَقَالَ : "" يَا  رَبِيعَةُ ،  مَا لَكَ  وَلِلصِّدِّيقِ  ؟ "" ، قُلْتُ :         [5/59]      يَا رَسُولَ اللهِ ، كَانَ كَذَا وَكَانَ كَذَا ، فَقَالَ لِي كَلِمَةً كَرِهْتُهَا ، فَقَالَ لِي قُلْ كَمَا قُلْتُ لَكَ حَتَّى يَكُونَ قِصَاصًا ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَجَلْ ، فَلَا تَرُدَّ عَلَيْهِ ، وَلَكِنْ قُلْ : غَفَرَ اللهُ لَكَ يَا  أَبَا بَكْرٍ ،  [ غَفَرَ اللهُ لَكَ يَا  أَبَا بَكْرٍ  ] "" . قَالَ : فَوَلَّى  أَبُو بَكْرٍ  - رَحِمَهُ اللهُ - وَهُوَ يَبْكِي  .","","Al-Mu'jam al-Kabir 4577","","ربيعة بن كعب الأسلمي عن عبد الملك بن حبيب الجوني عن مبارك بن فضالة عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","ربيعة بن كعب الأسلمي"
"4580","4578  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  أَبِي عِمْرَانَ الْجَوْنِيِّ ،  عَنْ  رَبِيعَةَ الْأَسْلَمِيِّ قَالَ :  كُنْتُ أَخْدُمُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ يَوْمًا : "" يَا  رَبِيعَةُ ،  أَلَا تَزَوَّجُ ؟ "" ، فَقُلْتُ : وَاللهِ يَا رَسُولَ اللهِ لَخِدْمَتُكُمْ أَحَبُّ إِلَيَّ ! قَالَ : ثُمَّ أَعَادَ عَلَيَّ بَعْدَ مَرَّةً أُخْرَى فَقُلْتُ مِثْلَ ذَلِكَ ، قَالَ : فَقُلْتُ : وَاللهِ لَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَعْلَمُ بِمَا يُصْلِحُنِي مِنِّي ، فَلَئِنْ قَالَ لِي مَرَّةً أُخْرَى لَأَقُولَنَّ بَلَى يَا رَسُولَ اللهِ ، فَقَالَ لِي : "" يَا  رَبِيعَةُ ،  أَلَا تَزَوَّجُ ؟ "" ، قُلْتُ : بَلَى يَا رَسُولَ اللهِ ! قَالَ لِي :  ائْتِ فُلَانًا -  لِرَجُلٍ مِنَ الْأَنْصَارِ  - فَلْيُزَوِّجُوكَ ابْنَتَهُمْ  فُلَانَةَ  ، قَالَ : فَأَتَيْتُهُمْ فَقُلْتُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْمُرُكُمْ أَنْ تُزَوِّجُونِي ! قَالُوا : مَرْحَبًا بِرَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، لَا يَذْهَبُ رَسُولُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا لِحَاجَتِهِ ! قَالَ : فَزَوَّجُونِي ، لَمْ يَسْأَلُونِي بَيِّنَةً ! فَأَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا كَئِيبٌ ، فَقَالَ لِي : "" مَا لَكَ يَا  رَبِيعَةُ ؟  "" ، قُلْتُ : يَا رَسُولَ اللهِ ، أَتَيْتُ قَوْمًا كِرَامًا فَزَوَّجُونِي وَلَمْ يَسْأَلُونِي بَيِّنَةً ! وَلَيْسَ عِنْدِي مَا أَصْدَقُ . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اجْمَعُوا لَهُ وَزْنَ نَوَاةٍ مِنْ ذَهَبٍ "" ، فَجَمَعُوا لِي وَزْنَ نَوَاتَيْنِ مِنْ ذَهَبٍ فَأَتَيْتُهُمْ بِهِ ، فَقَبِلُوا وَقَالُوا : كَثِيرٌ طَيِّبٌ ! فَأَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا كَئِيبٌ ، فَقَالَ : "" مَا لَكَ يَا  رَبِيعَةُ ؟  "" ، فَقُلْتُ : يَا رَسُولَ اللهِ ، أَتَيْتُ قَوْمًا كِرَامًا فَقَبِلُوا وَقَالُوا كَثِيرٌ طَيِّبٌ ، وَلَيْسَ عِنْدِي مَا أُولِمُ ! فَقَالَ : "" اجْمَعُوا لَهُ فِي ثَمَنِ كَبْشٍ "" ، فَجَمَعُوا لِي فِي ثَمَنِ كَبْشٍ ، وَأَرْسَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى أَهْلِهِ فَأُتِيَ  بِمِكْتَلٍ  فِيهِ شَعِيرٌ ، فَأَتَيْتُهُمْ بِهِ فَقَالُوا : أَمَّا الْكَبْشُ فَاكْفُونَاهُ أَنْتُمْ ، وَأَمَّا الشَّعِيرُ فَنَحْنُ نَكْفِيكُمُوهُ ! قَالَ : فَفَعَلُوا ذَلِكَ وَأَصْبَحْتُ ، فَدَعَوْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابَهُ  .","","Al-Mu'jam al-Kabir 4578","","ربيعة بن كعب الأسلمي عن عبد الملك بن حبيب الجوني عن مبارك بن فضالة عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","ربيعة بن كعب الأسلمي"
"4581","[5/60]      4579  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْأَزْدِيُّ ،  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْأَسْلَمِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَامِرٍ الْأَسْلَمِيُّ ،  عَنْ  يَحْيَى بْنِ بَهْزٍ الْأَسْلَمِيِّ ،  عَنْ  حَنْظَلَةَ بْنِ عَلِيٍّ الْأَسْلَمِيِّ ،  عَنْ  رَبِيعَةَ بْنِ كَعْبٍ الْأَسْلَمِيِّ قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَمْسَحُ عَلَى خُفَّيْهِ  .","","Al-Mu'jam al-Kabir 4579","","ربيعة بن كعب الأسلمي عن حنظلة بن علي بن الأسقع الأسلمي عن يحيى بن هند الأسلمي عن عبد الله بن عامر الأسلمي عن الواقدي عن محمد بن يحيى بن أبي حاتم عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ربيعة بن كعب الأسلمي"
"4582","4580  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْأَسَدِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ الصَّمَدِ الْعَمِّيُّ ،  عَنْ  أَبِي عِمْرَانَ الْجَوْنِيِّ ،  عَنْ  أَبِي فِرَاسٍ - رَجُلٍ مِنْ أَسْلَمَ - قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ :  سَلُونِي عَمَّا شِئْتُمْ "" ، فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، مَنْ أَبِي  ؟ قَالَ : "" أَبُوكَ فُلَانٌ الَّذِي تُدْعَى إِلَيْهِ "" ، وَسَأَلَهُ  رَجُلٌ :  أَفِي الْجَنَّةِ أَنَا ؟ فَقَالَ : "" فِي الْجَنَّةِ "" ، وَقَالَ  آخَرُ  : أَفِي الْجَنَّةِ أَنَا ؟ قَالَ : "" فِي النَّارِ "" ، فَقَامَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - فَقَالَ : رَضِينَا بِاللهِ رَبًّا  .","","Al-Mu'jam al-Kabir 4580","","ربيعة بن كعب الأسلمي عن عبد الملك بن حبيب الجوني عن عبد العزيز بن عبد الصمد العمي عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ربيعة بن كعب الأسلمي"
"4583","447 -  رَبِيعَةُ بْنُ قَيْسٍ الْعَدْوَانِيُّ  4581  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  ضِرَارُ بْنُ صُرَدٍ  ، ثَنَا  عَلِيُّ بْنُ هَاشِمٍ  ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ أَبِي رَافِعٍ  ،  عَنْ  أَبِيهِ  فِي تَسْمِيَةِ مَنْ شَهِدَ مَعَ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - مِنْ أَصْحَابِ رَسُولِ اللهُ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَبِيعَةُ بْنُ قَيْسٍ ،  وَهُوَ مِنْ  عَدْوَانَ  .","","Al-Mu'jam al-Kabir 4581","","","ربيعة بن قيس العدواني"
"4584","[5/61]      448 -  رَبِيعَةُ بْنُ عَبَّادٍ الدَّيْلِيُّ  4582  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  مُحَمَّدُ بْنُ سَعِيدٍ الْأَصْبَهَانِيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ وَيَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ، قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ أَبِي الزِّنَادِ ،  حَدَّثَنِي  أَبِي  ،  أَخْبَرَنِي  رَبِيعَةُ بْنُ عَبَّادٍ الدَّيْلِيُّ قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْجَاهِلِيَّةِ  بِسُوقِ ذِي الْمَجَازِ  وَهُوَ يَقُولُ :  يَا أَيُّهَا النَّاسُ ، قُولُوا لَا إِلَهَ إِلَّا اللهُ تُفْلِحُوا  ، فَلَمْ يَزَلْ يُرَدِّدُهَا مِرَارًا وَالنَّاسُ مُتَصَفُّونَ عَلَيْهِ يَتَّبِعُونَهُ ، وَإِذَا وَرَاءَهُ رَجُلٌ أَحْوَلُ ذُو  غَدِيرَتَيْنِ  وَضِيءُ الْوَجْهِ يَقُولُ : إِنَّهُ صَابِئٌ كَاذِبٌ - مَرَّتَيْنِ ، فَسَأَلْتُ مَنْ هَذَا ؟ فَقَالُوا : هَذَا عَمُّهُ  أَبُو لَهَبٍ  .","","Al-Mu'jam al-Kabir 4582","","ربيعة بن عباد الديلي عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","ربيعة بن عباد الديلي"
"4585","4583  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَتُّوَيْهِ الْأَصْبَهَانِيُّ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي الشَّوَارِبِ ،  ثَنَا  سَعِيدُ بْنُ سَلَمَةَ بْنِ أَبِي الْحُسَامِ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُنْكَدِرِ  أَنَّهُ سَمِعَ  رَبِيعَ بْنَ عِبَادٍ أَوْ عَبَّادٍ - شَكَّ  ابْنُ أَبِي الشَّوَارِبِ  - قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَطُوفُ عَلَى النَّاسِ  بِمِنًى  فِي مَنَازِلِهِمْ قَبْلَ أَنْ يُهَاجِرَ إِلَى  الْمَدِينَةِ ،  يَقُولُ :  يَا أَيُّهَا النَّاسُ ، إِنَّ اللهَ - عَزَّ وَجَلَّ - يَأْمُرُكُمْ أَنْ تَعْبُدُوهُ وَلَا تُشْرِكُوا بِهِ شَيْئًا  ، وَوَرَاءَهُ رَجُلٌ يَقُولُ : يَا أَيُّهَا النَّاسُ ، إِنَّ هَذَا يَأْمُرُكُمْ أَنْ تَتْرُكُوا دِينَ آبَائِكُمْ ! فَسَأَلْتُ مَنْ هَذَا الرَّجُلُ ؟ فَقَالُوا : عَمُّهُ  أَبُو لَهَبٍ  .","","Al-Mu'jam al-Kabir 4583","","ربيعة بن عباد الديلي عن محمد بن المنكدر عن سعيد بن سلمة السدوسي عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن إبراهيم بن محمد الطيان عن الطبراني","ربيعة بن عباد الديلي"
"4586","4584  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنْبَأَ  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  رَبِيعَةَ بْنِ عَبَّادٍ الدِّيلِيِّ قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِذِي الْمَجَازِ  وَهُوَ يَتَّبِعُ النَّاسَ يَدْعُوهُمْ إِلَى اللهِ فِي مَنَازِلِهِمْ  ، وَوَرَاءَهُ رَجُلٌ أَحْوَلُ يَقُولُ : لَا يَفْتِنَكُمْ هَذَا عَنْ دِينِ آبَائِكُمْ ! فَقُلْتُ : مَنْ هَذَا ؟ فَقَالُوا : عَمُّهُ  أَبُو لَهَبٍ  .","","Al-Mu'jam al-Kabir 4584","","ربيعة بن عباد الديلي عن محمد بن المنكدر عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","ربيعة بن عباد الديلي"
"4587","4585  -  حَدَّثَنَا  مُحَمَّدُ بْنُ رُزَيْقِ بْنِ جَامِعٍ الْمِصْرِيُّ  ، ثَنَا  عَبْدَةُ بْنُ         [5/62]      عَبْدِ الرَّحِيمِ الْمَرْوَزِيُّ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  أَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  عَنِ  ابْنِ الْمُنْكَدِرِ ،  عَنْ  رَبِيعَةَ بْنِ عَبَّادٍ قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِذِي الْمَجَازِ  يَتَّبِعُ النَّاسَ فِي مَنَازِلِهِمْ يَدْعُوهُمْ إِلَى اللهِ عَزَّ وَجَلَّ  ، وَوَرَاءَهُ رَجُلٌ أَحْوَلُ وَهُوَ يَقُولُ : يَا أَيُّهَا النَّاسُ ، لَا يَغُرَّنَّكُمْ هَذَا عَنْ دِينِكُمْ وَدِينِ آبَائِكُمْ ! فَقُلْتُ : مَنْ هَذَا ؟ فَقَالُوا : عَمُّهُ  أَبُو لَهَبٍ  .","","Al-Mu'jam al-Kabir 4585","","ربيعة بن عباد الديلي عن محمد بن المنكدر عن محمد بن عمرو بن علقمة بن وقاص الليثي عن النضر بن شميل عن عبدة بن عبد الرحيم بن حسان المروزي عن محمد بن رزيق بن جامع العدل عن الطبراني","ربيعة بن عباد الديلي"
"4588","4586  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ مُحَمَّدِ بْنِ الْمُهَاجِرِ الْقُرَشِيُّ الْمِصْرِيُّ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ الْمُنْكَدِرِ بْنِ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّهُ سَمِعَ  رَبِيعَةَ بْنَ عَبَّادٍ الدِّيَلِيَّ يَقُولُ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَطُوفُ عَلَى النَّاسِ  بِمِنًى  فِي مَنَازِلِهِمْ قَبْلَ أَنْ يُهَاجِرَ إِلَى  الْمَدِينَةِ  يَقُولُ :  أَيُّهَا النَّاسُ ، إِنَّ اللهَ أَمَرَكُمْ أَنْ تَعْبُدُوهُ وَلَا تُشْرِكُوا بِهِ شَيْئًا  ، وَوَرَاءَهُ رَجُلٌ أَحْوَلُ وَضِيءٌ لَهُ  غَدِيرَتَانِ  يَقُولُ : أَيُّهَا النَّاسُ ، هَذَا يَأْمُرُكُمْ أَنْ تَتْرُكُوا دِينَ آبَائِكُمْ ! فَسَأَلْتُ عَنْهُ فَقِيلَ : هَذَا عَمُّهُ  أَبُو لَهَبٍ  .","","Al-Mu'jam al-Kabir 4586","","ربيعة بن عباد الديلي عن محمد بن المنكدر عن المنكدر بن محمد بن المنكدر القرشي عن عبد الله بن المنكدر بن محمد عن عبيد الله بن عبد الله بن المنكدر التيمي عن إسماعيل بن محمد بن وهب المصري عن الطبراني","ربيعة بن عباد الديلي"
"4589","4587  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ الْبَزَّازُ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي صَفْوَانَ الثَّقَفِيُّ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  ثَنَا  سَعِيدُ بْنُ سَلَمَةَ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ وَمُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  رَبِيعَةَ بْنِ عَبَّادٍ قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِسُوقِ ذِي الْمَجَازِ  قَبْلَ أَنْ يُهَاجِرَ وَهُوَ يَطُوفُ عَلَى النَّاسِ فَيَقُولُ :  يَا أَيُّهَا النَّاسُ ، إِنَّ اللهَ يَأْمُرُكُمْ أَنْ تَعْبُدُوهُ وَلَا تُشْرِكُوا بِهِ شَيْئًا  ، وَخَلْفَهُ رَجُلٌ يَقُولُ : يَا أَيُّهَا النَّاسُ ، إِنَّ هَذَا يَأْمُرُكُمْ أَنْ تَتْرُكُوا دِينَ آبَائِكُمْ ! قُلْتُ : مَنْ هَذَا ؟ قَالُوا : عَمُّهُ  أَبُو لَهَبٍ  .","","Al-Mu'jam al-Kabir 4587","","ربيعة بن عباد الديلي عن محمد بن المنكدر عن سعيد بن سلمة السدوسي عن عبد الصمد بن عبد الوارث التنوري عن محمد بن عثمان بن أبي صفوان الثقفي عن أحمد بن عبد الله البزاز عن الطبراني","ربيعة بن عباد الديلي"
"4590","4588  -  حَدَّثَنَا  مُوسَى بْنُ سَهْلٍ أَبُو عِمْرَانَ الْجَوْنِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  شُعَيْبُ بْنُ إِسْحَاقَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  ابْنُ وَهْبٍ - قَالَا :  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  سَعِيدِ بْنِ خَالِدٍ الْقَارِظِيِّ ،  عَنْ  رَبِيعَةَ بْنِ عَبَّادٍ قَالَ :  رَأَيْتُ  أَبَا لَهَبٍ  بِعُكَاظَ  وَهُوَ يَتَّبِعُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَقُولُ : يَا         [5/63]      أَيُّهَا النَّاسُ ، إِنَّ هَذَا قَدْ غَوَى ، فَلَا يُغْوِيَنَّكُمْ عَنْ  مَآثِرِ  آبَائِكُمْ  ! وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَلُوذُ  مِنْهُ ، وَهُوَ يَتَّبِعُهُ  .","","Al-Mu'jam al-Kabir 4588","","ربيعة بن عباد الديلي عن سعيد بن خالد بن عبد الله القارظي عن محمد بن عبد الرحمن بن المغيرة عن عبد الله بن وهب المصري عن إبراهيم بن المنذر الحزامي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ربيعة بن عباد الديلي"
"4591","4589  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيِّ الْمَعْمَرِيُّ  ، ثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  ثَنَا  ابْنُ أَبِي زَائِدَةَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  حُسَيْنُ بْنُ عَبْدِ اللهِ بْنِ عَبَّاسٍ قَالَ :  سَمِعْتُ  رَبِيعَةَ بْنَ عَبَّادٍ الدِّيَلِيَّ قَالَ :  إِنِّي لَمَعَ أَبِي رَجُلٌ شَابٌّ أَنْظُرُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَّبِعُ الْقَبَائِلَ ، وَوَرَاءَهُ رَجُلٌ أَحْوَلُ وَضِيءٌ ذُو  جُمَّةٍ  ، يَقِفُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْقَبِيلَةِ فَيَقُولُ :  يَا بَنِي فُلَانٍ ، إِنِّي رَسُولُ اللهِ إِلَيْكُمْ ، آمُرُكُمْ أَنْ تَعْبُدُوا اللهَ وَلَا تُشْرِكُوا بِهِ شَيْئًا ،  وَأَنْ تُصَدِّقُونِي وَتَمْنَعُونِي حَتَّى أُنْفِذَ عَنِ اللهِ مَا بَعَثَنِي بِهِ "" ، فَإِذَا فَرَغَ مِنْ مَقَالَتِهِ قَالَ الْآخَرُ مِنْ خَلْفِهِ : يَا بَنِي فُلَانٍ ، إِنَّ هَذَا يُرِيدُ مِنْكُمْ أَنْ تَسْلَخُوا  اللَّاتَ  وَالْعُزَّى وَحُلَفَاءَكُمْ مِنَ الْحَيِّ مِنْ  بَنِي مَالِكِ بْنِ أُقَيْشٍ  إِلَى مَا جَاءَ بِهِ مِنَ الْبِدْعَةِ وَالضَّلَالَةِ ، فَلَا تَسْمَعُوا وَلَا تَتَّبِعُوهُ ! فَقُلْتُ لِأَبِي : مَنْ هَذَا ؟ قَالَ : هَذَا عَمُّهُ  أَبُو لَهَبٍ  .","","Al-Mu'jam al-Kabir 4589","","ربيعة بن عباد الديلي عن الحسين بن عبد الله بن عبيد الله بن عباس الهاشمي عن محمد بن إسحاق عن يحيى بن زكريا بن أبي زائدة عن مسروق بن المرزبان الكندي عن الحسن بن علي بن شبيب المعمري عن الطبراني","ربيعة بن عباد الديلي"
"4592","4590  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ أَنَّ بُكَيْرَ بْنَ عَبْدِ اللهِ بْنِ الْأَشَجِّ  حَدَّثَهُ  عَنْ  رَبِيعَةَ بْنِ عَبَّادٍ قَالَ :  رَأَيْتُ  أَبَا لَهَبٍ  بِعُكَاظَ  وَهُوَ يَتَّبِعُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَقُولُ : يَا أَيُّهَا النَّاسُ ، إِنَّ هَذَا قَدْ غَوَى ،  فَلَا يُغْوِيَنَّكُمْ عَنْ  مَآثِرِ  آبَائِكُمْ ! وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْعَى وَهُوَ عَلَى أَثَرِهِ ، وَنَحْنُ نَتَّبِعُهُ ، كَأَنِّي أَنْظُرُ إِلَيْهِ أَحْوَلُ ذُو  غَدِيرَتَيْنِ  أَبْيَضُ النَّاسِ وَأَجْمَلُهُ  .","","Al-Mu'jam al-Kabir 4590","","ربيعة بن عباد الديلي عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن إبراهيم بن المنذر الحزامي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ربيعة بن عباد الديلي"
"4593","4591  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْخَطَّابِ ،  ثَنَا  مَسْعُودُ بْنُ سَعْدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنِ  ابْنِ عَبَّادٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاقِفًا فِي مَكَانٍ قَبْلَ أَنْ يُبْعَثَ ، ثُمَّ رَأَيْتُهُ بَعْدَمَا بُعِثَ وَاقِفًا فِي ذَلِكَ الْمَوْضِعِ  بِعَرَفَاتٍ  .","","Al-Mu'jam al-Kabir 4591","","ربيعة بن عباد الديلي عن ابن عباد عن عطاء بن السائب عن مسعود بن سعد الجعفي عن عبد العزيز بن الخطاب الكوفي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","ربيعة بن عباد الديلي"
"4594","4592  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ - قَالَا :  ثَنَا         [5/64]      جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنِ  ابْنِ رَبِيعَةَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاقِفًا مَعَ الْمُشْرِكِينَ  بِعَرَفَاتٍ  ، ثُمَّ رَأَيْتُهُ بَعْدَ مَا بُعِثَ وَاقِفًا فِي مَوْقِفِهِ ذَلِكَ ، فَعَلِمْتُ أَنَّ اللهَ وَفَقَّهُ لِذَلِكَ  .","","Al-Mu'jam al-Kabir 4592","","ربيعة القرشي عن ابن ربيعة عن عطاء بن السائب عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ربيعة بن عباد الديلي"
"4595","4593  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الْخَطَّابِ ،  ثَنَا  مَسْعُودُ بْنُ سَعْدٍ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنِ  ابْنِ عَبَّادٍ ،  عَنْ  أَبِيهِ  قَالَ :  جَاءَ  رَجُلٌ مِنْ بَنِي لَيْثٍ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، أُنْشِدُكَ - قَالَهَا ثَلَاثَ مَرَّاتٍ ، فَأَنْشَدَهُ الرَّابِعَةَ مِدْحَةً لَهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ كَانَ أَحَدٌ مِنَ الشُّعَرَاءِ يُحْسِنُ فَقَدْ أَحْسَنْتَ  .","","Al-Mu'jam al-Kabir 4593","","عباد بن عمرو الديلي عن ربيعة بن عباد الديلي عن عطاء بن السائب عن مسعود بن سعد الجعفي عن عبد العزيز بن الخطاب الكوفي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","ربيعة بن عباد الديلي"
"4596","449 -  رَبِيعَةُ بْنُ عَامِرِ بْنِ بِجَادٍ  4594  -  حَدَّثَنَا  أَبُو حَصِينٍ وَالْحُسَيْنُ بْنُ إِسْحَاقَ وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالُوا :  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  يَحْيَى بْنِ حَسَّانَ ،  عَنْ  رَبِيعَةَ بْنِ عَامِرِ بْنِ بِجَادٍ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَلِظُّوا  بِيَا ذَا  الْجَلَالِ  وَالْإِكْرَامِ  .","","Al-Mu'jam al-Kabir 4594","","ربيعة بن عامر الأزدي عن يحيى بن حسان العسقلاني عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ربيعة بن عامر بن بجاد"
"4597","450 -  رَبِيعَةُ بْنُ الْفَضْلِ بْنِ حَبِيبٍ الْأَنْصَارِيُّ ،  "" اسْتُشْهِدَ  يَوْمَ أُحُدٍ  ""  4595  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ أُحُدٍ  مِنَ  الْأَنْصَارِ ،  ثُمَّ مِنْ  بَنِي مُعَاوِيَةَ بْنِ عَوْفٍ ،  رَبِيعَةُ بْنُ الْفَضْلِ بْنِ حَبِيبِ بْنِ زَيْدِ بْنِ تَمِيمٍ  .","","Al-Mu'jam al-Kabir 4595","","","ربيعة بن الفضل بن حبيب الأنصاري"
"4598","451 -  رَبِيعَةُ بْنُ الْغَازِ الْجُرَشِيُّ ، وَيُقَالُ ابْنُ عَمْرٍو ،  وَهُوَ جَدُّ  هِشَامِ بْنِ الْغَازِ         [5/65]      4596  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  الْحَارِثُ بْنُ يَزِيدَ  أَنَّهُ سَمِعَ  رَبِيعَةَ الْجُرَشِيَّ يَقُولُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اسْتَقِيمُوا وَنِعِمَّا إِنِ اسْتَقَمْتُمْ ، وَحَافِظُوا عَلَى الْوُضُوءِ فَإِنَّ خَيْرَ عَمَلِكُمُ الصَّلَاةُ  ، وَتَحَفَّظُّوا مِنَ الْأَرْضِ فَإِنَّهَا أُمُّكُمْ ، وَإِنَّهُ لَيْسَ مِنْ أَحَدٍ عَامِلٍ عَلَيْهَا خَيْرًا أَوْ شَرًّا إِلَّا وَهِيَ مُخْبِرَةٌ  .","","Al-Mu'jam al-Kabir 4596","","ربيعة بن عمرو الجرشي عن الحارث بن يزيد الحضرمي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","ربيعة بن الغاز الجرشي"
"4599","4597  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدِ بْنِ سَلَّامٍ (  ح  ) .  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي النَّضْرِ - قَالَا :  ثَنَا  رَيْحَانُ بْنُ سَعِيدٍ ،  عَنْ  عَبَّادِ بْنِ مَنْصُورٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  عَطِيَّةَ  أَنَّهُ سَمِعَ  رَبِيعَةَ الْجُرَشِيَّ يَقُولُ :  إِنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُتِيَ فَقِيلَ لَهُ : لِتَنَمْ عَيْنُكَ وَلْتَسْمَعْ أُذُنُكَ وَلْيَعْقِلْ قَلْبُكَ . قَالَ :  فَنَامَتْ عَيْنِي ، وَسَمِعَتْ أُذُنِي ، وَعَقَلَ قَلْبِي  . قَالَ : فَقِيلَ لَهُ : "" سَيِّدٌ بَنَى دَارًا وَصَنَعَ مَأْدُبَةً فَأَرْسَلَ دَاعِيًا ، فَمَنْ أَجَابَ الدَّاعِيَ دَخَلَ الدَّارَ وَأَكَلَ مِنَ الْمَأْدُبَةِ وَرَضِيَ عَنْهُ السَّيِّدُ ، وَمَنْ لَمْ يُجِبِ الدَّاعِيَ لَمْ يَدْخُلِ الدَّارَ وَلَمْ يَنَلِ الْمَأْدُبَةَ  وَسَخِطَ  عَلَيْهِ السَّيِّدُ ، فَالسَّيِّدُ اللهُ ، وَالدَّاعِي  مُحَمَّدٌ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَالْمَأْدُبَةُ الْجَنَّةُ  .","","Al-Mu'jam al-Kabir 4597","","ربيعة بن عمرو الجرشي عن عطية بن قيس الكلابي عن أبو قلابة الجرمي عن أيوب السختياني عن عباد بن منصور الناجي عن ريحان بن سعيد الناجي عن أبو بكر بن النضر بن أبي النضر البغدادي عن عبد الله بن أحمد الجواليقي عن الطبراني","ربيعة بن الغاز الجرشي"
"4600","4598  -  حَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ أَبِي السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي جَعْفَرٍ ،  عَنْ  رَجُلٍ  حَدَّثَهُ عَنْ  رَبِيعَةَ الْجُرَشِيِّ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ كَتَمَ غَلُولًا فَهُوَ مِثْلُهُ  .","","Al-Mu'jam al-Kabir 4598","","ربيعة بن عمرو الجرشي عن رجل عن عبيد الله بن أبي جعفر الكناني عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن عمرو بن أبي الطاهر المصري عن الطبراني","ربيعة بن الغاز الجرشي"
"4601","[5/66]      452 -  رَبِيعَةُ بْنُ أَكْثَمَ الْأَسَدِيُّ ،  "" حَلِيفُ  بَنِي عَبْدِ شَمْسِ بْنِ عَبْدِ مَنَافٍ ،  شَهِدَ  بَدْرًا  "" .  4599  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنْ حُلَفَاءِ  بَنِي عَبْدِ شَمْسِ بْنِ عَبْدِ مَنَافٍ  ،  رَبِيعَةُ بْنُ أَكْثَمَ  ، مِنْ  بَنِي أَسَدِ بْنِ خُزَيْمَةَ  .","","Al-Mu'jam al-Kabir 4599","","","ربيعة بن أكثم الأسدي"
"4602","4600  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنْ  بَنِي عَبْدِ شَمْسٍ  ،  رَبِيعَةُ بْنُ أَكْثَمَ  حَلِيفٌ لَهُمْ مِنْ  بَنِي أَسَدٍ  .","","Al-Mu'jam al-Kabir 4600","","","ربيعة بن أكثم الأسدي"
"4603","4601  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ أُحُدٍ  مِنَ الْمُسْلِمِينَ ، ثُمَّ مِنْ  قُرَيْشٍ  ،  رَبِيعَةُ بْنُ أَكْثَمَ  حَلِيفُ  بَنِي عَبْدِ شَمْسٍ  ، مِنْ  بَنِي أَسَدٍ  .","","Al-Mu'jam al-Kabir 4601","","","ربيعة بن أكثم الأسدي"
"4604","453 -  رَبِيعَةُ بْنُ رُوَاءٍ الْعَنْسِيُّ  4602  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  حَدَّثَنِي  عِيسَى بْنُ مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  أَنَّ  رَبِيعَةَ بْنَ رُوَاءٍ الْعَنْسِيَّ  قَدِمَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَجَدَهُ يَتَعَشَّى ، فَدَعَاهُ إِلَى الْعَشَاءِ فَأَكَلَ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَتَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ  ؟ "" ، قَالَ  رَبِيعَةُ  : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ . قَالَ : "" رَاغِبًا أَمْ رَاهِبًا ؟ "" ، قَالَ  رَبِيعَةُ  : أَمَّا الرَّغْبَةُ فَوَاللهِ مَا هِي فِي يَدِكَ ، وَأَمَّا الرَّهْبَةُ فَوَاللهِ أَنَا بِبِلَادٍ مَا يَبْلُغُنَا جُيُوشُكَ وَلَا خُيُولُكَ ، وَلَكِنِّي خُوِّفْتُ فَخِفْتُ ، وَقِيلَ لِي آمِنْ فَآمَنْتُ ! فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [5/67]      "" رُبَّ خَطِيبٍ مِنْ  عَنْسٍ  "" ، فَأَقَامَ يَخْتَلِفُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ جَاءَهُ فَوَدَّعَهُ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" إِنْ  أَحْسَسْتَ  حِسًّا  فَوَائِلْ إِلَى أَهْلِ الْقَرْيَةِ "" ، فَخَرَجَ  فَأَحَسَّ  حِسًّا  فَوَاءَلَ إِلَى قَرْيَةٍ فَمَاتَ بِهَا .","","Al-Mu'jam al-Kabir 4602","","أبو بكر بن محمد الخزرجي عن عبد الله بن أبي بكر بن محمد  ابن حزم عن أبيه عن عيسى بن محمد بن عبد العزيز عن محمد بن إسماعيل بن عياش العنسي عن هاشم بن مرثد الطيالسي عن الطبراني","ربيعة بن رواء العنسي"
"4605","454 -  رَبِيعَةُ بْنُ أُمَيَّةَ بْنِ خَلَفٍ الْجُمَحِيُّ  4603  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  يَحْيَى بْنُ عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ  رَبِيعَةُ بْنُ أُمَيَّةَ بْنِ خَلَفٍ الْجُمَحِيُّ  هُوَ الَّذِي يَصْرُخُ  يَوْمَ عَرَفَةَ  تَحْتَ  لَبَّةِ  نَاقَةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اصْرُخْ - وَكَانَ  صَيِّتًا  - أَيُّهَا النَّاسُ ، أَتَدْرُونَ أَيُّ شَهْرٍ هَذَا ؟ "" ، فَصَرَخَ فَقَالُوا : نَعَمِ ،  الشَّهْرُ  الْحَرَامُ ! قَالَ :  فَإِنَّ اللهَ قَدْ حَرَّمَ عَلَيْكُمْ دِمَاءَكُمْ وَأَمْوَالَكُمْ إِلَى أَنْ تَلْقَوْا رَبَّكُمْ  كَحُرْمَةِ  شَهْرِكُمْ هَذَا  ، ثُمَّ قَالَ : "" اصْرُخْ ، هَلْ تَدْرُونَ أَيُّ بَلَدٍ هَذَا ؟ "" ، فَصَرَخَ ، قَالُوا : نَعَمِ ،  الْبَلَدُ الْحَرَامُ !  قَالَ : "" فَإِنَّ دِمَاءَكُمْ وَأَمْوَالَكُمْ عَلَيْكُمْ حَرَامٌ إِلَى يَوْمِ تَلْقَوْنَهُ  كَحُرْمَةِ  بَلَدِكُمْ هَذَا "" ، ثُمَّ قَالَ : "" اصْرُخْ ، أَيُّ يَوْمٍ هَذَا ؟ "" فَصَرَخَ ، قَالُوا : نَعَمْ ، هَذَا يَوْمٌ حَرَامٌ ، وَهَذَا يَوْمُ  الْحَجِّ  الْأَكْبَرِ  ! قَالَ : "" فَإِنَّ اللهَ - عَزَّ وَجَلَّ - قَدْ حَرَّمَ عَلَيْكُمْ دِمَاءَكُمْ وَأَمْوَالَكُمْ إِلَى يَوْمِ تَلْقَوْنَهُ  كَحُرْمَةِ  يَوْمِكُمْ هَذَا  .","","Al-Mu'jam al-Kabir 4603","","عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن يونس بن بكير عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ربيعة بن أمية بن خلف"
"4606","455 -  رَبِيعٌ الْجَرْمِيُّ  4604  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  سَلَمَةُ بْنُ رَجَاءٍ ،  ثَنَا  سَلْمُ بْنُ عَبْدِ الرَّحْمَنِ الْجَرْمِيُّ ،  عَنْ  سَوَادَةَ بْنِ الرَّبِيعِ قَالَ :  انْطَلَقْتُ أَنَا وَأَبِي إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَمَرَ لَنَا بِذَوْدَيْنِ ، وَقَالَ :  مُرْ بَيْتَكَ         [5/68]      فَلْيُقَلِّمُوا أَظَافِيرَهُمْ ، لَا يَعْقِرُوا بِهَا ضُرُوعَ مَوَاشِيهِمْ إِذَا حَلَبُوا  .","","Al-Mu'jam al-Kabir 4604","","سوادة ، وقيل عن سلم بن عبد الرحمن الجرمي عن سلمة بن رجاء التميمي عن قاسم بن محمد بن أبي شيبة العبسي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ربيع الجرمي"
"4607","456 -  رَبِيعُ بْنُ إِيَاسٍ الْأَنْصَارِيُّ ، بَدْرِيٌّ  4605  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  مِنْ  بَنِي لَوْذَانَ بْنِ غَنْمِ بْنِ عَوْفِ بْنِ الْخَزْرَجِ ،  رَبِيعُ بْنُ إِيَاسِ بْنِ غَنْمِ بْنِ أُمَيَّةَ بْنِ لَوْذَانَ بْنِ غَنْمٍ  .","","Al-Mu'jam al-Kabir 4605","","","ربيع بن إياس"
"4608","4606  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ ،  ثُمَّ مِنْ  بَنِي عَوْفِ بْنِ الْخَزْرَجِ  ،  ثُمَّ مِنْ  بَنِي بَلْحُبْلَى ،  رَبِيعُ بْنُ إِيَاسٍ  .","","Al-Mu'jam al-Kabir 4606","","","ربيع بن إياس"
"4609","457 -  رَبِيعٌ الْأَنْصَارِيُّ  4607  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامِ بْنِ حَفْصِ بْنِ غِيَاثٍ وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ - قَالَا :  ثَنَا  جَرِيرٌ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  رَبِيعٍ الْأَنْصَارِيِّ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَادَ  ابْنَ أَخِي جَبْرٍ الْأَنْصَارِيَّ  ، فَجَعَلَ أَهْلُهُ يَبْكُونَ عَلَيْهِ ، فَقَالَ لَهُمْ  جَبْرٌ  : لَا تُؤْذُوا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَعْهُنَّ فَلْيَبْكِينَ مَا دَامَ حَيًّا ، فَإِذَا وَجَبَ فَلْيَسْكُتْنَ  ، فَقَالَ بَعْضُهُمْ : مَا كُنَّا نَرَى أَنْ يَكُونَ مَوْتُكَ عَلَى فِرَاشِكَ حَتَّى تُقْتَلَ فِي  سَبِيلِ  اللهِ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَوَمَا الشَّهَادَةُ إِلَّا فِي الْقَتْلِ فِي  سَبِيلِ  اللهِ ! إِنَّ شُهَدَاءَ أُمَّتِي إِذَنْ لَقَلِيلٌ ، إِنَّ الطَّعْنَ وَالطَّاعُونَ شَهَادَةٌ ، وَالْبَطْنَ شَهَادَةٌ ، وَالنُّفَسَاءَ بِجُمُعٍ شَهَادَةٌ ، وَالْحَرْقَ شَهَادَةٌ ،  وَالْغَرَقَ  شَهَادَةٌ ، وَالْهَدْمَ شَهَادَةٌ ، وَذَاتَ  الْجَنْبِ  شَهَادَةٌ  .","","Al-Mu'jam al-Kabir 4607","","الربيع الزرقي عن عبد الملك بن عمير القبطي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ربيع الأنصاري"
"4610","[5/69]      458 -  رَبِيعُ بْنُ زَيْدٍ ،  غَيْرُ مَنْسُوبٍ .  4608  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  ثَنَا  دَاوُدُ بْنُ عَبْدِ اللهِ الْأَوْدِيُّ  أَنَّهُ سَمِعَ  وَبَرَةَ أَبَا كُرْزٍ يُحَدِّثُ  أَنَّهُ سَمِعَ  رَبِيعَ بْنَ زِيَادٍ يَقُولُ :  بَيْنَمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسِيرُ إِذْ بَصَرَ  شَابًّا مِنْ قُرَيْشٍ  يَسِيرُ مُعْتَزِلًا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" أَلَيْسَ ذَاكَ فُلَانٌ ؟ "" ، قَالُوا : نَعَمْ . قَالَ : "" فَادْعُوهُ "" ، فَجَاءَ فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا لَكَ اعْتَزَلْتَ عَنِ الطَّرِيقِ ؟ "" ، قَالَ : كَرِهْتُ الْغُبَارَ . قَالَ :  فَلَا تَعْتَزِلْهُ ، فَوَالَّذِي نَفْسِي بِيَدِهِ إِنَّهُ  لَذَرِيرَةُ  الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 4608","","الربيع بن زياد الخزاعي عن وبرة الحارثي عن داود بن عبد الله الزعافري عن زهير بن معاوية بن حديج عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ربيع بن زيد"
"4611","459 -  رِبْعِيُّ بْنُ عَمْرٍو الْأَنْصَارِيُّ  4609  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ،  ثَنَا  ضِرَارُ بْنُ صُرَدٍ  ،  ثَنَا  عَلِيُّ بْنُ هَاشِمٍ  ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ  ،  عَنْ  أَبِيهِ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ مَعَ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ  - مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رِبْعِيُّ بْنُ عَمْرٍو ، بَدْرِيٌّ  .","","Al-Mu'jam al-Kabir 4609","","","ربعي بن عمرو"
"4612","460 -  رِبْعِيُّ بْنُ رَافِعٍ الْأَنْصَارِيُّ ، بَدْرِيٌّ  4610  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ،  ثَنَا  ضِرَارُ بْنُ صُرَدٍ  ،  ثَنَا  عَلِيُّ بْنُ هَاشِمٍ  ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ  ،  عَنْ  أَبِيهِ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ مَعَ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ  ،  رِبْعِيُّ بْنُ رَافِعٍ  ، مِنْ  بَنِي عَمْرِو بْنِ عَوْفٍ ،  [ بَدْرِيٌّ ]  .","","Al-Mu'jam al-Kabir 4610","","","ربعي بن رافع"
"4613","[5/70]      461 -  رِبْعِيُّ بْنُ أَبِي رِبْعِيٍّ الْأَنْصَارِيُّ ، بَدْرِيٌّ  .  4611  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  مِنْ  بَنِي الْعَجْلَانِ  ،  رِبْعِيُّ بْنُ أَبِي رِبْعِيٍّ  .","","Al-Mu'jam al-Kabir 4611","","","ربعي بن أبي ربعي"
"4614","462 -  رُكَانَةُ بْنُ عَبْدِ يَزِيدَ بْنِ هَاشِمِ بْنِ الْمُطَّلِبِ بْنِ عَبْدِ مَنَافِ بْنِ قُصَيِّ بْنِ كِلَابِ بْنِ مُرَّةَ بْنِ كَعْبِ بْنِ لُؤَيِّ بْنِ غَالِبِ بْنِ فِهْرٍ ،  ""  وَأُمُّهُ بِنْتُ الْعَجْلَانِ  ، مِنْ  بَنِي سَعْدِ بْنِ لَيْثِ بْنِ بَكْرِ بْنِ كِنَانَةَ ،  يُقَالُ : إِنَّهُ بَقِيَ إِلَى زَمَنِ  عُثْمَانَ بْنِ عَفَّانَ  رَضِيَ اللهُ عَنْهُمَا "" .  4612  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَاوِيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  أَبُو الرَّبِيعُ الزَّهْرَانِيُّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ - قَالُوا :  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  ثَنَا  الزُّبَيْرُ بْنُ سَعِيدٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَلِيِّ بْنِ يَزِيدَ بْنِ رُكَانَةَ فَأَتَيْتُهُ فِي قَرْيَةٍ  فَحَدَّثَنِي  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّهُ طَلَّقَ  امْرَأَتَهُ  الْبَتَّةَ  فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَأَلَهُ ، فَقَالَ لَهُ :  مَا نَوَيْتَ ؟ "" ، قَالَ : وَاحِدَةً ! قَالَ : "" آللهِ "" ، قَالَ : آللهِ !  قَالَ : "" هُوَ مَا نَوَيْتَ  .","","Al-Mu'jam al-Kabir 4612","","ركانة بن عبد يزيد المطلبي عن علي بن يزيد بن ركانة المطلبي عن عبد الله بن علي بن يزيد بن ركانة المطلبي عن الزبير بن سعيد الهاشمي عن جرير بن حازم عن شيبان بن فروخ الحبطي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ركانة بن عبد يزيد بن هاشم بن المطلب"
"4615","4613  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنِ  الزُّبَيْرِ بْنِ سَعِيدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَلِيِّ بْنِ السَّائِبِ ،  عَنْ  جَدِّهِ رُكَانَةَ بْنِ عَبْدِ يَزِيدَ  أَنَّهُ طَلَّقَ امْرَأَتَهُ  الْبَتَّةَ  فَأَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ         [5/71]      لَهُ ، فَقَالَ لَهُ :  مَا أَرَدْتَ بِهَا ؟ "" قَالَ : وَاحِدَةً ! قَالَ : "" آللهِ مَا أَرَدْتَ بِهَا إِلَّا وَاحِدَةً  ؟ "" ، قَالَ : آللهِ مَا أَرَدْتُ بِهَا إِلَّا وَاحِدَةً ! فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هِيَ وَاحِدَةٌ  .","","Al-Mu'jam al-Kabir 4613","","ركانة بن عبد يزيد المطلبي عن عبد الله بن علي بن السائب المطلبي عن الزبير بن سعيد الهاشمي عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ركانة بن عبد يزيد بن هاشم بن المطلب"
"4616","4614  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ، قَالَا :  ثَنَا  أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ،  ثَنَا  مُحَمَّدُ بْنُ رَبِيعَةَ الْكِلَابِيُّ قَالَ : لَقِيتُ رَجُلًا  بِمَكَّةَ  مِنْ  أَهْلِ عَسْقَلَانَ  يُقَالُ لَهُ أَبُو الْحَسَنِ ،  فَحَدَّثَنِي  عَنْ  أَبِي جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنِ  ابْنِ رُكَانَةَ ،  عَنْ  أَبِيهِ  أَنَّ  رُكَانَةَ  صَارَعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَرَعَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَ  رُكَانَةُ  : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  فَرْقُ مَا بَيْنَنَا وَبَيْنَ الْمُشْرِكِينَ الْعَمَائِمُ عَلَى الْقَلَانِسِ  .","","Al-Mu'jam al-Kabir 4614","","ركانة بن عبد يزيد المطلبي عن محمد بن ركانة بن عبد يزيد القرشي عن أبو جعفر بن محمد بن ركانة القرشي عن أبو الحسن العسقلاني عن محمد بن ربيعة بن سمير الرؤاسي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ركانة بن عبد يزيد بن هاشم بن المطلب"
"4617","463 -  رَكْبٌ الْمِصْرِيُّ  .  4615  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  يُوسُفُ بْنُ عَدِيٍّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَنْبَسَةَ بْنِ سَعِيدِ بْنِ غُنَيْمٍ الْكَلَاعِيِّ ،  عَنْ  نَصِيحٍ ،  عَنْ  رَكْبٍ الْمِصْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  طُوبَى لِمَنْ تَوَاضَعَ مِنْ غَيْرِ مَنْقَصَةٍ ، وَذَلَّ فِي نَفْسِهِ مِنْ غَيْرِ مَسْكَنَةٍ ،  وَأَنْفَقَ مَالًا جَمَعَهُ مِنْ غَيْرِ مَعْصِيَةٍ ، وَرَحِمَ الْمَسَاكِينَ أَهْلَ الْمَسْكَنَةِ ، وَخَالَطَ أَهْلَ الْفِقْهِ وَالْحِكْمَةِ ، طُوبَى لِمَنْ ذَلَّ فِي نَفْسِهِ وَطَابَ كَسْبُهُ ، وَأَصْلَحَ سَرِيرَتَهُ وَعَزَلَ عَنِ النَّاسِ شَرَّهُ ، طُوبَى لِمَنْ عَمِلَ بِعِلْمِهِ وَأَنْفَقَ الْفَضْلَ مِنْ مَالِهِ ، وَأَمْسَكَ الْفَضْلَ مِنْ قَوْلِهِ  .","","Al-Mu'jam al-Kabir 4615","","ركب المصري عن نصيح العنسي عن عنبسة بن سعيد بن غنيم الكلاعي عن إسماعيل بن عياش الأحول عن يوسف بن عدي بن رزق الكوفي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","ركب المصري"
"4618","4616  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ         [5/72]      عَيَّاشٍ ،  ثَنَا  الْمُطْعِمُ بْنُ الْمِقْدَامِ ،  عَنْ  نَصِيحٍ الْعَنْسِيِّ ،  عَنْ  رَكْبٍ الْمِصْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  طُوبَى لِمَنْ تَوَاضَعَ مِنْ غَيْرِ مَنْقَصَةٍ ، وَذَلَّ فِي نَفْسِهِ مِنْ غَيْرِ مَسْكَنَةٍ  ، وَأَنْفَقَ مَالًا جَمَعَهُ فِي غَيْرِ مَعْصِيَةٍ ، وَرَحِمَ أَهْلَ الذُّلِّ وَالْمَسْكَنَةِ ، وَخَالَطَ أَهْلَ الْفِقْهِ وَالْحِكْمَةِ ، طُوبَى لِمَنْ طَابَ كَسْبُهُ وَصَلُحَتْ سَرِيرَتُهُ وَكَرُمَتْ عَلَانِيَتُهُ وَعَزَلَ عَنِ النَّاسِ شَرَّهُ ، طُوبَى لِمَنْ عَمِلَ بِعِلْمٍ وَأَنْفَقَ الْفَضْلَ مِنْ مَالِهِ وَأَمْسَكَ الْفَضْلَ مِنْ قَوْلِهِ  .","","Al-Mu'jam al-Kabir 4616","","ركب المصري عن نصيح العنسي عن مطعم بن المقدام الصنعاني عن إسماعيل بن عياش الأحول عن هشام بن عمار عن عبد الله بن أحمد الجواليقي عن الطبراني","ركب المصري"
"4619","464 -  رَبَاحُ بْنُ الرَّبِيعِ الْأُسَيِّدِيُّ ، "" أَخُو حَنْظَلَةَ الْكَاتِبِ  "" .  4617  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  حَدَّثَنَا  ابْنُ أَبِي الزِّنَادِ ،  أَخْبَرَنِي  أَبِي  ،  أَنَا  الْمُرَقِّعُ بْنُ صَيْفِيٍّ - قَالَ  ابْنُ أَبِي مَرْيَمَ :  أَظُنُّهُ  عَنْ  أَبِيهِ  أَنَّ جَدَّهُ  رَبَاحَ بْنَ رَبِيعٍ أَخَا حَنْظَلَةَ الْكَاتِبِ  أَخْبَرَهُ  أَنَّهُ خَرَجَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزْوَةٍ غَزَاهَا كَانَ عَلَى  مُقَدِّمَتِهِ  فِيهَا  خَالِدُ بْنُ الْوَلِيدِ ،  فَمَرَّ  رَبَاحٌ  وَأَصْحَابُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  امْرَأَةٍ  مَقْتُولَةٍ مِمَّا أَصَابَتِ  الْمُقَدِّمَةُ  ، فَوَقَفُوا عَلَيْهَا يَنْظُرُونَ إِلَيْهَا وَيَعْجَبُونَ مِنْ خَلْقِهَا ، حَتَّى لَحِقَهُمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى نَاقَةٍ لَهُ ، فَتَفَرَّجُوا عَنِ الْمَرْأَةِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا كَانَتْ هَذِهِ تُقَاتِلُ "" ، ثُمَّ نَظَرَ فِي وُجُوهِ  الْقَوْمِ  فَقَالَ  لِأَحَدِهِمُ  :  الْحَقْ  خَالِدَ بْنَ الْوَلِيدِ  فَلَا يَقْتُلَنَّ  ذُرِّيَّةً  وَلَا  عَسِيفًا  .","","Al-Mu'jam al-Kabir 4617","","رباح بن الربيع الأسيدي عن أبو مرقع بن صيفي الحنظلي عن مرقع بن صيفي الحنظلي عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن الحكم الجمحي عن يوسف بن يزيد القراطيسي عن الطبراني","رباح بن الربيع"
"4620","4618  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  أَنَا  ابْنُ وَهْبٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  حَدَّثَنِي  الْمُرَقِّعُ بْنُ صَيْفِيٍّ أَنَّ جَدَّهُ  رَبَاحَ بْنَ رَبِيعٍ أَخَا حَنْظَلَةَ الْكَاتِبِ  أَخْبَرَهُ  أَنَّهُ خَرَجَ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ثُمَّ ذَكَرَ مِثْلَهُ  .","","Al-Mu'jam al-Kabir 4618","","رباح بن الربيع الأسيدي عن مرقع بن صيفي الحنظلي عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن عبد الله بن وهب المصري عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","رباح بن الربيع"
"4621","4619  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي الزِّنَادِ ،  حَدَّثَهُ  عَنِ  الْمُرَقِّعِ بْنِ صَيْفِيٍّ ،  عَنْ  جَدِّهِ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 4619","","رباح بن الربيع الأسيدي عن مرقع بن صيفي الحنظلي عن أبو الزناد عن المغيرة بن عبد الرحمن بن عبد الله الحزامي عن سعيد بن الحكم الجمحي عن يوسف بن يزيد القراطيسي عن الطبراني","رباح بن الربيع"
"4622","4620  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ         [5/73]      الْكَرَابِيسِيُّ ،  ثَنَا  الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنْ  مُرَقِّعِ بْنِ صَيْفِيٍّ ،  عَنْ  جَدِّهِ رَبَاحِ بْنِ الرَّبِيعِ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزْوَةٍ وَعَلَى  مُقَدِّمَةِ  النَّاسِ  خَالِدُ بْنُ الْوَلِيدِ ،  فَإِذَا  امْرَأَةٌ  مَقْتُولَةٌ عَلَى الطَّرِيقِ يَتَعَجَّبُونَ مِنْ خَلْقِهَا قَدْ أَصَابَتْهَا  الْمُقَدِّمَةُ  ، فَأَتَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَقَفَ عَلَيْهَا ، ثُمَّ قَالَ  لِرَجُلٍ  :  أَدْرِكْ  خَالِدَ بْنَ الْوَلِيدِ  فَقُلْ لَا يَقْتُلَنَّ  ذُرِّيَّةً  وَلَا  عَسِيفًا  .","","Al-Mu'jam al-Kabir 4620","","رباح بن الربيع الأسيدي عن مرقع بن صيفي الحنظلي عن أبو الزناد عن المغيرة بن عبد الرحمن بن عبد الله الحزامي عن سعيد بن عبد الجبار الكرابيسي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رباح بن الربيع"
"4623","4621  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ وَالْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ قَالَا :  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  عُمَرُ بْنُ الْمُرَقِّعِ بْنِ رَبَاحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ رَبَاحِ بْنِ الرَّبِيعِ  قَالَ :  كُنَّا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزَاةٍ ، فَإِذَا النَّاسُ مُجْتَمِعُونَ عَلَى  امْرَأَةٍ  مَقْتُولَةٍ ، فَقَالَ : "" مَا كَانَتْ هَذِهِ تُقَاتِلُ "" ، فَقَالَ : "" مَنْ عَلَى  الْمُقَدِّمَةِ  ؟ "" ، قَالُوا :  خَالِدُ بْنُ الْوَلِيدِ  . فَبَعَثَ إِلَيْهِ  رَجُلًا  فَقَالَ :  مُرْ  خَالِدًا  لَا يَقْتُلْ  ذُرِّيَّةً  وَلَا  عَسِيفًا  .","","Al-Mu'jam al-Kabir 4621","","رباح بن الربيع الأسيدي عن مرقع بن صيفي الحنظلي عن عمر بن المرقع التميمي عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","رباح بن الربيع"
"4624","4622  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ الْعَطَّارُ  ، ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  الْفَضْلُ بْنُ سُلَيْمَانَ  ،  ثَنَا  مُوسَى بْنُ عُقْبَةَ ،  حَدَّثَنِي  الْمُرَقَّعُ أَنَّهُ شَهِدَ عَلَى جَدِّهِ رَبَاحِ بْنِ الرَّبِيعِ الْحَنْظَلِيِّ أَنَّهُ  أَخْبَرَهُ  أَنَّهُ خَرَجَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزْوَةٍ ، وَكَانَ  الْمُقَدِّمَةُ  خَالِدَ بْنَ الْوَلِيدِ ،  فَمَرَّ  رَبَاحٌ  وَأَصْحَابُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  امْرَأَةٍ  قَتِيلَةٍ قَتَلَتْهَا  الْمُقَدِّمَةُ  ، فَاجْتَمَعُوا عَلَيْهَا يَنْظُرُونَ إِلَيْهَا وَإِلَى خَلْقِهَا وَيَتَعَجَّبُونَ مِنْهَا ، حَتَّى جَاءَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَتَفَرَّجُوا ، فَنَظَرَ إِلَيْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : "" مَا كَانَتْ هَذِهِ تُقَاتِلُ "" ، فَنَظَرَ فِي وُجُوهِ  الْقَوْمِ  ثُمَّ قَالَ  لِأَحَدِهِمْ  :  أَدْرِكْ  خَالِدَ بْنَ الْوَلِيدِ  فَقُلْ لَا تَقْتُلَنَّ  ذُرِّيَّةً  وَلَا  عَسِيفًا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( الفضيل )","","Al-Mu'jam al-Kabir 4622","","رباح بن الربيع الأسيدي عن مرقع بن صيفي الحنظلي عن موسى بن عقبة عن فضيل بن سليمان النميري عن فضيل بن حسين الجحدري عن سليمان بن الحسن العطار عن الطبراني","رباح بن الربيع"
"4625","4623  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ وَزَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالَا :  ثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ إِدْرِيسَ ،  عَنْ  عُمَرَ بْنِ مُرَقَّعٍ ،  عَنْ  قَيْسِ بْنِ زُهَيْرٍ ،  عَنْ  رَبَاحِ بْنِ رَبِيعِ بْنِ مُرَقَّعِ بْنِ صَيْفِيٍّ قَالَ :  غَزَوْنَا مَعَ رَسُولِ اللهِ         [5/74]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ قَدْ أَعْطَى كُلَّ ثَلَاثَةٍ مِنَّا بَعِيرًا يَرْكَبُهُ اثْنَانِ وَيَسُوقُ وَاحِدٌ فِي الصَّحَارِي وَنَقُودُ فِي الْجِبَالِ ، فَمَرَّ بِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا أَمْشِي ، فَقَالَ لِي : "" أَرَاكَ يَا  رَبَاحُ  مَاشِيًا "" ، فَقُلْتُ : إِنَّمَا نَزَلْتُ السَّاعَةَ ، وَهَذَانِ صَاحِبَايَ قَدْ رَكِبَا ! فَمَضَى ، فَمَرَّ بِصَاحِبَيَّ فَأَنَاخَا بَعِيرَهُمَا وَنَزَلَا عَنْهُ ، فَلَمَّا انْتَهَيْتُ قَالَا : ارْكَبْ صَدْرَ هَذَا الْبَعِيرِ ، فَلَا تَزَالُ عَلَيْهِ حَتَّى نَرْجِعَ  وَنَعْتَقِبُ  أَنَا وَصَاحِبِي ! قُلْتُ : وَلِمَ ؟ قَالَا : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لَكُمَا رَفِيقًا صَالِحًا ، فَأَحْسِنَا صُحْبَتَهُ  .","","Al-Mu'jam al-Kabir 4623","","رباح بن الربيع الأسيدي عن قيس بن زهير عن عمر بن المرقع التميمي عن عبد الله بن إدريس الأودي عن سفيان بن وكيع بن الجراح عن الساجي عن الطبراني","رباح بن الربيع"
"4626","465 -  رَبَاحٌ اللَّخْمِيُّ ، "" جَدُّ مُوسَى بْنِ عُلَيٍّ  ""  4624  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ أَبُو زَكَرِيَّا الدِّينَوَرِيُّ الْبَصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ مُحَمَّدِ بْنِ بَوَّابٍ الْحُصْرِيُّ ،  حَدَّثَنَا  مُطَهَّرُ بْنُ الْهَيْثَمِ الطَّائِيُّ ،  ثَنَا  مُوسَى بْنُ عُلَيٍّ بْنِ رَبَاحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهُ : "" مَا وُلِدَ لَكَ ؟ "" ، قَالَ : يَا رَسُولَ اللهِ ، وَمَا عَسَى أَنْ يُولَدَ لِي ؟ إِمَّا غُلَامٌ وَإِمَّا جَارِيَةٌ ! قَالَ : "" فَمَنْ يُشْبِهُ ؟ "" قَالَ : مَا عَسَى أَنْ يُشْبِهَ ؟ إِمَّا أُمَّهُ وَإِمَّا أَبَاهُ ! فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" هَامَهْ لَا تَقُولَنَّ كَذَلِكَ ،  إِنَّ  النُّطْفَةَ  إِذَا اسْتَقَرَّتْ فِي الرَّحِمِ أَحْضَرَهَا اللهُ - عَزَّ وَجَلَّ  - كُلَّ نَسَبٍ بَيْنَهَا وَبَيْنَ  آدَمَ  ، أَمَا قَرَأْتَ هَذِهِ الْآيَةَ فِي كِتَابَ اللهِ عَزَّ وَجَلَّ :         {      فِي أَيِّ صُورَةٍ مَا شَاءَ رَكَّبَكَ         }      .","","Al-Mu'jam al-Kabir 4624","","رباح بن قصير اللخمي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن مطهر بن الهيثم الطائي عن الحصرى سعيد بن محمد بن ثواب البصري عن يحيى بن عبد الله أبو زكريا الدينوري البصري عن الطبراني","رباح اللخمي"
"4627","4625  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ أَبُو زَكَرِيَّا الدِّينَوَرِيُّ الْبَصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ مُحَمَّدِ بْنِ بَوَّابٍ الْحُصْرِيُّ ،  ثَنَا  مُطَهَّرُ بْنُ الْهَيْثَمِ الطَّائِيُّ ،  ثَنَا  مُوسَى بْنُ عُلَيٍّ بْنِ رَبَاحٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ  مِصْرَ  سَتُفْتَحُ ، فَانْتَجِعُوا خَيْرَهَا وَلَا تَتَّخِذُوهَا دَارًا ،  إِنَّهُ يُسَاقُ إِلَيْهَا أَقَلُّ النَّاسِ أَعْمَارًا  .","","Al-Mu'jam al-Kabir 4625","","رباح بن قصير اللخمي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن مطهر بن الهيثم الطائي عن الحصرى سعيد بن محمد بن ثواب البصري عن يحيى بن عبد الله أبو زكريا الدينوري البصري عن الطبراني","رباح اللخمي"
"4628","[5/75]      466 -  رَبَاحٌ ، مَوْلَى النَّبِيِّ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  4626  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ وَعُثْمَانُ بْنُ أَبِي شَيْبَةَ قَالَا :  ثَنَا  وَكِيعٌ ،  عَنْ  عِكْرِمَةَ بْنِ عَمَّارٍ ،  عَنْ  إِيَاسِ بْنِ سَلَمَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كَانَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غُلَامٌ اسْمُهُ  رَبَاحٌ  .","","Al-Mu'jam al-Kabir 4626","","سلمة بن عمرو بن الأكوع الأسلمي عن إياس بن سلمة بن الأكوع الأسلمي عن عكرمة بن عمار عن وكيع بن الجراح عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رباح مولى النبي صلى الله عليه وسلم"
"4629","4627  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  سُفْيَانُ بْنُ وَكِيعٍ ،  ثَنَا  أَبِي  ،  ثَنَا  نَافِعُ بْنُ عُمَرَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنِ  ابْنِ عُمَرَ ،  أَخْبَرَنِي  بِلَالٌ قَالَ :  كَانَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غُلَامٌ اسْمُهُ  رَبَاحٌ  .","","Al-Mu'jam al-Kabir 4627","","بلال بن رباح سابق الحبشة عن عبد الله بن عمر بن الخطاب عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن وكيع بن الجراح عن سفيان بن وكيع بن الجراح عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رباح مولى النبي صلى الله عليه وسلم"
"4630","467 -  رَبَاحٌ الْأَنْصَارِيُّ ، "" مَوْلَى بَنِي جَحْجَبَى  ، اسْتُشْهِدَ  يَوْمَ الْيَمَامَةِ  ""  4628  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ قُتِلَ  يَوْمَ الْيَمَامَةِ  مِنَ  الْأَنْصَارِ ،  رَبَاحٌ مَوْلَى بَنِي جَحْجَبَى  .","","Al-Mu'jam al-Kabir 4628","","","رباح الأنصاري"
"4631","4629  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ "" مَنِ اسْتُشْهِدَ  يَوْمَ الْيَمَامَةِ  مِنَ  الْأَنْصَارِ ،  ثُمَّ مِنَ  الْأَوْسِ ،  ثُمَّ مِنْ  بَنِي عَمْرِو بْنِ عَوْفٍ ،  رَبَاحٌ مَوْلَى بَنِي جَحْجَبَى  "" .","","Al-Mu'jam al-Kabir 4629","","","رباح الأنصاري"
"4632","468 -  رَزِينُ بْنُ أَنَسٍ السُّلَمِيُّ  4630  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو رَبِيعَةَ فَهْدُ بْنُ عَوْفٍ ،  ثَنَا  نَائِلُ بْنُ مُطَرِّفٍ السُّلَمِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي رَزِينِ بْنِ أَنَسٍ  قَالَ :  لَمَّا ظَهَرَ         [5/76]      الْإِسْلَامُ وَلَنَا بِئْرٌ  بِالدَّنِينَةِ ،  خِفْنَا أَنْ يَغْلِبَنَا عَلَيْهَا مَنْ حَوْلَنَا ، قَالَ : فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرْتُ ذَلِكَ لَهُ ، قَالَ : وَكَتَبَ لِي كِتَابًا :  مِنْ  مُحَمَّدٍ  رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَمَّا بَعْدُ ، فَإِنَّ لَهُمْ بِئْرَهُمْ إِنْ كَانَ صَادِقًا  ، قَالَ : فَمَا قَاضَيْنَا فِيهِ إِلَى أَحَدٍ مِنْ قُضَاةِ  الْمَدِينَةِ  إِلَّا قَضَوْا لَنَا بِهِ . قَالَ : وَفِي كِتَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ كَذَا ، وَزَعَمَ أَنَّهُ كَذَا كَانَ كِتَابُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 4630","","رزين بن أنس بن عامر السلمي عن والد ونائل بن مطرف بن رزين عن ونائل بن مطرف بن رزين عن زيد بن عوف القطعي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","رزين بن أنس"
"4633","469 -  رُقَادُ بْنُ رَبِيعَةَ الْعُقَيْلِيُّ  4631  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ كَثِيرٍ الْبَجَلِيُّ ،  أَنَا  يَعْلَى بْنُ الْأَشْدَقِ قَالَ : أَدْرَكْتُ عِدَّةً مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِمَّنْ صَدَقَ مِنْهُمْ رُقَادُ بْنُ رَبِيعَةَ قَالَ :  أَخَذَ مِنَّا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الْغَنَمِ مِنَ الْمِائَةِ شَاةً  ، فَإِنْ زَادَتْ فَشَاتَانِ  .","","Al-Mu'jam al-Kabir 4631","","رقاد بن ربيعة العقيلي عن يعلى بن الأشدق عن أحمد بن كثير البجلي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رقاد بن ربيعة"
"4634","470 -  رُشَيْدُ بْنُ مَالِكٍ ، أَبُو عَمِيرَةَ السَّعْدِيُّ  4632  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ (  ح  ) .  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، حَدَّثَنَا  خَلَّادُ بْنُ يَحْيَى (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْحَكَمُ بْنُ مَرْوَانَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ - قَالُوا :  ثَنَا  مُعَرِّفُ بْنُ وَاصِلٍ السَّعْدِيُّ قَالَ :  حَدَّثَتْنِي  حَفْصَةُ بِنْتُ طَلْقٍ قَالَتْ :  حَدَّثَنَا  أَبُو عَمِيرَةَ رُشَيْدُ بْنُ مَالِكٍ قَالَ :  كُنَّا جُلُوسًا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَاهُ  رَجُلٌ  بِطَبَقٍ عَلَيْهِ تَمْرٌ ، فَقَالَ لَهُ : "" مَا هَذَا ؟ أَهَدِيَّةٌ أَمْ صَدَقَةٌ ؟ "" ، قَالَ الرَّجُلُ : صَدَقَةٌ ! قَالَ : "" فَقَدِّمْهَا إِلَى         [5/77]      الْقَوْمِ  "" . قَالَ :  وَحَسَنٌ  بَيْنَ يَدَيْهِ يَتَعَفَّرُ ، قَالَ : فَأَخَذَ الصَّبِيُّ تَمْرَةً فَجَعَلَهَا فِي فِيهِ ، قَالَ : فَفَطِنَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَدْخَلَ إِصْبَعَهُ فِي فِي الصَّبِيِّ فَانْتَزَعَ التَّمْرَةَ ثُمَّ قَذَفَهُ بِهَا وَقَالَ :  إِنَّا  آلَ مُحَمَّدٍ  لَا نَأْكُلُ الصَّدَقَةَ  .","","Al-Mu'jam al-Kabir 4632","","رشيد بن مالك السعدي عن حفصة بنت طلق عن معرف بن واصل السعدي عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","رشيد بن مالك"
"4635","471 -  رِيَابٌ الْمُزَنِيُّ  4633  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  ثَنَا  الْفُرَاتُ بْنُ أَبِي الْفُرَاتِ قَالَ :  سَمِعْتُ  الْفَضْلَ بْنَ طَلْحَةَ  يُحَدِّثُ عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ بْنِ رِيَابٍ ،  عَنْ  أَبِيهِ  أَنَّهُ "" كَانَ مَعَ جَدِّهِ حَيْثُ أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - وَهُوَ غُلَامٌ فَوَجَدَهُ مَحْلُولَ الْأَزْرَارِ  .","","Al-Mu'jam al-Kabir 4633","","قرة بن إياس بن هلال المزني عن معاوية بن قرة عن الفضل بن طلحة عن فرات بن أبي الفرات البصري عن عبد الواحد بن غياث عن محمد بن عبد الله مطين الحضرمي عن الطبراني","رياب المزني"
"4636","472 -  رَسِيمٌ الْعَبْدِيُّ  4634  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ وَعُبَيْدُ بْنُ غَنَّامٍ قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  يَحْيَى بْنِ الْحَارِثِ ،  عَنْ  يَحْيَى بْنِ غَسَّانَ ،  عَنِ  ابْنِ الرَّسِيمِ ،  عَنْ  أَبِيهِ  - وَكَانَ مِنْ  أَهْلِ هَجَرَ  ، وَكَانَ فَقِيهًا -  أَنَّهُ انْطَلَقَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي وَفْدٍ بِصَدَقَةٍ ، فَحَمَلَهَا إِلَيْهِ ، فَنَهَاهُمْ عَنِ النَّبِيذِ فِي هَذِهِ الظُّرُوفِ ، فَرَجَعُوا إِلَى أَرْضِهِمْ - وَهِيَ  أَرْضُ تِهَامَةَ ،  حَارَّةٌ -  فَاسْتَوْخَمُوا  ، فَرَجَعُوا إِلَيْهِ الْعَامَ الثَّانِيَ فِي صَدَقَاتِهِمْ فَقَالُوا : يَا رَسُولَ اللهِ ، إِنَّكَ نَهَيْتَنَا عَنْ هَذِهِ الْأَوْعِيَةِ فَتَرَكْنَاهَا فَشَقَّ ذَلِكَ عَلَيْنَا ! فَقَالَ :  اذْهَبُوا فَاشْرَبُوا مَا شِئْتُمْ ، وَلَا تَشْرَبُوا مَا أُوكِيَ سِقَاؤُهُ عَلَى إِثْمٍ  .","","Al-Mu'jam al-Kabir 4634","","الرسيم البحرينى عن ابن الرسيم عن يحيى بن غسان بن رسيم المرادي عن يحيى بن عبد الله بن الحارث الجابر عن عبد الرحيم بن سليمان الأشل عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","رسيم العبدي"
"4637","[5/78]      473 -  رِعْيَةُ الْجُهَنِيُّ ثُمَّ السُّحَيْمِيُّ  4635  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ التَّسْنِيمِيُّ ،  ثَنَا  الْأَنْصَارِيُّ ،  ثَنَا  إِسْرَائِيلُ بْنُ يُونُسَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  رِعْيَةَ السُّحَيْمِيِّ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَتَبَ إِلَيْهِ كِتَابًا فِي أَدِيمٍ أَحْمَرَ فَرَقَّعَ بِهِ دَلْوَهُ ، فَأُخْبِرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَبَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَرِيَّةً فَلَمْ يَدَعُوا لَهُ  سَارِحَةً  وَلَا بَارِحَةً وَلَا أَهْلًا وَلَا مَالًا إِلَّا أَخَذُوهُ ، فَأُفْلِتَ عُرْيَانًا عَلَى فَرَسٍ ، فَأَتَى ابْنَتَهُ وَهِيَ مُتَزَوِّجَةٌ فِي  بَنِي هِلَالٍ ،  وَكَانَ مَجْلِسُ  الْقَوْمِ  بِفِنَاءِ بَابِهَا ، فَدَخَلَ مِنْ وَرَاءِ الْبُيُوتِ عَلَيْهَا ، فَقَالَتْ : مَا لَكَ ؟ قَالَ : كُلُّ شَرٍّ قَدْ نَزَلَ بِأَبِيكِ ، مَا تُرِكَ لَهُ  سَارِحَةٌ  وَلَا بَارِحَةٌ وَلَا أَهْلٌ وَلَا مَالٌ إِلَّا أُخِذَ ! قُلْتُ : قَدْ دُعِيتَ إِلَى الْإِسْلَامِ ! وَكَانَتْ قَدْ أَسْلَمَتْ هِيَ ، قَالَ : فَطَرَحَتْ عَلَيْهِ ثَوْبًا فَخَرَجَ ، فَقَالَ : أَيْنَ  بَعْلُكِ  ؟ قَالَتْ : فِي الرَّحْلِ . فَأَتَاهُ وَعَلَيْهِ ثَوْبٌ إِذَا غُطِّيَ بِهِ رَأْسُهُ انْكَشَفَتِ اسْتُهُ ، وَإِنْ غُطِّيَ اسْتُهُ انْكَشَفَ رَأْسُهُ ! فَقَالَ : مَا الَّذِي أَرَى بِكَ ؟ قَالَ : كُلُّ الشَّرِّ قَدْ نَزَلَ بِي ! فَأَعَادَ الْكَلَامَ عَلَيْهِ بِمِثْلِ مَا قَالَ لِابْنَتِهِ ، قَالَ : وَأَنَا أُرِيدُ  مُحَمَّدًا  قَبْلَ أَنْ يُقَسِّمَ مَالِي ! قَالَ : خُذْ رَاحِلَتِي ! قَالَ : لَا حَاجَةَ لِي بِهَا ، وَلَكِنْ أَعْطِنِي  الْقَعُودَ  ! قَالَ : فَأَخَذَهَا وَمَضَى إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَاهُ مَعَ صَلَاةِ الصُّبْحِ وَهُوَ يُصَلِّي ، فَلَمَّا قَضَى صَلَاتَهُ قَالَ : ابْسُطْ يَدَيْكَ  أُبَايِعْكَ  ! فَبَسَطَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدَهُ ، فَلَمَّا أَرَادَ أَنْ يَضْرِبَ عَلَيْهَا قَبَضَهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَعَلَ ذَلِكَ مِرَارًا ، ثُمَّ أَقْبَلَ عَلَيْهِ فَقَالَ : "" مَنْ أَنْتَ ؟ "" ، قَالَ :  رِعْيَةُ السُّحَيْمِيُّ !  فَأَخَذَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِعَضُدِهِ فَرَفَعَهُ مِنَ الْأَرْضِ ، ثُمَّ قَالَ :  هَا هَذَا  رِعْيَةُ السُّحَيْمِيُّ ،  كَتَبْتُ إِلَيْهِ كِتَابًا فَرَقَّعَ بِهِ دَلْوَهُ  ، وَقَالَ  رِعْيَةُ  :         [5/79]      مَالِي وَوَلَدِي ! قَالَ : "" أَمَّا مَالُكَ فَهَيْهَاتَ قَدْ قُسِّمَ ، وَأَمَّا وُلْدُكَ وَأَهْلُكَ فَمَنْ أَصَبْتَ مِنْهُمْ "" ، قَالَ : فَمَضَى ثُمَّ عَادَ ، وَإِذَا ابْنُهُ قَدْ عَرَفَ ، فَرَجَعَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : هَذَا ابْنِي ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" يَا  بِلَالُ ،  اخْرُجْ مَعَهُ ، فَإِنْ زَعَمَ أَنَّهُ ابْنُهُ فَادْفَعْهُ إِلَيْهِ "" ، فَخَرَجَ مَعَهُ ، فَقَالَ : هَذَا ابْنِي ! فَدَفَعَهُ إِلَيْهِ ، وَأَقْبَلَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : ذَكَرَ أَنَّهُ ابْنُهُ ، وَمَا رَأَيْتُ وَاحِدًا مِنْهُمُ  اسْتَعْبَرَ  إِلَى صَاحِبِهِ ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" ذَاكَ جَفَاءُ الْأَعْرَابِ  .","","Al-Mu'jam al-Kabir 4635","","رعية السحيمي عن الشعبي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن محمد بن عبد الله بن المثنى الخزرجي عن محمد بن الحسن بن تسنيم الوراق عن محمد بن أبان الأصبهاني عن الطبراني","رعية الجهني"
"4638","4636  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ قَالَا :  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  رِعْيَةَ الْجُهَنِيِّ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَتَبَ إِلَيْهِ كِتَابًا فَرَقَّعَ بِهِ دَلْوَهُ ، فَمَرَّتْ بِهِ سَرِيَّةٌ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاسْتَاقُوا إِبِلًا لَهُ ، فَأَسْلَمَ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَا مَا أَدْرَكْتَ مِنْ مَالِكَ بِعَيْنِهِ قَبْلَ أَنْ يُقْسَمَ فَأَنْتَ أَحَقُّ بِهِ  .","","Al-Mu'jam al-Kabir 4636","","رعية السحيمي عن أبو إسحاق السبيعي عن حجاج بن أرطاة عن حماد بن سلمة عن يحيى بن آدم عن أبو كريب محمد بن العلاء عن الحسين بن إسحاق التستري عن الطبراني","رعية الجهني"
"4639","474 -  رُقَيْمُ بْنُ ثَابِتٍ ، أَبُو ثَابِتٍ الْأَنْصَارِيُّ ،  "" اسْتُشْهِدَ  يَوْمَ الطَّائِفِ  ""  4637  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ الطَّائِفِ  مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي عَمْرِو بْنِ عَوْفٍ ،  ثُمَّ مِنْ  بَنِي مُعَاوِيَةَ بْنِ الْحَارِثِ ،  رُقَيْمُ بْنُ ثَابِتِ بْنِ ثَعْلَبَةَ  .","","Al-Mu'jam al-Kabir 4637","","","رقيم بن ثابت"
"4640","4638  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  ،  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ الطَّائِفِ  مِنَ  الْأَنْصَارِ ،  ثُمَّ مِنَ  الْأَوْسِ ،  رُقَيْمُ بْنُ ثَابِتِ بْنِ ثَعْلَبَةَ بْنِ زَيْدِ بْنِ لَوْذَانَ بْنِ مُعَاوِيَةَ  .","","Al-Mu'jam al-Kabir 4638","","","رقيم بن ثابت"
"4641","[5/80]      475 -  رُخَيْلَةُ بْنُ ثَعْلَبَةَ بْنِ خَلْدَةَ الْأَنْصَارِيُّ ، بَدْرِيٌّ  4639  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ ،  ثُمَّ مِنْ  بَنِي بَيَاضَةَ ،  رُخَيْلَةُ بْنُ ثَعْلَبَةَ بْنِ خَلْدَةَ  .","","Al-Mu'jam al-Kabir 4639","","","رخيلة بن ثعلبة"
"4642","476 -  رَوْحُ بْنُ زِنْبَاعٍ الْجُذَامِيُّ  4640  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِي مَعْشَرٍ قَالَ :  لَمَّا مَاتَ  مُعَاوِيَةُ بْنُ يَزِيدَ  بَايَعَ  أَهْلُ الشَّامِ  كُلُّهُمُ  ابْنَ الزُّبَيْرِ  إِلَّا  أَهْلَ الْأَرْدُنِّ  ،  فَلَمَّا رَأَى ذَلِكَ رُءُوسُ  بَنِي أُمَيَّةَ  وَنَاسٌ مِنْ  أَهْلِ الشَّامِ  مِنْ أَشْرَافِهِمْ وَفِيهِمْ رَوْحُ بْنُ زِنْبَاعٍ الْجُذَامِيُّ قَالَ بَعْضُهُمْ لِبَعْضٍ : إِنَّ الْمُلْكَ كَانَ فِينَا  أَهْلَ الشَّامِ  فَيُنْقَلُ ذَلِكَ إِلَى  الْحِجَازِ !  لَا نَرْضَى بِذَلِكَ "" .","","Al-Mu'jam al-Kabir 4640","","روح بن زنباع الجذامي عن نجيح بن عبد الرحمن السندي عن حجاج بن محمد الأعور عن يحيى بن معين عن عبد الله بن أحمد بن حنبل عن الطبراني","روح بن زنباع"
"4643","بَابُ الزَّايِ  مَنِ اسْمُهُ زَيْدٌ  477 -  زَيْدُ بْنُ الْخَطَّابِ بْنِ نُفَيْلِ بْنِ عَبْدِ الْعُزَّى بْنِ رَبَاحِ بْنِ عَبْدِ اللهِ بْنِ قُرْطِ بْنِ رَزَاحِ بْنِ عَدِيِّ بْنِ كَعْبٍ ،  "" بَدْرِيٌّ ، اسْتُشْهِدَ  يَوْمَ الْيَمَامَةِ  ""  4641  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنْ  قُرَيْشٍ ،  مِنْ  بَنِي عَدِيِّ بْنِ كَعْبٍ  زَيْدُ بْنُ الْخَطَّابِ  .","","Al-Mu'jam al-Kabir 4641","","","زيد بن الخطاب"
"4644","[5/81]      4642  / 1  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنْ  قُرَيْشٍ ،  ثُمَّ مِنْ  بَنِي عَدِيِّ بْنِ كَعْبٍ ،  زَيْدُ بْنُ الْخَطَّابِ  .","","Al-Mu'jam al-Kabir 4642","","","زيد بن الخطاب"
"4645","4642  / 2  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ الْيَمَامَةِ  مِنْ  قُرَيْشٍ ،  ثُمَّ مِنْ  بَنِي عَدِيِّ بْنِ كَعْبٍ ،  زَيْدُ بْنُ الْخَطَّابِ  .","","Al-Mu'jam al-Kabir 4642","","","زيد بن الخطاب"
"4646","4643  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ الْحَكَمِ بْنِ أَبِي زِيَادٍ  يَقُولُ : ""  زَيْدُ بْنُ الْخَطَّابِ  كَانَ أَسَنَّ مِنْ  عُمَرَ ،  وَيُكْنَى  أَبَا عَبْدِ الرَّحْمَنِ ،  وَيُقَالُ  أَبُو ثَوْرٍ  "" .","","Al-Mu'jam al-Kabir 4643","","","زيد بن الخطاب"
"4647","4644  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  اقْتُلُوا الْحَيَّاتِ وَاقْتُلُوا ذَا  الطُّفْيَتَيْنِ  وَالْأَبْتَرَ  ، فَإِنَّهُمَا يُسْقِطَانِ الْحَمْلَ وَيَطْمِسَانِ الْبَصَرَ "" . قَالَ  ابْنُ عُمَرَ  : فَرَآنِي  أَبُو لُبَابَةَ أَوْ زَيْدُ بْنُ الْخَطَّابِ  وَأَنَا  أُطَارِدُ  حَيَّةً لِأَقْتُلَهَا فَنَهَانِي ، فَقُلْتُ : "" إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ أَمَرَ بِقَتْلِهِنَّ ""  فَقَالَ  :  إِنَّهُ قَدْ نَهَى بَعْدَ ذَلِكَ عَنْ قَتْلِ ذَوَاتِ الْبُيُوتِ  . قَالَ  الزُّهْرِيُّ  : ""  وَهُنَّ  الْعَوَامِرُ  "" .","","Al-Mu'jam al-Kabir 4644","","زيد بن الخطاب أخو عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","زيد بن الخطاب"
"4648","4645  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ بْنِ مُجَمِّعٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  اقْتُلُوا الْحَيَّاتِ  . قَالَ  ابْنُ عُمَرَ  : فَرَآنِي أَبُو لُبَابَةَ وَزَيْدُ بْنُ الْخَطَّابِ وَأَنَا أَقْتُلُ حَيَّةً مِنْ ذَوَاتِ الْبُيُوتِ وَكُنَّا نَدْعُوهُنَّ  الْجِنَّانَ  ،  فَقَالَا  : يَا  عَبْدَ اللهِ ،  "" إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَانَا أَنْ نَقْتُلَ ذَوَاتَ الْبُيُوتِ  .","","Al-Mu'jam al-Kabir 4645","","زيد بن الخطاب أخو عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إبراهيم بن إسماعيل بن مجمع عن حاتم بن إسماعيل الحارثي عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","زيد بن الخطاب"
"4649","[5/82]      4646  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  بِشْرُ بْنُ آدَمَ ،  ثَنَا  أَبُو عَلِيٍّ الْحَنَفِيُّ ،  ثَنَا  زَمْعَةُ بْنُ صَالِحٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، عَنْ  أَبِي لُبَابَةَ بْنِ عَبْدِ الْمُنْذِرِ وَزَيْدِ بْنِ الْخَطَّابِ "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ قَتْلِ  الْجِنَّانِ  .","","Al-Mu'jam al-Kabir 4646","","أبو لبابة بن عبد المنذر الأنصاري عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن زمعة بن صالح الجندي عن عبيد الله بن عبد المجيد الحنفي عن بشر بن آدم بن يزيد عن البزار عن الطبراني","زيد بن الخطاب"
"4650","4647  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ سَعْدٍ ،  ثَنَا  عَمِّي ،  ثَنَا  أَبِي  ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ شِهَابٍ أَنَّ  سَالِمًا  أَخْبَرَهُ  أَنَّ عَبْدَ اللهِ بْنَ عُمَرَ  أَخْبَرَهُ  أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  اقْتُلُوا الْحَيَّاتِ ذَا  الطُّفْيَتَيْنِ  وَالْأَبْتَرَ ؛  فَإِنَّهُمَا  يَلْتَمِسَانِ  الْبَصَرَ وَيَسْتَسْقِطَانِ الْحَمْلَ "" . فَقَالَ  عَبْدُ اللهِ بْنُ عُمَرَ  : مَا كُنْتُ أَدَعُ حَيَّةً إِلَّا قَتَلْتُهَا حَتَّى رَآنِي أَبُو لُبَابَةَ بْنُ الْمُنْذِرِ وَزَيْدُ بْنُ الْخَطَّابِ وَأَنَا أُطَالِبُ حَيَّةً مِنْ حَيَّاتِ الْبُيُوتِ ، فَنَهَيَانِي عَنْ قَتْلِهَا ، فَقُلْتُ : "" إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ بِقَتْلِهِنَّ "" ،  فَقَالَا  :  إِنَّهُ قَدْ نَهَى عَنْ قَتْلِ ذَوَاتِ الْبُيُوتِ  .","","Al-Mu'jam al-Kabir 4647","","زيد بن الخطاب أخو عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبيد الله بن سعد بن إبراهيم الزهري عن أحمد بن يحيى بن زهير التستري عن الطبراني","زيد بن الخطاب"
"4651","4648  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ خَلَّادٍ الدَّوْرَقِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حِزَامٍ الضُّبَعِيُّ الْبَصْرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ مُحَمَّدٍ أَبُو عَامِرٍ الْأَنْصَارِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ،  عَنْ  أَبِي جَنَابٍ الْكَلْبِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ زَيْدِ بْنِ الْخَطَّابِ ،  عَنْ  أَبِيهِ  قَالَ :  خَرَجْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ فَتْحِ مَكَّةَ  نَحْوَ الْمَقَابِرِ ، فَقَعَدَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى قَبْرٍ ، فَرَأَيْنَاهُ كَأَنَّهُ يُنَاجِي ، فَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَمْسَحُ الدُّمُوعَ مِنْ عَيْنَيْهِ ، فَتَلَقَّاهُ  عُمَرُ  رَحِمَهُ اللهُ وَكَانَ أَوَّلَنَا ، فَقَالَ : بِأَبِي أَنْتَ وَأُمِّي مَا يُبْكِيكَ ؟ قَالَ :  إِنِّي اسْتَأْذَنْتُ رَبِّي - عَزَّ وَجَلَّ - فِي زِيَارَةِ قَبْرِ أُمِّي وَكَانَتْ وَالِدَةً وَلَهَا قِبَلِي حَقٌّ أَنْ أَسْتَغْفِرَ لَهَا فَنَهَانِي  ، ثُمَّ أَوْمَأَ إِلَيْنَا أَنِ اجْلِسُوا ، فَجَلَسْنَا فَقَالَ : "" إِنِّي كُنْتُ نَهَيْتُكُمْ عَنْ زِيَارَةِ الْقُبُورِ ، فَمَنْ شَاءَ مِنْكُمْ أَنْ يَزُورَ فَلْيَزُرْ ، وَإِنِّي كُنْتُ نَهَيْتُكُمْ عَنْ لُحُومِ الْأَضَاحِيِّ فَوْقَ ثَلَاثَةِ أَيَّامٍ فَكُلُوا  وَادَّخِرُوا  مَا بَدَا لَكُمْ ، وَإِنِّي كُنْتُ نَهَيْتُكُمْ عَنْ ظُرُوفٍ وَأَمَرْتُكُمْ بِظُرُوفٍ فَانْتَبِذُوا ، فَإِنَّ الْآنِيَةَ لَا تُحِلُّ شَيْئًا وَلَا تُحَرِّمُهُ ، وَاجْتَنِبُوا كُلَّ مُسْكِرٍ  .","","Al-Mu'jam al-Kabir 4648","","زيد بن الخطاب أخو عمر بن الخطاب عن عبد الرحمن بن زيد بن الخطاب بن نفيل العدوي عن يحيى بن أبي حية عن عبد العزيز بن مسلم الخراساني عن إسماعيل بن محمد أبو عامر الأنصاري عن محمد بن حزام الضبعي البصري عن عبد الرحمن بن خلاد الدورقي عن الطبراني","زيد بن الخطاب"
"4652","[5/83]      478 -  زَيْدُ بْنُ حَارِثَةَ بْنِ شَرَاحِيلَ بْنِ كَعْبِ بْنِ عَبْدِ الْعُزَّى بْنِ يَزِيدَ بْنِ امْرِئِ الْقَيْسِ الْكَلْبِيُّ ، مَوْلَى رَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، "" اسْتُشْهِدَ  يَوْمَ مُؤْتَةَ  فِي سَنَةِ ثَمَانٍ "" .  4649  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  زَيْدُ بْنُ حَارِثَةَ بْنِ شَرَاحِيلَ بْنِ كَعْبِ بْنِ عَبْدِ الْعُزَّى بْنِ يَزِيدَ بْنِ امْرِئٍ الْقَيْسِ الْكَلْبِيُّ  ، وَأَنْعَمَ اللهُ عَلَيْهِ وَرَسُولُهُ  .","","Al-Mu'jam al-Kabir 4649","","","زيد بن حارثة"
"4653","4650  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنْ  قُرَيْشٍ  ، ثُمَّ مِنْ  بَنِي هَاشِمٍ  ،  زَيْدُ بْنُ حَارِثَةَ  .","","Al-Mu'jam al-Kabir 4650","","","زيد بن حارثة"
"4654","4651  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ الْبَكَّائِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  ""  زَيْدُ بْنُ حَارِثَةَ بْنِ شَرَاحِيلَ بْنِ كَعْبِ بْنِ عَبْدِ الْعُزَّى بْنِ امْرِئِ الْقَيْسِ بْنِ عَامِرِ بْنِ النُّعْمَانِ بْنِ عَامِرِ بْنِ عَبْدِ وُدِّ بْنِ عَوْفِ بْنِ كِنَانَةَ بْنِ بَكْرِ بْنِ عَوْفِ بْنِ عُذْرَةَ بْنِ زَيْدِ اللهِ بْنِ رُفَيْدَةَ بْنِ ثَوْرِ بْنِ كَلْبِ بْنِ وَبَرَةَ بْنِ الْحَارِثِ بْنِ قُضَاعَةَ  ، وَيُقَالُ : إِنَّ  أُمَّ زَيْدٍ سُعَادُ بِنْتُ زَيْدٍ  ، مِنْ  طَيِّئٍ  ""  .  قَالَ ابْنُ هِشَامٍ :  وَكَانَ  حَكِيمُ بْنُ حِزَامٍ  قَدِمَ مِنَ  الشَّامِ  بِزَيْدِ بْنِ حَارِثَةَ  وَصِيفًا ، فَاسْتَوْهَبَتْهُ مِنْهُ عَمَّتُهُ  خَدِيجَةُ  - وَهِيَ يَوْمَئِذٍ عِنْدَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَهَبَهُ لَهَا ، فَوَهَبَتْهُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَعْتَقَهُ  وَتَبَنَّاهُ  ، وَذَلِكَ قَبْلَ أَنْ يُوحَى إِلَيْهِ ، وَقَدِمَ عَلَيْهِ أَبُوهُ وَهُوَ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ شِئْتَ فَأَقِمْ عِنْدِي ، وَإِنْ شِئْتَ فَانْطَلِقْ مَعَ أَبِيكَ  ، قَالَ : بَلْ أُقِيمُ عِنْدَكَ !         [5/84]      فَلَمْ يَزَلْ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى بَعَثَهُ اللهُ ، فَصَدَّقَهُ وَأَسْلَمَ وَصَلَّى مَعَهُ ، فَلَمَّا أَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      ادْعُوهُمْ لآبَائِهِمْ         }      قَالَ : أَنَا  زَيْدُ بْنُ حَارِثَةَ  .","","Al-Mu'jam al-Kabir 4651","","عبد الملك بن هشام الذهلي عن محمد بن إسحاق عن زياد بن عبد الله البكائي عن عبد الملك بن هشام الذهلي عن عبد الرحيم بن عبد الله البرقي عن الطبراني","زيد بن حارثة"
"4655","4652  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  أَسْلَمَ زَيْدُ بْنُ حَارِثَةَ بَعْدَ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - فَكَانَ أَوَّلَ مَنْ أَسْلَمَ بَعْدَهُ  "" .","","Al-Mu'jam al-Kabir 4652","","زيد بن حارثة الكلبي عن محمد بن إسحاق عن زياد بن عبد الله البكائي عن عبد الملك بن هشام الذهلي عن عبد الرحيم بن عبد الله البرقي عن الطبراني","زيد بن حارثة"
"4656","4653  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنِ  ابْنِ شِهَابٍ قَالَ :  أَوَّلُ مَنْ أَسْلَمَ  زَيْدُ بْنُ حَارِثَةَ  "" .","","Al-Mu'jam al-Kabir 4653","","الزهري عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن أبو شعيب الحراني عن الطبراني","زيد بن حارثة"
"4657","4654  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ قُتِلَ  يَوْمَ مُؤْتَةَ  زَيْدُ بْنُ حَارِثَةَ  .","","Al-Mu'jam al-Kabir 4654","","","زيد بن حارثة"
"4658","4655  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْثًا إِلَى  مُؤْتَةَ  فِي  جُمَادَى الْأُولَى مِنْ سَنَةِ ثَمَانٍ  ، وَاسْتَعْمَلَ  زَيْدَ بْنَ حَارِثَةَ ،  وَقَالَ لَهُمْ :  إِنْ أُصِيبَ  زَيْدٌ  فَجَعْفَرُ بْنُ أَبِي طَالِبٍ  عَلَى النَّاسِ ، فَإِنْ أُصِيبَ  جَعْفَرٌ  فَعَبْدُ اللهِ بْنُ رَوَاحَةَ  عَلَى النَّاسِ  .","","Al-Mu'jam al-Kabir 4655","","عروة بن الزبير عن محمد بن جعفر بن الزبير بن العوام عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","زيد بن حارثة"
"4659","4656  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ قَالَ :  ثُمَّ مَضَى النَّاسُ ، حَتَّى إِذَا كَانُوا  بِتُخُومِ الْبَلْقَاءِ  لَقِيَهُمْ جُمُوعُ  هِرَقْلَ  ، وَانْحَازَ الْمُسْلِمُونَ إِلَى قَرْيَةٍ يُقَالُ لَهَا  مُؤْتَةُ ،         [5/85]      فَالْتَقَى النَّاسُ عِنْدَهَا وَتَعَبَّأَ لَهُمُ الْمُسْلِمُونَ ، فَجَعَلُوا عَلَى مَيْمَنَتِهِمْ رَجُلًا مِنْ  بَنِي عُذْرَةَ  يُقَالُ لَهُ  قُطْبَةُ بْنُ قَتَادَةَ ،  وَعَلَى مَيْسَرَتِهِمْ رَجُلًا مِنَ  الْأَنْصَارِ  يُقَالُ لَهُ  عَبَايَةُ بْنُ مَالِكٍ ،  ثُمَّ الْتَقَى النَّاسُ ،  فَقَاتَلَ زَيْدُ بْنُ حَارِثَةَ بِرَايَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى  شَاطَ  فِي رِمَاحِ  الْقَوْمِ  ""  .","","Al-Mu'jam al-Kabir 4656","","زيد بن حارثة الكلبي عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","زيد بن حارثة"
"4660","مَا  أَسْنَدَ  زَيْدٌ  4657  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  كَامِلُ بْنُ طَلْحَةَ الْجَحْدَرِيُّ (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ - قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  عُقَيْلُ بْنُ خَالِدٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ  أَنَّ  جِبْرِيلَ  - عَلَيْهِ السَّلَامُ - نَزَلَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَوَّلِ مَا أُوحِيَ إِلَيْهِ فَعَلَّمَهُ الْوُضُوءَ وَالصَّلَاةَ ، فَلَمَّا فَرَغَ  أَخَذَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدِهِ مَاءً  فَنَضَحَ  بِهِ فَرْجَهُ  "" .","","Al-Mu'jam al-Kabir 4657","","زيد بن حارثة الكلبي عن أسامة بن زيد بن حارثة ذو البطين عن عروة بن الزبير عن الزهري عن عقيل بن خالد الأيلي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","ما أسند زيد"
"4661","4658  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُبَيْدُ بْنُ يَعِيشَ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ،  عَنْ  زَيْدِ بْنِ حَارِثَةَ قَالَ :  قُلْتُ :  يَا رَسُولَ اللهِ ، آخَيْتَ بَيْنِي وَبَيْنَ  حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ  .","","Al-Mu'jam al-Kabir 4658","","زيد بن حارثة الكلبي عن البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن يونس بن بكير عن عبيد بن يعيش عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ما أسند زيد"
"4662","4659  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  يُونُسَ بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْبَرَاءِ  أَنَّ  زَيْدَ بْنَ حَارِثَةَ قَالَ :  يَا رَسُولَ اللهِ ، آخَيْتَ بَيْنِي وَبَيْنَ  حَمْزَةَ  .","","Al-Mu'jam al-Kabir 4659","","زيد بن حارثة الكلبي عن البراء بن عازب الأوسي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن يونس بن بكير عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ما أسند زيد"
"4663","4660  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  حَجَّاجِ بْنِ أَرْطَاةَ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ         [5/86]      عَبَّاسٍ رَضِيَ اللهُ عَنْهُمَا قَالَ :  كَانَ  حَمْزَةُ  عَمُّ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - أَخَا  زَيْدِ بْنِ حَارِثَةَ ،  آخَى بَيْنَهُمَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 4660","","عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن عبد الله بن نمير عن عثمان ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ما أسند زيد"
"4664","4661  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ أَبِي سَلَمَةَ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ الْبَكَّائِيُّ ،  عَنْ  حَجَّاجِ بْنِ أَرْطَاةَ ،  عَنِ  الْحَكَمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَالَ  زَيْدُ بْنُ حَارِثَةَ فِي  ابْنَةِ حَمْزَةَ  : "" ابْنَةُ أَخِي ،  آخَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنِي وَبَيْنَ أَبِيهَا  .","","Al-Mu'jam al-Kabir 4661","","زيد بن حارثة الكلبي عن عبد الله بن عباس عن مقسم بن بجرة عن الحكم بن عتيبة الكندي عن حجاج بن أرطاة عن زياد بن عبد الله البكائي عن محمد بن يحيى بن أبي سلمة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ما أسند زيد"
"4665","4662  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  عُرْوَةَ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ زَيْدِ بْنِ حَارِثَةَ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَشِّرِ الْمَشَّائِينَ فِي الظُّلَمِ إِلَى الْمَسَاجِدِ بِنُورٍ  يَوْمَ الْقِيَامَةِ  سَاطِعٍ  .","","Al-Mu'jam al-Kabir 4662","","زيد بن حارثة الكلبي عن أسامة بن زيد بن حارثة ذو البطين عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن الوليد بن مسلم القرشي عن سليمان بن أحمد الدمشقي عن عبد الله بن أحمد الجواليقي عن الطبراني","ما أسند زيد"
"4666","4663  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو أُسَامَةَ حَمَّادُ بْنُ أُسَامَةَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَمْرِو بْنِ عَلْقَمَةَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ وَيَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ زَيْدِ بْنِ حَارِثَةَ  قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ مُرْدِفِي إِلَى  نُصُبٍ  مِنَ  الْأَنْصَابِ  ، فَذَبَحْنَا لَهُ شَاةً ثُمَّ صَنَعْنَاهَا فِي  الْإِرَةِ  ، فَلَمَّا نَضِجَتِ اسْتَخْرَجْنَاهَا فِي  سُفْرَتِنَا  ، ثُمَّ رَكِبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَاقَتَهُ وَهُوَ مُرْدِفِي ، فَلَمَّا كُنَّا بِأَعْلَى  مَكَّةَ  لَقِيَهُ  زَيْدُ بْنُ عَمْرِو بْنِ نُفَيْلٍ  ، فَحَيَّا أَحَدُهُمَا صَاحِبَهُ بِتَحِيَّةِ الْجَاهِلِيَّةِ ، فَقَالَ لَهُ         [5/87]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" مَا لِي أَرَى قَوْمَكَ قَدْ  شَنِفُوكَ  وَكَرِهُوكَ ؟ "" ، فَقَالَ : وَاللهِ إِنَّ ذَلِكَ مِنْهُمْ لَبِغَيْرِ مَا ثَائِرَةٍ كَانَتْ مِنِّي إِلَيْهِمْ ، إِلَّا أَنِّي أَرَاهُمْ فِي ضَلَالٍ ، فَخَرَجْتُ أَبْتَغِي هَذَا الدِّينَ ، حَتَّى قَدِمْتُ عَلَى  أَحْبَارِ خَيْبَرَ  فَوَجَدْتُهُمْ يَعْبُدُونَ اللهَ وَيُشْرِكُونَ بِهِ ، فَقُلْتُ : وَاللهِ مَا هَذَا بِالدِّينِ الَّذِي أَبْتَغِي بِهِ ، فَخَرَجْتُ حَتَّى قَدِمْتُ عَلَى  أَحْبَارِ الشَّامِ  ، فَوَجَدْتُهُمْ يَعْبُدُونَ اللهَ وَيُشْرِكُونَ بِهِ ، فَقُلْتُ : وَاللهِ مَا هَذَا بِالدِّينِ الَّذِي خَرَجْتُ أَبْتَغِي ، فَقَالَ  حَبْرٌ مِنْ أَحْبَارِ الشَّامِ  : إِنَّكَ لَتَسْأَلُ عَنْ دِينٍ مَا نَعْلَمُ أَحَدًا يَعْبُدُ اللهَ بِهِ إِلَّا شَخْصًا  بِالْجَزِيرَةِ  ! فَخَرَجْتُ حَتَّى قَدِمْتُ عَلَيْهِ فَأَخْبَرْتُهُ بِالَّذِي خَرَجْتُ لَهُ ، فَقَالَ لِي : إِنَّ كُلَّ مَنْ رَأَيْتَ فِي ضَلَالٍ ، وَإِنَّكَ لَتَسْأَلُ عَنْ دِينِ اللهِ وَمَلَائِكَتِهِ ، وَقَدْ خَرَجَ فِي أَرْضِكَ نَبِيٌّ أَوْ هُوَ خَارِجٌ ، فَارْجِعْ فَصَدِّقْهُ وَآمِنْ بِهِ ! فَرَجَعْتُ فَلَمْ أَخْتَبِرْ نَبِيًّا بَعْدُ . قَالَ : فَأَنَاخَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَاقَتَهُ فَوَضَعَ  السُّفْرَةَ  بَيْنَ يَدَيْهِ ، فَقَالَ : مَا هَذَا ؟ قَالَ : "" شَاةٌ ذَبَحْنَاهَا  لِنُصُبِ  كَذَا كَذَا "" ، فَقَالَ  زَيْدُ بْنُ عَمْرٍو  : إِنَّا لَا نَأْكُلُ شَيْئًا ذُبِحَ لِغَيْرِ اللهِ ! ثُمَّ تَفَرَّقْنَا . قَالَ : وَمَاتَ  زَيْدُ بْنُ عَمْرِو بْنِ نُفَيْلٍ  قَبْلَ أَنْ يُبْعَثَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُبْعَثُ يَوْمَ الْقِيَامَةِ  أُمَّةً  وَحْدَهُ  .","","Al-Mu'jam al-Kabir 4663","","زيد بن حارثة الكلبي عن أسامة بن زيد بن حارثة ذو البطين عن يحيى بن عبد الرحمن بن حاطب اللخمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن أسامة القرشي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","ما أسند زيد"
"4667","4664  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرِو بْنِ عَلْقَمَةَ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ وَيَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ  قَالَ : خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ مُرْدِفِي . فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4664","","زيد بن حارثة الكلبي عن أسامة بن زيد بن حارثة ذو البطين عن يحيى بن عبد الرحمن بن حاطب اللخمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","ما أسند زيد"
"4668","4665  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ وَيَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  أَبِيهِ  قَالَ :  طُفْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ فَلَمَسْتُ بَعْضَ الْأَصْنَامِ ، فَقَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" لَا تَمَسَّهَا "" ، فَقُلْتُ : لَأَعُودَنَّ حَتَّى أُبْصِرَ مَا يَقُولُ ! ثُمَّ مَسَسْتُهَا فَقَالَ :  أَلَمْ تُنْهَ عَنْ هَذَا  ؟ "" ، قَالَ : فَوَالَّذِي أَكْرَمَهُ         [5/88]      وَأَنْزَلَ عَلَيْهِ الْكِتَابَ مَا مَسَّ مِنْهَا صَنَمًا حَتَّى أَكْرَمَهُ اللهُ ، وَأَنْزَلَ عَلَيْهِ  الْكِتَابَ  .  هذه الجملة كانت موجودة في أول صفحة 89 ، وتم نقلها إلى هنا لاقتضاء السياق ذلك.","","Al-Mu'jam al-Kabir 4665","","زيد بن حارثة الكلبي عن أسامة بن زيد بن حارثة ذو البطين عن يحيى بن عبد الرحمن بن حاطب اللخمي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن أسامة القرشي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","ما أسند زيد"
"4669","4666  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ عِيسَى التُّنُوخِيُّ ،  ثَنَا  زِيَادُ بْنُ الْحَسَنِ بْنِ فُرَاتٍ الْقَزَّازُ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  أَبِي الطُّفَيْلِ عَامِرِ بْنِ وَاثِلَةَ ،  عَنْ  زَيْدِ بْنِ حَارِثَةَ قَالَ :  كُنْتُ غُلَامًا عَلَى عَهْدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ يَوْمٍ : "" انْطَلِقُوا بِنَا إِلَى إِنْسَانٍ قَدْ رَأَيْنَا شَأْنَهُ "" ، قَالَ : فَانْطَلَقَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَمْشِي وَأَصْحَابُهُ مَعَهُ ، حَتَّى دَخَلُوا بَيْنَ حَائِطَيْنِ فِي زُقَاقٍ طَوِيلٍ ، فَانْتَهَوْا إِلَى بَابٍ صَغِيرٍ فِي أَقْصَى الزُّقَاقِ فَدَخَلُوا إِلَى دَارٍ ، فَلَمْ يَرَوْا فِي الدَّارِ أَحَدًا غَيْرَ  امْرَأَةٍ  وَاحِدَةٍ ، وَإِذَا قِرْبَةٌ عَظِيمَةٌ مَلْأَى مَاءً ، فَقَالُوا : نَرَى قِرْبَةً وَلَا نَرَى حَامِلَهَا ، كَلِّمُوا الْمَرْأَةَ ! فَأَشَارَتْ إِلَى قَطِيفَةٍ فِي نَاحِيَةِ الدَّارِ فَقَالَتِ انْظُرُوا إِلَى مَا تَحْتَ الْقَطِيفَةِ ، فَكَشَفُوهَا فَإِذَا تَحْتَهَا إِنْسَانٌ ، فَرَفَعَ رَأْسَهُ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ""  شَاهَ  الْوَجْهُ "" ، فَقَالَ : يَا  مُحَمَّدُ ،  لِمَ تَفْحَشُ عَلَيَّ ؟ فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  قَدْ خَبَأْتُ لَكَ خَبْأً ، فَأَخْبِرْنِي مَا هُوَ  ؟ "" ، وَقَالَ لِأَصْحَابِهِ : إِنِّي قَدْ خَبَأْتُ لَهُ سُورَةَ الدُّخَانِ ! فَقَالَ :  دُخٌّ  ! فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : "" اخْسَأْ ، مَا شَاءَ اللهُ كَانَ "" ، ثُمَّ انْصَرَفَ  .","","Al-Mu'jam al-Kabir 4666","","زيد بن حارثة الكلبي عن عامر بن واثلة عن فرات بن أبي عبد الرحمن القزاز عن الحسن بن الفرات القزاز عن زياد بن الحسن القزاز عن إبراهيم بن عبد الله بن عيسى التنوخي عن علي بن سعيد بن بشير عليك عن الطبراني","ما أسند زيد"
"4670","4667  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُجِيبٍ أَبُو هَمَّامٍ الدَّلَّالُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  هُزَيْلِ بْنِ شُرَحْبِيلَ ،  عَنْ  زَيْدِ بْنِ حَارِثَةَ قَالَ :  تَصَدَّقْتُ بِفَرَسٍ لِي ، فَرَأَيْتُ ابْنَتَهَا يُقَامُ بِالسُّوقِ  ، فَأَرَدْتُ أَنْ أَشْتَرِيَهَا ، فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَأَلْتُهُ عَنْهَا  .","","Al-Mu'jam al-Kabir 4667","","زيد بن حارثة الكلبي عن هزيل بن شرحبيل الأودي عن الشعبي عن جابر الجعفي عن إبراهيم بن طهمان عن محمد بن محبب الدلال عن حفص بن عمر سنجة ألف عن الطبراني","ما أسند زيد"
"4671","4668  -  حَدَّثَنَا  مُحَمَّدُ بْنُ اللَّيْثِ الْجَوْهَرِيُّ  ، ثَنَا  أَبُو هَمَّامٍ الْوَلِيدُ بْنُ شُجَاعٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زِيَادُ بْنُ خَيْثَمَةَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنْ  زَيْدِ بْنِ حَارِثَةَ  أَنَّهُ حَمَلَ عَلَى فَرَسٍ فِي  سَبِيلِ  اللهِ ، ثُمَّ إِنَّهُ وَجَدَهُ بَعْدُ  فِي         [5/89]      السُّوقِ يُبَاعُ ، وَهُوَ مَصْرُورٌ مَهْزُولٌ ، فَسَاوَمَ بِهِ ، ثُمَّ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ لَهُ : إِنِّي كُنْتُ حَمَلْتُ عَلَى فَرَسٍ فِي  سَبِيلِ  اللهِ ، وَإِنِّي قَدْ وَجَدْتُهُ يُبَاعُ فِي السُّوقِ بِثَمَنٍ يَسِيرٍ ، مَهْزُولٌ مَصْرُورٌ ، وَقَدْ عَرَفْتُ عَرَقَهُ ، فَأَشْتَرِيهِ ؟ "" ، فَنَهَاهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَشْتَرِيَهُ  .","","Al-Mu'jam al-Kabir 4668","","زيد بن حارثة الكلبي عن رفيع بن مهران عن داود بن أبي هند عن زياد بن خيثمة الجعفي عن شجاع بن الوليد السكوني عن الوليد بن شجاع عن محمد بن الليث الجوهري عن الطبراني","ما أسند زيد"
"4672","4669  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  كَثِيرُ بْنُ أَبِي كَثِيرٍ  ،  عَنْ  عَلِيِّ بْنِ عَبْدِ اللهِ ،  عَنْ  زَيْدِ بْنِ حَارِثَةَ  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ وَقْتِ صَلَاةِ الصُّبْحِ ؟ فَقَالَ : "" صَلِّهَا مَعَنَا الْيَوْمَ وَغَدًا "" ، فَلَمَّا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَاعِ  نَمِرَةَ  مِنَ  الْجُحْفَةِ  صَلَّاهَا حِينَ طَلَعَ أَوَّلُ الْفَجْرِ ، حَتَّى إِذَا كَانَ  بِذِي طُوًى  أَخَّرَهَا ، حَتَّى قَالَ النَّاسُ : أَقُبِضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَوْ صَلَّيْنَا ، فَصَلَّى أَمَامَ الشَّمْسِ ، ثُمَّ أَقْبَلَ عَلَى النَّاسِ فَقَالَ : "" مَا قُلْتُمْ ؟ "" ، قَالُوا : لَوْ صَلَّيْنَا ! قَالَ : "" لَوْ فَعَلْتُمْ لَأَصَابَكُمْ عَذَابٌ "" ، ثُمَّ دَعَا السَّائِلَ فَقَالَ :  وَقْتُهَا مَا بَيْنَ صَلَاتَيَّ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( كثير بن كثير) .","","Al-Mu'jam al-Kabir 4669","","زيد بن حارثة الكلبي عن علي بن أبي الوليد البارقي عن كثير بن كثير بن المطلب السهمي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ما أسند زيد"
"4673","479 -  زَيْدُ بْنُ بَوْلَا ، مَوْلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  4670  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الشَّنِّيُّ ،  حَدَّثَنِي  عُمَرُ بْنُ مُرَّةَ قَالَ :  سَمِعْتُ  بِلَالَ بْنَ يَسَارِ بْنِ زَيْدٍ مَوْلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  سَمِعْتُ  أَبِي  يُحَدِّثُ عَنْ  جَدِّي  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ قَالَ أَسْتَغْفِرُ اللهَ الَّذِي لَا إِلَهَ إِلَّا هُوَ وَأَتُوبُ إِلَيْهِ غُفِرَ لَهُ  ، وَإِنْ كَانَ [ فَرَّ مِنَ  الزَّحْفِ  ]  .","","Al-Mu'jam al-Kabir 4670","","زيد بن بولا المديني عن يسار بن زيد مولى رسول الله عن بلال بن يسار بن زيد مولى رسول الله عن عمر بن مرة الشني عن حفص بن عمر بن مرة الشني عن موسى بن إسماعيل التبوذكي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","زيد بن بولا"
"4674","[5/90]      480 -  زَيْدُ بْنُ سَهْلٍ ، أَبُو سَهْلٍ ، أَبُو طَلْحَةَ الْأَنْصَارِيُّ ،  عَقَبِيٌّ بَدْرِيٌّ نَقِيبٌ .  4671  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ  أَصْحَابِ الْعَقَبَةِ  مِنَ  الْأَنْصَارِ  ،  ثُمَّ مِنْ  بَنِي عَمْرِو بْنِ مَالِكِ بْنِ النَّجَّارِ  وَهُمْ  بَنُو جَدِيلَةَ  ،  أَبُو طَلْحَةَ سَهْلُ بْنُ زَيْدِ بْنِ الْأَسْوَدِ  وَهُوَ نَقِيبٌ ،  هَكَذَا قَالَ  ابْنُ لَهِيعَةَ  :  سَهْلُ بْنُ زَيْدٍ  فِي تَسْمِيَةِ مَنْ شَهِدَ  الْعَقَبَةَ  ، وَقَالَهُ عَلَى الصَّوَابِ فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  .","","Al-Mu'jam al-Kabir 4671","","","زيد بن سهل"
"4675","4672  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي  تَسْمِيَةِ مَنْ شَهِدَ  الْعَقَبَةَ  مِنَ  الْأَنْصَارِ  ،  أَبُو طَلْحَةَ زَيْدُ بْنُ سَهْلٍ  ، مِنْ  بَنِي النَّجَّارِ  ، وَشَهِدَ  بَدْرًا  .","","Al-Mu'jam al-Kabir 4672","","","زيد بن سهل"
"4676","4673  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  الْعَقَبَةَ  مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنْ  بَنِي عَدِيِّ بْنِ عَمْرِو بْنِ مَالِكِ بْنِ النَّجَّارِ بْنِ أَوْسٍ  أَبُو طَلْحَةَ ، وَاسْمُهُ زَيْدُ بْنُ سَهْلِ بْنِ الْأَسْوَدِ بْنِ حَرَامِ بْنِ عَمْرِو بْنِ زَيْدِ مَنَاةَ بْنِ عَدِيِّ بْنِ عَمْرِو بْنِ مَالِكٍ  .","","Al-Mu'jam al-Kabir 4673","","","زيد بن سهل"
"4677","4674  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ فُسْتُقَةُ ،  ثَنَا  الْحُسَيْنُ بْنُ عَلِيٍّ الصُّدَائِيُّ  ، عَنْ  يَعْقُوبَ بْنِ إِبْرَاهِيمَ بْنِ سَعِيدٍ  ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ إِسْحَاقَ  قَالَ : ""  أَبُو طَلْحَةَ زَيْدُ بْنُ سَهْلِ بْنِ الْأَسْوَدِ بْنِ حَرَامِ بْنِ عَمْرِو بْنِ زَيْدِ مَنَاةَ بْنِ عَدِيِّ بْنِ عَمْرِو بْنِ مَالِكِ بْنِ النَّجَّارِ  ""  .","","Al-Mu'jam al-Kabir 4674","","","زيد بن سهل"
"4678","4675  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  يَقُولُ :  أَبُو طَلْحَةَ زَيْدُ بْنُ سَهْلٍ  ،  سَمِعْتُ  ابْنَ إِدْرِيسَ  يَقُولُ :  قَالَ لِي  بَعْضُ وَلَدِهِ  .","","Al-Mu'jam al-Kabir 4675","","","زيد بن سهل"
"4679","4676  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا         [5/91]      جَعْفَرُ بْنُ سُلَيْمَانَ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ قَالَ :  خَطَبَ  أَبُو طَلْحَةَ  أُمَّ سُلَيْمٍ  قَبْلَ أَنْ يُسْلِمَ ، فَقَالَتْ :  أَمَا إِنِّي فِيكَ لَرَاغِبَةٌ ، وَمَا مِثْلُكَ يُرَدُّ  ، وَلَكِنَّكَ رَجُلٌ كَافِرٌ وَأَنَا امْرَأَةٌ مُسْلِمَةٌ ، فَإِنْ تُسْلِمْ فَذَلِكَ مَهْرِي لَا أَسْأَلُكَ غَيْرَهُ ! فَأَسْلَمَ  أَبُو طَلْحَةَ  وَتَزَوَّجَهَا  "" .","","Al-Mu'jam al-Kabir 4676","","أنس بن مالك عن ثابت البناني عن جعفر بن سليمان الضبعي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","زيد بن سهل"
"4680","4677  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْفِطْرِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ قَالَ :  تَزَوَّجَ  أَبُو طَلْحَةَ  أُمَّ سُلَيْمٍ  ، وَكَانَ صَدَاقَ مَا بَيْنَهُمَا الْإِسْلَامُ  ، أَسْلَمَتْ  أُمُّ سُلَيْمٍ  قَبْلَ  أَبِي طَلْحَةَ  فَخَطَبَهَا ، فَقَالَتْ : إِنِّي قَدْ أَسْلَمْتُ ، فَإِنْ أَسْلَمْتَ نَكَحْتُكَ ! فَأَسْلَمَ ، وَكَانَ صَدَاقَ مَا بَيْنَهُمَا الْإِسْلَامُ  "" .","","Al-Mu'jam al-Kabir 4677","","عبد الله بن عبد الله بن أبي طلحة الأنصاري عن محمد بن موسى الفطري عن قتيبة بن سعيد عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","زيد بن سهل"
"4681","4678  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ،  ثَنَا  أَبِي  ،  ثَنَا  حَرْبُ بْنُ مَيْمُونٍ ،  عَنِ  النَّضْرِ بْنِ أَنَسٍ ،  عَنْ  أَنَسٍ  أَنَّ  أُمَّ سُلَيْمٍ  تَزَوَّجَتْ  أَبَا طَلْحَةَ  عَلَى إِسْلَامِهِ  "" .","","Al-Mu'jam al-Kabir 4678","","أنس بن مالك عن النضر بن أنس بن مالك الأنصاري عن حرب بن ميمون الأكبر عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زيد بن سهل"
"4682","4679  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  صَالِحُ بْنُ عَبْدِ اللهِ التِّرْمِذِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَبَّادِ بْنِ مَنْصُورٍ ،  عَنْ  أَنَسٍ قَالَ :  اتَّخَذَ  أَبُو طَلْحَةَ الْأَنْصَارِيُّ  مَسْجِدًا فِي دَارِهِ ، فَأَرْسَلَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  فَصَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِي  وَبِأَبِي طَلْحَةَ ،  وَأُمُّ سُلَيْمٍ  خَلْفَنَا  .","","Al-Mu'jam al-Kabir 4679","","أنس بن مالك عن عباد بن منصور الناجي عن سفيان بن عيينة عن صالح بن عبد الله بن ذكوان الترمذي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زيد بن سهل"
"4683","4680  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ قَالَ :  كَانَ أَبُو طَلْحَةَ لَا يَصُومُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ أَجْلِ الْغَزْوِ  ، فَلَمَّا قُبِضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ أَرَهُ يُفْطِرُ إِلَّا يَوْمَ أَضْحَى أَوْ يَوْمَ فِطْرٍ  "" .","","Al-Mu'jam al-Kabir 4680","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن ثابت البناني عن شعبة بن الحجاج عن علي بن الجعد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زيد بن سهل"
"4684","4681  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ  أَنَّ  أَبَا طَلْحَةَ  سَرَدَ  الصَّوْمَ بَعْدَ وَفَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى مَاتَ  "" .","","Al-Mu'jam al-Kabir 4681","","أنس بن مالك عن ثابت البناني عن حماد بن سلمة عن عبد الأعلى بن حماد النرسي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زيد بن سهل"
"4685","[5/92]      4682  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  آخَى بَيْنَ  أَبِي عُبَيْدَةَ  وَأَبِي طَلْحَةَ  .","","Al-Mu'jam al-Kabir 4682","","أنس بن مالك عن ثابت البناني عن حماد بن سلمة عن هدبة بن خالد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زيد بن سهل"
"4686","ذِكْرُ وَفَاةِ  أَبِي طَلْحَةَ  وَقَدِ اخْتُلِفَ فِي وَفَاتِهِ ؛ فَقِيلَ مَاتَ غَازِيًا فِي الْبَحْرِ ، وَقِيلَ مَاتَ  بِالْمَدِينَةِ  - فَأَمَّا مَنْ ذَكَرَ أَنَّهُ مَاتَ غَازِيًا فِي الْبَحْرِ :  4683  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ ،  ثَنَا  أَبِي  ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ وَعَلِيِّ بْنِ زَيْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  خَرَجَ أَبُو طَلْحَةَ غَازِيًا فِي الْبَحْرِ فَمَاتَ فِي السَّفِينَةِ  ، فَلَمْ يَجِدُوا لَهُ مَكَانًا يَدْفِنُونَهُ فِيهِ ، فَانْتَظَرُوا بِهِ سِتَّةَ أَيَّامٍ حَتَّى وَجَدُوا لَهُ بَعْدَ سَبْعٍ مَكَانًا يَدْفِنُونَهُ فِيهْ ، وَلَمْ يُغَيَّرْ كَمَا هُوَ  "" .  وَأَمَّا مَنْ قَالَ مَاتَ  بِالْمَدِينَةِ .","","Al-Mu'jam al-Kabir 4683","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن علي بن زيد بن جدعان عن حماد بن سلمة عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","ذكر وفاة أبي طلحة"
"4687","4684  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  قَالَ : ""  تُوُفِّيَ  أَبُو طَلْحَةَ  سَنَةَ أَرْبَعٍ وَثَلَاثِينَ ، وَصَلَّى عَلَيْهَ عُثْمَانُ بْنُ عَفَّانَ  - رَضِيَ اللهُ عَنْهُ - سَنَةَ سَبْعِينَ ، وَاسْمُهُ  زَيْدُ بْنُ سَهْلٍ  ""  .","","Al-Mu'jam al-Kabir 4684","","","ذكر وفاة أبي طلحة"
"4688","4685  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ  قَالَ : ""  مَاتَ  أَبُو طَلْحَةَ زَيْدُ بْنُ سَهْلٍ  سَنَةَ أَرْبَعٍ وَثَلَاثِينَ ،  وَصَلَّى عَلَيْهِ  عُثْمَانُ بْنُ عَفَّانَ ،  مَاتَ ابْنَ سَبْعِينَ سَنَةً ، وَقَدْ قِيلَ : إِنَّ  أَبَا طَلْحَةَ  مَاتَ سَنَةَ اثْنَتَيْنِ وَثَلَاثِينَ  ""  .","","Al-Mu'jam al-Kabir 4685","","","ذكر وفاة أبي طلحة"
"4689","مَا  أَسْنَدَ  أَبُو طَلْحَةَ  ابْنُ عَبَّاسٍ  عَنْ  أَبِي طَلْحَةَ         [5/93]      4686  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ :  سَمِعْتُ  أَبَا طَلْحَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةُ تَمَاثِيلَ  .","","Al-Mu'jam al-Kabir 4686","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ابن عباس عن أبي طلحة"
"4690","4687  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ  ، ثَنَا  الْهَيْثَمُ بْنُ مَرْوَانَ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ سُمَيْعٍ ،  ثَنَا  رَوْحُ بْنُ الْقَاسِمِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِي طَلْحَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .","","Al-Mu'jam al-Kabir 4687","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن معمر بن راشد عن روح بن القاسم العنبري عن محمد بن عيسى بن القاسم مولى معاوية بن أبي سفيان عن الهيثم بن مروان بن الهيثم العنسي عن أحمد بن محمد بن عبد الله البغدادي عن الطبراني","ابن عباس عن أبي طلحة"
"4691","4688  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو عَاصِمٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ، كِلَاهُمَا  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِي طَلْحَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .","","Al-Mu'jam al-Kabir 4688","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","ابن عباس عن أبي طلحة"
"4692","4689  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْقَعْنَبِيُّ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ - قَالُوا :  ثَنَا  سُفْيَانُ ،  ثَنَا  الزُّهْرِيُّ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِي طَلْحَةَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .","","Al-Mu'jam al-Kabir 4689","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","ابن عباس عن أبي طلحة"
"4693","4690  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ الْمِصْرِيُّ  ، حَدَّثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يُونُسُ بْنُ يَزِيدَ ،  عَنِ  ابْنِ شِهَابٍ ،  أَخْبَرَنِي  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ :  سَمِعْتُ  أَبَا طَلْحَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .","","Al-Mu'jam al-Kabir 4690","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن يونس بن يزيدالأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن هارون بن كامل المصري عن الطبراني","ابن عباس عن أبي طلحة"
"4694","[5/94]      4691  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ  أَنَّهُ سَمِعَ  ابْنَ عَبَّاسٍ يَقُولُ :  سَمِعْتُ  أَبَا طَلْحَةَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .","","Al-Mu'jam al-Kabir 4691","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","ابن عباس عن أبي طلحة"
"4695","4692  / 1  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  عُبَيْدُ بْنُ إِسْحَاقَ الْعَطَّارُ ،  ثَنَا  أَبُو مَرْيَمَ ،  عَنِ  الْوَلِيدِ بْنِ كَثِيرٍ ،  حَدَّثَنِي  ابْنُ شِهَابٍ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ أَنَّ عَبْدَ اللهِ بْنَ الْعَبَّاسِ  حَدَّثَهُ  أَنَّ  أَبَا طَلْحَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .","","Al-Mu'jam al-Kabir 4692","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن الوليد بن كثير المخزومي عن عبد الغفار بن القاسم الأنصاري عن عبيد بن إسحاق عطار المطلقات عن لحية الليف محمد بن العباس عن الطبراني","ابن عباس عن أبي طلحة"
"4696","4692  / 2  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْحَسَنِ الْحَوْرَانِيُّ ،  عَنِ  الْوَلِيدِ بْنِ مُسْلِمٍ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِي طَلْحَةَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .","","Al-Mu'jam al-Kabir 4692","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن عبد الرحمن بن الحسن السلمي عن علي بن سعيد بن بشير عليك عن الطبراني","ابن عباس عن أبي طلحة"
"4697","4693  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَخْبَرَنِي  أَبُو طَلْحَةَ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَرَنَ  بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  .","","Al-Mu'jam al-Kabir 4693","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن الحسن بن سعد مولى علي بن أبي طالب عن حجاج بن أرطاة عن أبو معاوية الضرير عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","ابن عباس عن أبي طلحة"
"4698","4694  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، حَدَّثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ وَأَبُو مُعَاوِيَةَ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ وَأَبُو مُعَاوِيَةَ ،  عَنْ  حَجَّاجٍ ،  عَنِ  الْحَسَنِ بْنِ سَعْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  حَدَّثَنِي  أَبُو طَلْحَةَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَرَنَ  بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  .","","Al-Mu'jam al-Kabir 4694","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن الحسن بن سعد مولى علي بن أبي طالب عن حجاج بن أرطاة عن أبو معاوية الضرير عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","ابن عباس عن أبي طلحة"
"4699","[5/95]      -  زَيْدُ بْنُ خَالِدٍ الْجُهَنِيُّ  عَنْ  أَبِي طَلْحَةَ  .  4695  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ - قَالَا :  ثَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنْ  زَيْدِ بْنِ خَالِدٍ ،  عَنْ  أَبِي طَلْحَةَ الْأَنْصَارِيِّ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا تِمْثَالٌ  .","","Al-Mu'jam al-Kabir 4695","","زيد بن سهل بن الأسود الأنصاري عن زيد بن خالد الجهني عن سعيد بن يسار مولى ميمونة زوج رسول الله عن سهيل بن أبي صالح السمان عن خالد بن عبد الله الطحان عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","زيد بن خالد الجهني عن أبي طلحة"
"4700","4696  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  لَيْثُ بْنُ سَعْدٍ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ ،  عَنْ  بِشْرِ بْنِ سَعِيدٍ  ،  عَنْ  زَيْدِ بْنِ خَالِدٍ الْجُهَنِيِّ ،  عَنْ  أَبِي طَلْحَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الْمَلَائِكَةَ لَا تَدْخُلُ بَيْتًا فِيهِ صُورَةٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بسر بن سعيد ) كما في سنن الدارقطني (284).","","Al-Mu'jam al-Kabir 4696","","زيد بن سهل بن الأسود الأنصاري عن زيد بن خالد الجهني عن بسر بن سعيد المدني عن بكير بن عبد الله بن الأشج القرشي عن الليث بن سعد عن قتيبة بن سعيد عن موسى بن هارون الحمال عن الطبراني","زيد بن خالد الجهني عن أبي طلحة"
"4701","4697  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  سَعِيدِ بْنِ يَسَارٍ ،  عَنْ  زَيْدِ بْنِ خَالِدٍ الْجُهَنِيِّ ،  عَنْ  أَبِي طَلْحَةَ الْأَنْصَارِيِّ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا تِمْثَالٌ  .","","Al-Mu'jam al-Kabir 4697","","زيد بن سهل بن الأسود الأنصاري عن زيد بن خالد الجهني عن سعيد بن يسار مولى ميمونة زوج رسول الله عن سهيل بن أبي صالح السمان عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","زيد بن خالد الجهني عن أبي طلحة"
"4702","4698  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ أَنَّ بُكَيْرَ بْنَ عَبْدِ اللهِ بْنِ الْأَشَجِّ  حَدَّثَهُ  أَنَّ بِشْرَ بْنَ سَعِيدٍ  حَدَّثَهُ  أَنَّ زَيْدَ بْنَ خَالِدٍ الْجُهَنِيَّ  حَدَّثَهُ  أَنَّ أَبَا طَلْحَةَ  حَدَّثَهُ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ صُورَةٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بسر بن سعيد ) كما في سنن الدارقطني (284).","","Al-Mu'jam al-Kabir 4698","","زيد بن سهل بن الأسود الأنصاري عن زيد بن خالد الجهني عن بسر بن سعيد المدني عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","زيد بن خالد الجهني عن أبي طلحة"
"4703","أَنَسُ بْنُ مَالِكٍ  عَنْ  أَبِي طَلْحَةَ  4699  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ  ، عَنْ  أَبِي طَلْحَةَ قَالَ :  كُنْتُ فِيمَنْ صُبَّ عَلَيْهِ النُّعَاسُ  يَوْمَ أُحُدٍ  "" .","","Al-Mu'jam al-Kabir 4699","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن عمران بن داور القطان عن عمرو بن مرزوق الباهلي عن أبو مسلم الكجي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4704","[5/96]      4700  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ  أَنَّهُ كَانَ مِمَّنْ غَشِيَهُ النُّعَاسُ يَوْمَئِذٍ ،  قَالَ : "" وَكَانَ السَّيْفُ يَسْقُطُ مِنْ يَدِهِ فَآخُذُهُ ، وَيَسْقُطُ مِنْ يَدِي ثُمَّ آخُذُهُ ؛ مِنَ النُّعَاسِ "" .","","Al-Mu'jam al-Kabir 4700","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن العباس بن الوليد النرسي عن عبد الله بن أحمد الجواليقي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4705","4701  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَيَّاشُ بْنُ الْوَلِيدِ الرَّقَّامُ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ بِبِضْعَةٍ وَثَلَاثِينَ [ رَجُلًا ] مِنْ  صَنَادِيدِ  قُرَيْشٍ  ، فَأُلْقُوا فِي  طَوِيٍّ  مِنْ أَطَاوِي  بَدْرٍ  حَيْثُ  جَيَّفَتْ  ، وَكَانَ إِذَا ظَهَرَ عَلَى قَوْمٍ أَقَامَ بِالْعَرْصَةِ ثَلَاثًا ، فَلَمَّا كَانَ الْيَوْمُ الثَّالِثُ أَمَرَ بِرَاحِلَتِهِ فَشُدَّ عَلَيْهَا رَحْلُهَا ثُمَّ مَشَى ، وَاتَّبَعَهُ أَصْحَابُهُ ، قَالُوا : مَا نَرَاهُ مُنْطَلِقًا إِلَّا لِبَعْضِ حَاجَتِهِ ! ثُمَّ أَتَى شُقَّةَ الْبِئْرِ فَقَالَ : "" يَا  فُلَانَ بْنَ فُلَانٍ  وَيَا  فُلَانَ بْنَ فُلَانٍ ،  وَدِدْتُمْ أَنَّكُمْ كُنْتُمْ أَطَعْتُمُ اللهَ وَرَسُولَهُ ، فَهَلْ وَجَدْتُمْ مَا وَعَدَ رَبُّكُمْ حَقًّا فَقَدْ وَجَدْنَا مَا وَعَدَنَا رَبُّنَا حَقًّا "" ، قَالَ  عُمَرُ  : يَا رَسُولَ اللهِ ، أَتُكَلِّمُ أَجْسَادًا لَا أَرْوَاحَ فِيهَا ؟ قَالَ :  وَالَّذِي نَفْسُ  مُحَمَّدٍ  بِيَدِهِ مَا أَنْتُمْ بِأَسْمَعَ لِمَا أَقُولُ مِنْهُمْ  ، قَالَ  سَعِيدٌ  : قَالَ  قَتَادَةُ  : "" أَحْيَاهُمُ اللهُ - وَاللهِ - لَهُ حَتَّى سَمِعُوا قَوْلَهُ  .","","Al-Mu'jam al-Kabir 4701","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن عياش بن الوليد الرقام عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4706","4702  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُعَاذُ بْنُ مُعَاذٍ وَعَبْدُ الْأَعْلَى (  ح  ) .  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  مُعَاذُ بْنُ مُعَاذٍ - قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا غَلَبَ قَوْمًا أَحَبَّ أَنْ يُقِيمَ بِعَرْصَتِهِمْ  ثَلَاثَةَ أَيَّامٍ أَوْ ثَلَاثَ لَيَالٍ  .","","Al-Mu'jam al-Kabir 4702","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن سعيد بن أبي عروبة عن معاذ بن معاذ بن نصر عن قتيبة بن سعيد عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4707","[5/97]      4703  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ  ، ثَنَا  أَبُو الْجُمَاهِرِ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لَمَّا  صَبَّحَ  خَيْبَرَ  تَلَا هَذِهِ الْآيَةَ إِنَّا إِذَا نَزَلْنَا بِسَاحَةِ قَوْمٍ         {      فَسَاءَ صَبَاحُ الْمُنْذَرِينَ         }      .","","Al-Mu'jam al-Kabir 4703","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن عثمان الكفرسوسي عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4708","4704  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا  صَبَّحَ  خَيْبَرَ  وَقَدْ أَخَذُوا  مَسَاحِيَهُمْ  وَمَكَاتِلَهُمْ  وَغَدَوْا عَلَى حُرُوثِهِمْ ، فَلَمَّا رَأَوْا نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَعَهُ الْخَمِيسُ نَكَصُوا مُدْبِرِينَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اللهُ أَكْبَرُ ، اللهُ أَكْبَرُ ، اللهُ أَكْبَرُ ، خَرِبَتْ  خَيْبَرُ ،  إِنَّا إِذَا نَزَلْنَا بِسَاحَةِ قَوْمٍ         {      فَسَاءَ صَبَاحُ الْمُنْذَرِينَ         }      .","","Al-Mu'jam al-Kabir 4704","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن أمية بن بسطام عن إبراهيم بن هاشم البغوي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4709","4705  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ الْعَنْسِيُّ ،  ثَنَا  ثَابِتٌ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ :  كُنْتُ رَدِيفَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَوْ قُلْتُ إِنَّ رُكْبَتِي تَمَسُّ رُكْبَتَهُ ، فَسَكَتَ عَنْهُمْ ، حَتَّى إِذَا كَانَ عِنْدَ السَّحَرِ وَذَهَبَ ذُو الضَّرْعِ إِلَى ضَرْعِهِ وَذُو الزَّرْعِ إِلَى زَرْعِهِ  أَغَارَ عَلَيْهِمْ وَقَالَ : "" إِنَّا إِذَا نَزَلْنَا بِسَاحَةِ قَوْمٍ         {      فَسَاءَ صَبَاحُ الْمُنْذَرِينَ         }      .","","Al-Mu'jam al-Kabir 4705","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن ثابت البناني عن سليمان بن المغيرة القيسي عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4710","4706  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو وَعَبْدُ اللهِ بْنُ الْحُسَيْنِ الْمِصِّيصِيُّ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ الدِّمَشْقِيُّ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ :  سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ فِي تَلْبِيَتَهِ :  لَبَّيْكَ بِحَجَّةٍ وَعُمْرَةٍ مَعًا  .","","Al-Mu'jam al-Kabir 4706","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن بكار العاملي عن عبد الله بن الحسين بن جابر المصيصي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4711","4707  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ خَلَّادٍ الْبَاهِلِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي         [5/98]      طَلْحَةَ قَالَ :  رَمَقْتُ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابَهُ  يَوْمَ أُحُدٍ ،  فَلَمْ أَرَ أَحَدًا إِلَّا وَهُوَ يَمَلُّ تَحْتَ جُحْفَتِهِ مِنَ النُّعَاسِ  .","","Al-Mu'jam al-Kabir 4707","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن ثابت البناني عن حماد بن سلمة عن عبد الرحمن بن مهدي عن محمد بن خلاد الباهلي عن الحسن بن علي بن شبيب المعمري عن الطبراني","أنس بن مالك عن أبي طلحة"
"4712","4708  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْمَعْمَرِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ خَلَّادٍ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ :  كُنْتُ فِيمَنْ صُبَّ عَلَيْهِ النُّعَاسُ  يَوْمَ أُحُدٍ  "" .","","Al-Mu'jam al-Kabir 4708","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن حميد الطويل عن محمد بن إبراهيم بن أبي عدي القسملي عن محمد بن خلاد الباهلي عن الحسن بن علي بن شبيب المعمري عن الطبراني","أنس بن مالك عن أبي طلحة"
"4713","4709  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  ثَنَا  ثَابِتٌ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  جَزَاكُمُ اللهُ يَا مَعْشَرَ  الْأَنْصَارِ  خَيْرًا  ، فَإِنَّكُمْ مَا عَلِمْتُ  أَعِفَّةٌ  صُبُرٌ  .","","Al-Mu'jam al-Kabir 4709","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن ثابت البناني عن الحسن بن أبي جعفر الجفري عن مسلم بن إبراهيم الشحام عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4714","4710  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ وَزَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ، قَالَا :  ثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ الصَّفَّارُ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  ثَنَا  مُحَمَّدُ بْنُ ثَابِتٍ الْبُنَانِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَقْرِئْ قَوْمَكَ السَّلَامَ ؛ فَإِنَّهُمْ مَا عَلِمْتُ  أَعِفَّةٌ  صُبُرٌ  .","","Al-Mu'jam al-Kabir 4710","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن ثابت البناني عن محمد بن ثابت بن أسلم البناني عن عبد الصمد بن عبد الوارث التنوري عن عبدة بن عبد الله بن عبدة الخزاعي عن الساجي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4715","4711  -  حَدَّثَنَا  زَكَرِيَّا بْنُ حَمْدَوَيْهِ الصَّفَّارُ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ قَالَا :  ثَنَا  هَمَّامٌ قَالَ : قِيلَ لِمَطَرٍ وَأَنَا عِنْدَهُ : مِمَّنْ أَخَذَ الْحَسَنُ  الْوُضُوءُ مِمَّا مَسَّتِ النَّارُ  ؟  فَقَالَ  : أَخَذَهُ  عَنْ  أَنَسٍ ، وَأَخَذَهُ  أَنَسٌ  عَنْ  أَبِي طَلْحَةَ ، وَأَخَذَهُ  أَبُو طَلْحَةَ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Al-Mu'jam al-Kabir 4711","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن الحسن البصري عن مطر بن طهمان الوراق عن همام بن يحيى بن دينار عن عفان بن مسلم الصفار عن زكريا بن حمدويه الصفار عن الطبراني","أنس بن مالك عن أبي طلحة"
"4716","4712  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  إِسْمَاعِيلَ السُّدِّيِّ ،  عَنْ  يَحْيَى بْنِ عَبَّادٍ  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ  أَنَّهُ ابْتَاعَ خَمْرًا لِأَيْتَامٍ فَلَمَّا حُرِّمَتِ الْخَمْرُ قَالَ :  يَا رَسُولَ اللهِ أَتَّخِذُهَا خَلًّا ؟ قَالَ : "" لَا  .         [5/99]","","Al-Mu'jam al-Kabir 4712","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن يحيى بن عباد بن شيبان الأنصاري عن السدي الكبير عن قيس بن الربيع الأسدي عن أبو الوليد الطيالسي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أنس بن مالك عن أبي طلحة"
"4717","4713  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ حَيَّانَ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنِ  السُّدِّيِّ ،  عَنْ  أَبِي هُبَيْرَةَ يَحْيَى بْنِ عَبَّادٍ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 4713","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن يحيى بن عباد بن شيبان الأنصاري عن السدي الكبير عن سفيان الثوري عن عبد الصمد بن حيان عن بشر بن موسى بن صالح الأسدي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4718","4714  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  مُعْتَمِرٌ ،  عَنْ  لَيْثٍ ،  عَنْ  يَحْيَى بْنِ عَبَّادٍ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي اشْتَرَيْتُ خَمْرًا لِأَيْتَامٍ فِي حَجْرِي ! فَقَالَ :  أَهْرِقِ الْخَمْرَ وَاكْسِرِ الدِّنَانَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ إِنَّهَا لِأَيْتَامٍ ! قَالَ : "" أَهْرِقِ الْخَمْرَ وَاكْسِرِ الدِّنَانَ  .","","Al-Mu'jam al-Kabir 4714","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن يحيى بن عباد بن شيبان الأنصاري عن ليث بن أبي سليم عن معتمر بن سليمان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أنس بن مالك عن أبي طلحة"
"4719","4715  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي الشَّوَارِبِ ،  ثَنَا  عُمَرُ بْنُ رُدَيْحٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الْخَلِيطَيْنِ  .","","Al-Mu'jam al-Kabir 4715","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن عطاء بن أبي ميمونة البصرى عن عمر بن رديح البصري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن الساجي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4720","4716  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدِ بْنِ الْحَرِيشِ الْأَهْوَازِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ بْنِ أَبِي الشَّوَارِبِ ،  ثَنَا  عُمَرُ بْنُ رُدَيْحٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي مَيْمُونَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الْأَقْرَانِ  .","","Al-Mu'jam al-Kabir 4716","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن عطاء بن أبي ميمونة البصرى عن عمر بن رديح البصري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن أحمد بن زيد بن الحريش الأهوازي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4721","4717  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  أَخِي سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ صَلَّى عَلَيَّ صَلَاةً صَلَّى اللهُ عَلَيْهِ عَشْرًا  .","","Al-Mu'jam al-Kabir 4717","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن ثابت البناني عن عبيد الله بن عمر العمري عن سليمان بن بلال القرشي عن إسماعيل بن أبي أويس عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4722","4718  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ وَأَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ         [5/100]      قَالَا :  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  ثَنَا  جَسْرُ بْنُ فَرْقَدٍ ،  عَنْ  ثَابِتٍ  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَيْتُهُ طَيِّبَ النَّفْسِ حَسَنَ الْبِشْرِ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا رَأَيْتُكَ أَطْيَبَ نَفْسًا مِنْكَ الْيَوْمَ ، فَقَالَ :  وَمَا يَمْنَعُنِي وَالْمَلِكُ خَبَّرَنِي أَنَّهُ مَنْ صَلَّى عَلَيْكَ صَلَّيْتُ عَلَيْهِ أَنَا وَمَلَائِكَتِي عَشْرًا  ، وَمَنْ سَلَّمَ عَلَيْكَ سَلَّمْتُ عَلَيْهِ أَنَا وَمَلَائِكَتِي عَشْرًا  .","","Al-Mu'jam al-Kabir 4718","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن ثابت البناني عن جسر بن فرقد القصاب عن مسلم بن إبراهيم الشحام عن أحمد بن داود بن موسى السدوسي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4723","4719  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ الْبَغَوِيُّ ،  ثَنَا  صَالِحُ بْنُ مَالِكٍ الْخُوَارَزْمِيُّ ،  حَدَّثَنَا  صَالِحٌ الْمُرِّيُّ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَيْتُ مِنْ بِشْرِهِ وَطَلَاقَتِهِ شَيْئًا لَمْ أَرَهُ عَلَى مِثْلِ تِلْكَ الْحَالِ قَطُّ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا رَأَيْتُكَ عَلَى مِثْلِ هَذِهِ الْحَالِ قَطُّ ، فَقَالَ : "" وَمَا يَمْنَعُنِي يَا  أَبَا طَلْحَةَ  وَقَدْ خَرَجَ مِنْ عِنْدِي  جِبْرِيلُ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - آنِفًا فَأَتَانِي بِبِشَارَةٍ مِنْ رَبِّي قَالَ :  إِنَّ اللهَ بَعَثَنِي إِلَيْكَ أُبَشِّرُكَ أَنَّهُ لَيْسَ أَحَدٌ مِنْ أُمَّتِكَ يُصَلِّي عَلَيْكَ صَلَاةً إِلَّا صَلَّى اللهُ وَمَلَائِكَتُهُ عَلَيْهِ  بِهَا عَشْرًا  .","","Al-Mu'jam al-Kabir 4719","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن ثابت البناني عن صالح بن بشير المري عن صالح بن مالك الخوارزمي عن أبو القاسم البغوي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4724","4720  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ اللهِ الْفَرْغَانِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْوَلِيدِ الطَّبَرَانِيُّ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنِي  عَبْدُ الْعَزِيزِ بْنُ أَبِي سَلَمَةَ الْمَاجِشُونُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَسَارِيرُ  وَجْهِهِ  تَبْرُقُ  فَقُلْتُ : يَا رَسُولَ اللهِ مَا رَأَيْتُكَ أَطْيَبَ نَفْسًا وَلَا أَظْهَرَ بِشْرًا مِنْكَ فِي يَوْمِكَ هَذَا ، فَقَالَ :  وَمَا لِي لَا تَطِيبُ نَفْسِي وَلَا يَظْهَرُ بِشْرِي وَإِنَّمَا فَارَقَنِي  جِبْرِيلُ  - عَلَيْهِ السَّلَامُ  - السَّاعَةَ فَقَالَ : يَا  مُحَمَّدُ  مَنْ صَلَّى عَلَيْكَ مِنْ أُمَّتِكَ صَلَاةً كَتَبَ اللهُ لَهُ بِهَا عَشْرَ حَسَنَاتٍ وَمَحَا عَنْهُ عَشْرَ سَيِّئَاتٍ وَرَفَعَهُ بِهَا عَشْرَ دَرَجَاتٍ وَقَالَ لَهُ الْمَلَكُ مِثْلَ مَا قَالَ لَكَ ، قُلْتُ : يَا  جِبْرِيلُ  وَمَا ذَاكَ الْمَلَكُ ؟ قَالَ : إِنَّ اللهَ - عَزَّ وَجَلَّ - وَكَّلَ بِكَ مَلَكًا مِنْ لَدُنْ         [5/101]      خَلْقِكَ إِلَى أَنْ يَبْعَثَكَ لَا يُصَلِّي عَلَيْكَ أَحَدٌ مِنْ أُمَّتِكَ إِلَّا قَالَ : وَأَنْتَ صَلَّى اللهُ عَلَيْكَ  .","","Al-Mu'jam al-Kabir 4720","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن الزهري عن عبد العزيز بن عبد الله الماجشون عن الوليد بن سلمة الأردني عن إبراهيم بن الوليد الطبراني عن الفرغاني علي بن عبد الله بن عبد البر عن الطبراني","أنس بن مالك عن أبي طلحة"
"4725","4721  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  حَمَّادُ بْنُ عَمْرٍو النَّصِيبِيُّ ،  ثَنَا  زَيْدُ بْنُ رُفَيْعٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أَبِي طَلْحَةَ قَالَ :  أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَتَهَلَّلُ وَجْهُهُ مُسْتَبْشِرًا فَقُلْتُ : أَيْ رَسُولَ اللهِ إِنَّكَ لَعَلَى حَالٍ مَا رَأَيْتُكَ عَلَى مِثْلِهَا ، قَالَ : "" وَمَا يَمْنَعُنِي أَتَانِي  جِبْرِيلُ  - عَلَيْهِ السَّلَامُ - آنِفًا فَقَالَ : بَشِّرْ أُمَّتَكَ أَنَّهُ  مَنْ صَلَّى عَلَيْكَ صَلَاةً كُتِبَ لَهُ بِهَا عَشْرُ حَسَنَاتٍ  وَكُفِّرَ عَنْهُ بِهَا عَشْرُ سَيِّئَاتٍ وَرُفِعَ لَهُ بِهَا عَشْرُ دَرَجَاتٍ وَرَدَّ اللهُ عَلَيْهِ مِثْلَ قَوْلِهِ وَعُرِضَتْ عَلَيْهِ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 4721","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن الزهري عن زيد بن رفيع مولى أسماء بن خارجة عن حماد بن عمرو النصيبي عن سليمان بن داود العتكي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4726","4722  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ ، قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ أَنَّ أَبَانَ بْنَ أَبِي عَيَّاشٍ  أَخْبَرَهُمْ  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أَبِي طَلْحَةَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَتَى عَلَى  رَجُلٍ  وَهُوَ يَقُولُ : اللَّهُمَّ إِنِّي أَسْأَلُكَ بِأَنَّ لَكَ الْحَمْدَ لَا إِلَهَ إِلَّا أَنْتَ الْمَنَّانُ بَدِيعُ السَّمَاوَاتِ وَالْأَرْضِ ذُو  الْجَلَالِ  وَالْإِكْرَامِ ، فَقَالَ :  لَقَدْ سَأَلَ اللهَ بِالِاسْمِ الَّذِي إِذَا دُعِيَ بِهِ أَجَابَ  .","","Al-Mu'jam al-Kabir 4722","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن أبان بن أبي عياش عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","أنس بن مالك عن أبي طلحة"
"4727","4723  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  هَارُونُ بْنُ مُوسَى بْنِ رَاشِدٍ الْمُسْتَمْلِي الْكَبِيرُ مُكْحُلَةُ ،  ثَنَا  عُمَرُ بْنُ أَيُّوبَ الْمَوْصِلِيُّ ،  عَنْ  مَصَادِ بْنِ عُقْبَةَ ،  عَنْ  يَحْيَى بْنِ أَبِي إِسْحَاقَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أَبِي طَلْحَةَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الصَّدَقَةُ عَلَى الْمِسْكِينِ صَدَقَةٌ ،  وَعَلَى ذِي الرَّحِمِ صَدَقَةٌ وَصِلَةٌ  .","","Al-Mu'jam al-Kabir 4723","","زيد بن سهل بن الأسود الأنصاري عن أنس بن مالك عن يحيى بن أبي إسحاق الهنائي عن مصاد بن عقبة عن عمر بن أيوب الموصلي عن مكحلة هارون بن سفيان عن علي بن سعيد بن بشير عليك عن الطبراني","أنس بن مالك عن أبي طلحة"
"4728","[5/102]      عَبْدُ اللهِ بْنُ أَبِي طَلْحَةَ  عَنْ أَبِيهِ  4724  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ إِبْرَاهِيمَ الطَّيَالِسِيُّ وَعُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ قَالَا :  ثَنَا  أَبُو الْوَلِيدِ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ - قَالُوا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  سُلَيْمَانَ مَوْلَى الْحَسَنِ بْنِ عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا وَالْبِشْرُ يُرَى فِي وَجْهِهِ فَقِيلَ : يَا رَسُولَ اللهِ إِنَّا نَرَى فِي وَجْهِكَ بِشْرًا لَمْ نَكُنْ نَرَاهُ قَالَ : "" إِنَّ مَلَكًا أَتَانِي فَقَالَ : إِنَّ رَبَّكَ يَقُولُ لَكَ :  أَمَا تَرْضَى أَوْ أَلَا يُرْضِيكَ  أَنْ لَا يُصَلِّيَ عَلَيْكَ أَحَدٌ مِنْ أُمَّتِكَ إِلَّا صَلَّيْتُ عَلَيْهِ عَشْرًا  ؟ وَلَا يُسَلِّمُ عَلَيْكَ إِلَّا سَلَّمْتُ عَلَيْهِ عَشْرًا ؟ قُلْتُ : بَلَى  .","","Al-Mu'jam al-Kabir 4724","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن أبي طلحة البخاري عن سليمان الهاشمي مولى الحسن بن علي عن ثابت البناني عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن أبي طلحة عن أبيه"
"4729","4725  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ الْجَوْهَرِيُّ وَزَكَرِيَّا بْنُ حَمْدَوَيْهِ الصَّفَّارُ قَالَا :  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ - قَالَا :  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  عُثْمَانُ بْنُ حَكِيمٍ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  كُنَّا جُلُوسًا عَلَى الْأَفْنِيَةِ فَمَرَّ بِنَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  مَا لَكُمْ وَالْجُلُوسَ عَلَى  الصُّعُدَاتِ  ؟ "" فَقُلْنَا : يَا رَسُولَ اللهِ ، إِنَّا جَلَسْنَا نَتَحَدَّثُ نَذْكُرُ اللهَ قَالَ : "" فَأَعْطُوا الْمَجَالِسَ حَقَّهَا "" قُلْنَا : يَا رَسُولَ اللهِ وَمَا حَقُّهَا ؟ قَالَ : "" غَضُّ الْبَصَرِ وَرَدُّ السَّلَامِ وَإِهْدَاءُ السَّبِيلِ وَحُسْنُ الْكَلَامِ  .","","Al-Mu'jam al-Kabir 4725","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن أبي طلحة البخاري عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن عثمان بن حكيم الأحلافي عن عبد الواحد بن زياد عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن أبي طلحة عن أبيه"
"4730","4726  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ، وَأَحْمَدُ بْنُ عَبْدِ اللهِ الْبَزَّارُ         [5/103]      التُّسْتَرِيُّ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ مِسْكِينٍ الْيَمَانِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ جَنَاحٍ ،  ثَنَا  يَحْيَى بْنُ شُعْبَةَ قَالَ :  سَمِعْتُ  إِسْحَاقَ بْنَ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ  يُحَدِّثُ عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ غَسَلَ وَاغْتَسَلَ وَغَدَا وَابْتَكَرَ وَدَنَا مِنَ الْإِمَامِ  فَأَنْصَتَ  وَلَمْ يَلْغُ فِي يَوْمِ الْجُمُعَةِ كَتَبَ اللهُ لَهُ بِكُلِّ خُطْوَةٍ خَطَاهَا إِلَى الْمَسْجِدِ صِيَامَ سَنَةٍ وَقِيَامَهَا  .","","Al-Mu'jam al-Kabir 4726","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن أبي طلحة البخاري عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن يحيى القطان عن إبراهيم بن محمد بن جناح عن محمد بن مسكين بن نميلة اليمامي عن أحمد بن عبد الله البزاز عن الطبراني","عبد الله بن أبي طلحة عن أبيه"
"4731","4727  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  أَبِيهِ  أَنَّ  أَبَا طَلْحَةَ  دَعَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  عُمَيْرِ بْنِ طَلْحَةَ  حِينَ تُوُفِّيَ ،  فَأَتَاهُمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَلَّى عَلَيْهِ فِي مَنْزِلِهِ ،  فَتَقَدَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ  أَبُو طَلْحَةَ  وَرَاءَهُ  وَأُمُّ سُلَيْمٍ  لَمْ يَكُنْ مَعَهُمْ غَيْرُهُمْ  .","","Al-Mu'jam al-Kabir 4727","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن أبي طلحة البخاري عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن عمارة بن غزية عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عبد الله بن أبي طلحة عن أبيه"
"4732","4728  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي  ، ثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  ثَنَا  حَرَمِيُّ بْنُ عُمَارَةَ ،  حَدَّثَنَا  شُعْبَةُ ،  عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  ابْنِ أَبِي طَلْحَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَوَضَّئُوا مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 4728","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن أبي طلحة البخاري عن الزهري عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن شعبة بن الحجاج عن حرمي بن عمارة العتكي عن نصر بن علي بن نصر الجهضمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عبد الله بن أبي طلحة عن أبيه"
"4733","4729  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ ،  ثَنَا  حَاتِمٌ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي مُزَرِّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ أَبِي طَلْحَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي طَلْحَةَ  قَالَ :  دَخَلْتُ الْمَسْجِدَ فَعَرَفْتُ فِي وَجْهِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْجُوعَ ، فَسَأَلْتُ  أُمَّ سُلَيْمٍ  هَلْ عِنْدَكَ مِنْ شَيْءٍ ؟ فَأَشَارَتْ بِكَفَّيْهَا ، فَقَالَتْ : عِنْدِي شَيْءٌ ، فَقُلْتُ : اصْنَعِي اعْجِنِي وَأَرْسَلْتُ  أَنَسًا  ، فَقُلْتُ : ائْتِهِ فَسَارِّهِ فِي أُذُنِهِ وَادْعُهُ ، فَلَمَّا أَقْبَلَ  أَنَسٌ  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَذَا رَجُلٌ قَدْ أَتَاكُمْ بِخَيْرٍ ، بِأَيِّ شَيْءٍ أَرْسَلَكَ أَبُوكَ يَدْعُونَا  ؟ "" قَالَ  أَنَسٌ  : نَعَمْ ، فَاسْتَقْبَلْتُهُ قَالَ : "" قُومُوا بِسْمِ اللهِ "" فَأَدْبَرَ  أَنَسٌ  يَشْتَدُّ حَتَّى أَتَى  أَبَا طَلْحَةَ  ، فَقَالَ : هَذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ أَتَاكَ فِي النَّاسِ ، قَالَ  أَبُو طَلْحَةَ  : فَاسْتَقْبَلْتُهُ عِنْدَ الْبَابِ عَلَى مُسْتَرَاحِ الدَّرَجَةِ ، فَقُلْتُ : مَاذَا صَنَعْتَ بِنَا يَا رَسُولَ اللهِ ؟         [5/104]      إِنَّمَا عَرَفْتُ فِي وَجْهِكَ الْجُوعَ ، فَصَنَعْتُ لَكَ شَيْئًا تَأْكُلُهُ ، فَقَالَ : "" ادْخُلْ وَأَبْشِرْ "" فَدَخَلَ فَأَتَى بَصَحْفَتِهِمْ فَجَعَلَ يُسَوِّيهَا بِيَدِهِ ثُمَّ قَالَ : "" هَلْ مِنْ كَايِنَةٍ ؟  يَعْنِي الْأُدْمَ  ، فَأَتَوْهُ  بِعُكَّتِهِمْ  فِيهَا شَيْءٌ أَوْ لَيْسَ فِيهَا  ، فَقَالَ بِيَدِهِ فَانْسَكَبَ مِنْهَا السَّمْنُ فَقَالَ : "" أَدْخِلْ عَلَيَّ عَشَرَةً عَشَرَةً ، "" قَالَ : وَهُمْ  زُهَاءُ  مِائَةٍ ، فَدَخَلُوا فَأَكَلُوا حَتَّى شَبِعُوا ، وَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِلْفَضْلِ الَّذِي فَضَلَ : "" كُلُوا أَنْتُمْ وَعِيَالُكُمْ "" فَأَكَلُوا وَشَبِعُوا  .","","Al-Mu'jam al-Kabir 4729","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن أبي طلحة البخاري عن عبد الله بن عبد الله بن أبي طلحة الأنصاري عن معاوية بن أبي مزرد الهاشمي عن حاتم بن إسماعيل الحارثي عن محمد بن عباد بن الزبرقان المكي عن إبراهيم بن هاشم البغوي عن الطبراني","عبد الله بن أبي طلحة عن أبيه"
"4734","عَبْدُ اللهِ بْنُ عَبْدٍ الْقَارِيُّ  عَنْ  أَبِي طَلْحَةَ  4730  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  عَمِّي  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ ،  عَنْ  عَبْدِ اللهِ عَبْدِ بْنِ الْقَارِيِّ ،  عَنْ  أَبِي طَلْحَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  تَوَضَّئُوا مِمَّا مَسَّتِ النَّارُ  .","","Al-Mu'jam al-Kabir 4730","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عمرو بن عبد المخزومي عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن عبد القاري عن أبي طلحة"
"4735","عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ  عَنْ  أَبِي طَلْحَةَ  4731  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  أَبِي النَّضْرِ مَوْلَى عُمَرَ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ بْنِ مَسْعُودٍ  أَنَّهُ دَخَلَ عَلَى أَبِي طَلْحَةَ الْأَنْصَارِيِّ يَعُودُهُ قَالَ : فَوَجَدْنَا عِنْدَهُ  سَهْلَ بْنَ حُنَيْفٍ  ، قَالَ : فَدَعَا  أَبُو طَلْحَةَ  إِنْسَانًا  فَنَزَعَ نَمَطًا كَانَ تَحْتَهُ ، فَقَالَ لَهُ سَهْلُ بْنُ حُنَيْفٍ : لِمَ تَنْزِعُهُ ؟  قَالَ  : لِأَنَّ فِيهِ تَصَاوِيرَ وَقَدْ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيهَا مَا قَدْ عَلِمْتَهُ ،  فَقَالَ  سَهْلٌ  : أَوَلَمْ يَقُلْ :  إِلَّا مَا كَانَ رَقْمًا فِي ثَوْبٍ  ؟ "" فَقَالَ : بَلَى ، وَلَكِنَّهُ أَطْيَبُ لِنَفْسِي  .","","Al-Mu'jam al-Kabir 4731","","سهل بن حنيف الأوسي عن عبيد الله بن عبد الله بن عتبة بن مسعود عن سالم بن أبي أمية التيمي عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيد الله بن عبد الله بن عتبة عن أبي طلحة"
"4736","4732  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  سَالِمٍ أَبِي النَّضْرِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ قَالَ :  انْصَرَفْتُ مَعَ عُثْمَانَ بْنِ حُنَيْفٍ إِلَى أَبِي طَلْحَةَ نَعُودُهُ فَوَجَدْنَا تَحْتَهُ نَمَطًا فِيهِ صُوَرٌ فَلَمَّا جَلَسْنَا قَالَ : انْزِعُوا هَذَا عَنَّا ،  فَقَالَ  لَهُ  عُثْمَانُ  : "" أَمَا سَمِعْتَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَنْهَى عَنِ الصُّوَرِ إِلَّا  رَقْمًا فِي ثَوْبٍ أَوْ         [5/105]      ثَوْبًا فِيهِ رَقْمٌ  ؟ قَالَ : بَلَى ، وَلَكِنِّي أَكْرَهُهُ ، فَنَزَعَهُ  .","","Al-Mu'jam al-Kabir 4732","","زيد بن سهل بن الأسود الأنصاري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن سالم بن أبي أمية التيمي عن محمد بن إسحاق عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عبيد الله بن عبد الله بن عتبة عن أبي طلحة"
"4737","4733  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي النَّضْرِ ،  عَنْ  عَبْدِ اللهِ الْخَوْلَانِيِّ ،  عَنْ  أَبِي طَلْحَةَ ، صَاحِبِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ دَخَلَ عَلَى  سَهْلٍ  وَهُوَ مَرِيضٌ ، وَتَحْتَ  سَهْلٍ  نَمَطٌ فِيهِ تَمَاثِيلُ ، فَقَالَ  سَهْلٌ  : انْزِعُوا مِنْ تَحْتِي هَذَا النَّمَطَ ،  فَقَالَ  أَبُو طَلْحَةَ  : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي التَّصَاوِيرِ :  لَا تَدْخُلُهُ الْمَلَائِكَةُ إِلَّا مَا كَانَ مِنْ رَقْمٍ فِي ثَوْبٍ فَلَا بَأْسَ بِهِ  قَالَ  سَهْلٌ  : وَإِنْ كَانَ فَانْزِعُوهُ  .","","Al-Mu'jam al-Kabir 4733","","زيد بن سهل بن الأسود الأنصاري عن عبيد الله بن الأسود الخولاني عن سالم بن أبي أمية التيمي عن عبد الله بن لهيعة عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","عبيد الله بن عبد الله بن عتبة عن أبي طلحة"
"4738","أَبُو عَبْدِ الرَّحْمَنِ الزُّهْرِيُّ  عَنْ  أَبِي طَلْحَةَ  4734  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  يَعْقُوبُ بْنُ عَبْدِ الرَّحْمَنِ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  أَبِي طَلْحَةَ ، قَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكَلَ  أَثْوَارَ  أَقِطٍ فَتَوَضَّأَ مِنْهُ  .","","Al-Mu'jam al-Kabir 4734","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عبد الرحمن بن عبد القاري عن محمد بن عبد الله بن عبد الرحمن بن عبد المدنى عن عبد الرحمن بن محمد الإسكندراني عن يعقوب بن عبد الرحمن الإسكندراني عن سعيد بن منصور عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو عبد الرحمن الزهري عن أبي طلحة"
"4739","إِسْمَاعِيلُ بْنُ بَشِيرِ بْنِ مَغَالَةَ  عَنْ  أَبِي طَلْحَةَ  4735  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ بْنِ بُكَيْرٍ - قَالَا :  ثَنَا  اللَّيْثُ ،  حَدَّثَنِي  يَحْيَى بْنُ سُلَيْمِ بْنِ زَيْدٍ مَوْلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ سَمِعَ  إِسْمَاعِيلَ بْنَ بَشِيرٍ مَوْلَى بَنِي مَغَالَةَ يَقُولُ :  سَمِعْتُ  جَابِرَ بْنَ عَبْدِ اللهِ وَأَبَا طَلْحَةَ بْنَ سَهْلٍ الْأَنْصَارِيَّيْنِ يَقُولَانِ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنِ امْرِئٍ يَخْذُلُ مُسْلِمًا فِي مَوْطِنٍ يُنْتَقَصُ فِيهِ مِنْ عِرْضِهِ  وَيُنْتَهَكُ  فِيهِ مِنْ  حُرْمَتِهِ  إِلَّا خَذَلَهُ اللهُ فِي مَوْطِنٍ يُحِبُّ فِيهِ نُصْرَتَهُ ، وَمَا مِنْ أَحَدٍ يَنْصُرُ مُسْلِمًا فِي مَوْطِنٍ يُنْتَقَصُ فِيهِ مِنْ عِرْضِهِ  وَيُنْتَهَكُ  فِيهِ مِنْ  حُرْمَتِهِ  إِلَّا نَصَرَهُ اللهُ فِي مَوْطِنٍ يُحِبُّ فِيهِ نُصْرَتَهُ  .","","Al-Mu'jam al-Kabir 4735","","زيد بن سهل بن الأسود الأنصاري عن إسماعيل بن بشير الأنصاري عن يحيى بن سليم بن زيد الهاشمي عن الليث بن سعد عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","إسماعيل بن بشير بن مغالة عن أبي طلحة"
"4740","[5/106]      إِسْحَاقُ بْنُ عَبْدِ اللهِ  عَنْ  أَبِي طَلْحَةَ  4736  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ بَكْرٍ السَّهْمِيُّ ،  ثَنَا  حُمَيْدٌ ،  عَنْ  ثَابِتٍ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي طَلْحَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ضَحَّى بِكَبْشَيْنِ  أَمْلَحَيْنِ  فَقَالَ عِنْدَ الْأَوَّلِ : "" عَنْ  مُحَمَّدٍ  وَآلِ مُحَمَّدٍ  "" ، وَقَالَ عِنْدَ الثَّانِي : "" عَمَّنْ آمَنَ بِي وَصَدَّقَنِي مِنْ أُمَّتِي  .","","Al-Mu'jam al-Kabir 4736","","زيد بن سهل بن الأسود الأنصاري عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن ثابت البناني عن حميد الطويل عن عبد الله بن بكر بن حبيب عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","إسحاق بن عبد الله عن أبي طلحة"
"4741","481 -  زَيْدُ بْنُ ثَابِتٍ الْأَنْصَارِيُّ ، يُكْنَى أَبَا سَعِيدٍ ، وَيُقَالُ أَبُو خَارِجَةَ  4737  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  يَقُولُ : ""  زَيْدُ بْنُ ثَابِتِ بْنِ الضَّحَّاكِ  ""  .","","Al-Mu'jam al-Kabir 4737","","","زيد بن ثابت الأنصاري"
"4742","4738  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  ثَنَا  أَبُو جَعْفَرٍ الْخَطْمِيُّ ،  حَدَّثَنِي  خَالِي ،  عَنْ  جَدِّي عُقْبَةَ بْنِ فَاكِهٍ  قَالَ :  خَرَجْتُ إِلَى زَيْدِ بْنِ ثَابِتٍ فَخَرَجَ إِلَيَّ مُتَّزِرًا بِيَدِهِ الرُّمْحُ ، فَقُلْتُ : يَا  أَبَا خَارِجَةَ  مَا بَالُ الرُّمْحِ هَذِهِ السَّاعَةَ ؟  قَالَ  :  كُنْتُ أَطْلُبُ هَذِهِ الدَّابَّةَ الْخَبِيثَةَ الَّتِي يَكْتُبُ اللهُ بِقَتْلِهَا الْحَسَنَةَ وَيَمْحُو بِهَا السَّيِّئَةَ  وَهِيَ  الْوَزَغُ  ""  .","","Al-Mu'jam al-Kabir 4738","","زيد بن ثابت الأنصاري عن عقبة بن فاكه عن عبد الرحمن بن عقبة بن الفاكه الأنصاري عن عمير بن يزيد بن عمير الخطمي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","زيد بن ثابت الأنصاري"
"4743","4739  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ  ،  ثَنَا  أَحْمَدُ بْنُ عَلِيِّ بْنِ شَوْذَبٍ الْوَاسِطِيُّ  ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ  ،  ثَنَا  الْقَاسِمُ بْنُ أَبِي الزِّنَادِ  ،  عَنْ  أَخِيهِ  ،  عَنْ  أَبِيهِ  ،  عَنْ  خَارِجَةَ بْنِ زَيْدِ بْنِ ثَابِتٍ  ""  أَنَّ  مَرْوَانَ  قَالَ  لِزَيْدِ بْنِ ثَابِتٍ  : يَا  أَبَا سَعِيدٍ  ""  .","","Al-Mu'jam al-Kabir 4739","","","زيد بن ثابت الأنصاري"
"4744","4740  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ،  ثَنَا  جَعْفَرُ بْنُ حُمَيْدٍ  ،  ثَنَا  ابْنُ أَبِي الزِّنَادِ  ،  عَنْ  أَبِيهِ  ،  عَنْ  خَارِجَةَ بْنِ زَيْدٍ  قَالَ : ""  قَالُوا  لِزَيْدِ بْنِ ثَابِتٍ  : يَا  أَبَا سَعِيدٍ  ""  .","","Al-Mu'jam al-Kabir 4740","","","زيد بن ثابت الأنصاري"
"4745","[5/107]      4741  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  ، يَقُولُ : ""  زَيْدُ بْنُ ثَابِتٍ  يُكْنَى  أَبَا سَعِيدٍ  ""  .","","Al-Mu'jam al-Kabir 4741","","","زيد بن ثابت الأنصاري"
"4746","4742  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ وَيَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  خَارِجَةَ بْنِ زَيْدِ بْنِ ثَابِتٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَدِمَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْمَدِينَةَ  وَأَنَا ابْنُ إِحْدَى عَشْرَةَ سَنَةً  .","","Al-Mu'jam al-Kabir 4742","","زيد بن ثابت الأنصاري عن خارجة بن زيد بن ثابت الخزرجي عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","زيد بن ثابت الأنصاري"
"4747","4743  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ الْحَكَمِ بْنِ أَبِي زِيَادٍ الْقَطَوَانِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ قَيْسٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  خَارِجَةَ بْنِ زَيْدِ بْنِ ثَابِتٍ ،  عَنْ  زَيْدٍ  قَالَ :  أَجَازَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ الْخَنْدَقِ  وَكَسَانِي  قُبْطِيَّةً  .","","Al-Mu'jam al-Kabir 4743","","زيد بن ثابت الأنصاري عن خارجة بن زيد بن ثابت الخزرجي عن أبو إسماعيل بن قيس الأنصاري عن إسماعيل بن قيس الأنصاري عن يعقوب بن محمد بن عيسى عن عبد الله بن الحكم القطواني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زيد بن ثابت الأنصاري"
"4748","4744  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  يَحْيَى بْنُ يَعْلَى ،  عَنْ  أَبِيهِ  ،  عَنْ  غَيْلَانَ بْنِ جَامِعٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مُصْعَبِ بْنِ سَعْدٍ قَالَ :  قَالَ  عُثْمَانُ  :  أَيُّ النَّاسِ أَكْتَبُ ؟ فَقَالُوا : زَيْدُ بْنُ ثَابِتٍ  "" .","","Al-Mu'jam al-Kabir 4744","","زيد بن ثابت الأنصاري عن مصعب بن سعد بن أبي وقاص عن أبو إسحاق السبيعي عن غيلان بن جامع المحاربي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زيد بن ثابت الأنصاري"
"4749","4745  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ عُبَيْدِ بْنِ أَبِي كَرِيمَةَ الْحَرَّانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  مُصْعَبِ بْنِ سَعْدٍ قَالَ :  قَالَ  عُثْمَانُ  رَحِمَهُ اللهُ :  ادْعُوا لِي زَيْدَ بْنَ ثَابِتٍ كَاتَبَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .","","Al-Mu'jam al-Kabir 4745","","زيد بن ثابت الأنصاري عن مصعب بن سعد بن أبي وقاص عن أبو إسحاق السبيعي عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن إسماعيل بن عبيد بن عمر مولى عثمان بن عفان عن محمد بن عبد الله مطين الحضرمي عن الطبراني","زيد بن ثابت الأنصاري"
"4750","4746  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  رَزِينٌ الرُّمَّانِيُّ ،  عَنِ  الشَّعْبِيِّ  أَنَّ  زَيْدَ بْنَ ثَابِتٍ كَبَّرَ عَلَى أُمِّهِ أَرْبَعًا وَمَا حَسِبْتُهَا  حَدًّا  ، ثُمَّ أُتِيَ بِدَابَّةٍ فَأَخَذَ لَهُ  ابْنُ عَبَّاسٍ  الرِّكَابَ ، فَقَالَ لَهُ  زَيْدٌ  :  دَعْهُ أَوْ ذَرْهُ  ، فَقَالَ  ابْنُ         [5/108]      عَبَّاسٍ  : "" هَكَذَا نَفْعَلُ بِالْعُلَمَاءِ الْكُبَرَاءِ  "" .","","Al-Mu'jam al-Kabir 4746","","زيد بن ثابت الأنصاري عن الشعبي عن رزين بن حبيب الجهني عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","زيد بن ثابت الأنصاري"
"4751","4747  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  أَبُو مُسْهِرٍ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ الْعَزِيزِ قَالَ :  كَانَ الْعُلَمَاءُ بَعْدَ  مُعَاذِ بْنِ جَبَلٍ  عَبْدُ اللهِ بْنُ مَسْعُودٍ  وَأَبُو الدَّرْدَاءِ  وَسَلْمَانُ  وَعَبْدُ اللهِ بْنُ سَلَامٍ ،  وَكَانَ الْعُلَمَاءُ بَعْدَ هَؤُلَاءِ  زَيْدُ بْنُ ثَابِتٍ ،  ثُمَّ كَانَ بَعْدَ  زَيْدٍ  ابْنُ عُمَرَ  وَابْنُ عَبَّاسٍ  "" .","","Al-Mu'jam al-Kabir 4747","","سعيد بن عبد العزيز التنوخي عن عبد الأعلى بن مسهر الغساني عن أبو زرعة الدمشقي عن الطبراني","زيد بن ثابت الأنصاري"
"4752","4748  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبَّادٍ الْخَطَّابِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ الرَّازِيُّ ،  ثَنَا  سَلَمَةُ بْنُ الْفَضْلِ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ جَعْفَرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَكْتَبَ  عَبْدَ اللهِ بْنَ الْأَرْقَمِ  ، فَكَانَ يَكْتُبُ إِلَى الْمُلُوكِ ، فَبَلَغَ مِنْ أَمَانَتِهِ عِنْدَهُ أَنَّهُ كَانَ يَكْتُبُ إِلَى بَعْضِ الْمُلُوكِ فَيَكْتُبُ ثُمَّ يَأْمُرُهُ أَنْ يُطَبِّقَهُ ثُمَّ يَخْتِمُ لَا يَقْرَأُهُ لِأَمَانَتِهِ عِنْدَهُ ، وَاسْتَكْتَبَ أَيْضًا  زَيْدَ بْنَ ثَابِتٍ ،  فَكَانَ يَكْتُبُ الْوَحْيَ ، وَيَكْتُبُ إِلَى الْمُلُوكِ أَيْضًا ، وَكَانَ إِذَا غَابَ  عَبْدُ اللهِ بْنُ الْأَرْقَمِ  وَزَيْدُ بْنُ ثَابِتٍ  فَاحْتَاجَ أَنْ يَكْتُبَ إِلَى بَعْضِ أُمَرَاءِ الْأَجْنَادِ وَالْمُلُوكِ وَيَكْتُبَ لِإِنْسَانٍ كِتَابًا يُقْطِعُهُ أَمَرَ مَنْ حَضَرَ أَنْ يَكْتُبَ ، وَقَدْ كَتَبَ لَهُ  عُمَرُ بْنُ الْخَطَّابِ  وَعُثْمَانُ بْنُ عَفَّانَ  وَعَلِيُّ بْنُ أَبِي طَالِبٍ  وَزَيْدُ بْنُ ثَابِتٍ  وَالْمُغِيرَةُ بْنُ شُعْبَةَ  وَمُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ  وَخَالِدُ بْنُ سَعِيدِ بْنِ الْعَاصِ  رَضِيَ اللهُ عَنْهُمْ وَغَيْرُهُمْ مِمَّنْ قَدْ سُمِّيَ مِنَ الْعَرَبِ  .","","Al-Mu'jam al-Kabir 4748","","عبد الله بن الزبير عن محمد بن جعفر بن الزبير بن العوام عن محمد بن إسحاق عن سلمة بن الفضل الأبرش عن محمد بن حميد الرازي عن القاسم بن عباد الخطابى عن الطبراني","زيد بن ثابت الأنصاري"
"4753","4749  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ قَالَ :  جَلَسْنَا مَعَ ابْنِ عَبَّاسٍ فِي جِنَازَةِ  زَيْدِ بْنِ ثَابِتٍ  فَقَالَ  :  لَقَدْ دُفِنَ الْيَوْمَ عِلْمٌ كَثِيرٌ  "" .","","Al-Mu'jam al-Kabir 4749","","عبد الله بن عباس عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","زيد بن ثابت الأنصاري"
"4754","4750  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ قَالَ :  قَالَ  أَبُو هُرَيْرَةَ حِينَ مَاتَ  زَيْدُ بْنُ ثَابِتٍ  :  الْيَوْمَ مَاتَ حَبْرُ هَذِهِ الْأُمَّةِ ،  وَعَسَى اللهُ أَنْ يَجْعَلَ فِي  ابْنِ عَبَّاسٍ  مِنْهُ خَلَفًا  "" .","","Al-Mu'jam al-Kabir 4750","","أبو هريرة الدوسي عن يحيى بن سعيد الأنصاري عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","زيد بن ثابت الأنصاري"
"4755","[5/109]      4751  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَابِهْرَامَ الْإِيذَجِيُّ  ، ثَنَا  مَالِكُ بْنُ سَعِيدٍ الْقَيْسِيُّ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  أَبُو عَامِرٍ الْخَزَّازُ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ :  شَهِدْتُ جِنَازَةَ  زَيْدِ بْنِ ثَابِتٍ ،  فَلَمَّا دُلِّيَ فِي قَبْرِهِ  قَالَ  ابْنُ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُ - : "" يَا هَؤُلَاءِ ،  مَنْ سَرَّهُ أَنْ يَعْلَمَ كَيْفَ ذَهَابُ الْعِلْمِ فَهَكَذَا ذَهَابُ الْعِلْمِ  ، وَايْمُ اللهِ لَقَدْ ذَهَبَ الْيَوْمَ عِلْمٌ كَثِيرٌ  "" .  قَالَ  سَعِيدُ بْنُ الْمُسَيِّبِ  : ""  وَالْقَائِلُ لَقَدْ ذَهَبَ بِهِ عِلْمٌ كَثِيرٌ يَعْنِي  ابْنَ عَبَّاسٍ  "" .","","Al-Mu'jam al-Kabir 4751","","عبد الله بن عباس عن سعيد بن المسيب عن علي بن زيد بن جدعان عن صالح بن رستم الخزاز عن روح بن عبادة القيسي عن مالك بن سعد بن عبادة القيسي عن أحمد بن الحسين بن مابهرام الأيذجي عن الطبراني","زيد بن ثابت الأنصاري"
"4756","4752  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ نُمَيْرٍ  يَقُولُ : ""  مَاتَ  زَيْدُ بْنُ ثَابِتٍ  سَنَةَ خَمْسٍ وَأَرْبَعِينَ ،  وَمَاتَ  خَارِجَةُ بْنُ زَيْدِ بْنِ ثَابِتٍ  سَنَةَ تِسْعٍ وَتِسْعِينَ  ""  .","","Al-Mu'jam al-Kabir 4752","","","زيد بن ثابت الأنصاري"
"4757","4753  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  قَالَ : ""  تُوُفِّيَ  زَيْدُ بْنُ ثَابِتٍ  سَنَةَ خَمْسٍ وَأَرْبَعِينَ  ، سِنُّهُ سِتٌّ وَخَمْسُونَ ، وَمِنَ النَّاسِ مَنْ يَقُولُ : مَاتَ سَنَةَ ثَمَانٍ وَأَرْبَعِينَ وَسِنُّهُ تِسْعٌ وَخَمْسُونَ ، لِأَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَجَازَهُ  يَوْمَ الْخَنْدَقِ  وَهُوَ ابْنُ خَمْسَ عَشْرَةَ ،  وَالْخَنْدَقُ  فِي شَوَّالٍ سَنَةَ أَرْبَعٍ ، وَقَدِ اخْتُلِفَ فِي وَفَاتِهِ  ""  .","","Al-Mu'jam al-Kabir 4753","","","زيد بن ثابت الأنصاري"
"4758","4754  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ،  حَدَّثَنِي  أَبِي  رَحِمَهُ اللهُ قَالَ : ""  بَلَغَنِي  أَنَّ  زَيْدَ بْنَ ثَابِتٍ  تُوُفِّيَ سَنَةَ إِحْدَى وَخَمْسِينَ  ""  .","","Al-Mu'jam al-Kabir 4754","","","زيد بن ثابت الأنصاري"
"4759","4755  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ  ،  ثَنَا  دَاوُدُ بْنُ رُشَيْدٍ  ،  عَنِ  الْهَيْثَمِ بْنِ عَدِيٍّ  قَالَ : ""  هَلَكَ  زَيْدُ بْنُ ثَابِتٍ  سَنَةَ خَمْسٍ وَخَمْسِينَ  ""  .","","Al-Mu'jam al-Kabir 4755","","","زيد بن ثابت الأنصاري"
"4760","عَبْدُ اللهِ بْنُ عُمَرَ  عَنْ  زَيْدِ بْنِ ثَابِتٍ  4756  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الْمُزَابَنَةِ  .","","Al-Mu'jam al-Kabir 4756","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن إسحاق عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4761","[5/110]      4757  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْقَعْنَبِيُّ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ - قَالُوا :  ثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، عَنْ  زَيْدِ بْنِ ثَابِتٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  .","","Al-Mu'jam al-Kabir 4757","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سفيان بن عيينة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4762","4758  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الشِّبَامِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، أَخْبَرَنِي  زَيْدُ بْنُ ثَابِتٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  أَنْ تُبَاعَ  بِخَرْصِهَا  تَمْرًا ، وَلَمْ يُرَخِّصْ غَيْرَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 4758","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عبد الله الشبامي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4763","4759  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ  ، عَنْ  زَيْدِ بْنِ ثَابِتٍ قَالَ :  رَخَّصَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَيْعِ الْعَرَايَا  بِالتَّمْرِ وَالرُّطَبِ ، وَلَمْ يُرَخِّصْ فِي غَيْرِ ذَلِكَ  .","","Al-Mu'jam al-Kabir 4759","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن أبو عمرو الأوزاعي عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4764","4760  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  حَدَّثَنِي  الزُّبَيْدِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  كَيْلًا  بِخَرْصِهَا  مِنَ التَّمْرِ الْيَابِسِ  .","","Al-Mu'jam al-Kabir 4760","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن الوليد بن عامر الزبيدي عن يحيى بن حمزة بن البتلهي عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4765","4761  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، حَدَّثَنَا  عَلِيُّ بْنُ مَعْبَدٍ ،  ثَنَا  خَالِدُ بْنُ حَيَّانَ ،  عَنْ  سُلَيْمَانَ بْنِ أَبِي دَاوُدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  أَخْبَرَنِي  زَيْدُ بْنُ ثَابِتٍ  أَنَّ نَبِيَّ اللهُ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  بِالرُّطَبِ أَوْ بِتَمْرٍ ، وَلَمْ يُرَخِّصْ فِي غَيْرِ ذَلِكَ  .","","Al-Mu'jam al-Kabir 4761","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن سليمان بن أبي داود الحراني بومة عن خالد بن حيان الرقي عن علي بن معبد العبدي عن يحيى بن عثمان بن صالح عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4766","4762  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدٍ ،  ثَنَا  عَمِّي ،  ثَنَا  أَبِي  ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ شِهَابٍ أَنَّ  سَالِمًا  أَخْبَرَهُ  ،  أَنَّهُ سَمِعَ         [5/111]      عَبْدَ اللهِ بْنَ عُمَرَ  أَنَّ زَيْدَ بْنَ ثَابِتٍ  أَخْبَرَهُ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  بِالرُّطَبِ وَالتَّمْرِ ، وَلَمْ يُرَخِّصْ فِي غَيْرِ ذَلِكَ  .","","Al-Mu'jam al-Kabir 4762","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبيد الله بن سعد بن إبراهيم الزهري عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4767","4763  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ قَالَ :  رَخَّصَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تُبَاعَ الْعَرَايَا  بِخَرْصِهَا  تَمْرًا  .","","Al-Mu'jam al-Kabir 4763","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يحيى بن سعيد الأنصاري عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4768","4764  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ الرَّقِّيُّ  ، ثَنَا  قَبِيصَةُ بْنُ عُقْبَةَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ وَعُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ قَالَ :  رَخَّصَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْعَرَايَا  أَنْ تُبَاعَ  بِخَرْصِهَا  تَمْرًا  .","","Al-Mu'jam al-Kabir 4764","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن سفيان الثوري عن قبيصة بن عقبة السوائي عن حفص بن عمر سنجة ألف عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4769","4765  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  بِخَرْصِهَا  تَمْرًا  .","","Al-Mu'jam al-Kabir 4765","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يحيى بن سعيد الأنصاري عن الليث بن سعد عن عبد الله بن صالح المصري عن يوسف بن يزيد القراطيسي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4770","4766  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنَا  أَبِي  ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ  الْعَرِيَّةِ  يَأْخُذُهَا أَهْلُ الْبَيْتِ  بِخَرْصِهَا  يَأْكُلُونَهَا رُطَبًا  .","","Al-Mu'jam al-Kabir 4766","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يحيى بن سعيد الأنصاري عن أنس بن عياض الليثي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4771","4767  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ لِصَاحِبِ  الْعَرِيَّةِ  أَنْ يَبِيعَهَا  بِخَرْصِهَا  كَيْلًا  .","","Al-Mu'jam al-Kabir 4767","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4772","4768  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ وَيُوسُفُ الْقَاضِي قَالَا :  ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ - قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  حَدَّثَنِي  زَيْدُ بْنُ ثَابِتٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  بِخَرْصِهَا  .","","Al-Mu'jam al-Kabir 4768","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن حماد بن زيد عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4773","4769  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  أَيُّوبَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَخْبَرَنِي  زَيْدُ بْنُ ثَابِتٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [5/112]      رَخَّصَ فِي بَيْعِ الْعَرَايَا  .","","Al-Mu'jam al-Kabir 4769","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب السختياني عن إسماعيل ابن علية عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4774","4770  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَيُّوبَ وَعُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  قَالَ  زَيْدُ بْنُ ثَابِتٍ :  رَخَّصَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَيْعِ الْعَرَايَا  النَّخْلَةِ وَالنَّخْلَتَيْنِ تُوهَبَانِ لِلرَّجُلِ فَيَبِيعُهَا  بِخَرْصِهَا  تَمْرًا  .","","Al-Mu'jam al-Kabir 4770","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن حماد بن سلمة عن عبد الواحد بن غياث عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4775","4771  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا بِكَيْلِهَا  .","","Al-Mu'jam al-Kabir 4771","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4776","4772  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  بِخَرْصِهَا  كَيْلًا  .","","Al-Mu'jam al-Kabir 4772","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبيد الله بن عمر العمري عن عبد الله بن مسلمة القعنبي عن أبو مسلم الكجي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4777","4773  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ أَبِي عَبَّادٍ الْمَكِّيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  أَنْ تُبَاعَ  بِخَرْصِهَا  كَيْلًا  .","","Al-Mu'jam al-Kabir 4773","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن إسماعيل بن إبراهيم بن عقبة الأسدي عن يعقوب بن إسحاق القلزمي عن يوسف بن يزيد القراطيسي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4778","4774  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ،  ثَنَا  جُوَيْرِيَةُ بْنُ أَسْمَاءَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  أَنْ تُبَاعَ  بِخَرْصِهَا  كَيْلًا  .","","Al-Mu'jam al-Kabir 4774","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن جويرية بن أسماء الضبعي عن عبد الله بن محمد بن أسماء الضبعي عن موسى بن هارون الحمال عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4779","4775  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ ،  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى كَاتِبُ الْعُمَرِيِّ ،  ثَنَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ سُلَيْمَانَ الطَّوِيلِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَخْبَرَنِي  زَيْدُ بْنُ ثَابِتٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  بِخَرْصِهَا  .","","Al-Mu'jam al-Kabir 4775","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن سليمان بن زرعة الحميري عن المفضل بن فضالة عن زكريا بن يحيى القضاعي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4780","4776  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  عَنْبَسَةُ بْنُ خَالِدٍ ،  ثَنَا  يُونُسُ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي بَيْعِ الْعَرَايَا  بِخَرْصِهَا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( الطحاوي )","","Al-Mu'jam al-Kabir 4776","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أبو الزناد عن يونس بن يزيدالأيلي عن عنبسة بن خالد بن يزيد عن أحمد بن صالح المصري عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4781","4777  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَحْمَدُ بْنُ جَمِيلٍ         [5/113]      الْمَرْوَزِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي الْعَرَايَا  بِخَرْصِهَا  كَيْلًا  .","","Al-Mu'jam al-Kabir 4777","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن عبد الله بن المبارك عن أحمد بن جميل المروزي عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4782","4778  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  ثَنَا  ابْنُ أَبِي الزِّنَادِ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ - فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 4778","","زيد بن ثابت الأنصاري عن نافع مولى ابن عمر عن موسى بن عقبة عن عبد الرحمن بن أبي الزناد عن منصور بن أبي مزاحم عن موسى بن هارون الحمال عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4783","4779  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ الشَّامِيُّ الْكُوفِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  خَالِدُ بْنُ مَخْلَدٍ ،  ثَنَا  نَافِعٌ ،  عَنْ  أَبِي نُعَيْمٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ لِصَاحِبِ  الْعَرِيَّةِ  أَنْ يَبِيعَهَا  بِخَرْصِهَا  .","","Al-Mu'jam al-Kabir 4779","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن نافع بن عبد الرحمن بن أبي نعيم عن خالد بن مخلد القطواني عن أبو كريب محمد بن العلاء عن ابن الرواس جعفر بن أحمد بن عاصم عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4784","4780  -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ ، "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الْمُحَاقَلَةِ  وَالْمُزَابَنَةِ  .","","Al-Mu'jam al-Kabir 4780","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن إسحاق عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4785","4781  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ - قَالَا :  ثَنَا  حُسَيْنُ بْنُ مُحَمَّدٍ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنْ  عُبَيْدِ بْنِ حُنَيْنٍ مَوْلَى عُمَرَ بْنِ الْخَطَّابِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ قَالَ :  ابْتَعْتُ زَيْتًا بِالسُّوقِ ، فَقَامَ إِلَيَّ  رَجُلٌ  فَأَرْبَحَنِي حَتَّى رَضِيتُ ، فَلَمَّا أَخَذْتُ بِيَدِهِ لِأَضْرِبَ عَلَيْهَا أَخَذَ بِذِرَاعِي رَجُلٌ مِنْ خَلْفِي ، فَأَمْسَكَ بِيَدِي ، فَالْتَفَتُّ إِلَيْهِ فَإِذَا زَيْدُ بْنُ ثَابِتٍ ،  فَقَالَ  :  لَا تَبِعْهُ حَتَّى  تَحُوزَهُ  إِلَى بَيْتِكَ ، فَإِنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَى عَنْ بَيْعِ ذَلِكِ  .","","Al-Mu'jam al-Kabir 4781","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن عبيد بن حنين مولى زيد بن الخطاب عن أبو الزناد عن جرير بن حازم عن الحسين بن محمد بن بهرام المروذي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4786","4782  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  أَحْمَدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنْ  عُبَيْدِ بْنِ حُنَيْنٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  ابْتَعْتُ زَيْتًا مِنَ السُّوقِ ، حَتَّى إِذَا اسْتَوْفَيْتُ لَقِيَنِي  رَجُلٌ  فَأَعْطَانِي بِهِ رِبْحًا حَسَنًا ، فَأَرَدْتُ أَنْ  أَضْرِبَ  بِيَدِي عَلَى يَدِهِ ، فَأَخَذَ رَجُلٌ مِنْ خَلْفِي بِذِرَاعِي ، فَالْتَفَتُّ فَإِذَا زَيْدُ بْنُ ثَابِتٍ ،  فَقَالَ  : لَا تَبِعْهُ حَيْثُ ابْتَعْتَهُ حَتَّى  تَحُوزَهُ  إِلَى رَحْلِكِ ، فَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ تُبَاعَ السِّلْعَةُ حَيْثُ تُبْتَاعُ حَتَّى  يَحُوزَهَا  التُّجَّارُ  إِلَى رِحَالِهِمْ  .","","Al-Mu'jam al-Kabir 4782","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن عبيد بن حنين مولى زيد بن الخطاب عن أبو الزناد عن محمد بن إسحاق عن أحمد بن خالد بن موسى الوهبي عن أبو زرعة الدمشقي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4787","[5/114]      4783  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عُبَيْدُ بْنُ يَعِيشَ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنْ  عُبَيْدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  قَدِمَ زَيْتٌ مِنَ  الشَّامِ  ، فَاشْتَرَيْتُ مِنْهُ أَبْعِرَةً وَفَرَغْتُ مِنْ شِرَائِهَا ، فَقَامَ إِلَيَّ  رَجُلٌ  فَأَرْبَحَنِي بِهَا رِبْحًا ، فَبَسَطْتُ يَدِي  لِأُبَايِعَهُ  فَإِذَا رَجُلٌ أَخَذَ يَدِي مِنْ خَلْفِي ، فَنَظَرْتُ فَإِذَا زَيْدُ بْنُ ثَابِتٍ ،  فَقَالَ  :  لَا تَبِعْهُ حَتَّى تَنْقُلَهُ إِلَى رَحْلِكَ ، فَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ بِذَلِكَ  .","","Al-Mu'jam al-Kabir 4783","","زيد بن ثابت الأنصاري عن عبد الله بن عمر بن الخطاب عن عبيد بن حنين مولى زيد بن الخطاب عن أبو الزناد عن محمد بن إسحاق عن يونس بن بكير عن عبيد بن يعيش عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن عمر عن زيد بن ثابت"
"4788","أَبُو سَعِيدٍ الْخُدْرِيُّ  عَنْ  زَيْدِ بْنِ ثَابِتٍ  4784  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  سَعِيدٌ الْجُرَيْرِيُّ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ - قَالَا :  ثَنَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ ،  أَخْبَرَنِي  زَيْدُ بْنُ ثَابِتٍ قَالَ :  بَيْنَمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حَائِطٍ  لِبَنِي النَّجَّارِ  وَهُوَ عَلَى بَغْلَةٍ لَهُ وَنَحْنُ مَعَهُ ، قَالَ :  تَعَوَّذُوا بِاللهِ مِنْ عَذَابِ الْقَبْرِ  ، تَعَوَّذُوا بِاللهِ مِنْ عَذَابِ النَّارِ "" ، قُلْنَا : نَعُوذُ بِاللهِ مِنْ عَذَابِ الْقَبْرِ ، نَعُوذُ بِاللهِ مِنْ عَذَابِ النَّارِ ، قَالَ : "" تَعَوَّذُوا بِاللهِ مِنَ الْفِتَنِ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ "" قُلْنَا : نَعُوذُ بِاللهِ مِنَ الْفِتَنِ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ ، قَالَ : "" تَعَوَّذُوا بِاللهِ مِنْ فِتْنَةِ  الدَّجَّالِ  "" قَالُوا : نَعُوذُ بِاللهِ مِنْ فِتْنَةِ  الدَّجَّالِ  .","","Al-Mu'jam al-Kabir 4784","","زيد بن ثابت الأنصاري عن أبو سعيد الخدري عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن إسماعيل ابن علية عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","أبو سعيد الخدري عن زيد بن ثابت"
"4789","4785  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ الْمُسَاوِرِ الْجَوَاهِرِيُّ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، - رَضِيَ اللهُ عَنْهُ - قَالَ :  لَمَّا تُوُفِّيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَامَ خُطَبَاءُ  الْأَنْصَارِ  فَقَالُوا : يَا مَعْشَرَ  الْمُهَاجِرِينَ  ، إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا بَعَثَ رَجُلًا مِنْكُمْ قَرَنَهُ         [5/115]      بِرَجُلٍ مِنَّا  ، فَنَحْنُ نَرَى أَنْ يَلِيَ هَذَا الْأَمْرَ رَجُلَانِ رَجُلٌ مِنْكُمْ وَرَجُلٌ مِنَّا ، فَقَامَ  زَيْدُ بْنُ ثَابِتٍ  فَقَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الْمُهَاجِرِينَ  ، وَكُنَّا أَنْصَارَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَنَحْنُ أَنْصَارُ مَنْ يَقُومُ مَقَامَهُ ، فَقَالَ  أَبُو بَكْرٍ  رَضِيَ اللهُ عَنْهُ : جَزَاكُمُ اللهُ خَيْرًا مِنْ حَيٍّ يَا مَعْشَرَ  الْأَنْصَارِ  وَثَبَّتَ قَائِلَكُمْ ، وَاللهِ لَوْ قُلْتَ غَيْرَ ذَلِكَ مَا صَالَحْنَاكُمْ  .","","Al-Mu'jam al-Kabir 4785","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن داود بن أبي هند عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","أبو سعيد الخدري عن زيد بن ثابت"
"4790","4786  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ  ، ثَنَا  عَمْرُو بْنُ حَكَّامٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي الْبُحْتُرِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَصْحَابِي حَيِّزٌ وَالنَّاسُ حَيِّزٌ  ،  فَقَالَ  زَيْدُ بْنُ ثَابِتٍ وَرَافِعُ بْنُ خَدِيجٍ : صَدَقَ  .","","Al-Mu'jam al-Kabir 4786","","رافع بن خديج الأنصاري عن سعيد بن فيروز الطائي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن عمرو بن حكام الزنجبيلي عن إبراهيم بن صالح الشيرازي عن الطبراني","أبو سعيد الخدري عن زيد بن ثابت"
"4791","سَهْلُ بْنُ سَعْدٍ السَّاعِدِيُّ  عَنْ  زَيْدِ بْنِ ثَابِتٍ  4787  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ - قَالَا :  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ :  سَمِعْتُ  زَيْدَ بْنَ ثَابِتٍ يَقُولُ :  كَانَ إِذَا أُنْزِلَ الْوَحْيُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثَقُلَ لِذَلِكَ وَيَحْدُرُ جَبِينُهُ عَرَقًا  كَأَنَّهُ  الْجُمَانُ  وَإِنْ كَانَ فِي الْبَرْدِ  ،  وَاللَّفْظُ  لِعُقْبَةَ بْنِ مُكْرَمٍ  .","","Al-Mu'jam al-Kabir 4787","","زيد بن ثابت الأنصاري عن سهل بن سعد الساعدي عن الزهري عن عثمان بن عبد الرحمن بن عمر الوقاصي عن يونس بن بكير عن عقبة بن مكرم بن عقبة الكوفي عن محمد بن عثمان بن أبي شيبة عن الطبراني","سهل بن سعد الساعدي عن زيد بن ثابت"
"4792","سَهْلُ بْنُ أَبِي حَثْمَةَ  عَنْ  زَيْدِ بْنِ ثَابِتٍ  4788  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ الرَّازِيُّ ،  ثَنَا  هَارُونُ بْنُ الْمُغِيرَةِ ،  ثَنَا  عَنْبَسَةُ بْنُ سَعِيدٍ ،  عَنْ  زَكَرِيَّا بْنِ خَالِدٍ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  سَهْلِ بْنِ أَبِي حَثْمَةَ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ قَالَ :  كَانُوا يَتَبَايَعُونَ الثِّمَارَ قَبْلَ أَنْ تَطْلُعَ ، ثُمَّ يَخْتَصِمُونَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَّا إِذَا فَعَلْتُمْ هَذَا فَلَا تَبَايَعُوا حَتَّى يَبْدُوَ صَلَاحُهُ  .","","Al-Mu'jam al-Kabir 4788","","زيد بن ثابت الأنصاري عن سهل بن أبي حثمة الخزرجي عن عروة بن الزبير عن أبو الزناد عن زكريا بن خالد عن عنبسة بن سعيد بن الضريس عن هارون بن المغيرة المروزي عن محمد بن حميد الرازي عن عبد الله بن أحمد بن حنبل عن الطبراني","سهل بن أبي حثمة عن زيد بن ثابت"
"4793","[5/116]      أَنَسُ بْنُ مَالِكٍ  عَنْ  زَيْدِ بْنِ ثَابِتٍ  4789  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ وَيُوسُفُ الْقَاضِي ، قَالُوا :  ثَنَا  عَمْرُو بْنُ مَرْزُوقٍ ،  أَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَظَرَ قِبَلَ  الْيَمَنِ  فَقَالَ :  اللَّهُمَّ أَقْبِلْ بِقُلُوبِهِمْ ، وَبَارِكْ لَنَا فِي صَاعِنَا وَمُدِّنَا  .","","Al-Mu'jam al-Kabir 4789","","زيد بن ثابت الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن عمران بن داور القطان عن عمرو بن مرزوق الباهلي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أنس بن مالك عن زيد بن ثابت"
"4794","4790  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيُّ ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ قَالَ :  نَظَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قِبَلَ  الْيَمَنِ  فَقَالَ : "" اللَّهُمَّ أَقْبِلْ بِقُلُوبِهِمْ "" ، وَنَظَرَ قِبَلَ  الْعِرَاقِ  فَقَالَ : "" اللَّهُمَّ أَقْبِلْ بِقُلُوبِهِمْ "" ، وَنَظَرَ قِبَلَ  الشَّامِ  فَقَالَ :  اللَّهُمَّ أَقْبِلْ بِقُلُوبِهِمْ ، وَبَارِكْ لَنَا فِي صَاعِنَا وَمُدِّنَا  .","","Al-Mu'jam al-Kabir 4790","","زيد بن ثابت الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن عمران بن داور القطان عن عبد الرحمن بن مهدي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أنس بن مالك عن زيد بن ثابت"
"4795","4791  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  حَدَّثَنِي  أَبِي قَالَ :  وَجَدْتُ فِي كِتَابِ  أَبِي بِخَطِّهِ  :  نَا  مُسْتَلِمُ بْنُ سَعِيدٍ ،  عَنْ  مَنْصُورِ بْنِ زَاذَانَ ،  عَنْ  أَنَسٍ قَالَ :  دَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِأُمَّتِهِ فَقَالَ :  اللَّهُمَّ أَقْبِلْ بِقُلُوبِهِمْ إِلَى دِينِكَ وَحُطْ مَنْ وَرَاءَهُمْ بِرَحْمَتِكَ  ،  وَلَمْ يَذْكُرْ  زَيْدَ بْنَ ثَابِتٍ  .","","Al-Mu'jam al-Kabir 4791","","أنس بن مالك عن منصور بن زاذان الثقفي عن مستلم بن سعيد الواسطي عن محمد بن أبي شيبة العبسي عن عثمان ابن أبي شيبة عن محمد بن عثمان بن أبي شيبة عن الطبراني","أنس بن مالك عن زيد بن ثابت"
"4796","4792  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ وَيُوسُفُ الْقَاضِي وَأَبُو خَلِيفَةَ ، قَالُوا :  ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ،  عَنْ  هِشَامٍ الدَّسْتُوَائِيِّ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ قَالَ :  تَسَحَّرْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ خَرَجْنَا إِلَى الصَّلَاةِ  ، قُلْتُ : كَمْ كَانَ بَيْنَ الْأَذَانِ وَالْإِقَامَةِ وَالسَّحُورِ ؟ قَالَ : قَدْرُ خَمْسِينَ آيَةً  .","","Al-Mu'jam al-Kabir 4792","","زيد بن ثابت الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن هشام الدستوائي عن مسلم بن إبراهيم الشحام عن الفضل بن الحباب الجمحي عن الطبراني","أنس بن مالك عن زيد بن ثابت"
"4797","4793  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ عِيسَى الطَّائِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  مَنْصُورِ بْنِ زَاذَانَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ قَالَ : ""         [5/117]      تَسَحَّرْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ خَرَجْنَا إِلَى الصَّلَاةِ  قُلْتُ : كَمْ كَانَ بَيْنَ الْأَذَانِ وَالْإِقَامَةِ ؟ قَالَ : قَدْرُ خَمْسِينَ آيَةً  .","","Al-Mu'jam al-Kabir 4793","","زيد بن ثابت الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن منصور بن زاذان الثقفي عن هشيم بن بشير عن القاسم بن عيسى بن إبراهيم الطائي عن علي بن سعيد بن بشير عليك عن الطبراني","أنس بن مالك عن زيد بن ثابت"
"4798","4794  -  وَبِإِسْنَادِهِ  قَالَ :  تَسَحَّرْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ خَرَجْنَا فَصَلَّيْنَا  .","","Al-Mu'jam al-Kabir 4794","","زيد بن ثابت الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن منصور بن زاذان الثقفي عن هشيم بن بشير عن القاسم بن عيسى بن إبراهيم الطائي عن علي بن سعيد بن بشير عليك عن الطبراني","أنس بن مالك عن زيد بن ثابت"
"4799","4795  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  سَالِمُ بْنُ نُوحٍ ،  عَنْ  عُمَرَ بْنِ عَامِرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  زَيْدِ بْنِ ثَابِتٍ قَالَ :  تَسَحَّرْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَا قُمْنَا حَتَّى صَلَّى الْغَدَاةَ ،  قُلْتُ : فَمَا قَدْرُ ذَلِكَ ؟ قَالَ : قَدْرُ مَا يَقْرَأُ الْإِنْسَانُ خَمْسِينَ آيَةً  .","","Al-Mu'jam al-Kabir 4795","","زيد بن ثابت الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن عمر بن عامر الأحول عن سالم بن نوح العطار عن أبو موسى الزمن عن الساجي عن الطبراني","أنس بن مالك عن زيد بن ثابت"
"4800","4796  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  السَّرِيُّ بْنُ يَحْيَى ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كُنْتُ أَمْشِي مَعَ زَيْدِ بْنِ ثَابِتٍ ، فَقَارَبَ فِي الْخُطَى  فَقَالَ : "" أَتَدْرِي لِمَ مَشَيْتُ بِكَ هَذِهِ الْمِشْيَةَ ؟ "" ، فَقُلْتُ : لَا ،  فَقَالَ  : "" لِتَكْثُرَ خُطَانَا فِي الْمَشْيِ إِلَى الصَّلَاةِ "" ،  وَلَمْ  يَرْفَعْهُ  السَّرِيُّ بْنُ يَحْيَى  .","","Al-Mu'jam al-Kabir 4796","","زيد بن ثابت الأنصاري عن أنس بن مالك عن ثابت البناني عن السري بن يحيى الشيباني عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","أنس بن مالك عن زيد بن ثابت"
