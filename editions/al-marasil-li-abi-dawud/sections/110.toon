hadiths[14]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"514","110 - بَابٌ فِي [الْمَلَاحِمِ]  515  -  حَدَّثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  أَخْبَرَنَا  حَفْصٌ ،  عَنِ  ابْنِ جُرَيْجٍ .  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  ، رَأَى  بِالْمَدِينَةِ  الْكُرَّجَ فَقَالَ :  أَمَّا [أَنَا]  لَوْلَا أَنِّي رَأَيْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَقَرَّكَ مَا أَقْرَرْتُكَ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: الملاهي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أنبأ .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: رضي الله عنه .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 515","","عمر بن الخطاب عن عمرو بن دينار الأثرم عن ابن جريج عن حفص بن غياث النخعي عن قتيبة بن سعيد عن أبو داود السجستاني","باب في الملاحم"
"515","516  -  حَدَّثَنَا  هَنَّادٌ ، وَعُثْمَانُ بْنُ أَبِي شَيْبَةَ  ،  عَنِ  ابْنِ مُبَارَكٍ  ،  عَنْ  زِيَادِ بْنِ أَبِي مُسْلِمٍ ، قَالَ :  سَمِعْتُ  صَالِحًا أَبَا الْخَلِيلِ ، يُحَدِّثُ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ بِقَطْعِ الْمَرَاجِيحِ  ( 18816 ) .         [1/350]      قَالَ  هَنَّادٌ  : إِنَّهُ سَمِعَ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: المعنى .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: المبارك .","","Al-Marasil li-Abi Dawud 516","","صالح بن أبي مريم الضبعي عن زياد بن مسلم الفراء عن عبد الله بن المبارك عن عثمان ابن أبي شيبة عن أبو داود السجستاني","باب في الملاحم"
"516","517  -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  حَدَّثَنَا  خَالِدٌ ،  عَنْ  يُونُسَ .  عَنِ  الْحَسَنِ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ مَرَّ بِقَوْمٍ وَهُمْ يُطِيفُونَ  بِرَجُلٍ  وَهُوَ يُضْحِكُهُمْ  ، فَقَالَ : مَا هَذَا ؟ قَالُوا : رَجُلٌ يَتَشَبَّهُ  بِالْحِمَارِ يُضْحِكُ أَصْحَابَهُ ، فَقَالَ : سُبْحَانَ اللهِ وَمَا يُؤْمِنُ هَذَا - وَقَدْ أَحْسَنَ اللهُ صُورَتَهُ - أَنْ يُحَوِّلَهُ  فِي صُورَةِ حِمَارٍ  ( 18571 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: عن .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: تشبه .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يجعله الله .","","Al-Marasil li-Abi Dawud 517","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو داود السجستاني","باب في الملاحم"
"517","518  -  حَدَّثَنَا  كَثِيرُ بْنُ عُبَيْدٍ ،  حَدَّثَنَا  بَقِيَّةُ ،  عَنْ  إِسْمَاعِيلَ ،  عَنْ  سُلَيْمَانَ بْنِ سُلَيْمٍ ،  عَنْ  يَحْيَى بْنِ جَابِرٍ ،  عَنْ  يَزِيدَ بْنِ شُرَيْحٍ [الشَّامِيِّ]  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ثَلَاثٌ مِنَ الْمَيْسِرِ  : الْقِمَارُ ، وَالضَّرْبُ  بِالْكِعَابِ  ، وَالصَّفِيرُ بِالْحَمَامِ  ( 19548 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أنبأ .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 518","","يزيد بن شريح الحضرمي عن يحيى بن جابر بن حسان عن سليمان بن سليم الكناني عن إسماعيل بن عياش الأحول عن بقية بن الوليد عن كثير بن عبيد المذحجي عن أبو داود السجستاني","باب في الملاحم"
"518","519  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ ،  أَخْبَرَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ، أَنَّ مُحَمَّدَ بْنَ عُرْوَةَ ،  أَخْبَرَهُ  .  عَنْ  عُرْوَةَ ، قَالَ :  تُوُفِّيَتِ  امْرَأَةٌ  كَانَ أَصْحَابُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَضْحَكُونَ مِنْهَا ، فَقَالَ لَهَا  بِلَالٌ  : وَيْحَهَا قَدِ اسْتَرَاحَتْ ، فَقَالَ [لَهُ]  رَسُولُ         [1/351]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّمَا يَسْتَرِيحُ مَنْ غُفِرَ لَهُ  ( 19015 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أنبأ .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 519","","عروة بن الزبير عن محمد بن عروة بن الزبير بن العوام عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن وهب المصري عن سليمان بن داود المهري عن أبو داود السجستاني","باب في الملاحم"
"519","520  -  حَدَّثَنَا  هَارُونُ بْنُ زَيْدِ [بْنِ أَبِي الزَّرْقَاءِ]  ،  حَدَّثَنَا  أَبِي  ،  حَدَّثَنَا  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَائِشَةَ  ، قَالَتْ :  مَا سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَنْسُبُ أَحَدًا إِلَّا إِلَى الدِّينِ  ( 16088 ) .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أنبأ .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: رضي الله عنها .","","Al-Marasil li-Abi Dawud 520","","عائشة بنت أبي بكر الصديق عن زيد بن أسلم عن هشام بن سعد المخزومي عن زيد بن أبي الزرقاء التغلبي عن هارون بن زيد بن أبي الزرقاء عن أبو داود السجستاني","باب في الملاحم"
"520","521  -  حَدَّثَنَا  سَهْلُ بْنُ صَالِحٍ ،  حَدَّثَنَا  وَكِيعٌ ،  حَدَّثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ مِينَاءَ .  عَنِ  ابْنِ جَوْدَانَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنِ اعْتَذَرَ إِلَى أَخِيهِ الْمُسْلِمِ فَلَمْ يَقْبَلْ مِنْهُ  كَانَ عَلَيْهِ مَا عَلَى صَاحِبِ  مَكْسٍ  ( 3271 ) .","","Al-Marasil li-Abi Dawud 521","","جودان العبدي الكوفي عن عباس بن عبد الرحمن بن مينا الأشجعي عن ابن جريج عن سفيان الثوري عن وكيع بن الجراح عن سهل بن صالح الأنطاكي عن أبو داود السجستاني","باب في الملاحم"
"521","[1/352]      522  -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  عَنْ  خَالِدٍ ،  عَنْ  يُونُسَ .  عَنِ  الْحَسَنِ ،  أَنَّ  امْرَأَةً  أَتَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَسْأَلُهُ ، فَلَمْ تُوَافِقْ عِنْدَهُ شَيْئًا ، فَقَالَتْ : يَا رَسُولَ اللهِ عِدْنِي ، قَالَ  :  الْعِدَةُ عَطِيَّةٌ  ( 18573 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فقال .","","Al-Marasil li-Abi Dawud 522","","الحسن البصري عن يونس بن عبيد عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو داود السجستاني","باب في الملاحم"
"522","523  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ ،  عَنِ  ابْنِ وَهْبٍ ،  عَنْ  هِشَامِ بْنِ سَعْدٍ .  عَنْ  زَيْدِ بْنِ أَسْلَمَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  وَأْيُ  الْمُؤْمِنِ حَقٌّ         [1/353]      وَاجِبٌ  ( 18664 ) .  قَالَ أَبُو دَاوُدَ :  عِدَتُهُ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يعني عدته .","","Al-Marasil li-Abi Dawud 523","","زيد بن أسلم عن هشام بن سعد المخزومي عن عبد الله بن وهب المصري عن سليمان بن داود المهري عن أبو داود السجستاني","باب في الملاحم"
"523","524  -  حَدَّثَنَا  هِشَامُ بْنُ خَالِدٍ ،  حَدَّثَنَا  بَقِيَّةُ ،  حَدَّثَنَا  الْوَضِينُ بْنُ عَطَاءٍ .  حَدَّثَنِي  يَزِيدُ بْنُ مَرْثَدٍ الْمُدَّعِي ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا عَطَسَ أَحَدُكُمْ ، أَوْ تَجَشَّأَ ، فَلَا يَرْفَعَنَّ بِهِمَا الصَّوْتَ  ; فَإِنَّ الشَّيْطَانَ يُحِبُّ أَنْ يَرْفَعَ بِهِمَا الصَّوْتَ  ( 19551 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: حدثني .","","Al-Marasil li-Abi Dawud 524","","يزيد بن مرثد الهمداني عن الوضين بن عطاء عن بقية بن الوليد عن هشام بن خالد السلامي عن أبو داود السجستاني","باب في الملاحم"
"524","[1/354]      525  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ ،  أَخْبَرَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  عُقَيْلٍ .  عَنِ  ابْنِ شِهَابٍ ، قَالَ :  كَانَ  رَجُلٌ  [لَا يَزَالُ]  يَتَنَاوَلُ عَنْ وَجْهِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الشَّيْءَ ، فَكَأَنَّ ذَلِكَ آذَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ [النَّبِيُّ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا تَنَاوَلَ أَحَدُكُمْ عَنْ أَخِيهِ شَيْئًا فَلْيُرِهِ إِيَّاهُ  ( 19361 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أنبأ .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: رسول الله .","","Al-Marasil li-Abi Dawud 525","","الزهري عن عقيل بن خالد الأيلي عن الليث بن سعد عن عبد الله بن وهب المصري عن سليمان بن داود المهري عن أبو داود السجستاني","باب في الملاحم"
"525","526  -  حَدَّثَنَا  نَصْرُ بْنُ عَاصِمٍ [الْأَنْطَاكِيُّ]  ،  حَدَّثَنَا  يَحْيَى .  عَنِ  ابْنِ حَرْمَلَةَ ، [  قَالَ  ] :  خَرَجْتُ مَعَ سَعِيدِ بْنِ الْمُسَيِّبِ وَهُوَ آخِذٌ بِيَدِي ، فَرَفَعْتُ رَأْسِي ، فَإِذَا أَنَا بِالْهِلَالِ ، فَقُلْتُ : الْهِلَالُ يَا  أَبَا مُحَمَّدٍ  ، فَرَفَعَ رَأْسَهُ فَقَالَ :  آمَنْتُ بِالَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ  ، ثُمَّ قَالَ : كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ هَكَذَا .  ( 18714 )  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال ثنا .","","Al-Marasil li-Abi Dawud 526","","سعيد بن المسيب عن عبد الرحمن بن حرملة الأسلمي عن يحيى القطان عن نصر بن عاصم الأنطاكي عن أبو داود السجستاني","باب في الملاحم"
"526","[1/355]      527  -  حَدَّثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  أَبَانُ .  حَدَّثَنَا  قَتَادَةُ ، أَنَّهُ بَلَغَهُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا رَأَى الْهِلَالَ قَالَ : هِلَالُ خَيْرٍ وَرُشْدٍ  ، هِلَالُ خَيْرٍ وَرُشْدٍ  ، آمَنْتُ بِالَّذِي خَلَقَكَ ، ثَلَاثَ مَرَّاتٍ ، ثُمَّ يَقُولُ : الْحَمْدُ لِلهِ الَّذِي ذَهَبَ بِشَهْرِ كَذَا وَجَاءَ بِشَهْرِ كَذَا  ( 19224 ) .  قَالَ أَبُو دَاوُدَ :  رُوِيَ  مُتَّصِلًا  ، وَلَا يَصِحُّ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: حدثني .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: هلال خير ورشد .","","Al-Marasil li-Abi Dawud 527","","قتادة بن دعامة عن أبان بن يزيد العطار عن موسى بن إسماعيل التبوذكي عن أبو داود السجستاني","باب في الملاحم"
"527","528  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَلَاءِ ، أَنَّ زَيْدَ بْنَ الْحُبَابِ  أَخْبَرَهُمْ  ،  عَنْ  أَبِي هِلَالٍ .  عَنْ  قَتَادَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ إِذَا رَأَى الْهِلَالَ صَرَفَ وَجْهَهُ عَنْهُ  ( 19223 ) .","","Al-Marasil li-Abi Dawud 528","","قتادة بن دعامة عن محمد بن سليم الراسبي عن زيد بن الحباب العكلي عن أبو كريب محمد بن العلاء عن أبو داود السجستاني","باب في الملاحم"
