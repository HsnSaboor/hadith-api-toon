hadiths[116]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3585","«سآمرك بأمرين أيهما فعلت أجزأك عن الآخر وإن قويت عليهما فأنت أعلم إنما هذه ركضة من ركضات الشيطان فتحيضي ستة أيام أو سبعة أيام في علم الله ثم اغتسلي حتى إذا رأيت أنك قد طهرت واستنقأت فصلي ثلاثا وعشرين ليلة أو أربعا وعشرين ليلة وأيامها وصومي فإن ذلك يجزيك وكذلك فافعلي كل شهر كما يحضن النساء وكما يطهرن ميقات حيضهن وطهرهن وإن قويت على أن تؤخري الظهر وتعجلي العصر فتغتسلي وتجمعين بين الصلاتين الظهر والعصر وتؤخرين المغرب وتعجلين العشاء ثم تغتسلين وتجمعين بين الصلاتين فافعلي وتغتسلين مع الفجر فافعلي وصومي إن قدرت على ذلك وهذا أعجب الأمرين إلي»","حسن","Sahih al-Jami al-Saghir 3585","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3586","«ساب المؤمن كالمشرف على الهلكة»","حسن","Sahih al-Jami al-Saghir 3586","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3587","«ساعتان تفتح فيهما أبواب السماء وقلما ترد على داع دعوته: لحضور الصلاة والصف في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 3587","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3588","«ساقي القوم آخرهم»","صحيح","Sahih al-Jami al-Saghir 3588","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3589","«ساقي القوم آخرهم شربا»","صحيح","Sahih al-Jami al-Saghir 3589","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3590","«سألت الله الشفاعة لأمتي فقال: لك سبعون ألفا يدخلون الجنة بغير حساب ولا عذاب قلت: رب زدني فحثا لي بيديه مرتين وعن يمينه وعن شماله»","صحيح","Sahih al-Jami al-Saghir 3590","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3591","«سألت جبريل أي الأجلين قضى موسى؟ قال: أكملهما وأتمهما»","صحيح","Sahih al-Jami al-Saghir 3591","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3592","«سألت ربي أن لا يعذب اللاهين من ذرية البشر فأعطانيهم»","حسن","Sahih al-Jami al-Saghir 3592","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3593","«سألت ربي ثلاثا فأعطاني اثنتين ومنعني واحدة سألت ربي أن لا يهلك أمتي بالسنة فأعطانيها وسألته أن لا يهلك أمتي بالغرق فأعطانيها وسألته أن لا يجعل بأسهم بينهم فمنعنيها»","صحيح","Sahih al-Jami al-Saghir 3593","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3594","سأل موسى ربه فقال: يا رب ما أدنى أهل الجنة منزلة؟ قال: هو رجل يجيء بعدما يدخل أهل الجنة الجنة فيقال له: أدخل الجنة فيقول: أي رب كيف وقد نزل الناس منازلهم وأخذوا أخذاتهم؟ فيقال له: أترضى أن يكون لك مثل ملك ملك من ملوك الدنيا؟ فيقول: رضيت رب فيقول: لك ومثله ومثله ومثله ومثله فقال في الخامسة: رضيت رب فيقول هذا لك وعشرة أمثاله ولك ما اشتهت نفسك ولذت عينك فيقول رضيت رب! قال: رب فأعلاهم منزلة قال أولئك الذين أردت غرست كرامتهم بيدي وختمت عليها فلم تر عين ولم تسمع أذن ولم يخطر على قلب بشر","صحيح","Sahih al-Jami al-Saghir 3594","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3595","«سباب المسلم فسوق وقتاله كفر»","صحيح","Sahih al-Jami al-Saghir 3595","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3596","«سباب المسلم فسوق وقتاله كفر وحرمة ماله كحرمة دمه»","حسن","Sahih al-Jami al-Saghir 3596","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3597","«سبحان الله إنك لا تطيقه ولا تستطيعه هل قلت: اللهم آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار»","صحيح","Sahih al-Jami al-Saghir 3597","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3598","«سبحان الله بئسما جزتها نذرت لله إن نجاها الله عليها لتنحرنها لا وفاء لنذر في معصية الله ولا فيما لا يملك العبد»","صحيح","Sahih al-Jami al-Saghir 3598","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3599","«سبحان الله ماذا أنزل الليلة من الفتن؟ وماذا فتح من الخزائن؟ أيقظوا صواحب الحجر فرب كاسية في الدنيا عارية في الآخرة»","صحيح","Sahih al-Jami al-Saghir 3599","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3600","«سبحان الله ماذا أنزل من التشديد في الدين والذي نفسي بيده لو أن رجلا قتل في سبيل الله ثم أحيي ثم قتل ثم أحيي ثم قتل وعليه دين ما دخل الجنة حتى يقضى عنه دينه»","حسن","Sahih al-Jami al-Saghir 3600","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3601","«سبحان الله! هذا كما قال قوم موسى: {اجْعَلْ لَنَا إِلَهاً كَمَا لَهُمْ آلِهَةٌ} والذي نفسي بيده لتركبن سنن من كان قبلكم»","صحيح","Sahih al-Jami al-Saghir 3601","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3602","«سبع يجري للعبد أجرهن وهو في قبره بعد موته: من علم علما أو أجرى نهرا أو حفر بئرا أو غرس نخلا أو بنى مسجدا أو ورث مصحفا أو ترك ولدا يستغفر له بعد موته»","حسن","Sahih al-Jami al-Saghir 3602","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3603","«سبعة يظلهم الله في ظله يوم لا ظل إلا ظله: إمام عادل وشاب نشأ في عبادة الله ورجل قلبه معلق بالمسجد إذا خرج منه حتى يعود إليه ورجلان تحابا في الله فاجتمعا على ذلك وافترقا عليه ورجل ذكر الله خاليا ففاضت عيناه ورجل دعته امرأة ذات منصب وجمال فقال: إني أخاف الله رب العالمين ورجل تصدق بصدقة فأخفاها حتى لا تعلم شماله ما تنفق يمينه»","صحيح","Sahih al-Jami al-Saghir 3603","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3604","«سبعون ألفا من أمتي يدخلون الجنة بغير حساب: هم الذين لا يكتوون ولا يكوون ولا يسترقون ولا يتطيرون وعلى ربهم يتوكلون»","صحيح","Sahih al-Jami al-Saghir 3604","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3605","«سبق الكتاب أجله اخطبها إلى نفسها»","صحيح","Sahih al-Jami al-Saghir 3605","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3606","«سبق درهم مائة ألف درهم: رجل له درهمان أخذ أحدهما فتصدق به ورجل له مال كثير فأخذ من عرضه مائة ألف فتصدق بها»","حسن","Sahih al-Jami al-Saghir 3606","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3607","«سبقكن يتامى بدر ولكن سأدلكن على ما هو خير لكن من ذلك: تكبرن الله على إثر كل صلاة ثلاثا وثلاثين تكبيرة وثلاثا وثلاثين تسبيحة وثلاثا وثلاثين تحميدة ولا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير»","صحيح","Sahih al-Jami al-Saghir 3607","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3608","«ست من أشراط الساعة: موتي وفتح بيت المقدس وأن يعطى الرجل ألف دينار فيتسخطها وفتنة يدخل حرها بيت كل مسلم وموت يأخذ في الناس كقعاص الغنم وأن يغدر الروم فيسيرون بثمانين بندا تحت كل بند اثنا عشر ألفا»","صحيح","Sahih al-Jami al-Saghir 3608","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3609","«ستخرج نار من حضرموت قبل يوم القيامة تحشر الناس»","صحيح","Sahih al-Jami al-Saghir 3609","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3610","«ستر ما بين أعين الجن وعورات بني آدم إذا وضع أحدهم ثوبه أن يقول: بسم الله»","صحيح","Sahih al-Jami al-Saghir 3610","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3611","«ستر ما بين أعين الجن وعورات بني آدم إذا دخل أحدهم الخلاء أن يقول: بسم الله»","صحيح","Sahih al-Jami al-Saghir 3611","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3612","«ستصالحون الروم صلحا أمنا فتغزون أنتم وهم عدوا من ورائهم فتسلمون وتغنمون ثم تنزلون بمرج ذي تلول فيقوم رجل من الروم فيرفع الصليب ويقول: غلب الصليب! فيقوم إليه رجل من المسلمين فيقتله فيغدر القوم وتكون الملاحم فيجتمعون لكم فيأتونكم في ثمانين غاية مع كل غاية عشرة آلاف»","صحيح","Sahih al-Jami al-Saghir 3612","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3613","«ستفتح عليكم أرضون ويكفيكم الله فلا يعجز أحدكم أن يلهو بأسهمه»","صحيح","Sahih al-Jami al-Saghir 3613","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3614","«ستفتح عليكم الدنيا حتى تنجدوا بيوتكم كما تنجد الكعبة فأنتم اليوم خير من يومئذ»","صحيح","Sahih al-Jami al-Saghir 3614","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3615","«ستكون أئمة من بعدي يقولون فلا يرد عليهم قولهم يتقاحمون في النار كما تقاحم القردة»","صحيح","Sahih al-Jami al-Saghir 3615","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3616","«ستكون أحداث وفتنة وفرقة واختلاف فإن استطعت أن تكون المقتول لا القاتل فافعل»","صحيح","Sahih al-Jami al-Saghir 3616","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3617","«ستكون أمراء تشغلهم أشياء يؤخرون الصلاة عن وقتها فاجعلوا صلاتكم معهم تطوعا»","صحيح","Sahih al-Jami al-Saghir 3617","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3618","«ستكون أمراء فتعرفون وتنكرون فمن كره برئ ومن أنكر سلم ولكن من رضي وتابع لم يبرأ»","صحيح","Sahih al-Jami al-Saghir 3618","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3619","«ستكون بعدي أئمة يؤخرون الصلاة عن مواقيتها صلوها لوقتها فإذا حضرتم معهم الصلاة فصلوا»","صحيح","Sahih al-Jami al-Saghir 3619","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3620","«ستكون بعدي أثرة وأمور تنكرونها قالوا: فما تأمرنا؟ قال: تؤدون الحق الذي عليكم وتسألون الله الذي لكم»","صحيح","Sahih al-Jami al-Saghir 3620","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3621","«ستكون بعدي هنات وهنات فمن رأيتموه فارق الجماعة أو يريد أن يفرق أمر أمة محمد كائنا من كان فاقتلوه فإن يد الله مع الجماعة وإن الشيطان مع من فارق الجماعة يركض»","صحيح","Sahih al-Jami al-Saghir 3621","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3622","«ستكون بعدي هنات وهنات وهنات فمن أراد أن يفرق أمر المسلمين وهم جميع فاضربوه بالسيف كائنا من كان»","صحيح","Sahih al-Jami al-Saghir 3622","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3623","«ستكون فتنة القاعد فيها خير من القائم والقائم فيها خير من الماشي والماشي فيها خير من الساعي قيل: أفرأيت يا رسول الله إن دخل علي بيتي وبسط إلي يده ليقتلني؟ قال: كن كابن آدم»","صحيح","Sahih al-Jami al-Saghir 3623","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3624","ستكون فتن القاعد فيها خير من القائم والقائم فيها خير من الماشي والماشي فيها خير من الساعي من تشرف لها تستشرفه ومن وجد فيها ملجأ أو معاذا فليعذ به","صحيح","Sahih al-Jami al-Saghir 3624","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3625","«ستكون معادن يحضرها شرار الناس»","صحيح","Sahih al-Jami al-Saghir 3625","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3626","«سجدتا السهو في الصلاة تجزئان من كل زيادة ونقصان»","حسن","Sahih al-Jami al-Saghir 3626","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3627","«سددوا وقاربوا»","صحيح","Sahih al-Jami al-Saghir 3627","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3628","«سددوا وقاربوا وأبشروا واعلموا أنه لن يدخل أحدكم الجنة عمله ولا أنا إلا أن يتغمدني الله بمغفرة ورحمة»","صحيح","Sahih al-Jami al-Saghir 3628","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3629","«سعادة لابن آدم ثلاث وشقاوة لابن آدم ثلاث فمن سعادة ابن آدم: الزوجة الصالحة والمركب الصالح والمسكن الواسع وقوة لابن آدم ثلاث: المسكن السوء والمرأة السوء والمركب السوء»","حسن","Sahih al-Jami al-Saghir 3629","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3630","«سكاتها إقرارها» - يعني البكر -","صحيح","Sahih al-Jami al-Saghir 3630","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3631","«سل الله العفو والعافية في الدنيا والآخرة»","صحيح","Sahih al-Jami al-Saghir 3631","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3632","«سلوا الله العفو والعافية فإن أحدا لم يعط بعد اليقين خيرا من العافية»","صحيح","Sahih al-Jami al-Saghir 3632","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3633","«سلوا الله أن يستر عوراتكم ويؤمن روعاتكم»","حسن","Sahih al-Jami al-Saghir 3633","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3634","«سلوا الله ببطون أكفكم ولا تسألوه بظهورها»","صحيح","Sahih al-Jami al-Saghir 3634","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3635","«سلوا الله علما نافعا وتعوذوا بالله من علم لا ينفع»","حسن","Sahih al-Jami al-Saghir 3635","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3636","«سلوا الله لي الوسيلة أعلى درجة في الجنة لا ينالها إلا رجل واحد وأرجو أن أكون أنا هو»","صحيح","Sahih al-Jami al-Saghir 3636","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3637","«سلوا الله لي الوسيلة فإنه لا يسألها لي عبد في الدنيا إلا كنت له شهيدا أو شفيعا يوم القيامة»","حسن","Sahih al-Jami al-Saghir 3637","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3638","سمعتم بمدينة جانب منها في البر وجانب في البحر؟ لا تقوم الساعة حتى يغزوها سبعون ألفا من بني إسحاق فإذا جاءوها نزلوا فلم يقاتلوا بسلاح ولم يرموا بسهم قالوا: لا إله إلا الله والله أكبر فيسقط أحد جانبيها الذي في البحر ثم يقول الثانية: لا إله إلا الله والله أكبر فيسقط جانبها الآخر ثم يقول الثالثة: لا إله إلا الله والله أكبر فيفرج لهم فيدخلونها فيغنمون فبينما هم يقتسمون المغانم إذ جاءهم الصريخ فقال: إن الدجال قد خرج فيتركون كل شيء ويرجعون","صحيح","Sahih al-Jami al-Saghir 3638","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3639","«سم ابنك عبد الرحمن»","صحيح","Sahih al-Jami al-Saghir 3639","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3640","«سموا الله عليه وكلوه»","صحيح","Sahih al-Jami al-Saghir 3640","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3641","«سموا باسمي ولا تكنوا بكنيتي»","صحيح","Sahih al-Jami al-Saghir 3641","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3642","«سموا باسمي ولا تكنوا بكنيتي فإني إنما بعثت قاسما أقسم بينكم»","صحيح","Sahih al-Jami al-Saghir 3642","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3643","«سورة تبارك هي المانعة من عذاب القبر»","صحيح","Sahih al-Jami al-Saghir 3643","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3644","«سورة من القرآن ما هي إلا ثلاثون آية خاصمت عن صاحبها حتى أدخلته الجنة وهي تبارك»","حسن","Sahih al-Jami al-Saghir 3644","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3645","[سووا القبور على وجه الأرض إذا دفنتم الموتى]","حسن","Sahih al-Jami al-Saghir 3645","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3646","«سووا صفوفكم أو ليخالفن الله بين وجوهكم»","حسن","Sahih al-Jami al-Saghir 3646","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3647","«سووا صفوفكم فإن تسوية الصفوف من إقامة الصلاة»","صحيح","Sahih al-Jami al-Saghir 3647","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3648","«سووا صفوفكم لا تختلف قلوبكم»","صحيح","Sahih al-Jami al-Saghir 3648","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3649","«سلامة الرجل في الفتنة أن يلزم بيته»","حسن","Sahih al-Jami al-Saghir 3649","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3650","«سيأتي على الناس سنوات خداعات يصدق فيها الكاذب ويكذب فيها الصادق ويؤتمن فيها الخائن ويخون فيها الأمين وينطق فيها الرويبضة قيل: وما الرويبضة؟ قال: الرجل التافه يتكلم في أمر العامة»","صحيح","Sahih al-Jami al-Saghir 3650","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3651","«سيأتيكم أقوام يطلبون العلم فإذا رأيتموهم فقولوا لهم: مرحبا بوصية رسول الله وأفتوهم»","حسن","Sahih al-Jami al-Saghir 3651","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3652","«سيحان وجيحان والفرات والنيل كل من أنهار الجنة»","صحيح","Sahih al-Jami al-Saghir 3652","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3653","«سيخرج أقوام من أمتي يشربون القرآن كشربهم اللبن»","حسن","Sahih al-Jami al-Saghir 3653","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3654","سيخرج في آخر الزمان قوم أحداث الأسنان سفهاء الأحلام يقولون من خير قول البرية يقرءون القرآن لا يجاوز حناجرهم يمرقون من الدين كما يمرق السهم من الرمية فإذا لقيتموهم فاقتلوهم فإن في قتلهم أجرا لمن قتلهم عند الله يوم القيامة","صحيح","Sahih al-Jami al-Saghir 3654","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3655","«سيروا هذا جمدان سبق المفردون الذاكرون الله كثيرا والذاكرات»","صحيح","Sahih al-Jami al-Saghir 3655","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3656","«سيشدد هذا الدين برجال ليس لهم عند الله خلاق»","صحيح","Sahih al-Jami al-Saghir 3656","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3657","«سيصدقون ويجاهدون إذا أسلموا»","صحيح","Sahih al-Jami al-Saghir 3657","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3658","«سيصيب أمتي داء الأمم: الأشر والبطر والتكاثر والتشاحن في الدنيا والتباغض والتحاسد حتى يكون البغي»","حسن","Sahih al-Jami al-Saghir 3658","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3659","«سيصير الأمر إلى أن تكونوا جنودا مجندة جند بالشام وجند باليمن وجند بالعراق عليك بالشام فإنها خيرة الله من أرضه يجتبي إليها خيرته من عباده فإن أبيتم فعليكم يمنكم واسقوا من غدركم فإن الله قد توكل لي بالشام وأهله»","صحيح","Sahih al-Jami al-Saghir 3659","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3660","«سيقرأ القرآن رجال لا يجاوز حناجرهم يمرقون من الدين كما يمرق السهم من الرمية»","صحيح","Sahih al-Jami al-Saghir 3660","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3661","«سيكون أمراء تعرفون وتنكرون فمن نابذهم نجا ومن اعتزلهم سلم ومن خالطهم هلك»","صحيح","Sahih al-Jami al-Saghir 3661","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3662","«سيكون بعدي من أمتي قوم يقرءون القرآن لا يجاوز حلاقيمهم يخرجون من الدين كما يخرج السهم من الرمية ثم لا يعودون فيه هم شر الخلق والخليقة سيماهم التحليق»","صحيح","Sahih al-Jami al-Saghir 3662","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3663","«سيكون رجال من أمتي يأكلون ألوان الطعام ويشربون ألوان الشراب ويلبسون ألوان الثياب ويتشدقون في الكلام فأولئك شرار أمتي»","حسن","Sahih al-Jami al-Saghir 3663","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3664","«سيكون عليكم أمراء يؤخرون الصلاة عن مواقيتها ويحدثون البدع قال ابن مسعود: فكيف أصنع؟ قال: تسألني يا ابن أم عبد كيف تصنع؟ لا طاعة لمن عصى الله»","صحيح","Sahih al-Jami al-Saghir 3664","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3665","«سيكون في آخر الزمان خسف وقذف ومسخ إذا ظهرت المعازف والقينات واستحلت الخمر»","صحيح","Sahih al-Jami al-Saghir 3665","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3666","«سيكون في آخر الزمان شرطة يغدون في غضب الله ويروحون في سخط الله»","صحيح","Sahih al-Jami al-Saghir 3666","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3667","«سيكون في آخر الزمان ناس من أمتي يحدثونكم بما لم تسمعوا به أنتم ولا آباؤكم فإياكم وإياهم»","صحيح","Sahih al-Jami al-Saghir 3667","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3668","«سيكون في أمتي اختلاف وفرقة قوم يحسنون القيل ويسيئون الفعل يقرءون القرآن لا يجاوز تراقيهم يمرقون من الدين مروق السهم من الرمية لا يرجعون حتى يرتد على فوقه هم شرار الخلق والخليقة طوبى لمن قتلهم وقتلوه يدعون إلى كتاب الله وليسوا منه في شيء من قاتلهم كان أولى بالله منهم سيماهم التحليق»","صحيح","Sahih al-Jami al-Saghir 3668","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3669","«سيكون في أمتي أقوام يكذبون بالقدر»","صحيح","Sahih al-Jami al-Saghir 3669","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3670","«سيكون قوم يأكلون بألسنتهم كما تأكل البقر من الأرض»","صحيح","Sahih al-Jami al-Saghir 3670","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3671","«سيكون قوم يعتدون في الدعاء»","حسن","Sahih al-Jami al-Saghir 3671","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3672","«سيلي أموركم من بعدي رجال يعرفونكم ما تنكرون وينكرون عليكم ما تعرفون فمن أدرك ذلك منكم فلا طاعة لمن عصى الله عز وجل»","صحيح","Sahih al-Jami al-Saghir 3672","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3673","«سيوقد المسلمون من قسي يأجوج ومأجوج ونشابهم وأترستهم سبع سنين»","صحيح","Sahih al-Jami al-Saghir 3673","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3674","«سيد الاستغفار أن تقول: اللهم أنت ربي لا إله إلا أنت خلقتني وأنا عبدك وأنا على عهدك ووعدك ما استطعت أعوذ بك من شر ما صنعت أبوء لك بنعمتك علي وأبوء لك بذنبي فاغفر لي فإنه لا يغفر الذنوب إلا أنت من قالها من النهار موقنا بها فمات من يومه قبل أن يمسي فهو من أهل الجنة ومن قالها من الليل وهو موقن بها فمات قبل أن يصبح فهو من أهل الجنة»","صحيح","Sahih al-Jami al-Saghir 3674","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3675","«سيد الشهداء حمزة بن عبد المطلب ورجل قام إلى إمام جائر فأمره ونهاه فقتله»","حسن","Sahih al-Jami al-Saghir 3675","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3676","«سيد الشهداء عند الله يوم القيامة حمزة بن عبد المطلب»","حسن","Sahih al-Jami al-Saghir 3676","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3677","«سيد ريحان أهل الجنة الحناء»","صحيح","Sahih al-Jami al-Saghir 3677","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3678","«سيدات نساء أهل الجنة أربع: مريم وفاطمة وخديجة وآسية»","صحيح","Sahih al-Jami al-Saghir 3678","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3679","«السائمة جبار والجب جبار والمعدن جبار وفي الركاز الخمس»","حسن","Sahih al-Jami al-Saghir 3679","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3680","«الساعي على الأرملة والمسكين كالمجاهد في سبيل الله أو القائم الليل الصائم النهار»","صحيح","Sahih al-Jami al-Saghir 3680","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3681","«السبع المثاني فاتحة الكتاب»","صحيح","Sahih al-Jami al-Saghir 3681","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3682","«السجدة التي في {ص} سجدها داود توبة ونحن نسجدها شكرا»","صحيح","Sahih al-Jami al-Saghir 3682","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3683","«السحور أكله بركة فلا تدعوه ولو أن يجرع أحدكم جرعة من ماء فإن الله وملائكته يصلون على المتسحرين»","حسن","Sahih al-Jami al-Saghir 3683","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3684","«السراويل لمن لا يجد الإزار والخف لمن لا يجد النعلين»","صحيح","Sahih al-Jami al-Saghir 3684","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3685","«السعيد من سعد في بطن أمه والشقي من شقي في بطن أمه»","صحيح","Sahih al-Jami al-Saghir 3685","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3686","«السفر قطعة من العذاب يمنع أحدكم طعامه وشرابه ونومه فإذا قضى أحدكم نهمته من وجهه فليعجل الرجوع إلى أهله»","صحيح","Sahih al-Jami al-Saghir 3686","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3687","«السفل أرفق»","صحيح","Sahih al-Jami al-Saghir 3687","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3688","«السكينة عباد الله السكينة»","صحيح","Sahih al-Jami al-Saghir 3688","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3689","«السكينة في أهل الشاء»","صحيح","Sahih al-Jami al-Saghir 3689","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3690","«السلف في حبل الحبلة ربا»","صحيح","Sahih al-Jami al-Saghir 3690","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3691","«السل شهادة»","صحيح","Sahih al-Jami al-Saghir 3691","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3692","«السمت الحسن والتؤدة والاقتصاد جزء من أربعة وعشرين جزءا من النبوة»","حسن","Sahih al-Jami al-Saghir 3692","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3693","السمع والطاعة حق على المرء المسلم فيما أحب أو كره ما لم يؤمر بمعصية فإذا أمر بمعصية فلا سمع عليه ولا طاعة","صحيح","Sahih al-Jami al-Saghir 3693","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3694","«السنور من أهل البيت وإنه من الطوافين أو الطوافات عليكم»","صحيح","Sahih al-Jami al-Saghir 3694","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3695","«السواك مطهرة للفم مرضاة للرب»","صحيح","Sahih al-Jami al-Saghir 3695","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3696","«السواك يطيب الفم ويرضي الرب»","صحيح","Sahih al-Jami al-Saghir 3696","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3697","«السلام اسم من أسماء الله وضعه الله في الأرض فأفشوه بينكم فإن الرجل المسلم إذا مر بقوم فسلم عليهم فردوا عليه كان له عليهم فضل درجة بتذكيره إياهم السلام فإن لم يردوا عليه رد عليه من هو خير منهم وأطيب»","صحيح","Sahih al-Jami al-Saghir 3697","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3698","السلام عليكم دار قوم مؤمنين وإنا إن شاء الله بكم لاحقون وددت أنا قد رأينا إخواننا قالوا: أولسنا إخوانك؟ قال: بل أنتم أصحابي وإخواننا الذين لم يأتوا بعد قالوا: كيف تعرف من لم يأت بعد من أمتك؟ قال: أرأيت لو أن رجلا له خيل غر محجلة بين ظهري خيل دهم بهم ألا يعرف خيله قالوا: بلى قال: فإنهم يأتون يوم القيامة غرا محجلين من الوضوء وأنا فرطهم على الحوض ألا ليذادن رجال عن حوضي كما يذاد البعير الضال أناديهم: ألا هلم ألا هلم فيقال: إنهم قد بدلوا بعدك فأقول: سحقا فسحقا فسحقا","صحيح","Sahih al-Jami al-Saghir 3698","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3699","«السلام قبل السؤال فمن بدأكم بالسؤال قبل السلام فلا تجيبوه»","حسن","Sahih al-Jami al-Saghir 3699","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
"3700","«السيد الله»","صحيح","Sahih al-Jami al-Saghir 3700","","","الأحاديث المبدوءة بحرف السين Hadith Beginning with the Letter Sin (س)"
