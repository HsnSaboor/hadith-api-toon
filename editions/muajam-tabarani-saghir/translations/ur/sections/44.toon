hadiths[263]{hadithnumber,text}:
"18305","أتثًأصؼشتؤأثۏتىأڬشحەأۄۏڽأ=أهًڲًڽأىەأذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأڬەأضتوىەأزدتهأڬتأسڬشأڬۏتأحًأتىۄًڽأىەألشوتۏتأ=أهًڲأحۏىأڲشًۄًڽأوۏڽأحمضۏوأۄًأدتةۏڽأڲەأ؏أتۏڬأڲشًۄأزدتهأڬەأځۏډہەأډهتأدتةەأڲتأ؏أتۏڬأڲشًۄأتځىەأإثتاأتدزتزأڬۏأضشصوۏىأځشأډهتأدتةەأڲتأدۄتڽأطۏذأىتوۏأثًټۏأتْڲحۏأۄەأتًشأتۏڬأڲشًۄأزشۏتةەألشتحأڬەأڬىتشەأإأدتةەأڲتأ؏أزدتهأتىأڬەأضتحہأدىڲأڬشەأڲتأتًشأًۄأهًڲأزدتهأڬەأضتحہأدىڲأڬشۏڽأڲەأ؏أۏۄتڽأحڬأڬۄأتۄهأتۏوتىأ؏أطتوأڬەأوؽشثۏأؼهتمەأوۏڽأتڬټہەأۄًڽأڲەأتًشأزدتهأڬەأثتشەأوۏڽأتغهتؼأزۏىەأڬەأهةەأڬډہأهًڲًڽأڬًأثہۏدۏڽأڲەأ؏أتْىأوۏڽأضەأڬًةۏأطۄضًتشأحۏصأضشرأشىڲأڬەأڲہًڔەأځشأضًتشأۄًأڲتأۏتأضۏتۄأًأضلۏزأڲہًڔەأځشأضًتشأۄًأڲتأ؏أًۄأهًڲأهڔتةۏأوۏڽأذظۄأهۏڽأڲەأتًشأتىأوۏڽأضەأڬًةۏأثہۏأًتځضأىۄۏڽأإةەأڲتأۗأ أذعشحأؼثزتههۄأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أهًڲًڽأڬتأۏۄأڬۄىتأۄەأ=أڬۄأذعشحأؼۏضۏٳأؼهۏۄأتهضهتوأىتصهأۄًڽأڲەأتًشأزدتهأڬًأمحهأڬشۏڽأڲەأۗ أشتًۏأڬۄحەأۄۏڽأ=أوۏڽأىەأذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأڬًأتۄهأڬحتثأڬەأذًتهەأضەأتضأڬەأؼهتًۄأڬًةۏأتًشأشًتۏحأثۏتىأڬشحەأۄًةەأىۄۏڽأضىتأ؏أځہشأۏتأدًدأوتدًدأىڬهأإةۏڽأڲەأ؏أًۄأصوۏىأوۏڽأځہۏهأدتةۏڽأڲەأتًشألضتزأځۏزتأڬشۏڽأڲەأ؏أځہشأذعشحأؼثزتههۄأشعۏأتههۄأؼىۄأىەأۏۄأإۏحأحهتًحأڬۏأ=أ أ““أتًشأًۄأۄشأثهىزۏأضەأحۏصۏأضەأډهحەأۄًةەأإةۏڽأڲەأۗ‛‛أ"
"18306","أتثًأوشۏۄأىثۏأتڬشوأ﷽أڬەأذًتهەأضەأۏۄأثتحأىمهأڬشحەأۄۏڽأ=أشتًۏأڬًأطڬأۄەأ؏أۏتأطتۏزأۏۄأتهلتػأۄۏڽأ=أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ"
"18307","أذعشحأصۏزأثىأتشموأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ="
"18308","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأتههۄأحؼتهۏٳأڬەألشوتىأڬەأثتشەأوۏڽأىمهأڬشحەأۄۏڽأ=أ أ““أدثأظًشأوۏڽأځہًىڬأوتشۏأدتةەأڲۏأۗ‛‛أ"
"18309","حضرت ابوسعید خدری رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" جب بھی صبح ہوتی ہے تو دو فرشتے پکار کر یہ کہتے ہیں : ہر عیب سے پاک ہے وہ بادشاہ جو قدوس ہے اور دو فرشتے پکار کر یہ کہتے ہیں : اے اللہ ! خرچ کرنے والے کو اس کی جگہ مزید عطا فرما اور خرچ نہ کرنے والے کے ( مال کو ) ضائع کر دے اور دو فرشتے صور پر تعینات ہیں ، وہ دونوں اس بات کے منتظر ہیں کہ کب انہیں حکم ہوتا ہے تو وہ پھونک مار دیں اور دو فرشتے پکار کر یہ کہتے ہیں : اے بھلائی کے طلبگار ! آگے آ جاا ، اے برائی کے طلبگار ! باز آ جاا ، اور دو فرشتے پکار کر یہ کہتے ہیں : مردوں کے لیے عورتوں کے حوالے سے بربادی ہے اور عورتوں کے لئے مردوں کے حوالے سے بربادی ہے ۔"""" ( علامہ ہیثمی فرماتے ہیں : ) میں یہ کہتا ہوں : امام ابن ماجہ نے اس روایت کا ایک حصہ نقل کیا ہے ۔ یہ روایت امام بزار نے نقل کی ہے اس کی سند میں ایک راوی خارجہ بن مصعب خراسانی ہے جو انتہائی ضعیف ہے ، نجی بن یحیی نے کہا ہے : یہ مستقیم الحدیث ہے ، اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"18310","أؼثزتههۄأثىأذتشخأثۏتىأڬشحەأۄۏڽأ=أوۏڽأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأڬەأځتضأوًدًزأحہتأتْىأڬەأځتضأڬؼثأتذثتشأوًدًزأحہەأ؏أتىۄًڽأىەأذعشحأتضشتلۏهأؼهۏۄأتهضهتوأڬتأسڬشأڬۏتأحًأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأىەألشوتۏتأ=أتەأڬؼثأ$أحوأودہەأذعشحأتضشتلۏهأؼهۏۄأتهضهتوأڬەأثتشەأوۏڽأثحتاأ$أڬؼثأىەأدًتثأزۏتأ=أإځأهًڲًڽأڬەأځتضأؼهوأۄەأ؏أضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأىەألشوتۏتأ=أدۏأۄتڽأ$أضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأىەألشوتۏتأ=أهۏڬىأحوأودہەأثحتاأ$أحًأڬؼثأتذثتشأىەأثحتۏتأ=أتْىأڬەأډتشأځشأۄۏڽأ؏أزًأځشأۄًتأوۏڽأۄۏڽأ؏أتۏڬأځشأتىأڬۏأصۏىحأۄەأ؏أتۏڬأځشأتىأڬۏأڬتۄهأىتوۏأ+أشڲأڬۏأ,أدڲۄأځشأۄەأ؏أمهوأتىأڬەأڬتىأځشأۄەأ؏أدثأًذۏأىتصهأۄًحۏأۄەأحًأمهوأهڬہحتأۄەأتًشألشطحەأزشضأهۏحەأۄۏڽأتًشأظًشأځشأوحؼۏىألشطحۄأًۄأتۏڬأڲہټىەأڬەأثهأدہڬتأۄًتأۄەأتًشأزًضشتأڲہټىتأتْضأىەأڬہڔتأڬۏتأۄًتأۄەأ؏أتضأىەأظًشأڬًأوىۄأڬەأضتحہأهڲتۏتأۄًتأۄەأ؏أتْضأىەأتځىۏأځطحأڬًأدہڬتۏتأۄًتأۄەأ؏أتْضەأۏۄأذڬوأزۏتأڲۏتأۄەأڬۄأدثأًۄأذعشحأتضشتلۏهأؼهۏۄأتهضهتوأڬًأزۏڬہەأڬۄأتىۄًڽأىەأتځىەأځشأوهتأهۏەأۄۏڽأ؏أحًأًۄأظًشأوۏڽأځہًىڬ وتشأزەأۗأ أحًأضۏزۄأؼتةطۄأشعۏأتههۄأؼىۄتأىەألشوتۏتأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأتضۏأغشذأتشطتزألشوتحەأۄًةەأضىتأۄەأۗأ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتًشأتضأڬۏأضىزأذضىأۄەأۗ"
"18311","أذعشحأؼمثۄأثىأؼتوشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأضەأځۄهەأحوأهًڲًڽأځشأتۏڬأضۏتۄأشىڲأڬتأثتزهأإةەأڲتأدًأوؽشثأڬۏأغشلأضەأإةەأڲتأتًشأڋہتهأڬۏأغشذأڬتأۄًأڲتأ؏أًۄأوضهضهأإضوتىأوۏڽأثهىزأۄًحتأشۄەأڲتأتًشأځہۏهحتأشۄەأڲتأۏۄتڽأحڬأڬۄأإضوتىأڬًأثہشأزەأڲتأځہشأتۏڬأوىتزۏأۏۄأتؼهتىأڬشەأڲتأ=أتەأهًڲًأ$أحًأهًڲأتۏڬأزًضشەأڬۏأغشلأوحًدۄأۄًأڬشأځًډہۏڽأڲەأ=أڬۏتأحوأىەأضىتأۄەأآأحًأتىأوۏڽأضەأڬډہأهًڲأدًتثأزۏڽأڲەأ=أدۏأۄتڽأ$أًۄأزًضشۏأوشحثۄأځڬتشأڬشأڬۄەأڲتأ=أتەأهًڲًأ$أتههۄأڬتأذڬوأإأڲۏتأۄەأ؏أحًأحوأتضأڬەأذًتهەأضەأدهزثتصۏأىۄأڬشًأۗ‛‛ أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=““أتْضأستحأڬۏأمضوأ$أدضأڬەأزضحأمزشحأوۏڽأوۏشۏأدتىأۄەأ؏أزًأإزوۏًڽأىەأتځىتأڬځڔتأځہۏهتۏتأۄًتأۄًأڲتأتًشأًۄأزًىًڽأتضەأضوۏټأىۄۏڽأضڬۏڽأڲەأ؏أتۏڬأطرظأتځىەأذًعأڬًأثىتأشۄتأۄًأڲتأتًشأًۄأتضأوۏڽأضەأځتىۏأذتظهأىۄۏڽأڬشأځتةەأڲتأ؏أتۏڬأطرظأتځىۏأتًىټىۏأڬتأزًزہأزًۄأشۄتأۄًأڲتأ؏أهۏڬىأًۄأتضأڬًأځۏأىۄۏڽأضڬەأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأوذوزأثىأؼثزتههۄأڬتأوؼتوهۄأورحهلأۄەأدًأذعشحأوؽۏشۄأشعۏأتههۄأؼىۄأڬتأؽهتوأۄەأتًشأًۄأخمۄأۄەأۗ"
"18312","ابو ہریرہ رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""قیامت ضرور برپا ہوگی اور دو آدمی کا کپڑا ان کے درمیان ہوگا، نہ وہ اسے موڑیں گے اور نہ بیچیں گے، اور قیامت برپا ہوگی جبکہ آدمی نے لقمہ منہ تک اٹھایا ہوگا مگر اسے نہ کھا سکے گا، اور قیامت برپا ہوگی جبکہ آدمی اپنا حوض لپٹ رہا ہوگا مگر اس سے نہ پلا سکے گا۔"" میں نے کہا: یہ حدیث صحیح میں ہے سوا اس جزو کے کہ ""اور آدمی نے لقمہ اٹھایا ہوگا مگر نہ کھا سکے گا۔"" اسے احمد نے روایا ہے اور اس کے راوی صحیح کے راوی ہیں۔"
"18313","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أًۄأحوۄۏڽأځتاڽأوتشأڬتأعشًشأځہۏىڬەأڲۏأدضأغشذأدًتىأتًىټأځتاڽأوتشحتأۄەأۗ‛‛أ أشتًۏأڬۄحەأۄۏڽأ=أىثۏأتڬشوأ﷽أڬۏأوشتزأۏۄأحہۏأڬۄأصوۏىأتۏضتأڬشەأڲۏأۗأ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأخمۄأۄۏڽأۗ"
"18314","أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأ؏أىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أوټۏأځًشەأتىضتىأڬًأڬہتأدتحۏأۄەأ؏أضًتةەأځطحأوۏڽأوًدًزأتۏڬأورظًظأذظەأڬەأ؏أؼشعأڬۏأڲةۏأ=أۏتأشضًهأتههۄأ$أتضأڬۏأوختهأڬۏتأۄەأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أًۄأشتةۏأڬەأزتىەأڬۏأوتىىزأۄەأ؏أتْضۏأضەأحوۄۏڽأزًثتشۄأصىزۄأڬۏتأدتةەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتًشأتضأڬۏأضىزأذضىأۄەأۗ"
"18315","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أذعشحأهًغأؼهۏۄأتهضهتوأڬۏأمًوأتستىأڬەأًمحأۄهتڬحأڬتأطڬتشأۄًةۏأحہۏأتًشأمۏتوحأثہۏأتستىأڬەأًمحأمتةوأۄًأڲۏأۗ‛‛أ أتوتوأغثشتىۏأڬۄحەأۄۏڽأ=أوۏشەأىصزۏڬأتضأڬتأوغهثأۏۄأۄەأًۏضەأتههۄأثۄحشأدتىحتأۄەأڬۄألدشأڬۏأتستىأڬەأًمحأتۏضتأۄًأڲتأتًشأۏۄأتضحؽلتشأتًشأزؼتأڬتأًمحأۄەأۗ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأظشلأإزوأثىأؼهۏأڬتأوؼتوهۄأورحهلأۄەأتًشأًۄأخمۄأۄەأۗ"
"18316","أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ أ““أإځضأوۏڽأدىڲأڬشىەأًتهەأتلشتزأڬًأمۏتوحأڬەأزىأتْىأڬۏأىۏحًڽأڬەأوغتثمأصىزۄأڬۏتأدتةەأڲتأۗ‛‛أ أۏۄأشًتۏحأتثًۏؼهۏٳأىەأڬثۏشأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأدتثشأدؼلۏأۄەأتًشأًۄأعؼۏلأۄەأۗ"
"18317","أذعشحأدتثشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أۄشأطرظأڬًأتضأڬۏأرًتۄطأڬەأوغتثمأصىزۄأڬۏتأدتةەأڲتأ؏أدضأطرظأڬۏأرًتۄطأڬلشأۄًأڲۏأ؏أتضەأڬتلشًڽأڬەأضتحہأشڬہتأدتةەأڲتأتًشأتضأڬتأؼوهأتضەأڬًةۏألتةزۄأىۄۏڽأزەأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأۗ"
"18318","أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أحوۄۏڽأثشۄىۄأځتاڽأ؏أثشۄىۄأدضوأرحىەأڬەأثؽۏشأذتهحأوۏڽأذطشأڬەأزىأتټہتۏتأدتةەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأؼوشأثىأطثۄأڬتأوؼتوهۄأورحهلأۄەأتًشأًۄأخمۄأۄەأۗ"
"18319","أذعشحأضۄهأثىأضؼزأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأهًڲًڽأڬًأځۏزهأ؏أثشۄىۄأځتاڽأ؏أرحىەأڬەأثؽۏشأذتهحأوۏڽأتْټہتۏتأدتةەأڲتأ؏أؼشعأڬۏأڲةۏأ=أۏتأشضًهأتههۄأ$أڬۏتأوشزأ؏أؼًشحًڽأڬۏأغشلأزۏڬہۏڽأڲەأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتضأًمحأۄشأطرظأڬتأۏۄأؼتهوأۄًأڲتأڬۄأتْضأڬۏأحًدۄأڬضۏأتًشأڬۏأغشلأىۄۏڽأۄًأڲۏأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتًشأوؼدوأڬثۏشأوۏڽأتضأضەأصۏتزۄأترحظتشأڬەأضتحہأىمهأڬۏأۄەأ؏أتىأزًىًڽأوۏڽأتۏڬأشتًۏأتثشتۄۏوأثىأذوتزأثىأتثًذتصوأۄەأدضەأتوتوأزتشمغىۏأىەأعؼۏلأمشتشأزۏتأۄەأ؏أڬثۏشأڬەأثمۏۄأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18320","أضۏزۄأتوأضهوۄأشعۏأتههۄأؼىۄتأثۏتىأڬشحۏأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ"
"18321","أذعشحأتوتوأذضىأثىأؼهۏأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ="
"18322","أضۏزيأضًزۄأثىحأصوؼۄأشعۏأتههۄأؼىۄتأثۏتىأڬشحۏأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ="
"18323","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأهًڲًڽأڬتأذطشأدتىًشًڽأځشأۄًأڲتأ؏أحتڬۄأًۄأتځىۏأمثشًڽأضەأىڬهأڬشأوۏزتىأوذطشأحڬأدتأضڬۏڽأ؏أذعشحأظتهذأؼهۏۄأتهضهتوأتځىۏأتًىټىۏأځشأدتةۏڽأڲەأ؏أوۏشەأزًىًڽأثۏټەأذضىأتًشأذضۏىأ؏أوۏشۏأتًىټىۏأؼعثتؤأځشأدتةۏڽأڲەأ؏أوۏڽأثشتمأځشأدتاڽأڲتأ؏أدضأڬتأتۏڬأمزوأذزأىڲتۄأحڬأۄًحتأۄەأ؏أثهتهأدىحأڬۏأتۏڬأتًىټىۏأځشأدتةەأڲتأ؏أًۄأوذعأتستىأزەأڲتأ؏أدًأزشذمۏمحأڲًتۄۏأۄًأڲۏأ؏أۏۄتڽأحڬأڬۄأدثأًۄأۏۄأڬۄەأڲتأ=أوۏڽأتضأثتحأڬۏأڲًتۄۏأزۏحتأۄًڽأڬۄأذعشحأوذوزأ﷽أتههۄأڬەأشضًهأۄۏڽأ؏أحًأځۄهەأًتهەأتًشأثؼزأًتهەأحوتوأواوىۏىأتضأثتحأڬۏأڲًتۄۏأزۏڽأڲەأ؏أحًأڬضۏأڬۏأڲًتۄۏأمثًهأۄًأدتةەأڲۏأتًشأڬضۏأڬۏأوضحشزأۄًأدتةەأڲۏأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأظؽۏشأتًشأوؼدوأڬثۏشأوۏڽأىمهأڬۏأۄەأتًشأتىأڬەأتهلتػأۏۄأۄۏڽأ= أ““أمۏتوحأڬەأزىأتىثۏتةەأڬشتوأڬًأورحهلأدتىًشًڽأځشأثټہتۏتأدتةەأڲتأ؏أحتڬۄأًۄأوۏزتىأوذطشأحڬأدتأضڬۏڽأ؏أذعشحأظتهذأؼهۏۄأتهضهتوأڬًأتىأڬۏأتًىټىۏأځشأضًتشأڬۏتأدتةەأڲتأ؏أودہەأثشتمأځشأضًتشأڬۏتأدتةەأڲتأ؏أوۏشەأزًىًڽأثۏټًڽأذضىأتًشأذضۏىأڬًأدىحأڬۏأزًأتًىټىۏًڽأځشأضًتشأڬۏتأدتةەأڲتأۗ‛‛أ أتضأشًتۏحأڬۏأضىزأوۏڽأتۏڬأشتًۏأتثًظتهذأۄەأ؏أدًأهۏخأڬتأڬتحثأۄەأتًشأًۄأعؼۏلأۄەأًۏضەأتضأڬۏأحًخۏمأڬۏأڲةۏأۄەأتًشأتۏڬأشتًۏأؼخوتىأثىأۏذۏۏأثىأظتهذأۄەأدًأتضۏأغشذأۄەأ؏أتىأزًىًڽأشًتۏتحأڬەأثمۏۄأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18324","ابن عمر رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""ان لوگوں پر جو لا الہ الا اللہ کہتے ہیں، مرنے میں، قبروں میں، اور اٹھائے جانے میں کوئی وحشت نہیں ہے، گویا میں انہیں دیکھ رہا ہوں جب چیخ پڑے گی تو وہ اپنے سر مٹی سے جھاڑ رہے ہوں گے، کہتے ہوئے: اللہ کا شکر ہے جس نے ہم سے غم دور کر دیا۔"" اسے طبرانی نے روایا ہے، اس میں بعض لوگ ہیں جنہیں میں نہیں جانتا۔"
"18325","أضهۏوأثىأؼتوشأڬهتؼۏأثۏتىأڬشحەأۄۏڽأ=أۄوأىەأذعشحأومزتوأثىأوؼزۏأڬشثأڬىزۏأشعۏأتههۄأؼىۄأضەأڬۄتأ=أتەأتثًڬشۏوۄأ$أهًڲًڽأڬتأۏۄأڬۄىتأۄەأڬۄأإځأىەأىثۏأتڬشوأ﷽أڬۏأصۏتشحأىۄۏڽأڬۏأۄەأ؏أتىۄًڽأىەألشوتۏتأ=أدۏأۄتڽأ$أتههۄأڬۏأمضوأ$أوۏڽأىەأىثۏأتڬشوأ﷽أڬۏأصۏتشحأڬۏأۄەأ؏أىثۏأتڬشوأ﷽أىەأوۏشەأتضأڬتىأڬۏأهًأڬًأځڬڔأهۏتأحہتأ؏أوۏڽأتځىەأډډتأڬەأضتحہأډهحتأۄًتأإأڲۏتأحہتأ؏أځہشأىثۏأتڬشوأ﷽أۄوأىەأوۏشەأډډتأضەألشوتۏتأحہتأ=أڬۏتأحوأضودہحەأۄًأڬۄأًۄأتضأڬتأسڬشأڬشەأڲتأۗ أشتًۏأڬۄحەأۄۏڽأ=أۄوأىەأڬۄتأ=أتەأتثًڬشۏوۄأ$أإځأۄوۏڽأًۄأثتحأثۏتىأڬۏدةەأدًأإځأىەأىثۏأتڬشوأ﷽أڬۏأصثتىۏأضىۏأۄًأ؏أحًأتىۄًڽأىەألشوتۏتأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄألشوتحەأۄًةەأضىتأۄەأ="
"18326","أذعشحأومزتوأثىأتضًزأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ"
"18327","أذعشحأدتثشأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأتههۄأحؼتهۏٳأڬډہأهًڲًڽأڬًأډۏًىټۏًڽأڬۏأطڬهأوۏڽأتټہتةەأڲتأ؏أدىۄۏڽأهًڲأتځىەأځتاڽأڬەأسشۏؼەأشًىزأشۄەأۄًڽأڲەأ؏أحًأۏۄأزشۏتلحأڬۏتأدتةەأڲتأ=أتىأهًڲًڽأڬتأڬۏتأوؼتوهۄأۄەأآأدًأډۏًىټۏًڽأڬۏأطڬهأوۏڽأۄۏڽأ؏أحًأۏۄأڬۄتأدتةەأڲتأ=أۏۄأًۄأهًڲأحہەأدًأزىۏتأوۏڽأحڬثشأڬۏتأڬشحەأحہەأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأڬتأذڬوأثىأؼثزتههۄأؼوشۏأۄەأتًشأًۄأوحشًڬأۄەأۗ"
"18328","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أحڬثشأڬشىەأًتهًڽأڬًأمۏتوحأڬەأزىأډۏًىټۏًڽأڬۏأطڬهأوۏڽأتټہتۏتأدتةەأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأتًشأتضأڬۏأضىزأوۏڽأتۏضتأشتًۏأۄەأدضأضەأوۏڽأًتملأىۄۏڽأۄًڽأۗ"
"18329","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أتڲشأإزوۏأڬًأۏۄأځحۄأډهأدتةەأڬۄأوًحأڬەأثؼزأتضأڬًأڬۏتأظًشحذتهأځۏطأإةەأڲۏأآأحًأًۄأڬًةۏأډۏصأىۄأڬہتةەأڬًةۏأډۏصأىۄأځۏەأ؏أظشلأشًحتأشۄەأتًشأتځىتأضۏىۄأځۏټحتأشۄەأۗ‛‛ أشًتۏحأتوتوأغثشتىۏأىەأوؼدوأظؽۏشأتًشأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأتثشتۄۏوأثىأۄشتضۄأۄەأتًشأًۄأوحشًڬأۄەأۗ"
"18330","ابو ہریرہ رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""اس کے بعد موت کچھ نہیں مگر بکری کی ٹکر جیسی۔"" اسے طبرانی نے اوسط میں روایا ہے، اس میں بعض لوگ ہیں جنہیں میں نہیں جانتا۔"
"18331","أؼثزتهؼصۏصأؼغتشأ؏أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأڬەأذًتهەأضەأۏۄأشًتۏحأىمهأڬشحەأۄۏڽأتًشأوۏشتأرۏتهأۄەأتىۄًڽأىەأتضأڬًأوشلًؼأذزۏخأڬەأغًشأځشأىمهأڬۏتأۄەأ+أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأۄەأ=أ,أ أ““أتثىأإزوأڬًأدثأتههۄأحؼتهۏٳأىەأځۏزتأڬۏتأ؏أتْضأًمحأضەأهەأڬشأتْضأىەأڬضۏأتۏضۏأډۏصأڬتأضتوىتأىۄۏڽأڬۏتأدًأتضأڬەأهةەأوًحأضەأصۏتزۄأضرحأۄًأ؏أذتهتىڬۄأتضأڬەأثؼزأًتهۏأظًشحذتهأڬەأومتثهەأوۏڽأوًحأإضتىأۄەأ؏أهًڲأمۏتوحأڬەأزىأتۏضۏأضرحأۄًهىتڬۏأڬتأضتوىتأڬشۏڽأڲەأڬۄأتىأڬًأځضۏىەأڬۏأهڲتوأڋتهأزۏأدتةەأڲۏأتًشأًۄأځضۏىۄأتحىتأۄًأڲتأڬۄأتڲشأتضأوۏڽأڬطحۏتڽ ډهتةۏأدتةۏڽأحًأًۄأثہۏأډهأځڔۏڽأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتًشأتضأڬۏأضىزأؼوزۄأۄەأۗأ أۏۄأشًتۏحأتوتوأتذوزأىەأترحظتشأڬەأضتحہأتۏڬأظذتثۏأڬەأذًتهەأضەأىمهأڬۏأۄەأتًشأتىۄًڽأىەأتضأڬەأوشلًؼأۄًىەأوۏڽأطڬأڬتأتػۄتشأىۄۏڽأڬۏتأۄەأتًشأتضأڬۏأضىزأؼوزۄأۄەأۗ"
"18332","أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أوًحأڬۏأحوىتأىۄأڬشًأ$أڬۏًىڬۄأوغهؼأڬۏأۄًهىتڬۏأطزۏزأۄەأۗ‛‛أ أتضأڬەأثؼزأشتًۏأىەأځًشۏأذزۏخأسڬشأڬۏأۄەأدًأتضأضەأځۄهەأڬحتثأحًثۄأوۏڽأ؏أؼوشأغًۏهأۄًىەأضەأوحؼهمأثتثأوۏڽأڲصشأډڬۏأۄەأۗأ أۏۄأشًتۏحأتوتوأتذوزأتًشأتوتوأثصتشأىەأىمهأڬۏأۄەأتًشأتىأزًىًڽأڬۏأضىزأؼوزۄأۄەأۗ"
"18333","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأهًڲًڽأڬًأصىزۄأڬۏتأدتةەأڲتأتًشأتضأًمحأإضوتىأتْىأځشأۄهڬۏأثتشطأىتصهأڬشەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأتذوزأ؏أتوتوأتثًۏؼهۏٳأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأؼثزتهشذوىأثىأتثًظۄثتؤأۄەأدضأڬتأسڬشأتثىأتثًذتحوأىەأڬۏتأۄەأتىۄًڽأىەأتضأڬەأثتشەأوۏڽأڬًةۏأدشذأسڬشأىۄۏڽأڬۏأۄەأتضأشًتۏحأڬەأثمۏۄأشدتهأخمۄأۄۏڽأۗ"
"18334","أذعشحأتثًتوتوۄأثتۄهۏأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ= أ““أمۏتوحأڬەأزىأضًشدأتۏڬأوۏهأڬەألتظهەأدحىتأمشۏثأإأدتةەأڲتأتًشأتضأڬۏأحځطأتحىۏأتحىۏأثڔہأدتةەأڲۏأۏۄتڽأحڬأڬۄأڬۏڔەأوڬًڔەأتضأڬۏأًدۄأضەأۏًڽأڬہًهأتټہۏڽأڲەأدۏضەأۄىڋۏتأڬہًهحۏأۄەأتًشأهًڲأتضأظًشحذتهأوۏڽأۏًڽأؼشمأإهًزأۄًڽأڲەأڬۄأًۄأځضۏىۄأتىأڬەأڲىتۄًڽأڬەأذًتهەأضەأۄًأڲتأ؏أًۄأتىأوۏڽأضەأڬضۏأڬەأټرىەأحڬأځۄىډأشۄتأۄًأڲتأ؏أڬضۏأڬۏأځىڋهۏًڽأحڬأإأشۄتأۄًأڲتأ؏أڬضۏأڬەأًضغأحڬأإأشۄتأۄًأڲتأ؏أتًشأڬضۏأڬًأځضۏىەأڬۏأهڲتوأڋتهۏأڲةۏأۄًأڲۏأۗ‛‛ أۏۄأشًتۏحأتوتوأتذوزأتًشأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتوتوأتذوزأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأظشلأمتضوأثىأؼثزتهشذوىأڬتأوؼتوهۄأورحهلأۄەأتًشأتۏڬأضەأصۏتزۄأتلشتزأىەأتضەأخمۄأمشتشأزۏتأۄەأۗ"
"18335","أذعشحأؼمثۄأثىأؼتوشأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ"
"18336","أضؼۏزأثىأؼتوشأتىظتشۏأثۏتىأڬشحەأۄۏڽأ=أوۏڽأذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄأتًشأذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأڬەأځتضأثۏټہتأۄًتأحہتأ؏أتىأزًىًڽأوۏڽأضەأتۏڬأىەأزًضشەأضەأۏۄأڬۄتأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأثتحأسڬشأڬشحەأۄًةەأضىتأۄەأڬۄأمۏتوحأڬەأزىأهًڲًڽأڬەأځضۏىەأڬتأڬۏتأؼتهوأۄًأڲتأآ أتْىأزًىًڽأوۏڽأضەأتۏڬأىەأۏۄأثتحأسڬشأڬۏأڬۄأڬضۏأطرظأڬتأځضۏىۄأتضأڬۏأڬتىًڽأڬۏأهًأحڬأۄًأڲتأتًشأزًضشەأظتذثأىەأۏۄأثتحأسڬشأڬۏأ؏أځضۏىەأىەأتضەأهڲتوأڋتهۏأۄًةۏأۄًأڲۏأ؏أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأىەأتطتشۄأڬشأڬەأثحتۏتأڬۄأڬتىًڽأڬۏأهًأضەأهەأڬشأتضأڬەأوىۄأحڬأتۏضەأۄًأڲتأ؏أتثًؼتظوأىتوۏأشتًۏأىەأتځىۏأزًأتىڲهۏًڽأڬەأسشۏؼەأتطتشۄأڬشأڬەأۏۄأثحتۏتأڬۄأتۏضەأۄًأڲتأتًشأتىۄًڽأىەأۏۄأڬۄتأ=أوۏشەأرۏتهأوۏڽأۏۄأزًىًڽأظًشحۏڽأثشتثشأۄۏڽأۗ"
"18337","أذعشحأومزتوأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأضًشدأتحىتأمشۏثأإأدتةەأڲتأڬۄأًۄأهًڲًڽأضەأتۏڬأوۏهأڬەألتظهەأدحىتأشۄأدتةەأڲتأتًشأتضأڬۏأڲشوۏأصۏتزۄأۄًأدتةەأڲۏأ؏أدًأتىۄۏڽأدهتةەأڲۏأتًشأهًڲأتضأظًشحذتهأوۏڽأتځىەأتؼوتهأڬەأذضتثأضەأځضۏىەأڬۏأورحهلأومزتشًڽأوۏڽأۄًڽأڲەأ؏أڬضۏأطرظأڬتأځضۏىۄأتضأڬەأټرىًڽأحڬأإأشۄتأۄًأڲتأ؏أڬضۏأڬتأځضۏىۄأتضأڬەأڲہټىًڽأحڬأإأشۄتأۄًأڲتأ؏أڬضۏأڬتأځضۏىۄأتضأڬەأځۏټأڬەأىډهەأذظەأحڬأإأشۄتأۄًأڲتأتًشأڬضۏأڬًأځضۏىەأڬۏأهڲتوأڋتهۏأڲةۏأۄًأڲۏأۗ أشتًۏأڬۄحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأزۏڬہتأڬۄأإځأىەأتځىەأزضحأوثتشڬأڬەأسشۏؼەأتځىەأوىۄأڬۏأغشلأتطتشۄأڬۏتأۗ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأتځىەأتضحتزأتثشتۄۏوأثىأوذوزأؼشمأذوظۏأڬەأذًتهەأضەأىمهأڬۏأۄەأتًشأوۏڽأتضأضەأًتملأىۄۏڽأۄًڽأ؏أتضأشًتۏحأڬەأثمۏۄأشدتهأڬۏأىمهأڬشزۄأذزۏخأذضىأۄًحۏأۄەأۗ"
"18338","أوذوزأثىألشتحأثۏتىأڬشحەأۄۏڽأ=أوذتشثأڬەأضتوىەأزًأإزوۏًڽأىەأتځىتأومزوۄأځۏطأڬۏتأ؏أشتًۏأڬۄحەأۄۏڽأ=أتىأزًىًڽأوۏڽأضەأتۏڬأڬەأرهتلأتۏڬأطرظأىەأڲًتۄۏأزۏزۏأ؏أحًأدضأطرظأڬەأرهتلأڲًتۄۏأزۏأڲةۏأحہۏأتْضأىەأڬۄتأ=أتههۄأڬۏأمضوأ$أوۏشەأؼهوأڬەأوغتثمأۏۄأتۏڬأضډتأإزوۏأۄەأتًشأتڲشأإځأتضأڬەأثتشەأوۏڽأحلحۏطأڬشۏڽأحًأتضأڬۏأحؼشۏلأڬۏأدتةەأڲۏأتًشأتضأڬۏأىۏڬۏأڬتأحسڬشۄأۄًأڲتأ؏أهۏڬىأتضأىەأوۏشەأرهتلأدہًټۏأڲًتۄۏأزۏأۄەأتًشأودہەأتىزتصۄأىۄۏڽأۄًأځتۏتأڬۄأتضەأڬضأثتحأىەأتضأڬتوأڬۏأدشئحأزهتةۏأۄەأآأ أحًأوذتشثأثىأزختشأىەأتضأطرظأضەأڬۄتأ=أتەأطرظأ$أحوأتههۄأحؼتهۏٳأضەأڋشًأ$أڬۏًىڬۄأوۏڽأىەأذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأڬًأۏۄأثۏتىأڬشحەأۄًةەأضىتأۄەأ=أًۄأڬۄحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ أ““أدہًټۏأڲًتۄۏأزۏىەأًتهەأطرظأڬەأمزوأتځىۏأدڲۄأضەأۄهىەأضەأځۄهەأتْضأڬەأهةەأدۄىوأًتدثأۄًأدتحۏأۄەأتًشأمۏتوحأڬەأزىأځشىزۄأتځىەأځشأوتشەأڲتأتًشأدًأڬډہأتضأڬەأځۏټأوۏڽأۄەأتْضەأىڬتهأزەأڲتأذتهتىڬۄأتضەأتضأڬۏأڬًةۏأذتدحأىۄۏڽأۄًأڲۏأۗ‛‛أ أشتًۏأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أتْضأًمحأڬضۏأطرظأڬًأًؼػأًأىظۏذحأڬشأشۄەأحہەأۗأ"
"18339","أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أمۏتوحأڬەأزىأضتشۏأڬۏأضتشۏأصوۏىأإڲأۄًأڲۏأتًشأدىحأتضأڬەأځشەأۄًأڲۏأ؏أهًڲأتضأڬۏأذًشًڽأڬًأتًشأتضأڬەأثشحىًڽأڬًأزۏڬہۏڽأڲەأ؏أتضأستحأڬۏأمضوأ$أدضأڬەأزضحأمزشحأوۏڽأؼثزتههۄأڬۏأدتىأۄەأ؏أڬًةۏأطرظأتحىتأځضۏىۄأثۄتةەأڲتأڬۄأصوۏىأوۏڽأتىأڬتأًدًزأځضۏىەأوۏڽأڋًثتأۄًأڲتأتًشأڬضۏأڬتأځضۏىۄأتضأڬۏأىتڬأحڬأځۄىډأشۄتأۄًأڲتأ؏أذتهتىڬۄأتثہۏأتضأڬتأذضتثأىۄۏڽأۄًتأۄًأڲتأۗأ أهًڲًڽأىەأزشۏتلحأڬۏتأ=أتەأتثًؼثزتهشذوىأ$أتضأڬۏأًدۄأڬۏتأۄًأڲۏأآأتىۄًڽأىەألشوتۏتأ=أًۄأظًشحذتهأدضأڬتأهًڲأضتوىتأڬشۏڽأڲەأۗ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوًمًلأشًتۏحأڬەأغًشأځشأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18340","أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأڬتلشأڬەأهۏەأځډتضأۄصتشأضتهأڬۏأومزتشأىظثأڬۏأدتةەأڲۏأ؏أۏًڽأدۏضەأتضأىەأزىۏتأوۏڽأڬًةۏأثہۏأؼوهأىۄۏڽأڬۏتأتًشأڬتلشأډتهۏضأضتهأڬۏأوضتلحأڬەألتظهەأضەأدۄىوأڬًأزۏڬہەأڲتأتًشأۏۄأڲوتىأڬشەأڲتأڬۄأًۄأتضأوۏڽأڲشأدتةەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأتذوزأتًشأتوتوأتثًۏؼهۏٳأىەأىمهأڬۏأۄەأتًشأتضأڬۏأضىزأذضىأۄەأتڲشډۄأتضأڬەأشتًۏًڽأوۏڽأعؼلأځتۏتأدتحتأۄەأۗ"
"18341","عبداللہ یعنی ابن مسعود رضی اللہ عنہ سے نبی ﷺ سے روایت ہے کہ آپ نے فرمایا: ""قیامت کے دن آدمی کو پسینہ اتنا لگیں گا کہ وہ کہے گا: اے رب! مجھے راحت دے، چاہے آگ (جهنم) ہی کی طرف۔"""
"18342","أتۏڬأ““أوًمًلأ‛‛أشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=†أثەأطڬأڬتلشأ111111‛‛ۗأ ۏۄأزًىًڽأشًتۏتحأغثشتىۏأىەأڬثۏشأوۏڽأزًأتضىتزأڬەأضتحہأىمهأڬۏأۄۏڽأتىۄًڽأىەأتضأڬًأتًضغأوۏڽأثہۏأىمهأڬۏتأۄەأۗ"
"18343","أتىأزًىًڽأڬۏأتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=أتىۄًڽأىەألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأڬتلشأضەأذضتثأهۏتأدتةەأڲتأ؏أۏۄتڽأحڬأڬۄأځضۏىۄأتضەأهڲتوأڋتهأزەأڲتأۗ‛‛"
"18344","أ““أتًضغأ‛‛أڬۏأتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=أ أ““أتضأزىأڬۏأطزحأڬۏأًدۄأضەأڬتلشأڬًأځضۏىەأڬۏأهڲتوأڋتهأزۏأدتةەأڲۏأ؏أۏۄتڽأحڬأڬۄأًۄأۏۄأڬۄەأڲتأ=111111‛‛ۗأ أڬثۏشأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأتًشأتًضغأڬەأشدتهأوۏڽأتۏڬأشتًۏأوذوزأثىأتضذتمأۄەأتًشأًۄأخمۄأۄەأهۏڬىأًۄأوزهضأۄەأۗأ أۏۄأشًتۏحأتوتوأتثًۏؼهۏٳأىەأوشلًؼأشًتۏحأڬەأغًشأځشأڬثۏشأڬۏأشًتۏحأڬۏأوتىىزأىمهأڬۏأۄەأۗ"
"18345","أذعشحأدتثشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أوۏزتىأوذطشأوۏڽأڬضأطرظأڬًأتحىتأځضۏىۄأإةەأڲتأڬۄأًۄأۏۄأڬۄەأڲتأ=أتەأوۏشەأځشًشزڲتشأ$أحۏشتأودہەأدۄىوأڬۏأغشلأثہۏدأزۏىتأ؏أوۏشەأهةەأتضأضەأصۏتزۄأۄهڬتأۄًأڲتأ؏أدضأظًشحذتهأڬتأوۏڽأضتوىتأڬشأشۄتأۄًڽأذتهتىڬۄأًۄأطرظأۏۄأثتحأدتىحتأۄًأڲتأڬۄأدۄىوأڬتأؼستثأڬحىتأطزۏزأۄًأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏألعهأثىأؼۏضۏٳأشمتطۏأۄەأتًشأًۄأتىحۄتةۏأعؼۏلأۄەأۗ"
"18346","أذعشحأوؼتسأثىأدثهأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأوًوىۏىأڬًأۏًڽأصىزۄأڬۏتأدتةەأڲتأڬۄأًۄأزتڔہۏأوًىډہأڬەأثؽۏشأۄًڽأڲەأتىأڬۏأإىڬہۏڽأضشوڲۏڽأۄًڽأڲۏأتًشأتىأڬۏأؼوشأحۏضأضتهأۄًأڲۏأۗ‛‛أ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتًشأتضأڬۏأضىزأذضىأۄەأظشلأۏۄأۄەأڬۄأطۄشأىتوۏأشتًۏأىەأذعشحأوؼتسأثىأدثهأشعۏأتههۄأؼىۄأڬتأصوتىۄأىۄۏڽأځتۏتأۄەأۗأ"
"18347","أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أؼشعأڬۏأڲةۏأ=أۏتأشضًهأتههۄأ$أ+أتشطتزأثتشۏأحؼتهۏٳأۄەأ=أ,أ أ““أتۏڬأتۏضتأزىأدًأځډتضأۄصتشأضتهأڬتأۄًأڲتأۗ‛‛أ حًأۏۄأزىأڬحىتأصۏتزۄأغًۏهأۄًأڲتأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ"
"18348","ابو ہریرہ رضی اللہ عنہ سے نبی ﷺ سے روایت ہے کہ آپ نے فرمایا: ""جس دن لوگ رب العالمین کے لیے کھڑے ہوں گے، اس کا اندازہ پچاس ہزار سال کے نصف دن کے برابر ہوگا، پھر اس کو مومن پر آسان کر دیا جائے گا جیسے سورج غروب ہونے کے لیے ڈھلتی ہے یہاں تک کہ غروب ہو جائے۔"" اسے ابو یعلی نے روایا ہے، اس کے راوی صحیح کے راوی ہیں سوا اسماعیل بن عبداللہ بن خالد کے، اور وہ ثقت ہیں۔"
"18349","أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أًۄأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًةەأ؏أتىۄًڽأىەأؼشعأڬۏأ=أوۏڽأإځأضەأحۏىأډۏصًڽأڬەأثتشەأوۏڽأضًتهأڬشىەأًتهتأۄًڽأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أحوأدًأډتۄًأضًتهأڬشًأ$أتىۄًڽأىەأؼشعأڬۏأ=أمۏتوحأڬەأزىأحوتوأدۄتىًڽأڬەأځشًشزڲتشأڬەأضتوىەأهًڲأڬحىتأؼشظۄأڬہڔەأشۄۏڽأڲەأآأتًشأًۄأڬہڔتأشۄىتأ؏أوًوىأڬەأهةەأڬحىتأوطڬهأۄًأڲتأآأتًشأڬۏتأدىحأتًشأدۄىوأڬەأزشوۏتىأڬًةۏأتًشأوىصهأۄەأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۄتڽأحڬأحوۄتشەأتضأضًتهأڬتأحؼهمأۄەأڬۄأهًڲأحوتوأدۄتىًڽأڬەأځشًشزڲتشأڬەأإڲەأڬحىتأؼشظۄأڬہڔەأشۄۏڽأڲەأآأحًأًۄأ4333أضتهأ+أڬتأؼشظۄأ,أۄًأڲتأ؏أتىۄۏڽأتدتصحأىۄۏڽأزۏأدتةەأڲۏأۗأ أدۄتڽأحڬأحوۄتشەأتضأضًتهأڬتأحؼهمأۄەأڬۄأًۄأڬہڔتأۄًىتأ؏أوًوىأڬەأهةەأڬحىتأوطڬهأۄًأڲتأآأحًأوًوىۏىأڬەأزًأڲشًۄأۄًڽأڲەأ؏أدۄتڽأحڬأضثمحأهەأدتىەأًتهەأهًڲًڽأڬتأحؼهمأۄەأحًأدضأغشذأزًأإزوۏأضشڲًطۏأوۏڽأثتحأڬشأشۄەأۄًڽأتًشأتىأڬۏأضشڲًطۏأغًۏهأۄًأدتةەأتًشأځہشأًۄأزًىًڽأًتځضأډهەأدتةۏڽأ+أثضأتحىتأًمحأوذضًضأۄًأڲتأتًشأتىۄۏڽأدىحأوۏڽأزترهأڬشأزۏتأدتةەأڲتأۗأ أوۏڽأىەأڬۄتأ=أۏۄأحًأثۄحأإضتىأۄەأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۄتڽأحڬأحوۄتشەأتضأضًتهأڬتأحؼهمأۄەأڬۄأڬۏتأدىحأتًشأدۄىوأڬەأزشوۏتىأڬًةۏأتًشأوىصهأثہۏأۄەأآأحًأتىأزًىًڽأڬەأزشوۏتىأوۏشتأذًعأۄەأ؏أتضأڬتأثتهتةۏأذظۄأدىحأضەأهڲحتأۄەأتًشأتضأڬەأثتهتةۏأذظەأڬتأتۏڬأذظۄأدۄىوأضەأهڲحتأۄەأ؏أتضأڬۏأهوثتةۏأتۏڬأوتۄأڬۏأوضتلحأدحىۏأۄەأتًشأتضأڬۏأډًڔتةۏأثہۏأتۏڬأوتۄأڬۏأوضتلحأدحىۏأۄەأ؏أتضأڬتأځتىۏأزًزہأضەأصۏتزۄأضلۏزأۄەأتًشأطۄزأضەأصۏتزۄأوۏټہتأۄەأتضأوۏڽأډتىزۏأڬەأځۏتهەأتًشأطۏطەأڬەأثشحىأۄًڽأڲەأدًأتضأوۏڽأضەأتۏڬأڲهتضأځۏأهەأڲتأتضەأځۏتضأۏتأؽوأوذضًضأىۄۏڽأۄًأڲتأ؏أدثأحڬأهًڲًڽأڬەأزشوۏتىألۏظهۄأىۄۏڽأۄًأدتحتأۗ‛‛أ"
"18350","حضرت عبداللی بن عمرو رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" تم لوگ قیامت کے دن اکٹھے ہو گے ، تو یہ کہا جائے گا : اس امت کے فقراؤ اور مساکین کہاں ہیں ء تو وہ کھڑے ہو جائیں گے ، ان سے دریافت کیا جائے گا : تم نے کیا عمل کیا ء وہ جواب دیں گے : اے ہمارے پروردگار ! تو نے ہمیں آزمائش میں مبتلا کیا تو ہم نے صبر سے کام لیا ، تو نے امور اور حکومت کا نگران ہمارے علاوہ دوسروں کو بنایا ، تو اللہ تعالیٰ فرمائے گا : تم نے سچ کہا ہے ، راوی کو شک ہے ، یا شاید اس کی مانند کوئی اور کلمہ ہے ، نبی اکرم ﷺ نے فرمایا : تو وہ لوگ دوسرے لوگوں سے ایک مخصوص عرصہ پہلے جنت میں داخل ہو جائیں گے اور حساب کی شدت ان لوگوں کے لیے باقی رہ جائے گی ( یعنی جو دنیا میں امور اور حکومت سے متعلق افراد تھے ) ۔ لوگوں نے دریافت کیا : اْس وقت مومنین کہاں ہوں گے ء نبی اکرم ﷺ نے فرمایا : اْن کے لیے نور سے بنے ہوئے منبر رکھے جائیں گے ، ان پر بادل سایہ کر دیں گے اور وہ ( یعنی قیامت کا ) دن مومنین کے لیے ( دنیا کے ) دن کے ایک پہر سے زیادہ مختصر ہو گا ۔"""" یہ روایت امام طبرانی نے نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں صرف ابوکثیر زبیدی کا معاملہ مختلف ہے اور وہ ثقہ ہے ۔"
"18351","أذعشحأهمۏغأثىأؼتوشأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أًۄأىوتةىزەأڬەأغًشأځشأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًةەأ؏أتىأڬەأضتحہأتىأڬەأتۏڬأضتحہۏأحہەأ؏أدىأڬتأىتوأىۄۏڬأثىأؼتظوأثىأوتهڬأثىأوىحلمأحہتأ؏أذعشحأهمۏغأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأتًشأوۏشتأضتحہۏأشًتىۄأۄًةەأۏۄتڽأحڬأڬۄأۄوأتضأًمحأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًةەأ؏أدثأشدثأڬتأوۄۏىۄأڲصشأډڬتأحہتأ؏أۄوأتضأًمحأىثۏأتڬشوأ﷽أڬەأځتضأإةەأدثأإځأظثذأڬۏأىوتصأضەألتشؽأۄًىەأڬەأثؼزأهًڲًڽأڬەأزشوۏتىأرغثۄأزۏىەأڬەأهۏەأڬہڔەأۄًةەأحہەأ؏أإځأىەأتشطتزألشوتۏتأ=أ"
"18352","أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ= أ““أتۏڬأورظًظأغەأطزۄأزىأوۏڽأ؏أتههۄأحؼتهۏٳأضثأځۄهەأًتهًڽأتًشأثؼزأًتهًڽأڬًأدوؼأڬشەأڲتأ؏أًۄأډتهۏضأضتهأحڬأڬہڔەأشۄۏڽأڲەأتىأڬۏأىڲتۄۏڽأإضوتىأڬۏأغشلأتټہۏأۄًةۏأۄًڽأڲۏأتًشأًۄأذضتثأۄًىەأڬەأوىحػشأۄًڽأڲەأۗ أإځأ﷽ألشوتحەأۄۏڽأ=أتههۄأحؼتهۏٳأثتزهًڽأڬەأضتةەأوۏڽأؼشطأضەأڬشضۏأڬۏأغشلأتحشەأڲتأ؏أځہشأتۏڬأوىتزۏأۏۄأتؼهتىأڬشەأڲتأ=أتەأهًڲًأ$أڬۏتأحوأتځىەأځشًشزڲتشأضەأشتعۏأىۄۏڽأحہەأآأدضأىەأحوۄۏڽأځۏزتأڬۏتأ؏أدضأىەأحوۄۏڽأشصمأؼغتأڬۏتأ؏أدضأىەأحوۄۏڽأۏۄأذڬوأزۏتأڬۄأحوأتضأڬۏأؼثتزحأڬشًأتًشأڬضۏأڬًأتضأڬتأطشۏڬأمشتشأىۄأزًأ؏أتثأحوأوۏڽأضەأۄشأتۏڬأتضأڬەأځتضأډهتأدتةەأ؏أدضأڬەأضتحہأًۄأىضثحأشڬہحتأحہتأتًشأزىۏتأوۏڽأدضأڬۏأًۄأؼثتزحأڬشحتأحہتأ؏أڬۏتأۏۄأحوۄتشەأځشًشزڲتشأڬۏأغشلأضەأؼزهأڬەأوغتثمألۏظهۄأىۄۏڽأۄەأآأهًڲأدًتثأزۏڽ ڲەأ=أدۏأۄتڽأ$أ"
"18353","أتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أهًڲأحوتوأدۄتىًڽأڬەأځشًشزڲتشأڬۏأثتشڲتۄأوۏڽأ73أضتهأحڬأڬہڔەأشۄۏڽأڲەأ؏أتْىأڬۏأىڲتۄۏڽأتًځشأڬۏأغشلأتټہۏأۄًةۏأۄًڽأڲۏأتًشأًۄألۏظهەأڬەأوىحػشأۄًڽأڲەأۗ‛‛أتضأڬەأثؼزأشتًۏأىەأصۏزأثىأتثًتىۏضۄأڬۏأىمهأڬشزۄأشًتۏحأڬۏأوتىىزأشًتۏحأىمهأڬۏأۄەأۗأ أۏۄأحوتوأشًتۏتحأتوتوأغثشتىۏأىەأورحهلأذًتهًڽأضەأىمهأڬۏأۄۏڽأتىأوۏڽأضەأتۏڬأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأتثًرتهزأزتهتىۏأڬتأوؼتوهۄأورحهلأۄەأتًشأًۄأخمۄأۄەأۗ"
"18354","أذعشحأضوشۄأثىأدىزثأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أۄوأضەأۏۄألشوتحەأحہەأ= أ““أحوأهًڲًڽأڬتأذطشأ““أثۏحأتهومزضأ‛‛أڬۏأغشلأڬۏتأدتةەأڲتأتًشأځہشأحوۄۏڽأمۏتوحأڬەأزىأتڬټہتأڬۏتأدتةەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأتًشأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأغثشتىۏأڬۏأضىزأذضىأۄەأۗ"
"18355","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأ=أدًأطرظأتضأثتحأوۏڽأطڬأڬشحتأۄًأڬۄأوذطشأطتوأوۏڽأۄًأڲتأ؏أتْضەأضًشۄأذطشأڬۏأتثحزتةۏأ+أزشدأسۏهأ,أإۏتحأځڔہأهۏىۏأډتۄۏەأ=أ أ““أتضۏأىەأتۄهأڬحتثأضەأحؼهمأشڬہىەأًتهەأڬتلشًڽأڬًأځۄهەأذطشأڬەأغًشأځشأىڬتهتأ111111‛‛ۗأ أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أًۄأوذطشأڬۏأصوۏىأۄەأۗ‛‛أشتًۏأڬۄحەأۄۏڽأ=أۏؼىۏأطتوأۗأ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأتثًضؼزأثمتهأۄەأتًشأتضأځشأعؼۏلأۄًىتأؽتهثأۄەأۗ"
"18356","ابو موسی اشعری رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""لوگ جما کیے جائیں گے، پھر منادی پکارے گا: کیا یہ میری طرف سے عدل نہیں کہ میں ہر قوم کو وہی سونپ دوں جسے وہ عبادت کرتے تھے؟ پھر ان کے معبود ان کے سامنے اٹھائے جائیں گے تو وہ ان کے پیچھے چلیں گے، یہاں تک کہ اس امت کے سوا کوئی نہ بچے گا، تو ان سے کہا جائے گا: تمہیں کیا ہوا؟ وہ کہیں گے: ہم اپنا معبود نہیں دیکھتے جسے ہم عبادت کرتے تھے، تو ان پر ظہور ہوگا - تبارک وتعالیٰ۔"" ابو بردہ سے کہا گیا: اللہ کی قسم، کیا تم نے ابو موسی کو رسول اللہ ﷺ سے یہ بات بیان کرتے سنا ہے؟ انہوں نے کہا: اللہ کی قسم جس کے سوا کوئی معبود نہیں، تین مرتبہ۔ اسے طبرانی نے کبیر اور اوسط میں روایا ہے، اس میں فرات بن سائب ہے، اور وہ ضعیف ہے۔"
"18357","أذعشحأتثًوًضۏٳأتطؼشۏأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأتضأتوحأڬتأذطشأحۏىأتظىتلأوۏڽأڬۏتأدتةەأڲتأ؏أتۏڬأمضوأًۄأۄًأڲۏأدًأذضتثأڬەأثؽۏشأدىحأوۏڽأزترهأۄًأدتةەأڲۏأ؏أتۏڬأمضوأًۄأۄًأڲۏأ؏أدىأضەأوؼوًهۏأذضتثأهۏتأدتةەأڲتأتًشأًۄأدىحأوۏڽأزترهأۄًأدتةۏڽأڲەأ؏أتۏڬأمضوأًۄأۄًأڲۏأدًأځۄتڔًڽأڬۏأغشذأڬەأتځىەأثًدہأهەأڬشأإةۏڽأڲەأ؏أتههۄأحؼتهۏٳألشطحًڽأضەألشوتةەأڲتأذتهتىڬۄأًۄأتىأڬەأثتشەأوۏڽأصۏتزۄأثۄحشأدتىحتأۄەأ؏أۏۄأڬًىأهًڲأۄۏڽأآألشطحەأدًتثأزۏڽأڲەأ=أتەأۄوتشەأځشًشزڲتشأ$أۏۄأحۏشەأثىزەأۄۏڽأدًأحۏشۏأؼثتزحأڬۏتأڬشحەأحہەأ؏أۏۄأڬضۏأڬًأحۏشتأطشۏڬأمشتشأىۄۏڽأزۏحەأحہەأ؏أحًأتههۄأحؼتهۏٳألشوتةەأڲتأ=أتىأڬتأثًدہأۄټتأزًأ$أتًشأۏۄًزۏًڽأتًشأؼۏضتةۏًڽأځشأڋتهأزًأتًشأتىۄۏڽأوۏشۏأشذوحأڬەأًضۏهەأضەأدىحأوۏڽأزترهأڬشأزًأۗ‛‛"
"18358","أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أحوأهًڲًڽأڬًأتۏڬأوۏزتىأوۏڽأتڬټہتأڬۏتأدتةەأڲتأضثأهًڲأثۏىتةۏأڬەأزتةشەأوۏڽأإأضڬۏڽأڲەأ؏أتًشأځڬتشىەأًتهتأضثأحڬأتځىۏأإًتصأځۄىډتأضڬەأڲتأۗ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأشۏتذأىرؼۏأڬتأوؼتوهۄأورحهلأۄەأتًشأًۄأخمۄأۄەأۗ"
"18359","أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أثەأطڬأتههۄأحؼتهۏٳأمۏتوحأڬەأزىأضثأتوحًڽأڬًأدوؼأڬشەأڲتأ؏أځہشأًۄأؼشطأضەأڬشضۏأڬۏأغشلأتحشأڬشأإةەأڲتأتًشأتضأڬۏأڬشضۏأىەأإضوتىًڽأتًشأصوۏىأڬًأڲہۏشتأۄًتأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأؼثزتهتؼهۏٳأثىأوضتًشأۄەأتًشأًۄأوحشًڬأۄەأۗ"
"18360","ابو ہریرہ رضی اللہ عنہ سے نبی ﷺ سے روایت ہے کہ آپ نے فرمایا: ""میری امت سے میرے ساتھ قیامت کے دن ایسے لوگ آئیں گے جیسے سیلاب اور رات، وہ لوگوں کو کچل ڈالیں گے، تو فرشتے کہیں گے: محمد ﷺ کے ساتھ جو آئے ہیں وہ باقی امتوں یا انبیاء کے ساتھ آئے ہوئے لوگوں سے زیادہ ہیں۔"" اسے بزار نے روایا ہے، اس میں موسی بن عبیدہ ہے، اور وہ ضعیف ہے۔"
"18361","أذعشحأتثًسشأؽلتشۏأشعۏأتههۄأؼىۄأتًشأذعشحأتثًزشزتؤأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأوۏڽأزۏڲشأتوحًڽأڬەأزشوۏتىأتځىۏأتوحأڬًأځۄډتىأهًڽأڲتأ؏أهًڲًڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأتځىۏأتوحأڬًأڬۏضەأځۄډتىۏڽأڲەأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأتىۄۏڽأځۄډتىأهًڽأڲتأ؏أدثأًۄأإةۏڽأڲەأحًأتىأڬەأىتوۄأتؼوتهأتْىأڬەأزتةۏڽأۄتحہأوۏڽأۄًڽأڲەأتًشأضدزًڽأڬەأىطتىتحأڬۏأًدۄأضەأتىأڬەأډۄشەأوۏڽأوًدًزأورظًظأىطتىۏأڬۏأًدۄأضەأوۏڽأتىۄۏڽأځۄډتىأهًڽأڲتأتًشأوۏڽأتىأڬەأىًشأڬۏأًدۄأضەأتىۄۏڽأځۄډتىأهًڽأڲتأدًأتىأڬەأإڲەأډهأشۄتأۄًأڲتأۗ‛‛"
"18362","أتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=““أدًأ+أىًشأ,أتْىأڬەأإڲەأتًشأتىأڬەأزتةۏڽأغشلأډهأشۄتأۄًأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأتثىأهۄۏؼۄأڬتأوؼتوهۄأورحهلأۄەأ؏أًۄأعؼۏلأۄەأ؏أًۏضەأتضأڬۏأحًخۏمأڬۏأڲةۏأۄەأۗ"
"18363","حضرت ابودرداؤ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷺ نے ارشاد فرمایا ہے : """" قیامت کے دن میں وہ پہلا فرد ہواں گا ، جس کو سجدہ کرنے کی اجازت دی جائے گی اور میں وہ پہلا فرد ہواں گا ، جسے یہ اجازت دی جائے گی کہ وہ اپنے سر کو اٹھائے ، میں اپنے سامنے دیکھوں گا تو دیگر امتوں کے درمیان اپنی امت کو پہچان لوں گا ، اپنے پیچھے بھی اسی طرح ( پہچان لوں گا ) اپنے دائیں طرف بھی اسی طرح ( پہچان لوں گا ) اور بائیں طرف بھی اسی طرح ( پہچان لوں گا ) ۔"""" ایک صاحب نے عرض کی : یا رسول اللہ ! حضرت نوح علیہ السلام کی امت سے لے کر اپنی امت تک کی امتوں کے درمیان میں سے آپ اپنی امت کو کیسے پہچانیں گے ء نبی اکرم ﷺ نے ارشاد فرمایا : وہ لوگ وضو کے اثرات کی وجہ سے چمکدار پیشانیوں والے ہوں گے ، ان کے علاوہ کوئی اور ایسا نہیں ہو گا اور میں انہیں یوں پہچان لوں گا کہ جب وہ آئیں گے تو ان کے نامہ اعمال ان کے دائیں ہاتھ میں ہوں گے اور میں انہیں یوں پہچان لوں گا کہ اْن کے بچے ان کے آگے دوڑتے ہوئے آ رہے ہوں گے ۔"""" یہ روایت امام احمد نے نقل کی ہے اور امام بزار نے اختصار کے ساتھ ان صحابی کے حوالے سے نقل کی ہے تاہم انہوں نے یہ الفاظ نقل کئے ہیں :† اور ان کے بچے اْن کے آگے نور کی شکل میں ہوں گے ۔"""" امام احمد کے رجال صحیح کے رجال ہیں ، صرف ابن لہیعہ کا معاملہ مختلف ہے اور وہ ضعیف ہے ، ویسے اس کی توثیق کی گئی ہے ۔"
"18364","أذعشحأدتثشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أحوأهًڲأډوڬزتشأځۏطتىۏًڽأًتهەأۄًأۗ‛‛أ أۏۄأشًتۏحأتوتوأتثًۏؼهۏٳأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18365","أؼڬشوۄأثۏتىأڬشحەأۄۏڽأ=أتههۄأحؼتهۏٳأڬەأزًىًڽأۄتحہأزتةۏڽأۄۏڽأ؏أًۄأإضوتىًڽأڬًأهځۏټأڬشأتځىەأتۏڬأۄتحہأوۏڽأځڬڔەأڲتأتًشأځہشأۏۄألشوتةەأڲتأ=أوۏڽأثتزطتۄأۄًڽأ؏أرًزأڬًأصثشزضحأضودہىەأًتهەأهًڲأڬۄتڽأۄۏڽأآأحڬثشأڬشىەأًتهەأهًڲأڬۄتڽأۄۏڽأآأ أًۄأڬۄحەأۄۏڽأ=أځہشأًۄأحوتوأصوۏىًڽأڬًأتځىەأزًضشەأۄتحہأوۏڽأځڬڔەأڲتأتًشأۏۄألشوتةەأڲتأ=أوۏڽأثتزطتۄأۄًڽأ؏أرًزأڬًأصثشزضحأضودہىەأًتهەأهًڲأڬۄتڽأۄۏڽأآأحڬثشأڬشىەأًتهەأهًڲأڬۄتڽأۄۏڽأآأ أؼوشأثىأذوصۄأڬۄحەأۄۏڽأ=أوۏڽأىەأۏۄأشًتۏحأضتهوأثىأؼثزتههۄأڬًأضىتةۏأحًأضتهوأىەأثحتۏتأ=أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأىەأۄوۏڽأۏۄأثتحأثۏتىأڬۏأۄەأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأتههۄأحؼتهۏٳأإضوتىًڽأڬًأهځۏټەأڲتأتًشأتىۄۏڽأزتةۏڽأۄتحہأوۏڽأهەأڲتأتًشألشوتةەأڲتأ=أوۏڽأثتزطتۄأۄًڽأ؏أرًزأڬًأصثشزضحأضودہىەأًتهەأهًڲأڬۄتڽأۄۏڽأآأحڬثشأڬشىەأًتهەأهًڲأڬۄتڽأۄۏڽأآأځہشأًۄأحوتوأصوۏىًڽأڬًأهځۏټأڬشأتىۄۏڽأثتةۏڽأۄتحہأڬەأسشۏؼەأځڬڔأڬشأځہشأۏۄألشوتةەأڲتأ=أوۏڽأثتزطتۄأۄًڽأ؏أرًزأڬًأصثشزضحأضودہىەأًتهەأهًڲأڬۄتڽأۄۏڽأآأحڬثشأڬشىەأًتهەأهًڲأڬۄتڽأۄۏڽأآ‛‛ۗ"
"18366","أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬەأذًتهەأضەأتههۄأحؼتهۏٳأڬەأتضألشوتىأڬەأثتشەأوۏڽأىمهأڬشحەأۄۏڽأ=أ+أتشطتزأثتشۏأحؼتهۏٳأۄەأ=أ,أ أ““أدضأزىأصوۏىأڬًأزًضشۏأصوۏىأوۏڽأحثزۏهأڬشأزۏتأدتةەأڲتأۗ‛‛أ ىثۏأتڬشوأ﷽أىەأۏۄألشوتۏتأۄەأ=†أًۄأتۏڬأضلۏزأصوۏىأۄًأڲۏأ؏أدضأځشأرًىأىۄۏڽأثۄتۏتأڲۏتأۄًأڲتأتًشأدضأځشأڬضۏأڲىتۄأڬتأتشحڬتثأىۄۏڽأڬۏتأڲۏتأۄًأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأ؏أتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأدشۏشأثىأتۏًثأۄەأتًشأتضأڬەأعؼۏلأۄًىەأځشأتحلتمأۄەأۗ"
"18367","أذضىأثۏتىأڬشحەأۄۏڽأ=أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىەأۄوۏڽأذزۏخأثۏتىأڬۏأ=أدثأًۄأتًشأۄوأوزۏىۄأوىًشۄأوۏڽأوًدًزأحہەأتىۄًڽأىەأثحتۏتأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأۄەأ=أ أ““أمۏتوحأڬەأزىأتؼوتهأإةۏڽأڲەأ؏أىوتصأإةەأڲۏأتًشأؼشعأڬشەأڲۏأ=أتەأوۏشەأځشًشزڲتشأ$أوۏڽأىوتصأۄًڽأ؏أحًأځشًشزڲتشألشوتةەأڲتأ=أحوأثہهتةۏأځشأۄًأ؏أظزمۄأإةەأڲتأتًشأؼشعأڬشەأڲتأ=أتەأوۏشەأځشًشزڲتشأ$أوۏڽأظزمۄأۄًڽأ؏أحًأځشًشزڲتشألشوتةەأڲتأ=أحوأثہهتةۏأځشأۄًأ؏أځہشأشًصۄأإةەأڲتأتًشأؼشعأڬشەأڲتأ=أتەأوۏشەأځشًشزڲتشأ$أوۏڽأشًصۄأۄًڽأ؏أځشًشزڲتشألشوتةەأڲتأ=أحوأثہهتةۏأځشأۄًأ؏أتضۏأغشذأورحهلأتؼوتهأإحەأشۄۏڽأڲەأتًشأتههۄأحؼتهۏٳألشوتحتأشۄەأڲتأ=أحوأثہهتةۏأځشأۄًأ؏أځہشأتضهتوأإةەأڲتأتًشأؼشعأڬشەأڲتأ=أتەأځشًشزڲتشأ$أحًأضهتوحۏأؼغتأڬشىەأًتهتأۄەأتًشأوۏڽأتضهتوأۄًڽأ؏أتههۄأحؼتهۏٳألشوتةەأڲتأ=أثەأطڬأحوأثہهتةۏأځشأۄًأتًشأحوۄتشۏأًدۄأضەأإدأوۏڽأڲشلحأڬشًڽأڲتأتًشأحوۄتشۏأًدۄأضەأإدأوۏڽأؼغتأڬشًڽأڲتأۗ‛‛أ أتههۄأحؼتهۏٳأىەأتځىۏأڬحتثأوۏڽأۏۄأتشطتزألشوتۏتأۄەأ= أدًأطرظأتضهتوأڬەأؼهتًۄأڬًةۏأتًشأزۏىأحهتطأڬشەأڲتأحًأًۄأتضأڬۏأغشلأضەأمثًهأىۄۏڽأڬۏتأدتةەأڲتأتًشأًۄأطرظأإرشحأوۏڽأرضتشۄأځتىەأًتهًڽأوۏڽأضەأۄًأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأتذوزأتًشأتوتوأتثًۏؼهۏٳأىەأىمهأڬۏأۄەأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتًشأتىہًڽأىەأۏۄأتهلتػأصتةزأىمهأڬۏەأۄۏڽأ=أتههۄأحؼتهۏٳألشوتحتأۄەأ=أ أ““أثۏطڬأتههۄأحؼتهۏٳأڬەأىصزۏڬأزۏىأ؏أتضهتوأۄەأۗ‛‛ +أتۏڬأتًشأومتوأځشأتههۄأحؼتهۏٳأىەأۏۄأتشطتزألشوتۏتأۄەأ=أ أ““أتًشأدًأطرظأتضهتوأڬەأؼهتًۄأڬًةۏأتًشأزۏىأحهتطأڬشەأڲتأحًأًۄأتضأڬۏأغشلأضەأمثًهأىۄۏڽأۄًأڲتأتًشأًۄأطرظأإرشحأوۏڽأرضتشۄأځتىەأًتهًڽأوۏڽأضەأۄًأڲتأۗ‛‛ أتضأشًتۏحأڬۏأضىزأوۏڽأتۏڬأشتًۏأؼثتزأثىأشتطزأۄەأدضەأتثًذتحوأتًشأزۏڲشأذعشتحأىەأخمۄأمشتشأزۏتأۄەأتًشأتۏڬأدوتؼحأىەأتضەأعؼۏلأڬۄتأۄەأ؏أتوتوأتذوزأڬەأثمۏۄأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18368","أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أوۏڽأىەأهًڲًڽأڬًأزۏڬہتأڬۄأتىۄۏڽأذضتثأڬەأهۏەأدوؼأڬۏتأڲۏتأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأتثًۏؼهۏٳأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18369","أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأ=أودہەأتۏڬأظتذثأڬەأثتشەأوۏڽأځحۄأډهتأڬۄأتىۄًڽأىەأىثۏأتڬشوأ﷽أضەأتۏڬأذزۏخأضىۏأۄًةۏأۄەأحًأوۏڽأىەأتۏڬأتًىټأرشۏزتأ؏أتْضأځشأځتهتىأثتىزہتأتًشأځہشأتۏڬأوتۄأڬۏأوضتلحأڬتألتظهۄأغەأڬشأڬەأتىأظتذثأڬەأځتضأځۄىډتأ؏أۏۄتڽأحڬأڬۄأطتوأوۏڽأ؏أوۏڽأتىأڬەأځتضأإأڲۏتأ؏أًۄأذعشحأؼثزتههۄأثىأتىۏضأشعۏأتههۄأؼىۄأحہەأ؏أوۏڽأىەأزشثتىأضەأڬۄتأ=أحوأتْىأضەأڬۄًأڬۄأزشًتصەأځشأدتثشأوًدًزأۄەأ؏أزشثتىأىەأزشۏتلحأڬۏتأ=أًۄأدًأذعشحأؼثزتههۄأشعۏأتههۄأؼىۄأڬەأظتذثصتزەأۄۏڽأآأوۏڽأىەأدًتثأزۏتأ=أدۏأۄتڽأ$أحًأذعشحأؼثزتههۄأثىأتىۏضأشعۏأتههۄأؼىۄأتځىەأڬځڔەأڬًأڲہضۏټحەأۄًةەأثتۄشأإةەأتًشأتىۄًڽأىەأودہەأڲهەأهڲتأهۏتأتًشأوۏڽأىەأتىۄۏڽأڲهەأهڲتأهۏتأ؏أوۏڽأىەأڬۄتأ=أودہەأتۏڬأذزۏخأڬەأثتشەأوۏڽأۏۄأځحۄأډهتأحہتأڬۄأإځأىەأتضەأىثۏأتڬشوأ﷽أڬۏأصثتىۏأضىتأۄًتأۄەأتًشأًۄأمظتظأڬەأثتشەأوۏڽأۄەأ؏أحًأودہەأۏۄأتىزۏطۄأۄًتأڬۄأڬۄۏڽأوۏشەأتضأذزۏخأڬًأضىىەأضەأځۄهەأإځأڬتأتىحمتهأىۄأۄًأدتةەأ؏أۏتأوۏشتأتىحمتهأىۄأۄًأدتةەأ؏أحًأذعشحأؼثزتههۄأثىأتىۏضأشعۏأتههۄأؼىۄأىەأثحتۏتأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ="
"18370","ابن عباس رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""قیامت کے دن باندے کے قدم نہ ہٹیں گے جب تک اس سے چار چیزوں کے بارے میں پوچھا نہ جائے: اس کی عمر کے بارے میں کہ اسے کہاں گزارا، اس کے جسم کے بارے میں کہ اسے کہاں گھسایا، اس کے مال کے بارے میں کہ اسے کہاں خرچ کیا، اور کہاں سے کمایا، اور ہمارے پیار کے بارے میں اہل بیت۔"" اسے طبرانی نے کبیر اور اوسط میں روایا ہے، اس میں حسین بن حسن اشقر ہے، اور وہ بہت ضعیف ہے، اور ابن حبان نے اسے ثقت قرار دیا ہے باوجود اس کے کہ وہ سلف کو گالیاں دیتا تھا۔"
"18371","حضرت ابوبرزہ رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷺ نے ارشاد فرمایا : """" ( قیامت کے دن ) بندے کے قدم اپنی جگہ سے اْس وقت تک نہیں ہلیں گے جب تک اس سے چار چیزوں کے بارے میں حساب نہیں لیا جاتا ، اْس کے جسم کے بارے میں کہ اس نے کس کام میں اسے بوسیدہ کیا ء اس کی عمر کے بارے میں کہ اس نے کس کام میں اسے فنا کیا ء اس کے مال کے بارے میں کہ اس نے کیسے اسے کمایا اور کہاں خرچ کیا ء اور ہم اہل بیت کے ساتھ محبت کے بارے میں ( اس سے حساب لیا جائے گا ) عرض کی گئی : یا رسول اللہ ! آپ لوگوں کے ساتھ محبت کی علامت کیا ہے ء تو نبی اکرم ﷺ نے اپنا دست مبارک حضرت علی رضی اللہ عنہ کے کندھے پر لگایا ۔"""" یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے یہ امام ترمذی نے بھی نقل کی ہے تاہم انہوں نے یہ الفاظ اور اس کے بعد والا حصہ نقل نہیں کئے ہیں :† ہم اہل بیت کے ساتھ محبت کے بارے میں ۔"""" انہوں نے چوتھی چیز نقل کی ہے :"""" اْس سے علم کے بارے میں حساب لیا جائے گا کہ اس نے اس پر کتنا عمل کیا ۔"""" طبرانی کی سند میں ایک راوی حارث بن محمد کوفی ہے جسے معکوف کہا جاتا ہے † میزان ‟ کے مصنف نے یہ کہا ہے : یہ جھوٹی روایت نقل کرتا ہے اس روایت کے باقی رجال ثقہ ہیں ۔"
"18372","أذعشحأتثًزشزتؤأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأإزوۏأڬەأمزوأتځىۏأدڲۄأضەأتضأًمحأحڬأىۄۏڽأۄهۏڽأڲەأدثأحڬأتضأضەأډتشأډۏصًڽأڬەأثتشەأوۏڽأذضتثأىۄۏڽأهەأهۏتأدتحتأ؏أتْضأڬۏأدًتىۏأڬەأثتشەأوۏڽأڬۄأتضأىەأڬضأڬتوأوۏڽأتضەأثًضۏزۄأڬۏتأآأتضأڬۏأؼوشأڬەأثتشەأوۏڽأڬۄأتضأىەأڬضأڬتوأوۏڽأتضەألىتأڬۏتأآأتضأڬەأوتهأڬەأثتشەأوۏڽأڬۄأتضأىەأڬۄتڽأضەأڬوتۏتأتًشأڬضأڬتوأوۏڽأرشډأڬۏتأآ‛‛ۗ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأڬثۏشأتًشأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأتثًثڬشأزتۄشۏأۄەأتًشأًۄأتىحۄتةۏأعؼۏلأۄەأۗ"
"18373","أذعشحأوؼتسأثىأدثهأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأثىزەأڬەأمزوأتځىۏأدڲۄأضەأتْضأًمحأحڬأىۄۏڽأۄهۏڽأڲەأدثأحڬأتضأضەأډتشأډۏصًڽأڬەأثتشەأوۏڽأذضتثأىۄۏڽأهەأهۏتأدتحتأ؏أتضأڬۏأؼوشأڬەأثتشەأوۏڽأڬۄأتضأىەأڬضأڬتوأوۏڽأتضەألىتأڬۏتأ؏أتضأڬۏأدًتىۏأڬەأثتشەأوۏڽأڬۄأتضأىەأڬضأڬتوأوۏڽأتضەأثًضۏزۄأڬۏتأ؏أتضأڬەأوتهأڬەأثتشەأوۏڽأڬۄأتضأىەأڬۄتڽأضەأتضأڬًأڬوتۏتأتًشأڬۄتڽأرشډأڬۏتأتًشأتضأڬەأؼهوأڬەأثتشەأوۏڽأڬۄأتضأىەأڬۄتڽأحڬأتضأځشأؼوهأڬۏتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأتوتوأثصتشأىەأتضأڬۏأوتىىزأىمهأڬۏأۄەأ؏أتوتوأغثشتىۏأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأظتوحأثىأوؼتسأتًشأؼزۏأثىأؼزۏأڬىزۏأڬتأوؼتوهۄأورحهلأۄەأتًشأۏۄأزًىًڽأخمۄأۄۏڽأۗ"
"18374","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ= أ““أدثأمۏتوحأڬتأزىأۄًأڲتأحًأتههۄأحؼتهۏٳأتۏڬأثىزەأڬًأثهتةەأڲتأتضەأتځىەأضتوىەأڬہڔتأڬشەأڲتأتًشأتضأضەأتضأڬەأدتۄأًأوىظثأڬەأثتشەأوۏڽأذضتثأهەأڲتأ؏أدضأغشذأًۄأتضأضەأتضأڬەأوتهأڬەأثتشەأوۏڽأذضتثأهەأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأظؽۏشأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأۏًضلأثىأۏًىضأۄەأدًأتثًوضهوأتلغضأڬتأثہتةۏأۄەأتًشأًۄأتىحۄتةۏأعؼۏلأۄەأۗ"
"18375","أذعشحأثشۏزۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أحوأوۏڽأضەأۄشأتۏڬأڬەأضتحہأؼىمشۏثأتههۄأحؼتهۏٳأۏًڽأڬهتوأڬشەأڲتأڬۄأتههۄأحؼتهۏٳأتًشأتْضأطرظأڬەأزشوۏتىأڬًةۏأذدتثأۏتأڬًةۏأحشدوتىأىۄۏڽأۄًأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأؼثزتهؼصۏصأثىأتثتىأۄەأتًشأًۄأوحشًڬأۄەأۗ"
"18376","أؼثزتههۄأثىأؼڬۏوأثۏتىأڬشحەأۄۏڽأوۏڽأىەأذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأڬًأتضأوضدزأوۏڽأۏۄأثۏتىأڬشحەأۄًةەأضىتأۄەأ=أتىۄًڽأىەأڲلحڲًأضەأځۄهەأمضوأڬەأسشۏؼەأتځىەأڬهتوأڬتأإؽتصأڬۏتأتًشأځہشأۏۄألشوتۏتأ=أ أ““أحوأوۏڽأضەأۄشأتۏڬأڬەأضتحہأتضأڬتأځشًشزڲتشأتىلشتزۏأغًشأځشأۏًڽأڬهتوأڬشەأڲتأدضأغشذأډًزہًۏڽأشتحأوۏڽأ؏أحوأوۏڽأضەأڬضۏأتۏڬأڬەأضتوىەأډًزہًۏڽأڬتأډتىزأتڬۏهتأۄًحتأۄەأ؏أځشًشزڲتشألشوتةەأڲتأ=أتەأتثىأإزوأ$أوۏشۏأستحأڬەأثتشەأوۏڽأڬضأډۏصأىەأحوۄۏڽأؽهغألۄوۏأڬتأطڬتشأڬۏتأآأتەأتثىأإزوأ$أوۏشۏأستحأڬەأثتشەأوۏڽأڬضأډۏصأىەأحوۄۏڽأؽهغألۄوۏ ڬتأطڬتشأڬۏتأآأتەأتثىأإزوأ$أحوأىەأوشضهۏىأڬۏأزؼًحأڬتأڬۏتأدًتثأزۏتأآأتەأتثىأإزوأ$أحوأىەأوشضهۏىأڬۏأزؼًحأڬتأڬۏتأدًتثأزۏتأآأتەأتثىأإزوأ$أحوأىەأڬۏتأؼوهأڬۏتأآأتەأتثىأإزوأ$أحوأىەأڬۏتأؼوهأڬۏتأآأتەأتثىأإزوأ$أحوۄۏڽأدًأؼهوأحہتأتضأڬەأذًتهەأضەأحوأىەأڬۏتأؼوهأڬۏتأآأتەأتثىأإزوأ$أحوۄۏڽأدًأؼهوأحہتأتضأڬەأذًتهەأضەأحوأىەأڬۏتأؼوهأڬۏتأآ‟ۗ"
"18377","أذعشحأخًثتىأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأضًتهأ+أۏؼىۏأذضتثأ,أڬەأوضةهەأڬۏأؼػوحأڬتأتػۄتشأڬشحەأۄًةەأۏۄألشوتۏتأ=أ"
"18378","أذضىأثۏتىأڬشحەأۄۏڽأ=أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىەأۄوۏڽأ؏أىثۏأتڬشوأ﷽أڬەأوىثشأځشأرغثۄأزۏحەأۄًةەأۏۄأتشطتزألشوتۏتأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄألشوتحەأۄًةەأضىتأۄەأ=أ أ““أمۏتوحأڬەأزىأتههۄأحؼتهۏٳأذعشحأإزوأؼهۏۄأتهضهتوأڬەأضتوىەأحۏىأتوًشأڬەأذًتهەأضەأًدۄأثۏتىأڬشەأڲتأ؏أتههۄأحؼتهۏٳألشوتةەأڲتأ=أتەأإزوأ$أتڲشأتۏضتأىۄأۄًحتأڬۄأوۏڽأىەأدہًټأثًهىەأًتهًڽأځشأهؼىحأڬۏأۄەأتًشأوۏڽأدہًټأتًشأًؼزۄأرهتلۏأڬًأىتځضىزأڬشحتأۄًڽأتًشأوۏڽأىەأتضأذًتهەأضەأًؼۏزأثۏتىأڬۏأۄەأحًأإدأڬەأزىأوۏڽأىەأحوۄتشۏأضتشۏأتًهتزأځشأشذوأڬشأزۏىتأحہتأ؏أتضأؼستثأڬۏأطزحأڬۏأًدۄأضەأدًأوۏڽأىەأتْىأڬەأهةەأحۏتشأڬۏتأۄەأ؏أهۏڬىأوۏشۏأغشلأضەأۏۄأثتحأذمأۄەأڬۄأتڲشأوۏشەأشضًهًڽأڬۏأحڬسۏثأڬۏأڲةۏأتًشأوۏشەأذڬوأڬۏأىتلشوتىۏأڬۏأڲةۏأحًأوۏڽأدۄىوأڬًأدىتحأتًشأتىضتىًڽأزًىًڽأضەأثہشأزًڽأڲتأۗ أتههۄأحؼتهۏٳألشوتةەأڲتأ=أتەأإزوأ$أحوأۏۄأثتحأدتىأهًأ$أڬۄأوۏڽأحوۄتشۏأتًهتزأوۏڽأضەأدۄىوأوۏڽأڬضۏألشزأڬًأزترهأىۄۏڽأڬشًڽأڲتأتًشأتىأوۏڽأضەأڬضۏألشزأڬًأإڲأڬتأؼستثأىۄۏڽأزًڽأڲتأ؏أتهثحۄأتضأطرظأڬتأوؼتوهۄأورحهلأۄەأدضأڬەأثتشەأوۏڽأودہەأۏۄأؼهوأۄًأڬۄأتڲشأوۏڽأىەأتضەأزىۏتأڬۏأغشلأهًټتأزۏتأحًأًۄأځۄهەأضەأصۏتزۄأثزحشأؼوهأڬشەأڲتأ؏أًۄأشدًؼأىۄۏڽأڬشەأڲتأتًشأټہۏڬأىۄۏڽأۄًأڲتأۗأ أتههۄأحؼتهۏٳألشوتةەأڲتأ=أتەأإزوأ$أوۏڽأحوۄۏڽأتځىەأتًشأحوۄتشۏأسشۏحأڬەأزشوۏتىأختهخأومششأڬشحتأۄًڽأ؏أحوأوۏصتىأڬەأځتضأڬہڔەأۄًأدتاأتًشأتضأثتحأڬتأدتةصۄأهًأڬۄأتىأڬەأتؼوتهأوۏڽأضەأڬۏتأحوۄتشەأضتوىەأځۏطأڬۏتأدتحتأۄەأآأدضأطرظأڬۏأثہهتةۏأتضأڬەأطشأضەأسشەأڬەأًصىأدحىۏأصۏتزۄأۄًةۏأحًأتضەأدىحأوهأدتةەأڲۏأحتڬۄأحوۄۏڽأۏۄأثتحأځحۄأډهأدتةەأڬۄأوۏڽأتْىأوۏڽأضەأدۄىوأوۏڽأظشلأػتهوًڽأڬًأزترهأڬشًڽأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏألعهأثىأؼۏضۏٳأشمتطۏأۄەأتًشأًۄأڬستثأۄەأۗ"
"18379","أذعشحأتىضأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ= أ““أػهوأحۏىأمضوأڬتأۄًحتأۄەأ؏أتۏڬأػهوأًۄأۄەأدضأڬۏأتههۄأحؼتهۏٳأوؽلشحأىۄۏڽأڬشەأڲتأتۏڬأػهوأًۄأۄەأدضأڬۏأًۄأوؽلشحأڬشأزەأڲتأتًشأتۏڬأػهوأًۄأۄەأدضەأتههۄأحؼتهۏٳأډہًڔەأڲتأىۄۏڽأ؏أدۄتڽأحڬأتضأػهوأڬتأحؼهمأۄەأ؏أدضأڬۏأتههۄأحؼتهۏٳأوؽلشحأىۄۏڽأڬشەأڲتأحًأًۄأطشڬأۄەأ؏أتههۄأحؼتهۏٳأىەأتشطتزألشوتۏتأۄەأ= أ““أثەأطڬأطشڬأثڔتأػهوأۄەأۗ‛‛أ أدۄتڽأحڬأتضأػهوأڬتأحؼهمأۄەأدضأڬۏأتههۄأحؼتهۏٳأوؽلشحأڬشأزەأڲتأحًأۏۄأثىزًڽأڬتأًۄأػهوأۄەأدًأتىۄًڽأىەأتځىەأتًځشأڬۏتأۄًأڲتأدًأتىأڬەأتًشأتىأڬەأځشًشزڲتشأڬەأوتثۏىأوؼتوهتحأڬەأذًتهەأضەأۄًأڲتأۗ"
"18380","أذعشحأضهوتىألتشضۏأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ"
"18381","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أتۏڬأڲىتۄأًۄأۄەأدضأڬۏأوؽلشحأۄًأدتةەأڲۏأ؏أتۏڬأڲىتۄأًۄأۄەأدضأڬۏأوؽلشحأىۄۏڽأۄًأڲۏأ؏أتۏڬأڲىتۄأًۄأۄەأدضأڬتأثزهۄأزهًتۏتأدتةەأڲتأ؏أدۄتڽأحڬأتضأڲىتۄأڬتأحؼهمأۄەأدضأڬۏأوؽلشحأىۄۏڽأۄًأڲۏأ؏أحًأًۄأڬضۏأڬًأتههۄأڬتأطشۏڬأټہۄشتىتأۄەأ؏أدۄتڽأحڬأتضأڲىتۄأڬتأحؼهمأۄەأدضأڬۏأوؽلشحأۄًأدتةەأڲۏأحًأًۄأحوۄتشتأًۄأؼوهأۄەأدضأڬتأحؼهمأحوۄتشەأتًشأحوۄتشەأځشًشزڲتشأڬەأوتثۏىأوؼتوهەأضەأۄًأ؏أدۄتڽأحڬأتضأڲىتۄأڬتأحؼهمأۄەأ؏أدضأڬتأثزهۄأزهًتۏتأدتةەأڲتأحًأًۄأحوۄتشتأتځىەأثہتةۏأځشأػهوأڬشىتأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأغهذۄأثىأؼوشًأۄەأتًشأًۄأوحشًڬأۄەأۗ"
"18382","سیدہ عائشہ صدیقہ رضی اللہ عنہا بیان کرتی ہیں : نبی اکرم ﷺ نے ارشاد فرمایا : """" دواوین ( یعنی اعمال نامے ) اللہ تعالیٰ کے پاس تین قسم کے ہوں گے ، ایک دیوان وہ ہو گا جس کے حوالے سے اللہ تعالیٰ کوئی پرواہ نہیں کرے گا ، ایک دیوان وہ ہو گا جس میں سے اللہ تعالیٰ کوئی چیز نہیں چھوڑے گا اور ایک دیوان وہ ہو گا جس کی اللہ تعالیٰ مغفرت نہیں کرے گا ۔ جہاں تک اس دیوان کا تعلق ہے جس کی اللہ تعالیٰ مغفرت نہیں کرے گا تو وہ ( کسی کو ) اللہ تعالیٰ کے ساتھ شریک ٹھہرانا ہے ، اللہ تعالیٰ نے ارشاد فرمایا ہے : """" جو شخص اللہ تعالیٰ کے ساتھ شرک کرے گا تو اللہ تعالیٰ اس پر جنت حرام کر دے گا ۔"""" جہاں تک اس دیوان کا تعلق ہے جس کے بارے میں اللہ تعالیٰ کوئی پرواہ نہیں کرے گا ، تو وہ بندے کا اپنے اوپر وہ ظلم کرنا ہے جو اس کے اور اس کے پروردگار کے درمیان معاملات کے حوالے سے ہو ، جیسے اس نے کسی دن کا روزہ ترک کر دیا ہو یا نماز ترک کر دی ہو تو اللہ تعالیٰ اس کی مغفرت کر دے گا اور درگزر کرے گا ، اگر وہ چاہے گا ۔ جہاں تک اس دیوان کا تعلق ہے ، جس میں سے اللہ تعالیٰ کوئی بھی چیز نہیں چھوڑے گا تو وہ بندوں کا ایک دوسرے پر ظلم کرنا ہے اس کا لازمی طور پر قصاص ( یعنی بدلہ ) ہو گا ۔"""" یہ روایت امام احمد نے نقل کی ہے اس کی سند میں ایک راوی صدقہ بن موسیٰ ہے ، جسے جمہور نے ضعیف قرار دیا ہے ، مسلم بن ابراہیم کہتے ہیں : صدقہ بن موسیٰ نے ہمیں حدیث بیان کی اور وہ صدوق تھے ، اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"18383","أذعشحأذسۏلۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أووهًڬًڽأڬەأذًتهەأضەأوتهڬتىأڬەأهۏەأثشثتزۏأۄەأتًشأوتهڬتىأڬەأذًتهەأضەأووهًڬًڽأڬەأهةەأثشثتزۏأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏضەأشتًۏأۄۏڽأ؏أدىأضەأوۏڽأًتملأىۄۏڽأۄًڽأۗ"
"18384","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أووهًڬأڬەأذًتهەأضەأوتهڬأڬەأهةەأثشثتزۏأۄەأتًشأوتهڬأڬەأذًتهەأضەأووهًڬأڬەأهةەأثشثتزۏأۄەأ؏أؽشۏثأڬەأذًتهەأضەأتوۏشأڬەأهةەأثشثتزۏأۄەأتًشأتوۏشأڬەأذًتهەأضەأؽشۏثأڬەأهةەأثشثتزۏأۄەأ؏أڬوصًشأڬەأذًتهەأضەأغتمحًشأڬەأهةەأثشثتزۏأۄەأتًشأغتمحًشأڬەأذًتهەأضەأڬوصًشأڬەأهةەأثشثتزۏأۄەأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأىەأتځىەأتضحتزأوذوزأثىأهۏخأڬەأذًتهەأضەأىمهأڬۏأۄەأتوتوأتثىأذثتىأىەأتضأشتًۏأڬتأحسڬشۄأڬحتثأتهخمتحأوۏڽأڬۏتأۄەأتًشأۏۄأڬۄتأۄەأ=أۏۄأؽهغۏأڬشأدتحتأۄەأتًشأزًضشًڽأڬەأثشرهتلأىمهأڬشحتأۄەأۗ"
"18385","ابو ہریرہ رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""قیامت کے دن ہر چیز لڑے گی، یہاں تک کہ دو بکریاں بھی جو ایک دوسری سے سیگ لڑائی تھیں۔"" اسے احمد نے روایا ہے، اور اس کا سند حسن ہے۔"
"18386","ابو سعید خدری رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""اس ذات کی قسم جس کے ہاتھ میں میری جان ہے، قیامت کے دن ضرور لڑائی ہوگی، یہاں تک کہ دو بکریاں بھی جو ایک دوسری سے سیگ لڑائی تھیں۔"" اسے ابو یعلی نے روایا ہے، اور احمد نے اس طرح روایا ہے، اور اس کا سند حسن ہے۔"
"18387","أذعشحأؼمثۄأثىأؼتوشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأتۏڬأزًضشەأڬەأځۄهەأومتثهألشۏمأ؏أزًأځڔًضۏأۄًڽأڲەأۗ‛‛أ أۏۄأشًتۏحأتوتوأتذوزأىەأذضىأضىزأڬەأضتحہأىمهأڬۏأۄەأۗ"
"18388","حضرت ابوایوب انصاری رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" قیامت کے دن مقدمہ پیش کرنے والے پہلے افراد ، آدمی اور اس کی بیوی ہوں گے ، اللہ کی قسم ! عورت کی زبان کلام نہیں کرے گی بلکہ اس کے ہاتھ اور اس کے پااں کلام کریں گے اور عورت کے خلاف گواہی دیں گے کہ وہ شوہر کی غیر موجودگی میں کیا کرتی تھی ء اور آدمی کے دونوں ہاتھ اور اس کے دونوں پااں گواہی دیں گے جس کا وہ ارتکاب کرتا تھا ، پھر آدمی کو اور اس کے خدمت گاروں کو بلایا جائے گا ، ان کے ساتھ بھی اسی طرح ہو گا ، پھر بازار والوں کو بلایا جائے گا اور وہاں جو سکے اور قیراط ہوتے تھے ( انہیں بھی بلایا جائے گا ) اس ( یعنی ظالم ) کی نیکیاں اْس کو دے دی جائیں گی جو مظلوم ہو گا اور مظلوم کی برائیاں اس ظالم کے ذمے ڈال دی جائیں گی ، پھر ظالموں ( یا متکبرین ) کو لوہے کے بنے ہوئے طوقوں میں لایا جائے گا اور یہ کہا جائے گا : انہیں جہنم پر وارد کرو ! تو اللہ کی قسم ! مجھے نہیں معلوم کہ وہ اس میں داخل ہوں گے یا ویسا ہو گا ، جس طرح اللہ تعالیٰ نے ارشاد فرمایا ہے : """" تم میں سے ہر ایک اس ( جہنم ) پر وارد ہو گا ، یہ تمہارے پروردگار کے ذمہ حتمی و طے شدہ بات ہے ، پھر ہم پرہیزگاری اختیار کرنے والوں کو نجات دیدیں گے اور ظالموں کو اس ( جہنم میں ) گھٹنوں کے بل ( جھکا ہوا ) چھوڑ دیں گے ۔"""" یہ روایت امام طبرانی نے نقل کی ہے اس کی سند میں ایک راوی عبداللہ بن عبدالعزیز لیثی ہے اور وہ ضعیف ہے ، سعید بن منصور نے اسے ثقہ قرار دیا ہے وہ کہتے ہیں : امام مالک اس سے راضی تھے ، اس روایت کے بقیہ رجال صحیح کے رجال ہیں ۔"
"18389","حضرت واثلہ بن اسقع رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" قیامت کے دن اللہ تعالیٰ ایک ایسے بندے کو زندہ کرے گا ، جس کا کوئی گناہ نہیں ہو گا اللہ تعالیٰ فرمائے گا : دو میں سے کون سا معاملہ تمہارے نزدیک زیادہ پسندیدہ ہے ء یہ کہ میں تمہیں تمہارے عمل کی جزا دے دوں ء یا جو نعمتیں میں نے تمہیں عطا کی تھیں ( اْن کا حساب لے لوں ء ) بندہ کہے گا : اے میرے پروردگار ! تو یہ بات جانتا ہے کہ میں نے تیری کوئی نافرمانی نہیں کی ، پروردگار فرمائے گا : میری نعمتوں میں سے ایک نعمت کے حساب کے حوالے سے میرے بندے کو پکڑ لو ( یا اس کا حساب لو ) تو وہ ایک نعمت ہی اس کی ساری نیکیوں کو ختم کر دے گی ، بندہ کہے گا : اے میرے پروردگار ! تیری نعمت اور تیری رحمت ( کا میں محتاج اور طلبگار ہوں ) تو پروردگار فرمائے گا : میری نعمت اور میری رحمت ( کی بدولت میں تمہیں نجات ملے گی ) پھر ایک بندے کو لایا جائے گا جو یہ سمجھتا ہو گا کہ وہ اچھائی کرنے والا ہے ، اس کا کوئی گناہ نہیں ہو گا ، پروردگار اس سے دریافت کرے گا : کیا تم میرے دوستوں کے ساتھ محبت رکھتے تھے ء وہ جواب دے گا : میں لوگوں کے حوالے سے سلامتی میں رہا ( یعنی میں اْن سے لاتعلق رہا ) پروردگار دریافت کرے گا : کیا تم میرے دشمنوں کے ساتھ دشمنی رکھتے تھے ء وہ بندہ جواب دے گا : اے میرے پروردگار ! میرے اور کسی شخص کے درمیان کوئی ( دشمنی نہیں تھی ، تو پروردگار فرمائے گا : میری رحمت ایسے شخص کو نصیب نہیں ہو گی جو میرے دوستوں کے ساتھ محبت نہ رکھتا ہو اور میرے دشمنوں کے ساتھ دشمنی نہ رکھتا ہو ۔"""" یہ روایت امام طبرانی نے نقل کی ہے اس کی سند میں ایک راوی بشر بن عون ہے اور اس پر روایات ایجاد کرنے کا الزام ہے ۔"
"18390","ابن عمر رضی اللہ عنہ سے روایت ہے کہ نبی ﷺ نے فرمایا: ""مالک اور غلام، شوہر اور بیوی کو لایا جائے گا، تو مالک اور غلام کا حساب لیا جائے گا، اور شوہر اور بیوی کا حساب لیا جائے گا، یہاں تک کہ مرد سے کہا جائے گا: آپ نے فلان دن فلان دن لذت کے لیے شراب پی، اور شوہر سے کہا جائے گا: آپ نے فلان خاتون کو دیگر خطیبوں کے ساتھ خطبہ دیا، تو میں نے آپ کو اس سے شادی کرا دی اور انہیں چھوڑ دیا۔"" اسے بزار نے روایت کیا ہے، سعید بن سلمہ اموی کی روایت سے، لیتھ بن ابی سلیم سے، اور ان دونوں کو ضعیف قرار دیا گیا ہے، اگرچہ انہیں معتبر بھی قرار دیا گیا ہے، اور اس کے باقی راوی صحیح کے راوی ہیں۔"
"18391","أذعشحأؼثزتههۄأثىأصثۏشأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أدضأطرظأضەأذضتثأوۏڽأحلحۏطأڬۏأدتةەأڲۏأًۄأۄهتڬأۄًأدتةەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأىەأتوتوأغثشتىۏأىەأوؼدوأڬثۏشأتًشأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتوتوأثصتشأڬەأشدتهأتًشأوؼدوأڬثۏشأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أوؼدوأتًضغأڬەأشدتهأثہۏأتضۏأغشذأۄۏڽأ؏أظشلأؼوشًأثىأتثًؼتظوأىثۏهأڬتأوؼتوهۄأورحهلأۄەأتًشأًۄأخمۄأۄەأۗ"
"18392","أضۏزۄأؼتةطۄأظزۏمۄأشعۏأتههۄأؼىۄتأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحۏأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأڬضۏأضەأذضتثأهەأڬشأتضأڬۏأوؽلشحأىۄۏڽأۄًأڲۏأ؏أوضهوتىأتځىۏأمثشأوۏڽأۄۏأتځىتأؼوهأزۏڬہأهەأڲتأ؏أتههۄأحؼتهۏٳأىەأتشطتزألشوتۏتأۄەأ= أ““أتضأزىأتىضتىأۏتأدىأضەأتضأڬەأڲىتۄأڬەأثتشەأوۏڽأضًتهأىۄۏڽأڬۏتأدتةەأڲتأۗ‛‛ أ““أودشوأهًڲأتځىۏأىطتىۏأڬەأذًتهەأضەأځۄډتىەأدتةۏڽأڲەأۗ‛‛ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأتثىأهۄۏؼۄأۄەأتًشأًۄأعؼۏلأۄەأ؏أًۏضەأتضأڬۏأحًخۏمأڬۏأڲةۏأۄەأ؏أتضأشًتۏحأڬەأثمۏۄأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18393","أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأڬہڔەأۄًىەأڬەأزًشتىأتثىأإزوأڬًأتحىۏأؼتشأتًشأطشوىزڲۏأوذضًضأۄًأڲۏأڬۄأثىزۄأۏۄأإشصًأڬشەأڲتأ=أڬۄأتْضەأدۄىوأوۏڽأهەأدتىەأڬتأذڬوأزەأزۏتأدتةەأۗ‛‛ أۏۄأشًتۏحأتوتوأتثًۏؼهۏٳأىەأىمهأڬۏأۄەأتضأشًتۏحأڬۏأضىزأوۏڽأتۏڬأشتًۏألعهأثىأؼۏضۏٳأشمتطۏأۄەأتًشأتضأڬەأعؼۏلأۄًىەأځشأتحلتمأۄەأۗأ"
"18394","أذعشحأتىضأشعۏأتههۄأؼىۄأوشلًؼأذزۏخأڬەأغًشأځشأۏۄأثتحأىمهأڬشحەأۄۏڽأ+أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأۄەأ=أ,أ أ““أتۏڬألشطحەأڬًأوۏصتىأڬەأځتضأومششأڬۏتأڲۏتأۄەأ؏أتثىأإزوأڬًأهتأڬشأوۏصتىأڬەأزًىًڽأځهڔًڽأڬەأزشوۏتىأڬہڔتأڬشأزۏتأدتةەأڲتأ؏أتڲشأتضأڬتأوۏصتىأثہتشۏأۄًأڲتأحًألشطحۄأتۏضۏأإًتصأوۏڽأځڬتشأڬشأڬۄەأڲتأدًأضتشۏأورهًمأضىأضڬەأڲۏأ؏ألهتڽأطرظأتۏضتأضؼتزحوىزأۄًتأڬۄأًۄأتضأڬەأثؼزأڬثہۏأثزىظۏثأىۄۏڽأۄًأڲتأ؏أتًشأتڲشأتضأڬتأوۏصتىأۄهڬتأۄًتأحًألشطحۄأتحىۏأثهىزأإًتصأوۏڽأځڬتشأڬشأڬۄەأڲتأ؏أدضأڬًأضتشۏأورهًمأضىأضڬەأڲۏأ=ألهتڽأطرظأتۏضتأثزىظۏثأۄًتأڬۄأتثأًۄأتضأڬەأثؼزأڬثہۏأثہۏأضؼتزحأوىزأىۄۏڽأۄًأضڬەأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأظتهذأوشۏأۄەأتًشأتضأڬەأعؼۏلأۄًىەأځشأتحلتمأۄەأۗ"
"18395","انس بن مالک رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""قیامت کے دن مہر لگی ہوئی صحیفے لائے جائیں گے، تو انہیں اللہ تعالیٰ کے سامنے کھڑا کیا جائے گا، تو وہ تعالیٰ فرمائیں گے: ان کو پھینک دو اور ان کو قبول کرو۔ تو فرشتے کہیں گے: آپ کی عزت کی قسم، ہم نے ان میں بھلائی کے سوا کچھ نہیں دیکھا۔ تو اللہ عزوجل فرمائیں گے: یہ میرے وجه کے لئے نہیں تھا، اور میں آج اس کے سوا کچھ قبول نہیں کروں گا جو میرا وجه چاہنے کے لئے کیا گیا ہو۔"""
"18396","أتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=أ أ““ألشطحەأڬۄۏڽأڲەأ=أحۏشۏأؼصحأڬۏأمضوأۄەأۄوأىەأظشلأًۄأډۏصأىًټأڬۏأدًأتضأىەأؼوهأڬۏتأحہتأ؏أحًأځشًشزڲتشألشوتةەأڲتأ=أحوأىەأضډأڬۄتأۄەأ؏أتضأڬتأؼوهأوۏشەأؼهتًۄأڬضۏأتًشأڬەأهةەأحہتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأزًأتضىتزأڬەأضتحہأىمهأڬۏأۄەأتىأزًىًڽأوۏڽأضەأتۏڬأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أۏۄأشًتۏحأتوتوأثصتشأىەأثہۏأىمهأڬۏأۄەأۗ"
"18397","حضرت انس بن مالک رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷺ نے ارشاد فرمایا : """" جب آخری زمانہ آئے گا تو میری امت تین حصوں میں تقسیم ہو جائے گی ، ایک گروہ خالص طور پر اللہ تعالیٰ کی عبادت کرے گا ، ایک گروہ ریاکاری کے طور پر اللہ تعالیٰ کی عبادت کرے گا ، ایک گروہ اللہ تعالیٰ کی عبادت اس لیے کرے گا تاکہ لوگوں سے مالی فائدہ حاصل کرے ، قیامت کے دن جب اللہ تعالیٰ انہیں جمع کرے گا تو اللہ تعالیٰ اس شخص سے یہ فرمائے گا جو اس عبادت کے ذریعے لوگوں سے مالی فائدہ حاصل کرتا تھا ( اللہ تعالیٰ اس سے دریافت کرے گا : ) میری عزت اور میرے جلال کی قسم ! تم نے کس مقصد کے تحت میری عبادت کی ء وہ بندہ جواب دے گا : تیری عزت اور تیرے جلال کی قسم ! میں اس کے ذریعے لوگوں سے مالی فائدہ حاصل کرنا چاہتا تھا ، تو پروردگار فرمائے گا : تم نے جو کچھ بھی اکٹھا کیا ، وہ تمہیں یہ فائدہ نہیں دے گا کہ اب تم اس کی پناہ لے سکو ( پھر فرشتوں کو حکم ہو گا ) اس کو جہنم کی طرف لے جاا !۔ پھر اللہ تعالیٰ ریاکاری کے طور پر عبادت کرنے والے سے فرمائے گا : میری عزت اور میرے جلال کی قسم ! تم نے میری عبادت کے ذریعے کیا مراد لیا ء ( یعنی میری عبادت کے حوالے سے تمہارا مقصد کیا تھا ء ) تو وہ شخص عرض کرے گا : تیری عزت اور تیرے جلال کی قسم ، لوگوں کے لئے دکھاوا ( میرا مقصد تھا ) پروردگار فرمائے گا : اس میں سے کوئی بھی عمل مجھ تک نہیں پہنچا ( پھر فرشتوں کو حکم ہو گا ) اس کو جہنم کی طرف لے جاا !۔ پھر اللہ تعالیٰ اس شخص سے فرمائے گا جو خالص طور پر اس کی عبادت کرتا تھا ، میری عزت اور میرے جلال کی قسم ! تم میری عبادت کے ذریعے کیا مراد لیتے تھے ء وہ عرض کرے گا : تیری عزت اور تیرے جلال کی قسم ! تو اس بارے میں مجھ سے بہتر جانتا ہے ، میں نے اس کے ذریعے تجھے یاد کرنا اور تیری رضامندی مراد لیا تھا ، اللہ تعالیٰ فرمائے گا : میرے بندے نے سچ کہا ہے ( پھر فرشتوں کو حکم ہو گا : ) اسے جنت کی طرف لے جاا !۔ یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے اس کی سند میں ایک راوی عبید بن اسحاق عطار ہے جس کو جمہور نے ضعیف قرار دیا ہے اور ابوحاتم رازی اس سے راضی تھے ، ابن حبان نے اسے ثقہ کہا ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"18398","ابو سعید خدری رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""جب قیامت کا دن ہوگا تو کافر اپنے کام سے پہچانا جائے گا، تو وہ انکار کرے گا اور جھگڑے گا، تو اس سے کہا جائے گا: یہ تمہارے پڑوسی ہیں جو تم پر گواہی دے رہے ہیں، تو وہ کہے گا: انہوں نے جھوٹ بولیا۔ تو کہا جائے گا: تمہارے اہل و عیال اور عشیرہ۔ تو وہ کہے گا: انہوں نے جھوٹ بولیا۔ تو کہا جائے گا: قسم کھاؤ، تو وہ قسم کھائیں گے، پھر اللہ انہیں خاموش کر دے گا، اور ان کی زبانیں گواہی دیں گیں، پھر انہیں آگ (جہنم) میں ڈال دیا جائے گا۔"" اسے ابو یعلی نے حسن اسناد سے روایت کیا ہے، اگرچہ اس میں کچھ ضعف ہے۔"
"18399","أذعشحأؼمثۄأثىأؼتوشأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أتىۄًڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ= أ““أدضأزىأوىۄأځشأوۄشأهڲتأزۏأدتةەأڲۏأتضأزىأتىضتىأڬۏأدًأۄڋۏأضثأضەأځۄهەأڬهتوأڬشەأڲۏأًۄأثتةۏڽأټتىڲأڬتأصتىًأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأتذوزأتًشأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأتىأزًىًڽأڬۏأضىزأؼوزۄأۄەأۗ"
"18400","أذعشحأوؼتًۏۄأثىأذۏزيأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أإځأ﷽أىەأتشطتزألشوتۏتأ=أ"
"18401","أ+أؼهتوۄأۄۏخوۏألشوتحەأۄۏڽأ=أ,أوۏڽأۏۄأڬۄحتأۄًڽأ=أتضأضەأځۄهەأذعشحأؼثزتههۄأثىأتىۏضأشعۏأتههۄأؼىۄأڬۏأىمهأڬشزۄأذزۏخأڲصشأډڬۏأۄەأڬۄأتىۄًڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ="
"18402","أضۏزۄأؼتةطۄأظزۏمۄأشعۏأتههۄأؼىۄتأتًشأتۏڬأظذتثۏأ؏أىثۏأتڬشوأ﷽أڬەأذًتهەأضەأۏۄأثتحأىمهأڬشحەأۄۏڽأ=أ"
"18403","أذعشحأتثًسشأؽلتشۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أحطشۏلألشوتأحہەأ؏أزًأثڬشۏتڽأډشأشۄۏأحہۏڽأ؏أتْىأزًىًڽأوۏڽأضەأتۏڬأىەأزًضشۏأڬًأضۏىڲأوتشأڬشأتضەأځشەأڬشأزۏتأحًأىثۏأتڬشوأ﷽أۄىضأځڔەأ؏أؼشعأڬۏأڲةۏأ=أۏتأشضًهأتههۄأ$أإځأڬۏًڽأۄىضحەأۄۏڽأآأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أودہەأتضأځشأذۏشتىۏأۄًةۏأ؏أتضأستحأڬۏأمضوأ$أدضأڬەأزضحأمزشحأوۏڽأوۏشۏأدتىأۄەأ؏أمۏتوحأڬەأزىأتْضەأثزهۄأزهًتۏتأدتةەأڲتأۗ"
"18404","أتۏڬأشًتۏحأوۏڽأۏۄأثتحأوسڬًشأۄەأ=أ أ““أىثۏأتڬشوأ﷽أىەأزًأثڬشۏًڽأڬًأزۏڬہتأڬۄأًۄأتۏڬأزًضشەأڬًأضۏىڲأوتشأشۄۏأحہۏڽأ؏أإځأىەألشوتۏتأ=أتەأتثًسشأ$أڬۏتأحوأتضأثتشەأوۏڽأدتىحەأۄًأآأۏۄأدًأتۏڬأزًضشەأڬًأضۏىڲأوتشأشۄۏأۄۏڽأ؏أذعشحأتثًسشأشعۏأتههۄأؼىۄأىەأؼشعأڬۏأ=أدۏأىۄۏڽأ$أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أهۏڬىأتههۄأحؼتهۏٳأۏۄأثتحأدتىحتأۄەأتًشأًۄأؼىمشۏثأتىأزًىًڽأڬەأزشوۏتىألۏظهۄأزەأڲتأۗ‛‛ أۏۄأحوتوأشًتۏتحأتوتوأتذوزأىەأىمهأڬۏأۄۏڽأ؏أتوتوأثصتشأىەأځۄهۏأشًتۏحأىمهأڬۏأۄەأتوتوأغثشتىۏأىەأتضۏأغشذأڬۏأشًتۏحأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأ؏أتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأهۏخأثىأتثۏأضهۏوأۄەأتًشأًۄأوزهضأۄەأ؏أتوتوأتذوزأڬەأثمۏۄأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأتىأڬەأتضحتزأتثىأؼتةطۄأڬتأوؼتوهۄأورحهلأۄەأتًشأًۄأخمۄأۄەأۗأ أزًضشۏأشًتۏحأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأتًشأتضأڬۏأضىزأوۏڽأتۏضتأشتًۏأۄەأ؏أدضأڬتأىتوأثۏتىأىۄۏڽأڬۏتأڲۏتأۄەأۗ"
"18405","أذعشحأؼخوتىأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ= أ““أمۏتوحأڬەأزىأضۏىڲأڬەأثؽۏشأًتهۏأثڬشۏأڬًأ؏أضۏىڲأًتهۏأثڬشۏأضەأثزهۄأزهًتۏتأدتةەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأتثًۏؼهۏٳأىەأڬثۏشأوۏڽأىمهأڬۏأۄەأتًشأتوتوأثصتشأىەأىمهأڬۏأۄەأتًشأؼثزتههۄأثىأتذوزأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأذدتدأثىأىظۏشأۄەأدضأڬەأعؼۏلأۄًىەأڬەأثتًدًزأتضأڬۏأحًخۏمأڬۏأڲةۏأۄەأ؏أۄصتشأڬەأثمۏۄأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأؼًتوأثىأوصتذوأڬتأوؼتوهۄأورحهلأۄەأتًشأًۄأخمۄأۄەأۗ"
"18406","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أورهًمأڬًأتۏڬأزًضشەأضەأثزهۄأزهًتۏتأدتةەأڲتأ؏أۏۄتڽأحڬأڬۄأضۏىڲأڬەأثؽۏشأًتهۏأثڬشۏأڬًأ؏أضۏىڲأًتهۏأثڬشۏأضەأ؏أتًشأتۏڬأډۏًىټۏأڬًأزًضشۏأډۏًىټۏأضەأثزهۄأزهًتۏتأدتةەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18407","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أذعشحأظتزمأًأوظزًمأ؏أتثًتهمتضوأ﷽أىەأودہەأۏۄأثتحأثۏتىأڬۏأۄەأ=““أثەأطڬأځۄهەأزًألشۏمأمۏتوحأڬەأزىأ؏أدىأڬەأزشوۏتىألۏظهۄأڬۏتأدتةەأڲتأ؏أًۄأزًأثڬشۏتڽأۄًڽأڲۏأ؏أتۏڬأضۏىڲأًتهۏأۄًأڲۏأتًشأتۏڬأضۏىڲأڬەأثؽۏشأۄًأڲۏأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأ؏أتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأدتثشأثىأۏصۏزأدؼلۏأۄەأتًشأًۄأعؼۏلأۄەأۗ"
"18408","أذعشحأؼثزتههۄأثىأتثًتًلۏٳأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأتههۄأحؼتهۏٳأڬتأؼزهأۏۄتڽأحڬأدتةەأڲتأڬۄأثؽۏشأضۏىڲأًتهۏأثڬشۏأڬًأ؏أضۏىڲأًتهۏأضەأثزهۄأزهًتۏتأدتةەأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏضەأشتًۏأۄۏڽأ؏أدىأضەأوۏڽأًتملأىۄۏڽأۄًڽأتًشأتۏڬأشتًۏأؼغتأثىأضتةثأۄەأدًأترحهتغأڬتأطڬتشأۄًأڲۏتأحہتأۗ"
"18409","أىثۏأتڬشوأ﷽أڬۏأصًدۄأوذحشوۄأضۏزۄأتوأضهوۄأشعۏأتههۄأؼىۄتأثۏتىأڬشحۏأۄۏڽأ=أىثۏأتڬشوأ﷽أوۏشەأڲہشأوۏڽأوًدًزأحہەأ؏أإځأڬەأزضحأوثتشڬأوۏڽأوضًتڬأحہۏأ؏أځہشأىثۏأتڬشوأ﷽أىەأتځىۏأڬىۏصأڬًأ+أشتًۏأڬًأطڬأۄەأ؏أۏتأطتۏزأۏۄأتهلتػأۄۏڽأ=أ,أضۏزۄأتوأضهوۄأشعۏأتههۄأؼىۄتأڬۏأڬىۏصأڬًأثهتۏتأ+أًۄأىۄۏڽأإةۏأ,أحًأىثۏأتڬشوأ﷽أڬەأډۄشۄأوثتشڬأځشأؽعثأڬەأإختشأىوتۏتڽأۄًةەأ؏أضۏزۄأتوأضهوۄأشعۏأتههۄأؼىۄتأتْټہأڬشأڬوشەأڬەأتىزشأڲةۏڽأ؏أحًأتىۄًڽأىەأتضأڬىۏصأڬًأځتۏتأڬۄأًۄأثڬشۏأڬەأثډەأڬەأضتحہأڬہۏهأشۄۏأحہۏأ؏أحًأضۏزۄأتوأضهوۄأشعۏأتههۄأؼىۄتأىەألشوتۏتأ=أحوأۏۄتڽأثڬشۏأڬەأثډەأڬەأضتحہأڬہۏهأشۄۏأۄًأتًشأىثۏأتڬشوأ﷽أحوۄۏڽأثهتأشۄەأۄۏڽأ؏أتضأڬىۏصأىەأؼشعأڬۏأ=أتضأستحأڬۏأمضوأ$أدضأىەأإځأڬًأذمأڬەأۄوشتۄأوثؼًخأڬۏتأۄەأ؏أوۏڽأىەأإځأڬۏأإًتصأىۄۏڽأضىۏأحہۏأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتڲشأثزهۄأزۏەأدتىەأڬتأتىزۏطۄأىۄأۄًحتأحًأوۏڽأىەأحوۄۏڽأتضأوضًتڬأڬەأسشۏؼەأوتشىتأحہتأۗ‛‛"
"18410","أتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=““أتڲشأمظتظأىۄأۄًحتأحًأوۏڽأىەأحوۄۏڽأتضأوضًتڬأڬەأسشۏؼەأوتشىتأحہتأۗ‛‛"
"18411","أتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=““أتڲشأمظتظأڬتأرًلأىۄأۄًحتأحًأوۏڽأىەأحوۄۏڽأتضأهڬڔۏأڬەأسشۏؼەأحڬهۏلأځۄىډتىۏأحہۏأۗ‛‛أ أۏۄأحوتوأشًتۏتحأتوتوأتثًۏؼهۏٳأىەأىمهأڬۏأۄۏڽأتًشأتوتوأغثشتىۏأىەأتضأڬۏأوتىىزأىمهأڬۏأۄۏڽأ؏أحتۄوأتىۄًڽأىەأۏۄأتهلتػأىمهأڬةەأۄۏڽأ=““أىثۏأتڬشوأ﷽أىەأتځىۏأڬىۏصأڬًأثهتۏتأۗ‛‛أۏۄأتهلتػأڬضۏأطڬأڬەأثؽۏشأۄۏڽأتًشأتىۄًڽأىەأۏۄأتهلتػأىمهأڬةەأۄۏڽأ=†أتڲشأمۏتوحأڬەأزىأثزهۄ زۏەأدتىەأڬتأرًلأىۄأۄًحتأۗ‛‛أ أتوتوأتثًۏؼهۏٳأتًشأغثشتىۏأڬۏأىمهأڬشزۄأشًتۏحأڬۏأضىزأؼوزۄأۄەأۗ"
"18412","أذعشحأؼوتشأثىأۏتضشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أدًأطرظأتځىەأؽهتوأڬًأوتشەأڲتأڬۄأمۏتوحأڬەأزىأ؏أتضأؽهتوأڬًأتضأضەأثزهۄأزهًتۏتأدتةەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأخمۄأۄۏڽأۗ"
"18413","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أدًأطرظأػهوأڬەأغًشأځشأتۏڬأډہڔۏأوتشەأڲتأڬۄأمۏتوحأڬەأزىأتضأضەأثزهۄأزهًتۏتأدتةەأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأثصتشأىەأتًشأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتًشأتىأزًىًڽأڬۏأضىزأذضىأۄەأۗ"
"18414","أذعشحأخًثتىأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأدثأ““أدثتشأحثتشڬأًأحؼتهۏٳأ‛‛أإةەأڲتأتًشأځهأځشأتځىۏأټتىڲأوًڔأهەأڲتأتًشأۏۄألشوتةەأڲتأ؏أوۏشۏأؼصحأتًشأوۏشەأدهتهأڬۏأمضوأۄەأ؏أڬضۏأػتهوأڬتأػهوأوۏشەأإڲەأضەأىۄۏڽأڲصشأضڬەأڲتأ؏أځہشأًۄأورهًمأڬەأزشوۏتىأتىأڬەأثتۄوۏأوؼتوهتحأڬەأذًتهەأضەأتىظتلأڬشەأڲتأ؏أۏۄتڽأحڬأڬۄأًۄأثؽۏشأضۏىڲأًتهۏأثڬشۏأڬًأضۏىڲأًتهۏأثڬشۏأضەأثزهۄأزهًتةەأڲتأ؏أدًأضۏىڲأتْضأىەأتضەأوتشتأحہتأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأۏصۏزأثىأشثۏؼأۄەأ؏أدضەأتۏڬأدوتؼحأىەأعؼۏلأمشتشأزۏتأۄەأ؏أتثىأؼزۏأڬۄحەأۄۏڽأ=أودہەأۏۄأتوۏزأۄەأڬۄأتضأوۏڽأڬًةۏأذشدأىۄۏڽأۄًأڲتأ؏أتضأشًتۏحأڬەأثمۏۄأشدتهأخمۄأۄۏڽأۗ"
"18415","أذعشحأضهوتىألتشضۏأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأتۏڬأطرظأتحىۏأىۏڬۏتڽأهەأڬشأإةەأڲتأڬۄأًۄأۏۄأڲوتىأڬشەأڲتأڬۄأتىأڬۏأًدۄأضەأًۄأىدتحأځتأدتةەأڲتأ؏أهۏڬىأځہشأڬًةۏأطرظأإةەأڲتأدضأځشأتضأىەأػهوأڬۏتأۄًأڲتأ؏أحًأتضأطرظأڬۏأىۏڬۏتڽأهەأڬشأوػهًوأڬًأزەأزۏأدتةۏڽأڲۏأ؏أۏۄتڽأحڬأڬۄأتضأطرظأڬۏأڬًةۏأىۏڬۏأثتمۏأىۄۏڽأشۄەأڲۏأ؏أځہشأڬًةۏأتًشأطرظأإةەأڲتأدًأتضأضەأوغتهثۄأڬشەأڲتأهۏڬىأتضأڬۏأڬًةۏأىۏڬۏأثتمۏأىۄۏڽأشۄۏأۄًأڲۏأحًأوػهًوأڬۏأثشتةۏتڽأهەأڬشأتْضأڬۏأثشتةۏًڽأوۏڽأطتوهأڬشأزۏأدتةۏڽأڲۏأۗ‛‛ أۏۄأشًتۏحأغثشتىۏأتًشأتوتوأثصتشأىەأؼثزتههۄأثىأتضذتمأؼغتشأڬەأذًتهەأضەأرتهزأثىأذوصۄأضەأىمهأڬۏأۄەأتًشأوۏڽأتىأزًىًڽأضەأًتملأىۄۏڽأۄًڽأ؏أتضأشًتۏحأڬەأثمۏۄأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18416","أضهۏوتىأثىأذثۏثأوذتشثۏأثۏتىأڬشحەأۄۏڽأ=أوۏڽأدىڲأوۏڽأذظۄأهۏىەأڬەأهۏەأشًتىۄأۄًتأ؏أدثأوۏشتأڲصشأ““أذوظأ‛‛أضەأۄًتأحًأوۏڽأثتصتشأڬۏأغشلأڲۏتأحتڬۄأًۄتڽأضەأًۄأډۏصۏڽأهەأهًڽأدًأوضتلشأڬەأهۏەأعشًشۏأۄًحۏأۄۏڽأ؏أدثأوۏڽأىەأوضدزأڬەأزشًتصەأڬۏأغشلأزۏڬہتأحًأوۏڽأىەأضًډتأڬۄأتڲشأوۏڽأوضدزأڬەأتىزشأدتأڬشأزًأشڬؼحأتزتأڬشأهًڽأ+أحًأۏۄأوىتضثأۄًأڲتأ,أدثأوۏڽأوضدزأڬەأتىزشأإۏتأحًأوۏڽأىەأزۏڬہتأڬۄأًۄتڽأختثحأثىأوؼثزأ؏أتثىأصڬشۏتأتًشأوڬذًهأ؏أتۄهأزوطمأضەأحؼهمأشڬہىەأًتهەأڬډہأتلشتزأڬەأۄوشتۄأوًدًزأحہەأ؏أدثأوۏڽأىەأتىأهًڲًڽأڬًأزۏڬہتأحًأوۏڽأتىأڬەأځتضأإۏتأتًشأتىأڬەأځتضأثۏټہأڲۏتأ؏أًۄأهًڲأڬډہأزۏشأثتحأډۏحأڬشحەأشۄەأ؏أځہشأتىۄًڽأىەأڬۄتأ=أۄوأذعشحأتثًتوتوۄأثتۄهۏأشعۏأتههۄأؼىۄأڬۏأغشلأدتىەأڬتأتشتزۄأشڬہحەأۄۏڽأ؏أًۄأهًڲأتْټہەأحًأتىأڬەأضتحہأوۏڽأثہۏأتْټہأڲۏتأ؏أۄوأهًڲأذعشحأتثًتوتوۄأشعۏأتههۄأؼىۄأڬۏأرزوحأوۏڽأذتعشأۄًةەأ؏أًۄأتۏڬأثًڔہەأڬوصًشأؼوشأشضۏزۄألشزأحہەأ؏أهۏڬىأتىأڬۏأػتۄشۏأذتهحأڬۏأثۄأىضثحأتىأڬۏأؼمهأتًشأتىأڬۏأڲلحڲًأصۏتزۄألعۏهحأشڬہحۏأحہۏأ؏أتىۄًڽأىەأۄوۏڽأدًأثتحأتشطتزألشوتةۏأ؏أتضأوۏڽأضثأضەأځۄهۏأثتحأۏۄأحہۏأ؏أحوۄتشۏأۏۄأىطضحأتههۄأحؼتهۏٳأڬۏأغشلأضەأحوۄتشەأهةەأحثهۏؽأۄەأتًشأحوۄتشەأرهتلأتههۄأحؼتهۏٳأڬۏأذدحأۄەأ؏أىثۏأتڬشوأ﷽أڬًأدضأډۏصأڬەأۄوشتۄأوؼثًخأڬۏتأڲۏتأحہتأ؏أإځأىەأتضأڬۏأحثهۏؽأڬشأزۏأتًشأىثۏأتڬشوأ﷽أڬەأتظذتثأىەأدًأڬډہأضىتأحہتأ؏أتْضأڬۏأتىۄًڽأىەأحثهۏؽأڬشأزۏأ؏أحًأحوأهًڲأدًأضىًأڲەأ؏أحوأثہۏأتضأڬۏأحثهۏؽأڬشأزۏىتأ$أ أ““أحۏىأهًڲأۄۏڽأ؏أدىأڬتأتههۄأحؼتهۏٳأعتوىأۄەأ؏أتۏڬأًۄأطرظأدًأتههۄأڬۏأشتۄأوۏڽأىڬهحتأۄەأحًأتههۄأحؼتهۏٳأڬەأسوۄأۏۄأثتحأۄەأ؏أتههۄأحؼتهۏٳأتضەأدىحأوۏڽأزترهأڬشأزەأ؏أۏتأځہشأتضەأتدشأتًشأؽىۏوحأڬەأۄوشتۄأًتځضأهەأإةەأ؏أتًشأتۏڬأًۄأطرظأدًأتځىەأڲہشأوۏڽأضهتوحۏأڬەأۄوشتۄأزترهأۄًحتأۄەأۗ‛‛أ أځہشأتىۄًڽأىەأۏۄأثتحأثۏتىأڬۏأ=أدۄىوأځشأځهأۄًأڲتأدضأوۏڽأضتحأغثمەأۄًڽأڲەأ؏أتىأوۏڽأضەأزشوۏتىأًتهەأځشأىتلشوتىأهًڲأۄًڽأڲەأ؏أڬضۏأثىزەأڬًأهتۏتأدتةەأڲتأ؏أۏۄتڽأحڬأڬۄأدثأًۄأزشوۏتىۏأزشدەأځشأځۄىډەأڲتأحًأتضأضەأزشۏتلحأڬۏتأدتةەأڲتأ=أحوۄتشەأسوۄأڬحىتأمشعأۄەأآأځہشأتىۄًڽأىەأۏۄأإۏحأحهتًحأڬۏأ= أ““أتًشأًۄأتههۄأحؼتهۏٳأضەأڬًةۏأثتحأډہځتأىۄۏڽأضڬۏڽأڲەأۗ‛‛أ أًۄأطرظأڬۄەأڲتأ=أتەأوۏشەأځشًشزڲتشأ$أوۏشەأسوۄأتحىتأ؏أتحىتأمشعأۄەأ؏أحًأتْضەأڬۄتأدتةەأڲتأ=أحوأتځىتأمشعأتزتأڬشًأ$أًۄأڬۄەأڲتأ=أوۏشەأځتضأحًأڬًةۏأډۏصأىۄۏڽأۄەأ؏أودہەأضودہأىۄۏڽأإأشۄۏأڬۄأوۏڽأڬضأډۏصأڬەأسشۏؼەأتزتةۏڲۏأڬشًڽأآأحًأڬۄتأدتةەأڲتأ=أتضأڬۏأىۏڬۏتڽأهەأهًأ$أتضأطرظأضەأىۏڬۏتڽأهۏأدتةۏڽأڲۏأ؏أۏۄتڽأحڬأڬۄأتضأڬۏأڬًةۏأىۏڬۏأثتمۏأىۄۏڽأشۄەأڲۏأ؏أدثأتضأڬۏأىۏڬۏتڽأرحوأۄًأدتةۏڽأڲۏأحًأڬۄتأدتةەأڲتأ=أتضأڬۏأىۏڬۏتڽأرحوأۄًأڲةۏأۄۏڽأ؏أحًأۏۄأڬۄتأدتةەأڲتأ=أتضأضەأوغتهثۄأڬشىەأًتهەأڬەأڲىتۄأهًأتًشأتضأڬەأسوۄأڋتهأزًأ$أ"
"18417","أذعشحأتثًتوتوۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أمۏتوحأڬەأزىأػتهوأإةەأڲتأ؏أۏۄتڽأحڬأڬۄأًۄأدۄىوأڬەأځهأڬەأځتضأځۄىډەأڲتأ؏أدۄتڽأحتشۏڬۏأتًشأڲہثشتۄټأۄًأڲۏأ؏أحًأوػهًوأتضأضەأوهەأڲتأ؏أًۄأتضەأځۄډتىأهەأڲتأ؏أتضأىەأدًأػهوأتضأځشأڬۏتأحہتأتْضەأثہۏأځۄډتىأهەأڲتأ؏أځہشأػهوأڬشىەأًتهًڽأضەأ؏أوػهًوًڽأڬًأوضهضهأثزهۄأزهتۏتأدتحتأشۄەأڲتأ؏أۏۄتڽأحڬأڬەأتىأػتهوًڽأڬەأځتضأدحىۏأىۏڬۏتڽأۄًڽأڲۏأًۄأتىأضەأهەأهۏأدتةۏڽأڲۏأتًشأدثأتىأڬۏأىۏڬۏتڽأثتمۏأىۄۏڽأشۄۏڽأڲۏأ؏أحًأوػهًوًڽأڬۏأثشتةۏتڽأتْىأځشأڋتهأزۏأدتةۏڽأڲۏأ؏أۏۄتڽأحڬأڬۄأتىۄۏڽأدۄىوأڬەأضثأضەأىۏډەأًتهەأغثمەأوۏڽأځۄىډتأزۏتأدتةەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأڬۏأحًخۏمأڬۏأڲةۏأۄەأۗ"
"18418","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أمۏتوحأڬەأزىأهًڲًڽأڬەأځۄتڔًڽأدۏضەأوػتهوأهتةەأدتةۏڽأڲەأدًأتىۄًڽأىەأتۏڬأزًضشەأځشأڬةەأۄًڽأڲەأتًشأتىأڬەأذمًمأهتةەأدتةۏڽأڲەأتًشأځہشأتههۄأحؼتهۏٳأوضهضهأتىأڬەأذًتهەأضەأثزهۄأزهًتحتأشۄەأڲتأ؏أۏۄتڽأحڬأڬۄأتىأوۏڽأضەأڬًةۏأډۏصأثتمۏأىۄۏڽأشۄەأڲۏأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأ؏أتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأدتثشأثىأۏصۏزأدؼلۏأۄەأتًشأًۄأعؼۏلأۄەأۗ"
"18419","ابو بردہ بن نیار رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""اللہ عزوجل قرض دار کو قرض مانگنے والے پر اس طرح روکے گا جیسے کسی چیز کو کسی چیز پر سخت سے سخت روکا گیا ہو، تو وہ کہے گا: اے رب! میں اسے کیسے ادا کروں جبکہ آپ نے مجھے ننگا اور ننگے پاؤں حشر کیا ہے، تو میں کہاں سے لاؤں؟! تو اللہ عزوجل فرمائیں گے: میں انہیں تمہاری نیکیوں سے دوں گا، تو انہیں لوگوں کی نیکیوں پر ڈال دیا جائے گا، اگر وہ کافی ہو گئیں تو ٹھیک، اور اگر نہ کافی ہوئیں تو لوگوں کی برائیوں میں سے لے کر تمہاری برائیوں پر ڈال دیں گے۔"" اسے طبرانی نے اوسط میں روایت کیا ہے، اور اس میں حماد بن شعیب ہے، جو بہت ضعیف ہے۔"
"18420","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأىثۏأتڬشوأ﷽أڬەأذًتهەأضەأذعشحأشًذأتهتوۏىأؼهۏۄأتهضهتوأڬەأذًتهەأضەأۏۄأثتحأىمهأڬشحەأۄۏڽأ=أځشًشزڲتشألشوتحتأۄەأ="
"18421","أصتستىأثۏتىأڬشحەأۄۏڽأ=أوۏڽأذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أودہأضەأځۄهەأشۏطوأتًشأزۏثتدأًتهەأهًڲأتىأڬەأځتضأإأډڬەأحہەأ؏أوۏڽأىەأڬۄتأ=أإځأىەأهًڲًڽأڬًأمشۏثأڬشأهۏتأۄەأتًشأودہەأزًشأڬشأزۏتأۄەأ؏أتىۄًڽأىەأودہأضەألشوتۏتأ=أحوأمشۏثأإأدتاأ$أتىۄًڽأىەأودہەأمشۏثأڬۏتأۏۄتڽأحڬأڬۄأتىۄًڽأىەأودہەأتځىەأثډہًىەأځشأثټہتۏتأ؏أځہشأتىۄًڽأىەألشوتۏتأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ="
"18422","أدۄوأثىأتًضأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأؼثزتههۄأثىأتثًوشۏوأڬًأضىتأ؏أؼثزتههۄأثىأشضحوأتځىۏأضًتشۏأځشأتىأڬەأځتضأضەأڲصشتأتضأىەأتثىأتثًوشۏوأضەأڬۄتأ=أوۏشۏأۏۄأرًتۄطأحہۏأڬۄأوۏڽأإځأڬەأځتضأثۏټہحتأتًشأإځأڬەأضتحہأثتحأډۏحأڬشحتأ؏أدثأًۄأډهتأڲۏتأحًأتثىأتثًوشۏوأىەأڬۄتأ=أوۏڽأىەأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأڬًأۏۄأثۏتىأڬشحەأۄًةەأضىتأۄەأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأۄەأ="
"18423","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أتههۄأحؼتهۏٳأتضأثىزەأځشأشذوأڬشەأدضأىەأتځىەأڬضۏأثہتةۏأڬەأضتحہأدتىأۏتأوتهأڬەأذًتهەأضەأڬًةۏأصۏتزحۏأڬۏأۄًأ؏أځہشأًۄأتځىەأثہتةۏأڬەأځتضأدتةەأتًشأمۏتوحأڬەأزىأضەأځۄهەأتضەأوؼتلأڬشًتأهەأڬۏًىڬۄأمۏتوحأڬەأزىأحًأڬًةۏأزۏىتشأۏتأزشۄوأىۄۏڽأۄًأڲتأًۄتڽأحًأىۏڬۏتڽأۄۏأۄًڽأڲۏأۗ‛‛أ أؼشعأڬۏأڲةۏأ=أۏتأشضًهأتههۄأ$أتڲشأتضأڬەأځتضأىۏڬۏتڽأىۄأۄًةۏڽأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أحًأزًضشەأطرظأڬەأڲىتۄأهەأڬشأتضأڬەأڲىتۄًڽأوۏڽأطتوهأڬشأزۏەأدتةۏڽأڲەأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأۄتطوأثىأؼۏضۏٳأۏصىۏأۄەأتًشأوۏڽأتضأضەأًتملأىۄۏڽأۄًڽأتضأشًتۏحأڬەأثمۏۄأشدتهأڬۏأحًخۏمأڬۏأڲةۏأۄەأتڲشډۄأتىأوۏڽأضەأڬډہأوۏڽأعؼلأځتۏتأدتحتأۄەأۗ"
"18424","أذعشحأتثًوًضۏٳأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أتههۄأحؼتهۏٳأزىۏتأوۏڽأدضأثىزەأڬۏأځشزۄأځًطۏأڬشەأڲتأتْضەأمۏتوحأڬەأزىأتضأذًتهەأضەأؼتشأىۄۏڽأزهتةەأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأظؽۏشأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأؼوشأثىأضؼۏزأتثذأۄەأتًشأًۄأعؼۏلأۄەأۗ"
"18425","أضۏزيأتوأۄتىۏأثىحأتثًغتهثأشعۏأتههۄأؼىۄتأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحۏأۄۏڽأ=أ أ““أثەأطڬأتههۄأحؼتهۏٳأحوتوأځۄهەأًتهًڽأتًشأحوتوأثؼزأًتهًڽأڬًأتۏڬأوۏزتىأوۏڽأتڬټہتأڬشەأڲتأځہشأؼشطأڬەأىۏډەأضەأتۏڬأوىتزۏأځڬتشأڬشأۏۄأڬۄەأڲتأ=أتەأتۄهأحًذۏزأ$أثۏطڬأتههۄأحؼتهۏٳأىەأحوأضەأزشڲصشأڬۏتأۄەأ؏أځہشأًۄأهًڲأڬډہأصۏتزحۏًڽأڬەأذًتهەأضەأتۏڬأزًضشەأضەأوغتهثۄأڬشۏڽأڲەأحًأوىتزۏأځڬتشأڬشأڬۄەأڲتأ=أتەأتۄهأحًذۏزأ$أحوأتۏڬأزًضشەأڬًأوؼتلأڬشأزًأتًشأتضأڬتأخًتثأوۏشەأسوۄأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأتثًؼتظوأشثۏؼأثىأتضوتؼۏهأۄەأدًأوىڬشأتهذزۏخأۄەأۏۄأثتحأتثًذتحوأىەأڬۄۏأۄەأۗ"
"18426","حضرت انس بن مالک رضی اللہ عنہ روایت کرتے ہیں : نبی اکرم ﷺ نے ارشاد فرمایا : """" قیامت کے دن جب مخلوق اکٹھی ہو گی اور اہل جنت کو جنت میں داخل کر دیا جائے گا اور اہل جہنم کو جہنم میں داخل کر دیا جائے گا تو ایک منادی پکار کر یہ کہے گا : اے اہل جمع ! تم آپس کی زیادتیوں کو چھوڑ دو ( یعنی معاف کر دو ! ) تمہارا ثواب میرے ذمہ ہے ۔"""" یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے اس کی سند میں ایک راوی حکم بن سنان ابوعون ہے ابوحاتم کہتے ہیں : اسے بہت زیادہ وہم لاحق ہوتا ہے ، یہ قوی نہیں ہے اس کا محل صدق ہے ، اس کی حدیث کو نوٹ کیا جائے گا ، ان کے علاوہ دیگر حضرات نے اسے ضعیف قرار دیا ہے اس روایت کے بقیہ رجال ثقہ ہیں ۔ اس سے پہلے علم کی فضیلت سے متعلق باب میں حدیث گزر چکی ہے کہ اللہ تعالیٰ علماؤ سے فرمائے گا : """" میں نے اپنا علم تمہارے اندر اس لیے نہیں رکھا کہ میں یہ ارادہ رکھتا تھا کہ میں تمہیں عذاب دوں ، تم جاا ! میں نے تمہاری مغفرت کر دی ہے ۔"""" اسی طرح ایک حدیث قرض کے بارے میں ہے ، جو شخص قرض لیتا ہے اور اس کا مال ضائع ہو جاتا ہے تو اللہ تعالیٰ اس کی طرف سے ادائیگی کروا دے گا ۔"
"18427","أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأحًأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ"
"18428","ابو ہریرہ رضی اللہ عنہ سے روایت ہے کہ نبی ﷺ نے فرمایا: ""तुम میں سے کسی کو اس کا عمل نجات نہیں دے گا۔"" انہوں نے کہا: ""اے اللہ کے رسول! آپ کو بھی نہیں؟"" آپ نے فرمایا: ""میں بھی نہیں، سوا اس کے کہ اللہ مجھ پر اپنی رحمت سے ڈھانپ لے۔ تو سیدھے چلو اور قریب رہو، صبح کو اور شام کو چلو، اور رات کے آخری حصے سے کچھ حصہ لو، اور مقصد کو مقصد بناؤ، تم پہنچ جاؤ گے۔"" میں نے کہا: یہ صحیح میں مختصراً موجود ہے۔ اسے احمد نے روایت کیا ہے، اور اس کے راوی صحیح کے راوی ہیں۔"
"18429","أتىأظذتثۏأڬەأذًتهەأضەأۏۄأثتحأوىمًهأۄەأ=أًۄأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ="
"18430","أذعشحأتثًوًضۏٳأتطؼشۏأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أحوأوۏڽأضەأڬضۏأتۏڬأڬًأتضأڬتأؼوهأىدتحأىۄۏڽأزهًتةەأڲتأ؏أهًڲًڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأڬًأثہۏأىۄۏڽأآأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أودہەأثہۏأىۄۏڽأتهثحۄأتههۄأحؼتهۏٳأىەأتځىۏأشذوحأڬەأسشۏؼەأودہەأڋہتىځأهۏتأۄەأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأىەأتوتوأغثشتىۏأىەأوؼدوأتًضغأتًشأوؼدوأڬثۏشأوۏڽأىمهأڬۏأۄەأ؏أحتۄوأتىۄًڽأىەأوؼدوأڬثۏشأوۏڽأۏۄأتهلتػأىمهأڬةەأۄۏڽأ= أ““أحوأوۏڽأضەأڬضۏأتۏڬأڬًأتضأڬتأؼوهأدىحأوۏڽأزترهأىۄۏڽأڬشًتةەأڲتأ؏أذتعشۏىأوۏڽأضەأڬضۏأىەأزشۏتلحأڬۏتأ=أإځأڬًأثہۏأىۄۏڽأآ111111أتضأڬەأثؼزأشتًۏأىەأځًشۏأذزۏخأسڬشأڬۏأۄەأۗأ أتىأشًتۏتحأڬۏأتضتىۏزأوۏڽأتۏڬأشتًۏأتطؼخأثىأضًتشأۄەأدضأڬەأعؼۏلأۄًىەأڬەأثتًدًزأتضأڬۏأحًخۏمأڬۏأڲةۏأۄەأ؏أتىأشًتۏتحأڬەأثمۏۄأشدتهأخمۄأۄۏڽأۗ"
"18431","أذعشحأطشۏڬأثىأغتشمأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أحوأوۏڽأضەأڬًةۏأتۏڬأؼوهأڬۏأًدۄأضەأدىحأوۏڽأزترهأىۄۏڽأۄًأڲتأ؏أهًڲًڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأثہۏأىۄۏڽأآأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أوۏڽأثہۏأىۄۏڽأ؏أتهثحۄأتههۄأحؼتهۏٳأىەأودہەأتځىۏأشذوحأتًشألعهأڬەأسشۏؼەأڋہتىځأهۏتأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأورحهلأتضتىۏزأڬەأذًتهەأضەأىمهأڬۏأۄەأدىأوۏڽأضەأتۏڬأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18432","أذعشحأتضتوۄأثىأطشۏڬأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ"
"18433","أذعشحأتضزأثىأڬشصأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ="
"18434","حضرت انس بن مالک رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" قیامت کے دن ابن آدم کے لیے تین دیوان لائے جائیں گے ، ایک دیوان میں نیک عمل ہو گا ، ایک دیوان میں اس کے گناہ ہوں گے ، ایک دیوان میں اس پر اللہ تعالیٰ کی نعمتوں کا ذکر ہو گا ، اللہ تعالیٰ اپنی سب سے چھوٹی نعمت سے یہ فرمائے گا : ( راوی کہتے ہیں میرا خیال ہے ، روایت میں یہ الفاظ بھی ہیں : ) نعمتوں والے دیوان میں ( موجود سب سے چھوٹی نعمتوں سے یہ فرمائے گا : ) تم اس کے نیک اعمال میں سے اپنی قیمت وصول کر لو ! تو وہ نعمت اس شخص کے سارے نیک عمل کو حاصل کر لے گی ، پھر وہ پیچھے ہٹے گی اور یہ کہے گی : تیری عزت کی قسم ! میں نے پوری وصولی نہیں کی ، پھر اس شخص کے گناہ اور نعمتیں باقی رہ جائیں گے ، کیونکہ اس کا نیک عمل تو سارا رخصت ہو چکا ہو گا ، جب اللہ تعالیٰ بندے پر رحم کرنے کا ارادہ کرے گا تو فرمائے گا : اے میرے بندے ! اللہ تعالیٰ نے تیری نیکیوں کو کئی گنا کر دیا ہے اور اس نے تیرے گناہوں سے درگزر کیا ہے ( راوی کہتے ہیں : میرا خیال ہے ، روایت میں یہ الفاظ بھی ہیں : ) اور میں نے اپنی نعمتیں تمہیں ہبہ کر دی ہیں ۔"""" یہ روایت امام بزار نے نقل کی ہے اس کی سند میں ایک راوی صالح مری ہے اور وہ ضعیف ہے ۔"
"18435","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأ=أذثطۄأضەأحؼهمأشڬہىەأًتهتأتۏڬأطرظأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أتضأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأهًڲًڽأڬًأشىڲحأتًشأىثًحأڬەأذًتهەأضەأۄوأځشألعۏهحأزۏأڲةۏأۄەأ؏أتضأثتشەأوۏڽأإځأڬۏأڬۏتأشتةەأۄەأآأڬۄأتڲشأوۏڽأتضۏأغشذأتۏوتىأهەأإحتأۄًڽأ؏أدضأغشذأإځأهًڲأتۏوتىأهتةەأۄۏڽأتًشأتضأغشذأؼوهأڬشحتأۄًڽأ؏أدضأغشذأإځأؼوهأڬشحەأۄۏڽأ؏أحًأڬۏتأوۏڽأدىحأوۏڽأإځأڬەأضتحہأۄًاڽأڲتأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۏأۄتڽأ$أ أځہشأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أدًأطرظأهتأتهۄأهتأتههۄأځڔہەأڲتأحًأتضأڬۏأًدۄأضەأتضأڬەأهۏەأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأتۏڬأؼۄزأۄًأڲتأتًشأدًأطرظأضثذتىأتههۄأځڔہەأڲتأحًأتههۄأحؼتهۏٳأتضأڬەأهۏەأتۏڬأهتڬہأىۏڬۏتڽأىًټأڬشەأڲتأ؏أتضأطرظأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أتضأڬەأثؼزأۄوأڬۏضەأۄهتڬحأڬتأطڬتشأۄًأضڬحەأۄۏڽأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتضأستحأڬۏأمضوأ$أدضأڬەأزضحأمزشحأوۏڽأوۏشۏأدتىأۄەأ؏أمۏتوحأڬەأزىأتۏڬأطرظأتۏضتأؼوهأهەأڬشأإةەأڲتأڬۄأتڲشأتضەأځۄتڔأځشأشڬہأزۏتأدتةەأحًأًۄأتضأڬًأثہۏأثًدہهأوذضًضأۄًأ؏أځہشأتههۄأحؼتهۏٳأڬۏأىؼوحًڽأوۏڽأضەأتۏڬأىؼوحأڬہڔۏأۄًأڲۏأتًشأحمشۏثتَأتضأضتشەأؼوهأڬًأرحوأڬشأزەأڲۏأ؏أتڲشأتههۄأحؼتهۏٳأىەأتځىۏأشذوحأڬتألعهأتضأځشأىۄأڬۏتأ؏أځہشأۏۄأإۏحأىتصهأۄًةۏأ=أ أ““أڬۏتأتىضتىأځشأتۏضتأصوتىۄأىۄۏڽأإۏتأدثأًۄأڬًةۏأمتثهأسڬشأډۏصأىۄۏڽأحہتأ111111‛‛ۗأ أۏۄأإۏحأۏۄتڽأحڬأۄەأ=““أتًشأدثأحوأتزہشأزۏڬہًأڲەأحًأحوأىؼوحۏڽأتًشأثڔۏأثتزطتۄۏأزۏڬہًأڲەأۗ‛‛ أتضأذثطۏأطرظأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أڬۏتأدىحأوۏڽأوۏشۏأإىڬہۏڽأثہۏأتضأغشذأزۏڬہۏڽأڲۏأآأدضأغشذأإځأڬۏأإىڬہۏڽأزۏڬہۏڽأڲۏأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۏأۄتڽأ$أًۄأذثطۏأطرظأشًىەأهڲتأ؏أۏۄتڽأحڬأڬۄأتضأڬتأتىحمتهأۄًأڲۏتأۗ أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأڬۄحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأزۏڬہتأڬۄأإځأىەأرًزأضەأمثشأوۏڽأتحتشتأۗ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأتۏًثأثىأؼحثۄأۄەأتًشأًۄأعؼۏلأۄەأ؏أتضأڬۏأڬوصًشأحًخۏمأڬۏأڲةۏأۄەأۗ"
"18436","أذعشحأًتخهۄأثىأتضمؼأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ"
"18437","جابر رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""سات آسمانوں میں qadam رکھنے کی جگہ، نہ شبر، نہ ہتھیلی کی جگہ ہے جہاں فرشتہ کھڑا ہو، یا فرشتہ رکوع کرے، یا فرشتہ سجدہ کرے، تو جب قیامت کا دن ہوگا تو سب مل کر کہیں گے: تیری پاکی، ہم نے تیری وہ عبادت نہیں کی جو تیری عبادت کا حق تھی، سوا اس کے کہ ہم نے تیری ساتھ کسی کو شریک نہیں بنایا۔"" اسے طبرانی نے اوسط میں روایت کیا ہے، اور اس میں عروہ بن مروان ہے۔ دارقطنی نے کہا: حدیث میں مضبوط نہیں ہے، اور اس کے باقی راوی صحیح کے راوی ہیں۔"
"18438","أذعشحأؼحثۄأثىأؼثزأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ"
"18439","معاذ بن جبل رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""اگر تم چاہو تو میں تمہیں بتا دوں کہ اللہ عزوجل مومنین سے قیامت کے دن سب سے پہلے کیا کہے گا، اور وہ سب سے پہلے کیا کہیں گے؟"" انہوں نے کہا: ""جی ہاں۔"" آپ نے فرمایا: ""اللہ عزوجل مومنین سے کہے گا: کیا تم مجھ سے ملنا پسند کرتے تھے؟ تو وہ کہیں گے: جی ہاں، ہمارے رب! تو وہ پوچھے گا: کیوں؟ تو وہ کہیں گے: ہم نے آپ کی رحمت اور معافی کی امید رکھی تھی۔ تو وہ فرمائے گا: تو میری رحمت تمہارے لئے واجب ہو گئی۔"" اسے طبرانی نے دو اسناد سے روایت کیا ہے، ان میں سے ایک حسن ہے۔"
"18440","أضۏزۄأؼتةطۄأظزۏمۄأشعۏأتههۄأؼىۄتأثۏتىأڬشحۏأۄۏڽأ=أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أڬۏتأمۏتوحأڬەأزىأڬًةۏأذثۏثأ؏أتځىەأذثۏثأڬًأۏتزأشڬہەأڲتأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتەأؼتةطۄأ$أدۄتڽأحڬأحۏىأومتوتحأڬتأحؼهمأۄەأحًأ+أًۄتڽأ,أىۄۏڽأ؏أوۏصتىأڬەأځتضأدثأحڬأًۄأثًدہهأۏتأۄهڬتأىۄۏڽأۄًأدتحتأحًأًۄتڽأىۄۏڽأ؏أدثأىتوۄأتؼوتهأزۏەأدتةۏڽأڲەأ؏أدًأۏتأزتةۏڽأۄتحہأوۏڽأزۏتأدتةەأڲتأۏتأثتةۏڽأۄتحہأوۏڽأزۏتأدتةەأڲتأ؏أحًأًۄتڽأىۄۏڽأ؏أتًشأدثأدۄىوأوۏڽأضەأتۏڬأڲشزىأىڬهەأڲۏأ؏أًۄأڲشزىأۏۄأڬۄەأڲۏأ=أودہەأحۏىأتلشتزأڬەأهةەأومششأڬۏتأڲۏتأۄەأ؏أودہەأحۏىأتلشتزأڬەأهةەأومششأڬۏتأڲۏتأۄەأ؏أودہەأتضأڬەأهۏەأومششأڬۏتأڲۏتأۄەأ؏أدًأتههۄأحؼتهۏٳأڬەأضتحہأڬضۏأزًضشەأوؼثًزأڬۏأؼثتزحأڬشحتأحہتأ؏أودہەأتضأڬەأهۏەأومششأڬۏتأڲۏتأۄەأدًأۏًوأذضتثأځشأتۏوتىأىۄۏڽأشڬہحتأحہتأ؏أتًشأودہەأۄشأػتهوأضشڬطأڬەأهةەأومششأڬۏتأڲۏتأۄەأ؏أځہشأًۄأتىۄۏڽأهځۏټأوۏڽأهەأڲۏأتًشأتىۄۏڽأدۄىوأڬۏأڲۄشتةۏأوۏڽأڋتهأزەأڲۏأ؏أدۄىوأځشأتۏڬأځهأۄًأڲتأدًأثتهأضەأصۏتزۄأثتشۏڬأتًشأحهًتشأضەأصۏتزۄأحۏصأۄًأڲتأ؏أتضأځشأإىڬڔەأتًشأڬىڋەأۄًڽأڲەأدضأڬەأثتشەأوۏڽأتههۄأڬًأوىػًشأۄًأڲتأًۄأتضەأځڬڔأهۏڽأڲەأ؏أڬډہأهًڲأتضأځهأځشأضەأۏًڽأڲصشۏڽأڲەأدۏضەأځهڬأدہځڬىتأۄًحتأۄەأ؏أدۏضەأثدهۏأۄًحۏأۄەأ؏أدۏضەأۄًتأۄًحۏأۄەأ؏أدۏضەأحشثۏحأۏتلحۄأڲہًڔتأۄًحتأۄەأ؏أدۏضەأضًتشأۄًحتأۄەأ+أۏؼىۏأًۄأهًڲأورحهلأمضو"
"18441","أذعشحأتثًثڬشۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأهًڲًڽأڬًأځهأظشتغأځشأهتۏتأدتةەأڲتأتًشأتضأځهأڬەأزًىًڽأځۄهًأتىأهًڲًڽأڬًأىۏډەأڲشتةۏڽأڲەأدضأغشذأځحىڲەأإڲأوۏڽأڲشحەأۄۏڽأ؏أتههۄأحؼتهۏٳأدضأڬەأثتشەأوۏڽأډتۄەأڲتأتځىۏأشذوحأڬەأًضۏهەأضەأتضەأىدتحأؼغتأڬشأزەأڲتأۗأ"
"18442","عبداللہ بن عمرو رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""میری امت کا نشانہ جب وہ صراط پر چڑھیں گے: یا لا الہ الا انت۔"" اسے طبرانی نے کبیر اور اوسط میں روایت کیا ہے، اور اس میں ایک راوی ہے جسے ضعف کے باوجود معتبر قرار دیا گیا ہے، اور عبدوس بن محمد کو میں نہیں جانتا۔"
"18443","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أثەأطڬأتههۄأحؼتهۏٳأمۏتوحأڬەأزىأهًڲًڽأڬًأتىأڬەأىتوًڽأڬەأذًتهەأضەأثهتةەأڲتأتًشأۏۄأتضأڬۏأغشلأضەأتځىەأثىزًڽأڬەأهةەأځشزەأڬەأضتحہأۄًأڲتأهۏڬىأدۄتڽأحڬأځهأظشتغأڬەأځتضأڬتأوؼتوهۄأۄەأحًأًۄتڽأتههۄأحؼتهۏٳأۄشأوًوىأوشزأڬًأىًشأؼغتأڬشەأڲتأتًشأۄشأوًوىأؼًشحأڬًأىًشأؼغتأڬشەأڲتأتًشأۄشأوىتلمأڬًأىًشأؼغتأڬشەأڲتأ؏أهۏڬىأدثأًۄأهًڲأځهأظشتغأځش"
"18444","حضرت عبداللہ بن مسعود رضی اللہ عنہ فرماتے ہیں : """" پل صراط کو جہنم کے اوپر رکھا جائے گا جو تلوار کی دھار سے زیادہ باریک اور تیز ہو گا ، پرے کرنے والا اور پھسلانے والا ہو گا ، اس پر آگ کے بنے ہوئے آنکڑے ہوں گے جو اچک لیں گے ، تو پکڑنے والا اس میں گرے گا اور پچھاڑا گیا ہو گا ، ان میں سے کوئی برق کی مانند گزرے گا ، پھر جیسے ہوا ہوتی ہے ، پھر گھوڑے کے دوڑنے کی مانند ، پھر آدمی کے دوڑنے کی مانند ، پھر آدمی کے تیزی سے چلنے کی مانند ، پھر آدمی کے چلنے کی مانند ، پھر ان کے آخر میں ایسا انسان ہو گا جس پر جہنم واجب ہو چکی ہو گی ، وہ جہنم میں بری صورتحال کا سامنا کر چکا ہو گا ، یہاں تک کہ اللہ تعالیٰ اپنی رحمت کے فضل کے ذریعے اسے جنت میں داخل کر دے گا تو اْسے کہا جائے گا : تم آرزو کرو اور مانگو ! وہ کہے گا : اے میرے پروردگار ! کیا تو میرا مذاق اڑا رہا ہے ء جبکہ تو رب العزت ہے ، تو اسے کہا جائے گا : تم آرزو کرو اور مانگو ! ( وہ شخص مانگنا شروع کرے گا ) یہاں تک کہ جب اس کی تمام آرزوئیں ختم ہو جائیں گی تو اْس سے کہا جائے گا : تم نے جو مانگا وہ تمہیں ملتا ہے اور اس کے ہمراہ اس کی مانند مزید ملتا ہے ۔"""""
"18445","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأڬۏأىمهأڬشزۄأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=أ أ““أتضأڬەأۄوشتۄأتضأڬۏأوتىىزأوصۏزأزضأڲىتأوهحتأۄەأۗ‛‛"
"18446","أذعشحأۏؼهۏٳأثىأوىثۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ="
"18447","أتثًضوۏىۄأثۏتىأڬشحەأۄۏڽأ=أۄوتشەأزشوۏتىأ““أًشًزأ‛‛أڬەأثتشەأوۏڽأترحهتلأۄًأڲۏتأ؏أۄوأوۏڽأضەأڬډہأڬتأۏۄأڬۄىتأحہتأڬۄأوًوىأدۄىوأوۏڽأزترهأىۄۏڽأۄًأڲتأتًشأڬډہأڬتأۏۄأڬۄىتأحہتأ+أڬتلشأتًشأوًوىأ,أضثأتضأوۏڽأزترهأۄًڽأڲەأ؏أځہشأتههۄأحؼتهۏٳأځشۄۏصڲتشأهًڲًڽأڬًأىدتحأؼغتأڬشأزەأڲتأشتًۏأڬۄحەأۄۏڽأ=أوۏشۏأوهتمتحأذعشحأدتثشأشعۏأتههۄأؼىۄأثىأؼثزتههۄأشعۏأتههۄأؼىۄأضەأۄًةۏأ؏أوۏڽأىەأڬۄتأ=أۄوتشەأزشوۏتىأ““أًشًزأ‛‛أڬەأثتشەأوۏڽأترحهتلأۄًأڲۏتأۄەأ؏أتىۄًڽأىەألشوتۏتأ=أضثأهًڲأتضأځشأًتشزأۄًڽأڲەأ؏أوۏڽأىەأتىأضەأڬۄتأ=أۄوتشەأزشوۏتىأتضأثتشەأوۏڽأترحهتلأۄەأ؏أۄوأوۏڽأضەأڬډہأڬتأۏۄأڬۄىتأۄەأ=أوًوىأتضأوۏڽأزترهأىۄۏڽأۄًأڲتأتًشأڬډہأڬتأۏۄأڬۄىتأۄەأ=أ+أڬتلشأتًشأوًوىأ,أضثأتضأوۏڽأزترهأۄًڽأڲەأ؏أحًأذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتأىەأتځىۏأزًأتىڲهۏتڽأتځىەأزًىًڽأڬتىًڽأڬۏأغشلأثڔہتةۏڽأتًشألشوتۏتأ=أۏۄأزًىًڽأثۄشەأۄًأدتةۏڽأتڲشأوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأىۄأضىتأۄًأ="
"18448","أذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أوۏشۏأتوحأڬەأهۏەأدۄىوأڬۏأحځطأۏًڽأۄًأڲۏأ؏أدۏضەأذوتوأڬۏأحځطأۄًحۏأۄەأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأوذوزأثىأؼوشأًتمزۏأۄەأتًشأًۄأتىحۄتةۏأعؼۏلأۄەأۗ"
"18449","أذعشحأتثًتوتوۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أدۄىوأځشأتۏڬأتۏضتأزىأإةەأڲتأدثأًۄأڬہۏحۏأڬۏأغشذأۄًأڲۏأ؏أًۄأذشڬحأڬشەأڲۏأتًشأضشرأۄًأڲۏأتًشأتضأڬەأزشًتصەأثدأشۄەأۄًڽأڲەأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأدؼلشأثىأصثۏشأۄەأتًشأًۄأعؼۏلأۄەأۗ"
"18450","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أإځأ﷽أىەأتشطتزألشوتۏتأ=أودہەأ+أذًعأ,أڬًخشأؼغتأڬشأزۏتأڲۏتأۄەأ؏أوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أڬًخشأڬۏتأۄەأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أدىحأوۏڽأتۏڬأىۄشأۄەأدضأڬۏأډًڔتةۏأتًشأهوثتةۏأتحىۏأۄەأدحىتأوطشمأتًشأوؽشثأڬەأزشوۏتىألتظهۄأۄەأ؏أتضأوۏڽأضەأدًأطرظأځۏأهەأڲتأًۄأثؼزأوۏڽأڬثہۏأځۏتضتأىۄۏڽأۄًأڲتأتًشأتضأوۏڽأضەأدًأطرظأًعًأڬشأهەأڲتأًۄأثؼزأوۏڽأڬثہۏأوۏهتأىۄۏڽأۄًأڲتأ؏أهۏڬىأتضەأڬًةۏأتۏضتأطرظأىۄۏڽأځۏەأڲتأ؏أدضأىەأوۏشۏأزۏأۄًةۏأځىتۄأڬەأرهتلأًشصۏأڬۏأۄًأ؏أۏتأوۏشەأتۄهأثۏحأڬًأمحهأڬۏتأۄًأۗ‛‛"
"18451","انس رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""میرا حوض اس جگہ سے اس جگہ تک ہے، اس میں برتن تاروں کی تعداد کے ہیں، وہ مشک سے زیادہ خوشبو دار ہیں، شہد سے زیادہ میٹھی ہیں، برف سے زیادہ ٹھنڈے ہیں، دودھ سے زیادہ سفید ہیں، جس نے اس سے ایک گھونٹ پی لیا وہ کبھی پیاسا نہ ہوگا۔"" میں نے کہا: یہ صحیح میں مختصراً موجود ہے۔ اسے بزار اور طبرانی نے اوسط میں روایت کیا ہے، اور اس میں مسعودی ہے، جو قابل اعتماد ہے، لیکن وہ گڈ مڈ ہو گیا تھا، اور ان دونوں کے باقی راوی صحیح کے راوی ہیں۔"
"18452","أذعشحأتىضأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ"
"18453","ابو سعید خدری رضی اللہ عنہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""میرا ایک دریا ہے جو صنعاء سے ایلہ تک ہے، اس میں تاروں کی تعداد کے برتن ہیں، اور وہ برف سے زیادہ ٹھنڈا ہے، شہد سے زیادہ میٹھا ہے، دودھ سے زیادہ سفید ہے، جس نے اس سے ایک گھونٹ پی لیا وہ اس کے بعد کبھی پیاسا نہ ہوگا، اور جس نے اسے نہیں چکھا وہ کبھی سیراب نہ ہوگا۔"" اسے طبرانی نے اوسط میں روایت کیا ہے، اور اس میں محمد بن عبیداللہ العرزمی ہے، جو متروک (چھوڑا ہوا) ہے۔"
"18454","أؼثزتههۄأثىأثشۏزۄأثۏتىأڬشحەأۄۏڽأ=أؼثۏزأثىأصۏتزأڬًأذًعأڬًخشأڬەأثتشەأوۏڽأطڬأۄًتأ؏أتضأىەأذعشحأصۏزأثىأتشموأشعۏأتههۄأؼىۄأڬۏأغشلأځۏؽتوأثہۏدتأتًشأتىأضەأذًعأڬەأثتشەأوۏڽأزشۏتلحأڬۏتأحًأتىۄًڽأىەأتضەأتضأڬەأثتشەأوۏڽأذزۏخأثۏتىأڬۏأ؏أدًأتضأڬًأتډہۏأهڲۏأ؏أتضأىەأزشۏتلحأڬۏتأ=أڬۏتأإځأىەأرًزأىثۏأتڬشوأ﷽أڬۏأصثتىۏأۏۄأثتحأضىۏأۄەأآأتىۄًڽأىەألشوتۏتأ=أدۏأىۄۏڽأ$أثهڬۄأوۏشەأثہتةۏأىەأودہەأۏۄأذزۏخأثۏتىأڬۏأۄەأۗأ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗأ"
"18455","أۏذىضأثۏتىأڬشحەأۄۏڽأ=أذعشحأذوصيأثىأؼثزتهوغهثأشعۏأتههۄأؼىۄأدثأوزۏىۄأوىًشۄأحطشۏلأهتةەأحًأتىۄًڽأىەأضۏزۄأرًهۄأثىحأمۏضأثىألۄزأتىظتشۏۄأشعۏأتههۄأؼىۄتأڬەأضتحہأطتزۏأڬشأهۏأ؏أدًأثىًأىدتشأضەأحؼهمأشڬہحۏأحہۏڽأ؏أىثۏأتڬشوأ﷽أذعشحأذوصۄأشعۏأتههۄأؼىۄأڬەأڲہشأتىأضەأوهىەأڬەأهۏەأحطشۏلأهەأدتۏتأڬشحەأحہەأ؏أحًأتضأرتحًىأىەأىثۏأتڬشوأ﷽أڬەأذًتهەأضەأتذتزۏخأشًتۏحأڬۏأۄۏڽأ؏أًۄأرتحًىأثۏتىأڬشحۏأۄۏڽأ=أتۏڬأوشحثۄأىثۏأتڬشوأ﷽أۄوتشەأۄتڽأحطشۏلأهتةەأحًأوۏڽأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأڬەأثتشەأوۏڽأودہەأۏۄأثتحأځحۄأډهۏأۄەأڬۄأإځأىەأۏۄأثتحأثۏتىأڬۏأۄەأ=أمۏتوحأڬەأزىأإځأڬتأتۏڬأذًعأۄًأڲتأدًألهتڽأدڲۄأضەأهەأڬشألهتڽأدڲۄأدحىتأثڔتأۄًأڲتأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۏأۄتڽأ$أتًشأوۏشەأىصزۏڬأتضأوۏڽأضەأضۏشتثأۄًىەأڬەأذًتهەأضەأهًڲًڽأوۏڽأضثأضەأصۏتزۄأوذثًثأحوۄتشۏأمًوأۄەأۗ أًۄأرتحًىأثۏتىأڬشحۏأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأتۏڬأۄىڋۏتأځۏطأڬۏأ؏أدضأوۏڽأرثصۄأۏتأرصۏشۄأىتوۏأضتهىأحہتأۗأۏۄأطڬأشتًۏأڬًأۄەأۗأىثۏأتڬشوأ﷽أىەأتځىەأزضحأوثتشڬأۄىڋۏتأځشأشڬہتأحتڬۄأڬہتةۏڽأ؏أحًأإځأڬۏأتىڲهۏتڽأدهأڲةۏڽأ؏أإځأىەألشوتۏتأ=أتًۄأ؏أځہشأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتىضتىأڬًأدثأڬًةۏأډۏصأټہىڋۏأهڲحۏأۄەأحًأًۄأځہشأثہۏأًۄأڬۄحتأۄەأ““أتًۄأ‛‛أدثأتضەأڲشوأډۏصأهڲحۏأۄەأحًأځہشأثہۏأًۄأ†أتًۄأ‛‛أڬۄحتأۄەأۗ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتضەأتوتوأغثشتىۏأىەأترحظتشأڬەأضتحہأىمهأڬۏتأۄەأتىۄًڽأىەأۏۄأتهلتػأىمهأڬةەأۄۏڽأ=أإځأىەألشوتۏتأ=أ أ““أوۏشەأىصزۏڬأهًڲًڽأوۏڽأضثأضەأصۏتزۄأوذثًثأۗأشتًۏأڬًأطڬأۄەأ؏أۏتأطتۏزأۏۄأتهلتػأۄۏڽأ=أتضأځشأًتشزأۄًىەأڬەأذًتهەأضەأهًڲًڽأوۏڽأوۏشەأىصزۏڬأوذثًثأحشۏىأ11111‛‛ۗ أتًشأتضأشًتۏحأوۏڽأتىۄًڽأىەأۏۄأتهلتػأىمهأڬةەأۄۏڽأ=أتضأرتحًىأىەأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأ““أؼظۏزۄأ‛‛أځۏطأڬۏتأۗ أتوتوأتذوزأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18456","أضۏزيأرًهۄأثىحأذڬۏوأشعۏأتههۄأؼىۄتأثۏتىأڬشحۏأۄۏڽأ=أوۏڽأىەأزشۏتلحأڬۏتأ=أۏتأشضًهأتههۄأ$أڬۏتأإځأڬتأذًعأۄًأڲتأآأىۄۏڽأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۏأۄتڽأ$أتًشأًۄتڽأإىەأڬەأذًتهەأضەأوۏشەأىصزۏڬأضثأضەأصۏتزۄأوذثًثأحوۄتشۏأمًوأۄەأۗ أۏۄأشًتۏحأتوتوأتذوزأتًشأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتىۄًڽأىەأۏۄأثتحأثۏتىأڬۏأۄەأ=أتثًرتهزأتذوزأىەأتضەأتضۏأغشذأضۏزۄأرًهۄأثىحأذڬۏوأشعۏأتههۄأؼىۄتأڬەأذًتهەأضەأىمهأڬۏتأۄەأ؏أدثڬۄأزۏڲشأهًڲًڽأڬتأۏۄأڬۄىتأۄەأ=أۏۄأضۏزۄأرًهۄأثىحأمۏضأشعۏأتههۄأؼىۄتأڬەأذًتهەأضەأوىمًهأۄەأ؏أتىأزًىًڽأشًتۏتحأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18457","أذعشحأؼثزتههۄأثىأوضؼًزأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوهۏڬۄأڬەأزًأظتذثصتزەأ؏أىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًةەأ؏أتىأزًىًڽأىەأؼشعأڬۏأ=أۄوتشۏأًتهزۄأطًۄشأڬتأتذحشتوأڬشحۏأحہۏأ؏أثډًڽأځشأوۄشثتىأحہۏأ؏أوۄوتىأىًتصۏأڬۏتأڬشحۏأحہۏأ؏أحتۄوأتىۄًڽأىەأصوتىۄأدتۄهۏحأوۏڽأصىزۄأزشڲًشأڬۏتأحہتأ+أۏتأطتۏزأۏۄأوشتزأۄەأڬۄأتضأڬتأتىحمتهأصوتىۄأدتۄهۏحأوۏڽأۄًأڲۏتأحہتأ,أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أحوأزًىًڽأڬۏأوتڽأدۄىوأوۏڽأدتةەأڲۏأ؏أًۄأزًىًڽأًتځضأډهەأڲةەأ؏أتىأڬەأډۄشەأضەأځشۏطتىۏأڬتأتػۄتشأۄًأشۄتأحہتأ؏أىثۏأتڬشوأ﷽أىەأتىأزًىًڽأڬەأثتشەأوۏڽأذڬوأزۏتأحًأتىۄۏڽأًتځضأثهتۏتأڲۏتأ؏أًۄأزًىًڽأًتځضأإةەأحًأتىأڬەأډۄشەأضەأرًطۏأڬەأإختشأوذضًضأۄًأشۄەأحہەأ؏أتىۄۏڽأتوۏزأحہۏأڬۄأطتۏزأتضأثتشەأوۏڽأڬًةۏأىۏتأذڬوأإأڲۏتأۄەأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أوۏشۏأوتڽأثہۏأ؏أحوأزًىًڽأڬۏأوتڽأڬەأضتحہأۄًأڲۏأۗأ"
"18458","أذعشحأتثًتوتوۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أثەأطڬأتههۄأحؼتهۏٳأىەأوۏشەأضتحہأۏۄأًؼزۄأڬۏتأۄەأڬۄأًۄأوۏشۏأتوحأڬەأضحشأۄصتشأتلشتزأڬًأڬضۏأذضتثأڬەأثؽۏشأدىحأوۏڽأزترهأڬشەأڲتأۗ‛‛"
"18459","أذعشحأتضتوۄأثىأصۏزأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأ=أتۏڬأزىأىثۏأتڬشوأ﷽أذعشحأذوصۄأثىأؼثزتهوغهثأشعۏأتههۄأؼىۄأڬەأۄتڽأحطشۏلأهتةەأ؏أإځأىەأتىۄۏڽأ+أڲہشأوۏڽأ,أىۄۏڽأځتۏتأ؏أإځأىەأتىأڬۏأتۄهۏۄأضەأتىأڬەأثتشەأوۏڽأزشۏتلحأڬۏتأ؏أتضأرتحًىأڬتأحؼهمأثىًأىدتشأضەأحہتأ؏أتضأرتحًىأىەأثحتۏتأ=أوۏشەأًتهزأإځأځشأمشثتىأۄًڽأ؏أًۄأإځأڬۏأغشلأدتىەأڬەأهةەأۄۏأىڬهەأحہەأ؏أۄًأضڬحتأۄەأثىًأىدتشأڬۏأڬضۏأڲهۏأوۏڽأتىأڬتأإځأضەأضتوىتأىۄأۄًأځتۏتأۄًأ؏أۏتأشضًهأتههۄأ$أإځأتىزشأڬۏًڽأىۄۏڽأحطشۏلأهتحەأآأىثۏأتڬشوأ﷽أتىزشأحطشۏلأهەأڲةەأ؏أتضأرتحًىأىەأإځأڬۏأرزوحأوۏڽأ““أذۏضأ‛‛أځۏطأڬۏتأ؏أىثۏأتڬشوأ﷽أىەأتضأوۏڽأضەأڬہتۏتأ؏أتضأرتحًىأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأڬًأثۄحأ؏أثۄحأوثتشڬأۄًأ؏أإځأحطشۏلأهەأإةەأۄۏڽأ؏أًشىۄأوۏشتأإځأڬۏأرزوحأوۏڽأذتعشأۄًىەأڬتأتًشأإځأڬًأوثتشڬثتزأځۏطأڬشىەأڬتأتشتزۄأحہتأ؏أذعشحأتثًؼوتشۄأشعۏأتههۄأؼىۄأ+أۏؼىۏأذعشحأذوصۄأثىأؼثزتهوغهثأشعۏأتههۄأؼىۄأ,أىەأودہەأثحتۏتأۄەأڬۄأإځأڬًأدىحأوۏڽأتۏڬأىۄشأزۏأڲةۏأۄەأ؏أدضأڬتأىتوأڬًخشأۄەأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أدۏأۄتڽأ$أتضأڬۏأصوۏىأ+أۏتأتضأڬەأڬىتشەأڬۏأصوۏىأ,أۏتمًحأ؏أوشدتىأ؏أصثشدزأتًشأوًحۏًڽأڬۏأۄەأ؏أتضأرتحًىأىەأؼشعأڬۏأ=أوۏشۏأۏۄأرًتۄطأۄەأڬۄأإځأتځىەأذًعأڬۏأظلحأوۏشەأضتوىەأۏًڽأثۏتىأڬشۏڽأڬۄأوۏڽأًۄأإځأضەأضىأهًڽأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ="
"18460","حضرت حذیفہ بن اسید غفاری رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" اے لوگو ! میں تمہارا پیشرو ہواں گا اور تم حوض پر میرے پاس آا گے ، میرا حوض اتنا بڑا ہے جتنا صنعاؤ اور بصریٰ کے درمیان فاصلہ ہے ، اس کے پاس ستاروں کی تعداد میں چاندی اور سونے کے بنے ہوئے پیالے ہیں ، جب تم میرے پاس آا گے تو میں تم سے دو چیزوں کے بارے میں دریافت کروں گا ، تو تم لوگ اس بات کا دھیان رکھنا کہ میرے بعد تم ان دونوں کے بارے میں کیا کرتے ہو ء بڑا سبب اللہ کی کتاب ہے جس کا ایک کنارہ اللہ تعالیٰ کے ہاتھ میں ہے اور ایک کنارہ تمہارے ہاتھ میں ہے ، تو تم اس کو مضبوطی سے تھام کے رکھنا ، تم گمراہ نہ ہونا اور تم تبدیلی نہ کرنا ( اور دوسری چیز ) میری عترت ، میرے اہل بیت ہیں ، کیونکہ علم رکھنے والی اور خبر رکھنے والی ذات نے مجھے یہ بات بتائی ہے ، یہ دونوں ختم نہیں ہوں گے ، یہاں تک کہ یہ دونوں حوض پر میرے پاس آ جائیں گے ۔"""" یہ روایت امام طبرانی نے دو اسناد کے ساتھ نقل کیا ہے ان دونوں میں ایک راوی زید بن حسن انماطی ہے جسے ابن حبان نے ثقہ قرار دیا ہے اور ابوحاتم نے اسے ضعیف کہا ہے ان دونوں میں سے ایک کے بقیہ رجال صحیح کے رجال ہیں اور دوسری کے بھی اسی طرح ہیں ، صرف نصر بن عبدالرحمن کا معاملہ مختلف ہے ، اگر اللہ نے چاہا تو وہ بھی ثقہ ہو گا ۔"
"18461","سمُره بن جندب سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""انبیاء اپنی امتوں کے ساتھیوں کی تعداد پر فخر کرتے ہیں کہ ان میں سے کس کے سب سے زیادہ ساتھی ہیں، تو مجھے امید ہے کہ اس دن میں ان سب میں سب سے زیادہ لوگ میرے حوض پر وارد ہوں گے، اور ان میں سے ہر شخص اس دن اپنے بھرے ہوئے حوض پر کھڑا ہوگا، اس کے ہاتھ میں ایک عصا ہوگی جس سے وہ اپنی امت کے لوگوں کو پہچان کر بلائے گا، اور ہر امت کی ایک نشانی ہوگی جس سے ان کا نبی انہیں پہچانے گا۔"" اسے طبرانی نے روایہ کیا ہے، اور اس میں مروان بن جعفر سمری شامل ہیں، ابن ابی حاتم نے انہیں معتبر قرار دیا ہے، اور ازدی نے کہا: لوگ ان میں نقص بتاتے ہیں، اور اس کے باقی رواة معتبر ہیں۔"
"18462","أذعشحأضۄهأثىأضؼزأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أوۏڽأذًعأځشأحوۄتشتأځۏطشًأۄًاڽأڲتأ؏أدًأطرظأوۏشەأځتضأإأدتةەأڲتأتًشأځۏأهەأڲتأًۄأڬثہۏأځۏتضتأىۄۏڽأۄًأڲتأ؏أرثشزتشأ$أوۏشەأضتوىەأڬډہأتۏضەأهًڲأإةۏڽأڲەأ؏أدىۄۏڽأوۏڽأځۄډتىًڽأڲتأهۏڬىأځہشأوۏشەأتًشأتىأڬەأزشوۏتىأشڬتًټأإأدتةەأڲۏأۗ‛‛"
"18463","أتىأ+أۏؼىۏأذعشحأضۄهأثىأضؼزأشعۏأتههۄأؼىۄأ,أڬەأذًتهەأضەأۏۄأشًتۏحأوىمًهأۄەأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أۄشأىثۏأځۏطشًأۄًأڲتأتًشأوۏڽأذًعأځشأحوۄتشتأځۏطشًأۄًاڽأڲتأ؏أدًأطرظأذًعأځشأوۏشەأځتضأإأدتةەأڲتأتًشأځۏأهەأڲتأتضەأځۏتضأىۄۏڽأهڲەأڲۏأتًشأدضەأځۏتضأىۄۏڽأهڲەأڲۏأًۄأدىحأوۏڽأزترهأۄًأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأوًضۏٳأثىأۏؼمًثأصوؼۏأڬتأوؼتوهۄأورحهلأۄەأ؏أتۏڬأضەأصۏتزۄأتلشتزأىەأتضەأخمۄأمشتشأزۏتأۄەأتًشأتضأوۏڽأعؼلأځتۏتأدتحتأۄەأۗ"
"18464","أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ= أ““أهًڲًڽأڬتأڬۏتأوؼتوهۄأۄەأآأدًأۏۄأڬۄحەأۄۏڽأ=أتههۄأڬەأشضًهأ﷽أڬۏأشطحۄأزتشۏأتْىأڬۏأمًوأڬًأىلؼأىۄۏڽأزەأڲۏأ؏أدۏأۄتڽأ$أتههۄأڬۏأمضوأ$أوۏشەأضتحہأشطحۄأزتشۏأڬتأحؼهمأ؏أزىۏتأتًشأإرشحأوۏڽأدڔتأشۄەأڲتأتًشأتەأهًڲًأ$أثۏطڬأوۏڽأذًعأځشأحوۄتشتأځۏطشًأۄًاڽأڲتأ؏أدثأحوأهًڲأإاأڲەأحًأڬًةۏأطرظأۏۄأڬۄەأڲتأ=أۏتأشضًهأتههۄأ$أوۏڽألهتڽأثىألهتڽأۄًڽأ؏أڬًةۏأزًضشتأۏۄأڬۄەأڲتأ=أوۏڽألهتڽأثىألهتڽأۄًڽأ؏أحًأوۏڽأۏۄأڬۄًڽأڲتأ=أدۄتڽأحڬأىضثأڬتأحؼهمأۄەأحًأتضأڬًأوۏڽأىەأدتىأهۏتأۄەأهۏڬىأحوأهًڲًڽأىەأوۏشەأثؼزأىةۏأډۏصأځۏزتأڬۏأتًشأتْهټەأمزوًڽأځہشأڲةەأۗ‛‛أ أۏۄأشًتۏحأتوتوأتثًۏؼهۏٳأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأؼثزتههۄأثىأوذوزأثىأؼمۏهأڬتأوؼتوهۄأورحهلأۄەأتًشأتضأڬۏأحًخۏمأڬۏأڲةۏأۄەأۗ"
"18465","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ أ““أوۏڽأذًعأځشأحوۄتشتأځۏطشًأۄًاڽأڲتأ؏أدًأطرظأتضأځشأًتشزأۄًأڲتأ؏أًۄأڬتوۏتثأۄًأدتةەأڲتأ؏أڬډہأهًڲًڽأڬًأهتۏتأدتةەأڲتأ؏أځہشأتىۄۏڽأځڬڔأڬشأثتةۏڽأغشلأهەأدتۏتأدتةەأڲتأ؏أحًأوۏڽأڬۄًڽأڲتأ=أتەأوۏشەأځشًشزڲتشأ$أحًأۏۄأڬۄتأدتةەأڲتأ=أۏۄأهًڲأحوۄتشەأثؼزأتۏڔۏًڽأڬەأثهأوشحزأۄًأڲةەأحہەأۗ‛‛ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتوتوأغثشتىۏأىەأوؼدوأڬثۏشأتًشأوؼدوأتًضغأوۏڽأتضأڬۏأوتىىزأىمهأڬۏأۄەأ؏أحتۄوأتىۄًڽأىەأتضأڬەأإؽتصأوۏڽأۏۄأتهلتػأىمهأڬةەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ"
"18466","أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أوۏڽأذًعأځشأوًدًزأۄًاڽأڲتأتًشأتضأثتحأڬتأدتةصۄأهًڽأڲتأڬۄأڬًىأوۏشەأځتضأإحتأۄەأآأ"
"18467","أتىأ+أۏؼىۏأذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄأ,أڬەأذًتهەأضەأۏۄأثتحأوىمًهأۄەأ=أتىۄًڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ="
"18468","أذعشحأضوشۄأثىأدىزثأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أڬډہأهًڲأوۏشەأضتوىەأإةۏڽأڲەأدًأوۏشەأضتحہأحہەأ؏أدثأتىأڬەأضشأوۏشەأضتوىەأإةۏڽأڲەأحًأتىۄۏڽأودہأضەأځۄهەأۄۏأشًڬأهۏتأدتةەأڲتأ؏أوۏڽأڬۄًڽأڲتأ=أتەأوۏشەأځشًشزڲتشأ$أوۏشەأضتحہۏأ؏أوۏشەأضتحہۏأ؏أحًأڬۄتأدتةەأڲتأ=أحوأىۄۏڽأدتىحەأ؏أحوۄتشەأثؼزأتىۄًڽأىەأڬۏتأىۏتأڬتوأڬۏتأحہتأآ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأڬثۏشأتًشأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأ؏أتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأذڬوأثىأؼثزتهوهڬأۄەأتًشأًۄأعؼۏلأۄەأۗ"
"18469","أذعشحأتثًثڬشۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أذًعأځشأوۏشەأضتوىەأڬډہأتۏضەأهًڲأإةۏڽأڲەأدًأوۏشەأضتحہأشۄەأتًشأتىۄًڽأىەأودہەأزۏڬہتأ؏أۏۄتڽأحڬأڬۄأدثأًۄأوۏشەأضتوىەأإةۏڽأڲەأتًشأوۏڽأتىۄۏڽأزۏڬہًڽأڲتأحًأتىۄۏڽأودہأضەأځۄهەأۄۏأشًڬأهۏتأدتةەأڲتأ؏أوۏڽأۏۄأعشًشأڬۄًڽأڲتأ=أتەأوۏشەأځشًشزڲتشأ$أوۏشەأضتحہۏأ؏أوۏشەأضتحہۏأ؏أحًأۏۄأڬۄتأدتةەأڲتأ=أحوأىۄۏڽأدتىحەأ؏أحوۄتشەأثؼزأتىۄًڽأىەأڬۏتأىۏتأڬتوأڬۏتأحہتأۗ‛‛ أۏۄأشًتۏحأتوتوأتذوزأىەأزًأتضىتزأڬەأضتحہأىمهأڬۏأۄەأتىأزًىًڽأوۏڽأضەأتۏڬأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأؼهۏأثىأصۏزأڬتأوؼتوهۄأورحهلأۄەأتضأوۏڽأوًدًزأعؼلأڬەأثتًدًزأتضأڬۏأحًخۏمأڬۏأڲةۏأۄەأ؏أۏۄأشًتۏحأتوتوأغثشتىۏأىەأورحهلأتضتىۏزأڬەأضتحہأىمهأڬۏأۄەأتًشأتىأوۏڽأضەأتۏڬأڬەأشدتهأتوتوأتذوزأڬەأشدتهأڬۏأوتىىزأۄۏڽأۗ"
"18470","أذعشحأتثًزشزتؤأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أوۏڽأۏۄأظًشحذتهأىۄأځتاڽأڬۄأحوأوۏڽأضەأڬضۏأتۏڬأڬًأذًعأځشأوۏشەأځتضأىۄأإىەأزۏتأدتةەأتًشأوۏڽأۏۄأڬۄًڽأڬۄأۏۄأحًأوۏشەأضتحہۏًڽأضەأحؼهمأشڬہىەأًتهەأهًڲأۄۏڽأ؏أحًأۏۄأڬۄتأدتةەأ=أإځأىۄۏڽأدتىحەأ؏أإځأڬەأثؼزأتىۄًڽأىەأڬۏتأىۏتأڬتوأڬۏتأحہتأۗ‛‛أ أذعشحأتثًزشزتؤأشعۏأتههۄأؼىۄأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأتههۄأحؼتهۏٳأضەأۏۄأزؼتأڬۏدةەأڬۄأًۄأودہەأتْىأوۏڽأىۄأثىتةەأ؏أحًأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أحوأتْىأوۏڽأضەأىۄۏڽأۄًأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأزًأتضىتزأڬەأضتحہأىمهأڬۏأۄەأتىأزًىًڽأوۏڽأضەأتۏڬأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأتثًؼثزتههۄأتطؼشۏأڬتأوؼتوهۄأورحهلأۄەأتًشأًۄأخمۄأۄەأۗ"
"18471","أذعشحأتثًوضؼًزأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أوۏشەأضتحہۏًڽأوۏڽأضەأڬډہأهًڲأوۏشەأضتوىەأإةۏڽأڲەأ؏أۏۄتڽأحڬأڬۄأدثأوۏڽأتىۄۏڽأزۏڬہًڽأڲتأحًأتىۄۏڽأودہأضەأځۄهەأۄۏأشًڬأهۏتأدتةەأڲتأ؏أوۏڽأڬۄًڽأڲتأ=أۏۄأوۏشەأضتحہۏأۄۏڽأ؏أحًأۏۄأڬۄتأدتةەأڲتأ=أإځأىۄۏڽأدتىحەأإځأڬەأثؼزأتىۄًڽأىەأڬۏتأىۏتأڬتوأڬۏتأحہتأآ‛‛ۗأ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18472","أذعشحأدتثشأثىأؼثزتههۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أوۏڽأذًعأځشأحوۄتشتأځۏطشًأۄًاڽأڲتأتًشأوۏڽأزًضشۏأتوحًڽأڬەأومتثهەأوۏڽأحوۄتشۏأڬخشحأځشألرشأڬشًڽأڲتأ؏أحًأحوأوۏشەأثؼزأڬتلشأىۄأۄًأدتىتأڬۄأتۏڬأزًضشەأڬۏأڲشزىۏڽأوتشحەأځہشًأۗ‛‛أ"
"18473","ألشصزمأثۏتىأڬشحەأۄۏڽأ=أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىەأودہأضەألشوتۏتأ=أتەألشصزمأ$أوۏڽأزۏڬہأشۄتأۄًڽأڬۄأحوۄتشەأځتاڽأډہًټەأۄۏڽأ؏أتڲشأحوۄتشەأهۏەأۏۄأووڬىأۄًأڬۄأذًعأڬەأځتضأتىأزًىًڽأڬەأهۏەأڬًةۏأدڲۄأثىتأضڬحەأۄًأ؏أحًأحوأتۏضتأڬشأهۏىتأ؏أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ= أ““أوۏشتأذًعأ؏أؼوتىأتًشأتۏهۄأڬەأزشوۏتىألتظهەأدحىتأۄەأ؏أتضأڬتأځتىۏأزًزہأضەأصۏتزۄأضلۏزأ؏أطۄزأضەأصۏتزۄأوۏټہتأۄەأ؏أتضأڬەأثشحىأإضوتىأڬەأضحتشًڽأڬۏأحؼزتزأدحىەأۄۏڽأ؏أدًأطرظأتضأوۏڽأضەأځۏأهەأڲتأًۄأڬثہۏأځۏتضتأىۄۏڽأۄًأڲتأۗ‛‛"
"18474","أتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ= أ““أوۏشەأذًعأځشأوۏشۏأتوحأًتشزأۄًأڲۏأ؏أدًأتحىتأثڔتأۄەأدحىتأظىؼتؤأتًشأۏخشثأڬەأزشوۏتىألتظهۄأۄەأۗ‛‛أ"
"18475","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أوۏشتأتۏڬأذًعأۄەأتًشأوۏڽأتضأځشأحوۄتشتأځۏطشًأۄًاڽأڲتأۗ‛‛أ"
"18476","أذعشحأؼشثتعأثىأضتشۏۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أۏۄأتوحأذًعأځشأۏًڽأۄدًوأڬشەأڲۏأ؏أدضأغشذأځتىۏأځۏىەأ؏أدضأغشذأځتىۏأځۏىەأڬەأهۏەأإىەأًتهەأتًىټًڽأڬتأۄدًوأۄًحتأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأزًأتضىتزأڬەأضتحہأىمهأڬۏأۄەأتًشأتىأزًىًڽأوۏڽأضەأتۏڬأذضىأۄەأۗ"
"18477","حضرت عبداللہ بن عمر رضی اللہ عنہما نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" میرا حوض اتنا بڑا ہے جتنا عدن اور عمان کے درمیان فاصلہ ہے ( اس کا مشروب ) برف سے زیادہ سفید ، شہد سے زیادہ میٹھا اور مشک سے زیادہ خوشبودار ہے ، اس سے برتن آسمان کے ستاروں کی مانند ہیں جو شخص اس میں سے ایک مرتبہ پی لے گا وہ اس کے بعد کبھی پیاسا نہیں ہو گا ، اس حوض پر سب سے پہلے غریب مہاجرین آئیں گے ، حاضرین میں سے کسی نے دریافت کیا : یا رسول اللہ ! وہ کون ہوں گے ء نبی اکرم ﷺ نے ارشاد فرمایا : جن کے بال بکھرے ہوئے ہوں گے ، جن کے چہرے متغیر ہوں گے ، ان کے کپڑے میلے ہوں گے ان کے لیے دروازے نہیں کھولے جاتے ہوں گے ، وہ خوشحال عورتوں کے ساتھ نکاح نہیں کر سکتے ہوں گے ، جو ان کی ذمہ داری تھی وہ انہوں نے پوری کی ہو گی اور جو ان کا حق تھا وہ انہوں نے وصول نہیں کیا ہو گا ۔"""" ( علامہ ہیثمی فرماتے ہیں : ) میں یہ کہتا ہوں : حضرت عبداللہ بن عمر رضی اللہ عنہما سے منقول حدیث """" صحیح """" میں مذکور ہے ، جو اس سیاق کے بغیر ہے اور یہ درست ہے اور لوگوں کی روایت کے مطابق ہے جبکہ """" صحیح """" میں جو روایت ہے اس میں یہ مذکور ہے :"""" جتنا جربی اور اذرح کے درمیان فاصلہ ہے ۔"""" حالانکہ یہ دونوں ایسی بستیاں ہیں ، جو ایک دوسرے کے پہلو میں ہیں ۔ ہمارے ایک استاد شیخ علامہ صلاح الدین العلائی نے فرمایا ہے : شاید اس میں سے ایک لفظ رہ گیا ہے ( اور اصل جملہ یوں ہونا چاہیے : ) جس طرح تم لوگوں کے اور جربی اور اذرح کے درمیان فاصلہ ہے ۔ یہ بات میں نے ان سے سنی ہے ۔ یہ روایت امام احمد اور امام طبرانی نے عمرو بن عمر احموسیٰ کی مخارق بن ابومخارق کے حوالے سے نقل کردہ روایت کے طور پر نقل کی ہے اور اس کے باپ کا نام عبداللہ بن جابر ہے ابن حبان نے ان دونوں کا تذکرہ کتاب الثقات میں کیا ہے امام احمد کے استاد ابومغیرہ صحیح کے رجال میں سے ہیں ۔"
"18478","أذعشحأتثًتوتوۄأثتۄهۏأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ"
"18479","أذعشحأخًثتىأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أوۏڽأتځىەأذًعأضەأڬډہأهًڲًڽأڬًأځشەأڬشًڽأڲتأ؏أتځىەأتۄهأثۏحأڬۏأرتغشأ؏أوۏڽأتځىەأؼظتأڬەأسشۏؼەأتىأهًڲًڽأڬًأوتشًڽأڲتأۏۄتڽأحڬأڬۄأًۄأځۏډہەأۄټأدتةۏڽأڲەأۗ‛‛"
"18480","أذعشحأثشۏزۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬەأثتشەأوۏڽأۏۄأثتحأىمهأڬشحەأۄۏڽأ=أإځأ﷽أىەأذًعأڬتأحسڬشۄأڬشحەأۄًةەأۏۄأتشطتزألشوتۏتأ= أ““أحوأتضأوۏڽأإضوتىأڬەأضحتشًڽأڬۏأحؼزتزأوۏڽأثشحىأزۏڬہًأڲەأۗ‛‛ أۏۄأشًتۏحأتوتوأثصتشأىەأىمهأڬۏأۄەأ؏أًۄأڬۄحەأۄۏڽأ=أۏۄأذزۏخأؽشۏثأۄەأۗأ"
"18481","انس سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""مجھے کوثر عطا کیا گیا، تو میں نے اس میں ہاتھ ڈالا تو اس کی مٹی مشک کی طرح خوشبو دار تھی، اور اس کے کنکرے موتی تھے، اور اس کے دونوں کنارے - مجھے لگتا ہے اس نے کہا: - قبے ہیں جو زمین پر بہہ رہے ہیں، یہ کوئی نہر نہیں ہے جو کھودی گئی ہو۔"" میں نے انس سے کہا: آپ کے پاس صحیح میں حوض کے بارے میں دیگر احادیث بھی ہیں جو اس سیاق سے مختلف ہیں۔ اسے بزار نے روایہ کیا ہے، اور اس کے رواة پر اعتماد کیا گیا ہے اگرچہ ان میں سے بعض میں کمزوری ہے۔"
"18482","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أوۏشەأذًعأڬۏأوضتلحأتۏڬأوتۄأڬۏأۄەأتًشأتضأڬەأزًىًڽأڬىتشەأثشتثشأۄۏڽأ؏أتضأڬەأثشحىأإضوتىأڬەأضحتشًڽأڬۏأحؼزتزأوۏڽأۄۏڽأ؏أتضأڬتأځتىۏأثشلأضەأصۏتزۄأضلۏزأتًشأطۄزأضەأصۏتزۄأوۏټہتأتًشأوطڬأضەأصۏتزۄأرًطثًزتشأۄەأ؏أدًأطرظأتضأوۏڽأضەأتۏڬأوشحثۄأځۏأهەأڲتأًۄأتضأڬەأثؼزأڬثہۏأځۏتضتأىۄۏڽأۄًأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأوذوزأثىأؼثزتهًۄتثأذتشخۏأڬتأوؼتوهۄأورحهلأۄەأتًشأًۄأخمۄأۄەأۗ"
"18483","أذعشحأتثًثشصۄأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ="
"18484","أذعشحأثشتؤأثىأؼتصثأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ"
"18485","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأتًشأذعشحأدتثشأثىأؼثزتههيأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ="
"18486","أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أؽصًۄأحثًڬأڬەأضتهأىثۏأتڬشوأ﷽أشتحأڬەأًمحأىوتصأتزتأڬشىەأڬەأهۏەأڬہڔەأۄًةەأ؏أإځأڬەأځۏډہەأإځأڬەأتظذتثأضەأحؼهمأشڬہىەأًتهەأڬډہأتلشتزأتڬټہەأۄًأڲةەأ؏أًۄأإځأڬۏأذلتػحأڬشىەأهڲەأ؏أدثأىثۏأتڬشوأ﷽أىەأىوتصأتزتأڬشأهۏأحًأىوتصأضەألتشؽأۄًىەأڬەأثؼزأإځأتىأذعشتحأڬۏأغشلأوحًدۄأۄًةەأتًشأإځأىەأتىأضەأتشطتزألشوتۏتأ="
"18487","حضرت عبادہ بن صامت رضی اللہ عنہ بیان کرتے ہیں : """" ایک مرتبہ نبی اکرم ﷺ کے اصحاب نے نبی اکرم ﷺ کو غیر موجود پایا ، وہ لوگ جب پڑاا کیا کرتے تھے تو نبی اکرم ﷺ کو اپنے درمیان میں ٹھہراتے تھے ، وہ لوگ پریشان ہو گئے ، انہوں نے یہ گمان کیا کہ شاید اللہ تعالیٰ نے نبی اکرم ﷺ کے لئے ان کے علاوہ کوئی اور اصحاب منتخب کر لیے ہیں ، اسی دوران نبی اکرم ﷺ سامنے سے تشریف لے آئے ، ان لوگوں نے جب نبی اکرم ﷺ کو دیکھا تو انہوں نے تکبیر کہی ، ان لوگوں نے عرض کی : یا رسول اللہ ! ہم پریشان ہو گئے تھے کہ کہیں اللہ تعالیٰ نے آپ کے لئے ہمارے علاوہ کوئی اور اصحاب منتخب نہ کر لیے ہوں ، تو نبی اکرم ﷺ نے ارشاد فرمایا : جی نہیں ! بلکہ تم لوگ ہی دنیا اور آخرت میں میرے اصحاب ہو ، اللہ تعالیٰ نے مجھے بیدار کیا اور ارشاد فرمایا : اے محمد ( ﷺ ) ! میں نے جس نبی اور رسول کو مبعوث کیا ، تو اس نے مجھ سے کوئی ایک مخصوص سوال کیا ، تو میں نے وہ چیز اسے دیدی ، اے محمد ( ﷺ ) ! تم بھی سوال کرو تمہیں بھی دیا جائے گا ، میں نے عرض کی : میرا سوال قیامت کے دن اپنی امت کی شفاعت کے لیے ہے ۔"""" حضرت ابوبکر رضی اللہ عنہ نے عرض کی : یا رسول اللہ شفاعت کیا ہے ء نبی اکرم ﷺ نے فرمایا : میں نے کہا : اے میرے پروردگار ! میری شفاعت وہ ہے جو میں تیرے پاس سنبھال کے رکھوا رہا ہوں ، تو پروردگار نے فرمایا : ٹھیک ہے ، تو پروردگار میری بقیہ امت کو جہنم سے نکال دے گا اور انہیں جنت میں داخل کر دے گا ۔"""" یہ روایت امام احمد ، امام طبرانی نے نقل کی ہے امام احمد کے رجال ثقہ ہیں اگرچہ ان میں سے بعض راویوں میں ضعف پایا جاتا ہے ۔"
"18488","أذعشحأوؼتسأثىأدثهأشعۏأتههۄأؼىۄأتًشأذعشحأتثًوًضۏٳأتطؼشۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أ"
"18489","أتوتوأتذوزأڬۏأىمهأڬشزۄأتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=أ"
"18490","أذعشحأتثًوًضۏٳأتطؼشۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أۄوأىەأىثۏأتڬشوأ﷽أڬەأضتحہأتۏڬأدىڲأوۏڽأذظۄأهۏتأ؏أضلشأڬەأزًشتىأشتحأڬەأًمحأۄوأىەأځڔتاأڬۏتأشتحأڬەأڬضۏأًمحأوۏڽأ؏أوۏڽأتْټہأڬشأىثۏأتڬشوأ﷽أڬۏأورظًظأدڲۄأڬۏأغشلأإۏتأ؏أوۏڽأىەأإځأڬًأحهتطأڬۏتأهۏڬىأوۏڽأىەأإځأڬًأىۄۏڽأځتۏتأ؏أوۏڽأإځأڬۏأحهتطأوۏڽأڬہهۏأدڲۄأڬۏأغشلأډهتأڲۏتأ؏أًۄتڽأىثۏأتڬشوأ﷽أڬەأتظذتثأضەأحؼهمأشڬہىەأًتهەأڬًةۏأظتذثأوًدًزأحہەأًۄأثہۏأتضۏأحهتطأوۏڽأحہەأدًأوۏڽأحهتطأڬشأشۄتأحہتأۗ أشتًۏأڬۄحەأۄۏڽأ=أتثہۏأۄوأتضۏأذتهحأوۏڽأحہەأڬۄأتضۏأزًشتىأىثۏأتڬشوأ﷽أضتوىەأضەأۄوتشۏأغشلأإحەأۄًةەأحطشۏلأهتةەأ؏أۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأتۏڬأتۏضۏأضشصوۏىأځشأۄۏڽأدۄتڽأدىڲأډهأشۄۏأۄەأ؏أۄوأإځأڬەأذًتهەأضەأتىزۏطەأڬتأطڬتشأحہەأ؏أتۏضتأڬۏًڽأىۄۏڽأۄًتأڬۄأتڲشأإځأڬًأڬًةۏأعشًشحأځۏطأإةۏأحہۏأ؏أحًأإځأتځىەأتظذتثأوۏڽأضەأڬضۏأضەأڬۄۄأزۏحەأحًأًۄأإځأڬەأضتحہأتْټہأڬەأډهتأدتحتأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ="
"18491","ان کی نقل کردہ ایک روایت میں یہ الفاظ ہیں : """" ہم لوگ روانہ ہوئے ، یہاں تک کہ صبح کے قریب نبی اکرم ﷺ نے پڑاا کیا ، ہم آپ کے اردگرد اکٹھے ہو گئے ، ہم اسی طرح کیا کرتے تھے ، نبی اکرم ﷺ نے اپنی اوٹنی کو باندھا پھر آپ نے اپنا رخسار اس کی رسی پر رکھا اور آپ سو گئے ، ہم بھی ادھر ادھر بکھر گئے ، میں نے اپنا سر اٹھایا تو میں نے نبی اکرم ﷺ کو آپ کی مخصوص جگہ پر نہ پایا ، میں اس پر گھبرا گیا ، میں اْٹھا میں نے نشیبی حصے کی طرف سے چکی چلنے کی سی آواز سنی اسی دوران نبی اکرم ﷺ تشریف لے آئے ، آپ کے چہرے پر خوشی کے آثار نمایاں تھے ، راوی کہتے ہیں : میں نے عرض کی : یا رسول اللہ ! آپ کہاں تھے ء نبی اکرم ﷺ نے فرمایا : لگتا ہے تم نے مجھے میری جگہ پر نہیں دیکھا تو تم پریشان ہو گئے ، میں نے عرض کی : جی ہاں ! اللہ کی قسم ! میں پریشان ہو گیا تھا ، نبی اکرم ﷺ نے فرمایا : ابھی جبرائیل میرے پاس آئے تھے اور انہوں نے مجھے یہ اختیار دیا کہ یا شفاعت ہو ، یا ( پروردگار ) میری نصف امت کی مغفرت کر دے ، تو میں نے شفاعت کو اختیار کر لیا ۔"""" اسی دوران لوگ بھی اْٹھ کر نبی اکرم ﷺ کے پاس آ گئے ، انہوں نے عرض کی : یا رسول اللہ ! آپ ہماری بھی شفاعت کیجئے گا ، نبی اکرم ﷺ نے فرمایا : میری شفاعت تمہیں بھی نصیب ہو گی ، جب لوگ بکثرت آنے لگے تو نبی اکرم ﷺ نے ارشاد فرمایا : """" جو شخص ایسی حالت میں اللہ تعالیٰ کی بارگاہ میں حاضر ہو کہ وہ کسی کو اْس کا شریک نہ ٹھہراتا ہو تو وہ جنت میں داخل ہو گا ۔"""" طبرانی کی مختلف اسانید میں سے ایک کے رجال ثقہ ہیں ، یہ روایت انہوں نے معجم صغیر میں اس کی مانند نقل کی ہے ۔"
"18492","أذعشحأوظؼثأتضهوۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أۄوتشتأتۏڬأهڔڬتأڲۏتأتًشأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أتضأىەأڬۄتأ=أوۏڽأإځأضەأتۏڬأضًتهأڬشىتأډتۄحتأۄًڽأ؏أىثۏأتڬشوأ﷽أىەأزشۏتلحأڬۏتأ=أًۄأڬۏتأآأتضأىەأڬۄتأ=أوۏڽأإځأضەأۏۄأزشرًتضحأڬشحتأۄًڽأڬۄأإځأودہەأثہۏأتىأتلشتزأوۏڽأطتوهأڬشۏڽأ؏أدىأڬۏأإځأمۏتوحأڬەأزىأطلتؼحأڬشۏڽأڲەأ؏أىثۏأتڬشوأ﷽أىەأزشۏتلحأڬۏتأ=أحوۄۏڽأتضأڬتأذڬوأڬضأىەأزۏتأۄەأآأۏتأحوۄۏڽأتضأڬۏأحؼهۏوأڬضأىەأزۏأۄەأآأۏتأتضأڬەأثتشەأوۏڽأحوۄتشۏأشۄىوتةۏأڬضأىەأڬۏأۄەأآأ+أۏؼىۏأۏۄأطڬأشتًۏأڬًأۄەأ,أتضأىەأڬۄتأ=أودہەأتضأڬەأثتشەأوۏڽأڬضۏأىەأىۄۏڽأڬۄتأ؏أۏۄأوۏشتأتځىتأرۏتهأۄەأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أحًأحوأتىأتلشتزأوۏڽأضەأتۏڬأۄًأ؏أدىأڬۏأوۏڽأمۏتوحأڬەأزىأطلتؼحأڬشًڽأڲتأ؏أځہشأًۄأهڔڬتأډهتأڲۏتأحتڬۄأتځىەأتۄهأرتىۄأڬًأتضأثتشەأوۏڽأثحتةەأ؏أدثأًۄأوڔأڬشأډهتأڲۏتأ؏أحًأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتضأهڔڬەأڬًأوۏشەأځتضأهەأڬەأإاأ$أهًڲًأتضەأًتځضأهەأڬشأإةەأ؏أحًأًۄأځشۏطتىأحہتأتضەأۏۄأتىزۏطۄأحہتأڬۄأڬۄۏڽأتضأڬەأثتشەأوۏڽأڬًةۏأىۏتأذڬوأىۄأإأڲۏتأۄًأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ="
"18493","أذعشحأؼًلأثىأوتهڬأتطدؼۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أ أ““أۄوأهًڲأىثۏأتڬشوأ﷽أڬەأضتحہأضلشأڬشأشۄەأحہەأ؏أدثأشتحأڬتأًمحأۄًتأحًأىۏىزأوۏشۏأإىڬہًڽأضەأزًشأحہۏأ؏أودہەأىۏىزأىۄۏڽأإأشۄۏأحہۏأ؏أحًأوۏڽأتټہأڬہڔتأۄًتأ؏أهطڬشأوۏڽأوًدًزأۄشأدتىًشأىەأتځىتأشرضتشأصوۏىأځشأشڬہتأۄًتأحہتأ؏أوۏڽأىەأضًډتأوۏڽأىثۏأتڬشوأ﷽أڬەأځتضأدتحتأۄًڽأتًشأظثذأۄًىەأحڬأشتحأثہشأإځأڬۏأذلتػحأڬشحتأشۄًڽأڲتأ؏أوۏڽأىڬهتأتًشأورحهلأهًڲًڽأڬەأزشوۏتىأضەأڲصشحتأۄًتأىثۏأتڬشوأ﷽أڬەأځتهتىأڬەأځتضأإۏتأحًأىثۏأتڬشوأ﷽أتځىەأځتهتىأوۏڽأىۄۏڽأحہەأ؏أوۏڽأًۄتڽأضەأىڬهتأتًشأورحهلأهًڲًڽأڬەأځتهتىًڽأڬەأزشوۏتىأوۏڽأضەأۄًحتأۄًتأهطڬشأضەأثتۄشأىڬهأإۏتأ؏أودہەأضتوىەأڬًةۏأۄۏًهۏٳأىػشأإۏتأ؏أوۏڽأتضأڬۏأغشلأثڔہتأحًأًۄأذعشحأتثًؼثۏزۄأثىأدشتذأشعۏأتههۄأؼىۄأتًشأذعشحأوؼتسأثىأدثهأشعۏأتههۄأؼىۄأحہەأ؏أتىۄًڽأىەأودہأضەأزشۏتلحأڬۏتأۄەأ=أحوأڬۏًڽأثتۄشأإةەأۄًأآأوۏڽأىەأڬۄتأ=أتضۏأًدۄأضەأدضأڬۏأًدۄأضەأإځأزًىًڽأثتۄشأإةەأۄۏڽأ؏أۄوتشەأضتوىەأڬطتزۄأوۏزتىأحہتأ؏أدضەأهًڲأمعتةەأذتدحأڬەأهةەأتضحؼوتهأڬشحەأحہەأ؏أًۄأصۏتزۄأزًشأىۄۏڽأحہتأ؏أۄوأتضأوۏزتىأڬۏأغشلأډهأځڔەأتضۏأزًشتىأۄوأىەأًۄتڽأضەأإًتصأضىۏأدًأطۄزأڬۏأوڬہۏأڬۏأثہىثہىتۄټأڬۏأوتىىزأحہۏأ؏أۏًڽأدۏضەأۄًتأډهأشۄۏأۄًأ؏أىثۏأتڬشوأ﷽أىەأزشۏتلحأڬۏتأ=أڬۏتأۏۄتڽأتثًؼثۏزۄأثىأدشتذأۄەأآأۄوأىەأؼشعأڬۏأ=أدۏأۄتڽأ$أىثۏأتڬشوأ﷽أىەأزشۏتلحأڬۏتأ=أتًشأوؼتسأثىأدثهأۄەأآأۄوأىەأؼشعأڬۏأ=أدۏأۄتڽأ$أىثۏأتڬشوأ﷽أىەأزشۏتلحأڬۏتأ=أتًشأؼًلأثىأوتهڬأۄەأآأۄوأىەأؼشعأڬۏأ=أدۏأۄتڽأ$أ أىثۏأتڬشوأ﷽أۄوتشەأځتضأحطشۏلأهەأإةەأ؏أۄوأىەأإځأضەأڬًةۏأضًتهأىۄۏڽأڬۏتأ؏أىۄأۄۏأإځأىەأۄوأضەأڬًةۏأتًشأضًتهأڬۏتأ؏أۏۄتڽأحڬأڬۄأإځأتځىەأځتهتىأڬەأځتضأًتځضأحطشۏلأهەأإةەأ؏أحًأإځأىەأتشطتزألشوتۏتأ=أڬۏتأوۏڽأحوۄۏڽأتضأډۏصأڬەأثتشەأوۏڽأىۄأثحتاڽأدًأتثہۏأحہًڔۏأزۏشأځۄهەأوۏشەأځشًشزڲتشأىەأودہەأترحۏتشأزۏتأۄەأآأۄوأىەأؼشعأڬۏأ=أدۏأۄتڽأ$أۏتأشضًهأتههۄأ$أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتضأىەأودہەأۏۄأترحۏتشأزۏتأۄەأڬۄأًۄأوۏشۏأتوحأڬەأزًأحۄتةۏأذظەأڬًأڬضۏأذضتثأتًشأؼستثأڬەأثؽۏشأدىحأوۏڽأزترهأڬشأزەأ؏أتضأډۏصأتًشأطلتؼحأڬەأزشوۏتىأترحۏتشأزۏتأۄەأ؏أۄوأىەأزشۏتلحأڬۏتأ=أۏتأشضًهأتههۄأ$أحًأځہشأإځأىەأڬۏتأترحۏتشأڬۏتأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أوۏڽأىەأطلتؼحأڬًأترحۏتشأڬشأهۏتأۗأ ۄوأضثأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأۄوۏڽأتځىۏأطلتؼحأضەأثۄشۄأوىزأتلشتزأوۏڽأطتوهأڬۏدةەأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أوۏشۏأطلتؼحأۄشأوضهوتىأڬەأهةەأۄًأڲۏأۗ"
"18494","أتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=أذعشحأؼًلأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أ أ““أۄوأىەأىثۏأتڬشوأ﷽أڬەأضتحہأتۏڬأدڲۄأځشأځڔتاأڬۏتأ؏أشتحأڬەأًمحأوۏڽأثۏزتشأۄًتأحًأودہەأځًشەأهطڬشأوۏڽأڬًةۏأتۏضۏأډۏصأىػشأىۄۏڽأإحۏأحہۏأ؏أدًأځتهتىأڬۏأځډہهۏأهڬڔۏأضەأصۏتزۄأهوثۏأۄًأ؏أۄشأتىضتىأتًشأتًىټأصوۏىأڬەأضتحہأهڲتأۄًتأحہتأ؏أوۏڽأتْټہتأتًشأهًڲًڽأڬەأزشوۏتىأوۏڽأضەأڲصشحتأۄًتأىثۏأتڬشوأ﷽أڬەأإشتوأڬۏأدڲۄأڬەأځتضأإۏتأحًأإځأًۄتڽأىۄۏڽأحہەأوۏڽأىەأتځىتأۄتحہأإځأڬەأثضحشأځشأشڬہتأحًأًۄأټہىڋتأحہتأ؏أوۏڽأتْټہتأتًشأهًڲًڽأڬەأزشوۏتىأضەأڲصشحتأۄًتأ““أتىتأههۄأًتىتأتهۏۄأشتدؼًىأ‛‛أځڔہىەأهڲتأۗ‛‛أ أتضأڬەأثؼزأشتًۏأىەأذضثأضتثمأذزۏخأسڬشأڬۏأۄەأ؏أحتۄوأتضأوۏڽأۏۄأتهلتػأۄۏڽأ=أ أ““أتضأىەأودہەأۏۄأترحۏتشأزۏتأڬۄأًۄأوۏشۏأتوحأڬەأىظلأذظەأڬًأدىحأوۏڽأزترهأڬشأزەأ111111‛‛ۗ"
"18495","أتۏڬأشًتۏحأوۏڽأذعشحأتثًؼثۏزۄأشعۏأتههۄأؼىۄأڬۏأدڲۄأذعشحأتثًوًضۏٳأتطؼشۏأشعۏأتههۄأؼىۄأڬتأىتوأوسڬًشأۄەأۗ"
"18496","أتثًڬؼثأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأذعشحأتىضأشعۏأتههۄأؼىۄأڬەأظتذثصتزەأىظشأضەأڬۄتأ=أإځأودہەأڬًةۏأتۏضۏأذزۏخأثۏتىأڬۏدةەأدضأڬەأسشۏؼەأتههۄأحؼتهۏٳأودہەأىلؼأؼغتأڬشەأحًأتىۄًڽأىەألشوتۏتأ=أټہۏڬأۄەأوۏڽأحوۄۏڽأتۏضۏأذزۏخأثۏتىأڬشحتأۄًڽأدًأتىۄًڽأىەأوزۏىۄأوىًشۄأضەأۄوتشۏأغشلأهڬہأڬەأثہۏدۏأحہۏأ؏أذعشحأتىضأشعۏأتههۄأؼىۄأىەألشوتۏتأ=أتضأڬًأوذلًػأڬشأهۏىتأڬۏًىڬۄأۏۄأذزۏخأڬەأرصتىًڽأوۏڽأضەأۄەأتىۄًڽأىەأثحتۏتأ=أ"
"18497","أذعشحأؼثزتهشذوىأثىأتثًؼمۏهأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأتۏڬأًلزأڬەأۄوشتۄأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًتأ؏أۄوأإځأڬەأځتضأإةەأ؏أۄوأىەأإځأڬەأزشًتصەأځشأضًتشۏتڽأثتىزہۏڽأ؏أتضأًمحأوۏشەأىصزۏڬأإځأضثأضەأىتځضىزۏزۄألشزأحہەأ؏أدثأوۏڽأإځأڬەأځتضأدتىەأهڲتأحہتأ؏أهۏڬىأدثأۄوأإځأڬەأځتضأضەأتټہەأحًأإځأۄوتشەأىصزۏڬأضثأضەأصۏتزۄأځضىزۏزۄألشزأحہەأ؏أۄوأوۏڽأضەأڬضۏأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأتځىەأځشًشزڲتشأضەأتۏضۏأثتزطتۄۏأڬۏًڽأىۄۏڽأوتىڲحەأدضأغشذأذعشحأضهۏوتىأؼهۏۄأتهضهتوأڬۏأثتزطتۄۏأحہۏأ؏أشتًۏأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أۄىضأځڔەأ؏أځہشأإځأىەأتشطتزألشوتۏتأ=أ أ““أۄًأضڬحتأۄەأحوۄتشەأإمتأڬەأهةەأتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأًۄأډۏصأۄًأدًأذعشحأضهۏوتىأؼهۏۄأتهضهتوأڬۏأثتزطتۄۏأضەأصۏتزۄألعۏهحأشڬہحۏأۄًأ؏أتههۄأحؼتهۏٳأىەأدضأثہۏأىثۏأڬًأوثؼًخأڬۏتأتْضەأتۏڬأورظًظأزؼتأڬتأترحۏتشأزۏتأ؏أتىأتىثۏتؤأوۏڽأضەأڬضۏأىەأتضأورظًظأزؼتأڬەأسشۏؼەأڬًةۏأزىۏتًۏأىحۏدۄأذتظهأڬشىتأډتۄتأحًأًۄأتىۄۏڽأزەأزۏتأڲۏتأ؏أتْىأوۏڽأضەأڬضۏأىەأتضأورظًظأزؼتأڬًأتځىۏأمًوأڬەأرهتلأتضحؼوتهأڬۏتأدثأتضأمًوأىەأتىأڬۏأىتلشوتىۏأڬۏأحہۏأ؏أحًأتضأزؼتأڬۏأًدۄأضەأتىہۏڽأۄهتڬحأڬتأطڬتشأڬشأزۏتأڲۏتأ؏أتههۄأحؼتهۏٳأىەأودہەأثہۏأتۏڬأورظًظأزؼتأڬتأترحۏتشأزۏتأحًأوۏڽأىەأًۄأمۏتوحأڬەأزىأتځىۏأتوحأڬۏأطلتؼحأڬەأهۏەأتځىەأځشًشزڲتشأڬەأځتضأضىثہتهأڬەأشڬہًتأزۏأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأتًشأتوتوأثصتشأىەأىمهأڬۏأۄەأتًشأتىأزًىًڽأڬەأشدتهأخمۄأۄۏڽأۗ"
"18498","ابو سعید سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""ہر نبی کو کوئی ن کوئی عطیہ دی گئی تھی جسے اس نے فوراً حاصل کر لیا، اور میں نے اپنی عطیہ کو چھپا رکھا ہے تاکہ یہ میری امت کے لیے شفاعت بن جائے۔"" اسے بزار، ابو یعلی، اور احمد نے روایہ کیا ہے، اور اس کا سند اس کی متعدد طرز کی وجہ سے حسن ہے۔"
"18499","ابو ذر سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""مجھے پانچ چیزیں دی گئیں جو مجھ سے پہلے کسی نبی کو نہیں دی گئیں: میرے لیے زمین طہارت اور مسجد بنا دی گئی، اور میرے لیے غنائم حلال کر دی گئیں جو مجھ سے پہلے کسی نبی کے لیے حلال نہ تھیں، اور مجھ کو ڈراؤ کے ذریعے ایک ماہ کے سفر تک مدد دی گئی، اور مجھے سرخ اور سیاہ سب لوگوں کی طرف بھیجا گیا، اور مجھے شفاعت دی گئی جو میری امت کے那些 لوگوں تک پہنچے گی جو اللہ کے ساتھ کسی کو شریک نہ بنائیں گے۔"" اسے بزار نے روایہ کیا ہے اور اس کے رواة صحیح کے رواة ہیں سوا مجاہد کے جو ابو ذر سے نہیں ملے، اور اللہ بہتر جانتا ہے۔"
"18500","ابن عباس سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""مجھے پانچ چیزیں عطا کی گئیں جو مجھ سے پہلے کسی نبی کو نہیں دی گئیں: مجھے سرخ اور سیاہ سب کی طرف بھیجا گیا، اور مجھ سے پہلے جو نبی آئے وہ اپنی قوم کی طرف بھیجے جاتے تھے، اور زمین کو مسجد اور طہارت بنا دیا گیا، اور مجھے ڈراؤ کے ذریعے میرے آگے ایک ماہ کے سفر تک نصرت دی گئی، اور میرے لیے غنائم حلال کر دی گئیں جو مجھ سے پہلے کسی کے لیے حلال نہ تھیں، اور مجھے شفاعت دی گئی تو میں نے اسے اپنی امت کے لیے ملتوی رکھ دیا، تو یہ ان لوگوں تک پہنچے گی جو اللہ کے ساتھ کسی کو شریک نہ بنائیں گے۔"" اسے بزار نے دو حسن اسناد کے ساتھ روایہ کیا ہے۔ میں نے کہا: اور اس حدیث کے طرق پہلے تیمم میں اور نبوت کی علامات میں رسول اللہ ﷺ کی عام بعثت کے بارے میں آ چکے ہیں۔"
"18501","ام سلمہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""میں نے دیکھا کہ میری امت میرے بعد کیا کرے گی، تو میں نے ان کے لیے قیامت کے دن شفاعت کو چنا۔"""
"18502","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أڬًةۏأطرظأهًڲًڽأضەأوضهضهأوتىڲحتأشۄەأڲتأۏۄتڽأحڬأڬۄأدثأًۄأمۏتوحأڬەأزىأإةەأڲتأحًأتضأڬەأډۄشەأځشأڲًطحأڬتأڬًةۏأټڬڔتأىۄۏڽأۄًأڲتأۗ‛‛"
"18503","أذعشحأضهوتىأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أمۏتوحأڬەأزىأضًشدأڬًأزضأضتهأڬۏأڲشوۏأزەأزۏأدتةەأڲۏأ؏أځہشأًۄأهًڲًڽأڬەأضشًڽأڬەأمشۏثأإأدتةەأڲتأ؏أشتًۏأڬۄحەأۄۏڽأتضأڬەأثؼزأتىۄًڽأىەأځًشۏأذزۏخأسڬشأڬۏأۄەأدضأوۏڽأإڲەأډهأڬشأًۄأثۏتىأڬشحەأۄۏڽأ=أ"
"18504","أتثًىعشۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأڬًأثظشۄأڬەأوىثشأځشأرغثۄأزۏىەأڬەأزًشتىأۏۄأتشطتزألشوتحەأۄًةەأضىتأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ"
"18505","أذعشحأتىضأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أوۏڽأدىحأڬتأزشًتصۄأڬہټڬہټتاڽأڲتأ؏أًۄأوۏشەأهةەأڬہًهأزۏتأدتةەأڲتأ؏أًۄأضًىەأضەأثىتأۄًتأزشًتصۄأۄًأڲتأ؏أدضأڬۏأڬىڋۏأډتىزۏأڬۏأثىۏأۄًةۏأۄًأڲۏأ؏أوۏشەأضتوىەأضثأضەأثڔتأىًشأإةەأڲتأحًأوۏڽأضدزەأوۏڽأډهتأدتاڽأڲتأ؏أتضأًمحأتههۄأحؼتهۏٳأڬۏأخىتؤأڬەأثتشەأوۏڽأتۏضەأڬهوتحأودہەأتهمتؤأڬةەأدتةۏڽأڲەأدًأودہأضەأځۄهەأڬضۏأڬًأتهمتؤأىۄۏڽأڬۏەأڲةەأ؏أځہشأودہأضەأڬۄتأدتةەأڲتأ=أحوأتځىتأضشأتټہتاأ؏أحوأوتىڲًأ؏أًۄأزۏتأدتةەأڲتأ؏أحوأڬۄًأ؏أضىتأدتةەأڲتأ؏أحوأطلتؼحأڬشًأ؏أطلتؼحأمثًهأڬۏأدتةەأڲۏأ؏أحًأوۏڽأۏۄأڬۄًڽأڲتأ=أوۏشۏأتوحأ؏أحًأۏۄأڬۄتأدتةەأڲتأ=أحوۄۏڽأًۄأوهحتأۄەأدضأڬەأزهأوۏڽأ؏أدًأڬەأزتىەأڬەأًصىأدحىتأتۏوتىأۄًأۗ أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أځہشأوۏڽأزًضشۏأوشحثۄأضدزەأوۏڽأدتاڽأڲتأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أځہشأودہەأتضأڬۏأوتىىزأڬهوتحأتهمتؤأڬۏەأدتةۏڽأڲەأ؏أځہشأودہأضەأتضأڬۏأوتىىزأثتحأڬۄۏأدتةەأڲۏأتًشأوۏڽأۏۄأڬۄًڽأڲتأ=أوۏشۏأتوحأ؏أودہأضەأڬۄتأدتةەأڲتأ=أحوۄۏڽأًۄأوهحتأۄەأدضأڬەأزهأوۏڽأشتةۏأڬەأزتىەأڬەأًصىأدحىتأتۏوتىأۄًأ؏أځہشأوۏڽأحۏضشۏأوشحثۄأضدزەأوۏڽأدتاڽأڲتأ؏أځہشأودہأضەأتضأڬۏأوتىىزأثتحأڬۄۏأدتةەأڲۏأ؏أځہشأوۏڽأتځىتأضشأتټہتاڽأڲتأتًشأۏۄأڬۄًڽأڲتأ=أوۏشۏأتوحأ؏أحًأودہأضەأڬۄتأدتةەأڲتأ=أحوۄۏڽأۄشأًۄألشزأوهحتأۄەأدضأىەأترهتظأڬەأضتحہأهتأتهۄأتهتأتههۄأځڔہتأۄًأۗ‛‛"
"18506","حضرت انس رضی اللہ عنہ بیان کرتے ہیں : اللہ کے نبی ﷺ نے مجھے یہ بات بتائی ہے : """" میں کھڑا ہوا اپنی امت کا انتظار کروں گا ، جو پل صراط عبور کر رہی ہو گی ، اسی دوران حضرت عیسیٰ علیہ السلام آئیں گے ، نبی اکرم ﷺ نے فرمایا : وہ یہ کہیں گے : یہ انبیاؤ آپ کے پاس آئے ہیں ، اے حضرت محمد ( ﷺ ) ! اور وہ یہ سوال کرتے ہیں ۔ ( راوی کو شک ہے ، یا شاید یہ الفاظ ہیں : ) وہ آپ کے پاس اکٹھے ہوئے ہیں ، وہ اللہ تعالیٰ سے یہ دعا کر رہے ہیں کہ وہ اْمتوں کے اجتماع کو الگ الگ کر دے ، جہاں وہ چاہے کہ لوگ اس وقت شدید پریشانی کا شکار ہیں ، لوگ اس وقت پسینے میں ڈوبے ہوئے ہوں گے ، جہاں تک مومن کا تعلق ہے تو وہ اس کے لیے یوں ہو گا جیسے زکام ہوتا ہے اور جہاں تک کافر کا تعلق ہے تو موت نے اسے ڈھانپ لیا ہو گا ۔ نبی اکرم ﷺ نے فرمایا : حضرت عیسیٰ علیہ السلام کہیں گے : آپ انتظار کریں ، جب تک میں آپ کے پاس واپس نہیں آتا ۔ راوی بیان کرتے ہیں : اللہ کے نبی ﷺ جائیں گے اور عرش کے نیچے کھڑے ہو جائیں گے اور اس وقت انہیں اس صورتحال کا سامنا ہو گا ، جس کا سامنا کسی منتخب فرشتے یا کسی مرسل نبی نے نہیں کیا ، پھر اللہ تعالیٰ حضرت جبرائیل علیہ السلام کی طرف وحی کرے گا : کہ تم حضرت محمد ( ﷺ ) کے پاس جاا اور ان سے یہ کہو : کہ تم اپنا سر اٹھاا ، تم سوال کرو ، تمھیں دیا جائے گا ، تم شفاعت کرو ، تمھاری شفاعت قبول ہو گی ۔ نبی اکرم ﷺ نے فرمایا : تو مجھے شفاعت میں یہ اختیار دیا جائے گا کہ میں ان میں سے ہر ننانوے میں سے ایک انسان کو نکال لوں ۔ نبی اکرم ﷺ نے فرمایا : میں مسلسل اپنے پروردگار کے پاس آتا جاتا رہوں گا ، میں جب بھی اس کی بارگاہ میں کھڑا ہواں گا میری شفاعت قبول ہو گی ، یہاں تک کہ اللہ تعالیٰ مجھے اس میں سے یہ چیز عطا کرے گا کہ وہ فرمائے گا : اے محمد ( ﷺ ) اللہ کی مخلوق میں سے اپنی امت میں سے ، ہر اس شخص کو داخل کروا دو جو اس بات کی گواہی دیتا ہو کہ اللہ تعالیٰ کے علاوہ اور کوئی معبود نہیں ہے ، جس نے اخلاص کے ساتھ ایک دن یہ گواہی دی ہو اور وہ اس حالت میں مر گیا ہو ۔"""" یہ روایت امام احمد نے نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں ۔"
"18507","أذعشحأتثًثڬشأظزۏمأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأظثذأڬۏأىوتصأځڔہتةۏأ؏أځہشأإځأحطشۏلألشوتأۄًةەأ؏أۏۄتڽأحڬأڬۄأډتطحأڬتأًمحأۄًأڲۏتأحًأىثۏأتڬشوأ﷽أوضڬشتأزۏةەأځہشأإځأتځىۏأدڲۄأځشأشۄەأ؏أۏۄتڽأحڬأڬۄأإځأىەأػۄشأ؏أؼظشأتًشأوؽشثأڬۏأىوتصأځڔہتةۏأ؏أتضأزًشتىأإځأىەأڬًةۏأڲلحڲًأىۄۏڽأڬۏأ؏أۏۄتڽأحڬأڬۄأإځأىەأؼطتؤأڬۏأىوتصأځڔہتأزۏأ؏أځہشأإځأتْټہأڬشأتځىەأڲہشأحطشۏلأهەأڲةەأ؏أهًڲًڽأىەأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأضەأڬۄتأ=أڬۏتأإځأىثۏأتڬشوأ﷽أضەأۏۄأضًتهأىۄۏڽأڬشۏڽأڲەأڬۄأإځأڬتأڬۏتأوؼتوهۄأۄەأآأىثۏأتڬشوأ﷽أىەأإدأدًأغشصأؼوهأترحۏتشأڬۏتأۄەأًۄأإځأىەأځۄهەأڬثہۏأىۄۏڽأڬۏتأ؏أذعشحأتثًثڬشأ﷽أىەأىثۏأتڬشوأ﷽أضەأتضأثتشەأوۏڽأزشۏتلحأڬۏتأحًأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۏأۄتڽأ$أزىۏتأڬەأوؼتوهەأضەأوحؼهمأتًشأإرشحأڬەأوؼتوهەأضەأوحؼهمأدًأڬډہأثہۏأۄًأڲتأ؏أًۄأوۏشەأضتوىەأځۏطأڬۏتأڲۏتأ؏أضثأځۄهەأًتهەأتًشأثؼزأًتهەأهًڲًڽأڬًأتۏڬأوۏزتىأوۏڽأتڬټہتأڬۏتأدتةەأڲتأ؏أهًڲأتضأظًشحذتهأضەأځشۏطتىأۄًأدتةۏڽأڲەأ؏أۏۄتڽأحڬأڬۄأًۄأذعشحأإزوأؼهۏۄأتهضهتوأڬەأځتضأدتةۏڽأڲەأ؏أځضۏىۄأتحىتأصۏتزۄأۄًأڲتأڬۄأتىۄۏڽأهڲتوأڋتهأشۄتأۄًأڲتأ؏أًۄأڬۄۏڽأڲەأ=أتەأذعشحأإزوأ+أؼهۏۄأتهضهتوأ,أ$أإځأتثًتهثطشأۄۏڽأ؏أتههۄأحؼتهۏٳأىەأإځأڬًأوىحرثأڬۏتأإځأتځىەأځشًشزڲتشأڬۏأثتشڲتۄأوۏڽأۄوتشۏأطلتؼحأڬۏدةەأ؏أحًأذعشحأإزوأؼهۏۄأتهضهتوأڬۄۏڽأڲەأ=أودہەأثہۏأتضۏأظًشحذتهأڬتأضتوىتأۄەأدضأڬتأضتوىتأحوأهًڲأڬشأشۄەأۄًأ؏أحوأتځىەأزًضشەأدزتودزأذعشحأىًذأؼهۏۄأتهضهتوأڬەأځتضأدتاأ$أ أ““أثەأطڬأتههۄأحؼتهۏٳأىەأإزوأ؏أىًذأتًشأتثشتۄۏوأڬۏأإهأتًشأؼوشتىأڬۏأإهأڬًأحوتوأدۄتىًڽأوۏڽأضەأوىحرثأڬۏتأۗ‛‛"
"18508","أذعشحأتثًتۏًثأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أتۏڬأزىأىثۏأتڬشوأ﷽أتىأهًڲًڽأڬەأځتضأحطشۏلأهتةەأ؏أإځأىەأتىأضەألشوتۏتأ="
"18509","أذعشحأدتثشأثىأؼثزتههيأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أڬۏأإهأڬۏأتۏڬأرتزوۄأحہۏأدًأإځأڬۏأرزوحأڬۏتأڬشحۏأحہۏأ؏أتْضأڬتأىتوأ†أثشۄأ‛‛أحہتأ؏أتۏڬأطرظأتضأرتحًىأضەأوهتأتًشأثًهتأ=أتەأثشۄأ$أحوأتځىۏأهټًڽأڬًأڋہتىځأڬەأشڬہًأ$أڬۏًىڬۄأتههۄأحؼتهۏٳأڬەأومتثهەأوۏڽأ؏أذعشحأوذوزأ﷽أحوۄتشەأڬضۏأڬتوأىۄۏڽأإةۏڽأڲەأ؏أتْضأرتزوۄأىەأىثۏأتڬشوأ﷽أڬًأۏۄأثتحأثحتةۏأ؏أىثۏأتڬشوأ﷽أتځىۏأډتزشأڬًأڬہۏىډحەأۄًةەأحطشۏلأهتةەأ؏أإځأڬۏأڬىځټۏتڽأضشرأۄًأشۄۏأحہۏڽأ؏أشتًۏأثۏتىأڬشحەأۄۏڽأ=أۄوۏڽأتىظتشأڬًأىثۏأتڬشوأ﷽أڬەأؽظەأڬتأتضأثتحأضەأځحۄأډهأڲۏتأڬۄأإځأډتزشأڲہضۏټحەأۄًةەأإأشۄەأۄۏڽأ؏أتًشأإځأڬۏأڬىځټۏتڽأضشرأۄۏڽأ؏أۄوأىەأۄحہۏتأهةەأتًشأإځأڬۏأرزوحأوۏڽأذتعشأۄًةەأ؏أۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أإځأدًأډتۄۏڽأ؏أۄوۏڽأذڬوأزۏڽأ؏أتضأستحأڬۏأمضوأ$أدضأىەأإځأڬًأذمأڬەأۄوشتۄأوثؼًخأڬۏتأۄەأ؏أتڲشأإځأۄوۏڽأۄوتشۏأوتاڽأ؏أۄوتشەأثتځًڽأ؏أۄوتشۏأتًهتزأڬەأثتشەأوۏڽأذڬوأزۏڽأڲەأ؏أحًأۄوأتىأڬەأثتشەأوۏڽأثہۏأإځأڬەألشوتىأځشأؼوهأڬشۏڽأڲەأ؏أىثۏأتڬشوأ﷽أوىثشأځشأډڔہەأإځأىەأتههۄأحؼتهۏٳأڬۏأذوزأًأخىتؤأثۏتىأڬۏأتًشأځہشأتشطتزألشوتۏتأ=أوۏڽأڬًىأۄًڽأآأۄوأىەأؼشعأڬۏأ=أإځأتههۄأڬەأشضًهأ﷽أۄۏڽأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أټہۏڬأۄەأ؏أهۏڬىأوۏڽأڬًىأۄًڽأآأۄوأىەأؼشعأڬۏأ=أإځأذعشحأوذوزأ+أ﷽أ,أثىأؼثزتههيأثىأؼثزتهوغهثأثىأۄتطوأثىأؼثزوىتلأۄۏڽأ؏أىثۏأتڬشوأ﷽أىەألشوتۏتأ=أ"
"18510","أذعشحأؼمثۄأثىأؼتوشأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ= أدثأتههۄأحؼتهۏٳأضثأځۄهەأًتهًڽأ؏أضثأثؼزأًتهًڽأڬًأدوؼأڬشەأڲتأتًشأتىأڬەأزشوۏتىألۏظهۄأڬشەأڲتأ؏أدثأًۄأتىأڬەأزشوۏتىألۏظهۄأڬشأڬەألتشؽأۄًأدتةەأڲتأحًأوًوىۏىأۏۄأڬۄۏڽأڲەأ=أۄوتشەأځشًشزڲتشأىەأۄوتشەأزشوۏتىألۏظهۄأڬشأزۏتأۄەأ؏أحًأتثأۄوأۏۄأډتۄحەأۄۏڽأڬۄأڬًةۏأطرظأۄوتشەأځشًشزڲتشأڬۏأثتشڲتۄأوۏڽأۄوتشۏأطلتؼحأڬشەأ؏أحوأهًڲأۄوتشەأضتحہأذعشحأإزوأؼهۏۄأتهضهتوأڬۏأغشلأډهًأ$أڬۏًىڬۄأًۄأۄوتشەأدزتودزأۄۏڽأ؏أتههۄأحؼتهۏٳأىەأتځىەأزضحأمزشحأڬەأسشۏؼەأتىۄۏڽأځۏزتأڬۏتأۄەأتًشأتىأڬەأضتحہأڬهتوأڬۏتأۄەأ؏أًۄأهًڲأذعشحأإزوأؼهۏۄأتهضهتوأڬەأځتضأإةۏڽأڲەأتًشأتىأڬەأضتحہأۏۄأثتحأډۏحأڬشۏڽأڲەأڬۄأذعشحأإزوأؼهۏۄأتهضهتوأتىأڬۏأطلتؼحأڬشۏڽأ؏أحًأذعشحأإزوأؼهۏۄأتهضهتوأۏۄأڬۄۏڽأڲەأ=أحوأځشأهتصوأۄەأڬۄأذعشحأىًذأؼهۏۄأتهضهتوأڬەأځتضأدتاأ؏أًۄأهًڲأذعشحأىًذأؼهۏۄأتهضهتوأڬەأځتضأإةۏڽأڲەأ؏أذعشحأىًذأؼهۏۄأتهضهتوأتىأڬۏأشۄىوتةۏأذعشحأتثشتۄۏوأؼهۏۄأتهضهتوأڬۏأغشلأڬشۏڽأڲەأ؏أًۄأهًڲأذعشحأتثشتۄۏوأؼهۏۄأتهضهتوأڬەأځتضأإةۏڽأڲەأ؏أذعشحأتثشتۄۏوأؼهۏۄأتهضهتوأتْىأڬۏأشۄىوتةۏأذعشحأوًضۏٳأؼهۏۄأتهضهتوأڬۏأغشلأڬشۏڽأڲەأ؏أًۄأهًڲأذعشحأوًضۏٳأؼهۏۄأتهضهتوأڬەأځتضأإةۏڽأڲەأ؏أذعشحأوًضۏٳأؼهۏۄأتهضهتوأتىأڬۏأشۄىوتةۏأذعشحأؼۏضۏٳأؼهۏۄأتهضهتوأڬۏأغشلأڬشۏڽأڲەأ؏أځہشأًۄأهًڲأذعشحأؼۏضۏٳأؼهۏۄأتهضهتوأڬەأځتضأإةۏڽأڲەأحًأًۄأۏۄأڬۄۏڽأڲەأ=أوۏڽأحوۄتشۏأشۄىوتةۏأ““أتوۏأىثۏأ‛‛أڬۏأغشلأڬشحتأۄًڽأ؏أحًأًۄأهًڲأوۏشەأځتضأإةۏڽأڲەأ؏أتههۄأحؼتهۏٳأودہەأتدتصحأزەأڲتأڬۄأوۏڽأڬہڔتأۄًأدتاڽأ؏أحًأوۏشۏأوذلهأوۏڽأضثأضەأصۏتزۄأځتڬۏصيأحشۏىأرًطثًأځہۏهأدتةەأڲۏأ؏أدًأڬضۏأثہۏأطرظأىەأضًىڲہۏأۄًأ؏أۏۄتڽأحڬأڬۄأوۏڽأتځىەأځشًشزڲتشأڬەأځتضأإأدتاڽأڲتأ؏أًۄأوۏشۏأطلتؼحأمثًهأڬشەأڲتأ؏أًۄأوۏشەأهةەأوۏشەأضشأڬەأثتهًڽأضەأهەأڬشأوۏشەأځتاڽأڬەأىترىًڽأحڬأىًشأثىتةەأڲتأ؏أځہشأڬتلشأۏۄأڬۄۏڽأڲەأ=أواوىأىەأحًأتضأڬًأځتأهۏتأۄەأ؏أدًأتىأڬۏأطلتؼحأڬشەأ؏أۄوتشۏأطلتؼحأڬًىأڬشەأڲتأآأحًأًۄأڬۄۏڽأڲەأ=أۏۄأڬتوأظشلأتثهۏضأڬشأضڬحتأۄەأ؏أدضأىەأۄوۏڽأڲوشتۄأڬۏتأحہتأ؏أًۄأهًڲأتضأڬەأځتضأإةۏڽأڲەأ؏أًۄأڬہڔتأۄًأڲتأ؏أحًأتضأڬۏأوذلهأوۏڽأضثأضەأصۏتزۄأثشۏأثزثًأځہۏهأدتةەأڲۏأ؏أدًأڬضۏأطرظأىەأضًىڲہۏأۄًأ؏أځہشأًۄأتىۄۏڽأدۄىوأڬەأځتضأهەأدتةەأڲتأتضأًمحأًۄأۏۄأڬۄەأڲتأ=أدىأڬتأسڬشأمشإىأوۏڽأتىأتهلتػأوۏڽأۄەأ= أ““أتًشأدثألۏظهۄأۄًأدتةەأڲتأحًأطۏغتىأڬۄەأڲتأ=أثەأطڬأتههۄأحؼتهۏٳأىەأحوۄتشەأضتحہأضډتأًؼزۄأڬۏتأحہتأتًشأوۏڽأىەأحوۄتشەأضتحہأًؼزۄأڬۏتأتًشأوۏڽأىەأحوۄتشەأضتحہأتضأڬۏأرهتلأًشصۏأڬۏأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأؼثزتهشذوىأثىأصۏتزأثىأتىؼوأۄەأتًشأًۄأعؼۏلأۄەأۗ"
"18511","أذعشحأؼثزتههۄأثىأؼوشًأثىأتهؼتظأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أتضأمثهۄأڬەأوتىىەأًتهًڽأوۏڽأضەأتحىەأهًڲأدۄىوأوۏڽأزترهأۄًڽأڲەأ؏أدىأڬۏأحؼزتزأڬًأتههۄأحؼتهۏأڬەأؼهتًۄأتًشأڬًةۏأطوتشأىۄۏڽأڬشأضڬحتأ؏أتضأڬۏأًدۄأۏۄأۄًأڲۏأڬۄأتْىأهًڲًڽأىەأتههۄأحؼتهۏٳأڬۏأىتلشوتىۏأڬۏأۄًأڲۏأتًشأتضأڬۏأوؼظۏحأڬەأثتشەأوۏڽأدشئحأڬتأتػۄتشأڬۏتأۄًأڲتأتًشأتضأڬۏألشوتىثشزتشۏأڬەأثشرهتلأڬۏتأۄًأڲتأ؏أځہشأودہەأطلتؼحأڬۏأتدتصحأزۏأدتةەأڲۏأ؏أحًأوۏڽأضدزەأڬۏأذتهحأوۏڽأتههۄأحؼتهۏٳأڬۏأخىتؤأثۏتىأڬشًڽأڲتأ؏أدضأغشذأوۏڽأىەأمۏتوأڬۏأذتهحأوۏڽأتْضأڬۏأخىتؤأثۏتىأڬۏأحہۏأ؏أحًأودہأضەأڬۄتأدتةەأڲتأ=أحوأتځىتأضشأتټہتاأ؏أحوأوتىڲًأ؏أحوۄۏڽأزۏتأدتةەأڲتأ؏أحوأطلتؼحأڬشًأ؏أحوہتشۏأطلتؼحأمثًهأڬۏأدتةەأڲۏأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأڬثۏشأتًشأوؼدوأظؽۏشأوۏڽأىمهأڬۏأۄەأتًشأتضأڬۏأضىزأذضىأۄەأۗ"
"18512","حضرت عبادہ بن صامت رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" اْس ذات کی قسم ! جس کے دست قدرت میں میری جان ہے ، قیامت کے دن میں لوگوں کا سردار ہواں گا اور یہ بات کسی فخر یا ریاکاری کے بغیر کہہ رہا ہوں ، اور قیامت کے دن سب لوگ میرے جھنڈے کے نیچے ہوں گے ، اور کشادگی کے منتظر ہوں گے ، میرے پاس """" لواؤ الحمد """" ہو گا ، میں چلتا ہوا جااں گا ، لوگ میرے ساتھ چلتے ہوئے جائیں گے ، یہاں تک کہ میں جنت کے دروازے کے پاس آ جااں گا اور میں دروازہ کھولنے کے لیے کہوں گا ، تو دریافت کیا جائے گا : کون ہے ء میں جواب دوں گا : محمد ( ﷺ ) تو کہا جائے گا : حضرت محمد ﷺ کو خوش آمدید ! جب میں اپنے پروردگار کو دیکھوں گا ، تو میں اس کے سامنے سجدے میں گر جااں گا ، یہ اْس کے شکر کے طور پر ہو گا ، تو کہا جائے گا : تم اپنا سر اٹھاا ! تم کہو ، تمہاری بات مانی جائے گی ، تم شفاعت کرو ، تمھاری شفاعت قبول ہو گی ( تو میری شفاعت کے نتیجے میں ) ہر وہ شخص جہنم سے نکل آئے گا ، جو اللہ تعالیٰ کی رحمت اور میری شفاعت پر یقین رکھتا ہو ۔"""" یہ روایت امام طبرانی نے نقل کی ہے ، اسحاق بن یحیی نامی راوی نے حضرت عبادہ رضی اللہ عنہ کا زمانہ نہیں پایا ہے ، اس روایت کے بقیہ رجال ثقہ ہیں ۔"
"18513","أذعشحأڬؼثأثىأوتهڬأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أمۏتوحأڬەأزىأهًڲًڽأڬًأزًثتشۄأصىزۄأڬۏتأدتةەأڲتأ؏أحًأوۏڽأتًشأوۏشۏأتْوحأمۏتوحأڬەأزىأتۏڬأټۏهەأځشأۄًڽأڲەأ؏أوۏشتأځشًشزڲتشأودہەأضثصأذهۄأځۄىتةەأڲتأ؏أځہشأًۄأودہەأتدتصحأزەأڲتأحًأوۏڽأتْضأڬۏأطتىأڬەأوغتثمأتضأڬۏأخىتؤأثۏتىأڬشًڽأڲتأ؏أۏۄأ““أومتوأ‛‛أوذوًزأۄًأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأڬثۏشأتًشأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأ؏أوؼدوأڬثۏشأڬۏأزًأتضىتزأوۏڽأضەأتۏڬأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18514","أذعشحأذسۏلۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأوۏڽأضثأهًڲًڽأڬتأضشزتشأۄًاڽأڲتأ؏أوۏشتأځشًشزڲتشأودہەأثهتةەأڲتأ؏أوۏڽأڬۄًڽأڲتأ=أوۏڽأذتعشأۄًڽأ‛أضؼتزحأحۏشۏأغشلأضەأذتظهأۄًحۏأۄەأ؏أثہهتةۏأحۏشەأۄتحہًڽأوۏڽأۄەأ؏أحًأثشڬحأًتهتأۄەأ؏أحًأثهىزأًأثشحشأۄەأ؏أوۏڽأحۏشۏأوۄشثتىۏأوۏڽأذتعشأۄًڽأ؏أًۄأۄزتۏحأۏتلحۄأۄەأ؏أدضەأحًأىەأۄزتۏحأؼغتأڬۏأۄًأ؏أحۏشتأثىزۄأحۏشەأضتوىەأۄەأ؏أحۏشەأومتثهەأوۏڽأځىتۄأڲتۄ تًشأدتةەأىدتحأظشلأحۏشۏأستحأۄەأ؏أحًأثشڬحأًتهتأۄەأتًشأثهىزأًأثشحشأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأهۏخأثىأتثًضهۏوأۄەأتًشأًۄأوزهضأۄەأ؏أتضأشًتۏحأڬەأثمۏۄأشدتهأخمۄأۄۏڽأۗ"
"18515","أذعشحأذسۏلۄأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أتههۄأحؼتهۏٳأضثأهًڲًڽأڬًأتۏڬأوۏزتىأوۏڽأتڬټہتأڬشەأڲتأ؏أڬًةۏأطرظأڬهتوأىۄۏڽأڬشأضڬەأڲتأ؏أضثأضەأځۄهەأذعشحأوذوزأ﷽أڬهتوأڬشۏڽأڲەأتًشأًۄأۏۄأڬۄۏڽأڲەأ= أ““أوۏڽأذتعشأۄًڽأ؏أضؼتزحأوىزۏأحۏشۏأغشلأضەأذتظهأۄًحۏأۄەأ؏أثہهتةۏأحۏشەأزضحأمزشحأوۏڽأۄەأ؏أثشتةۏأحۏشۏأغشلأىۄۏڽأدتأضڬحۏأ؏أۄزتۏحأۏتلحۄأًۄأۄەأدضەأحًأىەأۄزتۏحأؼغتأڬۏأۄًأ؏أحۏشتأثىزۄأحۏشەأضتوىەأۄەأ؏أحۏشۏأوززأضەأۄەأ؏أحۏشۏأغشلأهًټىەأًتهتأۄەأ؏أحۏشەأومتثهەأوۏڽأڬًةۏأځىتۄأڲتۄأتًشأدتةەأىدتحأىۄۏڽأۄەأ؏أظشلأحۏشۏأۄۏأستحأۄەأ؏أحًأثشڬحأًتهت"
"18516","أذعشحأؼهۏأثىأتثًغتهثأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أوۏڽأتځىۏأتوحأڬۏأطلتؼحأڬشًڽأڲتأ؏أۏۄتڽأحڬأڬۄأوۏشتأځشًشزڲتشأودہەأورتغثأڬشأڬەألشوتةەأڲتأ=أتەأوذوزأ$أحوأشتعۏأۄًأڲةەأآأوۏڽأؼشعأڬشًڽأڲتأ=أتەأوۏشەأځشًشزڲتشأ$أحذمۏمأوۏڽأشتعۏأۄًأڲۏتأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأىەأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأ؏أتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأوذوزأثىأتذوزأثىأصۏزأوزتشۏأۄەأتًشأوۏڽأتْضأضەأًتملأىۄۏڽأۄًڽأ؏أتضأشًتۏحأڬەأثمۏۄأشدتهأڬۏأحًخۏمأڬۏأڲةۏأۄەأ؏أتڲشډۄأتْىأوۏڽأضەأثؼعأوۏڽأعؼلأځتۏتأدتحتأۄەأۗ"
"18517","أذعشحأؼثزتههۄأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أتۏڬأوشحثۄأۄوأىثۏأتڬشوأ﷽أڬەأڲہشأڬەأظذىأوۏڽأ+أطتۏزأۏۄأوشتزأۄەأإځأڬەأڲہشأڬەأثتۄشأ,أوًدًزأحہەأ؏أتضۏأزًشتىأإځأۄوتشەأځتضأحطشۏلأهتةەأ؏أإځأڬتأډۄشۄأوثتشڬأډوڬأشۄتأحہتأتًشأدڲوڲتأشۄتأحہتأ؏أإځأڬەأډۄشەأڬًأزۏڬہأڬشأۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أتههۄأحؼتهۏٳأإځأڬًأرًطأشڬہەأ؏أإځأڬەأډۄشەأڬۏأډوڬأتًشأرًطۏأزۏڬہأڬشأۄوۏڽأثہۏأرًطۏأۄًةۏأۄەأ؏أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أتثہۏأدثشتةۏهأوۏشەأځتضأإةەأتًشأتىۄًڽأىەأودہەأۏۄأرًطرثشۏأزۏأڬۄأتههۄأحؼتهۏٳأىەأودہەأطلتؼحأؼغتأڬۏأۄەأ؏أۄوأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أڬۏتأۏۄأثىًأۄتطوأڬەأثتشەأوۏڽأورظًظأۄەأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۏأىۄۏڽأ$أۄوأىەأزشۏتلحأڬۏتأ=أڬۏتأۏۄأمشۏطأڬەأثتشەأوۏڽأورظًظأۄەأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۏأىۄۏڽأ$أۄوأىەأزشۏتلحأڬۏتأ=أڬۏتأإځأڬۏأتوحأڬەأثتشەأوۏڽأۄەأآأىثۏأتڬشوأ﷽أىەألشوتۏتأ=أۏۄأوۏشۏأتوحأڬەأڲىتۄأڲتشأثًدہهأهًڲًڽأڬەأهةەأۄەأۗ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأڬثۏشأتًشأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأؼثزتهًتذزأىظشۏأۄەأدًأثؼزأڬەأصوتىەأڬتأۄەأ؏أتضأىەأتًصتؼۏأضەأشًتۏتحأىمهأڬۏأۄۏڽأتًشأوۏڽأتضأضەأًتملأىۄۏڽأۄًڽأ؏أتضأشًتۏحأڬەأثمۏۄأشدتهأخمۄأۄۏڽأۗ"
"18518","أذعشحأتثًتوتوۄأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أتځىۏأتوحأڬەأثشەأهًڲًڽأڬەأهةەأضثأضەأثۄحشأ““أوۏڽأ‛‛أۄًڽأۗ‛‛أإځأڬەأضتحہأثۏټہەأۄًةەأهًڲًڽأوۏڽأضەأتۏڬأظتذثأىەأإځأڬۏأرزوحأوۏڽأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أتىأڬەأثۄحشأهًڲًڽأڬەأهۏەأإځأڬۏضەأۄًڽأڲەأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۄتڽأحڬأوۏشۏأتوحأڬەأثشەأهًڲًڽأڬتأحؼهمأۄەأ؏أحًأتههۄأحؼتهۏٳأوۏشۏأطلتؼحأڬۏأًدۄأضەأتىۄۏڽأدىحأوۏڽأزترهأڬشەأڲتأ؏أدۄتڽأحڬأىۏڬأهًڲًڽأڬتأحؼهمأۄەأ؏أحًأتههۄأحؼتهۏٳأتىأڬەأتؼوتهأڬۏأًدۄأضەأتىۄۏڽأدىحأوۏڽأزترهأڬشأزەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأڬثۏشأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأدوۏؼأثىأخًثأشذثۏأۄەأتضأوۏڽأدۏوأځشأصثشأۄەأتًشأوۏوأځشأځۏطأۄەأ؏أوطۄًشأمًهأۏۄۏأۄەأ؏أتۏڬأمًهأڬەأوغتثمأۏۄأهلػأتضوأحظؽۏشأڬەأغًشأځشأۄەأ؏أتوتوأثرتشۏأىەأتضأشتًۏأڬەأثتشەأوۏڽأۏۄأڬۄتأۄەأ=أۏۄأوىڬشأتهذزۏخأۄەأ؏أتوتوأىضتةۏأىەأڬۄتأۄەأ=أۏۄأوحشًڬأتهذزۏخأۄەأ؏أتثىأؼزۏأڬۄحەأۄۏڽأ=أتضأڬۏأشًتۏتحأتضأثتحأځشأزهتهحأڬشحۏأۄۏڽأڬۄأۏۄأعؼۏلأۄەأ؏أتضأشًتۏحأڬەأثمۏۄأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18519","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأ=أتۏڬأزىأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أوۏشۏأطلتؼحأوۏشۏأتْوحأڬەأڬثۏشۄأڲىتۄأڬشىەأًتهًڽأڬەأهةەأۄًأڲۏأۗ‛‛أ ذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأىەألشوتۏتأ=أ أ““أثہهتةۏأڬۏأغشلأضثمحأهەأدتىەأًتهەأهًڲأڬضۏأذضتثأڬەأثؽۏشأدىحأوۏڽأزترهأۄًڽأڲەأ؏أوۏتىۄأشًۏأترحۏتشأڬشىەأًتهەأهًڲأتههۄأحؼتهۏٳأڬۏأشذوحأڬۏأًدۄأضەأدىحأوۏڽأزترهأۄًڽأڲەأتًشأتځىەأتًځشأػهوأڬشىەأًتهەأهًڲأتًشأتؼشتلأوۏڽأشۄىەأًتهەأهًڲأ؏أذعشحأوذوزأ﷽أڬۏأطلتؼحأڬۏأًدۄأضەأدىحأوۏڽأزترهأۄًڽأڲەأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأڬثۏشأوۏڽأىمهأڬۏأۄەأتًشأوؼدوأتًضغأوۏڽأترحظتشأڬەأضتحہأتضأظذتثۏأڬەأذًتهەأضەأىمهأڬۏأۄەأ؏أتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأوًضۏٳأثىأؼثزتهشذوىأضىتىۏأۄەأتًشأًۄأذزۏخأتۏدتزأڬشىەأًتهتأطرظأۄەأۗ"
"18520","عبداللہ بن عمرو سے روایت ہے کہ نبی ﷺ نے فرمایا: ""میں شفاعت اور یہ کہ میری امت کا نصف حصہ جنت میں داخل ہو کے درمیان مخیر تھا، تو میں نے شفاعت کو چنا کیونکہ یہ وسیع تر اور بہتر ہے، کیا تم سمجھتے ہو کہ یہ متقین کے لیے ہے؟ نہیں، بلکہ یہ گناہگاروں اور خطا کاروں کے لیے ہے جو گناہوں میں لپٹے ہوئے ہیں۔"" زیاد نے کہا: گویا یہ ہم ہیں، لیکن جو ہمیں سنایا گیا ہم نے وہی بیان کیا۔ اسے احمد اور طبرانی نے روایہ کیا ہے، سوا اس کے کہ طبرانی نے یوں روایہ کیا: ""گویا یہ مومن متقین کے لیے نہیں ہے، بلکہ یہ گناہگاروں، خطا کاروں اور گناہوں میں لپٹے ہوئے لوگوں کے لیے ہے۔"" اور طبرانی کے رواة صحیح کے رواة ہیں سوا نعمان بن قراد کے جو معتبر ہیں۔"
"18521","أذعشحأتىضأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أوۏشۏأطلتؼحأوۏشۏأتوحأڬەأڬثۏشۄأڲىتۄأڬشىەأًتهًڽأڬەأهةەأۄًأڲۏأۗ‛‛أ أۏۄأشًتۏحأتوتوأثصتشأىەأتًشأتوتوأغثشتىۏأىەأوؼدوأظؽۏشأتًشأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأۗ"
"18522","أتىأزًىًڽأوۏڽأتۏڬأشًتۏحأوۏڽأۏۄأتهلتػأۄۏڽأ=أ أ““أطلتؼحأڬًأوۏشۏأتوحأڬەأڬثۏشۄأڲىتۄأڬشىەأًتهًڽأڬەأهۏەأثىتۏتأڲۏتأۄەأۗ‛‛ أتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأرصشدأثىأؼخوتىأۄەأدضەأتثىأذثتىأىەأخمۄأمشتشأزۏتأۄەأتًشأتۏڬأضەأصۏتزۄأتلشتزأىەأتضەأعؼۏلأڬۄتأۄەأ؏أۄصتشأڬەأثمۏۄأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18523","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أ أ““أځۄهەأۄوأڬثۏشۄأڲىتۄأڬشىەأًتهًڽأڬەأهۏەأزؼتةەأوؽلشحأڬشىەأضەأثتصأشۄحەأحہەأ؏أۏۄتڽأحڬأڬۄأۄوأىەأتځىەأىثۏأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأ="
"18524","ام سلمہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""کام کر اور تواکل نہ کر؛ کیونکہ میری شفاعت میری امت کے ہلاک ہونے والوں کے لیے ہے۔"" اسے طبرانی نے روایہ کیا ہے، اور اس میں عمر بن مخرم شامل ہیں جو ضعیف ہیں۔"
"18525","أذعشحأثشۏزيأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأذعشحأوؼتًۏۄأشعۏأتههۄأؼىۄأڬەأځتضأإۏتأحًأًۄتڽأتۏڬأطرظأڬهتوأڬشأشۄتأحہتأ؏أذعشحأثشۏزۄأشعۏأتههۄأؼىۄأىەأڬۄتأ=أتەأذعشحأوؼتًۏۄأ$أڬۏتأإځأودہەأڬهتوأڬشىەأڬۏأتدتصحأزۏڽأڲەأآأتىۄًڽأىەألشوتۏتأ=أدۏأۄتڽأ$أًۄأۏۄأضودہەأڬۄأۏۄأثہۏأتضۏأغشذأڬهتوأڬشۏڽأڲەأدضأغشذأزًضشتأطرظأڬشأشۄتأحہتأ؏أذعشحأثشۏزۄأشعۏأتههۄأؼىۄأىەأڬۄتأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ="
"18526","أذعشحأثشۏزيأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ"
"18527","أذعشحأتىۏضأتىظتشۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ"
"18528","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أوۏڽأدۄىوأڬەأزشًتصەأڬەأځتضأإاڽأڲتأتًشأتضأڬەأزشًتصەأڬًأڬہټڬہټتاڽأڲتأ؏أًۄأوۏشەأهةەأڬہًهأزۏتأدتةەأڲتأ؏أوۏڽأتْضأوۏڽأزترهأۄًأدتاڽأڲتأ؏أځہشأوۏڽأتههۄأحؼتهۏٳأڬۏأتۏضۏأذوزأثۏتىأڬشًڽأڲتأڬۄأتههۄأحؼتهۏٳأڬۏأتضأغشذأضەأذوزأ؏أودہأضەأځۄهەأڬضۏأىەأثۏتىأىۄۏڽأڬۏأۄًأڲۏأ؏أتًشأىۄأۄۏأوۏشەأثؼزأڬًةۏأتضأغشذأذوزأثۏتىأڬشەأڲتأ؏أځہشأوۏڽأًۄتڽأضەأۄشأتضأطرظأڬًأىڬتهًڽأڲتأدضأىەأترهتظأڬەأضتحہأهتأتهۄأتهتأتههۄأځڔہتأۄًأڲتأ؏أځہشأمشۏطأڬەأڬډہأهًڲأوۏشەأضتوىەأڬہڔەأۄًڽأڲەأ؏أًۄأوۏشەأضتوىەأتځىتأىضثأثۏتىأڬشۏڽأڲەأ؏أوۏڽأتىأڬەأىضثأڬًأځۄډتىأهًڽأڲتأ؏أهۏڬىأوۏڽأتىأڬەأډۄشًڽأڬًأىۄۏڽأځۄډتىًڽأڲتأتًشأوۏڽأتىۄۏڽأدۄىوأوۏڽأډہًڔأزًڽأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتىۄًڽأىەأتځىەأتضحتزأؼهۏأثىأضؼۏزأشتصۏأڬەأذًتهەأضەأتضأڬًأىمهأڬۏتأۄەأدضأوۏڽأڬوصًشۏأځتةۏأدتحۏأۄەأتًشأتضأڬۏأضىزأوۏڽأتۏضەأشتًۏأۄۏڽأ؏أدىأضەأوۏڽأًتملأىۄۏڽأۄًڽأۗ"
"18529","أذعشحأدتثشأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أتۄهأدىحأڬډہأتۏضەأتلشتزأڬًأؽۏشأوًدًزأځتةۏڽأڲەأدىأضەأًۄأزىۏتأوۏڽأًتملأحہەأ؏أًۄأتىثۏتؤأڬەأځتضأإةۏڽأڲەأتًشأتىأهًڲًڽأڬتأسڬشأڬشۏڽأڲەأتًشأتىأهًڲًڽأڬەأثتشەأوۏڽأطلتؼحأڬشۏڽأڲەأحًأتْىأڬۏأطلتؼحأمثًهأڬۏأدتةەأڲۏأتًشأتىأهًڲًڽأڬًأ““أغهمتؤأ‛‛أڬۄتأدتةەأڲتأًۄأضثأ““أغهمتؤأ‛‛أۄًڽأڲەأ؏أتْىأځشأإثأذۏتحأڋتهتأدتةەأڲتأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتًشأتضأڬۏأضىزأذضىأۄەأۗ"
"18530","عبداللہ بن مسعود سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""بے شک بعض مسلمان جنت میں داخل ہوں گے جنہیں اللہ کی رحمت اور شفاعت کرنے والوں کی شفاعت کی وجہ سے آگ میں عذاب دیا گیا ہوگا۔"" اسے طبرانی نے روایہ کیا ہے، اور اس میں بعض ایسے لوگ شامل ہیں جنہیں میں نہیں جانتا۔"
"18531","أذعشحأوؽۏشۄأثىأطؼثۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أڬډہأهًڲأدۄىوأضەأىڬهۏڽأڲەأ؏أدىحأوۏڽأتىأڬتأىتوأ†أدۄىوۏأ‛‛أشڬہتأدتةەأڲتأ؏أًۄأهًڲأتههۄأحؼتهۏٳأضەأۏۄأزؼتأڬشۏڽأڲەأڬۄأتىأڬتأۏۄأىتوأحثزۏهأڬشأزۏتأدتةەأ؏أحًأتههۄأحؼتهۏٳأتىأڬتأۏۄأىتوأوذًأڬشأزەأڲتأ؏أدثأًۄأهًڲأدۄىوأضەأىڬهۏڽأڲەأحًأًۄأۏًڽأتْڲۏڽأڲەأدضأغشذأځشأتڲحتأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأؼثزتهشذوىأثىأتضذتمأۄەأتًشأًۄأعؼۏلأۗ"
"18532","جابر بن عبداللہ سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: ""میری امت کے بعض لوگ اپنے گناہوں کی وجہ سے عذاب پائیں گے، تو وہ آگ میں وہ رہیں گے جو اللہ چاہے، پھر مشرک انہیں تانا ماریں گے کہ: ہمیں نہیں نظر آتا کہ جو تم تصدیق اور ایمان رکھتے تھے اس نے تمہیں کیا فائدہ دیا؟ تو کوئی موحد نہ رہے گا سوا اس کے کہ اللہ اسے نکال لے۔"" پھر رسول اللہ ﷺ نے یہ آیت پڑھی: ""شاید کافر چاہیں گے کہ وہ مسلمان ہوتے۔"" میں نے کہا: جابر کے پاس صحیح میں اس سیاق سے مختلف دیگر احادیث بھی ہیں۔ اسے طبرانی نے اوسط میں روایہ کیا ہے، اور اس کے رواة صحیح کے رواة ہیں سوا بسام صرافی کے جو معتبر ہیں۔"
"18533","حضرت انس بن مالک رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" لا الہ الا اللہ کے ماننے والوں میں سے کچھ لوگ جہنم میں اپنے گناہوں کی وجہ سے داخل ہوں گے ، تو لات اور عزیٰ کے ماننے والے اْن سے یہ کہیں گے : تمہارا لا الہ الا اللہ کہنا ، تمہارے کس کام آیا ء جبکہ تم بھی ہمارے ساتھ جہنم میں ہو ، اللہ تعالیٰ ان ( کافر ) لوگوں پر غضبناک ہو گا اور ان ( یعنی گناہ گار اہل ایمان ) کو ( جہنم سے ) نکال دے گا اور انہیں نہر حیات میں ڈالے گا ، تو وہ جلنے کے اثر کے حوالے سے یوں ٹھیک ہو جائیں گے جس طرح چاند کا گرہن ختم ہوتا ہے ، پھر وہ جنت میں داخل ہو جائیں گے ، تو اہل جنت انہیں """" جہنمی """" کا نام دیں گے ۔"""" ایک شخص نے کہا : اے حضرت انس ! کیا آپ نے خود یہ ( حدیث ) نبی اکرم ﷺ کی زبانی سنی ہے ء حضرت انس رضی اللہ عنہ نے فرمایا : میں نے نبی اکرم ﷺ کو یہ ارشاد فرماتے ہوئے سنا ہے : """" جو شخص جانتے بوجھتے ہوئے میری طرف جھوٹی بات منسوب کرے ، وہ جہنم میں اپنے مخصوص ٹھکانے تک پہنچنے کے لیے تیار رہے ۔"""" ( پھر حضرت انس رضی اللہ عنہ نے فرمایا : ) میں نے نبی اکرم ﷺ کو یہ بات فرماتے ہوئے سنا ہے ( یعنی وہ حدیث جو اس سے پہلے بیان ہو چکی ہے ) ۔ یہ روایت امام طبرانی نے معجم اوسط میں نقل کی ہے اور اس کی سند میں ایسے راوی ہیں ، جن سے میں واقف نہیں ہوں ۔"
"18534","أذعشحأتىضأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أتههۄأحؼتهۏٳألشوتةەأڲتأ=أتضأڬًأدۄىوأضەأىڬتهأزًأ$أدضأڬەأزهأوۏڽأدًأڬەأزتىەأڬەأًصىأدحىتأتۏوتىأۄًأ؏أځہشأًۄألشوتةەأڲتأ=أتضأڬًأدۄىوأضەأىڬتهأزًأدضأڬەأزهأوۏڽأشتةۏأڬەأزتىەأڬەأًصىأدحىتأتۏوتىأۄًأ؏أځہشأًۄألشوتةەأڲتأ=أودہەأتځىۏأؼصحأتًشأتځىەأدهتهأڬۏأمضوأۄەأ؏أدضأطرظأىەأزىأۏتأشتحأڬۏأڲہڔۏأثہشأڬەأهۏەأودہأځشأتۏوتىأشڬہتأۄًأ؏أوۏڽأتضەأتضأطرظأڬۏأوتىىزأىۄۏڽأثىتاڽأڲتأ؏أدضأىەأودہأځشأتۏوتىأىۄۏڽأشڬہتأۗ‛‛"
"18535","اور عبداللہ بن مسعودؓ سے روایت ہے کہ انہوں نے کہا: ""شفاعت لوگوں کے لیے جاری رہتی ہے اور وہ آگ سے نکلتے رہتے ہیں، یہاں تک کہ ابلیس ابالیس (بڑی شیطان) اس کے لئے اپنی گردن لمبی کرتا ہے امید میں کہ اسے بھی پہنچ جائے۔"" طبرانی نے اسے موقوفاً روایا ہے، اور اس میں کثیر بن یحیی صاحب بصری ہے، جو ضعیف ہے۔"
"18536","اور ابن عباسؓ سے روایت ہے کہ انہوں نے کہا: رَسُولُ اللہِ ﷺ نے فرمایا: ""انبیاء کے لئے نور کے منبر رکھے جائیں گے پر وہ ان پر بیٹھیں گے، اور میرا منبر رہ جائے گا، میں اس پر نہ بیٹھوں گا، یا اس پر نہ بیٹھوں گا کھڑا ہو کر اپنے رب کے سامنے [اپنی امت کے لئے کھڑا ہو کر] اس ڈر سے کہ مجھے جنت کی طرف بھیج دیا جائے اور میری امت میرے بعد رہ جائے، تو میں کہوں گا: اے رب! میری امت! میری امت! تو اللہ عزوجل فرماۓ گا: اے محمد! تم اپنی امت کے ساتھ کیا کرنا چاہتے ہو؟ تو میں کہوں گا: اے رب! ان کا حساب جلد کر دو، تو ان کو بلایا جائے گا تو ان کا حساب لیا جائے گا، تو ان میں سے جو جنت میں داخل ہوں گے اس کی رحمتی سے، اور جو جنت میں داخل ہوں گے میری شفاعت سے، تو میں شفاعت کرتا رہوں گا یہاں تک کہ مجھے کچھ لوگوں کے بارے میں ہدایات مل جائیں گے جنہیں آگ کی طرف بھیجا جا چکا ہوگا، یہاں تک کہ مالک خازن جہنم کہے گا: اے محمد! تم نے اپنے رب کے غصبے میں اپنی امت کے لئے کسی عذاب کو باقی نہیں چھوڑا۔"" طبرانی نے اسے کبیر اور اوسط میں روایا ہے، اور اس میں محمد بن ثابث بنانی ہے، جو ضعیف ہے۔"
"18537","أذعشحأذسۏلۄأشعۏأتههۄأؼىۄأوشلًؼأذزۏخأڬەأغًشأځشأۏۄأثتحأىمهأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ"
"18538","أذعشحأؼثزتههۄأثىأؼوشأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أتځىۏأتوحأوۏڽأضەأ؏أوۏڽأضثأضەأځۄهەأدىأڬۏأطلتؼحأڬشًڽأڲتأًۄأوۏشەأتۄهأثۏحأۄۏڽأتًشأځہشأزشدۄأثزشدۄأمشۏثۏأؼصۏصأۄۏڽأ؏أدىأڬتأحؼهمأمشۏطأتًشأتىظتشأضەأۄەأ؏أځہشأًۄأهًڲأۄًڽأڲەأدًأودہأځشأتۏوتىأهتةەأتًشأدىۄًڽأىەأوۏشۏأځۏشًۏأڬۏأ؏أدىأڬتأحؼهمأتۄهأۏوىأضەأۄەأ؏أځہشأثتمۏأحوتوأؼشثًڽأڬۏأ؏أځہشأؼدوۏًڽأڬۏأتًشأضثأضەأځۄهەأوۏڽألعۏهحأًتهەأهًڲًڽأڬۏ طلتؼحأڬشًڽأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏضەأشتًۏأۄۏڽأدىأضەأوۏڽأًتملأىۄۏڽأۄًڽأۗ"
"18539","أذعشحأؼثزتهوهڬأثىأؼثتزأثىأدؼلشأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أتىۄًڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ= أ““أتځىۏأتوحأوۏڽأضەأ؏أوۏڽأضثأضەأځۄهەأدضأڬۏأطلتؼحأڬشًڽأڲتأًۄأتۄهأوزۏىۄأتًشأتۄهأوڬۄأتًشأتۄهأغتةلأۄۏڽأۗ‛‛ أۏۄأشًتۏحأتوتوأثصتشأتًشأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأشتًۏًڽأڬۏأتۏڬأتۏضۏأدوتؼحأۄەأدضأضەأوۏڽأًتملأىۄۏڽأۄًڽأۗ"
"18540","أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ= أ““أمۏتوحأڬەأزىأتههۄأحؼتهۏٳأذعشحأإزوأؼهۏۄأتهضهتوأڬۏأطلتؼحأڬًأمثًهأڬشەأڲتأدًأتْىأڬۏأضتشۏأتًهتزأوۏڽأضەأتۏڬأضًأۄصتشأ؏أۄصتشأتًشأزضأۄصتشأ؏أۄصتشأهًڲًڽأڬەأثتشەأوۏڽأۄًأڲۏأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأۏصۏزأشمتطۏأۄەأتًشأًۄأعؼۏلأۄەأۗ"
"18541","أرشطۄأثىأذشأثۏتىأڬشحەأۄۏڽأ=أوۏڽأوزۏىۄأوىًشۄأإۏتأ؏أوۏشۏأوهتمتحأذعشحأؼثزتههۄأثىأضهتوأشدۏأتههۄأؼىۄأضەأۄًةۏأ؏أتىہًڽأىەألشوتۏتأ=أڬۏتأوۏڽأحوۄۏڽأتۏضۏأذزۏخأثۏتىأىۄأڬشًڽأآأدضأڬتأسڬشأتههۄأڬۏأڬحتثأوۏڽأۄەأ؏أځہشأتىۄًڽأىەأًۄأذزۏخأثۏتىأڬۏأدضأوۏڽأتىأهًڲًڽأڬتأسڬشأۄەأدًأدۄىوأضەأىڬهۏڽأڲەأتًشأذعشحأإزوأؼهۏۄأتهضهتوأڬۄۏڽأڲەأ=أتەأوۏشەأځشًشزڲتشأ$أوۏشەأثډەأدهأشۄەأۄۏڽأ؏أحًأتىۄۏڽأًۄتڽأضەأىڬتهأزۏتأدتةەأڲتأ+أۏؼىۏأذعشحأإزوأؼهۏۄأتهضهتوأڬۏأتًهتزأڬًأدۄىوأضەأىڬتهأزۏتأدتةەأڲتأ,أۗ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18542","أذعشحأؼخوتىأؽىۏأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ= أ““أمۏتوحأڬەأزىأضثأضەأځۄهەأتىثۏتؤأڬۏأ؏أځہشأطۄزتؤأڬۏأتًشأځہشأواسىۏىأڬۏأطلتؼحأمثًهأۄًأڲۏأۗ‛‛"
"18543","أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أشًصۄأتًشأمشإىأ؏أمۏتوحأڬەأزىأثىزەأڬۏأطلتؼحأڬشۏڽأڲەأ؏أشًصۄأڬۄەأڲتأ=أتەأوۏشەأځشًشزڲتشأ$أوۏڽأىەأتضەأڬہتىەأضەأتًشأىلضتىۏأرًتۄطأځًشۏأڬشىەأضەأشًڬەأشڬہتأ؏أحًأتضأڬەأثتشەأوۏڽأوۏشۏأطلتؼحأمثًهألشوتأهەأ$أمشإىأڬۄەأڲتأ=أوۏڽأىەأتضەأشتحأڬەأًمحأضًىەأضەأشًڬەأشڬہتأ؏أحًأتضأڬەأثتشەأوۏڽأوۏشۏأطلتؼحأمثًهألشوتأهەأ$أىثۏأتڬشوأ﷽ألشوتحەأۄۏڽأ=أحًأتْىأزًىًڽأڬۏأطلتؼحأمثًهأۄًأڲۏأۗ‛‛أ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتًشأتضأڬۏأضىزأذضىأۄەأ؏أتڲشډۄأتثىأهۄۏؼۄأىتوۏأشتًۏأوۏڽأعؼلأځتۏتأدتحتأۄەأ؏أًۏضەأتضأڬۏأحًخۏمأڬۏأڲةۏأۄەأۗ"
"18544","أذعشحأتثًتوتوۄأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ= أ““أتۏڬأطرظأدًأىثۏأىۄۏڽأۄًأڲتأ؏أتْضأڬۏأطلتؼحأڬۏأًدۄأضەأزًأمثۏهًڽأشثۏؼۄأتًشأوعشأڬۏأحؼزتزأوۏڽأهًڲأدىحأوۏڽأزترهأۄًڽأڲەأ؏أتۏڬأطرظأىەأؼشعأڬۏأ=أۏتأشضًهأتههۄأ$أڬۏتأشثۏؼۄأ؏أوعشأڬتأذظۄأىۄۏڽأۄۏڽأآأىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أدۏضتأوۏڽأىەأڬۄتأۄەأ؏أًۏضتأۄۏأۄەأۗ‛‛ أۏۄأشًتۏحأتوتوأتذوزأتًشأتوتوأغثشتىۏأىەأورحهلأتضتىۏزأڬەأضتحہأىمهأڬۏأۄەأ؏أتوتوأتذوزأڬەأشدتهأتًشأغثشتىۏأڬۏأورحهلأتضتىۏزأوۏڽأضەأتۏڬأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأؼثزتهشذوىأثىأوۏضشۄأڬتأوؼتوهۄأورحهلأۄەأتًشأًۄأخمۄأۄەأۗ"
"18545","أذعشحأتثًثشصۄأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أوۏڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ أ““أوۏشۏأتْوحأوۏڽأتۏضتألشزأثہۏأۄًأڲتأدًأشثۏؼۄأتًشأوعشأضەأصۏتزۄأحؼزتزأوۏڽأهًڲًڽأڬۏأطلتؼحأڬشەأڲتأتًشأوۏشۏأتوحأضەأحؼهمأشڬہىەأًتهتأتۏضتألشزأثہۏأۄًأڲتأدًأدۄىوأوۏڽأثڔتأۄًأڲتأۏۄتڽأحڬأڬۄأًۄأدۄىوأڬەأتشڬتىأوۏڽأضەأتۏڬأشڬىأۄًأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأخمۄأۄۏڽأۗ"
"18546","أذعشحأتثًتوتوۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أوۏشۏأتوحأڬەأتۏڬأطرظأڬۏأطلتؼحأڬۏأًدۄأضەأوعشأمثۏهۄأڬەأهًڲًڽأڬۏأحؼزتزأضەأصۏتزۄأهًڲأدىحأوۏڽأزترهأۄًڽأڲەأ؏أڬًةۏأطرظأتځىەأتۄهأرتىۄأڬەأثتشەأوۏڽأطلتؼحأڬشەأڲتأ؏أإزوۏأتځىەأؼوهأڬەأذضتثأضەأطلتؼحأڬشەأڲتأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأ؏أظشلأتثًؽتهثأڬتأوؼتوهۄأورحهلأۄەأ؏أتۏڬأضەأصۏتزۄأتلشتزأىەأتضەأخمۄأمشتشأزۏتأۄەأتًشأتضأوۏڽأعؼلأځتۏتأدتحتأۄەأۗ"
"18547","أذعشحأتىضأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ أ““أمۏتوحأڬەأزىأتۄهأدۄىوأڬًأظلًڽأڬۏأطڬهأوۏڽأځۏطأڬۏتأدتةەأڲتأ؏أواوىۏىأتْىأڬەأځتضأضەأڲصشۏڽأڲەأحًأتۄهأدۄىوأوۏڽأضەأتۏڬأطرظأواوىۏىأوۏڽأضەأتۏڬأطرظأڬًأزۏڬہەأڲتأ؏أدضأضەأًۄأزىۏتأوۏڽأًتملأحہتأتًشأۏۄأڬۄەأڲتأ=أتەألهتڽأ$أڬۏتأحوۄۏڽأۏتزأۄەأآألهتڽأزىأحوأىەألهتڽألهتڽأڬتوأڬەأضهضهەأوۏڽأودہأضەأوززأهۏأحہۏأ؏أىثۏأتڬشوأ﷽ألشوتحەأۄۏڽأ=أحًأواوىأڬًأًۄأثتحأۏتزأإأدتةەأڲۏأ؏أًۄأتْضەأځۄډتىأهەأڲتأتًشأځہشأًۄأتځىەأځشًشزڲتشأڬۏأثتشڲتۄأوۏڽأتضأڬۏأطلتؼحأڬشەأڲتأحًأتضأطرظأڬەأثتشەأوۏڽأتضأڬۏأطلتؼحأمثًهأۄًأڲۏأۗ‛‛ أۏۄأشًتۏحأتوتوأتثًۏؼهۏٳأىەأتًشأتوتوأغثشتىۏأىەأوؼدوأتًضغأوۏڽأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأۏًضلأثىأرتهزأضوحۏأۄەأتًشأًۄأڬستثأۄەأۗ"
"18548","اور انس بن مالکؓ سے روایت ہے کہ انہوں نے کہا: رَسُولُ اللہِ ﷺ نے فرمایا: ""بے شک آدمی دو آدمیوں اور تین آدمیوں کے لئے شفاعت کرتا ہے۔"" بزار نے اسے روایا ہے، اور اس کے راوی صحیح کے راوی ہیں۔"
"18549","حضرت انس رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" دو آدمی ایک ویرانے سے گزر رہے تھے ، ان دونوں میں سے ایک عبادت گزار تھا اور دوسرا گناہ گار تھا ، عبادت گزار کو شدید پیاس محسوس ہوئی ، یہاں تک کہ وہ گر گیا ، اس کے ساتھی نے اس کی طرف دیکھا اس کے ساتھی کے پاس ایک مشکیزہ تھا ، جس میں کچھ پانی موجود تھا ، وہ ساتھی اس کی طرف دیکھنے لگا کہ وہ گرا ہوا ہے ، اْس نے سوچا : اللہ کی قسم ! اگر یہ نیک آدمی پیاس کی وجہ سے مر گیا اور میرے پاس پانی ہوا تو مجھے اللہ تعالی کی طرف سے کبھی کوئی بھلائی نصیب نہیں ہو گی ، لیکن اگر میں نے اپنا پانی پلا دیا ، تو میں مر جااں گا ، اس نے اللہ تعالیٰ پر توکل کیا ، پختہ ارادہ کیا اور اْس ( عبادت گزار ) پر اپنا پانی چھڑکا اور اسے بچا ہوا پانی پلا دیا ، وہ عبادت گزار اٹھ کھڑا ہوا اور اس نے وہ ویرانہ عبور کر لیا ۔ نبی اکرم ﷺ نے ارشاد فرمایا : قیامت کے دن اْس گناہگار کو حساب کے لیے کھڑا کیا جائے گا اور پھر اسے جہنم کی طرف لے جانے کا حکم ہو گا ، فرشتے اسے لے کے چل پڑیں گے ، وہ اس عبادت گزار کو دیکھے گا اور کہے گا : اے فلاں ! کیا تم مجھے پہچانتے ہو ء وہ دریافت کرے گا : تم کون ہو ء وہ جواب دے گا : میں وہ فلاں شخص ہوں ، جس نے ویرانے سے گزرنے کے موقع پر تمہارے لیے ایثار کیا تھا ، تو وہ کہے گا : جی ہاں ! میں نے تمہیں پہچان لیا ہے ، پھر وہ فرشتوں سے کہے گا : تم ٹھہر جاا ! وہ وہاں ٹھہر جائے گا ، وہ ( عبادت گزار ) آئے گا اور کھڑا ہو کر اپنے پروردگار سے دعا کرنا شروع کرے گا اور کہے گا : اے میرے پروردگار ! تو جانتا ہے اس نے مجھ پر جو احسان کیا تھا اور کیسے میرے لیے ایثار کیا تھا ء اے میرے پروردگار ! اس کو مجھے ہبہ کر دے ، تو پروردگار فرمائے گا : وہ تمہارا ہوا !۔ نبی اکرم ﷺ نے فرمایا : تو وہ عبادت گزار آئے گا اور اس شخص کا ہاتھ پکڑ کر اسے جنت میں داخل کروا دے گا ۔ یہ روایت امام ابویعلیٰ نے نقل کی ہے اور اس کے رجال صحیح کے رجال ہیں ، صرف ابوظلال قسملی کا معاملہ مختلف ہے ، ابن حبان اور دیگر حضرات نے اسے ثقہ قرار دیا ہے اور ایک سے زیادہ افراد نے اسے ضعیف کہا ہے ۔"
"18550","أذعشحأتىضأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أتۄهأدىحأضەأحؼهمأشڬہىەأًتهتأتۏڬأطرظأدہتىڬأڬشأتۄهأدۄىوأڬۏأغشلأزۏڬہەأڲتأ؏أحًأتۄهأدۄىوأضەأحؼهمأشڬہىەأًتهتأتۏڬأطرظأځڬتشأڬشأتضەأڬۄەأڲتأ=أتەألهتڽأ$أڬۏتأحوأودہەأځۄډتىحەأۄًأآأدىحۏأڬۄەأڲتأ=أدۏأىۄۏڽأ$أتههۄأڬۏأمضوأ$أوۏڽأحوۄۏڽأىۄۏڽأځۄډتىتأ؏أحوأڬًىأۄًأآأحوۄتشتأضحۏتىتضأۄًأ$أًۄأڬۄەأڲتأ=أوۏڽأًۄأطرظأۄًڽأ؏أدًأزىۏتأوۏڽأحوۄتشەأځتضأضەأڲصشتأحہتأ؏أحًأحوأىەأودہأضەأځۏىەأڬەأهةەأځتىۏأوتىڲتأحہتأ؏أحًأوۏڽأىەأحوۄۏڽأځهتأزۏتأحہتأ؏أتضأڬۏأًدۄأضەأحوأتځىەأځشًشزڲتشأڬۏأثتشڲتۄأوۏڽأوۏشۏأطلتؼحأڬشًأ$أ"
"18551","أطشذثۏهأثىأطلؼۄأ؏أىثۏأتڬشوأ﷽أڬەأتۏڬأظذتثۏأڬەأذًتهەأضەأۏۄأثتحأىمهأڬشحەأۄۏڽأ=أتىۄًڽأىەأىثۏأتڬشوأ﷽أڬًأۏۄأتشطتزألشوتحەأۄًةەأضىتأۄەأ=أ"
"18552","أذعشحأتىضأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أتًشأإځأڬەأڬډہأتظذتثأڬتأڲصشأۄًتأ؏أشتضحەأوۏڽأتۏڬأثډۄأوًدًزأحہتأ؏أدثأتضأڬۏأوتڽأىەأتىأهًڲًڽأڬًأإحەأۄًةەأزۏڬہتأحًأتضەأۏۄأتىزۏطۄأۄًتأڬۄأڬۄۏڽأًۄأثډۄأځۏشًڽأحهەأىۄأإأدتةەأ؏أًۄأزًڔحۏأۄًةۏأإةۏأ؏أًۄأۏۄأڬۄۄأشۄۏأحہۏأ=أوۏشتأثډۄأ؏أوۏشتأثډۄأ؏أتْضأىەأزًڔأڬەأإأڬەأتضأثډەأڬًأځڬڔأهۏتأ؏أهًڲًڽأىەأڬۄتأ=أۏتأشضًهأتههۄأ$أۏۄأؼًشحأتځىەأثډەأڬًأإڲأوۏڽأىۄۏڽأڋتهەأڲۏأشتًۏأڬۄحەأۄۏڽأ=أحًأىثۏأتڬشوأ﷽أىەأتىأڬۏأغشلأزۏڬہتأتًشأتشطتزألشوتۏتأ=أتههۄأحؼتهۏٳأثہۏأتځىەأوذثًثأثىزًڽأڬًأإڲأوۏڽأىۄۏڽأڋتهەأڲتأۗأ أۏۄأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأتًشأتوتوأثصتشأىەأتضأڬۏأوتىىزأىمهأڬۏأۄەأتًشأتوتوأتثًۏؼهۏٳأىەأىمهأڬۏأۄەأتًشأتىأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18553","أذعشحأؼوشأثىأرغتثأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ=أڬډہأمۏزۏأىثۏأتڬشوأ﷽أڬەأځتضأإةەأ111111أ+أؼهتوۄأۄۏخوۏألشوتحەأۄۏڽأ=أ,أوۏڽأۏۄأڬۄحتأۄًڽأ=أتضأڬەأثؼزأتىۄًڽأىەأځًشۏأذزۏخأسڬشأڬۏأۄەأ؏أدضأوۏڽأإڲەأډهأڬشأۏۄأتهلتػأۄۏڽأ="
"18554","اور ابن مسعودؓ سے: کہ رَسُولُ اللہِ ﷺ نے فرمایا: ""کچھ لوگ آگ میں ہوں گے جتنا اللہ چاہے کہ وہ رہیں، پھر اللہ ان پر رحم کرے گا تو انہیں اس سے نکالے گا، تو وہ جنت کے ادنیٰ حصے میں ہوں گے، تو وہ ایک نھر میں نہائیں گے جسے حیوان کہتے ہیں، جنت کے لوگ انہیں جہنمی کہیں گے، اگر ان میں سے کوئی جنت کے لوگوں کو دعوت دے تو وہ انہیں کھلائے گا، پिलائے گا، اور انہیں کپڑے پہنائے گا۔"" اور مجھے نہیں لگتا کہ اس نے یہ نہیں کہا: ""اور انہیں شادی بھی کرائے گا، اس سے اس کو کوئی کمی نہیں پہنچے گی۔"" احمد اور ابو یعلی نے اسے روایا ہے، اور ان دونوں کے راوی صحیح کے راوی ہیں سواہ عطا بن سائب کے، اور وہ ثقت ہے، لیکن وہ اختلط ہو گیا تھا۔"
"18555","اور ابو ہریرہؓ سے روایت ہے کہ انہوں نے کہا: رَسُولُ اللہِ ﷺ نے فرمایا: ""اللہ قیامت کے دن بعض لوگوں پر اپنی عظمت ظاہر کرے گا جنہوں نے کبھی کوئی بھلائی نہیں کی، تو انہیں آگ سے نکالے گا جبکہ وہ جل چکے ہوں گے، پھر انہیں اپنی رحمتی سے شفاعت کرنے والوں کی شفاعت کے بعد جنت میں داخل کرے گا۔"" احمد نے اسے روایا ہے، اور اس میں صالح مولی التوأمة ہے، جو ضعیف ہے۔"
"18556","أذعشحأوؽۏشۄأثىأطؼثۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أدۄىوأضەأڬډہأهًڲأىڬهۏڽأڲەأتًشأدىحأوۏڽأزترهأۄًأدتةۏڽأڲەأ؏أدىحأوۏڽأتىۄۏڽأ““أدۄىوۏأ‛‛أڬتأىتوأزۏتأدتةەأڲتأ؏أًۄأتههۄأحؼتهۏٳأضەأۏۄأزؼتأڬشۏڽأڲەأڬۄأتىأڬتأۏۄأىتوأحثزۏهأڬشأزۏتأدتةەأ؏أحًأتههۄأحؼتهۏٳأتىأڬتأۏۄأىتوأوټتأزەأڲتأدثأًۄأدۄىوأضەأىڬهأإةەأۄًڽأڲەأۗ‛‛ أشتًۏأڬۄحەأۄۏڽأ=أتضأڬەأثؼزأتىۄًڽأىەأځًشۏأذزۏخأسڬشأڬۏأۄەأۗأ أۏۄأشًتۏحأتوتوأتذوزأتًشأتوتوأغثشتىۏأىەأىمهأڬۏأۄەأتضأڬۏأضىزأوۏڽأتۏڬأشتًۏأؼثزتهشذوىأثىأتضذتمأڬًلۏأۄەأتًشأًۄأعؼۏلأۄەأۗ"
"18557","أذعشحألعتهۄأثىأؼثۏزأشعۏأتههۄأؼىۄأتًشأذعشحأؼثتزۄأثىأظتوحأشعۏأتههۄأؼىۄأ؏أۏۄأزًىًڽأذعشتحأثۏتىأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ"
"18558","أذعشحأتثًضؼۏزأرزشۏأشعۏأتههۄأؼىۄأتًشأذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ="
"18559","حضرت انس بن مالک رضی اللہ عنہ نبی اکرم ﷺ کا یہ فرمان نقل کرتے ہیں : """" ایک شخص جہنم میں ایک ہزار سال تک """" یا حنان یا منان """" پکارتا رہے گا ، اللہ تعالیٰ حضرت جبرائیل علیہ السلام سے فرمائے گا : تم جاا اور میرے اس بندے کو میرے پاس لے کر آا ! حضرت جبرائیل علیہ السلام جائیں گے ، وہ اہل جہنم کو پائیں گے ، وہ سر جھکا کر ( یا اوندھے ہو کر ) رو رہے ہوں گے ، وہ ( یعنی حضرت جبرائیل علیہ السلام ) اپنے پروردگار کے پاس واپس آئیں گے اور اس کو یہ بات بتائیں گے ، تو پروردگار فرمائے گا : تم اْس ( بندے ) کو میرے پاس لے کر آا ! وہ فلاں فلاں مقام پر ہے ، حضرت جبرائیل علیہ السلام اسے ساتھ لائیں گے اور اس کے پروردگار کی بارگاہ میں کھڑا کر دیں گے ، پروردگار دریافت کرے گا : اے میرے بندے ! تو نے اپنی جگہ اور ٹھکانے کو کیسا پایا ء وہ کہے گا : اے میرے پروردگار ! سب سے بری جگہ اور سب سے برا ٹھکانہ ، پروردگار فرمائے گا : میرے بندے کو واپس لے جاا ! وہ بندہ کہے گا : اے میرے پروردگار ! مجھے یہ امید نہیں تھی کہ اگر تو مجھے اس میں سے نکال دے گا ، تو مجھے واپس اس میں بھیج دے گا ، تو پروردگار فرمائے گا : میرے بندے کو چھوڑ دو !‟۔ یہ روایت امام احمد اور امام ابویعلیٰ نے نقل کی ہے اور ان دونوں کے رجال صحیح کے رجال ہیں ، صرف ابوظلال کا معاملہ مختلف ہے جمہور نے اسے ضعیف کہا ہے اور ابن حبان نے اسے ثقہ قرار دیا ہے ۔"
"18560","اور ابو سعید خدریؓ سے روایت ہے کہ انہوں نے کہا: رَسُولُ اللہِ ﷺ نے فرمایا: ""اگر تم اللہ کی رحمتی کی قدر جانتے تو اس پر بھروسہ کرتے - شاید انہوں نے کہا: - اس پر۔"" بزار نے اسے روایا ہے، اور اس کا سند حسن ہے۔"
"18561","أذعشحأؼثزتههۄأثىأؼثتضأشعۏأتههۄأؼىۄوتأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ أ““أثەأطڬأتههۄأحؼتهۏٳأىەأتۏڬأضًأشذوحۏڽأځۏزتأڬۏأۄۏڽأ؏أتْىأوۏڽأضەأتۏڬأشذوحأ؏أتضأىەأورهًمأڬەأزشوۏتىأحمضۏوأڬۏأۄەأتًشأىىتىًەأشذوحۏڽأمۏتوحأڬەأزىأڬەأهۏەأۄۏڽأۗ‛‛أ أۏۄأشًتۏحأتوتوأغثشتىۏأىەأتًشأتوتوأثصتشأىەأىمهأڬۏأۄەأتًشأتىأزًىًڽأڬۏأضىزأذضىأۄەأۗأ"
"18562","أذضىأثظشۏأثۏتىأڬشحەأۄۏڽأ=أودہأحڬأۏۄأشًتۏحأځۄىډۏأۄەأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأۄەأ= أ““أثەأطڬأتههۄأحؼتهۏٳأڬۏأتۏڬأضًأشذوحۏڽأۄۏڽأ؏أتضأىەأتۏڬأشذوحأتۄهأصوۏىأڬەأزشوۏتىأحمضۏوأڬۏأۄەأتًشأًۄأتْىأڬۏأصىزڲۏأثہشأڬەأهۏەأڬتلۏأۄەأتًشأتضأىەأىىتىًەأشذوحۏڽأ؏أمۏتوحأڬەأزىأتځىەأزًضحًڽأڬەأهةەأوذلًػأڬشأهۏأۄۏڽأۗ‛‛"
"18563","أذعشحأتثًۄشۏشۄأشعۏأتههۄأؼىۄأىەأىثۏأتڬشوأ﷽أڬەأذًتهەأضەأتضأڬۏأوتىىزأشًتۏحأىمهأڬۏأۄەأۗ أۏۄأشًتۏحأتًشأتضأضەأځۄهۏأشًتۏحأتوتوأتذوزأىەأىمهأڬۏأۄەأ؏أتىأضثأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18564","أدهتضأڬەأذًتهەأضەأتضأڬۏأوتىىزأشًتۏحأوىمًهأۄەأۗ"
"18565","أوذوزأثىأضۏشۏىأڬەأذًتهەأضەأتضأڬۏأوتىىزأشًتۏحأوىمًهأۄەأتًشأتضأڬەأشدتهأظذۏذأڬەأشدتهأۄۏڽأۗ"
"18566","أذعشحأوؼتًۏۄأثىأذۏزيأشعۏأتههۄأؼىۄأىثۏأتڬشوأ﷽أڬتأۏۄألشوتىأىمهأڬشحەأۄۏڽأ=أ"
"18567","أذعشحأؼثتزۄأثىأظتوحأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أىثۏأتڬشوأ﷽أىەأتشطتزألشوتۏتأ=أ"
