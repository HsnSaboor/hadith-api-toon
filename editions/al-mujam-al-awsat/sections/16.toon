hadiths[497]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"9001","8993  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ ،  نَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  مُجَاهِدٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ  يُبَاهِي  بِأَهْلِ عَرَفَاتٍ أَهْلَ السَّمَاءِ  - الْمَلَائِكَةَ - يَقُولُ : انْظُرُوا إِلَى عِبَادِي هَؤُلَاءِ جَاءُوا شُعْثًا غُبْرًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُجَاهِدٍ  إِلَّا  يُونُسُ بْنُ أَبِي إِسْحَاقَ  .","","Al-Mu'jam al-Awsat 8993","","أبو هريرة الدوسي عن مجاهد بن جبر المخزومي عن يونس بن أبي إسحاق عن عبد الله بن محمد بن المغيرة المصري عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9002","[9/17]      8994  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  نَا  سَعِيدُ بْنُ عُفَيْرٍ ،  نَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنِ  الْوَلِيدِ بْنِ رَبَاحٍ ،  عَنْ  أَبِي هُرَيْرَةَ  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : "" آمِينَ آمِينَ آمِينَ "" فَقِيلَ لَهُ : يَا رَسُولَ اللهِ ، مَا كُنْتَ تَصْنَعُ هَذَا ؟ فَقَالَ :  قَالَ لِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ :  رَغِمَ أَنْفُ عَبْدٍ - أَوْ : بَعُدَ  - دَخَلَ عَلَيْهِ رَمَضَانُ فَلَمْ يُغْفَرْ لَهُ  ، فَقُلْتُ : آمِينَ ، ثُمَّ قَالَ :  رَغِمَ  أَنْفُ عَبْدٍ - أَوْ : بَعُدَ  - أَدْرَكَ وَالِدَيْهِ أَوْ أَحَدَهُمَا فَلَمْ يُدْخِلْهُ الْجَنَّةَ ، فَقُلْتُ : آمِينَ ، ثُمَّ قَالَ :  رَغِمَ  أَنْفُ عَبْدٍ - أَوْ : بَعُدَ  - ذُكِرْتَ عِنْدَهُ فَلَمْ يُصَلِّ عَلَيْكَ ، فَقُلْتُ : آمِينَ  .","","Al-Mu'jam al-Awsat 8994","","أبو هريرة الدوسي عن الوليد بن رباح الدوسي عن كثير بن زيد السهمي عن سليمان بن بلال القرشي عن سعيد بن كثير بن عفير عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9003","8995  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُوسَى بْنُ عُلَيِّ بْنِ رَبَاحٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  اسْتَتْبَعَنِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَيْلَةً ، فَقَالَ :  إِنَّ نَفَرًا مِنَ الْجِنِّ خَمْسَةَ عَشَرَ بَنُو إِخْوَةٍ وَبَنُو عَمٍّ يَأْتُونِي اللَّيْلَةَ فَأَقْرَأُ عَلَيْهِمُ الْقُرْآنَ  ، فَانْطَلَقْتُ مَعَهُ إِلَى الْمَكَانِ الَّذِي أَرَادَ ، فَجَعَلَ لِي خَطًّا ثُمَّ أَجْلَسَنِي فِيهِ ، وَقَالَ : "" لَا تَخْرُجَنَّ مِنْ هَذَا "" ، فَبِتُّ فِيهِ حَتَّى أَتَانِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَعَ السَّحَرِ ، فِي يَدِهِ عَظْمُ حَائِلٍ ، وَرَوْثَةٌ ،  وَحُمَمَةٌ  ، فَقَالَ : "" إِذَا أَتَيْتَ الْخَلَاءَ فَلَا تَسْتَنْجِيَنَّ بِشَيْءٍ مِنْ هَذَا "" ، قَالَ : فَلَمَّا أَصْبَحْتُ قُلْتُ : لَأَعْلَمَنَّ حَيْثُ كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَهَبْتُ فَرَأَيْتُ مَوْضِعَ سَبْعِينَ بَعِيرًا  .  لَمْ يَرْوِ  عُلَيُّ بْنُ رَبَاحٍ  عَنِ  ابْنِ مَسْعُودٍ  حَدِيثًا غَيْرَ هَذَا  .","","Al-Mu'jam al-Awsat 8995","","عبد الله بن مسعود عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن عبد الله بن صالح المصري عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9004","8996  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  دَاوُدَ بْنِ يَزِيدَ الْأَوْدِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  قِيلَ :  يَا رَسُولَ اللهِ ، مَا أَكْثَرُ مَا يُولِجُ النَّاسَ النَّارَ ؟ فَقَالَ : ""  الْأَجْوَفَانِ  : الْفَرْجُ ، وَالْفَمُ  .","","Al-Mu'jam al-Awsat 8996","","أبو هريرة الدوسي عن يزيد بن عبد الرحمن بن الأسود الزعافري عن داود بن يزيد الزعافري عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9005","[9/18]      8997  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ ،  ثَنَا  مِسْعَرُ بْنُ كِدَامٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الْعَبَّاسِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَمْ أُنَبَّأْ أَنَّكَ تَقُومُ اللَّيْلَ وَتَصُومُ النَّهَارَ ؟  قُلْتُ : إِنِّي أَفْعَلُ ذَلِكَ ، قَالَ : "" فَإِنَّكَ إِذَا فَعَلْتَ بَخَصْتَ الْعَيْنَ ، كُلَّ شَهْرٍ ثَلَاثَةَ أَيَّامٍ ، فَذَاكَ صَوْمُ الدَّهْرِ "" ، فَقُلْتُ : إِنِّي أَجِدُ قُوَّةً ، فَقَالَ : "" صُمْ صَوْمَ  دَاوُدَ  ، كَانَ يَصُومُ يَوْمًا وَيُفْطِرُ يَوْمًا  .","","Al-Mu'jam al-Awsat 8997","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن مسعر بن كدام عن عبد الله بن محمد بن المغيرة المصري عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9006","8998  -  وَعَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَسْتَأْذِنُهُ فِي  الْجِهَادِ  ، فَقَالَ :  أَحَيٌّ وَالِدَاكَ ؟  قَالَ : نَعَمْ ، قَالَ : "" فَفِيهِمَا فَجَاهِدْ  .","","Al-Mu'jam al-Awsat 8998","","عبد الله بن عمرو بن العاص عن السائب بن فروخ الشاعر عن حبيب بن أبي ثابت الكاهلي عن مسعر بن كدام عن عبد الله بن محمد بن المغيرة المصري عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9007","8999  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ ،  ثَنَا  مِسْعَرُ بْنُ كِدَامٍ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خِيَارُكُمْ أَحْسَنُكُمْ قَضَاءً  .","","Al-Mu'jam al-Awsat 8999","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محارب بن دثار عن مسعر بن كدام عن عبد الله بن محمد بن المغيرة المصري عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9008","9000  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  نَا  عَبْدُ اللهِ بْنُ عُمَرَ الْعُمَرِيُّ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  خَرَجَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  مَكَّةَ  فِي حَجٍّ أَوْ عُمْرَةٍ أَوْ غَزْوٍ  ، فَلَمَّا كَانَ بِبَعْضِ الطَّرِيقِ قَالَ :  مَنْ يَمْلَأُ لَنَا حِيَاضَ الْأُثَايَةِ ؟  قَالَ  جَابِرٌ  : فَقُلْتُ : أَنَا يَا رَسُولَ اللهِ ، فَمَضَيْنَا حَتَّى أَتَيْنَا الْأُثَايَةَ         [9/19]      فَمَلَأْتُ الْحَوْضَ ، فَلَمَّا كَانَ فِي بَعْضِ اللَّيْلِ جَاءَ رَجُلٌ فَنَزَلَ ، فَإِذَا هُوَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَانْطَلَقَ فَقَضَى حَاجَتَهُ ، ثُمَّ جَاءَ فَتَوَضَّأَ مِنَ الْحَوْضِ ، ثُمَّ جَاءَ فَصَلَّى ، عَلَيْهِ إِزَارٌ مُلْتَحِفًا بِهِ ، فَتَوَضَّأْتُ ، ثُمَّ جِئْتُ فَقُمْتُ عَنْ يَسَارِهِ ، فَأَخَذَ بِيَدِي فَجَعَلَنِي عَنْ يَمِينِهِ ، فَصَلَّى رَكْعَتَيْنِ .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  وَهْبِ بْنِ كَيْسَانَ  إِلَّا  عَبْدُ اللهِ بْنُ عُمَرَ  .","","Al-Mu'jam al-Awsat 9000","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن وهب بن كيسان القرشي عن عبد الله بن عمر العمري عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9009","9001  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  نُعَيْمُ بْنُ حَمَّادٍ ،  نَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ ،  عَنْ  عُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّهَا كَانَتْ تَأْمُرُ بِالتَّلْبِينَةِ لِلْمَرِيضِ وَالْمَحْزُونِ عَلَى الْهَالِكِ ، وَتَقُولُ : إِنِّي سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  التَّلْبِينَةُ  تُجِمُّ  فُؤَادَ الْمَرِيضِ  ، وَتَذْهَبُ بِبَعْضِ الْحُزْنِ  .","","Al-Mu'jam al-Awsat 9001","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن عقيل بن خالد الأيلي عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9010","9002  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَخِيهِ عِيسَى بْنِ لَهِيعَةَ  ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمَّا نَزَلَتْ آيَةُ الْفَرَائِضِ فِي سُورَةِ النِّسَاءِ  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ الْحَبْسِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عِكْرِمَةَ  إِلَّا  عِيسَى  ، وَلَا يُرْوَى عَنِ  ابْنِ عَبَّاسٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9002","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عيسى بن لهيعة عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9011","9003  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَمِّي سَعِيدُ بْنُ عِيسَى ،  نَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ، قَالَ :  حَدَّثَنِي  الْحَارِثُ بْنُ يَزِيدَ الْعُكْلِيُّ وَسَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ الْهَمْدَانِيُّ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ، قَالَ :         [9/20]      سَمِعْتُ  النُّعْمَانَ بْنَ بَشِيرٍ الْأَنْصَارِيَّ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  اجْعَلُوا بَيْنَكُمْ وَبَيْنَ الْحَرَامِ سُتْرَةً  ، مَنْ فَعَلَ ذَلِكَ كَانَ أَبْرَأَ لِعِرْضِهِ وَدِينِهِ ، وَمَنْ وَقَعَ فِيهِ كَالْمُرْتِعِ إِلَى جَانِبِ الْحِمَى  يُوشِكُ  أَنْ يَقَعَ فِيهِ ، وَإِنَّ لِكُلِّ مَلِكٍ حِمًى ، وَإِنَّ حِمَى اللهِ فِي الْأَرْضِ مَحَارِمُهُ  .","","Al-Mu'jam al-Awsat 9003","","النعمان بن بشير الأنصاري عن الشعبي عن عبد الرحمن بن سعيد الخيواني عن محمد بن عجلان عن المفضل بن فضالة عن سعيد بن عيسى الرعيني عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9012","9004  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَمِّي سَعِيدٌ ،  نَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْإِيمَانُ  بِضْعٌ  وَسَبْعُونَ  شُعْبَةً  ، أَعْلَاهَا : شَهَادَةُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَدْنَاهَا : إِمَاطَةُ  الْأَذَى  عَنِ الطَّرِيقِ ، وَالْحَيَاءُ  شُعْبَةٌ  مِنَ الْإِيمَانِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ عَجْلَانَ  عَنِ  الْمَقْبُرِيِّ  إِلَّا  مُفَضَّلُ بْنُ فَضَالَةَ  .","","Al-Mu'jam al-Awsat 9004","","أبو هريرة الدوسي عن سعيد المقبري عن محمد بن عجلان عن المفضل بن فضالة عن سعيد بن عيسى الرعيني عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9013","9005  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَمِّي سَعِيدُ بْنُ عِيسَى ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ أَشْرَسَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمَّا أُدْخِلْتُ الْجَنَّةَ رَأَيْتُ فِيهَا قَصْرًا مِنْ ذَهَبٍ  ، فَقُلْتُ  لِجِبْرِيلَ  : لِمَنْ هَذَا الْقَصْرُ ؟ قَالَ : لِرَجُلٍ مِنْ  قُرَيْشٍ  ، فَرَجَوْتُ أَنْ أَكُونَ أَنَا هُوَ ، فَقُلْتُ : وَمَنْ هُوَ ؟ فَقَالَ :  عُمَرُ بْنُ الْخَطَّابِ  "" ، فَذَكَرَ ذَلِكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعُمَرَ  ، وَقَالَ : "" فَلَوْلَا مَا عَلِمْتُ مِنْ غَيْرَتِكَ يَا  أَبَا حَفْصٍ  لَدَخَلْتُهُ "" ، فَبَكَى  عُمَرُ  ، وَقَالَ : بِأَبِي وَأُمِّي أَعَلَيْكَ أَغَارُ يَا رَسُولَ اللهِ ؟  .  قَالَ عَبْدُ اللهِ بْنُ عُمَرَ :  وَحَدَّثَنِي  زَيْدُ بْنُ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ . غَيْرَ أَنَّهُ قَالَ : وَقَالَ :  عُمَرُ  غَيُورٌ  ، وَأَنَا أَغْيَرُ مِنْهُ ، وَاللهُ أَغْيَرُ مِنَّا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا  عَبْدُ اللهِ بْنُ عُمَرَ  ، وَلَا عَنْ  عَبْدِ اللهِ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ أَشْرَسَ  ،  تَفَرَّدَ بِهِ  سَعِيدُ بْنُ عِيسَى  .","","Al-Mu'jam al-Awsat 9005","","أبو هريرة الدوسي عن أسلم العدوي مولى عمر بن الخطاب عن زيد بن أسلم عن عبد الله بن عمر العمري عن عبد الرحمن بن مسعود بن أشرس التونسي عن سعيد بن عيسى الرعيني عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9014","[9/21]      9006  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ السَّمْحِ التُّجِيبِيُّ ،  عَنْ  عَبَّادِ بْنِ كَثِيرٍ ،  عَنْ  عُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ .  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ  زَيْنَبَ بِنْتَ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَجَارَتْ  أَبَا الْعَاصِ بْنَ الرَّبِيعِ بْنِ عَبْدِ شَمْسٍ  ، "" فَأَجَازَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جِوَارَهَا  .","","Al-Mu'jam al-Awsat 9006","","أنس بن مالك عن الزهري عن عقيل بن خالد الأيلي عن عباد بن كثير الكاهلي عن عبد الله بن السمح المصري عن يحيى بن عبد الله بن بكير المخزومي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9015","9007  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  يَحْيَى بْنُ صَالِحٍ الْأَيْلِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ .  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِعَتَّابِ بْنِ أُسَيْدٍ  :  إِنِّي قَدْ بَعَثْتُكَ عَلَى أَهْلِ اللهِ  أَهْلِ مَكَّةَ  ، فَانْهَهُمْ عَنْ بَيْعِ مَا لَمْ يَقْبِضُوا  ، وَعَنْ رِبْحِ مَا لَمْ يَضْمَنُوا ، وَعَنْ شَرْطَيْنِ فِي  شَرْطٍ  ، وَعَنْ بَيْعٍ وَقَرْضٍ ، وَعَنْ بَيْعٍ وَسَلَفٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْمَاعِيلَ بْنِ أُمَيَّةَ  إِلَّا  يَحْيَى بْنُ صَالِحٍ  ، وَلَا عَنْ  عَطَاءٍ  إِلَّا  إِسْمَاعِيلُ  ،  تَفَرَّدَ بِهِ  :  يَحْيَى بْنُ بُكَيْرٍ  .","","Al-Mu'jam al-Awsat 9007","","عبد الله بن عباس عن عطاء بن أبي رباح عن إسماعيل بن أمية الأموي عن يحيى بن صالح الأيلي عن يحيى بن عبد الله بن بكير المخزومي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9016","9008  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  سَعِيدُ بْنُ عُفَيْرٍ ،  نَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ تَمِيمٍ ، مَوْلَى بَنِي زِمَّانَةَ ،  عَنْ  أَبِيهِ  .  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا دَنَا رَمَضَانُ يَقُولُ :  أَظَلَّكُمْ  شَهْرُكُمْ هَذَا ، وَمَحْلُوفِ  أَبِي الْقَاسِمِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الَّذِي حَلَفَ بِهِ ، مَا مَرَّ عَلَى الْمُسْلِمِينَ مِثْلُهُ  ، إِنَّ اللهَ لَيَكْتُبُ أَجْرَهُ وَنَوَافِلَهُ قَبْلَ أَنْ يُدْخِلَهُ وَيَكْتُبُ وِزْرَهُ وَشَقَاءَهُ قَبْلَ أَنْ يُدْخِلَهُ ؛ وَذَلِكَ أَنَّ الْمُؤْمِنَ يُعِدُّ نَفَقَتَهُ وَقُوتَهُ لِعِيَالِهِ ، وَإِنَّ الْفَاجِرَ يُعِدُّ لِغَفْلَةِ الْمُسْلِمِينَ  وَعَوْرَتِهِمْ  ، فَهُوَ نِعْمَةٌ لِلْمُؤْمِنِ ، نِقْمَةٌ عَلَى الْكَافِرِينَ  .","","Al-Mu'jam al-Awsat 9008","","أبو هريرة الدوسي عن تميم المازني عن عمرو بن تميم المازني عن كثير بن زيد السهمي عن سليمان بن بلال القرشي عن سعيد بن كثير بن عفير عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9017","[9/22]      9009  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  سَعِيدُ بْنُ عُفَيْرٍ ،  نَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  حُمَيْدٍ الطَّوِيلِ . عَنْ أَنَسِ بْنِ مَالِكٍ ،  أَنَّهُ سَمِعَهُ  يَقُولُ :  آلَى  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ نِسَائِهِ ، وَكَانَتِ انْفَكَّتْ رِجْلُهُ فَأَقَامَ فِي  مَشْرُبَةٍ  تِسْعًا وَعِشْرِينَ ، ثُمَّ نَزَلَ فَقَالُوا : يَا رَسُولَ اللهِ ، آلَيْتَ شَهْرًا ، فَقَالَ :  الشَّهْرُ  تِسْعٌ وَعِشْرُونَ  .","","Al-Mu'jam al-Awsat 9009","","أنس بن مالك عن حميد الطويل عن سليمان بن بلال القرشي عن سعيد بن كثير بن عفير عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9018","9010  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  خَالِدُ بْنُ نِزَارٍ ،  نَا  حَمَّادُ بْنُ أَبِي حُمَيْدٍ ،  عَنْ  يَعْقُوبَ ، مَوْلَى الْحُرَقَةِ .  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ تَبِعَ جِنَازَةً حَتَّى يُصَلِّيَ عَلَيْهَا كَانَ لَهُ قِيرَاطٌ  ، وَمَنْ تَبِعَهَا حَتَّى تُغَيَّبَ كَانَ لَهُ قِيرَاطَانِ ، أَصْغَرُهُمَا مِثْلُ  أُحُدٍ  .  لَمْ يَرْوِ  حَمَّادُ بْنُ أَبِي حُمَيْدٍ وَهُوَ مُحَمَّدٌ  - هَكَذَا يَقُولُ  أَهْلُ الْمَدِينَةِ :  حَمَّادٌ  - عَنْ  يَعْقُوبَ مَوْلَى الْحُرَقَةِ  حَدِيثًا غَيْرَ هَذَا .","","Al-Mu'jam al-Awsat 9010","","أبو هريرة الدوسي عن يعقوب المدني مولى الحرقة عن محمد بن أبي حميد الزرقي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9019","9011  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ ،  نَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  أَيُّوبَ السَّخْتِيَانِيِّ وَخَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  مِنَ السُّنَّةِ إِذَا تَزَوَّجَ الرَّجُلُ الْبِكْرَ عَلَى  الثَّيِّبِ  ، أَقَامَ عِنْدَهَا سَبْعًا  ، وَإِذَا تَزَوَّجَ  الثَّيِّبَ  عَلَى الْبِكْرِ ، أَقَامَ عِنْدَهَا ثَلَاثًا  "" .","","Al-Mu'jam al-Awsat 9011","","أنس بن مالك عن أبو قلابة الجرمي عن خالد الحذاء عن سفيان الثوري عن عبد الله بن محمد بن المغيرة المصري عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9020","9012  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ، وَالْمِقْدَامُ بْنُ دَاوُدَ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُوسَى بْنُ عُلَيِّ بْنِ رَبَاحٍ ،  عَنْ  أَبِيهِ  عَنْ  عَمْرِو بْنِ الْعَاصِ ، قَالَ :  بَعَثَ إِلَيَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَمَرَنِي أَنْ آخُذَ ثِيَابِي وَسِلَاحِي ، فَأَتَيْتُهُ وَهُوَ يَتَوَضَّأُ  فَصَعَّدَ  فِيَّ النَّظَرَ ثُمَّ طَأْطَأَهُ ، فَقَالَ :  يَا  عَمْرُو  إِنِّي أُرِيدُ أَنْ أَبْعَثَكَ عَلَى جَيْشٍ لِيُظْفِرَكَ اللهُ وَيُسْلِمَكُمْ  ،  وَأَزْعَبُ  لَكَ زَعْبَةً مِنَ الْمَالِ         [9/23]      صَالِحَةً "" ، فَقُلْتُ : يَا رَسُولَ اللهِ مَا أَسْلَمْتُ رَغْبَةً فِي الْمَالِ ؛ وَلَكِنِّي أَسْلَمْتُ رَغْبَةً فِي الْإِسْلَامِ وَأَكُونَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : "" نِعْمَ ، وَنِعْمًا بِالْمَالِ الصَّالِحِ لِلْمَرْءِ الصَّالِحِ  .","","Al-Mu'jam al-Awsat 9012","","عمرو بن العاص بن وائل السهمي عن علي بن رباح اللخمي عن موسى بن علي اللخمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","مقدام بن داود بن عيسى المصري"
"9021","9013  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  أَبِي قَابُوسٍ  . عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الرَّاحِمُونَ يَرْحَمُهُمُ اللهُ  ، ارْحَمْ مَنْ فِي الْأَرْضِ يَرْحَمْكَ مَنْ فِي السَّمَاءِ  .","","Al-Mu'jam al-Awsat 9013","","عبد الله بن عمرو بن العاص عن أبو قابوس مولى عبد الله بن عمرو بن العاص عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9022","9014  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ عُمَرَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  . عَنْ  جَابِرٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا يَلْتَفِتُ إِذَا مَشَى  ، وَكَانَ رُبَّمَا تَعَلَّقَ رِدَاؤُهُ فِي الشَّجَرَةِ أَوِ الشَّيْءِ فَلَا يَلْتَفِتُ حَتَّى يَرْفَعُوهُ عَلَيْهِ ، وَكَانُوا يَضْحَكُونَ وَيَمْزَحُونَ ، وَكَانُوا قَدْ أَمِنُوا الْتِفَاتَهُ  .","","Al-Mu'jam al-Awsat 9014","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عبد الجبار بن عمر الأيلي عن سعيد بن الحكم الجمحي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9023","9015  -  وَعَنْ  جَابِرٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  كُلُّ مَعْرُوفٍ صَدَقَةٌ  .","","Al-Mu'jam al-Awsat 9015","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عبد الجبار بن عمر الأيلي عن سعيد بن الحكم الجمحي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9024","9016  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ وَهْبٍ ،  حَدَّثَنِي  أَبُو هَانِئٍ حُمَيْدُ بْنُ هَانِئٍ ،  عَنْ  أَبِي سَعِيدٍ الْغِفَارِيِّ ،  أَنَّهُ سَمِعَ  أَبَا هُرَيْرَةَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  سَيُصِيبُ أُمَّتِي دَاءُ الْأُمَمِ  فَقَالُوا : يَا رَسُولَ اللهِ ، وَمَا دَاءُ الْأُمَمِ ؟ قَالَ : "" الْأَشَرُ ، وَالْبَطَرُ ، وَالتَّدَابُرُ ، وَالتَّنَافُسُ فِي الدُّنْيَا ، وَالتَّبَاغُضُ ، وَالْبُخْلُ ، حَتَّى يَكُونَ الْبَغْيُ ، ثُمَّ يَكُونَ  الْهَرْجُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي سَعِيدٍ الْغِفَارِيِّ  إِلَّا  أَبُو هَانِئٍ  .","","Al-Mu'jam al-Awsat 9016","","أبو هريرة الدوسي عن أبو سعيد الغفاري عن حميد بن هانئ الخولاني عن عبد الله بن وهب المصري عن يحيى بن عبد الله بن بكير المخزومي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9025","9017  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  عُثْمَانُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ         [9/24]      شُعَيْبٍ ،  عَنْ  أَبِيهِ  عَنْ  جَدِّهِ  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ قَالَ حِينَ يَتَحَرَّكُ مِنَ اللَّيْلِ : بِسْمِ اللهِ ، عَشْرَ مَرَّاتٍ  ، وَسُبْحَانَ اللهِ ، عَشْرًا ، آمَنْتُ بِاللهِ وَكَفَرْتُ بِالطَّاغُوتِ ، عَشْرًا ، وُقِيَ كُلَّ شَيْءٍ يَتَحَرَّفُهُ ، وَلَمْ يَنْبَغِي لِذَنْبٍ يُدْرِكُهُ إِلَى مِثْلِهَا  .","","Al-Mu'jam al-Awsat 9017","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9026","9018  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَمِّي سَعِيدُ بْنُ عِيسَى ،  نَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ  . عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَشْيَاءَ حَرَّمَهَا :  وَثَمَنُ الْكَلْبِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  مُفَضَّلٌ  .","","Al-Mu'jam al-Awsat 9018","","عبد الله بن عباس عن عطاء بن أبي رباح عن ابن جريج عن المفضل بن فضالة عن سعيد بن عيسى الرعيني عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9027","9019  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  خَالِدُ بْنُ نِزَارٍ أَبُو يَزِيدَ الْأَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ صَالِحٍ التَّمَّارُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  . عَنْ  عَتَّابِ بْنِ أَسِيدٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي زَكَاةِ الْكُرُومِ :  إِنَّهَا تُخْرَصُ كَمَا تُخْرَصُ النَّخْلُ  ، ثُمَّ تُؤَدَّى زَكَاتُهَا زَبِيبًا كَمَا تُؤَدَّى زَكَاةُ النَّخْلِ تَمْرًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  مُحَمَّدُ بْنُ صَالِحٍ  .","","Al-Mu'jam al-Awsat 9019","","عتاب بن أسيد بن أبي العيص الأموي عن سعيد بن المسيب عن الزهري عن محمد بن صالح بن دينار التمار عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9028","9020  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  نَا  كَثِيرُ بْنُ عَبْدِ اللهِ الْمُزَنِيُّ ،  عَنْ  رُبَيْحِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي سَعِيدٍ الْخُدْرِيِّ ،  عَنْ  أَبِيهِ .  عَنْ  جَدِّهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخَذَ زَكَاةَ الْفِطْرِ مِنْ أَهْلِ الْبَادِيَةِ الْأَقِطَ  .  لَمْ يُرْوَ هَذَا الْحَدِيثُ عَنْ  أَبِي سَعِيدٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  كَثِيرُ بْنُ         [9/25]      عَبْدِ اللهِ  .","","Al-Mu'jam al-Awsat 9020","","أبو سعيد الخدري عن عبد الرحمن بن أبي سعيد الخدري عن ربيح بن عبد الرحمن الخدري عن كثير بن عبد الله بن عمرو بن عوف اليشكري عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9029","9021  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ  عَنْ  عُرْوَةَ  عَنْ  عَائِشَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ مِنَ الشِّعْرِ  حِكْمَةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  سُفْيَانُ  ،  تَفَرَّدَ بِهِ  خَالِدُ بْنُ نِزَارٍ  وَنَهْشَلُ بْنُ كَثِيرٍ الْمِصْرِيُّ  .  كذا في طبعة دار الحرمين ، وقال محققه في الحاشية : تشبه في الأصل ( البصري ) .أ.هـ ولم نقف على ما جعل محقق طبعة دار الحرمين يرجح أنه ( المصري ) والذي في طبعة الطحان : ( البصري ) وقال مغلطاي في في شرح ابن ماجه : نهشل بن كثير النهشلي بصرى ثقة . فالظاهر أن صوابه : ( البصري ) والله أعلم.","","Al-Mu'jam al-Awsat 9021","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9030","9022  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَمِّي سَعِيدُ بْنُ عِيسَى ،  نَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَطَاءٍ وَأَبِي الزُّبَيْرِ ،  أَنَّهُمَا سَمِعَا  جَابِرَ بْنَ عَبْدِ اللهِ ، يَقُولُ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ  الْمُخَابَرَةِ  ،  وَالْمُزَابَنَةِ  ، وَالْمُحَاقَلَةِ ، وَبَيْعِ  الثَّمَرِ  حَتَّى يُطْعَمَ ، إِلَّا الْعَرَايَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  مُفَضَّلٌ  .","","Al-Mu'jam al-Awsat 9022","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن المفضل بن فضالة عن سعيد بن عيسى الرعيني عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9031","9023  -  حَدَّثَنَا  مِقْدَامٌ ،  نَا  عَمِّي سَعِيدُ بْنُ عِيسَى ،  ثَنَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  حَدَّثَنِي  عَطَاءُ بْنُ أَبِي رَبَاحٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ، أَنَّ عَائِشَةَ ،  حَدَّثَتْهُ  "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي وَهِيَ مُعْتَرِضَةٌ بَيْنَهُ وَبَيْنَ الْقِبْلَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خَالِدِ بْنِ يَزِيدَ  إِلَّا  مُفَضَّلٌ  .","","Al-Mu'jam al-Awsat 9023","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن عطاء بن أبي رباح عن خالد بن يزيد الجمحي عن المفضل بن فضالة عن سعيد بن عيسى الرعيني عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9032","9024  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَمِّي سَعِيدُ بْنُ عِيسَى ،  ثَنَا  مُفَضَّلُ بْنُ فَضَالَةَ ،  عَنْ  يَحْيَى بْنِ أَيُّوبَ ،  عَنْ  يُونُسَ وَعُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  سَعِيدٍ وَأَبِي سَلَمَةَ .  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا أَمَّنَ الْقَارِئُ فَأَمِّنُوا  ، فَمَنْ وَافَقَ تَأْمِينُهُ تَأْمِينَ الْمَلَائِكَةِ غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ  .","","Al-Mu'jam al-Awsat 9024","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن عقيل بن خالد الأيلي عن يحيى بن أيوب الغافقي عن المفضل بن فضالة عن سعيد بن عيسى الرعيني عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9033","[9/26]      9025  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ ،  نَا  سُفْيَانُ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  عَنْ  جَابِرٍ ، قَالَ :  إِذَا دَخَلَ أَهْلُ الْجَنَّةِ الْجَنَّةَ قَالَ اللهُ عَزَّ وَجَلَّ : يَا عِبَادِي هَلْ تَسْأَلُونِي شَيْئًا فَأَزِيدَكُمْ ؟  قَالُوا : يَا رَبَّنَا ، مَا خَيْرٌ مِمَّا أَعْطَيْتَنَا ؟ قَالَ : رِضْوَانِي أَكْبَرُ  ،  رَفَعَهُ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُفْيَانَ  -  مَرْفُوعًا  - إِلَّا  عَبْدُ اللهِ بْنُ الْمُغِيرَةِ  وَالْفِرْيَابِيُّ  .","","Al-Mu'jam al-Awsat 9025","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سفيان الثوري عن عبد الله بن محمد بن المغيرة المصري عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9034","9026  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ ،  ثَنَا  هَمَّامُ بْنُ يَحْيَى ،  عَنْ  قَتَادَةَ ،  فِي قَوْلِهِ :         {      وَمَا أَدْرِي مَا يُفْعَلُ بِي وَلا بِكُمْ         }      قَالَ : قَدْ عَلِمَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَ ذَلِكَ مَا يُفْعَلُ بِهِ حِينَ أَنْزَلَ اللهُ :         {      إِنَّا فَتَحْنَا لَكَ فَتْحًا مُبِينًا         }      قَالَ  هَمَّامٌ  :  فَحَدَّثَنَا  عَنْ  أَنَسِ بْنِ مَالِكٍ ، أَنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا أُنْزِلَتْ عَلَيْهِ هَذِهِ الْآيَةُ ، قَالَ :  لَقَدْ أُنْزِلَتْ عَلَيَّ آيَةٌ أَحَبُّ إِلَيَّ مِنَ الدُّنْيَا جَمِيعًا  ، فَلَمَّا تَلَا نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  رَجُلٌ مِنَ الْقَوْمِ  : هَنِيئًا لَكَ يَا نَبِيَّ اللهِ ، قَدْ بَيَّنَ اللهُ لَكَ مَا يُفْعَلُ بِكَ ، فَمَاذَا يُفْعَلُ بِنَا ؟ فَأَنْزَلَ اللهُ :         {      لِيُدْخِلَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الأَنْهَارُ         }      الْآيَةَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هَمَّامٍ  إِلَّا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ  .","","Al-Mu'jam al-Awsat 9026","","أنس بن مالك عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عبد الله بن محمد بن المغيرة المصري عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9035","9027  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  خَالِدُ بْنُ نِزَارٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُؤَمَّلِ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَاءُ زَمْزَمَ لِمَا شُرِبَ لَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الزُّبَيْرِ  إِلَّا  عَبْدُ اللهِ بْنُ الْمُؤَمَّلِ  .","","Al-Mu'jam al-Awsat 9027","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن المؤمل العائذي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9036","9028  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدٌ ،  ثَنَا  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ بْنِ عُبَيْدِ اللهِ ،  عَنْ  مُجَاهِدٍ         [9/27]      عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا ،  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .  لَمْ يَرْوِهِ عَنْ  مُجَاهِدٍ  إِلَّا  إِسْحَاقُ  .","","Al-Mu'jam al-Awsat 9028","","عبد الله بن عمرو بن العاص عن مجاهد بن جبر المخزومي عن إسحاق بن يحيى بن طلحة التيمي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9037","9029  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  خَالِدُ بْنُ نِزَارٍ ،  نَا  نَافِعُ بْنُ عُمَرَ الْجُمَحِيُّ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ، قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ عُمَرَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  حَوْضِي  مَسِيرَةُ  شَهْرٍ  ، زَوَايَاهُ سَوَاءٌ ، وَمَاؤُهُ أَبْيَضُ مِنَ الْوَرِقِ ، وَرِيحُهُ أَطْيَبُ مِنَ الْمِسْكِ ، وَكِيزَانُهُ كَنُجُومِ السَّمَاءِ ، مَنْ شَرِبَ مِنْهُ لَا يَظْمَأُ أَبَدًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي مُلَيْكَةَ  إِلَّا  نَافِعُ بْنُ عُمَرَ  .","","Al-Mu'jam al-Awsat 9029","","عبد الله بن عمر بن الخطاب عن ابن أبي مليكة عن نافع بن عمر بن عبد الله بن جميل الجمحي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9038","9030  -  حَدَّثَنَا  مِقْدَامٌ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  نَا  نَافِعُ بْنُ عُمَرَ ،  نَا  بِشْرُ بْنُ عَاصِمٍ ،  عَنْ  أَبِيهِ  .  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ يُبْغِضُ الْبَلِيغَ مِنَ الرِّجَالِ  ، الَّذِي  يَتَخَلَّلُ  أَحَدُهُمُ الْكَلَامَ بِلِسَانِهِ كَمَا تَتَخَلَّلُ الْبَاقِرَةُ الْكَلَأَ بِأَلْسِنَتِهَا  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  :  نَافِعُ بْنُ عُمَرَ  .","","Al-Mu'jam al-Awsat 9030","","عبد الله بن عمر بن الخطاب عن عاصم بن سفيان الثقفي عن بشر بن عاصم بن سفيان الطائفي عن نافع بن عمر بن عبد الله بن جميل الجمحي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9039","9031  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ طَهْمَانَ         [9/28]      عَنْ  حُمَيْدٍ الطَّوِيلِ .  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  رَأَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حَجَّتِهِ رَجُلًا  يُهَادَى  بَيْنَ ابْنَيْهِ فِيمَا بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  ، فَقَالَ : "" بِمَ هَذَا ؟ "" قَالُوا : نَذَرَ أَنْ يَمْشِيَ إِلَى  الْبَيْتِ  ، فَقَالَ :  إِنَّ اللهَ لَا يَصْنَعُ بِتَعْذِيبِ هَذَا نَفْسَهُ شَيْئًا ، فَلْيَرْكَبْ  .","","Al-Mu'jam al-Awsat 9031","","أنس بن مالك عن حميد الطويل عن إبراهيم بن طهمان عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9040","9032  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  نَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  حَدَّثَنِي  أَبُو عُثْمَانَ الْيَشْكُرِيُّ ، قَالَ :  مَرَّ بِنَا أَنَسُ بْنُ مَالِكٍ فِي  مَسْجِدِ بَنِي رِفَاعَةَ  ، وَقَدْ صَلَّيْنَا الْغَدَاةَ ، وَمَعَهُ نَفَرٌ فَأَذَّنَ بَعْضُهُمْ ، فَرَكَعَ الرَّكْعَتَيْنِ ، ثُمَّ أَقَامَ ، فَتَقَدَّمَ  أَنَسُ بْنُ مَالِكٍ  فَصَلَّى بِهِمُ الْغَدَاةَ ، فَلَمَّا فَرَغَ مِنْ صَلَاتِهِ أَرْسَلَ إِلَى وِسَادَتَيْنِ ، فَأُتِيَ بِهِمَا فَالْتَفَتْنَا لَهُ ، فَقَعَدَ يُحَدِّثُنَا ، فَكَانَ فِيمَا  حَدَّثَنَا  ،  أَنَّهُ خَدَمَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَشْرَ سِنِينَ ، فَمَا قَالَ لَهُ لِشَيْءٍ فَعَلَهُ : "" لِمَ فَعَلْتَ هَذَا ؟  ، وَلَا لِشَيْءٍ لَمْ يَفْعَلْهُ : "" أَلَا فَعَلْتَ كَذَا  .","","Al-Mu'jam al-Awsat 9032","","أنس بن مالك عن الجعد بن دينار اليشكري عن إبراهيم بن طهمان عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9041","9033  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ ،  ثَنَا  أَبُو الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  هَذَا  الْبَيْتُ  دِعَامَةٌ  مِنْ دَعَائِمِ الْإِسْلَامِ ، فَمَنْ حَجَّ  الْبَيْتَ  ، أَوِ اعْتَمَرَ ، فَهُوَ ضَامِنٌ عَلَى اللهِ  ، فَإِنْ مَاتَ أَدْخَلَهُ الْجَنَّةَ ، وَإِنْ رَدَّهُ إِلَى أَهْلِهِ رَدَّهُ بِأَجْرٍ وَغَنِيمَةٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الزُّبَيْرِ  إِلَّا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عُمَيْرٍ  .","","Al-Mu'jam al-Awsat 9033","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن محمد بن عبد الله بن عبيد الليثي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9042","9034  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدٌ ،  نَا  سُفْيَانُ بْنُ عَبْدِ اللهِ  ،  عَنْ  مَالِكِ بْنِ أَنَسٍ ،  عَنِ  ابْنِ شِهَابٍ .  عَنْ  أَنَسٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ  مَكَّةَ  يَوْمَ الْفَتْحِ  وَعَلَى         [9/29]      رَأْسِهِ  الْمِغْفَرُ  غَيْرَ مُحْرِمٍ ، فَلَمَّا نَزَعَهُ جَاءَهُ  فَقَالَ :  ابْنُ خَطَلٍ  مُتَعَلِّقٌ بِأَسْتَارِ  الْكَعْبَةِ  ، فَقَالَ : "" اقْتُلُوهُ  .  كذا في طبعة دار الحرمين ، وأشار محقق طبعة دار الحرمين أنها كذلك بالأصول الخطية وأن الصواب : ( سفيان بن عيينة )  كذا في طبعة دار الحرمين ، وقال محققه : لعل هنا سقطا وفي الموطأ رقم ( 956 ) : ( جاءه رجل ) واللفظة ليست في طبعة الطحان أيضا","","Al-Mu'jam al-Awsat 9034","","أنس بن مالك عن الزهري عن مالك بن أنس عن سفيان بن عيينة عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9043","9035  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  خَالِدٌ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  حُمَيْدٍ .  عَنْ  أَنَسٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - احْتَجَمَ وَهُوَ مُحْرِمٌ  مِنْ دَاءٍ فِي رَأْسِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حُمَيْدٍ  إِلَّا  عَبْدُ اللهِ بْنُ عُمَرَ  .","","Al-Mu'jam al-Awsat 9035","","أنس بن مالك عن حميد الطويل عن عبد الله بن عمر العمري عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9044","9036  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدٌ ،  نَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  حُمَيْدٍ .  عَنْ  أَنَسٍ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ بَيْعِ  الثَّمَرَةِ  حَتَّى  تُزْهِيَ  ، فَقِيلَ لَهُ : وَمَا  تُزْهِي  ؟ قَالَ : "" حَتَّى تَحْمَرَّ  .","","Al-Mu'jam al-Awsat 9036","","أنس بن مالك عن حميد الطويل عن عبد الله بن عمر العمري عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9045","9037  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  خَالِدُ بْنُ نِزَارٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ .  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  قَدِمَ ثَمَانِيَةُ رَهْطٍ مِنْ  عُكْلٍ  الْمَدِينَةَ  ، فَأَسْلَمُوا  فَاجْتَوَوُا  الْأَرْضَ ، فَأَتَوْا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَشَكَوْا إِلَيْهِ ، فَقَالَ لَهُمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اغْدُوا إِلَى الْإِبِلِ ، فَاشْرَبُوا مِنْ أَلْبَانِهَا وَأَبْوَالِهَا  ، فَذَهَبُوا فَكَانُوا فِيهَا مَا شَاءَ اللهُ ، فَقَتَلُوا الرَّاعِيَ وَسَاقُوا الْإِبِلَ ، فَبَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي طَلَبِهِمْ ، فَأُتِيَ بِهِمْ ، فَقَطَعَ أَيْدِيَهُمْ وَأَرْجُلَهُمْ ،  وَسَمَرَ  أَعْيُنَهُمْ  .","","Al-Mu'jam al-Awsat 9037","","أنس بن مالك عن أبو قلابة الجرمي عن أيوب السختياني عن إبراهيم بن طهمان عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9046","9038  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  خَالِدُ بْنُ نِزَارٍ ،  نَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عَبْدٍ الْقَارِيُّ ،  أَنَّهُ سَمِعَ  أَبَا هُرَيْرَةَ ، يَقُولُ :  مَا أَنَا نَهَيْتُ عَنْ صِيَامِ يَوْمِ الْجُمُعَةِ ؛ وَلَكِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَى عَنْهُ  .","","Al-Mu'jam al-Awsat 9038","","أبو هريرة الدوسي عن عبد الله بن عبد القاري عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9047","9039  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ زِيَادٍ .  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  كَانَ النَّاسُ إِذَا أَتَوْا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالتَّمْرِ سَأَلَ عَنْهُ         [9/30]      فَإِنْ قَالُوا : صَدَقَةٌ : قَالَ : "" كُلُوا "" ، وَلَمْ يَأْكُلْ ، وَإِنْ قَالُوا : هَدِيَّةٌ ، أَكَلَ مَعَهُمْ  .","","Al-Mu'jam al-Awsat 9039","","أبو هريرة الدوسي عن محمد بن زياد الجمحي عن إبراهيم بن طهمان عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9048","9040  -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" قَالَ رَبُّكُمْ تَبَارَكَ وَتَعَالَى :  كُلُّ عَمَلِ ابْنِ آدَمَ لَهُ ، إِلَّا الصَّوْمَ لِي وَأَنَا  أَجْزِي  بِهِ  ،  وَلَخُلُوفُ  فَمِ الصَّائِمِ عِنْدَ اللهِ أَطْيَبُ مِنْ رِيحِ الْمِسْكِ  .","","Al-Mu'jam al-Awsat 9040","","أبو هريرة الدوسي عن محمد بن زياد الجمحي عن إبراهيم بن طهمان عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9049","9041  -  وَعَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ الْمِسْكِينُ بِالطَّوَّافِ الَّذِي تَرُدُّهُ الْأُكْلَةُ وَالْأُكْلَتَانِ  ، وَالتَّمْرَةُ وَالتَّمْرَتَانِ ؛ وَلَكِنَّ الْمِسْكِينَ الَّذِي لَا يَجِدُ مَا يُغْنِيهِ ، وَلَا يَسْأَلُ النَّاسَ لِيُعْطُوهُ  .","","Al-Mu'jam al-Awsat 9041","","أبو هريرة الدوسي عن محمد بن زياد الجمحي عن إبراهيم بن طهمان عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9050","9042  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدٌ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ .  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  كُلُّ عَمَلِ ابْنِ آدَمَ لَهُ وَالصَّوْمُ لِي وَأَنَا  أَجْزِي  بِهِ  ،  وَلَخُلُوفُ  فَمِ الصَّائِمِ أَطْيَبُ عِنْدَ اللهِ مِنْ رِيحِ الْمِسْكِ ، يَدَعُ امْرَأَتَهُ وَشَهْوَتَهُ وَطَعَامَهُ وَشَرَابَهُ مِنْ أَجْلِي ، فَهُوَ لِي وَأَنَا  أَجْزِي  بِهِ ، لِلصَّائِمِ فَرْحَتَانِ : فَرْحَةٌ عِنْدَ فِطْرِهِ ، وَفَرْحَةٌ حِينَ يَلْقَانِي ، الصِّيَامُ  جُنَّةٌ ،  فَإِنْ قَاتَلَهُ أَحَدٌ أَوْ شَتَمَهُ أَحَدٌ فَلَا يُكَلِّمْهُ ، وَلْيَقُلْ : إِنِّي صَائِمٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  إِلَّا  خَالِدُ بْنُ نِزَارٍ  .","","Al-Mu'jam al-Awsat 9042","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن عبد الله بن عمر العمري عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9051","9043  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  وَثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ أَبِي كَثِيرٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ، قَالَ :  دَخَلْتُ عَلَى أَنَسِ بْنِ مَالِكٍ عِنْدَ الْعَصْرِ يَوْمَ يَشُكُّونَ فِيهِ رَمَضَانَ ، وَأَنَا أُرِيدُ أَنْ أُسَلِّمَ عَلَيْهِ ،  فَدَعَا بِطَعَامٍ فَأَكَلَ "" ، فَقُلْتُ : هَذَا الَّذِي تَصْنَعُ سُنَّةٌ ؟  قَالَ  : "" نَعَمْ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا  مُحَمَّدُ بْنُ جَعْفَرٍ  .","","Al-Mu'jam al-Awsat 9043","","أنس بن مالك عن محمد بن كعب بن سليم القرظي عن محمد بن المنكدر عن زيد بن أسلم عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","مقدام بن داود بن عيسى المصري"
"9052","[9/31]      9044  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  خَالِدُ بْنُ نِزَارٍ ،  نَا  الْمُنْكَدِرُ بْنُ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِيهِ  .  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  كُلُّ مَعْرُوفٍ صَدَقَةٌ  ، وَمِنَ الْمَعْرُوفِ أَنْ تَلْقَى أَخَاكَ بِوَجْهٍ  طَلْقٍ  ، وَأَنْ  تُفْرِغَ  مِنْ دَلْوِكَ فِي إِنَاءِ أَخِيكَ  .","","Al-Mu'jam al-Awsat 9044","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن المنكدر بن محمد بن المنكدر القرشي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9053","9045  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدُ بْنُ نِزَارٍ ، قَالَ :  سَمِعْتُ  سُفْيَانَ بْنَ عُيَيْنَةَ ، يَقُولُ :  كَانَ مُحَمَّدُ بْنُ الْمُنْكَدِرِ إِذَا ذَكَرَ الْقَدَرِيَّةَ  قَالَ  :  الْقَدَرِيَّةُ الْمُشْرِكُونَ  "" .","","Al-Mu'jam al-Awsat 9045","","محمد بن المنكدر عن سفيان بن عيينة عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9054","9046  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  خَالِدُ بْنُ نِزَارٍ ،  نَا  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ .  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ يَتَصَبَّرْ يُصَبِّرْهُ اللهُ  ، وَمَنْ يَسْتَغْنِ يُغْنِهِ اللهُ ، وَمَنْ سَأَلَنَا نُعْطِهِ ، وَمَا أُعْطِيَ أَحَدٌ رِزْقًا أَوْسَعَ لَهُ مِنَ الصَّبْرِ  .","","Al-Mu'jam al-Awsat 9046","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن زيد بن أسلم عن هشام بن سعد المخزومي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9055","9047  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  خَالِدٌ ،  ثَنَا  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ .  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ :  قُلْتُ :  يَا رَسُولَ اللهِ أَيُّ النَّاسِ أَشَدُّ بَلَاءً ؟ فَقَالَ : "" النَّبِيُّونَ  ، قُلْتُ : ثُمَّ أَيٌّ ؟ قَالَ : "" ثُمَّ الصَّالِحُونَ ، إِنْ كَانَ أَحَدُهُمْ لَيُبْتَلَى بِالْفَقْرِ حَتَّى مَا يَجِدُ إِلَّا التَّمْرَةَ أَوْ نَحْوَهَا ، وَإِنْ كَانَ أَحَدُهُمْ لَيُبْتَلَى فَيَقْمَلُ حَتَّى يَنْبِذَ الْقَمْلَ ، وَكَانَ أَحَدُهُمْ بِالْبَلَاءِ أَشَدَّ فَرَحًا مِنْهُ بِالرَّخَاءِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا  هِشَامُ بْنُ سَعْدٍ  .","","Al-Mu'jam al-Awsat 9047","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن زيد بن أسلم عن هشام بن سعد المخزومي عن خالد بن نزار عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9056","9048  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ وَعُثْمَانُ بْنُ صَالِحٍ ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُحَمَّدِ بْنِ زَيْدِ بْنِ الْمُهَاجِرِ بْنِ قُنْفُذٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ .  عَنْ  جَابِرٍ ،  أَنَّ  رَجُلًا مِنْ ثَقِيفَ  أَهْدَى لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَاوِيَةً مِنْ خَمْرٍ بَعْدَمَا         [9/32]      حُرِّمَتِ الْخَمْرُ ، فَأَمَرَ بِهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَشُقَّتْ ، فَقَالَ رَجُلٌ : لَوْ أَمَرْتَ بِهَا فَتُبَاعَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ الَّذِي حَرَّمَ شُرْبَهَا حَرَّمَ بَيْعَهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ زَيْدٍ  إِلَّا  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9048","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن محمد بن زيد بن المهاجر الجدعاني عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9057","9049  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ وَعُثْمَانُ بْنُ صَالِحٍ ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ .  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا تَدْفَعُوا يَوْمَ عَرَفَةَ حَتَّى يَدْفَعَ الْإِمَامُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  إِلَّا  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9049","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9058","9050  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ وَعُثْمَانُ بْنُ صَالِحٍ ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ .  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  كَانَ يَقُولُ :  اللَّهُمَّ إِنِّي أَسْأَلُكَ عِلْمًا نَافِعًا  ، وَأَعُوذُ بِكَ مِنْ عِلْمٍ لَا يَنْفَعُ  .","","Al-Mu'jam al-Awsat 9050","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9059","9051  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  نَا  عُثْمَانُ بْنُ صَالِحٍ وَعَبْدُ اللهِ بْنُ يُوسُفَ ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ .  عَنْ  جَابِرٍ ،  أَنَّ  امْرَأَةً  كَانَتْ بَيْنَهَا وَبَيْنَ  زَوْجِهَا  خُصُومَةٌ ، فَأَتَيَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَتِ الْمَرْأَةُ : هَذَا زَوْجِي ، وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا فِي الْأَرْضِ أَبْغَضُ إِلَيَّ مِنْهُ ، وَقَالَ الزَّوْجُ : هَذِهِ امْرَأَتِي ، وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا فِي الْأَرْضِ شَيْءٌ أَبْغَضُ إِلَيَّ مِنْهَا ،  فَأَمَرَهُمَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَدْنُوَا إِلَيْهِ ، ثُمَّ دَعَا لَهُمَا  ، فَلَمْ  يَفْتَرِقَا  مِنْ عِنْدِهِ حَتَّى قَالَتْ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا خَلَقَ اللهُ شَيْئًا أَحَبَّ إِلَيَّ مِنْهُ ، وَقَالَ         [9/33]      الزَّوْجُ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا خَلَقَ اللهُ شَيْئًا أَحَبَّ إِلَيَّ مِنْهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ الْمُنْكَدِرِ  إِلَّا  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9051","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عبد الله بن لهيعة عن عثمان بن صالح بن صفوان عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9060","9052  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ وَالنَّضْرُ بْنُ عَبْدِ الْجَبَّارِ ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ، أَنَّ عَاصِمَ بْنَ عُمَرَ بْنِ قَتَادَةَ ،  حَدَّثَهُ  .  أَنَّ جَابِرَ بْنَ عَبْدِ اللهِ عَادَهُ ، ثُمَّ  قَالَ  : لَا أَبْرَحُ حَتَّى تَحْتَجِمَ ؛ فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْحِجَامَةُ شِفَاءٌ  .","","Al-Mu'jam al-Awsat 9052","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عاصم بن عمر الظفري عن بكير بن عبد الله بن الأشج القرشي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9061","9053  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ .  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  عَامَ  الْفَتْحِ  يَقُولُ :  إِنَّ اللهَ حَرَّمَ بَيْعَ الْخَمْرِ  ، وَالْمَيْتَةِ ، وَالْخِنْزِيرِ ، وَالْأَصْنَامِ "" ، قِيلَ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ  شُحُومَ  الْمَيْتَةِ ، فَإِنَّهَا تُدْهَنُ بِهَا السُّفُنُ ، وَتُدْهَنُ بِهَا الْجُلُودُ ،  وَتَسْتَصْبِحُ  بِهَا النَّاسُ ، فَقَالَ : "" حَرَامٌ "" ، ثُمَّ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ ذَلِكَ : ""  قَاتَلَ  اللهُ الْيَهُودَ ، إِنَّ اللهَ حَرَّمَ عَلَيْهَا  الشُّحُومَ  فَجَمَلُوهَا  ، ثُمَّ بَاعُوهَا وَأَكَلُوا أَثْمَانَهَا  .","","Al-Mu'jam al-Awsat 9053","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9062","9054  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ وَعَبْدُ اللهِ بْنُ الْحَكَمِ وَعُثْمَانُ بْنُ صَالِحٍ ، قَالُوا :  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  خَيْرِ بْنِ نُعَيْمٍ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ .  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  حَرَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثَمَنَ السِّنَّوْرِ  .","","Al-Mu'jam al-Awsat 9054","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن خير بن نعيم الناهضى عن عبد الله بن لهيعة عن عبد الله بن عبد الحكم بن أعين عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9063","9055  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  خَيْرِ بْنِ نُعَيْمٍ ،  عَنْ  عَطَاءٍ .         [9/34]      عَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  هَدَايَا الْإِمَامِ غُلُولٌ  .","","Al-Mu'jam al-Awsat 9055","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن خير بن نعيم الناهضى عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9064","9056  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  نَا  مُحَمَّدُ بْنُ مُسْلِمٍ الطَّائِفِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ .  عَنْ  جَابِرٍ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، عَنِ  الْمُخَابَرَةِ  ،  وَالْمُزَابَنَةِ  ، وَالْمُحَاقَلَةِ  وَالْمُخَابَرَةُ  : عَلَى الثُّلُثِ وَالرُّبُعِ وَالنِّصْفِ بِبَيَاضِ الْأَرْضِ ،  وَالْمُزَابَنَةُ  : بَيْعُ الرُّطَبِ بِالتَّمْرِ ، وَبَيْعُ الْعِنَبِ فِي الشَّجَرِ بِالزَّبِيبِ ، وَالْمُحَاقَلَةُ : بَيْعُ الزَّرْعِ قَائِمًا عَلَى أُصُولِهِ بِالطَّعَامِ  .","","Al-Mu'jam al-Awsat 9056","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9065","9057  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ .  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا صَدَقَةَ فِي شَيْءٍ مِنَ الزَّرْعِ وَالنَّخْلِ وَالْكَرْمِ  حَتَّى يَكُونَ  جِدَادُهُ  خَمْسَةَ  أَوْسُقٍ  .","","Al-Mu'jam al-Awsat 9057","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9066","9058  -  وَعَنْ  جَابِرٍ ، قَالَ :  جَاءَ  رَجُلٌ  وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ يَوْمَ الْجُمُعَةِ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" صَلَّيْتَ  ؟ "" قَالَ : لَا ، قَالَ : "" فَصَلِّ رَكْعَتَيْنِ  .","","Al-Mu'jam al-Awsat 9058","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9067","9059  -  وَعَنْ  جَابِرٍ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَضَعَ الرَّجُلُ إِحْدَى رِجْلَيْهِ عَلَى الْأُخْرَى  وَهُوَ مُسْتَلْقٍ  .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنْ  عَمْرِو بْنِ دِينَارٍ  إِلَّا  مُحَمَّدُ بْنُ مُسْلِمٍ  .","","Al-Mu'jam al-Awsat 9059","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9068","9060  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ، قَالَ :  أَتَى  رَجُلٌ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مُنْصَرَفَهُ مِنْ  حُنَيْنٍ  وَفِي ثَوْبِ  بِلَالٍ  فِضَّةٌ يَقْبِضُ مِنْهَا وَجَعَلَ يُعْطِي النَّاسَ ، فَقَالَ : يَا  مُحَمَّدُ  اعْدِلْ ،         [9/35]      فَقَالَ :  وَيْلَكَ ؛ مَنْ يَعْدِلُ إِذَا لَمْ أَعْدِلْ  ؟ لَقَدْ خِبْتُ وَخَسِرْتُ إِنْ لَمْ أَعْدِلْ "" فَقَالَ  عُمَرُ بْنُ الْخَطَّابِ  : دَعْنِي فَأَقْتُلَ هَذَا الْمُنَافِقَ ، فَقَالَ : "" مَعَاذَ اللهِ أَنْ يَتَحَدَّثَ النَّاسُ أَنِّي أَقْتُلُ أَصْحَابِي ، إِنَّ هَذَا وَأَصْحَابَهُ يَقْرَءُونَ الْقُرْآنَ لَا يُجَاوِزُ  تَرَاقِيَهُمْ  ،  يَمْرُقُونَ  مِنَ  الدِّينِ  كَمَا  يَمْرُقُ  السَّهْمُ مِنَ  الرَّمِيَّةِ  .","","Al-Mu'jam al-Awsat 9060","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن يحيى بن سعيد الأنصاري عن الليث بن سعد عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9069","9061  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ، قَالَ :  غَرَبَتِ الشَّمْسُ وَرَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِسَرِفَ  ، وَصَلَّى الْمَغْرِبَ  بِمَكَّةَ  ، وَبَيْنَهُمَا عَشَرَةُ أَمْيَالٍ ، وَغَرَبَتِ الشَّمْسُ  بِذَاتِ الْجَيْشِ  ، فَصَلَّى الْمَغْرِبَ  بِالْمَدِينَةِ  ، وَبَيْنَهُمَا أَحَدَ عَشَرَ مِيلًا  .","","Al-Mu'jam al-Awsat 9061","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن يحيى بن سعيد الأنصاري عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9070","9062  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  مَالِكُ بْنُ أَنَسٍ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ أَكْلِ لُحُومِ الضَّحَايَا بَعْدَ ثَلَاثٍ ، ثُمَّ قَالَ بَعْدَ ذَلِكَ : "" كُلُوا  ، وَتَزَوَّدُوا ، وَادَّخِرُوا  .","","Al-Mu'jam al-Awsat 9062","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9071","9063  -  وَبِهِ :  عَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ أَكْلِ لُحُومِ الضَّحَايَا بَعْدَ ثَلَاثٍ  ، وَأَنْ يَأْكُلَ الرَّجُلُ بِشِمَالِهِ ، وَأَنْ يَمْشِيَ فِي نَعْلٍ وَاحِدَةٍ  .","","Al-Mu'jam al-Awsat 9063","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9072","9064  -  وَعَنْ  جَابِرٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْبَقَرَةُ عَنْ سَبْعَةٍ ،  وَالْجَزُورُ  عَنْ سَبْعَةٍ  .","","Al-Mu'jam al-Awsat 9064","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9073","9065  -  وَعَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَغْلِقُوا الْبَابَ وَأَوْكُوا السِّقَاءَ  .","","Al-Mu'jam al-Awsat 9065","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9074","9066  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  اللَّيْثُ بْنُ سَعْدٍ ،  حَدَّثَنِي  يَحْيَى بْنُ أَيُّوبَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ .         [9/36]      عَنْ  جَابِرٍ ، قَالَ :  اشْتَرَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  أَعْرَابِيٍّ مِنْ بَنِي عَامِرِ بْنِ صَعْصَعَةَ  بَعِيرًا  ، فَلَمَّا أَوْجَبَ لَهُ الْبَيْعَ قَالَ لَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" اخْتَرْ "" قَالَ لَهُ أَعْرَابِيٌّ : إِنْ رَأَيْتُ كَالْيَوْمِ بَيْعًا خَيْرًا مِنْ بَيْعِكَ ،  عَمْرَكَ  اللهُ ، مِمَّنْ أَنْتَ ؟ قَالَ : "" مِنْ  قُرَيْشٍ  .","","Al-Mu'jam al-Awsat 9066","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن ابن جريج عن يحيى بن أيوب الغافقي عن الليث بن سعد عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9075","9067  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ، قَالَ :  أَقْبَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الْجَبَلِ وَقَدْ قَضَى حَاجَتَهُ  ، وَبَيْنَ أَيْدِيهِمْ تَمْرٌ عَلَى حَجَفَةٍ ، فَدَعَوْهُ إِلَيْهِ ، فَقَعَدَ يَأْكُلُ مَعَنَا ، وَمَا مَسَّ مَاءً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خَالِدِ بْنِ يَزِيدَ  إِلَّا  اللَّيْثُ  .","","Al-Mu'jam al-Awsat 9067","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن خالد بن يزيد الجمحي عن الليث بن سعد عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9076","9068  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  خَالِدِ بْنِ يَزِيدَ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ، قَالَ :  لَمَّا نَزَلَتْ :         {      قُلْ هُوَ الْقَادِرُ عَلَى أَنْ يَبْعَثَ عَلَيْكُمْ عَذَابًا مِنْ فَوْقِكُمْ         }      قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَعُوذُ بِاللهِ مِنْ ذَلِكَ  ،         {      أَوْ مِنْ تَحْتِ أَرْجُلِكُمْ         }      قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَعُوذُ بِاللهِ مِنْ ذَلِكَ "" ،         {      أَوْ يَلْبِسَكُمْ شِيَعًا         }      قَالَ : "" هَذَا أَيْسَرُ "" ، وَلَوِ اسْتَعَاذَهُ لَأَعَاذَهُ  .         [9/37]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خَالِدِ بْنِ يَزِيدَ  إِلَّا  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9068","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن خالد بن يزيد الجمحي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9077","9069  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا نَزَلَ الْحِجْرَ فِي  غَزْوَةِ  تَبُوكَ  قَامَ فَخَطَبَ النَّاسَ ، وَقَالَ :  يَا أَيُّهَا النَّاسُ لَا تَسْأَلُوا نَبِيَّكُمْ عَنِ الْآيَاتِ ،  هَؤُلَاءِ  قَوْمُ صَالِحٍ  سَأَلُوا نَبِيَّهُمْ أَنْ يَبْعَثَ لَهُمْ نَاقَةً فَفَعَلَ ، فَكَانَتْ تُرْوَى مِنْ هَذَا  الْفَجِّ  ، فَتَشْرَبُ مَاءَهُمْ يَوْمَ وِرْدِهَا ، وَيَحْلِبُونَ مِنْ لَبَنِهَا مِثْلَ الَّذِي كَانُوا يُصِيبُونَ مِنْ يَوْمِ غِبِّهَا ، ثُمَّ تَصْدُرُ مِنْ هَذَا  الْفَجِّ  ،  فَعَتَوْا  عَنْ أَمْرِ رَبِّهِمْ فَعَقَرُوهَا ، فَأَجَّلَهُمُ اللهُ ثَلَاثَةَ أَيَّامٍ ، وَكَانَ وَعْدُ اللهِ غَيْرَ مَكْذُوبٍ ، ثُمَّ جَاءَتْهُمُ الصَّيْحَةُ ، فَأَهْلَكَ اللهُ مَنْ كَانَ مِنْهُمْ بَيْنَ السَّمَاءِ وَالْأَرْضِ إِلَّا رَجُلًا كَانَ فِي حَرَمِ اللهِ ، فَمَنَعَهُ حَرَمُ اللهِ مِنْ عَذَابِ اللهِ "" . قِيلَ : يَا رَسُولَ اللهِ مَنْ هُوَ ؟ قَالَ : ""  أَبُو رِغَالٍ  .","","Al-Mu'jam al-Awsat 9069","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9078","9070  -  وَعَنْ  جَابِرٍ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَنَا  فَرَطٌ  لَكُمْ بَيْنَ أَيْدِيكُمْ عَلَى الْحَوْضِ  ، قَدْرُهُ مَا بَيْنَ  أَيْلَةَ  إِلَى  مَكَّةَ  ، وَسَيَأْتِي رِجَالٌ وَنِسَاءٌ ، فَلَا يَطْعَمُوا مِنْهُ شَيْئًا  .","","Al-Mu'jam al-Awsat 9070","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9079","9071  -  وَعَنْ  جَابِرٍ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  غِلَظُ الْقُلُوبِ وَالْجَفَاءُ فِي أَهْلِ الْمَشْرِقِ  ، وَالْإِيمَانُ وَالسَّكِينَةُ فِي  أَهْلِ الْحِجَازِ  .","","Al-Mu'jam al-Awsat 9071","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9080","9072  -  وَعَنْ  جَابِرٍ ،  أَنَّ  جَارِيَةً كَانَتْ لِبَعْضِ الْأَنْصَارِ  ، فَجَاءَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ :  إِنَّ سَيِّدِي يُكْرِهُنِي عَلَى الْبِغَاءِ ، فَأَنْزَلَ اللهُ :         {      وَلا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ إِنْ أَرَدْنَ تَحَصُّنًا         }      .","","Al-Mu'jam al-Awsat 9072","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9081","[9/38]      9073  -  وَعَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا أَعْجَبَتْ أَحَدَكُمُ الْمَرْأَةُ ، فَوَقَعَتْ فِي نَفْسِهِ  ، فَلْيَذْهَبْ إِلَى امْرَأَتِهِ فَلْيُوَاقِعْهَا ؛ فَإِنَّ ذَلِكَ يَرُدُّ مَا فِي نَفْسِهِ  .","","Al-Mu'jam al-Awsat 9073","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9082","9074  -  وَعَنْ  جَابِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَسْتَبْطِئُوا الرِّزْقَ  ؛ فَإِنَّهُ لَا تَمُوتُ نَفْسٌ حَتَّى تَبْلُغَ آخِرَ رِزْقِهَا ، فَأَجْمِلُوا فِي الطَّلَبِ الْحَلَالِ ، وَإِيَّاكُمْ وَالْحَرَامَ  .","","Al-Mu'jam al-Awsat 9074","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9083","9075  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  نَا  أَسَدُ بْنُ مُوسَى وَعَبْدُ اللهِ بْنُ يُوسُفَ وَالنَّضْرُ بْنُ عَبْدِ الْجَبَّارِ أَبُو الْأَسْوَدِ ، قَالُوا :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  نَحْنُ يَوْمَ الْقِيَامَةِ عَلَى  كَوْمٍ  فَوْقَ النَّاسِ  ، فَتُدْعَى الْأُمَمُ بِأَوْثَانِهَا وَمَا كَانَتْ تَعْبُدُ الْأَوَّلَ فَالْأَوَّلَ ، حَتَّى يَأْتِيَنَا رَبُّنَا بَعْدَ ذَلِكَ ، فَيَقُولُ : مَا تَنْتَظِرُونَ ؟ فَنَقُولُ : نَنْتَظِرُ رَبَّنَا ، فَيَقُولُ تَبَارَكَ وَتَعَالَى : أَنَا رَبُّكُمْ ، فَيَقُولُونَ : حَتَّى نَنْظُرَ إِلَيْكَ ، فَيَتَجَلَّى لَهُمْ ، ثُمَّ يَنْطَلِقُ وَيَتَّبِعُونَهُ ، ثُمَّ يُعْطَى كُلُّ إِنْسَانٍ مُنَافِقٍ ، وَمُؤْمِنٍ - يَوْمَ يَغْشَاهُ - ظُلَّةً ، ثُمَّ يَتَّبِعُونَهُ مَعَهُمُ الْمُنَافِقُونَ عَلَى جِسْرِ  جَهَنَّمَ ،  فِيهَا كَلَالِيبُ ،  وَحَسَكٌ  ، يَأْخُذُونَ مَنْ شَاءَ اللهُ ، ثُمَّ يُطْفَى نُورُ الْمُنَافِقِ ، وَيَنْجُو الْمُؤْمِنُ ، فَيَنْجُو أَوَّلُ زُمْرَةٍ وُجُوهُهُمْ كَالْقَمَرِ لَيْلَةَ الْبَدْرِ ، سَبْعُونَ أَلْفًا لَا يُحَاسَبُونَ ، ثُمَّ الَّذِينَ يَلُونَهُمْ كَأَضْوَإِ نَجْمٍ فِي السَّمَاءِ ، ثُمَّ كَذَلِكَ ، ثُمَّ تَحِلُّ الشَّفَاعَةُ وَيَشْفَعُونَ ، حَتَّى يَخْرُجَ مَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ وَفِي قَلْبِهِ  مِثْقَالُ  شَعِيرَةٍ مِنَ الْإِيمَانِ ، فَيُجْعَلُونَ بِفِنَاءِ الْجَنَّةِ ، وَيُهَرِيقُ أَهْلُ الْجَنَّةِ عَلَيْهِمْ مِنَ الْمَاءِ حَتَّى يَنْبُتُوا نَبَاتَ  الْغُثَاءِ  فِي السَّيْلِ ، ثُمَّ يَسْأَلُوا اللهَ حَتَّى يُجْعَلَ لِأَحَدِهِمْ مِثْلُ مُلْكِ الدُّنْيَا وَعَشَرَةِ أَمْثَالِهَا  .","","Al-Mu'jam al-Awsat 9075","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9084","9076  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ وَعَبْدُ اللهِ بْنُ يُوسُفَ وَالنَّضْرُ بْنُ عَبْدِ الْجَبَّارِ ، قَالُوا :  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ هَذِهِ الْأُمَّةَ تُبْتَلَى فِي قُبُورِهَا  ، فَإِذَا دَخَلَهُ الْمُؤْمِنُ ، وَتَوَلَّى عَنْهُ أَصْحَابُهُ ، جَاءَهُ مَلَكٌ شَدِيدُ الِانْبِهَارِ ،         [9/39]      فَيَقُولُ : مَا كُنْتَ تَقُولُ فِي هَذَا الرَّجُلِ ؟ فَيَقُولُ الْمُؤْمِنُ : أَقُولُ : إِنَّهُ رَسُولُ اللهِ وَعَبْدُهُ ، فَيَقُولُ لَهُ الْمَلَكُ : انْظُرْ مَقْعَدَكَ الَّذِي تَرَى مِنَ الْجَنَّةِ ، وَمَقْعَدَكَ الَّذِي أَنْجَاكَ اللهُ مِنْهُ مِنَ النَّارِ ، فَيَرَاهُمَا كِلَاهُمَا ، فَيَقُولُ الْمُؤْمِنُ : دَعُونِي أُبَشِّرُ أَهْلِي ، فَيُقَالُ لَهُ : اسْكُنْ ، وَأَمَّا الْمُنَافِقُ فَيَتَوَلَّى عَنْهُ أَهْلُهُ ، فَيُقَالُ لَهُ : مَا كُنْتَ تَقُولُ فِي هَذَا الرَّجُلِ ؟ فَيَقُولُ : لَا أَدْرِي ، أَقُولُ مَا يَقُولُ النَّاسُ ، فَيُقَالُ لَهُ : لَا دَرَيْتَ ، انْظُرْ إِلَى مَقْعَدِكَ الَّذِي كَانَ لَكَ مِنَ الْجَنَّةِ ، قَدْ أُبْدِلْتَ مَكَانَهُ مَقْعَدَكَ مِنَ النَّارِ  .  قَالَ  جَابِرٌ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يُبْعَثُ كُلُّ عَبْدٍ عَلَى مَا مَاتَ عَلَيْهِ  ، الْمُؤْمِنُ عَلَى إِيمَانِهِ ، وَالْمُنَافِقُ عَلَى نِفَاقِهِ  .","","Al-Mu'jam al-Awsat 9076","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن النضر بن عبد الجبار المرادي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9085","9077  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَزَالُ  طَائِفَةٌ  مِنْ أُمَّتِي يُقَاتِلُونَ عَلَى الْحَقِّ  ، ظَاهِرِينَ إِلَى يَوْمِ الْقِيَامَةِ ، وَبَيْنَ الرَّجُلِ وَبَيْنَ الْكُفْرِ تَرْكُ الصَّلَاةِ  .","","Al-Mu'jam al-Awsat 9077","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9086","9078  -  حَدَّثَنَا  الْمِقْدَامُ ،  ثَنَا  أَسَدُ بْنُ مُوسَى وَسَعِيدُ بْنُ أَبِي مَرْيَمَ ، قَالَا :  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الزُّبَيْرِ .  عَنْ  جَابِرٍ ، أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ  طَائِفَةً  مِنْ أُمَّتِي يُقَاتِلُونَ عَلَى الْحَقِّ  ، ظَاهِرِينَ إِلَى يَوْمِ الْقِيَامَةِ ، ثُمَّ يَنْزِلُ  عِيسَى ابْنُ مَرْيَمَ  ، فَيَقُولُ أَمِيرُهُمْ : تَقَدَّمْ فَصَلِّ لَنَا ، فَيَقُولُ : لَا ، إِنَّ بَعْضَكُمْ لِبَعْضٍ أَمِيرٌ ، لِيُكْرِمَ اللهُ هَذِهِ الْأُمَّةَ  .","","Al-Mu'jam al-Awsat 9078","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن عبد الله بن لهيعة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9087","9079  -  حَدَّثَنَا  الْمِقْدَامُ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ الْكُوفِيُّ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  مُزَاحِمِ بْنِ زُفَرَ ،  عَنْ  مُجَاهِدٍ .  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  دِينَارًا أَعْطَيْتَهُ مِسْكِينًا ، وَدِينَارًا أَعْطَيْتَهُ فِي رَقَبَةٍ  ، وَدِينَارًا أَنْفَقْتَهُ فِي  سَبِيلِ  اللهِ ، وَدِينَارًا أَنْفَقْتَهُ عَلَى أَهْلِكَ ، أَفْضَلُهَا الدِّينَارُ الَّذِي أَنْفَقْتَهُ عَلَى أَهْلِكَ  .","","Al-Mu'jam al-Awsat 9079","","أبو هريرة الدوسي عن مجاهد بن جبر المخزومي عن مزاحم بن زفر الجعفري عن سفيان الثوري عن عبد الله بن محمد بن المغيرة المصري عن المقدام بن داود الرعيني عن الطبراني","مقدام بن داود بن عيسى المصري"
"9088","[9/40]      مَنِ اسْمُهُ مَسْلَمَةُ  9080  -  حَدَّثَنَا  مَسْلَمَةُ بْنُ جَابِرٍ اللَّخْمِيُّ ،  ثَنَا  مُنَبِّهُ بْنُ عُثْمَانَ ،  نَا  الْوَضِينُ بْنُ عَطَاءٍ ،  عَنْ  مَحْفُوظِ بْنِ عَلْقَمَةَ ،  عَنِ  ابْنِ عَائِذٍ ،  أَنَّ  شُرَحْبِيلَ بْنَ السِّمْطِ  ،  قَالَ  لِعَمْرِو بْنِ عَبَسَةَ : هَلْ أَنْتَ مُحَدِّثِي حَدِيثًا سَمِعْتَهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيْسَ فِيهِ نِسْيَانٌ وَلَا كَذِبٌ ؟ قَالَ : نَعَمْ ؛ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : "" قَالَ اللهُ :  قَدْ حَقَّتْ مَحَبَّتِي لِلَّذِينَ يَتَصَادَقُونَ مِنْ أَجْلِي  ، وَقَدْ حَقَّتْ مَحَبَّتِي لِلَّذِينَ يَتَنَاصَرُونَ مِنْ أَجْلِي ، وَمَا مِنْ مُؤْمِنٍ وَلَا مُؤْمِنَةٍ يُقَدِّمُ اللهُ لَهُ ثَلَاثَةَ أَوْلَادٍ مِنْ صُلْبِهِ ، لَمْ يَبْلُغُوا الْحُلُمَ إِلَّا أَدْخَلَهُ اللهُ الْجَنَّةَ بِفَضْلِ رَحْمَتِهِ إِيَّاهُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْوَضِينِ بْنِ عَطَاءٍ  إِلَّا  مُنَبِّهُ بْنُ عُثْمَانَ  .","","Al-Mu'jam al-Awsat 9080","","عمرو  بن عبسة ربع الإسلام عن عبد الرحمن بن عائذ الثمالي عن محفوظ بن علقمة الحضرمي عن الوضين بن عطاء عن منبه بن عثمان الشامي عن مسلمة بن جابر اللخمي عن الطبراني","مسلمة بن جابر اللخمي"
"9089","9081  -  حَدَّثَنَا  مَسْلَمَةُ بْنُ جَابِرٍ ،  نَا  مُنَبِّهُ بْنُ عُثْمَانَ ،  حَدَّثَنِي  صَدَقَةُ ،  نَا  الْوَضِينُ بْنُ عَطَاءٍ ،  عَنْ  عَطَاءٍ الْخُرَاسَانِيِّ ،  عَنِ  الْحَسَنِ .  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْمَرْأَةُ خُلِقَتْ مِنْ ضِلَعٍ ، وَلَا يَسْتَقِيمُ لَكَ عَلَى  خُلُقٍ  وَاحِدٍ  ، فَإِنْ تُقِمْهَا تَكْسِرْهَا ، فَدَارِهَا تَعِشْ بِهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْوَضِينِ  إِلَّا  صَدَقَةُ  ،  تَفَرَّدَ بِهِ  مُنَبِّهُ بْنُ عُثْمَانَ  .","","Al-Mu'jam al-Awsat 9081","","أبو هريرة الدوسي عن الحسن البصري عن عطاء الخراساني عن الوضين بن عطاء عن صدقة بن عبد الله السمين عن منبه بن عثمان الشامي عن مسلمة بن جابر اللخمي عن الطبراني","مسلمة بن جابر اللخمي"
"9090","9082  -  حَدَّثَنَا  مَسْلَمَةُ بْنُ جَابِرٍ ،  ثَنَا  مُنَبِّهُ بْنُ عُثْمَانَ ،  نَا  ثَوْرُ بْنُ يَزِيدَ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ .  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ ذَاتَ يَوْمٍ :  أَتُحِبُّونَ أَنْ يَكُونَ لَكُمْ سُدُسُ الْجَنَّةِ ؟ "" قَالُوا : بَلَى يَا رَسُولَ اللهِ  ، عَرْضُهَا السَّمَاوَاتُ وَالْأَرْضُ ،         [9/41]      قَالَ : "" فَخُمُسُهَا ؟ "" قَالُوا : نَعَمْ ، قَالَ : "" فَالرُّبُعُ ؟ "" قَالُوا : فَذَاكَ أَكْثَرُ ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" أَرْجُو أَنْ أَكُونَ أَنَا النِّصْفَ الْبَاقِيَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  ثَوْرِ بْنِ يَزِيدَ  إِلَّا  مُنَبِّهُ بْنُ عُثْمَانَ  .","","Al-Mu'jam al-Awsat 9082","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن الشعبي عن مجالد بن سعيد عن ثور بن يزيد الكلاعي عن منبه بن عثمان الشامي عن مسلمة بن جابر اللخمي عن الطبراني","مسلمة بن جابر اللخمي"
"9091","9083  -  حَدَّثَنَا  مَسْلَمَةُ بْنُ جَابِرٍ اللَّخْمِيُّ ،  نَا  مُنَبِّهُ بْنُ عُثْمَانَ ،  نَا  صَدَقَةُ ،  حَدَّثَنِي  النُّعْمَانُ بْنُ الْمُنْذِرِ ،  عَنْ  مَكْحُولٍ وَيَحْيَى بْنِ الْحَارِثِ .  عَنْ  أَبِي أُمَامَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَحَبَّ فِي اللهِ وَأَبْغَضَ فِي اللهِ  وَأَعْطَى لِلهِ وَمَنَعَ لِلهِ ، فَقَدِ اسْتَكْمَلَ الْإِيمَانَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  النُّعْمَانِ  إِلَّا  صَدَقَةُ  ،  تَفَرَّدَ بِهِ  :  مُنَبِّهُ بْنُ عُثْمَانَ  .","","Al-Mu'jam al-Awsat 9083","","أبو أمامة الباهلي عن يحيى بن الحارث الذماري عن النعمان بن المنذر الغساني عن صدقة بن عبد الله السمين عن منبه بن عثمان الشامي عن مسلمة بن جابر اللخمي عن الطبراني","مسلمة بن جابر اللخمي"
"9092","9084  -  حَدَّثَنَا  مَسْلَمَةُ بْنُ جَابِرٍ اللَّخْمِيُّ ،  نَا  مُنَبِّهُ بْنُ عُثْمَانَ ،  نَا  صَفْوَانُ بْنُ عَمْرٍو ،  عَنْ  شُرَيْحِ بْنِ عُبَيْدٍ الْحَضْرَمِيِّ .  أَنَّ  ثَوْبَانَ مَوْلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَعَلَّكَ أَنْ  يُنْسَأَ  فِي أَجَلِكَ حَتَّى تَكُونَ مِمَّنْ يُؤَمَّرُ عَلَى عَشَرَةٍ  حِينَ يَسْكُنُ النَّاسُ  الْكُفُورَ  ، فَإِيَّاكَ أَنْ تُؤَمَّرَنَّ عَلَى عَشَرَةٍ فَمَا فَوْقَ ذَلِكَ ؛ فَإِنَّهُ لَا يُقَامُ رَجُلٌ عَلَى عَشَرَةٍ فَمَا فَوْقَ ذَلِكَ إِلَّا أَتَى اللهَ مَغْلُولًا يَدُهُ إِلَى عُنُقِهِ ، وَلَا يَفُكُّهُ مِنْ غُلِّهِ ذَلِكَ إِلَّا عَدْلٌ إِنْ كَانَ عَدَلَ بَيْنَهُمْ ، وَلَا تَعْمُرَنَّ  الْكُفُورَ  ؛ فَإِنَّ عَامِرَ  الْكُفُورِ  كَعَامِرِ الْقُبُورِ  .         [9/42]      "" لَا يُرْوَى "" مَا مِنْ أَمِيرِ عَشَرَةٍ "" عَنْ  ثَوْبَانَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  صَفْوَانُ بْنُ عَمْرٍو  .","","Al-Mu'jam al-Awsat 9084","","ثوبان بن بجدد مولى رسول الله عن شريح بن عبيد المقرائي عن صفوان بن عمرو السكسكي عن منبه بن عثمان الشامي عن مسلمة بن جابر اللخمي عن الطبراني","مسلمة بن جابر اللخمي"
"9093","9085  -  حَدَّثَنَا  مَسْلَمَةُ بْنُ الْهَيْصَمِ بْنِ مَسْلَمَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ الْفَرَجِ الرِّيَاشِيُّ ،  نَا  عَبْدُ الْمَلِكِ بْنُ قَرِيبٍ الْأَصْمَعِيُّ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  أَبِي غَالِبٍ .  عَنْ  أَبِي أُمَامَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْخَوَارِجُ كِلَابُ النَّارِ  .","","Al-Mu'jam al-Awsat 9085","","أبو أمامة الباهلي عن أبو غالب البصري صاحب أبي أمامة عن قريب بن عبد الملك الأصمعي عن الأصمعي عن عباس بن الفرج الرياشي عن مسلمة بن الهيصم الأصبهاني عن الطبراني","مسلمة بن الهيصم بن مسلمة الأصبهاني"
"9094","مَنِ اسْمُهُ مَسْعَدَةُ  9086  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  أَبُو ضَمْرَةَ أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ،  عَنْ  عُمَرَ بْنِ مُنَبِّهٍ ،  عَنْ  أَبِي عَبْدِ اللهِ الْقَرَّاظِ .  عَنْ  سَعْدِ بْنِ أَبِي وَقَّاصٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا يُرِيدُ أَحَدٌ  الْمَدِينَةَ  بِسُوءٍ إِلَّا أَذَابَهُ اللهُ  كَمَا يَذُوبُ الْمِلْحُ فِي الْمَاءِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ حَرْمَلَةَ  إِلَّا  أَبُو ضَمْرَةَ  .","","Al-Mu'jam al-Awsat 9086","","سعد بن أبي وقاص عن دينار القراظ عن عمر بن نبيه الكعبي عن عبد الرحمن بن حرملة الأسلمي عن أنس بن عياض الليثي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9095","9087  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  نَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  أَبُو ضَمْرَةَ ،  عَنِ  ابْنِ حَرْمَلَةَ ،  عَنْ  سَعْدٍ الظَّفَرِيِّ ، "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الْكَيِّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ حَرْمَلَةَ  إِلَّا  أَبُو ضَمْرَةَ  .","","Al-Mu'jam al-Awsat 9087","","سعد الظفري عن عبد الرحمن بن حرملة الأسلمي عن أنس بن عياض الليثي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9096","9088  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ سُلَيْمَانَ ، قَالَ :  سَمِعْتُ  عُمَارَةَ بْنَ غَزِيَّةَ ،  يُحَدِّثُ عَنْ  فَاطِمَةَ بِنْتِ الْحُسَيْنِ ،  عَنْ  أَبِيهَا  أَنَّ  عَبْدَ اللهِ بْنَ عَمْرٍو ، قَالَ :  يَا رَسُولَ اللهِ أَمِنَ  الْكِبْرِ  أَنْ يَكُونَ لِأَحَدِنَا النَّجِيبَةُ  الْفَارِهَةُ  ؟ قَالَ : "" لَا "" ، قَالَ : فَمِنَ  الْكِبْرِ  أَنْ يَكُونَ لِأَحَدِنَا  الْحُلَّةُ  الْحَسَنَةُ ؟         [9/43]      قَالَ : "" لَا "" ، قَالَ : فَمِنَ  الْكِبْرِ  أَنْ يَكُونَ لِأَحَدِنَا النَّعْلَانِ الْحَسَنَتَانِ ؟ قَالَ : "" لَا "" ، قَالَ : فَمِنَ  الْكِبْرِ  أَنْ أَتَّخِذَ طَعَامًا فَأَدْعُوَ قَوْمِي فَيَمْشُونَ خَلْفِي وَيَأْكُلُونَ عِنْدِي ؟ قَالَ : "" لَا "" ، قَالَ : فَمَا  الْكِبْرُ  يَا رَسُولَ اللهِ ؟ قَالَ : "" أَنْ تُسَفِّهَ الْحَقَّ  وَتَغْمِصَ  النَّاسَ  .  ""  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ  إِلَّا  عَبْدُ الْحَمِيدِ بْنُ سُلَيْمَانَ  ، وَلَا يُرْوَى عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9088","","عبد الله بن عمرو بن العاص عن الحسين بن علي عن فاطمة بنت الحسين بن علي بن أبي طالب عن عمارة بن غزية عن عبد الحميد بن سليمان الخزاعي عن سعيد بن منصور عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9097","9089  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  نَا  سَعِيدُ بْنُ مَنْصُورٍ ،  نَا  نُوحُ بْنُ قَيْسٍ ،  نَا  سَلَامَةُ بْنُ الْكِنْدِيِّ ، قَالَ :  كَانَ عَلِيٌّ - رَضِيَ اللهُ عَنْهُ - يُعَلِّمُ النَّاسَ الصَّلَاةَ عَلَى نَبِيِّ اللهِ ،  يَقُولُ  :  اللَّهُمَّ دَاحِيَ  الْمَدْحُوَّاتِ  ، وَبَارِئَ  الْمَسْمُوكَاتِ  ،  وَجَبَّارَ  الْقُلُوبِ عَلَى  فِطْرَاتِهَا  شَقِيِّهَا وَسَعِيدِهَا ، اجْعَلْ شَرَائِفَ صَلَوَاتِكَ وَنَوَامِيَ بَرَكَاتِكَ وَرَافِعَ تَحِيَّتِكَ عَلَى  مُحَمَّدٍ  عَبْدِكَ وَرَسُولِكَ ، الْخَاتِمِ لِمَا سَبَقَ ، وَالْفَاتِحِ لِمَا أُغْلِقَ ، وَالْمَعْلُومِ الْحَقَّ بِالْحَقِّ ،  وَالدَّامِغِ  جَيْشَاتِ  الْأَبَاطِيلِ كَمَا كَمُلَ  فَاضْطَلَعَ  بِأَمْرِكَ لِطَاعَتِكَ مُسْتَوْفِرًا فِي مَرْضَاتِكَ بِغَيْرِ مُلْكٍ فِي قَدَمٍ ، وَلَا وَهَنٍ فِي  عَزْمٍ  ، دَاعِيًا لِوَحْيِكَ ، حَافِظًا لِعَهْدِكَ ، مَاضِيًا عَلَى نَفَادِ أَمْرِكَ حَتَّى  أَوْرَى  تَبَسُّمًا لِقَابِسٍ ، بِهِ هُدِيَتِ الْقُلُوبُ بَعْدَ خَرْصَاتِ الْفِتَنِ وَالْإِثْمِ بِمُوضِحَاتِ الْأَعْلَامِ ، وَمَسَرَّاتِ الْإِسْلَامِ وَمَاثَرَاتِ الْأَحْكَامِ ، فَهُوَ أَمِينُكَ الْمَأْمُونُ ، وَخَازِنُ عِلْمِكَ الْمَخْزُونِ ،  وَشَهِيدُكَ  يَوْمَ الدِّينِ ، وَمَبْعُوثُكَ نِعْمَةً ، وَرَسُولُكَ بِالْحَقِّ رَحْمَةً ، اللَّهُمَّ  افْسَحْ  لَهُ مُتَفَسَّحًا فِي عَدْلِكَ ، وَاجْزِهِ مُضَاعَفَاتِ الْخَيْرِ مِنْ فَضْلِكَ لَهُ مُهَنَّيَاتٍ غَيْرَ مُكَدَّرَاتٍ مِنْ فَوْزِ ثَوَابِكَ الْمَعْلُومِ وَجَزِيلِ عَطَائِكَ الْمَجْلُولِ ، اللَّهُمَّ أَعْلِ عَلَى         [9/44]      بِنَاءِ الْبَاقِينَ  بِنَاءَهُ ، وَأَكْرِمْ مَثْوَاهُ لَدَيْكَ وَنُزُلَهُ ، وَأَتْمِمْ لَهُ نُورَهُ وَأَجْرَهُ ، مِنِ ابْتِعَائِكَ  لَهُ ، مَقْبُولَ الشَّهَادَةِ مَرْضِيَّ الْمَقَالَةِ ، ذَا مَنْطِقٍ عَدْلٍ ، وَكَلَامٍ فَصْلٍ ، وَحُجَّةٍ  وَبُرْهَانٍ  عَظِيمٍ  ""  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَلِيٍّ  رَضِيَ اللهُ عَنْهُ إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  نُوحُ بْنُ قَيْسٍ الطَّاحِيُّ  .  كذا في طبعة دار الحرمين ، وفي طبعة الطحان : ( البانين ) وفي بعض المصادر : ( الناس )  كذا في طبعة دار الحرمين ، وهو موافق لبعض المصادر . وفي طبعة الطحان : ( ابتعاثك ) وهو موافق لبعض المصادر أيضا ، وفي بعضها : ( ابتغائك ) . فالله أعلم","","Al-Mu'jam al-Awsat 9089","","علي بن أبي طالب عن سلامة بن الكندي عن نوح بن قيس بن رباح الحداني عن سعيد بن منصور عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9098","9090  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  نَا  سَعِيدُ بْنُ مَنْصُورٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  سَعِيدِ بْنِ أَبِي هِنْدٍ ، أَنَّ أَبَا مُرَّةَ - مَوْلَى عَقِيلِ بْنِ أَبِي طَالِبٍ -  أَخْبَرَهُمْ  أَنَّ أُمَّ هَانِئٍ  أَخْبَرَتْهُ  ،  أَنَّهَا أَجَارَتْ رَجُلَيْنِ مِنْ  بَنِي مَخْزُومٍ  يَوْمَ فَتْحِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مَكَّةَ  ، فَدَخَلَ عَلَيْهَا  عَلِيٌّ  ، فَقَالَ : مَا هَذَا يَا  أُمَّ هَانِئٍ  ؟ لَأَقْتُلَنَّهُمَا ، قَالَتْ : فَأَغْلَقْتُ عَلَيْهِمَا ، ثُمَّ ذَهَبْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَجَدْتُهُ يَغْتَسِلُ وَابْنَتُهُ  فَاطِمَةُ  تَسْتُرُهُ بِثَوْبٍ ، فَاغْتَسَلَ ثُمَّ أَخَذَ الثَّوْبَ فَالْتَحَفَ ، ثُمَّ صَلَّى الضُّحَى ثَمَانِ رَكَعَاتٍ ، ثُمَّ قَالَ : "" مَا لَكِ يَا  أُمَّ هَانِئٍ  ؟ "" قُلْتُ : إِنِّي قَدْ أَجَرْتُ رَجُلَيْنِ مِنْ أَحْمَائِي ، فَجَاءَ  عَلِيٌّ  يُرِيدُ أَنْ يَقْتُلَهُمَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدْ أَمَّنَّا مَنْ أَمَّنْتِ ، وَأَجَرْنَا مَنْ أَجَرْتِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ  إِلَّا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ  .","","Al-Mu'jam al-Awsat 9090","","فاختة الهاشمية أخت علي بن أبي طالب عن يزيد المدني مولى عقيل بن أبي طالب عن سعيد بن أبي هند الفزاري عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن سعيد بن منصور عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9099","9091  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  نَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبَّاسُ بْنُ أَبِي شَمْلَةَ ،  عَنْ  كَثِيرِ بْنِ عَبْدِ اللهِ الْمُزَنِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ مِنَ الشِّعْرِ  حِكْمَةً  .         [9/45]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  كَثِيرٍ  إِلَّا  عَبَّاسُ بْنُ أَبِي شَمْلَةَ  ،  تَفَرَّدَ بِهِ  :  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9091","","عمرو بن عوف بن زيد المزني عن عبد الله بن عمرو بن عوف المزني عن كثير بن عبد الله بن عمرو بن عوف اليشكري عن عباس بن أبى شملة المدني عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9100","9092  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مُحَمَّدُ بْنُ الْعَلَاءِ الثَّقَفِيُّ ، قَالَ :  سَمِعْتُ  الْوَلِيدَ بْنَ إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  يُحَدِّثُ عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنِّي لَأَجِدُ التَّمْرَةَ سَاقِطَةً ، فَآخُذُهَا ، فَآكُلُهَا  .","","Al-Mu'jam al-Awsat 9092","","عبد الرحمن بن عوف بن عبد عوف القرشي عن إبراهيم بن عبد الرحمن بن عوف عن الوليد بن إبراهيم بن عبد الرحمن بن عوف عن محمد بن العلاء بن أبي نيقة عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9101","9093  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  نَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مُحَمَّدُ بْنُ الْعَلَاءِ الثَّقَفِيُّ ،  عَنِ  الْوَلِيدِ بْنِ إِبْرَاهِيمَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  أَبِيهِ .  عَنْ  جَدِّهِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُكْرِهُوا مَرْضَاكُمْ عَلَى الطَّعَامِ وَالشَّرَابِ  ، فَإِنَّ اللهَ يُطْعِمُهُمْ وَيَسْقِيهِمْ  .  لَا يُرْوَى هَذَانِ الْحَدِيثَانِ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِمَا  :  مُحَمَّدُ بْنُ الْعَلَاءِ الثَّقَفِيُّ  .","","Al-Mu'jam al-Awsat 9093","","عبد الرحمن بن عوف بن عبد عوف القرشي عن إبراهيم بن عبد الرحمن بن عوف عن الوليد بن إبراهيم بن عبد الرحمن بن عوف عن محمد بن العلاء بن أبي نيقة عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9102","9094  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  نَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مَعْنُ بْنُ عِيسَى ،  ثَنَا  إِسْحَاقُ بْنُ حَازِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ ،  عَنْ  سَالِمٍ ،  عَنِ  ابْنِ عُمَرَ .  عَنْ  حَفْصَةَ  ، زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا صِيَامَ لِمَنْ لَمْ  يُؤَرِّضْهُ  قَبْلَ الْفَجْرِ  ،  يَعْنِي : يَنْوِيهِ  "" .         [9/46]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْحَاقَ بْنِ حَازِمٍ  إِلَّا  مَعْنٌ .  وَرَوَى هَذَا الْحَدِيثَ  اللَّيْثُ بْنُ سَعْدٍ  ، عَنْ  يَحْيَى بْنِ أَيُّوبَ  ، عَنْ  عَبْدِ اللهِ بْنِ أَبِي بَكْرٍ  ، عَنِ  الزُّهْرِيِّ  ، عَنْ  سَالِمٍ  ، عَنْ أَبِيهِ ، عَنْ  حَفْصَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَمْ يَقُلْ : ""  يُؤَرِّضْهُ  "" ، قَالَ : ""  يَفْرِضْهُ  "" .","","Al-Mu'jam al-Awsat 9094","","حفصة بنت عمر بن الخطاب عن عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن عبد الله بن أبي بكر بن محمد  ابن حزم عن إسحاق بن حازم البزاز عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9103","9095  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  سُفْيَانُ بْنُ حَمْزَةَ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ .  عَنْ  أَبِي ذَرٍّ ، قَالَ :  أَوْصَانِي حَبِيبِي - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِثَلَاثٍ : بِصَلَاةِ الضُّحَى  ، وَأَنْ لَا أَبِيتَ إِلَّا عَلَى  وِتْرٍ  ، وَصِيَامِ ثَلَاثَةِ أَيَّامٍ مِنْ كُلِّ شَهْرٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْمُطَّلِبِ  إِلَّا  كَثِيرُ بْنُ زَيْدٍ  ،  تَفَرَّدَ بِهِ  سُفْيَانُ بْنُ حَمْزَةَ  .","","Al-Mu'jam al-Awsat 9095","","أبو ذر الغفاري عن المطلب بن عبد الله بن حنطب المخزومي عن كثير بن زيد السهمي عن سفيان بن حمزة الأسلمي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9104","9096  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  نَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  عَبَّاسُ بْنُ أَبِي شَمْلَةَ ،  عَنْ  مُوسَى بْنِ يَعْقُوبَ الزَّمْعِيِّ ،  عَنْ  قَرِيبَةَ بِنْتِ وَهْبِ بْنِ عَبْدِ اللهِ بْنِ زَمْعَةَ .  عَنْ  زَيْنَبَ بِنْتِ أُمِّ سَلَمَةَ ، قَالَتْ :  دَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَغْتَسِلُ ، فَأَخَذَ حَفْنَةً مِنْ مَاءٍ ، فَضَرَبَ بِهَا وَجْهِي ، وَقَالَ :  وَرَاءَكِ أَيْ  لَكَاعِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  زَيْنَبَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9096","","زينب بنت أبي سلمة المخزومية عن قريبة بنت عبد الله بن وهب الأسدية عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن عباس بن أبى شملة المدني عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9105","9097  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  نَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  عَبَّاسُ بْنُ أَبِي شَمْلَةَ ،  حَدَّثَنِي  مُوسَى بْنُ يَعْقُوبَ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الْهَادِ ،  عَنْ  أَبِي بَكْرِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ ،  عَنْ  حَكِيمِ بْنِ حِزَامٍ ، قَالَ :  سَمِعْنَا صَوْتًا مِنَ السَّمَاءِ وَقَعَ إِلَى الْأَرْضِ  ، كَأَنَّهُ         [9/47]      صَوْتُ حَصَاةٍ وَقَعَ فِي طَسْتٍ ، وَرَمَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تِلْكَ الْحَصَاةَ فَانْهَزَمْنَا  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  حَكِيمِ بْنِ حِزَامٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  مُوسَى بْنُ يَعْقُوبَ  ، وَلَمْ يَرْوِهِ عَنْ  مُوسَى  إِلَّا  عَبَّاسُ بْنُ أَبِي شَمْلَةَ  وَابْنُ أَبِي فُدَيْكٍ  .","","Al-Mu'jam al-Awsat 9097","","حكيم بن حزام عن أبو بكر بن سليمان بن أبي حثمة العدوي عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن عباس بن أبى شملة المدني عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9106","9098  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبَّاسُ بْنُ أَبِي شَمْلَةَ ،  عَنْ  مُوسَى بْنِ يَعْقُوبَ ،  عَنِ  ابْنِ الْأَسْقَعِ ،  عَنْ  رُبَيْحِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي سَعِيدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  .  أَنَّ أَبَاهُ  مَالِكَ بْنَ سِنَانٍ  لَمَّا أُصِيبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي وَجْهِهِ  يَوْمَ  أُحُدٍ  ، مَصَّ دَمَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَازْدَرَدَهُ ، فَقِيلَ لَهُ : أَتَشْرَبُ الدَّمَ ؟ قَالَ : نَعَمْ ، أَشْرَبُ دَمَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَالَطَ دَمِي بِدَمِهِ ، لَا تَمَسُّهُ النَّارُ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي سَعِيدٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9098","","أبو سعيد الخدري عن عبد الرحمن بن أبي سعيد الخدري عن ربيح بن عبد الرحمن الخدري عن مصعب بن الأسقع عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن عباس بن أبى شملة المدني عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9107","9099  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبَّاسُ بْنُ أَبِي شَمْلَةَ ،  عَنْ  مُوسَى بْنِ يَعْقُوبَ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الْوَلِيدِ بْنِ عُثْمَانَ .  عَنْ  أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ارْمُوا جَمَرَاتِ  مُضَرَ  ، وَكَانَتْ كُلُّ قَبِيلَةٍ تَرْمِي جَمْرَةً  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَسْمَاءَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9099","","أسماء بنت أبي بكر عن يزيد بن عبد الله بن الوليد بن عثمان عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن عباس بن أبى شملة المدني عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9108","[9/48]      9100  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مُحَمَّدُ بْنُ فُلَيْحٍ ،  نَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  سُئِلَ  عَبْدُ اللهِ بْنُ عَمْرٍو :  مَا أَشَدَّ مَا رَأَيْتَ مِنَ الْمُشْرِكِينَ نَالُوا مِنْ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : أَشَدُّ مَا رَأَيْتُهُمْ نَالُوا مِنْهُ أَنِّي رَأَيْتُهُمْ تَوَاعَدُوا لَهُ يَوْمًا ، فَأَخَذُوا - وَهُوَ يَطُوفُ - فَأَخَذُوا بِجَامِعِ رِدَائِهِ ، فَقَالُوا : أَنْتَ الَّذِي تَسُبُّ آلِهَتَنَا ، وَتَنْهَانَا عَمَّا يَعْبُدُ آبَاؤُنَا ؟ فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" نَعَمْ ، أَنَا ذَاكَ "" ، قَالَ :  وَأَبُو بَكْرٍ  يَحْتَضِنُهُ ، يَقُولُ بِأَعْلَى صَوْتِهِ :         {      أَتَقْتُلُونَ رَجُلا أَنْ يَقُولَ رَبِّيَ اللهُ وَقَدْ جَاءَكُمْ بِالْبَيِّنَاتِ مِنْ رَبِّكُمْ         }      ؟ وَعَيْنَاهُ  تَنْضَحَانِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  مُحَمَّدُ بْنُ فُلَيْحٍ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9100","","عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن محمد بن فليح بن سليمان الأسلمي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9109","9101  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مُحَمَّدُ بْنُ فُلَيْحٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ زَيْدِ بْنِ الْمُهَاجِرِ بْنِ قُنْفُذٍ ،  عَنْ  أَبِيهِ  .  عَنْ  أُمِّ سَلَمَةَ ، زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صَلَاةُ الْمَرْأَةِ فِي بَيْتِهَا خَيْرٌ مِنْ صَلَاتِهَا فِي حُجْرَتِهَا  ، وَصَلَاتُهَا فِي حُجْرَتِهَا خَيْرٌ مِنْ صَلَاتِهَا فِي دَارِهَا ، وَصَلَاتُهَا فِي دَارِهَا خَيْرٌ مِنْ صَلَاتِهَا خَارِجٍ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أُمِّ سَلَمَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9101","","هند بنت أبي أمية زوج رسول الله عن زيد بن المهاجر بن قنفذ التيمي عن محمد بن زيد بن المهاجر الجدعاني عن محمد بن فليح بن سليمان الأسلمي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9110","9102  -  حَدَّثَنَا  مَسْعَدَةُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ ،  حَدَّثَنِي  أَبُو غَسَّانَ مُحَمَّدُ بْنُ مُطَرِّفٍ ،  عَنْ  عُمَرَ بْنِ نَافِعٍ ،  عَنْ  أَبِيهِ نَافِعٍ  ،  أَنَّ  رَجُلًا  سَأَلَ عَبْدَ اللهِ بْنَ عُمَرَ ، فَقَالَ :  إِنَّ لِي خَالًا فَارَقَ امْرَأَتَهُ ، فَدَخَلَهُ مِنْ ذَاكَ هَمٌّ وَأَمْرٌ شَقَّ عَلَيْهِ ، فَأَرَدْتُ أَنْ أَتَزَوَّجَهَا  ، وَلَمْ يَأْمُرْنِي بِذَلِكَ ، وَلَمْ يَعْلَمْ ؟  فَقَالَ  ابْنُ عُمَرَ  : "" لَا ، إِلَّا أَنْ تَنْكِحَ نِكَاحَ غِبْطَةٍ ، إِنْ وَافَقَتْكَ أَمْسَكْتَ ، وَإِنْ كَرِهْتَ         [9/49]      فَارَقْتَ ؛ فَإِنَّا كُنَّا نَعُدُّ هَذَا فِي زَمَانِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  السِّفَاحَ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَرَ  إِلَّا  أَبُو غَسَّانَ مُحَمَّدُ بْنُ مُطَرِّفٍ  .","","Al-Mu'jam al-Awsat 9102","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عمر بن نافع مولى ابن عمر عن محمد بن مطرف بن داود عن محمد بن فليح بن سليمان الأسلمي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9111","9103  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  إِسْحَاقُ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْمُخَرِّمِيُّ ،  عَنْ  عُثْمَانَ بْنِ مُحَمَّدٍ الْأَخْنَسِيِّ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِيهِ  .  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ وَلِيَ الْقَضَاءَ فَقَدْ  ذُبِحَ  بِغَيْرِ  سِكِّينٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْحَاقَ بْنِ جَعْفَرٍ  إِلَّا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9103","","أبو هريرة الدوسي عن أبو سعيد المقبري عن سعيد المقبري عن عثمان بن محمد بن المغيرة الأخنسي عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن إسحاق بن جعفر بن محمد الجعفري الحزين عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9112","9104  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  حَدَّثَنِي  خَالِي مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ الْمُطَّلِبِ بْنِ السَّائِبِ بْنِ أَبِي وَدَاعَةَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ مُوسَى بْنِ عَبْدِ اللهِ بْنِ أَبِي أُمَيَّةَ الْمَخْزُومِيُّ ،  حَدَّثَنِي  عَمِّي مُصْعَبُ بْنُ عَبْدِ اللهِ .  عَنْ  أُمِّ سَلَمَةَ بِنْتِ أَبِي أُمَيَّةَ ، قَالَتْ :  كَانَ النَّاسُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمُصَلِّي يُصَلِّي بِصَلَاتِهِ فَلَا يَعْدُو بَصَرُهُ مَوْضِعَ قَدَمَيْهِ  ، فَتُوُفِّيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ أَبُو بَكْرٍ ، وَكَانَ النَّاسُ إِذَا قَامَ أَحَدُهُمْ يُصَلِّي لَا يَعْدُو بَصَرُهُ مَوْضِعَ جَنْبَيْهِ ، وَتُوُفِّيَ  أَبُو بَكْرٍ  وَكَانَ عُمَرُ ، وَكَانَ النَّاسُ إِذَا قَامَ أَحَدُهُمْ لَا يَعْدُو بَصَرُهُ مَوْضِعَ الْقِبْلَةِ ، وَكَانَ عُثْمَانُ بْنُ عَفَّانَ ، وَكَانَ النَّاسُ إِذَا قَامَ أَحَدُهُمْ لَا يَلْتَفِتُ فِي الصَّلَاةِ يَمِينًا وَشِمَالًا ""  .  لَا يُرْوَى عَنْ  أُمِّ سَلَمَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9104","","هند بنت أبي أمية زوج رسول الله عن مصعب بن عبد الله بن أبي أمية المخزومي عن عبد الله بن موسى بن عبد الله بن أبي أمية المخزومي عن محمد بن إبراهيم بن المطلب السهمي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9113","9105  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنِي  عِكْرِمَةُ بْنُ مُصْعَبِ بْنِ ثَابِتٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  .  عَنْ  أَبِي قَتَادَةَ ، قَالَ :  خَرَجَ مُعَاذُ بْنُ جَبَلٍ يَطْلُبُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ يَجِدْهُ ، فَطَلَبَهُ فِي بُيُوتِهِ فَلَمْ يَجِدْهُ ، فَاتَّبَعَهُ فِي سِكَّةٍ سِكَّةٍ حَتَّى دُلَّ عَلَيْهِ فِي  جَبَلِ ثَوَابٍ  ، فَخَرَجَ حَتَّى رَقِيَ  جَبَلَ ثَوَابٍ  ، فَنَظَرَ يَمِينًا وَشِمَالًا ، فَبَصُرَ بِهِ فِي الْكَهْفِ الَّذِي اتَّخَذَ النَّاسُ إِلَيْهِ طَرِيقًا إِلَى  مَسْجِدِ الْفَتْحِ  ، فَإِذَا هُوَ سَاجِدٌ ، فَهَبَطْتُ مِنْ رَأْسِ الْجَبَلِ وَهُوَ         [9/50]      سَاجِدٌ ، فَلَمْ يَرْفَعْ رَأْسَهُ حَتَّى أَسَأْتُ بِهِ الظَّنَّ ، وَظَنَنْتُ أَنْ قَدْ قُبِضَ ، فَلَمَّا رَفَعَ رَأْسَهُ قُلْتُ : يَا رَسُولَ اللهِ لَقَدْ أَسَأْتُ بِكَ الظَّنَّ ، وَظَنَنْتُ أَنَّكَ قَدْ قُبِضْتَ ، فَقَالَ :  جَاءَنِي  جِبْرِيلُ  - عَلَيْهِ السَّلَامُ - بِهَذَا الْمَوْضِعِ ، فَقَالَ : إِنَّ اللهَ تَبَارَكَ وَتَعَالَى  يُقْرِئُكَ  السَّلَامَ  ، وَيَقُولُ لَكَ : مَا تُحِبُّ أَنْ أَفْعَلَ بِأُمَّتِكَ ؟ قُلْتُ : اللهُ أَعْلَمُ ، فَذَهَبَ ثُمَّ جَاءَنِي ، فَقَالَ : إِنَّهُ يَقُولُ : لَا أَسُوءُكَ فِي أُمَّتِكَ ، فَسَجَدْتُ ، فَأَفْضَلُ مَا يُتَقَرَّبُ بِهِ إِلَى اللهِ السُّجُودُ .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي قَتَادَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9105","","معاذ بن جبل عن أبو قتادة الأنصاري فارس رسول الله عن ثابت بن أبي قتادة السلمي عن مصعب بن ثابت بن أبي قتادة الأنصاري عن عكرمة بن مصعب بن ثابت عن إسحاق بن إبراهيم بن سعيد الصواف عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9114","9106  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  مُحَمَّدُ بْنُ مَعْنٍ الْغِفَارِيُّ ،  نَا  مُوسَى بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  أَنَّهُ خَرَجَ مَعَ  عَبْدِ اللهِ بْنِ عُمَرَ  ،  فَقَالَ  عَبْدُ اللهِ بْنُ عُمَرَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَعْطَى بَيْعَتَهُ ثُمَّ نَكَثَهَا ، لَقِيَ اللهَ عَزَّ وَجَلَّ يَوْمَ الْقِيَامَةِ وَلَيْسَتْ مَعَهُ يَمِينُهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُوسَى  إِلَّا  مُحَمَّدُ بْنُ مَعْنٍ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9106","","عبد الله بن عمر بن الخطاب عن أبو موسى بن سعد الأنصاري عن موسى بن سعد الأنصاري عن محمد بن معن بن محمد الغفاري عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9115","9107  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  إِسْحَاقُ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْمُخَرِّمِيُّ ،  عَنِ  الْحَارِثِ بْنِ الْفُضَيْلِ ،  عَنْ  جَعْفَرِ بْنِ عَبْدِ اللهِ بْنِ الْحَكَمِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْمِسْوَرِ بْنِ مَخْرَمَةَ ،  عَنْ  أَبِي رَافِعٍ ، قَالَ :  قَالَ  ابْنُ مَسْعُودٍ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَمْ يَكُنْ نَبِيٌّ قَطُّ إِلَّا لَهُ فِي أُمَّتِهِ حَوَارِيُّونَ مِنْ أَصْحَابِهِ  ، يَتَّبِعُونَ أَمْرَهُ وَيَهْتَدُونَ بِسُنَّتِهِ  .         [9/51]      ""  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْحَاقَ بْنِ جَعْفَرٍ  إِلَّا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9107","","عبد الله بن مسعود عن أبو رافع القبطي عن عبد الرحمن بن المسور بن مخرمة عن جعفر بن عبد الله بن الحكم الأوسي عن الحارث بن فضيل الخطمي عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن إسحاق بن جعفر بن محمد الجعفري الحزين عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9116","9108  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مُحَمَّدُ بْنُ فُلَيْحٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ حُسَيْنِ بْنِ عَطَاءٍ ،  عَنْ  دَاوُدَ بْنِ بَكْرِ بْنِ الْفُرَاتِ ،  عَنْ  شَرِيكِ بْنِ عَبْدِ اللهِ بْنِ أَبِي نَمِرٍ .  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَسْقَى ، فَخَطَبَ قَبْلَ الصَّلَاةِ  ، وَاسْتَقْبَلَ الْقِبْلَةَ ، وَحَوَّلَ رِدَاءَهُ ، ثُمَّ نَزَلَ فَصَلَّى رَكْعَتَيْنِ لَمْ يُكَبِّرْ فِيهِمَا إِلَّا تَكْبِيرَةً تَكْبِيرَةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ حُسَيْنٍ  إِلَّا  مُحَمَّدُ بْنُ فُلَيْحٍ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9108","","أنس بن مالك عن شريك بن عبد الله بن أبي نمر الكناني عن داود بن بكر بن أبي الفرات الأشجعي عن عبد الله بن الحسين بن عطاء بن يسار عن محمد بن فليح بن سليمان الأسلمي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9117","9109  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ طَلْحَةَ التَّيْمِيُّ ،  حَدَّثَنِي  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ ، قَالَ :  كُنْتُ مَعَ  مُوسَى بْنِ طَلْحَةَ  فِي الْمَسْجِدِ  ، فَدَخَلَ السَّائِبُ بْنُ يَزِيدَ ، فَقَالَ : اذْهَبْ إِلَى ذَلِكَ الشَّيْخِ ، فَقُلْ لَهُ : يَقُولُ لَكَ عَمِّي  مُوسَى بْنُ طَلْحَةَ  : هَلْ رَأَيْتَ رَسُولَ اللهِ ، صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَأَتَيْتُهُ ، فَقُلْتُ : هَلْ رَأَيْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟  فَقَالَ  : قَدْ رَأَيْتُهُ ، "" فَدَخَلْنَا عَلَيْهِ أَنَا وَغِلْمَةٌ مَعِي ، فَوَجَدْنَاهُ يَأْكُلُ تَمْرًا فِي قِنَاعٍ ، وَمَعَهُ نَاسٌ مِنْ أَصْحَابِهِ ، فَقَبَضَ لَنَا مِنْ ذَلِكَ التَّمْرِ قَبْضَةً قَبْضَةً ، وَمَسَحَ عَلَى رُءُوسِنَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْحَاقَ  إِلَّا  مُحَمَّدُ بْنُ طَلْحَةَ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9109","","السائب بن يزيد الكندي عن إسحاق بن يحيى بن طلحة التيمي عن محمد بن طلحة بن عبد الرحمن عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9118","9110  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  حَدَّثَنِي  أَبُو مَعْشَرٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  حَمْزَةَ بْنِ الْمُغِيرَةِ بْنِ شُعْبَةَ .  عَنْ  أَبِيهِ  ، قَالَ :  خَرَجَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  غَزْوَةِ تَبُوكَ  ، فَلَمَّا كَانَ بِبَعْضِ الطَّرِيقِ         [9/52]      ذَهَبَ لِحَاجَتِهِ وَتَبِعْتُهُ ، فَلَمَّا فَرَغَ قُلْتُ : هَذَا الْمَاءُ يَا رَسُولَ اللهِ ، فَاسْتَأْخَرَ عَنِّي ، فَاسْتَأْخَرْتُ عَنْهُ ،  فَاسْتَنْجَى بِالْمَاءِ ، ثُمَّ قَالَ : "" صُبَّ عَلَيَّ "" ، فَصَبَبْتُ عَلَيْهِ  ، فَغَسَلَ وَجْهَهُ ثَلَاثًا ، وَيَدَيْهِ ثَلَاثًا ، وَمَسَحَ بِرَأْسِهِ ، وَمَسَحَ عَلَى الْخُفَّيْنِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ  إِلَّا  أَبُو مَعْشَرٍ  ، وَلَا عَنْ  أَبِي مَعْشَرٍ  إِلَّا  عَبْدُ اللهِ بْنُ نَافِعٍ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9110","","المغيرة بن شعبة عن حمزة بن المغيرة بن شعبة عن عبيد الله بن عمر العمري عن نجيح بن عبد الرحمن السندي عن عبد الله بن نافع الصائغ عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9119","9111  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عَلِيِّ بْنِ حَسَنِ بْنِ أَبِي رَافِعٍ ،  ثَنَا  كَثِيرُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ .  عَنْ  جَدِّهِ  ،  عَنْ  عَبْدِ اللهِ ذِي الْبِجَادَيْنِ  ، الَّذِي هَلَكَ فِي  غَزْوَةِ تَبُوكَ  ، أَنَّهُ هَلَكَ فِي  جَوْفِ  اللَّيْلِ ، فَنَزَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حُفْرَتِهِ ، وَقَالَ  لِأَبِي بَكْرٍ  وَعُمَرَ  : "" أَدْلِيَا إِلَيَّ أَخَاكُمَا "" ، فَلَمَّا وَضَعَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي لَحْدِهِ قَالَ :  اللَّهُمَّ إِنِّي رَاضٍ عَنْهُ ، فَارْضَ عَنْهُ  . فَقَالَ أَبُو بَكْرٍ :  وَاللهِ لَوَدِدْتُ أَنِّي صَاحِبُ الْحُفْرَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  كَثِيرِ بْنِ عَبْدِ اللهِ  إِلَّا  إِبْرَاهِيمُ بْنُ عَلِيٍّ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9111","","عمرو بن عوف بن زيد المزني عن عبد الله بن عمرو بن عوف المزني عن كثير بن عبد الله بن عمرو بن عوف اليشكري عن إبراهيم بن علي بن حسن الرافعي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9120","9112  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مُحَمَّدُ بْنُ طَلْحَةَ التَّيْمِيُّ ،  ثَنَا  عَبْدُ الْحَكِيمِ بْنُ سُفْيَانَ بْنِ أَبِي نَمِرٍ ،  عَنْ  شَرِيكِ بْنِ عَبْدِ اللهِ بْنِ أَبِي نَمِرٍ .  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  خَرَجْنَا فِي  غَزْوَةِ ذَاتِ الرِّقَاعِ  ، حَتَّى إِذَا كُنَّا  بِحَرَّةِ  وَاقِمٍ  عَرَضَتِ امْرَأَةٌ بَدَوِيَّةٌ بِابْنٍ لَهَا ، فَجَاءَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَتْ :  يَا رَسُولَ اللهِ ، هَذَا ابْنِي قَدْ غَلَبَنِي عَلَيْهِ الشَّيْطَانُ ، فَقَالَ : "" أَدْنِيهِ مِنِّي  ، فَأَدْنَتْهُ مِنْهُ ، فَقَالَ : "" افْتَحِي فَمَهُ "" ، فَفَتَحَتْهُ ، فَبَصَقَ فِيهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ : "" اخْسَأْ عَدُوَّ اللهِ ، وَأَنَا رَسُولُ اللهِ "" - قَالَهَا ثَلَاثَ مَرَّاتٍ - ثُمَّ قَالَ : "" شَأْنُكِ         [9/53]      بِابْنِكِ ، لَيْسَ عَلَيْهِ بَأْسٌ ، فَلَنْ يَعُودَ إِلَيْهِ شَيْءٌ مِمَّا كَانَ يُصِيبُهُ "" .  ثُمَّ خَرَجْنَا فَنَزَلْنَا مَنْزِلًا ضَحْوًا ، دَيْمُومَةً لَيْسَ فِيهَا شَجَرَةٌ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِجَابِرٍ  : "" يَا  جَابِرُ  ، انْطَلِقْ فَانْظُرْ لِي مَكَانًا "" - يَعْنِي لِلْوُضُوءِ - فَخَرَجْتُ أَنْطَلِقُ ، فَلَمْ أَجِدْ إِلَّا شَجَرَتَيْنِ مُفْتَرِقَتَيْنِ ، لَوْ أَنَّهُمَا اجْتَمَعَتَا سَتَرَتَاهُ ، فَرَجَعْتُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا رَأَيْتُ شَيْئًا يَسْتُرُكَ إِلَّا شَجَرَتَيْنِ مُتَفَرِّقَتَيْنِ لَوْ أَنَّهُمَا اجْتَمَعَتَا سَتَرَتَاكَ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" انْطَلِقْ إِلَيْهِمَا ، فَقُلْ لَهُمَا : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ لَكُمَا : اجْتَمِعَا "" قَالَ : فَخَرَجْتُ ، فَقُلْتُ لَهُمَا ، فَاجْتَمَعَا حَتَّى كَأَنَّهُمَا فِي أَصْلٍ وَاحِدٍ ، ثُمَّ رَجَعْتُ فَأَخْبَرْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَخَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى قَضَى حَاجَتَهُ ، ثُمَّ رَجَعَ ، فَقَالَ : "" ائْتِهِمَا ، فَقُلْ لَهُمَا : إِنَّ رَسُولَ اللهِ يَقُولُ : ارْجِعَا كَمَا كُنْتُمَا ، كُلُّ وَاحِدَةٍ إِلَى مَكَانِهَا "" ، فَرَجَعْتُ ، فَقُلْتُ لَهُمَا : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ لَكُمَا : "" ارْجِعَا كَمَا كُنْتُمَا "" ، فَرَجَعَتَا .  ثُمَّ خَرَجْنَا فَنَزَلْنَا فِي وَادٍ مِنْ أَوْدِيَةِ  بَنِي مُحَارِبٍ  ، فَعَرَضَ لَهُ رَجُلٌ مِنْ  بَنِي مُحَارِبٍ  يُقَالُ لَهُ :  غَوْرَثُ بْنُ الْحَارِثِ  ، وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُتَقَلِّدٌ سَيْفَهُ ، فَقَالَ : يَا  مُحَمَّدُ  ، أَعْطِنِي سَيْفَكَ هَذَا ، فَسَلَّهُ ، وَنَاوَلَهُ إِيَّاهُ ، فَهَزَّهُ وَنَظَرَ إِلَيْهِ سَاعَةً ، ثُمَّ أَقْبَلَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا  مُحَمَّدُ  ، مَا يَمْنَعُكَ مِنِّي ؟ قَالَ : "" اللهُ يَمْنَعُنِي مِنْكَ "" ، فَارْتَعَدَتْ يَدُهُ حَتَّى سَقَطَ السَّيْفُ مِنْ يَدِهِ ، فَتَنَاوَلَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَالَ : "" يَا  غَوْرَثُ  ، مَنْ يَمْنَعُكَ مِنِّي ؟ "" قَالَ : لَا أَحَدَ ، بِأَبِي أَنْتَ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" اللَّهُمَّ اكْفِنَا  غَوْرَثًا  وَقَوْمَهُ "" ثُمَّ أَقْبَلْنَا رَاجِعِينَ ، فَجَاءَ  رَجُلٌ مِنْ أَصْحَابِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِعُشِّ طَيْرٍ يَحْمِلُهُ         [9/54]      فِيهِ فِرَاخٌ ، وَأَبَوَاهُ يَتْبَعَانِهِ ، وَيَقَعَانِ عَلَى يَدِ الرَّجُلِ ، فَأَقْبَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى مَنْ كَانَ مَعَهُ ، فَقَالَ : "" أَتَعْجَبُونَ بِفِعْلِ هَذَيْنِ الطَّيْرَيْنِ بِفِرَاخِهِمَا ؟ وَالَّذِي بَعَثَنِي بِالْحَقِّ ، لَلَّهُ أَرْحَمُ بِعِبَادِهِ مِنْ هَذَيْنِ الطَّيْرَيْنِ بِفِرَاخِهِمَا "" .  ثُمَّ أَقْبَلْنَا رَاجِعِينَ حَتَّى إِذَا كُنَّا  بِحَرَّةِ  وَاقِمٍ  عَرَضَتْ لَنَا الْأَعْرَابِيَّةُ الَّتِي جَاءَتْ بِابْنِهَا  بِوَطْبٍ  مِنْ لَبَنٍ وَشَاةٍ ،  وَأَهْدَتْهُ  لَهُ ، فَقَالَ : "" مَا فَعَلَ ابْنُكِ ؟ هَلْ أَصَابَهُ شَيْءٌ مِمَّا كَانَ يُصِيبُهُ ؟ "" قَالَتْ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا أَصَابَهُ شَيْءٌ مِمَّا كَانَ يُصِيبُهُ ، وَقَبِلَ هَدِيَّتَهَا ، ثُمَّ أَقْبَلْنَا حَتَّى إِذَا كُنَّا بِمَهْبِطٍ مِنَ  الْحَرَّةِ  أَقْبَلَ جَمَلٌ يُرْقِلُ ، فَقَالَ : "" أَتَدْرُونَ مَا قَالَ هَذَا الْجَمَلُ ؟ "" قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ ، قَالَ : "" هَذَا جَمَلٌ جَاءَنِي يَسْتَعِيذُنِي عَلَى سَيِّدِهِ ، يَزْعُمُ أَنَّهُ كَانَ يَحْرُثُ عَلَيْهِ مُنْذُ سِنِينَ حَتَّى إِذَا أَجْرَبَهُ  وَأَعْجَفَهُ  وَكَبُرَ سِنُّهُ أَرَادَ أَنْ يَنْحَرَهُ ، اذْهَبْ مَعَهُ يَا  جَابِرُ  إِلَى صَاحِبِهِ فَائْتِ بِهِ "" ، فَقُلْتُ : يَا رَسُولَ اللهِ مَا أَعْرِفُ صَاحِبَهُ ، قَالَ : "" إِنَّهُ سَيَدُلُّكَ عَلَيْهِ "" ، قَالَ : فَخَرَجَ بَيْنَ يَدَيَّ مُعْتَقًا حَتَّى وَقَفَ بِي فِي مَجْلِسِ  بَنِي خَطْمَةَ  ، فَقُلْتُ : أَيْنَ رَبُّ هَذَا الْجَمَلِ ؟ قَالُوا : فُلَانُ ابْنُ فُلَانٍ ، فَجِئْتُهُ ، فَقُلْتُ : أَجِبْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَخَرَجَ مَعِي حَتَّى جَاءَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" إِنَّ جَمَلَكَ هَذَا يَسْتَعِيذُنِي عَلَيْكَ ، يَزْعُمُ أَنَّكَ  حَرَثْتَ  عَلَيْهِ زَمَانًا حَتَّى أَجْرَبْتَهُ  وَأَعْجَفْتَهُ  وَكَبُرَ سِنُّهُ ثُمَّ أَرَدْتَ أَنْ تَنْحَرَهُ ؟ "" قَالَ : وَالَّذِي بَعَثَكَ بِالْحَقِّ إِنَّ ذَلِكَ كَذَلِكَ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" بِعْنِيهِ "" ، قَالَ : نَعَمْ يَا رَسُولَ اللهِ ، فَابْتَاعَهُ مِنْهُ ، ثُمَّ سَيَّبَهُ فِي الشَّجَرَةِ حَتَّى نَصَبَ سَنَامًا ، وَكَانَ إِذَا اعْتَلَّ عَلَى بَعْضِ  الْمُهَاجِرِينَ  أَوِ  الْأَنْصَارِ  مِنْ  نَوَاضِحِهِمْ  شَيْءٌ أَعْطَاهُ إِيَّاهُ ، فَمَكَثَ بِذَلِكَ زَمَانًا  .  قَالَ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  : قَالَ لِي  مُحَمَّدُ بْنُ طَلْحَةَ  :  كَانَتْ  غَزْوَةُ ذَاتِ الرِّقَاعِ         [9/55]      تُسَمَّى غَزْوَةَ الْأَعَاجِيبِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شَرِيكِ بْنِ عَبْدِ اللهِ  إِلَّا  عَبْدُ الْحَكِيمِ بْنُ سُفْيَانَ  ، وَلَا عَنْ  عَبْدِ الْحَكِيمِ  إِلَّا  مُحَمَّدُ بْنُ طَلْحَةَ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9112","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن شريك بن عبد الله بن أبي نمر الكناني عن عبد الحكيم بن سفيان بن أبي نمر عن محمد بن طلحة بن عبد الرحمن عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9121","9113  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  عَنْ  خَالِدِ بْنِ إِلْيَاسَ ،  عَنْ  أَبِي بَكْرِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ ،  عَنِ  الشِّفَاءِ أُمِّ سُلَيْمَانَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَعْمَلَ  أَبَا جَهْمِ بْنَ حُذَيْفَةَ  عَلَى الْمَغَانِمِ  ، فَأَصَابَ رَجُلًا بِقَوْسِهِ ،  فَشَجَّهُ  مُنَقِّلَةً ، فَقَضَى فِيهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِخَمْسَ عَشْرَةَ فَرِيضَةً  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنِ  الشِّفَاءِ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  خَالِدُ بْنُ إِلْيَاسَ  .","","Al-Mu'jam al-Awsat 9113","","الشفاء بنت عبد الله القرشية عن أبو بكر بن سليمان بن أبي حثمة العدوي عن خالد بن الياس العدوي عن عبد الله بن نافع الصائغ عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9122","9114  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ الصَّائِغُ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ بْنِ حَفْصٍ ،  عَنْ  يَزِيدَ بْنِ رُومَانَ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِي حُمَيْدٍ السَّاعِدِيِّ ، قَالَ :  اسْتَعْمَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  رَجُلًا مِنْ أَصْحَابِهِ  عَلَى الصَّدَقَاتِ ، فَقَدِمَ فَقَالَ لَمَّا جَاءَ بِهِ : هَذَا لَكُمْ وَهَذَا لِي ، فَبَلَغَ ذَلِكَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَخَطَبَ النَّاسَ ، فَقَالَ :  مَا بَالِي أَسْتَعْمِلُ أَحَدَكُمْ عَلَى أَشْيَاءَ مِمَّا وَلَّانِي اللهُ ، فَيَقْدَمُ ، فَيَقُولُ : هَذَا لَكُمْ وَهَذَا أُهْدِيَ لِي  ، أَلَا يَجْلِسُ أَحَدُكُمْ فِي بَيْتِ أَبِيهِ وَبَيْتِ أُمِّهِ حَتَّى يُهْدَى لَهُ ؟ "" ثُمَّ قَالَ : "" أَلَا يَقْعُدُ أَحَدُكُمْ فِي بَيْتِ أَبِيهِ وَبَيْتِ أُمِّهِ حَتَّى يُهْدَى لَهُ ؟ "" ثُمَّ قَالَ : "" لَا يَأْتِي أَحَدُكُمْ يَوْمَ الْقِيَامَةِ بِبَعِيرٍ يَحْمِلُهُ عَلَى ظَهْرِهِ لَهُ  رُغَاءٌ ،  أَوْ بَقَرَةٍ لَهَا  خُوَارٌ  أَوْ شَاةٍ لَهَا  يُعَارٌ  "" ثُمَّ رَفَعَ يَدَيْهِ إِلَى السَّمَاءِ ، فَقَالَ : "" أَلَا هَلْ بَلَّغْتُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ بْنِ رُومَانَ  إِلَّا  عَبْدُ اللهِ بْنُ عُمَرَ  ، وَلَا رَوَاهُ عَنْ         [9/56]      عَبْدِ اللهِ  إِلَّا  عَبْدُ اللهِ بْنُ نَافِعٍ  وَدَاوُدُ بْنُ خَالِدٍ الْخَيَّاطُ  .","","Al-Mu'jam al-Awsat 9114","","أبو حميد الساعدي عن عروة بن الزبير عن يزيد بن رومان الأسدي عن عبد الله بن عمر العمري عن عبد الله بن نافع الصائغ عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9123","9115  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  إِسْحَاقُ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْمُخَرِّمِيُّ ،  عَنْ  أُمِّ بَكْرٍ .  عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ ،  أَنَّ  عَبْدَ الرَّحْمَنِ بْنَ عَوْفٍ  بَاعَ كَرْمَةً مِنْ  عُثْمَانَ  بِأَرْبَعِينَ أَلْفَ دِينَارٍ ، فَأَمَرَ  عُثْمَانُ  عَبْدَ اللهِ بْنَ سَعْدِ بْنِ أَبِي سَرْحٍ  ، فَأَعْطَاهُ الثَّمَنَ ، فَقَسَمَهُ  عَبْدُ الرَّحْمَنِ  بَيْنَ  بَنِي زُهْرَةَ  ، وَبَيْنَ فُقَرَاءِ الْمُسْلِمِينَ ، وَأَزْوَاجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ  الْمِسْوَرُ  :  فَأَتَيْتُ  عَائِشَةَ ، فَقَالَتْ : مَا هَذَا ؟ قُلْتُ : بَعَثَ بِهِ  عَبْدُ الرَّحْمَنِ  ، فَقَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَحْنُو عَلَيْكُنَّ بَعْدِي إِلَّا الصَّابِرُونَ  ، سَقَى اللهُ  ابْنَ عَوْفٍ  مِنْ سَلْسَبِيلِ الْجَنَّةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْحَاقَ بْنِ جَعْفَرِ بْنِ مُحَمَّدٍ  إِلَّا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9115","","عائشة بنت أبي بكر الصديق عن المسور بن مخرمة عن أم بكر بنت المسور بن مخرمة عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن إسحاق بن جعفر بن محمد الجعفري الحزين عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9124","9116  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مَعْنُ بْنُ عِيسَى ،  ثَنَا  فَائِدٌ - مَوْلَى عَبَادِلَ -  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ .  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَدَا إِلَى  بَنِي قُرَيْظَةَ  عَلَى حِمَارٍ عُرْيٍ يُقَالُ لَهُ :  يَعْفُورُ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي رَافِعٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9116","","أبو رافع القبطي عن عبيد الله بن علي بن أبي رافع المدني عن فائد المدني مولى عبادل عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9125","9117  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  أَبُو ضَمْرَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَعِيدِ بْنِ أَبِي هِنْدٍ ،  عَنْ  عَبْدِ الْمَجِيدِ بْنِ سُهَيْلِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  أَبِي سَلَمَةَ .  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مِنْبَرِي هَذَا عَلَى  تُرْعَةٍ  مِنْ تُرَعِ الْجَنَّةِ  .","","Al-Mu'jam al-Awsat 9117","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عبد المجيد بن سهيل بن عبد الرحمن بن عوف عن عبد الله بن سعيد بن أبي هند الفزاري عن أنس بن عياض الليثي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9126","[9/57]      9118  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ،  عَنْ  عَمْرِو بْنِ يَحْيَى الْمَازِنِيِّ ،  عَنْ  يُوسُفَ بْنِ مُحَمَّدِ بْنِ ثَابِتِ بْنِ قَيْسِ بْنِ شَمَّاسٍ ،  عَنْ  أَبِيهِ .  عَنْ  جَدِّهِ  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ دَخَلَ عَلَيْهِ ، فَقَالَ :  اكْشِفِ الْبَاسَ رَبَّ النَّاسِ عَنْ  ثَابِتِ بْنِ قَيْسِ بْنِ شَمَّاسٍ  ، ثُمَّ أَخَذَ تُرَابًا مِنْ  بُطْحَانَ  ، فَجَعَلَهُ فِي قَدَحٍ فِيهِ مَاءٌ ، فَصَبَّهُ عَلَيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يُوسُفَ بْنِ مُحَمَّدِ بْنِ ثَابِتٍ  إِلَّا  عَمْرُو بْنُ يَحْيَى  ، وَلَا رَوَى عَنْ  عَمْرِو بْنِ يَحْيَى  إِلَّا  دَاوُدُ الْعَطَّارُ  ،  تَفَرَّدَ بِهِ  ابْنُ وَهْبٍ  .","","Al-Mu'jam al-Awsat 9118","","ثابت بن قيس الخزرجي خطيب رسول الله عن محمد بن ثابت بن قيس الخزرجي عن يوسف بن محمد بن ثابت الأنصاري عن عمرو بن يحيى بن عمارة المازني عن داود ابن النصراني عن عبد الله بن وهب المصري عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9127","9119  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عَلِيِّ بْنِ حَسَنِ بْنِ عَلِيِّ بْنِ أَبِي رَافِعٍ ،  حَدَّثَنِي  فَائِدٌ - مَوْلَى عَبَادِلَ - ،  عَنْ  مَوْلَاهُ عَبَادِلَ  عَنْ  أَبِي رَافِعٍ  ،  أَنَّهُ بَاعَ قِطْعَةً أَقْطَعَهُ إِيَّاهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ دَارِ  سَعْدِ بْنِ أَبِي وَقَّاصٍ ،  مِنْ  سَعْدٍ  بِثَمَانِيَةِ أَلْفِ دِرْهَمٍ . قَالَ : وَكَانَ رَجُلٌ قَدْ سَبَقَهُ بِهَا قَبْلُ ، فَأَعْطَاهُ بِهَا عَشَرَةَ آلَافِ دِرْهَمٍ ، فَأَبَى مِنْهُ أَنْ يَبِيعَ مِنْهُ ، فَقَالَ أَبُو رَافِعٍ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَهْلُ  الرُّكْحِ  أَحَقُّ  بِرُكْحِهِمْ  ، وَكَانَ  سَعْدٌ  أَسْقَبَ  .  لَا تُرْوَى هَذِهِ اللَّفْظَةُ : "" أَهْلُ  الرُّكْحِ  "" ، إِلَّا فِي هَذَا الْحَدِيثِ بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9119","","أبو رافع القبطي عن عبيد الله بن علي بن أبي رافع المدني عن فائد المدني مولى عبادل عن إبراهيم بن علي بن حسن الرافعي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9128","9120  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  إِبْرَاهِيمُ بْنُ عَلِيِّ بْنِ الْحَسَنِ بْنِ عَلِيِّ بْنِ أَبِي رَافِعٍ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ أَبِي زِيَادٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَمِعْتُ  رَبِيعَةَ بْنَ عَبَّادٍ الدِّيَلِيَّ ، وَهُوَ يَقُولُ :  أَمَّا مَا أَسْمَعُكُمْ تَقُولُونَ : إِنَّ  قُرَيْشًا  كَانَتْ تَنَالُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَإِنِّي أَكْثَرُ مَا رَأَيْتُ أَنَّ مَنْزِلَهُ كَانَ بَيْنَ مَنْزِلِ  أَبِي لَهَبٍ  وَعُقْبَةَ بْنِ أَبِي مُعَيْطٍ  ، فَكَانَ يَنْقَلِبُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى بَيْتِهِ ، فَيَجِدُ الْأَرْحَامَ         [9/58]      وَالدِّمَاءَ ، وَالْأَنْجَاثَ ، قَدْ تَصَدَّتْ عَلَى بَابِهِ ، فَيُنَحِّي ذَلِكَ  بِسِيَةِ  قَوْسِهِ وَيَقُولُ :  بِئْسَ الْجِوَارُ هَذَا يَا مَعْشَرَ  قُرَيْشٍ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  رَبِيعَةَ بْنِ عَبَّادٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9120","","ربيعة بن عباد الديلي عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن إبراهيم بن علي بن حسن الرافعي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9129","9121  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ هِلَالٍ ،  عَنْ  أَبِيهِ  .  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  أَنْزَلَ اللهُ جَلَّ جَلَالُهُ عَلَى نَبِيِّهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَكَّةَ  :         {      سَيُهْزَمُ الْجَمْعُ وَيُوَلُّونَ الدُّبُرَ         }      ،  فَقَالَ  عُمَرُ بْنُ الْخَطَّابِ  : يَا رَسُولَ اللهِ أَيُّ جَمْعٍ ؟ - وَذَلِكَ قَبْلَ  بَدْرٍ  - قَالَ : فَلَمَّا كَانَ  يَوْمُ بَدْرٍ  وَانْهَزَمَتْ  قُرَيْشٌ  ، "" نَظَرْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي آثَارِهِمْ مُصْلِتًا بِالسَّيْفِ ، يَقُولُ :         {      سَيُهْزَمُ الْجَمْعُ وَيُوَلُّونَ الدُّبُرَ         }      ، وَكَانَتْ  لِيَوْمِ بَدْرٍ  ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ فِيهِمْ :         {      حَتَّى إِذَا أَخَذْنَا مُتْرَفِيهِمْ بِالْعَذَابِ         }      الْآيَةَ ، وَأَنْزَلَ اللهُ :         {      أَلَمْ تَرَ إِلَى الَّذِينَ بَدَّلُوا نِعْمَتَ اللهِ كُفْرًا         }      الْآيَةَ ، "" وَرَمَاهُمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَسِعَتْهُمُ الرَّمْيَةُ وَمَلَأَتْ أَعْيُنَهُمْ وَأَفْوَاهَهُمْ ، حَتَّى إِنَّ الرَّجُلَ لَيُقْتَلُ وَهُوَ يُقْذِي عَيْنَيْهِ رِمَاهُ "" ، فَأَنْزَلَ اللهُ :         {      وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَكِنَّ اللهَ رَمَى         }      وَأَنْزَلَ اللهُ فِي إِبْلِيسَ :         {      فَلَمَّا تَرَاءَتِ الْفِئَتَانِ نَكَصَ عَلَى عَقِبَيْهِ وَقَالَ إِنِّي بَرِيءٌ مِنْكُمْ إِنِّي أَرَى مَا لا تَرَوْنَ إِنِّي أَخَافُ اللهَ وَاللهُ شَدِيدُ الْعِقَابِ         }      وَقَالَ  عُتْبَةُ بْنُ رَبِيعَةَ  ، وَنَاسٌ مَعَهُ مِنَ الْمُشْرِكِينَ  يَوْمَ بَدْرٍ  : غَرَّ هَؤُلَاءِ دِينُهُمْ ، فَأَنْزَلَ اللهُ :         {      إِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ غَرَّ هَؤُلاءِ دِينُهُمْ         }      .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي هُرَيْرَةَ  ، عَنْ  عُمَرَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9121","","أبو هريرة الدوسي عن هلال بن أبي هلال المذحجي عن محمد بن هلال بن أبي هلال المذحجي عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9130","9122  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ يَحْيَى بْنِ سَهْلِ بْنِ أَبِي حَثْمَةَ ،  أَخْبَرَنِي  أَبِي         [9/59]      عَنْ  أَبِيهِ  ،  أَنَّ  أَبَا بَرْزَةَ الْحَارِثِيَّ ، جَاءَ  يَوْمَ بَدْرٍ  بِثَلَاثَةِ رُءُوسٍ يَحْمِلُهَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَلَمَّا رَآهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ظَفِرَتْ يَمِينُكَ  ، قَالَ : يَا رَسُولَ اللهِ ، أَمَّا اثْنَانِ فَأَنَا قَتَلْتُهُمَا ، وَأَمَّا وَاحِدٌ فَرَأَيْتُ رَجُلًا أَبْيَضَ جَمِيلًا حَسَنَ الْوَجْهِ ضَرَبَ رَأْسَهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" ذَاكَ فُلَانٌ ، مَلَكٌ مِنَ الْمَلَائِكَةِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  سَهْلِ بْنِ أَبِي حَثْمَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9122","","عبد الملك بن جوية النصري عن سهل بن أبي حثمة الخزرجي عن يحيى بن سهل الحارثي عن محمد بن يحيى بن سهل الأنصاري عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9131","9123  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  نَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ مُوسَى ،  عَنْ  عُمَارَةَ بْنِ عَمَّارِ بْنِ أَبِي الْيَسَرِ ،  عَنْ  أَبِيهِ .  عَنْ  أَبِي الْيَسَرِ  ، قَالَ :  نَظَرْتُ إِلَى  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ  وَهُوَ كَأَنَّهُ صَنَمٌ ، وَعَيْنَاهُ تَذْرِفَانِ  ، فَلَمَّا نَظَرْتُ إِلَيْهِ قُلْتُ : جَزَاكَ اللهُ مِنْ ذِي رَحِمٍ شَرًّا ، تُقَاتِلُ ابْنَ أَخِيكَ مَعَ عَدُوِّهِ ؟ قَالَ : مَا فَعَلَ ، وَهَلْ أَصَابَهُ الْقَتْلُ ؟ قُلْتُ : اللهُ أَعَزُّ لَهُ ، وَأَنْصَرُ مِنْ ذَلِكَ ، قَالَ : مَا تُرِيدُ إِلَيَّ ؟ قُلْتُ : إِسَارًا ، "" فَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَى عَنْ قَتْلِكَ ، قَالَ : لَيْسَتْ بِأَوَّلِ صِلَتِهِ ، فَأَسَرْتُهُ ، ثُمَّ جِئْتُ بِهِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَمَّارِ بْنِ أَبِي الْيَسَرِ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9123","","كعب بن عمرو بن عباد البدري عن عمار بن أبي اليسر الأنصاري عن عمارة بن عمار بن أبي اليسر عن محمد بن موسى الفطري عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9132","9124  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  حَدَّثَنِي  رِفَاعَةُ بْنُ يَحْيَى ،  عَنْ  مُعَاذِ بْنِ رِفَاعَةَ بْنِ رَافِعٍ .  عَنْ  رِفَاعَةَ بْنِ رَافِعٍ  ، قَالَ :  لَمَّا كَانَ  يَوْمُ بَدْرٍ  تَجَمَّعَ النَّاسُ عَلَى  أُمَيَّةَ بْنِ خَلَفٍ  ، فَأَقْبَلْتُ إِلَيْهِ ، فَنَظَرْتُ إِلَى قِطْعَةٍ مِنْ دِرْعِهِ قَدِ انْقَطَعَتْ مِنْ تَحْتِ إِبْطِهِ ، فَطَعَنْتُهُ بِالسَّيْفِ فِيهَا طَعْنَةً فَقَتَلْتُهُ ،  وَرُمِيتُ بِسَهْمٍ  يَوْمَ بَدْرٍ  فَفُقِئَتْ  عَيْنِي ، "" فَبَصَقَ فِيهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، ثُمَّ دَعَا لِي "" ، فَمَا آذَانِي فِيهَا شَيْءٌ  .         [9/60]      لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  رِفَاعَةَ بْنِ رَافِعٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  ابْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9124","","رفاعة بن رافع الزرقي عن معاذ بن رفاعة بن رافع الزرقي عن رفاعة بن يحيى الزرقي عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9133","9125  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  ثَنَا  أَيُّوبُ بْنُ ثَابِتٍ ،  عَنْ  عَطَاءٍ .  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمْ تُقَاتِلِ الْمَلَائِكَةُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  يَوْمَ بَدْرٍ  ، وَكَانَتْ تَكُونُ فِيمَا سِوَى ذَلِكَ إِمْدَادًا ، وَلَمْ يَكُنْ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الْخَيْلِ إِلَّا فَرَسَانِ : أَحَدُهُمَا  لِلْمِقْدَادِ بْنِ الْأَسْوَدِ  ، وَالْآخَرُ  لِأَبِي مَرْثَدٍ الْغَنَوِيِّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءٍ  إِلَّا  أَيُّوبُ بْنُ ثَابِتٍ  ، وَلَا عَنْ  أَيُّوبَ  إِلَّا  عَبْدُ الْعَزِيزِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9125","","عبد الله بن عباس عن عطاء بن أبي رباح عن أيوب بن ثابت المكي عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9134","9126  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  ثَنَا  سَعِيدُ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  . عَنْ  جَابِرٍ ، قَالَ :  قَالَ  أَبُو جَهْلِ بْنُ هِشَامٍ  : إِنَّ  مُحَمَّدًا  يَزْعُمُ أَنَّكُمْ إِنْ لَمْ تُطِيعُوهُ كَانَ لَهُ فِيكُمْ ذَبْحٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَأَنَا أَقُولُ ذَلِكَ ، وَأَنْتَ مِنْ ذَلِكَ الذَّبْحِ  فَلَمَّا نَظَرَ إِلَيْهِ  يَوْمَ بَدْرٍ  مَقْتُولًا قَالَ : "" اللَّهُمَّ قَدْ أَنْجَزْتَ لِي مَا وَعَدْتَنِي "" فَوَجَّهَ  أَبَا سَلَمَةَ بْنَ عَبْدِ الْأَسَدِ  قِبَلَ  أَبِي جَهْلٍ  ،  فَقِيلَ  لِابْنِ مَسْعُودٍ  : أَنْتَ قَتَلْتَهُ ؟ قَالَ : "" بَلِ اللهُ قَتَلَهُ "" ، قَالَ  أَبُو سَلَمَةَ  : أَنْتَ قَتَلْتَهُ ؟ قَالَ : "" نَعَمْ "" ، فَقَالَ  أَبُو سَلَمَةَ  : لَوْ شَاءَ لَجَعَلَكَ فِي كَفِّهِ ، قَالَ  ابْنُ مَسْعُودٍ  : "" فَوَاللهِ لَقَدْ قَتَلْتُهُ وَجَرَّدْتُهُ "" ، قَالَ : فَمَا عَلَامَتُهُ ؟ قَالَ : "" شَامَةٌ سَوْدَاءُ بِبَطْنِ فَخِذِهِ الْيُمْنَى "" ، فَعَرَفَ  أَبُو سَلَمَةَ  النَّعْتَ ، فَقَالَ : "" جَرَّدْتُهُ ، وَلَمْ نُجَرِّدْ قُرَشِيًّا غَيْرَهُ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ  إِلَّا  سَعِيدُ بْنُ مُحَمَّدٍ  ، وَلَا عَنْ  سَعِيدٍ  إِلَّا  عَبْدُ الْعَزِيزِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9126","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن سعيد بن محمد عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9135","9127  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ         [9/61]      عِمْرَانَ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ وَعَبْدُ اللهِ ابْنَا زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِمَا  ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ .  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ  أَرْبَدَ بْنَ قَيْسِ بْنِ جُزَيِّ بْنِ خَالِدِ بْنِ جَعْفَرِ بْنِ كِلَابٍ  ،  وَعَامِرَ بْنَ الطُّفَيْلِ بْنِ مَالِكِ بْنِ جَعْفَرٍ  ، قَدِمَا  الْمَدِينَةَ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَانْتَهَيَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ جَالِسٌ ، فَجَلَسَا بَيْنَ يَدَيْهِ ، فَقَالَ  عَامِرُ بْنُ الطُّفَيْلِ  : يَا  مُحَمَّدُ  ، مَا تَجْعَلُ لِي إِنْ أَسْلَمْتُ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَكَ مَا لِلْمُسْلِمِينَ ، وَعَلَيْكَ مَا عَلَيْهِمْ  قَالَ  عَامِرٌ  : أَتَجْعَلُ لِيَ الْأَمْرَ إِنْ أَسْلَمْتُ مِنْ بَعْدِكَ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" لَكَ مَا لِلْمُسْلِمِينَ ، وَعَلَيْكَ مَا عَلَيْهِمْ "" قَالَ  عَامِرٌ  : أَتَجْعَلُ لِيَ الْأَمْرَ إِنْ أَسْلَمْتُ مِنْ بَعْدِكَ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" لَيْسَ ذَلِكَ لَكَ وَلَا لِقَوْمِكَ ، وَلَكِنْ لَكَ أَعِنَّةُ الْخَيْلِ "" قَالَ : أَنَا الْآنَ لِي أَعِنَّةُ الْخَيْلِ تُجَرُّ ، اجْعَلْ لِيَ  الْوَبَرَ  وَلَكَ الْمَدَرُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" لَا "" .  فَلَمَّا خَرَجَ  أَرْبَدُ  وَعَامِرٌ  ، قَالَ  عَامِرٌ  : يَا  أَرْبَدُ  ، إِنِّي أَشْغَلُ عَنْكَ  مُحَمَّدًا  بِالْحَدِيثِ فَاضْرِبْهُ بِالسَّيْفِ ، فَإِنَّ النَّاسَ إِذَا قَتَلْتَ  مُحَمَّدًا  لَمْ يَزِيدُوا عَلَى أَنْ يَرْضَوْا بِالدِّيَةِ ، وَيَكْرَهُوا الْحَرْبَ ، فَسَنُعْطِيهِمُ الدِّيَةَ ، قَالَ  أَرْبَدُ  : أَفْعَلُ ، قَالَ : فَأَقْبَلَا رَاجِعَيْنِ إِلَيْهِ ، فَقَالَ  عَامِرٌ  : يَا  مُحَمَّدُ  قُمْ مَعِي أُكَلِّمْكَ ، فَقَامَ مَعَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُخَلَّقًا إِلَى الْجِدَارِ ، وَوَقَفَ مَعَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُكَلِّمُهُ ، وَسَلَّ  أَرْبَدُ  السَّيْفَ ، فَلَمَّا وَضَعَ يَدَهُ عَلَى السَّيْفِ يَبِسَتْ عَلَى قَائِمَةِ السَّيْفِ ، فَلَمْ يَسْتَطِعْ سَلَّ السَّيْفِ ، وَأَبْطَأَ  أَرْبَدُ  عَلَى  عَامِرٍ  بِالضَّرْبِ ، فَالْتَفَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَى  عَامِرًا  وَمَا يَصْنَعُ ، فَانْصَرَفَ عَنْهُمَا .  فَلَمَّا خَرَجَ  عَامِرٌ  وَأَرْبَدُ  مِنْ عِنْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَضَيَا حَتَّى إِذَا كَانَا  بِالْحَرَّةِ - حَرَّةِ بَنِي  وَاقِمٍ  - نَزَلَا ، فَخَرَجَ إِلَيْهِمَا  سَعْدُ بْنُ مُعَاذٍ  وَأُسَيْدُ بْنُ حُضَيْرٍ  ، فَقَالَ : اشْخَصَا يَا عَدُوَّيِ اللهِ ، فَقَالَ  عَامِرٌ  : مَنْ هَذَا يَا  سَعْدُ  ؟ قَالَ :  أُسَيْدُ بْنُ حُضَيْرٍ  الْكَتَائِبُ ، فَخَرَجَا حَتَّى إِذَا كَانَا  بِالرَّقْمِ  أَرْسَلَ اللهُ عَلَى  أَرْبَدَ  صَاعِقَةً فَقَتَلَتْهُ         [9/62]      وَخَرَجَ  عَامِرٌ  حَتَّى إِذَا كَانَ  بِالْخُرَيْمِ  أَرْسَلَ اللهُ قُرْحَةً فَأَخَذَتْهُ ، فَأَدْرَكَهُ اللَّيْلُ فِي بَيْتِ  امْرَأَةٍ مِنْ بَنِي سَلُولٍ  ، فَجَعَلَ يَمَسُّ الْقُرْحَةَ فِي حَلْقِهِ ، وَيَقُولُ :  غُدَّةٌ  كَغُدَّةِ  الْجَمَلِ فِي بَيْتِ سَلُولِيَّةٍ ، يَرْغَبُ أَنْ يَمُوتَ فِي بَيْتِهَا ، ثُمَّ رَكِبَ فَرَسَهُ ، فَأَحْضَرَهُ حَتَّى مَاتَ عَلَيْهِ رَاجِعًا ، فَأُنْزِلَ فِيهِمَا :         {      اللهُ يَعْلَمُ مَا تَحْمِلُ كُلُّ أُنْثَى وَمَا تَغِيضُ الأَرْحَامُ وَمَا تَزْدَادُ         }      إِلَى قَوْلِهِ :         {      وَمَا لَهُمْ مِنْ دُونِهِ مِنْ وَالٍ         }      قَالَ : الْمُعَقِّبَاتُ مِنْ أَمْرِ اللهِ يَحْفَظُونَ  مُحَمَّدًا  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، ثُمَّ ذَكَرَ  أَرْبَدَ  وَمَا قَتَلَهُ ، فَقَالَ :         {      هُوَ الَّذِي يُرِيكُمُ الْبَرْقَ خَوْفًا وَطَمَعًا         }      إِلَى قَوْلِهِ :         {      وَهُوَ شَدِيدُ الْمِحَالِ         }      .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا ابْنَاهُ ، وَلَا رَوَاهُ عَنْهُمَا إِلَّا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9127","","عبد الله بن عباس عن عطاء بن يسار الهلالي عن زيد بن أسلم عن عبد الله بن زيد بن أسلم مولى عمر بن الخطاب عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9136","9128  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  فَضَالَةُ بْنُ يَعْقُوبَ ،  عَنْ  إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ، أَنَّ عُرْوَةَ  ،  حَدَّثَهُ  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَلَسَ عَلَى الْمِنْبَرِ يَوْمَ الْجُمُعَةِ ، فَلَمَّا جَلَسَ قَالَ : "" اجْلِسُوا  ، فَسَمِعَ  عَبْدُ اللهِ بْنُ رَوَاحَةَ  قَوْلَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" اجْلِسُوا "" ، فَجَلَسَ فِي  بَنِي غَنْمٍ  ، فَقِيلَ : يَا رَسُولَ اللهِ ذَاكَ  ابْنُ رَوَاحَةَ  جَالِسٌ فِي  بَنِي غَنْمٍ  ، سَمِعَكَ وَأَنْتَ تَقُولُ لِلنَّاسِ : "" اجْلِسُوا "" ، فَجَلَسَ فِي مَكَانِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ  ، وَلَا عَنْ  إِبْرَاهِيمَ  إِلَّا  فَضَالَةُ بْنُ يَعْقُوبَ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9128","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن إبراهيم بن إسماعيل بن مجمع عن فضالة بن يعقوب عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9137","9129  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  فَضَالَةُ بْنُ يَعْقُوبَ ،  عَنْ  إِبْرَاهِيمَ بْنِ إِسْمَاعِيلَ ،  عَنِ  ابْنِ عَجْلَانَ ، عَنْ نَافِعٍ ،  حَدَّثَهُ  .  أَنَّ  عَبْدَ اللهِ بْنَ عُمَرَ مَرَّ  بِرَجُلٍ  جَالِسٍ فِي صَلَاتِهِ ، قَدْ وَضَعَ يَدَهُ الْيُسْرَى فِي الصَّلَاةِ عَلَى عَيْنِهِ ، فَقَالَ لَهُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَجْلِسْ جِلْسَةَ         [9/63]      قَوْمٍ قَدْ عُذِّبُوا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ عَجْلَانَ  إِلَّا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ  ،  تَفَرَّدَ بِهِ  فَضَالَةُ بْنُ يَعْقُوبَ  .","","Al-Mu'jam al-Awsat 9129","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن عجلان عن إبراهيم بن إسماعيل بن مجمع عن فضالة بن يعقوب عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9138","9130  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  نَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ عُرْوَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا اسْتَيْقَظَ أَحَدُكُمْ مِنْ مَنَامِهِ فَلَا يُدْخِلْ يَدَهُ فِي الْإِنَاءِ حَتَّى يَغْسِلَهَا  ؛ فَإِنَّهُ لَا يَدْرِي أَيْنَ بَاتَتْ ، وَيُسَمِّي قَبْلَ أَنْ يُدْخِلَهَا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ عُرْوَةَ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  . وَلَا قَالَ أَحَدٌ مِمَّنْ رَوَى هَذَا الْحَدِيثَ عَنْ  أَبِي الزِّنَادِ  : "" وَيُسَمِّي قَبْلَ أَنْ يُدْخِلَهَا "" ، إِلَّا  هِشَامُ بْنُ عُرْوَةَ  .","","Al-Mu'jam al-Awsat 9130","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن أبو الزناد عن هشام بن عروة بن الزبير عن عبد الله بن محمد بن يحيى المدني عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9139","9131  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  أَبُو ضَمْرَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ الْأَسْلَمِيِّ ،  عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ ،  عَنْ  أَبِيهِ .  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  سَبْعَةٌ  يُظِلُّهُمُ  اللهُ فِي ظِلِّ عَرْشِهِ يَوْمَ الْقِيَامَةِ : إِمَامٌ يُقْسِطَ  ، وَرَجُلٌ يَتَصَدَّقُ بِيَمِينِهِ يُخْفِيهَا مِنْ شِمَالِهِ ، وَرَجُلٌ بَذَلَتْ لَهُ امْرَأَةٌ ذَاتُ  حَسَبٍ  وَمِيسَمٍ نَفْسَهَا ، فَقَالَ : إِنِّي أَخَافُ اللهَ رَبَّ الْعَالَمِينَ ، وَرَجُلٌ ذُكِرَ اللهُ عِنْدَهُ فَفَاضَتْ عَيْنَاهُ مِنْ خَشْيَةِ اللهِ ، وَرَجُلٌ لَقِيَ رَجُلًا ، فَقَالَ : وَاللهِ إِنِّي لَأُحِبُّكَ لِلهِ ، فَقَالَ : وَأَنَا أُحِبُّكَ لِلهِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُهَيْلِ بْنِ أَبِي صَالِحٍ  إِلَّا  عَبْدُ اللهِ بْنُ عَامِرٍ الْأَسْلَمِيُّ  ،  تَفَرَّدَ بِهِ  أَبُو ضَمْرَةَ         [9/64]      وَالْمَشْهُورُ : مِنْ حَدِيثِ  حَبِيبِ بْنِ عَبْدِ الرَّحْمَنِ  ، عَنْ  حَفْصِ بْنِ عَاصِمٍ  ، عَنْ  أَبِي هُرَيْرَةَ  .","","Al-Mu'jam al-Awsat 9131","","أبو هريرة الدوسي عن ذكوان السمان عن سهيل بن أبي صالح السمان عن عبد الله بن عامر الأسلمي عن أنس بن عياض الليثي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9140","9132  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي فُدَيْكٍ ،  عَنْ  كَثِيرِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ .  عَنْ  جَدِّهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمِعَ  رَجُلًا  يَقُولُ : هَاكَهَا خَضِرَةٌ ، فَقَالَ :  يَا لَبَّيْكَ ، أَخَذْنَا فَأْلَكَ مِنْ فِيكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  كَثِيرٍ  إِلَّا  ابْنُ أَبِي فُدَيْكٍ  .","","Al-Mu'jam al-Awsat 9132","","عمرو بن عوف بن زيد المزني عن عبد الله بن عمرو بن عوف المزني عن كثير بن عبد الله بن عمرو بن عوف اليشكري عن محمد بن إسماعيل بن مسلم الديلي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9141","9133  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  إِبْرَاهِيمُ بْنُ عَلِيٍّ الرَّافِعِيُّ ،  نَا  كَثِيرُ بْنُ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ .  عَنْ  جَدِّهِ  ، قَالَ :  صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  النَّجَاشِيِّ  فَكَبَّرَ عَلَيْهِ خَمْسًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  كَثِيرٍ  إِلَّا  إِبْرَاهِيمُ بْنُ عَلِيٍّ الرَّافِعِيُّ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9133","","عمرو بن عوف بن زيد المزني عن عبد الله بن عمرو بن عوف المزني عن كثير بن عبد الله بن عمرو بن عوف اليشكري عن إبراهيم بن علي بن حسن الرافعي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9142","9134  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  مَخْرَمَةُ بْنُ بُكَيْرٍ ،  عَنْ  أَبِيهِ ،  قَالَ :  سَمِعْتُ  يُونُسَ بْنَ يُوسُفَ ،  يُحَدِّثُ ، عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ، قَالَ :  قَالَتْ  عَائِشَةُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ يَوْمٍ أَكْثَرُ أَنْ  يُعْتِقَ  اللهُ فِيهِ عَبْدًا مِنَ النَّارِ مِنْ يَوْمِ عَرَفَةَ  ، وَإِنَّهُ لَيَدْنُو  فَيُبَاهِي  بِهِمُ الْمَلَائِكَةَ ، فَيَقُولُ : مَا أَرَادَ هَؤُلَاءِ ؟  .  "" لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَائِشَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  مَخْرَمَةُ بْنُ بُكَيْرٍ  .","","Al-Mu'jam al-Awsat 9134","","عائشة بنت أبي بكر الصديق عن سعيد بن المسيب عن يونس بن يوسف بن حماس الليثي عن بكير بن عبد الله بن الأشج القرشي عن مخرمة بن بكير المخزومي عن عبد الله بن وهب المصري عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9143","9135  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  ابْنُ وَهْبٍ ،  عَنْ  يَحْيَى بْنِ أَيُّوبَ ،  عَنِ  ابْنِ حَرْمَلَةَ ،  عَنْ  يَحْيَى بْنِ هِنْدٍ . أَنَّ حَمْزَةَ بْنَ عَمْرٍو الْأَسْلَمِيَّ ،  حَدَّثَهُ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِعَرَفَةَ  ، وَعَمِّي مُرْدِفِي ، وَهُوَ وَاضِعٌ إِصْبَعَيْهِ إِحْدَيْهِمَا عَلَى الْأُخْرَى ، فَقُلْتُ : مَا يَقُولُ رَسُولُ اللهِ -         [9/65]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : يَقُولُ :  ارْمُوا الْجِمَارَ بِمِثْلِ حَصَى  الْخَذْفِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ حَرْمَلَةَ  ، عَنْ  يَحْيَى بْنِ هِنْدٍ  ، عَنْ  حَمْزَةَ بْنِ عَمْرٍو  إِلَّا  يَحْيَى بْنُ أَيُّوبَ  ،  تَفَرَّدَ بِهِ  ابْنُ وَهْبٍ  .  وَرَوَاهُ النَّاسُ عَنِ  ابْنِ حَرْمَلَةَ  ، عَنْ  يَحْيَى بْنِ هِنْدٍ  ، عَنْ  أَسْمَاءَ بْنِ خَارِجَةَ  .","","Al-Mu'jam al-Awsat 9135","","حمزة بن عمرو بن عويمر الأسلمي عن يحيى بن هند الأسلمي عن عبد الرحمن بن حرملة الأسلمي عن يحيى بن أيوب الغافقي عن عبد الله بن وهب المصري عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9144","9136  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُغِيرَةِ ،  عَنِ  ابْنِ أَبِي الزِّنَادِ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ  . عَنِ  ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الدُّنْيَا سِجْنُ الْمُؤْمِنِ ، وَجَنَّةُ الْكَافِرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُوسَى بْنِ عُقْبَةَ  إِلَّا  ابْنُ أَبِي الزِّنَادِ  ، وَلَا عَنِ  ابْنِ أَبِي الزِّنَادِ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ الْمُغِيرَةِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9136","","عبد الله بن عمر بن الخطاب عن عبد الله بن دينار العدوي عن موسى بن عقبة عن عبد الرحمن بن أبي الزناد عن عبد الرحمن بن المغيرة الحزامي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9145","[9/66]      9137  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ الْمُغِيرَةِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي الزِّنَادِ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ أَبِي عَتِيقٍ ،  عَنْ  أَبِيهِ  ، -  لَا أَعْلَمُهُ إِلَّا عَنْ  عَائِشَةَ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا كَانَ نَبِيٌّ قَطُّ إِلَّا فِي أُمَّتِهِ مُعَلَّمٌ أَوْ مُعَلَّمَانِ  ، وَإِنْ يَكُنْ فِي أُمَّتِي مِنْهُمْ أَحَدٌ فَهُوَ  عُمَرُ بْنُ الْخَطَّابِ  ، إِنَّ  الْحَقَّ  عَلَى لِسَانِ  عُمَرَ  وَقَلْبِهِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَائِشَةَ  : "" إِنَّ  الْحَقَّ  عَلَى لِسَانِ  عُمَرَ  وَقَلْبِهِ "" إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9137","","عائشة بنت أبي بكر الصديق عن محمد بن عبد الرحمن التيمي عن عبد الله بن أبي عتيق التيمي عن عبد الرحمن بن أبي الزناد عن عبد الرحمن بن المغيرة الحزامي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9146","9138  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْفَضْلِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ اللهِ  بْنِ أَبِي حُسَيْنٍ الْمَكِّيِّ ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ .  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا كَانَ يَوْمُ الْقِيَامَةِ نُودِيَ : أَيْنَ أَبْنَاءُ السِّتِّينَ  ؟ وَهُوَ الْعُمُرُ الَّذِي قَالَ :         {      أَوَلَمْ نُعَمِّرْكُمْ مَا يَتَذَكَّرُ فِيهِ مَنْ تَذَكَّرَ وَجَاءَكُمُ النَّذِيرُ         }      .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءٍ  إِلَّا  ابْنُ أَبِي حُسَيْنٍ  ، وَلَا عَنِ  ابْنِ أَبِي حُسَيْنٍ  إِلَّا  إِبْرَاهِيمُ بْنُ الْفَضْلِ  ،  تَفَرَّدَ بِهِ  ابْنُ أَبِي فُدَيْكٍ  ، وَلَا يُرْوَى عَنِ  ابْنِ عَبَّاسٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .  كذا في طبعة دار الحرمين ، ولعل الصواب : (عبد الرحمن) والله أعلم","","Al-Mu'jam al-Awsat 9138","","عبد الله بن عباس عن عطاء بن أبي رباح عن عبد الله بن عبد الرحمن بن أبي حسين النوفلي عن إبراهيم بن الفضل المخزومي عن محمد بن إسماعيل بن مسلم الديلي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9147","9139  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  إِسْحَاقُ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ الْمُخَرِّمِيِّ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُحَمَّدِ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  قَالَ  سَعْدُ بْنُ أَبِي وَقَّاصٍ :  لَقَدْ شَهِدْتُ  بَدْرًا  وَمَا فِي وَجْهِي غَيْرُ  شَعَرَةٍ  ، ثُمَّ أَكْثَرَ اللهُ بَعْدُ مِنَ اللِّحَى  "" .         [9/67]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْحَاقَ بْنِ جَعْفَرٍ  إِلَّا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9139","","سعد بن أبي وقاص عن محمد بن سعد بن أبي وقاص عن إسماعيل بن محمد بن سعد عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن إسحاق بن جعفر بن محمد الجعفري الحزين عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9148","9140  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  حَدَّثَنِي  إِسْحَاقُ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْمُخَرِّمِيُّ ،  عَنْ  عُثْمَانَ بْنِ مُحَمَّدٍ الْأَخْنَسِيِّ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ  . عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ  قِبْلَةٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْحَاقَ بْنِ جَعْفَرٍ  إِلَّا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9140","","أبو هريرة الدوسي عن سعيد المقبري عن عثمان بن محمد بن المغيرة الأخنسي عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة عن إسحاق بن جعفر بن محمد الجعفري الحزين عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9149","9141  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مَعْنُ بْنُ عِيسَى ،  عَنْ  هِشَامِ بْنِ سَعْدٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ  . عَنْ  أَبِي رَافِعٍ ،  أَنَّهُ أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِكَتِفِ شَاةٍ ، فَأَكَلَهَا وَلَمْ يَتَوَضَّأْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا  هِشَامُ بْنُ سَعْدٍ  ،  تَفَرَّدَ بِهِ  مَعْنُ بْنُ عِيسَى  .","","Al-Mu'jam al-Awsat 9141","","أبو رافع القبطي عن عطاء بن يسار الهلالي عن زيد بن أسلم عن هشام بن سعد المخزومي عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9150","9142  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُوسَى التَّيْمِيُّ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  مُعَاذِ بْنِ عَبْدِ اللهِ بْنِ خُبَيْبٍ  . عَنْ  جَابِرِ بْنِ أُسَامَةَ الْجُهَنِيِّ ، قَالَ :  لَقِيتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَصْحَابِهِ بِالسُّوقِ ، فَقُلْتُ : أَيْنَ يُرِيدُ رَسُولُ اللهِ ؟ قَالُوا :  يُرِيدُ أَنْ  يَخُطَّ  لِقَوْمِكَ مَسْجِدًا  ، قَالَ : فَأَتَيْتُ "" وَقَدْ خَطَّ لَهُمْ مَسْجِدًا ، وَغَرَزَ فِي قِبْلَتِهِ خَشَبَةً ، فَأَقَامَهَا قِبْلَةً "" .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  جَابِرِ بْنِ أُسَامَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9142","","جابر بن أسامة الأنصاري عن معاذ بن عبد الله بن خبيب الجهني عن أسامة بن زيد الليثي المدني عن عبد الله بن موسى بن إبراهيم الطلحي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9151","9143  -  حَدَّثَنَا  مَسْعَدَةُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ عُرْوَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  وَهْبِ بْنِ كَيْسَانَ .         [9/68]      عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  أَنَّ أَبَاهُ تُوُفِّيَ وَتَرَكَ عَلَيْهِ ثَلَاثِينَ وَسْقًا  لِرَجُلٍ  مِنَ الْيَهُودِ ، فَاسْتَنْظَرَهُ  جَابِرٌ  ، فَأَبَى أَنْ يُنْظِرَهُ ، وَكَلَّمَ  جَابِرٌ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَشْفَعُ إِلَيْهِ ، فَجَاءَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَكَلَّمَ الْيَهُودِيَّ لِيَأْخُذَ تَمْرَهُ كُلَّهُ ، فَأَبَى عَلَيْهِ ، وَكَلَّمَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُنْظِرَهُ ، فَأَبَى ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَوْفَاهُ ثَلَاثِينَ وَسْقًا ، وَفَضَلَ لَهُ عَشَرَةُ  أَوْسُقٍ  ، فَجَاءَ  جَابِرٌ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرَهُ بِالَّذِي فَضَلَ فَوَجَدَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي الْعَصْرَ ، فَلَمَّا انْصَرَفَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَاءَهُ فَأَخْبَرَهُ أَنَّهُ قَدْ أَوْفَاهُ ، وَأَخْبَرَهُ بِالْفَضْلِ الَّذِي فَضَلَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَخْبِرْ بِذَلِكَ  عُمَرَ بْنَ الْخَطَّابِ  ، فَذَهَبَ  جَابِرٌ  إِلَى  عُمَرَ  فَأَخْبَرَهُ ، فَقَالَ : لَقَدْ عَلِمْتُ حِينَ مَشَى فِيهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَيُبَارِكَنَّ اللهُ فِيهَا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  وَهْبِ بْنِ كَيْسَانَ  إِلَّا  هِشَامُ بْنُ عُرْوَةَ  ، وَلَا رَوَاهُ عَنْ  هِشَامٍ  إِلَّا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9143","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن وهب بن كيسان القرشي عن هشام بن عروة بن الزبير عن عبد الله بن محمد بن يحيى المدني عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9152","9144  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي ثَابِتٍ ،  حَدَّثَنِي  أَبُو بَكْرِ بْنُ النُّعْمَانِ بْنِ عَبْدِ اللهِ بْنِ كَعْبِ بْنِ مَالِكٍ ،  عَنْ  أَبِيهِ .  عَنْ  جَدِّهِ كَعْبِ بْنِ مَالِكٍ  ، قَالَ :  حَرَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الشَّجَرَ  بِالْمَدِينَةِ  بَرِيدًا فِي بَرِيدٍ  ، وَأَرْسَلَنِي فَأَعْلَمْتُ عَلَى الْحَرَمِ ، عَلَى شَرَفِ  ذَاتِ الْجَيْشِ  ، وَعَلَى  شَرِيثٍ ،  وَعَلَى  مَخِيضٍ  ، وَعَلَى  نَبْتٍ  "" .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  كَعْبٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9144","","كعب بن مالك الأنصاري عن أبو أبو بكر بن النعمان بن عبد الله الأنصاري عن أبو بكر بن النعمان بن عبد الله الأنصاري عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9153","9145  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  أَبُو ضَمْرَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ أَبِي أَسِيدٍ ،  عَنْ  نَافِعٍ  . عَنِ  ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  لَا يَحِلُّ لِمُؤْمِنٍ أَنْ يَهْجُرَ أَخَاهُ فَوْقَ ثَلَاثَةٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعٍ  إِلَّا  إِبْرَاهِيمُ بْنُ أَبِي أَسِيدٍ  .","","Al-Mu'jam al-Awsat 9145","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن إبراهيم بن أبي أسيد عن أنس بن عياض الليثي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9154","[9/69]      9146  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  مَعْنُ بْنُ عِيسَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الْعَزِيزِ اللَّيْثِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ  . عَنِ  ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْبِضْعُ  مَا بَيْنَ السَّبْعِ إِلَى الْعَشْرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  عَبْدُ اللهِ بْنُ عَبْدِ الْعَزِيزِ  ، وَلَا رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الْعَزِيزِ  إِلَّا  مَعْنٌ  وَمُحَمَّدُ بْنُ خَالِدِ بْنِ عَثْمَةَ  .","","Al-Mu'jam al-Awsat 9146","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن عبد الله بن عبد العزيز الربذي عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9155","9147  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  نَا  شِبْلُ بْنُ الْعَلَاءِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  .  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَا عَرَبِيٌّ ، وَالْقُرْآنُ عَرَبِيٌّ  ، وَلِسَانُ أَهْلِ الْجَنَّةِ عَرَبِيٌّ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شِبْلٍ  إِلَّا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  ، وَلَا يُرْوَى عَنْ  أَبِي هُرَيْرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  "" .","","Al-Mu'jam al-Awsat 9147","","أبو هريرة الدوسي عن عبد الرحمن بن يعقوب الجهني عن العلاء بن عبد الرحمن الحرقي عن شبل بن العلاء الحرقي عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9156","9148  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مَعْنُ بْنُ عِيسَى ،  عَنْ  عَدِيِّ بْنِ الْفَضْلِ ،  عَنْ  أَيُّوبَ السَّخْتِيَانِيِّ ،  عَنْ  أَبِي الزُّبَيْرِ  . عَنْ  جَابِرٍ ، -  رَفَعَهُ  - قَالَ :  الضَّبُعُ صَيْدٌ  ، وَنُهِيَ الْمُحْرِمُ ، عَنْ قَتْلِهَا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَيُّوبَ  إِلَّا  عَدِيُّ بْنُ الْفَضْلِ  ، وَلَا عَنْ  عَدِيٍّ  إِلَّا  مَعْنٌ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9148","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن أيوب السختياني عن عدي بن الفضل التيمي عن معن بن عيسى عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9157","9149  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  مُحَمَّدُ بْنُ صَدَقَةَ الْفَدَكِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ سَهْلِ بْنِ أَبِي حَثْمَةَ ،  عَنْ  عَمَّهِ  أَبِي عُفَيْرِ بْنِ سَهْلِ بْنِ أَبِي حَثْمَةَ         [9/70]      أَنَّ أَبَاهُ  ، قَدْ  أَخْبَرَهُ  ،  أَنَّ  أَبَا بُرْدَةَ بْنَ نِيَارٍ ذَبَحَ ذَبِيحَةً بِسَحَرٍ ، فَلَمَّا انْصَرَفَ ذَكَرَ ذَلِكَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  مَنْ ذَبَحَ قَبْلَ الصَّلَاةِ فَلَيْسَتْ تِلْكَ الْأُضْحِيَّةَ  ، إِنَّمَا الْأُضْحِيَّةُ مَا ذُبِحَ بَعْدَ الصَّلَاةِ ، فَاذْهَبْ فَضَحِّ "" ، فَقَالَ : يَا رَسُولَ اللهِ مَا أَجِدُ شَيْئًا لِلْأُضْحِيَّةِ ، وَمَا عِنْدِي إِلَّا  جَذَعٌ  مِنَ الْمَعْزِ ، قَالَ : "" اذْهَبْ فَضَحِّ بِهَا ، وَلَيْسَ فِيهَا رُخْصَةٌ لِأَحَدٍ بَعْدَكَ "" .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  سَهْلِ بْنِ أَبِي حَثْمَةَ  ، إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9149","","هانئ بن نيار البلوي عن سهل بن أبي حثمة الخزرجي عن محمد بن سهل بن أبي حثمة الأوسي عن محمد بن يحيى بن سهل الأنصاري عن محمد بن صدقة الفدكي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9158","9150  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  نَا  مُحَمَّدُ بْنُ صَدَقَةَ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ سَهْلِ بْنِ أَبِي حَثْمَةَ الْحَارِثِيِّ ،  عَنْ  أَبِيهِ .  عَنْ  جَدِّهِ  ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَ أَبَاهُ  أَبَا حَثْمَةَ  خَارِصًا ، فَجَاءَهُ  رَجُلٌ  فَقَالَ : يَا رَسُولَ اللهِ إِنَّ  أَبَا حَثْمَةَ  قَدْ زَادَ عَلَيَّ ، فَدَعَا  أَبَا حَثْمَةَ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ ابْنَ عَمِّكَ يَزْعُمُ أَنَّكَ قَدْ زِدْتَ عَلَيْهِ  ، فَقَالَ : يَا رَسُولَ اللهِ قَدْ تَرَكْتُ عَرِيَّةَ أَهْلِهِ ، وَمَا يُطْعِمُ الْمَسَاكِينَ ، وَمَا يُصِيبُهُ الرِّيحُ . فَقَالَ : "" قَدْ زَادَكَ ابْنُ عَمِّكَ وَأَنْصَفَ "" .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  سَهْلِ بْنِ أَبِي حَثْمَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9150","","سهل بن أبي حثمة الخزرجي عن يحيى بن سهل الحارثي عن محمد بن يحيى بن سهل الأنصاري عن محمد بن صدقة الجبلاني عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9159","9151  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  مُحَمَّدُ بْنُ صَدَقَةَ ،  ثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ سَهْلِ بْنِ أَبِي حَثْمَةَ الْحَارِثِيُّ ،  عَنْ  بَشِيرِ بْنِ عَبْدِ اللهِ بْنِ مِكْتَفِ بْنِ مُحَيِّصَةَ ،  حَدَّثَنِي  سَهْلُ بْنُ أَبِي حَثْمَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ ، وَخَرَجَ مَعَهُ  عَبْدُ الرَّحْمَنِ بْنُ سَهْلٍ  ، فَلَمَّا كَانَ  بِالْحَرَّةِ  نَهَشَتْ  عَبْدَ الرَّحْمَنِ بْنَ سَهْلٍ  حَيَّةٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ادْعُوا لِي  عَمْرَو بْنَ حَزْمٍ  ، فَدُعِيَ ، فَعَرَضَ رُقْيَتَهُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : "" لَا بَأْسَ بِهَا ، ارْقِهِ "" ، قَالَ : فَوَضَعَ  ابْنُ حَزْمٍ  يَدَهُ عَلَيْهِ ، فَقَالَ : يَا رَسُولَ اللهِ هُوَ  يَمُوتُ . أَوْ : قَدْ مَاتَ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" ارْقِهِ ، وَإِنْ كَانَ قَدْ         [9/71]      يَمُوتُ "" - أَوْ : "" قَدْ مَاتَ  "" - ، فَرَقَاهُ ، فَصَحَّ  عَبْدُ الرَّحْمَنِ  ، وَانْطَلَقَ "" .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  سَهْلٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ  .","","Al-Mu'jam al-Awsat 9151","","سهل بن أبي حثمة الخزرجي عن بشير بن عبد الله بن مكنف المدني عن محمد بن يحيى بن سهل الأنصاري عن محمد بن صدقة الفدكي عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","مسعدة بن سعد العطار المكي"
"9160","مَنِ اسْمُهُ مُصْعَبٌ  9152  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ بْنِ مُحَمَّدِ بْنِ حَمْزَةَ بْنِ مُصْعَبِ بْنِ الزُّبَيْرِ بْنِ الْعَوَّامِ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُحَمَّدٍ الْجَحْشِيُّ ،  حَدَّثَنِي  عَمِّي عُمَرُ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  حُمَيْدٍ الطَّوِيلِ  . عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  خَدَمْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَشْرَ سِنِينَ ، مَا دَرَيْتُ شَيْئًا قَطُّ وَافَقَهُ ، وَلَا شَيْئًا قَطُّ خَالَفَهُ ، رَضِيَ مِنَ اللهِ بِمَا كَانَ ، وَإِنْ كَانَ بَعْضُ أَزْوَاجِهِ يَقُولُ : لَوْ فَعَلْتَ كَذَا وَكَذَا ، مَا لَكَ فَعَلْتَ كَذَا ؟ فَيَقُولُ :  دَعُوهُ ؛ فَإِنَّهُ لَا يَكُونُ إِلَّا مَا أَرَادَ اللهُ  . "" وَمَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  انْتَقَمَ  لِنَفْسِهِ مِنْ شَيْءٍ قَطُّ إِلَّا أَنْ يُنْتَهَكَ لِلهِ  حُرْمَةٌ  ، فَإِنِ انْتُهِكَتْ  حُرْمَةٌ  كَانَ أَشَدَّ النَّاسِ غَضَبًا لِلهِ ، وَمَا عُرِضَ عَلَيْهِ أَمْرَانِ قَطُّ إِلَّا اخْتَارَ أَيْسَرَهُمَا ، مَا لَمْ يَكُنْ فِيهِ لِلهِ  سَخَطٌ  ، فَإِنْ كَانَ لِلهِ فِيهِ  سَخَطٌ  كَانَ أَبْعَدَ النَّاسِ مِنْهُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ  إِلَّا  عُمَرُ بْنُ مُحَمَّدٍ الْجَحْشِيُّ  ،  تَفَرَّدَ بِهِ  عُبَيْدُ اللهِ بْنُ مُحَمَّدٍ الْجَحْشِيُّ  .","","Al-Mu'jam al-Awsat 9152","","أنس بن مالك عن حميد الطويل عن محمد بن عجلان عن عمر بن محمد عن عبيد الله بن محمد الجحشي عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9161","9153  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي ،  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ  . عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنْ أَبَى فَرُدَّهُ ، فَإِنْ أَبَى  فَقَاتِلْهُ  ؛ فَإِنَّمَا هُوَ شَيْطَانٌ "" - فِي الْمَارِّ بَيْنَ يَدَيِ الْمُصَلِّي - "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ  إِلَّا  الدَّرَاوَرْدِيُّ  .","","Al-Mu'jam al-Awsat 9153","","أبو سعيد الخدري عن عطاء بن يسار الهلالي عن صفوان بن سليم القرشي عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9162","[9/72]      9154  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ مُحَمَّدِ بْنِ مُسْلِمٍ .  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ  رَجُلًا مِنَ الْأَعْرَابِ  أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ مَتَى تَقُومُ السَّاعَةُ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  وَمَا أَعْدَدْتَ لِلسَّاعَةِ  ؟ "" فَقَالَ الْأَعْرَابِيُّ : مَا أَعْدَدْتُ لَهَا كَبِيرَ عَمَلٍ إِلَّا اثْنَيْنِ ، إِلَّا أَنِّي أُحِبُّ اللهَ وَرَسُولَهُ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَأَنْتَ مَعَ مَنْ أَحْبَبْتَ "" .","","Al-Mu'jam al-Awsat 9154","","أنس بن مالك عن محمد بن مسلم بن السائب بن خباب المدني عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9163","9155  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ مُسْلِمٍ ،  عَنْ  عَمِّهِ .  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ حِينَ زَاغَتِ الشَّمْسُ ، فَصَلَّى بِهِمْ صَلَاةَ الظُّهْرِ ، فَلَمَّا سَلَّمَ قَامَ عَلَى الْمِنْبَرِ ، فَذَكَرَ السَّاعَةَ ، وَذَكَرَ أَنَّ قَبْلَهَا أُمُورًا عِظَامًا ، ثُمَّ قَالَ :  مَنْ أَحَبَّ أَنْ يَسْأَلَ عَنْ شَيْءٍ فَلْيَسْأَلْ عَنْهُ  ، فَوَاللهِ لَا تَسْأَلُونِي عَنْ شَيْءٍ إِلَّا أَخْبَرْتُكُمْ بِهِ مَا دُمْتُ فِي مَقَامِي هَذَا "" ، قَالَ  أَنَسٌ  : فَأَكْثَرَ النَّاسُ الْبُكَاءَ حِينَ سَمِعُوا ، وَأَكْثَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَقُولَ : "" سَلُونِي عَمَّ شِئْتُمْ "" ، فَقَامَ  عَبْدُ اللهِ بْنُ حُذَافَةَ السَّهْمِيُّ  ، فَقَالَ : مَنْ أَبِي ؟ قَالَ : "" أَبُوكَ  حُذَافَةُ  "" ، فَلَمَّا أَكْثَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَقُولَ : "" سَلُونِي "" قَامَ  عُمَرُ  عَلَى رُكْبَتَيْهِ ، فَقَالَ : يَا رَسُولَ اللهِ رَضِينَا بِاللهِ رَبًّا وَبِالْإِسْلَامِ دِينًا ،  وَبِمُحَمَّدٍ  نَبِيًّا ، فَسَكَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ قَالَ ذَلِكَ  عُمَرُ  ، وَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" وَالَّذِي نَفْسِي بِيَدِهِ ، لَقَدْ عُرِضَتْ عَلَيَّ الْجَنَّةُ وَالنَّارُ فِي  عُرْضِ  هَذَا الْحَائِطِ ، فَلَمْ أَرَ كَالْيَوْمِ فِي  الْخَيْرِ  وَالشَّرِّ  .","","Al-Mu'jam al-Awsat 9155","","أنس بن مالك عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9164","9156  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنِي  أَبِي ،  نَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" طَافَ بِالْبَيْتِ عَلَى رَاحِلَتِهِ  ، يَسْتَلِمُ الرُّكْنَ         [9/73]      بِمِحْجَنِهِ  .","","Al-Mu'jam al-Awsat 9156","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9165","9157  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنِي  أَبِي  ،  نَا  عَبْدُ الْعَزِيزِ ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ  . عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ حَلَفَ  بِاللَّاتِ  وَالْعُزَّى فَلْيَقُلْ : لَا إِلَهَ إِلَّا اللهُ  ، وَمَنْ قَالَ لِصَاحِبِهِ : تَعَالَ  أُقَامِرْكَ ،  فَلْيَتَصَدَّقْ  .","","Al-Mu'jam al-Awsat 9157","","أبو هريرة الدوسي عن حميد بن عبد الرحمن القرشي عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9166","9158  -  حَدَّثَنَا  مُصْعَبٌ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُعَاوِيَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  ، وَإِنَّمَا أَنَا قَاسِمٌ ، وَيُعْطِي اللهُ جَلَّ ذِكْرُهُ "" .","","Al-Mu'jam al-Awsat 9158","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9167","9159  -  وَبِهِ  ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ .  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ  سَالِمٌ مَوْلَى أَبِي حُذَيْفَةَ  - مَوْلَى  امْرَأَةٍ مِنَ الْأَنْصَارِ  - وَكَانَ  أَبُو حُذَيْفَةَ  قَدْ  تَبَنَّاهُ  كَمَا  تَبَنَّى  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  زَيْدَ بْنَ حَارِثَةَ  ، "" وَكَانَ مَنْ  تَبَنَّى  رَجُلًا فِي الْجَاهِلِيَّةِ دَعَاهُ النَّاسُ إِلَيْهِ وَوَرِثَ مِنْ مِيرَاثِهِ حَتَّى أَنْزَلَ اللهُ :         {      ادْعُوهُمْ لآبَائِهِمْ هُوَ أَقْسَطُ عِنْدَ اللهِ         }      .","","Al-Mu'jam al-Awsat 9159","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9168","9160  -  حَدَّثَنَا  مُصْعَبٌ ،  حَدَّثَنِي  أَبِي  ،  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ .  عَنْ  عَائِشَةَ ،  أَنَّ  امْرَأَةً  كَانَتْ تَسْتَعِيرُ الْحُلِيَّ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَتَجْحَدُهُ  ، "" فَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِقَطْعِهَا  قَالَ  الزُّهْرِيُّ  :  وَحَدَّثَنِي  الْقَاسِمُ بْنُ مُحَمَّدٍ         [9/74]      عَنْ  عَائِشَةَ ، قَالَتْ :  فَنَكَحَتْ تِلْكَ الْمَرْأَةُ  رَجُلًا مِنْ بَنِي سُلَيْمٍ  ، وَكَانَتْ عِنْدَهُ حَسَنَةَ التَّلَبُّسِ  ، تَأْتِينِي فَأَرْفَعُ لَهَا حَاجَتَهَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Al-Mu'jam al-Awsat 9160","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9169","9161  -  وَبِهِ  ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  عُرْوَةَ  عَنْ  عَائِشَةَ ، قَالَتْ :  كَسَفَتِ الشَّمْسُ عَلَى حَيَاةِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَصَلَّى بِالنَّاسِ  - الْحَدِيثَ بِطُولِهِ .","","Al-Mu'jam al-Awsat 9161","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9170","9162  -  وَبِهِ  ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  كَثِيرِ بْنِ الْعَبَّاسِ .  أَنَّ عَبْدَ اللهِ بْنَ عَبَّاسٍ ،  كَانَ  يُحَدِّثُ  عَنْ  صَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ كَسَفَتِ الشَّمْسُ  بِالْمَدِينَةِ  ، أَنَّهُ لَمْ يَزِدْ عَلَى رَكْعَتَيْنِ مِثْلَ صَلَاةِ الصُّبْحِ  .","","Al-Mu'jam al-Awsat 9162","","عبد الله بن عباس عن كثير بن العباس بن عبد المطلب بن هاشم عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9171","9163  -  وَبِهِ  ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ، أَنَّهُ  سَمِعَ  أَبَا طَلْحَةَ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَدْخُلُ الْمَلَائِكَةُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .","","Al-Mu'jam al-Awsat 9163","","زيد بن سهل بن الأسود الأنصاري عن عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9172","9164  -  وَبِهِ  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  سَالِمٍ .  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  بَيْنَا أَنَا نَائِمٌ رَأَيْتُنِي أَطُوفُ  ، فَإِذَا رَجُلٌ آدَمُ سَبْطُ الشَّعَرِ بَيْنَ رَجُلَيْنِ ،  يَنْطِفُ  رَأْسُهُ ، قُلْتُ : مَنْ هَذَا ؟ قَالُوا :  عِيسَى ابْنُ مَرْيَمَ  ، فَذَهَبْتُ فَالْتَفَتُّ فَإِذَا رَجُلٌ أَحْمَرُ جَسِيمٌ  جَعْدُ  الرَّأْسِ  أَعْوَرُ  الْعَيْنِ الْيُمْنَى كَأَنَّ عَيْنَهُ عِنَبَةٌ  طَافِيَةٌ ،  قُلْتُ : مَنْ هَذَا ؟ قَالُوا :  الدَّجَّالُ  ، أَقْرَبُ النَّاسِ بِهِ شَبَهًا  ابْنُ قَطَنٍ  "" .","","Al-Mu'jam al-Awsat 9164","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9173","9165  -  وَبِهِ  ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  سَالِمٍ .  عَنْ  أَبِيهِ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  تُقَاتِلُكُمُ الْيَهُودُ ، وَتَتَسَلَّطُونَ عَلَيْهِمْ  حَتَّى يَقُولَ الْحَجَرُ : يَا عَبْدَ اللهِ هَذَا يَهُودِيٌّ وَرَائِي ، فَاقْتُلْهُ  .","","Al-Mu'jam al-Awsat 9165","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9174","9166  -  وَبِهِ  ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ         [9/75]      عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَدْخُلُ الْجَنَّةَ مِنْ أُمَّتِي زُمْرَةٌ سَبْعُونَ أَلْفًا  ، وَضَوْءُ وُجُوهِهِمْ كَضَوْءِ الْقَمَرِ لَيْلَةَ الْبَدْرِ  .","","Al-Mu'jam al-Awsat 9166","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9175","9167  -  وَبِهِ  ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  . عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا قُلْتَ لِصَاحِبِكَ يَوْمَ الْجُمُعَةِ :  أَنْصِتْ  ، وَالْإِمَامُ يَخْطُبُ ، فَقَدْ  لَغَوْتَ  .","","Al-Mu'jam al-Awsat 9167","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9176","9168  -  وَبِهِ  ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  أَبِي سَلَمَةَ .  عَنْ  عَائِشَةَ  أَنَّ  أَبَا بَكْرٍ  دَخَلَ الْمَسْجِدَ  وَعُمَرُ  يُكَلِّمُ النَّاسَ  ، فَمَضَى حَتَّى دَخَلَ بَيْتَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الَّذِي تُوُفِّيَ فِيهِ - وَهُوَ فِي بَيْتِ  عَائِشَةَ  - فَكَشَفَ عَنْ وَجْهِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بُرْدَ حِبَرَةٍ ، وَكَانَ  مُسَجًّى  بِهِ ، وَنَظَرَ إِلَى وَجْهِهِ ، وَأَكَبَّ عَلَيْهِ يُقَبِّلُهُ  "" .","","Al-Mu'jam al-Awsat 9168","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9177","9169  -  وَبِهِ  ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ  عَنْ  أَنَسٍ ،  أَنَّهُ سَمِعَ خُطْبَةَ  عُمَرَ  الْآخِرَةَ  ، حِينَ جَلَسَ  أَبُو بَكْرٍ  عَلَى مِنْبَرِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَذَاكَ الْغَدُ مِنْ يَوْمِ تُوُفِّيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  "" .","","Al-Mu'jam al-Awsat 9169","","أنس بن مالك عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9178","9170  -  وَبِهِ  ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ .  عَنْ  عَائِشَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دَخَلَ عَلَيْهَا وَهِيَ مُسْتَتِرَةٌ  بِقِرَامٍ  فِيهِ صُورَةُ تَمَاثِيلَ ، فَنَقَضَهَا ثُمَّ قَالَ :  إِنَّ أَشَدَّ النَّاسِ عَذَابًا الَّذِينَ يُضَاهُونَ بِخَلْقِ اللهِ  .","","Al-Mu'jam al-Awsat 9170","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9179","9171  -  وَبِهِ  :  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ ابْنِ أَخِي الزُّهْرِيِّ ،  عَنْ  عَمِّهِ ،  عَنْ  عُبَيْدِ بْنِ السَّبَّاقِ ، قَالَ :  أَخْبَرَنِي  ابْنُ عَبَّاسٍ ، أَنَّ مَيْمُونَةَ  أَخْبَرَتْهُ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَصْبَحَ يَوْمًا  وَاجِمًا  ، فَقَالَتْ لَهُ  مَيْمُونَةُ  : يَا رَسُولَ اللهِ اسْتَنْكَرْتُ هَيْئَتَكَ هَذَا الْيَوْمَ ، فَأَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَهُ ذَلِكَ عَلَى ذَلِكَ ، ثُمَّ وَقَعَ فِي نَفْسِهِ جَرْوٌ كَانَ تَحْتَ  نَضَدٍ  لَنَا ، فَأَمَرَ بِهِ فَأُخْرِجَ ، ثُمَّ أَخَذَ بِيَدِهِ مَاءً  فَنَضَحَ  مَكَانَهُ ، فَلَمَّا أَمْسَى لَقِيَهُ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  قَدْ كُنْتَ وَاعَدْتَنِي أَنْ تَلْقَانِي الْبَارِحَةَ  ، فَقَالَ : أَجَلْ ، وَلَكِنَّا لَا نَدْخُلُ بَيْتًا فِيهِ كَلْبٌ وَلَا صُورَةٌ  .         [9/76]      لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنِ  ابْنِ أَخِي الزُّهْرِيِّ  إِلَّا  الدَّرَاوَرْدِيُّ  ،  تَفَرَّدَ بِهَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ  .","","Al-Mu'jam al-Awsat 9171","","ميمونة بنت الحارث زوج رسول الله عن عبد الله بن عباس عن عبيد بن السباق  العبدري عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9180","9172  -  حَدَّثَنَا  مُصْعَبٌ ،  نَا  إِبْرَاهِيمُ بْنُ حَمْزَةَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِي بَكْرِ بْنِ نَافِعٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  صَفِيَّةَ بِنْتِ أَبِي عُبَيْدٍ ، قَالَتْ :  سَمِعْتُ  عُمَرَ بْنَ الْخَطَّابِ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَتَى  عَرَّافًا  لَمْ تُقْبَلْ لَهُ صَلَاةٌ أَرْبَعِينَ لَيْلَةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي بَكْرِ بْنِ نَافِعٍ  إِلَّا  الدَّرَاوَرْدِيُّ  .","","Al-Mu'jam al-Awsat 9172","","عمر بن الخطاب عن صفية بنت أبي عبيد زوج عبد الله بن عمر عن نافع مولى ابن عمر عن أبو بكر بن نافع مولى عبد الله بن عمر عن عبد العزيز بن محمد الدراوردي عن والد إبراهيم بن حمزة الزبيري عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9181","9173  -  حَدَّثَنَا  مُصْعَبٌ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  نَا  عَبْدُ اللهِ بْنُ مُصْعَبِ بْنِ ثَابِتِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ .  عَنِ  الزُّبَيْرِ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  فَضَّلَ اللهُ  قُرَيْشًا  بِسَبْعِ خِصَالٍ : فَضَّلَهُمْ بِأَنَّهُمْ عَبَدُوا اللهَ عَشْرَ سِنِينَ ، لَا يَعْبُدُهُ إِلَّا قُرَشِيٌّ  ، وَفَضَّلَهُمْ بِأَنَّهُ نَصَرَهُمْ يَوْمَ الْفِيلِ وَهُمْ مُشْرِكُونَ ، وَفَضَّلَهُمْ بِأَنَّهُ نَزَلَتْ فِيهِمْ سُورَةٌ مِنَ الْقُرْآنِ لَمْ يَدْخُلْ فِيهِمْ غَيْرُهُمْ         {      لإِيلافِ قُرَيْشٍ         }      وَفَضَّلَهُمْ بِأَنَّ فِيهِمُ النُّبُوَّةَ ، وَالْخِلَافَةَ ،  وَالْحِجَابَةَ  ، وَالسِّقَايَةَ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا  عَبْدُ اللهِ بْنُ مُصْعَبٍ  ، وَلَا يُرْوَى عَنِ  الزُّبَيْرِ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9173","","الزبير بن العوام عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد الله بن مصعب بن ثابت الزبيري عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9182","9174  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ ،  نَا  عِيسَى بْنُ مِينَا - قَالُونُ - ،  نَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ أَبِي كَثِيرٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الْحَارِثِ .  عَنْ  عَلِيٍّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلَا أَدُلُّكُمْ عَلَى مَا يُذْهِبُ  وَغَرَ  الصَّدْرِ ؟         [9/77]      صِيَامُ ثَلَاثَةِ أَيَّامٍ  مِنْ كُلِّ شَهْرٍ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُوسَى بْنِ عُقْبَةَ  إِلَّا  مُحَمَّدُ بْنُ جَعْفَرٍ  ،  تَفَرَّدَ بِهِ  عِيسَى بْنُ مِينَا - قَالُونُ  .","","Al-Mu'jam al-Awsat 9174","","علي بن أبي طالب عن الحارث الأعور عن أبو إسحاق السبيعي عن موسى بن عقبة عن محمد بن جعفر بن أبي كثير الزرقي عن قالون عيسى بن ميناء عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9183","9175  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ الزُّبَيْرِيُّ ،  نَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عُمَرَ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  عَمْرِو بْنِ سُلَيْمٍ .  عَنْ  أَبِي قَتَادَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا دَخَلَ أَحَدُكُمُ الْمَسْجِدَ فَلَا يَجْلِسْ حَتَّى يُصَلِّيَ رَكْعَتَيْنِ  .","","Al-Mu'jam al-Awsat 9175","","أبو قتادة الأنصاري فارس رسول الله عن عمرو بن سليم بن خلدة الزرقي عن عامر بن عبد الله بن الزبير بن العوام عن عبيد الله بن عمر العمري عن محمد بن عبد الله بن دينار عن إبراهيم بن المنذر الحزامي عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9184","9176  -  حَدَّثَنَا  مُصْعَبٌ ،  حَدَّثَنِي  أَبِي  ،  نَا  أَيُّوبُ بْنُ أَبِي خَالِدٍ الْخَيَّاطُ ،  حَدَّثَنِي  عُمَارَةُ بْنُ غَزِيَّةَ ،  عَنِ  الْأَعْرَجِ .  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  بَيْنَمَا رَجُلٌ يَمْشِي فِي  حُلَّةٍ  ، قَدْ أَعْجَبَتْهُ نَفْسُهُ ، فَخُسِفَ بِهِ ،  فَهُوَ  يَتَجَلْجَلُ  بِهِ إِلَى يَوْمِ الْقِيَامَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ  إِلَّا  أَيُّوبُ بْنُ أَبِي خَالِدٍ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ حَمْزَةَ  .","","Al-Mu'jam al-Awsat 9176","","أبو هريرة الدوسي عن عبد الرحمن بن هرمز الأعرج عن عمارة بن غزية عن أيوب بن أبي خالد الحناط عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","مصعب بن إبراهيم بن حمزة الزبيري"
"9185","مَنِ اسْمُهُ : مُوَرِّعٌ  9177  -  حَدَّثَنَا  مُوَرِّعُ بْنُ عَبْدِ اللهِ أَبُو ذُهْلٍ الْمِصِّيصِيُّ ،  نَا  الْحَسَنُ بْنُ عِيسَى الْحَرْبِيُّ ،  ثَنَا  رَوْحُ بْنُ الْمُسَيِّبِ ،  عَنْ  يَزِيدَ الرِّشْكِ  . عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّمَا جُعِلَتِ الشَّفَاعَةُ لِأَهْلِ الْكَبَائِرِ مِنْ أُمَّتِي  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ الرِّشْكِ  إِلَّا  رَوْحُ بْنُ الْمُسَيِّبِ  ،  تَفَرَّدَ بِهِ  الْحَسَنُ بْنُ عِيسَى  .","","Al-Mu'jam al-Awsat 9177","","أنس بن مالك عن يزيد بن أبي يزيد الرشك عن روح بن المسيب الكلبي عن الحسن بن عيسى الحربي عن مورع بن عبد الله أبو ذهل المصيصي عن الطبراني","مورع بن عبد الله أبو ذهل المصيصي"
"9186","[9/78]      9178  -  حَدَّثَنَا  مُوَرِّعُ بْنُ عَبْدِ اللهِ ،  ثَنَا  دَاوُدُ بْنُ مُعَاذٍ - ابْنُ بِنْتِ مَخْلَدِ بْنِ الْحُسَيْنِ -  ثَنَا  مِسْمَعُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  سَرَّارِ بْنِ مُجَشِّرٍ أَبِي عُبَيْدَةَ ،  عَنْ  أَيُّوبَ السَّخْتِيَانِيِّ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيَتَعَمَّقَنَّ أَقْوَامٌ مِنْ هَذِهِ الْأُمَّةِ  ، حَتَّى يَقُولَ أَحَدُهُمْ : هَذَا اللهُ خَلَقَنِي ، فَمَنْ خَلَقَهُ ؟ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَرَّارٍ  إِلَّا  مِسْمَعٌ  ،  تَفَرَّدَ بِهِ  دَاوُدُ بْنُ مُعَاذٍ  .","","Al-Mu'jam al-Awsat 9178","","أبو هريرة الدوسي عن محمد بن سيرين عن أيوب السختياني عن سرار بن مجشر العنزي عن مسمع بن عبد الملك بن مسمع البصري عن داود بن معاذ العتكي عن مورع بن عبد الله عن الطبراني","مورع بن عبد الله أبو ذهل المصيصي"
"9187","9179  -  حَدَّثَنَا  مُوَرِّعُ بْنُ عَبْدِ اللهِ ،  ثَنَا  عُمَرُ بْنُ يَزِيدَ السَّيَّارِيُّ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ  . عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَتَى النِّسَاءَ فِي أَعْجَازِهِنَّ فَقَدْ كَفَرَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  لَيْثٍ  إِلَّا  عَبْدُ الْوَارِثِ  ،  تَفَرَّدَ بِهِ  عُمَرُ بْنُ يَزِيدَ  .","","Al-Mu'jam al-Awsat 9179","","أبو هريرة الدوسي عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن عبد الوارث بن سعيد بن ذكوان عن عمر بن يزيد السياري عن مورع بن عبد الله عن الطبراني","مورع بن عبد الله أبو ذهل المصيصي"
"9188","9180  -  حَدَّثَنَا  مُوَرِّعٌ ،  نَا  دَاوُدُ ،  نَا  ثَابِتُ بْنُ زُهَيْرٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اللَّاعِبُ بِالنَّرْدِ كَوَاضِعِ يَدِهِ فِي لَحْمِ الْخِنْزِيرِ  ، وَالنَّاظِرُ إِلَيْهَا كَوَاضِعِ يَدِهِ فِي دَمِ الْخِنْزِيرِ "" .","","Al-Mu'jam al-Awsat 9180","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن ثابت بن زهير البصري عن داود بن معاذ العتكي عن مورع عن الطبراني","مورع بن عبد الله أبو ذهل المصيصي"
"9189","9181  -  حَدَّثَنَا  مُوَرِّعُ بْنُ عَبْدِ اللهِ ،  ثَنَا  دَاوُدُ بْنُ مُعَاذٍ ،  نَا  ثَابِتُ بْنُ زُهَيْرٍ ،  عَنْ  نَافِعٍ .  عَنِ  ابْنِ عُمَرَ ، قَالَ :  جَاءَ  أَعْرَابِيٌّ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : "" يَا نَبِيَّ اللهِ إِنِّي رَأَيْتُ الْبَارِحَةَ فِي الْمَنَامِ  أَنَّهُ لَيْسَ مِنْ عَبْدٍ يَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَشَهِدَ أَنَّكَ رَسُولُ اللهِ         [9/79]      إِلَّا رَفَعَهُ اللهُ دَرَجَةً فِي الْجَنَّةِ ، إِلَّا أَصْحَابَ الشَّاهِ -  وَهُوَ الشِّطْرَنْجُ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  نَافِعٍ  ، عَنِ  ابْنِ عُمَرَ  إِلَّا  ثَابِتُ بْنُ زُهَيْرٍ  ،  تَفَرَّدَ بِهِمَا  دَاوُدُ بْنُ مُعَاذٍ  .","","Al-Mu'jam al-Awsat 9181","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن ثابت بن زهير البصري عن داود بن معاذ العتكي عن مورع بن عبد الله عن الطبراني","مورع بن عبد الله أبو ذهل المصيصي"
"9190","9182  -  حَدَّثَنَا  مُوَرِّعُ بْنُ عَبْدِ اللهِ ،  نَا  دَاوُدُ بْنُ مُعَاذٍ ،  نَا  ثَابِتُ بْنُ زُهَيْرٍ ،  عَنْ  نَافِعٍ .  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  الْعِيرَ  الَّتِي فِيهَا  الْجَرَسُ  لَا تَصْحَبُهَا الْمَلَائِكَةُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعٍ  ، عَنِ  ابْنِ عُمَرَ  إِلَّا  ثَابِتُ بْنُ زُهَيْرٍ  .  وَرَوَاهُ النَّاسُ : عَنْ  نَافِعٍ  ، عَنْ  سَالِمٍ  ، عَنِ  الْجَرَّاحِ  ، عَنْ  أُمِّ حَبِيبَةَ  .","","Al-Mu'jam al-Awsat 9182","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن ثابت بن زهير البصري عن داود بن معاذ العتكي عن مورع بن عبد الله عن الطبراني","مورع بن عبد الله أبو ذهل المصيصي"
"9191","9183  -  حَدَّثَنَا  مُوَرِّعُ بْنُ عَبْدِ اللهِ ،  ثَنَا  دَاوُدُ بْنُ مُعَاذٍ ،  ثَنَا  أَيُّوبُ بْنُ وَاقِدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو ،  عَنْ  عَبَّادِ بْنِ عُبَيْدِ اللهِ الْأَسَدِيِّ  .  عَنْ  عَلِيٍّ ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُعَوِّذُ  الْحَسَنَ  وَالْحُسَيْنَ  :  أُعِيذُكُمَا بِكَلِمَاتِ اللهِ  التَّامَّةِ  ، مِنْ كُلِّ شَيْطَانٍ  وَهَامَّةٍ  ، وَمِنْ كُلِّ عَيْنٍ  لَامَّةٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  ، عَنِ  الْمِنْهَالِ  ، عَنْ  عَبَّادٍ  إِلَّا  أَيُّوبُ بْنُ وَاقِدٍ  ،  تَفَرَّدَ بِهِ  دَاوُدُ بْنُ مُعَاذٍ  .  وَرَوَاهُ  أَبُو حَفْصٍ الْأَبَّارُ  ، عَنِ  الْأَعْمَشِ  ، عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو  ، عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  .","","Al-Mu'jam al-Awsat 9183","","علي بن أبي طالب عن عباد بن عبد الله الأسدي عن المنهال بن عمرو الأسدي عن الأعمش عن أيوب بن واقد الكوفي عن داود بن معاذ العتكي عن مورع بن عبد الله عن الطبراني","مورع بن عبد الله أبو ذهل المصيصي"
"9192","9184  -  حَدَّثَنَا  مُوَرِّعُ بْنُ عَبْدِ اللهِ ،  نَا  الْحَسَنُ بْنُ عِيسَى ،  نَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْعَلَاءِ بْنِ الْمُسَيِّبِ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  جَعْفَرٍ ،  عَنْ  سَوْدَةَ بِنْتِ زَمْعَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمُسْتَحَاضَةُ تَدَعُ الصَّلَاةَ أَيَّامَ  أَقْرَائِهَا  الَّتِي كَانَتْ تَجْلِسُ فِيهَا  ، ثُمَّ تَغْتَسِلُ غُسْلًا وَاحِدًا ، ثُمَّ تَتَوَضَّأُ لِكُلِّ صَلَاةٍ "" .         [9/80]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَكَمِ  إِلَّا  الْعَلَاءُ بْنُ الْمُسَيِّبِ  ، وَلَا عَنِ  الْعَلَاءِ  إِلَّا  حَفْصُ بْنُ غِيَاثٍ  ،  تَفَرَّدَ بِهِ  الْحَسَنُ بْنُ عِيسَى  .","","Al-Mu'jam al-Awsat 9184","","سودة بنت زمعة زوج رسول الله عن جعفر عن الحكم بن عتيبة الكندي عن علاء بن المسيب عن حفص بن غياث النخعي عن الحسن بن عيسى الحربي عن مورع بن عبد الله عن الطبراني","مورع بن عبد الله أبو ذهل المصيصي"
"9193","مَنِ اسْمُهُ مُفَضَّلٌ  9185  -  حَدَّثَنَا  مُفَضَّلُ بْنُ مُحَمَّدٍ الْجَنَدِيُّ ،  ثَنَا  عَلِيُّ بْنُ زِيَادٍ اللَّحْجِيُّ ،  ثَنَا  أَبُو قُرَّةَ مُوسَى بْنُ طَارِقٍ ، قَالَ :  ذَكَرَهُ  زَمْعَةُ بْنُ صَالِحٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  أَنَّهُ سَمِعَ  أُمَيْمَةَ بِنْتَ رُقَيْقَةَ ، تَقُولُ :  بَايَعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ،  فَاشْتَرَطَ عَلَيَّ مَا اشْتَرَطَ عَلَى الْمُؤْمِنَاتِ ، ثُمَّ قَالَ : "" فِيمَا أَطَقْتِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُوسَى بْنِ عُقْبَةَ  إِلَّا  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9185","","أميمة بنت رقيقة التميمية عن محمد بن المنكدر عن موسى بن عقبة عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9194","9186  -  حَدَّثَنَا  مُفَضَّلُ بْنُ مُحَمَّدٍ الْجَنَدِيُّ ،  ثَنَا  عَلِيُّ بْنُ زِيَادٍ اللَّحْجِيُّ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  ابْنُ جُرَيْجٍ  ، أَخْبَرَنِي  وَرْقَاءُ بْنُ عُمَرَ ، أَنَّ عَطَاءً  أَخْبَرَهُ  أَنَّ  عَبْدَ اللهِ بْنَ عَبَّاسٍ دَعَا  الْفَضْلَ  يَوْمَ عَرَفَةَ فَقَالَ : إِنِّي صَائِمٌ ، فَقَالَ  عَبْدُ اللهِ  :  لَا تَصُمْ ، "" فَإِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قُرِّبَ إِلَيْهِ حِلَابٌ فِيهِ لَبَنٌ ، فَشَرِبَ مِنْهُ هَذَا الْيَوْمَ  ، وَإِنَّ النَّاسَ يَسْتَنُّونَ بِكُمْ  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9186","","عبد الله بن عباس عن عطاء بن أبي رباح عن ورقاء بن عمر عن ابن جريج عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9195","9187  -  حَدَّثَنَا  مُفَضَّلٌ ،  ثَنَا  عَلِيٌّ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ بْنُ صَالِحٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ، أَنَّ جُبَيْرَ بْنَ مُطْعِمٍ ،  حَدَّثَهُ  أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَدْخُلُ الْجَنَّةَ قَاطِعٌ  .         [9/81]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادِ بْنِ سَعْدٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  "" .","","Al-Mu'jam al-Awsat 9187","","جبير بن مطعم بن عدي النوفلي عن محمد بن جبير بن مطعم النوفلي عن الزهري عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9196","9188  -  وَبِهِ  :  حَدَّثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ بْنُ صَالِحٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ .  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  أَلَا أُرِيكُمْ كَيْفَ رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَوَضَّأُ ؟  فَأَخَذَ الْمَاءَ بِإِحْدَى يَدَيْهِ ، فَاسْتَنْشَقَ ، ثُمَّ جَمَعَ إِلَيْهَا الْأُخْرَى فَأَفْرَغَ فَأَفَاضَ عَلَى وَجْهِهِ ، وَغَسَلَ يَدَيْهِ ، ثُمَّ مَسَحَ بِرَأْسِهِ وَأُذُنَيْهِ ، ثُمَّ مَسَحَ عَلَى ظُهُورِ قَدَمَيْهِ فَوْقَ النَّعْلِ ، ثُمَّ قَامَ فَصَلَّى "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادِ بْنِ سَعْدٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9188","","عبد الله بن عباس عن عطاء بن يسار الهلالي عن زيد بن أسلم عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9197","9189  -  وَبِهِ  :  حَدَّثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  حَدَّثَنِي  يُونُسُ بْنُ خَبَّابٍ الْكُوفِيُّ ، قَالَ :  سَمِعْتُ  أَبَا عُبَيْدَةَ بْنَ عَبْدِ اللهِ بْنِ مَسْعُودٍ ، يَذْكُرُ  أَنَّهُ سَمِعَ  عَبْدَ اللهِ بْنَ مَسْعُودٍ  ، يَقُولُ :  إِنَّهُ كَانَ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ إِلَى  مَكَّةَ  ، وَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ إِذَا خَرَجَ إِلَى الْغَائِطِ  أَبْعَدَ  حَتَّى لَا يَرَاهُ أَحَدٌ ، قَالَ : فَبَصُرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِشَجَرَتَيْنِ مُتَبَاعِدَتَيْنِ ، فَقَالَ :  يَا  ابْنَ مَسْعُودٍ  اذْهَبْ إِلَى هَاتَيْنِ الشَّجَرَتَيْنِ فَقُلْ لَهُمَا : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَأْمُرُكُمَا أَنْ تَجْتَمِعَا لَهُ لِيَتَوَارَى بِكُمَا  فَمَشَتْ إِحْدَاهُمَا إِلَى الْأُخْرَى ، فَقَضَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَاجَتَهُ ، ثُمَّ رَجَعَتَا إِلَى مَكَانِهِمَا .  فَمَضَى حَتَّى أَتَيْنَا أَزِقَّةَ  الْمَدِينَةِ  ، فَجَاءَ بَعِيرٌ يَشْتَدُّ حَتَّى سَجَدَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ قَامَ بَيْنَ يَدَيْهِ تَذْرِفُ عَيْنَاهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" مَنْ صَاحِبُ هَذَا الْبَعِيرِ ؟ "" قَالُوا :  فُلَانٌ  ، فَقَالَ : "" ادْعُوهُ لِي "" ، فَأَتَوْا بِهِ ، فَقَالَ لَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" مَا شَأْنُكَ وَهَذَا الْبَعِيرُ يَشْكُوكَ ؟ "" فَقَالَ : يَا رَسُولَ اللهِ ، هَذَا الْبَعِيرُ كُنَّا  نَسْنُو  عَلَيْهِ مُنْذُ عِشْرِينَ سَنَةً ، ثُمَّ أَرَدْنَا نَحْرَهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" شَكَا ذَلِكَ ، بِئْسَمَا جَازَيْتُمُوهُ ، اسْتَعْمَلْتُمُوهُ عِشْرِينَ سَنَةً حَتَّى إِذَا رَقَّ عَظْمُهُ وَرَقَّ جِلْدُهُ أَرَدْتُمْ نَحْرَهُ ، بِعْنِيهِ "" قَالُوا :         [9/82]      بَلْ هُوَ لَكَ يَا رَسُولَ اللهِ ، فَأَمَرَ بِهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَجَّهَ بِهِ مَعَ الظَّهْرِ ، فَقَالَ لَهُ أَصْحَابُهُ : يَا رَسُولَ اللهِ سَجَدَ لَكَ هَذَا الْبَعِيرُ وَنَحْنُ أَحَقُّ بِالسُّجُودِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" مَعَاذَ اللهِ أَنْ يَسْجُدَ أَحَدٌ لِأَحَدٍ ، لَوْ سَجَدَ أَحَدٌ لِأَحَدٍ لَأَمَرْتُ الْمَرْأَةَ أَنْ تَسْجُدَ لِزَوْجِهَا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادِ بْنِ سَعْدٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9189","","عبد الله بن مسعود عن أبو عبيدة بن عبد الله بن مسعود عن يونس بن خباب الأسيدي عن أبو الزبير المكي عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9198","9190  -  حَدَّثَنَا  مُفَضَّلٌ ،  نَا  عَلِيُّ بْنُ زِيَادٍ اللَّحْجِيُّ ،  ثَنَا  أَبُو قُرَّةَ مُوسَى بْنُ طَارِقٍ ، قَالَ :  ذَكَرَ  زَمْعَةُ بْنُ صَالِحٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِي صَالِحٍ  . عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ اللهِ قَالَ :  إِنْ ذَكَرَنِي عَبْدِي وَحْدَهُ ذَكَرْتُهُ وَحْدِي ، وَإِنْ ذَكَرَنِي فِي مَلَإٍ ذَكَرْتُهُ فِي مَلَإٍ مِنَ الْمَلَائِكَةِ  ، وَإِنْ أَقْبَلَ إِلَيَّ يَمْشِي أَقْبَلْتُ إِلَيْهِ أُهَرْوِلُ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادِ بْنِ سَعْدٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9190","","أبو هريرة الدوسي عن ذكوان السمان عن زيد بن أسلم عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9199","9191  -  وَبِهِ  :  حَدَّثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ بْنُ صَالِحٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مَالِكِ بْنِ أَوْسِ بْنِ الْحَدَثَانِ ،  عَنْ  عُمَرَ بْنِ الْخَطَّابِ ، أَنَّهُ قَالَ :  إِنَّ اللهَ خَصَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ هَذَا  الْفَيْءِ  بِشَيْءٍ لَمْ يُعْطِهِ أَحَدًا غَيْرَهُ  ، قَالَ اللهُ تَعَالَى :         {      وَمَا أَفَاءَ اللهُ عَلَى رَسُولِهِ مِنْهُمْ فَمَا أَوْجَفْتُمْ عَلَيْهِ مِنْ خَيْلٍ وَلا رِكَابٍ         }      الْآيَةَ ، فَكَانَتْ هَذِهِ خَالِصَةً لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَاللهِ مَا اخْتَارَهَا دُونَكُمْ ، وَلَا  اسْتَأْثَرَ  بِهَا عَلَيْكُمْ ، لَقَدْ أَعْطَاكُمُوهَا حَتَّى بَقِيَ مِنْهَا هَذَا الْمَالُ الَّذِي بَقِيَ مِنْهَا ، قَالَ : وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُنْفِقُ عَلَى أَهْلِهِ نَفَقَةَ سَنَتِهِمْ مِنْ هَذَا الْمَالِ ، ثُمَّ يَأْخُذُ مَا بَقِيَ فَيَجْعَلُهُ مَجْعَلَ مَالِ اللهِ ، فَعَمِلَ بِذَلِكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَيَاتَهُ حَتَّى تُوُفِّيَ "" ، ثُمَّ قَالَ  عُمَرُ  بَعْدَ ذَلِكَ لِعُثْمَانَ وَعَبْدِ الرَّحْمَنِ وَالزُّبَيْرِ         [9/83]      وَسَعْدٍ ، وَهُمْ عِنْدَهُ : أَنْشُدُكُمَا بِاللهِ هَلْ تَعْلَمَانِ ذَلِكَ ؟ قَالَا : نَعَمْ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9191","","سعد بن أبي وقاص عن مالك بن أوس بن الحدثان النصري عن الزهري عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9200","9192  -  حَدَّثَنَا  مُفَضَّلُ بْنُ مُحَمَّدٍ الْجَنَدِيُّ ،  ثَنَا  عَلِيُّ بْنُ زِيَادٍ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ، أَنَّ أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ ،  حَدَّثَهُ  ، أَنَّهُ ،  سَمِعَ  أَبَا هُرَيْرَةَ ، يَقُولُ :  أُقِيمَتِ الصَّلَاةُ ، فَقُمْنَا فَعَدَّلْنَا الصُّفُوفَ قَبْلَ أَنْ يَخْرُجَ إِلَيْنَا رَسُولُ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادِ بْنِ سَعْدٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9192","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9201","9193  -  وَبِهِ  :  حَدَّثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ  الْبِرُّ  الصِّيَامَ فِي السَّفَرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9193","","كعب بن عاصم الأشعري عن أبو الدرداء عن صفوان عن الزهري عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9202","9194  -  حَدَّثَنَا  مُفَضَّلٌ ،  ثَنَا  أَبُو حُمَةَ ،  ثَنَا  أَبُو قُرَّةَ ،  عَنْ  زَمْعَةَ بْنِ صَالِحٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبَانَ .  عَنْ  أَنَسٍ ، قَالَ :  كُنَّا إِذَا رَفَعْنَا رُؤُوسَنَا مِنَ الرُّكُوعِ لَمْ يَضَعْ أَحَدٌ مِنَّا رَأْسَهُ حَتَّى نَرَى رَسُولَ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَاجِدًا "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9194","","أنس بن مالك عن أبان بن أبي عياش عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9203","9195  -  حَدَّثَنَا  مُفَضَّلٌ ،  نَا  أَبُو حُمَةَ ،  نَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبَانَ ،  حَدَّثَنِي  أَنَسٌ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ :  إِذَا نُودِيَ بِالصَّلَاةِ أَدْبَرَ الشَّيْطَانُ فِيمَا بَيْنَهُ وَبَيْنَ  الرَّوْحَاءِ  حَتَّى لَا يَسْمَعَ صَوْتَ التَّأْذِينِ  ، وَفُتِحَتْ أَبْوَابُ السَّمَاءِ وَأَبْوَابُ الْجِنَانِ ، وَاسْتُجِيبَ الدُّعَاءُ  .         [9/84]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9195","","أنس بن مالك عن أبان بن أبي عياش عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9204","9196  -  حَدَّثَنَا  مُفَضَّلٌ ،  ثَنَا  أَبُو حُمَةَ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ، قَالَ :  سَمِعْتُ  أَبِي  يُحَدِّثُ ، عَنْ  عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُوا الزَّيْتَ وَادَّهِنُوا بِهِ ؛ فَإِنَّهُ يَخْرُجُ مِنْ شَجَرَةٍ مُبَارَكَةٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9196","","عمر بن الخطاب عن أسلم العدوي مولى عمر بن الخطاب عن زيد بن أسلم عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9205","9197  -  وَبِهِ  :  حَدَّثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرًا ، يَقُولُ :  نَحَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ الْحُدَيْبِيَةِ  سَبْعِينَ نَاقَةً  ، شَرَّكَ بَيْنَ كُلِّ سَبْعَةٍ فِي جَزُورٍ  .","","Al-Mu'jam al-Awsat 9197","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9206","9198  -  حَدَّثَنَا  مُفَضَّلٌ ،  نَا  عَلِيُّ بْنُ زِيَادٍ اللَّحْجِيُّ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرًا ، يَقُولُ :  حَلَقَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْحُدَيْبِيَةِ  ، فَحَلَقَ نَاسٌ كَثِيرٌ مِنْ أَصْحَابِهِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَرْحَمُ اللهُ  الْمُحَلِّقِينَ  ، فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ وَالْمُقَصِّرِينَ ، فَقَالَ : "" رَحِمَ اللهُ  الْمُحَلِّقِينَ  "" ، قَالَ فِي الثَّالِثَةِ : "" وَالْمُقَصِّرِينَ  .","","Al-Mu'jam al-Awsat 9198","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9207","9199  -  وَبِهِ  : قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَذْكُرُ  الْمَسِيحَ الدَّجَّالَ  :  إِنِّي سَأَقُولُ لَكُمْ فِيهِ كَلِمَةً مَا قَالَهَا نَبِيٌّ قَبْلِي : إِنَّهُ  أَعْوَرٌ  ، وَلَيْسَ اللهُ  بِأَعْوَرَ  ، بَيْنَ عَيْنَيْهِ كِتَابٌ : كَافِرٌ "" - قَالَ  جَابِرٌ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" يَقْرَأُهُ كُلُّ مُؤْمِنٍ كَاتِبٍ وَغَيْرِ كَاتِبٍ ،         [9/85]      يَسِيحُ فِي الْأَرْضِ أَرْبَعِينَ يَوْمًا ، يَرِدُ كُلَّ بَلَدٍ غَيْرَ هَاتَيْنِ :  الْمَدِينَةِ  وَمَكَّةَ  ، حَرَّمَهُمَا اللهُ عَلَيْهِ ، يَوْمٌ مِنْ أَيَّامِهِ كَالسَّنَةِ ، وَيَوْمٌ كَالشَّهْرِ ، وَيَوْمٌ كَالْجُمُعَةِ ، ثُمَّ بَقِيَّةُ أَيَّامِهِ كَأَيَّامِكُمْ هَذِهِ ، لَا يَبْقَى إِلَّا أَرْبَعِينَ يَوْمًا "" .","","Al-Mu'jam al-Awsat 9199","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9208","9200  -  وَبِهِ  : قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ ، يَقُولُ :  اسْتَأْذَنَتْ  أُمُّ سَلَمَةَ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْحِجَامَةِ ، فَأَذِنَ لَهَا  ، فَأَرْسَلَتْ إِلَى  أُمٍّ لَهَا مِنَ الرَّضَاعَةِ  ، فَحَجَمَتْهَا  .","","Al-Mu'jam al-Awsat 9200","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9209","9201  -  وَبِهِ  : قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنْ عَبْدٍ إِلَّا عَلَى رَأْسِهِ حَرِيرَةٌ مُعَقَّدَةٌ ، فَإِذَا اسْتَيْقَظَ فَحَمِدَ اللهَ  ، وَقَامَ فَتَوَضَّأَ فَيُصَلِّي ، حُلَّتِ الْعُقَدُ ، وَإِنِ اسْتَيْقَظَ وَلَمْ يَحْمَدِ اللهَ ، قَالَ لَهُ الشَّيْطَانُ : عَلَيْكَ لَيْلٌ طَوِيلٌ ، ارْقُدْ ، فَيَعْقِدُ الشَّيْطَانُ عَلَيْهِ الْحَرِيرَ  .","","Al-Mu'jam al-Awsat 9201","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9210","9202  -  حَدَّثَنَا  مُفَضَّلٌ ،  نَا  أَبُو حُمَةَ ،  ثَنَا  أَبُو قُرَّةَ ،  عَنْ  زَمْعَةَ بْنِ صَالِحٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  أَنَّهُ سَمِعَ  جَابِرَ بْنَ عَبْدِ اللهِ ، يَقُولُ :  بَعَثَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَعَ  أَبِي عُبَيْدَةَ بْنِ الْجَرَّاحِ  ، وَنَحْنُ سِتُّمِائَةِ رَجُلٍ وَبِضْعَةَ عَشَرَ رَجُلًا ، نَتَلَقَّى  عِيرَ  قُرَيْشٍ  ، فَمَا وَجَدَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ زَادٍ إِلَّا جِرَابًا مِنْ تَمْرٍ ، فَكَانَ يُعْطِينَا تَمْرَةً تَمْرَةً كُلَّ يَوْمٍ ، نَمُصُّهَا وَنَشْرَبُ عَلَيْهَا مِنَ الْمَاءِ ، فَوَجَدْنَا فَقْدَهَا حِينَ فَنِيَتْ ، ثُمَّ أَقْبَلْنَا عَلَى الْخَبَطِ  نَخْبِطُهُ  بِعِصِيِّنَا ، ثُمَّ نَسْتَفُّهُ وَنَشْرَبُ عَلَيْهِ الْمَاءَ ، حَتَّى سُمِّينَا جَيْشَ  الْخَبَطِ  ، فَمَرَرْنَا بِسَاحِلِ الْبَحْرِ ، فَرَمَى الْبَحْرُ لَنَا بِدَابَّةٍ ، يُقَالُ لَهَا :  الْعَنْبَرُ  ، مِثْلُ الْكَثِيبِ ، فَقَالَ  أَبُو عُبَيْدَةَ  : مَيْتَةٌ لَا يَحِلُّ لَنَا ، ثُمَّ قَالَ بَعْدُ : بَلْ نَحْنُ فِي  سَبِيلِ  اللهِ ،         [9/86]      وَنَحْنُ مُضْطَرُّونَ ، فَأَكَلْنَا مِنْهَا نَحْوًا مِنْ نِصْفِ شَهْرٍ وَزِيَادَةٍ ، وَوَشَقْنَا وَشْقًا كَثِيرًا ، فَكُنَّا نَغْرِفُ مِنْ مَوْضِعِ عَيْنِهَا  الْوَدَكَ  بِالْجِرِارِ حَتَّى أَنْجَزْنَاهُ ، ثُمَّ جَلَسَ فِي مَوْضِعِ عَيْنِهَا ثَلَاثَةَ عَشَرَ رَجُلًا مِنَّا ، ثُمَّ أَخَذَ  أَبُو عُبَيْدَةَ  ضِلَعًا مِنْ أَضْلَاعِهِ ، فَأَقَامَهُ عَلَى طَرَفَيْهِ ، وَأَمَرَ بِأَطْوَلِ بَعِيرٍ فِي الرَّكْبِ فَرَحَلَهُ ، فَرَكِبَ عَلَيْهِ  رَجُلٌ  ، فَأَجَازَ تَحْتَهُ مَا مَسَّ رَأْسَهُ ، فَقَدِمْنَا عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  هَلْ مَعَكُمْ مِنْهُ شَيْءٌ ؟ "" فَقُلْنَا : نَعَمْ ، فَقَالَ : "" أَطْعِمُونَا مِنْهُ  فَأَرْسَلْنَا إِلَيْهِ  وَشِيقَةً  ، فَأَكَلَ مِنْهَا .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنْ  زِيَادِ بْنِ سَعْدٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهَا  أَبُو قُرَّةَ  "" .","","Al-Mu'jam al-Awsat 9202","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9211","9203  -  حَدَّثَنَا  مُفَضَّلٌ ،  ثَنَا  عَلِيٌّ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  نَافِعٍ ، مَوْلَى أَبِي قَتَادَةَ  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  كَيْفَ بِكُمْ إِذَا نَزَلَ  ابْنُ مَرْيَمَ  وَإِمَامُكُمْ مِنْكُمْ  ؟  .  لَمْ يَرْوِهِ عَنْ  زِيَادٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9203","","أبو هريرة الدوسي عن نافع بن عباس الأقرع عن الزهري عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9212","9204  -  حَدَّثَنَا  مُفَضَّلُ بْنُ مُحَمَّدٍ ،  ثَنَا  عَلِيُّ بْنُ زِيَادٍ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ، عَنْ هِنْدِ بِنْتِ الْحَارِثِ ،  حَدَّثَتْهُ  عَنْ  أُمِّ سَلَمَةَ ، زَوْجِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  :  اسْتَيْقَظَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ لَيْلَةٍ وَهُوَ يَقُولُ :  سُبْحَانَ اللهِ ، مَاذَا أُنْزِلَ مِنَ الْخَزَائِنِ ؟ وَمَاذَا أُنْزِلَ مِنَ الْفِتْنَةِ ؟  مَنْ يُوقِظُ صَوَاحِبَ الْحُجُرَاتِ ؟ رُبَّ  كَاسِيَةٍ  فِي الدُّنْيَا عَارِيَةٌ فِي الْآخِرَةِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادِ بْنِ سَعْدٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهِ  أَبُو قُرَّةَ  .  كذا في طبعة دار الحرمين ، وقد أشار محقق طبعة دار الحرمين إلى كونها كذلك بالمخطوط وهي كذلك في طبعة الطحان ، والصواب : ( قالت )","","Al-Mu'jam al-Awsat 9204","","هند بنت أبي أمية زوج رسول الله عن هند بنت الحارث الفراسية عن الزهري عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9213","9205  -  حَدَّثَنَا  مُفَضَّلٌ ،  نَا  عَلِيُّ بْنُ زِيَادٍ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ بْنُ صَالِحٍ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ         [9/87]      أَنَّ أُمَّهُ أُمَّ كُلْثُومٍ بِنْتَ عُقْبَةَ بْنِ أَبِي مُعَيْطٍ ،  أَخْبَرَتْهُ  أَنَّهَا سَمِعَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَيْسَ الْكَاذِبُ الَّذِي يُصْلِحُ بَيْنَ النَّاسِ ، فَيَقُولُ خَيْرًا أَوْ يَنْمِي خَيْرًا  ، قَالَتْ : وَلَمْ أَسْمَعْهُ يُرَخِّصُ فِي شَيْءٍ مِمَّا يَقُولُ النَّاسُ  كَذِبًا  إِلَّا فِي ثَلَاثٍ : "" فِي الْحَرْبِ ، وَفِي الْإِصْلَاحِ ، وَفِي حَدِيثِ الرَّجُلِ امْرَأَتَهُ  .","","Al-Mu'jam al-Awsat 9205","","أم كلثوم بنت عقبة بن أبي معيط عن حميد بن عبد الرحمن القرشي عن الزهري عن يعقوب بن عطاء بن أبي رباح المكي عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9214","9206  -  حَدَّثَنَا  مُفَضَّلُ بْنُ مُحَمَّدٍ ،  ثَنَا  عَلِيُّ بْنُ زِيَادٍ ،  نَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  أَبُو بَكْرِ بْنُ حَزْمٍ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  دَخَلَتْ عَلَيَّ امْرَأَةٌ مَعَهَا ابْنَانِ لَهَا ، فَلَمْ أَجِدْ لَهَا شَيْئًا إِلَّا تَمْرَةً ، فَأَعْطَيْتُهَا إِيَّاهَا  ، فَقَسَمَتْهَا بَيْنَهُمَا  "" .","","Al-Mu'jam al-Awsat 9206","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن أبو بكر بن محمد الخزرجي عن الزهري عن يعقوب بن عطاء بن أبي رباح المكي عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9215","9207  -  وَبِهِ  : قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي إِدْرِيسَ ، أَنَّ أَبَا ثَعْلَبَةَ الْخُشَنِيَّ  أَخْبَرَهُ  أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  نَهَى عَنْ كُلِّ ذِي نَابٍ مِنَ  السِّبَاعِ  .","","Al-Mu'jam al-Awsat 9207","","أبو ثعلبة الخشني عن عائذ الله بن عبد الله الخولاني عن الزهري عن يعقوب بن عطاء بن أبي رباح المكي عن زمعة بن صالح الجندي عن أبو قرة الصيداوي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9216","9208  -  وَبِهِ  ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنْ  نَافِعٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ وَقَفَ بَيْنَ الْجَمْرَتَيْنِ  فِي الْحَجَّةِ الَّتِي حَجَّ ، وَذَلِكَ يَوْمَ النَّحْرِ  ، فَقَالَ :  هَذَا يَوْمُ  الْحَجِّ  الْأَكْبَرِ  .","","Al-Mu'jam al-Awsat 9208","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن يعقوب بن عطاء بن أبي رباح المكي عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9217","9209  -  وَبِهِ  ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  اشْتِمَالِ  الصَّمَّاءِ  ، وَأَنْ يَحْتَبِيَ الرَّجُلُ فِي ثَوْبٍ وَاحِدٍ ،  لَيْسَ عَلَى فَرْجِهِ مِنْهُ شَيْءٌ "" .","","Al-Mu'jam al-Awsat 9209","","أبو سعيد الخدري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن يعقوب بن عطاء بن أبي رباح المكي عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9218","9210  -  وَبِهِ  ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي سَلَمَةَ         [9/88]      أَنَّهُ سَمِعَ  أَبَا هُرَيْرَةَ ، يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَطَاعَنِي فَقَدْ أَطَاعَ اللهَ ، وَمَنْ عَصَانِي فَقَدْ عَصَى اللهَ  ، وَمَنْ أَطَاعَ أَمِيرِي فَقَدْ أَطَاعَنِي ، وَمَنْ عَصَى أَمِيرِي فَقَدْ عَصَانِي  .","","Al-Mu'jam al-Awsat 9210","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن الزهري عن يعقوب بن عطاء بن أبي رباح المكي عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9219","9211  -  حَدَّثَنَا  مُفَضَّلُ بْنُ مُحَمَّدٍ ،  ثَنَا  أَبُو حُمَةَ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ هِشَامٍ ،  عَنْ  عَائِشَةَ ، أَنَّهَا قَالَتْ - وَذَكَرَتْ  زَيْنَبَ بِنْتَ جَحْشٍ  زَوْجَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَتْ :  وَلَمْ أَكُنْ رَأَيْتُ امْرَأَةً قَطُّ خَيْرًا فِي الدِّينِ مِنْ  زَيْنَبَ  ، أَتْقَى لِلهِ ، وَأَصْدَقَ حَدِيثًا  ، وَأَوْصَلَ لِلرَّحِمِ ، وَأَعْظَمَ صَدَقَةً ، وَأَشَدَّ ابْتِذَالًا لِنَفْسِهَا فِي الْعَمَلِ الَّذِي يُتَصَدَّقُ بِهِ ، وَيُتَقَرَّبُ بِهِ إِلَى اللهِ  "" .","","Al-Mu'jam al-Awsat 9211","","عائشة بنت أبي بكر الصديق عن محمد بن عبد الرحمن بن الحارث المخزومي عن الزهري عن يعقوب بن عطاء بن أبي رباح المكي عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9220","9212  -  حَدَّثَنَا  مُفَضَّلٌ ،  ثَنَا  عَلِيُّ بْنُ زِيَادٍ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ قَيْسٍ بِنْتِ مِحْصَنٍ ، وَكَانَتْ مِنَ الْمُهَاجِرَاتِ الْأُوَلِ اللَّائِي بَايَعْنَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهِيَ أُخْتُ  عُكَّاشَةَ بْنِ مِحْصَنٍ  ،  أَخْبَرَتْهُ  ،  أَنَّهَا أَتَتْ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِابْنٍ لَهَا لَمْ يَبْلُغْ أَنْ يَأْكُلَ الطَّعَامَ ، فَأَخْبَرَتْهُ "" أَنَّ  ابْنَهَا  بَالَ فِي حِجْرِ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَدَعَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمَاءٍ ،  فَنَضَحَ  عَلَى بَوْلِهِ ، وَلَمْ يَغْسِلْهُ غَسْلًا "" .","","Al-Mu'jam al-Awsat 9212","","أم قيس بنت محصن ، ويقال عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن يعقوب بن عطاء بن أبي رباح المكي عن زمعة بن صالح الجندي عن أبو قرة الصيداوي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9221","9213  -  حَدَّثَنَا  مُفَضَّلٌ ،  ثَنَا  عَلِيُّ بْنُ زِيَادٍ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  زَمْعَةُ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ  سَعْدَ بْنَ عُبَادَةَ  ، اسْتَفْتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي نَذْرٍ كَانَ عَلَى أُمِّهِ أَنْ يَقْضِيَهُ  ، "" فَأَمَرَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَقْضِيَ عَنْهَا "" .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ  إِلَّا  زَمْعَةُ  ،  تَفَرَّدَ بِهَا  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9213","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن يعقوب بن عطاء بن أبي رباح المكي عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9222","9214  -  حَدَّثَنَا  مُفَضَّلٌ ،  نَا  أَبُو حُمَةَ ،  نَا  أَبُو قُرَّةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  ابْنِ         [9/89]      الْحُوَيْرِثِ ،  عَنْ  نُعَيْمٍ الْمُجْمِرِ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أُمَّتِي  الْغُرُّ  الْمُحَجَّلُونَ  يَوْمَ الْقِيَامَةِ  فَمَنِ اسْتَطَاعَ أَنْ يُحَسِّنَ غُرَّتَهُ فَلْيَفْعَلْ .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9214","","أبو هريرة الدوسي عن نعيم بن عبد الله المجمر عن سعيد بن الحويرث المكي عن ابن جريج عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9223","9215  -  حَدَّثَنَا  مُفَضَّلٌ ،  ثَنَا  أَبُو حُمَةَ ،  ثَنَا  أَبُو قُرَّةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  أَبُو قَزَعَةَ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَوْهَبَ وَضُوءًا ، فَقِيلَ لَهُ : لَمْ نَجِدْ ذَلِكَ إِلَّا فِي  مَسْكِ  مَيْتَةٍ ، فَقَالَ :  أَدَبَغْتُمُوهُ ؟ "" قَالُوا : نَعَمْ ، قَالَ : "" فَهَلُمَّ ؛ فَإِنَّ ذَلِكَ طُهُورُهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9215","","أنس بن مالك عن سويد بن حجير الباهلي عن ابن جريج عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9224","9216  -  وَبِهِ  حَدَّثَنَا  أَبُو قُرَّةَ ،  عَنِ  ابْنِ جُرَيْجٍ ، عَنْ أَبِي خَالِدٍ ،  أَنَّهُ أَخْبَرَهُ  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ أَبِي جُحَيْفَةَ  ، قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْأَبْطَحِ  ، "" وَكَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  قُبَّةٍ  مِنْ أَدَمٍ  ، فَتَوَضَّأَ فِي  تَوْرٍ  مِنْ حِجَارَةٍ ، فَخَرَجَ  بِلَالٌ  بِفَضْلِهِ ، فَصَلَّى الظُّهْرَ وَالْعَصْرَ ، يَمُرُّ بَيْنَ يَدَيْهِ الرَّجُلُ وَالْمَرْأَةُ ، وَالْحِمَارُ مِنْ وَرَاءِ الْحَرْبَةِ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو قُرَّةَ  .  وَأَبُو خَالِدٍ  الَّذِي رَوَى عَنْهُ  ابْنُ جُرَيْجٍ  هَذَا الْحَدِيثَ هُوَ :  الدَّالَانِيُّ  .","","Al-Mu'jam al-Awsat 9216","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أبو خالد الدالاني عن ابن جريج عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9225","9217  -  حَدَّثَنَا  مُفَضَّلٌ ،  نَا  عَلِيُّ بْنُ زِيَادٍ ،  ثَنَا  أَبُو قُرَّةَ ، قَالَ :  ذَكَرَ  ابْنُ جُرَيْجٍ ، عَنْ قَيْسٍ ،  أَنَّهُ أَخْبَرَهُ  ، عَنْ أَبِي إِسْحَاقَ ،  أَنَّهُ سَمِعَهُ  يَقُولُ :  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ أَبِي سُفْيَانَ         [9/90]      أَنَّهُ سَمِعَ  أُبَيَّ بْنَ كَعْبٍ ، يُخْبِرُ ،  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَنَّهُ تَفَقَّدَ رِجَالًا فِي الصُّبْحِ ، فَقَالَ : "" أَيْنَ فُلَانٌ ؟ وَأَيْنَ فُلَانٌ ؟ "" قَالَ :  مَا مِنْ صَلَاةٍ أَثْقَلُ عَلَى الْمُنَافِقِ مِنْ صَلَاةِ الْعِشَاءِ وَالصُّبْحِ  ، وَلَوْ يَعْلَمُونَ مَا فِيهِمَا لَأَتَوْهُمَا وَلَوْ  حَبْوًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو قُرَّةَ  .  وَقَيْسٌ  الَّذِي رَوَى عَنْهُ  ابْنُ جُرَيْجٍ  هَذَا الْحَدِيثَ هُوَ :  قَيْسُ بْنُ الرَّبِيعِ  .","","Al-Mu'jam al-Awsat 9217","","أبي بن كعب عن عبد الله بن أبي سفيان الهاشمي عن أبو إسحاق السبيعي عن قيس بن الربيع الأسدي عن ابن جريج عن أبو قرة الصيداوي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9226","9218  -  حَدَّثَنَا  مُفَضَّلٌ ،  نَا  أَبُو حُمَةَ ،  ثَنَا  أَبُو قُرَّةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  يَحْيَى ،  عَنْ  أَنَسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَخَفَّ النَّاسِ صَلَاةً فِي تَمَامٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو قُرَّةَ  .  وَيَحْيَى  الَّذِي رَوَى عَنْهُ  ابْنُ جُرَيْجٍ  هَذَا الْحَدِيثَ هُوَ :  يَحْيَى بْنُ سَعِيدٍ الْأَنْصَارِيُّ  .","","Al-Mu'jam al-Awsat 9218","","أنس بن مالك عن يحيى بن سعيد الأنصاري عن ابن جريج عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9227","9219  -  حَدَّثَنَا  مُفَضَّلُ بْنُ مُحَمَّدٍ ،  ثَنَا  أَبُو حُمَةَ ،  ثَنَا  أَبُو قُرَّةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مَعْبَدِ بْنِ كَعْبِ بْنِ مَالِكٍ ،  عَنْ  أَخِيهِ عَبْدِ اللهِ بْنِ كَعْبٍ  ، قَالَ :  سَمِعْتُ  أَبَا أُمَامَةَ ، صَاحِبَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنِ اقْتَطَعَ حَقَّ امْرِئٍ         [9/91]      مُسْلِمٍ بِيَمِينِهِ فَقَدْ أَوْجَبَ اللهُ لَهُ النَّارَ  ، وَحَرَّمَ عَلَيْهِ الْجَنَّةَ "" ، فَقَالَ  رَجُلٌ  : وَإِنْ شَيْئًا يَسِيرًا يَا رَسُولَ اللهِ ؟ قَالَ : "" وَإِنْ كَانَ قَضِيبًا مِنْ أَرَاكٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو قُرَّةَ  .","","Al-Mu'jam al-Awsat 9219","","أبو أمامة البلوي عن عبد الله بن كعب بن مالك عن معبد بن كعب بن مالك الأنصاري عن العلاء بن عبد الرحمن الحرقي عن ابن جريج عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9228","9220  -  حَدَّثَنَا  مُفَضَّلُ بْنُ مُحَمَّدٍ ،  ثَنَا  أَبُو حُمَةَ ،  ثَنَا  أَبُو قُرَّةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  أَخْبَرَنِي  إِسْمَاعِيلُ بْنُ أُمَيَّةَ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  خَدَمْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَشْرَ سِنِينَ  ، مَا قَالَ لِي فِي شَيْءٍ فَعَلْتُهُ : لِمَ فَعَلْتَهُ ؟ وَلِشَيْءٍ لَمْ أَفْعَلْهُ : لِمَ لَمْ تَفْعَلْهُ ؟ "" .  قَالَ : وَزَادَنِي فِيهِ  مَعْمَرٌ  : "" فِي شَيْءٍ قَطُّ "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَبُو قُرَّةَ  وَعَبْدُ الْمَجِيدِ بْنُ أَبِي رَوَّادٍ  .","","Al-Mu'jam al-Awsat 9220","","أنس بن مالك عن عبد العزيز بن صهيب البناني عن إسماعيل بن أمية الأموي عن ابن جريج عن موسى بن طارق الزبيدي عن محمد بن يوسف الزبيدي صاحب أبي قرة عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مفضل بن محمد الجندي"
"9229","[9/92]      9221  - بَابُ النُّونِ  مَنِ اسْمُهُ : نَصْرٌ  حَدَّثَنَا  نَصْرُ بْنُ عَبْدِ الْمَلِكِ السِّنْجَارِيُّ ،  ثَنَا  مَعْمَرُ بْنُ مُحَمَّدِ بْنِ عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  حَدَّثَنِي  أَبِي مُحَمَّدُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  أَبِيهِ عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  عَنْ  سَلْمَى - امْرَأَةِ أَبِي رَافِعٍ  - قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوْقَ بَيْتِهِ جَالِسًا ، فَقَالَ :  يَا  سَلْمَى  ، ائْتِينِي بِغَسْلٍ  ، فَجِئْتُ إِلَيْهِ بِإِنَاءٍ فِيهِ مَاءُ  سِدْرٍ  ، فَصَفَّيْتُهُ لَهُ ثُمَّ  جَثَا  عَلَى مِرْفَقَةٍ حَشْوُهَا لِيفٌ ، وَأَنَا أَصُبُّ عَلَى رَأْسِهِ فَغَسَلَهُ ، وَإِنِّي لَأَنْظُرُ إِلَى كُلِّ قَطْرَةٍ تَقْطُرُ مِنْ رَأْسِهِ فِي الْإِنَاءِ ، كَأَنَّهُ الدُّرُّ يَلْمَعُ ، ثُمَّ جِئْتُهُ بِمَاءٍ فَغَسَلَهُ ، فَلَمَّا فَرَغَ مِنْ غَسْلِهِ قَالَ : "" يَا  سَلْمَى  ، اهْرِيقِي مَا فِي الْإِنَاءِ فِي مَوْضِعٍ لَا  يَتَخَطَّاهُ  أَحَدٌ "" ، فَأَخَذْتُ الْإِنَاءَ فَشَرِبْتُ بَعْضَهُ ، ثُمَّ أَهْرَقْتُ الْبَاقِيَ ، فَقَالَ لِي : "" مَاذَا صَنَعْتِ بِمَا فِي الْإِنَاءِ ؟ "" قُلْتُ : يَا رَسُولَ اللهِ  حَسَدْتُ  الْأَرْضَ عَلَيْهِ ، فَشَرِبْتُ بَعْضَهُ ، ثُمَّ أَهْرَقْتُ الْبَاقِيَ عَلَى الْأَرْضِ ، فَقَالَ : "" اذْهَبِي ، فَقَدْ حَرَّمَكِ اللهُ بِذَلِكَ عَلَى النَّارِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  سَلْمَى  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  مَعْمَرُ بْنُ مُحَمَّدٍ  .","","Al-Mu'jam al-Awsat 9221","","سلمى مولاة رسول الله عن عبيد الله بن أبي رافع مولى رسول الله عن محمد بن عبيد الله بن أبي رافع عن معمر بن محمد بن عبيد الله الهاشمي عن نصر بن علي بن عبد الملك السنجاري عن الطبراني","نصر بن عبد الملك السنجاري"
"9230","9222  -  حَدَّثَنَا  نَصْرُ بْنُ عَبْدِ الْمَلِكِ ،  ثَنَا  مَعْمَرُ بْنُ مُحَمَّدِ بْنِ عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  حَدَّثَنِي  مُحَمَّدٌ ،  عَنْ  أَبِيهِ عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  عَنْ  أَبِيهِ أَبِي رَافِعٍ  ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا طَنَّتْ أُذُنُ أَحَدِكُمْ         [9/93]      فَلْيَذْكُرْنِي ، وَلْيُصَلِّ عَلَيَّ  ، وَلْيَقُلْ : ذَكَرَ اللهُ بِخَيْرٍ مَنْ ذَكَرَنِي  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي رَافِعٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  مَعْمَرُ بْنُ مُحَمَّدٍ  .","","Al-Mu'jam al-Awsat 9222","","أبو رافع القبطي عن عبيد الله بن أبي رافع مولى رسول الله عن محمد بن عبيد الله بن أبي رافع عن معمر بن محمد بن عبيد الله الهاشمي عن نصر بن علي بن عبد الملك السنجاري عن الطبراني","نصر بن عبد الملك السنجاري"
"9231","9223  -  حَدَّثَنَا  نَصْرُ بْنُ الْحَكَمِ الْمَرْوَزِيُّ ،  ثَنَا  عَلِيُّ بْنُ حُجْرٍ ،  ثَنَا  يَحْيَى بْنُ سَابِقٍ ،  نَا  أَبُو حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ السَّاعِدِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لِكُلِّ أُمَّةٍ مَجُوسٌ ، وَلِكُلِّ أُمَّةٍ نَصَارَى  ، وَلِكُلِّ أُمَّةٍ يَهُودٌ ، وَإِنَّ  مَجُوسَ  أُمَّتِي الْقَدَرِيَّةُ ، وَنَصَارَاهُمُ الْخَشَبِيَّةُ ، وَيَهُودُهُمُ الْمُرْجِئَةُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي حَازِمٍ  إِلَّا  يَحْيَى بْنُ سَابِقٍ  ،  تَفَرَّدَ بِهِ  عَلِيُّ بْنُ حُجْرٍ  .","","Al-Mu'jam al-Awsat 9223","","سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن يحيى بن سابق الكوفي عن علي بن حجر بن إياس عن نصر بن الحكم بن حامد الأحول عن الطبراني","نصر بن الحكم المروذي"
"9232","9224  -  حَدَّثَنَا  نَصْرُ بْنُ الْحَكَمِ الْمَرْوَزِيُّ ،  ثَنَا  عَلِيُّ بْنُ حُجْرٍ ،  ثَنَا  عَتَّابُ بْنُ بَشِيرٍ ،  عَنْ  خُصَيْفٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الذَّهَبُ بِالذَّهَبِ ، وَالْفِضَّةُ بِالْفِضَّةِ  ، مِثْلًا بِمِثْلٍ  .  لَمْ يُجَوِّدْ  إِسْنَادَ  هَذَا الْحَدِيثِ عَنْ  خُصَيْفٍ  إِلَّا  عَتَّابُ بْنُ بَشِيرٍ  .","","Al-Mu'jam al-Awsat 9224","","أبو سعيد الخدري عن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن خصيف الجزري عن عتاب بن بشير عن علي بن حجر بن إياس عن نصر بن الحكم بن حامد الأحول عن الطبراني","نصر بن الحكم المروذي"
"9233","9225  -  حَدَّثَنَا  نَصْرُ بْنُ الْحَكَمِ الْمَرْوَزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَسَّامٍ الْمَرْوَزِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْمَدَنِيُّ ،  نَا  نَافِعُ بْنُ أَبِي نُعَيْمٍ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِأَهْلِ الْمَدِينَةِ  :  اللَّهُمَّ بَارِكْ لَهُمْ فِي صَاعِهِمْ وَمُدِّهِمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعِ بْنِ أَبِي نُعَيْمٍ  إِلَّا  عَبْدُ اللهِ بْنُ جَعْفَرٍ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ بَسَّامٍ الْمَرْوَزِيُّ  .","","Al-Mu'jam al-Awsat 9225","","أبو هريرة الدوسي عن سعيد المقبري عن نافع بن عبد الرحمن بن أبي نعيم عن عبد الله بن جعفر بن نجيح عن محمد بن بسام المروزي عن نصر بن الحكم بن حامد الأحول عن الطبراني","نصر بن الحكم المروذي"
"9234","[9/94]      مَنِ اسْمُهُ : نُعَيْمٌ  9226  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ الصُّورِيُّ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِينِيُّ ،  نَا  ضَمْرَةُ بْنُ رَبِيعَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ شَوْذَبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْقَاسِمِ ،  عَنْ  كَثِيرٍ ، - مَوْلَى عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، قَالَ :  جَاءَ  عُثْمَانُ  حِينَ  جَهَّزَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَيْشَ  الْعُسْرَةِ  بِأَلْفِ دِينَارٍ فِي كُمِّهِ ، فَصَبَّهَا فِي حِجْرِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُدْخِلُ يَدَهُ فِيهَا فَيُقَلِّبُهَا ، وَيَقُولُ :  مَا ضَرَّ  ابْنَ عَفَّانَ  مَا عَمِلَ بَعْدَ الْيَوْمِ  قَالَهَا مَرَّتَيْنِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ شَوْذَبٍ  إِلَّا  ضَمْرَةُ  ، وَلَا يُرْوَى عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9226","","عبد الرحمن بن سمرة العبشمي عن كثير بن أبي كثير البصري عن عبد الله بن القاسم شيخ لعبد الله بن شوذب عن عبد الله بن شوذب عن ضمرة بن ربيعة الفلسطيني عن موسى بن أيوب النصيبي عن نعيم بن محمد الصوري عن الطبراني","نعيم بن محمد الصوري"
"9235","9227  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ ،  نَا  مَرْوَانُ بْنُ مُعَاوِيَةَ الْفَزَارِيُّ ،  عَنْ  مُغِيرَةَ بْنِ مُسْلِمٍ السَّرَّاجِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  مُعَاوِيَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ سَرَّهُ أَنْ يُسَبِّحَ لَهُ بَنُو آدَمَ قِيَامًا وَجَبَتْ لَهُ النَّارُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  إِلَّا  مُغِيرَةُ بْنُ مُسْلِمٍ  ،  تَفَرَّدَ بِهِ  مَرْوَانُ بْنُ مُعَاوِيَةَ  .","","Al-Mu'jam al-Awsat 9227","","معاوية بن أبي سفيان عن عبد الله بن بريدة عن المغيرة بن مسلم القسملي عن مروان بن معاوية الفزاري عن موسى بن أيوب النصيبي عن نعيم بن محمد عن الطبراني","نعيم بن محمد الصوري"
"9236","9228  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ الصُّورِيُّ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِينِيُّ ،  ثَنَا         [9/95]      مُحَمَّدُ بْنُ شُعَيْبِ بْنِ شَابُورَ ،  عَنْ  خَالِدِ بْنِ دِهْقَانَ ،  نَا  عَبْدُ اللهِ بْنُ أَبِي زَكَرِيَّا ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  أَبِي الدَّرْدَاءِ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  كُلُّ ذَنْبٍ عَسَى اللهُ أَنْ يَغْفِرَهُ ، إِلَّا مَنْ مَاتَ مُشْرِكًا  ، أَوْ مُؤْمِنًا قَتَلَ مُؤْمِنًا مُتَعَمِّدًا  .","","Al-Mu'jam al-Awsat 9228","","أبو الدرداء عن هجيمة الأوصابية أم الدرداء الصغرى عن عبد الله بن أبي زكريا الخزاعي عن خالد بن دهقان عن محمد بن شعيب بن شابور القرشي عن موسى بن أيوب النصيبي عن نعيم بن محمد الصوري عن الطبراني","نعيم بن محمد الصوري"
"9237","9229  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ ،  نَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِينِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبِ بْنِ شَابُورَ ،  عَنْ  خَالِدِ بْنِ دِهْقَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي زَكَرِيَّا ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  أَبِي الدَّرْدَاءِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَزَالُ الْمُؤْمِنُ  مُعْنِقًا  صَالِحًا مَا لَمْ يُصِبْ دَمًا حَرَامًا  ، فَإِذَا أَصَابَ دَمًا حَرَامًا  بَلَّحَ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عَبْدِ اللهِ بْنِ أَبِي زَكَرِيَّا  إِلَّا  خَالِدُ بْنُ دِهْقَانَ  ،  تَفَرَّدَ بِهِمَا  مُحَمَّدُ بْنُ شُعَيْبٍ  .","","Al-Mu'jam al-Awsat 9229","","أبو الدرداء عن هجيمة الأوصابية أم الدرداء الصغرى عن عبد الله بن أبي زكريا الخزاعي عن خالد بن دهقان عن محمد بن شعيب بن شابور القرشي عن موسى بن أيوب النصيبي عن نعيم بن محمد عن الطبراني","نعيم بن محمد الصوري"
"9238","9230  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ الصُّورِيُّ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِينِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْحَسَنِ أَبُو مَسْعُودٍ الزَّجَّاجُ ،  عَنْ  أَبِي بَكْرٍ الْهُذَلِيِّ ،  عَنِ  الْحَسَنِ ، وَشَهْرِ بْنِ حَوْشَبٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ بَدَّلَ دِينَ اللهِ فَاقْتُلُوهُ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَائِشَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ ،  تَفَرَّدَ بِهِ  مُوسَى بْنُ أَيُّوبَ  .","","Al-Mu'jam al-Awsat 9230","","عائشة بنت أبي بكر الصديق عن شهر بن حوشب عن أبو بكر الهذلي عن عبد الرحمن بن الحسن الموصلي عن موسى بن أيوب النصيبي عن نعيم بن محمد الصوري عن الطبراني","نعيم بن محمد الصوري"
"9239","9231  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ الصُّورِيُّ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  زُهَيْرِ بْنِ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ثَلَاثَةٌ لَا تُقْبَلُ لَهُمْ صَلَاةٌ  ،         [9/96]      وَلَا يَصْعَدُ لَهُمْ إِلَى اللهِ حَسَنَةٌ : السَّكْرَانُ حَتَّى يَصْحُوَ ، وَالْمَرْأَةُ السَّاخِطُ عَلَيْهَا زَوْجُهَا ، وَالْعَبْدُ  الْآبِقُ  حَتَّى يَرْجِعَ فَيَضَعَ يَدَهُ فِي يَدِ مَوَالِيهِ  .","","Al-Mu'jam al-Awsat 9231","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن زهير بن محمد التميمي عن الوليد بن مسلم القرشي عن موسى بن أيوب النصيبي عن نعيم بن محمد الصوري عن الطبراني","نعيم بن محمد الصوري"
"9240","9232  -  وَبِهِ  :  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَيُّمَا عَبْدٍ مَاتَ فِي  إِبَاقِهِ  دَخَلَ النَّارَ  ، وَإِنْ قُتِلَ فِي  سَبِيلِ  اللهِ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ  إِلَّا  زُهَيْرُ بْنُ مُحَمَّدٍ  ،  تَفَرَّدَ بِهِمَا  الْوَلِيدُ  ، وَلَا يُرْوَيَانِ عَنْ  جَابِرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9232","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبد الله بن محمد بن عقيل بن أبي طالب عن زهير بن محمد التميمي عن الوليد بن مسلم القرشي عن موسى بن أيوب بن عامر الغافقي عن نعيم بن محمد الصوري عن الطبراني","نعيم بن محمد الصوري"
"9241","9233  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ الصُّورِيُّ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي الزُّبَيْرِ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ  عَسْبِ  الْفَحْلِ  ، وَعَنْ بَيْعِ الْمَاءِ ، وَعَنْ بَيْعِ الْحَرْثِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ - بِهَذَا التَّمَامِ - عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  الْوَلِيدُ بْنُ مُسْلِمٍ  .","","Al-Mu'jam al-Awsat 9233","","أبو الزبير المكي عن ابن جريج عن الوليد بن مسلم القرشي عن موسى بن أيوب النصيبي عن نعيم بن محمد الصوري عن الطبراني","نعيم بن محمد الصوري"
"9242","9234  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ الصُّورِيُّ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ ،  ثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  حَدُّ الطَّرِيقِ سَبْعَةُ أَذْرُعٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الزُّبَيْرِ  إِلَّا  سُوَيْدٌ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ شُعَيْبٍ  .","","Al-Mu'jam al-Awsat 9234","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سويد بن عبد العزيز السلمي عن محمد بن شعيب بن شابور القرشي عن موسى بن أيوب النصيبي عن نعيم بن محمد الصوري عن الطبراني","نعيم بن محمد الصوري"
"9243","[9/97]      9235  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ الصُّورِيُّ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِينِيُّ ،  ثَنَا  أَبُو مَسْعُودٍ الزَّجَّاجُ ،  عَنْ  أَبِي بَكْرٍ الْهُذَلِيِّ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  عُرِضْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ بَدْرٍ  وَأَنَا ابْنُ ثَلَاثَ عَشْرَةَ سَنَةً ، فَرَدَّنِي  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ عُرِضْتُ عَلَيْهِ  يَوْمَ أُحُدٍ  وَأَنَا ابْنُ أَرْبَعَ عَشْرَةَ فَرَدَّنِي ، ثُمَّ عُرِضْتُ  يَوْمَ  الْأَحْزَابِ  وَأَنَا ابْنُ خَمْسَ عَشْرَةَ فَأُجِزْتُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي بَكْرٍ الْهُذَلِيِّ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ الْحَسَنِ  ،  تَفَرَّدَ بِهِ  مُوسَى بْنُ أَيُّوبَ  .","","Al-Mu'jam al-Awsat 9235","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أبو بكر الهذلي عن عبد الرحمن بن الحسن الموصلي عن موسى بن أيوب النصيبي عن نعيم بن محمد الصوري عن الطبراني","نعيم بن محمد الصوري"
"9244","9236  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ الصُّورِيُّ ،  ثَنَا  مُوسَى بْنُ أَيُّوبَ النَّصِيبِينِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ خَالِدٍ ،  عَنْ  غَالِبِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَحْرَمَ مِنْ  بَيْتِ الْمَقْدِسِ  دَخَلَ مَغْفُورًا لَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعٍ  إِلَّا  غَالِبُ بْنُ عُبَيْدِ اللهِ  ،  تَفَرَّدَ بِهِ  مُوسَى بْنُ أَيُّوبَ  .","","Al-Mu'jam al-Awsat 9236","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن غالب بن عبيد الله القرقساني عن عبد الله بن خالد عن موسى بن أيوب النصيبي عن نعيم بن محمد الصوري عن الطبراني","نعيم بن محمد الصوري"
"9245","9237  -  حَدَّثَنَا  نُعَيْمُ بْنُ مُحَمَّدٍ ،  نَا  مُوسَى بْنُ أَيُّوبَ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  شَيْبَانَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنِ  الْمُسْتَوْرِدِ بْنِ شَدَّادٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخَذْتُ بِيَدِهِ ، فَإِذَا هِيَ أَلْيَنُ مِنَ الْحَرِيرِ  ، وَأَبْرَدُ مِنَ الثَّلْجِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ  إِلَّا  شَيْبَانُ  ،  تَفَرَّدَ بِهِ  الْوَلِيدُ بْنُ مُسْلِمٍ  .","","Al-Mu'jam al-Awsat 9237","","شداد بن عمرو بن حسل الفهري عن المستورد بن شداد الفهري عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن شيبان بن عبد الرحمن المؤدب عن الوليد بن مسلم القرشي عن موسى بن أيوب النصيبي عن نعيم بن محمد عن الطبراني","نعيم بن محمد الصوري"
"9246","[9/98]      مَنِ اسْمُهُ : نُعْمَانُ  9238  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ الْقَاضِي ،  ثَنَا  صَالِحُ بْنُ مُحَمَّدٍ الْكِلَابِيُّ ،  ثَنَا  عَلِيُّ بْنُ عَاصِمٍ ،  عَنْ  خَالِدٍ وَعَوْفٍ وَسَوَّارٍ الْقَاضِي ،  عَنْ  أَبِي الْمِنْهَالِ ،  عَنْ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ ، "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ النَّوْمِ قَبْلَ الْعِشَاءِ وَالْحَدِيثِ بَعْدَهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَوَّارٍ  إِلَّا  عَلِيُّ بْنُ عَاصِمٍ  ،  تَفَرَّدَ بِهِ  صَالِحُ بْنُ مُحَمَّدٍ الْكِلَابِيُّ  .","","Al-Mu'jam al-Awsat 9238","","نضلة بن عبيد بن عابد الأسلمي عن سيار بن سلامة الرياحي عن خالد الحذاء عن علي بن عاصم بن صهيب عن صالح بن محمد بن الحارث الكلابي عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9247","9239  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  نَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  عَنْ  نَافِعِ بْنِ أَبِي نُعَيْمٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقْصُرُ الصَّلَاةَ  بِالْعَقِيقِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ -  مَرْفُوعًا  - عَنْ  نَافِعِ بْنِ أَبِي نُعَيْمٍ  إِلَّا  عَبْدُ اللهِ بْنُ نَافِعٍ  ،  تَفَرَّدَ بِهِ  عَبْدُ اللهِ بْنُ حَمْزَةَ  .","","Al-Mu'jam al-Awsat 9239","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن نافع بن عبد الرحمن بن أبي نعيم عن عبد الله بن نافع الصائغ عن عبد الله بن حمزة الزبيري عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9248","9240  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  ثَنَا  إِسْحَاقُ بْنُ شَاهِينَ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  يُونُسَ وَهِشَامٍ ،  عَنْ  مُحَمَّدٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا أَتَيْتُمُ الصَّلَاةَ فَلْيَمْشِ أَحَدُكُمْ عَلَى  هِينَتِهِ  ، فَلْيُصَلِّ مَا أَدْرَكَ ، وَلْيَقْضِ مَا سُبِقَ بِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يُونُسَ  إِلَّا  هُشَيْمٌ  ،  تَفَرَّدَ بِهِ  إِسْحَاقُ بْنُ شَاهِينَ  .","","Al-Mu'jam al-Awsat 9240","","أبو هريرة الدوسي عن محمد بن سيرين عن هشام بن حسان العتكي عن هشيم بن بشير عن إسحاق بن شاهين الدهقاني عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9249","9241  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُقَدَّمُ بْنُ مُحَمَّدِ بْنِ يَحْيَى ،  نَا  عَمِّي الْقَاسِمُ بْنُ يَحْيَى ،  عَنْ  إِبْرَاهِيمَ بْنِ عُثْمَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْحَكَمِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  مَنْ  نَفَّسَ  كُرْبَةً مِنْ كُرَبِ الْمُسْلِمِ فِي         [9/99]      الدُّنْيَا  نَفَّسَ  اللهُ عَنْهُ كُرْبَةً مِنْ كُرَبِ الْآخِرَةِ  ، وَمَنْ سَتَرَ  عَوْرَةَ  مُسْلِمٍ فِي الدُّنْيَا سَتَرَ اللهُ  عَوْرَتَهُ  فِي الدُّنْيَا وَالْآخِرَةِ ، وَمَنْ يَسَّرَ عَلَى مُعْسِرٍ فِي الدُّنْيَا يَسَّرَ اللهُ عَلَيْهِ فِي الدُّنْيَا وَالْآخِرَةِ ، وَاللهُ فِي عَوْنِ الْعَبْدِ مَا كَانَ الْعَبْدُ فِي عَوْنِ أَخِيهِ  .  لَمْ يُدْخِلْ بَيْنَ  الْأَعْمَشِ  وَأَبِي صَالِحٍ  :  الْحَكَمَ  ، أَحَدٌ مِمَّنْ رَوَى هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا أَبُو شَيْبَةَ ، وَلَا رَوَاهُ عَنْ  أَبِي شَيْبَةَ  إِلَّا  الْقَاسِمُ بْنُ يَحْيَى  ،  تَفَرَّدَ بِهِ  مُقَدَّمُ بْنُ مُحَمَّدٍ  .","","Al-Mu'jam al-Awsat 9241","","أبو هريرة الدوسي عن ذكوان السمان عن الحكم بن عتيبة الكندي عن الأعمش عن إبراهيم بن عثمان أبو شيبة العبسي عن القاسم بن يحيى المقدمي عن مقدم بن محمد بن يحيى الهلالي عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9250","9242  -  حَدَّثَنَا  النُّعْمَانُ ،  نَا  مُقَدَّمُ بْنُ مُحَمَّدٍ ،  نَا  عَمِّي الْقَاسِمُ بْنُ يَحْيَى ،  عَنْ  أَبِي حَمْزَةَ الْأَعْوَرِ ،  عَنْ  أَبِي الْحَكَمِ الْبَجَلِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَوِ اجْتَمَعَ أَهْلُ السَّمَاءِ وَأَهْلُ الْأَرْضِ عَلَى قَتْلِ رَجُلٍ مُؤْمِنٍ  لَكَبَّهُمُ اللهُ فِي النَّارِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الْحَكَمِ الْبَجَلِيِّ - وَهُوَ عَبْدُ الرَّحْمَنِ بْنُ أَبِي نُعَيْمٍ  - إِلَّا  أَبُو حَمْزَةَ  ، وَلَا عَنْ  أَبِي حَمْزَةَ  إِلَّا  الْقَاسِمُ بْنُ يَحْيَى  ،  تَفَرَّدَ بِهِ  مُقَدَّمُ بْنُ مُحَمَّدٍ  .","","Al-Mu'jam al-Awsat 9242","","أبو هريرة الدوسي عن أبو الحكم البجلي عن ميمون القصاب عن القاسم بن يحيى المقدمي عن مقدم بن محمد بن يحيى الهلالي عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9251","9243  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  نَا  مُقَدَّمُ بْنُ مُحَمَّدٍ ،  نَا  عَمِّي الْقَاسِمُ بْنُ يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ عُثْمَانَ بْنِ خُثَيْمٍ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عُبَيْدِ بْنِ عُمَيْرٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  جَاءَتِ  امْرَأَةٌ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَسْأَلُهُ  مَا يُحِلُّ اللهُ لِلرَّجُلِ مِنِ امْرَأَتِهِ وَهِيَ حَائِضٌ ؟ قَالَ : "" مَا فَوْقَ السُّرَّةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ خُثَيْمٍ  إِلَّا  الْقَاسِمُ  ،  تَفَرَّدَ بِهِ  مُقَدَّمٌ  .","","Al-Mu'jam al-Awsat 9243","","عائشة بنت أبي بكر الصديق عن عبيد بن عمير بن قتادة الجندعي عن ابن أبي مليكة عن عبد الله بن عثمان بن خثيم عن القاسم بن يحيى المقدمي عن مقدم بن محمد بن يحيى الهلالي عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9252","9244  -  حَدَّثَنَا  النُّعْمَانُ ،  ثَنَا  مُقَدَّمٌ ،  نَا  عَمِّي الْقَاسِمُ ،  عَنْ  عَبْدِ اللهِ بْنِ عُثْمَانَ ،  عَنِ  ابْنِ أَبِي مُلَيْكَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي ، وَإِنِّي لَبِحِذَائِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ خُثَيْمٍ  إِلَّا  الْقَاسِمُ بْنُ يَحْيَى  ،  تَفَرَّدَ بِهِ  مُقَدَّمٌ  .","","Al-Mu'jam al-Awsat 9244","","عائشة بنت أبي بكر الصديق عن ابن أبي مليكة عن عبد الله بن عثمان بن خثيم عن القاسم بن يحيى المقدمي عن مقدم بن محمد بن يحيى الهلالي عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9253","9245  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  ثَنَا  السَّرِيُّ بْنُ عَاصِمٍ ،  ثَنَا  إِسْمَاعِيلُ ابْنُ         [9/100]      عُلَيَّةَ ،  عَنْ  يَحْيَى بْنِ عَتِيقٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ ، "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ يُبَالَ فِي الْمَاءِ  الرَّاكِدِ  ، ثُمَّ يُتَوَضَّأُ مِنْهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ -  مَرْفُوعًا  - عَنِ  ابْنِ عُلَيَّةَ  إِلَّا  السَّرِيُّ بْنُ عَاصِمٍ  وَيَعْقُوبُ الدَّوْرَقِيُّ  .","","Al-Mu'jam al-Awsat 9245","","أبو هريرة الدوسي عن محمد بن سيرين عن يحيى بن عتيق الطفاوي عن إسماعيل ابن علية عن السرى بن عاصم مؤدب المعتز بالله عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9254","9246  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  ثَنَا  السَّرِيُّ بْنُ عَاصِمٍ ،  نَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  نَا  عُمَارَةُ بْنُ أَبِي حَفْصَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عُمَرَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  الْكَوْثَرُ  نَهَرٌ فِي الْجَنَّةِ ، حَافَتَاهُ الذَّهَبُ  ، وَيَجْرِي عَلَى الدُّرِّ وَالْيَاقُوتِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ -  مَوْصُولًا  - عَنْ  عُمَارَةَ بْنِ أَبِي حَفْصَةَ  إِلَّا  ابْنُ عُلَيَّةَ  ،  تَفَرَّدَ بِهِ  السَّرِيُّ بْنُ عَاصِمٍ  .","","Al-Mu'jam al-Awsat 9246","","عبد الله بن عمر بن الخطاب عن عكرمة مولى ابن عباس عن عمارة بن أبي حفصة العتكي عن إسماعيل ابن علية عن السرى بن عاصم مؤدب المعتز بالله عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9255","9247  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ مَاهَانَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  طَلْحَةُ بْنُ زَيْدٍ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمٍ ،  عَنْ  أَبِيهِ  ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا أُسْرِيَ بِهِ إِلَى السَّمَاءِ أُوحِيَ إِلَيْهِ بِالْأَذَانِ  ، فَنَزَلَ بِهِ ، فَعَلَّمَهُ  جِبْرِيلُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  يُونُسُ  ، وَلَا عَنْ  يُونُسَ  إِلَّا  طَلْحَةُ بْنُ زَيْدٍ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ مَاهَانَ الْوَاسِطِيُّ  .","","Al-Mu'jam al-Awsat 9247","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن يونس بن يزيدالأيلي عن طلحة بن زيد الرقي عن محمد بن ماهان القصباني عن أحمد بن أبي حنيفة محمد بن ماهان عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9256","9248  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  ثَنَا  عَبْدُ اللهِ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  نَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  عَنْ  عُثْمَانَ بْنِ الضَّحَّاكِ ،  عَنْ  أَبِيهِ  ،  عَنْ  عُبَيْدِ اللهِ بْنِ مِقْسَمٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ :  سُنَّةُ الْقِرَاءَةِ فِي الصَّلَاةِ أَنْ تَقْرَأَ فِي الْأُولَيَيْنِ بِأُمِّ الْقُرْآنِ وَسُورَةٍ  ، وَفِي الْأُخْرَيَيْنِ بِأُمِّ الْقُرْآنِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  جَابِرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  عُبَيْدُ اللهِ بْنُ مِقْسَمٍ  .","","Al-Mu'jam al-Awsat 9248","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عبيد الله بن مقسم القرشي عن الضحاك بن عثمان الحزامي عن عثمان بن الضحاك بن عثمان الحزامي عن عبد الله بن نافع الصائغ عن عبد الله بن حمزة الزبيري عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9257","[9/101]      9249  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  نَا  عَبْدُ اللهِ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  نَا  صَدَقَةُ بْنُ بَشِيرٍ - مَوْلَى آلِ عُمَرَ بْنِ الْخَطَّابِ -  عَنْ  قُدَامَةَ بْنِ إِبْرَاهِيمَ ، أَنَّ عَبْدَ اللهِ بْنَ عُمَرَ ،  حَدَّثَهُ  أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ عَبْدًا مِنْ عِبَادِ اللهِ قَالَ : أَيْ رَبِّ ، لَكَ الْحَمْدُ كَمَا يَنْبَغِي لِجَلَالِ وَجْهِكَ وَلِعَظِيمِ سُلْطَانِكَ  ،  فَأَعْضَلَتْ  بِالْمَلَكَيْنِ ، فَصَعِدَا إِلَى السَّمَاءِ الدُّنْيَا ، فَقَالَا : أَيْ رَبِّ ، عَبْدُكَ قَدْ قَالَ مَقَالَةً مَا نَدْرِي كَيْفَ نَكْتُبُهَا  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  صَدَقَةُ بْنُ بَشِيرٍ  .","","Al-Mu'jam al-Awsat 9249","","عبد الله بن عمر بن الخطاب عن قدامة بن إبراهيم الجمحي عن صدقة بن بشير العمري عن عبد الله بن حمزة الزبيري عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9258","9250  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  نَا  أَحْمَدُ بْنُ رُشْدِ بْنِ خُثَيْمٍ الْهِلَالِيُّ         [9/102]      حَدَّثَنِي  عَمِّي سَعِيدُ بْنُ خُثَيْمٍ ،  عَنْ  حَنْظَلَةَ بْنِ أَبِي سُلَيْمَانَ ،  عَنْ  طَاوُسٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  حَدَّثَتْنِي  أُمُّ الْفَضْلِ بِنْتُ الْحَارِثِ الْهِلَالِيَّةُ  ، قَالَتْ :  مَرَرْتُ بِالنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ جَالِسٌ بِالْحِجْرِ ، فَقَالَ : "" يَا  أُمَّ الْفَضْلِ  "" ، قُلْتُ : لَبَّيْكَ يَا رَسُولَ اللهِ ، قَالَ : "" إِنَّكِ حَامِلٌ بِغُلَامٍ "" ، قُلْتُ : يَا رَسُولَ اللهِ وَكَيْفَ وَقَدْ تَحَالَفَتْ  قُرَيْشٌ  أَنْ لَا يَأْتُوا النِّسَاءَ ؟ قَالَ : "" هُوَ مَا أَقُولُ لَكِ ، فَإِذَا وَضَعْتِيهِ فَأْتِنِي بِهِ "" ، قَالَتْ : فَلَمَّا وَضَعْتُهُ أَتَيْتُ بِهِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَذَّنَ فِي أُذُنِهِ الْيُمْنَى ، وَأَقَامَ فِي أُذُنِهِ الْيُسْرَى ،  وَأَلْبَأَهُ  مِنْ رِيقِهِ ، وَسَمَّاهُ  عَبْدَ اللهِ  ، ثُمَّ قَالَ : "" اذْهَبِي بِأَبِي الْخُلَفَاءِ "" ، قَالَتْ : فَأَتَيْتُ  الْعَبَّاسَ  فَأَعْلَمْتُهُ ، وَكَانَ رَجُلًا لَبَّاسًا جَمِيلًا مُوتَئِدَ الْقَامَةِ ، فَتَلَبَّسَ ثُمَّ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَلَمَّا رَآهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَامَ إِلَيْهِ ، فَقَبَّلَ مَا بَيْنَ عَيْنَيْهِ ثُمَّ أَقْعَدَهُ عَنْ يَمِينِهِ ، ثُمَّ قَالَ :  هَذَا عَمِّي ، فَمَنْ شَاءَ  فَلْيُبَاهِ  بِعَمِّهِ  ، فَقَالَ  الْعَبَّاسُ  : بَعْضَ الْقَوْلِ يَا رَسُولَ اللهِ ، قَالَ : "" وَلِمَ لَا أَقُولُ هَذَا يَا عَمِّ ، وَأَنْتَ عَمِّي  وَصِنْوُ  أَبِي وَبَقِيَّةُ آبَائِي ، وَوَارِثِي ، وَخَيْرُ مَنْ أَخْلُفُ مِنْ بَعْدِي مِنْ أَهْلِي ؟ "" قُلْتُ : يَا رَسُولَ اللهِ ، قَالَتْ  أُمُّ الْفَضْلِ  كَذَا وَكَذَا ؟ قَالَ : "" هِيَ لَكَ يَا  عَبَّاسُ  بَعْدَ ثِنْتَيْنِ وَثَلَاثِينَ وَمِائَةٍ ، ثُمَّ مِنْكُمُ  السَّفَّاحُ  ،  وَالْمَنْصُورُ  ،  وَالْمَهْدِيُّ  ، ثُمَّ هِيَ فِي أَوْلَادِهِمْ حَتَّى يَكُونَ آخِرُهُمُ الَّذِي يُصَلِّي بِالْمَسِيحِ  عِيسَى ابْنِ مَرْيَمَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  طَاوُسٍ  إِلَّا  حَنْظَلَةُ  ، وَلَا عَنْ  حَنْظَلَةَ  إِلَّا  سَعِيدُ بْنُ خُثَيْمٍ  ،  تَفَرَّدَ بِهِ  أَحْمَدُ بْنُ رَشَدٍ  .","","Al-Mu'jam al-Awsat 9250","","لبابة بنت الحارث الهلالية عن عبد الله بن عباس عن طاوس بن كيسان عن حنظلة الجمحي عن سعيد بن خثيم الهلالي عن أحمد بن راشد بن خثيم الكوفي عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9259","9251  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  نَا  أَحْمَدُ بْنُ سِنَانٍ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  أَنَا  شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  أَبِي صَالِحٍ         [9/103]      عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَدُ الْمُعْطِي  الْعُلْيَا  ، وَخَيْرُ الصَّدَقَةِ مَا أَبْقَتْ  غِنًى  ، وَابْدَأْ بِمَنْ  تَعُولُ ،  تَقُولُ امْرَأَتُكَ : أَنْفِقْ عَلَيَّ أَوْ طَلِّقْنِي ، وَيَقُولُ وَلَدُكَ : يَا أَبَتِ إِلَى مَنْ تَكِلُنَا ؟ وَيَقُولُ خَادِمُكَ : أَطْعِمْنِي وَاسْتَعْمِلْنِي  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شَرِيكٍ  إِلَّا  يَزِيدُ بْنُ هَارُونَ  ، وَلَا  رَفَعَ  هَذَا الْحَدِيثَ عَنْ  عَاصِمٍ  إِلَّا  شَرِيكٌ  وَحَمَّادُ بْنُ سَلَمَةَ  .","","Al-Mu'jam al-Awsat 9251","","أبو هريرة الدوسي عن ذكوان السمان عن عاصم بن بهدلة عن شريك بن عبد الله النخعي عن يزيد بن هارون عن أحمد بن سنان القطان عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9260","9252  -  حَدَّثَنَا  النُّعْمَانُ ،  ثَنَا  أَحْمَدُ بْنُ سِنَانٍ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  كُلْثُومِ بْنِ جَبْرٍ وَأَبِي حَفْصٍ ،  عَنْ  أَبِي الْغَادِيَةِ ، قَالَ :  رَأَيْتُ  عَمَّارَ بْنَ يَاسِرٍ  ذَكَرَ  عُثْمَانَ بْنَ عَفَّانَ  ، فَقُلْتُ : لَئِنِ اسْتَمْكَنْتُ مِنْ هَذَا ، فَلَمَّا كَانَ  يَوْمُ  صِفِّينَ  وَعَلَيْهِ السِّلَاحُ ، فَجَعَلَ يَحْمِلُ حَتَّى يَدْخُلَ فِي  الْقَوْمِ  ، ثُمَّ يَخْرُجَ ، فَنَظَرْتُ فَإِذَا رُكْبَتُهُ قَدْ  حُسِرَ  عَنْهَا الدِّرْعُ وَالسَّاقُ ، فَسَدَّدْتُ نَحْوَهُ الرُّمْحَ ، فَطَعَنْتُ رُكْبَتَهُ ، ثُمَّ قَتَلْتُهُ ، فَقَالَ عَمْرُو بْنُ الْعَاصِ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  قَاتِلُهُ وَسَالِبُهُ فِي النَّارِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حَمَّادِ بْنِ سَلَمَةَ  إِلَّا  يَزِيدُ بْنُ هَارُونَ  .","","Al-Mu'jam al-Awsat 9252","","عمرو بن العاص بن وائل السهمي عن قزعة بن يحيى الحرشي عن سعيد بن جمهان الأسلمي عن حماد بن سلمة عن يزيد بن هارون عن أحمد بن سنان القطان عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9261","9253  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ ،  ثَنَا  مُحَمَّدُ بْنُ عَبَادَةَ الْوَاسِطِيُّ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ حُسَيْنٍ ،  عَنْ  يُوسُفَ بْنِ مَيْمُونٍ ،  عَنِ  الْأَغَرِّ أَبِي مُسْلِمٍ ،  عَنْ  أَبِي سَعِيدٍ ، وَأَبِي هُرَيْرَةَ ، قَالَا : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" يَقُولُ اللهُ عَزَّ وَجَلَّ :  الْكِبْرِيَاءُ رِدَائِي  ، فَمَنْ نَازَعَنِي ثَوْبِي جَعَلْتُهُ فِي النَّارِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يُوسُفَ بْنِ مَيْمُونٍ  إِلَّا  عَبْدُ الْمَلِكِ بْنُ حُسَيْنٍ  ،  تَفَرَّدَ بِهِ  يَزِيدُ بْنُ هَارُونَ  .","","Al-Mu'jam al-Awsat 9253","","أبو هريرة الدوسي عن الأغر المديني مولى أبي هريرة وأبي سعيد الخدري عن يوسف بن ميمون الصباغ عن ابن ذر ، عبد الملك بن الحسين النخعي عن يزيد بن هارون عن محمد بن عبادة بن البخترى الأسدي عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","النعمان بن أحمد الواسطي"
"9262","[9/104]      بَابُ الْوَاوِ  مَنِ اسْمُهُ : وَاثِلَةُ  9254  -  حَدَّثَنَا  وَاثِلَةُ بْنُ الْحَسَنِ الْعِرْقِيُّ ،  نَا  كَثِيرُ بْنُ عُبَيْدٍ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  بَحْرٍ السَّقَّاءِ ،  عَنْ  مُحَمَّدِ بْنِ زِيَادٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا يُؤَمِّنُ الَّذِي يَرْفَعُ رَأْسَهُ قَبْلَ الْإِمَامِ أَنْ يَجْعَلَ اللهُ رَأْسَهُ رَأْسَ حِمَارٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بَحْرٍ السَّقَّاءِ  إِلَّا  بَقِيَّةُ بْنُ الْوَلِيدِ  .","","Al-Mu'jam al-Awsat 9254","","أبو هريرة الدوسي عن محمد بن زياد الجمحي عن بحر بن كنيز السقاء عن بقية بن الوليد عن كثير بن عبيد المذحجي عن واثلة بن الحسن العرقي عن الطبراني","واثلة بن الحسن العرقي"
"9263","9255  -  حَدَّثَنَا  وَاثِلَةُ بْنُ الْحَسَنِ ،  ثَنَا  كَثِيرٌ ،  ثَنَا  بَقِيَّةُ ،  عَنْ  مُحَمَّدِ بْنِ الْوَلِيدِ الزُّبَيْدِيِّ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَرِيَّةً كُنْتُ فِيهَا  ، فَبَلَغَتْ  سُهْمَانُنَا  لِلرَّجُلِ اثْنَا عَشَرَ بَعِيرًا ، وَنَفَّلَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعْدَ ذَلِكَ بَعِيرًا بَعِيرًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّبَيْدِيِّ  إِلَّا  بَقِيَّةُ  .","","Al-Mu'jam al-Awsat 9255","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن الوليد بن عامر الزبيدي عن بقية بن الوليد عن كثير بن عبيد المذحجي عن واثلة بن الحسن العرقي عن الطبراني","واثلة بن الحسن العرقي"
"9264","9256  -  حَدَّثَنَا  وَاثِلَةُ ،  نَا  كَثِيرٌ ،  ثَنَا  بَقِيَّةُ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَدْهَمَ ،  عَنْ  مُحَمَّدِ بْنِ         [9/105]      عَجْلَانَ ،  عَنْ  فَرْوَةَ بْنِ مُجَاهِدٍ ،  عَنْ  سَهْلِ بْنِ مُعَاذِ بْنِ أَنَسٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ  كَظَمَ  غَيْظًا وَهُوَ قَادِرٌ عَلَى إِنْفَاذِهِ خَيَّرَهُ اللهُ مِنَ  الْحُورِ  الْعِينِ  يَوْمَ الْقِيَامَةِ ، وَمَنْ تَرَكَ ثَوْبَ جَمَالٍ وَهُوَ قَادِرٌ عَلَيْهِ كَسَاهُ اللهُ رِدَاءَ الْإِيمَانِ يَوْمَ الْقِيَامَةِ ، وَمَنْ أَنْكَحَ عَبْدًا وَضَعَ اللهُ عَلَى رَأْسِهِ تَاجَ الْمُلْكِ يَوْمَ الْقِيَامَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِبْرَاهِيمَ بْنِ أَدْهَمَ  إِلَّا  بَقِيَّةُ  .","","Al-Mu'jam al-Awsat 9256","","معاذ بن أنس الجهني عن سهل بن معاذ بن أنس الجهني عن فروة بن مجاهد اللخمي عن محمد بن عجلان عن إبراهيم بن أدهم الزاهد عن بقية بن الوليد عن كثير بن عبيد المذحجي عن واثلة بن الحسن العرقي عن الطبراني","واثلة بن الحسن العرقي"
"9265","9257  -  حَدَّثَنَا  وَاثِلَةُ بْنُ الْحَسَنِ الْعِرْقِيُّ ،  ثَنَا  كَثِيرٌ ،  ثَنَا  أَيُّوبُ بْنُ سُوَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ الْعَرْزَمِيِّ ،  عَنْ  قَتَادَةَ ، قَالَ :  قُلْتُ لِأَنَسِ بْنِ مَالِكٍ ، أَرِنَا كَيْفَ صَلَاةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟  فَقَامَ فَصَلَّى ، "" فَكَانَ يَرْفَعُ يَدَيْهِ مَعَ كُلِّ تَكْبِيرَةٍ "" ، فَلَمَّا انْصَرَفَ قَالَ : هَكَذَا كَانَ صَلَاةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  ، عَنْ  أَنَسٍ  إِلَّا  الْعَرْزَمِيُّ  .","","Al-Mu'jam al-Awsat 9257","","أنس بن مالك عن قتادة بن دعامة عن محمد بن عبيد الله بن أبي سليمان العرزمي عن أيوب بن سويد الحميري عن كثير بن عبيد المذحجي عن واثلة بن الحسن العرقي عن الطبراني","واثلة بن الحسن العرقي"
"9266","مَنِ اسْمُهُ : وَلِيدٌ  9258  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ الرَّمْلِيُّ ،  نَا  الْحُسَيْنُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  الْحَسَنُ بْنُ مُحَمَّدِ بْنِ أَعْيَنَ ،  نَا  فُلَيْحُ بْنُ سُلَيْمَانَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى عَلَى  النَّجَاشِيِّ  ، فَكَبَّرَ عَلَيْهِ أَرْبَعَ تَكْبِيرَاتٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعٍ  إِلَّا  فُلَيْحٌ  ،  تَفَرَّدَ بِهِ  الْحَسَنُ بْنُ مُحَمَّدِ بْنِ أَعْيَنَ  .","","Al-Mu'jam al-Awsat 9258","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن فليح بن سليمان عن الحسن بن محمد بن أعين الحراني عن الحسين بن أبي السري العسقلاني عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9267","9259  -  حَدَّثَنَا  الْوَلِيدُ ،  ثَنَا  الْحُسَيْنُ بْنُ أَبِي السَّرِيِّ ،  نَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،  نَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ ذَكْوَانَ ،  عَنِ  الْحَسَنِ ،  عَنْ  عُتَيٍّ         [9/106]      عَنْ  أُبَيِّ بْنِ كَعْبٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ  آدَمَ  غَسَّلَتْهُ الْمَلَائِكَةُ بِمَاءٍ وَسِدْرٍ  ، وَكَفَّنُوهُ ، وَأَلْحَدُوا لَهُ ، وَدَفَنُوهُ ، وَقَالُوا : هَذَا سُنَّتُكُمْ يَا بَنِي آدَمَ فِي مَوْتَاكُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ ذَكْوَانَ  إِلَّا  مُحَمَّدُ بْنُ إِسْحَاقَ  .","","Al-Mu'jam al-Awsat 9259","","أبي بن كعب عن عتي بن ضمرة التميمي عن الحسن البصري عن محمد بن ذكوان الطاحي عن محمد بن إسحاق عن محمد بن عبيد بن أبي أمية عن الحسين بن أبي السري العسقلاني عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9268","9260  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ الرَّمْلِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  سَعْدَانُ بْنُ يَحْيَى ،  عَنْ  صَدَقَةَ بْنِ أَبِي عِمْرَانَ ،  عَنْ  إِيَادِ بْنِ لَقِيطٍ ،  عَنْ  أَبِي رِمْثَةَ ، قَالَ :  انْطَلَقْتُ مَعَ أَبِي إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَإِذَا "" هُوَ ذُو  وَفْرَةٍ  ، بِهَا رَدْعٌ مِنْ حِنَّاءٍ ، وَعَلَيْهِ ثَوْبَانِ أَخْضَرَانِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  صَدَقَةَ بْنِ أَبِي عِمْرَانَ  إِلَّا  سَعْدَانُ بْنُ يَحْيَى  وَعَبَّادُ بْنُ صُهَيْبٍ  .  وَرَوَاهُ يَزِيدُ بْنُ  إِبْرَاهِيمَ التُّسْتَرِيُّ  ، عَنْ  صَدَقَةَ  ، عَنْ  بَابِي بْنِ مُنْقِذٍ  ، عَنْ  أَبِي رِمْثَةَ  .","","Al-Mu'jam al-Awsat 9260","","أبو رمثة البلوي عن إياد بن لقيط السدوسي عن صدقة بن أبي عمران الكوفي عن سعيد بن يحيى سعدان عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9269","9261  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  نَا  سَعْدَانُ بْنُ يَحْيَى ،  ثَنَا  أَبُو الرِّجَالِ الْبَصْرِيُّ  ،  عَنِ  النَّضْرِ بْنِ أَنَسٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى بِهِمُ الْهَاجِرَةَ ، فَرَفَعَ صَوْتَهُ فَقَرَأَ :         {      وَالشَّمْسِ وَضُحَاهَا         }             {      وَاللَّيْلِ إِذَا يَغْشَى         }      فَقَالَ لَهُ  أُبَيُّ بْنُ كَعْبٍ  : يَا رَسُولَ اللهِ ، أُمِرْتَ فِي هَذِهِ الصَّلَاةِ بِشَيْءٍ ؟ قَالَ :  لَا ، وَلَكِنِّي أَرَدْتُ أَنْ أُوَقِّتَ لَكُمْ صَلَاتَكُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  النَّضْرِ بْنِ أَنَسٍ  إِلَّا  أَبُو الرِّجَالِ  ، وَلَا رَوَاهُ عَنْ  أَبِي الرِّجَالِ         [9/107]      إِلَّا  سَعْدَانُ بْنُ يَحْيَى  وَسَلْمُ بْنُ قُتَيْبَةَ  .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( أبو الرحال )","","Al-Mu'jam al-Awsat 9261","","أنس بن مالك عن النضر بن أنس بن مالك الأنصاري عن أبو الرحال الأنصاري عن سعيد بن يحيى سعدان عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9270","9262  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ ،  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  نَا  مُحَمَّدُ بْنُ شُعَيْبٍ ،  عَنِ  الْمُغِيرَةِ بْنِ زِيَادٍ الْمَوْصِلِيِّ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ :  رَخَّصَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْعَصَا ، وَالسَّوْطِ ، وَالْحَبْلِ  ، وَأَشْبَاهِهِ ، يَلْتَقِطُهُ الْمُحْرِمُ فَيُحْرِزُهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْمُغِيرَةِ بْنِ زِيَادٍ  إِلَّا  مُحَمَّدُ بْنُ شُعَيْبٍ  .","","Al-Mu'jam al-Awsat 9262","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن المغيرة بن زياد البجلي عن محمد بن شعيب بن شابور القرشي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9271","9263  -  حَدَّثَنَا  الْوَلِيدُ ،  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  سَعْدَانُ بْنُ يَحْيَى ،  عَنْ  عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ،  عَنْ  صَالِحِ بْنِ أَبِي عَرِيبٍ ،  عَنْ  كَثِيرِ بْنِ مُرَّةَ ،  عَنْ  مُعَاذِ بْنِ جَبَلٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تُدِيمُوا النَّظَرَ إِلَى  الْمَجْذُومِينَ  ""  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  مُعَاذٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ  .","","Al-Mu'jam al-Awsat 9263","","معاذ بن جبل عن كثير بن مرة الرهاوي عن صالح بن أبي عريب الحضرمي عن عبد الحميد بن جعفر الأوسي عن سعيد بن يحيى سعدان عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9272","9264  -  حَدَّثَنَا  الْوَلِيدُ ،  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  خَالِدُ بْنُ أَبِي خَالِدٍ الْأَزْرَقُ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَفْضَلُ الْعِبَادَةِ الْفِقْهُ  ، وَأَفْضَلُ الدِّينِ  الْوَرَعُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الشَّعْبِيِّ  إِلَّا  ابْنُ أَبِي لَيْلَى  ، وَلَا عَنِ  ابْنِ أَبِي لَيْلَى  إِلَّا  خَالِدٌ  ،  تَفَرَّدَ بِهِ  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ  .","","Al-Mu'jam al-Awsat 9264","","عبد الله بن عمر بن الخطاب عن الشعبي عن محمد بن عبد الرحمن بن أبي ليلى عن خالد بن يزيد الأزرق عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9273","9265  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ الرَّمْلِيُّ ،  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا         [9/108]      الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ نَمِرٍ الْيَحْصَبِيِّ ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ ثَعْلَبَةَ الْأَنْصَارِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ بْنِ جَارِيَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى الْفَجْرَ يَوْمًا فَغَلَّسَ بِهَا  ثُمَّ صَلَّاهَا يَوْمًا بَعْدُ  فَأَسْفَرَ  بِهَا ، ثُمَّ قَالَ : "" مَا بَيْنَهُمَا وَقْتٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ نَمِرٍ  ،  تَفَرَّدَ بِهِ  الْوَلِيدُ  .","","Al-Mu'jam al-Awsat 9265","","عبد الرحمن بن يزيد بن جارية الأنصاري عن عبيد الله بن عبد الله بن ثعلبة الأنصاري عن عبيد الله بن عبد الله عن الزهري عن عبد الرحمن بن نمر اليحصبي عن الوليد بن مسلم القرشي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9274","9266  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ ،  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ بَشِيرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِي بَكْرِ بْنِ مُحَمَّدٍ ،  عَنْ  عُمَرَ بْنِ أَبِي سَلَمَةَ ،  عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ :  حَلَقَ رَأْسَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ النَّحْرِ  مَعْمَرُ بْنُ عَبْدِ اللهِ الْعَدَوِيُّ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أُمِّ سَلَمَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ  .","","Al-Mu'jam al-Awsat 9266","","هند بنت أبي أمية زوج رسول الله عن عمر بن أبي سلمة المخزومي عن أبو بكر بن محمد الخزرجي عن محمد بن إسحاق عن عبد الرحمن بن بشير الدمشقي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9275","9267  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  سَعْدَانُ بْنُ يَحْيَى ،  ثَنَا  نَافِعٌ ، مَوْلَى يُوسُفَ السُّلَمِيِّ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مِفْتَاحُ الصَّلَاةِ الطُّهُورُ ،  وَتَحْرِيمُهَا  التَّكْبِيرُ  ،  وَتَحْلِيلُهَا  التَّسْلِيمُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءٍ  إِلَّا  نَافِعٌ  ، وَلَا عَنْ  نَافِعٍ  إِلَّا  سَعْدَانُ بْنُ يَحْيَى  ،  تَفَرَّدَ بِهِ  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ  ، وَلَا يُرْوَى عَنِ  ابْنِ عَبَّاسٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9267","","عبد الله بن عباس عن عطاء بن أبي رباح عن نافع مولى يوسف السلمي عن سعيد بن يحيى سعدان عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9276","9268  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ ،  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَوَّارٍ ،  نَا  عَمْرُو بْنُ مَيْمُونِ بْنِ مِهْرَانَ ،  حَدَّثَنِي  أَبِي مَيْمُونُ بْنُ مِهْرَانَ ،  عَنْ  أَبِيهِ مِهْرَانَ  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ لَمْ يَقْرَأْ بِأُمِّ الْكِتَابِ فِي صَلَاتِهِ         [9/109]      فَهِيَ  خِدَاجٌ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  مِهْرَانَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ  .","","Al-Mu'jam al-Awsat 9268","","مهران الجزري عن ميمون بن مهران الرقي عن عمرو بن ميمون بن مهران عن عبد الرحمن بن سوار عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9277","9269  -  حَدَّثَنَا  الْوَلِيدُ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ بْنِ أَبِي مَالِكٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَشْقَى الْأَشْقِيَاءِ مَنِ اجْتَمَعَ عَلَيْهِ فَقْرُ الدُّنْيَا  وَعَذَابُ الْآخِرَةِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي سَعِيدٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  خَالِدُ بْنُ يَزِيدَ بْنِ أَبِي مَالِكٍ  .","","Al-Mu'jam al-Awsat 9269","","أبو سعيد الخدري عن عطاء بن أبي رباح عن يزيد بن عبد الرحمن بن أبي مالك عن خالد بن يزيد الهمداني عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9278","9270  -  حَدَّثَنَا  الْوَلِيدُ بْنُ حَمَّادٍ الرَّمْلِيُّ ،  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  نَا  مَطَرُ بْنُ الْعَلَاءِ ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ يَسَارٍ الثَّقَفِيُّ ،  نَا  أَبُو أُمَيَّةَ الشَّعْبَانِيُّ - وَكَانَ قَدْ أَدْرَكَ الْجَاهِلِيَّةَ -  حَدَّثَنِي  مُعَاذُ بْنُ جَبَلٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ثَلَاثُونَ نُبُوَّةٌ وَمُلْكٌ  ، وَثَلَاثُونَ مُلْكٌ  وَجَبَرُوتٌ  ، وَمَا وَرَاءَ ذَلِكَ فَلَا خَيْرَ فِيهِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي أُمَيَّةَ الشَّعْبَانِيُّ  ، عَنْ  مُعَاذٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ  .","","Al-Mu'jam al-Awsat 9270","","معاذ بن جبل عن يحمد الشعباني عن عبد الملك بن سيار الثقفي عن مطر بن العلاء الفزاري عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9279","9271  -  حَدَّثَنَا  الْوَلِيدُ ،  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ الْمُقْرِئُ  ،  ثَنَا  أَرْطَاةُ بْنُ الْمُنْذِرِ ،  عَنْ  أَبِي الْبَكَرَاتِ         [9/110]      عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمَلَاحِمُ عَلَى يَدَيِ الْخَامِسِ مِنْ  آلِ هِرَقْلَ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي مُوسَى  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  أَرْطَاةُ بْنُ الْمُنْذِرِ  .  كذا في طبعة دار الحرمين ، وقال محققه : كذا بالأصلين ، وصوابه ما في المجمع : ( القشيري ) فهو الذي يروي عنه سليمان بن عبد الرحمن .أ.هـ","","Al-Mu'jam al-Awsat 9271","","أبو موسى الأشعري عن أبو البكرات عن أرطاة بن المنذر السكوني عن محمد بن عبد الرحمن البيروتي عن سليمان بن عبد الرحمن التميمي عن الوليد بن حماد بن جابر الزيات عن الطبراني","الوليد بن حماد الرملي"
"9280","9272  -  حَدَّثَنَا  الْوَلِيدُ بْنُ الْعَبَّاسِ الْعَدَّاسُ الْمِصْرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  حَرْمَلَةُ بْنُ عِمْرَانَ التُّجِيبِيُّ ،  عَنْ  عُقْبَةَ بْنِ مُسْلِمٍ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ الْجُهَنِيِّ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا رَأَيْتَ اللهَ يُعْطِي الْعَبْدَ مَا يُحِبُّ وَهُوَ مُقِيمٌ عَلَى مَعَاصِيهِ فَإِنَّمَا ذَلِكَ لَهُ مِنْهُ اسْتِدْرَاجٌ  ثُمَّ نَزَعَ بِهَذِهِ الْآيَةِ         {      فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ فَتَحْنَا عَلَيْهِمْ أَبْوَابَ كُلِّ شَيْءٍ حَتَّى إِذَا فَرِحُوا بِمَا أُوتُوا أَخَذْنَاهُمْ بَغْتَةً فَإِذَا هُمْ مُبْلِسُونَ             *          فَقُطِعَ دَابِرُ الْقَوْمِ الَّذِينَ ظَلَمُوا وَالْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ         }      .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عُقْبَةَ بْنِ عَامِرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  حَرْمَلَةُ بْنُ عِمْرَانَ  .","","Al-Mu'jam al-Awsat 9272","","عقبة بن عامر بن عبس الفرضي عن عقبة بن مسلم التجيبي عن حرملة بن عمران التجيبي عن عبد الله بن صالح المصري عن الوليد بن العباس بن مسافر المصري عن الطبراني","الوليد بن العباس العداس المصري"
"9281","9273  -  حَدَّثَنَا  الْوَلِيدُ بْنُ الْعَبَّاسِ الْعَدَّاسُ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الصُّنَابِحِيِّ ، قَالَ :  لَمَّا حَضَرَتْ عُبَادَةَ الْوَفَاةُ ، وَأَنَا عِنْدَ رَأْسِهِ أَبْكِي ، قَالَ : مَا يُبْكِيكَ ؟ فَقُلْتُ : مَا لِي لَا أَبْكِي عَنْ نَفْعِكَ إِيَّايَ وَمَنْفَعَتِي مِنْكَ ؟ قَالَ : وَاللهِ مَا كَتَمْتُكَ كَلِمَةً سَمِعْتُهَا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا وَاحِدَةً ، وَأَنَا  مُحَدِّثُكَهَا  ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ قَالَ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، أَطَاعَ بِهَا قَلْبُهُ  ، وَذَلَّ بِهَا لِسَانُهُ حَرَّمَهُ اللهُ عَلَى النَّارِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا ابْنُهُ  عَبْدُ الرَّحْمَنِ  ، تَفَرَّدَ بِهِ  أَبُو صَالِحٍ  .","","Al-Mu'jam al-Awsat 9273","","عبادة بن الصامت عن عبد الرحمن بن عسيلة الصنابحي عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن عبد الله بن صالح المصري عن الوليد بن العباس بن مسافر المصري عن الطبراني","الوليد بن العباس العداس المصري"
"9282","9274  -  حَدَّثَنَا  الْوَلِيدُ بْنُ الْعَبَّاسِ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  ثَنَا  مُفَضَّلُ بْنُ         [9/111]      فَضَالَةَ ،  عَنْ  يُونُسَ بْنِ يَزِيدَ ،  عَنْ  سَعْدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَخِيهِ الْمِسْوَرِ بْنِ إِبْرَاهِيمَ  ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يُغَرَّمُ صَاحِبُ السَّرِقَةِ إِذَا أُقِيمَ عَلَيْهِ  الْحَدُّ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  مُفَضَّلُ بْنُ فَضَالَةَ  ، وَلَيْسَ  مُتَّصِلَ الْإِسْنَادِ  ؛ لِأَنَّ الْمِسْوَرَ لَمْ يَسْمَعْ مِنْ جَدِّهِ  .","","Al-Mu'jam al-Awsat 9274","","عبد الرحمن بن عوف بن عبد عوف القرشي عن المسور بن إبراهيم بن عبد الرحمن بن عوف عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن يونس بن يزيدالأيلي عن المفضل بن فضالة عن عبد الله بن صالح المصري عن الوليد بن العباس بن مسافر المصري عن الطبراني","الوليد بن العباس العداس المصري"
"9283","9275  -  حَدَّثَنَا  الْوَلِيدُ بْنُ الْعَبَّاسِ ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  بَكْرُ بْنُ مُضَرَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ،  أَنَّ الصَّلَاةَ فُرِضَتْ أَوَّلَ مَا فُرِضَتْ رَكْعَتَيْنِ  ، فَزِيدَ فِي صَلَاةِ الْحَضَرِ ، وَأُقِرَّتْ صَلَاةُ السَّفَرِ رَكْعَتَيْنِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ  إِلَّا  بَكْرُ بْنُ مُضَرَ  .","","Al-Mu'jam al-Awsat 9275","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن جعفر بن ربيعة الكندي عن بكر بن مضر المصري عن يحيى بن عبد الله بن بكير المخزومي عن الوليد بن العباس بن مسافر المصري عن الطبراني","الوليد بن العباس العداس المصري"
"9284","9276  -  حَدَّثَنَا  الْوَلِيدُ بْنُ الْعَبَّاسِ ،  نَا  يَحْيَى بْنُ بُكَيْرٍ ،  نَا  الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنِ  الضَّحَّاكِ ،  عَنْ  نَافِعٍ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ، أَنَّهُ  سَمِعَ  عَبْدَ اللهِ بْنَ عُمَرَ ، يَقُولُ :  مَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِابْنِ صَيَّادٍ  ، وَهُوَ يَلْعَبُ مَعَ صِبْيَانٍ  ، فَعَرَفَهُ ، فَقَدِمَهُ ، فَقَالَ : "" أَتَشْهَدُ أَنِّي رَسُولُ اللهِ ؟ "" قَالَ  ابْنُ الصَّيَّادِ  : أَشْهَدُ أَنَّكَ نَبِيُّ الْأُمِّيِّينَ ، فَتَشْهَدُ أَنِّي رَسُولُ اللهِ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" آمَنْتُ بِاللهِ وَرُسُلِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  نَافِعٍ  ، عَنْ  سَالِمٍ ،  إِلَّا  الضَّحَّاكُ  ،  تَفَرَّدَ بِهِ  الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ  .","","Al-Mu'jam al-Awsat 9276","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن الضحاك بن عثمان الحزامي عن المغيرة بن عبد الرحمن بن عبد الله الحزامي عن يحيى بن عبد الله بن بكير المخزومي عن الوليد بن العباس بن مسافر المصري عن الطبراني","الوليد بن العباس العداس المصري"
"9285","9277  -  حَدَّثَنَا  الْوَلِيدُ بْنُ الْعَبَّاسِ الْعَدَّاسُ ،  ثَنَا  أَبُو صَالِحٍ الْحُدَّانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  ضَمْضَمِ بْنِ زُرْعَةَ ،  عَنْ  شُرَيْحِ بْنِ عُبَيْدٍ ،  عَنْ  أَبِي زُهَيْرٍ الْأَنْمَارِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَقْتُلُوا الْجَرَادَ  ؛ فَإِنَّهُ         [9/112]      جُنْدُ اللهِ الْأَعْظَمُ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي زُهَيْرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  إِسْمَاعِيلُ بْنُ عَيَّاشٍ  .","","Al-Mu'jam al-Awsat 9277","","أبو الأزهر الأنماري عن شريح بن عبيد المقرائي عن ضمضم بن زرعة الحضرمي عن إسماعيل بن عياش الأحول عن عبد الغفار بن داود الحراني عن الوليد بن العباس بن مسافر المصري عن الطبراني","الوليد بن العباس العدوي"
"9286","9278  -  حَدَّثَنَا  الْوَلِيدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْعَزِيزِ الْمُقْرِئُ ،  نَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تُنْسَخُ دَوَاوِينُ أَهْلِ الْأَرْضِ فِي دَوَاوِينِ أَهْلِ السَّمَاءِ فِي كُلِّ اثْنَيْنٍ وَخَمِيسٍ  ، فَيُغْفَرُ لِكُلِّ مُسْلِمٍ لَا يُشْرِكُ بِاللهِ شَيْئًا ، إِلَّا رَجُلًا بَيْنَهُ وَبَيْنَ أَخِيهِ  شَحْنَاءُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَنْصُورٍ  إِلَّا  عَمْرُو بْنُ أَبِي قَيْسٍ  ، وَلَا عَنْ  عَمْرٍو  إِلَّا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْعَزِيزِ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ عَمَّارٍ  .","","Al-Mu'jam al-Awsat 9278","","أبو هريرة الدوسي عن ذكوان السمان عن منصور بن المعتمر عن عمرو بن أبي قيس عن عبد الصمد بن عبد العزيز الرازي عن محمد بن عمار الرازي عن الوليد بن أبان بن بونة الأصبهاني عن الطبراني","الوليد بن أبان الأصبهاني"
"9287","9279  -  حَدَّثَنَا  الْوَلِيدُ بْنُ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ الرَّازِيُّ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْعَزِيزِ ،  نَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  مَنْصُورٍ ،  عَنْ  أَبِي جَعْفَرٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِمَّا يَقْرَأُ فِي صَلَاةِ الْجُمُعَةِ بِالْجُمُعَةِ  ، فَيُحَرِّضُ بِهِ الْمُؤْمِنِينَ ، وَفِي الثَّانِيَةِ بِسُورَةِ الْمُنَافِقِينَ فَيُفْزِعُ بِهِ الْمُنَافِقِينَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَنْصُورٍ  إِلَّا  عَمْرُو بْنُ أَبِي قَيْسٍ  .","","Al-Mu'jam al-Awsat 9279","","أبو هريرة الدوسي عن أبو جعفر الباقر عن منصور بن المعتمر عن عمرو بن أبي قيس عن عبد الصمد بن عبد العزيز الرازي عن محمد بن عمار الرازي عن الوليد بن أبان بن بونة الأصبهاني عن الطبراني","الوليد بن أبان الأصبهاني"
"9288","[9/113]      9280  -  حَدَّثَنِي  الْوَلِيدُ بْنُ أَبَانَ ،  ثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  بَشِيرِ بْنِ عَاصِمٍ ،  عَنْ  أَبِي الْيَقْظَانِ ،  عَنْ  زَاذَانَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ثَلَاثَةٌ لَا يَهُولُهُمُ الْفَزَعُ ، وَلَا يَنَالُهُمُ الْحِسَابُ  ، عَلَى كَثِيبٍ مِنْ مِسْكٍ حَتَّى يَفْرَغَ اللهُ مِنْ حِسَابِ الْعِبَادِ : رَجُلٌ قَرَأَ الْقُرْآنَ ابْتِغَاءَ وَجْهِ اللهِ ، فَأَمَّ بِهِ قَوْمًا وَهُمْ رَاضُونَ بِهِ ، وَدَاعِيَةٌ يَدْعُو إِلَى الصَّلَوَاتِ الْخَمْسِ ابْتِغَاءَ وَجْهِ اللهِ ، وَعَبْدٌ أَحْسَنَ مَا بَيْنَهُ وَبَيْنَ رَبِّهِ ، وَفِيمَا بَيْنَهُ وَبَيْنَ مَوَالِيهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بَشِيرِ بْنِ عَاصِمٍ  إِلَّا  عَمْرُو بْنُ أَبِي قَيْسٍ  ، وَرَوَاهُ  الثَّوْرِيُّ  ، عَنْ  أَبِي الْيَقْظَانِ  ، عَنْ  زَاذَانَ  ، عَنِ  ابْنِ عُمَرَ  .","","Al-Mu'jam al-Awsat 9280","","عبد الله بن عمر بن الخطاب عن زاذان الكندي عن عثمان بن عمير البجلي عن بشير بن عاصم الكوفي عن عمرو بن أبي قيس عن عبد الصمد بن عبد العزيز الرازي عن محمد بن عمار الرازي عن الوليد بن أبان بن بونة الأصبهاني عن الطبراني","الوليد بن أبان الأصبهاني"
"9289","9281  -  حَدَّثَنَا  الْوَلِيدُ ،  ثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ ،  حَدَّثَنِي  أَبُو الْوَلِيدِ الْجَارُودِيُّ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي ذِئْبٍ  إِلَّا  الْجَارُودِيُّ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ عَمَّارٍ  .","","Al-Mu'jam al-Awsat 9281","","أنس بن مالك عن الزهري عن محمد بن عبد الرحمن بن المغيرة عن موسى بن أبي الجارود الجاروذي عن محمد بن عمار الرازي عن الوليد بن أبان بن بونة الأصبهاني عن الطبراني","الوليد بن أبان الأصبهاني"
"9290","9282  -  حَدَّثَنَا  الْوَلِيدُ بْنُ أَبَانَ ،  نَا  أَبُو مَعِينٍ الرَّازِيُّ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْمَلِكِ بْنِ شَيْبَةَ الْحِزَامِيُّ ،  ثَنَا  أَبُو قَتَادَةَ بْنُ يَعْقُوبَ بْنِ عَبْدِ اللهِ بْنِ ثَعْلَبَةَ بْنِ صُعَيْرٍ الْعُذْرِيُّ ،  عَنِ  ابْنِ أَخِي الزُّهْرِيِّ ،  عَنِ  الزُّهْرِيِّ         [9/114]      عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَوْ كَانَ الْمُؤْمِنُ فِي جُحْرٍ  لَقَيَّضَ  اللهُ لَهُ فِيهِ مَنْ يُؤْذِيهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا ابْنُ أَخِيهِ ، وَلَا عَنِ ابْنِ أَخِيهِ إِلَّا  أَبُو قَتَادَةَ  ،  تَفَرَّدَ بِهِ  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْمَلِكِ بْنِ شَيْبَةَ  .","","Al-Mu'jam al-Awsat 9282","","أنس بن مالك عن الزهري عن محمد بن عبد الله بن مسلم ابن أخي الزهري عن أبو قتادة بن يعقوب بن عبد الله بن ثعلبة بن صعير العذري عن عبد الرحمن بن عبد الملك الحزامي عن أبو معين الرازي عن الوليد بن أبان بن بونة الأصبهاني عن الطبراني","الوليد بن أبان الأصبهاني"
"9291","9283  -  حَدَّثَنَا  الْوَلِيدُ بْنُ أَبَانَ ،  أَنَا  مُحَمَّدُ بْنُ عَمَّارٍ الرَّازِيُّ ،  نَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  أَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ، قَالَ :  كُنْتُ عِنْدَ عَائِشَةَ ، وَعِنْدَهَا  كَعْبٌ الْحَبْرُ  فَذَكَرَ  إِسْرَافِيلَ  ،  فَقَالَتْ  عَائِشَةُ  : يَا  كَعْبُ  ، أَخْبِرْنِي عَنْ  إِسْرَافِيلَ  ، فَقَالَ  كَعْبٌ  : عِنْدَكُمُ الْعِلْمُ ، فَقَالَتْ : أَجَلْ ، فَأَخْبِرْنِي ، قَالَ :  لَهُ أَرْبَعَةُ أَجْنِحَةٍ ، جَنَاحَانِ فِي الْهَوَاءِ ، وَجَنَاحٌ قَدْ تَسَرْبَلَ بِهِ  ، وَجَنَاحٌ عَلَى كَاهِلِهِ ، وَالْعَرْشُ عَلَى كَاهِلِهِ وَالْقَلَمُ عَلَى أُذُنِهِ ، فَإِذَا نَزَلَ الْوَحْيُ كَتَبَ الْقَلَمُ ، ثُمَّ دَرَسَتِ الْمَلَائِكَةُ ، وَمَلَكُ الصُّورِ جَاثٍ عَلَى إِحْدَى رُكْبَتَيْهِ ، وَقَدْ نُصِبَتِ الْأُخْرَى ، فَالْتَقَمَ الصُّورَ ، مَحْنِيٌّ ظَهْرُهُ ، شَاخِصٌ بَصَرُهُ إِلَى  إِسْرَافِيلَ  ، وَقَدْ أُمِرَ إِذَا رَأَى  إِسْرَافِيلَ  قَدْ ضَمَّ جَنَاحَهُ أَنْ يَنْفُخَ فِي  الصُّورِ  "" ، فَقَالَتْ  عَائِشَةُ  : "" هَكَذَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حَمَّادِ بْنِ زَيْدٍ  إِلَّا  مُؤَمَّلٌ  .","","Al-Mu'jam al-Awsat 9283","","عائشة بنت أبي بكر الصديق عن عبد الله بن الحارث الأنصاري عن علي بن زيد بن جدعان عن حماد بن زيد عن مؤمل بن إسماعيل العدوي عن محمد بن عمار الرازي عن الوليد بن أبان بن بونة الأصبهاني عن الطبراني","الوليد بن أبان الأصبهاني"
"9292","[9/115]      بَابُ الْهَاءِ  ذِكْرُ مَنِ اسْمُهُ : هَاشِمٌ  9284  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ،  نَا  أَبُو صَالِحٍ الْفَرَّاءُ ،  ثَنَا  أَبُو إِسْحَاقَ الْفَزَارِيُّ ،  عَنْ  أَبِي إِسْحَاقَ الشَّيْبَانِيِّ ،  ثَنَا  مُحَارِبُ بْنُ دِثَارٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ يَزِيدَ ، يَقُولُ عَلَى الْمِنْبَرِ :  حَدَّثَنِي  الْبَرَاءُ بْنُ عَازِبٍ - وَكَانَ مَا عَلِمْتُ غَيْرَ كَذُوبٍ -  أَنَّهُمْ كَانُوا يُصَلُّونَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَإِذَا رَكَعَ رَكَعُوا ، وَإِذَا قَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ "" لَمْ يَزَالُوا قِيَامًا حَتَّى يَرَوْهُ قَدْ وَضَعَ وَجْهَهُ فِي الْأَرْضِ  ، ثُمَّ يَتَّبِعُونَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ الشَّيْبَانِيِّ  إِلَّا  أَبُو إِسْحَاقَ الْفَزَارِيُّ  .","","Al-Mu'jam al-Awsat 9284","","البراء بن عازب الأوسي عن عبد الله بن يزيد بن زيد الخطمي عن محارب بن دثار عن سليمان بن فيروز الشيباني عن أبو إسحاق الفزاري عن محبوب بن موسى الفراء عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9293","9285  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  يَحْيَى بْنُ مَعِينٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبَانَ الْوَرَّاقُ ،  نَا  مِسْعَرٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  دَخَلْتُ الْجَنَّةَ فَإِذَا أَنَا بِقَصْرٍ ، فَقُلْتُ : لِمَنْ هَذَا  ؟ فَقِيلَ :  لِعُمَرَ بْنِ الْخَطَّابِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مِسْعَرٍ  إِلَّا  إِسْمَاعِيلُ بْنُ أَبَانَ  ،  تَفَرَّدَ بِهِ  يَحْيَى بْنُ مَعِينٍ  .","","Al-Mu'jam al-Awsat 9285","","أنس بن مالك عن قتادة بن دعامة عن مسعر بن كدام عن إسماعيل بن أبان عن يحيى بن معين عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9294","9286  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ بَشِيرٍ الشَّيْبَانِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  قَرَأَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالنَّجْمِ  ، فَلَمَّا بَلَغَ السَّجْدَةَ سَجَدَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  مُحَمَّدُ بْنُ إِسْحَاقَ  ، وَلَا عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ بَشِيرٍ  ،  تَفَرَّدَ بِهِ  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ  .","","Al-Mu'jam al-Awsat 9286","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن محمد بن إسحاق عن عبد الرحمن بن بشير الدمشقي عن سليمان بن عبد الرحمن التميمي عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9295","9287  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  عَبْدُ اللهِ بْنُ كَثِيرٍ         [9/116]      الْقَارِئُ ،  ثَنَا  زُهَيْرُ بْنُ مُحَمَّدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي حُسَيْنٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَا  مُغِيرَةُ  ، إِذَا أَرَدْتَ أَنْ تَنْكِحَ امْرَأَةً فَلَا تَنْكِحْهَا حَتَّى تَنْظُرَ إِلَيْهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي حُسَيْنٍ  إِلَّا  زُهَيْرُ بْنُ مُحَمَّدٍ  ، وَلَا عَنْ  زُهَيْرٍ  إِلَّا  عَبْدُ اللهِ بْنُ كَثِيرٍ  ،  تَفَرَّدَ بِهِ  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ  .","","Al-Mu'jam al-Awsat 9287","","المغيرة بن شعبة عن عبد الرحمن بن أبي حسين عن عبد الله بن عبد الرحمن بن أبي حسين النوفلي عن زهير بن محمد التميمي عن عبد الله بن كثير الطويل الدمشقي عن سليمان بن عبد الرحمن التميمي عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9296","9288  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ خَالِدِ بْنِ أَبِي يَزِيدَ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  مُجَالِدِ بْنِ سَعِيدٍ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنْ  مَسْرُوقٍ ،  عَنْ  زَيْنَبَ ، - امْرَأَةِ عَبْدِ اللهِ - قَالَتْ :  جَمَعْتُ مُوَئْلًا لِي مِنَ الصَّدَقَةِ ،  فَأَتَيْتُ  عَائِشَةَ ، فَقُلْتُ : يَا أُمَّ الْمُؤْمِنِينَ ، إِنِّي جَمَعْتُ مُوَئْلًا لِي مِنَ الصَّدَقَةِ ، فَسَلِي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : فِي أَيِّ ذَلِكَ أَجْعَلُهُ ؟ أَفِي رَقَبَةٍ  أُعْتِقُهَا  ؟ أَمْ فِي  سَبِيلِ  اللهِ ؟ أَمْ عَلَى زَوْجٍ مَجْهُودٍ وَبَنِي أَخٍ أَيْتَامٍ ؟ ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  عَائِشَةَ  ، فَذَكَرَتْ لَهُ  عَائِشَةُ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَصَدَّقُهُ عَنْ زَوْجٍ مَجْهُودٍ وَبَنِي أَخٍ أَيْتَامٍ  ، إِنَّ الصَّدَقَةَ عَلَى ذِي الْقَرَابَةِ تَضْعُفُ مَرَّتَيْنِ فِي الْأَجْرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ  إِلَّا  خَالِدُ بْنُ أَبِي يَزِيدَ  .","","Al-Mu'jam al-Awsat 9288","","عائشة بنت أبي بكر الصديق عن زينب بنت معاوية رائطة عن مسروق بن الأجدع عن الشعبي عن مجالد بن سعيد عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9297","9289  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ عَيَّاشٍ الْحِمْصِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  أَبُو الْأَشْعَثِ جَعْفَرُ بْنُ الْحَارِثِ النَّخَعِيُّ الْكُوفِيُّ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَةَ ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  رَافِعِ بْنِ خَدِيجٍ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَسْفِرُوا  بِالْفَجْرِ ؛ فَإِنَّهُ أَعْظَمُ لِلْأَجْرِ  .         [9/117]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَعْفَرِ بْنِ الْحَارِثِ  إِلَّا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ إِسْمَاعِيلَ  .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( أبو الأشهب )","","Al-Mu'jam al-Awsat 9289","","رافع بن خديج الأنصاري عن محمود بن لبيد الأشهلي عن عاصم بن عمر الظفري عن محمد بن إسحاق عن جعفر بن الحارث الواسطي عن إسماعيل بن عياش الأحول عن محمد بن إسماعيل بن عياش العنسي عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9298","9290  -  حَدَّثَنَا  هَاشِمٌ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  نَا  مُوسَى بْنُ أَعْيَنَ ،  عَنِ  الْمُعَلَّى بْنِ عُرْفَانَ ،  عَنْ  أَبِي وَائِلٍ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَتَنَفَّسُ  فِي الْإِنَاءِ ثَلَاثَةَ أَنْفَاسٍ  ، يُسَمِّي عِنْدَ كُلِّ نَفَسٍ ، وَيَشْكُرُ فِي آخِرِهِنَّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي وَائِلٍ  إِلَّا  الْمُعَلَّى بْنُ عُرْفَانَ  ،  تَفَرَّدَ بِهِ  مُوسَى بْنُ أَعْيَنَ  .","","Al-Mu'jam al-Awsat 9290","","عبد الله بن مسعود عن شقيق بن سلمة عن معلى بن عرفان الأسدي عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9299","9291  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  نَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ :  سَمِعْتُ  الزُّهْرِيَّ ،  يُحَدِّثُ عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا نِكَاحَ إِلَّا بِوَلِيٍّ وَشَاهِدَيْ عَدْلٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُثْمَانَ بْنِ عَبْدِ الرَّحْمَنِ  إِلَّا  عِيسَى بْنُ يُونُسَ  .","","Al-Mu'jam al-Awsat 9291","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن عثمان بن عبد الرحمن بن عمر الوقاصي عن عيسى بن يونس بن أبي إسحاق عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9300","9292  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  نَا  مُوسَى بْنُ أَعْيَنَ ،  عَنِ  الْخَلِيلِ بْنِ مُرَّةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ حَفَرَ قَبْرًا بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  ، وَمَنْ  غَسَّلَ  مَيِّتًا خَرَجَ مِنَ الْخَطَايَا كَيَوْمِ وَلَدَتْهُ أُمُّهُ ، وَمَنْ كَفَّنَ         [9/118]      مَيِّتًا كَسَاهُ اللهُ أَثْوَابًا مِنْ حُلَلِ الْجَنَّةِ ، وَمَنْ  عَزَّى  حَزِينًا أَلْبَسَهُ اللهُ التَّقْوَى وَصَلَّى عَلَى رُوحِهِ فِي الْأَرْوَاحِ ، وَمَنْ  عَزَّى  مُصَابًا كَسَاهُ اللهُ حُلَّتَيْنِ مِنْ حُلَلِ الْجَنَّةِ لَا يَقُومُ لَهُمَا الدُّنْيَا ، وَمَنِ اتَّبَعَ جِنَازَةً حَتَّى يُقْضَى دَفْنُهَا كُتِبَ لَهُ ثَلَاثَةُ قَرَارِيطَ ، الْقِيرَاطُ مِنْهَا أَعْظَمُ مِنْ  جَبَلِ أُحُدٍ  ، وَمَنْ كَفَلَ يَتِيمًا أَوْ أَرْمَلَةً أَظَلَّهُ اللهُ فِي ظِلِّهِ وَأَدْخَلَهُ جَنَّتَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْخَلِيلِ بْنِ مُرَّةَ  إِلَّا  مُوسَى بْنُ أَعْيَنَ  ، وَلَا يُرْوَى عَنْ  جَابِرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  . وَلَمْ يُنْسَبْ لَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ  الَّذِي رَوَى هَذَا الْحَدِيثَ .","","Al-Mu'jam al-Awsat 9292","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن إسماعيل بن إبراهيم عن الخليل بن مرة الضبعي عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9301","9293  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  نَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  عَبْدِ الْوَهَّابِ بْنِ بُخْتٍ ،  عَنْ  عَبْدِ اللهِ بْنِ نَافِعٍ أَبِي يَعْقُوبَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَعُوذُ بِكَ مِنْ فِتْنَةِ  الْمَسِيحِ الدَّجَّالِ  ، وَمِنْ عَذَابِ الْقَبْرِ  ، وَمِنْ فِتْنَةِ الْقَبْرِ ، وَمِنْ شَرِّ فِتْنَةِ الْغِنَى ، وَمِنْ شَرِّ فِتْنَةِ الْفَقْرِ ، وَأَعُوذُ بِكَ مِنْ شَرِّ فِتْنَةِ  الْمَسِيحِ الدَّجَّالِ  ، اللَّهُمَّ  اغْسِلْ  خَطَايَايَ بِمَاءِ  الثَّلْجِ  وَالْبَرَدِ ، وَنَقِّ قَلْبِي مِنَ الْخَطَايَا كَمَا نَقَّيْتَ الثَّوْبَ الْأَبْيَضَ مِنَ الدَّنَسِ ، وَأَعُوذُ بِكَ مِنَ الْكَسَلِ  وَالْهَرَمِ  وَالْمَأْثَمِ  وَالْمَغْرَمِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ نَافِعٍ  إِلَّا  عَبْدُ الْوَهَّابِ بْنُ بُخْتٍ  ، وَلَا عَنْ  عَبْدِ الْوَهَّابِ  إِلَّا  خَالِدُ بْنُ أَبِي يَزِيدَ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ سَلَمَةَ  .","","Al-Mu'jam al-Awsat 9293","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أبو يعقوب عبد الله بن نافع عن عبد الوهاب بن بخت الأموي عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9302","9294  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  نَا  مُحَمَّدُ بْنُ سَلَمَةَ         [9/119]      عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عُلَاثَةَ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ حَلَفَ عَلَى يَمِينٍ  مَصْبُورَةٍ  ، هُوَ فِيهَا كَاذِبٌ ،  فَلْيَتَبَوَّأْ  لِوَجْهِهِ مَقْعَدَهُ مِنَ النَّارِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامٍ  إِلَّا  ابْنُ عُلَاثَةَ  .","","Al-Mu'jam al-Awsat 9294","","أبو هريرة الدوسي عن محمد بن سيرين عن هشام بن حسان العتكي عن قاضي الجن محمد بن عبد الله بن علاثة عن محمد بن سلمة الباهلي عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9303","9295  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ  ، قَالَ :  أَتَى  عَبْدُ اللهِ بْنُ عُمَرَ  ، فَقِيلَ لَهُ : إِنَّ  ابْنَ عَبَّاسٍ  يَأْمُرُ بِنِكَاحِ  الْمُتْعَةِ  ، فَقَالَ  ابْنُ عُمَرَ  : سُبْحَانَ اللهِ ، مَا أَظُنُّ  ابْنَ عَبَّاسٍ  يَفْعَلُ هَذَا ، قَالُوا : بَلَى ، إِنَّهُ يَأْمُرُ بِهِ ، فَقَالَ : وَهَلْ كَانَ  ابْنُ عَبَّاسٍ  إِلَّا غُلَامًا صَغِيرًا إِذْ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . ثُمَّ  قَالَ  ابْنُ عُمَرَ :  نَهَانَا عَنْهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَا كُنَّا مُسَافِحِينَ  .","","Al-Mu'jam al-Awsat 9295","","عبد الله بن عمر بن الخطاب عن سالم بن عبد الله بن عمر بن الخطاب عن الزهري عن إسحاق بن راشد الجزري عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9304","9296  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  نَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الْمُشْرِكِينَ لَا يَصْبُغُونَ لِحَاهُمْ  ، فَغَيِّرُوا الشَّيْبَ  .","","Al-Mu'jam al-Awsat 9296","","أبو هريرة الدوسي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن الزهري عن إسحاق بن راشد الجزري عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9305","9297  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَبِي بَكْرِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَكَلَ مِنْكُمْ فَلْيَأْكُلْ بِيَمِينِهِ  ، وَلْيَشْرَبْ بِيَمِينِهِ ؛ فَإِنَّ الشَّيْطَانَ يَأْكُلُ بِشِمَالِهِ ، وَيَشْرَبُ بِشِمَالِهِ  .","","Al-Mu'jam al-Awsat 9297","","عبد الله بن عمر بن الخطاب عن أبو بكر بن عبيد الله بن عبد الله بن عمر بن الخطاب عن الزهري عن إسحاق بن راشد الجزري عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9306","9298  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ  ، ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  نَا  مُوسَى بْنُ أَعْيَنَ         [9/120]      عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  ابْنِ كَعْبِ بْنِ مَالِكٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" أَنَّهُ  كَانَ لَا يَقْدَمُ مِنْ سَفَرٍ إِلَّا ضُحًى  ، فَيَبْدَأُ بِالْمَسْجِدِ فَيَرْكَعُ فِيهِ رَكْعَتَيْنِ ، ثُمَّ يَأْتِي أَهْلَهُ بَعْدَ ذَلِكَ  .","","Al-Mu'jam al-Awsat 9298","","كعب بن مالك الأنصاري عن عبد الله بن كعب بن مالك عن الزهري عن إسحاق بن راشد الجزري عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9307","9299  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  نَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُرَغِّبُ النَّاسَ فِي قِيَامِ رَمَضَانَ  مِنْ غَيْرِ أَنْ يَأْمُرَهُمْ بِعَزِيمَةِ أَمْرٍ فِيهِ ، ثُمَّ تُوُفِّيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَالْأَمْرُ عَلَى ذَلِكَ ، ثُمَّ كَانَ الْأَمْرُ عَلَى ذَلِكَ خِلَافَةَ  أَبِي بَكْرٍ  وَصَدْرًا مِنْ خِلَافَةِ  عُمَرَ  رَضِيَ اللهُ عَنْهُمَا  .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ  إِلَّا  مُوسَى بْنُ أَعْيَنَ  .","","Al-Mu'jam al-Awsat 9299","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن إسحاق بن راشد الجزري عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9308","9300  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  ثَنَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  إِبْرَاهِيمَ النَّخَعِيِّ ،  عَنِ  الْأَسْوَدِ بْنِ يَزِيدَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُوتِرُ بِتِسْعِ رَكَعَاتٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءِ بْنِ السَّائِبِ  إِلَّا  مُوسَى بْنُ أَعْيَنَ  .","","Al-Mu'jam al-Awsat 9300","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن عطاء بن السائب عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9309","9301  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  الْمُعَافَى بْنُ سُلَيْمَانَ ،  نَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ خَالِدِ بْنِ أَبِي يَزِيدَ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ الْبَجَلِيِّ ، قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ لَيْلَةٍ وَالْقَمَرُ طَالِعٌ لَيْلَةَ الْبَدْرِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَمَا إِنَّكُمْ سَتُعَايِنُونَ رَبَّكُمْ فِي الْجَنَّةِ كَمَا تُعَايِنُونَ هَذَا الْقَمَرَ  ، لَا  تُضَامُونَ  فِي رُؤْيَتِهِ ، فَإِنِ اسْتَطَعْتُمْ أَنْ لَا تُغْلَبُوا عَلَى صَلَاةٍ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا "" ، ثُمَّ قَرَأَ :         {      وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ الْغُرُوبِ         }      .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ  إِلَّا  أَبُو عَبْدِ الرَّحِيمِ  .  وَلَمْ يَقُلْ أَحَدٌ مِمَّنْ رَوَى هَذَا الْحَدِيثَ عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ  : ""  تُعَايِنُونَ رَبَّكُمْ  ""         [9/121]      إِلَّا  زَيْدُ بْنُ أَبِي أُنَيْسَةَ  وَأَبُو شِهَابٍ الْحَنَّاطُ  .","","Al-Mu'jam al-Awsat 9301","","جرير بن عبد الله بن جابر يوسف الأمة عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن المعافى بن سليمان الرسعني عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9310","9302  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْجَعْفَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَلَمَةَ الرَّبَعِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي صَعْصَعَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ وَسَّعَ عَلَى أَهْلِهِ فِي يَوْمِ عَاشُورَاءَ  أَوْسَعَ اللهُ عَلَيْهِ سَنَتَهُ كُلَّهَا  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْجَعْفَرِيُّ  .","","Al-Mu'jam al-Awsat 9302","","أبو سعيد الخدري عن عبد الله بن عبد الرحمن بن أبي صعصعة المازني عن محمد بن عبد الله بن عبد الرحمن بن أبي صعصعة الأنصاري عن عبد الله بن سلمة الربعي عن محمد بن إسماعيل بن جعفر الجعفري عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9311","9303  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  قَرَظَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَالْحَبَشَةُ  يَلْعَبُونَ ، وَأَنَا أَطَّلِعُ مِنْ  خَوْخَةٍ  لِي ، فَدَنَا مِنِّي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَوَضَعْتُ يَدَيَّ عَلَى مَنْكِبَيْهِ ، وَجَعَلْتُ أَنْظُرُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّهُنَّ بَنَاتُ  أَرْفِدَةَ  فَمَا زِلْتُ أَنْظُرُ وَهُمْ يَلْعَبُونَ وَيَرْقُصُونَ حَتَّى كُنْتُ أَنَا الَّذِي انْتَهَيْتُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَرَظَةَ  إِلَّا  إِسْرَائِيلُ  ،  تَفَرَّدَ بِهِ  آدَمُ  .","","Al-Mu'jam al-Awsat 9303","","عائشة بنت أبي بكر الصديق عن عكرمة مولى ابن عباس عن قرظة عن إسرائيل بن يونس بن أبي إسحاق عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9312","9304  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  نَا  حِبَّانُ بْنُ عَلِيٍّ ،  نَا  سَعْدُ بْنُ طَرِيفٍ الْإِسْكَافُ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَرَادَ الْحَاجَةَ  أَبْعَدَ  الْمَشْيَ ، فَانْطَلَقَ ذَاتَ يَوْمٍ لِحَاجَتِهِ ، ثُمَّ تَوَضَّأَ ، وَلَبِسَ أَحَدَ خُفَّيْهِ ، فَجَاءَ طَائِرٌ أَخْضَرُ فَأَخَذَ الْخُفَّ الْآخَرَ ، فَارْتَفَعَ بِهِ ثُمَّ أَلْقَاهُ ، فَخَرَجَ مِنْهُ أَسْوَدُ سَابِحٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  هَذِهِ كَرَامَةٌ ، أَكْرَمَنِي اللهُ بِهَا  ، ثُمَّ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ شَرِّ مَنْ يَمْشِي عَلَى بَطْنِهِ ، وَمِنْ شَرِّ مَنْ يَمْشِي عَلَى رِجْلَيْنِ ، وَمِنْ شَرِّ مَنْ         [9/122]      يَمْشِي عَلَى أَرْبَعٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عِكْرِمَةَ  إِلَّا  سَعْدُ بْنُ طَرِيفٍ  ،  تَفَرَّدَ بِهِ  حِبَّانُ بْنُ عَلِيٍّ  ، وَلَا يُرْوَى عَنِ  ابْنِ عَبَّاسٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9304","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سعد بن طريف الإسكاف عن حبان بن علي العنزي عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9313","9305  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  نَا  ابْنُ أَبِي فُدَيْكٍ الْمَدَنِيُّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ زَيْدٍ ،  عَنْ  مُصْعَبِ بْنِ مُصْعَبٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَلَّمَ  طَلْحَةُ بْنُ عُبَيْدِ اللهِ  عَامِرَ بْنَ فُهَيْرَةَ  بِشَيْءٍ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَهْلًا يَا  طَلْحَةُ  ؛ فَإِنَّهُ قَدْ شَهِدَ  بَدْرًا  كَمَا شَهِدْتَهُ  ، وَخَيْرُكُمْ خَيْرُكُمْ لِمَوَالِيهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  مُصْعَبُ بْنُ مُصْعَبٍ  ، وَلَا عَنْ  مُصْعَبٍ  إِلَّا  عَبْدُ الْمَلِكِ بْنُ زَيْدٍ  ، وَلَا عَنْ  عَبْدِ الْمَلِكِ  إِلَّا  ابْنُ أَبِي فُدَيْكٍ  ،  تَفَرَّدَ بِهِ  آدَمُ  ، وَلَا يُرْوَى عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9305","","عبد الرحمن بن عوف بن عبد عوف القرشي عن أبو سلمة بن عبد الرحمن عن الزهري عن مصعب بن مصعب بن عبد الرحمن الزهري عن عبد الملك بن زيد بن سعيد القرشي عن محمد بن إسماعيل بن مسلم الديلي عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9314","9306  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  جَابِرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ ، قَالَ :  احْتَجَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى قَرْنِهِ بَعْدَمَا سُمَّ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ اللهِ بْنِ جَعْفَرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  شَيْبَانُ  .","","Al-Mu'jam al-Awsat 9306","","عبد الله بن جعفر بن أبي طالب بن عبد المطلب عن أبو جعفر الباقر عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9315","9307  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ ، قَالَ :  اضْطَجَعَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى حَصِيرٍ ، فَأَثَّرَ الْحَصِيرُ بِجِلْدِهِ ، فَلَمَّا اسْتَيْقَظَ جَعَلْتُ أَمْسَحُ عَنْهُ ، وَأَقُولُ : يَا رَسُولَ اللهِ أَلَا آذَنْتَنِي قَبْلَ أَنْ تَنَامَ عَلَى هَذَا الْحَصِيرِ فَأَبْسُطَ لَكَ عَلَيْهِ شَيْئًا يَقِيكَ مِنْهُ ؟ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا لِي وَمَا لِلدُّنْيَا ، وَمَا لِلدُّنْيَا وَمَا لِي  ، مَا أَنَا وَالدُّنْيَا إِلَّا كَرَاكِبٍ اسْتَظَلَّ فِي فَيْءِ شَجَرَةٍ ،         [9/123]      ثُمَّ  رَاحَ  وَتَرَكَهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمْرِو بْنِ مُرَّةَ  إِلَّا  الْمَسْعُودِيُّ  .","","Al-Mu'jam al-Awsat 9307","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن عمرو بن مرة المرادي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9316","9308  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  نَا  وَرْقَاءُ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمَّا نَزَلَتْ هَذِهِ الْآيَةُ :         {      آمَنَ الرَّسُولُ بِمَا أُنْـزِلَ إِلَيْهِ مِنْ رَبِّهِ وَالْمُؤْمِنُونَ         }      قَرَأَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ، فَلَمَّا بَلَغَ :         {      غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ الْمَصِيرُ         }      قَالَ اللهُ : "" قَدْ غَفَرْتُ لَكُمْ . "" فَلَمَّا قَالَ :         {      رَبَّنَا لا تُؤَاخِذْنَا إِنْ نَسِينَا أَوْ أَخْطَأْنَا رَبَّنَا         }      قَالَ اللهُ : "" لَا أُؤَاخِذُكُمْ . "" فَلَمَّا قَالَ :         {      وَلا تَحْمِلْ عَلَيْنَا إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِنْ قَبْلِنَا         }      قَالَ اللهُ عَزَّ وَجَلَّ : "" لَا أَحْمِلُ عَلَيْكُمْ "" ، فَلَمَّا قَالَ :         {      وَلا تُحَمِّلْنَا مَا لا طَاقَةَ لَنَا بِهِ         }      قَالَ اللهُ تَبَارَكَ وَتَعَالَى : "" لَا أُحَمِّلُكُمْ         {      وَاعْفُ عَنَّا         }      قَالَ : "" قَدْ عَفَوْتُ عَنْكُمْ "" ، فَلَمَّا قَالَ :         {      وَاغْفِرْ لَنَا         }      قَالَ : "" قَدْ غَفَرْتُ لَكُمْ "" ، فَلَمَّا قَالَ :         {      وَارْحَمْنَا         }      قَالَ : "" قَدْ رَحِمْتُكُمْ "" ، فَلَمَّا قَالَ :         {      فَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ         }      قَالَ : "" قَدْ نَصَرْتُكُمْ عَلَى  الْقَوْمِ  الْكَافِرِينَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءٍ  إِلَّا  وَرْقَاءُ  ،  تَفَرَّدَ بِهِ  آدَمُ  .","","Al-Mu'jam al-Awsat 9308","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن عطاء بن السائب عن ورقاء بن عمر عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9317","9309  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  مَنْصُورِ بْنِ الْمُعْتَمِرِ ،  عَنْ  رِبْعِيِّ بْنِ حِرَاشٍ ،  عَنْ  خَرَشَةَ بْنِ الْحُرِّ ،  عَنْ  أَبِي ذَرٍّ قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا اسْتَيْقَظَ قَالَ :  الْحَمْدُ لِلهِ الَّذِي أَحْيَانَا بَعْدَمَا  أَمَاتَنَا  وَإِلَيْهِ  النُّشُورُ  ، وَكَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا قَامَ قَالَ :  بِاسْمِكَ اللَّهُمَّ نَمُوتُ وَنَحْيَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَنْصُورٍ  إِلَّا  شَيْبَانُ  .","","Al-Mu'jam al-Awsat 9309","","أبو ذر الغفاري عن خرشة بن الحر الفزاري عن ربعي بن حراش العبسي عن منصور بن المعتمر عن شيبان بن عبد الرحمن المؤدب عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9318","9310  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  وَرْقَاءُ ،  عَنْ  مُغِيرَةَ ،  عَنِ  الشَّعْبِيِّ         [9/124]      عَنِ  النُّعْمَانِ بْنِ بَشِيرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَثَلُ الْقَائِمِ عَلَى حُدُودِ اللهِ وَالْمُدَاهِنِ فِي حُدُودِ اللهِ  وَالرَّاكِبِ حُدُودَ اللهِ كَمَثَلِ نَفَرٍ ثَلَاثَةٍ كَانُوا فِي سَفِينَةٍ ، فَتَوَزَّعُوا مَنَازِلَهَا ، فَصَارَ مَكَانُ  النِّزِّ  وَمِهَرَاقُ الْمَاءِ لِأَحَدِهِمْ ، فَتَأَذَّوْا بِهِ ، فَأَخَذَ الْقَدُومَ فَقَرَعَ مَكَانَهُ ، فَقَالَ أَحَدُ الْبَاقِينَ لِلْآخَرِ : أَلَا تَرَى هَذَا الَّذِي يُرِيدُ أَنْ يَخْرِقَ سَفِينَتَنَا فَيُغْرِقَنَا ؟ فَقَالَ لَهُ الْآخَرُ : دَعْهُ ؛ فَإِنَّمَا يَخْرِقُ مَكَانَهُ "" ، قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" فَإِنْ مَنَعُوهُ سَلِمَ وَسَلِمُوا ، وَإِنْ تَرَكُوهُ غَرِقَ وَغَرِقُوا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  وَرْقَاءَ  إِلَّا  آدَمُ  .","","Al-Mu'jam al-Awsat 9310","","النعمان بن بشير الأنصاري عن الشعبي عن المغيرة بن مقسم الضبي عن ورقاء بن عمر عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9319","9311  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا اغْتَسَلَ مِنَ الْجَنَابَةِ غَسَلَ كَفَّيْهِ ثَلَاثَ مَرَّاتٍ قَبْلَ أَنْ يَغْمِسَهَا فِي الْإِنَاءِ  ، ثُمَّ أَفْرَغَ بِيَمِينِهِ عَلَى شِمَالِهِ ، يَغْسِلُ فَرْجَهُ حَتَّى يُنْقِيَهُ بِشِمَالِهِ ، ثُمَّ تَوَضَّأَ وُضُوءَهُ لِلصَّلَاةِ "" ، قَالَتْ : "" وَكَانَ لَهُ شَعَرٌ ، وَكَانَ يَأْخُذُ الْمَاءَ فَيُدْخِلُهُ فِي أُصُولِ شَعَرِهِ يُخَلِّلُهُ ، حَتَّى إِذَا اسْتَبْرَأَ الْبَشَرَةَ أَفْرَغَ عَلَى رَأْسِهِ ثَلَاثًا ، ثُمَّ أَفْرَغَ عَلَى جَسَدِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُبَارَكِ بْنِ فَضَالَةَ  إِلَّا  آدَمُ  ،  وَأَبُو النَّضْرِ هَاشِمُ بْنُ الْقَاسِمِ  .","","Al-Mu'jam al-Awsat 9311","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مبارك بن فضالة عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9320","9312  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مُرَّةَ الْهَمْدَانِيِّ ،  عَنْ  أَبِي بَكْرٍ الصِّدِّيقِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَدْخُلُ الْجَنَّةَ سَيِّئُ  الْمَلَكَةِ  ، مَلْعُونٌ مَنْ ضَارَّ مُسْلِمًا ، أَوْ غَرَّهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الشَّعْبِيِّ  إِلَّا  جَابِرٌ الْجُعْفِيُّ  ، وَلَا رَوَاهُ عَنْ  جَابِرٍ         [9/125]      إِلَّا  شَيْبَانُ  وَأَبُو حَمْزَةَ السُّكَّرِيُّ  .","","Al-Mu'jam al-Awsat 9312","","أبو  بكر الصديق عن مرة بن شراحيل عن الشعبي عن جابر الجعفي عن شيبان بن عبد الرحمن المؤدب عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9321","9313  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ ، قَالَ :  قَالَتْ  فَاطِمَةُ  : وَاكَرْبَاهُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ لَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا بُنَيَّةُ إِنَّهُ قَدْ حَضَرَ مِنْ أَبِيكِ أَمْرٌ لَيْسَ اللهُ بِتَارِكٍ أَحَدًا مِنْهُ لِمُوَافَاةِ يَوْمِ الْقِيَامَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  ثَابِتٍ  إِلَّا  مُبَارَكُ بْنُ فَضَالَةَ  .","","Al-Mu'jam al-Awsat 9313","","أنس بن مالك عن ثابت البناني عن مبارك بن فضالة عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9322","9314  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  آدَمُ ،  نَا  شَيْبَانُ ،  ثَنَا  قَتَادَةُ ،  عَنْ  عَزْرَةَ بْنِ عَبْدِ الرَّحْمَنِ الْخُزَاعِيِّ ،  عَنْ  رَاشِدِ بْنِ خُنَيْسٍ الْحِمْصِيِّ  ، قَالَ مَرَّةً :  حُنَيْسٍ  .  عَنْ  عُبَادَةَ بْنِ الصَّامِتِ ، قَالَ :  عَادَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ :  هَلْ تَدْرُونَ مَنْ شُهَدَاءُ أُمَّتِي يَوْمَ الْقِيَامَةِ  ؟ ""  فَأَرَمَّ  الْقَوْمُ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، الْقَتِيلُ فِي  سَبِيلِ  اللهِ ، الصَّابِرُ الْمُحْتَسِبُ شَهِيدٌ ، فَقَالَ : "" إِنْ لَمْ يَكُنْ شُهَدَاءُ أُمَّتِي إِلَّا هَؤُلَاءِ إِنَّهُمْ إِذًا لَقَلِيلٌ ؛ الْقَتِيلُ فِي  سَبِيلِ  اللهِ  شَهِيدٌ  ، وَالْغَرِيقُ  شَهِيدٌ  ،  وَالْمَبْطُونُ  شَهِيدٌ  ، وَالطَّاعُونُ شَهَادَةٌ ، وَالنُّفَسَاءُ يَجُرُّهَا وَلَدُهَا  بِسَرَرِهِ  إِلَى الْجَنَّةِ  .         [9/126]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  شَيْبَانُ  وَسَعِيدُ بْنُ بَشِيرٍ  ، عَنْ  شَيْبَانَ  ،  تَفَرَّدَ بِهِ  آدَمُ  .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( راشد بن حبيش )","","Al-Mu'jam al-Awsat 9314","","عبادة بن الصامت عن راشد بن حبيش الرقي عن عزرة بن عبد الرحمن بن زرارة عن قتادة بن دعامة عن شيبان بن عبد الرحمن المؤدب عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9323","9315  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  نَا  أَبُو غَسَّانَ مُحَمَّدُ بْنُ مُطَرِّفٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  عَطَاءِ بْنِ يَسَارٍ ،  عَنِ  الصُّنَابِحِيِّ ،  عَنْ  عُبَادَةَ بْنِ الصَّامِتِ ، قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  خَمْسُ صَلَوَاتٍ افْتَرَضَهُنَّ اللهُ عَلَى عِبَادِهِ  ، مَنْ أَحْسَنَ وُضُوءَهُنَّ وَصَلَّاهُنَّ لِوَقْتِهِنَّ ، وَأَتَمَّ رُكُوعَهُنَّ وَسُجُودَهُنَّ وَخُشُوعَهُنَّ ، كَانَ لَهُ عَهْدٌ عَلَى اللهِ أَنْ يَغْفِرَ لَهُ ، وَمَنْ لَمْ يَفْعَلْ فَلَيْسَ لَهُ عَلَى اللهِ عَهْدٌ ، إِنْ شَاءَ عَذَّبَهُ ، وَإِنْ شَاءَ غَفَرَ لَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا  أَبُو غَسَّانَ  ،  تَفَرَّدَ بِهِ  آدَمُ  .","","Al-Mu'jam al-Awsat 9315","","عبادة بن الصامت عن عبد الله الصنابحي عن عطاء بن يسار الهلالي عن زيد بن أسلم عن محمد بن مطرف بن داود عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9324","9316  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أُمِّهِ  ،  عَنْ  عَائِشَةَ قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَوَضَّأُ بِالْمُدِّ  .  لَمْ يَرْوِهِ عَنْ  قَتَادَةَ  عَنِ  الْحَسَنِ  ، عَنْ أُمِّهِ ، عَنْ  عَائِشَةَ ،  إِلَّا  شَيْبَانُ  .","","Al-Mu'jam al-Awsat 9316","","عائشة بنت أبي بكر الصديق عن خيرة مولاة أم سلمة عن الحسن البصري عن قتادة بن دعامة عن شيبان بن عبد الرحمن المؤدب عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9325","9317  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنْ  بُشَيْرِ بْنِ يَسَارٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الرَّحِمُ  شِجْنَةٌ  مِنَ الرَّحْمَنِ  ، تَعَلَّقَتْ  بِحَقْوَيِ  الرَّحْمَنِ ، تَقُولُ : اللَّهُمَّ صِلْ مَنْ وَصَلَنِي ، وَاقْطَعْ مَنْ قَطَعَنِي  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ  ، عَنْ  بُشَيْرِ بْنِ يَسَارٍ  إِلَّا  أَبُو جَعْفَرٍ الرَّازِيُّ  .  وَرَوَاهُ  وَرْقَاءُ  ، عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ  ، عَنْ  سَعِيدِ بْنِ يَسَارٍ  ، عَنْ  أَبِي هُرَيْرَةَ  .","","Al-Mu'jam al-Awsat 9317","","أبو هريرة الدوسي عن بشير بن يسار الحارثي عن عبد الله بن دينار العدوي عن عيسى بن أبي عيسى الرازي عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9326","9318  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  آدَمُ ،  نَا  أَبُو يُوسُفَ الْقَاضِي ،  عَنْ         [9/127]      سَعْدِ بْنِ طَرِيفٍ ،  عَنِ  الْأَصْبَغِ بْنِ نُبَاتَةَ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ قَالَ :  نَزَلْنَا مَنْزِلًا فَآذَتْنَا الْبَرَاغِيثُ فَسَبَبْنَاهَا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَسُبُّوهَا ؛ فَنِعْمَتِ الدَّابَّةُ ؛ فَإِنَّهَا أَيْقَظَتْكُمْ لِذِكْرِ اللهِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَلِيٍّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  آدَمُ  .","","Al-Mu'jam al-Awsat 9318","","علي بن أبي طالب عن أصبغ بن نباتة الكوفي عن سعد بن طريف الإسكاف عن أبو يوسف يعقوب بن إبراهيم القاضي عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9327","9319  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  إِسْرَائِيلُ ،  عَنْ  جَابِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ نُجَىٍّ ،  عَنْ  عَلِيٍّ رَضِيَ اللهُ عَنْهُ  فِي قَوْلِ اللهِ :         {      مِنْهُمْ مَنْ قَصَصْنَا عَلَيْكَ وَمِنْهُمْ مَنْ لَمْ نَقْصُصْ عَلَيْكَ         }      ، قَالَ :  بَعَثَ اللهُ عَبْدًا  حَبَشِيًّا  نَبِيًّا  ، فَهُوَ مِمَّنْ لَمْ يَقْصُصْ عَلَى  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  ""  .  لَا يُرْوَى عَنْ  عَلِيٍّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  آدَمُ  .","","Al-Mu'jam al-Awsat 9319","","علي بن أبي طالب عن عبد الله بن نجي بن سلمة الحضرمي عن جابر الجعفي عن إسرائيل بن يونس بن أبي إسحاق عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9328","9320  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  مُبَارَكُ بْنُ فَضَالَةَ ،  نَا  زِيَادُ بْنُ جُبَيْرِ بْنِ حَيَّةَ ،  أَخْبَرَنِي  أَبِي  أَنَّ  النُّعْمَانَ بْنَ مُقَرِّنٍ ، قَالَ : "" إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا غَزَا فَلَمْ يُقَاتِلْ أَوَّلَ النَّهَارِ ، لَمْ يَعْجَلْ حَتَّى تَحْضُرَ الصَّلَوَاتُ  ، وَتَهُبَّ الْأَرْوَاحُ ، وَيَطِيبَ الْقِتَالُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادِ بْنِ جُبَيْرِ بْنِ حَيَّةَ  إِلَّا  مُبَارَكُ بْنُ فَضَالَةَ  .","","Al-Mu'jam al-Awsat 9320","","النعمان بن مقرن بن عائذ المزني عن جبير بن حية بن مسعود الثقفي عن زياد بن جبير الثقفي عن مبارك بن فضالة عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9329","9321  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  ثَنَا  آدَمُ ،  ثَنَا  شَيْبَانُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنِ  الْعُرْيَانِ بْنِ الْهَيْثَمِ ،  عَنْ  قَبِيصَةَ بْنِ جَابِرٍ الْأَسَدِيِّ قَالَ :  قَالَ  عَبْدُ اللهِ بْنُ مَسْعُودٍ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَلْعَنُ الْمُتَنَمِّصَاتِ ،         [9/128]      وَالْمُتَفَلِّجَاتِ  ، وَالْمُتَوَشِّمَاتِ ، وَاللَّاتِي يُغَيِّرْنَ خَلْقَ اللهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ  إِلَّا  شَيْبَانُ  .","","Al-Mu'jam al-Awsat 9321","","عبد الله بن مسعود عن قبيصة بن جابر بن وهب الأسدي عن العريان بن الهيثم عن عبد الملك بن عمير القبطي عن شيبان بن عبد الرحمن المؤدب عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9330","9322  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  زَكَرِيَّا بْنُ نَافِعٍ الْأُرْسُوفِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ الطَّائِفِيُّ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ لَمْ يَجِدْ إِزَارًا وَهُوَ مُحْرِمٌ ، فَوَجَدَ سَرَاوِيلًا فَلْيَلْبَسْهُ  ، وَمَنْ لَمْ يَجِدْ نَعْلَيْنِ فَلْيَلْبَسِ الْخُفَّيْنِ ، فَلْيَقْطَعْهُمَا أَسْفَلَ مِنَ  الْكَعْبَيْنِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمْرِو بْنِ دِينَارٍ  ، عَنْ  جَابِرٍ ،  إِلَّا  مُحَمَّدُ بْنُ مُسْلِمٍ  .","","Al-Mu'jam al-Awsat 9322","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن زكريا بن نافع الأرسوفي عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9331","9323  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ ،  نَا  مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ الرَّمْلِيُّ ،  نَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  إِبْرَاهِيمَ ،  عَنِ  الْأَسْوَدِ ،  عَنْ  عَائِشَةَ ،  وَعَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَأَنِّي أَنْظُرُ إِلَى  وَبِيصِ  الطِّيبِ فِي مَفْرِقِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يُلَبِّي  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ سَعِيدٍ  إِلَّا  أَبُو خَالِدٍ الْأَحْمَرُ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ  .","","Al-Mu'jam al-Awsat 9323","","عائشة بنت أبي بكر الصديق عن الأسود بن يزيد النخعي عن إبراهيم النخعي عن الأعمش عن سليمان بن حيان الأحمر عن محمد بن عبد العزيز بن محمد العمري عن هاشم بن مرثد الطيالسي عن الطبراني","هاشم بن مرثد الطبراني"
"9332","مَنِ اسْمُهُ :  هَمَّامٌ  9324  -  حَدَّثَنَا  هَمَّامُ بْنُ يَحْيَى بْنِ هَمَّامِ بْنِ مَسْلَمَةَ بْنِ عُقْبَةَ بْنِ هَمَّامِ بْنِ مُنَبِّهٍ الصَّنْعَانِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَحْمَدَ الْيَمَامِيُّ ،  نَا  يَزِيدُ بْنُ أَبِي حَكِيمٍ ،  نَا  يَاسِينُ الزَّيَّاتُ ،  عَنْ  أَشْعَثَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَبِي هُرَيْرَةَ ، وَأَبِي سَعِيدٍ ، قَالَا :  أَوَّلُ صَلَاةٍ فُرِضَتْ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الظُّهْرُ  .","","Al-Mu'jam al-Awsat 9324","","أبو سعيد الخدري عن الحسن البصري عن أشعث بن سوار عن ياسين بن معاذ الزيات عن يزيد بن أبي حكيم الكناني عن إبراهيم بن أحمد اليمامي عن همام بن يحيى بن همام الصنعاني عن الطبراني","همام بن يحيي الصنعاني"
"9333","[9/129]      9325  -  حَدَّثَنَا  هَمَّامُ بْنُ يَحْيَى ،  نَا  حَرِيزُ بْنُ الْمُسَلَّمِ الصَّنْعَانِيُّ ،  نَا  عَبْدُ الْمَجِيدِ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنْ  يَاسِينَ الزَّيَّاتِ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كَيْفَ بِكُمْ إِذَا فَسَقَ شَبَابُكُمْ ، وَطَغَى نِسَاؤُكُمْ ؟  قَالُوا : يَا رَسُولَ اللهِ ، إِنَّ ذَلِكَ لَكَائِنٌ ؟ قَالَ : "" وَشَرٌّ مِنْ ذَلِكَ سَيَكُونُ ، كَيْفَ بِكُمْ إِذَا رَأَيْتُمُ الْمَعْرُوفَ مُنْكَرًا وَالْمُنْكَرَ مَعْرُوفًا ؟  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا  يَاسِينُ  ، وَلَا عَنْ  يَاسِينَ  إِلَّا  عَبْدُ الْمَجِيدِ  ،  تَفَرَّدَ بِهِ  حَرِيزُ بْنُ الْمُسَلَّمِ  .","","Al-Mu'jam al-Awsat 9325","","أبو هريرة الدوسي عن ذكوان السمان عن الأعمش عن ياسين بن معاذ الزيات عن عبد المجيد بن عبد العزيز بن أبي رواد عن حريز بن مسلم بن حرير الصنعاني عن همام بن يحيى بن همام الصنعاني عن الطبراني","همام بن يحيي الصنعاني"
"9334","9326  -  حَدَّثَنَا  هَمَّامُ بْنُ يَحْيَى ،  نَا  حَرِيزُ بْنُ الْمُسَلَّمِ ،  نَا  عَبْدُ الْمَجِيدِ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تَنْتِفُوا الشَّيْبَ ؛ فَإِنَّهُ نُورٌ  ، وَمَنْ         [9/130]      شَابَ شَيْبَةً فِي الْإِسْلَامِ كُتِبَ لَهُ بِهَا عَشْرُ حَسَنَاتٍ ، وَحُطَّ عَنْهُ بِهَا خَطِيئَةٌ ، وَرُفِعَ لَهُ بِهَا دَرَجَةٌ  .","","Al-Mu'jam al-Awsat 9326","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن ليث بن أبي سليم عن عبد العزيز بن أبي رواد الخراساني عن عبد المجيد بن عبد العزيز بن أبي رواد عن حريز بن مسلم بن حرير الصنعاني عن همام بن يحيى بن همام الصنعاني عن الطبراني","همام بن يحيي الصنعاني"
"9335","9327  -  حَدَّثَنَا  هَمَّامُ بْنُ يَحْيَى ،  نَا  حَرِيزُ بْنُ الْمُسَلَّمِ ،  نَا  عَبْدُ الْمَجِيدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  لَيْثٍ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنِ  الْقَاسِمِ ،  عَنْ  عَائِشَةَ قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا أَسْكَرَ  الْفَرَقُ  مِنْهُ ،  فَالْحُسْوَةُ  مِنْهُ حَرَامٌ  .","","Al-Mu'jam al-Awsat 9327","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن عمرو بن سالم الأنصاري عن ليث بن أبي سليم عن عبد العزيز بن أبي رواد الخراساني عن عبد المجيد بن عبد العزيز بن أبي رواد عن حريز بن مسلم بن حرير الصنعاني عن همام بن يحيى بن همام الصنعاني عن الطبراني","همام بن يحيي الصنعاني"
"9336","9328  -  حَدَّثَنَا  هَمَّامُ بْنُ يَحْيَى ،  ثَنَا  حَرِيزُ بْنُ الْمُسَلَّمِ ،  نَا  عَبْدُ الْمَجِيدِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَاصِمِ بْنِ ضَمْرَةَ ، قَالَ :  سَأَلْنَا  عَلِيًّا عَنْ صَلَاةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالنَّهَارِ ، فَقَالَ : إِنَّكُمْ لَا تُطِيقُونَهَا ، قَالُوا : إِنَّا نُحِبُّ أَنْ نَعْلَمَهَا ، قَالَ :  كَانَ يُمْهِلُ حَتَّى إِذَا كَانَتِ الشَّمْسُ مِنْ مَشْرِقِهَا كَنَحْوِ الْعَصْرِ مِنْ مَغْرِبِهَا أَتَى أَهْلَهُ  فَيَقِيلُ إِنْ بَدَا لَهُ ، فَإِذَا زَالَتِ الشَّمْسُ قَامَ فَصَلَّى أَرْبَعَ رَكَعَاتٍ ، وَيُصَلِّي بَعْدَ الظُّهْرِ رَكْعَتَيْنِ ، وَقَبْلَ الْعَصْرِ أَرْبَعَ رَكَعَاتٍ  "" .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنْ  عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ  إِلَّا ابْنُهُ ،  تَفَرَّدَ بِهِ  حَرِيزُ بْنُ الْمُسَلَّمِ  .","","Al-Mu'jam al-Awsat 9328","","علي بن أبي طالب عن عاصم بن ضمرة السلولي عن أبو إسحاق السبيعي عن عبد العزيز بن أبي رواد الخراساني عن عبد المجيد بن عبد العزيز بن أبي رواد عن حريز بن مسلم بن حرير الصنعاني عن همام بن يحيى بن همام الصنعاني عن الطبراني","همام بن يحيي الصنعاني"
"9337","مَنِ اسْمُهُ :  هَارُونُ  9329  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ الْمِصْرِيُّ ،  نَا  عَبْدُ اللهِ بْنُ يَزِيدَ ، - أَخُو عَبْدِ الرَّحْمَنِ الْمُقْرِئِ  -  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  عَنْ  أَبِي صَخْرٍ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ قُسَيْطٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا مِنْ مُسْلِمٍ يُسَلِّمُ عَلَيَّ إِلَّا رَدَّ اللهُ         [9/131]      إِلَيَّ رُوحِي  حَتَّى أَرُدَّ عَلَيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ قُسَيْطٍ  إِلَّا  أَبُو صَخْرٍ  .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( عبد الله بن يزيد أبو عبد الرحمن المقرئ )","","Al-Mu'jam al-Awsat 9329","","أبو هريرة الدوسي عن يزيد بن عبد الله بن قسيط الليثي عن حميد بن أبي المخارق الخراط عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9338","9330  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  عَبْدُ اللهِ بْنُ يَزِيدَ الْمُقْرِئُ ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  عَنْ  بَشِيرِ بْنِ أَبِي عَمْرٍو الْخَوْلَانِيِّ ، أَنَّ الْوَلِيدَ بْنَ قَيْسٍ التُّجِيبِيَّ ،  حَدَّثَهُ  أَنَّهُ سَمِعَ  أَبَا سَعِيدٍ الْخُدْرِيَّ ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَكُونُ  خَلْفٌ  مِنْ بَعْدِ سِتِّينَ سَنَةً ، أَضَاعُوا الصَّلَاةَ  ، وَاتَّبَعُوا الشَّهَوَاتِ ، فَسَوْفَ يَلْقَوْنَ غَيًّا ، ثُمَّ يَكُونُ خَلْفٌ يَقْرَؤُونَ الْقُرْآنَ لَا يُجَاوِزُ  تَرَاقِيَهُمْ ،  وَيَقْرَأُ الْقُرْآنَ ثَلَاثَةٌ : مُؤْمِنٌ ، وَمُنَافِقٌ ، وَفَاجِرٌ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي سَعِيدٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  حَيْوَةُ  .","","Al-Mu'jam al-Awsat 9330","","أبو سعيد الخدري عن الوليد بن قيس بن الأخرم التجيبي عن بشير بن أبي عمرو الخولاني عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9339","9331  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  عَنْ  عَبْدِ اللهِ بْنِ عَيَّاشٍ ، قَالَ :  سَمِعْتُ  أَبِي عَيَّاشَ بْنَ عَبَّاسٍ  ، يَقُولُ :  سَمِعْتُ  عِيسَى بْنَ هِلَالٍ الصَّدَفِيَّ وَأَبَا عَبْدِ الرَّحْمَنِ الْحُبُلِيَّ ، قَالَا :  سَمِعْنَا  عَبْدَ اللهِ بْنَ عَمْرٍو ، يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  سَيَكُونُ فِي آخِرِ أُمَّتِي نِسَاءٌ  كَاسِيَاتٌ  عَارِيَاتٌ  ، عَلَى رُءُوسِهِنَّ  كَأَسْنِمَةِ  الْبُخْتِ  ، الْعَنُوهُنَّ ؛ فَإِنَّهُنَّ مَلْعُونَاتٌ ، لَوْ كَانَ وَرَاءَكُمْ أُمَّةٌ مِنَ الْأُمَمِ خَدَمْنَهُنَّ كَمَا تَخْدُمُكُمْ نِسَاءُ الْأُمَمِ قَبْلَكُمْ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  عَبْدُ اللهِ بْنُ عَيَّاشٍ  .","","Al-Mu'jam al-Awsat 9331","","عبد الله بن عمرو بن العاص عن عيسى بن هلال السليحي عن عياش بن عباس القتباني عن عبد الله بن عياش القتباني عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9340","[9/132]      9332  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  عَنْ  سَعِيدِ بْنِ أَبِي أَيُّوبَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عَبَّادِ بْنِ تَمِيمٍ الْمَازِنِيِّ ،  عَنْ  أَبِيهِ  ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَوَضَّأُ وَيَمْسَحُ بِالْمَاءِ عَلَى رِجْلَيْهِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  تَمِيمٍ الْمَازِنِيِّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  سَعِيدُ بْنُ أَبِي أَيُّوبَ  .","","Al-Mu'jam al-Awsat 9332","","تميم بن زيد الأنصاري عن عباد بن تميم الخزرجي عن محمد بن عبد الرحمن بن نوفل عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9341","9333  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  عَنْ  سَعِيدِ بْنِ أَبِي أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ الْوَلِيدِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ حُجَيْرَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  دَعَا نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  سَلْمَانَ  ، فَقَالَ :  إِنَّ نَبِيَّ اللهِ يُرِيدُ أَنْ يَمْنَحَكَ كَلِمَاتٍ مِنَ الرَّحْمَنِ ، تَرْغَبُ إِلَيْهِ فِيهِنَّ ، وَتَدْعُو بِهِنَّ فِي اللَّيْلِ وَالنَّهَارِ  : اللَّهُمَّ إِنِّي أَسْأَلُكَ صِحَّةً فِي إِيمَانٍ ، وَإِيمَانًا فِي حُسْنِ  خُلُقٍ  ، وَنَجَاةً يَتْبَعُهَا فَلَاحٌ ، وَرَحْمَةً مِنْكَ وَعَافِيَةً ، وَمَغْفِرَةً مِنْكَ وَرِضْوَانًا  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي هُرَيْرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  سَعِيدُ بْنُ أَبِي أَيُّوبَ  .","","Al-Mu'jam al-Awsat 9333","","أبو هريرة الدوسي عن عبد الرحمن بن حجيرة الخولاني عن عبد الله بن عبد الرحمن بن حجيرة الخولاني عن عبد الله بن الوليد بن قيس التجيبي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9342","9334  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  نَا  حَرْمَلَةُ بْنُ عِمْرَانَ ،  عَنْ  أَبِي يُونُسَ سُلَيْمِ بْنِ جُبَيْرٍ ، قَالَ :  سَمِعْتُ  أَبَا هُرَيْرَةَ يَقُولُ :  قَرَأَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَذِهِ الْآيَةَ :         [9/133]             {      إِنَّ اللهَ يَأْمُرُكُمْ أَنْ تُؤَدُّوا الأَمَانَاتِ إِلَى أَهْلِهَا         }      إِلَى قَوْلِهِ :         {      إِنَّ اللهَ كَانَ سَمِيعًا بَصِيرًا         }      وَيَضَعُ إِبْهَامَهُ عَلَى أُذُنِهِ ، وَالَّتِي تَلِيهَا عَلَى عَيْنِهِ "" ، وَيَقُولُ لَنَا : هَكَذَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ ، وَيَضَعُ إِصْبَعَيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي يُونُسَ  إِلَّا  حَرْمَلَةُ بْنُ عِمْرَانَ  .","","Al-Mu'jam al-Awsat 9334","","أبو هريرة الدوسي عن سليم بن جبير مولى أبي هريرة عن حرملة بن عمران التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9343","9335  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  عَنْ  كَعْبِ بْنِ عَلْقَمَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا سَمِعْتُمُ الْمُؤَذِّنَ فَقُولُوا كَمَا يَقُولُ ، ثُمَّ صَلُّوا عَلَيَّ  ؛ فَمَنْ صَلَّى عَلَيَّ صَلَاةً صَلَّى اللهُ عَلَيْهِ عَشْرًا ، وَسَلُوا اللهَ لِيَ  الْوَسِيلَةَ  ؛ فَإِنَّهَا مَنْزِلَةٌ فِي الْجَنَّةِ لَا يَنْبَغِي أَنْ تَكُونَ إِلَّا لِعَبْدٍ مِنْ عِبَادِ اللهِ ، وَأَرْجُو أَنْ أَكُونَ أَنَا هُوَ ، فَمَنْ سَأَلَ لِيَ  الْوَسِيلَةَ  حَلَّتْ عَلَيْهِ الشَّفَاعَةُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرٍ  إِلَّا  كَعْبُ بْنُ عَلْقَمَةَ  ،  تَفَرَّدَ بِهِ  حَيْوَةُ  .","","Al-Mu'jam al-Awsat 9335","","عبد الله بن عمرو بن العاص عن عبدالرحمن بن جبير الفرضي عن كعب بن علقمة بن كعب عن حيوة بن شريح التجيبي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9344","9336  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  نَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ، قَالَ :  سَمِعْتُ  أَبَا الْخَيْرِ ، يَقُولُ :         [9/134]      أَتَيْتُ  عُقْبَةَ بْنَ عَامِرٍ ، فَقُلْتُ :  أَلَا أُعْجِبُكَ مِنْ  أَبِي تَمِيمٍ الْجَيْشَانِيِّ  ؟ يَرْكَعُ رَكْعَتَيْنِ قَبْلَ صَلَاةِ الْمَغْرِبِ  ، فَقَالَ  عُقْبَةُ  : "" أَمَا إِنَّا كُنَّا نَفْعَلُهُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ  إِلَّا  سَعِيدُ بْنُ أَبِي أَيُّوبَ  ، وَلَا يُرْوَى عَنْ  عُقْبَةَ بْنِ عَامِرٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9336","","عقبة بن عامر بن عبس الفرضي عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9345","9337  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  نَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  ثَنَا  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  عَنْ  سُوَيْدِ بْنِ قَيْسٍ ،  عَنْ  مُعَاوِيَةَ بْنِ حُدَيْجٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنْ كَانَ فِي شَيْءٍ شِفَاءٌ فَفِي شَرْطَةِ  مِحْجَمٍ  ، أَوْ فِي شَرْبَةٍ مِنْ عَسَلٍ ، أَوْ كَيِّ نَارٍ يُصِيبُ أَلَمًا ، وَمَا أُحِبُّ أَنْ  أَكْتَوِيَ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  مُعَاوِيَةَ بْنِ حُدَيْجٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  يَزِيدُ بْنُ أَبِي حَبِيبٍ  .","","Al-Mu'jam al-Awsat 9337","","معاوية بن حديج السكوني عن سويد بن قيس التجيبي عن يزيد بن أبي حبيب الأزدي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9346","9338  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  عُقَيْلٍ وَيُونُسَ وَابْنِ سَمْعَانَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ حَمَلَ مِنْ أُمَّتِي دَيْنًا ثُمَّ جَهَدَ فِي قَضَائِهِ فَمَاتَ قَبْلَ أَنْ يَقْضِيَهُ  فَأَنَا وَلِيُّهُ  .         [9/135]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  عُقَيْلٌ  وَيُونُسُ  وَابْنُ سَمْعَانَ  ، وَلَا رَوَاهُ عَنْهُمْ إِلَّا  سَعِيدُ بْنُ أَبِي أَيُّوبَ  ،  تَفَرَّدَ بِهِ  الْمُقْرِئُ  .","","Al-Mu'jam al-Awsat 9338","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن الزهري عن عبد الله بن زياد المخزومي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9347","9339  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ الْوَلِيدِ ،  عَنْ  أَبِي الْخَيْرِ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ثَلَاثَةٌ إِنْ كَانَ فِي شَيْءٍ شِفَاءٌ ، فَشَرْطَةُ  مِحْجَمٍ  ، أَوْ شَرْبَةُ عَسَلٍ ، أَوْ كَيٌّ بِنَارٍ تُصِيبُ أَلَمًا ، وَأَنَا أَكْرَهُ الْكَيَّ وَلَا أُحِبُّهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ الْوَلِيدِ  إِلَّا  سَعِيدُ بْنُ أَبِي أَيُّوبَ  .","","Al-Mu'jam al-Awsat 9339","","عقبة بن عامر بن عبس الفرضي عن مرثد بن عبد الله اليزني عن عبد الله بن الوليد بن قيس التجيبي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9348","9340  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  أَبُو عَبْدِ الرَّحْمَنِ ،  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  يَحْيَى بْنِ أَبِي سُلَيْمٍ  ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ رَمَانَا بِاللَّيْلِ فَلَيْسَ مِنَّا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْمَقْبُرِيِّ  إِلَّا  يَحْيَى بْنُ أَبِي سُلَيْمٍ  ،  تَفَرَّدَ بِهِ  سَعِيدُ بْنُ أَبِي أَيُّوبَ  .  كذا في طبعة دار الحرمين ، والصواب : ( يحيى بن أبي سليمان )","","Al-Mu'jam al-Awsat 9340","","أبو هريرة الدوسي عن سعيد المقبري عن يحيى بن أبي سليمان المدني عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9349","9341  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  ثَنَا  سَعِيدٌ         [9/136]      حَدَّثَنِي  عَبْدُ اللهِ بْنُ الْوَلِيدِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ حُجَيْرَةَ ،  عَنْ  أَبِيهِ  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  حَقُّ الْمُؤْمِنِ عَلَى الْمُؤْمِنِ سِتُّ خِصَالٍ : يُسَلِّمُ عَلَيْهِ إِذَا لَقِيَهُ  ، وَيُشَمِّتُهُ إِذَا عَطَسَ ، وَإِذَا دَعَاهُ أَنْ يُجِيبَهُ ، وَإِذَا مَرِضَ أَنْ يَعُودَهُ ، وَإِذَا مَاتَ أَنْ يَشْهَدَهُ ، وَإِذَا غَابَ أَنْ يَنْصَحَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ حُجَيْرَةَ  إِلَّا ابْنُهُ ، وَلَا عَنِ ابْنِهِ إِلَّا  عَبْدُ اللهِ بْنُ الْوَلِيدِ  ،  تَفَرَّدَ بِهِ  سَعِيدُ بْنُ أَبِي أَيُّوبَ  .","","Al-Mu'jam al-Awsat 9341","","أبو هريرة الدوسي عن عبد الرحمن بن حجيرة الخولاني عن عبد الله بن عبد الرحمن بن حجيرة الخولاني عن عبد الله بن الوليد بن قيس التجيبي عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9350","9342  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ ،  ثَنَا  سَعِيدٌ ،  عَنْ  عَيَّاشِ بْنِ عَبَّاسٍ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحُبُلِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْقَتْلُ فِي  سَبِيلِ  اللهِ يُكَفِّرُ كُلَّ شَيْءٍ ، إِلَّا الدَّيْنَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَيَّاشِ بْنِ عَبَّاسٍ  إِلَّا  سَعِيدُ بْنُ أَبِي أَيُّوبَ  .","","Al-Mu'jam al-Awsat 9342","","عبد الله بن عمرو بن العاص عن عبد الله بن يزيد المعافري عن عياش بن عباس القتباني عن سعيد بن أبي أيوب الخزاعي عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9351","9343  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  ثَنَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ،  نَا  الْحَسَنُ بْنُ عُمَارَةَ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنْ  سَالِمِ بْنِ أَبِي الْجَعْدِ .  عَنْ  ثَوْبَانَ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، مَا يَكْفِينِي مِنَ الدُّنْيَا ؟ فَقَالَ :  مَا سَدَّ جَوْعَتَكَ وَوَارَى  عَوْرَتَكَ  ، وَإِنْ كَانَ لَكَ بَيْتٌ يُظِلُّكَ فَذَاكَ  ، وَإِنْ كَانَتْ لَكَ دَابَّةٌ فَبَخٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَدِيِّ بْنِ ثَابِتٍ  إِلَّا  الْحَسَنُ بْنُ عُمَارَةَ  .","","Al-Mu'jam al-Awsat 9343","","ثوبان بن بجدد مولى رسول الله عن سالم بن أبي الجعد الغطفاني عن عدي بن ثابت الظفري عن الحسن بن عمارة عن عبد الله بن يزيد القصير عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9352","9344  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ :  نَا  حَفْصُ بْنُ عُمَرَ الْعَدَنِيُّ ،  نَا  الْحَكَمُ بْنُ أَبَانَ ،  عَنْ  عِكْرِمَةَ .  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  رُكِزَتِ  الْعَنَزَةُ  بَيْنَ يَدَيِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِعَرَفَاتٍ  ، فَصَلَّى إِلَيْهَا  ، وَالْحُمُرُ تَمُرُّ مِنْ وَرَاءِ  الْعَنَزَةِ  .","","Al-Mu'jam al-Awsat 9344","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن الحكم بن أبان العدني عن حفص بن عمر بن ميمون الفرخ عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9353","9345  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  حَفْصُ بْنُ عُمَرَ الْعَدَنِيُّ :  نَا  الْحَكَمُ بْنُ         [9/137]      أَبَانَ ،  عَنْ  عِكْرِمَةَ .  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  كَسَفَتِ الشَّمْسُ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَامَ إِلَى الصَّلَاةِ ، فَقَامَ مَلِيًّا  ، ثُمَّ رَكَعَ مَلِيًّا ، ثُمَّ قَامَ مَلِيًّا ، ثُمَّ رَكَعَ مَلِيًّا ، ثُمَّ سَجَدَ ، ثُمَّ عَادَ لِمِثْلِهَا . قَالَ  عِكْرِمَةُ :  قَالَ  ابْنُ عَبَّاسٍ  : كُنْتُ إِلَى جَنْبِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ أَسْمَعِ الْقِرَاءَةَ  .","","Al-Mu'jam al-Awsat 9345","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن الحكم بن أبان العدني عن حفص بن عمر بن ميمون الفرخ عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9354","9346  -  حَدَّثَنَا  هَارُونُ بْنُ مَلُّولٍ ،  نَا  حَفْصُ بْنُ عُمَرَ الْعَدَنِيُّ ،  نَا  الْحَكَمُ بْنُ أَبَانَ ،  عَنْ  عِكْرِمَةَ . -  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَذْكُرُ فِي السَّاعَةِ الَّتِي فِي الْجُمُعَةِ عَلَى الْمِنْبَرِ ، يُقَلِّلُهَا  .","","Al-Mu'jam al-Awsat 9346","","أبو هريرة الدوسي عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن الحكم بن أبان العدني عن حفص بن عمر بن ميمون الفرخ عن هارون بن ملول التجيبي عن الطبراني","هارون بن ملول المصري"
"9355","9347  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ الْمِصْرِيُّ ،  نَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  حَدَّثَنِي  عَطَاءُ بْنُ أَبِي رَبَاحٍ .  أَنَّ  جَابِرَ بْنَ عَبْدِ اللهِ زَعَمَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ أَكَلَ ثُومًا أَوْ بَصَلًا  فَلْيَعْتَزِلْنَا ، أَوْ : لِيَعْتَزِلْ مَسْجِدَنَا ، أَوْ : لِيَقْعُدْ فِي بَيْتِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  يُونُسُ  ، وَمَا  أَسْنَدَ  الزُّهْرِيُّ  عَنْ  عَطَاءِ بْنِ أَبِي رَبَاحٍ  حَدِيثًا غَيْرَ هَذَا .","","Al-Mu'jam al-Awsat 9347","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن الزهري عن يونس بن يزيدالأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9356","9348  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ ،  نَا  سَعِيدُ بْنُ عُفَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُوسَى بْنِ وَرْدَانَ ،  عَنْ  أَبِي الْهَيْثَمِ .  عَنْ  أَبِي بَصْرَةَ الْغِفَارِيِّ ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يَا  أَبَا بَصْرَةَ  ، إِنَّ الْكَافِرَ يَأْكُلُ فِي سَبْعَةِ أَمْعَاءٍ  ، وَالْمُؤْمِنُ يَأْكُلُ فِي  مِعًى  وَاحِدٍ  .         [9/138]      لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي بَصْرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9348","","حميل بن بصرة الغفاري عن سليمان بن عمرو العتواري عن موسى بن وردان المدني عن عبد الله بن لهيعة عن سعيد بن كثير بن عفير عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9357","9349  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ ،  ثَنَا  سَعِيدُ بْنُ عُفَيْرٍ ،  نَا  يَحْيَى بْنُ فُلَيْحٍ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  عِكْرِمَةَ .  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ الشُّرَّابَ كَانُوا يُضْرَبُونَ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالْأَيْدِي وَالنِّعَالِ وَالْعِصِيِّ  ""  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  ثَوْرٍ  إِلَّا  يَحْيَى  ،  تَفَرَّدَ بِهِ  سَعِيدُ بْنُ عُفَيْرٍ  .","","Al-Mu'jam al-Awsat 9349","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن ثور بن زيد الديلي عن يحيى بن فليح بن سليمان عن سعيد بن كثير بن عفير عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9358","9350  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ ،  نَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي حَبِيبَةَ ،  عَنْ  دَاوُدَ بْنِ الْحُصَيْنِ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ وَقَعَ عَلَى ذَاتِ  مَحْرَمٍ  فَاقْتُلُوهُ  .","","Al-Mu'jam al-Awsat 9350","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن داود بن الحصين الأموي عن إبراهيم بن إسماعيل الأنصاري عن سعيد بن الحكم الجمحي عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9359","9351  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ ،  نَا  يَحْيَى بْنُ بُكَيْرٍ ،  نَا  خُنَيْسُ بْنُ عَامِرٍ الْمَعَافِرِيُّ ،  عَنْ  أَبِي قَبِيلٍ ،  عَنْ  جُنَادَةَ بْنِ أَبِي أُمَيَّةَ ،  عَنْ  مُعَاذِ بْنِ جَبَلٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ نَبِيٍّ إِلَّا وَقَدْ أَنْذَرَ أُمَّتَهُ  الدَّجَّالَ  ، وَأَنَا أُحَذِّرُكُمْ أَمْرَ  الدَّجَّالِ  ، إِنَّهُ  أَعْوَرُ  ، وَإِنَّ رَبِّي لَيْسَ  بِأَعْوَرَ  ، مَكْتُوبٌ بَيْنَ عَيْنَيْهِ : كَافِرٌ ، يَقْرَأُ الْكَاتِبُ وَغَيْرُ الْكَاتِبِ ، مَعَهُ جَنَّةٌ وَنَارٌ ، نَارُهُ جَنَّةٌ وَجَنَّتُهُ نَارٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خُنَيْسِ بْنِ عَامِرٍ  إِلَّا  يَحْيَى بْنُ بُكَيْرٍ  .","","Al-Mu'jam al-Awsat 9351","","معاذ بن جبل عن جنادة بن أبي أمية الأزدي عن حيي بن هانئ السريعي عن خنيس بن عامر بن يحيى المعافري عن يحيى بن عبد الله بن بكير المخزومي عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9360","[9/139]      9352  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ ،  نَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الْمَدَنِيُّ ،  حَدَّثَنِي  أَبُو حَزْرَةَ يَعْقُوبُ بْنُ مُجَاهِدٍ ،  أَخْبَرَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : "" إِنَّ اللهَ يَقُولُ :  مَنْ أَهَانَ لِي وَلِيًّا فَقَدِ اسْتَحَلَّ مُحَارَبَتِي  ، وَمَا تَقَرَّبَ إِلَيَّ عَبْدٌ مِنْ عِبَادِي بِمِثْلِ أَدَاءِ فَرَائِضِي ، وَإِنَّ عَبْدِي لَيَتَقَرَّبُ إِلَيَّ بِالنَّوَافِلِ حَتَّى أُحِبَّهُ ، فَإِذَا أَحْبَبْتُهُ كُنْتُ عَيْنَيْهِ الَّتِي يُبْصِرُ بِهِمَا ، وَأُذُنَيْهِ الَّتِي يَسْمَعُ بِهِمَا ، وَيَدَهُ الَّتِي يَبْطِشُ بِهَا ، وَرِجْلَيْهِ الَّتِي يَمْشِي بِهِمَا ، إِنْ دَعَانِي أَجَبْتُهُ ، وَإِنْ سَأَلَنِي أَعْطَيْتُهُ ، وَمَا تَرَدَّدْتُ عَنْ شَيْءٍ أَنَا فَاعِلُهُ تَرَدُّدِي عَنْ مَوْتِهِ ، وَذَلِكَ أَنَّهُ يَكْرَهُ الْمَوْتَ وَأَنَا أَكْرَهُ مَسَاءَتَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي حَزْرَةَ  إِلَّا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ  ، وَلَا رَوَاهُ عَنْ  عُرْوَةَ  إِلَّا  أَبُو حَزْرَةَ  وَعَبْدُ الْوَاحِدِ بْنُ مَيْمُونٍ  .","","Al-Mu'jam al-Awsat 9352","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن يعقوب بن مجاهد المخزومي عن إبراهيم بن سويد بن حيان عن سعيد بن الحكم الجمحي عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9361","[9/140]      9353  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ ،  ثَنَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  نَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنِ  الْقَعْقَاعِ بْنِ حَكِيمٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنْ نَبِيِّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، أَنَّهُ قَالَ :  إِنَّمَا الصِّيتُ هَاهُنَا  ، وَأَشَارَ بِيَدِهِ إِلَى السَّمَاءِ  .  لَمْ يَذْكُرْ أَحَدٌ مِمَّنْ رَوَى هَذَا الْحَدِيثَ عَنِ  ابْنِ عَجْلَانَ  ،  الْقَعْقَاعَ  إِلَّا ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9353","","أبو هريرة الدوسي عن ذكوان السمان عن القعقاع بن حكيم الكناني عن محمد بن عجلان عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9362","9354  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ ،  نَا  عَمْرُو بْنُ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  وَاهِبِ بْنِ عَبْدِ اللهِ .  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لَا يُقْبِلُ أَحَدُكُمْ وَثَوْبُهُ عَلَى أَنْفِهِ فَإِنَّ ذَلِكَ  خَطْمُ  الشَّيْطَانِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9354","","عبد الله بن عمرو بن العاص عن واهب بن عبد الله المعافري عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9363","9355  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ ،  نَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  عَمَّارُ بْنُ سَعْدٍ ،  عَنْ  أَبِي سَلَمَةَ  عَنْ  عَائِشَةَ قَالَتْ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي ذَاتَ لَيْلَةٍ ، فَقُمْتُ خَلْفَهُ أُصَلِّي بِصَلَاتِهِ ، فَلَمَّا جَلَسَ خَفَّفَ فِي قِيَامِهِ وَصَلَّى رَكْعَتَيْنِ خَفِيفَتَيْنِ ، ثُمَّ         [9/141]      سَلَّمَ ، ثُمَّ قَامَ فَصَلَّى رَكْعَتَيْنِ ، ثُمَّ سَلَّمَ فَأَسْمَعَنِي السَّلَامَ ، ثُمَّ إِنَّهُ الْتَفَتَ إِلَيَّ فَقَالَ :  اكْلُفِي  مِنَ الْعَمَلِ مَا تُطِيقِينَ ، يَقُولُهَا ثَلَاثًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمَّارِ بْنِ سَعْدٍ  إِلَّا  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9355","","عائشة بنت أبي بكر الصديق عن أبو سلمة بن عبد الرحمن عن عمار بن سعد السلهمي عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9364","9356  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ ،  نَا  يَحْيَى بْنُ بُكَيْرٍ ،  نَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  أَبُو جَمِيلٍ الْأَنْصَارِيُّ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ .  عَنْ  عَائِشَةَ "" أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا أَصْبَحَ يَقُولُ : أَصْبَحْتُ يَا رَبِّ أُشْهِدُكَ وَأُشْهِدُ مَلَائِكَتَكَ وَأَنْبِيَاءَكَ وَرُسُلَكَ  وَجَمِيعَ خَلْقِكَ عَلَى شَهَادَتِي عَلَى نَفْسِي أَنِّي أَشْهَدُ أَنَّكَ أَنْتَ اللهُ لَا إِلَهَ إِلَّا أَنْتَ وَحْدَكَ لَا شَرِيكَ لَكَ ، وَأَنَّ مُحَمَّدًا عَبْدُكَ وَرَسُولُكَ ، وَأُومِنُ بِكَ وَأَتَوَكَّلُ عَلَيْكَ - يَقُولُهَا ثَلَاثًا -  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ  إِلَّا  أَبُو جَمِيلٍ الْأَنْصَارِيُّ  ،  تَفَرَّدَ بِهِ  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9356","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن أبو جميل الأنصاري عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9365","9357  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ  ، نَا  يَحْيَى بْنُ بُكَيْرٍ  ، نَا  ابْنُ لَهِيعَةَ ،  عَنْ  مُوسَى بْنِ أَيُّوبَ الْغَافِقِيِّ ،  عَنْ  إِيَاسِ بْنِ عَامِرٍ ،  عَنْ  عَلِيِّ بْنِ أَبِي طَالِبٍ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنِ  الْمُتْعَةِ  ، وَإِنَّمَا كَانَتْ لِمَنْ لَمْ يَجِدْ ، فَلَمَّا نَزَلَ النِّكَاحُ وَالطَّلَاقُ وَالْعِدَّةُ وَالْمِيرَاثُ نَهَى عَنْهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُوسَى بْنِ أَيُّوبَ  إِلَّا  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9357","","علي بن أبي طالب عن إياس بن عامر المصري عن موسى بن أيوب بن عامر الغافقي عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9366","9358  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ  ، نَا  عَبْدُ الْغَفَّارِ بْنُ دَاوُدَ أَبُو صَالِحٍ الْحَرَّانِيُّ  ، ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ، قَالَتْ : ""  دَخَلَ عَلَيَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَفِي الْبَيْتِ سِتْرٌ مَنْصُوبٌ فِيهِ صُوَرٌ  ، فَعَرَفْتُ الْغَضَبَ فِي وَجْهِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَطَعْتُهُ ، فَجَعَلْتُهُ مِرْفَقَتَيْنِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ  إِلَّا  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9358","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن بكير بن عبد الله بن الأشج القرشي عن عبد الله بن لهيعة عن عبد الغفار بن داود الحراني عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9367","[9/142]      9359  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ  ، ثَنَا  أَبُو صَالِحٍ الْحَرَّانِيُّ  ، نَا  ابْنُ لَهِيعَةَ ،  عَنِ  الْوَلِيدِ بْنِ أَبِي الْوَلِيدِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  عَائِشَةَ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  لَا خَيْرَ فِي جَمَاعَةِ النِّسَاءِ ، إِلَّا فِي مَسْجِدِ جَمَاعَةٍ  ، أَوْ جِنَازَةِ قَتِيلٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْوَلِيدِ بْنِ أَبِي الْوَلِيدِ  إِلَّا  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9359","","عائشة بنت أبي بكر الصديق عن القاسم بن محمد بن أبي بكر الصديق عن الوليد بن أبي الوليد مولى عبد الله بن عمر عن عبد الله بن لهيعة عن عبد الغفار بن داود الحراني عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9368","9360  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ  ، ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ ،  أَخْبَرَنِي  عَامِرُ بْنُ يَحْيَى الْمَعَافِرِيُّ ،  عَنْ  حَنَشٍ الصَّنْعَانِيِّ ، قَالَ :  لَمَّا كَانَتْ فِتْنَةُ ابْنِ الزُّبَيْرِ أَرْسَلَ إِلَيْهِ الْحَرُورِيَّةُ أَنِ ائْتِنَا ، فَجَاءَهُمْ ، فَقَامَ فَخَطَبَهُمْ ، فَحَمِدَ اللهَ ، فَقَالُوا : قَدْ عَلِمْنَا أَنَّ هَوَاكَ مَعَنَا ، فَتَعَالَ حَتَّى نَجْعَلَكَ  خَلِيفَةً  ،  فَقَالَ  : وَاللهِ لَقَدْ كَانَتْ بَصِيرَتِي فِيكُمْ قَبْلَ الْيَوْمِ ، وَلَقَدِ ازْدَدْتُ فِيكُمْ  بَصِيرَةً  ، وَكَيْفَ أَكُونُ فِيكُمْ وَقَدْ  سَمِعْتُ  أَبَا سَعِيدٍ الْخُدْرِيَّ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  يَخْرُجُ مِنْ هَذِهِ الْأُمَّةِ نَاسٌ ،  يَمْرُقُونَ  مِنَ  الدِّينِ  كَمَا  يَمْرُقُ  السَّهْمُ مِنَ  الرَّمِيَّةِ  ؟ .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ  ، عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  ابْنُ لَهِيعَةَ  .","","Al-Mu'jam al-Awsat 9360","","أبو سعيد الخدري عن عبد الله بن الزبير عن حنش بن عبد الله السبائي عن عامر بن يحيى الشرعبي عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن هارون بن كامل المصري عن الطبراني","هارون بن كامل المصري"
"9369","9361  -  حَدَّثَنَا  هَارُونُ بْنُ سُلَيْمَانَ أَبُو ذَرٍّ الْمِصْرِيُّ  ، ثَنَا  سُفْيَانُ بْنُ بِشْرٍ الْكُوفِيُّ  ، ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  تَسُبُّوا  عَلِيًّا  ؛ فَإِنَّهُ         [9/143]      مَمْسُوسٌ فِي ذَاتِ اللهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ بْنِ أَبِي الزِّيَادِ  إِلَّا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ  .","","Al-Mu'jam al-Awsat 9361","","كعب بن عجرة عن إسحاق بن كعب بن عجرة القضاعي عن يزيد بن أبي زياد القرشي عن عبد الرحيم بن سليمان الأشل عن سفيان بن بشر الكوفي عن هارون بن سليمان الجبان عن الطبراني","هارون بن سليمان أبو ذر المصري"
"9370","9362  -  حَدَّثَنَا  هَارُونُ بْنُ سُلَيْمَانَ  ، نَا  زُهَيْرُ بْنُ عَبَّادٍ الرُّؤَاسِيُّ  ، نَا  عِيسَى بْنُ يُونُسَ ،  عَنْ  فَائِدٍ أَبِي الْوَرْقَاءِ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ أَبِي أَوْفَى ، يَقُولُ :  إِنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ ثَلَاثًا ثَلَاثًا  ، وَمَسَحَ رَأْسَهُ مَرَّةً وَاحِدَةً  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ اللهِ بْنِ أَبِي أَوْفَى  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9362","","عبد الله بن أبي أوفى الأسلمي عن فائد بن عبد الرحمن العطار عن عيسى بن يونس بن أبي إسحاق عن زهير بن عباد بن مليح الرؤاسي عن هارون بن سليمان الجبان عن الطبراني","هارون بن سليمان أبو ذر المصري"
"9371","9363  -  حَدَّثَنَا  هَارُونُ بْنُ سُلَيْمَانَ  ، نَا  زُهَيْرُ بْنُ عَبَّادٍ  ، نَا  سَلَّامٌ الطَّوِيلُ ،  عَنْ  زَيْدٍ الْعَمِّيِّ ،  عَنْ  أَبِي عُثْمَانَ الْأَنْصَارِيِّ ،  عَنِ  ابْنِ عُمَرَ ،  عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ ، أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ إِنَّا كُنَّا قَبْلَكَ أَهْلَ كِتَابٍ ، وَإِنَّا نُؤْمَرُ بِغَسْلِ الْغَائِطِ وَالْبَوْلِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ قَدْ رَضِيَ عَنْكُمْ ، وَأَثْنَى عَلَيْكُمْ ، وَأَحَبَّكُمْ ، فَلَا تَدَعُوهُ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنِ  ابْنِ عُمَرَ  ، عَنْ  عَبْدِ اللهِ بْنِ سَلَامٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  زُهَيْرُ بْنُ عَبَّادٍ  .","","Al-Mu'jam al-Awsat 9363","","عبد الله بن سلام بن الحارث الإسرائيلي عن عبد الله بن عمر بن الخطاب عن عمرو بن سالم الأنصاري عن زيد بن الحواري العمي عن سلام بن سلم الطويل عن زهير بن عباد بن مليح الرؤاسي عن هارون بن سليمان الجبان عن الطبراني","هارون بن سليمان أبو ذر المصري"
"9372","9364  -  حَدَّثَنَا  هَارُونُ بْنُ سُلَيْمَانَ أَبُو ذَرٍّ الْمِصْرِيُّ  ، نَا  يُوسُفُ بْنُ عَدِيٍّ  ، ثَنَا  عَمْرُو بْنُ ثَابِتٍ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ ابْنِ أَخِي زَيْدِ بْنِ أَرْقَمَ ، قَالَ :  دَخَلْنَا عَلَى أُمِّ سَلَمَةَ ،  فَقَالَتْ  : مِنْ أَيْنَ أَنْتُمْ ؟ فَقُلْنَا : مِنْ  أَهْلِ الْكُوفَةِ  ، قَالَتْ : أَنْتُمُ الَّذِينَ تَشْتُمُونَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقُلْتُ : مَا عَلِمْتُ أَحَدًا شَتَمَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، قَالَتْ : بَلْ  تَلْعَنُونَ  عَلِيًّا  وَمَنْ يُحِبُّهُ ، وَكَانَ رَسُولُ اللهِ يُحِبُّهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الرَّحْمَنِ ابْنِ أَخِي زَيْدِ بْنِ أَرْقَمَ  إِلَّا  يَزِيدُ بْنُ أَبِي زِيَادٍ  ، وَلَا عَنْ  يَزِيدَ  إِلَّا  عَمْرُو بْنُ ثَابِتٍ  ،  تَفَرَّدَ بِهِ  يُوسُفُ بْنُ عَدِيٍّ  .","","Al-Mu'jam al-Awsat 9364","","هند بنت أبي أمية زوج رسول الله عن عبد الرحمن ابن أخي زيد بن أرقم عن يزيد بن أبي زياد القرشي عن عمرو  بن أبي المقدام عن يوسف بن عدي بن رزق الكوفي عن هارون بن سليمان الجبان عن الطبراني","هارون بن سليمان أبو ذر المصري"
"9373","[9/144]      9365  -  حَدَّثَنَا  هَارُونُ بْنُ سُلَيْمَانَ  ، نَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ الْأَصْبَهَانِيُّ ،  عَنْ  أَبِي سِنَانٍ ضِرَارِ بْنِ مُرَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِنَّ  جَهَنَّمَ  لَمَّا سِيقَ إِلَيْهَا أَهْلُهَا تَلَقَّتْهُمْ فَلَفَحَتْهُمْ لَفْحَةً  ، لَمْ تَدَعْ لَحْمًا عَلَى عَظْمٍ إِلَّا أَلْقَتْهُ عَلَى الْعُرْقُوبِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ  إِلَّا  أَبُو سِنَانٍ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ سُلَيْمَانَ الْأَصْبَهَانِيُّ  .","","Al-Mu'jam al-Awsat 9365","","أبو هريرة الدوسي عن عبد الله بن أبي الهذيل الغنوي عن ضرار بن مرة الشيباني عن محمد بن سليمان بن عبد الله الأصبهاني عن يحيى بن سليمان بن يحيى عن هارون بن سليمان الجبان عن الطبراني","هارون بن سليمان أبو ذر المصري"
"9374","9366  -  حَدَّثَنَا  هَارُونُ بْنُ سُلَيْمَانَ أَبُو ذَرٍّ  ، ثَنَا  سُفْيَانُ بْنُ بِشْرٍ الْكُوفِيُّ  ، نَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  كَثِيرِ بْنِ زَيْدٍ ،  عَنِ  الْمُطَّلِبِ بْنِ عَبْدِ اللهِ بْنِ حَنْطَبٍ ، قَالَ :  قَالَ  أَبُو أَيُّوبَ الْأَنْصَارِيُّ  لِمَرْوَانَ بْنِ الْحَكَمِ  : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَبْكُوا عَلَى الدِّينِ إِذَا وَلَّيْتُمُوهُ أَهْلَهُ  ، وَلَكِنِ ابْكُوا عَلَيْهِ إِذَا وَلَّيْتُمُوهُ غَيْرَ أَهْلِهِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي أَيُّوبَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  سُفْيَانُ بْنُ بِشْرٍ  .","","Al-Mu'jam al-Awsat 9366","","أبو أيوب الأنصاري عن المطلب بن عبد الله بن حنطب المخزومي عن كثير بن زيد السهمي عن حاتم بن إسماعيل الحارثي عن سفيان بن بشر الكوفي عن هارون بن سليمان الجبان عن الطبراني","هارون بن سليمان أبو ذر المصري"
"9375","9367  -  حَدَّثَنَا  هَارُونُ بْنُ سُلَيْمَانَ  نَا  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ  ، ثَنَا  الْمُحَارِبِيُّ ،  أَنَّهُ سَمِعَ  الْأَعْمَشَ ،  يَذْكُرُ ، عَنْ  طَرِيفِ بْنِ مَيْمُونٍ ،  عَنِ  ابْنِ عَبَّاسٍ -  يَرْفَعُهُ  - قَالَ :  مَا مِنْ رَجُلٍ وَلِيَ عَشَرَةً إِلَّا أُتِيَ بِهِ يَوْمَ الْقِيَامَةِ مَغْلُولًا يَدُهُ إِلَى عُنُقِهِ  ، حَتَّى يُفْصَلَ بَيْنَهُ وَبَيْنَهُمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا  الْمُحَارِبِيُّ  ،  تَفَرَّدَ بِهِ  يَحْيَى بْنُ سُلَيْمَانَ الْجُعْفِيُّ  .","","Al-Mu'jam al-Awsat 9367","","عبد الله بن عباس عن طريف بن ميمون عن الأعمش عن عبد الرحمن بن محمد المحاربي عن يحيى بن سليمان بن يحيى عن هارون بن سليمان الجبان عن الطبراني","هارون بن سليمان أبو ذر المصري"
"9376","9368  -  حَدَّثَنَا  هَارُونُ بْنُ سُلَيْمَانَ أَبُو ذَرٍّ  ، نَا  زُهَيْرُ بْنُ عَبَّادٍ  ، نَا  حَفْصُ بْنُ         [9/145]      مَيْسَرَةَ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ  عَنِ  ابْنِ عُمَرَ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا صَلَّى أَحَدُكُمْ فَلْيَلْبَسْ ثَوْبَيْهِ  ، فَإِنَّ اللهَ أَحَقُّ مَنْ تُزُيِّنَ لَهُ ، فَمَنْ لَمْ يَكُنْ لَهُ ثَوْبَانِ فَلْيَتَّزِرْ إِذَا صَلَّى ، وَلَا يَشْتَمِلْ أَحَدُكُمْ فِي صَلَاتِهِ  اشْتِمَالَ  الْيَهُودِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُوسَى بْنِ عُقْبَةَ  إِلَّا  حَفْصُ بْنُ مَيْسَرَةَ  ،  تَفَرَّدَ بِهِ  زُهَيْرُ بْنُ عَبَّادٍ  .","","Al-Mu'jam al-Awsat 9368","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن موسى بن عقبة عن حفص بن ميسرة العقيلي عن زهير بن عباد بن مليح الرؤاسي عن هارون بن سليمان الجبان عن الطبراني","هارون بن سليمان أبو ذر المصري"
"9377","9369  -  حَدَّثَنَا  هَارُونُ بْنُ سُلَيْمَانَ أَبُو ذَرٍّ ،  نَا  يُوسُفُ بْنُ عَدِيٍّ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَرَادَ اللهُ بِعَبْدٍ شَرًّا خَضَّرَ لَهُ فِي اللَّبِنِ وَالطِّينِ حَتَّى يَبْنِيَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سُفْيَانَ  إِلَّا  الْمُحَارِبِيُّ  ، وَلَا عَنِ  الْمُحَارِبِيِّ  إِلَّا  يُوسُفُ بْنُ عَدِيٍّ  ،  تَفَرَّدَ بِهِ  أَبُو ذَرٍّ  .","","Al-Mu'jam al-Awsat 9369","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن سفيان الثوري عن عبد الرحمن بن محمد المحاربي عن يوسف بن عدي بن رزق الكوفي عن هارون بن سليمان الجبان عن الطبراني","هارون بن سليمان أبو ذر المصري"
"9378","9370  -  حَدَّثَنَا  هَارُونُ بْنُ مُوسَى الْأَخْفَشُ الْمُقْرِئُ الدِّمَشْقِيُّ ،  ثَنَا  سَلَّامُ بْنُ سُلَيْمَانَ الْمَدَائِنِيُّ  ، ثَنَا  أَبُو عَمْرِو بْنُ الْعَلَاءِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ قَالَ :  قَرَأْتُ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         {      اللهُ الَّذِي خَلَقَكُمْ مِنْ ضَعْفٍ         }      ، فَقَالَ : ""         {      مِنْ ضَعْفٍ         }      ،         {      ثُمَّ جَعَلَ مِنْ بَعْدِ ضَعْفٍ قُوَّةً         }      فَقَالَ :         {      ثُمَّ جَعَلَ مِنْ بَعْدِ ضَعْفٍ قُوَّةً         }      "" ،         {      ثُمَّ جَعَلَ مِنْ بَعْدِ قُوَّةٍ ضَعْفًا         }      فَقَالَ :         {      مِنْ بَعْدِ قُوَّةٍ ضَعْفًا         }      .","","Al-Mu'jam al-Awsat 9370","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أبو عمرو بن العلاء عن سلام بن سليمان بن سوار الضرير عن هارون بن موسى الأخفش الدمشقي عن الطبراني","هارون بن موسى الأخفش الدمشقي"
"9379","9371  -  حَدَّثَنَا  هَارُونُ بْنُ مُوسَى  ، نَا  سَلَّامُ بْنُ سُلَيْمَانَ  ، ثَنَا  أَبُو عَمْرِو بْنُ الْعَلَاءِ ،  عَنْ  نَافِعٍ         [9/146]      عَنِ  ابْنِ عُمَرَ ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَرَأَ :         {      فَشَارِبُونَ شُرْبَ الْهِيمِ         }      .","","Al-Mu'jam al-Awsat 9371","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أبو عمرو بن العلاء عن سلام بن سليمان بن سوار الضرير عن هارون بن موسى الأخفش الدمشقي عن الطبراني","هارون بن موسى الأخفش الدمشقي"
"9380","9372  -  حَدَّثَنَا  هَارُونُ بْنُ مُحَمَّدِ بْنِ الْمُنَخَّلِ الْحَارِثِيُّ الْوَاسِطِيُّ  ، ثَنَا  الْعَبَّاسُ بْنُ أَبِي طَالِبٍ  ، نَا  حَفْصُ بْنُ عُمَرَ الْعَدَنِيُّ  ، ثَنَا  مُوسَى بْنُ سَعْدٍ الْبَصْرِيُّ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ :  أُهْدِيَ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ طَائِرٌ ، فَقَالَ :  اللَّهُمَّ ائْتِنِي بِأَحَبِّ خَلْقِكَ إِلَيَّ يَأْكُلْ مَعِي مِنْ هَذَا الطَّائِرِ  ، فَجَاءَ  عَلِيُّ بْنُ أَبِي طَالِبٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَسَنِ  إِلَّا  مُوسَى بْنُ سَعْدٍ  ،  تَفَرَّدَ بِهِ  حَفْصُ بْنُ عُمَرَ  .","","Al-Mu'jam al-Awsat 9372","","أنس بن مالك عن الحسن البصري عن موسى بن سعد البصري عن حفص بن عمر بن ميمون الفرخ عن عباس بن جعفر العباسي عن هارون بن محمد بن المنخل الحارثي الواسطي عن الطبراني","هارون بن محمد بن المنخل الواسطي"
"9381","9373  -  حَدَّثَنَا  هَارُونُ بْنُ مُحَمَّدِ بْنِ الْمُنَخَّلِ  ، نَا  الْفَضْلُ بْنُ أَبِي طَالِبٍ  ، نَا  الْحَارِثُ بْنُ مَنْصُورٍ  ، نَا  عُمَرُ بْنُ قَيْسٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُنْكَحُ الْمَرْأَةُ إِلَّا بِإِذْنِ وَلِيٍّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  عُمَرُ بْنُ قَيْسٍ  ،  تَفَرَّدَ بِهِ  الْحَارِثُ بْنُ مَنْصُورٍ  .","","Al-Mu'jam al-Awsat 9373","","أبو هريرة الدوسي عن سعيد بن المسيب عن الزهري عن عمر بن قيس سندل عن الحارث بن منصور الواسطي عن الفضل بن أبي طالب الهاشمي عن هارون بن محمد بن المنخل عن الطبراني","هارون بن محمد بن المنخل الواسطي"
"9382","9374  -  حَدَّثَنَا  هَارُونُ بْنُ مُحَمَّدِ بْنِ الْمُنَخَّلِ ،  نَا  أَحْمَدُ بْنُ مَنِيعٍ ،  نَا  أَشْعَثُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ زُبَيْدٍ ،  عَنْ  عُبَيْدَةَ ،  حَدَّثَنِي  سُفْيَانُ  ،  عَنْ  حُذَيْفَةَ قَالَ :  بَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  سُبَاطَةِ  قَوْمٍ  ، ثُمَّ تَوَضَّأَ وَمَسَحَ عَلَى خُفَّيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُبَيْدَةَ  إِلَّا  أَشْعَثُ بْنُ عَبْدِ الرَّحْمَنِ  ،  تَفَرَّدَ بِهِ  أَحْمَدُ بْنُ مَنِيعٍ  .  كذا في طبعة دار الحرمين ، والصواب : ( شقيق) كما في مصادر التخريج.","","Al-Mu'jam al-Awsat 9374","","حذيفة بن اليمان عن شقيق بن سلمة عن عبيدة بن معتب الضبي عن أشعث بن عبد الرحمن بن زبيد اليامي عن أحمد بن منيع البغوي عن هارون بن محمد بن المنخل عن الطبراني","هارون بن محمد بن المنخل الواسطي"
"9383","[9/147]      9375  -  حَدَّثَنَا  هَارُونُ بْنُ مُحَمَّدِ بْنِ الْمُنَخَّلِ ،  نَا  مُحَمَّدُ بْنُ سُلَيْمَانَ ، لُوَيْنٌ ،  نَا  رَوْحُ بْنُ الْمُسَيِّبِ ،  عَنْ  يَزِيدَ الرَّقَاشِيِّ ،  عَنْ  غُنَيْمِ بْنِ قَيْسٍ ،  عَنْ  أَبِي مُوسَى الْأَشْعَرِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ اللهَ جَلَّ ذِكْرُهُ يَوْمَ خَلَقَ  آدَمَ  قَبَضَ مِنْ صُلْبِهِ قَبْضَتَيْنِ  ، فَوَقَعَ كُلُّ طَيِّبٍ فِي يَمِينِهِ وَكُلُّ خَبِيثٍ بِيَدِهِ الْأُخْرَى ، فَقَالَ : هَؤُلَاءِ أَصْحَابُ الْيَمِينِ وَلَا  أُبَالِي  ، وَهَؤُلَاءِ أَصْحَابُ الْجَنَّةِ ، وَهَؤُلَاءِ أَصْحَابُ النَّارِ ، ثُمَّ أَعَادَهُمْ فِي صُلْبِ  آدَمَ  ، فَهُمْ يُنْسَلُونَ عَلَى ذَاكَ الْآنَ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي مُوسَى  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  رَوْحُ بْنُ الْمُسَيِّبِ  .","","Al-Mu'jam al-Awsat 9375","","أبو موسى الأشعري عن غنيم بن قيس الكعبي عن يزيد بن أبان الرقاشي عن روح بن المسيب الكلبي عن محمد بن سليمان لوين عن هارون بن محمد بن المنخل عن الطبراني","هارون بن محمد بن المنخل الواسطي"
"9384","مَنِ اسْمُهُ : الْهَيْثَمُ  9376  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَالِدٍ الْمِصِّيصِيُّ ،  نَا  عَبْدُ الْكَبِيرِ بْنُ الْمُعَافَى بْنِ عِمْرَانَ ،  نَا  شَرِيكٌ ،  عَنِ  الْعَبَّاسِ بْنِ ذَرِيحٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، -  رَفَعَهُ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مِنِ اقْتِرَابِ السَّاعَةِ أَنْ يُرَى الْهِلَالُ  قَبَلًا  ، فَيُقَالُ : لِلَيْلَتَيْنِ ، وَأَنْ تُتَّخَذَ الْمَسَاجِدُ طُرُقًا ، وَأَنْ يَظْهَرَ مَوْتُ الْفُجَاءَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْعَبَّاسِ بْنِ ذَرِيحٍ  إِلَّا  شَرِيكٌ ،  تَفَرَّدَ بِهِ  عَبْدُ الْكَبِيرِ بْنُ الْمُعَافَى  .","","Al-Mu'jam al-Awsat 9376","","أنس بن مالك عن الشعبي عن عباس بن ذريح الكلبي عن شريك بن عبد الله النخعي عن عبد الكبير بن المعافى الموصلي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9385","9377  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  نَا  مُحَمَّدُ بْنُ عِيسَى بْنِ الطَّبَّاعِ ،  نَا  هُشَيْمٌ ،  عَنْ  مَنْصُورِ بْنِ زَاذَانَ ،  عَنْ  عَطَاءٍ         [9/148]      عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُئِلَ عَنْ مَنْ حَلَقَ قَبْلَ أَنْ يَذْبَحَ ، قَالَ : "" لَا حَرَجَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَنْصُورٍ  إِلَّا  هُشَيْمٌ  .","","Al-Mu'jam al-Awsat 9377","","عبد الله بن عباس عن عطاء بن أبي رباح عن منصور بن زاذان الثقفي عن هشيم بن بشير عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9386","9378  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  ثَنَا  عَبْدُ الْكَبِيرِ بْنُ الْمُعَافَى ،  ثَنَا  هُشَيْمٌ ،  عَنْ  عُبَيْدَةَ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَبْدِ اللهِ بْنِ عُبَيْدِ اللهِ الْهَاشِمِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ عُكَيْمٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَسْتَمْتِعُوا مِنَ الْمَيْتَةِ بِإِهَابٍ وَلَا عَصَبٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُبَيْدَةَ  إِلَّا  هُشَيْمٌ  ،  تَفَرَّدَ بِهِ  عَبْدُ الْكَبِيرِ بْنُ الْمُعَافَى  .","","Al-Mu'jam al-Awsat 9378","","عبد الله بن عكيم الجهني عن عبد الله بن عبيد الله بن عباس عن إبراهيم النخعي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن عبد الكبير بن المعافى الموصلي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9387","9379  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  ثَنَا  عَبْدُ الْكَبِيرِ بْنُ الْمُعَافَى بْنِ عِمْرَانَ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  قَامَ  بِلَالٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : مَاتَتْ فُلَانَةُ وَاسْتَرَاحَتْ ، فَغَضِبَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَقَالَ :  إِنَّمَا اسْتَرَاحَ مَنْ غُفِرَ لَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الْأَسْوَدِ  إِلَّا  ابْنُ لَهِيعَةَ  ، وَلَا عَنِ  ابْنِ لَهِيعَةَ  إِلَّا  الْمُعَافَى  ،  تَفَرَّدَ بِهِ  عَبْدُ الْكَبِيرِ  .","","Al-Mu'jam al-Awsat 9379","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن المعافى بن عمران عن عبد الكبير بن المعافى الموصلي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9388","9380  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  نَا  عَبْدُ الْكَبِيرِ بْنُ الْمُعَافَى ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  عُقْبَةَ بْنِ عَامِرٍ ، أَنَّهُ قَالَ :  يَا رَسُولَ اللهِ ، إِنَّ أُخْتِي نَذَرَتْ أَنْ تَمْشِيَ إِلَى الْبَيْتِ ، فَقَالَ :  مُرْهَا فَلْتَرْكَبْ ؛ فَإِنَّ اللهَ لَا يَصْنَعُ بِعَنَاءِ هَذِهِ شَيْئًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  سَعِيدِ بْنِ مَسْرُوقٍ  إِلَّا  أَبُو الْأَحْوَصِ  ،  تَفَرَّدَ بِهِ         [9/149]      عَبْدُ الْكَبِيرِ  .","","Al-Mu'jam al-Awsat 9380","","عقبة بن عامر بن عبس الفرضي عن عكرمة مولى ابن عباس عن سعيد بن مسروق الثوري عن سلام بن سليم الحنفي عن عبد الكبير بن المعافى الموصلي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9389","9381  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  نَا  عَبْدُ الْكَبِيرِ ،  ثَنَا  صَالِحُ بْنُ مُوسَى الطَّلْحِيُّ ،  نَا  مُعَاوِيَةُ بْنُ إِسْحَاقَ ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا بَرَّ أَبَاهُ مَنْ شَدَّ إِلَيْهِ الطَّرْفَ بِالْغَضَبِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ  إِلَّا  مُعَاوِيَةُ بْنُ إِسْحَاقَ  ،  تَفَرَّدَ بِهِ  صَالِحُ بْنُ مُوسَى  .","","Al-Mu'jam al-Awsat 9381","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن معاوية بن إسحاق بن طلحة التيمي عن صالح بن موسى الطلحي عن عبد الكبير بن المعافى الموصلي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9390","9382  -  حَدَّثَنَا  هَيْثَمٌ ،  نَا  عَبْدُ الْكَبِيرِ بْنُ الْمُعَافَى ،  ثَنَا  صَالِحُ بْنُ مُوسَى ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  أَقْبَلَ  طَلْحَةُ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ سَرَّهُ أَنْ يَنْظُرَ إِلَى رَجُلٍ قَدْ قَضَى  نَحْبَهُ  ، فَلْيَنْظُرْ إِلَى  طَلْحَةَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ  إِلَّا  صَالِحُ بْنُ مُوسَى  .","","Al-Mu'jam al-Awsat 9382","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن معاوية بن إسحاق بن طلحة التيمي عن صالح بن موسى الطلحي عن عبد الكبير بن المعافى الموصلي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9391","9383  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  نَا  عَبْدُ الْكَبِيرِ بْنُ الْمُعَافَى بْنِ عِمْرَانَ ،  ثَنَا  صَالِحُ بْنُ مُوسَى ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَسْرَعُ الْخَيْرِ ثَوَابًا صِلَةُ الرَّحِمِ  ، وَأَسْرَعُ الشَّرِّ عِقَابًا قَطِيعَةُ الرَّحِمِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ  إِلَّا  صَالِحُ بْنُ مُوسَى  .","","Al-Mu'jam al-Awsat 9383","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن معاوية بن إسحاق بن طلحة التيمي عن صالح بن موسى الطلحي عن عبد الكبير بن المعافى الموصلي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9392","9384  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  نَا  عَبْدُ الْكَبِيرِ ،  ثَنَا  صَالِحُ بْنُ مُوسَى ،  عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  عَائِشَةَ بِنْتِ طَلْحَةَ ،  عَنْ  عَائِشَةَ قَالَتْ :  بَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي أَصْحَابِهِ فِي قِبَلِ الْبَيْتِ إِذْ أَقْبَلَ أَبِي ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَرَادَ أَنْ يَنْظُرَ إِلَى عَتِيقٍ مِنَ النَّارِ فَلْيَنْظُرْ إِلَى  أَبِي بَكْرٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُعَاوِيَةَ بْنِ إِسْحَاقَ  إِلَّا  صَالِحُ بْنُ مُوسَى  .","","Al-Mu'jam al-Awsat 9384","","عائشة بنت أبي بكر الصديق عن عائشة بنت طلحة التيمية عن معاوية بن إسحاق بن طلحة التيمي عن صالح بن موسى الطلحي عن عبد الكبير بن المعافى الموصلي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9393","[9/150]      9385  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  ثَنَا  دَاوُدُ بْنُ مَنْصُورٍ ،  ثَنَا  أَيُّوبُ بْنُ خُوطٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الدُّنْيَا سِجْنُ الْمُؤْمِنِ ، وَجَنَّةُ الْكَافِرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  أَيُّوبُ بْنُ خُوطٍ  ،  تَفَرَّدَ بِهِ  دَاوُدُ بْنُ مَنْصُورٍ  .","","Al-Mu'jam al-Awsat 9385","","أنس بن مالك عن قتادة بن دعامة عن أيوب بن خوط الحبطي عن داود بن منصور الثغري عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9394","9386  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  ثَنَا  دَاوُدُ بْنُ مَنْصُورٍ ،  نَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  يَزِيدَ بْنِ رُومَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  عَائِشَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْلَا أَنَّ قَوْمَكِ حَدِيثُو عَهْدٍ بِالْجَاهِلِيَّةِ لَأَمَرْتُ  بِالْبَيْتِ  فَهُدِمَ  ، حَتَّى أُدْخِلَ فِيهِ مَا أُخْرِجَ مِنْهُ ،  الْحِجْرُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ بْنِ رُومَانَ  إِلَّا  جَرِيرُ بْنُ حَازِمٍ  وَأَبُو أُوَيْسٍ  .","","Al-Mu'jam al-Awsat 9386","","عائشة بنت أبي بكر الصديق عن عبد الله بن الزبير عن يزيد بن رومان الأسدي عن جرير بن حازم عن داود بن منصور الثغري عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9395","9387  -  حَدَّثَنَا  هَيْثَمٌ ،  ثَنَا  دَاوُدُ بْنُ مَنْصُورٍ ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  ثَابِتٍ ،  عَنْ  أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِذَا أُقِيمَتِ الصَّلَاةُ فَلَا تَقُومُوا حَتَّى تَرَوْنِي  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  ثَابِتٍ  إِلَّا  جَرِيرُ بْنُ حَازِمٍ  .","","Al-Mu'jam al-Awsat 9387","","أنس بن مالك عن ثابت البناني عن جرير بن حازم عن داود بن منصور الثغري عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9396","9388  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  نَا  دَاوُدُ بْنُ مَنْصُورٍ ،  نَا  جَرِيرُ بْنُ حَازِمٍ قَالَ :  سَمِعْتُ  أَبَا الزُّبَيْرِ  يُحَدِّثُ عَنْ  جَابِرٍ ، قَالَ :  كَانَ يُنْبَذُ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  تَوْرٍ  مِنْ حِجَارَةٍ  ، فَيَشْرَبُ مِنْهُ يَوْمَهُ ذَلِكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  جَرِيرِ بْنِ حَازِمٍ  إِلَّا  دَاوُدُ بْنُ مَنْصُورٍ  .","","Al-Mu'jam al-Awsat 9388","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن جرير بن حازم عن داود بن منصور الثغري عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9397","9389  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ ،  نَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ سَابِقٍ ،  ثَنَا  زِيَادُ بْنُ الْحَسَنِ بْنِ الْفُرَاتِ الْقَزَّازُ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ  عَنْ  أَبِي الْأَحْوَصِ  عَنْ  أَبِيهِ  ،  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلَ يَسْأَلُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا رَأَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُوءَ هَيْئَتِهِ قَالَ :  هَلْ لَكَ مِنْ مَالٍ ؟ "" قَالَ : نَعَمْ ، مِنْ كُلِّ الْمَالِ قَدْ آتَانِي اللهُ         [9/151]      مِنَ الْإِبِلِ وَالْغَنَمِ وَالْخَيْلِ  ، قَالَ : "" إِذَا آتَاكَ اللهُ مَالًا فَلْيُرَ عَلَيْكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَسَنِ بْنِ فُرَاتٍ  إِلَّا ابْنُهُ  زِيَادُ بْنُ الْحَسَنِ  ،  تَفَرَّدَ بِهِ  يَحْيَى بْنُ مُحَمَّدِ بْنِ سَابِقٍ  .","","Al-Mu'jam al-Awsat 9389","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن الحسن بن الفرات القزاز عن زياد بن الحسن القزاز عن يحيى بن محمد بن سابق المصيصي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9398","9390  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَالِدٍ الْمِصِّيصِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  نَا  فَرَجُ بْنُ فَضَالَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  عَمْرَةَ  عَنْ  أُمِّ سَلَمَةَ ،  أَنَّهَا كَانَتْ لَهَا شَاةٌ تَحْتَلِبُهَا ، فَفَقَدَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  مَا فَعَلَتْ شَاتُكُمْ ؟ "" قَالُوا : مَاتَتْ ، قَالَ : "" أَفَلَا انْتَفَعْتُمْ بِإِهَابِهَا  ؟ "" قُلْنَا : إِنَّهَا مَيْتَةٌ ، قَالَ : "" إِنَّ دِبَاغَهَا يُحِلُّهَا ، كَمَا يُحِلُّ الْخَلُّ الْخَمْرَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ سَعِيدٍ  إِلَّا  فَرَجُ بْنُ فَضَالَةَ  ، وَلَا يُرْوَى عَنْ  أُمِّ سَلَمَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9390","","هند بنت أبي أمية زوج رسول الله عن عمرة بنت عبد الرحمن الأنصارية عن يحيى بن سعيد الأنصاري عن فرج بن فضالة بن النعمان التنوخي عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9399","9391  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَالِدٍ ،  نَا  دَاوُدُ بْنُ مَنْصُورٍ ،  نَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  حُجَيَّةَ بْنِ عَدِيٍّ ،  عَنْ  عَلِيٍّ ، قَالَ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ  نَسْتَشْرِفَ  الْعَيْنَ وَالْأُذُنَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  جَرِيرُ بْنُ حَازِمٍ  .","","Al-Mu'jam al-Awsat 9391","","علي بن أبي طالب عن حجية بن عدي الكندي عن سلمة بن كهيل الحضرمي عن أبو إسحاق السبيعي عن جرير بن حازم عن داود بن منصور الثغري عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","الهيثم بن خالد المصيصي"
"9400","9392  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ الدُّورِيُّ ،  نَا  مُحَمَّدُ بْنُ عَمَّارٍ الْمَوْصِلِيُّ ،  نَا  الْمُعَافَى بْنُ عِمْرَانَ الْمَوْصِلِيُّ ،  عَنِ  الْحَسَنِ بْنِ حَيٍّ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ ،  عَنْ  سَعْدِ بْنِ أَبِي وَقَّاصٍ ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  نِعْمَ الْمِيتَةُ أَنْ يَمُوتَ الرَّجُلُ دُونَ حَقِّهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَسَنِ بْنِ حَيٍّ  إِلَّا  الْمُعَافَى بْنُ عِمْرَانَ  .","","Al-Mu'jam al-Awsat 9392","","سعد بن أبي وقاص عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن إبراهيم بن مهاجر بن جابر البجلي عن الحسن بن صالح بن صالح بن حي عن المعافى بن عمران عن محمد بن عبد الله بن عمار الغامدي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9401","9393  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  الْحُسَيْنُ بْنُ يَزِيدَ الطَّحَّانُ ،  ثَنَا  عَبْدُ السَّلَامِ         [9/152]      بْنُ حَرْبٍ  عَنْ  يَزِيدَ أَبِي خَالِدٍ الدَّالَانِيُّ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مُعَاوِيَةَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُسَلِّمُ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ  ، حَتَّى يُرَى بَيَاضُ خَدَّيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَكَمِ  إِلَّا  أَبُو خَالِدٍ الدَّالَانِيُّ  ،  تَفَرَّدَ بِهِ  عَبْدُ السَّلَامِ بْنُ حَرْبٍ  .","","Al-Mu'jam al-Awsat 9393","","عبد الله بن معاوية الغاضري عن عبد الله بن سخبرة عن الحكم بن عتيبة الكندي عن أبو خالد الدالاني عن عبد السلام بن حرب الملائي عن الحسين بن يزيد بن يحيى الطحان عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9402","9394  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ الدُّورِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ ،  ثَنَا  الْهَيْثَمُ بْنُ صَالِحٍ ،  عَنْ  سَلَّامٍ أَبِي الْمُنْذِرِ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنْ  عَطَاءٍ ،  عَنْ  جَابِرٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَطَرٍ  إِلَّا  سَلَّامٌ أَبُو الْمُنْذِرِ  ،  تَفَرَّدَ بِهِ  الْهَيْثَمُ بْنُ صَالِحٍ  .","","Al-Mu'jam al-Awsat 9394","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عطاء بن أبي رباح عن مطر بن طهمان الوراق عن سلام بن سليمان المزني عن الهيثم بن صالح عن محمد بن محمد بن مرزوق الباهلي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9403","9395  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  أَبُو الْجَوَّابِ ،  عَنْ  سُلَيْمَانَ بْنِ قَرْمٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقٍ ،  عَنْ  عَبْدِ اللهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا يَحِلُّ لِمُسْلِمٍ أَنْ يَهْجُرَ أَخَاهُ فَوْقَ ثَلَاثٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا  سُلَيْمَانُ بْنُ قَرْمٍ  ، وَلَا عَنْ  سُلَيْمَانَ  إِلَّا  أَبُو الْجَوَّابِ  ،  تَفَرَّدَ بِهِ  إِبْرَاهِيمُ بْنُ سَعِيدٍ  .","","Al-Mu'jam al-Awsat 9395","","عبد الله بن مسعود عن شقيق بن سلمة عن الأعمش عن سليمان بن قرم الضبي عن أحوص بن جواب الضبي عن إبراهيم بن سعيد الجوهري عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9404","9396  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  يَزِيدُ بْنُ عَمْرِو بْنِ الْبَرَاءِ الْغَنَوِيُّ ،  ثَنَا  حَفْصُ بْنُ عُمَرَ الْعَدَنِيُّ ،  ثَنَا  مُوسَى بْنُ سَعْدٍ ،  عَنْ  مَيْمُونٍ الْقَنَّادِ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَظَرَ  مُحَمَّدٌ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى رَبِّهِ تَبَارَكَ         [9/153]      وَتَعَالَى ، قَالَ  عِكْرِمَةُ  : فَقُلْتُ  لِابْنِ عَبَّاسٍ  : نَظَرَ  مُحَمَّدٌ  إِلَى رَبِّهِ ؟ قَالَ : "" نَعَمْ ؛  جَعَلَ الْكَلَامَ  لِمُوسَى  ،  وَالْخُلَّةَ  لِإِبْرَاهِيمَ  ، وَالنَّظَرَ  لِمُحَمَّدٍ  ، صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَيْمُونٍ الْقَنَّادِ  إِلَّا  مُوسَى بْنُ سَعْدٍ  ،  تَفَرَّدَ بِهِ  حَفْصُ بْنُ عُمَرَ الْعَدَنِيُّ  .","","Al-Mu'jam al-Awsat 9396","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن ميمون القناد عن موسى بن سعيد البصري عن حفص بن عمر بن ميمون الفرخ عن يزيد بن عمرو بن يزيد الغنوي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9405","9397  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  زَكَرِيَّا بْنُ يَحْيَى الْمَدَائِنِيُّ ،  نَا  شَبَابَةُ بْنُ سَوَّارٍ ،  ثَنَا  وَرْقَاءُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَزَوَّجَ  صَفِيَّةَ  ، وَجَعَلَ عِتْقَهَا صَدَاقَهَا  ، وَأَوْلَمَ لِلنَّاسِ  حَيْسًا  عَلَى نِطَعٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَنْصُورِ بْنِ الْمُعْتَمِرِ  إِلَّا  وَرْقَاءُ  ، وَلَا عَنْ  وَرْقَاءَ  إِلَّا  شَبَابَةُ  ،  تَفَرَّدَ بِهِ  زَكَرِيَّا بْنُ يَحْيَى  .","","Al-Mu'jam al-Awsat 9397","","أنس بن مالك عن قتادة بن دعامة عن منصور بن المعتمر عن ورقاء بن عمر عن شبابة بن سوار المدائني عن زكريا بن يحيى بن أيوب المدائني عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9406","9398  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  مُؤَمَّلُ بْنُ هِشَامٍ ،  ثَنَا  يَحْيَى بْنُ عَبَّادٍ ،  عَنِ  السَّرِيِّ بْنِ يَحْيَى ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  مُجَاهِدٍ ، قَالَ :  قَالَ  ابْنُ عُمَرَ :  لَقَدْ أُعْطِيتُ مِنْهُ شَيْئًا مَا أُعْطِيَهُ إِلَّا رَسُولُ اللهِ  ، صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  يَعْنِي : الْجِمَاعَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  السَّرِيِّ بْنِ يَحْيَى  إِلَّا  يَحْيَى بْنُ عَبَّادٍ  ،  تَفَرَّدَ بِهِ  مُؤَمَّلُ بْنُ هِشَامٍ  .","","Al-Mu'jam al-Awsat 9398","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن عبد الكريم الاصطخري عن السري بن يحيى الشيباني عن يحيى بن عباد الضبعي عن مؤمل بن هشام اليشكري عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9407","9399  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ النَّطَّاحِ ،  نَا  عَاصِمُ بْنُ هِلَالٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - احْتَجَمَ وَأَجَرَهُ  ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عِكْرِمَةَ  إِلَّا  عَاصِمُ بْنُ هِلَالٍ  ، وَرَوَاهُ غَيْرُهُ عَنْ  أَيُّوبَ  عَنْ  مُحَمَّدٍ  .","","Al-Mu'jam al-Awsat 9399","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن أيوب السختياني عن عاصم بن هلال البارقي عن ابن النطاح محمد بن صالح بن مهران عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9408","9400  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  عَلِيُّ بْنُ سِيَابَةَ الْكُوفِيُّ ،  ثَنَا  كَثِيرُ         [9/154]      بْنُ هِشَامٍ ،  نَا  سُلَيْمَانُ الْبَصْرِيُّ ، هُوَ الْقَافْلَانِيُّ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي الطُّفَيْلِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  كَانَ يُقَالُ : إِنَّ مِمَّا أَدْرَكَ النَّاسَ مِنْ كَلَامِ النُّبُوَّةِ : إِذَا لَمْ  تَسْتَحْيِي  فَاصْنَعْ  مَا شِئْتَ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي الطُّفَيْلِ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  عَلِيُّ بْنُ سِيَابَةَ  .","","Al-Mu'jam al-Awsat 9400","","عامر بن واثلة عن محمد بن عبد الرحمن الطفاوي عن سليمان بن أبي سليمان القافلاني عن كثير بن هشام الكلابي عن علي بن سيابة عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9409","9401  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  إِسْمَاعِيلُ بْنُ مُوسَى السُّدِّيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  بَيَانٍ ، أَوْ غَيْرِهِ  عَنْ  أَنَسٍ ، قَالَ :  كَانَ خَاتَمُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ  وَرِقٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بَيَانٍ  إِلَّا  شَرِيكٌ  ،  تَفَرَّدَ بِهِ  إِسْمَاعِيلُ بْنُ مُوسَى  .","","Al-Mu'jam al-Awsat 9401","","أنس بن مالك عن غيره عن شريك بن عبد الله النخعي عن إسماعيل بن موسى الفزاري عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9410","9402  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  مُحَمَّدُ بْنُ الْعَلَاءِ أَبُو كُرَيْبٍ ،  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  بَيَانٍ ،  عَنْ  عَامِرٍ ، وَذَكَرَ قَيْسٌ ،  قَالَ :  كَانَ ابْنُ مَسْعُودٍ "" يُحَدِّثُ  الشَّهْرَ  ، لَا يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ، فَإِذَا ذَكَرَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَالَ هَكَذَا ، أَوْ نَحْوًا مِنْ هَذَا ، أَوْ قَرِيبًا مِنْ هَذَا  ، وَكَانَ يُرْعَدُ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بَيَانٍ  إِلَّا  مُحَمَّدُ بْنُ فُضَيْلٍ  ،  تَفَرَّدَ بِهِ  أَبُو كُرَيْبٍ  .  وَقَيْسٌ  الَّذِي رَوَى عَنْهُ  الشَّعْبِيُّ  هَذَا الْحَدِيثَ هُوَ  قَيْسُ بْنُ قَهْدٍ  .","","Al-Mu'jam al-Awsat 9402","","عبد الله بن مسعود عن قيس بن أبي حازم عن الشعبي عن بيان بن بشر الأحمسي عن محمد بن فضيل بن غزوان عن أبو كريب محمد بن العلاء عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9411","9403  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  مُحَمَّدُ بْنُ حَشِيشٍ  ،  ثَنَا  مُفَضَّلُ بْنُ صَالِحٍ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْمَرْءُ مَعَ مَنْ أَحَبَّ  .         [9/155]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُحَادَةَ  إِلَّا  مُفَضَّلُ بْنُ صَالِحٍ  .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( خشيش )","","Al-Mu'jam al-Awsat 9403","","أنس بن مالك عن الحسن البصري عن محمد بن جحادة الأودي عن المفضل بن صالح النخاس عن محمد بن خشيش الجعفي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9412","9404  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  أَبُو مُوسَى الْأَنْصَارِيُّ ،  نَا  أَحْمَدُ بْنُ بَشِيرٍ الْهَمْدَانِيُّ ،  عَنْ  أَبِي الْبِلَادِ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  مَسْرُوقٍ ،  قَالَ  :  دَخَلْتُ عَلَى عَائِشَةَ وَعِنْدَهَا رَجُلٌ مَكْفُوفٌ ، تُقَطِّعُ لَهُ الْأُتْرُجَّ وَتُطْعِمُهُ إِيَّاهُ بِالْعَسَلِ ، فَقُلْتُ : مَنْ هَذَا يَا أُمَّ الْمُؤْمِنِينَ ؟ قَالَتْ : هَذَا  ابْنُ أُمِّ مَكْتُومٍ  ،  أَقْبَلَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعِنْدَهُ  عُتْبَةُ  وَشَيْبَةُ  ، فَأَقْبَلَ عَلَيْهِمَا  ، فَنَزَلَتْ :         {      عَبَسَ وَتَوَلَّى             *          أَنْ جَاءَهُ الأَعْمَى         }      قَالَتِ :  ابْنُ أُمِّ مَكْتُومٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الْبِلَادِ  ، عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ  إِلَّا  أَحْمَدُ بْنُ بَشِيرٍ ،  تَفَرَّدَ بِهِ  أَبُو مُوسَى الْأَنْصَارِيُّ  .","","Al-Mu'jam al-Awsat 9404","","عائشة بنت أبي بكر الصديق عن مسروق بن الأجدع عن مسلم بن صبيح الهمداني عن يحيى بن أبى سليمان الغطفاني عن أحمد بن بشير المخزومى عن إسحاق بن موسى الخطمي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9413","9405  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ الدُّورِيُّ ،  ثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الْمَوْصِلِيُّ ،  ثَنَا  أَبُو إِسْمَاعِيلَ الْمُؤَدِّبُ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  تَسَحَّرُوا ؛ فَإِنَّ فِي السَّحُورِ بَرَكَةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ  إِلَّا  أَبُو إِسْمَاعِيلُ  ،  تَفَرَّدَ بِهِ  أَحْمَدُ بْنُ إِبْرَاهِيمَ  .","","Al-Mu'jam al-Awsat 9405","","أبو هريرة الدوسي عن عطاء بن أبي رباح عن يعقوب بن عطاء بن أبي رباح المكي عن إبراهيم بن سليمان أبو إسماعيل عن أحمد بن إبراهيم بن خالد عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9414","9406  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ الدُّورِيُّ ،  نَا  أَحْمَدُ بْنُ يَزِيدَ بْنِ سُلَيْمَانَ - مَوْلَى بَنِي هَاشِمٍ -  نَا  حُسَيْنُ بْنُ الْحَسَنِ الْأَشْقَرُ ،  نَا  هُشَيْمٌ ،  عَنْ  أَبِي هَاشِمٍ الرُّمَّانِيِّ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَزُولُ قَدَمَا الْعَبْدِ يَوْمَ الْقِيَامَةِ حَتَّى يُسْأَلَ عَنْ أَرْبَعٍ  : عَنْ عُمُرِهِ فِيمَا أَفْنَى ، وَعَنْ جَسَدِهِ فِيمَا أَبْلَاهُ ، وَعَنْ مَالِهِ         [9/156]      فِيمَا أَنْفَقَهُ وَمِنْ أَيْنَ كَسَبَهُ ، وَعَنْ حُبِّنَا أَهْلَ الْبَيْتِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي هَاشِمٍ  إِلَّا  هُشَيْمٌ  ، وَلَا عَنْ  هُشَيْمٍ  إِلَّا  حُسَيْنُ بْنُ حَسَنٍ  ،  تَفَرَّدَ بِهِ  أَحْمَدُ بْنُ يَزِيدَ  .","","Al-Mu'jam al-Awsat 9406","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن يحيى بن دينار الرماني عن هشيم بن بشير عن الحسين بن الحسن الأشقر عن أحمد بن محمد ابن أبي الخناجر عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9415","9407  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  هَارُونُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبُو خَالِدٍ الْأَحْمَرُ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ - نَحْوَ حَدِيثِ  قَبِيلَةَ  - :  لَيْسَ عَلَى فَرَسِ الْغَازِي وَعَبْدِهِ صَدَقَةٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَحْيَى بْنِ سَعِيدٍ  إِلَّا  أَبُو خَالِدٍ  ،  تَفَرَّدَ بِهِ  هَارُونُ بْنُ إِسْحَاقَ  .","","Al-Mu'jam al-Awsat 9407","","أبو هريرة الدوسي عن سعيد بن المسيب عن يحيى بن سعيد الأنصاري عن سليمان بن حيان الأحمر عن هارون بن إسحاق الهمداني عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9416","9408  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ أَبُو الْأَسْبَاطِ ،  ثَنَا  أَبُو بِلَالٍ الْأَشْعَرِيُّ ،  عَنْ  قَيْسِ بْنِ الرَّبِيعِ ،  عَنْ  أَبِي حَصِينٍ ،  عَنِ  الْقَاسِمِ بْنِ حَسَّانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ عَشْرِ خِلَالٍ  : عَنْ  تَغْيِيرِ  الشَّيْبِ وَعَنْ نَتْفِهِ ، وَعَنِ الصُّفْرَةِ ، وَعَنْ إِسْبَالِ الْإِزَارِ ، وَعَنْ عَقْدِ  التَّمَائِمِ  ، وَعَنْ ضَرْبِ  الْكِعَابِ  ، وَعَنِ التَّعَوُّذِ -  يَعْنِي التَّعْوِيذَاتِ  - ، وَعَنِ التَّخَتُّمِ بِالذَّهَبِ ، وَعَنِ  التَّبَرُّجِ  بِالزِّينَةِ لِغَيْرِ  مَحَلِّهَا  ، وَعَنْ  عَزْلِ  الْمَاءِ عَنْ مَحَلِّهِ ،         [9/157]      وَعَنْ  إِفْسَادِ  الصَّبِيِّ غَيْرَ مُحَرِّمِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي حَصِينٍ  إِلَّا  قَيْسٌ  ، وَلَا عَنْ  قَيْسٍ  إِلَّا  أَبُو بِلَالٍ  ،  تَفَرَّدَ بِهِ  أَبُو الْأَسْبَاطِ  .","","Al-Mu'jam al-Awsat 9408","","عبد الله بن مسعود عن عبد الرحمن بن حرملة الكوفي عن القاسم بن حسان العامري عن عثمان بن عاصم بن حصين عن قيس بن الربيع الأسدي عن أبو بلال الأشعري عن يعقوب بن إبراهيم الكوفى عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9417","9409  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  عَبَّادُ بْنُ يَعْقُوبَ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْقُدُّوسِ ،  عَنْ  فِطْرٍ ،  عَنْ  أَبِي هَارُونَ ،  عَنْ  أَبِي سَعِيدٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى عَلَى  النَّجَاشِيِّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  فِطْرٍ  إِلَّا  عَبْدُ اللهِ بْنُ عَبْدِ الْقُدُّوسِ  ،  تَفَرَّدَ بِهِ  عَبَّادُ بْنُ يَعْقُوبَ  .","","Al-Mu'jam al-Awsat 9409","","أبو سعيد الخدري عن عمارة بن جوين العبدي عن فطر بن خليفة عن عبد الله بن عبد القدوس الرازي عن عباد بن يعقوب الرواجني عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9418","9410  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  مُحَمَّدُ بْنُ أَبَانَ الْبَلْخِيُّ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ ،  عَنْ  عَائِشَةَ ،  أَنَّهَا "" أُهْدِيَتْ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهَا لُعَبُهَا  .  لَمْ يَرْوِ  أَبُو أُسَامَةَ  عَنْ  عَبْدِ الرَّزَّاقِ  إِلَّا هَذَا الْحَدِيثَ وَحَدِيثًا آخَرَ  .","","Al-Mu'jam al-Awsat 9410","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن حماد بن أسامة القرشي عن محمد بن أبى إبراهيم حمدويه عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9419","9411  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي النَّضْرِ ،  ثَنَا  أَبُو النَّضْرِ ،  ثَنَا  أَبُو مَالِكٍ النَّخَعِيُّ عَبْدُ الْمَلِكِ بْنُ الْحُسَيْنِ ،  عَنْ  أَبِي الْمُحَجَّلِ ،  عَنِ  ابْنِ أَخِي أَنَسِ بْنِ مَالِكٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  كَانَ مَقَامِي بَيْنَ كَتِفَيْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَكَانَ إِذَا سَلَّمَ قَالَ :  اللَّهُمَّ اجْعَلْ خَيْرَ عُمُرِي آخِرَهُ  ، اللَّهُمَّ اجْعَلْ خَوَاتِيمَ عَمَلِي رِضْوَانَكَ ، اللَّهُمَّ اجْعَلْ خَيْرَ أَيَّامِي يَوْمَ أَلْقَاكَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي الْمُحَجَّلِ  إِلَّا  عَبْدُ الْمَلِكِ بْنُ حُسَيْنٍ  ، وَلَا عَنْ  عَبْدِ الْمَلِكِ  إِلَّا  أَبُو النَّضْرِ  ،  تَفَرَّدَ بِهِ  أَبُو بَكْرِ بْنُ أَبِي النَّضْرِ  .","","Al-Mu'jam al-Awsat 9411","","أنس بن مالك عن إسحاق بن عبد الله بن أبي طلحة الخزرجي عن قطن أبو المحجل عن ابن ذر ، عبد الملك بن الحسين النخعي عن هاشم بن القاسم بن مسلم عن أبو بكر بن النضر بن أبي النضر البغدادي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9420","9412  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ،  نَا  عَبْدُ الصَّمَدِ         [9/158]      بْنُ عَبْدِ الْوَارِثِ ،  ثَنَا  شُعْبَةُ ،  عَنْ  زَائِدَةَ ،  عَنْ  أَبِي حَصِينٍ ،  عَنْ  ذَكْوَانَ ،  عَنْ  عَائِشَةَ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى فِي ثَوْبٍ بَعْضُهُ عَلَيَّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شُعْبَةَ  إِلَّا  عَبْدُ الصَّمَدِ  ،  تَفَرَّدَ بِهِ  أَحْمَدُ الدَّوْرَقِيُّ  .","","Al-Mu'jam al-Awsat 9412","","عائشة بنت أبي بكر الصديق عن ذكوان السمان عن عثمان بن عاصم بن حصين عن زائدة بن قدامة عن شعبة بن الحجاج عن عبد الصمد بن عبد الوارث التنوري عن أحمد بن إبراهيم بن كثير عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9421","9413  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  الْفَضْلُ بْنُ إِسْحَاقَ الدُّورِيُّ ،  نَا  عُمَرُ بْنُ أَيُّوبَ الْمَوْصِلِيُّ ،  عَنْ  عِيسَى بْنِ الْمُسَيِّبِ الْبَجَلِيِّ ،  عَنْ  عَامِرٍ الشَّعْبِيِّ ،  عَنِ  الصُّبَيِّ بْنِ مَعْبَدٍ التَّغْلِبِيِّ ،  أَنَّهُ أَهَلَّ بِالْحَجِّ وَالْعُمْرَةِ جَمِيعًا ، فَلَمَّا ظَهَرَ مِنَ  الْقَادِسِيَّةِ  مَرَّ بِهِ رَاكِبَانِ ، وَهُوَ يُلَبِّي بِالْحَجِّ وَالْعُمْرَةِ جَمِيعًا ، فَقَالَ أَحَدُهُمَا : أَلَا تَسْمَعُ ؟ فَقَالَ : دَعْهُ ؛ فَهُوَ أَضَلُّ مِنْ بَعِيرِهِ ، فَأَخَذَنِي مَا قَصُرَ وَمَا طَالَ ، فَأَمْعَنْتُ حَتَّى لَقِيَنِي مَنْ أَخْبَرَ عَنْهُمَا ، قُلْتُ : مَنْ هَذَانِ الرَّاكِبَانِ ؟ قَالَ : هَذَا  سَلْمَانُ بْنُ رَبِيعَةَ الْبَاهِلِيُّ  وَزَيْدُ بْنُ صُوحَانَ  ، فَقَدِمْتُ  الْمَدِينَةَ  ، فَأَتَيْتُ عُمَرَ ، فَحَدَّثْتُهُ فَأَخْبَرْتُهُ بِمَا قَالَا ،  فَقَالَ  :  أَخْطَآ وَأَصَبْتَ ، هُدِيتَ لِسُنَّةِ نَبِيِّكَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  ، ثُمَّ أَرْسَلَ إِلَيْهِمَا فَنَهَاهُمَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الشَّعْبِيِّ  إِلَّا  عِيسَى بْنُ الْمُسَيِّبِ  ، وَلَا عَنْ  عِيسَى  إِلَّا  عُمَرُ بْنُ أَيُّوبَ  ،  تَفَرَّدَ بِهِ  الْفَضْلُ بْنُ إِسْحَاقَ  .","","Al-Mu'jam al-Awsat 9413","","عمر بن الخطاب عن صبي بن معبد التغلبي عن الشعبي عن عيسى بن المسيب البجلي عن عمر بن أيوب الموصلي عن الفضل بن إسحاق بن حيان الدوري عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9422","[9/159]      9414  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  عُبَيْدُ اللهِ بْنُ عُمَرَ الْقَوَارِيرِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  نَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنْ  خَالِدِ بْنِ كَثِيرٍ الْهَمْدَانِيِّ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  زِرِّ بْنِ حُبَيْشٍ ،  عَنْ  صَفْوَانَ بْنِ عَسَّالٍ الْمُرَادِيِّ ، قَالَ :  جِئْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَسْأَلُهُ عَنِ الْمَسْحِ عَلَى الْخُفَّيْنِ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، جِئْتُ أَسْأَلُكَ عَنِ الْعِلْمِ ، فَقَالَ :  إِنَّ الْمَلَائِكَةَ  تَضَعُ  أَجْنِحَتَهَا  لِطَالِبِ الْعِلْمِ مِنْ حُبِّهَا لِمَا جَاءَ يَطْلُبُ  ، وَعَنْ أَيِّ الْعِلْمِ تَسْأَلُ ؟ "" قُلْتُ : يَا رَسُولَ اللهِ ، عَنِ الْمَسْحِ عَلَى الْخُفَّيْنِ ، قَالَ : "" نَعَمْ ، يَوْمٌ وَلَيْلَةٌ لِلْمُقِيمِ ، وَثَلَاثٌ لِلْمُسَافِرِ مِنَ الْغَائِطِ وَالْبَوْلِ ، ثُمَّ تُحْدِثُ وُضُوءًا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خَالِدِ بْنِ كَثِيرٍ  إِلَّا  مُحَمَّدُ بْنُ إِسْحَاقَ  ،  تَفَرَّدَ بِهِ  عَبْدُ الْأَعْلَى  .","","Al-Mu'jam al-Awsat 9414","","صفوان بن عسال المرادي عن زر بن حبيش الثعلبي عن عاصم بن بهدلة عن خالد بن كثير الهمداني عن محمد بن إسحاق عن عبد الأعلى بن عبد الأعلى القرشي عن عبيد الله بن عمر القواريري عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9423","9415  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  نَا  هَاشِمُ بْنُ الْوَلِيدِ الْهَرَوِيُّ ،  ثَنَا  كِنَانَةُ بْنُ جَبَلَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ طَهْمَانَ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  أَبِي عُثْمَانَ ،  عَنْ  أَبِي هُرَيْرَةَ ، قَالَ :  أَمَرَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ أُنَادِيَ فِي  أَهْلِ الْمَدِينَةِ  :  إِنَّ فِي كُلِّ صَلَاةٍ قِرَاءَةً ، وَلَوْ بِفَاتِحَةِ الْكِتَابِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَجَّاجِ  إِلَّا  إِبْرَاهِيمُ بْنُ طَهْمَانَ  .","","Al-Mu'jam al-Awsat 9415","","أبو هريرة الدوسي عن أبو عثمان النهدي عن عبد الكريم الاصطخري عن حجاج بن أرطاة عن إبراهيم بن طهمان عن كنانة بن جبلة الهروي عن هاشم بن الوليد الهروي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9424","9416  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَمَّارٍ الْمَوْصِلِيُّ ،  ثَنَا  عُمَرُ بْنُ أَيُّوبَ ،  عَنْ  مَصَادِ بْنِ عُقْبَةَ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  صُومُوا لِرُؤْيَتِهِ ، وَأَفْطِرُوا لِرُؤْيَتِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زِيَادِ بْنِ سَعْدٍ  إِلَّا  مَصَادُ بْنُ عُقْبَةَ  ، وَلَا عَنْ  مَصَادٍ  إِلَّا  عُمَرُ بْنُ أَيُّوبَ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ عَمَّارٍ  .","","Al-Mu'jam al-Awsat 9416","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زياد بن سعد الخراساني عن مصاد بن عقبة عن عمر بن أيوب الموصلي عن محمد بن عبد الله بن عمار الغامدي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9425","9417  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  أَبُو مُوسَى الْأَنْصَارِيُّ ،  ثَنَا  أَبُو غَزِيَّةَ مُحَمَّدُ         [9/160]      بْنُ مُوسَى ،  نَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي وَجْهِ  الْكَعْبَةِ  ، مُحْتَبِيًا بِيَدَيْهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُمَرَ بْنِ مُحَمَّدٍ  إِلَّا  إِبْرَاهِيمُ بْنُ سَعْدٍ  ، وَلَا عَنْ  إِبْرَاهِيمَ  إِلَّا  أَبُو غَزِيَّةَ  ،  تَفَرَّدَ بِهِ  أَبُو مُوسَى الْأَنْصَارِيُّ  .","","Al-Mu'jam al-Awsat 9417","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عمر بن محمد بن زيد بن عبد الله بن عمر بن الخطاب عن إبراهيم بن سعد أبو إسحاق الزهري عن محمد بن موسى بن مسكين المديني عن إسحاق بن موسى الخطمي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9426","9418  -  حَدَّثَنَا  هَيْثَمٌ ،  ثَنَا  أَبُو مُوسَى ،  نَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَفْضَلَ الْحَدِيثِ كِتَابُ اللهِ ، وَأَحْسَنَ  الْهَدْيِ  هَدْيُ  مُحَمَّدٍ  ، وَشَرَّ الْأُمُورِ  مُحْدَثَاتُهَا  ، وَكُلَّ بِدْعَةٍ ضَلَالَةٌ ، وَمَنْ تَرَكَ مَالًا فَلِأَهْلِهِ ، وَمَنْ تَرَكَ دَيْنًا أَوْ  ضَيَاعًا  فَعَلَيَّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ جَعْفَرِ بْنِ مُحَمَّدٍ  إِلَّا  أَبُو مُوسَى الْأَنْصَارِيُّ  .","","Al-Mu'jam al-Awsat 9418","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو جعفر الباقر عن جعفر الصادق عن محمد بن جعفر ابن علي بن الحسين العلوي عن إسحاق بن موسى الخطمي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9427","9419  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  عَلِيُّ بْنُ سِيَابَةَ  ،  ثَنَا  عَلِيُّ بْنُ يُونُسَ الْبَلْخِيُّ ،  عَنْ  هِشَامِ بْنِ الْغَازِ  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُشَدُّ  الْمَطِيُّ  إِلَّا إِلَى ثَلَاثَةِ مَسَاجِدَ  :  الْمَسْجِدِ الْحَرَامِ  ، وَمَسْجِدِي هَذَا ،  وَالْمَسْجِدِ الْأَقْصَى  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  هِشَامِ بْنِ الْغَازِ  إِلَّا  عَلِيُّ بْنُ يُونُسَ  ،  تَفَرَّدَ بِهِ  عَلِيُّ بْنُ سِيَابَةَ  .  كذا في طبعة دار الحرمين ، والصواب : ( يعلى )","","Al-Mu'jam al-Awsat 9419","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن هشام بن الغاز الجرشي عن علي بن يونس البلخي عن يعلى بن مرة الثقفي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9428","9420  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  عَلِيُّ بْنُ سِيَابَةَ ،  ثَنَا  عَمْرُو ابْنُ أَخِي الْحَسَنِ بْنِ عَمْرٍو ،  ثَنَا  عَمِّي الْحَسَنُ بْنُ عَمْرٍو ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ، قَالَ :  لَمَّا رَآنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا أُمْسِكُ شَيْئًا ، إِنَّمَا أُنْفِقُهُ ، قَالَ لِي :  يَا  جَرِيرُ  لَا عَلَيْكَ أَنْ تُمْسِكَ عَلَيْكَ مَالَكَ ؛ فَإِنَّ لِهَذَا الْأَمْرِ مُدَّةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الشَّعْبِيِّ  إِلَّا  الْحَسَنُ بْنُ عَمْرٍو  ، وَلَا عَنِ  الْحَسَنِ  إِلَّا ابْنُ         [9/161]      أَخِيهِ  عَمْرُو بْنُ عَبْدِ الْغَفَّارِ  ،  تَفَرَّدَ بِهِ  عَلِيُّ بْنُ سِيَابَةَ  .","","Al-Mu'jam al-Awsat 9420","","جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن الحسن بن عمرو الفقيمي عن عمرو بن عبد الغفار الفقيمي عن علي بن سيابة عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9429","9421  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  عَلِيُّ بْنُ سِيَابَةَ ،  ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ الْقُرَشِيُّ ،  ثَنَا  أَبُو سِنَانٍ سَعْدُ بْنُ سِنَانٍ الشَّيْبَانِيُّ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  صِلَةَ بْنِ زُفَرَ ،  عَنْ  حُذَيْفَةَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اسْتَشْرِفُوا الْعَيْنَ وَالْأُذُنَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  صِلَةَ  ، عَنْ  حُذَيْفَةَ  إِلَّا  أَبُو سِنَانٍ  ، وَلَا عَنْ  أَبِي سِنَانٍ  إِلَّا  مُحَمَّدُ بْنُ كَثِيرٍ  ،  تَفَرَّدَ بِهِ  عَلِيُّ بْنُ سِيَابَةَ  .  وَرَوَاهُ النَّاسُ عَنْ  أَبِي إِسْحَاقَ  ، عَنْ  سُرَيْجِ بْنِ النُّعْمَانِ  ، عَنْ  عَلِيٍّ  .  وَرَوَاهُ  أَبُو وَكِيعٍ  ، عَنْ  أَبِي إِسْحَاقَ  ، عَنْ  هُبَيْرَةَ بْنِ يَرِيمَ  ، عَنْ  عَلِيٍّ  .  كذا في طبعة دار الحرمين ، والصواب : ( سعيد بن سنان )","","Al-Mu'jam al-Awsat 9421","","حذيفة بن اليمان عن صلة بن زفر العبسي عن أبو إسحاق السبيعي عن سعيد بن سنان البرجمي عن محمد بن كثير القرشي عن علي بن سيابة عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9430","9422  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  الْحَسَنُ بْنُ شَوْكَرٍ ،  ثَنَا  يُوسُفُ بْنُ عَطِيَّةَ الصَّفَّارُ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَبِي هُرَيْرَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يُتِمَّ صَوْمَ شَهْرٍ بَعْدَ رَمَضَانَ ، إِلَّا رَجَبَ وَشَعْبَانَ  .  لَمْ يَرْوِهِ عَنْ  هِشَامٍ  إِلَّا  يُوسُفُ بْنُ عَطِيَّةَ  .","","Al-Mu'jam al-Awsat 9422","","أبو هريرة الدوسي عن محمد بن سيرين عن هشام بن حسان العتكي عن يوسف بن عطية بن ثابت الصفار عن الحسن بن شوكر البغدادي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9431","9423  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  مُحَمَّدُ بْنُ عَمَّارٍ الْمَوْصِلِيُّ ،  نَا  الْقَاسِمُ بْنُ يَزِيدَ الْجَزْمِيُّ ،  عَنْ  صَدَقَةَ بْنِ عَبْدِ اللهِ الدِّمَشْقِيِّ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  مُحَمَّدِ بْنِ زِيَادٍ الْمَدَنِيِّ ،  عَنْ  فُرَاتٍ ، مَوْلَى عَائِشَةَ ، قَالَ :  قَالَتْ  عَائِشَةُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ دَخَلَ  الرَّهَجُ  جَوْفَهُ لَمْ يَدْخُلِ النَّارَ أَبَدًا  .         [9/162]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  صَدَقَةُ  ، وَلَا عَنْ  صَدَقَةَ  إِلَّا  الْقَاسِمُ بْنُ يَزِيدَ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ عَمَّارٍ  .","","Al-Mu'jam al-Awsat 9423","","عائشة بنت أبي بكر الصديق عن فرات مولى عائشة عن محمد بن زياد الجمحي عن ابن جريج عن صدقة بن عبد الله السمين عن القاسم بن يزيد الجرمي عن محمد بن عبد الله بن عمار الغامدي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9432","9424  -  حَدَّثَنَا  هَيْثَمٌ ،  ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  نَا  أَبُو مَعْشَرٍ ،  عَنْ  شُرَحْبِيلَ بْنِ سَعْدٍ ، قَالَ :  أَخَذْتُ طَيْرًا فِي  بَنِي حَارِثَةَ  ، فَأَخَذَهُ رَافِعُ بْنُ خَدِيجٍ ، فَأَرْسَلَهُ ،  وَقَالَ  : أَمَا عَلِمْتَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَرَّمَ مَا بَيْنَ  لَابَتَيِ  الْمَدِينَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  شُرَحْبِيلَ  ، عَنْ  رَافِعٍ ،  إِلَّا  أَبُو مَعْشَرٍ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ بَكَّارٍ  .  وَرَوَاهُ النَّاسُ عَنْ  شُرَحْبِيلَ  ، عَنْ  زَيْدِ بْنِ ثَابِتٍ  .","","Al-Mu'jam al-Awsat 9424","","رافع بن خديج الأنصاري عن شرحبيل بن سعد الخطمي عن نجيح بن عبد الرحمن السندي عن محمد بن بكار الرصافي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9433","9425  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  زَكَرِيَّا بْنُ يَحْيَى الْمَدَائِنِيُّ ،  نَا  شَبَابَةُ بْنُ سَوَّارٍ ،  نَا  الْمُغِيرَةُ بْنُ مُسْلِمٍ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى أَنْ نَمُنَّ عَلَى أَوْلَادِ الزِّنَا  -  يَعْنِي : فِي الْعِتْقِ  ""  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَطَرٍ  إِلَّا  الْمُغِيرَةُ  ، وَلَا عَنِ  الْمُغِيرَةِ  إِلَّا  شَبَابَةُ  ،  تَفَرَّدَ بِهِ  زَكَرِيَّا بْنُ يَحْيَى  .","","Al-Mu'jam al-Awsat 9425","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن مطر بن طهمان الوراق عن المغيرة بن مسلم القسملي عن شبابة بن سوار المدائني عن زكريا بن يحيى بن أيوب المدائني عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9434","9426  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  الْحَسَنُ بْنُ حَمَّادٍ الْوَرَّاقُ ،  ثَنَا  أَبُو يَحْيَى الْحِمَّانِيُّ ،  عَنْ  يُوسُفَ بْنِ مَيْمُونٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  لَمَّا افْتَتَحَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مَكَّةَ  قَالَ :  إِنَّ اللهَ وَرَسُولَهُ حَرَّمَ عَلَيْكُمْ شُرْبَ الْخَمْرِ وَثَمَنَهَا  ، وَحَرَّمَ عَلَيْكُمْ أَكْلَ الْمَيْتَةِ وَثَمَنَهَا ، وَحَرَّمَ عَلَيْكُمُ الْخَنَازِيرَ وَأَكْلَهَا وَثَمَنَهَا "" . وَقَالَ : "" قُصُّوا الشَّوَارِبَ ، وَأَعْفُوا اللِّحَى ، وَلَا تَمْشُوا فِي الْأَسْوَاقِ إِلَّا وَعَلَيْكُمُ الْأُزُرُ ، إِنَّهُ لَيْسَ مِنَّا مَنْ عَمِلَ سُنَّةَ غَيْرِنَا  .","","Al-Mu'jam al-Awsat 9426","","عبد الله بن عباس عن عطاء بن أبي رباح عن يوسف بن ميمون الصباغ عن عبد الحميد بن عبد الرحمن بشمين عن الحسن بن حماد الوراق عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9435","[9/163]      9427  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  الْحَسَنُ بْنُ حَمَّادٍ الْوَرَّاقُ ،  ثَنَا  أَبُو يَحْيَى الْحِمَّانِيُّ ،  عَنْ  يُوسُفَ بْنِ مَيْمُونٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  عُمَرَ  وَمَعَهُ أُنَاسٌ مِنْ أَصْحَابِهِ ، فَقَالَ :  أَمُؤْمِنُونَ أَنْتُمْ ؟  فَسَكَتُوا - ثَلَاثَ مَرَّاتٍ - فَقَالَ  عُمَرُ  فِي آخِرِهِمْ : نَعَمْ ، نُؤْمِنُ عَلَى مَا أَتَيْتَنَا بِهِ ، وَنَحْمَدُ اللهَ فِي الرَّخَاءِ ، وَنَصْبِرُ عَلَى الْبَلَاءِ ، وَنُؤْمِنُ بِالْقَضَاءِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" مُؤْمِنُونَ وَرَبِّ الْكَعْبَةِ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عَطَاءٍ  إِلَّا  يُوسُفُ بْنُ مَيْمُونٍ  ، وَلَا عَنْ  يُوسُفَ  إِلَّا  أَبُو يَحْيَى الْحِمَّانِيُّ  ،  تَفَرَّدَ بِهِمَا  الْحَسَنُ بْنُ حَمَّادٍ الْوَرَّاقُ  .","","Al-Mu'jam al-Awsat 9427","","عبد الله بن عباس عن عطاء بن أبي رباح عن يوسف بن ميمون الصباغ عن عبد الحميد بن عبد الرحمن بشمين عن الحسن بن حماد الوراق عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9436","9428  -  حَدَّثَنَا  هَيْثَمٌ ،  نَا  عَلِيُّ بْنُ سِيَابَةَ ،  نَا  بِشْرُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِمْرَانَ الْوَاسِطِيُّ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي أَوْفَى ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّهُ لَيَبْلُغُ مِنْ عَدْلِ اللهِ يَوْمَ الْقِيَامَةِ حَتَّى يَقْتَصَّ  لِلْجَمَّاءِ  مِنْ ذَاتِ الْقَرْنِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَطَاءِ بْنِ السَّائِبِ  إِلَّا  عَبْدُ اللهِ بْنُ عِمْرَانَ  ، وَلَا عَنْ  عَبْدِ اللهِ  إِلَّا  بِشْرُ بْنُ مُحَمَّدٍ  ،  تَفَرَّدَ بِهِ  عَلِيُّ بْنُ سِيَابَةَ  .","","Al-Mu'jam al-Awsat 9428","","عبد الله بن أبي أوفى الأسلمي عن عطاء بن السائب عن عبد الله بن عمران الواسطي عن بشر بن محمد بن أبان السكري عن علي بن سيابة عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9437","9429  -  حَدَّثَنَا  هَيْثَمُ  بْنُ خَلَفٍ ،  نَا  الْحُسَيْنُ بْنُ مَهْدِيٍّ الْأُبُلِّيُّ ،  ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  نَا  وَرْقَاءُ بْنُ عُمَرَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَوَضَّأَ مَرَّةً مَرَّةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمْرِو بْنِ دِينَارٍ  إِلَّا  وَرْقَاءُ  ، وَلَا عَنْ  وَرْقَاءَ  إِلَّا  حَجَّاجُ بْنُ نُصَيْرٍ  ،  تَفَرَّدَ بِهِ  الْحُسَيْنُ بْنُ مَهْدِيٍّ  .  كذا في طبعة دار الحرمين : ( هشيم ) ، والصواب المثبت كما في طبعة الطحان وسياق الأحاديث قبله وينظر ترجمته في تاريخ بغداد وغيره","","Al-Mu'jam al-Awsat 9429","","عبد الله بن عباس عن عطاء بن أبي رباح عن عمرو بن دينار الأثرم عن ورقاء بن عمر عن حجاج بن نصير الفساطيطي عن الحسين بن مهدي الأبلي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9438","9430  -  حَدَّثَنَا  هُشَيْمُ بْنُ خَلَفٍ  ،  نَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْأَسَدِيُّ ،  نَا  أَبِي  ،  نَا  شَرِيكُ بْنُ عَبْدِ اللهِ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسِ بْنِ أَبِي حَازِمٍ ، قَالَ :         [9/164]      خَطَبَ عُمَرُ بْنُ الْخَطَّابِ النَّاسَ ذَاتَ يَوْمٍ عَلَى مِنْبَرِ  الْمَدِينَةِ  ،  فَقَالَ  فِي خُطْبَتِهِ :  إِنَّ فِي جَنَّاتِ عَدْنٍ قَصْرًا لَهُ خَمْسُمِائَةِ بَابٍ  ، عَلَى كُلِّ بَابٍ خَمْسَةُ آلَافٍ مِنَ  الْحُورِ  الْعِينِ  ، لَا يَدْخُلُهُ إِلَّا نَبِيٌّ ، ثُمَّ نَظَرَ إِلَى قَبْرِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : هَنِيئًا لَكَ يَا صَاحِبَ الْقَبْرِ ، ثُمَّ قَالَ : أَوْ صِدِّيقٌ ، ثُمَّ الْتَفَتَ إِلَى قَبْرِ  أَبِي بَكْرٍ  ، فَقَالَ : هَنِيئًا لَكَ يَا  أَبَا بَكْرٍ  ، ثُمَّ قَالَ : أَوْ شَهِيدٌ  ، ثُمَّ أَقْبَلَ عَلَى نَفْسِهِ ، فَقَالَ : وَأَنَّى لَكَ الشَّهَادَةُ يَا عُمَرُ ، ثُمَّ قَالَ : إِنَّ الَّذِي أَخْرَجَنِي مِنْ  مَكَّةَ  إِلَى هِجْرَةِ  الْمَدِينَةِ  لَقَادِرٌ أَنْ يَسُوقَ إِلَيَّ الشَّهَادَةَ "" . قَالَ  ابْنُ مَسْعُودٍ  :  فَسَاقَهَا اللهُ إِلَيْهِ عَلَى يَدِ شَرِّ خَلْقِهِ ،  مَجُوسِيٍّ عَبْدٍ مَمْلُوكٍ لِلْمُغِيرَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  إِسْمَاعِيلَ  إِلَّا  شَرِيكٌ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ الْحَسَنِ  .  كذا في طبعة دار الحرمين ، ولعل الصواب : ( هيثم )","","Al-Mu'jam al-Awsat 9430","","عمر بن الخطاب عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن شريك بن عبد الله النخعي عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9439","9431  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  مُحَمَّدُ بْنُ أَبِي عُمَرَ الدُّورِيُّ ،  ثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ الْحَضْرَمِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  بَيَانٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  الْبُزَاقُ فِي الْمَسْجِدِ خَطِيئَةٌ  ، وَكَفَّارَتُهَا دَفْنُهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  بَيَانٍ  إِلَّا  أَبُو عَوَانَةَ  ، وَلَا عَنْ  أَبِي عَوَانَةَ  إِلَّا  أَحْمَدُ بْنُ إِسْحَاقَ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ أَبِي عُمَرَ  .","","Al-Mu'jam al-Awsat 9431","","أنس بن مالك عن بيان بن بشر الأحمسي عن الوضاح بن عبد الله اليشكري عن أحمد بن إسحاق الحضرمي عن محمد بن عمر بن أبي عمر المقرئ عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9440","9432  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ ،  نَا  حَاجِبُ بْنُ         [9/165]      الْوَلِيدِ ،  نَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  إِبْرَاهِيمَ بْنِ أَدْهَمَ ،  عَنْ  مُقَاتِلِ بْنِ حَيَّانَ ،  عَنْ  شَهْرِ بْنِ حَوْشَبٍ ، قَالَ :  قُلْتُ  لِأُمِّ سَلَمَةَ : مَا كَانَ أَكْثَرُ دُعَاءِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقَالَتْ : "" يَا مُقَلِّبَ الْقُلُوبِ ، ثَبِّتْ قَلْبِي عَلَى دِينِكَ "" ، قُلْتُ : يَا رَسُولَ اللهِ ، مَا أَكْثَرَ دُعَاءَكَ هَذَا ؟ قَالَ :  إِنَّ الْقُلُوبَ بَيْنَ  أُصْبُعَيْنِ  مِنْ أَصَابِعِ الرَّحْمَنِ ، مَا شَاءَ أَزَاغَ ، وَمَا شَاءَ أَقَامَ  .  لَمْ يَرْوِ عَنْ  إِبْرَاهِيمَ بْنِ أَدْهَمَ  إِلَّا  بَقِيَّةُ  ، وَلَا عَنْ  بَقِيَّةَ  إِلَّا  حَاجِبُ بْنُ الْوَلِيدِ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ مَنْصُورٍ الطُّوسِيُّ  .","","Al-Mu'jam al-Awsat 9432","","هند بنت أبي أمية زوج رسول الله عن شهر بن حوشب عن مقاتل بن حيان عن إبراهيم بن أدهم الزاهد عن بقية بن الوليد عن حاجب بن الوليد الأعور المؤدب عن محمد بن منصور الطوسي عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9441","9433  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  مَيْمُونُ بْنُ الْأَصْبَغِ ،  ثَنَا  عَبْدُ اللهِ بْنُ عِصْمَةَ النَّصِيبِينِيُّ ،  نَا  مُحَمَّدُ بْنُ سَلَمَةَ الْعَفَّانِيُّ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي سُفْيَانَ ،  عَنْ  جَابِرٍ ، قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، عَنِ الضَّحِكِ مِنَ الضَّرْطَةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا  مُحَمَّدُ بْنُ سَلَمَةَ  ، وَلَا عَنْ  مُحَمَّدِ بْنِ سَلَمَةَ  إِلَّا  عَبْدُ اللهِ بْنُ عِصْمَةَ  ،  تَفَرَّدَ بِهِ  مَيْمُونُ بْنُ الْأَصْبَغِ  .  كذا في طبعة دار الحرمين ، والصواب : ( محمد بن سلمة بن البناني )","","Al-Mu'jam al-Awsat 9433","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن طلحة بن نافع العراقي عن الأعمش عن محمد بن سلمة الشامي عن عبد الله بن عصمة النصيبي عن ميمون بن الأصبغ عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9442","9434  -  حَدَّثَنَا  هَيْثَمٌ ،  نَا  مُحَمَّدُ بْنُ عُبَيْدٍ الْمُحَارِبِيُّ ،  ثَنَا  الْوَلِيدُ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ الْحَارِثِيِّ ،  عَنْ  مُسْلِمٍ الْمُلَائِيِّ ،  عَنْ  إِبْرَاهِيمَ ،  عَنْ  عَلْقَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مَسْعُودٍ ، قَالَ :  أُمِرَ  عَلِيٌّ  بِقِتَالِ  النَّاكِثِينَ  ،  وَالْقَاسِطِينَ  ،  وَالْمَارِقِينَ  ""  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُسْلِمٍ  إِلَّا  أَبُو عَبْدِ الرَّحْمَنِ  ، وَلَا عَنْ  أَبِي عَبْدِ الرَّحْمَنِ  إِلَّا  الْوَلِيدُ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ عُبَيْدٍ  .","","Al-Mu'jam al-Awsat 9434","","عبد الله بن مسعود عن علقمة بن قيس النخعي عن إبراهيم النخعي عن مسلم بن كيسان البراد عن أبو عبد الرحمن الحارثي عن الوليد بن حماد اللؤلؤي عن محمد بن عبيد بن محمد بن واقد النحاس عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9443","9435  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ النَّطَّاحِ ،  ثَنَا  أَرْطَاةُ أَبُو حَاتِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَوْلَا أَنْ يَكُونَ سُنَّةً لَأَمَرْتُ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ  .         [9/166]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  أَرْطَاةُ أَبُو حَاتِمٍ  ،  تَفَرَّدَ بِهِ  مُحَمَّدُ بْنُ صَالِحٍ  .","","Al-Mu'jam al-Awsat 9435","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن ابن جريج عن أرطاة بن المنذر البصري عن ابن النطاح محمد بن صالح بن مهران عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9444","9436  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  ثَنَا  أَحْمَدُ بْنُ إِبْرَاهِيمَ الْمَوْصِلِيُّ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  هَارُونَ أَبِي إِسْحَاقَ الْكُوفِيِّ ،  أَنَّهُ سَمِعَ  أَبَا بُرْدَةَ ،  يُحَدِّثُ عَنْ  أَبِيهِ أَبِي مُوسَى  -  يَرْفَعُهُ  - قَالَ :  مَنْ صَلَّى ثِنْتَيْ عَشْرَةَ رَكْعَةً بَنَى اللهُ لَهُ بَيْتًا فِي الْجَنَّةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي بُرْدَةَ  إِلَّا  هَارُونُ أَبُو إِسْحَاقَ  ،  تَفَرَّدَ بِهِ  حَمَّادُ بْنُ زَيْدٍ  ، وَلَا يُرْوَى عَنْ  أَبِي مُوسَى  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9436","","أبو موسى الأشعري عن أبو بردة بن أبي موسى الأشعري عن أبو إسحاق عن حماد بن زيد عن أحمد بن إبراهيم بن خالد عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9445","9437  -  حَدَّثَنَا  هَيْثَمٌ ،  ثَنَا  حُمَيْدُ بْنُ زَنْجُوَيْهِ النَّسَائِيُّ ،  نَا  الْخَضِرُ بْنُ مُحَمَّدِ بْنِ شُجَاعٍ الْحَرَّانِيُّ ،  نَا  هُشَيْمٌ ،  عَنْ  عُبَيْدَةَ ،  عَنْ  رِبْعِيِّ بْنِ حِرَاشٍ ،  عَنْ  حُذَيْفَةَ ، قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَقَالَ : يَا رَسُولَ اللهِ أَكَلَتْنَا  الضَّبُعُ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الدُّنْيَا تُفْتَحُ عَلَيْكُمْ  ، فَيَا لَيْتَ أُمَّتِي لَا يَلْبَسُوا  الدِّيبَاجَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُبَيْدَةَ  إِلَّا  هُشَيْمٌ  ،  تَفَرَّدَ بِهِ  الْخَضِرُ بْنُ مُحَمَّدٍ  ، وَلَا يُرْوَى عَنْ  حُذَيْفَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Al-Mu'jam al-Awsat 9437","","حذيفة بن اليمان عن ربعي بن حراش العبسي عن عبيدة بن معتب الضبي عن هشيم بن بشير عن الخضر بن محمد الجزري عن حميد بن زنجويه عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9446","9438  -  حَدَّثَنَا  هَيْثَمُ بْنُ خَلَفٍ ،  نَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  مُحَمَّدُ بْنُ الصَّلْتِ أَبُو يَعْلَى التَّوَّزِيُّ ،  نَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  مَالِكِ بْنِ مِغْوَلٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ -  رَفَعَهُ  - قَالَ :  يُؤْتَى الرَّجُلُ فِي قَبْرِهِ ، فَإِذَا أُتِيَ مِنْ قِبَلِ رَأْسِهِ دَفَعَتْهُ تِلَاوَةُ الْقُرْآنِ  ، وَإِذَا أُتِيَ مِنْ قِبَلِ يَدَيْهِ دَفَعَتْهُ الصَّدَقَةُ ، وَإِذَا أُتِيَ مِنْ قِبَلِ رِجْلَيْهِ         [9/167]      دَفَعَهُ مَشْيُهُ إِلَى الْمَسَاجِدِ ، وَالصَّبْرُ حَجَزَهُ "" ، فَقَالَ : أَمَا إِنِّي لَوْ رَأَيْتُ  خَلِيلًا  كُنْتُ صَاحِبَهُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ  إِلَّا  مَالِكُ بْنُ مِغْوَلٍ  ، وَلَا عَنْ  مَالِكٍ  إِلَّا  سُفْيَانُ  ، وَلَا عَنْ  سُفْيَانَ  إِلَّا  مُحَمَّدُ بْنُ الصَّلْتِ  ،  تَفَرَّدَ بِهِ  أَبُو حَفْصٍ  .","","Al-Mu'jam al-Awsat 9438","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن طلحة بن مصرف الهمداني عن مالك بن مغول الصهيبي عن سفيان بن عيينة عن محمد بن الصلت التوزي عن الفلاس عن الهيثم بن خلف الدوري عن الطبراني","هيثم بن خلف الدروي"
"9447","[9/168]      بَابُ الْيَاءِ  مَنِ اسْمُهُ : يَعْقُوبُ  9439  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ الزُّبَيْرِ الْحَلَبِيُّ ،  حَدَّثَنِي  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  حَدَّثَنِي  عَاصِمُ بْنُ سَعِيدٍ ،  عَنْ  مَعْبَدِ بْنِ خَالِدٍ         [9/169]      عَنْ  أَنَسِ بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَحْيَا سُنَّتِي فَقَدْ أَحَبَّنِي  ، وَمَنْ أَحَبَّنِي كَانَ مَعِي فِي الْجَنَّةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَعْبَدِ بْنِ خَالِدٍ  إِلَّا  عَاصِمُ بْنُ سَعِيدٍ  ،  تَفَرَّدَ بِهِ  النُّفَيْلِيُّ  .","","Al-Mu'jam al-Awsat 9439","","أنس بن مالك عن معبد بن خالد بن أنس بن مالك الأنصاري عن عاصم بن سعيد المازني عن عبد الله بن محمد النفيلي عن يعقوب بن إسحاق بن الزبير الحلبي عن الطبراني","يعقوب بن إسحاق بن الزبير الحلبي"
"9448","9440  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ الزُّبَيْرِ الْحَلَبِيُّ ،  نَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  نَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  ثَنَا  أَبُو الْعَلَاءِ الْخَفَّافُ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا يَمْسَحُ وَجْهَهُ فِي الصَّلَاةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  خَالِدِ بْنِ طَهْمَانَ أَبِي الْعَلَاءِ  إِلَّا  مَرْوَانُ بْنُ مُعَاوِيَةَ  ،  تَفَرَّدَ بِهِ  النُّفَيْلِيُّ  .","","Al-Mu'jam al-Awsat 9440","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن خالد بن طهمان السلولي عن مروان بن معاوية الفزاري عن عبد الله بن محمد النفيلي عن يعقوب بن إسحاق بن الزبير الحلبي عن الطبراني","يعقوب بن إسحاق بن الزبير الحلبي"
"9449","9441  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  أَبُو سُفْيَانَ الْمَعْمَرِيُّ ،  عَنْ  مَعْمَرٍ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ تَوَضَّأَ فَأَحْسَنَ الْوُضُوءَ وَعَادَ أَخَاهُ الْمُسْلِمَ مُحْتَسِبًا بُوعِدَ مِنْ  جَهَنَّمَ  مَسِيرَةَ  سِتِّينَ  خَرِيفًا         [9/170]      قُلْتُ :  يَا  أَبَا حَمْزَةَ  ، وَمَا  الْخَرِيفُ  ؟ قَالَ : الْعَامُ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مَعْمَرٍ  إِلَّا  أَبُو سُفْيَانَ الْمَعْمَرِيُّ  ،  تَفَرَّدَ بِهِ  أَبُو جَعْفَرٍ النُّفَيْلِيُّ  .","","Al-Mu'jam al-Awsat 9441","","أنس بن مالك عن ثابت البناني عن معمر بن راشد عن محمد بن حميد اليشكري عن عبد الله بن محمد النفيلي عن يعقوب بن إسحاق عن الطبراني","يعقوب بن إسحاق بن الزبير الحلبي"
"9450","9442  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  أَبُو مُعَاوِيَةَ الضَّرِيرُ ،  عَنْ  خَالِدِ بْنِ إِلْيَاسَ ،  عَنْ  يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَا مِنِ امْرِئٍ مُسْلِمٍ يَرَى مِنْ أَخِيهِ  عَوْرَةً  فَيَسْتُرُهَا إِلَّا أَدْخَلَهُ اللهُ بِهَا الْجَنَّةَ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَبِي سَعِيدٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  خَالِدُ بْنُ إِلْيَاسَ  .","","Al-Mu'jam al-Awsat 9442","","أبو سعيد الخدري عن يحيى بن عبد الرحمن بن حاطب اللخمي عن خالد بن الياس العدوي عن أبو معاوية الضرير عن عبد الله بن محمد النفيلي عن يعقوب بن إسحاق عن الطبراني","يعقوب بن إسحاق بن الزبير الحلبي"
"9451","9443  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  ثَنَا  عَبْدُ الْمَجِيدِ بْنُ كَثِيرٍ الْحَرَّانِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ، قَالَ :  حَدَّثَنِي  أَبُو بَكْرٍ الْعَنْسِيُّ ،  ثَنَا  أَبُو قَبِيلٍ الْمِصْرِيُّ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الصَّوْمُ يُذْبِلُ اللَّحْمَ  ، وَيُبْعِدُ مِنْ حَرِّ السَّعِيرِ ، إِنَّ لِلهِ مَائِدَةً عَلَيْهَا مَا لَا عَيْنٌ رَأَتْ ، وَلَا أُذُنٌ سَمِعَتْ ، وَلَا خَطَرَ عَلَى قَلْبِ بَشَرٍ ، لَا يَقْعُدُ عَلَيْهَا إِلَّا الصَّائِمُونَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَبِي قَبِيلٍ  إِلَّا  أَبُو بَكْرٍ الْعَنْسِيُّ  ،  تَفَرَّدَ بِهِ  بَقِيَّةُ  .","","Al-Mu'jam al-Awsat 9443","","أنس بن مالك عن حيي بن هانئ السريعي عن أبو بكر العنسي عن بقية بن الوليد عن عبد المجيد بن كثير الحراني عن يعقوب بن إسحاق عن الطبراني","يعقوب بن إسحاق بن الزبير الحلبي"
"9452","9444  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  ثَنَا  مَخْلَدُ بْنُ مَالِكٍ ،  نَا  عَطَّافُ بْنُ خَالِدٍ الْمَخْزُومِيُّ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَسْجِدِ الْخَيْفِ مِنْ مِنًى  ، فَقَالَ :  نَضَّرَ  اللهُ امْرَأً سَمِعَ مَقَالَتِي فَحَفِظَهَا  ، ثُمَّ ذَهَبَ إِلَى مَنْ لَمْ يَسْمَعْهَا ، فَرُبَّ حَامِلِ فِقْهٍ لَيْسَ بِفَقِيهٍ ، وَرُبَّ حَامِلِ فِقْهٍ إِلَى مَنْ هُوَ أَفْقَهُ مِنْهُ ، ثَلَاثٌ لَا  يُغِلُّ  عَلَيْهِنَّ         [9/171]      قَلْبُ امْرِئٍ مُؤْمِنٍ : إِخْلَاصُ الْعَمَلِ لِلهِ ، وَالنُّصْحُ لِمَنْ وَلَّاهُ اللهُ عَلَيْكُمُ الْأَمْرَ ، وَلُزُومُ جَمَاعَةِ الْمُسْلِمِينَ ؛ فَإِنَّ  دَعْوَتَهُمْ  تُحِيطُ  مِنْ وَرَائِهِمْ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا ابْنُهُ ،  تَفَرَّدَ بِهِ  عَطَّافُ بْنُ خَالِدٍ  وَمُحَمَّدُ بْنُ شُعَيْبِ بْنِ شَابُورَ  .","","Al-Mu'jam al-Awsat 9444","","أنس بن مالك عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن عطاف بن خالد المخزومي عن مخلد بن مالك بن شيبان الحراني عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن الزبير الحلبي"
"9453","9445  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  ثَنَا  جَعْفَرُ بْنُ عَاصِمٍ الْحَرَّانِيُّ ،  ثَنَا  مُجَاشِعُ بْنُ عَمْرٍو ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ عَلَى أَهْلِ لَا إِلَهَ إِلَّا اللهُ وَحْشَةٌ عِنْدَ الْمَوْتِ  ، وَلَا عِنْدَ الْقَبْرِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ  إِلَّا  مُجَاشِعُ بْنُ عَمْرٍو  ،  تَفَرَّدَ بِهِ  جَعْفَرُ بْنُ عَاصِمٍ  .","","Al-Mu'jam al-Awsat 9445","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن داود بن أبي هند عن مجاشع بن عمرو عن جعفر بن عاصم الأشعري عن يعقوب بن إسحاق عن الطبراني","يعقوب بن إسحاق بن الزبير الحلبي"
"9454","9446  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ الزُّبَيْرِ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الْحَرَّانِيُّ ،  نَا  زُهَيْرٌ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ قَرَأَ :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      كُلَّ يَوْمٍ خَمْسِينَ مَرَّةً نُودِيَ يَوْمَ الْقِيَامَةِ مِنْ قَبْرِهِ : قُمْ فَادْخُلِ الْجَنَّةَ  .","","Al-Mu'jam al-Awsat 9446","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن زهير بن معاوية بن حديج عن عبد الرحمن بن عمرو الحراني عن يعقوب بن إسحاق بن الزبير عن الطبراني","يعقوب بن إسحاق بن الزبير الحلبي"
"9455","9447  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى بْنُ رَجَاءٍ الْحَرَّانِيُّ ،  نَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَهْلُ  الْمَعْرُوفِ  فِي الدُّنْيَا أَهْلُ  الْمَعْرُوفِ  فِي الْآخِرَةِ  .         [9/172]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  لَيْثٍ  إِلَّا  مُوسَى بْنُ أَعْيَنَ  .","","Al-Mu'jam al-Awsat 9447","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن موسى بن أعين الجزري عن يحيى بن رجاء الحراني عن يعقوب بن إسحاق عن الطبراني","يعقوب بن إسحاق بن الزبير الحلبي"
"9456","9448  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ الزُّبَيْرِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدٍ أَبُو عَبْدِ الرَّحْمَنِ الْأَذْرَمِيُّ ،  نَا  هُشَيْمٌ ،  عَنْ  حُمَيْدٍ ،  عَنْ  أَنَسٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ  بِأَعْرَابِيٍّ  وَهُوَ يَدْعُو فِي صَلَاتِهِ ، وَهُوَ يَقُولُ : يَا مَنْ لَا تَرَاهُ الْعُيُونُ ، وَلَا تُخَالِطُهُ الظُّنُونُ ، وَلَا يَصِفُهُ الْوَاصِفُونَ ، وَلَا تُغَيِّرُهُ الْحَوَادِثُ ، وَلَا يَخْشَى الدَّوَائِرَ ، يَعْلَمُ مَثَاقِيلَ الْجِبَالِ ، وَمَكَايِيلَ الْبِحَارِ ، وَعَدَدَ قَطْرِ الْأَمْطَارِ ، وَعَدَدَ وَرَقِ الْأَشْجَارِ ، وَعَدَدَ مَا أَظْلَمَ عَلَيْهِ اللَّيْلُ وَأَشْرَقَ عَلَيْهِ النَّهَارُ ، لَا تُوَارِي مِنْهُ سَمَاءٌ سَمَاءً ، وَلَا أَرْضٌ أَرْضًا ، وَلَا بَحْرٌ مَا فِي قَعْرِهِ ، وَلَا جَبَلٌ مَا فِي  وَعْرِهِ  ، اجْعَلْ خَيْرَ عُمُرِي آخِرَهُ ، وَخَيْرَ عَمَلِي خَوَاتِمَهُ ، وَخَيْرَ أَيَّامِي يَوْمَ أَلْقَاكَ فِيهِ ، فَوَكَّلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالْأَعْرَابِيِّ  رَجُلًا  ، فَقَالَ : "" إِذَا صَلَّى فَائْتِنِي بِهِ "" ، فَلَمَّا صَلَّى أَتَاهُ ، وَقَدْ كَانَ أُهْدِيَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - [ ... ] ذَهَبٌ مِنْ بَعْضِ الْمَعَادِنِ ، فَلَمَّا أَتَاهُ الْأَعْرَابِيُّ وَهَبَ لَهُ الذَّهَبَ ، وَقَالَ : "" مِمَّنْ أَنْتَ يَا أَعْرَابِيُّ ؟ "" قَالَ : مِنْ  بَنِي عَامِرِ بْنِ صَعْصَعَةَ  يَا رَسُولَ اللهِ ، قَالَ : "" هَلْ تَدْرِي لِمَ وَهَبْتُ لَكَ الذَّهَبَ ؟ "" قَالَ : لِلرَّحِمِ بَيْنَنَا وَبَيْنَكَ يَا رَسُولَ اللهِ ، فَقَالَ :  إِنَّ لِلرَّحِمِ حَقًّا ، وَلَكِنْ وَهَبْتُ لَكَ الذَّهَبَ لِحُسْنِ ثَنَائِكَ عَلَى اللهِ عَزَّ وَجَلَّ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حُمَيْدٍ  إِلَّا  هُشَيْمٌ  ،  تَفَرَّدَ بِهِ  الْأَذْرَمِيُّ  .","","Al-Mu'jam al-Awsat 9448","","أنس بن مالك عن حميد الطويل عن هشيم بن بشير عن عبد الله بن محمد الأذرمي عن يعقوب بن إسحاق بن الزبير عن الطبراني","يعقوب بن إسحاق بن الزبير الحلبي"
"9457","9449  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ ،  نَا  سَعِيدُ بْنُ سُلَيْمَانَ النَّشِيطِيُّ ،  نَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  حَرْمَلَةَ بْنِ عِمْرَانَ الْمِصْرِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ شِمَاسَةَ الْمَهْرِيِّ ،  قَالَ  :  دَخَلْتُ عَلَى عَائِشَةَ ، فَقَالَتْ : مِمَّنْ أَنْتَ ؟ قُلْتُ : مِنْ  أَهْلِ مِصْرَ  ، فَقَالَتْ :         [9/173]      كَيْفَ وَجَدْتُمُ  ابْنَ خَدِيجٍ  فِي غَزَاتِكُمْ هَذِهِ ؟ قُلْتُ : وَجَدْنَاهُ خَيْرَ أَمِيرٍ ، كُلَّمَا مَاتَ لِرَجُلٍ مِنَّا فَرَسٌ أَعْطَاهُ فَرَسًا ، فَقَالَتْ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  اللَّهُمَّ مَنْ وَلِيَ مِنْ أَمْرِ أُمَّتِي شَيْئًا فَرَفَقَ بِهِمْ فَارْفُقْ بِهِ  ، وَمَنْ شَقَّ عَلَيْهِمْ فَاشْقُقْ عَلَيْهِ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  عَبْدِ الرَّحْمَنِ بْنِ شِمَاسَةَ  ، عَنْ  عَائِشَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  حَرْمَلَةُ بْنُ عِمْرَانَ  .","","Al-Mu'jam al-Awsat 9449","","عائشة بنت أبي بكر الصديق عن عبد الرحمن بن شماسة المهري عن حرملة بن عمران التجيبي عن جرير بن حازم عن سعيد بن سليمان النشيطي عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9458","9450  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ ،  ثَنَا  عَلِيُّ بْنُ بَحْرِ بْنِ بَرِّيٍّ ،  ثَنَا  مُحَمَّدُ بْنُ أَنَسٍ ،  ثَنَا  مُطَرِّفُ بْنُ طَرِيفٍ ،  عَنْ  أَبِي الْجَهْمِ ،  عَنِ  الْبَرَاءِ بْنِ عَازِبٍ ، "" أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ لَا يُصَلِّي صَلَاةً مَكْتُوبَةً إِلَّا قَنَتَ فِيهَا  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُطَرِّفٍ  إِلَّا  مُحَمَّدُ بْنُ أَنَسٍ  .","","Al-Mu'jam al-Awsat 9450","","البراء بن عازب الأوسي عن سليمان بن الجهم الجوزجانى عن مطرف بن طريف عن محمد بن أنس القرشي عن علي بن بحر بن بري القطان عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9459","9451  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ ،  نَا  شَاذُّ بْنُ الْفَيَّاضِ ،  ثَنَا  الْحَارِثُ بْنُ شِبْلٍ ،  عَنْ  أُمِّ النُّعْمَانِ ،  عَنْ  عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَخَفُّ النِّسَاءِ صَدَاقًا أَعْظَمُهُنَّ بَرَكَةً  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أُمِّ النُّعْمَانِ  ، عَنْ  عَائِشَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  الْحَارِثُ بْنُ شِبْلٍ  .","","Al-Mu'jam al-Awsat 9451","","عائشة بنت أبي بكر الصديق عن أم النعمان عن الحارث بن شبل البصري عن شاذ بن فياض اليشكري عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9460","9452  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى بْنُ زُهَيْرٍ الْقُرَشِيُّ ،  ثَنَا  أَزْهَرُ بْنُ سَعْدٍ ،  عَنِ  ابْنِ عَوْنٍ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ لِلهِ مَلَكًا يُنَادِي عِنْدَ كُلِّ صَلَاةٍ  : يَا بَنِي آدَمَ قُومُوا إِلَى نِيرَانِكُمُ الَّتِي أَوْقَدْتُمُوهَا عَلَى أَنْفُسِكُمْ ، فَأَطْفِئُوهَا بِالصَّلَاةِ  .         [9/174]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ عَوْنٍ  إِلَّا  أَزْهَرُ  ،  تَفَرَّدَ بِهِ  يَحْيَى بْنُ زُهَيْرٍ الْقُرَشِيُّ  .","","Al-Mu'jam al-Awsat 9452","","أنس بن مالك عن محمد بن سيرين عن عبد الله بن عون بن أرطبان عن أزهر بن سعد السمان عن يحيى بن زهير الفهري عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9461","9453  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الْوَهَّابِ الثَّقَفِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمٍ الطَّائِفِيُّ ،  عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  ذَكَاةُ  الْجَنِينِ  ذَكَاةُ  أُمِّهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  أَيُّوبَ بْنِ مُوسَى  إِلَّا  مُحَمَّدُ بْنُ مُسْلِمٍ الطَّائِفِيُّ  .","","Al-Mu'jam al-Awsat 9453","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن أيوب بن موسى الأموي عن محمد بن مسلم بن سوسن الطائفي عن عبد الوهاب بن عبد المجيد الثقفي عن عثمان بن عبد الوهاب بن عبد المجيد الثقفى عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9462","9454  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ ،  ثَنَا  الْعَبَّاسُ بْنُ بَكَّارٍ الضَّبِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْجَعْدِ الْقُرَشِيُّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ جَاءَ أَجَلُهُ وَهُوَ يَطْلُبُ الْعِلْمَ  لَقِيَ اللهَ وَلَمْ يَكُنْ بَيْنَهُ وَبَيْنَ النَّبِيِّينَ إِلَّا دَرَجَةُ النُّبُوَّةِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الزُّهْرِيِّ  إِلَّا  مُحَمَّدُ بْنُ الْجَعْدِ  ،  تَفَرَّدَ بِهِ  الْعَبَّاسُ بْنُ بَكَّارٍ  .","","Al-Mu'jam al-Awsat 9454","","عبد الله بن عباس عن سعيد بن المسيب عن علي بن زيد بن جدعان عن الزهري عن محمد بن الجعد القرشي عن العباس بن الوليد الضبي عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9463","9455  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  طَالُوتُ بْنُ عَبَّادٍ ،  ثَنَا  عَاصِمُ بْنُ عَبْدِ الْوَاحِدِ الْوَزَّانُ ،  أَنَّهُ سَمِعَ  أَنَسَ بْنَ مَالِكٍ ، يَقُولُ :  احْتَجَمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَأَعْطَاهُ كِرَاءَهُ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَاصِمِ بْنِ عَبْدِ الْوَاحِدِ  إِلَّا  طَالُوتُ  .","","Al-Mu'jam al-Awsat 9455","","أنس بن مالك عن عاصم بن عبد الواحد الوزان عن طالوت بن عباد الجحدري عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9464","9456  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ ،  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  عَاصِمُ بْنُ عَبْدِ الْوَاحِدِ بْنِ زِيَادٍ ،  ثَنَا  عُثْمَانُ بْنُ حَكِيمٍ ،  عَنْ  عَامِرِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا قَعَدَ فِي الصَّلَاةِ جَعَلَ قَدَمَهُ الْيُسْرَى         [9/175]      تَحْتَ فَخِذِهِ الْيُسْرَى ، وَفَرَشَ قَدَمَهُ الْيُمْنَى ، وَوَضَعَ يَدَهُ الْيُسْرَى عَلَى رُكْبَتِهِ ، وَوَضَعَ يَدَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى ، وَأَشَارَ بِأُصْبُعِهِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عُثْمَانَ بْنِ حَكِيمٍ  إِلَّا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ  .","","Al-Mu'jam al-Awsat 9456","","عبد الله بن الزبير عن عامر بن عبد الله بن الزبير بن العوام عن عثمان بن حكيم الأحلافي عن عاصم بن عبد الواحد بن زياد عن عفان بن مسلم الصفار عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9465","9457  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  عَفَّانُ ،  نَا  وُهَيْبُ بْنُ خَالِدٍ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  حَدَّثَنِي  جَدِّي  ،  أَنَّهُ دَخَلَ الدَّارَ عَلَى  عُثْمَانَ  وَهُوَ مَحْصُورٌ فِيهَا ،  وَأَنَّهُ سَمِعَ  أَبَا هُرَيْرَةَ يَسْتَأْذِنُ  عُثْمَانَ  فِي الْكَلَامِ ، فَأَذِنَ لَهُ ، فَقَامَ ، فَحَمِدَ اللهَ ، وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  سَيَكُونُ بَعْدِي فِتَنًا وَاخْتِلَافًا  ، فَقَالَ قَائِلٌ مِنَ النَّاسِ : مَنْ لَنَا يَا رَسُولَ اللهِ ؟ فَقَالَ : "" عَلَيْكُمْ بِالْأَمِيرِ وَأَصْحَابِهِ "" وَهُوَ يُشِيرُ إِلَى  عُثْمَانَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُوسَى بْنِ عُقْبَةَ  إِلَّا  وُهَيْبٌ  ، وَجَدُّ  مُوسَى بْنِ عُقْبَةَ  إِلَى أُمِّهِ يُكَنَّى  أَبَا حَبِيبَةَ  .","","Al-Mu'jam al-Awsat 9457","","أبو هريرة الدوسي عن أبو حبيبة المدني مولى الزبير بن العوام عن موسى بن عقبة عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9466","9458  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  ثَنَا  سَلْمُ بْنُ قَادِمٍ ،  نَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  مُعَاوِيَةَ بْنِ يَحْيَى ،  عَنْ  سُلَيْمَانَ بْنِ مُسْلِمٍ  ،  عَنْ  أَنَسٍ ، قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  احْتَرِسُوا مِنَ النَّاسِ بِسُوءِ  الظَّنِّ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنْ  أَنَسٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  بَقِيَّةُ  .  كذا في طبعة دار الحرمين ، ولعل الصواب :(سليمان بن سليم).","","Al-Mu'jam al-Awsat 9458","","أنس بن مالك عن سليمان بن سليم الكناني عن معاوية بن يحيى الطرابلسي عن بقية بن الوليد عن سلم بن قادم البغدادي عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9467","9459  -  حَدَّثَنَا  يَعْقُوبُ ،  نَا  عَفَّانُ ،  نَا  عِمْرَانُ الْقَطَّانُ أَبُو الْعَوَّامِ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي الْخَلِيلِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ         [9/176]      عَنْ  أُمِّ سَلَمَةَ ، قَالَتْ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  يُبَايَعُ لِرَجُلٍ بَيْنَ  الرُّكْنِ  وَالْمَقَامِ  عِدَّةُ  أَهْلِ بَدْرٍ  ، فَيَأْتِيهِ  عَصَائِبُ  أَهْلِ الْعِرَاقِ  ،  وَأَبْدَالُ  أَهْلِ الشَّامِ  ، فَيَغْزُوهُ جَيْشٌ مِنْ  أَهْلِ الشَّامِ  ، حَتَّى إِذَا كَانُوا  بِالْبَيْدَاءِ  خُسِفَ بِهِمْ ، فَيَغْزُوهُمْ  رَجُلٌ مِنْ قُرَيْشٍ  أَخْوَالُهُ مِنْ  كَلْبٍ  ، فَيَلْتَقُونَ ، فَيَهْزِمُهُمُ اللهُ ، فَالْخَائِبُ مَنْ خَابَ مِنْ غَنِيمَةِ  كَلْبٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  عِمْرَانُ الْقَطَّانُ  .","","Al-Mu'jam al-Awsat 9459","","هند بنت أبي أمية زوج رسول الله عن عبد الله بن الحارث بن نوفل عن صالح بن أبي مريم الضبعي عن قتادة بن دعامة عن عمران بن داور القطان عن عفان بن مسلم الصفار عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9468","9460  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  عَفَّانُ ،  نَا  عِمْرَانُ ،  حَدَّثَنِي  قَتَادَةُ ،  حَدَّثَنِي  أَبُو نَضْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَمْلِكُ رَجُلٌ مِنْ أَهْلِ بَيْتِي  أَجْلَى  الْجَبْهَةِ ،  أَقْنَى  الْأَنْفِ  ، يَمْلَأُ الْأَرْضَ قِسْطًا وَعَدْلًا كَمَا مُلِئَتْ ظُلْمًا وَجَوْرًا ، يَعِيشُ هَذَا "" وَبَسَطَ كَفَّهُ الْيُمْنَى ، وَبَسَطَ إِلَى جَنْبِهَا  أُصْبُعَيْنِ  ، وَبَسَطَ كَفَّهُ الْيُسْرَى  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  قَتَادَةَ  إِلَّا  عِمْرَانُ الْقَطَّانُ  .","","Al-Mu'jam al-Awsat 9460","","أبو سعيد الخدري عن المنذر بن مالك العوقي عن قتادة بن دعامة عن عمران بن داور القطان عن عفان بن مسلم الصفار عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9469","9461  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ الْمُخَرِّمِيُّ ،  نَا  عَفَّانُ ،  نَا  يَزِيدُ بْنُ إِبْرَاهِيمَ ،  نَا  لَيْثُ بْنُ أَبِي سُلَيْمٍ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ :  نُهِينَا أَنْ نَتْبَعَ جِنَازَةً مَعَهَا رَانَّةٌ  ""  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَزِيدَ بْنِ إِبْرَاهِيمَ  إِلَّا  عَفَّانُ  .","","Al-Mu'jam al-Awsat 9461","","عبد الله بن عمر بن الخطاب عن مجاهد بن جبر المخزومي عن ليث بن أبي سليم عن يزيد بن إبراهيم التستري عن عفان بن مسلم الصفار عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9470","9462  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  سَعِيدُ بْنُ سُلَيْمَانَ النَّشِيطِيُّ ،  نَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ عَلَى بَابِي  دُرْنُوكٌ  فِيهِ خَيْلٌ ذَوَاتُ أَجْنِحَةٍ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَلْقُوا هَذَا  .","","Al-Mu'jam al-Awsat 9462","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن جرير بن حازم عن سعيد بن سليمان النشيطي عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9471","9463  -  وَبِهِ  ،         [9/177]      قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي بِاللَّيْلِ وَأَنَا مُعْتَرِضَةٌ بَيْنَهُ وَبَيْنَ الْقِبْلَةِ  ، فَإِذَا أَرَادَ أَنْ يُوتِرَ أَيْقَظَنِي ،  فَانْسَلَلْتُ  مِنْ بَيْنِ يَدَيْهِ انْسِلَالًا  ""  .  لَمْ يَرْوِ  جَرِيرُ بْنُ حَازِمٍ  عَنْ  هِشَامِ بْنِ عُرْوَةَ  إِلَّا هَذَيْنِ الْحَدِيثَيْنِ .","","Al-Mu'jam al-Awsat 9463","","عائشة بنت أبي بكر الصديق عن عروة بن الزبير عن هشام بن عروة بن الزبير عن جرير بن حازم عن سعيد بن سليمان النشيطي عن يعقوب بن إسحاق البيهسي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9472","9464  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  نَا  أَحْمَدُ بْنُ عَبْدِ الصَّمَدِ الْأَنْصَارِيُّ ،  نَا  مَعْنُ بْنُ عِيسَى الْقَزَّازُ ،  نَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  دَاوُدَ بْنِ عَلِيٍّ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، قَالَ :  عَفَوْتُ  لَكُمْ عَنِ الْخَيْلِ وَالرَّقِيقِ ،  وَلَيْسَ فِيمَا دُونَ الْمِئَتَيْنِ زَكَاةٌ  .  لَا يُرْوَى هَذَا الْحَدِيثُ عَنِ  ابْنِ عَبَّاسٍ  إِلَّا بِهَذَا  الْإِسْنَادِ  ،  تَفَرَّدَ بِهِ  مَعْنُ بْنُ عِيسَى  .","","Al-Mu'jam al-Awsat 9464","","عبد الله بن عباس عن علي بن عبد الله بن عباس بن عبد المطلب عن داود بن علي الهاشمي عن محمد بن عبد الرحمن بن أبي ليلى عن قيس بن الربيع الأسدي عن معن بن عيسى عن أحمد بن عبد الصمد النهرواني عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق المخرمي"
"9473","9465  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ أَبِي إِسْرَائِيلَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  نَا  ضَمْضَمُ بْنُ جَوْسِ بْنِ ضَمْضَمٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَوَضَّأَ وَمَسَحَ رَأْسَهُ مَرَّةً وَاحِدَةً  ""  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  ضَمْضَمِ بْنِ جَوْسٍ  إِلَّا  مُحَمَّدُ بْنُ جَابِرٍ  .","","Al-Mu'jam al-Awsat 9465","","أبو هريرة الدوسي عن أبو ضمضم بن جوس الهفاني عن ضمضم بن جوس الهفاني عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9474","9466  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  أَبِي  ،  نَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَكَّةُ  حَرَمٌ ، لَا يُجْلَى جَلَاؤُهَا ، وَلَا  يُعْضَدُ  شَجَرُهَا  ، وَلَا يُخَافُ وَحْشُهَا  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ  ، عَنِ  ابْنِ عَبَّاسٍ  إِلَّا  مُحَمَّدُ بْنُ جَابِرٍ  .","","Al-Mu'jam al-Awsat 9466","","عبد الله بن عباس عن حبيب بن أبي ثابت الكاهلي عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9475","9467  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  أَبِي  ،  نَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شَقِيقِ بْنِ سَلَمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  نَهَانَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ لُحُومِ الْحُمُرِ  الْأَهْلِيَّةِ  ؛ إِبْقَاءً         [9/178]      عَلَى الظَّهْرِ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْأَعْمَشِ  إِلَّا  حِبَّانُ  وَمُحَمَّدُ بْنُ جَابِرٍ  ،  تَفَرَّدَ بِهِ  عَنْ  مُحَمَّدِ بْنِ جَابِرٍ  :  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ  ،  وَتَفَرَّدَ بِهِ  عَنْ  حِبَّانَ  :  بَكْرُ بْنُ يَحْيَى بْنِ زَبَّانَ  .","","Al-Mu'jam al-Awsat 9467","","عبد الله بن عباس عن شقيق بن سلمة عن الأعمش عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9476","9468  -  حَدَّثَنَا  يَعْقُوبُ ،  حَدَّثَنِي  أَبِي  ،  نَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  حَمَّادٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  لَمَّا أَتَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَمْعًا أَمَرَ ضَعَفَةَ أَهْلِهِ أَنْ يَتَقَدَّمُوا بِلَيْلٍ ، وَقَالَ :  لَا تَرْمُوا الْجَمْرَةَ حَتَّى تَطْلُعَ الشَّمْسُ  "" .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  حَمَّادٍ  إِلَّا  مُحَمَّدُ بْنُ جَابِرٍ  وَأَبُو حَنِيفَةَ  ،  تَفَرَّدَ بِهِ  عَنْ  مُحَمَّدِ بْنِ جَابِرٍ  :  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ  ، وَعَنْ  أَبِي حَنِيفَةَ  :  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ  .","","Al-Mu'jam al-Awsat 9468","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن حماد بن أبي سليمان عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9477","9469  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  أَبِي  ،  نَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  يَعْقُوبَ بْنِ عَطَاءِ بْنِ أَبِي رَبَاحٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلُّ  مُزْدَلِفَةَ  مَشْعَرٌ  ، وَارْتَفِعُوا عَنْ  بَطْنِ عُرَنَةَ  ، وَكُلُّ  عَرَفَاتٍ  مَوْقِفٌ ، وَارْتَفِعُوا عَنْ  وَادِي مُحَسِّرٍ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  يَعْقُوبَ بْنِ عَطَاءٍ  إِلَّا  مُحَمَّدُ بْنُ جَابِرٍ  وَسُفْيَانُ بْنُ عُيَيْنَةَ  .","","Al-Mu'jam al-Awsat 9469","","عبد الله بن عباس عن عطاء بن أبي رباح عن يعقوب بن عطاء بن أبي رباح المكي عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9478","9470  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ أَبِي إِسْرَائِيلَ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  أَبِي مَعْمَرٍ ،  عَنْ  عُقْبَةَ بْنِ عَمْرٍو ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَمْسَحُ  مَنَاكِبَنَا  فِي الصَّلَاةِ ، وَيَقُولُ :  سَوُّوا  الْمَنَاكِبَ  ، وَأَقِيمُوا الصُّفُوفَ ، وَلَا  تَخْتَلِفُوا  فَتَخْتَلِفَ  قُلُوبُكُمْ  .         [9/179]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَمْرِو بْنِ مُرَّةَ  إِلَّا  مُحَمَّدُ بْنُ جَابِرٍ  ،  تَفَرَّدَ بِهِ  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ  .","","Al-Mu'jam al-Awsat 9470","","أبو مسعود البدري عن عبد الله بن سخبرة عن عمرو بن مرة المرادي عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9479","9471  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ أَبِي إِسْرَائِيلَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ،  عَنْ  عِكْرِمَةَ ،  عَنْ  عَائِشَةَ ، قَالَتْ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُقَبِّلُ وَهُوَ صَائِمٌ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ  إِلَّا  مُحَمَّدُ بْنُ جَابِرٍ  وَعَبِيدَةُ بْنُ حُمَيْدٍ  .","","Al-Mu'jam al-Awsat 9471","","عائشة بنت أبي بكر الصديق عن عكرمة مولى ابن عباس عن عبد العزيز بن رفيع الطائفي عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9480","9472  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَمْحُو اللهُ مَا يَشَاءُ إِلَّا الشِّقْوَةَ وَالسَّعَادَةَ ، وَالْحَيَاةَ وَالْمَوْتَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  ابْنِ أَبِي لَيْلَى  إِلَّا  مُحَمَّدُ بْنُ جَابِرٍ  ، وَلَا رَوَاهُ عَنْ  نَافِعٍ  إِلَّا  ابْنُ أَبِي لَيْلَى  .","","Al-Mu'jam al-Awsat 9472","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن محمد بن عبد الرحمن بن أبي ليلى عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9481","9473  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  أَبِي  ،  نَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  نَا  عَمَّارٌ الدُّهْنِيُّ ، قَالَ :  قُلْتُ  لِأَبِي إِسْحَاقَ : أَذَكَرْتَ ؟ يَعْنِي حَدِيثَ مُسْلِمِ بْنِ نُذَيْرٍ  عَنْ  حُذَيْفَةَ ،  أَخَذَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِعَضَلَةِ  سَاقِي  ؟  فَحَدَّثَنِيهِ  "" قَالَ  سُفْيَانُ  : ثُمَّ لَقِيتُهُ ، فَسَأَلْتُهُ ،  فَحَدَّثَنِي بِهِ  .","","Al-Mu'jam al-Awsat 9473","","حذيفة بن اليمان عن مسلم بن نذير الكوفي عن أبو إسحاق السبيعي عن عمار بن معاوية الدهني عن سفيان بن عيينة عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9482","9474  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  ثَنَا  أَبِي  ،  عَنْ  قَيْسِ بْنِ سَعْدٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو         [9/180]      حَدِيثَ الْقَبْرِ ، حَدِيثَ زَاذَانَ ،  عَنِ  الْبَرَاءِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، مِثْلَ حَدِيثِ  الْأَعْمَشِ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنِ  الْحَجَّاجِ  إِلَّا  قَيْسُ بْنُ سَعْدٍ  ، وَلَا عَنْ  قَيْسِ بْنِ سَعْدٍ  إِلَّا  جَرِيرُ بْنُ حَازِمٍ  ، وَلَا عَنْ  جَرِيرٍ  إِلَّا  وَهْبٌ  ،  تَفَرَّدَ بِهِ  إِسْحَاقُ بْنُ أَبِي إِسْرَائِيلَ  .","","Al-Mu'jam al-Awsat 9474","","البراء بن عازب الأوسي عن زاذان الكندي عن المنهال بن عمرو الأسدي عن حجاج بن أرطاة عن قيس بن سعد الحبشي عن جرير بن حازم عن وهب بن جرير بن حازم عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9483","9475  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ مَسْمُولٍ ،  حَدَّثَنِي  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُوضَعُ النَّوَاصِي إِلَّا فِي حَجٍّ أَوْ عُمْرَةٍ  .","","Al-Mu'jam al-Awsat 9475","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عمر بن محمد بن المنكدر التيمي عن محمد بن سليمان المسمولي عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9484","9476  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ، قَالَ :  حَدَّثَنِي  أَبِي  قَالَ :  نَا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ مَسْمُولٍ ،  عَنْ  عُمَرَ بْنِ مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ ،  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ضَمَّرَ الْخَيْلَ وَسَابَقَ بَيْنَهَا ، فَرَآنِي رَاكِبًا عَلَى بَعِيرٍ ، فَقَالَ :  يَا  جَابِرُ  ، لَا تَزَالُ تَتَضَعُهُ  أَيْ لَا تَزَالُ تَضْرِبُهُ  .  لَمْ يَرْوِ هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عُمَرَ بْنِ مُحَمَّدِ بْنِ الْمُنْكَدِرِ  إِلَّا  مُحَمَّدُ بْنُ سُلَيْمَانَ بْنِ مَسْمُولٍ  .","","Al-Mu'jam al-Awsat 9476","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن محمد بن المنكدر عن عمر بن محمد بن المنكدر التيمي عن محمد بن سليمان المسمولي عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9485","9477  -  حَدَّثَنَا  يَعْقُوبُ ،  ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  بَكْرُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عِمْرَانَ بْنِ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - طَافَ عَلَى رَاحِلَتِهِ  ، وَفِي يَدِهِ  مِحْجَنٌ  يَسْتَلِمُ بِهِ  الرُّكْنَ  .         [9/181]      لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  عَبْدِ الْكَرِيمِ  إِلَّا  ابْنُ أَبِي لَيْلَى  ،  تَفَرَّدَ بِهِ  عِمْرَانُ بْنُ مُحَمَّدٍ  .","","Al-Mu'jam al-Awsat 9477","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن عبد الكريم بن أبي المخارق عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن بكر بن عبد الرحمن الأنصاري عن أبو كريب محمد بن العلاء عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن أبي إسرائيل"
"9486","9478  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ عَبَّادِ بْنِ الْعَوَّامِ الْوَاسِطِيُّ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَيْسَ عَلَى أَهْلِ لَا إِلَهَ إِلَّا اللهُ وَحْشَةٌ فِي قُبُورِهِمْ  ، وَلَا  مَنْشَرِهِمْ  ، وَكَأَنِّي أَنْظُرُ إِلَى أَهْلِ لَا إِلَهَ إِلَّا اللهُ وَهُمْ يَنْفُضُونَ التُّرَابَ عَنْ رُءُوسِهِمْ ، وَيَقُولُونَ :         {      الْحَمْدُ لِلهِ الَّذِي أَذْهَبَ عَنَّا الْحَزَنَ         }      .","","Al-Mu'jam al-Awsat 9478","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن يحيى بن عبد الحميد عن يعقوب بن إسحاق الواسطي عن الطبراني","يعقوب بن إسحاق بن إبراهيم بن عباد الواسطي"
"9487","9479  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عُمَرَ ، قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزَاةٍ ، فَقَالَ :  لَا يَصْحَبْنَا الْيَوْمَ مَنْ آذَى جَارَهُ  ، فَقَالَ  رَجُلٌ  مِنَ  الْقَوْمِ  : أَنَا بُلْتُ فِي أَصْلِ حَائِطِ جَارِي ؟ فَقَالَ : "" لَا تَصْحَبْنَا الْيَوْمَ  .","","Al-Mu'jam al-Awsat 9479","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن يحيى بن عبد الحميد عن يعقوب بن إسحاق الواسطي عن الطبراني","يعقوب بن إسحاق بن إبراهيم بن عباد الواسطي"
"9488","9480  -  وَبِهِ  :  عَنِ  ابْنِ عُمَرَ ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَكْرَهُ مِنَ الشَّاةِ سَبْعًا  : الْمَرَارَةَ ، وَالْمَثَانَةَ ، وَالْمَحْيَاةَ ، وَالذَّكَرَ ، وَالْأُنْثَيَيْنِ ، وَالْغُدَّةَ ، وَالدَّمَ ، وَكَانَ أَحَبَّ الشَّاةِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُقَدَّمُهَا  ، قَالَ :  وَأُتِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِطَعَامٍ ، فَأَقْبَلَ  الْقَوْمُ  يُلْقِمُونَهُ اللَّحْمَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ أَطْيَبَ اللَّحْمِ لَحْمُ الظَّهْرِ  .","","Al-Mu'jam al-Awsat 9480","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن يحيى بن عبد الحميد عن يعقوب بن إسحاق الواسطي عن الطبراني","يعقوب بن إسحاق بن إبراهيم بن عباد الواسطي"
"9489","9481  -  وَبِهِ         [9/182]      عَنِ  ابْنِ عُمَرَ ،  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِيدِ الْعِقَابِ ذِي الطَّوْلِ لا إِلَهَ إِلا هُوَ إِلَيْهِ الْمَصِيرُ         }      ، قَالَ :         {      غَافِرِ الذَّنْبِ         }      لِمَنْ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ  ،         {      وَقَابِلِ التَّوْبِ         }      مِمَّنْ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ "" ،         {      شَدِيدِ الْعِقَابِ         }      لِمَنْ لَا يَقُولُ : لَا إِلَهَ إِلَّا اللهُ "" ،         {      ذِي الطَّوْلِ         }      ذِي الْغِنَى لَا إِلَهَ إِلَّا هُوَ ، كَانَتْ كُفَّارُ  قُرَيْشٍ  لَا يُوَحِّدُونَهُ ، فَوَحَّدَ نَفْسَهُ "" ،         {      إِلَيْهِ الْمَصِيرُ         }      إِلَيْهِ يَصِيرُ مَنْ يَقُولُ : لَا إِلَهَ إِلَّا اللهُ ، فَيَدْخُلُ الْجَنَّةَ ، وَيَصِيرُ مَنْ لَا يَقُولُ : لَا إِلَهَ إِلَّا اللهُ ، فَيُدْخِلُهُ النَّارَ  "" .","","Al-Mu'jam al-Awsat 9481","","عبد الله بن عمر بن الخطاب عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن يحيى بن عبد الحميد عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","يعقوب بن إسحاق بن إبراهيم بن عباد الواسطي"
"9490","9482  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ عَبَّادِ بْنِ الْعَوَّامِ ،  نَا  يَحْيَى الْحِمَّانِيُّ ،  نَا  عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحُسَيْنِ بْنِ عَلِيٍّ ،  فِي قَوْلِ اللهِ عَزَّ وَجَلَّ :         {      وَشَاهِدٍ وَمَشْهُودٍ         }      ، قَالَ :  الشَّاهِدُ جَدِّي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ، وَالْمَشْهُودُ : يَوْمُ الْقِيَامَةِ ، ثُمَّ تَلَا هَذِهِ الْآيَةَ :         {      إِنَّا أَرْسَلْنَاكَ شَاهِدًا وَمُبَشِّرًا وَنَذِيرًا         }      ثُمَّ تَلَا :         {      ذَلِكَ يَوْمٌ مَجْمُوعٌ لَهُ النَّاسُ وَذَلِكَ يَوْمٌ مَشْهُودٌ         }      ""  .  لَمْ يَرْوِ هَذِهِ الْأَحَادِيثَ عَنْ  زَيْدِ بْنِ أَسْلَمَ  إِلَّا ابْنُهُ  عَبْدُ الرَّحْمَنِ بْنُ زَيْدٍ  .","","Al-Mu'jam al-Awsat 9482","","الحسين بن علي عن زيد بن أسلم عن عبد الرحمن بن زيد بن أسلم عن يحيى بن عبد الحميد عن يعقوب بن إسحاق الواسطي عن الطبراني","يعقوب بن إسحاق بن إبراهيم بن عباد الواسطي"
"9491","9483  -  حَدَّثَنَا  يَعْقُوبُ بْنُ مُجَاهِدٍ الْبَصْرِيُّ ،  نَا  الْمُنْذِرُ بْنُ الْوَلِيدِ الْجَارُودِيُّ ،  ثَنَا  أَبِي  ،  نَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنِ  الْحَسَنِ بْنِ عَلِيٍّ قَالَ : سَمِعْتُ جَدِّي رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ عَبْدٍ صَلَّى صَلَاةَ الصُّبْحِ ، ثُمَّ جَلَسَ يَذْكُرُ اللهَ حَتَّى تَطْلُعَ الشَّمْسُ  إِلَّا كَانَ لَهُ حِجَابٌ مِنْ  جَهَنَّمَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ  إِلَّا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ  ،  تَفَرَّدَ بِهِ         [9/183]      الْمُنْذِرُ  عَنْ أَبِيهِ .","","Al-Mu'jam al-Awsat 9483","","الحسن بن علي سبط رسول الله عن الحكم بن عتيبة الكندي عن محمد بن جحادة الأودي عن الحسن بن أبي جعفر الجفري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن يعقوب بن مجاهد البصري عن الطبراني","يعقوب بن إسحاق بن إبراهيم بن عباد الواسطي"
"9492","9484  -  حَدَّثَنَا  يَعْقُوبُ بْنُ مُجَاهِدٍ ،  نَا  الْمُنْذِرُ بْنُ الْوَلِيدِ ،  نَا  أَبِي  ،  نَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  مَرْزُوقٍ ، مَوْلَى أَنَسٍ ،  عَنْ  أَنَسِ بْنِ مَالِكٍ ، قَالَ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نَسْتَغْفِرَ بِالْأَسْحَارِ  سَبْعِينَ مَرَّةً  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ  إِلَّا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ  .","","Al-Mu'jam al-Awsat 9484","","أنس بن مالك عن مرزوق مولى أنس عن محمد بن جحادة الأودي عن الحسن بن أبي جعفر الجفري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن يعقوب بن مجاهد عن الطبراني","يعقوب بن مجاهد"
"9493","9485  -  حَدَّثَنَا  يَعْقُوبُ بْنُ مُجَاهِدٍ ،  ثَنَا  الْمُنْذِرُ بْنُ الْوَلِيدِ ،  نَا  أَبِي  ،  نَا  الْحَسَنُ ،  ثَنَا  مُحَمَّدُ بْنُ جُحَادَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَدِيِّ بْنِ حَاتِمٍ ، قَالَ :  جَاءَ أَعْرَابٌ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  نَحْرِ  الظَّهِيرَةِ ، مُتَقَلِّدِي السُّيُوفِ  مُجْتَابِي  النِّمَارِ  ، فَحَثَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - النَّاسَ عَلَيْهِمْ ، فَقَالَ :  لِيَتَصَدَّقْ ذُو الدِّينَارِ مِنْ دِينَارِهِ ، وَذُو الدِّرْهَمِ مِنْ دِرْهَمِهِ  ، وَذُو الْبُرِّ مِنْ بُرِّهِ ، وَذُو الشَّعِيرِ مِنْ شَعِيرِهِ ، وَذُو التَّمْرِ مِنْ تَمْرِهِ ، مِنْ قَبْلِ أَنْ يَأْتِيَ عَلَيْهِ يَوْمٌ ، فَيَنْظُرَ أَمَامَهُ فَلَا يَرَى إِلَّا النَّارَ ، وَيَنْظُرَ عَنْ يَمِينِهِ فَلَا يَرَى إِلَّا النَّارَ ، وَيَنْظُرَ عَنْ شِمَالِهِ فَلَا يَرَى إِلَّا النَّارَ ، وَيَنْظُرَ مِنْ وَرَائِهِ فَلَا يَرَى إِلَّا النَّارَ ، فَلَا يَرَى شَيْئًا يَتَّقِي بِوَجْهِهِ النَّارَ  .  لَمْ يَرْوِ هَذَا الْحَدِيثَ عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ  إِلَّا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ  ،  تَفَرَّدَ بِهِ  الْمُنْذِرُ  عَنْ أَبِيهِ .","","Al-Mu'jam al-Awsat 9485","","عدي بن حاتم بن عبد الله الطائي عن سماك بن حرب البكري عن محمد بن جحادة الأودي عن الحسن بن أبي جعفر الجفري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن يعقوب بن مجاهد عن الطبراني","يعقوب بن مجاهد"
"9494","9486  -  وَبِهِ  :  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  أَبِي صَالِحٍ         [9/184]      عَنْ  أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْإِمَامُ  ضَامِنٌ ،  وَالْمُؤَذِّنُ  مُؤْتَمَنٌ  ، اللَّهُمَّ أَرْشِدِ الْأَئِمَّةَ وَاغْفِرْ لِلْمُؤَذِّنِينَ  .","","Al-Mu'jam al-Awsat 9486","","أبو هريرة الدوسي عن ذكوان السمان عن محمد بن جحادة الأودي عن الحسن بن أبي جعفر الجفري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن يعقوب بن مجاهد عن الطبراني","يعقوب بن مجاهد"
"9495","9487  -  وَبِهِ  : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَيْرُ الصَّدَقَةِ مَا أَبْقَتْ  غِنًى  ، وَالْيَدُ  الْعُلْيَا  خَيْرٌ مِنَ  الْيَدِ  السُّفْلَى ، وَابْدَأْ بِمَنْ  تَعُولُ  .","","Al-Mu'jam al-Awsat 9487","","أبو هريرة الدوسي عن ذكوان السمان عن محمد بن جحادة الأودي عن الحسن بن أبي جعفر الجفري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن يعقوب بن مجاهد عن الطبراني","يعقوب بن مجاهد"
"9496","9488  -  حَدَّثَنَا  يَعْقُوبُ بْنُ مُجَاهِدٍ ،  نَا  الْمُنْذِرُ بْنُ الْوَلِيدِ ،  نَا  أَبِي  ،  ثَنَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  عَطِيَّةَ ،  عَنْ  أَبِي سَعِيدٍ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ أَهْلَ الْجَنَّةِ  لَيَتَرَاءَوْنَ  أَهْلَ  عِلِّيِّينَ  كَمَا  يَتَرَاءَى  أَهْلُ الدُّنْيَا الْكَوْكَبَ  الدُّرِّيَّ  فِي السَّمَاءِ  ، وَإِنَّ  أَبَا بَكْرٍ  وَعُمَرَ  مِنْهُ  وَأَنْعَمَا  .","","Al-Mu'jam al-Awsat 9488","","أبو سعيد الخدري عن عطية بن سعد العوفي عن محمد بن جحادة الأودي عن الحسن بن أبي جعفر الجفري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن يعقوب بن مجاهد عن الطبراني","يعقوب بن مجاهد"
"9497","9489  -  وَبِهِ  :  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  فُلَانِ بْنِ صَيَّاحٍ ،  عَنِ  الْمُغِيرَةِ بْنِ الْأَخْنَسِ         [9/185]      قَالَ :  دَخَلْنَا عَلَى  الْمُغِيرَةِ بْنِ شُعْبَةَ  وَهُوَ أَمِيرٌ عَلَى  الْكُوفَةِ  ، وَعِنْدَهُ  سَعِيدُ بْنُ زَيْدٍ  ، فَدَخَلَ  غُنَيْمُ بْنُ عَلْقَمَةَ  ، فَقَالَ : مَنْ  عَلِيٌّ  ؟  فَقَالَ  سَعِيدُ بْنُ زَيْدِ بْنِ عَمْرِو بْنِ نُفَيْلٍ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَبُو بَكْرٍ  فِي الْجَنَّةِ ،  وَعُمَرُ  فِي الْجَنَّةِ  ،  وَعَلِيٌّ  فِي الْجَنَّةِ ،  وَعُثْمَانُ  فِي الْجَنَّةِ  .  وَاللهُ أَعْلَمُ بِالصَّوَابِ  آخِرُ  الْمُعْجَمِ  وَالْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ  .","","Al-Mu'jam al-Awsat 9489","","سعيد بن زيد بن عمرو العدوي عن عبد الرحمن بن الأخنس الكوفي عن حر بن الصياح النخعي عن محمد بن جحادة الأودي عن الحسن بن أبي جعفر الجفري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن يعقوب بن مجاهد عن الطبراني","يعقوب بن مجاهد"
