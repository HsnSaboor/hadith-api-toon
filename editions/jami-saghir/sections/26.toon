hadiths[72]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"6983","«هذا ابن آدم وهذا أجله وثم أمله وثم أمله وثم أمله»","صحيح","Sahih al-Jami al-Saghir 6983","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6984","«هذا الأمل وهذا أجله فبينما هوكذلك إذ جاءه الخط الأقرب»","صحيح","Sahih al-Jami al-Saghir 6984","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6985","«هذا الإنسان وهذا أجله محيط به وهذا الذي هوخارج أمله وهذه الخطوط الصغار الأعراض فإن أخطأ هذا نهشه هذا وإن أخطأ هذا نهشه هذا»","صحيح","Sahih al-Jami al-Saghir 6985","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6986","«هذا القرع نكثر به طعامنا»","صحيح","Sahih al-Jami al-Saghir 6986","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6987","«هذا الذي تحرك له العرش وفتحت له أبواب السماء وشهده سبعون ألفا من الملائكة لقد ضم ضمة ثم فرج عنه»","صحيح","Sahih al-Jami al-Saghir 6987","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6988","«هذا الموقف وعرفة كلها موقف»","صحيح","Sahih al-Jami al-Saghir 6988","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6989","«هذا الوضوء فمن زاد على هذا فقد أساء أو تعدى وظلم»","حسن","Sahih al-Jami al-Saghir 6989","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6990","«هذا أوان يختلس العلم من الناس حتى لا يقدروا منه على شيء ثكلتك أمك يا زياد! إن كنت لأعدك من فقهاء أهل المدينة هذه التوراة والإنجيل عند اليهود والنصارى فماذا يغني عنهم؟!»","صحيح","Sahih al-Jami al-Saghir 6990","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6991","«هذا جبريل آخذ برأس فرسه عليه أداة الحرب»","صحيح","Sahih al-Jami al-Saghir 6991","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6992","«هذا جبل يحبنا ونحبه»","صحيح","Sahih al-Jami al-Saghir 6992","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6993","«هذا حجر رمي به في النار منذ سبعين خريفا فلهو يهوي في النار الآن حين انتهى إلى قعرها»","صحيح","Sahih al-Jami al-Saghir 6993","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6994","«هذا خالي فليرني امرؤ خاله»","صحيح","Sahih al-Jami al-Saghir 6994","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6995","«هذا شهر رمضان قد جاءكم تفتح به أبواب الجنة وتغلق فيه أبواب النار وتسلسل فيه الشياطين»","صحيح","Sahih al-Jami al-Saghir 6995","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6996","«هذا قزح وهو الموقف وجمع كلها موقف ونحرت هاهنا ومنى كلها منحر فانحروا في رحالكم»","صحيح","Sahih al-Jami al-Saghir 6996","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6997","«هذا قزح وهو الموقف جمع كلها موقف هذا المنحر ومنى كلها منحر»","صحيح","Sahih al-Jami al-Saghir 6997","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6998","«هذا ممن قضى نحبه» . - يعني طلحة -","صحيح","Sahih al-Jami al-Saghir 6998","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"6999","«هذا مني - يعني الحسن - وحسين من علي»","صحيح","Sahih al-Jami al-Saghir 6999","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7000","«هذا موضع الإزار فإن أبيت فأسفل فإن أبيت فلا حق للإزار فيما دسون الكعبين»","صحيح","Sahih al-Jami al-Saghir 7000","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7001","«هذا والذي نفسي بيده من النعيم الذي تسألون عنه: ظل بارد ورطب طيب وماء بارد»","صحيح","Sahih al-Jami al-Saghir 7001","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7002","«هذا يوم عاشوراء ولم يكتب الله عليكم صيامه وأنا صائم فمن شاء فليصم ومن شاء فليفطر»","صحيح","Sahih al-Jami al-Saghir 7002","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7003","«هذان ابناى وابنا بنتي اللهم إني أحبهما فأحبهما وأحب من يحبهما»","حسن","Sahih al-Jami al-Saghir 7003","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7004","«هذان السمع والبصر» - يعني أبا بكر وعمر -","صحيح","Sahih al-Jami al-Saghir 7004","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7005","«هذان سيدا كهول أهل الجنة من الأولين والآخرين إلا النبيين والمرسلين لا تخبرهما يا علي» - يعني أبا بكر وعمر -","صحيح","Sahih al-Jami al-Saghir 7005","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7006","«هذه النار جزء من مائة جزء من جهنم»","صحيح","Sahih al-Jami al-Saghir 7006","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7007","«هذه بتلك السبقة»","صحيح","Sahih al-Jami al-Saghir 7007","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7008","«هذه ثم ظهور الحصر» - قاله صلى الله عليه وسلم لأزواجه في حجة الوداع - ... [خ د] عن أبي واقد","صحيح","Sahih al-Jami al-Saghir 7008","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7009","«هذه رحمة يجعلها الله في قلوب من يشاء من عباده وإنما يرحم الله من عباده الرحماء»","صحيح","Sahih al-Jami al-Saghir 7009","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7010","«هذه صلاة البيوت» - يعني السبحة بعد المغرب -","صحيح","Sahih al-Jami al-Saghir 7010","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7011","«هذه طابة وهذا أحد وهو جبل يحبنا ونحبه»","صحيح","Sahih al-Jami al-Saghir 7011","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7012","«هذه عرفة وهو الموقف وعرفة كلها موقف»","صحيح","Sahih al-Jami al-Saghir 7012","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7013","«هذه عمرة استمتعنا بها فمن لم يكن عنده الهدي فليحل الحل كله فإن العمرة قد دخلت في الحج إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 7013","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7014","«هذه وهذه سواء» - يعني الخنصر والإبهام -","صحيح","Sahih al-Jami al-Saghir 7014","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7015","«هكذا الوضوء فمن زاد على هذا ... فقد أساء وظلم»","حسن","Sahih al-Jami al-Saghir 7015","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7016","«هكذا فإنما الاستئذان من النظر»","صحيح","Sahih al-Jami al-Saghir 7016","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7017","«هاهنا أحد من بني فلان؟ إن صاحبكم مأسور بدينه»","صحيح","Sahih al-Jami al-Saghir 7017","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7018","«هاهنا أرض الفتن حيث يطلع قرن الشيطان»","صحيح","Sahih al-Jami al-Saghir 7018","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7019","«هجاهم حسان فشفى واشتفى»","صحيح","Sahih al-Jami al-Saghir 7019","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7020","«هجر المسلم أخاه كسفك دمه»","صحيح","Sahih al-Jami al-Saghir 7020","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7021","«هدايا العمال غلول»","صحيح","Sahih al-Jami al-Saghir 7021","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7022","«هدم المتعة النكاح والطلاق والعدة والميراث»","حسن","Sahih al-Jami al-Saghir 7022","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7023","«هل أنت إلا إصبع دميت وفي سبيل الله ما لقيت»","صحيح","Sahih al-Jami al-Saghir 7023","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7024","«هل أنتم تاركوا لي أمرائي؟ لكم صفوة أمرهم وعليهم كدره»","صحيح","Sahih al-Jami al-Saghir 7024","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7025","«هل أنتم تاركوا لي أمرائي؟ إنما مثلكم ومثلهم كمثل رجل استرعى إبلا أو غنما فرعاها ثم تحين سقيها فأوردها حوضا فشرعت فيه فشربت صفوه وتركت كدره فصفوه لكم وكدره عليهم»","صحيح","Sahih al-Jami al-Saghir 7025","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7026","«هل تدرون أين تغرب هذه؟ تغرب في عين حامية»","صحيح","Sahih al-Jami al-Saghir 7026","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7027","«هل تدرون ما الكوثر؟ هونهر أعطانيه ربي في الجنة عليه خير كثير ترد عليه أمتي يوم القيامة آنيته عدد الكواكب يختلج العبد منهم فأقول: يا رب أنه من أمتي فيقال: إنك لا تدري ما أحدثوا بعدك»","صحيح","Sahih al-Jami al-Saghir 7027","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7028","""هل تدرون ماذا قال ربكم الليلة؟ قال الله: أصبح من عبادي مؤمن بي وكافر فأما من قال: مطرنا بفضل الله ورحمته فذلك مؤمن بي كافر بالكواكب وأما من قال: مطرنا بنوء كذا وكذا فذلك كافر بي ومؤمن بالكواكب ""","صحيح","Sahih al-Jami al-Saghir 7028","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7029","«هل ترون قبلتي هاهنا؟ فوالله ما يخفي على خشوعكم ولا ركوعكم إني لأراكم من وراء ظهري»","صحيح","Sahih al-Jami al-Saghir 7029","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7030","«هل ترون ما أرى؟ إني لأرى مواقع الفتن خلال بيوتكم كمواقع القطر»","صحيح","Sahih al-Jami al-Saghir 7030","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7031",""" هل تضارون في رؤية الشمس بالظهيرة صحوا ليس معها سحاب؟ وهل تضارون في رؤية القمر ليلة البدر صحوا ليس فيها سحاب؟ ما تضارون في رؤية الله يوم القيامة إلا كما تضارون في رؤية أحدهما إذا كان يوم القيامة أذن مؤذن: ليتبع كل أمة ما كانت تعبد فلا يبقى أحد كان يعبد غير الله من الأصنام والأنصاب إلا يتساقطون في النار حتى إذا لم يبق إلا من كان يعبد الله من بر وفاجر وغير أهل الكتاب فيدعى اليهود فيقال لهم: ما كنتم تعبدون؟ قالوا: كنا نعبد عزيرا ابن الله! فيقال: كذبتم ما اتخذ الله من صاحبة ولا ولد فماذا تبغون؟ قالوا: عطشنا يا ربنا فاسقنا فيشار إليهم: ألا تردون؟ فيحشرون إلى النار كأنها سراب يحطم بعضها بعضا فيتساقطون في النار ; ثم يدعى النصارى فيقال لهم: ما كنتم تعبدون؟ قالوا: كنا نعبد المسيح ابن الله! فيقال لهم: كذبتم ما اتخذ الله من صاحبة ولا ولد فيقال لهم: ماذا تبغون؟ فيقولون: عطشنا يا ربنا فاسقنا فيشار إليهم: ألا تردون؟ فيحشرون إلى جهنم كأنها سراب يحطم بعضها بعضا فيتساقطون في النار حتى إذا لم يبق إلا من كان يعبد الله من بر وفاجر أتاهم رب العالمين في أدنى صورة من التي رأوه فيها قال: فما تنتظرون؟ تتبع كل أمة ما كانت تعبد قالوا: يا ربنا فارقنا الناس في الدنيا أفقر ما كنا إليهم ولم نصاحبهم فيقول: أنا ربكم قيقولون: نعوذ بالله منك لا نشرك بالله شيئا مرتين أو ثلاثا حتى إن بعضهم ليكاد أن ينقلب فيقول: هل بينكم وبينه آية فتعرفونه بها؟ فيقولون: نعم الساق فيكشف عن ساق فلا يبقي من كان يسجد لله من تلقاء نفسه إلا أذن الله له بالسجود ولا يبقى من كان يسجد اتقاء ورياء إلا جعل الله ظهره طبقة واحدة كلما أراد أن يسجد خر على قفاه ثم يرفعون رءوسهم وقد تحول في الصورة التي رأوه فيها أول مرة فيقول: أنا ربكم فيقولون: أنت ربنا ; ثم يضرب الجسر على جهنم وتحل الشفاعة ويقولون: اللهم سلم سلم قيل: يا رسول الله وما الجسر؟ قال: دحض مزلة فيه خطاطيف وكلاليب وحسكة تكون بنجد فيها شويكة يقال لها: السعدان فيمر المؤمنون كطرف العين وكالبرق وكالريح وكالطير وكأجأويد الخيل والركاب فناج مسلم ومخدوش مرسل ومكدوس في نار جهنم حتى إذا خلص المؤمنون من النار فوالذي نفسي بيده ما من أحد منكم بأشد مناشدة لله في استيفاء الحق من المؤمنين لله يوم القيامة لإخوانهم الذين في النار يقولون: ربنا كانوا يصومون معنا ويصلون ويحجون فيقال لهم: أخرجوا من عرفتم فتحرم صورهم على النار فيخرجون خلقا كثيرا قد أخذت النار إلى نصف ساقه وإلى ركبتيه قيقولون: ربنا ما بقي فيها أحد ممن أمرتنا به ; فيقول الله عز وجل: ارجعوا فمن وجدتم في قلبه مثقال دينار من خير فأخرجوه فيخرجون خلقا كثيرا ثم يقولون ربنا لم نذر فيها أحدا ممن أمرتنا به ; ثم يقول: ارجعوا فمن وجدتم في قلبه مثقال نصف دينار من خير فأخرجوه فيخرجون خلقا كثيرا ثم يقولون: ربنا لم نذر فيها ممن أمرتنا أحدا ثم يقول: ارجعوا فمن وجدتم في قلبه مثقال ذرة من خير فأخرجوه فيخرجون خلقا كثير ثم يقولون: ربنا! لم نذر فيها خيرا فيقول الله: شفعت الملائكة وشفع النبيون وشفع المؤمنون ولم يبق إلا أرحم الراحمين فيقبض قبضة من النار فيخرج منها قوما لم يعملوا خير قط قد عادوا حمما فيلقيهم في نهر في أفواه الجنة يقال له: نهر الحياة فيخرجون كما تخرج الحبة في حميل السيل ألا ترونها تكون إلى الحجر أو الشجر ما يكون إلى الشمس أصيفر وأخيضر وما يكون منها إلى الظل يكون أبيض فيخرجون كاللؤلؤ في رقابهم الخواتيم يعرفهم أهل الجنة: هؤلاء عتقاء الله من النار الذين أدخلهم الجنة بغير عمل عملوه ولا خير قدموه ثم يقول: أدخلوا الجنة فما رأيتموه فهو لكم فيقولون: ربنا أعطيتنا ما لم تعط أحدا من العالمين فيقول: لكم عندي أفضل من هذا؟ فيقولون: يا ربنا أي شيء أفضل من هذا؟ فيقول: رضاي فلا أسخط عليكم بعده أبدا ""","صحيح","Sahih al-Jami al-Saghir 7031","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7032",""" هل تضارون في رؤية الشمس في الظهيرة ليست في سحابة؟ هل تضارون في رؤية القمر ليلة البدر ليس في سحابة؟ فوالذي نفسي بيده لا تضارون في رؤية ربكم عز وجل إلا كما تضارون في رؤية أحدهما فيلقى العبد فيقول: أي فل ألم أكرمك وأسودك وأزوجك وأسخر لك الخيل والإبل وأذرك ترأس وتربع؟ فيقول: بلى أي رب فيقول: أفظننت أنك ملاقي؟ فيقول: لا فيقول: إني أنساك كما نسيتني; ثم يلقى الثاني فيقول له: أي فل؟ ألم أكرمك وأسودك وأزوجك وأسخر لك الخيل والإبل وأذرك ترأس وتربع؟ فيقول: بلى أي رب! فيقول: أفظننت أنك ملاقي؟ فيقول: لا فيقول: إني أنساك كما نسيتني; ثم يلقى الثالث فيقول له مثل ذلك فيقول: رب آمنت بك وبكتابك وبرسلك وصليت وصمت وتصدقت ويثني بخير ما استطاع فيقول: هاهنا إذن ثم يقال: الآن نبعث شاهدا عليك ويتفكر في نفسه: من ذا الذي يشهد علي؟ فيختم على فيه ويقال لفخذه: انطقي فتنطق فخذه ولحمه وعظامه بعمله وذلك ليعذر من نفسه وذلك المنافق الذي يسخط الله عليه ""","صحيح","Sahih al-Jami al-Saghir 7032","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7033",""" هل تمارون في القمر ليلة البدر ليس دونه سحاب؟ هل تمارون في رؤية الشمس ليس دونها سحاب؟ فإنكم ترونه كذلك يحشر الله الناس يوم القيامة فيقول: من كان يعبد شيئا فليتبعه فيتبع من كان يعبد الشمس الشمس ويتبع من كان يعبد القمر القمر ويتبع من كان يعبد الطواغيت الطواغيت وتبقى هذه الأمة فيها منافقوها; فيأتيهم الله في صورة غير صورته التي يعرفون فيقول: أنا ربكم فيقولون: نعوذ بالله منك هذا مكاننا حتى يأتينا ربنا فإذا جاءنا عرفناه فيأتيهم الله في صورته التي يعرفون فيقول: أنا ربكم فيقولون: أنت ربنا فيتبعونه; ويضرب الصراط بين ظهراني جهنم فأكون أول من يجوز من الرسل بأمته ولا يتكلم يومئذ أحد إلا الرسل وكلام الرسل يومئذ: اللهم سلم سلم وفي جهنم كلاليب مثل شوك السعدان غير أنه لا يعلم ما قدر عظمها إلا الله تخطف الناس بأعمالهم فمنهم من يوبق بعمله ومنهم من يخردل ثم ينجوحتى إذا فرغ الله من القضاء بين العباد وأراد أن يخرج برحمته من أراد من أهل النار أمر الملائكة أن يخرجوا من النار من كان لا يشرك بالله شيئا ممن يقول لا إله إلا الله فيخرجونهم ويعرفونهم بآثار السجود وحرم الله على النار أن تأكل آثار السجود فيخرجون من النار وقد امتحشوا فيصب عليهم ماء الحياة فينبتون كما تنبت الحبة في حميل السيل ثم يفرغ الله من القضاء بين العباد ويبقى رجل بين الجنة والنار وهو آخر أهل النار دخولا الجنة مقبلا بوجهه قبل النار فيقول: يا رب اصرف وجهي عن النار فقد قشبني ريحها وأحرقني ذكاؤها فيقول: هل عسيت إن فعل ذلك بك أن تسأل غير ذلك فيقول: لا وعزتك فيعطي الله ما يشاء من عهد وميثاق، فيصرف الله وجهه عن النار فإذا أقبل به على الجنة ورأى بهجتها سكت ما شاء الله أن يسكت ثم قال: يا رب! قدمني عند باب الجنة فيقول الله: أليس قد أعطيت العهد والميثاق أن لا تسأل غير الذي كنت سألت؟ فيقول: يا رب لا أكون أشقى خلقك فيقول: فما عسيت إن أعطيتك ذلك أن لا تسأل غيره؟ فيقول لا وعزتك لا أسألك غير ذلك فيعطى ربه ما شاء من عهد وميثاق فيقدمه إلى باب الجنة فإذا بلغ بابها فرأى زهرتها وما فيها من النضرة والسرور ; فيسكت ما شاء الله أن يسكت فيقول: يا رب أدخلني الجنة فيقول الله: ويحك يا ابن آدم! ما أغدرك! أليس قد أعطيت العهد والميثاق أن لا تسأل غير الذي أعطيت؟ فيقول: يا رب لا تجعلني أشقى خلقك فيضحك الله منه ثم يأذن له في دخول الجنة فيقول: تمن فيتمني حتى إذا انقطعت أمنيته قال الله تعالى: زد من كذا وكذا أقبل يذكره ربه حتى إذا انتهت به الأماني قال الله عز وجل: لك ذلك ومثله معه ""","صحيح","Sahih al-Jami al-Saghir 7033","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7034","«هل تنصرون إلا بضعفائكم؟ بدعوتهم وإخلاصهم»","صحيح","Sahih al-Jami al-Saghir 7034","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7035","«هل تنصرون وترزقون إلا بضعفائكم؟»","صحيح","Sahih al-Jami al-Saghir 7035","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7036",""" هل قرأ معي أحد منكم آنفا؟ إني أقول: مالي أنازع القرآن؟!","صحيح","Sahih al-Jami al-Saghir 7036","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7037","«هل منكم رجل إذ أتى أهله فأغلق عليه بابه وألقى عليه ستره واستتر بستر الله؟ قالوا: نعم قال: ثم يجلس بعد ذلك فيقول: فعلت كذا فعلت كذا فسكتوا ثم أقبل على النساء فقال: هل منكن من تحدث؟ فسكتن فجثت فتاة كعاب على إحدى ركبتيها وتطأولت لرسول الله صلى الله عليه وسلم ليراها ويسمع كلامها فقالت: يا رسول الله! إنهم ليحدثون وإنهن ليحدثن فقال: هل تدرون ما مثل ذلك؟ إنما مثل ذلك مثل شيطانة لقيت شيطانا في السكة فقضى حاجته والناس ينظرون إليه! ألا إن طيب الرجال ما ظهر ريحه ولم يظهر لونه ألا إن طيب النساء ما ظهر لونه ولم يظهر ريحه ألا لا يفضين رجل إلى رجل ولا امرأة إلى امرأة إلا إلى ولد أو والد»","صحيح","Sahih al-Jami al-Saghir 7037","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7038","«هلاك أمتي على يدي غلمة من قريش»","صحيح","Sahih al-Jami al-Saghir 7038","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7039","«هلك المتنطعون»","صحيح","Sahih al-Jami al-Saghir 7039","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7040","«هلك كسرى ثم لا يكون كسرى بعده وقيصر ليهلكن ثم لا يكون قيصر بعده وليقسمن كنوزهما في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 7040","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7041","«هلا أخذتم إهابها فدبغتموه فانتفعتم به؟ إنما حرم أكلها»","صحيح","Sahih al-Jami al-Saghir 7041","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7042","«هلا تركتموه لعله أن يتوب فيتوب الله عليه» .؟ - يعني ماعزا -","صحيح","Sahih al-Jami al-Saghir 7042","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7043","«هلم إلى الغداء المبارك» - يعني السحور -","صحيح","Sahih al-Jami al-Saghir 7043","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7044","«هلم إلى جهاد لا شوكة فيه: الحج»","صحيح","Sahih al-Jami al-Saghir 7044","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7045","«هما ريحانتاي من الدنيا» - يعني الحسن والحسين -","صحيح","Sahih al-Jami al-Saghir 7045","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7046","«هم الأخسرون ورب الكعبة هم الأخسرون ورب الكعبة يوم القيامة الأكثرون إلا من قال في عباد الله هكذا وهكذا وقليل ما هم والذي نفسي بيده ما من رجل يموت يترك غنما أو إبلا أو بقرا لم يؤد زكاتها إلا جاءته يوم القيامة أعظم ما يكون وأسمنه حتى تطأه بأظلافها وتنطحه بقرونها حتى يقضي بين الناس كلما تقدمت أخراها عادت أولاها»","صحيح","Sahih al-Jami al-Saghir 7046","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7047","«هو اختلاس يختلسه الشيطان من صلاة العبد» - يعني الالتفات -","صحيح","Sahih al-Jami al-Saghir 7047","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7048","«هو الطهور ماؤه الحل ميتته»","صحيح","Sahih al-Jami al-Saghir 7048","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7049","«هو حر كله ليس لله شريك»","صحيح","Sahih al-Jami al-Saghir 7049","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7050","«هو عليها صدقة وهو منها لنا هدية»","صحيح","Sahih al-Jami al-Saghir 7050","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7051","«هو في ضحضاح من نار ولولا أنا لكان في الدرك الأسفل من النار» - يعني أبا طالب -","صحيح","Sahih al-Jami al-Saghir 7051","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7052","«هون عليك فإني لست بملك إنما أنا ابن امرأة من قريش كانت تأكل القديد»","صحيح","Sahih al-Jami al-Saghir 7052","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7053","«الهجرة هجرتان: هجرة الحاضر وهجرة البادي فأما البادي فيجيب إذا دعي ويطيع إذا أمر وأما الحاضر فهو أعظمهما بلية وأعظمهما أجرا»","صحيح","Sahih al-Jami al-Saghir 7053","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
"7054","«الهدية إلى الإمام غلول»","صحيح","Sahih al-Jami al-Saghir 7054","","","الأحاديث المبدوءة بحرف الهاء Hadith Beginning with the Letter Ha (ه)"
