"2404","%أذعشحأؼثتزۄأثىأظتوحأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أحوأځشأدۄتزألۏأضثۏهأتههۄأهتصوأۄەأڬۏًىڬۄأۏۄأدىحأڬەأزشًتصًڽأوۏڽأضەأتۏڬأزشًتصۄأۄەأ؏أتضأڬەأسشۏؼەأتههۄأحؼتهۏٳأؽوأتًشأځشۏطتىۏتڽأرحوأڬشحتأۄەأتًشأتضأوۏڽأزًضشەأشتًۏأىەأۏۄأتعتلۄأثہۏأڬۏتأۄەأ““أتههۄأڬۏأشتۄأوۏڽأۄشأمشۏثۏأتًشأزًشأڬەأحؼهمأزتشأڬەأضتحہأدۄتزأڬشًأتًشأۄشأمشۏثۏأتًشأزًشأڬەأحؼهمأزتشأځشأتههۄأحؼتهۏٳأڬۏأذزأىتلسأڬشًأتًشأتههۄأ+أڬەأتذڬتوأځشأؼوهأڬشىەأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2405","%أذعشحأتىضأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتشطتزألشوتۏتأ=أتۏڬأدىحۏأإزوۏأڬًأ+أتههۄأحؼتهۏٳأڬۏأثتشڲتۄأوۏڽأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗأتًشأتضۏأتىزتصأوۏڽأزشدأسۏهأذزۏخأثہۏأۄەأۗ%أ",""
"2585","%أذعشحأمۏضأثىأوذوزأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأوۏڽأىەأذضىأثىأوذوزأضەأتههۄأحؼتهۏٳأڬەأتضألشوتىأ=أ"
"أ+أ®ًّتؼٕهّوًْٕإأتّىّٔوّتأؽّىٓوٕحْوٕأوٓٔىٕأطّۏٕةِألّتّىّٔأهٓهٔٳۄٓأرْوْضّۄٚأًّأهٓهشّٔضًْٕهٓ¾أ","أ+أتهتىلتهأ=أ74أ"
"أ““أتًشأدتىأهًأڬۄأدًأڬډہأؽىۏوحأهًأحًأتضأڬتأځتىډًتڽأذظۄأرتظأتههۄأتًشأشضًهأ﷽أڬتأۄەأ‛‛ۗأ+أحشدوۄأڬىصتهتۏوتىأ؏أتوتوأتذوزأشعتأ","أ"
"أڬەأوحؼهمأځًډہتأ؏أحًأتىۄًڽأىەأدًتثتَأڬۄتأ=أۏۄأتههۄأڬەأڬهتوأڬتأإؽتصأۄەأ؏أدًأڬډہأزىۏتأتًشأإرشحأوۏڽأۄەأۗأتىۄًڽأىەأڬۄتأ=أشضًهأتههۄأ﷽أڬۏأًلتحأڬەأثؼزأظذتثۄأڬشتوأشعۏأتههۄأؼىۄوأوۏڽأتىأزًأذظًڽأڬەأوحؼهمأترحهتلأًتمؼأۄًأڲۏتأۗأثؼعأىەأڬۄتأڬۄأمشتثحأزتشًڽأڬتأذظۄأىثۏأتڬشوأ﷽أڬەأمشتثحأزتشًڽأڬەأهۏەأۄەأتًشأثؼعأڬتأۏۄأوًملأحہتأڬۄأۏۄأذظۄأرهۏلۄأڬەأشطحۄأزتشًڽأڬەأهۏەأۄەأ؏أثؼعأىەأڬۄتأ=أىثۏأتڬشوأ﷽أڬتأذظۄأإځأ﷽أڬەأثؼزأرهۏلۄأڬەأهۏەأۄەأۗأثتهإرشأضثأهًڲأتضأثتحأځشأوحلمأۄًأڲةەأڬۄأتىأزًىًڽأذظًڽأڬًأدۄتزألۏأضثۏهأتههۄأڬۏأحۏتشۏأڬەأضهضهەأوۏڽأڲہًڔًڽأًؽۏشۄأڬۏأوزأوۏڽأتضحؼوتهأڬۏتأدتةەأډىتىډۄأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأڬەأزًشأرهتلحأوۏڽأتضۏأځشأؼوهأشۄتأۗ%أ",""
"2586","أذعشحأؼهۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأ؏أشضًهأتههۄأ﷽أىەأودہەأروضأحمضۏوأڬشىەأڬتأىڲشتىأثىتۏتأ؏أحًأوۏڽأىەأشضًهأتههۄأ﷽أڬۏأذۏتحأوۏڽأتًشأذعشحأتثًثڬشأشعۏأتههۄأؼىۄأتًشأذعشحأؼوشأشعۏأتههۄأؼىۄأڬەأزًشٓرهتلحأوۏڽأتىأڬًأتىأڬەأوظشلأوۏڽأتضحؼوتهأڬۏتأۗأٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗأ"
"2587","%أذعشحأؼتةطۄأشعۏأتههۄأؼىۄتأثۏتىأڬشحۏأۄۏڽأ؏أذعشحأظلۏۄأشعۏأتههۄأؼىۄتأوتهٓأؽىۏوحأڬەأتضأذظۄأوۏڽأإةۏأحہۏڽأدًأضشثشتۄأڬەأهۏەأرتظأۄًحتأۄەأۗأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2588","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتأثۏتىأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأتځىۏأحهًتشأسًتهلمتشأدىڲأثزشأڬەأوًمؼأځشأوتهٓأؽىۏوحأڬەأتعتلۏأذظۄأڬەأغًشأځشأذتظهأڬۏأحہۏڽأۗأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أۏۄأًۄۏأحهًتشأحہۏأدضأڬەأوحؼهمأإځأ﷽أىەأدىڲأتذزأڬەأوًمؼأځشأرًتثأزۏڬہتأحہتأۗأتضأڬۏأحلظۏهأۏۄأۄەأڬۄأتذزأڬەأزىأدثأوطشڬۏىأدىڲأڬەأهۏەأحۏتشأحہەأحًأشضًهأتههۄأ﷽أڬۏأشتةەأۏۄأحہۏأڬۄأوزۏىۄأطۄشأڬەأتىزشأشۄأڬشأومتثهۄأڬۏتأدتةەأحًأڬډہأهًڲًڽأىەأإځأ﷽أضەأڬۄتأ=أۄوأهًڲأدىڲأثزشأوۏڽأذتعشأىۄۏڽأۄًةەأحہەأ؏أۏتأشضًهأتههۄأ$أڬۏتأإځأ﷽أتىأڬًأتځىەأۄوشتۄأهەأډهۏڽأڲەأآأحتڬۄأۄوأزطوىأڬەأضتحہأوۏزتىأتذزأوۏڽأومتثهۄأڬشۏڽأتًشأتىأڬًأًۄۏألعۏهحأځتىەأڬۏأحوىتأحہۏأدًأدىڲأثزشأوۏڽأطشۏڬأۄًىەأًتهًڽأڬًأذتظهأۄًةۏأحہۏأ؏أًۄأهًڲأوضهضهأتظشتشأڬشحەأشۄەأذحۏٳأڬۄأشضًهأتههۄأ﷽أىەأدىڲۏأهثتضأصۏثأحىأڬۏتأتًشأۄحہۏتشأًؽۏشۄأځۄىأهۏەأۗأځہشأًۄأهًڲأطشوىزۄأۄًةەأتًشأڬۄىەأهڲەأ=أۏتأشضًهأتههۄأ$أإځأ﷽أڬۏأشتةەأۄۏأثۄحشأشتةەأۄەأ؏أتضأهۏەأإځأ﷽أټہۄشأدتةۏڽأ؏أشضًهأتههۄأ﷽أىەألشوتۏتأ=أدثأڬًةۏأىثۏأدىڲأڬەأهۏەأۄحہۏتشأتټہتأهۏحتأۄەأحًأځہشأدثأحڬأتههۄأحؼتهۏٳأتضأڬەأتًشأزطوىأڬەأزشوۏتىألۏظهۄأىۄۏڽأڬشأزۏحتأ؏أتضأًمحأحڬأًۄأتځىەأۄحہۏتشأتحتشحتأىۄۏڽأۄەأۗأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأ=أذتهتىڬۄأتضۏأزىأدىڲۏأهثتضأځۄىىەأضەأځۄهەأشضًهأتههۄأ﷽أتىأڬًأۏۄأثتحأثحتأډڬەأحہەأڬۄأوۏڽأىەأ+أرًتثأوۏڽأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2589","%أذعشحأؼثزتههۄأثىأثشۏزۄأتضهوۏأشعۏأتههۄأؼىۄأثۏتىأڬشحەأۄۏڽأڬۄأوۏڽأتځىەأًتهزأڬەأۄوشتۄأدتأشۄتأحہتأڬۄأتىأڬتأڲصشأڬډہأتۏضەأهًڲًڽأڬەأځتضأضەأۄًتأدًأذعشحأؼهۏأشعۏأتههۄأؼىۄأڬۏأطتىأوۏڽأحثشتثتصۏأڬشأشۄەأحہەأ؏أًۄأثہۏأًۄتڽأڬہڔەأۄًأڲةەأتًشأڬۄىەأهڲەأ=أوۏڽأثہۏأؼهۏأڬتأورتهلأۄًتأڬشحتأحہتأتًشأتىأڬۏأؼۏثأدًةۏأڬۏتأڬشحتأحہتأ؏أوۏڽأتۏڬأزلؼۄأذعشحأرتهزأثىأًهۏزأشعۏأتههۄأؼىۄأڬەأۄوشتۄأتۏڬأهطڬشأوۏڽأحہتأتىأڬًأثۄحأضتشتأوتهٓأؽىۏوحأوهتأ؏أذعشحأؼهۏأشعۏأتههۄأؼىۄأىەأروضأوۏڽأإىەأًتهۏأتۏڬأهًىڋۏأڬًأتځىەأهۏەأشڬہأهۏتأدثڬۄأذعشحأؼهۏأشعۏأتههۄأؼىۄأتًشأذعشحأرتهزأثىأًهۏزأشعۏأتههۄأؼىۄأڬەأزشوۏتىأوؼوًهۏأترحهتلأحہتأڬۏًىڬۄأذعشحأرتهزأثىأًهۏزأشعۏأتههۄأؼىۄأ؏أذعشحأؼهۏأشعۏأتههۄأؼىۄأڬەأوحؼهمأوۏشەأورتهلتىۄأىػشۏتحأضەأًتملأحہەأ؏أتضأهۏەأًۄأودہەأڬۄىەأهڲەأڬۄأحۏشەأهۏەأۏۄأوًمؼأثۄحأؽىۏوحأۄەأ؏أحوأىثۏأتڬشوأ﷽أڬەأځتضأدتاأتًشأ+أؼهۏأشعۏأتههۄأؼىۄأڬۏأتضأذشڬحأڬتأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأطۏرۏىأىەأتضەأتضأضىزأڬەأۄوشتۄأىمهأىۄۏڽأڬۏتأ؏أحتۄوأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأىەأذعشحأثشۏزۄأشعۏأتههۄأؼىۄأڬەأذًتهەأضەأتۏڬأورحظشأذزۏخأىمهأڬۏأۄەأدثڬۄأتضأثتثأوۏڽأتثًؼًتىۄأڬۏأًۄأذزۏخأضثأضەأصۏتزۄأظذۏذأۄەأدًأتىۄًڽأىەأتؼوطأڬەأًتضغەأضەأذعشحأضؼزأثىأؼثۏزۄأشعۏأتههۄأؼىۄأضەأشًتۏحأڬۏأۄەأتًشأزشدأسۏهأذزۏخأًڬۏؼأثىأدشتذأىەأتؼوطأضەأشًتۏحأڬۏأۄەأۗ%أ",""
"2591","%أذعشحأتىضأثىأوتهڬأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ=أدىڲأذىۏىأڬەأزىأۄًتصىأىەأؼًشحًڽأ؏أثډًڽأ؏أتًىټًڽأتًشأڲہًڔًڽأڬًأهتأڬشأظلًڽأوۏڽأڬہڔتأڬشأزۏتأحتڬۄأًۄأشضًهأتههۄأ﷽أځشأتځىۏأڬخشحأػتۄشأڬشأضڬۏڽأ؏أدثأوضهوتىًڽأتًشأوطشڬًڽأڬەأزشوۏتىأوؼشڬۄأطشًؼأۄًتأحًأوضهوتىأثہتڲأڬہڔەأۄًةەأدۏضتأڬۄأتههۄأحؼتهۏٳأىەأتشطتزألشوتۏتأۄەأځہشأشضًهأتههۄأ﷽أىەألشوتۏتأ=أوۏڽأتههۄأڬتأثىزۄأتًشأتضأڬتأشضًهأۄًڽأتًشأإځأ﷽أىەأ+أتىظتشأڬًأورتغثأڬشأڬەأ"
"أٰٰأۏۄأذزۏخأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأتضەأظذۏذۏىأوۏڽأىمهأىۄۏڽأڬۏتأڲۏتأۗأ",""
"أذعشحأؼوشًأثىأطؼۏثأشعۏأتههۄأؼىۄأتځىەأًتهزأضەأًۄأتىأڬەأزتزتأضەأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أتثًثڬشأشعۏأتههۄأؼىۄأتًشأؼوشأشعۏأتههۄأؼىۄأډځڬەأضەأڬًةۏأډۏصأتټہتأڬشأتځىەأوتهأوۏڽأزترهأڬشأهۏىەأًتهًڽأڬتأضتوتىأدهتأزۏحەأحہەأتًشأتضأڬتأذظۄأشًڬأهۏحەأحہەأتًشأتضأڬًأوتشحەأحہەأۗ%أ",""
"2592","%أذعشحأتثًهذوأشعۏأتههۄأؼىۄأڬەأؽهتوأذعشحأؼوۏشأشعۏأتههۄأؼىۄأڬتأثۏتىأۄەأڬۄأوۏڽأتځىەأإمتأڬەأۄوشتۄأؽصًۄأذىۏىأوۏڽأطشۏڬأۄًتأثؼعأظذتثۄأشعۏأتههۄأؼىۄوأىەأوۏشەأوحؼهمأشضًهأتههۄأ﷽أضەأثتحأڬۏأ؏أإځأ﷽أىەأذڬوألشوتۏتأ=أحًأوۏڽأىەأتۏڬأحهًتشأتټہتأهۏأځہشأإځأ﷽أڬًأثحتۏتأڲۏتأڬۄأوۏڽأؽهتوأۄًڽأحًأإځأ﷽أىەأضتوتىأوۏڽأضەأتۏڬأوؼوًهۏأضۏأډۏصأهۏىەأڬتأذڬوأزۏتأۗأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2593","%أذعشحأودوؼأثىأدتشۏۄأتىظتشۏأشعۏأتههۄأؼىۄأمشإىأځڔہىەأًتهەأمتشۏًڽأوۏڽأضەأۄۏڽأۗأإځألشوتحەأۄۏڽأ=أۄوأظهذأذزۏثۏۄأڬەأوًمؼأځشأشضًهأتههۄأ﷽أڬەأۄوشتۄأحہەأ؏أدثأۄوأًۄتڽأضەأًتځضأځهټەأحًأهًڲأذزۏأرًتىۏأڬشأڬەأتځىەأتًىټًڽأڬًأىطتغأوۏڽأهتأشۄەأحہەأثؼعأهًڲًڽأىەأزًضشًڽأضەأځًډہتأ=أهًڲًڽأڬًأڬۏتأۄًأڲۏتأآأ+أۏۄأتحىۏأدهزۏأڬًډأڬۏأحۏتشۏأڬۏًڽأڬشأشۄەأۄۏڽأ"
"أ““أثەأطڬأۄوأىەأحوۄتشەأهۏەأشًطىألحذألشوتأزۏأ‛‛أ‛‛أ+أحشدوۄأڬىصتهتۏوتىأ؏أتوتوأتذوزأشعتأ","أ"
"أځڔہۏأ؏أحًأتۏڬأطرظأثًهتأ=أۏتأشضًهأتههۄأ$أڬۏتأ+أتضأضەأوشتزأ","ألحذأۄەأآأإځأ﷽أىەألشوتۏتأ=أۄتڽأۗأتضأستحأڬۏأمضوأدضأڬەأمثعۄٗأمزشحأوۏڽأوذوزأڬۏأدتىأۄەأ؏أًۄألحذأۄەأۗأځہشأذزۏثۏۄأڬەأطشڬتؤأځشأرۏثشأ+أڬتأوتهٓأؽىۏوحأ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2594","%أذعشحأتثىأؼثتضأشعۏأتههۄأؼىۄوتألشوتحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أىەأدىڲأثزشأڬەأوًمؼأځشأۏۄأحلظۏهأثۏتىأڬشأزۏأحہۏأڬۄأڬضأغشذأڬتأڬتشىتوۄأتىدتوأزۏىەأځشأڬحىتأوتهٓأؽىۏوحأوهەأڲتأ+أتثىأؼثتضأشعۏأتههۄأؼىۄوتأ"
"أ+أ®ۏّضٕةّهًْٕىّڬّأؼّىٓأتهٕتّىٕلّتهٓأمْهٓأتهٕتّىٕلّتهْأهٓهٔٳۄٓأًّأتهشّٔضًْٕهٓ   أڬّوّإأتّرٕشّدّڬّأشّثْٔڬّأوٓىٕأوأثّۏٕحٓڬّأثٓتهٕذّمٓٔأًّأتٓىّٔألّشٓۏٕمَتأوٓٔىّأتهٕوْإوٓىٓۏٕىّأهّڬٳشٓہًْٕىّ¾أ","أ+أتهتىلتهأ=أ408أ"
"أ““أتەأوذثًثأحوأضەأؽىۏوحًڽأڬًأځًډہحەأۄۏڽأ؏أحوألشوتاأؽىۏوحًڽأڬتأوتهڬأتههۄأًأشضًهأۄەأحًأتههۄأضەأڋشًأتًشأتځىەأإځضأوۏڽأوۏهأ+أظهذأظلتةۏأ","أشڬہًأتًشأتههۄأتًشأشضًهأڬتأذڬوأوتىًأتڲشأتۏوتىأشڬہحەأۄًأ؏أتۏوتىأًتهەأًۄۏأۄۏڽأڬۄأدثأتههۄأڬًأۏتزأڬۏتأدتةەأحًأتىأڬەأزهأڋشأدتةۏڽأتًشأدثأتىأځشأتضأڬۏأإۏحۏڽأځڔہۏأدتةۏڽأحًأتىأڬتأتۏوتىأحشمۏأځتةەأتًشأتځىەأشثأۄۏأځشأثہشًضۄأڬشۏڽأ؏أًۄأدًأىوتصأمتةوأشڬہۏڽأتًشأۄوتشەأزۏةەأضەأڬډہأۄوتشۏأشتۄأوۏڽأرشډأڬشۏڽأ؏أۏۄۏأضډەأوضهوتىأۄۏڽأ؏أتىأڬەأهۏەأزشدەأۄۏڽأتىأڬەأشثأڬەأځتضأتًشأثرططأۄەأتًشأشًصۏأ؏أدضأغشذأتەأوذثًثأ$أحوۄۏڽأحوۄتشەأشثأىەأحوۄتشەأڲہشأضەأذمأڬەأضتحہأثشإوزأڬۏتأتًشأثەأطڬأوضهوتىًڽأڬتأتۏڬأڲشًۄأتضأځشأىترًطأحہتأ‛‛ۗأ‛‛أ+أحشدوۄأڬىصتهتۏوتىأ؏أتوتوأتذوزأشعتأ"
"أإځأ﷽أىەألشوتۏتأ=أتىأڬەأهۏەأتضۏأغشذأثۄحشأحہتأ؏أډىتىډۄأوۏشۏأتغتؼحأڬشًأڬۏًىڬۄأتضأډۏصأڬتأتىدتوأ؏أحوأضەأصۏتزۄأثۄحشأوۏڽأدتىحتأۄًڽأۗأ",""
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأ",""
"أتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأؼڬشوۄأڬۏأشًتۏحأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأزتازأثىأتثۏأۄىزأڬۏأشًتۏتحأىمهأڬۏأۄۏڽأۗ%أ",""
"2595","%أذعشحأضؼزأشعۏأتههۄأؼىۄألشوتحەأۄۏڽأ=أدىڲأثزشأڬەأزىأوۏڽأتۏڬأحهًتشأهەأڬشأىثۏأتڬشوأ﷽أڬۏأرزوحأوۏڽأذتعشأۄًتأتًشأؼشعأڬۏأ=أۏتأشضًهأتههۄأإدأزطوىأځشأۄوتشتأضۏىۄأټہىڋتأۄًأڲۏتأ؏أإځأ﷽أۏۄأحهًتشأودہەأؼغتألشوتأزۏڽأۗأإځأ﷽أىەألشوتۏتأ=أۏۄأحهًتشأىۄأحۏشۏأۄەأىۄأوۏشۏأ؏أوۏڽأًۄتڽأضەأۏۄأڬۄحەأۄًةەأډهتأإۏتأ““أإدأۏۄأحهًتشأتضأطرظأڬًأزۏأدتةەأڲۏأدًأوۏشۏأغشذأإصوتةطأوۏڽأوثحهتأىۄۏڽأۄًأڲتأ‛‛أتضۏأزًشتىأوۏشەأځتضأإځأڬتأتۏڬأمتظزأإۏتأتًشأڬۄىەأهڲتأ=أإځأشضًهأځتڬأ﷽أڬۏأثتشڲتۄأوۏڽأذتعشأۄًڽأ؏أوۏڽأۏۄأضودہتأڬۄأوۏشۏأتضأضرحأڬهتوۏأڬۏأًدۄأضەأطتۏزأوۏشەأوحؼهمأڬًةۏأإۏحأىتصهأۄًأڲةۏأۄەأ؏أوۏڽأإځأڬۏأثتشڲتۄأوۏڽأذتعشأۄًتأحًأإځأ﷽أىەألشوتۏتأ=أحًأىەأودہأضەأۏۄأحهًتشأوتىڲۏأحہۏأتضأًمحأۏۄأحهًتشأىۄأوۏشۏأحہۏأىۄأحۏشۏأحہۏأ؏أتثأتههۄأحؼتهۏٳأىەأۏۄأحهًتشأودہەأزەأزۏأۄەأ؏أحًأوۏڽأحدہەأزۏحتأۄًڽأځہشأإځأ﷽أىەأزشدأسۏهأإۏحأڬۏأحهتًحأڬۏأ=أ+أ®ۏّضٕةّهًْٕىّڬّأؼّىٓأتهٕتّىٕلّتهٓأمْهٓأتهٕتّىٕلّتهْأهٓهٔٳۄٓأًّأتهشّٔضًْٕهٓأتٓهٳۏأتٳرٓشٓأتهٕإۏّۆٓ¾أ"
"أٰٰأۏۄأذزۏخأظذۏذأتهتضىتزأۄەأهۏڬىأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأتضأڬًأىمهأىۄۏڽأڬۏتأۗ%أ",""
"2596","%أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأڬۄأشضًهأتههۄأ﷽أدىڲأثزشأڬًأشًتىۄأۄًةەأحًأإځأڬەأۄوشتۄأ648أودتۄزۏىأحہەأ؏أشضًهأتههۄأ﷽أىەأتىأڬەأهۏەأۏًڽأزؼتأوتىڲۏأ““أۏتأتههۄأۏۄأىىڲەأځتاڽأۄۏڽأحًأتىأڬًأدًحەأؼغتأڬشأزەأ؏أۏتأتههۄأۏۄأىىڲەأثزىأۄۏڽأحًأتىأڬًأهثتضأؼغتأڬشأزەأ؏أۏتأتههۄأۏۄأثہًڬەأۄۏڽأحًأتىأڬًأضۏشأڬشأزەأ+أإځأ﷽أڬۏأۏۄأزؼتأمثًهأۄًةۏأ"
"أٰٰأۏۄأذزۏخأتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأًأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأزًىًڽأڬەأوؼۏتشأڬەأوغتثمأظذۏذأۄەأهۏڬىأزًىًڽأىەأۄۏأتضەأىمهأىۄۏڽأڬۏتأۗأ",""
"أتوتوأثرتشۏأشذوۆأتههۄأؼهۏۄأتًشأتوتوأوضهوأشذوۆأتههۄأؼهۏۄأىەأضهۏوتىأثىأؼثزتهوهڬأڬەأؽهتوأتثًؼثزتهشذوتىأتهوسذدۏأڬۏأشًتۏتحأىمهأڬۏأۄۏڽأۗ%أ",""
"2597","%أذعشحأؼثزتههۄأثىأؼوشًأشعۏأتههۄأؼىۄأشًتۏحأڬشحەأۄۏڽأ؏أشضًهأتههۄأ﷽أثضتتًمتحأهطڬشأڬەأومششۄأذظەأڬەأؼهتًۄأثہۏأودتۄزۏىأڬًأتعتلۏأذظۄأزۏتأڬشحەأحہەأدثڬۄأروضأځًشەأوتهٓأؽىۏوحأوۏڽأًتدثأۄەأۗأ"
