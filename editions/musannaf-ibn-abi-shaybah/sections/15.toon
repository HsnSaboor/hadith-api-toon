"14436","(۱۴۴۳۶) حدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، قَالَ : تَلْبَسُ مَا شَائَتْ ، إِلاَّ الْبُرْقُعَ۔","","Musannaf Ibn Abi Shaybah 14436","","","كتاب الحج"
"14437","(۱۴۴۳۷) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، قَالاَ : تَلْبَسُ الْقُفَّازَیْنِ وَالسَّرَاوِیلَ ، وَلاَ تَبَرْقَعُ وَلا تَلَثَّمُ ، وَتَلْبَسُ مَا شَائَتْ مِنَ الثِّیَابِ ، إِلاَّ ثَوْبًا یَنْفُضُ عَلَیْہَا وَرْسًا ، أَوْ زَعْفَرَانًا۔","Hasan","Musannaf Ibn Abi Shaybah 14437","","","كتاب الحج"
"14438","(۱۴۴۳۸) حدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَرِہَ الْبُرْقُعَ وَالْقُفَّازَیْنِ لِلْمُحْرِمَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 14438","","","كتاب الحج"
"14439","(۱۴۴۳۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، وَعُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ تَلْبَسُ الْقُفَّازَیْنِ ، وَلاَ تَلْبَسُ ثَوْبًا مَسَّہُ وَرْسٌ ، وَلاَ زَعْفَرَانٌ۔","Hasan","Musannaf Ibn Abi Shaybah 14439","","","كتاب الحج"
"14440","(۱۴۴۴۰) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَام ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تَلْبَسُ الْمُحْرِمَۃُ الْقُفَّازَیْنِ وَالسَّرَاوِیلَ۔","Da'if","Musannaf Ibn Abi Shaybah 14440","","","كتاب الحج"
"14441","(۱۴۴۴۱) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الْقُفَّازَیْنِ ؟ فَقَالاَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14441","","","كتاب الحج"
"14442","(۱۴۴۴۲) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی النِّسَائَ فِی الإِحْرَامِ عَنِ الْقُفَّازَیْنِ وَالنِّقَابِ ، وَمَا مَسَّہُ الْوَرْسُ وَالزَّعْفَرَانُ مِنَ الثِّیَابِ۔ (بخاری ۱۸۳۸۔ ابوداؤد ۱۸۲۲)","Hasan","Musannaf Ibn Abi Shaybah 14442","","","كتاب الحج"
"14443","(۱۴۴۴۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَائِشَۃَ قَالَتْ : تَلْبَسُ الْمُحْرِمَۃُ مَا شَائَتْ مِنَ الثِّیَابِ ، إِلاَّ الْبُرْقُعَ وَالْقُفَّازَیْنِ ، وَلاَ تَتَنَقِّبُ۔","","Musannaf Ibn Abi Shaybah 14443","","","كتاب الحج"
"14444","(۱۴۴۴۴) حدَّثَنَا جَرِیرٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلْقَمَۃُ یَخْنِسُ وَجْہَہُ فِی ثَوْبِہِ وَہُوَ مُحْرِمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14444","","","كتاب الحج"
"14445","(۱۴۴۴۵) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ إِذَا آذَتْکَ الرِّیحُ وَأَنْتَ مُحْرِمٌ أَنْ تَرْفَعَ ثَوْبَک إلَی وَجْہِکَ ، وَلاَ بَأْسَ لِلْمَرْأَۃِ إِذَا آذَتْہَا الرِّیحُ أَنْ تَسْدُل ثَوْبَہَا علی وَجْہِہَا۔","","Musannaf Ibn Abi Shaybah 14445","","","كتاب الحج"
"14446","(۱۴۴۴۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ مُحْرِمُونَ ، فَإِذَا لَقِینَا الرَّکْبَ سَدَلْنَا ثِیَابَنَا مِنْ فَوْقِ رُؤُوسِنَا عَلَی وُجُوہِنَا ، فَإِذَا جَاوَزْنَا رَفَعْنَاہَا۔n(ابوداؤد ۱۸۲۹۔ دارقطنی ۲۶۲)","Da'if","Musannaf Ibn Abi Shaybah 14446","","","كتاب الحج"
"14447","(۱۴۴۴۷) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا آذَتِ الْمُحْرِمَ الرِّیحُ ، فَلاَ بَأْسَ أَنْ یَرْفَعَ ثَوْبَہُ مِنْ بَیْنِ یَدَیْہِ فیُغَطِّیَ بِہِ إلَی جَبْہَتِہِ۔","","Musannaf Ibn Abi Shaybah 14447","","","كتاب الحج"
"14448","(۱۴۴۴۸) حدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ بَأْسَ أَنْ تُغَطِّیَ وَجْہَکَ وَأَنْتَ مُحْرِمٌ ، وَأَنْفَکَ وَأَنْتَ مُحْرِمٌ إِلَی جَبِینِکَ۔","","Musannaf Ibn Abi Shaybah 14448","","","كتاب الحج"
"14449","(۱۴۴۴۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : یَرْفَعُ الْمُحْرِمُ ثَوْبَہُ إِذَا کَانَ مُضْطَجِعًا إِلَی عَیْنَِیہِ، وَتَسْدُلُ الْمُحْرِمَۃُ ثَوْبَہَا عَلَی وَجْہِہَا۔","","Musannaf Ibn Abi Shaybah 14449","","","كتاب الحج"
"14450","(۱۴۴۵۰) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، عَنِ الْفُرَافِصَۃِ بْنِ عُمَیْرٍ ، قَالَ : رَأَیْتُ عُثْمَانَ مُغَطِّیًا وَجْہَہُ وَہُوَ مُحْرِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 14450","","","كتاب الحج"
"14451","(۱۴۴۵۱) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : یُغَشِّی وَجْہَہُ بِثَوْبِہِ إلَی شَعْرِ رَأْسِہِ ، وَأَشَارَ أَبُو الزُّبَیْرِ بِثَوْبِہِ حَتَّی رَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 14451","","","كتاب الحج"
"14452","(۱۴۴۵۲) حدَّثَنَا عَلِی بْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الْوَجْہُ فَمَا فَوْقَہُ مِنَ الرَّأْسِ ، فَلاَ یُخَمِّرُ أَحَدٌ الذَّقَنَ فَمَا فَوْقَہُ۔","","Musannaf Ibn Abi Shaybah 14452","","","كتاب الحج"
"14453","(۱۴۴۵۳) حدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ إِذَا نَامَ غَطَّی وَجْہَہُ إِلَی أَطْرَافِ شَعْرِہِ۔","","Musannaf Ibn Abi Shaybah 14453","","","كتاب الحج"
"14454","(۱۴۴۵۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنِ الْقَاسِمِ ، عَنِ الْفُرَافِصَۃِ ؛ رَأَی عُثْمَانَ ، وَزَیْدًا ، وَمَرْوَانَ بْنَ الْحَکَمِ یُخَمِّرُونَ وُجُوہَہُمْ وَہُمْ مُحْرِمُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 14454","","","كتاب الحج"
"14455","(۱۴۴۵۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنِ الْفُرَافِصَۃِ ، قَالَ : رَأَیْتُ عُثْمَانَ مُغَطِّیًا وَجْہَہُ بِثَوْبِہِ وَہُوَ مُحْرِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 14455","","","كتاب الحج"
"14456","(۱۴۴۵۶) حدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ سَالِمِ بْنِ مَاہَانَ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یُرَخِّصُ لِلْمُحْرِمِ أَنْ یُغَطِّی شَفَتَیْہِ مَا دُونَ أَنْفِہِ۔","","Musannaf Ibn Abi Shaybah 14456","","","كتاب الحج"
"14457","(۱۴۴۵۷) حدَّثَنَا وَکِیعٌ، عَنْ مَعْقِلٍ، عَنْ عَطَائٍ، قَالَ: یُغَطِّی الْمُحْرِمُ وَجْہَہُ إلَی الْحَاجِبَیْنِ۔ وَقَالَ: ہُوَ قَوْلُ سُفْیَانَ۔","","Musannaf Ibn Abi Shaybah 14457","","","كتاب الحج"
"14458","(۱۴۴۵۸) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ حَاطِبٍ ؛عَمَّنْ رَأَی عُثْمَانَ مُحْرِمًا مُغَطِّیًا وَجْہَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 14458","","","كتاب الحج"
"14459","(۱۴۴۵۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنِ الْفُرَافِصَۃِ ، قَالَ : رَأَیْتُ عُثْمَانَ ، وَزَیْدًا ، وَابْنَ الزُّبَیْرِ یُغَطُّونَ وُجُوہَہُمْ وَہُمْ مُحْرِمُونَ ، إِلَی قِصَاصِ الشَّعْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 14459","","","كتاب الحج"
"14460","(۱۴۴۶۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ رَأَی رَجُلاً مُحْرِمًا قَدِ اسْتَظَلَّ بِعُودٍ ، فَقَالَ : اِضْحَ لِمَنْ أَحْرَمْتَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14460","","","كتاب الحج"
"14461","(۱۴۴۶۱) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ ، قَالَ : خَرَجْتُ مَعَ عُمَرَ فَمَا رَأَیْتُہُ مُضْطَرِبًا فُسْطَاطًا حَتَّی رَجَعَ ، قُلْتُ لَہُ ، أَوْ قِیلَ لَہُ : بِأَیِّ شَیْئٍ کَانَ یَسْتَظِلُّ ؟ قَالَ : کَانَ یَطْرَحُ النِّطَعَ عَلَی الشَّجَرَۃِ فَیَسْتَظِلُّ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 14461","","","كتاب الحج"
"14462","(۱۴۴۶۲) حدَّثَنَا وَکِیعٌ ، عَنْ کَثِیرِ بْنِ زَیْدٍ ، عَنِ الْمُطَّلِبِ بْنِ عَبْدِ اللہِ بْنِ حَنْطَبٍ ، قَالَ : کَانَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُضَحُّونَ إِذَا أَحْرَمُوا۔","Hasan","Musannaf Ibn Abi Shaybah 14462","","","كتاب الحج"
"14463","(۱۴۴۶۳) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی إِسْمَاعِیلَ ، عَنْ أَخِیہِ إِسْمَاعِیلَ بْنِ رَاشِدٍ ، قَالَ : حَجَجْنَا وَمَعَنَا عَمْرُو بْنُ مَیْمُونٍ ، فَأَصَابَنَا بَرْدٌ شَدِیدٌ ، فَکَانَ یُغَطِّی رَأْسَہُ وَنَحْنُ مُحْرِمُونَ۔","","Musannaf Ibn Abi Shaybah 14463","","","كتاب الحج"
"14464","(۱۴۴۶۴) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ عَطَائٍ ، وَعَنْ أَبِیہِ ، قَالاَ : یَسْتَظِلُّ الْمُحْرِمُ بِالْعُودِ وَبِیَدِہِ ، وَمِنَ الْحَرِّ وَالْبَرْدِ۔","","Musannaf Ibn Abi Shaybah 14464","","","كتاب الحج"
"14465","(۱۴۴۶۵) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : کَانَ أَبِی یَجْعَلُ الثَّوْبَ عَلَی الْمَحْمِلِ ، یَسْتَظِلُّ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14465","","","كتاب الحج"
"14466","(۱۴۴۶۶) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ عِمْرَانَ الْقَطَّانِ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ لَمْ یَرَ بَأْسًا أَنْ یَسْتَظِلَّ الْمُحْرِمُ مِنَ الشَّمْسِ۔","","Musannaf Ibn Abi Shaybah 14466","","","كتاب الحج"
"14467","(۱۴۴۶۷) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مَطَرٍ ، عَنْ أَبِی الْخَلِیلِ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14467","","","كتاب الحج"
"14468","(۱۴۴۶۸) حدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَابِرِ بْنِ زَیْدِ بْنِ رِفَاعَۃَ ، قَالَ : رَأَیْتُ مُجَاہِدًا وَہُوَ مُحْرِمٌ ، وَعَلَی رَحْلِہِ کَہَیْئَۃِ الطَّاقِ۔","","Musannaf Ibn Abi Shaybah 14468","","","كتاب الحج"
"14469","(۱۴۴۶۹) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنِ ابْنِ شَبِیبٍ ؛ أَنَّ عَائِشَۃَ سُئِلَتْ عَنِ الْمُحْرِمِ یُصِیبُہُ الْبَرْدُ ؟ فَقَالَتْ : یَقُولُ بِثَوْبِہِ ہَکَذَا ۔ وَرَفَعہُ فَوْقَ رَأْسِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 14469","","","كتاب الحج"
"14470","(۱۴۴۷۰) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ بِمِِِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 14470","","","كتاب الحج"
"14471","(۱۴۴۷۱) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حَبِیبٍ الْمُعَلِّمِ ، عَنْ عَطَائٍ ؛ سُئِلَ عَنْ مُحْرِمٍ أَصَابَہُ مَطَرٌ فَغَطَّی رَأْسَہُ ؟ فَقَالَ : فِدْیَۃٌ مِنْ صِیَامٍ ، أَوْ صَدَقۃ ، أَوْ نُسُکٍ۔","","Musannaf Ibn Abi Shaybah 14471","","","كتاب الحج"
"14472","(۱۴۴۷۲) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ سُلَیْمَانَ ، قَالَ : سَمِعْتُ ذَرًّا یَسْأَلُ إِبْرَاہِیمَ عَنِ الْمُحْرِمِ تُصِیبُہُ السَّمَائُ ، کَیْفَ یَصْنَعُ ؟ قَالَ : یَرْفَعُ قِنَاعَہُ فَوْقَ رَأْسِہِ ، وَلاَ یُغَطِّی بہِ رَأْسَہُ۔","","Musannaf Ibn Abi Shaybah 14472","","","كتاب الحج"
"14473","(۱۴۴۷۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : أَوَّلُ مَنْ عَرَّفَ بِالْبَصْرَۃِ ابْنُ عَبَّاسٍ۔","","Musannaf Ibn Abi Shaybah 14473","","","كتاب الحج"
"14474","(۱۴۴۷۴) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، قَالَ : رَأَیْتُ عَمْرَو بْنَ حُرَیْثٍ یَخْطُبُ یَوْمَ عَرَفَۃَ ، وَقدِ اجْتَمَعَ النَّاسُ إِلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 14474","","","كتاب الحج"
"14475","(۱۴۴۷۵) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ أَبَا وَائِلٍ وَأَصْحَابَنَا یَجْلِسُونَ یَوْمَ عَرَفَۃَ ، فَیَتَحَدَّثُونَ کَمَا یَتَحَدَّثُونَ فِی سَائِرِ الأَیَّامِ۔","","Musannaf Ibn Abi Shaybah 14475","","","كتاب الحج"
"14476","(۱۴۴۷۶) حدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ؛ أَنَّہُ رَأَی سَعِیدَ بْنَ الْمُسَیَّبِ عَشِیَّۃَ عَرَفَۃَ یُسْنِدُ ظَہْرَہُ إلَی الْمَقْصُورَۃِ ، وَیَسْتَقْبِلُ الشَّامَ حَتَّی تَغْرُبَ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 14476","","","كتاب الحج"
"14477","(۱۴۴۷۷) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ یُونُسَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرَۃَ ، قَالَ : مَا کَانَ یَشْہَدُ الْمَسْجِدَ الْجَامِعَ عَشِیَّۃَ عَرَفَۃَ ، إِلاَّ مَنْ کَانَ یَشْہَدُہُ قَبْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 14477","","","كتاب الحج"
"14478","(۱۴۴۷۸) حدَّثَنَا إِسْمَاعِیلُ بْنُ إبْرَاہِیمَ، عَنِ ابْنِ عَوْنٍ، قَالَ: کَانُوا یَسْأَلُونَ مُحَمَّدًا عَنْ إتْیَانِ الْمَسْجِدِ عَشِیَّۃَ عَرَفَۃَ؟ فَیَقُولُ: لاَ أَعْلَمُ بِہِ بَأْسًا، فَکَانَ یَقْعُدُ فِی مَنْزِلِہِ، فَکَانَ حَدِیثُہُ فِی تِلْکَ الْعَشِیَّۃِ حَدِیثَہُ فِی سَائِرِ الأَیَّامِ۔","","Musannaf Ibn Abi Shaybah 14478","","","كتاب الحج"
"14479","(۱۴۴۷۹) حدَّثَنَا ابْنُ مَہْدِی ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، قَالَ : سَأَلْتُہمَا عَنِ الاجْتِمَاعِ عَشِیَّۃَ عَرَفَۃَ ؟ فَقَالاَ : مُحْدَثٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14479","","","كتاب الحج"
"14480","(۱۴۴۸۰) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ سُئِلَ عَنِ التَّعْرِیفِ ؟ فَقَالَ : إِنَّمَا التَّعْرِیفُ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14480","","","كتاب الحج"
"14481","(۱۴۴۸۱) حدَّثَنَا وَکِیعٌ ، عَنْ بُکَیْرِ بْنِ عَامِرٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْمُعَرَّفُ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14481","","","كتاب الحج"
"14482","(۱۴۴۸۲) حدَّثَنَا وَکِیعٌ ، عَنِ ابن یَزِیدَ ، عَنِ الشعبی ، قَالَ : إِنَّمَا الْمُعَرَّفُ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14482","","","كتاب الحج"
"14483","(۱۴۴۸۳) حدَّثَنَا شَرِیکٌ ، عَنْ زُبَیْدٍ ، قَالَ : مَا کُنَّا نُعَرِّفُ إِلاَّ فِی مَسَاجِدِنَا۔","No Data Available","Musannaf Ibn Abi Shaybah 14483","","","كتاب الحج"
"14484","(۱۴۴۸۴) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ الأَزْرَقِ ، عَنْ أَبِی عُمَرَ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : إِنَّمَا الْمُعَرَّفُ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14484","","","كتاب الحج"
"14485","(۱۴۴۸۵) حدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، عَنْ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنَّ أَحَقَّ مَا لَزِمَتِ الرِّجَالُ بُیُوتَہَا یَوْمَ عَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 14485","","","كتاب الحج"
"14486","(۱۴۴۸۶) حدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ سَوَّارٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ سِیرِینَ ، قَالَ : لَقَدْ رَأَیْتُنَا زَمَانَ زِیَادٍ وَمَا نُنْکِرُ عَشِیَّۃَ عَرَفَۃَ مِنْ سَائِرِ الْعَشِیَّاتِ۔","","Musannaf Ibn Abi Shaybah 14486","","","كتاب الحج"
"14487","(۱۴۴۸۷) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَالْحَکَمِ ، قَالاَ : الْمُعَرَّفُ بِدْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 14487","","","كتاب الحج"
"14488","(۱۴۴۸۸) حدَّثَنَا ہُشَیْمٌ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَانَا لاَ یَشْہَدَانِ الْمَسْجِدَ عَشِیَّۃَ عَرَفَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14488","","","كتاب الحج"
"14489","(۱۴۴۸۹) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ وَبَرَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَرِہَ زِیَارَۃَ الْبَیْتِ أَیَّامَ التَّشْرِیقِ ، یَعْنِی بَعْدَ الْوَاجِبِ۔","","Musannaf Ibn Abi Shaybah 14489","","","كتاب الحج"
"14490","(۱۴۴۹۰) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا زُرْتَ الْبَیْتَ یَوْمَ النَّحْرِ ، فَلاَ تَعُدْ إلَیْہِ حَتَّی تَنْفِرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14490","","","كتاب الحج"
"14491","(۱۴۴۹۱) حدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَرِہَ زِیَارَتَہُ أَیَّامَ التَّشْرِیقِ ، یَعْنِی بَعْدَ الْوَاجِبِ۔","","Musannaf Ibn Abi Shaybah 14491","","","كتاب الحج"
"14492","(۱۴۴۹۲) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُفِیضُ کُلَّ لَیْلَۃٍ۔","","Musannaf Ibn Abi Shaybah 14492","","","كتاب الحج"
"14493","(۱۴۴۹۳) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَأْتِی الْبَیْتَ أَیَّامَ التَّشْرِیقِ ، وَلَمْ یَکُنْ أَحَدٌ یَفْعَلُہُ۔","","Musannaf Ibn Abi Shaybah 14493","","","كتاب الحج"
"14494","(۱۴۴۹۴) حدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ زُرْتَ الْبَیْتَ أَیَّامَ التَّشْرِیقِ کُلَّ یَوْمٍ، فَہُوَ أَفْضَلُ۔","","Musannaf Ibn Abi Shaybah 14494","","","كتاب الحج"
"14495","(۱۴۴۹۵) حدَّثَنَا أَبُو خَالِدٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَخْبَرَنِی أَبُو طَلْحَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَنَ بَیْنَ الْحَجِّ وَالْعُمْرَۃِ۔ (احمد ۴/۲۸۔ ابویعلی ۱۴۱۲)","","Musannaf Ibn Abi Shaybah 14495","","","كتاب الحج"
"14496","(۱۴۴۹۶) حدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ الْبَطِینِ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ، عَنْ مَرْوَانَ بْنِ الْحَکَمِ ، قَالَ : کُنَّا نَسِیرُ مَعَ عُثْمَانَ ، فَسَمِعَ رَجُلاً یُلَبِّی بِہِمَا جَمِیعًا ، فَقَالَ عُثْمَانُ : مَنْ ہَذَا ؟ فَقَالُوا : عَلِیٌّ، قَالَ : فَأَتَاہُ عُثْمَانُ ، فَقَالَ : أَلَمْ تَعْلَمْ أَنِّی نَہَیْتُ عَنْ ہَذَا ؟ فَقَالَ : بَلَی ، وَلَکِنْ لَمْ أَکُنْ لأَدَعَ فِعْلَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِقَوْلِکَ۔ (بخاری ۱۵۶۳۔ احمد ۱/۱۳۵)","Sahih","Musannaf Ibn Abi Shaybah 14496","","","كتاب الحج"
"14497","(۱۴۴۹۷) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : خَرَجْنَا حُجَّاجًا وَمَعَنَا الصُّبَیُّ بْنُ مَعْبَدٍ ، قَالَ : فَأَحْرَمَ بِالْحَجِّ وَالْعُمْرَۃِ ، قَالَ : فَقَدِمْنَا عَلَی عُمَرَ فَذَکَرَ ذَلِکَ لَہُ ، فَقَالَ : ہُدِیتَ لِسُنَّۃِ نَبِیِّکَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابوداؤد ۱۷۹۵۔ احمد ۱/۲۵)","","Musannaf Ibn Abi Shaybah 14497","","","كتاب الحج"
"14498","(۱۴۴۹۸) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدَۃَ بْنِ أَبِی لُبَابَۃَ ، عَنْ شَقِیقِ بْنِ سَلَمَۃَ ، عَنِ الصُّبَیِّ بْنِ مَعْبَدٍ ، عَنْ عُمَرَ ؛ بِمِثْلِہِ۔ (ابن ماجہ ۲۹۷۰۔ احمد ۱/۲۵)","Sahih","Musannaf Ibn Abi Shaybah 14498","","","كتاب الحج"
"14499","(۱۴۴۹۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ شَقِیقٍ ، عَنِ الصُّبَیِّ بْنِ مَعْبَدٍ ، عَنْ عُمَرَ ؛ بِمِثْلِہِ۔ (احمد ۱/۳۷۔ طیالسی ۵۸)","Sahih","Musannaf Ibn Abi Shaybah 14499","","","كتاب الحج"
"14500","(۱۴۵۰۰) حدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی عِمْرَانَ ، قَالَ : حجَجْتُ مَعَ مَوْلاَی ، فَدَخَلْتُ عَلَی أُمِّ سَلَمَۃَ ، فَقَالَتْ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : یَا آلَ مُحَمَّدٍ ، أَہِلَّوا بِعُمْرَۃٍ وَحَجٍّ۔ (احمد ۶/۲۹۷۔ ابویعلی ۷۰۱۱)","Sahih","Musannaf Ibn Abi Shaybah 14500","","","كتاب الحج"
"14501","(۱۴۵۰۱) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَرَنَ بَیْنَ الْحَجِّ وَالْعُمْرَۃِ ، وَطَافَ لَہمَا طَوَافًا وَاحِدًا۔ (ترمذی ۹۴۷۔ احمد ۳/۳۸۱)","","Musannaf Ibn Abi Shaybah 14501","","","كتاب الحج"
"14502","(۱۴۵۰۲) حدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، قَالَ : حدَّثَنِی حُمَیْدُ بْنُ ہِلاَلٍ ، قَالَ: سَمِعْتُ مُطَرِّفَ بْنَ عَبْدِ اللہِ یَقُولُ : حدَّثَنِی عِمْرَانُ بْنُ حُصَیْنٍ ، قَالَ : جَمَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَ الْحَجِّ وَالْعُمْرَۃِ ، ثُمَّ لَمْ یَنْہَ عَنْہُ ، وَلَمْ یَنْزِلْ کِتَابٌ یُحَرِّمْہ۔ (مسلم ۱۶۸۔ احمد ۴/۴۲۸)","Sahih","Musannaf Ibn Abi Shaybah 14502","","","كتاب الحج"
"14503","(۱۴۵۰۳) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی أَسْمَائَ ، عَنْ أَنَسٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُلَبِّی بِہِمَا جَمِیعًا : لَبَّیْکَ بِحَجَّۃٍ وَعُمْرَۃٍ ، مَعًا۔ (بخاری ۱۵۵۱۔ ابوداؤد ۱۷۹۲)","Da'if","Musannaf Ibn Abi Shaybah 14503","","","كتاب الحج"
"14504","(۱۴۵۰۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، عَنْ أَنَسٍ ؛ أَنَّہُ سَمِعَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لَبَّیْکَ بِعُمْرَۃٍ وَحَجٍّ۔ (مسلم ۲۱۴۔ ابوداؤد ۱۷۹۲)","Sahih","Musannaf Ibn Abi Shaybah 14504","","","كتاب الحج"
"14505","(۱۴۵۰۵) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ أَبِی قَتَادَۃَ یَقُولُ : إِنَّمَا قَرَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لأَنَّہُ أُخْبِرَ أَنَّہُ لَیْسَ بِحَاجٍّ بَعْدَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 14505","","","كتاب الحج"
"14506","(۱۴۵۰۶) حدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ عَلِیِّ بْنِ زَیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : سَمِعْتُ أَصْحَابَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، یُلَبُّونَ بِعُمْرَۃٍ وَحَجَّۃٍ مَعًا۔","Da'if","Musannaf Ibn Abi Shaybah 14506","","","كتاب الحج"
"14507","(۱۴۵۰۷) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ کَثِیرِ بْنِ جُمْہَانَ ، قَالَ : خَرَجْنَا حُجَّاجًا وَمَعَنَا رَجُلٌ مِنْ أَہْلِ الْجَبَلِ لَمْ یَحُجَّ قَطُّ ، فَأَہَلَّ بِحَجَّۃٍ وَعُمْرَۃٍ ، فَعَابَ ذَلِکَ عَلَیْہِ أَصْحَابُنَا ، قَالَ : فَنَزَلْنَا قَرِیبًا مِنِ ابْنِ عُمَرَ ، قَالَ : فَقُلْنَا لَہُ : إِنَّ مَعَنَا رَجُلاً مِنْ أَہْلِ الْجَبَلِ لَمْ یَحُجَّ قَطُّ ، فَأَہَلَّ بِحَجَّۃٍ وَعُمْرَۃٍ ، فَعَابَ ذَلِکَ عَلَیْہِ أَصْحَابُنَا ، فَمَا کَفَّارَتہُ ؟ قَالَ : کَفَّارَتُہُ أَنْ یَرْجِعَ بِأَجْرَیْنِ وَتَرْجِعُونَ بِوَاحِدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 14507","","","كتاب الحج"
"14508","(۱۴۵۰۸) حدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ حُمَیْدٍ، عَنْ أَنَسٍ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: لَبَّیْکَ بِعُمْرَۃٍ وَحَجَّۃٍ، مَعًا۔n(ابوداؤد ۱۷۹۲۔ نسائی ۳۷۰۹)","Sahih","Musannaf Ibn Abi Shaybah 14508","","","كتاب الحج"
"14509","(۱۴۵۰۹) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ حُمَیْدٍ ، وَمُصْعَب ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَبَّیْکَ بِعُمْرَۃٍ وَحَجَّۃٍ۔ (احمد ۳/۱۱۱۔ حمیدی ۱۲۱۵)","Sahih","Musannaf Ibn Abi Shaybah 14509","","","كتاب الحج"
"14510","(۱۴۵۱۰) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : خَرَجْنَا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ نُرَی إِلاَّ الْحَجَّ۔ (بخاری ۲۹۴۔ مسلم ۱۱۹)","Sahih","Musannaf Ibn Abi Shaybah 14510","","","كتاب الحج"
"14511","(۱۴۵۱۱) حدَّثَنَا وَکِیعٌ ، عَنِ الأَفْلَحِ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، قَالَتْ : خَرَجْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُہِلِّینَ بِالْحَجِّ۔ (بخاری ۱۵۶۰۔ احمد ۶/۲۰۷)","Sahih","Musannaf Ibn Abi Shaybah 14511","","","كتاب الحج"
"14512","(۱۴۵۱۲) حدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أَفْرَدَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْحَجَّ بَعْدَہُ أَرْبَعِینَ سَنَۃً ، وَہُمْ کَانُوا لِسُنَّتِہِ أَشَدَّ اتِّبَاعًا ، أَبُو بَکْرٍ ، وَعُمَرُ ، وَعُثْمَانَ۔","","Musannaf Ibn Abi Shaybah 14512","","","كتاب الحج"
"14513","(۱۴۵۱۳) حدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، وَسُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا بَکْرٍ ، وَعُمَرَ جَرَّدَا ، زَادَ سُفْیَانُ : وَعُثْمَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 14513","","","كتاب الحج"
"14514","(۱۴۵۱۴) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، قَالَ : أَفْرَدَ الْحَجَّ أَبُو بَکْرٍ ، وَعُمَرُ ، وَعُثْمَانَ ، وَعَلْقَمَۃُ ، وَالأَسْوَدُ۔","","Musannaf Ibn Abi Shaybah 14514","","","كتاب الحج"
"14515","(۱۴۵۱۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَأَلَتُ سُلَیْمَانَ بْنَ یَسَارٍ عَنِ الْجَمْعِ بَیْنَ الْحَجِّ وَالْعُمْرَۃِ ؟ فَقَالَ : لاَ نُحِبُّ أَنْ نَخْلِطَ بِحَجِّنَا شَیْئًا۔","","Musannaf Ibn Abi Shaybah 14515","","","كتاب الحج"
"14516","(۱۴۵۱۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ ابْنُ الزُّبَیْرِ : أَفْرِدُوا الْحَجَّ ، وَدَعُوْا قَوْلَ أَعْمَاکُمْ ہَذَا ، یَعْنِی ابْنَ عَبَّاسٍ۔","Da'if","Musannaf Ibn Abi Shaybah 14516","","","كتاب الحج"
"14517","(۱۴۵۱۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ القِرَانَ وَالْمُتْعَۃَ ، وَقَالَ : التَّجْرِیدُ أَحَبُّ إِلَیَّ۔","","Musannaf Ibn Abi Shaybah 14517","","","كتاب الحج"
"14518","(۱۴۵۱۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ صَالِحٍ الْعُکْلِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : التَّجْرِیدُ أَحَبُّ إِلَیَّ۔","","Musannaf Ibn Abi Shaybah 14518","","","كتاب الحج"
"14519","(۱۴۵۱۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ عُبَیْدِ اللہِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، عَنْ عُمَرَ؛ أَنَّہُ حَجّ خِلاَفَتَہُ کُلَّہَا یُفْرِدُ الْحَجَّ۔","Sahih","Musannaf Ibn Abi Shaybah 14519","","","كتاب الحج"
"14520","(۱۴۵۲۰) حدَّثَنَا إِسْمَاعِیلُ بْنُ إِبْرَاہِیمَ، عَن أَبِی حَمْزَۃَ، عَنْ إِبْرَاہِیمَ، عَنِ الأَسْوَدِ، قَالَ: قَالَ عَبْدُ اللہِ بْنُ مَسْعُودٍ: نُسُکَانِ أَحَبُّ إلَیَّ أَنْ یَکُونَ لِکُلِّ وَاحِدٍ مِنْہُمَا شَعَثٌ وَسَفَرٌ ، قَالَ : فَسَافَرَ الأَسْوَدُ ثَمَانِینَ مَا بَیْنَ حَجَّۃٍ وَعُمْرَۃٍ ، لَمْ یَجْمَعْ بَیْنَہُمَا ، وَسَافَرَ عَبْدُ الرَّحْمَنِ بْنُ الأَسْوَدِ سِتِّینَ مَا بَیْنَ حَجَّۃٍ وَعُمْرَۃٍ ، لَمْ یَجْمَعْ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 14520","","","كتاب الحج"
"14521","(۱۴۵۲۱) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی إِسْمَاعِیلَ ، قَالَ : خَرَجْتُ مَعَ إِبْرَاہِیمَ وَمَعَنَا أَصْحَابٌ لَنَا، فَأَحْرَمُوا جَمِیعًا وَجَرَّدُوا الْحَجَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 14521","","","كتاب الحج"
"14522","(۱۴۵۲۲) حدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ مَنْصُورِ بْنِ زَاذَانَ ، عَنِ الْحَکَمِ ، عَنْ زِیَادِ بْنِ مَالِکٍ ؛ أَنَّ عَلِیًّا ، وَابْنَ مَسْعُودٍ ، قَالاَ فِی الْقَارِنِ : یَطُوفُ طَوَافَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 14522","","","كتاب الحج"
"14523","(۱۴۵۲۳) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عَمْرِو بْنِ الأَسْوَدِ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ ، قَالَ : إِذَا قَرَنْتَ بَیْنَ الْحَجِّ وَالْعُمْرَۃِ ، فَطُفْ طَوَافَیْنِ ، وَاسْعَ سَعْیَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 14523","","","كتاب الحج"
"14524","(۱۴۵۲۴) حدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ (ح) وَعَنْ إِسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالاَ : یَطُوفُ طَوَافَیْنِ ، وَیَسْعَی سَعْیَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14524","","","كتاب الحج"
"14525","(۱۴۵۲۵) حدَّثَنَا حَفْصٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : الْقَارِنُ یَطُوفُ طَوَافَیْنِ ، وَیَسْعَی سَعْیَیْنِ۔","","Musannaf Ibn Abi Shaybah 14525","","","كتاب الحج"
"14526","(۱۴۵۲۶) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنْ عَبْدِالرَّحْمَنِ بْنِ الأَسْوَدِ، عَنْ أَبِیہِ، قَالَ: الْقَارِنُ یَطُوفُ طَوَافَیْنِ۔","","Musannaf Ibn Abi Shaybah 14526","","","كتاب الحج"
"14527","(۱۴۵۲۷) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الْقَارِنِ ؟ فَقَالاَ : یَطُوفُ طَوَافَیْنِ ، وَیَسْعَی سَعْیَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14527","","","كتاب الحج"
"14528","(۱۴۵۲۸) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْقَارِنِ ، قَالَ : طَوَافَانِ ، وَسَعْیَانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14528","","","كتاب الحج"
"14529","(۱۴۵۲۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ طَافَ لَہُمَا طَوَافًا وَاحِدًا۔","","Musannaf Ibn Abi Shaybah 14529","","","كتاب الحج"
"14530","(۱۴۵۳۰) حدَّثَنَا یَحْیَی بْنُ أَبِی سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ طَاوُوسٍ ، قَالَ : حَلَفَ لِی أَنَّہُ لَمْ یَطُفْ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْحَجِّ وَالْعُمْرَۃِ ، إِلاَّ طَوَافًا وَاحِدًا۔","","Musannaf Ibn Abi Shaybah 14530","","","كتاب الحج"
"14531","(۱۴۵۳۱) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا جَمَعَ بَیْنَ الْحَجِّ وَالْعُمْرَۃِ فَطَوَافٌ وَاحِدٌ ، وَسَعْیٌ وَاحِدٌ ، وَإِذَا قَرَنَ فَطَوَافَانِ وَسَعْیَانِ۔","","Musannaf Ibn Abi Shaybah 14531","","","كتاب الحج"
"14532","(۱۴۵۳۲) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ الْمُزَنِیّ ، عَنْ سَالِمٍ ، قَالَ : إِذَا جَمَعَ بَیْنَ الْحَجِّ وَالْعُمْرَۃِ ، فَعَلَیْہِ طَوَافٌ وَاحِدٌ ، وَسَعْیٌ وَاحِدٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14532","","","كتاب الحج"
"14533","(۱۴۵۳۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یُجْزِئہ طَوَافٌ۔","","Musannaf Ibn Abi Shaybah 14533","","","كتاب الحج"
"14534","(۱۴۵۳۴) حدَّثَنَا ابْنُ أَبِی غَنِیۃ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ مُجَاہِدٍ ، قَالَ : إِذَا قَدِمْتَ قَارِنًا ، أَوْ مُتَمَتِّعًا فَیَکْفِیکَ سَعْیٌ وَاحِدٌ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، فَإِنْ کُنْتَ سَاعِیًا ثَانِیًا ، فَأَخِّرْ ذَلِکَ إِلَی یَوْمِ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 14534","","","كتاب الحج"
"14535","(۱۴۵۳۵) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ طَافَ لَہُمَا طَوَافًا وَاحِدًا۔","Sahih","Musannaf Ibn Abi Shaybah 14535","","","كتاب الحج"
"14536","(۱۴۵۳۶) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ (ح) وَعَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالاَ : یَطُوفُ طَوَافًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14536","","","كتاب الحج"
"14537","(۱۴۵۳۷) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ (ح) وَعَنْ ہِشَامٍ عَنِ الْحَسَنِ قَالاَ : یَطُوفُ طَوَافًا۔","","Musannaf Ibn Abi Shaybah 14537","","","كتاب الحج"
"14538","(۱۴۵۳۸) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، وَعَطَائٍ ، وَطَاوُوسٍ قَالُوا : یَطُوفُ الْقَارِنُ طَوَافًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14538","","","كتاب الحج"
"14539","(۱۴۵۳۹) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا کَانَ یَنْہَی النِّسَائَ عَنِ النِّقَابِ وَہُنَّ حُرُمٌ ، وَلَکِنْ یُسْدِلْنَ الثَّوْبَ عَلَی وُجُوہِہِنَّ سَدْلاً۔","","Musannaf Ibn Abi Shaybah 14539","","","كتاب الحج"
"14540","(۱۴۵۴۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : تَرُدُّ الْمَرْأَۃُ الْمُحْرِمَۃُ الثَّوْبَ عَلَی وَجْہِہَا ، وَلاَ تَنْتَقِبُ۔","","Musannaf Ibn Abi Shaybah 14540","","","كتاب الحج"
"14541","(۱۴۵۴۱) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَحْیَی ، وَعُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ تَنْتَقِبُ الْمُحْرِمَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 14541","","","كتاب الحج"
"14542","(۱۴۵۴۲) حدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أُمِّ شَبِیبٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَرِہَتِ النِّقَابَ لِلْمُحْرِمَۃِ وَالْکُحْلَ ، وَرَخَّصَتْ فِی الْخُفَّیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 14542","","","كتاب الحج"
"14543","(۱۴۵۴۳) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَکْرَہُ لِلْمُحْرِمَۃِ النِّقَابَ وَالْقُفَّازَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 14543","","","كتاب الحج"
"14544","(۱۴۵۴۴) حدَّثَنَا الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : لاَ تَنْتَقِبُ۔","","Musannaf Ibn Abi Shaybah 14544","","","كتاب الحج"
"14545","(۱۴۵۴۵) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ النِّقَابِ لِلْمُحْرِمَۃِ ؟ فَکَرِہَاہُ وَقَالاَ : تُخْرِجُ وَجْہَہَا لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 14545","","","كتاب الحج"
"14546","(۱۴۵۴۶) حدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنْہُ ، یَعْنِی النِّقَابَ۔","Hasan","Musannaf Ibn Abi Shaybah 14546","","","كتاب الحج"
"14547","(۱۴۵۴۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : وَقَفَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عِنْدَ الْجَمْرَۃِ الثَّانِیَۃِ ، أَطْوَلَ مِمَّا وَقَفَ عِنْدَ الْجَمْرَۃِ الأُولَی ، ثُمَّ أَتَی جَمْرَۃَ الْعَقَبَۃِ فَرَمَاہَا ، وَلَمْ یَقِفْ عِنْدَہَا۔","","Musannaf Ibn Abi Shaybah 14547","","","كتاب الحج"
"14548","(۱۴۵۴۸) حدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَنْ مُحَمَّدِ بْنِ الأَسْوَدِ بْنِ خَلَفٍ ، قَالَ : أَدْرَکْتُ النَّاسَ یَتَزَوَّدُونَ الْمَائَ إِذَا ذَہَبُوا یَرْمُونَ الْجِمَارَ ، مِنْ طُولِ الْقِیَامِ عِنْدَ الْجَمْرَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 14548","","","كتاب الحج"
"14549","(۱۴۵۴۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنْ ابْنِ عَبَّاسٍ ؛ أَنَّہُ وَقَفَ مَعَ ابْنِ عَبَّاسٍ قَدْرَ سُورَۃٍ مِنَ السَّبْعِ ، قَالَ : قُلْتُ : مِنَ النَّاسِ مَنْ یُبَطِء الْقِرَائَۃَ وَمِنْہُمْ مَنْ یُسْرِعُ ؟ قَالَ : مِثْلَ قِرَائَتِی ؟ قَالَ : قُلْتُ : أَنْتَ خَفِیفُ الْقِرَائَۃِ ، قَالَ : مِثْلَ قِرَائَتِی۔","","Musannaf Ibn Abi Shaybah 14549","","","كتاب الحج"
"14550","(۱۴۵۵۰) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی عَلِیٌّ الأَزْدِیُّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : بِمِثْلِ حَدِیثِ عَبْدِ اللہِ إِیَّایَ۔","Hasan","Musannaf Ibn Abi Shaybah 14550","","","كتاب الحج"
"14551","(۱۴۵۵۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، قَالَ : وَقَفْت مَعَ عَمْرِو بْنِ شُعَیْبٍ ، وَعَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ فَلَمْ یُطِیلاَ ، وَوَقَفْتُ مَعَ عَطَائٍ قَدْرَ سُورَۃِ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 14551","","","كتاب الحج"
"14552","(۱۴۵۵۲) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ ، وَإِبْرَاہِیمَ ، وَطَاوُوسًا ، وَعَامِرَ بْنَ عَبْدِ اللہِ بْنِ الزُّبَیْرِ یُطِیلُونَ الْقِیَامَ عِنْدَ الْجِمَارِ۔","","Musannaf Ibn Abi Shaybah 14552","","","كتاب الحج"
"14553","(۱۴۵۵۳) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَقُومُ عِنْدَ الْجَمْرَتَیْنِ مِقْدَارَ مَا یَقْرَأُ الرَّجُلُ سُورَۃَ الْبَقَرَۃِ۔","","Musannaf Ibn Abi Shaybah 14553","","","كتاب الحج"
"14554","(۱۴۵۵۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَقِفُ عِنْدَ الْجَمْرَۃِ مِقْدَارَ مَا یَقْرَأُ الرَّجُلُ سُورَۃَ الْبَقَرَۃِ۔","","Musannaf Ibn Abi Shaybah 14554","","","كتاب الحج"
"14555","(۱۴۵۵۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ؛ أَنَّ عَطَائً وَقَفَ عِنْدَالْجَمْرَۃِ مِقْدَارَ مَا یَقْرَأُ الرَّجُلُ السُّورَۃَ مِنَ الْمِئِینَ۔","","Musannaf Ibn Abi Shaybah 14555","","","كتاب الحج"
"14556","(۱۴۵۵۶) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ ؛ أَنَّہُمَا کَرِہَا أَنْ یُخْرَجَ مِنْ تُرَابِ الْحَرَمِ إلَی الْحِلِّ ، أَوْ یُدْخَلَ مِنْ تُرَابِ الْحِلِّ إلَی الْحَرَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 14556","","","كتاب الحج"
"14557","(۱۴۵۵۷) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ أَبِی الْفُرَاتِ الْمَکِّیُّ ، عَنْ أَبِیہِ ؛ أَنْ ابْنَ الزُّبَیْرِ لَمَّا ہَدَمَ الْکَعْبَۃَ فَبَنَاہَا ، کَرِہَ أَنْ یَبْنِیَ فِیہَا مِنْ تُرَابِ الْحِلِّ۔","Da'if","Musannaf Ibn Abi Shaybah 14557","","","كتاب الحج"
"14558","(۱۴۵۵۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ مُسلِمٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ؛ أَنَّہُمَا کَرِہَاہُ ، یَعنی أَنْ یُخْرَجَ بِتُرَابِ الْحَرَمِ إلَی الْحِلِّ۔","","Musannaf Ibn Abi Shaybah 14558","","","كتاب الحج"
"14559","(۱۴۵۵۹) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ قَالُوا : لاَ تَطُفْ بِالْبَیْتِ إِلاَّ وَأَنْتَ عَلَی وُضُوئٍ۔","","Musannaf Ibn Abi Shaybah 14559","","","كتاب الحج"
"14560","(۱۴۵۶۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَقْضِی شَیْئًا مِنَ الْمَنَاسِکِ إِلاَّ وَہُوَ مُتَوَضِّیئٌ۔","Sahih","Musannaf Ibn Abi Shaybah 14560","","","كتاب الحج"
"14561","(۱۴۵۶۱) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ الرَّبِیعِ ، عَنْ عَطَائٍ ، وَالْحَسَنِ ؛ أَنَّہُمَا کَرِہَا أَنْ یَطُوفَ الرَّجُلُ عَلَی غَیْرِ طَہَارَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14561","","","كتاب الحج"
"14562","(۱۴۵۶۲) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الحَکَم ، وَحَمَّادًا ، وَمَنْصُورًا ، وَسُلَیْمَانَ عَنِ الرَّجُلِ یَطُوفُ بِالْبَیْتِ عَلَی غَیْرِ طَہَارَۃٍ ؟ فَلَمْ یَرَوْا بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 14562","","","كتاب الحج"
"14563","(۱۴۵۶۳) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا لَمْ یَرَیَا بَأْسًا أَنْ یَطُوفَ الرَّجُلُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ عَلَی غَیْرِ وُضُوئٍ ، وَکَانَ الْوُضُوئُ أَحَبَّ إلَیْہِمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 14563","","","كتاب الحج"
"14564","(۱۴۵۶۴) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا أَحْرَمَ الرَّجُلُ وَعَلَیْہِ قَمِیصٌ فَلاَ یَنْزِعُہُ مِنْ رَأْسِہِ ، یَشُقُّہُ ، ثُمَّ یَخْرُجُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 14564","","","كتاب الحج"
"14565","(۱۴۵۶۵) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَیُونُسَ ، عَنِ الْحَسَنِ (ح) وَمُغِیرَۃَ وَحُصَیْنٍ ، عَنِ الشَّعْبِیِّ قَالُوا : یَخْرِقُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14565","","","كتاب الحج"
"14566","(۱۴۵۶۶) حدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدٍ (ح) وَعَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَنْ أَبِی صَالِحٍ قَالَ : إذَا أَحْرَمَ وَعَلَیْہِ قَمِیصٌ فَلْیَشُقَّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14566","","","كتاب الحج"
"14567","(۱۴۵۶۷) حدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عَاصِمٍ ، عَنْ وَاصِلٍ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : یَشُقُّہُ۔","","Musannaf Ibn Abi Shaybah 14567","","","كتاب الحج"
"14568","(۱۴۵۶۸) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : یَخْلَعُہُ مِنْ قِبَلِ رِجْلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14568","","","كتاب الحج"
"14569","(۱۴۵۶۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَقُولُ : مَنْ أَحْرَمَ وَعَلَیْہِ قَمِیصٌ فَلْیَنْزِعْہُ ، وَلاَ یَشُقَّہُ۔","","Musannaf Ibn Abi Shaybah 14569","","","كتاب الحج"
"14570","(۱۴۵۷۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ عَطَائٍ ، قَالَ : یَنْزِعُہُ۔","","Musannaf Ibn Abi Shaybah 14570","","","كتاب الحج"
"14571","(۱۴۵۷۱) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ ہَمَّامٍ ، عَنْ عَطَائٍ ، عَنْ صَفْوَانَ بْنِ یَعْلَی ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اخْلَعْہَا ، وَاصْنَعْ فِی عُمْرَتِکَ مَا کُنْت صَانِعًا فِی حَجِّکَ ، یَعْنِی جُبَّۃٌ کَانَتْ عَلَیْہِ۔n(بخاری ۱۷۸۹۔ مسلم ۱۰)","Sahih","Musannaf Ibn Abi Shaybah 14571","","","كتاب الحج"
"14572","(۱۴۵۷۲) حدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَنْزِعُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14572","","","كتاب الحج"
"14573","حدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ ، قَالَ :n(۱۴۵۷۳) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَہَا ، وَکَانَتْ حَائِضًا : أَنْ تَقْضِیَ الْمَنَاسِکَ کُلَّہَا غَیْرَ أَنَّہَا لاَ تَطُوفُ بِالْبَیْتِ۔","Sahih","Musannaf Ibn Abi Shaybah 14573","","","كتاب الحج"
"14574","(۱۴۵۷۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : تَقْضِی الْحَائِضُ الْمَنَاسِکَ کُلَّہَا ، إِلاَّ الطَّوَافَ بِالْبَیْتِ۔n(ترمذی ۹۴۵۔ احمد ۶/۱۳۷)","Da'if","Musannaf Ibn Abi Shaybah 14574","","","كتاب الحج"
"14575","(۱۴۵۷۵) حدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ یَحْیَی بْنِ بِشْرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : تَقْضِی الْحَائِضُ الْمَنَاسِکَ کُلَّہَا ، إِلاَّ الطَّوَافَ بِالْبَیْتِ ، وتَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","","Musannaf Ibn Abi Shaybah 14575","","","كتاب الحج"
"14576","(۱۴۵۷۶) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : تَقْضِی الْحَائِضُ الْمَنَاسِکَ کُلَّہَا ، إِلاَّ الطَّوَافَ بِالْبَیْتِ وَبَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 14576","","","كتاب الحج"
"14577","(۱۴۵۷۷) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، قَالَ : قُلْتُ لأَبِی الْعَالِیَۃِ : تَقْرَأُ الْحَائِضُ الْقُرْآنَ ؟ قَالَ : لاَ تَقْرَأُ الْقُرْآنَ ، وَلاَ تُصَلِّی ، وَلاَ تَطُوفُ بِالْبَیْتِ ، وَلاَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، وَقَالَ : الطَّوَافُ بَیْنَ الصَّفَا وَالْمَرْوَۃِ عَدْلُ الطَّوَافِ بِالْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 14577","","","كتاب الحج"
"14578","(۱۴۵۷۸) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَقْضِی الْحَائِضُ الْمَنَاسِکَ کُلَّہَا ، غَیْرَ الطَّوَافِ۔","","Musannaf Ibn Abi Shaybah 14578","","","كتاب الحج"
"14579","(۱۴۵۷۹) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی الْمُنِیبِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : تَقْضِی الْمَنَاسِکَ کُلَّہَا ، إِلاَّ الطَّوَافَ بِالْبَیْتِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14579","","","كتاب الحج"
"14580","(۱۴۵۸۰) حدَّثَنَا وَکِیعٌ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : سَمِعْتُہُ یَقُولُ : تَقِفُ بِعَرَفَۃَ وَتَقْضِی الْمَنَاسِکَ کُلَّہَا ، إِلاَّ الطَّوَافَ بِالْبَیْتِ۔","Hasan","Musannaf Ibn Abi Shaybah 14580","","","كتاب الحج"
"14581","(۱۴۵۸۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ ہَانِیئٍ ، عَنْ حُسَیْنِ بْنِ عَلِیٍّ ، قَالَ : تَقْضِی الْحَائِضُ الْمَنَاسِکَ کُلَّہَا ، إِلاَّ الطَّوَافَ بِالْبَیْتِ۔","Da'if","Musannaf Ibn Abi Shaybah 14581","","","كتاب الحج"
"14582","(۱۴۵۸۲) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ طَارِقٍ ، قَالَ : طَافَتِ امْرَأَتِی وَصَلَّتْ رَکْعَتَیْنِ ، ثُمَّ حَاضَتْ قَبْلَ أَنْ تَطُوفَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، فَأَمَرْتُہَا أَنْ تَطُوفَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، فَسَمِعَتْنِی امْرَأَۃٌ وَأَنَا آمُرُہَا بِذَلِکَ ، فَقَالَتْ : نِعْمَ مَا أَمَرَتْہَا بِہِ ، کَانَتْ عَمَّتِی وَخَالَتِی عَائِشَۃُ ، وَأُمُّ سَلَمَۃَ ، زَوْجَتَا النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَقُولاَنِ : إذَا طَافَتِ الْمَرْأَۃُ بِالْبَیْتِ ، ثُمَّ صَلَّتْ رَکْعَتَیْنِ ، ثُمَّ حَاضَتْ ، فَلْتَطُفْ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 14582","","","كتاب الحج"
"14583","(۱۴۵۸۳) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا طَافَتْ بِالْبَیْتِ، ثُمَّ حَاضَتْ قَبْلَ أَنْ تَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، فَلْتَسْعَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 14583","","","كتاب الحج"
"14584","(۱۴۵۸۴) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، قَالَ : سَأَلْتُ عَطَائً عَنِ امْرَأَۃٍ طَافَتْ بِالْبَیْتِ ، ثُمَّ حَاضَتْ ؟ قَالَ : تَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14584","","","كتاب الحج"
"14585","(۱۴۵۸۵) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ قَالاَ : تَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14585","","","كتاب الحج"
"14586","(۱۴۵۸۶) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ (ح) وَعَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ قَالُوا : تَسْعَی بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14586","","","كتاب الحج"
"14587","(۱۴۵۸۷) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا أَتَی الْبَیْتَ یَوْمَ النَّحْرِ طَافَ طَوَافًا وَاحِدًا ، ثُمَّ أَتَی مَنْزِلَہُ ، فَقَالَ ، ثُمَّ أَتَی مِنًی وَلَمْ یَعُدْ إلَی الْبَیْتِ۔","Sahih","Musannaf Ibn Abi Shaybah 14587","","","كتاب الحج"
"14588","(۱۴۵۸۸) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ لَمْ یَزِدْ یَوْمَ الزِّیَارَۃِ عَلَی طَوَافٍ وَاحِدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14588","","","كتاب الحج"
"14589","(۱۴۵۸۹) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یَطُوفُوا یَوْمَ النَّحْرِ ثَلاَثَۃَ أَسَابِیعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14589","","","كتاب الحج"
"14590","(۱۴۵۹۰) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، قَالَ : طُفْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ یَوْمَ النَّحْرِ طَوَافًا وَاحِدًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14590","","","كتاب الحج"
"14591","(۱۴۵۹۱) حدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : خَرَجْتُ مَعَ الْحَسَنِ ، فَلَمَّا کَانَ یَوْمُ النَّحْرِ زُرْنَا الْبَیْتَ، فَطُفْنَا بِالْبَیْتِ طَوَافًا وَاحِدًا ، وَسَعَیْنَا بَیْنَ الصَّفَا وَالْمَرْوَۃِ ، ثُمَّ رَجَعْنَا إلَی مِنًی۔","","Musannaf Ibn Abi Shaybah 14591","","","كتاب الحج"
"14592","(۱۴۵۹۲) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ؛ أَنَّہُ کَانَ یَطُوفُ طَوَافًا وَاحِدًا یَوْمَ الزِّیَارَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14592","","","كتاب الحج"
"14593","(۱۴۵۹۳) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَفْلَحَ ، قَالَ : زُرْتُ مَعَ الْقَاسِمِ الْبَیْتَ فِی آخِرِ السَّحَرِ ، فَطُفْنَا طَوَافًا وَاحِدًا لَمَّا أَصْبَحْنَا ، ثُمَّ رَجَعْنَا إلَی مِنًی۔","","Musannaf Ibn Abi Shaybah 14593","","","كتاب الحج"
"14594","(۱۴۵۹۴) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی الظُّہْرَ بِعَرَفَاتٍ ، ثُمَّ صَلَّی الْعَصْرَ ، یَعْنِی بِعَرَفَۃَ ، وَلَمْ یُسَبِّحْ بَیْنَہُمَا شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 14594","","","كتاب الحج"
"14595","(۱۴۵۹۵) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ؛ أَنَّہُ جَمَعَ بَیْنَ الظُّہْرِ وَالْعَصْرِ بِعَرَفَاتٍ ، ثُمَّ وَقَفَ۔","Sahih","Musannaf Ibn Abi Shaybah 14595","","","كتاب الحج"
"14596","(۱۴۵۹۶) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ عَلْقَمَۃَ وَالأَسْوَدِ قَالاَ : قَالَ عَبْدُ اللہِ : لاَ یُجْمَعْ بَیْنَ الصَّلاَتَیْنِ إِلاَّ بِعَرَفَۃَ ، الظُّہْرُ وَالْعَصْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 14596","","","كتاب الحج"
"14597","(۱۴۵۹۷) حدَّثَنَا ابْنُ نُمَیْرٍ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : مِنْ سُنَّۃِ الْحَجِّ إذَا فَرَغَ مِنْ خُطْبَتِہِ نَزَلَ فَصَلَّی الظُّہْرَ وَالْعَصْرَ جَمِیعًا ، ثُمَّ یَقِفُ بِعَرَفَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 14597","","","كتاب الحج"
"14598","(۱۴۵۹۸) حدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ قَالاَ : مِنَ السُّنَّۃِ أَنْ تُجْمِعَ بَیْنَہُمَا بِعَرَفَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 14598","","","كتاب الحج"
"14599","(۱۴۵۹۹) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : صَلَّیْتُ خَلْفَ سَالِمٍ ، وَعُبَیْدِ اللہِ بِعَرَفَۃَ ، فَجَمَعَا بَیْنَ الصَّلاَتَیْنِ ، وَلَمْ یَجْہَرَا بِالْقِرَائَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14599","","","كتاب الحج"
"14600","(۱۴۶۰۰) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : یُجْمَعُ بَیْنَ الظُّہْرِ وَالْعَصْرِ بِعَرَفَۃَ۔","","Musannaf Ibn Abi Shaybah 14600","","","كتاب الحج"
"14601","(۱۴۶۰۱) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، قَالَ : یُؤَخِّرُ الإِمَامُ الظُّہْرَ یَوْمَ عَرَفَۃَ ، أَشَدَّ مَا یُؤَخِّرُہَا یَوْمًا مِنَ السَّنَۃِ ، وَیُعَجِّلُ الْعَصْرَ أَشَدَّ مَا یُعَجِّلُہَا یَوْمًا مِنَ السَّنَۃِ۔","","Musannaf Ibn Abi Shaybah 14601","","","كتاب الحج"
"14602","(۱۴۶۰۲) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : لاَ یَبِیتَنَّ أَحَدٌ مِنْ وَرَائِ الْعَقَبَۃِ لَیْلاً بِمِنًی أَیَّامَ التَّشْرِیقِ۔","Da'if","Musannaf Ibn Abi Shaybah 14602","","","كتاب الحج"
"14603","(۱۴۶۰۳) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ عُمَرَ کَانَ یَنْہَی أَنْ یَبِیتَ أَحَدٌ مِنْ وَرَائِ الْعَقَبَۃِ ، وَکَانَ یَأْمُرُہُمْ أَنْ یَدْخُلُوا مِنًی۔","Sahih","Musannaf Ibn Abi Shaybah 14603","","","كتاب الحج"
"14604","(۱۴۶۰۴) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَرِہَ أَنْ یَنَامَ أَحَدٌ أَیَّامَ مِنًی بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14604","","","كتاب الحج"
"14605","(۱۴۶۰۵) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ أَنْ یَکُونَ أَوَّلُ اللَّیْلِ بِمَکَّۃَ وَآخِرُہُ بِمِنًی ، وَلاَ بَأْسَ أَنْ یَکُونَ أَوَّلُ اللَّیْلِ بِمِنًی وَآخِرُہُ بِمَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14605","","","كتاب الحج"
"14606","(۱۴۶۰۶) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ حَسَنِ بْنِ عَبْدِ اللہِ الْمُزَنِیِّ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ کَعْبٍ یَقُولُ : مِنَ السُّنَّۃِ إذَا زُرْت الْبَیْتَ أَلاَّ تَبِیتَ إِلاَّ بِمِنًی۔","Hasan","Musannaf Ibn Abi Shaybah 14606","","","كتاب الحج"
"14607","(۱۴۶۰۷) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یُوسُفَ بْنِ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : اجْعَلُوا أَیَّامَ مِنًی بِمِنًی۔","","Musannaf Ibn Abi Shaybah 14607","","","كتاب الحج"
"14608","(۱۴۶۰۸) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ قَالَ : لاَ یَبِیتَنَّ أَحَدٌ مِنْ وَرَائِ الْعَقَبَۃِ أَیَّامَ التَّشْرِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14608","","","كتاب الحج"
"14609","(۱۴۶۰۹) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا بَاتَ دُونَ الْعَقَبَۃِ أَہْرَاقَ لِذَلِکَ دَمًا۔","","Musannaf Ibn Abi Shaybah 14609","","","كتاب الحج"
"14610","(۱۴۶۱۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : سُئِلَ عَنِ الرَّجُلِ یَبِیتُ لَیَالِیَ مِنًی بِمَکَّۃَ ؟ قَالَ : یَتَصَدَّقُ بِدِرْہَمٍ ، أَوْ نَحْوِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14610","","","كتاب الحج"
"14611","(۱۴۶۱۱) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنِی إبْرَاہِیمُ بْنُ نَافِعٍ ، قَالَ : أَخْبَرَنَا عَبْدُ اللہِ بْنُ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَرِہَ أَنْ یَبِیتَ لَیْلَۃً تَامَّۃً عَنْ مِنًی۔","","Musannaf Ibn Abi Shaybah 14611","","","كتاب الحج"
"14612","(۱۴۶۱۲) حدَّثَنَا أَبُوبَکْرٍ الْحَنَفِیُّ، عَنْ بُکَیْرِ بْنِ مِسْمَارٍ، عَنْ سَالِمٍ، قَالَ: یَتَصَدَّقُ بِدِرْہَمٍ، یَعْنِی إذَا بَاتَ عَنْ مِنًی۔","","Musannaf Ibn Abi Shaybah 14612","","","كتاب الحج"
"14613","(۱۴۶۱۳) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عمَرَ ؛ أَنَّ الْعَبَّاسَ بْنَ عَبْدِ الْمُطَّلِبِ اسْتَأْذَنَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَبِیتَ بِمَکَّۃَ لَیَالِیَ مِنًی ، فَأَذِنَ لَہُ مِنْ أَجْلِ سِقَایَتِہِ۔n(بخاری ۱۷۴۵۔ ابوداؤد ۱۹۵۴)","Sahih","Musannaf Ibn Abi Shaybah 14613","","","كتاب الحج"
"14614","(۱۴۶۱۴) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا إبْرَاہِیمُ بْنُ نَافِعٍ ، قَالَ : أَخْبَرَنَا عَمْرُو بْنُ دِینَارٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا رَمَیْتَ الْجِمَارَ فَبِتْ حَیْثُ شِئْت۔","Sahih","Musannaf Ibn Abi Shaybah 14614","","","كتاب الحج"
"14615","(۱۴۶۱۵) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا إبْرَاہِیمُ بْنُ نَافِعٍ ، قَالَ : حدَّثَنَا ابْنُ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَبِیتَ الرَّجُلُ بِمَکَّۃَ لَیَالِیَ مِنًی ، إِذَا کَانَ فِی ضَیْعَتِہِ۔","","Musannaf Ibn Abi Shaybah 14615","","","كتاب الحج"
"14616","(۱۴۶۱۶) حدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، عَنِ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ مَکَّۃَ وَعَلَیْہِ مِغْفَرٌ۔ (بخاری ۱۸۴۶۔ ابوداؤد ۲۶۷۸)","Sahih","Musannaf Ibn Abi Shaybah 14616","","","كتاب الحج"
"14617","(۱۴۶۱۷) حدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ شَبِیبِ بْنِ حَوْشَبٍ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا أَحْرَمُوا حَمَلُوا مَعَہُمُ السُّیُوفَ فِی الْقُرُبِ۔","Da'if","Musannaf Ibn Abi Shaybah 14617","","","كتاب الحج"
"14618","(۱۴۶۱۸) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَمْ یَکُونُوا یَکْرَہُونَ أَنْ یُسَافِرُوا بِالسُّیُوفِ فِی قُرُبِہَا ، وَہُمْ مُحْرِمُونَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14618","","","كتاب الحج"
"14619","(۱۴۶۱۹) حدَّثَنَا شَرِیکٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ؛ أَنَّ أَبَاہُ کَانَ یَدْخُلُ الْحَرَمَ بِسَیْفٍ۔","","Musannaf Ibn Abi Shaybah 14619","","","كتاب الحج"
"14620","(۱۴۶۲۰) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَتَقَلَّدَ الْمُحْرِمُ سَیْفَہُ إذَا خَافَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14620","","","كتاب الحج"
"14621","(۱۴۶۲۱) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ یَدْخُلُ أَحَدٌ مَکَّۃَ بِسِلاَحٍ فِی حَجٍّ ، وَلاَ عُمْرَۃٍ۔","","Musannaf Ibn Abi Shaybah 14621","","","كتاب الحج"
"14622","(۱۴۶۲۲) حدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، قَالَ : أَحْسَبُ أَنِّی سَمِعْتُ قَیْسَ بْنَ سَعْدٍ یَقُولُ : قَالَ ابْنُ عُمَرَ : الْمُحْرِمُ لاَ یَحْمِلُ السِّلاَحُ۔","","Musannaf Ibn Abi Shaybah 14622","","","كتاب الحج"
"14623","(۱۴۶۲۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ قَالاَ : لاَ یَدْخُلُ الْمُحْرِمُ بِسِلاَحٍ۔","","Musannaf Ibn Abi Shaybah 14623","","","كتاب الحج"
"14624","(۱۴۶۲۴) حدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلِ بْنِ مَرْزُوقٍ ، عَنْ عَطِیَّۃَ ، قَالَ : سَأَلْتُ مَوْلًی لابْنِ عُمَرَ عَنْ مَوْتِ ابْنِ عُمَرَ ؟ قَالَ : أَصَابَہُ رَجُلٌ مِنْ أَہْلِ الشَّامِ بِزُجٍّ ، فَدَخَلَ عَلَیْہِ الْحَجَّاجُ یَعُودُہُ ، فَقَالَ : لَوْ أَعْلَمُ مَنْ أَصَابَکَ لَفَعَلْتُ وَفَعَلْتُ ، قَالَ : أَنْتَ أَصَبْتنِی ، أَدْخَلْتَ السِّلاَحَ الْحَرَمَ۔","Da'if","Musannaf Ibn Abi Shaybah 14624","","","كتاب الحج"
"14625","(۱۴۶۲۵) حدَّثَنَا أَبُو خَالِدٍ ، وَلَیْسَ بِالأَحْمَرِ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ أَبِی السَّفَرِ ؛ أَنَّہُ دَخَلَ الْحَرَمَ وَعَلَیْہِ سَیْفٌ مُتَقَلِّدُہُ ، فَلَمَّا دَخَلَ نَزَعَہُ۔","","Musannaf Ibn Abi Shaybah 14625","","","كتاب الحج"
"14626","(۱۴۶۲۶) حدَّثَنَا وَکِیعٌ ، عَنِ الصَّلْتِ ، عَنْ عُقْبَۃَ بْنِ صَہْبَانَ ، قَالَ : رَأَیْتُ عُثْمَانَ بِالأَبْطَحِ ، وَإِنَّ فُسْطَاطَہُ مَضْرُوبٌ ، وَإِنَّ سَیْفَہُ مُعَلَّقٌ بِالْفُسْطَاطِ۔","Da'if","Musannaf Ibn Abi Shaybah 14626","","","كتاب الحج"
"14627","(۱۴۶۲۷) حدَّثَنَا وَکِیعٌ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : کُنْتُ عِنْدَ ابْنِ عَبَّاسٍ فَأَتَاہُ رَجُلٌ ، فَقَالَ : إنِّی أَہْدَیْتُ بَدَنَۃً ، وَإِنِّی أَضْلَلْتہَا بِالطَّرِیقِ ، فَہَلْ تُجْزِئُ عَنِّی ؟ قَالَ : إِنْ کَانَتْ فِی نَذْرٍ ، أَوْ فِی کَفَّارَۃٍ فَوَافِ بِہَا الْبَیْتَ ، فَلاَ إِخَالُکَ وَافَیْتَ بِہَا ، وَإِنْ کَانَتْ تَطَوُّعًا أَجْزَأَتْ عَنْکَ ، قَالَ : قُلْتُ : فِیہِ وَلَوْ شَاۃً ؟ قَالَ : نَعَمْ۔","Sahih","Musannaf Ibn Abi Shaybah 14627","","","كتاب الحج"
"14628","(۱۴۶۲۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّ عُمَرَ قَضَی فِی الأَرْنَبِ جَفرَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 14628","","","كتاب الحج"
"14629","(۱۴۶۲۹) حدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : فِی الأَرْنَبِ کَفٌّ مِنْ طَعَامٍ فَمَا دُونَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14629","","","كتاب الحج"
"14630","(۱۴۶۳۰) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ ، قَالَ : فِی الأَرْنَبِ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 14630","","","كتاب الحج"
"14631","(۱۴۶۳۱) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حدَّثَنَا حُسَیْنُ بْنُ عَقِیلٍ ، عَنِ الضَّحَّاکِ ، قَالَ : فِی الأَرْنَبِ مَا دُونَ الْمُسِنَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14631","","","كتاب الحج"
"14632","(۱۴۶۳۲) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ عُمَرَ ، وَعُثْمَانَ ، وَزَیْدَ بْنَ ثَابِتٍ ، وَابْنَ عَبَّاسٍ ، وَمُعَاوِیَۃَ ، قَالُوا : فِی النَّعَامَۃِ بَدَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 14632","","","كتاب الحج"
"14633","(۱۴۶۳۳) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاووُسٍ ، وَمُجَاہِدٍ ، قَالُوا : فِی النَّعَامَۃِ بَدَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 14633","","","كتاب الحج"
"14634","(۱۴۶۳۴) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : فِی النَّعَامَۃِ بَدَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 14634","","","كتاب الحج"
"14635","(۱۴۶۳۵) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : فِی النَّعَامَۃِ جَزُورٌ۔","","Musannaf Ibn Abi Shaybah 14635","","","كتاب الحج"
"14636","(۱۴۶۳۶) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : فِی النَّعَامَۃِ بَدَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 14636","","","كتاب الحج"
"14637","(۱۴۶۳۷) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : فِی الْبَقَرَۃِ بَقَرَۃٌ۔","","Musannaf Ibn Abi Shaybah 14637","","","كتاب الحج"
"14638","(۱۴۶۳۸) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : إذَا أَصَابَ الْمُحْرِمُ بَقَرَۃَ الْوَحْشِ ، فَفِیہَا جَزُورٌ۔","","Musannaf Ibn Abi Shaybah 14638","","","كتاب الحج"
"14639","(۱۴۶۳۹) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، قَالَ : فِی الْبَقَرَۃِ بَقَرَۃٌ۔","","Musannaf Ibn Abi Shaybah 14639","","","كتاب الحج"
"14640","(۱۴۶۴۰) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : فِی الْحِمَارِ بَدَنَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14640","","","كتاب الحج"
"14641","(۱۴۶۴۱) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ، قَالُوا : فِی الْحِمَارِ بَقَرَۃٌ۔","","Musannaf Ibn Abi Shaybah 14641","","","كتاب الحج"
"14642","(۱۴۶۴۲) حدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَجُلاً کَانَ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ مُحْرِمٌ ، فَوَقَصَتْہُ نَاقَتُہُ فَمَاتَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اِغْسِلُوہُ بِمَائٍ وَسِدْرٍ ، وَکَفِّنُوہُ فِی ثَوْبَیْہِ ، وَلاَ تُخَمِّرُوا رَأْسَہُ ، وَلاَ تُمِسُّوْہُ بِطِیبٍ ، فَإِنَّ اللَّہَ یَبْعَثُہُ یَوْمَ الْقِیَامَۃِ مُلَبِّدًا۔ (بخاری ۱۸۵۱۔ مسلم ۹۹)","Sahih","Musannaf Ibn Abi Shaybah 14642","","","كتاب الحج"
"14643","(۱۴۶۴۳) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تُخَمِّرُوا رَأْسَہُ ، فَإِنَّ اللَّہَ یَبْعَثُہُ یَوْمَ الْقِیَامَۃِ مُلَبِّیًا۔ (مسلم ۹۸۔ ابوداؤد ۳۲۳۳)","Sahih","Musannaf Ibn Abi Shaybah 14643","","","كتاب الحج"
"14644","(۱۴۶۴۴) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، أَنَّہُ سُئِلَ عَنِ الْمُحْرِمِ یُغَطَّی رَأْسُہُ إِذَا مَاتَ ، وَإِذَا کُفِّنَ ؟ قَالَ : قدْ غَطَّی ابْنُ عُمَرَ ، وَکَشَفَ غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 14644","","","كتاب الحج"
"14645","(۱۴۶۴۵) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنِ ابْنِ طَاوُوس، عَنْ أَبِیہِ، قَالَ: یُغَیَّبُ رَأْسُ الْمُحْرِمِ إِذَا مَاتَ۔","","Musannaf Ibn Abi Shaybah 14645","","","كتاب الحج"
"14646","(۱۴۶۴۶) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا مَاتَ الْمُحْرِمُ فَہُوَ حَلال۔","No Data Available","Musannaf Ibn Abi Shaybah 14646","","","كتاب الحج"
"14647","(۱۴۶۴۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنِ عامر قَالَ : إذَا مَاتَ الْمُحْرِمُ فَقَدْ ذَہَبَ إِحْرَامُہُ۔","","Musannaf Ibn Abi Shaybah 14647","","","كتاب الحج"
"14648","(۱۴۶۴۸) حدَّثَنَا وَکِیعٌ ، عَنْ عُقْبَۃَ بْنِ أَبِی صَالِحٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَائِشَۃَ ، قَالَتْ : إِذَا مَاتَ الْمُحْرِمُ ذَہَبَ إِحْرَامُ صَاحِبِکُمْ۔","","Musannaf Ibn Abi Shaybah 14648","","","كتاب الحج"
"14649","(۱۴۶۴۹) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عنْ عَائِشَۃَ ؛ أَنَّہَا سُئِلَتْ عَنِ الْمُحْرِمِ یَمُوتُ ؟ فَقَالَتْ : اصْنَعُوا بِہِ کَمَا تَصْنَعُونَ بِمَوْتَاکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 14649","","","كتاب الحج"
"14650","(۱۴۶۵۰) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَسَارٍ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ ، وَسُئِلَ عَنِ الرَّجُلِ یَمُوتُ وَہُوَ مُحْرِمٌ ؟ قَالَ : قَدْ ذَہَبَ إِحْرَامُہُ ، یُکَفَّنُ کَمَا یُکَفَّنُ الْحَلاَلُ۔","","Musannaf Ibn Abi Shaybah 14650","","","كتاب الحج"
"14651","(۱۴۶۵۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خَمِّرُوا وُجُوہَکُمْ ، وَلاَ تَشَبَّہُوا بِالْیَہُودِ۔ (طبرانی ۱۱۔ بیہقی ۳۹۳)","","Musannaf Ibn Abi Shaybah 14651","","","كتاب الحج"
"14652","(۱۴۶۵۲) حدَّثَنَا عُبَیْدُ اللہِ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ فِی الْمُحْرِمِ: یُغَطَّی رَأْسُہُ، وَلاَ یُکْشَفُ۔","","Musannaf Ibn Abi Shaybah 14652","","","كتاب الحج"
"14653","(۱۴۶۵۳) حدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ تُقَرِّبُوہُ طِیبًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14653","","","كتاب الحج"
"14654","(۱۴۶۵۴) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، وَعَطَائٍ ؛ أَنَّ عَائِشَۃَ اشْتَرَتْ بَدَنَۃً فَأَضَلَّتْہَا ، فَاشْتَرَتْ مَکَانََہَا ، ثُمَّ وَجَدَتْہَا ، فَنَحَرَتْہُمَا جَمِیعًا ، ثُمَّ قَالَتْ : کَانَ فِی عِلْمِ اللہِ أَنْ أَنْحَرُہُمَا جَمِیعًا ۔ وَذَلِکَ فِی التَّطَوُّعِ۔","","Musannaf Ibn Abi Shaybah 14654","","","كتاب الحج"
"14655","(۱۴۶۵۵) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَائِشَۃَ نَحَرَتْہُمَا جَمِیعًا۔","Sahih","Musannaf Ibn Abi Shaybah 14655","","","كتاب الحج"
"14656","(۱۴۶۵۶) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ مَاعِزِ بْنِ مَالِکٍ ، أَوْ مَالِکِ بْنِ مَاعِزٍ الثَّقَفِیِّ ، قَالَ : سَاقَ أَبِی ہَدْیَیْنِ عَنْ نَفْسِہِ وَامْرَأَتِہِ وَابْنَتِہِ ، فَأَضَلَّہُمَا بِذِی الْمَجَازِ ، فَلَمَّا کَانَ یَوْمُ النَّحْرِ ذَکَرَ ذَلِکَ لِعُمَرَ ، فَقَالَ: تَرَبَّصَ الْیَوْمَ وَغَدًا وَبَعْدَ غَدٍ ، فَإِنَّمَا النَّحْرُ فِی ہَذِہِ الثَّلاَثَۃِ الأَیَّامِ ، فَإِنْ وَجَدْتَ ہَدْیَیْکَ فَانْحَرْہُمَا جَمِیعًا، فَإِنْ لَمْ تَجِدْہُمَا فَاشْتَرِ ہَدْیَیْنِ فِی الْیَوْمِ الثَّالِثِ ، فَانْحَرْہُمَا وَلاَ تُحِلَّ مِنْک حَرَامًا حَتَّی تَنْحَرَہُمَا ، أَوْ ہَدْیَیْنِ آخَرَیْنِ ، فَإِنْ نَحَرْتَ الْہَدْیَیْنِ اللَّذَیْنِ اشْتَرَیْتَ وَوَجَدْتَ الْہَدْیَیْنِ الضَّالَّیْنِ بَعْدُ فَانْحَرْہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 14656","","","كتاب الحج"
"14657","(۱۴۶۵۷) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَقِیلِ بْنِ طَلْحَۃَ ، عَنْ أَبِی الْخُصَیْبِ الْقَیْسِیِّ ؛ أَنَّہُ أَہْدَی عَنْ أُمِّہِ بَدَنَۃً فَأَضَلَّہَا ، فَاشْتَرَی مَکَانَہَا أُخْرَی ، فَقَلَّدَہَا ، ثُمّ?? وَجَدَ الأُولَی ، فَسَأَلَ ابْنَ عُمَرَ ؟ فَقَالَ : انْحَرْہُمَا جَمِیعًا۔","Da'if","Musannaf Ibn Abi Shaybah 14657","","","كتاب الحج"
"14658","(۱۴۶۵۸) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی طَالِبٍ الْحَجَّامِ ، وَکَانَ ثِقَۃً ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَنْحَرُہُمَا جَمِیعًا۔","Sahih","Musannaf Ibn Abi Shaybah 14658","","","كتاب الحج"
"14659","(۱۴۶۵۹) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا أَہْدَتْ بَدَنَتَیْنِ فَأَضَلَّتْہُمَا ، فَأَہْدَی لَہَا ابْنُ الزُّبَیْرِ بَدَنَتَیْنِ فَنَحَرَتْہُمَا ، ثُمَّ وَجَدَتِ الْبَدَنَتَیْنِ فَنَحَرَتْہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 14659","","","كتاب الحج"
"14660","(۱۴۶۶۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عَلِیِّ بْنِ نَافِعٍ ، قَالَ : سُقْتُ بَدَنَۃً فَأَضْلَلْتُہَا ، فَاشْتَرَیْتُ أُخْرَی فَنَحَرْتُہَا ، ثُمَّ وَجَدْتُ الأُولَی ، فَسَأَلْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ ؟ فَقَالَ : انْحَرْہُمَا ، وَسَأَلْتُ عِکْرِمَۃَ ؟ فَقَالَ : نَاقَۃً مِنْ إِبِلِک۔","","Musannaf Ibn Abi Shaybah 14660","","","كتاب الحج"
"14661","(۱۴۶۶۱) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : انْحَرِ الأُولَی۔","","Musannaf Ibn Abi Shaybah 14661","","","كتاب الحج"
"14662","(۱۴۶۶۲) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی بَکْرِ بْنِ أَبِی الْجَہْمِ ، قَالَ : سَأَلْتُ عَنْہُ قَبِیصَۃَ بْنَ ذُؤَیْبٍ ؟ فَقَالَ : انْحَرْہُمَا جَمِیعًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14662","","","كتاب الحج"
"14663","(۱۴۶۶۳) حدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ کَثِیرِ بْنِ شِنْظِیرٍ ، عَنْ عَطَائٍ ، قَالَ : إِذَا کَانَتِ الأُولَی تَطَوُّعًا نَحَرَہُمَا جَمِیعًا ، وَإِذَا کَانَتْ وَاجِبَۃً صَنَعَ بِالأُخْرَی مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 14663","","","كتاب الحج"
"14664","(۱۴۶۶۴) حدَّثَنَا أَبُو أُسَامَۃَ، عَنِ ہشام ، عَنِ الْحَسَنِ ، وَعَطَائٍ ؛ أَنَّہُمَا قَالاَ فِی رَجُلٍ أَضَلَّ بَدَنَتَہُ تَطَوُّعًا، فَاشْتَرَی أُخْرَی ، قَالاَ : إِنْ کَانَ قَلَّدَ الَّذِی اشْتَرَی نَحَرَہُمَا ، وَإِنْ کَانَ لَمْ یُقَلِّدْہَا بَاعَہَا إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 14664","","","كتاب الحج"
"14665","(۱۴۶۶۵) حدَّثَنَا أَبُو الأَحْوَصِ سَلاَّ مُ بْنُ سُلَیْمٍ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَاتَ وَلَمْ یَحُجَّ حَجَّۃَ الإِسْلاَمِ ، لَمْ یَمْنَعْہُ مَرَضٌ حَابِسٌ ، أَوْ حَاجَۃٌ ظَاہِرَۃٌ ، أَوْ سُلْطَانٌ جَائِرٌ ، فَلْیَمُتْ عَلَی أَیِّ حَالٍ شَائَ ، یَہُودِیًّا ، أَوْ نَصْرَانِیًّا۔ (دارمی ۱۷۸۵۔ بیہقی ۳۳۴)","Da'if","Musannaf Ibn Abi Shaybah 14665","","","كتاب الحج"
"14666","(۱۴۶۶۶) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ الأَسْوَدُ لِرَجُلٍ مِنْہُمْ مُوسِرٍ : لَوْ مِتَّ وَلَمْ تَحُجَّ ، لَمْ أُصَلِّ عَلَیْکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14666","","","كتاب الحج"
"14667","(۱۴۶۶۷) حدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ، عَنْ سُفْیَانَ، عَنِ مُجَاہِدِ بْنِ رُومِیٍّ، وَکَانَ ثِقَۃً، قَالَ: سَأَلَتُ سَعِیدَ بْنَ جُبَیْرٍ، وَعَبْدَ الرَّحْمَن بْنِ أَبِی لَیْلَی ، وَعَبْدَ اللہِ بْنَ مَعْقِلٍ عَنْ رَجُلٍ مَاتَ وَلَمْ یَحُجَّ ، وَہُوَ مُوسِرٌ ؟ فَقَالَ سَعِیدٌ: النَّارَ ، النَّارَ ، وَقَالَ ابْنُ مَعْقِلٍ : مَاتَ وَہُوَ لِلَّہِ عَاصٍ ، وَقَالَ ابْنُ أَبِی لَیْلَی : إِنِّی لأَرْجُو إِنْ حَجَّ عَنْہُ وَلِیُّہُ۔","","Musannaf Ibn Abi Shaybah 14667","","","كتاب الحج"
"14668","(۱۴۶۶۸) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی الْمُعَلَّی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لَوْ کَانَ لِی جَارٌ مُوسِرٌ ، ثُمَّ مَاتَ وَلَمْ یَحُجَّ ، لَمْ أُصَلِّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14668","","","كتاب الحج"
"14669","(۱۴۶۶۹) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ ثُوَیْرٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ مَاتَ وَہُوَ مُوسِرٌ لَمْ یَحُجَّ ، جَائَ یَوْمَ الْقِیَامَۃِ وَبَیْنَ عَیْنَیْہِ مَکْتُوبٌ : کَافِرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 14669","","","كتاب الحج"
"14670","(۱۴۶۷۰) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَدِیِّ بْنِ عَدِیٍّ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : مَنْ مَاتَ وَہُوَ مُوسِرٌ لَمْ یَحُجَّ ، فَلْیَمُتْ عَلَی أَیِّ حَالٍ شَائَ ، یَہُودِیًّا ، أَوْ نَصْرَانِیًّا۔","Sahih","Musannaf Ibn Abi Shaybah 14670","","","كتاب الحج"
"14671","(۱۴۶۷۱) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَدِیِّ بْنِ عَدِیٍّ ، عَنِ الضَّحَّاکِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَرْزَمٍ ، عَنْ عُمَرَ ؛ بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 14671","","","كتاب الحج"
"14672","(۱۴۶۷۲) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرو بْنِ دِینَارٍ قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ یُسْرِعُ فِی الطَّوَافِ۔","Sahih","Musannaf Ibn Abi Shaybah 14672","","","كتاب الحج"
"14673","(۱۴۶۷۳) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ، عَنْ إِسْمَاعِیلَ بْنِ عَبْدِالْمَلِکِ، قَالَ: رَأَیْتُ عُمَرَ بْنَ عَبْدِالْعَزِیزِ یُہَرْوِلُ فِی الطَّوَافِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14673","","","كتاب الحج"
"14674","(۱۴۶۷۴) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ عَمْرَو بْنَ مَیْمُونٍ یَطُوفُ بِالْبَیْتِ یُسْرِعُ حَتَّی یَکَادَ یَسْعَی ، أَوْ یَشْتَدُّ۔","","Musannaf Ibn Abi Shaybah 14674","","","كتاب الحج"
"14675","(۱۴۶۷۵) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : طُفْتُ مَعَہُ بِالْبَیْتِ ، فَکَانَ یَمْشِی عَلَی ہِیْنَتِہِ قَلِیلاً قَلِیلاً ، وَلاَ یُزَاحِمُ عَلَی الْحَجَرِ۔","","Musannaf Ibn Abi Shaybah 14675","","","كتاب الحج"
"14676","(۱۴۶۷۶) حدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، قَالَ : قَالَ لَنَا سَعِیدُ بْنُ جُبَیْرٍ وَنَحْنُ نَطُوفُ بِالْبَیْتِ : یَا مَعْشَرَ الشَّبَابِ اُرْمُلُوا، إسْرَعُوا۔","","Musannaf Ibn Abi Shaybah 14676","","","كتاب الحج"
"14677","(۱۴۶۷۷) حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : جَلَسْنَا لابْنِ عُمَرَ نَنْظُرُ کَیْفَ یَطُوفُ ، فَرَأَیْنَاہُ قَائِلاً ہَکَذَا ، قَدْ قَبَضَ عَلَی أَصَابِعِہِ وَہُوَ یَشْتَدُّ۔","Sahih","Musannaf Ibn Abi Shaybah 14677","","","كتاب الحج"
"14678","(۱۴۶۷۸) حدَّثَنَا جَرِیرٌ ، وَأَبُو الأَحْوَص ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، قَالَ : کَانَ أَبُو قَتَادَۃَ فِی نَفَرٍ مُحْرِمِینَ ، وَأَبُو قَتَادَۃَ مُحِلٌّ ، فَرَأَی أَصْحَابُہُ حِمَارًا وَحْشِیًّا ، فَلَمْ یُؤْذِنوہُ حَتَّی أَبْصَرَہُ ، فَاخْتَلَسَ مِنْ بَعْضِہِمْ سَوْطًا فَصَرَعَہُ ، فَأَکَلُوا وَحَمَلُوا مِنْہُ ، فَلَقُوا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَأَلُوہُ عَنْہ ؟ فَقَالَ : ہَلْ أَشَارَ إلَیْہِ أَحَدٌ مِنْکُمْ ؟ قَالُوا : لاَ ، قَالَ : فَکُلُوا۔ (بخاری ۱۸۲۱۔ مسلم ۶۳)","Sahih","Musannaf Ibn Abi Shaybah 14678","","","كتاب الحج"
"14679","(۱۴۶۷۹) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ مُعَاذِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا مَعَ طَلْحَۃَ بْنِ عُبَیْدِ اللہِ فِی الْحَجِّ وَنَحْنُ مُحْرِمُونَ ، قَالَ : فَأُہْدِیَ لَنَا طَائِرٌ ، وَطَلْحَۃُ نَائِمٌ ، قَالَ : فَمِنَّا مَنْ أَکَلَ ، وَمِنَّا مَنْ تَوَرَّعَ فَلَمْ یَأْکُلْہُ ، فَلَمَّا اسْتَیْقَظَ طَلْحَۃُ ذَکَرُوا ذَلِکَ لَہُ ، قَالَ : فَوَفَقَ مَنْ أَکَلَہُ ، وَقَالَ : أَکَلْنَاہ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (مسلم ۶۵۔ احمد ۱/۱۶۲)","Sahih","Musannaf Ibn Abi Shaybah 14679","","","كتاب الحج"
"14680","(۱۴۶۸۰) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَانَ لاَ یَرَی بَأْسًا بِلَحْمِ الطَّیْرِ إِذَا صِیدَ لِغَیْرِہِ ، یَعْنِی فِی الإِحْرَامِ۔","Hasan","Musannaf Ibn Abi Shaybah 14680","","","كتاب الحج"
"14681","(۱۴۶۸۱) حدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ سَالِمٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ ، یَقُولُ : لَمَّا قَدِمْتُ مِنَ الْبَحْرَیْنِ لَقِیَنِی قَوْمٌ مِنْ أَہْلِ الْعِرَاقِ ، فَسَأَلُونِی عَنِ الْحَلاَلِ یَصِیدُ الصَّیْدَ فَیَأْکُلُہُ الْحَرَامُ ؟ فَأَفْتَیْتُہمْ بِأَکْلِہِ ، فَقَدِمْتُ عَلَی عُمَرَ فَسَأَلْتُہُ عَنْ ذَلِکَ ؟ فَقَالَ : لَوْ أَفْتَیْتَہُمْ بِغَیْرِہِ مَا أَفْتَیْتَ أَحَدًا أَبَدًا۔","Hasan","Musannaf Ibn Abi Shaybah 14681","","","كتاب الحج"
"14682","(۱۴۶۸۲) حدَّثَنَا وَکِیعٌ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ؛ أَنَّ الزُّبَیْرَ بْنَ الْعَوَّامِ کَانَ یَتَزَوَّدُ صَفِیفَ الْوَحْشِ وَہُوَ مُحْرِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 14682","","","كتاب الحج"
"14683","(۱۴۶۸۳) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ (ح) وَعَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُمَا لَمْ یَکُونَا یَرَیَانِ بَأْسًا بِأَکْلِ الْمُحْرِمِ مَا صَادَ الْحَلاَلُ ، إِذَا کَانَ لَمْ یَصِدْہُ مِنْ أَجْلِہِ ، أَوْ بِآلَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14683","","","كتاب الحج"
"14684","(۱۴۶۸۴) حدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ أَبِیہِ ، عَنْ سَعْدِ بْنِ عِیَاضٍ ، قَالَ : سُئِلَ ابْنُ مَسْعُودٍ عَنْ قَوْمٍ مُحْرِمِینَ ، لَقُوا قَوْمًا حَلاَلاً مَعَہُمْ لَحْمُ صَیْدٍ ، فَإِمَّا بَاعُوہُمْ ، وَإِمَّا أَطْعَمُوہُمْ ؟ فَقَالَ : لاَ بَأْسَ۔","Da'if","Musannaf Ibn Abi Shaybah 14684","","","كتاب الحج"
"14685","(۱۴۶۸۵) حدَّثَنَا وَکِیعٌ، عَنْ قُرَّۃَ بن خالد، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ، قَالَ: قَالَ رَجُلٌ: اشْتَرَیْنَا رِجْلَ حِمَارٍ وَنَحْنُ مُحْرِمُونَ مِنْ قَوْمٍ حَلاَلٍ ، قَالَ : فَمَرَرْنَا بِأَبِی ذَرٍّ ، فَسَأَلْنَاہُ ؟ فَقَالَ : لاَ أَرَاکُمْ فَجَرتُمْ ، لاَ بَأْسَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 14685","","","كتاب الحج"
"14686","(۱۴۶۸۶) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ الصَّعْبِ بْنِ جَثَّامَۃَ ، قَالَ : أَہْدَیْتُ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالأَبْوَائِ ، أَوْ بِوَدَّانَ حِمَارَ وَحْشٍ وَہُوَ مُحْرِمٌ ، قَالَ : فَرَدَّہُ : وَقَالَ : إِنَّہُ لَیْسَ بِنَا رَدّ عَلَیْکَ ، وَلَکِنَّا حُرُمٌ۔ (بخاری ۱۸۲۵۔ مسلم ۵۰)","Sahih","Musannaf Ibn Abi Shaybah 14686","","","كتاب الحج"
"14687","(۱۴۶۸۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَہْدَی الصَّعْبُ بْنُ جَثَّامَۃَ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِمَارَ وَحْشٍ وَہُوَ مُحْرِمٌ ، فَرَدَّہُ عَلَیْہِ ، وَقَالَ : لَوْلاَ أَنَّا مُحْرِمُونَ لَقَبِلْنَاہُ مِنْک۔ (مسلم ۵۴۔ احمد ۱/۲۸۰)","Sahih","Musannaf Ibn Abi Shaybah 14687","","","كتاب الحج"
"14688","(۱۴۶۸۸) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَرِہَ طَرِیَّ الصَّیْدِ وَقَدِیدَہُ لِلْمُحْرِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 14688","","","كتاب الحج"
"14689","(۱۴۶۸۹) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَہْدَی الصَّعْبُ بْنُ جَثَّامَۃَ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِمَارَ وَحْشٍ ، فَقَالَ : رُدَّوہُ إِلَیْہِ ، إِنَّا مُحْرِمُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 14689","","","كتاب الحج"
"14690","(۱۴۶۹۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَانَ یَنْہَی الْحَرَامَ عْن أَکْلِ الصَّیْدِ وَشِیقَۃً ، أَو غَیْرَہَا۔","","Musannaf Ibn Abi Shaybah 14690","","","كتاب الحج"
"14691","(۱۴۶۹۱) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرٍو ، عَنْ أَبِی الشَّعْثَائِ ؛ أَنَّہُ کَرِہَ أَکْلَہُ لِلْمُحْرِمِ ، وَیَتْلُو: {وَحُرِّمَ عَلَیْکُمْ صَیْدُ الْبَرِّ مَا دُمْتُمْ حُرُمًا}۔","No Data Available","Musannaf Ibn Abi Shaybah 14691","","","كتاب الحج"
"14692","(۱۴۶۹۲) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَ : قَالَتْ : یَا ابْنَ أُخْتِی ، إِنَّمَا ہِیَ لَیَالٍ ، فَإِنْ تَخَلَّجَ فِی صَدْرِکَ شَیْئٌ فَدَعْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14692","","","كتاب الحج"
"14693","(۱۴۶۹۳) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہِیَ مُبْہَمَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 14693","","","كتاب الحج"
"14694","(۱۴۶۹۴) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ مَعْبَدِ بْنِ صُبَیْحٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَرِہَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 14694","","","كتاب الحج"
"14695","(۱۴۶۹۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِیاد ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ؛ أَنَّ عُثْمَانَ أُہْدِیَتْ لَہُ حَجَلٌ وَہُوَ فِی بَعْضِ حَجَّاتِہِ وَہُوَ مُحْرِمٌ ، فَأَمَرَ بِہَا فَطُبِخَتْ ، فَجُعِلَتْ ثَرِیدًا ، فَأُتِیَ بِہَا فِی الْجِفَانِ وَنَحْنُ مُحْرِمُونَ ، فَأَکَلُوا کُلُّہُمْ إِلاَّ عَلِیًا۔","Hasan","Musannaf Ibn Abi Shaybah 14695","","","كتاب الحج"
"14696","(۱۴۶۹۶) حدَّثَنَا وَکِیعٌ، عَنْ إِسْمَاعِیلَ، قَالَ: سَأَلْتُ الشَّعْبِیَّ عَنْہُ؟ فَقَالَ: قَدَ اُخْتُلِفَ فِیہِ، وَلاَ تَأْکُلْ مِنْہُ أَحَبَّ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 14696","","","كتاب الحج"
"14697","(۱۴۶۹۷) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِنِ اسْتَطَعْتَ أَنْ لاَ تَدْنُوَ مِنِ امْرَأَتِکَ وَأَنْتَ حَرَامٌ۔","","Musannaf Ibn Abi Shaybah 14697","","","كتاب الحج"
"14698","(۱۴۶۹۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَأْمُرُ بِاعْتِزَالِہَا جِدًّا۔","","Musannaf Ibn Abi Shaybah 14698","","","كتاب الحج"
"14699","(۱۴۶۹۹) حدَّثَنَا حُسَین بن عَلِیّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ حَبِیبِ بْنِ أَبِی مَرْزُوقٍ ، قَالَ : سَأَلْتُ عَنْہُ نَافِعًا ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 14699","","","كتاب الحج"
"14700","(۱۴۷۰۰) حدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ أَبِی بِشْرٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ فِی الرَّجُلِ یَحْمِلُ امْرَأَتَہُ وَہُوَ مُحْرِمٌ، قَالَ : احْمِلْہَا وَاتَّقِ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 14700","","","كتاب الحج"
"14701","(۱۴۷۰۱) حدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 14701","","","كتاب الحج"
"14702","(۱۴۷۰۲) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، وَعَطَائٍ، قَالاَ: لاَ بَأْسَ أَنْ یَحْمِلَہَا، مَا لَمْ تَکُنْ مُلاَمَسَۃٌ۔","","Musannaf Ibn Abi Shaybah 14702","","","كتاب الحج"
"14703","(۱۴۷۰۳) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَعَطَائٍ ، قَالاَ : لاَ بَأْسَ أَنْ یَحْمِلَ الْمُحْرِمُ امْرَأَتَہُ ، مَا لَمْ یَلْزِقْ جِلْدَہُ بِجِلْدِہَا۔","","Musannaf Ibn Abi Shaybah 14703","","","كتاب الحج"
"14704","(۱۴۷۰۴) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : سَأَلَ مَرْوَانُ بْنُ الْحَکَمِ ابْنَ عَبَّاسٍ وَنَحْنُ بِوَادِی الأَزْرَقِ ، فَقَالَ : الصَّیْدُ یَصِیدُہُ الْمُحْرِمُ ، لاَ یَجِدُ لَہُ نِدًّا مِنَ النَّعَمِ ؟ فَقَالَ ابْنُ عَبَّاسٍ : ثَمَنُہُ یُہْدَی إلَی مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14704","","","كتاب الحج"
"14705","(۱۴۷۰۵) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا أَصَابَ الْمُحْرِمُ مِنَ الصَّیْدِ مَا لَمْ یَکُنْ فِیہِ ہَدْیٌ ، تَصَدَّقَ بِثَمَنِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14705","","","كتاب الحج"
"14706","(۱۴۷۰۶) حدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : مَا لَمْ یَبْلُغْ ہَدْیًا ،فَطَعَامٌ یَطْعَمُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14706","","","كتاب الحج"
"14707","(۱۴۷۰۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زِیَادِ بْنِ الْحُصَیْنِ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تَمَثَّلَ بِہَذَا الْبَیْتَ وَہُوَ مُحْرِمٌ ، قَالَ :nوَہُنَّ یَمْشِینَ بِنَا ہَمِیسًا ۔۔۔ إِنْ تَصْدُقَ الطَّیْرُ نَنِکَ لَمِیسَا۔n قَالَ : فَقِیلَ لَہُ : تَقُول ہَذَا وَأَنْتَ مُحْرِمٌ ، فَقَالَ : إِنَّمَا الْفُحْشُ مَا وُوْجِہ بِہِ النِّسَائُ وَہُمْ مُحْرِمُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 14707","","","كتاب الحج"
"14708","(۱۴۷۰۸) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَرِہَ الإِعْرَابَ لِلْمُحْرِمِ ، قُلْتُ : وَمَا الإِعْرَابُ ؟ قَالَ : أَنْ یَقُولَ : لَوْ أَحْلَلْت قَدْ أَصَبْتُکِ۔","","Musannaf Ibn Abi Shaybah 14708","","","كتاب الحج"
"14709","(۱۴۷۰۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ التَّعْرِیبَ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 14709","","","كتاب الحج"
"14710","(۱۴۷۱۰) حدَّثَنَا وَکِیعٌ ، عَنْ مَعْقِلٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیر ؛ أَنَّہُ کَرِہَ التَّعْرِیبَ لِلْمُحْرِمِ۔","","Musannaf Ibn Abi Shaybah 14710","","","كتاب الحج"
"14711","(۱۴۷۱۱) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ طَاوُوسٍ ؛ أَنَّ عَبْدَ اللہِ بْنَ الزُّبَیْرِ ، قَالَ : إِیَّاکُمْ وَالنِّسَائَ ، فَإِنَّ الإِعْرَابَ مِنَ الرَّفَثِ ، قَالَ طَاوُوس : فَأَخْبَرْتُ بِذَلِکَ ابْنَ عَبَّاسٍ ، فَقَالَ : صَدَقَ ابْنُ الزُّبَیْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 14711","","","كتاب الحج"
"14712","(۱۴۷۱۲) حدَّثَنَا حَفص بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی الصَّفَا وَالْمَرْوَۃِ دُعَائٌ مُوَقَّتٌ ، فَادْعُ بِمَا شِئْتَ۔","","Musannaf Ibn Abi Shaybah 14712","","","كتاب الحج"
"14713","(۱۴۷۱۳) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لَمْ نَسْمَعْ عَلَی الصَّفَا وَالْمَرْوَۃِ دُعَائٌ مُوَقَّتًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14713","","","كتاب الحج"
"14714","(۱۴۷۱۴) حدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، قَالَ : لَیْسَ عَلَیْہِمَا دُعَائٌ مُوَقَّتٌ ، فَادْعُ بِمَا شِئْتَ ، وَسَلْ مَا شِئْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14714","","","كتاب الحج"
"14715","(۱۴۷۱۵) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ مُعَاذِ بْنِ الْعَلاَئِ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ بْنَ خَالِدٍ الْمَخْزُومِیَّ یَقُولُ : لاَ أَعْلَمُ عَلَی الصَّفَا وَالْمَرْوَۃِ دُعَائً مُوَقَّتًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14715","","","كتاب الحج"
"14716","(۱۴۷۱۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ وَہْبِ بْنِ الأَجْدَعِ ؛ أَنَّہُ سَمِعَ عُمَرَ یَقُولُ : یَبْدَأُ بِالصَّفَا وَیَسْتَقْبِلُ الْبَیْتَ ، ثُمَّ یُکَبِّرُ سَبْعَ تَکْبِیرَاتٍ ، بَیْنَ کُلِّ تَکْبِیرَتَیْنِ ، حَمْدٌ للہِ وَصَلَاۃٌ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَمَسْأَلۃٌ لِنَفْسِہِ ، وَعَلَی الْمَرْوَۃِ مِثْلَ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 14716","","","كتاب الحج"
"14717","(۱۴۷۱۷) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إِذَا صَعِدَ عَلَی الصَّفَا اسْتَقْبَلَ الْبَیْتَ، ثُمَّ کَبَّرَ ثَلاَثًا ، ثُمَّ قَالَ : لاَ إِلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، یَرْفَعُ بِہَا صَوْتَہُ ، ثُمَّ یَدْعُو قَلِیلاً ، ثُمَّ یَفْعَلُ ذَلِکَ عَلَی الْمَرْوَۃِ ، حَتَّی یَفْعَلَ ذَلِکَ سَبْعَ مَرَّاتٍ ، فَیَکُونَ التَّکْبِیرُ إِحُدَی وَعِشْرِینَ تَکْبِیرَۃً ، فَمَا یَکَادُ یَفْرُغُ حَتَّی یَشُقَّ عَلَیْنَا ، وَنَحْنُ شَبَابٌ۔","Sahih","Musannaf Ibn Abi Shaybah 14717","","","كتاب الحج"
"14718","(۱۴۷۱۸) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الأَصْبَغِ بْنِ زَیْدٍ ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ یَقُولُ : یَقُومُ الرَّجُلُ عَلَی الصَّفَا وَالْمَرْوَۃِ قَدْرَ قِرَائَۃِ سُورَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 14718","","","كتاب الحج"
"14719","(۱۴۷۱۹) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، قَالَ : قَالَ الْحَکَمُ لإِبْرَاہِیمَ : رَأَیْتُ أَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ یَقُومُ عَلَی الصَّفَا قَدْرَ مَا یَقْرَأُ الرَّجُلُ عِشْرِینَ وَمِئَۃَ آیَۃٍ ، قَالَ : إِنَّہُ لَفَقِیہٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14719","","","كتاب الحج"
"14720","(۱۴۷۲۰) حدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَدَأَ بِالصَّفَا ، فَرَقِی ، وَوَحَّدَ اللَّہَ وَکَبَّرَہُ ، وَقَالَ : لاَ إِلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، لاَ إِلَہَ إِلاَّ اللَّہُ وَحْدَہُ ، أَنْجَزَ وَعْدَہُ ، وَنَصَرَ عَبْدَہُ ، وَہَزَمَ الأَحْزَابَ وَحْدَہُ ، ثُمَّ دَعَا بَیْنَ ذَلِکَ ، قَالَ مِثْلَ ذَلِکَ ثَلاَثَ مَرَّاتٍ ، ثُمَّ نَزَلَ إِلَی الْمَرْوَۃِ حَتَّی انْصَبَّتْ قَدَمَاہُ إِلَی بَطْنِ الْوَادِی ، حَتَّی إِذَا صَعِدْنَا مَشَی حَتَّی أَتَی الْمَرْوَۃَ ، فَفَعَلَ عَلَی الْمَرْوَۃِ کَمَا فَعَلَ عَلَی الصَّفَا۔","Sahih","Musannaf Ibn Abi Shaybah 14720","","","كتاب الحج"
"14721","(۱۴۷۲۱) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ ضَفَرَ ، أَوْ لَبَّدَ ، أَوْ عَقَصَ فَلْیَحْلِقْ، وَقَالَ ابْنُ عَبَّاسٍ : مَا نَوَی۔","Sahih","Musannaf Ibn Abi Shaybah 14721","","","كتاب الحج"
"14722","(۱۴۷۲۲) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْعَبَّاسِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : خَرَجْتُ مَعَ خَالَتِی مَیْمُونَۃَ فَلَبَّدْتُ رَأْسِی بِعَسَلٍ ، أَوْ بِغِرَائٍ فَتَنَشَّرَ ، فَشَقَّ عَلَیَّ وَأَنَا مُحْرِمٌ ، فَسَأَلْتُہَا ؟ فَقَالَتْ : اغْمِسْ رَأْسَکَ فِی مَائٍ مِرَارًا۔","Sahih","Musannaf Ibn Abi Shaybah 14722","","","كتاب الحج"
"14723","(۱۴۷۲۳) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : مَنْ لَبَّدَ ، أَوْ عَقَصَ ، أَوْ ضَفَرَ بسَیْرٍ ، فَقَدْ وَجَبَ عَلَیْہِ الْحَلْقُ۔","","Musannaf Ibn Abi Shaybah 14723","","","كتاب الحج"
"14724","(۱۴۷۲۴) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَر ، قَالَ : مَنْ لَبَّدَ ، أَوْ ضَفَرَ ، أَوْ فَتَلَ فَلْیَحْلِقْ۔","Sahih","Musannaf Ibn Abi Shaybah 14724","","","كتاب الحج"
"14725","(۱۴۷۲۵) حدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ عَوْفٍ ، عَنْ شَیْخٍ ، قَالَ : سَأَلْتُ عَنْہُ ، فَزَعَمُوا أَنَّہُ أَبُو الْمُہَلَّبِ ، قَالَ : مَنْ لَبَّدَ ، أَوْ ضَفَرَ فَقَدْ وَجَبَ عَلَیْہِ الْحَلْقُ۔","","Musannaf Ibn Abi Shaybah 14725","","","كتاب الحج"
"14726","(۱۴۷۲۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : مَنْ لَبَّدَ ، أَوْ ضَفَرَ فَلْیَحْلِقْ۔","","Musannaf Ibn Abi Shaybah 14726","","","كتاب الحج"
"14727","(۱۴۷۲۷) حدَّثَنَا عُبَیْدُ اللہِ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : وَضَعْتُ عَلَی رَأْسِی طِینًا قَبْلَ أَنْ أُحْرِمَ ،فَلَقِیتُ ابْنَ الزُّبَیْرِ، فَقَالَ : أَمَّا عُمَرُ فَکَانَ یَرَی الْحَلْقَ عَلَی مَنْ لَبَّدَ ، وَأَمَّا أَنَا فَلاَ أَرَی إِلاَّ مَا نَوَیْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 14727","","","كتاب الحج"
"14728","(۱۴۷۲۸) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْمُحْرِمِ إِذَا احْتَاجَ إِلَی قَمِیصٍ یَلْبَسُہُ ، أَوْ حَلَقَ رَأْسَہُ ، أَوْ نَحْوِ ہَذَا مِمَّا لاَ یَحْتَاجُ إِلَیْہِ الْمُحْرِمُ ، مِمَّا لاَ یَنْبَغِی لَنَا أَنْ نَصْنَعَہُ ، قَالَ : إِنْ فَعَلَ ذَلِکَ جَمِیعًا مَعًا فَعَلَیْہِ دَمٌ وَاحِدٌ ، وَإِذَا فَرَّقَ فَلِکُلِّ شَیْئٍ مِنْ ذَلِکَ دَمٌ۔","","Musannaf Ibn Abi Shaybah 14728","","","كتاب الحج"
"14729","(۱۴۷۲۹) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، قَالاَ : إِذَا جَمَعَ ذَلِکَ فِی سَاعَۃٍ فَعَلَیْہِ دَمٌ وَاحِدٌ ، وَإِنْ فَرَّقَ بَیْنَ ذَلِکَ ، فَلِکُلِّ وَاحِدٍ مِنْ ذَلِکَ دَمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14729","","","كتاب الحج"
"14730","(۱۴۷۳۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُ الْقَاسِمَ یَتَطَوَّعُ بَیْنَ الظُّہْرِ وَالْعَصْرِ بِعَرَفَۃَ ، وَرَأَیْتُ سَالِمًا لاَ یَفْعَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14730","","","كتاب الحج"
"14731","(۱۴۷۳۱) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَر ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یَتَطَوَّعُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 14731","","","كتاب الحج"
"14732","(۱۴۷۳۲) حدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الظُّہْرَ وَالْعَصْرَ بِعَرَفَۃَ ، وَلَمْ یُسَبِّحْ بَیْنَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 14732","","","كتاب الحج"
"14733","(۱۴۷۳۳) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : صَلِّ بَیْنَ الظُّہْرِ وَالْعَصْرِ بِعَرَفَۃَ ، إِنْ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 14733","","","كتاب الحج"
"14734","(۱۴۷۳۴) حدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ: مَنْ صَلَّی الصَّلاَتَیْنِ بِعَرَفَۃَ، لَمْ یَتَطَوَّعْ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 14734","","","كتاب الحج"
"14735","(۱۴۷۳۵) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ، قَالَ: إِنْ أَمْکَنَکَ الإِمَامُ أَنْ تَطَوَّعَ بَیْنَہُمَا ، فَتَطَوَّعْ۔","","Musannaf Ibn Abi Shaybah 14735","","","كتاب الحج"
"14736","(۱۴۷۳۶) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَنَس بن سِیرِین قَالَ : رَأَیْتُ ابن عُمَر لاَ یَتَطَوَّعُ بَیْنَ الظُّہْرِ وَالْعَصْرِ بِعَرَفَۃَ ، وَرَأَیتُ القَاسِم یَتَطَوَّع۔","Sahih","Musannaf Ibn Abi Shaybah 14736","","","كتاب الحج"
"14737","(۱۴۷۳۷) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَتَطَوَّعُ بَیْنَ الظُّہْرِ وَالْعَصْرِ بِعَرَفَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14737","","","كتاب الحج"
"14738","(۱۴۷۳۸) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الصَّبَّاحِ بْنِ عَبْدِ اللہِ الْبَجَلِیِّ ، قَالَ : سَأَلْتُ أَنَسَ بْنَ مَالِکٍ عَنِ الْمُحْرِمِ ، ہَلْ یَذْبَحُ ؟ قَالَ : نَعَمْ۔","Hasan","Musannaf Ibn Abi Shaybah 14738","","","كتاب الحج"
"14739","(۱۴۷۳۹) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : یَذْبَحُ الْمُحْرِمُ کُلَّ شَیْئٍ ، إِلاَّ الصَّیْدَ۔","","Musannaf Ibn Abi Shaybah 14739","","","كتاب الحج"
"14740","(۱۴۷۴۰) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ۔ قَالَ : وَسَأَلْتُ عَطَائً ، فَقَالاَ : لاَ بَأْسَ أَنْ یَذْبَحَ الْمُحْرِمُ مَا لَیْسَ بِصَیْدٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14740","","","كتاب الحج"
"14741","(۱۴۷۴۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، قَالَ : سَأَلْتُہُ عَنْ ذَبِیحَۃِ الْمُحْرِمِ ؟ فَلَمْ یَرَ بِہَا بَأْسًا ، قَالَ : وَکَانَ الْحَکَمُ لاَ یَرَی بِہَا بَأْسًا۔","","Musannaf Ibn Abi Shaybah 14741","","","كتاب الحج"
"14742","(۱۴۷۴۲) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : ذَبِیحَۃُ الْمُحْرِمِ مَیْتَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14742","","","كتاب الحج"
"14743","(۱۴۷۴۳) حدَّثَنَا یَعْقُوبُ بْنُ إِبْرَاہِیمَ ، عَن لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : ذَبِیحَۃُ الْمُحْرِم کَالْمَیْتَۃِ لاَ تُؤْکَلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14743","","","كتاب الحج"
"14744","(۱۴۷۴۴) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ أَبِی مَاعِزٍ ، قَالَ : جَائَتِ امْرَأَۃٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إِنِّی اُسْتُحِضْتُ ، قَالَ : دَعِی الصَّلاَۃَ أَیَّامَکِ الَّتِی ہِیَ أَیَّامُک ، ثُمَّ اغْتَسِلِی وَاحْتَشِی کُرْسُفًا ، وَطُوفِی بِالْبَیْتِ وَصَلِّی۔","Da'if","Musannaf Ibn Abi Shaybah 14744","","","كتاب الحج"
"14745","(۱۴۷۴۵) حدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الْمُسْتَحَاضَۃِ ، قَالَ : مُرْہَا فَلْتَغْتَسِلْ وَلْتَسْتَنْقِی بِجَہْدِہَا ، وَلْتَستنفِرْ بِثَوْبٍ نَظِیفٍ ، ثُمَّ لْتَطُفْ بِالْبَیْتِ۔","Sahih","Musannaf Ibn Abi Shaybah 14745","","","كتاب الحج"
"14746","(۱۴۷۴۶) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حُمَید ، عَنْ عَمَّارِ بْنِ أَبِی عَمَّارٍ مَوْلَی بَنِی ہَاشِمٍ ، قَالَ : جَاء ت امْرَأَۃٌ إِلَی ابْنِ عَبَّاسٍ ، فَقَالَتْ : تَطُوفُ الْمُسْتَحَاضَۃُ بِالْبَیْتِ ؟ فَقَالَ : تَقْعُدُ أَیَّامَ أَقْرَائِہَا ، ثُمَّ تَغْتَسِلْ وَتَطُوفُ بِالْبَیْتِ ، قَالَ : فَقَالَتْ : ہَلْ تَدْخُلُ الْکَعْبَۃَ ؟ قَالَ : فَقَالَ : اسْتَدْخِلِی وَاسْتَنْفِرِی ، وَادْخُلِی۔","Hasan","Musannaf Ibn Abi Shaybah 14746","","","كتاب الحج"
"14747","(۱۴۷۴۷) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : سَأَلْتُُہُ : أَتُصَلِّی الْمُسْتَحَاضَۃُ ؟ قَالَ : نَعَمْ ، وَتَحُجُّ الْبَیْتَ وَإِنْ سَالَ عَلَی عَقِبَیْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 14747","","","كتاب الحج"
"14748","(۱۴۷۴۸) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ؛ أَنَّہُمَا قَالاَ : تَقْضِی الْمَنَاسِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14748","","","كتاب الحج"
"14749","(۱۴۷۴۹) حدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : الْمُسْتَحَاضَۃُ تَطُوفُ بِالْبَیْتِ ، وَبَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","","Musannaf Ibn Abi Shaybah 14749","","","كتاب الحج"
"14750","(۱۴۷۵۰) حدَّثَنَا وَکِیعٌ، عَنْ ہَمَّامٍ ، عَنْ عَطَائٍ ، عَنِ امْرَأَۃٍ مِنْ أَہْلِ مَکَّۃَ ، عَنْ عَائِشَۃَ؛ أَنَّہَا طَافَتْ بِی مُسْتَحَاضَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 14750","","","كتاب الحج"
"14751","(۱۴۷۵۱) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ ؛ قَالَ : تَجْلِسُ الْمُسْتَحَاضَۃُ اسْتِعْدَادَہَا الَّذِی کَانَتْ تَجْلِسُ فِیہِ ، ثُمَّ تَحْتَشِی وَتَغْتَسِلُ ، وَتَطُوفُ بِالْبَیْتِ وَتَنْفِرُ۔","","Musannaf Ibn Abi Shaybah 14751","","","كتاب الحج"
"14752","(۱۴۷۵۲) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِنَافِعٍ : مَتَی کَانَ ابْنُ عُمَرَ یَرُوحُ ؟ قَالَ : رَسُولُہُ عِنْدَ الإِمَامِ ، فَإِذَا رَاحَ ، رَاحَ ، عَجَّلَ ، أَوْ أَخَّرَ ، قَالَ : وَکَانَ لاَ یَخْرُجُ حَتَّی یَطُوفَ سبْعًا ، وَکَانَ یُحِبُّ أَنْ لاَ یُصَلِّیَ الظُّہْرَ إِلاَّ بِمِنًی ، قَالَ : وَأَخَّرَ الأَمِیُر مَرَّۃً ، فَصَلَّی دُونَ مِنًی۔","Hasan","Musannaf Ibn Abi Shaybah 14752","","","كتاب الحج"
"14753","(۱۴۷۵۳) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، قَالَ : رَأَیْتُ أَنَسًا رَاکِبًا حِمَارًا ، ذَاہِبًا إِلَی مِنًی یَوْمَ التَّرْوِیَۃِ ، فَقُلْتُ لَہُ : أَیْنَ صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الظُّہْرَ فِی ہَذَا الْیَوْمِ ؟ قَالَ : اُنْظُرْ أَیْنَ یُصَلِّی أُمَرَاؤُکَ فَصَلِّ۔","Sahih","Musannaf Ibn Abi Shaybah 14753","","","كتاب الحج"
"14754","(۱۴۷۵۴) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُصَلِّی الظُّہْرَ یَوْمَ التَّرْوِیَۃِ بِمَکَّۃَ ، ثُمَّ یَسِیرُ إلَی مِنًی فَیَبِیتُ بِہَا۔","","Musannaf Ibn Abi Shaybah 14754","","","كتاب الحج"
"14755","(۱۴۷۵۵) حدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا کَانَ یَوْمَ التَّرْوِیَۃِ تَوَجَّہَ إِلَی مِنًی ، فَصَلَّی بِہَا الظُّہْرَ وَالْعَصْرَ ، وَالْمَغْرِبَ وَالْعِشَائَ وَالصُّبْحَ۔","Sahih","Musannaf Ibn Abi Shaybah 14755","","","كتاب الحج"
"14756","(۱۴۷۵۶) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الرَّوَاحُ إِلَی مِنًی إِذَا زَاغَتِ الشَّمْسُ ، فَلْیَرُح الإِمَامُ۔","","Musannaf Ibn Abi Shaybah 14756","","","كتاب الحج"
"14757","(۱۴۷۵۷) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الظُّہْرَ یَوْمَ التَّرْوِیَۃِ بِمِنًی۔","","Musannaf Ibn Abi Shaybah 14757","","","كتاب الحج"
"14758","(۱۴۷۵۸) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَتْ عَائِشَۃُ تَمْکُثُ بِمَکَّۃَ لَیْلَۃَ عَرَفَۃَ مُسْیَ یَوْمِ التَّرْوِیَۃِ ، عَامَّۃَ اللَّیْلِ۔","","Musannaf Ibn Abi Shaybah 14758","","","كتاب الحج"
"14759","(۱۴۷۵۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : صَلَّیْتُ مَعَہُ بِمَکَّۃَ الْعِشَائَ لَیْلَۃَ التَّرْوِیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14759","","","كتاب الحج"
"14760","(۱۴۷۶۰) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، قَالَ : سَمِعْتُ ابْنَ الزُّبَیْرِ یَقُولُ : إِنَّ مِنْ سُنَّۃِ الْحَجِّ، أَنَّ الإِمَامَ یُصَلِّی بِمِنًی الظُّہْرَ وَالْعَصْرَ ، وَالْمَغْرِبَ وَالْعِشَائَ وَالْفَجْرَ ، ثُمَّ یَغْدُو۔","Sahih","Musannaf Ibn Abi Shaybah 14760","","","كتاب الحج"
"14761","(۱۴۷۶۱) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ عَطَائٌ : مَنْ شَائَ صَلَّی بِمَکَّۃَ الظُّہْرَ ، وَمَنْ شَائَ صَلَّی بِمِنًی۔","","Musannaf Ibn Abi Shaybah 14761","","","كتاب الحج"
"14762","(۱۴۷۶۲) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ إِسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یَوْمَ التَّرْوِیَۃِ صَلَّی رَکْعَتَیْنِ فِی الْمَسْجِدِ الْحَرَامِ ، ثُمَّ خَرَجَ مِنْ مَکَّۃَ مَاشِیًا حَتَّی انْتَہَی إِلَی مِنًی ، فَصَلَّی بِہَا الظُّہْرَ وَالْعَصْرَ ، وَالْمَغْرِبَ وَالْعِشَائَ وَالْفَجْرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14762","","","كتاب الحج"
"14763","(۱۴۷۶۳) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنْ لاَحِقِ بْنِ حُمَیْدٍ ، قَالَ : صَلَّیْتُ الْفَجْرَ إِلَی جَنْبِ ابْنِ عُمَرَ ، وَرَاحِلَتُہُ مَوْقُوفَۃٌ ، فَلَمَّا نَظَرَ إِلَی الشَّمْسِ عَلَی قُلَّۃِ الْجَبَلِ رَکِبَ رَاحِلَتَہُ ، ثُمَّ غَدَا إِلَی عَرَفَاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 14763","","","كتاب الحج"
"14764","(۱۴۷۶۴) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ : أَخْبَرَنِی مَنْ رَأَی ابْنَ عَبَّاسٍ یَأْتِی عَرَفَۃَ بِسَحَرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 14764","","","كتاب الحج"
"14765","(۱۴۷۶۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : أَمَّا إِبْرَاہِیمُ فَإِنَّہُ بَاتَ بِمِنًی ، حَتَّی إِذَا أَصْبَحَ وَطَلَعَ حَاجِبُ الشَّمْسِ سَارَ حَتَّی نَزَلَ مَنْزِلَہُ مِنْ عَرَفَۃَ۔ (ابن خزیمۃ ۲۸۰۳)","Sahih","Musannaf Ibn Abi Shaybah 14765","","","كتاب الحج"
"14766","(۱۴۷۶۶) حدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَلَّی بِمِنًی الْفَجْرَ ، ثُمَّ مَکَثَ قَلِیلاً حَتَّی طَلَعَتِ الشَّمْسُ ، ثُمَّ سَارَ۔","Sahih","Musannaf Ibn Abi Shaybah 14766","","","كتاب الحج"
"14767","(۱۴۷۶۷) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا صَلَّیْتَ الْفَجْرَ فَسِرْ إلَی عَرَفَاتٍ ،فَأنْزِلْ مَنَازِلَ النَّاسِ ، الأَرَاکَ وَغَیْرَہُ مِنْ مَنَازِلِہِمْ۔","","Musannaf Ibn Abi Shaybah 14767","","","كتاب الحج"
"14768","(۱۴۷۶۸) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُ الأَئِمَّۃَ ، أَئِمَّۃَ الْمَوْسِمِ یَتَحَرَّوْنَ بِغُدُوِّہِمْ إِلَی عَرَفَاتٍ طُلُوعَ الشَّمْسِ ، وَلاَ أَرَاہُمْ تَحَرَّوْا بِہِ إِلاَّ فِعْلَ نَبِیِّہِمْ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 14768","","","كتاب الحج"
"14769","(۱۴۷۶۹) حدَّثَنَا وَکِیعٌ ، عَنْ أَفْلَحَ ، قَالَ : صَلَّیْتُ مَعَ الْقَاسِمِ الْفَجْرَ بِمِنًی ، ثُمَّ مَکَثَ سَاعَۃً ، ثُمَّ ارْتَحَلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14769","","","كتاب الحج"
"14770","(۱۴۷۷۰) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : لاَ یَخْرُجُ مِنْ مِنًی إِلَی عَرَفَاتٍ حَتَّی یُصَلِّیَ بِمِنًی الْغَدَاۃَ۔","","Musannaf Ibn Abi Shaybah 14770","","","كتاب الحج"
"14771","(۱۴۷۷۱) حدَّثَنَا أَبُو خَالِدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ اسْتَلَمَ الْحَجَرَ بِیَدِہِ وَقَبَّلَ یَدَہُ ، وَقَالَ: مَا تَرَکْتُہُ مُنْذُ رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَفْعَلُہُ۔ (مسلم ۲۴۶۔ بیہقی ۷۵)","Hasan","Musannaf Ibn Abi Shaybah 14771","","","كتاب الحج"
"14772","(۱۴۷۷۲) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ ، وَأَبَا ہُرَیْرَۃ إِذَا اسْتَلَمُوا الرُّکْنَ، یَعْنِی الْحَجَرَ ، قَبَّلُوا أَیْدِیَہُمْ ۔ قَالَ : قُلْتُ لِعَطَائٍ : وَابْنَ عَبَّاسٍ ؟ قَالَ : وَابْنُ عَبَّاسٍ ، حَسِبْتَ کَثِیرًا ، قَالَ : وَقَالَ عَطَائٌ : لَمْ أَمْسَحِ الرُّکْنَ إِنْ لَمْ أُقَبِّلْ یَدِی ۔ قَالَ : وَقَالَ عَمْرُو بْنُ دِینَارٍ : یَجْفَی مَنْ مَسَحَ الرُّکْنَ، وَلَمْ یُقَبِّلْ یَدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14772","","","كتاب الحج"
"14773","(۱۴۷۷۳) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُحَمَّدِ بْنِ الْمُرْتَفِعِ ، قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ ، وَعُمَرَ بْنَ عَبْدِ الْعَزِیزِ اسْتَلَمَا الْحَجَرَ ، فَأَمَّا أَحَدُہُمَا فَقَبَّلَ یَدَہُ ، وَالآخَرُ مَسَحَ بِہَا وَجْہَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14773","","","كتاب الحج"
"14774","(۱۴۷۷۴) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، وَأَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : مَا رَأَیْتُ أَبِی اسْتَلَمَ الْحَجَرَ ، إِلاَّ قَبَّلَ یَدَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14774","","","كتاب الحج"
"14775","(۱۴۷۷۵) حدَّثَنَا ابْنُ فُضَیْلٍ، وَعَبْدَۃَ، عَنْ عَبْدِ الْمَلِکِ، قَالَ: رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یَمْسَحُ الْحَجَرَ ، ثُمَّ یُقَبِّلُ یَدَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14775","","","كتاب الحج"
"14776","(۱۴۷۷۶) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، قَالَ : رَأَیْتُ مُجَاہِدًا ، وَسَعِیدَ بْنَ جُبَیْرٍ ، وَعَطَائً؛ إِذَا اسْتَلَمُوا الرُّکْنَ الْیَمَانِیَّ ، قَبَّلُوا أَیْدِیَہُمْ۔","","Musannaf Ibn Abi Shaybah 14776","","","كتاب الحج"
"14777","(۱۴۷۷۷) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِالرَّحْمَنِ، عَنْ حَسَنٍ، عَنْ طَارِقٍ، قَالَ: رَأَیْتُ عَلِیَّ بْنَ حُسَیْنٍ یَلْتَزِمُ الرُّکْنَ الْیَمَانِیَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 14777","","","كتاب الحج"
"14778","(۱۴۷۷۸) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَطَاوُسٍ ؛ فِی الرَّجُلِ یَنْسَی الرَّکْعَتَیْنِ اللَّتَیْنِ لِلطَّوَافِ الْوَاجِبِ ، قَالاَ : إِنْ صَلَّی بَعْدَہَا صَلاَۃً أَجْزَأَہُ ذَلِکَ ، وَإِنْ صَلَّی فِی أَدْنَی الْحَرَمِ وَأَقْصَاہُ أَجْزَأَہُ ، وَإِنْ لَمْ یُصَلِّ حَتَّی یَخْرُجَ مِنَ الْحَرَمِ أَہْرَاقَ دَمًا۔","","Musannaf Ibn Abi Shaybah 14778","","","كتاب الحج"
"14779","(۱۴۷۷۹) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ طَافَ بِالْبَیْتِ وَنَسِیَ أَنْ یُصَلِّیَ الرَّکْعَتَیْنِ حَتَّی مَضَی ، قَالَ : یُصَلِّیہِمَا إِذَا ذَکَرَ ، وَلَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 14779","","","كتاب الحج"
"14780","(۱۴۷۸۰) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ نَسِیَ رَکْعَتَیِ الطَّوَافِ ، قَالَ : یُصَلِّیہِمَا حَیْثُ مَا ذَکَرَہُمَا مَا لَمْ یَغْشَ النِّسَائَ۔","","Musannaf Ibn Abi Shaybah 14780","","","كتاب الحج"
"14781","(۱۴۷۸۱) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَتَّابِ بْنِ زِیَادِ بْنِ وَرْقَائَ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ لِلْحَلاَّقِ : اُبْلُغْ بِالْحَلْقِ إِلَی الْعَظْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 14781","","","كتاب الحج"
"14782","(۱۴۷۸۲) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَقُولُ لِلْحَلاَّقِ ، إِذَا حَلَقَ فِی الْحَجِّ وَالعمرۃ : اُبْلُغِ الْعَظْمَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 14782","","","كتاب الحج"
"14783","(۱۴۷۸۳) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَقُولُ لِلْحَلاَقِ : ابْدَأْ بِالأَیْمَنِ ، وَابْلُغْ بِالْحَلْقِ الْعَظْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 14783","","","كتاب الحج"
"14784","(۱۴۷۸۴) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُحَمَّدِ بْنِ الْحَارِثِ بْنِ سُفْیَانَ ، عَنْ عَلِیٍّ الأَزْدِیِّ، قَالَ: نَحَرَ ابْنُ عُمَرَ وَحَلَقَ ، قَالَ : فَسَمِعْتُہُ یَقُولُ لِلْحَلاَقِ : اُبْلُغِ الْعَظْمَیْنِ ، قَالَ : فَقُلْتُ لِعَطَائٍ : سَمِعْتُہُ یَقُولُ فِی الْحَلْقِ ، اُبْلُغِ الْعَظْمَیْنِ ؟ ، قَالَ : سَمِعْتُہُمْ یَذْکُرُونَہُ ، وَلَمْ أَسْمَعْہُ مِنْ ثَبْتٍ۔","","Musannaf Ibn Abi Shaybah 14784","","","كتاب الحج"
"14785","(۱۴۷۸۵) حدَّثَنَا جُنَیْدٌ الْحَجَّامُ ، عَنْ مُخْتَارِ بْنِ مُنَیْحٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : اُبْلُغْ إِلَی الْعَظْمَیْنِ۔","","Musannaf Ibn Abi Shaybah 14785","","","كتاب الحج"
"14786","(۱۴۷۸۶) حدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ ، عَنْ عَطَائٍ ، قَالَ : السُّنَّۃُ أَنْ یَبْلُغَ بِالْحَلْقِ إِلَی الْعَظْمَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 14786","","","كتاب الحج"
"14787","(۱۴۷۸۷) حدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَنَسٍ ؛ أَنَّہُ رَأَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِلْحَلاَّقِ ہَکَذَا ، وَأَشَارَ بِیَدِہِ إِلَی الْجَانِبِ الأَیْمَنِ۔ (مسلم ۳۲۵۔ ترمذی ۹۱۲)","Sahih","Musannaf Ibn Abi Shaybah 14787","","","كتاب الحج"
"14788","(۱۴۷۸۸) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرٍو ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَقُولُ لِلْحَلاَّقِ : ابْدَأْ بِالأَیْمَنِ۔","","Musannaf Ibn Abi Shaybah 14788","","","كتاب الحج"
"14789","(۱۴۷۸۹) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : أَخْبَرَنِی الرَّجُلُ الَّذِی قَصَّرَ عَنْ نَافِعِ بْنِ عَلْقَمَۃَ فِی إِمَارَتِہِ ، قَالَ : فَقَالَ لِی : ابْدَأْ بِالشِّقِّ الأَیْسَرِ ، قَالَ : قُلْتُ : إِنِّی قَصَّرْتُ عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ابْدَأْ بِالأَیْمَنِ ، قَالَ : امْضِ لِمَا أُمِرْتَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 14789","","","كتاب الحج"
"14790","(۱۴۷۹۰) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَرْمِی الْجِمَارَ إِذَا زَالَتِ الشَّمْسُ۔ (ترمذی ۸۹۸۔ احمد ۱/۲۴۸)","Hasan","Musannaf Ibn Abi Shaybah 14790","","","كتاب الحج"
"14791","(۱۴۷۹۱) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَرْمِی الْجِمَارَ إِذَا زَاغت الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 14791","","","كتاب الحج"
"14792","(۱۴۷۹۲) حدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ السَّائِبِ ، عَنْ مُحَمَّدِ بْنِ السَّائِبِ ، عنْ أَبِیہِ ، قَالَ : رَأَیْتُ عُمَرَ یَخْرُجُ إِذَا زَالَتِ الشَّمْسُ یَرْمِی الْجِمَارَ۔","Da'if","Musannaf Ibn Abi Shaybah 14792","","","كتاب الحج"
"14793","(۱۴۷۹۳) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنِ ابْنِ طَاوُوس ، قَالَ : یَرْمِی الْجِمَارَ إِذَا طَلَعَتِ الشَّمْسُ۔","Hasan","Musannaf Ibn Abi Shaybah 14793","","","كتاب الحج"
"14794","(۱۴۷۹۴) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : رَأَیْتُ ابْنَ الزُّبَیْرِ ، وَعُبَیْدَ بْنَ عُمَیْرٍ یَرْمِیَانِ الْجِمَارَ بَعْدَ مَا زَالَتِ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 14794","","","كتاب الحج"
"14795","(۱۴۷۹۵) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : رَمَقْتُ ابْنَ عَبَّاسٍ رَمَاہَا عِنْدَ الظَّہِیرَۃِ قَبْلَ أَنْ تَزُولَ۔","","Musannaf Ibn Abi Shaybah 14795","","","كتاب الحج"
"14796","(۱۴۷۹۶) حدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یَتَحَیَّنُ زَوَالَ الشَّمْسِ ، فَیَرْمِی الْجِمَارَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14796","","","كتاب الحج"
"14797","(۱۴۷۹۷) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی إِسْمَاعِیلَ : قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ ، وَطَاوُوسًا یَرْمِیَانِ الْجِمَارَ عِنْدَ زَوَالِ الشَّمْسِ ، وَیُطِیلاَنِ الْقِیَامَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14797","","","كتاب الحج"
"14798","(۱۴۷۹۸) حدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14798","","","كتاب الحج"
"14799","(۱۴۷۹۹) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَمِعْتُ عَطَائً یَقُولُ : لاَ تُرْمَی الْجَمْرَۃُ حَتَّی تَزُولَ الشَّمْسُ ، فَعَاوَدْتُہُ فِی ذَلِکَ ، فَقَالَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14799","","","كتاب الحج"
"14800","(۱۴۸۰۰) حدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، وَأَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَمَی جَمْرَۃَ الْعَقَبَۃِ یَوْمَ النَّحْرِ ضُحًی ، وَأَمَّا بَعْدُ فَإِذَا زَالَتِ الشَّمْسُ۔n(مسلم ۳۱۴۔ ابوداؤد ۵۱۱)","Sahih","Musannaf Ibn Abi Shaybah 14800","","","كتاب الحج"
"14801","(۱۴۸۰۱) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ مِثْلَہُ ، وَلَمْ یَرْفَعْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 14801","","","كتاب الحج"
"14802","(۱۴۸۰۲) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنِ الْحَسَنِ الْعُرَنِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَوْ عَنِ الْحَسَنِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَتَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِلَیْلٍ، فَرَحَّلَنَا عَلَی حُمُرَاتِ أُغَیْلِمَۃِ بَنِی عَبْدِ الْمُطَّلِبِ ، وَجَعَلَ یَلْطُخُ أَفْخَاذَنَا ، وَیَقُولُ : أُبَیْنِیَّ ، لاَ تَرْمُوا الْجَمْرَۃَ حَتَّی تَطْلُعَ الشَّمْسُ ، وَمَا أَحْسَبُ أَحَدًا یَرْمِیہَا حَتَّی تَطْلُعَ الشَّمْسُ ، وَکَانَ ابْنُ عَبَّاسٍ یَقُولُ : مَنْ أَفَاضَ مِنْ عُرْنَۃَ فَلاَ حَجَّ لَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 14802","","","كتاب الحج"
"14803","(۱۴۸۰۳) حدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إبِْرَاہِیمَ ، قَالَ : لاَ تُرْمَی جَمْرَۃُ الْعَقَبَۃِ یَوْمَ النَّحْرِ ، حَتَّی تَطْلُعَ الشَّمْسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14803","","","كتاب الحج"
"14804","(۱۴۸۰۴) حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عَبْدِ الصَّمَدِ الْعَمِّیُّ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : رَأَیْتُ أَبَا جَعْفَرٍ رَمَی الْجَمْرَۃَ قَبْلَ طُلُوعِ الشَّمْسِ ، وَکَانَ عَطَائٌ ، وَطَاوُوسٌ ، وَمُجَاہِدٌ ، وَالنَّخَعِیُّ ، وَعَامِرٌ ، وَسَعِیدُ بْنُ جُبَیْرٍ یَرْمُونَ حِینَ یَقْدَمُونَ ، أَیَّ سَاعَۃٍ قَدِمُوا ، لاَ یَرَوْنَ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14804","","","كتاب الحج"
"14805","(۱۴۸۰۵) حدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَرْمِیَ الرَّجُلُ جَمْرَۃَ الْعَقَبَۃِ قَبْلَ أَنْ تَطْلُعَ الشَّمْسُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14805","","","كتاب الحج"
"14806","(۱۴۸۰۶) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، قَالَتْ : وَدِدْتُ أَنِّی کُنْت اسْتَأْذَنْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَمَا اسْتَأْذَنَتْہُ سَوْدَۃُ ، أَنْ تَأْتِیَ مِنًی بِلَیْلٍ وَتَرْمِیَ مِنْ قَبْلِ أَنْ یَأْتِیَ النَّاسُ ، فَأَذِنَ لَہَا ، وَکَانَتِ امْرَأَۃً ثَبِطَۃً ثَقِیلَۃً۔ (بخاری ۱۶۸۰۔ مسلم ۲۹۵۔ احمد ۶/۹۸)","Hasan","Musannaf Ibn Abi Shaybah 14806","","","كتاب الحج"
"14807","(۱۴۸۰۷) حدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ ، قَالَ : کَانَ ابْنُ عُمَرَ یَبْعَثُ بِصِبْیَانِہِ لَیْلَۃَ الْمُزْدَلِفَۃِ فَیُصَلُّونَ الصُّبْحَ بِمِنًی ، وَیَرْمُونَ الْجَمْرَۃَ قَبْلَ أَنْ یَأْتِیَ النَّاسُ۔","Sahih","Musannaf Ibn Abi Shaybah 14807","","","كتاب الحج"
"14808","(۱۴۸۰۸) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ وَہُوَ مُحْرِمٌ۔ (بخاری ۱۸۳۵۔ ابوداؤد ۱۸۳۱)","Sahih","Musannaf Ibn Abi Shaybah 14808","","","كتاب الحج"
"14809","(۱۴۸۰۹) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ ، وَہُوَ مُحْرِمٌ ، مِنْ وَثْئٍ کَانَ بِہِ۔ (ابوداؤد ۱۸۳۱)","","Musannaf Ibn Abi Shaybah 14809","","","كتاب الحج"
"14810","(۱۴۸۱۰) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ مِقْسِم ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ وَہُوَ مُحْرِمٌ۔ (ابوداؤد ۲۳۶۵۔ احمد ۱/۲۱۵)","Da'if","Musannaf Ibn Abi Shaybah 14810","","","كتاب الحج"
"14811","(۱۴۸۱۱) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، قَالَ : قیلَ لِعَطَائٍ : یَحْتَجِمُ الْمُحْرِمُ ؟ فَقَالَ : نَعَمْ ، قَدْ فَعَلَ ذَلِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلَکِنْ لاَ یَحْلِقُ شَعْرًا۔","","Musannaf Ibn Abi Shaybah 14811","","","كتاب الحج"
"14812","(۱۴۸۱۲) حدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : یَحْتَجِمُ الْمُحْرِمُ ، وَلاَ یَحْلِقُ شَعْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14812","","","كتاب الحج"
"14813","(۱۴۸۱۳) حدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ الرَّازِیّ ، عَنْ حَنْظَلَۃَ ، قَالَ : سُئِلَ طَاوُوسُ : أَیَحْتَجِمُ الْمُحْرِمُ ؟ قَالَ : نَعَمْ ، إِذَا کَانَ وَجِعًا۔","","Musannaf Ibn Abi Shaybah 14813","","","كتاب الحج"
"14814","(۱۴۸۱۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : یَحْتَجِمُ الْمُحْرِمُ ، وَلاَ یَحْتَجِمُ الصَّائِمُ۔","","Musannaf Ibn Abi Shaybah 14814","","","كتاب الحج"
"14815","(۱۴۸۱۵) حدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ وَہُوَ مُحْرِمٌ۔ (ابوداؤد ۱۸۳۳۔ احمد ۳/۲۶۷)","Hasan","Musannaf Ibn Abi Shaybah 14815","","","كتاب الحج"
"14816","(۱۴۸۱۶) حدَّثَنَا مُعَلَّی بْنُ مَنْصُورٍ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ عَلْقَمَۃَ بْنِ أَبِی عَلْقَمَۃَ ، عَنِ الأَعْرَجِ ، عَنِ ابْنِ بُحَیْنَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ وَہُوَ مُحْرِمٌ۔ (مسلم ۸۸)","Sahih","Musannaf Ibn Abi Shaybah 14816","","","كتاب الحج"
"14817","(۱۴۸۱۷) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ وَہُوَ مُحْرِمٌ عَلَی ذُؤَابَتَیْہِ ، بِمَکَانٍ یُدْعَی لَحْیَی الْجَمَل۔","","Musannaf Ibn Abi Shaybah 14817","","","كتاب الحج"
"14818","(۱۴۸۱۸) حدَّثَنَا ابْن أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَرِہَا أَنْ یَحْتَجِمَ الْمُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 14818","","","كتاب الحج"
"14819","(۱۴۸۱۹) حدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ، عَنْ ہِشَامٍ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لاَ بَأْسَ أَنْ یَشُمَّ الْمُحْرِمُ الرَّیْحَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 14819","","","كتاب الحج"
"14820","(۱۴۸۲۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بِہِ بَأْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 14820","","","كتاب الحج"
"14821","(۱۴۸۲۱) حدَّثَنَا وَکِیعٌ ، عَنْ إِبرَہِیمَ بْنِ نَافِعٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَشُمَّ الْمُحْرِمُ الرَّیْحَانَ۔","","Musannaf Ibn Abi Shaybah 14821","","","كتاب الحج"
"14822","(۱۴۸۲۲) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ یُوسُفَ بْنِ مَاہِکٍ ، عَمَّنْ رَأَی مَعَ عَبْدِ اللہِ بْنِ عَامِرٍ بِعَرَفَۃَ فِی الْحَجِّ رَیْحَانًا ، وَہُوَ مُحْرِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 14822","","","كتاب الحج"
"14823","(۱۴۸۲۳) حدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْر ، قَالَ : حدَّثَنَا إِبْرَاہِیمُ بْنُ نَافِعٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ أَنْ یَشُمَّ الْمُحْرِمُ الرَّیْحَانَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14823","","","كتاب الحج"
"14824","(۱۴۸۲۴) حدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَشُمَّ الْمُحْرِمُ الإِذْخِرَ۔","","Musannaf Ibn Abi Shaybah 14824","","","كتاب الحج"
"14825","(۱۴۸۲۵) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، قَالَ : لاَ بَأْسَ أَنْ یَشُمَّ الْمُحْرِمُ طِیبَ نَبَاتِ الأَرْضِ ، وَبَعْر الظّباء ۔","","Musannaf Ibn Abi Shaybah 14825","","","كتاب الحج"
"14826","(۱۴۸۲۶) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، وَعَطَائٍ ، قَالاَ : لاَ بَأْسَ أَنْ یَشُمَّ الْمُحْرِمُ طِیبَ نَبَاتِ الأَرْضِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14826","","","كتاب الحج"
