hadiths[20]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3565","«زادك الله حرصا ولا تعد»","صحيح","Sahih al-Jami al-Saghir 3565","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3566","«زادني ربي صلاة وهي الوتر وقتها ما بين العشاء إلى طلوع الفجر»","صحيح","Sahih al-Jami al-Saghir 3566","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3567","«زار رجل أخا له في قرية فأرصد الله له ملكا على مدرجته فقال: أين تريد؟ قال: أخا لي في هذه القرية فقال: هل له عليك من نعمة تربها؟ قال: لا إلا أني أحبه في الله قال: فإني رسول الله إليك أن الله أحبك كما أحببته»","صحيح","Sahih al-Jami al-Saghir 3567","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3568","«زر عبا تزدد حبا»","صحيح","Sahih al-Jami al-Saghir 3568","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3569","«زره عليك ولو بشوكة»","حسن","Sahih al-Jami al-Saghir 3569","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3570","«زكاة الفطر طهرة للصائم من اللغو والرفث وطعمة للمساكين من أداها قبل الصلاة فهي زكاة مقبولة ومن أداها بعد الصلاة فهي صدقة من الصدقات»","صحيح","Sahih al-Jami al-Saghir 3570","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3571","«زكاة الفطر فرض على كل مسلم حر وعبد ذكر وأنثى من المسلمين صاع من تمر أو صاع من شعير»","صحيح","Sahih al-Jami al-Saghir 3571","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3572","«زمزم طعام طعم وشفاء سقم»","صحيح","Sahih al-Jami al-Saghir 3572","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3573","«زملوهم بدمائهم فإنه ليس من كلم يكلم في الله إلا وهو يأتي يوم القيامة يدمى لونه لون الدم وريحه ريح المسك»","صحيح","Sahih al-Jami al-Saghir 3573","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3574","«زن وأرجح»","صحيح","Sahih al-Jami al-Saghir 3574","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3575","«زنا العينين النظر»","صحيح","Sahih al-Jami al-Saghir 3575","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3576","«زنا اللسان الكلام»","صحيح","Sahih al-Jami al-Saghir 3576","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3577","«زوروا القبور فإنها تذكركم الآخرة»","صحيح","Sahih al-Jami al-Saghir 3577","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3578","«زوروا القبور ولا تقولوا هجرا»","صحيح","Sahih al-Jami al-Saghir 3578","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3579","«زودك الله التقوى وغفر ذنبك ويسر لك الخير حيثما كنت»","حسن","Sahih al-Jami al-Saghir 3579","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3580","«زينوا القرآن بأصواتكم»","صحيح","Sahih al-Jami al-Saghir 3580","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3581","«زينوا القرآن بأصواتكم فإن الصوت الحسن يزيد القرآن حسنا»","صحيح","Sahih al-Jami al-Saghir 3581","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3582","«الزبيب والتمر هو الخمر»","صحيح","Sahih al-Jami al-Saghir 3582","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3583","«الزبير ابن عمتي وحواريي من أمتي»","صحيح","Sahih al-Jami al-Saghir 3583","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
"3584","«الزكاة في هذه الأربعة: الحنطة والشعير والزبيب والتمر»","صحيح","Sahih al-Jami al-Saghir 3584","","","الأحاديث المبدوءة بحرف الزاي Hadith Beginning with the Letter Zay (ز)"
