hadiths[605]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَرَأَيْتَ إِنْغَمَسْتُ يَدَيَّ فِي كِظَامَةٍ غَمْسًا ؟ قَالَ : حَسْبُكَ ، وَالرِّجْلُ كَذَلِكَ وَلَكِنْ أَنْقِهَا ""","","","","","Book of Purification"
"2","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  فَاغْسِلُوا وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى الْمَرَافِقِ ، فِيمَا يُغْسَلُ ؟ قَالَ : نَعَمْ ، لا شَكَّ فِي ذَلِكَ ""","","","","","Book of Purification"
"3","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي زِيَادٌ , أَنَّ فُلَيْحَ بْنَ سُلَيْمَانَ أَخْبَرَهُ , أَنَّ أَبَا هُرَيْرَةَ تَوَضَّأَ فَغَسَلَ الرُّفْغَيْنِ ، فَقِيلَ لَهُ : مَا تُرِيدُ بِهَذَا ؟ قَالَ : أُرِيدُ أُحْسِنُ تَحْجِيلِي , أَوْ قَالَ : تَحِلْيَتِي ""","","","","","Book of Purification"
"4","عَنِ ابْنِ جُرَيْجٍ , قَالَ : عَنْ عَمْرِو بْنِ يَحْيَى بْنِ عُمَارَةَ بْنِ أَبِي حَسَنٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  كَانَيَمْسَحُ رَأْسَهُ مَرَّةً وَاحِدَةً بِكَفَّيْهِ يُقْبِلُ بِيَدَيْهِ ، وَيُدْبِرُ بِهِمَا عَلَى رَأْسِهِ مَرَّةً وَاحِدَةً ""","","","","","Book of Purification"
"5","عَنْ مَالِكٍ ، عَنْ عَمْرِو بْنِ يَحْيَى ، عَنْ أَبِيهِ ، عَنْ عَبْدِ اللَّهِ بْنِ زَيْدٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَسَحَ رَأْسَهُ بِيَدَيْهِ ، فَأَقْبَلَ بِهِمَا وَأَدْبَرَ بَدَأَ بِمُقَدَّمِ رَأْسِهِ ، ثُمَّ رَدَّهُمَا حَتَّى رَجَعَ إِلَى الْمَكَانِ الَّذِي بَدَأَ مِنْهُ ""","","","","","Book of Purification"
"6","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ ، أَنَّ ابْنَ عُمَرَ  كَانَيَضَعُ بَطْنَ كَفِّهِ الْيُمْنَى عَلَى الْمَاءِ ، ثُمَّ لا يَنْفُضُهَا ، ثُمَّ يَمْسَحُ بِهَا مَا بَيْنَ قَرْنِهِ إِلَى الْجَبِينِ مَرَّةً وَاحِدَةً , لا يَزِيدُ عَلَيْهَا ""","","","","","Book of Purification"
"7","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَيُدْخِلُ يَدَيْهِ فِي الْوَضُوءِ ، فَيَمْسَحُ بِهِمَا مَسْحَةً وَاحِدَةً الْيَافُوخَ قَطْ ""","","","","","Book of Purification"
"8","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ رَبِّهِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ  أَنَّهُ كَانَيَمْسَحُ رَأْسَهُ مَرَّةً ""","","","","","Book of Purification"
"9","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنِ الْكَلْبِيِّ ، عَنِ الأَصْبَغِ بْنِ بُنَاتَةَ ، عَنْ عَلِيٍّ  أَنَّهُتَوَضَّأَ فَمَسَحَ رَأْسَهُ مَسْحَةً وَاحِدَةً ""","","","","","Book of Purification"
"10","عَنْ إِسْرَائِيلَ ، عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ , قَالَ : سَمِعْتُ مُجَاهِدًا , يَقُولُ : لَوْ كُنْتُ عَلَى شَاطِئِ الْفُرَاتِ , مَا مَسَحْتُ بِرَأْسِي إِلا وَاحِدَةً ""","","","","","Book of Purification"
"11","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ، عَنِ الرُّبَيِّعِ بِنْتِ عَفْرَاءَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : تَوَضَّأَ وَمَسَحَ رَأْسَهُ مَرَّتَيْنِ "", قَالَ : وَبَلَغَنِي أَنَّ عَلِيًّا , قَالَ : "" مَسَحَ ثَلاثًا ""","","","","","Book of Purification"
"12","عَنْ إِسْرَائِيلَ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَمْرِو بْنِ عَامِرٍ , قَالَ :  رَأَيْتُ عَلِيًّاتَوَضَّأَ ، ثُمَّ أَخَذَ كَفًّا مِنْ مَاءٍ ، فَوَضَعَهُ عَلَى رَأْسِهِ ، فَرَأَيْتُهُ يَنْحَدِرُ عَلَى نَوَاحِي رَأْسِهِ كُلِّهِ ""","","","","","Book of Purification"
"13","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : أَكْثَرُ مَا أَمْسَحُ بِرَأْسِي ثَلاثَ مِرَارٍ لا أَزِيدُ ، وَلا أَنْقُصُ بِكَفٍّ وَاحِدٍ مِنْ غَيْرِ أَنْ أُوجِبَهُ ""","","","","","Book of Purification"
"14","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ , قَالَ : إِذَا مَسَحَ بَعْضَ رَأْسِهِ أَجْزَأَهُ ""","","","","","Book of Purification"
"15","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : كَيْفَ يَمْسَحُ ذُو الضَّفِيرَتَيْنِ بِرَأْسِهِ ؟ قَالَ : فِيمَا عَلَى رَأْسِهِ مِنْهُمَا فَقَطْ ، وَلا يَحْلِقُ رَأْسَهُ ، وَلا يَمْسَحُ بِأَطْرَافِ الشَّعْرِ ""، ثُمَّ وَضَعَ عَطَاءٌ يَدَهُ عَلَى رَأْسِهِ فَمَسَحَ الشَّعْرَ عَلَى مَنَابِتِهِ ، وَأَمَرَّ كَفَّيْهِ عَلَى مَا عَلَى رَأْسِهِ مِنْهُ فَصَبَّ كَفَّيْهِ ، وَلَمْ يُرْجِعْهُمَا مُصْعِدًا مُسْتَقْبِلَ الشَّعْرِ ، وَلَقَدْ رَأَيْتُ وَلَمْ يُعِدِ الرَّأْسَ ، وَسَأَلْتُهُ عَنْ صَاحِبِ الْجُمَّةِ ؟ , فَقَالَ : هَذَا الْقَوْلُ فِيهِمَا جَمِيعًا ، وَلَقَدْ رَأَيْتُ عُبَيْدَ بْنَ عُمَيْرٍ وَكَانَ ذَا جُمَّةٍ , فَكَانَ يَكُفُّ مَا عَلَى وَجْهِهِ مِنْهَا فَفَعَلَهُ بَيْنَ أُذُنَيْهِ وَرَأْسِهِ , فَكَانَ يَمَسُّ تِلْكَ الَّتِي يَجْعَلُ بَيْنَ أُذُنَيْهِ ، وَرَأْسِهِ ، وَلَمْ يَكُنْ يَمَسُّ مِنْ جُمَّتِهِ إِلا مَا عَلَى رَأْسِهِ مَنهُ فَقَطْ ""","","","","","Book of Purification"
"16","عَنِ الثَّوْرِيِّ , قَالَ : إِذَا مَسَحَ الرَّجُلُ بِرَأْسِهِ ، وَلَمْ يَمْسَحْ بِأُذُنَيْهِ أَجْزَأَهُ ، وَإِنْ مَسَحَ بِأُذُنَيْهِ وَلَمْ يَمْسَحْ بِرَأْسِهِ لَمْ يُجْزِئْهُ ""","","","","","Book of Purification"
"17","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي مَنْ ، سَمِعَ الْحَسَنَ , يَقُولُ : يَكْفِيكَ أَنْ تَمْسَحَ رَأْسَكَ بِمَا فِي يَدَيْكَ مِنَ الْوَضُوءِ ""","","","","","Book of Purification"
"18","عَنْ إِسْرَائِيلَ ، عَنْ مُوسَى بْنِ أَبِي عَائِشَةَ , قَالَ : سَمِعْتُ مُصْعَبَ بْنَ سَعْدٍ وَسَأَلَهُ رَجُلٌ ، فَقَالَ : أَتَوَضَّأُ وَأَغْسِلُ وَجْهِي وَذِرَاعَيَّ , فَيَكْفِينِي مَا فِي يَدَيَّ لِرَأْسِي ، أَوْ أُحْدِثُ لِرَأْسِي مَاءً ؟ قَالَ : لا بَلْ أَحْدِثْ لِرَأْسِكَ مَاءً ""","","","","","Book of Purification"
"19","أَخْبَرَنَا مَعْمَرٌ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَيُحْدِثُ لِرَأْسِهِ مَاءً "", قَالَ : أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , مِثْلَهُ""","","","","","Book of Purification"
"20","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنَا ابْنُ عَجْلانَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  كَانَيَمْسَحُ بِأُذُنَيْهِ مَعَ وَجْهِهِ مَرَّةً ، وَيَمْسَحُ بِرَأْسِهِ يُدْخِلُ كَفَّيْهِ فِي الْمَاءِ ، ثُمَّ يَمْسَحُ بِهِمَا مَا أَقْبَلَ مِنْ رَأْسِهِ الْيَافُوخَ , ثُمَّ الْقَفَا ، ثُمَّ الصُّدْغَيْنِ ، ثُمَّ يَمْسَحُ بِأُذُنَيْهِ مَسْحَةً وَاحِدَةً , كُلُّ ذَلِكَ بِمَا فِي كَفِّهِ مِنْ تِلْكَ الْمَسْحَةِ الْوَاحِدَةِ ""","","","","","Book of Purification"
"21","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :بِفَضْلِ وَجْهِكَ تَمْسَحُ رَأْسَكَ ؟ , قَالَ :  لا ، وَلَكِنْ أَغْمِسُ يَدَيَّ فِي الْمَاءِ , وَأَمْسَحُ بِهِمَا ، وَلا أَنْفُضُهُمَا ، وَلا أَنْتَظِرُ أَنْ يَجِفَّ الَّذِي فِيهِمَا مِنَ الْمَاءِ ، وَإِنِّي لَحَرِيصٌ عَلَى بَلِّ الشَّعْرِ ""","","","","","Book of Purification"
"22","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي سُلَيْمَانُ بْنُ مُوسَى ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الأُذُنَانِ مِنَ الرَّأْسِ ""","","","","","Book of Purification"
"23","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : الأُذُنَانِ مِنَ الرَّأْسِ "", عَنِ الثَّوْرِيِّ ، عَنْ أَبِي النَّضْرِ ، عَنْ سَعِيدِ ابْنِ مَرْجَانَةَ ، عَنِ ابْنِ عُمَرَ مِثْلَهُ""","","","","","Book of Purification"
"24","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ ، أَنَّ ابْنَ عُمَرَ  كَانَيَغْسِلُ ظُهُورَ أُذُنَيْهِ وَبُطُونَهُمَا إِلا الصِّمَاخَ مَعَ الْوَجْهِ مَرَّةً , أَوْ مَرَّتَيْنِ , وَيُدْخِلُ بِإِصْبَعَيْهِ بَعْدَمَا يَمْسَحُ بِرَأْسِهِ فِي الْمَاءِ ، ثُمَّ يُدْخِلُهُمَا فِي الصِّمَاخِ مَرَّةً، وَقَالَ : فَرَأَيْتُهُ وَهُوَ يَمُوتُ تَوَضَّأَ ، ثُمَّ أَدْخَلَ إِصْبَعَيْهِ فِي الْمَاءِ , فَجَعَلَ يُرِيدُ أَنْ يُدْخِلَهُمَا فِي صِمَاخِهِ فَلا يَهْتَدِيَانِ ، وَلا يَنْتَهِي حَتَّى أَدْخَلْتُ أَنَا إِصْبَعِي فِي الْمَاءِ , فَأَدْخَلتُهُمَا فِي صِمَاخِهِ ""","","","","","Book of Purification"
"25","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ ، عَنْ يَزِيدَ بْنِ الأَصَمِّ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : الأُذُنَانِ مِنَ الرَّأْسِ ""","","","","","Book of Purification"
"26","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ , قَالَ :  كُنَّانُوَضِّئُ ابْنَ عُمَرَ وَهُوَ مَرِيضٌ , فَيَأْمُرُنَا أَنْ نَمْسَحَ بِأُذُنَيْهِ عَلَى مَا كَانَ يَمْسَحُ "", قَالَ : وَأَخْبَرَنِي أَيُّوبُ ، عَنْ نَافِعٍ , قَالَ : فَنَسِينَا مَرَّةً أَنْ نَمْسَحَ بِأُذُنَيْهِ , فَجَعَلَ يُدْنِي يَدَيْهِ إِلَى أُذُنَيْهِ فَلا يُطِيقُ أَنْ يَبْلُغَ أُذُنَيْهِ ، وَلا نَدْرِي مَا يُرِيدُ ، حَتَّى انْتَبَهْنَا بَعْدُ فَمَسَحْنَاهُمَا , فَسَكَنَ""","","","","","Book of Purification"
"27","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَيَمْسَحُ بِأُذُنَيْهِ مَعَ رَأْسِهِ إِذَا تَوَضَّأَ ، يُدْخِلُ إِصْبَعَيْهِ فِي الْمَاءِ ، فَمَسَحَ بِهِمَا أُذُنَيْهِ ، ثُمَّ يَرُدُّ إِبْهَامَيْهِ خَلْفَ أُذُنَيْهِ ""","","","","","Book of Purification"
"28","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَيُدْخِلُ يَدَيْهِ فِي الْوَضُوءِ , يَمْسَحُ بِهِمَا مَسْحَةً وَاحِدَةً عَلَى الْيَافُوخِ فَقَطْ ، ثُمَّ يُدْخِلُ إِصْبَعَيْهِ فِي الْمَاءِ ، ثُمَّ يُدْخِلُهُمَا فِي أُذُنَيْهِ ، ثُمَّ يَرُدُّ إِبْهَامَيْهِ خَلْفَ أُذُنَيْهِ ""","","","","","Book of Purification"
"29","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّهُ كَانَ يَمْسَحُ الأُذُنَيْنِ ، وَيَقُولُ : الأُذُنَانِ مِنَ الرَّأْسِ ""","","","","","Book of Purification"
"30","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي مَعْشَرٍ ، عَنْ إِبْرَاهِيمَ ، أَنَّهُ كَانَ يَمْسَحُ ظُهُورَ الأُذُنَيْنِ , وَبُطُونَهُمَا ""","","","","","Book of Purification"
"31","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : تَتْبَعُ بِإِصْبَعَيْكَ بُطُونَ الأُذُنَيْنِ , تَغْسِلُهُمَا بِفَضْلِ وَجْهِكَ مِنَ الْمَاءِ كُلَّمَا غَرَفْتَ عَلَى وَجْهِكَ ، قُلْتُ : أَرَأَيْتَ إِنْ أَخَّرْتُ مَسْحَهُمَا حَتَّى أَمْسَحَهُمَا مَعَ الرَّأْسِ ؟ قَالَ : لا يَضُرُّكَ ""","","","","","Book of Purification"
"32","عَنْ إِسْرَائِيلَ ، عَنْ عَامِرٍ ، عَنْ شَقِيقِ بْنِ سَلَمَةَ ، عَنْ عُثْمَانَ  أَنَّهُتَوَضَّأَ فَمَسَحَ بِأُذُنَيْهِ ظَاهِرَهُمَا , وَبَاطِنَهُمَا ، وَقَالَ : رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُهُ ""","","","","","Book of Purification"
"33","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ، عَنِ الرُّبَيِّعِ بِنْتِ عَفْرَاءَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَسَحَ بِأُذُنَيْهِ ظَاهِرَهُمَا , وَبَاطِنَهُمَا ""","","","","","Book of Purification"
"34","عَنِ الثَّوْرِيِّ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِيِّ , قَالَ : مَا اسْتَقْبَلَ الْوَجْهَ مِنَ الأُذُنَيْنِ فَهُوَ مِنَ الْوَجْهِ "" , يَقُولُ : "" يَغْسِلُهُ وَظَاهِرَهُمَا مِنَ الرَّأْسِ ""","","","","","Book of Purification"
"35","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ حُسَيْنِ بْنِ عَبْدِ اللَّهِ بْنِ عُبَيْدِ اللَّهِ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : الأُذُنَانِ لَيْسَتَا مِنَ الْوَجْهِ ، وَلَيْسَتَا مِنَ الرَّأْسِ ، وَلَوْ كَانَتَا مِنَ الرَّأْسِ لَكَانَ يَنْبَغِي أَنْ يُحْلَقَ مَا عَلَيْهَا مِنَ الشَّعْرِ ، وَلَوْ كَانَتَا مِنَ الْوَجْهِ لَكَانَ يَنْبَغِي أَنْ يُغْسَلَ ظُهُورُهُمَا , وَبُطُونُهُمَا مَعَ الْوَجْهِ ""","","","","","Book of Purification"
"36","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : مِنْ أَيْنَ تَرَى الأُذُنَيْنِ ؟ , قَالَ : مِنَ الرَّأْسِ , قَالَ : وَأَمْسَحُهُمَا مَعَ الْوَجْهِ كُلَّمَا أَفْرَغْتُ عَلَى وَجْهِي ، قُلْتُ : أَحَقٌّ عَلَيَّ أَنْ أُخْرِجَ وَسَخَ الأُذُنَيْنِ ؟ , قَالَ : لا ""","","","","","Book of Purification"
"37","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  كَيْفَ يَمْسَحُ الأَصْلَعُ ؟ قَالَ :"" يَمْسَحُ رَأْسَهُ كُلَّهُ مَا فِيهِ شَعْرٌ ، وَمَا هُوَ أَصْلَعُ مِنْهُ يُصِيبُهُ الْمَاءُ مَا أَصَابَ ، وَيُخْطِئُ مَا أَخْطَأَ وَلَيْسَ عَلَيْهِ أَنْ يُنَقِّيَهُ ""","","","","","Book of Purification"
"38","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ  سُئِلَ عَنْرَجُلٍ نَسِيَ أَنْ يَمْسَحَ بِرَأْسِهِ حَتَّى صَلَّى , قَالَ : إِنْ شَاءَ أَعَادَ الْوُضُوءَ , وَالصَّلاةَ ""","","","","","Book of Purification"
"39","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : إِنْ نَسِيتَ الْمَسْحَ بِالرَّأْسِ فَصَلَّيْتَ , ثُمَّ ذَكَرْتَ فَامْسَحْ بِرَأْسِكَ ، وَأَعِدِ الصَّلاةَ, قَالَ : وَبَلَغَنِي عَنْهُ وَلا أَدْرِي أَنِّي قَدْ سَمِعْتُهُ , يَقُولُ : إِنْ كَانَ فِي لِحْيَتِكَ بَلَلٌ , فَامْسَحْ مِنْهَا ""","","","","","Book of Purification"
"40","عَنْ مَعْمَرٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ  فِي الَّذِينَسِيَ مَسْحَ الرَّأْسِ فِي الْوُضُوءِ , قَالَ : إِنْ كَانَ فِي لِحْيَتِهِ بَلَلٌ فَلْيَمْسَحْ بِرَأْسِهِ فَقَطْ ، وَلْيُعِدِ الصَّلاةَ ""","","","","","Book of Purification"
"41","عَنِ الثَّوْرِيِّ , قَالَ : إِذَا نَسِيَ الْمَسْحَ مَسَحَ ، وَأَعَادَ الصَّلاةَ ، وَلَمْ يُعِدِ الْوُضُوءَ ، وَإِذَا نَسِيَ الْمَسْحَ فَأَصَابَ رَأْسَهُ مَطَرٌ , فَإِنَّهُ يُجْزِيهِ هُوَ طَهُورٌ ""","","","","","Book of Purification"
"42","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ فِي رَجُلٍ نَسِيَ أَنْ يَسْتَنْشِقَ ، أَوْ يَمْسَحَ بِأُذُنَيْهِ ، أَوْ يَتَمَضْمَضَ حَتَّى دَخَلَ فِي الصَّلاةِ ، ثُمَّ ذَكَرَ فَإِنَّهُ لا يَنْصَرِفُ لِذَلِكَ ؟ قَالَ : فَإِنْ كَانَ نَسِيَ أَنْ يَمْسَحَ بِرَأْسِهِ فَذَكَرَ وَهُوَ فِي الصَّلاةِ ، فَإِنَّهُ يَنْصَرِفُ وَمَسَحَ بِرَأْسِهِ ""","","","","","Book of Purification"
"43","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : إِنْ نَسِيَ الْمَسْحَ بِالرَّأْسِ أَعَادَ الصَّلاةَ ""","","","","","Book of Purification"
"44","عَنِ الثَّوْرِيِّ  فِيرَجُلٍ نَسِيَ الْمَسْحَ بِرَأْسِهِ , ثُمَّ قَامَ فَكَبَّرَ فِي الصَّلاةِ فَضَحِكَ , قَالَ : يَنْصَرِفُ وَيَمْسَحُ بِرَأْسِهِ وَلا يُعِيدُ الْوُضُوءَ , لأَنَّهُ لَمْ تَكُنْ صَلاتُهُ وَلا وُضُوءٌ تَامٌّ ""","","","","","Book of Purification"
"45","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ , قَالَ : إِذَا نَسِيتَ الْمَسْحَ بِالرَّأْسِ فَوَجَدْتَ فِي لِحْيَتِكَ بَلَلا , فَامْسَحْ بِهَا رَأْسَكَ ""، عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، وَالثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , مِثْلَهُ , قَالَ الثَّوْرِيُّ : "" وَكَانَ غَيْرُهُ يَسْتَحِبُّ مِنْ مَاءٍ غَيْرِهِ "" , قَالَ سُفْيَانُ : "" أَرَاهُ مُصْعَبَ بْنَ سَعْدٍ ""","","","","","Book of Purification"
"46","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ مُوسَى بْنِ أَبِي عَائِشَةَ , قَالَ : سَمِعْتُ مُصْعَبَ بْنَ سَعْدٍ وَسَأَلَهُ رَجُلٌ ، فَقَالَ : أَتَوَضَّأُ فَأَغْسِلُ وَجْهِي وَذِرَاعَيَّ فَيَكْفِينِي مَا فِي يَدَيَّ لِلرَّأْسِ أَمْ أُحْدِثُ لِرَأْسِي مَاءً ؟ قَالَ : بَلْ أَحْدِثْ لِرَأْسِكَ مَاءً ""","","","","","Book of Purification"
"47","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ , قَالَ : سَأَلْتُ ابْنَ الْمُسَيِّبِ كَيْفَ تَمْسَحُ الْمَرْأَةُ رَأْسَهَا ؟ , قَالَ : تَسْلَخُ خِمَارَهَا ، ثُمَّ تَمْسَحُ رَأْسَهَا ""","","","","","Book of Purification"
"48","عَنْ مَالِكٍ ، عَنْ نَافِعٍ , قَالَ :  رَأَيْتُ صَفِيَّةَ بِنْتَ أَبِي عُبَيْدٍ تَوَضَّأَتْ وَأَنَا غُلامٌ ,فَإِذَا أَرَادَتْ أَنْ تَمْسَحَ رَأْسَهَا سَلَخَتِ الْخِمَارَ ""","","","","","Book of Purification"
"49","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : تَمْسَحُ عَلَى ثِيَابِهَا أَوَّلَ النَّهَارِ , وَتُمِسُّ الْمَاءَ أَطْرَافَ شَعْرِ قُصَّتِهَا مِنْ نَحْوِ الْجَبِينِ ""","","","","","Book of Purification"
"50","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ عِكْرِمَةَ ، وَالْحَسَنِ ، قَالا : فِي هَذِهِ الآيَةِ  يَأَيُّهَا الَّذِينَ آمَنُوا إِذَا قُمْتُمْ إِلَى الصَّلاةِ فَاغْسِلُوا وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى الْمَرَافِقِ وَامْسَحُوا بِرُءُوسِكُمْ وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِ ، قَالا : تَمْسَحُ الرِّجْلَيْنِ ""","","","","","Book of Purification"
"51","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ جَابِرِ بْنِ يَزِيدَ ، أَوْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : افْتَرَضَ اللَّهُ غَسْلَتَيْنِ وَمَسْحَتَيْنِ , أَلا تَرَى أَنَّهُ ذَكَرَ التَّيَمُّمَ , فَجَعَلَ مَكَانَ الْغَسْلَتَيْنِ مَسْحَتَيْنِ , وَتَرَكَ الْمَسْحَتَيْنِ "", وَقَالَ رَجُلٌ لِمَطَرٍ الْوَرَّاقِ : مَنْ كَانَ يَقُولُ : الْمَسْحُ عَلَى الرِّجْلَيْنِ ؟ , فَقَالَ : فُقَهَاءُ كَثِيرٌ""","","","","","Book of Purification"
"52","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، أَنَّهُ سَمِعَ عِكْرِمَةَ يَقُولُ : قَالَ ابْنُ عَبَّاسٍ : الْوُضُوءُ مَسْحَتَانِ , وَغَسْلَتَانِ ""","","","","","Book of Purification"
"53","عَنِ ابْنِ عُيَيْنَةَ , قَالَ : حَدَّثَنَا إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ، عَنِ الشَّعْبِيِّ , قَالَ :  أَمَّا جِبْرِيلُ عَلَيْهِ السَّلامُ فَقَدْ نَزَلَ بِالْمَسْحِ عَلَى الْقَدَمَيْنِ ""","","","","","Book of Purification"
"54","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي السَّوْدَاءِ , قَالَ : سَمِعْتُ ابْنَ عَبْدِ خَيْرٍ يُحَدِّثُ ، عَنْ أَبِيهِ , قَالَ : رَأَيْتُ عَلِيًّا يَتَوَضَّأُ , فَجَعَلَ يَغْسِلُ ظَهْرَ قَدَمَيْهِ ، وَقَالَ :  لَوْلا أَنِّي رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَغْسِلُ ظَهْرَ قَدَمَيْهِ , لَرَأَيْتُ بَاطِنَ الْقَدَمَيْنِ أَحَقَّ بِالْغَسْلِ مِنْ ظَاهِرِهِمَا ""","","","","","Book of Purification"
"55","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : لِمَ لا أَمْسَحُ بِالْقَدَمَيْنِ كَمَا أَمْسَحُ بِالرَّأْسِ وَقَدْ قَالَهُمَا جَمِيعًا , قَالَ : لا أَرَاهُ إِلا مَسَحَ الرَّأْسَ وَغَسَلَ الْقَدَمَيْنِ ، إِنِّي سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : وَيْلٌ لِلأَعْقَابِ مِنَ النَّارِ "", قَالَ عَطَاءٌ : وَإِنَّ أُنَاسًا لَيَقُولُونَ : هُوَ الْمَسْحُ , وَأَمَّا أَنَا فَأَغْسِلُهُمَا ""","","","","","Book of Purification"
"56","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ ابْنَ مَسْعُودٍ , قَالَ : رَجَعَ إِلَى غَسْلِ الْقَدَمَيْنِ فِي قَوْلِهِ :  وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِ ""","","","","","Book of Purification"
"57","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، أَنَّ أَبَاهُ , قَالَ :  إِنَّالْمَسْحَ عَلَى الرِّجْلَيْنِ رَجَعَ إِلَى الْغَسْلِ فِي قَوْلِهِ :  وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِ ""","","","","","Book of Purification"
"58","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ، عَنْ عُثْمَانَ بْنِ أَبِي سُوَيْدٍ ، أَنَّهُ ذَكَرَ لِعُمَرَ بْنِ عَبْدِ الْعَزِيزِ الْمَسْحَ عَلَى الْقَدَمَيْنِ , فَقَالَ : لَقَدْ بَلَغَنِي عَنْ ثَلاثَةٍ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَدْنَاهُمُ ابْنُ عَمِّكَ الْمُغِيرَةُ بْنُ شُعْبَةَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : غَسَلَ قَدَمَيْهِ ""","","","","","Book of Purification"
"59","أَخْبَرَنَا مَعْمَرٌ ، عَنْ مُحَمَّدِ بْنِ زِيَادٍ , قَالَ : رَأَيْتُ أَبَا هُرَيْرَةَ مَرَّ بِقَوْمٍ يَتَوَضَّئُونَ مِنَ الْمِطْهَرَةِ , فَقَالَ : أَحْسِنُوا الْوُضُوءَ يَرْحَمُكُمُ اللَّهُ , أَلَمْ تَسْمَعُوا مَا قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : وَيْلٌ لِلأَعْقَابِ مِنَ النَّارِ ""","","","","","Book of Purification"
"60","أَخْبَرَنَا مَعْمَرٌ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : وَيْلٌ لِلأَعْقَابِ مِنَ النَّارِ ""","","","","","Book of Purification"
"61","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ ، عَنْ رَجُلٍ ، عَنْ أَبِي ذَرٍّ قَالَ : أَشْرَفَ عَلَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ نَتَوَضَّأُ , فَقَالَ : وَيْلٌ لِلأَعْقَابِ مِنَ النَّارِ "", قَالَ : فَطَفِقْنَا نَغْسِلُهَا غَسْلا , وَنُدَلِّكُهَا دَلْكًا""","","","","","Book of Purification"
"62","عَنْ مَعْمَرٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ، عَنِ الرُّبَيِّعِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : غَسَلَ قَدَمَيْهِ ثَلاثًا ثَلاثًا "", ثُمَّ قَالَتْ لَنَا : أَنَّ ابْنَ عَبَّاسٍ قَدْ دَخَلَ عَلَيَّ فَسَأَلَنِي عَنْ هَذَا الْحَدِيثِ فَأَخْبَرْتُهُ , فَقَالَ : يَأْبَى النَّاسُ , إِلا الْغَسْلَ وَنَجِدُ فِي كِتَابِ اللَّهِ تَعَالَى , الْمَسْحَ يَعْنِي : الْقَدَمَيْنِ""","","","","","Book of Purification"
"63","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : إِذَا اغْتَرَفْتَ بِيَدَيْكَ جَمِيعًا عَلَى قَدَمَيْكَ , فَاغْسِلِ الَّتِي تَغْسِلُ بِهَا بَطْنَ قَدَمَيْكَ قَبْلَ أَنْ تُدْخِلَهَا فِي الْمَاءِ ""","","","","","Book of Purification"
"64","عَنْ مَعْمَرٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، كَانَ يَقُولُ : خَلِّلُوا أصَابِعَكُمْ بِمَاءٍ , قَبْلَ أَنْ يُخَلِّلَهَا اللَّهُ بِالنَّارِ ""","","","","","Book of Purification"
"65","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي مِسْكِينٍ ، عَنْ هُزَيْلِ ابْنِ شُرَحْبِيلَ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ : لَيَنْتَهِكَنَّ رَجُلٌ بَيْنَ أَصَابِعِهِ فِي الْوُضُوءِ , أَوْ لَيَنْتَهِكَنَّهُ النَّارُ ""","","","","","Book of Purification"
"66","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مُحَمَّدِ بْنِ عَجْلانَ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ , قَالَ : تَوَضَّأَ عَبْدُ الرَّحْمَنِ بْنُ أَبِي بَكْرٍ عِنْدَ عَائِشَةَ , فَقَالَتْ لَهُ : أَسْبِغِ الْوُضُوءَ ، فَإِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : وَيْلٌ لِلأَعْقَابِ مِنَ النَّارِ ""","","","","","Book of Purification"
"67","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  كَانَإِذَا غَسَلَ قَدَمَيْهِ خَلَّلَ أَصَابِعَهُ ""","","","","","Book of Purification"
"68","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ طَلْحَةَ بْنِ مُصَرِّفٍ ، وَحُذَيْفَةَ بْنِ الْيَمَانِ ، قَالا : خَلِّلُوا الأَصَابِعَ , لا يَحْشُهُنَّ اللَّهُ نَارًا ""","","","","","Book of Purification"
"69","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، أَنَّ أَبَا بَكْرٍ  كَانَيُخَلِّلُ أَصَابِعَهُ إِذَا تَوَضَّأَ ""","","","","","Book of Purification"
"70","عَنِ ابْنِ جُرَيْجٍ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَفِي تَوَضُّئِهِ يُنَقِّي رِجْلَيْهِ ، وَيُنَظِّفُ أَصَابِعَ يَدَيْهِ مَعَ أَصَابِعِ رِجْلَيْهِ ، وَيُتْبِعُ ذَلِكَ حَتَّى يُنَقِّيَهُ ""","","","","","Book of Purification"
"71","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَيُخَلِّلُ أَصَابِعَهُ إِذَا تَوَضَّأَ ""","","","","","Book of Purification"
"72","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ ، عَنْ مُحَمَّدِ بْنِ مَحْمُودٍ ، أَنَّهُ بَلَغَهُ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَظَرَ إِلَى رَجُلٍ أَعْمَى يَتَوَضَّأُ ، فَجَعَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : بَطْنُ الْقَدَمِ "" , وَلا يَسْمَعُهُ الأَعْمَى ، وَجَعَلَ الأَعْمَى يَغْسِلُ بَطْنَ الْقَدَمَيْنِ , فَسُمِّيَ الْبَصِيرَ""","","","","","Book of Purification"
"73","عَنْ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَيَغْسِلُ قَدَمَيْهِ بِأَكْثَرَ وَضُوئِهِ "", قَالَ عَبْدُ الرَّزَّاقِ : وَوَضَّأْتُ أَنَا الثَّوْرِيَّ فَرَأَيْتُهُ يَفْعَلُ ذَلِكَ , يَغْسِلُهُمَا فَيُكْثِرُ""","","","","","Book of Purification"
"74","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ مُحَمَّدِ بْنِ مَحْمُودٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَظَرَ إِلَىرَجُلٍ مَحْجُوبِ الْبَصَرِ يَتَوَضَّأُ وَهُوَ مِنْهُ مُتَنَاءٍ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  قَلِيلٌ بَطْنُ الْقَدَمَيْنِ "" , فَغَسَلَ بَطْنَ الْقَدَمِ , فَسُمِّيَ الْبَصِيرُ""","","","","","Book of Purification"
"75","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : قَوْلُهُ :  وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِ تَرَى الْكَعْبَيْنِ فِيمَا يُغْسَلُ مِنَ الْقَدَمَيْنِ ؟ , قَالَ : نَعَمْ ، لا شَكَّ فِيهِ ""","","","","","Book of Purification"
"76","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ كَثِيرٍ ، عَنْ عَاصِمِ بْنِ لَقِيطِ بْنِ صَبِرَةَ ، عَنْ أَبِيهِ ، أَنَّهُ أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرَ أَشْيَاءَ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَسْبِغِ الْوُضُوءَ ، وَخَلِّلِ الأَصَابِعَ ، وَإِذَا اسْتَنْثَرْتَ فَأَبْلِغْ , إِلا أَنْ تَكُونَ صَائِمًا ""","","","","","Book of Purification"
"77","قَالَ : أنا ابْنُ جُرَيْجٍ , قَالَ : ثنا إِسْمَاعِيلُ بْنُ كَثِيرٍ أَبُو هَاشِمٍ الْمَكِّيُّ ، عَنْ عَاصِمِ بْنِ لَقِيطِ بْنِ صَبِرَةَ ، عَنْ أَبِيهِ ، أَوْ جَدِّهِ , قَالَ : انْطَلَقْتُ أَنَا وَأَصْحَابٌ لِي حَتَّى انْتَهَيْنَا إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَلَمْ نُجدهُ , قَالَ : فَأَطْعَمَتْنَا عَائِشَةُ تَمْرًا وَعَصَدَتْ لَنَا عَصِيدَةً ، إِذْ جَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَتَقَلَّعُ ، قَالَ :  هَلْ أَطْعَمْتِيهِمْ مِنْ شَيْءٍ ؟ "" , قُلْنَا : نَعَمْ ، فَبَيْنَا نَحْنُ عَلَى ذَلِكَ دَفَعَ الرَّاعِي الْغَنَمَ فِي الْمَرَاحِ عَلَى يَدِهِ سَخْلَةٌ , قَالَ : "" هَلْ وَلَّدْتَ ؟ "" , قَالَ : نَعَمْ , قَالَ : "" فَاذْبَحْ لَهُمْ شَاةً ، ثُمَّ أَقْبِلْ عَلَيْنَا "" , فَقَالَ : لا تَحْسَبَنَّ وَلَمْ يَقُلْ لا تَحْسِبَنَّ أَنَّا ذَبَحْنَا الشَّاةَ مِنْ أَجْلِكُمْ ، لَنَا غَنَمٌ مِائَةٌ لا نُرِيدُ أَنْ تَزِيدَ عَلَيْهَا إِذَا وَلَّدَ الرَّاعِي لَنَا بَهْمَةً أَمَرْنَاهُ فَذَبَحَ شَاةً , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ! أَخْبِرْنِي عَنِ الْوُضُوءِ , قَالَ :"" إِذَا تَوَضَّأْتَ فَأَسْبِغْ ، وَخَلِّلْ بَيْنَ الأَصَابِعِ ، وَإِذَا اسْتَنْثَرْتَ فَأَبْلِغْ , إِلا أَنْ تَكُونَ صَائِمَا "" , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ! إِنَّ لِي امْرَأَةً فَذَكَرَ مِنْ طُولِ لِسَانِهَا وَبَذَائِهَا ، فَقَالَ : "" طَلِّقْهَا "" , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ، إِنَّهَا ذَاتُ صُحْبَةٍ وَوَلَدٍ , قَالَ : "" أَمْسِكْهَا وَأْمُرْهَا فَإِنْ يَكُنْ فِيهَا خَيْرٌ فَسَتَفْعَلُ , وَلا تَضْرِبْ ظَعِينَتَكَ ضَرْبَكَ أَمَتِكَ ""","","","","","Book of Purification"
"78","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : إِنْ غَمَسْتَ يَدَكَ فِي كِظَامَةٍ فَأَنْقِهَا وَحَسْبُكَ ، وَلا تَبْدَأْ بِيُسْرَى رِجْلَيْكَ قَبْلَ يُمْنَاهُمَا ""","","","","","Book of Purification"
"79","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ  فِيرَجُلٍ أَدْخَلَ قَدَمَيْهِ فِي نَهْرٍ وَلَمْ يَمَسَّهُمَا بِيَدِهِ , قَالَ : يُجْزِيهِ ""","","","","","Book of Purification"
"80","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَرَأَيْتَإِنْ تَوَضَّأَ إِنْسَانٌ فَوَطِئَ عَلَى خِرَاءٍ عَلَيْهِ وُضُوءٌ ؟ قَالَ : "" لا ، وَلَكِنْ لِيَغْسِلْ عَنْهُ الْخِرَاءَ فَلْيُنَقِّهِ ""، قَالَ : وَأَقُولُ أَنَا : "" فَخُذْ بِهَذَا ، وَإِنْ وَطِئَ رَوْثًا دَلَكَ رِجْلَيْهِ بِالأَرْضِ "" أَوْ قَالَ : "" بِالتُّرَابِ "" , عَنْ إِسْرَائِيلَ ، عَنِ الْعَوَّامِ بْنِ حَوْشَبٍ ، عَنْ إِبْرَاهِيمَ ، مِثْلَ قَوْلِ الشَّعْبِيِّ""","","","","","Book of Purification"
"81","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : إِنْ وَطِئَ رَجُلٌ فِي رَجِيعِ إِنْسَانٍ إِلَى الْكَعْبَيْنِ فَلَيْسَ عَلَيْهِ إِلا أَنْ يَغْسِلَ رِجْلَيْهِ ""","","","","","Book of Purification"
"82","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , فِي رَجُلٍ يُصِيبُ جَسَدَهُ الْبَوْلُ , أَوِ الدَّمُ وَهُوَ مُتَوَضِّئٌ , قَالَ : يَغْسِلُ أَثَرَ الْبَوْلِ وَالدَّمِ , وَلا يَتَوَضَّأُ ""","","","","","Book of Purification"
"83","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ عَطَاءٍ ، وَطَاوُسٍ ، وَعَنْ رِجَالٍ , قَالُوا : إِذَا وَطِئْتَ نَتْنًا رَطْبًا فَاغْسِلْهُ , وَإِنْ كَانَ يَابِسًا فَلا بَأْسَ ""","","","","","Book of Purification"
"84","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ وَطِئْتُ خِرَاءً يَابِسًا أَغْسِلُ بَطْنَ قَدَمِي ؟ قَالَ :  لا "" ، قُلْتُ : فَكَفِّي وَوَجْهِي أَصَابَ شَيْءٌ مِنْ ذَلِكَ خِرَاءً يَابِسًا ؟ قَالَ : "" لا ، لَعَمْرِي إِنَّالرِّيحَ إِذَا صَعِدْنَا مَعَ الْجِنَازَةِ لَتُسَفِّي الْخِرَاءَ الْيَابِسَ عَلَى وُجُوهِنَا ، فَمَا نَتَوَضَّأُ وَلا نَغْسِلُ وُجُوهَنَا وَلا شَيْئًا مِنْ ذَلِكَ ""","","","","","Book of Purification"
"85","عَنْ مَعْمَرٍ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ , قَالَ : كُنَّا نَدْخُلُ عَلَى أَبِي الْعَالِيَةِ الرِّيَاحِيِّ فَنَتَوَضَّأُ , فَيَقُولُ : أَمَا تَوَضَّئُونَ فِي رِحَالِكُمْ ؟ "" , فَنَقُولُ : بَلَى , وَلَكِنَّا نَطَأُ فِي الْقَشْبِ , قَالَ : "" فَلا وُضُوءَ عَلَيْكُمْ ، أَلا أُخْبِرُكُمْ بِأَشَدَّ مِنْ ذَاكُمْ ، إِنَّ الرِّيحَ تُطَيِّرُهُ عَلَيْهِ فِي رُءُوسِكُمْ وَلِحَاكُمْ ""","","","","","Book of Purification"
"86","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ , قَالَ : إِذَا وَطِئَ الرَّجُلُ خِرَاءً يَابِسًا فَلا وُضُوءَ عَلَيْهِ ، وَإِنْ مَسَّ كَلْبًا فَلا وُضُوءَ عَلَيْهِ ""","","","","","Book of Purification"
"87","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ فَذَلِكَ يَمَسُّ ثَوْبِي أَرُشُّهُ ؟ , قَالَ : لا ""","","","","","Book of Purification"
"88","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : خَرَجْنَا يَوْمًا مَعَ ابْنِ الْمُسَيِّبِ إِلَى مَسْجِدٍ وَكَانَتِ الأَرْضُ مُطِرَتْ فَفِيهَا رَدَغٌ ، فَلَمَّا أَتَيْنَا بَابَ الْمَسْجِدِ غَسَلَ رَجُلٌ مِنَ الْقَوْمِ رِجْلَيْهِ ، فَقَالَ لَهُ ابْنُ الْمُسَيِّبِ أَمَا كُنْتَ تَوَضَّأْتَ فِي رَحْلِكَ ؟ "" , قَالَ : بَلَى ، وَلَكِنَّا مَرَرْنَا فِي هَذَا الرَّزَغِ , قَالَ : "" لَيْسَ عَلَيْكُمْ وُضُوءٌ ""","","","","","Book of Purification"
"89","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي مَنْ رَأَى الْحَسَنَ يَمْشِي فِي الطِّينِ , قَالَ : وَالطِّينُ لا يَبْلُغُ ظَهْرَ الْقَدَمَيْنِ , وَلَكِنَّهُ يَمْلأُ بُطُونَهُمَا ، فَلَمَّا بَلَغَ بَابَ الْمَسْجِدِ مَسَحَ بَاطِنَ قَدَمَيْهِ بِالأَرْضِ ، ثُمَّ دَخَلَ الْمَسْجِدَ وَلَمْ يَغْسِلْهُمَا ""","","","","","Book of Purification"
"90","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , فِي الرَّجُلِ يُصِيبُ جَسَدَهُ الْبَوْلُ , وَالدَّمُ وَهُوَ مُتَوَضِّئٌ , قَالَ : يَغْسِلُ أَثَرَ الدَّمِ وَالْبَوْلِ , وَلا يَتَوَضَّأُ ""","","","","","Book of Purification"
"91","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنْ بَكْرِ بْنِ عَبْدِ اللَّهِ الْمُزَنِيِّ , قَالَ : رَأَيْتُ ابْنَ عُمَرَبِمِنًى  يَتَوَضَّأُ ، ثُمَّ يَخْرُجُ وَهُوَ حَافٍ فَيَطَأُ مَا يَطَأُ ، ثُمَّ يَدْخُلُ الْمَسْجِدَ فَيُصَلِّي وَلا يَتَوَضَّأُ ""","","","","","Book of Purification"
"92","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ , قَالَ : كَانَ عَلْقَمَةُ ، وَالأَسْوَدُ يَخُوضَانِ الْمَاءَ وَالطِّينَ فِي الْمَطَرِ ، ثُمَّ يَدْخُلانِ الْمَسْجِدَ فَيُصَلِّيَانِ ""","","","","","Book of Purification"
"93","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَيْتُ يَحْيَى بْنَ وَثَّابٍ ، وَعَبْدَ اللَّهِ بْنَ عَيَّاشٍ ، وَغَيْرَهُمَا مِنْ أَصْحَابِ عَبْدِ اللَّهِ ، يَخُوضُونَ الْمَاءَ قَدْ خَالَطَهُ السِّرْقِينُ وَالْبَوْلُ ، فَإِذَا انْتَهَوْا إِلَى بَابِ الْمَسْجِدِ , لَمْ يَزِيدُوا عَلَى أَنْ يُنَفِّضُوا أَقْدَامَهُمْ ، ثُمَّ يَدْخُلُونَ فِي الصَّلاةِ ""","","","","","Book of Purification"
"94","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْقَاسِمِ بْنِ أَبِي بَزَّةَ , قَالَ : سَأَلَ رَجُلٌ عَبْدَ اللَّهِ بْنَ الزُّبَيْرِ عَنْ طِينِ الْمَطَرِ , فَقَالَ : تَسْأَلُنِي عَنْ طَهُورَيْنِ جَمِيعًا ، قَالَ اللَّهُ :   وَنَزَّلْنَا مِنَ السَّمَاءِ مَاءً مُبَارَكًا ، وَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :"" جُعِلَتْ لِيَ الأَرْضُ مَسْجِدًا وَطَهُورًا ""","","","","","Book of Purification"
"95","عَنِ الثَّوْرِيِّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ ، عَنْ عَلْقَمَةَ بْنِ قَيْسٍ , قَالَ : الْوُضُوءُ مِنَ الْحَدَثِ , وَلَيْسَ مِنَ الْمَوْطِئِ ""","","","","","Book of Purification"
"96","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي حَصِينٍ ، عَنْ يَحْيَى بْنِ وَثَّابٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : الْوُضُوءُ مِمَّا خَرَجَ وَلَيْسَ مِمَّا دَخَلَ ، وَلا يُتَوَضَّأُ مِنْ مَوْطِئٍ ""","","","","","Book of Purification"
"97","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي وَائِلٍ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ :  كُنَّالا نَتَوَضَّأُ مِنْ مَوْطِئٍ ""","","","","","Book of Purification"
"98","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنْ مُسْلِمِ بْنِ أَبِي عِمْرَانَ ، أَنَّ ابْنَ مَسْعُودٍ , قَالَ :  كُنَّالا نَتَوَضَّأُ مِنْ مَوْطِئٍ ، وَلا نَكْشِفُ سِتْرًا ، وَلا نَكُفُّ شَعْرًا "", قَالَ : قَوْلُهُ "" وَلا نَكْشِفُ سِتْرًا : يَدَهُ إِذَا كَانَ عَلَيْهَا الثَّوْبُ فِي الصَّلاةِ ""","","","","","Book of Purification"
"99","عَنْ بِشْرِ بْنِ رَافِعٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، عَنْ أَبِيهِ , قَالَ : نَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ نَكْشِفَ سِتْرًا ، أَوْ نَكُفَّ شَعْرًا ، أَوْ نُحْدِثَ وُضُوءًا "", قَالَ : قُلْتُ لِيَحْيَى : قَوْلُهُ , "" أَوْ نُحْدِثَ وُضُوءًا "" , قَالَ : إِذَا وَطِئَ نَتِنًا وَكَانَ مُتَوَضِّئًا , قَالَ : وَقَوْلُهُ : "" وَلا نَكْشِفُ سِتْرًا "" , يَقُولُ : لا يَكْشِفُ الثَّوْبَ عَنْ يَدِهِ إِذَا سَجَدَ""","","","","","Book of Purification"
"100","عَنْ عَبْدِ اللَّهِ بْنِ زِيَادِ بْنِ سَمْعَانَ ، قَالَ : أَخْبَرَنِي الْقَعْقَاعُ بْنُ حَكِيمٍ ، عَنْ عَائِشَةَ , قَالَتْ : سَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  عَنِالرَّجُلِ يَطَأُ فِي نَعْلَيْهِ الأَذَى , قَالَ : التُّرَابُ لَهُمَا طَهُورٌ ""","","","","","Book of Purification"
"101","عَنْ قَيْسِ بْنِ الرَّبِيعِ ، عَنْ عَبْدِ اللَّهِ بْنِ عِيسَى ، عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ ، عَنِ امْرَأَةٍ مِنْ بَنِي عَبْدِ الأَشْهَلِ , قَالَتْ : قُلْتُ : يَا رَسُولَ اللَّهِ  إِنَّلَنَا طَرِيقًا مُنْتِنَةً فِي الْمَطَرِ ، قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" أَلَيْسَ دُونَهَا طَرِيقٌ طَيِّبَةٌ ؟ "" , قُلْتُ : بَلَى , قَالَ : "" فَذَلِكَ بِذَلِكَ ""","","","","","Book of Purification"
"102","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ عَجْلانَ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ ، أَنَّ امْرَأَةً ، سَأَلَتْ عَائِشَةَ ، عَنِالْمَرْأَةِ تَجُرُّ ذَيْلَهَا إِذَا خَرَجَتْ إِلَى الْمَسْجِدِ فَتُصِيبُ الْمَكَانَ الَّذِي لَيْسَ بِطَاهِرٍ , قَالَتْ :  فَإِنَّهَا تَمُرُّ عَلَى الْمَكَانِ الطَّاهِرِ فَيُطَهِّرَهُ ""","","","","","Book of Purification"
"103","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي رَجَاءٍ الْعُطَارِدِيِّ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ يوْمَ الْجُمُعَةِ عَلَى هَذَا الْمِنْبَرِ فِي يَوْمٍ مَطِيرٍ , يَقُولُ : صَلُّوا فِي رِحَالِكُمْ ، وَلا تَأْتُوا بِالْخَبَثِ تَنْقُلُونَهُ بِأَقْدَامِكُمْ إِلَى الْمَسْجِدِ , فَلَيْسَ كُلُّ جِرَارِ الْمَسْجِدِ يَسَعُ لِطُهُورِكُمْ ""","","","","","Book of Purification"
"104","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : تُحْمَلُ مَعِي مَاءٌ فِي يَوْمٍ مَطِيرٍ حَتَّى آتِيَ بَابَ الْمَسْجِدِ , فَأَغْسِلُهُمَا عِنْدَهُ ""","","","","","Book of Purification"
"105","عَنِ الثَّوْرِيِّ , فِيرَجُلٍ تَوَضَّأَ , ثُمَّ اغْتَمَسَتْ رِجْلُهُ فِي نَتْنٍ وَلَمْ يَجِدْ مَاءً , قَالَ : تَيَمَّمْ هُوَ بِمَنْزِلَةِ رَجُلٍ لَمْ يُتِمَّ وُضُوءَهُ ؟ قَالَ :  فَإِنْ أَصَابَ شَيْئًا مِنْ مَوَاضِعِ الْوُضُوءِ وَالتَّيَمُّمِ شَيْءٌ , مَسَحَهُ بِالتُّرَابِ وَكَانَ بِمَنْزِلَةِ الْمَاءِ ""","","","","","Book of Purification"
"106","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ إِنْسَانٌ عَطَاءً , قَالَ : سَأَلْتُ مَسِسْتُ نَعْلِي فِي الصَّلاةِ فَوَقَعَتْ يَدِي عَلَى قَشْبٍ , أُعِيدُ صَلاتِي ؟ , قَالَ : لا ""","","","","","Book of Purification"
"107","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ الشَّعْبِيِّ  فِي رَجُلٍصَلَّى وَفِي خُفَّيْهِ نَتْنٌ ؟ , قَالَ : يُعِيدُ ""","","","","","Book of Purification"
"108","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَخْطَأَتْ إِحْدَى قَدَمَيَّ أَوْ نَسِيتُهَا حَتَّى ذَكَرْتُ بَعْدُ ، وَلَمْ أُحْدِثْ فِي ذَلِكَ شَيْئًا , قَالَ : اغْسِلِ الَّذِي أَخْطَأْتَ , وَلا تَأْتَنِفْ وُضُوءًا مُسْتَقْبَلا ""","","","","","Book of Purification"
"109","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : نَسِيتُ شَيْئًا قَلِيلا مِنْ أَعْضَاءِ الْوُضُوءِ مِنَ الْجَسَدِ , قَالَ : فَأَمِسَّهُ الْمَاءَ ""","","","","","Book of Purification"
"110","عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ عُبَيْدٍ ، عَنِ الْحَسَنِ , قَالَ : مَنْ نَسِيَ شَيْئًا مِنْ أَعْضَائِهِ فِي الْوُضُوءِ , فَلا يُعِدِ الْوُضُوءَ جَفَّ الْوُضُوءُ أَوْ لَمْ يَجِفَّ ، وَلَيْغَسِلِ الَّذِي تَرَكَ ، وَيُعِيدُ الصَّلاةَ ""","","","","","Book of Purification"
"111","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ أَبِي سَبْرَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : مَنْ تَرَكَ مِنْ مَوَاضِعِ الْوُضُوءِ شَيْئًا فَلْيُعِدْ , فَلْيَغْسِلِ الَّذِي تَرَكَ ، ثُمَّ لِيُعِدِ الصَّلاةَ وَإِنْ كَانَ مِثْلَ الشَّعْرِ ""","","","","","Book of Purification"
"112","عَنْ هُشَيْمِ بْنِ بَشِيرٍ ، عَنِ الْعَوَّامِ بْنِ حَوْشَبٍ , قَالَ : سَمِعْتُ إِبْرَاهِيمَ النَّخَعِيَّ , يَقُولُ : مَا أَصَابَ الْمَاءُ مِنْ مَوَاضِعِ الطُّهُورِ , فَقَدْ طَهُرَ ذَلِكَ الْمَكَانُ ""","","","","","Book of Purification"
"113","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : مَنْ نَسِيَ شَيْئًا مِنْ أَعْضَاءِ وُضُوئِهِ فَإِنْ لَمْ يَجِفَّ وُضُوءُهُ فَلْيَغْسِلِ الَّذِي تَرَكَ ، وَإِنْ كَانَ قَدْ جَفَّ أَعَادَ الْوُضُوءَ وَالصَّلاةَ فِي الْوَقْتِ ""","","","","","Book of Purification"
"114","عَنْ مَعْمَرٍ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ أَبِي قِلابَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ رَأَى رَجُلا يُصَلِّي ، وَقَدْ تَرَكَ مِنْ رِجْلَيْهِ مَوْضِعَ ظُفُرٍ ، فَأَمَرَهُ أَنْ يُعِيدَ الْوُضُوءَ وَالصَّلاةَ ""","","","","","Book of Purification"
"115","أَخْبَرَنَا مَعْمَرٌ ، عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْنِ عَقِيلِ بْنِ أَبِي طَالِبٍ , قَالَ : دَخَلْتُ عَلَى الرُّبَيِّعِ بِنْتِ عَفْرَاءَ ، فَقَالَتْ : مَنْ أَنْتَ ؟ , قَالَ : قُلْتُ : أَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَقِيلِ بْنِ أَبِي طَالِبٍ , قَالَتْ : فَمَنْ أُمُّكَ ؟ قُلْتُ : رَيْطَةُ بِنْتُ عَلِيٍّ , أَوْ فُلانَةُ بِنْتُ عَلِيِّ بْنِ أَبِي طَالِبٍ , قَالَتْ : مَرْحَبًا بِكَ يَا ابْنَ أُخْتِي , قُلْتُ : جِئْتُكَ أَسْأَلُكَ عَنْ وُضُوءِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ , قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصِلُنَا وَيَزُورُنَا ، وَكَانَ يَتَوَضَّأُ فِي هَذَا الإِنَاءِ أَوْ فِي مِثْلِ هَذَا الإِنَاء وَهُوَ نَحْوٌ مِنْ مُدٍّ ، قَالَتْ : فَكَانَ يَغْسِلُ يَدَيْهِ ، وَيُمَضْمِضُ ، وَيَسْتَنْثِرُ ، ثُمَّ غَسَلَ وَجْهَهُ ثَلاثًا ، ثُمَّ غَسَلَ يَدَيْهِ ثَلاثًا ثَلاثًا ، ثُمَّ مَسَحَ بِرَأْسِهِ مَرَّتَيْنِ ، وَمَسَحَ بِأُذُنَيْهِ ظَاهِرِهِمَا وَبَاطِنِهِمَا ، وَغَسَلَ قَدَمَيْهِ ثَلاثًا "", ثُمَّ قَالَتْ : إِنَّ ابْنَ عَبَّاسٍ قَدْ دَخَلَ عَلَيَّ فَسَأَلَنِي ، عَنْ هَذَا الْحَدِيثِ فَأَخْبَرْتُهُ ، فَقَالَ : يَأْبَى النَّاسُ , إِلا الْغَسْلَ ، وَنَجِدُ فِي كِتَابِ اللَّهِ الْمَسْحَ عَلَى الْقَدَمَيْنِ""","","","","","Book of Purification"
"116","أنا الثَّوْرِيُّ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ أَبِي حَيَّةَ بْنِ قَيْسٍ ، عَنْ عَلِيٍّ رَضِيَ اللَّهُ عَنْهُ ، أَنَّهُتَوَضَّأَ ثَلاثًا ، ثُمَّ مَسَحَ بِرَأْسِهِ ، ثُمَّ شَرِبَ فَضْلَ وَضُوئِهِ ، ثُمَّ قَالَ :  مَنْ سَرَّهُ أَنْ يَنْظُرَ إِلَى وُضُوءِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَلْيَنْظُرْ إِلَى هَذَا ""","","","","","Book of Purification"
"117","أَخْبَرَنَا إِسْرَائِيلُ بْنُ يُونُسَ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ أَبِي حَيَّةَ بْنِ قَيْسٍ ، عَنْ عَلِيٍّ , قَالَ : شَهِدْتُ عَلِيًّا فِي الرَّحْبَةِ بَالَ  ثُمَّتَوَضَّأَ فَغَسَلَ كَفَّيْهِ ثَلاثًا ، وَمَضْمَضَ ، وَاسْتَنْثَرَ ثَلاثًا ، وَغَسَلَ وَجْهَهُ ثَلاثًا ، وَذِرَاعَيْهِ ثَلاثًا ثَلاثًا ، وَمَسَحَ بِرَأْسِهِ ، وَغَسَلَ قَدَمَيْهِ ثَلاثًا ، ثُمَّ اسْتَتَمَّ قَائِمَا ، ثُمَّ أَخَذَ فَشَرِبَ فَضْلَ وُضُوئِهِ ، ثُمَّ قَالَ : إِنِّي رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَعَلَ كَالَّذِي رَأَيْتُمُونِي فَعَلْتُ , فَأَحْبَبْتُ أَنْ أُرِيَكُمْ ""","","","","","Book of Purification"
"118","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ ، عَنِ الْخَارِفِيِّ ، أَنَّ عَلِيًّا بِالْكُوفَةِ ، قَالَ لِخَادِمِهِ : يَا قُنْبُرُ ! أَبْغِنِي وَضُوءًا ؟ فَجَاءَهُ بِهِ ، قَالَ الْمُغِيرَةُ ، عَنْ عَبْدِ الْكَرِيمِ فِي عُسٍّ  فَبَدَأَفَغَسَلَ يَدَيْهِ قَبْلَ أَنْ يُدْخِلَهُمَا فِي الْوَضُوءِ ثَلاثَ مَرَّاتٍ ، ثُمَّ مَضْمَضَ ثَلاثًا ، وَاسْتَنْثَرَ ثَلاثًا ، ثُمَّ غَسَلَ وَجْهَهُ ثَلاثًا ، ثُمَّ غَسَلَ يَدَهُ الْيُمْنَى إِلَى الْمِرْفَقِ ثَلاثًا ، ثُمَّ الْيُسْرَى كَذَلِكَ ، ثُمَّ غَرَفَ غَرْفَةَ مَاءٍ بِإِحْدَى يَدَيْهِ عَلَى رَأْسِهِ فَمَسَحَ بِهَا , قَالَ : فِي الصَّيْفِ كَأَنَّهُ غَرَفَهَا لِلصَّيْفِ , قَالَ : ثُمَّ غَسَلَ رِجْلَهُ الْيُمْنَى إِلَى الْكَعْبَيْنِ ثَلاثًا ، ثُمَّ الْيُسْرَى كَذَلِكَ ، ثُمَّ قَامَ قَائِمًا , فَشَرِبَ مِنْ فَضْلِ وَضُوئِهِ ، ثُمَّ قَالَ : مَنْ أَحَبَّ أَنْ يَنْظُرَ إِلَى وُضُوءِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَهَكَذَا فَلْيَتَوَضَّأْ, قَالَ : وَيَرَوْنَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ شَرِبَ فَضْلَ وَضُوئِهِ قَائِمًا ، كَمَا صَنَعَ عَلِيٌّ ، ثُمَّ صَلَّى الْمَكْتُوبَةَ , قَالَ : ثُمَّ لَمْ يَبْرَحْ مِنْ مَقْعَدِهِ حَتَّى دَعَا قُنْبُرًا بِوَضُوءِ الصَّلاةِ ، ثُمَّ غَرَفَ غَرْفَةً وَاحِدَةً فَمَضْمَضَ مِنْهَا وَاسْتَنْثَرَ ، وَمَسَحَ بِوَجْهِهِ وَذِرَاعَيْهِ وَرَأْسِهِ وَرِجْلَيْهِ مِنْ تِلْكَ الْغَرْفَةِ مَسْحَةً وَاحِدَةً لِكُلِّ عُضْوٍ قَسَمَهَا ، فَمَضْمَضَ وَاسْتَنْثَرَ ، وَمَسَحَ بِوَجْهِهِ ، وَذِرَاعَيْهِ وَرَأْسِهِ وَاحِدَةً ، ثُمَّ قَالَ : هَكَذَا وُضُوءُ مَنْ لَمْ يُحْدِثْ يَقُولُ : إِنْ أَحَبَّ أَنْ يَتَوَضَّأَ وَإِنْ شَاءَ فَلا ""","","","","","Book of Purification"
"119","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مَنْ أُصَدِّقُ ، أَنَّ مُحَمَّدَ بْنَ عَلِيِّ بْنِ حُسَيْنٍ ، أَخْبَرَهُ قَالَ : أَخْبَرَنِي أَبِي ، عَنْ أَبِيهِ , قَالَ : دَعَا عَلِيٌّ بِوَضُوءٍ فَقُرِّبَ لَهُ فَغَسَلَ كَفَّيْهِ ثَلاثَ مَرَّاتٍ قَبْلَ أَنْ يُدْخِلَهُمَا فِي وَضُوئِهِ ، ثُمَّ مَضْمَضَ ثَلاثًا ، وَاسْتَنْشَقَ ثَلاثًا ، ثُمَّ غَسَلَ وَجْهَهُ ثَلاثًا ، ثُمَّ غَسَلَ يَدَهُ الْيُمْنَى إِلَى الْمِرْفَقِ ثَلاثًا ، ثُمَّ الْيُسْرَى كَذَلِكَ ، ثُمَّ مَسَحَ بِرَأْسِهِ مَسْحَةً وَاحِدَةً ، ثُمَّ غَسَلَ رِجْلَهُ الْيُمْنَى إِلَى الْكَعْبَيْنِ ثَلاثًا ، ثُمَّ الْيُسْرَى كَذَلِكَ ، ثُمَّ قَامَ قَائِمًا , فَقَالَ لِي : نَاوِلْنِي ، فَنَاوَلْتُهُ الإِنَاءَ الَّذِي فِيهِ فَضْلُ وَضُوئِهِ فَشَرِبَ مِنْ فَضْلِ وَضُوئِهِ قَائِمَا فَعَجِبْتُ , فَلَمَّا رَآنِي عَجِبْتُ , قَالَ : لا تَعْجَبْ ، فَإِنِّي رَأَيْتُ أَبَاكَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصْنَعُ مِثْلَ مَا رَأَيْتَنِي أَصْنَعُ, يَقُولُ : بِوَضُوئِهِ هَذَا , وَبِشَرَابِهِ فَضْلَ وَضُوئِهِ قَائِمًا""","","","","","Book of Purification"
"120","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ أَنَّهُ بَلَغَهُ ، عَنْ عُثْمَانَ بْنِ عَفَّانَ  أَنَّهُمَضْمَضَ ثَلاثًا ، وَاسْتَنْثَرَ ثَلاثًا ، ثُمَّ أَفْرَغَ عَلَى وَجْهِهِ ثَلاثًا ، وَعَلَى يَدَيْهِ ثَلاثًا ، ثُمَّ غَسَلَ رِجْلَيْهِ ثَلاثًا ثَلاثًا ، ثُمَّ قَالَ : هَكَذَا تَوَضَّأَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ "", قَالَ : وَلَمْ أَسْتَيْقِنْهَا ، عَنْ عُثْمَانَ لَمْ أَزِدْ عَلَيْهِ ، وَلَمْ أَنْقُصْ""","","","","","Book of Purification"
"121","عَنْ إِسْرَائِيلَ ، عَنْ عَامِرِ بْنِ شَقِيقٍ ، عَنْ شَقِيقِ بْنِ سَلَمَةَ ، قَالَ : رَأَيْتُ عُثْمَانَ بْنَ عَفَّانَ تَوَضَّأَ فَغَسَلَ كَفَّيْهِ ثَلاثًا ثَلاثًا ، وَمَضْمَضَ ، وَاسْتَنْشَقَ ، وَاسْتَنْثَرَ ، وَغَسَلَ وَجْهَهُ ثَلاثًا , قَالَ : وَحَسِبتُهُ ، قَالَ : وَذِرَاعَيْهِ ثَلاثًا ثَلاثًا ، ثُمَّ مَسَحَ بِرَأْسِهِ ، وَأُذُنَيْهِ ظَاهِرَهُمَا وَبَاطِنَهُمَا ، وَغَسَلَ قَدَمَيْهِ ثَلاثًا ثَلاثًا ، وَخَلَّلَ أَصَابِعَهُ ، وَخَلَّلَ لِحْيَتَهُ حِينَ غَسَلَ وَجْهَهُ قَبْلَ أَنْ يَغْسِلَ قَدَمَيْهِ ، ثُمَّ قَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَفْعَلُ كَالَّذِي رَأَيْتُمُونِي فَعَلْتُ ""","","","","","Book of Purification"
"122","أَخْبَرَنَا مَعْمَرٌ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ ،  أَنَّهُتَوَضَّأَ فَغَسَلَ كُلَّ عُضْوٍ مِنْهُ غَسْلَةً وَاحِدَةً ، ثُمَّ ذَكَرَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , كَانَ يَفْعَلُهُ ""","","","","","Book of Purification"
"123","عَنْ دَاوُدَ بْنِ قَيْسٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَتَوَضَّأَ مَرَّةً مَرَّةً ""","","","","","Book of Purification"
"124","عَنِ الثَّوْرِيِّ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّهُ قَالَ :  أَلا أُخْبِرُكُمْبِوُضُوءِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَغَرَفَ بِيَدِهِ الْيُمْنَى ، ثُمَّ صَبَّ عَلَى الْيُسْرَى صَبَّةً صَبَّةً ""","","","","","Book of Purification"
"125","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَتَوَضَّأَ وُضُوءَيْنِ ، مَرَّةً وَثَلاثًا ""","","","","","Book of Purification"
"126","عَنْ دَاوُدَ بْنِ قَيْسٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ مِقْسَمٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ , أَنَّهُ سُئِلَ عَنْ ثَلاثِ غَرَفَاتٍ فِي الْوُضُوءِ ، فَقَالَ : مَنْ كَانَ يُحْسِنُ أَنْ يَتَوَضَّأَ كَفَتْهُ غَرْفَةٌ وَاحِدَةٌ ""","","","","","Book of Purification"
"127","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ  أَنَّهُتَوَضَّأَ مَرَّةً ""","","","","","Book of Purification"
"128","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ تُجْزِئُ مَرَّةً إِذَا أَسْبَغَ الْوُضُوءَ ""","","","","","Book of Purification"
"129","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : لَوْ تَوَضَّأَ رَجُلٌ مَرَّةً وَاحِدَةً فَأَبْلَغَ فِي تِلْكَ الْمَرَّةِ أَجْزَأَ عَنْهُ ""","","","","","Book of Purification"
"130","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ جَابِرٍ ، عَنْ جَابِرٍ ، عَنِ الْحَسَنِ , قَالَ : يُجْزِئُ مَرَّةً , وَيُجْزِئُ مَرَّتَيْنِ ""","","","","","Book of Purification"
"131","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : أَنْبَأَنِي مَنْ ، رَأَى عُمَرَ بْنَ الْخَطَّابِ يَتَوَضَّأُ مَرَّتَيْنِ ""","","","","","Book of Purification"
"132","عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنِ الأَسْوَدِ بْنِ يَزِيدَ ، أَنَّهُ رَأَى عُمَرَ بْنَ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ يَتَوَضَّأُ مَرَّتَيْنِ ""","","","","","Book of Purification"
"133","عَنِ الثَّوْرِيِّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ، عَنْ مُجَاهِدٍ , قَالَ : كُنْتُأُوَضِّئُ ابْنَ عُمَرَ  مِرَارًا مَرَّتَيْنِ ، وَمِرَارًا ثَلاثًا ""","","","","","Book of Purification"
"134","عَنْ مَالِكِ بْنِ أَنَسٍ ، عَنْ عَمْرِو بْنِ يَحْيَى الْمَازِنِيِّ ، أَنَّ رَجُلا قَالَ لِعَبْدِ اللَّهِ بْنِ زَيْدٍ ، وَكَانَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : هَلْ تَسْتَطِيعُ أَنْ تُرِيَنِي كَيْفَ كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَتَوَضَّأُ ؟ قَالَ : نَعَمْ ، فَدَعَا عَبْدُ اللَّهِ بْنُ زَيْدٍبِوَضُوءٍ  فَأَفْرَغَ عَلَى يَدَيْهِ فَغَسَلَهُمَا مَرَّتَيْنِ ، ثُمَّ مَضْمَضَ وَاسْتَنْثَرَ ثَلاثًا ، وَغَسَلَ وَجْهَهُ ثَلاثًا ، ثُمَّ غَسَلَ يَدَيْهِ إِلَى الْمِرْفَقَيْنِ مَرَّتَيْنِ ، ثُمَّ مَسَحَ رَأْسَهُ بِيَدَيْهِ , فَأَقْبَلَ بِهِمَا وَأَدْبَرَ بَدَأَ بِمُقَدَّمِ رَأْسِهِ ، ثُمَّ ذَهَبَ بِهِمَا إِلَى قَفَاهُ ، ثُمَّ رَدَّهُمَا حَتَّى رَجَعَ إِلَى الْمَكَانِ الَّذِي بَدَأَ مِنْهُ ، ثُمَّ غَسَلَ رِجْلَيْهِ ""","","","","","Book of Purification"
"135","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، عَنْ عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ ، عَنْ حُمْرَانَ بْنِ أَبَانَ , قَالَ : رَأَيْتُ عُثْمَانَ بْنَ عَفَّانَتَوَضَّأَ  فَأَفْرَغَ عَلَى يَدَيْهِ ثَلاثًا فَغَسَلَهُمَا ، ثُمَّ مَضْمَضَ وَاسْتَنْثَرَ ، ثُمَّ غَسَلَ وَجْهَهُ ثَلاثًا ، ثُمَّ غَسَلَ يَدَهُ الْيُمْنَى إِلَى الْمِرْفَقِ ثَلاثًا ، ثُمَّ غَسَلَ الْيُسْرَى مِثْلَ ذَلِكَ ، ثُمَّ مَسَحَ بِرَأْسِهِ ، ثُمَّ غَسَلَ قَدَمَهُ الْيُمْنَى ثَلاثًا ، ثُمَّ الْيُسْرَى ثَلاثًا كَذَلِكَ ، ثُمَّ قَالَ : "" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَتَوَضَّأُ نَحْوَ وُضُوئِي "" ، ثُمَّ قَالَ : "" مَنْ تَوَضَّأَ وُضُوئِي هَذَا ، ثُمَّ صَلَّى رَكْعَتَيْنِ لا يُحَدِّثُ فِيهِمَا نَفْسَهُ ، غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ ""","","","","","Book of Purification"
"136","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَهُ ابْنُ شِهَابٌ ، عَنْ عَطَاءِ بْنِ زَيْدٍ الْجُنْدَعِيِّ ، أَنَّهُ سَمِعَ حُمْرَانَ مَوْلَى عُثْمَانَ ، أَنَّ عُثْمَانَ ،تَوَضَّأَ  فَأَهْرَاقَ عَلَى يَدَيْهِ ثَلاثَ مَرَّاتٍ ، وَاسْتَنْثَرَ ثَلاثًا ، وَمَضْمَضَ ثَلاثًا ، وَغَسَلَ وَجْهَهُ ثَلاثًا ، وَغَسَلَ يَدَهُ الْيُمْنَى إِلَى الْمِرْفَقِ ثَلاثًا ، وَغَسَلَ الْيُسْرَى مِثْلَ ذَلِكَ ، ثُمَّ مَسَحَ بِرَأْسِهِ ، ثُمَّ غَسَلَ قَدَمَهُ الْيُمْنَى ثَلاثًا ، ثُمَّ الْيُسْرَى مِثْلَ ذَلِكَ ، ثُمَّ قَالَ : "" رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ نَحْوَ وُضُوئِي ، ثُمَّ قَالَ : مَنْ تَوَضَّأَ مِثْلَ وُضُوئِي هَذَا ، ثُمَّ قَامَ فَرَكَعَ رَكْعَتَيْنِ لَمْ يُحَدِّثْ فِيهِمَا نَفْسَهُ , غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ ""","","","","","Book of Purification"
"137","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ ، عَنْ حُمْرَانَ مَوْلَى عُثْمَانَ قَالَ : جَلَسَ عُثْمَانُ بِالْمَقَاعِدِ فَدَعَا بِوَضُوءٍ فَتَوَضَّأَ ، ثُمَّ قالَ : وَاللَّهِ لأُحَدِّثَنَّكُمْ بِحَدِيثٍ لَوْلا آيَةٌ فِي كِتَابِ اللَّهِ مَا حَدَّثْتُكُمُوهُ ، إِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : مَا تَوَضَّأَ رَجُلٌ فَأَحْسَنَ وُضُوءَهُ , إِلا غُفِرُ لَهُ مَا بَيْنَهُ ، وَبَيْنَ الصَّلاةِ الأُخْرَى حَتَّى يُصَلِّيَهَا "", قَالَ : أَنَا سَمِعْتُهُ مِنْهُ""","","","","","Book of Purification"
"138","عَنْ إِسْرَائِيلَ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَطَاءٍ ، عَنْ عُقْبَةَ بْنِ عَامِرٍ الْجُهَنِيِّ , قَالَ : كُنَّا مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي سَفَرَةٍ ، وَنَحْنُ نَتَنَاوَبُ رِعْيَةَ الإِبِلِ ، فَجِئْتُ ذَاتَ يَوْمٍ وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَخْطُبُ , وَقَدْ سَبَقَنِي بَعْضُ قَوْلِهِ فَجَلَسْتُ إِلَى جَنْبِ عُمَرَ بْنِ الْخَطَّابِ ، فَسَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : مَنْ تَوَضَّأَ فَأَسْبَغَ الْوُضُوءَ ، ثُمَّ قَامَ يُصَلِّي فَصَلَّى صَلاةً ، يَعْلَمُ مَا يَقُولُ فِيهَا حَتَّى يَفْرُغَ مِنْ صَلاتِهِ , كَانَ كَهَيْئَتِهِ يَوْمَ وَلَدَتْهُ أُمُّهُ "" , فَقَالَ : قُلْتُ : بَخٍ بَخٍ ، فَقَالَ عُمَرُ بْنُ الْخَطَّابِ : قَدْ قَالَ آنِفًا أَجْوَدَ مِنْ هَذَا , قَالَ : "" مَنْ تَوَضَّأَ فَأَسَبْغَ الْوُضُوءَ ، ثُمَّ قَامَ فَصَلَّى صَلاةً يَعْلَمُ مَا يَقُولُ فِيهَا حَتَّى فَرَغَ مِنْ صَلاتِهِ ، ثُمَّ قَالَ : أَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَشْهَدُ أَنَّ مُحمَّدًا عَبْدُهُ وَرَسُولُهُ ، فُتِحَتْ لَهُ ثَمَانِيَةُ أَبْوَابٍ مِنَ الْجَنَّةِ يَدْخُلُ مِنْ أَيِّهَا شَاءَ ""","","","","","Book of Purification"
"139","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ أَبَا مُوسَى الأَشْعَرِيَّ , قَالَ نُحَرِّقُ عَلَى أَنْفُسِنَا , فَإِذَا صَلَّيْنَا الْمَكْتُوبَةَ كَفَّرَتِ الصَّلاةُ مَا قَبْلَهَا ، ثُمَّ نُحَرِّقُ عَلَى أَنْفُسِنَا , فَإِذَا صَلَّيْنَا كَفَّرَتِ الصَّلاةُ مَا قَبْلَهَا ""","","","","","Book of Purification"
"140","عَنْ مَعْمَرٍ ، عَنْ أَبَانَ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قَالَ : قَالَ سَلْمَانُ الْفَارِسِيُّ  إِنَّالْعَبْدَ الْمُؤْمِنَ إِذَا قَامَ إِلَى الصَّلاةِ وُضِعَتْ خَطَايَاهُ عَلَى رَأْسِهِ ، فَلا يَفْرُغُ مِنْ صَلاتِهِ حَتَّى تَتَفَرَّقَ مِنْهُ كَمَا تَفَرَّقُ عُذُوقُ النَّخْلَةِ ، تَسَّاقَطُ يَمِينًا وَشِمَالا ""","","","","","Book of Purification"
"141","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مِسْعَرٍ ، عَنْ زَيْدٍ الْعَمِّيِّ ، عَنِ الْحَسَنِ , قَالَ : مَا يُنَادِي مُنَادٍ مِنْ أَهْلِ الأَرْضِ بِالصَّلاةِ حَتَّى يُنَادِيَ مُنَادٍ مِنْ أَهْلِ السَّمَاءِ : قُومُوا يَا بَنِي آدَمَ فَأَطْفِئُوا نِيرَانَكُمْ "" , قَالَ : فَيَقُومُ الْمُؤَذِّنُ يُؤَذِّنُ ، ثُمَّ يَقُومُ النَّاسُ إِلَى الصَّلاةِ ""","","","","","Book of Purification"
"142","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، عَنْ أَبِي كَثِيرٍ الزُّبَيْدِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ الْعَاصِ , قَالَ : خَرَجَتْ فِي عُنُقِ آدَمَ شَأْفَةٌ يَعْنِي بَثْرَةً فَصَلَّى صَلاةً فَانْحَدَرَتْ إِلَى صَدْرِهِ ، ثُمَّ صَلَّى صَلاةً فَانْحَدَرَتْ إِلَى الْحَقْوِ ، ثُمَّ صَلَّى صَلاةً فَانْحَدَرَتْ إِلَى الْكَفِّ ، ثُمَّ صَلَّى صَلاةً فَانْحَدَرَتْ إِلَى الإِبْهَامِ ، ثُمَّ صَلَّى صَلاةً فَذَهَبَتْ ""","","","","","Book of Purification"
"143","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي وَائِلٍ , قَالَ : قَالَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ : الصَّلَوَاتُ كَفَّارَاتٌ لِمَا بَيْنَهُنَّ , مَا اجْتُنِبَتِ الْكَبَائِرُ ""","","","","","Book of Purification"
"144","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَبِيهِ ، عَنِ الْمُغِيرَةِ بْنِ شُبَيْلٍ ، عَنْ طَارِقِ بْنِ شِهَابٍ ، أَنَّهُ بَاتَ عِنْدَ سَلْمَانَ يَنْظُرُ اجْتِهَادَهُ , قَالَ : فَقَامَ فَصَلَّى مِنْ آخِرِ اللَّيْلِ فَكَأَنَّهُ لَمْ يَرَ الَّذِي كَانَ يَظُنُّ , فَذَكَرَ ذَلِكَ لَهُ , فَقَالَ سَلْمَانُ : حَافِظُوا عَلَى هَذِهِ الصَّلَوَاتِ الْخَمْسِ فَإِنَّهُنَّ كَفَّارَاتٌ لِهَذِهِ الْجِرَاحَاتِ مَا لَمْ تُصِبِ الْمَقْتَلَةَ ، فَإِذَا أَمْسَى النَّاسُ كَانُوا عَلَى ثَلاثِ مَنَازِلَ : فَمِنْهُمْ مَنْ لَهُ وَلا عَلَيْهِ ، وَمِنْهُمْ مَنْ عَلَيْهِ وَلا لَهُ ، وَمِنْهُمْ لا لَهُ وَلا عَلَيْهِ ، فَرَجُلٌ اغْتَنَمَ ظُلْمَةَ اللَّيْلِ ، وَغَفْلَةَ النَّاسِ ، فَقَامَ يُصَلِّي حَتَّى أَصْبَحَ فَذَلِكَ لَهُ وَلا عَلَيْهِ ، وَرَجُلٌ اغْتَنَمَ غَفْلَةَ النَّاسِ ، وَظُلْمَةَ اللَّيْلِ ، فَرَكِبَ رَأْسَهُ فِي الْمَعَاصِي فَذَلِكَ عَلَيْهِ وَلا لَهُ ، وَرَجُلٌ صَلَّى الْعِشَاءَ ، ثُمَّ نَامَ فَذَلِكَ لا لَهُ وَلا عَلَيْهِ ، فَإِيَّاكَ وَالْحَقْحَقَةَ , وَعَلَيْكَ بِالْقَصْدِ وَالدَّوَامِ ""","","","","","Book of Purification"
"145","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ صَالِحٍ مَوْلَى التَّوْأَمَةِ ، عَنِ السَّائِبِ بْنِ خَبَّابٍ ، عَنْ زَيْدِ بْنِ ثَابِتٍ , قَالَ : صَلاةُ الرَّجُلِ فِي بَيْتِهِ نُورٌ ، وَإِذَا قَامَ الرَّجُلُ إِلَى الصَّلاةِ عُلِّقَتْ خَطَايَاهُ فَوْقَهُ ، فَلا يَسْجُدُ سَجْدَةً إِلا كَفَّرَ اللَّهُ عَنْهُ بِهَا خَطِيئَةً ""","","","","","Book of Purification"
"146","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ رَجُلٍ مِنْ أَهْلِ الْبَصْرَةِ ، عَنِ الْحَسَنِ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لِلْمُصَلِّي ثَلاثُ خِصَالٍ تَتَنَاثَرُ الرَّحْمَةُ عَلَيْهِ مِنْ قَدَمِهِ إِلَى عَنَانِ السَّمَاءِ ، وَتَحُفُّ بِهِ الْمَلائِكَةُ مِنْ قَرْنِهِ إِلَى أَعْنَانِ السَّمَاءِ ، وَيُنَادِي مُنَادٍ لَوْ عَلِمَ الْمُنَاجِي مَنْ يُنَاجِي مَا انْفَتَلَ ""","","","","","Book of Purification"
"147","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : إِذَا مَضْمَضَ كَانَ مَا يَخْرُجُ مِنْ فِيهِ خَطَايَا ، وَإِذَا اسْتَنْثَرَ كَانَ مَا يَخْرُجُ مِنْ أَنْفِهِ خَطَايَا ، وَإِذَا غَسَلَ وَجْهَهُ كَانَ مَا يَخْرُجُ مِنْهُ خَطَايَا ، وَإِذَا غَسَلَ يَدَيْهِ كَانَ مَا يَهْبِطُ مِنْهَا خَطَايَا ، وَإِذَا مَسَحَ بِرَأْسِهِ كَانَ مَا يَهْبِطُ عَنْهُ مِنَ الأَقْذَارِ خَطَايَا ، وَإِذَا غَسَلَ رِجْلَيْهِ كَانَ مَا يَهْبِطُ عَنْهُمَا خَطَايَا , حَتَّى يَرْجِعَ كَمَا وَلَدَتْهُ أُمُّهُ إِلا مِنْ كَبِيرَةٍ ""","","","","","Book of Purification"
"148","عَنِ الْمُثَنَّى بْنِ الصَّبَّاحِ ، عَنِ الْقَاسِمِ الشَّامِيِّ ، أَنَّ مَوْلاةً لَهُ يُقَالُ لَهَا أُمُّ هَاشِمٍ , أَجْلَسَتْهُ فِي السِّتْرِ بِدَوَاةٍ وَقَلَمٍ ، وَأَرْسَلَتْ إِلَى أَبِي أُمَامَةَ , فَسَأَلَتْهُ عَنْ حَدِيثٍ حَدَّثَهُ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْوُضُوءِ , فَقَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : مَنْ قَامَ إِلَى الْوُضُوءِ فَغَسَلَ يَدَيْهِ خَرَجَتِ الْخَطَايَا مِنْ يَدَيْهِ ، فَإِذَا مَضْمَضَ خَرَجَتِ الْخَطَايَا مِنْ فِيهِ ، فَإِذَا اسْتَنْثَرَ خَرَجَتْ مِنْ أَنْفِهِ ، فَكَذَلِكَ حَتَّى يَغْسِلَ الْقَدَمَيْنِ , فَإِنْ خَرَجَ إِلَى صَلاةٍ مَفْرُوضَةٍ كَانَ كَحَجَّةٍ مَبْرُورَةٍ ، وَإِنْ خَرَجَ إِلَى صَلاةِ تَطَوُّعٍ كَانَتْ كَعُمْرَةٍ مَبْرُورَةٍ ""","","","","","Book of Purification"
"149","عَنْ مُقَاتِلٍ ، وَرَجُلٌ ، عَنْ أَشْعَثَ بْنِ سَوَّارٍ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ ، عَنْ عَلِيٍّ , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ أيُّ اللَّيْلِ أَفْضَلُ ؟ قَالَ : جَوْفُ اللَّيْلِ الآخِرُ , قَالَ : ثُمَّ الصَّلاةُ مَقْبُولَةٌ إِلَى صَلاةِ الْفَجْرِ ، ثُمَّ لا صَلاةَ إِلَى طُلُوعِ الشَّمْسِ ، ثُمَّ الصَّلاةُ مَقْبُولَةٌ إِلَى صَلاةِ الْعَصْرِ ، ثُمَّ لا صَلاةَ حَتَّى تَغْرُبَ الشَّمْسُ "" , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ، كَيْفَ صَلاةُ اللَّيْلِ ؟ , قَالَ : "" مَثْنَى مَثْنَى "" , قَالَ : قُلْتُ : كَيْفَ صَلاةُ النَّهَارِ ؟ , قَالَ : "" أَرْبَعًا أَرْبَعًا "" , قَالَ : "" وَمَنْ صَلَّى عَلَيَّ صَلاةً كَتَبَ اللَّهُ لَهُ قِيرَاطًا ، وَالْقِيرَاطُ مِثْلُ أُحُدٍ ، وَأَنَّ الْعَبْدَ إِذَا قَامَ يَتَوَضَّأُ فَغَسَلَ كَفَّيْهِ خَرَجَتْ ذُنُوبُهُ مِنْ كَفَّيْهِ ، ثُمَّ إِذَا مَضْمَضَ وَاسْتَنْشَقَ خَرَجَتْ ذُنُوبُهُ مِنْ خَيَاشِيمِهِ ، ثُمَّ إِذَا غَسَلَ وَجْهَهُ خَرَجَتْ ذُنُوبُهُ مِنْ وَجْهِهِ وَسَمْعِهِ وَبَصَرِهِ ، ثُمَّ إِذَا غَسَلَ ذِرَاعَيْهِ خَرَجَتْ ذُنُوبُهُ مِنْ ذِرَاعَيْهِ ، ثُمَّ إِذَا مَسَحَ بِرَأْسِهِ خَرَجَتْ ذُنُوبُهُ مِنْ رَأْسِهِ ، ثُمَّ إِذَا غَسَلَ رِجْلَيْهِ خَرَجَتْ ذُنُوبُهُ مِنْ رِجْلَيْهِ ، ثُمَّ إِذَا قَامَ إِلَى الصَّلاةِ خَرَجَ مِنْ ذُنُوبِهِ كَيَوْمِ وَلَدَتْهُ أُمُّهُ ""","","","","","Book of Purification"
"150","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي قِلابَةَ ، عَنْ عَمْرِو بْنِ عَبْسَةَ , قَالَ : كَانَ جَالِسًا مَعَ أَصْحَابٍ لَهُ ، إِذْ قَالَ لَهُ رَجُلٌ : مَنْ يُحَدِّثُنَا حَدِيثًا عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ عَمْرٌو : أَنَا , قَالَ : هِيَ ، لِلَّهِ أَبُوكَ وَاحْذَرْ , قَالَ : سَمِعْتُهُ , يَقُولُ : مَنْ شَابَ شَيْبَةً فِي سَبِيلِ اللَّهِ كَانَتْ لَهُ نُورًا يَوْمَ الْقِيَامَةِ "", قَالَ : هِيَ ، لِلَّهِ أَبُوكَ وَاحْذَرْ""","","","","","Book of Purification"
"151","قَالَ : وَسَمِعْتُهُ يَقُولُ : مَنْ رَمَى سَهْمَا فِي سَبِيلِ اللَّهِ كَانَ لَهُ عَدْلُ رَقَبَةٍ "", قَالَ : هِيَ ، لِلَّهِ أَبُوكَ وَاحْذَرْ""","","","","","Book of Purification"
"152","قَالَ : وَسَمِعْتُهُ يَقُولُ : مَنْ أَعْتَقَ نَسَمَةً أَعْتَقَ اللَّهُ بِكُلِّ عُضْوٍ مِنْهَا عُضْوًا مِنْهُ مِنَ النَّارِ ""","","","","","Book of Purification"
"153","قَالَ : وَسَمِعْتُهُ يَقُولُ : مَنْ أَعْتَقَ نَسَمَتَيْنِ ، أَعْتَقَ اللَّهُ بِكُلِّ عُضْوَيْنِ مِنْهُمَا عُضْوَيْنِ مِنْهُ مِنَ النَّارِ "", قَالَ : هِيَ ، لِلَّهِ أَبُوكَ , وَاحْذَرْ""","","","","","Book of Purification"
"154","قَالَ : وَحَدِيثًا لَوْ أَنِّي لَمْ أَسْمَعْهُ مِنْهُ إِلا مَرَّةً , أَوْ مَرَّتَيْنِ , أَوْ ثَلاثًا , أَوْ أَرْبَعًا , أَوْ خَمْسًا لَمْ أُحَدِّثْكُمُوهُ : مَا مِنْ عَبْدٍ مُسْلِمٍ يَتَوَضَّأُ فَيَغْسِلُ وَجْهَهُ , إِلا تَسَاقَطَتْ خَطَايَا وَجْهِهِ مِنْ أَطْرَافِ لِحْيَتِهِ ، فَإِذَا غَسَلَ يَدَيْهِ تَسَاقَطَتْ خَطَايَا يَدَيْهِ مِنْ بَيْنِ أَظْفَارِهِ ، فَإِذَا مَسَحَ بِرَأْسِهِ تَسَاقَطَتْ خَطَايَا رَأْسِهِ مِنْ أَطْرَافِ شَعْرِهِ ، فَإِذَا غَسَلَ رِجْلَيْهِ تَسَاقَطَتْ خَطَايَا رِجْلَيْهِ مِنْ بَاطِنِهِمَا ، فَإِنْ أَتَى مَسْجِدًا فَصَلَّى فِي جَمَاعَةٍ فِيهِ فَقَدْ وَقَعَ أَجْرُهُ عَلَى اللَّهِ ، فَإِنْ قَامَ فَصَلَّى رَكْعَتَيْنِ كَانَتَا كَفَّارَةً "", قَالَ : هِيَ ، لِلَّهِ أَبُوكَ , وَاحْذَرْ , حَدِّثْ وَلا تُخْطِئْ""","","","","","Book of Purification"
"155","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا مَضْمَضَ الْعَبْدُ خَرَجَتْ كُلُّ خَطِيئَةٍ كَانَ يَتَكَلَّمُ بِهَا مَعَ الْمَاءِ إِذَا خَرَجَ مِنْ فِيهِ ، وَإِذَا غَسَلَ وَجْهَهُ خَرَجَتْ كُلُّ خَطِيئَةٍ فِي وَجْهِهِ مَعَ الْمَاءِ الَّذِي يَقْطُرُ مِنْ وَجْهِهِ ، وَإِذَا غَسَلَ يَدَيْهِ خَرَجَتِ الْخَطَايَا مِنْ يَدَيْهِ مَعَ الْمَاءِ الَّذِي يَقْطُرُ مِنْ يَدَيْهِ ، وَإِذَا غَسَلَ رِجْلَيْهِ خَرَجَتِ الْخَطَايَا مِنْ رِجْلَيْهِ حِينَ يَغْسِلُهُمَا ، فَإِذَا خَرَجَ مِنْ بَيْتِهِ إِلَى الْمَسْجِدِ مُحِيَ عَنْهُ بِكُلِّ خُطْوَةٍ خَطِيئَةٌ ، وَزِيدَ بِهَا حَسَنَةً حَتَّى يَدْخُلَ الْمَسْجِدَ ""","","","","","Book of Purification"
"156","عَنْ قَيْسِ بْنِ الرَّبِيعِ ، عَنِ الأَسْوَدِ بْنِ قَيْسٍ ، عَنْ ثَعْلَبَةَ بْنِ عَبَّادٍ ، عَنْ أَبِيهِ ، قَالَ : مَا أَدْرِي كَمْ حَدَّثَنِي هَذَا الْحَدِيثَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَا مِنْ عَبْدٍ يَتَوَضَّأُ فَيُحْسِنُ وُضُوءَهُ , حَتَّى يَسِيلَ الْمَاءُ عَلَى وَجْهِهِ ، ثُمَّ يَغْسِلُ ذِرَاعَيْهِ حَتَّى يَسِيلَ الْمَاءُ عَلَى مِرْفَقَيْهِ ، ثُمَّ يَغْسِلُ قَدَمَيْهِ حَتَّى يَسِيلَ الْمَاءُ مِنْ قِبَلِ عَقِبَيْهِ ، ثُمَّ يُصَلِّي فَيُحْسِنُ صَلاتَهُ إِلا غُفِرَ لَهُ مَا سَلَفَ ""","","","","","Book of Purification"
"157","عَنِ الثَّوْرِيِّ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنْ سُلَيْمَانَ بْنِ بُرَيْدَةَ ، عَنْ أَبِيهِ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : يَتَوَضَّأُ لِكُلِّ صَلاةٍ حَتَّى كَانَ يَوْمُ الْفَتْحِ , فَصَلَّى الظُّهْرَ , وَالْعَصْرَ , وَالْمَغْرِبَ بِوُضُوءٍ وَاحِدٍ ""","","","","","Book of Purification"
"158","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ عَلْقَمَةَ بْنِ مَرْثَدٍ ، عَنْ سُلَيْمَانَ بْنِ بُرَيْدَةَ ، عَنْ أَبِيهِ , قَالَ : صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الصَّلَوَاتِ بِوُضُوءٍ وَاحِدٍ ، وَمَسَحَ عَلَى خُفَّيْهِ "" ، فَقَالَ لَهُ عُمَرُ : يَا رَسُولَ اللَّهِ ! صَنَعْتَ شَيْئًا لَمْ تَكُنْ تَصْنَعُهُ ؟ قَالَ : "" إِنِّي عَمْدًا صَنَعْتُهُ يَا عُمَرُ ! ""","","","","","Book of Purification"
"159","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ يُونُسَ بْنِ جُبَيْرٍ أَبِي غَلابٍ ، عَنْ حِطَّانَ بْنِ عَبْدِ اللَّهِ الرَّقَاشِيِّ , قَالَ : كُنَّا مَعَ أَبِي مُوسَى الأَشْعَرِيِّ فِي جَيْشٍ عَلَى سَاحِلِ دِجْلَةَ ، إِذْ حَضَرَتِ الصَّلاةُ فَنَادَى مُنَادِيهِ لِلظُّهْرِ ، فَقَامَ النَّاسُ إِلَى الْوُضُوءِ ، فَتَوَضَّئُوا فَصَلَّى بِهِمْ ، ثُمَّ جَلَسُوا حِلَقًا ، فَلَمَّا حَضَرَتِ الْعَصْرُ نَادَى مُنَادِي الْعَصْرِ ، فَهَبَّ النَّاسُ لِلْوُضُوءِ أَيْضًا ، فَأَمَرَ مُنَادِيَهُ فَنَادَى  أَلا ,لا وُضُوءَ إِلا عَلَى مَنْ أَحْدَثَ ، قَدْ أَوْشَكَ الْعِلْمُ أَنْ يَذْهَبَ ، وَيَظْهَرَ الْجَهْلُ حَتَّى يَضْرِبَ الرَّجُلُ أُمَّهُ بِالسَّيْفِ مِنَ الْجَهْلِ ""","","","","","Book of Purification"
"160","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : مَا أُبَالِي أَنْ أُصَلِّيَ خَمْسَ صَلَوَاتٍ كُلُّهُنَّ بِوُضُوءٍ وَاحِدٍ , مَا لَمْ أُدَافِعْ غَائِطًا , أَوْ بَوْلا "", عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , مِثْلَهُ""","","","","","Book of Purification"
"161","عَنِ الثَّوْرِيِّ ، عَنْ عَمْرِو بْنِ عَامِرٍ , قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِكٍ , يَقُولُ :  كَانَأَحَدُنَا يَكْفِيهِ الْوُضُوءُ مَا لَمْ يُحْدِثْ ""","","","","","Book of Purification"
"162","عَنِ الثَّوْرِيِّ ، عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ ، عَنْ إِبْرَاهِيمَ , قَالَ : إِنِّي لأُصَلِّي الظُّهْرَ , وَالْعَصْرَ , وَالْمَغْرِبَ بِوُضُوءٍ وَاحِدٍ مَا لَمْ أُحْدِثْ ، أَوْ أَقُولُ مُنْكَرًا ""","","","","","Book of Purification"
"163","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ , قَالَ : لا يُجُوزُ وُضُوءُ أَحَدٍ أَكْثَرَ مِنْ صَلاةِ يَوْمٍ وَلَيْلَةٍ ، أَحْدَثَ أَوْ لَمْ يُحْدِثْ ، وَيَمْسَحُ أَوْ لَمْ يَمْسَحْ "", قَالَ : وَسَمِعْتُ وَهْبًا , يَقُولُ : "" إِنِّي لأُصَلِّي الظُّهْرَ بِوُضُوءِ الْعِشَاءِ ""","","","","","Book of Purification"
"164","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْوُضُوءُ لِكُلِّ صَلاةٍ ؟ قَالَ : "" لا ، قُلْتُ : فَإِنَّهُ يَقُولُ :  إِذَا قُمْتُمْ إِلَى الصَّلاةِ , قَالَ : حَسْبُكَ الْوُضُوءُ الأَوَّلُ ، لَوْ تَوَضَّأْتُ لِلصُّبْحِ لَصَلَّيْتُ الصَّلَوَاتِ كُلَّهَا بِهِ , مَا لَمْ أُحْدِثْ , قُلْتُ : فَيُسْتَحَبُّ أَنْ أَتَوَضَّأَ لِكُلِّ صَلاةٍ ؟ , قَالَ : لا ""","","","","","Book of Purification"
"165","عَنْ يَحْيَى بْنِ الْعَلاءِ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَةَ بْنِ عُمَيْرٍ , قَالَ : كَانَ الأَسْوَدُ بْنُ يَزِيدَ يَتَوَضَّأُ بِقَدَحٍ قَدْرَ رِيِّ الرَّجُلِ ، ثُمَّ يُصَلِّي بِذَلِكَ الْوُضُوءِ الصَّلَوَاتِ كُلَّهَا , مَا لَمْ يُحْدِثْ ""","","","","","Book of Purification"
"166","عَنْ صَاحِبٍ لَهُ ، عَنْ أَبِي ذِئْبٍ ، عَنْ شُعْبَةَ مَوْلَى ابْنِ عَبَّاسٍ ، أَنَّ الْمِسْوَرَ بْنَ مَخْرَمَةَ , قَالَ لابْنِ عَبَّاسٍ : هَلْ لَكَ بَحْرٌ فِي عُبَيْدِ بْنِ عُمَيْرٍ إِذَا سَمِعَ النَّدَاءَ خَرَجَ فَتَوَضَّأَ , قَالَ ابْنُ عَبَّاسٍ : هَكَذَا يَصْنَعُ الشَّيْطَانُ إِذَا جَاءَ فَآذِنُونِي "" , فَلَمَّا جَاءَ أَخْبَرُوهُ , فَقَالَ : مَا يَحْمِلُكَ عَلَى مَا تَصْنَعُ ؟ "" , فَقَالَ : إِنَّ اللَّهَ يَقُولُ :  إِذَا قُمْتُمْ إِلَى الصَّلاةِ فَاغْسِلُوا وُجُوهَكُمْ فَتَلا الآيَةَ , فَقَالَ ابْنُ عَبَّاسٍ : "" لَيْسَ هَكَذَا , إِذَا تَوَضَّأْتَ فَأَنْتَ طَاهِرٌ مَا لَمْ تُحْدِثْ ""","","","","","Book of Purification"
"167","عَنْ رَجُلٍ مِنْ أَهْلِ مِصْرَ , قَالَ : أَخْبَرَنَا فُضَيْلُ بْنُ مَرْزُوقٍ الْهَمْدَانِيُّ ، أَنَّ عَلِيًّا  كَانَيَتَوَضَّأُ لِكُلِّ صَلاةٍ ""","","","","","Book of Purification"
"168","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنَا نَافِعٌ ، أَنَّ عُمَرَ  كَانَيُمَضْمِضُ ، وَيَسْتَنْثِرُ لِكُلِّ صَلاةٍ ""","","","","","Book of Purification"
"169","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَيَتَوَضَّأُ لِكُلِّ صَلاةٍ ""","","","","","Book of Purification"
"170","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ ، أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ  كَانَيَكْرَهُ أَنْ يَتَوَضَّأَ فِي النُّحَاسِ , قَالَ : "" جَاءَتْهُ النُّضَارُ , وَالرِّكَاءُ , وَطَسْتُ نُحَاسٍ ""","","","","","Book of Purification"
"171","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ , عَنِ ابْنِ عُمَرَ  أَنَّهُ كَانَلا يَتَوَضَّأُ فِي الصُّفْرِ "", قَالَ سُفْيَانُ : "" وَلا نَأْخُذُ بِهِ "" , قُلْتُ : مَا النُّضَارُ ؟ , قَالَ : عُودُ الطَّرْفَاءِ""","","","","","Book of Purification"
"172","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ , قَالَ : كَانَ ابْنُ عُمَرَيَغْسِلُ قَدَمَيْهِ فِي طَسْتٍ مِنْ نُحَاسٍ , قَالَ :  وَكَانَ يَكْرَهُ أَنْ يَشْرَبَ فِي قَدَحٍ مِنْ صُفْرٍ ""","","","","","Book of Purification"
"173","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : ذَكَرْتُ لَهُ كَرَاهِيَةَ ابْنِ عُمَرَ فِي النُّحَاسِ ، قَالَ : الْوُضُوءُ فِي النُّحَاسِ مَا يُكْرَهُ مِنَ النُّحَاسِ شَيْءٌ ، إِلا لِرِيحِهِ فَقَطْ ""","","","","","Book of Purification"
"174","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ  أَنَّهُ كَانَيَتَوَضَّأُ فِي آنِيَةِ النُّحَاسِ ""","","","","","Book of Purification"
"175","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ  كَانَيَكْرَهُ أَنْ يَتَوَضَّأَ فِي النُّحَاسِ ""","","","","","Book of Purification"
"176","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  كَانَيَغْسِلُ رَأْسَهُ فِي سَطْلٍ مِنْ نُحَاسٍ لِبَعْضِ أَزْوَاجِهِ""","","","","","Book of Purification"
"177","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ عَبْدَ اللَّهِ بْنَ عُمَرَ ، عَنِ الْوُضُوءِ فِي النُّحَاسِ , قَالَ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَغْسِلُ رَأْسَهُ فِي سَطْلٍ مِنْ نُحَاسٍ لِزَيْنَبَ بِنْتِ جَحْشٍ "", فَقَالَ رَجُلٌ حِينَئِذٍ عِنْدَنَا مِنْ آلِ جَحْشٍ : نَعَمْ , ذَلِكَ الْمِخْضَبُ عِنْدَنَا""","","","","","Book of Purification"
"178","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَائِشَةَ , قَالَتْ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي مَرَضِهِ الَّذِي مَاتَ فِيهِ : صُبُّوا عَلَيَّ مِنْ سَبْعِ قِرَبٍ لَمْ تُحْلَلْ أَوْكِيَتُهُنَّ فَأَعْهَدُ إِلَى النَّاسِ "" , قَالَتْ عَائِشَةُ : فَأَجْلَسْنَاهُ فِي مِخْضَبٍ لِحَفْصَةَ مِنْ نُحَاسٍ , وَسَكَبْنَا عَلَيْهِ الْمَاءَ مِنْهُنَّ حَتَّى طَفِقَ يُشِيرُ إِلَيْنَا أَنْ قَدْ فَعَلْتُنَّ , ثُمَّ خَرَجَ""","","","","","Book of Purification"
"179","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أُخْبِرْتُ عَنْ مُعَاوِيَةَ أَنَّهُ قَالَ : نُهِيتُ أَنْ أَتَوَضَّأَ فِي النُّحَاسِ ، وَأَنْ آتِي أَهْلِي فِي غُرَّةِ الْهِلالِ ، وَإِذَا انْتَبَهْتُ مِنْ سِنَتِي لِلصَّلاةِ أَنْ أَسْتَاكَ "", قَالَ : قِيلَ لِي أَرَى أَنَّ قَوْلَهُ : "" آتِي أَهْلِي فِي غُرَّةِ الْهِلالِ "" يُحَذِّرُ النَّاسَ ذَلِكَ فِي الْهِلالِ ، وَفِي النِّصْفِ مِنْ أَجْلِ الشَّيْطَانِ""","","","","","Book of Purification"
"180","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ أَبِي مُلَيْكَةَ , يَقُولُ : تَبَرَّزَ عُمَرُ بْنُ الْخَطَّابِ فِي أَجْيَادَ ، ثُمَّ رَجَعَ فَاسْتَوْهَبَ وَضُوءًا فَلَمْ يَهَبُوا لَهُ , قَالَتْ أُمُّ مَهْزُولٍ وَهِيَ مِنَ الْبَغَايَا التِّسْعِ اللَّوَاتِي كُنَّ فِي الْجَاهِلِيَّةِ : يَا أَمِيرَ الْمُؤْمِنِينَ ! هَذَا مَاءٌ وَلَكِنَّهُ فِي عُلْبَةٍ ، وَالْعُلْبَةُ الَّتِي لَمْ تُدْبَغْ ، فَقَالَ عُمَرُ لِخَالِدِ بْنِ طُحَيْلٍ  هِيَ ؟ "" , قَالَ : نَعَمْ ! فَقَالَ : "" هَلُمَّ , فَإِنَّاللَّهَ جَعَلَ الْمَاءَ طَهُورًا ""","","","","","Book of Purification"
"181","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ إِنْسَانٌ عَطَاءً ، فَقَالَ : أَشْرَبُ وَأَتَوَضَّأُ مِنْ مَاءٍ يَكُونُ فِي ظَرْفٍ وَلَمْ يُدْبَغْ ؟ قَالَ : أَذَكِيٌّ ؟ , قَالَ : نَعَمْ ، وَلَيْسَ بِمَيْتَةٍ , قَالَ : لا بَأْسَ بِذَلِكَ ""","","","","","Book of Purification"
"182","عَنْ إِسْرَائِيلَ ، عَنْ عِيسَى بْنِ أَبِي عَزَّةَ ، عَنْ عَامِرٍ الشَّعْبِيِّ , قَالَ : دِبَاغُ الْجُلُودِ ذَكَاتُهَا ""","","","","","Book of Purification"
"183","أَخْبَرَنَا أَبُو سَعِيدٍ أَحْمَدُ بْنُ مُحَمَّدِ بْنِ زِيَادِ بْنِ بِشْرٍ الأَعْرَابِيُّ , قَالَ : حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ , قَالَ : قَرَأْنَا عَلَى عَبْدِ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : مَرَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى شَاةٍ لِمَوْلاةٍ لِمَيْمُونَةَ , فَقَالَ : أَفَلا اسْتَمْتَعْتُمْ بِإِهَابِهَا ؟ "" , قَالُوا : فكَيْفَ وَهِيَ مَيْتَةٌ ؟ يَا رَسُولَ اللَّهِ ! , قَالَ : "" إِنَّمَا حُرِّمَ لَحْمُهَا ""","","","","","Book of Purification"
"184","عَنْ مَعْمَرٍ ، وَكَانَ الزُّهْرِيُّ ينكر الدباغ , ويقول : يُسْتَمْتَعُ بِهِ عَلَى كُلِّ حَالٍ ""","","","","","Book of Purification"
"185","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا دُبِغَ جِلْدُ الْمَيْتَةِ فَحَسْبُهُ , فَلْيَنْتَفِعْ بِهِ ""","","","","","Book of Purification"
"186","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً , يَقُولُ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : كَانَتْشَاةٌ دَاجِنَةٌ لإِحْدَى نِسَاءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَمَاتَتْ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَفَلا اسْتَمْتَعْتُمْ بِإِهَابِهَا ؟ ""","","","","","Book of Purification"
"187","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ عَطَاءٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : أَخْبَرَتْنِي مَيْمُونَةُ ، أَنَّشَاةً مَاتَتْ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَلا دَبَغْتُمْ إِهَابَهَا ؟ ""","","","","","Book of Purification"
"188","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : حَدَّثَنِي غَيْرُ عَطَاءٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَوْهَبَ وَضُوءًا ، فَقِيلَ لَهُ : مَا نَجِدُ لَكَ إِلا فِي مَسْكِ مَيْتَةٍ , قَالَ : "" أَدَبَغْتُمُوهُ ؟ "" , قَالُوا : نَعَمْ , قَالَ : "" هَلُمَّ فَإِنَّ ذَلِكَ طَهُورٌ ""","","","","","Book of Purification"
"189","عَنِ الثَّوْرِيِّ ، عَنْ زَيْدِ بْنِ أَسْلَمَ , قَالَ : حَدَّثَنِي عَبْدُ الرَّحْمَنِ بْنُ وَعْلَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : قُلْتُ لَهُ : إِنَّا نَغْزُو أَهْلَ الْمَشْرِقِ فَنُؤْتَى بِالأُهُبِ بِالأَسْقِيَةِ , قَالَ : مَا أَدْرِي مَا أَقُولُ لَكَ , إِلا أَنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : أَيُّمَا إِهَابٍ دُبِغَ فَقَدْ طَهُرَ ""","","","","","Book of Purification"
"190","عَنْ مَالِكِ بْنِ أَنَسٍ ، قَالَ : حَدَّثَنِي يَزِيدُ بْنُ عَبْدِ اللَّهِ بْنِ قُسَيْطٍ ، عَنِ ابْنِ ثَوْبَانَ ، عَنْ أُمِّهِ ، عَنْ عَائِشَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَمَرَ أَنْ يُسْتَمْتَعَ بِجُلُودِ الْمَيْتَةِ إِذَا دُبِغَتْ ""","","","","","Book of Purification"
"191","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنْ ثَعْلَبَةَ ، عَنْ أَبِي وَائِلٍ ، عَنْ عُمَرَ ، أَنَّهُسُئِلَ عَنْ مَيْتَةٍ , فَقَالَ :  طُهُورُهَا دِبَاغُهَا ""","","","","","Book of Purification"
"192","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ بْنِ عُبَيْدٍ ، عَنِ الْحَسَنِ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَسْقَى فَأُتِيَ بِسِقَاءٍ , قِيلَ : إِنَّهُ مَيْتٌ ، وَذَكَرُوا الدِّبَاغَ , قَالَ : "" فَشَرِبَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْهُ ""","","","","","Book of Purification"
"193","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : سَأَلْتُهُ عَنِالرَّجُلِ تَكُونُ لَهُ الإِبِلُ , وَالْبَقَرُ , وَالْغَنَمُ فَتَمُوتُ فَتُدْبَغُ جُلُودُهَا , قَالَ :  يَبِيعُهَا أَوْ يَلْبَسُهَا "", عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، مِثْلَ قَوْلِ إِبْرَاهِيمَ""","","","","","Book of Purification"
"194","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :أَيَبِيعُ الرَّجُلُ جُلُودَ الضَّأْنِ الْمَيْتَةِ لَمْ تُدْبَغْ ؟ قَالَ :  مَا أُحِبُّ أَنْ تَأْكُلَ ثَمَنَهَا ، وَإِنْ تُدْبَغُ ""","","","","","Book of Purification"
"195","عَنْ مَعْمَرٍ ، عَمَّنْ ، سَمِعَ الْحَسَنَ ، يَقُولُ : فِيجُلُودِ الْمَيْتَةِ  طُهُورُهَا دِبَاغُهَا "" , قَالَ : وَكَانَ الْحَسَنُ , يَقُولُ : "" يُنْتَفَعُ بِهَا , وَلا تُبَاعُ ""","","","","","Book of Purification"
"196","عَنِ الثَّوْرِيِّ ، عَنْ عِيسَى بْنِ أَبِي عَزَّةَ ، عَنْ عَامِرٍ الشَّعْبِيِّ قَالَ : ذَكَاةُ الْجُلُودِ دِبَاغُهَا فَالْبَسْ ""","","","","","Book of Purification"
"197","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنَا نَافِعٌ مَوْلَى ابْنِ عُمَرَ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدِ بْنِ أَبِي بَكْرٍ ، أَنَّ مُحَمَّدَ بْنَ الأَشْعَثِ ، كَلَّمَ عَائِشَةَ فِي أَنْيَتَّخِذَ لَهَا لَحَافًا مِنَ الْفِرَاءِ ، فَقَالَتْ :  إِنَّهُ مَيْتَةٌ وَلَسْتُ بِلابِسَةٍ شَيْئًا مِنَ الْمَيْتَةِ "" , قَالَ : فَنَحْنُ نَصْنَعُ لَكَ لَحَافًا نَدْبَغُ , وَكَرِهَتْ أَنْ تَلْبَسَ مِنَ الْمَيْتَةِ""","","","","","Book of Purification"
"198","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً  يَسْأَلُ عَنْأَوْلادِ الضَّأْنِ ، تُسْتَلُّ مِنْ أَجْوَافِ أُمَّهَاتِهَا , فَتَخْرُجُ مَيِّتَةً فَتُجْعَلُ مُسُوكُهَا فِرَاءً , قَالَ : "" أَتُدْبَغُ ؟ "" , قَالَ : نَعَمْ , قَالَ : "" فَحَسْبُهُ ، الْبَسُوهُ ""","","","","","Book of Purification"
"199","عَنِ ابْنِ جُرَيْجٍ ، قَالَ عَطَاءٌ : مَا نَسْتَمْتِعُ مِنَ الْمَيْتَةِ إِلا بِجُلُودِهَا ، إِذَا دُبِغَتْ فَإِنَّ دِبَاغَهَا طُهُورُهُ وَذَكَاتُهُ ""","","","","","Book of Purification"
"200","عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ ، عَنْ شُعْبَةَ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، عَنْ عَبْدِ اللَّهِ بْنِ عُكَيْمٍ , قَالَ : قُرِئَ عَلَيْنَا كِتَابُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي أَرْضِ جُهَيْنَةَ وَأَنَا غُلامٌ شَابٌّ : أَلا تَسْتَمْتِعُوا مِنَ الْمَيْتَةِ بِشَيْءٍ بِإِهَابٍ , وَلا عَصَبٍ ""","","","","","Book of Purification"
"201","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَرَأَيْتَلَوِ اضْطُرِرْتُ فِي سَفَرٍ إِلَى مَاءٍ فِي ظَرْفِ مَيْتَةٍ لَمْ يُدْبَغْ ، أَوٍ إِلَى مَاءٍ فِيهِ فَأْرَةٌ مَيِّتَةٌ لَيْسَ مَعِي مَاءٌ غَيْرُهُ فَهُوَ أَحَبُّ إِلَيْكَ أَنْ تُطَهِّرَ بِهِ , أَمِ التُّرَابُ ؟ قَالَ : "" بَلْ هُوَ أَحَبُّ إِلَيَّ مِنَ التُّرَابِ "" , قُلْتُ : فَنَدَعُهُ فِي الْقَرَارِ ؟ , قَالَ : "" نَعَمْ "" , قُلْتُ : فَتَوَضَّأْتُ بِهِ فِي الْقَرَارِ وَلا أَدْرِي ، ثُمَّ صَلَّيْتُ الْمَكْتُوبَةَ ، ثُمَّ عَلِمْتُ قَبْلَ أَنْ تَفُوتَنِي تِلْكَ الصَّلاةُ , قَالَ : "" فَعُدْ فَتَوَضَّأْ , ثُمَّ عُدْ لِصَلاتِكَ "" , قَالَ : قُلْتُ : فَعَلِمْتُ بَعْدُ مَا فَاتَنِي , قَالَ : فَلا تُعِدْ ""","","","","","Book of Purification"
"202","عَنِ الثَّوْرِيِّ ، عَنْ عَمْرٍو , قَالَ : لَيْسَ لِصُوفِ الْمَيْتَةِ ذَكَاةٌ ، اغْسِلْهُ فَانْتَفِعْ بِهِ "", قَالَ الثَّوْرِيُّ : أَلَمْ تَرَ أَنَّا نَنْزِعُهُ وَهِيَ حَيَّةٌ ؟""","","","","","Book of Purification"
"203","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِيرِينَ , قَالَ : الصُّوفُ , وَالْمَرْعَزُ , وَالْجَزُّ , وَالثَّلُّ لا بَأْسَ بِهِ ، وَبِرِيشِ الْمَيْتَةِ ""","","","","","Book of Purification"
"204","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ , قَالَ : لا بَأْسَ بِصُوفِ الْمَيْتَةِ , وَلَكِنَّهُ يُغْسَلُ , وَلا بَأْسَ بِرِيشِ الْمَيْتَةِ ""","","","","","Book of Purification"
"205","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ إِنْسَانٌ عَطَاءًعَنْ صُوفِ الْمَيْتَةِ فَكَرِهَهُ ، وَقَالَ :  إِنِّي لَمْ أَسْمَعْ أَنَّهُ يُرَخِّصُ إِلا فِي إِهَابِهَا إِذَا دُبِغَ ""","","","","","Book of Purification"
"206","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , قَالَ ذَكَرُوا أَنَّهُ يُسْتَثْقَبُ بِشُحُومِ الْمَيْتَةِ ، وَيُدَّهَنُ بِهَا السُّفُنُ ، وَلا يُمَسُّ , قَالَ : يُؤْخَذُ بِعُودٍ , قُلْتُ : أَيُدَّهَنُ بِهَا غَيْرُ السُّفُنِ أَدِيمٌ , أَوْ شَيْءٌ يُمَسُّ ؟ , قَالَ : لَمْ أَعْلَمْ , قُلْتُ : وَأَيْنَ يُدَّهَنُ مِنَ السُّفُنِ ؟ , قَالَ : ظُهُورُهَا وَلا يُدَّهَنُ بُطُونُهَا , قُلْتُ : وَلا بُدَّ أَنْ يَمَسَّ وَدَكَهَا بِيَدِهِ فِي الْمِصْبَاحِ ؟ , قَالَ : فَلْيَغْسِلْ يَدَهُ إِذَا مَسَّهُ ""","","","","","Book of Purification"
"207","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ عِظَامُ الْفِيلِ ؟ ، فَإِنَّهُ زَعَمُوا الأَنْصَابَ عِظَامَهَا وَهِيَ مَيِّتَةٌ "" , قَالَ : "" فَلا يُسْتَمْتَعُ بِهَا "" , قُلْتُ : "" وَعِظَامُ الْمَاشِيَةِ الْمَيِّتَةِ كَذَلِكَ ؟ "" , قَالَ : "" نَعَمْ "" , قُلْتُ : "" أَيُجْعَلُ فِي عِظَامِ الْمَيْتَةِ شَيْءٌ يُحْوَ فِيهِ "" , قَالَ : "" لا ""","","","","","Book of Purification"
"208","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ الدَّابَّةُ الَّتِي تَكُونُ مِنْهَا مُشْطُ الْعَاجِ يُؤْخَذُ مَيْتَةً فَيُجْعَلُ مِنْهَا مَسَكٌ , فَإِنَّهُ لا يُذْبَحُ "" , قَالَ : "" لا "" ، ثُمَّ أَذْكَرْتُهُ , فقُلْتُ : "" إِنَّهَا مِنْ دَوَابِّ الْبَحْرِ مِمَّا يُلْقِيهَا "" , قَالَ : "" فَهِيَ مِمَّا يُلْقِي الْبَحْرُ ""","","","","","Book of Purification"
"209","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامٍ ، عَنِ ابْنِ سِيرِينَ , قَالَ :  كَانَلا يُرَى بِالتِّجَارَةِ بِالْعَاجِ بَأْسًا ""","","","","","Book of Purification"
"210","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ ، عَنْ طَاوُسٍ ، أَنَّهُ كَانَيَكْرَهُ عِظَامَ الْفِيلِ, قَالَ : قَالَ لِي مَعْمَرٌ :  وَرَأَى قَلَمَا مِنْ عَظْمِ الْفِيلِ فِي أَلْوَاحٍ لِي ، فَقَالَ : "" أَلْقِهِ "" , ثُمَّ رَأَى مَعْمَرٌ بَعْدُ مَعِي قَلَمَا فِي الأَلْوَاحِ فِي طَرَفِهِ حَلْقَةٌ مِنْ فِضَّةٍ ، ثُمَّ قَالَ : "" اطْرَحْ ""","","","","","Book of Purification"
"211","عَنْ مَعْمَرِ بْنِ أَبِي شَيْبَةَ , قَالَ : رَأَيْتُتَحْتَ وِسَادَةِ طَاوُسٍ عَلَى فِرَاشِهِ سِكِّينًا نِصَابُهُ مِنْ حَضَنٍ , قَالَ :  وَقَدْ رَآهُ حِينَ رَفَعْتُ الْوِسَادَةَ ""","","","","","Book of Purification"
"212","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ , قَالَ : وَكَانَ لأَبِي مُشْطٌ وَمُدٌّ مِنْ عِظَامِ الْفِيلِ "", يَعْنِي : الْحَضَنَ""","","","","","Book of Purification"
"213","عَنْ مَعْمَرٍ ، عَنْ يَزِيدَ الرِّشْكِ ، عَنْ أَبِي مُلَيْحِ بْنِ أُسَامَةَ , قَالَ :نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  أَنْ يَفْتَرِشَ جُلُودَ السِّبَاعِ ""","","","","","Book of Purification"
"214","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ أَبِي شَيْخٍ الْهُنَائِيِّ ، أَنَّ مُعَاوِيَةَ ، قَالَ لِنَفَرٍ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ : نَهَى أَنْ يُفْتَرَشَ جُلُودُ السِّبَاعِ ""","","","","","Book of Purification"
"215","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ أَبِي شَيْخٍ الْهُنَائِيِّ ، أَنَّ مُعَاوِيَةَ , قَالَ لِنَفَرٍ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : نَهَى عَنْ سُرُوجِ النُّمُورِ أَنْ يُرْكَبَ عَلَيْهَا ؟ "" , قَالُوا : "" نَعَمْ ""","","","","","Book of Purification"
"216","أَخْبَرَنَا عَبَّادُ بْنُ كَثِيرٍ الْبَصْرِيُّ ، عَنْ رَجُلٍ أَحْسَبُهُ خَالِد ، عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ , قَالَ : أُتِيَ عَلِيٌّ بِدَابَّةٍ ، فَإِذَا عَلَيْهَا سَرْجٌ عَلَيْهِ خَزٌّ ، فَقَالَ : نَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْخَزِّ ، عَنْ رُكُوبٍ عَلَيْهَا ، وَعَنْ جُلُوسٍ عَلَيْهَا ، وَعَنْ جُلُودِ النُّمُورِ ، عَنْ رُكُوبٍ عَلَيْهَا ، وَعَنْ جُلُوسٍ عَلَيْهَا ، وَعْنِ الْغَنَائِمِ أَنْ تُبَاعَ حَتَّى تُخَمَّسَ ، وَعَنْ حَبَالَى سَبَايَا الْعَدُوِّ أَنْ يُوطَأْنَ ، وَعَنِ الْحُمُرِ الأَهْلِيَّةِ ، وَعَنْ أَكْلِ ذِي نَابٍ مِنَ السِّبَاعِ ، وَأَكْلِ ذِي مِخْلَبٍ مِنَ الطَّيْرِ ، وَعَنْ ثَمَنِ الْخَمْرِ ، وَعَنْ ثَمَنِ الْمَيْتَةِ ، وَعَنْ عَسَبِ الْفَحْلِ ، وَعَنْ ثَمَنِ الْكَلْبِ "", عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ ، عَنْ عَاصِمِ بْنِ ضَمْرَةَ , مِثْلَهُ""","","","","","Book of Purification"
"217","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ رَجُلٍ مِنْ بَنِي زُهْرَةَ , رَفَعَهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : نَهَى أَنْ يُرْكَبَ عَلَى جِلْدِ النَّمِرِ ""","","","","","Book of Purification"
"218","عَنِ ابْنِ مُجَاهِدٍ ، عَنْ أَبِيهِ , قَالَ :نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  عَنْ جُلُودِ السِّبَاعِ أَنْ يُرْكَبَ عَلَيْهَا "", عَنِ ابْنِ جُرَيْجٍ ، عَنْ مُجَاهِدٍ , مِثْلَهُ""","","","","","Book of Purification"
"219","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ بَعْضِ أَصْحَابِهِ ، عَنْ عُمَرَ  أَنَّهُنَهَى أَنْ تُفْتَرَشَ جُلُودُ السِّبَاعِ , أَوْ تُلْبَسَ ""","","","","","Book of Purification"
"220","عَنِ الثَّوْرِيِّ ، عَنْ سُوَيْدٍ ، عَنْ أَبِي جَعْفَرٍ ، عَنْ عَلِيِّ بْنِ الْحُسَيْنِ , قَالَ :  كَانَتْ لَهُسَنْجَوِيَّةٌ مِنْ ثَعَالِبَ فَكَانَ يَلْبَسُهَا ، فَإِذَا أَرَادَ أَنْ يُصَلِّيَ وَضَعَهَا "", السَّنْجَوِيَّةُ : الثَّوْبُ يُصْبَغُ لَوْنَ السَّمَاءِ ، ثُمَّ يُوضَعُ عَلَى فَرْوٍ مِنْ ثَعَالِبَ""","","","","","Book of Purification"
"221","عَنِ الثَّوْرِيِّ ، عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ , قَالَ :  رَأَيْتُ عَلَى إِبْرَاهِيمَ النَّخَعِيِّقَلَنْسُوَةً فِيهَا ثَعَالِبُ ""","","","","","Book of Purification"
"222","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامٍ ، عَنِ ابْنِ سِيرِينَ , قَالَ : عَرَضَ رَجُلٌ عَلَى عُمَرَ بْنِ الْخَطَّابِ قَلَنْسُوَةً مِنْ ثَعَالِبَ , فَأَمَرَ بِهَا فَفُتِّقَتْ ""","","","","","Book of Purification"
"223","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : رَأَى عُمَرُ بْنُ الْخَطَّابِعَلَى رَجُلٍ قَلَنْسُوَةً فِيهَا مِنْ جُلُودِ الْهِرَرِ , فَأَخَذَهَا فَخَرَقَهَا ، وَقَالَ :  مَا أَحْسَبُهُ إِلا مَيْتَةً ""","","","","","Book of Purification"
"224","عَنْ مَعْمَرٍ ، عَنِ ابْنِ سِيرِينَ , قَالَ : سَأَلْتُ عُبَيْدَةَ عَنْ جُلُودِ الْهِرَرِ ، فَكَرِهَهُ ، وَإِنْ دُبِغَ ""","","","","","Book of Purification"
"225","عَنِ الْحَسَنِ بْنِ عُمَارَةَ ، عَنِ الْحَكَمِ ، عَنْ إِبْرَاهِيمَ , قَالَ : لا بَأْسَ بِجُلُودِ السِّبَاعِ تُبَاعُ وَيُرْكَبُ عَلَيْهَا , وَتُبْسَطُ ""","","","","","Book of Purification"
"226","عَنِ ابْنِ عُيَيْنَةَ , قَالَ : أَخْبَرَنِي مَنْ رَأَى الشَّعْبِيَّ جَالِسًا عَلَى جِلْدِ أَسَدٍ ""","","","","","Book of Purification"
"227","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ عَنْ جُلُودِ النُّمُورِ , فَرَخَّصَ فِيهَا ، وَقَالَ :  قَدْرَخَّصَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي جُلُودِ الْمَيْتَةِ ""","","","","","Book of Purification"
"228","عَنْ حُمَيْدٍ ، عَنِ الْحَجَّاجِ بْنِ أَرْطَاةَ , قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : لا بَأْسَ بِجُلُودِ السِّبَاعِ إِذَا دُبِغَتْ ، وَيَقُولُ :  قَدْرَخَّصَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي جُلُودِ الْمَيْتَةِ "", قَالَ عَبْدُ الرَّزَّاقِ : وَسَمِعْتُ أَنَا إِبْرَاهِيمَ , وَغَيْرَهُ يَذْكُرُ , عَنْ أَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ""","","","","","Book of Purification"
"229","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ أَبِي الْوَلِيدِ ، عَنِ ابْنِ عَوْنٍ , قَالَ :  كَانَ ابْنُ سِيرِينَيَرْكَبُ بِسَرْجٍ عَلَيْهِ جِلْدُ نَمِرٍ "", قَالَ : "" وَكَانَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ يَرْكَبُ عَلَيْهِ ""","","","","","Book of Purification"
"230","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، أَنَّ أَبَاهُ ، لَمْ يَكُنْ لَهُ سَرْجٌ , إِلا وَعَلَيْهِ جِلْدُ نَمِرٍ ""","","","","","Book of Purification"
"231","عَنْ إِسْمَاعِيلَ أَيْضًا , قَالَ : أَخْبَرَنِي بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْسِرَاجٍ ، سَأَلَ الْحَسَنَ عَنْهَا ، فَقَالَ :  لا بَأْسَ بِهَا رُكِبَ بِهَا فِي زَمَنِ عُمَرَ بْنِ الْخَطَّابِ ""","","","","","Book of Purification"
"232","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً عَنِ الْوُضُوءِ الَّذِي بِبَابِ الْمَسْجِدِ , فَقَالَ : لا بَأْسَ بِهِ كَانَ عَلَى عَهْدِ ابْنِ عَبَّاسٍ وَهُوَ جَعَلَهُ ، وَقَدْ عَلِمَ أَنَّهُ يَتَوَضَّأُ مِنْهُ الرِّجَالُ ، وَالنِّسَاءُ ، الأَسْوَدُ , وَالأَحْمَرُ , وَكَانَ لا يَرَى بِهِ بَأْسًا ، وَلَوْ كَانَ بِهِ بَأْسٌ لَنَهَى عَنْهُ "" , قَالَ : أَكُنْتَ مُتَوَضِّئًا مِنْهُ ؟ قَالَ : "" نَعَمْ ""","","","","","Book of Purification"
"233","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِنِّي رَأَيْتُ إِنْسَانًا مُنْكَشِفًا مَكْشُوفًا عَلَى الْحَوْضِ يَغْرِفُ بِيَدِهِ عَلَى فَرْجِهِ , قَالَ : فَتَوَضَّأْ , فَلَيْسَ عَلَيْكَ ، إِنَّ الدِّينَ سَمْحٌ , قَدْ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : اسْمَحُوا يُسْمَحْ لَكُمْ ، وَقَدْ كَانَ مَنْ مَضَى لا يُفَتِّشُونَ عَنْ هَذَا ، وَلا يَلْحَفُونَ فِيهِ "", يَعْنِي : يَفْحَصُونَ عَنْهُ""","","","","","Book of Purification"
"234","عَنْ عَبْدِ الْعَزِيزِ بْنِ أَبِي رَوَّادٍ ، قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ وَاسِعٍ ، أَنَّ رَجُلا , قَالَ : يَا رَسُولَ اللَّهِ ، جَرٌّ مُخَمَّرٌ جَدِيدٌ أَحَبُّ إِلَيْكَ أَنْ تَتَوَضَّأَ مِنْهُ ، أَوْ مِمَّا يَتَوَضَّأُ النَّاسُ مِنْهُ أَحَبُّ ؟ , قَالَ : أَحَبُّ الأَدْيَانِ إِلَى اللَّهِ الْحَنِيفِيَّةُ "" ، قِيلَ : وَمَا الْحَنِيفِيَّةُ ؟ , قَالَ : "" السَّمْحَةُ "" , قَالَ : "" الإِسْلامُ الْوَاسِعُ ""","","","","","Book of Purification"
"235","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ أَيُّوبَ ، عَنِ الشَّعْبِيِّ , قَالَ : مَطَاهِرُكُمْ أَحَبُّ إِلَيَّ مِنْ جَرٍّ عَجُوزٍ مُخَمَّرٍ ""","","","","","Book of Purification"
"236","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ هَمَامِ بْنِ الْحَارِثِ , قَالَ : رَأَيْتُ جَرِيرَ بْنَ عَبْدِ اللَّهِ : يَتَوَضَّأُ مِنْ مِطْهَرَةٍ ""","","","","","Book of Purification"
"237","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، قَالَ : سَمِعْتُ عَنْ إِبْرَاهِيمَ , قَالَ :  كَانَ أَصْحَابُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَتَوَضَّئُونَ مِنَ الْمِهْرَاسِ ""","","","","","Book of Purification"
"238","عَنِ الثَّوْرِيِّ ، عَنْ مُزَاحِمِ بْنِ زُفَرَ , قَالَ : قُلْتُ لِلشَّعْبِيِّ : أَكُوزٌ عَجُوزٌ مُخَمَّرٌ أَحَبُّ إِلَيْكَ أَنْ يُتَوَضَّأَ مِنْهُ ، أَوْ مِنْ هَذِهِ الْمَطَاهِرِ الَّتِي يُدْخِلُ فِيهَا الْجَزَّارُ يَدَهُ ؟ , قَالَ "" لا ، بَلْ مِنْ هَذِهِ الْمَطَاهِرِ الَّتِي يُدْخِلُ فِيهَا الْجَزَّارُ يَدَهُ "", عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ مُحَمَّدِ بْنِ وَاسِعٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ , إِلا أَنَّهُ لَمْ يَذْكُرِ : الْحَنِيفِيَّةَ السَّمْحَةَ""","","","","","Book of Purification"
"239","عَنِ ابْنِ جُرَيْجٍ , قَالَ : لا بَأْسَ أَنْ يَتَوَضَّأَ الرِّجَالُ وَالنِّسَاءُ مَعًا , إِنَّمَا هُنَّ شَقَائِقُكُمْ , وَأَخَوَاتُكُمْ , وَبَنَاتُكُمْ , وَأُمَّهَاتُكُمْ ""","","","","","Book of Purification"
"240","عَنِ ابْنِ جُرَيْجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ :  كُنَّانَتَوَضَّأُ نَحْنُ وَالنِّسَاءُ مَعًا ""","","","","","Book of Purification"
"241","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ أَبِي سَلامَةَ الْحَبِيبِيِّ ، قَالَ : رَأَيْتُ عُمَرَ بْنَ الْخَطَّابِ أَتَى حِيَاضًا عَلَيْهَا الرِّجَالُ , وَالنِّسَاءُ يَتَوَضَّئُونَ جَمِيعًا فَضَرَبَهُمْ بِالدِّرَّةِ ، ثُمَّ قَالَ لِصَاحِبِ الْحَوْضِ : اجْعَلْ لِلرِّجَالِ حِيَاضًا ، وَلِلنِّسَاءِ حِيَاضًا "" , ثُمَّ لَقِيَ عَلِيًّا , فَقَالَ : "" مَا تَرَى ؟ "" , فَقَالَ : "" أَرَى إِنَّمَا أَنْتَ رَاعٍ ، فَإِنْ كُنْتَ تَضْرِبُهُمْ عَلَى غَيْرِ ذَلِكَ فَقَدْ هَلَكْتَ , وَأَهْلَكْتَ ""","","","","","Book of Purification"
"242","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، وَرَدَ مَاءً , فَقِيلَ لَهُ :  إِنَّالْكِلابَ وَالسِّبَاعَ تَلَغُ فِيهِ , قَالَ : قَدْ ذَهَبَتْ بِمَا وَلَغَتْ فِي بُطُونِهَا "" , فَقِيلَ : إِنَّ الْكَلْبَ وَلَغَ فِي حَوْضِ مَجَنَّةَ , فَقَالَ : "" هَلْ وَلَغَ إِلا بِلِسَانِهِ ؟ فَشَرِبَ مِنْهُ وَاسْتَقَى "", قَالَ : وَمَجَنَّةُ : اسْمُ حَوْضٍ""","","","","","Book of Purification"
"243","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عِكْرِمَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، وَرَدَ حَوْضَ مَجَنَّةَ ، فَقِيلَ لَهُ : يَا أَمِيرَ الْمُؤْمِنِينَ ،إِنَّمَا وَلَغَ فِيهِ الْكَلْبُ آنِفًا , قَالَ :  إِنَّمَا وَلَغَ بِلِسَانِهِ فَاشْرَبُوا مِنْهُ , وَتَوَضَّئُوا ""","","","","","Book of Purification"
"244","عَنْ مَالِكٍ ، وَغَيْرِهِ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ، أَنَّهُ كَانَ مَعَ عُمَرَ بْنِ الْخَطَّابِ فِي رَكْبٍ فِيهِمْ عَمْرُو بْنُ الْعَاصِ ، فَوَقَفُوا عَلَى حَوْضٍ ، فَقَالَ عَمْرٌو :  يَا صَاحِبَ الْحَوْضِأَتَرِدُ حَوْضَكَ السِّبَاعُ ؟ "" , فَقَالَ عُمَرُ : "" يَا صَاحِبَ الْحَوْضِ لا تُخْبِرْنَا , فَإِنَّا نَرِدُ عَلَى السِّبَاعِ وَتَرِدُ عَلَيْنَا "", عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ عَجْلانَ ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ ، مِثْلَهُ""","","","","","Book of Purification"
"245","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ دَاوُدَ بْنِ الْحُصَيْنِ ، عَنْ أَبِيهِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَوَضَّأَ بِمَا أَفْضَلَتِ السِّبَاعُ ""","","","","","Book of Purification"
"246","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَرَدَ , وَمَعَهُ أَبُو بَكْرٍ ، وَعُمَرُ , عَلَى حَوْضٍ فَخَرَجَ أَهْلُ الْمَاءِ , فَقَالُوا : يَا رَسُولَ اللَّهِ  إِنَّالْكِلابَ وَالسِّبَاعَ تَلَغُ فِي هَذَا الْحَوْضِ ، فَقَالَ : لَهَا مَا حَمَلَتْ فِي بُطُونِهَا , وَلَنَا مَا بَقِيَ شَرَابٌ وَطَهُورٌ "", شَكَّ الَّذِي أَخْبَرَنِي أَنَّهُ حَوْضُ الأَبْوَاءِ""","","","","","Book of Purification"
"247","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ أَبِيهِ ، أَنَّهُ الْتَمَسَ لِعُمَرَ وَضُوءًا فَلَمْ يَجِدْهُ إِلا عِنْدَ نَصْرَانِيَّةٍ ، فَاسْتَوْهَبَهَا وَجَاءَ بِهِ إِلَى عُمَرَ فَأَعْجَبَهُ حُسْنُهُ ، فَقَالَ عُمَرُ : مِنْ أَيْنَ هَذَا ؟ "" , فَقَالَ لَهُ : "" مِنْ عِنْدِ هَذِهِ النَّصْرَانِيَّةِ ، فَتَوَضَّأَ ثُمَّ دَخَلَ عَلَيْهَا "" , فَقَالَ لَهَا : "" أَسْلِمِي "" , فَكَشَفَتْ عَنْ رَأْسِهَا , فَإِذَا هُوَ كَأَنَّهُ ثَغَامَةٌ بَيْضَاء ، فَقَالَتْ : "" أَبَعْدَ هَذِهِ السِّنِّ ؟ ""","","","","","Book of Purification"
"248","عَنْ مَعْمَرٍ ، عَنِ ابْنِ أَبِي ذِئْبٍ ، عَنْ رَجُلٍ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  تَوَضَّأَ أَوْ شَرِبَ مِنْ غَدِيرٍ كَانَ يُلْقَى فِيهِ لُحُومُ الْكِلابِ "" , قَالَ : وَلا أَعْلَمُهُ إِلا قَالَ : وَالْجِيَفُ ، فَذَكَرَ ذَلِكَ لَهُ , فَقَالَ لَهُ : "" إِنَّالْمَاءَ لا يُنَجِّسُهُ شَيْءٌ ""","","","","","Book of Purification"
"249","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ ابْنَ عَبَّاسٍ , قَالَ :  إِنَّالْمَاءَ يُطَهِّرُ ، وَلا يُطَهَّرُ ""","","","","","Book of Purification"
"250","عَنْ مَعْمَرٍ , قَالَ : وَأَخْبَرَنِي مَنْ سَمِعَ عِكْرِمَةَ , يَقُولُ :  إِنَّالْمَاءَ لا يُنَجِّسُهُ شَيْءٌ ، وَالْمَاءُ طَهُورٌ ""","","","","","Book of Purification"
"251","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا كَانَ الْمَاءُ قُلَّتَيْنِ لَمْ يَحْمِلْ نَجِسًا , وَلا بَأْسًا ""","","","","","Book of Purification"
"252","قَالَ ابْنُ جُرَيْجٍ : زَعَمُوا أَنَّهَا قِلالُ هَجَرَ ، قَالَ أَبُو بَكْرٍ : الْقُلَّتَيْنِ قَدْرُ الْفَرَقِ ""","","","","","Book of Purification"
"253","عَنْ أَبِيهِ ، عَنْ عِكْرِمَةَ ، أَنَّ ابْنَ عَبَّاسٍ ،مَرَّ بِغَدِيرٍ فِيهِ جِيفَةٌ :  فَأَمَرَ بِهَا فَنُحِّيَتْ ، ثُمَّ تَوَضَّأَ مِنْهُ ""","","","","","Book of Purification"
"254","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنْ عُمَرَ بْنِ سَلْمٍ ، أَنَّهُ سَمِعَ عِكْرِمَةَ , يَقُولُ : إِذَا كَانَ الْمَاءُ ذَنُوبًا ، أَوْ ذَنُوبَيْنِ لَمْ يُنَجِّسْهُ شَيْءٌ "" ، قُلْتُ لَهُ : مَا الذَّنُوبُ ؟ , قَالَ : "" دَلْوٌ ""","","","","","Book of Purification"
"255","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنِ ابْنِ مَسْعُودٍ ، أَنَّهُ قَالَ : إِذَا اخْتَلَطَ الْمَاءُ وَالدَّمُ , فَالْمَاءُ طَهُورٌ ""","","","","","Book of Purification"
"256","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : إِذَا قَطَرَ فِي الْمَاءِ شَيْءٌ مِنْ دَمٍ , فَأَهْرِقْ مِنْهُ كُوزًا أَوْ كُوزَيْنِ ، فَإِنْ كَانَ الْمَاءُ قَلِيلا قَدْرَ مَا يُتَوَضَّأُ مِنْهُ , فَأَهْرِقْهُ ""","","","","","Book of Purification"
"257","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنِ الأَحْوَصِ بْنِ حَكِيمٍ ، عَنْ عَامِرِ بْنِ سَعْدٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا يُنَجِّسُ الْمَاءَ إِلا مَا غَيَّرَ رِيحَهُ ، أَوْ طَعْمَهُ ، أَوْ مَا غَلَبَ عَلَى رِيحِهِ وَطَعْمِهِ ""","","","","","Book of Purification"
"258","عَنِ ابْنِ جُرَيْجٍ , قَالَ : عَنْ رَجُلٍ ، عَنْ عِكْرِمَةَ , قَالَ :  إِنَّالْمَاءَ لا يُنَجِّسُهُ شَيْءٌ أَبَدًا ، يُطَهِّرُ وَلا يُطَهِّرُهُ شَيْءٌ "" ، إِنَّهُ قَالَ : ""  وَأَنْزَلْنَا مِنَ السَّمَاءِ مَاءً طَهُورًا ""","","","","","Book of Purification"
"259","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ أَبِي بَكْرِ بْنِ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي بَكْرِ بْنِ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا كَانَ الْمَاءُ قُلَّتَيْنِ لَمْ يُنَجِّسْهُ شَيْءٌ ""","","","","","Book of Purification"
"260","عَنِ الثَّوْرِيِّ ، عَنْ لَيْثٍ لَمْ يُنَجِّسْهُ شَيْءٌ ""","","","","","Book of Purification"
"261","عَنِ الثَّوْرِيِّ ، عَنْ رَجُلٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : إِذَا كَانَ الْمَاءُ كُرًّا لَمْ يُنَجِّسْهُ شَيْءٌ، الْكُرُّ أَرْبَعُونَ ذَهَبًا ""","","","","","Book of Purification"
"262","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ ، عَنْدَجَاجَةٍ وَقَعَتْ فِي بِئْرٍ فَمَاتَتْ ، فَقَالَ :  لا بَأْسَ أَنْ يُتَوَضَّأَ مِنْهَا ، وَيُشْرَبَ ، إِلا أَنْ تَنْتُنَ حَتَّى يُوجَدَ رِيحُ نَتْنِهَا فِي الْمَاءِ فَتُنْزَحَ ""","","","","","Book of Purification"
"263","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ ، عَنْفَأْرَةٍ وَقَعَتْ فِي الْبِئْرِ , فَقَالَ :  إِنْ أُخْرِجَتْ مَكَانَهَا فَلا بَأْسَ , وَإِنْ مَاتَتْ فِيهَا نُزِحَتْ ""","","","","","Book of Purification"
"264","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ , يَقُولُ : إِذَا مَاتَتِ الدَّابَّةُ فِي الْبِئْرِ أُخِذَ مِنْهَا ، وَإِنْ تَفَسَّخَتْ فِيهَا نُزِحَتْ ""","","","","","Book of Purification"
"265","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ , يَقُولُ : إِذَا مَاتَتِ الدَّابَّةُ فِي الْبِئْرِ أُخِذَ مِنْهَا أَرْبَعُونَ دَلْوًا ""","","","","","Book of Purification"
"266","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِيهِ ، أَنَّ عَلِيًّا , قَالَ : إِذَا سَقَطَتِ الْفَأْرَةُ فِي الْبِئْرِ فَتَقَطَّعَتْ نُزِعَ مِنْهَا سَبْعَةُ أَدْلاءٍ ، فَإِنْ كَانَتِ الْفَأْرَةُ كَهَيْئَتِهَا لَمْ تُقْطَعْ نُزِعَ مِنْهَا دَلْوٌ وَدَلْوَانِ ، فَإِنْ كَانَتْ مُنْتِنَةً أَعْظَمَ مِنْ ذَلِكَ فَلْيُنْزَعْ مِنَ الْبِئْرِ مَا يُذْهِبُ الرِّيحَ ""","","","","","Book of Purification"
"267","عَنْ لَيْثٍ ، عَنْ عَطَاءٍ , قَالَ : إِذَا سَقَطَ الْكَلْبُ فِي الْبِئْرِ فَأُخْرِجَ مِنْهَا حِينَ سَقَطَ نُزِعَ مِنْهَا عِشْرُونَ دَلْوًا ، فَإِنْ أُخْرِجَ حِينَ مَاتَ نُزِعَ مِنْهَا سِتُّونَ أَوْ سَبْعُونَ دَلْوًا ، فَإِنْ تَفَسَّخَ فِيهَا نُزِحَ مَاؤُهَا ، فَإِنْ لَمْ يَسْتَطِيعُوا نُزِحَ مِنْهَا مِائَةُ دَلْوٍ وَعِشْرُونَ وَمِائَةٌ ""","","","","","Book of Purification"
"268","عَنْ مَعْمَرٍ , قَالَ :سَقَطَ رَجُلٌ فِي زَمْزَمَ فَمَاتَ فِيهَا ، فَأَمَرَ ابْنُ عَبَّاسٍ  أَنْ تُسَدَّ عُيُونُهَا وَتُنْزَحُ , قِيلَ لَهُ : إِنَّ فِيهَا عَيْنًا قَدْ غَلَبَتْنَا , "" إِنَّهَا مِنَ الْجَنَّةِ "" , فَأَعْطَاهُمْ مُطْرَفًا مِنْ خَزٍّ فَحَشَوْهُ فِيهَا ، ثُمَّ نُزِحَ مَاؤُهَا حَتَّى لَمْ يَبْقَ فِيهَا نَتْنٌ""","","","","","Book of Purification"
"269","عَنِ الثَّوْرِيِّ ، عَنْ مُجَاهِدٍ ، وَعَطَاءٍ ,  فيفأرة وقعت في بئر , فعجن من مائها , قال : "" يُطَعْمُ الدَّجَاجَ ""","","","","","Book of Purification"
"270","عَنْ رَجُلٍ مِنَ الْبَصْرَةِ ، أَنَّ عَمْرَو بْنَ عُبَيْدٍ ، قَالَ لِلْحَسَنِ :أَضَعُ وَضُوئِي فَتَأْتِي الْفَأْرَةُ وَتَشْرَبُ مِنْهُ ، قَالَ الْحَسَنُ :  أَهْرِقْهُ , فَإِنَّ الْفَاسِقَةَ لا تَشْرَبُ مِنْ شَيْءٍ إِلا بَالَتْ فِيهِ ""، ذَكَرَهُ تَوْبَةُ ، عَنْ شَدِيدِ بْنِ أَبِي الْحَكَمِ""","","","","","Book of Purification"
"271","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : سُئِلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  عَنِالْفَأْرَةِ تَقَعُ فِي السَّمْنِ , قَالَ : إِذَا كَانَ جَامِدًا فَأَلْقُوهُ وَمَا حَوْلَهَا ، وَإِنْ كَانَ مَائِعًا فَلا تَقْرَبُوهُ "", وعَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَيْمُونَةَ ، وَكَذَلِكَ أَخْبَرَنَاهُ ابْنُ عُيَيْنَةَ , عَنْ مَعْمَرٍ ، عَنْ أَبِي هَارُونَ الْعَبْدِيِّ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ نَحْوَ هَذَا , قَالَ أَبُو هَارُونَ : قُلْنَا لأَبِي سَعِيدٍ : يُنْتَفَعُ بِهِ ؟ , قَالَ : "" نَعَمْ ""","","","","","Book of Purification"
"272","عَنْ مَعْمَرٍ ، عَنِ أَبِي هَارُونَ ، عَنْ أَبِي سَعِيدٍ , قَالَ : انْتَفِعُوا بِهِ , وَلا تَأْكُلُوا ""","","","","","Book of Purification"
"273","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ شَرِيكِ بْنِ أَبِي نَمِرٍ ، عَنْ عَطَاءِ بْنِ يَسَارٍ , قَالَ : سُئِلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  عَنِالْفَأْرَةِ تَقَعُ فِي السَّمْنِ , قَالَ : إِنْ كَانَ جَامِدًا أُخِذَ مَا حَوْلَهَا قَدْرَ الْكَفِّ , وَأُكِلَ بَقِيَّتُهُ ""","","","","","Book of Purification"
"274","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ أَبِي جَابِرٍ الْبَيَاضِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : سُئِلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  عَنِالْفَأْرَةِ تَقَعُ فِي السَّمْنِ , قَالَ : إِنْ كَانَ جَامِدًا أُخِذَ مَا حَوْلَهَا قَدْرَ الْكَفِّ ، وَإِذَا وَقَعَتْ فِي الزَّيْتِ اسْتُصْبِحَ ""","","","","","Book of Purification"
"275","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ الْفَأْرَةُ تَقَعُ فِي الْوَدَكِ الْجَامِدِ ، أَوْ غَيْرِ الْجَامِدِ ؟ "" , قَالَ : "" بَلَغَنَا إِنْ كَانَ جَامِدًا أُخِذَ مَا حَوْلَهَا فَأُلْقِيَ , وَأُكِلَ مَا بَقِيَ "" , قُلْتُ : "" فَغَيْرُ الْجَامِدِ ؟ "" , قَالَ : "" لَمْ يَبْلُغْنِي فِيهِ شَيْءٌ ، وَلَكِنْ أَرَى أَنْ يُسْتَثْقَبَ بِهِ , وَلا يُؤْكَلُ ""","","","","","Book of Purification"
"276","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : إِذَا مَاتَتِ الْفَأْرَةُ فِي الْوَدَكِ الْجَامِدِ "" , قَالَ : "" بَلَغَنَا إِنْ كَانَ جَامِدًا أُخِذَ مَا حَوْلَهُ فَأُلْقِيَ , وَأُكِلَ مَا بَقِيَ ""","","","","","Book of Purification"
"277","عَنْ مَعْمَرٍ ، وَالثَّوْرِيُّ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ  أَيُّفَأْرَةٍ وَقَعَتْ فِي زَيْتٍ عِشْرُونَ قَرْطَلا ، فَقَالَ ابْنُ عُمَرَ : اسْتَسْرِجُوا بِهِ , وَادَّهِنُوا بِهِ الأُدْمَ ""","","","","","Book of Purification"
"278","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَمْرِو بْنِ دِينَارٍ : مَاتَتْ فَأْرَةٌ فِي دُهْنِ إِنْسَانٍ يَدَّهِنُ بِهِ , قَالَ : مَا أُحِبُّهُ ""","","","","","Book of Purification"
"279","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً  عَنْفَأْرَةٍ مَاتَتْ فِي عَسَلٍ , قَالَ : الْعَسَلُ كَهَيْئَةِ الْجَامِدِ يُغْرَفُ مَا حَوْلَهَا , وَيُؤْكَلُ مَا بَقِيَ ""","","","","","Book of Purification"
"280","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، قُلْتُ لَهُ : الْفَأْرَةُ تَمُوتُ فِي السَّمْنِ الذَّائِبِ , أَوِ الدُّهْنِ فَيُوجَدُ قَدْ تَسَلَّخَتْ , أَوْ يُوجَدُ قَدْ مَاتَتْ وَهِيَ شَدِيدَةٌ لَمْ تُسْلَخْ , قَالَ : سَوَاءٌ مَاتَتْ فِيهِ الدُّهْنُ يُنَشُّ وَيُدَّهَنُ بِهِ إِنْ لَمْ تُقَذِّرْ "" ، قُلْتُ : فَالسَّمْنُ يُنَشُّ فَيُسَخَّنُ ثُمَّ يُؤْكَلُ , قَالَ : "" لَيْسَ مَا يُؤْكَلُ كَهَيْئَةِ شَيْءٍ فِي الرَّأْسِ يُدَّهَنُ بِهِ ""","","","","","Book of Purification"
"281","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :فَأْرَةٌ وَقَعَتْ فِي جَرٍّ فَمَاتَتْ فِيهِ ، فَقَالَ  لا يُتَوَضَّأُ مِنْهُ , فَإِنْ تَوَضَّأْتَ وَلَمْ تَعْلَمْ ، ثُمَّ صَلَّيْتَ وَلَمْ تَعْلَمْ فَعُدْ مَا كُنْتَ فِي وَقْتٍ "" , قَالَ : "" فَإِنْ فَاتَكَ الْوَقْتُ فَعُدْ أَيْضًا "" ، قُلْتُ : فَثَوْبِي مَسَّهُ مِنْ مَاءِ تِلْكَ الْجَرَّةِ شَيْءٌ أَغْسِلُهُ , أَوْ أَرُشُّهُ ؟ , قَالَ : "" لا ""","","","","","Book of Purification"
"282","عَنِ الثَّوْرِيِّ , قَالَ إِذَا اضْطُرِرْتَ إِلَى مَاءٍ وَقَعَ فِيهِ فَأْرَةٌ , فَتَوَضَّأْ , وَتَيَمَّمْ تَجْمَعْهُمَا ""","","","","","Book of Purification"
"283","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْوَزَغُ يَمُوتُ فِي الْوَدَكِ السَّمْنِ وَالدُّهْنِ ، وَأَشْبَاهِ هَذَا بِمَنْزِلَةِ الْفَأْرَةِ هُوَ فِي ذَلِكَ , قَالَ : وَأُحِبُّ ""","","","","","Book of Purification"
"284","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، أَنَّوَزَغًا وَقَعَ فِي سَمْنٍ لآلِ أَبِي مُوسَى الأَشْعَرِيِّ فَلَتُّوا بِهِ سَوِيقًا ، ثُمَّ أَخْبَرُوهُ , فَقَالَ :  بِيعُوهُ مِمَّنْ يَسْتَحِلُّهُ ، ثُمَّ أَعْلِمُوهُ ""","","","","","Book of Purification"
"285","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ عَنْ عِمْرَانَ بْنِ حُصَيْنٍ ، أَنَّوَزَغًا مَاتَ لَهُمْ ، فَلَتُّوا بِهِ سَوِيقًا فَشَرِبَ مِنْهُنَّ ، ثُمَّ أُخْبِرَ بِالَّذِي كَانَ مِنْ أَمْرِهِ ، فَقَالَ :  هَلْ عَلِمْتُمْ ؟ "" , قَالُوا : لا , فَصَفَّقَ بِيَدَيْهِ ، وَقَالَ : "" بِيعُوا السَّمْنَ وَالسَّوِيقَ مِنْ غَيْرِ أَهْلِ دِينِكُمْ ، وَبَيِّنُوا لَهُمُ الَّذِي كَانَ مِنْ أَمْرِهِ "" , قَالَ بَعْضُ أَهْلِهِ : أَلا نَسْتَسْرِجُ بِهِ ؟ , قَالَ : "" بَلَى إِنْ شِئْتُمْ ""","","","","","Book of Purification"
"286","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الْجُعَلُ يَمُوتُ فِي الْعَسَلِ ، أَوِ السَّمْنِ ، أَوِ الْوَدَكِ ، أَوِ الْمَاءِ , قَالَ :  إِنَّمَا هُوَ فُوفَةٌ لَيْسَ لَهُ لَحْمٌ وَلا دَمٌ ، إِنْ وَقَعَ فِي جَامِدٍ , أَوْ غَيْرِ جَامِدٍ فَمَاتَ , فَلا يُلْقَى مِنْهُ شَيْءٌ ، وَلا تُهْرِقْهُ وَكُلْهُ "" , قَالَ : قُلْتُ لَهُ : مَا الْجُعَلُ ؟ , قَالَ : "" الدَّابَّةُ السُّودُ الَّذِي يُدَهْدِهُ الْخُرْءَ""","","","","","Book of Purification"
"287","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ فِيالْجُعَلِ , وَالزُّنْبُورِ , وَأَشْبَاهِهِ إِذَا سَقَطَ فِي الْمَاءِ ، أَوْ وَقَعَ فِي الطَّعَامِ وَالشَّرَابِ , قَالَ :  يُؤْكَلُ , وَيُشْرَبُ , وَيُتَوَضَّأُ مِنْهُ ، وَمَا يَكُونُ فِي الْمَاءِ مِمَّا لَيْسَ فِيهِ عَظْمٌ , فَلا بَأْسَ بِهِ ""","","","","","Book of Purification"
"288","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ مَنْبُوذٍ ، عَنْ أُمِّهِ ، أَنَّهَا كَانَتْ تُسَافِرُ مَعَ مَيْمُونَةَ زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : فَكُنَّا نَأْتِي الْغَدِيرَ فِيهِ الْجُعْلانُ أَمْوَاتًا فَنَأْخُذُ مِنْهُ الْمَاءَ "", يَعْنِي : فَيَشْرَبُونَهُ""","","","","","Book of Purification"
"289","عَنِ الثَّوْرِيِّ ، عَنْ أَبِيهِ ، عَنْ إِبْرَاهِيمَ ، أَنَّهُ سُئِلَ عَنِالذُّبَابِ يَقَعُ فِي الْمَاءِ فَيَمُوتُ فِيهِ , قَالَ :  لا بَأْسَ بِهِ ""","","","","","Book of Purification"
"290","عَنْ مَعْمَرٍ ، عَنْ هَمَامِ بْنِ مُنَبِّهٍ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَبُولَنَّ أَحَدُكُمْ فِي الْمَاءِ الدَّائِمِ الَّذِي لا يَجْرِي ، ثُمَّ يَتَوَضَّأُ مِنْهُ ""","","","","","Book of Purification"
"291","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لا يَبُولَنَّ أَحَدُكُمْ فِي الْمَاءِ الدَّائِمِ ، ثُمَّ يَتَوَضَّأُ مِنْهُ ""","","","","","Book of Purification"
"292","عَنِ ابْنِ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : نَهَى أَنْ يَبُولَ الرَّجُلُ فِي الْمَاءِ الْمُنْقَعِ ""","","","","","Book of Purification"
"293","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ ذَكْوَانَ ، عَنْ مُوسَى بْنِ أَبِي عُثْمَانَ ، عَنْ أَبِيهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : نَهَى أَنْ يُبَالَ فِي الْمَاءِ الدَّائِمِ الَّذِي لا يَجْرِي , ثُمَّ يُغْتَسَلُ فِيهِ ""","","","","","Book of Purification"
"294","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، عَنْ سُلَيْمَانَ بْنِ مُوسَى ، عَنْ رَجُلٍ , قَالَ : سَأَلْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ  عَنِالْمَاءِ النَّاقِعِ ، أَغْتَسِلُ فِيهِ وَقَدْ دَخَلَهُ الْجُنُبُ ؟ قَالَ : لا , وَلَكِنِ اغْتَرِفْ مِنْهُ غَرْفًا ""","","","","","Book of Purification"
"295","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ مِنْ أَهْلِ الْكُوفَةِ ، أَنَّ ابْنَ عَبَّاسٍ , قَالَ : إِنْ أَصَابَتْكَ جَنَابَةٌ وَمَرَرْتَ بِغَدِيرٍ , فَاغْتَرِفْ مِنْهُ اغْتِرَافًا فَاصْبُبْهُ عَلَيْكَ ، وَإِنْ سَالَ فِيهِ , فَلا تُبَالِ , وَلا تَدْخُلْ فِيهِ إِنِ اسْتَطَعْتَ ""","","","","","Book of Purification"
"296","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ  فِيالرَّجُلِ تُصِيبُهُ الْجَنَابَةُ فَيَمُرُّ بِالْبِئْرِ وَلَيْسَ مَعَهُ دَلْوٌ , قَالَ : إِنْ لَمْ يَجِدْ إِلا أَنْ يُدْخِلَ يَدَهُ فِيهَا فَلْيُدْخِلْ "", قَالَ مَعْمَرٌ : وَسَمِعْتُ مَنْ يَقُولُ : "" يَبُلُّ طَرَفَ ثَوْبِهِ ، ثُمَّ يَعْصِرُهُ عَلَى يَدَيْهِ , فَيَغْسِلُ يَدَيْهِ "" , قَالَ مَعْمَرٌ : "" وَلَوْ تَيَمَّمَ ثُمَّ أَدْخَلَ يَدَهُ , كَانَ أَحَبَّ إِلَيَّ""","","","","","Book of Purification"
"297","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ  فِيرَجُلٍ نَسِيَ فَأَدْخَلَ يَدَهُ فِي الْمَاءِ الَّذِي يَغْتَسِلُ فِيهِ وَهُوَ جُنُبٌ قَبْلَ أَنْ يَغْسِلَهُمَا , قَالَ : بِئْسَ مَا صَنَعَ , وَيَغْتَسِلُ بِهِ ""","","","","","Book of Purification"
"298","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ , يَقُولُ : يُلْقِي ، وَلا يَتَوَضَّأُ ، وَلا يَغْتَسِلُ ""","","","","","Book of Purification"
"299","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً ، عَنِالْجُنُبِ ، يَنْسَى فَيُدْخِلُ يَدَهُ فِي الإِنَاءِ الَّذِي فِيهِ غُسْلُهُ قَبْلَ أَنْ يَغْسِلَهُمَا , قَالَ :  إِذَا نَسِيَ فَلا بَأْسَ فَلْيَغْسِلْ يَدَيْهِ ""","","","","","Book of Purification"
"300","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : لَيْسَ عَلَى الثَّوْبِ جَنَابَةٌ , وَلا عَلَى الأَرْضِ جَنَابَةٌ ، وَلا عَلَى الرَّجُلِ يَمَسُّهُ الْجُنُبُ جَنَابَةٌ ، وَلَيْسَ عَلَى الْمَاءِ جَنَابَةٌ "" , يَقُولُ : "" إِذَا سَبَقَتْهُ يَدَاهُ فَأَدْخَلَهُمَا فِي الْمَاءِ وَهُوَ جُنُبٌ قَبْلَ أَنْ يَغْسِلَهُمَا , فَلا بَأْسَ ""","","","","","Book of Purification"
"301","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ :  كَانَ أَصْحَابُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيُدْخِلُونَ أَيْدِيَهُمُ الْمَاءَ ، وَهُمْ جُنُبٌ , وَالنِّسَاءُ وَهُنَّ حُيَّضٌ , وَلا يُفْسِدُ ذَلِكَ عَلَيْهِمْ ""","","","","","Book of Purification"
"302","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ  عَنْرَجُلٍ يَغْتَسِلُ مِنَ الْجَنَابَةِ فَيَنْتَضِحُ فِي الإِنَاءِ مِنْ جِلْدِهِ , فَقَالَ : "" لا بَأْسَ بِهِ ""","","","","","Book of Purification"
"303","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ  أَرَأَيْتَمَا يَنْتَضِحُ مِنَ الإِنَاءِ فِي الطَّسْتِ ؟ قَالَ : "" لا يَضُرُّكَ ""","","","","","Book of Purification"
"304","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :أَضَعُ قَدَحِيَ الَّذِي فِيهِ وَضُوئِي فِي الطَّسْتِ الَّتِي أَتَوَضَّأُ فِيهِ , وَلَعَلَّهُ أَنْ تَكُونَ كَبِيرَةً , قَالَ :  لا "" , قُلْتُ : فَإِنِّي أَعْلَمُ أَنِّي يُنْتَضَحُ عَلَيَّ مِنَ الطَّسْتِ ، وَلَيْسَ فِيهِ الْقَدَحُ , وَيُنْتَضَحُ فِي وَضُوئِي مِنَ الطَّسْتِ , وَلَيْسَ فِيهَا الْقَدَحُ , قَالَ : "" لا يَضُرُّكَ شَيْءٌ مِنْ ذَلِكَ هُوَ عُذْرٌ لَكَ أَنْ يَكُونَ ذَلِكَ , وَقَدْ عَزَلْتَ فَدَخَلَ مِنَ الطَّسْتِ ""","","","","","Book of Purification"
"305","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لنَافِعٍ ،أَيْنَ كَانَ ابْنُ عُمَرَ يَجْعَلُ إِنَاءَهُ الَّذِي يَتَوَضَّأُ فِيهِ ؟  , قَالَ : "" إِلَى جَنْبِهِ ""","","","","","Book of Purification"
"306","عَنِ الثَّوْرِيِّ ، عَنِ الْعَلاءِ بْنِ الْمُسَيَّبِ ، عَنْ رَجُلٍ ، عَنْ إِبْرَاهِيمَ ، عَنِ ابْنِ عَبَّاسٍ  أَنَّهُ سُئِلَ عَنْرَجُلٍ يَغْتَسِلُ , أَوْ يَتَوَضَّأُ مِنَ الْمَاءِ وَيَنْتَضِحُ فِيهِ "" ، قَالَ : "" فَلَمْ يَرَ بِهِ بَأْسًا ""","","","","","Book of Purification"
"307","عَنْ مَعْمَرٍ ، عَمَّنْ ، سَمِعَ أَنَسَ بْنَ مَالِكٍ ، وَالْحَسَنَ ، يَسْأَلانِ عَنِالرَّجُلِ  يَغْتَسِلُ مِنَ الْجَنَابَةِ , فَيَنْتَضِحُ مِنْ غُسْلِهِ فِي الْمَاءِ الَّذِي يَغْتَسِلُ مِنْهُ , قَالَ : "" لا بَأْسَ بِهِ ""","","","","","Book of Purification"
"308","عَنْ مَعْمَرٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ , قَالَ : كَانَ مَيْمُونُ بْنُ مِهْرَانَ يَغْتَسِلُ مِنْ إِنَاءٍ فَيَرْفَعُهُ ، لأَنْ لا يَنْتَضِحَ مِنْ غُسْلِهِ ""","","","","","Book of Purification"
"309","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ الْعَاصِ , قَالَ : مَاءَانِ لا يُنَقِّيَانِ مِنَ الْجَنَابَةِ : مَاءُ الْبَحْرِ ، وَمَاءُ الْحَمَّامِ ""","","","","","Book of Purification"
"310","قَالَ مَعْمَرٌ : سَأَلْتُ يَحْيَى عَنْهُ بَعْدَ حِينٍ , فَقَالَ : قَدْ بَلَغَنِي مَا هُوَ أَوْثَقُ مِنْ ذَلِكَ ، إِنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سُئِلَ عَنْ مَاءِ الْبَحْرِ , فَقَالَ : مَاءُ الْبَحْرِ طَهُورٌ ، وَحِلٌّ مَيْتَتُهُ ""","","","","","Book of Purification"
"311","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي سُلَيْمَانُ بْنُ مُوسَى , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الْبَحْرُ طَهُورٌ , مَاؤُهُ وَحَلالٌ مَيْتَتُهُ "", عَنِ الثَّوْرِيِّ ، عَنْ أَبَانَ ، عَنْ أَنَسٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ""","","","","","Book of Purification"
"312","عَنِ الثَّوْرِيِّ ، وَابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ الْمُغِيرَةِ بْنِ عَبْدِ اللَّهِ ، أَنَّ نَاسًا مِنْ بَنِي مُدْلِجٍ سَأَلُوا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، إِنَّا نَرْكَبُ أَرْمَاثًا لَنَا ، وَيَحْمِلُ أَحَدُنَا مُوَيْهًا لِشِفَّتِهِ ،فَإِنْ تَوَضَّأْنَا بِمَاءِ الْبَحْرِ وَجَدْنَا فِي أَنْفُسِنَا ، وَإِنْ تَوَضَّأْنَا مِنْهُ عَطِشْنَا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  هُوَ الطَّهُورُ , مَاؤُهُ الْحَلالُ مَيْتَتُهُ ""","","","","","Book of Purification"
"313","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ أَبِي يَزِيدَ الْمَدَنِيِّ ، قَالَ : حَدَّثَنِي رَجُلٌ مِنَ الصَّيَّادِينَ الَّذِي يَكُونُونَ فِي الْجَارِ ، وَكَانَ أَهْلُ الْمَدِينَةِ يُرْزَقُونَ مِنَ الْجَارِ ، فَوَجَدَ حَبًّا مَنْثُورًا , فَجَعَلَ عُمَرُ يَلْتَقِطُهُ حَتَّى جَمَعَ مِنْهُ مُدًّا ، أَوْ قَرِيبًا مِنْ مُدٍّ ، ثُمَّ قَالَ :  أَلا أَرَاكَ تَصْنَعُ مِثْلَ هَذَا ، وَهَذَا قُوتُ رَجُلٍ مُسْلِمٍ حَتَّى اللَّيْلِ "" , قَالَ : فقُلْتُ لَهُ : يَا أَمِيرَ الْمُؤْمِنِينَ ، لَوْ رَكِبْتَ لِتَنْظُرَ كَيْفَ نَصْطَادُ ؟ قَالَ : فَرَكِبَ مَعَهُمْ فَجَعَلُوا يَصْطَادُونَ ، فَقَالَ عُمَرُ : "" تَاللَّهِ إِنْ رَأَيْتُ كَالْيَوْمِ كَسْبًا أَطْيَبَ , أَوْ قَالَ : أَحَلَّ "" ، ثُمَّ قَالَ : فَصَنَعْنَا لَهُ طَعَامَا ، فَقُلْتُ : يَا أَمِيرَ الْمُؤْمِنِينَ ! إِنْ شِئْتَ سَقَيْنَاكَ طَعَامَا ، وَإِنْ شِئْتَ مَاءً , فَإِنَّ اللَّبَنَ أَيْسَرُ عِنْدَنَا مِنَ الْمَاءِ , إِنَّا نَسْتَعْذِبُ مِنْ مَكَانَ كَذَا , قَالَ : فَطَعِمَ ، ثُمَّ دَعَا بِالَّذِي أَرَادَ ، ثُمَّ قُلْنَا : يَا أَمِيرَ الْمُؤْمِنِينَ ! إِنَّا نَخْرُجُ إِلَى هَهُنَا فَنَتَزَوَّدُ مِنَ الْمَاءِ لِشَفَتِنَا ، ثُمَّ نَتَوَضَّأُ مِنْ مَاءِ الْبَحْرِ , فَقَالَ : "" سُبْحَانَ اللَّهِ !وَأَيُّ مَاءٍ أَطْهَرُ مِنْ مَاءِ الْبَحْرِ ؟ ""","","","","","Book of Purification"
"314","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ عِكْرِمَةَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، سُئِلَ عَنْ مَاءِ الْبَحْرِ , فَقَالَ : أَيُّ مَاءٍ أَطْهَرُ مِنْ مَاءِ الْبَحْرِ ؟ ""","","","","","Book of Purification"
"315","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، قَالَ ابْنُ عَبَّاسٍ : هُمَا بَحْرَانِ :  هَذَا عَذْبٌ فُرَاتٌ وَهَذَا مِلْحٌ أُجَاجٌ ""","","","","","Book of Purification"
"316","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ سُلَيْمَانُ بْنُ مُوسَى عَطَاءً , وَأَنَا أَسْمَعُ ، فَقَالَ : أَطَهُورٌ مَاءُ الْبَحْرِ ؟ "" , فَقَالَ : "" نَعَمْ ""","","","","","Book of Purification"
"317","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَإِنْ وَجَدْتُ مَاءً غَيْرَ مَاءِ الْبَحْرِ , وَالإِيضَا , وَرَأَيْتُ بِئْرًا أَدَعُ الْبِئْرَ وَالإِيضَا ؟ قَالَ :  إِنْ تَطَهَّرْتَ مِنْهُمَا فَهُمَا طَهُورٌ , قُلْتُ لَهُ : مَا الإِيضَا ؟ , قَالَ : الْمِطْهَرَةُ ""","","","","","Book of Purification"
"318","عَنِ الثَّوْرِيِّ ، عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ ، عَنْمَاءِ الْبَحْرِ أَغْتَسِلُ بِهِ ؟ قَالَ :  نَعَمْ ، وَالْمَاءُ الْعَذْبُ أَحَبُّ إِلَيَّ ""","","","","","Book of Purification"
"319","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، قَالا : أَخْبَرَنَا ابْنُ طَاوُسٍ ، عَنْ أَبِيهِ ، أَنَّ رَجُلا قَالَ لَهُ : مَرَرْتُ بِالْبَحْرِ وَأَنَا جُنُبٌ , فَاغْتَسَلْتُ مِنْهُ "" , قَالَ : حَسْبُكَ ""","","","","","Book of Purification"
"320","عَنْ مَعْمَرٍ ، عَنْ هَمَامِ بْنِ مُنَبِّهٍ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : طُهُورُ إِنَاءِ أَحَدِكُمْ إِذَا وَلَغَ فِيهِ الْكَلْبُ , أَنْ يَغْسِلَهُ سَبْعَ مَرَّاتٍ ""","","","","","Book of Purification"
"321","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا وَلَغَ الْكَلْبُ فِي الإِنَاءِ , فَاغْسِلُوهُ سَبْعَ مَرَّاتٍ , أُولاهُنَّ بِالتُّرَابِ "", عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ بْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ""","","","","","Book of Purification"
"322","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ , قَالَ : فِيالْكَلْبِ يَلَغُ فِي الإِنَاءِ , قَالَ :  لا تَجْعَلْ فِيهِ شَيْئًا , حَتَّى تَغْسِلَهُ سَبْعَ مَرَّاتٍ ""","","","","","Book of Purification"
"323","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :كَمْ يُغْسَلُ الإِنَاءُ الَّذِي يَلَغُ فِيهِ الْكَلْبُ ؟ , قَالَ :  كُلُّ ذَلِكَ سَمِعْتُ سَبْعًا , وَخَمْسًا , وَثَلاثَ مَرَّاتٍ ""","","","","","Book of Purification"
"324","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَمْرُو بْنُ دِينَارٍ : يُغْسَلُ الإِنَاءُ إِذَا وَلَغَ فِيهِ الْكَلْبُ سَبْعَ مَرَّاتٍ ""","","","","","Book of Purification"
"325","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي زِيَادٌ ، أَنَّ ثَابِتَ بْنَ عِيَاضٍ مَوْلَى عَبْدِ الرَّحْمَنِ بْنِ زَيْدٍ حَدَّثَهُ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا وَلَغَ الْكَلْبُ فِي إِنَاءِ أَحَدِكُمْ فَلْيَغْسِلْهُ سَبْعَ مَرَّاتٍ "", قَالَ زِيَادٌ : وَأَخْبَرَنِي هِلالُ بْنُ أُسَامَةَ , أَنَّهُ سَمِعَ أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي هُرَيْرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ""","","","","","Book of Purification"
"326","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ ، عَنِالْكَلْبِ يَلَغُ فِي الإِنَاءِ , قَالَ :  يُغْسَلُ ثَلاثَ مَرَّاتٍ, قَالَ : لَمْ أَسْمَعْ فِي الْهِرِّ شَيْئًا ""","","","","","Book of Purification"
"327","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :وَلَغَ الْكَلْبُ فِي جَفْنَةِ قَوْمٍ فِيهَا لَبَنٌ , فَأَدْرَكُوهُ عِنْدَ ذَلِكَ , فَغَرَفُوا حَوْلَ مَا وَلَغَ فِيهِ , قَالَ :  لا تَشْرَبُوهُ ""","","","","","Book of Purification"
"328","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ  أَنَّهُ كَانَيَكْرَهُ سُؤْرَ الْكَلْبِ "", عَنِ الثَّوْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، بِمِثْلِهِ""","","","","","Book of Purification"
"329","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ  أَنَّهُ كَانَيَكْرَهُ سُؤْرَ السِّنَّوْرِ "", عَنِ الثَّوْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , مِثْلَهُ""","","","","","Book of Purification"
"330","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الْهِرُّ ؟ قَالَ :  هُوَ بِمَنْزِلَةِ الْكَلْبِ ، أَوْ شَرٌّ مِنْهُ ""","","","","","Book of Purification"
"331","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ أَبِيهِ ، فِيالْهِرِّ يَلَغُ فِي الإِنَاءِ , قَالَ :  بِمَنْزِلَةِ الْكَلْبِ يُغْسَلُ سَبْعَ مَرَّاتٍ ""","","","","","Book of Purification"
"332","أَخْبَرَنَا مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ فِيالْهِرِّ يَلَغُ فِي الإِنَاءِ , قَالَ :  اغْسِلْهُ مَرَّةً وَأَهْرِقْهُ ""","","","","","Book of Purification"
"333","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : سَأَلْتُ ابْنَ الْمُسَيِّبِ ، عَنِالْهِرِّ يَلَغُ فِي الإِنَاءِ , قَالَ :  يُغْسَلُ مَرَّةً أَوْ مَرَّتَيْنِ ""، وَكَانَ الْحَسَنُ , يَقُولُ : "" مَرَّةً أَوْ ثَلاثًا ""","","","","","Book of Purification"
"334","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عِكْرِمَةَ ، أَنَّهُ رَأَى أَبَا قَتَادَةَ الأَنْصَارِيَّ يَضَعُ الإِنَاءَ لِلْهِرِّ فَتَشْرَبُ مِنْهُ ، ثُمَّ يَتَوَضَّأُ بِفَضْلِهَا "", عَنِ الثَّوْرِيِّ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ عِكْرِمَةَ , مِثْلَهُ""","","","","","Book of Purification"
"335","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، عَنْ أَيُّوبَ السِّخْتِيَانِيِّ ، أَنَّهُ سَمِعَ عِكْرِمَةَ ، مَوْلَى ابْنِ عَبَّاسٍ , يَقُولُ : قَرَّبَ أَبُو قَتَادَةَإِنَاءً إِلَى الْهِرِّ فَوَلَغَ فِيهِ ، ثُمَّ تَوَضَّأَ مِنْ فَضْلِهِ ، وَقَالَ :  إِنَّهَا مِنْ مَتَاعِ الْبَيْتِ "", مَعْمَرٌ ، عَنْ أَيُّوبَ ، عَنْ عِكْرِمَةَ , مِثْلَهُ""","","","","","Book of Purification"
"336","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , قَالَ : أَخْبَرَنِي صَالِحٌ مَوْلَى التَّوْأَمَةِ , قَالَ : سَمِعْتُ أَبَا قَتَادَةَ , يَقُولُ : لا بَأْسَ بِالْوُضُوءِ مِنْ فَضْلِ الْهِرَّةِ إِنَّمَا هُوَ مِنْ عِيَالِي "", عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ ، عَنِ امْرَأَةٍ ، عَنْ أُمِّهَا ، وَكَانَتْ عِنْدَ أَبِي قَتَادَةَ , مِثْلَ حَدِيثِ مَالِكٍ""","","","","","Book of Purification"
"337","عَنِ ابْنِ جُرَيْجٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ ، عَنِ امْرَأَةٍ ، عَنْ أُمِّهَا ، وَكَانَتْ تَحْتَ أَبِي قَتَادَةَ , أَنَّ أُمَّهَا أَخْبَرَتْهَا ، أَنَّ أَبَا قَتَادَةَ زَارَهُمْ , فَسَكَبُوا لَهُ وَضُوءًا فَدَنَتْ مِنْهُ هِرَّةٌ , فَأَصْغَى إِلَيْهَا الإِنَاءَ الَّذِي فِيهِ وَضُوءُهُ فَشَرِبَتْ مِنْهُ ، ثُمَّ تَوَضَّأَ بِفَضْلِهَا فَعَجِبُوا مِنْ ذَلِكَ ، قَالَ أَبُو قَتَادَةَ : إِنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :  إِنَّهَالَيْسَتْ بِنَجَسٍ ، إِنَّهَا مِنَ الطَّوَّافِينَ عَلَيْكُمْ ""","","","","","Book of Purification"
"338","عَنْ مَالِكِ بْنِ أَنَسٍ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ ، عَنْ حُمَيْدَةَ بِنْتِ عُبَيْدِ بْنِ رِفَاعَةَ ، عَنْ كَبْشَةَ بِنْتِ كَعْبِ بْنِ مَالِكٍ ، وَكَانَتْ عِنْدَ ابْنِ أَبِي قَتَادَةَ ، أَنَّ أَبَا قَتَادَةَ دَخَلَ عَلَيْهَا فَسَكَبَتْ لَهُ وَضُوءًا , فَجَاءَتْ هِرَّةٌ فَشَرِبَتْ ، فَأَصْغَى لَهَا الإِنَاءَ حَتَّى تَشْرَبَ , قَالَتْ كَبْشَةُ : فَرَآنِي أَنْظُرُ إِلَيْهِ , فَقَالَ : أَتَعْجَبِينَ يَا بِنْتَ أَخِي ؟ قَالَتْ : نَعَمْ , قَالَ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ :  إِنَّهَالَيْسَتْ بِنَجَسٍ , إِنَّمَا هِيَ مِنَ الطَّوَّافِينَ , وَالطَّوَّافَاتِ ""","","","","","Book of Purification"
"339","عَنْ مَعْمَرٍ ، عَنْ أَبِي إِسْحَاقَ , قَالَ :وَلَغَ هِرٌ فِي لَبَنٍ لآلِ أَبِي قَيْسٍ  فَأَرَادَ أَهْلُهُ أَنْ يُهْرِقُوا اللَّبَنَ , فَنَهَاهُمْ عَنْ ذَلِكَ , وَأَمَرَهُمْ أَنْ يَشْرَبُوهُ ""","","","","","Book of Purification"
"340","عَنِ ابْنِ جُرَيْجٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ مَوْلًى لِلأَنْصَارِ ، أَنَّ جَدَّتَهُ أَخْبَرَتْهُ ، أَنَّ مَوْلاتَهَا أَرْسَلَتْهَا بِجَشِيشٍ , أَوْ رُزٍّ إِلَى عَائِشَةَ تُهْدِيهِ , فَجَاءَتْ بِهِ وَعَائِشَةُ تُصَلِّي , فَوَضَعَتْهُ فَدَنَتْ مِنْهُ هِرَّةٌ فَأَكَلَتْ مِنْهُ ، وَعِنْدَ عَائِشَةَ نِسَاءٌ , فَلَمَّا انْصَرَفَتْ دَعَتْ بِهِ , فَلَمَّا رَأَتِ النِّسْوَةَ يَتَوَقَّيْنَ الْمَكَانَ الَّذِي أَكَلَتْ مِنْهُ الْهِرَّةُ ،وَضَعَتْ عَائِشَةُ رَضِيَ اللَّهُ عَنْهَا يَدَهَا فِي الْمَكَانَ الَّذِي أَكَلَتْ فِيهِ الْهِرَّةُ , وَقَالَتْ :  أَنَّهَا لَيْسَتْ بِنَجَسٍ ""","","","","","Book of Purification"
"341","عَنِ الثَّوْرِيِّ ، عَنْ حَارِثَةَ بْنِ أَبِي الرِّجَالِ ، عَنْ عَمْرَةَ ، عَنْ عَائِشَةَ , قَالَتْ : كُنْتُ أَتَوَضَّأُ أَنَا وَرَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ إِنَاءٍ قَدْ أَصَابَ مِنْهُ الْهِرُّ قَبْلَ ذَلِكَ ""","","","","","Book of Purification"
"342","عَنِ الثَّوْرِيِّ ، عَنِ الرُّكَيْنِ بْنِ الرَّبِيعِ بْنِ عُمَيْلَةَ الْفَزَارِيِّ ، عَنْ عَمَّةٍ لَهُ , يُقَالُ لَهَا : صَفِيَّةُ بِنْتُ عَمِيلَةَ ، عَنْ حُسَيْنِ بْنِ عَلِيٍّ ، أَنَّ امْرَأَةً سَأَلَتْ عَنِالسِّنَّوْرِ يَلَغُ فِي شَرَابِي ، فَقَالَ :  الْهِرُّ ؟ "" , فَقَالَتْ : نَعَمْ , قَالَ : "" فَلا تُهْرِقِي شَرَابَكِ , وَلا طَهُورَكِ , فَإِنَّهُ لا يُنَجِّسُ شَيْئًا ""","","","","","Book of Purification"
"343","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، وَأَيُّوبَ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : الْهِرُّ مِنْ مَتَاعِ الْبَيْتِ ""","","","","","Book of Purification"
"344","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عِكْرِمَةَ , قَالَ : سُئِلَ ابْنُ عَبَّاسٍ ، عَنْوُلُوغِ الْهِرِّ فِي الإِنَاءِ أَيُغْسَلُ ؟ قَالَ :  إِنَّمَا هُوَ مِنْ مَتَاعِ الْبَيْتِ ""","","","","","Book of Purification"
"345","عَنِ الثَّوْرِيِّ ، عَنِ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ ، عَنْ إِبْرَاهِيمَ , قَالَ : السِّنَّوْرُ مِنْ مَتَاعِ الْبَيْتِ ""","","","","","Book of Purification"
"346","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي صَدَقَةُ بْنُ يَسَارٍ , قَالَ :تَوَضَّأَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَوْمَا فَاحْتَبَسَ عَنْ أَصْحَابِهِ , ثُمَّ خَرَجَ , فَقَالُوا : مَا حَبَسَكَ ؟ , قَالَ :  دُوَيِّبَةٌ شَرِبَتِ الْهِرَّةُ "", قَالَ صَدَقَةُ : لا أَدْرِي أَمِنْ وَضُوئِهِ أَمْ مِنْ فَضْلِ وَضُوئِهِ لا أَدْرِي , وَقَالَ رَجُلٌ حِينَئِذٍ عِنْدَنَا مِمَّنْ سَمِعَ الْعِلْمَ : بَلْ مِنْ وَضُوئِهِ""","","","","","Book of Purification"
"347","عَنِ ابْنِ جُرَيْجٍ ، قُلْتُ لِعَطَاءٍ :الْحِمَارُ يَشْرَبُ فِي جَفْنَتِي ؟ قَالَ :  نَعَمْ ، وَتَوَضَّأَ بِفَضْلِهِ "" ، ثُمَّ تَلا : ""  وَالْخَيْلَ وَالْبِغَالَ وَالْحَمِيرَ لِتَرْكَبُوهَا "" , قُلْتُ : فَإِنَّهُ يُنْهَى ، عَنْ أَكْلِهِ ؟ , قَالَ : لَيْسَ أَكْلُهُ مِثْلَ أَنْ يُتَوَضَّأَ بِفَضْلِهِ , فَاسْقِهِ بِجَفْنَتِكَ ""","","","","","Book of Purification"
"348","عَنِ ابْنِ مُجَاهِدٍ ، عَنْ أَبِيهِ  أَنَّهُ كَانَيَتَوَضَّأُ بِفَضْلِ الْحِمَارِ ""","","","","","Book of Purification"
"349","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، رَأَى مُجَاهِدًا يَتَوَضَّأُ بِفَضْلِ الْحِمَارِ ""","","","","","Book of Purification"
"350","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ  عَنِالْوُضُوءِ مِنْ فَضْلِ الْحِمَارِ , فَقَالَ : لا بَأْسَ بِهِ ""","","","","","Book of Purification"
"351","وَقَالَ مَعْمَرٌ وَأَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ , يَقُولُ : لا بَأْسَ مِنْ فَضْلِ الْحِمَارِ بِالْوَضُوءِ ""","","","","","Book of Purification"
"352","عَنْ أَبِيهِ ، عَنْ عَبْدِ الْكَرِيمِ , قَالَ : سَأَلْتُ الْحَسَنَ ، عَنْ سُؤْرِ الْحِمَارِ ، فَقَالَ : لا بَأْسَ بِفَضْلِ الدَّوَابِّ كُلِّهَا ""","","","","","Book of Purification"
"353","قَالَ : وَسَأَلْتُ إِبْرَاهِيمَ النَّخَعِيَّ عَنْ سُؤْرِ الْحِمَارِ ؟ فَكَرِهَهُ ""","","","","","Book of Purification"
"354","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنِ الْحَسَنِ , قَالَ : لا بَأْسَ بِسُؤْرِ الْحِمَارِ ""","","","","","Book of Purification"
"355","عَنْ هِشَامٍ ، عَنِ الْحَسَنِ , قَالَ : لا بَأْسَ بِالْوُضُوءِ بِفَضْلِ الْحِمَارِ ""","","","","","Book of Purification"
"356","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ كَرِهَ سُؤْرَ الْحِمَارِ , وَالْبَغْلِ , وَالْكَلْبِ , وَلا يَرَى بِسُؤْرِ الْفَرَسِ , وَلا الشَّاةِ بَأْسًا "", عَنْ هُشَيْمٍ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , مِثْلَهُ""","","","","","Book of Purification"
"357","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ،  أَنَّهُكَرِهَ أَنْ يُتَوَضَّأَ بِفَضْلِ الْحِمَارِ , قَالَ : وَهَلْ هُوَ إِلا الْحِمَارُ ؟ ""","","","","","Book of Purification"
"358","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : مَا لا تَأْكُلُ لَحْمَهُ , لا تَتَوَضَّأُ بِفَضْلِهِ ""، قَالَ قَتَادَةُ : "" وَلَمْ أَسْمَعْ أَحَدًا يَخْتَلِفُ فِيمَا أُكِلَ لَحْمُهُ مِنَ الدَّوَابِّ أَنْ يُتَوَضَّأَ بِفَضْلِهِ , وَيُشْرَبُ مِنْهُ ""","","","","","Book of Purification"
"359","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ  أَنَّهُ كَانَيَكْرَهُ سُؤْرَ الْحِمَارِ , وَالْكَلْبِ , وَالْهِرِّ , أَنْ يُتَوَضَّأَ بِفَضْلِهِمْ "", عَنِ الثَّوْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , مِثْلَهُ""","","","","","Book of Purification"
"360","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : سَأَلْتُ الْحَسَنَ ، وَابْنَ الْمُسَيِّبِ ،  عَنِالْوُضُوءِ بِفَضْلِ الْمَرْأَةِ ، فَكِلاهُمَا نَهَانِي عَنْهُ ""","","","","","Book of Purification"
"361","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ عُبَيْدٍ ، عَنِ الْحَسَنِ ، أَنَّهُ كَانَ لا يَرَى بَأْسًا أَنْ يَتَنَازَعَ الرَّجُلُ وَالْمَرْأَةُ الْوُضُوءَ , وَيَقُولُ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يَتَوَضَّأَ الرَّجُلُ بِفَضْلِ الْمَرْأَةِ ""","","","","","Book of Purification"
"362","عَنْ مَعْمَرٍ ، عَنْ جَابِرِ بْنِ يَزِيدَ الْجُعْفِيِّ ، عَنْ ذِي قَرَابَةٍ لِجُوَيْرِيَةَ زَوْجِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهَا , قَالَتْ : لا تَتَوَضَّأْ بِفَضْلِ وَضُوئِي ""","","","","","Book of Purification"
"363","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عُمَرَ بْنِ سَعِيدِ بْنِ مَسْرُوقٍ ، عَنْ رَجُلٍ ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ الْحِمْيَرِيِّ ، عَنْ رَجُلٍ ، صَحِبَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثَلاثَ سِنِينَ , أَنَّهُ قَالَ : نَهَى أَنْ يَتَوَضَّأَ الرَّجُلُ بِفَضْلِ الْمَرْأَةِ ""","","","","","Book of Purification"
"364","عَنْ مَعْمَرٍ , قَالَ : سَمِعْتُ قَتَادَةَ ، أَوْ غَيْرَهِ يُحَدِّثُ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّهُ كَانَلا يَرَى بَأْسًا بِفَضْلِ شَرَابِ الْمَرْأَةِ , وَلا بِفَضْلِ وَضُوئِهَا , وَيَقُولُ :  هِيَ أَنْظَفُ ثِيَابًا , وَأَطْيَبُ رِيحًا "", عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ أَيُّوبَ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ , مِثْلَهُ""","","","","","Book of Purification"
"365","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ إِنْسَانٌ عَطَاءً ، فَقَالَ : الْمَرْأَةُ تَغْتَسِلُ غَيْرُ الْجُنُبِ ، أَيَغْتَسِلُ الرَّجُلُ بِفَضْلِهَا ؟ "" , قَالَ : "" نَعَمْ ""","","","","","Book of Purification"
"366","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ عَبَّاسِ بْنِ عَبْدِ اللَّهِ بْنِ مَعْبَدٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : لا بَأْسَ بِفَضْلِ الْمَرْأَةِ حَائِضًا كَانَتْ , أَوْ غَيْرَ حَائِضٍ , إِذَا لَمْ يَكُنْ فِي يَدَيْهَا بَأْسٌ ""","","","","","Book of Purification"
"367","عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : لا بَأْسَ أَنْ يَتَوَضَّأَ الرَّجُلُ بِفَضْلِ الْمَرْأَةِ , مَا لَمْ تَكُنْ حَائِضًا أَوْ جُنُبًا ""","","","","","Book of Purification"
"368","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :لَقِيتُ الْمَرْأَةَ عَلَى الْمَاءِ تَغْتَسِلُ بِهِ أَوْ تَتَوَضَّأُ ، يَتَوَضَّأُ الرَّجُلُ بِفَضْلِهَا ؟ قَالَ :  نَعَمْ , إِذَا كَانَتْ مُسْلِمَةً "", قَالَ عَطَاءٌ : "" يَغْتَسِلُ الرَّجُلُ بِفَضْلِ الْمَرْأَةِ غَيْرَ جُنُبَيْنِ ""","","","","","Book of Purification"
"369","عَنْ مَعْمَرٍ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ ، سَمِعْتُ عَبْدَ اللَّهِ بْنَ سَرْجَسَ , قَالَ : لا بَأْسَ أَنْ يَغْتَسِلَ الرَّجُلُ وَالْمَرْأَةُ مِنْ إِنَاءٍ وَاحِدٍ , فَإِذَا خَلَتْ بِهِ فَلا تَقْرَبْهُ ""","","","","","Book of Purification"
"370","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : لا بَأْسَ بِالْوُضُوءِ مِنْ فَضْلِ شَرَابِ الْمَرْأَةِ ، وَفَضْلِ وَضُوئِهَا مَا لَمْ تَكُنْ جُنُبًا ، أَوْ حَائِضًا , فَإِذَا خَلَتْ بِهِ فَلا تَقْرَبْهُ ""","","","","","Book of Purification"
"371","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ إِنْسَانٌ عَطَاءً ، فَقَالَ : الْمَرْأَةُ تَغْتَسِلُ غَيْرَ جُنُبٍ , أَيَغْتَسِلُ الرَّجُلُ بِإِنَاءٍ مَعَهَا ؟ قَالَ : نَعَمْ ""","","","","","Book of Purification"
"372","عَنِ الثَّوْرِيِّ ، عَنْ مِقْدَامِ بْنِ شُرَيْحِ بْنِ هَانِئٍ ، عَنْ أَبِيهِ ، عَنْ عَائِشَةَ , قَالَتْ : كُنْتُ أَشْرَبُ فِي الإِنَاءِ وَأَنَا حَائِضٌ , فَيَأْخُذُهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَيَضَعُ فَاهُ عَلَى مَوْضِعِ فِيَّ فَيَشْرَبُ ، وَكُنْتُ آخُذُ الْعَرْقَ فَأَنْتَهِشُ مِنْهُ فَيَأْخُذُهُ مِنِّي ، ثُمَّ يَضَعُ فَاهُ عَلَى مَوْضِعِ فِيَّ فَيَنْتَهِشُ مِنْهُ ""","","","","","Book of Purification"
"373","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ  عَنْسُؤْرِ الْحَائِضِ ، وَالْجُنُبِ , فَلَمْ يَرَ بِهِ بَأْسًا ""","","","","","Book of Purification"
"374","عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : لا بَأْسَ بِسُؤْرِ الْحَائِضِ ، وَالْجُنُبِ , فَلَمْ يَرَ بِهِ بَأْسًا وُضُوءًا ، أَوْ شَرَابًا ""","","","","","Book of Purification"
"375","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ , قَالَ : لا بَأْسَ بِسُؤْرِ الْحَائِضِ أَنْ يَشْرَبَهُ ، وَأَنْ يَتَوَضَّأَ مِنْهُ ""","","","","","Book of Purification"
"376","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ  كَانَيَكْرَهُ سُؤْرَ الْجُنُبِ , وَوُضُوءَهُ , وَشَرَابَهُ ، وَكَانَ لا يَرَى بَأْسًا أَنْ يَتَوَضَّأَ بِفَضْلِ الْحَائِضِ ، وَيَكْرَهُ فَضْلَ شَرَابِهَا "", عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنِ الْحَسَنِ ، مِثْلَ حَدِيثِ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ""","","","","","Book of Purification"
"377","عَنْ مَالِكٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ  أَنَّهُ كَانَيَكْرَهُ فَضْلَ الْحَائِضِ وَالْجُنُبِ ""","","","","","Book of Purification"
"378","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ عَبَّاسِ بْنِ عَبْدِ اللَّهِ بْنِ مَعْبَدٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : لا بَأْسَ بِفَضْلِ الْمَرْأَةِ حَائِضًا كَانَتْ ، أَوْ غَيْرَ حَائِضٍ ""","","","","","Book of Purification"
"379","عَنِ الثَّوْرِيِّ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ امْرَأَةً مِنْ نِسَاءِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَحَمَّتْ مِنْ جَنَابَةٍ , فَجَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَتَوَضَّأَ مِنْ فَضْلِهَا , فَقَالَتْ : إِنِّي اغْتَسَلْتُ مِنْهُ , فَقَالَ :  إِنَّالْمَاءَ لا يُنَجِّسُهُ شَيْءٌ "", عَنْ إِسْرَائِيلَ ، عَنْ عِكْرِمَةَ ، عَنِ ابْنِ عَبَّاسٍ , مِثْلَهُ""","","","","","Book of Purification"
"380","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ , قَالَ : سُئِلَ عُمَرُ بْنُ الْخَطَّابِ ، عَنِ الْمَرْأَةِ الْحَائِضِ تُنَاوِلُ الرَّجُلَ وَضُوءًا ، فَتُدْخِلُ يَدَهَا فِيهِ , قَالَ :  إِنَّحَيْضَتَهَا لَيْسَتْ فِي يَدِهَا ""","","","","","Book of Purification"
"381","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :هَلْ يَتَوَضَّأُ الْجُنُبُ بِفَضْلِ وَضُوءِ الْجُنُبِ ، وَالرَّجُلُ وَالْمَرْأَةُ يَتَوَضَّأُ أَحَدُهُمَا بِفَضْلِ الآخَرِ جُنُبَيْنِ ؟ , قَالَ :  أَمَّا لِصَلاةٍ فَلا ، وَلَكِنَّ الطَّعَامَ وَالشَّرَابَ وَالنَّوْمَ "" , قَالَ : "" لا يُنْتَفَعُ بِفَضْلِ وَضُوءِ الْجُنُبِ لِلصَّلاةِ "" , قُلْتُ : وَالْحَائِضُ بِمَنْزِلَتِهِمَا ؟ , قَالَ : "" نَعَمْ ""","","","","","Book of Purification"
"382","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : كُنَّا نَغْتَسِلُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَحْنُ وَنِسَاؤُنَا مِنْ إِنَاءٍ وَاحِدٍ ""","","","","","Book of Purification"
"383","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ لا بَأْسَ أَنْ تَمْتَشِطَ الْمَرْأَةُ الطَّاهِرُ بِفَضْلِ الْجُنُبِ مِنَ الْجَنَابَةِ , وَيُخْتَضَبَ بِفَضْلِهَا , يَأْكُلُ أَحَدُهُمَا وَيَشْرَبُ مِنْ فَضْلِ الآخَرِ ""","","","","","Book of Purification"
"384","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، وَعَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ : لا بَأْسَ أَنْ تَمْتَشِطَ الْمَرْأَةُ الطَّاهِرُ بِفَضْلِ الْحَائِضِ "", عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , مِثْلَهُ""","","","","","Book of Purification"
"385","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً ,عَنْ مَسِّ الإِبِطِ ، فَقَالَ : مَا أُحِبّ أَنْ أَمَسَّهُ مُنْذُ سَمِعْتُ فِيهِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ مَا سَمِعْتُ  وَلا أَتَوَضَّأُ مِنْهُ ""","","","","","Book of Purification"
"386","عَنْ إِبْرَاهِيمَ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنْ رَجُلٍ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : مَنْ مَسَّ إِبِطَهُ فَلْيَتَوَضَّأْ "", قَالَ : وَلَمْ أَسْمَعْ هَذَا الْحَدِيثَ إِلا مِنْهُ , قَالَ : "" وَإِنَّا نُحَدِّثُ النَّاسَ بِالْوُضُوءِ مِنْ مَسِّ الْفَرْجِ فَمَا يُصَدِّقُونَا , فَكَيْفَ إِذَا حدَّثْنَا بِمَسِّ الإِبِطِ ؟ "" , عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنِ ابْنِ شِهَابٍ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ مِثْلَهُ , إِلا أَنَّهُ لَمْ يَذْكُرِ الذَّكَرَ""","","","","","Book of Purification"
"387","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ , قَالَ : كَانَ ابْنُ عُمَرَ يُمِرُّ يَدَهُ عَلَى إِبِطِهِ إِذَا تَوَضَّأَ ، ثُمَّ لا يُعِيدُ وُضُوءًا ""","","","","","Book of Purification"
"388","عَنْ أَبِي جَعْفَرٍ الرَّازِيِّ قَالَ : أَخْبَرَنَا يَحْيَى الْبَكَّاءُ , قَالَ : رَأَيْتُ ابْنَ عُمَرَ فِي إِزَارٍ وَرِدَاءٍ  فَرَأَيْتُهُيَضَعُ يَدَهُ عَلَى أَنْفِهِ ، ثُمَّ يَضْرِبُ بِيَدِهِ عَلَى إِبِطِهِ وَهُوَ فِي الصَّلاةِ ""","","","","","Book of Purification"
"389","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، وَعَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : لَيْسَ فِي نَتْفِ الإِبِطِ وُضُوءٌ ""","","","","","Book of Purification"
"390","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ شُعَيْبٍ ، أَنَّ بُسْرَةَ بِنْتَ صَفْوَانَ بْنِ مُحَرَّثٍ , قَالَتْ : قُلْتُ : يَا رَسُولَ اللَّهِ , إِحْدَانَا تَتَوَضَّأُ لِصَلاةٍ فَتَفْرَغُ مِنْ وُضُوئِهَا ، ثُمَّ تُدْخِلُ يَدَهَا فِي دِرْعِهَا فَتَمَسُّ فَرْجَهَا , أَيَجِبُ عَلَيْهَا الْوُضُوءُ ؟ , قَالَ :  نَعَمْ ،إِذَا مَسَّتْ فَرْجَهَا فَلْتُعِدِ الصَّلاةَ , وَالْوُضُوءَ "", قَالَ : وَعَبْدُ اللَّهِ بْنُ عَمْرٍو جَالِسٌ فَلَمْ يُفْزِعْ ذَلِكَ عَبْدَ اللَّهِ ابْنَ عَمْرٍو بَعْدُ""","","","","","Book of Purification"
"391","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ , قَالَ : تَذَاكَرَ هُوَ وَمَرْوَانُ الْوُضُوءَ مِنْ مَسِّ الْفَرْجِ ، فَقَالَ مَرْوَانُ : حَدَّثَتْنِي بُسْرَةُ بِنْتُ صَفْوَانَ ، أَنَّهَا سَمِعَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : يَأْمُرُ بِالْوُضُوءِ مِنْ مَسِّ الْفَرْجِ "", فَكَأَنَّ عُرْوَةُ لَمْ يَقْنَعْ بِحَدِيثِهِ , فَأَرْسَلَ مَرْوَانُ إِلَيْهَا شُرْطِيًّا فَرَجَعَ فَأَخْبَرَهُمْ , أَنَّهَا سَمِعَتْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" يَأْمُرُ بِالْوُضُوءِ مِنْ مَسِّ الْفَرْجِ "" , قَالَ مَعْمَرٌ : وَأَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ ، عَنْ أَبِيهِ , مِثْلَهُ""","","","","","Book of Purification"
"392","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : حَدَّثَنِي ابْنُ شِهَابٍ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ ، عَنْ عُرْوَةَ أَنَّهُ كَانَ يُحَدِّثُ ، عَنْ بُسْرَةَ بِنْتِ صَفْوَانَ ، عَنْ زَيْدِ بْنِ خَالِدٍ الْجُهَنِيِّ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا مَسَّ أَحَدُكُمْ ذَكَرَهُ فَلْيَتَوَضَّأْ ""","","","","","Book of Purification"
"393","عَنْ مَعْمَرِ بْنِ رَاشِدٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَصَلَّى الصُّبْحَ ثُمَّ عَادَ لَهَا , فَقِيلَ لَهُ : إِنَّكَ قَدْ كُنْتَ صَلَّيْتَ , فَقَالَ :  أَجَلْ ، وَلَكِنِّي ، مَسَسْتُ ذَكَرِي , فَنَسِيتُ أَنْ أَتَوَضَّأَ ""","","","","","Book of Purification"
"394","عَنِ ابْنِ جُرَيْجٍ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، أَنَّ مُجَاهِدًا أَخْبَرَهُ ، أَنَّ بَعْضَ بَنِي سَعْدِ بْنِ أَبِي وَقَّاصٍ أَخْبَرَهُ , قَالَ : كُنْتُ أَمْسِكُ عَلَى سَعْدِ بْنِ أَبِي وَقَّاصٍ مَرَّةً الْمُصْحَفَ وَهُوَ يَسْتَذْكِرُ إِلَى أَنْحَكَّنِي ذَكَرِي فَحَكَكْتُهُ ، فَلَمَّا رَآنِي أُدْخِلُ يَدِيَ هُنَالِكَ , قَالَ :  أَمَسَسْتَهُ ؟ "" , قُلْتُ : نَعَمْ , قَالَ : "" قُمْ فَتَوَضَّأْ ""","","","","","Book of Purification"
"395","عَنْ مَعْمَرٍ ، وَابْنِ عُيَيْنَةَ ، عَنْ إِبْرَاهِيمَ بْنِ أَبِي حُرَّةَ ، عَنْ مُصْعَبِ بْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ , قَالَ : كُنْتُ أَعْرِضُ عَلَى أَبِي أَمْسِكُ الْمُصْحَفَ ، وَهُوَ يَقْرَأُهُفَحَكَّنِي ذَكَرِي فَأَدْخَلْتُ يَدِي فَحَكَكْتُهُ ، فَإِذَا أَنَا قَدْ مَسَسْتُ ذَكَرِي فَذَكَرْتُ ذَلِكَ لَهُ , قَالَ :  قُمْ فَتَوَضَّأْ ، فَفَعَلْتُ ""","","","","","Book of Purification"
"396","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ أَبِي مُلَيْكَةَ يُحَدِّثُ ، عَمَّنْ لا أَتَّهِمُ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ بَيْنَا هُوَ قَائِمٌ يُصَلِّي بِالنَّاسِ حِينَ بَدَأَ فِي الصَّلاةِ ، فَزَلَّتْ يَدُهُ عَلَى ذَكَرِهِ , فَأَشَارَ إِلَى النَّاسِ أَنِ امْكُثُوا ، وَذَهَبَ فَتَوَضَّأَ ، ثُمَّ جَاءَ فَصَلَّى, فَقَالَ لَهُ أَبِي : لَعَلَّهُ وَجَدَ مَذْيًا ؟ , قَالَ : لا أَدْرِي ""","","","","","Book of Purification"
"397","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، أَنَّ ابْنَ عُمَرَ صَلَّى بِهِمُ الْعَصْرَ ، ثُمَّ سَارَ أَمْيَالا , قَالَ : حَسِبْتُ أَنَّهُ , قَالَ : سِتَّةً , قَالَ : ثُمَّ نَزَلَ فَتَوَضَّأَ , وَأَعَادَ الصَّلاةَ , قَالَ : فقُلْتُ لَهُ :أَلَيْسَ قَدْ كُنْتَ صَلَّيْتَ ؟ , قَالَ :  بَلَى , وَلَكِنْ قَدْ مَسَسْتُ ذَكَرِي فَصَلَّيْتُ , وَلَمْ أَتَوَضَّأْ ، فَلِذَلِكَ أَعَدْتُ ""","","","","","Book of Purification"
"398","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنَا ابْنُ شِهَابٍ ، عَنْ سَالِمٍ ، أَنَّ ابْنَ عُمَرَ صَلَّى بِهِمْ بِطَرِيقِ مَكَّةَ الْعَصْرَ ، ثُمَّ رَكِبْنَا فَسِرْنَا مَا قُدِّرَ أَنْ نَسِيرَ ، ثُمَّ أَنَاخَ ابْنُ عُمَرَ , فَتَوَضَّأَ وَصَلَّى الْعَصْرَ وَحْدَهُ ، قَالَ سَالِمٌ : فَقُلْتُ لَهُ : إِنَّكَ قَدْ صَلَّيْتَ لَنَا صَلاةَ الْعَصْرِ أَفَنَسِيتَ ؟ , قَالَ :  إِنَّنِي لَمْ أَنْسَ , وَلَكِنِّي قَدْمَسَسْتُ ذَكَرِي قَبْلَ أَنْ أُصَلِّيَ ، فَلَمَّا ذَكَرْتُ ذَلِكَ , تَوَضَّأْتُ فَعُدْتُ لِصَلاتِي "", قَالَ ابْنُ جُرَيْجٍ : وَحَدَّثَنِي حَسَنُ بْنُ مُسْلِمٍ ، أَنَّ سَالِمَا حَدَّثَهُ , نَحْوَ حَدِيثِ ابْنِ شِهَابٍ هَذَا ، غَيْرَ أَنَّهُ لَمْ يَذْكُرْ أَيَّ صَلاةٍ""","","","","","Book of Purification"
"399","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ , قَالَ : كَانَ أَبِييَغْتَسِلُ ، ثُمَّ يَتَوَضَّأُ , فَيَقُولُ :  أَمَا يُجْزِيكَ الْغُسْلُ ، فَيَقُولُ : بَلَى ، وَلَكِنْ يُخَيَّلُ إِلَيَّ أَنَّهُ يَخْرُجُ مِنْ ذَكَرِي شَيْءٌ فَأَمَسُّهُ , فَأتَوَضَّأُ لِذَلِكَ ""","","","","","Book of Purification"
"400","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَإِنْ مَسَسْتَ ذَكَرَكَ وَأَنْتَ تَغْتَسِلُ , قَالَ :  إِذًا أَعُودُ بِوُضُوءٍ ""","","","","","Book of Purification"
"401","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , قَالَ : مَنْ مَسَّ ذَكَرَهُ فَلْيَتَوَضَّأْ ""","","","","","Book of Purification"
"402","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : مَنْ مَسَّ ذَكَرَهُ فَلْيَتَوَضَّأْ ""","","","","","Book of Purification"
"403","وَإِنَّمَا أُثِرَ ذَلِكَ ، عَنِ ابْنِ عُمَرَ ، قَالَ لَهُ قَيْسٌ : يَا أَبَا مُحَمَّدٍ ,لَوْ مَسَسْتَ ذَكَرَكَ وَأَنْتَ فِي الصَّلاةِ الْمَكْتُوبَةِ أَكُنْتَ مُنْصَرِفًا , وَقَاطِعًا صَلاتَكَ لِتَتَوَضَّأَ ؟ قَالَ :  نَعَمْ , وَاللَّهِ إِنْ كُنْتُ لَقَاطِعًا صَلاتِي وَمُتَوَضِّئًا ""","","","","","Book of Purification"
"404","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :مَسَسْتُ الذَّكَرَ مِنْ وَرَاءِ الثَّوْبِ , قَالَ :  فَلا وُضُوءَ إِلا مِنْ مُبَاشَرَةٍ ، ثُمَّ بِالْمَسِيسِ "" ، قُلْتُ : بِالْفَخِذِ أَوِ السَّاقِ , قَالَ : "" فَلا وُضُوءَ إِلا بِالْيَدِ "" , قُلْتُ : فَمَا يُفَرِّقُ بَيْنَ ذَلِكَ ؟ , قَالَ : "" إِنَّمَا هُوَ مِنَ الرِّجْلِ , وَكَيْفَ لا يَمَسُّ الرِّجْلَ ، لَيْسَتِ الْيَدُ كَهَيْئَةِ الرِّجْلِ فِي ذَلِكَ ""","","","","","Book of Purification"
"405","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَإِنْ مَسَسْتُ ذَكَرِي وَلَمْ أَمَسَّ سَبِيلَ الْبَوْلِ , قَالَ :  إِذَا مَسَسْتَ ظَهْرَهُ , أَوْ أَيَّهُ كَانَ فَتَوَضَّأْ ""","","","","","Book of Purification"
"406","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ ، عَنْ جَعْفَرِ بْنِ الزُّبَيْرِ ، عَنِ الْقَاسِمِ أَبِي عَبْدِ الرَّحْمَنِ عَنْ أَبِي أُمَامَةَ ، أَنَّ رَجُلا سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ :مَسَسْتُ ذَكَرِي , وَأَنَا أُصَلِّي , قَالَ :  لا بَأْسَ إِنَّمَا هُوَ جُذْيَةٌ مِنْكَ ""","","","","","Book of Purification"
"407","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ مُحَمَّدِ بْنِ جَابِرٍ ، عَنْ قَيْسِ بْنِ طَلْقٍ ، عَنْ أَبِيهِ , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ ! أَرَأَيْتَالرَّجُلَ يَتَوَضَّأُ فَيَهْوِي بِيَدِهِ , فَيَمَسُّ ذَكَرَهُ , أيَتَوَضَّأُ ؟ ثُمَّ أَهْوَى بِيَدَيَّ فَأَمَسَّ ذَكَرِي ؟ , قَالَ :  هُوَ مِنْكَ ""","","","","","Book of Purification"
"408","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ الْحَسَنِ قَالَ : اجْتَمَعَ رَهْطٌ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْهُمْ ، مَنْ يَقُولُ : مَا أُبَالِي مَسَسْتُهُ أَمْ أُذُنِي ، أَوْ فَخِذِي ، أَوْ رُكْبَتِي ""","","","","","Book of Purification"
"409","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ أَبِي إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ , قَالَ : مَا أُبَالِي إِيَّاهُ مَسَسْتُ , أَوْ أُذُنِي إِذَا لَمْ أَعْتَمِدْ لِذَلِكَ ""","","","","","Book of Purification"
"410","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ الْمَخَارِقِ بْنِ أَحْمَرَ الْكُلاعِيِّ , قَالَ : سَمِعْتُ حُذَيْفَةَ بْنَ الْيَمَانِ ، وَعَنْ إِيَادِ بْنِ لَقِيطٍ , قَالَ : حَدَّثَنَا الْبَرَاءُ بْنُ قَيْسٍ , قَالَ : سَمِعْتُ حُذَيْفَةَ ، وَسَأَلَهُ رَجُلٌ عَنْمَسِّ الذَّكَرِ فِي الصَّلاةِ , فَقَالَ :  مَا أُبَالِي مَسَسْتُهُ ، أَوْ مَسَسْتُ أَنْفِي "", وَبِهِ يَأْخُذُ سُفْيَانُ""","","","","","Book of Purification"
"411","عَنْ مَعْمَرٍ ، عَنِ الثَّوْرِيِّ ، وَإِسْرَائِيلَ ، عَنْ إِسْحَاقَ ، عَنْ أَرْقَمَ بْنِ شُرَحْبِيلٍ , قَالَ :حَكَكْتُ جَسَدِي وَأَنَا فِي الصَّلاةِ ، وَأَفْضَيْتُ إِلَى ذَكَرِي ، فقُلْتُ لِعَبْدِ اللَّهِ بْنِ مَسْعُودٍ : فَضَحِكَ وقَالَ :  اقْطَعْهُ أَيْنَ تَعْزِلُهُ إِنَّمَا هُوَ بُضْعَةٌ مِنْكَ ""","","","","","Book of Purification"
"412","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، أَنَّ ابْنَ مَسْعُودٍ , قَالَ : مَا أُبَالِي إِيَّاهُ مَسَسْتُ , أَوْ أَرْنَبَتِي ""","","","","","Book of Purification"
"413","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ  أَرَأَيْتَ إِنْمَسَسْتُ بِالذِّرَاعِ الذَّكَرَ , أَتَوَضَّأُ ؟ قَالَ : نَعَمْ ""","","","","","Book of Purification"
"414","أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، عَنْ عِمَرَانَ بْنِ الْحُصَيْنِ , قَالَ : مَا أُبَالِي إِيَّاهُ مَسَسْتُ ، أَوْ فَخِذِي ""","","","","","Book of Purification"
"415","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ , قَالَ : سَأَلَ رَجُلٌ سَعْدَ بْنَ أَبِي وَقَّاصٍ ، عَنْمَسِّ الذَّكَرِ أيَتَوَضَّأُ مِنْهُ ؟ قَالَ :  إِنْ كَانَ مِنْكَ شَيْءٌ نَجِسٌ , فَاقْطَعْهُ ""","","","","","Book of Purification"
"416","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ يُوسُفَ ، عَنْ كَثِيرٍ ، مِنْ أَهْلِ الْمَدِينَةِ ، أَنَّ ابْنَ عَبَّاسٍ ، قَالَ لابْنِ عُمَرَ : لَوْ أَعْلَمُ أَنَّ مَا تُقُولُ فِي الذَّكَرِ حَقًّا لَقَطَعْتُهُ ، ثُمَّ إِذَا لَوْ أَعْلَمُهُ نَجِسًا لَقَطَعْتُهُ ، وَمَا أُبَالِي إِيَّاهُ مَسَسْتُ ، أَوْ مَسَسْتُ أَنْفِي ""","","","","","Book of Purification"
"417","عَنْ سُلَيْمَانَ بْنِ مِهْرَانَ الأَعْمَشِ ، عَنِ الْمِنْهَالِ بْنِ عَمْرٍو ، عَنْ قَيْسِ بْنِ السَّكَنِ ، أَنَّ عَلِيًّا ، وَعَبْدَ اللَّهِ بْنَ مَسْعُودٍ ، وَحُذَيْفَةَ بْنَ الْيَمَانِ ، وَأَبَا هُرَيْرَةَ لا يَرَوْنَ مِنْ مَسِّ الذَّكَرِ وُضُوءًا ، وَقَالُوا : لا بَأْسَ بِهِ ""","","","","","Book of Purification"
"418","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَةَ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ , قَالَ : مَنْ مَسَّ ذَكَرَهُ , فَلَيْسَ عَلَيْهِ وُضُوءٌ ""","","","","","Book of Purification"
"419","عَنْ مَعْمَرٍ , قَالَ : كَانَ الْحَسَنُ ، وقَتَادَةُ لا يَرَيَانِ مِنْهُ وُضُوءًا ""","","","","","Book of Purification"
"420","عَنِ الثَّوْرِيِّ , قَالَ : سَمِعْتُهُ يَقُولُ : دَعَانِي وَابْنَ جُرَيْجٍ بعض أمرائهم , فسألناعَنْ مَسِّ الذَّكَرِ ، فَقَالَ ابْنُ جُرَيْجٍ :  يَتَوَضَّأُ "" ، فقُلْتُ : لا وُضُوءَ عَلَيْهِ ، فَلَمَّا اخْتَلَفْنَا , قُلْتُ لابْنِ جُرَيْجٍ : أَرَأَيْتَ لَوْ أَنَّ رَجُلا وَضَعَ يَدَهُ عَلَى مَنِيٍّ ؟ , فَقَالَ : "" يَغْسِلُ يَدَهُ "" ، قُلْتُ : فَأَيُّهُمَا أَنْجَسُ الْمَنِيُّ , أَوِ الذَّكَرُ ؟ , قَالَ : "" لا ، بَلِ الْمَنِيُّ "" , قَالَ : فَقُلْتُ : وَكَيْفَ هَذَا ؟ , قَالَ : "" مَا أَلْقَاهَا عَلَى لِسَانِكَ إِلا شَيْطَانٌ ""","","","","","Book of Purification"
"421","أَخْبَرَنَا عَنْ مَعْمَرٍ ، قَالَ : كَانَ الْحَسَنُ , وَقَتَادَةُ : لا يَرَيَانِ مِنْهُ وُضُوءًا ""","","","","","Book of Purification"
"422","أَخْبَرَنَا مَعْمَرٌ ، عَنِ الزُّهْرِيِّ ، قَالَ : سَمِعْتُ أَبَانَ بْنَ عُثْمَانَ ، يَقُولُ : مَنْ مَسَّ الذَّكَرَ فَلْيَتَوَضَّأْ ""","","","","","Book of Purification"
"423","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عِكْرِمَةَ ، أَنَّهُ قَالَ : مَنْ مَسَّ مَغَابِنَهُ فَلْيَتَوَضَّأْ "", قَالَ عَمْرٌو : "" وَمَا أُرَاهُ إِلا الرُّفْغَيْنِ ""","","","","","Book of Purification"
"424","أَنَّهُ قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ مَسَّ ذَكَرَهُ ، أَوْ أُنْثَيَيْهِ ، أَوْ رُفْغَيْهِ , فَلْيُعِدِ الْوُضُوءَ ""","","","","","Book of Purification"
"425","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْمَسَسْتُ مَا حَوْلَ الذَّكَرِ وَالأُنْثَيَيْنِ ؟ قَالَ :  فَلا وُضُوءَ إِلا مِنْهُ نَفْسِهِ ""","","","","","Book of Purification"
"426","عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : إِذَا مَسَّ الرَّجُلُ أُنْثَيَيْهِ ، أَوْ رُفْغَيْهِ تَوَضَّأَ ""","","","","","Book of Purification"
"427","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :مَسَّ الرَّجُلُ مِقْعَدَتَهُ سَبِيلَ الْخَلاءِ , وَلَمْ يَضَعْ يَدَهُ هُنَاكَ أَفَيَتَوَضَّأُ ؟ قَالَ :  نَعَمْ ، إِذَا كُنْتَ مُتَوَضِّئًا مِنْ مَسِّ الذَّكَرِ تَوَضَّأْتَ مِنْ مَسِّهَا "" , قَالَ : قُلْتُ : أَرَأَيْتَ إِنْ مَسَّ مَا حَوْلَ سَبِيلِ الْخَلاءِ وَلَمْ يُوغِلْ يَدَهُ هُنَالِكَ""","","","","","Book of Purification"
"428","عَنْ مَعْمَرٍ , قَالَ : سَمِعْتُ رَجُلا ، يَقُولُ لِقَتَادَةَ :رَجُلٌ بِهِ الْحَاصِرَةُ فَتَخْرُجُ مِقْعَدَتُهُ مِنْ شِدَّةِ الزَّحِيرِ فَيُدْخِلُهَا بِيَدِهِ ، هَلْ عَلَيْهِ وُضُوءٌ ؟ , قَالَ :  لا ، وَلَكِنْ يَغْسِلُ يَدَهُ ""","","","","","Book of Purification"
"429","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  أَرَأَيْتَ لَوْمَسَسْتُ ذَكَرَ غُلامٍ صَغِيرٍ ؟ قَالَ : تَوَضَّأْ ""","","","","","Book of Purification"
"430","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : مَسَسْتُ قُنْبَ حِمَارٍ , أَوْ ثَيْلَ جَمَلٍ , قَالَ :  أَمَّاقُنْبُ الْحِمَارِ فَكُنْتَ مُتَوَضِّئًا ، وَأَمَّا مِنْ ثَيْلِ الْجَمَلِ فَلا "" , قُلْتُ : فَمَاذَا يُفَرِّقُ بَيْنَهُمَا ؟ , قُلْتُ : "" مِنْ أَجْلِ الْحِمَارِ وَهُوَ أَنْجَسُ "" , قَالَ : وَأَقُولُ : "" أَنَا أَنْظُرُ كُلَّ شَيْءٍ نَجِسٍ كَهَيْئَةِ الْحِمَارِ , لا يُؤْكَلُ لَحْمُهُ مَسَّ مِنْهُ ذَلِكَ فَعَلَيْهِ الْوُضُوءُ ، وَكُلُّ شَيْءٍ يُؤْكَلُ لَحْمُهُ كَهَيْئَةِ الْبَعِيرِ مَسَّ ذَلِكَ مِنْهُ , فَلا وُضُوءَ مِنْهُ ""","","","","","Book of Purification"
"431","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْكَلْبُ مَسَّ ثَوْبِي أَرُشُّهُ ؟ , قَالَ : لا ""","","","","","Book of Purification"
"432","عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : سَأَلْتُهُ فقُلْتُ :مَرَّ كَلْبٌ فَأَصَابَ طَيْلَسَانِي , قَالَ :  إِنْ كَانَ لَزِقَ بِهِ شَيْءٌ فَاغْسِلْهُ ، وَإِلا فَلا بَأْسَ ""","","","","","Book of Purification"
"433","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِنْمَسَّ رَجُلٌ كَلْبًا , أَوْ حِمَارًا رَطْبًا , يَتَوَضَّأُ مِنْهُ ؟ قَالَ :  لا ، وَذَلِكَ أَنْتَنُ مِنَ الإِبِطِ ""","","","","","Book of Purification"
"434","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ فِيرَجُلٍ تَوَضَّأَ فَمَسَّ كَلْبًا , قَالَ :  لَيْسَ عَلَيْهِ وُضُوءٌ ""","","","","","Book of Purification"
"435","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ إِنْسَانٌ عَطَاءً ، فَقَالَ : مَسَسْتُ نَعْلِي فِي الصَّلاةِ ، وَقَعَتْ يَدَيَّ عَلَى قَشْبٍ فِيهَا ، أُعِيدُ صَلاتِي ؟ , قَالَ "" لا ""","","","","","Book of Purification"
"436","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : سَأَلْتُهُ عَنْرَجُلٍ يَتَوَضَّأُ فَيُصَافِحُ الْجُنُبَ ، وَالْحَائِضَ ، وَالْيَهُودِيَّ ، وَالنَّصْرَانِيَّ , قَالَ :  لا يُعِيدُ الْوُضُوءَ ""","","","","","Book of Purification"
"437","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَقِيَ حُذَيْفَةَ فَأَهْوَى بِيَدِهِ إِلَى حُذَيْفَةَ , فَقَالَ حُذَيْفَةُ : إِنِّي جُنُبٌ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَنَّالْمُؤْمِنَ لا يَنْجُسُ ""","","","","","Book of Purification"
"438","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : لَيْسَ عَلَى الرَّجُلِ يَمَسُّهُ الرَّجُلُ جَنَابَةٌ "", عَنْ مَعْمَرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , مِثْلَهُ""","","","","","Book of Purification"
"439","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ يَحْيَى بْنِ الْجَزَّارِ , قَالَ : صَلَّى ابْنُ مَسْعُودٍ وَعَلَى بَطْنِهِ فَرْثٌ , وَدَمٌ مِنْ جُزُرٍ نَحَرَهَا , وَلَمْ يَتَوَضَّأْ ""","","","","","Book of Purification"
"440","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : نَحَرَ ابْنُ مَسْعُودٍ جَزُورًا فَتَلَطَّخَ بِدَمِهَا وَفَرْثِهَا ، ثُمَّ أُقِيمَتِ الصَّلاةُ فَصَلَّى , وَلَمْ يَتَوَضَّأْ ""","","","","","Book of Purification"
"441","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ عَمَارٍ الدُّهْنِيِّ ، عَنْ أَبِي عَمْرٍو الشَّيْبَانِيِّ ، أَوْ غَيْرِهِ ، أَنَّ عَلِيًّا ، اسْتَتَابَ الْمُسْتَوْرِدَ الْعِجْلِيَّ وَهُوَ يُرِيدُ الصَّلاةَ , وَقَالَ :  إِنِّي أَسْتَعِينُ بِاللَّهِ عَلَيْكَ , فَقَالَ : وَأَنَا أَسْتَعِينُ الْمَسِيحَ عَلَيْكَ , قَالَ :فَأَهْوَى عَلِيٌّ بِيَدِهِ إِلَى عُنُقِهِ فَإِذَا هُوَ بِصَلِيبٍ فَقَطَعُهُ ، فَلَمَّا دَخَلَ فِي الصَّلاةِ قَدَّمَ رَجُلا وَذَهَبَ ، ثُمَّ أَخْبَرَ النَّاسَ أَنَّهُ لَمْ يُحْدِثْ ذَلِكَ بِحَدَثٍ أَحْدَثَهُ , لَكِنَّهُ مَسَّ هَذِهِ الأَنْجَاسَ فَأَحَبَّ أَنْ يُحْدِثَ مِنْهَا وُضُوءًا ""","","","","","Book of Purification"
"442","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :قَصُّ الشَّارِبِ ، وَتَقْلِيمُ الأَظْفَارِ ، أَمِنْهُ وُضُوءٌ ؟ قَالَ :  لا ، وَلَكِنْ لِيَمَسَّ بِالْمَاءِ حَيْثُ قَلَّمَ وَقَصَّ ""","","","","","Book of Purification"
"443","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : إِذَا أَخَذَ الرَّجُلُ مِنْ أَظْفَارِهِ , أَوْ مِنْ شَعْرِهِ شَيْئًا أَمَرَّ عَلَيْهِ الْمَاءَ ""","","","","","Book of Purification"
"444","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ , قَالَ : يَمْسَحُ عَلَيْهِ الْمَاءَ ""","","","","","Book of Purification"
"445","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ , قَالَ :  قَدِانْتَقَضَ وُضُوءُهُ ""","","","","","Book of Purification"
"446","عَنْ هِشَامٍ ، عَنِ الْحَسَنِ فِي : الَّذِي يَأْخُذُ مِنْ أَظْفَارِهِ وَشَعْرِهِ ، لَيْسَ عَلَيْهِ شَيْءٌ ""","","","","","Book of Purification"
"447","عَنِ الثَّوْرِيِّ ، عَنْ يُونُسَ ، عَنِ الْحَسَنِ , قَالَ : لَيْسَ عَلَيْهِ شَيْءٌ ""","","","","","Book of Purification"
"448","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِيِّ , قَالَ هُوَ طَهُورٌ ""","","","","","Book of Purification"
"449","عَنْ مَعْمَرٍ ، وَالثَّوْرِيِّ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ أَبِيهِ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ :  لأَنْأَتَوَضَّأَ مِنَ الْكَلِمَةِ الْخَبِيثَةِ ، أَحَبُّ إِلَيَّ أَنْ أَتَوَضَّأَ مِنَ الطَّعَامِ الطَّيِّبِ ""","","","","","Book of Purification"
"450","عَنِ الثَّوْرِيِّ ، عَنْ عَاصِمٍ ، عَنْ ذَكْوَانَ ، أَنَّ عَائِشَةَ , قَالَتْ : يَتَوَضَّأُ أَحَدُكُمْ مِنَ الطَّعَامِ الطَّيِّبِ ، وَلا يَتَوَضَّأُ مِنَ الْكَلِمَةِ الْعَوْرَاءِ يَقُولُهَا ""","","","","","Book of Purification"
"451","عَنِ الثَّوْرِيِّ ، عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ ، عَنْ إِبْرَاهِيمَ , قَالَ :  إِنِّيأُصَلِّي الظُّهْرَ , وَالْعَصْرَ , وَالْمَغْرِبَ بِوُضُوءٍ وَاحِدٍ , إِلا أَنْ أُحْدِثَ ، أَوْ أَقُولَ مُنْكَرً "", عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عُبَيْدَةَ , مِثْلَهُ""","","","","","Book of Purification"
"452","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ هَلْ تَعْلَمُ فِي شَيْءٍ مِنْ كَلامٍ وُضُوءٌ ؟ قَالَ : لا ""","","","","","Book of Purification"
"453","عَنْ مَعْمَرٍ ، عَنْ هَمَامِ بْنِ مُنَبِّهٍ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : الْوُضُوءُ مِنَ الْحَدَثِ ""","","","","","Book of Purification"
"454","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : إِذَا مَلَكَ النَّوْمُ , فَتَوَضَّأْ قَاعِدًا , أَوْ مُضْطَجِعًا ""","","","","","Book of Purification"
"455","عَنْ هِشَامٍ ، عَنِ الْحَسَنِ , قَالَ : إِذَا نَامَ قَاعِدًا ، أَوْ قَائِمًا , فَالْوُضُوءُ ""","","","","","Book of Purification"
"456","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : إِذَا اسْتَثْقَلَ الرَّجُلُ نَوْمًا قَائِمًا ، أَوْ قَاعِدًا ، أَوْ مُضْطَجِعًا تَوَضَّأَ "", قَالَ : "" وَلَقَدْ كَانَ الْحَسَنُ يَتَوَضَّأُ فِي اللَّيْلَةِ مَرَّاتٍ ""","","","","","Book of Purification"
"457","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ , قَالَ : سَأَلْتُ الْحَسَنَ ، عَنِالرَّجُلِ نَامَ وَهُوَ سَاجِدٌ , قَالَ :  إِذَا خَالَطَهُ النَّوْمُ فَلْيَتَوَضَّأْ "", قَالَ : وَرَأَيْنَا الْحَسَنَ فِي الْمَقْصُورَةِ يَخْفِقُ بِرَأْسِهِ ، ثُمَّ يَقُومُ فَيُصَلِّي وَلا يَتَوَضَّأُ""","","","","","Book of Purification"
"458","عَنِ الثَّوْرِيِّ ، عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : وَجَبَ الْوُضُوءُ عَلَى كُلِّ نَائِمٍ ، إِلا مَنْ أَخْفَقَ خَفْقَةً بِرَأْسِهِ ""","","","","","Book of Purification"
"459","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ , قَالَ : إِذَا نَامَ وَهُوَ جَالِسٌ نَوْمًا مُثْقَلا أَعَادَ الْوُضُوءَ ، فَأَمَّا إِذَا كَانَ تَغْفِيفًا فَلا بَأْسَ ""","","","","","Book of Purification"
"460","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ ، وَغَيْرِهِ ، عَنْ سَعِيدٍ الْجُرَيْرِيِّ ، عَنْ هِلالٍ الْعَبْسِيِّ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ , قَالَ : مَنِ اسْتَحَقَّ النَّوْمَ فَعَلَيْهِ الْوُضُوءُ ""","","","","","Book of Purification"
"461","عَنْ مَالِكِ بْنِ أَنَسٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَالَ : مَنْ نَامَ مُضْطَجِعًا , فَلْيَتَوَضَّأْ ""","","","","","Book of Purification"
"462","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، عَنْ أَنَسٍ , قَالَ :  لَقَدْ رَأَيْتُ أَصْحَابَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيُوقَظُونَ لِلصَّلاةِ , وَإِنِّي لأَسْمَعُ لِبَعْضِهِمْ غَطِيطًا , يَعْنِي : وَهُوَ جَالِسٌ , فَمَا يَتَوَضَّئُونَ "", قَالَ مَعْمَرٌ : فَحَدَّثْتُ بِهِ الزُّهْرِيَّ ، فَقَالَ رَجُلٌ عِنْدَهُ : أَوْ خَطِيطًا ، قَالَ الزُّهْرِيُّ : "" لا ، قَدْ أَصَابَ غَطِيطًا ""","","","","","Book of Purification"
"463","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ  أَنَّهُ كَانَيَنَامُ وَهُوَ جَالِسٌ فَلا يَتَوَضَّأُ ، وَإِذَا نَامَ مُضْطَجِعًا أَعَادَ الْوُضُوءَ "", عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , مِثْلَهُ""","","","","","Book of Purification"
"464","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ ثَابِتِ بْنِ عُبَيْدٍ , قَالَ : انْتَهَيْتُ إِلَى ابْنِ عُمَرَ وَهُوَ جَالِسٌ يَنْتَظِرُ الصَّلاةَ , فَسَلَّمْتُ عَلَيْهِ فَاسْتَيْقَظَ ، فَقَالَ :  أَبَا ثَابِتٍ ! "" , قَالَ : قُلْتُ : نَعَمْ , قَالَ : "" أَسَلَّمْتَ ؟ "" , قَالَ : قُلْتُ : نَعَمْ , قَالَ : ""إِذَا سَلَّمْتَ فَأَسْمِعْ ، وَإِذَا رَدُّوا عَلَيْكَ فَلْيُسْمِعُوكَ "" ، ثُمَّ قَامَ فَصَلَّى ، وَكَانَ مُحْتَبِيًا قَدْ نَامَ""","","","","","Book of Purification"
"465","عَنِ ابْنِ جُرَيْجٍ ، عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ ، أَنَّ طَاوُسًا ،قَدِمَ يَوْمَ الْجُمُعَةِ وَابْنُ الضَّحَّاكِ يَخْطُبُ النَّاسَ , قَالَ : فَلَمَّا صَلَّيْنَا وَخَرَجْنَا , قَالَ :  مَا قَالَ حِينَ رَقَدْتُ ؟ ""","","","","","Book of Purification"
"466","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : سَأَلْتُهُ عَنِالرَّجُلِ يَنَامُ وَهُوَ رَاكِعٌ , أَوْ سَاجِدٌ , قَالَ :  لا يَجِبُ عَلَيْهِ الْوُضُوءُ حَتَّى يَضَعَ جَنْبَهُ ""","","","","","Book of Purification"
"467","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ فِطْرٍ ، عَنِ ابْنِ عَبْدِ الْكَرِيمِ بْنِ أَبِي أُمَيَّةَ ، أَنَّ عَلِيًّا ، وَابْنَ مَسْعُودٍ ، وَالشَّعْبِيَّ ، قَالُوا :  فِيالرَّجُلِ يَنَامُ وَهُوَ جَالِسٌ : لَيْسَ عَلَيْهِ وُضُوءٌ ""","","","","","Book of Purification"
"468","عَنْ هِشَامِ بْنِ حَسَّانَ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ , قَالَ : سَأَلْتُ عُبَيْدَةَ ،  عَنِالرَّجُلِ يَنَامُ وَهُوَ سَاجِدٌ أيَتَوَضَّأُ ؟ قَالَ : "" هُوَ أَعْلَمُ بِنَفْسِهِ ""","","","","","Book of Purification"
"469","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , قَالَ : سَأَلْتُ عُبَيْدَةَ أيَتَوَضَّأُ الرَّجُلُ إِذَا نَامَ ؟ قَالَ : هُوَ أَعْلَمُ بِنَفْسِهِ ""","","","","","Book of Purification"
"470","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ رَقَدْتُ فِي الْمَكْتُوبَةِ هُنَيَّةً ، ثُمَّ فَزِعْتُ فَلَمْ أَعْلَمْ أَنِّي تَكَلَّمْتُ بِشَيْءٍ ، أَعُودُ أَمْ عَلَيَّ شَيْءٌ ؟ , قَالَ : لا ""","","","","","Book of Purification"
"471","عَنْ مَعْمَرٍ ، عَنْ حَمَّادٍ , قَالَ : إِذَا أَفَاقَ الْمَجْنُونُ , تَوَضَّأَ وُضُوءَهُ لِلصَّلاةِ ""","","","","","Book of Purification"
"472","عَنْ هِشَامٍ ، عَنِ الْحَسَنِ , قَالَ : إِذَا أَفَاقَ الْمَجْنُونُ اغْتَسَلَ ""","","","","","Book of Purification"
"473","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :رَجُلٌ أَطْلَى بِنَوْرَةٍ , هَلْ عَلَيْهِ وُضُوءٌ ؟ , قَالَ :  أَوَ لَيْسَ مُغْتَسِلا ؟ "" , قَالَ : "" وَلا بُدَّ لَهُ أَنْ يَمَسَّ ذَكَرَهُ "" , هُوَ الْقَائِلُ , قَالَ : قُلْتُ : فَطَلَى سَاقَيْهِ مِنْ وَجَعٍ بِهِمَا وَهُوَ مُتَوَضِّئٌ , أَيُعِيدُ الْوُضُوءَ ؟ , قَالَ : "" لَيْسَتِ النَّوْرَةُ بِحَدَثٍ ""","","","","","Book of Purification"
"474","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، أَنَّ ابْنَ عُمَرَ ، كَانَ يَقُولُ : مَنْ قَبَّلَ امْرَأَتَهُ وَهُوَ عَلَى وُضُوءٍ , أَعَادَ الْوُضُوءَ ""","","","","","Book of Purification"
"475","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّهُسُئِلَ عَنِ الْقُبْلَةِ , قَالَ :  مِنْهَا الْوُضُوءُ , وَهِيَ مِنَ اللَّمْسِ ""","","","","","Book of Purification"
"476","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ نَافِعٍ , قَالَ : كَانَ ابْنُ عُمَرَ يَخْرُجُ إِلَى الصَّلاةِ ، وَقَدْ تَوَضَّأَ فَيَلْقَى بَعْضَ وَلَدِهِ فَيُقَبِّلُهُ ، ثُمَّ يَدْعُو بِمَاءٍ فَيُمَصْمِصُ ، وَلا يَزِيدُ عَلَى ذَلِكَ "", قَالَ مَعْمَرٌ : "" الْمَصْمَصَةُ دُونَ الْمَضْمَضَةِ ""","","","","","Book of Purification"
"477","عَنْ مَعْمَرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، عَنْ أَبِي عُبَيْدَةَ ، أَنَّ ابْنَ مَسْعُودٍ , قَالَ : يَتَوَضَّأُ الرَّجُلُ مِنَ الْمُبَاشَرَةِ ، وَمِنَ اللَّمْسِ بِيَدِهِ ، وَمِنَ الْقُبْلَةِ إِذَا قَبَّلَ امْرَأَتَهُ "" ، وَكَانَ يَقُولُ فِي هَذِهِ الآيَةِ :  أَوْ لامَسْتُمُ النِّسَاءَ "" , قَالَ : "" هُوَ الْغَمْزُ ""","","","","","Book of Purification"
"478","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ , قَالَ : سَمِعْتُ أَبَا عُبَيْدَةَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : قَالَ ابْنُ مَسْعُودٍ : الْقُبْلَةُ مِنَ اللَّمْسِ , وَمِنْهَا الْوُضُوءُ ""","","","","","Book of Purification"
"479","عَنِ الثَّوْرِيِّ ، عَنْ مُحِلٍّ ، عَنْ إِبْرَاهِيمَ , قَالَ : إِذَا قَبَّلَ الرَّجُلُ بِشَهْوَةٍ ، أَوْ لَمَسَ بِشَهْوَةٍ فَعَلَيْهِ الْوُضُوءُ ""","","","","","Book of Purification"
"480","عَنِ الثَّوْرِيِّ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِيِّ , قَالَ : إِذَا قَبَّلَ فَعَلَيْهِ الْوُضُوءُ ""","","","","","Book of Purification"
"481","عَنْ هِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ عُبَيْدَةَ , قَالَ : الْمُلامَسَةُ بِالْيَدِ "" , قَالَ : "" وَمِنْهَا الْوُضُوءُ , وَالتَّيَمُّمُ إِذَا لَمْ يَجِدْ مَاءً ""، عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عُبَيْدَةَ , مِثْلَهُ , قَالَ مَعْمَرٌ : وَكَانَ قَتَادَةُ , يَقُولُ : "" الْوُضُوءُ مِنَ الْقُبْلَةِ "" , حَسِبْتُهُ ذَكَرَهُ , عَنِ ابْنِ الْمُسَيِّبِ""","","","","","Book of Purification"
"482","عَنِ ابْنِ مُجَاهِدٍ ، عَنْ أَبِيهِ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : مَا أُبَالِي قَبَّلْتُهَا , أَوْ شَمَمْتُ رَيْحَانًا ""","","","","","Book of Purification"
"483","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، أَنَّ عُبَيْدَ بْنَ عُمَيْرٍ ، وَسَعِيدَ بْنَ جُبَيْرٍ ، وَعَطَاءَ بْنَ أَبِي رَبَاحٍ ،اخْتَلَفُوا فِي الْمُلامَسَةِ ، قَالَ سَعِيدٌ , وَعَطَاءٌ : هُوَ اللَّمْسُ وَالْغَمْزُ , وَقَالَ عُبَيْدُ بْنُ عُمَيْرٍ : هُوَ النِّكَاحُ , فَخَرَجَ عَلَيْهِمُ ابْنُ عَبَّاسٍ وَهُمْ كَذَلِكَ فَسَأَلُوهُ ، وَأَخْبَرُوهُ بِمَا , قَالُوا : فَقَالَ :  أَخْطَأَ الْمَوْلِيَانِ ، وَأَصَابَ الْعَرَبِيُّ ، وَهُوَ الْجِمَاعُ ، وَلَكِنَّ اللَّهَ يَعِفُّ وَيَكْنِي ""","","","","","Book of Purification"
"484","عَنِ ابْنِ مُجَاهِدٍ ، قَالَ : حُدِّثْتُ عَنْ مُجَاهِدٍ , قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : مَا أُبَالِي قَبَّلْتُهَا , أَوْ شَمَمْتُ رَيْحَانًا ""","","","","","Book of Purification"
"485","قَالَ : وَكَانَ ابْنُ سَعِيدٍ ، وَابْنُ الْمُسَيِّبِ ، يَقُولانِ : مِنَ الْقُبْلَةِ الْوُضُوءُ ""","","","","","Book of Purification"
"486","عَنِ ابْنِ جُرَيْجٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ  خَرَجَ إِلَى الصَّلاةِفَقَبَّلَتْهُ امْرَأَتُهُ فَصَلَّى , وَلَمْ يَتَوَضَّأْ ""","","","","","Book of Purification"
"487","عَنِ الأَوْزَاعِيِّ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ شُعَيْبٍ ، عَنِ امْرَأَةٍ سَمَّاهَا أَنَّهَا ، سَمِعَتْ عَائِشَةَ ، تَقُولُ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَتَوَضَّأُ ، وَكَانَيَخْرُجُ إِلَى الصَّلاةِ فَيُقَبِّلُنِي ، ثُمَّ يُصَلِّي , فَمَا يُحْدِثُ وُضُوءًا ""","","","","","Book of Purification"
"488","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ، عَنْ مَعْبَدِ بْنِ بُنَانَةَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ ، عَنْ عَائِشَةَ , قَالَتْ : قَبَّلَنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ صَلَّى , وَلَمْ يُحْدِثْ وُضُوءًا ""","","","","","Book of Purification"
"489","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي رَوْقٍ ، عَنْ إِبْرَاهِيمَ التَّيْمِيِّ ، عَنْ عَائِشَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ  كَانَيُقَبِّلُ بَعْدَ الْوُضُوءِ ، وَلا يُعِيدُ , أَوْ قَالَتْ : ثُمَّ يُصَلِّي ""","","","","","Book of Purification"
"490","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُمَرَ ، أَنَّ عَاتِكَةَ بِنْتَ زَيْدٍ قَبَّلَتْ عُمَرَ بْنَ الْخَطَّابِ وَهُوَ صَائِمٌ ، فَلَمْ يَنْهَهَا , قَالَ : وَهُوَ يُرِيدُ الصَّلاةَ ، ثُمَّ مَضَى فَصَلَّى , وَلَمْ يَتَوَضَّأْ ""","","","","","Book of Purification"
"491","عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ عُبَيْدٍ ، عَنِ الْحَسَنِ , قَالَ : لَيْسَ فِي الْقُبْلَةِ وُضُوءٌ ""","","","","","Book of Purification"
"492","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَبْدِ الْكَرِيمِ ، أَنَّهُ سَمِعَ الْحَسَنَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،وَهُوَ جَالِسٌ فِي الْمَسْجِدِ فِي الصَّلاةِ :  فَقَبَضَ عَلَى قَدَمِ عَائِشَةَ غَيْرَ مُتَلَذِّذٍ ""","","","","","Book of Purification"
"493","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِنَّمَا هِيَ رَيْحَانَتُكَ ""","","","","","Book of Purification"
"494","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : إِنْ قَاءَ إِنْسَانٌ , أوِ اسْتَقَاءَ ، فَقَدْ وَجَبَ عَلَيْهِ الْوُضُوءُ ، وَإِنْ قَلَسَ , فَقَدْ وَجَبَ عَلَيْهِ الْوُضُوءُ ""","","","","","Book of Purification"
"495","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْقَلَسَ رَجُلٌ فَبَلَغَ صَدْرَهُ , أَوْ حَلْقَهِ , وَلَمْ يَبْلُغِ الْفَمَ ؟ قَالَ :  فَلا وُضُوءَ عَلَيْهِ "" ، قُلْتُ : أَرَأَيْتَ إِنْ بَلَغَ الْحَلْقَ فَلَمْ يَمُجَّهَا وَأَعَادَهَا فِي جَوْفِهِ ؟ , قَالَ : "" فَقَدْ وَجَبَ الْوُضُوءُ إِذَا بَلَغَتِ الْفَمَ فَظَهَرَتْ "" ، قُلْتُ : أَتَكْرَهُ أَنْ يُعِيدَهَا الْمَرْءُ فِي جَوْفِهِ بَعْدَ مَا يَظْهَرُ بِفِيهِ ؟ , قَالَ : "" نَعَمْ ، وَلا أَكْرَهُهُ لِمَأْثَمٍ ، وَلَكِنْ أُقَذِّرُهُ ""","","","","","Book of Purification"
"496","قَالَ : قُلْتُ لِعَطَاءٍ :  أَرَأَيْتَ إِنْتَجَشَّأْتُ ، فَخَرَجَ شَيْءٌ مِنَ الطَّعَامِ مِنْ حَلْقِي وَكَانَ نَشَبَ فِي حَلْقِي وَلَيْسَ مِنْ مَعِدَتِي أَتَوَضَّأُ مِنْهُ ؟ قَالَ : "" لا "" ، قُلْتُ : أَرَأَيْتَ لَوْ تَجَشَّيْتُ , فَجَاءَ مِنَ الأَوْدَاجِ وَالطَّعَامِ شَيْءٌ يَسِيرٌ ؟ , قَالَ : "" لَعَمْرِي إِنِّي لأَتَنَخَّمُ شَيْئًا كَثِيرًا ، ثُمَّ يَأْتِي الشَّيْءُ مِنْ حَلْقِي وَمِنَ الرَّأْسِ ، فَلَيْسَ فِي ذَلِكَ وُضُوءٌ , إِلا مَا خَرَجَ مِنْ جَوْفِكَ مِنْ مَعِدَتِكَ ""","","","","","Book of Purification"
"497","عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُسٍ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ , قَالَ : إِذَا بَلَغَ الْقَلَسُ الْفَمَ فَقَدْ وَجَبَ فِيهِ الْوُضُوءُ ، فَإِنْ كَانَتْ يَابِسَةً يَجِدُهَا فِي حَلْقِهِ , لَمْ يَتَوَضَّأْ مِنْهَا ""، عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ ، مِثْلَ ذَلِكَ""","","","","","Book of Purification"
"498","قَالَ الثَّوْرِيُّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ :  إِنَّالْقَلَسَ إِذَا دُسِعَ , فَلْيَتَوَضَّأْ ""","","","","","Book of Purification"
"499","عَنِ ابْنِ مُجَاهِدٍ ، عَنْ أَبِيهِ , قَالَ : إِذَا ظَهَرَ عَلَى اللِّسَانِ قَلِيلُهُ , أَوْ كَثِيرُهُ ، فَفِيهِ الْوُضُوءُ ""","","","","","Book of Purification"
"500","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ لَيْثٍ ، عَنْ طَاوُسٍ ، وَمُجَاهِدٍ ، قَالا : لَيْسَ فِي الْقَلَسِ وُضُوءٌ ""","","","","","Book of Purification"
"501","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ , قَالَ : لَيْسَ فِي الْقَلَسِ وُضُوءٌ ""","","","","","Book of Purification"
"502","عَنِ ابْنِ جُرَيْجٍ ، عَنْ أَبِيهِ ، يَرْفَعُهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : الْوُضُوءُ مِنَ الْقَيْءِ , وَإِنْ كَانَ قَلَسًا يَغْلِبُهُ , فَلْيَتَوَضَّأْ ""","","","","","Book of Purification"
"503","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ يَعِيشَ بْنِ الْوَلِيدِ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنْ أَبِي الدَّرْدَاءِ , قَالَ : اسْتَقَاءَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَأَفْطَرَ , وَأُتِيَ بِمَاءٍ فَتَوَضَّأَ ""","","","","","Book of Purification"
"504","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :قَطْرَةٌ خَرَجَتُ مِنَ الْبَوْلِ ؟ , قَالَ :  تَوَضَّأْ مِنْهَا , هِيَ حَدَثٌ ""","","","","","Book of Purification"
"505","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : تَوَضَّأْ مِنْ كُلِّ حَدَثٍ مِنَ الْبَوْلِ ، وَالْخَلاءِ ، وَالْفُسَاءِ ، وَالضُّرَاطِ ، وَمِنْ كُلِّ حَدَثٍ يَخْرُجُ مِنَ الإِنْسَانِ ""","","","","","Book of Purification"
"506","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ عَنْ يعلى بْنِ سَيَّابَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ فَسَا , أَوْ ضَرَطَ , فَلْيُعِدِ الْوُضُوءَ ""","","","","","Book of Purification"
"507","أَخْبَرَنَا مَعْمَرٌ ، عَنْ عَاصِمِ بْنِ سُلَيْمَانَ ، عَنْ مُسْلِمِ بْنِ سَلامٍ ، عَنْ عِيسَى بْنِ حِطَّانَ ، عَنْ قَيْسِ بْنِ طَلْقٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : إِذَا فَسَا أَحَدُكُمْ , أَوْ ضَرَطَ , فَلْيَتَوَضَّأْ ، فَإِنَّ اللَّهَ لا يَسْتَحْيِي مِنَ الْحَقِّ ""","","","","","Book of Purification"
"508","عَنْ مَعْمَرٍ ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَقْبَلُ اللَّهُ صَلاةَ مَنْ أَحْدَثَ حَتَّى يَتَوَضَّأَ "", قَالَ : فَقَالَ لَهُ رَجُلٌ مِنْ أَهْلِ حَضْرَمَوْتَ : مَا الْحَدَثُ يَا أَبَا هُرَيْرَةَ ؟ , قَالَ : "" فُسَاءٌ , أَوْ ضُرَاطٌ ""","","","","","Book of Purification"
"509","عَنْ عَبْدِ الرَّحْمَنِ بْنِ عُمَرَ ، وَالأَوْزَاعِيِّ ، عَنْ وَاصِلٍ ، عَنْ مُجَاهِدٍ , قَالَ : وَجَدَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، رِيحًا وَمَعَهُ أَصْحَابُهُ ، فَقَالَ : مِمَّنْ خَرَجَتْ هَذِهِ الرِّيحُ , فَلْيَتَوَضَّأْ ""، فَاسْتَحْيَا صَاحِبُهَا وَلَمْ يَقُمْ , حَتَّى قَالَهَا ثَلاثًا ، فَلَمْ يَقُمْ أَحَدٌ ، فَقَالَ الْعَبَّاسُ بْنُ عَبْدِ الْمُطَّلِبِ : يَا رَسُولَ اللَّهِ ، أَلا نَتَوَضَّأُ كُلُّنَا ؟""","","","","","Book of Purification"
"510","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا أَحْدَثَ أَحَدُكُمْ فِي الصَّلاةِ فَلْيُمْسِكْ عَلَى أَنْفِهِ ، ثُمَّ لِيَنْصَرِفْ ""","","","","","Book of Purification"
"511","أَخْبَرَنَا مَعْمَرٌ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ قَالَ : أَخْبَرَنِي عِيَاضُ بْنُ هِلالٍ ، أَنَّهُ سَمِعَ أَبَا سَعِيدٍ الْخُدْرِيَّ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا شَبَّهَ عَلَى أَحَدِكُمُ الشَّيْطَانُ وَهُوَ فِي صَلاتِهِ , فَقَالَ : أَحْدَثْتَ ، فَلْيَقُلْ فِي نَفْسِهِ : كَذَبْتَ ، حَتَّى يَسْمَعَ صَوْتًا بِأُذُنِهِ ، أَوْ يَجِدَ رِيحًا بِأَنْفِهِ ، وَإِذَا صَلَّى أَحَدُكُمْ فَلَمْ يَدْرِ أَزَادَ أَمْ نَقَصَ , فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ ""","","","","","Book of Purification"
"512","عَنِ الزُّهْرِيِّ ، عَنِ ابْنِ الْمُسَيِّبِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، سُئِلَ عَنِالرَّجُلِ يَشْتَبِهُ فِي صَلاتِهِ , قَالَ :  لا يَنْصَرِفُ إِلا أَنْ يَجِدَ رِيحًا ، أَوْ يَسْمَعَ صَوْتًا ""","","","","","Book of Purification"
"513","عَنْ أَبِي بَكْرِ بْنِ عَبْدِ اللَّهِ ، أَنَّ عَبْدَ اللَّهِ بْنَ مُحَمَّدٍ مَوْلَى أَسْلَمَ حَدَّثَهُ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ جَاءَهُ رَجُلٌ , فَقَالَ لَهُ : إِنَّهُ يُخَيَّلُ إِلَيَّ إِذَا كُنْتُ أُصَلِّي أَنَّهُ يَخْرُجُ مِنْ إِحْلِيلِي الشَّيْءُ ، أَوْ يَخْرُجُ مِنِّي الرِّيحُ أَفَأَقْطَعُ صَلاتِي ؟ , قَالَ :  لا ، إِنَّمَاذَلِكَ مِنَ الشَّيْطَانِ ، يَدْخُلُ فِي إِحْلِيلِ أَحَدِكُمْ حَتَّى يُخَيَّلَ إِلَيْهِ أَنَّهُ يَخْرُجُ مِنْهُ الرِّيحُ ، فَإِذَا وَجَدَ أَحَدُكُمْ ذَلِكَ فَلا يَقْطَعْ صَلاتَهُ حَتَّى يَجِدَ بَلَلا ، أَوْ رِيحًا ، أَوْ يَسْمَعَ صَوْتًا ""","","","","","Book of Purification"
"514","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْهَالِ بْنِ عَمْرٍو ، عَنْ قَيْسِ بْنِ الْسَكَنِ , قَالَ : قَالَ ابْنُ مَسْعُودٍ  إِنَّالشَّيْطَانَ لَيَطِيفُ بِالرَّجُلِ فِي صَلاتِهِ لِيَقْطَعَ عَلَيْهِ صَلاتَهُ ، فَإِذَا أَعْيَاهُ نَفَخَ فِي دُبُرِهِ ، فَإِذَا أَحَسَّ أَحَدُكُمْ فَلا يَنْصَرِفَنَّ حَتَّى يَجِدَ رِيحًا , أَوْ يَسْمَعَ صَوْتًا ""","","","","","Book of Purification"
"515","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ عَبْدُ اللَّهِ  إِنَّالشَّيْطَانَ لَيَنْفُخُ فِي دُبُرِ الرَّجُلِ ، فَإِذَا أَحَسَّ أَحَدُكُمْ ذَلِكَ , فَلا يَنْصَرِفْ حَتَّى يَسْمَعَ صَوْتًا , أَوْ يَجِدَ رِيحًا ""","","","","","Book of Purification"
"516","عَنِ الثَّوْرِيِّ ، عَنِ الْمُغِيرَةِ ، عَنْ إِبْرَاهِيمَ , قَالَ :  يُقَالُ إِنَّالشَّيْطَانَ يَجْرِي فِي الإِحْلِيلِ وَيَعَضُّ فِي الدُّبُرِ ، فَإِذَا أَحَسَّ أَحَدُكُمْ مِنْ ذَلِكَ شَيْئًا , فَلا يَنْصَرِفْ حَتَّى يَسْمَعَ صَوْتًا ، أَوْ يَجِدَ رِيحًا ""","","","","","Book of Purification"
"517","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ شَكَكْتُ أَكُونُ أَحْدَثْتُ ؟ , قَالَ : فَلا تَقُمْ لِلصَّلاةِ إِلا بِيَقِينٍ ""","","","","","Book of Purification"
"518","عَنْ مَعْمَرٍ ، عَمَّنْ سَمِعَ الْحَسَنَ , يَقُولُ : إِذَا شَكَكْتَ فِي الْوُضُوءِ قَبْلَ الصَّلاةِ فَتَوَضَّأْ ، وَإِذَا شَكَكْتَ وَأَنْتَ فِي الصَّلاةِ , أَوْ بَعْدَ الصَّلاةِ , فَلا تُعِدْ تِلْكَ الصَّلاةَ ""","","","","","Book of Purification"
"519","عَنْ هُشَيْمٍ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : إِذَا شَكَكْتَ فِي الْوُضُوءِ قَبْلَ أَنْ تَدْخُلَ الصَّلاةَ فَتَوَضَّأْ ، وَإِذَا شَكَكْتَ وَأَنْتَ فِي الصَّلاةِ فَامْضِ ""","","","","","Book of Purification"
"520","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ بْنِ خَيْثَمَةَ ، شَكَا إِلَى إِبْرَاهِيمَ النَّخَعِيِّ ،إِذَا شَكَّ فِي الْوُضُوءِ , يَقُولُ :  وَسْوَسَةً لَمْ تَمْسَحْ بِرَأْسِكَ ، لَمْ تَغْسِلْ كَذَا , قَالَ : "" ذَلِكَ مِنَ الشَّيْطَانِ يَمْضِي "" ، وَقَالَ الثَّوْرِيُّ : وَكَانَ يُقَالُ : "" إِذَا ابْتَدَأَ ذَلِكَ أَنْ يُعِيدَ , فَإِذَا جَعَلَهُ يَكْثُرُ عَلَيْهِ , فَلا يُعِيدُ الْوُضُوءَ وَالصَّلاةَ ""","","","","","Book of Purification"
"521","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ : وَالْقَيْحُ , وَالدَّمُ سَوَاءٌ ""","","","","","Book of Purification"
"522","عَنِ ابْنِ مُجَاهِدٍ ، عَنْ أَبِيهِ , قَالَ : تَوَضَّأْ مِنَ الْقَيْحِ ، وَالدَّكَرِ , وَالدَّمِ "", وَذَكَرَ خَصْلَتَيْنِ لَمْ أَذْكُرْهُمَا""","","","","","Book of Purification"
"523","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ فِي الشَّجَّةِ تَكُونُ بِالرَّجُلِ , قَالَ : إِنْ سَالَ الدَّمُ فَلْيَتَوَضَّأْ ، وَإِنْ ظَهَرَ وَلَمْ يَسِلْ ، فَلا وُضُوءَ عَلَيْهِ ""","","","","","Book of Purification"
"524","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : تَوَضَّأْ مِنْ كُلِّ دَمٍ خَرَجَ ، فَسَالَ وَقَيْحٍ وَدُمَّلٍ ، أَوْ نِفْطَةٍ يَسِيرَةٍ إِذَا خَرَجَ فَسَالَ , فِيهِ الْوُضُوءُ "" , قَالَ : "" وَإِنْ نَزَعْتَ سِنًّا فَسَالَ مَعَهَا دَمٌ , فَتَوَضَّأْ ""","","","","","Book of Purification"
"525","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ , قَالَ : سَأَلْتُ إِبْرَاهِيمَ ، وَمُجَاهِدًا , قَالَ : قُلْتُ :جَزَزْتُ يَدَيَّ فَظَهَرَ الدَّمُ وَلَمْ يَسِلْ ، قَالَ مُجَاهِدٌ :  تَوَضَّأْ "" ، قَالَ إِبْرَاهِيمُ : "" حَتَّى يَسِيلَ ""","","","","","Book of Purification"
"526","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ أَبِي نَجِيحٍ , قَالَ : سَأَلْتُ عَطَاءً ، وَمُجَاهِدًا ، عَنِالْجُرْحِ يَكُونُ فِي يَدِ الإِنْسَانِ , فَيَكُونُ فِيهِ دَمٌ يَظْهَرُ وَلا يَسِيلُ ، قَالَ مُجَاهِدٌ :  يَتَوَضَّأُ "" ، وَقَالَ عَطَاءٌ : "" حَتَّى يَسِيلَ ""","","","","","Book of Purification"
"527","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ فِي الرَّجُلِ يَخْرُجُ مِنْهُ الْقَيْحُ وَالدَّمُ ، فَقَالَ : يَتَوَضَّأُ مِنْ كُلِّ دَمٍ أَوْ قَيْحٍ سَالَ أَوْ قَطَرَ "", عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ ، يَقُولُ مِثْلَ ذَلِكَ فِي الدَّمِ , وَكَانَ لا يَرَى الْقَيْحَ مِثْلَ الدَّمِ""","","","","","Book of Purification"
"528","عَنْ مَعْمَرٍ ، عَنْ حُمَيْدٍ الطَّوِيلِ , قَالَ : سَأَلْتُ سَعِيدَ بْنَ جُبَيْرٍ ، عَنْبُثْرَةٍ كَانَتْ فِي وَجْهِي , فَعَصَرْتُهَا فَخَرَجَ مِنْهَا دَمٌ ، فَفَتَتُّهُ بِأُصْبُعِي , قَالَ :  لَيْسَ فِيهَا وُضُوءٌ ""","","","","","Book of Purification"
"529","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنِ ابْنِ أَبِي نَجِيحٍ ، عَنْ مُجَاهِدٍ , قَالَ : الْقَيْحُ , وَالدَّمُ سَوَاءٌ ""","","","","","Book of Purification"
"530","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، وَحُمَيْدٍ الطَّوِيلِ قَالا : حَدَّثَنَا بَكْرُ بْنُ عَبْدِ اللَّهِ الْمُزَنِيُّ ، أَنَّهُ رَأَى ابْنَ عُمَرَ عَصَرَ بُثْرَةً بَيْنَ عَيْنَيْهِ , فَخَرَجَ مِنْهَا شَيْءٌ فَفَتَّهُ بَيْنَ إِصْبَعَيْهِ ، ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ ""","","","","","Book of Purification"
"531","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ , قَالَ : ذَهَبْتُ أَمْسَحُ بِالْحَجَرِ قَالَ : فَلا أَعْلَمُ إِلا أَنَّ أَيُّوبَ , قَالَ :لَقِيَنِي بِظُفْرِهِ فَجَرَحَ يَدَيَّ جُرْحًا فَخَرَجَ مِنْهَا مِنَ الدَّمِ قَدْرُ مَا وَارَى الْجُرْحَ ، فَقُلْتُ لِطَاوُسٍ : مَا تَرَى أَغْسِلُهُ ؟ قَالَ :  اغْسِلْهُ إِنْ شِئْتَ "" ، ثُمَّ قَالَ : "" مَا أُرَاهُ إِلا قَلِيلا فَاتْرُكْهُ يَيْبَسُ ""","","","","","Book of Purification"
"532","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أُدْخِلُ إِصْبَعِي فِي أَنْفِي فَتَخْرُجُ مُخَضَّبَةً بِالدَّمِ ؟ , قَالَ : فَلا تَتَوَضَّأْ ، وَلَكِنِ اغْسِلْ عَنْكَ الدَّمَ , وَاغْسِلْ أَصَابِعَكَ وَاسْتَنْثِرْ "" , قَالَ : "" وَإِنْ أَدْخَلْتَ إِصْبَعَكَ فِي أَنْفِكَ وَأَنْتَ فِي الصَّلاةِ فَخَرَجَ فِي إِصْبَعِكَ دَمٌ , فَلا تَنْصَرِفْ ، وَامْسَحْ أَصَابِعَكَ بِالتُّرَابِ وَحَسْبُكَ ""","","","","","Book of Purification"
"533","عَنْ مَعْمَرٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ , قَالَ : أَخْبَرَنِي مَيْمُونُ بْنُ مِهْرَانَ , قَالَ : رَأَيْتُ أَبَا هُرَيْرَةَ أَدْخَلَ إِصْبَعَهُ فِي أَنْفِهِ , فَخَرَجَتْ مُخَضَّبَةً دَمًا فَفَتَّهُ ، ثُمَّ صَلَّى فَلَمْ يَتَوَضَّأْ ""","","","","","Book of Purification"
"534","عَنْ مَعْمَرٍ ، عَنْ أَبِي الزِّنَادِ , قَالَ : رَأَيْتُ ابْنَ الْمُسَيِّبِ أَدْخَلَ أَصَابِعَهُ فِي أَنْفِهِ ، فَخَرَجَتْ مُخَضَّبَةً دَمًا فَفَتَّهُ ، ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ "", قَالَ : وَأَشَارَ مَعْمَرٌ كَيْفَ فَتَّهُ فَوَضَعَ إِبَهَامَهُ عَلَى السَّبَّابَةِ ، ثُمَّ فَتَّ""","","","","","Book of Purification"
"535","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ فِيالْمَاءِ يَخْرُجُ مِنَ الْجُرْحِ , قَالَ :  لَيْسَ فِيهِ شَيْءٌ "" , قَالَ : قُلْتُ : وَإِنْ كَانَ فِي الْمَاءِ صُفْرَةٌ ؟ ، قَالا : "" فَلا وُضُوءَ مِنْ مَاءٍ ""","","","","","Book of Purification"
"536","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : لا وُضُوءَ مِنْ دَمْعِ عَيْنٍ ، وَلا مِمَّا سَالَ مِنَ الأَنْفِ ""","","","","","Book of Purification"
"537","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ , فِيالرَّجُلِ يَبْصُقُ دَمًا , قَالَ :  إِنْ كَانَ الْغَالِبُ عَلَيْهِ الدَّمُ تَوَضَّأَ ""","","","","","Book of Purification"
"538","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً ، عَمَّا يَخْرُجُ مِنَ الدَّمِ فِي الْفَمِ , قَالَ : إِذَا سَالَ فِي الْفَمِ فَفِيهِ الْوُضُوءُ ، وَإِنْ سَالَتِ اللِّثَةُ فِي الْفَمِ حَتَّى يَبْرُزَ , فَتَوَضَّأْ ""","","","","","Book of Purification"
"539","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ أَبِي الزِّنَادِ ، قَالَ : لَقَدْ رَأَيْتُ ابْنَ الْمُسَيِّبِ يُدْخِلُ أَصَابِعَهُ الْعَشْرَ فِي أَنْفِهِ ، فَتَخْرُجُ مُخَضَّبَةً بِالدَّمِ فَيَفُتُّهُ ، ثُمَّ يُصَلِّي , وَلا يَتَوَضَّأُ ""","","","","","Book of Purification"
"540","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :الرَّجُلُ يَتَنَخَّمُ دَمًا ، هَلْ عَلَيْهِ الْوُضُوءُ ؟ قَالَ :  لا ، قُلْتُ : أَيُمَضْمِضُ ؟ , قَالَ : "" لا ، إِنْ شَاءَ ""","","","","","Book of Purification"
"541","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :أُدْخِلُ عُودًا فِي فَمِي , فَيَخْرُجُ فِيهِ دَمٌ , قَالَ :  فَلا تُمَضْمِضْ ""","","","","","Book of Purification"
"542","عَنِ الثَّوْرِيِّ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ , قَالَ : بَصَقَ مُجَاهِدٌ دَمًا فَتَوَضَّأَ ""","","","","","Book of Purification"
"543","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :رَجُلٌ مَفْئُودٌ يَنْفُثُ دَمًا ، أَوْ مَصْدُورٌ يَنْهَرُ قَيْحًا , أَحَدَثٌ هُوَ ؟ , قَالَ :  لا ، وَلا وُضُوءَ عَلَيْهِ مِمَّا لَيْسَ بِطَعَامٍ ""","","","","","Book of Purification"
"544","عَنْ رَجُلٍ ، عَنْ مُحَمَّدِ بْنِ جَابِرٍ ، عَنْ أَبِي إِسْحَاقَ ، أَنَّ رَجُلا سَأَلَ عَلْقَمَةَ بْنَ قَيْسٍ , قَالَ :بَصَقْتُ دَمًا ؟ , قَالَ :  فَمَضْمِضْ ، وَتُصَلِّي ""","","","","","Book of Purification"
"545","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ :  إِنْسَالَ مِنَ اللِّثَةِ دَمٌ فِي الْفَمِ فَفِيهِ الْوُضُوءُ ، وَإِنْ نَزَعْتَ سِنًّا فَسَالَ مَعَهَا دَمٌ حَتَّى تَبْزُقَ فَفِيهِ الْوُضُوءُ ""، وَاللَّثَةُ : اللَّحْمُ الَّذِي فَوْقَ الأَسْنَانِ""","","","","","Book of Purification"
"546","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :بَصَقْتُ فِي الصَّلاةِ فَخَرَجَ دَمٌ فِي الْبُصَاقِ , قَالَ :  فَلا تُمَضْمِضْ إِنْ شِئْتَ ، إِنَّ الدِّينَ سَمْحٌ ، بَلَغَنِي أَنَّهُ كَانَ , يُقَالُ : اسْمَحُوا يُسْمَحْ لَكُمْ ""","","","","","Book of Purification"
"547","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ فِي الرَّجُلِ يَبْصُقُ دَمًا , قَالَ : إِذَا كَانَ الْغَالِبُ عَلَيْهِ الدَّمُ , تَوَضَّأْ ""","","","","","Book of Purification"
"548","عَنِ الثَّوْرِيِّ ، وَابْنِ عُيَيْنَةَ ، عَنْ عَطَاءِ بْنِ السَّائِبِ , قَالَ : رَأَيْتُ عَبْدَ اللَّهِ بْنَ أَبِي أَوْفَى بَصَقَ دَمًا ، ثُمَّ صَلَّى , وَلَمْ يَتَوَضَّأْ ""","","","","","Book of Purification"
"549","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ , قَالَ : يُتَوَضَّأُ مِنَ الرُّعَافِ , إِذَا ظَهَرَ فَسَالَ مِمَّا قَلَّ , أَوْ كَثُرَ ""","","","","","Book of Purification"
"550","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :رَجُلٌ أَخَذَهُ الرُّعَافُ فَلَمْ يَرْقَ عَنْهُ ، حَتَّى كَادَتِ الصَّلاةُ أَنْ تَفُوتَهُ كَيْفَ يَصْنَعُ ؟ قَالَ :  يَسُدُّ مِنْخَرَهُ فَيَقُومُ فَيُصَلِّي ، وَإِنْ خَافَ أَنْ يَدْخُلَ "" ، قُلْتُ : إِذًا يَقَعُ الدَّمُ فِي جَوْفِهِ ؟ , قَالَ : "" إِنَّهُ لا يَقَعُ فِي جَوْفِهِ ، وَلا بُدَّ مِنَ الصَّلاةِ ، وَإِنْ وَقَعَ فِي جَوْفِهِ ""","","","","","Book of Purification"
"551","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , قَالَ :  إِذَا رَعَفَ الإِنْسَانُ فَلَمْ يُقْلِعْ , فَإِنَّهُ يَسُدُّ مِنْخَرَهُ وَيُصَلِّي ، وَإِنْ خَافَ أَنْ يَدْخُلَ جَوْفَهُ فَلْيُصَلِّ ، وَإِنْ سَالَ "" , فَإِنَّ عُمَرَ "" قَدْصَلَّى وَجُرْحُهُ يَثْعَبُ دَمًا ""","","","","","Book of Purification"
"552","قَالَ مَعْمَرٌ : وَبَلَغَنِي عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : إِذَا لَمْ يَسْتَمْسِكْ رُعَافُهُ , أَوْمَأَ إِيمَاءً ""","","","","","Book of Purification"
"553","عَنْ مَعْمَرٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ عِكْرِمَةَ , قَالَ : إِنْ كَانَ لا يَسْتَمْسِكُ فِي الصَّلاةِ حَشَاهُ ""","","","","","Book of Purification"
"554","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : آنَسْتُ الدَّمَ فِي أَنْفِي وَأَنَا فِي الصَّلاةِ وَلَمْ يَخْرُجْ ، أَنْصَرِفُ ؟ قَالَ : "" لا "" ، قُلْتُ : فَآنَسْتُهُ فِي الْمِنْخَرِ قَبْلَ الصَّلاةِ وَلَمْ تَسِلْ ، أَسْتَنْثِرْ ؟ , قَالَ : "" إِنْ شِئْتَ وَهُوَ يَنْهَى عَنْ مَسِّ الأَنْفِ فِي الصَّلاةِ ""","","","","","Book of Purification"
"555","عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ , قَالَ : كَانَتْ بِي دَمَامِيلُ ، فَسَأَلْتُ أَبِي عَنْهَا , فَقَالَ :  إِنْ كَانَتْ تُرْقَأُ فَاغْسِلْهَا وَتَوَضَّأْ ، وَإِنْ كَانَتْ لا تُرْقَأُ فَتَوَضَّأْ وَصَلِّ ، فَإِنْ خَرَجَ شَيْءٌ فَلا تُبَالِ ، فَإِنَّ عُمَرَ قَدْصَلَّى وَجُرْحُهُ يَثْعَبُ دَمًا ""","","","","","Book of Purification"
"556","عَنِ الثَّوْرِيِّ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , قَالَ : حَدَّثَنِي سُلَيْمَانُ بْنُ يَسَارٍ ، أَنَّ الْمِسْوَرَ بْنَ مَخْرَمَةَ أَخْبَرَهُ ، قَالَ : دَخَلْتُ أَنَا , وَابْنُ عَبَّاسٍ عَلَى عُمَرَ حِينَ طُعِنَ , فَقُلْنَا : الصَّلاةُ , فَقَالَ :  إِنَّهُلا حَظَّ لأَحَدٍ فِي الإِسْلامِ أَضَاعَ الصَّلاةَ "" , فَصَلَّى وَجُرْحُهُ يَثْعَبُ دَمًا""","","","","","Book of Purification"
"557","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ ابْنَ أَبِي مُلَيْكَةَ ، دَخَلَ ابْنُ عَبَّاسٍ ، وَالْمِسْوَرُ بْنُ مَخْرَمَةَ عَلَى عُمَرَ حِينَ انْصَرَفَا مِنَ الصَّلاةِ بَعْدَمَا طُعِنَ , فَوَجَدَاهُ لَمْ يُصَلِّ الصُّبْحَ , فَقَالا : الصَّلاةُ ، فَقَالَ :  نَعَمْ ،مَنْ تَرَكَ الصَّلاةَ فَلا حَظَّ لَهُ فِي الإِسْلامِ "" ، فَتَوَضَّأَ , ثُمَّ صَلَّى وَجُرْحُهُ يَثْعَبُ دَمًا""","","","","","Book of Purification"
"558","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : لَمَّا طُعِنَ عُمَرُ احْتَمَلْتُهُ أَنَا وَنَفَرٌ مِنَ الأَنْصَارِ حَتَّى أَدْخَلْنَاهُ مَنْزِلَهُ , فَلَمْ يَزَلْ فِي غَشْيَةٍ وَاحِدَةٍ حَتَّى أَسْفَرَ ، فَقَالَ رَجُلٌ : إِنَّكُمْ لَنْ تُفْزِعُوهُ بِشَيْءٍ , إِلا بِالصَّلاةِ , قَالَ : فَقُلْنَا : الصَّلاةَ يَا أَمِيرَ الْمُؤْمِنِينَ ! قَالَ : فَفَتَحَ عَيْنَيْهِ ، ثُمَّ قَالَ :  أَصَلَّى النَّاسُ ؟ "" , قُلْنَا : نَعَمْ , قَالَ : "" أَمَا إِنَّهُلا حَظَّ فِي الإِسْلامِ لأَحَدٍ تَرَكَ الصَّلاةَ "" ، فَصَلَّى وَجُرْحُهُ يَثْعَبُ دَمًا""","","","","","Book of Purification"
"559","عَنْ مَعْمَرٍ ، عَنِ الزُّهْرِيِّ ، عَنْ خَارِجَةَ بْنِ زَيْدٍ , قَالَ : كَبِرَ زَيْدٌ حَتَّى سَلَسَ مِنْهُ الْبَوْلُ , فَكَانَ يُدَاوِيهِ مَا اسْتَطَاعَ ، فَإِذَا غَلَبَهُ تَوَضَّأَ ، ثُمَّ صَلَّى ""","","","","","Book of Purification"
"560","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ , وَغَيْرِهِ ، عَنِ ابْنِ عَبَّاسٍ , قَالَ : شَكَا إِلَيْهِ رَجُلٌ , فَقَالَ : إِنِّي أَكُونُ فِي الصَّلاةِ فَيُخَيَّلُ إِلَيَّ أَنَّ بِذَكَرِي بَلَلا , قَالَ : قَاتَلَ اللَّهُ الشَّيْطَانَ , إِنَّهُ يَمَسُّ ذَكَرَ الإِنْسَانِ فِي صَلاتِهِ لِيُرِيَهُ أَنَّهُ قَدْ أَحْدَثَ ، فَإِذَا تَوَضَّأتَ , فَانْضَحْ فَرْجَكَ بِالْمَاءِ ، فَإِنْ وَجَدْتَ , قُلْتُ : هُوَ مِنَ الْمَاءِ ""، فَفَعَلَ الرَّجُلُ ذَلِكَ , فَذَهَبَ""","","","","","Book of Purification"
"561","عَنْ عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ ، قَالَ : سَمِعْتُ سَعِيدَ بْنَ جُبَيْرٍ , قَالَ : وَسَأَلَهُ رَجُلٌ , فَقَالَ : إِنِّيأَلْقَى مِنَ الْبَوْلِ شِدَّةٌ إِذَا كَبَّرْتُ وَدَخَلْتُ فِي الصَّلاةِ وَجَدْتُهُ ، فَقَالَ سَعِيدٌ :  أَطِعْنِي افْعَلْ مَا آمُرُكَ خَمْسَةَ عَشَرَ يَوْمًا تَوَضَّأْ ، ثُمَّ ادْخُلْ فِي صَلاتِكَ , فَلا تَنْصَرِفَنَّ ""","","","","","Book of Purification"
"562","عَنْ دَاوُدَ بْنِ قَيْسٍ , قَالَ : سَأَلْتُ مُحَمَّدَ بْنَ كَعْبٍ الْقُرَظِيَّ , قُلْتُ : إِنِّي أَتَوَضَّأُ وَأَجِدُ بَلَلا , قَالَ : إِذَا تَوَضَّأتَ فَانْضَحْ فَرْجَكَ ، فَإِنْ جَاءَكَ , فَقُلْ : هُوَ مِنَ الْمَاءِ الَّذِي نَضَحْتُ ، فَإِنَّهُ لا يَتْرُكُكَ حَتَّى يَأْتِيَكَ وَيَحْرِجَكَ ""","","","","","Book of Purification"
"563","عَنْ مَعْمَرٍ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ ، عَنْ سُفْيَانَ بْنِ الْحَكَمِ ، أَوِ الْحَكَمِ بْنِ سُفْيَانَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،  كَانَإِذَا تَوَضَّأَ وَفَرَغَ ، أَخَذَ كَفًّا مِنْ مَاءٍ فَنَضَحَ بِهِ فَرْجَهُ ""","","","","","Book of Purification"
"564","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ ، عَنْ سُفْيَانَ بْنِ الْحَكَمِ ، أَوِ الْحَكَمِ بْنِ سُفْيَانَ الثَّقَفِيِّ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،  كَانَإِذَا بَالَ وَتَوَضَّأَ , نَضَحَ فَرْجَهُ ""","","","","","Book of Purification"
"565","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنْ نَافِعٍ , قَالَ : كَانَ ابْنُ عُمَرَ إِذَا تَوَضَّأَ لا يَغْسِلُ أَثَرَ الْبَوْلِ ، وَلَكِنَّهُ كَانَ يَنْضَحُ ""","","","","","Book of Purification"
"566","عَنِ الثَّوْرِيِّ ، عَنِ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ النَّخَعِيِّ ، عَنْ أَبِي الضُّحَى ، قَالَ : رَأَيْتُ ابْنَ عُمَرَ تَوَضَّأَ ، ثُمَّ نَضَحَ , حَتَّى رَأَيْتُ الْبَلَلَ مِنْ خَلْفِهِ فِي ثِيَابِهِ ""","","","","","Book of Purification"
"567","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ , قَالَ : سَمِعْتُ مُسْلِمَ بْنَ صُبَيْحٍ , يَقُولُ : رَأَيْتُ ابْنَ عُمَرَ تَوَضَّأَ ، ثُمَّ أَخَذَ غَرْفَةً مِنْ مَاءٍ فَصَبَّهَا بَيْنَ إِزَارِهِ وَبَطْنِهِ عَلَى فَرْجِهِ ""","","","","","Book of Purification"
"568","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنْ حُمَيْدِ بْنِ هِلالٍ ، أَنَّ حُذَيْفَةَ بْنَ الْيَمَانِ , قَالَ : إِذَا تَوَضَّأْتُ ، ثُمَّ خَرَجَ مِنِّي شَيْءٌ بَعْدَ ذَلِكَ ، فَإِنِّي لا أَعُدُّهُ بِهَذِهِ , أَوْ قَالَ : مِثْلَ هَذِهِ "" , وَوَضَعَ رِيقَهُ عَلَى إِصْبَعِهِ""","","","","","Book of Purification"
"569","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ أَبِيهِ ، أَنَّ حُذَيْفَةَ بْنَ الْيَمَانِ ، وَزَيْدَ بْنَ ثَابِتٍ ، وَالْحَسَنَ ، وَعَطَاءً ، كانوا لا يَرَوْنَ بَأْسًا بِالْبَلَلِ يَجِدُهُ الرَّجُلُ فِي الصَّلاةِ , مَا لَمْ يَقْطُرْ ""","","","","","Book of Purification"
"570","عَنْ مَعْمَرٍ , قَالَ : سَمِعْتُ عَبْدَ الْحَكَمِ بْنَ عَبْدِ اللَّهِ بْنِ أَبِي فَرْوَةَ , يَقُولُ : كَانَيُصِيبُنِّي فِي الصَّلاةِ ، وَإِنِّي لأَجِدُ الْبِلَّةَ ، وَيَخْرُجُ مِنِّي فِي الصَّلاةِ ، فَكُنْتُ أَنْصَرِفُ فِي السَّاعَةِ مِرَارًا وَأَتَوَضَّأُ ، فَسَأَلْتُ ابْنَ الْمُسَيِّبِ , فَقَالَ :  لا تَنْصَرِفْ "" , قَالَ : فَظَنَنْتُ أَنَّهُ يَظُنُّ أَنَّهُ إِنَّمَا يُشْبِهُ عَلَيَّ , قَالَ : قُلْتُ : إِنَّهُ أَكْثَرُ مِنْ ذَلِكَ إِنَّهُ يُصِيبُ قَدَمِي , أَوْ قَالَ : الأَرْضَ , قَالَ : "" لا تَنْصَرِفْ , فَإِذَا حَسَسْتَ ذَلِكَ فَتَلَقَّهُ بِثَوْبِكَ ""، فَقَالَ لِي أَخٌ كَانَ عِنْدَهُ جَالِسًا : أَتَدْرِي مَا قَالَ لَكَ ؟ , قَالَ : "" اغْسِلْ ثَوْبَكَ إِذَا فَرَغْتَ مِنْ صَلاتِكَ "" , وَلَمْ أَسْمَعْهُ أَنَا , قَالَ : فَفَعَلْتُ الَّذِي قَالَ : فَلَمْ أَلْبَثْ أَنْ ذَهَبَ عَنِّي""","","","","","Book of Purification"
"571","عَنْ مَعْمَرٍ ، عَنْ أَيُّوبَ ، عَنِ ابْنِ سِيرِينَ  أَنَّهُ كَانَيَرَى الْقَطْرَ حَدَثًا "", وَقَالَهُ الْحَسَنُ أَيْضًا""","","","","","Book of Purification"
"572","عَنْ مَعْمَرٍ , قَالَ : سَأَلَهُ رَجُلٌ , فَقَالَ : إِنِّيأَجِدُ الْبِلَّةَ وَأَنَا فِي الصَّلاةِ أَنْصَرِفُ ؟ قَالَ :  لا ، حَتَّى تَكُونَ قَطْرَةٌ أَحْسَبُهُ , قَالَ يَوْمَئِذٍ : هَلْ أَحَدٌ إِلا يَجِدُ الْبِلَّةَ ""","","","","","Book of Purification"
"573","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍوَجَدْتُ رِيبَةً مِنَ الْمَنِيِّ قَبْلَ الظُّهْرِ , فَلَمْ أَنْظُرْ إِلَيْهِ حَتَّى انْصَرَفْتُ مِنَ الْمَغْرِبِ ، فَوَجَدْتُ فِي طَرَفِ ذَكَرِي مَنِيًّا , قَالَ :  فَعُدْ لِصَلاتِكَ كُلِّهَا "" ، قُلْتُ : أَرَأَيْتَ إِنْ صَلَّيْتُ الظُّهْرَ , وَالْعَصْرَ , وَالْمَغْرِبَ ، ثُمَّ انْقَلَبْتُ ، فَإِذَا أَنَا أَجِدُ مَذْيًا وَلَمْ أُرَتِّبْ قَبْلَ ذَلِكَ وَلا بَعْدَهُ , قَالَ : "" فَلا تُعِدْهُ ، فَإِنَّكَ لَعَلَّكَ أَمْذَيْتَ بَعْدَ مَا صَلَّيْتَ "" ، قُلْتُ : جَامَعْتُ ، ثُمَّ رُحْتُ فَوَجَدْتُ رِيبَةً قَبْلَ الظُّهْرِ , فَلَمْ أَنْصَرِفْ حَتَّى انْقَلَبْتُ عِشَاءً , فَوَجَدْتُ مَذْيًا قَدْ يَبِسَ عَلَى طَرَفِ الإِحْلِيلِ ، فَتَعَشَّيْتُ وَلَمْ أَعْجَلْ عَنْ عَشَائِي ، ثُمَّ رُحْتُ إِلَى الْمَسْجِدِ فَصَلَّيْتُ الظُّهْرَ , وَالْعَصْرَ , وَالْمَغْرِبَ , يَقُولُ : "" أَعَدْتُهُنَّ , فَرَآنِي قَدْ أَصَبْتُ فِيمَا أَعَدْتُهُ ""","","","","","Book of Purification"
"574","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ قَيْسٌ لِعَطَاءٍ : أَرَأَيْتَ الْمَذْيَ أَكُنْتَ مَاسِحُهُ مَسْحًا , قَالَ : لا ، الْمَذْيُ أَشَدُّ مِنَ الْبَوْلِ ، يُغْسَلُ غَسْلا ، ثُمَّ أَنْشَأَ يُخْبِرُنَا حِينَئِذٍ , قَالَ : أَخْبَرَنِي عَائِشُ بْنُ أَنَسٍ أَخُو سَعْدِ بْنِ لَيْثٍ , قَالَ : تَذَاكَرَ عَلِيُّ بْنُ أَبِي طَالِبٍ , وَعَمَّارُ بْنُ يَاسِرٍ ، وَالْمِقْدَادُ بْنُ الأَسْوَدُ الْمَذْيَ ، فَقَالَ عَلِيٌّ : إِنِّي رَجُلٌ مَذَّاءٌ ، فَاسْأَلُوا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَنْ ذَلِكَ ، فَإِنِّي أَسْتَحِي أَنْ أَسْأَلَهُ عَنْ ذَلِكَ لِمَكَانِ ابْنَتِهِ مِنِّي ، لَوْلا مَكَانُ ابْنَتِهِ لَسَأَلْتُهُ ، فَقَالَ عَائِشُ : فَسَأَلَ أَحَدُ الرَّجُلَيْنِ عَمَّارٌ , أَوِ الْمِقْدَادُ ، قَالَ قَيْسٌ : فَسَمَّى لِي عَائِشٌ الَّذِي سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَنْ ذَلِكَ مِنْهُمَا ، فَنَسِيتُهُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : ذَلِكُمُ الْمَذْيُ ، إِذَا وَجَدَهُ أَحَدُكُمْ فَلْيَغْسِلْ ذَلِكَ مِنْهُ ، ثُمَّ لِيَتَوَضَّأْ , فَلْيُحْسِنْ وُضُوءَهُ ، ثُمَّ لِيَنْتَضِحْ فِي فَرْجِهِ "", قَالَ : فَسَأَلْتُ عَطَاءً ، عَنْ قَوْلِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَغْسِلُ ذَلِكَ مِنْهُ , قَالَ : حَيْثُ الْمَذْيُ يَغْسِلُ مِنْهُ , أَمْ ذَكَرَهُ كُلَّهُ ؟ , فَقَالَ : "" بَلْ حَيْثُ الْمَذْيُ مِنْهُ فَقَطُّ ""","","","","","Book of Purification"
"575","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ وَجَدْتُ مَذْيًا , فَغَسَلْتُ ذَكَرِي , أَنْضَحُ فِي ذَلِكَ فَرْجِي ؟ قَالَ : لا ، حَسْبُكَ ""","","","","","Book of Purification"
"576","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أُجَامِعُ أَهْلِي فَأَجِدُ مَذْيًا بَعْدَهُ , أَوْ عِنْدَهُ بَعْدَ جِمَاعٍ غَيْرِ جِمَاعٍ ، فَأَنْفِضُ ذَكَرِي ، وَأَغْتَسِلُ ، وَأَجِدُ قَبْلَ الظُّهْرِ رِيبَةً مِنْ رَطْبٍ ، فَإِنِّي أَجِدُ عَلَى فَخِذِي , وَعَلَى الأُنْثَيَيْنِ ، أَنْظُرُ هَلْ أَجِدُ شَيْئًا أَمْ لِي رُخْصَةٌ فِي أَنْ لا أَنْظُرَ ؟ فَقَالَ : إِنْ كُنْتَ مُمْذِيًا فَانْظُرْ ، وَإِنْ كُنْتَ غَيْرَ مُمْذٍ فَلا تَنْظُرْ ""","","","","","Book of Purification"
"577","عَنْ مَالِكٍ ، عَنْ أَبِي النَّضْرِ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، عَنِ الْمِقْدَادِ ، أَنَّ عَلِيًّا ، أَمَرَهُ أَنْ يَسْأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَنِالرَّجُلِ إِذَا دَنَا مِنِ امْرَأَتِهِ ، فَخَرَجَ مِنْهُ الْمَذْيُ مَاذَا عَلَيْهِ ؟ , فَإِنَّ عِنْدِي ابْنَتَهُ ، وَأَنَا أَسْتَحْيِي أَنْ أَسْأَلَهُ ، قَالَ الْمِقْدَادُ : فَسَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَنْ ذَلِكَ فَقَالَ :  إِذَا وَجَدَ أَحَدُكُمْ ذَلِكَ , فَلْيَنْضَحْ فَرْجَهُ , وَلْيَتَوَضَّأْ وُضُوءَهُ لِلصَّلاةِ ""","","","","","Book of Purification"
"578","عَنْ مَعْمَرٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ عَطَاءٍ ، عَنْ عَائِشِ بْنِ أَنَسٍ , قَالَ : قَالَ عَلِيٌّ لِلْمِقْدَادِ : سَلْ لِي رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، عَنِالرَّجُلِ يُلاعِبُ امْرَأَتَهُ وَيُكَلِّمُهَا فَيُمْذِي ، لَوْلا أَنِّي أَسْتَحْيِي وَأَنَّ ابْنَتَهُ تَحْتِي لَسَأَلْتُهُ ، فَسَأَلَ الْمِقْدَادُ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لِيَغْسِلْ ذَكَرَهُ ، وَلْيَتَوَضَّأْ ، ثُمَّ لِيَنْضَحْ فِي فَرْجِهِ ""","","","","","Book of Purification"
"579","عَنْ مَعْمَرٍ ، وَابْنِ جُرَيْجٍ ، قَالَ : حَدَّثَنَا هِشَامُ بْنُ عُرْوَةَ ، عَنْ عُرْوَةَ ، أَنَّ عَلِيًّا , قَالَ : قُلْتُ لِلْمِقْدَادِ : سَلْ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَإِنِّي لَوْلا أَنَّ تَحْتِي ابْنَتَهُ لَسَأَلْتُهُ عَنْ ذَلِكَ ، إِذَا مَا اقْتَرَبَ الرَّجُلُ مِنِ امْرَأَتِهُ فَأَمْذَى ، وَلَمْ يَمْلِكْ ذَلِكَ وَلَمْ يَمَسَّهَا , فَسَأَلَ الْمِقْدَادُ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا مَا أَمْذَى أَحَدُكُمْ وَلَمْ يَمَسَّهَا , فَلْيَغْسِلْ ذَكَرَهُ وَأُنْثَيَيْهِ "", وَكَانَ عُرْوَةُ , يَقُولُ : "" لِيَتَوَضَّأْ إِذَا أَرَادَ أَنْ يُصَلِّيَ كَوُضُوئِهِ لِلصَّلاةِ "" , عَنْ مَعْمَرٍ ، عَنْ هِشَامِ بْنِ عُرْوَةَ ، عَنْ أَبِيهِ , مِثْلَهُ""","","","","","Book of Purification"
"580","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ ، أَنَّ عَلِيًّا , قَالَ :كُنْتُ رَجُلا مَذَّاءً , فَاسْتَحْيَيْتُ أَنْ أَسْأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَأَمَرْتُ رَجُلا فَسَأَلَهُ , فَقَالَ :  فِيهِ الْوُضُوءُ "", قَالَ الأَعْمَشُ : فَحَدَّثَنَا أَبُو يَعْلَى ، عَنْ مُحَمَّدِ بْنِ الْحَنَفِيَّةِ ، أَنَّ عَلِيًّا , قَالَ : فَاسْتَحْيَيْتُ أَنْ أَسْأَلَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَتِ ابْنَتُهُ تَحْتِي , فَأَمَرْتُ الْمِقْدَادَ فَسَأَلَهُ , فَقَالَ : "" فِيهِ الْوُضُوءُ ""","","","","","Book of Purification"
"581","عَنْ مَعْمَرٍ ، وَابْنِ عُيَيْنَةَ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ أَبِيهِ , قَالَ : سَمِعْتُ عُمَرَ , يَقُولُ :  إِنَّهُلَيَخْرُجُ مِنْ أَحَدِنَا مِثْلُ الْجُمَانَةِ , فَإِذَا وَجَدَ أَحَدُكُمْ ذَلِكَ فَلْيَغْسِلْ ذَكَرَهُ , وَلْيَتَوَضَّأْ ""","","","","","Book of Purification"
"582","عَنِ الثَّوْرِيِّ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ أَبِيهِ ، عَنْ عُمَرَ فِي الْمَذْيِ يَغْسِلُ ذَكَرَهُ ، وَيَتَوَضَّأُ وُضُوءَهُ لِلصَّلاةِ ""","","","","","Book of Purification"
"583","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ ، عَنْ سُلَيْمَانَ بْنِ مُسْهِرٍ ، عَنْ خَرَشَةَ بْنِ الْحُرِّ ، أَنَّ عُثْمَانَ ،سُئِلَ عَنِ الْمَذْيِ ، فَقَالَ :  ذَاكُمُ الْقَطْرُ مِنْهُ الْوُضُوءُ ""","","","","","Book of Purification"
"584","عَنِ الثَّوْرِيِّ ، عَنْ زِيَادِ بْنِ فَيَّاضٍ , قَالَ : سَمِعْتُ سَعِيدَ بْنَ جُبَيْرٍ ، يَقُولُفِي الْمَذْيِ :  يَغْسِلُ حَشَفَتَهُ ""","","","","","Book of Purification"
"585","عَنْ إِبْرَاهِيمَ ، عَنْ أَبِي حَمْزَةَ مَوْلَى بَنِي أَسَدٍ , قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ , قَالَ : بَيْنَا أَنَا عَلَى رَاحِلَتِي بَيْنَ النَّائِمِ وَالْيَقْظَانِ أَخَذَتْ مِنِّي شَهْوَةٌ ، فَخَرَجَ مِنْ ذَكَرِي شَيْءٌ حَتَّى مَلأَ حَاذِي وَمَا حَوْلَهُ "" , فَقَالَ : "" اغْسِلْ ذَكَرَكَ ، وَمَا أَصَابَكَ ، ثُمَّ تَوَضَّأْ وُضُوءَكَ لِلصَّلاةِ ""","","","","","Book of Purification"
"586","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ فِي الْمَذْيِ , وَالْوَدْيِ , وَالْمَنِيّ : مِنَ الْمَنِيِّ الْغُسْلُ ، وَمِنَ الْمَذْيِ ، وَالْوَدْيِ الْوُضُوءُ يَغْسِلُ حَشَفَتَهُ , وَيَتَوَضَّأُ ""","","","","","Book of Purification"
"587","عَنْ مَعْمَرٍ ، عَمَّنْ سَمِعَ عِكْرِمَةَ , قَالَ : هِيَ ثَلاثَةٌ الْمَذْيُ ، وَالْوَدْيُ ، وَالْمَنِيُّ ، فَأَمَّا الْمَذْيُ : فَهُوَ الَّذِي يَكُونُ مَعَ الْبَوْلِ , وَبَعْدَهُ فِيهِ غَسْلُ الْفَرْجِ , وَالْوُضُوءُ أَيْضًا ، وَأَمَّا الْمَنِيُّ : فَهُوَ الْمَاءُ الدَّافِقُ الَّذِي يَكُونُ فِيهِ الشَّهْوَةُ ، وَمِنْهُ يَكُونُ الْوَلَدُ , فَفِيهِ الْغُسْلُ "", عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , مِثْلَهُ""","","","","","Book of Purification"
"588","عَنِ ابْنِ عُيَيْنَةَ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : إِنِّي لأَجِدُ الْمَذْيَ عَلَى فَخِذِي يَنْحَدِرُ وَأَنَا أُصَلِّي , فَمَا أُبَالِي ذَلِكَ ""","","","","","Book of Purification"
"589","قَالَ : وَقَالَ سَعِيدٌ : عَنْ عُمَرَ بْنِ الْخَطَّابِ إِنِّي لأَجِدُ الْمَذْيَ عَلَى فَخِذِي يَنْحَدِرُ وَأَنَا عَلَى الْمِنْبَرِ , مَا أُبَالِي ذَلِكَ ""","","","","","Book of Purification"
"590","عَنِ الثَّوْرِيِّ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ : سَمِعْتُهُ يَقُولُ : لَوْ سَالَ عَلَى فَخِذِي مَا انْصَرَفْتُ "", يَعْنِي : الْمَذْيَ""","","","","","Book of Purification"
"591","عَنِ ابْنِ عُيَيْنَةَ ، عَنِ ابْنِ عَجْلانَ , قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَنِ الأَعْرَجِ , يَقُولُ : قَالَ عُمَرُ وَهُوَ عَلَى الْمِنْبَرِ :  إِنَّهُلَيَنْحَدِرُ شَيْءٌ مِثْلُ الْجُمَانِ ، أَوْ مِثْلُ الْخَرَزَةِ , فَمَا أُبَالِيهِ ""","","","","","Book of Purification"
"592","أَخْبَرَنَا أَبُو سَعِيدٍ أَحْمَدُ بْنُ مُحَمَّدِ بْنِ زِيَادِ بْنِ بِشْرٍ , بِمَكَّةَ ، قَالَ : حَدَّثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ، عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :قُرْحَةٌ فِي ذِرَاعِي , قَالَ :  لا تَقْرَبْهَا , وَأَمِسَّهَا الْمَاءَ "" ، قُلْتُ : أَرَأَيْتَ إِنْ كَانَ حَوْلَ الْجُرْحِ دَمٌ , وَقَيْحٌ , وَلَكِنْ قَدْ لَصَقَ عَلَى شَفَةِ الْجُرْحِ , قَالَ : "" فَاتْبَعْهُ بِصُوفَةٍ ، أَوْ كُرْسُفَةٍ فِيهَا مَاءٌ فَاغْسِلْهُ "" ، قُلْتُ : فَلا رُخْصَةَ لِي أَنْ لا أَمَسَّهُ , وَلا أُنَقِّيَهُ ؟ , قَالَ : "" لا تُصَلِّ وَبِكَ دَمٌ ""","","","","","Book of Purification"
"593","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :قُرْحَةٌ فِي ذِرَاعِي ، أَرَأَيْتَ إِنْ كَانَ الْجُرْحُ فَاتِحًا فَاهُ , قَالَ :  فَلا تُدْخِلْ يَدَكَ فِيهِ , وَأَمْسِسِ الْمَاءَ مَا حَوْلَهُ ""","","","","","Book of Purification"
"594","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : رَجُلٌ مَكْسُورُ الْيَدِ مَعْصُوبٌ عَلَيْهَا , قَالَ :  يَمْسَحُ الْعِصَابَةَ وَحْدَهُ وَحَسْبُهُ "" , قَالَ : ""فَلا بُدَّ أَنْ يَمَسَّ الْعِصَابَ ، إِنَّمَا عِصَابُ يَدِهِ بِمَنْزِلَةِ يَدِهِ ، يَمْسَحُ عَلَى الْعِصَابِ مَسْحًا ، فَإِنْ أَخْطَأَ مِنْهُ شَيْئًا فَلا بَأْسَ ""","","","","","Book of Purification"
"595","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَإِنْ كَانَ عَلَى دُمَّلٍ فِي ذِرَاعِ رَجُلٍ عِصَابٌ ، أَوْ قُرْحَةٍ يَسِيرَةٍ ، أَيَمْسَحُ عَلَى الْعِصَابِ أَوْ يَنْزِعُهُ ؟ , قَالَ :  إِذَا كَانَتْ يَسِيرَةً , فَأُحِبُّ أَنْ يَنْزَعَ الْعَصَائِبَ ""","","","","","Book of Purification"
"596","عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ فِي كَسْرِ الْيَدِ وَالرِّجْلِ , وَكُلِّ شَيْءٍ شَدِيدٍ إِذَا كَانَ مَعْصُوبًا , فَاللَّهُ أَعْذَرَ بِالْعُذْرِ , فَلْيَمْسَحِ الْعَصَائِبَ ""","","","","","Book of Purification"
"597","عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عَطَاءٍ ، وَعَنِ ابْنِ عُيَيْنَةَ ، عَنْ مَالِكِ بْنِ مِغْوَلٍ , قَالَ : سَأَلْتُ عَطَاءً : أَمْسَحُ عَلَى الْجَبَائِرِ ؟ , قَالَ : "" نَعَمْ ""","","","","","Book of Purification"
"598","عَنِ الثَّوْرِيِّ ، عَنِ الأَشْعَثِ , قَالَ : سَأَلتُ إِبْرَاهِيمَ ،عَنِ الْمَسْحِ عَلَى الْجَبَائِرِ , فَقَالَ :  امْسَحْ عَلَيْهَا مَسْحًا ، فَاللَّهُ أَعْذَرَ بِالْعُذْرِ ""","","","","","Book of Purification"
"599","أَخْبَرَنَا إِسْرَائِيلُ بْنُ يُونُسَ ، عَنْ عَمْرِو بْنِ خَالِدٍ ، عَنْ زَيْدِ بْنِ عَلِيٍّ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، عَنْ عَلِيٍّ , قَالَ : انْكَسَرَ أَحَدُ زَنْدَيَّ ، فَسَأَلْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَأَمَرَنِي أَنْ أَمْسَحَ عَلَى الْجَبَائِرِ ""","","","","","Book of Purification"
"600","عَنِ الثَّوْرِيِّ ، عَنْ سَلَمَةَ بْنِ كُهَيْلٍ ،ضَرَبْتُ بَعِيرًا لِي فَشَجَجْتُ نَفْسِي ، فَسَأَلْتُ سَعِيدَ بْنَ جُبَيْرٍ , فَقَالَ :  اغْسِلْ مَا حَوْلَهُ , وَلا تَقْرَبْهُ الْمَاءَ ""","","","","","Book of Purification"
"601","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , مِثْلَهُ , قَالَ : إِذَا كَانَ الْجُرْحُ مَعْصُوبًا , فَامْسَحْ حَوْلَ الْعِصَابَةِ "", عَنْ مَعْمَرٍ , عَنِ رَجُلٍ مِنْ أَهْلِ الْجَزِيرَةِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ , مِثْلَهُ""","","","","","Book of Purification"
"602","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَإِنِ اشْتَكَيْتُ أُذُنِي فَاشْتَدَّ عَلَيَّ أَنْ أَغْسِلَهَا , قَالَ :  لا تُنَقِّهَا , وَأَمِسَّهَا الْمَاءَ فَقَطْ ""","","","","","Book of Purification"
"603","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي عَاصِمُ بْنُ سُلَيْمَانَ , قَالَ : دَخَلْنَا عَلَى أَبِي الْعَالِيَةِ الرِّيَاحِيِّوَهُوَ وَجِعٌ فَوَضَّئُوهُ ، فَلَمَّا بَقِيَتْ إِحْدَى رِجْلَيْهِ , قَالَ :  امْسَحُوا عَلَى هَذِهِ فَإِنَّهَا مَرِيضَةٌ "", وَكَانَ بِهَا حُمْرَةٌ , وَالْحُمْرَةُ : الْوَرَمُ""","","","","","Book of Purification"
"604","عَنْ مَعْمَرٍ ، عَنْ قَتَادَةَ , فِيالدُّودِ يَخْرُجُ مِنَ الإِنْسَانِ , مِثْلَ حَبِّ الْقَرْعِ , قَالَ :  لَيْسَ عَلَيْهِ مِنْهُ وُضُوءٌ ""","","","","","Book of Purification"
"605","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاهِيمَ , فِيالدُّودِ يَخْرُجُ مِنَ الإِنْسَانِ , قَالَ :  لَيْسَ فِيهِ وُضُوءٌ ""","","","","","Book of Purification"
