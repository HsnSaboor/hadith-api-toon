hadiths[176]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"648","عَنْ رِفَاعَةَ بْنِ رَافِعٍ - رضي الله عنه - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - سُئِلَ: أَيُّ الْكَسْبِ أَطْيَبُ? قَالَ: ((عَمَلُ الرَّجُلِ بِيَدِهِ، وَكُلُّ بَيْعٍ مَبْرُورٍ)). رَوَاهُ الْبَزَّارُ، وَصَحَّحَهُ الْحَاكِمُ.","Da'if","Bulugh al-Maram 648","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"649","وَعَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ -رَضِيَ اللَّهُ عَنْهُمَا: أَنَّهُ سَمِعَ رَسُولَ اللَّهِ - صلى الله عليه وسلم - يَقُولُ عَامَ الْفَتْحِ، وَهُوَ بِمَكَّةَ: ((إِنَّ اللَّهَ وَرَسُولَهُ حَرَّمَ بَيْعَ الْخَمْرِ، وَالْمَيْتَةِ، وَالْخِنْزِيرِ، وَالْأَصْنَامِ)). فَقِيلَ: يَا رَسُولَ اللَّهِ، أَرَأَيْتَ شُحُومَ الْمَيْتَةِ، فَإِنَّهُ تُطْلَى بِهَا السُّفُنُ، وَتُدْهَنُ بِهَا الْجُلُودُ، وَيَسْتَصْبِحُ بِهَا النَّاسُ? فَقَالَ: ((لَا، هُوَ حَرَامٌ)) ، ثُمَّ قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - عِنْدَ ذَلِكَ: ((قَاتَلَ اللَّهُ الْيَهُودَ، إِنَّ اللَّهَ لَمَّا حَرَّمَ عَلَيْهِمْ شُحُومَهَا جَمَلُوهُ، ثُمَّ بَاعُوهُ، فَأَكَلُوا ثَمَنَهُ)). مُتَّفَقٌ عَلَيْهِ","Sahih","Bulugh al-Maram 649","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"650","وَعَنِ ابْنِ مَسْعُودٍ - رضي الله عنه - قَالَ: سَمِعْتُ رَسُولَ اللَّهِ - صلى الله عليه وسلم - يَقُولُ: ((إِذَا اخْتَلَفَ الْمُتَبَايِعَانِ لَيْسَ بَيْنَهُمَا بَيِّنَةٌ، فَالْقَوْلُ مَا يَقُولُ رَبُّ السِّلْعَةِ أَوْ يَتَتَارَكَانِ)). رَوَاهُ الْخَمْسَةُ، وَصَحَّحَهُ الْحَاكِمُ.","Hasan","Bulugh al-Maram 650","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"651","وَعَنْ أَبِي مَسْعُودٍ - رضي الله عنه: أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - نَهَى عَنْ ثَمَنِ الْكَلْبِ، وَمَهْرِ الْبَغِيِّ، وَحُلْوَانِ الْكَاهِنِ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 651","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"652","وَعَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ -رَضِيَ اللَّهُ عَنْهُمَا: أَنَّهُ كَانَ [يَسِيرُ] عَلَى جَمَلٍ لَهُ أَعْيَا. فَأَرَادَ أَنْ يُسَيِّبَهُ. قَالَ: فَلَحِقَنِي النَّبِيُّ - صلى الله عليه وسلم - فَدَعَا لِي، وَضَرَبَهُ، فَسَارَ سَيْرًا لَمْ يَسِرْ مِثْلَهُ، قَالَ: ((بِعْنِيهِ بِوُقِيَّةٍ)) قُلْتُ: لَا. ثُمَّ قَالَ: ((بِعْنِيهِ)) فَبِعْتُهُ بِوُقِيَّةٍ، وَاشْتَرَطْتُ حُمْلَانَهُ إِلَى أَهْلِي، فَلَمَّا بَلَغْتُ أَتَيْتُهُ بِالْجَمَلِ، فَنَقَدَنِي ثَمَنَهُ، ثُمَّ رَجَعْتُ فَأَرْسَلَ فِي أَثَرِي. فَقَالَ: ((أَتُرَانِي مَاكَسْتُكَ لِآخُذَ جَمَلَكَ؟ خُذْ جَمَلَكَ وَدَرَاهِمَكَ فَهُوَ لَكَ)). مُتَّفَقٌ عَلَيْهِ، وَهَذَا السِّيَاقُ لِمُسْلِمٍ.","Sahih","Bulugh al-Maram 652","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"653","وَعَنْهُ رضي الله عنه قَالَ: أَعْتَقَ رَجُلٌ مِنَّا عَبْدًا لَهُ عَنْ دُبُرٍ لَمْ يَكُنْ لَهُ مَالٌ غَيْرُهُ. فَدَعَا بِهِ النَّبِيُّ - صلى الله عليه وسلم - فَبَاعَهُ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 653","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"654","وَعَنْ مَيْمُونَةَ زَوْجِ النَّبِيِّ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَرَضِيَ عَنْهَا -; أَنَّ فَأْرَةً وَقَعَتْ فِي سَمْنٍ، فَمَاتَتْ فِيهِ، فَسُئِلَ النَّبِيُّ - صلى الله عليه وسلم - عَنْهَا. فَقَالَ: ((أَلْقُوهَا وَمَا حَوْلَهَا، وَكُلُوهُ)). رَوَاهُ الْبُخَارِيُّ. وَزَادَ أَحْمَدُ. وَالنَّسَائِيُّ: فِي سَمْنٍ جَامِدٍ.","Sahih","Bulugh al-Maram 654","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"655","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((إِذَا وَقَعَتِ الْفَأْرَةُ فِي السَّمْنِ، فَإِنْ كَانَ جَامِدًا فَأَلْقُوهَا وَمَا حَوْلَهَا، وَإِنْ كَانَ مَايِعًا فَلَا تَقْرَبُوهُ)). رَوَاهُ أَحْمَدُ، وَأَبُو دَاوُدَ، وَقَدْ حَكَمَ عَلَيْهِ الْبُخَارِيُّ وَأَبُو حَاتِمٍ بِالْوَهْمِ.","Da'if","Bulugh al-Maram 655","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"656","وَعَنْ أَبِي الزُّبَيْرِ قَالَ: سَأَلْتُ جَابِرًا عَنْ ثَمَنِ السِّنَّوْرِ وَالْكَلْبِ؟ فَقَالَ: زَجَرَ النَّبِيُّ - صلى الله عليه وسلم - عَنْ ذَلِكَ. رَوَاهُ مُسْلِمٌ. وَالنَّسَائِيُّ وَزَادَ: إِلَّا كَلْبَ صَيْدٍ.","Sahih","Bulugh al-Maram 656","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"657","وَعَنْ عَائِشَةَ -رَضِيَ اللَّهُ عَنْهَا- قَالَتْ: جَاءَتْنِي بَرِيرَةُ، فَقَالَتْ: كَاتَبْتُ أَهْلِي عَلَى تِسْعٍ أُوَاقٍ، فِي كُلِّ عَامٍ أُوقِيَّةٌ، فَأَعِينِينِي. فَقُلْتُ: إِنْ أَحَبَّ أَهْلُكِ أَنْ أَعُدَّهَا لَهُمْ وَيَكُونَ وَلَاؤُكِ لِي فَعَلْتُ، فَذَهَبَتْ بَرِيرَةُ إِلَى أَهْلِهَا. فَقَالَتْ لَهُمْ; فَأَبَوْا عَلَيْهَا، فَجَاءَتْ مِنْ عِنْدِهِمْ، وَرَسُولُ اللَّهِ - صلى الله عليه وسلم - جَالِسٌ. فَقَالَتْ: إِنِّي قَدْ عَرَضْتُ ذَلِكَ عَلَيْهِمْ فَأَبَوْا إِلَّا أَنْ يَكُونَ الْوَلَاءُ لَهُمْ، فَسَمِعَ النَّبِيُّ - صلى الله عليه وسلم - فَأَخْبَرَتْ عَائِشَةُ النَّبِيَّ - صلى الله عليه وسلم -. فَقَالَ: ((خُذِيهَا وَاشْتَرِطِي لَهُمُ الْوَلَاءَ، فَإِنَّمَا الْوَلَاءُ لِمَنْ أَعْتَقَ)) فَفَعَلَتْ عَائِشَةُ، ثُمَّ قَامَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - فِي النَّاسِ [خَطِيبًا] ، فَحَمِدَ اللَّهَ وَأَثْنَى عَلَيْهِ. ثُمَّ قَالَ: ((أَمَّا بَعْدُ، مَا بَالُ رِجَالٍ يَشْتَرِطُونَ شُرُوطًا لَيْسَتْ فِي كِتَابِ اللَّهِ - عز وجل - مَا كَانَ مِنْ شَرْطٍ لَيْسَ فِي كِتَابِ اللَّهِ فَهُوَ بَاطِلٌ، وَإِنْ كَانَ مِائَةَ شَرْطٍ، قَضَاءُ اللَّهِ أَحَقُّ، وَشَرْطُ اللَّهِ أَوْثَقُ، وَإِنَّمَا الْوَلَاءُ لِمَنْ أَعْتَقَ)). مُتَّفَقٌ عَلَيْهِ، وَاللَّفْظُ لِلْبُخَارِيِّ.nوَعِنْدَ مُسْلِمٍ فَقَالَ: اشْتَرِيهَا وَأَعْتِقِيهَا وَاشْتَرِطِي لَهُمُ الْوَلَاءَ.","Sahih","Bulugh al-Maram 657","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"658","وَعَنِ ابْنِ عُمَرَ - رَضِيَ اللَّهُ عَنْهُمَا - قَالَ: نَهَى عُمَرُ عَنْ بَيْعِ أُمَّهَاتِ الْأَوْلَادِ، فَقَالَ: لَا تُبَاعُ، وَلَا تُوهَبُ، وَلَا تُورَثُ، لِيَسْتَمْتِعْ بِهَا مَا بَدَا لَهُ، فَإِذَا مَاتَ فَهِيَ حُرَّةٌ. رَوَاهُ مَالِكٌ، وَالْبَيْهَقِيُّ، وَقَالَ: رَفَعَهُ بَعْضُ الرُّوَاةِ، فَوَهِمَ.","Sahih","Bulugh al-Maram 658","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"659","وَعَنْ جَابِرٍ - رضي الله عنه - قَالَ: كُنَّا نَبِيعُ سَرَارِيَنَا، أُمَّهَاتِ الْأَوْلَادِ، وَالنَّبِيُّ - صلى الله عليه وسلم - حَيٌّ، لَا نَرَى بِذَلِكَ بَأْسًا. رَوَاهُ النَّسَائِيُّ، وَابْنُ مَاجَهْ وَالدَّارَقُطْنِيُّ، وَصَحَّحَهُ ابْنُ حِبَّانَ.","Sahih","Bulugh al-Maram 659","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"660","وَعَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: نَهَى النَّبِيُّ - صلى الله عليه وسلم - عَنْ بَيْعِ فَضْلِ الْمَاءِ. رَوَاهُ مُسْلِمٌ. وَزَادَ فِي رِوَايَةٍ: وَعَنْ بَيْعِ ضِرَابِ الْجَمَلِ.","Sahih","Bulugh al-Maram 660","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"661","وَعَنِ ابْنِ عُمَرَ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: نَهَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - عَنْ عَسْبِ الْفَحْلِ. رَوَاهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 661","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"662","وَعَنْهُ رضي الله عنه أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - نَهَى عَنْ بَيْعِ حَبَلِ الْحَبَلَةِ، وَكَانَ بَيْعًا يَتَبَايَعُهُ أَهْلُ الْجَاهِلِيَّةِ: كَانَ الرَّجُلُ يَبْتَاعُ الْجَزُورَ إِلَى أَنْ تُنْتَجَ النَّاقَةُ، ثُمَّ تُنْتَجُ الَّتِي فِي بَطْنِهَا. مُتَّفَقٌ عَلَيْهِ، وَاللَّفْظُ لِلْبُخَارِيِّ.","Sahih","Bulugh al-Maram 662","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"663","وَعَنْهُ رضي الله عنه أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - نَهَى عَنْ بَيْعِ الْوَلَاءِ، وَعَنْ هِبَتِهِ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 663","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"664","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: نَهَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - عَنْ بَيْعِ الْحَصَاةِ، وَعَنْ بَيْعِ الْغَرَرِ. رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 664","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"665","وَعَنْهُ رضي الله عنه: أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - قَالَ: ((مَنِ اشْتَرَى طَعَامًا فَلَا يَبِعْهُ حَتَّى يَكْتَالَهُ)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 665","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"666","وَعَنْهُ رضي الله عنه قَالَ: نَهَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - عَنْ بَيْعَتَيْنِ فِي بَيْعَةٍ. رَوَاهُ أَحْمَدُ، وَالنَّسَائِيُّ، وَصَحَّحَهُ التِّرْمِذِيُّ، وَابْنُ حِبَّانَ. وَلِأَبِي دَاوُدَ: ((مَنْ بَاعَ بَيْعَتَيْنِ فِي بَيْعَةٍ فَلَهُ أَوَكَسُهُمَا، أَوْ الرِّبَا)).","Hasan","Bulugh al-Maram 666","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"667","وَعَنْ عَمْرِوِ بْنِ شُعَيْبٍ، عَنْ أَبِيهِ، عَنْ جَدِّهِ قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَا يَحِلُّ سَلَفٌ وَبَيْعٌ وَلَا شَرْطَانِ فِي بَيْعٍ، وَلَا رِبْحُ مَا لَمْ يُضْمَنْ، وَلَا بَيْعُ مَا لَيْسَ عِنْدَكَ)). رَوَاهُ الْخَمْسَةُ، وَصَحَّحَهُ التِّرْمِذِيُّ، وَابْنُ خُزَيْمَةَ، وَالْحَاكِمُ. وَأَخْرَجَهُ فِي ((عُلُومِ الْحَدِيثِ)) مِنْ رِوَايَةِ أَبِي حَنِيفَةَ، عَنْ عَمْرٍو الْمَذْكُورِ بِلَفْظِ: ((نَهَى عَنْ بَيْعٍ وَشَرْطٍ)) وَمِنْ هَذَا الْوَجْهِ أَخْرَجَهُ الطَّبَرَانِيُّ فِي ((الْأَوْسَطِ)) وَهُوَ غَرِيبٌ.","Sahih","Bulugh al-Maram 667","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"668","وَعَنْهُ قَالَ: نَهَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - عَنْ بَيْعِ الْعُرْبَانِ. رَوَاهُ مَالِكٌ، قَالَ: بَلَغَنِي عَنْ عَمْرِو بْنِ شُعَيْبٍ، بِهِ.","Hasan","Bulugh al-Maram 668","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"669","وَعَنِ ابْنِ عُمَرَ رَضِيَ اللَّهُ عَنْهُمَا قَالَ: ابْتَعْتُ زَيْتًا فِي السُّوقِ، فَلَمَّا اسْتَوْجَبْتُهُ لَقِيَنِي رَجُلٌ فَأَعْطَانِي بِهِ رِبْحًا حَسَنًا، فَأَرَدْتُ أَنْ أَضْرِبَ عَلَى يَدِ الرَّجُلِ، فَأَخَذَ رَجُلٌ مِنْ خَلْفِي بِذِرَاعِي، فَالْتَفَتُّ، فَإِذَا هُوَ زَيْدُ بْنُ ثَابِتٍ، فَقَالَ: لَا تَبِعْهُ حَيْثُ ابْتَعْتَهُ حَتَّى تَحُوزَهُ إِلَى رَحْلِكَ; فَإِنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - نَهَى أَنْ تُبَاعَ السِّلَعُ حَيْثُ تُبْتَاعُ، حَتَّى يَحُوزَهَا التُّجَّارُ إِلَى رِحَالِهِمْ. رَوَاهُ أَحْمَدُ، وَأَبُو دَاوُدَ وَاللَّفْظُ لَهُ، وَصَحَّحَهُ ابْنُ حِبَّانَ وَالْحَاكِمُ.","Hasan","Bulugh al-Maram 669","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"670","وَعَنْهُ رضي الله عنه قَالَ: قُلْتُ: يَا رَسُولَ اللَّهِ! إِنِّي أَبِيعُ بِالْبَقِيعِ، فَأَبِيعُ بِالدَّنَانِيرِ وَآخُذُ الدَّرَاهِمَ، وَأَبِيعُ بِالدَّرَاهِمِ وَآخُذُ الدَّنَانِيرَ، آخُذُ هَذَا مِنْ هَذِهِ وَأُعْطِي هَذَهِ مِنْ هَذِا? فَقَالَ رَسُولُ اللَّهِ - صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: ((لَا بَأْسَ أَنْ تَأْخُذَهَا بِسِعْرِ يَوْمِهَا مَا لَمْ تَتَفَرَّقَا وَبَيْنَكُمَا شَيْءٌ)). رَوَاهُ الْخَمْسَةُ، وَصَحَّحَهُ الْحَاكِمُ.","Sahih","Bulugh al-Maram 670","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"671","وَعَنْهُ رضي الله عنه قَالَ: نَهَى - صلى الله عليه وسلم - عَنِ النَّجْشِ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 671","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"672","وَعَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ -رَضِيَ اللَّهُ عَنْهُمَا-; - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - نَهَى عَنْ الْمُحَاقَلَةِ، وَالْمُزَابَنَةِ، وَالْمُخَابَرَةِ، وَعَنْ الثُّنْيَا، إِلَّا أَنْ تُعْلَمَ - رَوَاهُ الْخَمْسَةُ إِلَّا اِبْنَ مَاجَهْ، وَصَحَّحَهُ التِّرْمِذِيُّ.","Hasan","Bulugh al-Maram 672","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"673","وَعَنْ أَنَسٍ - رضي الله عنه - قَالَ: نَهَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - عَنِ الْمُحَاقَلَةِ، وَالْمُخَاضَرَةِ، وَالْمُلَامَسَةِ، وَالْمُنَابَذَةِ، وَالْمُزَابَنَةِ. رَوَاهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 673","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"674","وَعَنْ طَاوُسٍ، عَنِ اِبْنِ عَبَّاسٍ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَا تَلَقَّوْا الرُّكْبَانَ، وَلَا يَبِيعُ حَاضِرٌ لِبَادٍ)). قُلْتُ لِابْنِ عَبَّاسٍ: مَا قَوْلُهُ: ((وَلَا يَبِيعُ حَاضِرٌ لِبَادٍ?)) قَالَ: لَا يَكُونُ لَهُ سِمْسَارًا. مُتَّفَقٌ عَلَيْهِ وَاللَّفْظُ لِلْبُخَارِيِّ.","Sahih","Bulugh al-Maram 674","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"675","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَا تَلَقَّوا الْجَلَبَ، فَمَنْ تُلُقِّيَ فَاشْتُرِيَ مِنْهُ، فَإِذَا أَتَى سَيِّدُهُ السُّوقَ فَهُوَ بِالْخِيَارِ)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 675","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"676","وَعَنْهُ رضي الله عنه قَالَ: نَهَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - أَنْ يَبِيعَ حَاضِرٌ لِبَادٍ، ((وَلَا تَنَاجَشُوا، وَلَا يَبِيعُ الرَّجُلُ عَلَى بَيْعِ أَخِيهِ، وَلَا يَخْطُبُ عَلَى خِطْبَةِ أَخِيهِ، وَلَا تُسْأَلُ الْمَرْأَةُ طَلَاقَ أُخْتِهَا لِتَكْفَأَ مَا فِي إِنَائِهَا)). مُتَّفَقٌ عَلَيْهِ. وَلِمُسْلِمٍ: ((لَا يَسُمِ الْمُسْلِمُ عَلَى سَوْمِ الْمُسْلِمِ)).","Sahih","Bulugh al-Maram 676","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"677","وَعَنْ أَبِي أَيُّوبَ الْأَنْصَارِيِّ - رضي الله عنه -[قَالَ]: سَمِعْتُ رَسُولَ اللَّهِ - صلى الله عليه وسلم - يَقُولُ: ((مَنْ فَرَّقَ بَيْنَ وَالِدَةٍ وَوَلَدِهَا، فَرَّقَ اللَّهُ بَيْنَهُ وَبَيْنَ أَحِبَّتِهِ يَوْمَ الْقِيَامَةِ)). رَوَاهُ أَحْمَدُ، وَصَحَّحَهُ التِّرْمِذِيُّ، وَالْحَاكِمُ، وَلَكِنْ فِي إِسْنَادِهِ مَقَالٌ. وَلَهُ شَاهِدٌ.","Hasan","Bulugh al-Maram 677","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"678","وَعَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ - رضي الله عنه - قَالَ: أَمَرَنِي رَسُولُ اللَّهِ - صلى الله عليه وسلم - أَنْ أَبِيعَ غُلَامَيْنِ أَخَوَيْنِ، فَبِعْتُهُمَا، فَفَرَّقْتُ بَيْنَهُمَا، فَذَكَرْتُ ذَلِكَ لِلنَّبِيِّ - صلى الله عليه وسلم - فَقَالَ: ((أَدْرِكْهُمَا، فَارْتَجِعْهُمَا، وَلَا تَبِعْهُمَا إِلَّا جَمِيعًا)). رَوَاهُ أَحْمَدُ، وَرِجَالُهُ ثِقَاتٌ، وَقَدْ صَحَّحَهُ ابْنُ خُزَيْمَةَ، وَابْنُ الْجَارُودِ، وَابْنُ حِبَّانَ، وَالْحَاكِمُ، وَالطَّبَرَانِيُّ، وَابْنُ الْقَطَّانِ.","Da'if","Bulugh al-Maram 678","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"679","وَعَنْ أَنَسِ بْنِ مَالِكٍ - رضي الله عنه - قَالَ: غَلَا السِّعْرُ بِالْمَدِينَةِ عَلَى عَهْدِ رَسُولِ اللَّهِ - صلى الله عليه وسلم - فَقَالَ النَّاسُ: يَا رَسُولَ اللَّهِ! غَلَا السِّعْرُ، فَسَعِّرْ لَنَا، فَقَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - إِنَّ اللَّهَ هُوَ الْمُسَعِّرُ، الْقَابِضُ، الْبَاسِطُ، الرَّازِقُ، وَإِنِّي لَأَرْجُو أَنْ أَلْقَى اللَّهَ تَعَالَى-، وَلَيْسَ أَحَدٌ مِنْكُمْ يَطْلُبُنِي بِمَظْلِمَةٍ فِي دَمٍ وَلَا مَالٍ)). رَوَاهُ الْخَمْسَةُ إِلَّا النَّسَائِيَّ، وَصَحَّحَهُ ابْنُ حِبَّانَ.","Sahih","Bulugh al-Maram 679","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"680","وَعَنْ مَعْمَرِ بْنِ عَبْدِ اللَّهِ - رضي الله عنه - عَنْ رَسُولِ اللَّهِ - صلى الله عليه وسلم - قَالَ: ((لَا يَحْتَكِرُ إِلَّا خَاطِئٌ)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 680","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"681","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - عَنِ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: ((لَا تَصُرُّوا الْإِبِلَ وَالْغَنَمَ، فَمَنِ ابْتَاعَهَا بَعْدُ فَإِنَّهُ بِخَيْرِ النَّظَرَيْنِ بَعْدَ أَنْ يَحْلُبَهَا، إِنْ شَاءَ أَمْسَكَهَا، وَإِنْ شَاءَ رَدَّهَا وَصَاعًا مِنْ تَمْرٍ)). مُتَّفَقٌ عَلَيْهِ. وَلِمُسْلِمٍ: ((فَهُوَ بِالْخِيَارِ ثَلَاثَةَ أَيَّامٍ)). وَفِي رِوَايَةٍ: لَهُ، عَلَّقَهَا - الْبُخَارِيُّ: ((رَدَّ مَعَهَا صَاعًا مِنْ طَعَامٍ، لَا سَمْرَاءَ)). قَالَ الْبُخَارِيُّ: وَالتَّمْرُ أَكْثَرُ.","Sahih","Bulugh al-Maram 681","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"682","وَعَنِ ابْنِ مَسْعُودٍ - رضي الله عنه - قَالَ: مَنِ اشْتَرَى شَاةً مَحَفَّلَةً، فَرَدَّهَا، فَلْيَرُدَّ مَعَهَا صَاعًا. رَوَاهُ الْبُخَارِيُّ. وَزَادَ الْإِسْمَاعِيلِيُّ: مِنْ تَمْرٍ.","Sahih","Bulugh al-Maram 682","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"683","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - - أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - مَرَّ عَلَى صُبْرَةِ طَعَامٍ، فَأَدْخَلَ يَدَهُ فِيهَا، فَنَالَتْ أَصَابِعُهُ بَلَلًا، فَقَالَ: ((مَا هَذَا يَا صَاحِبَ الطَّعَامِ؟)) قَالَ: أَصَابَتْهُ السَّمَاءُ يَا رَسُولَ اللَّهِ. فَقَالَ: ((أَفَلَا جَعَلْتَهُ فَوْقَ الطَّعَامِ; كَيْ يَرَاهُ النَّاسُ؟ مَنْ غَشَّ فَلَيْسَ مِنِّي)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 683","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"684","وَعَنْ عَبْدِ اللَّهِ بْنِ بُرَيْدَةَ، عَنْ أَبِيهِ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((مَنْ حَبَسَ الْعِنَبَ أَيَّامَ الْقِطَافِ، حَتَّى يَبِيعَهُ مِمَّنْ يَتَّخِذُهُ خَمْرًا، فَقَدَ تَقَحَّمَ النَّارَ عَلَى بَصِيرَةٍ)). رَوَاهُ الطَّبَرَانِيُّ فِي ((الْأَوْسَطِ)) بِإِسْنَادٍ حَسَنٍ.","Da'if","Bulugh al-Maram 684","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"685","وَعَنْ عَائِشَةَ -رَضِيَ اللَّهُ عَنْهَا- قَالَتْ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((الخَرَاجُ بِالضَّمَانِ)). رَوَاهُ الْخَمْسَةُ، وَضَعَّفَهُ الْبُخَارِيُّ، وَأَبُو دَاوُدَ وَصَحَّحَهُ التِّرْمِذِيُّ، وَابْنُ خُزَيْمَةَ، وَابْنُ الْجَارُودِ، وَابْنُ حِبَّانَ، وَالْحَاكِمُ، وَابْنُ الْقَطَّانِ.","Hasan","Bulugh al-Maram 685","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"686","وَعَنْ عُرْوَةَ الْبَارِقِيِّ - رضي الله عنه: أَنَّ النَّبِيَّ - صلى الله عليه وسلم - أَعْطَاهُ دِينَارًا يَشْتَرِي بِهِ أُضْحِيَّةً، أَوْ شَاةً، فَاشْتَرَى شَاتَيْنِ، فَبَاعَ إِحْدَاهُمَا بِدِينَارٍ، فَأَتَاهُ بِشَاةٍ وَدِينَارٍ، فَدَعَا لَهُ بِالْبَرَكَةِ فِي بَيْعِهِ، فَكَانَ لَوِ اشْتَرَى تُرَابًا لَرَبِحَ فِيهِ. رَوَاهُ الْخَمْسَةُ إِلَّا النَّسَائِيَّ. وَقَدْ أَخْرَجَهُ الْبُخَارِيُّ ضِمْنَ حَدِيثٍ، وَلَمْ يَسُقْ لَفْظَهُ. وَأَوْرَدَ التِّرْمِذِيُّ لَهُ شَاهِدًا: مِنْ حَدِيثِ حَكِيمِ بْنِ حِزَامٍ.","Sahih","Bulugh al-Maram 686","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"687","وَعَنِ أَبِي سَعِيدٍ الْخُدْرِيِّ - رضي الله عنه: أَنَّ النَّبِيَّ - صلى الله عليه وسلم - نَهَى عَنْ شِرَاءِ مَا فِي بُطُونِ الْأَنْعَامِ حَتَّى تَضَعَ، وَعَنْ بَيْعِ مَا فِي ضُرُوعِهَا، وَعَنْ شِرَاءِ الْعَبْدِ وَهُوَ آبِقٌ، وَعَنْ شِرَاءِ الْمَغَانِمِ حَتَّى تُقْسَمَ، وَعَنْ شِرَاءِ الصَّدَقَاتِ حَتَّى تُقْبَضَ، وَعَنْ ضَرْبَةِ الْغَائِصِ. رَوَاهُ ابْنُ مَاجَهْ، وَالْبَزَّارُ، وَالدَّارَقُطْنِيُّ بِإِسْنَادٍ ضَعِيفٍ.","Da'if","Bulugh al-Maram 687","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"688","وَعَنِ ابْنِ مَسْعُودٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَا تَشْتَرُوا السَّمَكَ فِي الْمَاءِ; فَإِنَّهُ غَرَرٌ)). رَوَاهُ أَحْمَدُ، وَأَشَارَ إِلَى أَنَّ الصَّوَابَ وَقْفُهُ.","Da'if","Bulugh al-Maram 688","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"689","وَعَنِ ابْنِ عَبَّاسٍ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: نَهَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - أَنْ تُبَاعَ ثَمَرَةٌ حَتَّى تُطْعَمَ، وَلَا يُبَاعَ صُوفٌ عَلَى ظَهْرٍ، وَلَا لَبَنٌ فِي ضَرْعٍ. رَوَاهُ الطَّبَرَانِيُّ فِي ((الْأَوْسَطِ)) وَالدَّارَقُطْنِيُّ. وَأَخْرَجَهُ أَبُو دَاوُدَ فِي ((الْمَرَاسِيلِ)) لِعِكْرِمَةَ، وَهُوَ الرَّاجِحُ. وَأَخْرَجَهُ أَيْضًا مَوْقُوفًا عَلَى ابْنِ عَبَّاسٍ بِإِسْنَادٍ قَوِيٍّ، وَرَجَّحَهُ الْبَيْهَقِيُّ.","Hasan","Bulugh al-Maram 689","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"690","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه، أَنَّ النَّبِيَّ - صلى الله عليه وسلم - نَهَى عَنْ بَيْعِ الْمَضَامِينِ، وَالْمَلَاقِيحِ. رَوَاهُ الْبَزَّارُ، وَفِي إِسْنَادِهِ ضَعْفٌ.","Da'if","Bulugh al-Maram 690","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"691","عَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((مَنْ أَقَالَ مُسْلِمًا بَيْعَتَهُ، أَقَالَهُ اللَّهُ عَثْرَتَهُ)). رَوَاهُ أَبُو دَاوُدَ، وَابْنُ مَاجَهْ، وَصَحَّحَهُ ابْنُ حِبَّانَ، وَالْحَاكِمُ.","Da'if","Bulugh al-Maram 691","","","بَابُ شُرُوطِهِ وَمَا نُهِيَ عَنْهُ مِنْهُ"
"692","وَعَنِ ابْنِ عُمَرَ -رَضِيَ اللَّهُ عَنْهُمَا-، عَنْ رَسُولِ اللَّهِ - صلى الله عليه وسلم - قَالَ: ((إِذَا تَبَايَعَ الرَّجُلَانِ، فَكُلُّ وَاحِدٍ مِنْهُمَا بِالْخِيَارِ مَا لَمْ يَتَفَرَّقَا وَكَانَا جَمِيعًا، أَوْ يُخَيِّرُ أَحَدُهُمَا الْآخَرَ، فَإِنْ خَيَّرَ أَحَدُهُمَا الْآخَرَ فَتَبَايَعَا عَلَى ذَلِكَ فَقَدَ وَجَبَ الْبَيْعُ، وَإِنْ تَفَرَّقَا بَعْدَ أَنْ تَبَايَعَا، وَلَمْ يَتْرُكْ وَاحِدٌ مِنْهُمَا الْبَيْعَ فَقَدْ وَجَبَ الْبَيْعُ)). مُتَّفَقٌ عَلَيْهِ، وَاللَّفْظُ لِمُسْلِمٍ.","Sahih","Bulugh al-Maram 692","","","بَابُ الْخِيَارِ"
"693","وَعَنْ عَمْرِو بْنِ شُعَيْبٍ، عَنْ أَبِيهِ، عَنْ جَدِّهِ; أَنَّ النَّبِيَّ - صلى الله عليه وسلم - قَالَ: ((الْبَائِعُ وَالْمُبْتَاعُ بِالْخِيَارِ حَتَّى يَتَفَرَّقَا، إِلَّا أَنْ تَكُونَ صَفْقَةَ خِيَارٍ، وَلَا يَحِلُّ لَهُ أَنْ يُفَارِقَهُ خَشْيَةَ أَنْ يَسْتَقِيلَهُ)). رَوَاهُ الْخَمْسَةُ إِلَّا ابْنَ مَاجَهْ، وَالدَّارَقُطْنِيُّ، وَابْنُ خُزَيْمَةَ، وَابْنُ الْجَارُودِ. وَفِي رِوَايَةٍ: ((حَتَّى يَتَفَرَّقَا عَنْ مَكَانِهِمَا)).","Sahih","Bulugh al-Maram 693","","","بَابُ الْخِيَارِ"
"694","وَعَنِ ابْنِ عُمَرَ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: ذَكَرَ رَجُلٌ لِلنَّبِيِّ - صلى الله عليه وسلم - أَنَّهُ يُخْدَعُ فِي الْبُيُوعِ، فَقَالَ: ((إِذَا بَايَعْتَ فَقُلْ: لَا خَلَابَةَ)). مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 694","","","بَابُ الْخِيَارِ"
"695","عَنْ جَابِرٍ - رضي الله عنه - قَالَ: لَعَنَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - آكِلَ الرِّبَا، وَمُوكِلَهُ، وَكَاتِبَهُ، وَشَاهِدَيْهِ، وَقَالَ: ((هُمْ سَوَاءٌ)). رَوَاهُ مُسْلِمٌ. وَلِلْبُخَارِيِّ نَحْوُهُ مِنْ حَدِيثِ أَبِي جُحَيْفَةَ.","Sahih","Bulugh al-Maram 695","","","بَابُ الرِّبَا"
"696","وَعَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ - رضي الله عنه - عَنْ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: ((الرِّبَا ثَلَاثَةٌ وَسَبْعُونَ بَابًا، أَيْسَرُهَا مِثْلُ أَنْ يَنْكِحَ الرَّجُلُ أُمَّهُ، وَإِنَّ أَرْبَى الرِّبَا عِرْضُ الرَّجُلِ الْمُسْلِمِ)) رَوَاهُ ابْنُ مَاجَهْ مُخْتَصَرًا، وَالْحَاكِمُ بِتَمَامِهِ وَصَحَّحَهُ.","Sahih","Bulugh al-Maram 696","","","بَابُ الرِّبَا"
"697","وَعَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ - رضي الله عنه - أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - قَالَ: ((لَا تَبِيعُوا الذَّهَبَ بِالذَّهَبِ إِلَّا مِثْلًا بِمِثْلٍ، وَلَا تُشِفُّوا بَعْضَهَا عَلَى بَعْضٍ، وَلَا تَبِيعُوا الْوَرِقَ بِالْوَرِقِ إِلَّا مِثْلًا بِمِثْلٍ، وَلَا تُشِفُّوا بَعْضَهَا عَلَى بَعْضٍ، وَلَا تَبِيعُوا مِنْهَا غَائِبًا بِنَاجِزٍ)). مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 697","","","بَابُ الرِّبَا"
"698","وَعَنْ عُبَادَةَ بْنِ الصَّامِتِ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((الذَّهَبُ بِالذَّهَبِ، وَالْفِضَّةُ بِالْفِضَّةِ، وَالْبُرُّ بِالْبُرِّ، وَالشَّعِيرُ بِالشَّعِيرِ، وَالتَّمْرُ بِالتَّمْرِ، وَالْمِلْحُ بِالْمِلْحِ، مِثْلًا بِمِثْلٍ، سَوَاءً بِسَوَاءٍ، يَدًا بِيَدٍ، فَإِذَا اخْتَلَفَتْ هَذِهِ الْأَصْنَافُ فَبِيعُوا كَيْفَ شِئْتُمْ إِذَا كَانَ يَدًا بِيَدٍ)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 698","","","بَابُ الرِّبَا"
"699","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((الذَّهَبُ بِالذَّهَبِ وَزْنًا بِوَزْنٍ مِثْلًا بِمِثْلٍ، وَالْفِضَّةُ بِالْفِضَّةِ وَزْنًا بِوَزْنٍ مِثْلًا بِمِثْلٍ، فَمَنْ زَادَ أَوْ اسْتَزَادَ فَهُوَ رِبًا)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 699","","","بَابُ الرِّبَا"
"700","وَعَنْ أَبِي سَعِيدٍ، وَأَبِي هُرَيْرَةَ -رَضِيَ اللَّهُ عَنْهُمَا، أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - اسْتَعْمَلَ رَجُلًا عَلَى خَيْبَرٍ، فَجَاءَهُ بِتَمْرٍ جَنِيبٍ، فَقَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((أَكُلُّ تَمْرِ خَيْبَرَ هَكَذَا؟)) فَقَالَ: لَا، وَاللَّهِ يَا رَسُولَ اللَّهِ، إِنَّا لَنَأْخُذُ الصَّاعَ مِنْ هَذَا بِالصَّاعَيْنِ وَالثَّلَاثَةِ فَقَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - ((لَا تَفْعَلْ، بِعِ الْجَمْعَ بِالدَّرَاهِمِ، ثُمَّ ابْتَعْ بِالدَّرَاهِمِ جَنِيبًا)). وَقَالَ فِي الْمِيزَانِ مِثْلَ ذَلِكَ. مُتَّفَقٌ عَلَيْهِ. وَلِمُسْلِمٍ: ((وَكَذَلِكَ الْمِيزَانُ)).","Sahih","Bulugh al-Maram 700","","","بَابُ الرِّبَا"
"701","وَعَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: نَهَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - عَنْ بَيْعِ الصُّبْرَةِ مِنَ التَّمْرِ لا يُعْلَمُ مَكِيلُهَا بِالْكَيْلِ الْمُسَمَّى مِنَ التَّمْرِ. رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 701","","","بَابُ الرِّبَا"
"702","وَعَنْ مَعْمَرِ بْنِ عَبْدِ اللَّهِ - رضي الله عنه - قَالَ: إِنِّي كُنْتُ أَسْمَعُ رَسُولَ اللَّهِ - صلى الله عليه وسلم - يَقُولُ: ((الطَّعَامُ بِالطَّعَامِ مِثْلًا بِمِثْلٍ))، وَكَانَ طَعَامُنَا يَوْمَئِذٍ الشَّعِير. رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 702","","","بَابُ الرِّبَا"
"703","وَعَنْ فَضَالَةَ بْنِ عُبَيْدٍ - رضي الله عنه - قَالَ: اشْتَرَيْتُ يَوْمَ خَيْبَرَ قِلَادَةً بِاثْنَيْ عَشَرَ دِينَارًا، فِيهَا ذَهَبٌ وَخَرَزٌ، فَفَصَلْتُهَا فَوَجَدْتُ فِيهَا أَكْثَرَ مِنِ اثْنَيْ عَشَرَ دِينَارًا، فَذَكَرْتُ ذَلِكَ لِلنَّبِيِّ - صلى الله عليه وسلم - فَقَالَ: ((لَا تُبَاعُ حَتَّى تُفْصَلَ)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 703","","","بَابُ الرِّبَا"
"704","وَعَنْ سَمُرَةَ بْنِ جُنْدُبٍ - رضي الله عنه، أَنَّ النَّبِيَّ - صلى الله عليه وسلم - نَهَى عَنْ بَيْعِ الْحَيَوَانِ بِالْحَيَوَانِ نَسِيئَةً. رَوَاهُ الْخَمْسَةُ، وَصَحَّحَهُ التِّرْمِذِيُّ، وَابْنُ الْجَارُودِ.","Sahih","Bulugh al-Maram 704","","","بَابُ الرِّبَا"
"705","وَعَنِ ابْنِ عُمَرَ - رَضِيَ اللَّهُ عَنْهُمَا -[قَالَ]: سَمِعْتُ رَسُولَ اللَّهِ - صلى الله عليه وسلم - يَقُولُ: ((إِذَا تَبَايَعْتُمْ بِالْعِينَةِ، وَأَخَذْتُمْ أَذْنَابَ الْبَقَرِ، وَرَضِيتُمْ بِالزَّرْعِ، وَتَرَكْتُمْ الْجِهَادَ، سَلَّطَ اللَّهُ عَلَيْكُمْ ذُلًّا لَا يَنْزِعُهُ حَتَّى تَرْجِعُوا إِلَى دِينِكُمْ)). رَوَاهُ أَبُو دَاوُدَ مِنْ رِوَايَةِ نَافِعٍ عَنْهُ، وَفِي إِسْنَادِهِ مَقَالٌ. وَلِأَحْمَدَ: نَحْوُهُ مِنْ رِوَايَةِ عَطَاءٍ، وَرِجَالُهُ ثِقَاتٌ وَصَحَّحَهُ ابْنُ الْقَطَّانِ.","Da'if","Bulugh al-Maram 705","","","بَابُ الرِّبَا"
"706","وَعَنْ أَبِي أُمَامَةَ - رضي الله عنه - عَنِ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: ((مَنْ شَفَعَ لِأَخِيهِ شَفَاعَةً، فَأَهْدَى لَهُ هَدِيَّةً، فَقَبِلَهَا، فَقَدْ أَتَى بَابًا عَظِيمًا مِنْ أَبْوَابِ الرِّبَا)). رَوَاهُ أَحْمَدُ، وَأَبُو دَاوُدَ، وَفِي إِسْنَادِهِ مَقَالٌ.","Hasan","Bulugh al-Maram 706","","","بَابُ الرِّبَا"
"707","وَعَنْ عَبْدِ اللَّهِ بْنِ عَمْرِوٍ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: لَعَنَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - الرَّاشِي وَالْمُرْتَشِيَ. رَوَاهُ أَبُو دَاوُدَ، وَالتِّرْمِذِيُّ وَصَحَّحَهُ.","Hasan","Bulugh al-Maram 707","","","بَابُ الرِّبَا"
"708","وَعَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو -رَضِيَ اللَّهُ عَنْهُمَا; أَنَّ رَسُولَ - صلى الله عليه وسلم - أَمَرَهُ أَنْ يُجَهِّزَ جَيْشًا فَنَفِدَتِ الْإِبِلُ، فَأَمَرَهُ أَنْ يَأْخُذَ عَلَى قَلَائِصِ الصَّدَقَةِ. قَالَ: فَكُنْتُ آخُذُ الْبَعِيرَ بِالْبَعِيرَيْنِ إِلَى إِبِلِ الصَّدَقَةِ. رَوَاهُ الْحَاكِمُ وَالْبَيْهَقِيُّ، وَرِجَالُهُ ثِقَاتٌ.","Hasan","Bulugh al-Maram 708","","","بَابُ الرِّبَا"
"709","وَعَنِ ابْنِ عُمَرَ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: نَهَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - عَنِ الْمُزَابَنَةِ; أَنْ يَبِيعَ ثَمَرَ حَائِطِهِ إِنْ كَانَ نَخْلًا بِتَمْرٍ كَيْلًا، وَإِنْ كَانَ كَرْمًا أَنْ يَبِيعَهُ بِزَبِيبٍ كَيْلًا، وَإِنْ كَانَ زَرْعًا أَنْ يَبِيعَهُ بِكَيْلِ طَعَامٍ، نَهَى عَنْ ذَلِكَ كُلِّهُ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 709","","","بَابُ الرِّبَا"
"710","وَعَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ - رضي الله عنه - قَالَ: سَمِعْتُ رَسُولَ اللَّهِ - صلى الله عليه وسلم - سُئِلَ عَنِ اشْتِرَاءِ الرُّطَبِ بِالتَّمْرِ. فَقَالَ: ((أَيَنْقُصُ الرُّطَبُ إِذَا يَبِسَ؟)) قَالُوا: نَعَمَ. فَنَهَى عَنْ ذَلِكَ. رَوَاهُ الْخَمْسَةُ، وَصَحَّحَهُ ابْنُ الْمَدِينِيِّ، وَالتِّرْمِذِيُّ، وَابْنُ حِبَّانَ، وَالْحَاكِمُ.","Hasan","Bulugh al-Maram 710","","","بَابُ الرِّبَا"
"711","وَعَنِ ابْنِ عُمَرَ -رَضِيَ اللَّهُ عَنْهُمَا-; - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - نَهَى عَنْ بَيْعِ الْكَالِئِ بِالْكَالِئِ، يَعْنِي: الدَّيْنِ بِالدَّيْنِ. رَوَاهُ إِسْحَاقُ، وَالْبَزَّارُ بِإِسْنَادٍ ضَعِيفٍ.","Da'if","Bulugh al-Maram 711","","","بَابُ الرِّبَا"
"712","عَنْ زَيْدِ بْنِ ثَابِتٍ - رضي الله عنه - أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - رَخَّصَ فِي الْعَرَايَا: أَنْ تُبَاعَ بِخَرْصِهَا كَيْلًا. مُتَّفَقٌ عَلَيْهِ. وَلِمُسْلِمٍ: رَخَّصَ فِي الْعَرِيَّةِ يَأْخُذُهَا أَهْلُ الْبَيْتِ بِخَرْصِهَا تَمْرًا، يَأْكُلُونَهَا رُطَبًا.","Sahih","Bulugh al-Maram 712","","","بَابُ الرُّخْصَةِ فِي الْعَرَايَا وَبَيْعِ الْأُصُولِ وَالثِّمَارِ"
"713","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه، أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - رَخَّصَ فِي بَيْعِ الْعَرَايَا بِخَرْصِهَا، فِيمَا دُونَ خَمْسَةِ أَوْسُقٍ، أَوْ فِي خَمْسَةِ أَوْسُقٍ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 713","","","بَابُ الرُّخْصَةِ فِي الْعَرَايَا وَبَيْعِ الْأُصُولِ وَالثِّمَارِ"
"714","وَعَنِ ابْنِ عُمَرَ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: نَهَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - عَنْ بَيْعِ الثِّمَارِ حَتَّى يَبْدُوَ صَلَاحُهَا، نَهَى الْبَائِعَ وَالْمُبْتَاعَ. مُتَّفَقٌ عَلَيْهِ. وَفِي رِوَايَةٍ: وَكَانَ إِذَا سُئِلَ عَنْ صَلَاحِهَا؟ قَالَ: ((حَتَّى تَذْهَبَ عَاهَتُهَا)).","Sahih","Bulugh al-Maram 714","","","بَابُ الرُّخْصَةِ فِي الْعَرَايَا وَبَيْعِ الْأُصُولِ وَالثِّمَارِ"
"715","وَعَنْ أَنَسِ بْنِ مَالِكٍ - رضي الله عنه، أَنَّ النَّبِيَّ - صلى الله عليه وسلم - نَهَى عَنْ بَيْعِ الثِّمَارِ حَتَّى تُزْهَى. قِيلَ: وَمَا زَهْوُهَا؟ قَالَ: ((تَحْمَارُّ وَتَصْفَارُّ)). مُتَّفَقٌ عَلَيْهِ، وَاللَّفْظُ لِلْبُخَارِيِّ.","Sahih","Bulugh al-Maram 715","","","بَابُ الرُّخْصَةِ فِي الْعَرَايَا وَبَيْعِ الْأُصُولِ وَالثِّمَارِ"
"716","وَعَنْ أَنَسِ بْنِ مَالِكٍ - رضي الله عنه، أَنَّ النَّبِيَّ - صلى الله عليه وسلم - نَهَى عَنْ بَيْعِ الْعِنَبِ حَتَّى يَسْوَدَّ، وَعَنْ بَيْعِ الْحَبِّ حَتَّى يَشْتَدَّ. رَوَاهُ الْخَمْسَةُ، إِلَّا النَّسَائِيَّ، وَصَحَّحَهُ ابْنُ حِبَّانَ، وَالْحَاكِمُ.","Da'if","Bulugh al-Maram 716","","","بَابُ الرُّخْصَةِ فِي الْعَرَايَا وَبَيْعِ الْأُصُولِ وَالثِّمَارِ"
"717","وَعَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَوْ بِعْتَ مِنْ أَخِيكَ ثَمَرًا فَأَصَابَتْهُ جَائِحَةٌ، فَلَا يَحِلُّ لَكَ أَنْ تَأْخُذَ مِنْهُ شَيْئًا. بِمَ تَأْخُذُ مَالَ أَخِيكَ بِغَيْرِ حَقٍّ؟)). رَوَاهُ مُسْلِمٌ. وَفِي رِوَايَةٍ لَهُ: أَنَّ النَّبِيَّ - صلى الله عليه وسلم - أَمَرَ بِوَضْعِ الْجَوَائِحِ.","Sahih","Bulugh al-Maram 717","","","بَابُ الرُّخْصَةِ فِي الْعَرَايَا وَبَيْعِ الْأُصُولِ وَالثِّمَارِ"
"718","وَعَنِ ابْنِ عُمَرَ -رَضِيَ اللَّهُ عَنْهُمَا-، عَنِ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: مَنِ ابْتَاعَ نَخْلًا بَعْدَ أَنْ تُؤَبَّرَ، فَثَمَرَتُهَا لِلْبَائِعِ الَّذِي بَاعَهَا، إِلَّا أَنْ يَشْتَرِطَ الْمُبْتَاعُ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 718","","","بَابُ الرُّخْصَةِ فِي الْعَرَايَا وَبَيْعِ الْأُصُولِ وَالثِّمَارِ"
"719","عَنِ ابْنِ عَبَّاسٍ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: قَدِمَ النَّبِيُّ - صلى الله عليه وسلم - الْمَدِينَةَ، وَهُمْ يُسْلِفُونَ فِي الثِّمَارِ السَّنَةَ وَالسَّنَتَيْنِ، فَقَالَ: مَنْ أَسْلَفَ فِي تَمْرٍ فَلْيُسْلِفْ فِي كَيْلٍ مَعْلُومٍ، وَوَزْنٍ مَعْلُومٍ، إِلَى أَجَلٍ مَعْلُومٍ. مُتَّفَقٌ عَلَيْهِ. وَلِلْبُخَارِيِّ: ((مَنْ أَسْلَفَ فِي شَيْءٍ)).","Sahih","Bulugh al-Maram 719","","","أَبْوَابُ السَّلَمِ وَالْقَرْضِ، وَالرَّهْنِ."
"720","وَعَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى، وَعَبْدِ اللَّهِ بْنِ أَبِي أَوْفَى -رَضِيَ اللَّهُ عَنْهُمَا- قَالَا: كُنَّا نُصِيبُ الْمَغَانِمَ مَعَ رَسُولِ اللَّهِ - صلى الله عليه وسلم - وَكَانَ يَأْتِينَا أَنْبَاطٌ مِنْ أَنْبَاطِ الشَّامِ، فَنُسْلِفُهُمْ فِي الْحِنْطَةِ وَالشَّعِيرِ وَالزَّبِيبِ. وَفِي رِوَايَةٍ: وَالزَّيْتِ إِلَى أَجَلٍ مُسَمًّى. قِيلَ: أَكَانَ لَهُمْ زَرْعٌ؟ قَالَا: مَا كُنَّا نَسْأَلُهُمْ عَنْ ذَلِكَ. رَوَاهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 720","","","أَبْوَابُ السَّلَمِ وَالْقَرْضِ، وَالرَّهْنِ."
"721","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - عَنِ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: ((مَنْ أَخَذَ أَمْوَالَ النَّاسِ يُرِيدُ أَدَاءَهَا، أَدَّى اللَّهُ عَنْهُ، وَمَنْ أَخَذَهَا يُرِيدُ إِتْلَافَهَا، أَتْلَفَهُ اللَّهُ)). رَوَاهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 721","","","أَبْوَابُ السَّلَمِ وَالْقَرْضِ، وَالرَّهْنِ."
"722","وَعَنْ عَائِشَةَ -رَضِيَ اللَّهُ عَنْهَا- قَالَتْ: قُلْتُ: يَا رَسُولَ اللَّهِ! إِنَّ فُلَانًا قَدِمَ لَهُ بَزٌّ مِنَ الشَّامِ، فَلَوْ بَعَثْتَ إِلَيْهِ، فَأَخَذْتَ مِنْهُ ثَوْبَيْنِ بِنَسِيئَةٍ إِلَى مَيْسَرَةٍ? فَأَرْسَلَ إِلَيْهِ، فَامْتَنَعَ. أَخْرَجَهُ الْحَاكِمُ، وَالْبَيْهَقِيُّ، وَرِجَالُهُ ثِقَاتٌ.","Sahih","Bulugh al-Maram 722","","","أَبْوَابُ السَّلَمِ وَالْقَرْضِ، وَالرَّهْنِ."
"723","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((الظَّهْرُ يُرْكَبُ بِنَفَقَتِهِ إِذَا كَانَ مَرْهُونًا، وَلَبَنُ الدَّرِّ يُشْرَبُ بِنَفَقَتِهِ إِذَا كَانَ مَرْهُونًا، وَعَلَى الَّذِي يَرْكَبُ وَيَشْرَبُ النَّفَقَةُ)). رَوَاهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 723","","","أَبْوَابُ السَّلَمِ وَالْقَرْضِ، وَالرَّهْنِ."
"724","وَعَنْهُ رضي الله عنه قَالَ: قَالَ رَسُولُ اللَّهِ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: ((لَا يَغْلَقُ الرَّهْنُ مِنْ صَاحِبِهِ الَّذِي رَهَنَهُ، لَهُ غُنْمُهُ، وَعَلَيْهِ غُرْمُهُ)). رَوَاهُ الدَّارَقُطْنِيُّ، وَالْحَاكِمُ، وَرِجَالهُ ثِقَاتٌ. إِلَّا أَنَّ الْمَحْفُوظَ عِنْدَ أَبِي دَاوُدَ وَغَيْرِهِ إِرْسَالُهُ.","Da'if","Bulugh al-Maram 724","","","أَبْوَابُ السَّلَمِ وَالْقَرْضِ، وَالرَّهْنِ."
"725","وَعَنْ أَبِي رَافِعٍ - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - اسْتَسْلَفَ مِنْ رَجُلٍ بَكْرًا فَقَدِمَتْ عَلَيْهِ إِبِلٌ مِنَ الصَّدَقَةِ، فَأَمَرَ أَبَا رَافِعٍ أَنْ يَقْضِيَ الرَّجُلَ بَكْرَهُ، فَقَالَ: لَا أَجِدُ إِلَّا خَيَارًا. قَالَ: ((أَعْطِهِ إِيَّاهُ، فَإِنَّ خِيَارَ النَّاسِ أَحْسَنُهُمْ قَضَاءً)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 725","","","أَبْوَابُ السَّلَمِ وَالْقَرْضِ، وَالرَّهْنِ."
"726","وَعَنْ عَلِيٍّ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: ((كُلُّ قَرْضٍ جَرَّ مَنْفَعَةً، فَهُوَ رِبًا)). رَوَاهُ الْحَارِثُ بْنُ أَبِي أُسَامَةَ، وَإِسْنَادُهُ سَاقِطٌ. وَلَهُ شَاهِدٌ ضَعِيفٌ عَنْ فَضَالَةَ بْنِ عُبَيْدٍ عِنْدَ الْبَيْهَقِيِّ. وَآخَرُ مَوْقُوفٌ عَنْ عَبْدِ اللَّهِ بْنِ سَلَامٍ رضي الله عنه عِنْدَ الْبُخَارِيِّ.","Da'if","Bulugh al-Maram 726","","","أَبْوَابُ السَّلَمِ وَالْقَرْضِ، وَالرَّهْنِ."
"727","عَنْ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ أَبِي هُرَيْرَةَ - رضي الله عنه -[قَالَ]: سَمِعْتُ رَسُولَ اللَّهِ - صلى الله عليه وسلم - يَقُولُ: ((مَنْ أَدْرَكَ مَالَهُ بِعَيْنِهِ عِنْدَ رَجُلٍ قَدْ أَفْلَسَ، فَهُوَ أَحَقُّ بِهِ مِنْ غَيْرِهِ)). مُتَّفَقٌ عَلَيْهِ. وَرَوَاهُ أَبُو دَاوُدَ، وَمَالِكٌ: مِنْ رِوَايَةِ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ مُرْسَلًا بِلَفْظِ: ((أَيُّمَا رَجُلٌ بَاعَ مَتَاعًا فَأَفْلَسَ الَّذِي ابْتَاعَهُ، وَلَمْ يَقْبِضِ الَّذِي بَاعَهُ مِنْ ثَمَنِهِ شَيْئًا، فَوَجَدَ مَتَاعَهُ بِعَيْنِهِ، فَهُوَ أَحَقُّ بِهِ، وَإِنْ مَاتَ الْمُشْتَرِي فَصَاحِبُ الْمَتَاعِ أُسْوَةُ الْغُرَمَاءِ)). وَوَصَلَهُ الْبَيْهَقِيُّ، وَضَعَّفَهُ تَبَعًا لِأَبِي دَاوُدَ. وَرَوَى أَبُو دَاوُدَ، وَابْنُ مَاجَهْ: مِنْ رِوَايَةِ عُمَرَ بْنِ خَلْدَةَ قَالَ: أَتَيْنَا أَبَا هُرَيْرَةَ فِي صَاحِبٍ لَنَا قَدْ أَفْلَسَ، فَقَالَ: لَأَقْضِيَنَّ فِيكُمْ بِقَضَاءِ رَسُولِ اللَّهِ - صلى الله عليه وسلم: ((مَنْ أَفْلَسَ أَوْ مَاتَ فَوَجَدَ رَجُلٌ مَتَاعَهُ بِعَيْنِهِ فَهُوَ أَحَقُّ بِهِ)). وَصَحَّحَهُ الْحَاكِمُ، وَضَعَّفَ أَبُو دَاوُدَ هَذِهِ الزِّيَادَةَ فِي ذِكْرِ الْمَوْتِ.","Sahih","Bulugh al-Maram 727","","","بَابُ التَّفْلِيسِ وَالْحَجْرِ"
"728","وَعَنْ عَمْرِو بْنِ الشَّرِيدِ، عَنْ أَبِيهِ قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَيُّ الْوَاجِدِ يُحِلُّ عِرْضَهُ وَعُقُوبَتَهُ)). رَوَاهُ أَبُو دَاوُدَ، وَالنَّسَائِيُّ، وَعَلَّقَهُ الْبُخَارِيُّ، وَصَحَّحَهُ ابْنُ حِبَّانَ.","Hasan","Bulugh al-Maram 728","","","بَابُ التَّفْلِيسِ وَالْحَجْرِ"
"729","وَعَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ - رضي الله عنه - قَالَ: أُصِيبَ رَجُلٌ فِي عَهْدِ رَسُولِ اللَّهِ صلى الله عليه وسلم - فِي ثِمَارٍ ابْتَاعَهَا، فَكَثُرَ دَيْنُهُ، فَقَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - ((تَصَدَّقُوا عَلَيْهِ))، فَتَصَدَّقَ النَّاسُ عَلَيْهِ، وَلَمْ يَبْلُغْ ذَلِكَ وَفَاءَ دَيْنِهِ، فَقَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - لِغُرَمَائِهِ: ((خُذُوا مَا وَجَدْتُمْ، وَلَيْسَ لَكُمْ إِلَّا ذَلِكَ)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 729","","","بَابُ التَّفْلِيسِ وَالْحَجْرِ"
"730","وَعَنِ ابْنِ كَعْبِ بْنِ مَالِكٍ، عَنْ أَبِيهِ; - أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - حَجَرَ عَلَى مُعَاذٍ مَالَهُ، وَبَاعَهُ فِي دَيْنٍ كَانَ عَلَيْهِ. رَوَاهُ الدَّارَقُطْنِيُّ، وَصَحَّحَهُ الْحَاكِمُ، وَأَخْرَجَهُ أَبُو دَاوُدَ مُرْسَلًا، وَرُجِّحَ إِرسَالُهُ.","Da'if","Bulugh al-Maram 730","","","بَابُ التَّفْلِيسِ وَالْحَجْرِ"
"731","وَعَنِ ابْنِ عُمَرَ - رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: عُرِضْتُ عَلَى النَّبِيِّ - صلى الله عليه وسلم - يَوْمَ أُحُدٍ، وَأَنَا ابْنُ أَرْبَعَ عَشْرَةَ سَنَةً، فَلَمْ يُجِزْنِي، وَعُرِضْتُ عَلَيْهِ يَوْمَ الْخَنْدَقِ، وَأَنَا ابْنُ خَمْسَ عَشْرَةَ سَنَةً، فَأَجَازَنِي. مُتَّفَقٌ عَلَيْهِ. وَفِي رِوَايَةٍ لِلْبَيْهَقِيِّ: ((فَلَمْ يُجِزْنِي، وَلَمْ يَرَنِي بَلَغْتُ)). وَصَحَّحَهَا ابْنُ خُزَيْمَةَ.","Sahih","Bulugh al-Maram 731","","","بَابُ التَّفْلِيسِ وَالْحَجْرِ"
"732","وَعَنْ عَطِيَّةَ الْقُرَظِيِّ - رضي الله عنه - قَالَ: عُرِضْنَا عَلَى النَّبِيِّ - صلى الله عليه وسلم - يَوْمَ قُرَيْظَةَ، فَكَانَ مَنْ أَنْبَتَ قُتِلَ، وَمَنْ لَمْ يُنْبِتْ خُلِّيَ سَبِيلُهُ، فَكُنْتُ فِيمَنْ لَمْ يُنْبِتْ فَخُلِّيَ سَبِيلِي. رَوَاهُ الْخَمْسَةُ، وَصَحَّحَهُ ابْنُ حِبَّانَ، وَالْحَاكِمُ. وَقال صحيح علي شرط الشيخين.","Sahih","Bulugh al-Maram 732","","","بَابُ التَّفْلِيسِ وَالْحَجْرِ"
"733","وَعَنْ عَمْرِو بْنِ شُعَيْبٍ، عَنْ أَبِيهِ، عَنْ جَدِّهِ; أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - قَالَ: ((لَا يَجُوزُ لِامْرَأَةٍ عَطِيَّةٌ إِلَّا بِإِذْنِ زَوْجِهَا)). وَفِي لَفْظٍ: ((لَا يَجُوزُ لِلْمَرْأَةِ أَمْرٌ فِي مَالِهَا، إِذَا مَلَكَ زَوْجُهَا عِصْمَتَهَا)). رَوَاهُ أَحْمَدُ، وَأَصْحَابُ السُّنَنِ إِلَّا التِّرْمِذِيَّ، وَصَحَّحَهُ الْحَاكِمُ.","Hasan","Bulugh al-Maram 733","","","بَابُ التَّفْلِيسِ وَالْحَجْرِ"
"734","وَعَنْ قَبِيصَةَ بْنِ مُخَارِقٍ [الْهِلَالِيِّ]- رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((إِنَّ الْمَسْأَلَةَ لَا تَحِلُّ إِلَّا لِأَحَدِ ثَلَاثَةٍ: رَجُلٍ تَحَمَّلَ حَمَالَةً فَحَلَّتْ لَهُ الْمَسْأَلَةُ حَتَّى يُصِيبَهَا ثُمَّ يُمْسِكَ، وَرَجُلٍ أَصَابَتْهُ جَائِحَةٌ اجْتَاحَتْ مَالَهُ، فَحَلَّتْ لَهُ الْمَسْأَلَةُ حَتَّى يُصِيبَ قِوَامًا مِنْ عَيْشٍ، وَرَجُلٍ أَصَابَتْهُ فَاقَةٌ حَتَّى يَقُولَ ثَلَاثَةٌ مِنْ ذَوِي الْحِجَى [ص:258] مِنْ قَوْمِهِ: لَقَدْ أَصَابَتْ فُلَانًا فَاقَةٌ، فَحَلَّتْ لَهُ الْمَسْأَلَةُ)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 734","","","بَابُ التَّفْلِيسِ وَالْحَجْرِ"
"735","عَنْ عَمْرِو بْنِ عَوْفٍ الْمُزَنِيِّ - رضي الله عنه - أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - قَالَ: ((الصُّلْحُ جَائِزٌ بَيْنَ الْمُسْلِمِينَ، إِلَّا صُلْحًا حَرَّمَ حَلَالًا وَ أَحَلَّ حَرَامًا، وَالْمُسْلِمُونَ عَلَى شُرُوطِهِمْ، إِلَّا شَرْطًا حَرَّمَ حَلَالًا وَ أَحَلَّ حَرَامًا)). رَوَاهُ التِّرْمِذِيُّ وَصَحَّحَهُ. وَأَنْكَرُوا عَلَيْهِ لِأَنَّ رَاوِيَهُ كَثِيرَ بْنَ عَبْدِ اللَّهِ بْنِ عَمْرِوِ بْنِ عَوْفٍ ضَعِيفٌ. وَكَأَنَّهُ اعْتَبَرَهُ بِكَثْرَةِ طُرُقِهِ. وَقَدْ صَحَّحَهُ ابْنُ حِبَّانَ مِنْ حَدِيثِ أَبِي هُرَيْرَةَ.","Sahih","Bulugh al-Maram 735","","","بَابُ الصُّلْحِ"
"736","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - ((قَالَ: لَا يَمْنَعُ جَارٌ جَارَهُ أَنْ يَغْرِزَ خَشَبَةً فِي جِدَارِهِ)). ثُمَّ يَقُولُ أَبُو هُرَيْرَةَ - رضي الله عنه - مَا لِي أَرَاكُمْ عَنْهَا مُعْرِضِينَ؟ وَاللَّهِ لَأَرْمِيَنَّ بِهَا بَيْنَ أَكْتَافِكُمْ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 736","","","بَابُ الصُّلْحِ"
"737","وَعَنْ أَبِي حُمَيْدٍ السَّاعِدِيِّ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَا يَحِلُّ لِامْرِئٍ أَنْ يَأْخُذَ عَصَا أَخِيهِ بِغَيْرِ طِيبِ نَفْسٍ مِنْهُ)). رَوَاهُ ابْنُ حِبَّانَ، وَالْحَاكِمُ فِي ((صَحِيحَيْهِمَا)).","Hasan","Bulugh al-Maram 737","","","بَابُ الصُّلْحِ"
"738","عَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((مَطْلُ الْغَنِيِّ ظُلْمٌ، وَإِذَا أُتْبِعُ أَحَدُكُمْ عَلَى مَلِيٍّ فَلْيَتْبَعْ)). مُتَّفَقٌ عَلَيْهِ.nوَفِي رِوَايَةِ أَحْمَدَ: ((وَمَن أَحيَل فَلْيَحْتَلْ)).","Sahih","Bulugh al-Maram 738","","","بَابُ الْحَوَالَةِ وَالضَّمَانِ"
"739","وَعَنْ جَابِرٍ - رضي الله عنه - قَالَ: تُوُفِّيَ رَجُلٌ مِنَّا، فَغَسَّلْنَاهُ، وَحَنَّطْنَاهُ، وَكَفَّنَّاهُ، ثُمَّ أَتَيْنَا بِهِ رَسُولَ اللَّهِ - صلى الله عليه وسلم - فَقُلْنَا: تُصَلِّي عَلَيْهِ؟ فَخَطَا خُطًى، ثُمَّ قَالَ: ((أَعَلَيْهِ دَيْنٌ؟)) قُلْنَا: دِينَارَانِ، فَانْصَرَفَ، فَتَحَمَّلَهُمَا أَبُو قَتَادَةَ، فَأَتَيْنَاهُ، فَقَالَ أَبُو قَتَادَةَ: الدِّينَارَانِ عَلَيَّ، فَقَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - ((أُحِقَّ الْغَرِيمُ وَبَرِئَ مِنْهُمَا الْمَيِّتُ؟)) قَالَ: نَعَمْ، فَصَلَّى عَلَيْهِ. رَوَاهُ أَحْمَدُ، وَأَبُو دَاوُدَ، وَالنَّسَائِيُّ، وَصَحَّحَهُ ابْنُ حِبَّانَ، وَالْحَاكِمُ.","Sahih","Bulugh al-Maram 739","","","بَابُ الْحَوَالَةِ وَالضَّمَانِ"
"740","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - كَانَ يُؤْتَى بِالرَّجُلِ الْمُتَوَفَّى عَلَيْهِ الدَّيْنُ، فَيَسْأَلُ: ((هَلْ تَرَكَ لِدَيْنِهِ مِنْ قَضَاءٍ؟)) فَإِنْ حُدِّثَ أَنَّهُ تَرَكَ وَفَاءً صَلَّى عَلَيْهِ، وَإِلَّا قَالَ: ((صَلُّوا عَلَى صَاحِبِكُمْ)) فَلَمَّا فَتَحَ اللَّهُ عَلَيْهِ الْفُتُوحَ قَالَ: ((أَنَا أَوْلَى بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ، فَمَنْ تُوُفِّيَ، وَعَلَيْهِ دَيْنٌ فَعَلَيَّ قَضَاؤُهُ)). مُتَّفَقٌ عَلَيْهِ. وَفِي رِوَايَةٍ لِلْبُخَارِيِّ: ((فَمَنْ مَاتَ وَلَمْ يَتْرُكْ وَفَاءً)).","Sahih","Bulugh al-Maram 740","","","بَابُ الْحَوَالَةِ وَالضَّمَانِ"
"741","وَعَنْ عَمْرِو بْنِ شُعَيْبٍ، عَنْ أَبِيهِ، عَنْ جَدِّهِ قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَا كَفَالَةَ فِي حَدٍّ)). رَوَاهُ الْبَيْهَقِيُّ بِإِسْنَادٍ ضَعِيفٍ.","Da'if","Bulugh al-Maram 741","","","بَابُ الْحَوَالَةِ وَالضَّمَانِ"
"742","عَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((قَالَ اللَّهُ: أَنَا ثَالِثُ الشَّرِيكَيْنِ مَا لَمْ يَخُنْ أَحَدُهُمَا صَاحِبَهُ، فَإِذَا خَانَ خَرَجْتُ مِنْ بَيْنِهِمَا)). رَوَاهُ أَبُو دَاوُدَ، وَصَحَّحَهُ الْحَاكِمُ.","Hasan","Bulugh al-Maram 742","","","بَابُ الشَّرِكَةِ وَالْوَكَالَةِ"
"743","وَعَنْ السَّائِبِ [بْنِ يَزِيدَ] الْمَخْزُومِيِّ - أَنَّهُ كَانَ شَرِيكَ النَّبِيِّ - صلى الله عليه وسلم - قَبْلَ الْبَعْثَةِ، فَجَاءَ يَوْمَ الْفَتْحِ، فَقَالَ: ((مَرْحَبًا بِأَخِي وَشَرِيكِي)). رَوَاهُ أَحْمَدُ، وَأَبُو دَاوُدَ، وَابْنُ مَاجَةَ.","Da'if","Bulugh al-Maram 743","","","بَابُ الشَّرِكَةِ وَالْوَكَالَةِ"
"744","وَعَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ - رضي الله عنه - قَالَ: اشْتَرَكْتُ أَنَا وَعَمَّارٌ وَسَعْدٌ فِيمَا نُصِيبُ يَوْمَ بَدْرٍ ... الْحَدِيثَ. رَوَاهُ النَّسَائِيُّ.","Da'if","Bulugh al-Maram 744","","","بَابُ الشَّرِكَةِ وَالْوَكَالَةِ"
"745","وَعَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ -رَضِيَ اللَّهُ عَنْهُمَا- - قَالَ: أَرَدْتُ الْخُرُوجَ إِلَى خَيْبَرَ، فَأَتَيْتُ النَّبِيَّ - صلى الله عليه وسلم - فَقَالَ: ((إِذَا أَتَيْتَ وَكِيلِي بِخَيْبَرَ، فَخُذْ مِنْهُ خَمْسَةَ عَشَرَ وَسْقًا)). رَوَاهُ أَبُو دَاوُدَ وَصَحَّحَهُ.","Da'if","Bulugh al-Maram 745","","","بَابُ الشَّرِكَةِ وَالْوَكَالَةِ"
"746","وَعَنْ عُرْوَةَ الْبَارِقِيِّ - رضي الله عنه - أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - بَعَثَ مَعَهُ بِدِينَارٍ يَشْتَرِي لَهُ أُضْحِيَّةً ... الْحَدِيثَ. رَوَاهُ الْبُخَارِيُّ فِي أَثْنَاءِ حَدِيثٍ، وَقَدْ تَقَدَّمَ.","Sahih","Bulugh al-Maram 746","","","بَابُ الشَّرِكَةِ وَالْوَكَالَةِ"
"747","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: بَعَثَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - عُمَرَ عَلَى الصَّدَقَةِ ... الْحَدِيثَ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 747","","","بَابُ الشَّرِكَةِ وَالْوَكَالَةِ"
"748","وَعَنْ جَابِرٍ - رضي الله عنه - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - نَحَرَ ثَلَاثًا وَسِتِّينَ، وَأَمَرَ عَلِيًّا أَنْ يَذْبَحَ الْبَاقِيَ ... الْحَدِيثَ. رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 748","","","بَابُ الشَّرِكَةِ وَالْوَكَالَةِ"
"749","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - فِي قِصَّةِ الْعَسِيفِ. قَالَ النَّبِيُّ - صلى الله عليه وسلم: ((وَاغْدُ يَا أُنَيْسُ عَلَى امْرَأَةِ هَذَا، فَإِنْ اعْتَرَفَتْ فَارْجُمْهَا ... )) الْحَدِيثَ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 749","","","بَابُ الشَّرِكَةِ وَالْوَكَالَةِ"
"750","عَنْ أَبِي ذَرٍّ - رضي الله عنه - قَالَ: قَالَ لِي رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((قُلِ الْحَقَّ، وَلَوْ كَانَ مُرًّا)). صَحَّحَهُ ابْنُ حِبَّانَ فِي حَدِيثٍ طَوِيلٍ.","Da'if","Bulugh al-Maram 750","","","بَابُ الْإِقْرَارِ"
"751","عَنْ سَمُرَةَ بْنِ جُنْدُبٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((عَلَى الْيَدِ مَا أَخَذَتْ حَتَّى تُؤَدِّيَهُ)). رَوَاهُ أَحْمَدُ، وَالْأَرْبَعَةُ، وَصَحَّحَهُ الْحَاكِمُ.","Da'if","Bulugh al-Maram 751","","","بَابُ الْعَارِيَةِ"
"752","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((أَدِّ الْأَمَانَةَ إِلَى مَنِ ائْتَمَنَكَ، وَلَا تَخُنْ مَنْ خَانَكَ)). رَوَاهُ أَبُو دَاوُدَ، وَالتِّرْمِذِيُّ وَحَسَّنَهُ، وَصَحَّحَهُ الْحَاكِمُ، وَاسْتَنْكَرَهُ أَبُو حَاتِمٍ الرَّازِيُّ.","Da'if","Bulugh al-Maram 752","","","بَابُ الْعَارِيَةِ"
"753","وَعَنْ يَعْلَى بْنِ أُمَيَّةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((إِذَا أَتَتْكَ رُسُلِي فَأَعْطِهِمْ ثَلَاثِينَ دِرْعًا))، قُلْتُ: يَا رَسُولَ اللَّهِ! أَعَارِيَةٌ مَضْمُونَةٌ أَوْ عَارِيَةٌ مُؤَدَّاةٌ؟ قَالَ: ((بَلْ عَارِيَةٌ مُؤَدَّاةٌ)). رَوَاهُ أَحْمَدُ، وَأَبُو دَاوُدَ، وَالنَّسَائِيُّ، وَصَحَّحَهُ ابْنُ حِبَّانَ.","Da'if","Bulugh al-Maram 753","","","بَابُ الْعَارِيَةِ"
"754","وَعَنْ صَفْوَانَ بْنِ أُمَيَّةَ; - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - اسْتَعَارَ مِنْهُ دُرُوعًا يَوْمَ حُنَيْنٍ. فَقَالَ: أَغَصْبٌ يَا مُحَمَّدُ؟ قَالَ: ((بَلْ عَارِيَةٌ مَضْمُونَةٌ)). رَوَاهُ أَبُو دَاوُدَ، وَالنَّسَائِيُّ، وَصَحَّحَهُ الْحَاكِمُ. وَأَخْرَجَ لَهُ شَاهِدًا ضَعِيفًا عَنِ ابْنِ عَبَّاسٍ رضي الله عنهما .","Da'if","Bulugh al-Maram 754","","","بَابُ الْعَارِيَةِ"
"755","عَنْ سَعِيدِ بْنِ زَيْدٍ -رَضِيَ اللَّهُ عَنْهُمَا-; أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - قَالَ: ((مَنْ اقْتَطَعَ شِبْرًا مِنَ الْأَرْضِ ظُلْمًا طَوَّقَهُ اللَّهُ إِيَّاهُ يَوْمَ الْقِيَامَةِ مِنْ سَبْعِ أَرَضِينَ)). مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 755","","","بَابُ الْغَصْبِ"
"756","وَعَنْ أَنَسٍ; - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - كَانَ عِنْدَ بَعْضِ نِسَائِهِ، فَأَرْسَلَتْ إِحْدَى أُمَّهَاتِ الْمُؤْمِنِينَ مَعَ خَادِمٍ لَهَا بِقَصْعَةٍ فِيهَا طَعَامٌ، فَكَسَرَتِ الْقَصْعَة، فَضَمَّهَا، وَجَعَلَ فِيهَا الطَّعَامَ. وَقَالَ: ((كُلُوا)) وَدَفَعَ الْقَصْعَةَ الصَّحِيحَةَ لِلرَّسُولِ، وَحَبَسَ الْمَكْسُورَةَ. رَوَاهُ الْبُخَارِيُّ. وَالتِّرْمِذِيُّ، وَسَمَّى الضَّارِبَةَ عَائِشَةَ، وَزَادَ: فَقَالَ النَّبِيُّ - صلى الله عليه وسلم: ((طَعَامٌ بِطَعَامٍ، وَإِنَاءٌ بِإِنَاءٍ)). وَصَحَّحَهُ.","Sahih","Bulugh al-Maram 756","","","بَابُ الْغَصْبِ"
"757","وَعَنْ رَافِعِ بْنِ خَدِيجٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((مَنْ زَرَعَ فِي أَرْضِ قَوْمٍ بِغَيْرِ إِذْنِهِمْ، فَلَيْسَ لَهُ مِنَ الزَّرْعِ شَيْءٌ، وَلَهُ نَفَقَتُهُ)). رَوَاهُ أَحْمَدُ، وَالْأَرْبَعَةُ إِلَّا النَّسَائِيَّ، وَحَسَّنَهُ التِّرْمِذِيُّ. وَيُقَالُ: إِنَّ الْبُخَارِيَّ ضَعَّفَهُ.","Da'if","Bulugh al-Maram 757","","","بَابُ الْغَصْبِ"
"758","وَعَنْ عُرْوَةَ بْنِ الزُّبَيْرِ قَالَ: قَالَ رَجُلٌ مِنَ الصَّحَابَةِ; مِنْ أَصْحَابِ رَسُولِ اللَّهِ - صلى الله عليه وسلم: إِنَّ رَجُلَيْنِ اخْتَصَمَا إِلَى رَسُولِ اللَّهِ - صلى الله عليه وسلم - فِي أَرْضٍ، غَرَسَ أَحَدُهُمَا فِيهَا نَخْلًا، وَالْأَرْضُ لِلْآخَرِ، فَقَضَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - بِالْأَرْضِ لِصَاحِبِهَا، وَأَمَرَ صَاحِبَ النَّخْلِ أَنْ يُخْرِجَ نَخْلَهُ. وَقَالَ: ((لَيْسَ لِعِرْقٍ ظَالِمٍ حَقٌّ)). رَوَاهُ أَبُو دَاوُدَ، وَإِسْنَادُهُ حَسَنٌ. وَآخِرُهُ عِنْدَ أَصْحَابِ السُّنَنِ مِنْ رِوَايَةِ عُرْوَةَ، عَنْ سَعِيدِ بْنِ زَيْدٍ. وَاخْتُلِفَ فِي وَصْلِهِ وَإِرْسَالِهِ، وَفِي تَعْيِين صَحَابِيِّهِ.","Da'if","Bulugh al-Maram 758","","","بَابُ الْغَصْبِ"
"759","وَعَنْ أَبِي بَكْرَةَ; - رضي الله عنه - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - قَالَ: فِي خُطْبَتِهِ يَوْمَ النَّحْرِ بِمِنًى ((إِنَّ دِمَاءَكُمْ وَأَمْوَالَكُمْ [وَأَعْرَاضَكُمْ] عَلَيْكُمْ حَرَامٌ، كَحُرْمَةِ يَوْمِكُمْ هَذَا، فِي بَلَدِكُمْ هَذَا، فِي شَهْرِكُمْ هَذَا)). مُتَّفَقٌ عَلَيْهِ","Sahih","Bulugh al-Maram 759","","","بَابُ الْغَصْبِ"
"760","عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: قَضَى رَسُولُ اللَّهِ - صلى الله عليه وسلم - بِالشُّفْعَةِ فِي كُلِّ مَا لَمْ يُقْسَمْ، فَإِذَا وَقَعَتِ الْحُدُودُ وَصُرِّفَتْ الطُّرُقُ فَلَا شُفْعَةَ. مُتَّفَقٌ عَلَيْهِ، وَاللَّفْظُ لِلْبُخَارِيِّ. وَفِي رِوَايَةِ مُسْلِمٍ: ((الشُّفْعَةُ فِي كُلِّ شِرْكٍ: أَرْضٍ، أَوْ رَبْعٍ، أَوْ حَائِطٍ، لَا يَصْلُحُ أَنْ يَبِيعَ حَتَّى يَعْرِضَ عَلَى شَرِيكِهِ)). وَفِي رِوَايَةِ الطَّحَاوِيِّ: قَضَى النَّبِيُّ - صلى الله عليه وسلم - بِالشُّفْعَةِ فِي كُلِّ شَيْءٍ، وَرِجَالُهُ ثِقَاتٌ.","Sahih","Bulugh al-Maram 760","","","بَابُ الشُّفْعَةِ"
"761","وَعَنْ أَبِي رَافِعٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((الْجَارُ أَحَقُّ بِسَقَبِهِ)). أَخْرَجَهُ الْبُخَارِيُّ، وَفِيهِ قِصَّةٌ.","Sahih","Bulugh al-Maram 761","","","بَابُ الشُّفْعَةِ"
"762","وَعَنْ أَنَسِ بْنِ مَالِكٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((جَارُ الدَّارِ أَحَقُّ بِالدَّارِ)). رَوَاهُ النَّسَائِيُّ، وَصَحَّحَهُ ابْنُ حِبَّانَ، وَلَهُ عِلَّةٌ.","Hasan","Bulugh al-Maram 762","","","بَابُ الشُّفْعَةِ"
"763","وَعَنْ جَابِرٍ قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((الْجَارُ أَحَقُّ بِشُفْعَةِ جَارِهِ، يُنْتَظَرُ بِهَا - وَإِنْ كَانَ غَائِبًا - إِذَا كَانَ طَرِيقُهُمَا وَاحِدًا)). رَوَاهُ أَحْمَدُ، وَالْأَرْبَعَةُ، وَرِجَالُهُ ثِقَاتٌ.","Hasan","Bulugh al-Maram 763","","","بَابُ الشُّفْعَةِ"
"764","وَعَنِ ابْنِ عُمَرَ -رَضِيَ اللَّهُ عَنْهُمَا-، عَنِ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: الشُّفْعَةُ كَحَلِّ الْعِقَالِ. رَوَاهُ ابْنُ مَاجَهْ وَالْبَزَّارُ، وَزَادَ: ((وَلَا شُفْعَةَ لِغَائِبٍ)). وَإِسْنَادُهُ ضَعِيفٌ.","Da'if","Bulugh al-Maram 764","","","بَابُ الشُّفْعَةِ"
"765","عَنْ صُهَيْبٍ - رضي الله عنه - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - قَالَ: ((ثَلَاثٌ فِيهِنَّ الْبَرَكَةُ: الْبَيْعُ إِلَى أَجَلٍ، وَالْمُقَارَضَةُ، وَخَلْطُ الْبُرِّ بِالشَّعِيرِ لِلْبَيْتِ، لَا لِلْبَيْعِ)). رَوَاهُ ابْنُ مَاجَهْ بِإِسْنَادٍ ضَعِيفٍ.","Da'if","Bulugh al-Maram 765","","","بَابُ الْقِرَاضِ"
"766","وَعَنْ حَكِيمِ بْنِ حِزَامٍ - رضي الله عنه - أَنَّهُ كَانَ يَشْتَرِطُ عَلَى الرَّجُلِ إِذَا أَعْطَاهُ مَالًا مُقَارَضَةً: أَنْ لَا تَجْعَلَ مَالِي فِي كَبِدٍ رَطْبَةٍ، وَلَا تَحْمِلَهُ فِي بَحْرٍ، وَلَا تَنْزِلَ بِهِ فِي بَطْنِ مَسِيلٍ، فَإِنْ فَعَلْتَ شَيْئًا مِنْ ذَلِكَ فَقَدَ ضَمِنْتَ مَالِي. رَوَاهُ الدَّارَقُطْنِيُّ، وَرِجَالُهُ ثِقَاتٌ. وَقَالَ مَالِكٌ فِي ((الْمُوَطَّأِ)) عَنْ الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ يَعْقُوبَ، [ص:270] عَنْ أَبِيهِ، عَنْ جَدِّهِ: أَنَّهُ عَمِلَ فِي مَالٍ لِعُثْمَانَ عَلَى أَنَّ الرِّبْحَ بَيْنَهُمَا. وَهُوَ مَوْقُوفٌ صَحِيحٌ.","Sahih","Bulugh al-Maram 766","","","بَابُ الْقِرَاضِ"
"767","عَنِ ابْنِ عُمَرَ - رَضِيَ اللَّهُ عَنْهُمَا - أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - عَامَلَ أَهْلَ خَيْبَرَ بِشَطْرِ مَا يَخْرُجُ مِنْهَا مِنْ ثَمَرٍ، أَوْ زَرْعٍ. مُتَّفَقٌ عَلَيْهِ. وَفِي رِوَايَةٍ لَهُمَا: فَسَأَلُوا أَنْ يُقِرَّهُمْ بِهَا عَلَى أَنْ يَكْفُوا عَمَلَهَا وَلَهُمْ نِصْفُ الثَّمَرِ، فَقَالَ لَهُمْ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((نُقِرُّكُمْ بِهَا عَلَى ذَلِكَ مَا شِئْنَا)) ، فَقَرُّوا بِهَا، حَتَّى أَجْلَاهُمْ عُمَرُ. وَلِمُسْلِمٍ: أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - دَفَعَ إِلَى يَهُودِ خَيْبَرَ نَخْلَ خَيْبَرَ وَأَرْضَهَا عَلَى أَنْ يَعْتَمِلُوهَا مِنْ أَمْوَالِهِمْ، وَلَهُ شَطْرُ ثَمَرِهَا.","Sahih","Bulugh al-Maram 767","","","بَابُ الْمُسَاقَاةِ وَالْإِجَارَةِ"
"768","وَعَنْ حَنْظَلَةَ بْنِ قَيْسٍ قَالَ: سَأَلْتُ رَافِعَ بْنَ خَدِيجٍ - رضي الله عنه - عَنْ كِرَاءِ الْأَرْضِ بِالذَّهَبِ وَالْفِضَّةِ؟ فَقَالَ: لَا بَأْسَ بِهِ، إِنَّمَا كَانَ النَّاسُ يُؤَاجِرُونَ عَلَى عَهْدِ رَسُولِ اللَّهِ - صلى الله عليه وسلم - عَلَى الْمَاذِيَانَاتِ، وَأَقْبَالِ الْجَدَاوِلِ، وَأَشْيَاءَ مِنَ الزَّرْعِ، فَيَهْلِكُ هَذَا وَيَسْلَمُ هَذَا، وَيَسْلَمُ هَذَا وَيَهْلِكُ هَذَا، وَلَمْ يَكُنْ لِلنَّاسِ كِرَاءٌ إِلَّا هَذَا، فَلِذَلِكَ زَجَرَ عَنْهُ، فَأَمَّا شَيْءٌ مَعْلُومٌ مَضْمُونٌ فَلَا بَأْسَ بِهِ. رَوَاهُ مُسْلِمٌ. وَفِيهِ بَيَانٌ لِمَا أُجْمِلَ فِي الْمُتَّفَقَ عَلَيْهِ مِنْ إِطْلَاقِ النَّهْيِ عَنْ كِرَاءِ الْأَرْضِ.","Sahih","Bulugh al-Maram 768","","","بَابُ الْمُسَاقَاةِ وَالْإِجَارَةِ"
"769","وَعَنْ ثَابِتِ بْنِ الضَّحَّاكِ - رضي الله عنه - أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - نَهَى عَنِ الْمُزَارَعَةِ [وَأَمَرَ] بِالْمُؤَاجَرَةِ. رَوَاهُ مُسْلِمٌ أَيْضًا.","Sahih","Bulugh al-Maram 769","","","بَابُ الْمُسَاقَاةِ وَالْإِجَارَةِ"
"770","وَعَنِ ابْنِ عَبَّاسٍ -رَضِيَ اللَّهُ عَنْهُمَا-; أَنَّهُ قَالَ: احْتَجَمَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - وَأَعْطَى الَّذِي حَجَمَهُ أَجْرَهُ، وَلَوْ كَانَ حَرَامًا لَمْ يُعْطِهِ. رَوَاهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 770","","","بَابُ الْمُسَاقَاةِ وَالْإِجَارَةِ"
"771","وَعَنْ رَافِعِ بْنِ خَدِيجٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((كَسْبُ الْحَجَّامِ خَبِيثٌ)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 771","","","بَابُ الْمُسَاقَاةِ وَالْإِجَارَةِ"
"772","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((قَالَ اللَّهُ - عز وجل: ثَلَاثَةٌ أَنَا خَصْمُهُمْ يَوْمَ الْقِيَامَةِ: رَجُلٌ أَعْطَى بِي ثُمَّ غَدَرَ، وَرَجُلٌ بَاعَ حُرًّا، فَأَكَلَ ثَمَنَهُ، وَرَجُلٌ اسْتَأْجَرَ أَجِيرًا، فَاسْتَوْفَى مِنْهُ، وَلَمْ يُعْطِهِ أَجْرَهُ)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 772","","","بَابُ الْمُسَاقَاةِ وَالْإِجَارَةِ"
"773","وَعَنِ ابْنِ عَبَّاسٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((إِنَّ أَحَقَّ مَا أَخَذْتُمْ عَلَيْهِ حَقًّا كِتَابُ اللَّهِ)). أَخْرَجَهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 773","","","بَابُ الْمُسَاقَاةِ وَالْإِجَارَةِ"
"774","وَعَنِ ابْنِ عُمَرَ - رَضِيَ اللَّهُ عَنْهُمَا - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((أُعْطُوا الْأَجِيرَ أَجْرَهُ قَبْلَ أَنْ يَجِفَّ عَرَقُهُ)). رَوَاهُ ابْنُ مَاجَهْ. وفي الباب: عن أبي هريرة -رضي الله عنه- عند [أبي] يعلى والبيهقي. وجابر عند الطبراني، وكلها ضعاف)).","Sahih","Bulugh al-Maram 774","","","بَابُ الْمُسَاقَاةِ وَالْإِجَارَةِ"
"775","وَعَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ - رضي الله عنه - أَنَّ النَّبِيَّ -صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: ((مَنِ اسْتَأْجَرَ أَجِيرًا، فَلْيُسَمِّ لَهُ أُجْرَتَهُ)). رَوَاهُ عَبْدُ الرَّزَّاقِ وَفِيهِ انْقِطَاعٌ، وَوَصَلَهُ الْبَيْهَقِيُّ مِنْ طَرِيقِ أَبِي حَنِيفَةَ.","Da'if","Bulugh al-Maram 775","","","بَابُ الْمُسَاقَاةِ وَالْإِجَارَةِ"
"776","عَنْ عُرْوَةَ، عَنْ عَائِشَةَ -رَضِيَ اللَّهُ عَنْهَا-; أَنَّ النَّبِيَّ - صلى الله عليه وسلم - قَالَ: ((مَنْ عَمَّرَ أَرْضًا لَيْسَتْ لِأَحَدٍ، فَهُوَ أَحَقُّ بِهَا)). قَالَ عُرْوَةُ: وَقَضَى بِهِ عُمَرُ فِي خِلَافَتِهِ. رَوَاهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 776","","","بَابُ إِحْيَاءِ الْمَوَاتِ"
"777","وَعَنْ سَعِيدِ بْنِ زَيْدٍ - رضي الله عنه - عَنِ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: ((مَنْ أَحْيَا أَرْضًا مَيْتَةً فَهِيَ لَهُ)). رَوَاهُ الثَّلَاثَةُ، وَحَسَّنَهُ التِّرْمِذِيُّ. وَقَالَ: رُوِيَ مُرْسَلًا. وَهُوَ كَمَا قَالَ، وَاخْتُلِفَ فِي صَحَابِيِّهِ، فَقِيلَ: جَابِرٌ، وَقِيلَ: عَائِشَةُ، وَقِيلَ: عَبْدُ اللَّهِ بْنُ عَمْرٍو، وَالرَّاجِحُ الْأَوَّلُ.","Hasan","Bulugh al-Maram 777","","","بَابُ إِحْيَاءِ الْمَوَاتِ"
"778","وَعَنِ ابْنِ عَبَّاسٍ; أَنَّ الصَّعْبَ بْنَ جَثَّامَةَ - رضي الله عنه - أَخْبَرَهُ أَنَّ النَّبِيَّ - صلى الله عليه وسلم - قَالَ: ((لَا حِمَى إِلَّا لِلَّهِ وَلِرَسُولِهِ)). رَوَاهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 778","","","بَابُ إِحْيَاءِ الْمَوَاتِ"
"779","وَعَنِ ابْنِ عَبَّاسٍ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَا ضَرَرَ وَلَا ضِرَارَ)). رَوَاهُ أَحْمَدُ، وَابْنُ مَاجَهْ. وَلَهُ مِنْ حَدِيثِ أَبِي سَعِيدٍ مِثْلُهُ، وَهُوَ فِي الْمُوَطَّإِ مُرْسَلٌ.","Da'if","Bulugh al-Maram 779","","","بَابُ إِحْيَاءِ الْمَوَاتِ"
"780","وَعَنْ سَمُرَةَ بْنِ جُنْدُبٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((مَنْ أَحَاطَ حَائِطًا عَلَى أَرْضٍ فَهِيَ لَهُ)). رَوَاهُ أَبُو دَاوُدَ، وَصَحَّحَهُ ابْنُ الْجَارُودِ.","Da'if","Bulugh al-Maram 780","","","بَابُ إِحْيَاءِ الْمَوَاتِ"
"781","وَعَنْ عَبْدِ اللَّهِ بْنِ مُغَفَّلٍ - رضي الله عنه - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - قَالَ: ((مَنْ حَفَرَ بِئْرًا فَلَهُ أَرْبَعُونَ ذِرَاعًا عَطَنًا لِمَاشِيَتِهِ)). رَوَاهُ ابْنُ مَاجَهْ بِإِسْنَادٍ ضَعِيفٍ.","Hasan","Bulugh al-Maram 781","","","بَابُ إِحْيَاءِ الْمَوَاتِ"
"782","وَعَنْ عَلْقَمَةَ بْنِ وَائِلٍ، عَنْ أَبِيهِ; - أَنَّ النَّبِيَّ - صلى الله عليه وسلم - أَقْطَعَهُ أَرْضًا بِحَضْرَمَوْتَ. رَوَاهُ أَبُو دَاوُدَ، وَالتِّرْمِذِيُّ، وَصَحَّحَهُ ابْنُ حِبَّانَ.","Sahih","Bulugh al-Maram 782","","","بَابُ إِحْيَاءِ الْمَوَاتِ"
"783","وَعَنِ ابْنِ عُمَرَ - رَضِيَ اللَّهُ عَنْهُمَا -، أَنَّ النَّبِيَّ - صلى الله عليه وسلم - أَقْطَعَ الزُّبَيْرَ حُضْرَ فَرَسِهِ، فَأَجْرَى الْفَرَسَ حَتَّى قَامَ، ثُمَّ رَمَى سَوْطَهُ. فَقَالَ: ((أَعْطُوهُ حَيْثُ بَلَغَ السَّوْطُ)). رَوَاهُ أَبُو دَاوُدَ وَفِيهِ ضَعْفٌ.","Hasan","Bulugh al-Maram 783","","","بَابُ إِحْيَاءِ الْمَوَاتِ"
"784","وَعَنْ رَجُلٍ مِنْ الصَّحَابَةِ - رضي الله عنه - قَالَ: غَزَوْتُ مَعَ رَسُولِ اللَّهِ - صلى الله عليه وسلم - فَسَمِعْتُهُ يَقُولُ: ((النَّاسُ شُرَكَاءُ فِي ثَلَاثٍ: فِي الْكَلَأِ، وَالْمَاءِ، وَالنَّارِ)). رَوَاهُ أَحْمَدُ، وَأَبُو دَاوُدَ، وَرِجَالُهُ ثِقَاتٌ.","Sahih","Bulugh al-Maram 784","","","بَابُ إِحْيَاءِ الْمَوَاتِ"
"785","عَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - قَالَ: ((إِذَا مَاتَ الْإِنْسَانُ انْقَطَعَ عَنْهُ عَمَلُهُ إِلَّا مِنْ ثَلَاثٍ: صَدَقَةٍ جَارِيَةٍ، أَوْ عِلْمٍ يُنْتَفَعُ بِهِ، أَوْ وَلَدٍ صَالَحٍ يَدْعُو لَهُ)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 785","","","بَابُ الْوَقْفِ"
"786","وَعَنِ ابْنِ عُمَرَ - رَضِيَ اللَّهُ عَنْهُمَا - قَالَ: أَصَابَ عُمَرُ أَرْضًا بِخَيْبَرَ، فَأَتَى النَّبِيَّ - صلى الله عليه وسلم - يَسْتَأْمِرُهُ فِيهَا، فَقَالَ: يَا رَسُولَ اللَّهِ! إِنِّي أَصَبْتُ أَرْضًا بِخَيْبَرَ لَمْ أُصِبْ مَالًا قَطُّ هُوَ أَنْفَسُ عِنْدِي مِنْهُ قَالَ: ((إِنْ شِئْتَ حَبَسْتَ أَصْلَهَا، وَتَصَدَّقْتَ بِهَا)). قَالَ: فَتَصَدَّقَ بِهَا عُمَرُ، [غَيْرَ] أَنَّهُ لَا يُبَاعُ أَصْلُهَا، وَلَا يُورَثُ، وَلَا يُوهَبُ، فَتَصَدَّقَ بِهَا فِي الْفُقَرَاءِ، وَفِي الْقُرْبَى، وَفِي الرِّقَابِ، وَفِي سَبِيلِ اللَّهِ، وَابْنِ السَّبِيلِ، وَالضَّيْفِ، لَا جُنَاحَ عَلَى مَنْ وَلِيَهَا أَنْ يَأْكُلَ مِنْهَا بِالْمَعْرُوفِ، وَيُطْعِمَ صَدِيقًا غَيْرَ مُتَمَوِّلٍ مَالًا. مُتَّفَقٌ عَلَيْهِ، وَاللَّفْظُ لِمُسْلِمٍ. وَفِي رِوَايَةٍ لِلْبُخَارِيِّ: تَصَدَّقْ بِأَصْلِهِ، لَا يُبَاعُ وَلَا يُوهَبُ، وَلَكِنْ يُنْفَقُ ثَمَرُهُ.","Sahih","Bulugh al-Maram 786","","","بَابُ الْوَقْفِ"
"787","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: بَعَثَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - عُمَرَ عَلَى الصَّدَقَةِ ... الْحَدِيثَ، وَفِيهِ: وَأَمَّا خَالِدٌ فَقَدِ احْتَبَسَ أَدْرَاعَهُ وَأَعْتَادَهُ فِي سَبِيلِ اللَّهِ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 787","","","بَابُ الْوَقْفِ"
"788","عَنِ النُّعْمَانِ بْنِ بَشِيرٍ - رَضِيَ اللَّهُ عَنْهُمَا - أَنَّ أَبَاهُ أَتَى بِهِ رَسُولَ اللَّهِ - صلى الله عليه وسلم - فَقَالَ: إِنِّي نَحَلْتُ ابْنِي هَذَا غُلَامًا كَانَ لِي، فَقَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((أَكُلُّ وَلَدِكَ نَحَلْتَهُ مِثْلَ هَذَا؟)). فَقَالَ: لَا. فَقَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((فَارْجِعْهُ)). وَفِي لَفْظٍ: فَانْطَلَقَ أَبِي إِلَى النَّبِيِّ - صلى الله عليه وسلم - لِيُشْهِدَهُ عَلَى صَدَقَتِي. فَقَالَ: ((أَفَعَلْتَ هَذَا بِوَلَدِكَ كُلِّهِمْ؟)). قَالَ: لَا. قَالَ: ((اتَّقُوا اللَّهَ، وَاعْدِلُوا بَيْنَ أَوْلَادِكُمْ)). فَرَجَعَ أَبِي، فَرَدَّ تِلْكَ الصَّدَقَةَ. مُتَّفَقٌ عَلَيْهِ. وَفِي رِوَايَةٍ لِمُسْلِمٍ قَالَ: ((فَأَشْهِدْ عَلَى هَذَا غَيْرِي)) ثُمَّ قَالَ: ((أَيَسُرُّكَ أَنْ يَكُونُوا لَكَ فِي الْبِرِّ سَوَاءً؟)) قَالَ: بَلَى. قَالَ: ((فَلَا إِذًا)).","Sahih","Bulugh al-Maram 788","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"789","وَعَنِ ابْنِ عَبَّاسٍ - رَضِيَ اللَّهُ عَنْهُمَا - قَالَ: قَالَ النَّبِيُّ - صلى الله عليه وسلم: ((الْعَائِدُ فِي هِبَتِهِ كَالْكَلْبِ يَقِيءُ، ثُمَّ يَعُودُ فِي قَيْئِهِ)). مُتَّفَقٌ عَلَيْهِ. وَفِي رِوَايَةٍ لِلْبُخَارِيِّ: ((لَيْسَ لَنَا مَثَلُ السَّوْءِ، الَّذِي يَعُودُ فِي هِبَتِهِ كَالْكَلْبِ يَرْجِعُ فِي قَيْئِهِ)).","Sahih","Bulugh al-Maram 789","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"790","وَعَنِ ابْنِ عُمَرَ، وَابْنِ عَبَّاسٍ - رَضِيَ اللَّهُ عَنْهُمْ-، عَنِ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: ((لَا يَحِلُّ لِرَجُلٍ مُسْلِمٍ أَنْ يُعْطِيَ الْعَطِيَّةَ، ثُمَّ يَرْجِعَ فِيهَا; إِلَّا الْوَالِدُ فِيمَا يُعْطِي وَلَدَهُ)). رَوَاهُ أَحْمَدُ، وَالْأَرْبَعَةُ، وَصَحَّحَهُ التِّرْمِذِيُّ، وَابْنُ حِبَّانَ، وَالْحَاكِمُ.","Sahih","Bulugh al-Maram 790","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"791","وَعَنْ عَائِشَةَ -رَضِيَ اللَّهُ عَنْهَا- قَالَتْ: كَانَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - يَقْبَلُ الْهَدِيَّةَ، وَيُثِيبُ عَلَيْهَا. رَوَاهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 791","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"792","وَعَنِ ابْنِ عَبَّاسٍ -رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: وَهَبَ رَجُلٌ لِرَسُولِ اللَّهِ - صلى الله عليه وسلم - نَاقَةً، فَأَثَابَهُ عَلَيْهَا، فَقَالَ: ((رَضِيتَ؟)) قَالَ: لَا. فَزَادَهُ، فَقَالَ: ((رَضِيتَ؟)) قَالَ: لَا. فَزَادَهُ. قَالَ: ((رَضِيتَ؟)) قَالَ: نَعَمْ. رَوَاهُ أَحْمَدُ، وَصَحَّحَهُ ابْنُ حِبَّانَ.","Sahih","Bulugh al-Maram 792","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"793","وَعَنْ جَابِرٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((الْعُمْرَى لِمَنْ وُهِبَتْ لَهُ)). مُتَّفَقٌ عَلَيْهِ وَلِمُسْلِمٍ: ((أَمْسِكُوا عَلَيْكُمْ أَمْوَالَكُمْ وَلَا تُفْسِدُوهَا، فَإِنَّهُ مَنْ أَعْمَرَ عُمْرَى فَهِيَ لِلَّذِي أُعْمِرَهَا حَيًا وَمَيِّتًا، وَلِعَقِبِهِ)). وَفِي لَفْظٍ: ((إِنَّمَا الْعُمْرَى الَّتِي أَجَازَ رَسُولُ اللَّهِ - صلى الله عليه وسلم - أَنْ يَقُولَ: هِيَ لَكَ وَلِعَقِبِكَ، فَأَمَّا إِذَا قَالَ: هِيَ لَكَ مَا عِشْتَ، فَإِنَّهَا تَرْجِعُ إِلَى صَاحِبِهَا)). وَلِأَبِي دَاوُدَ وَالنَّسَائِيِّ: ((لَا تُرْقِبُوا، وَلَا تُعْمِرُوا، فَمَنْ أُرْقِبَ شَيْئًا أَوْ أُعْمِرَ شَيْئًا فَهُوَ لِوَرَثَتِهِ)).","Sahih","Bulugh al-Maram 793","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"794","وَعَنْ عُمَرَ - رضي الله عنه - قَالَ: حَمَلْتُ عَلَى فَرَسٍ فِي سَبِيلِ اللَّهِ، فَأَضَاعَهُ صَاحِبُهُ، فَظَنَنْتُ أَنَّهُ بَائِعُهُ بِرُخْصٍ، فَسَأَلْتُ رَسُولَ اللَّهِ - صلى الله عليه وسلم - عَنْ ذَلِكَ. فَقَالَ: ((لَا تَبْتَعْهُ، وَإِنْ أَعْطَاكَهُ بِدِرْهَمٍ …)) الْحَدِيثَ. مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 794","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"795","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - عَنِ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: ((تَهَادُوْا تَحَابُّوا)). رَوَاهُ الْبُخَارِيُّ فِي ((الأَدَبِ الْمُفْرَدِ)) وَأَبُو يَعْلَى بِإِسْنَادٍ حَسَنٍ.","Hasan","Bulugh al-Maram 795","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"796","وَعَنْ أَنَسٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((تَهَادَوْا، فَإِنَّ الْهَدِيَّةَ تَسُلُّ السَّخِيمَةَ)). رَوَاهُ الْبَزَّارُ بِإِسْنَادٍ ضَعِيفٍ.","Da'if","Bulugh al-Maram 796","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"797","وَعَنْ أَبِي هُرَيْرَةَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((يَا نِسَاءَ الْمُسْلِمَاتِ! لَا تَحْقِرَنَّ جَارَةٌ لِجَارَتِهَا وَلَوْ فِرْسِنَ شَاةٍ)). مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 797","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"798","وَعَنِ ابْنِ عُمَرَ -رَضِيَ اللَّهُ عَنْهُمَا-، عَنْ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: ((مَنْ وَهَبَ هِبَةً، فَهُوَ أَحَقُّ بِهَا، مَا لَمْ يُثَبْ عَلَيْهَا)). رَوَاهُ الْحَاكِمُ وَصَحَّحَهُ، وَالْمَحْفُوظُ مِنْ رِوَايَةِ ابْنِ عُمَرَ، عَنْ عُمَرَ قَوْلُهُ.","","Bulugh al-Maram 798","","","بَابُ الْهِبَةِ وَالْعُمْرَى وَالرُقبَي"
"799","عَنْ أَنَسٍ - رضي الله عنه - قَالَ: مَرَّ النَّبِيُّ - صلى الله عليه وسلم - بِتَمْرَةٍ فِي الطَّرِيقِ، فَقَالَ: ((لَوْلَا أَنِّي أَخَافُ أَنْ تَكُونَ مِنَ الصَّدَقَةِ لَأَكَلْتُهَا)). مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 799","","","بَابُ اللُّقَطَةِ"
"800","وَعَنْ زَيْدِ بْنِ خَالِدٍ الْجُهَنِيِّ - رضي الله عنه - قَالَ: جَاءَ رَجُلٌ إِلَى النَّبِيِّ - صلى الله عليه وسلم - فَسَأَلَهُ عَنِ اللُّقَطَةِ؟ فَقَالَ: ((اعْرِفْ عِفَاصَهَا وَوِكَاءَهَا، ثُمَّ عَرِّفْهَا سَنَةً، فَإِنْ جَاءَ صَاحِبُهَا وَإِلَّا فَشَأْنُكَ بِهَا)). قَالَ: فَضَالَّةُ الْغَنَمِ؟ قَالَ: ((هِيَ لَكَ، أَوْ لِأَخِيكَ، أَوْ لِلذِّئْبِ)). قَالَ: فَضَالَّةُ الْإِبِلِ؟ قَالَ: ((مَا لَكَ وَلَهَا؟ مَعَهَا سِقَاؤُهَا وَحِذَاؤُهَا، تَرِدُ الْمَاءَ، وَتَأْكُلُ الشَّجَرَ، حَتَّى يَلْقَاهَا رَبُّهَا)). مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 800","","","بَابُ اللُّقَطَةِ"
"801","وَعَنْهُ رضي الله عنه قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((مَنْ آوَى ضَالَّةً فَهُوَ ضَالٌّ، مَا لَمْ يُعَرِّفْهَا)). رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 801","","","بَابُ اللُّقَطَةِ"
"802","وَعَنْ عِيَاضِ بْنِ حِمَارٍ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((مَنْ وَجَدَ لُقَطَةً فَلْيُشْهِدْ ذَوَيْ عَدْلٍ، وَلْيَحْفَظْ عِفَاصَهَا وَوِكَاءَهَا، ثُمَّ لَا يَكْتُمْ، وَلَا يُغَيِّبْ، فَإِنْ جَاءَ رَبُّهَا فَهُوَ أَحَقُّ بِهَا، وَإِلَّا فَهُوَ مَالُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ)). رَوَاهُ أَحْمَدُ، وَالْأَرْبَعَةُ إِلَّا التِّرْمِذِيَّ، وَصَحَّحَهُ ابْنُ خُزَيْمَةَ، وَابْنُ الْجَارُودِ، وَابْنُ حِبَّانَ.","Sahih","Bulugh al-Maram 802","","","بَابُ اللُّقَطَةِ"
"803","وَعَنْ عَبْدِ الرَّحْمَنِ بْنِ عُثْمَانَ التَّيْمِيِّ - رضي الله عنه، أَنَّ النَّبِيَّ - صلى الله عليه وسلم - نَهَى عَنْ لُقَطَةِ الْحَاجِّ. رَوَاهُ مُسْلِمٌ.","Sahih","Bulugh al-Maram 803","","","بَابُ اللُّقَطَةِ"
"804","وَعَنْ الْمِقْدَامِ بْنِ مَعْدِي كَرِبَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((أَلَا لَا يَحِلُّ ذُو نَابٍ مِنَ السِّبَاعِ، وَلَا الْحِمَارُ الْأَهْلِيُّ، وَلَا اللُّقَطَةُ مِنْ مَالِ مُعَاهَدٍ، إِلَّا أَنْ يَسْتَغْنِيَ عَنْهَا)). رَوَاهُ أَبُو دَاوُدَ.","Sahih","Bulugh al-Maram 804","","","بَابُ اللُّقَطَةِ"
"805","عَنِ ابْنِ عَبَّاسٍ - رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((أَلْحِقُوا الْفَرَائِضَ بِأَهْلِهَا، فَمَا بَقِيَ فَهُوَ لِأَوْلَى رَجُلٍ ذَكَرٍ)). مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 805","","","بَابُ الْفَرَائِضِ"
"806","وَعَنْ أُسَامَةَ بْنِ زَيْدٍ - رَضِيَ اللَّهُ عَنْهُمَا- أَنَّ النَّبِيَّ - صلى الله عليه وسلم - قَالَ: ((لَا يَرِثُ الْمُسْلِمُ الْكَافِرَ، وَلَا يَرِثُ الْكَافِرُ الْمُسْلِمَ)). مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 806","","","بَابُ الْفَرَائِضِ"
"807","وَعَنِ ابْنِ مَسْعُودٍ - رضي الله عنه - فِي بِنْتٍ، وَبِنْتِ اِبْنٍ، وَأُخْتٍ - قَضَى النَّبِيُّ - صلى الله عليه وسلم: ((لِلِابْنَةِ النِّصْفَ، وَلِابْنَةِ الِابْنِ السُّدُسَ - تَكْمِلَةَ الثُّلُثَيْنِ- وَمَا بَقِيَ [ص:283] فَلِلْأُخْتِ)). رَوَاهُ الْبُخَارِيُّ.","Sahih","Bulugh al-Maram 807","","","بَابُ الْفَرَائِضِ"
"808","وَعَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو - رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَا يَتَوَارَثُ أَهْلُ مِلَّتَيْنِ)). رَوَاهُ أَحْمَدُ، وَالْأَرْبَعَةُ إِلَّا التِّرْمِذِيَّ. وَأَخْرَجَهُ الْحَاكِمُ بِلَفْظِ أُسَامَةَ. وَرَوَى النَّسَائِيُّ حَدِيثَ أُسَامَةَ بِهَذَا اللَّفْظِ.","Hasan","Bulugh al-Maram 808","","","بَابُ الْفَرَائِضِ"
"809","وَعَنْ عِمْرَانَ بْنِ حُصَينٍ قَالَ: جَاءَ رَجُلٌ إِلَى النَّبِيِّ - صلى الله عليه وسلم - فَقَالَ: إِنَّ ابْنَ ابْنِي مَاتَ، فَمَا لِي مِنْ مِيرَاثِهِ? فَقَالَ: ((لَكَ السُّدُسُ)) فَلَمَّا وَلَّى دَعَاهُ، فَقَالَ: ((لَكَ سُدُسٌ آخَرُ)) فَلَمَّا وَلَّى دَعَاهُ. فَقَالَ: ((إِنَّ السُّدُسَ الْآخَرَ طُعْمَةٌ)). رَوَاهُ أَحْمَدُ وَالْأَرْبَعَةُ، وَصَحَّحَهُ التِّرْمِذِيُّ. وَهُوَ مِنْ رِوَايَةِ الْحَسَنِ الْبَصْرِيِّ عَنْ عِمْرَانَ، وَقِيلَ: إِنَّهُ لَمْ يَسْمَعْ مِنْهُ.","Da'if","Bulugh al-Maram 809","","","بَابُ الْفَرَائِضِ"
"810","وَعَنِ ابْنِ بُرَيْدَةَ، عَنْ أَبِيهِ; أَنَّ النَّبِيَّ - صلى الله عليه وسلم - جَعَلَ لِلْجَدَّةِ السُّدُسَ، إِذَا لَمْ يَكُنْ دُونَهَا أُمٌّ. رَوَاهُ أَبُو دَاوُدَ، وَالنَّسَائِيُّ، وَصَحَّحَهُ ابْنُ خُزَيْمَةَ، وَابْنُ الْجَارُودِ، وَقَوَّاهُ ابْنُ عَدِيٍّ.","Hasan","Bulugh al-Maram 810","","","بَابُ الْفَرَائِضِ"
"811","وَعَنْ الْمِقْدَامِ بْنِ مَعْدِي كَرِبَ - رضي الله عنه - قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((الْخَالُ وَارِثُ مَنْ لَا وَارِثَ لَهُ)). أَخْرَجَهُ أَحْمَدُ، وَالْأَرْبَعَةُ سِوَى التِّرْمِذِيِّ، وَحَسَّنَهُ أَبُو زُرْعَةَ الرَّازِيُّ، وَصَحَّحَهُ ابْنُ حِبَّانَ، وَالْحَاكِمُ.","Hasan","Bulugh al-Maram 811","","","بَابُ الْفَرَائِضِ"
"812","وَعَنْ أَبِي أُمَامَةَ بْنِ سَهْلٍ قَالَ: كَتَبَ مَعِي عُمَرُ إِلَى أَبِي عُبَيْدَةَ - رَضِيَ اللَّهُ عَنْهُمْ-; أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - قَالَ: ((اللَّهُ وَرَسُولُهُ مَوْلَى مَنْ لَا مَوْلَى لَهُ، وَالْخَالُ وَارِثُ مَنْ لَا وَارِثَ لَهُ)). رَوَاهُ أَحْمَدُ، وَالْأَرْبَعَةُ سِوَى أَبِي دَاوُدَ، وَحَسَّنَهُ التِّرْمِذِيُّ، وَصَحَّحَهُ ابْنُ حِبَّانَ.","Hasan","Bulugh al-Maram 812","","","بَابُ الْفَرَائِضِ"
"813","وَعَنْ جَابِرٍ - رضي الله عنه - عَنْ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: ((إِذَا اسْتَهَلَّ الْمَوْلُودُ وُرِّثَ)). رَوَاهُ أَبُو دَاوُدَ، وَصَحَّحَهُ ابْنُ حِبَّانَ.","Da'if","Bulugh al-Maram 813","","","بَابُ الْفَرَائِضِ"
"814","وَعَنْ عَمْرِو بْنِ شُعَيْبٍ، عَنْ أَبِيهِ، عَنْ جَدِّهِ قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((لَيْسَ لِلْقَاتِلِ مِنَ الْمِيرَاثِ شَيْءٌ)). رَوَاهُ النَّسَائِيُّ، وَالدَّارَقُطْنِيُّ، وَقَوَّاهُ ابْنُ عَبْدِ الْبَرِّ، وَأَعَلَّهُ النَّسَائِيُّ، وَالصَّوَابُ: وَقْفُهُ عَلَى عُمَرَ.","Hasan","Bulugh al-Maram 814","","","بَابُ الْفَرَائِضِ"
"815","وَعَنْ عُمَرَ بْنِ الْخَطَّابِ - رضي الله عنه - قَالَ: سَمِعْتُ رَسُولَ اللَّهِ - صلى الله عليه وسلم یَقُولُ: ((مَا أَحْرَزَ الْوَالِدُ أَوْ الْوَلَدُ فَهُوَ لِعَصَبَتِهِ مَنْ كَانَ)). رَوَاهُ أَبُو دَاوُدَ، وَالنَّسَائِيُّ، وَابْنُ مَاجَهْ، وَصَحَّحَهُ ابْنُ الْمَدِينِيِّ، وَابْنُ عَبْدِ الْبَرِّ.","Hasan","Bulugh al-Maram 815","","","بَابُ الْفَرَائِضِ"
"816","وَعَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ - رَضِيَ اللَّهُ عَنْهُمَا- قَالَ: قَالَ النَّبِيُّ - صلى الله عليه وسلم: ((الْوَلَاءُ لُحْمَةٌ كَلُحْمَةِ النَّسَبِ، لَا يُبَاعُ، وَلَا يُوهَبُ)). رَوَاهُ الْحَاكِمُ: مِنْ طَرِيقِ الشَّافِعِيِّ، عَنْ مُحَمَّدِ بْنِ الْحَسَنِ، عَنْ أَبِي يُوسُفَ، وَصَحَّحَهُ ابْنُ حِبَّانَ، وَأَعَلَّهُ الْبَيْهَقِيُّ.","Sahih","Bulugh al-Maram 816","","","بَابُ الْفَرَائِضِ"
"817","وَعَنْ أَبِي قِلَابَةَ، عَنْ أَنَسٍ قَالَ: قَالَ رَسُولُ اللَّهِ - صلى الله عليه وسلم: ((أَفْرَضُكُمْ زَيْدُ بْنُ ثَابِتٍ)). أَخْرَجَهُ أَحْمَدُ، وَالْأَرْبَعَةُ سِوَى أَبِي دَاوُدَ، وَصَحَّحَهُ التِّرْمِذِيُّ، وَابْنُ حِبَّانَ، وَالْحَاكِمُ، وَأُعِلَّ بِالْإِرْسَالِ.","Sahih","Bulugh al-Maram 817","","","بَابُ الْفَرَائِضِ"
"818","عَنْ ابْنِ عُمَرَ - رَضِيَ اللَّهُ عَنْهُمَا-; أَنَّ رَسُولَ اللَّهِ - صلى الله عليه وسلم - قَالَ: ((مَا حَقُّ امْرِئٍ مُسْلِمٍ لَهُ شَيْءٌ يُرِيدُ أَنْ يُوصِيَ فِيهِ يَبِيتُ لَيْلَتَيْنِ إِلَّا وَوَصِيَّتُهُ مَكْتُوبَةٌ عِنْدَهُ)). مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 818","","","بَابُ الْوَصَايَا"
"819","وَعَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ - رضي الله عنه - قَالَ: قُلْتُ: يَا رَسُولَ اللَّهِ! أَنَا ذُو مَالٍ، وَلَا يَرِثُنِي إِلَّا اِبْنَةٌ لِي وَاحِدَةٌ، أَفَأَتَصَدَّقُ بِثُلُثَيْ مَالِي؟ قَالَ: ((لَا))، قُلْتُ: أَفَأَتَصَدَّقُ بِشَطْرِهِ؟ قَالَ: ((لَا))، قُلْتُ: أَفَأَتَصَدَّقُ بِثُلُثِهِ؟ قَالَ: ((الثُّلُثُ، وَالثُّلُثُ كَثِيرٌ، إِنَّكَ أَنْ تَذَرَ وَرَثَتَكَ أَغْنِيَاءَ خَيْرٌ مِنْ أَنْ تَذَرَهُمْ عَالَةً يَتَكَفَّفُونَ النَّاسَ)). مُتَّفَقٌ عَلَيْهِ.","Sahih","Bulugh al-Maram 819","","","بَابُ الْوَصَايَا"
"820","وَعَنْ عَائِشَةَ -رَضِيَ اللَّهُ عَنْهَا: أَنَّ رَجُلًا أَتَى النَّبِيَّ - صلى الله عليه وسلم - قَالَ: يَا رَسُولَ اللَّهِ! إِنَّ أُمِّي اُفْتُلِتَتْ نَفْسُهَا وَلَمْ تُوصِ، وَأَظُنُّهَا لَوْ تَكَلَّمَتْ تَصَدَّقَتْ، أَفَلَهَا أَجْرٌ إِنْ تَصَدَّقْتُ عَنْهَا? قَالَ: ((نَعَمْ)). مُتَّفَقٌ عَلَيْهِ، وَاللَّفْظُ لِمُسْلِمٍ.","Sahih","Bulugh al-Maram 820","","","بَابُ الْوَصَايَا"
"821","وَعَنْ أَبِي أُمَامَةَ الْبَاهِلِيِّ - رضي الله عنه - سَمِعْتُ رَسُولَ اللَّهِ - صلى الله عليه وسلم - يَقُولُ: ((إِنَّ اللَّهَ قَدْ أَعْطَى كُلَّ ذِي حَقٍّ حَقَّهُ، فَلَا وَصِيَّةَ لِوَارِثٍ)). رَوَاهُ أَحْمَدُ، وَالْأَرْبَعَةُ إِلَّا النَّسَائِيَّ، وَحَسَّنَهُ أَحْمَدُ وَالتِّرْمِذِيُّ، وَقَوَّاهُ ابْنُ خُزَيْمَةَ، وَابْنُ الْجَارُودِ. وَرَوَاهُ الدَّارَقُطْنِيُّ مِنْ حَدِيثِ اِبْنِ عَبَّاسٍ - رَضِيَ اللَّهُ عَنْهُمَا-، وَزَادَ فِي آخِرِهِ: ((إِلَّا أَنْ يَشَاءَ الْوَرَثَةُ)). وَإِسْنَادُهُ حَسَنٌ.","Hasan","Bulugh al-Maram 821","","","بَابُ الْوَصَايَا"
"822","وَعَنْ مُعَاذِ بْنِ جَبَلٍ - رضي الله عنه - قَالَ: ((قَالَ النَّبِيُّ - صلى الله عليه وسلم: ((إِنَّ اللَّهَ تَصَدَّقَ عَلَيْكُمْ بِثُلُثِ أَمْوَالِكُمْ عِنْدَ وَفَاتِكُمْ; زِيَادَةً فِي حَسَنَاتِكُمْ)). رَوَاهُ الدَّارَقُطْنِيُّ. وَأَخْرَجَهُ أَحْمَدُ، وَالْبَزَّارُ مِنْ حَدِيثِ أَبِي الدَّرْدَاءِ. وَابْنُ مَاجَهْ: مِنْ حَدِيثِ أَبِي هُرَيْرَةَ. وَكُلُّهَا ضَعِيفَةٌ، لَكِنْ قَدْ يَقْوَى بَعْضُهَا بِبَعْضٍ. وَاللَّهُ أَعْلَمُ.","Da'if","Bulugh al-Maram 822","","","بَابُ الْوَصَايَا"
"823","عَنْ عَمْرِو بْنِ شُعَيْبٍ، عَنْ أَبِيهِ، عَنْ جَدِّهِ، عَنِ النَّبِيِّ - صلى الله عليه وسلم - قَالَ: مَنْ أُودِعَ وَدِيعَةً، فَلَيْسَ عَلَيْهِ ضَمَانٌ - أَخْرَجَهُ ابْنُ مَاجَهْ، وَإِسْنَادُهُ ضَعِيفٌ.","Da'if","Bulugh al-Maram 823","","","بَابُ الْوَدِيعَةِ"
