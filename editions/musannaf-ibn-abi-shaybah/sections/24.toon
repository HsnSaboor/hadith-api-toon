hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"23047","(۲۳۰۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ أَبِی قُرَّۃَ ، عَنْ سَلْمَانَ بْنِ رَبِیعَۃَ الْبَاہِلِیِّ: فِی رَجُلٍ اشْتَرَی مِنْ رَجُلٍ سِلْعَۃً عَلَی أَنْ یَنْظُرَ إلَیْہَا ، وَقَطَعَ الثَّمَنَ ، فَمَاتَتْ ، فَضَمَّنَہُ سَلْمَانُ بْنُ رَبِیعَۃَ۔","","Musannaf Ibn Abi Shaybah 23047","","","كتاب البيوع والأقضية"
"23048","(۲۳۰۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : فِی الرَّجُلِ یَشْتَرِی السِّلْعَۃَ عَلَی أَنْ یَنْظُرَ إلَیْہَا فَمَاتَتْ ، قَالَ : یَضْمَنُ الْمُشْتَرِی۔","","Musannaf Ibn Abi Shaybah 23048","","","كتاب البيوع والأقضية"
"23049","(۲۳۰۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، عَنِ الْحَسَنِ ، قَالَ : یَضْمَنُ الْمُشْتَرِی إذَا کَانَ بِالْخِیَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23049","","","كتاب البيوع والأقضية"
"23050","(۲۳۰۵۰) حَدَّثَنَا ہُشَیْمٌ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَقُولُ : إذَا اشْتَرَی الرَّجُلُ الْمَتَاعَ عَلَی أَنَّہُ فِیہِ بِالْخِیَارِ فَہَلَکَ مِنْ عِنْدِہِ ، قَالَ : إِنْ کَانَ سَمَّی الثَّمَنَ ، فَہُوَ لَہُ ضَامِنٌ ، وَإِنْ لَمْ یَکُنْ سَمَّی الثَّمَنَ ، فَہُوَ فِیہِ مُؤْتَمَنٌ۔","","Musannaf Ibn Abi Shaybah 23050","","","كتاب البيوع والأقضية"
"23051","(۲۳۰۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : کَانَ ابْنُ أَبِی لَیْلَی یَقُولُ : إذَا کَانَ الْبَائِعُ بِالْخِیَارِ فَمَاتَتِ السِّلْعَۃُ فَلَیْسَ عَلَی الْمُشْتَرِی شَیْئٌ۔n وَقَالَ سُفْیَانُ : یَضْمَنُ الْقِیمَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23051","","","كتاب البيوع والأقضية"
"23052","(۲۳۰۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : فِی الرَّجُلِ یَقُولُ لِلرَّجُلِ : عِنْدَک شَہَادَۃٌ ؟ فَیَقُولُ : لاَ ، ثُمَّ یَجِیئُ فَیَشْہَدُ ، قَالَ : ہِیَ جَائِزَۃٌ۔","","Musannaf Ibn Abi Shaybah 23052","","","كتاب البيوع والأقضية"
"23053","(۲۳۰۵۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، قَالَ : شَہِدَ الْقَاسِمُ بْنُ مُحَمَّدٍ بِشَہَادَۃٍ عِنْدَ أَبَانَ بْنِ عُثْمَانَ لِرَجُلٍ ، فَجَعَلَ الرَّجُلُ یَذْکُرُہُ شَیْئًا فِی شَہَادَتِہِ ، فَیَقُولُ : لاَ أَذْکُرُہُ ، وَلاَ أَحْفَظُ إلاَّ ہَذَا ، ثُمَّ خَرَجَ فَذَکَرَ وَالْقَوْمُ قُعُودٌ ، فَقَالَ : إنَّ ہَذَا سَأَلَنِی شَیْئًا فِی شَہَادَۃٍ کُنْت لاَ أَذْکُرُہُ لَہُ ، وَإِنِّی قَدْ ذَکَرْتہ وَأنَا أَشْہَدُ أَنَّ مَا قَالَ حَقٌّ وَأَنَا أَشْہَدُ بِہِ۔","","Musannaf Ibn Abi Shaybah 23053","","","كتاب البيوع والأقضية"
"23054","(۲۳۰۵۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ مَسْعُودٍ : أَنَّہُ کَانَ یَکْرَہُ بَیْعَ الْمُکَاتَبِ۔","","Musannaf Ibn Abi Shaybah 23054","","","كتاب البيوع والأقضية"
"23055","(۲۳۰۵۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَوْ عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یُبَاعَ الْمُکَاتَبُ إِذَا بَقِیَ عَلَیْہِ شَیء مِنْ مُکَاتَبَتِہِ مِمَّنْ یَشْتَرِیہِ وَیَضْمَنُ عِتْقَہُ ، وَلاَ یُبَاعُ لِلرِّقِّ۔","","Musannaf Ibn Abi Shaybah 23055","","","كتاب البيوع والأقضية"
"23056","(۲۳۰۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ : أَنَّ بَرِیرَۃَ أَتَتْہَا وَہِیَ مُکَاتَبَۃٌ ، فَسَأَلْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَشْتَرِیہَا عَلَی أَنَّ وَلاَئَہَا لِمَوَالِیہَا؟ فَقَالَ: اشْتَرِیہَا وَأَعْتِقِیہَا ، فَإِنَّمَا الْوَلاَئُ لِمَنْ أَعْتَقَ۔n(بخاری ۲۵۶۳۔ مسلم ۱۱۴۳)","Sahih","Musannaf Ibn Abi Shaybah 23056","","","كتاب البيوع والأقضية"
"23057","(۲۳۰۵۷) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی ابْنُ أَبِی مُلَیْکَۃَ : أَنَّ امْرَأَۃً کُوتِبَتْ ، فَوَلَدَتْ وَلَدَیْنِ فِی مُکَاتَبَتِہَا ، ثُمَّ مَاتَتْ ، فَسُئِلَ عَنْ ذَلِکَ عَبْدُ اللہِ بْنُ الزُّبَیْرِ ؟ فَقَالَ : إِنْ أَقَامَا بِکِتَابَۃِ أُمِّہِمَا فَذَلِکَ لَہُمَا ، فَإِذَا أَدَّیَا عَتَقَا۔","Sahih","Musannaf Ibn Abi Shaybah 23057","","","كتاب البيوع والأقضية"
"23058","(۲۳۰۵۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : وَلَدُ الْمُکَاتَبَۃِ بِمَنْزِلَتِہَا ، یَعْتِقُونَ بِعِتْقِہَا وَیَرِقُّونَ بِرِقِّہَا ، فَإِنْ مَاتَتْ سَعَوا فِیمَا بَقِیَ مِنْ مُکَاتَبَتِہَا ، فَإِنْ أَدُّوا عَتَقُوا ، وَإِنْ عَجَزُوا أُرِقُّواْ۔","","Musannaf Ibn Abi Shaybah 23058","","","كتاب البيوع والأقضية"
"23059","(۲۳۰۵۹) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : وَلَدُہ بِمَنْزِلَتِہِ فِی السَّعْیِ۔ یَعْنِی : الْمُکَاتَبَ۔","","Musannaf Ibn Abi Shaybah 23059","","","كتاب البيوع والأقضية"
"23060","(۲۳۰۶۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ طَاوُوسٍ ، عَنْ حُجْرٍ الْمَدَرِیِّ ، عَنْ زَیْدِ بْنِ ثَابِتٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَعَلَ الْعُمْرَی لِلْوَارِثِ۔ (ابوداؤد ۳۵۵۴۔ نسائی ۶۵۵۲)","Sahih","Musannaf Ibn Abi Shaybah 23060","","","كتاب البيوع والأقضية"
"23061","(۲۳۰۶۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ : أَنَّ طَارِقًا قَضَی بِالْعُمْرَی لِلْوَارِثِ لِقَوْلِ جَابِرٍ عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (مسلم ۱۲۴۷)","","Musannaf Ibn Abi Shaybah 23061","","","كتاب البيوع والأقضية"
"23062","(۲۳۰۶۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ عُمْرَی فَمَنْ أَعْمَرَ شَیْئًا ، فَہُوَ لَہُ۔ (ابن ماجہ ۲۳۷۹۔ نسائی ۶۵۸۴)","Hasan","Musannaf Ibn Abi Shaybah 23062","","","كتاب البيوع والأقضية"
"23063","(۲۳۰۶۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعُمْرَی جَائِزَۃٌ لِمَنْ أُعْمِرَہَا۔ (احمد ۱/۲۵۰)","","Musannaf Ibn Abi Shaybah 23063","","","كتاب البيوع والأقضية"
"23064","(۲۳۰۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃَََ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعُمْرَی مِیرَاثٌ لأَہْلِہَا أو جائزۃ لأہلہا۔ (ترمذی ۱۳۴۹۔ ابوداؤد ۳۵۴۴)","Hasan","Musannaf Ibn Abi Shaybah 23064","","","كتاب البيوع والأقضية"
"23065","(۲۳۰۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ابِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمْسِکُوا عَلَیْکُمْ أَمْوَالَکُمْ لاَ تُعْمِرُوہَا ، فَمَنْ أُعْمِرَ عُمْرَی فَہِیَ سَبِیلُ الْمِیرَاثِ۔n(مسلم ۲۷۔ احمد ۳/۳۰۲)","Sahih","Musannaf Ibn Abi Shaybah 23065","","","كتاب البيوع والأقضية"
"23066","(۲۳۰۶۶) حَدَّثَنَا وَکِیع ، قَالَ : حَدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أُعْمِرَ عُمْرَی فَہِیَ لَہُ وَلِوَرَثَتِہِ مِنْ بَعْدِہِ۔","","Musannaf Ibn Abi Shaybah 23066","","","كتاب البيوع والأقضية"
"23067","(۲۳۰۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ طَاوُوسٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعُمْرَی مِیرَاثٌ۔ (نسائی ۶۵۴۶۔ احمد ۵/۱۸۹)","","Musannaf Ibn Abi Shaybah 23067","","","كتاب البيوع والأقضية"
"23068","(۲۳۰۶۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : أَخْبَرَنَا سَلَمَۃُ بْنُ کُہَیْلٍ ، قَالَ : کُنَّا جُلُوسًا عِنْدَ شُرَیْحٍ إذْ أَتَاہُ قَوْمٌ یَخْتَصِمُونَ إلَیْہِ فِی عُمْرَی جُعِلَتْ لِرَجُلٍ حَیَاتَہُ ، فَقَالَ : ہِیَ لَہُ حَیَاتَہُ وَمَوْتَہُ ، فَأَقْبَلَ عَلَیْہِ الَّذِی قَضَی عَلَیْہِ یُنَاشِدُہُ ، فَقَالَ شُرَیْحٌ : لَقَدْ لاَمَنِی ہَذَا عَلَی أَمْرٍ قَضَی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 23068","","","كتاب البيوع والأقضية"
"23069","(۲۳۰۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، عَنْ مَکْحُولٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَیُّمَا رَجُلٍ أُعْمِرَ عُمْرَی فَہِیَ لَہُ یَصْنَعُ بِہَا مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 23069","","","كتاب البيوع والأقضية"
"23070","(۲۳۰۷۰) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدٍ بْنِ عَقِیلٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، عَنْ عَلِیٍّ ، قَالَ : الْعُمْرَی بَتَاتٌ۔","Da'if","Musannaf Ibn Abi Shaybah 23070","","","كتاب البيوع والأقضية"
"23071","(۲۳۰۷۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : أَتَاہُ أَعْرَابِیٌّ فَقَالَ: إنِّی أَعْطَیْتُ ابْنَ أَخِی نَاقَۃً حَیَاتَہُ ، فَنَمَتْ حَتَّی صَارت إبْلاً ، فَمَا تری فِیہَا ؟ قَالَ : ہِیَ لَہُ حَیَاتَہُ وَمَوْتَہُ ، فَقَالَ ألأَعْرَابِیُّ : إنَّمَا جَعَلْتہَا صَدَقَۃً ، قَالَ : ذَلِکَ أَبْعَدُ لَکَ مِنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 23071","","","كتاب البيوع والأقضية"
"23072","(۲۳۰۷۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ: سَأَلْتُ إبْرَاہِیمَ عَنِ السُّکْنَی؟ قَالَ: تَرْجِعُ إلَی وَرَثَۃِ الْمُسْکِنِ ، فَقُلْتُ: یَا أَبَا عِمْرَانَ أَلَیْسَ کَانَ یُقَالُ : مَنْ مَلَکَ شَیْئًا حَیَاتَہُ ، فَہُوَ لَہُ حَیَاتَہُ ومَوْتَہ ؟ قَالَ : ذَلِکَ فِی الْعُمْرَی۔","","Musannaf Ibn Abi Shaybah 23072","","","كتاب البيوع والأقضية"
"23073","(۲۳۰۷۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، عَنِ الْحَسَنِ ، قَالَ : سَمِعْتُہُ یَقُولُ : إذَا أَعْطَی الرَّجُلُ الرَّجُلَ الدَّارَ حَیَاتَہُ فَہِیَ لَہُ حَیَاتَہُ وَبَعْدَ مَوْتِہِ۔","","Musannaf Ibn Abi Shaybah 23073","","","كتاب البيوع والأقضية"
"23074","(۲۳۰۷۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ، عَنِ ابْنِ سِیرِینَ، عَنْ شُرَیْحٍ، قَالَ: جَائَہُ رَجُلٌ أَعْمَی یُخَاصِمُ فِی أَمَۃٍ أُعْمِرَہَا ، فَقَضَی بِہَا شُرَیْحٌ لِلَّذِی أَعْمَرَہَا ، فَقَالَ الرَّجُلُ : قَضَیْت عَلَیَّ ، فَقَالَ : مَا أَنَا قَضَیْت عَلَیْک ، وَلَکِنْ قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَلَکَ شَیْئًا حَیَاتَہُ ، فَہُوَ لَہُ حَیَاتَہُ وَمَوْتہ۔n(بیہقی ۱۷۵۔ عبدالرزاق ۱۶۸۸۰)","","Musannaf Ibn Abi Shaybah 23074","","","كتاب البيوع والأقضية"
"23075","(۲۳۰۷۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا ابْنُ أَبِی خَالِدٍ، عَنِ الشَّعْبِیِّ، قَالَ: إذَا قَالَ ہِیَ لَکَ حَیَاتک فہی لہ حیاتہ وَمَوْتَہُ۔","","Musannaf Ibn Abi Shaybah 23075","","","كتاب البيوع والأقضية"
"23076","(۲۳۰۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ أُعْمِرَ عُمْرَی فَہِیَ لَہُ وَلِوَرَثَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 23076","","","كتاب البيوع والأقضية"
"23077","(۲۳۰۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا حَجَّاجُ بْنُ أَبِی عُثْمَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا مَعْشَرَ الأَنْصَارِ ، أَمْسِکُوا عَلَیْکُمْ أَمْوَالَکُمْ لاَ تُعْمِرُوہَا فَإِنَّہُ مَنْ أَعْمَرَ شَیْئًا فَإِنَّہُ لِمَنْ أُعْمِرَہُ۔ (مسلم ۲۷۔ احمد ۳/۳۱۷)","Sahih","Musannaf Ibn Abi Shaybah 23077","","","كتاب البيوع والأقضية"
"23078","(۲۳۰۷۸) حَدَّثَنَا یَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : سَمِعْتُ مُعَاوِیَۃَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعُمْرَی جَائِزَۃٌ لأَہْلِہَا۔n(احمد ۴/۹۷۔ ابویعلی ۷۳۳۱)","Da'if","Musannaf Ibn Abi Shaybah 23078","","","كتاب البيوع والأقضية"
"23079","(۲۳۰۷۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ جَابِرٍ ، قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْعُمْرَی لَہُ وَلِعَقِبِہِ بَتْلَۃً ، لَیْسَ لِلْمُعْطِی فِیہَا شَرْطٌ وَلاَ ثُنْیَا۔n(بخاری ۲۶۲۵۔ مسلم ۱۲۴۶)","Sahih","Musannaf Ibn Abi Shaybah 23079","","","كتاب البيوع والأقضية"
"23080","(۲۳۰۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنِ النَّضْرِ بْنِ أَنَسٍ ، عَنْ بَشِیرِ بْنِ نَہِیکٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعُمْرَی جَائِزَۃٌ لأَہْلِہَا ، أَوْ مِیرَاثٌ لأَہْلِہَا۔n(مسلم ۳۲۔ احمد ۲/۴۶۸)","Sahih","Musannaf Ibn Abi Shaybah 23080","","","كتاب البيوع والأقضية"
"23081","(۲۳۰۸۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، أَنَّہُمَا قَالاَ : یَرْجِعُ صَاحِبُ الْعُمْرَی مَا دَامَا حَیَّیْنِ۔","","Musannaf Ibn Abi Shaybah 23081","","","كتاب البيوع والأقضية"
"23082","(۲۳۰۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ زِیَادِ بْنِ أَبِی الْجَعْدِ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ: نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الرُّقْبَی، وَقَالَ: مَنْ أُرْقِبَ رُقْبَی فَہِیَ لَہُ۔(نسائی ۶۵۶۶۔ احمد ۲/۲۶)","Sahih","Musannaf Ibn Abi Shaybah 23082","","","كتاب البيوع والأقضية"
"23083","(۲۳۰۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَنْظَلَۃُ ، عَنْ طَاوُوسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَحِلُّ الرُّقْبَی ، فَمَنْ أُرْقِبَ رُقْبَی فَہِیَ فِی سَبِیلِ الْمِیرَاثِ۔ (ابوداؤد ۳۵۵۴۔ عبدالرزاق ۱۶۹۱۳)","","Musannaf Ibn Abi Shaybah 23083","","","كتاب البيوع والأقضية"
"23084","(۲۳۰۸۴) حَدَّثَنَا ابن علیۃ ، عن ابن أبی نجیح ، عن طاوس قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ رُقْبَی ، مَنْ أُرْقِبَ رُقْبَی فَہِیَ لورثۃ المرقب۔","","Musannaf Ibn Abi Shaybah 23084","","","كتاب البيوع والأقضية"
"23085","(۲۳۰۸۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا شُعْبَۃُ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ مُجَاہِدٍ، قَالَ: قَالَ عَلِیٌّ: الْعُمْرَی وَالرُّقْبَی سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 23085","","","كتاب البيوع والأقضية"
"23086","(۲۳۰۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ حَسَّانَ ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ : مَنْ أُعْمِرَ عُمْرَی فَہِیَ لَہُ وَلِوَرَثَتِہِ مِنْ بَعْدِہِ لاَ تَرْجِعُ إلَی الَّذِی أَعْمَرَہَا ، وَالرُّقْبَی مِثْلُہَا ، قُلْتُ لِمُجَاہِدٍ : مَا الرُّقْبَی ؟ قَالَ : قَوْلُ الرَّجُلِ : ہِیَ لِلآخِرِ مِنِّی وَمِنْک۔","","Musannaf Ibn Abi Shaybah 23086","","","كتاب البيوع والأقضية"
"23087","(۲۳۰۸۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الرُّقْبَی وَالْعُمْرَی سَوَائٌ ، قَالَ وَکِیعٌ : الْعُمْرَی وَالْہِبَۃُ وَالْعَطِیَّۃُ وَالنُّحْلَۃُ إذَا قُبِضَتْ فَہِیَ جَائِزَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 23087","","","كتاب البيوع والأقضية"
"23088","(۲۳۰۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ عَسْبِ الْفَحْلِ۔ (احمد ۲/۲۹۹۔ دارمی ۲۶۲۳)","Da'if","Musannaf Ibn Abi Shaybah 23088","","","كتاب البيوع والأقضية"
"23089","(۲۳۰۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ أَبِی کُلَیْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی نُعْمٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : نُہِیَ عَنْ عَسْبِ الْفَحْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 23089","","","كتاب البيوع والأقضية"
"23090","(۲۳۰۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی مُعَاذٍ ، قَالَ : کُنْتُ تَیَّاسًا فَنَہَانِی الْبَرَائُ عَنْ عَسْبِی۔","Da'if","Musannaf Ibn Abi Shaybah 23090","","","كتاب البيوع والأقضية"
"23091","(۲۳۰۹۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مِنَ السُّحْتِ ضِرَابُ الْفَحْلِ وَمَہْرُ الْبَغِیِّ وَکَسْبُ الْحَجَّامِ۔","Sahih","Musannaf Ibn Abi Shaybah 23091","","","كتاب البيوع والأقضية"
"23092","(۲۳۰۹۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ طَرْقِ الْفَحْلِ۔ (مسلم ۱۱۹۷۔ نسائی ۶۲۶۶)","Sahih","Musannaf Ibn Abi Shaybah 23092","","","كتاب البيوع والأقضية"
"23093","(۲۳۰۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْوَلِیدُ بْنُ عِیسَی السَّعْدِیُّ ، قَالَ : قُلْتُ لِلْحَسَنِ : إنَّ لَنَا تُیُوسًا نُؤَاجِرُہَا ، قَالَ : لاَ بَأْسَ مَا لَمْ تُحْلَبْ ، أَوْ تُبْسَر۔","","Musannaf Ibn Abi Shaybah 23093","","","كتاب البيوع والأقضية"
"23094","(۲۳۰۹۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ تَأْخُذْ عَلَی ضِرَابِ الْفَحْلِ أَجْرًا ، وَلاَ بَأْسَ أَنْ تُعْطِیَ إذَا لَمْ تَجِدْ مَنْ یُطْرِقُکَ۔","","Musannaf Ibn Abi Shaybah 23094","","","كتاب البيوع والأقضية"
"23095","(۲۳۰۹۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : کَانُوا یَدْخُلُونَ عَلَی عَلْقَمَۃَ وَہُوَ یُقْرِعُ غَنَمَہُ یَعْنِی یُنْزِی عَلَیْہَا التَّیْسَ وَیَعْلِفَ وَیَحْلُبُ۔","","Musannaf Ibn Abi Shaybah 23095","","","كتاب البيوع والأقضية"
"23096","(۲۳۰۹۶) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: لاَ یُسْلَمُ مَا یُکَالُ فِیمَا یُکَالُ، وَلاَ یُسْلَمُ مَا یُوزَنُ فِیمَا یُوزَنُ۔","","Musannaf Ibn Abi Shaybah 23096","","","كتاب البيوع والأقضية"
"23097","(۲۳۰۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : لاَ تُسْلِمُ طَعَاماً فِی طَعَامٍ ، وَلاَ لَحْماً فِی لَحْمٍ ، وَکَانَ لاَ یَرَی بَأْسًا أَنْ یُسْلِمَ طَعَامًا فِی الشَّاۃِ الْقَائِمَۃِ۔","","Musannaf Ibn Abi Shaybah 23097","","","كتاب البيوع والأقضية"
"23098","(۲۳۰۹۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ سَالِمٍ ، قَالَ : قَالَ الشَّعْبِیُّ : لاَ تَشْتَرِ شَیْئًا یُکَالُ بِشَیْئٍ یکال إلَی أَجَلٍ۔","","Musannaf Ibn Abi Shaybah 23098","","","كتاب البيوع والأقضية"
"23099","(۲۳۰۹۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنِ الْحَسَنِ وَقَتَادَۃَ : أَنَّہُمَا کَرِہَا أَنْ یُسْلِمَ طَعَامًا فِی طَعَامٍ۔","","Musannaf Ibn Abi Shaybah 23099","","","كتاب البيوع والأقضية"
"23100","(۲۳۱۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یُسْلِمَ مَا یُکَالُ فِیمَا یُکَالُ ، وَمَا یُوزَنُ فِیمَا یُوزَنُ ، إنَّمَا ہُوَ طَعَامٍ بِطَعَامٍ۔","","Musannaf Ibn Abi Shaybah 23100","","","كتاب البيوع والأقضية"
"23101","(۲۳۱۰۱) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : فِی الرَّجُلِ یَدْفَعُ إلَی الرَّجُلِ مَالاً مُضَارَبَۃً أَنَّہُ ضَامِنٌ ، قَالَ : لَیْسَ بِضَامِنٍ۔","","Musannaf Ibn Abi Shaybah 23101","","","كتاب البيوع والأقضية"
"23102","(۲۳۱۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، قَالَ : کُلُّ شَرْطٍ فِی مُضَارَبَۃٍ ، فَہُوَ رِبًا وَہُوَ قَوْلُ قَتَادَۃَ۔","","Musannaf Ibn Abi Shaybah 23102","","","كتاب البيوع والأقضية"
"23103","(۲۳۱۰۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : أَنَّہُ سُئِلَ عَنْ رَجُلٍ دَفَعَ إلَی رَجُلٍ مَالاً مُضَارَبَۃً وَضَمَّنَہُ إیَّاہُ ، قَالَ : الرِّبْحُ بَیْنَہُمَا ، وَلاَ یُلْتَفَتُ إلَی ضَمَانِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23103","","","كتاب البيوع والأقضية"
"23104","(۲۳۱۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : إذَا کَانَ لِلْمُشْرِکِ مَمْلُوکٌ فَأَسْلَمَ ، اُنْتُزِعَ مِنْہُ فَبِیعَ لِلْمُسْلِمِینَ وَرُدَّ ثَمَنُہُ عَلَی صَاحِبِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 23104","","","كتاب البيوع والأقضية"
"23105","(۲۳۱۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : أَنَّہُ کَانَ یَأْمُرُ بِبَیْعِ رَقِیقِ أَہْلِ الذِّمَّۃِ إذَا أَسْلَمُوا۔","","Musannaf Ibn Abi Shaybah 23105","","","كتاب البيوع والأقضية"
"23106","(۲۳۱۰۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَسْلَمَتْ أُمُّ وَلَدِ النَّصْرَانِیِّ سَعَتْ فِی قِیمَتِہَا ، وَإِذَا أَسْلَمَتْ أَمَۃٌ بَاعَہَا۔","","Musannaf Ibn Abi Shaybah 23106","","","كتاب البيوع والأقضية"
"23107","(۲۳۱۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا أَسْلَمَ عَبْدُ الذِّمِّیِّ فُرِّقَ بَیْنَہُ وَبَیْنَ مَوْلاَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23107","","","كتاب البيوع والأقضية"
"23108","(۲۳۱۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُبَارَکٌ ، عَنِ الْحَسَنِ ، قَالَ : مَنْ کَانَ من فتیتہِمْ فَأَسْلَمَ ، فَہُوَ حُرٌّ ، وَمَا اشْتَرَوْا مِنْ سَبْیِ الْمُسْلِمِینَ فَأَسْلَمَ بِیعَ فِی الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 23108","","","كتاب البيوع والأقضية"
"23109","(۲۳۱۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَسْلَمَ عَبْدُ الذِّمِّیِّ رُفِعَ إلَی الإِمَامِ فَبَاعَہُ فِی الْمُسْلِمِینَ ، وَدَفَعَ ثَمَنَہُ إلَی مَوْلاَہُ۔ وَقَالَ الْحَسَنُ : لاَ یَخْدِم مُسْلِمٌ کَافِرًا۔","","Musannaf Ibn Abi Shaybah 23109","","","كتاب البيوع والأقضية"
"23110","(۲۳۱۱۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ، قَالَ: مَضَتِ السُّنَّۃُ أَنْ لاَ یَسْتَرِقَّ کَافِرٌ مُسْلِمًا۔","","Musannaf Ibn Abi Shaybah 23110","","","كتاب البيوع والأقضية"
"23111","(۲۳۱۱۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : { وَلاَ تَمْنُنْ تَسْتَکْثِرُ } قَالَ : لاَ تُعْطِ لِتَزْدَادَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23111","","","كتاب البيوع والأقضية"
"23112","(۲۳۱۱۲) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، قَالَ: حدَّثَنِی مَنْ سَمِعَ عِکْرِمَۃَ یَقُولُ: لاَ تُعْطِ الْعَطِیَّۃَ فَتُرِیدُ أَنْ تَأْخُذَ أَکْثَرَ مِنْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23112","","","كتاب البيوع والأقضية"
"23113","(۲۳۱۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ نُبَیْطٍ، عَنِ الضَّحَّاکِ: {وَلاَ تَمْنُنْ تَسْتَکْثِرُ} قَالَ : لاَ تُعْطِ لِتُعْطَی أَکْثَرَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 23113","","","كتاب البيوع والأقضية"
"23114","(۲۳۱۱۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، قَالَ : سَمِعْتُ الضَّحَّاکَ : {وَمَا آتَیْتُمْ مِنْ رِبًا لِیَرْبُوَا فِی أَمْوَالِ النَّاسِ فَلاَ یَرْبُوا عِنْدَ اللہِ} قَالَ : ہَذَا کَانَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَاصَّۃً۔","","Musannaf Ibn Abi Shaybah 23114","","","كتاب البيوع والأقضية"
"23115","(۲۳۱۱۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الْحَسَنِ : فِی قَوْلِہِ : {وَلاَ تَمْنُنْ تَسْتَکْثِرُ} قَالَ : لاَ تَمْنُنْ عَمَلَک عَلَی رِبًا لِتَسْتَکْثِرَ عَلَی رَبِّک۔","","Musannaf Ibn Abi Shaybah 23115","","","كتاب البيوع والأقضية"
"23116","(۲۳۱۱۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْقَاسِمِ بْنِ أَبِی بَزَّۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَفِی قَوْلِہِ : {وَلاَ تَمْنُنْ تَسْتَکْثِرُ} قَالَ: لاَ تُعْطِی شَیْئًا تَطْلُبُ أَکْثَرَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 23116","","","كتاب البيوع والأقضية"
"23117","(۲۳۱۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورِ بْنِ صَفِیَّۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الرَّجُلُ یُعْطِی لِیُثَابَ عَلَیْہِ ، {وَمَا آتَیْتُمْ مِنْ رِبًا لِیَرْبُوَا فِی أَمْوَالِ النَّاسِ فَلاَ یَرْبُوا عِنْدَ اللہِ}۔","","Musannaf Ibn Abi Shaybah 23117","","","كتاب البيوع والأقضية"
"23118","(۲۳۱۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْہَدَایَا۔","","Musannaf Ibn Abi Shaybah 23118","","","كتاب البيوع والأقضية"
"23119","(۲۳۱۱۹) حَدَّثَنَا وَکِیعٌ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ الرَّجُلُ یُعْطِی قَرَابَتَہُ لِیَکْثُرَ بِذَلِکَ مَالَہُ۔","","Musannaf Ibn Abi Shaybah 23119","","","كتاب البيوع والأقضية"
"23120","(۲۳۱۲۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، {وَمَا آتَیْتُمْ مِنْ رِبًا لِیَرْبُوَا فِی أَمْوَالِ النَّاسِ فَلاَ یَرْبُوا عِنْدَ اللہِ} ہُوَ الَّذِی یَتَعَاطَی النَّاسُ بَیْنَہُمْ مِنَ المَعْرُوفٍ الْتِمَاسَ الثَّوَابِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23120","","","كتاب البيوع والأقضية"
"23121","(۲۳۱۲۱) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی حَوَانِیتِ السُّوقِ إذْنٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 23121","","","كتاب البيوع والأقضية"
"23122","(۲۳۱۲۲) حَدَّثَنَا حَفْصٌ وَابْنُ عُلَیَّۃَ وَعَبْدُ السَّلاَمِ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا فَتَحَ السُّوقِی بَابَہُ وَجَلَسَ ، فَقَدْ أَذِنَ۔","","Musannaf Ibn Abi Shaybah 23122","","","كتاب البيوع والأقضية"
"23123","(۲۳۱۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ إبْرَاہِیمُ التَّیْمِیُّ وَإِبْرَاہِیمُ النَّخَعِیُّ وَخَیْثَمَۃُ وَأَصْحَابُنَا یَأْتُونَا فِی حَوَانِیتِ السُّوقِ فَلاَ یَزِیدُونَ عَلَی أَنْ یَقُولُوا : السَّلاَمُ عَلَیْکُمْ ، ثُمَّ یَدْخُلُونَ۔","","Musannaf Ibn Abi Shaybah 23123","","","كتاب البيوع والأقضية"
"23124","(۲۳۱۲۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ عِکْرِمَۃَ : أَنَّہُ قِیلَ لَہُ : کَانَ ابْنُ عُمَرَ یَسْتَأْذِنُ عَلَی حَوَانِیتِ السُّوقِ ؟ فَقَالَ : وَمَنْ یُطِیقُ مَا کَانَ ابْنُ عُمَرَ یُطِیقُ؟","Sahih","Musannaf Ibn Abi Shaybah 23124","","","كتاب البيوع والأقضية"
"23125","(۲۳۱۲۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ ابْنُ سِیرِینَ یَأْتِینِی فِی حُجْرَۃِ بُرِّیٍّ فَیَقُولُ : السَّلاَمُ عَلَیْکُمْ، ثُمَّ یَلِجُ۔","","Musannaf Ibn Abi Shaybah 23125","","","كتاب البيوع والأقضية"
"23126","(۲۳۱۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شُعَیْبٍ ، قَالَ : کَانَ أَبُو الْعَالِیَۃِ یَأْتِی فِی بَیْتِ بُرِّیٍّ فَیَقُولُ : السَّلاَمُ عَلَیْکُمْ أَلِجُ ؟ فَأَقُولُ : رَحِمَک اللَّہُ ، إنَّمَا ہِیَ السُّوقُ ، فَیَقُولُ : إنَّ الرَّجُلَ رُبَّمَا خَلاَ عَلَی حِسَابِہِ وَرُبَّمَا خَلاَ عَلَی الدَّرَاہِمِ یَتَفَقَّدُہَا۔","","Musannaf Ibn Abi Shaybah 23126","","","كتاب البيوع والأقضية"
"23127","(۲۳۱۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کُنْتُ مَعَ مُجَاہِدٍ فِی سُوقِ الْکُوفَۃِ وَخِیَامٌ لِلْخَیَّاطَیْنِ مُقْبِلَۃٌ عَلَی السُّوقِ مِمَّا یَلِی دُورَ بنی الْبَکّائِ ، فَقَالَ : کَانَ ابْنُ عُمَرَ یَسْتَأْذِنُ فِی مِثْلِ ہَذِہِ قَالَ : وَقُلْتُ : کَیْفَ یَصْنَعُ ؟ قَالَ : کَانَ یَقُولُ : السَّلاَمُ عَلَیْکُمْ أَلِجُ ؟ ثُمَّ یَلِجُ۔","Sahih","Musannaf Ibn Abi Shaybah 23127","","","كتاب البيوع والأقضية"
"23128","(۲۳۱۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُبَادَۃُ بْنُ مُسْلِمٍ الْفَزَارِیّ ، عَنْ دِرْہَمٍ أَبِی عُبَیْدٍ الْمُحَارِبِیِّ ، قَالَ : رَأَیْتُ عَلِیًّا أَصَابَتْہُ السَّمَائُ وَہُوَ فِی السُّوقِ ، فَاسْتَظَلَّ بِخَیْمَۃِ الْفَارِسِیِّ ، فَجَعَلَ الْفَارِسِیُّ یَدْفَعُہُ ، عَنْ خَیْمَتِہِ وَجَعَلَ عَلِیٌّ یَقُول : إنَّمَا أَسْتَظِلُّ مِنَ الْمَطَرِ ، فَأُخْبِرَ الْفَارِسِیُّ بَعْدُ أَنَّہُ عَلِیٌّ فَجَعَلَ یَضْرِبُ صَدْرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 23128","","","كتاب البيوع والأقضية"
"23129","(۲۳۱۲۹) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ عَنْ شُرَیْحٍ : أَنَّہُ أَجَازَ شَہَادَۃَ امْرَأَتَیْنِ فِی عِتْقٍ۔","","Musannaf Ibn Abi Shaybah 23129","","","كتاب البيوع والأقضية"
"23130","(۲۳۱۳۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : أَنَّہُ أَجَازَ شَہَادَۃَ امْرَأَتَیْنِ فِی عِتْقٍ ، إحْدَاہُمَا خَالَۃ۔ یَعْنِی : مَعْہُمَا رَجُلٌ۔","","Musannaf Ibn Abi Shaybah 23130","","","كتاب البيوع والأقضية"
"23131","(۲۳۱۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَجُوزُ شَہَادَۃُ النِّسَائِ فِی الْعَتَاقَۃِ وَالدَّیْنِ وَالْوَصِیَّۃِ۔ یَعْنِی : مَعَ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 23131","","","كتاب البيوع والأقضية"
"23132","(۲۳۱۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ یُجِیزُ شَہَادَۃَ النِّسَائِ فِی الْحُقُوقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23132","","","كتاب البيوع والأقضية"
"23133","(۲۳۱۳۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ النِّسَائِ إلاَّ فِی الدَّیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23133","","","كتاب البيوع والأقضية"
"23134","(۲۳۱۳۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : یُجِیزُ شَہَادَۃَ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 23134","","","كتاب البيوع والأقضية"
"23135","(۲۳۱۳۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : تَجُوزُ شَہَادَتَہُنَّ فِی الدَّیْنِ وَفِیمَا لاَ بُدَّ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 23135","","","كتاب البيوع والأقضية"
"23136","(۲۳۱۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ : سَأَلَ الْمُغِیرَۃُ بْنُ سَعِیدٍ الشَّعْبِیَّ : أَتَجُوزُ شَہَادَۃُ الرَّجُلِ وَالْمَرْأَتَیْنِ فِی الطَّلاَقِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 23136","","","كتاب البيوع والأقضية"
"23137","(۲۳۱۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنِ الزُّبَیْرِ بْنِ الْخِرِّیتِ ، عَنْ أَبِی لَبِیدٍ : أَنَّ عُمَرَ أَجَازَ شَہَادَۃَ النِّسَائِ فِی الطَّلاَقِ۔","","Musannaf Ibn Abi Shaybah 23137","","","كتاب البيوع والأقضية"
"23138","(۲۳۱۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ رَاشِدٍ ، عَنْ أَبِی کَثِیرٍ الْحَنَفِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّہُ کَرِہَ أَنْ یَبِیعَ ثَمَرَتَہُ وَیَتَبَرَّأ مِنَ الصَّدَقَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 23138","","","كتاب البيوع والأقضية"
"23139","(۲۳۱۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ عَمْرِو بْنِ شُعَیْبٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ یَبْرَأ مِنَ الصَّدَقَۃِ۔","","Musannaf Ibn Abi Shaybah 23139","","","كتاب البيوع والأقضية"
"23140","(۲۳۱۴۰) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا بِعْتَ ثَمَرَتَکَ أَو ثَمَرَۃ حَائِطِکَ فَالصَّدَقَۃُ فِی الْحَائِطِ۔n وَقَالَ ابْنُ أَبِی مُلَیْکَۃَ : ہِیَ عَلَی الْمُبْتَاعِ۔","","Musannaf Ibn Abi Shaybah 23140","","","كتاب البيوع والأقضية"
"23141","(۲۳۱۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ أَطْیَبَ مَا أَکَلَ الرَّجُلُ مِنْ کَسْبِہِ ، وَوَلَدُہُ مِنْ کَسْبِہِ۔n(احمد ۶/۴۲۔ ابن حبان ۴۲۶۱)","Sahih","Musannaf Ibn Abi Shaybah 23141","","","كتاب البيوع والأقضية"
"23142","(۲۳۱۴۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ : أَنَّ رَجُلاً خَاصَمَ أَبَاہُ فِی مَالٍ کَانَ أَصَابَہُ ، إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : أَنْتَ وَمَالُکَ لأَبِیکَ۔ (ابن ماجہ ۲۲۹۱)","","Musannaf Ibn Abi Shaybah 23142","","","كتاب البيوع والأقضية"
"23143","(۲۳۱۴۳) حَدَّثَنَا خلف بْنُ خَلِیفَۃَ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْوَلَدُ مِنْ کَسْبِ الْوَالِدِ۔ (طبرانی ۵۱۳۲)","","Musannaf Ibn Abi Shaybah 23143","","","كتاب البيوع والأقضية"
"23144","(۲۳۱۴۴) حَدَّثَنَا وَکِیعٌ وَغُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ اللَّیثِی ، عَنْ أُمِّہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَلَدُ الرَّجُلِ مِنْ کَسْبِہِ ، مِنْ أَطْیَبِ کَسْبِہِ۔n(ابوداؤد ۳۵۲۳۔ احمد ۱۲۶)","Da'if","Musannaf Ibn Abi Shaybah 23144","","","كتاب البيوع والأقضية"
"23145","(۲۳۱۴۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، عَنْ عَمَّتِہِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِنَحْوِہِ۔ (ترمذی ۱۳۵۸۔ احمد ۱۶۲)","Da'if","Musannaf Ibn Abi Shaybah 23145","","","كتاب البيوع والأقضية"
"23146","(۲۳۱۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : یَأْکُلُ الرَّجُلُ مِنْ مَالِ وَلَدِہِ مَا شَائَ ، وَلاَ یَأْکُلُ الْوَلَدُ مِنْ مَالِ وَالِدِہِ إلاَّ بِإِذْنِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 23146","","","كتاب البيوع والأقضية"
"23147","(۲۳۱۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا دَاوُد بْنُ عَبْدِ اللہِ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : قَالَتْ عَائِشَۃُ : وَلَدُ الرَّجُلِ مِنْ کَسْبِہِ ، یَأْکُلُ مِنْ مَالِہِ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 23147","","","كتاب البيوع والأقضية"
"23148","(۲۳۱۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، قَالَ : جَائَ رَجُلٌ مِنَ الأَنْصَارِ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، إنَّ أَبِی غَصَبَنِی مَالِی ، فَقَالَ : أَنْتَ وَمَالُکَ لأَبِیکَ۔","Da'if","Musannaf Ibn Abi Shaybah 23148","","","كتاب البيوع والأقضية"
"23149","(۲۳۱۴۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَأْکُلُ الْوَالِدُ مِنْ مَالِ وَلَدِہِ مَا شَائَ ، وَلاَ یَأْکُلُ الْوَلَدُ مِنْ مَالِ وَالِدِہِ إلاَّ بِطِیبِ نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 23149","","","كتاب البيوع والأقضية"
"23150","(۲۳۱۵۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ وَوَکِیعٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 23150","","","كتاب البيوع والأقضية"
"23151","(۲۳۱۵۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 23151","","","كتاب البيوع والأقضية"
"23152","(۲۳۱۵۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ صَالِحِ بْنِ حَیٍّ ، عَنْ عَامِرٍ ، قَالَ : الرَّجُلُ فِی حِلٍّ مِنْ مَالِ وَلَدِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23152","","","كتاب البيوع والأقضية"
"23153","(۲۳۱۵۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : صَنَعَ رَجُلٌ فِی مَالِہِ شَیْئًا وَلَمْ یَسْتَأْذِنْ أَبَاہُ ، قَالَ ہِشَامٌ : قَالَ أَبِی : فَسَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَوْ أَبَا بَکْرٍ ، أَوْ عُمَرَ فَقَالَ : اُرْدُدْہ عَلَیْہِ فَإِنَّمَا ہُوَ سَہْمٌ مِنْ کِنَانَتِک۔ (عبدالرزاق ۱۶۶۲۷)","","Musannaf Ibn Abi Shaybah 23153","","","كتاب البيوع والأقضية"
"23154","(۲۳۱۵۴) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : کَانَ عَطَائٌ لاَ یَرَی بَأْسًا أَنْ یَأْخُذَ الرَّجُلُ مِنْ مَالِ وَلَدِہِ مَا شَائَ مِنْ غَیْرِ ضَرُورَۃٍ۔","","Musannaf Ibn Abi Shaybah 23154","","","كتاب البيوع والأقضية"
"23155","(۲۳۱۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ مَسْرُوقٍ ، قَالَ : أَنْتَ مِنْ ہِبَۃِ اللہِ لأَبِیکَ ، أَنْتَ وَمَالُکَ لأَبِیکَ ، ثُمَّ قَرَأ : {یَہَبُ لِمَنْ یَشَائُ إنَاثًا وَیَہَبُ لِمَنْ یَشَائُ الذُّکُورَ}۔","","Musannaf Ibn Abi Shaybah 23155","","","كتاب البيوع والأقضية"
"23156","(۲۳۱۵۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ : أَنَّ رَجُلاً أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ إنَّ أَبِی اجْتَاحَ مَالِی ، فَقَالَ : أَنْتَ وَمَالُکَ لأَبِیکَ۔n(ابوداؤد ۳۵۲۴۔ احمد ۲/۲۰۴)","","Musannaf Ibn Abi Shaybah 23156","","","كتاب البيوع والأقضية"
"23157","(۲۳۱۵۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : عَلَی الْوَلَدِ أَنْ یَبَرَّ وَالِدَہُ ، وَکُلُّ إنْسَانٍ أَحَقُّ بِالَّذِی لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23157","","","كتاب البيوع والأقضية"
"23158","(۲۳۱۵۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قَالَ رَجُلٌ لِلْقَاسِمِ بْنِ مُحَمَّدٍ : أَیَعْتَصِرُ الرَّجُلُ مِنْ مَالِ وَلَدِہِ مَا شَائَ ؟ فَقَالَ : مَا أَدْرِی مَا ہَذَا ؟۔","","Musannaf Ibn Abi Shaybah 23158","","","كتاب البيوع والأقضية"
"23159","(۲۳۱۵۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ : قَالَ خُذْ مِنْ مَالِ وَلَدِکَ مَا أَعْطَیْتَہُ ، وَلاَ تَأْخُذْ مِنْہُ مَا لَمْ تُعْطِہِ۔","","Musannaf Ibn Abi Shaybah 23159","","","كتاب البيوع والأقضية"
"23160","(۲۳۱۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ یُونُسَ بْنِ یَزِیدَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ : أَنَّ حَمْزَۃَ بْنَ عَبْدِ اللہِ بْنِ عُمَرَ نَحَرَ جَزُورًا ، فَجَائَ سَائِلٌ فَسَأَلَ ابْنَ عُمَرَ ، فَقَالَ عَبْدُ اللہِ : مَا ہِیَ لِی ، فَقَالَ حَمْزَۃُ : یَا أَبَتَاہُ ، فَأَنْتَ فِی حِلٍّ فَأَطْعِمْ مِنْہَا مَا شِئْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 23160","","","كتاب البيوع والأقضية"
"23161","(۲۳۱۶۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : یُنْفِقُ الرَّجُلُ مِنْ مَالِ وَلَدِہِ إذَا کَانَ مُحْتَاجًا بِقَدْرِ مَا أَنْفَقَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 23161","","","كتاب البيوع والأقضية"
"23162","(۲۳۱۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ الْحَن??فِیَّۃِ ، عَنْ عَلِیٍّ ، قَالَ : الرَّجُلُ أَحَقُّ بِمَالِ وَلَدِہِ إذَا کَانَ صَغِیرًا ، فَإِذَا کَبُرَ وَاحْتَازَ مَالَہُ کَانَ أَحَقَّ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 23162","","","كتاب البيوع والأقضية"
"23163","(۲۳۱۶۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ رَجُلٌ لِجَابِرِ بْنِ زَیْدٍ : إنَّ أَبِی یَحْرِمُنِی مَالَہُ ، یَقُولُ : لاَ أُعْطِیکَ مِنْہُ شَیْئًا ، قَالَ : کُلْ مِنْ مَالِ أَبِیک بِالْمَعْرُوفِ۔","","Musannaf Ibn Abi Shaybah 23163","","","كتاب البيوع والأقضية"
"23164","(۲۳۱۶۴) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ علِیٍّ وَعَبْدُ اللہِ ، قَالاَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالشُّفْعَۃِ لِلْجِوَارِ۔","","Musannaf Ibn Abi Shaybah 23164","","","كتاب البيوع والأقضية"
"23165","(۲۳۱۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ عَمَّنْ سَمِعَ عَلِیًّا ، وَعَبْدَ اللہِ یَقُولاَنِ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْجِوَارِ۔ (نسائی ۶۳۰۴۔ عبدالرزاق ۱۴۳۸۳)","Da'if","Musannaf Ibn Abi Shaybah 23165","","","كتاب البيوع والأقضية"
"23166","(۲۳۱۶۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ عَمْرِو بْنِ الشَّرِیدِ ، عَنْ أَبِی رَافِعٍ یَبْلُغُ بِہِ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْجَارُ أَحَقُّ بِصَقَبہِ۔ (بخاری ۶۹۷۷۔ ابوداؤد ۳۵۱۰)","Sahih","Musannaf Ibn Abi Shaybah 23166","","","كتاب البيوع والأقضية"
"23167","(۲۳۱۶۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃَََ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : جَارُ الدَّارِ أَحَقُّ بِالدَّارِ۔ (ابوداؤد ۳۵۱۱۔ احمد ۵/۱۲)","Hasan","Musannaf Ibn Abi Shaybah 23167","","","كتاب البيوع والأقضية"
"23168","(۲۳۱۶۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْجَارُ أَحَقُّ بِشُفْعَۃِ جَارِہِ إذَا کَانَ طَرِیقُہُمَا وَاحِدًا یُنْتَظَرُ بِہَا ، وَإِنْ کَانَ غَائِبًا۔n(ابوداؤد ۳۵۱۲۔ احمد ۳/۳۰۳)","Sahih","Musannaf Ibn Abi Shaybah 23168","","","كتاب البيوع والأقضية"
"23169","(۲۳۱۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْمُغِیرَۃِ الثَّقَفِیِّ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الشَّفِیعُ أَوْلَی مِنَ الْجَارِ ، وَالْجَارُ أَوْلَی مِنَ الْجُنُبِ۔ (عبدالرزاق ۱۴۳۹۰)","","Musannaf Ibn Abi Shaybah 23169","","","كتاب البيوع والأقضية"
"23170","(۲۳۱۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، قَالَ : حَدَّثَنَا عُمَرُ بْنُ رَاشِدٍ السُّلَمِیُّ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْجِوَارِ۔ (عبدالرزاق ۱۴۳۸۴)","Da'if","Musannaf Ibn Abi Shaybah 23170","","","كتاب البيوع والأقضية"
"23171","(۲۳۱۷۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ : أَنَّ عُمَرَ کَتَبَ إلَی شُرَیْحٍ : أَنْ یَقْضِیَ بِالْجِوَارِ ، قَالَ : فَکَانَ شُرَیْحٌ یَقْضِی لِلرَّجُلِ مِنْ أَہْلِ الْکُوفَۃِ عَلَی الرَّجُلِ مِنْ أَہْلِ الشَّامِ۔","","Musannaf Ibn Abi Shaybah 23171","","","كتاب البيوع والأقضية"
"23172","(۲۳۱۷۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْخَلِیطُ أَحَقُّ مِنَ الشَّفِیعِ ، وَالشَّفِیعُ أَحَقُّ مِنَ الْجَارِ ، وَالْجَارُ أَحَقُّ مِمَّنْ سِوَاہُ۔","","Musannaf Ibn Abi Shaybah 23172","","","كتاب البيوع والأقضية"
"23173","(۲۳۱۷۳) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : الشَّرِیکُ أَحَقُّ بِالشُّفْعَۃِ فَإِنْ لَمْ یَکُنْ لَہُ شَرِیکٌ فَالْجَارُ۔","","Musannaf Ibn Abi Shaybah 23173","","","كتاب البيوع والأقضية"
"23174","(۲۳۱۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، عَنْ إبْرَاہِیمَ ، قَالَ: الْخَلِیطُ أَحَقُّ مِنَ الْجَارِ ، وَالْجَارُ أَحَقُّ مِنْ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 23174","","","كتاب البيوع والأقضية"
"23175","(۲۳۱۷۵) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَیَّانَ ، عَنْ أَبِیہِ : أَنَّ عَمْرَو بْنَ حُرَیْثٍ کَانَ یَقْضِی بِالْجِوَارِ۔","","Musannaf Ibn Abi Shaybah 23175","","","كتاب البيوع والأقضية"
"23176","(۲۳۱۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حُسَیْنَ الْمُعَلِّمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ عَمْرِو بْنِ الشَّرِیدِ ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، أَرْضٌ لَیْسَ فِیہَا لأَحَدٍ قَسْمٌ وَلاَ شِرْکٌ إلاَّ الْجِوَارُ ، قَالَ : الْجَوارُ أَحَقُّ بِسَقَبِہِ مَا کَانَ۔ n(ابن ماجہ ۲۴۹۶۔ طحاوی ۱۲۴)","Sahih","Musannaf Ibn Abi Shaybah 23176","","","كتاب البيوع والأقضية"
"23177","(۲۳۱۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَتْ لَہُ شَرِکَۃٌ فِی أَرْضٍ أَوْ رَبْعَۃٍ فَلَیْسَ لَہُ أَنْ یَبِیعَ حَتَّی یَسْتَأْذِنَ شَرِیکَہُ ، فَإِنْ شَائَ أَخَذَ ، وَإِنْ شَائَ تَرَکَ۔ (مسلم ۱۲۲۹۔ ابوداؤد ۳۵۰۷)","Sahih","Musannaf Ibn Abi Shaybah 23177","","","كتاب البيوع والأقضية"
"23178","(۲۳۱۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الشَّیْبَانِیِّ، عَنْ حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: الشُّفْعَۃُ لِلْمُشْرِکِ وَالأَعْرَابِیِّ وَغَیْرِہِما۔n وَقَالَ الشَّعْبِیُّ : لاَ شُفْعَۃَ لأَعْرَابِیٍّ ، وَلاَ مُشْرِکٍ۔","","Musannaf Ibn Abi Shaybah 23178","","","كتاب البيوع والأقضية"
"23179","(۲۳۱۷۹) حَدَّثَنَا شَرِیکٌ، عَنْ لَیْثٍ، عَنْ مُہَاجِرٍ، عَنِ الشَّعْبِیِّ، قَالَ: لَیْسَ لأَعْرَابِیٍّ، وَلاَ لِمَنْ لاَ یَسْکُنُ الْمِصْرَ شُفْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 23179","","","كتاب البيوع والأقضية"
"23180","(۲۳۱۸۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ حُمَیْدٍ، عَنِ الْحَسَنِ، قَالَ: لَیْسَ لِلْیَہُودِیِّ وَلاَ النَّصْرَانِیِّ شُفْعَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 23180","","","كتاب البيوع والأقضية"
"23181","(۲۳۱۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ، عَنْ أَبِی الْمِقْدَامِ أَبِی فَرْوَۃ، قَالَ: حَدَّثَنِی جَارٌ لِی: أَنَّ شُرَیْحًا قَضَی لِنَصْرَانِیٍّ بِشُفْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 23181","","","كتاب البيوع والأقضية"
"23182","(۲۳۱۸۲) حَدَّثَنَا وَکِیعٌ ، حدَّثَنَا قَیْسُ بْنُ الرَّبِیعِ ، عَنْ خَالِدٍ الْحَذَّائِ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : لِلْیَہُودِیِّ وَالنَّصْرَانِیِّ شُفْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 23182","","","كتاب البيوع والأقضية"
"23183","(۲۳۱۸۳) حَدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ لِیَہُودِیٍّ ، وَلاَ نَصْرَانِیٍّ شُفْعَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 23183","","","كتاب البيوع والأقضية"
"23184","(۲۳۱۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : قَالَ لنَا سُفْیَانُ : لِلْیَہُودِیِّ وَالنَّصْرَانِیِّ شُفْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 23184","","","كتاب البيوع والأقضية"
"23185","(۲۳۱۸۵) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی لِلْکُفَّارِ شُفْعَۃً۔","","Musannaf Ibn Abi Shaybah 23185","","","كتاب البيوع والأقضية"
"23186","(۲۳۱۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : لِلأَعْرَابِیِّ شُفْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 23186","","","كتاب البيوع والأقضية"
"23187","(۲۳۱۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنِ الْحَکَمِ ، قَالَ : لِلأَعْرَابِیِّ شُفْعَۃٌ ، قَالَ وَکِیعٌ : قَالَ لَہُ شُفْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 23187","","","كتاب البيوع والأقضية"
"23188","(۲۳۱۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ أَبِی حَصِینٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ شُفْعَۃَ لِلأَعْرَابِیِّ۔","","Musannaf Ibn Abi Shaybah 23188","","","كتاب البيوع والأقضية"
"23189","(۲۳۱۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ سَعِیدِ بْنِ أَشْوَعَ ، قَالَ : لَیْسَ لِلأَعْرَابِیِّ شُفْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 23189","","","كتاب البيوع والأقضية"
"23190","(۲۳۱۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : مَالِکُ بْنُ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ وَأَبِی سَلَمَۃَ ، قَالَ : قَضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالشُّفْعَۃِ فی کل مَا لَمْ یُقْسَمْ ، فَإِذَا وَقَعَتِ الْحُدُودُ فَلاَ شُفْعَۃَ۔n(ابن ماجہ ۲۴۹۷۔ مالک ۱)","","Musannaf Ibn Abi Shaybah 23190","","","كتاب البيوع والأقضية"
"23191","(۲۳۱۹۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عُمَارَۃَ ، عَنْ أَبِی بَکْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ أَبَانَ بْنِ عُثْمَانَ ، قَالَ : قَالَ عُثْمَانُ : لاَ شُفْعَۃَ فِی بِئْرٍ ، وَلاَ فَحْلٍ ، وَالأرف تَقْطَعُ کُلَّ شُفْعَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 23191","","","كتاب البيوع والأقضية"
"23192","(۲۳۱۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَوْنِ بْنِ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِاللہِ، قَالَ: قَالَ عُمَرُ بْنُ الْخَطَّابِ: إذَا وَقَعَتِ الْحُدُودُ وَعَرَفَ النَّاسُ حُدُودَہُمْ فَلاَ شُفْعَۃَ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 23192","","","كتاب البيوع والأقضية"
"23193","(۲۳۱۹۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ، عَنْ خَالِدٍ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ: أَنَّہُ کَانَ یَقْضِی بِالْجِوَارِ حَتَّی جَائَہُ کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ أَلاَ یَقْضِی بِہِ إلاَّ مَا کَانَ مِنْ شَرِیکَیْنِ مُخْتَلِطَیْنِ ، أَوْ دَارًا یُغْلَقُ عَلَیْہَا بَابٌ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 23193","","","كتاب البيوع والأقضية"
"23194","(۲۳۱۹۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی الزُّبَیْرُ بْنُ مُوسَی ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : إذَا قُسِّمَتِ الأَرْضُ وَحُدَّتْ وَصُرِفَتْ طُرُقُہَا فَلاَ شُفْعَۃَ۔","","Musannaf Ibn Abi Shaybah 23194","","","كتاب البيوع والأقضية"
"23195","(۲۳۱۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَوْنِ بْنِ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : إذَا وَقَعَتِ الْحُدُودُ وَعَرَفَ النَّاسُ حُقُوقَہُمْ فَلاَ شُفْعَۃَ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 23195","","","كتاب البيوع والأقضية"
"23196","(۲۳۱۹۶) حَدَّثَنَا عَبْدُالسَّلاَمِ بْنُ حَرْبٍ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ، قَالَ: إذَا کَانَ بَیْنَ الدَّارَیْنِ طَرِیقٌ فَلاَ شُفْعَۃَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 23196","","","كتاب البيوع والأقضية"
"23197","(۲۳۱۹۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنْ عُبَیْدَۃَ، قَالَ: سَمِعْتُ إبْرَاہِیمَ یَقُولُ: إذَا کَانَ بَیْنَہُمَا طَرِیقٌ فَاصِلٌ فَلاَ شُفْعَۃَ۔","","Musannaf Ibn Abi Shaybah 23197","","","كتاب البيوع والأقضية"
"23198","(۲۳۱۹۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ الشُّفْعَۃِ ؟ فَقَالَ : إذَا کَانَتِ الدَّارُ إلَی جَنْبِ الدَّارِ لَیْسَ بَیْنَہُمَا طَرِیقٌ فَفِیہَا شُفْعَۃٌ۔","","Musannaf Ibn Abi Shaybah 23198","","","كتاب البيوع والأقضية"
"23199","(۲۳۱۹۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ شُفْعَۃَ إلاَّ فِی تُرْبَۃٍ۔","","Musannaf Ibn Abi Shaybah 23199","","","كتاب البيوع والأقضية"
"23200","(۲۳۲۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : لاَ شُفْعَۃَ إلاَّ فِی جَرِیبٍ أَوْ عَقَارٍ۔","","Musannaf Ibn Abi Shaybah 23200","","","كتاب البيوع والأقضية"
"23201","(۲۳۲۰۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23201","","","كتاب البيوع والأقضية"
"23202","(۲۳۲۰۲) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالشُّفْعَۃِ فِی کُلِّ شَیْئٍ : الأَرْضِ ، وَالدَّارِ ، وَالْجَارِیَۃِ ، وَالْخَادِمِ۔n قَالَ: فَقَالَ : عَطَائٌ : إنَّمَا الشُّفْعَۃُ فِی الأَرْضِ وَالدَّارِ ، قَالَ : فَقَالَ ابْنُ أَبِی مُلَیْکَۃَ : تَسْمَعُنِی لاَ أُمَّ لَکَ! أَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ تَقُولُ مِثْلَ ہَذَا ؟۔ (ترمذی ۱۳۷۱۔ بیہقی ۱۰۹)","","Musannaf Ibn Abi Shaybah 23202","","","كتاب البيوع والأقضية"
"23203","(۲۳۲۰۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنِ الشَّعْبِیِّ ، قَالَ: فِی جَارَیِ الدَّارِ إذَا کَانَا فِی الْجِوَارِ سَوَائً فَأَیُّہُمَا سَبَقَ، فَہُوَ أَحَقُّ بِالشُّفْعَۃِ۔","","Musannaf Ibn Abi Shaybah 23203","","","كتاب البيوع والأقضية"
"23204","(۲۳۲۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : مَنْ بِیعَتْ شُفْعَتُہُ وَہُوَ شَاہِدٌ لاَ یُنْکِرُ فَلاَ شُفْعَۃَ لَہُ۔","","Musannaf Ibn Abi Shaybah 23204","","","كتاب البيوع والأقضية"
"23205","(۲۳۲۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ وَالْقَاسِمِ : فِی رَجُلٍ بِیعَتْ دَارُہُ وَہُوَ سَاکِتٌ لاَ یُنْکِرُ ، قَالاَ : یَلْزَمُہُ وَہُوَ جَائِزٌ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23205","","","كتاب البيوع والأقضية"
"23206","(۲۳۲۰۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ وَالْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ أَنَّہُمَا کَانَا یَقُولاَنِ لِلْمُبْتَاعِ : أَقِمِ الْبَیِّنَۃَ أَنَّہَا بِیعَتْ وَہُوَ شَاہِدٌ لاَ یُنْکِرُ۔","","Musannaf Ibn Abi Shaybah 23206","","","كتاب البيوع والأقضية"
"23207","(۲۳۲۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : إذَا أَذِنَ الشَّفِیعُ لِلْمُشْتَرِی فِی الشِّرَاء فَاشْتَرَی فَلاَ شُفْعَۃَ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23207","","","كتاب البيوع والأقضية"
"23208","(۲۳۲۰۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : قَالَ سُفْیَانُ : لَہُ الشُّفْعَۃُ لأَنَّ حَقَّہُ وَقَعَ بَعْدَ الْبَیْعِ۔","","Musannaf Ibn Abi Shaybah 23208","","","كتاب البيوع والأقضية"
"23209","(۲۳۲۰۹) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ : أَنَّ ابْنَ مَسْعُودٍ کَانَ یَکْرَہُ إذَا أَقْرَضَ الدَّرَاہِمَ أَنْ یَأْخُذَ خَیْرًا مِنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 23209","","","كتاب البيوع والأقضية"
"23210","(۲۳۲۱۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حجاج ، عن عطاء ، قَالَ : کان ابن عمر یستقرض ، فإذا خرج عطاؤہ أعطاہ خیرًا منہا۔","","Musannaf Ibn Abi Shaybah 23210","","","كتاب البيوع والأقضية"
"23211","(۲۳۲۱۱) حَدَّثَنَا قَطَریّ بْنُ عَبْدِ اللہِ أَبُو مُرَیٍّ ، عَنْ أَشْعَثَ الْحُدَّانِیِّ ، قَالَ : سَأَلْتُ الْحَسَنَ فَقُلْتُ : یَا أَبَا سَعِیدٍ ، تَجِیئُ الْکِبَارُ وَلِی جَارَاتٌ وَلَہُنَّ عَطَائٌ ، فَیَقْتَرِضْنَ مِنِّی ، وَنِیَّتِی فَضْلُ دِرْہَمِ الْعَطَائِ عَلَی دِرْہَمِی ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 23211","","","كتاب البيوع والأقضية"
"23212","(۲۳۲۱۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ زَکَرِیَّا ، قَالَ : قُلْتُ لِعَامِرٍ : الرَّجُلُ یَسْتَقْرِضُ ، فَإِذَا خَرَجَ عَطَاؤہُ أَعْطَانِی خَیْرًا مِنْہَا ، قَالَ : لاَ بَأْسَ مَا لَمْ تَشْتَرِطْ أَوْ تُعْطِہِ ، الْتِمَاسَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23212","","","كتاب البيوع والأقضية"
"23213","(۲۳۲۱۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : إذَا أَقْترَضْتَ شَیْئًا فَقَضَیْتَ أَفْضَلَ مِنْہُ فَلاَ بَأْسَ إِنْ لَمْ یَکُنْ شَرْطٌ عِنْدَ الْقَرْضِ۔","","Musannaf Ibn Abi Shaybah 23213","","","كتاب البيوع والأقضية"
"23214","(۲۳۲۱۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، قَالَ : سَأَلْتُُہُمَا عَنِ الرَّجُلِ یُقْرِضُ الرَّجُلَ الدَّرَاہِمَ فَیَأْخُذُ خَیْرًا مِنَ الَّذِی أَعْطَی ، فَقَالاَ : إِنْ لَمْ یَکُنْ نَوَی فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23214","","","كتاب البيوع والأقضية"
"23215","(۲۳۲۱۵) حَدَّثَنَا رَوَّادُ بْنُ جَرَّاحٍ ، عَنِ الأَوْزَاعِیِّ : فِی رَجُلٍ أَقْرَضَ رَجُلاً عَشَرَۃَ دَرَاہِمَ فَأَتَی بِعَشَرَۃٍ وَدَانِقَیْنِ ، قَالَ : لاَ تَقْبَلْ ، قُلْتُ لَہُ : إِنَّہُ قَدْ طَابَتْ نَفْسُہُ ، قَالَ : وَہَلْ یَکُونُ الرِّبَا إلأَعَنْ طِیبِ نَفْسٍ۔","","Musannaf Ibn Abi Shaybah 23215","","","كتاب البيوع والأقضية"
"23216","(۲۳۲۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنْ عَامِرٍ : فِی الرَّجُلِ یُقْرِضُ الرَّجُلَ الْقَرْضَ وَیَنْوِی أَنْ یُقْضَی أَجْوَدَ مِنْہُ ، قَالَ : ذَلِکَ أَخْبَثُ۔","","Musannaf Ibn Abi Shaybah 23216","","","كتاب البيوع والأقضية"
"23217","(۲۳۲۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : اسْتَقْرَضَ رَجُلٌ مِنَ ابْنِ مَسْعُودٍ دَرَاہِم فَقَضَاہُ، فَقَالَ لَہُ: الرَّجُلُ: إنِّی تَجَاوَزْتُ لَکَ مِنْ جَیِّدِ عَطَائِی، فَکَرِہَ ذَلِکَ ابْنُ مَسْعُودٍ وَقَالَ: مِثْلَ دَرَاہِمِی۔","","Musannaf Ibn Abi Shaybah 23217","","","كتاب البيوع والأقضية"
"23218","(۲۳۲۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنِ الْقَاسِمِ بْنِ أَبِی بَزَّۃَ ، عَنْ عَطَائِ بْنِ یَعْقُوبَ ، قَالَ : اسْتَسلَفَ مِنِّی ابْنُ عُمَرَ أَلْفَ دِرْہَمٍ فَقَضَانِی دَرَاہِمَ أَجْوَدَ مِنْ دَرَاہِمِی ، فَقَالَ : مَا کَانَ فِیہَا مِنْ فَضْلٍ ، فَہُوَ نَائِلٌ مِنِّی إلَیْک ، أَتَقْبَلُہُ ؟ قُلْتُ : نَعَمْ۔","Sahih","Musannaf Ibn Abi Shaybah 23218","","","كتاب البيوع والأقضية"
"23219","(۲۳۲۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ الرَّجُلِ یُقْرِضُ الرَّجُلَ الدَّرَاہِمَ فَیُعْطَی أَجْوَدَ مِنْہَا؟ قَالاَ : لاَ بَأْسَ مَا لَمْ تَکُنْ نِیَّتُہُ عَلَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23219","","","كتاب البيوع والأقضية"
"23220","(۲۳۲۲۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، عَنْ عَامِرٍ ، قَالَ : سَأَلْتُُہُ عن الرَّجُلُ یُقْرِضُ الرَّجُلَ الدَّرَاہِمَ فَیُعْطَی أَجْوَدَ مِنْہَا ؟ قَالَ : لاَ بَأْسَ مَا لَمْ یَتَعَمَّدْ ، أَوْ یَشْتَرِطْ۔","","Musannaf Ibn Abi Shaybah 23220","","","كتاب البيوع والأقضية"
"23221","(۲۳۲۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : سَمِعْتُ شَیْخًا یُقَالَ لَہُ : الْمُغِیرَۃُ ، قَالَ : قُلْتُ لاِبْنِ عُمَرَ : إنِّی أُسَلِّفُ جِیرَانِی إلَی الْعَطَائِ فَیَقْضُونِی دَرَاہِمَ أَجْوَدَ مِنْ دَرَاہِمِی ، قَالَ : لاَ بَأْسَ مَا لَمْ تَشْتَرِطْ۔","Da'if","Musannaf Ibn Abi Shaybah 23221","","","كتاب البيوع والأقضية"
"23222","(۲۳۲۲۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : مَنِ اشْتَرَی ثَوْبًا بِشَرْطٍ فَبَاعَہُ مُرَابَحَۃً قَبْلَ أَنْ یَسْتَوْجِبَہُ ، فَإِنَّ الرِّبْحَ لِصَاحِبِ الثَّوْبِ۔","","Musannaf Ibn Abi Shaybah 23222","","","كتاب البيوع والأقضية"
"23223","(۲۳۲۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : مَنِ اشْتَرَی بَیْعًا بِشَرْطٍ فَبَاعَہُ قَبْلَ أَنْ یَسْتَوْجِبَہُ فَمَا کَانَ فِیہِ مِنْ فَضْلٍ ، فَہُوَ لِلأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 23223","","","كتاب البيوع والأقضية"
"23224","(۲۳۲۲۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : إذَا اشْتَرَی بَیْعًا عَلَی أَنَّہُ فِیہِ بِالْخِیَارِ فَبَاعَہُ قَبْلَ أَنْ یَأْتِیَ صَاحِبُہُ ، فَقَدْ جَازَ بَیْعُہُ وَہُوَ لَہُ حِلٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 23224","","","كتاب البيوع والأقضية"
"23225","(۲۳۲۲۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ مُطَرِّفِ بْنِ عُتْبَۃَ ، عَنْ أَبِیہِ وَکَانَ صَدِیقًا لِشُرَیْحٍ ، قَالَ : قُلْتُ لِشُرَیْحٍ : آتِی السُّوقَ فَأَشْتَرِی الثَّوْبَ وَأَشْتَرِطُ أَنِّی فِیہِ بِالْخِیَارِ ، ثُمَّ أَنْطَلِقُ ، فَإِنْ بِعْتُہُ أَخَذْتُ الرِّبْحَ ، وَإِلاَّ رَدَدْتُہُ ، قَالَ : فَلاَ تَفْعَلْ۔","","Musannaf Ibn Abi Shaybah 23225","","","كتاب البيوع والأقضية"
"23226","(۲۳۲۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ سَعِیدِ بْنِ زَیْدِ بْنِ عُقْبَۃَ ، عَنْ أَبِیہِ ، عَنْ سَمُرَۃَََ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ ضَاعَ لَہُ مَتَاعٌ ، أَوْ سُرِقَ لَہُ مَتَاعٌ فَوَجَدَہُ فِی یَدِ رَجُلٍ فَہُوَ أَحَقُّ بِہِ ، وَیَرْجِعُ الْمُشْتَرِی عَلَی الْبَائِعِ۔ (احمد ۵/۱۸۔ دارقطنی ۲۹)","","Musannaf Ibn Abi Shaybah 23226","","","كتاب البيوع والأقضية"
"23227","(۲۳۲۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ حَجَّارِ بْنِ أَبْجَرَ ، عَنْ عَلِیٍّ : فِی رَجُلٍ کَانَ فِی یَدِہِ ثَوْبٌ ، فَأَقَامَ رَجُلٌ عَلَیْہِ الْبَیِّنَۃَ فَقَالَ علی : ادْفَعْ إلَی ہَذَا ثَوْبَہُ ، وَاتْبَعْ مَنِ اشْتَرَیْتَ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 23227","","","كتاب البيوع والأقضية"
"23228","(۲۳۲۲۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَتِ الْقُضَاۃُ تَقْضِی فِیمَنْ بَاعَ شَیْئًا لَیْسَ لَہُ ، فَہُوَ لِصَاحِبِہِ ، إذَا طَلَبَہُ یُؤْخَذُ ہَذَا بِالشَّرْوَی۔","","Musannaf Ibn Abi Shaybah 23228","","","كتاب البيوع والأقضية"
"23229","(۲۳۲۲۹) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنِ الشَّعْبِیِّ : فِی الْقَوْمِ یَکُونُونَ شُرَکَائَ فِی الدَّارِ ، فَاشْتَرَی بَعْضُہُمْ مِنْ بَعْضٍ ، قَالَ : لَیْسَ لِلآخَرِینَ شُفْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 23229","","","كتاب البيوع والأقضية"
"23230","(۲۳۲۳۰) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 23230","","","كتاب البيوع والأقضية"
"23231","(۲۳۲۳۱) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : ابْتَعْتُ أَنَا وَرَجُلٌ دَارًا ، وَلِرَجُلٍ سُدُسٌ وَلِلآخَرِ نِصْفٌ فَبَاعَ یَعْنِی صَاحِبِی آخُذُہُ أَنَا وَہُمْ جَمِیعًا ، أَوْ آخُذُہُ دُونَہُمْ ، قَالَ : لاَ ، بَلْ تَأْخُذُہُ دُونَہُمْ۔","","Musannaf Ibn Abi Shaybah 23231","","","كتاب البيوع والأقضية"
"23232","(۲۳۲۳۲) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ، عَنِ ابْنِ جُرَیْجٍ، قَالَ: أَخْبَرَنِی ابْنُ أَبِی حُسَیْنٍ، عن طَاوُوسٍ قَالَ: ہُمْ فِیہِ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 23232","","","كتاب البيوع والأقضية"
"23233","(۲۳۲۳۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ مُصْعَبِ بْنِ ثَابِتٍ ، قَالَ : سَمِعْتُ عَطَائً یُحَدِّثُ ، أَنَّ رَجُلاً رَہَنَ رَجُلاً فَرَسًا فَنَفَقَ فِی یَدِہِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلْمُرْتَہِنِ : ذَہَبَ حَقُّکَ۔n(ابوداؤد ۱۸۸۔ بیہقی ۴۱)","Da'if","Musannaf Ibn Abi Shaybah 23233","","","كتاب البيوع والأقضية"
"23234","(۲۳۲۳۴) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی حَصِینٍ ، قَالَ : سَمِعْتُ شُرَیْحًا یَقُولُ : ذَہَبَتِ الرِّہَانُ بِمَا فِیہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23234","","","كتاب البيوع والأقضية"
"23235","(۲۳۲۳۵) حَدَّثَنَا علی بن مسہر ، عن الشیبانی ، عن الشعبی ، عن شریح قَالَ : الرہن بما فیہ۔","No Data Available","Musannaf Ibn Abi Shaybah 23235","","","كتاب البيوع والأقضية"
"23236","(۲۳۲۳۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسماعیل ، عن الشعبی ، عن شریح قَالَ : ذہبت الرہان بما فیہا۔","","Musannaf Ibn Abi Shaybah 23236","","","كتاب البيوع والأقضية"
"23237","(۲۳۲۳۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ شُرَیْحٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 23237","","","كتاب البيوع والأقضية"
"23238","(۲۳۲۳۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : الرَّہْنُ بِمَا فِیہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23238","","","كتاب البيوع والأقضية"
"23239","(۲۳۲۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : سَأَلْتُ ابْنَ أَبِی نَجِیحٍ ، عَنِ الرَّہْنِ إذَا ہَلَکَ ، قَالَ : کَانَ عَطَائٌ یَقُولُ : الذَّہَبُ وَالْفِضَّۃُ وَالْعُرُوضُ یَتَرَادَّانِ ، وَالْحَیَوَانُ لاَ یَتَرَادَّانِ ، ہُوَ مِنَ الأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 23239","","","كتاب البيوع والأقضية"
"23240","(۲۳۲۴۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَانَ الرَّہْنُ بِأَکْثَرَ مِمَّا رُہِنَ بِہِ ، فَہُوَ أَمِینٌ فِی الْفَضْلِ ، فَإِنْ کَانَ نَاقِصًا فَأَحْسَنُ مِنْ ذَلِکَ أَنْ یَرُدَّ عَلَیْہِ النُّقْصَانَ۔","","Musannaf Ibn Abi Shaybah 23240","","","كتاب البيوع والأقضية"
"23241","(۲۳۲۴۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : الرَّہْنُ بِمَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 23241","","","كتاب البيوع والأقضية"
"23242","(۲۳۲۴۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : الرَّہْنُ بِمَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 23242","","","كتاب البيوع والأقضية"
"23243","(۲۳۲۴۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إدْرِیسُ الأَوْدِیُّ ، عَنْ إبْرَاہِیمَ بْنِ عُمَیْرۃ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ فِی الرَّہْنِ : یَتَرَادَّانِ الْفَضْلَ۔","Da'if","Musannaf Ibn Abi Shaybah 23243","","","كتاب البيوع والأقضية"
"23244","(۲۳۲۴۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مَنْصُورٍ، عَنِ الْحَکَمِ، عَنْ عَلِیٍّ، قَالَ: یَتَرَادَّانِ الْفَضْلَ فِی الرَّہْنِ۔","","Musannaf Ibn Abi Shaybah 23244","","","كتاب البيوع والأقضية"
"23245","(۲۳۲۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ عَبْدِ الأَعْلَی بْنِ عَامِرٍ ، عَنْ مُحَمَّدِ بْنِ الْحَنَفِیَّۃِ ، عَنْ عَلِیٍّ ، قَالَ: إذَا کَانَ الرَّہْنُ أَکْثَرَ مِمَّا رُہِنَ بِہِ فَہَلَکَ ، فَہُوَ بِمَا فِیہِ لأَنَّہُ أَمِینٌ فِی الْفَضْلِ ، وَإِذَا کَانَ أَقَلَّ مِمَّا رَہَنَ بِہِ فَہَلَکَ رَدَّ الرَّاہِنُ الْفَضْلَ۔","Da'if","Musannaf Ibn Abi Shaybah 23245","","","كتاب البيوع والأقضية"
"23246","(۲۳۲۴۶) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ الْقَعْقَاعِ بْنِ یَزِیدَ ، عَنْ إبْرَاہِیمَ ، قَالَ: إذَا کَانَ الرَّہْنُ أَکْثَرَ مِمَّا رُہِنَ بِہِ فَہَلَکَ، فَہُوَ بِمَا فِیہِ ، لأَنَّہُ أَمِینٌ فِی الْفَضْلِ ، وَإِذَا کَانَ أَقَلَّ مِمَّا رُہِنَ بِہِ فَہَلَکَ، رَدَّ الرَّاہِنُ الْفَضْلَ۔","","Musannaf Ibn Abi Shaybah 23246","","","كتاب البيوع والأقضية"
"23247","(۲۳۲۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ شِبَاکٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : رَجُلٌ رَہَنَ مِئَۃ دِرْہَمٍ بمائتی درہم ، فَہَلَکَتِ الْمِئَۃُ ؟ فَقَالَ : إنَّ أَحْسَنَ أنْ یَتَرَادَّا فِی الْفَضْلِ۔","Hasan","Musannaf Ibn Abi Shaybah 23247","","","كتاب البيوع والأقضية"
"23248","(۲۳۲۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسماعیل ، عن عامر قَالَ : الرہن بما فیہ۔","","Musannaf Ibn Abi Shaybah 23248","","","كتاب البيوع والأقضية"
"23249","(۲۳۲۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ، قَالَ : الرَّہْنُ بِمَا فِیہِ۔قَالَ شُعْبَۃُ : قُلْتُ لِلْحَکَمِ فِی قَوْلِہِ : إذَا کَانَ أَقَلَّ ، أَوْ أَکْثَرَ سَوَائٌ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 23249","","","كتاب البيوع والأقضية"
"23250","(۲۳۲۵۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یُغْلَقُ الرَّہْنُ ، ہُوَ لِمَنْ رَہَنَہُ ، لَہُ غُنْمُہُ وَعَلَیْہِ غُرْمُہُ۔n(عبدالرزاق ۱۵۰۳۳۔ ابن حبان ۵۹۳۴)","","Musannaf Ibn Abi Shaybah 23250","","","كتاب البيوع والأقضية"
"23251","(۲۳۲۵۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ إبْرَاہِیمَ بْنِ عَامِرِ بْنِ مَسْعُودٍ الْجُمَحِیِّ ، عَنْ مُعَاوِیَۃَ بْنِ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، أَنَّ رَجُلاً رَہَنَ دَارًا إلَی أَجَلٍ ، فَلَمَّا حَلَّ الأَجَل ، قَالَ الْمُرْتَہِنُ : دَارِی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یُغْلَقُ الرَّہْنُ۔","","Musannaf Ibn Abi Shaybah 23251","","","كتاب البيوع والأقضية"
"23252","(۲۳۲۵۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : مَا زِلْنَا نَسْمَعُ ، أَنَّ الرَّہْنَ بِمَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 23252","","","كتاب البيوع والأقضية"
"23253","(۲۳۲۵۳) حَدَّثَنَا أَبُو عَاصِمٍ ، عَنْ عِمْرَانَ الْقَطَّانِ ، عَنْ مَطَرٍ ، عَنْ عَطَائٍ ، قَالَ: مَا زِلْنَا نَسْمَعُ ، أَنَّ الرَّہْنَ بِمَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 23253","","","كتاب البيوع والأقضية"
"23254","(۲۳۲۵۴) حَدَّثَنَا أَبُو عَاصِمٍ ، عَنْ عِمْرَانَ الْقَطَّانِ ، عَنْ مَطَرٍ ، عَنْ عَطَائٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ عُمَرَ ، قَالَ: إذَا کَانَ الرَّہْنُ أَکْثَرَ مِمَّا رُہِنَ بِہِ ، فَہُوَ أَمِینٌ فِی الْفَضْلِ ، وَإِذَا کَانَ أَقَلَّ رُدَّ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 23254","","","كتاب البيوع والأقضية"
"23255","(۲۳۲۵۵) حَدَّثَنَا عبد الوہاب بن عطاء ، عن ابن عون ، عن محمد بن سیرین ، قَالَ : الرہن بما فیہ۔","","Musannaf Ibn Abi Shaybah 23255","","","كتاب البيوع والأقضية"
"23256","(۲۳۲۵۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ جَابَانَ ، قَالَ خَاصَمْتُ إلَی شُرَیْحٍ فِی خَاتَمِ ذَہَبٍ فَقَالَ : الرَّہْنُ بِمَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 23256","","","كتاب البيوع والأقضية"
"23257","حَدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حَدَّثَنَا أَبُو بَکْرِ بْنُ أَبِی شَیْبَۃَ ، قَالَ :n(۲۳۲۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ الْحَسَنِ ، عَنْ أُمِّہِ فَاطِمَۃَ ابْنَۃِ حُسَیْنٍ ، أَنَّ زَیْدَ بْنَ حَارِثَۃَ قَدِمَ یَعْنِی مِنْ أَیْلَۃَ ، فَاحْتَاجَ إلَی ظَہْرٍ فَبَاعَ بَعْضَہُمْ ، فَلَمَّا قَدِمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی امْرَأَۃً مِنْہُمْ تَبْکِی ، قَالَ : مَا شَأْنُ ہَذِہِ ؟ فَأُخْبِرَ أَنَّ زَیْدًا بَاعَ وَلَدَہَا ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اُرْدُدْہُ أَوِ اشْتَرِہِ۔","","Musannaf Ibn Abi Shaybah 23257","","","كتاب البيوع والأقضية"
"23258","(۲۳۲۵۸) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، قَالَ : بَعَثَ مَعِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِغُلاَمَیْنِ سَبِیَّیْنِ مَمْلُوکَیْنِ أَبِیعُہُمَا ، فَلَمَّا أَتَیْتُہُ ، قَالَ : جَمَعْتَ أَوْ فَرَّقْتَ ؟ قُلْتُ : فَرَّقْتُ ، قَالَ : فَأَدْرِکْ أَدْرِکْ۔ (ترمذی ۱۲۸۴۔ ابوداؤد ۲۶۸۹)","Da'if","Musannaf Ibn Abi Shaybah 23258","","","كتاب البيوع والأقضية"
"23259","(۲۳۲۵۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ عَمْرِو بْنِ دِینَارٍ، عَنْ فَرُّوخَ، قَالَ: کَتَبَ عُمَرُ: أنْ لاَ تُفَرِّقُوا بَیْنَ الأَخَوَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 23259","","","كتاب البيوع والأقضية"
"23260","(۲۳۲۶۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ فَرُّوخَ - وَرُبَّمَا قَالَ : عَنْ أَبِیہِ : أَنَّ عُمَرَ ، قَالَ : لاَ تُفَرِّقُوا بَیْنَ الأُمِّ وَوَلَدِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 23260","","","كتاب البيوع والأقضية"
"23261","(۲۳۲۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : قَالَ عِقَالُ - أَوْ حَکِیمُ بْنُ عِقَال - قَالَ : کَتَبَ عُثْمَانُ بْنُ عَفَّانَ إلَی عِقَال : أَنْ یَشْتَرِیَ مِئَۃ أَہْلِ بَیْتٍ یَرْفَعُہُمْ إلَی الْمَدِینَۃِ ، وَلاَ تَشْتَرِی لِی شَیْئًا تُفَرِّقُ بَیْنَہُ وَبَیْنَ وَالِدِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 23261","","","كتاب البيوع والأقضية"
"23262","(۲۳۲۶۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ حَبِیبِ بْنِ شِہَابٍ ، عَنْ أَبِیہِ : أَنَّہُ غَزَا مَعَ أبِی مُوسَی ، فَلَمَّا فَتَحُوا تُسْتَرَ کَانَ لاَ یُفَرِّقُ بَیْنَ الْمَرْأَۃِ وَوَلَدِہَا فِی الْبَیْعِ۔","Sahih","Musannaf Ibn Abi Shaybah 23262","","","كتاب البيوع والأقضية"
"23263","(۲۳۲۶۳) حَدَّثَنَا زَیْدُ بْنُ حَبَّابٍ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، قَالَ : سَمِعْتُ ابْنَ أَبِی جَبَلَۃَ الْقُرَشِیَّ یَقُولُ : کَانُوا یُفَرِّقُونَ بَیْنَ السَّبَایَا ، فَیَجِیئُ أَبُو أَیُّوبَ فَیَجْمَعُ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 23263","","","كتاب البيوع والأقضية"
"23264","(۲۳۲۶۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنَّمَا کَرِہُوا بَیْعَ الرَّقِیقِ مَخَافَۃَ أَنْ یُفَرِّقُوا بَیْنَ الْوَلَدِ وَوَالِدِہِ وَبَیْنَ الإِخْوَۃِ۔","","Musannaf Ibn Abi Shaybah 23264","","","كتاب البيوع والأقضية"
"23265","(۲۳۲۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أُتِیَ بِالسَّبْیِ أَعْطَی أہل البیت جَمِیعًا کَرَاہِیَۃَ أَنْ یُفَرِّقَ بَیْنَہُمْ۔ (ابن ماجہ ۲۲۴۸۔ احمد ۳۸۹)","Da'if","Musannaf Ibn Abi Shaybah 23265","","","كتاب البيوع والأقضية"
"23266","(۲۳۲۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَیُّوبَ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ حَکِیمِ بْنِ عِقَال ، قَالَ : کَتَبَ عُثْمَانُ إلَی أَبِی أَنِ اشْتَرِ لِی مِئَۃ أَہْلِ بَیْتٍ وَلاَ تُفَرِّقْ بَیْنَ وَالِدٍ وَوَلَدِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 23266","","","كتاب البيوع والأقضية"
"23267","(۲۳۲۶۷) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ وَمُحَمَّدٍ: أَنَّہُمَا کَانَا یَکْرَہَانِ أَنْ یُفَرَّقَا بَیْنَ الأَمَۃِ وَوَلَدِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23267","","","كتاب البيوع والأقضية"
"23268","(۲۳۲۶۸) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ: أَنَّہُ کَانَ یَکْرَہُہُ، وَیَقُولُ: لاَ بَأْسَ بِہِ إذَا أُوصِفَ، أَوْ أُوصِفَتْ۔","Hasan","Musannaf Ibn Abi Shaybah 23268","","","كتاب البيوع والأقضية"
"23269","(۲۳۲۶۹) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ ، عَنْ طُلَیْقِ بْنِ عِمْرَانَ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی أَنْ یُفَرَّقَ بَیْنَ الأَمَۃِ وَوَلَدِہَا فِی الْبَیْعِ۔ (ابن ماجہ ۲۲۵۰۔ دارقطنی ۲۵۴)","Da'if","Musannaf Ibn Abi Shaybah 23269","","","كتاب البيوع والأقضية"
"23270","(۲۳۲۷۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَتَبْتُ إلَی نَافِعٍ أَسْأَلُہُ عَنْ أَہْلِ الْبَیْتِ یَکُونُونَ لِلرَّجُلِ أَیَصْلُحُ أَنْ یُفَرِّقَ بَیْنَہُمْ ؟ قَالَ : فَقَالَ : لاَ أَعْلَمُ ذَلِکَ حَرَامًا ، وَلَکِنْ یُکْرَہُ عِنْدَہَا۔","","Musannaf Ibn Abi Shaybah 23270","","","كتاب البيوع والأقضية"
"23271","(۲۳۲۷۱) حَدَّثَنَا عَبْدُالْوَہَّابِ بْنُ عَطَائٍ، عَنِ ابْنِ أَبِی عَرُوبَۃَ، عَنْ دَاوُدَ بْنِ أَبِی الْقَصَّافِ، عَنْ رِیَاحِ بْنِ عَبِیْدَۃَ: أَنَّ عُمَرَ بْنَ عَبْدِالْعَزِیزِ کَتَبَ إلَیْہِ أَنْ یَبِیعَ رَقِیقًا مِنْ رَقِیقِ الإِمَارَۃِ وَأَنْ یَبِیعَ أَہْلَ الْبَیْتِ جَمِیعًا، وَلاَ یُفَرِّقَ بَیْنَہُمْ۔","","Musannaf Ibn Abi Shaybah 23271","","","كتاب البيوع والأقضية"
"23272","(۲۳۲۷۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، قَالَ : کَتَبَ عُمَرُ : أَلاَ تُفَرِّقُوا بَیْنَ السَّبَایَا وَأَوْلاَدِہِنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 23272","","","كتاب البيوع والأقضية"
"23273","(۲۳۲۷۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : نُبِّئْتُ أَنَّ ابْنًا لاِبْنِ عُمَرَ ، قَالَ لَہُ : تَکْرَہُ أَنْ یُفَرَّقَ بَیْنَ الأَمَۃِ وَبَیْنَ ابْنِہَا وَقَدْ فَرَّقْتَ بَیْنِی وَبَیْنَ أُمِّی؟!۔","Da'if","Musannaf Ibn Abi Shaybah 23273","","","كتاب البيوع والأقضية"
"23274","(۲۳۲۷۴) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ رَفَعُہُ قَالَ : کَانَ ألنَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا قَدِمَ عَلَیْہِ السَّبْیُ أَعْطَی أَہْلَ الْبَیْتِ : أَہْلَ الْبَیْتِ ، کَرَاہِیَۃَ أَنْ یُفَرِّقَ بَیْنَہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 23274","","","كتاب البيوع والأقضية"
"23275","(۲۳۲۷۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : أَنَّہُ بَاعَ بِنْتَ جَارِیَۃٍ لَہُ ، قَالَ مَنْصُورٌ : فَقُلْتُ لَہُ : أَلَیْسَ کَانُوا یَکْرَہُونَ التَّفْرِیقَ ؟ قَالَ : بَلَی ! وَلَکِنْ أُمُّہَا رَضِیَتْ وَقَدْ وَضَعْتُہَا مَوْضِعًا۔","","Musannaf Ibn Abi Shaybah 23275","","","كتاب البيوع والأقضية"
"23276","(۲۳۲۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ وَعَطَائٍ وَمُحَمَّدِ بْنِ عَلِیٍّ ، قَالُوا : لاَ بَأْسَ أَنْ یُفَرَّقَ بَیْنَ الْمُوَلَّدَاتِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23276","","","كتاب البيوع والأقضية"
"23277","(۲۳۲۷۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِہِ إذَا أُوصِفَ ، أَوْ أُوصِفَتْ۔n وَقَالَ وَکِیعٌ : السَّبْیُ لاَ یُفَرَّقُ بَیْنَہُمْ ، فَأَمَّا الْمُوَلَّدَاتُ إذَا اسْتَغْنَیْنَ عَنْ أُمَّہَاتِہِنَّ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23277","","","كتاب البيوع والأقضية"
"23278","(۲۳۲۷۸) حَدَّثَنَا شَرِیکٌ، عَنْ جَابِرٍ، عَنْ عَامِرٍ وَأَبِی جَعْفَرٍ: أنَّہُمَا کَرِہَا التَّفْرِیقَ بَیْنَ السَّبَایَا، فَأَمَّا الْمُوَلَّدُونَ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23278","","","كتاب البيوع والأقضية"
"23279","(۲۳۲۷۹) حَدَّثَنَا شَرِیکٌ ، عَنْ فِرَاسٍ ، عَنْ عَامِرٍ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ غَلَتَ فِی الإِسْلاَمِ یَعْنِی لاَ غَلَطَ۔","","Musannaf Ibn Abi Shaybah 23279","","","كتاب البيوع والأقضية"
"23280","(۲۳۲۸۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ : أَنَّہُ کَانَ لاَ یُجِیزُ الْغَلَطَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23280","","","كتاب البيوع والأقضية"
"23281","(۲۳۲۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : فِی رَجُلٍ بَاعَ رَجُلاً ثَوْبًا فَقَالَ : غَلِطْتُ ، فَقَالَ : الشَّعْبِیُّ : لَیْسَ بِشَیْئٍ ، الْبَیْعُ خُدْعَۃٌ ، وَقَالَ الْقَاسِمُ : یَرُدُّہُ۔","","Musannaf Ibn Abi Shaybah 23281","","","كتاب البيوع والأقضية"
"23282","(۲۳۲۸۲) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللہِ مَوْلَی عَمْرِو بْنِ حُرَیْثٍ ، عَنْ أَبِیہِ ، قَالَ : قدِمَ رَجُلٌ مِنْ أَہْلِ الْبَادِیَۃِ بِعَشَرَۃِ أَبْعِرَۃٍ فَجَعَلَ یُعْطَی بِالْبَعِیرِ مِئَۃ وَثَلاَثِینَ ، وَمِئَۃً وَعِشْرِینَ ، فَیَأْبَی ، فَأَتَاہُ رَجُلٌ مِنَ النَّخَّاسِینَ فَقَالَ : قَدْ أَخَذْتُہَا مِنْکَ بِأَلْفٍ أَقْرَعَ ، فَبَاعَہَا ، فَلَمَّا حَسَبَ حِسَابَہَا نَدِمَ ! فَخَاصَمَہُ إلَی شُرَیْحٍ ، فَأَجَازَ الْبَیْعَ وَقَالَ: الْبَیْعُ خُدْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 23282","","","كتاب البيوع والأقضية"
"23283","(۲۳۲۸۳) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الطَّعَامِ حَتَّی یَجْرِیَ فِیہِ الصَّاعَانِ ، فَتَکَُونُ لَہُ زِیَادَتُہُ وَعَلَیْہِ نُقْصَانہ۔ (ابن ماجہ ۲۲۲۸۔ دارقطنی ۲۴)","Hasan","Musannaf Ibn Abi Shaybah 23283","","","كتاب البيوع والأقضية"
"23284","(۲۳۲۸۴) حَدَّثَنَا حَفْصٌ ، عَنْ أشعث ، عن ابن سیرین ، عَنْ عَبِیْدَۃَ ، قَالَ : نُہِیَ عَنْ بَیْعِ الطَّعَامِ حَتَّی یَجْرِیَ فِیہِ الصَّاعَانِ ، فَتَکُونَ زِیَادَتُہُ لِمَنَ اشْتَرَی ، وَنُقْصَانُہُ عَلَی الْبَائِعِ۔","","Musannaf Ibn Abi Shaybah 23284","","","كتاب البيوع والأقضية"
"23285","(۲۳۲۸۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ وَالْحَسَنِ : أَنَّہُمَا سُئِلاَ عَنِ الرَّجُلِ یَشْتَرِی الطَّعَامَ أَیَبِیعُہُ بِکَیْلِہِ؟ فَقَالاَ : لاَ ، حَتَّی یَجْرِیَ فِیہِ الصَّاعَانِ ، فَتَکُونُ لَہُ الزِّیَادَۃُ وَعَلَیْہِ النُّقْصَانُ۔","","Musannaf Ibn Abi Shaybah 23285","","","كتاب البيوع والأقضية"
"23286","(۲۳۲۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ وَالْحَکَمِ : فِی الرَّجُلِ یَشْتَرِی الطَّعَامَ فَیَزِیدُ ، فَقَالاَ: إِنْ کَانَ غَلِطَ رَدَّہُ ، وَإِنْ کَانَ زِیَادَۃً رَدَّہُ۔","","Musannaf Ibn Abi Shaybah 23286","","","كتاب البيوع والأقضية"
"23287","(۲۳۲۸۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَنْ عَاصِمِ بْنِ بَشِیرِ بْنِ الْبَرَائِ ، قَالَ : سَمِعْتُ مُوَرِّقًا الْعِجْلِیّ یَقُولُ: لَقَدْ بَعَثْنَا بِسَفِینَۃٍ مِنَ الأَہْوَازِ إلَی الْبَصْرَۃِ فِیہَا ثَلاَثُونَ کُرًّا، مَا ہُوَ إلاَّ فَضْلُ مَا بَیْنَ الْکَیْلَیْنِ۔","","Musannaf Ibn Abi Shaybah 23287","","","كتاب البيوع والأقضية"
"23288","(۲۳۲۸۸) حَدَّثَنَا عُمَرُ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ: إِنْ بِعْتَ طَعَامًا فَوَجَدْتَ زِیَادَۃً فَلَکَ، أَوْ نُقْصَانًا فَعَلَیْک۔","","Musannaf Ibn Abi Shaybah 23288","","","كتاب البيوع والأقضية"
"23289","(۲۳۲۸۹) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ ، قَالَ : إذَا أَقَرَّ عَلَی نَفْسِہِ بِالْعُبُودِیَّۃِ ، فَہُوَ عَبْدٌ۔","Da'if","Musannaf Ibn Abi Shaybah 23289","","","كتاب البيوع والأقضية"
"23290","(۲۳۲۹۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یُسْتَرَقُّ حُرٌّ بِإِقْرَارِہِ عَلَی نَفْسِہِ بِالْعُبُودِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 23290","","","كتاب البيوع والأقضية"
"23291","(۲۳۲۹۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ : فِی الرَّجُلِ یَقُولُ : کُنْتُ مَمْلُوکًا لِفُلاَنٍ ، أَوْ کَانَ أَبِی مَمْلُوکًا لِفُلاَنٍ ، أَوْ کَانَتْ أُمِّی مَمْلُوکَۃً لِفُلاَنٍ ، فَقَالَ فُلاَنٌ : أَنْتُمْ عَبِیدِی الْیَوْمَ ، قَالَ : إذَا کَانُوا قَدْ جروا فِی الْعِتْقِ وَعُرِفَ أَنَّہُمْ مَوَالٍ ، لاَ یَکُونُونَ لِہَذَا مَمْلُوکِینَ لِلَّذِینَ یَدَّعُونَ إلاَّ أَنْ یَجِیئَ بِشُہُودٍ عُدُولٍ یَشْہَدُونَ أَنَّہُمْ مَمْلُوکُوہ إلَی الْیَوْمِ۔","","Musannaf Ibn Abi Shaybah 23291","","","كتاب البيوع والأقضية"
"23292","(۲۳۲۹۲) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ، عَنِ ابْنِ أَبِی غَنِیَّۃَ، عَنِ الْحَکَمِ، قَالَ: إذَا لَحِقَ أَحَدَ الْمُتَفَاوِضَیْنِ دَیْنٌ ، فَہُوَ عَلَیْہِمَا جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 23292","","","كتاب البيوع والأقضية"
"23293","(۲۳۲۹۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : الْکَفِیلُ غَارِمٌ۔","","Musannaf Ibn Abi Shaybah 23293","","","كتاب البيوع والأقضية"
"23294","(۲۳۲۹۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : قُلْتُ لِشُرَیْحٍ : کَفِیلِی حِیلَ دُونَہُ ، وَمَالِی اُقْتُضِیَ مُسَمًّی ، وَمَالُ غَرِیمِی اُقْتُسِمَ دُونِی ، فَقَالَ : إِنْ کَانَ الْکَفِیلُ مُخَیَّرًا فَالْکَفِیلُ غَارِمٌ ، وَإِنْ کَانَ مَالُکَ اُقْتُضِیَ مُسَمًّی فَأَنْتَ أَحَقُّ بِہِ ، وَإِنْ کَانَ مَالُ غَرِیمِکَ اُقْتُسِمَ دُونَکَ فَہُوَ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 23294","","","كتاب البيوع والأقضية"
"23295","(۲۳۲۹۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ شُرَحْبِیلَ بْنِ مُسْلِمٍ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ البَاہِلِی یَقُولُ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی خُطْبَتِہِ فِی عَامِ حَجَّۃِ الْوَدَاعِ یَقُولُ : الدَّیْنُ مَقْضِیٌّ وَالزَّعِیمُ غَارِمٌ۔ یَعْنِی : الْکَفِیلَ۔","Hasan","Musannaf Ibn Abi Shaybah 23295","","","كتاب البيوع والأقضية"
"23296","(۲۳۲۹۶) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ وَطَاوُوسٍ : فِی قولہ تعالی : {فَکَاتِبُوہُمْ إِنْ عَلِمْتُمْ فِیہِمْ خَیْرًا} قَالاَ : مَالٌ وَأَمَانَۃٌ۔","","Musannaf Ibn Abi Shaybah 23296","","","كتاب البيوع والأقضية"
"23297","(۲۳۲۹۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : أَدَاؤہُ وَمَالہُ۔","","Musannaf Ibn Abi Shaybah 23297","","","كتاب البيوع والأقضية"
"23298","(۲۳۲۹۸) حَدَّثَنَا ابْن أبی زائدۃ ووکیع ، عن ابن عون ، عن ابن سیرین ، عن عَبِیْدَۃَ ، قَالَ : إذا صلی۔","No Data Available","Musannaf Ibn Abi Shaybah 23298","","","كتاب البيوع والأقضية"
"23299","(۲۳۲۹۹) حَدَّثَنَا ابْن أبی زائدۃ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَاَل : خَیْرُہُ : أَدَاؤہُ وَمَالہُ۔","","Musannaf Ibn Abi Shaybah 23299","","","كتاب البيوع والأقضية"
"23300","(۲۳۳۰۰) حَدَّثَنَا ابْن إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا صَلَّی۔","","Musannaf Ibn Abi Shaybah 23300","","","كتاب البيوع والأقضية"
"23301","(۲۳۳۰۱) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : {فَکَاتِبُوہُمْ إِنْ عَلِمْتُمْ فِیہِمْ خَیْرًا} قَالَ : دِینًا وَأَمَانَۃً۔","","Musannaf Ibn Abi Shaybah 23301","","","كتاب البيوع والأقضية"
"23302","(۲۳۳۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسماعیل بن أبی خالد ، عن أبی صالح ، قَالَ : أداء وأمانۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 23302","","","كتاب البيوع والأقضية"
"23303","(۲۳۳۰۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، قَالَ : مَالاً۔","","Musannaf Ibn Abi Shaybah 23303","","","كتاب البيوع والأقضية"
"23304","(۲۳۳۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ وَمَالِکُ بْنُ مِغْوَلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : صِدْقًا وَوَفَائً۔","No Data Available","Musannaf Ibn Abi Shaybah 23304","","","كتاب البيوع والأقضية"
"23305","(۲۳۳۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، عَنْ عَطَائٍ ، قَالَ : مَالاً۔","No Data Available","Musannaf Ibn Abi Shaybah 23305","","","كتاب البيوع والأقضية"
"23306","(۲۳۳۰۶) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : {إِنْ عَلِمْتُمْ فِیہِمْ خَیْرًا} قَالَ ابْنُ عَبَّاسٍ : الْخَیْرُ : الْمَالُ۔","","Musannaf Ibn Abi Shaybah 23306","","","كتاب البيوع والأقضية"
"23307","(۲۳۳۰۷) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : {فَکَاتِبُوہُمْ إِنْ عَلِمْتُمْ فِیہِمْ خَیْرًا} قَالَ : کَائِنَۃً أَخْلاَقُہُمْ مَا کَانَتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 23307","","","كتاب البيوع والأقضية"
"23308","(۲۳۳۰۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : فِی قَوْلِہِ تَعَالی : {فَکَاتِبُوہُمْ إِنْ عَلِمْتُمْ فِیہِمْ خَیْرًا} قَالَ : الْخَیْرُ : الْقُرْآنُ وَالإِسْلاَمُ۔n وَقَالَ سَعِیدُ بْنُ أَبِی الْحَسَنِ : الإِسْلاَمُ وَالْغِنَی۔","","Musannaf Ibn Abi Shaybah 23308","","","كتاب البيوع والأقضية"
"23309","(۲۳۳۰۹) حَدَّثَنَا وکیع قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ عُبَیْدَۃَ بْنِ أَبِی صَالِحٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَنْ کَفَلَ عَنْ رَجُلٍ بِکَفَالَۃٍ ، وَلَمْ یَأْمُرْہُ بِہَا فَأَدَّاہَا عَنْہُ فَلَیْسَ لِلْمَکْفُولِ عَنْہُ شَیْئٌ ، إنَّمَا ہِیَ حَمَالَۃٌ تَحَمَّلَہَا۔","","Musannaf Ibn Abi Shaybah 23309","","","كتاب البيوع والأقضية"
"23310","(۲۳۳۱۰) حَدَّثَنَا حَفْصٌ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ، عَنْ طَلْحَۃَ بْنِ عَبْدِ اللہِ بْنِ عَوْفٍ، قَالَ: أَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُنَادِیًا فَنَادَی حَتَّی انْتَہَی إلَی الثَّنِیَّۃِ : أَلاَ لاَ تَجُوزُ شَہَادَۃُ خَصْمٍ وَلاَ ظَنِینٍ ، وَإِنَّ الْیَمِینَ عَلَی الْمُدَّعَی عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 23310","","","كتاب البيوع والأقضية"
"23311","(۲۳۳۱۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : أَرُدُّ شَہَادَۃَ سِتَّۃٍ : الْخَصْمِ ، وَالْمُرِیبِ ، وَدَافِعِ الْمَغْرَمِ ، وَالشَّرِیکِ لِشَرِیکِہِ ، وَالأَجِیرِ لِمَنِ اسْتَأْجَرَہُ ، وَالْعَبْدِ لِسَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 23311","","","كتاب البيوع والأقضية"
"23312","(۲۳۳۱۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تَجُوزُ فِی الطَّلاَقِ شَہَادَۃُ ظَنِینٍ ، وَلاَ مُتَّہَمٍ۔","","Musannaf Ibn Abi Shaybah 23312","","","كتاب البيوع والأقضية"
"23313","(۲۳۳۱۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ شُرَیْحٌ : لاَ أُجِیزُ شَہَادَۃَ : خَصْمٍ ، وَلاَ مُرِیبٍ ، وَلاَ دَافِعِ مَغْرَمٍ ، وَلاَ الشَّرِیکِ لِشَرِیکِہِ ، وَلاَ الأَجِیرِ لِمَنِ اسْتَأْجَرَہُ ، وَلاَ الْعَبْدِ لِسَیِّدِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23313","","","كتاب البيوع والأقضية"
"23314","(۲۳۳۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الابْنِ لأَبِیہِ ، وَلاَ الأَبِ لاِبْنِہِ ، وَلاَ الْمَرْأَۃِ لِزَوْجِہَا ، وَلاَ الزَّوْجِ لاِمْرَأَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23314","","","كتاب البيوع والأقضية"
"23315","(۲۳۳۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الْوَالِدِ لِوَلَدِہِ ، وَلاَ الْوَلَدِ لِوَالِدِہِ ، وَلاَ الْمَرْأَۃِ لِزَوْجِہَا ، وَلاَ الزَّوْجِ لاِمْرَأَتِہِ ، وَلاَ الْعَبْدِ لِسَیِّدِہِ ، وَلاَ السَّیِّدِ لِعَبْدِہِ ، وَلاَ الشَّرِیکِ لِشَرِیکِہِ ، وَلاَ کُلِّ وَاحِدٍ مِنْہَا لِصَاحِبِہِ۔","","Musannaf Ibn Abi Shaybah 23315","","","كتاب البيوع والأقضية"
"23316","(۲۳۳۱۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ : أَنَّہُ کَانَ لاَ یُجِیزُ شَہَادَۃَ الرَّجُلِ لأَبِیہِ ، وَلاَ شَہَادَۃَ الْمَرْأَۃِ لِزَوْجِہَا ، وَکَانَ یُجِیزُ شَہَادَۃَ الرَّجُلِ لاِبْنِہِ ، وَشَہَادَۃَ الرَّجُلِ لاِمْرَأَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23316","","","كتاب البيوع والأقضية"
"23317","(۲۳۳۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَنْصَارِیُّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَقُولُ : لاَ تَجُوزُ شَہَادَۃُ الرَّجُلِ لاِبْنِہِ ، وَلاَ شَہَادَۃُ الابْنِ لأَبِیہِ ، وَلاَ شَہَادَۃُ الزَّوْجِ لِزَوْجَتِہِ ، وَلاَ شَہَادَۃُ الزَّوْجَۃِ لِزَوْجِہَا۔","","Musannaf Ibn Abi Shaybah 23317","","","كتاب البيوع والأقضية"
"23318","(۲۳۳۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ شَبِیبِ بْنِ غَرْقَدَۃَ ، قَالَ : شَہِدْتُ شُرَیْحًا أَجَازَ شَہَادَۃَ زَوْجٍ لاِمْرَأَتِہِ ، فَقِیلَ لَہُ : إِنَّہُ زَوْجٌ ، فَقَالَ : وَمَنْ یَشْہَدُ لِلْمَرْأَۃِ إلاَّ زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 23318","","","كتاب البيوع والأقضية"
"23319","(۲۳۳۱۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : کَانَ ابْنُ أَبِی لَیْلَی یُجِیزُ شَہَادَۃَ الزَّوْجِ لاِمْرَأَتِہِ ، وَلاَ یُجِیزُ شَہَادَۃَ الْمَرْأَۃِ لِزَوْجِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23319","","","كتاب البيوع والأقضية"
"23320","(۲۳۳۲۰) حَدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ أَبِی جناب ، عن عون ، عَنْ شُرَیْحٍ : أَنَّہُ أَجَازَ شَہَادَۃَ أَبٍ وَزَوْجٍ۔","","Musannaf Ibn Abi Shaybah 23320","","","كتاب البيوع والأقضية"
"23321","(۲۳۳۲۱) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ سُلَیْمَانَ بْنِ أَبِی سُلَیْمَانَ ، قَالَ : شَہِدْتُ لأَبِی عِنْدَ أَبِی بَکْرِ بْنِ حَزْمٍ فَأَجَازَ شَہَادَتِی۔","","Musannaf Ibn Abi Shaybah 23321","","","كتاب البيوع والأقضية"
"23322","(۲۳۳۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : أَنَّہُ أَجَازَ شَہَادَۃَ مَجُوسِیٍّ عَلَی یَہُودِیٍّ ، أَوْ نَصْرَانِیٍّ۔","","Musannaf Ibn Abi Shaybah 23322","","","كتاب البيوع والأقضية"
"23323","(۲۳۳۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ یُجِیزُ شَہَادَۃَ أَہْلِ الْکِتَابِ بَعْضِہِمْ عَلَی بَعْضٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 23323","","","كتاب البيوع والأقضية"
"23324","(۲۳۳۲۴) حَدَّثَنَا وَکِیع ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنْ عَامِرٍ : أَنَّہُ أَجَازَ شَہَادَۃَ یَہُودِیٍّ عَلَی نَصْرَانِیٍّ ، أَوْ نَصْرَانِیٍّ عَلَی یَہُودِیٍّ۔","","Musannaf Ibn Abi Shaybah 23324","","","كتاب البيوع والأقضية"
"23325","(۲۳۳۲۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا خَالِدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ بُکَیْر السُّلَمِیُّ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : شَہِدْتُ شُرَیْحًا أَجَازَ شَہَادَۃَ قَوْمٍ مِنْ أَہْلِ الشِّرْکِ بَعْضِہِمْ عَلَی بَعْضٍ بِخِفَافِہِمْ نَقْعٌ۔","","Musannaf Ibn Abi Shaybah 23325","","","كتاب البيوع والأقضية"
"23326","(۲۳۳۲۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ عَوْنِ بْنِ مَعْمَرٍ ، عَنْ إبْرَاہِیمَ الصَّائِغِ ، قَالَ : سَأَلْتُ نَافِعًا عَنْ شَہَادَۃِ أَہْلِ الْکِتَابِ بَعْضِہِمْ عَلَی بَعْضٍ ، فَقَالَ : تَجُوزُ۔","","Musannaf Ibn Abi Shaybah 23326","","","كتاب البيوع والأقضية"
"23327","(۲۳۳۲۷) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، قَالَ: سَأَلْتُ حَمَّادًا؟ فَقَالَ: أَہْلُ الشِّرْکِ جَمِیعًا تَجُوزُ شَہَادَۃُ بَعْضِہِمْ عَلَی بَعْضٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 23327","","","كتاب البيوع والأقضية"
"23328","(۲۳۳۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : قَالَ سُفْیَانُ : الإِسْلاَمُ مِلَّۃٌ وَالشِّرْکُ مِلَّۃٌ ، تَجُوزُ شَہَادَۃُ بَعْضِہِمْ عَلَی بَعْضٍ۔n قَالَ : وَقَالَ وَکِیعٌ : وَکَذَلِکَ نَقُولُ۔","","Musannaf Ibn Abi Shaybah 23328","","","كتاب البيوع والأقضية"
"23329","(۲۳۳۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَقُولُ : إذَا اخْتَلَفَتِ الْمِلَلُ لاَ تجوز شَہَادَۃُ بَعْضِہِمْ عَلَی بَعْضٍ۔","Hasan","Musannaf Ibn Abi Shaybah 23329","","","كتاب البيوع والأقضية"
"23330","(۲۳۳۳۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الْیَہُودِیِّ عَلَی النَّصْرَانِیِّ ، وَلاَ النَّصْرَانِیِّ عَلَی الْیَہُودِیِّ ، وَلاَ مِلَّۃٍ عَلَی غَیْرِ مِلَّتِہَا إلاَّ الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 23330","","","كتاب البيوع والأقضية"
"23331","(۲۳۳۳۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ دَاوُدَ، عَنِ الشَّعْبِیِّ، قَالَ: لاَ تَجُوزُ شَہَادَۃُ مِلَّۃٍ عَلَی مِلَّۃٍ إلاَّ الْمُسْلِمِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23331","","","كتاب البيوع والأقضية"
"23332","(۲۳۳۳۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ وحماد، قَالا: لاَ تَجُوزُ شَہَادَۃُ أَہْلِ الْکِتَابِ بَعْضِہِمْ عَلَی بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 23332","","","كتاب البيوع والأقضية"
"23333","(۲۳۳۳۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ أَہْلِ الْکِتَابِ بَعْضِہِمْ عَلَی بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 23333","","","كتاب البيوع والأقضية"
"23334","(۲۳۳۳۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ والشَّعْبِیِّ والْحَسَنِ ، قَالُوا : لاَ تَجُوزُ شَہَادَۃُ أَہْلِ مِلَّۃٍ إلاَّ عَلَی أَہْلِ مِلَّتِہَا : الْیَہُودِیُّ عَلَی الْیَہُودِیِّ ، وَالنَّصْرَانِیُّ عَلَی النَّصْرَانِیِّ۔","","Musannaf Ibn Abi Shaybah 23334","","","كتاب البيوع والأقضية"
"23335","(۲۳۳۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ : أَنَّہُ کَانَ لاَ یَقْبَلُ شَہَادَۃَ مِلَّۃٍ عَلَی غَیْرِہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 23335","","","كتاب البيوع والأقضية"
"23336","(۲۳۳۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنْ شَہَادَۃِ الْیَہُودِیِّ عَلَی النَّصْرَانِیِّ ، وَالنَّصْرَانِیِّ عَلَی الْیَہُودِیِّ ؟ فَقَالَ : الْحَکَمُ : لاَ تَجُوزُ شَہَادَۃُ أَہْلِ دِینٍ عَلَی أہل دِینٍ۔","","Musannaf Ibn Abi Shaybah 23336","","","كتاب البيوع والأقضية"
"23337","(۲۳۳۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ رَاشِدٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ مِلَّۃٍ عَلَی مِلَّۃٍ إلاَّ الْمُسْلِمِینَ۔n قَالَ وَکِیعٌ : کَانَ ابْنُ أَبِی لَیْلَی لاَ یُجِیزُ شَہَادَۃَ الْیَہُودِیِّ عَلَی النَّصْرَانِیِّ ، وَلاَ النَّصْرَانِیِّ عَلَی الْیَہُودِیِّ۔n(عبدالرزاق ۱۵۵۲۵۔ بیہقی ۱۶۳)","No Data Available","Musannaf Ibn Abi Shaybah 23337","","","كتاب البيوع والأقضية"
"23338","(۲۳۳۳۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ جَہْمٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : تجوز شَہَادَۃُ أَہْلِ الْکِتَابِ بَعْضِہِمْ عَلَی بَعْضٍ لِلْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 23338","","","كتاب البيوع والأقضية"
"23339","(۲۳۳۳۹) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، قَالَ: تَجُوزُ شَہَادَتُہُمْ لِلْمُسْلِمِینَ بَعْضِہِمْ عَلَی بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 23339","","","كتاب البيوع والأقضية"
"23340","(۲۳۳۴۰) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبَّاسٍ ، عَنْ شُرَیْحٍ۔ وَعَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالاَ : لاَ کَفَالَۃَ لِلْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 23340","","","كتاب البيوع والأقضية"
"23341","(۲۳۳۴۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ وَحُمَیْدٍ ، عَنِ الْحَسَنِ : أَنَّ رَجُلاً مِنْ قُرَیْشٍ سَرَقَ بَعِیرًا فَقَطَعَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدَہُ۔ قَالَ : وَکَانَتْ تَجُوزُ شَہَادَتُہُ۔ (ابوداؤد ۳۹۵)","Hasan","Musannaf Ibn Abi Shaybah 23341","","","كتاب البيوع والأقضية"
"23342","(۲۳۳۴۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : شَہِدَ عِنْدَ شُرَیْحٍ أَقْطَعُ ، فَأَثْنَی عَلَیْہِ خَیْرًا۔ فَقَالَ شُرَیْحٌ : نُجِیزُ شَہَادَۃَ صَاحِبِ کُلِّ حَدٍّ إذَا کَانَ یَوْمَ یَشْہَدُ عَدْلاً إلاَّ الْقَاذِفَ ، فَإِنَّ تَوْبَتَہُ فِیمَا بَیْنَہُ وَبَیْنَ اللہِ۔","","Musannaf Ibn Abi Shaybah 23342","","","كتاب البيوع والأقضية"
"23343","(۲۳۳۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ شُرَیْحٍ : أَنَّہُ أَجَازَ شَہَادَۃَ أَقْطَعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23343","","","كتاب البيوع والأقضية"
"23344","(۲۳۳۴۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ، عَنْ عَامِرٍ ، قَالَ: أُتِیَ عَلِیٌّ فِی بَعْضِ الأَمْرِ ، وَقَالَ وَکِیعٌ: فِی شَیْئٍ ، فَقَالَ : إِنَّہُ لَجَوْرٌ ، وَلَوْلا أَنَّہُ صُلْحٌ لَرَدَدْتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 23344","","","كتاب البيوع والأقضية"
"23345","(۲۳۳۴۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : أَیُّمَا امْرَأَۃٍ صُولِحَتْ عَلَی ثُمُنِہَا ، وَلَمْ یُبَیَّنْ لَہَا مَا تَرَکَ زَوْجُہَا ، فَتِلْکَ الرِّیبَۃُ کُلُّہَا۔","","Musannaf Ibn Abi Shaybah 23345","","","كتاب البيوع والأقضية"
"23346","(۲۳۳۴۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : مَا شَہِدْتُ شُرَیْحًا أَمَرَ بِصُلْحٍ إلاَّ مَرَّۃً ، وَذَلِکَ أَنَّ رَجُلاً أَسْوَدَ اسْتَوْدَعَ امْرَأَۃً ثَمَانِینَ دِرْہَمًا فَحَوَّلَتْ مَتَاعَہَا ، فَضَاعَتِ الدَّرَاہِمُ ، فَخَاصَمَہَا إلَی شُرَیْحٍ ، فَقَالَ : أَتَتَّہِمُہَا؟ قَالَ : لاَ ، قَالَ : إِنْ شِئْتَ أَخَذْت خَمْسِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23346","","","كتاب البيوع والأقضية"
"23347","(۲۳۳۴۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنْ أَبِی حَصِینٍ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ : أَنَّہُ رُبَّمَا أَتَاہُ الْقَوْمُ یَخْتَصِمُونَ إلَیْہِ فِی الشَّیْئِ فَیَقُولُ : اذْہَبُوا فَاصْطَلِحُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 23347","","","كتاب البيوع والأقضية"
"23348","(۲۳۳۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، عَنِ ابْنِ سِیرِینَ، أَنَّہُ قَالَ: رُبَّمَا أَتَی شُرَیْحًا الْقَوْمُ یَخْتَصِمُونَ إلَیْہِ فَیَقُولُ : اذْہَبُوا إلَی عَبِیْدَۃَ۔","","Musannaf Ibn Abi Shaybah 23348","","","كتاب البيوع والأقضية"
"23349","(۲۳۳۴۹) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا مِسْعَرٌ ، عَنْ أَزْہَرَ الْعَطَّارِ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، قَالَ عُمَرُ: رُدُّوا الْخُصُومَ حَتَّی یَصْطَلِحُوا ، فَإِنَّ فَصْلَ الْقَضَائِ یُورِثُ بَیْنَ الْقَوْمِ الضَّغَائِنَ۔","Hasan","Musannaf Ibn Abi Shaybah 23349","","","كتاب البيوع والأقضية"
"23350","(۲۳۳۵۰) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : بَعَثَ عُمَرُ بْنُ الْخَطَّابِ قَاضِیًا ، فَاخْتَصَمَ إلَیْہِ رَجُلاَنِ فِی دِینَارٍ ، قَالَ : فَأَعْطَاہُ أَحَدَہُمَا ، وَأَعْطَی الآخَرَ دِینَارًا مِنْ عِنْدِہِ ، فَبَلَغَ ذَلِکَ عُمَرَ فَبَعَثَ إلَیْہِ فَعَزَلَہُ۔","","Musannaf Ibn Abi Shaybah 23350","","","كتاب البيوع والأقضية"
"23351","(۲۳۳۵۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا رَضِیَ الْخَصْمَانِ بِقَوْلِ رَجُلٍ جَازَ عَلَیْہِمَا مَا قَالَ۔","","Musannaf Ibn Abi Shaybah 23351","","","كتاب البيوع والأقضية"
"23352","(۲۳۳۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : جَائَ رَجُلاَنِ یَخْتَصِمَانِ إلَی عَبِیْدَۃَ ، فَقَالَ : تُؤَمِّرَانِی عَلَیْکُمَا ؟ قَالاَ : نَعَمْ ، فَقَضَی بَیْنَہُمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23352","","","كتاب البيوع والأقضية"
"23353","(۲۳۳۵۳) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ یَعْنِی ابْنَ أَبِی فَرْوَۃَ ، عَنْ غَیْلاَنَ ، قَالَ : قُلْتُ لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ : لَوْ غَیَّرْتَ ہَذِہِ الدَّرَاہِمَ فَإِنَّہَا تَقَعُ فِی یَدِ الْیَہُودِیِّ وَالنَّصْرَانِیِّ وَالْجُنُبِ وَالْمَجُوسِیِّ ، قَالَ : أَرَدْتَ أَنْ تَحْتَجَّ عَلَیْنَا الأُمَمُ ، تُرِیدُ أَنْ نُغَیِّرَ تَوْحِیدَ ربِّنَا وَاسْمَ نَبِیِّنَا؟!۔","","Musannaf Ibn Abi Shaybah 23353","","","كتاب البيوع والأقضية"
"23354","(۲۳۳۵۴) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مُحَمَّدِ بْنِ فَضَاء ، عَنْ أَبِیہِ ، عَنْ عَلْقَمَۃَ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ کَسْرِ سِکَّۃِ الْمُسْلِمِینَ الْجَائِزَۃِ بَیْنَہُمْ إلاَّ مِنْ بَأْسٍ۔n(ابوداؤد ۳۴۴۳۔ حاکم ۳۱)","Da'if","Musannaf Ibn Abi Shaybah 23354","","","كتاب البيوع والأقضية"
"23355","(۲۳۳۵۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : أَثِمَ النَّاسُ فِی ضربہم الدَّرَاہِمِ الْبِیضِ۔","","Musannaf Ibn Abi Shaybah 23355","","","كتاب البيوع والأقضية"
"23356","(۲۳۳۵۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِی فَرْوَۃَ ، سَمِعَ ابْنَ أَبِی لَیْلَی ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّاب : مَنْ زَافَتْ عَلَیْہِ وَرِقُہُ فَلاَ یُحَالِفُ النَّاسَ إنَّہَا طَیِّبَۃٌ ، وَلَکِنْ لِیَخْرُجْ بِہَا إلَی السُّوقِ فَلْیَقُلْ : مَنْ یَبِیعُنِی بہَذِہِ الدَّرَاہِمِ الزُّیُوفِ سَحْقَ ثَوْبٍ ، أَوْ حَاجَۃً مِنْ حَاجَتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 23356","","","كتاب البيوع والأقضية"
"23357","(۲۳۳۵۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِیہِ ، عَنْ رَجُلٍ مِنَ السَّمَّانِینَ ، قَالَ : قَالَ عَلِیٌّ : إذَا کَانَ لأَحَدِکُمْ دَرَاہِم لاَ تُنْفَقُ عَنْہُ فَلْیَبْتَعْ بِہَا ذَہَبًا ، وَلْیَبْتَعْ بِالذَّہَبِ مَا یُنْفَقُ عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 23357","","","كتاب البيوع والأقضية"
"23358","(۲۳۳۵۸) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا سَلَمَۃُ بْنُ نُبَیْطٍ ، عَنِ الضَّحَّاکِ بْنِ مُزَاحِمٍ ، قَالَ : بَاعَ ابْنُ مَسْعُودٍ نُفَایَۃَ بَیْتِ الْمَالِ مَرَّۃً ، ثُمَّ لَقِیَ عُمَرَ فَلَمْ یَعُدْ لِذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 23358","","","كتاب البيوع والأقضية"
"23359","(۲۳۳۵۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ: أَنَّ عُمَرَ نَہَی عَبْدَ اللہِ أَنْ یَبِیعَ نُفَایَۃَ بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 23359","","","كتاب البيوع والأقضية"
"23360","(۲۳۳۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ حُوْطٍ الْعَبْدِیِّ ، قَالَ : جَعَلَنِی عَبْدُ اللہِ عَلَی بَیْتِ الْمَالِ ، فَکُنْتُ إذَا مَرَّ بِی دِرْہَمٌ زَیْفٌ کسرتہ۔","Sahih","Musannaf Ibn Abi Shaybah 23360","","","كتاب البيوع والأقضية"
"23361","(۲۳۳۶۱) حَدَّثَنَا ابن مہدی ، عن سفیان ، عن منصور ، عَنْ إبْرَاہِیمَ ، عن میمون بن أبی شبیب : أنَّہُ کَانَ إذَا مَرَّ بِہِ دِرْہَمٌ زَیْفٌ کَسَرَہُ ، وَیَقُولُ : لاَ یُغَرُّ بِہِ الْمُسْلِمُونَ۔","","Musannaf Ibn Abi Shaybah 23361","","","كتاب البيوع والأقضية"
"23362","(۲۳۳۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، قَالَ : قُلْتُ لِمُحَمَّدِ بْنِ سِیرِینَ : أَشْتَرِی بِالدِّرْہَمِ الزَّیْفِ وَأُبَیِّنُہُ؟ قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23362","","","كتاب البيوع والأقضية"
"23363","(۲۳۳۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، قَالَ : رَأَیْتُ صَفْوَانَ بْنَ مُحْرِزٍ أَتَی السُّوقَ وَمَعَہُ دِرْہَمٌ زَیْفٌ فَقَالَ : مَنْ یَبِیعُنِی عِنَباً طَیِّبًا بِدِرْہَمٍ خَبِیثٍ ؟! فَاشْتَرَی وَلَمْ یُشْہِدْ۔","","Musannaf Ibn Abi Shaybah 23363","","","كتاب البيوع والأقضية"
"23364","(۲۳۳۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ ، قَالَ : قُلْتُ لِلْحَسَنِ : یَا أَبَا سَعِیدٍ یَجْتَمِعُ عِنْدِی الدَّرَاہِمُ النُّحَاسُ فَأَبِیعُہَا وَأُبَیِّنُہَا ؟ قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23364","","","كتاب البيوع والأقضية"
"23365","(۲۳۳۶۵) حَدَّثَنَا زِیَادُ بْنُ الرَّبِیعِ ، عَنْ صَالِحٍ الدَّہَّانِ ، عَنْ جَابِرِ بْنِ زَیْدٍ : أَنَّہُ کَانَ إذَا وَقَعَ فِی یَدِہِ دِرْہَمٌ زَیْفٌ کَسَرَہُ وَقَالَ : مَا یَحِلُّ أَنْ یُغَرَّ بِہِ مُسْلِمٌ۔","","Musannaf Ibn Abi Shaybah 23365","","","كتاب البيوع والأقضية"
"23366","(۲۳۳۶۶) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ یَعْقُوبَ بْنِ قَیْسٍ : أَنَّ سَعِیدَ بْنَ جُبَیْرٍ کَانَ فِی یَدِہِ دِرْہَمٌ ، فَقُلْتُ لَہُ : أَرنِیہ، فَأَعْطَانِیہِ ، وَقَالَ : لَوْ کَانَ رَدِیئاً لَمْ أُعْطِکَہُ۔","","Musannaf Ibn Abi Shaybah 23366","","","كتاب البيوع والأقضية"
"23367","(۲۳۳۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : أَنَّ مُعَاذَ بْنَ جَبَلٍ دَارَ عَلَیْہِ دَیْنٌ ، فَأَخْرَجَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنْ مَالِہِ لِغُرَمَائِہِ۔","","Musannaf Ibn Abi Shaybah 23367","","","كتاب البيوع والأقضية"
"23368","(۲۳۳۶۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ مَنْصُورٍ ، عَنْ شُرَیْحٍ ، قَالَ : کَانَ یَبِیعُ مَا فَوْقَ الإِزَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23368","","","كتاب البيوع والأقضية"
"23369","(۲۳۳۶۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ دِلاَفٍ ، عَنْ أَبِیہِ ، عَنْ عَمِّ أَبِیہِ بِلاَلِ بْنِ الْحَارِثِ ، قَالَ : کَانَ رَجُلٌ یُغَالِی بِالرَّوَاحِلِ ، وَیَسْبِقُ الْحَاجَّ ، حَتَّی أَفْلَسَ ، قَالَ : فَخَطَبَ عُمَرُ بْنُ الْخَطَّابِ فَقَالَ : أَمَّا بَعْدُ فَإِنَّ الأُسَیْفِعَ أُسَیْفِعَ جُہَیْنَۃَ رَضِیَ مِنْ أَمَانَتِہِ وَدِینِہِ أَنْ ، یُقَالَ: سَبَقَ الْحَاجَّ، فَادَّانَ مُعْرِضًا ، فَأَصْبَحَ قَدْ دِیْنَ بِہِ ، فَمَنْ کَانَ لَہُ عَلْیہِ شَیْئٌ فَلِیَأْتِنَا حَتَّی نُقَسِّمَ مَالَہُ بَیْنَہُمْ۔ (مالک ۸)","Da'if","Musannaf Ibn Abi Shaybah 23369","","","كتاب البيوع والأقضية"
"23370","(۲۳۳۷۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی ذِئْبٍ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَانَ لاَ یَبِیعُ خَادِمَ الرَّجُلِ، وَلاَ مَسْکَنَہُ فِی الدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 23370","","","كتاب البيوع والأقضية"
"23371","(۲۳۳۷۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ عَمْرِو بْنِ مَیْمُونٍ، عَنْ عُمَرَ بْنِ عَبْدِالْعَزِیزِ: أَنَّہُ فَلَّسَ رَجُلاً وَآجَرَہُ۔","","Musannaf Ibn Abi Shaybah 23371","","","كتاب البيوع والأقضية"
"23372","(۲۳۳۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ رَجُلٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ إذَا فَلَّسَ رَجُلاً جَعَلَ مَا بَقِیَ بَیْنَ غُرَمَائِہِ۔","","Musannaf Ibn Abi Shaybah 23372","","","كتاب البيوع والأقضية"
"23373","(۲۳۳۷۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَن الأعمش ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بأس بہ۔","","Musannaf Ibn Abi Shaybah 23373","","","كتاب البيوع والأقضية"
"23374","(۲۳۳۷۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ وَالْقَاسِمِ وَطَاوُوسٍ وَمُجَاہِدٍ وَمُحَمَّدِ بْنِ عَلِیٍّ وَعَطَائٍ ، قَالُوا : لاَ بَأْسَ بِالسَّلَمِ فِی الْحَرِیرِ۔n قَالَ : قَالَ وَکِیعٌ : نَرْجُو أَنْ لاَ یَکُونَ بِہِ بَأْسٌ۔","","Musannaf Ibn Abi Shaybah 23374","","","كتاب البيوع والأقضية"
"23375","(۲۳۳۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الفَزَعِ بْنِ عُفَیقٍ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : مَا تَقُولُ فِی السَّرَقِ ؟ قَالَ: وَمَا السَّرَقُ ؟ قُلْتُ : الْحَرِیرُ ، أَوْ شُقَقُ الْحَرِیرِ ، قَالَ : یَا أَہْلَ الْعِرَاقِ ، إنَّکُمْ تُسَمُّونَ أَسْمَائً مُنْکَرَۃً ، أَوَلاَ تَقُولُ : شُقَقُ الْحَرِیرِ ؟! قُلْتُ : فَإِنَّ لَہُ فِی السُّوقِ سِعْرًا نَشْتَرِیہ بِسِعْرٍ ، وَنَبِیعُہُ إلَی الْعَطَائِ بِأَکْثَرَ مِنْ ذَلِکَ، قَالَ : إذَا اشْتَرَیْتَہُ وَقَبَضْتَہُ فَبِعْہُ کَیْفَ شِئْتَ۔","Da'if","Musannaf Ibn Abi Shaybah 23375","","","كتاب البيوع والأقضية"
"23376","(۲۳۳۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ الْوَلِیدِ الْمُزَنِیّ ، عَنْ رَجُلٍ ، عَنِ ابن مَعْقِلٍ : أَنَّہُ کَرِہَ السَّلَمَ فِی الْحَرِیر۔","","Musannaf Ibn Abi Shaybah 23376","","","كتاب البيوع والأقضية"
"23377","(۲۳۳۷۷) حَدَّثَنَا مُعْتَمِرٌ، عَنْ أَبِیہِ، قَالَ: سُئِلَ طَاوُوسٌ، عَنِ السَّلَمِ فِی الْعَرْضِ ، أَوْ قَالَ: الْعُرُوضِ ، قَالَ: لاَ بَأْسَ۔ وَسُئِلَ عَنِ السَّلَمِ فِی الْحَرِیرِ؟ فَقَالَ : لاَ أَدْرِی مَا الْحَرِیرُ۔","","Musannaf Ibn Abi Shaybah 23377","","","كتاب البيوع والأقضية"
"23378","(۲۳۳۷۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إسْرَائِیلُ وَشَرِیکٌ، عَنْ أَبِی إِسْحَاقَ، عَنْ مَسْرُوقٍ: أَنَّہُ کَرِہَ السَّلَمَ فِی الْحَرِیرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23378","","","كتاب البيوع والأقضية"
"23379","(۲۳۳۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : أَنَّہُ کَرِہَ السَّلَمَ فِی الْحَرِیرِ۔","","Musannaf Ibn Abi Shaybah 23379","","","كتاب البيوع والأقضية"
"23380","(۲۳۳۸۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ۔ وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالا : مَا ذَہَبَ مِنَ الرَّہْنِ مِنْ شَیْئٍ فَبِحِسَابِ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23380","","","كتاب البيوع والأقضية"
"23381","(۲۳۳۸۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : سَأَلْتُہُ عَنْ رَجُلٍ ارْتَہَنَ دَارًا فَاحْتَرَقَتْ ، قَالَ: حَقُّہُ فِیمَا ذَہَبَ ، وَحَقُّہُ فِیمَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 23381","","","كتاب البيوع والأقضية"
"23382","(۲۳۳۸۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ : فِی رَجُلٍ ارْتَہَنَ دَارًا فَاحْتَرَقَتْ ، قَالَ : حقُّہُ فِی الْعَرْصَۃِ۔","","Musannaf Ibn Abi Shaybah 23382","","","كتاب البيوع والأقضية"
"23383","(۲۳۳۸۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ رَہَنَ ثَوْبًا فَأْتُکِلَ ، قَالَ : یُلْقِی مِنْہُ بِقَدْرِ مَا نَقَصَ مِنْ قِیمَۃِ الثَّوْبِ۔","","Musannaf Ibn Abi Shaybah 23383","","","كتاب البيوع والأقضية"
"23384","(۲۳۳۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إذَا قَبَضَ الْمُرْتَہِنُ الرَّہْنَ ، ثُمَّ مَاتَ الرَّاہِنُ وَعَلَیْہِ دَیْنٌ ، فَہُوَ أَحَقُّ بِہِ مِنَ الْغُرَمَائِ حَتَّی یُسْتَوْفَی۔","No Data Available","Musannaf Ibn Abi Shaybah 23384","","","كتاب البيوع والأقضية"
"23385","(۲۳۳۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ وَسَالِمٍ وَعَامِرٍ ، قَالُوا : إذَا مَاتَ الرَّاہِنُ وَعَلَیْہِ دَیْنٌ ، فَالْمُرْتَہِنُ أَحَقُّ بِہِ مِنَ الْغُرَمَائِ حَتَّی یُسْتَوْفَی۔","No Data Available","Musannaf Ibn Abi Shaybah 23385","","","كتاب البيوع والأقضية"
"23386","(۲۳۳۸۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ : فِی الرَّجُلِ یَرْہَنُ الرَّہْنَ ، ثُمَّ یَمُوتُ صَاحِبُہُ ، وَلاَ یَدَعُ مَالاً غَیْرَ الرَّہْنِ ، وَعَلَیْہِ دَیْنٌ سِوَی دَیْنِ صَاحِبِ الرَّہْنِ ؟ قَالَ : الْمُرْتَہِنُ أَحَقُّ بِالرَّہْنِ مِنْ غُرَمَائِ الْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 23386","","","كتاب البيوع والأقضية"
"23387","(۲۳۳۸۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إنَّ الرَّہْنَ الْمَقْبُوضَ إذَا مَاتَ صَاحِبُہُ ، أَوْ أَفْلَسَ فَالَّذِی ہُوَ فِی یَدِہِ أَحَقُّ بِہِ ، فَإِنْ لَمْ یَکُنْ مَقْبُوضًا ، فَہُوَ بَیْنَ الْغُرَمَائِ۔","","Musannaf Ibn Abi Shaybah 23387","","","كتاب البيوع والأقضية"
"23388","(۲۳۳۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، حَدَّثَنَا عَامِرٌ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَجَازَ شَہَادَۃَ خُزَیْمَۃَ بْنِ ثَابِتٍ بِشَہَادَۃِ رَجُلَیْنِ۔ (ابوداؤد ۳۶۰۲۔ نسائی ۶۲۴۳)","","Musannaf Ibn Abi Shaybah 23388","","","كتاب البيوع والأقضية"
"23389","(۲۳۳۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : شَہِدْتُ عِنْدَ زُرَارَۃَ بْنِ أَوْفَی عَلَی شَہَادَۃِ وَحْدِی ، فَأَجَازَ شَہَادَتِی ، وَبِئْسَ مَا صَنَعَ۔","","Musannaf Ibn Abi Shaybah 23389","","","كتاب البيوع والأقضية"
"23390","(۲۳۳۹۰) حَدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : شَہِدْتُ عِنْدَ شُرَیْحٍ عَلَی شَہَادَۃٍ وَحْدِی عَلَی وَصِیَّۃٍ فَأَجَازَ شَہَادَتِی۔","","Musannaf Ibn Abi Shaybah 23390","","","كتاب البيوع والأقضية"
"23391","(۲۳۳۹۱) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : قَالَ لِی شُرَیْحٌ : تَشْہَدُ أَنَّہُ خَطُّکَ بِیَدِکَ ، وَأملی رَزِینٌ عَلَیْکَ؟ قُلْتُ : نَعَمْ ، فَأَجَازَ شَہَادَتِی وَحْدِی۔","","Musannaf Ibn Abi Shaybah 23391","","","كتاب البيوع والأقضية"
"23392","(۲۳۳۹۲) حَدَّثَنَا ابن إدریس ، عن أشعث ، عن أبی قیس : أن شریحًا أجاز شہادتہ وحدہ علی مصحف۔","","Musannaf Ibn Abi Shaybah 23392","","","كتاب البيوع والأقضية"
"23393","(۲۳۳۹۳) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ شُرَیْحٍ : أَنَّہُ أَجَازَ شَہَادَتَہُ وَحْدَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23393","","","كتاب البيوع والأقضية"
"23394","(۲۳۳۹۴) حَدَّثَنَا جَرِیرٌ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنِ ابْنِ مَعْقِل: فِی الرَّجُلِ یَکُونُ لَہُ عَلَی الرَّجُلِ الدَّیْنُ فَیَجْحَدُہُ، ثُمَّ یَقْدِرُ لَہُ عَلَی مَالٍ ؟ قَالَ : لاَ یُعَارِضُہُ ، یُؤَدِّی وَدِیعَتَہُ۔","","Musannaf Ibn Abi Shaybah 23394","","","كتاب البيوع والأقضية"
"23395","(۲۳۳۹۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سفیان ، عن دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : ہُوَ أَسْعَدُ۔","","Musannaf Ibn Abi Shaybah 23395","","","كتاب البيوع والأقضية"
"23396","(۲۳۳۹۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ عَطَائٍ ، قَالَ : کَانَ لِرَجُلٍ مِنْ أَصْحَابِنَا عَلَی رَجُلٍ مَالٌ فَجَحَدَہُ ، ثُمَّ وَقَعَ لَہُ عِنْدِی شَیْئٌ ، فَجَائَنِیْ وَسَأَلَنِی وَسَأَلَ أَصْحَابَنَا ، فَقَالُوا : یَأْخُذُہُ ، وَسَأَلْت ابْنَ مَعْقِلٍ ؟ فَقَالَ : یُؤَدِّی أَمَانَتَہُ وَیَطْلُبُ حَقَّہُ ، فَإِنْ کَانَ لَہُ بَیِّنَۃٌ أَخَذَ بِحَقِّہِ وَإِلاَّ اسْتَحْلَفَہُ۔","","Musannaf Ibn Abi Shaybah 23396","","","كتاب البيوع والأقضية"
"23397","(۲۳۳۹۷) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ : أَنَّہُ کَانَ إذَا سُئِلَ عَنْ ہَذَا قَرَأَ ہَذِہِ الآیَۃَ : {وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا بِمِثْلِ مَا عُوقِبْتُمْ بِہِ}۔","No Data Available","Musannaf Ibn Abi Shaybah 23397","","","كتاب البيوع والأقضية"
"23398","(۲۳۳۹۸) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ سَعِیدٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَقْبِضُ مَا لَمْ یُحَلَّفْ۔","No Data Available","Musannaf Ibn Abi Shaybah 23398","","","كتاب البيوع والأقضية"
"23399","(۲۳۳۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الرَّجُلِ یَکُونُ لَہُ عَلَی الرَّجُلِ الدَّیْنُ فَیَجْحَدُہُ ، فَیَقَعُ لَہُ عِنْدَہُ الْمَالُ ؟ قَالَ الْحَکَمُ : قَالَ إبْرَاہِیمُ : لاَ بَأْسَ أَنْ یَقْبِضَ مَا لَمْ یَخَفْ أَنْ یُسْتَحْلَفَ۔n قَالَ : قَالَ وَکِیعٌ : کَذَلِکَ نَقُولُ۔","","Musannaf Ibn Abi Shaybah 23399","","","كتاب البيوع والأقضية"
"23400","(۲۳۴۰۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، قَالَ : مَکْتُوبٌ فِی التَّوْرَاۃِ: لاَ تَخُنِ الْخَائِنَ خِیَانَتُہُ تَکْفِیکَ۔","","Musannaf Ibn Abi Shaybah 23400","","","كتاب البيوع والأقضية"
"23401","(۲۳۴۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا مِسْکِینٌ أَبُو ہُرَیْرَۃَ التَّیْمِیُّ ، قَالَ: سَأَلْتُ مُجَاہِدًا عَنْ ذَلِکَ؟ فَقَالَ: لاَ تَخُونہ۔","","Musannaf Ibn Abi Shaybah 23401","","","كتاب البيوع والأقضية"
"23402","(۲۳۴۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ تَخُونہ۔","","Musannaf Ibn Abi Shaybah 23402","","","كتاب البيوع والأقضية"
"23403","(۲۳۴۰۳) حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ ، عَنْ أَبِی مَکِینٍ : أَنَّ أَبَا مِجْلَزٍ ، وَیَحْیَی بْنَ عَقِیلٍ ، قَالَ أَحَدُہُمَا : رَجُلٌ خَانَنِی فَذَہَبَ مِنِّی بِدَرَاہِمٍ ، فَصَارَتْ لَہُ عِنْدِی دَرَاہِمُ ، أَفَلاَ آخُذُ مِنْ دَرَاہِمِہِ کَمَا أَخَذَ مِنْ دَرَاہِمِی ؟ قَالَ لِی: لاَ تَأْخُذْ لِکَیْ لاَ آخُذَ ، قَالَ الآخَرُ : لَکِنِّی آخُذُ۔","","Musannaf Ibn Abi Shaybah 23403","","","كتاب البيوع والأقضية"
"23404","(۲۳۴۰۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَدِّ الأَمَانَۃَ ، وَلاَ تَخُنْ مَنْ خَانَکَ۔ (بخاری ۳۱۴۲۔ ابوداؤد ۳۵۲۹)","Hasan","Musannaf Ibn Abi Shaybah 23404","","","كتاب البيوع والأقضية"
"23405","(۲۳۴۰۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : لاَ بَأْسَ أَنْ یَقْتَصَّ الذَّہَبَ مِنَ الذَّہَبِ ، وَالْفِضَّۃَ مِنَ الْفِضَّۃِ، وَلاَ یَقْتَصُّ عُرُوضًا ، وَلاَ حَیَوَانًا مِنْ ذَہَبٍ ، وَلاَ فِضَّۃٍ۔n قَالَ : قَالَ وَکِیعٌ : وَکَذَلِکَ نَقُولُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23405","","","كتاب البيوع والأقضية"
"23406","(۲۳۴۰۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : ہُوَ أَسْعَدُ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23406","","","كتاب البيوع والأقضية"
"23407","(۲۳۴۰۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَفْلَسَ الْعَبْدُ فَاعْتَرَفَ بِالدَّیْنِ فَإِنَّہُ لاَ یَجُوزُ قَوْلُہُ۔","","Musannaf Ibn Abi Shaybah 23407","","","كتاب البيوع والأقضية"
"23408","(۲۳۴۰۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ، قَالَ : لاَ یُقْضَی دَیْنُ الْمَمْلُوکِ إلاَّ بِبَیِّنَۃٍ۔","","Musannaf Ibn Abi Shaybah 23408","","","كتاب البيوع والأقضية"
"23409","(۲۳۴۰۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یَجُوزُ إقْرَارُ مَمْلُوکٍ بِدَیْنٍ إلاَّ أَنْ یَکُونَ مَأْذُونًا لَہُ فِی التِّجَارَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23409","","","كتاب البيوع والأقضية"
"23410","(۲۳۴۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَکْرَہُ أَنْ یَقُولَ : أَدُلُّکَ عَلَی الْمَتَاعِ وَتُشْرِکُنِی فِیہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23410","","","كتاب البيوع والأقضية"
"23411","(۲۳۴۱۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی حُرَّۃَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ قَالَ : أَدُلُّکَ عَلَی بَیْعِ کَذَا وَکَذَا ، وَتُشْرِکُ فِیہِ أَخِی ؟ قَالَ : الْبَیْعُ عَنْ تَرَاضٍ۔","","Musannaf Ibn Abi Shaybah 23411","","","كتاب البيوع والأقضية"
"23412","(۲۳۴۱۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ : أَنَّہُ کَانَ یَکْرَہُ أَنْ یَدُلَّ الرَّجُلَ عَلَی الْمَتَاعِ عَلَی أَنْ یُشْرِکَہُ۔","","Musannaf Ibn Abi Shaybah 23412","","","كتاب البيوع والأقضية"
"23413","(۲۳۴۱۳) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ فِی قولہ تعالی : {یَا أَیُّہَا الَّذِینَ آمَنُوا کُونُوا قَوَّامِینَ بِالْقِسْطِ} قَالَ : الرَّجُلاَنِ یَجْلِسَانِ عِنْدَ الْقَاضِی ، فَیَکُونُ لَیُّ الْقَاضِی وَإِکْرَاہُہُ لأَحَدِ الرَّجُلَیْنِ دُونَ الآخَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 23413","","","كتاب البيوع والأقضية"
"23414","(۲۳۴۱۴) حَدَّثَنَا عَبْدُ الرحیم بْنُ سُلَیْمَانَ ، عَنْ الْمُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَا مِنْ حَکَمٍ یَحْکُمُ بَیْنَ النَّاسِ إلاَّ حُشِرَ یَوْمَ الْقِیَامَۃِ ، وَمَلَکٌ آخِذٌ بِقَفَاہُ حَتَّی یَقِفَ بِہِ عَلَی جَہَنَّمَ ، ثُمَّ یَرْفَعُ رَأْسَہُ إلَی الرَّحْمَان ، فَإِنْ قَالَ لَہُ : اطْرَحْہُ ، طَرَحَہُ فِی مَہْوَی أَرْبَعِینَ خَرِیفًا۔n قَالَ : وَقَالَ مَسْرُوقٌ : لأَنْ أَقْضِیَ یَوْمًا آخُذُ بِحَقٍّ وَعَدْلٍ أَحَبُّ إلَیَّ مِنْ سَنَۃٍ أَغْزُوہَا فِی سَبِیلِ اللہِ۔n(ابن ماجہ ۲۳۱۱۔ احمد ۱/۴۳۰)","Da'if","Musannaf Ibn Abi Shaybah 23414","","","كتاب البيوع والأقضية"
"23415","(۲۳۴۱۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنِ الْمِنْہَالِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ بَلاَئُ سُلَیْمَانَ الَّذِی اُبْتُلِیَ بِہِ فِی نَاسٍ مِنْ أَہْلِ الْجَرَادَۃِ ، وَکَانَتِ الْجَرَادَۃُ امْرَأَۃً ، وَکَانَ ہَوَی سُلَیْمَانَ أَنْ یَکُونَ الْحَقُّ لأَہْلِ الْجَرَادَۃِ فَیَقْضِیَ لَہُمْ بِہِ۔ (نسائی ۱۰۹۹۳۔ طبری ۴۴۹)","Hasan","Musannaf Ibn Abi Shaybah 23415","","","كتاب البيوع والأقضية"
"23416","(۲۳۴۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ عَبْدِ الْعَزِیزِ التَّنُوخِیُّ ، عَنْ إسْمَاعِیلَ بْنِ عُبَیْدِ اللہِ بْنِ أبی الْمُہَاجِرِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ الأَشْعَرِیِّ ، قَالَ : قَالَ عُمَرُ : وَیْلٌ لِدَیَّانِ أَہْلِ الأَرْضِ مِنْ دَیَّانِ أَہْلِ السَّمَائِ یَوْمَ یَلْقَوْنَہُ إلاَّ مَنْ أَمَّ الْعَدْلَ وَقَضَی بِالْحَقِّ ، وَلَمْ یَقْضِ لِہَوًی ، وَلاَ قَرَابَۃٍ ، وَلاَ لِرَغْبَۃٍ ، وَلاَ لِرَہْبَۃٍ ، وَجَعَلَ کِتَابَ اللہِ مِرْآۃً بَیْنَ عَیْنَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 23416","","","كتاب البيوع والأقضية"
"23417","(۲۳۴۱۷) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : سَمِعْتُ رُفَیْعًا أَبَا الْعَالِیَۃِ ، قَالَ : قَالَ عَلِیٌّ : الْقُضَاۃُ ثَلاَثَۃٌ : اثْنَانِ فِی النَّارِ ، وَوَاحِدٌ فِی الْجَنَّۃِ ، فَذَکَرَ اللَّذَیْنِ فِی النَّارِ ، قَالَ : رَجُلٌ جَارَ مُتَعَمِّدًا فَہَذَا فِی النَّارِ ، وَرَجُلٌ أَرَادَ الْحَقَّ فَأَخْطَأَ فَہُوَ فِی النَّارِ ، وَآخَرُ أَرَادَ الْحَقَّ فَأَصَابَ فَہُوَ فِی الْجَنَّۃِ۔ قَالَ : فَقُلْتُ لِرُفَیْعٍ : أَرَأَیْت ہَذَا الَّذِی أَرَادَ الْحَقَّ فَأَخْطَأَ ! قَالَ : کَانَ حَقُّہُ إذَا لَمْ یَعْلَمِ الْقَضَائَ أَنْ لاَ یَکُونَ قَاضِیًا۔n(ترمذی ۱۳۲۲۔ ابوداؤد ۳۵۶۸)","Sahih","Musannaf Ibn Abi Shaybah 23417","","","كتاب البيوع والأقضية"
"23418","(۲۳۴۱۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ قَتَادَۃَ : أَنَّ أَبَا مُوسَی الأَشْعَرِیَّ ، قَالَ : لاَ یَنْبَغِی لِقَاضٍ أَنْ یَقْضِیَ حَتَّی یَتَبَیَّنَ لَہُ الْحَقُّ کَمَا یَتَبَیَّنُ اللَّیْلُ عَنِ النَّہَارِ ، قَالَ : فَبَلَغَ ذَلِکَ عُمَرَ فَقَالَ : صَدَقَ أَبُو مُوسَی۔","","Musannaf Ibn Abi Shaybah 23418","","","كتاب البيوع والأقضية"
"23419","(۲۳۴۱۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی قَوْلِہِ (وَفَصْلَ الْخِطَاب) قَالَ: الْعِلْمُ بِالْقَضَائِ۔","","Musannaf Ibn Abi Shaybah 23419","","","كتاب البيوع والأقضية"
"23420","(۲۳۴۲۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ، قَالَ : الشُّہُودُ وَالأَیْمَانُ۔","","Musannaf Ibn Abi Shaybah 23420","","","كتاب البيوع والأقضية"
"23421","(۲۳۴۲۱) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ :فِی قَوْلِہِ : (یُؤْتِی الْحِکْمَۃَ مَنْ یَشَائُ) قَالَ : لَیْسَتِ النُّبُوَّۃُ ، وَلَکِنَّہُ الْعِلْمُ وَالْقُرْآنُ وَالْفِقْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23421","","","كتاب البيوع والأقضية"
"23422","(۲۳۴۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ زِیَادٍ ، قَالَ : (فَصْلَ الْخِطَابِ) أَمَّا بَعْدُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23422","","","كتاب البيوع والأقضية"
"23423","(۲۳۴۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ، قَالَ : الشُّہُودُ وَالأَیْمَانُ۔","","Musannaf Ibn Abi Shaybah 23423","","","كتاب البيوع والأقضية"
"23424","(۲۳۴۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَحْکُمُ الْحَکَمُ بَیْنَ اثْنَیْنِ وَہُوَ غَضْبَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 23424","","","كتاب البيوع والأقضية"
"23425","(۲۳۴۲۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا دَاوُد بْنُ أَبِی ہِنْدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : مَا شَہِدْتُ عَلَی لَہَوَاتِ خَصْمٍ قطّ ، وَلاَ لَقَّنْتُہُ حُجَّتَہُ۔","","Musannaf Ibn Abi Shaybah 23425","","","كتاب البيوع والأقضية"
"23426","(۲۳۴۲۶) حَدَّثَنَا عَبِیْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرَۃَ ، عَنْ أَبِیہِ ، قَالَ : لاَ یَحْکُمُ الْحَکَمُ بَیْنَ اثْنَیْنِ وَہُوَ غَضْبَانُ۔ (بخاری ۷۱۵۸۔ مسلم ۱۳۴۲)","Sahih","Musannaf Ibn Abi Shaybah 23426","","","كتاب البيوع والأقضية"
"23427","(۲۳۴۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ زَیْنَبَ بِنْتِ أُمِّ سَلَمَۃَ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إنَّکُمْ تَخْتَصِمُونَ إلَیَّ ، وَإِنَّمَا أَنَا بَشَرٌ ، وَلَعَلَّ بَعْضَکُمْ أَنْ یَکُونَ أَلْحَنَ بِحُجَّتِہِ مِنْ بَعْضٍ ، وَإِنَّمَا أَقْضِی بَیْنَکُمْ عَلَی نَحْوٍ مِمَّا أَسْمَعُ مِنْکُمْ ، فَمَنْ قَضَیْتُ لَہُ مِنْ حَقِّ أَخِیہِ بِشَیْئٍ فَلاَ یَأْخُذْہُ ، فَإِنَّمَا أَقْطَعُ لَہُ قِطْعَۃً مِنَ النَّارِ یَأْتِی بِہَا یَوْمَ الْقِیَامَۃِ۔ (بخاری ۶۹۶۷۔ مسلم ۱۳۳۷)","Sahih","Musannaf Ibn Abi Shaybah 23427","","","كتاب البيوع والأقضية"
"23428","(۲۳۴۲۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ اللَّیْثِیُّ ، عَنْ عَبْدِ اللہِ بْنِ رَافِعٍ مَوْلَی أُمِّ سَلَمَۃَ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : جَائَ رَجُلاَنِ مِنَ الأَنْصَارِ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْتَصِمَانِ فِی مَوَارِیثَ بَیْنَہُمَا ، قَدْ دَرَسَتْ لَیْسَ بَینَہُمَا بَیِّنَۃٌ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّکُمْ تَخْتَصِمُونَ إلَیَّ ، وَإِنَّمَا أَنَا بَشَرٌ ، وَلَعَلَّ بَعْضَکُمْ أَنْ یَکُونَ أَلْحَنَ بِحُجَّتِہِ مِنْ بَعْضٍ ، وَإِنَّمَا أَقْضِی بَیْنَکُمْ عَلَی نَحْوٍ مِمَّا أَسْمَعُ مِنْکُمْ ، فَمَنْ قَضَیْتُ لَہُ مِنْ حَقِّ أَخِیہِ بِشَیْئٍ فَلاَ یَأْخُذْہُ ، فَإِنَّمَا أَقْطَعُ لَہُ بِہِ قِطْعَۃً مِنَ النَّارِ ، یَأْتِی بِہَا إسْطَامًا فِی عُنُقِہِ یَوْمَ الْقِیَامَۃِ ، قَالَتْ : فَبَکَی الرَّجُلاَنِ وَقَالَ کُلٌّ مِنْہُمَا : حَقِّی لأَخِی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمَّا إذْ فَعَلْتُمَا فَاذْہَبَا فَاقْتَسِمَا وَتَوَخَّیَا الْحَقَّ ، ثُمَّ اسْتَہِمَا ، ثُمَّ لْیَحْلِلْ کُلُّ وَاحِدٍ مِنْکُمَا صَاحِبَہُ۔n(ابوداؤد ۳۵۷۹۔ دارقطنی ۱۲۳)","Hasan","Musannaf Ibn Abi Shaybah 23428","","","كتاب البيوع والأقضية"
"23429","(۲۳۴۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ : حَدَّثَنَا أَبُو سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا أَنَا بَشَرٌ ، وَلَعَلَّ بَعْضَکُمْ أَنْ یَکُونَ أَلْحَنَ بِحُجَّتِہِ مِنْ بَعْضٍ ، فَمَنْ قَطَعْتُ لَہُ مِنْ حَقِّ أَخِیہِ فَإِنَّمَا أَقْطَعُ لَہُ قِطْعَۃً مِنَ النَّارِ۔ (احمد ۲/۳۳۲۔ ابن حبان ۵۰۷۱)","Hasan","Musannaf Ibn Abi Shaybah 23429","","","كتاب البيوع والأقضية"
"23430","(۲۳۴۳۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنْ إِبْرَاہِیمَ ، عَن شُرَیْحٍ : أنَّہُ کَانَ یَقُولُ لِلْخُصُومِ : سَیَعْلَمُ الظَّالِمُونَ حَقَّ مَنْ نَقَصُوا ، إنَّ الظَّالِمَ یَنْتَظِرُ الْعِقَابَ ، وَإِنَّ الْمَظْلُومَ یَنْتَظِرُ النَّصْرَ۔","","Musannaf Ibn Abi Shaybah 23430","","","كتاب البيوع والأقضية"
"23431","(۲۳۴۳۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَوْفٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ شُرَیْحٌ مِمَّا یَقُولُ لِلْخَصمِ : یَا عَبْدَ اللہِ ، وَاللَّہِ إنِّی لأَقْضِی لَکَ ، وَإِنِّی لأَظُنُّک ظَالِمًا ، وَلَکِنْ لَسْتُ أَقْضِی بِالظَّنِّ ، وَلَکِنْ أَقْضِی بِمَا أَحْضَرْتَنِی ، وَإِنَّ قَضَائِی لاَ یُحِلُّ لَکَ مَا حُرِّمَ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 23431","","","كتاب البيوع والأقضية"
"23432","(۲۳۴۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ عَبْدِ الأَعْلَی بْنِ عَامِرٍ الثَّعْلَبِیِّ ، عَنْ بِلاَلِ بْنِ أَبِی بُرْدَۃَ بْنِ أَبِی مُوسَی ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَأَلَ الْقَضَائَ وُکِلَ إلَی نَفْسِہِ ، وَمَنْ أُجْبِرَ عَلَیْہِ نَزَلَ عَلَیْہِ مَلَکٌ فَسَدَّدَہُ۔ (ترمذی ۱۳۲۳۔ ابوداؤد ۳۵۷۳)","Da'if","Musannaf Ibn Abi Shaybah 23432","","","كتاب البيوع والأقضية"
"23433","(۲۳۴۳۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنِ الْحَارِثِ الْبَصْریِّ ، قَالَ : کَانَتْ بَنُو إسْرَائِیلَ إذَا اسْتُقْضِیَ لِلرَّجُلِ مِنْہُمْ أُونِسَ لَہُ مِنَ النُّبُوَّۃِ۔","","Musannaf Ibn Abi Shaybah 23433","","","كتاب البيوع والأقضية"
"23434","(۲۳۴۳۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا بَعْضُ الْمَدَنِیِّینَ ، عَنِ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ وَلِیَ الْقَضَائَ فَکَأَنَّمَا ذُبِحَ بِغَیْرِ سِکِّینٍ۔","Da'if","Musannaf Ibn Abi Shaybah 23434","","","كتاب البيوع والأقضية"
"23435","(۲۳۴۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ شُرَیْحٍ ، قَالَ: إنَّمَا الْقَضَائُ جَمْرٌ ، فَادْفَعِ الْجَمْرَ عَنْک بِعُودَیْنِ یَعْنِی الشَّاہِدَیْنِ۔","","Musannaf Ibn Abi Shaybah 23435","","","كتاب البيوع والأقضية"
"23436","(۲۳۴۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ مَعْنِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : کَانَ شُرَیْحٌ یَقُولُ لِلشَّاہِدَیْنِ : إنِّی لَمْ أَدَعُکُمَا ، وَلاَ أَنَا مَانِعُکُمَا إِنْ قُمْتُمَا ، وَإِنَّمَا یَقْضِی أَنْتُمَا وَإِنِّی مُتَحَرِّزٌ بِکُمَا ، فَتَحَرَّزَا لأَنْفُسِکُمَا۔","","Musannaf Ibn Abi Shaybah 23436","","","كتاب البيوع والأقضية"
"23437","(۲۳۴۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فُرَاتُ بْنُ أَبِی بَحْرٍ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ - وَقَالَ لَہُ رَجُلٌ : اقْضِ بَیْنَنَا بِمَا أَرَاک اللَّہُ - قَالَ : إنِّی لَسْتُ بِرَأْیِی أَقْضِی۔","","Musannaf Ibn Abi Shaybah 23437","","","كتاب البيوع والأقضية"
"23438","(۲۳۴۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَبْدِ الرَّحْمَنِ ، قَالَ : لَمَّا أُمِرَ دَاوُد بِالْقَضَائِ قُطِعَ بِہِ ، فَأَوْحَی اللَّہُ إلَیْہِ : سَلْہُمُ الْبَیِّنَۃَ وَاسْتَحْلِفْہُمْ۔","","Musannaf Ibn Abi Shaybah 23438","","","كتاب البيوع والأقضية"
"23439","(۲۳۴۳۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ : کَتَبَ الْحَکَمُ بْنُ أَیُّوبَ فِی نَفَرٍ یَسْتَعْمِلُہُمْ عَلَی الْقَضَائِ ، فَقَالَ جَابِرُ بْنُ زَیْدٍ : لَوْ أَرْسَلَ إلَیَّ لَہَرَبْتُ۔","","Musannaf Ibn Abi Shaybah 23439","","","كتاب البيوع والأقضية"
"23440","(۲۳۴۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : لَمَّا تُوُفِّیَ عَبْدُ الرَّحْمَنِ بْنُ أُذَیْنَۃَ ذُکِرَ أَبُو قِلاَبَۃَ لِلْقَضَائِ فَہَرَبَ حَتَّی أَتَی الشَّامَ ، فَوَافَقَ ذَلِکَ عَزْلَ صَاحِبِہَا ، فَہَرَبَ حَتَّی أَتَی الْیَمَامَۃَ فَلَقِیتُہُ بَعْدَ ذَلِکَ فَقَالَ : مَا وَجَدْتُ مَثَلَ الْقَاضِی إلاَّ کَمَثَلِ رَجُلٍ سَابِحٍ فِی بَحْرٍ ، وَکَمْ عَسَی أنْ یَسْبَحَ حَتَّی یَغْرَقَ۔","","Musannaf Ibn Abi Shaybah 23440","","","كتاب البيوع والأقضية"
"23441","(۲۳۴۴۱) حَدَّثَنَا مُعَلَّی بْنُ مَنْصُورٍ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، عَنْ عُثْمَانَ بْنِ مُحَمَّدٍ ، عَنِ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ جُعِلَ قَاضِیًا بَیْنَ النَّاسِ ، فَقَدْ ذُبِحَ بِغَیْرِ سِکِّینٍ۔n(ترمذی ۵۹۲۵۔ ابوداؤد ۳۵۶۶)","Hasan","Musannaf Ibn Abi Shaybah 23441","","","كتاب البيوع والأقضية"
"23442","(۲۳۴۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عَوْنٍ ، عَنِ الْحَارِثِ بْنِ عَمْرٍو الثَّقَفِیِّ ، عَنْ رِجَالٍ مِنْ أَہْلِ حِمْصٍ مِنْ أَصْحَابِ مُعَاذٍ ، عَنْ مُعَاذٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا بَعَثَہُ قَالَ لَہُ : کَیْفَ تَقْضِی ؟ قَالَ : أَقْضِی بِمَا فِی کِتَابِ اللہِ ، قَالَ : فَإِنْ جَائَک أَمْرٌ لَیْسَ فِی کِتَابِ اللہِ ، قَالَ : أَقْضِی بِسُنَّۃِ رَسُولِ اللہِ ، قَالَ : فَإِنْ لَمْ تَکُنْ سُنَّۃٌ مِنْ رَسُولِ اللہِ ؟ قَالَ : أَجْتَہِدُ رَأْیِی ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی وَفَّقَ رَسُولَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ترمذی ۱۳۲۷۔ احمد ۵/۲۳۶)","Da'if","Musannaf Ibn Abi Shaybah 23442","","","كتاب البيوع والأقضية"
"23443","(۲۳۴۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ ، قَالَ : لَمَّا بَعَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُعَاذًا إلَی الْیَمَنِ ، قَالَ : یَا مُعَاذُ بِمَ تَقْضِی ؟ قَالَ : أَقْضِی بِکِتَابِ اللہِ ، قَالَ : فَإِنْ جَائَ ک أَمْرٌ لَیْسَ فِی کِتَابِ اللہِ ؟ قَالَ أقضی بما قضی بہ نبیہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : فَإِنْ جَائَ ک أَمْرٌ لَیْسَ فِی کِتَابِ اللہِ وَلَمْ یَقْضِ فِیہِ نَبِیُّہُ وَلَمْ یَقْضِ فِیہِ الصَّالِحُونَ ؟ قَالَ : أَؤُمُّ الْحَقَّ جَہْدِی ، قَالَ : فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَمْدُ لِلَّہِ الَّذِی جَعَلَ رَسُولَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْضِی بِمَا یَرْضَی بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 23443","","","كتاب البيوع والأقضية"
"23444","(۲۳۴۴۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : أَنَّ عُمَرَ بْنَ الْخَطَّابِ رضی اللَّہُ عَنْہُ کَتَبَ إلَیْہِ : إذَا جَائَ کَ شَیْئٌ فِی کِتَابِ اللہِ فَاقْضِ بِہِ ، وَلاَ یَلْفِتَنَّکَ عَنْہُ الرِّجَالُ ، فَإِنْ جَائَ کَ أَمْرٌ لَیْسَ فِی کِتَابِ اللہِ فَانْظُرْ سُنَّۃَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَاقْضِ بِہَا ، فَإِنْ جَائَ کَ مَا لَیْسَ فِی کِتَابِ اللہِ وَلَیْسَ فِیہِ سُنَّۃٌ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَانْظُرْ مَا اجْتَمَعَ النَّاسُ عَلَیْہِ فَخُذْ بِہِ ، فَإِنْ جَائَ کَ مَا لَیْسَ فِی کِتَابِ اللہِ ، وَلَمْ یَکُنْ فِیہِ سُنَّۃٌ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلَمْ یَتَکَلَّمْ فِیہِ أَحَدٌ قَبْلَکَ ، فَاخْتَرْ أَیَّ الأَمْرَیْنِ شِئْتَ : إِنْ شِئْتَ أَنْ تَجْتَہِدَ بِرَأْیِکَ وَتُقَدَّمَ فَتَقَدَّمْ ، وَإِنْ شِئْتَ أَنْ تَتَأَخَّرَ فَتَأَخَّرْ ، وَلاَ أَرَی التَّأَخُّرَ إلاَّ خَیْرًا لَک۔ (نسائی ۵۳۹۹)","Sahih","Musannaf Ibn Abi Shaybah 23444","","","كتاب البيوع والأقضية"
"23445","(۲۳۴۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : أَکْثَرُوا عَلَی عَبْدِ اللہِ ذَاتَ یَوْمٍ فَقَالَ : یَا أَیُّہَا النَّاسُ ، قَدْ أَتَی عَلَیْنَا زَمَانٌ لَسْنَا نَقْضِی ، وَلَسْنَا ہُنَاکَ ، ثُمَّ إنَّ اللَّہَ قَدَّرَأَنْ بَلَغَنَا مِنَ الأَمْرِ مَا تَرَوْنَ ، فَمَنْ عَرَضَ لَہُ مِنْکُمْ قَضَائٌ بَعْدَ الْیَوْمِ فَلِیَقْضِ بِمَا فِی کِتَابِ اللہِ ، فَإِنْ جَائَ ہُ أَمْرٌ لَیْسَ فِی کِتَابِ اللہِ فَلْیَقْضِ بِمَا قَضَی بِہِ نَبِیُّہُ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَإِنْ جَائَ ہُ أَمْرٌ لَیْسَ فِی کِتَابِ اللہِ ، وَلَمْ یَقْضِ بِہِ نَبِیُّہُ ، فَلْیَقْضِ بِمَا قَضَی بِہِ الصَّالِحُونَ ، فَإِنْ أَتَاہُ أَمْرٌ لَیْسَ فِی کِتَابِ اللہِ ، وَلاَ قَضَی بِہِ نَبِیُّہُ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ قَضَی بِہِ الصَّالِحُونَ ، فَلْیَجْتَہِدْ بِرَأْیِہِ ، وَلاَ یَقُولُ : إنِّی أَخَافُ وَإِنِّی أَخَافُ ، فَإِنَّ الْحَلاَلَ بَیِّنٌ وَالْحَرَامَ بَیِّنٌ ، وَبَیْنَ ذَلِکَ أُمُورٌ مُشْتَبِہَاتٌ ، فَدَعْ مَا یَرِبْیُکَ إلَی مَا لاَ یَرِبْیُکَ۔","Sahih","Musannaf Ibn Abi Shaybah 23445","","","كتاب البيوع والأقضية"
"23446","(۲۳۴۴۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ، مِثْلَ حَدِیثِ أَبِی مُعَاوِیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 23446","","","كتاب البيوع والأقضية"
"23447","(۲۳۴۴۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ ، نَحْوَہُ إلأَأَنَّہُ زَادَ فِیہِ : فَإِنْ أَتَاہُ أَمْرٌ لاَ یَعْرِفُہُ فَلْیُقِرَّ ، وَلاَ یَسْتَحْیِ۔","Sahih","Musannaf Ibn Abi Shaybah 23447","","","كتاب البيوع والأقضية"
"23448","(۲۳۴۴۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ إذَا سُئِلَ عَنِ الأَمْرِ ، وَکَانَ فِی الْقُرْآنِ أَخْبَرَ بِہِ ، وَإِنْ لَمْ یَکُنْ فِی الْقُرْآنِ ، فَکَانَ عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخْبَرَ بِہِ ، فَإِنْ لَمْ یَکُنْ فَعَنْ أَبِی بَکْرٍ وَعُمَرَ رضی اللَّہُ عَنْہُما ، فَإِنْ لَمْ یَکُنْ قَالَ فِیہِ بِرَأْیِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 23448","","","كتاب البيوع والأقضية"
"23449","(۲۳۴۴۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا سَیْفُ بْنُ سُلَیْمَانَ الْمَکِّیُّ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنِ ابْنِ عَبَّاسٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِشہادۃ شَاہِدٍ وَیَمِینٍ۔n(مسلم ۳۔ ابوداؤد ۳۶۰۳)","Sahih","Musannaf Ibn Abi Shaybah 23449","","","كتاب البيوع والأقضية"
"23450","(۲۳۴۵۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا جُوَیْرِیَۃُ بْنُ أَسْمَائَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ رَجُلٍ ، عَنْ سُرَّق: أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِشَہَادَۃِ شَاہِدٍ مَعَ یَمِینٍ۔ (ترمذی ۱۳۴۵۔ ابن ماجہ ۲۳۷۱)","Da'if","Musannaf Ibn Abi Shaybah 23450","","","كتاب البيوع والأقضية"
"23451","(۲۳۴۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِیہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِشَہَادَۃِ شَاہِدٍ وَیَمِینٍ ، قَالَ : وَقَضَی بِہَا عَلِیٌّ رضی اللَّہُ عَنْہُ بَیْنَ أَظْہُرِکُمْ۔","","Musannaf Ibn Abi Shaybah 23451","","","كتاب البيوع والأقضية"
"23452","(۲۳۴۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ خَالِدِ بْنِ أَبِی کَرِیمَۃَ ، عَنْ أَبِی جَعْفَرٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِشَہَادَۃِ شَاہِدٍ وَیَمِینٍ فِی الْحُقُوقِ۔","Da'if","Musannaf Ibn Abi Shaybah 23452","","","كتاب البيوع والأقضية"
"23453","(۲۳۴۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَوَّارِ بْنِ عَبْدِ اللہِ ، قَالَ : قُلْتُ لِرَبِیعَۃَ : قَوْلُکُمْ فِی شَہَادَۃِ شَاہِدٍ وَیَمِینِ صَاحِبِ الْحَقِّ ؟ قَالَ : وُجِدَ فِی کِتَابِ سَعْدٍ۔","","Musannaf Ibn Abi Shaybah 23453","","","كتاب البيوع والأقضية"
"23454","(۲۳۴۵۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ أَبِی الزِّنَادِ : أَنَّ عَبْدَ الْحَمِیدِ کَانَ یَقْضِی بِالْیَمِینِ بِالْکُوفَۃِ مَعَ الشَّاہِدِ ، قَالَ : فَأَنْکَرَ عَلَیْہِ نَاسٌ مِنْ أَہْلِ الْکُوفَۃِ ، فَکَتَبَ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فَکَتَبَ إلَیْہِ : أَنْ یَقْضِیَ بِالْیَمِینِ مَعَ الشَّاہِدِ ، فَقَالَ شَیْخٌ مِنْ مَشِیْخَتِہِمْ ، أَوْ قَالَ : مِنْ کُبَرَائِہِمْ : شَہِدْتُ شُرَیْحًا یَقْضِی بِالْیَمِینِ مَعَ الشَّاہِدِ۔","","Musannaf Ibn Abi Shaybah 23454","","","كتاب البيوع والأقضية"
"23455","(۲۳۴۵۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ حَصِینٍ ، قَالَ : قَضَی عَلَیَّ عَبْدُ اللہِ بْنُ عُتْبَۃَ بِشَہَادَۃِ شَاہِدٍ مَعَ یَمِینِ صَاحِبِ الْحَقِّ۔","","Musannaf Ibn Abi Shaybah 23455","","","كتاب البيوع والأقضية"
"23456","(۲۳۴۵۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ عَبْدِ الْحَمِیدِ الْعَتَکِیِّ : أَنَّ یَحْیَی بْنَ یَعْمُرَ کَانَ یَقْضِی بِشَہَادَۃِ شَاہِدٍ وَیَمِینٍ۔","","Musannaf Ibn Abi Shaybah 23456","","","كتاب البيوع والأقضية"
"23457","(۲۳۴۵۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ وَسُئِلَ عَنْ قَاضٍ قَضَی بِجَوْرٍ ، فَقَالَ الشَّعْبِیُّ : أَمَّا الْجَوْرُ فَلاَ أَقُولُ فِیہِ ، یَقُولُ : إِنَّہُ لاَ یَنْبَغِی لَہُ أَنْ یَجُورَ ، وَلَکنْ أَیُّمَا قَاضٍ قَضَی ، فَجَائَ قَاضٍ مِنْ بَعْدِہِ ، فَلاَ یَنْبَغِی لَہُ أَنْ یَنْظُرَ فِی قَضَائِہِ ، وَیُوَلِّیہِ مِنْ ذَلِکَ مَا کَانَ تَوَلَّی۔","","Musannaf Ibn Abi Shaybah 23457","","","كتاب البيوع والأقضية"
"23458","(۲۳۴۵۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ ، قَالَ : لاَ یُبَاعُ حُرٌّ فِی إفْلاَسٍ ، قَالَ : وَکَتَبَ بِذَلِکَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ رحمہ اللہ تعالی۔","","Musannaf Ibn Abi Shaybah 23458","","","كتاب البيوع والأقضية"
"23459","(۲۳۴۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أبی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، وَأَبِی ہَاشِمٍ : فِی رَجُلٍ ادَّعَی قِبَلَ رَجُلٍ مَالاً، فَقَالَ : أَعْطِنِی کَفِیلاً حَتَّی آتِیَ بِبَیِّنَتِی ، قَالَ : لَیْسَ لَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23459","","","كتاب البيوع والأقضية"
"23460","(۲۳۴۶۰) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ عُقْبَۃَ بْنِ أَبِی الْعَیْزَارِ ، قَالَ : أَتَیْتُ الشَّعْبِیَّ بِرَجُلٍ لِی عَلَیْہِ حَقٌّ لَمْ یَکُنْ لِی عَلَیْہِ بَیِّنَۃٌ ، فَقُلْت : خُذْ لِی مِنْہُ کَفِیلاً ، فَأَبَی أَنْ یَأْخُذَ لِی مِنْہُ کَفِیلاً۔","","Musannaf Ibn Abi Shaybah 23460","","","كتاب البيوع والأقضية"
"23461","(۲۳۴۶۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی الْفَیْضِ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ یَسَارٍ ، قَالَ : سَمِعْتُ أَبَا الدَّرْدَائِ سَاوَمَ رَجُلاً ، فَحَلَفَ الرَّجُل أَنْ لاَ یَبِیعَہُ ، ثُمَّ أَعْطَاہُ بَعْدَ ذَلِکَ بِذَلِکَ الثمنِ ، فَقَالَ أَبُو الدَّرْدَائِ : إنِّی أَخْشَی أَوْ أَکْرَہُ أَنْ أَحْمِلَک عَلَی إِثْمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 23461","","","كتاب البيوع والأقضية"
"23462","(۲۳۴۶۲) حَدَّثَنَا وکیع ، عن یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ أَبِیہِ ، عَنْ سَعِیدِ بْنِ وَہْبٍ ، عَنْ مُعَاذٍ : أَنَّہُ سَاوَمَ رَجُلاً بِبَیْعٍ فَحَلَفَ أَنْ لاَ یَبِیعَہُ ، ثُمَّ دَعَاہُ أَنْ یَبِیعَہُ ، فَکَرِہَ أَنْ یَشْتَرِیَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 23462","","","كتاب البيوع والأقضية"
"23463","(۲۳۴۶۳) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ : أَنَّ مُعَاذًا سَاوَمَ رَجُلاً بِشَیْئٍ فَحَلَفَ أَنْ لاَ یَبِیعَہُ فَذَکَرَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 23463","","","كتاب البيوع والأقضية"
"23464","(۲۳۴۶۴) حَدَّثَنَا ابن علیۃ ، عن ابن عون ، عن محمد قَالَ : قلت لہ : الرجل یحلف علی الشیء أن لاَ یبیعہ ، ثم یبیعہ أشتریہ منہ ؟ قَالَ : نَعَمْ ، وأذکِرْہ یمینہ۔","","Musannaf Ibn Abi Shaybah 23464","","","كتاب البيوع والأقضية"
"23465","(۲۳۴۶۵) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، بِنَحْوٍ مِنْہُ ، قَالَ : ہَذَا أحْرَزُ لِیَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 23465","","","كتاب البيوع والأقضية"
"23466","(۲۳۴۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُرَّۃَ بْنِ شَرَاحِیلَ ، قَالَ إنَّ صُہَیْبًا بَاعَ دَارَہُ مِنْ عُثْمَانَ ، وَاشْتَرَطَ سُکْنَاہَا کَذَا وَکَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 23466","","","كتاب البيوع والأقضية"
"23467","(۲۳۴۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ قَیْسٍ الأَسَدِیُّ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ : أَنَّ تَمِیمًا الدَّارِیَّ بَاعَ دَارِہِ وَشَتَرَطَ سُکْنَاہَا حَیَاتَہُ ، وَقَالَ : إنَّمَا مَثَلِی مَثَلُ أُمِّ مُوسَی رُدَّ عَلَیْہَا ابْنُہَا وَأُعْطِیَتْ أَجْرَ رَضَاعِہَا۔","","Musannaf Ibn Abi Shaybah 23467","","","كتاب البيوع والأقضية"
"23468","(۲۳۴۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : أَنَّ امْرَأَتَیْنِ بَاعَتَا دَارَیْنِ لَہُمَا وَاشْتَرَطَتَا سُکْنَاہُمَا حَیَاتَہُمَا۔ فَقَالَ : عَامِرٌ : تَسْکُنَانِ حَتَّی تَمُوتَا۔","","Musannaf Ibn Abi Shaybah 23468","","","كتاب البيوع والأقضية"
"23469","(۲۳۴۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : کان ابن أبی لیلی یجیزہ عندنا ، وأما غیرہ ، فکان یردہ۔","","Musannaf Ibn Abi Shaybah 23469","","","كتاب البيوع والأقضية"
"23470","(۲۳۴۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ شَبِیبِ بْنِ غَرْقَدَۃَ الْبَارِقِیِّ ، قَالَ : سَمِعْتُ شُرَیْحًا یَقُولُ : لِکُلِّ مُسْلِمٍ شَرْطُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23470","","","كتاب البيوع والأقضية"
"23471","(۲۳۴۷۱) حَدَّثَنَا وَکِیعٌ وَیَحْیَی بْنُ آدَمَ ، قَالاَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، قَالَ : وَقَعَ حَائِطٌ لِرَجُلٍ بَیْنَہُ وَبَیْنَ جَارِہِ ، فَخَاصَمَہُ جَارُہُ إلَی شُرَیْحٍ ، فَلَمْ یُجْبرہُ عَلَی بِنَائِہِ ، وَقَالَ لِجَارِہِ : اذْہَبْ فَاسْتُرْ عَلَی نَفْسِک۔","","Musannaf Ibn Abi Shaybah 23471","","","كتاب البيوع والأقضية"
"23472","(۲۳۴۷۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ شَقِیقٍ، عَنْ أَبِی مَسْ??ُودٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: حُوسِبَ رَجُلٌ مِمَّنْ کَانَ قَبْلَکُمْ ، فَلَمْ یُوجَدْ لَہُ مِنَ الْخَیْرِ شَیْئٌ ، إلاَّأَنَّہُ کَانَ رَجُلاً مُوسِرًا یُخَالِطُ النَّاسَ، فَیَقُولُ لِغِلْمَانِہِ : تَجَاوَزُوا عَنِ الْمُعْسِرِ ، فَقَالَ اللَّہُ تَعَالی لِمَلاَئِکَتِہِ : نَحْنُ أَحَقُّ بِذَلِکَ مِنْہُ تَجَاوَزُوا عَنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 23472","","","كتاب البيوع والأقضية"
"23473","(۲۳۴۷۳) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخَطْمِیِّ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ نَفَّسَ عَنْ غَرِیمِہِ ، أَوْ مَحَا عَنْہُ کَانَ فِی ظِلِّ الْعَرْشِ یَوْمَ الْقِیَامَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 23473","","","كتاب البيوع والأقضية"
"23474","(۲۳۴۷۴) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ زُہَیْرِ بْنِ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ عَبْدِ اللہِ بْنِ سَہْلِ بْنِ حُنَیْفٍ : أَنَّ سَہْلَ بْن حُنَیْفٍ حَدَّثَہُ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَعَانَ مُجَاہِدًا فِی سَبِیلِ اللہِ ، أَوْ غَارِمًا فِی عُسْرَتِہِ ، أَوْ مُکَاتَبًا فِی رَقَبَتِہِ ، أَظَلَّہُ اللَّہُ فِی ظِلِّہِ یَوْمَ لاَ ظِلَّ إلاَّ ظِلُّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 23474","","","كتاب البيوع والأقضية"
"23475","(۲۳۴۷۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ رِبْعِیٍّ ، قَالَ : قَالَ عُقْبَۃُ بْنُ عَمْرٍو لِحُذَیْفَۃَ : حَدِّثْنِی بِشَیْئٍ سَمِعْتَہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : کَانَ فِیمَنْ کَانَ قَبْلَکُمْ رَجُلٌ أَتَاہُ الْمَلَکُ لِیَقْبِضَ رُوحَہُ فَقَالَ : ہَلْ عَمِلْتَ خَیْرًا ؟ قَالَ: مَا أَعْلَمُہُ ، قَالَ : اُنْظُرْ ، قَالَ : مَا أَعْلَمُہُ إلاَّ أَنِّی کُنْتُ رَجُلاً أُحَارِفُ النَّاسَ فِی ألدُّنْیَا وَأُخَالِطُہُمْ ، فَکُنْتُ أُنْظِرُ الْمُعْسِرَ ، وَأَتَجَاوَزُ عَنِ الْمُوسِرِ ، فَأَدْخَلَہُ اللَّہُ الْجَنَّۃَ ، قَالَ عُقْبَۃُ : وَأَنَا سْمِعْتہُ یَقُولُ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 23475","","","كتاب البيوع والأقضية"
"23476","(۲۳۴۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الشُّعَیْثِی ، عَنْ مَکْحُولٍ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خُذْ حَقَّک فِی عَفَافٍ وَافیاً ، أَوْ غَیْرِ وَافٍ۔ (ابن ماجہ ۲۴۲۲)","","Musannaf Ibn Abi Shaybah 23476","","","كتاب البيوع والأقضية"
"23477","(۲۳۴۷۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ رِبْعِیٍّ ، عَنْ أَبِی الْیَسَرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَنْظَرَ مُعْسِرًا ، أَوْ وَضَعَ لَہُ ، أَظَلَّہُ اللَّہُ فِی ظِلِّ عَرْشِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 23477","","","كتاب البيوع والأقضية"
"23478","(۲۳۴۷۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عُمَارَۃَ بْنِ عُمَیْرٍ ، قَالَ : شَہِدَ رَجُلاَنِ عِنْدَ شُرَیْحٍ لِرَجُلٍ عَلَی شَیْئٍ ، قَالَ الأَعْمَشُ : أَرَاہُ قَالَ : عَلَی بَغْلٍ فَقَالَ : نَشْہَدُ أَنَّ ہَذَا اشْتَرَاہُ مِنْ ہَذَا ، قَالَ أَحَدُ الشَّاہِدَیْنِ: وَأَشْہَدُ أَنَّہُ فَاجِرٌ ، فَقَالَ شُرَیْحٌ : وَمَا یُدْرِیک أَنَّہُ فَاجِرٌ ؟ قُمْ لاَ شَہَادَۃَ لَک۔","","Musannaf Ibn Abi Shaybah 23478","","","كتاب البيوع والأقضية"
"23479","(۲۳۴۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنِ الْجَعْدِ بْنِ ذَکْوَانَ ، قَالَ : تَقَدَّمَ رَجُلٌ إلَی شُرَیْحٍ ، قَالَ : فَدَعَا بِشَاہِدٍ لَہُ فَقَالَ : أَیْنَ رَبِیعَۃُ الْکُوَیْفِرُ ، فَجَائَ ہُ ، فَقَالَ شُرَیْحٌ : أَقْرَرْتَ بِکُوَیْفِر ، فَرَدَّ شَہَادَتَہُ۔","","Musannaf Ibn Abi Shaybah 23479","","","كتاب البيوع والأقضية"
"23480","(۲۳۴۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ : لَوْ شَہِدَ رَجُلاَنِ عَلَی رَجُلٍ أَنَّہُ طَلَّقَ امْرَأَتَہُ ، ثُمَّ رَجَعَا عَنْ شَہَادَتِہِمَا قَالَ : الطَّلاَقُ بَاقٍ إِنْ لَمْ یَکُنْ دَخَلَ بِہَا ، رَجَعَ الزَّوْجُ عَلَیْہِمَا بِنِصْفِ الصَّدَاقِ ، وَإِنْ کَانَ قَدْ دَخَلَ بِہَا فَلاَ شَیْئَ عَلَیْہِمَا۔ یَعْنِی : مِنَ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 23480","","","كتاب البيوع والأقضية"
"23481","(۲۳۴۸۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عُثْمَانَ الْبَتِّیِّ ، عَنْ بَعْضِ أَصْحَابِ إبْرَاہِیمَ ، عَنْ إبْرَہِیمٍ : فِی رَجُلٍ أَذِنَ لِعَبْدِہِ فَلَحقہُ دَیْنٌ ، وَمَاتَ الْمَوْلَی وَعَلَیْہِ دَیْنٌ ، قَالَ : یُبْدَأُ بِدَیْنِ الْمَوْلَی قَبْلَ دَیْنِ الْعَبْدِ۔n قَالَ الْبَتِّیُّ : لاَ یُعْجِبُنِی ذَلِکَ ، یُبْدَأُ بِدَیْنِ الْعَبْدِ قَبْلَ دَیْنِ الْمَوْلَی ، لأَنَّہُ أَطْلَقَ رَقَبَتَہُ۔","","Musannaf Ibn Abi Shaybah 23481","","","كتاب البيوع والأقضية"
"23482","(۲۳۴۸۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : آتِی حَرِیفِی فَأَشْتَرِی مِنْہُ الْمَتَاعَ وَأَزِیدُہُ فِی ثَمَنِہِ ، وَلَوْ شِئْتَ أَخَذْتَہُ مِنْہُ بِدُونِ ذَلِکَ ، أَبِیعُہُ مِنْہُ مُشَافَّۃً ؟ قَالَ : لاَ ۔ یَعْنِی : مُرَابَحَۃً۔","","Musannaf Ibn Abi Shaybah 23482","","","كتاب البيوع والأقضية"
"23483","(۲۳۴۸۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِیہِ ، عَنِ الشَّعْبِیِّ ، قَالَ : قبْض النخل : أَنْ یَنْظُرَ إلَیْہِ ویقلِّبہ۔","","Musannaf Ibn Abi Shaybah 23483","","","كتاب البيوع والأقضية"
"23484","(۲۳۴۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ : فِی رَجُلٍ ، قَالَ لِرَجُلٍ : إِنْ لَمْ آتِکَ بِحَقِّکَ إلَی کَذَا وَکَذَا فَدَارِی لَکَ ، فَقَالَ شُرَیْحٌ : إِنْ أَخْطَتْ یَدُہُ رِجْلَہُ غَرِمَ۔","","Musannaf Ibn Abi Shaybah 23484","","","كتاب البيوع والأقضية"
"23485","(۲۳۴۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : جَائَ رَجُلٌ إلَی شُرَیْحٍ فَقَالَ : إنِّی اسْتَوْدَعْتُ ہَذَا وَإِنَّہَا ذَہَبَتْ وَہُوَ یَنْظُرُ ، فَقَالَ شُرَیْحٌ : شُہُودُکَ أَنَّہَا ذَہَبَتْ وَہُوَ یَنْظُرُ۔","","Musannaf Ibn Abi Shaybah 23485","","","كتاب البيوع والأقضية"
"23486","(۲۳۴۸۶) حَدَّثَنَا علی ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الْقَرْیَۃِ یَتَقَبَّلُہَا وَفِیہَا الْعُلُوجُ وَالْبُیُوتُ وَالنَّخْلُ وَالشَّجَرُ ؟ فَکَرِہَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23486","","","كتاب البيوع والأقضية"
"23487","(۲۳۴۸۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلَہُ رَجُلٌ وَأَنَا أَسْمَعُ : أَیَتَقَبَّلُ الرَّجُلُ الأَرْضَ فِیہَا الْعُلُوجُ وَالثِّمَارُ وَالْبُیُوتُ ؟ فَقَالَ : لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23487","","","كتاب البيوع والأقضية"
"23488","(۲۳۴۸۸) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ: أَنَّہُ کَرِہَ قَبَالَۃَ الرُّؤُوسِ ، وَلَمْ یَرَ بِالْقُرَی بَأْسًا۔","","Musannaf Ibn Abi Shaybah 23488","","","كتاب البيوع والأقضية"
"23489","(۲۳۴۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمُثَنَّی بْنُ سَعِیدٍ الضُّبَعِیُّ ، عَنْ قَتَادَۃَ ، عَنْ بُشَیْرِ بْنِ کَعْبٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اجْعَلُوا الطَّرِیقَ سَبْعَۃَ أَذْرُعٍ۔n(بخاری ۲۴۷۳۔ مسلم ۱۴۳)","Sahih","Musannaf Ibn Abi Shaybah 23489","","","كتاب البيوع والأقضية"
"23490","(۲۳۴۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا اخْتَلَفْتُمْ فِی الطَّرِیقِ فَاجْعَلُوہُ سَبْعَۃ أَذْرُعٍ۔(ابن ماجہ ۲۳۳۹۔ احمد ۱/۲۳۵)","","Musannaf Ibn Abi Shaybah 23490","","","كتاب البيوع والأقضية"
"23491","(۲۳۴۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : مَنْصُورُ بْنُ دِینَارٍ ، عَنْ أَبِی عِکْرِمَۃَ الْمَخْزُومِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَمْنَعْ أَحَدُکُمْ جَارَہُ أَنْ یَضَعَ خَشَبَۃً عَلَی جِدَارِہِ۔ (احمد ۲/۴۴۷)","Da'if","Musannaf Ibn Abi Shaybah 23491","","","كتاب البيوع والأقضية"
"23492","(۲۳۴۹۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَمْنَعْ أَحَدُکُمْ جَارَہُ أَنْ یَضَعَ خَشَبَۃً عَلَی جِدَارِہِ۔n قَالَ : وَقَالَ أَبُو ہُرَیْرَۃَ : مَا لِی أَرَاکُمْ عنہا مُعْرِضِینَ ، وَاللَّہِ لأَرْمِیَنَّ بِہَا بَیْنَ أَکْتَافِکُمْ۔n(بخاری ۲۴۶۳۔ مسلم ۱۳۶)","Sahih","Musannaf Ibn Abi Shaybah 23492","","","كتاب البيوع والأقضية"
"23493","(۲۳۴۹۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَنَی بِنَائً فَلْیُدَعِّمْہُ بِحَائِطِ جَارِہِ۔ (احمد ۲۳۵۔ طبرانی ۱۱۸۰۶)","","Musannaf Ibn Abi Shaybah 23493","","","كتاب البيوع والأقضية"
"23494","(۲۳۴۹۴) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ، عَنْ وَائِلِ بْنِ رَبِیعَۃَ، قَالَ: قَالَ ابْنُ مَسْعُودٍ: عُدِلَتْ شَہَادَۃُ الزُّورِ بِالشِّرْکِ بِاللَّہِ، ثُمَّ قَرَأَ: {فَاجْتَنِبُوا الرِّجْسَ مِنَ الأَوْثَانِ وَاجْتَنِبُوا قَوْلَ الزُّورِ}۔","Hasan","Musannaf Ibn Abi Shaybah 23494","","","كتاب البيوع والأقضية"
"23495","(۲۳۴۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ سُفْیَانَ الْعُصْفُرِیِّ ، عَنْ أَبِیہِ ، عَنْ حَبِیبِ بْنِ النُّعْمَانِ الأَسَدِیِّ ، عَنْ خُرَیْمِ بْنِ فَاتِکٍ ، قَالَ : صَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الصُّبْحَ ، فَلَمَّا انْصَرَفَ قَامَ قَائِمًا فَقَالَ : عَدَلَتْ شَہَادَۃُ الزُّورِ بِالشِّرْکِ بِاَللَّہِ ثَلاَثَ مَرَّاتٍ ، ثُمَّ تَلاَ ہَذِہِ الآیَۃَ : {وَاجْتَنِبُوا قَوْلَ الزُّورِ حُنَفَائَ لِلَّہِ غَیْرَ مُشْرِکِینَ بِہِ}۔ (ترمذی ۲۲۹۹۔ ابوداؤد ۳۵۹۴)","Da'if","Musannaf Ibn Abi Shaybah 23495","","","كتاب البيوع والأقضية"
"23496","(۲۳۴۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ بْنِ مُحَمَّدِ بْنِ أَبِی بَکْرٍ ، عَنْ أَبِیہِ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : أَلاَ لاَ یُؤْسَرَنَّ أَحَدٌ فِی الإِسْلاَمِ بِشَہَادَۃِ الزُّورِ فَإِنَّا لاَ نَقْبَلُ إلاَّ الْعُدُولَ۔n(مالک ۷۲۰)","","Musannaf Ibn Abi Shaybah 23496","","","كتاب البيوع والأقضية"
"23497","(۲۳۴۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ ابنِ عُمَرَ ، عَنِ ابْنِ الْحَنَفِیَّۃِ : {وَلاَ تَقْفُ مَا لَیْسَ لَکَ بِہِ عِلْمٌ} قَالَ: شَہَادَۃُ الزُّورِ۔","","Musannaf Ibn Abi Shaybah 23497","","","كتاب البيوع والأقضية"
"23498","(۲۳۴۹۸) حَدَّثَنَا أَبُو بَکْرٍ وَشَرِیکٌ ، عَنْ عَاصِمٍ ، عَنْ وَائِلِ بْنِ رَبِیعَۃَ ، قَالَ : عَدَلَتْ شَہَادَۃُ الزُّورِ بِالشِّرْکِ بِاللَّہِ ، وَتَلاَ أَحَدُہُمَا : {وَالَّذِینَ لاَ یَشْہَدُونَ الزُّورَ} وَتَلاَ الآخَرF : {وَاجْتَنِبُوا قَوْلَ الزُّورِ}۔","No Data Available","Musannaf Ibn Abi Shaybah 23498","","","كتاب البيوع والأقضية"
"23499","(۲۳۴۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ، قَالَ : شَہِدْتُ عُمَرَ بْنَ الْخَطَّابِ أَقَامَ شَاہِدَ زُورٍ عَشِیَّۃً فِی إزَارٍ یُنَکِّتُ نَفْسَہُ۔ (عبدالرزاق ۱۵۳۸۸)","Da'if","Musannaf Ibn Abi Shaybah 23499","","","كتاب البيوع والأقضية"
"23500","(۲۳۵۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِیْنٍ ، قَالَ : کَانَ شُرَیْحٌ یَبْعَثُ بِشَاہِدِ الزُّورِ إلَی مَسْجِدِ قَوْمِہِ ، أَوْ إلَی سُوقِہِ : إنَّا قَدْ زَیَّفْنَا شَہَادَۃَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 23500","","","كتاب البيوع والأقضية"
"23501","(۲۳۵۰۱) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا الْمَسْعُودِیُّ ، عَنْ أَبِی حَصِینٍ ، قَالَ : جَلَسَ إلَیَّ الْقَاسِمُ فَقَالَ : أَیَّ شَیْئٍ کَانَ یَصْنَعُ شُرَیْحٌ بِشَاہِدِ الزُّورِ إذَا أَخَذَہُ ؟ قَالَ : قُلْتُ : کَانَ یَکْتُبُ اسْمَہُ عِنْدَہُ ، فَإِنْ کَانَ مِنَ الْعَرَبِ بَعَثَ بِہِ إلَی مَسْجِدِ قَوْمِہِ ، وَإِنْ کَانَ مِنَ الْمَوَالِی بَعَثَ بِہِ إلَی سُوقِہِ ، یُعْلِمُہُمْ ذَلِکَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 23501","","","كتاب البيوع والأقضية"
"23502","(۲۳۵۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الْجَعْدِ بْنِ ذَکْوَانَ ، قَالَ : شَہِدْتُ شُرَیْحًا ضَرَبَ شَاہِدَ الزُّورِ خَفَقَاتٍ ، وَنَزَعَ عِمَامَتَہُ عَنْ رَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 23502","","","كتاب البيوع والأقضية"
"23503","(۲۳۵۰۳) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْکَرِیمِ الْجَزَرِیِّ ، قَالَ : شَہِدَ قَوْمٌ عِنْدَ عمَرَ بْنِ عَبْدِ الْعَزِیزِ عَلَی ہِلاَلِ رَمَضَانَ ، فَاتَّہَمَہُمْ فَضَرَبَہُمْ سَبْعِینَ سَبْعِینَ ، وَأَبْطَلَ شَہَادَتَہُمْ۔","","Musannaf Ibn Abi Shaybah 23503","","","كتاب البيوع والأقضية"
"23504","(۲۳۵۰۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : شَاہِدُ الزُّورِ یُعَزَّرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23504","","","كتاب البيوع والأقضية"
"23505","(۲۳۵۰۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : شَاہِدُ الزُّورِ یُضْرَبُ شَیْئًا وَیُعَرَّفُ النَّاسَ ، وَیُقَالُ : إنَّ ہَذَا شَہِدَ بِزُورٍ۔","","Musannaf Ibn Abi Shaybah 23505","","","كتاب البيوع والأقضية"
"23506","(۲۳۵۰۶) حَدَّثَنَا عَبَّادٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : شَاہِدُ الزُّورِ یُضْرَبُ مَا دُونَ أَرْبَعِینَ : خَمْسَۃً وَثَلاَثِینَ، سِتَّۃً وَثَلاَثِینَ ، سَبْعَۃً وَثَلاَثِینَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23506","","","كتاب البيوع والأقضية"
"23507","(۲۳۵۰۷) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ : أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ جَلَدَ شَاہِدَ الزُّورِ سَبْعِینَ سَوْطًا۔","","Musannaf Ibn Abi Shaybah 23507","","","كتاب البيوع والأقضية"
"23508","(۲۳۵۰۸) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنِ الْجَعْدِ أَبِی عُثْمَانَ ، قَالَ : کَانَ شُرَیْحٌ إذَا أُتِیَ بِشَاہِدِ الزُّورِ خَفَقَہُ خَفَقَاتٍ وَنَزَعَ عِمَامَتَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23508","","","كتاب البيوع والأقضية"
"23509","(۲۳۵۰۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ اشْتَرَی عَلَفًا بِوَزْنٍ فَقَبَضَہُ بِغَیْرِ وَزْنٍ فَتَلِفَ الْعَلَفُ ، فَقَالَ : ہُوَ مِنْ مَالِ الَّذِی اشْتَرَاہُ۔n قَالَ : وَقَالَ مُحَمَّدٌ مِثْلَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 23509","","","كتاب البيوع والأقضية"
"23510","(۲۳۵۱۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا قَالَ : إِنْ فَعَلْتُ کَذَا وَکَذَا فَغُلاَمِی حُرٌّ ، فَبَاعَہُ ثُمَّ فَعَلَہُ ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 23510","","","كتاب البيوع والأقضية"
"23511","(۲۳۵۱۱) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ۔ وَعَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ وَعَطَائٍ : فِی الرَّجُلِ یَقُولُ لِغُلاَمِہِ : إِنْ دَخَلْتَ الدَّارَ فَأَنْتَ حُرٌّ ، فَبَاعَہُ فَدَخَلَ الدَّارَ ، ثُمَّ اشْتَرَاہُ ، قَالُوا : لاَ یَعْتِقُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23511","","","كتاب البيوع والأقضية"
"23512","(۲۳۵۱۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یَقُولُ لِغُلاَمِہِ : إِنْ فَعَلْتَ کَذَا وَکَذَا فَأَنْتَ حُرٌّ ، وَلامْرَأَتِہِ : فَأَنْتِ طَالِقٌ ، قَالَ : إِنْ کَانَ بَیْنَہُمَا بَیْعٌ أَوْ طَلاَقٌ لَمْ یَقَعْ۔","","Musannaf Ibn Abi Shaybah 23512","","","كتاب البيوع والأقضية"
"23513","(۲۳۵۱۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنِ ابْنِ أَبِی لَیْلَی وَالْقَاسِمِ بْنِ الْوَلِیدِ وَابْنِ شُبْرُمَۃَ: فِی الرَّجُلِ یَقُولُ : إِنْ فَعَلْتُ کَذَا وَکَذَا فَغُلاَمُہُ حُرٌّ ، أَوِ امْرَأَتُہُ طَالِقٌ ، فَیَبِیعُ الْغُلاَمَ ، أَوْ یُطَلِّقُ الْمَرْأَۃَ، ثُمَّ یَحْنَثُ فِی یَمِینِہِ ، قَالُوا : یَلْزَمُہُ الْعِتْقُ وَالطَّلاَقُ۔","","Musannaf Ibn Abi Shaybah 23513","","","كتاب البيوع والأقضية"
"23514","(۲۳۵۱۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ وَعَنِ ابْنِ سِیرِینَ : أَنَّ شُرَیْحًا کَانَ یُجِیزُ الإِعْتِرَافَ فِی الْقِصَصِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23514","","","كتاب البيوع والأقضية"
"23515","(۲۳۵۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فُرَاتُ بْنُ أَبِی بَحْرٍ ، عَنْ أَبِیہِ ، قَالَ شَہِدْتُ شُرَیْحًا رُفِعَتْ إلَیْہِ قِصَّۃٌ فَقَالَ : إنِّی لَسْتُ أَقْرَأُ الْکُتُبَ۔","","Musannaf Ibn Abi Shaybah 23515","","","كتاب البيوع والأقضية"
"23516","(۲۳۵۱۶) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ حَنَشٍ ، عَنْ عَلِیٍّ : أَنَّہُ اسْتَحْلَفَ عُبَیْدَ اللہِ بْنَ الْحُرِّ مَعَ بَیِّنَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 23516","","","كتاب البيوع والأقضية"
"23517","(۲۳۵۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حسن بن صالح ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَلِیٍّ : أَنَّہُ اسْتَحْلَفَ عُبَیْدَ اللہِ بْنَ الْحُرِّ مَعَ بَیِّنَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 23517","","","كتاب البيوع والأقضية"
"23518","(۲۳۵۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ الْمُغِیرَۃِ ، عَنْ سَعِیدِ بْنِ أَشْوَعَ ، عَنْ شُرَیْحٍ ، قَالَ : قَبَّحَ اللَّہُ بَیِّنَتَکَ إِنْ لَمْ تَحْلِفْ عَلَی حَقِّک۔","","Musannaf Ibn Abi Shaybah 23518","","","كتاب البيوع والأقضية"
"23519","(۲۳۵۱۹) حَدَّثَنَا وَکِیعٌ، قَالَ: حَدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، قَالَ: قُلْتُ لِلشَّعْبِیِّ: أَسْتَحْلِفُ الرَّجُلَ مَعَ بَیِّنَتِہِ ؟ قَالَ: نَعَمْ۔","","Musannaf Ibn Abi Shaybah 23519","","","كتاب البيوع والأقضية"
"23520","(۲۳۵۲۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ یَسْتَحْلِفُ مَعَ الْبَیِّنَۃِ۔","","Musannaf Ibn Abi Shaybah 23520","","","كتاب البيوع والأقضية"
"23521","(۲۳۵۲۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : أَقَامَ رَجُلٌ عَلَی رَجُلٍ بَیِّنَتَہُ ، فَقَالَ خَصْمُہُ : یَمِینُہُ أَحَبُّ إلَیَّ مِنْ شُہُودِہِ۔ فَاسْتَحْلَفَہُ فَنَکَلَ، فَقَالَ شُرَیْحٌ: بِئْسَ مَا أَثْنَیْت عَلَی شُہُودِکَ، وَرَدَّ شَہَادَتَہُمْ۔n وَقَالَ عَبْدُ اللہِ بْنُ عُتْبَۃَ : لاَ أُعْطِیک حَقًّا لاَ تَحْلِفُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 23521","","","كتاب البيوع والأقضية"
"23522","(۲۳۵۲۲) حَدَّثَنَا عُبَیْدُ اللہِ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنِ ابْنِ شُبْرُمَۃَ وَابْنِ أَبِی لَیْلَی: فِی سَفِینَۃٍ تُؤَاجَرُ فِی الْبَحْرِ فَتَنْکَسِرُ وَفِیہَا مَتَاعٌ : قَالَ ابْنُ شُبْرُمَۃَ : لاَ یَضْمَنُ ، وَقَالَ ابْنُ أَبِی لَیْلَی : یَضْمَنُ ، وَقَالَ سُفْیَانُ : لاَ نَرَی عَلَیْہِ ضَمَانًا۔","","Musannaf Ibn Abi Shaybah 23522","","","كتاب البيوع والأقضية"
"23523","(۲۳۵۲۳) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ الْحَکَمَ وَالشَّعْبِیَّ عَنْ رَجُلٍ اسْتَعَارَ دَابَّۃً فَأَکْرَاہَا بِدِرْہَمٍ ، قَالَ الْحَکَمُ : الدِّرْہَمُ لَہُ ، وَقَالَ الشَّعْبِیُّ : الدِّرْہَمُ لِصَاحِبِ الدَّابَّۃِ۔","","Musannaf Ibn Abi Shaybah 23523","","","كتاب البيوع والأقضية"
"23524","(۲۳۵۲۴) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عنِ الشَّعْبِیِّ : فِی رَجُلَیْنِ اشْتَرَکَا ، فَأَخْرَجَ کُلُّ وَاحِدٍ عَشَرَۃَ آلاَفٍ وَلَمْ یَخْلِطَاہَا ، فَعَمِلَ أَحَدُہُمَا بِمَا عِنْدَہُ فَتَوِیَ ، فَلَمْ یَرَہُ شَرِیکًا ، وَقَالَ : النُّقْصَانُ وَمَا تَوِیَ : عَلَیْہِ ، وَلَیْسَ عَلَی الآخَرِ مِنْہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 23524","","","كتاب البيوع والأقضية"
"23525","(۲۳۵۲۵) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : قَالَ سُفْیَانُ : لاَ تَکُونُ شَرِکَۃً بَیْنَہُمَا حَتَّی یَخْلِطَا أَمْوَالَہُمَا۔","","Musannaf Ibn Abi Shaybah 23525","","","كتاب البيوع والأقضية"
"23526","(۲۳۵۲۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَسَنٌ ، عَنِ ابْنِ أَبِی لَیْلَی : أَنَّہُ قَالَ فِی قَصَّارٍ اسْتَعَانَ صَاحِبَ الثَّوْبِ فَدَقَّ مَعَہُ فَخَرَقَ الثَّوْبَ ، قَالَ : یَضْمَنُ الْقَصَّارُ۔","","Musannaf Ibn Abi Shaybah 23526","","","كتاب البيوع والأقضية"
"23527","(۲۳۵۲۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ: فِی الْمَرِیضِ قَالَ : إذَا أَبْرَأَ الْوَارِثَ مِنَ الدَّیْنِ بَرِیئَ۔","","Musannaf Ibn Abi Shaybah 23527","","","كتاب البيوع والأقضية"
"23528","(۲۳۵۲۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23528","","","كتاب البيوع والأقضية"
"23529","(۲۳۵۲۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُلُّ شَیْئٍ یُوزَنُ فَمِثْلٌ بِمِثْلٍ ، فَإِذَا اخْتَلَفَ فَزِدْ وَازْدَدْ ، وَکُلُّ شَیْئٍ یُکَالُ فَمِثْلٌ بِمِثْلٍ ، فَإِذَا اخْتَلَفَ فَزِدْ وَازْدَدْ۔","No Data Available","Musannaf Ibn Abi Shaybah 23529","","","كتاب البيوع والأقضية"
"23530","(۲۳۵۳۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنِ الشَّعْبِیِّ، عَنْ شُرَیْحٍ، قَالَ: الْحَقُّ جَدِیدٌ، لاَ یُبْطِلُہُ طُولُ التَّرْکِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23530","","","كتاب البيوع والأقضية"
"23531","(۲۳۵۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ سَرَقَ عَبْدًا فَبَاعَہُ مِنْ آخَر فَمَاتَ فِی یَدِ الْمُشْتَرِی ، قَالَ : ذَہَبَتْ دَرَاہِمُ الْمُشْتَرِی ، وَیَتْبَعُ صَاحِبُ الْعَبْدِ السَّارِقَ۔","","Musannaf Ibn Abi Shaybah 23531","","","كتاب البيوع والأقضية"
"23532","(۲۳۵۳۲) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ عَنْ رَجُلٍ یَشْتَرِی الْفُلُوسَ بِالدَّرَاہِمِ ہَلْ ہُوَ صَرْفٌ ؟ فَقَالَ : نَعَمْ فَلاَ تُفَارِقْہُ حَتَّی تَسْتَوْفِیَہُ۔","","Musannaf Ibn Abi Shaybah 23532","","","كتاب البيوع والأقضية"
"23533","(۲۳۵۳۳) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَبْتَاعُ الثَّوْبَ جَمَاعَۃً ، کُلُّ ثَوْبٍ بِعَشَرَۃِ دَرَاہِمَ وَبَعْضُہُ خَیْرٌ مِنْ بَعْضٍ ، فَیَکُونُ فِی بَعْضِہِ خَرْقٌ ؟ قَالَ : یَرُدہُّ بِعَشَرٍ۔n قَالَ سُفْیَانُ غَیْرَہُ یقول : یردہ بقیمتہ من جمیع الثمن۔ قَالَ سفیان وَہُوَ أَحَبُّ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 23533","","","كتاب البيوع والأقضية"
"23534","(۲۳۵۳۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مُفَضَّلُ بْنُ مُہَلْہَلٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ : فِی الرَّجُلِ یَأْذَنُ لِعَبْدِہِ فِی التِّجَارَۃِ ثُمَّ یَبِیعُہُ : قَالَ : یَضْمَنُ۔","","Musannaf Ibn Abi Shaybah 23534","","","كتاب البيوع والأقضية"
"23535","(۲۳۵۳۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، قَالَ : قُلْتُ لِلْجَعْدِ بْنِ ذَکْوَانَ : شَہِدْتَ شُرَیْحًا یَقُولُ : أُجِیزُ شَہَادَۃَ الشَّاہِدِ عَلَی الشَّاہِدِ؟ قَالَ : نَعَمْ إذا کان عدلاً۔","","Musannaf Ibn Abi Shaybah 23535","","","كتاب البيوع والأقضية"
"23536","(۲۳۵۳۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ الحسن ، عن عبد الأعلی ، عن شریح : أنہ کان یجیز شَہَادَۃَ الشَّاہِدِ عَلَی الشَّاہِدِ إذَا شُہِدَ عَلَیْہِمَا۔","","Musannaf Ibn Abi Shaybah 23536","","","كتاب البيوع والأقضية"
"23537","(۲۳۵۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ لاَ یُجِیزُ شَہَادَۃَ الشَّاہِدِ مَا دَامَ حَیًّا وَلَوْ کَانَ بِالْیَمَنِ۔","","Musannaf Ibn Abi Shaybah 23537","","","كتاب البيوع والأقضية"
"23538","(۲۳۵۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ الأَزْرَقِ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ یَقُولُ : لاَ تَجُوزُ شَہَادَۃُ الشَّاہِدِ عَلَی الشَّاہِدِ حَتَّی یَکُونَا اثْنَیْنِ۔","","Musannaf Ibn Abi Shaybah 23538","","","كتاب البيوع والأقضية"
"23539","(۲۳۵۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أخْبَرَنَا ہِشَامٌ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالْمُقَاوَاۃِ۔","","Musannaf Ibn Abi Shaybah 23539","","","كتاب البيوع والأقضية"
"23540","(۲۳۵۴۰) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ کَسْبَ الْیَدِ عَلَی التِّجَارَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23540","","","كتاب البيوع والأقضية"
"23541","(۲۳۵۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ وَائِلِ بْنِ دَاو??د ، عَنْ سَعِیدِ بْنِ المُسَیَّب ، قَالَ : سُئِلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّ الْکَسْبِ أَطْیَبُ ؟ قَالَ : عَمَلُ الرَّجُلِ بِیَدِہِ ، وَکُلُّ بَیْعٍ مَبْرُورٍ۔ (حاکم ۱۰۔ بزار ۱۲۵۷)","","Musannaf Ibn Abi Shaybah 23541","","","كتاب البيوع والأقضية"
"23542","(۲۳۵۴۲) حَدَّثَنَا حَفْصٌ ، قَالَ : سَأَلْتُ عَمْرًا مَا کَانَ الْحَسَنُ یَقُولُ فِی الْبِطِّیخِ وَالْقِثَّائِ وَالْخِیَارِ وَالْوَرْدِ ، وَمَا لاَ یَخْرُجُ جَمِیعًا ، قَالَ : کَانَ یَقُولُ : لاَ یُشْتَرَی إلاَّ مَا یَخْرُجُ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 23542","","","كتاب البيوع والأقضية"
"23543","(۲۳۵۴۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مُفَضَّلٌ ، عَنْ مُغِیرَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : الرَّجُلُ یُسْلِمُ فِی العِنَبِ؟ فَلَمْ یَرَ بِہِ بَأْسًا ، قَالَ : قُلْتُ : أُسْلِمُ فِی العِنَبِ أَنَأْخُذُ بُسْرًا ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 23543","","","كتاب البيوع والأقضية"
"23544","(۲۳۵۴۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا أَبُو بَکْرٍ النَّہْشَلِیُّ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ، عَنْ طَاوُوسٍ : أَنَّ رَجُلاً سَأَلَہُ فَقَالَ : إنِّی جَعَلْت جَارِیَتِی حُرَّۃً إِنْ نَقَصْتُہَا مِنْ کَذَا وَکَذَا ، فَقَدْ خِفْت أَنْ یَنْقَضِیَ الْمَوْسِمُ قَبْلَ أَنْ نَبِیعَہَا ، فَتَرَی أَنْ نَبِیعَہَا بِأَقَلَّ مِمَّا قُلْت ؟ قَالَ : إِنْ لَمْ تَخَفَ السُّلْطَانَ۔ أَوْ : لَوْلاَ أَنِّی أَخَافُ السُّلْطَانَ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 23544","","","كتاب البيوع والأقضية"
"23545","(۲۳۵۴۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ : أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا أَنْ یَشْتَرِیَ الرَّجُلُ الْبَیْعَ بَعْضَہُ بِنَقْدٍ وَبَعْضَہُ بِنَسِیئَۃٍ : ثُمَّ یَبِیعُہُ مُرَابَحَۃً ، قَالاَ : یُعْلِم صَاحِبُہُ مِنْہُ مِثْلَ مَا یَعْلَمُ۔","","Musannaf Ibn Abi Shaybah 23545","","","كتاب البيوع والأقضية"
"23546","(۲۳۵۴۶) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی حَرَّۃَ ، قَالَ : سَمِعْتُ أَبَا نَضْرَۃَ یَقُولُ : التَّاجِرُ الصَّدُوقُ بِمَنْزِلَۃِ الشَّہِیدِ عِنْدَ اللہِ تَعَالَی یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 23546","","","كتاب البيوع والأقضية"
"23547","(۲۳۵۴۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : مَالِکُ بْنُ مِغْوَلٍ ، عَنْ أَبِی حَمْزَۃَ ، عَنِ الْحَسَنِ ، قَالَ : التَّاجِرُ الأَمِینُ الصَّادِقُ مَعَ الصِّدِّیقِینَ وَالشُّہَدَائِ۔n قَالَ : فَذَکَرْت ذَلِکَ لإِبْرَاہِیمَ فَقَالَ : صَدَقَ الْحَسَنُ ، أَوْ لَیْسَ فِی جِہَادٍ؟۔ (ترمذی ۱۲۰۹۔ دارقطنی ۱۸)","No Data Available","Musannaf Ibn Abi Shaybah 23547","","","كتاب البيوع والأقضية"
"23548","(۲۳۵۴۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ سَعِیدِ بْنِ الْمُسَیَّبِ : فِی رَجُلٍ أَعْتَقَ عَبْدَہُ وَشَرَطَ خِدْمَتَہُ ، قَالَ : إذَا أَعْتَقَہُ بَطَلَ شَرْطُہُ۔","","Musannaf Ibn Abi Shaybah 23548","","","كتاب البيوع والأقضية"
"23549","(۲۳۵۴۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عن أَبِی حَیَّانَ التَّیْمِیِّ ، عَنْ أَبِیہِ : أَنَّ جَارَۃً لِشُرَیْحٍ دَخَلَتْ عَلَیْہِ وَمَعَہَا جَارِیَۃٌ لَہَا ، فَقَالَتْ : یَا أَبَا أُمَیَّۃَ إنِّی أَعْتَقْت جَارِیَتِی ہَذِہِ ، قَالَ : قَدْ أَسْمَعُ مَا تَقُولِینَ ، قَالَتْ : وَشَرَطْت عَلَیْہَا خِدْمَتِی مَا دُمْت حَیَّۃً ، فَقَالَ شُرَیْحٌ : ہَا ہِیَ ہَذِہِ إِنْ شَائَتْ فَعَلَتْ۔","","Musannaf Ibn Abi Shaybah 23549","","","كتاب البيوع والأقضية"
"23550","(۲۳۵۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی کِبْرَانَ ، عَنِ الضَّحَّاکِ : فِی امْرَأَۃٍ أَعْتَقَتْ خَادِمًا لَہَا ، ثُمَّ اسْتَثْنَتْ ، قَالَ الضَّحَّاکُ : تُعْتَقُ۔","","Musannaf Ibn Abi Shaybah 23550","","","كتاب البيوع والأقضية"
"23551","(۲۳۵۵۱) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ الْمُغِیرَۃِ بْنِ سَعْدِ بْنِ الأَخْرَمِ ، عَنْ أَبِیہِ : أَنَّ رَجُلاً أَتَی ابْنَ مَسْعُودٍ فَقَالَ : إنِّی أَعْتَقْت أَمَتِی ہَذِہِ ، وَاشْتَرَطْت عَلَیْہَا أَنْ تَلِیَ مِنِّی مَا تَلِی الأَمَۃُ مِنْ سَیِّدِہَا إلاَّ الْفَرْجِ ، أَوْ قَالَ : غَیْرِ الْفَرْجِ ، فَلَمَّا غَلُظْت رَقَبَتَہَا ، قَالَتْ : إنِّی حُرَّۃٌ ، قَالَ : لَیْسَ ذَلِکَ لَہَا ، خُذْ بِرَقَبَتِہَا فَانْطَلِقْ بِہَا ، فَلَکَ مَا اشْتَرَطْت عَلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 23551","","","كتاب البيوع والأقضية"
"23552","(۲۳۵۵۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ سَعِیدِ بْنِ جُمْہَانَ ، عَنْ سَفِینَۃَ : أَنَّ أُمَّ سَلَمَۃَ أَعْتَقَتْہُ وَاشْتَرَطَتْ عَلَیْہِ أَنْ یَخْدُمَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَا عَاشَ۔ (ابوداؤد ۳۹۲۸۔ ابن ماجہ ۲۵۲۶)","Hasan","Musannaf Ibn Abi Shaybah 23552","","","كتاب البيوع والأقضية"
"23553","(۲۳۵۵۳) حَدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، قَالَ : أَمَرَنِی الزُّہْرِیُّ فَکَتَبْت عَلَیْہِ کِتَابًا : أَنَّہُ اسْتَسْلَفَ ذَہَبًا مَعْلُومًا فِی طَعَامٍ مَعْلُومٍ إلَی أَجَلٍ مَعْلُومٍ مِنْ صَالِحِ طَعَامِ کَذَا ، أَوْ شَرْوَاہُ۔","","Musannaf Ibn Abi Shaybah 23553","","","كتاب البيوع والأقضية"
"23554","(۲۳۵۵۴) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ حَمَّادٍ ، قَالَ : لَوْ بِعْت رَجُلاً طَعَامًا بِالْحَالِّ فَنَقَلَہُ إلَی بَیْتِہِ ، ثُمَّ أَقَلْتہ مِنْہُ وَقَبَضْتہ فِی بَیْتِہِ ، فَإِنْ شِئْتَ بِعْت مِنْہُ بِنَسِیئَۃٍ ، وَقَالَ قَتَادَۃُ : لاَ تَشْتَرِہ مِنْہُ حَتَّی تَنْقُلَہُ إلَی بَیْتِک۔","","Musannaf Ibn Abi Shaybah 23554","","","كتاب البيوع والأقضية"
"23555","(۲۳۵۵۵) حَدَّثَنَا عَبْدُ الصَّمَدِ ، عَنْ ہِشَامٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ فِی کُرٍّ مِنْ بُرٍّ بِمِئَۃِ مِیزَانٍ مِنْ عَلَفٍ نَسِیئَۃً : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 23555","","","كتاب البيوع والأقضية"
"23556","(۲۳۵۵۶) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ حَبِیبِ بْنِ أَبِی مَرْزُوقٍ ، قَالَ : سُئِلَ ابْنُ عَبَّاسٍ عَنْ رَجُلٍ اسْتَقْرَضَ طَعَامًا عَتِیقًا ، فَقَضَی مَکَانَہُ حَدِیثًا؟ قَالَ : إِنْ لَمْ یَکُنْ بَیْنَہُمَا شَرْطُہُ فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 23556","","","كتاب البيوع والأقضية"
"23557","(۲۳۵۵۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سَہْلٍ السَّرَّاجِ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنِ الرَّجُلِ یُعِینُ الرَّجُلَ مِنَ الْمُشْرِکِینَ؟ قَالَ : أَوَ مَا بَلَغَک مَا قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الأَعْرَابِیِّ ؟۔","Hasan","Musannaf Ibn Abi Shaybah 23557","","","كتاب البيوع والأقضية"
"23558","(۲۳۵۵۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ بِشْرِ بْنِ مَنْصُورٍ ، عَنْ حَمَّادٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَشْتَرِیَ لأَہْلِ الذِّمَّۃِ۔","","Musannaf Ibn Abi Shaybah 23558","","","كتاب البيوع والأقضية"
"23559","(۲۳۵۵۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، عَنْ أَبِی عَبْدِ اللہِ الشَّقَرِیِّ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ بَاعَ بَیْعًا إلَی أَجَلٍ ، فَبَاعَہُ الْمُشْتَرِی مِنْ رَجُلٍ ، أَیَشْتَرِیہِ صَاحِبُہُ الَّذِی بَاعَہُ ؟ قَالَ : إذَا لَمْ یَکُنْ فِیہِ مُوَاکَسَۃ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23559","","","كتاب البيوع والأقضية"
"23560","(۲۳۵۶۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سَعِیدِ بْنِ زید، عن ہشام، عن الحسن: فی ہذا إذَا لَمْ یَکُنْ فِیہِ مُوَاکَسَۃ فَلاَ بَأْسَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23560","","","كتاب البيوع والأقضية"
"23561","(۲۳۵۶۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سَعِیدِ بْنِ السَّائِبِ ، عَنْ دَاوُدَ بْنِ أَبِی عَاصِمٍ : أَنَّہُ بَاعَ مِنْ أُخْتِہِ بَیْعًا إلَی أَجَلٍ ، ثُمَّ أَمَرَتْہُ أَنْ یَبِیعَہُ ، فَبَاعَہُ ، فَسَأَلْت ابْنَ الْمُسَیَّبِ ؟ فَقَالَ : أبْصِرْ أَنْ یَکُونَ أَنْتَ ہُوَ؟ قُلْتُ : أَنَا ہُوَ ، قَالَ : ذَاکَ ہُوَ الرِّبَا ، ذَاکَ ہُوَ الرِّبَا ، فَلاَ تَأْخُذْ مِنْہُ إلاَّ رَأْسَ مَالِکَ۔","","Musannaf Ibn Abi Shaybah 23561","","","كتاب البيوع والأقضية"
"23562","(۲۳۵۶۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ لِمَیِّتٍ شَرْطٌ۔","","Musannaf Ibn Abi Shaybah 23562","","","كتاب البيوع والأقضية"
"23563","(۲۳۵۶۳) حَدَّثَنَا عَبْدُ الصَّمَدِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَکَمِ : فِی الرَّجُلِ یُؤَاجِرُ دَارَہُ عَشْرَ سِنِینَ ، فَیَمُوتُ قَبْلَ ذَلِکَ : تُنْتَقَضُ الإِجَارَۃُ ، وَتَبْطُلُ الْعَارِیَّۃُ۔n وَقَالَ مَکْحُولٌ : تَمْضِی الْعَارِیَّۃُ ، وَتَبْطُلُ الإِجَارَۃُ۔n وَقَالَ إیَاسُ بْنُ مُعَاوِیَۃَ : یَمْضِیَانِ إلَی غَایَتِہِمَا۔n قَالَ أَیُّوبُ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ : إنَّمَا یَرِثُونَ مِنْ ذَلِکَ مَا کَانَ یَمْلِکُ فِی حَیَاتِہِ۔","","Musannaf Ibn Abi Shaybah 23563","","","كتاب البيوع والأقضية"
"23564","(۲۳۵۶۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ عَامِرٍ : أَنَّہُ سُئِلَ عَنِ امْرَأَۃٍ أَسْلَمَتْ غُلاَمًا لَہَا أَشْہُرًا ، فَمَاتَتِ الْمَرْأَۃُ قَبْلَ ذَلِکَ ؟ فَقَالَ عَامِرٌ لأَخیہَا : ہُوَ غُلاَمُک ، إِنْ شِئْتَ قَبَضْتَہُ ، وَإِنْ شِئْتَ تَرَکْتَہُ۔","","Musannaf Ibn Abi Shaybah 23564","","","كتاب البيوع والأقضية"
"23565","(۲۳۵۶۵) حَدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ یَکْرَہُ أَنْ یَضْمَنَ السِّمْسَارُ۔","","Musannaf Ibn Abi Shaybah 23565","","","كتاب البيوع والأقضية"
"23566","(۲۳۵۶۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ : فِی رَجُلٍ دَبَّرَ غُلاَمًا لَہُ ، ثُمَّ مَاتَ وَعَلَیْہِ دَیْنٌ، قَالَ : یَسْعَی فِیہِ۔","","Musannaf Ibn Abi Shaybah 23566","","","كتاب البيوع والأقضية"
"23567","(۲۳۵۶۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حُذَیْفَۃَ أبی الْیَمَانِ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : إذَا أَشْرَکَ الرَّجُلُ الرَّجُلَ وَلَمْ یَنْقُدْ فَلَیْسَ عَلَیْہِ وَضِیعَۃٌ ، إنَّمَا ہِیَ طُعْمَۃٌ أَطْعَمَہَا إیَّاہُ۔","","Musannaf Ibn Abi Shaybah 23567","","","كتاب البيوع والأقضية"
"23568","(۲۳۵۶۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : فِی رَجُلٍ بَاعَ غُلاَمًا لَہُ بِغَنَمٍ فَتَنَاتَجَت الْغَنَمُ فَزَادَتْ ، ثُمَّ وُجِدَ بِالْغُلاَمِ عَیْبًا دُلِّسَ لَہُ ، قَالَ : یَرُدُّہُ وَلَہُ شَرْوَی غَنَمِہِ ، أَوْ یُعْطِیہَا إیَّاہُ بِأَعْیَانِہَا کَمَا أَخَذَہَا۔","","Musannaf Ibn Abi Shaybah 23568","","","كتاب البيوع والأقضية"
"23569","(۲۳۵۶۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ : فِی الرَّجُلِ یَرْہَنُ الْمُصْحَفَ بِالْعَرْضِ ، قَالا : لاَ یَقْرَأُ فِیہِ ، وَإِنْ أَذِنَ صَاحِبُہُ ، وَإِنْ کَانَ فِی بَیْعٍ فَأَذِنَ لَہُ صَاحِبُہُ ، قَرَأَ فِیہِ ، وَإِلاَّ لَمْ یَقْرَأْ فِیہِ۔","","Musannaf Ibn Abi Shaybah 23569","","","كتاب البيوع والأقضية"
"23570","(۲۳۵۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَکْرَہُ أَنْ یَسْتَأْجِرَ الْعَرْصَۃَ فَیَبْنِیَ فِیہَا مِنْ أَجْرِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23570","","","كتاب البيوع والأقضية"
"23571","(۲۳۵۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنِ ابْنِ عَوْنٍ، قَالَ: کَانَ مُحَمَّدٌ یَکْرَہُ أَنْ یُعَجِّلَ السَّاکِنُ مِنَ الأَجْرِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 23571","","","كتاب البيوع والأقضية"
"23572","(۲۳۵۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ رَجُلٌ آجَرَ نَفْسَہُ سَنَۃً بِأَلْفِ دِرْہَمٍ ، قَالَ : فَقَالَ لِی : سَلْ مُحَمَّدًا فَإِنَّہُمْ قَدْ عَجَّلُوا لِی ، فَسَأَلْتُہُ ؟ فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 23572","","","كتاب البيوع والأقضية"
"23573","(۲۳۵۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ الْقَاسِمُ بْنُ مُحَمَّدٍ خَاصَمَ إلَی قَاضٍ فَقَضَی عَلَیْہِ ، فَعُزِلَ ذَلِکَ الْقَاضِی ، فَجَائَ غَیْرُہُ ، فَکَانَ یَقْضِی لِلْقَاسِمِ ، فَقِیلَ لَہُ : لَوْ خَاصَمْت إلَیْہِ ، فَقَالَ : لاَ ، إنِّی قَدْ خَاصَمْت إلَی قَاضٍ فَقَضَی عَلَیَّ۔","","Musannaf Ibn Abi Shaybah 23573","","","كتاب البيوع والأقضية"
"23574","(۲۳۵۷۴) حَدَّثَنَا أَزْہَرٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ بَأْسَ بِالثَّوْبِ أَنْ یَقُولَ الرَّجُلُ : إِنْ تَأْخُذْہُ کُلَّہُ فَبِعَشْرَۃٍ ، وَإِنْ أَخَذْتَ نِصْفَہُ فَبِأَحَدَ عَشَرَ۔","","Musannaf Ibn Abi Shaybah 23574","","","كتاب البيوع والأقضية"
"23575","(۲۳۵۷۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، قَالَ : کَانَ عَامِرٌ یُجِیزُ الْکِتَابَ الْمَخْتُومَ یَجِیئُہُ مِنَ الْقَاضِی۔","","Musannaf Ibn Abi Shaybah 23575","","","كتاب البيوع والأقضية"
"23576","(۲۳۵۷۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ عُمَرَ بْنِ أَبِی زَائِدَۃَ ، قَالَ : جِئْنَا بِکِتَابٍ مِنْ قَاضِی الْکُوفَۃِ إلَی إیَاسِ بْنِ مُعَاوِیَۃَ ، فَجِئْت وَقَدْ عُزِلَ إیَاسٌ وَاسْتُقْضِیَ الْحَسَنُ ، فَدَفَعْت کِتَابِی إلَیْہِ فَقَبِلَہُ وَلَمْ یَسْأَلْنِی عَنْہ ، فَفَتَحَہُ ، ثُمَّ نَشَرَہُ ، فَوَجَدَ لِی فِیہِ شَہَادَۃَ شَاہِدَیْنِ عَلَی رَجُلٍ مِنْ أَہْلِ الْبَصْرَۃِ بِخَمْسِمِئَۃٍ درہم ، فَقَالَ لِرَجُلٍ یَقُومُ عَلَی رَأْسِہِ : اذْہَبْ بِہَذَا إلَی ابْنِ زِیَادٍ ، فَقُلْ لَہُ : أَرْسِلْ إلَی فُلاَنِ بْنِ فُلاَنٍ ، فَخُذْ مِنْہُ خَمْسَمِئَۃِ دِرْہَمٍ فَادْفَعْہَا إلَی ہَذَا ، قَالَ : فَذَہَبَ بِی فَفَعَلَ۔","","Musannaf Ibn Abi Shaybah 23576","","","كتاب البيوع والأقضية"
"23577","(۲۳۵۷۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کِتَابُ الْقَاضِی إلَی الْقَاضِی جَائِزٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 23577","","","كتاب البيوع والأقضية"
"23578","(۲۳۵۷۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، قَالَ : کَانَ الشَّعْبِیُّ یَسْأَلُ الشَّاہِدَ أَنْ یَجِیئَ بِمَنْ یُزَکِّیہِ۔","","Musannaf Ibn Abi Shaybah 23578","","","كتاب البيوع والأقضية"
"23579","(۲۳۵۷۹) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ دَاوُدَ بْنِ سِنَانٍ : أَنَّ رَجُلاً اشْتَرَی حَائِطَ رُمَّانٍ بِثَمَانِمِئَۃِ دِرْہَمٍ ، فَبَاعَ مِنْہُ بِعِشْرِینَ دِرْہَمًا ، ثُمَّ بَاعَ مَا بَقِیَ مُرَابَحَۃً ، فَأَخْبَرَ صَاحِبَہُ فَخَاصَمَہُ إلَی أَمِینِ السُّوقِ ، فَأَبْرَأَہُ مِنْہَا۔n قَالَ : فَسَأَلْت الْقَاسِمَ وَسَالِمًا ؟ فَقَالاَ : ہَذَا لاَ یَصلح۔","","Musannaf Ibn Abi Shaybah 23579","","","كتاب البيوع والأقضية"
"23580","(۲۳۵۸۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا اشْتَرَی الرَّجُلُ الدَّابَّۃَ فَوَجَدَ بِضِرْسِہَا عَیْبًا فَأَرَادَ رَدَّہَا ، فَإِنَّہُ یَحْلِفُ بِاللَّہِ إِنَّہُ لَمِنْ أَجْلِ ضِرْسِہَا رَدَّہَا ، وَإِنْ کَانَ عَیْبًا سِوَی ذَلِکَ لَمْ یَحْلِفْ۔","","Musannaf Ibn Abi Shaybah 23580","","","كتاب البيوع والأقضية"
"23581","(۲۳۵۸۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حنش بْنِ الْحَارِثِ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ النَّخَعِیِّ : أَنَّ رَجُلاً اشْتَرَی مِنْ رَجُلٍ جَارِیَۃً فَلَمْ یَجِدْ لَہَا أَضْرَاسًا ، فَخَاصَمَہُ إلَی شُرَیْحٍ ، فَقَالَ شُرَیْحٌ : بَیِّنَتُک أَنَّہُ بَاعَکَہَا وَلَیْسَ لَہَا أَضْرَاسٌ ، وَإِلاَّ فَیَمِینُہُ بِاللَّہِ أَنَّہُ بَاعَکَہَا وَلَہَا أَضْرَاسٌ۔","Hasan","Musannaf Ibn Abi Shaybah 23581","","","كتاب البيوع والأقضية"
"23582","(۲۳۵۸۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَن حَذَّائٍ حَذَا لِی نَعْلَیْنِ بِغَیْرِ أَجْرٍ فَأَفْسَدَہُمَا ؟ قَالَ: إنِّی لاَکْرَہُ أَنْ أُضَمِّنَہُ وَلَمْ أُعْطِہِ أَجْرًا۔","","Musannaf Ibn Abi Shaybah 23582","","","كتاب البيوع والأقضية"
"23583","(۲۳۵۸۳) حَدَّثَنَا أَحْمَدُ بْنُ بَشِیرٍ ، عَنِ ابْنِ شُبْرُمَۃَ ، عَنِ الشَّعْبِیِّ ، بِنَحْوٍ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 23583","","","كتاب البيوع والأقضية"
"23584","(۲۳۵۸۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ : فِی رَجُلٍ أَخَذَ طَعَامًا لِرَجُلٍ یَعْنِی غَصَبَہُ ، قَالَ : عَلَیْہِ مِثْلُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23584","","","كتاب البيوع والأقضية"
"23585","(۲۳۵۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، قَالَ : حدَّثَنَا عِیسَی الْخَبَّاطُ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنْ رَجُلٍ اسْتَأْجَرَ حَمَّالاً یَحْمِلُ عَلَیْہِ طَعَامًا ، فَوَضَعَ حِمْلاً مِنْہَا فِی أَہْلِہِ ، ثُمَّ قَالَ : اُنْظُرُوا کَمَا تَبِیعُونَ فَاحْسُبُوہُ عَلَیَّ ؟ فَقَالَ : سَعِیدٌ : عَلَیْہِ طَعَامٌ مِثْلُ طَعَامِہِ۔","","Musannaf Ibn Abi Shaybah 23585","","","كتاب البيوع والأقضية"
"23586","(۲۳۵۸۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ شُرَیْحٌ یُحَلِّفُ أَلْبَتَّۃَ فِی الرَّجُلِ یُدَّعَی عَلَی أَبِیہِ دَیْن ، فَإِنْ حَلَفَ وَإِلاَّ أَخَذَہُ مِنْہُ ، وَیَکُونُ لأَبِیکَ عَلَی إنْسَانٍ دَیْنٌ تَدَّعِیہِ فَتُقِیمُ الْبَیِّنَۃَ ، فَإِنْ حَلَفْتَ مَعَ بَیِّنَتِکَ وَإِلاَّ لَمْ یُعْطِک۔","","Musannaf Ibn Abi Shaybah 23586","","","كتاب البيوع والأقضية"
"23587","(۲۳۵۸۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَن حماد ، عَنْ إبْرَاہِیمَ ، قَالَ : یُحَلَّف فی ہذین البابین علی علمہ۔","","Musannaf Ibn Abi Shaybah 23587","","","كتاب البيوع والأقضية"
"23588","(۲۳۵۸۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ یَسْتَحْلِفُ أَلْبَتَّۃَ عَلَی مَا غَابَ وَشَہِدَ ، قَالَ : فَقُلْتُ لِعَامِرٍ : أَرَأَیْت لَوْ أَنَّ رَجُلاً ادَّعَی عَلَی أَبِی مَالاً لاَ عِلْمَ لِی بِہِ ، أَکَانَ عَلَیَّ أَنْ أَحْلِفَ أَلْبَتَّۃَ ؟ قَالَ : نَعَمْ ، فَأَنْکَرْنَا ذَلِکَ إنْکَارًا شَدِیدًا ، قَالَ : رُدَّ الْیَمِینَ عَلَی مَنْ ہُوَ أَعْلَمُ بِہَا مِنْک۔n قَالَ : وَکَانَ عَامِرٌ یَأْخُذُ بِہِ۔","","Musannaf Ibn Abi Shaybah 23588","","","كتاب البيوع والأقضية"
"23589","(۲۳۵۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا وَلِیَ الرَّجُلُ بِنَفْسِہِ اسْتُحْلِفَ أَلْبَتَّۃَ ، وَمَا وَلِیَہُ غَیْرُہُ اسْتُحْلِفَ عَلَی عِلْمِہِ۔","","Musannaf Ibn Abi Shaybah 23589","","","كتاب البيوع والأقضية"
"23590","(۲۳۵۹۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُسْتَحْلَفُ الرَّجُلُ فِیمَا ادُّعِیَ عَلَی أَبِیہِ عَلَی عِلْمِہِ۔","","Musannaf Ibn Abi Shaybah 23590","","","كتاب البيوع والأقضية"
"23591","(۲۳۵۹۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عُمَارَۃَ بْنِ أَبِی حَفْصَۃَ ، قَالَ : اخْتَصَمَ رَجُلاَنِ إلَی الْحَسَنِ فَقَالَ لَہُ : اسْتَحْلِفْہُ فِی حَقٍّ کَانَ لأَبِیہِ لَمْ یَشْہَدْ أَبَاہُ ، قَالَ : فَقَالَ الْحَسَنُ : وَہَلْ یَحْلِفُ عَلَی ہَذَا أَحَدٌ یَعْقِلُ ؟۔","","Musannaf Ibn Abi Shaybah 23591","","","كتاب البيوع والأقضية"
"23592","(۲۳۵۹۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ : عَنْ رَجُلٍ یُصِیبُ الْمَالَ الْحَرَامَ ، قَالَ : إِنْ سَرَّہُ أَنْ یَتَبَرَّأَ مِنْہُ فَلْیَخْرُجْ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 23592","","","كتاب البيوع والأقضية"
"23593","(۲۳۵۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، قَالَ : قَالَ رَجُلٌ لِعَطَائِ بْنِ أَبِی رَبَاحٍ : رَجُلٌ أَصَابَ مَالاً مِنْ حَرَامٍ ؟ قَالَ : لِیَرُدَّہُ عَلَی أَہْلِہِ ، فَإِنْ لَمْ یَعْرِفْ أَہْلَہُ فَلْیَتَصَدَّقْ بِہِ ، وَلاَ أَدْرِی یُنْجِیہِ ذَلِکَ مِنْ إِثْمِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23593","","","كتاب البيوع والأقضية"
"23594","(۲۳۵۹۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، قَالَ : زَعَمَ مَالِکُ بْنُ دِینَارٍ أَنَّ رَجُلاً سَأَلَ عَطَائً فَقَالَ : إنِّی کُنْت غُلاَمًا فَأَصَبْت أَمْوَالاً مِنْ وُجُوہٍ لاَ أُحِبُّہَا فَأَنَا أُرِیدُ التَّوْبَۃَ ؟ قَالَ : رُدَّہَا إلَی أَہْلِہَا ، قَالَ : لاَ أَعْرِفُہُمْ ، قَالَ : تَصَدَّقْ بِہَا، فَمَا لَکَ فِی ذَلِکَ مِنْ أَجْرٍ، وَمَا أَدْرِی ہَلْ تَسْلَمُ مِنْ وِزْرِہَا أَمْ لاَ؟ قَالَ: وَسَأَلَ مُجَاہِدًا؟ فَقَالَ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23594","","","كتاب البيوع والأقضية"
"23595","(۲۳۵۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الرَّبِیعِ بْنِ سَعْدٍ ، قَالَ : سَأَلَ رَجُلٌ أَبَا جَعْفَرٍ عَنْ رَجُلٍ قَالَ : صَدِیقٌ لِی أَصَابَ مَالاً حَرَامًا فَخَالَطَ کُلَّ شَیْئٍ مِنْہُ مِنْ أَہْلِہِ وَمَا لَہُمْ ، ثُمَّ إِنَّہُ عَرَفَ مَا کَانَ فِیہِ ، فَأَقْبَلَ عَلَی الْحَجِّ وَجِوَارِ ہَذَا الْبَیْتِ ، فَمَا تَرَی لَہُ ؟ قَالَ : أَرَی لَہُ أَنْ یَتَّقِیَ اللَّہَ ، ثُمَّ لاَ یَعُودُ۔","","Musannaf Ibn Abi Shaybah 23595","","","كتاب البيوع والأقضية"
"23596","(۲۳۵۹۶) حَدَّثَنَا حَفْصٌ ، عَنْ سُلَیْمَانَ أَبِی عَبْدِ اللہِ ، قَالَ : قَالَ الْحَسَنُ : مَنِ احْتَازَ مِنْ رَجُلٍ مَالاً ، أَوْ سَرَقَ مِنْ رَجُلٍ مَالاً ، وَأَرَادَ أَنْ یَرُدَّہُ إلَیْہِ مِنْ وَجْہٍ لاَ یَعْلَمُ فَأَوْصَلَہُ إلَیْہِ : فَلا بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23596","","","كتاب البيوع والأقضية"
"23597","(۲۳۵۹۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمَیْدٍ الطَّوِیلِ ، عن أنس بن مالک وإیَاسِ بْنِ مُعَاوِیَۃَ : سُئِلاَ عَنْ مَمْلُوکٍ کَانَ بَیْنَ ثَلاَثَۃٍ ، فَکَاتَبَ أَحَدُہُمْ نَصِیبَہُ ، وَأَعْتَقَ أَحَدُہُمْ نَصِیبَہُ ، فَمَاتَ الْمَمْلُوکُ وَتَرَکَ مَالاً ؟ فَقَضَی أَنَس وَإِیَاسٌ : أَنَّ مَا تَرَکَ فَہُوَ بَیْنَہُمْ بِالسَّوِیَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 23597","","","كتاب البيوع والأقضية"
"23598","(۲۳۵۹۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ مُوسَی بْنِ عُلَیِّ بْنِ رَبَاحٍ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ عَنْ مُکَاتَبٍ تَزَوَّجَ حُرَّۃً فَأَوْلَدَہَا ، وَاشْتَرَی جَارِیَۃً فَأَوْلَدَہَا ، فَمَاتَ وَبَقِیَ عَلَیْہِ شَیْئٌ مِنْ مُکَاتَبَۃٍ أَیُّہُمَا یَسْعَی فِیمَا بَقِیَ عَلَیْہِ ؟ قَالَ : وَلَدُہُ الَّذِین مِنْ جَارِیَتِہِ۔","","Musannaf Ibn Abi Shaybah 23598","","","كتاب البيوع والأقضية"
"23599","(۲۳۵۹۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا عَنِ الرَّجُلِ یَکُونُ فِی الدَّارِ حِینًا فَیَجِیئُ أُنَاسٌ فَیُقِیمُونَ الْبَیِّنَۃَ أَنَّہَا کَانَتْ لِجَدِّہِمْ ؟ قَالَ : لاَ ، حَتَّی یَشْہَدُوا أَنَّہَا لَہُ الْیَوْمَ۔","","Musannaf Ibn Abi Shaybah 23599","","","كتاب البيوع والأقضية"
"23600","(۲۳۶۰۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ ، قَالَ : إذَا کَانَتِ الدَّارُ خِطَّۃً ، فَأَرَادَ الْقَوْمُ أَنْ یَقْتَسِمُوہَا ، فَإِنَّہَا تُقَسَّمُ عَلَی الْمِیرَاثِ مِیرَاثِ الْمَیِّتِ صَاحِبِ الْخِطَّۃِ ، فَإِنِ ادَّعَی إنْسَانٌ مِنَ الْوَرَثَۃِ ، أَوْ غَیْرِہِمْ دَعْوَی فَوْقَ مَا یُصِیبُہُ مِنَ الْمِیرَاثِ : فَعَلَیْہِ الْبَیِّنَۃُ فِیمَا ادَّعَی أَنَّ فُلاَنًا ، أَوْ أنَّہُ تُصُدِّقَ عَلَیَّ ، أَوْ وُہِبَ لِی أَوْ بَاعَنِی بِکَذَا وَکَذَا ، وَإِنْ طَلَبَت امْرَأَۃٌ أَوْ زَوْجٌ کَانَ لِبَعْضِ بَنِی الْمَیِّتِ ، فَإنَّہُ یُکَلَّفُ الْبَیِّنَۃَ عَلَی أَنَّ فُلاَنًا وَرِثَ فُلاَنًا ، أَوْ فُلاَنَۃً وَرِثَتْ فُلاَنًا ، أَوْ مَاتَ صَاحِبُ الْخِطَّۃِ قَبْلَہَا أَوْ ہِیَ قَبْلَہُ فَوَرِثَتْہُ ، فَإِنَّہُ یَأْخُذُ بِحَقِّہِ۔n وَإِنْ کَانَ رَجُلٌ مِنْ وَلَدِ صَاحِبِ الْخِطَّۃِ یَدَّعِی فِیہَا وَیُنْکِرُ الَّذِینَ فِی أَیْدِیہِمْ نَصِیبَہُ ، فَعَلَی الْمُدَّعِی الْبَیِّنَۃُ أَنَّ فُلاَنًا مَاتَ قَبْلَ فُلاَنٍ ، وَوَرِثَہُ فُلاَنٌ ، وَوَرِثْتہ أَنَا بَعْدُ۔n وَإِذَا أَقَرَّ الْوَرَثَۃُ أَنَّہُ قَدْ کَانَ لِصَاحِبِ الدَّارِ امْرَأَۃٌ ، وَادَّعَی أَہْلُہَا نَصِیبَہَا فَہُوَ ثَابِتٌ عَلَیْہِمْ ، وَإِنْ قَالُوا : قَدْ کَانَ طَلَّقَہَا قَبْلَ الْمَوْتِ فَالْبَیِّنَۃُ عَلَیْہِمْ أَنَّہُ قَدْ کَانَ طَلَّقَہَا ، وَإِلأَفَقَدْ وَجَبَ الْمِیرَاثُ لَہَا۔n وَإِذَا کَانَتِ الدَّارُ شِرَائً وَہِیَ فِی یَدِ قَوْمٍ فَہِیَ لِلَّذِین فِی أَیْدِیہِمْ ، فَإِنِ ادَّعَی إنْسَانٌ فِیہَا فَعَلَیْہِ الْبَیِّنَۃُ ، أَنَّ لَہُ فِیہَا حَقًّا۔","","Musannaf Ibn Abi Shaybah 23600","","","كتاب البيوع والأقضية"
"23601","(۲۳۶۰۱) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : مَا أَحْدَثُوا شَیْئًا أَعْجَبُ إلَیَّ مِنْ قَوْلِہِمْ : یَشْہَدُ أَنَّہَا لَہُ الْیَوْمَ۔","","Musannaf Ibn Abi Shaybah 23601","","","كتاب البيوع والأقضية"
"23602","(۲۳۶۰۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ وَحَمَّادٍ ، قَالاَ : لَوْ أَنَّ رَجُلاً قَالَ لِرَجُلٍ : اذْہَبْ إلَی بَابِ الدَّارِ وَلَک خَمْسُمِئَۃِ دِرْہَمٍ ، قَالاَ : کَانَ لَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23602","","","كتاب البيوع والأقضية"
"23603","(۲۳۶۰۳) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ مُغِیرَۃَ وَالشَّعْبِیِّ : فِی رَجُلٍ غُرَّ بوَلَد زِنْیَۃ فِی قسمۃ فَأَعْتَقَہُ ، ثُمَّ عُلِمَ بَعْدَ ذَلِکَ ، قَالاَ : جَازَ عِتْقُہُ ، وَیُعْتَقُ مِنْ مَالِ الَّذِی غَرَّہُ ، وَالْوَلاَئُ لَہُ۔","","Musannaf Ibn Abi Shaybah 23603","","","كتاب البيوع والأقضية"
"23604","(۲۳۶۰۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ ہِشَامِ بْنِ حُجَیْرٍ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ : فِی رَجُلٍ کَانَ یُسَاوِمُ رَجُلاً بشیء فجاء رجل آخَرَ یُرِیدُ أَنْ یُسَاوِمَہُ ، فَنَہَرَہُ الرَّجُلُ الْمُسَاوِمُ ، فَرَأَی عُمَرُ بْنُ الْخَطَّابِ أَنَّہَا شَرِکَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 23604","","","كتاب البيوع والأقضية"
"23605","(۲۳۶۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ : أَنَّ رَجُلاً بَاعَ عَبْدًا لَہُ بِقُصَاصِ شَعْرِہِ کَیَّۃٌ ، فَخَاصَمَہُ إلَی شُرَیْحٍ فَقَالَ : کَتَمْتَ الشَّیْنَ وَوَارَیْتَہُ ، فَلَمْ یُجْزِہِ وَرَدَّہُ۔","","Musannaf Ibn Abi Shaybah 23605","","","كتاب البيوع والأقضية"
"23606","(۲۳۶۰۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ : سَأَلْتُ عَطَائً : أَشْتَرِی بِأَلْفِ دِرْہَمٍ فَأَقُولُ قَبْلَ عَقْدِہِ : أَجْعَلُہَا مِئَۃ دِینَارٍ؟ قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23606","","","كتاب البيوع والأقضية"
"23607","(۲۳۶۰۷) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ غَشَّنَا فَلَیْسَ مِنَّا۔ (مسلم ۱۶۴۔ ابوداؤد ۳۴۴۶)","Hasan","Musannaf Ibn Abi Shaybah 23607","","","كتاب البيوع والأقضية"
"23608","(۲۳۶۰۸) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، أَنَّہُمَا قَالاَ : الْغِشُّ حَرَامٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 23608","","","كتاب البيوع والأقضية"
"23609","(۲۳۶۰۹) حَدَّثَنَا الأَسْوَدُ بْنُ عَامِرٍ، قَالَ: حدَّثَنَا شَرِیکٌ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی، عَنْ جُمَیْعِ بْنِ عُمَیْرٍ، عَنْ عَامِرٍ، عَنْ أَبِی بُرْدَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لَیْسَ مِنَّا مَنْ غَشَّنَا۔ (بخاری ۲۸۱۷۔ احمد ۳/۴۵)","Da'if","Musannaf Ibn Abi Shaybah 23609","","","كتاب البيوع والأقضية"
"23610","(۲۳۶۱۰) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَأْمُرُ أَہْلَ الْمُضَارَبَۃِ أَنْ یَجْعَلُوا بَیْنَہُمْ شَہْرًا مَعْلُومًا یَحْتَسِبُونَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 23610","","","كتاب البيوع والأقضية"
"23611","(۲۳۶۱۱) حَدَّثَنَا عَلِیٌّ ، عَنْ حَفْصٍ ، عَنْ مُحَمَّدِ بْنِ طَلْحَۃَ ، قَالَ : إذَا اخْتَلَفَت الشُّہُودُ فِی الْکَلاَمِ وَکَانَ الأَصْلُ وَاحِدًا : فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23611","","","كتاب البيوع والأقضية"
"23612","(۲۳۶۱۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدۃَ ، عَنْ سِمَاکٍ ، عَنْ حَنَشٍ ، عَنْ عَلِیٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا تَقَاضَی إلَیْک رَجُلاَنِ فَلاَ تَسْمَعْ مَا یَقُولُ الأَوَّلُ ، حَتَّی تَسْمَعَ مَا یَقُولُ الآخَرُ ، فَإِنَّک سَوْفَ تَرَی کَیْفَ تَقْضِی۔n قَالَ عَلِیٌّ : فَمَا زِلْت بَعْدَہَا قَاضِیًا۔ (ترمذی ۱۳۳۱۔ ابوداؤد ۳۵۷۷)","Da'if","Musannaf Ibn Abi Shaybah 23612","","","كتاب البيوع والأقضية"
"23613","(۲۳۶۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ وَعَامِرٍ ، أَنَّہُمَا قَالاَ : لاَ تُقْبَلُ مِنْ خَصْمٍ خُصُومَۃٌ حَتَّی یَحْضُرَ خَصْمُہُ۔","","Musannaf Ibn Abi Shaybah 23613","","","كتاب البيوع والأقضية"
"23614","(۲۳۶۱۴) حَدَّثَنَا عُبَیْدُ اللہ قَالَ : حَدَّثَنَا حسن ، عن لیث ، عن مجاہد ، قَالَ : یأخذ الرجل من مال ولدہ ما شاء إلا الفرج۔","","Musannaf Ibn Abi Shaybah 23614","","","كتاب البيوع والأقضية"
"23615","(۲۳۶۱۵) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : حدَّثَنَا حَسَنٌ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23615","","","كتاب البيوع والأقضية"
"23616","(۲۳۶۱۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِلْحَسَنِ : الرَّجُلُ یَأْخُذُ جَارِیَۃَ ابْنِہِ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 23616","","","كتاب البيوع والأقضية"
"23617","(۲۳۶۱۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْوَالِدُ فِی حِلٍّ مِنْ مَالِ وَلَدِہِ إلاَّ الْفَرْجَ۔","","Musannaf Ibn Abi Shaybah 23617","","","كتاب البيوع والأقضية"
"23618","(۲۳۶۱۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ ، قَالَ : کَانَ یَقُولُ : أَصْحَابُ الدُّورِ أَحَقُّ بِأَفْنِیَۃِ دُورِہِمْ ، وَأَصْحَابُ الأَرْضِیْنَ أَحَقُّ بِنُقُوضِ أَرْضِیہِمْ۔","","Musannaf Ibn Abi Shaybah 23618","","","كتاب البيوع والأقضية"
"23619","(۲۳۶۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ : مَنْ غَلَبَ الْمَائُ عَلَی شَیْئٍ ، فَہُوَ لَہُ۔","","Musannaf Ibn Abi Shaybah 23619","","","كتاب البيوع والأقضية"
"23620","(۲۳۶۲۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُمَر مَوْلَی غُفْرَۃَ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ ، عَنْ رَجُلَیْنِ اشْتَرَکَا، فَنقد أَحَدُہُمَا عَنْ صَاحِبِ الثمن کُلَّہ ، فَقَدِمَا الْمَدِینَۃَ فَبَاعَا طَائِفَۃً مِنَ الْبُرِّ فَرَبِحَا وَبَقِیَتْ طَائِفَۃٌ ، فَقَالَ الَّذی نَقدَ الْمَالَ لِصَاحِبِہِ : إِنْ شِئْتَ أَنْ تَنْقُدَ مَا بَقِیَ وَأَنْتَ عَلَی شَرِکَتِکَ ، وَإِنْ شِئْتَ خَرَجْت مِنْہُ وَمِنْ رِبْحِہِ وَأَبْرَأْتُک؟ فَقَالَ : لاَ یَحِلُّ ہَذَا۔n وَسَأَلْت الْقَاسِمَ فَقَالَ : مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23620","","","كتاب البيوع والأقضية"
"23621","(۲۳۶۲۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ سَلْمِ بْنِ أَبِی الذَّیَّالِ، قَالَ: سَأَلْتُ الْحَسَنَ عَنْ رَجُلَیْنِ اشْتَرَیَا مَتَاعًا فَبَاعَاہُ بِرِبْحٍ بِنَقْدٍ وَنَسِیئَۃٍ؟ فَقَالَ أَحَدُہُمَا لِصَاحِبِہِ: اُنْقُدْنِی رَأْسَ مَالِی، فَمَا بَقِیَ فَہُوَ لَکَ، قَالَ: فَکَرِہَ الْحَسَنُ۔","","Musannaf Ibn Abi Shaybah 23621","","","كتاب البيوع والأقضية"
"23622","(۲۳۶۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنِ ابْنِ سِیرِینَ : فِی الرَّجُلِ یُقْضَی مِنَ الْقِمَارِ ، قَالَ : لاَ بَأْسَ۔ وَقَالَ الْحَسَنُ فِی الرَّجُلِ یَقْضِی مِنَ الرِّبَا : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 23622","","","كتاب البيوع والأقضية"
"23623","(۲۳۶۲۳) حَدَّثَنَا قَبِیصَۃُ ، قَالَ : حدَّثَنَا ہَارُونُ الْبَرْبَرِیُّ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنْ رَجُلٍ دَفَعَ إلَی رَجُلٍ مَالاً مُضَارَبَۃً وَأَشْہَدَ عَلَیْہِ بِہِ ، فَجَائَ الرَّجُلُ یُرِیدُ أَنْ یَأْخُذَ مِنْہُ مَالَہُ ، فَقَالَ : قَدْ دَفَعْتہ إلَیْک ، فَقَالَ الْحَکَمُ : عَلَیْہِ الْبَیِّنَۃُ أَنَّہُ دَفَعَہُ إلَیْہِ کَمَا أَشْہَدَ عَلَیْہِ ، وَقَالَ حَمَّادٌ : یُصَدَّقُ فِیہِ کَمَا یُصَدَّقُ فِی مِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 23623","","","كتاب البيوع والأقضية"
"23624","(۲۳۶۲۴) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، عَنْ شُرَیْحٍ ، قَالَ: یَجُوزُ إقْرَارُ الْعَبْدِ فِیمَا اسْتَنْجَزَہُ فِیہِ أَہْلُہُ۔","","Musannaf Ibn Abi Shaybah 23624","","","كتاب البيوع والأقضية"
"23625","(۲۳۶۲۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ یُجِیزُ قَوْلَ الْعَبْدِ فِیمَا أَذِنَ لَہُ فِیہِ أَہْلُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23625","","","كتاب البيوع والأقضية"
"23626","(۲۳۶۲۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ، عَنْ عَمْرِو بْنِ دِینَارٍ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ: أَنَّہُ سُئِلَ عَنْ رَجُلٍ لَہُ عَلَی رَجُلٍ کُرٌّ مِنْ بُرٍّ؟ فَقَالَ : ہَذَا کُرٌّ قَدْ کِلْتُہُ ، أَیَأْخُذُہُ بِکَیْلِہِ ؟ قَالَ : إِنْ شَائَ أَخَذَہُ بِکَیْلِہِ۔","","Musannaf Ibn Abi Shaybah 23626","","","كتاب البيوع والأقضية"
"23627","(۲۳۶۲۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنْ مَکْحُولٍ : فِی رَجُلٍ قَالَ لِرَجُلٍ : غُلاَمِی لَکَ مَا حَیِیتُ ، فَإِذَا مِتُّ فَہُوَ حُرٌّ ، قَالَ : جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 23627","","","كتاب البيوع والأقضية"
"23628","(۲۳۶۲۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : فِی رَجُلٍ اشْتَرَی مِنْ رَجُلٍ أکرارًا مِنْ طَعَامٍ وَنَقَدَہُ ، ثُمَّ ذَہَبَ لِیَکْتَالَ الطَّعَامَ فَلَمْ یَفِ ، قَالَ : لِیَرُدَّ عَلَیْہِ صَاحِبُ الطَّعَامِ ثَمَنَ مَا بَقِیَ عَلَی حِصَّۃِ مَا اشْتَرَی ، قَالَ : وَکَانَ مُحَمَّدٌ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 23628","","","كتاب البيوع والأقضية"
"23629","(۲۳۶۲۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجِ بْنِ أَرْطَاۃَ ، عَنْ أَبِی جَعْفَرٍ الْبَجَلِیِّ ، قَالَ : دَخَلَ رَجُلٌ الْحَمَّامَ فَأَعْطَاہُ أَجْرًا عَلَی دُخُولِ الْحَمَّامِ ، قَالَ: وَأَعْطَاہُ ثِیَابَہُ یُمْسِکُہَا ، قَالَ: فَضَاعَتِ الثِّیَابُ ،قَالَ: فَخَاصَمَہُ إلَی شُرَیْحٍ، قَالَ : فَقَالَ شُرَیْحٌ : أَعْطَیْت عَلَی إمْسَاکِ الثِّیَابِ ؟ قَالَ : لاَ ، وَلَکِنْ أَعْطَیْتہ عَلَی دُخُولِ الْحَمَّامِ ، فَقَالَ لَہُ شُرَیْحٌ : قُمْ فَلاَ شَیْئَ لَک۔","","Musannaf Ibn Abi Shaybah 23629","","","كتاب البيوع والأقضية"
"23630","(۲۳۶۳۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَقُولُ : إِنْ عَمِلْت کَذَا فَبِکَذَا ، وَإِنْ عَمِلْت کَذَا فَبِکَذَا ، قَالَ : لاَ بَأْسَ بِہِ فِی الإِجَارَۃِ۔","","Musannaf Ibn Abi Shaybah 23630","","","كتاب البيوع والأقضية"
"23631","(۲۳۶۳۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ مُجَاہِدٍ : أَنَّ رَجُلاً بَعَثَ إلَی عَائِشَۃَ بِصُرَّۃٍ مِنْ دَنَانِیرَ عَلَیْہَا لِعَائِشَۃَ أُمِّ الْمُؤْمِنِینَ ، فَلَمَّا انْتَہَی الْقَوْمُ قَریبًا مِنَ الْمَدِینَۃِ أَصَابَتْہُمْ سَمَائٌ ، فَضَاعَتِ الصُّرَّۃُ ، فَمَضَی الْقَوْمُ فَأَتَوُا الْمَدِینَۃَ ، فَنَظَرَ الرَّجُلُ فِی الْکِتَابِ ، ثُمَّ جَعَلَ مِثْلَ الدَّنَانِیرِ وَکَتَبَ عَلَیْہَا ، ثُمَّ جَائَ بِالْکِتَابِ وَالصُّرَّۃِ إلَی عَائِشَۃَ ، وَمَرَّ قَوْمٌ بِذَلِکَ الْمَنْزِلِ ، فَوَجَدُوا الصُّرَّۃَ مَکْتُوبًا عَلَیْہَا ، فَجَاؤُوا بِہَا إلَی عَائِشَۃَ ، فَأَرْسَلَتْ بِذَلِکَ إلَی صَاحِبِ الدَّنَانِیرِ الأُولَی ، فَقَالَتْ لَہُ : أَخْبِرْنِی خَبَرَ الدَّنَانِیرِ ، فَقَالَ لَہَا : الْخَبَرُ فِی الْکِتَابِ ، فَقَالَتْ : اُصْدُقْنِی ، فَأَخْبَرَہَا الْخَبَرَ ، قَالَتْ : قَدْ أَرَدْت أَنْ تُطْعِمَنِی مَا لاَ یَحِلُّ لِی۔","Da'if","Musannaf Ibn Abi Shaybah 23631","","","كتاب البيوع والأقضية"
"23632","(۲۳۶۳۲) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : فِی رَجُلٍ اشْتَرَی مِنْ رَجُلٍ سِلْعَۃً ، قَالَ : إِنْ لَمْ آتِکَ بِالثَّمَنِ إلَی کَذَا وَکَذَا ، قَالَ لَیْسَ بِبَیْعٍ۔","","Musannaf Ibn Abi Shaybah 23632","","","كتاب البيوع والأقضية"
"23633","(۲۳۶۳۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی سُلَیْمَانُ مَوْلَی الْبَرْصَائِ ، قَالَ : بِعْت مِنِ ابْنِ عُمَرَ سِلْعَۃً أَوْ بَیْعًا ، فَقَالَ : إِنْ جَائَتْ نَفَقَتُنَا إلَی ثَلاَثٍ فَالسِّلْعَۃُ لَنَا ، وَإِنْ لَمْ تَأْتِنَا نَفَقَتُنَا إلَی ثَلاَثٍ فَلاَ بَیْعَ بَیْنَنَا وَبَیْنَکَ ، فَسَنَسْتَقْبِلُ فِیہَا بَیْعًا مُسْتَقْبَلاً۔","Da'if","Musannaf Ibn Abi Shaybah 23633","","","كتاب البيوع والأقضية"
"23634","(۲۳۶۳۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ مِنْ أَصْلِ قَوْلِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِمَنٍّ مِنْ صُفْرٍ صَحِیحٍ بِمَنَوَیْنِ مِنْ صُفْرٍ مَکْسُورٍ ، وَسُئِلَ عَنْ سِکِّینٍ بِسِکِّینَیْنِ ؟ فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 23634","","","كتاب البيوع والأقضية"
"23635","(۲۳۶۳۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَتِ الدِّرْعُ تُبَاعُ بِالأَدْرَاعِ۔","","Musannaf Ibn Abi Shaybah 23635","","","كتاب البيوع والأقضية"
"23636","(۲۳۶۳۶) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو ، قَالَ : أَخْبَرَنَا أَبُو عَوَانَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ : فِی الرَّجُلِ یَکُونُ لَہُ الشَّاہِدُ مَعَ یَمِینِہِ ، قَالَ : لاَ تَجُوزُ إلاَّ شَہَادَۃُ رَجُلَیْنِ ، أَوْ رَجُلٍ وَامْرَأَتَیْنِ۔n قَالَ عَامِرٌ : مَعَ أنَّ أَہْلَ الْمَدِینَۃِ یَقُولُونَ : شَہَادَۃُ الشَّاہِدَیْنِ مَعَ یَمِینِ الطَّالِبِ۔","","Musannaf Ibn Abi Shaybah 23636","","","كتاب البيوع والأقضية"
"23637","(۲۳۶۳۷) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ ، قَالَ: ہِیَ بِدْعَۃٌ ، وَأَوَّلُ مَنْ قَضَی بِہَا مُعَاوِیَۃُ۔","","Musannaf Ibn Abi Shaybah 23637","","","كتاب البيوع والأقضية"
"23638","(۲۳۶۳۸) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ جَہْمِ بْنِ أَبِی الْجَہْمِ ، قَالَ : حدَّثَنِی مَنْ سَمِعَ عَبْدَ اللہِ بْنَ جَعْفَرٍ یُحَدِّثُ : أَنَّ عَلِیًّا کَانَ لاَ یَحْضُرُ الْخُصُومَۃَ ، وَکَانَ یَقُولُ : إنَّ لَہَا قُحَمًا یَحْضُرُہَا الشَّیْطَانُ ، فَجَعَلَ خُصُومَتَہُ إلَی عَقِیلٍ ، فَلَمَّا کَبِرَ وَرَقَّ حَوَّلَہَا إلَیَّ ، فَکَانَ عَلِیٌّ یَقُولُ : مَا قُضِیَ لِوَکِیلِی فَلِی ، وَمَا قُضِیَ عَلَی وَکِیلِی فَعَلَیَّ۔","Da'if","Musannaf Ibn Abi Shaybah 23638","","","كتاب البيوع والأقضية"
"23639","(۲۳۶۳۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ ، عُہْدَۃُ الْمُسْلِمِ وَإِنْ لَمْ یَشْتَرِطْ : لاَ دَائَ ، وَلاَ غَائِلَۃَ ، وَلاَ خِبْثَ ، وَلاَ شَیْنَ۔","","Musannaf Ibn Abi Shaybah 23639","","","كتاب البيوع والأقضية"
"23640","(۲۳۶۴۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَاصِمٍ ، قَالَ : قَالَ رَجُلٌ لِعَامِرٍ : ابْتَعْت فَرَسًا وَنَقَدْت ثَمَنَہُ وَشَارَکْت فِیہِ رَجُلاً ، فَنَفَقَ الْفَرَسُ ، قَالَ : احْتَسِبْ فَرَسَک۔","","Musannaf Ibn Abi Shaybah 23640","","","كتاب البيوع والأقضية"
"23641","(۲۳۶۴۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ الْمُحَارِبِیُّ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ مَشَی إلَی رَجُلٍ بِحَقِّہِ لِیَقْضِیَہُ کُتِبَتْ لَہُ بِکُلِّ خُطْوَۃٍ حَسَنَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 23641","","","كتاب البيوع والأقضية"
"23642","(۲۳۶۴۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ : أَنَّ الْحُسَیْنَ بْنَ عَلِیٍّ مَرَّ بِرَاعٍ یَرْعَی ، فَأَتَاہُ بِشَاۃٍ فَأَہْدَاہَا لَہُ ، فَقَالَ لَہُ : حُرٌّ أَنْتَ أَمْ مَمْلُوکٌ ؟ فَقَالَ : مَمْلُوکٌ ، فَرَدَّہَا عَلَیْہِ ، فَقَالَ : إِنَّہَا لِی ، فَقَبِلہَا مِنْہُ ، ثُمَّ اشْتَرَاہُ وَاشْتَرَی الْغَنَمَ ، وَأَعْتَقَہُ وَجَعَلَ الْغَنَمَ لَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 23642","","","كتاب البيوع والأقضية"
"23643","(۲۳۶۴۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ إذَا اتَّہَمَ الشَّاہِدَ لَمْ یَسْأَلْہُ حَتَّی یُقَوَّمَ۔","","Musannaf Ibn Abi Shaybah 23643","","","كتاب البيوع والأقضية"
"23644","(۲۳۶۴۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سَیَّارٍ ، عَنِ الشَّعْبِیِّ : أَنَّ رَجُلاً خَرَقَ فَرْوَ رَجُلٍ ، فَاخْتَصَمَا إلَی شُرَیْحٍ فَقَالَ : رُقْعَۃٌ مَکَانَ رُقْعَۃٍ۔","","Musannaf Ibn Abi Shaybah 23644","","","كتاب البيوع والأقضية"
"23645","(۲۳۶۴۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، عنْ مَسْرُوقٍ : فِی الرَّجُلِ یَخْرِقُ الْفَرْوَ ، قَالَ : لَیْسَ عَلَیْہِ إلاَّ أَنْ یَرْقعَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23645","","","كتاب البيوع والأقضية"
"23646","(۲۳۶۴۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، قَالَ : أَخْبَرَنِی حُسَیْنُ بْنُ وَاقِدٍ ، قَالَ : حَدَّثَنِی عُثْمَانُ أَبُو الْمُنَازِلِ ابْنُ أَخِی شُرَیْحٍ ، عَنْ شُرَیْحٍ : أَنَّہُ کَانَ لاَ یُجِیزُ شَہَادَۃَ صَاحِبِ حَمَامٍ ، وَلاَ صَاحِبِ الْحَمَّامِ۔","","Musannaf Ibn Abi Shaybah 23646","","","كتاب البيوع والأقضية"
"23647","(۲۳۶۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی الْمُہَزِّمِ ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّہُ کَانَ لاَ یُجِیزُ شَہَادَۃَ أَصْحَابِ الْخُمُرِ۔","Da'if","Musannaf Ibn Abi Shaybah 23647","","","كتاب البيوع والأقضية"
"23648","(۲۳۶۴۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ أَبِی حَیَّانَ، عَنْ أَبِیہِ، عَنْ شُرَیْحٍ، قَالَ: لَمْ یَکُنْ لَہُ مِثْعَبٌ إلاَّ فِی جَوْفِ دَارِہِ۔","","Musannaf Ibn Abi Shaybah 23648","","","كتاب البيوع والأقضية"
"23649","(۲۳۶۴۹) حَدَّثَنَا ہُشَیْمٌ، عَنْ یُونُسَ، عَنِ الْحَسَنِ، قَالَ: إذَا بِیعَ نَصِیبٌ مُسَمًّی مِنْ دَارِہِ جَازَ، فَإِنْ لَمْ یَکُنْ مُسَمًّی لَمْ یَجُزْ۔","","Musannaf Ibn Abi Shaybah 23649","","","كتاب البيوع والأقضية"
"23650","(۲۳۶۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عُبَیْدَۃَ وَمُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 23650","","","كتاب البيوع والأقضية"
"23651","(۲۳۶۵۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ الصَّعْبِ بْنِ جَثَّامَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ حِمَی إلاَّ لِلَّہِ وَرَسُولِہِ۔ (بخاری ۳۰۱۲۔ ابن حبان ۱۳۶)","Sahih","Musannaf Ibn Abi Shaybah 23651","","","كتاب البيوع والأقضية"
"23652","(۲۳۶۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ مَنْعِ فَضْلِ الْمَائِ لِیَمْنَعَ بِہِ فَضْلَ الْکَلاَ۔","Sahih","Musannaf Ibn Abi Shaybah 23652","","","كتاب البيوع والأقضية"
"23653","(۲۳۶۵۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوسٍ : أَنَّ أَبَاہُ کَانَ یَکْرَہُ بَیْعَ الْکَلاَ فِی مَنْبَتِہِ۔","","Musannaf Ibn Abi Shaybah 23653","","","كتاب البيوع والأقضية"
"23654","(۲۳۶۵۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : أَنَّ عُمَرَ حَمَی الرَّبَذَۃَ لِنَعَمِ الصَّدَقَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 23654","","","كتاب البيوع والأقضية"
"23655","(۲۳۶۵۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ثَوْرٌ الشَّامِیُّ ، عَنْ حَرِیزِ بْنِ عُثْمَانَ ، عَنْ أَبِی خِدَاشٍ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْمُسْلِمُونَ شُرَکَائُ فِی ثَلاَثٍ : الْکَلاَ وَالْمَائُ وَالنَّارُ۔ (ابوداؤد ۳۴۷۲۔ احمد ۵/۳۶۴)","Sahih","Musannaf Ibn Abi Shaybah 23655","","","كتاب البيوع والأقضية"
"23656","(۲۳۶۵۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحَلَّ الْعُرْبَانَ فِی الْبَیْعِ۔","","Musannaf Ibn Abi Shaybah 23656","","","كتاب البيوع والأقضية"
"23657","(۲۳۶۵۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ سَعِیدِ بْنِ المُسَیَّب ، قَالَ : لاَ عُرْبُونَ فِی وَدَکٍ ، وَلاَ عَلَفٍ ، وَلاَ طَعَامٍ ، وَالعُرْبُونَ فِی غَیْرِہِنَّ۔","","Musannaf Ibn Abi Shaybah 23657","","","كتاب البيوع والأقضية"
"23658","(۲۳۶۵۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ لاَ یَرَی بِالْعُرْبُونِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 23658","","","كتاب البيوع والأقضية"
"23659","(۲۳۶۵۹) حَدَّثَنَا یَزِیدُ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُعْطِیَ الرَّجُلُ الْعُرْبُونَ الْمَلاَحَ ، أَوْ غَیْرَہُ فَیَقُولُ : إِنْ جِئْت بِہِ إلَی کَذَا وَکَذَا وَإِلأَفَہُوَ لَک۔","","Musannaf Ibn Abi Shaybah 23659","","","كتاب البيوع والأقضية"
"23660","(۲۳۶۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنِ ابْنِ أَبِی ذِئْبٍ، عَنِ الزُّہْرِیِّ، عَنْ حَمْزَۃَ بْنِ عَبْدِاللہِ بْنِ عُمَرَ بْنِ الْخَطَّابِ، قَالَ : کُنَّا نَتَبَایَعُ الثِّیَابِ بَیْنَ یَدَیْ عَبْدِ اللہِ بْنِ عُمَرَ : مَنِ افْتَدَی افْتَدَی بِدِرْہَمٍ ، فَلاَ یَأْمُرُنَا وَلاَ یَنْہَانَا۔","Sahih","Musannaf Ibn Abi Shaybah 23660","","","كتاب البيوع والأقضية"
"23661","(۲۳۶۶۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ مُحَمَّدِ بْنِ أَسْلَمَ: أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحَلَّ الْعُرْبَانَ فِی الْبَیْعِ۔","Da'if","Musannaf Ibn Abi Shaybah 23661","","","كتاب البيوع والأقضية"
"23662","(۲۳۶۶۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَمْرٍو، عَنْ عَبْدِالرَّحْمَنِ بْنِ فَرُّوخَ: أَنَّ نَافِعَ بْنَ عَبْدِالْحَارِثِ اشْتَرَی دَار السَّجْنِ مِنْ صَفْوَانَ بْنِ أُمَیَّۃَ بِأَرْبَعَۃِ آلاَفِ دِرْہَمٍ ، فَإِنْ رَضِیَ عُمَرُ فَالْبَیْعُ لَہُ ، وَإِنْ عُمَرَ لَمْ یَرْضَ فَأَرْبَعُمِئَۃٍ لِصَفْوَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 23662","","","كتاب البيوع والأقضية"
"23663","(۲۳۶۶۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا ہِشَامٌ ، وَابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَقُولُ فِی الرَّجُلِ یَسْتَأْجِرُ الدَّارَ وَالسَّفِینَۃَ فَیَقُولُ : إِنْ جِئْتک إلَی کَذَا وَکَذَا وَإِلأَفَہُوَ لَکَ ، قَالَ : فَإِنْ لَمْ یَجِئْہُ فَہُوَ لَہُ۔","","Musannaf Ibn Abi Shaybah 23663","","","كتاب البيوع والأقضية"
"23664","(۲۳۶۶۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ۔ وَعَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ : أَنَّہُمَا کَرِہَا الْعُرْبَانَ فِی الْبَیْعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23664","","","كتاب البيوع والأقضية"
"23665","(۲۳۶۶۵) حَدَّثَنَا زَیْد بْن الْحُبَابِ ، عَنْ مُوسَی بْنِ عُلَیٍّ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ عَنْ مَرْکَبٍ لِلْعَدُوِّ أَلْقَتْہُ الرِّیحُ إلَی قَوْمٍ ؟ قَالَ : ہُوَ لِمَنْ غَنِمَہُ ، وَفِیہِ الْخَمْسُ۔","","Musannaf Ibn Abi Shaybah 23665","","","كتاب البيوع والأقضية"
"23666","(۲۳۶۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سُئِلَ الْحَسَنُ عَنِ السَّفِینَۃِ تَغْرَقُ فِی الْبَحْرِ ، فِیہَا مَتَاعُ لِقَوْمِ سَبْی؟ قَالَ : مَا أَلْقَی الْبَحْرُ عَلَی سَاحِلِہِ فَہُوَ لِصَاحِبِہِ ، وَمَنْ غَاصَ عَلَی شَیْئٍ فَاسْتَخْرَجَہُ فَہُوَ لَہُ۔","","Musannaf Ibn Abi Shaybah 23666","","","كتاب البيوع والأقضية"
"23667","(۲۳۶۶۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ : فِی الْبَحْرِ یَطْرَحُ الْمَتَاعَ ، قَالَ: ہُوَ بِمَنْزِلَۃِ اللُّقَطَۃِ ، تُعَرَّفُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23667","","","كتاب البيوع والأقضية"
"23668","(۲۳۶۶۸) حَدَّثَنَا شَرِیکٌ، عَنْ غَالِبٍ أَبِی الْہُذَیْلِ، عَنْ کُلَیْبٍ الْجَرْمِیِّ: أَنَّہُ شَہِدَ عَلِیًّا یَنْہَی الْقَصَّابِینَ، عَنِ النَّفْخِ۔ یَعْنِی: فِی اللَّحْمِ۔","Hasan","Musannaf Ibn Abi Shaybah 23668","","","كتاب البيوع والأقضية"
"23669","(۲۳۶۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنِ الأَحْوَص بْنِ حَکِیمٍ ، عَنْ رَاشِدِ بْنِ سَعْدٍ ، قَالَ: نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ النَّفْخِ فِی اللَّحْمِ لِلْبَیْعِ۔","Da'if","Musannaf Ibn Abi Shaybah 23669","","","كتاب البيوع والأقضية"
"23670","(۲۳۶۷۰) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ لَمْ یَکُنْ یَکْرَہُ الْمُصْحَفَ بِالْمُصْحَفِ مُبَادَلَۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 23670","","","كتاب البيوع والأقضية"
"23671","(۲۳۶۷۱) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: لاَ بَأْسَ بِالْبَدَلِ مُصْحَفٌ بِمُصْحَفٍ۔","","Musannaf Ibn Abi Shaybah 23671","","","كتاب البيوع والأقضية"
"23672","(۲۳۶۷۲) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِالْمُصْحَفِ بِالْمُصْحَفِ وَبَیْنَہُمَا عَشَرَۃُ دَرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 23672","","","كتاب البيوع والأقضية"
"23673","(۲۳۶۷۳) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إبْر??اہِیمَ ، قَالَ : لاَ یُقَسَّمُ الْمُصْحَفُ فِی الْمِیرَاثِ ، یَکُونُ لِقُرَّائِ أَہْلِ الْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 23673","","","كتاب البيوع والأقضية"
"23674","(۲۳۶۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ عُمَرُ : مَنْ تَجَرَ فِی شَیْئٍ ثَلاَثَ مَرَّاتٍ فَلَمْ یُصِبْ فِیہِ فَلْیَتَحَوَّلْ مِنْہُ إلَی غَیْرِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 23674","","","كتاب البيوع والأقضية"
"23675","(۲۳۶۷۵) حَدَّثَنَا حَفْصٌ ، عَنْ مُوسَی بْنِ عُمَیْرٍ ، قَالَ : سَأَلْتُ الْحَکَمَ عْن رَجُلٍ اشْتَرَی جَارِیَۃً ثُمَّ وَطِئَہَا ، أَیَبِیعُہَا مُرَابَحَۃً ؟ قَالَ : لاَ ، حَتَّی یُبَیِّنَ۔","","Musannaf Ibn Abi Shaybah 23675","","","كتاب البيوع والأقضية"
"23676","(۲۳۶۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ خَالِدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ شُرَیْحٌ یُسَلِّمُ عَلَی الْخُصُومِ۔","","Musannaf Ibn Abi Shaybah 23676","","","كتاب البيوع والأقضية"
"23677","(۲۳۶۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَمَّنْ سَمِعَ ابْنَ سِیرِینَ یَکْرَہُ إذَا وَرِثَ أَحَدُ الْمُتَفَاوِضَیْنِ شَیْئًا أَنْ یُشْرِکَہُ فِیہِ صَاحِبَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23677","","","كتاب البيوع والأقضية"
"23678","(۲۳۶۷۸) حَدَّثَنَا عَبْدَۃُ ، عن سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَشْتَرِیَ الرَّجُلُ سِہَامَ الْقَصَّابِینَ قَبْلَ أَنْ تُقَسَّمَ۔","","Musannaf Ibn Abi Shaybah 23678","","","كتاب البيوع والأقضية"
"23679","(۲۳۶۷۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یَشْتَرِی الْمَمْلُوکَ عَلَی أَنْ یُعْتِقَہُ فَلاَ یَفْعَلُ ؟ قَالَ : إِنْ أَعْتَقَہُ وَإِلاَّ رَدَّہُ۔","","Musannaf Ibn Abi Shaybah 23679","","","كتاب البيوع والأقضية"
"23680","(۲۳۶۸۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ عَوْنٍ، عَنِ ابْنِ سِیرِینَ: أَنَّ عُمَرَ أَجَازَ شَہَادَۃَ عَلْقَمَۃَ الْخَصِیِّ عَلَی ابْنِ مَظْعُونٍ۔","","Musannaf Ibn Abi Shaybah 23680","","","كتاب البيوع والأقضية"
"23681","(۲۳۶۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یَنْبَغِی أَنْ یَبِیعَ بِدَیْنٍ وَیَشْتَرِیَ بِہِ ، وَلاَ یَبِیعَ بِنَقْدٍ وَیَشْتَرِیَ بِدَیْنٍ ، وَلاَ بَأْسَ أَنْ یَبِیعَ بِدَیْنٍ وَیَشْتَرِیَ بِنَقْدٍ۔","","Musannaf Ibn Abi Shaybah 23681","","","كتاب البيوع والأقضية"
"23682","(۲۳۶۸۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ : أَنَّ مُوَرِّقًا الْعِجْلِیّ کَانَ یَمُرُّ عَلَی الْعَاشِرِ فَیَسْتَطْعِمُہُ۔","","Musannaf Ibn Abi Shaybah 23682","","","كتاب البيوع والأقضية"
"23683","(۲۳۶۸۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ ، قَالَ : کَانَ الْحَسَنُ یَکْرَہُ أَنْ یَسْتَطْعِمَہُ ، وَلاَ یَرَی بَأْسًا إِنْ أَطْعَمَہُ أَنْ یَأْکُلَ۔","","Musannaf Ibn Abi Shaybah 23683","","","كتاب البيوع والأقضية"
"23684","(۲۳۶۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، قَالَ : أَتَیْنَا سَعِیدَ بْنَ جُبَیْرٍ فِی أَسْفَلِ الْفُرَاتِ فَأَرْسَلَ إلَی صَاحِبِ الْقَنْطَرَۃِ الْعَشَّارِینَ : إِنْ کَانَ عِنْدَکُمْ شَیْئٌ فَأَطْعِمُونَا ، فَأَطْعَمُونَا ، فَأَکَلَ مَعَنَا۔","","Musannaf Ibn Abi Shaybah 23684","","","كتاب البيوع والأقضية"
"23685","(۲۳۶۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ : أَنَّ رَجُلاً کَسَرَ طُنْبُورًا لرَجُلٍ ، فَخَاصَمَہُ إلَی شُرَیْحٍ ، فَلَمْ یُضَمِّنْہُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 23685","","","كتاب البيوع والأقضية"
"23686","(۲۳۶۸۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ عُثْمَانَ الشَّحَّامِ، عَنِ ابْنِ سِیرِینَ: أَنَّہُ کَانَ یَکْرَہُ وَذَکَرَ عِنْدَہُ أَجْرَ الدَّلاَّلِ۔","","Musannaf Ibn Abi Shaybah 23686","","","كتاب البيوع والأقضية"
"23687","(۲۳۶۸۷) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ یَزِیدَ بْنِ عَطَائٍ ، عَنْ سِمَاکٍ ، عَنْ حَجَّارِ بْنِ أَبْجَرَ : أَنَّ رَجُلاً ، قَالَ لِعَلِیٍّ : ذَہَبَ وَاللَّہِ مَالِی ، فَقَالَ لَہُ عَلِیٌّ : أَنْتَ ضَیَّعْتہ ، أَفَلاَ أَخَذْت مِنْہُ بِمَعْرِفَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 23687","","","كتاب البيوع والأقضية"
"23688","(۲۳۶۸۸) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یَکُونُ لَہُ عَلَی الرَّجُلِ دَرَاہِمُ فَیَأْخُذُہَا وَفِیہَا مسَمْعِیَّۃٌ ، قَالَ : لاَ بَأْسَ بِہِ ، وَإِنْ کَانَتْ فِضَّۃً بَعْدَ أَنْ یَکُونَ وَزْنًا بِوَزْنٍ۔","","Musannaf Ibn Abi Shaybah 23688","","","كتاب البيوع والأقضية"
"23689","(۲۳۶۸۹) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالمسَمْعِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 23689","","","كتاب البيوع والأقضية"
"23690","(۲۳۶۹۰) حَدَّثَنَا عُبَیْدُاللہِ بْنُ مُوسَی، قَالَ: أخْبَرَنَا سُفْیَانُ، عَنْ أَشْعَثَ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ: أَنَّ الضَّحَّاکَ بْنَ قَیْسٍ اخْتَصَمَ إلَیْہِ فِی جَارِیَۃٍ وَجَدَ بِہَا الدُّبَیْلَۃَ وَہُوَ دَائٌ قَدِیمٌ یُعْرَفُ أَنَّہُ لَیْسَ مِمَّا یَحْدُثُ ، فَقَضَی بِہِ عَلَی الْبَائِعِ۔n قَالَ سُفْیَانُ : وَقَوْلُ الضَّحَّاکِ أَحَبُّ إلَیَّ مِنْ قَوْلِ شُرَیْحٍ : إذَا کَانَ یَعْرِفُ أَنَّہُ لَیْسَ مِمَّا یَحْدُثُ أَنْ یَرُدَّ وَیُوجِبُ یَمِینَ الْمُشْتَرِی أَنَّہُ لَمْ یَرَہُ قَبْلَ أَنْ یَشْتَرِیَہُ ، وَلَمْ یَرْضَہُ بَعْدَ مَا رَآہُ۔","","Musannaf Ibn Abi Shaybah 23690","","","كتاب البيوع والأقضية"
"23691","(۲۳۶۹۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ فُضَیْلٍ ، قَالَ : أَعْطَانِی إنْسَانٌ دِینَارًا أَشْتَرِی لَہُ بِہِ بُرًّا ، فَہَلَکَ ، فَقُلْتُ لِلْحَنَّاطِ : کِلْ مَکَانَہُ فَذَکَرْتہ لإِبْرَاہِیمَ فَقَالَ : مَا کَانَ عَلَیْک۔","","Musannaf Ibn Abi Shaybah 23691","","","كتاب البيوع والأقضية"
"23692","(۲۳۶۹۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ عِمْرَانَ الْخَیَّاطِ ، قَالَ : أَعْطَتْنِی امْرَأَۃٌ دَرَاہِمَ أَشْتَرِی لَہَا بِہَا ، فَہَلَکَ مِنْہَا مِثْقَالٌ ، فَذَکَرْتہ لإِبْرَاہِیمَ فَقَالَ : اجْعَلْ مَکَانَہُ۔","","Musannaf Ibn Abi Shaybah 23692","","","كتاب البيوع والأقضية"
"23693","(۲۳۶۹۳) حَدَّثَنَا مُعْتَمِرٌ ، وَأَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ عَلَی الرَّسُولِ ضَمَانٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 23693","","","كتاب البيوع والأقضية"
"23694","(۲۳۶۹۴) حَدَّثَنَا وکیع، عن سفیان، عن جابر، عن القاسم، عن علی وعبد اللہ، قالا: لَیْسَ عَلَی مُؤْتَمَنٍ ضَمَان۔","Da'if","Musannaf Ibn Abi Shaybah 23694","","","كتاب البيوع والأقضية"
"23695","(۲۳۶۹۵) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ عَلَی الْمُؤْتَمَنِ غُرْمٌ إلاَّ أَنْ یُخَالِفَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23695","","","كتاب البيوع والأقضية"
"23696","(۲۳۶۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : یُکْرَہُ أَنْ یَقُولَ الْمُضَارِبُ لِصَاحِبِہِ : أَنَا أَفْضُلُک عِشْرِینَ دِرْہَمًا ، أَوْ ثَلاَثِینَ ، وَلاَ یَرَی بَأْسًا أَنْ یَقُولَ : أَفْضُلُک بِثُلُثٍ ، أَوْ رُبْعٍ ، أَوْ سُدُسٍ۔","","Musannaf Ibn Abi Shaybah 23696","","","كتاب البيوع والأقضية"
"23697","(۲۳۶۹۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَابْنِ سِیرِینَ : أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا أَنْ یَدْفَعَ الرَّجُلُ إلَی الرَّجُلِ مَالاً مُضَارَبَۃً وَیَقُولُ : لَکَ مِنْہَا رِبْحُ أَلْفِ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 23697","","","كتاب البيوع والأقضية"
"23698","(۲۳۶۹۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یَکْرَہُ ذَلِکَ إلاَّ أَنْ یَجْعَلَ لَہُ ثُلُثًا ، أَوْ رُبُعًا ، أَوْ خُمُسًا۔","","Musannaf Ibn Abi Shaybah 23698","","","كتاب البيوع والأقضية"
"23699","(۲۳۶۹۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : رِبْحَ الْمَال مَضْمُونٍ ، قَالَ : فَسَّرَہَا : الرَّجُلُ یَأْخُذُ مِنَ الرَّجُلِ مَالاً مُضَارَبَۃً وَیَقُولُ : أَضْمَنُ لَکَ ، وَلَک نِصْفُ الرِّبْحِ أَوْ ثُلُثُہُ۔","","Musannaf Ibn Abi Shaybah 23699","","","كتاب البيوع والأقضية"
"23700","(۲۳۷۰۰) حَدَّثَنَا أَبُو الأَحْوَص، عَنْ أَبِی إِسْحَاقَ، عَنِ الْعَالِیَۃِ، قَالَت: کُنْت جَالِسَۃً عِنْدَ عَائِشَۃَ فَأَتَتْہَا امْرَأَۃٌ، فَقَالَتْ: یَا أُمَّ الْمُؤْمِنِینَ ، إنِّی وَجَدْت شَاۃً ضَالَّۃً فَکَیْفَ تَأْمُرِینِی أَنْ أَصْنَعَ بِہَا ؟ قَالَتْ : عَرِّفِی وَاعْلِفِی وَاحْلُبِی ، ثُمَّ عَادَتْ فَسَأَلَتْہَا ؟ قَالَتْ : تَأْمُرِینِی أَنْ آمُرَک أَنْ تَبِیعِیہَا أَوْ تَذْبَحِیہَا ؟ فَلَیْسَ ذَلِکَ لَک۔","Hasan","Musannaf Ibn Abi Shaybah 23700","","","كتاب البيوع والأقضية"
"23701","(۲۳۷۰۱) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، قَالَ : کُنْتُ قَاعِدًا عِنْدَ ابْنِ عُمَرَ فَأَتَاہُ رَجُلٌ فَقَالَ : ضَالَّۃً وَجَدْتہَا ، فَقَالَ : أَصْلِحْ إلَیْہَا وَانْشُدْ ، فَقَالَ : فَہَلْ عَلَیَّ إِنْ شَرِبْت مِنْ لَبَنِہَا ؟ قَالَ ابْنُ عُمَرَ : مَا أَرَی عَلَیْک فِی ذَلِکَ شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 23701","","","كتاب البيوع والأقضية"
"23702","(۲۳۷۰۲) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّ رَجُلاً ، قَالَ لَہُ : وَجَدْت جَمَلاً ضَالاَّ ، أَدَعُہُ یَضْرِبُ فِی إبِلِی ؟ قَالَ : لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23702","","","كتاب البيوع والأقضية"
"23703","(۲۳۷۰۳) حَدَّثَنَا جریر ، عن مغیرۃ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ ربح لمال مضمون۔ قَالَ تفسیر ہَذا : الرجل یأخذ من الرجل مالاً مضاربۃ ، ویقول : أضمن لک ، ولک نصف الربح ، أو ثلثہ۔","","Musannaf Ibn Abi Shaybah 23703","","","كتاب البيوع والأقضية"
"23704","(۲۳۷۰۴) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : فِی الرَّجُلِ یَشْتَرِی السِّلْعَۃَ فَیَرَی بِہَا الْعَیْبَ ، ثُمَّ یَعْرِضُہَا عَلَی الْبَیْعِ : لَیْسَ لَہُ أَنْ یَرُدَّہَا۔","","Musannaf Ibn Abi Shaybah 23704","","","كتاب البيوع والأقضية"
"23705","(۲۳۷۰۵) حَدَّثَنَا شَرِیکٌ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23705","","","كتاب البيوع والأقضية"
"23706","(۲۳۷۰۶) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا عرَضَ الرَّجُلُ السِّلْعَۃَ عَلَی الْبَیْعِ بَعْدَ مَا یَرَی الدَّائَ جَازَتْ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23706","","","كتاب البيوع والأقضية"
"23707","(۲۳۷۰۷) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا اشْتَرَی الرَّجُلُ السِّلْعَۃَ، ثُمَّ وَطِئَہَا ، أَوْ عَرَضَہَا عَلَی الْبَیْعِ بَعْدَ الْعَیْبِ لَزِمَتْہُ۔","","Musannaf Ibn Abi Shaybah 23707","","","كتاب البيوع والأقضية"
"23708","(۲۳۷۰۸) حَدَّثَنَا شَرِیکٌ، عَنْ جَابِرٍ، عَنْ عَامِرٍ وَأَبِی جَعْفَرٍ، قَالَ: کَرِہَا أَنْ یَبِیعَ الرَّجُلُ عَلَی أَنْ یَأْخُذَ الدِّینَارَ وَکَذَا۔","","Musannaf Ibn Abi Shaybah 23708","","","كتاب البيوع والأقضية"
"23709","(۲۳۷۰۹) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 23709","","","كتاب البيوع والأقضية"
"23710","(۲۳۷۱۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: سَأَلَہُ عَنِ الرَّجُلِ یَشْتَرِی الْبُرَّ بِکَذَا وَکَذَا دِرہمًا، الدِّینَارُ بِعَشَرَۃٍ۔n قَالَ : وَحَدَّثَنِی مَسْرُوقٌ ، عَنْ عَبْدِ اللہِ ، قَالَ : لاَ یَصْلُحُ صَفْقَتَانِ فِی صَفْقَۃٍ۔","","Musannaf Ibn Abi Shaybah 23710","","","كتاب البيوع والأقضية"
"23711","(۲۳۷۱۱) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ تُرَدُّ الأَمَۃُ مِنَ الْحَیْضِ إلاَّ أَنْ یَشْتَرِطَ الْمُبْتَاعُ۔","","Musannaf Ibn Abi Shaybah 23711","","","كتاب البيوع والأقضية"
"23712","(۲۳۷۱۲) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : سَأَلْتُہ عَنِ الرَّجُلِ یَدَّعِی عَلَی الرَّجُلِ أَشْیَائَ مُخْتَلِفَۃً ؟ قَالَ: یُحَلِّفُہُ عَلَی شَیْئٍ شَیْئٍ۔","","Musannaf Ibn Abi Shaybah 23712","","","كتاب البيوع والأقضية"
"23713","(۲۳۷۱۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ : عَنْ رَجُلٍ اسْتَوْدَعَ غَنَمًا فَتَنَاسَلَتْ عِنْدَہُ فَبَاعَہَا ، قَالَ : عَلَیْہِ قِیمَتُہَا یَوْمَ بَاعَہَا۔","","Musannaf Ibn Abi Shaybah 23713","","","كتاب البيوع والأقضية"
"23714","(۲۳۷۱۴) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ بُکَیْر ، عَنْ عِیَاضِ بْنِ عَبْدِ اللہِ بْنِ سَعْدٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : أُصِیبَ رَجُلٌ فِی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی ثِمَارٍ ابْتَاعَہَا ، فَکَثُرَ دَیْنُہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَصَدَّقُوا عَلَیْہِ فَتَصَدَّقَ النَّاسُ عَلَیْہِ ، فَلَمْ یَبْلُغْ ذَلِکَ وَفَائَ دَیْنِہِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خُذُوا مَا وَجَدْتُمْ ، وَلَیْسَ لَکُمْ إلاَّ ذَلِکَ۔ یَعْنِی : الْغُرَمَائَ۔n(مسلم ۱۱۹۱۔ ابوداؤد ۳۴۶۳)","Sahih","Musannaf Ibn Abi Shaybah 23714","","","كتاب البيوع والأقضية"
"23715","(۲۳۷۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَمْعَۃُ ، عَنِ الزُّہْرِیِّ ، عَنِ ابْنِ کَعْبِ بْنِ مَالِکٍ ، عَنْ أَبِیہِ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ بِہِ وَہُوَ مُلاَزِمٌ رَجُلاً فِی أُوقِیَّتَیْنِ ، فَقَالَ النَّبِیّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلرَّجُلِ ہَکَذَا بِیَدِہِ، أَیْ ضَعْ عَنْہُ الشَّطْرَ ، فَقَالَ لَہُ الرَّجُلُ : نَعَمْ یَا رَسُولَ اللہِ ، فَقَالَ : أَدِّ إلَیْہِ مَا بَقِیَ مِنْ حَقِّہِ۔n(بخاری ۴۵۷۔ ابوداؤد ۳۵۹۰)","Da'if","Musannaf Ibn Abi Shaybah 23715","","","كتاب البيوع والأقضية"
"23716","(۲۳۷۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی صَالِحٍ الْحَنَفِیِّ ، أَنَّ قَوْمًا لَزِمَہُمْ دُیُونٌ فِی زَمَنِ عُمَرَ بْنِ الْخَطَّابِ ، فَکَتَبَ عُمَرُ إلَی عَامِلِہِ : أَنْ یُؤَخِّرُوا ثُلُثًا إلَی الْمَیْسَرَۃِ وَیَحُطُّوا ثُلُثًا وَیَجْعَلُوا ثُلُثًا ، فَفَعَلُوا۔","","Musannaf Ibn Abi Shaybah 23716","","","كتاب البيوع والأقضية"
"23717","(۲۳۷۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ أَنْ یَقُولَ الرَّجُلُ لِلرَّجُلِ : اشْتَرِ مِنِّی ہَذَا الدِّینَارَ وَأَقْضِیک۔","","Musannaf Ibn Abi Shaybah 23717","","","كتاب البيوع والأقضية"
"23718","(۲۳۷۱۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرٍ ، قَالَ : نَہَیْت ابْنَ الزُّبَیْرِ عَنْ بَیْعِ النَّخْلِ مُعَاوَمَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 23718","","","كتاب البيوع والأقضية"
"23719","(۲۳۷۱۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ حُمَیْدٍ الأَعْرَجِ ، عَنْ سُلَیْمَانَ بْنِ عَتِیقٍ ، عَنْ جَابِرٍ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ بَیْعِ النَّخْلِ سِنِینَ۔ (ابوداؤد ۳۳۶۷۔ مسلم ۱۱۷۸)","Sahih","Musannaf Ibn Abi Shaybah 23719","","","كتاب البيوع والأقضية"
"23720","(۲۳۷۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ أَبِی الزُّبَیْرِ، عَنْ جَابِرٍ: أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْمُعَاوَمَۃِ۔n(مسلم ۱۱۷۵۔ ابوداؤد ۳۳۹۷)","Sahih","Musannaf Ibn Abi Shaybah 23720","","","كتاب البيوع والأقضية"
"23721","(۲۳۷۲۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، قَالَ : وُلِّیتُ صَدَقَۃَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلَیَّ فَأَتَیْت مَحْمُودَ بْنَ لَبِیدٍ فَسَأَلْتُہُ ؟ فَقَالَ : إنَّ عُمَرَ کَانَ عِنْدَہُ یَتِیمٌ فَبَاعَ مَالَہُ ثَلاَثَ سِنِینَ۔","Sahih","Musannaf Ibn Abi Shaybah 23721","","","كتاب البيوع والأقضية"
"23722","(۲۳۷۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، قَالَ : قُلْتُ لَہُ : کَانَ إبْرَاہِیمُ یَکْرَہُ بَیْعَ النَّخْلِ السَّنَتَیْن ؟ قَالَ: کَانَ یَکْرَہ مَا ہُوَ أَہْوَنُ مِنْ ہَذَا۔","","Musannaf Ibn Abi Shaybah 23722","","","كتاب البيوع والأقضية"
"23723","(۲۳۷۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ سَعد مَوْلَی عُمَرَ : أَنَّ أُسَیْدَ بْنَ حُضَیْرٍ مَاتَ وَعَلَیْہِ دَیْنٌ ، فَبَاعَ عُمَرُ ثَمَرَۃ أَرْضِہِ سَنَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 23723","","","كتاب البيوع والأقضية"
"23724","(۲۳۷۲۴) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ :قَالَ سُفْیَانُ : لاَ رُجُوعَ فِی ہِبَۃٍ إِلاَّ عِنْدَ الْقَاضِی۔n وَقَالَ ابْنُ أَبِی لَیْلَی : یَرْجِعُ دُونَ الْقَاضِی۔","","Musannaf Ibn Abi Shaybah 23724","","","كتاب البيوع والأقضية"
"23725","(۲۳۷۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إذْ أَقَرَّ عِنْدَ الْقَاضِی بِشَیْئٍ ثُمَّ کَافَرَ أُخِذَ بِإِقْرَارِہِ إلاَّ الْحَدَّ۔","","Musannaf Ibn Abi Shaybah 23725","","","كتاب البيوع والأقضية"
"23726","(۲۳۷۲۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : فِی رَجُلَیْنِ تَدَارَآن الشَّیْئَ ، فَقَالَ أَحَدُہُمَا لِصَاحِبِہِ : إِنْ حَلَفْت ، فَہُوَ لَک۔ قَالَ : إِنْ حَلَفَ فَہُوَ لَہُ۔","","Musannaf Ibn Abi Shaybah 23726","","","كتاب البيوع والأقضية"
"23727","(۲۳۷۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَادَۃَ بْنِ مُسْلِمٍ ، عَنْ مُحَمَّدِ بْنِ مَیْسَرَۃَ ، قَالَ : سَمِعْتُ طَاوُسًا یَکْرَہُ بَیْعَ جُلُودِ النُّمُورِ ، وَعِظَامِ الْفِیلِ ، وَشِرَائَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23727","","","كتاب البيوع والأقضية"
"23728","(۲۳۷۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعَۃَ ، عَنِ الْحَسَنِ : أَنَّہُ لَمْ یَرَ بَأْسًا بِبَیْعِ جُلُودِ النُّمُورِ وَشِرَائِہَا۔","","Musannaf Ibn Abi Shaybah 23728","","","كتاب البيوع والأقضية"
"23729","(۲۳۷۲۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَابْنِ سِیرِینَ : أَنَّہُمَا لَمْ یَرَیَا بَأْسًا بِشِرَاء أَنْیَابِ الفِیَلَۃ ، وَلاَ بِبَیْعِہَا بَأْسًا۔","","Musannaf Ibn Abi Shaybah 23729","","","كتاب البيوع والأقضية"
"23730","(۲۳۷۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ بَأْسَ بِالتِّجَارَۃِ فِی الْعَاجِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23730","","","كتاب البيوع والأقضية"
"23731","(۲۳۷۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إبْرَاہِیمَ ، عَنِ ابْنِ سِیرِینَ : فِی رَجُلٍ دَفَعَ إلَی نَسَّاجٍ غَزْلاً فَأَفْسَدَہُ، قَالَ : کَانَ شُرَیْحٌ یَقُولُ : أَقِمِ الْبَیِّنَۃَ أَنَّہُ أَفْسَدَہُ ، فَإِذَا أَقَامَ الْبَیِّنَۃَ ، قَالَ لِلنَّسَّاجِ : أَعْطِہِ مِثْلَ غَزْلِہِ۔","","Musannaf Ibn Abi Shaybah 23731","","","كتاب البيوع والأقضية"
"23732","(۲۳۷۳۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ مَنْصُورٍ ، قَالَ : سَلَّمْتُ غَزْلاً لأُمِی إلَی نَسَّاجٍ فَأَفْسَدَہُ ، فَسَأَلْتُ إبْرَاہِیمَ ؟ فَقَالَ : یَضْمَنُ۔","","Musannaf Ibn Abi Shaybah 23732","","","كتاب البيوع والأقضية"
"23733","(۲۳۷۳۳) حَدَّثَنَا جَرِیرٌ، عَنْ لَیْثٍ ، عَنْ طَاوُسٍ ، قَالَ : قَالَ عُمَرُ : لاَ یَبِیعَنَّ بِسُوقِکُمْ إنْسَانٌ إلاَّ إنْسَان یَعْقِلُ الْبَیْعَ۔","Da'if","Musannaf Ibn Abi Shaybah 23733","","","كتاب البيوع والأقضية"
"23734","(۲۳۷۳۴) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ زَاذَانَ ، قَالَ : اسْتَوْدَعَ رَجُلاَنِ امْرَأَۃً وَدِیعَۃً وَقَالاَ لَہَا : لاَ تَدْفَعِیہَا إِلَی وَاحِدٍ مِنَّا حَتَّی نَجْتَمِعَ عِنْدَکَ ، ثُمَّ انْطَلَقَا فَغَابَا ، فَجَائَ أَحَدُہُمَا إلَیْہَا فَقَالَ : أَعْطِینِی وَدِیعَتِی فَإِنَّ صَاحِبِی قَدْ مَاتَ ، فَأَبَتْ حَتَّی کَثُرَ اخْتِلاَفُہُ إلَیْہَا ، ثُمَّ أَعْطَتْہُ ، ثُمَّ جَائَ الآخَرُ بَعْدُ فَقَالَ : ہَاتِی وَدِیعَتِی ، فَقَالَتْ : قَدْ جَائَ صَاحِبُک فَذَکَرَ أَنَّک قَدْ مِتَّ ، فَأَخَذَ وَدِیعَتَکُمَا مِنِّی ، فَارْتَفَعَا إلَی عُمَرَ ، فَلَمَّا قَصَّا عَلَیْہِ الْقِصَّۃَ ، قَالَ لَہَا عُمَرُ : مَا أَرَاک إلاَّ قَدْ ضَمِنْت ، قالَتِ الْمَرْأَۃُ : یَا أَمِیرَ الْمُؤْمِنِینَ ، اجْعَلْ عَلِیًّا بَیْنِی وَبَیْنَہُ ، قَالَ لِعَلِیٍّ : اقْضِ بَیْنَہُمَا یَا عَلِیُّ ، قَالَ عَلِیٌّ : ہَذِہِ الْوَدِیعَۃُ عِنْدِی ، وَقَدْ أَمَرْتُماہَا أَلاَّ تَدْفَعَ إلَی وَاحِدٍ مِنْکُمَا حَتَّی تَجْتَمِعَا عِنْدَہَا ، فَأْتِنِی بِصَاحِبِکَ ، فَلَمْ یُضَمِّنْہَا ، قَالَ : فَرَأَوْا أَنَّہُمَا إنَّمَا أَرَادَا أَنْ یَذْہَبَا بِمَالِ الْمَرْأَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 23734","","","كتاب البيوع والأقضية"
"23735","(۲۳۷۳۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ فِی الْمُضَارِبِ یَمُرُّ عَلَی الْعَاشِرِ فَیُہْدِی لَہُ وَیَصْنَعُ لَہُ قَارُورَۃً مِنَ الدُّہْنِ، قَالَ یَحْسَبُہُ مِنَ الرِّبْحِ، فَإِنْ لَمْ یَکُنْ رِبْحٌ فَمِنْ رَأْسِ الْمَالِ، قَالَ: یُصَانِعُ بِالْمَالِ عَنِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 23735","","","كتاب البيوع والأقضية"
"23736","(۲۳۷۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ : فِی الرَّجُلِ یَبِیعُ سُرِّیَّۃً قَدْ وَلَدَتْ مِنْہُ فَیَشْتَرِیہَا رَجُلٌ فَیَقَعُ عَلَیْہَا فَتَلِدُ مِنْہُ أَیْضًا ، قَالَ : تُرَدُّ إلَی الأَوَّلِ ، وَیَکُونُ لَہَا صَدَاقُ مِثْلِہَا ، وَیَکُونُ وَلَدُہَا من الآخَرِ بِمَنْزِلَتِہَا یُعْتَقُونَ بِعِتْقِہَا ، وَیَأْخُذُ الآخَرُ ثَمَنَہَا مِنَ الأَوَّلِ ، فَإِنْ کَانَ وَاحِدٌ مِنْہُمَا عَلِمَ أَنَّہُ لاَ یَصْلُحُ عُوقِبَ ، فَإِنْ عَلِمَا کِلاَہُمَا عُوقِبَا۔","","Musannaf Ibn Abi Shaybah 23736","","","كتاب البيوع والأقضية"
"23737","(۲۳۷۳۷) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ : فِی رَجُلٍ بَاعَ مِنْ رَجُلٍ مَتَاعًا فَوَضَعَہُ عِنْدَہُ ، فَبَاعَہُ الْمُبْتَاعُ ، قَالَ : الرِّبْحُ لِلأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 23737","","","كتاب البيوع والأقضية"
"23738","(۲۳۷۳۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ : فِی رَجُلٍ اشْتَرَی مِنْ رَجُلٍ مَتَاعًا ، فَذَہَبَ یَجِیئُ بِحَمَّالٍ یَنْقُلُہُ، فَوَجَدَ صَاحِبَہُ قَدْ بَاعَہُ ، قَالَ : إِنْ وَجَدَ شَیْئًا بِعَیْنِہِ أَخَذَہُ ، وَإِنْ کَانَ قَدْ ذَہَبَ فَلَمْ یُقْدَرْ عَلَیْہِ فَلاَ شَیْئَ لَہُ ، وَرِبْحُہُ لِلَّذِی بَاعَہُ۔","","Musannaf Ibn Abi Shaybah 23738","","","كتاب البيوع والأقضية"
"23739","(۲۳۷۳۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : شَہِدْت الْحَکَمَ سَأَلَ إبْرَاہِیمَ فَلَمْ یُجِبْہُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 23739","","","كتاب البيوع والأقضية"
"23740","(۲۳۷۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الرَّہْنُ یُرْکَبُ إذَا کَانَ مَرْہُونًا ، وَلَبَنُ الدَّرِّ یُشْرَبُ إذَا کَانَ مَرْہُونًا ، وَعَلَی الَّذِی یَرْکَبُ وَیَشْرَبُ نَفَقَتُہُ۔ (بخاری ۲۵۱۱۔ ابوداؤد ۳۵۲۱)","Sahih","Musannaf Ibn Abi Shaybah 23740","","","كتاب البيوع والأقضية"
"23741","(۲۳۷۴۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ۔ وَعَنْ عَبَّادِ بْنِ الْعَوَّامِ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ : فِی عَبْدٍ رُہِنَ ، قَالَ : نَفَقَتُہُ عَلَی الرَّاہِنِ۔","","Musannaf Ibn Abi Shaybah 23741","","","كتاب البيوع والأقضية"
"23742","(۲۳۷۴۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مُفَضَّلُ بْنُ مُہَلْہِلٍ ، عَنْ سُفْیَانَ ، قَالَ : نَفَقَۃُ الرَّہْنِ عَلَی الرَّاہِنِ۔","","Musannaf Ibn Abi Shaybah 23742","","","كتاب البيوع والأقضية"
"23743","(۲۳۷۴۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: سَمِعْتُ حَسَنَ بْنَ صَالِحٍ ، قَالَ: نَفَقَۃُ الرَّہْنِ عَلَی الْمُرْتَہِنِ لأَنَّہُ فِی ضَمَانِہِ۔n وَقَوْلُ أَبِی حَنِیفَۃَ : عَلَی الرَّاہِنِ۔","","Musannaf Ibn Abi Shaybah 23743","","","كتاب البيوع والأقضية"
"23744","(۲۳۷۴۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : سَأَلْتُ شَرِیکًا : عَلَی مَنْ نَفَقَۃُ الْحَیَوَانِ إذَا کَانَ رَہْنًا ؟ قَالَ : عَلَی الرَّاہِنِ۔","","Musannaf Ibn Abi Shaybah 23744","","","كتاب البيوع والأقضية"
"23745","(۲۳۷۴۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الرَّبِیعِ بْنِ سَعْدٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ عَنْ رَجُلٍ أَشْتَرِی مِنْہُ طَعَامًا فَیُعْطِینِی بَعْضَہُ ثُمَّ یُقْطَعُ بِہِ فَلاَ یَجِدُ مَا یُعْطِینِی فَیَقُولُ : بِعْنِی مِنْ طَعَامِکَ حَتَّی أُعْطِیَک ؟ قَالَ : لاَ تَقْرَبَنَّ ہَذَا ، ہَذَا الرِّبَا الصَّرَاحِیَۃُ۔","","Musannaf Ibn Abi Shaybah 23745","","","كتاب البيوع والأقضية"
"23746","(۲۳۷۴۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ قَتَادَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ : فِی رَجُلٍ اسْتَأْجَرَ أَجِیرًا فَآجَرَہُ بِأَکْثَرَ مِمَّا اسْتَأْجَرَہُ ، قَالَ الْفَضْلُ لِلأَوَّلِ۔","Hasan","Musannaf Ibn Abi Shaybah 23746","","","كتاب البيوع والأقضية"
"23747","(۲۳۷۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ عُمَرَ : أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 23747","","","كتاب البيوع والأقضية"
"23748","(۲۳۷۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : فِی الرَّجُلِ یَسْتَکْرِی الْبَیْتَ فَیُکْرِیہِ بِأَکْثَرَ مِمَّا اسْتَأْجَرَہُ ، قَالَ : یَرُدُّ الْفَضْلَ۔","","Musannaf Ibn Abi Shaybah 23748","","","كتاب البيوع والأقضية"
"23749","(۲۳۷۴۹) حَدَّثَنَا وکیع ، قَالَ : حَدَّثَنَا عَلِیُّ بْنُ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَأَبِی سَلَمَۃَ بْنِ عَبْدِ الرَّحْمَنِ وَعُرْوَۃَ بْنِ الزُّبَیْرِ وَسُلَیْمَانَ بْنِ یَسَارٍ : فِی الرَّجُلِ یَسْتَأْجِرُ الدَّارَ فَیُؤَجِّرُہَا بِأَکْثَرَ مِمَّا اسْتَأْجَرَہَا ، فَرَخَّصَ فِیہِ اثْنَانِ ، وَکَرِہَہُ اثْنَانِ۔","","Musannaf Ibn Abi Shaybah 23749","","","كتاب البيوع والأقضية"
"23750","(۲۳۷۵۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تَأْخُذَنَّ فَضْلاً مِنْ دَابَّۃٍ تَسْتَأْجِرُہَا ، وَلاَ بَیْتٍ۔","","Musannaf Ibn Abi Shaybah 23750","","","كتاب البيوع والأقضية"
"23751","(۲۳۷۵۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ طَلْحَۃَ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ ، أَنَّہُ قَالَ : إذَا اسْتَأْجَرْت غُلاَمًا ، أَوْ دُخَانًا فَلاَ تُؤَجِّرْہُ بِأَکْثَرَ مِمَّا اسْتَأْجَرْتہ۔","","Musannaf Ibn Abi Shaybah 23751","","","كتاب البيوع والأقضية"
"23752","(۲۳۷۵۲) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا أَبُو ہِلاَلٍ ، قَالَ : سَمِعْتُ شَہْرَ بْنَ حَوْشَبٍ یَکْرَہُ أَنْ یَسْتَأْجِرَ الرَّجُلُ الشَّیْئَ فَیُؤَاجِرَہُ بِأَکْثَرَ مِنْ أُجِّرَہُ۔","","Musannaf Ibn Abi Shaybah 23752","","","كتاب البيوع والأقضية"
"23753","(۲۳۷۵۳) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنِ الرَّبِیعِ ، عَنْ عِکْرِمَۃَ ، قَالَ : ہُوَ حَرَامٌ۔","","Musannaf Ibn Abi Shaybah 23753","","","كتاب البيوع والأقضية"
"23754","(۲۳۷۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : ہُوَ رِبًا۔","No Data Available","Musannaf Ibn Abi Shaybah 23754","","","كتاب البيوع والأقضية"
"23755","(۲۳۷۵۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : سَأَلْتُہ عَنِ الرَّجُلِ یَسْتَأْجِرُ الشَّیْئَ فَیُؤَاجِرَہُ بِأَکْثَرَ مِمَّا اسْتَأْجَرَہُ ، فَلَمْ یَرَ بِہِ بَأْسًا ، ثُمَّ سَأَلْتُہُ عَنْہُ بَعْدُ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 23755","","","كتاب البيوع والأقضية"
"23756","(۲۳۷۵۶) حدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونَ : أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23756","","","كتاب البيوع والأقضية"
"23757","(۲۳۷۵۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَرِہَ أَنْ یَسْتَأْجِرَ الرَّجُلُ الدَّارَ ، ثُمَّ یُؤَاجِرہا بِأَکْثَرَ مِمَّا اسْتَأْجَرَہَا۔n قَالَ : قُلْتُ لإِبْرَاہِیمَ : فَإِنْ آجَرَہَا بِأَکْثَرَ لِمَنْ یَکُونُ الأَجْرُ ؟ قَالَ : لِصَاحِبِہَا۔","","Musannaf Ibn Abi Shaybah 23757","","","كتاب البيوع والأقضية"
"23758","(۲۳۷۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُبَارَکٌ ، عَنْ یُونُسَ بْنِ عُبَیْدٍ ، عَنِ ابْنِ سِیرِینَ : أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23758","","","كتاب البيوع والأقضية"
"23759","(۲۳۷۵۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ أَصْحَابُنَا الْکُوفِیُّونَ یَکْرَہُونَہُ وَیَقُولُونَ : لَمْ نَشْتَرِ وَلَمْ نَبِعْ ؟ فَبِأَیِّ شَیْئٍ نَأْکُلُ مَالَہُ ؟!۔","","Musannaf Ibn Abi Shaybah 23759","","","كتاب البيوع والأقضية"
"23760","(۲۳۷۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَابْنِ عُمَرَ : أَنَّہُمَا کَانَا یَکْرَہَانِ إذَا اسْتَأْجَرَ الرَّجُلُ الشَّیْئَ أَنْ یُؤَاجِرَہُ بِأَکْثَرَ مِمَّا اسْتَأْجَرَہُ۔","","Musannaf Ibn Abi Shaybah 23760","","","كتاب البيوع والأقضية"
"23761","(۲۳۷۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ ، قَالَ : کَانَ ہِشَامُ بْنُ ہُبَیْرَۃَ یَقْضِی : مَنِ اسْتَأْجَرَ شَیْئًا ثُمَّ آجَرَہُ بِأَکْثَرَ مِمَّا اسْتَأْجَرَہُ بِہِ ، أَنَّ ذَلِکَ الْفَضْلَ لِرَبِّہِ۔","","Musannaf Ibn Abi Shaybah 23761","","","كتاب البيوع والأقضية"
"23762","(۲۳۷۶۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الزِّبْرِقَانِ ، عَنْ إبْرَاہِیمَ ، مِثْلَ حَدِیثِ وَکِیعٍ ، عَنْ مَنْصُورٍ۔","","Musannaf Ibn Abi Shaybah 23762","","","كتاب البيوع والأقضية"
"23763","(۲۳۷۶۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ وَالْحَکَمَ عَنِ الرَّجُلِ یَکْترِی الإِبِلَ ، ثُمَّ یُکْرِیہَا بِأَکْثَرَ مِمَّا اسْتَأْجَرَہَا ؟ قَالَ : لاَ بَأْسَ إذَا عَمِلَ فِیہَا بِنَفْسِہِ ، أَوِ اکْتَرَی فِیہَا أَجِیرًا۔","","Musannaf Ibn Abi Shaybah 23763","","","كتاب البيوع والأقضية"
"23764","(۲۳۷۶۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : أَنَّہُ سُئِلَ عَنْ رَجُلٍ اکْتَرَی إبِلاً فَأَکْرَاہَا بِأَکْثَرَ مِنْ ذَلِکَ ؟ قَالَ : فَتَرَدَّدَ سَاعَۃً ، ثُمَّ قَالَ : مَا أَرَی بِہِ بَأْسًا فِی رَأْیِی۔","No Data Available","Musannaf Ibn Abi Shaybah 23764","","","كتاب البيوع والأقضية"
"23765","(۲۳۷۶۵) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : لاَ بَأْسَ إذَا اکْتَرَیْت بَیْتًا أَنْ تُکْرِیَہُ بِأَکْثَرَ مِنْ أَجْرِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23765","","","كتاب البيوع والأقضية"
"23766","(۲۳۷۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ ہِشَامِ بْنِ ہُبَیْرَۃَ : أَنَّہُ کَرِہَہُ إلاَّ أَنْ یَسْتَعْمِلَ ، أَوْ یَسْکُنَ فِی الدَّارِ ، أَوْ یَسْکُنَ بَعْضَہَا۔","","Musannaf Ibn Abi Shaybah 23766","","","كتاب البيوع والأقضية"
"23767","(۲۳۷۶۷) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إذَا اسْتَأْجَرَ الرَّجُلُ الدَّارَ فَآجَرَ بَعْضَہَا وَأَسْکَنَ بَعْضَہَا ، قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23767","","","كتاب البيوع والأقضية"
"23768","(۲۳۷۶۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرٍ : أَنَّہُ کَرِہَہُ إلاَّ أَنْ یُصْلِحَ فِیہَا شَیْئًا۔","","Musannaf Ibn Abi Shaybah 23768","","","كتاب البيوع والأقضية"
"23769","(۲۳۷۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الرَّبِیعُ وَمُبَارَکٌ وَأَبُو ہِلاَلٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَأْجِرَ الرَّجُلُ الشَّیْئَ ، ثُمَّ یُؤَاجِرَہُ بِأَکْثَرَ۔","","Musannaf Ibn Abi Shaybah 23769","","","كتاب البيوع والأقضية"
"23770","(۲۳۷۷۰) حَدَّثَنَا ابن علیۃ ، عن لیث ، عن عطاء ، أَنَّہُ کَانَ لاَ یَری بَأْساً أَنْ یَسْتَأجِرَ الرَّجُل الْبَیْتَ ، ثُمَّ یُؤجِّرَہ بِأَکْثَرَ مِمَّا اسْتَأْجَرَہُ بِہِ۔","","Musannaf Ibn Abi Shaybah 23770","","","كتاب البيوع والأقضية"
"23771","(۲۳۷۷۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : إذَا دُفِعَ إلَیْہِ إزْمِیلٌ ، أَوْ مَرٌّ فَوَاجَرَہُ بِأَکْثَرَ مِمَّا اسْتَأْجَرَہُ بِہِ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23771","","","كتاب البيوع والأقضية"
"23772","(۲۳۷۷۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ : أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُؤَاجِرَ الأَجِیرَ أَوِ الشَّیْئَ بِأَکْثَرَ مِمَّا اسْتَأْجَرَہُ۔","","Musannaf Ibn Abi Shaybah 23772","","","كتاب البيوع والأقضية"
"23773","(۲۳۷۷۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ عَبِیدَۃَ ، قَالَ : التَّخْیِیرُ بَیْنَ الْغِلْمَانِ حُکْمٌ۔","","Musannaf Ibn Abi Shaybah 23773","","","كتاب البيوع والأقضية"
"23774","(۲۳۷۷۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ بُکَیْر الضَّخْمِ ، عَنْ عَلِیّ ، قَالَ : ہُوَ حُکْم۔","Da'if","Musannaf Ibn Abi Shaybah 23774","","","كتاب البيوع والأقضية"
"23775","(۲۳۷۷۵) حَدَّثَنَا ہشیم ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ۔ وَمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ : أَنَّہُمَا کَرِہَا أَنْ یُعْطِیَ الرَّجُلُ الرَّجُلَ الدَّابَّۃَ ، أَوِ الْغُلاَمَ ، أَوِ الْبَیْتَ فَیَقُولُ : مَا کَسَبْتَ مِنْ شَیْئٍ فَہُوَ بَیْنِی وَبَیْنَک۔","","Musannaf Ibn Abi Shaybah 23775","","","كتاب البيوع والأقضية"
"23776","(۲۳۷۷۶) حَدَّثَنَا ہِشَامٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قیلَ لَہُ : إنَّ نَاسًا مِنَ النَّخَّاسِینَ وَأَصْحَابِ الدَّوَابِّ یُسَمِّی أَحَدُہُمُ اصطَبْل دَوَابَّہُ : خُرَاسَانَ وَسِجِسْتَانَ ! ثُمَّ یَأْتِی السُّوقَ فَیَقُولُ : جَائَتْ مِنْ خُرَاسَانَ وَسِجِسْتَانَ ، قَالَ : فَکَرِہَ ذَلِکَ إبْرَاہِیمُ۔","","Musannaf Ibn Abi Shaybah 23776","","","كتاب البيوع والأقضية"
"23777","(۲۳۷۷۷) حَدَّثَنَا ہُشَیْمٌ، عَنْ یُونُسَ، عَنِ الْحَسَنِ ، قَالَ: کَانَ لاَ یَرَی بَأْسًا بِبَیْعِ الْبَلَحِ لِمَنْ یَصْرِمَہُ حَتَّی یَشْتَرِیَہُ۔","","Musannaf Ibn Abi Shaybah 23777","","","كتاب البيوع والأقضية"
"23778","(۲۳۷۷۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ یَکْرَہُ أَنْ تَحْمِلَ الْمَیْتَۃَ إلَی مَنْ یَسْتَحِلُّ أَکْلَہَا ، وَلاَ یَرَی بَأْسًا أَنْ یَسْتَأْجِرَ عَلَیْہَا مَنْ یَنْقُلُہَا عَنْہ۔","","Musannaf Ibn Abi Shaybah 23778","","","كتاب البيوع والأقضية"
"23779","(۲۳۷۷۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : فِی رَجُلٍ اشْتَرَی بَیْعًا إلَی شَہْرٍ بِکَذَا ، وَإِلَی شَہْرَیْنِ بِکَذَا ، فَاسْتُہْلِکَ الْبَیْعَ ، قَالَ : لَہُ أَوْکسُ الثمنین إلَی أَبْعَدِ الأَجَلَیْنِ۔","","Musannaf Ibn Abi Shaybah 23779","","","كتاب البيوع والأقضية"
"23780","(۲۳۷۸۰) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، عَنْ وُہَیْبٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : مَنْ بَاعَ بَیْعَتَیْنِ إلَی أَجَلَیْنِ فَلَہُ أَقَلُّ الثمنین إلَی أَبْعَدِ الأَجَلَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 23780","","","كتاب البيوع والأقضية"
"23781","(۲۳۷۸۱) حَدَّثَنَا مُعَاذٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : أَنَّہُ کَانَ یُضَمِّنُ الرَّاعِیَ إلاَّ مِنْ مَوْتٍ۔","","Musannaf Ibn Abi Shaybah 23781","","","كتاب البيوع والأقضية"
"23782","(۲۳۷۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ : أَنَّہُ سُئِلَ عَنِ الرَّاعِی یُضَمَّنُ إذَا کَانَ أَجِیرًا ؟ قَالَ : لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23782","","","كتاب البيوع والأقضية"
"23783","(۲۳۷۸۳) حَدَّثَنَا أَبُو بَکْرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : یُضَمَّنُ الرَّاعِی۔","No Data Available","Musannaf Ibn Abi Shaybah 23783","","","كتاب البيوع والأقضية"
"23784","(۲۳۷۸۴) حَدَّثَنَا حَفْصٌ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ عَلَی الرَّاعِی ضَمَانٌ۔","","Musannaf Ibn Abi Shaybah 23784","","","كتاب البيوع والأقضية"
"23785","(۲۳۷۸۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنِ الْمُثَنَّی ، عَنْ عَمْرِو بْنِ شُعَیْب ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ یَضْمَنُ الرَّاعِی۔","","Musannaf Ibn Abi Shaybah 23785","","","كتاب البيوع والأقضية"
"23786","(۲۳۷۸۶) حَدَّثَنَا قُتَیْبَۃُ بْنُ سَعِیدٍ ، عَنْ بَکْرِ بْنِ مُضَرَ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ ، قَالَ : لَیْسَ عَلَی الرَّاعِی ضَمَانٌ۔","","Musannaf Ibn Abi Shaybah 23786","","","كتاب البيوع والأقضية"
"23787","(۲۳۷۸۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَا رَأَیْت شُرَیْحًا قَطُّ إلاَّ وَہُوَ یُضَمِّنُ الأَجِیرَ ، إلاَّ رَجُلاً اسْتَأْجَرَ رَجُلاً یَعْلِفُ لَہُ بَغْلَتَیْنِ حَشِیشًا ، فَشَرَدَتْ إحْدَاہُمَا ، فَلَمْ یُضَمِّنْہُ۔","","Musannaf Ibn Abi Shaybah 23787","","","كتاب البيوع والأقضية"
"23788","(۲۳۷۸۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَضْمَنُ الرَّاعِی ، إذَا کَانَ یَرْعَی لہذا ولہذا ، فإن کان یرعی لَکَ وَحْدَک فَلَیْسَ عَلَیْہِ ضَمَانٌ۔","","Musannaf Ibn Abi Shaybah 23788","","","كتاب البيوع والأقضية"
"23789","(۲۳۷۸۹) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یَضْمَنُ الرَّاعِی۔","No Data Available","Musannaf Ibn Abi Shaybah 23789","","","كتاب البيوع والأقضية"
"23790","(۲۳۷۹۰) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، قَالَ : لَوْ رَأَیْت رَجُلاً شَجَّ رَجُلاً ، فَدَعَانِی إلَی إِمَامٍ جَائِرٍ أَشْہَدُ لَہُ : مَا شَہِدْتُ لَہُ۔","","Musannaf Ibn Abi Shaybah 23790","","","كتاب البيوع والأقضية"
"23791","(۲۳۷۹۱) حَدَّثَنَا قَبِیصَۃُ، قَالَ: أَخْبَرَنَا سُفْیَانُ، عَنْ جَابِرٍ، عَنِ الشَّعْبِیِّ وَالْحَکَمِ، قَالاَ: إذَا اتُّہِمَ الْوَصِیُّ اُسْتُحْلِفَ۔","","Musannaf Ibn Abi Shaybah 23791","","","كتاب البيوع والأقضية"
"23792","(۲۳۷۹۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ : فِی رَجُلَیْنِ کَانَتْ بَیْنَہُمَا أَمَۃٌ اشْتَرَیَاہَا بِأَرْبَعِینَ دِینَارًا ، فَأَرَادَا أَنْ یَبِیعَاہَا مُرَابَحَۃً ، فَأُعْطِیَا بِہَا خَمْسِینَ دِینَارًا ، فَاقْتَواہَا أَحَدُہُمَا ثُمَّ أَرَادَ أَنْ یَبِیعَہَا مُرَابَحَۃً ، قَالَ : یَبِیعُہَا عَلَی خَمْسَۃٍ وَأَرْبَعِینَ دِینَارًا ، تِلْکَ الْخَمْسَۃُ رِبْحُہَا نَفْسُہُ۔","","Musannaf Ibn Abi Shaybah 23792","","","كتاب البيوع والأقضية"
"23793","(۲۳۷۹۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ : أَنَّ رَجُلاً تَصَدَّقَ عَلَی أُمِّہِ بِجَارِیَۃٍ ، ثُمَّ تَزَوَّجَ امْرَأَۃً ، فَسَاقَہَا إلَی امْرَأَتِہِ ، فَاخْتَصَمُوا إلَی شُرَیْحٍ فَقَالَ لأُمِّہِ : إنَّ ابْنَک لَمْ یَہَبَکِ صَدَقَتَہُ۔","","Musannaf Ibn Abi Shaybah 23793","","","كتاب البيوع والأقضية"
"23794","(۲۳۷۹۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ : أَنَّہُ کَانَ یَجْعَلُہَا لأُمِّہِ ، إلاَّ أَنْ یَأْتی بِبَیِّنَۃٍ أَنَّہُ أَصْدَقَہَا قَبْلَ أَنْ یَتَصَدَّقَ بِہَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 23794","","","كتاب البيوع والأقضية"
"23795","(۲۳۷۹۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ : فِی رَجُلَیْنِ تَدَارَآ فِی مَالٍ کَانَ بَیْنَہُمَا ، فَوَضَعَاہُ عَلَی یَدَیْ عَدْلٍ ، قَالَ : فَالْمَالُ عَلَی حَالِہِ عِنْدَ الْعَدْلِ حَتَّی یُقِیمَ أَحَدُہُمَا الْبَیِّنَۃَ۔","","Musannaf Ibn Abi Shaybah 23795","","","كتاب البيوع والأقضية"
"23796","(۲۳۷۹۶) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : جَائَہُ قَوْمٌ یَخْتَصِمُونَ مِنَ الْغَزَّالِینَ فَقَالُوا : سُنَّتُنَا فِیمَا بَیْنَنَا ، فَقَالَ : سُنَّتُکُمْ فِیمَا بَیْنَکُمْ۔","","Musannaf Ibn Abi Shaybah 23796","","","كتاب البيوع والأقضية"
"23797","(۲۳۷۹۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِی عَاصِمٍ الْغَطَفَانِیِّ ، عَنِ الشَّعْبِیِّ : أَنَّ أُمِّ وَلَدٍ قَالَتْ لِسَیِّدِہَا : رَقِّص صَبِیَّک إذَا بَکَی عَلَیْک ، وَقُلْ : مَادرتوآزَاد ، قَالَ الشَّعْبِیُّ : إِنْ کَانَ لاَ یَدْرِی مَا الْفَارِسِیَّۃُ فَلَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 23797","","","كتاب البيوع والأقضية"
"23798","(۲۳۷۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ حَیَّانَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الأَقْلَفُ لاَ تَجُوزُ شَہَادَتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 23798","","","كتاب البيوع والأقضية"
"23799","(۲۳۷۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الأَقْلَفُ لاَ تَجُوزُ شَہَادَتُہُ ، وَلاَ تُقْبَلُ لَہُ صَلاَۃٌ ، وَلاَ تُؤْکَلُ لَہُ ذَبِیحَۃٌ۔n قَالَ : فَکَانَ الْحَسَنُ لاَ یَرَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23799","","","كتاب البيوع والأقضية"
"23800","(۲۳۸۰۰) ح??دَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زِیَادُ بْنُ أبِی زِیَاد ، قَالَ : اشْتَرَیْت مِنْ رَجُلٍ شَاۃً فَنَقَدْتہ ثَمَنَہَا ، ثُمَّ جِئْت لأَقْبِضَہَا فَقَالَ الْبَائِعُ : أَنَّہَا أَرَادَتْ أَنْ تَمُوتَ فَذَبَحَہَا أَہْلِی ، فَخَاصَمْتہُ إلَی شُرَیْحٍ ، فَقَالَ شُرَیْحٌ : رُدَّ عَلَیْہِ الثَّمَنَ۔","","Musannaf Ibn Abi Shaybah 23800","","","كتاب البيوع والأقضية"
"23801","(۲۳۸۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ : أَنَّہُ سُئِلَ عَنْ رَجُلٍ اشْتَرَی عَبْدًا فَقَالَ : الْمُشْتَرِی لِلْبَائِعِ : بِعْہُ لِی فَہُوَ مِنْک أُنْفِقَ ، فَمَاتَ الْعَبْدُ فِی یَدِ الْبَائِعِ ، فَقَالَ : یَغْرَمُ الْبَائِعُ ثَمَنَہُ۔","","Musannaf Ibn Abi Shaybah 23801","","","كتاب البيوع والأقضية"
"23802","(۲۳۸۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذا اعتقب الْبَائِعَ الْبَیْعَ بِبَعْضِ الثمنِ فَمَاتَ ، فَہُوَ مِنْ مَالِ الْبَائِعِ۔","","Musannaf Ibn Abi Shaybah 23802","","","كتاب البيوع والأقضية"
"23803","(۲۳۸۰۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا اشْتَرَی دَارًا بِعَرْضٍ ، أَوْ بِدَرَاہِمَ وَعَرْضٍ ، أَنَّہُ لَیْسَ فِیہَا شُفْعَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 23803","","","كتاب البيوع والأقضية"
"23804","(۲۳۸۰۴) حَدَّثَنَا عُبَیْدُ بْنُ سُہَیلٍ الْغُدَانِی ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ نَسَّاجٌ فِی بَیْتِہِ غُزُولُ النَّاسِ ، فَاحْتَرَقَ بَیْتُہُ فَاحْتَرَقَتْ غُزُولُ النَّاسِ ، فَبَقِیَ ثَلاَثُ کُبَّاتٍ ، فَانْطَلَقَ بِہَا إلَی شُرَیْحٍ وَمَعَہُ امْرَأَتَانِ ، فَقَالَتْ إحْدَاہُمَا : ہُوَ غَزْلِی ، وَقَالَتِ الأُخْرَی : لاَ وَاللَّہِ ہُوَ غَزْلِی ، فَخَلَّی بِإِحْدَاہُمَا فَقَالَ : عَلَی أَیْشٍ کَبَّبْت غَزْلَک ؟ قَالَتْ : عَلَی قِشْرِ جَوْزَۃٍ ، وَقَالَ لِلأُخْرَی : عَلَی أَیْشٍ کببت غَزْلَک ؟ قَالَتْ : عَلَی کِسْرَۃِ خُبْزٍ ، فَقَالَ : یَا نَسَّاجُ ، اذْہَبْ فَانْقُضْ ہَذَا الْغَزْلَ ، فَإِنْ کَانَ عَلَی قِشْرَۃِ جَوْزَۃٍ فَادْفَعْہُ إلَی ہَذِہِ ، وَإِنْ کَانَ عَلَی کِسْرَۃِ خُبْزٍ فَادْفَعْہُ إلَی ہَذِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 23804","","","كتاب البيوع والأقضية"
"23805","(۲۳۸۰۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ : فِی رَجُلٍ ، قَالَ : یَوْمَ أَشْتَرِی فُلاَنًا فَہُوَ حُرٌّ ، فَاشْتَرَاہُ ، قَالَ : ہُوَ حُرٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 23805","","","كتاب البيوع والأقضية"
"23806","(۲۳۸۰۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ : إنِ اشْتَرَیت ہَذَا الْعَبْدَ فَہُوَ حُرٌّ ، فَاشْتَرَاہُ ، فَہُوَ حُرٌّ۔","","Musannaf Ibn Abi Shaybah 23806","","","كتاب البيوع والأقضية"
"23807","(۲۳۸۰۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ : فِی الرَّجُلِ یَقُولُ : یَوْمَ أَشْتَرِی فُلاَنًا فَہُوَ حُرٌّ ، قَالَ : یَوْمَ یَشْتَرِیہِ فَہُوَ عَتِیقٌ۔","","Musannaf Ibn Abi Shaybah 23807","","","كتاب البيوع والأقضية"
"23808","(۲۳۸۰۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، قَالَ : أَخْبَرَنِی عَبْدُ اللہِ بْنُ رِفَاعَۃَ ألأَنْصَارِیُّ ، قَالَ : قِیلَ لِرَجُلٍ : ذُکِرَ أَنَّک تُرِید أَنْ تَبْتَاعَ فُلاَنَۃَ وَلِیدَۃً سَمَّوْہَا ، فَقَالَ الرَّجُلُ : ہِیَ حُرَّۃٌ إنِ ابْتَعْتہَا ، فَزَعَمَ عَبْدُ اللہِ أَنَّہُ سَأَلَ سَعِیدَ بْنَ الْمُسَیَّبِ فَقَالَ : أَمَّا أَنَا فَلاَ أَرَاہُ شَیْئًا ، وَأَمَّا عُمَرُ بْنُ عَبْدِ الْعَزِیزِ فَیَأْبَاہُ۔","","Musannaf Ibn Abi Shaybah 23808","","","كتاب البيوع والأقضية"
"23809","(۲۳۸۰۹) حَدَّثَنَا ۔۔۔ وَکَانَ الْقَاسِمُ وَسَالِمٌ لاَ یُرَخِّصَانِ لأَحَدٍ فِی طَلاَقٍ ، أَوْ عَتَاقٍ۔","","Musannaf Ibn Abi Shaybah 23809","","","كتاب البيوع والأقضية"
"23810","(۲۳۸۱۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یَقُولُ : إنِ اشْتَرَیْت فُلاَنَۃً فَہِیَ حُرَّۃٌ ، أَوْ کُلُّ جَارِیَۃٍ اشْتَرَیْتہَا عَلَیْک فَہِیَ حُرَّۃٌ : أَنَّہُ إنِ اشْتَرَی شَیْئًا مِنْ ذَلِکَ ، فَقَدْ عَتَقَ۔","","Musannaf Ibn Abi Shaybah 23810","","","كتاب البيوع والأقضية"
"23811","(۲۳۸۱۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ : أَنَّ رَجُلاً قَالَ لِغُلاَمِہِ : أَنْتَ لِلَّہِ ، قَالَ فَسُئِلَ الشَّعْبِیُّ وَالْمُسَیَّبُ بْنُ رَافِعٍ وَحَمَّادُ بْنُ أَبِی سُلَیْمَانَ ؟ فَقَالُوا : ہُوَ حُرٌّ۔","","Musannaf Ibn Abi Shaybah 23811","","","كتاب البيوع والأقضية"
"23812","(۲۳۸۱۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ الرَّجُلُ لِعَبْدِہِ ، أَوْ لأَمَتِہِ : أَنْتَ عَتِیقٌ أَنْتَ حُرٌّ أَنْتَ لِلَّہِ ، فَہُوَ عَتِیقٌ ، إذَا قَالَ : أَنْتَ مَوْلی بنیّ ، فَہُوَ عَتِیقٌ۔","","Musannaf Ibn Abi Shaybah 23812","","","كتاب البيوع والأقضية"
"23813","(۲۳۸۱۳) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ عُمَیْرٍ : أَنَّ عَبْدًا أَذِنَ لَہُ مَوْلاَہُ فِی الْخِیَاطَۃِ ، وَعَبْدًا أَذِنَ لَہُ فِی الصِّبْغِ ، قَالَ : فَضَمَّنَہُما شُرَیْحٌ ، فَضَمَّنَ الْخَیَّاطَ ثَمَنَ الْخُیُوطِ وَالإِبَرِ ، وَضَمَّنَ الآخَرَ الصِّبْغَ وَالْغَلْی ، وَمَا أَشْبَہَ أَعْمَالَہُمْ۔","","Musannaf Ibn Abi Shaybah 23813","","","كتاب البيوع والأقضية"
"23814","(۲۳۸۱۴) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : إذَا أَذِنَ لَہُ فِی نَوْعٍ مِنَ التِّجَارَۃِ فَتَجَرَ فِی نَوْعٍ غَیْرِ الَّذِی أَذِنَ لَہُ فِیہِ ، فَلَیْسَ عَلَیْہِ دَیْنُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 23814","","","كتاب البيوع والأقضية"
"23815","(۲۳۸۱۵) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ : أَنَّہُ کَانَ یَقُولُ : إذَا أَذِنَ لَہُ فِی نَوْعٍ وَاحِدٍ فَقَدْ أَذِنَ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23815","","","كتاب البيوع والأقضية"
"23816","(۲۳۸۱۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، قَالَ : قَالَ ابْنُ سِیرِینَ : الشُّفْعَۃُ لاَ تُورَثُ۔","","Musannaf Ibn Abi Shaybah 23816","","","كتاب البيوع والأقضية"
"23817","(۲۳۸۱۷) حُدِّثْتُ عَنْ جَرِیرٍ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الشُّفْعَۃُ لاَ تُورَثُ۔","","Musannaf Ibn Abi Shaybah 23817","","","كتاب البيوع والأقضية"
"23818","(۲۳۸۱۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ : أَنَّہُ رَکِبَہُ دَیْنٌ ، فَکَانَ یَقْضِی غُرَمَائَہُ بَعْضَہُمْ دُونَ بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 23818","","","كتاب البيوع والأقضية"
"23819","(۲۳۸۱۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْحَارِثِ بْنِ عُمَیْرٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، بِنَحْوٍ مِنْہُ ، أَوْ شَبِیہٍ بِہِ۔","","Musannaf Ibn Abi Shaybah 23819","","","كتاب البيوع والأقضية"
"23820","(۲۳۸۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ شُرَیْحٌ لاَ یُبْرِئُ الْبَائِعَ إلاَّ مِنْ دَائٍ أَعْلَمَہُ إیَّاہُ۔","","Musannaf Ibn Abi Shaybah 23820","","","كتاب البيوع والأقضية"
"23821","(۲۳۸۲۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ : فِی رَجُلٍ کَانَ یَطْلُبُ رَجُلاً بِدَیْنٍ فَمَاتَ الْمَطْلُوبُ ، فَقَالَ شُرَیْحٌ : بَیِّنَتُہُ عَلَی أَصْلِ حَقِّہِ ، وَالْبَرَائَۃُ عَلَی أَہْلِ الْمُتَوَفَّی أَنَّ صَاحِبَہُمْ قَدْ بَرِئَ ، أَوْ یَمِینُ الطَّالِبِ أَنَّہُ مَاتَ یَوْمَ مَاتَ وَالْحَقُّ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 23821","","","كتاب البيوع والأقضية"
"23822","(۲۳۸۲۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا بِعْت مَتَاعاً مُرَابَحَۃً فَاحْسُبْ مَا أَنْفَقْت عَلَیْہِ ، وَلاَ تَحْسُبْ مَا أَنْفَقْت عَلَی نَفْسِک۔","","Musannaf Ibn Abi Shaybah 23822","","","كتاب البيوع والأقضية"
"23823","(۲۳۸۲۳) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ رَاشِدٍ ، عَنْ مَکْحُولٍ : أَنَّہُ کَانَ یَکْرَہُ أَنْ یُعْطِیَ الرَّجُلُ الرَّجُلَ الدِّینَارَ فَیَقُولُ : اصْرِفْہُ بِکَذَا وَکَذَا وَلَک مَا فَضَلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23823","","","كتاب البيوع والأقضية"
"23824","(۲۳۸۲۴) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ رَبِیعَۃَ الرَّأْیِ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : فِی رَجُلٍ بَاعَ جَارِیَۃً وَوَلَدَہَا ثُمَّ ادَّعَی الْوَلَدَ ، قَالَ : یُرَدُّ عَلَیْہِ بِالْمِلْکِ ، وَلاَ یَثْبُتُ النَّسَبُ۔","","Musannaf Ibn Abi Shaybah 23824","","","كتاب البيوع والأقضية"
"23825","(۲۳۸۲۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا أَبُو شِہَابٍ ، عَنْ سُفْیَانَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنِ الْحَارِثِ الْعُکْلِیِّ: فِی شِرَی الْقَصِیلِ عَلَی أَنْ یَعْلِفَہُ ، قَالَ : إِنْ شَغَلَہُ شَیْئٌ عَنْ قَطْعِہِ حَتَّی یَزِیدَ فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 23825","","","كتاب البيوع والأقضية"
"23826","(۲۳۸۲۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَمْرٍو ، عَنْ طَاوُوسٍ : أَنَّہُ لَمْ یَرَ بَأْسًا أَنْ یَقُولَ الرَّجُلُ لِلرَّجُلِ إذَا بَاعَہُ الطَّعَامَ : أَنْقُدُک إذَا وَفَّیْتنِی۔","","Musannaf Ibn Abi Shaybah 23826","","","كتاب البيوع والأقضية"
"23827","(۲۳۸۲۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ : فِی رَجُلٍ قَالَ لِعَبْدِہِ : اخْدِمْنِی سَنَۃً وَأَنْتَ حُرٌّ ، قَالَ : یَخْدُمُہُ سَنَۃً وَہُوَ حُرٌّ ، وَإذَا قَالَ : أَنْتَ حُرٌّ عَلَی أَنْ تَخْدُمَنِی سَنَۃً ثُمَّ مَاتَ الرَّجُلُ : خَدَمَ وَلَدَہُ سَنَۃً مِنْ بَعْدِہِ وَیُعْتَقُ مِنْ ثُلُثِہِ۔","","Musannaf Ibn Abi Shaybah 23827","","","كتاب البيوع والأقضية"
"23828","(۲۳۸۲۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : شَہِدَ رَجُلٌ عِنْدَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ عَلَی شَہَادَۃٍ ، فَقَالَ الْمَشْہُودُ عَلَیْہِ: إِنَّہُ لاَ تُقْبَلُ شَہَادَتُہُ ، قَالَ : وَلِمَ ؟ قَالَ : لاَ یُدْرَی مَنْ أَبُوہُ ؟ قَالَ : ائْتِنِی بِشَاہِدٍ سِوَاہُ۔","","Musannaf Ibn Abi Shaybah 23828","","","كتاب البيوع والأقضية"
"23829","(۲۳۸۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زُہَیْرٍ العَبْسِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : وَلَدُ الزِّنَا یَؤُمُّ ، وَتَجُوزُ شَہَادَتُہُ۔","","Musannaf Ibn Abi Shaybah 23829","","","كتاب البيوع والأقضية"
"23830","(۲۳۸۳۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ رَجُلٍ ، عَنْ نَافِعٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ وَلَدِ الزِّنَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23830","","","كتاب البيوع والأقضية"
"23831","(۲۳۸۳۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہِشَامٍ ، عَنْ حَجَّاجٍ : أَنَّ ابْنَ عَبَّاسٍ کَانَ یَقُولُ : تَجُوزُ شَہَادَتُہُ۔","","Musannaf Ibn Abi Shaybah 23831","","","كتاب البيوع والأقضية"
"23832","(۲۳۸۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ وَزُہَیْرٌ ، عَنْ أَبِی سِنَانٍ ، عَنْ شَیْخٍ مِنْ بَنِی الْہُجَیْمِ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : أَیُّمَا رَجُلٍ کَانَ عَلَیْہِ دَیْنٌ فَأَیْسَرَ فَلَمْ یَقْضِہِ کَانَ کَآکِلِ سُحْتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 23832","","","كتاب البيوع والأقضية"
"23833","(۲۳۸۳۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی مَکِینٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : أَیُّمَا رَجُلٍ کَانَ عَلَیْہِ دَیْنٌ إلَی أَجَلٍ فَأَیْسَرَ وَلَمْ یَقْضِہِ ، فَقَدْ ہَلَکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23833","","","كتاب البيوع والأقضية"
"23834","(۲۳۸۳۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ : فِی الرَّجُلِ یَقُولُ : قدْ أَخَذْت قَدْ رَضِیت ، قَالَ : ہُوَ بِالْخِیَارِ مَا کَانَ عَلَی شَرْطِہِ۔","","Musannaf Ibn Abi Shaybah 23834","","","كتاب البيوع والأقضية"
"23835","(۲۳۸۳۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ : أَنَّ رَجُلاً سَاوَمَ رَجُلاً بِثَوْبٍ فَقَالَ رَجُلٌ : أَبِیعُک مِثْلَہُ بِکَذَا وَکَذَا ، فَبَاعَہُ مِنْہُ ، ثُمَّ انْطَلَقَ إلَی صَاحِبِ الثَّوْبِ فَاشْتَرَاہُ مِنْہُ ، ثُمَّ أَتَاہُ بِہِ فَأَبَی أَنْ یَقْبَلَہُ ، فَخَاصَمَہُ إلَی شُرَیْحٍ فَقَالَ : لاَ نَجِدُ شَیْئًا أَشْبَہَ بِہِ مِنْہُ ، فَأَجَازَہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 23835","","","كتاب البيوع والأقضية"
"23836","(۲۳۸۳۶) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : فِی رَجُلَیْنِ وَرِثَا أَمْوَالاً وَمَتَاعًا یَبِیعُ أَحَدُہُمَا صَاحِبَہُ قَبْلَ أَنْ یَقْتَسِمَا ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 23836","","","كتاب البيوع والأقضية"
"23837","(۲۳۸۳۷) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَبِیعُہُ حَتَّی یُقَاسِمَہُ۔","","Musannaf Ibn Abi Shaybah 23837","","","كتاب البيوع والأقضية"
"23838","(۲۳۸۳۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَتَخَارَجُ الشَّرِیکَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 23838","","","كتاب البيوع والأقضية"
"23839","(۲۳۸۳۹) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی الأَسْلَمِیُّ ، عَنْ عِیسَی بْنِ مُوسَی ، قَالَ : سَأَلَ رَجُلٌ الْحَکَمَ عْن مُکَاتَبٍ بَیْنَ رَجُلَیْنِ أَعْتَقَہُ أَحَدُہُمَا ، فَقَالَ : إنَّمَا ہُوَ مَالٌ وَہَبَہُ لَہُ ، لَیْسَ عَلَیْہِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 23839","","","كتاب البيوع والأقضية"
"23840","(۲۳۸۴۰) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ: أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِکِرَائِ الْکِفَایَۃِ إذَا لَمْ یُعْطِہِ الدَّرَاہِمَ۔","","Musannaf Ibn Abi Shaybah 23840","","","كتاب البيوع والأقضية"
"23841","(۲۳۸۴۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ شِبَاکٍ ، قَالَ : خَاصَمَ رَجُلٌ أُخْتَہُ إلَی شُرَیْحٍ فِی حُلِیٍّ عَلَیْہَا ، فَقَالَ : ہُوَ مِیرَاثُ أَبِی ، فَاسْأَلْہَا الْبَیِّنَۃَ أنہ لہا ، فَقَالَ : لاَ ، بَلْ أَسْأَلُک الْبَیِّنَۃَ أَنَّہُ لأَبِیک۔","","Musannaf Ibn Abi Shaybah 23841","","","كتاب البيوع والأقضية"
"23842","(۲۳۸۴۲) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : فِی الرَّجُلِ یَسْتَأْجِرُ الأَجِیرَ سَنَۃً بِطَعَامِہِ ، وَسَنَۃً بِخَرَاجٍ بِکَذَا وَکَذَا ، قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23842","","","كتاب البيوع والأقضية"
"23843","(۲۳۸۴۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أُؤَاجرُ غُلاَمِی عَلَی أَنْ أُطْعِمَہُ سَنَۃً وَہُوَ سَنَۃً وَفِی الثَّالِثَۃِ بِخَرَاجِ کَذَا وَکَذَا ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 23843","","","كتاب البيوع والأقضية"
"23844","(۲۳۸۴۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ حَمَّادٍ : أَنَّہُ کَرِہَ أَنْ یُسْتَأْجَرَ الرَّجُلُ بِطَعَامِہِ۔","","Musannaf Ibn Abi Shaybah 23844","","","كتاب البيوع والأقضية"
"23845","(۲۳۸۴۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ مُضَارِبِ بْنِ حَزْنٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : کُنْتُ أَجِیرًا لِبُسْرَۃَ ابْنَۃِ غَزْوَانَ بِطَعَامِی وَعُقْبَۃِ رِجْلِی۔ (ابن ماجہ ۲۴۴۵)","Da'if","Musannaf Ibn Abi Shaybah 23845","","","كتاب البيوع والأقضية"
"23846","(۲۳۸۴۶) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ : أَنَّ رَجُلاً کَانَ لَہُ سِتَّۃُ أَعْبُدٍ ، فَأَعْتَقَہُمْ عِنْدَ مَوْتِہِ ، فَأَقْرَعَ بَیْنَہُمُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَعْتَقَ مِنْہُمُ اثْنَیْنِ وَأَرَقَّ أَرْبَعَۃً۔ (مسلم ۱۲۸۸۔ ابوداؤد ۳۹۵۴)","Sahih","Musannaf Ibn Abi Shaybah 23846","","","كتاب البيوع والأقضية"
"23847","(۲۳۸۴۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ عَبْدِ اللہِ بْنِ مُخْتَارٍ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَّہُ أَقْرَعَ۔ (نسائی ۴۹۷۹)","Sahih","Musannaf Ibn Abi Shaybah 23847","","","كتاب البيوع والأقضية"
"23848","(۲۳۸۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ صَفِیَّۃَ : أَنَّہَا أَقْرَعَتْ بَیْنَ حَمْزَۃَ وَبَیْنَ رَجُلٍ فِی کَفَنٍ۔","","Musannaf Ibn Abi Shaybah 23848","","","كتاب البيوع والأقضية"
"23849","(۲۳۸۴۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ صَالِحِ بْنِ أَبِی الأَخْضَرِ ، عَنِ الْوَلِیدِ بْنِ أَبِی ہِشَامٍ ، عَنْ مَالِکِ بْنِ عَبْدِ اللہِ الْخَثْعَمِیِّ ، قَالَ : کُنَّا جُلُوسًا عِنْدَ عُثْمَانَ فَقَالَ : مَنْ ہَاہُنَا مِنْ أَہْلِ الشَّامِ ؟ فَقُمْت فَقَالَ : أَبْلِغْ مُعَاوِیَۃَ إذَا غَنِمَ غَنِیمَۃً أَنْ یَأْخُذَ خَمْسَۃَ أَسْہُمٍ ، فَلْیَکْتُبْ عَلَی سَہْمٍ مِنْہَا لِلَّہِ ، ثُمَّ لِیُقْرِعْ ، فَحَیْثُ مَا خَرَجَ مِنْہَا فَلْیَأْخُذْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 23849","","","كتاب البيوع والأقضية"
"23850","(۲۳۸۵۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا سَافَرَ أَقْرَعَ بَیْنَ نِسَائِہِ۔ (بخاری ۲۵۹۳۔ مسلم ۲۱۲۹)","Hasan","Musannaf Ibn Abi Shaybah 23850","","","كتاب البيوع والأقضية"
"23851","(۲۳۸۵۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ أَیْمَنَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِمِثْلِہِ۔ (بخاری ۵۲۱۱۔ مسلم ۸۸)","Sahih","Musannaf Ibn Abi Shaybah 23851","","","كتاب البيوع والأقضية"
"23852","(۲۳۸۵۲) حَدَّثَنَا جَرِیرٌ ، عَنْ أَسْلَمَ الْمُنْقِرِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : أَنَّہُ أَقْرَعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23852","","","كتاب البيوع والأقضية"
"23853","(۲۳۸۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَسْلَمَ ، عْن سَعِیدِ بْنِ جُبَیْرٍ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23853","","","كتاب البيوع والأقضية"
"23854","(۲۳۸۵۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ بْنِ الْخَلِیلِ الْحَضْرَمِیِّ ، عَنْ زَیْدِ بْنِ أَرْقَمَ ، أَنَّہُ قَالَ : اخْتَصَمَ إلَی عَلِیٍّ قَوْمٌ ، قَالَ : فَقَالَ : إنِّی مُقْرِعٌ بَیْنَہُمْ ، قَالَ : فَذُکِرَ ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَضَحِکَ حَتَّی بَدَتْ نَوَاجِذُہُ۔ (ابوداؤد ۲۲۶۳)","Hasan","Musannaf Ibn Abi Shaybah 23854","","","كتاب البيوع والأقضية"
"23855","(۲۳۸۵۵) حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ أَبِی رَافِعٍ ، عَنْ أَبِی ہُرَیْرَۃَ : أَنَّ رَجُلَیْنِ ادَّعَیَا دَابَّۃً ، وَلَمْ یَکُنْ لَہُمَا بَیِّنَۃٌ ، فَأَمَرَہُمَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَسْتَہِمَا عَلَی الْیَمِینِ۔","Sahih","Musannaf Ibn Abi Shaybah 23855","","","كتاب البيوع والأقضية"
"23856","(۲۳۸۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنْ عَبْدِ اللہِ بْنِ رَافِعٍ ، عَنْ أُمِّ سَلَمَۃَ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِرَجُلَیْنِ : اسْتَہِمَا ثُمَّ تَوَخَّیَا الْحَقَّ ، ثُمَّ لِیُحْلِلْ کُلُّ وَاحِدٍ مِنْکُمَا صَاحِبَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 23856","","","كتاب البيوع والأقضية"
"23857","(۲۳۸۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ : أَنَّ ابْنَ الزُّبَیْرِ أَقْرَعَ۔","Sahih","Musannaf Ibn Abi Shaybah 23857","","","كتاب البيوع والأقضية"
"23858","(۲۳۸۵۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ عَبِیدَۃ : أَنَّہُ أَقْرَعَ۔","","Musannaf Ibn Abi Shaybah 23858","","","كتاب البيوع والأقضية"
"23859","(۲۳۸۵۹) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : بَلَغَ مُحَمَّدَ بْنَ سِیرِینَ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ أَقْرَعَ ، فَقَالَ: ما أری ہَذَا إِلاَّ مِنَ الاسْتِقْسَامِ بِالأَزْلاَمِ۔","","Musannaf Ibn Abi Shaybah 23859","","","كتاب البيوع والأقضية"
"23860","(۲۳۸۶۰) حَدَّثَنَا ابْنُ إدْرِیسَ وَوَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ وَاصِلٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ: أَنَّہُ کَانَ یَقْطَعُ الْکُنُفَ ، أَوْ یَأْمُرُ بِقَطْعِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 23860","","","كتاب البيوع والأقضية"
"23861","(۲۳۸۶۱) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قَالَ مُحَمَّدٌ : وَدِدْت أَنَّ کُلَّ کَنِیف قُطِعَ ، وَأَوَّلُہَا کَنِیفُ عَبْدِ اللہِ۔","","Musannaf Ibn Abi Shaybah 23861","","","كتاب البيوع والأقضية"
"23862","(۲۳۸۶۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إسْمَاعِیلَ بْنِ مُسْلِمٍ ، عَنِ الْحَارِثِ ، قَالَ : کَانَ شُرَیْحٌ لاَ یَدَعُ ظُلَّۃً لاَ یَمُرُّ فِیہَا الْفَارِسُ بِرُمْحِہِ ، وَیَقُولُ : بَنَیْتُمْ عَلَی رُمْحِ الْفَارِسِ!۔","","Musannaf Ibn Abi Shaybah 23862","","","كتاب البيوع والأقضية"
"23863","(۲۳۸۶۳) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ الْحَسَنَ عن الرَّجُلِ یَشْتَرِی بِالدَّیْنِ ؟ قَالَ : اتَّقِ اللَّہَ وَکُلْ بِقَدْرِ مَالِک۔","No Data Available","Musannaf Ibn Abi Shaybah 23863","","","كتاب البيوع والأقضية"
"23864","(۲۳۸۶۴) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذُکِرَ لِنَافِع أَنَّ ابْنَ عُمَرَ کَانَ یَشْتَرِی إلَی الْمَیْسَرَۃِ ، فَغَضِبَ وَقَالَ: إنَّمَا کَانَ یَشْتَرِی مِنْ قَوْمٍ قَدْ عَرَفَہُمْ وَعَرَفُوہُ ، فَیُمْطِلُہُمُ السَّنَۃَ وَالسَّنَتَیْنِ ، وَلَہُ مِنَ الرِّبَاعِ مَا لَوْ شَائَ لَبَاعَ فَقَضَاہُمْ ، وَکَانَ ابْنُ عُمَرَ إذَا أَیْسَرَ قَضَی۔","Sahih","Musannaf Ibn Abi Shaybah 23864","","","كتاب البيوع والأقضية"
"23865","(۲۳۸۶۵) حَدَّثَنَا وَکِیعٌ ، عن سفیان ، عن رجل ، عن الحسن : فی الرجل یصرف الدنانیر فیعطَی الدَّارَہِم الزّیف ؟ قَالَ : لاَ بأس أن یستبدِلہ۔","","Musannaf Ibn Abi Shaybah 23865","","","كتاب البيوع والأقضية"
"23866","(۲۳۸۶۶) حَدَّثَنَا وکیع قَالَ : وَقَالَ سُفْیَانُ : إِنْ کَانَ سُتُّوقًا رَدَّہُ ، وَیَکُونُ شَرِیکًا فِی الدَّنَانِیرِ بِحِصَّتِہِ۔","","Musannaf Ibn Abi Shaybah 23866","","","كتاب البيوع والأقضية"
"23867","(۲۳۸۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : لَوْ أَنَّ رَجُلاً جَائَ إلَی صَیْرَفِیٍّ بِدِینَارٍ فَصَرَفَہُ عِنْدَہُ بِعَشَرَۃِ دَرَاہِمَ ، فَقَبَضَ الدِّینَارَ ، وَلَیْسَ عِنْدَ الصَّیْرَفِیِّ دَرَاہِم ؟ قَالَ : إنِ احْتَالَہَا لَہُ قَبْلَ أَنْ یَفْتَرِقَا فَإِنَّ الْبَیْعَ جَائِزٌ ، لأَنَّ کُلَّ وَاحِدٍ مِنْہُمَا ثَمَنٌ لِصَاحِبِہِ ، وَلَوْ کَانَ عَرَضًا فَسَدَ الْبَیْعُ۔","","Musannaf Ibn Abi Shaybah 23867","","","كتاب البيوع والأقضية"
"23868","(۲۳۸۶۸) حَدَّثَنَا وکیع ، قَالَ : قَالَ سُفْیَانُ : فِی عَشَرَۃِ دَرَاہِمَ بِسَبْعَۃٍ وَفَلْسٍ ، فَکَرِہَہُ ، وَعَشَرَۃِ دَرَاہِمَ بِتِسْعَۃِ دَرَاہِمَ وَذَہَبٍ ، لَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 23868","","","كتاب البيوع والأقضية"
"23869","(۲۳۸۶۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : سَمِعْتُ سُفْیَانَ یَقُولُ : إذَا سَمَّی بَرِئَ ، وَإِنْ لَمْ یَضَعْ یَدَہُ۔","","Musannaf Ibn Abi Shaybah 23869","","","كتاب البيوع والأقضية"
"23870","(۲۳۸۷۰) حَدَّثَنَا وَکِیعٌ ، سَمِعْتُ سُفْیَانَ یَقُولُ : إذَا قَالَ : بَرِئْت مِنْ کُلِّ عَیْبٍ بَرِئَ ؟۔","","Musannaf Ibn Abi Shaybah 23870","","","كتاب البيوع والأقضية"
"23871","(۲۳۸۷۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الرَّبِیعِ بْنِ سَعْدٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ عَنْ رَجُلٍ أَشْتَرِی مِنْہُ طَعَامًا فَیُعْطِینِی بَعْضَہُ ، ثُمَّ یَقْطَعُ بِہِ فَلاَ یُعْطِینِی فَیَقُولُ : بِعْنِی طَعَامَکَ حَتَّی أَقْضِیَک ؟ قَالَ : لاَ تَقْرَبَنَّ ہَذَا ہذا الرِّبَا الصَّرَاحِیَۃُ۔","","Musannaf Ibn Abi Shaybah 23871","","","كتاب البيوع والأقضية"
"23872","(۲۳۸۷۲) حَدَّثَنَا حَفْصٌ ، عَنْ سُلَیْمَانَ أَبِی عَبْدِ اللہِ ، قَالَ : قَالَ الْحَسَنُ : مَنِ احْتَازَ مِنْ رَجُلٍ مَالاً ، أَوْ سَرَقَ مِنْ رَجُلٍ مَالاً ، فَأَرَادَ أَنْ یَرُدَّہُ إلَیْہِ مِنْ وَجْہٍ لاَ یَعْلَمُ ، فَأَوْصَلَہُ إلَیْہِ فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 23872","","","كتاب البيوع والأقضية"
"23873","(۲۳۸۷۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَلْمِ بْنِ أ??بِی الذَّیَّالِ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنْ شَرِیکَیْنِ اشْتَرَیَا مَتَاعًا فَبَاعَہُ بِرِبْحٍ بِنَقْدٍ وَنَسِیئَۃٍ ، فَقَالَ: أَحَدُہُمَا لِصَاحِبِہِ: اُنْقُدْنِی رَأْسَ مَالِی، وَمَا بَقِیَ فَہُوَ لَکَ، فَکَرِہَہُ الْحَسَنُ۔","","Musannaf Ibn Abi Shaybah 23873","","","كتاب البيوع والأقضية"
"23874","(۲۳۸۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، أَنَّہُمَا قَالاَ فِی الرَّجُلِ یَبِیعُ قَوْسَرَۃً أَوْ حُلَّۃً ، ثُمَّ یُعْطِیہِ بَقِیَّتَہَا عَدَدًا یَکِیلُہَا ، أَنَّہُمَا کَرِہَا ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23874","","","كتاب البيوع والأقضية"
"23875","(۲۳۸۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ وَأَبِی ہَاشِمٍ : فِی رَجُلٍ اشْتَرَی عَشَرَۃَ آلاَفِ جَوْزَۃٍ بِثَلاَثِینَ دِرْہَمًا یَشْتَرِیہ عَدَدًا ، ثُمَّ یُصَیَّر بجرۃ أو بجرتین ، ثُمَّ یَعُدُّن بَقِیَّتَہُ علَی مَا فِی الْجَرَتَیْنِ ، قَالاَ : ہُوَ مَکْرُوہٌ۔","","Musannaf Ibn Abi Shaybah 23875","","","كتاب البيوع والأقضية"
"23876","(۲۳۸۷۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَالَ الرَّجُلُ لِمَمْلُوکِہِ : إنَّک لَحُرُّ النَّفْسِ ، فَہُوَ حُرٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 23876","","","كتاب البيوع والأقضية"
"23877","(۲۳۸۷۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ : فِی الرَّجُلِ یَقُولُ لِمَمْلُوکِہِ : مَا أَنْتَ إلاَّ حُرٌّ ، قَالَ : فَقَالَ: الْحَسَنُ : نِیَّتُہُ۔","","Musannaf Ibn Abi Shaybah 23877","","","كتاب البيوع والأقضية"
"23878","(۲۳۸۷۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 23878","","","كتاب البيوع والأقضية"
"23879","(۲۳۸۷۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ : فِی رَجُلٍ قَاتَلَ غُلاَمُہُ رَجُلاً فَقَالَ : إنَّمَا ہُوَ حُرٌّ مِثْلُک ، قَالَ : ہُوَ حُرٌّ۔","Hasan","Musannaf Ibn Abi Shaybah 23879","","","كتاب البيوع والأقضية"
"23880","(۲۳۸۸۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ دِینَارٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ قَالَ : جُرِحَ رَجُلٌ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : اُدْعُوا لَہُ الطَّبِیبَ ، فَقَالُوا : یَا رَسُولَ اللہِ ، ہَلْ یُغْنِی عَنْہُ الطَّبِیبُ؟ قَالَ : نَعَمْ ، إِنَّ اللَّہَ تَبَارَکَ وَتَعَالَی لَمْ یُنْزِلْ دَائً ، إِلاَّ أَنْزَلَ مَعَہُ شِفَائً۔ (احمد ۵/۳۷۱)","","Musannaf Ibn Abi Shaybah 23880","","","كتاب الطب"
"23881","(۲۳۸۸۱) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا حَرْبُ بْنُ مَیْمُونٍ ، قَالَ : سَمِعْتُ عِمْرَانَ الْعَمِّیَّ ، یَقُولُ : سَمِعْتُ أَنَسًا رضِیَ اللَّہُ عَنْہُ یَقُولُ : إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنَّ اللَّہَ حَیْثُ خَلَقَ الدَّائَ خَلَقَ الدَّوَائَ ، فَتَدَاوَوْا۔ (احمد ۳/۱۵۶)","Hasan","Musannaf Ibn Abi Shaybah 23881","","","كتاب الطب"
"23882","(۲۳۸۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ عُمَرَ بْنِ سَعِیدِ بْنِ أَبِی حُسَیْنٍ ، قَالَ : حدَّثَنَا عَطَائٌ ، عَنْ أَبِی ہُرَیْرَۃَ رضِیَ اللَّہُ عَنْہُ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا أَنْزَلَ اللَّہُ مِنْ دَائٍ إِلاَّ أَنْزَلَ لَہُ شِفَائً۔ (بخاری ۵۶۷۸۔ ابن ماجہ ۳۴۳۹)","Sahih","Musannaf Ibn Abi Shaybah 23882","","","كتاب الطب"
"23883","(۲۳۸۸۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنْ أُسَامَۃَ بْنِ شَرِیکٍ ، قَالَ : شَہِدْتُ الأَعْرَابَ یَسْأَلُونَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : تَدَاوَوْا عِبَادَ اللہِ ، فَإِنَّ اللَّہَ لَمْ یَضَعْ دَائً إِلاَّ وَضَعَ مَعَہُ شِفَائً ، إِلاَّ الْہِرَمَ۔ (ابوداؤد ۳۸۵۱۔ ترمذی ۲۰۳۸)","Sahih","Musannaf Ibn Abi Shaybah 23883","","","كتاب الطب"
"23884","(۲۳۸۸۴) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا شَبِیبُ بْنُ شَیْبَۃَ ، قَالَ : حَدَّثَنَا عَطَائُ بْنُ أَبِی رَبَاحٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ رضِیَ اللَّہُ عَنْہُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنَّ اللَّہَ لَمْ یُنْزِلْ دَائً ، أَوْ لَمْ یَخْلُقْ دَائً إِلاَّ وَقَدْ أَنْزَلَ ، أَوْ خَلَقَ لَہُ دَوَائً ، عَلِمَہُ مَنْ عَلِمَہُ ، وَجَہِلَہُ مَنْ جَہِلَہُ ، إِلاَّ السَّامَ ، قَالُوا : یَا رَسُولَ اللہِ ، وَمَا السَّامُ ؟ قَالَ : الْمَوْتُ۔ (طبرانی ۹۲)","Da'if","Musannaf Ibn Abi Shaybah 23884","","","كتاب الطب"
"23885","(۲۳۸۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ عَبْدُ اللہِ : لَمْ یُنْزِلِ اللَّہُ دَائً، أَوْ لَمْ یَخْلُقْ دَائً إِلاَّ وَقَدْ أَنْزَلَ مَعَہُ شِفَائً، جَہِلَہُ مَنْ جَہِلَہُ ، وَعَلِمَہُ مَنْ عَلِمَہُ۔ (احمد ۱/۴۱۳)","Sahih","Musannaf Ibn Abi Shaybah 23885","","","كتاب الطب"
"23886","(۲۳۸۸۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ؛ أَنَّ رَجُلاً أَصَابَہُ جُرْحٌ ، فَاحْتَقَنَ الدَّمُ ، وَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَعَا لَہُ رَجُلَیْنِ مِنْ بَنِی أَنْمَارٍ فَقَالَ : أیَّکُمَا أَطَبَّ ؟ فَقَالَ رَجُلٌ : یَا رَسُولَ اللہِ ، أَوَفِی الطِّبِّ خَیْرٌ ؟ فَقَالَ : إِنَّ الَّذِی أَنْزَلَ الدَّائَ أَنْزَلَ الدَّوَائَ۔ (مالک ۹۴۳)","","Musannaf Ibn Abi Shaybah 23886","","","كتاب الطب"
"23887","(۲۳۸۸۷) حدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ شَبِیبٍ ، عَنْ أَبِی قِلاَبَۃَ ؛ (وَقِیلَ مَنْ رَاقٍ) ، قَالَ : مَنْ طَبِیبٌ۔","","Musannaf Ibn Abi Shaybah 23887","","","كتاب الطب"
"23888","(۲۳۸۸۸) حَدَّثَنَا مُعْتَمِرٌ ، عَنِ ابْنِ مُبَارَکٍ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ کَعْبٍ ، قَالَ : إِنَّ اللَّہَ یَقُولُ : أَنَا الَّذِی أُصِحَّ وَأُدَاوِی۔","","Musannaf Ibn Abi Shaybah 23888","","","كتاب الطب"
"23889","(۲۳۸۸۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ ابْنِ أَبْجَرَ ، عَنْ إِیَادِ بْنِ لَقِیطٍ ، عَنْ أَبِی رِمْثَۃَ ، قَالَ : انْطَلَقْتُ مَعَ أَبِی وَأَنَا غُلاَمٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَقَالَ لَہُ أَبِی : إِنِّی رَجُلٌ طَبِیبٌ ، فَأَرِنِی ہَذِہِ السِّلْعَۃَ الَّتِی بِظَہْرِکَ ، قَالَ : مَا تَصْنَعُ بِہَا ؟ قَالَ : أَقْطَعُہَا ، قَالَ : لَسْتَ بِطَبِیبٍ وَلَکِنَّک رَفِیقٌ ، طَبِیبُہَا الَّذِی وَضَعَہَا ، وَقَالَ غَیْرُہُ : الَّذِی خَلَقَہَا۔ (ابوداؤد ۴۲۰۴۔ ترمذی ۲۸۱۲)","Sahih","Musannaf Ibn Abi Shaybah 23889","","","كتاب الطب"
"23890","(۲۳۸۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ شُرْبَ الأَدْوِیَۃِ کُلِّہَا ، إِلاَّ اللَّبَنَ وَالْعَسَلَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23890","","","كتاب الطب"
"23891","(۲۳۸۹۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ شُرْبَ الأَدْوِیَۃِ الْمَعْجُونَۃِ إِلاَّ شَیْئًا یَعْرِفُہُ ، وَکَانَ إِذَا أَرَادَ شَیْئًا مِنْہُ وَلِیَہُ بِنَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 23891","","","كتاب الطب"
"23892","(۲۳۸۹۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْوَلِیدِ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، عَنِ ابْنِ مَعْقِل ؛ أَنَّہُ کَرِہَ الدَّوَائَ الْخَبِیثَ الَّذِی إِذَا عُلِقَ قَتَلَ صَاحِبَہُ۔","","Musannaf Ibn Abi Shaybah 23892","","","كتاب الطب"
"23893","(۲۳۸۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدَّوَائِ الْخَبِیثِ۔ (ابن ماجہ ۳۴۵۹۔ احمد ۲/۴۴۶)","Hasan","Musannaf Ibn Abi Shaybah 23893","","","كتاب الطب"
"23894","(۲۳۸۹۴) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : قیلَ لِلرَّبِیعِ بْنِ خُثَیْمٍ فِی مَرَضِہِ : أَلاَ نَدْعُو لَکَ الطَّبِیبَ ؟ فَقَالَ : أَنْظِرُونِی ، ثُمَّ تَفَکَّرَ فَقَالَ : {وَعَادًا وَثَمُودَ وَأَصْحَابَ الرَّسِّ وَقُرُونًا بَیْنَ ذَلِکَ کَثِیرًا وَکَُلاًّ ضَرَبْنَا لَہُ الأَمْثَالَ وَکُلاًّ تَبَّرْنَا تَتْبِیرًا} فَذَکَرَ مِنْ حِرْصِہِمْ عَلَی الدُّنْیَا وَرَغْبَتِہِمْ فِیہَا ، قَالَ : فَقَدْ کَانَتْ مَرْضَی ، وَکَانَ فِیہِمْ أَطِبَّائُ ، فَلاَ الْمُدَاوِی ، وَلاَ الْمُدَاوَی ، ہَلَکَ النَّاعِتُ وَالْمَنْعُوتُ لَہُ ، وَاللَّہِ لاَ تَدْعُوا لِی طَبِیبًا۔","","Musannaf Ibn Abi Shaybah 23894","","","كتاب الطب"
"23895","(۲۳۸۹۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ السَّکَرَ وَیَأْبَاہُ۔","","Musannaf Ibn Abi Shaybah 23895","","","كتاب الطب"
"23896","(۲۳۸۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : مَرِضَ أَبُو الدَّرْدَائِ فَعَادُوہُ ، فَقَالُوا لَہُ : نَدْعُو لَکَ الطَّبِیبَ ؟ فَقَالَ : ہُوَ أَضْجَعَنِی۔","","Musannaf Ibn Abi Shaybah 23896","","","كتاب الطب"
"23897","(۲۳۸۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا لاَ یَرَوْنَ بِالاسْتِمْشَائِ بَأْسًا ، قَالَ : وَإِنَّمَا کَرِہُوا مِنْہُ مَخَافَۃَ أَنْ یُضْعِفَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 23897","","","كتاب الطب"
"23898","(۲۳۸۹۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَمْشِیَ الْمُحْرِمُ۔","No Data Available","Musannaf Ibn Abi Shaybah 23898","","","كتاب الطب"
"23899","(۲۳۸۹۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : خَیْرُ الدَّوَائِ ؛ اللَّدُودُ ، وَالسَّعُوطُ ، وَالْمَشِیُّ ، وَالْحِجَامَۃُ ، وَالْعَلقُ۔ (ترمذی ۲۰۵۳)","","Musannaf Ibn Abi Shaybah 23899","","","كتاب الطب"
"23900","(۲۳۹۰۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ؛ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 23900","","","كتاب الطب"
"23901","(۲۳۹۰۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ زُرْعَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ مَوْلًی لِمَعْمَرٍ التَّیْمِیِّ ، عَنْ أَسْمَائَ بِنْتِ عُمَیْسٍ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بِمَاذَا کُنْتِ تَسْتَمْشِینَ ؟ قُلْتُ : بِالشَّبْرُمِ ، قَالَ : حَارٌّ جَارٌّ ، ثُمَّ اسْتَمْشَیْتُ بِالسَّنَا ، فَقَالَ : لَوْ کَانَ شَیْئٌ یَشْفِی مِنَ الْمَوْتِ کَانَ السَّنَا ، أَوِ السَّنَا شِفَائٌ مِنَ الْمَوْتِ۔ (طبرانی ۳۹۷۔ ترمذی ۲۰۸۱)","Da'if","Musannaf Ibn Abi Shaybah 23901","","","كتاب الطب"
"23902","(۲۳۹۰۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ أُمِّ قَیْسٍ ابْنَۃِ مِحْصَنٍ ، قَالَتْ: دَخَلْتُ بِابْنٍ لِی عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَقَدْ أَعْلَقْتُ عَلَیْہِ مِنَ الْعُذْرَۃِ ، فَقَالَ : عَلاَمَ تَدْغَرْنَ أَوْلاَدَکُنَّ ؟ عَلَیکُنَّ بِہَذَا الْعِلاَقِ ، عَلَیْکُنَّ بِہَذَا الْعُودِ الْہِنْدِیِّ ، فَإِنَّ فِیہِ سَبْعَۃَ أَشْفِیَۃٍ ، یُسْعَطُ بِہِ مِنَ الْعُذْرَۃِ ، وَیُلَدُّ بِہِ مِنْ ذَاتِ الْجَنْبِ۔ (بخاری ۵۶۹۲۔ مسلم ۱۷۳۴)","Sahih","Musannaf Ibn Abi Shaybah 23902","","","كتاب الطب"
"23903","(۲۳۹۰۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی أُمِّ سَلَمَۃَ وَعِنْدَہَا صَبِیٌّ یَبْتَدِرُ مَنْخَرَاہُ دَمًا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا ہَذَا ؟ قَالُوا : بِہِ الْعُذْرَۃُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلاَمَ تُعَذِّبْنَ أَوْلاَدَکُنَّ ؟ إِنَّمَا یَکْفِی إِحْدَاکُنَّ أَنْ تَأْخُذَ قُسْطًا ہِنْدِیًّا ، فَتَحُکَّہُ بِمَائٍ سَبْعَ مَرَّاتٍ ، ثُمَّ تُوجِرَہُ إِیَّاہُ ، قَالَ : فَفَعَلُوہُ فَبَرَأَ۔ (احمد ۳/۳۱۵۔ بزار ۳۰۲۴)","Hasan","Musannaf Ibn Abi Shaybah 23903","","","كتاب الطب"
"23904","(۲۳۹۰۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنَّ أَمْثَلَ مَا تَدَاوَیْتُمْ بِہِ الْحِجَامَۃُ ، وَالْقُسْطُ الْعَرَبِیُّ لِصِبْیَانِکُمْ مِنَ الْعُذْرَۃِ ، وَلاَ تُعَذِّبُوہُمْ بِالْغَمْزِ۔n(بخاری ۵۶۹۶۔ مسلم ۶۴)","Sahih","Musannaf Ibn Abi Shaybah 23904","","","كتاب الطب"
"23905","(۲۳۹۰۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : عَلَیْکُمْ بِہَذِہِ الْحَبَّۃِ السَّوْدَائِ ، فَإِنَّ فِیہَا شِفَائً مِنْ کُلِّ دَائٍ، قِیلَ لَہُ: عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ؟ قَالَ: نَعَمْ۔ (مسلم ۸۸۔ احمد ۲/۲۶۸)","Sahih","Musannaf Ibn Abi Shaybah 23905","","","كتاب الطب"
"23906","(۲۳۹۰۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إِسْمَاعِیلَ بْنِ مُسْلِمٍ ، عَنْ قتَادَۃَ ، وَمَطَرِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الشَّونِیزُ فِیہِ شِفَائٌ مِنْ کُلِّ دَائٍ إِلاَّ السَّامَ ، قَالُوا : یَا رَسُولَ اللہِ ، مَا السَّامُ ؟ قَالَ : الْمَوْتُ۔ (احمد ۵/۳۴۶)","Da'if","Musannaf Ibn Abi Shaybah 23906","","","كتاب الطب"
"23907","(۲۳۹۰۷) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا إِسْرَائِیلُ ، عَنْ مَنْصُورٍ ، عَنْ خَالِدِ بْنِ سَعْدٍ ، عَنِ ابْنِ أَبِی عَتِیقٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : عَلَیْکُمْ بِہَذِہِ الْحَبَّۃِ السَّوْدَائِ ، فَإِنَّ فِیہِ شِفَائً مِنْ کُلِّ دَائٍ ، یَعْنِی الشَّونِیزَ۔ (بخاری ۵۶۸۷۔ احمد ۶/۱۳۸)","Sahih","Musannaf Ibn Abi Shaybah 23907","","","كتاب الطب"
"23908","(۲۳۹۰۸) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْحُقْنَۃِ أَشَدَّ الْقَوْلِ۔","Da'if","Musannaf Ibn Abi Shaybah 23908","","","كتاب الطب"
"23909","(۲۳۹۰۹) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23909","","","كتاب الطب"
"23910","(۲۳۹۱۰) حَدَّثَنَا شَرِیکٌ ، وَعَبَّادٌ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِنِّی لأَتَفَحَّشُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23910","","","كتاب الطب"
"23911","(۲۳۹۱۱) حَدَّثَنَا شَرِیکٌ، عَنْ جَابِرٍ، قَالَ: سُئِلَ عَامِرٌ عَنِ الْحُقْنَۃِ لِلصَّائِمِ؟ فَقَالَ: إِنِّی لأَکْرَہُہَا لِلْمُفْطِرِ، فَکَیْفَ لِلصَّائِمِ؟","","Musannaf Ibn Abi Shaybah 23911","","","كتاب الطب"
"23912","(۲۳۹۱۲) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِنِّی لأَتَفَحَّشُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23912","","","كتاب الطب"
"23913","(۲۳۹۱۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ ، وَالْحَسَنِ ؛ أَنَّہُمَا کَرِہَا الْحُقْنَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23913","","","كتاب الطب"
"23914","(۲۳۹۱۴) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو، قَالَ: حدَّثَنَا أَبُو عَوَانَۃَ، عَنْ لَیْثٍ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ، عَنْ الْمَعْرُورِ، عَنْ عَلِیٍّ؛ أَنَّہُ کَرِہَ الْحُقْنَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 23914","","","كتاب الطب"
"23915","(۲۳۹۱۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : ہِیَ طَرَفٌ مِنْ عَمَلِ قَوْمِ لُوطٍ ، یَعْنِی الْحُقْنَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23915","","","كتاب الطب"
"23916","(۲۳۹۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ مُجَاہِدٍ ، وَطَاوُوسٍ ؛ أَنَّہُمَا کَرِہَا الْحُقْنَۃَ۔","","Musannaf Ibn Abi Shaybah 23916","","","كتاب الطب"
"23917","(۲۳۹۱۷) حَدَّثَنَا جَرِیرٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 23917","","","كتاب الطب"
"23918","(۲۳۹۱۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : ہِیَ دَوَائٌ۔","","Musannaf Ibn Abi Shaybah 23918","","","كتاب الطب"
"23919","(۲۳۹۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ؛ أَنَّہُ احْتَقَنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 23919","","","كتاب الطب"
"23920","(۲۳۹۲۰) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بِالْحُقْنَۃِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 23920","","","كتاب الطب"
"23921","(۲۳۹۲۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : حَدَّثَنِی أَبُو مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ لاَ یَرَی بِالْحُقْنَۃِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 23921","","","كتاب الطب"
"23922","(۲۳۹۲۲) حَدَّثَنَا جَرِیرٌ ، وَمُعْتَمِرٌ ، عَنِ الرُّکَیْنِ ، عَنِ الْقَاسِمِ بْنِ حَسَّانٍ ، عَنْ عَمِّہِ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَکْرَہُ عَقْدَ التَّمَائِمِ۔ (احمد ۳۹۷۔ حاکم ۱۹۵)","Da'if","Musannaf Ibn Abi Shaybah 23922","","","كتاب الطب"
"23923","(۲۳۹۲۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عِیسَی ، عَنْ عَبْدِ اللہِ بْنِ عُکَیْمٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَعَلَّقَ عَلاَقَۃً وُکِلَ إِلَیْہَا۔ (احمد ۴/۳۱۰۔ بیہقی ۳۵۱)","Da'if","Musannaf Ibn Abi Shaybah 23923","","","كتاب الطب"
"23924","(۲۳۹۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : دَخَلَ عَبْدُ اللہِ عَلَی امْرَأَتِہِ وَہِیَ مَرِیضَۃٌ ، فَإِذَا فِی عُنُقِہَا خَیْطٌ مُعَلَّقٌ ، فَقَالَ : مَا ہَذَا ؟ فَقَالَتْ : شَیْئٌ رُقِیَ لِی فِیہِ مِنَ الْحُمَّی ، فَقَطَعَہُ وَقَالَ : إِنَّ آلَ إِبْرَاہِیمَ أَغْنِیَائُ عَنِ الشِّرْکِ۔","","Musannaf Ibn Abi Shaybah 23924","","","كتاب الطب"
"23925","(۲۳۹۲۵) حَدَّثَنَا ہُشَیمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : رَأَی ابْنُ مَسْعُودٍ عَلَی بَعْضِ أَہْلِہِ شَیْئًا قَدْ تَعَلَّقَہُ ، فَنَزَعَہُ مِنْہُ نَزْعًا عَنِیفًا ، وَقَالَ : إِنَّ آلَ ابْنِ مَسْعُودٍ أَغْنِیَائُ عَنِ الشِّرْکِ۔","","Musannaf Ibn Abi Shaybah 23925","","","كتاب الطب"
"23926","(۲۳۹۲۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ الْحُصَیْنِ ، أَنَّہُ رَأَی فِی یَدِ رَجُلٍ حَلْقَۃً مِنْ صُفْرٍ ، فَقَالَ : مَا ہَذِہِ ؟ قَالَ : مِنَ الْوَاہِنَۃِ ، قَالَ : لَمْ یَزِدْکَ إِلاَّ وَہْنًا ، لَوْ مِتَّ وَأَنْتَ تَرَاہَا نَافِعَتَکَ لَمِتَّ عَلَی غَیْرِ الْفِطْرَۃِ۔ (ابن ماجہ ۳۵۳۱۔ احمد ۴/۴۴۵)","Hasan","Musannaf Ibn Abi Shaybah 23926","","","كتاب الطب"
"23927","(۲۳۹۲۷) حَدَّثَنَا ہُشَیمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٍ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ الْحُصَیْنِ ؛ مِثْلَ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 23927","","","كتاب الطب"
"23928","(۲۳۹۲۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَزِیدَ ، قَالَ : أَخْبَرَنِی زَیْدُ بْنُ وَہْبٍ ، قَالَ : انْطَلَقَ حُذَیْفَۃُ إِلَی رَجُلٍ مِنَ النَّخَعِ یَعُودُہُ ، فَانْطَلَقَ وَانْطَلَقْتُ مَعَہُ ، فَدَخَلَ عَلَیْہِ وَدَخَلْتُ مَعَہُ ، فَلَمَسَ عَضُدَہُ ، فَرَأَی فِیہِ خَیْطًا ، فَأَخَذَہُ فَقَطَعَہُ ، ثُمَّ قَالَ : لَوْ مِتَّ وَہَذَا فِی عَضُدِکَ مَا صَلَّیْتُ عَلَیْکَ۔","Da'if","Musannaf Ibn Abi Shaybah 23928","","","كتاب الطب"
"23929","(۲۳۹۲۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ أَبِی ظِبْیَانَ، عَنْ حُذَیْفَۃَ، قَالَ: دَخَلَ عَلِیٌّ عَلَی رَجُلٍ یَعُودُہُ، فَوَجَدَ فِی عَضُدِہِ خَیْطًا، قَالَ: فَقَالَ: مَا ہَذَا؟ قَالَ : خَیْطٌ رُقِیَ لِی فِیہِ ، فَقَطَعَہُ ، ثُمَّ قَالَ : لَوْ مِتَّ مَا صَلَّیْتُ عَلَیْکَ۔","Sahih","Musannaf Ibn Abi Shaybah 23929","","","كتاب الطب"
"23930","(۲۳۹۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانُ ، عَنْ إِبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ؛ أَنَّہُ کَرِہَ تَعْلِیقَ شَیْئٍ مِنَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 23930","","","كتاب الطب"
"23931","(۲۳۹۳۱) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ ، عَنْ أَبِی الْخَیْرِ ، عنْ عُقْبَۃَ بْنِ عَامِرٍ ، قَالَ : مَوْضِعُ التَّمِیمَۃِ مِنَ الإِِنْسَان وَالطِّفْلِ شِرْکٌ۔","Sahih","Musannaf Ibn Abi Shaybah 23931","","","كتاب الطب"
"23932","(۲۳۹۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : مَنْ تَعَلَّقَ عَلاَقَۃً وُکِلَ إِلَیْہَا۔","","Musannaf Ibn Abi Shaybah 23932","","","كتاب الطب"
"23933","(۲۳۹۳۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ التَّمَائِمَ کُلَّہَا ، مِنَ الْقُرْآنِ وَغَیْرِ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 23933","","","كتاب الطب"
"23934","(۲۳۹۳۴) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23934","","","كتاب الطب"
"23935","(۲۳۹۳۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : أُعَلِّقُ فِی عَضُدِی ہَذِہِ الآیَۃَ : {یَا نَارُ کُونِی بَرْدًا وَسَلاَمًا عَلَی إِبْرَاہِیمَ} مِنْ حُمَّی کَانَتْ بِی ؟ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23935","","","كتاب الطب"
"23936","(۲۳۹۳۶) حَدَّثَنَا شَرِیکٌ ، عَنْ ہِلاَلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ عَلَّقَ التَّمَائِمَ وَعَقَدَ الرَّقَی ، فَہُوَ عَلَی شُعْبَۃٍ مِنَ الشِّرْکِ۔","","Musannaf Ibn Abi Shaybah 23936","","","كتاب الطب"
"23937","(۲۳۹۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ التَّمَائِمَ وَالرَّقَی وَالنَّشَرَ۔","","Musannaf Ibn Abi Shaybah 23937","","","كتاب الطب"
"23938","(۲۳۹۳۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ؛ أَنَّ سَعِیدَ بْنَ جُبَیْرٍ رَأَی إِنْسَانًا یَطُوفُ بِالْبَیْتِ فِی عُنُقِہِ خَرَزَۃٌ فَقَطَعَہَا۔","","Musannaf Ibn Abi Shaybah 23938","","","كتاب الطب"
"23939","(۲۳۹۳۹) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَنْ قَطَعَ تَمِیمَۃً عَنْ إِنْسَانٍ کَانَ کَعِدْلِ رَقَبَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 23939","","","كتاب الطب"
"23940","(۲۳۹۴۰) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ قَتَادَۃَ، عَنْ وَاقِعِ بْنِ سَحْبَانَ، قَالَ: قَالَ عَبْدُ اللہِ: مَنْ عَلَّقَ شَیْئًا وُکِلَ إِلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 23940","","","كتاب الطب"
"23941","(۲۳۹۴۱) حَدَّثَنَا وَکِیعٌ ، عَنِ أَبِی شِہَابٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کَانَتْ بِہِ شَقِیقَۃٌ ، قَالَ : فَقَالَ لَہُ رَجُلٌ : أَرْقِیکَ مِنْہَا ؟ قَالَ : لاَ حَاجَۃَ لِی بِالرَّقَی۔","","Musannaf Ibn Abi Shaybah 23941","","","كتاب الطب"
"23942","(۲۳۹۴۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ الْمَعَاذَۃَ لِلصِّبْیَانِ ، وَیَقُولُ : إِنَّہُمْ یَدْخُلُونَ بِہِ الْخَلاَئَ۔","","Musannaf Ibn Abi Shaybah 23942","","","كتاب الطب"
"23943","(۲۳۹۴۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہَاشِمِ بْنِ ہَاشِمٍ ، قَالَ : سَمِعْتُ عَامِرَ بْنَ سَعْدِ بْنِ أَبِی وَقَّاصٍ یَقُولُ : سَمِعْتُ سَعْدًا یَقُولُ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ تَصَبَّحَ بِسَبْعِ تَمَرَاتِ عَجْوَۃٍ ، لَمْ یَضُرَّہُ ذَلِکَ الْیَوْمَ سَمٌّ ، وَلاَ سِحْرٌ۔ (بخاری ۵۴۴۵۔ مسلم ۱۵۴)","Sahih","Musannaf Ibn Abi Shaybah 23943","","","كتاب الطب"
"23944","(۲۳۹۴۴) حَدَّثَنَا یَزِیدُ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعَجْوَۃُ مِنَ الْجَنَّۃِ ، وَہِیَ شِفَائٌ مِنَ السَّمِّ۔ (ترمذی ۲۰۶۸۔ احمد ۳/۴۸)","Da'if","Musannaf Ibn Abi Shaybah 23944","","","كتاب الطب"
"23945","(۲۳۹۴۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَأْمُرُ مِنَ الدَّوَامِ ، أَوِ الدَّوَارِ بِسَبْعِ تَمَرَاتٍ عَجْوَۃٍ ، فِی سَبْعِ غَدَوَاتٍ عَلَی الرِّیقِ۔","Sahih","Musannaf Ibn Abi Shaybah 23945","","","كتاب الطب"
"23946","(۲۳۹۴۶) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ بِلاَلٍ ، قَالَ : حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ بْنِ أَبِی نَمِرٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ أَبِی عَتِیقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی عَجْوَۃِ الْعَالِیَۃِ شِفَائٌ أَوْ : إِنَّہَا تِرْیَاقٌ فِی أَوَّلِ الْبُکْرَۃِ عَلَی الرِّیقِ۔ (مسلم ۱۶۱۹۔ نسائی ۶۷۱۴)","Hasan","Musannaf Ibn Abi Shaybah 23946","","","كتاب الطب"
"23947","(۲۳۹۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، عَنْ أَنَسٍ ؛ أَنَّ أُمَّ سُلَیْمٍ وَلَدَتْ غُلاَمًا ، فَقَالَ لِی أَبُو طَلْحَۃَ : احْمِلْہُ حَتَّی تَأْتِیَ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأَتَی بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَبَعَثَ مَعَہُ بِتَمَرَاتٍ ، فَأَخَذَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مَعَہُ شَیْئٌ ؟ قَالُوا : نَعَمْ ، تَمَرَاتٌ ، فَأَخَذَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَمَضَغَہَا ، ثُمَّ أَخَذَ مِنْ فِیہِ فَجَعَلَہُ فِی فِیِّ الصَّبِیِّ ، ثُمَّ حَنَّکَہُ بِہِ ، وَسَمَّاہُ عَبْدَ اللہِ۔ (بخاری ۵۴۷۰۔ مسلم ۱۶۸۹)","Sahih","Musannaf Ibn Abi Shaybah 23947","","","كتاب الطب"
"23948","(۲۳۹۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ بُرَیدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ : وُلِدَ لِی غُلاَمٌ ، فَأَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَمَّاہُ إِبْرَاہِیمَ ، وَحَنَّکَہُ بِتَمْرَۃٍ۔ (بخاری ۶۱۹۸۔ مسلم ۲۴)","Sahih","Musannaf Ibn Abi Shaybah 23948","","","كتاب الطب"
"23949","(۲۳۹۴۹) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ مُسْہِرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ أَسْمَائَ بِنْتِ أَبِی بَکْرٍ ؛ أَنَّہَا أَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِابْنِ الزُّبَیْرِ حِینَ وَضَعَتْہُ ، وَطَلَبُوا تَمْرَۃً حَتَّی وَجَدُوہَا فَحَنَّکَہُ بِہَا ، فَکَانَ أَوَّلَ شَیْئٍ دَخَلَ بَطْنَہُ رِیقُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (بخاری ۳۹۰۹۔ مسلم ۱۶۹۱)","Hasan","Musannaf Ibn Abi Shaybah 23949","","","كتاب الطب"
"23950","(۲۳۹۵۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُؤْتَی بِالصِّبْیَانِ فَیُبَرِّکُ عَلَیْہِمْ وَیُحَنِّکُہُمْ۔ (بخاری ۶۰۰۲۔ مسلم ۱۶۹۱)","Sahih","Musannaf Ibn Abi Shaybah 23950","","","كتاب الطب"
"23951","(۲۳۹۵۱) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ إِسْمَاعِیلَ بْنِ مُسْلِمٍ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ، عَنْ جَابِرٍ، قَالَ: سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: عَلَیْکُمْ بِالإِثْمِدِ عِنْدَ النَّوْمِ، فَإِنَّہُ یَشُدُّ الْبَصَرَ وَیُنْبِتُ الشَّعْرَ۔n(ابن ماجہ ۳۴۹۶)","Da'if","Musannaf Ibn Abi Shaybah 23951","","","كتاب الطب"
"23952","(۲۳۹۵۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیْمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: خَیْرُ أَکْحَالِکُمُ الإِثْمِدُ، یَجْلُو الْبَصَرَ، وَیُنْبِتُ الشَّعْرَ۔","Hasan","Musannaf Ibn Abi Shaybah 23952","","","كتاب الطب"
"23953","(۲۳۹۵۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ عِمْرَانَ بْنِ أَبِی أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَکْتَحِلُ بِالإِثْمِدِ ، وَیَکْحَلُ الْیُمْنَی ثَلاَثَ مَرَاوِد ، وَالْیُسْرَی مِرْوَدَیْنِ۔ (ابن سعد ۴۸۴)","","Musannaf Ibn Abi Shaybah 23953","","","كتاب الطب"
"23954","(۲۳۹۵۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ حَفْصَۃَ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَکْتَحِلُ ثَلاَثًا فِی کُلِّ عَیْنٍ۔","Sahih","Musannaf Ibn Abi Shaybah 23954","","","كتاب الطب"
"23955","(۲۳۹۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَکْتَحِلُ اثْنَتَیْنِ فِی ذِہِ ، وَاثْنَتَیْنِ فِی ذِہِ ، وَوَاحِدَۃً بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 23955","","","كتاب الطب"
"23956","(۲۳۹۵۶) حَدَّثَنَا یَزِیدُ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُکْحُلَۃٌ یَکْتَحِلُ بِہَا ثَلاَثًا فِی کُلِّ عَیْنٍ۔ (ترمذی ۲۰۴۸۔ ابن ماجہ ۳۴۹۹)","Da'if","Musannaf Ibn Abi Shaybah 23956","","","كتاب الطب"
"23957","(۲۳۹۵۷) حَدَّثَنَا شَبَابَۃ قَالَ : حَدَّثَنَا شُعْبَۃُ ، عَنْ سِمَاکٍ ، عَنْ عَلْقَمَۃَ بْنِ وَائِلٍ ، عَنْ أَبِیہِ ؛ أَنَّ رَجُلاً مِنْ جُعْفَی ، یُقَالَ لَہُ : سُوَیْد بْنُ طَارِقٍ ، سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْخَمْرِ ؟ فَنَہَاہُ عَنْہَا ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنَّمَا نَصْنَعہَا لِدَوَائٍ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّہَا دَائٌ وَلَیْسَتْ بِدَوَائٍ۔","Hasan","Musannaf Ibn Abi Shaybah 23957","","","كتاب الطب"
"23958","(۲۳۹۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ؛ أَنَّ رَجُلاً أَصَابَہُ الصَّفْرُ ، فَنُعِتَ لَہُ السَّکَرُ ، فَسَأَلَ عَبْدَ اللہِ عَنْ ذَلِکَ ؟ فَقَالَ : إِنَّ اللَّہَ لَمْ یَجْعَلْ شِفَائَکُمْ فِیمَا حَرَّمَ عَلَیْکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 23958","","","كتاب الطب"
"23959","(۲۳۹۵۹) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَتْ لابْنِ عُمَرَ بُخْتِیَّۃٌ ، وَإِنَّہَا مَرِضَتْ ، فَوُصِفَ لِی أَنْ أُدَاوِیَہَا بِالْخَمْرِ ، فَدَاوَیْتُہَا ، ثُمَّ قُلْتُ لابْنِ عُمَرَ : إِنَّہُمْ وَصَفُوا لِی أَنْ أُدَاوِیَہَا بِالْخَمْرِ ، قَالَ : فَفَعَلْتَ ؟ قُلْتُ : لاَ ، وَقَدْ کُنْتُ فَعَلْتُ ، قَالَ : أَمَا إِنَّک لَوْ فَعَلْتَ عَاقَبْتُکَ۔","Hasan","Musannaf Ibn Abi Shaybah 23959","","","كتاب الطب"
"23960","(۲۳۹۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ ابْنُ عَامِرٍ ، وَابْنُ زِیَادٍ : لاَ أُوتَی بِأَحَدٍ سَقَی صَبِیًّا خَمْرًا إِلاَّ جَلَدْتُہُ ۔ قَالَ ابْنُ عَوْنٍ : وَحِفْظِی : ابْنُ زِیَادٍ۔","","Musannaf Ibn Abi Shaybah 23960","","","كتاب الطب"
"23961","(۲۳۹۶۱) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ عَبْدِاللہِ بْنِ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ تُسْقَی الْبَہَائِمُ الْخَمْرَ۔","Hasan","Musannaf Ibn Abi Shaybah 23961","","","كتاب الطب"
"23962","(۲۳۹۶۲) حَدَّثَنَا عَبْدُالرَّحِیمِ، عَنْ عُبَیْدَۃَ، عَنْ إِبْرَاہِیمَ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُتَدَاوَی بِالْخَمْرِ، وَبِدَمِ الْحَلَمِ، وَبِالنَّارِ۔","","Musannaf Ibn Abi Shaybah 23962","","","كتاب الطب"
"23963","(۲۳۹۶۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، قَالَ : سَمِعْتُ الْحَسَنَ وَسُئِلَ عَنْ صَبِیٍّ یَشْتَکِی ، نُعِتَ لَہُ قَطْرَۃٌ مِنْ خَمْرٍ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 23963","","","كتاب الطب"
"23964","(۲۳۹۶۴) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ عَائِشَۃَ کَانَتْ تَقُولُ : مَنْ تَدَاوَی بِالْخَمْرِ فَلاَ شَفَاہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 23964","","","كتاب الطب"
"23965","(۲۳۹۶۵) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ عَامِرٍ ، قَالَ : قَالَ ابْنُ عَامِرٍ : مَنْ سَقَی صَبِیًّا خَمْرًا جَلَدْنَا الَّذِی سَقَاہُ۔","Sahih","Musannaf Ibn Abi Shaybah 23965","","","كتاب الطب"
"23966","(۲۳۹۶۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ مِسْعَرٍ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ؛ أَنَّ ابْنَ عُمَرَ کَرِہَ أَنْ یُدَاوَی دَبَرُ الإِبِلِ بِالْخَمْرِ۔","","Musannaf Ibn Abi Shaybah 23966","","","كتاب الطب"
"23967","(۲۳۹۶۷) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، قَالَ : حدَّثَنَا أَیْمَنُ بْنُ نَابِلٍ ، عَنْ أُمِّ کُلْثُومِ ابْنَۃِ عَمْرٍو ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلَیْکُمْ بِالْبَغِیضِ النَّافِعِ ، یَعْنِی التَّلْبِینَۃَ ، فَوَالَّذِی نَفْسِی بِیَدِہِ ، إِنَّہُ لَیَغْسِلُ بَطْنَ أَحَدِکُمْ کَمَا یَغْسِلُ أَحَدُکُمْ وَجْہَہُ مِنَ الْوَسَخِ ، وَکَانَ إِذَا اشْتَکَی أَحَدٌ مِنْ أَہْلِہِ ، لَمْ تَزَلِ الْبُرْمَۃُ عَلَی النَّارِ حَتَّی یَأْتِیَ عَلَی أَحَدِ طَرَفَیْہِ۔ (ترمذی ۲۰۳۹۔ احمد ۶/۳۲)","Da'if","Musannaf Ibn Abi Shaybah 23967","","","كتاب الطب"
"23968","(۲۳۹۶۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، عَنْ مَکْحُولٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَحْتَجِمُ أَسْفَلَ مِنَ الذُّؤَابَۃِ ، وَیُسَمِّیہَا مُنْقِذًا۔","","Musannaf Ibn Abi Shaybah 23968","","","كتاب الطب"
"23969","(۲۳۹۶۹) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : احْتَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثًا عَلَی الأَخْدَعَیْنِ ، وَعَلَی الْکَاہِلِ وَاحِدَۃً۔ (ترمذی ۲۰۵۱۔ ابوداؤد ۳۸۵۶)","Sahih","Musannaf Ibn Abi Shaybah 23969","","","كتاب الطب"
"23970","(۲۳۹۷۰) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ بِلاَلٍ ، قَالَ : حَدَّثَنِی عَلْقَمَۃُ بْنُ أَبِی عَلْقَمَۃَ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَن الأَعْرَجَ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ بُحَیْنَۃَ یَقُولُ : احْتَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِلَحْیِ جَمَلٍ وَہُوَ مُحْرِمٌ ، وَسَطَ رَأْسِہِ۔ (بخاری ۱۸۳۶۔ ابن ماجہ ۳۴۸۱)","Hasan","Musannaf Ibn Abi Shaybah 23970","","","كتاب الطب"
"23971","(۲۳۹۷۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا یَحْیَی بْنُ یَزِیدَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ بِمَکَانٍ بِطَرِیقِ مَکَّۃَ ، بِمَعْدِنٍ یُدْعَی لَحْیَ جَمَلٍ وَہُوَ مُحْرِمٌ فَوْقَ رَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 23971","","","كتاب الطب"
"23972","(۲۳۹۷۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مَنْصُورٍ ، قَالَ : قُلْتُ لِمُجَاہِدٍ : احْتَجَمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : إِلاَّ أَنَّ رِجْلَہُ وُثِئَتْ فَحَجَمَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 23972","","","كتاب الطب"
"23973","(۲۳۹۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ احْتَجَمَ وَہُوَ مُحْرِمٌ فِی رَأْسِہِ ، مِنْ أَذًی کَانَ بِہِ۔ (بخاری ۵۶۹۹۔ ابوداؤد ۱۸۳۲)","Sahih","Musannaf Ibn Abi Shaybah 23973","","","كتاب الطب"
"23974","(۲۳۹۷۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِذَا عَسِرَ عَلَی الْمَرْأَۃِ وَلَدُہَا ، فَیَکْتُبُ ہَاتَیْنِ الآیَتَیْنِ وَالْکَلِمَاتِ فِی صَحْفَۃٍ ، ثُمَّ تُغْسَلُ فَتُسْقَی مِنْہَا : بِسْمِ اللہِ الَّذِی لاَ إِلَہَ إِلاَّ ہُوَ الْحَلِیمُ الْکَرِیمُ ، سُبْحَانَ اللہِ رَبِّ السَّمَاوَاتِ السَّبْعِ وَرَبِّ الْعَرْشِ الْعَظِیمِ: {کَأَنَّہُمْ یَوْمَ یَرَوْنَہَا لَمْ یَلْبَثُوا إِلاَّ عَشِیَّۃً ، أَوْ ضُحَاہَا} ، {کَأَنَّہُمْ یَوْمَ یَرَوْنَ مَا یُوعَدُونَ لَمْ یَلْبَثُوا إِلاَّ سَاعَۃً مِنْ نَہَارٍ بَلاَغٌ فَہَلْ یُہْلَکُ إلاَّ الْقَوْمُ الْفَاسِقُونَ}۔","Da'if","Musannaf Ibn Abi Shaybah 23974","","","كتاب الطب"
"23975","(۲۳۹۷۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ لاَ تَرَی بَأْسًا أَنْ یُعَوَّذَ فِی الْمَائِ ، ثُمَّ یُصَبَّ عَلَی الْمَرِیضِ۔","","Musannaf Ibn Abi Shaybah 23975","","","كتاب الطب"
"23976","(۲۳۹۷۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ (ح) وَلَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُمَا لَمْ یَرَیَا بَأْسًا أَنْ یَکْتُبَ آیَۃً مِنَ الْقُرْآنِ ، ثُمَّ یُسْقَاہُ صَاحِبُ الْفَزَعِ۔","","Musannaf Ibn Abi Shaybah 23976","","","كتاب الطب"
"23977","(۲۳۹۷۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حَجَّاجٌ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی سَعِیدَ بْنَ جُبَیْرٍ یَکْتُبُ التَّعْوِیذَ لِمَنْ أَتَاہُ ، قَالَ حَجَّاجٌ : وَسَأَلْتُ عَطَائً ؟ فَقَالَ : مَا سَمِعْنَا بِکَرَاہِیَتِہِ إِلاَّ مِنْ قِبَلِکُمْ أَہْل الْعِرَاقِ۔","","Musannaf Ibn Abi Shaybah 23977","","","كتاب الطب"
"23978","(۲۳۹۷۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، قَالَ : أَخْبَرَنَا قَتَادَۃُ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : سَأَلْتُُہُ عَنِ النَّشَرِ ، فَأَمَرَنِی بِہَا ، قُلْتُ : أَرْوِیہَا عَنْکَ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 23978","","","كتاب الطب"
"23979","(۲۳۹۷۹) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ؛ أَنَّ أُمَّ الْمُؤْمِنِینَ عَائِشَۃَ سُئِلَتْ عَنِ النَّشَرِ ؟ فَقَالَتْ : مَا تَصْنَعُونَ بِہَذَا ؟ ہَذَا الْفُرَاتُ إِلَی جَانِبِکُمْ ، یَسْتَنْقِعُ فِیہِ أَحَدُکُمْ سَبْعًا یَسْتَقْبِلُ الْجِرْیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 23979","","","كتاب الطب"
"23980","(۲۳۹۸۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ کَانَ بِالْکُوفَۃِ یَکْتُبُ مِن الفَزَع آیَاتٍ مِنَ الْقُرْآنِ ، فَیُسْقَاہُ الْمَرِیضُ ؟ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 23980","","","كتاب الطب"
"23981","(۲۳۹۸۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، قَالَ : سَمِعْتُ الْحَسَنَ وَسُئِلَ عَنِ النَّشَرِ ؟ فَقَالَ : سِحْرٌ۔","","Musannaf Ibn Abi Shaybah 23981","","","كتاب الطب"
"23982","(۲۳۹۸۲) حَدَّثَنَاَ ابْنُ عُیَیْنَۃَ ، وَأَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی رَجَائٍ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنِ النَّشَرِ ؟ فَذَکَرَ لِی عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ہِیَ مِنْ عَمَلِ الشَّیْطَانِ۔ (بزار ۳۰۳۴)","Hasan","Musannaf Ibn Abi Shaybah 23982","","","كتاب الطب"
"23983","(۲۳۹۸۳) حَدَّثَنَا عَثَّام بْنُ عَلِیٍّ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عائِشَۃَ ، قَالَتْ: مَنْ أَصَابَہُ نُشْرَۃٌ، أَوْ سَمٌّ ، أَوْ سِحْرٌ ، فَلْیَأْتِ الْفُرَاتَ ، فَلْیَسْتَقْبِلِ الْجِرْیَۃَ ، فَیَغْتَمِسَ فِیہِ سَبْعَ مَرَّاتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 23983","","","كتاب الطب"
"23984","(۲۳۹۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ یَزِیدَ بْنِ حَیَّانَ ، عَنْ زَیْدِ بْنِ أَرْقَمَ ، قَالَ : سَحَرَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ مِنَ الْیَہُودِ ، فَاشْتَکَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِذَلِکَ أَیَّامًا ، فَأَتَاہُ جِبْرِیلُ فَقَالَ : إِنَّ رَجُلاً کَذَا مِنَ الْیَہُودِ سَحَرَکَ ، عَقَدَ لَکَ عُقَدًا ، فَأَرْسَلَ إِلَیْہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلِیًّا ، فَاسْتَخْرَجَہَا ، فَجَائَ بِہِ ، فَجَعَلَ کُلَّمَا حَلَّ عُقْدَۃً وَجَدَ لِذَلِکَ خِفَّۃً ، قَالَ : فَقَامَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَأَنَّمَا نُشِطَ مِنْ عِقَالٍ ، فَمَا ذُکِرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَلِکَ الْیَہُودِیَّ ، وَلاَ رَآہُ فِی وَجْہِہِ قَطُّ۔ (احمد ۴/۳۶۷۔ حاکم ۳۶۰)","","Musannaf Ibn Abi Shaybah 23984","","","كتاب الطب"
"23985","(۲۳۹۸۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : سَحَرَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَہُودِیٌّ مِنْ یَہُودِ بَنِی زُرَیْقٍ ، یُقَالَ لَہُ : لَبِیدُ بْنُ الأَعْصَمِ ، حَتَّی کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُخَیَّلُ إِلَیْہِ أَنَّہُ یَفْعَلُ الشَّیْئَ وَلاَ یَفْعَلُہُ ، حَتَّی إِذَا کَانَ ذَاتَ یَوْمٍ ، أَوْ ذَاتَ لَیْلَۃٍ ، دَعَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ دَعَا ، ثُمَّ قَالَ : یَا عَائِشَۃُ ، أَشَعَرْتِ أَنَّ اللَّہَ قَدْ أَفْتَانِی فِیمَا اسْتَفْتیہ فِیہِ ؟ جَائَنِی رَجُلاَنِ ، فَجَلَسَ أَحَدُہُمَا عِنْدَ رَأْسِی ، وَالآخَرُ عِنْدَ رِجْلِی ، فَقَالَ الَّذِی عِنْدَ رَأْسِی لِلَّذِی عِنْدَ رِجْلِی ، أَوِ الَّذِی عِنْدَ رِجْلِی لِلَّذِی عِنْدَ رَأْسِی : مَا وَجَعُ الرَّجُلِ ؟ قَالُوا : مَطْبُوبٌ ، قَالَ : مَنْ طَبَّہُ ؟ قَالَ : لَبِیدُ بْنُ الأَعْصَمِ ، قَالَ : فِی أَیِّ شَیْئٍ ؟ قَالَ : فِی مُشْطٍ وَمُشَاطَۃٍ ، وَجُفِّ طَلْعَۃِ ذَکَرٍ ، قَالَ : وَأَیْنَ ہُوَ ؟ قَالَ : فِی بِئْرِ ذِی أَرْوَانَ ، فَأَتَاہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی أُنَاسٍ مِنْ أَصْحَابِہِ ، ثُمَّ جَائَ فَقَالَ : یَا عَائِشَۃُ ، کَأَنَّمَا مَاؤُہَا نُقَاعَۃُ الْحِنَّائِ ، وَلَکَأَنَّ نَخْلَہَا رُؤُوسُ الشَّیَاطِینِ ، قَالَ : فَقُلْتُ : یَا رَسُولَ اللہِ ، أَفَلاَ أَخْرَجْتَہُ ؟ فَقَالَ : لاَ ، أَمَّا أَنَا فَقَدْ عَافَانِی اللَّہُ ، وَکَرِہْتُ أَنْ أُثِیرَ عَلَی النَّاسِ مِنْہُ شَرًّا ، فَأَمَرَ بِہَا فَدُفِنَتْ۔ (بخاری ۳۱۷۵۔ مسلم ۱۷۱۹)","Sahih","Musannaf Ibn Abi Shaybah 23985","","","كتاب الطب"
"23986","(۲۳۹۸۶) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لَمَّا فُتِحَتْ خَیْبَرُ ، أُہْدِیَتْ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَاۃٌ فِیہَا سَمٌّ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اجْمَعُوا لِی مَنْ کَانَ ہَاہُنَا مِنَ الْیَہُودِ ، فَقَالَ لَہُمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَلْ جَعَلْتُمْ فِی ہَذِہِ الشَّاۃِ سُمًّا ؟ قَالُوا : نَعَمْ ، قَالَ : مَا حَمَلَکُمْ عَلَی ذَلِکَ ؟ قَالُوا : أَرَدْنَا إِنْ کُنْتَ کَاذِبًا أَنْ نَسْتَرِیحُ مِنْکَ ، وَإِنْ کُنْتَ نَبِیًّا لَمْ یَضُرَّکَ۔ (بخاری ۳۱۶۹۔ ابوداؤد ۴۵۰۱)","Sahih","Musannaf Ibn Abi Shaybah 23986","","","كتاب الطب"
"23987","(۲۳۹۸۷) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَأْتِیَ الْمُؤْخَذُ عَنْ أَہْلِہِ ، وَالْمَسْحُورُ ، مَنْ یُطْلِقُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 23987","","","كتاب الطب"
"23988","(۲۳۹۸۸) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، قَالَ : سَأَلْتُ عَطَائً الْخُرَاسَانِیَّ عَنِ الْمُؤْخَذِ وَالْمَسْحُورِ ، یَأْتِی مَنْ یُطْلِقُ عَنْہُ ؟ قَالَ : لاَ بَأْسَ بِذَلِکَ إِذَا اضْطُرَّ إِلَیْہِ۔","","Musannaf Ibn Abi Shaybah 23988","","","كتاب الطب"
"23989","(۲۳۹۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قُلْتُ لَہُ : رَجُلٌ طُبَّ بِسِحْرٍ ، یُحَلَّ عَنْہُ ؟ قَالَ : نَعَمْ ، مَنِ اسْتَطَاعَ أَنْ یَنْفَعَ أَخَاہُ فَلْیَفْعَلْ۔","","Musannaf Ibn Abi Shaybah 23989","","","كتاب الطب"
"23990","(۲۳۹۹۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَجَّاجٍ الصَّوَّافِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ ہِلاَلِ بْنِ أَبِی مَیْمُونَۃَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ مُعَاوِیَۃَ بْنِ الْحَکَمِ السُّلَمِیِّ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، إِنِّی حَدِیثُ عَہْدٍ بِجَاہِلِیَّۃٍ ، وَقَدْ جَائَ اللَّہُ بِالإِسْلاَمِ ، وَإِنَّ مِنَّا رِجَالاً یَأْتُونَ الْکُہَّانَ ، قَالَ : فَلاَ تَأْتِہمْ۔ (مسلم ۳۸۱۔ ابوداؤد ۹۲۷)","Sahih","Musannaf Ibn Abi Shaybah 23990","","","كتاب الطب"
"23991","(۲۳۹۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : حدَّثَنَا الشَّیْبَانِیُّ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ ، قَالَ: قَالَ عَلِیٌّ: إِنَّ ہَؤُلاَئِ الْعَرَّافِینَ کُہَّانُ الْعَجَمِ ، فَمَنْ أَتَی کَاہِنًا یُؤْمِنُ بِمَا یَقُولُ ، فَقَدْ بَرِئَ مِمَّا أَنْزَلَ اللَّہُ عَلَی مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 23991","","","كتاب الطب"
"23992","(۲۳۹۹۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : لَدِرْہَمُ مِینٍ خَیْرٌ مِنْ قَلْبِ رَجُلٍ یَأْتِی الْعَرَّافَ۔","Sahih","Musannaf Ibn Abi Shaybah 23992","","","كتاب الطب"
"23993","(۲۳۹۹۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی بَکْرٍ ، عَنْ أَبِی مَسْعُودٍ ؛ أَنَّ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ حُلْوَانِ الْکَاہِنِ۔","Sahih","Musannaf Ibn Abi Shaybah 23993","","","كتاب الطب"
"23994","(۲۳۹۹۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، وَوَکِیعٌ ، قَالاَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ مَشَی إِلَی سَاحِرٍ ، أَوْ کَاہِنٍ ، أَوْ عَرَّافٍ فَصَدَّقَہُ بِمَا یَقُولُ ، فَقَدْ کَفَرَ بِمَا أَنْزَلَ اللَّہُ عَلَی مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Hasan","Musannaf Ibn Abi Shaybah 23994","","","كتاب الطب"
"23995","(۲۳۹۹۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنِ الشَّیْبَانِیِّ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ، عَنْ أَبِیہِ، عَنْ عَائِشَۃَ، قَالَ: سَأَلْتُہَا عَنِ الرُّقْیَۃِ مِنَ الْحُمَۃِ ؟ فَقَالَتْ : رَخَّصَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الرُّقْیَۃِ مِنْ کُلِّ ذِی حُمَۃٍ۔ (بخاری ۵۷۴۱۔ مسلم ۱۷۲۴)","Sahih","Musannaf Ibn Abi Shaybah 23995","","","كتاب الطب"
"23996","(۲۳۹۹۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الرُّقَی ، وَکَانَ عِنْدَ آلِ عَمْرِو بْنِ حَزْمٍ رُقْیَۃٌ یَرْقُونَ بِہَا مِنَ الْعَقْرَبِ ، قَالَ : فَأَتَوُا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَرَضُوہَا عَلَیْہِ ، وَقَالُوا : إِنَّکَ نَہَیْتَ عَنِ الرُّقَی ، فَقَالَ : مَنِ اسْتَطَاعَ مِنْکُمْ أَنْ یَنْفَعَ أَخَاہُ فَلْیَفْعَلْ۔ (مسلم ۱۷۲۶۔ احمد ۳/۳۱۵)","Hasan","Musannaf Ibn Abi Shaybah 23996","","","كتاب الطب"
"23997","(۲۳۹۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، عَنْ بَعْضِ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ رُقْیَۃَ إِلاَّ مِنْ عَیْنٍ ، أَوْ حُمَۃٍ۔ (ابوداؤد ۳۸۸۰۔ ترمذی ۲۰۵۷)","Da'if","Musannaf Ibn Abi Shaybah 23997","","","كتاب الطب"
"23998","(۲۳۹۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَدَغَتْنِی عَقْرَبٌ ، فَابْتَدَرَ مَنْخَرَایَ دَمًا ، فَرَقَانِی الأَسْوَدُ فَبَرَأْتُ۔","","Musannaf Ibn Abi Shaybah 23998","","","كتاب الطب"
"23999","(۲۳۹۹۹) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بِرُقْیَۃِ الْحُمَۃِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 23999","","","كتاب الطب"
"24000","(۲۴۰۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، قَالَ : رُخِّصَ فِی الرُّقَی مِنَ الْحُمَۃِ ، وَالنَّمْلَۃِ ، وَالنَّفْسِ۔","","Musannaf Ibn Abi Shaybah 24000","","","كتاب الطب"
"24001","(۲۴۰۰۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عُمَارَۃَ ، عَنْ أَبِی بَکْرِ بْنِ مُحَمَّدٍ ؛ أَنَّ خَالِدَۃَ بِنْتَ أَنَسٍ أُمَّ بَنِی حَزْمٍ السَّاعِدِی جَائَ تْ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَرَضَتْ عَلَیْہِ الرُّقَی ، فَأَمَرَہَا بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 24001","","","كتاب الطب"
"24002","(۲۴۰۰۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمٍ ، عَنْ یُوسُفَ بْنِ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أَنَسٍ ، قَالَ : رَخَّصَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الرُّقْیَۃِ مِنَ الْعَیْنِ وَالْحُمَۃِ۔ (مسلم ۱۷۲۵۔ ترمذی ۲۰۵۶)","Sahih","Musannaf Ibn Abi Shaybah 24002","","","كتاب الطب"
"24003","(۲۴۰۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ: رَأَی ابْنُ مَسْعُودٍ عَلَی ابْنِہِ قَصَبَۃً مِنَ الْحُمَّی ، فَقَطَعَہَا، فَقَالَ : لاَ رُقْیَۃَ إِلاَّ مِنْ عَیْنٍ ، أَوْ حُمَۃٍ۔","","Musannaf Ibn Abi Shaybah 24003","","","كتاب الطب"
"24004","(۲۴۰۰۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ اسْتَرْقَی مِنَ الْعَقْرَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 24004","","","كتاب الطب"
"24005","(۲۴۰۰۵) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ: کَانَ لآلِ الأَسْوَدِ رُقْیَۃٌ یَرْقُونَ بِہَا فِی الْجَاہِلِیَّۃِ مِنَ الْحُمَۃِ ، قَالَ : فَعَرَضَہَا الأَسْوَدُ عَلَی عَائِشَۃَ ، قَالَ : فَأَمَرَتْہُمْ أَنْ یَرْقُوا بِہَا ، قَالَ : وَقَالَتْ عَائِشَۃُ : لاَ رُقْیَۃَ إِلاَّ مِنْ عَیْنٍ ، أَوْ حُمَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 24005","","","كتاب الطب"
"24006","(۲۴۰۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ أَبِی بَکْرِ بْنِ سُلَیْمَانَ بْنِ أَبِی حَثْمَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِجَدَّتِہِ الشِّفَائِ بِنْتِ عَبْدِ اللہِ : عَلِّمِی حَفْصَۃَ رُقْیَتَکِ ، قَالَ أَبُو بِشْر : یَعْنِی إِسْمَاعِیلَ ابْنَ عُلَیَّۃَ : فَقُلْتُ لِمُحَمَّدٍ : مَا رُقْیَتُہَا ؟ قَالَ : رُقْیَۃُ النَّمْلَۃِ۔ (احمد ۶/۲۸۶)","","Musannaf Ibn Abi Shaybah 24006","","","كتاب الطب"
"24007","(۲۴۰۰۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَاصِمٍ ، عَنْ یُوسُفَ بْنِ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أَنَسٍ ، قَالَ : رَخَّصَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الرُّقْیَۃِ مِنَ النَّمْلَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 24007","","","كتاب الطب"
"24008","(۲۴۰۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ، قَالَ : حَدَّثَنِی صَالِحُ بْنُ کَیْسَانَ ، عَنْ أَبِی بَکْرِ بْنِ سُلَیْمَانَ بْنِ أَبِی حَثْمَۃَ ، أَنَّ الشِّفَائَ ابْنَۃَ عَبْدِ اللہِ ، قَالَتْ : دَخَلَ عَلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا قَاعِدَۃٌ عِنْدَ حَفْصَۃَ بِنْتِ عُمَرَ ، فَقَالَ : مَا یَمْنَعُکِ أَنْ تُعَلِّمِی ہَذِہِ رُقْیَۃَ النَّمْلَۃِ کَمَا عَلَّمْتِیہَا الْکِتَابَۃَ۔ (ابوداؤد ۳۸۸۳۔ احمد ۳۷۲)","Sahih","Musannaf Ibn Abi Shaybah 24008","","","كتاب الطب"
"24009","(۲۴۰۰۹) حَدَّثَنَا عُقْبَۃُ بْنُ خَالِدٍ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عِصْمَۃَ ، قَالَ: سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ التَّعْوِیذِ؟ فَقَالَ: لاَ بَأْسَ بِہِ إِذَا کَانَ فِی أَدِیمٍ۔","","Musannaf Ibn Abi Shaybah 24009","","","كتاب الطب"
"24010","(۲۴۰۱۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الْحَائِضِ یَکُونُ علَیْہَا التَّعْوِیذُ ، قَالَ : إِنْ کَانَ فِی أَدِیمٍ ، فَلْتَنْزِعْہُ ، وَإِنْ کَانَ فِی قَصَبَۃِ فِضَّۃٍ ، فَإِنْ شَائَ تْ وَضَعَتْہُ ، وَإِنْ شَائَ تْ لَمْ تَضَعْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24010","","","كتاب الطب"
"24011","(۲۴۰۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ ثُوَیْرٍ ، قَالَ : کَانَ مُجَاہِدٌ یَکْتُبُ للنَّاسِ التَّعْوِیذَ فَیُعَلِّقُہُ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 24011","","","كتاب الطب"
"24012","(۲۴۰۱۲) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ حَسَنٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَکْتُبَ الْقُرْآنَ فِی أَدِیمٍ ، ثُمَّ یُعَلِّقُہُ۔","","Musannaf Ibn Abi Shaybah 24012","","","كتاب الطب"
"24013","(۲۴۰۱۳) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا فَزِعَ أَحَدُکُمْ فِی نَوْمِہِ فَلْیَقُلْ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّاتِ مِنْ غَضَبِہِ وَسُوئِ عِقَابِہِ ، وَمِنْ شَرِّ عِبَادِہِ ، وَمِنْ شَرِّ الشَّیَاطِینِ وَمَا یَحْضُرُون ، فَکَانَ عَبْدُ اللہِ یُعَلِّمُہَا وَلَدَہُ مَنْ أَدْرَکَ مِنْہُمْ ، وَمَنْ لَمْ یُدْرِکْ ، کَتَبَہَا وَعَلَّقَہَا عَلَیْہِ۔ (ابوداؤد ۳۸۸۹۔ ترمذی ۳۵۲۸)","","Musannaf Ibn Abi Shaybah 24013","","","كتاب الطب"
"24014","(۲۴۰۱۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إِسْمَاعِیلَ بْنِ مُسْلِمٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالشَّیْئِ مِنَ الْقُرْآنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24014","","","كتاب الطب"
"24015","(۲۴۰۱۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، قَالَ : حدَّثَنَا أَیُّوبُ ؛ أَنَّہُ رَأَی فِی عَضُدِ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ خَیْطًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24015","","","كتاب الطب"
"24016","(۲۴۰۱۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَسَنٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یُعَلَّقَ الْقُرْآنُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24016","","","كتاب الطب"
"24017","(۲۴۰۱۷) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ أَبَانَ بْنِ ثَعْلَبٍ ، عَنْ یُونُسَ بْنِ خَبَّابٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ عَنِ التَّعْوِیذِ یُعَلَّقُ عَلَی الصِّبْیَانِ ؟ فَرَخَّصَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 24017","","","كتاب الطب"
"24018","(۲۴۰۱۸) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بَأْسًا أَنْ یُعَلِّقَ الرَّجُلُ الشَّیْئَ مِنْ کِتَابِ اللہِ ، إِذَا وَضَعَہُ عِنْدَ الْغُسْلِ وَعِنْدَ الْغَائِطِ۔","","Musannaf Ibn Abi Shaybah 24018","","","كتاب الطب"
"24019","(۲۴۰۱۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُطَرِّفٍ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، عَنْ عَلِیٍّ ، قَالَ : بَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ یُصَلِّی ، فَوَضَعَ یَدَہُ عَلَی الأَرْضِ فَلَدَغَتْہُ عَقْرَبٌ ، فَتَنَاوَلَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَعْلِہِ فَقَتَلَہَا ، فَلَمَّا انْصَرَفَ قَالَ : لَعَنَ اللَّہُ الْعَقْرَبَ ، لاَ تَدَعُ مُصَلِّیًا ، وَلاَ غَیْرَہُ ، أَوْ نَبِیًّا ، وَلاَ غَیْرَہُ ، ثُمَّ دَعَا بِمِلْحٍ وَمَائٍ فَجَعَلَہُ فِی إِنَائٍ ، ثُمَّ جَعَلَ یَصُبُّہُ عَلَی إِصْبَعِہِ حَیْثُ لَدَغَتْہُ ، وَیَمْسَحُہَا وَیُعَوِّذُہَا بِالْمُعَوِّذَتَیْنِ۔ (طبرانی ۸۳۰)","","Musannaf Ibn Abi Shaybah 24019","","","كتاب الطب"
"24020","(۲۴۰۲۰) حَدَّثَنَا عَبْدُالرَّحِیمِ ، عَنِ الْحَسَنِ بْنِ عُبیدِاللہِ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ: کَانَ یَرْقَی بِالْحِمْیَرِیَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 24020","","","كتاب الطب"
"24021","(۲۴۰۲۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ الْقَعْقَاعِ، عَنْ إِبْرَاہِیمَ، قَالَ: رُقْیَۃُ الْعَقْرَبِ: شَجَّۃ قَرَنیۃ مِلْحَۃِ بَحْرٍ قفْطا۔ (طبرانی ۸۶۸۱)","","Musannaf Ibn Abi Shaybah 24021","","","كتاب الطب"
"24022","(۲۴۰۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْقَعْقَاعِ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : عَرَضْتُہَا عَلَی عَائِشَۃَ ، فَقَالَتْ : ہَذِہِ مَوَاثِیقُ۔","Sahih","Musannaf Ibn Abi Shaybah 24022","","","كتاب الطب"
"24023","(۲۴۰۲۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ حَجَّاجٍ ، عَنِ الزُّہْرِیِّ ، عَنْ طَارِقِ بْنِ أَبِی مُخَاشِنٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : أُتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِرَجُلٍ لَدَغَتْہُ عَقْرَبٌ ، فَقَالَ : أَمَا إِنَّہُ لَوْ قَالَ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ ، لَمْ یُلْدَغْ ، أَوْ لَمْ یَضُرَّہُ۔ (مسلم ۲۰۸۱۔ ابن حبان ۱۰۲۱)","","Musannaf Ibn Abi Shaybah 24023","","","كتاب الطب"
"24024","(۲۴۰۲۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَرْقُونَ ، وَیَکْرَہُونَ النَّفْثَ فِی الرَّقَی۔","","Musannaf Ibn Abi Shaybah 24024","","","كتاب الطب"
"24025","(۲۴۰۲۵) حَدَّثَنَا عَرْعَرَۃُ بْنُ الْبِرِنْدِ ، عَنْ أَبِی الْہَزْہَازِ ، قَالَ : دَخَلْتُ عَلَی الضَّحَّاکِ وَہُوَ وَجِعٌ ، فَقُلْتُ : أَلاَ أُعَوِّذُک یَا أَبَا مُحَمَّدٍ ؟ قَالَ : بَلَی ، وَلاَ تَنْفُثْ ، قَالَ : فَعَوَّذْتہ بِالْمُعَوِّذَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 24025","","","كتاب الطب"
"24026","(۲۴۰۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : قَالَ عِکْرِمَۃُ : أَکْرَہُ أَنْ أَقُولَ فِی الرُّقْیَۃِ ، بِسْمِ اللہِ ، أُفْ۔","","Musannaf Ibn Abi Shaybah 24026","","","كتاب الطب"
"24027","(۲۴۰۲۷) حَدَّثَنَا أَبُو قَطْنٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ؛ أَنَّہُمَا کَرِہَا التَّفْلَ فِی الرَّقَی۔","","Musannaf Ibn Abi Shaybah 24027","","","كتاب الطب"
"24028","(۲۴۰۲۸) حَدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، عَنْ مُحَمَّدِ بْنِ حَاطِبٍ ، قَالَ : دَبَبْتُ إِلَی قِدْرٍ لَنَا فَاحْتَرَقَتْ یَدَیَّ ، فَأَتَتْ بِی أُمِّی إِلَی شَیْخٍ بِالْبَطْحَائِ ، فَقَالَتْ : ہَذَا مُحَمَّدٌ ، قَدِ احْتَرَقَتْ یَدُہُ ، فَجَعَلَ یَنْفُثُ عَلَیْہَا وَیَتَکَلَّمُ بِکَلاَمٍ لاَ أَحْفَظُہُ ، فَلَمَّا کَانَ فِی إِمْرَۃِ عُثْمَانَ ، قُلْتُ : مَنِ الشَّیْخُ الَّذِی ذَہَبْتِ بِی إِلَیْہِ ؟ قَالَتْ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۳/۲۵۹۔ ابن حبان ۲۹۷۶)","Hasan","Musannaf Ibn Abi Shaybah 24028","","","كتاب الطب"
"24029","(۲۴۰۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنِی عَبْدُ الْعَزِیزِ بْنُ عُمَرَ ، قَالَ : حَدَّثَنِی رَجُلٌ مِنْ بَنِی سَلاَمَانِ بْنِ سَعْدٍ ، عَنْ أُمِّہِ ؛ أَنَّ خَالَہَا حَبِیبَ بْنَ فُوَیْکٍ حَدَّثَہَا ، أَنَّ أَبَاہُ خَرَجَ بِہِ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَعَیْنَاہُ مُبْیَضَّتَانِ ، لاَ یُبْصِرُ بِہِمَا شَیْئًا ، فَسَأَلَہُ مَا أَصَابَہُ ؟ فَأَخْبَرَہُ ، فَنَفَثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی عَیْنَیْہِ ، فَرَأَیْتُہُ یُدْخِلُ الْخَیْطَ فِی الإِبْرَۃِ ، وَإِنَّہُ لاَبْنُ ثَمَانِینَ ، وَإِنَّ عَیْنَیْہِ لَمُبْیَضَّتَانِ۔ (طبرانی ۳۵۴۶)","Da'if","Musannaf Ibn Abi Shaybah 24029","","","كتاب الطب"
"24030","(۲۴۰۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَنْفُثُ فِی الرُّقْیَۃِ۔ (بخاری ۱۳۱۔ مسلم ۱۷۲۳)","Sahih","Musannaf Ibn Abi Shaybah 24030","","","كتاب الطب"
"24031","(۲۴۰۳۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُثْمَان بْنُ حَکِیمٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ یَعْلَی بْنِ مُرَّۃَ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَفَعَتِ امْرَأَۃٌ إِلَیْہِ صَبِیًّا ، فَجَعَلَہُ بَیْنَہُ وَبَیْنَ وَاسِطَۃِ الرَّحْلِ ، ثُمَّ فَغَرَ فَاہُ ، فَنَفَثَ فِیہِ۔ (حاکم ۶۱۷)","Da'if","Musannaf Ibn Abi Shaybah 24031","","","كتاب الطب"
"24032","(۲۴۰۳۲) حَدَّثَنَا حَفْصٌ ، عَنْ عُثْمَانَ بْنِ قَیْسٍ ، عَنْ قَیْسِ بْنِ مُحَمَّدِ بْنِ الأَشْعَثِ ، قَالَ : ذُہِبَ بِی إِلَی عَائِشَۃَ وَفِی عَیْنَیَّ سُوئٌ ، فَرَقَتْنِی وَنَفَثَتْ۔","Da'if","Musannaf Ibn Abi Shaybah 24032","","","كتاب الطب"
"24033","(۲۴۰۳۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنِ الرُّقْیَۃِ یُنْفَثُ فِیہَا ؟ فَقَالَ : لاَ أَعْلَمُ بِہَا بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24033","","","كتاب الطب"
"24034","(۲۴۰۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنْ زِیَادِ بْنِ ثُوَیْبٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : دَخَلَ عَلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا أَشْتَکِی ، فَقَالَ : أَلاَ أَرْقِیکَ بِرُقْیَۃٍ عَلَّمَنِیہَا جِبْرِیلُ ، بِسْمِ اللہِ أَرْقِیکَ ، وَاللَّہُ یَشْفِیکَ ، مِنْ کُلِّ إِربٍ یُؤْذِیکَ ، وَمِنْ شَرِّ النَّفَّاثَاتِ فِی الْعُقَدِ ، وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ۔ (احمد ۲/۴۴۶۔ ابن ماجہ ۳۵۲۴)","Da'if","Musannaf Ibn Abi Shaybah 24034","","","كتاب الطب"
"24035","(۲۴۰۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ عَمْرَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ مِمَّا یَقُولُ لِلْمَرِیضِ بِبُزَاقِہِ بِإِصْبَعِہِ : بِسْمِ اللہِ ، تُرْبَۃُ أَرْضِنَا ، بِرِیقَۃِ بَعْضِنَا ، یُشْفَی سَقِیمُنَا ، بِإِذْنِ رَبِّنَا۔n(بخاری ۵۷۴۵۔ مسلم ۱۷۲۴)","Sahih","Musannaf Ibn Abi Shaybah 24035","","","كتاب الطب"
"24036","(۲۴۰۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَوِّذُ بِہَذِہِ الْکَلِمَاتِ : أَذْہِبِ الْبَاسَ رَبَّ النَّاسِ ، وَاشْفِ وَأَنْتَ الشَّافِی ، لاَ شِفَائَ إِلاَّ شِفَاؤُکَ ، شِفَائً لاَ یُغَادِرُ سَقَمًا ، قَالَتْ : فَلَمَّا ثَقُلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَرَضِہِ الَّذِی مَاتَ فِیہِ ، أَخَذْتُ بِیَدِہِ فَجَعَلْتُ أَمْسَحُہَا وَأَقُولُہَا ، قَالَتْ : فَنَزَعَ یَدَہُ مِنْ یَدِی ، وَقَالَ : اللَّہُمَّ اغْفِرْ لِی ، وَأَلْحِقْنِی بِالرَّفِیقِ الأَعْلَی ، قَالَتْ : فَکَانَ ہَذَا آخَرَ مَا سَمِعْتُ مِنْ کَلاَمِہِ۔ (مسلم ۱۷۲۲۔ ابن ماجہ ۱۶۱۹)","Sahih","Musannaf Ibn Abi Shaybah 24036","","","كتاب الطب"
"24037","(۲۴۰۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ ، قَالَ : اشْتَکَیْتُ فَدَخَلَ عَلَیَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا أَقُولُ : إِنْ کَانَ أَجَلِی قَدْ حَضَرَ فَأَرِحْنِی ، وَإِنْ کَانَ مُتَأَخِّرًا فَاشْفِنِی ، أَوْ عَافِنِی ، وَإِنْ کَانَ بَلاَئً فَصَبِّرْنِی ، قَالَ : فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَیْفَ قُلْتَ ؟ قَالَ : فَقُلْتُ لَہُ ، قَالَ : فَمَسَحَنِی بِیَدِہِ ، ثُمَّ قَالَ : اللَّہُمَّ اشْفِہِ ، أَوْ عَافِہِ ، فَمَا اشْتَکَیْتُ ذَلِکَ الْوَجَعَ بَعْدُ۔ (ترمذی ۳۵۶۴۔ ابن حبان ۶۹۴۰)","Hasan","Musannaf Ibn Abi Shaybah 24037","","","كتاب الطب"
"24038","(۲۴۰۳۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الْحَجَّاجِ ، عَنِ الْمِنْہَالِ بْنِ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ دَخَلَ عَلَی مَرِیضٍ لَمْ تَحْضُرْ وَفَاتُہُ ، فَقَالَ: أَسْأَلُ اللَّہَ الْعَظِیمَ ، رَبَّ الْعَرْشِ الْعَظِیمِ أَنْ یَشْفِیَک ، سَبْعَ مَرَّاتٍ ، شُفِیَ۔ (احمد ۱/۲۳۹۔ ابوداؤد ۳۰۹۹)","","Musannaf Ibn Abi Shaybah 24038","","","كتاب الطب"
"24039","(۲۴۰۳۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، قَالَ : أَخْبَرَنِی عُمَیْرُ بْنُ ہَانِئٍ ، قَالَ : سَمِعْتُ جُنَادَۃَ بْنَ أَبِی أُمَیَّۃَ یَقُولُ : سَمِعْتُ عُبَادَۃَ بْنَ الصَّامِتِ یُحَدِّثُ عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّ جِبْرِیلَ رَقَاہُ وَہُوَ یُوعَکُ ، فَقَالَ : بِسْمِ اللہِ أَرْقِیکَ ، مِنْ کُلِّ دَائٍ یُؤْذِیکَ ، مِنْ کُلِّ حَاسِدٍ إِذَا حَسَدَ ، وَمِنْ کُلِّ عَیْنٍ ، وَاسْمُ اللہِ یَشْفِیکَ۔ (احمد ۵/۳۲۳۔ ابن حبان ۹۵۳)","Da'if","Musannaf Ibn Abi Shaybah 24039","","","كتاب الطب"
"24040","(۲۴۰۴۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا دَخَلَ عَلَی مَرِیضٍ ، قَالَ : أَذْہِبِ الْبَأْسَ رَبَّ النَّاسِ ، وَاشْفِ أَنْتَ الشَّافِی ، لاَ شِفَائَ إِلاَّ شِفَاؤُکَ۔ (ترمذی ۳۵۶۵)","Da'if","Musannaf Ibn Abi Shaybah 24040","","","كتاب الطب"
"24041","(۲۴۰۴۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، قَالَ: حدَّثَنَا زَکَرِیَّا ، قَالَ : حَدَّثَنِی سِمَاکٌ ، عَنْ مُحَمَّدِ بْنِ حَاطِبٍ ، قَالَ: تَنَاوَلْتُ قِدْرًا لَنَا فَاحْتَرَقَتْ یَدَیَّ ، فَانْطَلَقَتْ بِی أُمِّی إِلَی رَجُلٍ جَالِسٍ فِی الْجَبَّانَۃِ ، فَقَالَتْ: یَا رَسُولَ اللہِ، فَقَالَ: لَبَّیْکِ وَسَعْدَیْکِ ، ثُمَّ أَدْنَتْنِی مِنْہُ ، فَجَعَلَ یَنْفُثُ وَیَتَکَلَّمُ بِکَلاَمٍ لاَ أَدْرِی مَا ہُوَ، فَسَأَلْتُ أُمِّی بَعْدَ ذَلِکَ: مَا کَانَ یَقُولُ؟ فَقَالَتْ: کَانَ یَقُولُ: أَذْہِبِ الْبَاْسَ رَبَّ النَّاسِ، وَاشْفِ أَنْتَ الشَّافِی، لاَ شَافِیَ إِلاَّ أَنْتَ۔n(ابن سعد ۶۵۰)","Hasan","Musannaf Ibn Abi Shaybah 24041","","","كتاب الطب"
"24042","(۲۴۰۴۲) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، قَالَ : حدَّثَنَا أَبُو شِہَابٍ ، عَنْ دَاوُدَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : اشْتَکَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَقَاہُ جِبْرِیلُ ، فَقَالَ : بِسْمِ اللہِ أَرْقِیکَ ، مِنْ کُلِّ شَیْئٍ یُؤْذِیکَ ، مِنْ کُلِّ حَاسِدٍ وَعَیْنٍ ، وَاللَّہُ یَشْفِیکَ۔ (مسلم ۱۷۱۸۔ ترمذی ۹۸۲)","Sahih","Musannaf Ibn Abi Shaybah 24042","","","كتاب الطب"
"24043","(۲۴۰۴۳) حَدَّثَنَا یَعْلَی ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنِ الْمِنْہَالِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَوِّذُ الْحَسَنَ وَالْحُسَیْنَ ، یَقُولُ : أُعِیذُکُمَا بِکَلِمَاتِ اللہِ التَّامَّۃِ ، مِنْ کُلِّ شَیْطَانٍ وَہَامَّۃٍ ، وَمِنْ کُلِّ عَیْنٍ لاَمَّۃٍ ، وَیَقُولُ ، ہَکَذَا کَانَ إِبْرَاہِیمُ یُعَوِّذُ ابْنَیْہِ إِسْمَاعِیلَ وَإِسْحَاقَ۔n(ترمذی ۲۰۶۰۔ ابوداؤد ۴۷۰۴)","Sahih","Musannaf Ibn Abi Shaybah 24043","","","كتاب الطب"
"24044","(۲۴۰۴۴) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَنِ الْمِنْہَالِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ بِمِثْلِہِ ، أَوْ نَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 24044","","","كتاب الطب"
"24045","(۲۴۰۴۵) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ إِبْرَاہِیمَ بْنِ إِسْمَاعِیلَ بْنِ أَبِی حَبِیبَۃَ ، قَالَ : حدَّثَنِی دَاوُدُ بْنُ الْحُصَیْنِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعَلِّمُنَا مِنَ الأَوْجَاعِ کُلِّہَا وَمِنَ الْحُمَّی ہَذَا الدُّعَائَ : بِسْمِ اللہِ الْکَبِیرِ ، أَعُوذُ بِاللَّہِ الْعَظِیمِ ، مِنْ شَرِّ کُلِّ عِرْقٍ نَعَّارٍ ، وَمِنْ شَرِّ حَرِّ النَّارِ۔ (ترمذی ۲۰۷۵۔ ابن ماجہ ۳۵۲۶)","Da'if","Musannaf Ibn Abi Shaybah 24045","","","كتاب الطب"
"24046","(۲۴۰۴۶) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ فَرْقَدٍ السَّبَخِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ امْرَأَۃً جَائَ تْ بِابْنٍ لَہَا إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إِنَّ ابْنِی ہَذَا بِہِ جُنُونٌ ، وَإِنَّہُ یَأْخُذُہُ عِنْدَ عَشَائِنَا وَغَدَائِنَا ، فَیَخْبُثُ ، قَالَ : فَمَسَحَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَدْرَہُ وَدَعَا لَہُ ، فَثَعَّ ثَعَّۃً ، فَخَرَجَ مِنْ جَوْفِہِ مِثْلُ الْجَرْوِ الأَسْوَدِ۔ (احمد ۱/۲۳۹۔ طبرانی ۱۲)","Da'if","Musannaf Ibn Abi Shaybah 24046","","","كتاب الطب"
"24047","(۲۴۰۴۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرَۃَ ابْنَۃِ عَبْدِ الرَّحْمَنِ ، قَالَتْ : اشْتَکَتْ عَائِشَۃُ أُمُّ الْمُؤْمِنِینَ ، وَإِنَّ أَبَا بَکْرٍ دَخَلَ عَلَیْہَا وَیَہُودِیَّۃٌ تَرْقِیہَا ، فَقَالَ : اِرْقِیہَا بِکِتَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 24047","","","كتاب الطب"
"24048","(۲۴۰۴۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، قَالَ : جَائَ رَجُلٌ إِلَی عَلِیٍّ ، فَقَالَ : إِنَّ فُلاَنًا شَاکٍ ، قَالَ : فَیَسُرَّکَ أَنْ یَبْرَأ ؟ قَالَ : نَعَمْ ، قَالَ : قُلْ یَا حَلِیمُ یَا کَرِیمُ ، اشْفِ فُلاَنًا۔","","Musannaf Ibn Abi Shaybah 24048","","","كتاب الطب"
