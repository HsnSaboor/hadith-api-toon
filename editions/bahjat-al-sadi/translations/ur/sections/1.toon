یہ حدیث نفع بخش معاملات، اور نقصان دہ معاملات کے بیان میں اصل ہے، اور یہ کہ دونوں قسموں کے درمیان فرق: سچائی اور بیان ہے۔ پس جس نے اپنے معاملے میں سچ بولا، اور ہر اس چیز کو بیان کیا جس پر معاملہ موقوف ہے مقصود اوصاف میں سے، اور عیوب اور نقص میں سے، تو یہ فوری میں نافع معاملہ ہے اللہ اور اس کے رسول کے امر کی تعمیل سے، اور گناہ سے سلامتی سے، اور اس کے معاملے میں برکت کے نزول سے، اور آئندہ میں ثواب کے حصول سے، اور عقاب سے سلامتی سے۔ اور جس نے جھوٹ بولا اور عیوب چھپائے، اور جو عقود میں صفات میں سے اس پر ہے تو وہ اپنے گناہ کے ساتھ، اس کا معاملہ برکت سے مٹا ہوا ہے۔ اور جب معاملے سے برکت کھینچ لی جائے تو اس کا صاحب اپنی دنیا اور آخرت میں خسارے میں رہا۔ اور اس اصل سے تدلیس کے حرام ہونے پر استدلال کیا جاتا ہے، اور عیوب چھپانے کے، اور دھوکے کے حرام ہونے پر، اور ترازوؤں اور ناپ تول اور گز وغیرہ میں کمی کے؛ کیونکہ وہ جھوٹ اور چھپانے میں سے ہیں۔ اور اسی طرح نجش کے حرام ہونے پر اور معاملات میں دھوکے اور آنے والے قافلوں کو آگے جا کر لینے کے تاکہ وہ انہیں بیچیں یا ان سے خریدیں۔ اور اس میں داخل ہے: ثمن و مثمن کی مقدار میں جھوٹ اور معقود علیہ کے وصف میں اور اس کے سوا میں۔ اور اس کا ضابطہ یہ ہے: کہ ہر وہ چیز جسے تم ناپسند کرتے ہو کہ تمہارا مسلمان بھائی یا غیر تم سے اس میں معاملہ کرے اور تمہیں اس کی خبر نہ دے، تو وہ جھوٹ اور چھپانے اور دھوکے کے باب میں سے ہے۔ اور اس میں داخل ہیں: بیع اپنی انواع سے، اور اجارے، اور شرکتاں اور تمام معاوضے، اور ان کی میعادیں اور ان کی دستاویزات۔ تو ان سب میں بندے پر سچائی اور بیان متعین ہے، اور اس کے لیے جھوٹ اور چھپانا حلال نہیں۔ اور اس حدیث میں ہے: بیع میں مجلس کے خیار کا اثبات، اور یہ کہ دونوں متبایعین میں سے ہر ایک کے لیے بیع کے محل میں رہنے تک امضا یا فسخ کے درمیان خیار ہے، پس جب وہ جدا ہو جائیں تو بیع ثابت اور واجب ہو جاتی ہے، اور اس کے بعد ان میں سے کسی کے لیے خیار نہیں مگر ایسے سبب سے جو فسخ کو واجب کرے، جیسے شرط کا خیار، یا عیب جسے وہ پائے جو اس سے چھپایا گیا، یا تدلیس یا ثمن یا مثمن کی معرفت کا متعذر ہونا۔ اور مجلس کے خیار کے اثبات میں حکمت یہ ہے: کہ بیع بہت کثرت سے واقع ہوتی ہے، اور انسان اپنی بیع یا خرید پر بہت نادم ہوتا ہے، تو شارع نے اس کے لیے خیار بنایا؛ تاکہ وہ غور کرے اور اپنا حال دیکھے: کیا وہ امضا کرے یا فسخ کرے؟ اور اللہ بہتر جانتا ہے۔"
"38","[AI-translation] ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: «رسول اللہ ﷺ نے کنکری کی بیع سے، اور غرر کی بیع سے منع فرمایا»۔ مسلم نے اسے روایت کیا۔
اور یہ ہر غرر کو جامع کلام ہے، اور غرر سے مراد: خطرہ اور جہالت ہے۔ اور یہ میسر میں داخل ہے، کیونکہ میسر جیسے مقابلہ بازیوں اور شرطوں میں داخل ہوتا ہے — سوائے گھوڑوں اور اونٹوں اور تیروں کی دوڑ کی شرط کے — اسی طرح معاملات کے امور میں داخل ہوتا ہے۔ پس ہر بیع جس میں خطرہ ہو: آیا مبیع حاصل ہوگی، یا نہیں ہوگی؟ — جیسے بھاگے اور گمشدہ اور غصب شدہ کی بیع غاصب کے سوا سے، یا اس سے جو اسے لینے پر قادر نہ ہو، اور جیسے لوگوں کے ذموں میں جو ہے اس کی بیع — اور خصوصاً ٹال مٹول کرنے والوں اور تنگدستوں کے — تو وہ غرر میں داخل ہے۔ اور اسی طرح ہر بیع جس میں ظاہر جہالت ہو جس میں مقصود مختلف ہو؛ تو وہ غرر کی بیع میں داخل ہے، جیسے اس کا بیچنا جو اس کے گھر میں سامان میں سے ہے، یا جو اس کی دکان میں ہے، یا جو اس جگہ میں ہے، اور وہ اسے نہ جانتا ہو اور نہ اس کا علم رکھتا ہو، یا کنکری کی بیع جو غرر کی مثالوں میں سے مثال ہے، جیسے کہے: یہ کنکری پھینک، پس جس سامان پر بھی گری، وہ اتنے میں تمہارے ذمے ہے، یا اسے زمین میں پھینک پس جتنی دوری تک پہنچے، وہ اتنے میں تمہارے لیے ہے، یا منابذہ یا ملامسہ کی بیع، یا چوپایوں کے پیٹوں میں جو ہے اس کی بیع، اور جو اس کے مشابہ ہو: تو یہ سب واضح غرر ہے۔ اور شارع کی حکمت میں سے: اس قسم کا حرام کرنا ہے، اس میں جو خطرات ہیں ان کی وجہ سے، اور دشمنیاں پیدا کرنے کی وجہ سے جن میں ان میں سے ایک دوسرے کو فاحش نقصان دہ دھوکہ دے سکتا ہے۔ اور اسی لیے علماء نے بیع کے لیے شرط لگائی: مبیع کا علم، اور ثمن کا علم۔ اور انہوں نے یہ بھی شرط لگائی: کہ عاقد جائز التصرف ہو، یہ کہ وہ بالغ عاقل رشید ہو؛ کیونکہ نابالغ یا غیر رشید سے عقد میں ضرور نقصان دہ دھوکہ حاصل ہوگا، اور یہ غرر میں سے ہے۔ اور اسی طرح انہوں نے شرط لگائی: مدت کا علم، جب ثمن یا اس کا بعض، یا بیع سلم میں مبیع مؤجل ہو؛ کیونکہ مدت کی جہالت عقد کو غرر بنا دیتی ہے۔ اور جیسے غرر کی بیع کی ممانعت میں وہ غرر داخل ہے جس پر دونوں متفق ہوں، تو بدرجہ اولیٰ اس میں داخل ہے ایک کا دوسرے کو دھوکہ دینا معاملے کے امور میں سے کسی چیز میں: معقود بہ میں سے، یا معقود علیہ میں سے، یا اس کی صفات میں سے کسی چیز میں۔ اور سارا دھوکہ دہی میں داخل ہے۔ اور دھوکے کے افراد اور اس کی تفصیلات کا ضبط ممکن نہیں، اور وہ لوگوں کے درمیان معروف ہیں۔ اور غرر کی بیع کا حاصل معدوم کی بیع کی طرف لوٹتا ہے، جیسے حبل الحبلہ، اور سالوں کی، یا اس کی بیع جس پر قدرت نہ ہو، جیسے بھاگے ہوئے اور اس جیسے کی، یا مطلق مجہول کی بیع اس کی ذات میں، یا اس کی جنس میں، یا اس کی صفات میں۔"
"39","[AI-translation] عمرو بن عوف مزنی رضی اللہ عنہ سے نبی ﷺ سے روایت ہے کہ آپ نے فرمایا: «مسلمانوں کے درمیان صلح جائز ہے، سوائے ایسی صلح کے جس نے حلال کو حرام کیا، یا حرام کو حلال کیا۔ اور مسلمان اپنی شرطوں پر ہیں، سوائے ایسی شرط کے جس نے حلال کو حرام کیا، یا حرام کو حلال کیا»۔ سنن کے مصنفین نے اسے روایت کیا سوائے نسائی کے۔
اس شریف حدیث میں صلح اور شرطوں کی اقسام کو جمع کیا — صحیح اور فاسد کو — ایسے کلام سے جو علم کی اقسام اور اس کے افراد میں سے اتنا سموئے ہے جو واضح حد سے شمار نہیں کیا جا سکتا۔ پس خبر دی کہ صلح میں اصل: یہ ہے کہ وہ جائز ہے اس میں کوئی حرج نہیں، سوائے جب وہ حلال کو حرام کرے، یا حرام کو حلال کرے۔ اور یہ محیط کلام ہے، صلح کی تمام قسموں میں داخل ہے۔ اور صلح خیر ہے، اس میں جو جھگڑے کا خاتمہ ہے اس کی وجہ سے، اور دلوں کی سلامتی، اور ذموں کی براءت۔ پس اس میں داخل ہے: مالوں میں صلح اقرار میں، یہ کہ وہ اس کے لیے دین، یا عین، یا حق کا اقرار کرے، تو اس سے اس کے بعض پر یا غیر پر صلح کرے۔ اور انکار کی صلح، یہ کہ وہ اس پر دین میں سے، یا عین میں سے حق کا دعویٰ کرے، تو وہ انکار کرے۔ پھر دونوں اس سے مصالحت پر متفق ہوں عین یا دین پر، یا منفعت یا ابراء پر، یا غیر پر: تو یہ سب جائز ہے۔ اور اسی طرح مجہول حقوق سے صلح، جیسے دو کے درمیان طویل معاملہ ہو، جس میں ایک پر یا دونوں پر حق کے ثابت ہونے میں اشتباہ ہو، یا اس کی مقدار میں اشتباہ ہو، تو دونوں اس پر صلح کریں جس پر وہ متفق ہوں، اور عدل کی کوشش کریں۔ اور اس کا تمام: یہ کہ ہر ایک دوسرے کو حلال کرے، یا دو کے درمیان میراث یا وقف میں، یا وصیت یا دوسرے مال میں شرکت ہو: دیون میں سے، یا اعیان میں سے، پھر دونوں اس سے مصالحت کریں اس پر جسے وہ عدل و صواب سے قریب تر سمجھیں۔ اور اسی طرح اس میں داخل ہے: میاں بیوی کے درمیان زوجیت کے حق میں سے کسی حق میں مصالحت: نفقہ یا لباس یا مسکن یا غیرہ میں سے، گزشتہ یا حاضر، اور اگر حال تقاضا کرے کہ ان میں سے ایک اپنے بعض حق سے چشم پوشی کرے، بقیہ کے حصول کے لیے، یا زوجیت کے بقاء کے لیے، یا فضل کے زوال کے لیے، یا مقاصد میں سے غیر کے لیے، تو یہ سب حسن ہے۔ جیسا کہ اللہ تعالیٰ نے ان کے حق میں فرمایا: «تو ان دونوں پر کوئی گناہ نہیں کہ وہ آپس میں صلح کر لیں اور صلح خیر ہے» (قرآن النساء 4:128)۔ اور اسی طرح جانوں میں، یا اعضاء میں قصاص سے صلح مال پر جس پر دونوں متفق ہوں، یا جانوں اور اعضاء اور زخموں کی دیتوں سے معاوضہ، یا حاکم خصموں کے درمیان اس سے صلح کرائے جس کا حال تقاضا کرے، اس میں دونوں کی مصلحت کی کوشش کرتے ہوئے۔ پس یہ سب آپ ﷺ کے قول میں داخل ہے: «مسلمانوں کے درمیان صلح جائز ہے»۔ پس اگر صلح حلال کے حرام کرنے، یا حرام کے حلال کرنے کو شامل ہو، تو وہ اس حدیث کی نص سے فاسد ہے، جیسے آزادوں کی غلامی پر صلح، یا حرام شرمگاہوں کی اباحت پر، یا وہ صلح جس میں ظلم ہو۔ اور اسی لیے اللہ نے اسے اپنے قول سے مقید کیا: «پس ان دونوں کے درمیان عدل سے صلح کراؤ اور انصاف کرو بے شک اللہ انصاف کرنے والوں سے محبت کرتا ہے» (قرآن الحجرات 9:49)۔ یا اضطراری صلح جیسے مجبور کی، اور جیسے عورت جب اس کا شوہر اس پر ظلم سے تنگی کرے تاکہ وہ اس سے فدیہ دے کر چھوٹے، اور جیسے دوسرے کے حق پر اس کی اجازت کے بغیر صلح اور جو اس کے مشابہ ہو، تو یہ قسم حرام صلح ہے صحیح نہیں۔ اور رہیں شرطیں: تو اس حدیث میں خبر دی کہ مسلمان اپنی شرطوں پر ہیں، سوائے ایسی شرط کے جو حرام کو حلال کرے یا حلال کو حرام کرے، اور یہ بڑی اصل ہے، کیونکہ شرطیں وہ ہیں جو متعاقدین میں سے ایک دوسرے پر لگاتا ہے جس میں اس کے لیے حصہ اور مصلحت ہو، تو وہ جائز ہے، اور وہ لازم ہے جب دوسرا اس پر موافق ہو اور اسے تسلیم کرے۔ اور یہ مثل اس کے جب خریدار مبیع میں مقصود وصف کی شرط لگائے، جیسے غلام کے کاتب ہونے کی شرط، یا فلاں کام اچھی طرح کرنے کی، یا جانور کے ہموار چلنے یا دودھ دینے کی، یا شکاری جانور کے شکار کرنے کی، یا لونڈی کے کنواری یا خوبصورت ہونے یا اس میں فلاں مقصود وصف کی۔ اور مثل اس کے کہ خریدار شرط لگائے: کہ ثمن یا اس کا بعض مسمیٰ مدت تک مؤجل ہے، یا چیز بیچے اور بیچنے والا شرط لگائے: کہ وہ معلوم مدت تک اس سے نفع اٹھائے گا، جیسا کہ جابر بن عبد اللہ انصاری رضی اللہ عنہما نے نبی کے ہاتھ اپنا اونٹ بیچا، اور مدینہ تک اس کی سواری کی شرط لگائی۔ اور مثل اس کے کہ گھر، یا دکان کی سکونت کی معلوم مدت تک شرط لگائے، یا برتن کو معلوم مدت تک استعمال کرنے کی، اور جو اس کے مشابہ ہو۔ اور اسی طرح رہن اور ضمان اور کفالت کی شرطیں صحیح لازم شرطوں میں سے ہیں۔ اور مثل ان شرطوں کے جو مشارکت کرنے والے لگاتے ہیں مضاربت میں، یا شرکت عنان میں، یا وجوہ میں، یا ابدان میں، یا مساقات میں، یا مزارعت میں: تو یہ سب صحیح ہیں، سوائے ایسی شرطوں کے جو حرام کو حلال کریں، اور اس کے برعکس جیسے جو جہالت اور غرر کی طرف لوٹیں۔ اور مثل واقفین اور وصیت کرنے والوں کی شرطیں ان کے اوقاف اور وصیتوں میں مقصود شرطوں میں سے: تو یہ سب صحیح ہیں، جب تک حرام میں داخل نہ ہوں۔ اور اسی طرح میاں بیوی کے درمیان شرطیں، جیسے وہ اپنے گھر یا اپنے شہر کی شرط لگائے، یا معین نفقہ یا اس جیسے کی، کیونکہ پورا کیے جانے کے سب سے حقدار شرطیں یہ قسم ہے۔"
"40","[AI-translation] ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «مالدار کا ٹال مٹول ظلم ہے۔ اور جب تم میں سے کسی کو مالدار پر حوالہ دیا جائے تو وہ حوالہ قبول کرے»۔ متفق علیہ ہے یعنی بخاری اور مسلم نے روایت کیا۔
یہ حدیث حسن وفاء کا امر، اور حسن استیفاء، اور ان دونوں یا ان میں سے ایک کے ضد کی ممانعت پر مشتمل ہے۔ پس آپ کا قول: «مالدار کا ٹال مٹول ظلم ہے» یعنی: واجب حق کی ادائیگی میں ٹال مٹول ظلم ہے؛ کیونکہ وہ واجب عدل کا ترک ہے، جب کہ قادر پر لازم ہے کہ ادائیگی میں جلدی کرے، بغیر اس کے کہ حق والے کو طلب اور اصرار، یا شکایت کی حاجت دے۔ پس جس نے قدرت کے ساتھ ایسا کیا وفاء پر، تو وہ ظالم ہے۔ اور «مالدار» وہ ہے جس کے پاس مالی موجودات ہوں جن سے وہ وفاء پر قدرت رکھے۔ اور حدیث کے مفہوم سے: کہ تنگدست پر تاخیر میں کوئی حرج نہیں۔ اور اللہ نے حق والے پر اسے آسانی تک مہلت دینا واجب کیا ہے۔ اور اس حدیث سے ہم سمجھتے ہیں: کہ مالی ظلم دوسرے کا مال ناحق لینے کے ساتھ خاص نہیں، بلکہ اس میں دوسرے کے مال پر ہر زیادتی داخل ہے، یا اس کے حق پر کسی بھی وجہ سے ہو۔ پس جس نے دوسرے کا مال غصب کیا، یا چرایا، یا اپنے پاس دوسرے کے حق کا انکار کیا یا اس کے بعض کا، یا اس پر دعویٰ کیا جو اس کا نہیں اصل حق میں سے یا اس کے وصف میں سے، یا اسے اس کے حق میں وقت سے دوسرے وقت تک ٹالتا رہا، یا اسے اس سے کم ادا کیا جو اس کے ذمے اس کے لیے واجب ہوا — وصف میں یا مقدار میں — تو یہ سب اپنے احوال کے مطابق ظالم ہیں۔ اور ظلم قیامت کے دن اس کے اہل پر اندھیرے ہیں۔ پھر دوسرے جملے میں حسن استیفاء ذکر کیا، اور یہ کہ جس کا حق ہو اس پر لازم ہے کہ اپنے ساتھی کے پیچھے معروف اور آسانی سے لگے، نہ پریشانی اور نہ تنگی سے، اور نہ اسے اپنے معاملے میں تنگی سے بوجھل کرے، اور نہ اس پر ممتنع ہو جب وہ اسے ایسی جہت کی طرف پھیرے جس میں اس پر کوئی ضرر اور نہ نقص ہو۔ پس جب وہ اس کے حق کا حوالہ مالدار پر کرے — یعنی: وفاء پر قادر نہ ٹالنے والا اور نہ روکنے والا — تو وہ اس پر حوالہ لے، کیونکہ یہ حسن استیفاء اور سماحت میں سے ہے۔ اور اسی لیے اللہ تعالیٰ نے دونوں امور کا ذکر اپنے قول میں کیا: «پس جسے اس کے بھائی کی طرف سے کچھ معاف کیا گیا تو معروف سے پیروی اور احسان سے اس کی طرف ادائیگی ہے» (قرآن البقرۃ 2:178)۔ پس حق والے کو امر کیا کہ وہ جس پر حق ہے اس کے پیچھے معروف سے لگے، جو عرفاً و عقلاً مستحسن ہو، اور جس پر حق ہے وہ احسان سے ادا کرے۔ اور آپ ﷺ نے اس جمیل وصف سے متصف کے لیے دعا کی، فرمایا: «اللہ اس بندے پر رحم کرے جو بیچتے وقت نرم ہو، خریدتے وقت نرم ہو، ادا کرتے وقت نرم ہو، تقاضا کرتے وقت نرم ہو»۔ پس معاملہ برتنے میں، اور ادائیگی میں، اور تقاضے میں سماحت، اس کے صاحب کے لیے ہر خیر کی امید ہے: دینی و دنیوی، اس مبارک دعا میں داخل ہونے کی وجہ سے جس کا قبول ہونا ضروری ہے۔ اور یہ عیاناً مشاہدہ کیا گیا ہے۔ کیونکہ تم اس وصف والے تاجر کو نہیں پاؤ گے مگر دیکھو گے کہ اللہ نے اس پر رزق انڈیل دیا ہے، اور اس پر برکت نازل کی ہے۔ اور اس کے برعکس ٹال مٹول اور تنگی والے، اور معاملہ کرنے والوں کو بوجھل کرنے والے، اور بدلہ عمل کی جنس سے ہے، پس آسانی کا بدلہ آسانی ہے۔ اور جب مالدار کا ٹال مٹول ظلم ہو: تو اسے حق ادا کرنے پر مجبور کرنا واجب ہوا جب اس کا قرض خواہ اس کی شکایت کرے، پس اگر ادا کرے ورنہ تعزیر ہو یہاں تک کہ ادا کرے، یا اس کا قرض خواہ درگزر کرے۔ اور جب وہ شکایت کے سبب اپنے قرض خواہ کو تاوان کا سبب بنے: تو اس پر اس کے مال میں سے جو لیا اس کا تاوان ہے، کیونکہ وہی سبب ہے، اور یہ ناحق ہے۔ اور اسی طرح جو بھی دوسرے کو ظلماً تاوان کا سبب بنے تو اس پر ضمان ہے۔ اور یہ حدیث حوالة کے باب میں اصل ہے، اور یہ کہ جسے اس کے حق کا مالدار پر حوالہ دیا گیا، تو اس پر لازم ہے کہ وہ منتقل ہو، اور اسے ممتنع ہونے کا حق نہیں۔ اور اس کے مفہوم سے: کہ جب غیر مالدار پر حوالہ دیا گیا تو اس پر منتقل ہونا لازم نہیں، اس میں جو ضرر ہے اس کی وجہ سے۔ اور وہ حق جس سے منتقل ہو: وہ ذموں میں ثابت دیون ہیں، قرض میں سے یا مبیع کے ثمن میں سے، یا غیرہما میں سے۔ اور جب وہ اسے مالدار پر منتقل کرے تو وہ اس کے پیچھے لگے: محیل کی ذمہ بری ہو گئی، اور قرض خواہ کا حق اس کی طرف منتقل ہو گیا جس پر حوالہ دیا گیا۔ واللہ اعلم۔"
"41","[AI-translation] سمرہ بن جندب رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «ہاتھ پر لازم ہے جو اس نے لیا، یہاں تک کہ وہ اسے ادا کرے»۔ سنن کے مصنفین نے اسے روایت کیا سوائے نسائی کے۔
اور یہ اس کو شامل ہے جو اس نے لوگوں کے مالوں میں سے ناحق لیا، جیسے غصب اور اس جیسے، اور جو اس نے حق سے لیا، جیسے رہن اور اجارہ۔ رہا پہلی قسم: تو وہ غصب ہے، اور وہ دوسرے کا مال ناحق لینا ہے اس کی رضا کے بغیر، اور وہ عظیم ظلم اور محرمات میں سے ہے؛ کیونکہ رسول اللہ ﷺ فرماتے ہیں: «جس نے بالشت بھر زمین غصب کی قیامت کے دن سات زمینوں میں سے اسے اس کا طوق پہنایا جائے گا»۔ اور غاصب پر لازم ہے کہ جو اس نے لیا وہ لوٹائے، اگرچہ اس کے لوٹانے پر اس کی قیمت سے کئی گنا خرچ آئے اور اگرچہ اسے اس کے لوٹانے میں ضرر پہنچے، کیونکہ وہی ہے جس نے اپنے نفس پر ضرر داخل کیا۔ پس اگر وہ کمی کے ساتھ لوٹائے تو اس کے ساتھ کمی کا تاوان دے۔ اور اس پر اس کے ہاتھ میں رہنے کی مدت کی اجرت ہے، اور اگر وہ تلف ہو گیا تو اس کا ضمان دے۔ اور رہا جب ہاتھ نے دوسرے کا مال اس کے صاحب کی رضا سے لیا، اجارے سے، یا رہن یا مضاربت سے، یا مساقات سے، یا مزارعت سے، یا غیرہ سے: تو ہاتھ والا امین ہے، کیونکہ عین والے نے اسے امین بنایا ہے، پس اگر وہ اس کے ہاتھ میں تعدی اور کوتاہی کے بغیر تلف ہو گئی: تو اس پر کوئی ضمان نہیں، اور اگر وہ اس کی حفاظت میں کوتاہی یا اس پر زیادتی سے تلف ہوئی: تو اس کا ضمان دے اور جب اس سے غرض ختم ہو تو اسے اس کے صاحب کو لوٹائے۔ اور اس حدیث میں داخل ہوا «ہاتھ پر لازم ہے جو اس نے لیا یہاں تک کہ وہ اسے ادا کرے»۔ اور اسی طرح عاریہ مستعیر پر لازم ہے کہ وہ اسے اس کے صاحب کو لوٹائے اس سے غرض ختم ہونے پر، یا اس کے رب کے طلب کرنے پر، کیونکہ عاریہ جائز عقد ہے لازم نہیں۔ پس اگر عاریہ تعدی اور کوتاہی کے بغیر تلف ہو گئی، تو علماء میں سے جس نے اس پر ضمان ڈالا، جیسا کہ امام احمد کے مذہب کا مشہور ہے، اور ان میں سے جس نے اس پر ضمان نہیں ڈالا دیگر امناداروں کی طرح۔ اور ان میں سے جس نے تفصیل کی: پس اگر اس کے ضمان کی شرط لگائی تو ضمان دے گا، ورنہ نہیں، اور یہ تینوں اقوال میں سے بہترین قول ہے۔ لیکن اگر مال مجنون، یا نادان، یا نابالغ کے ہاتھ میں پایا گیا، تو اس نے اسے حفاظت کے لیے لیا، پس وہ اس کے ہاتھ میں تعدی اور کوتاہی کے بغیر تلف ہو گیا: تو وہ احسان کرنے والا ہے، اور احسان کرنے والوں پر کوئی راہ نہیں۔ اور اگر وہ لقطہ لے جس کا اٹھانا جائز ہے، تو اس پر ایک کامل سال اس کا اعلان لازم ہے۔ پس اگر وہ پہچانی نہ گئی: تو وہ پانے والے کے لیے ہے، پس اگر اس کے بعد اس کا صاحب پایا گیا اور اس کا وصف بیان کیا: تو اسے اس کے سپرد کرے اگر وہ موجود ہو، اور اس کا ضمان دے اگر اس نے اسے استعمال یا غیرہ سے تلف کیا ہو۔ اور اگر وہ تعریف کے سال میں تفریط اور تعدی کے بغیر تلف ہو گئی: تو اٹھانے والے پر کوئی ضمان نہیں، کیونکہ وہ امینوں کے جملے میں سے ہے، اور وہ اس وقت اس کی ملکیت میں داخل نہیں ہوئی تھی، واللہ اعلم۔"
"42","[AI-translation] جابر بن عبد اللہ رضی اللہ عنہما سے روایت ہے، انہوں نے کہا: «رسول اللہ ﷺ نے ہر اس چیز میں شفعہ کا فیصلہ کیا جو تقسیم نہ ہوئی ہو۔ پس جب حدود واقع ہو جائیں، اور راستے پھیر دیے جائیں، تو کوئی شفعہ نہیں»۔ بخاری نے اسے روایت کیا۔
اس حدیث سے اخذ کیا جاتا ہے: شفعہ کے تمام احکام، اور جس میں شفعہ ہے، اور جس میں شفعہ نہیں ہے۔ اور شفعہ صرف مشترک اموال میں ہے۔ اور وہ دو قسمیں ہیں: عقار اور غیرہ۔ پس اس حدیث میں عقار میں شفعہ ثابت کیا، اور اس پر دلالت کی کہ غیر عقار میں کوئی شفعہ نہیں، پس جانوروں، اور سامانوں، اور عقود میں شرکت، اور تمام منقولات میں کوئی شفعہ نہیں، جب ان میں سے ایک اپنا نصیب بیچے۔ اور رہے عقارات: پس جب وہ الگ کر دیے گئے اور حدود متعین کر دی گئیں، اور راستے پھیر دیے گئے اور دونوں شریکوں میں سے ہر ایک نے اپنا نصیب چن لیا، تو ان میں کوئی شفعہ نہیں، جیسا کہ حدیث کی نص ہے، کیونکہ وہ اس وقت پڑوسی بن جاتا ہے، اور پڑوسی کو اپنے پڑوسی پر کوئی شفعہ نہیں۔ اور رہا جب حدود متعین نہ ہوئیں اور راستے نہ پھیرے گئے، پھر ان میں سے ایک نے اپنا نصیب بیچا: تو باقی شریک یا شرکاء کے لیے شفعہ ہے، یہ کہ وہ اسے اس ثمن سے لیں جس پر عقد واقع ہوا، ہر ایک اپنے ملک کے بقدر۔ اور حدیث کا ظاہر: یہ ہے کہ اس عقار میں کوئی فرق نہیں جس کی قسمت ممکن ہو۔ اور یہی صحیح ہے، کیونکہ شفعہ میں حکمت — اور وہ شریک سے ضرر دور کرنا ہے — دونوں قسموں میں موجود ہے۔ اور حدیث عام ہے۔ اور رہا جس سے دونوں قسموں کے درمیان فرق پر استدلال کیا گیا: تو وہ ضعیف ہے۔ اور علماء نے پڑوسی کے اپنے پڑوسی پر شفعہ میں اختلاف کیا، جب ان کے درمیان دونوں ملکوں کے حقوق میں سے کوئی حق ہو، جیسے مشترک راستہ، یا کنواں یا اس جیسا۔ پس ان میں سے: جس نے اس قسم میں شفعہ واجب کیا، اور کہا: بے شک اس حق میں یہ اشتراک تمام ملک میں اشتراک کی نظیر ہے، اور اس میں ضرر اس جیسا ہے وہاں ضرر کی طرح، اور یہی ہے جس پر دلائل دلالت کرتے ہیں۔ اور ان میں سے: جس نے اس میں شفعہ ثابت نہیں کیا، جیسا کہ امام احمد کے مذہب کا مشہور ہے۔ اور ان میں سے جس نے پڑوسی کے لیے مطلقاً شفعہ ثابت کیا، اور یہ صورت اس کے ہاں بدرجہ اولیٰ ہے، جیسا کہ امام ابو حنیفہ کا مذہب ہے۔ اور نبی ﷺ نے شریک کے لیے شفعہ ثابت کیا: اگر چاہے لے، اور اگر چاہے نہ لے، اور وہ حقوق کے جملے میں سے ہے، جو سوائے اس کے ساقط نہیں ہوتے کہ اسے صراحۃً ساقط کرے، یا اس سے جو اسقاط پر دلالت کرے۔ اور رہا اس میں شفعہ لینے کی طرف جدا جدا جلدی کی شرط، بغیر اس کے کہ اس متفق علیہ حق میں اس کے لیے مہلت ہو: تو یہ ایسا قول ہے جس پر کوئی دلیل نہیں۔ اور جن دو حدیثوں سے انہوں نے استدلال کیا جنہیں انہوں نے وارد کیا: «شفعہ عقال کھولنے کی طرح ہے»، «شفعہ اس کے لیے ہے جو اس پر جھپٹے» اس نے بیع کا علم ہوتے ہی اسے طلب کیا اور اس کی طلب میں تاخیر نہ کی تو ان میں سے کوئی بھی نبی ﷺ سے صحیح نہیں ہوئی۔ پس صحیح: یہ ہے کہ یہ حق دیگر حقوق کی طرح شرط کے خیار میں سے، یا عیب یا اس جیسے میں حق ثابت ہے مگر جب اس کا صاحب اسے قول یا فعل سے ساقط کرے، واللہ اعلم۔"
"43","[AI-translation] ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «اللہ تعالیٰ فرماتا ہے: میں دو شریکوں کا تیسرا ہوں، جب تک ان میں سے ایک اپنے ساتھی سے خیانت نہ کرے، پس اگر وہ اس سے خیانت کرے تو میں ان کے درمیان سے نکل جاتا ہوں»۔ ابو داؤد نے اسے روایت کیا۔
یہ حدیث اپنے عموم سے شرکت کی تمام اقسام کے جواز پر دلالت کرتی ہے: شرکت عنان، اور ابدان، اور وجوہ، اور مضاربت، اور مفاوضت اور شرکت کی دیگر اقسام جن پر دونوں شریک متفق ہوں۔ اور جس نے ان میں سے کسی کو منع کیا تو اس پر ممانعت پر دلالت کرنے والی دلیل لازم ہے، ورنہ اصل جواز ہے، اس حدیث کی وجہ سے، اور اس کی شمولیت کی وجہ سے۔ اور اس لیے کہ اصل ہر معاملے میں جواز ہے۔ اور حدیث شرکتوں کے فضل اور ان کی برکت پر دلالت کرتی ہے، جب وہ سچائی اور امانت پر بنائی گئیں۔ کیونکہ جس کے ساتھ اللہ ہو اس کے رزق میں برکت دیتا ہے، اور اس کے لیے ان اسباب کو آسان کرتا ہے جن سے وہ رزق پائے، اور اسے وہاں سے رزق دیتا ہے جہاں سے وہ گمان نہیں کرتا، اور اس کی مدد کرتا ہے اور اسے درست رکھتا ہے۔ اور یہ: اس لیے کہ شرکتوں میں شریکوں کے درمیان ان کی رائے اور ان کے اعمال میں تعاون حاصل ہوتا ہے۔ اور کبھی ایسے اعمال ہوں جن پر ہر ایک اکیلے قدرت نہ رکھے، اور اعمال اور اموال کے جمع ہونے سے ان کا ادراک ممکن ہو۔ اور شرکتوں کو مکان اور اعمال وغیرہ میں پھیلانا اور وسعت دینا بھی ممکن ہے۔ اور نیز، کیونکہ غالباً ان سے ایسی راحت حاصل ہوتی ہے جو انسان کے اکیلے اپنے علم سے حاصل نہیں ہوتی۔ اور کبھی ان میں سے ایک دوسرے کی راحت کے ساتھ عمل چلائے، یا اس کی بعض اہم باتوں کے لیے جانے کے وقت، یا اس کی بیماری کے وقت۔ اور یہ سب سچائی اور امانت کے ساتھ ہے، پس جب ان میں خیانت داخل ہو، اور ان میں سے ایک یا دونوں دوسرے سے خیانت کی نیت کریں، اور جو اس سے ممکن ہو اسے چھپائیں، تو اللہ ان کے درمیان سے نکل جاتا ہے۔ اور برکت جاتی رہتی ہے۔ اور اسباب آسان نہیں ہوتے۔ اور تجربہ اور مشاہدہ اس حدیث کی گواہی دیتا ہے۔ واللہ اعلم۔"
"44","[AI-translation] ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «جب بندہ مر جاتا ہے تو اس کا عمل منقطع ہو جاتا ہے سوائے تین کے: جاری صدقہ، یا علم جس سے نفع اٹھایا جائے، یا نیک اولاد جو اس کے لیے دعا کرے»۔ مسلم نے اسے روایت کیا۔
دنیا کی دار کو اللہ نے عمل کی دار بنایا ہے، جس سے بندے خیر میں سے، یا شر میں سے، دوسری دار کے لیے زاد لیتے ہیں، اور وہ جزاء کی دار ہے۔ اور کوتاہی کرنے والے نادم ہوں گے جب وہ اس دار سے منتقل ہوں گے، اور اپنی آخرت کے لیے وہ زاد نہ لیں جو انہیں سعادت دے، اور اس وقت تدارک ممکن نہیں۔ اور نہ بندے کے لیے ممکن ہے کہ وہ اپنی نیکیوں میں ذرہ برابر اضافہ کرے، اور نہ اسی طرح اپنی برائیوں میں سے مٹائے۔ اور بندے کا عمل اس سے منقطع ہو جاتا ہے سوائے ان تین اعمال کے جو اس کے عمل کے آثار میں سے ہیں۔ پہلا: جاری صدقہ، یعنی: جس کا نفع مستمر ہو۔ اور یہ جیسے عقارات کا وقف جن کے حاصل سے نفع اٹھایا جائے، یا برتن جن کے استعمال سے نفع اٹھایا جائے، یا جانور جن کی سواری اور منافع سے نفع اٹھایا جائے، یا کتابیں اور مصاحف جن کے استعمال اور ان سے انتفاع سے نفع اٹھایا جائے، یا مساجد اور مدارس اور گھر وغیرہ جن سے نفع اٹھایا جائے۔ پس یہ سب اس کا اجر بندے پر جاری ہے جب تک ان میں سے کسی چیز سے نفع اٹھایا جائے۔ اور یہ وقف کی عظیم فضیلتوں میں سے ہے۔ اور خصوصاً وہ اوقاف جن میں دینی امور پر اعانت ہو، جیسے علم اور جہاد، اور عبادت کے لیے فراغت، اور اس جیسے۔ اور اسی لیے علماء نے وقف میں شرط لگائی: کہ اس کا مصرف نیکی اور قربت کی جہت پر ہو۔ دوسرا: وہ علم جس سے اس کے بعد نفع اٹھایا جائے، جیسے وہ علم جو اس نے علم کے لیے تیار طلبہ کو سکھایا، اور وہ علم جو اس نے لوگوں میں پھیلایا، اور وہ کتابیں جو اس نے نافع علوم کی اقسام میں تصنیف کیں۔ اور اسی طرح ہر وہ چیز جس کی تعلیم سے انتفاع کا تسلسل ہو براہ راست، یا لکھ کر، تو اس کا اجر اس پر جاری ہے۔ پس کتنے ہی ہدایت یافتہ علماء ہیں جو سینکڑوں سال پہلے مر گئے، اور ان کی کتابیں مستعمل ہیں، اور ان کے شاگردوں کی خیر کا تسلسل ہے۔ اور یہ اللہ کا فضل ہے۔ تیسرا: نیک اولاد — صلبی اولاد، یا بیٹے یا بیٹی کی اولاد، مذکر یا مؤنث — اس کا والد اس کی صلاح اور اس کی دعا سے نفع اٹھاتا ہے۔ پس وہ ہر وقت اپنے والدین کے لیے مغفرت اور رحمت کی دعا کرتا ہے، اور درجات کی بلندی، اور ثوابوں کے حصول کی۔ اور یہ جو اس حدیث میں مذکور ہیں وہ اس کا مضمون ہیں: «بے شک ہم مردوں کو زندہ کرتے ہیں اور لکھتے ہیں جو انہوں نے آگے بھیجا اور ان کے آثار» (قرآن یٰس 36:12)۔ پس جو انہوں نے آگے بھیجا: وہ ہے جو انہوں نے حسن یا برے اعمال میں سے براہ راست کیے۔ اور ان کے آثار: وہ ہے جو ان کے اعمال پر مرتب ہوا، جسے دوسروں نے کیا، یا دوسروں نے اس سے نفع اٹھایا۔ اور جو کچھ بندے کو اس کے عمل کے آثار میں سے پہنچتا ہے وہ تین ہیں: پہلا: وہ امور جن پر دوسروں نے اس کے سبب اور اس کی دعوت اور رہنمائی سے عمل کیا۔ دوسرا: وہ امور جن سے دوسروں نے کوئی بھی نفع اٹھایا، اس نفع کے مطابق خیر میں اس کی اقتدا سے۔ تیسرا: وہ امور جنہیں دوسروں نے کیا اور اسے ہدیہ کیا، یا صدقہ اس کی طرف سے دیا یا اس کے لیے دعا کی، خواہ وہ اس کی حسی اولاد میں سے ہوں یا اس کی روحانی اولاد میں سے جنہوں نے اس کی تعلیم سے تربیت پائی، اور اس کی ہدایت اور رہنمائی سے، یا اس کے رشتہ داروں اور محبت کرنے والے ساتھیوں میں سے، یا عام مسلمانوں میں سے، دین میں اس کے مقامات کے مطابق، اور اس کے مطابق جو اس نے بندوں تک خیر پہنچائی، یا اس کا سبب بنا، اور اس کے مطابق جو اللہ نے بندوں کے دلوں میں اس کی محبت رکھی جس پر ضرور اس کے بہت سے آثار مرتب ہوں گے جن میں سے: ان کی دعا، اور ان کا اس کے لیے استغفار ہے۔ اور یہ سب اس شریف حدیث میں داخل ہیں۔ اور کبھی بندے کے لیے ایک ہی چیز میں کئی منافع جمع ہو جاتے ہیں، جیسے نیک عالم اولاد جس کے باپ نے اس کی تعلیم میں کوشش کی، اور جیسے کتابیں جنہیں وہ وقف کرتا ہے یا اسے ہبہ کرتا ہے جو ان سے نفع اٹھائے۔ اور اس حدیث سے شادی کی ترغیب پر استدلال کیا جاتا ہے جس کے ثمرات میں سے نیک اولاد کا حصول ہے، اور دیگر مصلحتوں میں سے، جیسے بیوی کی صلاح اور اسے سکھانا جس سے وہ نفع اٹھائے، اور دوسروں کو نفع دے۔ واللہ اعلم۔"
"45","[AI-translation] اسمر بن مضرس سے روایت ہے کہ رسول اللہ ﷺ نے فرمایا: «جو کسی ایسی چیز کی طرف سبقت کرے جس کی طرف اس سے پہلے کوئی مسلمان سبقت نہ کر چکا ہو تو وہ اسی کی ہے»۔ ابو داؤد نے اسے روایت کیا۔
اس حدیث میں داخل ہے: تمام مباح چیزوں کی طرف سبقت کرنا جو نہ کسی کی ملکیت ہوں اور نہ کسی کے اختصاص میں ہوں۔ پس اس میں داخل ہے: بنجر مردہ زمین کو آباد کرنے کی طرف سبقت۔ پس جو اس کی طرف پانی نکال کر، یا اس پر پانی جاری کر کے، یا تعمیر کر کے سبقت کرے وہ اس کا مالک ہو گیا۔ اور آباد کیے بغیر وہ اس کا مالک نہیں ہوتا۔ لیکن اگر امام یا اس کے نائب نے اسے وہ زمین بطور اقطاع دی ہو، یا اس نے اسے آباد کیے بغیر بنجر زمین پر حد بندی کر کے اپنے لیے مخصوص کر لیا ہو: تو وہ اس کا زیادہ حقدار ہے، اور وہ اس کا مالک نہیں ہوتا۔ پس اگر کوئی اسے آباد کرنے کا خواہشمند ملے تو اس سے کہا جائے گا: یا تو اسے آباد کر، یا اس سے اپنا ہاتھ اٹھا لے۔ اور اس میں داخل ہے: خشکی اور سمندر کے شکار کی طرف سبقت، اور ان کانوں کی طرف جو ظاہر نہ ہوں اور نہ جاری ہوں۔ اور لکڑی یا گھاس یا پھینکی ہوئی چیز جس سے بے رغبتی کی گئی ہو اسے لینے کی طرف سبقت۔ اور مسجدوں اور مدرسوں اور بازاروں اور مسافر خانوں میں بیٹھنے کی طرف سبقت اگر وہ ایسے منتظم پر موقوف نہ ہو جس کے لیے ترتیب اور تعیین مقرر کی گئی ہو، تو اس میں واقفوں اور وصیت کرنے والوں کی نص کی طرف رجوع کیا جائے گا۔ پس جو ایسی مباح چیزوں میں سے کسی چیز کی طرف سبقت کرے جس کا کوئی مالک نہ ہو تو وہی اس کا زیادہ حقدار ہے۔ اور اس میں ملکیت لی ہوئی مقدار تک محدود ہے۔ اور اسی طرح جو ان کاموں میں سبقت کرے جن میں جعالہ ہو جن میں ان کا مالک کہتا ہے: جو میرے لیے یہ کام کرے اس کے لیے اتنا ہے: تو وہی تقدیم اور جعل کا مستحق ہے۔ اور اسی طرح جو گری پڑی چیز اور لاوارث بچے کو اٹھانے کی طرف سبقت کرے، اور دیگر اشیاء، تو یہ سب اس حدیث میں داخل ہے۔ اور اللہ بہتر جانتا ہے۔"
"46","[AI-translation] ابن عباس رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «فرض حصے ان کے حقداروں تک پہنچا دو، پس جو باقی بچے تو وہ سب سے قریبی مرد رشتہ دار کے لیے ہے»۔ متفق علیہ ہے یعنی بخاری اور مسلم دونوں نے اسے روایت کیا۔"
"47","[AI-translation] ابو امامہ باہلی رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: میں نے رسول اللہ ﷺ کو فرماتے ہوئے سنا: «بے شک اللہ نے ہر حقدار کو اس کا حق دے دیا ہے، پس وارث کے لیے کوئی وصیت نہیں»۔ ابو داؤد، ترمذی اور ابن ماجہ نے اسے روایت کیا۔
یہ دونوں حدیثیں میراث کے اکثر احکام، اور وصیتوں کے احکام پر مشتمل ہیں۔ پس بے شک اللہ تعالیٰ نے میراث کے احکام کو مکمل اور واضح تفصیل سے بیان کیا، اور ہر حقدار کو اس کا حق دیا، اور رسول اللہ ﷺ نے حکم دیا کہ فرض حصے ان کے حقداروں تک پہنچائے جائیں، پس وہ عصبہ پر مقدم کیے جائیں گے۔ پس جو باقی بچے تو وہ سب سے قریبی مرد رشتہ دار کے لیے ہے۔ اور وہ عصبہ ہیں جو مذکر فروع میں سے، اور مذکر اصول میں سے، اور اصول کی مذکر فروع میں سے، اور ولاء میں سے ہیں۔ پس ان جہتوں میں سے جب دو یا زیادہ عاصب جمع ہو جائیں تو سب سے قریبی جہت والا مقدم کیا جائے گا۔ پس اگر وہ ایک ہی جہت میں ہوں تو درجے میں سب سے قریبی مقدم کیا جائے گا۔ پس بیٹا پوتے پر مقدم کیا جائے گا، اور مثلاً چچا چچا زاد بھائی پر۔ پس اگر وہ ایک ہی درجے میں ہوں، اور ان میں سے ایک قرابت کی قوت سے ممتاز ہو اور یہ صرف اصول کی فروع میں ہی تصور ہو سکتا ہے، جیسے بھائی اور چچا مطلقاً اور ان کے بیٹے: تو قوی تر یعنی سگا بھائی سوتیلے بھائی پر مقدم کیا جائے گا۔ اور آپ رضی اللہ عنہ کے قول «سب سے قریبی مرد رشتہ دار کے لیے» سے یہی مراد ہے یعنی: اسی ترتیب کے مطابق جہت یا درجے یا قوت میں سب سے قریبی۔ اور اس سے معلوم ہوا: کہ فرض والا ابتدا میں عاصب پر مقدم ہے، اور یہ کہ اگر فرض حصے ترکہ کو پورا گھیر لیں تو عاصب تمام فرائض کے مسائل میں ساقط ہو جائے گا، حتیٰ کہ حماریہ میں بھی، اور وہ یہ ہے کہ جب میت نے شوہر، اور ماں، اور ماں شریک بھائی، اور سگے بھائی چھوڑے ہوں: تو شوہر کے لیے نصف ہے، اور ماں کے لیے چھٹا حصہ، اور ماں شریک بھائیوں کے لیے تیسرا حصہ۔ پس یہ فرض والے ہیں ہم نے ان تک ان کے فرض پہنچا دیے، اور سگے بھائی ساقط ہو گئے؛ کیونکہ وہ عصبہ ہیں۔ اور یہی بہت سے دلائل کی رو سے صحیح ہے۔ یہ ان میں سب سے واضح ہے۔ اور آپ ﷺ کے قول «فرض حصے ان کے حقداروں تک پہنچا دو» سے استدلال کیا جاتا ہے کہ جب فرض حصے زیادہ ہو جائیں اور باہم ٹکرائیں اور ان میں سے بعض بعض کو حجب نہ کریں، تو ان کے لیے عول کیا جائے گا، اور ان کے فرض حصے اسی قدر کم کر دیے جائیں گے جس قدر عول ہوا ہو جیسے قرضے جب مقروض کے ان موجودہ مالوں پر پیش ہوں جو ان کے قرضوں کے لیے کافی نہ ہوں؛ پس انہیں ان کے قرضوں کے بقدر دیا جائے گا۔ اور یہ عدل میں سے ہے۔ پس ہر دو شریک جو کسی چیز کے استحقاق میں شریک ہوں جس کا ہر ایک کے لیے مکمل ہونا ممکن نہ ہو، اور ان میں سے کسی کو تقدیم کی کوئی امتیازی وجہ نہ ہو: تو وہ اپنے استحقاق کے بقدر کم کیے جائیں گے۔ اور یہ ہبات اور وصیتوں اور اوقاف اور دیگر میں ہے، جیسا کہ زیادتی ان کے لیے ان کے املاک اور استحقاق کے بقدر ہے۔ اور حدیث دلالت کرتی ہے کہ جب کوئی فرض والا نہ پایا جائے، تو سارا مال سابقہ ترتیب کے مطابق عصبہ کے لیے ہے۔ اور اسی طرح دلالت کرتی ہے کہ جب صرف فرض والے پائے جائیں، اور کوئی عاصب نہ پایا جائے، تو ان پر ان کے فرضوں کے بقدر رد کیا جائے گا، جیسا کہ ان پر عول کیا جاتا ہے؛ کیونکہ فرض حصے مقرر کرنے اور ان کا اندازہ لگانے کی حکمت میں سے ہے: کہ بقیہ عاصب کے لیے باقی رہے۔ پس جب عاصب نہ پایا جائے تو مزاحم نہ ہونے کی وجہ سے مستحقین پر رد کیا گیا۔ اور حدیث غیر وارث کے لیے وصیت کے صحیح ہونے پر دلالت کرتی ہے۔ لیکن اس میں تفصیل ہے: اگر وصیت کرنے والا مالدار ہو اور اپنے وارثوں کو مالدار چھوڑے، تو مستحب ہے۔ اور اگر وہ فقیر ہو اور اس کے وارث اس کی ساری میراث کے محتاج ہوں، ان کے فقیر ہونے یا کثرت کی وجہ سے، تو اس کے لیے بہتر ہے کہ وہ وصیت نہ کرے، بلکہ اپنا مال اپنے وارثوں کے لیے چھوڑ دے۔ اور رہی وارث کے لیے وصیت، تو حدیث اس کی ممانعت پر دلالت کرتی ہے۔ اور اس کی علت آپ ﷺ کے قول سے بیان کی: «بے شک اللہ نے ہر حقدار کو اس کا حق دے دیا ہے، پس وارث کے لیے کوئی وصیت نہیں»۔ پس جس نے وارث کے لیے وصیت کی اس نے اللہ کی حدوں سے تجاوز کیا، اور بعض وارثوں کو بعض پر فضیلت دی۔ اور برابر ہے کہ یہ وصیت کے طور پر واقع ہو یا وارث کے لیے ہبہ کے طور پر، جیسا کہ علماء کا اتفاق ہے، یا اپنے تہائی مال کو اپنے بعض وارثوں پر وقف کرنے کے طور پر۔ اور بعض نے اس مسئلے میں شذوذ اختیار کیا، پس اسے جائز کہا۔ اور یہ حدیث کے لفظ اور معنی کے منافی ہے۔ اور رہی اجنبی کے لیے، یا دینی جہتوں کے لیے وصیت، تو تہائی یا اس سے کم میں جائز ہے۔ اور جو تہائی سے زائد ہو، وہ وارثوں کی اجازت پر موقوف ہے۔"
"48","[AI-translation] ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «تین شخص ہیں جن کی مدد کرنا اللہ کے ذمے حق ہے: وہ مکاتب جو ادائیگی کا ارادہ رکھے، اور وہ نکاح کرنے والا جو پاکدامنی کا ارادہ رکھے، اور اللہ کے راستے میں جہاد کرنے والا»۔ سنن کے مصنفین نے اسے روایت کیا سوائے نسائی کے۔
اور یہ اس لیے ہے: کہ اللہ تعالیٰ نے خرچ کرنے والوں سے جلد عوض کا وعدہ کیا، اور نفقہ کو مطلق رکھا۔ اور وہ ان نفقات کی طرف پھرتی ہے جنہیں اللہ پسند کرتا ہے؛ کیونکہ عوض کا اس کا وعدہ ثواب کے باب سے ہے جو صرف اسی پر ہوتا ہے جسے اللہ پسند کرتا ہے۔ اور رہے وہ نفقات ان امور میں جنہیں اللہ پسند نہیں کرتا: یا تو معاصی میں، یا مباحات میں اسراف میں، تو اللہ نے ان کے اہل کے لیے عوض کی ضمانت نہیں دی، بلکہ وہ تاوان ہی ہوتی ہیں۔ اور یہ تین مذکورہ امور اس حدیث میں ان بہترین امور میں سے ہیں جنہیں اللہ پسند کرتا ہے۔ پس اللہ کے راستے میں جہاد دین کا کوہان اور اس کی چوٹی اور اس کا اعلیٰ ترین حصہ ہے۔ برابر ہے کہ وہ ہتھیار سے جہاد ہو، یا علم اور دلیل سے جہاد ہو، پس اس راستے میں خرچ کا عوض دیا جائے گا اور اس راستے پر چلنے والا اللہ کی طرف سے مدد یافتہ ہے، اس کا معاملہ اس کے لیے آسان کیا گیا ہے۔ اور رہا مکاتب، تو کتابت کا اللہ نے اپنے قول میں حکم دیا ہے: «پس ان سے کتابت کر لو اگر تم ان میں خیر جانو» (قرآن النور 24:33) یعنی: ان کے دین اور دنیا کو درست کرنے میں صلاحیت۔ پس آقا کو اس کا حکم دیا گیا ہے۔ اور وہ مکاتب غلام جو ادائیگی کا ارادہ رکھے اور آزادی اور اپنے دین و دنیا کے لیے فراغت میں جلدی کرے اللہ اس کی مدد کرتا ہے، اور اس کے امور اس کے لیے آسان کرتا ہے، اور اسے وہاں سے رزق دیتا ہے جہاں سے وہ گمان نہیں کرتا۔ اور آقا پر لازم ہے: کہ وہ اپنے مکاتب سے ان میعادوں کے اندازے میں نرمی کرے جن میں کتابت کی قسطیں حل ہوتی ہیں، اور جب وہ اسے ادا کرے تو اسے کتابت کے مال میں سے چوتھائی دے۔ اور مکاتبوں کے حق میں اللہ تعالیٰ کے قول میں: «اور انہیں اللہ کے اس مال میں سے دو جو اس نے تمہیں دیا ہے» (قرآن النور 24:33) آقا کے لیے اور دیگر مسلمانوں کے لیے حکم ہے۔ اور اسی لیے اللہ نے اس کے لیے اپنے قول میں زکاۃ میں سے حصہ بنایا: «اور گردنوں میں» (قرآن التوبۃ 9:60) اور یہ اللہ تعالیٰ کی مدد میں سے ہے۔ اور نبی ﷺ سے اس سے زیادہ عام بات ثابت ہے، پس آپ نے فرمایا: «جو لوگوں کے مال اس ارادے سے لے کہ انہیں ادا کرے گا اللہ اس کی طرف سے ادا کرے گا، اور جو انہیں ضائع کرنے کے ارادے سے لے گا اللہ اسے ضائع کرے گا»۔ بخاری نے اسے روایت کیا۔ اور رہا نکاح: تو اللہ اور اس کے رسول نے اس کا حکم دیا ہے۔ اور اس پر بہت سے فوائد مرتب کیے ہیں: اللہ کی مدد، اور اللہ اور اس کے رسول کے امر کی تعمیل، اور یہ کہ وہ رسولوں کی سنتوں میں سے ہے۔ اور اس میں ہے: شرمگاہ کی حفاظت۔ اور نگاہ کا جھکانا، اور نسل کا حصول، اور بیوی اور اولاد پر خرچ کرنا؛ پس بے شک بندہ جب اپنے اہل پر ثواب کی نیت سے خرچ کرے تو وہ اس کے لیے اجر ہوگا، اور اللہ کے ہاں نیکیاں، برابر ہے کہ وہ کھانا ہو یا پینا یا لباس یا تمام حاجتوں میں استعمال ہونے والی چیز۔ یہ سب بندے کے لیے خیر ہے، اور جاری نیکیاں ہیں۔ اور یہ قاصر نوافل عبادات سے افضل ہے۔ اور اس میں ہے: بندے پر اللہ کی نعمتوں کو یاد کرنا، اور اس کی عبادت کے لیے فراغت، اور میاں بیوی کا اپنے دین و دنیا کی مصلحتوں پر تعاون کرنا، اور اللہ تعالیٰ نے فرمایا ہے: «پس ان عورتوں سے نکاح کرو جو تمہیں پسند آئیں» (قرآن النساء 4:3) اور رسول اللہ ﷺ نے فرمایا: «عورت سے چار چیزوں کے لیے نکاح کیا جاتا ہے: اس کے مال کے لیے، اور اس کے جمال کے لیے، اور اس کے حسب کے لیے، اور اس کے دین کے لیے، پس تو دیندار کو پا لے تیرے ہاتھ خاک آلود ہوں» اس لیے کہ اس میں احوال اور گھر اور اولاد کی اصلاح ہے، اور شوہر کے دل کا سکون اور اطمینان ہے، پس اگر دین کے ساتھ غیر بھی حاصل ہو جائے تو وہ بھی، ورنہ دین مقصود صفات میں سب سے عظیم ہے، اللہ تعالیٰ نے فرمایا: «پس نیک عورتیں فرمانبردار ہیں غیب کی حفاظت کرنے والیاں اس سے جو اللہ نے محفوظ رکھا» (قرآن النساء 4:34) اور بیوی پر لازم ہے: اللہ کے حق کی، اور اپنے شوہر کے حق کی ادائیگی، اور شوہر کے حق کو تمام مخلوق کے حقوق پر مقدم کرنا۔ اور شوہر پر لازم ہے: اپنی بیوی کی اصلاح کی کوشش کرنا، اور ان تمام اسباب کو اختیار کرنا جن سے ان دونوں کے درمیان موافقت مکمل ہو، پس بے شک موافقت ہی سب سے عظیم مقصود ہے۔ اور اسی لیے نبی ﷺ نے اس عورت کی طرف دیکھنے کی ترغیب دی جس سے وہ منگنی کرنا چاہے، تاکہ وہ اپنے معاملے میں بصیرت پر ہو، اور اللہ بہتر جانتا ہے۔"
"49","[AI-translation] عائشہ رضی اللہ عنہا سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «رضاعت سے وہ حرام ہوتا ہے جو ولادت سے حرام ہوتا ہے»۔ متفق علیہ ہے یعنی بخاری اور مسلم دونوں نے اسے روایت کیا۔
اور یہ اس لیے ہے: کہ نسب سے حرام ہونے والیاں قرآن کی نص اور اجماع سے: مائیں ہیں خواہ ہر جہت سے کتنی ہی اوپر ہوں، اور بیٹیاں خواہ ہر جہت سے کتنی ہی نیچے ہوں، اور بہنیں مطلقاً، اور بھائیوں کی بیٹیاں، اور بہنوں کی بیٹیاں، خواہ نیچے ہوں، اور پھوپھیاں، اور خالائیں۔ پس تمام قرابتیں حرام ہیں، سوائے چچا کی بیٹیوں، اور پھوپھی کی بیٹیوں، اور ماموں کی بیٹیوں، اور خالہ کی بیٹیوں کے۔ اور یہ سات دودھ پلانے والی عورت کی جہت سے، اور دودھ کے مالک کی جہت سے رضاعت میں حرام ہیں، جب رضاعت دو سال کے اندر پانچ یا زیادہ چوسنیاں ہو۔ اور رہا دودھ پینے والے کے قرابت داروں کی جہت سے، تو تحریم اس کی اولاد سے خاص ہے۔ اور رہے اس کے نسبی باپ اور ماں اور ان کے اصول و فروع، تو ان کا تحریم سے کوئی تعلق نہیں۔ اور اسی طرح دو بہنوں کو جمع کرنا حرام ہے، اور عورت اور اس کی پھوپھی، یا اس کی خالہ کو نسب میں جمع کرنا۔ اور اسی طرح رضاعت میں ہے۔ اور اسی طرح بیوی کی مائیں حرام ہیں خواہ کتنی ہی اوپر ہوں، اور اس کی بیٹیاں خواہ کتنی ہی نیچے ہوں، جب وہ اپنی بیوی سے صحبت کر چکا ہو، اور باپوں کی بیویاں خواہ کتنی ہی اوپر ہوں، اور بیٹوں کی بیویاں خواہ کتنی ہی نیچے ہوں ہر جہت سے، اور اسی طرح رضاعت میں ہے۔ اور رضاعت میں جمع کرنے اور سسرالی رشتوں کے تحریم کے مسائل میں اختلاف ہے۔ لیکن جمہور علماء اور چاروں ائمہ کا مذہب، عمومات کی وجہ سے اس کا حرام ہونا ہے۔"
"50","[AI-translation] ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «کوئی مومن مرد کسی مومنہ عورت سے بغض نہ رکھے: اگر اس کی ایک عادت کو ناپسند کرے تو دوسری سے راضی ہو گا»۔ مسلم نے اسے روایت کیا۔
یہ رہنمائی نبی ﷺ کی طرف سے، شوہر کے لیے اپنی بیوی سے حسن معاشرت میں سب سے بڑے اسباب اور داعیوں میں سے ہے، پس آپ نے مومن کو اپنی بیوی سے بری معاشرت سے منع کیا۔ اور کسی چیز سے نہی اس کے ضد کا امر ہے۔ اور اسے حکم دیا کہ وہ اس میں جو اچھے اخلاق ہیں، اور وہ امور جو اس کے موافق ہیں انہیں ملحوظ رکھے، اور انہیں اس کے اخلاق میں سے جسے اس نے ناپسند کیا اس کے مقابلے میں رکھے پس بے شک شوہر جب اپنی بیوی میں جو اچھے اخلاق ہیں، اور وہ خوبیاں جنہیں وہ پسند کرتا ہے ان میں غور کرے، اور اس سبب کو دیکھے جس نے اسے اس سے تنگ ہونے اور اس سے بری معاشرت کی طرف بلایا، تو وہ اسے ایک یا دو چیزیں مثلاً پائے گا، اور اس میں جسے وہ پسند کرتا ہے وہ زیادہ ہے۔ پس جب وہ منصف ہو تو اس کی برائیوں سے چشم پوشی کرے گا اس لیے کہ وہ اس کی خوبیوں میں گم ہو کر کم ہیں۔ اور اسی سے: صحبت باقی رہتی ہے، اور واجب اور مستحب حقوق ادا کیے جاتے ہیں۔ اور بسا اوقات کہ جسے اس نے ناپسند کیا وہ اسے درست کرنے یا بدلنے کی کوشش کرے۔ اور رہا جو خوبیوں سے چشم پوشی کرے، اور برائیوں کو ملحوظ رکھے خواہ وہ کم ہوں، تو یہ انصاف نہ ہونے میں سے ہے۔ اور وہ اپنی بیوی کے ساتھ بمشکل ہی صاف رہے گا۔ اور لوگ اس میں تین قسموں میں ہیں۔ ان میں سب سے اعلیٰ: وہ ہے جو اچھے اخلاق اور خوبیوں کو ملحوظ رکھے، اور برائیوں سے کلیتاً چشم پوشی کرے اور انہیں بھلا دے۔ اور سب سے کم توفیق اور ایمان اور اچھے اخلاق والا، وہ ہے جس نے معاملہ الٹ دیا، پس خوبیوں کو ضائع کیا خواہ کیسی ہی ہوں، اور برائیوں کو اپنی آنکھوں کے سامنے رکھا۔ اور بسا اوقات انہیں بڑھائے اور پھیلائے اور ان کی تفسیر ایسے ظنون اور تاویلوں سے کرے جو کم کو زیادہ بنا دیں، جیسا کہ واقع ہے۔ اور تیسری قسم: وہ ہے جو دونوں باتوں کو ملحوظ رکھے، اور ان دونوں کے درمیان وزن کرے، اور بیوی سے ہر ایک کے تقاضے کے مطابق معاملہ کرے۔ اور یہ منصف ہے۔ لیکن وہ کمال سے محروم رہا۔ اور یہ ادب جس کی طرف رسول اللہ ﷺ نے رہنمائی کی، اس کا اپنانا اور اسے تمام معاشروں اور معاملہ کرنے والوں کے ساتھ استعمال کرنا چاہیے؛ پس بے شک اس کا دینی اور دنیوی نفع بہت ہے، اور اس کا صاحب اپنے دل کی راحت کی کوشش کر چکا، اور اس سبب میں جو اس سے واجب اور مستحب حقوق کی ادائیگی کو پا لے؛ کیونکہ لوگوں میں کمال متعذر ہے۔ اور فاضل کے لیے یہی کافی ہے کہ اس کی برائیاں گنی جائیں۔ اور نفس کو معاشروں سے جو آئے اس پر جمائے رکھنا جو انسان کی رغبت کے خلاف ہو، اس پر حسن خلق، اور لوگوں کے ساتھ نیکی اور احسان کرنا آسان کرتا ہے۔ اور اللہ ہی توفیق دینے والا ہے۔"
"51","[AI-translation] عبد الرحمن بن سمرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے مجھ سے فرمایا: «اے عبد الرحمن بن سمرہ، امارت نہ مانگ، پس بے شک اگر تو وہ مانگنے پر دیا گیا تو اسی کے سپرد کر دیا جائے گا، اور اگر تو وہ بغیر مانگے دیا گیا تو اس پر تیری مدد کی جائے گی۔ اور جب تو کسی قسم پر قسم کھائے پھر اس کے غیر کو اس سے بہتر دیکھے، تو جو بہتر ہے اسے اختیار کر، اور اپنی قسم کا کفارہ دے»۔ متفق علیہ ہے یعنی بخاری اور مسلم دونوں نے اسے روایت کیا۔
یہ حدیث دو عظیم جملوں پر مشتمل ہے: پہلا: کہ امارت اور مخلوق پر دیگر ولایتیں، بندے کو انہیں نہیں مانگنا چاہیے، اور نہ ان کے لیے خود کو پیش کرنا چاہیے۔ بلکہ اللہ سے عافیت اور سلامتی مانگے، پس بے شک وہ نہیں جانتا، کیا ولایت اس کے لیے خیر ہوگی یا شر؟ اور وہ نہیں جانتا، کیا وہ اسے قائم کرنے کی استطاعت رکھتا ہے، یا نہیں؟ پس جب اس نے اسے مانگا اور اس پر حرص کی، تو اپنے نفس کے سپرد کر دیا گیا۔ اور جب بندہ اپنے نفس کے سپرد کر دیا جائے، تو وہ توفیق نہیں پاتا، اور نہ اپنے امور میں درست رکھا جاتا ہے، اور نہ اس پر اس کی مدد کی جاتی ہے، کیونکہ اس کا مانگنا دو محذوروں سے خبر دیتا ہے: پہلا: دنیا اور ریاست پر حرص، اور حرص اللہ کے مال میں بے جا خرچ میں شک میں ڈالنے، اور اللہ کے بندوں پر بلندی پر ابھارتا ہے۔ دوسرا: اس میں نفس پر ایک طرح کا اعتماد ہے، اور اللہ سے مدد طلب کرنے سے انقطاع ہے۔ اور اسی لیے آپ نے فرمایا: «اسی کے سپرد کر دیا جائے گا»۔ اور رہا جس نے اس پر حرص نہیں کی اور نہ اس کی طرف دیکھا، بلکہ وہ اسے بغیر مانگے آئی اور اس نے خود میں اس پر قدرت نہ ہونا دیکھا، تو بے شک اللہ اس پر اس کی مدد کرتا ہے، اور اسے اس کے نفس کے سپرد نہیں کرتا کیونکہ اس نے بلا کے لیے خود کو پیش نہیں کیا، اور جسے بلا اس کے اختیار کے بغیر آئے وہ اس سے اٹھا لی جاتی ہے، اور اس کے وظیفے کو قائم کرنے کی توفیق دی جاتی ہے۔ اور اس حالت میں اللہ تعالیٰ پر اس کا توکل قوی ہوتا ہے، اور جب بندہ اللہ پر توکل کرتے ہوئے سبب کو قائم کرے تو کامیاب ہوتا ہے۔ اور آپ ﷺ کے قول میں: «اس پر تیری مدد کی جائے گی» دلیل ہے کہ امارت اور دیگر دنیوی ولایتیں دونوں باتوں کو جامع ہیں: دین کے لیے، اور دنیا کے لیے، پس بے شک تمام ولایتوں سے مقصود ہے: لوگوں کے دین اور دنیا کی اصلاح۔ اور اسی لیے: ان سے امر و نہی متعلق ہے، اور واجبات کا پابند کرنا، اور محرمات سے روکنا، اور حقوق کی ادائیگی کا پابند کرنا۔ اور اسی طرح سیاست اور جہاد کے امور، پس وہ جس نے ان میں اللہ کے لیے اخلاص کیا اور واجب کو قائم کیا تو بہترین عبادات میں سے ہے، اور جو ایسا نہ ہو تو عظیم خطرات میں سے ہے۔ اور اسی لیے وہ فرض کفایہ میں سے تھیں؛ کیونکہ بہت سے واجبات ان پر موقوف ہیں۔ پس اگر کہا جائے: یوسف نے مالی خزانوں کی ولایت کیسے مانگی اپنے قول میں: «مجھے زمین کے خزانوں پر مقرر کر دو» (قرآن یوسف 12:55) تو کہا جائے گا: اس کا جواب اللہ تعالیٰ کے قول میں ہے: «بے شک میں حفاظت کرنے والا جاننے والا ہوں» (قرآن یوسف 12:55) پس وہ بے شک اسے اسی مصلحت کے لیے مانگا جسے اس کے سوا کوئی قائم نہیں کر سکتا تھا: کامل حفاظت سے، اور ان خزانوں سے متعلق تمام جہتوں کے علم سے۔ حسن استخراج سے، اور حسن تصریف سے، اور کامل عدل قائم کرنے سے۔ پس جب اس نے دیکھا کہ بادشاہ نے اسے اپنے لیے خاص کر لیا اور اسے اپنے پر مقدم کیا، اور اعلیٰ مقام میں رکھا، تو اس پر بھی واجب ہوا مکمل خیرخواہی، بادشاہ اور رعیت کے لیے۔ اور وہ اس کی ولایت میں متعین ہے۔ اور اسی لیے: جب اس نے زمین کے خزانوں کی ولایت سنبھالی تو زراعت کو مضبوط کرنے میں بہت کوشش کی۔ پس مصری دیاروں میں اول سے آخر تک کوئی موضع نہ رہا جو زراعت کے لائق ہو مگر سات سال کی مدت میں زراعت کی گئی۔ پھر اسے محفوظ کیا اور اس عجیب حفاظت سے اس کی حفاظت کی۔ پھر جب قحط کے سال آئے، اور لوگ ارزاق کے محتاج ہوئے، تو لوگوں کے لیے عدل سے ناپنے میں کوشش کی، پس تاجروں کو کھانا خریدنے سے منع کیا محتاجوں پر تنگی کے خوف سے، اور اس سے مصلحتوں اور منافع میں سے ایسی چیز حاصل ہوئی جو گنی اور شمار نہیں کی جا سکتی، جیسا کہ معروف ہے۔ دوسرا جملہ: آپ ﷺ کا قول: «اور جب تو کسی قسم پر قسم کھائے، پھر اس کے غیر کو اس سے بہتر دیکھے تو جو بہتر ہے اسے اختیار کر، اور اپنی قسم کا کفارہ دے»۔ یہ اس کو شامل ہے جس نے واجب کے ترک پر، یا مسنون کے ترک پر قسم کھائی؛ پس بے شک وہ اپنی قسم کا کفارہ دے، اور وہ واجب اور مسنون کرے جس کے ترک پر اس نے قسم کھائی تھی۔ اور یہ اس کو شامل ہے جس نے محرم کے کرنے پر، یا مکروہ کے کرنے پر قسم کھائی، پس بے شک اسے اس محرم اور مکروہ کے ترک کا حکم دیا جائے گا، اور وہ اپنی قسم کا کفارہ دے گا۔ پس چاروں قسمیں آپ ﷺ کے قول میں داخل ہیں: «پس جو بہتر ہے اسے اختیار کر» کیونکہ مطلقاً مامور کا کرنا، اور مطلقاً منہی کا ترک کرنا: خیر میں سے ہے۔ اور یہی اللہ تعالیٰ کے قول کا معنی ہے: «اور اللہ کو اپنی قسموں کے لیے نیکی کرنے اور تقویٰ اختیار کرنے اور لوگوں کے درمیان صلح کرنے میں رکاوٹ نہ بناؤ» (قرآن البقرۃ 2:224) یعنی: قسم کو اپنے لیے عذر اور رکاوٹ اور مانع نہ بناؤ ان نیکی اور تقویٰ کے کاموں، اور لوگوں کے درمیان صلح کرنے سے جب تم ان امور کے ترک پر قسم کھاؤ، بلکہ اپنی قسموں کا کفارہ دو، اور نیکی اور تقویٰ کرو، اور لوگوں کے درمیان صلح کرو۔ اور اس حدیث سے لیا جاتا ہے: کہ قسم کی حفاظت ان امور کے غیر میں اولیٰ ہے، لیکن اگر قسم مامور کے کرنے پر، یا منہی کے ترک پر ہو، تو اس کے لیے جائز نہ تھا کہ وہ حانث ہو۔ اور اگر مباح میں ہو، تو دونوں باتوں میں اختیار ہے۔ اور اس کی حفاظت اولیٰ ہے۔ اور جان لو کہ کفارہ صرف مستقبل پر منعقد قسم میں واجب ہوتا ہے جب وہ قسم کھائے اور حانث ہو۔ اور وہ آزاد کرنے، یا دس مسکینوں کو کھلانے، یا انہیں کپڑا پہنانے کے درمیان اختیار پر ہے۔ پس جو نہ پائے تو تین دن روزے رکھے۔ اور رہی گزشتہ امور پر قسم یا لغو قسم، جیسے انسان کا اپنی بات کے دوران کہنا: نہیں اللہ کی قسم، اور ہاں اللہ کی قسم، تو اس میں کوئی کفارہ نہیں۔ اور اللہ بہتر جانتا ہے۔"
"52","[AI-translation] عائشہ رضی اللہ عنہا سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «جو نذر مانے کہ وہ اللہ کی اطاعت کرے گا تو اسے اس کی اطاعت کرنی چاہیے، اور جو نذر مانے کہ وہ اللہ کی نافرمانی کرے گا تو وہ اس کی نافرمانی نہ کرے»۔ بخاری نے اسے روایت کیا۔
نذر بندے کا اپنے نفس پر اللہ کی طاعت لازم کرنا ہے: یا تو بغیر سبب کے، جیسے اس کا کہنا: اللہ کے لیے مجھ پر ہے یا میں نے نذر مانی گردن آزاد کرنے کی، یا اتنے اتنے روزے رکھنے کی، یا اتنا اتنا صدقہ کرنے کی۔ اور یا تو سبب سے، جیسے وہ اسے اپنے غائب کے آنے پر، یا مریض کے صحت یاب ہونے پر، یا محبوب کے حاصل ہونے پر، یا ناپسندیدہ کے زوال پر معلق کرے، پس جب اس کے لیے اس کا مطلوب پورا ہو جائے تو اس پر وفا واجب ہو گئی۔ اور یہ حدیث تمام طاعتوں کو شامل ہے۔ پس جس نے واجب اور مستحب طاعت کی نذر مانی، تو اس پر نذر سے وفا واجب ہو گئی، اور اس سے کوئی کفارہ نہیں بلکہ وفا متعین ہے، جیسا اسے نبی ﷺ نے اس حدیث میں حکم دیا۔ اور جیسا اللہ نے اپنے قول میں نذر پوری کرنے والوں کی ثنا کی: «وہ نذر پوری کرتے ہیں» (قرآن الانسان 76:7) باوجودیکہ نذر کا عقد مکروہ ہے، جیسا اس میں نذر سے منع کیا۔ اور آپ نے فرمایا: «وہ کوئی خیر نہیں لاتی، اور وہ تو بخیل سے نکلواتی ہے»۔ اور رہی معصیت کی نذر، تو بندے پر متعین ہے کہ وہ اللہ کی معصیت ترک کرے خواہ اس نے اس کی نذر مانی ہو۔ اور نذر کی باقی قسمیں، جیسے معصیت کی نذر، اور مباح کی نذر، اور لجاج اور غضب کی نذر، ان کا حکم حنث میں قسم کے حکم کی طرح ہے، ان میں قسم کا کفارہ ہے کیونکہ وہ معنی میں قسم کے شریک ہیں۔ اور اللہ بہتر جانتا ہے۔"
"53","[AI-translation] علی رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «مسلمانوں کے خون برابر ہیں، اور ان میں سب سے ادنیٰ ان کی ذمہ سے کوشش کرتا ہے، اور ان میں سب سے دور والا ان کی طرف لوٹاتا ہے، اور وہ غیروں کے مقابلے میں ایک ہاتھ ہیں۔ خبردار! کوئی مسلمان کافر کے بدلے قتل نہ کیا جائے، اور نہ عہد والا اپنے عہد میں»۔ ابو داؤد اور نسائی نے اسے روایت کیا۔
اور اسے ابن ماجہ نے ابن عباس سے روایت کیا۔ یہ حدیث اللہ تعالیٰ کے قول کی تفصیل کی طرح ہے: «مومن تو صرف بھائی بھائی ہیں» (قرآن الحجرات 49:10) اور آپ ﷺ کے قول کی: «اور اللہ کے بندو بھائی بھائی ہو جاؤ»۔ پس مومنوں پر لازم ہے: کہ وہ محبت کرنے والے ہوں، صاف دل ہوں نہ بغض رکھنے والے اور نہ دشمنی کرنے والے، وہ سب ان کی کلی مصلحتوں کے لیے کوشش کریں جن سے ان کے دین و دنیا کا قیام ہے، نہ شریف وضیع پر تکبر کرے، اور نہ ان میں سے کوئی کسی کو حقیر جانے۔ پس ان کے خون برابر ہیں، پس بے شک قصاص میں صرف دین میں برابری شرط ہے، پس مسلمان کافر کے بدلے قتل نہ کیا جائے گا، جیسا اس حدیث میں ہے، اور آزادی میں برابری، پس آزاد غلام کے بدلے قتل نہ کیا جائے گا۔ اور رہے باقی اوصاف، تو تمام مسلمان ایک سطح پر ہیں۔ پس جس نے عمداً زیادتی سے قتل کیا یا عضو کاٹا، تو ان کے لیے ہے کہ وہ اس سے قصاص لیں بشرطیکہ عضو میں مماثلت ہو، چھوٹے اور بڑے کے درمیان کوئی فرق نہیں، اور اس کے برعکس، اور مذکر اور مؤنث کے درمیان اور اس کے برعکس، اور عالم اور جاہل کے، اور شریف اور وضیع کے، اور کامل اور ناقص کے درمیان جیسا اس کے برعکس ان امور میں۔ آپ ﷺ کا قول: «اور ان میں سب سے ادنیٰ ان کی ذمہ سے کوشش کرتا ہے» یعنی: کہ مسلمانوں کی ذمہ ایک ہے۔ پس جب کافر نے مسلمانوں میں سے کسی ایک سے پناہ مانگی تو باقیوں پر اسے امن دینا واجب ہو گیا، جیسا اللہ تعالیٰ نے فرمایا: «اور اگر مشرکوں میں سے کوئی تجھ سے پناہ مانگے تو اسے پناہ دے یہاں تک کہ وہ اللہ کا کلام سنے پھر اسے اس کی امن کی جگہ پہنچا دے» (قرآن التوبۃ 9:6) پس اس میں شریف سردار کی پناہ دینے، اور عام لوگوں میں سے ایک کی پناہ دینے کے درمیان کوئی فرق نہیں۔ اور آپ ﷺ کا قول: «اور ان میں سب سے دور والا ان کی طرف لوٹاتا ہے» یعنی: امن دینے میں اور اسی طرح لشکروں کا ان کے ان دستوں کے ساتھ شریک ہونا جو جاتے ہیں پس حملہ کرتے ہیں یا پہرہ دیتے ہیں، پس جب لشکر غنیمت پائے، یا لشکر کے تابع دستوں میں سے کوئی دستہ غنیمت پائے، تو سب غنیمت میں شریک ہوئے۔ اور اس میں مباشرت کرنے والا خاص نہیں؛ کیونکہ وہ سب اپنے کام پر تعاون کرنے والے ہیں۔ اور آپ ﷺ کا قول: «اور وہ غیروں کے مقابلے میں ایک ہاتھ ہیں» یعنی: تمام زمین میں تمام مسلمانوں پر واجب ہے کہ وہ کفار میں سے اپنے دشمنوں پر قول و فعل سے، اور جنگی امور میں، اور اقتصادی امور میں مددوں اور معاونت سے، اور ہر وسیلے سے دفاع سے ایک ہاتھ ہوں۔ پس مسلمانوں پر لازم ہے: کہ وہ یہ واجبات اپنی استطاعت کے بقدر قائم کریں، تاکہ اللہ انہیں نصرت دے اور انہیں عزت دے، اور ایمان کے واجبات کو قائم کرنے سے دشمنوں کی زیادتی کو ان سے دفع کرے، پس ہم اس سے سوال کرتے ہیں کہ انہیں اس کی توفیق دے۔ اور آپ ﷺ کا قول: «اور نہ عہد والا اپنے عہد میں» یعنی: اس کافر کا قتل حلال نہیں جس کا ذمہ یا امن یا صلح سے عہد ہو، پس بے شک جب آپ نے فرمایا: «کوئی مسلمان کافر کے بدلے قتل نہ کیا جائے» تو آپ نے معاہد کے قتل کے حرام ہونے کے اس بیان سے احتراز کیا تاکہ کوئی گمان کرنے والا اس کے جواز کا گمان نہ کرے۔ اور اللہ بہتر جانتا ہے۔"
"54","[AI-translation] عمرو بن شعیب سے، انہوں نے اپنے والد سے، انہوں نے اپنے دادا سے روایت کیا کہ رسول اللہ ﷺ نے فرمایا: «جو علاج کرے اور اس سے علاج معلوم نہ ہو، تو وہ ضامن ہے»۔ ابو داؤد اور نسائی نے اسے روایت کیا۔
یہ حدیث اپنے لفظ اور مفہوم سے دلالت کرتی ہے: کہ کسی کے لیے حلال نہیں کہ وہ صنعتوں میں سے کسی صنعت کو اختیار کرے جب وہ اسے اچھی طرح نہ جانتا ہو، برابر ہے کہ وہ طب ہو یا غیرہ، اور یہ کہ جو اس پر جری ہوا، تو وہ گناہگار ہے۔ اور اس کے عمل پر جو مرتب ہوا نفس یا عضو یا اس جیسے کے تلف ہونے میں سے، تو وہ اس کا ضامن ہے، اور اس نے اس صنعت کے مقابلے میں جو وہ اچھی طرح نہیں جانتا مال میں سے جو لیا، تو وہ اسے دینے والے پر لوٹایا جائے گا؛ کیونکہ اس نے اسے صرف اس کے دھوکے اور اس کے وہم دلانے سے دیا کہ وہ اچھی طرح جانتا ہے، حالانکہ وہ اچھی طرح نہیں جانتا، پس وہ دھوکے میں داخل ہے، اور «جو ہمیں دھوکہ دے وہ ہم میں سے نہیں»۔ اور اسی طرح معمار اور بڑھئی اور لوہار اور موچی اور جولا ہے اور ان جیسے جنہوں نے اپنے نفس کو اس کے لیے کھڑا کیا، وہم دلاتے ہوئے کہ وہ صنعت کو اچھی طرح جانتا ہے، حالانکہ وہ جھوٹا ہے۔ اور حدیث کے مفہوم سے ہے: کہ ماہر طبیب اور اس جیسا جب مباشرت کرے اور اس کا ہاتھ زیادتی نہ کرے، اور اس پر تلف مرتب ہو، تو وہ ضامن نہیں؛ کیونکہ اس میں مکلف یا اس کے ولی کی طرف سے اجازت ہے۔ پس جو بھی اجازت دی گئی چیز پر مرتب ہو، تو وہ غیر مضمون ہے، اور جو اجازت دی گئی چیز کے غیر پر مرتب ہو، تو وہ مضمون ہے۔ اور اس سے استدلال کیا جاتا ہے: کہ طب کی صنعت نافع علوم میں سے ہے جو شرعاً اور عقلاً مطلوب ہیں۔ اور اللہ بہتر جانتا ہے۔"
"55","[AI-translation] عائشہ رضی اللہ عنہا سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «مسلمانوں سے حدود کو دفع کرو جہاں تک تم استطاعت رکھو، پس اگر اس کے لیے کوئی نکلنے کی راہ ہو، تو اس کا راستہ چھوڑ دو، پس بے شک امام کا معاف کرنے میں غلطی کرنا، سزا دینے میں غلطی کرنے سے بہتر ہے»۔ ترمذی نے اسے نبی ﷺ تک مرفوعاً اور صحابی تک موقوفاً روایت کیا۔
یہ حدیث: دلالت کرتی ہے کہ حدود شبہات سے دفع کی جاتی ہیں۔ پس جب انسان کا معاملہ مشتبہ ہو جائے اور اس کا حال ہم پر مشکل ہو جائے، اور احتمالات واقع ہوں: کیا اس نے حد کو واجب کرنے والا کام کیا یا نہیں؟ اور کیا وہ جاننے والا ہے یا جاہل؟ اور کیا وہ تاویل کرنے والا ہے جو اس کے حلال ہونے کا معتقد ہے یا نہیں؟ اور کیا اس کے لیے عقد یا اعتقاد کا کوئی عذر ہے؟ تو اس سے سزا دفع کر دی گئی، کیونکہ ہم نے اس کے موجب کو یقینی طور پر متحقق نہیں کیا۔ اور اگر معاملہ دونوں باتوں کے درمیان متردد ہو، تو اس کے سبب کے کرنے والے سے سزا دفع کرنے میں غلطی، اس پر سزا واقع کرنے میں غلطی سے جو اس کا سبب نہ کرے ہلکی ہے، پس بے شک اللہ کی رحمت اس کے غضب پر سبقت لے گئی، اور اس کی شریعت آسانی اور سہولت پر مبنی ہے۔ اور معصوموں کے خونوں اور ان کے بدنوں اور ان کے مالوں میں اصل تحریم ہے، یہاں تک کہ ہم اس کو متحقق کریں جو ہمارے لیے اس میں سے کچھ کو مباح کرے۔ اور علماء نے اس اصل پر حدود کے ابواب میں بہت سی مثالیں ذکر کی ہیں، اور ان میں اکثر اس حدیث کے موافق ہیں۔ اور ان میں سے: ایسی مثالیں ہیں جن میں نظر ہے، پس بے شک وہ احتمال جو وہم اور خیال کے مشابہ ہو، اس کا کوئی اعتبار نہیں۔ اور میزان اس حدیث کا لفظ ہے۔ پس اگر تم اس کے لیے پاؤ، یا اگر اس کے لیے نکلنے کی راہ ہو، تو اس کا راستہ چھوڑ دو۔ اور اس حدیث میں اصل پر دلیل ہے۔ اور وہ ہے: کہ جب دو مفسدتیں تحقیقاً یا احتمالاً ٹکرائیں، تو ہم بڑی مفسدت کا خیال رکھتے ہیں، پس شر کو ہلکا کرنے کے لیے اسے دفع کرتے ہیں۔ اور اللہ بہتر جانتا ہے۔"
"56","[AI-translation] حضرت علی رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «معصیت میں کوئی اطاعت نہیں، اطاعت تو صرف معروف (نیکی) میں ہے»۔ متفق علیہ (بخاری اور مسلم)۔
یہ حدیث ہر اس شخص کی اطاعت کے لیے ایک قید ہے جس کی اطاعت واجب ہے، خواہ حکمران ہوں، والدین ہوں، شوہر ہو یا ان کے علاوہ۔ کیونکہ شریعت دینے والے نے ان کی اطاعت کا حکم دیا ہے۔ اور ان میں سے ہر ایک کی اطاعت اس کے حال کے مناسب امور میں ہے، اور وہ سب معروف کے ساتھ ہے۔ کیونکہ شارع نے بہت سے احکام میں لوگوں کو عرف اور عادت کی طرف لوٹایا ہے، جیسے نیکی اور صلہ رحمی، اور عدل اور عام احسان۔ اسی طرح اس کی اطاعت بھی جس کی اطاعت واجب ہے۔ اور یہ سب اس قید سے مقید ہے، اور یہ کہ ان میں سے جس نے اللہ کی معصیت کا حکم دیا، کسی حرام فعل کے کرنے کا یا کسی واجب کے چھوڑنے کا، تو اللہ کی معصیت میں کسی مخلوق کی اطاعت نہیں۔ پس جب ان میں سے کوئی کسی معصوم جان کے قتل کا، یا اسے مارنے کا، یا اس کا مال لینے کا، یا واجب حج کے چھوڑنے کا، یا کسی واجب عبادت کے چھوڑنے کا، یا اس سے قطع تعلق کا حکم دے جس سے جوڑنا واجب ہے، تو ان کی کوئی اطاعت نہیں، اور مخلوق کی اطاعت پر اللہ کی اطاعت کو مقدم کیا جائے گا۔ اور اس حدیث سے سمجھا جاتا ہے: کہ جب ان کی واجب اطاعت اور نفلوں میں سے کسی نفل کا تعارض ہو جائے تو ان کی اطاعت کو مقدم کیا جائے گا: کیونکہ نفل کا چھوڑنا معصیت نہیں۔ پس جب شوہر اپنی بیوی کو نفلی روزے سے یا نفلی حج سے روکے، یا حکمران سیاسی امور میں سے کسی ایسے کام کا حکم دے جو کسی مستحب کے ترک کو مستلزم ہو، تو واجب کو مقدم کرنا واجب ہے۔ اور آپ ﷺ کا قول: «اطاعت تو صرف معروف میں ہے» جیسا کہ وہ ان باتوں کو شامل ہے جو ہم نے ذکر کیں، اسی طرح وہ اسے بھی شامل ہے کہ اس کو قدرت اور استطاعت سے معلق کیا جائے، جیسا کہ اصل شریعت میں واجبات معلق ہیں۔ اور حدیث میں ہے «تم پر سننا اور اطاعت کرنا لازم ہے اپنی استطاعت کے مطابق»۔ واللہ اعلم۔"
"57","[AI-translation] حضرت عبداللہ بن عمرو اور حضرت ابوہریرہ رضی اللہ عنہما سے روایت ہے، دونوں نے کہا: رسول اللہ ﷺ نے فرمایا: «جب حاکم فیصلہ کرے، پھر اجتہاد کرے اور درست فیصلہ کرے تو اس کے لیے دو اجر ہیں۔ اور جب وہ فیصلہ کرے، پھر اجتہاد کرے اور خطا کرے تو اس کے لیے ایک اجر ہے»۔ متفق علیہ (بخاری اور مسلم)۔
حاکم سے مراد وہ ہے جس کے پاس اتنا علم ہو جو اسے قضا کا اہل بنائے۔ اور اہل علم نے قاضی کی شرطیں ذکر کی ہیں۔ پس بعض نے ان میں مبالغہ کیا ہے، اور بعض نے صرف اس علم پر اکتفا کیا ہے جو فتویٰ کے لیے درست ہو۔ اور یہی اولیٰ ہے۔ پس اس حدیث میں ہے: کہ جاہل اگر فیصلہ کرے اور درست فیصلہ بھی کرے تو وہ ظالم اور گناہ گار ہے، کیونکہ اس کے لیے جاہل ہوتے ہوئے فیصلے پر اقدام کرنا حلال نہیں۔ اور یہ اس پر دلالت کرتا ہے: کہ حاکم کے لیے اجتہاد ضروری ہے۔ اور وہ دو قسم کا ہے: ایک اجتہاد اس مقدمے کو جس میں فیصلہ کے لیے رجوع کیا گیا ہے شرعی احکام میں داخل کرنے میں۔ اور دوسرا اجتہاد اس حق کے قریبی اور دوست اور ان کے مقابل پر نافذ کرنے میں، اس طرح کہ اس باب میں سب لوگ اس کے نزدیک ایک ہوں، وہ کسی ایک کو دوسرے پر فضیلت نہ دے، اور خواہش اسے مائل نہ کرے۔ پس جب وہ ایسا ہو تو وہ ہر حال میں اجر پانے والا ہے: اگر درست ہو تو اس کے لیے دو اجر ہیں۔ اور اگر خطا کرے تو اس کے لیے ایک اجر ہے، اور اس کی خطا معاف ہے، کیونکہ وہ اس کی استطاعت سے باہر تھی۔ اور عدل بھی دیگر امور کی طرح استطاعت سے معلق ہے۔ اور مجتہد حاکم اور خواہش پرست کے درمیان فرق یہ ہے: کہ حق والا وہ ہے جس نے وہ کیا جس کا اسے حکم دیا گیا تھا، یعنی اچھی نیت اور اجتہاد کا، اور وہ ظاہر میں اسی اعتقاد کا مکلف ہے جو اس کے پاس قائم دلیل کے مطابق ہو، برخلاف خواہش پرست کے، کیونکہ وہ بغیر علم کے اور حق کے قصد کے بغیر بات کرتا ہے۔ یہ شیخ الاسلام نے کہا۔ اور اس میں ہے: اس حاکم کی فضیلت جو اس وصف پر ہو، اور یہ کہ وہ ہر مقدمے میں جس کا وہ فیصلہ کرتا ہے اجر و ثواب پاتا ہے۔ اور اسی لیے قضا فرض کفایہ میں سے سب سے عظیم ہے؛ کیونکہ مخلوق کے درمیان حقوق سب جھگڑے یا اشتباہ کے وقت قاضی کے محتاج ہیں۔ اور اس پر لازم ہے: کہ وہ اس اجتہاد کے حاصل کرنے پر اپنے نفس سے جہاد کرے جس سے اس کی ذمہ داری بری ہو، اور جس سے وہ خیر اور عظیم اجر پائے۔ واللہ اعلم۔"
"58","[AI-translation] حضرت ابن عباس رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «اگر لوگوں کو ان کے دعووں کے ساتھ دے دیا جائے تو لوگ دوسری قوموں کے خونوں اور ان کے مالوں کا دعویٰ کریں گے، لیکن قسم مدعیٰ علیہ (جس پر دعویٰ کیا گیا ہو) پر ہے»۔ مسلم نے روایت کیا۔ اور بیہقی کے پاس ایک لفظ میں ہے: «بینہ (دلیل) مدعی پر ہے، اور قسم اس پر ہے جو انکار کرے»۔
یہ حدیث بڑی قدر والی ہے۔ اور یہ مقدمات اور احکام کی بڑی بنیادوں میں سے ایک بڑی بنیاد ہے؛ کیونکہ لوگوں کے درمیان قضا تو جھگڑے کے وقت ہی ہوتی ہے: یہ ایک دوسرے پر حقوق میں سے کسی حق کا دعویٰ کرتا ہے، تو وہ اس کا انکار کرتا ہے، اور یہ اس حق سے اپنی براءت کا دعویٰ کرتا ہے جو اس پر ثابت تھا۔ پس آپ ﷺ نے ایک ایسی بنیاد بیان فرمائی جو ان کے جھگڑے کو ختم کرتی ہے، اور جس سے حق والا اور باطل والا واضح ہو جاتا ہے۔ پس جس نے کسی عین، یا کسی قرض، یا حقوق اور ان کے متعلقات میں سے کسی حق کا دوسرے پر دعویٰ کیا، اور اس دوسرے نے اس کا انکار کیا، تو اصل انکار کرنے والے کے ساتھ ہے۔ پس یہ مدعی اگر اس حق کو ثابت کرنے والی بینہ لے آئے تو اس کے لیے وہ حق ثابت ہو جائے گا، اور اس کے حق میں فیصلہ کیا جائے گا، اور اگر وہ بینہ نہ لائے تو دوسرے پر اس کے لیے سوائے قسم کے کچھ نہیں۔ اور اسی طرح جس نے اس حق سے اپنی براءت کا دعویٰ کیا جو اس پر تھا، یعنی یہ کہ اس نے ادا کر دیا ہے اور بری ہو گیا ہے، اور صاحب حق نے اس کا انکار کیا، اور کہا: کہ وہ اب بھی اس کے ذمے باقی ہے، تو اگر ادائیگی اور براءت کا دعویٰ کرنے والا بینہ نہ لائے تو اس کے ذمے حق کے باقی ہونے کا فیصلہ کیا جائے گا، کیونکہ یہی اصل ہے۔ لیکن صاحب حق پر اس کے باقی ہونے کی قسم ہے۔ اور اسی طرح عیبوں کے دعوے، اور شرطوں، اور میعادوں، اور دستاویزوں کے دعوے: یہ سب اسی باب سے ہیں۔ پس معلوم ہوا کہ یہ حدیث قضا کے تمام مسائل میں قاضیوں کو اس کی سخت ضرورت ہے؛ کیونکہ بینہ حق کو واضح کرنے والی چیز کا نام ہے۔ اور وہ حقوق کے فرق کے ساتھ مختلف ہوتی ہے، اور اہل علم نے اس کی تفصیل بیان کی ہے۔ اور آپ ﷺ نے اس حدیث میں حکم بیان فرمایا، اور اس کلی شریعت میں حکمت بیان فرمائی، اور یہ کہ وہ بندوں کی ان کے دین اور دنیا میں عین صلاح ہے، اور یہ کہ اگر لوگوں کو ان کے دعووں کے ساتھ دے دیا جائے تو شر اور فساد بہت ہو جائے گا، اور لوگ دوسری قوموں کے خونوں اور ان کے مالوں کا دعویٰ کریں گے۔ پس معلوم ہوا کہ اسلام کی شریعت میں بشر کی صلاح ہے۔ اور جب تم اسے جاننا چاہو تو اس کی کلی شریعتوں میں سے ہر شریعت کا اس کے ضد سے مقابلہ کرو، تم عظیم فرق پاؤ گے، اور گواہی دو گے کہ جس نے اسے شرع کیا وہ حکیم علیم ہے، بندوں پر رحیم ہے؛ کیونکہ وہ حکمت اور عدل، اور رحمت، اور مظلوم کی مدد، اور ظالم کو روکنے پر مشتمل ہے۔ اور بعض محققین نے کہا ہے: کہ شریعت نے قسم کو دعویٰ کرنے والوں کے دونوں پہلوؤں میں سے قوی تر پہلو میں رکھا ہے۔ اور جس نے اس کا پیچھا کیا اس نے اسے جان لیا۔ واللہ اعلم۔"
"59","[AI-translation] حضرت عائشہ رضی اللہ عنہا سے مرفوعاً روایت ہے: «خائن اور خائنہ کی شہادت جائز نہیں، اور نہ اس کی جس پر حد لگائی گئی ہو، اور نہ اس کی جو اپنے بھائی پر کینہ رکھتا ہو اس کے خلاف، اور نہ اس کی جو ولاء یا قرابت میں متہم ہو، اور نہ اہل بیت کے قانع (وابستہ خدمت گار) کی»۔ ترمذی نے روایت کیا۔
یہ حدیث شہادت میں قدح کرنے والی باتوں پر مشتمل ہے۔ اور وہ یہ ہے: کہ اللہ نے عادل اور پسندیدہ لوگوں کو گواہ بنانے کا حکم دیا ہے۔ اور اہل علم نے لوگوں کے درمیان حقوق میں گواہ کے لیے شرط لگائی ہے: کہ وہ ظاہری عادل ہو، اور انہوں نے عدالت کی صفات ذکر کی ہیں۔ اور بعض نے اس کی حد اللہ تعالیٰ کے اس قول سے ماخوذ حد سے کی ہے: ﴿مِمَّن تَرضَونَ مِنَ الشُّهَدَاءِ﴾ یعنی «ان گواہوں میں سے جنہیں تم پسند کرتے ہو» (قرآن البقرہ 2:282) پس کہا: ہر وہ شخص جو لوگوں کے نزدیک پسندیدہ ہو، لوگ اس کی بات اور اس کی شہادت پر مطمئن ہوں، تو وہ مقبول ہے۔ اور یہ سب سے اچھی حد ہے۔ اور لوگوں کے لیے اس کے علاوہ کسی اور پر عمل کی گنجائش نہیں۔ اور وہ چیزیں جو شہادت میں قدح کرتی ہیں وہ تہمت یا اس کے گمان کی طرف لوٹتی ہیں۔ پس لوگوں میں سے کچھ وہ ہیں جن کی شہادت مطلقاً قبول نہیں کی جاتی ان تمام امور میں جن میں شہادت کا اعتبار کیا جاتا ہے، جیسے خائن اور خائنہ، اور وہ جس پر حد لگائی گئی ہو یعنی بڑی معصیت جس سے اس نے توبہ نہ کی ہو کیونکہ اپنی خیانت اور فسق کی وجہ سے وہ عدالت سے محروم ہے، تو اس کی شہادت قبول نہیں کی جاتی۔ اور لوگوں میں سے کچھ وہ ہیں جو عدالت سے متصف ہیں، لیکن ان میں ایک وصف ہے جس سے ڈر ہے کہ وہ اس کے ساتھ مائل ہو جائے، اور حق کے خلاف گواہی دے، اور وہ جیسے اصول اور فروع، اور مولیٰ اور اہل بیت کا قانع، پس ان کی شہادت مذکورہ لوگوں کے حق میں قبول نہیں کی جاتی؛ کیونکہ یہ تہمت کا مقام ہے۔ اور ان کے خلاف قبول کی جاتی ہے۔ اور اسی طرح میاں بیوی، اور آقا اپنے مکاتب یا آزاد کردہ غلام کے ساتھ۔ اور لوگوں میں سے کچھ ان کے برعکس ہیں، جیسے دشمن جس کے دل میں اپنے بھائی کے لیے غمر یعنی کینہ ہو۔ پس اگر وہ اس کے حق میں گواہی دے تو قبول کی جاتی ہے۔ اور اگر وہ اپنے دشمن کے خلاف گواہی دے تو قبول نہیں کی جاتی؛ کیونکہ دشمنی غالباً دشمن کو نقصان پہنچانے پر ابھارتی ہے۔ واللہ اعلم۔"
"60","[AI-translation] حضرت رافع بن خدیج رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: «میں نے کہا: اے اللہ کے رسول! ہم کل دشمن سے ملنے والے ہیں، اور ہمارے پاس چھریاں نہیں ہیں۔ تو کیا ہم سرکنڈے سے ذبح کریں؟ آپ ﷺ نے فرمایا: جو خون بہا دے اور اس پر اللہ کا نام لیا گیا ہو تو کھاؤ، دانت اور ناخن کے علاوہ۔ اور میں تمہیں اس کے بارے میں بتاؤں گا، رہا دانت تو وہ ہڈی ہے۔ اور رہا ناخن تو وہ حبشیوں کی چھری ہے۔ اور ہمیں اونٹوں اور بکریوں کا لوٹا ہوا مال ملا، تو ان میں سے ایک اونٹ بھاگ گیا، تو ایک شخص نے اسے تیر مارا تو اسے روک دیا۔ تو رسول اللہ ﷺ نے فرمایا: «بے شک ان میں وحشی جانوروں کی طرح بدکنے والے جانور ہیں، پس جب ان میں سے کوئی تم پر غالب آ جائے تو اس کے ساتھ ایسا ہی کرو»»۔ متفق علیہ (بخاری اور مسلم)۔
آپ ﷺ کا قول: «جو خون بہائے» آخر تک، جامع کلام ہے جس میں ہر وہ چیز داخل ہے جو خون بہائے یعنی خون نکالے خواہ لوہے سے ہو، یا تانبے سے، یا پیتل سے، یا سرکنڈے سے، یا لکڑی سے، یا ایندھن سے، یا نوکیلی کنکری سے یا اس کے علاوہ، اور وہ جس میں نفوذ ہو جیسے بارود میں سیسہ؛ کیونکہ وہ اپنے نفوذ سے بہاتا ہے، اپنے وزن سے نہیں۔ اور اس میں داخل ہے: جو تیروں سے شکار کیا جائے، اور سکھائے ہوئے کتوں سے، اور پرندوں سے جب ان سب پر اللہ کا نام لیا گیا ہو۔ اور رہا ذبح کی جگہ، تو وہ حلقوم اور مری ہے، اگر انہیں کاٹ دیا تو کافی ہے۔ پس اگر ان کے ساتھ ودجین کا کاٹنا بھی حاصل ہو جائے اور وہ دونوں رگیں ہیں جو حلقوم کو گھیرے ہوئے ہیں تو وہ اولیٰ ہے۔ اور رہا شکار، تو اس کے بدن میں سے کسی بھی جگہ زخم کافی ہے؛ اس کی حاجت کی وجہ سے۔ اور اسی طرح اگر اونٹ یا گائے یا بکری بھاگ جائے، اور اسے پکڑنے سے عاجز ہو جائے، تو وہ شکار کے درجے میں ہو گا، جیسا کہ حدیث میں ہے۔ پس اس کے بدن میں سے جس جگہ بھی زخم لگایا جائے کافی ہے، جیسا کہ شکار اگر اس پر قدرت پائے اور وہ زندہ ہو تو اس کی ذکاۃ ضروری ہے۔ پس حکم اپنی علت کے ساتھ گھومتا ہے، جس سے عاجز ہو وہ شکار کے درجے میں ہے، اگرچہ پالتو جانوروں میں سے ہو۔ اور جس پر قدرت ہو اسے ذبح کرنا ضروری ہے، اگرچہ وحشی جانوروں میں سے ہو۔ اور نبی ﷺ نے اس سے دانت کو مستثنیٰ کیا، اور اس کی علت بیان فرمائی کہ وہ ہڈی ہے۔ پس اس سے دلالت ہوئی کہ تمام ہڈیاں اگرچہ خون بہائیں ان سے ذبح حلال نہیں۔ اور کہا گیا: کہ علت دونوں باتوں کا مجموعہ ہے: اس کا دانت ہونا، اور اس کا ہڈی ہونا، تو وہ دانت سے خاص ہو گا۔ اور صحیح پہلا قول ہے۔ اور اسی طرح ناخن سے ذبح حلال نہیں، نہ پرندے کا نہ اس کے علاوہ کا۔ پس حاصل یہ ہے: کہ ذبح کی شرطیں یہ ہیں: ذبح کی جگہ میں خون بہانا، ساتھ میں ذبح کرنے والا مسلمان ہو، یا کتابی ہو، اور اس پر اللہ کا نام ذکر کرے۔ اور رہا شکار، تو وہ ذبح سے زیادہ وسیع ہے۔ جیسا کہ گزرا کہ وہ شکار کے بدن میں سے جس جگہ بھی ہو، اور یہ کہ شکاری پرندوں اور کتوں کا شکار حلال ہے جب وہ سکھائے ہوئے ہوں، اور شکار پر انہیں چھوڑتے وقت ان پر اللہ کا نام ذکر کیا گیا ہو۔ واللہ اعلم۔"
"61","[AI-translation] حضرت شداد بن اوس رضی اللہ عنہ سے روایت ہے: کہ رسول اللہ ﷺ نے فرمایا: «بے شک اللہ نے ہر چیز پر احسان لکھ دیا ہے، پس جب تم قتل کرو تو قتل کو اچھا کرو، اور جب تم ذبح کرو تو ذبح کو اچھا کرو۔ اور تم میں سے ہر ایک اپنی چھری تیز کرے، اور اپنے ذبیحہ کو آرام دے»۔ مسلم نے روایت کیا۔
احسان دو قسم کا ہے: خالق کی عبادت میں احسان، یہ کہ اللہ کی عبادت ایسے کرے گویا وہ اسے دیکھ رہا ہے، پس اگر وہ اسے نہ دیکھ رہا ہو تو اللہ اسے دیکھ رہا ہے۔ اور وہ اللہ کے حقوق کی ادائیگی میں جدوجہد ہے خیر خواہی کے ساتھ، اور ان کی تکمیل کے ساتھ۔ اور مخلوق کے حقوق میں احسان۔ اور واجب احسان کی اصل یہ ہے: کہ ان کے واجب حقوق ادا کرے، جیسے والدین سے نیکی کرنا، اور رشتے داروں سے جوڑنا، اور تمام معاملات میں انصاف کرنا، یعنی جو حق تم پر ہے وہ پورا دو، جیسا کہ تم اپنا مال پورا لیتے ہو۔ اللہ تعالیٰ نے فرمایا: ﴿وَاعبُدُوا اللَّهَ وَلَا تُشرِکُوا بِهِ شَیئًا وَبِالوَالِدَینِ إِحسَانًا وَبِذِي القُربَی وَالیَتَامَی وَالمَسَاکِینِ وَالجَارِ ذِي القُربَی وَالجَارِ الجُنُبِ وَالصَّاحِبِ بِالجَنبِ وَابنِ السَّبِیلِ وَمَا مَلَکَت أَیمَانُکُم﴾ یعنی «اور اللہ کی عبادت کرو اور اس کے ساتھ کسی چیز کو شریک نہ کرو اور والدین اور قرابت والے اور یتیموں اور مسکینوں اور قرابت والے پڑوسی اور اجنبی پڑوسی اور پہلو کے ساتھی اور مسافر اور تمہارے دائیں ہاتھ کے مال (غلاموں اور زیر دستوں) کے ساتھ احسان کرو» (قرآن النساء 4:36) پس ان سب کے ساتھ احسان کا حکم دیا۔ اور اس میں داخل ہے تمام نوع انسان کے ساتھ احسان، اور چوپایوں کے ساتھ احسان، حتیٰ کہ اس حالت میں بھی جس میں ان کی جانیں نکلتی ہیں، اور اسی لیے آپ ﷺ نے فرمایا: «پس جب تم قتل کرو تو قتل کو اچھا کرو»۔ پس جو قتل کا مستحق ہو جائے قتل کو واجب کرنے والی وجہ سے، اس کی گردن تلوار سے ماری جائے، بغیر اذیت دینے کے اور نہ مثلہ کرنے کے۔ اور آپ ﷺ کا قول: «جب تم ذبح کرو تو ذبح کو اچھا کرو» یعنی ذبح کی ہیئت اور اس کی صفت۔ اور اسی لیے فرمایا: «تم میں سے ہر ایک اپنی چھری تیز کرے» یعنی اپنی چھری: «اور اپنے ذبیحہ کو آرام دے» پس جب بندہ اس کے ساتھ احسان کا مکلف ہے جو آدمیوں میں سے قتل کا مستحق ہو، اور اس جانور کے ذبح کے احسان کا جسے ذبح کرنا مقصود ہو، تو اس کے علاوہ حالت میں کیسا ہو گا؟ اور جان لو کہ مکلف بہ احسان دو قسم کا ہے: ایک واجب، اور وہ انصاف ہے، اور مخلوق کے لیے جو تم پر واجب ہوا ہے اسے ادا کرنا، بحسب اس حق کے جو تم پر متوجہ ہوا ہے۔ اور دوسرا مستحب احسان۔ اور وہ اس سے زائد ہے، یعنی بدنی، یا مالی، یا علمی نفع پہنچانا، یا دینی خیر کی طرف رہنمائی، یا دنیوی مصلحت کی طرف، پس ہر معروف صدقہ ہے، اور ہر وہ چیز جو مخلوق کو خوشی داخل کرے صدقہ اور احسان ہے۔ اور ہر وہ چیز جو ان سے ناپسندیدہ کو ہٹائے، اور ان سے وہ دفع کرے جسے وہ پسند نہیں کرتے، تھوڑا ہو یا زیادہ، تو وہ صدقہ اور احسان ہے۔ اور جب نبی ﷺ نے اس بدکار عورت کا قصہ ذکر فرمایا جس نے سخت پیاسے کتے کو اپنے موزے سے کنویں سے پانی پلایا تھا، اور اللہ نے اس کا شکر ادا کیا اور اسے بخش دیا۔ تو صحابہ نے رسول اللہ ﷺ سے کہا: «کیا ہمارے لیے چوپایوں میں اجر ہے؟» فرمایا: «ہر تر جگر میں اجر ہے»۔ پس احسان یہ ہے: کہ تمام منافع پہنچائے کسی بھی قسم سے ہوں، کسی بھی مخلوق کے لیے ہوں، لیکن وہ احسان کیے جانے والوں کے فرق سے، اور ان کے حق اور مقام سے، اور احسان کے اعتبار سے، اور اس کے موقع کی عظمت، اور اس کے نفع کی عظمت سے، اور احسان کرنے والے کے ایمان اور اخلاص کے اعتبار سے، اور اس سبب کے اعتبار سے جو اسے اس کی طرف بلائے، مختلف ہوتا ہے۔ اور احسان کی اعلیٰ قسموں میں سے ہے: اس کے ساتھ احسان جس نے تم سے قول یا فعل سے برائی کی۔ اللہ تعالیٰ نے فرمایا: ﴿ادفَع بِالَّتِي هِيَ أَحسَنُ فَإِذَا الَّذِي بَینَکَ وَبَینَهُ عَدَاوَةٌ کَأَنَّهُ وَلِيٌّ حَمِیمٌ وَمَا یُلَقَّاهَا إِلَّا الَّذِینَ صَبَرُوا وَمَا یُلَقَّاهَا إِلَّا ذُو حَظٍّ عَظِیمٍ﴾ یعنی «اس سے دفع کرو جو سب سے اچھی ہے، تو وہ جس کے درمیان اور تمہارے درمیان دشمنی ہے گویا وہ گرم جوش دوست ہو جائے گا اور یہ صرف انہیں ملتی ہے جنہوں نے صبر کیا اور یہ صرف اسے ملتی ہے جو بڑے نصیب والا ہے» (قرآن فصلت 41:34-35) اور جس کا طریقہ احسان ہو اللہ اس کی جزا احسان سے دے گا: ﴿هَل جَزَاءُ الإِحسَانِ إِلَّا الإِحسَانُ﴾ یعنی «احسان کی جزا احسان کے سوا کیا ہے» (قرآن الرحمٰن 55:60) (قرآن الرحمٰن 55:60) ﴿لِلَّذِینَ أَحسَنُوا الحُسنَی وَزِیَادَةٌ﴾ یعنی «جنہوں نے احسان کیا ان کے لیے اچھا بدلہ اور زیادہ ہے» (قرآن یونس 10:26) ﴿لِلَّذِینَ أَحسَنُوا فِي هَذِهِ الدُّنیَا حَسَنَةٌ﴾ یعنی «جنہوں نے اس دنیا میں احسان کیا ان کے لیے بھلائی ہے» (قرآن الزمر 39:10) ﴿إِنَّ رَحمَتَ اللَّهِ قَرِیبٌ مِنَ المُحسِنِینَ﴾ یعنی «بے شک اللہ کی رحمت احسان کرنے والوں سے قریب ہے» (قرآن الاعراف 7:56) یعنی اللہ کی عبادت میں احسان کرنے والے، اللہ کے بندوں کے ساتھ احسان کرنے والے۔ اور اللہ تعالیٰ اپنے بندوں پر عدل کو احسان میں سے واجب کرتا ہے، اور انہیں اس سے زائد فضل کی طرف بلاتا ہے، اور اللہ تعالیٰ نے معاملے میں فرمایا: ﴿وَلَا تَنسَوُا الفَضلَ بَینَکُم﴾ یعنی «اور اپنے درمیان فضل کو نہ بھولو» (قرآن البقرہ 2:237) یعنی اپنے معاملات میں فضل اور احسان کے لیے جگہ رکھو۔ اور تمام حقوق میں پورا استقصاء نہ کرو، بلکہ آسانی کرو اور سختی نہ کرو، اور بیچنے اور خریدنے، اور ادا کرنے اور تقاضا کرنے میں درگزر کرو۔ اور جس نے اپنے آپ کو اس معروف کا پابند کیا، اس نے بہت خیر پایا، اور بڑا احسان پایا۔ واللہ اعلم۔"
"62","[AI-translation] حضرت جابر بن عبداللہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: «رسول اللہ ﷺ نے خیبر کے دن پالتو گدھوں کو، اور خچروں کے گوشت کو، اور درندوں میں سے ہر کچلی والے کو، اور پرندوں میں سے ہر پنجے والے کو حرام کیا»۔ ترمذی نے روایت کیا۔
تمام کھانوں میں اصل حلت ہے، کیونکہ اللہ نے اپنے بندوں کے لیے وہ حلال کیا جو زمین نے دانوں اور پھلوں اور قسم قسم کی نباتات سے نکالا، اور ان کے لیے سمندر کے سب جانور حلال کیے اس کا زندہ اور اس کا مردہ۔ اور رہا خشکی کے جانور، تو ان میں سے تمام پاکیزہ حلال کیے، جیسے آٹھ قسم کے چوپائے اور ان کے علاوہ، اور وحشی شکاری پرندے اور ان کے علاوہ۔ اور اس نوع میں سے صرف خبیث حرام کیے اور اس کے لیے حد اور فارق بنایا۔ اور کبھی بعض حرام چیزوں کو معین کیا، جیسا کہ اس حدیث میں پالتو گدھوں کو معین کیا، اور خچروں کو اور انہیں حرام کیا۔ اور فرمایا: «بے شک وہ ناپاک ہیں»۔ اور رہا وحشی گدھے تو وہ حلال ہیں، اور اسی طرح درندوں میں سے کچلی والوں کو حرام کیا، جیسے بھیڑیا اور شیر اور چیتا اور لومڑی اور کتا اور ان جیسے، اور پرندوں میں سے ہر پنجے والے کو جو اپنے پنجے سے شکار کرے، جیسے باز اور شکra اور ان جیسے۔ اور جس کے قتل سے روکا گیا جیسے صرد، یا جس کے قتل کا حکم دیا گیا جیسے کوا اور ان جیسے، تو وہ حرام ہیں۔ اور جو خبیث ہو، جیسے سانپ اور بچھو اور چوہے اور کیڑوں کی قسمیں، اور اسی طرح جو حلال جانوروں میں سے اپنی موت مرا ہو، یا غیر شرعی ذکاۃ سے ذبح کیا گیا ہو، تو وہ حرام ہے۔ واللہ اعلم۔"
"63","[AI-translation] حضرت ابن عباس رضی اللہ عنہما سے روایت ہے، انہوں نے کہا: «رسول اللہ ﷺ نے مردوں میں سے عورتوں سے مشابہت کرنے والوں پر، اور عورتوں میں سے مردوں سے مشابہت کرنے والیوں پر لعنت فرمائی»۔ بخاری نے روایت کیا۔
تمام عادی امور میں اصل اباحت ہے، پس ان میں سے صرف وہ حرام ہے جسے اللہ اور اس کے رسول نے حرام کیا ہو، یا تو اس کی ذات کے لیے جیسے غصب کیا ہوا، اور وہ جس کی کمائی خبیث ہو مردوں اور عورتوں کے حق میں، یا تو حلت کو دونوں صنفوں میں سے ایک کے ساتھ خاص کرنے کے لیے، جیسا کہ شارع نے سونے اور چاندی اور ریشم کا لباس عورتوں کے لیے مباح کیا، اور اسے مردوں پر حرام کیا۔ اور رہا شارع کا مردوں کے عورتوں سے، اور عورتوں کے مردوں سے تشبہ کو حرام کرنا، تو وہ لباس، اور کلام، اور تمام احوال میں عام ہے۔ پس امور تین قسم کے ہیں: ایک قسم مردوں اور عورتوں کے درمیان مشترک ہے لباس کی قسموں اور اس کے علاوہ میں سے، تو یہ دونوں نوعوں کے لیے جائز ہے؛ کیونکہ اصل اباحت ہے، اور اس میں کوئی تشبہ نہیں۔ اور ایک قسم مردوں سے خاص ہے، تو وہ عورتوں کے لیے حلال نہیں، اور ایک قسم عورتوں سے خاص ہے، تو وہ مردوں کے لیے حلال نہیں۔ اور تشبہ سے روکنے میں حکمت میں سے ہے: کہ اللہ تعالیٰ نے مردوں کو عورتوں پر ایک درجہ بنایا، اور انہیں عورتوں پر قوام بنایا، اور انہیں قدری امور سے، اور شرعی امور سے ممتاز کیا، پس اس امتیاز کا قائم رہنا اور مردوں کی عورتوں پر فضیلت کا ثابت رہنا، شرعاً اور عقلاً مقصود ہے۔ پس مردوں کا عورتوں سے تشبہ انہیں اس بلند درجے سے گراتا ہے۔ اور عورتوں کا مردوں سے تشبہ امتیاز کو باطل کرتا ہے۔ اور نیز، مردوں کا عورتوں سے کلام اور لباس اور اس جیسے میں تشبہ مخنث پن کے اسباب میں سے ہے، اور اخلاق کے گرنے کا، اور عورتوں سے مشابہت کرنے والے کی ان سے اختلاط کی رغبت کا، جس سے محذور کا ڈر ہے، اور اسی طرح برعکس۔ اور یہ شرعی معانی، اور مردوں کے مراتب اور عورتوں کے مراتب کی حفاظت، اور ہر ایک کو اس کے اس مقام پر اتارنا جس پر اللہ نے اسے اتارا ہے، عقلاً مستحسن ہے، جیسا کہ وہ شرعاً مستحسن ہے۔ اور جب تم مکمل تشبہ کا ضرر، اور منازل کا اعتبار نہ کرنا جاننا چاہو تو اس زمانے میں اس گرے ہوئے اختلاط کو دیکھو جس کے ساتھ دینی غیرت، اور انسانی مروت، اور اچھے اخلاق چلے گئے، اور ان کی جگہ ہر رذیل خلق میں سے اس کا ضد آ گیا۔ اور اس سے مشابہ ہے یا وہ اس سے سخت تر ہے مسلمانوں کا کافروں سے ان کے خاص امور میں تشبہ، کیونکہ آپ ﷺ نے فرمایا: «جو کسی قوم سے مشابہت کرے وہ انہی میں سے ہے» کیونکہ ظاہری تشبہ باطنی تشبہ کی طرف بلاتا ہے، اور برائیوں کے وسائل اور ذرائع کو شارع نے ہر جہت سے بند کرنا چاہا ہے۔"
"64","[AI-translation] حضرت ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «اللہ نے کوئی بیماری نہیں اتاری مگر اس کے لیے شفا بھی اتاری»۔ بخاری نے روایت کیا۔
یہاں انزال تقدیر کے معنی میں ہے۔ پس اس حدیث میں قضا و قدر کا اثبات ہے، اور اسباب کا اثبات ہے۔ اور گزر چکا کہ یہ عظیم اصل کتاب و سنت سے ثابت ہے۔ اور عقل اور فطرت اس کی تائید کرتی ہیں۔ پس دینی اور دنیوی منافع اور مضرات سب اللہ کی قضا اور تقدیر سے ہیں، اس نے ان کا علم سے احاطہ کیا ہے، اور اس کی قلم ان سے چل چکی ہے، اور اس کی مشیت ان سے نافذ ہو چکی ہے، اور بندوں کے لیے ان اسباب کا کرنا آسان کیا ہے جو انہیں منافع اور مضرات تک پہنچائیں، پس ہر ایک اس کے لیے آسان کیا گیا ہے جس کے لیے وہ پیدا کیا گیا ہے: دین اور دنیا کے مصالح سے، اور ان کے مضرات سے۔ اور سعید وہ ہے جسے اللہ نے آسان ترین امور اور اللہ کی رضا سے قریب ترین اور اس کے دین اور دنیا کے لیے درست ترین کے لیے آسان کیا، اور شقی وہ ہے جس پر معاملہ الٹ گیا۔ اور اس حدیث کا عموم تقاضا کرتا ہے: کہ تمام باطنی اور ظاہری بیماریوں کی دوائیں ہیں جو ان کا مقابلہ کرتی ہیں، جو نہ اترنے والی کو دفع کرتی ہیں، اور اترنے والی کو کلیتاً اٹھاتی ہیں، یا اسے ہلکا کرتی ہیں۔ اور اس میں ہے: بدن کے طب کے سیکھنے کی ترغیب، جیسا کہ دلوں کا طب سیکھا جاتا ہے، اور یہ کہ وہ نافع اسباب کے جملے میں سے ہے۔ اور طب کے تمام اصول اور اس کی تفصیلات، اس حدیث کی شرح ہیں؛ کیونکہ شارع نے ہمیں خبر دی ہے کہ تمام بیماریوں کی دوائیں ہیں۔ پس ہمیں چاہیے کہ ہم ان کے سیکھنے کی کوشش کریں، اور اس کے بعد ان پر عمل کرنے اور انہیں نافذ کرنے کی۔ اور بہت سے لوگ گمان کرتے تھے کہ بعض بیماریوں کی کوئی دوا نہیں، جیسے سل اور اس جیسے، اور جب طب کا علم ترقی کر گیا، اور لوگ اس کے علم میں سے جہاں پہنچے وہاں پہنچ گئے، تو لوگوں نے اس حدیث کی تصدیق جانی، اور یہ کہ وہ اپنے عموم پر ہے۔ اور طب کے اصول یہ ہیں: غذا کا انتظام، یہ کہ وہ نہ کھائے یہاں تک کہ شہوت (بھوک) سچی ہو اور پچھلا کھانا مکمل ہضم ہو جائے، اور غذاؤں میں سے نافع ترین کو تلاش کرے، اور وہ ملکوں اور شخصوں اور حالوں کے اعتبار سے ہو، اور کھانے سے اتنا نہ بھرے جو اسے نقصان دے اور اس کا ہضم کرنا اور اس میں کوشش کرنا، بلکہ میزان اللہ تعالیٰ کا یہ قول ہے: ﴿وَکُلُوا وَاشرَبُوا وَلَا تُسرِفُوا﴾ یعنی «اور کھاؤ اور پیو اور اسراف نہ کرو» (قرآن الاعراف 7:31) اور تمام موذی چیزوں سے پرہیز کرے ان کی مقدار میں، یا ان کی ذات میں، یا ان کے وقت میں۔ پھر اگر استفراغ ممکن ہو، اور اس سے دواؤں کے استعمال کے بغیر مقصود حاصل ہو جائے، تو وہ اولیٰ اور نافع تر ہے۔ پس اگر دوا کی طرف مجبور ہو تو اسے بقدر استعمال کرے۔ اور چاہیے کہ اس کا ذمہ صرف جاننے والا اور ماہر طبیب لے۔ اور جان لو کہ ہوا کی پاکیزگی، اور بدن اور کپڑوں کی صفائی، اور خبیث بوؤں سے دوری، صحت پر بہترین مددگار ہے۔ اور اسی طرح متوسط ورزش۔ کیونکہ وہ اعضا اور اعصاب اور پٹھوں کو مضبوط کرتی ہے، اور فضلات کو دور کرتی ہے، اور بھاری غذاؤں کو ہضم کرتی ہے، اور طب کی تفصیلات اطباء کے نزدیک معروف ہیں۔ لیکن یہ اصول جنہیں ہم نے ذکر کیا ہر ایک کو ان کی ضرورت ہے۔ اور آپ ﷺ سے صحیح ثابت ہے «شفا تین میں ہے: پچھنا لگوانے کی چیر میں، یا شہد کے شربت میں، یا آگ سے داغنے میں، اور کالے دانے میں ہر بیماری سے شفا ہے»۔ «ہندی عود میں سات شفائیں ہیں، عذرہ سے سعوط کیا جاتا ہے، اور ذات الجنب سے لدود کیا جاتا ہے»، «بخار جہنم کی بھاپ سے ہے، پس اسے پانی سے ٹھنڈا کرو»، «آنکھ اور بخار اور چیونٹی کے لیے دم میں رخصت دی»، «اور جب تم سے آنکھ کی وجہ سے غسل کرنے کو کہا جائے تو غسل کرو»۔ «اور خبیث دوا سے منع فرمایا»، «اور دونوں پاؤں کے درد کے لیے ان کے خضاب کا حکم دیا»۔"
"65","[AI-translation] حضرت ابو قتادہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «اچھا خواب اللہ کی طرف سے ہے، اور برا خواب شیطان کی طرف سے ہے، پس جب تم میں سے کوئی وہ دیکھے جسے وہ پسند کرتا ہے تو اسے صرف اس سے بیان کرے جس سے وہ محبت کرتا ہے۔ اور جب وہ وہ دیکھے جسے وہ ناپسند کرتا ہے تو اللہ سے اس کے شر سے اور شیطان کے شر سے پناہ مانگے، اور تین بار تھوکے، اور اسے کسی سے بیان نہ کرے، کیونکہ وہ اسے نقصان نہیں دے گا»۔ متفق علیہ (بخاری اور مسلم)۔
آپ ﷺ نے اس حدیث میں خبر دی: کہ اچھا خواب اللہ کی طرف سے ہے، یعنی شیطان کی خلط ملط اور تشویش سے سالم، اور وہ اس لیے کہ انسان جب سوتا ہے تو اس کی روح نکلتی ہے، اور اسے کچھ تجرد حاصل ہوتا ہے جس سے وہ بہت سے علوم اور معارف کے لیے تیار ہو جاتی ہے۔ اور وہ نرم ہو جاتی ہے اس کے ساتھ جو اللہ اسے الہام کرتا ہے، اور فرشتہ اسے اس کے خواب میں اس کی طرف ڈالتا ہے۔ پس وہ بیدار ہوتا ہے اور اس کے لیے وہ باتیں واضح ہو چکی ہوتی ہیں جو اس سے پہلے مجہول تھیں، یا اسے وہ باتیں یاد آ جاتی ہیں جن سے وہ غافل تھا، یا وہ ان حالوں سے آگاہ ہو جاتا ہے جن کا جاننا اسے نفع دیتا ہے، یا ان پر عمل کرنا، یا وہ دینی یا دنیوی مضرات سے ڈرایا جاتا ہے جو اس کے وہم میں نہ تھیں، یا وہ نصیحت پکڑتا ہے اور ان اعمال سے رغبت اور رہبت کرتا ہے جن میں وہ ملوث تھا، یا وہ ان کے قریب ہے، یا وہ بعض جزئی اعیان سے آگاہ ہو جاتا ہے انہیں شرعی احکام میں داخل کرنے کے لیے۔ پس یہ سب باتیں اچھے خواب کی علامت ہیں، جو نبوت کے چھیالیس حصوں میں سے ایک حصہ ہے۔ اور جو نبوت میں سے ہو وہ جھوٹا نہیں ہوتا۔ پس نبی ﷺ کے خواب کو دیکھو اللہ تعالیٰ کے اس قول میں: ﴿إِذ یُرِیکَهُمُ اللَّهُ فِي مَنَامِکَ قَلِیلًا وَلَو أَرَاکَهُم کَثِیرًا لَفَشِلتُم وَلَتَنَازَعتُم فِي الأَمرِ وَلَکِنَّ اللَّهَ سَلَّمَ إِنَّهُ عَلِیمٌ بِذَاتِ الصُّدُورِ﴾ یعنی «جب اللہ تمہیں تمہارے خواب میں انہیں تھوڑا دکھاتا ہے اور اگر وہ تمہیں انہیں زیادہ دکھاتا تو تم بزدل ہو جاتے اور معاملے میں جھگڑتے لیکن اللہ نے سلامت رکھا، بے شک وہ سینوں والی باتوں کو جاننے والا ہے» (قرآن الانفال 8:43) اس سے کتنے منافع حاصل ہوئے اور کتنے مضرات دور ہوئے۔ اور اسی طرح اللہ تعالیٰ کا قول: ﴿لَقَد صَدَقَ اللَّهُ رَسُولَهُ الرُّؤیَا بِالحَقِّ لَتَدخُلُنَّ المَسجِدَ الحَرَامَ إِن شَاءَ اللَّهُ آمِنِینَ مُحَلِّقِینَ رُءُوسَکُم وَمُقَصِّرِینَ لَا تَخَافُونَ فَعَلِمَ مَا لَم تَعلَمُوا فَجَعَلَ مِن دُونِ ذَلِکَ فَتحًا قَرِیبًا﴾ یعنی «بے شک اللہ نے اپنے رسول کو سچا خواب حق کے ساتھ دکھایا، تم ضرور مسجد حرام میں داخل ہو گے اگر اللہ نے چاہا امن سے اپنے سروں کو منڈواتے ہوئے اور کترواتے ہوئے، ڈرتے نہیں ہو، پس اس نے جانا جو تم نے نہ جانا تو اس سے پہلے ایک قریبی فتح رکھی» (قرآن الفتح 27:27) (قرآن الفتح 27:27)، اس سے ایمان میں کتنی زیادتی ہوئی، اور اس سے ایقان کا کمال تمام ہوا، اور وہ اللہ کی عظیم نشانیوں میں سے تھی۔ اور مصر کے بادشاہ کے خواب کو دیکھو، اور یوسف صدیق کی اس کی تعبیر کو، اور جیسا کہ اس نے تعبیر کا ذمہ لیا تو اللہ نے اسے وہ تولیت دی جس میں اس میں موجود تدبیر تھی، پس اس سے بہت سی خیرات حاصل ہوئیں، اور وافر نعمتیں، اور اس سے ضرورتیں اور حاجتیں دور ہوئیں، اور اللہ نے اس سے یوسف کو بندوں سے اوپر درجات پر اٹھایا۔ اور عبداللہ بن زید اور عمر بن خطاب رضی اللہ عنہما کے اذان اور اقامت کے خواب پر غور کرو، اور کیسے وہ اس عظیم شعیرہ کے شرع ہونے کا سبب بنے جو عظیم دینی شعائر میں سے ہے۔ اور انبیاء اور اولیاء اور صالحین کے خواب بلکہ عموم مومنوں اور ان کے علاوہ کے مشہور معروف ہیں، ان اہم منافع اور پاکیزہ ثمرات کا شمار نہیں جو ان میں شامل ہیں۔ اور وہ اللہ کی اپنے بندوں پر نعمتوں کے جملے میں سے ہیں، اور مومنوں کی بشارتوں میں سے، اور غافلوں کی تنبیہات میں سے، اور منہ موڑنے والوں کے لیے اس کی یاد دہانی میں سے، اور ضد کرنے والوں پر حجت قائم کرنے میں سے۔ اور رہا وہ خواب جو پریشان خواب ہیں، تو وہ صرف انسان کی روح پر شیطان کی خلط ملط سے ہے، اور اسے پریشان کرنے سے، اور اسے ڈرانے سے، اور ان باتوں کو لانے سے جو اسے غم اور فکر دیتی ہیں، یا اس کے لیے خوشی اور شادمانی اور اترانا واجب کرتی ہیں، یا اسے شر اور فساد اور مضر حرص کے لیے بے چین کرتی ہیں۔ پس نبی ﷺ نے اس وقت حکم دیا کہ بندہ ان اسباب کو اختیار کرے جو اس کے شر کو دفع کریں، یہ کہ اسے کسی سے بیان نہ کرے، کیونکہ وہ اس کے باطل ہونے اور مٹنے کا سبب ہے، اور یہ کہ اپنے بائیں تین بار تھوکے۔ اور یہ کہ اللہ سے شیطان رجیم سے پناہ مانگے، جو اس خواب کا سبب اور اس کا دافع ہے، اور اس وقت اس کا دل مطمئن ہو کہ وہ اسے نقصان نہیں دے گا، اپنے رسول کے قول کی تصدیق کرتے ہوئے، اور اس کے دفع کرنے والے اسباب کی کامیابی پر بھروسا کرتے ہوئے۔ اور رہا اچھا خواب، تو چاہیے کہ اس پر اللہ کی حمد کرے، اور اس سے اس کے پورا ہونے کا سوال کرے، اور اسے اس سے بیان کرے جس سے وہ محبت کرتا ہے اور اس سے مودت جانتا ہے، تاکہ وہ اس کی خوشی سے خوش ہو، اور اس میں اس کے لیے دعا کرے۔ اور اسے اس سے بیان نہ کرے جس سے وہ محبت نہیں کرتا، تاکہ وہ اس پر ایسی تعبیر سے تشویش نہ ڈالے جو اس کی خواہش کے موافق ہو، یا حسد سے اس کی نعمت کے زوال میں کوشش نہ کرے۔ اور اسی لیے جب یوسف نے سورج اور چاند اور گیارہ ستاروں کو اپنے لیے سجدہ کرتے دیکھا، اور اسے اپنے باپ سے بیان کیا تو اس نے اس سے کہا: ﴿یَا بُنَيَّ لَا تَقصُص رُؤیَاکَ عَلَی إِخوَتِکَ فَیَکِیدُوا لَکَ کَیدًا إِنَّ الشَّیطَانَ لِلإِنسَانِ عَدُوٌّ مُبِینٌ﴾ یعنی «اے میرے بیٹے! اپنا خواب اپنے بھائیوں سے بیان نہ کرو ورنہ وہ تمہارے لیے چال چلیں گے، بے شک شیطان انسان کا کھلا دشمن ہے» (قرآن یوسف 12:5) اور اسی لیے دشمنوں سے نعمتوں کو چھپانا امکان کے ساتھ اولیٰ ہے، مگر یہ کہ اس میں کوئی راجح مصلحت ہو۔ اور جان لو کہ سچا خواب کبھی بندہ اپنی خارجی صورت پر دیکھتا ہے، جیسا کہ اذان کے خواب اور اس کے علاوہ میں، اور کبھی اس میں اس کے لیے محسوس مثالیں بیان کی جاتی ہیں، تاکہ وہ ان سے معقول باتوں کا، یا محسوس باتوں کا جو ان سے مشابہ ہوں، اعتبار کرے، جیسے مصر کے بادشاہ کا خواب اور اس جیسے، اور وہ دیکھنے والے اور وقت اور عادت، اور حالوں کے تنوع سے مختلف ہوتا ہے۔"
"66","[AI-translation] حضرت علی بن الحسین رحمہ اللہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «آدمی کے اسلام کے حسن میں سے ہے اس کا اسے چھوڑنا جو اسے معنی نہیں رکھتا»۔ مالک اور احمد نے روایت کیا۔
اور ابن ماجہ نے اسے ابوہریرہ سے روایت کیا، اور ترمذی نے اسے علی بن الحسین سے اور ابوہریرہ سے روایت کیا۔ اسلام اطلاق کے وقت اس میں ایمان اور احسان داخل ہیں۔ اور وہ دین کی ظاہری اور باطنی شریعتیں ہیں۔ اور مسلمان اسلام میں دو قسموں میں تقسیم ہیں، جیسا کہ اس حدیث کے مفہوم نے دلالت کی۔ پس ان میں سے کچھ اپنے اسلام میں احسان کرنے والے ہیں، اور ان میں سے کچھ برائی کرنے والے ہیں۔ پس جس نے ظاہراً اور باطناً اسلام کو قائم کیا تو وہ محسن ہے: ﴿وَمَن أَحسَنُ دِینًا مِمَّن أَسلَمَ وَجهَهُ لِلَّهِ وَهُوَ مُحسِنٌ وَاتَّبَعَ مِلَّةَ إِبرَاهِیمَ حَنِیفًا وَاتَّخَذَ اللَّهُ إِبرَاهِیمَ خَلِیلًا﴾ یعنی «اور اس سے اچھا دین کس کا ہے جس نے اپنا چہرہ اللہ کے لیے جھکا دیا اور وہ احسان کرنے والا ہے اور اس نے ابراہیم کی ملت کی پیروی کی یکسو ہو کر اور اللہ نے ابراہیم کو دوست بنایا» (قرآن النساء 4:125) پس یہ محسن اس میں مشغول ہوتا ہے جو اسے معنی رکھتا ہے، اس میں سے جس کا چھوڑنا اس پر واجب ہے معصیتوں اور برائیوں میں سے، اور اس میں سے جس کا چھوڑنا اس کے لیے مناسب ہے جیسے مکروہات اور زائد مباحات جن میں اس کے لیے کوئی مصلحت نہیں، بلکہ وہ اس سے خیر کو فوت کرتی ہیں۔ پس آپ ﷺ کا قول: «آدمی کے اسلام کے حسن میں سے ہے اس کا اسے چھوڑنا جو اسے معنی نہیں رکھتا» ان کو شامل ہے جو ہم نے ذکر کیے۔ اور حدیث کا مفہوم یہ ہے: کہ جس نے اسے نہ چھوڑا جو اسے معنی نہیں رکھتا، تو وہ اپنے اسلام میں برائی کرنے والا ہے اور وہ ان اقوال اور افعال کو شامل ہے جن سے منع کیا گیا ہے حرمت کی ممانعت سے یا کراہت کی ممانعت سے۔ پس یہ حدیث عام جامع کلمات میں سے شمار ہوتی ہے، کیونکہ اس نے اس حاصر تقسیم کو تقسیم کیا، اور ان اسباب کو بیان کیا جن سے اسلام کا حسن تمام ہوتا ہے، اور وہ اس میں مشغول ہونا جو معنی رکھتا ہے، اور اسے چھوڑنا جو قول اور فعل میں سے معنی نہیں رکھتا، اور ان اسباب کو جن سے بندہ برائی کرنے والا ہوتا ہے، اور وہ اس حال کا ضد ہیں۔ واللہ اعلم۔"
"67","[AI-translation] حضرت ایوب بن موسیٰ بن عمرو بن سعید بن العاص سے، وہ اپنے والد سے، وہ اپنے دادا سے روایت کرتے ہیں: کہ رسول اللہ ﷺ نے فرمایا: «کوئی باپ اپنی اولاد کو اچھے ادب سے بہتر کوئی عطیہ نہیں دیتا»۔ ترمذی نے روایت کیا۔
تمہارے حسن سلوک کے سب سے زیادہ حقدار اور تمہارے احسان کے سب سے زیادہ مستحق تمہارے اولاد ہیں، کیونکہ وہ امانتیں ہیں جنہیں اللہ نے تمہارے پاس رکھا ہے، اور تمہیں ان کے بدنوں اور دلوں کی اچھی تربیت کی وصیت کی ہے، اور ان کاموں میں سے جو کچھ بھی تم ان کے ساتھ کرو، چھوٹا ہو یا بڑا، تو وہ تم پر واجب کی ادائیگی میں سے ہے، اور ان بہترین چیزوں میں سے ہے جو تمہیں اللہ کا قرب عطا کرتی ہیں، پس اس میں کوشش کرو اور اسے اللہ کے ہاں ثواب کی نیت سے کرو، پس جس طرح جب تم انہیں کھلاتے اور پہناتے ہو اور ان کے بدنوں کی پرورش کرتے ہو تو تم حق ادا کرنے والے اور اجر پانے والے ہو، اسی طرح بلکہ اس سے بڑھ کر جب تم ان کے دلوں اور روحوں کی پرورش کرو نافع علوم اور سچی معرفتوں اور اچھے اخلاق کی طرف رہنمائی اور ان کے ضد سے ڈرانے کے ساتھ۔ اور «نحل» عطیے اور احسان ہیں، پس اچھے آداب اولاد کے لیے حال اور انجام کے اعتبار سے سونا چاندی اور دنیوی سامان کی قسموں کے دینے سے بہتر ہیں، کیونکہ اچھے آداب اور خوبصورت اخلاق سے وہ بلند ہوتے ہیں، اور انہی سے وہ سعادت پاتے ہیں اور انہی سے وہ اپنے ذمے اللہ کے حقوق اور بندوں کے حقوق ادا کرتے ہیں، اور انہی سے وہ نقصانوں کی قسموں سے بچتے ہیں، اور انہی سے ان کا اپنے والدین سے حسن سلوک مکمل ہوتا ہے۔ رہی اولاد کی غفلت تو اس کا نقصان بڑا ہے اور اس کا خطرہ سنگین ہے۔ بتاؤ اگر تمہارا کوئی باغ ہو اور تم اسے بڑھاؤ یہاں تک کہ اس کے درخت مکمل ہو جائیں اور اس کے پھل پک جائیں اور اس کی کھیتیاں اور پھول رونق پکڑ لیں، پھر تم اسے چھوڑ دو اور اس کی حفاظت نہ کرو اور اسے سیراب نہ کرو اور اسے آفتوں سے پاک نہ کرو اور ہر وقت اس کی نشوونما کا انتظام نہ کرو، تو کیا یہ سب سے بڑی جہالت اور حماقت نہیں؟ پھر تم اپنی اولاد کو کیسے ضائع کر سکتے ہو جو تمہارے جگر کا ٹکڑا اور تمہارے دل کا پھل اور تمہاری روح کی نقل ہیں اور جیتے جی اور مرنے کے بعد تمہارے قائم مقام ہیں، جن کی سعادت سے تمہاری سعادت مکمل ہوتی ہے اور جن کی کامیابی اور کامرانی سے تم بہت خیر پاتے ہو۔ ﴿وَمَا يَذَّكَّرُ إِلَّا أُولُو الْأَلْبَابِ﴾ یعنی «اور نصیحت صرف عقل والے ہی قبول کرتے ہیں» (قرآن آل عمران 3:7)۔"
"68","[AI-translation] حضرت ابو موسیٰ اشعری رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «نیک ہم نشین اور برے ہم نشین کی مثال مشک اٹھانے والے اور بھٹی دھونکنے والے جیسی ہے۔ پس مشک اٹھانے والا: یا تو تمہیں عطا کرے گا، یا تم اس سے خریدو گے، یا تم اس سے اچھی خوشبو پاؤ گے۔ اور بھٹی دھونکنے والا: یا تو تمہارے کپڑے جلا دے گا، یا تم اس سے بری بو پاؤ گے»۔ متفق علیہ (بخاری اور مسلم)۔
اس حدیث میں نیک دوستوں کے چننے کی ترغیب اور ان کے ضد سے ڈرانا شامل ہے۔ اور نبی ﷺ نے ان دو مثالوں سے بات واضح کی، یہ بیان کرتے ہوئے کہ نیک ہم نشین: اس کے ساتھ تمہاری تمام حالتیں نفع اور خیر میں ہیں، اس مشک اٹھانے والے کی طرح جس کے پاس مشک سے تم نفع اٹھاتے ہو: یا عطیے سے یا قیمت سے۔ اور کم از کم: تمہارے اس کے ساتھ بیٹھنے کی مدت میں تم مشک کی خوشبو سے مطمئن رہتے ہو۔ پس جو خیر بندے کو اپنے نیک ہم نشین سے پہنچتی ہے وہ تیز مشک سے بڑھ کر اور بہتر ہے، کیونکہ یا تو وہ تمہیں وہ سکھائے گا جو تمہارے دین اور دنیا میں تمہیں نفع دے، یا تمہیں نصیحت کا تحفہ دے گا، یا تمہیں اس پر جمے رہنے سے ڈرائے گا جو تمہیں نقصان دے۔ تو وہ تمہیں اللہ کی اطاعت اور والدین سے نیکی اور رشتے داروں سے جوڑنے پر ابھارتا ہے، اور تمہیں تمہارے نفس کے عیب دکھاتا ہے، اور تمہیں اپنے قول اور فعل اور حال سے اچھے اخلاق اور ان کی خوبیوں کی دعوت دیتا ہے۔ کیونکہ انسان اپنے دوست اور ہم نشین کی پیروی پر پیدا کیا گیا ہے، اور طبیعتیں اور روحیں جمع کیے گئے لشکر ہیں، ان میں سے بعض بعض کو خیر کی طرف یا اس کے ضد کی طرف کھینچتے ہیں۔ اور نیک ہم نشین سے تمہیں کم سے کم جو فائدہ حاصل ہوتا ہے اور وہ ایسا فائدہ ہے جسے حقیر نہ سمجھا جائے یہ ہے کہ تم اس کی وجہ سے برائیوں اور معصیتوں سے رک جاتے ہو، دوستی کی رعایت سے اور خیر میں مقابلے سے اور شر سے بلندی سے، اور یہ کہ وہ تمہاری حاضری اور غیر حاضری میں تمہاری حفاظت کرتا ہے، اور یہ کہ تمہیں اس کی محبت اور دعا تمہاری زندگی میں اور تمہاری موت کے بعد نفع دیتی ہے، اور یہ کہ تمہارے ساتھ اس کے تعلق اور تم سے اس کی محبت کی وجہ سے وہ تمہاری طرف سے دفاع کرتا ہے۔ اور یہ ایسی باتیں ہیں جن کا دفاع تم خود براہ راست نہیں کرتے، جیسا کہ وہ تمہیں ایسے اشخاص اور اعمال سے جوڑ سکتا ہے جن سے تمہارا ان سے جڑنا تمہیں نفع دے۔ اور نیک دوستوں کے فائدے گنے نہیں جا سکتے۔ اور آدمی کے لیے یہی کافی ہے کہ وہ اپنے ساتھی سے عبرت پکڑے اور یہ کہ وہ اپنے دوست کے دین پر ہوتا ہے۔ رہے بروں کی صحبت تو وہ ہم نے جو کچھ ذکر کیا اس سب کے ضد ہے، اور وہ اس کے لیے جو ان کی صحبت کرے ہر پہلو سے نقصان ہیں اور جو انہیں ملے اس کے لیے شر ہیں۔ پس کتنی ہی قومیں ان کی وجہ سے ہلاک ہوئیں۔ اور انہوں نے اپنے دوستوں کو ہلاکتوں کی طرف کھینچا جانتے ہوئے بھی اور انجانے میں بھی۔ اور اسی لیے مومن بندے پر اللہ کی سب سے بڑی نعمتوں میں سے ہے کہ وہ اسے نیکوں کی صحبت کی توفیق دے۔ اور اپنے بندے کے لیے اس کی سزا میں سے ہے کہ وہ اسے بروں کی صحبت میں مبتلا کرے۔ نیکوں کی صحبت بندے کو اعلیٰ علیین تک پہنچاتی ہے اور بروں کی صحبت اسے اسفل سافلین تک پہنچاتی ہے۔ نیکوں کی صحبت اس کے لیے نافع علوم اور فضیلت والے اخلاق اور نیک اعمال کو واجب کرتی ہے، اور بروں کی صحبت اسے اس سب سے محروم کرتی ہے: ﴿وَيَوْمَ يَعَضُّ الظَّالِمُ عَلَى يَدَيْهِ يَقُولُ يَا لَيْتَنِي اتَّخَذْتُ مَعَ الرَّسُولِ سَبِيلًا - يَا وَيْلَتَى لَيْتَنِي لَمْ أَتَّخِذْ فُلَانًا خَلِيلًا - لَقَدْ أَضَلَّنِي عَنِ الذِّكْرِ بَعْدَ إِذْ جَاءَنِي وَكَانَ الشَّيْطَانُ لِلْإِنْسَانِ خَذُولًا﴾ یعنی «اور جس دن ظالم اپنے ہاتھوں کو کاٹے گا کہے گا اے کاش میں نے رسول کے ساتھ راستہ پکڑا ہوتا۔ اے میری بربادی اے کاش میں نے فلاں کو دوست نہ بنایا ہوتا۔ بے شک اس نے مجھے نصیحت سے گمراہ کیا اس کے بعد کہ وہ میرے پاس آ چکی تھی اور شیطان انسان کو دھوکا دینے والا ہے» (قرآن الفرقان 25:27-29)۔"
"69","[AI-translation] حضرت ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «مومن ایک سوراخ سے دو بار نہیں ڈسا جاتا»۔ متفق علیہ (بخاری اور مسلم)۔
یہ ایک مثال ہے جو نبی ﷺ نے مومن کی مکمل احتیاط اور بیداری کو بیان کرنے کے لیے دی، اور یہ کہ مومن کو اس کا ایمان ان برائیوں کے کرنے سے روکتا ہے جن کا کرنا اسے نقصان دے، اور یہ کہ جب وہ ان میں سے کسی میں پڑ جائے تو وہ فوراً ندامت اور توبہ اور رجوع کی طرف لپکتا ہے۔ اور اس کی توبہ کی تکمیل میں سے ہے کہ وہ اس سبب سے انتہائی بچے جس نے اسے گناہ میں ڈالا، جیسے اس کی حالت جس نے اپنا ہاتھ سوراخ میں ڈالا اور اسے سانپ نے ڈس لیا، تو وہ اس کے بعد اس سوراخ میں اپنا ہاتھ ڈالنے کے قریب نہیں جاتا، اس کی وجہ سے جو اسے اس میں پہلی بار پہنچا۔ اور جس طرح ایمان اپنے والے کو اطاعتوں کے کرنے پر ابھارتا ہے اور ان میں اسے رغبت دلاتا ہے اور ان کے چھوٹنے پر اسے غمگین کرتا ہے، اسی طرح وہ اسے برائیوں کے کرنے سے روکتا ہے، اور اگر وہ واقع ہو جائیں تو وہ ان سے نکلنے کی طرف لپکتا ہے اور اس جیسی چیز کی طرف نہیں لوٹتا جس میں وہ پڑا تھا۔ اور اس حدیث میں ہے: تمام امور میں مضبوطی اور دانائی کی ترغیب۔ اور اس کے لازموں میں سے ہے: نافع سببوں کو پہچاننا تاکہ وہ انہیں کرے اور نقصان دہ سببوں کو تاکہ وہ ان سے بچے۔ اور یہ شبہ کے سببوں سے بچنے کی ترغیب پر دلالت کرتی ہے جن کے قریب جانے سے شر میں پڑنے کا ڈر ہو۔ اور یہ کہ ذریعے معتبر ہیں۔ اور اللہ نے مومنوں کو اس کی طرف لوٹنے سے ڈرایا ہے جسے شیطان نے معصیتوں میں پڑنے سے مزین کیا، پس فرمایا: ﴿يَعِظُكُمُ اللَّهُ أَنْ تَعُودُوا لِمِثْلِهِ أَبَدًا إِنْ كُنْتُمْ مُؤْمِنِينَ﴾ یعنی «اللہ تمہیں نصیحت کرتا ہے کہ اس جیسے کی طرف کبھی نہ لوٹو اگر تم مومن ہو» (قرآن النور 24:17)۔ اور اسی لیے توبہ کرنے والوں میں سے جس نے شر چکھا ہو اس کی اس سے نفرت بڑی ہوتی ہے اور اس سے اس کا ڈرانا اور بچنا زیادہ ہوتا ہے، کیونکہ اس نے تجربے سے اس کے برے اثرات جان لیے ہیں۔ اور حدیث میں ہے: «تحمل اللہ کی طرف سے ہے اور جلدی شیطان کی طرف سے ہے، اور کوئی بردبار نہیں مگر ٹھوکر کھانے والا اور کوئی دانا نہیں مگر تجربے والا»۔ واللہ اعلم۔"
"70","[AI-translation] حضرت ابو ذر غفاری رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «اے ابو ذر! تدبیر جیسی کوئی عقل نہیں، اور رکنے جیسا کوئی ورع نہیں، اور اچھے اخلاق جیسا کوئی حسب نہیں»۔ بیہقی نے «شعب الایمان» میں روایت کیا۔
اس حدیث میں تین جملے شامل ہیں، ان میں سے ہر ایک کے نیچے عظیم علم ہے: رہا پہلا جملہ تو وہ عقل اور اس کے اثرات اور علامتوں کے بیان میں ہے، اور یہ کہ کتاب و سنت میں قابل تعریف عقل: وہ قوت اور نعمت ہے جو اللہ نے بندے کو عطا کی ہے، جس سے وہ نافع چیزوں اور علوم اور معرفتوں کو سمجھتا ہے اور ان سے رکتا ہے اور نقصان دہ اور بری باتوں سے بچتا ہے، تو وہ انسان کے لیے ضروری ہے، وہ اپنے تمام دینی اور دنیوی حالوں میں اس سے بے نیاز نہیں ہوتا، کیونکہ اسی سے وہ نافع کو اور اس کی طرف راستے کو جانتا ہے اور نقصان دہ کو اور اس سے سلامتی کی کیفیت کو جانتا ہے۔ اور عقل اپنے اثرات سے پہچانی جاتی ہے۔ پس آپ ﷺ نے اس حدیث میں اس کے اچھے اثرات بیان فرمائے، پس فرمایا: «تدبیر جیسی کوئی عقل نہیں» یعنی بندے کی اپنے دین کے امور کی اور اپنی دنیا کے امور کی تدبیر۔ پس اس کے دین کے امور کی تدبیر یہ ہے کہ وہ سیدھے راستے کو جاننے کی کوشش کرے اور یہ کہ نبی کریم کس اخلاق اور ہدی اور سیرت پر تھے، پھر وہ منظم حالت سے اس پر چلنے کی کوشش کرے۔ جیسا کہ آپ ﷺ نے فرمایا: «صبح اور شام اور رات کے کچھ حصے سے مدد لو، اور میانہ روی میانہ روی اختیار کرو تم پہنچ جاؤ گے»۔ اور اس حدیث کی شرح اور اس راستے کا بیان جس کی طرف رسول اللہ ﷺ نے رہنمائی کی گزر چکا، اور یہ کہ وہ آسان راستہ ہے جو اللہ تک اور اس کے عزت والے گھر تک آسانی اور راحت سے پہنچاتا ہے، اور یہ کہ وہ بندے سے اس کی راحتوں اور دنیوی کاموں میں سے کچھ نہیں چھینتا، بلکہ بندہ اس کے ساتھ دونوں مصلحتوں کے حاصل کرنے اور دونوں سعادتوں اور پاکیزہ زندگی سے کامیاب ہونے کی طاقت پاتا ہے۔ پس جب اس نے اپنے دینی حالوں کی تدبیر اس شرعی میزان سے کی تو اس کا دین اور اس کی عقل مکمل ہو گئی، کیونکہ عقل سے مطلوب یہ ہے کہ وہ اپنے والے کو اچھے انجاموں تک قریبی اور آسان راستے سے پہنچائے۔ رہی معاش کی تدبیر تو عقل مند روزی کے طلب میں کوشش کرتا ہے اس سے جو اس پر واضح ہو جائے کہ وہ اس کے لیے زیادہ نافع اور اس کے مقصد کے حاصل ہونے میں زیادہ کارگر ہے۔ اور وہ سببوں میں اندھی بے خبری سے نہیں بھٹکتا، اسے کوئی قرار نہ ہو، بلکہ جب وہ کوئی سبب دیکھے جس سے اس کے لیے روزی کا دروازہ کھلا تو وہ اسے لازم پکڑے اور اس پر ثابت رہے اور طلب میں میانہ روی کرے، تو اس میں آزمائی ہوئی برکت ہے۔ پھر وہ دوسری تدبیر کرتا ہے اور وہ خرچ اور انفاق میں تدبیر ہے، تو وہ حرام راستوں میں خرچ نہ کرے یا غیر نافع راستوں میں یا مباح خرچوں میں اسراف کرے یا بخل کرے۔ اور اس کا میزان نیکوں کی مدح میں اللہ تعالیٰ کا یہ قول ہے: ﴿وَالَّذِينَ إِذَا أَنْفَقُوا لَمْ يُسْرِفُوا وَلَمْ يَقْتُرُوا وَكَانَ بَيْنَ ذَلِكَ قَوَامًا﴾ یعنی «اور وہ لوگ جب خرچ کرتے ہیں نہ اسراف کرتے ہیں اور نہ بخل کرتے ہیں اور اس کے درمیان اعتدال ہوتا ہے» (قرآن الفرقان 25:67)۔ پس روزیوں کے کمانے میں اچھی تدبیر اور خرچ اور تصرف اور حفاظت اور اس کے متعلقات میں اچھی تدبیر: انسان کی عقل کے کمال اور اس کی سنجیدگی اور رشد کی دلیل ہے۔ اور اس کا ضد: اس کی عقل کے نقص اور اس کے مغز کے فساد کی دلیل ہے۔ دوسرا جملہ: آپ ﷺ کا قول: «رکنے جیسا کوئی ورع نہیں»۔ پس یہ ورع کی جامع حد ہے، اس سے رسول اللہ ﷺ نے بیان فرمایا: کہ حقیقی ورع وہ ہے جو اپنے نفس اور دل اور زبان اور تمام اعضا کو حرام نقصان دہ باتوں سے روکے۔ پس اہل علم نے ورع کی تفسیر میں جو کچھ کہا وہ سب اس واضح جامع تفسیر کی طرف لوٹتا ہے۔ پس جس نے اپنے دل کو شکوں اور شبہوں سے اور حرام خواہشوں اور کینے اور بغض سے اور اخلاق کی تمام برائیوں سے محفوظ رکھا، اور اپنی زبان کو غیبت اور چغلی اور جھوٹ اور گالی اور ہر گناہ اور اذیت اور حرام کلام سے محفوظ رکھا، اور اپنی شرمگاہ اور نگاہ کو حرام سے محفوظ رکھا، اور اپنے پیٹ کو حرام کھانے سے محفوظ رکھا، اور اپنے اعضا کو گناہوں کے کمانے سے محفوظ رکھا، تو یہی حقیقت میں ورع ہے۔ اور جس نے اس میں سے کچھ ضائع کیا اس کے ورع میں اسی قدر کمی آئی، اور اسی لیے شیخ الاسلام نے کہا: «ورع اسے چھوڑنا ہے جس کے آخرت میں نقصان کا ڈر ہو»۔ تیسرا جملہ: آپ ﷺ کا قول: «اچھے اخلاق جیسا کوئی حسب نہیں»۔ اور یہ کہ حسب مخلوق کے نزدیک بلند مرتبہ ہے۔ اور صاحب حسب کو اس کے سبب اعتبار اور شرف حاصل ہے۔ اور وہ دو قسم کا ہے: پہلی قسم: حسب جو انسان کے نسب اور اس کے گھر کے شرف سے متعلق ہے۔ اور یہ قسم صرف مدح ہے، کیونکہ وہ اس کا محل ہے کہ اس کا والا اپنے حسب کے تقاضے پر عمل کرنے والا ہو، گھٹیا باتوں سے بلند ہو، اچھے اخلاق سے مزین ہو۔ تو وہ دوسرے کے لیے مقصود ہے۔ رہی دوسری قسم تو وہ حقیقی حسب ہے جو بندے کا وصف ہے اور اس کے لیے جمال اور زینت ہے اور دنیا اور دین میں خیر ہے، اور وہ اچھا اخلاق ہے جو وسیع بردباری اور صبر اور معافی اور نیکی اور احسان کرنے اور برائی اور اذیت کو برداشت کرنے اور لوگوں کے طبقوں سے اچھے خلق سے ملنے پر مشتمل ہے۔ اور اگر تم چاہو تو کہو: اچھا اخلاق دو قسم کا ہے: پہلا: اللہ کے ساتھ اچھا اخلاق، اور وہ یہ ہے کہ اس کے شرعی اور تقدیری فیصلوں کو اس کے حکم پر رضا اور تسلیم سے قبول کرے اور اس کی شریعت کے لیے فرمانبرداری کرے، اطمینان اور رضا سے اور اللہ کا اس پر شکر کرتے ہوئے جو اس نے حکم اور توفیق سے نعمت دی، اور اس کی تکلیف دہ تقدیروں پر صبر اور ان پر رضا سے۔ دوسرا: مخلوق کے ساتھ اچھا اخلاق، اور وہ نرمی کرنا اور اذیت برداشت کرنا اور اذیت روکنا ہے، جیسا کہ اللہ تعالیٰ نے فرمایا: ﴿خُذِ الْعَفْوَ وَأْمُرْ بِالْعُرْفِ وَأَعْرِضْ عَنِ الْجَاهِلِينَ﴾ یعنی «معافی پکڑو اور بھلائی کا حکم دو اور جاہلوں سے منہ پھیرو» (قرآن الاعراف 7:199) ﴿وَلَا تَسْتَوِي الْحَسَنَةُ وَلَا السَّيِّئَةُ ادْفَعْ بِالَّتِي هِيَ أَحْسَنُ فَإِذَا الَّذِي بَيْنَكَ وَبَيْنَهُ عَدَاوَةٌ كَأَنَّهُ وَلِيٌّ حَمِيمٌ - وَمَا يُلَقَّاهَا إِلَّا الَّذِينَ صَبَرُوا وَمَا يُلَقَّاهَا إِلَّا ذُو حَظٍّ عَظِيمٍ﴾ یعنی «اور نیکی اور برائی برابر نہیں، اس سے دفع کرو جو بہتر ہے تو وہ جس کے درمیان اور تمہارے درمیان دشمنی ہے گویا وہ گرم جوش دوست ہے۔ اور اسے صرف وہی پاتے ہیں جنہوں نے صبر کیا اور اسے صرف بڑے نصیب والا پاتا ہے» (قرآن فصلت 41:34-35)۔ پس جس نے اللہ کے ساتھ اور مخلوق کے ساتھ اچھے اخلاق کو قائم کیا اس نے خیر اور کامیابی پائی۔ واللہ اعلم۔"
"71","[AI-translation] حضرت ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: «ایک شخص آیا اور کہا: اے اللہ کے رسول! مجھے وصیت کیجیے۔ تو آپ نے فرمایا: غصہ نہ کرو۔ پھر اس نے بار بار دہرایا تو آپ نے فرمایا: غصہ نہ کرو»۔ بخاری نے روایت کیا۔
اس شخص نے سمجھا کہ وہ جزوی معاملے کی وصیت ہے، حالانکہ وہ چاہتا تھا کہ نبی ﷺ اسے کلی کلام کی وصیت کریں، اور اسی لیے اس نے دہرایا۔ پھر جب نبی ﷺ نے اس پر دہرایا تو اس نے جانا کہ یہ جامع کلام ہے، اور وہ ایسا ہی ہے، کیونکہ آپ کا قول: «غصہ نہ کرو» دو عظیم باتوں کو شامل ہے: ایک: سببوں کے کرنے کا حکم، اور اچھے اخلاق اور بردباری اور صبر پر مشق کرنا، اور نفس کو اس پر جمائے رکھنا جو انسان کو مخلوق سے پہنچے، قولی اور فعلی اذیت سے۔ پس جب بندہ اس کی توفیق پائے اور اس پر غصے کا وارد ہو تو وہ اسے اپنے اچھے اخلاق سے برداشت کرے اور اسے اپنی بردباری اور صبر سے اور اس کے اچھے انجاموں کی معرفت سے قبول کرے، کیونکہ چیز کے حکم میں اس کا حکم اور اس کا بھی حکم ہے جس کے بغیر وہ مکمل نہیں ہوتا، اور چیز سے روکنا اس کے ضد کا حکم ہے اور ان سببوں کے کرنے کا حکم ہے جو بندے کو روکی ہوئی چیز سے بچنے میں مدد دیں، اور یہ اس میں سے ہے۔ دوسرا: حکم غصے کے بعد کہ وہ اپنے غصے کو نافذ نہ کرے، کیونکہ غصہ غالباً انسان اسے دفع کرنے اور لوٹانے کی طاقت نہیں رکھتا، لیکن وہ اسے نافذ نہ کرنے کی طاقت رکھتا ہے۔ پس اس پر لازم ہے کہ جب وہ غصہ کرے تو اپنے نفس کو ان حرام اقوال اور افعال سے روکے جن کا غصہ تقاضا کرتا ہے۔ پس جب اس نے اپنے نفس کو غصے کے نقصان دہ اثرات کے کرنے سے روکا تو گویا حقیقت میں اس نے غصہ نہیں کیا۔ اور اس سے بندہ کامل عقلی قوت والا اور کامل قلبی قوت والا ہوتا ہے، جیسا کہ آپ ﷺ نے فرمایا: «پہلوان پچھاڑنے والا نہیں، پہلوان تو وہ ہے جو غصے کے وقت اپنے نفس پر قابو رکھے»۔ پس بندے کی قوت کا کمال یہ ہے کہ وہ بچے اس سے کہ اس میں شہوت کی قوت اور غصے کی قوت کے برے اثرات اثر کریں، بلکہ وہ ان دونوں قوتوں کو اس کے لینے کی طرف پھیرے جو دین اور دنیا میں نفع دے اور اس کے دفع کرنے کی طرف جو ان دونوں میں نقصان دے۔ پس بہترین لوگ وہ ہیں جن کی شہوت اور خواہش اس کے تابع ہو جو رسول ﷺ لائے اور جن کا غصہ اور دفاع باطل پر حق کی مدد میں ہو۔ اور بدترین لوگ وہ ہیں جو اپنی شہوت اور غصے کے پچھاڑے ہوئے ہوں۔ اور نہیں حول ولا قوۃ مگر اللہ سے۔"
"72","[AI-translation] حضرت عبداللہ بن مسعود رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «جنت میں داخل نہیں ہو گا جس کے دل میں ذرہ برابر تکبر ہو» تو ایک شخص نے کہا: آدمی چاہتا ہے کہ اس کا کپڑا اچھا ہو اور اس کی جوتی اچھی ہو؟ تو آپ نے فرمایا: «بے شک اللہ خوبصورت ہے خوبصورتی کو پسند کرتا ہے۔ تکبر: حق کو رد کرنا اور لوگوں کو حقیر جاننا ہے»۔ مسلم نے روایت کیا۔
اللہ تعالیٰ نے خبر دی ہے کہ آگ متکبروں کا ٹھکانا ہے، اور اس حدیث میں ہے کہ: «جنت میں داخل نہیں ہو گا جس کے دل میں ذرہ برابر تکبر ہو» پس یہ اس پر دلالت کرتی ہے کہ تکبر آگ میں داخلے کا موجب ہے اور جنت میں داخلے سے روکنے والا ہے۔ اور اس جامع تفسیر سے جو نبی ﷺ نے ذکر کی یہ معنی انتہائی وضوح سے واضح ہو جاتا ہے، کیونکہ آپ نے تکبر کو دو قسم بنایا: تکبر پہلی قسم: حق پر، اور وہ اسے رد کرنا اور قبول نہ کرنا ہے، پس ہر جس نے حق رد کیا تو وہ اسی قدر اس سے متکبر ہے جس قدر اس نے حق میں سے رد کیا۔ اور یہ کہ بندوں پر فرض ہے کہ وہ اس حق کے سامنے جھکیں جس کے ساتھ اللہ نے اپنے رسول بھیجے اور جس سے اپنی کتابیں اتاریں۔ پس وہ متکبر جو رسولوں کی فرمانبرداری سے کلیتاً انکار کرتے ہیں کافر ہیں آگ میں ہمیشہ رہنے والے، کیونکہ ان کے پاس رسولوں کے ہاتھوں پر آیات اور برہانوں سے تائید شدہ حق آیا۔ تو ان کے دلوں میں تکبر کھڑا ہوا روکنے والا، تو انہوں نے اسے رد کر دیا۔ اللہ تعالیٰ نے فرمایا: ﴿إِنَّ الَّذِينَ يُجَادِلُونَ فِي آيَاتِ اللَّهِ بِغَيْرِ سُلْطَانٍ أَتَاهُمْ إِنْ فِي صُدُورِهِمْ إِلَّا كِبْرٌ مَا هُمْ بِبَالِغِيهِ﴾ یعنی «بے شک جو لوگ اللہ کی آیات میں جھگڑتے ہیں بغیر کسی دلیل کے جو ان کے پاس آئی ہو ان کے سینوں میں تکبر کے سوا کچھ نہیں جسے وہ پانے والے نہیں» (قرآن غافر 40:56)۔ رہے وہ متکبر جو بعض حق کی فرمانبرداری سے انکار کرتے ہیں جو ان کی رائے اور خواہش کے خلاف ہو، تو وہ اگرچہ کافر نہیں تو ان کے ساتھ اسی قدر سزا کے موجبات ہیں جس قدر ان کے ساتھ تکبر ہے۔ اور جو اثر انہوں نے شریعت کے آنے کے بعد واضح ہونے والے حق کے قبول سے رکنے سے لیا۔ اور اسی لیے علماء کا اجماع ہے کہ جس پر رسول اللہ ﷺ کی سنت واضح ہو جائے اس کے لیے حلال نہیں کہ وہ اس سے کسی کے قول کی طرف مڑے، وہ کوئی بھی ہو۔ پس طالب علم پر واجب ہے کہ وہ پختہ عزم کرے اللہ کے قول اور اس کے رسول کے قول کو ہر ایک کے قول پر مقدم کرنے کا، اور یہ کہ اس کی اصل جس کی طرف وہ لوٹے اور اس کی بنیاد جس پر وہ بنائے نبی ﷺ کی ہدی سے ہدایت پانا ہو، اور اس کی مراد کو جاننے میں اجتہاد اور اس میں ظاہراً اور باطناً اس کی پیروی کرنا ہو۔ پس جب اس عظیم معاملے کی توفیق ہوئی تو وہ خیر کی توفیق پا گیا، اور اس کی خطا معاف ہو گئی، کیونکہ اس کا عام قصد شریعت کی پیروی ہے۔ پس خطا معذور ہے جب اس نے حق کو جاننے میں استدلال اور اجتہاد سے اپنی استطاعت کی۔ اور یہی حق کے سامنے متواضع ہے۔ رہا مخلوق پر تکبر اور وہ دوسری قسم ہے تو وہ انہیں حقیر جاننا اور انہیں حقیر سمجھنا ہے اور وہ انسان کے اپنے نفس پر تعجب اور ان پر اپنی بڑائی سے پیدا ہوتا ہے۔ پس نفس پر تعجب مخلوق پر تکبر اور انہیں حقیر جاننے اور ان کا مذاق اڑانے اور اپنے قول اور فعل سے انہیں گھٹانے پر ابھارتا ہے۔ اور رسول اللہ ﷺ نے فرمایا: «آدمی کے شر کے لیے یہی کافی ہے کہ وہ اپنے مسلمان بھائی کو حقیر جانے»۔ اور جب اس شخص نے کہا: «آدمی چاہتا ہے کہ اس کا کپڑا اچھا ہو اور اس کی جوتی اچھی ہو» اور ڈرا کہ یہ اس تکبر میں سے ہو جس میں وعید آئی ہے: تو نبی ﷺ نے اسے بیان فرمایا کہ یہ تکبر میں سے نہیں، جب اس کا والا حق کا فرمانبردار ہو مخلوق کے لیے متواضع ہو، اور یہ کہ وہ اس جمال میں سے ہے جسے اللہ پسند کرتا ہے، کیونکہ وہ تعالیٰ اپنی ذات اور اسماء اور صفات اور افعال میں جمیل ہے، ظاہری جمال اور باطنی جمال کو پسند کرتا ہے۔ پس ظاہری جمال: جیسے جسم اور لباس اور مسکن میں صفائی اور اس کے متعلقات۔ اور باطنی جمال: اخلاق کے معانی اور ان کی خوبیوں سے مزین ہونا۔ اور اسی لیے نبی ﷺ کی دعا میں سے تھا: «اے اللہ مجھے بہترین اعمال اور اخلاق کی ہدایت دے، بہترین کی ہدایت تیرے سوا کوئی نہیں دیتا۔ اور مجھ سے برے اعمال اور اخلاق کو پھیر دے، برے کو مجھ سے تیرے سوا کوئی نہیں پھیرتا»۔ واللہ اعلم۔"
"73","[AI-translation] حضرت عبداللہ بن عمرو رضی اللہ عنہما سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «کامیاب ہو گیا جس نے اسلام قبول کیا اور بقدر کفایت روزی دی گئی اور اللہ نے اسے اس پر قانع کر دیا جو اس نے اسے دیا»۔ مسلم نے روایت کیا۔
آپ ﷺ نے اس کے کامیاب ہونے کا حکم فرمایا جس نے یہ تین خصلتیں جمع کیں۔ اور «فلاح» جامع نام ہے ہر مطلوب محبوب کے حاصل ہونے کا اور ہر ڈرے ہوئے خوف سے سلامتی کا۔ اور یہ کہ ان تینوں نے دین اور دنیا کی خیر جمع کی، کیونکہ بندہ جب اس اسلام کی ہدایت پائے جو اللہ کا دین ہے جس کے سوا کوئی دین قبول نہیں کیا جاتا، اور وہ ثواب سے کامیابی اور عذاب سے نجات کا مدار ہے، اور اسے وہ روزی حاصل ہو جو اسے کافی ہو اور مخلوق سے سوال سے اس کا چہرہ بچائے، پھر اللہ اس پر نعمت تمام کرے کہ اسے اس پر قانع کر دے جو اس نے اسے دیا، اور اسے دی گئی روزی اور کفایت پر رضا حاصل ہو جائے اور اس کا نفس اس سے آگے کی طمع نہ کرے، تو اس نے دنیا اور آخرت کی بھلائی پالی۔ کیونکہ ان تین باتوں میں سے کسی کے یا ان میں سے کسی ایک کے چھوٹنے سے کمی یہ ہے: یا تو وہ اسلام کی ہدایت نہ پائے تو یہ اس کا حال کیسا بھی ہو اس کا انجام ابدی بدبختی ہے۔ یا وہ اسلام کی ہدایت پائے لیکن وہ مبتلا ہو: یا بھلانے والے فقر سے یا سرکش بنانے والی دولت سے، اور دونوں ہی بڑا ضرر اور نقص ہیں۔ یا اسے کافی روزی حاصل ہو وسیع یا اندازے سے لیکن وہ اللہ کی روزی پر قانع نہ ہو اور اس کا دل اس پر مطمئن نہ ہو جو اللہ نے اسے دیا، تو یہ دل اور نفس کا فقیر ہے۔ کیونکہ دولت کثرت سامان سے نہیں، دولت تو دل کی دولت ہے، پس کتنے دولت والے ہیں اور ان کا دل فقیر حسرت زدہ ہے، اور کتنے ہاتھ کے فقیر ہیں اور ان کا دل دولت مند راضی ہے اللہ کی روزی پر قانع ہے۔ پس سمجھدار جب اس پر دنیا تنگ ہو تو وہ اپنے اوپر اس کی تنگی اور اس کے فقر کو اور دل کے فقر اور اس کی حسرت اور غم کو جمع نہ کرے، بلکہ جیسے وہ روزی کے حاصل کرنے کی کوشش کرتا ہے تو وہ دل کی راحت اور اس کے سکون اور اطمینان کی کوشش کرے۔ واللہ اعلم۔"
"74","[AI-translation] حضرت ابو ایوب انصاری رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: «ایک شخص نبی ﷺ کے پاس آیا اور کہا: اے اللہ کے رسول! مجھے نصیحت کیجیے اور مختصر کیجیے۔ تو آپ نے فرمایا: جب تم اپنی نماز میں کھڑے ہو تو رخصت ہونے والے کی نماز پڑھو، اور ایسی بات نہ کرو جس سے کل معذرت کرنی پڑے، اور لوگوں کے ہاتھوں میں جو ہے اس سے مایوسی کو جمع کرو»۔ احمد نے روایت کیا۔
یہ تین وصیتیں کیا ہی وصیتیں ہیں، جب بندہ انہیں لے لے تو اس کے امور مکمل ہو جائیں اور وہ کامیاب ہو۔ پس پہلی وصیت: نماز کی تکمیل کو شامل ہے اور اسے بہترین حالوں پر ادا کرنے میں کوشش کو۔ اور وہ یہ کہ وہ ہر نماز پر اپنے نفس کا محاسبہ کرے جو وہ پڑھتا ہے اور یہ کہ وہ اس میں واجب اور فرض اور سنت میں سے سب کو پورا کرے گا، اور یہ کہ وہ احسان کے مقام کو حاصل کرے جو بلند ترین مقام ہے۔ اور وہ یہ کہ وہ اس میں کھڑا ہو اسے مستحضر کرتے ہوئے کہ وہ اپنے رب کے سامنے کھڑا ہے، اور یہ کہ وہ اس سے سرگوشی کرتا ہے اس سے جو وہ قراءت اور ذکر اور دعا سے کہتا ہے، اور اس کے لیے اپنے قیام اور رکوع اور سجدے اور جھکنے اور اٹھنے میں عاجزی کرتا ہے۔ اور اس جلیل مقصد پر اس کی مدد کرتا ہے اپنے نفس کو اس پر جمائے رکھنا بغیر تردد اور قلبی سستی کے، اور وہ ہر نماز میں مستحضر کرے کہ وہ رخصت ہونے والے کی نماز ہے، گویا وہ اس کے سوا کوئی نماز نہیں پڑھے گا۔ اور معلوم ہے کہ رخصت ہونے والا ایسی کوشش کرتا ہے جس میں وہ اپنی ساری وسعت خرچ کرے۔ اور وہ ان نافع معانی اور قوی سببوں کو ساتھ رکھے یہاں تک کہ اس پر معاملہ آسان ہو جائے اور وہ اس کا عادی ہو جائے۔ اور اس صورت پر نماز اپنے والے کو ہر رذیل خلق سے روکتی ہے اور اسے ہر جمیل خلق پر ابھارتی ہے، اس کی وجہ سے جو وہ اس کے نفس میں ایمان کی زیادتی اور دل کے نور اور سرور اور خیر میں اس کی کامل رغبت سے اثر کرتی ہے۔ رہی دوسری وصیت تو وہ زبان کی حفاظت اور اس کی نگرانی ہے، کیونکہ زبان کی حفاظت پر مدار ہے، اور وہ بندے کے معاملے کی لگام ہے۔ پس جب بندہ اپنی زبان کا مالک ہو جائے وہ اپنے تمام اعضا کا مالک ہو جاتا ہے، اور جب اس کی زبان اس کی مالک ہو جائے اور وہ اسے نقصان دہ کلام سے نہ بچائے تو اس کا معاملہ اس کے دین اور دنیا میں بگڑ جاتا ہے۔ پس وہ کوئی کلام نہ کرے مگر اس نے اس کے دین یا دنیا میں اس کا نفع جان لیا ہو اور ہر کلام جس میں تنقید یا معذرت کا احتمال ہو تو اسے چھوڑ دے، کیونکہ جب وہ اس سے کلام کرے گا تو کلام اس کا مالک ہو جائے گا اور وہ اس کا قیدی بن جائے گا۔ اور بسا اوقات وہ اس پر ایسا ضرر پیدا کرے جس کا تدارک وہ نہ کر سکے۔ رہی تیسری وصیت تو وہ نفس کو اللہ وحدہ سے تعلق پر جمائے رکھنا ہے، اپنے معاش اور معاد کے امور میں، پس وہ صرف اللہ سے سوال کرے اور صرف اس کے فضل میں طمع کرے، اور اپنے نفس کو لوگوں کے ہاتھوں میں جو ہے اس سے مایوسی پر جمائے، کیونکہ مایوسی حفاظت ہے، اور جو کسی چیز سے مایوس ہو جائے وہ اس سے بے نیاز ہو جاتا ہے۔ پس جس طرح وہ اپنی زبان سے صرف اللہ سے سوال کرتا ہے تو وہ اپنے دل کو صرف اللہ سے معلق کرے۔ تو وہ حقیقت میں اللہ کا بندہ رہے، مخلوق کی بندگی سے سالم۔ وہ ان کی غلامی سے آزاد ہو گیا، اور اس سے عزت اور شرف کمایا، کیونکہ مخلوق سے معلق ذلت اور گراوٹ کماتا ہے اپنے ان سے تعلق کے بقدر۔ واللہ اعلم۔"
"75","[AI-translation] حضرت مصعب بن سعد سے روایت ہے کہ نبی ﷺ نے فرمایا: «کیا تم اپنے کمزوروں کے سبب ہی مدد دیے جاتے اور روزی دیے جاتے ہو؟»۔ بخاری نے روایت کیا۔
پس اس حدیث میں ہے کہ طاقتور قادر لوگوں کے لیے مناسب نہیں کہ وہ کمزور عاجزوں کو حقیر جانیں، نہ جہاد اور مدد کے امور میں اور نہ روزی اور ان کے کمانے سے عاجز ہونے کے امور میں۔ رسول ﷺ نے بیان فرمایا کہ دشمنوں پر نصرت اور روزی کا پھیلاؤ کمزوروں کے سببوں سے ہو سکتا ہے، ان کی توجہ اور دعا اور ان کے مدد مانگنے اور روزی مانگنے سے۔ اور وہ یہ کہ وہ اسباب جن سے مقاصد حاصل ہوتے ہیں دو قسم کے ہیں۔ ایک قسم وہ ہے جو حس سے دیکھی جاتی ہے، اور وہ قولی اور فعلی بہادری سے قوت ہے اور دولت کے حاصل ہونے اور کمانے پر قدرت سے۔ اور یہ قسم وہ ہے جو اکثر مخلوق کے دلوں پر غالب ہے، اور وہ اس سے نصرت اور روزی کے حاصل ہونے کو معلق کرتے ہیں، یہاں تک کہ بہت سے اہل جاہلیت کا حال پہنچا کہ وہ اپنی اولاد کو فقر کے ڈر سے قتل کرتے تھے، اور ان کے علاوہ کا پہنچا کہ وہ اپنے ان اہل و عیال سے تنگ ہوتے تھے جن کا کمانا نہ ہو اور جن کی قوت جاتی رہی، اور یہ سب کوتاہ نظر اور کمزور ایمان اور اللہ کے وعدے اور اس کی کفایت پر کم بھروسا اور امور کو ان کی حقیقت کے خلاف دیکھنا ہے۔ دوسری قسم: معنوی اسباب، اور وہ دینی اور دنیوی مطالب کے حاصل ہونے میں اللہ پر توکل کی قوت میں اور اس پر کامل بھروسے میں اور اس کی طرف قوی توجہ اور اس سے طلب میں ہیں۔ اور یہ باتیں کمزور عاجزوں میں بہت مضبوط ہوتی ہیں جنہیں ضرورت نے مجبور کیا کہ وہ حق العلم جانیں کہ ان کی کفایت اور روزی اور مدد اللہ کے پاس سے ہے، اور یہ کہ وہ انتہائی عاجز ہیں۔ تو ان کے دل ٹوٹ گئے اور اللہ کی طرف متوجہ ہوئے، تو اس نے ان کے لیے اپنی نصرت اور روزی سے مکروہوں کو دفع کرنا اور منافع لانا اتارا جو قادر نہیں پاتے۔ اور قادر لوگوں کے لیے ان کے سبب سے ایسی روزی آسان کی جو ان کے حساب میں نہ تھی، کیونکہ اللہ نے ہر ایک کے لیے مقدر روزی بنائی ہے۔ اور اس نے ان عاجزوں کی روزیاں قادر لوگوں کے ہاتھ پر بنائی ہیں، اور قادر لوگوں کی اس پر مدد کی، اور خاص کر ان کی جن کا اللہ پر بھروسا قوی ہو اور جن کے نفس اس کے ثواب پر مطمئن ہوں، کیونکہ اللہ ان کے لیے نصرت اور روزی کے ایسے اسباب کھولتا ہے جو ان کے وہم میں نہ تھے اور نہ ان کے خیال میں آئے تھے۔ پس کتنے انسان کی روزی تنگ تھی، پھر جب اس کا اہل و عیال اور اس سے وابستہ بڑھ گئے تو اللہ نے اس کے لیے روزی شرعی قدری الٰہی جہتوں اور سببوں سے وسیع کر دی۔ اور اللہ کے اس وعدے کی جہت سے جو خلاف نہیں ہوتا: ﴿وَمَا أَنْفَقْتُمْ مِنْ شَيْءٍ فَهُوَ يُخْلِفُهُ﴾ یعنی «اور تم نے جو چیز بھی خرچ کی تو وہ اس کا بدل دیتا ہے» (قرآن سبا 34:39)۔ اور اس جہت سے کہ فرشتے ہر صبح دعا کرتے ہیں: «اے اللہ خرچ کرنے والے کو بدل عطا کر اور روکنے والے کو تلفی عطا کر»۔ اور اس جہت سے کہ ان کمزوروں کی روزیاں اس کی طرف متوجہ ہوئیں جو ان کی کفالت کرے اور وہ اس کے ہاتھ پر تھیں۔ اور اس جہت سے کہ دینے والے کا ہاتھ تمام پہلوؤں سے اونچا ہے۔ اور اس جہت سے کہ اللہ کی طرف سے مدد مؤنت کے بقدر آتی ہے، اور یہ کہ برکت ہر اس چیز میں شریک ہوتی ہے جو اس کے لیے ہو اور اس کے ثواب کا ارادہ ہو۔ اور اسی لیے ہم کہتے ہیں: اور بندے کے اللہ کے لیے اخلاص کی جہت سے اور اس کے دل اور زبان اور ہاتھ سے اس کا قرب پکڑنے سے، جب بھی وہ خرچ کرتا ہے وہ اللہ کی طرف متوجہ ہوتا ہے اور اس کا قرب پکڑتا ہے۔ اور جو اس کے لیے ہو وہ مبارک ہے۔ اور توکل کی قوت کی جہت سے اور خرچ کرنے والے کے بھروسے اور اللہ کے فضل اور نیکی میں اس کی طمع سے۔ اور طمع اور امید مطلوب کے حاصل ہونے کے سب سے بڑے سببوں میں سے ہیں۔ اور ان کمزوروں کی دعا کی جہت سے جن پر خرچ کیا گیا، کیونکہ وہ اللہ سے دعا کرتے ہیں کھڑے اور بیٹھے اور اپنے تمام حالوں میں اس کے لیے جس نے ان کی کفایت کی۔ اور دعا قوی سبب ہے: ﴿وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ﴾ یعنی «اور تمہارے رب نے کہا مجھ سے دعا کرو میں تمہیں قبول کروں گا» (قرآن غافر 40:60)۔ اور یہ سب آزمایا ہوا مشاہد ہے، پس محروموں کے لیے تباہی ہے اور توفیق والوں کا نفع کیا ہی عظیم ہے، واللہ اعلم۔"
"76","[AI-translation] حضرت ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «اللہ دو آدمیوں پر ہنستا ہے ان میں سے ایک دوسرے کو قتل کرتا ہے، دونوں جنت میں داخل ہوتے ہیں، یہ اللہ کی راہ میں لڑتا ہے اور قتل کر دیا جاتا ہے، پھر اللہ قاتل پر توبہ سے رجوع کرتا ہے اور وہ اسلام لاتا ہے پھر شہید ہوتا ہے»۔ متفق علیہ (بخاری اور مسلم)۔
یہ حدیث کریم کے کرم کے تنوع پر دلالت کرتی ہے، اور یہ کہ اس کا کرم اور فضل ایسے پہلوؤں سے متنوع ہے جو گنے نہیں جا سکتے اور مخلوق کی عقلوں اور خیالوں میں نہیں آتے۔ پس یہ دو آدمی جن میں سے ایک نے دوسرے کو قتل کیا اللہ نے ان میں سے ہر ایک کے لیے اپنے فضل اور کرم سے ایسا سبب مقدر کیا جو اسے جنت تک پہنچائے۔ پس پہلا: اس کی راہ میں لڑا، اور اللہ نے اسے دوسرے آدمی کے ہاتھ پر جس نے ابھی اسلام قبول نہ کیا تھا شہادت سے عزت دی جو صدیقین کے مرتبے کے بعد بلند ترین مرتبہ ہے، اور جہاد میں اس کا مقصد اللہ کے کلمے کو بلند کرنا اور اس سے اپنے رب کا قرب پکڑنا تھا۔ تو اس کا اجر اللہ پر ہے، اور اس کا قاتل پر کوئی حق نہیں، تو اس کا اجر اللہ پر ثابت ہوا۔ رہا دوسرا تو اللہ تعالیٰ نے توبہ کا دروازہ ہر اس کے لیے کھلا بنایا جو توبہ چاہے اسلام سے اور اس سے نیچے سے، اور گناہوں میں سے کسی گناہ کو توبہ کے قبول سے روکنے والا نہیں بنایا، جیسا کہ اللہ تعالیٰ نے توبہ کرنے والوں کے حق میں فرمایا: ﴿قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ لَا تَقْنَطُوا مِنْ رَحْمَةِ اللَّهِ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾ یعنی «کہو اے میرے بندو جنہوں نے اپنی جانوں پر زیادتی کی اللہ کی رحمت سے مایوس نہ ہو بے شک اللہ تمام گناہ بخشتا ہے بے شک وہی بخشنے والا رحم کرنے والا ہے» (قرآن الزمر 39:53)۔ پس جب وہ اسلام لایا اور توبہ کی تو اللہ نے اس سے کفر اور اس کے اثرات مٹا دیے، پھر اس پر شہادت سے احسان کیا، تو وہ جنت میں داخل ہوا، اپنے اس بھائی کی طرح جسے اس نے قتل کیا تھا اور جسے اس کے ہاتھ پر عزت دی تھی، اور اسے اپنے بھائی کے ہاتھ پر قتل سے رسوا نہیں کیا، جبکہ وہ کافر تھا۔ پس باری تعالیٰ کا یہ ہنسنا اس کے کرم اور جود کی انتہا اور اس کی نیکی کے تنوع پر دلالت کرتا ہے۔ اور یہ ہنسنا جو اس حدیث میں اور نصوص میں سے اس کے علاوہ میں وارد ہے اللہ کی دیگر صفات کی طرح ہے۔ مومن پر لازم ہے کہ وہ اس کا اقرار کرے اور اس پر ایمان لائے، اور یہ کہ وہ حقیقت پر حق ہے، اور یہ کہ اس کی صفات کمال کی صفات ہیں، ان میں اس کا کوئی مثل اور نہ شبہ اور نہ ہمسر ہے۔ پس جس طرح اللہ کی ذات ہے جس سے کوئی ذات مشابہ نہیں اسی طرح اس تعالیٰ کی صفات ہیں جن سے کوئی صفات مشابہ نہیں، اور وہ سب حمد اور بزرگی اور تعظیم اور جلال اور جمال اور کمال کی صفات ہیں۔ تو ہم ان پر ایمان لاتے ہیں جو ہمارے رب کی صفات میں سے کتاب و سنت سے آیا، اور ہم جانتے ہیں کہ ایمان اور توحید مکمل نہیں ہوتا مگر انہیں اس صورت پر ثابت کرنے سے جو اللہ کی عظمت اور کبریائی اور بزرگی کے لائق ہے۔ اور یہ حدیث اسلام میں داخل ہونے کی ترغیب دینے والی اور ہر وسیلے سے توبہ کے دروازے کھولنے والی احادیث کے جملے میں سے ہے، کیونکہ اسلام اس سے پہلے کو گرا دیتا ہے، اور جو انسان نے اپنے کفر کی حالت میں کیا، اور وہ اس پر اسلام لایا جو اس نے پہلے کیا، حتیٰ کہ وہ گردنیں جنہیں اس نے اپنے باطل کی مدد میں قتل کیا، اور وہ مال جن پر وہ اس کی وجہ سے قابض ہوا، وہ سب اسلام کے بعد معاف ہیں۔ اور ہمارا قول: «اس کی وجہ سے» احتراز ہے ان حقوق سے جن کا تقاضا مسلمانوں اور کافروں کے درمیان معاملات نے کیا، کیونکہ کافر جب اسلام لائے اور اس پر حقوق اور قرض اور وہ عینیں ہوں جنہیں اس نے لیا اور وہ اسے معاملے کے سبب حاصل ہوئیں، تو اسلام انہیں نہیں گراتا، کیونکہ وہ لوگوں کے درمیان مشترک معاملات ہیں، ان کے نیک اور فاجر کے، ان کے مسلمان اور کافر کے، پہلی قسم کے برخلاف، کیونکہ دونوں فریق میں سے ہر ایک مسلمانوں اور کافروں میں سے جب جنگ ہو اور اس پر قتل اور مال لینا مرتب ہو، تو وہ صرف اس کی رضا اور تبرع سے لوٹتا ہے جس تک وہ پہنچا، واللہ اعلم۔ اور اس سے بعض پہلوؤں سے مشابہ ہے باغیوں کا عادل لوگوں سے لڑنا، جہاں علماء نے انہیں اس کا ضامن نہیں بنایا جو انہوں نے جنگ کی حالت میں جانوں اور مالوں میں سے تلف کیا تاویل کی وجہ سے، جیسا کہ صحابہ رضی اللہ عنہم نے اس پر اجماع کیا جب فتنہ واقع ہوا، تو انہوں نے اجماع کیا کہ جو جانیں تلف ہوئیں اور جو مال تلف کیے گئے ان میں دونوں فریق میں سے کوئی ضمان نہیں۔ اور آپ کے قول میں: «پھر اللہ دوسرے پر توبہ سے رجوع کرتا ہے اور وہ اسلام لاتا ہے» دلیل ہے کہ جو اسلام لائے یا اپنے گناہوں سے توبہ کرے اس پر اللہ کی توبہ بندے کی توبہ سے پہلے ہے، کیونکہ وہ تعالیٰ نے اس کی توبہ کا اذن دیا اور اسے مقدر کیا اور اس پر لطف کیا، جب اس کے لیے توبہ کو واجب کرنے والے اسباب مقدر کیے، تو بندے نے توبہ کی، پھر اللہ اس پر اس کے بعد توبہ سے رجوع ہوا کہ اس سے پہلے جرائم کفر اور اس سے نیچے مٹا دیے، پس بندے کی توبہ دو توبوں میں گھری ہے، اس کا رب اس پر ان سے تفضل کرتا ہے، اس کا اسے توبہ کا اذن اور تقدیر اور آسان کرنا یہاں تک کہ اس نے توبہ کی، پھر اس کی توبہ قبول کرنا اور اس کی لغزش مٹانا، پس وہ تعالیٰ تواب رحیم ہے۔ اور توبہ بڑی اطاعتوں اور عظیم ترین میں سے ہے، پس یہ حکم تمام اطاعتوں میں ثابت ہے، اللہ بندے کو پہلے ان کی توفیق دیتا ہے اور اس کے لیے ان کے اسباب آسان کرتا ہے اور اس کے لیے ان کے راستے سہل کرتا ہے، پھر جب اطاعت گزار انہیں کرے تو انہیں قبول کرتا ہے اور اس کے لیے ان سے اپنی رضا اور ثواب لکھتا ہے، پس کریم کا فضل کتنا وسیع ہے اور اس کا متنوع بھرپور کرم کتنا زیادہ ہے۔ واللہ اعلم۔"
"77","[AI-translation] حضرت انس رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «تم میں سے کوئی موت کی تمنا نہ کرے اس نقصان کی وجہ سے جو اسے پہنچا، پس اگر وہ ضرور کرنے والا ہو تو کہے: اے اللہ مجھے زندہ رکھ جب تک زندگی میرے لیے بہتر ہو، اور مجھے وفات دے جب وفات میرے لیے بہتر ہو»۔ متفق علیہ (بخاری اور مسلم)۔
یہ اس نقصان کے لیے موت کی تمنا سے ممانعت ہے جو بندے پر اترتا ہے، بیماری سے یا فقر سے یا خوف سے یا سختی اور ہلاکت میں پڑنے سے یا اس جیسی چیزوں سے، کیونکہ اس کے لیے موت کی تمنا میں خرابیاں ہیں۔ ان میں سے: کہ وہ اس حالت سے ناراضی اور تنگی کا اظہار کرتی ہے جس سے وہ دوچار ہوا، حالانکہ وہ صبر اور اپنے وظیفے کو قائم کرنے کا حکم پاتا ہے۔ اور معلوم ہے کہ موت کی تمنا اس کے منافی ہے۔ اور ان میں سے: کہ وہ نفس کو کمزور کرتی ہے اور سستی اور کاہلی پیدا کرتی ہے اور مایوسی میں ڈالتی ہے۔ اور بندے سے مطلوب ان باتوں کا مقابلہ کرنا ہے، اور ان میں سے اسے کمزور اور ہلکا کرنے کی کوشش اپنی قدرت کے بقدر، اور یہ کہ اس کے ساتھ دل کی قوت اور اس پر جو اترا اس کے زائل ہونے میں طمع کی قوت ہو۔ اور وہ دو باتوں کا موجب ہے: الٰہی لطف اس کے لیے جو حکم دیے گئے سبب لائے، اور نافع کوشش جسے دل کی قوت اور اس کی امید واجب کرے۔ اور ان میں سے: کہ موت کی تمنا جہالت اور حماقت ہے، کیونکہ وہ نہیں جانتا کہ موت کے بعد کیا ہو گا، تو بسا اوقات وہ نقصان سے اس کی طرف پناہ مانگنے والے جیسا ہو جو اس سے زیادہ سخت ہو، برزخ کے عذاب اور اس کی ہولناکیوں سے۔ اور ان میں سے: کہ موت بندے پر نیک اعمال منقطع کرتی ہے جن کے کرنے اور قائم کرنے میں وہ لگا ہے، اور مومن کی باقی عمر کی کوئی قیمت نہیں، تو وہ کیسے اس عمل کے منقطع ہونے کی تمنا کرے جس کا ذرہ دنیا اور جو اس میں ہے سے بہتر ہے۔ اور اس عموم سے خاص یہ ہے: اس نقصان پر صبر سے قائم ہونا جو اسے پہنچا، کیونکہ اللہ صبر کرنے والوں کو ان کا اجر بے حساب پورا دیتا ہے۔ اور اسی لیے حدیث کے آخر میں فرمایا: «پس اگر وہ ضرور کرنے والا ہو تو کہے: اے اللہ مجھے زندہ رکھ جب زندگی میرے لیے بہتر ہو، اور مجھے وفات دے جب وفات میرے لیے بہتر ہو» تو بندہ معاملہ اپنے رب کے سپرد کرے جو جانتا ہے کہ اس میں اس کے لیے خیر اور صلاح کیا ہے، جو اپنے بندے کی مصلحتوں میں سے وہ جانتا ہے جو بندہ نہیں جانتا، اور اس کے لیے اس خیر کا ارادہ کرتا ہے جس کا وہ ارادہ نہیں کرتا، اور اس پر اس کی مصیبت میں لطف کرتا ہے جیسا کہ اس پر اس کی نعمتوں میں لطف کرتا ہے۔ اور اس کے درمیان اور آپ ﷺ کے قول کے درمیان فرق: «تم میں سے کوئی نہ کہے: اے اللہ مجھے بخش دے اگر تو چاہے، اے اللہ مجھ پر رحم کر اگر تو چاہے، لیکن سوال میں پختگی کرے، کیونکہ اللہ پر کوئی مجبور کرنے والا نہیں»، یہ کہ حدیث میں مذکور جس میں اللہ کے علم اور ارادے سے معلق کرنا ہے، وہ ان معین امور میں ہے جن کا بندہ ان کے انجام اور مصلحت کو نہیں جانتا۔ رہا دوسری حدیث میں مذکور تو وہ وہ امور ہیں جن کی مصلحت بلکہ ضرورت اور ہر بندے کی ان کی حاجت جانی جاتی ہے، اور وہ اللہ کی مغفرت اور اس کی رحمت اور اس جیسی ہیں۔ پس بندہ انہیں اپنے رب سے مانگے اور پختہ طلب سے طلب کرے، مشیت اور اس کے علاوہ سے معلق نہیں۔ کیونکہ وہ ان میں کوشش کا حکم پاتا ہے اور لازم کیا گیا ہے، اور ہر اس میں جو ان تک وسیلہ بنے۔ اور یہ اس فرق کی طرح ہے جو ثابت حکم والی واجبات اور مستحبات کے کرنے کے درمیان اور بعض معین امور کے درمیان ہے جن کا بندہ ان کی حقیقت اور مصلحت کو نہیں جانتا، تو وہ رکے یہاں تک کہ اس پر اس میں معاملہ واضح ہو جائے۔ اور بہت سے اہل علم نے اس سے مستثنیٰ کیا، فتنے کے ڈر سے موت کی تمنا کے جواز کو، اور اس میں سے بنایا حضرت مریم رضی اللہ عنہا کا قول: ﴿يَا لَيْتَنِي مِتُّ قَبْلَ هَذَا﴾ یعنی «اے کاش میں اس سے پہلے مر گئی ہوتی» (قرآن مریم 19:23)۔ جیسا کہ بعض نے موت کی تمنا مستثنیٰ کی اللہ کے شوق میں۔ اور اس میں سے بنایا یوسف ﷺ کا قول: ﴿أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ﴾ یعنی «تو دنیا اور آخرت میں میرا کارساز ہے مجھے مسلمان وفات دے اور مجھے نیکوں سے ملا» (قرآن یوسف 12:101)۔ اور اس میں نظر ہے، کیونکہ یوسف نے موت کی تمنا نہیں کی، بلکہ اس نے اللہ سے اسلام پر ثبات مانگا، یہاں تک کہ وہ اسے مسلمان وفات دے، جیسا کہ بندہ اپنے رب سے حسن خاتمہ مانگتا ہے۔ واللہ اعلم۔"
"78","[AI-translation] حضرت ابو سعید خدری رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «بے شک دنیا میٹھی سرسبز ہے، اور بے شک اللہ تمہیں اس میں جانشین بنانے والا ہے، پھر وہ دیکھے گا کہ تم کیسے عمل کرتے ہو، پس دنیا سے بچو اور عورتوں سے بچو؛ پس بے شک بنی اسرائیل کی پہلی آزمائش عورتوں میں تھی»۔ مسلم نے روایت کیا۔
آپ ﷺ نے اس حدیث میں دنیا کے حال کی اور اس وصف کی خبر دی جس پر وہ ہے جو دیکھنے والوں اور چکھنے والوں کو بھلا لگتا ہے۔ پھر خبر دی کہ اللہ نے دنیا کو بندوں کے لیے آزمائش اور امتحان بنایا، پھر ان سببوں کے کرنے کا حکم دیا جو اس کے فتنے میں پڑنے سے بچاتے ہیں۔ پس آپ کا یہ خبر دینا کہ وہ میٹھی سرسبز ہے اس کے ان اوصاف کو عام ہے جن پر وہ ہے، پس وہ اپنے ذائقے اور طعم میں اور اپنی لذتوں اور شہوتوں میں میٹھی ہے، اپنی رونق اور ظاہری حسن میں سرسبز ہے، جیسا کہ اللہ تعالیٰ نے فرمایا: ﴿زُيِّنَ لِلنَّاسِ حُبُّ الشَّهَوَاتِ مِنَ النِّسَاءِ وَالْبَنِينَ وَالْقَنَاطِيرِ الْمُقَنْطَرَةِ مِنَ الذَّهَبِ وَالْفِضَّةِ وَالْخَيْلِ الْمُسَوَّمَةِ وَالْأَنْعَامِ وَالْحَرْثِ﴾ یعنی «لوگوں کے لیے خواہشات کی محبت مزین کر دی گئی ہے، عورتوں اور بیٹوں اور سونے چاندی کے ڈھیروں خزانوں اور نشان زدہ گھوڑوں اور مویشیوں اور کھیتی سے» (قرآن آل عمران 3:14) اور اللہ تعالیٰ نے فرمایا: ﴿إِنَّا جَعَلْنَا مَا عَلَى الْأَرْضِ زِينَةً لَهَا لِنَبْلُوَهُمْ أَيُّهُمْ أَحْسَنُ عَمَلًا﴾ یعنی «بے شک ہم نے جو کچھ زمین پر ہے اسے اس کے لیے زینت بنایا تاکہ ہم انہیں آزمائیں کہ ان میں سے کون بہتر عمل کرتا ہے» (قرآن الکہف 18:7) پس اس میں یہ رنگا رنگ لذتیں اور رونق والے منظر، اللہ نے انہیں اپنی طرف سے آزمائش اور امتحان بنایا، اور اس میں بندوں کو جانشین بنایا تاکہ وہ دیکھے کہ وہ کیسے عمل کرتے ہیں۔ پس جس نے اسے اس کے حلال سے لیا، اور اسے اس کے حق میں رکھا، اور اس سے اس پر مدد لی جس کے لیے وہ پیدا کیا گیا تھا یعنی اللہ کی بندگی قائم کرنے پر، تو وہ اس کے لیے زاد اور اس سے اشرف اور باقی رہنے والے گھر کی طرف سواری بنی، اور اس کے لیے دنیوی اور اخروی سعادت مکمل ہو گئی۔ اور جس نے اسے اپنا سب سے بڑا غم اور اپنے علم کی غایت اور اپنا مقصود بنایا، تو اسے اس میں سے صرف وہی ملا جو اس کے لیے لکھا گیا تھا، اور اس کے بعد اس کا انجام بدبختی کی طرف ہوا، اور وہ اس کی لذتوں اور شہوتوں سے صرف تھوڑی مدت کے سوا لطف نہ اٹھا سکا، پس اس کی لذتیں تھوڑی ہوئیں اور اس کے غم طویل ہوئے۔ اور اس کی لذتوں کی ہر نوع میں یہی فتنہ اور آزمائش ہے، لیکن سب سے بڑھ کر اور سخت ترین فتنہ عورتوں کا ہے، پس بے شک ان کا فتنہ عظیم ہے، اور اس میں پڑنا خطرناک ہے اور اس کا ضرر بڑا ہے، پس بے شک وہ شیطان کے پھندے اور اس کے جال ہیں، کتنے ہی عافیت والوں کو ان کے ذریعے شکار کیا تو وہ اپنی شہوت کا قیدی اور اپنے گناہ کا گروی ہو گیا، اس پر خلاصی مشکل ہو گئی، اور گناہ اسی کا گناہ ہے، پس بے شک وہی ہے جس نے اس بلا سے احتراز نہ کیا، ورنہ اگر وہ اس سے بچتا، اور تہمت کی جگہوں میں داخل نہ ہوتا، اور بلا کے سامنے نہ آتا، اور مولیٰ سے وابستگی سے مدد لیتا، تو وہ اس فتنے سے نجات پاتا، اور اس آزمائش سے خلاصی پاتا۔ اور اسی لیے نبی ﷺ نے اس حدیث میں اس سے خاص طور پر ڈرایا۔ اور ان امتوں کے بارے میں خبر دی جو ہم سے پہلے تھیں اس کی جو ان پر گزری؛ پس بے شک اس میں عبرت پکڑنے والوں کے لیے عبرت ہے، اور متقیوں کے لیے نصیحت ہے۔ واللہ اعلم۔"
"79","[AI-translation] حضرت ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «ایمان ستر سے کچھ اوپر ـ یا ساٹھ سے کچھ اوپر ـ شاخیں ہیں، ان میں سب سے اعلیٰ قول ہے: لا الٰہ الا اللہ، اور ان میں سب سے ادنیٰ راستے سے تکلیف دور کرنا ہے، اور حیا ایمان کی ایک شاخ ہے»۔ متفق علیہ (بخاری اور مسلم)۔
یہ حدیث ان نصوص کے جملے میں سے ہے جو اس پر دلالت کرتی ہیں کہ ایمان ایسا نام ہے جو دل کے عقائد اور اس کے اعمال اور جوارح کے اعمال اور زبان کے اقوال کو شامل ہے، پس ہر وہ چیز جو اللہ کا قرب دے، اور جسے وہ پسند کرے اور اس سے راضی ہو، واجب میں سے اور مستحب میں سے، تو وہ ایمان میں داخل ہے، اور یہاں اس کی اعلیٰ اور ادنیٰ اور ان کے درمیان جو ہے یعنی حیا ذکر کی۔ «اور حیا ایمان کی ایک شاخ ہے» اور شاید حیا کا ذکر اس لیے کیا؛ کیونکہ وہ تمام ایمان کی شاخوں کو قائم کرنے کا سب سے قوی سبب ہے۔ پس بے شک جس نے اللہ سے حیا کی اس کی نعمتوں کے تسلسل کی وجہ سے، اور اس کے کرم کی فراوانی کی وجہ سے، اور اس پر اس کے اچھے ناموں سے تجلی کی وجہ سے، اور بندہ ـ اس کے باوجود اس جلیل بزرگ رب کے ساتھ بہت کوتاہی کرنے والا اپنے نفس پر ظلم کرتا ہے اور اس پر جنایت کرتا ہے ـ تو اس حیا نے اس کے لیے جرائم سے بچنا اور واجبات اور مستحبات کو قائم کرنا واجب کر دیا۔ پس ان شاخوں میں سب سے اعلیٰ ایمان کی شاخ اور اس کی اصل اور بنیاد، قول ہے: «لا الٰہ الا اللہ» اپنے دل سے سچا ہوتے ہوئے، اس طرح کہ وہ جانے اور یقین کرے کہ اس عظیم وصف یعنی الوہیت کا صرف اللہ کے سوا کوئی مستحق نہیں؛ پس بے شک وہی اس کا رب ہے جو اس کی اور تمام جہانوں کی اپنے فضل اور احسان سے پرورش کرتا ہے، اور سب فقیر ہیں اور وہ غنی ہے، اور سب عاجز ہیں اور وہ قوی ہے، پھر وہ اپنے تمام حالوں میں اپنے رب کی بندگی قائم کرے، اس کے لیے دین کو خالص کرتے ہوئے، پس بے شک ایمان کی تمام شاخیں اس اصل کی فرعیں اور ثمرات ہیں۔ اور اس نے اس پر دلالت کی کہ ایمان کی شاخوں میں سے بعض حق معبود کے لیے اخلاص کی طرف لوٹتی ہیں، اور بعض مخلوق سے احسان کی طرف لوٹتی ہیں۔ اور تکلیف دور کرنے سے قولی اور فعلی احسان کی تمام انواع پر تنبیہ کی۔ وہ احسان جس میں منافع کا پہنچنا ہے، اور وہ احسان جس میں مخلوق سے مضرتوں کا دفع کرنا ہے۔ اور جب ہم نے جانا کہ ایمان کی تمام شاخیں ان امور کی طرف لوٹتی ہیں، تو ہم نے جانا کہ خیر کی ہر خصلت وہ شاخوں میں سے ہے، اور علماء نے ان کے تعین پر کلام کیا ہے۔ پس ان میں سے: جس نے حدیث میں مقدر اس مبلغ تک پہنچایا۔ اور ان میں سے: جس نے اس سے قریب کیا، لیکن جب معنی سمجھ لیا جائے تو انسان کے لیے ممکن ہو جاتا ہے کہ وہ ہر وہ خصلت شمار کرے جو شارع سے وارد ہو ـ قولی ہو یا فعلی، ظاہری ہو یا باطنی ـ شاخوں میں سے، اور ایمان میں بندے کا حصہ ان خصلتوں سے اس کے حصے کے بقدر ہے، کمی اور زیادتی میں، اور قوت اور ضعف میں، اور تکمیل اور اس کے ضد میں، اور وہ اللہ کی خبر اور اس کے رسول کی خبر کی تصدیق کی طرف، اور ان دونوں کے امر کی تعمیل کی طرف، اور ان دونوں کی نہی سے اجتناب کی طرف لوٹتی ہیں۔ اور اللہ نے ایمان کو پاکیزہ درخت سے وصف کیا ہے اس کی اصل میں اور اس کے ثمرات میں جس کی اصل ثابت ہے، اور اس کی شاخیں آسمان میں بلند ہیں، وہ ہر وقت اپنے رب کے اذن سے اپنا پھل دیتی ہے، اور اللہ لوگوں کے لیے مثالیں بیان کرتا ہے تاکہ وہ یاد کریں۔ واللہ اعلم۔"
"80","[AI-translation] حضرت عدی بن حاتم رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «تم میں سے کوئی بھی نہیں مگر اس کا رب اس سے کلام کرے گا، اس کے درمیان اور اس کے رب کے درمیان کوئی ترجمان نہیں ہو گا، پھر وہ اپنے دائیں دیکھے گا تو صرف وہی دیکھے گا جو اس نے آگے بھیجا، اور اپنے بائیں دیکھے گا تو صرف وہی دیکھے گا جو اس نے آگے بھیجا، اور اپنے سامنے دیکھے گا تو اپنے چہرے کے سامنے آگ کے سوا کچھ نہ دیکھے گا، پس آگ سے بچو اگرچہ کھجور کے ٹکڑے سے ہو، پس جو نہ پائے تو اچھی بات سے»۔ متفق علیہ (بخاری اور مسلم)۔
یہ عظیم حدیث ہے جس نے باری کی عظمت میں سے وہ شامل کیا جس کا عقلیں احاطہ نہیں کرتیں اور جسے زبانیں بیان نہیں کرتیں۔ اس میں خبر دی: کہ تمام مخلوق سے اللہ براہ راست کلام کرے گا بغیر ترجمان اور واسطے کے، اور ان سے ان کے تمام اعمال کے بارے میں سوال کرے گا، ان کے خیر اور شر کے، ان کے باریک اور عظیم کے، ان کے اگلے اور پچھلے کے، جو بندوں نے جانا اور جو وہ ان میں سے بھول گئے، اور یہ اس لیے کہ اس کی عظمت اور کبریائی کی وجہ سے جیسے وہ انہیں ایک ساعت میں پیدا کرتا ہے اور ایک ساعت میں روزی دیتا ہے، اور ایک ساعت میں انہیں اٹھاتا ہے تو وہ ان سب کا ایک ساعت میں حساب لے گا، پس بابرکت ہے وہ جس کے لیے عظمت اور بزرگی اور عظیم بادشاہت اور جلال ہے۔ اور اس حالت میں جس میں وہ ان کا حساب لے گا بندے کے ساتھ نہ مددگار ہیں نہ معاون اور نہ اولاد اور نہ مال، وہ اس کے پاس فرد آیا ہے جیسے اس نے اسے پہلی بار پیدا کیا تھا، اس کے اعمال نے اسے گھیر رکھا ہے جو خیر یا شر سے بدلے کا مطالبہ کرتے ہیں، اس کے دائیں اور بائیں، اور اس کے سامنے آگ ہے اس کا اس پر وارد ہونا ضروری ہے، تو کیا اس سے اس کے نکلنے کی کوئی راہ ہے؟ اس کی کوئی راہ نہیں سوائے اللہ کی رحمت سے، اور اس کے ہاتھوں نے نجات دلانے والے اعمال میں سے جو آگے بھیجا۔ اور اسی لیے نبی ﷺ نے اپنی امت کو آگ سے بچنے پر ابھارا اگرچہ معمولی چیز سے ہو، جیسے کھجور کے ٹکڑے سے، پس جو نہ پائے تو اچھی بات سے۔ اور اس حدیث میں ہے: کہ آگ سے نجات دلانے والی چیزوں میں سب سے عظیم، مخلوق سے مال اور اقوال سے احسان ہے، اور یہ کہ بندے کو معروف میں سے کسی چیز کو حقیر نہیں جاننا چاہیے اگرچہ تھوڑی ہو، اور اچھی بات مخلوق کے لیے نصیحت کو شامل ہے انہیں وہ سکھانے سے جو وہ نہیں جانتے، اور انہیں ان کے دینی اور دنیوی مصالح کی طرف رہنمائی سے۔ اور وہ دلوں کو خوش کرنے والے کلام کو شامل ہے، سینوں کو کھولنے والے، بشاشت اور خندہ روئی سے ملے ہوئے، اور وہ اللہ کے ذکر اور اس کی ثنا کو شامل ہے، اور اس کے احکام اور اس کی شریعتوں کے ذکر کو۔ پس ہر وہ کلام جو اللہ کا قرب دے اور جس سے اللہ کے بندوں کے لیے نفع حاصل ہو، تو وہ اچھی بات میں داخل ہے، اللہ تعالیٰ نے فرمایا: ﴿إِلَيْهِ يَصْعَدُ الْكَلِمُ الطَّيِّبُ وَالْعَمَلُ الصَّالِحُ يَرْفَعُهُ﴾ یعنی «اسی کی طرف پاکیزہ کلام چڑھتا ہے اور نیک عمل اسے بلند کرتا ہے» (قرآن فاطر 35:10) اور اللہ تعالیٰ نے فرمایا: ﴿وَالْبَاقِيَاتُ الصَّالِحَاتُ خَيْرٌ عِنْدَ رَبِّكَ ثَوَابًا وَخَيْرٌ أَمَلًا﴾ یعنی «اور باقی رہنے والی نیکیاں آپ کے رب کے ہاں ثواب کے اعتبار سے بہتر اور امید کے اعتبار سے بہتر ہیں» (قرآن الکہف 18:46) واللہ اعلم۔"
"81","[AI-translation] حضرت ابوہریرہ رضی اللہ عنہ سے نبی ﷺ سے روایت ہے کہ آپ نے فرمایا: «مجھے چھوڑے رکھو جب تک میں نے تمہیں چھوڑا ہے، پس بے شک تم سے پہلوں کو ان کے بہت سوال کرنے اور ان کے انبیاء سے اختلاف کرنے نے ہلاک کیا، پس جب میں تمہیں کسی چیز سے منع کروں تو اس سے بچو، اور جب میں تمہیں کسی امر کا حکم دوں تو اس میں سے جتنا استطاعت رکھو لاؤ»۔ متفق علیہ (بخاری اور مسلم)۔
یہ سوالات جن سے نبی ﷺ نے منع کیا: وہ ہیں جن سے اللہ نے اپنے قول میں منع کیا: ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَسْأَلُوا عَنْ أَشْيَاءَ إِنْ تُبْدَ لَكُمْ تَسُؤْكُمْ﴾ یعنی «اے ایمان والو! ایسی چیزوں کے بارے میں نہ پوچھو کہ اگر وہ تم پر ظاہر کر دی جائیں تو تمہیں بری لگیں» (قرآن المائدہ 5:101) اور وہ غیب کے امور میں سے چیزوں کے بارے میں سوالات ہیں، یا ان امور میں سے جن سے اللہ نے درگزر کیا، پس نہ انہیں حرام کیا اور نہ واجب کیا، تو سائل ان کے بارے میں وحی کے نزول اور تشریع کے وقت سوال کرتا ہے، تو بسا اوقات سوال کی وجہ سے وہ واجب ہو جاتی ہیں، اور بسا اوقات اسی طرح حرام ہو جاتی ہیں، تو سائل آپ ﷺ کے قول میں داخل ہو جاتا ہے: «مسلمانوں میں جرم کے اعتبار سے سب سے بڑا وہ ہے جس نے ایسی چیز کے بارے میں سوال کیا جو حرام نہ تھی تو اس کے سوال کی وجہ سے حرام کر دی گئی»۔ اور اسی طرح بندے کو ہٹ دھرمی اور الجھی ہوئی باتوں کے سوال سے منع کیا جاتا ہے، اور اس سے بھی منع کیا جاتا ہے کہ وہ معمولی غیر اہم امور کے بارے میں سوال کرے، اور اہم امور کے بارے میں سوال کو چھوڑ دے، پس یہ سوالات اور ان جیسے وہ ہیں جن سے شارع نے منع کیا۔ اور رہا استرشاد کے طور پر دینی مسائل کے بارے میں سوال اصولوں میں سے اور فروع میں سے، عبادات ہوں یا معاملات، تو وہ ان میں سے ہیں جن کا اللہ نے اور اس کے رسول نے حکم دیا ہے، اور جن پر انہوں نے ابھارا ہے، اور وہ علوم سیکھنے اور حقائق پانے کا وسیلہ ہیں، اللہ تعالیٰ نے فرمایا: ﴿فَاسْأَلُوا أَهْلَ الذِّكْرِ إِنْ كُنْتُمْ لَا تَعْلَمُونَ﴾ یعنی «پس اہل ذکر سے پوچھو اگر تم نہیں جانتے» (قرآن الانبیاء 21:7) اور فرمایا: ﴿وَاسْأَلْ مَنْ أَرْسَلْنَا مِنْ قَبْلِكَ مِنْ رُسُلِنَا أَجَعَلْنَا مِنْ دُونِ الرَّحْمَنِ آلِهَةً يُعْبَدُونَ﴾ یعنی «اور ان سے پوچھو جنہیں ہم نے تم سے پہلے اپنے رسولوں میں سے بھیجا تھا، کیا ہم نے رحمن کے سوا معبود بنائے تھے جن کی عبادت کی جائے» (قرآن الزخرف 43:45) اور اس کے علاوہ آیات تک۔ اور آپ ﷺ نے فرمایا: «اللہ جس کے ساتھ خیر کا ارادہ کرتا ہے اسے دین کی سمجھ عطا کرتا ہے» اور یہ دین میں سمجھ کے راستے پر چلنے سے ہوتا ہے پڑھنے اور سیکھنے اور سوال سے، اور فرمایا: «جب وہ نہیں جانتے تھے تو انہوں نے سوال کیوں نہ کیا؟ پس بے شک لا علمی کی شفا سوال ہے»۔ اور اللہ نے سائل سے نرمی کا اور اسے اس کا مطلوب دینے کا اور اس سے تنگ نہ ہونے کا حکم دیا۔ اور سورۃ الضحی میں فرمایا: ﴿وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ﴾ یعنی «اور رہا سائل تو اسے نہ جھڑکو» (قرآن الضحی 93:10) پس یہ نافع علوم کے بارے میں سائل کو اور دنیوی امور میں سے جس کا اسے حاجت ہو، مال میں سے اور اس کے علاوہ کو شامل ہے۔ اور اس حدیث میں جو داخل ہے اس میں سے ہے: باری کی صفات کی کیفیت کے بارے میں سوال، پس بے شک صفات سب میں معاملہ ویسا ہی ہے جیسا امام مالک نے اسے کہا جس نے ان سے عرش پر استواء کی کیفیت کے بارے میں سوال کیا؟ تو فرمایا: «استواء معلوم ہے، اور کیفیت مجہول ہے، اور اس پر ایمان واجب ہے، اور اس کے بارے میں سوال بدعت ہے»۔ پس جس نے اللہ کے علم کی کیفیت کے بارے میں، یا اس کی خلق اور تدبیر کی کیفیت کے بارے میں سوال کیا، تو اسے کہا جائے گا: پس جیسا کہ اللہ تعالیٰ کی ذات ہے جس سے کوئی ذات مشابہ نہیں تو اس کی صفات ہیں جن سے کوئی صفات مشابہ نہیں، پس مخلوق اللہ کو جانتی ہے، اور جانتی ہے جو اس نے انہیں اپنی صفات اور افعال میں سے بتائی ہے، اور رہا اس کی کیفیت، تو اس کی تاویل اللہ کے سوا کوئی نہیں جانتا۔ پھر آپ ﷺ نے اس حدیث میں دو عظیم اصل ذکر کیں: ایک: آپ ﷺ کا قول: «پس جب میں نے تمہیں اس سے منع کیا تو اس سے بچو» پس ہر وہ چیز جس سے نبی نے منع کیا اقوال اور افعال میں سے، ظاہری اور باطنی، اسے چھوڑنا واجب ہے، اور اس سے رکنا ہے، اللہ اور اس کے رسول کے لیے تعمیل اور طاعت کے طور پر۔ اور نہی میں یہ نہیں فرمایا: «جتنی استطاعت رکھو» کیونکہ نہی نفس کو روکنے کا مطالبہ ہے، اور وہ ہر ایک کے لیے مقدور ہے، پس ہر ایک اس سب کے چھوڑنے پر قدرت رکھتا ہے جس سے اللہ نے اور اس کے رسول نے منع کیا، اور بندے اس مطلق حرام میں سے کسی چیز کے مضطر نہیں ہوئے، پس بے شک حلال وسیع ہے، تمام مخلوق کو ان کی عبادات اور ان کے معاملات میں اور ان کے تمام تصرفات میں گنجائش دیتا ہے۔ اور رہا مضطر کے لیے مردار اور خون اور خنزیر کے گوشت کا مباح ہونا، تو بے شک وہ اس مجبور کرنے والی حالت میں حلال کی جنس میں سے ہو گیا ہے؛ پس بے شک ضرورتیں ممنوعات کو مباح کر دیتی ہیں، تو ضرورت انہیں مباح بنا دیتی ہے؛ کیونکہ اس نے محرمات کو صرف اپنے بندوں کی حفاظت کے لیے حرام کیا، اور انہیں شرور اور مفاسد سے بچانے کے لیے، اور ان کے لیے مصلحت کے طور پر، تو جب اس کا وہ مصلحت مقابلہ کرے جو عظیم تر ہو ـ اور وہ جان کا باقی رہنا ہے ـ تو یہ اس پر مقدم کی گئی اللہ کی طرف سے رحمت اور احسان کے طور پر۔ اور دوائیں اس باب میں سے نہیں ہیں، پس بے شک دوا ضرورات کے باب میں داخل نہیں، پس بے شک اللہ تعالیٰ مبتلا کو متنوع سببوں سے شفا دیتا ہے، وہ دوا میں متعین نہیں ہوتیں۔ اور اگرچہ دوا میں غالب گمان ہو کہ اس سے شفا ہو گی، تو بے شک محرمات سے دوا کرنا حلال نہیں، جیسے شراب اور پالتو گدھیوں کے دودھ اور محرمات کی اقسام سے، بخلاف مردار کھانے پر مضطر کے، پس بے شک وہ یقین کرتا ہے کہ اگر وہ اس میں سے نہ کھائے تو وہ مر جائے گا۔ دوسری اصل: آپ ﷺ کا قول: «اور جب میں نے تمہیں کسی امر کا حکم دیا تو اس میں سے جتنا استطاعت رکھو لاؤ» اور یہ بڑی اصل ہے، اس پر اللہ تعالیٰ کا قول بھی دلالت کرتا ہے: ﴿فَاتَّقُوا اللَّهَ مَا اسْتَطَعْتُمْ﴾ یعنی «پس اللہ سے ڈرو جتنی تم استطاعت رکھتے ہو» (قرآن التغابن 64:16) پس شریعت کے تمام اوامر بندے کی قدرت اور استطاعت سے معلق ہیں۔ پس جب وہ واجبات میں سے کسی واجب پر کلیتاً قدرت نہ رکھے، تو اس سے اس کا وجوب ساقط ہو گیا۔ اور جب وہ اس کے بعض پر قدرت رکھے ـ اور وہ بعض عبادت ہو ـ تو اس میں سے جس پر وہ قدرت رکھے وہ واجب ہوا، اور اس سے جو وہ عاجز ہو وہ ساقط ہوا۔ اور اس میں فقہ اور احکام کے مسائل میں سے وہ داخل ہے جو گنا اور شمار نہ کیا جا سکے۔ پس مریض قائم ہو کر نماز پڑھے، پس اگر استطاعت نہ رکھے تو بیٹھ کر پڑھے، پس اگر استطاعت نہ رکھے تو پہلو پر پڑھے، پس اگر سر سے اشارے کی استطاعت نہ رکھے تو آنکھ سے اشارہ کرے۔ اور بندہ روزہ رکھے جب تک اس پر قادر ہو۔ پس اگر اسے ایسا مرض عاجز کر دے جس کے زائل ہونے کی امید نہ ہو، تو اس کی طرف سے ہر دن ایک مسکین کو کھلائے، اور اگر وہ ایسا مرض ہو جس کے زائل ہونے کی امید ہو، تو وہ افطار کرے، اور دوسرے دنوں میں سے گنتی پوری کرے۔ اور اس میں سے ہے جس نے نماز کی واجب سترہ سے، یا استقبال سے یا نجاست سے بچنے سے عجز کیا: تو اس سے جو وہ عاجز ہو وہ ساقط ہوا۔ اور اسی طرح نماز کی باقی شرطیں اور اس کے ارکان، اور طہارت کی شرطیں، اور جسے پانی سے طہارت متعذر ہو جائے عدم سے، یا تمام طہارت میں یا اس کے بعض میں ضرر سے، تو وہ تیمم کی طہارت کی طرف منتقل ہوا۔ اور حج میں معضوب پر ہے کہ وہ اسے نائب بنائے جو اس کی طرف سے حج کرے، جب وہ اپنے مال سے اس پر قادر ہو۔ اور امر بالمعروف اور نہی عن المنکر، اس پر واجب ہے جو اس پر ہاتھ سے قدرت رکھے، پھر زبان سے پھر دل سے۔ اور اندھے اور لنگڑے اور مریض پر ان عبادات کے چھوڑنے میں کوئی حرج نہیں جن سے وہ عاجز ہوں، یا جو ان پر ناقابل برداشت مشقت کریں۔ اور جس پر واجب نفقہ ہو، اور وہ اس سب سے عاجز ہو، تو وہ اپنی بیوی سے شروع کرے، پھر اپنے غلام سے، پھر اولاد سے، پھر والدین سے، پھر قریبی پھر قریبی سے۔ اور اسی طرح فطرہ۔ اور اسی طرح وہ سب جس کا بندے کو حکم دیا گیا ہو ایجاب کا امر ہو یا استحباب کا، جب وہ اس کے بعض پر قدرت رکھے، اور باقی سے عاجز ہو، تو اس پر جو وہ قدرت رکھے وہ واجب ہوا، اور اس سے جو وہ عاجز ہو وہ ساقط ہوا۔ اور وہ سب اس حدیث میں داخل ہیں۔ اور قرعہ کے مسائل کا اس اصل میں دخول ہے؛ کیونکہ جب امور مشتبہ ہو جائیں: وہ کس کے لیے ہیں؟ اور ان کا زیادہ حقدار کون ہے؟ تو ہم مرجحات کی طرف لوٹے۔ پس اگر ہر جہت سے ترجیح متعذر ہو، تو یہ واجب عجز کی وجہ سے ساقط ہوا، اور قرعہ کی طرف منتقل ہوا جو ممکن میں سے غایت ہے۔ اور وہ کتب فقہ میں معروف بہت سے مسائل ہیں۔ اور ولایتیں سب ـ ان کی چھوٹی اور بڑی ـ اس اصل کے تحت داخل ہیں، پس بے شک ہر ولایت میں اسے متولی بنانا واجب ہے جو ان اوصاف سے متصف ہو جن سے ولایت کا مقصود حاصل ہو۔ پس اگر وہ سب متعذر ہوں، تو اس میں بہتر پھر بہتر کو متولی بنانا واجب ہوا۔ اور جیسا کہ اس اصل پر اس آیت اور اس حدیث سے استدلال کیا جاتا ہے، تو بے شک اس پر ان آیات اور احادیث سے استدلال کیا جاتا ہے جن میں اللہ اور اس کے رسول نے امت سے حرج کی نفی کی، جیسے اللہ تعالیٰ کا قول: ﴿لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا﴾ یعنی «اللہ کسی جان کو اس کی وسعت کے سوا تکلیف نہیں دیتا» (قرآن البقرہ 2:286) ﴿لِيُنْفِقْ ذُو سَعَةٍ مِنْ سَعَتِهِ وَمَنْ قُدِرَ عَلَيْهِ رِزْقُهُ فَلْيُنْفِقْ مِمَّا آتَاهُ اللَّهُ لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا مَا آتَاهَا﴾ یعنی «کشادگی والے کو اپنی کشادگی سے خرچ کرنا چاہیے اور جس پر اس کا رزق تنگ کر دیا گیا ہو تو اسے اس میں سے خرچ کرنا چاہیے جو اللہ نے اسے دیا ہے، اللہ کسی جان کو اس کے سوا تکلیف نہیں دیتا جو اس نے اسے دیا ہے» (قرآن الطلاق 65:7) ﴿وَمَا جَعَلَ عَلَيْكُمْ فِي الدِّينِ مِنْ حَرَجٍ﴾ یعنی «اور اس نے دین میں تم پر کوئی تنگی نہیں رکھی» (قرآن الحج 22:78) ﴿مَا يُرِيدُ اللَّهُ لِيَجْعَلَ عَلَيْكُمْ مِنْ حَرَجٍ﴾ یعنی «اللہ تم پر کوئی تنگی کرنا نہیں چاہتا» (قرآن المائدہ 5:6) ﴿يُرِيدُ اللَّهُ بِكُمُ الْيُسْرَ وَلَا يُرِيدُ بِكُمُ الْعُسْرَ﴾ یعنی «اللہ تمہارے ساتھ آسانی چاہتا ہے اور تمہارے ساتھ تنگی نہیں چاہتا» (قرآن البقرہ 2:185) ﴿يُرِيدُ اللَّهُ أَنْ يُخَفِّفَ عَنْكُمْ﴾ یعنی «اللہ چاہتا ہے کہ تم سے تخفیف کرے» (قرآن النساء 4:28) پس عبادات اور اس کے علاوہ میں شرعی تخفیفات اپنی تمام انواع سے اس اصل میں داخل ہیں، ساتھ اس کے جس سے اس پر اللہ تعالیٰ کے ان ناموں اور صفات سے استدلال کیا جاتا ہے جو اس کا تقاضا کرتی ہیں، جیسے حمد اور حکمت، اور وسیع رحمت، اور لطف اور کرم اور احسان۔ پس بے شک ان جلیل جمیل ناموں کے آثار جیسے وہ مخلوقات اور تدبیروں میں بہتے ہوئے وافر وسیع ہیں، تو وہ اسی طرح شریعتوں میں ہیں، بلکہ عظیم تر کیونکہ وہ خلق میں غایت ہیں۔ اور وہ ابدی سعادت کا سب سے بڑا وسیلہ ہیں۔ پس بے شک اللہ تعالیٰ نے مکلفوں کو پیدا کیا تاکہ وہ اس کی بندگی قائم کریں۔ اور اس کی بندگی کو اور اس کی شرع کو قائم کرنا اس کی رضا اور اس کی کرامت پانے کا راستہ بنایا۔ جیسا کہ اللہ تعالیٰ نے فرمایا ـ اس کے بعد کہ اس نے طہارت کو اس کی انواع سے شرع کیا ـ ﴿مَا يُرِيدُ اللَّهُ لِيَجْعَلَ عَلَيْكُمْ مِنْ حَرَجٍ وَلَكِنْ يُرِيدُ لِيُطَهِّرَكُمْ وَلِيُتِمَّ نِعْمَتَهُ عَلَيْكُمْ لَعَلَّكُمْ تَشْكُرُونَ﴾ یعنی «اللہ تم پر کوئی تنگی کرنا نہیں چاہتا بلکہ وہ چاہتا ہے کہ تمہیں پاک کرے اور تم پر اپنی نعمت تمام کرے تاکہ تم شکر کرو» (قرآن المائدہ 5:6) پس اس کی رحمت اور اس کی نعمت کے آثار شرعیات اور مباحات میں ظاہر ہوئے، جیسا کہ موجودات میں ظاہر ہوئے۔ پس اس کے لیے اتم حمد اور اعلیٰ ہے، اور اوفر شکر اور ثنا اور اعلیٰ ہے، اور غایت محبت اور تعظیم اور منتہا ہے۔ وباللہ التوفیق۔"
"82","[AI-translation] حضرت جریر بن عبداللہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «جو لوگوں پر رحم نہیں کرتا اللہ اس پر رحم نہیں کرتا»۔ متفق علیہ (بخاری اور مسلم)۔
یہ حدیث اپنے منطوق سے اس پر دلالت کرتی ہے کہ جو لوگوں پر رحم نہیں کرتا اللہ اس پر رحم نہیں کرتا، اور اپنے مفہوم سے کہ جو لوگوں پر رحم کرتا ہے اللہ اس پر رحم کرتا ہے، جیسا کہ آپ ﷺ نے دوسری حدیث میں فرمایا: «رحم کرنے والوں پر رحمن رحم کرتا ہے، زمین والوں پر رحم کرو، آسمان والا تم پر رحم کرے گا»۔ پس مخلوق کے لیے بندے کی رحمت ان سب سے بڑے سببوں میں سے ہے جن سے اللہ کی رحمت پائی جاتی ہے، جس کے آثار میں دنیا کی خیرات ہیں، اور آخرت کی خیرات ہیں، اور اس کا فقدان اللہ کی رحمت کے سب سے بڑے قاطعوں اور موانع میں سے ہے، اور بندہ اللہ کی رحمت کا غایت درجہ محتاج اور فقیر ہے، اس سے آنکھ جھپکنے کے برابر بھی بے نیاز نہیں ہوتا، اور جو کچھ وہ نعمتوں میں سے اور نقمتوں کے دفع ہونے میں سے ہے وہ اللہ کی رحمت سے ہے۔ پس جب وہ چاہے کہ وہ انہیں باقی رکھے اور ان میں اضافہ کرے، تو وہ ان تمام سببوں کو کرے جن سے اس کی رحمت پائی جاتی ہے، اور وہ سب اللہ تعالیٰ کے قول میں جمع ہیں: ﴿إِنَّ رَحْمَتَ اللَّهِ قَرِيبٌ مِنَ الْمُحْسِنِينَ﴾ یعنی «بے شک اللہ کی رحمت احسان کرنے والوں سے قریب ہے» (قرآن الاعراف 7:56) اور وہ اللہ کی عبادت میں احسان کرنے والے ہیں، اللہ کے بندوں سے احسان کرنے والے۔ اور مخلوق سے احسان ان پر بندے کی رحمت کے آثار میں سے ہے۔ اور وہ رحمت جس سے بندہ متصف ہوتا ہے دو نوع ہے: پہلی نوع: جبلّی رحمت، اللہ نے بعض بندوں کو اس پر پیدا کیا ہے، اور ان کے دلوں میں مخلوق پر رافت اور رحمت اور شفقت رکھی ہے، تو انہوں نے اس رحمت کے تقاضے سے وہ سب کیا جس پر وہ ان کے نفع میں سے قدرت رکھتے تھے، اپنی استطاعت کے بقدر۔ پس وہ اس پر محمود اور ثواب یافتہ ہیں جو انہوں نے قائم کیا، اور اس پر معذور ہیں جس سے وہ عاجز ہوئے، اور بسا اوقات اللہ نے ان کے لیے ان کی سچی نیتوں سے وہ لکھ دیا جس سے ان کی قوتیں عاجز تھیں۔ اور دوسری نوع: وہ رحمت جسے بندہ ہر راستے اور وسیلے پر چلنے سے کماتا ہے، جو اس کے دل کو اس وصف پر کر دے، پس بندہ جانتا ہے کہ یہ وصف اخلاق کے اجل مکارم اور اکمل میں سے ہے، تو وہ اس سے متصف ہونے پر اپنے نفس سے جہاد کرتا ہے، اور جانتا ہے جو اللہ نے اس پر ثواب مرتب کیا ہے، اور اس کے فوت ہونے میں ثواب سے محرومی کیا ہے؛ تو وہ اپنے رب کے فضل میں رغبت کرتا ہے، اور اس سبب سے کوشش کرتا ہے جس سے وہ اسے پائے۔ اور جانتا ہے کہ بدلہ عمل کی جنس سے ہے۔ اور جانتا ہے کہ دینی اخوت اور ایمانی محبت کو اللہ نے باندھا ہے اور مومنوں کے درمیان جوڑا ہے، اور انہیں حکم دیا ہے کہ وہ بھائی بھائی محبت کرنے والے ہوں، اور وہ ہر اسے چھوڑیں جو اس کے منافی ہو بغض میں سے، اور عداوتوں میں سے، اور قطع تعلق میں سے۔ پس بندہ ان سببوں کو پہچانتا رہتا ہے جن سے وہ اس جلیل وصف کو پاتا ہے، اور اس سے متحقق ہونے میں اجتہاد کرتا ہے، یہاں تک کہ اس کا دل مخلوق پر رحمت اور شفقت سے بھر جاتا ہے۔ اور کیا ہی اچھا یہ فاضل خلق ہے، اور جلیل کامل وصف ہے۔ اور یہ رحمت جو دلوں میں ہے، اس کے آثار جوارح اور زبان پر ظاہر ہوتے ہیں، لوگوں تک نیکی اور خیر اور منافع پہنچانے کی کوشش میں، اور ان سے اضرار اور مکروہات کو زائل کرنے میں۔ اور اس رحمت کی علامت جو بندے کے دل میں موجود ہے، یہ ہے کہ وہ تمام مخلوق کے لیے عموماً، اور مومنوں کے لیے خصوصاً خیر کے پہنچنے کا محب ہو، ان پر شر اور ضرر کے حاصل ہونے کو ناپسند کرنے والا ہو۔ پس اس محبت اور کراہت کے بقدر اس کی رحمت ہوتی ہے۔ اور جس کا حبیب موت یا مصائب میں سے غیر سے مصاب ہو، پس اگر اس کا اس پر حزن رحمت کی وجہ سے ہو، تو وہ محمود ہے، اور وہ صبر اور رضا کے منافی نہیں، کیونکہ آپ ﷺ جب اپنی بیٹی کے بیٹے کی موت پر روئے، تو سعد نے آپ سے کہا: «اے اللہ کے رسول! یہ کیا ہے؟» تو اس کے ساتھ دوسرا آنسو لائے، اور فرمایا: «یہ رحمت ہے جسے اللہ اپنے بندوں کے دلوں میں رکھتا ہے، اور اللہ اپنے بندوں میں سے صرف رحم کرنے والوں پر رحم کرتا ہے» اور اپنے بیٹے ابراہیم کی موت پر فرمایا: «دل غمگین ہے، اور آنکھ آنسو بہاتی ہے، اور ہم صرف وہی کہتے ہیں جو ہمارے رب کو راضی کرے، اور بے شک اے ابراہیم ہم تمہاری جدائی سے غمگین ہیں»۔ اور اسی طرح چھوٹے بچوں پر رحمت اور ان پر نرمی، اور ان پر سرور داخل کرنا رحمت میں سے ہے، اور رہا ان کی پروا نہ کرنا، اور ان پر نرمی نہ کرنا، تو وہ جفا اور غلظت اور قساوت میں سے ہے، جیسا کہ جفا کرنے والے اعراب میں سے بعض نے کہا جب اس نے نبی ﷺ اور آپ کے اصحاب کو اپنے چھوٹے بچوں کو بوسہ دیتے دیکھا، تو اس اعرابی نے کہا: میرے دس لڑکے ہیں میں نے ان میں سے ایک کو بوسہ نہیں دیا، تو نبی ﷺ نے فرمایا: «کیا میں تمہارے لیے کچھ کر سکتا ہوں جب کہ اللہ نے تمہارے دل سے رحمت نکال لی ہے؟»۔ اور رحمت میں سے ہے: اس بدکار عورت کی رحمت جب اس نے کتے کو پلایا، جو پیاس سے مٹی کھانے کے قریب تھا، تو اللہ نے اسے اس رحمت کی وجہ سے بخش دیا۔ اور اس کا ضد ہے: اس عورت کا عذاب جس نے بلی باندھی، نہ اسے کھلایا اور پلایا، اور نہ اسے چھوڑا کہ وہ زمین کے کیڑے مکوڑوں سے کھائے یہاں تک کہ وہ مر گئی۔ اور اس میں سے وہ ہے جو مشاہد اور مجرب ہے، کہ جس نے اپنے چوپایوں سے کھلانے اور پلانے اور نافع دیکھ بھال سے احسان کیا، تو بے شک اللہ اس کے لیے ان میں برکت دیتا ہے۔ اور جس نے ان سے برائی کی، تو دنیا میں آخرت سے پہلے سزا دی گئی، اور اللہ تعالیٰ نے فرمایا: ﴿مِنْ أَجْلِ ذَلِكَ كَتَبْنَا عَلَى بَنِي إِسْرَائِيلَ أَنَّهُ مَنْ قَتَلَ نَفْسًا بِغَيْرِ نَفْسٍ أَوْ فَسَادٍ فِي الْأَرْضِ فَكَأَنَّمَا قَتَلَ النَّاسَ جَمِيعًا وَمَنْ أَحْيَاهَا فَكَأَنَّمَا أَحْيَا النَّاسَ جَمِيعًا﴾ یعنی «اسی وجہ سے ہم نے بنی اسرائیل پر لکھ دیا کہ جس نے کسی جان کو قتل کیا بغیر جان کے بدلے یا زمین میں فساد کے تو گویا اس نے تمام لوگوں کو قتل کیا، اور جس نے اسے زندہ کیا تو گویا اس نے تمام لوگوں کو زندہ کیا» (قرآن المائدہ 5:32) اور یہ اس کی وجہ سے ہے جو پہلے کے دل میں قساوت اور غلظت اور شر میں سے ہے، اور جو دوسرے کے دل میں رحمت اور نرمی اور رافت میں سے ہے، جب کہ وہ اس کی کوشش میں ہے کہ وہ ہر اسے زندہ کرے جسے زندہ کرنے کی اسے لوگوں میں سے قدرت ہو، جیسا کہ جو پہلے کے دل میں قساوت میں سے ہے وہ تمام جانوں کے قتل کے لیے تیار ہے۔"
"83","[AI-translation] حضرت انس بن مالک رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «جو چاہے کہ اس کے لیے اس کے رزق میں کشادگی کی جائے، اور اس کے لیے اس کے نشان میں تاخیر کی جائے، تو اسے اپنی رحم سے جوڑنا چاہیے»۔ متفق علیہ (بخاری اور مسلم)۔
اس حدیث میں ہے: صلہ رحمی پر ابھارنا، اور اس کا بیان کہ وہ جیسا کہ آخرت میں اللہ کی رضا اور اس کے ثواب کی موجب ہے، تو وہ فوری ثواب کی موجب ہے، بندے کی محبوب ترین چیزوں کے حاصل ہونے سے، اور یہ کہ وہ رزق کے بسط اور اس کی وسعت کا سبب ہے، اور عمر کی درازی کا سبب ہے۔ اور یہ حقیقت پر حق ہے؛ پس بے شک وہ تعالیٰ سببوں اور مسببات کا خالق ہے۔ اور اللہ نے ہر مطلوب کے لیے سبب اور راستہ بنایا ہے جس سے وہ پایا جائے، اور یہ بڑی اصل پر جاری ہے، اور یہ کہ اس کی حکمت اور حمد میں سے ہے کہ اس نے بدلہ عمل کی جنس سے بنایا، پس جیسا اس نے اپنی رحم سے متنوع نیکی اور احسان سے جوڑا، اور ان کے دلوں پر سرور داخل کیا، تو اللہ نے اس کی عمر کو جوڑا، اور اس کے رزق کو جوڑا، اور اس کے لیے رزق کے دروازوں اور اس کی برکتوں میں سے وہ کھولا جو اسے اس جلیل سبب کے بغیر حاصل نہ ہوتا۔ اور جیسا کہ صحت اور ہوا کی پاکیزگی اور غذا کی پاکیزگی، اور بدنوں اور دلوں کو قوت دینے والی چیزوں کا استعمال، عمر کی درازی کے سببوں میں سے ہیں، تو اسی طرح صلہ رحمی کو اللہ نے ربانی سبب بنایا۔ پس بے شک وہ اسباب جن سے دنیوی محبوبات حاصل ہوتے ہیں دو قسم ہیں: محسوس امور، جو حواس کے ادراک میں اور عقلوں کے مدارک میں داخل ہوں۔ اور ربانی الٰہی امور جنہیں اس نے مقدر کیا جو ہر چیز پر قادر ہے، اور جس سے تمام اسباب اور عالم کے امور اس کی مشیت کے تابع ہیں، اور جس نے توکل کرنے والوں کے لیے کفایت کا ذمہ لیا، اور متقیوں کے لیے رزق اور تنگیوں سے نکلنے کا وعدہ کیا۔ اللہ تعالیٰ نے فرمایا: ﴿وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا - وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ﴾ یعنی «اور جو اللہ سے ڈرے وہ اس کے لیے نکلنے کی راہ بنا دیتا ہے، اور اسے وہاں سے رزق دیتا ہے جہاں سے وہ گمان نہیں کرتا، اور جو اللہ پر توکل کرے تو وہ اسے کافی ہے» (قرآن الطلاق 65:2-3) اور جب نبی ﷺ فرماتے ہیں: «صدقہ مال میں کوئی کمی نہیں کرتا» بلکہ اسے بڑھاتا ہے، تو قرابت داروں اور رشتے داروں پر صدقہ اور ہدیہ کیسا ہو گا؟ اور اس حدیث میں دلیل ہے: کہ عامل کے قصد کا، جو اس کے عمل پر دنیوی ثواب مرتب ہوتا ہے وہ اسے ضرر نہیں دیتا جب عمل سے قصد اللہ کا چہرہ اور آخرت کا گھر ہو۔ پس بے شک اللہ نے اپنی حکمت اور رحمت سے فوری اور آئندہ ثواب مرتب کیا، اور اس کا عمل کرنے والوں سے وعدہ کیا؛ کیونکہ امید اور اس کا ثمر لینا عمل کرنے والوں کو چست کرتا ہے، اور ان کی ہمتیں خیر پر ابھارتا ہے، جیسا کہ جرائم پر وعید، اور ان کی سزاؤں کا ذکر جن سے اللہ اپنے بندوں کو ڈراتا ہے اور انہیں گناہوں اور جرائم کے چھوڑنے پر ابھارتا ہے۔ پس صادق مومن اپنے فعل اور ترک میں اللہ کے لیے مخلص ہوتا ہے، ان اعمال میں متنوع مرغبات سے اس اعلیٰ مقصد پر مدد لیتے ہوئے، واللہ الموفق۔"
"84","[AI-translation] حضرت ابو موسیٰ اشعری رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «آدمی اس کے ساتھ ہے جس سے اس نے محبت کی»۔ متفق علیہ (بخاری اور مسلم)۔
«آدمی اس کے ساتھ ہے جس سے اس نے محبت کی» اس حدیث میں رسولوں سے قوی محبت کی اور ان کی ان کے مراتب کے بقدر پیروی کی ترغیب ہے، اور ان کے ضد سے محبت سے ڈرانا ہے، پس بے شک محبت محب کے اس سے قوی اتصال کی دلیل ہے جس سے وہ محبت کرتا ہے، اور اس کے اخلاق سے اس کی مناسبت کی، اور اس کی اقتدا کی، پس وہ اس کے وجود کی دلیل ہے، اور وہ اس پر بھی ابھارنے والی ہے۔ اور نیز جس نے اللہ تعالیٰ سے محبت کی، تو اس کی محبت کا نفس اسے اللہ کا قرب دلانے والی عظیم ترین چیزوں میں سے ہے، پس بے شک اللہ تعالیٰ قدردان ہے، تقرب کرنے والے کو اس سے بہت زیادہ دیتا ہے ـ کئی گنا بڑھا کر ـ جو اس نے خرچ کیا، اور اس کے شکر میں سے ہے: کہ وہ اسے اس سے ملحق کرے جس سے اس نے محبت کی، اگرچہ اس کا عمل کوتاہ ہو، اللہ تعالیٰ نے فرمایا: ﴿وَمَنْ يُطِعِ اللَّهَ وَالرَّسُولَ فَأُولَئِكَ مَعَ الَّذِينَ أَنْعَمَ اللَّهُ عَلَيْهِمْ مِنَ النَّبِيِّينَ وَالصِّدِّيقِينَ وَالشُّهَدَاءِ وَالصَّالِحِينَ وَحَسُنَ أُولَئِكَ رَفِيقًا﴾ یعنی «اور جو اللہ اور رسول کی اطاعت کرے تو وہ ان کے ساتھ ہوں گے جن پر اللہ نے انعام کیا، نبیوں اور صدیقوں اور شہیدوں اور صالحوں میں سے، اور وہ کیسے اچھے ساتھی ہیں» (قرآن النساء 4:69) اور اسی لیے انس نے کہا: «ہم کسی چیز سے اتنے خوش نہیں ہوئے جتنا آپ ﷺ کے قول سے خوش ہوئے: «آدمی اس کے ساتھ ہے جس سے اس نے محبت کی» کہا: پس میں رسول اللہ اور ابوبکر اور عمر سے محبت کرتا ہوں، تو امید رکھتا ہوں کہ میں ان کے ساتھ ہوں گا»۔ اور اللہ تعالیٰ نے فرمایا: ﴿جَنَّاتُ عَدْنٍ يَدْخُلُونَهَا وَمَنْ صَلَحَ مِنْ آبَائِهِمْ وَأَزْوَاجِهِمْ وَذُرِّيَّاتِهِمْ﴾ یعنی «عدن کے باغات جن میں وہ داخل ہوں گے اور ان کے باپ دادا اور ان کی بیویوں اور ان کی اولاد میں سے جو نیک ہوئے» (قرآن الرعد 13:23) اور اللہ سبحانہ نے فرمایا: ﴿وَالَّذِينَ آمَنُوا وَاتَّبَعَتْهُمْ ذُرِّيَّتُهُمْ بِإِيمَانٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَا أَلَتْنَاهُمْ مِنْ عَمَلِهِمْ مِنْ شَيْءٍ﴾ یعنی «اور جو ایمان لائے اور ان کی اولاد نے ایمان کے ساتھ ان کی پیروی کی تو ہم ان کی اولاد کو ان سے ملا دیں گے اور ان کے عمل میں سے کچھ کم نہیں کریں گے» (قرآن الطور 52:21) اور یہ مشاہد مجرب ہے جب بندہ اہل خیر سے محبت کرتا ہے تو تم اسے ان سے ملا ہوا دیکھتے ہو، حریص کہ وہ ان جیسا ہو، اور جب وہ اہل شر سے محبت کرتا ہے تو ان سے مل جاتا ہے اور ان کے اعمال کرتا ہے۔ اور آپ ﷺ نے فرمایا: «آدمی اپنے دوست کے دین پر ہوتا ہے، پس تم میں سے ہر ایک دیکھے کہ وہ کس سے دوستی کرتا ہے»، اور «نیک ہم نشین کی مثال، مشک اٹھانے والے جیسی ہے: یا تو وہ تمہیں عطا کرے گا، یا تم اس سے خریدو گے، یا تم اس سے اچھی خوشبو پاؤ گے، اور برے ہم نشین کی مثال بھٹی دھونکنے والے جیسی ہے: یا تو وہ تمہارے کپڑے جلا دے گا، یا تم اس کے پاس بری بو پاؤ گے»۔ اور جب مخلوق کے درمیان آپس میں محبت میں یہ حال ہو تو اس کا کیا حال ہوگا جس نے اللہ سے محبت کی اور اس کی محبت اور خشیت کو ہر چیز پر مقدم کیا؟ تو وہ اللہ کے ساتھ ہے، اور اسے اس سے کامل قرب حاصل ہو گیا ہے، اور وہ محبوں کا قرب ہے، اور اللہ اس کے ساتھ تھا۔ پس «بے شک اللہ ان کے ساتھ ہے جو ڈرے اور ان کے ساتھ جو احسان کرنے والے ہیں» (قرآن النحل 16:128)۔ اور احسان کی اعلیٰ ترین انواع رحیم کریم رحمن کی محبت ہے، ایسی محبت جو اس کی معرفت سے ملی ہو۔ پس ہم اللہ سے سوال کرتے ہیں کہ وہ ہمیں اپنی محبت اور اس سے محبت کرنے والوں کی محبت اور اس عمل کی محبت عطا کرے جو اس کی محبت کا قرب دلائے، بے شک وہ سخی کریم ہے، اور توفیق اللہ سے ہے۔"
"85","[AI-translation] حضرت عبداللہ بن عمر رضی اللہ عنہما سے روایت ہے: «بے شک رسول اللہ ﷺ جب اپنے اونٹ پر سفر کے لیے نکلتے ہوئے سیدھے بیٹھتے تو تین بار تکبیر کہتے، پھر کہتے: پاک ہے وہ جس نے ہمارے لیے اسے مسخر کیا اور ہم اس پر قابو پانے والے نہ تھے، اور بے شک ہم اپنے رب کی طرف لوٹنے والے ہیں۔ اے اللہ بے شک ہم تجھ سے اپنے اس سفر میں نیکی اور تقویٰ کا، اور عمل میں سے اس کا سوال کرتے ہیں جسے تو پسند کرے، اے اللہ ہم پر ہمارا یہ سفر آسان کر دے، اور اس کی دوری کو ہم سے لپیٹ دے، اے اللہ تو سفر میں ساتھی ہے اور اہل میں جانشین ہے، اے اللہ بے شک میں تیری پناہ مانگتا ہوں سفر کی مشقت سے، اور منظر کی افسردگی سے، اور مال اور اہل اور اولاد میں برے لوٹنے سے۔ اور جب لوٹتے تو یہی کلمات کہتے اور ان میں اضافہ کرتے: لوٹنے والے، توبہ کرنے والے، عبادت کرنے والے، اپنے رب کی حمد کرنے والے»۔ مسلم نے روایت کیا۔
اس حدیث میں عظیم فوائد ہیں جو سفر سے متعلق ہیں۔ اور ان دعاؤں نے دینی مصالح کے طلب کو سمیٹا ہے ـ اور وہ اہم ترین امور ہیں ـ اور دنیوی مصالح کو، اور محبوبات کے حاصل ہونے کو، اور مکروہات اور مضرتوں کے دفع کو اور اللہ کی نعمتوں کے شکر کو، اور اس کی آلاء اور اس کے کرم کے تذکرے کو، اور سفر کے اللہ کی طاعت پر اور اس کے قرب پر مشتمل ہونے کو۔ پس آپ کا قول: «جب اپنی سواری پر سفر کے لیے نکلتے ہوئے سیدھے بیٹھتے، تین بار تکبیر کہتے» وہ اپنے سفر کا اللہ کی تکبیر اور اس کی ثنا سے افتتاح ہے، جیسا کہ وہ اس پر ختم کرتے تھے۔ اور آپ ﷺ کا قول: «پاک ہے وہ جس نے ہمارے لیے اسے مسخر کیا، اور ہم اس پر قابو پانے والے نہ تھے اور بے شک ہم اپنے رب کی طرف لوٹنے والے ہیں» اس میں سواریوں کو مسخر کرنے پر اللہ کی ثنا ہے، جو بوجھوں اور جانوں کو دور شہروں اور وسیع قطروں تک اٹھاتی ہیں، اور سواریوں سے اللہ کی نعمت کا اعتراف ہے۔ اور اس میں سواریاں داخل ہیں: اونٹوں میں سے، اور سمندری اور بری اور ہوائی جہازوں میں سے، پس وہ سب اس میں داخل ہیں۔ اور اسی لیے نوح نے سوار ہونے والوں سے اپنے ساتھ کشتی میں کہا: ﴿ارْكَبُوا فِيهَا بِسْمِ اللَّهِ مَجْرَاهَا وَمُرْسَاهَا﴾ یعنی «اس میں سوار ہو جاؤ، اللہ کے نام سے اس کا چلنا اور اس کا ٹھہرنا ہے» (قرآن ہود 11:41) پس یہ سواریاں سب، اور ان کے اسباب، اور جس سے وہ تمام اور مکمل ہوتی ہیں، سب اللہ کی نعمتوں اور اس کے تسخیر میں سے ہیں۔ بندوں پر واجب ہے کہ وہ اس کی نعمت کا اللہ کے لیے اعتراف کریں، اور خصوصاً اسے برتنے کے وقت۔ اور اس میں اس حالت کا تذکرہ ہے جو اگر باری نہ ہوتا تو حاصل نہ ہوتی اور ذلیل نہ ہوتی اس کے قول میں: «اور ہم اس پر قابو پانے والے نہ تھے» یعنی طاقت رکھنے والے، اگر معاملہ ہمارے حول اور قوت کی طرف لوٹایا جاتا، تو ہم علم اور قدرت اور ارادے میں کمزور ترین چیز ہوتے، لیکن اس نے حیوانات مسخر کیے اور انسان کو سواریوں کی صنعت سکھائی، جیسا کہ اللہ نے بچانے والی زرہوں کی صنعت کے آسان کرنے میں احسان کیا اپنے قول میں: ﴿وَعَلَّمْنَاهُ صَنْعَةَ لَبُوسٍ لَكُمْ لِتُحْصِنَكُمْ مِنْ بَأْسِكُمْ فَهَلْ أَنْتُمْ شَاكِرُونَ﴾ یعنی «اور ہم نے اسے تمہارے لیے لباس کی صنعت سکھائی تاکہ وہ تمہیں تمہاری لڑائی سے بچائے، تو کیا تم شکر کرنے والے ہو» (قرآن الانبیاء 21:80) پس مخلوق پر ہے کہ وہ اللہ کا شکر کریں، جب اس نے انہیں عورتیں چھپانے والے لباس کی اور زینت کے لباس کی اور جنگ کے لباس اور جنگ کے آلات کی صنعت سکھائی، اور انہیں بحری و بری و ہوائی کشتیوں کی صنعت اور ہر اس چیز کی صنعت سکھائی جس سے نفع اٹھانے کی انہیں حاجت ہو، اور لوہا اتارا جس میں سخت جنگ اور لوگوں کے لیے متنوع منافع ہیں۔ لیکن اکثر مخلوق اللہ کے شکر سے غفلت میں ہے، بلکہ اللہ پر سرکشی اور تکبر میں، اور ان نعمتوں سے بندوں پر جبر میں ہے۔ اور اس حدیث میں ہے حسی دنیوی سفر سے معنوی اخروی سفر کی یاددہانی، اس کے قول کی وجہ سے: «اور بے شک ہم اپنے رب کی طرف لوٹنے والے ہیں»۔ تو جیسا اس نے خلق کا آغاز کیا وہ اسے لوٹائے گا تاکہ جنہوں نے برائی کی انہیں ان کے کیے کا بدلہ دے، اور جنہوں نے احسان کیا انہیں بہترین سے بدلہ دے۔ اور اس کا قول: «اے اللہ! بے شک ہم تجھ سے اپنے اس سفر میں نیکی اور تقویٰ کا اور عمل میں سے اس کا سوال کرتے ہیں جسے تو پسند کرے»۔ اللہ سے سوال کیا کہ سفر اس جلیل وصف سے متصف ہو، تمام نیکی کے اعمال پر مشتمل ہو جو اللہ کے حق سے متعلق ہیں اور جو مخلوق کے حقوق سے متعلق ہیں، اور تقویٰ پر جو اللہ کی ناراضی سے بچنا ہے، اللہ کو ناپسند تمام اقوال و اعمال ظاہری و باطنی چھوڑنے سے، جیسا اس سے اس عمل کا سوال کیا جسے اللہ پسند کرے۔ اور یہ تمام طاعتوں اور قربتوں کو شامل ہے، اور جب سفر اس وصف پر ہو تو وہ کامیاب سفر ہے، اور وہ مبارک سفر ہے۔ اور آپ ﷺ کے سفر سب ان جلیل معانی پر مشتمل تھے۔ پھر اللہ سے اعانت اور سفر کی مشقتوں کے ہلکا کرنے کا سوال کیا، تو فرمایا: «اے اللہ! ہم پر ہمارا یہ سفر آسان کر دے، اور اس کی دوری کو ہم سے لپیٹ دے» کیونکہ سفر عذاب کا ٹکڑا ہے، تو اس کے ہلکا کرنے اور اس کے بعید کے لپیٹنے کا سوال کیا، اور یہ فکروں اور مشقتوں کے ہلکا کرنے سے اور سیر میں برکت سے ہوتا ہے، یہاں تک کہ بعید مسافتیں طے کرے اور وہ بے پروا ہو، اور اس کے لیے سفر میں راحت دینے والے اسباب میں سے بہت سی باتیں مقدر کرے، جیسے دل کی راحت، اور رفاقت کی مناسبت، اور سیر کا آسان ہونا، اور خوفوں سے راستے کا امن، اور اس کے سوا دیگر اسباب میں سے۔ تو کتنے ہی سفر ہیں جو بہت سے دنوں تک پھیلے، لیکن اللہ نے انہیں ہلکا کیا اور ان کے اہل پر آسان کیا، اور کتنے ہی قلیل سفر ہیں جو ہر مشکل سے مشکل تر ہوئے، تو وہاں اللہ کے آسان کرنے اور اس کے لطف اور اس کی اعانت کے سوا کچھ نہیں۔ اور اسی لیے سفر کے ہلکا کرنے کے تحقق میں فرمایا: «اے اللہ! بے شک میں تیری پناہ مانگتا ہوں سفر کی مشقت سے» یعنی اس کی مشقت اور مشکل سے «اور منظر کی افسردگی سے» یعنی لازم حزن اور دائم فکر سے «اور مال اور اہل اور اولاد میں برے لوٹنے سے» یعنی: اے رب! ہم تجھ سے سوال کرتے ہیں کہ تو ہر اس چیز کی حفاظت کرے جو ہم نے اپنے پیچھے چھوڑی اور اپنے سفر سے جسے ہم نے جدا کیا اہل اور اولاد اور مال میں سے، اور یہ کہ ہم سلامتی سے اور ہم پر اور ان پر پے در پے نعمتوں سے مسرور ان کی طرف لوٹیں: تو اس سے نعمت مکمل ہوتی ہے اور سرور کامل ہوتا ہے۔ اور اسی طرح اپنے سفر سے رجوع اور واپسی میں یہ کہتا ہے، اور اضافہ کرتا ہے: «لوٹنے والے، توبہ کرنے والے، عبادت کرنے والے، اپنے رب کی حمد کرنے والے» یعنی اے اللہ! ہم تجھ سے سوال کرتے ہیں کہ تو ہمیں ہمارے لوٹنے اور رجوع میں تیری توبہ اور تیری عبادت اور تیری حمد کے پابند بنا، اور یہ کہ تو ہمارے سفر کا خاتمہ تیری طاعت پر کرے، جیسا تو نے اس کا آغاز اس کی توفیق سے کیا۔ اور اسی لیے اللہ تعالیٰ نے فرمایا: «اور کہو اے رب! مجھے سچے داخلے سے داخل کر اور مجھے سچے نکلنے سے نکال اور میرے لیے اپنی طرف سے مددگار سلطان بنا» (قرآن الاسراء 17:80)۔ اور سچا داخلہ اور نکلنا یہ ہے کہ بندے کے سفر اور اس کے داخلے اور نکلنے سب سچائی اور حق پر مشتمل ہوں، اور اس میں مشغول ہونا جسے اللہ پسند کرے، اللہ پر توکل سے ملا ہوا اور اس کی اعانت سے مصاحب ہو۔ اور اس میں آخر میں اس کی نعمت کا اعتراف ہے، جیسا اول میں اس کا اعتراف کیا، اس کے قول میں: «اپنے رب کی حمد کرنے والے»۔ تو جیسا بندے پر ہے کہ وہ عبادت کے فعل اور حاجت کے شروع کی توفیق پر اللہ کی حمد کرے، تو اس پر ہے کہ وہ اس کی تکمیل اور اس کے تمام ہونے اور اس سے فراغت پر اللہ کی حمد کرے، کیونکہ فضل اس کا فضل ہے، اور خیر اس کا خیر ہے، اور اسباب اس کے اسباب ہیں۔ اور اللہ عظیم فضل والا ہے۔"
"86","[AI-translation] حضرت جابر بن عبداللہ رضی اللہ عنہما سے روایت ہے: بے شک نبی ﷺ نے فرمایا: «مجھ سے اپنے مناسک لو»۔ احمد اور مسلم اور نسائی نے روایت کیا۔
یہ جامع کلام ہے جس سے اہل علم نے اس سب کی مشروعیت پر استدلال کیا جو نبی ﷺ نے اپنے حج میں کیا اور کہا واجب میں وجوباً، اور مستحبات میں استحباباً، اور وہ آپ ﷺ کے نماز میں قول کی نظیر ہے: «نماز اس طرح پڑھو جیسے تم نے مجھے نماز پڑھتے دیکھا ہے» پس جیسا کہ وہ نماز کے تمام جزئیات کو شامل ہے، تو یہ مناسک کے تمام جزئیات کو شامل ہے۔ اور شیخ الاسلام ابن تیمیہ کا بہت اچھا کلام ہے نبی ﷺ کے حج کے خلاصے میں، جسے انہوں نے «القواعد النورانیہ» میں ذکر کیا، تو فرمایا ـ اللہ ان کی روح کو پاک کرے اور ان سے راضی ہو ـ: اور حدیث کے علماء میں سے خاص کے ہاں متواتر نقل سے بہت سے وجہوں سے «صحیحین» اور اس کے علاوہ میں ثابت ہوا ہے: کہ آپ ﷺ جب حجۃ الوداع میں حج کیا تو آپ نے اور مسلمانوں نے ذوالحلیفہ سے احرام باندھا۔ تو فرمایا: «جو چاہے عمرے کا احرام باندھے تو کرے، اور جو چاہے حج کا احرام باندھے تو کرے، اور جو چاہے عمرے اور حج کا احرام باندھے تو کرے» پھر جب وہ آئے اور بیت اللہ کا طواف کیا اور صفا اور مروہ کے درمیان سعی کی، تو ان تمام مسلمانوں کو حکم دیا جو ان کے ساتھ حج کر رہے تھے کہ وہ اپنے احرام سے حلال ہو جائیں اور اسے عمرہ بنا لیں، سوائے اس کے جس نے ہدی ساتھ لی ہو، پس بے شک وہ حلال نہ ہو یہاں تک کہ ہدی اپنے محل تک پہنچے۔ تو ان میں سے بعض نے اس بارے میں ان سے مراجعت کی۔ تو آپ غضبناک ہوئے، اور فرمایا: «دیکھو جو میں نے تمہیں حکم دیا ہے اسے کرو»۔ اور آپ ﷺ خود ہدی ساتھ لائے تھے، پس اپنے احرام سے حلال نہ ہوئے، اور جب آپ نے بعض کی حلال ہونے سے کراہت دیکھی تو فرمایا: «اگر میں اپنے معاملے کے آغاز میں وہ جان لیتا جو اب مجھے معلوم ہوا ہے تو میں ہدی ساتھ نہ لاتا، اور اسے عمرہ بنا لیتا، اور اگر میرے ساتھ ہدی نہ ہوتی تو میں ضرور حلال ہو جاتا»۔ اور یہ بھی فرمایا: «بے شک میں نے اپنے سر کے بال جمائے ہیں اور اپنی ہدی کو قلادہ پہنایا ہے، پس میں حلال نہ ہوں گا یہاں تک کہ نحر کروں»۔ پس تمام مسلمان حلال ہو گئے سوائے ان چند کے جنہوں نے ہدی ساتھ لی تھی؛ ان میں سے تھے: رسول اللہ ﷺ، اور علی بن ابی طالب، اور طلحہ بن عبید اللہ۔ پھر جب یوم الترویہ آیا تو حلال ہونے والوں نے حج کا احرام باندھا، جب وہ منیٰ کی طرف جا رہے تھے، تو آپ نے انہیں وہ رات منیٰ میں ٹھہرایا اور ان کے ساتھ وہیں ظہر اور عصر اور مغرب اور عشاء اور فجر پڑھی، پھر انہیں لے کر نمرہ کی طرف چلے، ضب کے راستے سے، اور نمرہ عرفہ سے باہر ہے، اس کے جنوبی اور مغربی جانب سے، نہ حرم میں سے ہے اور نہ عرفہ میں سے۔ تو آپ کے لیے نمرہ میں خیمہ نصب کیا گیا۔ اور وہیں آپ کے بعد آپ کے خلفائے راشدین اترتے تھے، اور وہیں بازار اور حاجت پوری کرنا اور کھانا اور اس جیسی چیزیں ہوتی تھیں۔ پھر جب سورج ڈھل گیا تو آپ سوار ہوئے اور جو آپ کے ساتھ سوار ہوئے، اور مسلمان بطن عرنہ میں مصلے کی طرف چلے، جہاں مسجد بنائی گئی ہے اور وہ نہ حرم میں سے ہے اور نہ عرفہ میں سے۔ بلکہ وہ دونوں مشعروں کے درمیان برزخ ہے: وہاں حلال اور حرام کے درمیان، اس کے اور موقف کے درمیان تقریباً ایک میل ہے، تو آپ نے ان میں اپنی اونٹنی پر حج کا خطبہ دیا، اور وہ جمعہ کا دن تھا، پھر اترے تو ان کے ساتھ ظہر اور عصر قصر کر کے جمع کر کے پڑھی۔ پھر چلے ـ اور مسلمان آپ کے ساتھ تھے ـ عرفہ میں موقف کی طرف اس پہاڑ کے پاس جو جبل الرحمہ کے نام سے معروف ہے۔ اور اس کا نام ""الال"" ہے ہلال کے وزن پر، اور وہی ہے جسے عام لوگ عرفہ کہتے ہیں، تو آپ اور مسلمان ذکر اور دعا میں رہے یہاں تک کہ سورج غروب ہو گیا، تو انہیں لے کر مزدلفہ کی طرف چلے، تو شفق غائب ہونے کے بعد سامان اتارنے سے پہلے مغرب اور عشاء پڑھی، جب وہ مزدلفہ میں اترے، اور وہیں رہے یہاں تک کہ فجر طلوع ہوئی، تو مسلمانوں کے ساتھ فجر اپنے اول وقت میں پڑھی، ہر دن سے بڑھ کر اندھیرے میں، پھر قزح کے پاس وقوف کیا، اور وہ مزدلفہ کا پہاڑ ہے جسے مشعر حرام کہا جاتا ہے، تو مسلمانوں کے ساتھ کھڑے رہے یہاں تک کہ خوب روشنی ہو گئی، پھر انہیں لے کر چلے یہاں تک کہ منیٰ آئے، تو اس کا افتتاح جمرۃ العقبہ کی رمی سے کیا، پھر منیٰ میں اپنی منزل کی طرف لوٹے، پھر منحر پر آئے اور اپنی ساتھ لائی ہوئی ہدی میں سے تریسٹھ اونٹ نحر کیے، اور علی کو حکم دیا تو انہوں نے باقی نحر کی اور وہ سو اونٹ تھی، پھر اپنا سر منڈوایا۔ پھر مکہ کی طرف افاضہ کیا، تو طواف افاضہ کیا، اور آپ نے اپنے گھر کے کمزوروں کو مزدلفہ سے طلوع فجر سے پہلے روانہ کر دیا تھا، تو انہوں نے رات میں جمرے کی رمی کی۔ پھر مسلمانوں کے ساتھ منیٰ کے تین دن قیام کیا، ان کے ساتھ پانچوں نمازیں قصر کر کے بغیر جمع کے پڑھتے، ہر دن سورج ڈھلنے کے بعد تینوں جمرات کی رمی کرتے، پہلے جمرے سے آغاز کرتے ـ اور وہ صغریٰ ہے، اور وہ منیٰ سے قریب ترین ہے اور مکہ سے دور ترین ہے ـ اور جمرۃ العقبہ پر ختم کرتے، اور دونوں جمرات کے درمیان: پہلے اور دوسرے کے درمیان، اور دوسرے اور تیسرے کے درمیان طویل وقوف کرتے بقدر سورۃ البقرہ، اللہ کا ذکر کرتے اور دعا کرتے؛ پس بے شک مواقف تین ہیں: عرفہ، اور مزدلفہ، اور منیٰ۔ پھر ایام تشریق کے آخر میں جمرات کی رمی کے بعد آپ اور مسلمانوں نے افاضہ کیا، تو محصب میں اترے، خیف بنی کنانہ کے پاس، تو آپ اور مسلمان بدھ کی رات وہیں رہے، اور اسی رات عائشہ کو ان کے بھائی عبدالرحمن کے ساتھ بھیجا؛ تاکہ وہ تنعیم سے عمرہ کریں، اور وہ مکہ سے حرم کے قریب ترین کناروں میں سے ہے، اہل مدینہ کے راستے سے۔ اور اس کے بعد وہاں مسجد بنائی گئی جسے لوگوں نے مسجد عائشہ نام دیا؛ کیونکہ نبی ﷺ کے ساتھ حج کے بعد آپ کے اصحاب میں سے کسی نے کبھی عمرہ نہ کیا سوائے عائشہ کے، اس لیے کہ وہ جب آئیں تو حائضہ ہو گئی تھیں اور وہ عمرے کا احرام باندھے ہوئے تھیں۔ تو انہوں نے وقوف سے پہلے بیت اللہ کا طواف نہ کیا، نہ صفا اور مروہ کے درمیان سعی کی، اور نبی ﷺ نے ان سے فرمایا: «حاجی جو کچھ کرتا ہے کرو، سوائے اس کے کہ بیت اللہ کا طواف نہ کرو، نہ صفا اور مروہ کے درمیان سعی کرو»۔ پھر آپ اور مسلمانوں نے بیت اللہ کو الوداع کیا اور مدینہ لوٹے۔ اور ایام تشریق کے بعد قیام نہ کیا، اور آپ کے عہد میں کبھی کسی نے ایسا عمرہ نہ کیا جس میں وہ حرم سے حل کی طرف نکلے سوائے عائشہ رضی اللہ عنہا تنہا کے، تو فقہائے حدیث ـ جیسے احمد اور ان کے علاوہ ـ نے اس سب میں ان کی سنت کو لیا، ان کے کلام کے آخر تک ـ اللہ ان کی روح کو پاک کرے اور ان سے راضی ہو ـ۔ واللہ اعلم۔"
"87","[AI-translation] حضرت ابوہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «قل ہو اللہ احد قرآن کے تیسرے کے برابر ہے»۔ مسلم نے روایت کیا۔
«قل ہو اللہ احد قرآن کے تیسرے کے برابر ہے» اہل علم نے اس معادلے کے معنی اور اس کی توجیہ پر کلام کیا ہے۔ اور اس میں جو بہترین کہا گیا: کہ اس کا قرآن کے ثلث کے برابر ہونا، اس کی وجہ سے ہے جو اس نے عظیم معانی کو شامل کیا: توحید کے معانی، اور ایمان کے اصول۔ پس بے شک وہ جلیل موضوعات جنہیں قرآن شامل ہے: 1 ـ یا تو شرعی احکام: ظاہری یا باطنی، عبادات یا معاملات۔ 2 ـ اور یا تو قصے اور خبریں مخلوقات کے بارے میں اگلی اور پچھلی، اور مکلفوں کے احوال اعمال پر جزا میں۔ 3 ـ اور یا تو توحید اور معارف، جو اللہ کے ناموں اور اس کی صفات سے متعلق ہیں، اور اس کے وحدانیت اور کمال سے تفرد سے، اور ہر عیب سے اور مخلوقات میں سے کسی کی مماثلت سے اس کے منزہ ہونے سے۔ پس سورۃ قل ہو اللہ احد اس پر مشتمل ہے، اور اس سب کو شامل ہے جو اس اصل سے اعتقاد واجب ہے، جو تمام اصولوں کی اصل ہے۔ اور اسی لیے اللہ نے ہمیں حکم دیا کہ ہم اسے اپنی زبانوں سے کہیں، اور اسے اپنے دلوں سے جانیں، اور اس کا اقرار کریں اور اللہ کے لیے اس کے اعتقاد سے دین رکھیں، اور اللہ کے لیے اس سے تعبد کریں۔ تو فرمایا: ﴿قُلْ هُوَ اللَّهُ أَحَدٌ﴾ یعنی «کہو وہ اللہ ایک ہے» (قرآن الاخلاص 112:1) پس اللہ: وہ معبود ہے جو الوہیت کے تمام معانی کا مستحق ہے، جو واجب کرتے ہیں کہ وہی تنہا معبود ہو، تنہا محمود ہو، تنہا مشکور ہو، معظم مقدس ہو، ذو الجلال والاکرام ہو۔ اور «احد» یعنی: جو ہر کمال سے متفرد ہے، اور مجد اور جلال سے، اور جمال اور حمد سے، اور حکمت اور رحمت سے، اور کمال کی صفات میں سے غیر سے۔ پس اس میں اس کا کوئی مثل اور نہ نظیر ہے، اور نہ کسی جہت سے مناسبت ہے۔ پس وہ اپنی حیات اور قیومیت میں، اور اپنے علم اور قدرت میں، اور اپنی عظمت اور جلال میں، اور اپنے جمال اور حمد میں، اور اپنی حکمت اور رحمت میں، اور اپنی صفات میں سے غیر میں احد ہے، غایت کمال اور اس کی نہایت سے موصوف ہے، ان صفات میں سے ہر صفت سے۔ اور اس کی احدیت اور اس سے اس کے تفرد کے تحقیق میں سے ہے کہ وہ ﴿الصَّمَدُ﴾ یعنی «بے نیاز ہے» (قرآن الاخلاص 112:2) یعنی: کامل رب، اور عظیم سردار، جس سے کمال کی کوئی صفت باقی نہیں رہی مگر وہ اس سے متصف ہوا۔ اور اس کی غایت اور اس کے کمال سے وصف کیا گیا، اس طرح کہ مخلوق ان صفات میں سے بعض کا اپنے دلوں سے احاطہ نہیں کرتی، اور نہ ان کی زبانیں ان کا اظہار کرتی ہیں۔ اور وہ مصمود الیہ ہے، تمام حاجتوں اور مصیبتوں میں مقصود ہے: ﴿يَسْأَلُهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ كُلَّ يَوْمٍ هُوَ فِي شَأْنٍ﴾ یعنی «اس سے مانگتا ہے جو آسمانوں اور زمین میں ہے، ہر دن وہ کسی کام میں ہے» (قرآن الرحمٰن 55:29) پس وہ بذاتہ غنی ہے، اور تمام کائنات بذاتہ اس کی فقیر ہیں، ان کے پیدا کرنے میں اور ان کے تیار کرنے میں، اور ان کی ہر اس چیز سے مدد میں جس کی وہ ہر جہت سے حاجت رکھتے ہیں، ان میں سے کسی کو اس سے ذرہ برابر بھی غنا نہیں، ان کے احوال میں سے ہر حال میں۔ پس صمد: وہ مصمود الیہ ہے، ہر چیز میں مقصود ہے، اس کے کمال اور اس کے کرم اور اس کے جود اور اس کے احسان کی وجہ سے۔ اور اسی لیے ﴿لَمْ يَلِدْ وَلَمْ يُولَدْ﴾ یعنی «نہ اس نے جنا اور نہ وہ جنا گیا» (قرآن الاخلاص 112:3) پس بے شک تمام مخلوقات ایک دوسرے سے پیدا ہوتی ہیں، اور ان میں سے بعض بعض کے والد ہیں، اور بعض مولود ہیں۔ اور ہر مخلوق وہ مادے سے پیدا کی گئی ہے۔ اور رہا رب، تو بے شک وہ اس وصف میں ان کی مماثلت سے منزہ ہے، جیسا کہ وہ ہر نقص کی صفت میں ان کی مماثلت سے منزہ ہے۔ اور اسی لیے اس تنزیہ کو تحقیق کیا، اور اس کمال کو اس کے قول سے تمام کیا: ﴿وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ﴾ یعنی «اور اس کا کوئی ہمسر نہیں» (قرآن الاخلاص 112:4) یعنی: اس کا کوئی نظیر اور نہ مکافئ اور نہ مثیل ہے، نہ اس کے ناموں میں، اور نہ اس کی صفات میں، اور نہ اس کے افعال میں، اور نہ اس کے ان تمام حقوق میں جن سے وہ خاص ہوا۔ پس اس کا خاص حق دو امور ہیں: ہر جہت سے تمام کمال سے تفرد، اور تمام مخلوق سے خالص بندگی۔ پس سزاوار ہے اس سورت کے لیے جو ان عظیم جملوں کو شامل ہے: کہ وہ قرآن کے ثلث کے برابر ہو، پس بے شک جو کچھ قرآن میں اچھے ناموں میں سے ہے، اور عظیم عالی صفات میں سے، اور اللہ کے افعال اور اس کی صفات کے احکام میں سے، ان ناموں کی تفاصیل ہیں جو اس سورت میں ذکر کیے گئے، بلکہ جو کچھ قرآن میں ظاہری اور باطنی بندگیوں میں سے ہے، اور ان کی اقسام اور ان کی تفاصیل، اس سورت کے مضمون کی تفصیل ہیں۔ واللہ اعلم۔"
"88","[AI-translation] حضرت عبداللہ بن مسعود رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «حسد نہیں مگر دو میں: وہ آدمی جسے اللہ نے مال دیا، تو اسے اسے حق میں ہلاک کرنے پر مسلط کیا۔ اور وہ آدمی جسے اللہ نے حکمت دی، تو وہ اس سے فیصلہ کرتا ہے اور اسے سکھاتا ہے»۔ متفق علیہ (بخاری اور مسلم)۔
حسد دو نوع ہے: ایک نوع ہر حال میں محرم مذموم ہے، اور وہ یہ ہے کہ وہ بندے سے اللہ کی نعمت کے زوال کی تمنا کرے ـ دینی ہو یا دنیوی ـ اور برابر ہے کہ وہ اسے محبت کرے جو اس کے دل میں قرار پکڑ گئی ہو، اور اس سے اپنے نفس سے جہاد نہ کرے، یا وہ اس کے ساتھ اس کے زائل کرنے اور چھپانے میں کوشش کرے، اور یہ قبیح تر ہے، پس بے شک وہ بار بار ظلم ہے۔ اور یہ نوع وہ ہے جو نیکیوں کو کھاتی ہے جیسے آگ لکڑی کو کھاتی ہے۔ اور دوسری نوع یہ کہ وہ غیر سے اللہ کی نعمت کے زوال کی تمنا نہ کرے، لیکن اس جیسی کے اپنے لیے حاصل ہونے کی تمنا کرے، یا اس سے اوپر یا نیچے۔ اور یہ دو نوع ہیں محمود، اور غیر محمود۔ پس ان میں سے محمود: یہ کہ وہ اپنے بندے پر اللہ کی دینی نعمت دیکھے، تو تمنا کرے کہ اس کے لیے اس جیسی ہو، پس یہ خیر کی تمنا کے باب سے ہے، پس اگر اس سے اس کے حاصل کرنے کے لیے کوشش اور عمل مل جائے، تو وہ نور علی نور ہے۔ اور سب سے عظیم جس پر رشک کیا جائے: وہ جس کے پاس مال ہو جو اسے حلال سے حاصل ہوا ہو، پھر وہ اسے حق میں خرچ کرنے پر مسلط اور موفق ہوا ہو، واجب اور مستحب حقوق میں، پس بے شک یہ ایمان پر سب سے عظیم برہان میں سے ہے، اور احسان کی عظیم ترین انواع میں سے ہے۔ اور وہ جس کے پاس علم اور حکمت ہو جو اللہ نے اسے سکھائی ہو، تو وہ اسے سکھانے اور لوگوں کے درمیان فیصلہ کرنے میں خرچ کرنے کی توفیق پائے، پس احسان کی یہ دو نوعیں کوئی چیز ان کے برابر نہیں۔ پہلا: مخلوق کو اپنے مال سے نفع دیتا ہے، اور ان کی حاجتیں دفع کرتا ہے، اور خیریہ منصوبوں میں خرچ کرتا ہے، تو وہ قائم ہوتے ہیں اور ان کا نفع تسلسل پاتا ہے، اور ان کا اثر عظیم ہوتا ہے۔ اور دوسرا: لوگوں کو اپنے علم سے نفع دیتا ہے، اور ان کے درمیان دین اور علم پھیلاتا ہے جس سے بندے اپنے تمام امور میں ہدایت پاتے ہیں، عبادات میں سے اور معاملات میں سے اور اس کے علاوہ۔ پھر ان دو کے بعد: خیر پر رشک ہوتی ہے، اس کے حال اور اللہ کے ہاں اس کے درجات کے بقدر۔ اور اسی لیے اللہ تعالیٰ نے اس خیر کے حاصل ہونے پر فرح اور استبشار کا حکم دیا، اور یہ کہ اس کی توفیق صرف عظیم عالی نصیب والوں کو ہوتی ہے۔ اللہ تعالیٰ نے فرمایا: ﴿قُلْ بِفَضْلِ اللَّهِ وَبِرَحْمَتِهِ فَبِذَلِكَ فَلْيَفْرَحُوا هُوَ خَيْرٌ مِمَّا يَجْمَعُونَ﴾ یعنی «کہو اللہ کے فضل اور اس کی رحمت سے، پس اسی پر انہیں خوش ہونا چاہیے، وہ اس سے بہتر ہے جو وہ جمع کرتے ہیں» (قرآن یونس 10:58) اور فرمایا: ﴿وَلَا تَسْتَوِي الْحَسَنَةُ وَلَا السَّيِّئَةُ ادْفَعْ بِالَّتِي هِيَ أَحْسَنُ فَإِذَا الَّذِي بَيْنَكَ وَبَيْنَهُ عَدَاوَةٌ كَأَنَّهُ وَلِيٌّ حَمِيمٌ - وَمَا يُلَقَّاهَا إِلَّا الَّذِينَ صَبَرُوا وَمَا يُلَقَّاهَا إِلَّا ذُو حَظٍّ عَظِيمٍ﴾ یعنی «اور نیکی اور برائی برابر نہیں ہوتیں، اس سے دفع کرو جو بہتر ہو، پھر وہ جس کے درمیان اور تمہارے درمیان دشمنی ہے گویا وہ گرم جوش دوست ہے۔ اور یہ صرف انہی کو دیا جاتا ہے جنہوں نے صبر کیا اور یہ صرف بڑے نصیب والے کو دیا جاتا ہے» (قرآن فصلت 41:34-35) اور بسا اوقات جس نے ان خیرات میں سے کسی چیز کی تمنا کی، اس کے لیے فاعل کے اجر جیسا ہو جب اس کی نیت سچی ہو، اور اس کے عزم سے پختہ ارادہ کرے کہ اگر وہ اس عمل پر قدرت رکھتا، تو اس جیسا عمل کرتا، جیسا کہ اس سے حدیث ثابت ہے۔ اور خصوصاً جب وہ شروع کرے اور بعض کوشش کرے۔ اور رہا وہ رشک جو محمود نہیں، تو وہ دنیوی مطالب کے حاصل ہونے کی تمنا ہے لذتوں کے لیے، اور شہوتوں کے لینے کے لیے، جیسا کہ اللہ تعالیٰ نے قارون کی قوم سے حکایت کرتے ہوئے فرمایا: ﴿يَا لَيْتَ لَنَا مِثْلَ مَا أُوتِيَ قَارُونُ إِنَّهُ لَذُو حَظٍّ عَظِيمٍ﴾ یعنی «کاش ہمارے لیے بھی اس جیسا ہوتا جو قارون کو دیا گیا، بے شک وہ بڑے نصیب والا ہے» (قرآن القصص 28:79) پس بے شک جو اس جیسے کی تمنا کرے جو برائیاں کرتا ہے تو وہ اپنی نیت سے ہے، اور ان دونوں کا وزر برابر ہے۔ پس اس تفصیل سے ہر حال میں مذموم حسد واضح ہوتا ہے۔ اور وہ حسد جو رشک ہے، جو ایک حال میں محمود ہے، اور ایک حال میں مذموم ہے۔ واللہ اعلم۔"
"89","[AI-translation] عبد اللہ بن مسعود رضی اللہ عنہ سے روایت ہے: «نبی ﷺ دعا کیا کرتے تھے اور فرماتے تھے: اے اللہ! میں تجھ سے ہدایت اور تقویٰ، اور پاک دامنی اور غنا (بے نیازی) کا سوال کرتا ہوں» اسے مسلم نے روایت کیا۔
یہ دعا «اے اللہ! میں تجھ سے ہدایت اور تقویٰ کا سوال کرتا ہوں» سب سے زیادہ جامع اور سب سے زیادہ نفع بخش دعاؤں میں سے ہے۔ یہ دین اور دنیا دونوں کی بھلائی کا سوال اپنے اندر رکھتی ہے، کیونکہ ”ہدایت“ نفع بخش علم ہے، اور ”تقویٰ“ نیک عمل اور اس چیز کو چھوڑ دینا ہے جس سے اللہ اور اس کے رسول ﷺ نے منع کیا ہے۔ اسی سے دین درست ہوتا ہے، کیونکہ دین نفع بخش علوم اور سچی معرفتوں کا نام ہے، یہی ہدایت ہے، اور اللہ اور اس کے رسول کی اطاعت پر قائم رہنا، یہی تقویٰ ہے۔ اور «پاک دامنی اور غنا» مخلوق سے پاک دامنی اور دل کو ان سے وابستہ نہ کرنے کو شامل ہے، اور اللہ کے ساتھ اور اس کے رزق کے ساتھ غنا (بے نیازی)، اور اس پر قناعت، اور کفایت کی وہ مقدار حاصل ہونا جس سے دل کو اطمینان ملے، کو شامل ہے۔ اسی سے دنیوی زندگی کی سعادت اور قلبی راحت مکمل ہوتی ہے، اور یہی پاکیزہ زندگی ہے۔ پس جسے ہدایت و تقویٰ اور پاک دامنی و غنا عطا کر دیا گیا، اس نے دونوں سعادتیں پا لیں، اسے ہر مطلوب چیز حاصل ہو گئی اور وہ ہر خوف والی چیز سے نجات پا گیا۔ اور اللہ بہتر جانتا ہے۔"
"90","[AI-translation] عبد اللہ بن عمرو رضی اللہ عنہما سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «جو شخص یہ چاہے کہ اسے آگ سے دور کر دیا جائے اور جنت میں داخل کر دیا جائے، تو اسے موت اس حال میں آئے کہ وہ اللہ اور آخرت کے دن پر ایمان رکھتا ہو، اور لوگوں کے ساتھ وہ سلوک کرے جو وہ پسند کرتا ہے کہ اس کے ساتھ کیا جائے» اسے مسلم نے روایت کیا۔
اس میں کوئی شک نہیں کہ جو آگ سے دور کر دیا گیا اور جنت میں داخل کر دیا گیا وہی کامیاب ہوا، اور یہ وہ غایت ہے جس کے لیے تمام مومن کوشش کرتے ہیں، پس نبی ﷺ نے اس حدیث میں اس کے دو سبب ذکر فرمائے، جن کی طرف تمام شعبے اور شاخیں لوٹتی ہیں: اللہ اور آخرت کے دن پر ایمان، جو ان اصولوں پر ایمان کو شامل ہے جن کا اللہ نے اپنے اس قول میں ذکر کیا ہے: «کہو: ہم اللہ پر ایمان لائے» (قرآن البقرہ 2:136)، اور آخرت کے لیے عمل کرنے اور اس کے لیے تیاری کو شامل ہے، کیونکہ صحیح ایمان اس کا تقاضا کرتا اور اسے لازم کرتا ہے؛ اور لوگوں کے ساتھ احسان کرنا، اور انہیں قول و فعل اور مال و معاملے میں وہ چیز پہنچانا جو وہ پسند کرتا ہے کہ وہ اس کے ساتھ معاملہ کریں۔ یہی احسان اور خیر خواہی کا صحیح پیمانہ ہے، پس ہر وہ معاملہ جو لوگوں سے برتنے میں تم پر مشتبہ ہو جائے، تو دیکھو کہ کیا تم پسند کرتے ہو کہ تم سے وہ معاملہ کیا جائے یا نہیں؟ پس اگر تم یہ پسند کرتے ہو تو تم ان کے لیے وہی پسند کرتے ہو جو اپنے لیے پسند کرتے ہو، اور اگر تم پسند نہیں کرتے کہ تم سے وہ معاملہ کیا جائے تو تم نے اس عظیم واجب کو ضائع کر دیا۔"
"91","[AI-translation] ابو ہریرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «بے شک اللہ تمھارے لیے تین چیزوں کو پسند کرتا ہے اور تمھارے لیے تین چیزوں کو ناپسند کرتا ہے، پس تمھارے لیے یہ پسند کرتا ہے کہ تم اس کی عبادت کرو اور اس کے ساتھ کسی چیز کو شریک نہ ٹھہراؤ، اور یہ کہ تم سب مل کر اللہ کی رسی کو مضبوطی سے تھامے رکھو اور تفرقہ نہ ڈالو، اور تمھارے لیے ناپسند کرتا ہے: قیل و قال (بے فائدہ باتیں)، کثرتِ سوال، اور مال ضائع کرنا» اسے مسلم نے روایت کیا۔
اس حدیث میں اللہ کے لیے رضا (پسند کرنے) کا اثبات اور اس کے متعلقات کا ذکر ہے، اور اس کی طرف سے کراہت (ناپسند کرنے) کا اثبات اور اس کے متعلقات کا ذکر ہے؛ کیونکہ اللہ تعالیٰ اپنے بندوں پر اپنے کرم سے ان کے لیے وہ چیز پسند کرتا ہے جس میں ان کی دنیا و آخرت میں مصلحت اور سعادت ہے۔ اور وہ یہ ہے کہ وہ اکیلے اللہ کی عبادت قائم کریں جس کا کوئی شریک نہیں، اور اس کے لیے دین کو خالص کریں، اس طرح کہ لوگ ایمان کے عقائد اور اس کے اصولوں، اور اسلام کی ظاہری و باطنی شریعتوں، اور نیک اعمال اور پاکیزہ اخلاق پر قائم ہوں، یہ سب اللہ کے لیے خالص ہو، اس کی مرضی کے موافق ہو، اس کے نبی کی سنت پر ہو، اور وہ اللہ کی رسی کو تھامے رکھیں، اور وہ اس کا دین ہے جو اس کے اور اس کے بندوں کے درمیان واسطہ ہے، پس وہ اس پر مجتمع ہو کر نیکی اور تقویٰ پر ایک دوسرے سے تعاون کرتے ہوئے قائم ہوں: «مسلمان مسلمان کا بھائی ہے، نہ اس پر ظلم کرتا ہے، نہ اسے بے یار و مددگار چھوڑتا ہے، نہ اس سے جھوٹ بولتا ہے، نہ اسے حقیر سمجھتا ہے»، بلکہ وہ اس سے محبت کرنے والا، صاف دل رکھنے والا، اور مددگار بھائی ہو۔ اور اس اصل اور اس سے پہلے والے سے دین مکمل ہوتا ہے، اور مسلمانوں پر نعمت تمام ہوتی ہے، اور اللہ انہیں اس سے عزت دیتا ہے اور ان کی نصرت کرتا ہے، ان تمام وسائل پر ان کے قائم ہونے کی وجہ سے جن کا انہیں اللہ نے حکم دیا اور جو ان کے لیے نصرت و تمکین کی اور فوری و آئندہ فلاح و نجاح کی ضمانت دیتے ہیں جس نے انہیں قائم کیا۔ پھر اس کا ذکر کیا جسے اللہ نے اپنے بندوں کے لیے ناپسند کیا، (قیل و قال) ان امور میں سے جو ان امور کے منافی ہیں جنہیں وہ پسند کرتا ہے اور انہیں توڑنے والے ہیں۔ تو ان میں سے ہے: قیل و قال کی کثرت، کیونکہ وہ جھوٹ اور عدم تثبت اور ناحق اعتقاد کے اسباب میں سے ہے۔ اور فتنوں کے وقوع اور دلوں کے تنافر کے اسباب میں سے ہے، اور نافع امور سے ضرر دینے والے امور میں مشغول ہونے میں سے ہے۔ اور شاید ہی کوئی اس میں سے کسی چیز سے سالم رہے، جب اس کی رغبت قیل و قال میں ہو۔ اور رہا اس کا قول: «اور کثرت سوال» تو یہ مذموم سوال ہے، جیسے بغیر حاجت و ضرورت دنیا کا سوال، اور ہٹ دھرمی اور سختی کے طور پر سوال، اور ان امور کے بارے میں جن کے ضرر کا خوف ہو، یا ان امور کے بارے میں جن میں کوئی نفع نہیں، جو اللہ تعالیٰ کے اس قول میں داخل ہیں: «اے ایمان والو! ایسی چیزوں کے بارے میں نہ پوچھو کہ اگر وہ تم پر ظاہر کر دی جائیں تو تمہیں بری لگیں» (قرآن المائدہ 5:101)۔ اور رہا نافع علوم کے بارے میں استرشاد یا ارشاد کے طور پر سوال، تو یہ محمود ہے جس کا حکم دیا گیا ہے۔ اور اس کا قول: «اور مال ضائع کرنا» اور وہ یا تو اس کی حفاظت چھوڑنے سے ہوتا ہے یہاں تک کہ وہ ضائع ہو جائے، یا چوروں اور ضیاع کا نشانہ بنے، یا اپنی جائیداد کی آبادی کی کوتاہی سے، یا اپنے حیوان پر خرچ سے، یا مال کو ضرر دینے والے امور میں یا غیر نافع میں خرچ کرنے سے ہو۔ تو یہ سب مال ضائع کرنے میں داخل ہے۔ اور یا ناقص عقل والوں کو ان کا والی بنانے سے، جیسے چھوٹے اور بے وقوف اور مجنون اور ان جیسے؛ کیونکہ اللہ تعالیٰ نے مالوں کو لوگوں کے لیے قیام بنایا ہے، ان سے ان کی دینی و دنیوی مصلحتیں قائم ہوتی ہیں، تو اس میں نعمت کا تمام یہ ہے کہ وہ اس میں خرچ کیے جائیں جس کے لیے وہ پیدا کیے گئے: منافع اور شرعی امور میں سے، اور دنیوی منافع میں۔ اور جسے اللہ نے اپنے بندوں کے لیے ناپسند کیا، تو وہ ان سے اس کے ضد کو پسند کرتا ہے، ان سے پسند کرتا ہے کہ وہ جو کچھ کہیں اس میں متثبت ہوں، اور یہ کہ وہ ہر سنی ہوئی بات نقل نہ کریں، اور یہ کہ وہ سچائی کی تلاش کرنے والے ہوں، اور یہ کہ وہ صرف اس کے بارے میں سوال کریں جو نفع دے، اور یہ کہ وہ اپنے مالوں کی حفاظت کریں اور ان کی تدبیر کریں، اور ان میں نافع تصرفات کریں اور انہیں نافع مصارف میں خرچ کریں۔ اور اسی لیے اللہ تعالیٰ نے فرمایا: «اور اپنے وہ مال بے وقوفوں کو نہ دو جنہیں اللہ نے تمہارے لیے قیام بنایا ہے» (قرآن النساء 4:5)۔ اور حمد اللہ کے لیے اول و آخر ہے۔ اور اللہ بہتر جانتا ہے۔"
"92","[AI-translation] عائشہ رضی اللہ عنہا سے روایت ہے، انہوں نے کہا: «ہند بنت عتبہ، جو ابو سفیان کی بیوی تھیں، رسول اللہ ﷺ کے پاس آئیں اور عرض کیا: اے اللہ کے رسول! ابو سفیان بہت بخیل آدمی ہیں، وہ مجھے اتنا خرچ نہیں دیتے جو مجھے اور میرے بچوں کو کافی ہو، سوائے اس کے جو میں ان کے علم کے بغیر ان کے مال سے لے لوں، تو کیا اس میں مجھ پر کوئی گناہ ہے؟ تو رسول اللہ ﷺ نے فرمایا: ان کے مال سے معروف (دستور) کے مطابق اتنا لے لو جو تمھیں اور تمھارے بچوں کو کافی ہو» متفق علیہ ہے۔
علماء نے اس حدیث سے بہت سے فقہی مسائل اخذ کیے ہیں، میں ان میں سے جو مجھے یاد ہیں ان کی طرف اشارہ کروں گا۔ یہ کہ فتویٰ پوچھنے والے اور ظلم کی شکایت کرنے والے کے لیے غیبت کا حکم یہ ہے کہ جس شخص سے فتویٰ یا شکایت کا تعلق ہو اس کے بارے میں سچ بولنا جائز ہے، اور یہ حرام غیبت میں سے نہیں ہے، اور یہ غیبت سے مستثنیٰ صورتوں میں سے ایک ہے، اور ان سب کو غیر کے بارے میں بات کرنے کی حاجت جمع کرتی ہے، کیونکہ حرام غیبت یہ ہے کہ تم اپنے بھائی کا ذکر اس طرح کرو جسے وہ ناپسند کرے، پس جب اس کی حاجت ہو — جیسا کہ ہم نے ذکر کیا، اور جیسے خاص یا عام خیر خواہی میں، یا جب کوئی شخص اپنے لقب کے سوا پہچانا نہ جاتا ہو — تو اتنی مقدار میں یہ جائز ہے جس سے مقصود حاصل ہو جائے۔ اور اسی سے یہ ہے: کہ اولاد کا نفقہ باپ پر واجب ہے، اور وہ اس کے ساتھ خاص ہے، ماں اس میں اس کی شریک نہیں اور نہ کوئی اور۔ اور اسی طرح اس میں ہے: بیوی کے نفقے کا وجوب، اور یہ کہ اس کی مقدار کفایت ہے، کیونکہ آپ ﷺ کے اس قول کی وجہ سے: «ان کے مال سے معروف کے مطابق اتنا لے لو جو تمھیں اور تمھارے بچوں کو کافی ہو» اور یہ کہ کفایت عرف کے اعتبار سے ہے، لوگوں کے احوال کے مطابق: ان کے زمانے اور جگہ، اور ان کی خوشحالی و تنگدستی میں، اور یہ کہ جب خرچ کرنے والا نفقے سے رک جائے یا بخل کرے، اصلاً یا تکمیل میں کمی کرے، تو جس کا نفقہ ہے یا جو خرچ کی ذمہ داری سنبھالے ہوئے ہے وہ اس کے مال سے لے سکتا ہے، اگرچہ اس کے علم کے بغیر ہو، اور یہ اس لیے کہ سبب ظاہر ہے، اور اس حالت میں اسے خیانت نہیں کہا جائے گا، پس وہ آپ ﷺ کے اس قول میں داخل نہیں ہوتا: «جو تم سے خیانت کرے تم اس سے خیانت نہ کرو»۔ اور یہی اس مسئلے میں درمیانہ اور صحیح قول ہے کہ جس شخص پر کسی کا حق ہو اس کے مال سے اس کے علم کے بغیر اپنے حق کی مقدار میں لینا، اور یہ امام احمد کے مذہب کا مشہور قول ہے کہ یہ جائز نہیں، مگر جب سبب ظاہر ہو، جیسے بیوی اور اولاد اور غلاموں وغیرہ پر نفقہ، اور جیسے مہمان کا حق۔ اور اسی سے یہ ہے کہ جو شخص کسی معاملے کا ذمہ دار ہو جس میں مالی تخمینے کی حاجت ہو تو تخمینے میں اس کا قول قبول کیا جائے گا؛ کیونکہ وہ امانت دار ہے، اس چیز پر اسے ولایت حاصل ہے۔ اور اسی سے یہ ہے کہ جب کسی فتوے کا تعلق غیر سے ہو اور پوچھے گئے شخص کے غالب گمان میں پوچھنے والا سچا ہو تو اس غیر کو حاضر کرنے کی حاجت نہیں، خاص طور پر جب اس میں کوئی فساد ہو، جیسا کہ اس مقدمے میں ہے، کیونکہ اگر اس شکایت کے لیے ابو سفیان کو حاضر کیا جاتا تو مامون نہ ہوتا کہ اس کے اور اس کی بیوی کے درمیان کوئی نامناسب بات واقع ہو جائے۔ اور اس میں غائب کے خلاف فیصلے پر کوئی دلالت نہیں، کیونکہ یہ حکم نہیں ہے، بلکہ یہ فتویٰ پوچھنا ہے۔ اور اللہ بہتر جانتا ہے۔"
"93","[AI-translation] ابو بکرہ رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: میں نے رسول اللہ ﷺ کو فرماتے ہوئے سنا: «کوئی شخص دو آدمیوں کے درمیان اس حال میں فیصلہ نہ کرے کہ وہ غصے میں ہو» متفق علیہ ہے۔
«کوئی شخص دو آدمیوں کے درمیان اس حال میں فیصلہ نہ کرے کہ وہ غصے میں ہو» یہ حدیث کئی امور پر دلالت کرتی ہے: پہلا: لوگوں کے درمیان فیصلہ کرنے والے کو منع کیا گیا ہے کہ وہ دو افراد کے درمیان کسی معین مقدمے میں اس حال میں فیصلہ کرے کہ وہ غصے میں ہو، چاہے وہ دینی مقدمات ہوں یا دنیوی۔ اور یہ اس وجہ سے ہے کہ غصے میں فکر بدل جاتی ہے اور منحرف ہو جاتی ہے۔ اور فکر کا یہ انحراف حق کو حاضر کرنے میں نقصان دیتا ہے، اور حق کے قصد میں بھی نقصان دیتا ہے، اور حاکم اور اس کے علاوہ ہر شخص کا اصل فرض یہ ہے: علم اور عمل میں حق کا قصد کرنا۔ دوسرا: اس سے دلالت ملتی ہے کہ اسے ان اسباب کو اختیار کرنے میں کوشش کرنی چاہیے جو غصے کو دور کریں یا اسے ہلکا کریں: حلم اور صبر کا اخلاق اپنانے سے، اور نفس کو اس چیز پر تیار رکھنے سے جو اسے پہنچے اور جو وہ فریقین سے سنے: کیونکہ یہ غصے کو دور کرنے یا ہلکا کرنے پر بڑی مدد ہے۔ تیسرا: اس تعلیل سے یہ لیا جاتا ہے کہ ہر وہ چیز جو انسان کو حق کی معرفت یا اس کے قصد سے روکے تو اس کا حکم غصے کے حکم جیسا ہے۔ اور وہ جیسے شدید فکر، اور بھوک و پیاس، اور پیشاب یا پاخانے کا دباؤ یا اس جیسی چیزیں، جن سے فکر اسی طرح یا غصے سے زیادہ مشغول ہوتی ہے۔ چوتھا: غصے اور اس جیسی حالت میں فیصلہ کرنے کی ممانعت مقصود لذاتہ نہیں ہے۔ بلکہ یہ ہے کہ حاکم کو چاہیے کہ وہ فیصلہ نہ کرے یہاں تک کہ وہ شرعی کلی حکم کا اور جزوی مقدمے کا تمام پہلوؤں سے مکمل علم حاصل کر لے، اور خوب سمجھے کہ اسے شرعی حکم پر کیسے منطبق کرے، کیونکہ حاکم ان تین امور کا محتاج ہے: پہلا: شرعی طریقوں کا علم جو شریعت نے جھگڑوں کے فیصلے اور لوگوں کے درمیان حکم کے لیے مقرر کیے ہیں۔ دوسرا: یہ کہ وہ فریقین کے درمیان جھگڑے کو سمجھے اور اس کا مکمل تصور قائم کرے، اور ہر ایک کو اپنی دلیل پیش کرنے دے، اور اپنے مقدمے کی مکمل وضاحت کرنے دے۔ پھر جب وہ اس کی تحقیق کر لے اور اس کا مکمل احاطہ کر لے تو تیسرے امر کا محتاج ہوتا ہے: اور وہ اسے شرعی احکام پر منطبق کرنے اور داخل کرنے کی صفت ہے، پس جب اسے ان تین امور کی توفیق مل جائے اور وہ عدل کا قصد کرے تو اسے توفیق مل جاتی ہے اور اس کی طرف ہدایت پاتا ہے۔ اور جب ان میں سے ایک بھی فوت ہو جائے تو غلطی واقع ہوتی ہے اور حکم خراب ہو جاتا ہے۔ اور اللہ بہتر جانتا ہے۔"
"94","[AI-translation] عمرو بن شعیب سے، وہ اپنے والد سے، وہ اپنے دادا سے روایت کرتے ہیں، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «کھاؤ اور پیو، اور پہنو اور صدقہ کرو، بغیر اسراف اور بغیر تکبر کے» اسے احمد اور ابو داود نے روایت کیا، اور بخاری نے اسے تعلیقاً نقل کیا۔
یہ حدیث دین اور دنیا میں نفع بخش امور میں مال کے استعمال اور نقصان دہ امور سے بچنے پر مشتمل ہے۔ اور وہ اس طرح کہ اللہ تعالیٰ نے مال کو بندوں کے لیے قیام کا ذریعہ بنایا ہے، اس سے ان کے خاص اور عام، دینی اور دنیوی حالات قائم رہتے ہیں۔ اور اللہ اور اس کے رسول نے اس میں — اس کے حاصل کرنے اور استعمال کرنے، اور اس کی تدبیر اور خرچ کرنے میں — بہترین اور سب سے زیادہ نفع بخش طریقوں کی طرف رہنمائی کی ہے، جن کا انجام بہترین ہو: حال میں اور مستقبل میں۔ اس میں اس کے حصول کے لیے مباح اور نفع بخش اسباب کے ذریعے کوشش کی رہنمائی کی گئی، اور یہ کہ طلب خوبصورت ہو، اس کے ساتھ نہ سستی ہو نہ کمزوری، اور نہ اس کے حصول میں ایسا انہماک ہو جو انسان کی حالت میں خلل ڈالے، اور یہ کہ حرام اور گھٹیا کمائیوں سے بچا جائے، پھر جب کمائی حاصل ہو جائے تو انسان اس کی حفاظت اور معروف میں استعمال کی کوشش کرے، کھانے پینے اور لباس میں، اور جن چیزوں کی حاجت ہو، وہ خود اور جو اس سے وابستہ ہوں بیوی اور اولاد وغیرہ میں سے، بغیر کنجوسی اور بغیر فضول خرچی کے۔ اور اسی طرح جب وہ اسے غیر کے لیے نکالے تو اسے ان طریقوں میں نکالے جو اسے نفع دیں، اور جن کا ثواب اور خیر اس کے لیے باقی رہے، جیسے محتاج رشتہ داروں اور پڑوسیوں وغیرہ پر صدقہ، اور جیسے ہدیہ اور دعوتیں جن کا عرف جاری ہو۔ اور یہ سب اسراف سے بچنے اور فخر و تکبر کے قصد سے بچنے کے ساتھ معلق ہے، جیسا کہ اس حدیث میں قید لگائی گئی، اور جیسا کہ اللہ تعالیٰ کے اس قول میں ہے: «اور وہ لوگ کہ جب وہ خرچ کرتے ہیں تو نہ اسراف کرتے ہیں اور نہ بخل کرتے ہیں، اور اس کے درمیان اعتدال پر رہتے ہیں» (قرآن الفرقان 25:67) پس مال کی تدبیر میں یہی عدل ہے: کہ وہ بخل اور فضول خرچی کے دونوں درجوں کے درمیان قوام (اعتدال) ہو، اور اسی سے معاملات قائم رہتے اور مکمل ہوتے ہیں۔ اور اس کے سوا جو کچھ ہے وہ گناہ اور نقصان ہے، اور عقل و حال میں کمی ہے۔ اور اللہ بہتر جانتا ہے۔"
"95","[AI-translation] ابو ذر رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: «عرض کیا گیا: اے اللہ کے رسول! آپ اس شخص کے بارے میں کیا فرماتے ہیں جو نیکی کا کوئی عمل کرتا ہے اور لوگ اس پر اس کی تعریف کرتے ہیں — یا (راوی نے کہا:) اس سے محبت کرتے ہیں؟ آپ نے فرمایا: یہ مومن کی فوری بشارت ہے» اسے مسلم نے روایت کیا۔
آپ ﷺ نے اس حدیث میں خبر دی کہ قابلِ تعریف اعمال کے فوری آثار بشارت میں سے ہیں؛ کیونکہ اللہ نے اپنے اولیاء — اور وہ مومن متقی ہیں — سے اس دنیا کی زندگی میں اور آخرت میں بشارت کا وعدہ کیا ہے۔ اور ”بشارت“ وہ خوش کن خبر یا معاملہ ہے جس سے بندہ اپنے اچھے انجام کو پہچانتا ہے، اور یہ کہ وہ سعادت والوں میں سے ہے، اور یہ کہ اس کا عمل مقبول ہے۔ رہی آخرت میں بشارت تو وہ اللہ کی رضا اور اس کے ثواب کی بشارت ہے، اور اس کے غضب و عقاب سے نجات کی، موت کے وقت اور قبر میں اور بعث کی طرف اٹھنے کے وقت، اللہ اپنے مومن بندے کے لیے ان مقامات میں فرشتوں کے ہاتھوں بشارت بھیجتا ہے، جیسا اس سے کتاب و سنت کی نصوص کثرت سے آئی ہیں، اور وہ معروف ہیں۔ اور رہی دنیا میں بشارت جسے اللہ مومنوں کے لیے اپنے فضل کا نمونہ اور اس کی تعجیل بناتا ہے اور اس سے ان کا تعارف اور اس سے انہیں اعمال پر نشاط دلاتا ہے، تو اس کی اعم یہ ہے کہ انہیں خیر کی توفیق دے اور انہیں شر سے محفوظ رکھے، جیسا آپ ﷺ نے فرمایا: «رہے سعادت والے تو وہ سعادت والوں کے عمل کے لیے آسان کیے جاتے ہیں»۔ تو جب بندہ خیر کے اعمال کو اپنے لیے آسان پائے، اپنے لیے سہل کیے گئے، اور اپنے نفس کو اللہ کی حفاظت سے ان اعمال سے محفوظ پائے جو اسے ضرر دیں، تو یہ اس بشارت میں سے تھی جس سے مومن اپنے معاملے کے انجام پر استدلال کرتا ہے، کیونکہ اللہ اکرم الاکرمین اور اجود الاجودین ہے۔ اور جب وہ اپنے بندے سے احسان کا آغاز کرے تو اسے تمام کرتا ہے۔ تو سب سے عظیم منت اور احسان جس سے وہ اس پر منت رکھے اس کا دینی احسان ہے، تو مومن اس سے اکمل سرور سے مسرور ہوتا ہے: اللہ کی اس پر خیر کے اعمال اور ان کے آسان کرنے کی منت سے سرور؛ کیونکہ ایمان کی سب سے بڑی علامتوں میں سے خیر کی محبت اور اس میں رغبت اور اس کے فعل سے سرور ہے۔ اور دوسرا سرور اس کی شدید طمع سے کہ اللہ اس پر اپنی نعمت تمام کرے اور اس کا فضل دائم رہے۔ اور اس میں سے ہے جو نبی ﷺ نے اس حدیث میں ذکر کیا: جب بندہ خیر کے اعمال میں سے کوئی عمل کرے ـ اور خصوصاً صالح آثار اور عام نفع والے خیریہ منصوبے ـ اور اس پر لوگوں کی اس سے محبت اور اس پر ان کی ثنا اور اس کے لیے ان کی دعا مرتب ہو ـ تو یہ اس بشارت میں سے تھا کہ یہ عمل مقبول اعمال میں سے ہے، جن میں اللہ نے خیر و برکت رکھی ہے۔ اور اس دنیا کی زندگی میں بشارت میں سے ہے، بندے سے مومنوں کی محبت، اس کے لیے اللہ تعالیٰ کا قول: «بے شک جو ایمان لائے اور انہوں نے نیک اعمال کیے تو رحمن ان کے لیے محبت بنائے گا» (قرآن مریم 19:96) یعنی ان سے اس کی محبت اور بندوں کے دلوں میں ان کی محبت ڈالنا۔ اور اس میں سے ہے اچھی ثنا، کیونکہ بندے پر مومنوں کی کثرت ثنا ان کی طرف سے اس کے لیے شہادت ہے۔ اور مومن زمین میں اللہ کے گواہ ہیں۔ اور اس میں سے ہے صالح خواب جسے مومن دیکھے یا اس کے لیے دیکھا جائے، کیونکہ صالح خواب مبشرات میں سے ہے۔ اور بشارت میں سے ہے کہ اللہ بندے پر ایسی تقدیر کرے جسے وہ پسند کرے یا ناپسند کرے۔ اور اس تقدیر کو اس کے دین کی اصلاح اور شر سے اس کی سلامتی کا وسیلہ بنائے۔ اور باری سبحانہ کے لطف کی انواع شمار نہیں کی جا سکتیں اور نہ خیال میں آتی ہیں اور نہ وہم میں گھومتی ہیں۔ اور اللہ بہتر جانتا ہے۔"
"96","[AI-translation] عبد اللہ بن عمرو رضی اللہ عنہما سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «اللہ کی رضا والدین کی رضا میں ہے، اور اللہ کی ناراضی والدین کی ناراضی میں ہے» اسے ترمذی نے روایت کیا۔
اور ابن حبان اور حاکم نے اسے صحیح قرار دیا۔ یہ حدیث والدین کے ساتھ نیکی کے فضل اور اس کے وجوب پر دلیل ہے، اور یہ کہ وہ اللہ تعالیٰ کی رضا کا سبب ہے۔ اور والدین کی نافرمانی سے ڈرانے اور اس کی حرمت پر دلیل ہے، اور یہ کہ وہ اللہ کی ناراضی کا سبب ہے۔ اور اس میں کوئی شک نہیں کہ یہ والدین اور اولاد پر اللہ کی رحمت میں سے ہے؛ کیونکہ والدین اور ان کی اولاد کے درمیان ایسا تعلق ہے جس جیسی کوئی چیز نہیں، کوئی اور رشتہ اور مضبوط وابستگی اور والدین کا وہ احسان جس کے برابر مخلوق میں سے کسی کا احسان نہیں۔ اور متنوع تربیت اور اولاد کی دینی و دنیوی حاجت اس تاکید والے حق کو ادا کرنے کی ہے، حق کی ادائیگی کے طور پر، اور ثواب حاصل کرنے کے لیے، اور اپنی ذریت کو یہ سکھانے کے لیے کہ وہ ان سے ویسا معاملہ کریں جیسا انہوں نے اپنے والدین سے کیا۔ یہ اسباب اور جو ان سے شاخیں نکلتی ہیں اللہ کی رضا کو ان کی رضا کے ساتھ جوڑنے کا موجب ہیں۔ اور اس کا برعکس اس کے برعکس ہے۔ اور جب کہا جائے: وہ نیکی کیا ہے جس کا اللہ اور اس کے رسول نے حکم دیا ہے؟ تو کہا جائے گا: اللہ اور اس کے رسول نے اس کی معروف حد مقرر کی ہے، اور ایسی تفسیر کی ہے جسے ہر شخص سمجھتا ہے۔ پس اللہ تعالیٰ نے ان سے احسان کا مطلق حکم دیا۔ اور کچھ مثالوں کا ذکر کیا جو احسان کا نمونہ ہیں۔ پس ہر قولی یا فعلی یا بدنی احسان، والدین اور اولاد کے احوال اور وقت اور جگہ کے مطابق، یہی نیکی ہے۔ اور اس حدیث میں: نیکی کی غایت اور انتہا کا ذکر ہے جو والدین کی رضا ہے: پس احسان موجب اور سبب ہے، اور رضا اثر اور مسبب ہے۔ پس ہر وہ چیز جو والدین کو راضی کرے، عرفی معاملات کی تمام اقسام میں سے، اور ہر اس راستے اور وسیلے پر چلنا جو انہیں راضی کرے، وہ نیکی میں داخل ہے، جیسا کہ نافرمانی: ہر وہ چیز ہے جو انہیں ناراض کرے، قول سے ہو یا فعل سے۔ لیکن وہ اطاعت کے ساتھ مقید ہے، معصیت کے ساتھ نہیں۔ پس جب اولاد کے لیے والدین کو راضی کرنا اللہ کو ناراض کیے بغیر ممکن نہ ہو تو والدین کی محبت پر اللہ کی محبت کو مقدم کرنا واجب ہے، اور ملامت اور قصور والدین کا ہوگا، وہ اپنے سوا کسی کو ملامت نہ کریں۔ اور اس حدیث میں: اللہ کے لیے رضا اور ناراضی کی صفت کا اثبات ہے، اور یہ کہ وہ اس کی محبوب اور پسندیدہ چیزوں سے متعلق ہے۔ پس اللہ تعالیٰ اپنے اولیاء اور برگزیدوں سے محبت کرتا ہے اور اس سے محبت کرتا ہے جو اس کی اور اس کے رسول کی اطاعت پر قائم ہو، اور یہ اس کے کمال اور حکمت اور حمد اور رحمت میں سے ہے۔ اور اس کی رضا اور ناراضی اس کی مشیت اور قدرت سے متعلق صفات میں سے ہیں۔ اور اس میں عصمت یہ ہے: کہ مومن پر واجب ہے کہ وہ اس چیز کو ثابت کرے جو اللہ نے اپنے لیے ثابت کی ہے اور اس کے رسول نے اس کے لیے ثابت کی ہے، کمال کی ذاتی اور فعلی صفات میں سے، اس انداز میں جو اللہ کی عظمت اور کبریائی اور بزرگی کے لائق ہو، اور وہ جانے کہ اللہ کا کوئی ہمسر نہیں، نہ کوئی کفو، نہ کوئی مثال، اس کی ذات اور اسماء میں، اور اس کی صفات و افعال میں۔ اور اللہ بہتر جانتا ہے۔"
"97","[AI-translation] انس بن مالک رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «تین چیزیں ایسی ہیں جن پر مسلمان کا دل خیانت (کینہ) نہیں رکھتا: عمل کو اللہ کے لیے خالص کرنا، حکمرانوں کی خیر خواہی کرنا، اور مسلمانوں کی جماعت سے وابستہ رہنا، کیونکہ ان کی دعا ان کے پیچھے سے انہیں گھیرے رکھتی ہے» اسے ترمذی اور شافعی وغیرہ نے روایت کیا۔
شیخ شمس الدین ابن القیم نے کہا: یعنی ان تین چیزوں پر مسلمان کا دل غل (کینہ و خیانت) نہیں رکھتا اور نہ ان کے ساتھ غل اٹھاتا ہے، بلکہ وہ اس سے غل کو دور کرتی ہیں، اور اسے اس سے پاک کرتی ہیں، اور اس سے نکال دیتی ہیں، کیونکہ دل شرک پر سب سے بڑا غل رکھتا ہے۔ اور اسی طرح وہ دھوکے پر، اور بدعت و گمراہی کے ذریعے مسلمانوں کی جماعت سے نکلنے پر غل رکھتا ہے۔ پس یہ تین چیزیں اسے غل اور فساد سے بھر دیتی ہیں۔ اور اس غل کا علاج اور اس کے فاسد مادوں کو نکالنا، اخلاص اور خیر خواہی کو خالص کرنے، اور سنت کی پیروی سے ہے۔ انتہی۔ یعنی پس جس نے اپنے تمام اعمال اللہ کے لیے خالص کر لیے، اور اپنے تمام امور میں اللہ کے بندوں کے لیے خیر خواہی کی، اور اتفاق کے ساتھ اور اختلاف نہ کرتے ہوئے جماعت سے وابستہ رہا، اور اس کا دل صاف ستھرا ہو گیا، تو وہ اللہ کا ولی بن گیا، اور جو اس کے برخلاف ہو، اس کا دل ہر آفت اور شر سے بھر گیا، اور اللہ بہتر جانتا ہے۔"
"98","[AI-translation] عبد اللہ بن عمر رضی اللہ عنہما سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «لوگ سو اونٹوں کی مانند ہیں، تم ان میں تقریباً کوئی سواری کے قابل اونٹنی نہ پاؤ گے» متفق علیہ ہے۔
یہ حدیث سچی خبر اور نفع بخش رہنمائی پر مشتمل ہے۔ رہی خبر، تو وہ یہ کہ آپ ﷺ نے خبر دی کہ نقص اکثر لوگوں کو شامل ہے، اور ان میں کامل — یا کمال کے قریب — کم ہے، جیسے سو اونٹ، تم انہیں بہت سمجھتے ہو، پھر جب تم ان میں سے سواری کے قابل اونٹنی چاہو جو بوجھ اٹھانے اور سواری اور جانے آنے کے قابل ہو، تو تم اسے تقریباً نہ پاؤ گے، اور اسی طرح لوگ بہت ہیں، پھر جب تم ان میں سے منتخب کرنا چاہو جو تعلیم یا فتویٰ یا امامت، یا بڑی یا چھوٹی حکمرانیوں، یا اہم ذمہ داریوں کے قابل ہو، تو تم تقریباً اسے نہ پاؤ گے جو اس ذمہ داری کو اچھے طریقے سے ادا کرے، اور یہی واقعہ ہے، کیونکہ انسان بڑا ظالم اور جاہل ہے، اور ظلم اور جہالت نقائص کا سبب ہیں، اور وہ کمال اور تکمیل سے روکنے والے ہیں۔ اور رہی رہنمائی، تو اس خبر کا مضمون آپ ﷺ کی طرف سے رہنمائی ہے کہ امت کے مجموعے کو چاہیے کہ وہ کوشش کریں، اور ان مردوں کو تیار کرنے میں محنت کریں جو اہم ذمہ داریوں، اور عام نفع والے کلی امور کو سنبھالنے کے قابل ہوں۔ اور اللہ نے اس معنی کی طرف اپنے اس قول میں رہنمائی کی ہے: «تو کیوں نہ نکلا ان میں سے ہر گروہ میں سے ایک حصہ، تاکہ وہ دین میں سمجھ حاصل کریں اور اپنی قوم کو ڈرائیں جب وہ ان کی طرف لوٹیں» (قرآن التوبہ 9:122) پس جہاد کا حکم دیا، اور یہ کہ اسے کافی جماعت ادا کرے، اور یہ کہ علم کے لیے دوسری جماعت آگے بڑھے، تاکہ یہ ان کی مدد کریں اور وہ ان کی، اور ولایتوں اور تقرری کا اس کا حکم دینا، اس کا اور اس چیز کا حکم دینا ہے جس کے بغیر وہ شرائط اور تکمیلات سے مکمل نہیں ہوتیں۔ پس دینی و دنیوی ذمہ داریاں، اور کلی اعمال، لوگوں کے لیے ناگزیر ہیں اور ان کی مصلحت ان کے بغیر مکمل نہیں ہوتی، اور وہ اس کے بغیر مکمل نہیں ہوتیں کہ انہیں اہل اور امانت دار لوگ سنبھالیں، اور یہ استطاعت کے مطابق ان اوصاف کے حاصل کرنے کی کوشش کا تقاضا کرتا ہے۔ اللہ تعالیٰ نے فرمایا: «پس اللہ سے ڈرو جتنی تم استطاعت رکھتے ہو» (قرآن التغابن 64:16) اور اللہ بہتر جانتا ہے۔"
"99","[AI-translation] انس بن مالک رضی اللہ عنہ سے روایت ہے، انہوں نے کہا: رسول اللہ ﷺ نے فرمایا: «لوگوں پر ایک ایسا زمانہ آئے گا کہ اپنے دین پر مضبوطی سے قائم رہنے والا ایسا ہوگا جیسے انگارے کو مٹھی میں پکڑنے والا» اسے ترمذی نے روایت کیا۔
اور یہ حدیث بھی خبر اور رہنمائی کا تقاضا کرتی ہے۔ رہی خبر، تو وہ یہ کہ آپ ﷺ نے خبر دی کہ آخر زمانے میں خیر اور اس کے اسباب کم ہو جائیں گے، اور شر اور اس کے اسباب زیادہ ہو جائیں گے، اور اس وقت دین پر قائم رہنے والے لوگ بہت ہی کم ہوں گے، اور یہ کم تعداد سخت شدت اور عظیم مشقت کی حالت میں ہوگی، جیسے انگارے کو پکڑنے والے کی حالت، مخالفوں کی قوت کی وجہ سے، اور گمراہ کرنے والے فتنوں کی کثرت کی وجہ سے، شبہات اور شکوک اور الحاد کے فتنے، اور خواہشات کے فتنے اور مخلوق کا دنیا کی طرف مائل ہونا اور اس میں انہماک، ظاہر اور باطن میں، اور ایمان کی کمزوری، اور مددگار اور معاون کی کمی کی وجہ سے سخت تنہائی۔ لیکن اپنے دین پر قائم رہنے والا، ان مخالفتوں اور رکاوٹوں کو دور کرنے پر قائم رہنے والا جن پر بصیرت اور یقین والے اور مضبوط ایمان والے ہی جم سکتے ہیں، مخلوق میں سب سے بہتر ہے، اور اللہ کے نزدیک سب سے بلند درجے والا، اور اس کے نزدیک سب سے بڑی قدر والا ہے۔ اور رہی رہنمائی، تو وہ اس کی امت کے لیے رہنمائی ہے کہ وہ اپنے آپ کو اس حالت پر تیار رکھیں، اور جانیں کہ یہ ناگزیر ہے، اور یہ کہ جو ان رکاوٹوں میں گھس گیا، اور اپنے دین اور ایمان پر صبر کیا — ان مخالفتوں کے ساتھ — تو اس کے لیے اللہ کے نزدیک اعلیٰ درجات ہیں، اور اس کا مولا اس چیز پر اس کی مدد کرے گا جسے وہ پسند کرتا اور چاہتا ہے، کیونکہ مدد مؤنے (بوجھ) کے بقدر ہوتی ہے۔ اور ہمارا یہ زمانہ اس وصف سے کتنا مشابہ ہے جو آپ ﷺ نے ذکر فرمایا، کیونکہ اسلام میں اس کے نام کے سوا کچھ باقی نہیں رہا، اور نہ قرآن میں اس کے نقش کے سوا، ایمان کمزور ہے، اور دل منتشر ہیں، اور حکومتیں بکھری ہوئی ہیں، اور دشمنیاں اور بغض جنہوں نے مسلمانوں کے درمیان دوری ڈال دی، اور ظاہری اور باطنی دشمن، جو دین کو ختم کرنے کے لیے چھپ کر اور کھل کر کام کر رہے ہیں، اور الحاد اور مادیت، جس نے اپنی خبیث دھارے اور ٹھاٹھیں مارتی موجوں سے بوڑھوں اور نوجوانوں کو بہا لیا، اور اخلاق کے فساد کی طرف دعوتیں، اور باقی ماندہ رمق کو ختم کرنے کی دعوتیں۔ پھر لوگوں کا دنیا کی زینتوں کی طرف مائل ہونا، یہاں تک کہ وہی ان کے علم کی انتہا بن گئیں، اور ان کی سب سے بڑی فکر، اور اسی کے لیے وہ راضی ہوتے اور ناراض ہوتے ہیں، اور آخرت سے بے رغبتی کی خبیث دعوت، اور مکمل طور پر دنیا کو آباد کرنے پر مائل ہونا، اور دین کو تباہ کرنا اور اسے حقیر سمجھنا اور اس کے اہل کا اور ہر اس چیز کا مذاق اڑانا جو اس کی طرف منسوب ہو، اور فخر و خود نمائی، اور الحاد پر مبنی تمدنوں کے ساتھ تکبر جن کے آثار اور چنگاریوں اور شرور کو بندوں نے دیکھ لیا ہے۔ پس ان جمع شدہ شرور کے ساتھ، اور ٹھاٹھیں مارتی موجوں، اور گھیرنے والی پریشانیوں، اور حاضر اور آنے والے تاریک فتنوں کے ساتھ — ان امور اور ان کے علاوہ کے ساتھ — تم اس حدیث کا مصداق پاتے ہو۔ لیکن اس کے باوجود، مومن اللہ کی رحمت سے ناامید نہیں ہوتا، اور نہ اللہ کے فضل سے مایوس ہوتا ہے، اور نہ اس کی نظر ظاہری اسباب تک محدود ہوتی ہے، بلکہ اس کا دل ہر وقت اسباب کے پیدا کرنے والے، کریم عطا کرنے والے کی طرف متوجہ رہتا ہے، اور کشادگی اس کی آنکھوں کے سامنے ہوتی ہے، اور اس کا وہ وعدہ جس کی وہ خلاف ورزی نہیں کرتا کہ وہ اس کے لیے تنگی کے بعد آسانی پیدا کرے گا، اور یہ کہ کشادگی تکلیف کے ساتھ ہے، اور یہ کہ تکلیفوں کا دور ہونا سخت تکلیفوں اور ہولناک امور کے آنے کے ساتھ ہے۔ پس مومن وہ ہے جو ان حالات میں کہتا ہے: ”لا حول ولا قوۃ الا باللہ“ اور ”حسبنا اللہ ونعم الوکیل۔ علی اللہ توکلنا۔ اللھم لک الحمد، والیک المشتکی۔ وانت المستعان۔ وبک المستغاث۔ ولا حول ولا قوۃ الا باللہ العلی العظیم“ اور ایمان اور خیر خواہی اور دعوت میں سے جتنا وہ کر سکتا ہے ادا کرتا ہے۔ اور تھوڑے پر قناعت کرتا ہے، جب زیادہ ممکن نہ ہو۔ اور بعض شر کے زائل ہونے اور ہلکا ہونے پر، جب اس کے سوا کوئی چارہ نہ ہو: «اور جو اللہ سے ڈرے گا وہ اس کے لیے نکلنے کا راستہ بنا دے گا — اور جو اللہ پر بھروسا کرے گا تو وہ اسے کافی ہے — اور جو اللہ سے ڈرے گا وہ اس کے معاملے میں آسانی پیدا کر دے گا» (قرآن الطلاق 65:2-4) اور تمام تعریف اللہ کے لیے ہے جس کی نعمت سے نیک اعمال مکمل ہوتے ہیں، اور محمد اور ان کی آل اور ان کے اصحاب اور قیامت کے دن تک ان کے پیروکاروں پر اللہ کی رحمت ہو۔ خاتمہ۔ یہ رسالہ مکمل ہوا جو نبی ﷺ کی جامع احادیث میں سے ننانوے احادیث کی شرح پر مشتمل ہے، علوم کی اقسام میں، اور نفع بخش موضوعات، اور صحیح عقائد، اور کریم اخلاق، اور فقہ و آداب، اور شامل اصلاحات، اور عام فوائد میں۔ یہ اس کے مرتب نے کہا: عبد الرحمن بن ناصر بن عبد اللہ آل سعدی۔ اللہ انہیں اور ان کے والدین اور ان کے والدین کو، اور تمام مسلمانوں کو بخشے۔ اور وہ اس سے دس شعبان سن ایک ہزار تین سو اکہتر ہجری میں فارغ ہوئے۔ اور اللہ تعالیٰ کی مدد اور آسانی سے مصنف کے خط سے اسے نقل کرنے سے فراغت 27 رمضان سن 1371ھ میں ہوئی، اللہ کے فضل کے محتاج فقیر، عبد اللہ بن سلیمان آل عبد اللہ السلمان کے قلم سے۔ اللہ انہیں اور ان کے والدین اور ان کے والدین کو اور تمام مسلمانوں کو بخشے۔ یہ ایک قیمتی موتی ہے، اور ایک سرسبز باغ ہے، وہ راغبوں کی مطلوب چیز ہے، اور فائدہ اٹھانے والوں کی سیرگاہ، اور دیکھنے والوں کی بہجت ہے، اس خوش نما ظاہر کی وجہ سے جس میں وہ ظاہر ہوا، اور معارف و تحقیق کے پھولوں سے جس سے وہ آراستہ ہوا، اور ان عظیم فوائد کی وجہ سے جو اس میں رکھے گئے، جن کا چننا آسان ہے، اور قریب پھلوں کی وجہ سے جن کا ذائقہ خوشگوار ہے، اور میٹھے چشموں کی وجہ سے جن کا گھاٹ خوشگوار ہے، کیونکہ وہ نفع بخش عقائد کے بیان پر، اور جامع اصولوں، اور متنوع احکام، اور بلند آداب، اور اہم موضوعات اور کثیر علوم کے علاوہ پر مشتمل ہے، جو انسان کو ہدایت اور رشد عطا کرتے ہیں، اور اس کی بصیرت اور یقین میں اضافہ کرتے ہیں۔ اور تمھارے لیے اس سے یہی کافی ہے کہ وہ اس کلام کی شرح ہے جو اللہ کے کلام کے بعد سب سے اشرف کلام ہے اور خیر کو سب سے زیادہ جمع کرنے والا اور سب سے زیادہ نفع بخش ہے، مخلوق میں سب سے زیادہ علم والے اور سب سے زیادہ فصیح، محمد ﷺ کے کلام کی۔ اور ان کے شریف مقاصد اور قیمتی خزانوں کی وضاحت ہے، جسے فاضل شیخ عبد الرحمن بن ناصر السعدی پیش کرتے ہیں، اللہ انہیں اسلام اور اس کے اہل کی طرف سے بہترین جزا دے، اور ان کی تحقیق کے سورج ہمیشہ چمکتے رہیں، اور ان کے علوم کے بیج روشن رہیں۔"
