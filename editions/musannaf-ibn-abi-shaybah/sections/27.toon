hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"26053","(۲۶۰۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَوْنٍ ، قَالَ : وَقَعَ رَجُلٌ فِی رَجُلٍ فَرَدَّ عَلَیْہِ آخَرُ فَقَالَتْ أُمُّ الدَّرْدَائِ : لَقَدْ غَبَطْتُک ، إِنَّہُ مَنْ ذَبَّ عَنْ عِرْضِ أَخِیہِ ، وَقَاہُ اللَّہُ ، قَالَ مِسْعَرٌ : نَفْحَ ، أَوْ لَفْحَ النَّارِ۔","","Musannaf Ibn Abi Shaybah 26053","","","كتاب الأدب"
"26054","(۲۶۰۵۴) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : إذَا قُلْتَ مَا فِی الرَّجُلِ فَلَمْ تُزَکِّہِ۔","","Musannaf Ibn Abi Shaybah 26054","","","كتاب الأدب"
"26055","(۲۶۰۵۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنْ أُسَامَۃَ بْنِ شَرِیکٍ ، قَالَ : شَہِدْت الأَعْرَابَ یَسْأَلُونَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلَیْنَا حَرَجٌ فِی کَذَا وَکَذَا ؟ فَقَالَ : عِبَادَ اللہِ ، وَضَعَ اللَّہُ الْحَرَجَ إلاَّ مَنِ اقْتَرَضَ مِنْ عِرْضِ أَخِیہِ شَیْئًا فَذَلِکَ الَّذِی حَرَجٌ۔","Sahih","Musannaf Ibn Abi Shaybah 26055","","","كتاب الأدب"
"26056","(۲۶۰۵۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : لَوْ رَأَیْت أَقْطَعَ فَذَکَرْتہ فَقُلْت الأَقْطَعُ کَانَتْ غِیبَۃً ، قَالَ : فَذَکَرْتہ لأَبِی إِسْحَاقَ فَقَالَ : صَدَقَ۔","","Musannaf Ibn Abi Shaybah 26056","","","كتاب الأدب"
"26057","(۲۶۰۵۷) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ عَبْدِ اللہِ بْنِ بَکْرٍ ، عَنْ أَبِیہِ ، قَالَ أَبُو مُوسَی الأَشْعَرِیُّ : لَوْ رَأَیْت رَجُلاً یَرْضَعُ شَاۃً فِی الطَّرِیقِ فَسَخِرْت مِنْہُ خِفْت أَنْ لاَ أَمُوتَ حَتَّی أَرْضَعَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 26057","","","كتاب الأدب"
"26058","(۲۶۰۵۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا حَسَنٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : إذَا قُلْتَ مَا ہُوَ فِیہِ ، وَہُوَ لاَ یَسْمَعُ ، فَقَدِ اغْتَبْتہ ، وَإِذَا قُلْتَ مَا لَیْسَ فِیہِ ، فَقَدْ بَہَتَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 26058","","","كتاب الأدب"
"26059","(۲۶۰۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : لَوْ سَخِرْت مِنْ کَلْبٍ لَخَشِیت أَنْ أَکُونَ کَلْبًا۔","","Musannaf Ibn Abi Shaybah 26059","","","كتاب الأدب"
"26060","(۲۶۰۶۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : الْبَلاَئُ مُوَکَّلٌ بِالْقَوْلِ۔","","Musannaf Ibn Abi Shaybah 26060","","","كتاب الأدب"
"26061","(۲۶۰۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ، قَالَ: إذَا قُلْتَ مَا فِیہِ، فَقَدِ اغْتَبْتہ ، وَإِنْ قُلْتَ مَا لَیْسَ فِیہِ ، فَقَدْ بَہَتَّہ۔","","Musannaf Ibn Abi Shaybah 26061","","","كتاب الأدب"
"26062","(۲۶۰۶۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلاَنَ ، عَنِ الْحَارِثِ ، قَالَ : کُنْتُ أَخِذًا بِیَدِ إبْرَاہِیمَ وَنَحْنُ نُرِید الْمَسْجِدَ ، قَالَ : فَذَکَرْت رَجُلاً فَاغْتَبْتہ ، قَالَ فَقَالَ لی إبْرَاہِیمُ : ارْجِعْ فَتَوَضَّأْ ، کَانُوا یَعُدُّونَ ہَذَا ہُجْرًا۔","","Musannaf Ibn Abi Shaybah 26062","","","كتاب الأدب"
"26063","(۲۶۰۶۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عُرْوَۃَ ، أَنَّہُ کَانَ لَہُ مُشْطٌ مِنْ عِظَامِ الْفِیلِ وَمَدْہَنٌ مِنْ عِظَامِ الْفِیلِ۔","","Musannaf Ibn Abi Shaybah 26063","","","كتاب الأدب"
"26064","(۲۶۰۶۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، قَالَ : رَأَیْتُ أَبِی یَدَّہِنُ فِی مَدْہَنٍ مِنْ عِظَامِ الْفِیلِ۔","","Musannaf Ibn Abi Shaybah 26064","","","كتاب الأدب"
"26065","(۲۶۰۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ لَہُ مَدْہَنٌ مِنْ عَاجٍ یَدَّہِنُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 26065","","","كتاب الأدب"
"26066","(۲۶۰۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ أُمہِ ، عَنْ سُرِّیَّۃٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَتْ : أَتَیْتہ بِمَدْہَنٍ مِنْ عَاجٍ ، أَوْ مُشْطٍ مِنْ عَاجٍ فَکَرِہَہُ وَقَالَ : ہُوَ مَیْتَۃٌ۔","","Musannaf Ibn Abi Shaybah 26066","","","كتاب الأدب"
"26067","(۲۶۰۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَرِہَ الْعَاجَ۔","","Musannaf Ibn Abi Shaybah 26067","","","كتاب الأدب"
"26068","(۲۶۰۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَرِہَ الْعَاجَ۔","","Musannaf Ibn Abi Shaybah 26068","","","كتاب الأدب"
"26069","(۲۶۰۶۹) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَرِہَ الْعَاجَ کُلَّہُ ، وَأَنْ یُتَّخَذَ مِنْہُ مِشْطًا۔","","Musannaf Ibn Abi Shaybah 26069","","","كتاب الأدب"
"26070","(۲۶۰۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خُزَیْمَۃَ ، عَنِ الْحَسَنِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ التَّرَجُّلِ إلاَّ غِبًّا۔ (ابوداؤد ۴۱۵۶۔ ترمذی ۱۷۵۶)","Hasan","Musannaf Ibn Abi Shaybah 26070","","","كتاب الأدب"
"26071","(۲۶۰۷۱) [corrupt]َدَّثَنَا وَکِیعٌ ، عَنْ جُوَیْرِیَۃَ بْنِ أَسْمَائَ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ کَانَ رُبَّمَا ادَّہَنَ فِی الْیَوْمِ مَرَّتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 26071","","","كتاب الأدب"
"26072","(۲۶۰۷۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا سَعِید ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ التَّرَجُّلِ إلاَّ غِبًّا۔","Hasan","Musannaf Ibn Abi Shaybah 26072","","","كتاب الأدب"
"26073","(۲۶۰۷۳) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ ، عَنْ شَیْبَۃَ بْنِ ہِشَامٍ ، عَنْ مُغِیرَۃَ بْنِ الْحَارِثِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : التَّرَجُّلُ غِبًّا۔","Da'if","Musannaf Ibn Abi Shaybah 26073","","","كتاب الأدب"
"26074","(۲۶۰۷۴) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یَکْرَہُونَ التَّرَجُّلَ کُلَّ یَوْمٍ۔","","Musannaf Ibn Abi Shaybah 26074","","","كتاب الأدب"
"26075","(۲۶۰۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَعَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالاَ : حدَّثَنَا عُبَید اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کَانَ ثَلاَثَۃٌ فَلاَ یَتَسَارَّ اثْنَانِ دُونَ الآخَرِ ، وَقَالَ ابْنُ نُمَیْرٍ : یَتَنَاج۔ (مسلم ۱۷۱۷۔ احمد ۲/۱۴۱)","Sahih","Musannaf Ibn Abi Shaybah 26075","","","كتاب الأدب"
"26076","(۲۶۰۷۶) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کنا ثَلاَثَۃً أَنْ یَتَنَاجَی اثْنَانِ دُونَ وَاحِدٍ أَجْلَ أَنْ یُحْزِنَہُ حَتَّی یَخْتَلِطَ بِالنَّاسِ۔n(مسلم ۱۷۱۸۔ بخاری ۶۲۹۰)","Sahih","Musannaf Ibn Abi Shaybah 26076","","","كتاب الأدب"
"26077","(۲۶۰۷۷) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَحْوَص ، قَالَ : قَالَ عَبْدُ اللہِ : إذَا کَانَ ثَلاَثَۃُ نَفَرٍ فلا یَنْتَجِی اثْنَانِ دُونَ وَاحِدٍ ، فَإِنَّ ذَلِکَ یَسُوئُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26077","","","كتاب الأدب"
"26078","(۲۶۰۷۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ وَہُوَ یُنَاجِی رَجُلاً ، فَأَدْخَلْت رَأْسِی بَیْنَہُمَا فَضَرَبَ ابْنُ عُمَرَ صَدْرِی وَقَالَ : إذَا رَأَیْت اثْنَیْنِ یَتَنَاجَیَانِ فَلاَ تَدْخُلْ بَیْنَہُمَا إلاَّ بِإِذْنِہِمَا۔","Sahih","Musannaf Ibn Abi Shaybah 26078","","","كتاب الأدب"
"26079","(۲۶۰۷۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا کَانَ الْقَوْمُ أَرْبَعَۃً فَلاَ بَأْسَ أَنْ یَتَنَاجَی اثْنَانِ دُونَ صَاحِبَیْہِمَا۔ (ابوداؤد ۴۸۱۸)","Sahih","Musannaf Ibn Abi Shaybah 26079","","","كتاب الأدب"
"26080","(۲۶۰۸۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو سَمِعَ جَابِرًا یَقُولُ : مَرَّ رَجُلٌ فِی الْمَسْجِدِ بِسِہَامٍ فَقَالَ لَہُ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمْسِکْ بِنِصَالِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 26080","","","كتاب الأدب"
"26081","(۲۶۰۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ بُرَیْدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : إذَا مَرَّ أَحَدُکُمْ فِی الْمَسْجِدِ بِنَبْلٍ فَلْیُمْسِکْ بِنِصَالِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 26081","","","كتاب الأدب"
"26082","(۲۶۰۸۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا عَاصِمٌ ، عَنِ الْحَسَنِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی قَوْمًا یَتَعَاطَوْنَ سَیْفًا مَشْہُورًا فَقَالَ : لَعَنَ اللَّہُ ہَؤُلاَئِ ، فَقُلْت للحسن : إنَّہُ کَانَ فِی الْمَسْجِدِ ، فَقَالَ : لاَ ، بَلْ فِی رَحْبَۃٍ مِنْ رِحَابِ الْمَسْجِدِ۔ (احمد ۵/۴۱۔ حاکم ۲۹۰)","Hasan","Musannaf Ibn Abi Shaybah 26082","","","كتاب الأدب"
"26083","(۲۶۰۸۳) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، قَالَ: مَلْعُونٌ مَنْ نَاوَلَ أَخَاہُ السَّیْفَ مَسْلُولاً فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 26083","","","كتاب الأدب"
"26084","(۲۶۰۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَسْلَمَ الْمُنْقِرِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، أَنَّہُ کَرِہَ سَلَّ السَّیْفِ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 26084","","","كتاب الأدب"
"26085","(۲۶۰۸۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنِ الْحَسَنِ ، قَالَ : سَمِعْتُہُ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ نَاوَلَ أَخَاہُ السَّیْفَ فَلْیَغْمِدْہُ۔","Hasan","Musannaf Ibn Abi Shaybah 26085","","","كتاب الأدب"
"26086","(۲۶۰۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُتَعَاطَی السَّیْفُ مَسْلُولاً۔ (ترمذی ۲۱۶۳۔ ابوداؤد ۲۵۸۱)","Sahih","Musannaf Ibn Abi Shaybah 26086","","","كتاب الأدب"
"26087","(۲۶۰۸۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنِ الْحَسَنِ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُتَعَاطَی السَّیْفُ مَسْلُولاً ، وَمَرَّ بِقَوْمٍ یَتَعَاطَوْنَ سَیْفًا مَسْلُولاً فَقَالَ : أَلَمْ أَنْہَکُمْ عن ہَذَا ؟ لَعَنَ اللَّہُ مَنْ فَعَلَ ہَذَا۔ (احمد ۳/۳۶۱)","Da'if","Musannaf Ibn Abi Shaybah 26087","","","كتاب الأدب"
"26088","(۲۶۰۸۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَقُمْ رَجُلٌ لِرَجُلٍ ، وَلَکِنْ لِیُوسِعْ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 26088","","","كتاب الأدب"
"26089","(۲۶۰۸۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یُقِیمَنَّ أَحَدُکُمْ أَخَاہُ مِنْ مَجْلِسِہِ ، ثُمَّ یَجْلِسَ فِیہِ ، قَالَ : وَکَانَ ابْنُ عُمَرَ إذَا قَامَ لَہُ الرَّجُلُ عن مَجْلِسِہِ لَمْ یَجْلِسْ فِیہِ۔ (مسلم ۱۷۱۴۔ احمد ۲/۸۹)","Sahih","Musannaf Ibn Abi Shaybah 26089","","","كتاب الأدب"
"26090","(۲۶۰۹۰) حَدَّثَنَا ابْنُ نُمَیْرٍ وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یُقِیمَنَّ الرَّجُلُ الرَّجُلَ عَنْ مَقْعَدِہِ ثُمَّ یَقْعُدَ فِیہِ ، وَلَکِنْ تَفَسَّحُوا وَتَوَسَّعُوا۔n(مسلم ۱۷۱۴۔ احمد ۲/۱۶)","Sahih","Musannaf Ibn Abi Shaybah 26090","","","كتاب الأدب"
"26091","(۲۶۰۹۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَبْدِ رَبِّہِ بْنِ سَعِیدٍ ، عَنْ مَوْلًی لأَبِی مُوسَی ، عَنْ سَعِیدِ بْنِ أَبِی الْحَسَنِ ، عَنْ أَبِی بَکْرَۃَ ، أَنَّہُ دُعِیَ إلَی شَہَادَۃٍ فَقَامَ لَہُ رَجُلٌ مِنْ مَجْلِسِہِ فَقَالَ لَہُ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی إذَا قَامَ الرَّجُلُ لِلرَّجُلِ عَنْ مَجْلِسِہِ أَنْ یَجْلِسَ فِیہِ ، وَنَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَمْسَحَ الرَّجُلُ یَدَہُ بِثَوْبِ مَنْ لاَ یَکْسُو۔ (ابوداؤد ۴۷۹۴۔ احمد ۵/۴۴)","Da'if","Musannaf Ibn Abi Shaybah 26091","","","كتاب الأدب"
"26092","(۲۶۰۹۲) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ: حدَّثَنَا فُلَیْحٌ ، عَنْ أَیُّوبَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ یَعْقُوبَ بْنِ أَبِی یَعْقُوبَ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَقُومُ الرَّجُلُ لِلرَّجُلِ عَنْ مَجْلِسِہِ ، وَلَکِنِ افْسَحُوا یَفْسَحَ اللَّہُ لَکُمْ۔ (احمد ۲/۳۳۸)","Hasan","Musannaf Ibn Abi Shaybah 26092","","","كتاب الأدب"
"26093","(۲۶۰۹۳) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ عَطَائٍ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : کَانَ یُکْرَہُ أَنْ یَقُومَ الرَّجُلُ مِنْ مَجْلِسِہِ لِلرَّجُلِ لِیَجْلِسَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 26093","","","كتاب الأدب"
"26094","(۲۶۰۹۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی الْعَنْبَسِ ، عَنْ أَبِی الْعَدَبَّسِ ، عَنْ أَبِی مَرْزُوقٍ ، عَنْ أَبِی غَالِبٍ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَوَکِّئًا عَلَی عَصًا ، فَقُمْنَا إلَیْہِ فَقَالَ : لاَ تَقُومُوا کَمَا تَقُومُ الأَعَاجِمُ یُعَظِّمُ بَعْضُہَا بَعْضًا۔ (ابوداؤد ۵۱۸۷۔ ابن ماجہ ۳۸۳۶)","Da'if","Musannaf Ibn Abi Shaybah 26094","","","كتاب الأدب"
"26095","(۲۶۰۹۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَبِیبِ بْنِ شَہِیدٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : دَخَلَ مُعَاوِیَۃُ بَیْتًا فِیہِ عَبْدُ اللہِ بْنُ عَامِرٍ، وَعَبْدُ اللہِ بْنُ الزُّبَیْرِ ، فَقَامَ عَبْدُ اللہِ بْنُ عَامِرٍ وَلَمْ یَقُمْ عَبْدُ اللہِ بْنُ الزُّبَیْرِ فَقَالَ مُعَاوِیَۃُ لابْنِ عَامِرٍ : اجْلِسْ ، فَإِنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ سَرَّہُ أَنْ یَتَمَثَّلَ لَہُ الرِّجَالُ قِیَامًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (ترمذی ۲۷۵۵۔ ابوداؤد ۵۱۸۶)","Sahih","Musannaf Ibn Abi Shaybah 26095","","","كتاب الأدب"
"26096","(۲۶۰۹۶) عَفَّان ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : مَا کَانَ شَخْصٌ أَحَبَّ إلَیْہِمْ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانُوا إذَا رَأَوْہُ لَمْ یَقُومُوا لِمَا یَعْلَمُونَ مِنْ کَرَاہِیَتِہِ لِذَلِکَ۔n(ترمذی ۲۷۵۴)","Sahih","Musannaf Ibn Abi Shaybah 26096","","","كتاب الأدب"
"26097","(۲۶۰۹۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ أَبِیہِ ، عَنْ طَارِقٍ ، قَالَ : کُنَّا جُلُوسًا عِنْدَ الشَّعْبِیِّ ، فَجَائَ جَرِیرُ بْنُ یَزِیدَ ، فَدَعَا لَہُ الشَّعْبِیُّ بِوِسَادَۃٍ فَقُلْنَا لَہُ : یَا أَبَا عَمْرٍو نَحْنُ عِنْدَکَ أَشْیَاخٌ ، دَعَوْت لِہَذَا الْغُلاَمِ بِوِسَادَۃٍ ؟ فَقَالَ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا أَتَاکُمْ کَرِیمُ قَوْمٍ فَأَکْرِمُوہُ۔","","Musannaf Ibn Abi Shaybah 26097","","","كتاب الأدب"
"26098","(۲۶۰۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ طَارِق ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَتَاکُمْ کَرِیمُ قَوْمٍ فَأَکْرِمُوہُ۔ (ابوداؤد ۵۱۱)","","Musannaf Ibn Abi Shaybah 26098","","","كتاب الأدب"
"26099","(۲۶۰۹۹) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ عَاصِمٍ ، قَالَ : طَرَحَ أَبُو قِلاَبَۃَ لِرَجُلٍ وِسَادَۃً فَقَالَ أَبُو قِلاَبَۃَ : إِنَّہُ کَانَ یُقَالُ : لاَ تَرُدَّ عَلَی أَخِیک کَرَامَتَہُ۔","","Musannaf Ibn Abi Shaybah 26099","","","كتاب الأدب"
"26100","(۲۶۱۰۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : دَخَلَ عَلِیٌّ وَرَجُلٌ ، فَطَرَحَ لَہُمَا وِسَادَتَیْنِ ، فَجَلَسَ عَلِیٌّ وَلَمْ یَجْلِسِ الآخَرُ ، فَقَالَ عَلِیٌّ : لاَ یَرُدُّ الْکَرَامَۃَ إلاَّ حِمَارٌ۔","","Musannaf Ibn Abi Shaybah 26100","","","كتاب الأدب"
"26101","(۲۶۱۰۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : خُذِ الْحُکْمَ مِمَّنْ سَمِعْتہ ، فَإِنَّمَا ہُوَ مِثْلُ الرَّمْیَۃِ مِنْ غَیْرِ رَامٍ۔","","Musannaf Ibn Abi Shaybah 26101","","","كتاب الأدب"
"26102","(۲۶۱۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، قَالَ : حَدَّثَنِی عَلِیُّ بْنُ الأَقْمَرِ ، أَنَّ أَبَا جُحَیْفَۃَ کَانَ یَقُولُ : جَالِسُوا الْکُبَرَائَ ، وَخَالِطُوا الْحُکَمَائَ ، وَسَائِلُوا الْعُلَمَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 26102","","","كتاب الأدب"
"26103","(۲۶۱۰۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخَطْمِیِّ ، أَنَّ جَدَّہُ وَہُوَ عُمَیْرُ بْنُ حَبِیبٍ أَوْصَی بَنِیہِ فَقَالَ : یَا بَنِیَّ ، إیَّاکُمْ وَمُجَالَسَۃَ السُّفَہَائِ ، فَإِنَّ مُجَالَسَتَہُمْ دَائٌ ، إِنَّہُ مَنْ یَحْلُمُ ، عَنِ السَّفِیہِ یُسَرَّ بِحِلْمِہِ ، وَمَنْ یُحبہ یَنْدَمُ ، وَمَنْ لاَ یَقَرُّ بِقَلِیلِ مَا یَجِیئُ بِہِ السَّفِیہُ یَقَرُّ بِالْکَثِیرِ ، وَإِذَا أَرَادَ أَحَدُکُمْ أَنْ یَأْمُرَ بِالْمَعْرُوفِ وَیَنْہَی عَنِ الْمُنْکَرِ فَلْیُوَطِّنْ نَفْسَہُ عَلَی الصَّبْرِ عَلَی الأَذَی ، فَإِنَّہُ مَنْ یَصْبِرُ لاَ یَجِدُ لِلأَذَی مَسًّا۔","Sahih","Musannaf Ibn Abi Shaybah 26103","","","كتاب الأدب"
"26104","(۲۶۱۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : إنَّ مِنْ فِقْہِ الرَّجُلِ مَمْشَاہُ وَمَدْخَلَہُ ، قَالَ أَبُو قِلاَبَۃَ : قَاتَلَ اللَّہُ الشَّاعِرَ حَیْثُ یَقُولُ :nعَنِ الْمَرْئِ لاَ تَسْأَلْ وأبصر قَرِینَہُ وَ کُلُّ قَرِینٍ بِالْمُقَارَنِ مُہْتَدِی","","Musannaf Ibn Abi Shaybah 26104","","","كتاب الأدب"
"26105","(۲۶۱۰۵) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عن أبی إسحاق، عَنْ مُرَّۃَ، أَوْ ہُبَیْرَۃَ، قَالَ: قَالَ عَبْدُ اللہِ: اعْتَبِرُوا النَّاسَ بِأخْدانِہِمْ۔","Hasan","Musannaf Ibn Abi Shaybah 26105","","","كتاب الأدب"
"26106","(۲۶۱۰۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَیْمُونٍ الْجُہَنِیِّ أَبی مَنْصُورا ، قَالَ : سَمِعْتُ إبْرَاہِیمَ یَقُولُ : إذَا دَخَلَ أَحَدُکُمْ بَیْتًا فَأَیْنَمَا أَجْلَسُوہُ فَلْیَجْلِسْ ، ہُمْ أَعْلَمُ بِعَوْرَۃِ بَیْتِہِمْ۔","","Musannaf Ibn Abi Shaybah 26106","","","كتاب الأدب"
"26107","(۲۶۱۰۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ شُرَیْحًا یَمْشِی مُخْتَصِرًا۔","","Musannaf Ibn Abi Shaybah 26107","","","كتاب الأدب"
"26108","(۲۶۱۰۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، قَالَ : إنَّمَا یُکْرَہُ الاخْتِصَارُ فِی الصَّلاَۃِ لأَنَّ إبْلِیسَ أُہْبِطَ مُخْتَصِرًا۔","","Musannaf Ibn Abi Shaybah 26108","","","كتاب الأدب"
"26109","(۲۶۱۰۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ إذَا حَدَّثَ الرَّجُلُ الرَّجُلَ بِحَدِیثٍ وَقَالَ : اکْتُمْ عَلَیَّ ، فَہِیَ أَمَانَۃٌ۔","","Musannaf Ibn Abi Shaybah 26109","","","كتاب الأدب"
"26110","(۲۶۱۱۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 26110","","","كتاب الأدب"
"26111","(۲۶۱۱۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَطَائٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ جَابِرِ بْنِ عَتِیکٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا حَدَّثَ الرَّجُلُ الرَّجُلَ بِالْحَدِیثِ ، ثُمَّ الْتَفَتَ فَہِیَ أَمَانَۃٌ۔ (ابوداؤد ۴۸۳۵۔ ترمذی ۱۹۵۹)","Da'if","Musannaf Ibn Abi Shaybah 26111","","","كتاب الأدب"
"26112","(۲۶۱۱۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إیَّاکُمْ وَالْکَذِبَ ، فَإِنَّ الْکَذِبَ یَہْدِی إلَی الْفُجُورِ ، وَإِنَّ الْفُجُورَ یَہْدِی إلَی النَّارِ ، وَإِنَّ الرَّجُلَ لَیَکْذِبُ وَیَتَحَرَّی الْکَذِبَ حَتَّی یُکْتَبَ عِنْدَ اللہِ کَذَّابًا ، وَعَلَیْکُم[corrupt] بِالصِّدْقِ ، فَإِنَّ الصِّدْقَ بِرٌّ ، وَالْبِرُّ یَہْدِی إلَی الْجَنَّۃِ ، وَإِنَّ الرَّجُلَ یَصْدُقُ وَیَتَحَرَّی الصِّدْقَ حَتَّی یُکْتَبَ عِنْدَ اللہِ صِدِّیقًا۔ (مسلم ۱۰۵۔ ابوداؤد ۴۹۵۰)","Sahih","Musannaf Ibn Abi Shaybah 26112","","","كتاب الأدب"
"26113","(۲۶۱۱۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ مُرَّۃَ بْنِ شَرَاحِیلَ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّ الرَّجُلَ لَیَصْدُقُ وَیَتَحَرَّی الصِّدْقَ حَتَّی مَا یَکُونُ لِلْفُجُورِ فِی قَلْبِہِ مَوْضِعُ إبْرَۃٍ یَسْتَقِرُّ فِیہِ ، وَإِنَّہُ لَیَکْذِبُ وَیَتَحَرَّی الْکَذِبَ حَتَّی مَا یَکُونُ لِلصِّدْقِ فِی قَلْبِہِ مَوْضِعُ إبْرَۃٍ یَسْتَقِرُّ فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 26113","","","كتاب الأدب"
"26114","(۲۶۱۱۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، وَعَنْ مُجَاہِدٍ، عَنْ أَبِی مَعْمَرٍ، عَنْ عَبْدِ اللہِ، وَعَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنْ عَبْدِ اللہِ ، قَالَ : لاَ یَصْلُحُ الْکَذِبُ فِی جَدٍّ ، وَلاَ ہَزْلٍ ، ثُمَّ تَلاَ عَبْدُ اللہِ {اتَّقُوا اللَّہَ وَکُونُوا مَعَ الصَّادِقِینَ}۔ (دارمی ۲۷۱۵)","","Musannaf Ibn Abi Shaybah 26114","","","كتاب الأدب"
"26115","(۲۶۱۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : قَالَ أَبُو بَکْرٍ : إیَّاکُمْ وَالْکَذِبَ فَإِنَّہُ مُجَانِبُ الإِیمَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 26115","","","كتاب الأدب"
"26116","(۲۶۱۱۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ، عَنْ عَبْدِ اللہِ ، قَالَ : الْمُؤْمِنُ یُطْوَی عَلَی الْخِلاَلِ کُلِّہَا غَیْرِ الْخِیَانَۃِ وَالْکَذِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 26116","","","كتاب الأدب"
"26117","(۲۶۱۱۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ سَعْدٍ ، قَالَ : الْمُؤْمِنُ یُطْبَعُ عَلَی الْخِلاَلِ کُلِّہَا غَیْرِ الْخِیَانَۃِ وَالْکَذِبِ۔ (بزار ۱۱۳۹۔ ابو یعلی ۷۰۷)","Sahih","Musannaf Ibn Abi Shaybah 26117","","","كتاب الأدب"
"26118","(۲۶۱۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، قَالَ : ذُکِرَ عِنْدَ عَامِرٍ ، أَنَّ الْمُنَافِقَ الَّذِی إذَا حَدَّثَ کَذَبَ ، فَقَالَ عَامِرٌ : لاَ أَدْرِی مَا تَقُولُونَ ؟ إِنْ کَانَ کَذَّابًا ، فَہُوَ مُنَافِقٌ۔","","Musannaf Ibn Abi Shaybah 26118","","","كتاب الأدب"
"26119","(۲۶۱۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ مَیْمُونِ بْنِ أَبِی شَبِیبٍ ، عَنْ عُمَرَ ، قَالَ : لاَ تَبْلُغُ حَقِیقَۃَ الإِیمَانِ حَتَّی تَدَعَ الْکَذِبَ فِی الْمِزَاحِ۔","Hasan","Musannaf Ibn Abi Shaybah 26119","","","كتاب الأدب"
"26120","(۲۶۱۲۰) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا عَوْنٌ ، قَالَ : ذُکِرَ الْکَذِبُ عِنْدَ مُحَمَّدٍ فِی الْحَرْبِ ، أَنَّہُ لاَ بَأْسَ بِہِ ، فَقَالَ مُحَمَّدٌ : لاَ أَعْلَمُ الْکَذِبَ إلاَّ حَرَامًا۔","","Musannaf Ibn Abi Shaybah 26120","","","كتاب الأدب"
"26121","(۲۶۱۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : حُدِّثْت عَنْ أَبِی أُمَامَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یُطْوَی الْمُؤْمِنُ عَلَی الْخِلاَلِ کُلِّہَا غَیْرِ الْخِیَانَۃِ وَالْکَذِبِ۔ (احمد ۵/۲۵۲)","Da'if","Musannaf Ibn Abi Shaybah 26121","","","كتاب الأدب"
"26122","(۲۶۱۲۲) حَدَّثَنَا شَبَابَۃُ ، عَنِ اللَّیْثِ ، عَنِ ابْنِ عَجْلاَنَ ، أَنَّ رَجُلاً مِنْ مَوَالِی عَبْدِ اللہِ بْنِ عَامِرٍ بن رَبیعۃ العدوی ، حَدَّثَہُ عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ ، أَنَّہُ قَالَ : دَعَتْنِی أُمِّی یَوْمًا وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَاعِدٌ فِی بَیْتِنَا ، فَقَالَتْ : ہَا تَعَالَ أُعْطِیک ، فَقَالَ لَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَمَا أَرَدْت أَنْ تُعْطِیَہُ ؟ قَالَتْ : تَمْرًا ، فَقَالَ لَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَمَا إنَّک لَوْ لَمْ تُعْطِہِ شَیْئًا کُتِبَتْ عَلَیْکِ کِذْبَۃٌ۔n(ابوداؤد ۴۹۵۲۔ احمد ۳/۴۴۷)","Da'if","Musannaf Ibn Abi Shaybah 26122","","","كتاب الأدب"
"26123","(۲۶۱۲۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَرْبَعٌ مَنْ کُنَّ فِیہِ ، فَہُوَ مُنَافِقٌ خَالِصٌ ، وَمَنْ کَانَتْ فِیہِ خَلَّۃٌ مِنْہُنَّ کَانَتْ فِیہِ خَلَّۃٌ مِنْ نِفَاقٍ حَتَّی یَدَعَہَا : إذَا حَدَّثَ کَذَبَ ، وَإِذَا وَعَدَ أَخْلَفَ ، وَإِذَا عَاہَدَ غَدَرَ ، وَإِذَا خَاصَمَ فَجَرَ۔ (مسلم ۱۰۶۔ ابو داؤد ۴۶۵۵)","Sahih","Musannaf Ibn Abi Shaybah 26123","","","كتاب الأدب"
"26124","(۲۶۱۲۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : قَالَ عَبْدُ اللہِ : اعْتَبِرُوا الْمُنَافِقَ بِثَلاَثٍ : إذَا حَدَّثَ کَذَبَ ، وَإِذَا وَعَدَ أَخْلَفَ ، وَإِذَا عَاہَدَ غَدَرَ۔ (نسائی ۱۱۷۵۴)","Sahih","Musannaf Ibn Abi Shaybah 26124","","","كتاب الأدب"
"26125","(۲۶۱۲۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، عَن صُبَیح بْنِ عَبْدِ اللہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : ثَلاَثٌ مَنْ کُنَّ فِیہِ فَہُوَ مُنَافِقٌ : إذَا حَدَّثَ کَذَبَ وَإِذَا وَعَدَ أَخْلَفَ وَإِذَا اُؤْتُمِنَ خَانَ: قَالَ : وَتَلاَ ہَذِہِ الآیَۃَ : {وَمِنْہُمْ مَنْ عَاہَدَ اللَّہَ لَئِنْ آتَانَا مِنْ فَضْلِہِ } إلَی قَوْلِہِ : { نِفَاقًا فِی قُلُوبِہِمْ } إلَی قَوْلِہِ : { بِمَا کَانُوا یَکْذِبُونَ } (التوبۃ: ۷۵ تا ۷۷)","Da'if","Musannaf Ibn Abi Shaybah 26125","","","كتاب الأدب"
"26126","(۲۶۱۲۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاَثٌ مَنْ کُنَّ فِیہِ ، فَہُوَ مُنَافِقٌ : الَّذِی إذَا حَدَّثَ کَذَبَ ، وَإِذَا وَعَدَ أَخْلَفَ ، وَإِذَا اُؤْتُمِنَ خَانَ۔n(بخار ی۳۳۔ ترمذی ۲۶۳۱)","Da'if","Musannaf Ibn Abi Shaybah 26126","","","كتاب الأدب"
"26127","(۲۶۱۲۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : ثَلاَثٌ مَنْ کُنَّ فِیہِ ، فَہُوَ مُنَافِقٌ ، وَإِنْ صَامَ وَصَلَّی وَقَالَ إِنِّی مُسْلِمٍ : إذَا حَدَّثَ کَذَبَ ، وَإِذَا اؤْتُمِنَ خَانَ ، وَإِذَا وَعَدَ أَخْلَفَ۔","","Musannaf Ibn Abi Shaybah 26127","","","كتاب الأدب"
"26128","(۲۶۱۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ مَیْمُونِ بْنِ أَبِی شَبِیبٍ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ حَدَّثَ عَنِّی بِحَدِیثٍ وَہُوَ یُرَی ، أَنَّہُ کَذِبٌ ، فَہُوَ أَحَدُ الْکَاذِبَِیْنِ۔n(ترمذی ۲۶۶۲۔ احمد ۴/۲۵۲)","Sahih","Musannaf Ibn Abi Shaybah 26128","","","كتاب الأدب"
"26129","(۲۶۱۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ سَمُرَۃََ بْنِ جُنْدَبٍ ، قَالَ : قَالَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ حَدَّثَ عَنِّی حَدِیثًا وَہُوَ یُرَی ، أَنَّہُ کَذِبٌ ، فَہُوَ أَحَدُ الْکَاذِبَیْنِ۔n(ابن ماجہ ۳۹۔ احمد ۲۰)","Sahih","Musannaf Ibn Abi Shaybah 26129","","","كتاب الأدب"
"26130","(۲۶۱۳۰) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِ حَدِیثِ سَمُرَۃَ۔ (ابن ماجہ ۳۸)","Da'if","Musannaf Ibn Abi Shaybah 26130","","","كتاب الأدب"
"26131","(۲۶۱۳۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، قَالَ : حدَّثَنِی خُبَیْبٌ ، عَنْ حَفْصِ بْنِ عَاصِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کَفَی بِالْمَرْئِ کَذِبًا أَنْ یُحَدِّثَ بِکُلِّ مَا سَمِعَ۔ (مسلم ۵۔ ابوداؤد ۴۹۵۳)","Sahih","Musannaf Ibn Abi Shaybah 26131","","","كتاب الأدب"
"26132","(۲۶۱۳۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : قَالَ عُمَرُ : حَسْبُ امْرِئٍ مِنَ الْکَذِبِ أَنْ یُحَدِّثَ بِکُلِّ مَا سَمِعَ۔","Sahih","Musannaf Ibn Abi Shaybah 26132","","","كتاب الأدب"
"26133","(۲۶۱۳۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، عَنْ عَبْدِ اللہِ ، قَالَ : بحسْبِ امْرِئٍ مِنَ الْکَذِبِ أَنْ یُحَدِّثَ بِکُلِّ مَا سَمِعَ۔","Sahih","Musannaf Ibn Abi Shaybah 26133","","","كتاب الأدب"
"26134","(۲۶۱۳۴) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ بْنِ أَبِی حَفْصَۃَ ، عَنْ شُعْبَۃَ ، عَنْ رَجُلٍ ، قَالَ : قَالَ شُرَیْحٌ : الْحِلْمُ کَنْزٌ مُوفَّرٌ۔","","Musannaf Ibn Abi Shaybah 26134","","","كتاب الأدب"
"26135","(۲۶۱۳۵) حَدَّثَنَا عَبْدُ الرَّحْمَان بْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَاصِمٍ الأَحْوَلِ ، قَالَ : قَالَ الشَّعْبِیُّ : زَیَّنَ الْعِلْمَ حِلْمُ أَہْلِہِ۔","","Musannaf Ibn Abi Shaybah 26135","","","كتاب الأدب"
"26136","(۲۶۱۳۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ مُعَاوِیَۃُ : لاَ حِلْمَ إلاَّ التَجَارِب۔","Sahih","Musannaf Ibn Abi Shaybah 26136","","","كتاب الأدب"
"26137","(۲۶۱۳۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَام ، عَنْ طَاوُوسٍ ، قَالَ : مَا جُعِلَ الْعِلْمُ ، أَوَ مَا حُمِلَ الْعِلْمُ فِی مِثْلِ جِرَابِ حِلْمٍ۔","","Musannaf Ibn Abi Shaybah 26137","","","كتاب الأدب"
"26138","(۲۶۱۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : سَمِعْتُ بُرْدًا ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : مَا جُمِعَ شَیْئٌ إلَی شَیْئٍ أَزْیَنَ مِنْ عِلْمٍ إلَی حِلْمٍ۔","","Musannaf Ibn Abi Shaybah 26138","","","كتاب الأدب"
"26139","(۲۶۱۳۹) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا عَرْعَرَۃُ بْنُ الْبِرِنْدِ، عَنِ ابْنِ عَوْنٍ، عَنِ الْحَسَنِ، قَالَ: قَالَ الأَحْنَفُ بْنُ قَیْسٍ: إنِّی لَسْت بِحَلِیمٍ ، وَلَکِنِّی أَتَحَالَمُ۔","Da'if","Musannaf Ibn Abi Shaybah 26139","","","كتاب الأدب"
"26140","(۲۶۱۴۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ، عَنْ عبد اللہِ، قَالَ: لاَ تَنْشُرْ بَزَّک إلاَّ عِنْدَ مَنْ یبغیہ۔ (احمد ۳۶۰)","","Musannaf Ibn Abi Shaybah 26140","","","كتاب الأدب"
"26141","(۲۶۱۴۱) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنِ الأَعْمَش، عَنْ مُسْلِم، عَن مَسْروق قَالَ: لاَ تَنْشُرْ بَزَّک إلاَّ عِنْدَ مَنْ یُرِیدُہُ۔","","Musannaf Ibn Abi Shaybah 26141","","","كتاب الأدب"
"26142","(۲۶۱۴۲) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : لاَ تُحَدِّثْ بِالْحَدِیثِ إلاَّ مَنْ یَعْرِفُہُ ، فَإِنَّ مَنْ لاَ یَعْرِفُہُ یَضُرُّہُ ، وَلاَ یَنْفَعُہُ۔","","Musannaf Ibn Abi Shaybah 26142","","","كتاب الأدب"
"26143","(۲۶۱۴۳) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ عَمَّارٍ الدُّہْنِیِّ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: لاَ أَنْشُرُ بَزِّی عِنْدَ مَنْ لاَ یُرِیدُہُ۔","","Musannaf Ibn Abi Shaybah 26143","","","كتاب الأدب"
"26144","(۲۶۱۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، عَنِ ابْنِ مَعْقِلٍ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : لاَ تَنْشُرْ سِلْعَتَکَ إلاَّ عِنْدَ مَنْ یُرِیدُہَا۔","","Musannaf Ibn Abi Shaybah 26144","","","كتاب الأدب"
"26145","(۲۶۱۴۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیْمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: خَیْرُ أَکْحَالِکُمُ الإِثْمِدُ ، یَجْلُو الْبَصَرَ ، وَیُنْبِتُ الشَّعْرَ۔","Hasan","Musannaf Ibn Abi Shaybah 26145","","","كتاب الأدب"
"26146","(۲۶۱۴۶) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ إسْمَاعِیلَ بْنِ مُسْلِمٍ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ، عَنْ جَابِرٍ، قَالَ: سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : عَلَیْکُمْ بِالإثْمدِ عِنْدَ النَّوْمِ فَإِنَّہُ یَشُدُّ الْبَصَرَ وَیُنْبِتُ الشَّعْرَ۔","Da'if","Musannaf Ibn Abi Shaybah 26146","","","كتاب الأدب"
"26147","(۲۶۱۴۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ حَفْصَۃَ ، عَنْ أَنَسٍ ، أَنَّہُ کَانَ یَکْتَحِلُ ثَلاَثًا فِی کُلِّ عَیْنٍ۔","Sahih","Musannaf Ibn Abi Shaybah 26147","","","كتاب الأدب"
"26148","(۲۶۱۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ یَکْتَحِلُ اثْنَتَیْنِ فِی ذِہِ ، وَاثْنَتَیْنِ فِی ذِہِ ، وَوَاحِدَۃً بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 26148","","","كتاب الأدب"
"26149","(۲۶۱۴۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ عِمْرَانَ بْنِ أَبِی أَنَسٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَکْتَحِلُ بِالإثْمدِ ، یَکْتَحِلُ الْیُمْنَی ثَلاَثَۃَ مَرَاوِدَ وَالْیُسْرَی مِرْوَدَیْنِ۔","","Musannaf Ibn Abi Shaybah 26149","","","كتاب الأدب"
"26150","(۲۶۱۵۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُکْحُلَۃٌ یَکْتَحِلُ مِنْہَا ثَلاَثَۃً فِی کُلِّ عَیْنٍ۔","Da'if","Musannaf Ibn Abi Shaybah 26150","","","كتاب الأدب"
"26151","(۲۶۱۵۱) حَدَّثَنَا حُسَیْنُ بْنُ عَبْدِ الرَّحْمَنِ الْحَارِثِیُّ ، عَنِ ابْنِ عَوْنٍ ، عَنِ النَّضْرِ بْنِ أَنَسٍ ، أَنَّہُ قَالَ فِی الْکُحْلِ : أَمَّا أَنَا فَإِنِّی أَکْتَحِلُ ثَلاَثًا ہَاہُنَا ، وَثَلاَثًا ہَاہُنَا ، وَوَاحِدَۃً بَیْنَہُمَا فَذَکرت ذلک لمحمد فَقَالَ : أَمَّا أَنا فَإِنِّی أَکتَحِلُ ثَلاَثًا ہَاہُنَا واثنتین ہَاہُنَا وَوَاحِدَۃً بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 26151","","","كتاب الأدب"
"26152","(۲۶۱۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ أَبِی الْمُغِیرَۃِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَنِ اکْتَحَلَ فَلْیُوتِرْ۔ (ابوداؤد ۳۶۔ احمد ۲/۳۵۱)","Da'if","Musannaf Ibn Abi Shaybah 26152","","","كتاب الأدب"
"26153","(۲۶۱۵۳) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ سَدیرٍ ، قَالَ : کُنْتُ عِنْدَ أَبِی جَعْفَرٍ ، فَلَمَّا أَرَدْت أَنْ أَرْکَبَ أَخَذَ بِالرِّکَابِ وَقَالَ : مَا عَلَیْک أَنْ أُؤْجَرَ ، وَلَیْسَ بِہِ بَأْسٌ۔","","Musannaf Ibn Abi Shaybah 26153","","","كتاب الأدب"
"26154","(۲۶۱۵۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَجْلَحِ ، عَنْ عَامِرٍ ، قَالَ : دَعَا عُمَرُ زَیْدَ بْنَ صُوحَانَ ، فَضَفَنَہُ عَلَی الرَّحْلِ کَمَا تَضْفِنُونَ أَنْتُمْ أُمَرَائَکُمْ ، ثُمَّ الْتَفَتَ إلَی النَّاسِ فَقَالَ : افْعَلُوا بِزَیْدٍ وَأَصْحَابِہِ مِثْلَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 26154","","","كتاب الأدب"
"26155","(۲۶۱۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : رُبَّمَا أَمْسَکَ لِی ابْنُ عَبَّاسٍ ، أَوِ ابْنُ عُمَرَ بِالرِّکَابِ۔","Hasan","Musannaf Ibn Abi Shaybah 26155","","","كتاب الأدب"
"26156","(۲۶۱۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ غُلاَمًا أَعْوَرَ آخِذًا لِعَلْقَمَۃَ بِالرِّکَابِ ، أَحْسَبُہُ ، قَالَ : یَوْمَ الجُمُعَۃ۔","","Musannaf Ibn Abi Shaybah 26156","","","كتاب الأدب"
"26157","(۲۶۱۵۷) حَدَّثَنَا عَفَّانُ، قَالَ: حدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، قَالَ: حَدَّثَنَا عَبْدُ اللہِ بْنُ صُبَیْحٍ الْحَنَفِیُّ ، وَذَہَبَ لِیَرْکَبَ فَأَخَذَ رَجُلٌ بِرِکَابِہِ فَقَالَ : بَلَغَنِی أَنَّ مُطَرِّفًا کَانَ یَقُولُ : مَا کُنْت لأَمْنَعَ أَخًا لِی یُرِیدُ کَرَامَتِی أَنْ یُکْرِمَنِی۔","","Musannaf Ibn Abi Shaybah 26157","","","كتاب الأدب"
"26158","(۲۶۱۵۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا غَالِبٌ الْقَطَّانُ ، قَالَ : أَرَدْت یَوْمًا أَنْ أَرْکَبَ حِمَارًا ، فَجَائَ شُعَیْبٌ یَمْسِکُ بِالرِّکَابِ ، فَسَأَلْت الْحَسَنَ فَقَالَ : اقْبَلْ کَرَامَۃَ أَخِیک۔","","Musannaf Ibn Abi Shaybah 26158","","","كتاب الأدب"
"26159","(۲۶۱۵۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ الأَخْنَسِ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ ، عَنْ یُوسُفَ بْنِ مَاہَکَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنِ اقْتَبَسَ عِلْمًا مِنَ النُّجُومِ اقْتَبَسَ شُعْبَۃً مِنَ السِّحْرِ ، زَادَ مَا زَادَ۔ (ابوداؤد ۳۹۰۰۔ ابن ماجہ ۳۷۲۶)","Sahih","Musannaf Ibn Abi Shaybah 26159","","","كتاب الأدب"
"26160","(۲۶۱۶۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَتَعَلَّمَ مِنَ النُّجُومِ وَالْقَمَرِ مَا یَہْتَدِی بِہِ۔","","Musannaf Ibn Abi Shaybah 26160","","","كتاب الأدب"
"26161","(۲۶۱۶۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنِی یَحْیَی بْنُ أَیُّوبَ ، قَالَ : حَدَّثَنَا عَبْدُ اللہِ بْنُ طَاوُوسٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَنْظُرُونَ فِی النُّجُومِ وَفِی حُرُوفِ أَبِی جَادٍ ، قَالَ : أَرَی أُولَئِکَ قَوْمًا لاَ خَلاَقَ لَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 26161","","","كتاب الأدب"
"26162","(۲۶۱۶۲) حَدَّثَنَا غَسَّانُ بْنُ مُضَرَ ، عَنْ سَعِیدِ بْنِ یَزِیدَ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : قَالَ عُمَرُ : تَعَلَّمُوا مِنْ ہَذِہِ النُّجُومِ مَا تَہْتَدُونَ بِہِ فِی ظُلْمَۃِ الْبَرِّ وَالْبَحْرِ ، ثُمَّ أَمْسِکُوا۔","Sahih","Musannaf Ibn Abi Shaybah 26162","","","كتاب الأدب"
"26163","(۲۶۱۶۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَضْرِبُ وَلَدَہُ عَلَی اللَّحْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 26163","","","كتاب الأدب"
"26164","(۲۶۱۶۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ ثَوْرٍ ، عَنْ عُمَرَ بْنِ زَیْدٍ ، قَالَ : کَتَبَ عُمَرُ إلَی أَبِی مُوسَی : أَمَّا بَعْدُ فَتَفَقَّہُوا فِی السُّنَّۃِ وَتَفَقَّہُوا فِی الْعَرَبِیَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 26164","","","كتاب الأدب"
"26165","(۲۶۱۶۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : قَالَ سُلَیْمَانُ بْنُ دَاوُد لاِبْنِہِ : مَنْ أَرَاْدَ أَنْ یَغِیظَ عَدُوَّہُ فَلاَ یَرْفَعَ الْعَصَا ، عَنْ وَلَدِہِ۔","","Musannaf Ibn Abi Shaybah 26165","","","كتاب الأدب"
"26166","(۲۶۱۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یَقُولُونَ : أَکْرِمْ وَلَدَک وَأَحْسِنْ أَدَبَہُ۔","","Musannaf Ibn Abi Shaybah 26166","","","كتاب الأدب"
"26167","(۲۶۱۶۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ عَوْنٍ، قَالَ: سُئِلَ مُحَمَّدٌ عَنِ النَّحْوِ، قَالَ: لاَ أَعْلَمُ بِہِ بَأْسًا إِنْ لَمْ یَکُنْ فِیہِ بَغْیٌ۔","","Musannaf Ibn Abi Shaybah 26167","","","كتاب الأدب"
"26168","(۲۶۱۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، أَنَّہُ کَرِہَ لاَ بِحَمْدِ اللہِ۔","","Musannaf Ibn Abi Shaybah 26168","","","كتاب الأدب"
"26169","(۲۶۱۶۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُکْرَہُ أَنْ یَقُولَ الرَّجُلُ لاَ بِحَمْدِ اللہِ وَلَکِنْ قُولُوا : نَعَمْ بِحَمْدِ اللَّہِ۔","","Musannaf Ibn Abi Shaybah 26169","","","كتاب الأدب"
"26170","(۲۶۱۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : یُکْرَہُ أَنْ یَقُولَ الرَّجُلُ لاَ بِحَمْدِ اللہِ وَلَکِنْ یَقُولُ : لاَ وَالْحَمْدُ لِلَّہِ۔","","Musannaf Ibn Abi Shaybah 26170","","","كتاب الأدب"
"26171","(۲۶۱۷۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ دِینَارٍ ، عَنْ ہِشَامٍ ، أَنَّ مُحَمَّدًا کَانَ إذَا قَلَّمَ أَظْفَارَہُ دَفَنَہَا۔","","Musannaf Ibn Abi Shaybah 26171","","","كتاب الأدب"
"26172","(۲۶۱۷۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ حَسَّانٍ ، قَالَ : أَخْبَرَنَا حَبِیبُ بْنُ شَہِیدٍ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : اسْتَأْذَنْت عَلَی مُسْلِمِ بْنِ یَسَارٍ فَجَلَست ثُمَّ أَذِنَ لِی ، فَدَخَلْت عَلَیْہِ فَقَالَ : لَقَدَ اسْتَأْذَنْت عَلَیَّ وَإِنِّی لأدْفِنُ بَعْضَ وَلَدِی ، قَالَ : وَکَانَ بَعْضُ نِسَائِہِ أَسْقَطَتْ فَدَفَنَہُ۔","","Musannaf Ibn Abi Shaybah 26172","","","كتاب الأدب"
"26173","(۲۶۱۷۳) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ یَزِیدَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، أَنَّہُ أَمَرَ حَجَّامًا یَحْجُمُہُ أَنْ یُفْرِغَ مَحْجَمَۃَ دَمٍ لِکَلْبٍ یَلَغُہَا۔","","Musannaf Ibn Abi Shaybah 26173","","","كتاب الأدب"
"26174","(۲۶۱۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْجَبَّارِ بْنِ عَبَّاسٍ ، عَنْ رَجُلٍ مِنْ بَنِی ہَاشِمٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِدَفْنِ الشَّعْرِ وَالظُّفْرِ وَالدَّمِ۔ (بخاری ۲۰۹۴۔ بزار ۲۹۶۸)","Da'if","Musannaf Ibn Abi Shaybah 26174","","","كتاب الأدب"
"26175","(۲۶۱۷۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، أنَّہُ کَانَ إذَا قَلَّمَ أَظْفَارَہُ دَفَنَہَا ، أَوْ أَمَرَ بِہَا فَدُفِنَتْ۔","","Musannaf Ibn Abi Shaybah 26175","","","كتاب الأدب"
"26176","(۲۶۱۷۶) حدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنْ أَفْلَحَ ، عَنِ الْقَاسِمِ ، أَنَّہُ کَانَ یَدْفِنُ شَعْرَہُ بِمِنًی۔","","Musannaf Ibn Abi Shaybah 26176","","","كتاب الأدب"
"26177","(۲۶۱۷۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مَہْدِیٍّ ، قَالَ : دَخَلْنَا عَلَی مُحَمَّدِ بْنِ سِیرِینَ یَوْمَ جُمُعَۃٍ بَعْدَ الْعَصْرِ ، فَدَعَا بِمِقْصٍ فَقَلَّمَ أَظْفَارَہُ فَجَمَعَہَا ، قَالَ مَہْدِیٌّ : فَأَنْبَأَنَا ہِشَامٌ ، أَنَّہُ کَانَ یَأْمُرُ بِہَا أَنْ تُدْفَنَ۔","","Musannaf Ibn Abi Shaybah 26177","","","كتاب الأدب"
"26178","(۲۶۱۷۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : دَخَلْت مَسْجِدَ الْمَدِینَۃِ فَإِذَا عَبْدُ اللہِ بْنُ سَلاَمٍ ، فَسَلَّمْت ثُمَّ جَلَسْت ، فَقَالَ : یَا ابْنَ أَخِی ، إنَّک جَلَسْت وَنَحْنُ نُرِیدُ الْقِیَامَ۔","Da'if","Musannaf Ibn Abi Shaybah 26178","","","كتاب الأدب"
"26179","(۲۶۱۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَشْعَثَ ، قَالَ : حدَّثَنِی رَجُلٌ ، أَنَّ رَجُلاً جَلَسَ إلَی الْحَسَنِ فَقَالَ لَہُ : جَلَسْت إلَیْنَا عَلَی حِینِ قِیَامٍ مِنَّا ، أَفَتَأْذَنُ۔","","Musannaf Ibn Abi Shaybah 26179","","","كتاب الأدب"
"26180","(۲۶۱۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ، عَنْ أَبِی مِجْلَزٍ ، قَالَ: إذَا جَلَسَ إلَیْک رَجُلٌ مُتَعَمِّدًا فَلاَ تَقُمْ حَتَّی تَسْتَأْذِنَہُ۔","","Musannaf Ibn Abi Shaybah 26180","","","كتاب الأدب"
"26181","(۲۶۱۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ رَجُلٍ ، عَنْ إبْرَاہِیمَ مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 26181","","","كتاب الأدب"
"26182","(۲۶۱۸۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ: مَا جَلَسَ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحَدٌ فَقَامَ حَتَّی یَقُومَ۔","Hasan","Musannaf Ibn Abi Shaybah 26182","","","كتاب الأدب"
"26183","(۲۶۱۸۳) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ، عَنْ مُحَمَّدٍ، قَالَ: کَانَ لاَ یَرَی بَأْسًا إذَا جَلَسَ الرَّجُلُ إلَی الرَّجُلِ أَنْ یَقُومَ، وَلاَ یَسْتَأْذِنَہُ۔","","Musannaf Ibn Abi Shaybah 26183","","","كتاب الأدب"
"26184","(۲۶۱۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ نَافِعٍ ، قَالَ : قعَدْت إلَی سَعِیدِ بْنِ جُبَیْرٍ ، فَلَمَّا أَرَادَ أَنْ یَقُومَ ، قَالَ : أَتَأْذَنُونَ ؟ إنَّکُمْ جَلَسْتُمْ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 26184","","","كتاب الأدب"
"26185","(۲۶۱۸۵) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مَنْصُورٍ ، عَنْ رِبْعِیٍّ ، قَالَ : حدَّثَنِی رَجُلٌ مِنْ بَنِی عَامِرٍ اسْتَأْذَنَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ فِی بَیْتٍ فَقَالَ : أَلِجُ ؟ فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِخَادِمِہِ : اخْرُجْ إلَی ہَذَا فَعَلِّمْہُ الاسْتِئْذَانَ وَقُلْ لَہُ : قُلِ السَّلاَمُ عَلَیْکُمْ أَدْخُلُ ؟ فَسَمِعَہُ الرَّجُلُ فَقَالَ : السَّلاَمُ عَلَیْکُمْ أَدْخُلُ ؟ فَأَذِنَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَدَخَلَ۔ (بخاری ۱۰۸۴۔ ابوداؤد ۵۱۳۴)","Sahih","Musannaf Ibn Abi Shaybah 26185","","","كتاب الأدب"
"26186","(۲۶۱۸۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ سَمِعَ عَامِرَ بْنَ عَبْدِ اللہِ بْنِ الزُّبَیْرِ یَقُولُ : حدَّثَتْنِی رَیْحَانَۃُ ، أَنَّ أَہْلَہَا أَرْسَلُوہَا إلَی عُمَرَ ، فَدَخَلَتْ عَلَیْہِ بِغَیْرِ إذْنٍ ، فَعَلَّمَہَا فَقَالَ لَہَا : اخْرُجِی فَسَلِّمِی ، فَإِذَا رُدَّ عَلَیْک فَاسْتَأْذِنِی۔","Da'if","Musannaf Ibn Abi Shaybah 26186","","","كتاب الأدب"
"26187","(۲۶۱۸۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ وَاصِلِ بْنِ السَّائِبِ ، عَنْ أَبِی سَوْرَۃَ ، عَنْ أَبِی أیُّوبَ الأَنْصَارِیِّ ، قَالَ : قلْنا یَا رَسُولَ اللہِ ، ہَذَا السَّلاَمُ فَمَا الاسْتِئْنَاسُ ، قَالَ : یَتَکَلَّمُ الرَّجُلُ بِتَسْبِیحَۃٍ وَتَکْبِیرَۃٍ وَتَحْمِیدَۃٍ ، وَیَتَنَحْنَحُ ، وَیُؤْذِنُ أَہْلَ الْبَیْتِ۔ (ابن ماجہ ۳۷۰۷)","Da'if","Musannaf Ibn Abi Shaybah 26187","","","كتاب الأدب"
"26188","(۲۶۱۸۸) حَدَّثَنَا یَحْیَی بْنُ مُحَمَّدٍ الْقُرَشِیُّ أَبُو زُکَیْرٍ سَمِعَ زَیْدَ بْنَ أَسْلَمَ یَقُولُ : بَعَثَنِی أَبِی إلَی ابْنِ عُمَرَ فَقُلْت : أَلِجُ ؟ فَقَالَ : لاَ تَقُلْ ہَکَذَا ، وَلَکِنْ قُلْ : السَّلاَمُ عَلَیْکُمْ ، فَإِذَا قِیلَ وَعَلَیْکُمْ ، فَادْخُلْ۔","Da'if","Musannaf Ibn Abi Shaybah 26188","","","كتاب الأدب"
"26189","(۲۶۱۸۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الْمُغِیرَۃِ ، عَنِ الْحَارِثِ ، عَنْ عَبْدِ اللہِ بْنِ نُجَیٍّ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ لِی مِنَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَدْخَلاَنِ : مَدْخَلٌ بِاللَّیْلِ ، وَمَدْخَلٌ بِالنَّہَارِ ، فَکُنْت إذَا أَتَیْتہ وَہُوَ یُصَلِّی یَتَنَحْنَحُ لِی۔","Hasan","Musannaf Ibn Abi Shaybah 26189","","","كتاب الأدب"
"26190","(۲۶۱۹۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : اسْتَأْذَنْت عَلَی عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی وَہُوَ یُصَلِّی بِالظَّلاَمِ فَفَتَحَ لِی۔","","Musannaf Ibn Abi Shaybah 26190","","","كتاب الأدب"
"26191","(۲۶۱۹۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ زُہْرَۃَ بْنِ حُمِیضَۃَ ، قَالَ : رَدَفْت أَبَا بَکْرٍ فَکُنَّا نَمُرُّ بِالْقَوْمِ فَنُسَلِّمُ عَلَیْہِمْ فَیَرُدُّونَ عَلَیْنَا أَکْثَرَ مِمَّا نُسَلِّمُ ، فَقَالَ أَبُو بَکْرٍ : مَا زَالَ النَّاسُ غَالِبِینَ لَنَا مُنْذُ الْیَوْمِ۔","Da'if","Musannaf Ibn Abi Shaybah 26191","","","كتاب الأدب"
"26192","(۲۶۱۹۲) حَدَّثَنَا غُنْدَرٌ وَأَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عُمَر ، قَالَ : کُنْتُ رِدْفَ أَبِی بَکْرٍ فَذَکَرَ ، مِثْلَہُ ، ثُمَّ قَالَ : لَقَدْ فَضَلَنَا النَّاسُ الْیَوْمَ بِخَیْرٍ کَثِیرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 26192","","","كتاب الأدب"
"26193","(۲۶۱۹۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : جَائَ رَجُلٌ إِلَی عَلِی فَقَالَ : السَّلاَمُ عَلَیْک یَا أَمِیرَ الْمُؤْمِنِینَ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، فَقَالَ : وَعَلَیْکُمْ فَظَنَّ أَنَّہُ لَمْ یَسْمَعْ فَقَالَ: السَّلاَمُ عَلَیْک یَا أَمِیرَ الْمُؤْمِنِینَ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، فَقَالَ : وَعَلَیْکُمْ ، فَقَالَ : أَلاَ تَرُدُّ عَلَیَّ لِمَا أَقُولُ لَکَ؟ قَالَ : أَلَیْسَ قَدْ فَعَلْت ؟۔","","Musannaf Ibn Abi Shaybah 26193","","","كتاب الأدب"
"26194","(۲۶۱۹۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، قَالَ : حدَّثَنِی سَعِیدُ بْنُ أَبِی سَعِیدٍ الْمَقْبُرِیُّ ، عَنْ أَبِی ہُرَیْرَۃَ، أَنَّ رَجُلاً دَخَلَ الْمَسْجِدَ وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَالِسٌ فِی نَاحِیَۃِ الْمَسْجِدِ ، فَصَلَّی ، ثُمَّ جَائَ فَسَلَّمَ عَلَیْہِ فَقَالَ : وَعَلَیْک السَّلاَمُ۔ (بخاری ۶۲۵۱۔ ترمذی ۲۶۹۲)","Sahih","Musannaf Ibn Abi Shaybah 26194","","","كتاب الأدب"
"26195","(۲۶۱۹۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عِمْرَانَ بْنِ أَبِی أَنَسٍ ، عَنْ مَالِکِ بْنِ أَوْسِ بْنِ الْحَدَثَانِ ، قَالَ : قدِمَ أَبُو ذَرٍّ مِنَ الشَّامِ فَدَخَلَ الْمَسْجِدَ وَفِیہِ عُثْمَانُ فَقَالَ : السَّلاَمُ عَلَیْکُمْ ، فَقَالَ : وَعَلَیْکُمُ السَّلاَمُ ، کَیْفَ أَنْتَ یَا أَبَا ذَرٍّ ؟ قَالَ : بِخَیْرٍ ، کَیْفَ أَنْتَ یَا عُثْمَانُ ؟۔ قَالَ : بِخَیر۔","Da'if","Musannaf Ibn Abi Shaybah 26195","","","كتاب الأدب"
"26196","(۲۶۱۹۶) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ ، عَنْ مَیْمُونٍ ، أَنَّ رَجُلاً سَلَّمَ عَلَی سَلْمَانَ الْفَارِسِیِّ فَقَالَ : السَّلاَمُ عَلَیْکُمْ وَرَحْمَۃُ اللہِ وَبَرَکَاتُہُ ، فَقَالَ : سَلْمَانُ : حَسْبُک حَسْبُک ، ثُمَّ رَدَّ عَلَیہ الَّذِی قَالَ ، ثُمَّ زَادَ أُخْرَی ، فَقَالَ لَہُ الرَّجُلُ : أَتَعْرِفُنِی یَا أَبَا عَبْدِ اللہِ ؟ فَقَالَ : أَمَّا رُوحِی فَقَدْ عَرَفَ رُوحَک۔","","Musannaf Ibn Abi Shaybah 26196","","","كتاب الأدب"
"26197","(۲۶۱۹۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ یَرُدُّ السَّلاَمَ کَمَا یُقَالَ لَہُ : السَّلاَمُ عَلَیْکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 26197","","","كتاب الأدب"
"26198","(۲۶۱۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجَلْدِ بْنِ أَیُّوبَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : أَوْصَانِی أَبِی ، قَالَ: إذَا سُلِّمَ عَلَیْک، فَلاَ تَقُلْ : وَعَلَیْک ، قُلْ : وَعَلَیْکُمْ ، فَإِنَّ مَعَہُ مَلاَئِکَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 26198","","","كتاب الأدب"
"26199","(۲۶۱۹۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی حَیَّانَ ، عَنْ عَبْدِ الرَّحْمَنِ الرَّحَّالِ ، قَالَ : کَانَ الرَّبِیعُ بْنُ خُثَیْمٍ إذَا رَدَّ السَّلاَمَ یَقُولُ : وَعَلَیْکُمْ یَعْنِی یَنْوِی الرَّدَّ عَلَی مَا سُلِّمَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 26199","","","كتاب الأدب"
"26200","(۲۶۲۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، أَنَّ شُرَیْحًا إذَا رَدَّ قَالَ : وَعَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 26200","","","كتاب الأدب"
"26201","(۲۶۲۰۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زَید بن وَہب ، أَنَّہُ کَانَ إذَا سُلِّمَ عَلَیْہِ قَالَ : وَعَلَیْکُمُ السَّلاَمُ وَرَحْمۃ اللہ وَبَرَکَاتُہ وَمَغْفِرَتہ۔","","Musannaf Ibn Abi Shaybah 26201","","","كتاب الأدب"
"26202","(۲۶۲۰۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، قَالَ: إذَا رَدَّ الرَّجُلُ فَلْیَقُلْ: وَعَلَیْکُمْ - یَعْنِی مَعَہُ الْمَلاَئِکَۃُ۔","","Musannaf Ibn Abi Shaybah 26202","","","كتاب الأدب"
"26203","(۲۶۲۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، وَابْنُ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ إذَا رَدَّ ، قَالَ : وَعَلَیْکُمْ وَرَحْمَۃُ اللہِ۔","","Musannaf Ibn Abi Shaybah 26203","","","كتاب الأدب"
"26204","(۲۶۲۰۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ إذَا رَدَّ ، قَالَ : وَعَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 26204","","","كتاب الأدب"
"26205","(۲۶۲۰۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ غَالِبٍ ، قَالَ : إنَّا لَجُلُوسٌ بِبَابِ الْحَسَنِ إذْ جَائَہُ رَجُلٌ ، فَقَالَ : حَدَّثَنِی أَبِی ، عَنْ جَدِّی ، قَالَ : بَعَثَنِی أَبِی إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : ائْتِہِ فَأَقْرِئْہُ السَّلاَمَ ، فَأَتَیْتہ فَقُلْت : إنَّ أَبِی یُقْرِئُک السَّلاَمَ ، فَقَالَ : وَعَلَیْک وَعَلَی أَبِیک السَّلاَمُ۔ (ابوداؤد ۵۱۸۹۔ احمد ۵/۳۶۶)","Da'if","Musannaf Ibn Abi Shaybah 26205","","","كتاب الأدب"
"26206","(۲۶۲۰۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدِ بْنِ أَبِی الْمُجَالِدِ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : قُلْتُ لَہُ : إنَّ بَنِی أَخِیک یُقْرِئُونَک السَّلاَمَ ، ثُمَّ أَہْلَ الْمَسْجِدِ ، قَالَ : وَعَلَیْک وَعَلَیْہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 26206","","","كتاب الأدب"
"26207","(۲۶۲۰۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، قَالَ : قَالَ لی عَبْدُ اللہِ : إذَا لَقِیت عُمَرَ ، أَوْ کَلِمَۃٌ نَحْوُہَا ، فَأَقْرِئْہُ السَّلاَمَ ، قَالَ : فَلَقِیتہ فَأَقْرَأْتہ فَقَالَ : عَلَیْہِ ، أَوْ وَعَلَیْہِ السَّلاَمُ وَرَحْمَۃُ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 26207","","","كتاب الأدب"
"26208","(۲۶۲۰۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی سَلَمَۃَ ، أَنَّ عَائِشَۃَ حَدَّثَتْہُ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لَہَا : إنَّ جِبْرِیلَ یَقْرَأُ عَلَیْک السَّلاَمَ ، فَقَالَتْ : وَعَلَیْہِ السَّلاَمُ وَرَحْمَۃُ اللہِ۔n(بخاری ۶۲۵۳۔ ترمذی ۲۶۹۳)","Sahih","Musannaf Ibn Abi Shaybah 26208","","","كتاب الأدب"
"26209","(۲۶۲۰۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ وَأَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ إذَا قِیلَ لَہُ إنَّ فُلاَنًا یُقْرِئُک السَّلاَمَ ، قَالَ : وَعَلَیْک وَعَلَیْہِ السَّلاَمُ۔","","Musannaf Ibn Abi Shaybah 26209","","","كتاب الأدب"
"26210","(۲۶۲۱۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ الجلدِ بْنِ أَیُّوبَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ أَبِیہِ ، قَالَ : أوْصَانِی أَبِی ، قَالَ : إذَا لَقِیت رَجُلاً فَلاَ تَقُلْ : السَّلاَمُ عَلَیْک ، قُلْ : السَّلاَمُ عَلَیْکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 26210","","","كتاب الأدب"
"26211","(۲۶۲۱۱) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ زِیَادِ بْنِ بَیَانٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، أَنَّ رَجُلاً سَلَّمَ عَلَی أَبِی بَکْرٍ فَقَالَ : السَّلاَمُ عَلَیْک یَا خَلِیفَۃَ رَسُولِ اللہِ ، فَقَالَ أَبُو بَکْرٍ : مِنْ بَیْنِ ہَؤُلاَئِ أَجْمَعِینَ۔","","Musannaf Ibn Abi Shaybah 26211","","","كتاب الأدب"
"26212","(۲۶۲۱۲) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِالرَّحْمَنِ الرُّؤَاسِیُّ، عَنْ حَسَنِ بْنِ صَالِحٍ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ، عَنْ خَالِدِ بْنِ أبی الصَّلْتِ ، قَالَ : دَخَلَ ابْنُ سِیرِینَ عَلَی ابْنِ ہُبَیْرَۃَ فَقَالَ : السَّلاَمُ عَلَیْکُمْ ، فَقَالَ : ابْنُ ہُبَیْرَۃَ: مَا ہَذَا السَّلاَمُ؟ فَقَالَ: ہَکَذَا کَانَ یُسَلَّمُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ترمذی ۲۶۸۹۔ ابوداؤد ۵۱۵۳)","","Musannaf Ibn Abi Shaybah 26212","","","كتاب الأدب"
"26213","(۲۶۲۱۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عِمْرَانَ بْنِ أَبِی أَنَسٍ ، عَنْ مَالِکِ بْنِ أَوْسِ بْنِ الْحَدَثَانِ ، قَالَ : قدِمَ أَبُو ذَرٍّ مِنَ الشَّامِ فَدَخَلَ الْمَسْجِدَ وَفِیہِ عُثْمَانُ ، فَقَالَ : السَّلاَمُ عَلَیْکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 26213","","","كتاب الأدب"
"26214","(۲۶۲۱۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا حَسَن ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَ عمر إلَی بَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : السَّلاَمُ عَلَی رَسُولِ اللہِ ، السَّلاَمُ عَلَیْکُمْ۔ (بخاری ۱۰۸۵۔ احمد ۱/۳۲۵)","Hasan","Musannaf Ibn Abi Shaybah 26214","","","كتاب الأدب"
"26215","(۲۶۲۱۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَسَنٍ ، عَنْ مُجَالِدٍ ، قَالَ : کَانَ یُسَلَّمُ عَلَی عُمَرَ السَّلاَمُ عَلَیْک یَا أَمِیرَ الْمُؤْمِنِینَ ، السَّلاَمُ عَلَیْکُمْ یَعْنِی عَلَی مَنْ عِنْدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 26215","","","كتاب الأدب"
"26216","(۲۶۲۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَکْرَہُ أَنْ یَقُولَ السَّلاَمُ عَلَیْک حَتَّی یَقُولَ السَّلاَمُ عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 26216","","","كتاب الأدب"
"26217","(۲۶۲۱۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَلَّمَ الرَّجُلُ عَلَی الرَّجُلِ ، وَإِنْ کَانَ وَحْدَہُ فَلْیَقُلِ السَّلاَمُ عَلَیْکُمْ - یَعْنِی مَعَہُ الْمَلاَئِکَۃُ۔","","Musannaf Ibn Abi Shaybah 26217","","","كتاب الأدب"
"26218","(۲۶۲۱۸) أَبُو أُسَامَۃَ، عَنْ عَبْدِ الْمُؤْمِنِ، قَالَ: سَلَّمْت عَلَی رَجُلٍ یَمْشِی مَعَ مُسْلِمِ بْنِ یَسَارٍ فَقُلْت: السَّلاَمُ عَلَیْک، فَقَالَ لِی مُسْلِمٌ : مَہْ ، فَقُلْت : إنِّی عَرَفْتہ ، فَقَالَ : وَإِنْ إذَا سَلَّمْت فَقُلْ : السَّلاَمُ عَلَیْکُمْ ، فَإِنَّ مَعَہُ حَفَظَۃٌ۔","","Musannaf Ibn Abi Shaybah 26218","","","كتاب الأدب"
"26219","(۲۶۲۱۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَبِی غِفَارٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : جَائَ رَجُلٌ إلَی سَلْمَانَ ، فَقَالَ : إنَّ فُلاَنًا یُقْرِئُک السَّلاَمَ ، فَقَالَ : مُذْ کَمْ ؟ فَذَکَرَ أَیَّامًا فَقَالَ : أَمَا لَوْ لَمْ تَفْعَلْ لَکَانَتْ أَمَانَۃً تُؤَدِّیہَا۔","Hasan","Musannaf Ibn Abi Shaybah 26219","","","كتاب الأدب"
"26220","(۲۶۲۲۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنِ ابْنِ الْحَنَفِیَّۃِ ؛ فِی الرَّجُلِ یَقُولُ : أقْرِئْ فُلاَنًا السَّلاَمَ ، قَالُوا : ہِیَ أَمَانَۃٌ إلاَّ أَنْ یَنْسَی۔","","Musannaf Ibn Abi Shaybah 26220","","","كتاب الأدب"
"26221","(۲۶۲۲۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، قَالَ : قُلْتُ لأَبِی مِجْلَزٍ : قَوْلُ الرَّجُلِ لِلرَّجُلِ : أَقْرِئْ فُلاَنًا السَّلاَمَ ، وَلاَ حَرَجَ ، قَالَ : ہِیَ أَمَانَۃٌ ، وَإذَا قَالَ : أُبَلِّغُ عَنْک ، کَانَ فِی سَعَۃٍ۔","","Musannaf Ibn Abi Shaybah 26221","","","كتاب الأدب"
"26222","(۲۶۲۲۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَبِی غِفَارٍ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ، عَنْ أَبِی جُرَیٍّ الْہُجَیْمِیِّ ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْت : عَلَیْک السَّلاَمُ یَا رَسُولَ اللہِ ، قَالَ : لاَ تَقُلْ : عَلَیْک السَّلاَمُ ، فَإِنَّ عَلَیْک السَّلاَمُ تَحِیَّۃُ الْمَوْتَی۔","Hasan","Musannaf Ibn Abi Shaybah 26222","","","كتاب الأدب"
"26223","(۲۶۲۲۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، أَنَّ رَجُلاً سَلَّمَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : عَلَیْک السَّلاَمُ یَا نبی اللہِ ، فَکَرِہَ ذَلِکَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَالَ : تِیکَ تَحِیَّۃُ الْمَوْتَی۔","","Musannaf Ibn Abi Shaybah 26223","","","كتاب الأدب"
"26224","(۲۶۲۲۴) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ : عَلَیْکُمُ السَّلاَمُ ، إنَّمَا قَالَ : {وَسَلاَمٌ عَلَی الْمُرْسَلِینَ}۔","","Musannaf Ibn Abi Shaybah 26224","","","كتاب الأدب"
"26225","(۲۶۲۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ نَافِعٍ ، قَالَ : کُنْتُ أَسِیرُ مَعَ عَبْدِ اللہِ بْنِ أَبِی زَکَرِیَّا فِی أَرْضِ الرُّومِ ، فَبَالَتْ دَابَّتِی ، فَقَامَتْ فَبَالَتْ ، فَلَحِقْتُہُ فَقَالَ : أَلاَ سَلَّمْتَ ؟ فَقُلْت : إنَّمَا فَارَقْتُک الآنَ ، قَالَ : وَإِنْ فَارَقْتَنِی ، کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَسَایَرُونَ فَتَفْرُقُ بَیْنَہُمُ الشَّجَرَۃُ فَیَلْتَقُونَ فَیُسَلِّمُ بَعْضُہُمْ عَلَی بَعْضٍ۔","","Musannaf Ibn Abi Shaybah 26225","","","كتاب الأدب"
"26226","(۲۶۲۲۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ الرَّجُلاَنِ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَسَایَرَانِ فَتَفْرُقُ بَیْنَہُمَا الشَّجَرَۃُ فَیَلْتَقِیَانِ فَیُسَلِّمُ أَحَدُہُمَا عَلَی الآخَرِ۔","Hasan","Musannaf Ibn Abi Shaybah 26226","","","كتاب الأدب"
"26227","(۲۶۲۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، وَسَعِیدِ بْنِ جُبَیْرٍ أَنَّہُمَا کَانَا یَشْکِیَانِ بُطُونَہُمَا فَیَجِیئَانِ فَیُسَلِّمَانِ۔","","Musannaf Ibn Abi Shaybah 26227","","","كتاب الأدب"
"26228","(۲۶۲۲۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ : کَانَ لاَ یُفَارِقُنِی إلاَّ عَلَی سَلاَمٍ ، أَجِیئُ ، ثُمَّ أَذْہَبُ فَیُسَلِّمُ عَلَیَّ ، ثُمَّ أَجِیئُ ، ثُمَّ أَذْہَبُ فَیُسَلِّمُ عَلَیَّ۔","","Musannaf Ibn Abi Shaybah 26228","","","كتاب الأدب"
"26229","(۲۶۲۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : إِنْ کَانَ الرَّجُلُ مِنْہُمْ لَیُفَارِقُ صَاحِبَہُ ، مَا یَحُولُ بَیْنَہُ إلاَّ شَجَرَۃٌ ، ثُم یَلقَاہُ فَیُسَلِّمُ عَلَیہ۔","","Musannaf Ibn Abi Shaybah 26229","","","كتاب الأدب"
"26230","(۲۶۲۳۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، قَالَ : تَذَاکَرُوا الْمُصَافَحَۃَ فَقَالَ النُّعْمَانُ بْنُ حُمَیْدٍ : دَخَلْت عَلَی سَلْمَانَ مَعَ خَالِی عَبَّادِ بْنِ شُرَحْبِیلَ ، فَلَمَّا رَآہُ صَافَحَہُ سَلْمَانُ۔","Da'if","Musannaf Ibn Abi Shaybah 26230","","","كتاب الأدب"
"26231","(۲۶۲۳۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، وَابْنُ نُمَیْرٍ ، عَنِ الأَجْلَحِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مِنْ مُسْلِمَیْنِ یَلْتَقِیَانِ فَیَتَصَافَحَانِ إلاَّ غُفِرَ لَہُمَا قَبْلَ أَنْ یَتَفَرَّقَا۔n(ابوداؤد ۵۱۷۰۔ ابن ماجہ ۳۷۰۳)","Hasan","Musannaf Ibn Abi Shaybah 26231","","","كتاب الأدب"
"26232","(۲۶۲۳۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَنْظَلَۃَ السَّدُوسِیِّ ، عَنْ أَنَسٍ ، قَالَ : قلْنَا : یَا رَسُولَ اللہِ ، أَیُصَافِحُ بَعْضُنَا بَعْضًا ؟ قَالَ : نَعَمْ۔ (ترمذی ۲۷۲۸۔ احمد ۳/۱۹۸)","Da'if","Musannaf Ibn Abi Shaybah 26232","","","كتاب الأدب"
"26233","(۲۶۲۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّ أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کَانَ یُصَافِحُ بَعْضُہُمْ بَعْضًا۔ (بخاری ۶۲۶۳۔ ترمذی ۲۷۲۹)","Sahih","Musannaf Ibn Abi Shaybah 26233","","","كتاب الأدب"
"26234","(۲۶۲۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ غَالِبٍ ، قَالَ: قُلْتُ لِلشَّعْبِیِّ : إنَّ ابْنَ سِیرِینَ کَانَ یَکْرَہُ الْمُصَافَحَۃَ ، قَالَ: فَقَالَ الشَّعْبِیُّ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَصَافَحُونَ ، وَإِذَا قَدِمَ أَحَدُہُمْ مِنْ سَفَرٍ عَانَقَ صَاحِبَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 26234","","","كتاب الأدب"
"26235","(۲۶۲۳۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : سَأَلْتُ ابْنَ عَوْنٍ ، عَنِ الْمُصَافَحَۃِ ، قَالَ : کَانَ مُحَمَّدٌ لاَ یَفْعَلُہُ بِنَا ، وَلاَ نَفْعَلُہُ بِہِ ، وَکَانَ إذَا مَدَّ رَجُلٌ یَدَہُ ، لَمْ یَمْنَعْ یَدَہُ مِنْ أَحَدٍ۔","","Musannaf Ibn Abi Shaybah 26235","","","كتاب الأدب"
"26236","(۲۶۲۳۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنِ ابْنِ الأَسْوَدِ ، قَالَ : إنَّ مِنْ تَمَامِ التَّحِیَّۃِ الْمُصَافَحَۃَ۔","","Musannaf Ibn Abi Shaybah 26236","","","كتاب الأدب"
"26237","(۲۶۲۳۷) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، قَالَ : إنَّ مِنْ تَمَامِ التَّحِیَّۃِ الْمُصَافَحَۃَ۔","","Musannaf Ibn Abi Shaybah 26237","","","كتاب الأدب"
"26238","(۲۶۲۳۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ یَحْیَی بن أَیُّوبَ ، عَنْ عُبَیْدِ اللہِ بْنِ زَحْرٍ ، عَنْ عَلِیِّ بْنِ یَزِیدَ ، عَنِ الْقَاسِمِ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَمَامُ تَحِیَّتِکُمُ الْمُصَافَحَۃُ۔ (ترمذی ۲۷۳۱)","Da'if","Musannaf Ibn Abi Shaybah 26238","","","كتاب الأدب"
"26239","(۲۶۲۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی عَبْدِ اللہِ الْعَسْقَلاَنِیِّ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی ابْنَ مُحَیْرِیزٍ یُصَافِحُ نَصْرَانِیًّا فِی مَسْجِدِ دِمَشْقَ۔","Da'if","Musannaf Ibn Abi Shaybah 26239","","","كتاب الأدب"
"26240","(۲۶۲۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُصَافِحَ الْمُسْلِمُ الْیَہُودِیَّ ، وَالنَّصْرَانِیَّ۔","","Musannaf Ibn Abi Shaybah 26240","","","كتاب الأدب"
"26241","(۲۶۲۴۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : إنَّمَا الْمُشْرِکُونَ نَجَسٌ فَلاَ تُصَافِحُوہُمْ ، فَمَنْ صَافَحَہُمْ فَلْیَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 26241","","","كتاب الأدب"
"26242","(۲۶۲۴۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : سَأَلْتُہ عَنْ مُصَافَحَۃِ الْمَجُوسِیِّ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 26242","","","كتاب الأدب"
"26243","(۲۶۲۴۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَلَقَّی جَعْفَرَ بْنَ أَبِی طَالِبٍ فَالْتَزَمَہُ ، وَقَبَّلَ مَا بَیْنَ عَیْنَیْہِ۔ (ابوداؤد ۵۱۷۸۔ حاکم ۶۲۴)","","Musannaf Ibn Abi Shaybah 26243","","","كتاب الأدب"
"26244","(۲۶۲۴۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حَجَّاجِ بْنِ دِینَارٍ ، عَنْ عُتْبَۃَ بن أَبِی عُثْمَانَ ، أَنَّ عُمَرَ اعْتَنَقَ حُذَیْفَۃَ۔","","Musannaf Ibn Abi Shaybah 26244","","","كتاب الأدب"
"26245","(۲۶۲۴۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بَلْجٍ ، قَالَ : رَأَیْتُ عَمْرَو بْنَ مَیْمُونٍ وَالأَسْوَدَ بْنَ ہلال الْتَقَیَا وَاعْتَنَقَ کُلٌّ مِنْہُمَا صَاحِبَہُ۔","","Musannaf Ibn Abi Shaybah 26245","","","كتاب الأدب"
"26246","(۲۶۲۴۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عَبَّادِ بْنِ عَبَّادٍ ، قَالَ : رَأَیْتُ أَبَا مِجْلَزٍ وَخَالِدًا الأَثْبَجَ الْتَقَیَا ، فَاعْتَنَقَ کُلٌّ مِنْہُمَا صَاحِبَہُ۔","","Musannaf Ibn Abi Shaybah 26246","","","كتاب الأدب"
"26247","(۲۶۲۴۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ إیَاسِ بْنِ دَغْفَلٍ ، قَالَ : رَأَیْتُ أَبَا نَضْرَۃَ قَبَّلَ خَدَّ الْحَسَنِ۔","","Musannaf Ibn Abi Shaybah 26247","","","كتاب الأدب"
"26248","(۲۶۲۴۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا ثَابِتٌ ، عَنْ مُعَاذَۃَ الْعَدَوِیَّۃِ ، قَالَتْ : کَانَ أَصْحَابُ صِلَۃِ بْنِ أَشْیَمَ إذَا دَخَلُوا عَلَیْہِ یَلْتزِم بَعْضُہُمْ بَعْضًا۔","","Musannaf Ibn Abi Shaybah 26248","","","كتاب الأدب"
"26249","(۲۶۲۴۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : حَدَّثَنَا الْحَسَنُ ، عَنِ الْمُہَاجِرِ بْنِ قُنْفُذٍ ، أَنَّہُ سَلَّمَ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَبُولُ فَلَمْ یَرُدَّ عَلَیْہِ حَتَّی فَرَغَ۔n(ابوداؤد ۱۸۔ ابن ماجہ ۳۵۰)","Hasan","Musannaf Ibn Abi Shaybah 26249","","","كتاب الأدب"
"26250","(۲۶۲۵۰) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ ، عَنْ سُفْیَانَ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَرَّ رَجُلٌ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَبُولُ ، فَسَلَّمَ عَلَیْہِ فَلَمْ یَرُدَّ عَلَیْہِ۔ (مسلم ۱۱۵۔ ترمذی ۹۰)","Sahih","Musannaf Ibn Abi Shaybah 26250","","","كتاب الأدب"
"26251","(۲۶۲۵۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ الأَلْہَانِیِّ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : أَمَرَنَا نَبِیُّنَا صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ نُفْشِیَ السَّلاَمَ۔ (ابن ماجہ ۳۶۹۳۔ طبرانی ۷۵۲۴)","Hasan","Musannaf Ibn Abi Shaybah 26251","","","كتاب الأدب"
"26252","(۲۶۲۵۲) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِلْمُسْلِمِ عَلَی الْمُسْلِمِ یُسَلِّمُ عَلَیْہِ إذَا لَقِیَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 26252","","","كتاب الأدب"
"26253","(۲۶۲۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اعْبُدُوا الرَّحْمَان ، وَأَفْشُوا السَّلاَمَ۔ (بخاری ۹۸۱۔ ابن ماجہ ۳۶۹۴)","Da'if","Musannaf Ibn Abi Shaybah 26253","","","كتاب الأدب"
"26254","(۲۶۲۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، قَالَ : حدَّثَنِی عَبْدُ اللہِ بْنُ سَلاَمٍ ، قَالَ : لَمَّا قَدِمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمَدِینَۃَ انْجَفَلَ النَّاسُ قِبَلَہُ ، وَقِیلَ : قَدِمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَجِئْت فِی النَّاسِ لأَنْظُرَ ، فَلَمَّا تَبَیَّنْت وَجْہَہُ ، عَرَفْت أَنَّ وَجْہَہُ لَیْسَ بِوَجْہِ کَذَّابٍ ، فَکَانَ أَوَّلَ شَیْئٍ سَمِعْتہ یَتَکَلَّمُ بِہِ أَنْ قَالَ : یَا أَیُّہَا النَّاسُ ، أَفْشُوا السَّلاَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 26254","","","كتاب الأدب"
"26255","(۲۶۲۵۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ الْمُحَارِبِیِّ ، عَنْ مُعَاوِیَۃَ بْنِ سُوَیْد ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : أَمَرَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِإِفْشَائِ السَّلاَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 26255","","","كتاب الأدب"
"26256","(۲۶۲۵۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَالَّذِی نَفْسِی بِیَدِہِ ، لاَ تَدْخُلُوا الْجَنَّۃَ حَتَّی تُؤْمِنُوا ، وَلاَ تُؤْمِنُوا حَتَّی تَحَابُّوا ، أَلاَ أَدُلُّکُمْ عَلَی أَمْرٍ إذَا فَعَلْتُمُوہُ تَحَابَبْتُمْ ؟ أَفْشُوا السَّلاَمَ ۔ (مسلم ۹۳۔ ترمذی ۲۶۸۸)","Sahih","Musannaf Ibn Abi Shaybah 26256","","","كتاب الأدب"
"26257","(۲۶۲۵۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ ، عَنْ عَلِیٍّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ فِی الْجَنَّۃِ غُرَفًا تُرَی ظُہُورُہَا مِنْ بُطُونِہَا ، وَبُطُونُہَا مِنْ ظُہُورِہَا ، فَقَامَ أَعْرَابِیٌّ فَقَالَ : لِمَنْ ہِیَ یَا رَسُولَ اللہِ ؟ قَالَ : ہِیَ لِمَنْ قَالَ طَیَّبَ الْکَلاَمَ ، وَأَطْعَمَ الطَّعَامَ ، وَأَفْشَی السَّلاَمَ ، وَصَلَّی بِاللَّیْلِ وَالنَّاسُ نِیَامٌ۔ (ترمذی ۱۲۳۔ ابویعلی ۴۳۴)","Da'if","Musannaf Ibn Abi Shaybah 26257","","","كتاب الأدب"
"26258","(۲۶۲۵۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا شَیْبَانُ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ یَعیش بن الْوَلِیدِ ، عَنْ مَوْلًی لِلزُّبَیْرِ ، عَنِ الزُّبَیْرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلاَ أُنَبِّئُکُمْ بِأَمْرٍ إذَا فَعَلْتُمُوہُ تَحَابَبْتُمْ ؟ أَفْشُوا السَّلاَمَ بَیْنَکُمْ۔ (احمد ۱۶۴۔ بیہقی ۲۳۲)","Da'if","Musannaf Ibn Abi Shaybah 26258","","","كتاب الأدب"
"26259","(۲۶۲۵۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : إنَّ السَّلاَمَ اسْمٌ مِنْ أَسْمَائِ اللہِ فَأَفْشُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26259","","","كتاب الأدب"
"26260","(۲۶۲۶۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إِنْ کُنْت لأَخْرُجُ إلَی السُّوقِ وَمَا لِی حَاجَۃٌ إلاَّ أَنْ أُسَلِّمَ وَیُسَلَّمَ عَلَیَّ۔","Sahih","Musannaf Ibn Abi Shaybah 26260","","","كتاب الأدب"
"26261","(۲۶۲۶۱) حَدَّثَنَا حَفْصٌ، عَنْ عَاصِمٍ، عَنْ أَبِی عُثْمَانَ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: إنَّ أَبْخَلَ النَّاسِ الَّذِی یَبْخَلُ بِالسَّلاَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 26261","","","كتاب الأدب"
"26262","(۲۶۲۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمَّارٍ الدُّہْنِیِّ ، عَنْ رَجُلٍ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَتَبَ إلَی رَجُلٍ مِنْ أَہْلِ الْکِتَابِ : السَّلاَمُ عَلَیْک۔","Da'if","Musannaf Ibn Abi Shaybah 26262","","","كتاب الأدب"
"26263","(۲۶۲۶۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا کَتَبْت إلَی الْیَہُودِیِّ وَالنَّصْرَانِیِّ فِی الْحَاجَۃِ فَابْدَأْہُ بِالسَّلاَمِ ، وَقَالَ مُجَاہِدٌ : اکْتُبِ السَّلاَمُ عَلَی مَنِ اتَّبَعَ الْہُدَی۔","","Musannaf Ibn Abi Shaybah 26263","","","كتاب الأدب"
"26264","(۲۶۲۶۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا الْمَسْعُودِیُّ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، قَالَ : سَأَلَ مُحَمَّدُ بْنُ کَعْبٍ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ عَنِ ابْتِدَائِ أَہْلِ الذِّمَّۃِ بِالسَّلاَمِ فَقَالَ : تَرُدُّ عَلَیْہِمْ ، وَلاَ تَبْتَدِئہُمْ ، فَقُلْت : فَکَیْفَ تَقُولُ أَنْتَ ؟ فقَالَ : مَا أَرَی بَأْسًا أَنْ تَبْتَدِئہُمْ ، قُلْتُ : لِمَ ؟ قَالَ : لِقَوْلِ اللہِ {فَاصْفَحْ عَنْہُمْ وَقُلْ سَلاَمٌ فَسَوْفَ یَعْلَمُونَ}۔","","Musannaf Ibn Abi Shaybah 26264","","","كتاب الأدب"
"26265","(۲۶۲۶۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ الأَلْہَانِیِّ وَشُرَحْبِیلُ بْنُ مُسْلِمٍ ، عَنْ أَبِی أُمَامَۃَ ، أَنَّہُ کَانَ لاَ یَمُرُّ بِمُسْلِمٍ ، وَلاَ یَہُودِیٍّ ، وَلاَ نَصْرَانِیٍّ إلاَّ بَدَأَہُ بِالسَّلاَمِ۔","Hasan","Musannaf Ibn Abi Shaybah 26265","","","كتاب الأدب"
"26266","(۲۶۲۶۶) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ ابْنِ عَجْلاَنَ ، أَنَّ عَبْدَ اللہِ وَأَبَا الدَّرْدَائِ وَفَضَالَۃَ بْنَ عُبَیْدٍ کَانُوا یَبْدَؤُونَ أَہْلَ الشِّرْکِ بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 26266","","","كتاب الأدب"
"26267","(۲۶۲۶۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ أَبِی عِیسَی ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّ مِنْ رَأْسِ التَّوَاضُعِ أَنْ تَبْدَأَ بِالسَّلاَمِ مَنْ لَقِیتَ۔","Da'if","Musannaf Ibn Abi Shaybah 26267","","","كتاب الأدب"
"26268","(۲۶۲۶۸) حَدَّثَنَا عَفَان قَالَ : حدَّثَنَا عَبْدُ الوَاحِدِ بْنُ زِیَادٍ ، قَالَ : حَدَّثَنَا عَاصِمٌ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَ أَبُو بُرْدَۃَ إلَی رَجُلٍ مِنْ أَہْلِ الذِّمَّۃِ یُسَلِّمُ عَلَیْہِ ، فَقِیلَ لَہُ : لِمَ قُلْتُ لَہُ ؟ فَقَالَ : إِنَّہُ بَدَأَنِی بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 26268","","","كتاب الأدب"
"26269","(۲۶۲۶۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، عَنْ حَاتِمِ بْنِ أَبِی صَغِیرَۃَ ، عَنْ عَطِیَّۃَ وَکَانَ کَاتِبًا لِعَبْدِ اللہِ بْنِ مُطَرِّفِ بْنِ الشِّخِّیرِ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ مُطَرِّفِ بْنِ الشِّخِّیرِ یَقُولُ : مَا عَلَی وجہ الأَرْضِ رَجُلٌ یَبْدَأُ آخَرَ بِالسَّلاَمِ إلاَّ کَانَ ذَلِکَ صَدَقَۃً عَلَیْہِ إلَی یَوْمِ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 26269","","","كتاب الأدب"
"26270","(۲۶۲۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : إنَّ الرَّجُلَ إذَا مَرَّ بِالْقَوْمِ فَسَلَّمَ عَلَیْہِمْ فَرَدُّوا عَلَیْہِ کَانَ لَہُ فَضْلُ دَرَجَۃٍ عَلَیْہِمْ لأَنَّہُ أَذْکَرَہُمُ السَّلاَمَ۔","Sahih","Musannaf Ibn Abi Shaybah 26270","","","كتاب الأدب"
"26271","(۲۶۲۷۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ أَبِی عَاصِمٍ ، قَالَ : قَالَ عَبْدُ اللہِ : الْبَادِئُ بِالسَّلاَمِ یُرْبِی عَلَی صَاحِبِہِ فِی الأَجْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 26271","","","كتاب الأدب"
"26272","(۲۶۲۷۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : مَا الْتَقَی رَجُلاَنِ قَطُّ إلاَّ کَانَ أَوْلاَہُمَا بِاللَّہِ الَّذِی یَبْدَأُ بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 26272","","","كتاب الأدب"
"26273","(۲۶۲۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، أَنَّہُ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَاسٌ مِنَ الْیَہُودِ فَقَالُوا : السَّامُ عَلَیْک یَا أَبَا الْقَاسِمِ ، فَقَالَ : وَعَلَیْکُمْ۔ (مسلم ۱۱۔ احمد ۲۲۹)","Sahih","Musannaf Ibn Abi Shaybah 26273","","","كتاب الأدب"
"26274","(۲۶۲۷۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ وَمُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: إذَا سَلَّمَ عَلَیْکُمْ أَحَدٌ مِنْ أَہْلِ الْکِتَابِ فَقُولُوا: وَعَلَیْکُمْ۔ (مسلم ۱۷۰۵۔ ابوداؤد ۵۱۶۵)","Sahih","Musannaf Ibn Abi Shaybah 26274","","","كتاب الأدب"
"26275","(۲۶۲۷۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَرْثَدِ بْنِ عَبْدِ اللہِ الْیَزَنِیِّ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ الْجُہَنِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی رَاکِبٌ غَدًا إلَی یَہُود فَلاَ تَبْدَؤُوہُمْ بِالسَّلاَمِ ، فَإِذَا سَلَّمُوا عَلَیْکُمْ فَقُولُوا : وَعَلَیْکُمْ۔ (ابن ماجہ ۳۶۹۹۔ احمد ۴/۱۴۴)","Hasan","Musannaf Ibn Abi Shaybah 26275","","","كتاب الأدب"
"26276","(۲۶۲۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ الْیَہُودَ إذَا لَقُوکُمْ وَقَالُوا : السَّامُ عَلَیْکُمْ ، فَقُولُوا لَہُمْ : وَعَلَیْکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 26276","","","كتاب الأدب"
"26277","(۲۶۲۷۷) حَدَّثَنَا أَبُو أُسَامَۃَ وَوَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ حُمَیْدِ بْنِ زَادَوَیْہِ ، عَنْ أَنَسٍ ، قَالَ : نُہِینَا ، أَوْ أُمِرْنَا أَنْ لاَ نَزِیدَ أَہْلَ الْکِتَابِ عَلَی وَعَلَیْکُمْ۔ (احمد ۳/۱۱۳)","Da'if","Musannaf Ibn Abi Shaybah 26277","","","كتاب الأدب"
"26278","(۲۶۲۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَرْثَدِ بْنِ عَبْدِ اللہِ الْیَزَنِیِّ ، عَنْ أَبِی بَصْرَۃَ الْغِفَارِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّا غَادُونَ إلَی یَہُودَ فَلاَ تَبْدَؤُوہُمْ بِالسَّلاَمِ ، فَإِنْ سَلَّمُوا فَقُولُوا : وَعَلَیْکُمْ۔ (مسندہ ۶۶۸)","","Musannaf Ibn Abi Shaybah 26278","","","كتاب الأدب"
"26279","(۲۶۲۷۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ سَلَّمَ عَلَیْکُمْ مِنْ خَلْقِ اللہِ فَرُدُّوا عَلَیْہِمْ ، وَإِنْ کَانَ یَہُودِیًّا ، أَوْ نَصْرَانِیًّا ، أَوْ مَجُوسِیًّا۔","","Musannaf Ibn Abi Shaybah 26279","","","كتاب الأدب"
"26280","(۲۶۲۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ مَعَنْ، عَنْ إبْرَاہِیمَ ، قَالَ: إذَا سَلَّمَ عَلَیْک الرَّجُلُ مِنْ أَہْلِ الْکِتَابِ فَقُلْ وَعَلَیْک۔","","Musannaf Ibn Abi Shaybah 26280","","","كتاب الأدب"
"26281","(۲۶۲۸۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : إذَا سَلَّمَ عَلَیْکُمْ یَہُودِیٌّ ، أَوْ نَصْرَانِیٌّ فَقُولُوا : وَعَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 26281","","","كتاب الأدب"
"26282","(۲۶۲۸۲) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃ بْنِ وَہْرَام ، عَنْ طَاوُوسٍ ، قَالَ : کَانَ إذَا سَلَّمَ عَلَیْہِ الْیَہُودِیُّ وَالنَّصْرَانِیُّ ، قَالَ : عَلاَک السَّلاَمُ۔","","Musannaf Ibn Abi Shaybah 26282","","","كتاب الأدب"
"26283","(۲۶۲۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، وَعَنْ أَبِی مَعْشَرٍ، عَنْ إبْرَاہِیمَ، وَعَنْ حَمَّادٍ، عَنْ إبْرَاہِیمَ ، قَالاَ : إذَا قُلْتَ حَیَّاک اللَّہُ ، فَقُلْ : بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 26283","","","كتاب الأدب"
"26284","(۲۶۲۸۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَجِیدِ ، قَالَ : کَانَ الحسن یَکْرَہُ أَنْ یَقُولَ الرَّجُلُ حَیَّاک اللَّہُ إلاَّ أَنْ یَقُولَ : بِالسَّلاَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 26284","","","كتاب الأدب"
"26285","(۲۶۲۸۵) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنَْابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، قَالَ : جَائَنَا مَیْمُونُ بْنُ مِہْرَانَ فَقَالَ لَہُ رَجُلٌ حَیَّاک اللَّہُ فَقَالَ : لاَ تَقُلْ ہَکَذَا ، ہَذِہِ تَحِیَّۃُ الشَّبابِّ ، وَلَکِنْ قُلْ : حَیَّاکُمَ اللَّہُ بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 26285","","","كتاب الأدب"
"26286","(۲۶۲۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إذَا قَالَ الرَّجُلُ لِلرَّجُلِ حَیَّاک اللَّہُ أَنْ یَقُولَ : بِالسَّلاَمِ۔","","Musannaf Ibn Abi Shaybah 26286","","","كتاب الأدب"
"26287","(۲۶۲۸۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنِی عَلْقَمَۃُ بْنُ مَرْثَدٍ ، عَنْ عَطَائِ بْنِ أَبِی رَبَاحٍ ، أَنَّہُ کَرِہَ ، أَوْ قَالَ : کَانَ یُکْرَہُ السَّلاَمُ بِالْیَدِ وَلَمْ یَرَ بِالرَّأْسِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 26287","","","كتاب الأدب"
"26288","(۲۶۲۸۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : أَتَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ صِبْیَانٌ فَسَلَّمَ عَلَیْنَا۔ (بخاری ۶۲۴۷۔ ابوداؤد ۵۱۶۱)","Hasan","Musannaf Ibn Abi Shaybah 26288","","","كتاب الأدب"
"26289","(۲۶۲۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حُبَیبِّ بْنِ حُجْرٍ القیسی ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ : مَرَّ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ صِبْیَانٌ فَقَالَ : السَّلاَمُ عَلَیْکُمْ یَا صِبْیَانُ۔ (احمد ۳/۱۸۳۔ دارقطنی ۶۲۷)","Hasan","Musannaf Ibn Abi Shaybah 26289","","","كتاب الأدب"
"26290","(۲۶۲۹۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یُسَلِّمُ عَلَی الصِّبْیَانِ۔","","Musannaf Ibn Abi Shaybah 26290","","","كتاب الأدب"
"26291","(۲۶۲۹۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَنْ حَجَّاجٍ، عَنِ الْحَکَمِ، أَنَّ شُرَیْحًا کَانَ یَمُرُّ عَلَی الصِّبْیَانِ فَیُسَلِّمُ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 26291","","","كتاب الأدب"
"26292","(۲۶۲۹۲) حَدَّثَنَا وَکِیعٌ وَحَفْصٌ ، عَنْ حَنَشِ بْنِ الْحَارِثِ ، قَالَ : کَانَ عَمْرُو بْنُ مَیْمُونٍ یَمُرُّ عَلَیْنَا وَنَحْنُ صِبْیَانٌ فَیُسَلِّمُ عَلَیْنَا۔","","Musannaf Ibn Abi Shaybah 26292","","","كتاب الأدب"
"26293","(۲۶۲۹۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ أُبَیّ بن عَبْداللہِ قَالَ: کَانَ إِبرَاہِیم یَمُرُّ عَلَیْنَا وَنَحْنُ صِبْیَانٌ فَیُسَلِّمُ عَلَیْنَا۔","","Musannaf Ibn Abi Shaybah 26293","","","كتاب الأدب"
"26294","(۲۶۲۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یُسَلِّمُ عَلَی الصِّبْیَانِ ، وَلاَ یُسْمِعُہُمْ۔","","Musannaf Ibn Abi Shaybah 26294","","","كتاب الأدب"
"26295","(۲۶۲۹۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی حُسَیْنٍ سَمِعَہُ مِنْ شَہْرٍ یَقُولُ : أَخْبَرَتْہُ أَسْمَائُ بِنْتُ یَزِیدَ ، قَالَتْ : مَرَّ عَلَیْنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی نِسْوَۃٍ فَسَلَّمَ عَلَیْنَا۔ (ترمذی ۲۶۹۷۔ ابوداؤد ۵۱۶۲)","Hasan","Musannaf Ibn Abi Shaybah 26295","","","كتاب الأدب"
"26296","(۲۶۲۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ جَابِرٍ ، عَنْ طَارِقٍ التَّیْمِیِّ ، عَنْ جَرِیرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ عَلَی نِسْوَۃٍ فَسَلَّمَ عَلَیْہِنَّ۔ (احمد ۳/۳۶۳۔ ابویعلی ۷۵۰۶)","Da'if","Musannaf Ibn Abi Shaybah 26296","","","كتاب الأدب"
"26297","(۲۶۲۹۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، أَنَّ ابْنَ عُمَرَ مَرَّ عَلَی امْرَأَۃٍ فِی ظلۃ فَسَلَّمَ عَلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 26297","","","كتاب الأدب"
"26298","(۲۶۲۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ بِشرِ بن حَرب قَالَ : رَأَیت ابن عُمَر مَرَّ عَلَی امْرَأَۃٍ فَسَلَّمَ عَلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 26298","","","كتاب الأدب"
"26299","(۲۶۲۹۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابن ذَرٍّ ، عَنْ مُجَاہِدٍ ، أَنَّ عُمَرَ مَرَّ عَلَی نِسْوَۃٍ فَسَلَّمَ عَلَیْہِنَّ۔","","Musannaf Ibn Abi Shaybah 26299","","","كتاب الأدب"
"26300","(۲۶۳۰۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زُرْزُر ، قَالَ : سَأَلْتُ عَطَائً عَنِ السَّلاَمِ عَلَی النِّسَائِ فَقَالَ : إِنْ کُنَّ شَوَابَّ فَلاَ۔","","Musannaf Ibn Abi Shaybah 26300","","","كتاب الأدب"
"26301","(۲۶۳۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِمُحَمَّدٍ : أُسَلِّمُ عَلَی الْمَرْأَۃِ ؟ قَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 26301","","","كتاب الأدب"
"26302","(۲۶۳۰۲) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی أَنْ یُسَلِّمَ الرَّجُلُ عَلَی الْمَرْأَۃِ إلاَّ أَنْ یَدْخُلَ عَلَیْہَا فِی بَیْتِہَا فَیُسَلِّمَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 26302","","","كتاب الأدب"
"26303","(۲۶۳۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ قُرَیْرٍ ، قَالَ : جَائَ رَجُلٌ إلَی الْحَسَنِ فَقَالَ : أُسَلِّمُ عَلَی النِّسَائِ ؟ قَالَ : الْحَقْ بِأَہْلِک۔","","Musannaf Ibn Abi Shaybah 26303","","","كتاب الأدب"
"26304","(۲۶۳۰۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنِ الْحَسَنِ عن عُبَیْدِ اللہِ ، قَالَ : کَانَ عَمْرُو بْنُ مَیْمُونٍ یُسَلِّمُ عَلَی النِّسَائِ وَالصِّبْیَانِ۔","","Musannaf Ibn Abi Shaybah 26304","","","كتاب الأدب"
"26305","(۲۶۳۰۵) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ عَمْرِو بْنِ عُثْمَانَ، قَالَ: رَأَیْتُ مُوسَی بْنَ طَلْحَۃَ مَرَّ عَلَی نِسْوَۃٍ جُلُوسٍ فَسَلَّمَ عَلَیْہِنَّ۔","","Musannaf Ibn Abi Shaybah 26305","","","كتاب الأدب"
"26306","(۲۶۳۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا ، عَنِ السَّلاَمِ عَلَی النِّسَائِ فَکَرِہَہُ حماد عَلَی الشَّابَّۃِ وَالْعَجُوزِ ، وَقَالَ الْحَکَمُ : کَانَ شُرَیْحٌ یُسَلِّمُ عَلَی کُلِّ أَحَدٍ ، قُلْتُ : النِّسَائُ ؟ قَالَ : عَلَی کُلِّ أَحَدٍ۔","","Musannaf Ibn Abi Shaybah 26306","","","كتاب الأدب"
"26307","(۲۶۳۰۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ أَبُو مَسْعُودٍ لأَبِی عَبْدِ اللہِ ، أَوْ قَالَ أَبُو عَبْدِ اللہِ لأَبِی مَسْعُودٍ : مَا سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی زَعَمُوا ؟ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : بِئْسَ مَطِیَّۃُ الرَّجُلِ : زَعَمُوا۔ (احمد ۵/۴۰۱۔ طحاوی ۱۸۵)","","Musannaf Ibn Abi Shaybah 26307","","","كتاب الأدب"
"26308","(۲۶۳۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ کَرِہَ زَعَمُوا۔","","Musannaf Ibn Abi Shaybah 26308","","","كتاب الأدب"
"26309","(۲۶۳۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ وَسُفْیَانُ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَرِہَ زَعَمُوا ، ثُمَّ قَرَأَ سُفْیَانُ {زَعَمَ الَّذِینَ کَفَرُوا}۔","","Musannaf Ibn Abi Shaybah 26309","","","كتاب الأدب"
"26310","(۲۶۳۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ شُرَیْحٍ ، قَالَ : زَعَمُوا زَامِلَۃُ الْکَذِبِ۔","","Musannaf Ibn Abi Shaybah 26310","","","كتاب الأدب"
"26311","(۲۶۳۱۱) حَدَّثَنَا وَکِیعٌ ، عَنْ قَیس ، عن أَبِی یَحیَی ، عن مُجَاہِد ، عن ابن عَون قَال : زَعَمُوا زَامِلَۃُ الْکَذِبِ ، فَلاَ تَکُونَنَّ لِلْکَذِبِ زَامِلَۃ۔","","Musannaf Ibn Abi Shaybah 26311","","","كتاب الأدب"
"26312","(۲۶۳۱۲) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ أَبُو دَاوُدَ ، عَنْ سُفْیَانَ ، عَنْ یَحْیَی بْنِ ہَانِئٍ ، قَالَ : قَالَ لِی أَبِی : یَا بُنَیَّ ، ہَبْ لِی من الْحَدِیثِ زَعَمُوا وَسَوْفَ۔","","Musannaf Ibn Abi Shaybah 26312","","","كتاب الأدب"
"26313","(۲۶۳۱۳) حَدَّثَنَا ابْنُ أَبِی عُبَیْدَۃَ ، عَنْ أَبِیہِ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، قَالَ : قَالَ لِی شُرَیْحٌ : إنَّ زَعَمُوا کُنْیَۃُ الْکَذِبِ۔","","Musannaf Ibn Abi Shaybah 26313","","","كتاب الأدب"
"26314","(۲۶۳۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ حَبِیبٍ ، قَالَ : سَأَلْتُ أَبَا قِلاَبَۃَ فَقَالَ : زَعَمُوا۔","","Musannaf Ibn Abi Shaybah 26314","","","كتاب الأدب"
"26315","(۲۶۳۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : زَعَمُوا وَاللَّہِ۔","","Musannaf Ibn Abi Shaybah 26315","","","كتاب الأدب"
"26316","(۲۶۳۱۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ ثَابِتٍ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : أَنُہِیَ ، عَنْ نَبِیذِ الْجَرِّ ، فَقَالَ : زَعَمُوا ذَلِکَ ، قَالَ : قُلْتُ : أَنْتَ سَمِعْتہ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : زَعَمُوا ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 26316","","","كتاب الأدب"
"26317","(۲۶۳۱۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ سُئِلَ عَنْ شَیْئٍ فَقَالَ : زَعَمُوا۔","","Musannaf Ibn Abi Shaybah 26317","","","كتاب الأدب"
"26318","(۲۶۳۱۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ الْقَاسِمَ عَنِ الرَّجُلِ یُوتِرُ عَلَی رَاحِلَتِہِ ، قَالَ : زَعَمُوا أَنَّ ابْنَ عُمَرَ کَانَ یُوتِرُ بِالأَرْضِ۔","","Musannaf Ibn Abi Shaybah 26318","","","كتاب الأدب"
"26319","(۲۶۳۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُثْمَانَ الثَّقَفِیِّ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنِ ابْنِ أبی عَمْرَۃ ، قَالَ : قیلَ یَا رَسُولَ اللہِ ، کَیْفَ أَصْبَحْت ؟ قَالَ : بِخَیْرٍ مِنْ قَوْمٍ لَمْ یَشْہَدُوا جِنَازَۃً وَلَمْ یَعُودُوا مَرِیضًا۔n(طبرانی ۷۳۲۹)","","Musannaf Ibn Abi Shaybah 26319","","","كتاب الأدب"
"26320","(۲۶۳۲۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ ، عَنْ جَابِرٍ ، قَالَ : قُلْتُ: کَیْفَ أَصْبَحْت یَا رَسُولَ اللہِ ؟ قَالَ : بِخَیْرٍ مِنْ رَجُلٍ لَمْ یُصْبِحْ صَائِمًا وَلَمْ یَعُدْ سَقِیمًا۔","Da'if","Musannaf Ibn Abi Shaybah 26320","","","كتاب الأدب"
"26321","(۲۶۳۲۱) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، قَالَ : سَأَلْتُ عَائِشَۃَ : کَیْفَ أَصْبَحْت ؟ قَالَتْ : بِنِعْمَۃٍ مِنَ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 26321","","","كتاب الأدب"
"26322","(۲۶۳۲۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : مَرَرْت بِعَامِرٍ الشَّعْبِیِّ وَہُوَ جَالِسٌ بِفِنَائِہِ فَقُلْت : کَیْفَ أَنْتَ؟ فَقَالَ : کَانَ شُرَیْحٌ إذَا قِیلَ لَہُ : کَیْفَ أَنْتَ ؟ قَالَ : بِنِعْمَۃٍ وَمَدَّ إصْبَعَہُ السَّبَّابَۃَ إلَی السَّمَائِ۔","","Musannaf Ibn Abi Shaybah 26322","","","كتاب الأدب"
"26323","(۲۶۳۲۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، قَالَ : حدَّثَنِی بَکْرٌ ، قَالَ : قَالَ : قَالَ رَجُلٌ لأَبِی تَمِیمَۃَ الہُجَیمِی : کَیْفَ أَنْتُمْ ؟ قَالَ : بَیْنَ نِعْمَتَیْنِ : بَیْنَ ذَنْبٍ مَسْتُورٍ ، وَثَنَائٍ لاَ یَعْلَمُ بِہِ أَحَدٌ مِنْ ہَؤُلاَئِ النَّاسِ ، وَاللَّہِ مَا بَلَغْتُہُ ، وَلاَ أَنَا بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 26323","","","كتاب الأدب"
"26324","(۲۶۳۲۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : سَمِعْتُ إبْرَاہِیمَ وَسُلِّمَ عَلَیْہِ فَقَالَ : وَعَلَیْکُمْ ، فقیل لہ : کَیْفَ أَنْتَ ؟ قَالَ : بِنِعْمَۃٍ مِنَ اللہِ۔","","Musannaf Ibn Abi Shaybah 26324","","","كتاب الأدب"
"26325","(۲۶۳۲۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ حُمَیْدٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، أَنَّ رَجُلاً ، قَالَ لَہُ : کَیْفَ أَصْبَحْت یَا أَبَا عَمْرٍو ؟ فَقَالَ : بِنِعْمَۃٍ ، قُلْتُ : مِمَّنْ ؟ قَالَ : مِنَ اللہِ۔","","Musannaf Ibn Abi Shaybah 26325","","","كتاب الأدب"
"26326","(۲۶۳۲۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ عَلِیٌّ إذَا سُئِلَ وَہُوَ مَرِیضٌ ، کَیْفَ أَنْتَ ؟ قَالَ : بِشَرٍّ : وَقَرَأَ ہَذِہِ الآیَۃَ : {وَنَبْلُوکُمْ بِالشَّرِّ وَالْخَیْرِ فِتْنَۃً}۔","","Musannaf Ibn Abi Shaybah 26326","","","كتاب الأدب"
"26327","(۲۶۳۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : لَقِیَ رَجُلٌ عِکْرِمَۃَ بِالْمَدِینَۃِ فَقَالَ : کَیْفَ أَنْتَ ؟ قَالَ : أَنَا بِشَرٍّ یَدَایَ مُتَشَقِّقَتَانِ وَأَنَا کَذَا وَأَنَا وَکَذَا، قَالَ: وَکَانَ یَتَأَوَّلُ ہَذِہِ الآیَۃَ: {وَنَبْلُوکُمْ بِالشَّرِّ وَالْخَیْرِ فِتْنَۃً وَإِلَیْنَا تُرْجَعُونَ}۔","","Musannaf Ibn Abi Shaybah 26327","","","كتاب الأدب"
"26328","(۲۶۳۲۸) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، أَنَّ أَبَا عَبْدِ الرَّحْمَنِ السُّلَمِیّ کَانَ إذَا قِیلَ لَہُ : کَیْفَ أَنْتَ ؟ قَالَ : بِخَیْرٍ نَحْمَدُ اللَّہَ ، قَالَ عَطَائٌ : فَذَکَرْت ذَلِکَ لأَبِی الْبَخْتَرِیِّ فَقَالَ : أَنَّی أَخْذُہَا ؟ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 26328","","","كتاب الأدب"
"26329","(۲۶۳۲۹) حَدَّثَنَا إسْمَاعِیلُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : لَقِیَ رَجُلٌ مُحَمَّدًا فَقَالَ : کَیْفَ أَنْتَ ؟ قَالَ : بِشَرٍّ ، أَجُوعُ فَلاَ أَسْتَطِیعُ أَنْ أَشْبَعَ ، وَأَعْطَشُ فَلاَ أَسْتَطِیعُ أَنْ أُرْوَی۔","","Musannaf Ibn Abi Shaybah 26329","","","كتاب الأدب"
"26330","(۲۶۳۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ تُوطَأَ أَعْقَابُہُمْ۔ (دارمی ۵۲۴)","","Musannaf Ibn Abi Shaybah 26330","","","كتاب الأدب"
"26331","(۲۶۳۳۱) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو الْکَلْبِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عنْ شُعَیْبِ بْنِ عَبْدِ اللہِ بْنِ عَمْرٍو ، عَنْ أَبِیہِ ، قَالَ : مَا رُئِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْکُلُ مُتَّکِئًا قَطُّ ، وَلاَ یَطَأُ عَقِبَیہِ رَجُلاَنِ۔n(ابوداؤد ۳۷۶۴۔ احمد ۲/۱۶۵)","Hasan","Musannaf Ibn Abi Shaybah 26331","","","كتاب الأدب"
"26332","(۲۶۳۳۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْحَارِثِ بْنِ سُوَیْد ، أَنَّ عَمَّارًا دَعَا عَلَی رَجُلٍ فَقَالَ : اللَّہُمَّ إِنْ کَانَ کَاذِبًا فَابْسُطْ لَہُ الدُّنْیَا وَاجْعَلْہُ مَوْطِأَ الْعَقِبَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 26332","","","كتاب الأدب"
"26333","(۲۶۳۳۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، قَالَ : حدَّثَنَا عُمَرُ بْنُ قَیْسٍ ، عَنْ عَمْرِو بْنِ أَبِی قُرَّۃَ الْکِنْدِیِّ ، قَالَ : انْطَلَقَ سَلْمَانُ، وَأَبِی حَتَّی أَتَیَا دَارَ سَلْمَانَ ، وَدَخَلَ سَلْمَانُ الدَّارَ فَقَالَ: السَّلاَمُ عَلَیْکُمْ ، ثُمَّ أَذِنَ لأَبِی قُرَّۃَ۔","","Musannaf Ibn Abi Shaybah 26333","","","كتاب الأدب"
"26334","(۲۶۳۳۴) حَدَّثَنَا ابن فُضَیْلٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : إذَا دَخَلْت عَلَی أَہْلِکَ فَقُلْ : السَّلاَمُ عَلَیْکُمْ تَحِیَّۃً مِنْ عِنْدِ اللہِ مُبَارَکَۃً طَیِّبَۃً۔","","Musannaf Ibn Abi Shaybah 26334","","","كتاب الأدب"
"26335","(۲۶۳۳۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ الْغِفَارِیِّ ، قَالَ : إذَا دَخَلْت عَلَی أَہْلِکَ فَقُلْ : السَّلاَمُ عَلَیْکُمْ۔","","Musannaf Ibn Abi Shaybah 26335","","","كتاب الأدب"
"26336","(۲۶۳۳۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : دَخَلْت مَعَ أَبِی الْعَالِیَۃِ بَیْتَہُ فَسَلَّمَ وَلَیْسَ فِیہِ أَحَدٌ ، وَقَالَ شَیْئًا لَمْ أَفْہَمْہُ۔","","Musannaf Ibn Abi Shaybah 26336","","","كتاب الأدب"
"26337","(۲۶۳۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبرنا ابْنُ عَوْنٍ ، عَنْ مُحَمَّدٍ فِی قَوْلِہِ تَعَالَی : {وَالَّذِینَ لَمْ یَبْلُغُوا الْحُلُمَ مِنْکُمْ} قَالَ : کَانَ أَہْلُونَا یُعَلِّمُونَا أَنْ نُسَلِّمَ ، وَکَانَ أَحَدُنَا إذَا جَائَ یَقُولُ : السَّلاَمُ عَلَیْکُمْ ، أَیَدْخُلُ فُلاَنٌ ؟۔","","Musannaf Ibn Abi Shaybah 26337","","","كتاب الأدب"
"26338","(۲۶۳۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، قَالَ : حدَّثَنَا مَعْقِلٌ ، عَنْ عَبْدِ الْکَرِیمِ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إذَا دَخَلَ بَیْتًا ، قَالَ : بِسْمِ اللہِ وَالْحَمْدُ لِلَّہِ ، وَلاَ قُوَّۃَ إلاَّ بِاَللَّہِ وَالسَّلاَمُ عَلَی نَبِیِّ اللہِ ، اللَّہُمَّ افْتَحْ لِی أَبْوَابَ رَحْمَتِکَ {وَأَدْخِلْنِی مُدْخَلَ صِدْقٍ وَأَخْرِجْنِی مُخْرَجَ صِدْقٍ وَاجْعَلْ لِی مِنْ لَدُنْک سُلْطَانًا نَصِیرًا} وَہَبْ لِی مِنْ لَدُنْک رَحْمَۃً ، إنَّک أَنْتَ الْوَہَّابُ ، اللَّہُمَّ احْفَظْنِی مِنْ فَوْقِی أَنْ أُخْتَطَفَ ، وَمِنْ تَحْتِ رِجْلِی أَنْ یُخْسَفَ بِی ، وَعَنْ یَمِینِی ، وَعَنْ شِمَالِی مِنَ الشَّیْطَانِ الرَّجِیمِ۔","","Musannaf Ibn Abi Shaybah 26338","","","كتاب الأدب"
"26339","(۲۶۳۳۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : کَانَ عَبْدُ اللہِ إذَا دَخَلَ دَارَہُ اسْتَأْنَسَ وَتَکَلَّمَ ، ثُمَّ رَفَعَ صَوْتَہُ۔","","Musannaf Ibn Abi Shaybah 26339","","","كتاب الأدب"
"26340","(۲۶۳۴۰) حَدَّثَنَا ابْنُ المُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ ، أَنَّ یَہُودِیًّا حَلَبَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَاقَۃً فَقَالَ : اللَّہُمَّ جَمِّلْہُ ، فَاسْوَدَّ شَعْرُہُ۔ (ابوداؤد ۴۹۲)","","Musannaf Ibn Abi Shaybah 26340","","","كتاب الأدب"
"26341","(۲۶۳۴۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَن تَقُول للیَہُودِی ہَدَاکَ اللہ۔","","Musannaf Ibn Abi Shaybah 26341","","","كتاب الأدب"
"26342","(۲۶۳۴۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَائَ یَہُودِیٌّ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : ادْعُ اللَّہَ لِی ، فَقَالَ : کَثَّرَ اللَّہُ مَالَک وَوَلَدَک وَأَصَحَّ جِسْمَک وَأَطَالَ عُمْرَک۔","","Musannaf Ibn Abi Shaybah 26342","","","كتاب الأدب"
"26343","(۲۶۳۴۳) حَدَّثَنَا الْفَضْلُ، عَنْ أَبِی سِنَانٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: لَوْ قَالَ لِی فِرْعَوْنُ بَارَکَ اللَّہُ فِیک لَقُلْت وَفِیک۔","","Musannaf Ibn Abi Shaybah 26343","","","كتاب الأدب"
"26344","(۲۶۳۴۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُہ عَنِ الرَّجُلِ یَسْتَأْذِنُ عَلَیَّ ، وَلاَ یُسَلِّمُ آذَنُ لَہُ ؟ قَالَ : أَکْرَہُ أَنْ آذَنَ لَہُ وَالنَّاسُ یَفْعَلُونَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 26344","","","كتاب الأدب"
"26345","(۲۶۳۴۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لاَ تَأْذَنُوا حَتَّی تُؤْذَنُوا بِالسَّلاَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 26345","","","كتاب الأدب"
"26346","(۲۶۳۴۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا دُعِیت ، فَہُوَ إذْنُک ، فَسَلِّمْ ، ثُمَّ ادْخُلْ۔","Sahih","Musannaf Ibn Abi Shaybah 26346","","","كتاب الأدب"
"26347","(۲۶۳۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْجُرَیْرِیِّ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ : اسْتَأْذَنَ رَجُلٌ عَلَی رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ قَائِمٌ عَلَی الْبَابِ فَقَالَ : أَدْخُلُ ، ثَلاَثَ مَرَّاتٍ ، وَہُوَ یَنْظُرُ إلَیْہِ ، فَلَمْ یَأْذَنْ لَہُ ، ثُمَّ قَالَ : السَّلاَمُ عَلَیْکُمْ أَدْخُلُ ، فَقَالَ : ادْخُلْ ، ثُمَّ قَالَ : لَوْ أَقَمْت إلَی اللَّیْلِ تَقُولُ أَدْخُلُ ، مَا أَذِنْت لَکَ حَتَّی تَبْدَأَ بِالسَّلاَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 26347","","","كتاب الأدب"
"26348","(۲۶۳۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ صَالِحٍ القُدادی ، قَالَ : بَعَثَنِی أَہْلِی إلَی سَعِیدِ بْنِ جُبَیْرٍ بِہَدِیَّۃٍ ، فَانْتَہَیْت إلَی الْبَابِ وَہُوَ یَتَوَضَّأُ فَقُلْتُ : أَدْخُلُ ؟ فَسَکَتَ ثَلاَثًا ، قَالَ : قُلْ : السَّلاَمُ عَلَیْکُمْ ، قَالَ : فَدَخَلْت فَقَالَ : لَمْ أَرَک تَہْتَدِی إلَی السُّنَّۃِ فَعَلَّمْتُک۔","","Musannaf Ibn Abi Shaybah 26348","","","كتاب الأدب"
"26349","(۲۶۳۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ جَابِرٍ ، قَالَ : اسْتَأْذَنْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مَنْ ہَذَا ؟ فَقُلْت : أَنَا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنَا أَنَا۔ (بخاری ۶۲۵۰۔ مسلم ۳۸)","Sahih","Musannaf Ibn Abi Shaybah 26349","","","كتاب الأدب"
"26350","(۲۶۳۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا اسْتَأْذَنَ فَقِیلَ لَہُ : ادْخُلْ بِسَلاَمٍ ، رَجَعَ ، قَالَ : لاَ أَدْرِی أَدْخُلُ بِسَلاَمٍ ، أَوْ بِغَیْرِ سَلاَمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 26350","","","كتاب الأدب"
"26351","(۲۶۳۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ أَبِی الجَراح ، عَنْ رَجُلٍ مِنْ أَہْلِ الْحِجَازِ ، قَالَ : قالَتِ امْرَأَتِی: ائْتِنِی بِأَبِی ہُرَیْرَۃَ حَتَّی أَسْتَفْتِیَہُ ، عَنْ بَعْضِ شأنی، فَأَتَیْتہ، فَجَائَ مَعِی، فَلَمَّا انْتَہَیْنَا إلَی الْبَابِ ، قَالَ: ادْخُلِ الدَّارَ، فَدَخَلْت فَقُلْت : ہَذَا أَبُو ہُرَیْرَۃَ قَدْ جَائَ فَقَالَ : السَّلاَمُ عَلَیْکُمْ أَدْخُلُ ، فَقُلْنَا : ادْخُلْ بِسَلاَمٍ ، فَعَادَ فَقَالَ : السَّلاَمُ عَلَیْکُمْ أَدْخُلُ ، فَقُلْنَا : ادْخُلْ بِسَلاَمٍ ، قَالَ : قُولُوا : ادْخُلْ ، فَقَالَ : السَّلاَمُ عَلَیْکُمْ أَدْخُلُ ؟ فَقُلْنَا لَہُ : ادْخُلْ ، فَدَخَلَ۔","Da'if","Musannaf Ibn Abi Shaybah 26351","","","كتاب الأدب"
"26352","(۲۶۳۵۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا دَخَلْت بَیْتًا لَیْسَ فِیہِ أَحَدٌ فَقُلْ : السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ۔","","Musannaf Ibn Abi Shaybah 26352","","","كتاب الأدب"
"26353","(۲۶۳۵۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الرَّجُلِ یَدْخُلُ فِی الْبَیْتِ ، أَوْ فِی الْمَسْجِدِ لَیْسَ فِیہِ أَحَدٌ ، قَالَ : یَقُولُ : السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 26353","","","كتاب الأدب"
"26354","(۲۶۳۵۴) حَدَّثَنَا أَبو الأَحوص ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : قُل : السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ۔","","Musannaf Ibn Abi Shaybah 26354","","","كتاب الأدب"
"26355","(۲۶۳۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ مَاہَانَ فِی قَوْلِہِ تَعَالَی : {فَإِذَا دَخَلْتُمْ بُیُوتًا فَسَلِّمُوا عَلَی أَنْفُسِکُمْ تَحِیَّۃً مِنْ عِنْدِ اللہِ مُبَارَکَۃً طَیِّبَۃً} قَالَ : تَقُولُ : السَّلاَمُ عَلَیْنَا مِنْ رَبِّنَا۔","","Musannaf Ibn Abi Shaybah 26355","","","كتاب الأدب"
"26356","(۲۶۳۵۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَبْدِالْکَرِیمِ، عَنْ مُجَاہِدٍ، قَالَ: تَقُولُ: السَّلاَمُ عَلَیْنَا، وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ۔","","Musannaf Ibn Abi Shaybah 26356","","","كتاب الأدب"
"26357","(۲۶۳۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ، قَالَ : إِذَا دَخَلْتَ بَیْتًا ، لَیْسَ فِیہِ أَحَدٌ ، فَقُلْ بِسْمِ اللہِ ، الْحَمْدُ لِلَّہِ ، السَّلاَمُ عَلَیْنَا ، وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ۔","","Musannaf Ibn Abi Shaybah 26357","","","كتاب الأدب"
"26358","(۲۶۳۵۸) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ عَبْدِالْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ: إذَا لَمْ یَکُنْ فِیہِ أَحَدٌ فَقُلْ: السَّلاَمُ عَلَیْنَا مِنْ رَبِّنَا۔","","Musannaf Ibn Abi Shaybah 26358","","","كتاب الأدب"
"26359","(۲۶۳۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ: حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّ رَجُلاً کَتَبَ لابْنِ عُمَرَ: بِسْمِ اللہِ لِفُلاَنٍ، فَقَالَ : ابْنُ عُمَرَ : مَہْ ، إنَّ اسْمَ اللہِ ہُوَ لَہُ وَحْدَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26359","","","كتاب الأدب"
"26360","(۲۶۳۶۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُکْرَہُ أَنْ یُکْتَبَ أَوَّلَ الرِّسَالَۃِ بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ لِفُلاَنٍ ، وَلاَ یَرَی بَأْسًا أَنْ یُکْتَبَ فِی أول والعُنْوان۔","","Musannaf Ibn Abi Shaybah 26360","","","كتاب الأدب"
"26361","(۲۶۳۶۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ حُمَیْدٍ، عَنْ بَکْرٍ، قَالَ: أکْتُبْ إلَی فُلاَنٍ، وَلاَ أکْتُبْ لِفُلاَنٍ۔","","Musannaf Ibn Abi Shaybah 26361","","","كتاب الأدب"
"26362","(۲۶۳۶۲) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ، عَنْ إسْرَائِیلَ ، عَنْ إسْمَاعِیلَ بْنِ سَلمان ، عَنْ دِینَارٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : لاَ بَأْسَ أَنْ یَکْتُبَ : بِسْمِ اللہِ لِفُلاَنٍ۔","","Musannaf Ibn Abi Shaybah 26362","","","كتاب الأدب"
"26363","(۲۶۳۶۳) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ إسْرَائِیلَ ، عَنِ الشَّعْبِیِّ مِثْلُہُ۔","","Musannaf Ibn Abi Shaybah 26363","","","كتاب الأدب"
"26364","(۲۶۳۶۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ قَالَ : إذَا کَتَبَ کَتَبَ : السَّلاَمُ عَلَیْک فِیمَا أَحْمَدُ اللَّہَ الَّذِی لاَ إلَہَ إلاَّ ہُوَ وَہُوَ لِلْحَمْدِ أَہْلٌ تَبَارَکَ وَتَعَالَی : {لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ}۔","","Musannaf Ibn Abi Shaybah 26364","","","كتاب الأدب"
"26365","(۲۶۳۶۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ سُوقَۃَ ، قَالَ : أَتَیْتُ نُعَیْمَ بْنَ أَبِی ہِنْدٍ فَأَخْرَجَ إلَیَّ صَحِیفَۃً فَإِذَا فِیہَا مِنْ أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ وَمُعَاذِ بْنِ جَبَلٍ إلَی عُمَرَ بْنِ الْخَطَّابِ سَلاَمٌ عَلَیْک أَمَّا بَعْدُ فَکَتَبَ إلَیْہِمَا مِنْ عُمَرَ بْنِ الْخَطَّابِ إلَی أَبِی عُبَیْدَۃَ بْنِ الْجَرَّاحِ وَمُعَاذِ بْنِ جَبَلٍ سَلاَمٌ عَلَیْکُمَا أَمَّا بَعْدُ۔","","Musannaf Ibn Abi Shaybah 26365","","","كتاب الأدب"
"26366","(۲۶۳۶۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنِ الْعَبَّاسِ بْنِ ذَرِیحٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَتَبَتْ عَائِشَۃُ إلَی مُعَاوِیَۃَ : أَمَّا بَعْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 26366","","","كتاب الأدب"
"26367","(۲۶۳۶۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : حدَّثَنِی مَنْ قَرَأَ کِتَابَ عُثْمَانَ ، أَوْ مَنْ قُرِیء عَلَیْہِ: أَمَّا بَعْدُ۔","Da'if","Musannaf Ibn Abi Shaybah 26367","","","كتاب الأدب"
"26368","(۲۶۳۶۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : قرَأْت رَسَائِلَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُلَّمَا انْقَضَتْ قِصَّۃٌ ، قَالَ : أَمَّا بَعْدُ۔ (بخاری ۷۔ مسلم ۱۳۹۳)","","Musannaf Ibn Abi Shaybah 26368","","","كتاب الأدب"
"26369","(۲۶۳۶۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، قَالَ : سَمِعْتُ عَامِرًا یَقُولُ : قَالَ زِیَادٌ : إنَّ فَصْلَ الْخِطَابِ الَّذِی أُعْطِیَ دَاوُد أَمَّا بَعْدُ۔","","Musannaf Ibn Abi Shaybah 26369","","","كتاب الأدب"
"26370","(۲۶۳۷۰) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ، عَنْ سُفْیَانَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، أَنَّہُ کَتَبَ فِی رِسَالَۃٍ: أَمَّا بَعْدُ ، ثُمَّ قَالَ : کَانَ فِی رَسَائِلِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَّا بَعْدُ۔","","Musannaf Ibn Abi Shaybah 26370","","","كتاب الأدب"
"26371","(۲۶۳۷۱) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : أَرْسَلَنِی أَبِی إلَی ابْنِ عُمَرَ فَرَأَیْتہ یَکْتُبُ بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ أَمَّا بَعْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 26371","","","كتاب الأدب"
"26372","(۲۶۳۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : قرَأْت فِی رَسَائِلَ مِنْ رَسَائِلِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُلَّمَا انْقَضَی أَمْرٌ ، قَالَ : أَمَّا بَعْدُ۔ (بخاری ۱۱۲۱)","Sahih","Musannaf Ibn Abi Shaybah 26372","","","كتاب الأدب"
"26373","(۲۶۳۷۳) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ أَبُو دَاوُدَ ، عَنْ سُفْیَانَ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ ثَعْلَبَۃَ بْنِ عِبَادٍ ، عَنْ سَمُرَۃََ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ فَقَالَ : أَمَّا بَعْدُ۔ (ابن حبان ۲۸۵۶۔ ابن خزیمۃ ۱۳۹۷)","Da'if","Musannaf Ibn Abi Shaybah 26373","","","كتاب الأدب"
"26374","(۲۶۳۷۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، وَابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّ أَبَا حُمَیْدٍ السَّاعِدِیَّ حَدَّثَہُ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ فَقَالَ : أَمَّا بَعْدُ۔ (بخاری ۹۲۵۔ مسلم ۱۴۶۴)","Sahih","Musannaf Ibn Abi Shaybah 26374","","","كتاب الأدب"
"26375","(۲۶۳۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَکَلَّمَ فَقَالَ : أَمَّا بَعْدُ۔ (بخاری ۴۱۴۱۔ مسلم ۲۱۳۷)","Sahih","Musannaf Ibn Abi Shaybah 26375","","","كتاب الأدب"
"26376","(۲۶۳۷۶) حَدَّثَنَا مَیْمُونٌ الزَّعْفَرَانِیُّ ، عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ ، عَنْ أَبِیہِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَ فَقَالَ : أَمَّا بَعْدُ۔ (مسلم ۵۹۲۔ احمد ۳/۳۱۰)","Da'if","Musannaf Ibn Abi Shaybah 26376","","","كتاب الأدب"
"26377","(۲۶۳۷۷) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ رِبْعِیِّ بْنِ حِرَاشٍ ، عَنِ الطُّفَیْلِ بْنِ سَخْبَرَۃَ أَخٍ لعَائِشَۃَ مِنَ الرَّضَاعَۃِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَمَّا بَعْدُ۔n(ابن ماجہ ۲۱۱۸۔ حاکم ۳)","Hasan","Musannaf Ibn Abi Shaybah 26377","","","كتاب الأدب"
"26378","(۲۶۳۷۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ یَزِیدَ بْنِ حَیَّانَ ، عَنْ زَیْد بْنِ أَرْقَمَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَہُمْ فَقَالَ : أَمَّا بَعْدُ۔ (مسلم ۱۸۷۴۔ ابوداؤد ۴۹۳۴)","Sahih","Musannaf Ibn Abi Shaybah 26378","","","كتاب الأدب"
"26379","(۲۶۳۷۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : کَتَبَ أَبُو الدَّرْدَائِ إلَی مَسْلَمَۃَ بْنِ مَخْلَدٍ وَہُوَ أَمِیرٌ بِمِصْرَ : أَمَّا بَعْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 26379","","","كتاب الأدب"
"26380","(۲۶۳۸۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ ہُبَیْرَۃَ ، قَالَ : کَتَبَ أَبُو الدَّرْدَائِ إلَی سَلْمَانَ : أَمَّا بَعْدُ ۔ وَکَتَبَ سَلْمَانُ إلَی أَبِی الدَّرْدَائِ أَمَّا بَعْدُ۔","","Musannaf Ibn Abi Shaybah 26380","","","كتاب الأدب"
"26381","(۲۶۳۸۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، قَالَ : کَتَبَ عُمَرُ إلَی أَبِی مُوسَی : أَمَّا بَعْدُ۔","","Musannaf Ibn Abi Shaybah 26381","","","كتاب الأدب"
"26382","(۲۶۳۸۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنْ عُبَیْدِ اللہِ الْقُرَشِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عُکَیْمٍ ، قَالَ : خَطَبَنَا أَبُو بَکْرٍ فَقَالَ : أَمَّا بَعْدُ۔","Da'if","Musannaf Ibn Abi Shaybah 26382","","","كتاب الأدب"
"26383","(۲۶۳۸۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ دِلاَفٍ ، عَنْ أَبِیہِ ، عَنْ عَمِّ أَبِیہِ بِلاَلِ بْنِ الْحَارِثِ ، قَالَ : خَطَبَ عُمَرُ بْنُ الْخَطَّابِ فَقَالَ : أَمَّا بَعْدُ۔","Da'if","Musannaf Ibn Abi Shaybah 26383","","","كتاب الأدب"
"26384","(۲۶۳۸۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَتَبَ أَبُو مُوسَی إلَی عَامِرِ بْنِ عَبْدِ اللہِ الَّذِی کَانَ یُدْعَی ابْنَ عَبْدِ الْقَیْسِ : أَمَّا بَعْدُ۔","","Musannaf Ibn Abi Shaybah 26384","","","كتاب الأدب"
"26385","(۲۶۳۸۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إِبْرَاہِیمَ، عَن عَلْقَمَۃَ، قَالَ: أَقْبَلْت مَعَ عَبْدِاللہِ مِنَ السَّیْلَحین فَصَحِبَہُ دَہَّاقِینَ مِنْ أَہْلِ الْحِیرَۃِ ، فَلَمَّا دَخَلُوا الْکُوفَۃَ أَخَذُوا فِی طَرِیقٍ غَیْرِ طَرِیقِہِمْ ، فَالْتَفَتَ إلَیْہِمْ فَرَآہُمْ قَدْ عَدَلُوا ، فَأَتْبَعَہُمُ السَّلاَمَ ، فَقُلْت : أَتُسَلِّمُ عَلَی ہَؤُلاَئِ الْکُفَّارِ ، فَقَالَ : نَعَمْ إِنَّہُم صَحِبُونِی وَلِلصُّحْبَۃِ حَقٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 26385","","","كتاب الأدب"
"26386","(۲۶۳۸۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَ[corrupt]لَ : مَا زَادَہُمْ عَبْدُ اللہِ عَنِ الإِشَارَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 26386","","","كتاب الأدب"
"26387","(۲۶۳۸۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ شُعَیْبِ بْنِ الْحَبْحَابِ ، قَالَ : کُنْتُ مَعَ عَلِیِّ بْنِ عَبْدِ اللہِ الْبَارِقِیِّ ، فَمَرَّ عَلَیْنَا یَہُودِیٌّ ، أَوْ نَصْرَانِیٌّ عَلَیْہِ کَارَۃٌ مِنْ طَعَامٍ ، فَسَلَّمَ عَلَیْہِ عَلِیٌّ ، فَقَالَ شُعَیْبٌ : فَقُلْت : إِنَّہُ یَہُودِیٌّ، أَوْ نَصْرَانِیٌّ ، فَقَرَأَ عَلِیٌّ آخِرَ سُورَۃِ الزُّخْرُفِ {وَقِیلِہِ یَا رَبِّ إنَّ ہَؤُلاَئِ قَوْمٌ لاَ یُؤْمِنُونَ فَاصْفَحْ عَنْہُمْ وَقُلْ سَلاَمٌ فَسَوْفَ یَعْلَمُونَ}۔","","Musannaf Ibn Abi Shaybah 26387","","","كتاب الأدب"
"26388","(۲۶۳۸۸) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنَا مَعْمَر ، قَالَ : بَلَغَنِی ، أَنَّ أَبَا ہُرَیْرَۃَ مَرَّ عَلَی یَہُودِیٍّ فَسَلَّمَ ، فَقِیلَ لَہُ : إِنَّہُ یَہُودِیٌّ ، فَقَالَ : یَا یَہُودِیُّ ، رُدَّ عَلَیَّ سَلاَمِی ، وَأَدْعُو لَکَ ، قَالَ : قَدْ رَدَدْتہ ، قَالَ : اللَّہُمَّ کَثِّرْ مَالَہُ وَوَلَدَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 26388","","","كتاب الأدب"
"26389","(۲۶۳۸۹) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ عَاصِمٍ ، عَنْ مُحَمَّدٍ ، قَالَ : یُسَلِّمُ الرَّاکِبُ عَلَی الْمَاشِی ، وَالْمَاشِی عَلَی الْقَاعِدِ ، فَإِذَا الْتَقَیَا بَدَأَ خیرہما۔","","Musannaf Ibn Abi Shaybah 26389","","","كتاب الأدب"
"26390","(۲۶۳۹۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، قَالَ : کُنْتُ أَنَا وَالشَّعْبِیُّ فَلَقِینَا رَجُلاً رَاکِبًا ، فَبَدَأَہُ الشَّعْبِیُّ بِالسَّلاَمِ فَقُلْت : أَتَبْدَؤُہُ وَنَحْنُ رَاجِلاَنِ وَہُوَ رَاکِبٌ ؟ فَقَالَ : لَقَدْ رَأَیْت شُرَیْحًا یُسَلِّمُ عَلَی الرَّاکِبِ۔","","Musannaf Ibn Abi Shaybah 26390","","","كتاب الأدب"
"26391","(۲۶۳۹۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ وَسُلَیْمَانَ بْنِ مُوسَی ، قَالاَ : یُسَلِّمُ الصَّغِیرُ علی الْکَبِیرِ ، وَالْقَائِمُ عَلَی الْقَاعِدِ ، وَیُسَلِّمُ الرَّاکِبُ عَلَی الْمَاشِی ، وَالْقَلِیلُونَ عَلَی الْکَثِیرِینَ۔","","Musannaf Ibn Abi Shaybah 26391","","","كتاب الأدب"
"26392","(۲۶۳۹۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی حَیَّانَ التَّیْمِیِّ ، عَنْ أَبِی الزِّنْبَاعِ ، عَنْ أَبِی الدِّہْقَانَۃِ ، قَالَ : قیلَ لِعُمَرَ بْنِ الْخَطَّابِ : إنَّ ہَاہُنَا غُلاَمًا مِنْ أَہْلِ الْحِیرَۃِ ، لَمْ یُرَ قَطُّ أَحْفَظُ مِنْہُ ، وَلاَ أَکْتُبُ مِنْہُ ، فَإِنْ رَأَیْت أَنْ تَتَّخِذَہُ کَاتِبًا بَیْنَ یَدَیْک، إذَا کَانَتْ لَکَ الْحَاجَۃُ شَہِدَک، قَالَ: فَقَالَ عُمَرُ: قَدِ اتَّخَذْت إذًا بِطَانَۃً مِنْ دُونِ الْمُؤْمِنِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 26392","","","كتاب الأدب"
"26393","(۲۶۳۹۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ لِعَبْدِ اللہِ کَاتِبٌ نَصْرَانِیٌّ۔","","Musannaf Ibn Abi Shaybah 26393","","","كتاب الأدب"
"26394","(۲۶۳۹۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، عَنْ عِیَاضٍ الأَشْعَرِیِّ ، أَنَّ أَبَا مُوسَی کَانَ لَہُ کَاتِبٌ نَصْرَانِیٌّ۔","Hasan","Musannaf Ibn Abi Shaybah 26394","","","كتاب الأدب"
"26395","(۲۶۳۹۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، قَالَ : جَائَنَا کِتَابُ أَبِی بَکْرٍ وَنَحْنُ بِالْقَادِسِیَّۃِ ، وَکَتَبَ عَبْدُ اللہِ بْنُ الأَرْقَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 26395","","","كتاب الأدب"
"26396","(۲۶۳۹۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ بْنِ مُحَمَّدٍ ، أنَّ عُبَیْدَ اللہِ بْنِ أَبِی رَافِعٍ کَاتِبِ عَلِیٍّ أَخْبَرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26396","","","كتاب الأدب"
"26397","(۲۶۳۹۷) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ، عَنِ الزُّہْرِیِّ، عَنْ عُبَیْدِ بْنِ السَّبَّاقِ، عَنْ زَیْدِ بْنِ ثَابِتٍ، أَنَّ أَبَا بَکْرٍ، قَالَ لَہُ: قدْ کُنْتَ تَکْتُبُ الْوَحْیَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَاجْمَعِ الْقُرْآنَ فَاکْتُبْہُ۔n(بخاری ۴۶۷۹۔ ترمذی ۳۱۰۳)","Da'if","Musannaf Ibn Abi Shaybah 26397","","","كتاب الأدب"
"26398","(۲۶۳۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ کَاتِبٍ لِعَلِی۔","","Musannaf Ibn Abi Shaybah 26398","","","كتاب الأدب"
"26399","(۲۶۳۹۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ، قَالَ: حدَّثَنِی وَرَّادٌ کَاتِبُ الْمُغِیرَۃِ بْنِ شُعْبَۃَ۔","","Musannaf Ibn Abi Shaybah 26399","","","كتاب الأدب"
"26400","(۲۶۴۰۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ بَجَالَۃَ ، قَالَ : کُنت کَاتِبًا لِجَِزِی بْنِ مُعَاوِیَۃَ۔","","Musannaf Ibn Abi Shaybah 26400","","","كتاب الأدب"
"26401","(۲۶۴۰۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، عَنْ حَاتِمِ بْنِ أَبِی صَغِیرَۃَ ، عَنْ عَطِیَّۃَ ، کَاتِبٍ لِعَبْدِ اللہِ بْنِ مُطَرِّفٍ۔","","Musannaf Ibn Abi Shaybah 26401","","","كتاب الأدب"
"26402","(۲۶۴۰۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَنْ مَنصُور ، عَنِ ابْنِ سِیرِینَ ، أَنَّ الْعَلاَئَ بْنَ الْحَضْرَمِیِّ کَتَبَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَبَدَأَ بِنَفْسِہِ۔ (ابوداؤد ۵۰۹۲۔ حاکم ۶۳۶)","","Musannaf Ibn Abi Shaybah 26402","","","كتاب الأدب"
"26403","(۲۶۴۰۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَتَبَ أَبُو مُوسَی : مِنْ عَبْدِ اللہِ بْنِ قَیْسٍ إلَی عَامِرِ بْنِ عَبْدِ اللہِ۔","","Musannaf Ibn Abi Shaybah 26403","","","كتاب الأدب"
"26404","(۲۶۴۰۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، أَنَّ ابْنَ عُمَرَ کَتَبَ إلَی عُمَرَ بْنِ الْخَطَّابِ فَکَتَبَ : مِنْ عَبْدِ اللہِ بْنِ عُمَرَ إلَی عُمَرَ ، قَالَ جَعْفَرٌ : قَالَ مَیْمُونٌ : إنَّمَا ہُوَ شَیْئٌ یُعَظِّمُ بِہِ الأَعَاجِمُ بَعْضُہَا بَعْضًا۔","Sahih","Musannaf Ibn Abi Shaybah 26404","","","كتاب الأدب"
"26405","(۲۶۴۰۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ کَہْمَسٍ ، قَالَ : قَالَ لِی عَبْدُ اللہِ بْنُ مُسْلِمِ بْنِ یَسَارٍ : أَوَ حَرَجٌ عَلَیَّ أَلاَ أَبْدَأَ بِہِ فِی الْکِتَابِ ، فَإِنَّہُ لاَ یُبْدَأُ إلاَّ بِأَمِینٍ وَیَبْدَأُ الرَّجُلُ بِأَبِیہِ۔","","Musannaf Ibn Abi Shaybah 26405","","","كتاب الأدب"
"26406","(۲۶۴۰۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : کَتَبْت إلَی شُعْبَۃَ بِبَغْدَادَ فَبَدَأْت بِاسْمِہِ ، فَکَتَبَ إلَیَّ یَنْہَانِی وَیَذْکُرُ أَنَّ الْحَکَمَ کَانَ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 26406","","","كتاب الأدب"
"26407","(۲۶۴۰۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ شَیْخٍ ، أَنَّ زَیْدَ بْنَ ثَابِتٍ کَتَبَ إلَی مُعَاوِیَۃَ فَبَدَأَ بِمُعَاوِیَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 26407","","","كتاب الأدب"
"26408","(۲۶۴۰۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یُکْتَبُ إلَیْہِ فَیُبْدَأَ بِہِ ، فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 26408","","","كتاب الأدب"
"26409","(۲۶۴۰۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَتْ لابْنِ عُمَرَ حَاجَۃٌ إلَی مُعَاوِیَۃَ ، فَأَرَادَ أَنْ یَکْتُبَ إلَیْہِ فَقَالُوا : لَوْ بَدَأْت بِہِ ، فَلَمْ یَزَالُوا بِہِ حَتَّی کَتَبَ : بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ إلَی مُعَاوِیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 26409","","","كتاب الأدب"
"26410","(۲۶۴۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، قَالَ : کَتَبَ رَجُلٌ کِتَابًا مِنَ الْحَسَنِ إلَی صَالِحِ بْنِ عَبْدِ الرَّحْمَنِ فَکَتَبَ : بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ مِنَ الْحَسَنِ إلَی صَالِحٍ ، فَقَالَ : الرَّجُلُ : یَا أَبَا سَعِیدٍ ، لَوْ بَدَأْت بِہِ ، فَبَدَأَ بِہِ۔","","Musannaf Ibn Abi Shaybah 26410","","","كتاب الأدب"
"26411","(۲۶۴۱۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ إسْمَاعِیلَ الْمَکِّیِّ ، عَنِ الْحَسَنِ وَالنَّخَعِیِّ أَنَّہُمَا لَمْ یَرَیَا بَأْسًا أَنْ یَکْت[corrupt]بَ الرَّجُلُ إلَی الرَّجُلِ فَیَبْدَأَ بِہِ۔","","Musannaf Ibn Abi Shaybah 26411","","","كتاب الأدب"
"26412","(۲۶۴۱۲) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَزَارَۃَ ، عَنِ الْحَکَمِ ، قَالَ : لاَ بَأْسَ أَنْ تَبْدَأَ بِغَیْرِکَ إذَا کَتَبْت إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 26412","","","كتاب الأدب"
"26413","(۲۶۴۱۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَطَائِ بْنِ أَبِی مَیْمُونَۃَ ، قَالَ : سَمِعْتُ أَبَا رَافِعٍ یُحَدِّثُ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ زَیْنَبَ کَانَ اسْمُہَا بَرَّۃَ ، فَقِیلَ لَہَا : تُزَکِّی نَفْسَہَا ، فَسَمَّاہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ زَیْنَبَ۔n(مسلم ۱۷۔ احمد ۲/۴۳۰)","Sahih","Musannaf Ibn Abi Shaybah 26413","","","كتاب الأدب"
"26414","(۲۶۴۱۴) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ ابْنَۃً لِعُمَرَ کَانَ یُقَالُ لَہَا عَاصِیَۃُ، فَسَمَّاہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ جَمِیلَۃَ۔(مسلم ۱۵۔ ابوداؤد ۴۹۱۳)","Sahih","Musannaf Ibn Abi Shaybah 26414","","","كتاب الأدب"
"26415","(۲۶۴۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ خَیْثَمَۃَ ، قَالَ : کَانَ اسْمُ أَبِی فِی الْجَاہِلِیَّۃِ عَزِیزًا ، فَسَمَّاہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَبْدَ الرَّحْمَن۔ (احمد ۴/۱۷۸۔ ابن حبان ۵۸۲۸)","","Musannaf Ibn Abi Shaybah 26415","","","كتاب الأدب"
"26416","(۲۶۴۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا سَمِعَ الاِسْمَ الْقَبِیحَ حَوَّلَہُ إلَی مَا ہُوَ أَحْسَنُ مِنْہُ۔ (ترمذی ۲۸۳۹)","","Musannaf Ibn Abi Shaybah 26416","","","كتاب الأدب"
"26417","(۲۶۴۱۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا الْمَسْعُودِیُّ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ مَوْلَی آلِ طَلْحَۃَ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ اسْمُ جُوَیْرِیَۃَ بَرَّۃَ ، فَحَوَّلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اسْمَہَا۔n(احمد ۱/۳۱۶)","Hasan","Musannaf Ibn Abi Shaybah 26417","","","كتاب الأدب"
"26418","(۲۶۴۱۸) حَدَّثَنَا حُمَیدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّ رَجُلاً کَانَ اسْمُہُ الْحُبَابَ ، فَسَمَّاہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَبْدَ اللہِ وَقَالَ: الْحُبَابُ شَیْطَانٌ ، وَکَانَ اسْمُ رَجُلٍ الْمُضْطَجِعَ فَسَمَّاہُ الْمُنْبَعِثَ۔n(ابن سعد ۵۴۱)","","Musannaf Ibn Abi Shaybah 26418","","","كتاب الأدب"
"26419","(۲۶۴۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : لَمْ یُدْرِکِ الإِسْلاَمَ مِنْ عُصَاۃِ قُرَیْشٍ غَیْرُ مُطِیعٍ ، وَکَانَ اسْمُہُ الْعَاصِیَ ، فَسَمَّاہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُطِیعًا۔ (مسلم ۱۴۰۔ احمد ۳/۴۱۲)","","Musannaf Ibn Abi Shaybah 26419","","","كتاب الأدب"
"26420","(۲۶۴۲۰) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی أَبُو الْمُحَیَّاۃِ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : حدَّثَنِی ابْنُ أَخِی عَبْدِ اللہِ بْنِ سَلاَمٍ ، عَنْ عَبْدِ اللہِ بْنِ سَلاَمٍ ، قَالَ : قَدِمْت عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَیْسَ اسْمِی عَبْدَ اللہِ بْنَ سَلاَمٍ ، فَسَمَّانِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَبْدَ اللہِ بْنَ سَلاَمٍ۔ (ترمذی ۳۲۵۶۔ حاکم ۴۱۳)","Da'if","Musannaf Ibn Abi Shaybah 26420","","","كتاب الأدب"
"26421","(۲۶۴۲۱) حَدَّثَنَا یَزِیدُ بْنُ الْمِقْدَامِ بْنِ شُرَیْحٍ ، عَنِ الْمِقْدَامِ بْنِ شُرَیْحٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ہَانِئِ بْنِ شُرَیْحٍ ، قَالَ : وَفَدَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی قَوْمِہِ فَسَمِعَہُمْ یُسَمُّونَ رَجُلاً عَبْدَ الْحَجَرِ ، فَقَالَ لَہُ : مَا اسْمُک ؟ قَالَ: عَبْدُ الْحَجَرِ ، فَقَالَ لَہُ : رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا أَنْتَ عَبْدُ اللہِ۔","Hasan","Musannaf Ibn Abi Shaybah 26421","","","كتاب الأدب"
"26422","(۲۶۴۲۲) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا أَبُو عَقِیلٍ ، قَالَ : حَدَّثَنَا مُجَالِدُ بْنُ سَعِیدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، قَالَ : لَقِیت عُمَرَ بْنَ الْخَطَّابِ فَقَالَ : مَنْ أَنْتَ ؟ فَقُلْت : مَسْرُوقُ بْنُ الأَجْدَعِ ، فَقالَ عُمَر : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الأَجْدَعُ شَیْطَانٌ۔ (ابوداؤد ۴۹۱۸۔ بزار ۳۱۸)","Da'if","Musannaf Ibn Abi Shaybah 26422","","","كتاب الأدب"
"26423","(۲۶۴۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَرِہَ عَبْدُ رَبِّہِ۔","","Musannaf Ibn Abi Shaybah 26423","","","كتاب الأدب"
"26424","(۲۶۴۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ قَیْسٍ الأسدی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَرِہَ عَبْدُ رَبِّہِ۔","","Musannaf Ibn Abi Shaybah 26424","","","كتاب الأدب"
"26425","(۲۶۴۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَرِہَ اللَّہُ مَالکًا۔","","Musannaf Ibn Abi Shaybah 26425","","","كتاب الأدب"
"26426","(۲۶۴۲۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ الرُّکَیْنِ ، عَنْ أَبِیہِ ، عَنْ سَمُرَۃََ ، قَالَ : نَہَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ نُسَمِّیَ رَقِیقَنَا أَرْبَعَۃَ أَسْمَائٍ : أَفْلَحَ وَنَافِعًا وَرَبَاحًا وَیَسَارًا۔ (مسلم ۱۶۸۵۔ ابوداؤد ۴۹۲۰)","Sahih","Musannaf Ibn Abi Shaybah 26426","","","كتاب الأدب"
"26427","(۲۶۴۲۷) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنِّی عَسَیت إِنْ شَائَ اللَّہُ أَنْ أَنْہَی أُمَّتِی أَنْ یُسَمُّوا نَافِعًا وَأَفْلَحَ وَبَرَکَۃً ، قَالَ الأَعْمَشُ : لاَ أَدْرِی ذَکَرَ رَافِعًا أَمْ لاَ ، لأِنَّ الرَّجُلَ إذَا جَائَ یَقُولُ : أَثَمَّ بَرَکَۃٌ ، فَیَقُولُونَ : لاَ۔ (بخاری ۸۳۳۔ ابوداؤد ۴۹۲۱)","Hasan","Musannaf Ibn Abi Shaybah 26427","","","كتاب الأدب"
"26428","(۲۶۴۲۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی خَلْدَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : تَفْعَلُونَ شَرًّا مِنْ ذَلِکَ ، تُسَمُّونَ أَوْلاَدَکُمْ أَسْمَائَ الأَنْبِیَائِ ، ثُمَّ تَلْعُنْونَہُمْ۔","","Musannaf Ibn Abi Shaybah 26428","","","كتاب الأدب"
"26429","(۲۶۴۲۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ مُجَاہِدٍ، قَالَ: أَحَبُّ الأَسْمَائِ إلَی اللہِ عَبْدُاللہِ، وَعَبْدُالرَّحْمَن۔","","Musannaf Ibn Abi Shaybah 26429","","","كتاب الأدب"
"26430","(۲۶۴۳۰) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : أَحَبُّ الأَسْمَائِ إلیہ أَسْمَائُ الأَنْبِیَائِ۔","","Musannaf Ibn Abi Shaybah 26430","","","كتاب الأدب"
"26431","(۲۶۴۳۱) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا الْعُمَرِیُّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَحَبُّ الأَسْمَائِ إلَی اللہِ عَبْدُ اللہِ ، وَعَبْدُ الرَّحْمَن۔ (مسلم ۱۶۸۲۔ ابوداؤد ۴۹۱۰)","Da'if","Musannaf Ibn Abi Shaybah 26431","","","كتاب الأدب"
"26432","(۲۶۴۳۲) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّ ابْنَ الْحَنَفِیَّۃِ کَانَ یُکَنَّی أَبَا الْقَاسِمِ۔","","Musannaf Ibn Abi Shaybah 26432","","","كتاب الأدب"
"26433","(۲۶۴۳۳) حَدَّثَنَا مُحَمَّدٌ بْنُ الْحَسَنِ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ مُحَمَّدُ بْنُ الأَشْعَث وَکَانَ ابْنَ أُخْتِ عَائِشَۃَ وَکَانَ یُکَنَّی أَبَا الْقَاسِمِ۔","","Musannaf Ibn Abi Shaybah 26433","","","كتاب الأدب"
"26434","(۲۶۴۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ فِطْرٍ ، عَنْ مُنْذِرٍ ، عَنْ مُحَمَّدِ بْنِ الْحَنَفِیَّۃِ ، قَالَ : قَالَ عَلِیٌّ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنْ وُلِدَ لِی غُلاَمٌ بَعْدَکَ أُسَمِّیہِ بِاسْمِکَ وَأُکَنِّیہِ بِکُنْیَتِکَ ؟ قَالَ : نَعَمْ۔ (ابوداؤد ۴۹۲۸)","","Musannaf Ibn Abi Shaybah 26434","","","كتاب الأدب"
"26435","(۲۶۴۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تَتْرُکُوا النَّارَ فِی بُیُوتِکُمْ حِینَ تَنَامُونَ۔ (بخاری ۶۲۹۳۔ مسلم ۱۵۹۶)","Sahih","Musannaf Ibn Abi Shaybah 26435","","","كتاب الأدب"
"26436","(۲۶۴۳۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ بُرَیْدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی ، قَالَ : احْتَرَقَ بَیْتٌ بِالْمَدِینَۃِ عَلَی أَہْلِہِ ، فَحُدِّثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِشَأْنِہِمْ فَقَالَ : إنَّمَا ہَذِہِ النَّارُ عَدُوٌّ لَکُمْ ، فَإِذَا نِمْتُمْ فَأَطْفِئُوہَا عَنْکُمْ۔ (بخاری ۶۲۹۴۔ مسلم ۱۵۹۶)","Sahih","Musannaf Ibn Abi Shaybah 26436","","","كتاب الأدب"
"26437","(۲۶۴۳۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : أَمَرَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَہَانَا ، فَأَمَرَنَا أَنْ نُطْفِئَ سُرُجَنَا۔ (بخاری ۶۲۹۶۔ مسلم ۱۵۹۴)","Sahih","Musannaf Ibn Abi Shaybah 26437","","","كتاب الأدب"
"26438","(۲۶۴۳۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : کَانَ یُکْرَہُ أَنْ نَدَعَ السُّراجَ حَتَّی نُصْبِحَ۔","","Musannaf Ibn Abi Shaybah 26438","","","كتاب الأدب"
"26439","(۲۶۴۳۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَحْیَی ، عَنْ أَبِیہِ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ لنا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الْحُدَیْبِیَۃِ : لاَ تُوقِدُوا نَارًا بِلَیْلٍ ، ثُمَّ قَالَ : أَوْقِدُوا وأطفئوا فَإِنَّہُ لَنْ یُدْرِکَ قَوْمٌ مُدَّکُمْ ، وَلاَ صَاعَکُمْ۔ (نسائی ۸۸۵۵۔ احمد ۳/۲۶)","Hasan","Musannaf Ibn Abi Shaybah 26439","","","كتاب الأدب"
"26440","(۲۶۴۴۰) حَدَّثَنَا عَمْرُو بْنُ طَلْحَۃَ ، عَنْ أَسْبَاطِ بْنِ نَصْرٍ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا نِمْتُمْ فَأَطْفِئُوہَا۔ (بخاری ۱۲۲۲۔ ابوداؤد ۵۲۰۵)","Da'if","Musannaf Ibn Abi Shaybah 26440","","","كتاب الأدب"
"26441","(۲۶۴۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی زِیَادٍ ، عَنْ أُمِّ وَلَدٍ لِعَبْدِاللہِ بْنِ مَسْعُودٍ، قَالَتْ : کَانَ عَبْدُ اللہِ یَأْمُرُ بِدَارِہِ فَتُکْنَسُ حَتَّی لَوِ الْتَمَسْت فِیہَا تَبِنَۃً ، أَوْ قَصَبَۃً مَا قَدَرْت عَلَیْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 26441","","","كتاب الأدب"
"26442","(۲۶۴۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُرِّیَّۃِ الرَّبِیعِ ، قَالَتْ : کَانَ الرَّبِیعُ یَأْمُرُ بِالدَّارِ تُنَظَّفُ کُلَّ یَوْمٍ۔","","Musannaf Ibn Abi Shaybah 26442","","","كتاب الأدب"
"26443","(۲۶۴۴۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لَمَّا قَدِمَ الأَشْعَرِیُّ الْبَصْرَۃَ ، قَالَ لَہُمْ : فیما تقولون إنَّ أَمِیرَ الْمُؤْمِنِینَ بَعَثَنِی إلَیْکُمْ لأَعَلِّمَکُمْ سُنَّتَکُمْ وَأُنَظِّفَ لَکُمْ طُرُقَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 26443","","","كتاب الأدب"
"26444","(۲۶۴۴۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : قَالَ أَبُو الْقَاسِمِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَمُّوا بِاسْمِی ، وَلاَ تَکَنَّوْا بِکُنْیَتِی۔ (بخاری ۳۵۳۹۔ مسلم ۱۶۸۴)","Sahih","Musannaf Ibn Abi Shaybah 26444","","","كتاب الأدب"
"26445","(۲۶۴۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَسَمَّوْا بِاسْمِی ، وَلاَ تَکَنَّوْا بِکُنْیَتِی۔ (احمد ۳۱۳۔ ابویعلی ۱۹۱۸)","Hasan","Musannaf Ibn Abi Shaybah 26445","","","كتاب الأدب"
"26446","(۲۶۴۴۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْبَقِیعِ ، فَنَادَی رَجُلٌ آخَرَ یَا أَبَا الْقَاسِمِ ، فَالْتَفَتَ إلَیْہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : إنِّی لَمْ أَعْنِکَ یَا رَسُولَ اللہِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَسَمَّوْا بِاسْمِی ، وَلاَ تَکَنَّوْا بِکُنْیَتِی۔ (بخاری ۲۱۲۰۔ مسلم ۱۶۸۲)","Sahih","Musannaf Ibn Abi Shaybah 26446","","","كتاب الأدب"
"26447","(۲۶۴۴۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَالِمٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: تَسَمَّوا بِاسْمِی ، وَلاَ تَکَنَّوْا بِکُنْیَتِی ، فَإِنَّمَا جُعِلْت قَاسِمًا أَقْسِمُ بَیْنَکُمْ۔ (بخاری ۶۱۸۷۔ مسلم ۱۶۸۳)","Sahih","Musannaf Ibn Abi Shaybah 26447","","","كتاب الأدب"
"26448","(۲۶۴۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی عَمْرَۃَ ، عَنْ عَمِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَجْمَعُوا بَیْنَ اسْمِی وَکُنْیَتِی۔ (احمد ۵/۳۶۴۔ ابن سعد ۱۰۷)","Sahih","Musannaf Ibn Abi Shaybah 26448","","","كتاب الأدب"
"26449","(۲۶۴۴۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ سَمِعَ جَابِرًا یَقُولُ : وُلِدَ لِرَجُلٍ مِنَّا غُلاَمٌ ، قَالَ : فَسَمَّاہُ الْقَاسِمَ ، قَالَ : فَقُلْنَا : لاَ نُکَنِّیہِ أَبَا الْقَاسِمِ ولاَ نُنْعِمُہُ عَیْنًا ، فَأَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَ لَہُ ذَلِکَ فَقَالَ : أَسْم ابْنَک عَبْدَ الرَّحْمَن۔ (بخاری ۶۱۸۶۔ مسلم ۱۶۸۴)","Sahih","Musannaf Ibn Abi Shaybah 26449","","","كتاب الأدب"
"26450","(۲۶۴۵۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِمُحَمَّدٍ : أَکَانَ یُکْرَہُ أَنْ یُکَنَّی الرَّجُلُ بِأَبِی الْقَاسِمِ ، وَإِنْ لَمْ یَکُنِ اسْمُہُ مُحَمَّدًا ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 26450","","","كتاب الأدب"
"26451","(۲۶۴۵۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ الأَحْوَلِ ، قَالَ : کُنَّا نَطُوفُ وَمَعَنَا مِقْسَمٌ فَجَعَلَ طَاوُوسٌ یُحَدِّثُہُ وَیَقُولُ إِیہًا فَقُلْنَا : أَبُو الْقَاسِمِ ، فَقَالَ : وَاللَّہِ لاَ أَکْنِیہِ بِہَا۔","","Musannaf Ibn Abi Shaybah 26451","","","كتاب الأدب"
"26452","(۲۶۴۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الْمُہَلَّبِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : بَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی بَعْضِ أَسْفَارِہِ وَامْرَأَۃٌ مِنَ الأَنْصَارِ عَلَی نَاقَۃٍ ، فَضَجِرَتْ فَلَعَنَتْہَا ، فَسَمِعَ ذَلِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : خُذُوا مَا عَلَیْہَا وَدَعُوہَا فَإِنَّہَا مَلْعُونَۃٌ ، قَالَ عِمْرَانُ بْنُ حُصَیْنٍ : فَکَأَنِّی أَرَاہَا تَجُولُ فِی السُّوقِ مَا یَعْرِضُ لَہَا أَحَدٌ۔ (مسلم ۲۰۰۴۔ ابوداؤد ۲۵۵۴)","Sahih","Musannaf Ibn Abi Shaybah 26452","","","كتاب الأدب"
"26453","(۲۶۴۵۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ أَخْبَرَنَا سُلَیْمَانُ التَّیْمِیُّ ، عَنْ أَبِی عُثْمَانَ ، عَنْ أَبِی بَرْزَۃَ ، أَنَّ جَارِیَۃً بَیْنَمَا ہِیَ عَلَی بَعِیرٍ ، أَوْ رَاحِلَۃٍ عَلَیْہَا مَتَاعٌ لِلْقَوْمِ بَیْنَ جَبَلَیْنِ فَتَضَایَقَ بِہَا الْجَبَلُ ، فَأَتَی عَلَیْہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا أَبْصَرَتْہُ جَعَلَتْ تَقُولُ : حل اللَّہُمَّ الْعَنْہُ حَلَّ اللَّہُمَّ الْعَنْہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ صَاحِبُ الرَّاحِلَۃِ ؟ لاَ یَصْحَبُنَا بَعِیرٌ ، أَوْ رَاحِلَۃٌ عَلَیْہَا لَعَنْۃٌ مِنَ اللہِ ، أَوْ کَمَا قَالَ۔n(مسلم ۲۰۰۵۔ احمد ۴/۴۱۹)","Sahih","Musannaf Ibn Abi Shaybah 26453","","","كتاب الأدب"
"26454","(۲۶۴۵۴) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ، عَنْ أَبِیہِ، عَنْ أَبِی ہُرَیْرَۃَ، قَالَ: بَیْنَمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسِیرُ فِی نَاسٍ مِنْ أَصْحَابِہِ إذْ لَعَنْ رَجُلٌ مِنْہُمْ بَعِیرَہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَنْ لَعَنْ بَعِیرَہُ ؟ فَقَالَ: أَنَا یَا رَسُولَ اللہِ، قَالَ: أَخِّرْہُ عَنَّا، فَقَدْ أُجِبْت۔ (احمد ۲/۴۲۸)","Hasan","Musannaf Ibn Abi Shaybah 26454","","","كتاب الأدب"
"26455","(۲۶۴۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شِمْرٍ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، عَنْ عَائِشَۃَ ، أَنَّہَا قُرِّبَ إلَیْہَا بَعِیرًا لِتَرْکَبَہُ ، فَالْتَوَی عَلَیْہَا فَلَعَنَتْہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَرْکَبِیہِ فَإِنَّک لَعَنْتِیہِ۔n(احمد ۶/۲۵۷۔ ابویعلی ۴۷۱۶)","","Musannaf Ibn Abi Shaybah 26455","","","كتاب الأدب"
"26456","(۲۶۴۵۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : بَیْنَمَا عُمَرُ یَسِیرُ فِی أصْحَابِہِ وَفِی الْقَوْمِ رَجُلٌ یَسِیرُ عَلَی بَعِیرٍ لَہُ مِنَ الْقَوْمِ یَضَعُہُ حَیْثُ یَشَائُ ، فَلاَ أَدْرِی بِمَا الْتَوَی عَلَیْہِ فَلَعَنْہُ ، فَقَالَ عُمَرُ : مَنْ ہَذَا اللاَّعِنُ ؟ قَالُوا : فُلاَنٌ ، قَالَ : تَخَلَّفْ عَنَّا أَنْتَ وَبَعِیرُک ، لاَ تَصْحَبُنَا رَاحِلَۃٌ مَلْعُونَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 26456","","","كتاب الأدب"
"26457","(۲۶۴۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدِ بْنِ سِنَانٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : إنَّ لِکُلِّ شَیْئٍ شَرَفًا ، وَأَشْرَفُ الْمَجَالِسِ مَا اسْتَقْبَلَ بِہِ الْقِبْلَۃَ ، وقَالَ : مَا رَأَیْت سُفْیَانَ یَجْلِسُ إلاَّ مُسْتَقْبِلَ الْقِبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 26457","","","كتاب الأدب"
"26458","(۲۶۴۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ إذَا نَامَ اسْتَقْبَلَ الْقِبْلَۃَ وَرُبَّمَا اسْتَلْقَی۔","","Musannaf Ibn Abi Shaybah 26458","","","كتاب الأدب"
"26459","(۲۶۴۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، أَنَّ ابْنَ مَسْعُودٍ جَلَسَ مُسْتَقْبِلَ الْقِبْلَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 26459","","","كتاب الأدب"
"26460","(۲۶۴۶۰) حَدَّثَنَا وَکِیعٌ، عَنْ مُحَمَّدِ بْنِ عَبْدِاللہِ الشُّعَیْثِیِّ ، عَنْ مَکْحُولٍ ، قَالَ: أَفْضَلُ الْمَجَالِسِ مُسْتَقْبِلَ الْقِبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 26460","","","كتاب الأدب"
"26461","(۲۶۴۶۱) حَدَّثَنَا وَکِیعٌ، عَنْ ثَوْرٍ، عَنْ سُلَیْمَانَ بْنِ مُوسَی، قَالَ: لِکُلِّ شَیْئٍ سَیِّدٌ، وَسَیِّدُ الْمَجَالِسِ مُسْتَقْبِلَ الْقِبْلَۃِ۔","","Musannaf Ibn Abi Shaybah 26461","","","كتاب الأدب"
"26462","(۲۶۴۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْعَلاَئِ ، قَالَ : مَا أُعْطِیَ عَبْدٌ بَعْدَ الإِسْلاَمِ أَفْضَلَ مِنْ عَقْلٍ صَالِحٍ یُرْزَقُہُ۔","","Musannaf Ibn Abi Shaybah 26462","","","كتاب الأدب"
"26463","(۲۶۴۶۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : قَالَ عُمَرُ : حَسْبُ الرَّجُلِ دِینُہُ وَمُرُوئَتُہُ: خُلُقُہُ ، وَأَصْلُہُ : عَقْلُہُ۔","","Musannaf Ibn Abi Shaybah 26463","","","كتاب الأدب"
"26464","(۲۶۴۶۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ ، عَنْ زِیَادِ بْنِ حُدِیرٍ ، عَنْ عُمَرَ بِنَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 26464","","","كتاب الأدب"
"26465","(۲۶۴۶۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : {فَإِنْ آنَسْتُمْ مِنْہُمْ رُشْدًا} قَالَ : عَقْلاً۔","","Musannaf Ibn Abi Shaybah 26465","","","كتاب الأدب"
"26466","(۲۶۴۶۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : قَالَ عُمَرُ : حَسْبُ الْمَرْئِ دِینُہُ وَمُرُوئَتُہُ ، خُلُقُہُ ، وَأَصْلُہُ : عَقْلُہُ۔","","Musannaf Ibn Abi Shaybah 26466","","","كتاب الأدب"
"26467","(۲۶۴۶۷) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ تَعَالَی : {قَسَمٌ لِذِی حِجْرٍ} قَالَ : لذی النُّہَی وَالْعَقْلِ۔","Da'if","Musannaf Ibn Abi Shaybah 26467","","","كتاب الأدب"
"26468","(۲۶۴۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عِکْرِمَۃَ فِی قَوْلِہِ: {قَسَمٌ لِذِی حِجْرٍ} قَالَ: لِذِی لُبٍّ وَلِذِی عَقْلٍ۔","","Musannaf Ibn Abi Shaybah 26468","","","كتاب الأدب"
"26469","(۲۶۴۶۹) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَن ہِلاَلِ بن خَبَّاب ، عَن مُجاہِد : {قَسَمٌ لِذِی حِجْرٍ} قَالَ : لِذِی عَقْلٍ۔","","Musannaf Ibn Abi Shaybah 26469","","","كتاب الأدب"
"26470","(۲۶۴۷۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفیان ، عن الأَغَر ، عَنْ خَلِیفَۃَ بْنِ حُصَیْنٍ ، عَنْ أَبِی نَصْرٍ ، عَنِ ابْنِ عَبَّاسٍ {قَسَمٌ لِذِی حِجْرٍ} : لِذِی لُبٍّ۔","Hasan","Musannaf Ibn Abi Shaybah 26470","","","كتاب الأدب"
"26471","(۲۶۴۷۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ {قَسَمٌ لِذِی حِجْرٍ} قَالَ : لِذِی عَقْلٍ۔","","Musannaf Ibn Abi Shaybah 26471","","","كتاب الأدب"
"26472","(۲۶۴۷۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ نَتْفِ الشَّیْبِ وَقَالَ : ہُوَ نُورُ الْمُؤْمِنِ۔n(ترمذی ۲۸۲۱۔ ابن ماجہ ۳۷۲۱)","","Musannaf Ibn Abi Shaybah 26472","","","كتاب الأدب"
"26473","(۲۶۴۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَیُّوبَ السِّخْتِیَانِیِّ ، عَنْ یُوسُفَ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، أَنَّ حَجَّامًا أَخَذَ مِنْ شَارِبِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَأَی شَیْبَۃً فِی لِحْیَتِہِ ، فَأَہْوَی إلَیْہَا ، فَأَخَذَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِیَدِہِ وَقَالَ : مَنْ شَابَ شَیْبَۃً فِی الإِسْلاَمِ کَانَتْ لَہُ نُورًا یَوْمَ الْقِیَامَۃِ۔ (ترمذی ۱۶۳۵۔ ابن سعد ۴۳۳)","","Musannaf Ibn Abi Shaybah 26473","","","كتاب الأدب"
"26474","(۲۶۴۷۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الْمُثَنَّی ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، أَنَّہُ کَانَ یَکْرَہُ نَتْفَ الشَّیْبِ۔ (مسلم ۱۰۴)","Sahih","Musannaf Ibn Abi Shaybah 26474","","","كتاب الأدب"
"26475","(۲۶۴۷۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : عُذِّبَ رَجُلٌ فِی نَتْفِ الشَّیْبِ۔","","Musannaf Ibn Abi Shaybah 26475","","","كتاب الأدب"
"26476","(۲۶۴۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُمَیْدٍ الأَعْرَجِ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ یَقُولُ : لاَ تَنْتِفُوا الشَّیْبَ فَإِنَّہُ نُورٌ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 26476","","","كتاب الأدب"
"26477","(۲۶۴۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ نَتْفَ الشَّیْبِ وَلَمْ یَرَ بِقَصِّہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 26477","","","كتاب الأدب"
"26478","(۲۶۴۷۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ عُمَرَ یَقُولُ : الْقُعُودُ بَیْنَ الظِّلِّ وَالشَّمْسِ مَقْعَدُ الشَّیْطَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 26478","","","كتاب الأدب"
"26479","(۲۶۴۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَقْعُدَ الرَّجُلُ بَیْنَ الظِّلِّ وَالشَّمْسِ۔ (بخاری ۱۱۷۴۔ عبدالرزاق ۱۹۸۰۰)","","Musannaf Ibn Abi Shaybah 26479","","","كتاب الأدب"
"26480","(۲۶۴۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ زِیَادٍ مَوْلَی بَنِی مَخْزُومٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : حرْفُ الظِّلِّ مَقْعَدُ الشَّیْطَانِ۔ (ابوداؤد ۴۷۸۸۔ احمد ۲/۳۸۳)","Sahih","Musannaf Ibn Abi Shaybah 26480","","","كتاب الأدب"
"26481","(۲۶۴۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ ، عَنْ نُفَیْعٍ الْجَمَّالِ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: حرْفُ الظِّلِّ مَقِیلُ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 26481","","","كتاب الأدب"
"26482","(۲۶۴۸۲) حَدَّثَنَا عَلِیُّ بْنُ الْجَعْدِ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ مُحَمَّدِ بْنِ وَاسِعٍ ، عَنْ أَبِی عِیَاضٍ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : حَدُّ الظِّلِّ وَالشَّمْسِ مَقَاعِدُ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 26482","","","كتاب الأدب"
"26483","(۲۶۴۸۳) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ خَالِدٍ، عَنْ عِکْرِمَۃَ فِی الَّذِی یَقْعُدُ بَیْنَ الظِّلِّ وَالشَّمْسِ: قَالَ ذَاکَ مَقْعَدُ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 26483","","","كتاب الأدب"
"26484","(۲۶۴۸۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی الْمُنِیبِ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ نَہَی أَنْ یُقْعَدَ بَیْنَ الشَّمْسِ وَالظِّلِّ۔ (ابن ماجہ ۳۷۲۔ حاکم ۲۷۲)","Da'if","Musannaf Ibn Abi Shaybah 26484","","","كتاب الأدب"
"26485","(۲۶۴۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ یَقُولُ : مَنِ اسْتَمَعَ حَدِیث قَوْمٍ وَہُمْ لَہُ کَارِہُونَ صُبَّ فِی أُذُنِہِ الآنُکُ یَوْمَ الْقِیَامَۃِ یَعْنِی الرَّصَاصَ۔ (بخاری ۷۰۴۲۔ ابوداؤد ۴۹۸۵)","","Musannaf Ibn Abi Shaybah 26485","","","كتاب الأدب"
"26486","(۲۶۴۸۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ ، عَنْ عَطَائِ بْنِ دِینَارٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَتَّخِذُوا ظُہُورَ الدَّوَابِّ کَرَاسِیَ لأَحَادِیثِکُمْ ، فَرُبَّ رَاکِبِ مَرْکُوبَۃٍ ہِیَ خَیْرٌ مِنْہُ وَأَطْوَعُ لِلَّہِ وَأَکْثَرُ ذِکْرًا۔ (احمد ۳/۴۴۰۔ دارمی ۲۶۶۸)","","Musannaf Ibn Abi Shaybah 26486","","","كتاب الأدب"
"26487","(۲۶۴۸۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ سَعِیدٍ الزُّبَیْدِیِّ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، أَنَّ عُمَرَ کَرِہَ الْوُقُوفَ عَلَی الدَّابَّۃِ۔","","Musannaf Ibn Abi Shaybah 26487","","","كتاب الأدب"
"26488","(۲۶۴۸۸) حَدَّثَنَا وَکِیعٌ، عَنْ کَامِل، عَن حَبِیب قَالَ: کَانَ یَکرہ طُول الْوُقُوفِ عَلَی الدَّابَّۃِ وَأَنْ تُضْرَبَ وَہِیَ محسنۃ۔","","Musannaf Ibn Abi Shaybah 26488","","","كتاب الأدب"
"26489","(۲۶۴۸۹) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنْ مُوسَی الْجُہَنِیِّ، قَالَ: رَأَیْتُ الشَّعْبِیَّ وَطَلْحَۃَ مُتَوَاقِفَیْنِ عَلَی دَارِ سَعْدِ بْنِ طَلْحَۃَ۔","","Musannaf Ibn Abi Shaybah 26489","","","كتاب الأدب"
"26490","(۲۶۴۹۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا دَاوُد بْنُ أَبِی ہِنْدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، أَنَّ أَبَا مُوسَی اسْتَأْذَنَ عَلَی عُمَرَ ثَلاَثًا فَلَمْ یَأْذَنْ لَہُ ، قَالَ: فَانْصَرَفَ فَأَرْسَلَ إلَیْہِ عُمَرُ : مَا رَدَّک؟ قَالَ : اسْتَأْذَنْت الاِسْتِئْذَانَ الَّذِی أَمَرَنَا بِہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثًا ، فَإِنْ أُذِنَ لَنَا دَخَلْنَا ، وَإِنْ لَمْ یُؤْذَنْ لَنَا رَجَعْنَا ، قَالَ : لِتَأْتِینَّ عَلَی ہَذَا بِبَیِّنَۃٍ ، أَوْ لأَفْعَلَنَّ وَأَفْعَلَنَّ ، فَأَتَی مَجْلِسَ قَوْمِہِ فَنَاشَدَہُمْ ، فَشَہِدُوا لَہُ ، فَخَلَّی عَنْہُ۔n(بخاری ۲۰۶۲۔ مسلم ۳۵)","Sahih","Musannaf Ibn Abi Shaybah 26490","","","كتاب الأدب"
"26491","(۲۶۴۹۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : قَالَ عَلِیٌّ : الأُولَی إذن ، وَالثَّانِیَۃُ مُؤَامَرَۃٌ ، وَالثَّالِثَۃُ عَزْمَۃٌ ، إمَّا أَنْ یُؤْذَنُوا وَإِمَّا أَنْ یُرَدُّوا۔","Da'if","Musannaf Ibn Abi Shaybah 26491","","","كتاب الأدب"
"26492","(۲۶۴۹۲) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الاِسْتِئْذَانُ ثَلاَثٌ ، فَإِنْ أُذِنَ لَکَ وَإِلاَّ فَارْجِعْ۔","","Musannaf Ibn Abi Shaybah 26492","","","كتاب الأدب"
"26493","(۲۶۴۹۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْقَوْمِ یَسْتَأْذِنُونَ ، قَالَ : قَالَ : إِنْ قَالَ رَجُلٌ مِنْہُمُ السَّلاَمُ عَلَیْکُمْ أَنَدْخُلُ ، أَجْزَأَ ذَلِکَ عَنْہُمْ۔","","Musannaf Ibn Abi Shaybah 26493","","","كتاب الأدب"
"26494","(۲۶۴۹۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : دَخَلْنَا عَلَی أَبِی رَزِینٍ وَنَحْنُ ذُو عَدَدٍ ، فَکَانَ کُلُّ إنْسَانٍ مِنَّا یُسَلِّمُ وَیَسْتَأْذِنُ ، فَقَالَ : إِنَّہُ إذَا أُذِنَ لأَوَّلِکُمْ أُذِنَ لآخِرِکُمْ۔","","Musannaf Ibn Abi Shaybah 26494","","","كتاب الأدب"
"26495","(۲۶۴۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : عَطَسَ رَجُلاَنِ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَشَمَّتَ ، أَوْ سَمَّتَ أَحَدَہُمَا وَلَمْ یُشَمِّتِ الآخَرَ ، فَقِیلَ : یَا رَسُولَ اللہِ ، عَطَسَ عِنْدَکَ رَجُلاَنِ فَشَمَّتَ أَحَدَہُمَا وَلَمْ تُشَمِّتِ الآخَرَ ، فَقَالَ : إنَّ ہَذَا حَمِدَ اللَّہَ ، وَإِنَّ ہَذَا لَمْ یَحْمَدِ اللَّہَ۔n(بخاری ۶۲۲۱۔ مسلم ۲۲۹۲)","Sahih","Musannaf Ibn Abi Shaybah 26495","","","كتاب الأدب"
"26496","(۲۶۴۹۶) حَدَّثَنَا قَاسِمُ بْنُ مَالِکٍ الْمُزَنِیّ ، عَنْ عَاصِمِ بْنِ کُلَیْبٍ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : دَخَلْت عَلَی أَبِی مُوسَی وَہُوَ فِی بَیْتِ بِنْتِ الْفَضْلِ فَعَطَسْت فَلَمْ یُشَمِّتْنِی وَعَطَسَتْ فَشَمَّتَہَا ؟ فَرَجَعْت إلَی أُمِّی فَأَخْبَرْتُہَا ، فَلَمَّا جَائَہَا ، قَالَتْ : عَطَسَ عِنْدَکَ ابْنِی فَلَمْ تُشَمِّتْہُ وَعَطَسَتْ فَشَمَّتَّہَا ، قَالَ : إنَّ ابْنَک عَطَسَ وَلَمْ یَحْمَدِ اللَّہَ فَلَمْ أُشَمِّتْہُ ، وَعَطَسَتْ ہذہ وَحَمِدَتِ اللَّہَ فَشَمَّتُّہَا ، وَسَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا عَطَسَ أَحَدُکُمْ فَحَمِدَ اللَّہَ فَشَمِّتُوہُ ، وَإِذَا لَمْ یَحْمَدِ اللَّہَ فَلاَ تُشَمِّتُوہُ۔ (بخاری ۹۴۱۔ مسلم ۲۲۹۲)","Sahih","Musannaf Ibn Abi Shaybah 26496","","","كتاب الأدب"
"26497","(۲۶۴۹۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِنْ حَقِّ الْمُسْلِمِ عَلَی الْمُسْلِمِ تَشْمِیتُ الْعَاطِسِ إذَا حَمِدَ اللَّہَ۔ n(مسلم ۱۷۰۴)","Hasan","Musannaf Ibn Abi Shaybah 26497","","","كتاب الأدب"
"26498","(۲۶۴۹۸) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ أَبِی مُنَیْنٍ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : کُنَّا جُلُوسًا عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَطَسَ رَجُلٌ فَحَمِدَ اللَّہَ فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَرْحَمُک اللَّہُ ، ثُمَّ عَطَسَ آخَرُ فَسَکَتَ ، فَلَمْ یَقُلْ لَہُ شَیْئًا ، فَقَالَ : یَا رَسُولَ اللہِ ، عَطَسَ ہَذَا فَقُلْت لَہُ : رَحِمَک اللَّہُ ، وَعَطَسْت فَلَمْ تَقُلْ لِی شَیْئًا ؟ فَقَالَ : إنَّ ہَذَا حَمِدَ اللَّہَ وَأَنْتَ سَکَتَّ۔ (بخاری ۹۳۰)","Hasan","Musannaf Ibn Abi Shaybah 26498","","","كتاب الأدب"
"26499","(۲۶۴۹۹) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ، عَنْ غَالِبٍ، قَالَ: کَانَ الْحَسَنُ، وَابْنُ سِیرِینَ لاَ یُشَمِّتَانِ الْعَاطِسَ حَتَّی یَحْمَدَاللَّہَ۔","","Musannaf Ibn Abi Shaybah 26499","","","كتاب الأدب"
"26500","(۲۶۵۰۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، قَالَ : عَطَسَ رجل عِنْدَ الْقَاسِمِ فَقَالَ لَہُ الْقَاسِمُ : قُلْ : الْحَمْدُ لِلَّہِ ، فَلَمَا قَالَ شَمَّتَہُ۔","","Musannaf Ibn Abi Shaybah 26500","","","كتاب الأدب"
"26501","(۲۶۵۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، أَنَّ رَجُلاً عَطَسَ عِنْدَہُ فَشَمَّتَہُ ، ثُمَّ عَطَسَ فَشَمَّتَہُ ، ثُمَّ عَادَ فِی الثَّالِثَۃِ فَقَالَ : إنَّک مَضْنُوکٌ۔","Da'if","Musannaf Ibn Abi Shaybah 26501","","","كتاب الأدب"
"26502","(۲۶۵۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : شَمِّتِ الْعَاطِسَ مَا بَیْنَکَ وَبَیْنَہُ ثَلاَثًا ، فَإِنْ زَادَ ، فَہُوَ رِیحٌ۔","Da'if","Musannaf Ibn Abi Shaybah 26502","","","كتاب الأدب"
"26503","(۲۶۵۰۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، قَالَ : حدَّثَنِی إیَاسُ بْنُ سَلَمَۃَ بْنِ الأَکْوَعِ ، أَنَّ أَبَاہُ حَدَّثَہُ ، أَنَّ رَجُلاً عَطَسَ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : رَحِمَک اللَّہُ ، ثُمَّ عَطَسَ الثَّانِیَۃَ ، فَقَالَ : ہُوَ مَزْکُومٌ۔ (مسلم ۲۲۹۲۔ ابوداؤد ۴۹۹۸)","Sahih","Musannaf Ibn Abi Shaybah 26503","","","كتاب الأدب"
"26504","(۲۶۵۰۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُصْعَبِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ذُؤَیْبٍ ، قَالَ : عَطَسَ رَجُلٌ عِنْدَ ابْنِ الزُّبَیْرِ فَشَمَّتَہُ ، ثُمَّ عَطَسَ فَشَمَّتَہُ ، ثُمَّ عَطَسَ الثَّالِثَۃَ فَشَمَّتَہُ ، ثُمَّ عَطَسَ فِی الرَّابِعَۃِ فَقَالَ لَہُ : ابْنُ الزُّبَیْرِ : إنَّک مَضْنُوکٌ فَامْتَخِط۔","Da'if","Musannaf Ibn Abi Shaybah 26504","","","كتاب الأدب"
"26505","(۲۶۵۰۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عَمْرُو بْنُ الْعَاصِ : إذَا عَطَسَ أَحَدُکُمْ ثَلاَثَ مَرَّاتٍ فَشَمِّتُوہُ ، فَإِنْ زَادَ فَلاَ تُشَمِّتُوہُ ، فَإِنَّمَا ہُوَ دَائٌ یَخْرُجُ مِنْ رَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 26505","","","كتاب الأدب"
"26506","(۲۶۵۰۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَیْرِ ، أَنَّ رَجُلاً عَطَسَ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَشَمَّتَہُ ، ثُمَّ عَطَسَ فَشَمَّتَہُ ، ثُمَّ عَطَسَ فَشَمَّتَہُ ، ثُمَّ عَطَسَ الرَّابِعَۃَ فَقَالَ لَہُ : النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّک مَضْنُوکٌ فَامْتَخِط۔","","Musannaf Ibn Abi Shaybah 26506","","","كتاب الأدب"
"26507","(۲۶۵۰۷) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَعْطِسُ مِرَارًا ، قَالَ : شَمِّتْہُ مَرَّۃً وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 26507","","","كتاب الأدب"
"26508","(۲۶۵۰۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ یُجْزِئُہُ أَنْ یُشَمِّتَہُ مَرَّۃً وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 26508","","","كتاب الأدب"
"26509","(۲۶۵۰۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی الْمُنَبِّہِ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنِ الرَّجُلِ یَحْتَاجُ إلَی الدُّخُولِ عَلَی أَہْلِ الذِّمَّۃِ مِنْ مَطَرٍ ، أَوْ بَرْدٍ ، أَیَسْتَأْذِنُ عَلَیْہِمْ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 26509","","","كتاب الأدب"
"26510","(۲۶۵۱۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِمُحَمَّدٍ : کَیْفَ أَسْتَأْذِنُ عَلَی أَہْلِ الْکِتَابِ ؟ قَالَ : إِنْ شِئْتَ قُلْتَ : السَّلاَمُ عَلَی مَنِ اتَّبَعَ الْہُدَی أَلِجُ ؟۔","","Musannaf Ibn Abi Shaybah 26510","","","كتاب الأدب"
"26511","(۲۶۵۱۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَن حُصَیْنٍ، عَنْ أَبِی مَالِکٍ الْغِفَارِیِّ ، قَالَ: إذَا دَخَلْت بَیْتًا فِیہِ الْمُشْرِکُونَ فَقُلْ: السَّلاَمُ عَلَیْنَا وَعَلَی عِبَادِ اللہِ الصَّالِحِینَ، یَحْسَبُونَ أَنَّک قَدْ سَلَّمْت عَلَیْہِمْ، وَقَدْ صَرَفْت السَّلاَمَ عَنہُمْ۔","","Musannaf Ibn Abi Shaybah 26511","","","كتاب الأدب"
"26512","(۲۶۵۱۲) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، أَنَّہُ کَانَ یَسْتَأْذِنُ عَلَی أَہْلِ الذِّمَّۃِ۔","","Musannaf Ibn Abi Shaybah 26512","","","كتاب الأدب"
"26513","(۲۶۵۱۳) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَنْ أَبِی سِنَانٍ، عَن سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: لاَ تَدْخُلْ عَلَی أَہْلِ الْکِتَابِ إلاَّ بِإِذْنٍ۔","","Musannaf Ibn Abi Shaybah 26513","","","كتاب الأدب"
"26514","(۲۶۵۱۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، أَنَّہُ کَانَ یَقُولُ : أندرآیم۔","","Musannaf Ibn Abi Shaybah 26514","","","كتاب الأدب"
"26515","(۲۶۵۱۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی الْمُنَبِّہِ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَن مُجَاہِدٍ ، قَالَ : عَطَسَ رَجُلٌ عِنْدَ ابْنِ عُمَرَ فَقَالَ: أَشْہَبُ، قَالَ ابْنُ عُمَرَ: أَشْہَبُ اسْمُ شَیْطَانٍ، وَضَعَہُ إبْلِیسُ بَیْنَ الْعَطْسَۃِ وَالْحَمْدُ لِلَّہِ لِیُذْکَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 26515","","","كتاب الأدب"
"26516","(۲۶۵۱۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَکْرَہَ أَنْ یَقُولَ : أَشْہَبُ ، إذَا عَطَسَ۔","","Musannaf Ibn Abi Shaybah 26516","","","كتاب الأدب"
"26517","(۲۶۵۱۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا عَطَسَ وَہُوَ وَحْدَہُ فَلْیَقُلِ : الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ ، ثُمَّ یَقُولُ : یَرْحَمُنَا اللَّہُ وَإِیَّاکُمْ ، فَإِنَّہُ یُشَمِّتُہُ مَنْ سَمِعَہُ مِنْ خَلْقِ اللہِ۔","","Musannaf Ibn Abi Shaybah 26517","","","كتاب الأدب"
"26518","(۲۶۵۱۸) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : إذَا عَطَسْت وَأَنْتَ وَحْدَک فَرُدَّ عَلَی مَنْ مَعَک یَعْنِی مِنَ الْمَلاَئِکَۃِ۔","","Musannaf Ibn Abi Shaybah 26518","","","كتاب الأدب"
"26519","(۲۶۵۱۹) حَدَّثَنَا علی بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عِیسَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ عَلِیٍّ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا عَطَسَ أَحَدُکُمْ فَلْیَقُلْ : الْحَمْدُ لِلَّہِ ، وَلْیَرُدَّ عَلَیْہِ مَنْ حَوْلَہُ رَحِمَک اللَّہُ ، وَلْیَرُدَّ عَلَیْہِمْ : یَہْدِیکُمُ اللَّہُ وَیُصْلِحُ بَالَکُمْ۔ (ترمذی ۲۷۴۱۔ احمد ۵/۱۲۲)","Da'if","Musannaf Ibn Abi Shaybah 26519","","","كتاب الأدب"
"26520","(۲۶۵۲۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا عَطَسَ أَحَدُکُمْ فَلْیَقُلِ : الْحَمْدُ لِلَّہِ ، وَلْیَقُلْ مَنْ عِندَہُ : یَرْحَمُک اللَّہُ ، وَلْیَرُدَّ عَلَیْہِمْ : یَغْفِرُ اللَّہُ لَنَا وَلَکُمْ۔ n(بخاری ۹۳۴۔ حاکم ۲۶۶)","Da'if","Musannaf Ibn Abi Shaybah 26520","","","كتاب الأدب"
"26521","(۲۶۵۲۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ أَصحَاب عَبد اللہ إذَا عَطَسَ الرَّجُل، فَقَالَ الْحَمْدُ لِلَّہِ قَالُوا : یَرْحَمُنَا اللَّہُ وَإِیَّاک ، وَیَقُول ہُو : یَغْفِرُ اللَّہُ لَنَا وَلَکُمْ۔","","Musannaf Ibn Abi Shaybah 26521","","","كتاب الأدب"
"26522","(۲۶۵۲۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلاَنَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا شَمَّتَ الْعَاطِسَ ، قَالَ : یَرْحَمُنَا اللَّہُ وَإِیَّاکُمْ ، فَإِذَا عَطَسَ ہُوَ فَشُمِّتَ ، قَالَ : یَغْفِرُ اللَّہُ لَنَا وَلَکُمْ وَیَرْحَمُنَا وَإِیَّاکُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 26522","","","كتاب الأدب"
"26523","(۲۶۵۲۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلاَنَ ، عَنِ الْحَارِثِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَبْدُ اللہِ إذَا عَطَسَ فَشُمِّتَ ، قَالَ : یَغْفِرُ اللَّہُ لَنَا وَلَکُمْ۔","","Musannaf Ibn Abi Shaybah 26523","","","كتاب الأدب"
"26524","(۲۶۵۲۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ إذَا شَمَّتُوا الْعَاطِسَ ، قَالُوا : یَغْفِرُ اللَّہُ لَنَا وَلَکُمْ۔","","Musannaf Ibn Abi Shaybah 26524","","","كتاب الأدب"
"26525","(۲۶۵۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الْحَجَّاجِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا شَمَّتَّ الْعَاطِسَ فَقُلْ : یَرْحَمُک اللَّہُ ، وَیَقُولُ ہُوَ : یَہْدِیکُمُ اللَّہُ وَیُصْلِحُ بَالَکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 26525","","","كتاب الأدب"
"26526","(۲۶۵۲۶) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو ، قَالَ : أَخْبَرَنَا الْمَاجِشُونُ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إذَا رَدَّ فَلْیَقُلْ : یَہْدِیکُمُ اللَّہُ وَیُصْلِحُ بَالَکُمْ۔n(بخاری ۶۲۲۴۔ احمد ۲/۳۵۳)","Sahih","Musannaf Ibn Abi Shaybah 26526","","","كتاب الأدب"
"26527","(۲۶۵۲۷) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَن طَلْحَۃَ بْنِ یَحْیَی ، قَالَ : سَمِعْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ ، وَیَحْیَی وَعِیسَی بْنَ أَبِی طَلْحَۃَ وَإِبْرَاہِیمَ بْنَ مُحَمَّدِ بْنِ طَلْحَۃَ یقولون إذَا عَطَسَ أَحَدُکُمْ فَقِیلَ لَہُ : یَرْحَمُک اللَّہُ ، قَالَ: یَہْدِیکُمُ اللَّہُ وَیُصْلِحُ بَالَکُمْ۔","","Musannaf Ibn Abi Shaybah 26527","","","كتاب الأدب"
"26528","(۲۶۵۲۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَن یُونُسَ ، عَنِ الزُّہْرِیِّ ، قَالَ : حدَّثَنَا أَبُو بَکْرِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ ، عَن مَرْوَانَ بْنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ بْنِ عَبْدِ یَغُوثَ ، عَن أُبَیٍّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ مِنَ الشِّعْرِ حِکْمَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 26528","","","كتاب الأدب"
"26529","(۲۶۵۲۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ الزُّہْرِیِّ، عَن عُرْوَۃَ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: مِنَ الشِعْرِ حِکْمَۃٌ۔","","Musannaf Ibn Abi Shaybah 26529","","","كتاب الأدب"
"26530","(۲۶۵۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا زَائِدَۃُ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : إنَّ مِنَ الشِّعْرِ حُکْمًا۔","","Musannaf Ibn Abi Shaybah 26530","","","كتاب الأدب"
"26531","(۲۶۵۳۱) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیر ، قَالَ : حدَّثَنَا حُسَامُ بْنُ الْمِصَکِّ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ مِنَ الشِّعْرِ حُکْمًا۔","Da'if","Musannaf Ibn Abi Shaybah 26531","","","كتاب الأدب"
"26532","(۲۶۵۳۲) حَدَّثَنَا وَکِیعٌ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ مِنَ الشِّعْرِ حُکْمًا۔","","Musannaf Ibn Abi Shaybah 26532","","","كتاب الأدب"
"26533","(۲۶۵۳۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنِ ابْنِ الشَّرِیدِ ، أَوْ یَعْقُوبَ بْنِ عَاصِمٍ سَمِعَ أَحَدُہُمَا الشَّرِیدَ یَقُولُ : أَرْدَفَنِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَلْفَہُ فَقَالَ : ہَلْ مَعَک مِنْ شِعْرِ أُمَیَّۃَ بْنِ أَبِی الصَّلْتِ شَیْئٌ؟ قُلْتُ: نَعَمْ، قَالَ: ہِیہِ ، فَأَنْشَدْتہ بَیْتًا فَقَالَ : ہِیہِ ، فَلَمْ یَزَلْ یَقُولُ : ہِیہِ ہِیہِ حَتَّی أَنْشَدْتہ مِئَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 26533","","","كتاب الأدب"
"26534","(۲۶۵۳۴) حَدَّثَنَا طَلْقُ بْنُ غَنَّامٍ ، عَن قَیْسٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبِیدَۃَ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ مِنَ الشِّعْرِ حُکْمًا ، وَإِنَّ مِنَ الْبَیَانِ سِحْرًا۔","Da'if","Musannaf Ibn Abi Shaybah 26534","","","كتاب الأدب"
"26535","(۲۶۵۳۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَعْلَی ، عَنْ عَمْرِو بْنِ الشَّرِیدِ ، عَنْ أَبِیہِ ، قَالَ : أَنْشَدْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِئَۃ قَافِیَۃٍ مِنْ شِعْرِ أُمَیَّۃَ بْنِ أَبِی الصَّلْتِ یَقُولُ بَیْنَ کُلِّ قَافِیَۃٍ : ہِیہِ ، وَقَالَ : إِنْ کَادَ لَیُسْلِمُ۔","Hasan","Musannaf Ibn Abi Shaybah 26535","","","كتاب الأدب"
"26536","(۲۶۵۳۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن یَعْقُوبَ بْنِ عُتْبَۃ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ صَدَّقَ أُمَیَّۃَ بْنَ أَبِی الصَّلْتِ فِی شَیْئٍ مِنْ شِعْرِہِ ، أَوْ قَالَ فِی بَیْتَیْنِ مِنْ شِعْرِہِ، فَقَالَ :nزُحَلٌ وَثَوْرٌ تَحْتَ رِجْلِ یَمِینِہ وَالنَّسْرُ لِلاُخْرَی وَلَیْثٌ مُرْصَدُn قالَ : فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَدَقَ۔nوَالشَّمْسُ تَطْلُعُ کُلَّ آخِرِ لَیْلَۃٍ حَمْرَائَ یُصْبِحُ لَوْنُہَا یَتَوَرَّدُn فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَدَقَ۔","","Musannaf Ibn Abi Shaybah 26536","","","كتاب الأدب"
"26537","(۲۶۵۳۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَائِدَۃَ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَمَثَّلُ مِنَ الأَشْعَارِ :وَیَأْتِیک بِالأَخْبَارِ مَنْ لَمْ تُزَوِّدْ۔","Da'if","Musannaf Ibn Abi Shaybah 26537","","","كتاب الأدب"
"26538","(۲۶۵۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن مُوسَی بْنِ طَلْحَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ أَصْدَقَ کَلِمَۃٍ ، قَالَہَا شَاعِرٌ کَلِمَۃُ لَبِیدٍ ، ثُمَّ تَمَثَّلَ أَوَّلَہُ وَتَرَکَ آخِرَہُ :n أَلاَ کُلُّ شَیْئٍ مَا خَلاَ اللَّہَ بَاطِلٌ۔n وَکَادَ أُمَیَّۃُ بْنُ أَبِی الصَّلْتِ أَنْ یُسْلِمَ۔","Sahih","Musannaf Ibn Abi Shaybah 26538","","","كتاب الأدب"
"26539","(۲۶۵۳۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ أَصْدَقَ کَلِمَۃٍ ، قَالَہَا الشَّاعِرُ کَلِمَۃُ لَبِیَدٍ :أَلاَ کُلُّ شَیْئٍ مَا خَلاَ اللَّہَ بَاطِلٌ۔وَکَادَ أُمَیَّۃُ بْنُ أَبِی الصَّلْتِ یُسْلِمَ۔","Sahih","Musannaf Ibn Abi Shaybah 26539","","","كتاب الأدب"
"26540","(۲۶۵۴۰) حَدَّثَنَا عَبْدَۃَ بْنِ سُلَیْمَانَ ، عَنْ أَبِی حیان ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، أَنَّ حَسَّانَ بْنَ ثَابِتٍ أَنْشَدَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَبْیَاتًا فَقَالَ :nشَہِدْت بِإِذْنِ اللہِ أَنَّ مُحَمَّدًاnوَأَنَّ أَبَا یَحْیَی وَیَحْیَی کِلاَہُمَاnوَأَنَّ أَخَا الأَحْقَافِ إذَا قَامَ فِیہُمُnرَسُولُ الَّذِی فَوْقَ السَّمَاوَاتِ مِنْ عَلُnلَہُ عَمَلٌ فِی دِینِہِ مُتَقَبَّلُnیَقُولُ بِذَاتِ اللہِ فِیہِمْ وَیَعْدِلُ","","Musannaf Ibn Abi Shaybah 26540","","","كتاب الأدب"
"26541","(۲۶۵۴۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : اسْتَأْذَنَ حَسَّانُ النَّبِیَّ فِی قُرَیْشٍ ، قَالَ : کَیْفَ تَصْنَعُ بِنَسَبِی فِیہِمْ ؟ قَالَ : أَسُلُّک مِنْہُمْ کَمَا تُسَلُّ الشَّعْرَۃُ مِنَ الْعَجِینِ۔","Da'if","Musannaf Ibn Abi Shaybah 26541","","","كتاب الأدب"
"26542","(۲۶۵۴۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : ذُکِرَ عِنْدَ عَائِشَۃَ حَسَّانُ فَقِیلَ لَہَا : إِنَّہُ قَدْ أَعَانَ عَلَیْک وَفَعَلَ وَفَعَلَ ، فَقَالَتْ : مَہْلاً ، فَإِنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ اللَّہَ یُؤَیِّدُ حَسَّانَ فِی شِعْرِہِ بِرُوحِ الْقُدُسِ۔","Da'if","Musannaf Ibn Abi Shaybah 26542","","","كتاب الأدب"
"26543","(۲۶۵۴۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : اہْجُ الْمُشْرِکِینَ , فَإِنَّ رُوحَ الْقُدُسِ مَعَک۔","Da'if","Musannaf Ibn Abi Shaybah 26543","","","كتاب الأدب"
"26544","(۲۶۵۴۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، أَنَّ حَسَّانَ بْنَ ثَابِتٍ سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَہْجُوَ أَبَا سُفْیَانَ ، قَالَ : فَکَیْفَ بِقَرَابَتِی ؟ قَالَ : وَالَّذِی أَکْرَمَک لأسُلَّنَّکَ مِنْہُمْ سَلَّ الشَّعْرِ مِنَ الْعَجِینِ۔","","Musannaf Ibn Abi Shaybah 26544","","","كتاب الأدب"
"26545","(۲۶۵۴۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِحَسَّانَ بْنِ ثَابِتٍ : اہْجُ الْمُشْرِکِینَ , فَإِنَّ جِبْرِیلَ مَعَک۔","Sahih","Musannaf Ibn Abi Shaybah 26545","","","كتاب الأدب"
"26546","(۲۶۵۴۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی خَالِدٍ الْوَالِبِیِّ ، قَالَ : کُنَّا نُجَالِسُ أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَنَاشَدُونَ الأَشْعَارَ وَیَذْکُرُونَ أَمْرَ الْجَاہِلِیَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 26546","","","كتاب الأدب"
"26547","(۲۶۵۴۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عن أسامۃ , عَن نَافِعٍ ، قَالَ : کَانَت لِعَبْدِ اللہِ بن رواحۃ جَارِیَۃٌ ، فَکَانَ یُکَاتِمُ امْرَأَتَہُ غَشَیَانَہَا ، قَالَ : فَوَقَعَ عَلَیْہَا ذَاتَ یَوْمٍ ، فَجَائَ إلَی امْرَأَتِہِ فَاتَّہَمَتْہُ أَنْ یَکُونَ وَقَعَ عَلَیْہَا ، فَأَنْکَرَ ذَلِکَ فَقَالَتْ لہ : اقْرَأْ إذًا الْقُرْآنَ ، فَقَالَ :nشَہِدْت بِإِذْنِ اللہِ أَنَّ مُحَمَّدًاnوَأَنَّ أَبَا یَحْیَی وَیَحْیَی کِلاَہُمَاnرَسُولُ الَّذِی فَوْقَ السَّمَاوَاتِ مِنْ عَلُnلَہُ عَمَلٌ فِی دِینِہِ مُتَقَبَّلُn فَقَالَتْ : أَولَی لکَ۔","","Musannaf Ibn Abi Shaybah 26547","","","كتاب الأدب"
"26548","(۲۶۵۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَن مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن خَیْثَمَۃَ ، قَالَ أَتَی عُمَرَ شَاعِرٌ فَقَالَ : أُنْشِدُک ، فَاسْتَنْشَدَہُ ، فَجَعَلَ ہُوَ یُنْشِدُہُ ، فَذَکَرَ مُحَمَّدًا فَقَالَ : غَفَرَ اللَّہُ لِمُحَمَّدٍ بِمَا صَبَرَ ، قَالَ : یَقُولُ عُمَرُ : قَدْ فَعَلَ ، ثُمَّ أَبَا بَکْرٍ جَمِیعًا وَعُمَرَ ، فَقَالَ : مَا شَائَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 26548","","","كتاب الأدب"
"26549","(۲۶۵۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مُصْعَبِ بْنِ سُلَیْمٍ ، عَنْ أَنَسٍ ، قَالَ : تَمَثَّلَ الْبَرَائُ بَیْتًا مِنْ شِعْرٍ فَقُلْت : تُمَثِّلُ أَخِی بِبَیْتٍ مِنْ شِعْرٍ لاَ تَدْرِی لَعَلَّہُ آخِرُ شَیْئٍ تَکَلَّمْت بِہِ ، قَالَ : لاَ أَمُوتُ عَلَی فِرَاشِی ، لَقَدْ قَتَلْت مِنَ الْمُشْرِکِینَ وَالْمُنَافِقِینَ مِئَۃ إلاَّ رَجُلاً۔","Hasan","Musannaf Ibn Abi Shaybah 26549","","","كتاب الأدب"
"26550","(۲۶۵۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی خَالِدٍ الْوَالِبِیِّ ، قَالَ : کُنْتُ أَجْلِسُ مَعَ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَعَلَّہُمْ لاَ یَذْکُرُونَ إلاَّ الشِّعْرَ حَتَّی یَتَفَرَّقُوا۔","Hasan","Musannaf Ibn Abi Shaybah 26550","","","كتاب الأدب"
"26551","(۲۶۵۵۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ ، عَنْ أَبِی الْجَحَّافِ ، عَنِ الشَّعْبِیِّ ، قَالَ کَانَ أَبُو بَکْرٍ شَاعِرًا ، وَکَانَ عُمَرُ شَاعِرًا ، وَکَانَ عَلِیٌّ شَاعِرًا۔","","Musannaf Ibn Abi Shaybah 26551","","","كتاب الأدب"
"26552","(۲۶۵۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنَا مُجَالِدٌ ، قَالَ : أَخْبَرَنَی عَامِرٌ ، قَالَ : أَخْبَرَنَا رِبْعِیُّ بْنُ حِرَاشٍ ، أَنَّہُ أَتَی عُمَرَ فِی نَفَرٍ مِنْ غَطَفَانَ فَذَکَرُوا الشِّعْرَ فَقَالَ عُمَرُ : أَیُّ شُعَرَائِکُمْ أَشْعَرُ ؟ فَقَالُوا : أَنْتَ أَعْلَمُ یَا أَمِیرَ الْمُؤْمِنِینَ ، قَالَ : فَقَالَ عُمَرُ : مَنِ الَّذِی یَقُولُ :nأَتَیْتُک عَارِیًّا خَلِقًا ثِیَابِیnعَلَی خَوْفٍ تُظَنُّ بِی الظُّنُونُnفَأَلْفَیْت الأَمَانَۃَ لَمْ تَخُنْہَاnکَذَلِکَ کَانَ نُوحٌ لاَ یَخُونُnقُلنا النَّابِغَۃُ , ثُمَّ قَالَ مِثْلَ ذَلِکَ ، ثُمَّ قَالَ : مَنِ الَّذِی یَقُولُ :nحَلَفْت فَلَمْ أَتْرُکْ لِنَفْسِکَ رِیبَۃًnوَلَیْسَ وَرَائَ اللہِ لِلْمَرْئِ مَذْہَبُnثُمَّ قَالَ : مَنِ الَّذِی یَقُولُ :nإلاَ سُلَیْمَانَ إذْ قَالَ الإِلَہُ لَہُnقُمْ فِی الْبَرِیَّۃِ فَازْجُرْہَا عَلی الْفَنَدِnقلْنَا : النَّابِغَۃُ ، قَالَ : ہَذَا أَشْعَرُ شُعَرَائِکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 26552","","","كتاب الأدب"
"26553","(۲۶۵۵۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ أَبِی الضُّحَی ، أَنَّ أَبَا بَکْرٍ اسْتَنْشَدَ مَعْدِی کَرِبَ فَأَنْشَدَہُ ، وَقَالَ : مَا اسْتَنْشَدْت فِی الإِسْلاَمِ أَحَدًا قَبْلَک۔","","Musannaf Ibn Abi Shaybah 26553","","","كتاب الأدب"
"26554","(۲۶۵۵۴) حَدَّثَنَا وَکِیعٌ ، عَن سَعِیدِ بْنِ حَسَّانَ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : قَالَ أَبُو بَکْرٍ : رُبَّمَا قَالَ الشَّاعِرُ الْکَلِمَۃَ الْحِکَمِیَّۃَ۔","","Musannaf Ibn Abi Shaybah 26554","","","كتاب الأدب"
"26555","(۲۶۵۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَن ہَانِئٍ ، قَالَ : سَمِعْتُ عَلِیًّا یَقُولُ :nاشْدُدْ حَیَازِیمَکَ لِلْمَوْتِnوَلاَ تَجْزَعْ مِنَ الْمَوْتِnفإنَّ الْمَوْتَ لاَقِیکَاnإذَا حَلَّ بِوَادِیکَا","Hasan","Musannaf Ibn Abi Shaybah 26555","","","كتاب الأدب"
"26556","(۲۶۵۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن یَزِیدَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ عَلِیُّ بْنُ أَبِی طَالِبٍ لِلْمُرَادِیِّ :nأُرِیدُ حَیَاتَہُ وَیُرِیدُ قَتْلِیnعَذِیرَک مِنْ خَلِیِّکَ مِنْ مُرَادِ","","Musannaf Ibn Abi Shaybah 26556","","","كتاب الأدب"
"26557","(۲۶۵۵۷) حَدَّثَنَا یَعلی بْنُ عُبَیْدٍ ، عَنْ أَبِی حَیَّانَ ، عَن مُجَمِّعٍ ، قَالَ : بَنَی عَلِیٌّ سِجْنًا فَسَمَّاہُ نَافِعًا ، ثُمَّ بَدَا لَہُ فَکَسَّرَہُ وَبَنَی أَحْصَنَ مِنْہُ ، ثُمَّ قَالَ بَیْتَ شِعْرٍ :nأَلَمْ تَرَونی کَیِّسًا مُکَیَّسًاnبَنَیْت بَعْدَ نَافِعٍ مُخَیَّسًا","","Musannaf Ibn Abi Shaybah 26557","","","كتاب الأدب"
"26558","(۲۶۵۵۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن دَاوُد ، عَنِ الشَّعْبِیِّ ، أَنَّ عُمَرَ کَتَبَ إلَی الْمُغِیرَۃِ أَنْ یَسْتَنْطِق الشُّعَرَائَ عَندَہُ۔","","Musannaf Ibn Abi Shaybah 26558","","","كتاب الأدب"
"26559","(۲۶۵۵۹) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَشِیر ، عَن عِکْرِمَۃَ ، قَالَ : کُنْتُ أَسِیرُ مَعَ ابْنِ عَبَّاسٍ وَنَحْنُ مُنْطَلِقُونَ إلَی عَرَفَاتٍ ، فَکُنْت أُنْشِدُہُ الشِّعْرَ ، وَیَفْتَحُہُ عَلَیَّ۔","Sahih","Musannaf Ibn Abi Shaybah 26559","","","كتاب الأدب"
"26560","(۲۶۵۶۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن شُعْبَۃَ ، عَن قَتَادَۃَ ، عَن مُطَرِّفِ بْنِ عَبْدِ اللہِ ، قَالَ : خَرَجْت مَعَ عِمْرَانَ بْنِ حُصَیْنٍ إلَی الْکُوفَۃِ ، فَکَانَ لاَ یَأْتِی عَلَیْہِ یَوْمٌ إلاَّ أَنْشَدَنَا فِیہِ الشِّعْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 26560","","","كتاب الأدب"
"26561","(۲۶۵۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَن مُحَمَّدِ بْنِ سِیرِینَ ، عَن کَثِیرِ بْنِ أَفْلَحَ ، قَالَ : کَانَ أخِرُ مَجْلِسٍ جَلَسْنَا فِیہِ مَعَ زَیْدِ بْنِ ثَابِتٍ مَجْلِسًا تَنَاشَدْنَا فِیہِ الشِّعْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 26561","","","كتاب الأدب"
"26562","(۲۶۵۶۲) حَدَّثَنَا عَبْدَۃُ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قدِمْنَا الْمَدِینَۃَ وَہِیَ وَبِیئۃٌ فَاشْتَکَی أَبُو بَکْرٍ وَاشْتَکَی بِلاَلٌ ، قَالَتْ : فَکَانَ أَبُو بَکْرٍ تعنی إذَا أَفَاقَ یَقُولُ :nکُلُّ امْرِئٍ مُصْبِحٌ فِی أَہْلِہِnوَالْمَوْتُ أَدْنَی مِنْ شِرَاکِ نَعْلِہِnقالَتْ : وَکَانَ بِلاَلٌ إذَا أَفَاقَ یَقُولُ :nأَلاَ لَیْتَ شِعْرِی ہَلْ أَبِیتَنَّ لَیْلَۃًnوہَلْ أَرِدَنَّ یَوْمًا مِیَاہَ مِجَنَّۃٍnبِوَادٍ وَحَوْلِی إذْخِرٌ وَجَلِیلُnوَہَلْ یَبْدُوَنَّ لِی شَامَۃٌ وَطَفِیلُ","Sahih","Musannaf Ibn Abi Shaybah 26562","","","كتاب الأدب"
"26563","(۲۶۵۶۳) حَدَّثَنَا عَبْدَۃُ، عَن ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ، عَنْ عَائِشَۃَ، قَالَتْ: کَانَتْ تَتَمَثَّلُ ہَذَیْنِ الْبَیْتَیْنِ مِنْ قَوْلِ لَبِیَدٍ:nذَہَبَ الَّذِینَ یُعَاشُ فِی أَکْنَافِہِمْnیَتَأَکَّلُونَ مَشِیحَۃً وَخِیَانَۃًnوَبَقِیت فِی خَلَفٍ کَجِلْدِ الأَجْرَبِnوَیُعَابُ قَائِلُہُمْ وَإِنْ لَمْ یَشْغَبْ","Sahih","Musannaf Ibn Abi Shaybah 26563","","","كتاب الأدب"
"26564","(۲۶۵۶۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ عُمَرُ یَتَمَثَّلُ بِہَذَا الْبَیْتِ :n إلَیْک تَعْدُو قَلِقًا وَضِینُہَا n مُعْترِضًا فِی بَطْنِہَا جَنِینُہَا۔n مُخَالِفًا دِینَ النَّصَارَی دِینہَا۔","Sahih","Musannaf Ibn Abi Shaybah 26564","","","كتاب الأدب"
"26565","(۲۶۵۶۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن مُسْلِمٍ ، عَن مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : دَخَلَ عَلَیْہَا حَسَّانُ بْنُ ثَابِتٍ بَعْدَ مَا کُفَّ بَصَرُہُ ، فَقِیلَ لَہَا ، أَتُدْخِلِینَ عَلَیْک ہَذَا الَّذِی قَالَ اللَّہُ : {وَالَّذِی تَوَلَّی کِبْرَہُ مِنْہُمْ لَہُ عَذَابٌ عَظِیمٌ} قَالَتْ : أَوَلَیْسَ فِی عَذَابٍ عَظِیمٍ ، قَدْ کُفَّ بَصَرُہُ ، قَالَ : فَأَنْشَدَہَا بَیْتًا ، قَالَہُ لاِبْنَتِہِ :nحَصَانٌ رَزَانٌ مَا تُزَنُّ بِرِیبَۃٍ وَتُصْبِحُ غَرْثَی مِنْ لُحُومِ الْغَوَافِلِn قالَتْ : لَکِنَّ أَنْتَ لَسْت کَذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 26565","","","كتاب الأدب"
"26566","(۲۶۵۶۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی فَزَارَۃَ ، عَنِ الْحَکَمِ ، أَنَّ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی أَنْشَدَ شِعْرًا فِی الْمَسْجِدِ وَالْمُؤَذِّنُ یُقِیمُ۔","","Musannaf Ibn Abi Shaybah 26566","","","كتاب الأدب"
"26567","(۲۶۵۶۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : مَا رَأَیْت أَحَدًا أَعْلَمَ بِشِعْرٍ ، وَلاَ فَرِیضَۃٍ ، وَلاَ أَعْلَمَ بِفِقْہٍ مِنْ عَائِشَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 26567","","","كتاب الأدب"
"26568","(۲۶۵۶۸) حَدَّثَنَا شَرِیکٌ ، عَن فُرَاتٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : (الْقَانِعُ) السَّائِلُ ، ثُمَّ أَنْشَدَ بیت شَمَّاخٍ وَقَالَ:nلَمَالُ الْمَرْئِ یُصْلِحُہُ فیغنی ۔۔۔ مَفَاقِرُہُ أَعَفُّ مِنَ الْقَنُوعِ۔","","Musannaf Ibn Abi Shaybah 26568","","","كتاب الأدب"
"26569","(۲۶۵۶۹) حَدَّثَنَا شَرِیکٌ ، عَن بَیَانٍ ، عَنْ عَامِرٍ {فَإِذَا ہُمْ بِالسَّاہِرَۃِ} قَالَ : بِالأَرْضِ ، ثُمَّ أَنْشَدَ بیتا لأُمَیَّۃِ :nفأتانا بلَحْمٍ بسَاہِرَۃٍ وَبَحْر","","Musannaf Ibn Abi Shaybah 26569","","","كتاب الأدب"
"26570","(۲۶۵۷۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، قَالَ : مَا سَمِعت الْحَسَنَ یَتَمَثَّلُ بِبَیْتٍ مِنْ شِعْرٍ قَطُّ إلاَّ ہَذَا الْبَیْتَ :nلَیْسَ مَنْ مَاتَ فَاسْتَرَاحَ بِمَیِّتٍ إنَّمَا الْمَیِّتُ مَیِّتُ الأَحْیَائِn ثُمَّ قَالَ : صَدَقَ وَاللَّہِ ، إِنَّہُ لَیَکُونُ حَیًّا وَہُوَ مَیِّتُ الْقَلْبِ۔","","Musannaf Ibn Abi Shaybah 26570","","","كتاب الأدب"
"26571","(۲۶۵۷۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَن ہِشَامٍ ، قَالَ : سَمِعْتُ أَبِی یَقُولُ : تَرَکْتہَا یَعْنِی عَائِشَۃَ قَبْلَ أَنْ تَمُوتَ بِثَلاَثِ سِنِینَ ، وَمَا رَأَیْت أَحَدًا أَعْلَمَ بِکِتَابِ اللہِ ، وَلاَ بِسُنَّۃٍ ، عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ بِشِعْرٍ ، وَلاَ فَرِیضَۃٍ مِنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 26571","","","كتاب الأدب"
"26572","(۲۶۵۷۲) حَدَّثَنَا أَبُو دَاوُدَ ، قَالَ : الطَّیَالِسِیُّ ، عَن مِسْمَعِ بْنِ مَالِکٍ الْیَرْبُوعِیِّ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ یَقُولُ : کَانَ ابْنُ عَبَّاسٍ إذَا سُئِلَ عَن شَیْئٍ مِنَ الْقُرْآنِ أَنْشَدَ أشْعَارًا مِنْ أَشْعَارِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 26572","","","كتاب الأدب"
"26573","(۲۶۵۷۳) حَدَّثَنَا حُسَین بْنُ عَلِیٍّ ، عَنِ ابْنِ أَبْجَرَ ، قَالَ : مَرَّ عَامِرٌ بِرَجُلَیْنِ عِنْدَ مَجْمَعِ طَرِیقَیْنِ وَہُمَا یَغتَبَانہ وَیَقَعَانِ فِیہِ فَقَالَ :nہَنِیئًا مَرِیئًا غَیْرَ دَائِ مُخَامِرٍ لِعَزَّۃَ مِنْ أَعْرَاضِنَا مَا اسْتَحَلَّتِ","","Musannaf Ibn Abi Shaybah 26573","","","كتاب الأدب"
"26574","(۲۶۵۷۴) حَدَّثَنَا یَحْیَی بْنُ وَاضِحٍ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ أَبِی الْحَسَنِ الْبَرَّادِ ، قَالَ : لَمَّا نَزَلَتْ ہَذِہِ الآیَۃُ {وَالشُّعَرَائُ یَتَّبِعُہُمَ الْغَاوُونَ} جَائَ عَبْدُ اللہِ بْنُ رَوَاحَۃَ وَکَعْبُ بْنُ مَالِکٍ وَحَسَّانُ بْنُ ثَابِتٍ إلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُمْ یَبْکُونَ ، فَقَالُوا : یَا رَسُولَ اللہِ ، أَنْزَلَ اللَّہُ ہَذِہِ الآیَۃَ وَہُوَ یَعْلَمُ أَنَّا شُعَرَائُ ، فَقَالَ : اقَرَؤُوا مَا بَعْدَہَا : {إلاَ الَّذِینَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ} أَنْتُمْ {وَانْتَصَرُوا} أَنْتُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 26574","","","كتاب الأدب"
"26575","(۲۶۵۷۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن سَلَمَۃَ، عَن عِکْرِمَۃَ: {وَالشُّعَرَائُ یَتَّبِعُہُمَ الْغَاوُونَ} قَالَ: عُصَاۃُ الْجِنِّ۔","","Musannaf Ibn Abi Shaybah 26575","","","كتاب الأدب"
"26576","(۲۶۵۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخَطْمِیِّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَبْنِی الْمَسْجِدَ ، وَعَبْدُ اللہِ بْنُ رَوَاحَۃَ یَقُولُ :n أَفْلَحَ مَنْ یُعَالِجُ الْمَسَاجِدَا۔n وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ :n قَدْ أَفْلَحَ مَنْ یُعَالِجُ الْمَسَاجِدَا۔n یَتْلُو الْقُرْآنَ قَائِمًا وَقَاعِدَا۔n وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ :n وَیَتْلُو الْقُرْآنَ قَائِمًا وَقَاعِدَا۔n وَہُمْ یَبْنُونَ الْمَسْجِدَ۔","","Musannaf Ibn Abi Shaybah 26576","","","كتاب الأدب"
"26577","(۲۶۵۷۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، حدَّثَنَا مُجَالِدٌ ، عَنْ عَامِرٍ ، أَنَّ حَارِثَۃَ بْنَ بَدْرٍ التَّیْمِیَّ مِنْ أَہْلِ الْبَصْرَۃِ ، قَالَ :nأَلاَ أَبْلِغَنْ ہَمْدَانَ إِمَّا لَقِیتہَا سَلاَما فَلاَ یَسْلَمُ عَدُوٌّ یَعِیبُہَاnلَعَمْرُ یَمِینًا إنَّ ہَمْدَانَ تَتَّقِی الإلَہُ وَیَقْضِی بِالْکِتَابِ خَطِیبُہَاn وقال :nفشَیَّب رَأْسِی وَاسْتَخَفَّ حَلومَنَا رُعُودُ الْمَنَایَا حَوْلَہَا وَبُرُوقُہَاnوَإِنَّا لَتَسْتَحْلِی الْمَنَایَا نُفُوسُنَا وَنَتْرُکُ أُخْرَی مَرَّۃً مَا نَذُوقُہَاn قالَ عَامِرٌ : فَحُدِّثَ بِہَذَا الْحَدِیثِ عَبْدُ اللَّہُ بْنُ جَعْفَرٍ ، فقَالَ : کُنَّا نَحْنُ أَحَقَّ بِہَذِہِ الأَبْیَاتِ مِنْ ہَمَدَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 26577","","","كتاب الأدب"
"26578","(۲۶۵۷۸) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ بْنُ قُدَامَۃَ الْجُمَحِیُّ ، قَالَ : حَدَّثَنِی عُمَر بْنُ شُعَیْبٍ ، أَخو عَمْرُو بْنُ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : لَمَّا رَفَعَ النَّاسُ أَیْدِیَہُمْ مِنْ صِفِّینَ ، قَالَ عَمْرُو بْنُ الْعَاصِ :nشَبَّتِ الْحَرْبُ فَأَعْدَدْت لَہَاnیَصِلُ الشَّدَّ بِشَدٍّ فَإِذَاnجُرْشُعٌ أَعْظَمُہُ جُفْرَتْہُnمُفْرَعَ الْحَارِکِ ملویَّ الثبجnونت الْخَیْلُ مِنَ الشد مَعَجْnفَإِذَا ابْتَلَّ مِنَ الْمَائِ حدجnقالَ : وَقَالَ عَبْدُ اللہِ بْنُ عَمْرٍو :nلَوْ شَہِدْت جَمَلٌ مَقَامِی وَمَشْہَدِیnبِصِفِّینَ یَوْمًا شَابَ مِنْہَا الذَّوَائِبُnغَدَاۃَ أَتَی أَہْلُ الْعِرَاقِ کَأَنَّہُمْnوَجِئْنَاہُمْ بِرَدًی کَأَنَّ صُفُوفَنَاnوَدَارَتْ رَحَانَا وَاسْتَدَارَتْ رَحَاہُمْnإذَا قُلْتَ قَدْ وَلَّوْا سِرَاعًا بَدَتْ لَنَاnفَقَالُوا لَنَا إنَّا نَرَی أَنْ تُبَایِعُواnسَحَابُ رَبِیعٍ رفَّعتہ الْجَنَائِبُnمِنَ الْبَحْرِ مَدُّ مَوْجُہِ مُتَرَاکِبُnسَرَاۃَ النَّہَار مَا تُوَالّی الْمَنَاکِبُnکَتَائِبُ مِنْہُمْ فَارْجَحَنَّتْ کَتَائِبُnعَلِیًّا فَقُلْنَا بَلْ نَرَی أَنْ تُضَارَبُوا","Da'if","Musannaf Ibn Abi Shaybah 26578","","","كتاب الأدب"
"26579","(۲۶۵۷۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حَمْزَۃَ أَبِی عِمَارَۃَ ، قَالَ : قَالَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ لِعُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ : مَالَک وَلِلشِّعْرِ ؟ قَالَ : وَہَلْ یَسْتَطِیعُ الْمَصْدُورُ إلاَّ أَنْ یَنْفُثَ۔","","Musannaf Ibn Abi Shaybah 26579","","","كتاب الأدب"
"26580","(۲۶۵۸۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، قَالَ : کنت إذَا لَقِیت عُبَیْدَ اللہِ بْنَ عَبْدِ اللہِ فَکَأَنَّمَا أُفَجِّرُ بِہِ بَحْرًا۔","","Musannaf Ibn Abi Shaybah 26580","","","كتاب الأدب"
"26581","(۲۶۵۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْوَلِیدِ بْنِ جُمَیْعٍ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : لَمْ یَکُنْ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَحَزِّقین ، وَلاَ مُتَمَاوِتِینَ ، وَکَانُوا یَتَنَاشَدُونَ الشِّعْرَ فِی مَجَالِسِہِمْ ، وَیَذْکُرُونَ أمْرَ جَاہِلِیَّتِہِمْ ، فَإِذَا أُرِیدَ أَحَدُہُمْ عَلَی شَیْئٍ مِنْ دِینِہِ دَارَتْ حَمَالِیقُ عَیْنَیْہِ کَأَنَّہُ مَجْنُونٌ۔","Hasan","Musannaf Ibn Abi Shaybah 26581","","","كتاب الأدب"
"26582","(۲۶۵۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ ابْنِ شُبْرُمَۃَ ، قَالَ : سَمعتہ یَقُول کَانَ الفَرَزْدَق مِن أَشْعَر النَّاس۔","","Musannaf Ibn Abi Shaybah 26582","","","كتاب الأدب"
"26583","(۲۶۵۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ أَبی سُفیَان السَّعدِی ، قَالَ : سَمِعْتُ الْحَسَنَ یَتَمَثَّلُ ہَذَا الْبَیْتَ :nیَسُرُّ الْفَتَی مَا کَانَ قَدَّمَ مِنْ تُقًی إذَا عَرَفَ الدَّائَ الَّذِی ہُوَ قَاتِلُہْ۔","","Musannaf Ibn Abi Shaybah 26583","","","كتاب الأدب"
"26584","(۲۶۵۸۴) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ عَامِرٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا اسْتَرَاثَ الْخَبَرَ تَمَثَّلَ بِبَیْتِ طَرَفَۃَ : وَیَأْتِیک بِالأَخْبَارِ مَنْ لَمْ تُزَوِّدْ۔","Hasan","Musannaf Ibn Abi Shaybah 26584","","","كتاب الأدب"
"26585","(۲۶۵۸۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ: أَخْبَرَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَبْدِالرَّحْمَنِ، عَنْ أَبِیہِ، قَالَ: کُنْتُ أُجَالِسُ أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَعَ أَبِی فِی الْمَسْجِدِ فَیَتَنَاشَدُونَ الأَشْعَارَ ، وَیَذْکُرُونَ حَدِیثَ الْجَاہِلِیَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 26585","","","كتاب الأدب"
"26586","(۲۶۵۸۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا شَرِیکٌ ، عَن سِمَاکِ بْنِ حَرْبٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کُنَّا نَأْتِی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیَجْلِسُ أَحَدُنَا حَیْثُ یَنْتَہِی، وَکَانُوا یَتَذَاکَرُونَ الشِّعْرَ وَحَدِیثَ الْجَاہِلِیَّۃِ عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلاَ یَنْہَاہُمْ ، وَرُبَّمَا تَبَسَّمَ۔","Hasan","Musannaf Ibn Abi Shaybah 26586","","","كتاب الأدب"
"26587","(۲۶۵۸۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَن قَتَادَۃَ ، عَن مُطَرِّفٍ ، قَالَ : صَحِبْت عِمْرَانَ بْنَ حُصَیْنٍ فِی سَفَرٍ ، فَمَا کَانَ یَوْمٌ إلاَّ یُنْشِدُ فِیہِ شِعْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 26587","","","كتاب الأدب"
"26588","(۲۶۵۸۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، قَالَ : سَأَلَ رَجُلٌ مُحَمَّدًا وَہُوَ فِی الْمَسْجِدِ وَالرَّجُلُ یُرِیدُ أَنْ یُصَلِّیَ : أَیَتَوَضَّأُ مَنْ یُنْشِدُ الشِّعْرَ ؟ وَیُنْشِدُ الشِّعْرَ فِی الْمَسْجِدِ ؟ قَالَ : وَأَنْشَدَہُ أَبْیَاتًا مِنْ شِعْرِ حَسَّانَ ذَلِکَ الرَّقِیقِ ، ثُمَّ افْتَتَحَ الصَّلاَۃَ۔","","Musannaf Ibn Abi Shaybah 26588","","","كتاب الأدب"
"26589","(۲۶۵۸۹) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَن حَمَّادِ بْنِ زَیْدٍ ، عَنْ عَلِیِّ بْنِ زَیْدِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرَۃَ ، عَنِ الأَسْوَدِ بْنِ سَرِیعٍ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، إنِّی مَدَحْت اللَّہَ مَدْحَۃً وَمَدَحْتُک أُخْرَی ، قَالَ : ہَاتِ , وَابْدَأْ بِمَدْحِکَ اللَّہَ۔","Da'if","Musannaf Ibn Abi Shaybah 26589","","","كتاب الأدب"
"26590","(۲۶۵۹۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا دَیْلَمُ بْنُ غَزْوَانَ ، قَالَ : حَدَّثَنَا ثَابِتٌ ، عَنْ أَنَسٍ ، قَالَ : حَضَرَتْ حَرْبًا فَقَالَ عَبْدُ اللہِ بْنُ رَوَاحَۃَ :nیَا نَفْسُ أَلاَ أَرَاک تَکْرَہِینَ الْجَنَّۃَ أَحْلِفُ بِاَللَّہِ لَتَنْزِلَنَّہْ طَائعۃ أَو لَتکرہِنَّہ","Hasan","Musannaf Ibn Abi Shaybah 26590","","","كتاب الأدب"
"26591","(۲۶۵۹۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدِ بْنِ جُدْعَانَ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، قَالَتْ : تَمَثَّلْت بِہَذَا الْبَیْتِ ، وَأَبُو بَکْرٍ یَقْضِی :nوَأَبْیَضُ یُسْتَسْقَی الْغَمَامُ بِوَجْہِہِ ثِمَالْ الْیَتَامَی عِصْمَۃٌ لِلأََرَامِلِn فَقَالَ أَبُو بَکْرٍ : ذَاکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 26591","","","كتاب الأدب"
"26592","(۲۶۵۹۲) حَدَّثَنَا مُعْتَمِرٌ ، عَن مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّ رسول اللہ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمْ یَقُلْ شَیْئًا مِنَ الشِّعْرِ إلاَّ قَدْ قِیلَ لہ إلاَّ ہَذَا :nہَذَا الْحِمَالُ لاَ حِمَالُ خَیْبَرْ ہَذَا أَبَرَّ رَبَّنَا وَأَطْہَرْ","","Musannaf Ibn Abi Shaybah 26592","","","كتاب الأدب"
"26593","(۲۶۵۹۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ الْخَنْدَقِ ، وَکَانَ کَثِیرَ شَعْرِ الصَّدْرِ وَہُوَ یَرْتَجِزُ بِرَجَزِ عَبْدِ اللہِ بْنِ رَوَاحَۃَ وَہُوَ یَقُولُ :nاللَّہُمَّ لَوْلاَ أَنْتَ مَا اہْتَدَیْنَاnوَلاَ تَصَدَّقْنَا وَلاَ صَلَّیْنَاnفَأَنْزِلَنْ سَکِینَۃً عَلَیْنَاnوَثَبِّتِ الأَقْدَامَ إِنْ لاَقَیْنَاnإنَّ الأُلَی قَدْ بَغَوْا عَلَیْنَاnوَإِنْ أَرَادُوا فِتْنَۃً أَبَیْنَا","Sahih","Musannaf Ibn Abi Shaybah 26593","","","كتاب الأدب"
"26594","(۲۶۵۹۴) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : مَا وَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دُبُرَہُ یَوْمَ حُنَیْنٍ ، قَالَ : وَالْعَبَّاسُ ، وَأَبُو سُفْیَانَ آخِذَانِ بِلِجَامِ بَغْلَتِہِ وَہُوَ یَقُولُ :nأَنَا النَّبِیُّ لاَ کَذِبْ أَنَا ابْنُ عَبْدِ الْمُطَّلِبْ","Hasan","Musannaf Ibn Abi Shaybah 26594","","","كتاب الأدب"
"26595","(۲۶۵۹۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَن جُنْدَبِ بْنِ سُفْیَانَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ فِی غَارٍ فَنُکِبَ فَقَالَ :nہَلْ أَنْتِ إلاَّ إصْبَعٌ دُمِیتِ وَفِی سَبِیلِ اللہِ مَا لَقِیتِ۔","Sahih","Musannaf Ibn Abi Shaybah 26595","","","كتاب الأدب"
"26596","(۲۶۵۹۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ :nإنَّ الْعَیْشَ عَیْشُ الآخِرَہْ فَاغْفِرْ لِلأََنْصَارِ وَالْمُہَاجِرَہْ","Sahih","Musannaf Ibn Abi Shaybah 26596","","","كتاب الأدب"
"26597","(۲۶۵۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی الْمُعَلَّی ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَقْرَأُ (دَارَسْت) وَیَقُولُ : دَارِسٌ کَطَعْمِ الصَّابِ وَالْعَلْقَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 26597","","","كتاب الأدب"
"26598","(۲۶۵۹۸) حَدَّثَنَا وَکِیعٌ ، عَن ثَابِتٍ بْنِ أَبِی صَفِیَّۃَ ، عَن شَیْخٍ یُکَنَّی أَبَا عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الزَّنِیمُ : اللَّئِیمُ الْمُلْزِقُ ، ثُمَّ أَنْشَدَ ہَذَا الْبَیْتَ :nزَنِیمٌ تَدَاعَاہُ الرِّجَالُ زِیَادَۃً کَمَا زِیدَ فِی عَرْضِ الأَدِیمِ الأَکَارِعُ","Da'if","Musannaf Ibn Abi Shaybah 26598","","","كتاب الأدب"
"26599","(۲۶۵۹۹) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ : أَخْبَرَنَا مَسْعُودُ بْنُ سَعْدٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ ابْنِ عِبَادٍ ، عَنْ أَبِیہِ ، أَنَّ رَجُلاً مِنْ بَنِی لَیْثٍ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، أُنْشِدُک ؟ قَالَ : لاَ ، فَأَنْشَدَہُ فِی الرَّابِعَۃِ مَدْحَۃً لَہُ فَقَالَ : إِنْ کَانَ أَحَدٌ مِنَ الشُّعَرَائِ یُحْسِنُ ، فَقَدْ أَحْسَنْت۔","Da'if","Musannaf Ibn Abi Shaybah 26599","","","كتاب الأدب"
"26600","(۲۶۶۰۰) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن قَتَادَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا کُنْت أَدْرِی مَا قَوْلُہُ : {رَبَّنَا افْتَحْ بَیْنَنَا وَبَیْنَ قَوْمِنَا بِالْحَقِّ} حَتَّی سَمِعْت بِنْتَ ذِی یَزَنٍ تَقُولُ : تَعَالَی أُفَاتِحْک۔","Sahih","Musannaf Ibn Abi Shaybah 26600","","","كتاب الأدب"
"26601","(۲۶۶۰۱) حَدَّثَنَا أَحْمَدُ بْنُ بِشْرٍ، عَن مُجَالِدٍ، عَنْ عَامِرٍ، أَنَّ ابْنَ الزُّبَیْرِ اسْتَنْشَدَ أَبْیَاتَ خَالِدٍ وَہُوَ یَطُوفُ بِالْبَیْتِ۔","Da'if","Musannaf Ibn Abi Shaybah 26601","","","كتاب الأدب"
"26602","(۲۶۶۰۲) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَن ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ ابْنُ الزُّبَیْرِ یَحْمِلُ عَلَیْہِمْ حَتَّی یُخْرِجَہُمْ مِنَ الأَبْوَابِ وَیَقُولُ : لَوْ کَانَ قَرْنِی وَاحِدًا کَفَیْتہ ؛nویقول:nولَسْنَا عَلَی الأَعْقَابِ تَدْمَی کُلُومُنَا وَلَکِنْ عَلَی أَقْدَامِنَا تَقْطُرُ الدِّما","Sahih","Musannaf Ibn Abi Shaybah 26602","","","كتاب الأدب"
"26603","(۲۶۶۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ ، أَنَّ أَہْلَ الشَّامِ کَانُوا یُقَاتِلُونَ ابْنَ الزُّبَیْرِ وَیَصِیحُونَ بِہِ : یَا ابْنَ ذَاتِ النِّطَاقَیْنِ ، فَقَالَ : ابْنُ الزُّبَیْرِ :nوتِلْکَ شَکَاۃٌ ظَاہِرٌ عَنک عَارُہَاn فَقَالَتْ أَسْمَائُ : عَیَّرُوک بِہِ ؟ قَالَ : نَعَمْ ، قَالَتْ : فَہُوَ وَاللَّہِ حَقٌ۔","Hasan","Musannaf Ibn Abi Shaybah 26603","","","كتاب الأدب"
"26604","(۲۶۶۰۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن رَجُلٍ ، أَنَّ ابْنَ الزُّبَیْرِ کَانَ یُنْشِدُ الشِّعْرَ وَہُوَ یَطُوفُ بِالْبَیْتِ۔","Da'if","Musannaf Ibn Abi Shaybah 26604","","","كتاب الأدب"
"26605","(۲۶۶۰۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن دَاوُد ، أَنَّ سَعِیدَ بْنَ الْمُسَیَّبِ ، قَالَ : لاَ تَطْلُعُ الشَّمْسُ حَتَّی یَصْحَبَہَا ثَلاَثُ مِئَۃِ مَلَکٍ وَسَبْعُونَ مَلَکًا ، أَمَا سَمِعْت أُمَیَّۃَ بْنَ أَبِی الصَّلْتِ یَقُولُ :nلَیْسَتْ بِطَالِعَۃٍ لَنَا فِی رِسْلِہَا إلاَ مُعَذَّبَۃً وَإِلاَّ تُجْلَدُ","","Musannaf Ibn Abi Shaybah 26605","","","كتاب الأدب"
"26606","(۲۶۶۰۶) حَدَّثَنَا حَفْصٌ، عَن مُجَالِدٍ، عَنِ الشَّعْبِیِّ، قَالَ: کَانَ یَکْرَہُ أَنْ یَکْتُبَ أَمَامَ الشِّعْرِ بِسْمِ اللہِ الرَّحْمَن الرَّحِیمِ۔","","Musannaf Ibn Abi Shaybah 26606","","","كتاب الأدب"
"26607","(۲۶۶۰۷) حَدَّثَنَا حَفْصٌ ، وَأَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لأَنْ یَمْتَلِئَ جَوْفُ الرَّجُلِ قَیْحًا حَتَّی یَرِیہِ ، خَیْرٌ لَہُ مِنْ أَنْ یَمْتَلِئَ شِعْرًا ، إلاَّ أَنْ حَفْصًا لَمْ یَقُلْ : جوف۔","Sahih","Musannaf Ibn Abi Shaybah 26607","","","كتاب الأدب"
"26608","(۲۶۶۰۸) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَن سَعِیدِ بْنِ عَبْدِ اللہِ ، عَن یُحَنَّسَ مَوْلَی مُصْعَبِ بْنِ الزُّبَیْرِ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : بَیْنَمَا نَحْنُ عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بالعرج إذْ عَرَضَ شَاعِرٌ یُنْشِدُ فَقَالَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: خُذُوا الشَّیْطَانَ أَوِ أَمْسِکُوا الشَّیْطَانَ لأَنْ یَمْتَلِئَ جَوْفُ الرَّجُلِ قَیْحًا خَیْرٌ لَہُ مِنْ أَنْ یَمْتَلِئَ شِعْرًا۔ (بخاری ۳۵۸۸۔ مسلم ۱۷۶۹)","Sahih","Musannaf Ibn Abi Shaybah 26608","","","كتاب الأدب"
"26609","(۲۶۶۰۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَن حَنْظَلَۃَ ، عَن سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لأَنْ یَمْتَلِئَ الرَّجُلُ قَیْحًا خَیْرٌ لَہُ مِنْ أَنْ یَمْتَلِئَ شِعْرًا۔ (بخاری ۶۱۵۴۔ احمد ۲/۹۶)","Sahih","Musannaf Ibn Abi Shaybah 26609","","","كتاب الأدب"
"26610","(۲۶۶۱۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَان ، عَن سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ أَبِی الزَّعْرَائِ ، قَالَ : قَالَ عَبْدُ اللہِ : لأَنْ یَمْتَلِئَ جَوْفُ الرَّجُلِ قَیْحًا خَیْرٌ مِنْ أَنْ یَمْتَلِئَ شِعْرًا۔","Da'if","Musannaf Ibn Abi Shaybah 26610","","","كتاب الأدب"
"26611","(۲۶۶۱۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، عَن عُثْمَانَ ، قَالَ : لأَنْ یَمْتَلِئَ جَوْفُ الرَّجُلِ قَیْحًا خَیْرٌ لَہُ مِنْ أَنْ یَمْتَلِئَ شِعْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 26611","","","كتاب الأدب"
"26612","(۲۶۶۱۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن ہِشَامِ بْنِ عَائِذٍ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لأَنْ یَمْتَلِئَ جَوْفُ الرَّجُلِ قَیْحًا خَیْرٌ مِنْ أَنْ یَمْتَلِئَ شِعْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 26612","","","كتاب الأدب"
"26613","(۲۶۶۱۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ عَمْرِو بْنِ حُرَیْثٍ ، قَالَ : قَالَ عُمَر : لأَنْ یَمْتَلِئَ جَوْفُ الرَّجُلِ قَیْحًا خَیْرٌ لَہُ مِنْ أَنْ یَمْتَلِئَ شِعْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 26613","","","كتاب الأدب"
"26614","(۲۶۶۱۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَن مَسْرُوقٍ ، أَنَّہُ تَمَثَّلَ مَرَّۃً بِبَیْتِ شِعْرٍ فَسَکَتَ عَن آخِرِہِ وَقَالَ : إنِّی لأَکْرَہُ أَنْ یُکْتَبَ فِی صَحِیفَتِی بَیْتُ شِعْرٍ۔","","Musannaf Ibn Abi Shaybah 26614","","","كتاب الأدب"
"26615","(۲۶۶۱۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا الأَسْوَدُ بْنُ شَیْبَانَ ، قَالَ : حَدَّثَنَا أَبُو نَوْفَلِ بْنُ أَبِی عَقْرَبٍ ، قَالَ : سَأَلْتُ عَائِشَۃَ : ہَلْ کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُتسَامَعُ عَندَہُ الشِّعْرُ ، قَالَتْ : کَانَ أَبْغَضَ الْحَدِیثِ إلَیْہِ۔ (ابوداؤد ۱۴۷۷۔ احمد ۱۳۴)","Sahih","Musannaf Ibn Abi Shaybah 26615","","","كتاب الأدب"
"26616","(۲۶۶۱۶) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ، قَالَ: کَانُوا یَکْرَہُونَ مِنَ الشِّعْرِ مَا ضَاہَی الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 26616","","","كتاب الأدب"
"26617","(۲۶۶۱۷) حَدَّثَنَا الأَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَن قَتَادَۃَ ، عَن یُونُسَ بْنِ جُبَیْرٍ ، عَن مُحَمَّدِ بْنِ سَعْدٍ ، عَن سَعْدٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لأَنْ یَمْتَلِئَ جَوْفُ أَحَدِکُمْ قَیْحًا یَرِیہِ ، خَیْرٌ لَہُ مِنْ أَنْ یَمْتَلِئَ شِعْرًا۔ (مسلم ۱۷۶۹۔ احمد ۱/۱۷۵)","Sahih","Musannaf Ibn Abi Shaybah 26617","","","كتاب الأدب"
"26618","(۲۶۶۱۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، قَالَ : سَمِعْتُ حَبِیبَ بْنَ شَہِیدٍ یَذْکُرُ ، عَن مُعَاوِیَۃَ بْنِ قُرَّۃَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَالَ : مَا یَسُرُّنِی أَنَّ لِی بِمَا أَعْلَمُ مِنْ مَعَارِیضِ الْقَوْلِ مِثْلَ أَہْلِی وَمَالِی ، أَوَلاَ یَحسَبُون أَنِّی أَوَدُّ أَنَّ لِی مِثل أَہلِی وَمالِی وَددتُ أَنَّ لِی مِثل أَہلِی وَمالِی ، ثُمَّ مِثْلَ أَہْلِی وَمَالِی ۔","","Musannaf Ibn Abi Shaybah 26618","","","كتاب الأدب"
"26619","(۲۶۶۱۹) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : قَالَ عُمَرُ : إنَّ فِی الْمَعَارِیضِ مَا یَکُفُّ ، أَوْ یَعِفُّ الرَّجُلَ عَنِ الْکَذِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 26619","","","كتاب الأدب"
"26620","(۲۶۶۲۰) حَدَّثَنَا عُقْبَۃُ بْنُ خَالِدٍ ، عَن شُعْبَۃَ ، عَن قَتَادَۃَ ، عَن مُطَرِّفِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، عَن عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : إنَّ فِی الْمَعَارِیضِ لَمَنْدُوحَۃً عَنِ الْکَذِبِ۔ (ابن عدی ۴۹۔ بیہقی ۱۹۹)","Sahih","Musannaf Ibn Abi Shaybah 26620","","","كتاب الأدب"
"26621","(۲۶۶۲۱) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، قَالَ : بَلَغَنِی عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : مَا أُحِبُّ لِی بِالْمَعَارِیضِ کَذَا وَکَذَا۔","Da'if","Musannaf Ibn Abi Shaybah 26621","","","كتاب الأدب"
"26622","(۲۶۶۲۲) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ لَہُمْ کَلاَمٌ یَتَکَلَّمُونَ بِہِ یَدْرَؤُونَ بِہِ عنْ أَنْفُسِہِمْ مَخَافَۃَ الْکَذِبِ۔","","Musannaf Ibn Abi Shaybah 26622","","","كتاب الأدب"
"26623","(۲۶۶۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن حَبِیبِ بْنِ شَہِیدٍ ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، قَالَ : قَالَ حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ : مَا أُحِبُّ أَنَّ لِی بِنَصِیبِی مِنَ الْمَعَارِیضِ مِثْلَ أَہْلِی وَمَالِی ، وَلَعَلَّکُمْ تَرَوْنَ أَنِّی لاَ أُحِبُّ أَنَّ لِی مِثْلَ أَہْلِی وَمَالِی، وَوَدِدْت أَنَّ لِی مِثْلَ أَہْلِی وَمَالِی۔","","Musannaf Ibn Abi Shaybah 26623","","","كتاب الأدب"
"26624","(۲۶۶۲۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : لاَ تَقُلْ لِصَاحِبِکَ یَا حِمَارُ ، یَا کَلْبُ ، یَا خِنْزِیرُ ، فَیَقُولَ لَکَ یَوْمَ الْقِیَامَۃِ : أَتَرَانِی خُلِقْت کَلْبًا ، أَوْ حِمَارًا ، أَوْ خِنْزِیرًا ؟۔","","Musannaf Ibn Abi Shaybah 26624","","","كتاب الأدب"
"26625","(۲۶۶۲۵) حَدَّثَنَا جَرِیرٌ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، قَالَ : اسْتَسْقَی مُوسَی لِقَوْمِہِ فَقَالَ : اشْرَبُوا یَا حَمِیرُ ، قَالَ : فَقَالَ اللَّہُ لَہُ : لاَ تُسَمِّ عِبَادِی حَمِیرًا۔","","Musannaf Ibn Abi Shaybah 26625","","","كتاب الأدب"
"26626","(۲۶۶۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَقُولُونَ : إذَا قَالَ الرَّجُلُ لِلرَّجُلِ : یَا حِمَارُ یَا کَلْبُ یَا خِنْزِیرُ ، قَالَ لَہُ یَوْمَ الْقِیَامَۃِ : أَتَرَانِی خَلَقْتُہ کَلْبًا ، أَوْ حِمَارًا ، أَوْ خِنْزِیرًا ؟۔","","Musannaf Ibn Abi Shaybah 26626","","","كتاب الأدب"
"26627","(۲۶۶۲۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَن دَاوُد بْنِ أَبِی ہِنْدٍ، عَن بَکْرِ بْنِ عَبْدٍالْمُزَنِیّ، عَنْ عَلْقَمَۃَ بْنِ عَبْدِاللہِ، أَنَّ ابْنَ عُمَرَ قَالَ لِرَجُلٍ کَلَّمَ صَاحِبَہُ یَوْمَ الْجُمُعَۃِ وَالإِمَامُ یَخْطُبُ : أَمَّا أَنْتَ فَحِمَارٌ ، وَأَمَّا صَاحِبُک فَلاَ جُمُعَۃَ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26627","","","كتاب الأدب"
"26628","(۲۶۶۲۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَن سَعْدٍ ، وَأَبِی بَکْرَۃَ ، کِلاَہُمَا یَقُولُ : سَمِعَتْہ أُذُنَایَ ، وَوَعَاہُ قَلْبِی مُحَمَّدًا صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنِ ادَّعَی إلَی غَیْرِ أَبِیہِ ، وَہُوَ یَعْلَمُ أَنَّہُ غَیْرُ أَبِیہِ ، فَالْجَنَّۃُ عَلَیْہِ حَرَامٌ۔ (مسلم ۱۱۵۔ ابن ماجہ ۲۶۱۰)","Sahih","Musannaf Ibn Abi Shaybah 26628","","","كتاب الأدب"
"26629","(۲۶۶۲۹) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَن مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، رَفَعَہُ ، قَالَ : مَنِ ادَّعَی إلَی غَیْرِ أَبِیہِ فَلَنْ یَرِیحَ رِیحَ الْجَنَّۃِ ، فَلَمَّا رَأَی ذَلِکَ نُعَیْمُ بْنُ أَبِی أُمَیَّۃَ ، وَکَانَ مُعَاوِیَۃُ أَرَادَ أَنْ یَدَّعِیَہُ ، قَالَ لِمُعَاوِیَۃَ : إنَّمَا أَنَا سَہْمٌ مِنْ کِنَانَتِکَ ، فَاقْذِفْنِی حَیْثُ شِئْت۔ (ابن ماجہ ۲۶۱۱۔ احمد ۱۷۱)","Sahih","Musannaf Ibn Abi Shaybah 26629","","","كتاب الأدب"
"26630","(۲۶۶۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَوَلَّی غَیْرَ مَوَالِیہِ فَعَلَیْہِ لَعَنَۃُ اللہِ وَالْمَلاَئِکَۃِ وَالنَّاسِ أَجْمَعِینَ۔n(مسلم ۱۱۴۶۔ ابوداؤد ۵۰۷۳)","Hasan","Musannaf Ibn Abi Shaybah 26630","","","كتاب الأدب"
"26631","(۲۶۶۳۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَن قَتَادَۃَ ، عَن شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدٗ الرَّحْمَنِ بْنِ غَنْمٍ ، عَنْ عَمْرِو بْنِ خَارِجَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خَطَبَہُمْ وَہُوَ عَلَی رَاحِلَتِہِ ، وَإِنَّ رَاحِلَتَہُ لَتَقْصَعُ بِجَرَّتِہَا ، وَإِنَّ لُعَابَہَا یَسِیلُ بَیْنَ کَتِفَیَّ فَقَالَ : مَنِ ادَّعَی إلَی غَیْرِ أَبِیہِ ، أَوْ تَوَلَّی غَیْرَ مَوَالِیہِ فَعَلَیْہِ لَعَنَۃُ اللہِ ، لاَ یُقْبَلُ مِنْہُ صَرْفٌ ، وَلاَ عَدْلٌ ، أَوْ قَالَ : عَدْلٌ ، وَلاَ صَرْفٌ۔","","Musannaf Ibn Abi Shaybah 26631","","","كتاب الأدب"
"26632","(۲۶۶۳۲) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الْحَارِثِ ، عَنْ أَبِی سَلَمَۃَ ، عَن سَعِیدِ بْنِ زَیْدٍ ، قَالَ : أَشْہَدُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَمِعْتہ یَقُولُ : مَنْ تَوَلَّی مَوْلًی بِغَیْرِ إذْنِہِ فَعَلَیْہِ لَعَنَۃُ اللہِ۔","Hasan","Musannaf Ibn Abi Shaybah 26632","","","كتاب الأدب"
"26633","(۲۶۶۳۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ أَبِی مَعْمَرٍ ، قَالَ : قَالَ أَبُو بَکْرٍ : کَفَرَ بِاللَّہِ مَنِ ادَّعَی نَسَبًا لاَ یُعْلَمُ ، وَتَبَرَّأَ مِنْ نَسَبٍ ، وَإِنْ دَقَّ۔ (دارمی ۲۸۶۳۔ احمد ۲۱۵)","Sahih","Musannaf Ibn Abi Shaybah 26633","","","كتاب الأدب"
"26634","(۲۶۶۳۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَن شُرَحْبِیلَ بْنِ مُسْلِمٍ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ الْبَاہِلِیَّ یَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنِ ادَّعَی إلَی غَیْرِ أَبِیہِ وَانْتَمَی إلَی غَیْرِ مَوَالِیہِ ، فَعَلَیْہِ لَعَنَۃُ اللہِ التَّابِعَۃ إلَی یَوْمِ الْقِیَامَۃِ۔ (ترمذی ۲۱۲۰۔ ابوداؤد ۲۸۶۲)","Hasan","Musannaf Ibn Abi Shaybah 26634","","","كتاب الأدب"
"26635","(۲۶۶۳۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنِ ادَّعَی إلَی غَیْرِ أَبِیہِ ، أَوْ تَوَلَّی غَیْرَ مَوَالِیہِ ، فَعَلَیْہِ لَعَنَۃُ اللہِ وَالْمَلاَئِکَۃِ وَالنَّاسِ أَجْمَعِینَ۔ (احمد ۱/۳۲۸۔ ابویعلی ۲۵۴۰)","Hasan","Musannaf Ibn Abi Shaybah 26635","","","كتاب الأدب"
"26636","(۲۶۶۳۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَاصِمٍ ، عَن زِرٍّ ، قَالَ : أَتَیْتُ صَفْوَانَ بْنَ عَسَّالٍ الْمُرَادِیَّ فَقَالَ لِی : مَا جَائَ بِکَ ؟ فَقُلْت : ابْتِغَائَ الْعِلْمِ ، قَالَ : فَإِنَّ الْمَلاَئِکَۃَ تَضَعُ أَجْنِحَتَہَا لِطَالِبِ الْعِلْمِ۔","Da'if","Musannaf Ibn Abi Shaybah 26636","","","كتاب الأدب"
"26637","(۲۶۶۳۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شِمْرِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مُعَلِّمُ الْخَیْرِ یَسْتَغْفِرُ لَہُ کُلُّ شَیْئٍ حَتَّی الْحُوتُ فِی الْبَحْرِ۔ (دارمی ۳۴۳۔ عبدالبر ۱۸۰)","Sahih","Musannaf Ibn Abi Shaybah 26637","","","كتاب الأدب"
"26638","(۲۶۶۳۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن ہَارُونَ بْنِ عَنتَرَۃَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا یسْلُک رَجُلٌ طَرِیقًا یَلْتَمِسُ فِیہَا الْعِلْمَ إلاَّ سَہَّلَ اللَّہُ لَہُ طَرِیقًا إلَی الْجَنَّۃِ۔ (ابوداؤد ۳۶۳۸۔ دارمی ۳۴۵)","Sahih","Musannaf Ibn Abi Shaybah 26638","","","كتاب الأدب"
"26639","(۲۶۶۳۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ قَیْسٍ الْمُلاَئِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَضْلُ الْعِلْمِ خَیْرٌ مِنْ فَضْلِ الْعِبَادَۃِ ، وَمِلاَکُ دِینِکُمُ الْوَرَعُ۔ (حاکم ۹۲۔ بزار ۲۹۶۹)","","Musannaf Ibn Abi Shaybah 26639","","","كتاب الأدب"
"26640","(۲۶۶۴۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنِ الأَحْنَفِ ، قَالَ : قَالَ عُمَرُ : تَفَقَّہُوا قَبْلَ أَنْ تُسَوَّدُوا۔ (دارمی ۲۵۰)","Sahih","Musannaf Ibn Abi Shaybah 26640","","","كتاب الأدب"
"26641","(۲۶۶۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَلَکَ طَرِیقًا یَلْتَمِسُ فِیہِ عِلْمًا ، سَہَّلَ اللَّہُ لَہُ طَرِیقًا إلَی الْجَنَّۃِ۔n(مسلم ۲۰۷۴۔ ابوداؤد ۳۶۳۸)","Sahih","Musannaf Ibn Abi Shaybah 26641","","","كتاب الأدب"
"26642","(۲۶۶۴۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن لَیْثٍ ، عَن طَاوُوس ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْہُومَانِ لاَ یَشْبَعَانِ : طَالِبُ عِلْمٍ وَطَالِبُ دُنْیَا۔ (دارمی ۳۳۴)","Da'if","Musannaf Ibn Abi Shaybah 26642","","","كتاب الأدب"
"26643","(۲۶۶۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیق ، عَنْ عَبْدِ اللہِ ، قَالَ : تَعَلَّمُوا ، فَإِنَّ أَحَدَکُمْ لاَ یَدْرِی مَتَی یُخْتل إلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 26643","","","كتاب الأدب"
"26644","(۲۶۶۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن تَمِیمِ بْنِ سَلَمَۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : اغْدُ عَالِمًا ، أَوْ مُتَعَلِّمًا ، وَلاَ تَغْدُ بَیْنَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 26644","","","كتاب الأدب"
"26645","(۲۶۶۴۵) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن سَالِمِ بْنِ أَبِی الْجَعْدِ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : تَعَلَّمُوا قَبْلَ أَنْ یُرْفَعَ الْعِلْمُ ، فَإِنَّ الْعَالِمَ وَالْمُتَعَلِّمَ فِی الأَجْرِ سَوَائٌ۔","Sahih","Musannaf Ibn Abi Shaybah 26645","","","كتاب الأدب"
"26646","(۲۶۶۴۶) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنِ الأَعْمَشِ، عَن سَالِمٍ، قَالَ: قَالَ أَبُو الدَّرْدَائِ: مُعَلِّمُ الْعِلْمِ وَمُتَعَلِّمُہُ فِی الأَجْرِ سَوَائٌ۔","Sahih","Musannaf Ibn Abi Shaybah 26646","","","كتاب الأدب"
"26647","(۲۶۶۴۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّ الرَّجُلَ لاَ یُولَدُ عَالِمًا ، وَإِنَّمَا الْعِلْمُ بِالتَّعَلُّمِ۔","Sahih","Musannaf Ibn Abi Shaybah 26647","","","كتاب الأدب"
"26648","(۲۶۶۴۸) حَدَّثَنَا دَاوُد ، عَن سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ مِثْلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26648","","","كتاب الأدب"
"26649","(۲۶۶۴۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا التیمی ، عَن سَیَّارٍ ، عَنْ عَائِذِ اللہِ ، قَالَ : الَّذِی یَتَتَبَّعُ الأَحَادِیثَ لِیُحَدِّثَ بِہَا لاَ یَجِدُ رِیحَ الْجَنَّۃِ۔","","Musannaf Ibn Abi Shaybah 26649","","","كتاب الأدب"
"26650","(۲۶۶۵۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن سُفْیَانَ ، عَن بُرْدٍ ، عَن مَکْحُولٍ ، قَالَ: مَنْ طَلَبَ الْحَدِیثَ لیجاری بِہِ السُّفَہَائَ، أَوْ لِیُمَارِیَ بِہِ الْعُلَمَائَ ، أَوْ لِیَصْرِفَ بِہِ وُجُوہَ النَّاسِ إلَیْہِ ، فَہُوَ فِی النَّارِ۔ (دارمی ۳۷۴)","","Musannaf Ibn Abi Shaybah 26650","","","كتاب الأدب"
"26651","(۲۶۶۵۱) حَدَّثَنَا سُرَیْجُ بْنُ النُّعْمَانِ ، قَالَ : حدَّثَنَا فُلَیْحٌ ، عَنْ أَبِی طِوَالَۃَ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مَعْمَرٍ ، عَن سَعِیدِ بْنِ یَسَارٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَعَلَّمَ عِلْمًا مِمَّا یُبْتَغَی بِہِ وَجْہُ اللہِ لاَ یَتَعَلَّمُہُ إلاَّ لِیُصِیبَ بِہِ عَرَضًا مِنَ الدُّنْیَا لَمْ یَجِدْ عَرْفَ الْجَنَّۃِ یَوْمَ الْقِیَامَۃِ - یَعْنِی رِیحَہَا۔ (ابوداؤد ۳۶۵۶۔ ابن ماجہ ۲۵۲)","Hasan","Musannaf Ibn Abi Shaybah 26651","","","كتاب الأدب"
"26652","(۲۶۶۵۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : مَا عَلِمْت أَحَدًا مِنَ النَّاسِ کَانَ أَطْلَبَ لِلْعِلْمِ فِی أُفُقٍ مِنَ الآفَاقِ مِنْ مَسْرُوقٍ۔","","Musannaf Ibn Abi Shaybah 26652","","","كتاب الأدب"
"26653","(۲۶۶۵۳) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن رَجُلٍ لَمْ یُسَمِّہِ، أَنَّ مَسْرُوقًا رَحَلَ فِی حَرْفٍ، وَأَنَّ أَبَا سَعِیدٍ رَحَلَ فِی حَرْفٍ۔","","Musannaf Ibn Abi Shaybah 26653","","","كتاب الأدب"
"26654","(۲۶۶۵۴) حَدَّثَنَا عَلِیُّ بْنُ صَالِحٍ ، عَنْ أَبِیہِ ، قَالَ : حدَّثَنَا الشَّعْبِیُّ بِحَدِیثٍ ، ثُمَّ قَالَ لِی : أَعْطَیْتُکَہُ بِغَیْرِ شَیْئٍ ، وَإِنْ کَانَ الرَّاکِبُ لَیَرْکَبُ إلَی الْمَدِینَۃِ فِیمَا دُونَہُ۔ (بخاری ۵۰۸۳۔ مسلم ۲۴۱)","","Musannaf Ibn Abi Shaybah 26654","","","كتاب الأدب"
"26655","(۲۶۶۵۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن رَجُلٍ ، قَالَ : قَالَ لِی الشَّعْبِیُّ أحَادِیثٌ أَعْطَیْنَاکہَا بِغَیْرِ شَیْئٍ ، وَإِنْ کَانَ الرَّاکِبُ لَیَرْکَبُ فِیمَا دُونَہَا إلَی الْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 26655","","","كتاب الأدب"
"26656","(۲۶۶۵۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَن شُعْبَۃَ ، عَن عُمَارَۃَ ، عَنْ أَبِی مِجْلَزٍ ، عَن قَیْسِ بْنِ عُبَادٍ ، قَالَ : خَرَجْت إلَی الْمَدِینَۃِ أَطْلُبُ الْعِلْمَ وَالشَّرَفَ۔","","Musannaf Ibn Abi Shaybah 26656","","","كتاب الأدب"
"26657","(۲۶۶۵۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ جَعْفَرِ بْنِ إیَاسٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : تَحَدَّثُوا ، فَإِنَّ الْحَدِیثَ یَہِیجُ الْحَدِیثَ۔","Sahih","Musannaf Ibn Abi Shaybah 26657","","","كتاب الأدب"
"26658","(۲۶۶۵۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا کَہْمَسُ بْنُ الْحَسَنِ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ ، قَالَ : قَالَ عَلِیٌّ : تَزَاوَرُوا وَتَذَاکَرُوا الْحَدِیثَ فَإِنَّکُمْ إِنْ لاَ تَفْعَلُوا یَدْرُسْ۔","Sahih","Musannaf Ibn Abi Shaybah 26658","","","كتاب الأدب"
"26659","(۲۶۶۵۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فِطْرٌ ، عَن شَیْخٍ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ یَقُولُ : تَذَاکَرُوا الْحَدِیثَ ، فَإِنَّ إحْیَائَہُ ذِکْرُہُ۔ (دارمی ۶۱۹)","","Musannaf Ibn Abi Shaybah 26659","","","كتاب الأدب"
"26660","(۲۶۶۶۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، أَنَّہُ کَانَ یَأْتِی صِبْیَانَ الْکُتَّابِ فَیَعْرِضُ عَلَیْہِمْ حَدِیثَہُ کَیْ لاَ یَنْسَی۔","","Musannaf Ibn Abi Shaybah 26660","","","كتاب الأدب"
"26661","(۲۶۶۶۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِیسَی بْنُ الْمُسَیَّبِ ، قَالَ : سَمِعْتُ إبْرَاہِیمَ یَقُولُ : إذَا سَمِعْت حَدِیثًا فَحَدِّثْ بہ حِینَ تَسْمَعُہُ ، وَلَوْ أَنْ تُحَدِّثَ بِہ مَنْ لاَ یَشْتَہِیہِ ، فَإِنَّہُ یَکُونُ کَالْکِتَابِ فِی صَدْرِک۔","","Musannaf Ibn Abi Shaybah 26661","","","كتاب الأدب"
"26662","(۲۶۶۶۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : إحْیَائُ الْحَدِیثِ مُذَاکَرَتُہُ ، فَقَالَ لَہُ عَبْدُ اللہِ بْنُ شَدَّادٍ : کَمْ مِنْ حَدِیثٍ قَدْ أَحْیَیْتہ فِی صَدْرِی۔","","Musannaf Ibn Abi Shaybah 26662","","","كتاب الأدب"
"26663","(۲۶۶۶۳) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا الأَعْمَشُ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : آفَۃُ الْعِلْمِ النِّسْیَانُ، وَإِضَاعَتُہُ أَنْ تُحَدِّثَ بِہِ غَیْرَ أَہْلِہِ۔ (دارمی ۶۲۴)","","Musannaf Ibn Abi Shaybah 26663","","","كتاب الأدب"
"26664","(۲۶۶۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْقَاسِمِ ، قَالَ : قَالَ عَبْدُ اللہِ : آفَۃُ الْعِلْمِ النِّسْیَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 26664","","","كتاب الأدب"
"26665","(۲۶۶۶۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، وَأَبُو أُسَامَۃَ ، عَن عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَن نَافِعٍ ، عَن سَعِیدِ بْنِ أَبِی ہِنْدٍ، عَنْ أَبِی مُوسَی، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنْ لَعِبَ بِالنَّرْدِ، فَقَدْ عَصَی اللَّہَ وَرَسُولَہُ۔n(مالک ۹۵۸۔ احمد ۴/۳۹۴)","","Musannaf Ibn Abi Shaybah 26665","","","كتاب الأدب"
"26666","(۲۶۶۶۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، عَن سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَن سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ لَعِبَ بِالنَّرْدَشِیرِ فَکَأَنَّمَا غَمَسَ یَدَہُ فِی لَحْمِ خِنْزِیرٍ وَدَمِہِ۔n(بخاری ۱۲۷۱۔ مسلم ۱۷۷۰)","Sahih","Musannaf Ibn Abi Shaybah 26666","","","كتاب الأدب"
"26667","(۲۶۶۶۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَ مِثْلَہُ۔ (احمد ۵/۳۵۲)","","Musannaf Ibn Abi Shaybah 26667","","","كتاب الأدب"
"26668","(۲۶۶۶۰۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَن قَتَادَۃَ ، قَالَ : بَلَغَنَا أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، سُئِلَ عَنِ اللَّعِبِ بِالْکَعْبَیْنِ فَقَالَ : إِنَّہَا مَیْسِرُ الأَعَاجِمِ ، قَالَ : وَکَانَ قَتَادَۃُ یَکْرَہُ اللَّعِبَ بِکُلِّ شَیْئٍ حَتَّی یَکْرَہَ اللَّعِبَ بِالْعَصَا۔ (احمد ۱/۴۴۶۔ بیہقی ۲۱۵)","","Musannaf Ibn Abi Shaybah 26668","","","كتاب الأدب"
"26669","(۲۶۶۶۹) حَدَّثَنَا مُعْتَمِرٌ وَجَرِیرٌ ، عَنِ الرُّکَیْنِ ، عَنِ الْقَاسِمِ بْنِ حَسَّانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الضَّرْبِ بِالْکِعَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 26669","","","كتاب الأدب"
"26670","(۲۶۶۷۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَن قَتَادَۃَ ، عَنْ أَبِی أَیُّوبَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : مَثَلُ الَّذِی یَلْعَبُ بِالْکَعْبَیْنِ ، وَلاَ یُقَامِرُ کَمَثَلِ الْمُدَّہِنِ بِشَحْمِہِ ، وَلاَ یَأْکُلُ لَحْمَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26670","","","كتاب الأدب"
"26671","(۲۶۶۷۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَن مُجَاہِدٍ ، عَنِ ابْنِ عُمر قَالَ : لأَنْ أَضَعَ یَدِی فِی لَحْمِ خِنْزِیرٍ أَحَبُّ إلَیَّ مِنْ أَنْ أَلْعَبَ بِالنَّرْدِ۔","Sahih","Musannaf Ibn Abi Shaybah 26671","","","كتاب الأدب"
"26672","(۲۶۶۷۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن بُرْدِ بْنِ مَعْمَرِ بْنِ یَزِیدَ ، قَالَ : سَأَلْتُ عَائِشَۃَ رضی اللہ عنہا عَنِ النَّرْدَشِیرِ ، قَالَتْ : قَبَّحَ اللَّہُ النَّرْدَشِیرَ وَقَبَّحَ مَنْ لَعِبَ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 26672","","","كتاب الأدب"
"26673","(۲۶۶۷۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ بْنِ سُمَیْعٍ ، قَالَ : حدَّثَنَا أَبُو الأَشْعَثِ النَّخَعِیُّ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : لأَنْ یَتَلَطَّخَ الرَّجُلُ بِدَمِ خِنْزِیرٍ حَتَّی یَسْتَوْسِعَ مِنہ خَیْرٌ لَہُ مِنْ أَنْ یَلْعَبَ بِالْکِعَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 26673","","","كتاب الأدب"
"26674","(۲۶۶۷۴) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عَلِیٌّ : النَّرْدُ ، أَوِ الشِّطْرَنْجُ مِنَ الْمَیْسِرِ۔","","Musannaf Ibn Abi Shaybah 26674","","","كتاب الأدب"
"26675","(۲۶۶۷۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ إذَا وَجَدَ نَرْدًا فِی بَیْتٍ کَسَّرَہَا وَضَرَبَ مَنْ لَعِبَ بِہَا۔","","Musannaf Ibn Abi Shaybah 26675","","","كتاب الأدب"
"26676","(۲۶۶۷۶) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا مِسْعَرٌ وَسُفْیَانُ ، عَنْ عَبْدِالْمَلِکِ بْنِ عُمَیْرٍ، عَنْ أَبِی الأَحْوَصِ، قَالَ سُفْیَانُ: عَنْ عَبْدِ اللہِ ، وَقَصَّرَ بِہِ مِسْعَرٌ : إیَّاکُمْ وَہَذِہِ الْکِعَابَ الْمَوْسُومَۃَ الَّتِی تُزْجَرُ زَجْرًا ، فَإِنَّہَا مِنَ الْمَیْسِرِ۔","Hasan","Musannaf Ibn Abi Shaybah 26676","","","كتاب الأدب"
"26677","(۲۶۶۷۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أُسَامَۃَ بْنُ زِید ، عَن سَعِیدِ بْنِ أَبِی ہِنْدٍ سَمِعَہُ مِنْہُ ، عَنْ أَبِی مُوسَی ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ لَعِبَ بِالنَّرْدِ ، فَقَدْ عَصَی اللَّہَ وَرَسُولَہُ۔","","Musannaf Ibn Abi Shaybah 26677","","","كتاب الأدب"
"26678","(۲۶۶۷۸) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سَلاَّمُ بْنُ مِسْکِینٍ، عَن قَتَادَۃَ، عَنْ أَبِی أَیُّوبَ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو، قَالَ: مَنْ لَعِبَ بِالنَّرْدِ قِمَارًا ، کَانَ کَآکِلِ لَحْمِ الْخِنْزِیرِ ، وَمَنْ لَعِبَ بِہَا غَیْرِ قِمَارٍ کَانَ کَالْمُدَّہِنِ بِوَدَکِ الْخِنْزِیرِ۔","Sahih","Musannaf Ibn Abi Shaybah 26678","","","كتاب الأدب"
"26679","(۲۶۶۷۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا معمر ، عَن بَسَّامٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ عَنِ اللَّعِبِ بِالنَّرْدِ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 26679","","","كتاب الأدب"
"26680","(۲۶۶۸۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا کَامِلٌ أَبُو الْعَلاَئِ، قَالَ: سَمِعْتُ صَلْتًا الدِّہَان مُنْذُ أَرْبَعِینَ سَنَۃً، عَنْ عَلِیٍّ، قَالَ: لأَنْ أَطْلِی بِجِوَائِ قِدْرٍ أَحَبُّ إلَیَّ مِنْ أَطْلِی بِخَلُوقٍ، وَلأَنْ أَقْلِبَ جَمْرَتَیْنِ أَحَبُّ إلَیَّ مِنْ أَنْ أَقْلِبَ کَعْبَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 26680","","","كتاب الأدب"
"26681","(۲۶۶۸۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ الْوَلِیدِ ، عَن فُضَیْلِ بْنِ مُسْلِمٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ إذَا مَرَّ بِہِمْ وَہُمْ یَلْعَبُونَ بِالنَّرْدِشِیرِ عَقَلَہُمْ إلَی نِصْفِ النَّہَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 26681","","","كتاب الأدب"
"26682","(۲۶۶۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ مَرْزُوقٍ ، عَن مَیْسَرَۃَ النَّہْدِیِّ ، قَالَ : مَرَّ عَلِیٌّ عَلَی قَوْمٍ یَلْعَبُونَ بِالشِّطْرَنْجِ ، فَقَالَ : {مَا ہَذِہِ التَّمَاثِیلُ الَّتِی أَنْتُمْ لَہَا عَاکِفُونَ}۔","","Musannaf Ibn Abi Shaybah 26682","","","كتاب الأدب"
"26683","(۲۶۶۸۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مَعْمَرٌ ، عَن بَسَّامٍ ، عَنْ أَبِی جَعْفَرٍ ، أَنَّہُ کَرِہَ اللَّعِبَ بِالشِّطْرَنْجِ۔","","Musannaf Ibn Abi Shaybah 26683","","","كتاب الأدب"
"26684","(۲۶۶۸۴) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِم ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ فِی الشِّطْرَنْجِ ، قَالَ : کَانُوا یُنْزِلُونَ النَّاظِرَ إلَیْہَا کَالنَّاظِرِ إلَی لَحْمِ الْخِنْزِیرِ ، وَالَّذِی یُقْلِبُہَا کَالَّذِی یُقْلِبُ لَحْمَ الْخِنْزِیرِ۔","","Musannaf Ibn Abi Shaybah 26684","","","كتاب الأدب"
"26685","(۲۶۶۸۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ إسْمَاعِیلَ بْنُ مُجَمِّعٍ ، عَن عُبَیْدٍ مَوْلَی سَلَمَۃَ بْنِ الأَکْوَعِ ، عن سَلَمَۃَ بْنِ الأَکْوَعِ أَنَّہُ کَانَ یَنْہَی بَنِیہِ عَنِ اللَّعِبِ بِأَرْبَعَۃَ عَشَرَ أَشَدَّ النَّہْیِ۔","Da'if","Musannaf Ibn Abi Shaybah 26685","","","كتاب الأدب"
"26686","(۲۶۶۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْرَائِیلُ ، عَنْ جَابِرٍ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ ابْنُ عُمَرَ یَنْہَی عَنِ اللَّعِبِ بِالشُّہَارْدَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 26686","","","كتاب الأدب"
"26687","(۲۶۶۸۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعُمَرِیِّ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ مَرَّ عَلَی قَوْمٍ یَلْعَبُونَ بِأَرْبَعَۃَ عَشَرَ فَکَسَّرَہَا عَلَی رَأْسِ أَحَدِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 26687","","","كتاب الأدب"
"26688","(۲۶۶۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ إسْمَاعِیلَ بْنِ مُجَمِّعٍ ، عَنْ عَبْدِ الْکَرِیمِ أَبِی أُمَیَّۃَ ، عَن أُمِّ قُثُم قَالَتْ : دَخَلَ عَلَیْنَا عَلِیٌّ وَنَحْنُ نَلْعَبُ بِأَرْبَعَۃَ عَشَرَ فَقَالَ : مَا ہَذَا ؟ فَقُلْنَا : نَحْنُ صِیَامٌ نَتَلَہَّی بِہِ ، قَالَ : أَفَلاَ أَشْتَرِی لَکُمْ بِدِرْہَمٍ جَوْزًا تَلْہُونَ بِہِ وَتَدَعُونَہَا ، قَالَ : فَاشْتَرَی لَنَا بِدِرْہَمٍ جَوْزًا۔","Da'if","Musannaf Ibn Abi Shaybah 26688","","","كتاب الأدب"
"26689","(۲۶۶۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَن بَسَّامٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ عَلِیُّ بْنُ الْحُسَیْنِ یُلاَعِبُ أَہْلَہُ بِالشُّہَارْدَۃِ۔","","Musannaf Ibn Abi Shaybah 26689","","","كتاب الأدب"
"26690","(۲۶۶۹۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنی الضَّحَّاکُ بْنُ عُثْمَانَ ، قَالَ : أَخْبَرَنَی نَافِعٌ ، أَنَّ ابْنَ عُمَرَ دَخَلَ عَلَی جَارِیَتَیْنِ لَہُ تَلْعَبَانِ بِالشُّہَارْدَۃِ فَضَرَبَہُمَا بہا حَتَّی تَکَسَّرَتْ۔","Hasan","Musannaf Ibn Abi Shaybah 26690","","","كتاب الأدب"
"26691","(۲۶۶۹۱) حَدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَن یَزِیدَ بْنِ أَبِی عُبَیْدٍ ، قَالَ : کَانَ سَلَمَۃُ بْنُ الأَکْوَعِ یَنْہَی بَنِیہِ أَنْ یَلْعَبُوا بِأَرْبَعَۃَ عَشَرَ ، وَیَقُولُ : إنَّہُمْ یَکْذِبُونَ فِیہَا وَیَفْجُرُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 26691","","","كتاب الأدب"
"26692","(۲۶۶۹۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَرِہَ اللَّعِبَ بِالشُّہَارْدَۃِ۔","","Musannaf Ibn Abi Shaybah 26692","","","كتاب الأدب"
"26693","(۲۶۶۹۳) حَدَّثَنَا حَفْصٌ ، عَن لَیْثٍ ، عَن طَاوُوس ، قَالَ : کَانَ یَکْرَہُ الْقِمَارَ وَیَقُولُ : إِنَّہُ مِنَ الْمَیْسِرِ حَتَّی لَعِبِ الصِّبْیَانِ بِالْجَوْزِ وَالْکِعَابِ۔","","Musannaf Ibn Abi Shaybah 26693","","","كتاب الأدب"
"26694","(۲۶۶۹۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ نَجِیحٍ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ مَرَّ عَلَی غِلْمَانٍ یَوْمَ الْعِیدِ بالْمِرْبَد وَہُمْ یَتَقَامَرُونَ بِالْجَوْزِ ، فَقَالَ : یَا غِلْمَانُ ، لاَ تُقَامِرُوا ، فَإِنَّ الْقِمَارَ مِنَ الْمَیْسِرِ۔","","Musannaf Ibn Abi Shaybah 26694","","","كتاب الأدب"
"26695","(۲۶۶۹۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کُلُّ شَیْئٍ فِیہِ خَطَرٌ ، فَہُوَ مِنَ الْمَیْسِرِ۔","","Musannaf Ibn Abi Shaybah 26695","","","كتاب الأدب"
"26696","(۲۶۶۹۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن لَیْثٍ ، عَنْ عَطَائٍ ، وَمُجَاہِدٍ ، وَطَاوُوس ، أَوِ اثْنَیْنِ مِنْہُمْ ، قَالاََ : کُلُّ شَیْئٍ مِنَ الْقِمَارِ ، فَہُوَ مِنَ الْمَیْسِرِ حَتَّی لَعِبِ الصِّبْیَانِ بِالْجَوْزِ۔","","Musannaf Ibn Abi Shaybah 26696","","","كتاب الأدب"
"26697","(۲۶۶۹۷) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ أَسْلَمَ الْمُنْقِرِیِّ ، قَالَ : کَانَ سَعِیدُ بْنُ جُبَیْرٍ إذَا مَرَّ عَلَی أَصْحَابِ النَّرْدِ لَمْ یُسَلِّمْ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 26697","","","كتاب الأدب"
"26698","(۲۶۶۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَن زِیَادِ بْنِ حُدَیْرٍ ، أَنَّہُ مَرَّ عَلَی قَوْمٍ یَلْعَبُونَ بِالنَّرْدِ فَسَلَّمَ وَہُوَ لاَ یَعْلَمُ ، ثُمَّ رَجَعَ فَقَالَ : رُدُّوا عَلَیَّ سَلاَمِی۔","","Musannaf Ibn Abi Shaybah 26698","","","كتاب الأدب"
"26699","(۲۶۶۹۹) حَدَّثَنَا وَکِیعٌ ، عَن أُمِّ غُرَابٍ ، عَن بُنَانَۃَ ، أَنَّ عُثْمَانَ کَانَ یَتَمَطَّرُ فِی أَوَّلِ مَطْرَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 26699","","","كتاب الأدب"
"26700","(۲۶۷۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ الْمُؤَمِّلِ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، أَنَّ ابْنَ عَبَّاسٍ کَانَ یَتَمَطَّرُ ، یُخْرِجُ ثِیَابَہُ حَتَّی یُخْرِجَ سَرْجَہُ فِی أَوَّلِ مَطْرَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 26700","","","كتاب الأدب"
"26701","(۲۶۷۰۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَن یَزِیدَ بْنِ أَبَانَ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَمَطَّرُ فِی أَوَّلِ مَطْرَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 26701","","","كتاب الأدب"
"26702","(۲۶۷۰۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن سعد بْنِ رَزِینٍ عَمَّنْ حَدَّثَہُ ، عَنْ عَلِیٍّ ، أَنَّہُ کَانَ إذَا رأی الْمَطَرَ خَلَعَ ثِیَابَہُ وَجَلَسَ ، وَیَقُولُ : حدِیثُ عَہْدٍ بِالْعَرْشِ۔","Da'if","Musannaf Ibn Abi Shaybah 26702","","","كتاب الأدب"
"26703","(۲۶۷۰۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا ثَابِتٌ ، قَالَ : حَدَّثَنَا أَنَسٌ ، قَالَ : أَصَابَنَا وَنَحْنُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَطَرٌ ، قَالَ : فَخَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَحَسَرَ ثَوْبَہُ عَنہُ حَتَّی أَصَابَہُ ، فَقُلْنَا : یَا رَسُولَ اللہِ ، لِمَ صَنَعْت ہَذَا ؟ قَالَ : لأَنَّہُ حَدِیثُ عَہْدٍ بِرَبِّہِ۔n(ابوداؤد ۵۰۵۹۔ مسلم ۶۱۵)","Sahih","Musannaf Ibn Abi Shaybah 26703","","","كتاب الأدب"
"26704","(۲۶۷۰۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ بَکْرٍ السَّہْمِیُّ ، قَالَ : حدَّثَنَا حَاتِمُ بْنُ أَبِی صَغِیرَۃَ ، عَنِ النُّعْمَانِ بْنِ سَالِمٍ ، أَنَّ عَمْرَو بْنَ أَوْسٍ أَخْبَرَہُ ، أَنَّ أَبَاہُ أَوْسًا أَخْبَرَہُ ، قَالَ : إنَّا لَقُعُودٌ عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَقُصُّ عَلَیْنَا وَیُذَکِّرُنَا۔ (ابن ماجہ ۳۹۲۹۔ احمد ۸)","Sahih","Musannaf Ibn Abi Shaybah 26704","","","كتاب الأدب"
"26705","(۲۶۷۰۵) حَدَّثَنَا وَکِیعٌ ، عَن مَالِکِ بْنِ مِغْوَلٍ ، قَالَ : قَالَ أَبُو عَبْدِ الرَّحْمَنِ السُّلَمِیُّ : لاَ تُجَالِسُوا مِنَ الْقُصَّاصِ إلاَّ أَبَا الأَحْوَصِ۔","","Musannaf Ibn Abi Shaybah 26705","","","كتاب الأدب"
"26706","(۲۶۷۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، قَالَ : ذَکَرُوا عِنْدَ الشَّعْبِیِّ الْجُلُوسَ مَعَ الْقُصَّاصِ کَعَدْلِ عِتْقِ رَقَبَۃٍ ، فَقَالَ : لأَنْ أُعْتِقَ رَقَبَۃً أَحَبُّ إلَیَّ مِنْ أَنْ أَجْلِسَ مَعَ الْقُصَّاصِ أَرْبَعَۃَ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 26706","","","كتاب الأدب"
"26707","(۲۶۷۰۷) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، قَالَ : کَانَ إبْرَاہِیمُ التَّیْمِیُّ یُذَکِّرُ فِی مَنْزِلِ أَبِی وَائِلٍ ، فَجَعَلَ أَبُو وَائِلٍ یَنْتَفِضُ کَمَا یَنْتَفِضُ الطَّیْرُ۔","","Musannaf Ibn Abi Shaybah 26707","","","كتاب الأدب"
"26708","(۲۶۷۰۸) حَدَّثَنَا جَرِیرٌ ، قَالَ : کَانَ الْحَسَنُ یَقُصُّ ، وَکَانَ سَعِیدُ بْنُ جُبَیْرٍ یَقُصُّ۔","","Musannaf Ibn Abi Shaybah 26708","","","كتاب الأدب"
"26709","(۲۶۷۰۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن دَاوُد بْنِ سَابُورَ ، عَن مُجَاہِدٍ ، قَالَ : کُنَّا نَفْخَرُ عَلَی النَّاسِ بِأَرْبَعَۃٍ : بِفَقِیہِنَا وَبِقَاصِّنَا وَبِمُؤَذِّنِنَا وَبِقَارِئِنَا ، فَقِیہُنَا ابْنُ عَبَّاسٍ ، وَمُؤَذِّنُنَا أَبُو مَحْذُورَۃَ ، وَقَاصُّنَا عُبَیْدُ بْنُ عُمَیْرٍ ، وَقَارِئُنَا عَبْدُ اللہِ بْنُ السَّائِبِ۔","Sahih","Musannaf Ibn Abi Shaybah 26709","","","كتاب الأدب"
"26710","(۲۶۷۱۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن مُجَاہِدٍ ، عَن یَزِیدَ بْنِ شَجَرَۃَ ، أَنَّہُ کَانَ یَقُصُّ ، وَکَانَ یُوَافِقُ قَوْلُہُ فِعْلَہُ۔","","Musannaf Ibn Abi Shaybah 26710","","","كتاب الأدب"
"26711","(۲۶۷۱۱) حَدَّثَنَا غُنْدَرٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَن کُرْدُوسٍ ، قَالَ : کَانَ یَقُصُّ ، فقَالَ: حَدَّثَنِی رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لأَنْ أَجْلِسَ فِی مِثْلِ ہَذَا الْمَجْلِسِ أَحَبُّ إلَیَّ مِنْ أَنْ أُعْتِقَ أَرْبَعَ رِقَابٍ ، یَعْنِی الْقَصَصَ۔ (احمد ۳/۴۷۴)","Da'if","Musannaf Ibn Abi Shaybah 26711","","","كتاب الأدب"
"26712","(۲۶۷۱۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : رَأَیْتُ تَمِیمًا الدَّارِیَّ یَقُصُّ فِی عَہْدِ عُمَرَ بْنِ الْخَطَّابِ رضی اللہ عَنہما۔","","Musannaf Ibn Abi Shaybah 26712","","","كتاب الأدب"
"26713","(۲۶۷۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، قَالَ : رَأَیْتُ مُحَمَّدَ بْنَ کَعْبٍ الْقُرَظِیَّ یَقُصُّ۔","","Musannaf Ibn Abi Shaybah 26713","","","كتاب الأدب"
"26714","(۲۶۷۱۴) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَن عُبَیْدِ اللہِ ، عَن نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَمْ یُقَصَّ زَمَانَ أَبِی بَکْرٍ ، وَلاَ عُمَرَ ، إنَّمَا کَانَ الْقَصَصُ زَمَنَ الْفِتْنَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 26714","","","كتاب الأدب"
"26715","(۲۶۷۱۵) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَن سَعِیدٍ الْجُرَیْرِیِّ، عَنْ أَبِی عُثْمَانَ ، قَالَ: کَتَبَ عَامِلٌ لِعُمَرَ بْنِ الْخَطَّابِ إلَیْہِ ، أَنَّ ہَاہُنَا قَوْمًا یَجْتَمِعُونَ فَیَدْعُونَ لِلْمُسْلِمِینَ وَلِلأَمِیرِ ، فَکَتَبَ إلَیْہِ عُمَرُ : أَقْبِلْ وَأَقْبِلْ بِہِمْ مَعَک ، فَأَقْبَلَ ، وَقَالَ عُمَرُ لِلْبَوَّابِ : أَعِدَّ لِی سَوْطًا ، فَلَمَّا دَخَلُوا عَلَی عُمَرَ أَقْبَلَ عَلَی أَمِیرِہِمْ ضَرْبًا بِالسَّوْطِ ، فَقَالَ : یَا أمیر المؤمنین ، إنَّا لَسْنَا أُولَئِکَ الَّذِینَ یَعْنِی أُولَئِکَ قَوْمٌ یَأْتُونَ مِنْ قِبَلِ الْمَشْرِقِ۔","Sahih","Musannaf Ibn Abi Shaybah 26715","","","كتاب الأدب"
"26716","(۲۶۷۱۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، أَنَّ عَلِیًّا رَأَی رَجُلاً یَقُصُّ ، فقَالَ : عَلِمْت النَّاسِخَ وَالْمَنْسُوخَ ؟ قَالَ : لاَ قَالَ : ہَلَکْت وَأَہْلَکْت۔","Sahih","Musannaf Ibn Abi Shaybah 26716","","","كتاب الأدب"
"26717","(۲۶۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، عَنْ عَبْدِاللہِ بْنِ خَبَّابٍ ، قَالَ: رَآنِی أَبِی وَأَنَا عِنْدَ قَاصٍّ ، فَلَمَّا رَجَعت أَخَذَ الْہِرَاوَۃَ ، قَالَ : قَرْنٌ قَدْ طَالَعَ الْعَمَالِقَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 26717","","","كتاب الأدب"
"26718","(۲۶۷۱۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَن سُفْیَانَ، عَنْ أَبِیہِ، قَالَ: سَمِعْتُ إبْرَاہِیمَ التَّیْمِیَّ، قَالَ: إنَّمَا حَمَلَنِی عَلَی مَجْلِسِی ہَذَا أَنِّی رُؤیت کَأَنِّی أُقَسِّمُ رَیْحَانًا ، فَذَکَرْت ذَلِکَ لإِبْرَاہِیمَ فَقَالَ : إنَّ الرَّیْحَانَ لَہُ مَنْظَرٌ وَطَعْمُہُ مُرٌّ۔","","Musannaf Ibn Abi Shaybah 26718","","","كتاب الأدب"
"26719","(۲۶۷۱۹) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : حَدَّثَنَی عُقْبَۃُ بْنُ حُرَیْثٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، وَجَائَ رَجُلٌ قَاصٌّ وَجَلَسَ فِی مَجْلِسِہِ فَقَالَ ابْنُ عُمَرَ : قُمْ مِنْ مَجْلِسِنَا ، فَأَبَی أَنْ یَقُومَ ، فَأَرْسَلَ ابْنُ عُمَرَ إلَی صَاحِبِ الشُّرَطِ : أَقِمِ الْقَاصَّ ، فَبَعَثَ إلَیْہِ فَأَقَامَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26719","","","كتاب الأدب"
"26720","(۲۶۷۲۰) حَدَّثَنَا شَرِیکٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَلْقَمَۃَ ، قَالَ : قیلَ لَہُ : أَلاَ تَقُصُّ عَلَیْنَا ؟ قَالَ : إنِّی أَکْرَہُ أَنْ آمُرَکُمْ بِمَا لاَ أَفْعَلُ۔","","Musannaf Ibn Abi Shaybah 26720","","","كتاب الأدب"
"26721","(۲۶۷۲۱) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی سِنَانٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْہُذَیْلِ ، عَن خَبَّابٍ ، قَالَ : رَأَی ابْنَہُ عِنْدَ قَاصٍّ ، فَلَمَّا رَجَعَ اتَّزَرَ وَأَخَذَ السَّوْطَ وَقَالَ : أَمَعَ الْعَمَالِقَۃِ ، ہَذَا قَرْنٌ قَدْ طَلَعَ۔","Hasan","Musannaf Ibn Abi Shaybah 26721","","","كتاب الأدب"
"26722","(۲۶۷۲۲) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ ، عَن مُجَاہِدٍ ، قَالَ : دَخَلَ قَاصٌّ فَجَلَسَ قَرِیبًا مِنَ ابْنِ عُمَرَ فَقَالَ لَہُ : قُمْ ، فَأَبَی أَنْ یَقُومَ ، فَأَرْسَلَ إلَی صَاحِبِ الشُّرَطِ ، فَأَرْسَلَ إلَیْہِ شُرْطِیًّا فَقَامَ۔","Hasan","Musannaf Ibn Abi Shaybah 26722","","","كتاب الأدب"
"26723","(۲۶۷۲۳) حَدَّثَنَا شَرِیکٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : بَلَغَ عُمَرَ ، أَنَّ رَجُلاً یَقُصُّ بِالْبَصْرَۃِ فَکَتَبَ إلَیْہِ : {الر تِلْکَ آیَاتُ الْکِتَابِ الْمُبِینِ إنَّا أَنْزَلْنَاہُ قُرْآنًا عَرَبِیًّا لَعَلَّکُمْ تَعْقِلُونَ نَحْنُ نَقُصُّ عَلَیْک أَحْسَنَ الْقَصَصِ} إلَی آخِرِ الآیَۃِ ، قَالَ : فَعَرَفَ الرَّجُلُ فَتَرَکَہُ۔","","Musannaf Ibn Abi Shaybah 26723","","","كتاب الأدب"
"26724","(۲۶۷۲۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ ، عَن أُکَیْلٍ ، قَالَ : قَالَ إبْرَاہِیمُ : مَا أَحَدٌ مِمَّنْ یَذْکُرُ أَرْجَی فِی نَفْسِی أَنْ یَسْلَمَ مِنْہُ یَعْنِی إبْرَاہِیمَ التَّیْمِیَّ ، وَلَوَدِدْت ، أَنَّہُ یَسْلَمُ مِنْہُ کَفَافًا لاَ عَلَیْہِ ، وَلاَ لَہُ۔","","Musannaf Ibn Abi Shaybah 26724","","","كتاب الأدب"
"26725","(۲۶۷۲۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَن سَلَمَۃَ ، عَنْ أَبِی الدَّرْدَائِ - جَارٍ لِسَلَمَۃَ - قَالَ : قُلْتُ لِعَائِشَۃَ أَوْ قَالَ لَہَا رَجُلٌ : آتِیَ الْقَاصَّ یَدْعُو لِی ، فَقَالَتْ : لأَنْ تَدْعُوَ لِنَفْسِکَ خَیْرٌ مِنْ أَنْ یَدْعُوَ لَکَ الْقَاصُّ۔","Da'if","Musannaf Ibn Abi Shaybah 26725","","","كتاب الأدب"
"26726","(۲۶۷۲۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَن نَافِعٍ ، قَالَ : لَمْ یَکُنْ قَاصٌّ فِی زَمَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، وَلاَ زَمَنِ أَبِی بَکْرٍ، وَلاَ زَمَنِ عُمَرَ، وَلاَ فِی زَمَنِ عُثْمَانَ۔ (ابن ماجہ ۳۷۵۴۔ ابن حبان ۶۲۶۱)","","Musannaf Ibn Abi Shaybah 26726","","","كتاب الأدب"
"26727","(۲۶۷۲۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، حَدَّثَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : حدَّثَنَی یَحْیَی بْنُ سَعِیدٍ الْکَلاَعِیُّ ، عَن جُبَیْرِ بْنِ نُفَیْرٍ الْحَضْرَمِیِّ ، أَنَّ أُمَّ الدَّرْدَائِ بَعَثَتْہُ إلَی نَوْفَلِ بْنِ فُلاَنٍ وَقَاصٍّ مَعَہُ ، یَقُصَّانِ فِی الْمَسْجِدِ ، فَقَالَتْ : قُلْ لَہُمَا : لِیَتَّقِیَا اللَّہَ وَتَکُنْ مَوْعِظَتُہُمَا لِلنَّاسِ لأَنْفُسِہِمَا۔","","Musannaf Ibn Abi Shaybah 26727","","","كتاب الأدب"
"26728","(۲۶۷۲۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَن عُبَیْدِ بْنِ الْحَسَنِ ، عَنِ ابْنِ مَعْقِلٍ ، قَالَ : کَانَ رَجُلٌ لاَ یَزَالُ یَقُصُّ فَقَالَ لَہُ ابْنُ مَسْعُودٍ : انْشُرْ سِلْعَتَکَ عَلَی مَنْ یُرِیدُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 26728","","","كتاب الأدب"
"26729","(۲۶۷۲۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ ابْنِ عُمَرَ ، قَالَ : قبَّلْنَا یَدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (ابوداؤد ۲۶۴۰۔ احمد ۲۳)","Da'if","Musannaf Ibn Abi Shaybah 26729","","","كتاب الأدب"
"26730","(۲۶۷۳۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 26730","","","كتاب الأدب"
"26731","(۲۶۷۳۱) حَدَّثَنَا ابْنُ إدْرِیسَ وَغُنْدَرٌ ، وَأَبُو أُسَامَۃَ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَن صَفْوَانَ بْنِ عَسَّالٍ ، أَنَّ قَوْمًا مِنَ الْیَہُودِ قَبَّلُوا یَدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَرِجْلَیْہِ۔n(ترمذی ۲۷۳۳۔ احمد ۴/۲۳۹)","Hasan","Musannaf Ibn Abi Shaybah 26731","","","كتاب الأدب"
"26732","(۲۶۷۳۲) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن زِیَادِ بْنِ فَیَّاضٍ ، عَن تَمِیمِ بْنِ سَلَمَۃَ ، أَنَّ أَبَا عُبَیْدَۃَ قَبَّلَ یَدَ عُمَرَ ، قَالَ تَمِیمٌ : وَالْقُبْلَۃُ سُنَّۃٌ۔ (بیہقی ۱۰۱)","","Musannaf Ibn Abi Shaybah 26732","","","كتاب الأدب"
"26733","(۲۶۷۳۳) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَن مَالِکٍ، عَن طَلْحَۃَ، قَالَ: قبَّلَ خَیْثَمَۃُ یَدِی، قَالَ مَالِکٌ: وَقَبَّلَ طَلْحَۃُ یَدِی۔","","Musannaf Ibn Abi Shaybah 26733","","","كتاب الأدب"
"26734","(۲۶۷۳۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَرِہَ أَنْ یَقُولَ الرَّجُلُ : ذَیّا۔","","Musannaf Ibn Abi Shaybah 26734","","","كتاب الأدب"
"26735","(۲۶۷۳۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی سُعَادٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ الْحَنَفِیَّۃِ ، أَنَّہُ سَمِعَ رَجُلاً یَقُولُ: یَا ہَنَاۃُ ، فَنَہَاہُ۔","","Musannaf Ibn Abi Shaybah 26735","","","كتاب الأدب"
"26736","(۲۶۷۳۶) حَدَّثَنَا حَفْصٌ ، عَن عِیسَی بْنِ الْمُسَیَّبِ ، أَنَّہُ کَرِہَ کُلَّ شَیْئٍ یَکُونُ آخِرُہُ : وَیْہِ۔","","Musannaf Ibn Abi Shaybah 26736","","","كتاب الأدب"
"26737","(۲۶۷۳۷) حَدَّثَنَا ابْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَن مُوسَی بْنِ سُلَیْمَانَ ، عَنِ الْقَاسِمِ بْنِ مُخَیْمِرَۃَ ، قَالَ : قَالَ لُقْمَانُ لابْنِہِ وَہُوَ یَعِظُہُ : یَا بُنَیَّ ، إیَّاکَ وَالتَّقَنُّعَ فَإِنَّہُ مَخْوَفَۃٌ بِاللَّیْلِ مَذَلَّۃٌ ، أَوْ مَذَمَّۃٌ بِالنَّہَارِ۔","","Musannaf Ibn Abi Shaybah 26737","","","كتاب الأدب"
"26738","(۲۶۷۳۸) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَن سَہْلِ بْنِ خَلِیفَۃَ ، عَن عُبَیْدَۃَ ، قَالَ : رَأَیْتُ طَاوُوسًا عَلَیْہِ مُقَنَّعَۃٌ مِثْلُ مُقَنَّعَۃِ الرُّہْبَانِ۔","","Musannaf Ibn Abi Shaybah 26738","","","كتاب الأدب"
"26739","(۲۶۷۳۹) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ، عَنْ أَبِی الْعَلاَئِ، قَالَ: رَأَیْتُ الْحَسَنَ بْنَ عَلِیٍّ یُصَلِّی مُقَنِّعًا رَأْسَہُ۔ (عبدالرزاق ۱۹۸۴۰۔ بزار ۲۸۸۶)","Da'if","Musannaf Ibn Abi Shaybah 26739","","","كتاب الأدب"
"26740","(۲۶۷۴۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَن عُبَیْدِ اللہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ نَامَ وَفِی یَدِہِ رِیحُ غَمَرٍ فَأَصَابَہُ شَیْئٌ فَلاَ یَلُومَنَّ إلاَّ نَفْسَہُ۔","","Musannaf Ibn Abi Shaybah 26740","","","كتاب الأدب"
"26741","(۲۶۷۴۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن وَاصِلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنَّ الشَّیْطَانَ یَحْضُرُ الدَّسَمَ۔","","Musannaf Ibn Abi Shaybah 26741","","","كتاب الأدب"
"26742","(۲۶۷۴۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا زُہَیْرٌ ، عَن سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ نَامَ وَفِی یَدِہِ غَمَرٌ لَمْ یَغْسِلْہُ فَأَصَابَہُ شَیْئٌ فَلاَ یَلُومَنَّ إلاَّ نَفْسَہُ۔n(ابوداؤد ۳۸۴۸۔ ترمذی ۱۸۵۹)","Sahih","Musannaf Ibn Abi Shaybah 26742","","","كتاب الأدب"
"26743","(۲۶۷۴۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَن مَیْمُونِ بْنِ أَبِی شَبِیبٍ ، قَالَ : قَالَ صَعْصَعَۃُ لابْنِ أَخِیہِ : إنِّی کُنْت أَحَبَّ إلَی أَبِیک مِنْک فَأَنْتَ أَحَبُّ إلَیَّ مِنِ ابْنِی ، إذَا لَقِیت الْمُؤْمِنَ فَخَالِطْہُ ، وَإِذَا لَقِیت الْفَاجِرَ فَخَالِقْہُ۔","","Musannaf Ibn Abi Shaybah 26743","","","كتاب الأدب"
"26744","(۲۶۷۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِ ، عَن یَحْیَی بْنِ وَثَّابٍ ، عَن رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْمُؤْمِنُ الَّذِی یُخَالِطُ النَّاسَ وَیَصْبِرُ عَلَی أَذَاہُمْ أَفْضَلُ مِنَ الَّذِی لاَ یُخَالِطُ النَّاسَ ، وَلاَ یَصْبِرُ عَلَی أَذَاہُمْ۔ (ترمذی ۲۵۰۷۔ احمد ۲/۴۳)","Sahih","Musannaf Ibn Abi Shaybah 26744","","","كتاب الأدب"
"26745","(۲۶۷۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ عن عبد اللہ بن باہ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ مَسْعُودٍ : خَالِطُوا النَّاسَ وَزَایِلُوہُمْ وَصَافِحُوہُمْ وَدِینُکُمْ فلاَ تَکْلِمُونَہُ۔ (طبرانی ۹۷۵۷)","Sahih","Musannaf Ibn Abi Shaybah 26745","","","كتاب الأدب"
"26746","(۲۶۷۴۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : حدَّثَنِی مُسْلِمٌ الْبَطِینُ ، عنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبہ: ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : مَا أَخْطَأَنِی ابْنُ مَسْعُودٍ خَمِیسًا إلاَّ أَتَیْتہ فِیہِ ، قَالَ: فَمَا سَمِعْتہ یَقُولُ لِشَیْئٍ قَطُّ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا کَانَ ذَاتَ عَشِیَّۃٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : فَنَکَّسَ ، قَالَ : فَنَظَرْت إلَیْہِ وَہُوَ قَائِمٌ مُنحَلَّۃً أَزْرَارُ قَمِیصِہِ ، قَدَ اغْرَوْرَقَتْ عَیْنَاہُ وَانْتَفَخَتْ أَوْدَاجُہُ، قَالَ : أَوْ دُونَ ذَلِکَ ، أَوْ فَوْقَ ذَلِکَ ، أَوْ قَرِیبًا مِنْ ذَلِکَ ، أَوْ شَبِیہًا بِذَلِکَ۔ (احمد ۱/۴۵۲۔ دارمی ۲۷۰)","Sahih","Musannaf Ibn Abi Shaybah 26746","","","كتاب الأدب"
"26747","(۲۶۷۴۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ أَنَسُ بْنُ مَالِکٍ إذَا حَدَّثَ عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَدِیثًا فَفَرَغَ مِنْہُ ، قَالَ : أَوْ کَمَا قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(دارمی ۲۷۶۔ احمد ۲۰۵)","Sahih","Musannaf Ibn Abi Shaybah 26747","","","كتاب الأدب"
"26748","(۲۶۷۴۸) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : حدَّثَ بِحَدِیثٍ فَقِیلَ لَہُ : أَتَرْفَعُ ہَذَا ؟ فَقَالَ : دُونَہُ أَحَبُّ إلَیْنَا إِنْ کَانَ خَطَأٌ فِی ذَلِکَ ، أَوْ زِیَادَۃٌ ، أَوْ نُقْصَانٌ کَانَ أَحَبَّ إلَیْنَا۔","Sahih","Musannaf Ibn Abi Shaybah 26748","","","كتاب الأدب"
"26749","(۲۶۷۴۹) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : قلْنَا لِزَیْدِ بْنِ أَرْقَمَ : حَدِّثْنَا ، قَالَ : کَبِرْنَا وَنَسِینَا ، وَالْحَدِیثُ علَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَدِیدٌ۔ (ابن ماجہ ۲۵۔ احمد ۳۷۰)","Sahih","Musannaf Ibn Abi Shaybah 26749","","","كتاب الأدب"
"26750","(۲۶۷۵۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَن حَمَّادِ بْنِ زَیْدٍ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، قَالَ : خَرَجْت مَعَ سَعْدِ بْنِ مَالِکٍ مِنَ الْمَدِینَۃِ إلَی مَکَّۃَ ، فَمَا سَمِعْتہ یُحَدِّثُ حَدِیثًا حَتَّی رَجَعْنا۔","Sahih","Musannaf Ibn Abi Shaybah 26750","","","كتاب الأدب"
"26751","(۲۶۷۵۱) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : حَدَّثَنَا تَوْبَۃُ الْعَنْبَرِیُّ ، قَالَ : قَالَ لِی الشَّعْبِیُّ : أَرَأَیْت الْحَسَنَ حِینَ یَقُولُ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَقَدْ جَلَسْت إلَی ابْنِ عُمَرَ ، فَمَا سَمِعْتہ یُحَدِّثُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إلاَّ حَدِیثًا ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِضَبٍّ فَقَالَ : إِنَّہُ لَیْسَ مِنْ طَعَامِی ، وَأَمَّا أَنْتُمْ فَکُلُوہُ۔ (بخاری ۷۲۶۷۔ مسلم ۱۵۴۳)","Sahih","Musannaf Ibn Abi Shaybah 26751","","","كتاب الأدب"
"26752","(۲۶۷۵۲) حَدَّثَنَا أَبُو بَکر ، قَالَ : حَدَّثَنَا شُعْبَۃُ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ ، قَالَ : جَلَسْت إلَی ابْنِ عُمَرَ سَنَۃً فَمَا سَمِعْتہ یُحَدِّثُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِشَیْئٍ۔ (ابن ماجہ ۲۶۔ احمد ۲/۱۵۷)","Sahih","Musannaf Ibn Abi Shaybah 26752","","","كتاب الأدب"
"26753","(۲۶۷۵۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن شُعْبَۃَ ، عَن سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ، قَالَ : قَالَ عُمَرَ لابْنِ مَسْعُودٍ وَلأَبِی الدَّرْدَائِ وَلأَبِی مَسْعُودٍ وَعُقْبَۃَ بْنِ عَمْرٍو : أَحْسَبُ مَا ہَذَا الْحَدِیثُ ، عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : وَأَحْسَبُہُ حَبَسَہُمْ بِالْمَدِینَۃِ حَتَّی أُصِیبَ۔","Sahih","Musannaf Ibn Abi Shaybah 26753","","","كتاب الأدب"
"26754","(۲۶۷۵۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، سَمِعَ سَہْلَ بْنَ سَعْدٍ یَقُولُ : اطَّلَعَ رَجُلٌ مِنْ جُحْرٍ فِی حُ[corrupt]ْرَۃِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَعَہُ مِدْرًی یَحُکُّ بِہِ رَأْسَہُ فَقَالَ : لَوْ أَعْلَمُ أَنَّک تَنْظُرُ لَطَعَنْتُ بِہِ فِی عَیْنِکَ : إنَّمَا الاِسْتِئْذَانُ مِنَ الْبَصَرِ۔ (بخاری ۶۲۴۱۔ مسلم ۱۶۹۸)","Sahih","Musannaf Ibn Abi Shaybah 26754","","","كتاب الأدب"
"26755","(۲۶۷۵۵) حَدَّثَنَا وَکِیعٌ ، عَن بَرَکَۃَ بْنِ یَعْلَی التَّیْمِیِّ ، عَنْ أَبِی سُوَیْد الْعَبْدِیِّ ، قَالَ : کُنَّا بِبَابِ ابْنِ عُمَرَ نَسْتَأْذِنُ عَلَیْہِ ، فَحَانَتْ مِنِّی الْتِفَاتَۃٌ ، فَرَآنِی فَقَالَ : أَیُّکُمُ اطَّلَعَ فِی دَارِی ؟ قَالَ قُلْتُ : أَنَا أَصْلَحَک اللَّہُ ، حَانَتْ مِنِّی الْتِفَاتَۃٌ فَنَظَرْت ، قَالَ : وَیْحَک لَکَ أنْ تَطَّلِعَ فِی دَارِی!۔","Da'if","Musannaf Ibn Abi Shaybah 26755","","","كتاب الأدب"
"26756","(۲۶۷۵۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَن طَلْحَۃَ ، عَنِ الْہُذَیْلِ بْنِ شُرَحْبِیلَ ، أَنَّ سَعْدًا اسْتَأْذَنَ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَدْخَلَ رَأْسَہُ ، فَقَالَ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا جُعِلَ الاِسْتِئْذَانُ مِنْ أَجْلِ النَّظَرِ۔ (ابوداؤد ۵۱۳۱۔ طبرانی ۵۳۸۶)","","Musannaf Ibn Abi Shaybah 26756","","","كتاب الأدب"
"26757","(۲۶۷۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ سَبَقَہُ بَصَرُہُ إلَی الْبُیُوتِ ، فَقَدْ دَمَرَ یَعْنِی دَخَلَ۔","Hasan","Musannaf Ibn Abi Shaybah 26757","","","كتاب الأدب"
"26758","(۲۶۷۵۸) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَن طَلْحَۃَ ، عَن ہُزَیْلٍ ، قَالَ : جَائَ رَجُلٌ فَوَقَفَ عَلَی بَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَسْتَأْذِنُ ، فَقَامَ عَلَی الْبَابِ ، فَقَالَ لہ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَکَذَا ، عَنک ہَکَذَا ، فَإِنَّمَا الاِسْتِئْذَانُ مِنَ النَّظَرِ۔","","Musannaf Ibn Abi Shaybah 26758","","","كتاب الأدب"
"26759","(۲۶۷۵۹) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَن سُلَیْمَانَ بْنِ بِلاَلٍ ، عَن سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ أَنَّ أَحَدًا اطَّلَعَ عَلَی نَاسٍ بِغَیْرِ إذْنِہِمْ حَلَّ لَہُمْ أَنْ یَفْقَؤُوا عَیْنَہُ۔ (بخاری ۶۸۸۸۔ مسلم ۱۶۹۹)","Hasan","Musannaf Ibn Abi Shaybah 26759","","","كتاب الأدب"
"26760","(۲۶۷۶۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حُمَیْدٌ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ فِی بَیْتِہِ ، فَاطَّلَعَ رَجُلٌ مِنْ خَلَلِ الْبَابِ ، فَسَدَّدَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ علیہ بِمِشْقَصٍ ، فَتَأَخَّرَ الرَّجُلُ۔ (بخاری ۶۲۴۲۔ مسلم ۱۶۹۹)","Sahih","Musannaf Ibn Abi Shaybah 26760","","","كتاب الأدب"
"26761","(۲۶۷۶۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَن مُسْلِمِ بْنِ نَذِیرٍ ، قَالَ : اسْتَأْذَنَ رَجُلٌ عَلَی حُذَیْفَۃَ فَأَدْخَلَ رَأْسَہُ فَقَالَ لَہُ حُذَیْفَۃُ : قَدْ أَدْخَلْت رَأْسَک فَأَدْخِلْ إِسْتَک۔","Hasan","Musannaf Ibn Abi Shaybah 26761","","","كتاب الأدب"
"26762","(۲۶۷۶۲) حَدَّثَنَا شَرِیکٌ بْنُ عَبْدِ اللہِ ، عَن سِمَاکٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (بخاری ۶۸۸۸۔ ترمذی ۲۶۵۹)","Hasan","Musannaf Ibn Abi Shaybah 26762","","","كتاب الأدب"
"26763","(۲۶۷۶۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًِا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (بخاری ۱۰۸۔ مسلم ۱۰)","Sahih","Musannaf Ibn Abi Shaybah 26763","","","كتاب الأدب"
"26764","(۲۶۷۶۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ عَلِیٍّ مِثْلُ حَدِیثِ ابْنِ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَن حَبِیبٍ۔ (بزار ۶۲۱)","Sahih","Musannaf Ibn Abi Shaybah 26764","","","كتاب الأدب"
"26765","(۲۶۷۶۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَوْزَاعِیِّ ، عَن حَسَّانَ بْنِ عَطِیَّۃَ ، عَنْ أَبِی کَبْشَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔n(بخاری ۳۴۶۱۔ ترمذی ۲۶۶۹)","Sahih","Musannaf Ibn Abi Shaybah 26765","","","كتاب الأدب"
"26766","(۲۶۷۶۶) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنْ عَامِرِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ لِلزُّبَیْرِ : یَا أَبَتِی ، مَالِی لاَ أَسْمَعُک تُحَدِّثُ عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَمَا أسْمَعُ ابْنَ مَسْعُودٍ وَفُلاَنًا وَفُلاَنًا ؟ فَقَالَ : أما إنِّی لَمْ أُفَارِقْہُ مُنْذُ أَسْلَمْت ، وَلَکِنِّی سَمِعْت مِنْہُ کَلِمَۃً : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (بخاری ۱۰۷۔ ابوداؤد ۳۶۴۳)","Sahih","Musannaf Ibn Abi Shaybah 26766","","","كتاب الأدب"
"26767","(۲۶۷۶۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا ، عَن خَالِدِ بْنِ سَلَمَۃَ ، عَن مُسْلِمٍ مَوْلَی خَالِدِ بْنِ عُرْفُطَۃَ ، أَنَّ خَالِدَ بْنَ عُرْفُطَۃَ ذَکَرَ الْمُخْتَارَ فَقَالَ : کَذَّابٌ ، وَسَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنْ جَہَنَّمَ۔ (احمد ۵/۲۹۲۔ ابویعلی ۶۸۳۳)","Da'if","Musannaf Ibn Abi Shaybah 26767","","","كتاب الأدب"
"26768","(۲۶۷۶۸) حَدَّثَنَا یَحیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ ، عَن مَعْبَدِ بْنِ کَعْبٍ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ عَلَی ہَذَا الْمِنْبَرِ : إیَّاکُمْ وَکَثْرَۃَ الْحَدِیثِ عَلَیَّ ، فَمَنْ قَالَ فَلْیَقُلْ حَقًّا ، أَوْ صِدْقًا ، وَمَنْ تَقَوَّلَ عَلَیَّ مَا لَمْ أَقُلْ فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (احمد ۵/۲۹۷۔ دارمی ۲۳۷)","Hasan","Musannaf Ibn Abi Shaybah 26768","","","كتاب الأدب"
"26769","(۲۶۷۶۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَأَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ، عَنْ أَبِی بَکْرِ بْنِ سَالِمٍ، عَنْ أَبِیہِ، عَنْ جَدِّہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إنَّ الَّذِی یَکْذِبُ عَلَیَّ یُبْنَی لَہُ بَیْتٌ فِی النَّارِ۔n(احمد ۲/۲۲۔ طبرانی ۱۳۱۵۴)","Sahih","Musannaf Ibn Abi Shaybah 26769","","","كتاب الأدب"
"26770","(۲۶۷۷۰) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَن رِبْعِیِّ بْنِ حِرَاشٍ ، أَنَّہُ سَمِعَ عَلِیًّا یَخْطُبُ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ تَکْذِبُوا عَلَیَّ، فَإِنَّہُ مَنْ یَکْذِبْ عَلَیَّ یَلِجَ النَّارَ۔(بخاری ۱۰۶۔ مسلم ۱۲۳)","Sahih","Musannaf Ibn Abi Shaybah 26770","","","كتاب الأدب"
"26771","(۲۶۷۷۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، قَالَ : حَدَّثَنَا زَیْدُ بْنُ أَسْلَمَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَذَبَ عَلَیَّ ، أَحْسَبُہُ قَالَ : مُتَعَمِّدًا ، فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (مسلم ۲۲۹۸۔ احمد ۳/۴۴)","Sahih","Musannaf Ibn Abi Shaybah 26771","","","كتاب الأدب"
"26772","(۲۶۷۷۲) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَن مُطَرِّفٍ ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (ابن ماجہ ۳۷)","Da'if","Musannaf Ibn Abi Shaybah 26772","","","كتاب الأدب"
"26773","(۲۶۷۷۳) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقُْرِیء ، عَن سَعِیدِ بْنِ أَبِی أَیُّوبَ ، قَالَ : حدَّثَنَی بَکْرُ بْنُ عَمْرٍو ، عَنْ أَبِی عُثْمَانَ مُسْلِمِ بْنِ یَسَارٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ تَقَوَّلَ عَلَیَّ مَا لَمْ أَقُلْ فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (بخار ی۱۱۰۔ مسلم ۱۰)","Da'if","Musannaf Ibn Abi Shaybah 26773","","","كتاب الأدب"
"26774","(۲۶۷۷۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَن مُرَّۃَ ، عَن رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ قَامَ فِینَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : قدْ رَأَیْتُمُونِی وَسَمِعْتُمْ مِنِّی وَسَتُسْأَلُونَ عَنی، فَمَنْ کَذَبَ عَلَیَّ فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (احمد ۵/۴۱۲)","Sahih","Musannaf Ibn Abi Shaybah 26774","","","كتاب الأدب"
"26775","(۲۶۷۷۵) قَال حُدِّثْت عَن ہُشَیْمٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (ابن ماجہ ۳۳۔ دارمی ۲۳۱)","","Musannaf Ibn Abi Shaybah 26775","","","كتاب الأدب"
"26776","(۲۶۷۷۶) حدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا سُلَیْمَانُ التَّیْمِیُّ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ ، وَرُبَّمَا قَالَ : فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ مُتَعَمِّدًا۔n(نسائی ۵۹۱۴۔ احمد ۳/۱۱۶)","Sahih","Musannaf Ibn Abi Shaybah 26776","","","كتاب الأدب"
"26777","(۲۶۷۷۷) حَدَّثَنَا سُوَیْد بْنُ عَمْرو ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ عَبْدِ الأَعْلَی ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، عنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔n(ترمذی ۲۹۵۱۔ احمد ۱/۲۹۳)","Da'if","Musannaf Ibn Abi Shaybah 26777","","","كتاب الأدب"
"26778","(۲۶۷۷۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ عُبَیْدٍ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ کَذِبًا عَلَیَّ لَیْسَ کَکَذِبِ أَحَدِکُمْ ، فَمَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (بخاری ۱۲۹۱۔ مسلم ۱۵)","Sahih","Musannaf Ibn Abi Shaybah 26778","","","كتاب الأدب"
"26779","(۲۶۷۷۹) حَدَّثَنَا أَبُو بَکْرٍ قَالَ : وَجَدْت فِی کِتَاب أَبی مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ : عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ مَحمُود بن لَبِید ، عَنْ عُثْمَانَ بْنِ عَفَّان ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ (احمد ۱/۷۰۔ بزار ۳۸۴)","Sahih","Musannaf Ibn Abi Shaybah 26779","","","كتاب الأدب"
"26780","(۲۶۷۸۰) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَن أَبِی حَیَّانَ ، عَن یَزِیدَ بْنِ حَیَّانَ ، عَن زَیْدِ بْنِ أَرْقَمَ ، قَالَ : سَمِعْتُہُ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَذَبَ عَلَیَّ مُتَعَمِّدًا فَلْیَتَبَوَّأْ مَقْعَدَہُ مِنَ النَّارِ۔ n(احمد ۴/۳۶۶۔ طبرانی ۵۰۱۷)","Sahih","Musannaf Ibn Abi Shaybah 26780","","","كتاب الأدب"
"26781","(۲۶۷۸۱) حدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ ، قَالَ : حدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنْ أَبِی رَزِینٍ ، قَالَ: قِیلَ لِلْعَبَّاسِ : أَنْتَ أَکْبَرُ ، أَوْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : ہُوَ أَکْبَرُ مِنِّی وَوُلِدْت أَنَا قَبْلَہُ۔n(حاکم ۳۲۰)","Sahih","Musannaf Ibn Abi Shaybah 26781","","","كتاب الأدب"
"26782","(۲۶۷۸۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَنْ أَبِیہِ ، قَالَ : قیلَ لأَبِی وَائِلٍ : أَیُّکُمَا أَکْبَرُ ؟ أَنْتَ أَکْبَرُ ، أَوِ الرَّبِیعُ بْنُ خُثَیْمٍ ؟ قَالَ : أَنَا أَکْبَرُ مِنْہُ سِنًّا وَہُوَ أَکْبَرُ مِنِّی عَقْلاً۔","","Musannaf Ibn Abi Shaybah 26782","","","كتاب الأدب"
"26783","(۲۶۷۸۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ أَبِی وَائِلٍ بِنَحْوٍ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 26783","","","كتاب الأدب"
"26784","(۲۶۷۸۴) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَن مُجَاہِدٍ ، عَنْ أَبِی مَعْمَرٍ ، عَنِ الْمِقْدَادِ بْنِ الأَسْوَدِ قَالَ : أَمَرَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ نَحْثُوَ فِی وُجُوہِ الْمَدَّاحِینَ التُّرَابَ۔ (مسلم ۲۲۹۷۔ احمد ۶/۵)","Sahih","Musannaf Ibn Abi Shaybah 26784","","","كتاب الأدب"
"26785","(۲۶۷۸۵) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَن ہَمَّامِ بْنِ الْحَارِثِ ، أَنَّ رَجُلاً جَعَلَ یَمْدَحُ عُثْمَانَ ، فَعَمَدَ الْمِقْدَادُ فَجَثَا عَلَی رُکْبَتَیْہِ ، قَالَ : وَکَانَ رَجُلاً ضَخْمًا ، قَالَ : فَجَعَلَ یَحْثُو فِی وَجْہِہِ الْحَصَی ، فَقَالَ لَہُ عُثْمَانُ : مَا شَأْنُک ؟ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا رَأَیْتُمُ الْمَدَّاحِینَ فَاحْثُوا فِی وُجُوہِہِمُ التُّرَابَ۔ (مسلم ۲۲۹۷۔ احمد ۶/۵)","Sahih","Musannaf Ibn Abi Shaybah 26785","","","كتاب الأدب"
"26786","(۲۶۷۸۶) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن سَعْدِ بْنِ إبْرَاہِیمَ ، عَن مَعْبَدٍ الْجُہَنِیِّ ، عَن مُعَاوِیَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إیَّاکُمْ وَالتَّمَادُحَ فَإِنَّہُ الذَّبْحُ۔ (احمد ۴/۹۸۔ طبرانی ۸۱۵)","Hasan","Musannaf Ibn Abi Shaybah 26786","","","كتاب الأدب"
"26787","(۲۶۷۸۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ قَالَ : کُنَّا قُعُودًا عِنْدَ عُمَرَ بْنِ الْخَطَّابِ ، فَدَخَلَ عَلَیْہِ رَجُلٌ فَسَلَّمَ عَلَیْہِ ، فَأَثْنَی عَلَیْہِ رَجُلٌ مِنَ الْقَوْمِ فِی وَجْہِہِ ، فَقَالَ لہ عُمَرُ : عَقَرْت الرَّجُلَ عَقَرَک اللَّہُ ، تُثْنِی عَلَیْہِ فِی وَجْہِہِ فِی دِینِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 26787","","","كتاب الأدب"
"26788","(۲۶۷۸۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَن زَیْدِ بْنِ أَسْلَمَ ، عَنْ أَبِیہِ أَسْلَمَ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ : الْمَدِیحُ الذَّبْحُ۔ (بخاری ۳۳۶)","Sahih","Musannaf Ibn Abi Shaybah 26788","","","كتاب الأدب"
"26789","(۲۶۷۸۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ قَالَ : قَالَ عَبْدُ اللہِ : إذَا طَلَبَ أَحَدُکُمُ الْحَاجَۃَ فَلْیَطْلُبْہَا طَلَبًا یَسِیرًا، وَلاَ یَأْتِی الرَّجُلَ فَیُثْنِیَ عَلَیْہِ فِی وَجْہِہِ فَیَقْطَعَ ظَہْرَہُ فَلاَ یَمْنَعُہُ شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 26789","","","كتاب الأدب"
"26790","(۲۶۷۹۰) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ قَالَ : حدَّثَنَا شُعْبَۃُ ، عَن خَالِدٍ الْحَذَّائِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرَۃَ ، عَنْ أَبِیہِ قَالَ : مَدَحَ رَجُلٌ رَجُلاً عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ لَہُ : النَّبِیُّ صَلَّ[corrupt] اللَّہُ عَلَیْہِ وَسَلَّمَ : وَیْحَک ، قَطَعْت عُنُقَ صَاحِبِکَ مِرَارًا ، ثُمَّ قَالَ : إِنْ کَانَ أَحَدکم مَادِحًا أَخَاہُ لاَ مَحَالَۃَ فَلْیَقُلْ لَہُ : أَحْسَبُ ، وَلاَ أُزَکِّی عَلَی اللہِ أَحَدًا۔ (مسلم ۲۲۹۶۔ ابن ماجہ ۳۷۴۴)","Sahih","Musannaf Ibn Abi Shaybah 26790","","","كتاب الأدب"
"26791","(۲۶۷۹۱) حَدَّثَنَا غُنْدَرٌ، عَن شُعْبَۃَ ، عَنْ عَاصِمٍ قَالَ : قُلْتُ لغنیم : أَیُکْرَہُ لِلرَّجُلِ أَنْ یَمْدَحَ أَخَاہُ وَہُوَ شَاہِدٌ؟ قَالَ: نَعَمْ ، فَقُلْت : وَإِنْ کَانَ غَائِبًا ؟ قَالَ : کَانَ یُقَالُ : لاَ تَمْدَحْ أَخَاک۔","","Musannaf Ibn Abi Shaybah 26791","","","كتاب الأدب"
"26792","(۲۶۷۹۲) حَدَّثَنَا أَبُو دَاوُدَ عُمَرُ بْنُ سَعْدٍ ، عَن سُفْیَانَ، عَن لَیْثٍ، عَن طَاوُوس، عَنِ ابْنِ عَبَّاسٍ قَالَ: لاَ أُزَکِّی بعد النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَحَدًا۔","Da'if","Musannaf Ibn Abi Shaybah 26792","","","كتاب الأدب"
"26793","(۲۶۷۹۳) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ الْحَکَمِ ، عَنْ عَطَائِ بْنِ أَبِی رَبَاحٍ ، أَنَّ رَجُلاً کَانَ یَمْدَحُ رَجُلاً عِنْدَ ابْنِ عُمَرَ ، فَجَعَلَ ابْنُ عُمَرَ یَحْثُو التُّرَابَ نَحْوَ وَجْہِہِ بِأَصَابِعِہِ ، وَقَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا رَأَیْتُمُ الْمَادِحِینَ فَاحْثُوا فِی أَفْوَاہِہِمُ التُّرَابَ ؟۔ n(احمد ۲/۹۴۔ ابن حبان ۵۷۷۰)","","Musannaf Ibn Abi Shaybah 26793","","","كتاب الأدب"
"26794","(۲۶۷۹۴) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا سُفْیَانُ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَن ہَمَّامٍ قَالَ : جَائَ رَجُلٌ فَأَثْنَی عَلَی عُثْمَانَ فِی وَجْہِہِ فَأَخَذَ الْمِقْدَادُ بْنُ الأَسْوَدِ تُرَابًا فَحَثَاہُ فِی وَجْہِہِ ، وَقَالَ : إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إذَا لَقِیتُمُ الْمَدَّاحِینَ فَاحْثُوا فِی وُجُوہِہِمُ التُّرَابَ۔ (مسلم ۲۲۹۷۔ ابوداؤد ۴۷۷۱)","Sahih","Musannaf Ibn Abi Shaybah 26794","","","كتاب الأدب"
"26795","(۲۶۷۹۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ قَالَ : کُنَّا جُلُوسًا عِنْدَ عُمَرَ فَأَثْنَی رَجُلٌ عَلَی رَجُلٍ فِی وَجْہِہِ حِینَ أَدْبَرَ فَقَالَ عمر : عَقَرْت الرَّجُلَ ، عَقَرَک اللَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26795","","","كتاب الأدب"
"26796","(۲۶۷۹۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَنْ یَہْلَکَ امْرُؤٌ بَعْدَ مَشْورَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 26796","","","كتاب الأدب"
"26797","(۲۶۷۹۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ قَالَ : قَالَ سُلَیْمَانُ بْنُ دَاوُد لابْنِہِ : یَا بُنَیَّ ، لاَ تَقْطَعْ أَمْرًا حَتَّی تُؤَامِرَ مُرْشِدًا ، فَإِنَّک إذَا فَعَلْت ذَلِکَ لَمْ تَحْزَنْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 26797","","","كتاب الأدب"
"26798","(۲۶۷۹۸) حَدَّثَنَا وَکِیعٌ، عَن سُفْیَانَ، عَن رَجُلٍ، عَنِ الضَّحَّاکِ قَالَ: مَا أَمَرَ اللَّہُ نَبِیَّہُ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْمُشَاوَرَۃِ إلاَّ لِمَا یَعْلَمَ فِیہَا مِنَ الْفَضْلِ ، ثُمَّ تَلاَ {وَشَاوِرْہُمْ فِی الأَمْرِ}۔","","Musannaf Ibn Abi Shaybah 26798","","","كتاب الأدب"
"26799","(۲۶۷۹۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا اخْتَلَفَ النَّاسُ فِی شَیْئٍ فَانْظُرْ کَیْفَ صَنَعَ فِیہِ عُمَرُ فَإِنَّہُ کَانَ لاَ یَصْنَعُ شَیْئًا حَتَّی یَسْأَلَ وَیُشَاوِرَ۔","","Musannaf Ibn Abi Shaybah 26799","","","كتاب الأدب"
"26800","(۲۶۸۰۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إیَاسِ بْنِ دَغْفَلٍ قَالَ : حدَّثَنَا الْحَسَنُ قَالَ : مَا تشَاوَرَ قَوْمٌ إلاَّ ہُدُوا لأَرْشَدِ أَمْرِہِمْ۔","","Musannaf Ibn Abi Shaybah 26800","","","كتاب الأدب"
"26801","(۲۶۸۰۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ قَالَ : حدَّثَنَی أَبُو مُصْعَبٍ الأَنْصَارِیُّ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : اطْلُبُوا الْحَوَائِجَ إلَی حِسَانِ الْوُجُوہِ۔","","Musannaf Ibn Abi Shaybah 26801","","","كتاب الأدب"
"26802","(۲۶۸۰۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَن طَلْحَۃَ ، عَنْ عَطَائٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ابْتَغُوا الْخَیْرَ عِنْدَ حِسَانِ الْوُجُوہِ۔ (ابن ابی الدنیا ۵۳)","Da'if","Musannaf Ibn Abi Shaybah 26802","","","كتاب الأدب"
"26803","(۲۶۸۰۳) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْتَمِسُوا الْمَعْرُوفَ عِنْدَ حِسَانِ الْوُجُوہِ۔ (طبرانی ۹۸۳)","","Musannaf Ibn Abi Shaybah 26803","","","كتاب الأدب"
"26804","(۲۶۸۰۴) حَدَّثَنَا وَکِیعٌ، عَنِ ابْنِ عَوْنٍ، عَنْ إبْرَاہِیمَ قَالَ: کَانُوا یَکْرَہُونَ إذَا اجْتَمَعُوا أَنْ یُخْرِجَ الرَّجُلُ أَحْسَنَ حَدِیثِہِ۔","","Musannaf Ibn Abi Shaybah 26804","","","كتاب الأدب"
"26805","(۲۶۸۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ عُمَرُ : مَا تَعَلَّمَ الرَّجُلُ الْفَارِسِیَّۃَ إلاَّ خَبث ، وَلاَ خَبث إلاَّ نَقَصَتْ مُرُوئَتُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 26805","","","كتاب الأدب"
"26806","(۲۶۸۰۶) حَدَّثَنَا وَکِیعٌ ، عَن ثَوْرٍ ، عَنْ عَطَائٍ قَالَ : لاَ تَعَلَّمُوا رَطَانَۃَ الأَعَاجِمِ ، وَلاَ تَدْخُلُوا عَلَیْہِمْ کَنَائِسَہُمْ ، فَإِنَّ السَّخَطَۃ تَنْزِلُ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 26806","","","كتاب الأدب"
"26807","(۲۶۸۰۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَن دَاوُد بْنِ أَبِی ہِنْدٍ ، أَنَّ مُحَمَّدَ بْنَ سَعْدِ بْنِ أَبِی وَقَّاصٍ سَمِعَ قَوْمًا یَتَکَلَّمُونَ بِالْفَارِسِیَّۃِ فَقَالَ : مَا بَالُ الْمَجُوسِیَّۃِ بَعْدَ الْحَنِیفِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 26807","","","كتاب الأدب"
"26808","(۲۶۸۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خَلْدَۃَ قَالَ : کَلَّمَنِی أَبُو الْعَالِیَۃِ بِالْفَارِسِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 26808","","","كتاب الأدب"
"26809","(۲۶۸۰۹) حَدَّثَنَا وَکِیعٌ ، عَنِ النَّہَّاسِ بْنِ قَہْمٍ ، قَالَ : سَمِعْتُ شَیْخًا بِمَکَّۃَ یَقُولُ : أَشْرَفَ أَبُو ہُرَیْرَۃَ مِنْ ہَذَا الْبَابِ عَلَی ہَذَا السُّوقِ فَقَالَ : یَا بَنِی فَرُّوخَ ، سحت وداست۔","Da'if","Musannaf Ibn Abi Shaybah 26809","","","كتاب الأدب"
"26810","(۲۶۸۱۰) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَن مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِتَمْرٍ مِنَ الصَّدَقَۃِ ، فَتَنَاوَلَ الْحَسَنُ بْنُ عَلِیٍّ تَمْرَۃً فَلاَکَہَا فِی فِیہِ ، فَقَالَ لَہُ : النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کِخْ کِخْ ، لاَ تَحِلُّ لَنَا الصَّدَقَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 26810","","","كتاب الأدب"
"26811","(۲۶۸۱۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَن مُنْذِرٍ الثَّوْرِیِّ قَالَ : سَأَلَ رَجُلٌ ابْنَ الْحَنَفِیَّۃِ ، عَنِ الْجُبْنِ فَقَالَ: یَا جَارِیَۃُ، اذْہَبِی بِہَذَا الدِّرْہَمِ فَاشْتَرِی بِہِ ینیرا، فَاشْتَرَتْ بِہِ ینیرا، ثُمَّ جَائَتْ بِہِ یَعْنِی الْجُبْنَ۔","","Musannaf Ibn Abi Shaybah 26811","","","كتاب الأدب"
"26812","(۲۶۸۱۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن بُرْدٍ ، عَنِ الزُّہْرِیِّ قِیلَ لَہُ : أَیَکْتَنِی الرَّجُلُ قَبْلَ أَنْ یُولَدَ لَہُ ؟ قَالَ : کَانَ رِجَالٌ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَکْتَنُوا قَبْلَ أَنْ یُولَدَ لَہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 26812","","","كتاب الأدب"
"26813","(۲۶۸۱۳) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ قَالَ: کَنَّانِی عَبْدُ اللہِ بِأَبِی شِبْلٍ، وَکَانَ عَلْقَمَۃُ لاَ یُولَدُ لَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26813","","","كتاب الأدب"
"26814","(۲۶۸۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ الأَسَدِیُّ ، عَنْ أَبِی عَوَانَۃَ ، عَن ہِلاَلِ بْنِ أَبِی حُمَیْدٍ قَالَ : کَنَّانِی عُرْوَۃُ قَبْلَ أَنْ یُولَدَ لِی۔","","Musannaf Ibn Abi Shaybah 26814","","","كتاب الأدب"
"26815","(۲۶۸۱۵) حَدَّثَنَا وَکِیعٌ ، عَن ہِشَامٍ ، عَن مَوْلًی لِلزُّبَیْرِ ، عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتْ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا رَسُولَ اللہِ ، کُلُّ أَزْوَاجِکَ قَدْ کَنَّیْتہ غَیْرِی ، قَالَ : فَأَنْتِ أُمُّ عَبْدِ اللہِ۔ (بخاری ۸۵۱۔ ابوداؤد ۴۹۳۱)","Da'if","Musannaf Ibn Abi Shaybah 26815","","","كتاب الأدب"
"26816","(۲۶۸۱۶) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ قَالَ : حدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَن حَمْزَۃَ بْنِ صُہَیْبٍ ، أَنَّ عُمَرَ قَالَ لِصُہَیْبٍ : مَا لَکَ تَکْتَنِی بِأَبِی یَحْیَی وَلَیْسَ لَکَ وَلَدٌ ؟ قَالَ : کَنَّانِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِأَبِی یَحْیَی۔ (ابن ماجہ ۳۷۳۸۔ احمد ۱۶)","Da'if","Musannaf Ibn Abi Shaybah 26816","","","كتاب الأدب"
"26817","(۲۶۸۱۷) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَنْ أَبِی التَّیَّاحِ ، عَنْ أَنَسٍ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْتِینَا ، فَکَانَ یَقُولُ لأَخٍ لِی صَغِیرٍ : یَا أَبَا عُمَیْرٍ ، مَا فَعَلَ النُّغَیْرُ ؟۔","Sahih","Musannaf Ibn Abi Shaybah 26817","","","كتاب الأدب"
"26818","(۲۶۸۱۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : لاَ بَأْسَ أَنْ یَکْتَنِیَ الرَّجُلُ قَبْلَ أَنْ یُولَدَ لَہُ۔","","Musannaf Ibn Abi Shaybah 26818","","","كتاب الأدب"
"26819","(۲۶۸۱۹) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن شَیْخٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، أَوْ جَابِرًا قَالَ : کَانَ فِی کَلاَمِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَرْتِیلٌ ، أَوْ تَرْسِیلٌ۔ (ابوداؤد ۴۸۰۵)","Da'if","Musannaf Ibn Abi Shaybah 26819","","","كتاب الأدب"
"26820","(۲۶۸۲۰) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِی الْعُمَیْسِ، عَنْ عَطِیَّۃَ، عَنِ ابْنِ عُمَرَ قَالَ: الإنْبِعَاق فِی الْکَلاَمِ مِنْ شَقَاشِقِ الشَّیْطَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 26820","","","كتاب الأدب"
"26821","(۲۶۸۲۱) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن أُسَامَۃَ ، عَنِ الزُّہْرِیِّ ، عَن عُرْوَۃَ ، عَنْ عَائِشَۃَ رضی اللہ عنہا قَالَتْ : کَانَ کَلاَمُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَلاَمًا فَصْلاً ، یَفْہَمُہُ کُلُّ مَنْ سَمِعَہُ۔ n(ابوداؤد ۴۸۰۶۔ ترمذی ۳۶۳۹)","Hasan","Musannaf Ibn Abi Shaybah 26821","","","كتاب الأدب"
"26822","(۲۶۸۲۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا نَافِعُ بْنُ عُمَرَ الْجُمَحِیُّ ، عَن بِشْرِ بْنِ عَاصِمٍ ، عَنْ أبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو - قَالَ نَافِعٌ : أُرَاہُ رَفَعَہُ - قَالَ : إنَّ اللَّہَ یَبْغُضُ الْبَلِیغَ مِنَ الرِّجَالِ الَّذِی یَتَخَلَّلُ بِلِسَانِہِ تَخَلُّلَ الْبَاقِرَۃِ بِلِسَانِہَا۔ (ابوداؤد ۴۹۶۶۔ ترمذی ۲۸۵۳)","Hasan","Musannaf Ibn Abi Shaybah 26822","","","كتاب الأدب"
"26823","(۲۶۸۲۳) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ قَالَ : قَامَ رَجُلٌ فَتَکَلَّمَ بَیْنَ یَدَیِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی أَزْبَدَ شِدْقَاہُ فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَعَلَّمُوا ، وَإِیَّاکُمْ وَشَقَاشِقَ الْکَلاَمِ ، فَإِنَّ شَقَاشِقَ الْکَلاَمِ مِنَ شَقَائِقِ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 26823","","","كتاب الأدب"
"26824","(۲۶۸۲۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَن یَزِیدَ، عَنْ أَبِی جَعْفَرٍ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُسْمِعَ الْمُبْتَلَی التَّعْوِیذَ مِنَ الْبَلاَئِ۔","","Musannaf Ibn Abi Shaybah 26824","","","كتاب الأدب"
"26825","(۲۶۸۲۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَن مُجَاہِدٍ قَالَ : کَانَ یَکْرَہُ أَنْ یَقُولَ اللَّہُمَّ لاَ تَبْتَلِنِی إلاَّ بِالَّتِی ہِیَ أَحْسَنُ وَیَقُولُ : قَالَ اللَّہُ تَعَالَی : (وَنَبْلُوکُمْ بِالشَّرِّ وَالْخَیْرِ فِتْنَۃً)۔","","Musannaf Ibn Abi Shaybah 26825","","","كتاب الأدب"
"26826","(۲۶۸۲۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ، عَن مَعْمَرٍ، عَنِ ابْنِ طَاوُوس، عَنْ أَبِیہِ، أَنَّہُ کَانَ إذَا اجْتَمَعَتْ عَندَہُ الرَّسَائِلُ أَمَرَ بِہَا فَأُحْرِقَتْ۔","","Musannaf Ibn Abi Shaybah 26826","","","كتاب الأدب"
"26827","(۲۶۸۲۷) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ النُّعْمَانِ بْنِ قَیْسٍ ، أَنَّ عَبِیدَۃَ أَوْصَی أَنْ تُمْحَی کُتُبُہُ۔","","Musannaf Ibn Abi Shaybah 26827","","","كتاب الأدب"
"26828","(۲۶۸۲۸) حَدَّثَنَا مُعْتَمِرٌ ، عَن کَہْمَسٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمِ بْنِ یَسَارٍ ، عَن مُسْلِمِ بْنِ یَسَارٍ قَالَ : کَانَ إذَا جَائَہُ الْکِتَابُ مَحَا مَا کَانَ فِیہِ مِنْ ذِکْرِ اللہِ ، ثُمَّ أَلْقَاہُ۔","","Musannaf Ibn Abi Shaybah 26828","","","كتاب الأدب"
"26829","(۲۶۸۲۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ جَامِعِ بْنِ شَدَّادٍ ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ قَالَ : أُتِیَ عَبْدَ اللہِ بِصَحِیفَۃٍ فِیہَا حَدِیثٌ ، فَأَتَی بِمَائٍ فَمَحَاہَا ، ثُمَّ غَسَلَہَا ، ثُمَّ أَمَرَ بِہَا فَأُحْرِقَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 26829","","","كتاب الأدب"
"26830","(۲۶۸۳۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : قُلْتُ لِعَبِیدَۃَ : وَجَدْت کِتَابًا أَقْرَؤُہُ ؟ قَالَ : لاَ۔ (ابوداؤد ۱۴۸۰)","","Musannaf Ibn Abi Shaybah 26830","","","كتاب الأدب"
"26831","(۲۶۸۳۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْوَلِیدِ بْنِ ثَعْلَبَۃَ الطَّائِیِّ ، عَنِ الضَّحَّاکِ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُکْتَبَ الْحَدِیثُ فِی الْکَرَارِیسِ۔","","Musannaf Ibn Abi Shaybah 26831","","","كتاب الأدب"
"26832","(۲۶۸۳۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الْوَلِیدِ بْنِ ثَعْلَبَۃَ ، عَنْ عَبْدِ اللہِ مُؤَذِّنِ الضَّحَّاکِ ، عَنِ الضَّحَّاکِ قَالَ : لاَ تَتَّخِذُوا لِلْحَدِیثِ کَرَارِیسَ کَکَرَارِیسِ الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 26832","","","كتاب الأدب"
"26833","(۲۶۸۳۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَرِہَ الْکَرَارِیسَ۔","","Musannaf Ibn Abi Shaybah 26833","","","كتاب الأدب"
"26834","(۲۶۸۳۴) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِی عَوَانَۃَ، عَن سُلَیْمَانَ بْنِ أَبِی الْعَتِیکِ، عَنْ أَبِی مَعْشَرٍ، عَنْ إبْرَاہِیمَ، أَنَّہُ کَرِہَہَا۔","","Musannaf Ibn Abi Shaybah 26834","","","كتاب الأدب"
"26835","(۲۶۸۳۵) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَن عِیسَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ تَسُبُّوا اللَّیْلَ، وَلاَ النَّہَارَ، وَلاَ الشَّمْسَ، وَلاَ الْقَمَرَ، وَلاَ الرِّیحَ، فَإِنَّہَا تُبْعَثُ عَذَابًا عَلَی قَوْمٍ ، وَرَحْمَۃً عَلَی آخَرِینَ۔ (ابویعلی ۲۱۹۱)","Da'if","Musannaf Ibn Abi Shaybah 26835","","","كتاب الأدب"
"26836","(۲۶۸۳۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ قَالَ : حدَّثَنَا ثَابِتٌ الزُّرَقِیُّ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَسُبُّوا الرِّیحَ فَإِنَّہَا مِنْ رُوحِ اللہِ ، تَأْتِی بِالرَّحْمَۃِ وَالْعَذَابِ ، وَلَکِنْ سَلُوا اللَّہَ مِنْ خَیْرِہَا ، وَتَعَوَّذُوا بِاللَّہِ مِنْ شَرِّہَا۔ (ابوداؤد ۵۰۵۶۔ احمد ۲۶۸)","Sahih","Musannaf Ibn Abi Shaybah 26836","","","كتاب الأدب"
"26837","(۲۶۸۳۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنِ الْحَسَنِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ فِی سَیْرٍ ، فَہَبَّتْ رِیحٌ ، فَکَشَفَتْ عَن رَجُلٍ قَطِیفَۃً کَانَتْ عَلَیْہِ ، فَلَعَنَہَا فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ألَعَنْتہَا ؟ قَالَ : یَا رَسُولَ اللہِ ، کَشَفَتْ قَطِیفَتِی ، فَقَالَ : إذَا رَأَیْتہَا فَسَلِ اللَّہَ مِنْ خَیْرِہَا ، وَتَعَوَّذْ بِاللَّہِ مِنْ شَرِّہَا ، وَلاَ تَلْعَنْہَا فَإِنَّہَا مَأْمُورَۃٌ۔ (ابوداؤد ۴۸۷۲۔ ترمذی ۱۹۷۸)","Hasan","Musannaf Ibn Abi Shaybah 26837","","","كتاب الأدب"
"26838","(۲۶۸۳۸) حَدَّثَنَا شَبَابَۃُ قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْہَیْثمِ قَالَ : رَأَی عَاصِمُ بْنُ ضَمْرَۃَ قَوْمًا یَتَّبِعُونَ رَجُلاً فَقَالَ : إِنَّہَا فِتْنَۃٌ لِلْمَتْبُوعِ مَذَلَّۃٌ لِلتَّابِعِ۔","","Musannaf Ibn Abi Shaybah 26838","","","كتاب الأدب"
"26839","(۲۶۸۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ قَالَ : تَبعَ ابْنَ مَسْعُودٍ نَاسٌ فَجَعَلُوا یَمْشُونَ خَلْفَہُ فَقَالَ : أَلَکُمْ حَاجَۃٌ ؟ قَالُوا : لاَ ، قَالَ : ارْجِعُوا فَإِنَّہَا ذِلَّۃٌ لِلتَّابِعِ فِتْنَۃٌ لِلْمَتْبوعِ۔","","Musannaf Ibn Abi Shaybah 26839","","","كتاب الأدب"
"26840","(۲۶۸۴۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن ہَارُونَ بْنِ عَنتَرَۃَ ، عَن سُلَیْمِ بْنِ حَنْظَلَۃَ قَالَ : أَتَیْنَا أُبَیَّ بْنَ کَعْبٍ لِنَتَحَدَّثَ عِندَہُ ، فَلَمَّا قَامَ قُمْنَا نَمْشِی مَعَہُ ، فَلَحِقَہُ عُمَرُ فَرَفَعَ عَلَیْہِ الدِّرَّۃَ فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، اعْلَمْ مَا تَصْنَعُ ؟ قَالَ : إنَّمَا تَرَی فِتْنَۃً لِلْمَتْبُوعِ ذِلَّۃً لِلتَّابِعِ۔","Hasan","Musannaf Ibn Abi Shaybah 26840","","","كتاب الأدب"
"26841","(۲۶۸۴۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَاصِمٍ قَالَ : لَم یَکُن ابن سِرِین یَتْرک أَحَدًا یَمشِی مَعَہُ۔","","Musannaf Ibn Abi Shaybah 26841","","","كتاب الأدب"
"26842","(۲۶۸۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَاصِمٍ قَالَ : کَانَ أَبُو الْعَالِیَۃِ إذَا جَلَسَ إلَیْہِ أَکْثَرُ مِنْ أَرْبَعَۃٍ قَامَ۔","","Musannaf Ibn Abi Shaybah 26842","","","كتاب الأدب"
"26843","(۲۶۸۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن مُصْعَبِ بْنِ سَعْدٍ ، عَن سَعْدٍ قَالَ : یَا بَنِیَّ ، تَعَلَّمُوا الرَّمْیَ فَإِنَّہُ خَیْرُ لَعِبِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 26843","","","كتاب الأدب"
"26844","(۲۶۸۴۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَن مُحَمَّدِ بْنِ إِسْحَاقَ، عَن مُحَمَّدِ بْنِ إبْرَاہِیمَ، عَن رَافِعِ بْنِ سَالِمٍ الْفَزَارِیِّ قَالَ: مَرَّ عُمَرُ بْنُ الْخَطَّابِ بِنَا فَقَالَ : ارْمُوا ، فَإِنَّ الرَّمْیَ عُدَّۃٌ وَجَلاَدَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 26844","","","كتاب الأدب"
"26845","(۲۶۸۴۵) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَن طَلْحَۃَ بْنِ یَحْیَی ، عَنْ أَبِی بُرْدَۃَ قَالَ : قَالَ سَعِیدُ بْنُ الْعَاصِ : إذَا عَلَّمْت وَلَدِی الْقُرْآنَ وَأَحْجَجْتُہُ وَزَوَّجْتہ ، فَقَدْ قَضَیْت حَقَّہُ ، وَبَقِیَ حَقِّی عَلَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 26845","","","كتاب الأدب"
"26846","(۲۶۸۴۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ قَالَ : لاَ تَحْضُرُ الْمَلاَئِکَۃُ شَیْئًا مِنْ لَہْوِکُمْ غَیْرَ الرِّہَانِ وَالرَّمْیِ ، نِعْمَ مُلْتَہَی الْمُؤْمِنِ الْقَوْسُ وَالنَّبْلُ۔","","Musannaf Ibn Abi Shaybah 26846","","","كتاب الأدب"
"26847","(۲۶۸۴۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَن حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ عَلَی أُنَاسٍ من أَسْلم یَرْمُونَ فَقَالَ : خُذُوا وَأَنَا مَعَ ابْنِ الأَدْرَعِ ، فَقَالُوا : یَا رَسُولَ اللہِ ، نَأْخُذُ وَأَنْتَ مَعَ بَعْضِنَا دُونَ بَعْضٍ ، فَقَالَ : خُذُوا وَأَنَا مَعَکُمْ یَا بَنِی إسْمَاعِیلَ۔ (بخاری ۲۸۹۹۔ احمد ۴/۵۰)","","Musannaf Ibn Abi Shaybah 26847","","","كتاب الأدب"
"26848","(۲۶۸۴۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ عَبْدِاللہِ بْنِ سَعِیدٍ، عَنْ أَبِیہِ، عَنِ ابن أَبِی حَدْرَدٍ الأَسْلَمِیِّ قَالَ: مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَاسٍ مِنْ أَسْلَمَ وَہُمْ یَتَنَاضَلُونَ فَقَالَ: ارْمُوا یَا بَنِی إسْمَاعِیلَ، فَإِنَّ أَبَاکُمْ کَانَ رَامِیًا، ارْمُوا وَأَنَا مَعَ ابْنِ الأَدْرَعِ، فَأَمْسَکَ الْقَوْمُ بِأَیْدِیہِمْ فَقَالَ: مَا لَکُمْ لاَ تَرْمُونَ؟ قَالُوا: یَا رَسُولَ اللہِ، أَنَرْمِی وَقَدْ قُلْتَ: أَنَا مَعَ ابْنِ الأَدْرَعِ ، وَقَدْ عَلِمْنَا أَنَّ حِزْبَک لاَ یُغْلَبُ؟ قَالَ: ارْمُوا وَأَنَا مَعَکُمْ کُلِّکُمْ۔ (مسند ۶۲۹)","Da'if","Musannaf Ibn Abi Shaybah 26848","","","كتاب الأدب"
"26849","(۲۶۸۴۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ أَبِیہِ ، عَن رَجُلٍ مِنْ أَسْلَمَ یُقَالُ لَہُ ابْنُ الأَدْرَعِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَمَعْدَدُوا وَاخْشَوْشِنُوا وَانْتَضِلُوا وَامْشُوا حُفَاۃً۔ (طبرانی ۸۴)","Da'if","Musannaf Ibn Abi Shaybah 26849","","","كتاب الأدب"
"26850","(۲۶۸۵۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا الدَّسْتَوَائِیُّ ، عَن یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلاَّمٍ ، عَنْ عَبْدِ اللہِ بْنِ الأَزْرَقِ ، عَن عُقْبَۃَ بْنِ عَامِرٍ الْجُہَنِیِّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إنَّ اللَّہَ لَیُدْخِلُ بِالسَّہْمِ الْوَاحِدِ الثَّلاَثَۃَ الْجَنَّۃَ : صَانِعَہُ یَحْتَسِبُ فِی صَنْعَتِہِ الْخَیْرَ ، وَالرَّامِیَ بِہِ ، وَالْمُمِدَّ بِہِ ، وَقَالَ : ارْمُوا وَارْکَبُوا، وَإِنْ تَرْمُوا أَحَبُّ إلَیَّ مِنْ أَنْ تَرْکَبُوا ، وَکُلُّ مَا یَلْہُو بِہِ الْمَرْئُ الْمُسْلِمُ بَاطِلٌ إلاَّ رَمْیَہُ بِقَوْسِہِ ، وَتَأْدِیبَہُ فَرَسَہُ، وَمُلاَعَبَتَہُ أَہْلَہُ ، فَإِنَّہُنَّ مِنَ الْحَقِّ۔","Da'if","Musannaf Ibn Abi Shaybah 26850","","","كتاب الأدب"
"26851","(۲۶۸۵۱) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ قَالَ : حدَّثَنَا أَبُو سَلاَّمٍ الدِّمَشْقِیُّ ، عَن خَالِدِ بْنِ زَیْدٍ الْجُہَنِیِّ ، عَن عُقْبَۃَ بْنِ عَامِرٍ ، عَن رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَہُ نَحْوَہُ إلاَّ أَنَّہُ قَالَ : وَمُنَبِّلَہُ۔ (ابوداؤد ۲۵۰۵۔ احمد ۴/۱۴۶)","Da'if","Musannaf Ibn Abi Shaybah 26851","","","كتاب الأدب"
"26852","(۲۶۸۵۲) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ الأَوْزَاعِیِّ ، عَن بِلاَلِ بْنِ سَعْدٍ قَالَ : أَدْرَکْتہمْ یَشْتَدُّونَ بَیْنَ الأَغْرَاضِ وَیَضْحَکُ بَعْضُہُمْ إلَی بَعْضٍ ، فَإِذَا کَانَ اللَّیْلُ کَانُوا رُہْبَانًا۔","Sahih","Musannaf Ibn Abi Shaybah 26852","","","كتاب الأدب"
"26853","(۲۶۸۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ، عَنْ أَبِیہِ قَالَ: رَأَیْتُ حُذَیْفَۃَ یَشْتدُّ بَیْنَ الْہَدَفَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 26853","","","كتاب الأدب"
"26854","(۲۶۸۵۴) حَدَّثَنَا أَبُو بَکْر بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَدَبَّسِ ، قَالَ : سَمِعْتُ عُمَرَ یَقُولُ : أَخِیفُوا الْہَوَامَّ قَبْلَ أَنْ تُخِیفَکُمْ ، وَانْتَضِلُوا وَتَمَعْدَدُوا وَاخْشَوْشِنُوا وَاجْعَلُوا الرَّأْسَ رَأْسَیْنِ ، وَفَرِّقُوا عَنِ الْمَنِیَّۃِ ، وَلاَ تُلِثُّوا بِدَارٍ مُعْجِزَۃٍ ، وَأَخِیفُوا الْحَیَّاتِ قَبْلَ أَنْ تُخِیفَکُمْ وَأَصْلِحُوا مَثَاوِیَکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 26854","","","كتاب الأدب"
"26855","(۲۶۸۵۵) حَدَّثَنَا زِیَادُ بْنُ الرَّبِیعِ ، عَن یُونُسَ بْنِ عُبَیْدٍ ، عَنْ أَبِی قِلاَبَۃَ ، أَنَّ ابْنَ عَبَّاسٍ کَانَ إذَا خَرَجَ مِنْ بَیْتِہِ إلَی الْمَسْجِدِ عَرَفَ جِیرَانُ الطَّرِیقِ ، أَنَّہُ قَدْ مَرَّ مِنْ طِیبِ رِیحِہِ۔","","Musannaf Ibn Abi Shaybah 26855","","","كتاب الأدب"
"26856","(۲۶۸۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ : کَانَ عَبْدُ اللہِ یَتَطَیَّبُ بِطِیبٍ فِیہِ مِسْکٌ۔","","Musannaf Ibn Abi Shaybah 26856","","","كتاب الأدب"
"26857","(۲۶۸۵۷) حَدَّثَنَا عَلِیُّ بْنُ حَفْصٍ قَالَ : أَخْبَرَنَا ابْنُ أَبِی ذِئْبٍ ، عَن عُثْمَانَ بْنِ عُبَیْدِ اللہِ مَوْلًی لِسَعْدِ بْنِ أَبِی وَقَّاصٍ قَالَ : رَأَیْتُ ابْنَ عُمَرَ وَأَبَا ہُرَیْرَۃَ وَأَبَا قَتَادَۃَ وَأَبَا أُسَیْدَ السَّاعِدِیَّ یَمُرُّونَ عَلَیْنَا وَنَحْنُ فِی الْکُتَّابِ فَنَجِدُ مِنْہُمْ رِیحَ الْعَبِیرِ وَہُوَ الْخَلُوقُ۔","Da'if","Musannaf Ibn Abi Shaybah 26857","","","كتاب الأدب"
"26858","(۲۶۸۵۸) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعْرَفُ بِرِیحِ الطِّیبِ إذَا أَقْبَلَ۔ (عبدالرزاق ۷۹۳۴۔ ابن سعد ۳۹۸)","","Musannaf Ibn Abi Shaybah 26858","","","كتاب الأدب"
"26859","(۲۶۸۵۹) حَدَّثَنَا وَکِیعٌ ، عَن مِسْعَرٍ ، عَن مُحَمَّدِ بْنِ جُحَادَۃَ ، عَن طَلْحَۃَ بْنِ مُصَرِّفٍ قَالَ : کَانَ ابْنُ مَسْعُودٍ یُعْرَفُ بِرِیحِ الطِّیبِ۔","","Musannaf Ibn Abi Shaybah 26859","","","كتاب الأدب"
"26860","(۲۶۸۶۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَن سُلَیْمَانَ بْنِ مِینَائَ ، عَن نُفَیْعٍ مَوْلَی عَبْدِ اللہِ قَالَ : کَانَ عَبْدُ اللہِ مِنْ أَطْیَبِ النَّاسِ رِیحًا ، وَأَنْقَاہُمْ ثَوْبًا أَبْیَضَ۔","Da'if","Musannaf Ibn Abi Shaybah 26860","","","كتاب الأدب"
"26861","(۲۶۸۶۱) حَدَّثَنَا وَکِیعٌ ، عَن مُحَمَّدِ بْنِ قَیْسٍ ، عَنِ الشَّعْبِیِّ قَالَ : کَانَ عَبْدُ اللہِ بْنُ جَعْفَرٍ یَسْحَقُ الْمِسْکَ ، ثُمَّ جَعَلَہُ عَلَی یَافُوخِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 26861","","","كتاب الأدب"
"26862","(۲۶۸۶۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ خَرَجَ یَوْمَ عِیدٍ ، فَمَرَّ بِالنِّسَائِ ، فَوَجَدَ رِیحَ رَأْسِ امْرَأَۃٍ فَقَالَ : مَنْ صَاحِبَۃُ ہَذَا ؟ أَمَا لَوْ عَرَفْتہَا لَفَعَلْت وَفَعَلْت ، إنَّمَا تَطَیَّبُ الْمَرْأَۃُ لِزَوْجِہَا، فَإِذَا خَرَجَتْ لَبِسَتْ أُطَیْمِرَہَا ، أَوْ أُطَیْمِرَ خَادِمِہَا ، فَتَحَدَّثَ النِّسَائُ ، أَنَّہَا قَامَتْ عَن حَدَثٍ۔","","Musannaf Ibn Abi Shaybah 26862","","","كتاب الأدب"
"26863","(۲۶۸۶۳) حَدَّثَنَا وَکِیعٌ ، عَن ثَابِتِ بْنِ عُمَارَۃَ ، عَن غُنَیْمِ بْنِ قَیْسٍ ، عَنْ أَبِی مُوسَی قَالَ : أَیُّمَا امْرَأَۃٍ استعْطرَتْ ، ثُمَّ خَرَجَتْ لتُوجَدَ رِیحُہَا فَہِی فَاعِلَۃ ، وَکُل عَین فَاعِلَۃ۔","Sahih","Musannaf Ibn Abi Shaybah 26863","","","كتاب الأدب"
"26864","(۲۶۸۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانُ ، عَنْ عَاصِمِ بْنِ عُبَیْدِ اللہِ ، عَنْ عُبَیْدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَیُّمَا امْرَأَۃٍ تَطَیَّبَتْ ثُمَّ خَرَجَتْ إلَی الْمَسْجِدِ لِیُوجَدَ رِیحُہَا ، لَمْ تُقْبَلْ لَہَا صَلاَۃٌ حَتَّی تَغْتَسِلَ اغْتِسَالَہَا مِنَ الْجَنَابَۃِ۔ (ابوداؤد ۴۱۷۱۔ احمد ۲/۲۴۶)","Da'if","Musannaf Ibn Abi Shaybah 26864","","","كتاب الأدب"
"26865","(۲۶۸۶۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن مُحَمَّدِ بْنِ عَجْلاَنَ ، عَن یَعْقُوبَ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَن بُسْرِ بْنِ سَعِیدٍ ، عَن زَیْنَبَ امْرَأَۃِ عَبْدِ اللہِ قَالَتْ : قَالَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا خَرَجَتْ إحْدَاکُنَّ إلَی الْمَسْجِدِ فَلاَ تَمَسَّ طِیبًا۔ (مسلم ۳۲۸۔ احمد ۶/۳۶۳)","Hasan","Musannaf Ibn Abi Shaybah 26865","","","كتاب الأدب"
"26866","(۲۶۸۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْقَاسِمِ بن أَبِی بَزَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ مَسْعُودٍ ، أَنَّہُ وَجَدَ مِنِ امْرَأَتِہِ رِیحَ مِجْمَرٍ وَہِیَ بِمَکَّۃَ ، فَأَقْسَمَ عَلَیْہَا أَلاَ تَخْرُجَ تِلْکَ اللَّیْلَۃَ۔","","Musannaf Ibn Abi Shaybah 26866","","","كتاب الأدب"
"26867","(۲۶۸۶۷) حَدَّثَنَا وَکِیعٌ ، عَن کَثِیرِ بْنِ زَیْدٍ ، عَن عُثْمَانَ بْنِ عَبْدِ اللہِ بْنِ سُرَاقَۃَ ، عَن أُمِّہِ قَالَتْ : نَزَلَ بِی حَمَوِیٌّ فَمَسِسْت طِیبًا ، ثُمَّ خَرَجْت فَأَرْسَلَتْ إلَیَّ حَفْصَۃُ : إنَّمَا الطِّیبُ لِلْفِرَاشِ۔","","Musannaf Ibn Abi Shaybah 26867","","","كتاب الأدب"
"26868","(۲۶۸۶۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، أَنَّ امْرَأَتَہُ اسْتَأْذَنَتْہُ أَنْ تَأْتِیَ أَہْلَہَا ، فَأَذِنَ لَہَا فَوَجَدَ بِہَا رِیحُ دُخْنۃ فحبسہا ، وَقَالَ : إنَّ الْمَرْأَۃَ إذَا تَطَیَّبَتْ ثُمَّ خَرَجَتْ فَإِنَّمَا طِیبُہَا شَنَارٌ فِیہِ نَارٌ۔","","Musannaf Ibn Abi Shaybah 26868","","","كتاب الأدب"
"26869","(۲۶۸۶۹) حَدَّثَنَا وَکِیعٌ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ قَالَ : زَارَتْ أَسْمَائُ أُخْتَہَا عَائِشَۃَ ، وَالزُّبَیْرُ غَائِبٌ ، فَدَخَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَوَجَدَ رِیحَ طِیبٍ فَقَالَ : مَا عَلَی امْرَأَۃٍ أَنْ لاَ تَطَیَّبَ وَزَوْجُہَا غَائِبٌ۔ (طبرانی ۲۸۰)","Da'if","Musannaf Ibn Abi Shaybah 26869","","","كتاب الأدب"
"26870","(۲۶۸۷۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَنِ ابْنِ عَجْلاَنَ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: الإِیمَانُ سِتُّونَ ، أَوْ سَبْعُونَ ، أَوْ بِضْعَۃٌ وَاحِدُ الْعَدَدَیْنِ: أَعْلاَہَا شَہَادَۃُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ ، وَأَدْنَاہَا إمَاطَۃُ الأَذَی عَنِ الطَّرِیقِ ، وَالْحَیَائُ شُعْبَۃٌ مِنَ الإِیمَانِ۔ (بخاری ۹۔ مسلم ۶۳)","Hasan","Musannaf Ibn Abi Shaybah 26870","","","كتاب الأدب"
"26871","(۲۶۸۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبَانَ بْنِ صَمْعَۃَ ، عَنْ أَبِی الْوَازِعِ ، عَنْ أَبِی بَرْزَۃَ قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، دُلَّنِی عَلَی عَمَلٍ أَنْتَفِعُ بِہِ ، قَالَ : نَحِّ الأَذَی عَن طَرِیقِ الْمُسْلِمِینَ۔ (مسلم ۲۰۲۱۔ ابن ماجہ ۳۶۸۱)","Hasan","Musannaf Ibn Abi Shaybah 26871","","","كتاب الأدب"
"26872","(۲۶۸۷۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا جَرِیرُ بْنُ حَازِمٍ قَالَ : حَدَّثَنَا بَشَّارُ بْنُ أَبِی سَیْفٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَن عِیَاضِ بْنِ غُطَیْفٍ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنْ عَادَ مَرِیضًا ، أَوْ أَنْفَقَ عَلَی أَہْلِہِ ، أَوْ مَازَ أَذًی عَن طَرِیقٍ فَحَسَنَۃٌ بِعَشْرَۃِ أَمْثَالِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 26872","","","كتاب الأدب"
"26873","(۲۶۸۷۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ قَالَ : خَرَجَ رَجُلٌ مَعَ مُعَاذٍ ، فَجَعَلَ لاَ یَرَی أَذًی فِی طَرِیقٍ إلاَّ نَحَّاہُ ، فَلَمَّا رَأَی ذَلِکَ الرَّجُلُ جَعَلَ لاَ یَمُرُّ بِشَیْئٍ إلاَّ نَحَّاہُ ، فَقَالَ لَہُ : مَا حَمَلَک عَلَی ہَذَا ؟ قَالَ : الَّذِی رَأَیْتُک تَصْنَعُ ، قَالَ : أَصَبْت ، أَوْ أَحْسَنْت ، إِنَّہُ مَنْ أَمَاطَ أَذًی ، عَن طَرِیقٍ کُتِبَتْ لَہُ حَسَنَۃٌ ، وَمَنْ کُتِبَتْ لَہُ حَسَنَۃٌ دَخَلَ الْجَنَّۃَ۔","","Musannaf Ibn Abi Shaybah 26873","","","كتاب الأدب"
"26874","(۲۶۸۷۴) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : سَمِعْتُ أَبَا ہِلاَلٍ قَالَ : حَدَّثَنَا قَتَادَۃُ ، عَنْ أَنَسٍ قَالَ : کَانَتْ شَجَرَۃٌ عَلَی طَرِیقِ النَّاسِ، فَکَانَتْ تُؤْذِیہِمْ، فَعَزَلَہَا رَجُلٌ، عَن طَرِیقِ النَّاسِ، قَالَ: قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: فَلَقَدْ رَأَیْتہ یَتَقَلَّبُ فِی ظِلِّہَا فِی الْجَنَّۃِ۔ (احمد ۱۵۴۔ ابویعلی ۳۰۴۸)","Hasan","Musannaf Ibn Abi Shaybah 26874","","","كتاب الأدب"
"26875","(۲۶۸۷۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : کَانَ عَلَی طَرِیقٍ غُصْنُ شَجَرَۃٍ یُؤْذِی النَّاسَ ، فَأَمَاطَہَا رَجُلٌ فَأُدْخِلَ الْجَنَّۃَ۔ (ابن ماجہ ۳۶۸۲)","Sahih","Musannaf Ibn Abi Shaybah 26875","","","كتاب الأدب"
"26876","(۲۶۸۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانَ ، عَن وَاصِلٍ مَوْلَی أَبِی عُیَیْنَۃَ ، عَن یَحْیَی بْنِ عَقِیلٍ، عَن یَحْیَی بْنِ یَعْمُرَ، عَنْ أَبِی ذَرٍّ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: عُرِضَتْ عَلَیَّ أُمَّتِی بِأَعْمَالِہَا، حَسَنِہَا وَسَیِّئِہَا ، فَرَأَیْت فِی مَحَاسِنِ أَعْمَالِہَا الأَذَی یُنَحَّی عَنِ الطَّرِیقِ ، وَرَأَیْت فِی سَیِّیء أَعْمَالِہَا النُّخَامَۃُ فِی الْمَسْجِدِ لاَ تُدْفَنُ۔ (مسلم ۳۹۰۔ احمد ۵/۱۸۰)","Hasan","Musannaf Ibn Abi Shaybah 26876","","","كتاب الأدب"
"26877","(۲۶۸۷۷) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : حدَّثَنَا إسْمَاعِیلُ بن قَیْسٍ ، قَالَ : سَمِعْتُ سَعْدًا یَقُولُ : اتَّقُوا ہَذِی الْمُلاَعِن ، ثُمَّ قَالَ إسْمَاعِیلُ : یَعْنِی التَّحَشُّشَ عَلَی ظَہْرِ الطَّرِیقِ۔","Sahih","Musannaf Ibn Abi Shaybah 26877","","","كتاب الأدب"
"26878","(۲۶۸۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : إیَّاکُمْ وَالْمُلاَعن ، قَالُوا : وَمَا الْمُلاَعِنُ ؟ قَالَ : قَارِعَۃُ الْجُلُوسِ عَلَی الطَّرِیقِ وَتَحْتَ الشَّجَرَۃِ یَسْتَظِلُّ تَحْتَہَا الرَّاکِبُ۔n(مسلم ۲۲۶۔ ابوداؤد ۲۶)","Sahih","Musannaf Ibn Abi Shaybah 26878","","","كتاب الأدب"
"26879","(۲۶۸۷۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، عَنْ جَابِرٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَنْزِلُوا عَلَی جَوَادِّ الطَّرِیقِ ، وَلاَ تَقْضُوا عَلَیْہَا الْحَاجَاتِ۔","Sahih","Musannaf Ibn Abi Shaybah 26879","","","كتاب الأدب"
"26880","(۲۶۸۸۰) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَن خُلَیْدِ بْنِ جَعْفَرٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَکَرَ الْمِسْکُ فَقَالَ : ہُوَ أَطْیَبُ طِیبِکُمْ۔ (مسلم ۱۷۶۶)","Sahih","Musannaf Ibn Abi Shaybah 26880","","","كتاب الأدب"
"26881","(۲۶۸۸۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَن ابْنِ سِیرِینَ ، عَن ابن عُمَر قَالَ : أَطْیَب طیبکم : الْمِسْکَ۔","Sahih","Musannaf Ibn Abi Shaybah 26881","","","كتاب الأدب"
"26882","(۲۶۸۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ ، عَن عُبَیْدٍ مَوْلَی سَلَمَۃَ ، عَن سَلَمَۃَ ، أَنَّہُ کَانَ إذَا تَوَضَّأَ أَخَذَ الْمِسْکَ فَمَسَحَ بِہِ وَجْہَہُ وَیَدَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 26882","","","كتاب الأدب"
"26883","(۲۶۸۸۳) حَدَّثَنَا وَکِیعُ ، عَن مُحَمَّدِ بْنِ قَیْسٍ ، عَنِ الشَّعْبِیِّ قَالَ : کَانَ عَبْدُ اللہِ بْنُ جَعْفَرٍ یَسْحَقُ الْمِسْکَ ، ثُمَّ یَجْعَلُہُ عَلَی یَافُوخِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 26883","","","كتاب الأدب"
"26884","(۲۶۸۸۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ ابْنِ سِیرِینَ قَالَ : لاَ بَأْسَ بِالْمِسْکِ لِلْحَیِّ وَالْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 26884","","","كتاب الأدب"
"26885","(۲۶۸۸۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنِ الضَّحَّاکِ قَالَ : الْمِسْکُ مَیْتَۃٌ وَدَمٌ۔","","Musannaf Ibn Abi Shaybah 26885","","","كتاب الأدب"
"26886","(۲۶۸۸۶) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن لَیْثٍ ، عَن مُجَاہِدٍ ، أَنَّہُ کَرِہَ أَنْ یُجْعَلَ الْمِسْکُ فِی الْمُصْحَفِ۔","","Musannaf Ibn Abi Shaybah 26886","","","كتاب الأدب"
"26887","(۲۶۸۸۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَکْرَہُ الْمِسْکَ لِلْحَیِّ وَالْمَیِّتِ۔","","Musannaf Ibn Abi Shaybah 26887","","","كتاب الأدب"
"26888","(۲۶۸۸۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَن عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ عَلِیِّ بْنِ عُمَارَۃَ قَالَ : جَائَ أَبُو أَیُّوبَ ، فَأَرَادَ أَنْ یَبِیتَ عَلَی سَطْحٍ لَنَا أَجْلَحَ ، قَالَ : کِدْت أَنْ أَبَیْت اللَّیْلَۃَ لاَ ذِمَّۃَ لِی۔","Da'if","Musannaf Ibn Abi Shaybah 26888","","","كتاب الأدب"
"26889","(۲۶۸۸۹) حَدَّثَنَا مَرْوَانُ ، عَنِ الْعَلاَء بْنِ عَبْدِ الرَّحْمَنِ قَالَ : سَأَلْتُ مُجَاہِدًا عَنِ الرَّجُلِ یَنَامُ فَوْقَ السَّطْحِ لَیْسَ عَلَیْہِ حَائِطٌ ، فَقَالَ مُجَاہِدٌ : إنَّمَا قِیلَ ذَاکَ لِمَنْ سَقَطَ فَمَات۔","","Musannaf Ibn Abi Shaybah 26889","","","كتاب الأدب"
"26890","(۲۶۸۹۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَمْرِو بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ أَبِی حُسَیْنٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَقْطَعْ مَنْ کَانَ یَصِلُ أَبَاک ، یُطْفَأْ بِذَلِکَ نُورُک ، إنَّ وِدَّک وِدُّ أَبِیک۔ (مسلم۱۱۔ ابوداؤد ۵۱۰۰)","","Musannaf Ibn Abi Shaybah 26890","","","كتاب الأدب"
"26891","(۲۶۸۹۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن ہَارُونَ بْنِ عَنتَرَۃَ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ قَالَ : قَالَ عَبْدُ اللہِ : صِلْ مَنْ کَانَ أَبُوک یُوَاصِلُ ، فَإِنَّ صِلَۃً للْمَیِّتِ فِی قَبْرِہِ أَنْ تَصِلَ مَنْ کَانَ یُوَاصِلُ۔","","Musannaf Ibn Abi Shaybah 26891","","","كتاب الأدب"
"26892","(۲۶۸۹۲) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَن ثَابِتٍ ، عَن بِلاَلٍ ، عَنْ أَبِیہِ قَالَ : إن مِنْ صِلَۃِ الرَّجُلِ أَبَاہُ أَنْ یَصِلَ إخْوَانَہُ الَّذِینَ کَانَ یَصِلُہُمْ ، قَالَ حَمَّادٌ : أَحْسَبُہُ ، عَنْ أَبِی مُوسَی ، قِیلَ لِحَمَّادٍ : بِلاَلُ بْنُ أَبِی بُرْدَۃَ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 26892","","","كتاب الأدب"
"26893","(۲۶۸۹۳) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ : حدَّثَنَا ہِشَامٌ ، عَنْ أَبِیہِ قَالَ : مَکْتُوبٌ فِی التَّوْرَاۃِ : أَحْبِبْ حَبِیبَک وَحَبِیبَ أَبِیک۔","","Musannaf Ibn Abi Shaybah 26893","","","كتاب الأدب"
"26894","(۲۶۸۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا أَبُو عَقِیلٍ قَالَ : حَدَّثَنَا سَلَمَۃُ بْنُ عَبْدِ اللہِ بْنِ عُمَرَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَالَ : تَرِّبُوا صُحُفَکُمْ أَنْجَحُ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 26894","","","كتاب الأدب"
"26895","(۲۶۸۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا بَقِیَّۃُ قَالَ : حَدَّثَنَا أَبُو أَحْمَدَ الدِّمَشْقِیِّ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : تَرِّبُوا صُحُفَکُمْ أَنْجَحُ لَہَا وَالتُّرَابُ مُبَارَکٌ۔n(ترمذی ۲۷۱۳۔ ابن ماجہ ۳۷۷۴)","Da'if","Musannaf Ibn Abi Shaybah 26895","","","كتاب الأدب"
"26896","(۲۶۸۹۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا أَبُو شَیْبَۃَ ، عَن رَجُلٍ ، عَنِ الشَّعْبِیِّ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَرِّبُوا صُحُفَکُمْ أَعْظَمُ لِلْبَرَکَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 26896","","","كتاب الأدب"
"26897","(۲۶۸۹۷) حَدَّثَنَا شَرِیکٌ ، عَنِ الْعَبَّاسِ بْنِ ذُرَیْحٍ ، عَنِ الشَّعْبِیِّ قَالَ : قَالَ ابْنُ عَبَّاسٍ : إنِّی لأَرَی لِجَوَابِ الْکِتَابِ عَلَیَّ حَقًّا کَرَدِّ السَّلاَمِ۔ (ابن عدی ۱۷۶)","Sahih","Musannaf Ibn Abi Shaybah 26897","","","كتاب الأدب"
"26898","(۲۶۸۹۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنْ عَامِرٍ ، عَنِ ابْنِ عُمَرَ قَالَ : مَا کُنْت أُبَالِی لَوْ کُنْت عَاشِرَ عَشَرَۃٍ عَلَی دَابَّۃٍ بَعْدَ أَنْ تُطِیقَنَا۔","Sahih","Musannaf Ibn Abi Shaybah 26898","","","كتاب الأدب"
"26899","(۲۶۸۹۹) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَن خَالِدٍ ، عَن عِکْرِمَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَلَقَّاہُ غُلاَمَانِ مِنْ بَنِی عَبْدِ الْمُطَّلِبِ ، فَحَمَلَ وَاحِدًا بَیْنَ یَدَیْہِ وَالآخَرَ خَلْفَہُ۔ (عبدالرزاق ۱۹۴۸۲)","","Musannaf Ibn Abi Shaybah 26899","","","كتاب الأدب"
"26900","(۲۶۹۰۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَن حَبِیبِ بْنِ الشَّہِیدِ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ قَالَ : قَالَ عَبْدُ اللہِ بْنُ جَعْفَرٍ لابْنِ الزُّبَیْرِ : أَتَذْکُرُ إذْ تَلَقَّیْنَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَا وَأَنْتَ ، وَابْنُ عَبَّاسٍ ؟ قَالَ : نَعَمْ ، فَحَمَلَنَا وَتَرَکَک۔ (مسلم ۱۸۸۵۔ احمد ۱/۲۰۳)","Sahih","Musannaf Ibn Abi Shaybah 26900","","","كتاب الأدب"
"26901","(۲۶۹۰۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ عَاصِمٍ قَالَ: حدَّثَنَا مُوَرِّقُ الْعِجْلِیّ قَالَ: حَدَّثَنَی عَبْدُ اللہِ بْنُ جَعْفَرٍ قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا قَدِمَ مِنْ سَفَرٍ تُلُقِّیَ بِنَا ، قَالَ: فَتُلُقِّیَ بِی ، وَبِالْحَسَنِ، أَوْ بِالْحُسَیْنِ ، قَالَ : فَحَمَلَ أَحَدَنَا بَیْنَ یَدَیْہِ ، وَالآخَرَ خَلْفَہُ ، حَتَّی دَخَلْنَا الْمَدِینَۃَ۔ (ابوداؤد ۲۵۵۹۔ احمد ۲۰۳)","Hasan","Musannaf Ibn Abi Shaybah 26901","","","كتاب الأدب"
"26902","(۲۶۹۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَن سُفْیَانَ الْعَطَّارِ ، قَالَ : رَأَیْتُ الشَّعْبِیَّ مُرْتَدِفًا خَلْفَ رَجُلٍ ، قَالَ : وَکَانَ یَقُولُ : صَاحِبُ الدَّابَّۃِ أَحَقُّ بِمُقَدَّمِہَا۔","","Musannaf Ibn Abi Shaybah 26902","","","كتاب الأدب"
"26903","(۲۶۹۰۳) حَدَّثَنَا عَبْدُالْوَہَّابِ الثَّقَفِیُّ، عَن خَالِدٍ، عَن مُحَمَّدِ بْنِ سِیرِینَ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَرْکَبَ ثَلاَثَۃٌ عَلَی دَابَّۃٍ۔","","Musannaf Ibn Abi Shaybah 26903","","","كتاب الأدب"
"26904","(۲۶۹۰۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ قَالَ : أَیُّمَا ثَلاَثَۃٍ رَکِبُوا عَلَی دَابَّۃٍ فَأَحَدُہُمْ مَلْعُونٌ۔","","Musannaf Ibn Abi Shaybah 26904","","","كتاب الأدب"
"26905","(۲۶۹۰۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن جِبْرِیلَ بْنِ أَحْمَرَ ، عَنِ ابْنِ بُرَیْدَۃَ قَالَ : رَآنِی أَبِی رِدْفَ ثَالِثٍ فَقَالَ : مَلْعُونٌ۔","Hasan","Musannaf Ibn Abi Shaybah 26905","","","كتاب الأدب"
"26906","(۲۶۹۰۶) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِر ، عَنْ عَامِرٍ قَالَ : خَرَجْتُ إلَی الْحِیرَۃِ أَنْظُرُ إلَی الْفِیلِ ، فَرَأَیْت الْحَارِثَ الأَعْوَرَ رَاکِبًا وَخَلْفَہُ رِدْفٌ ، قَالَ : فَقَالَ : لَوْ صَلُحَ ثَلاَثَۃٌ حَمَلْنَاک۔","","Musannaf Ibn Abi Shaybah 26906","","","كتاب الأدب"
"26907","(۲۶۹۰۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ ، عَن حسن ، عَن مُہَاجِرِ بْنِ قُنْفُذٍ قَالَ : کُنَّا نَتَحَدَّثُ مَعَہُ إذْ مَرَّ ثَلاَثَۃٌ عَلَی حِمَارٍ ، فَقَالَ لِلآخِرِ مِنْہُمْ : انْزِلْ لَعَنَک اللَّہُ ، قَالَ : فَقِیلَ لَہُ : تَلْعَنُ ہَذَا الإِِنْسَان ؟ قَالَ : فَقَالَ : إنَّا قَدْ نُہِینَا عَن ہَذَا : أَنْ یَرْکَبَ الثَّلاَثَۃُ عَلَی الدَّابَّۃِ۔ (طبرانی ۷۸۲)","Da'if","Musannaf Ibn Abi Shaybah 26907","","","كتاب الأدب"
"26908","(۲۶۹۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعَنْبَسِ ، عَن زَاذَانَ قَالَ : رَأَی ثَلاَثَۃً عَلَی بَغْلٍ فَقَالَ لِیَنْزِلْ أَحَدُکُمْ ، فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَعَنَ الثَّالِثَ۔ (ابوداؤد ۲۹۹)","","Musannaf Ibn Abi Shaybah 26908","","","كتاب الأدب"
"26909","(۲۶۹۰۹) حَدَّثَنَا وَکِیعٌ ، عَن بَشِیرِ بْنِ سَلْمَانَ ، عَن سَیَّارِ أَبِی الْحَکَمِ ، عَن طَارِقِ بْنِ شِہَابٍ قَالَ : کَانَ عَبْدُ اللہِ إذَا صَلَّی الْفَجْرَ لَمْ یَدَعْ أَحَدًا مِنْ أَہْلِہِ صَغِیرًا ، وَلاَ کَبِیرًا یُطرِق حَتَّی تَطْلُعَ الشَّمْسُ۔","Sahih","Musannaf Ibn Abi Shaybah 26909","","","كتاب الأدب"
"26910","(۲۶۹۱۰) حَدَّثَنَا وَکِیعٌ ، عَن فُضَیْلِ بْنِ غَزْوَانَ ، عَن مُہَاجِرِ بْنِ شَمَّاسٍ ، عَنْ عَمِّہِ قَالَ : کُنْتُ أَخْرُجُ إلَی جَبَّانَۃٍ مِنْ ہَذِہِ الْجَبَابِینِ أَنْصِبُ بِفَخٍّ لِی ، فَخَرَجْت ثَلاَثَ غَدَوَاتٍ أَرَی رَجُلاً بَعْدَ الْفَجْرِ جَالِسًا فِی مَکَان، قُلْتُ: یَا عَبْدَ اللہِ ، مَنْ أَنْتَ ؟ قَالَ : أَنَا حُذَیْفَۃُ بْنُ الْیَمَانِ ، قَالَ : قُلْتُ : أَیُّ شَیْئٍ تَصْنَعُ ہَاہُنَا ؟ قَالَ : أَنْظُرُ إلَی الشَّمْسِ مِنْ أَیْنَ تَطْلُعُ ؟۔","Da'if","Musannaf Ibn Abi Shaybah 26910","","","كتاب الأدب"
"26911","(۲۶۹۱۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ: حدَّثَنَا إسْمَاعِیلُ قَالَ: حَدَّثَنی قَیْسُ بْنُ أَبِی حَازِمٍ، عَن مُدْرِکِ بْنِ عَوْفٍ قَالَ: مَرَرْت عَلَی بِلاَلٍ وَہُوَ بِالشَّامِ جَالِسٌ غُدْوَۃً، فَقُلْت: مَا یُجلسک یَا أَبَا عَبْدِ اللہِ، قَالَ: أَنْتَظِرُ طُلُوعَ الشَّمْسِ۔","Sahih","Musannaf Ibn Abi Shaybah 26911","","","كتاب الأدب"
"26912","(۲۶۹۱۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن سِمَاکٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا صَلَّی الْفَجْرَ جَلَسَ فِی مُصَلاَّہُ حَتَّی تَطْلُعَ الشَّمْسُ۔","Hasan","Musannaf Ibn Abi Shaybah 26912","","","كتاب الأدب"
"26913","(۲۶۹۱۳) حَدَّثَنَا وَکِیعٌ ، عَن سَلَمَۃَ ، عَنِ الضَّحَّاکِ قَالَ : عَجَبًا لأَصْحَابِ عَبْدِ اللہِ ، إنَّہُمْ یَنْظُرُونَ إلَی الشَّمْسِ مِنْ حَیْثُ تَطْلُعُ ، أَوَلاَ یَعْلَمُونَ أَنَّ الْفَجْرَ إذَا طَلَعَ مِنْ مَوْضِعٍ طَلَعَتْ مِنْہُ الشَّمْسُ۔","","Musannaf Ibn Abi Shaybah 26913","","","كتاب الأدب"
"26914","(۲۶۹۱۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَبِی بِشْرٍ ، عَن جُنْدُبِ بْنِ عَبْدِ اللہِ الْبَجَلِیِّ ، ثُمَّ الْقَسْرِیِّ قَالَ : اسْتَأْذَنْت عَلَی حُذَیْفَۃَ ثَلاَثَ مَرَّاتٍ فَلَمْ یُؤْذَنْ لِی فَرَجَعْت : فَإِذَا رَسُولُہُ قَدْ لَحِقَنِی فَقَالَ : مَا رَدَّک ؟ قُلْتُ : ظَنَنْت أَنَّک نَائِمٌ ؟ قَالَ : مَا کُنْت لأَنَامَ حَتَّی أَنْظُرَ مِنْ أَیْنَ تَطْلُعُ الشَّمْسُ قَالَ : فَحَدَّثْتُ بِہِ مُحَمَّدًا فَقَالَ : قَدْ فَعَلَہُ غَیْرُ وَاحِدٍ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 26914","","","كتاب الأدب"
"26915","(۲۶۹۱۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ قَالَ : لاَ تَبِتْ فِی بَیْتٍ وَحْدَک ، فَإِنَّ الشَّیْطَانَ أَشَدُّ مَا یَکُونُ وَلَعًا۔","","Musannaf Ibn Abi Shaybah 26915","","","كتاب الأدب"
"26916","(۲۶۹۱۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُسَافِرَ الرَّجُلُ وَحْدَہُ ، أَوْ یَبِیتَ فِی بَیْتٍ وَحْدَہُ۔ (ابوداؤد ۳۱۱۔ احمد ۹۱)","","Musannaf Ibn Abi Shaybah 26916","","","كتاب الأدب"
"26917","(۲۶۹۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَاصِمِ بن مُحَمَّد ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ یَعْلَمُ أَحَدُکُمْ مَا فِی الْوَحْدَۃِ مَا سَارَ أَحَدُکُمْ بِاللَّیْلِ۔ (بخاری ۲۹۹۸۔ ترمذی ۱۶۷۳)","Sahih","Musannaf Ibn Abi Shaybah 26917","","","كتاب الأدب"
"26918","(۲۶۹۱۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَنْ أَبِیہِ ، عَن مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ قَالَ : کَانَ أَبِی لاَ یَأْتَمِن عَلَی حَدِیثِہِ أَہْلَہُ ، کَانَ یَخْلُو ہُوَ وَأَصْحَابُہُ فِی غُرْفَۃٍ یَتَحَدَّثُونَ۔","","Musannaf Ibn Abi Shaybah 26918","","","كتاب الأدب"
"26919","(۲۶۹۱۹) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن سَلَمَۃَ ، عَن عِیسَی بْنِ عَاصِمٍ ، عَن زِرٍّ ، عَنْ عَبْدِ اللہِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الطِّیَرَۃُ شِرْکٌ ، الطِّیَرَۃُ شِرْکٌ ، وَمَا مِنَّا إلاَّ ، وَلَکِنَّ اللَّہَ یُذْہِبُہُ بِالتَّوَکُّلِ۔ (ابوداؤد ۳۹۰۵۔ ابن ماجہ ۳۵۳۸)","Sahih","Musannaf Ibn Abi Shaybah 26919","","","كتاب الأدب"
"26920","(۲۶۹۲۰) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَن عُرْوَۃَ بْنِ عَامِرٍ قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الطِّیَرَۃِ فَقَالَ : أَحْسَنُہَا الْفَأْلُ ، وَلاَ تَرُدَّ مُسْلِمًا ، فَإِذَا رَأَی أَحَدُکُمْ مِنْ ذَلِکَ مَا یَکْرَہُ فَلْیَقُلْ : اللَّہُمَّ لاَ یَأْتِی بِالْحَسَنَاتِ ، وَلاَ یَدْفَعُ السَّیِّئَاتِ إلاَّ أَنْتَ ، وَلاَ حَوْلَ وَلاَ قُوَّۃَ إلاَّ بِک۔n(ابوداؤد ۳۹۱۴۔ بیہقی ۱۳۹)","","Musannaf Ibn Abi Shaybah 26920","","","كتاب الأدب"
"26921","(۲۶۹۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جُنَابٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ عَدْوَی ، وَلاَ طِیَرَۃَ ، وَلاَ ہَامَۃَ ، فَقَامَ إلَیْہِ رَجُلٌ فَقَالَ : یَا رَسُولَ اللہِ ، الْبَعِیرُ یَکُونُ بِہِ الْجَرَبُ فَتُجْرَبُ بِہِ الإِبِلُ ؟ قَالَ : ذَلِکَ الْقَدَرُ ، فَمَنْ أَجْرَبَ الأَوَّلَ ؟۔ (بخاری ۵۷۱۷۔ مسلم ۱۷۴۲)","Da'if","Musannaf Ibn Abi Shaybah 26921","","","كتاب الأدب"
"26922","(۲۶۹۲۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن سِمَاکٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ عَدْوَی لاَ طِیَرَۃَ ، وَلاَ ہَامَۃَ وَلاَ صَفَرَ۔ (احمد ۲۲۹)","Hasan","Musannaf Ibn Abi Shaybah 26922","","","كتاب الأدب"
"26923","(۲۶۹۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنِ الْمُضَارِبِ بْنِ حَزْنٍ قَالَ : قُلْتُ لأَبِی ہُرَیْرَۃَ : أَسَمِعْت مِنْ نَبِیِّکَ شَیْئًا فَحَدِّثْنِیہِ ، قَالَ : نَعَمْ ، قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ عَدْوَی ، وَلاَ طِیَرَۃَ ، وَلاَ ہَامَۃَ ، وَخَیْرُ الطِّیَرَۃِ الْفَأْلُ ، وَالْعَیْنُ حَقٌّ۔ (بخاری ۵۷۴۰۔ احمد ۲/۴۸۷)","Hasan","Musannaf Ibn Abi Shaybah 26923","","","كتاب الأدب"
"26924","(۲۶۹۲۴) حَدَّثَنَا عَلِی بْنُ مُسْہِرٍ ، عَن مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُحِبُّ الْفَأْلَ الْحَسَنَ وَیَکْرَہُ الطِّیَرَۃَ۔ (ابن ماجہ ۳۵۳۶۔ ابن حبان ۶۱۲۱)","Hasan","Musannaf Ibn Abi Shaybah 26924","","","كتاب الأدب"
"26925","(۲۶۹۲۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَن قَتَادَۃَ ، عَنْ أَنَسٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ عَدْوَی ، وَلاَ طِیَرَۃَ ، وَأُحِبُّ الْفَأْلَ الصَّالِحَ۔ (بخاری ۵۷۵۶۔ ابن ماجہ ۳۵۳۷)","Sahih","Musannaf Ibn Abi Shaybah 26925","","","كتاب الأدب"
"26926","(۲۶۹۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ قَالَ : قَالَ عَبْدُ اللہِ : لاَ تَضُر الطِّیَرَۃُ إلاَّ مَنْ تَطَیَّرَ۔","","Musannaf Ibn Abi Shaybah 26926","","","كتاب الأدب"
"26927","(۲۶۹۲۷) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ قَالَ : حدَّثَنَا الْفُرَاتُ بْنُ سُلَیمَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَن زِیَادِ بْنِ أَبِی مَرْیَمَ قَالَ : خَرَجَ سَعْدُ بْنُ أَبِی وَقَّاصٍ فِی سَفَرٍ ، قَالَ : فَأَقْبَلَتِ الظِّبَائُ نَحْوَہُ حَتَّی إذَا دَنَتْ مِنْہُ رَجَعَتْ ، فَقَالَ لَہُ رَجُلٌ : أَیُّہَا الأَمِیرُ ، ارْجِعْ ، فَقَالَ لَہُ : سَعْدٌ : أَخْبِرْنِی مِنْ أَیُّہَا تَطَیَّرْت ؟ أَمِنْ قُرُونِہَا حِینَ أَقْبَلَتْ أَمْ مِنْ أَدْبَارِہَا حِینَ أَدْبَرَتْ ؟ ، ثُمَّ قَالَ سَعْدٌ عِنْدَ ذَلِکَ : إنَّ الطِّیَرَۃَ لَشُعْبَۃٌ مِنَ الشِّرْکِ۔","Hasan","Musannaf Ibn Abi Shaybah 26927","","","كتاب الأدب"
"26928","(۲۶۹۲۸) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَن مَرْزُوقِ أبی بُکَیْر التَّیْمِیِّ ، عَن عِکْرِمَۃَ ، أَنَّ ابْنَ عَبَّاسٍ لُزِقَ بِمَجْذُومٍ فَقُلْت لَہُ : تَلْزَقُ بِمَجْذُومٍ ؟ قَالَ : فَأَمْضِ ، وَقَالَ : لَعَلَّہُ خَیْرٌ مِنِّی وَمِنْک۔","Sahih","Musannaf Ibn Abi Shaybah 26928","","","كتاب الأدب"
"26929","(۲۶۹۲۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِیہِ ، عَن سِبَاعِ بْنِ ثَابِتٍ ، عَن أُمِّ کُرْزٍ قَالَتْ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَقِرُّوا الطَّیْرَ عَلَی مَکِنَاتِہَا۔ (ابوداؤد ۸۲۸۔ طیالسی ۱۶۳۴)","Sahih","Musannaf Ibn Abi Shaybah 26929","","","كتاب الأدب"
"26930","(۲۶۹۳۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَن سُلَیْمَانَ بْنِ الْقَاسِمِ ، عَن أُمِّہِ قَالَ : سَأَلَتْ أُمُّ سَعِیدٍ سُرِّیَّۃَ عَلِیٍّ : ہَلْ کَانَ الْحَسَنُ وَالْحُسَیْنُ یَتَطَیَّرَانِ ؟ قَالَتْ : کَانَا یَحُسَّانِ وَیَمْضِیَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 26930","","","كتاب الأدب"
"26931","(۲۶۹۳۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَوْفٍ ، عَن حَیَّانَ ، عَن قَطَنِ بْنِ قَبِیصَۃَ ، عَنْ أَبِیہِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعِیَافَۃُ وَالطِّیَرَۃُ وَالطَّرْقُ مِنَ الْجِبْتِ۔ (ابوداؤد ۳۹۰۲۔ احمد ۳/۴۷۷)","Da'if","Musannaf Ibn Abi Shaybah 26931","","","كتاب الأدب"
"26932","(۲۶۹۳۲) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن رَجَائِ بْنِ حَیْوَۃَ ، عَنْ أَبِی الدَّرْدَائِ قَالَ : ثَلاَثٌ مَنْ کُنَّ فِیہِ ، فَہُوَ مُنَافِقٌ : مَنْ تَکَہَّنَ ، أَوِ اسْتَقْسَمَ ، أَوْ رَجَعَتْہُ طِیَرَۃٌ مِنْ سَفَرٍ۔","Hasan","Musannaf Ibn Abi Shaybah 26932","","","كتاب الأدب"
"26933","(۲۶۹۳۳) حَدَّثَنَا عَلِیُّ بْنُ الْجَعْدِ ، عَن یَزِیدَ بْنِ إِبْرَاہِیمَ ، عَن أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ غَولَ ، وَلاَ صَفَرَ۔ (مسلم ۱۷۴۵۔ احمد ۳/۲۹۳)","Sahih","Musannaf Ibn Abi Shaybah 26933","","","كتاب الأدب"
"26934","(۲۶۹۳۴) حَدَّثَنَا شَرِیکٌ وَہُشَیْمٌ ، عَن یَعْلَی بْنِ عَطَائٍ ، عَنْ عَمْرِو بْنِ الشَّرِیدِ ، عَنْ أَبِیہِ قَالَ : کَانَ فِی وَفْدِ ثَقِیفٍ رَجُلٌ مَجْذُومٌ ، فَأَرْسَلَ إلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّا قَدْ بَایَعْناک فَارْجِعْ۔","Sahih","Musannaf Ibn Abi Shaybah 26934","","","كتاب الأدب"
"26935","(۲۶۹۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَن مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ عَمْرٍو بْنِ عُثْمَانَ ، عَنْ أَمَۃِ فَاطِمَۃَ بِنْتِ حُسَیْنٍ، عَنِ ابْنِ عَبَّاسٍ قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ تُدِیمُوا النَّظَرَ إلَی الْمَجْذُومِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 26935","","","كتاب الأدب"
"26936","(۲۶۹۳۶) حَدَّثَنَا وَکِیعٌ ، عَنِ النَّہَّاسِ بْنِ قَہْمٍ ، قَالَ : سَمِعْتُ شَیْخًا بِمَکَّۃَ یُحَدِّثُ عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِرَّ مِنَ الْمَجْذُومِ فِرَارَک مِنَ الأَسَدِ۔","Da'if","Musannaf Ibn Abi Shaybah 26936","","","كتاب الأدب"
"26937","(۲۶۹۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ مُسْلِمٍ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ عَلَی مَجْذُومٍ فَخَمَّرَ أَنْفَہُ فَقِیلَ لَہُ : یَا رَسُولَ اللہِ ، أَلَیْسَ قُلْتَ : لاَ عَدْوَی ، وَلاَ طِیَرَۃَ ؟ قَالَ : بَلَی۔","","Musannaf Ibn Abi Shaybah 26937","","","كتاب الأدب"
"26938","(۲۶۹۳۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یُورِدُ الْمُمْرِضَ عَلَی الْمُصِحِّ۔ (مسلم ۱۰۴۔ ابن ماجہ ۳۵۴۱)","Hasan","Musannaf Ibn Abi Shaybah 26938","","","كتاب الأدب"
"26939","(۲۶۹۳۹) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَن نَافِعِ بْنِ جُبَیْرٍ قَالَ : قَالَ کَعْبٌ لِعَبْدِ اللہِ بْنِ عَمْرٍو : ہَلْ تَطَیَّرُ ؟ قَالَ : نَعَمْ ، قَالَ : فَمَا تَقُولُ ؟ قَالَ : أَقُولُ اللَّہُمَّ لاَ طَیْرَ إلاَّ طَیْرُک ، وَلاَ خَیْرَ إلاَّ خَیْرُک ، وَلاَ رَبَّ لَنَا غَیْرَک قَالَ : أَنْتَ أَفْقَہُ الْعَرَبِ۔","Hasan","Musannaf Ibn Abi Shaybah 26939","","","كتاب الأدب"
"26940","(۲۶۹۴۰) حَدَّثَنَا مُحَمَّدٌ بْنُ سَوَائٍ ، عَن خَالِدِ الْحَذَّائِ ، عَنْ أَبِی قِلاَبَۃَ ، أَنَّہُ کَانَ یُعْجِبُہُ أَنْ یُتَّقَی الْمَجْذُومُ۔","","Musannaf Ibn Abi Shaybah 26940","","","كتاب الأدب"
"26941","(۲۶۹۴۱) حَدَّثَنَا غَسَّانُ بْنُ مُضَرَ ، عَن سَعِیدِ بْنِ یَزِیدَ ، عَن عِکْرِمَۃَ قَالَ : مَا لَکُمْ لاَ تَسْأَلُونَنَا أَفْلَسْتُمْ ؟۔","","Musannaf Ibn Abi Shaybah 26941","","","كتاب الأدب"
"26942","(۲۶۹۴۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَن سَعْدِ بْنِ إبْرَاہِیمَ قَالَ : قَالَ ابْنُ عَبَّاسٍ : مَا سَأَلَنِی رَجُلٌ عَن مَسْأَلَۃٍ إلاَّ عَرَفْت ، فَقِیہٌ ہُوَ ، أَوْ غَیْرُ فَقِیہٍ۔","","Musannaf Ibn Abi Shaybah 26942","","","كتاب الأدب"
"26943","(۲۶۹۴۳) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ ، عَن سُفْیَانَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَن سَعِیدِ بْنِ جُبَیْرٍ قَالَ : مَا أَحَدٌ یَسْأَلُنِی؟۔","","Musannaf Ibn Abi Shaybah 26943","","","كتاب الأدب"
"26944","(۲۶۹۴۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو قَالَ : قَالَ لَنَا عُرْوَۃُ : ائْتُونِی فَتَلَقَّوْا مِنِّی۔","","Musannaf Ibn Abi Shaybah 26944","","","كتاب الأدب"
"26945","(۲۶۹۴۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ قَالَ : کَانَ عُرْوَۃُ یَتَأَلَّفُ النَّاسَ عَلَی حَدِیثِہِ۔","","Musannaf Ibn Abi Shaybah 26945","","","كتاب الأدب"
"26946","(۲۶۹۴۶) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ ، عَن سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ السَّائِبِ ، عَن زَاذَانَ قَالَ : سَأَلْتُ ابْنَ مَسْعُودٍ عَنْ أَشْیَائَ مَا أَحَدٌ یَسْأَلُنِی عنہا۔","Sahih","Musannaf Ibn Abi Shaybah 26946","","","كتاب الأدب"
"26947","(۲۶۹۴۷) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَن سِمَاکٍ ، عَن خَالِدِ بن عَرْعَرَۃ ، قَالَ : أَتَیْتُ الرَّحْبَۃَ فَإِذَا أَنَا بِنَفَرٍ جُلُوسٍ قَرِیبًا مِنْ ثَلاَثِینَ ، أَوْ أَرْبَعِینَ رَجُلاً فَقَعَدْتُ مَعَہُمْ ، فَخَرَجَ عَلَیْنَا عَلِیٌّ ، فَمَا رَأَیْتہ أَنْکَرَ أَحَدًا مِنَ الْقَوْمِ غَیْرِی فَقَالَ : أَلاَ رَجُلٌ یَسْأَلُنِی فَیَنْتَفِعُ وَیَنْتَفِعُ جُلَسَاؤُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 26947","","","كتاب الأدب"
"26948","(۲۶۹۴۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن یَحْیَی بْنِ سَعِیدٍ قَالَ : نُرَاہ عَن سَعید بن المُسَیّب لَمْ یَکُنْ أَحَدٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ سَلُونِی إلاَّ عَلِیُّ بْنُ أَبِی طَالِبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 26948","","","كتاب الأدب"
"26949","(۲۶۹۴۹) حَدَّثَنَا ہُشَیْمٌ ، عَن مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِرٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِکِتَابٍ أَصَابَہُ مِنْ بَعْضِ الْکُتُبِ ، فَقَالَ : یَا رَسُولَ اللہِ ، إنِّی أَصَبْتُ کِتَابًا حَسَنًا مِنْ بَعْضِ أَہْلِ الْکِتَابِ ، قَالَ : فَغَضِبَ ، وَقَالَ : أَمُتَہَوِّکُونَ فِیہَا یَا ابْنَ الْخَطَّابِ ، وَالَّذِی نَفْسِی بِیَدِہِ ، لَقَدْ جِئْتُکُمْ بِہَا بَیْضَائَ نَقِیَّۃً ، لاَ تَسْأَلُوہُمْ عَن شَیْئٍ فَیُخْبِرُوکُمْ بِحَقٍّ فَتُکَذِّبُوا بِہِ ، أَوْ بِبَاطِلٍ فَتُصَدِّقُوا بِہِ ، وَالَّذِی نَفْسِی بِیَدِہِ ، لَوْ کَانَ مُوسَی کان حَیًّا الیَوم مَا وَسِعَہُ إلاَّ أَنْ یَتَّبِعَنی۔","Da'if","Musannaf Ibn Abi Shaybah 26949","","","كتاب الأدب"
"26950","(۲۶۹۵۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَن سُفْیَانَ، عَن سَعْدِ بْنِ إِبْرَاہِیمَ، عَن عَطَائِ بْنِ یَسَارٍ قَالَ: کَانَتِ الْیَہُودُ تَجِیئُ إلَی الْمُسْلِمِینَ فَیُحَدِّثُونَہُمْ فَیَسْتَحْسِنُونَ، أَوْ قَالَ: یَسْتَحِبُّونَ، فَذَکَرُوا ذَلِکَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : لاَ تُصَدِّقُوہُمْ ، وَلاَ تُکَذِّبُوہُمْ قُولُوا : {آمَنَّا بِاَللَّہِ وَمَا أُنْزِلَ إلَیْنَا وَمَا أُنْزِلَ إلَیْکُمْ} إلَی آخِرِ الآیَۃِ۔","","Musannaf Ibn Abi Shaybah 26950","","","كتاب الأدب"
"26951","(۲۶۹۵۱) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ أَیُّوبَ ، عَن عِکْرِمَۃَ قَالَ : قَالَ ابْنُ عَبَّاسٍ : تَسْأَلُونَ أَہْلَ الْکِتَابِ عَن کُتُبِہِمْ وَعَندَکُمْ کِتَابُ اللہِ أَقْرَبُ الْکُتُبِ عَہْدًا بِاللَّہِ تَقْرَؤُونَہُ مَحْضًا لَمْ یَشُبْ۔ (بخاری ۲۶۸۵)","Sahih","Musannaf Ibn Abi Shaybah 26951","","","كتاب الأدب"
"26952","(۲۶۹۵۲) حَدَّثَنَا یَعْلَی قَالَ : حدَّثَنَا الأَعْمَشُ ، عَن عُمَارَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ قَالَ : قَالَ عَبْدُ اللہِ : لاَ تَسْأَلُوا أَہْلَ الْکِتَابِ عَن شَیْئٍ فَتُکَذِّبُوا بِحَقٍّ ، أَوْ تُصَدِّقُوا بِبَاطِلٍ ، فَإِنَّہُمْ لَنْ یَہْدُوکُمْ وَیَضِلُّونَ أَنْفُسَہُمْ ، وَلَیْسَ أَحَدٌ مِنْہُمْ إلاَّ فِی قَلْبِہِ تَالِیَۃٌ تَدْعُوہُ إلَی دَیْنِہِ کَتَالِیَۃِ الْمَالِ۔","Sahih","Musannaf Ibn Abi Shaybah 26952","","","كتاب الأدب"
"26953","(۲۶۹۵۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنِ الرَّبِیعِ بْنِ سَعْدٍ قَالَ : رَأَیْتُ جَابِرًا یَکْتُبُ عِنْدَ ابْنِ سَابِطٍ فِی أَلْوَاحٍ۔","Sahih","Musannaf Ibn Abi Shaybah 26953","","","كتاب الأدب"
"26954","(۲۶۹۵۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ قَالَ : کُنْتُ سَیِّئَ الْحِفْظِ ، فَرَخَّصَ لِی سَعِیدُ بْنُ الْمُسَیَّبِ فِی الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 26954","","","كتاب الأدب"
"26955","(۲۶۹۵۵) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عَبْدِ اللہِ بْنِ سُفْیَانَ ، عَنْ عَمِّہِ ، أَنَّہُ سَمِعَ عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : قیِّدُوا الْعِلْمَ بِالْکِتَابِ۔ (دارمی ۴۹۷)","Sahih","Musannaf Ibn Abi Shaybah 26955","","","كتاب الأدب"
"26956","(۲۶۹۵۶) حَدَّثَنَا وَکِیعٌ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ قَالَ: قَالَ ابْنُ عَبَّاسٍ: قیِّدُوا الْعِلْمَ بِالْکِتَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 26956","","","كتاب الأدب"
"26957","(۲۶۹۵۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن عُبَیْدِ اللہِ بْنِ الأَخْنَسِ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ ، عَن یُوسُفَ بْنِ مَاہَکَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : کُنْتُ أَکْتُبُ کُلَّ شَیْئٍ أَسْمَعُہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأُرِیدُ حِفْظَہُ ، فَنَہَتْنِی قُرَیْشٌ عَن ذَلِکَ وقَالُوا : تَکْتُبُ کُلَّ شَیْئٍ تَسْمَعُہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَکَلَّمُ فِی الرِّضَا وَالْغَضَبِ قَالَ : فَأَمْسَکْت فَذَکَرْت ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَشَارَ بِیَدِہِ إلَی فِیہِ فَقَالَ : اکْتُبْ فَوَالَّذِی نَفْسِی بِیَدِہِ : مَا یَخْرُجُ مِنْہُ إلاَّ حَقٌّ۔n(دارمی ۴۸۴۔ احمد ۲/۱۹۲)","Sahih","Musannaf Ibn Abi Shaybah 26957","","","كتاب الأدب"
"26958","(۲۶۹۵۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن مِسْعَرٍ ، عَن مَعْن قَالَ : أَخْرَجَ إلَیَّ عَبْدُ الرَّحْمَنِ بْنِ عَبْدِ اللہِ کِتَابًا وَحَلَفَ لِی أَنَّہُ خَطُّ أَبِیہِ بِیَدِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 26958","","","كتاب الأدب"
"26959","(۲۶۹۵۹) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ بَأْسَ بِکِتَابِ الأَطْرَافِ۔","","Musannaf Ibn Abi Shaybah 26959","","","كتاب الأدب"
"26960","(۲۶۹۶۰) حَدَّثَنَا وَکِیعٌ ، عَن أَبِی کِبْران قَالَ : سَمِعت الضَحَاک یَقُول إِذَا سَمِعت شَیئًا فَاکتُبہ وَلَو فی حائط۔","","Musannaf Ibn Abi Shaybah 26960","","","كتاب الأدب"
"26961","(۲۶۹۶۱) حَدَّثَنَا وَکِیعٌ ، عَن حُسَیْنِ بْنِ عُقَیْلٍ قَالَ : أَمْلَی عَلَیَّ الضَّحَّاکُ مَنَاسِکَ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 26961","","","كتاب الأدب"
"26962","(۲۶۹۶۲) حَدَّثَنَا وَکِیعُ ، عَن عُمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، عَن بَشِیرِ بْنِ نَہِیکٍ قَالَ : کُنْتُ أَکْتُبُ مَا أَسْمَعُہُ مِنْ أَبِی ہُرَیْرَۃَ ، فَلَمَّا أَرَدْت أَنْ أُفَارِقَہُ أَتَیْتہ بِکِتَابِی فَقُلْت ہَذَا سَمِعْتہ مِنْک ؟ قَالَ : نَعَمْ۔","Sahih","Musannaf Ibn Abi Shaybah 26962","","","كتاب الأدب"
"26963","(۲۶۹۶۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَن حَمَّادِ بْنِ زَیْدٍ ، عَن یَحْیَی بْنِ عَتِیقٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : کُنْتُ أَلْقَی عَبِیْدَۃَ بِالأَطْرَافِ فَأَسْأَلُہُ۔","","Musannaf Ibn Abi Shaybah 26963","","","كتاب الأدب"
"26964","(۲۶۹۶۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن عُثْمَانَ بْنِ حَکِیمٍ ، عَن سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّہُ کَانَ یَکُونُ مَعَ ابْنِ عَبَّاسٍ ، فَیَسْمَعُ مِنْہُ الْحَدِیثَ فَیَکْتُبُہُ فِی وَاسِطَۃِ الرَّحْلِ ، فَإِذَا نَزَلَ نَسَخَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26964","","","كتاب الأدب"
"26965","(۲۶۹۶۵) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ قَالَ : الْکِتَابُ أَحَبُّ إلَیَّ مِنَ النِّسْیَانِ۔","","Musannaf Ibn Abi Shaybah 26965","","","كتاب الأدب"
"26966","(۲۶۹۶۶) حَدَّثَنَا سُلَیْمَانُ بْنُ حَرْبٍ قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ أَیُّوبَ ، عَنْ أَبِی الْمَلِیحِ قَالَ : یَعِیبُونَ عَلَیْنَا الْکِتَابَ وَقَدْ قَالَ اللَّہُ تَعَالَی : {عِلْمُہَا عِنْدَ رَبِّی فِی کِتَابٍ}۔","","Musannaf Ibn Abi Shaybah 26966","","","كتاب الأدب"
"26967","(۲۶۹۶۷) حَدَّثَنَا حَفْصٌ، عَن مُجَالِدٍ، عَنِ الشَّعْبِیِّ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ، أَنَّہُ کَانَ إذَا سَمِعَ شَیْئًا کَتَبَہُ۔","","Musannaf Ibn Abi Shaybah 26967","","","كتاب الأدب"
"26968","(۲۶۹۶۸) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ حَنَشٍ قَالَ: رَأَیْتُہُمْ عِنْدَ الْبَرَائِ یَکْتُبُونَ عَلَی أَکُفِّہِمْ بِالْقَصَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 26968","","","كتاب الأدب"
"26969","(۲۶۹۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن شُعْبَۃَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ اللہِ بْنِ یَسَارٍ قَالَ : سَمِعَتْ عَلِیًّا یَخْطُبُ یَقُولُ : أَعْزِمُ عَلَی کُل مَنْ کَانَ عَندَہُ کِتَابٌ إلاَّ رَجَعَ فَمَحَاہُ ، فَإِنَّمَا ہَکَذَا النَّاسُ حَیْثُ تَتَبَّعُوا أَحَادِیثَ عُلَمَائِہِمْ وَتَرَکُوا کِتَابَ رَبِّہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 26969","","","كتاب الأدب"
"26970","(۲۶۹۷۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن کَہْمَسَ ، عَنْ أَبِی نَضْرَۃَ قَالَ : قلْنَا لأَبِی سَعِیدٍ الْخُدْرِیِّ : لَوِ اکْتَبْتَنَا الْحَدِیثَ ؟ فَقَالَ : لاَ نُکْتِبُکُمْ ، خُذُوا عَنَّا کَمَا أَخَذْنَا عَن نَبِیِّنَا صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 26970","","","كتاب الأدب"
"26971","(۲۶۹۷۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَن سُلَیْمَانَ بْنِ الأَسْوَدِ الْمُحَارِبِیِّ قَالَ : کَانَ ابْنُ مَسْعُودٍ یَکْرَہُ کِتَابَ الْعِلْمِ۔","Sahih","Musannaf Ibn Abi Shaybah 26971","","","كتاب الأدب"
"26972","(۲۶۹۷۲) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ قَالَ : کَانَ عُمَرُ یَکْتُبُ إلَی عُمَّالِہِ : لاَ تُخَلِّدُنَّ عَلَیَّ کِتَابًا۔","","Musannaf Ibn Abi Shaybah 26972","","","كتاب الأدب"
"26973","(۲۶۹۷۳) حَدَّثَنَا جَرِیرٌ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : قَالَ لِی عَبِیْدَۃُ : لاَ تُخَلِّدُنَّ عَلَیَّ کِتَابًا۔","","Musannaf Ibn Abi Shaybah 26973","","","كتاب الأدب"
"26974","(۲۶۹۷۴) حَدَّثَنَا وَکِیعٌ ، عَن طَلْحَۃَ بْنِ یَحْیَی ، عَنْ أَبِی بُرْدَۃَ قَالَ : کَتَبْت عَنْ أَبِی کِتَابًا کَبِیرًا فَقَالَ : ائْتِنِی بِکُتُبِکَ ، فَأَتَیْتہ بِہَا فَغَسَلَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 26974","","","كتاب الأدب"
"26975","(۲۶۹۷۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، عَنِ ابْنِ سِیرِینَ قَالَ : إنَّمَا ضَلَّتْ بَنُو إسْرَائِیلَ بِکُتُبٍ وَرِثُوہَا عَن آبَائِہِمْ۔","","Musannaf Ibn Abi Shaybah 26975","","","كتاب الأدب"
"26976","(۲۶۹۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، أَنَّ مَرْوَانَ دَعَا زَیْدَ بْنَ ثَابِتٍ وَقَوْمًا یَکْتُبُونَ وَہُوَ لاَ یَدْرِی، فَأَعْلَمُوہُ فَقَالَ : أَتَدْرُونَ لَعَلَّ کُلَّ شَیْئٍ حَدَّثْتُکُمْ لَیْسَ کَمَا حَدَّثْتُکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 26976","","","كتاب الأدب"
"26977","(۲۶۹۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ جَامِعِ بْنِ شَدَّادٍ، عَنِ الأَسْوَدِ بْنِ ہِلاَلٍ قَالَ: أُتِیَ عَبْدُ اللہِ بِصَحِیفَۃٍ فِیہَا حَدِیثٌ ، فَدَعَا بِمَائٍ فَمَحَاہَا ، ثُمَّ غَسَلَہَا ، ثُمَّ أَمَرَ بِہَا فَأُحْرِقَتْ ، ثُمَّ قَالَ : أُذَکِّرُ بِاللَّہِ رَجُلاً یَعْلَمُہَا عِنْدَ أَحَدٍ إلاَّ أَعْلَمَنِی بِہِ ، وَاللَّہِ لَوْ أَعْلَمُ أَنَّہَا بِدیر ہِنْد لاَنْتَعَلْتُ إلَیْہَا ، بِہَذَا ہَلَکَ أَہْلُ الْکِتَابِ قَبْلَکُمْ حَتَّی نَبَذُوا کِتَابَ اللہِ وَرَائَ ظُہُورِہِمْ کَأَنَّہُمْ لاَ یَعْلَمُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 26977","","","كتاب الأدب"
"26978","(۲۶۹۷۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَن کَہْمَسٍ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ أَبِیہِ قَالَ : کُلُّ الْکِتَابِ أَکْرَہُ ، قَالَ : أَرَاہُ یَعْنِی مَا کَانَ فِیہِ مِنْ ذِکْرِ اللہِ ، قُلْتُ لِمُعْتَمِرٍ : یَعْنِی الْخَاتَمَ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 26978","","","كتاب الأدب"
"26979","(۲۶۹۷۹) حَدَّثَنَا مُعَاذٌ قَالَ : حدَّثَنَا ابْنُ عَوْنٍ ، عَنِ الْقَاسِمِ ، أَنَّہُ کَانَ لاَ یَکْتُبُ الْحَدِیثَ۔","","Musannaf Ibn Abi Shaybah 26979","","","كتاب الأدب"
"26980","(۲۶۹۸۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ قَالَ : کُنَّا نَخْتَلِفُ فِی أَشْیَائَ فَکَتَبْتہَا فِی کِتَابٍ ، ثُمَّ أَتَیْتُ بِہَا ابْنَ عُمَرَ أَسْأَلُہُ عنہا خَفِیًّا ، فَلَوْ عَلِمَ بِہَا کَانَتِ الْفَیْصَلُ فِیمَا بَیْنِی وَبَیْنَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 26980","","","كتاب الأدب"
"26981","(۲۶۹۸۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ قَالَ : قَالَ عَبِیْدَۃُ : لاَ تُخَلِّدُنَّ عَلَیَّ کِتَابًا۔","","Musannaf Ibn Abi Shaybah 26981","","","كتاب الأدب"
"26982","(۲۶۹۸۲) حَدَّثَنَا ابْنُ إدْرِیسَ، عَن ہَارُونَ بْنِ عَنتَرَۃَ، عَنْ أَبِیہِ، عَنِ ابْنِ عَبَّاسٍ، أَنَّہُ رَخَّصَ لَہُ أَنْ یَکْتُبَ وَلَمْ یَکَدْ۔","Sahih","Musannaf Ibn Abi Shaybah 26982","","","كتاب الأدب"
"26983","(۲۶۹۸۳) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ قَالَ : حدَّثَنَا عُمَارَۃُ بْنُ زَاذَانَ قَالَ : حَدَّثَنَا عَلِیُّ بْنُ الْحَکَمِ ، عَنْ عَطَائِ بْنِ أَبِی رَبَاحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : مَا مِنْ رَجُلٍ حَفِظَ عِلْمًا فَسُئِلَ عَنہُ فَکَتَمَہُ إلاَّ جِیئَ بہ یَوْمَ الْقِیَامَۃِ مُلَجَّمًا بِلِجَامٍ مِنْ نَارٍ۔ (ابوداؤد ۳۶۵۰۔ ابن حبان ۹۵)","Hasan","Musannaf Ibn Abi Shaybah 26983","","","كتاب الأدب"
"26984","(۲۶۹۸۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَن حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : مَنْ کَتَمَ عِلْمًا عِندَہُ أَلْجَمَہُ اللَّہُ یَوْمَ الْقِیَامَۃِ بِلِجَامٍ مِنْ نَارٍ۔ (احمد ۴۹۹)","","Musannaf Ibn Abi Shaybah 26984","","","كتاب الأدب"
"26985","(۲۶۹۸۵) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ قَالَ : حدَّثَنَا ابْنُ عَوْنٍ قَالَ : کَان مِمَّنْ یَتَّبِعُ أَنْ یُحَدِّثَ بِالْحَدِیثِ کَمَا سَمِعَ : محمد بْنُ سِیرِینَ وَالْقَاسِمُ بْنُ مُحَمَّدٍ وَرَجَائُ بْنُ حَیْوَۃَ ، وَکَانَ مِمَّنْ لاَ یَتَّبِعُ ذَلِکَ : الْحَسَنُ وَإِبْرَاہِیمُ وَالشَّعْبِیُّ ، قَالَ ابْنُ عَوْنٍ : فَقُلْتُ لِمُحَمَّدٍ : إنَّ فُلاَنًا لاَ یَتَّبِعُ أَنْ یُحَدِّثَ بِالْحَدِیثِ کَمَا سَمِعَ ، فَقَالَ : أمَّا أَنَّہُ لَوِ اتَّبَعَہُ کَانَ خَیْرًا لَہُ۔","","Musannaf Ibn Abi Shaybah 26985","","","كتاب الأدب"
"26986","(۲۶۹۸۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن عُمَارَۃَ ، عَنْ أَبِی مَعْمَرٍ ، أَنَّہُ کَانَ یَتْبَعُ اللَّحْنَ فِی الْحَدِیثِ کَیْ یَجِیئُ بِہِ کَمَا سَمِعَ۔","","Musannaf Ibn Abi Shaybah 26986","","","كتاب الأدب"
"26987","(۲۶۹۸۷) حَدَّثَنَا صَفْوَان ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ وَالشَّعْبِیِّ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِتَقْدِیمِ الْحَدِیثِ وَتَأْخِیرِہِ ، وَکَانَ ابْنُ سِیرِینَ یَتَکَلَّفُہُ کَمَا سَمِعَہ۔","","Musannaf Ibn Abi Shaybah 26987","","","كتاب الأدب"
"26988","(۲۶۹۸۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ، عَنْ إسْمَاعِیلِ بْنِ أُمَیَّۃَ قَالَ: کُنَّا نُرِیدُ نَافِعًا عَلَی إقَامَۃِ اللَّحْنِ فِی الْحَدِیثِ فَیَأْبَی۔","","Musannaf Ibn Abi Shaybah 26988","","","كتاب الأدب"
"26989","(۲۶۹۸۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ قَالَ : قلْت لأَبِی الضُّحَی : الْمُصَوِّرُونَ ، قَالَ : الْمُصَوِّرِینَ۔","","Musannaf Ibn Abi Shaybah 26989","","","كتاب الأدب"
"26990","(۲۶۹۹۰) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : قُلْتُ لَہُ : أَسْمَعُ اللَّحْنَ فِی الْحَدِیثِ ؟ قَالَ : أَقِمْہُ۔","","Musannaf Ibn Abi Shaybah 26990","","","كتاب الأدب"
"26991","(۲۶۹۹۱) حَدَّثَنَا أَبُو عَاصِمٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَجْعَلَ الرَّجُلُ فِی یَدِہِ الْخَیْطَ یَسْتَذْکِرُ بِہِ الرَّجُلُ فِی الشَّیْئِ۔","","Musannaf Ibn Abi Shaybah 26991","","","كتاب الأدب"
"26992","(۲۶۹۹۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَن مَنْصُورِ بْنِ أَبِی الأَسْوَدِ ، عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یُرْبَطَ الْخَیْطُ فِی الْخَاتَمِ یَسْتَذْکِرُ بِہِ الْحَاجَۃَ۔","","Musannaf Ibn Abi Shaybah 26992","","","كتاب الأدب"
"26993","(۲۶۹۹۳) ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَن مَغْرَائَ الْعَبْدِیِّ ، عَن شُرَیْحٍ ، أَنَّہُ سَمِعَ صَوْتَ دُفٍّ فَقَالَ : إنَّ الْمَلاَئِکَۃَ لاَ یَدْخُلُونَ بَیْتًا فِیہِ دُفٌّ۔","","Musannaf Ibn Abi Shaybah 26993","","","كتاب الأدب"
"26994","(۲۶۹۹۴) یَحْیَی بْنُ سَعِیدٍ ، وَابْنُ مَہْدِیٍّ ، عَن سُفْیَانَ ، عَن عِمْرَانَ بْنِ مُسْلِمٍ قَالَ : قَالَ لِی خَیْثَمَۃُ : أَمَا سَمِعْت سُوَیْدًا یَقُولُ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ دُفٌّ۔","","Musannaf Ibn Abi Shaybah 26994","","","كتاب الأدب"
"26995","(۲۶۹۹۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَن سُفْیَانَ ، عَن مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یَسْتَقْبِلُونَ الْجَوَارِیَ فِی الأَزِقَّۃِ مَعَہُنَّ الدُّفُوفَ فَیَشُقُّونَہَا۔","","Musannaf Ibn Abi Shaybah 26995","","","كتاب الأدب"
"26996","(۲۶۹۹۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ إبْرَاہِیمَ اخْتُتِنَ بِالْقَدُّومِ وَہُوَ ابْنُ مِئَۃ وَعِشْرِینَ سَنَۃً ، ثُمَّ عَاشَ بَعْدَ ذَلِکَ ، ثَمَانِینَ سَنَۃً۔(بخاری ۳۳۵۶۔ مسلم ۱۸۳۹)","Sahih","Musannaf Ibn Abi Shaybah 26996","","","كتاب الأدب"
"26997","(۲۶۹۹۷) حَدَّثَنَا عَبْدَۃُ ، عَن یَحْیَی بْنِ سَعِیدٍ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : کَانَ إبْرَاہِیمُ أَوَّلَ النَّاسِ أَضَافَ الضَّیْفَ ، وَأَوَّلَ النَّاسِ قَصَّ شَارِبَہُ وَقَلَّمَ أَظْفَارَہُ وَاسْتَحَدَّ ، وَأَوَّلَ النَّاسِ اخْتُتِنَ ، وَأَوَّلَ النَّاسِ رَأَی الشَّیْبَ فَقَالَ : یَا رَبِّ ، مَا ہَذَا ؟ قَالَ : الْوَقَارُ ، قَالَ : رَبِّ زِدْنِی وَقَارًا۔ (مالک۴۔ ابن عدی ۱۵۱۱)","","Musannaf Ibn Abi Shaybah 26997","","","كتاب الأدب"
"26998","(۲۶۹۹۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَن حَجَّاجٍ ، عَن رَجُلٍ ، عَنْ أَبِی الْمَلِیحِ ، عَن شَدَّادِ بْنِ أَوْسٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْخِتَانُ سُنَّۃٌ لِلرِّجَالِ مَکْرُمَۃٌ لِلنِّسَائِ۔ (طبرانی ۷۱۱۲۔ احمد ۷۵)","Da'if","Musannaf Ibn Abi Shaybah 26998","","","كتاب الأدب"
"26999","(۲۶۹۹۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : خَمْسٌ مِنَ الْفِطْرَۃِ فَذَکَرَ الْخِتَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 26999","","","كتاب الأدب"
"27000","(۲۷۰۰۰) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ، عَنْ إسْرَائِیلَ، عَن مَنْصُورٍ، عَن مُجَاہِدٍ وَإِبْرَاہِیمَ ، قَالاَ: الْخِتَانُ من السُنَّۃِ۔ (ابن حبان ۳۵۴۔ بزار ۹۹۰)","","Musannaf Ibn Abi Shaybah 27000","","","كتاب الأدب"
"27001","(۲۷۰۰۱) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن مَنْصُورٍ ، عَن مَالِکِ بْنِ الْحَارِثِ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، أَنَّ عَبْدَ اللہِ قَالَ : إنَّ اللَّہَ یُحِبُّ أَنْ تُقْبَلَ رُخَصُہُ کَمَا یُحِبُّ أَنْ تُؤْتَی عَزَائِمُہُ۔ (طبرانی ۱۰۰۳)","Sahih","Musannaf Ibn Abi Shaybah 27001","","","كتاب الأدب"
"27002","(۲۷۰۰۲) حَدَّثَنَا غُنْدَرُ ، عَن شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : إنَّ اللَّہَ یُحِبُّ أَنْ تُؤْتَی رُخَصُہُ کَمَا یُحِبُّ أَنْ تُؤْتَی عَزَائِمُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 27002","","","كتاب الأدب"
"27003","(۲۷۰۰۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِیہِ ، عَن تَمِیمِ بْنِ سَلَمَۃَ ، عَنِ ابْنِ عُمَرَ قَالَ : إنَّ اللَّہَ یُحِبُّ أَنْ تُؤْتَی مَیَاسِرُہُ کَمَا یُحِبُّ أَنْ تُؤْتَی عَزَائِمُہُ۔ (احمد ۱۰۸۔ ابن حبان ۲۷۴۲)","Sahih","Musannaf Ibn Abi Shaybah 27003","","","كتاب الأدب"
"27004","(۲۷۰۰۴) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ أَبِیہِ قَالَ : ذَکَرْتہ لِعَبْدِ الرَّحْمَنِ الرَّحَّالِ قَالَ : قَالَ ابْنُ عَبَّاسٍ : إنَّ اللَّہَ یُحِبُّ أَنْ تُؤْتَی مَیَاسِرُہُ کَمَا یُحِبُّ أَنْ تُؤْتَی عَزَائِمُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 27004","","","كتاب الأدب"
"27005","(۲۷۰۰۵) حَدَّثَنَا وَکِیعٌ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَن مُحَمَّدِ بْنِ الْمُنْکَدِرِ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ اللَّہَ یُحِبُّ أَنْ تُقْبَلَ رُخَصُہُ کَمَا یُحِبُّ أَنْ تُؤْتَی فَرِیضَتُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 27005","","","كتاب الأدب"
"27006","(۲۷۰۰۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَن مَسْرُوقٍ قَالَ : إنَّ اللَّہَ یُحِبُّ أَنْ تُؤْتَی رُخَصُہُ کَمَا یُحِبُّ أَنْ تُؤْتَی عَزَائِمُہُ۔","","Musannaf Ibn Abi Shaybah 27006","","","كتاب الأدب"
"27007","(۲۷۰۰۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ قَالَ : إنَّ اللَّہَ یُحِبُّ أَنْ تُؤْتَی مَیَاسِرُہُ کَمَا یُحِبُّ أَنْ یُطَاعَ فی عَزَائِمِہِ۔","","Musannaf Ibn Abi Shaybah 27007","","","كتاب الأدب"
"27008","(۲۷۰۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن نَضْرَ بْنِ عَرَبِی ، عَنْ عَطَائٍ قَالَ : إذَا تَنَازَعَک أَمْرَانِ ، فَاحْمِلِ الْمُسْلِمِینَ عَلَی أَیْسَرِہِمَا۔","","Musannaf Ibn Abi Shaybah 27008","","","كتاب الأدب"
"27009","(۲۷۰۰۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ رضی اللہ عنہا قَالَتْ : مَا خُیِّرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَ أَمْرَیْنِ أَحَدُہُمَا أَیْسَرُ مِنَ الآخَرِ إلاَّ أَخَذَ الَّذِی ہُوَ أَیْسَرُ۔ (مسلم ۱۸۱۴۔ احمد ۳۱)","Sahih","Musannaf Ibn Abi Shaybah 27009","","","كتاب الأدب"
"27010","(۲۷۰۱۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَن لَیْثٍ ، عَن طَاوُوس ، عَنِ ابْنِ عَبَّاسٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَسِّرُوا ، وَلاَ تُعَسِّرُوا۔","Da'if","Musannaf Ibn Abi Shaybah 27010","","","كتاب الأدب"
"27011","(۲۷۰۱۱) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَن سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا بَعَثَہُ ہُوَ وَمُعَاذًا إلَی الْیَمَنِ قَالَ : یَسِّرَا ، وَلاَ تُعَسِّرَا۔ (بخاری ۳۰۳۸۔ مسلم ۱۳۵۹)","Sahih","Musannaf Ibn Abi Shaybah 27011","","","كتاب الأدب"
"27012","(۲۷۰۱۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَوْفٍ ، عَن زِیَادِ بْنِ مِخْرَاقٍ ، عَنْ أَبِی کِنَانَۃَ ، عَنْ أَبِی مُوسَی قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ابْنُ أُخْتِ الْقَوْمِ مِنہم۔ (احمد ۳۹۶۔ بزار ۱۵۸۲)","Hasan","Musannaf Ibn Abi Shaybah 27012","","","كتاب الأدب"
"27013","(۲۷۰۱۳) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، عَن قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ابْنُ أُخْتِ الْقَوْمِ مِنْ أَنْفُسِہِمْ۔ (بخاری ۳۵۲۸۔ مسلم ۷۳۵)","Sahih","Musannaf Ibn Abi Shaybah 27013","","","كتاب الأدب"
"27014","(۲۷۰۱۴) حَدَّثَنَا وَکِیعٌ ، عَن شُعْبَۃَ ، قَالَ : قُلْتُ لِمُعَاوِیَۃَ بْنِ قُرَّۃَ : سَمِعْت أَنَسَ بْنَ مَالِکٍ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِلنُّعْمَانِ بْنِ مُقَرِّنٍ : ابْنُ أُخْتِ الْقَوْمِ مِنْ أَنْفُسِہِمْ قَالَ : نَعَمْ۔(نسائی ۲۳۹۳۔ احمد ۲۲۲)","Sahih","Musannaf Ibn Abi Shaybah 27014","","","كتاب الأدب"
"27015","(۲۷۰۱۵) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنِ ابْنِ خُثَیْمٍ ، عَنْ إسْمَاعِیلَ بْنِ عُبَیْدِ اللہِ بْنِ رِفَاعَۃَ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ قَالَ : جَمَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قُرَیْشًا فَقَالَ : ہَلْ فِیکُمْ مِنْ غَیْرِکُمْ ؟ قَالُوا : لاَ إلاَّ ابْنُ أُخْتِنَا وَحَلِیفُنَا وَمَوْلاَنَا ، فَقَالَ : ابْنُ أُخْتِکُمْ مِنْکُمْ ، وَحَلِیفُکُمْ مِنْکُمْ ، وَمَوْلاَکُمْ مِنْکُمْ۔ (بخاری ۷۵۔ احمد ۳۴۰)","Hasan","Musannaf Ibn Abi Shaybah 27015","","","كتاب الأدب"
"27016","(۲۷۰۱۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَن مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمۃَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : حَدِّثُوا عَن بَنِی إسْرَائِیلَ ، وَلاَ حَرَجَ۔ (ابوداؤد ۳۶۵۴۔ احمد ۵۰۲)","Hasan","Musannaf Ibn Abi Shaybah 27016","","","كتاب الأدب"
"27017","(۲۷۰۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ بْنِ سَعْدٍ ، عَنِ ابْنِ سَابِطٍ ، عَنْ جَابِرٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَحَدَّثُوا عَن بَنِی إسْرَائِیلَ فَإِنَّہُ کَانَتْ فِیہِمْ أَعَاجِیبُ۔","Hasan","Musannaf Ibn Abi Shaybah 27017","","","كتاب الأدب"
"27018","(۲۷۰۱۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَوْزَاعِیِّ ، عَن حَسَّانَ بْنِ عَطِیَّۃَ ، عَنْ أَبِی کَبْشَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : حَدِّثُوا عَن بَنِی إسْرَائِیلَ ، وَلاَ حَرَجَ۔","Sahih","Musannaf Ibn Abi Shaybah 27018","","","كتاب الأدب"
"27019","(۲۷۰۱۹) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا ہَمَّامٌ ، عَن زَیْدِ بْنِ أَسْلَمَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ أَبِی سَعِیدٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : حَدِّثُوا عَن بَنِی إسْرَائِیلَ ، وَلاَ حَرَجَ۔ (احمد ۳۹)","Sahih","Musannaf Ibn Abi Shaybah 27019","","","كتاب الأدب"
"27020","(۲۷۰۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَن یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَن عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : لَعَنَ اللَّہُ الْمُتَخَنِّثِینَ مِنَ الرِّجَالِ ، وَالْمُتَرَجِّلاَت مِنَ النِّسَائِ قَالَ : قُلْتُ لِعِکْرِمَۃَ : مَا الْمُتَرَجِّلاَتُ ؟ قَالَ : الْمُتَشَبِّہَاتُ بِالرِّجَالِ۔ (بخاری ۵۸۸۵۔ ابوداؤد ۴۰۹۴)","Da'if","Musannaf Ibn Abi Shaybah 27020","","","كتاب الأدب"
"27021","(۲۷۰۲۱) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَہْضَمِ بْنِ عَبْدِ اللہِ ، عَمنْ حَدَّث ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمُتَخَنِّثِینَ مِنَ الرِّجَالِ الَّذِینَ یَتَشَبَّہُونَ بِالنِّسَائِ ، وَالْمُتَرَجِّلاَت مِنَ النِّسَائِ اللاَتِی یَتَشَبَّہْنَ بِالرِّجَالِ۔ (ابوداؤد ۴۰۹۵۔ احمد ۱۷۱۵)","Da'if","Musannaf Ibn Abi Shaybah 27021","","","كتاب الأدب"
"27022","(۲۷۰۲۲) حَدَّثَنَا وَکِیعٌ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، عَن زَیْنَبَ بِنْتِ أُمِّ سَلَمَۃَ ، عَن أُمِّ سَلَمَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ عَلَیْہَا فَسَمِعَ مُخَنَّثًا وَہُوَ یَقُولُ لِعَبْدِ اللہِ بْنِ أَبِی أُمَیَّۃَ أَخِیہَا : إِنْ یَفْتَحِ اللَّہُ الطَّائِفَ غَدًا دَلَلْتُک عَلَی امْرَأَۃٍ تُقْبِلُ بِأَرْبَعٍ وَتُدْبِرُ بِثَمَانٍ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَخْرِجُوہُمْ مِنْ بُیُوتِکُمْ۔ (مسلم ۱۷۱۵۔ ابوداؤد ۴۸۹۱)","Sahih","Musannaf Ibn Abi Shaybah 27022","","","كتاب الأدب"
"27023","(۲۷۰۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنِ الْوَلِیدِ بْنِ الْعَیْزَارِ ، عَن عِکْرِمَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ لاَ یَدْخُلُ بَیْتًا فِیہِ مُخَنَّثٌ۔","","Musannaf Ibn Abi Shaybah 27023","","","كتاب الأدب"
"27024","(۲۷۰۲۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنِ الشَّعْبِیِّ قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمُتَشَبِّہِینَ مِنَ الرِّجَالِ بِالنِّسَائِ ، وَالْمُتَشَبِّہَات مِنَ النِّسَائِ بِالرِّجَالِ۔","","Musannaf Ibn Abi Shaybah 27024","","","كتاب الأدب"
"27025","(۲۷۰۲۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا أَبُو حَیَّانَ ، عَن یُونُسَ ، عَنِ الْحَسَنِ یَرْفَعُہُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لُعِنَ مِنَ الرِّجَالِ الْمُتَشَبِّہُ بِالنِّسَائِ وَلُعِنَ مِنَ النِّسَائِ الْمُتَشَبِّہَۃُ الْمُتَرَجِّلَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 27025","","","كتاب الأدب"
"27026","(۲۷۰۲۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَن حَسَنٍ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَن سُوَیْد بْنِ غَفَلَۃَ قَالَ : الْمُتَشَبِّہَۃُ بِالرِّجَالِ مِنَ النِّسَائِ ، لَیْسَتْ مِنَّا وَلَسْنَا مِنْہَا۔","Munkar","Musannaf Ibn Abi Shaybah 27026","","","كتاب الأدب"
"27027","(۲۷۰۲۷) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ قَالَ : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، أَیُّ الْمُسْلِمِینَ أَفْضَلُ ؟ فَقَالَ : مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِہِ وَیَدِہِ۔n(مسلم ۶۵۔ احمد ۳۷۲)","Hasan","Musannaf Ibn Abi Shaybah 27027","","","كتاب الأدب"
"27028","(۲۷۰۲۸) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أَبِی کَثِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : قامَ رَجُلٌ فَقَالَ : یَا رَسُولَ اللہِ ، أَیُّ الإِسْلاَمِ أَفْضَلُ ، قَالَ : أَنْ یَسْلَمَ الْمُسْلِمُونَ مِنْ یَدِکَ وَلِسَانِک۔ (مسلم ۶۴۔ احمد ۳۶۳۹۱)","Sahih","Musannaf Ibn Abi Shaybah 27028","","","كتاب الأدب"
"27029","(۲۷۰۲۹) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَمِعْتُ عُرْوَۃَ بْنَ النَّزَّالِ یُحَدِّثُ عَن مُعَاذِ بْنِ جَبَلٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لَہُ : أَلاَ أَدُلُّک عَلَی أَمْلَکِ ذَلِکَ کُلِّہِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، قَوْلُک أَلاَ أَدُلُّکَ عَلَی أَمْلَکِ ذَلِکَ کُلِّہِ قَالَ : فَأَشَارَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِیَدِہ إلَی لِسَانِہِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، وَإِنَّا لَنُؤَاخَذُ بِمَا نَتَکَلَّمُ بِہِ ، قَالَ : ثَکِلَتْک أُمُّک یا مُعَاذُ ، وَہَلْ یَکُبُّ النَّاسَ عَلَی مَنَاخِرِہِمْ إلاَّ حَصَائِدُ أَلْسِنَتِہِمْ ، قَالَ شُعْبَۃُ : وَقَالَ الْحَکَمُ : وَحَدَّثَنِی بِہِ مَیْمُونُ بْنُ أَبِی شَبِیبٍ ، وَسَمِعْتہ مِنْہُ مُنْذُ أَرْبَعِینَ سَنَۃً۔ (ترمذی ۲۶۱۶۔ احمد ۲۳۳)","Da'if","Musannaf Ibn Abi Shaybah 27029","","","كتاب الأدب"
"27030","(۲۷۰۳۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن یَزِیدَ بْنِ حَیَّانَ ، عَن عَنبَس بْنِ عُقْبَۃَ قَالَ عَبْدُ اللہِ : وَالَّذِی لاَ إلَہَ غَیْرُہُ ، مَا عَلَی الأَرْضِ شَیْئٌ أَحْوَجُ إلَی طُولِ سِجْنٍ مِنْ لِسَانٍ۔ (ابوداؤد ۱۵۹)","Sahih","Musannaf Ibn Abi Shaybah 27030","","","كتاب الأدب"
"27031","(۲۷۰۳۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ عَجْلاَنَ ، عَن زَیْدِ بْنِ أَسْلَمَ ، عَنْ أَبِیہِ قَالَ : دَخَلَ عُمَرُ عَلَی أَبِی بَکْرٍ وَہُوَ آخِذٌ بِلِسَانِہِ ہَکَذَا ، یَقُولُ : ہَا إنَّ ذَا أَوْرَدَنِی الْمَوَارِدَ۔","Hasan","Musannaf Ibn Abi Shaybah 27031","","","كتاب الأدب"
"27032","(۲۷۰۳۲) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن یَعْلَی بْنِ عَطَائٍ ، عَنْ عَبْدِ اللہِ بْنِ سُفْیَانَ ، عَنْ أَبِیہِ قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، أَیُّ شَیْئٍ أَتْقَی ؟ فَأَشَارَ بِیَدِہِ إلَی لِسَانِہِ۔ (ترمذی ۲۴۱۰۔ احمد ۳۸۴)","Sahih","Musannaf Ibn Abi Shaybah 27032","","","كتاب الأدب"
"27033","(۲۷۰۳۳) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ قَالَ : أَحَقُّ مَا طَہَّرَ الْمُسْلِمُ لِسَانَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 27033","","","كتاب الأدب"
"27034","(۲۷۰۳۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلٍ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَقُلْ أَحَدُکُمْ : إنِّی خَبِیثُ النَّفْسِ ، وَلْیَقُلْ ، إنِّی لَقِسُ النَّفْسِ۔ (بخاری ۶۱۸۰)","","Musannaf Ibn Abi Shaybah 27034","","","كتاب الأدب"
"27035","(۲۷۰۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَن ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ رضی اللہ عنہا ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ یَقُلْ أَحَدُکُمْ : خَبُثَتْ نَفْسِی ، وَلْیَقُلْ : لَقِسَتْ نَفْسِی۔ (بخاری ۶۱۷۹۔ مسلم ۱۶)","Sahih","Musannaf Ibn Abi Shaybah 27035","","","كتاب الأدب"
"27036","(۲۷۰۳۶) حَدَّثَنَا وَکِیعٌ، عَن مِسْعَرٍ، عَن سِمَاکٍ الْحَنَفِیِّ ، قَالَ: سَمِعْتُ ابْنَ عَبَّاسٍ یَکْرَہُ أَنْ یَقُولَ : إنِّی کَسْلاَنُ۔","Sahih","Musannaf Ibn Abi Shaybah 27036","","","كتاب الأدب"
"27037","(۲۷۰۳۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَاشِدٍ ، أَنَّ أُخْتًا لِعُبَیْدِ بْنِ عُمَیْرٍ اسْتَشْفَعَتْ لِرَجُلٍ عَلَیْہِ فَقَالَتْ : إنَّمَا ہُوَ بِاللَّہِ وَبِکَ ، فَغَضِبَ فَقَالَ : إنَّمَا ہُوَ بِاللَّہِ۔","","Musannaf Ibn Abi Shaybah 27037","","","كتاب الأدب"
"27038","(۲۷۰۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن سُفْیَانَ ، عَن مُخْتَارٍ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَکْرَہُ أَنْ یَقُولَ : اللَّہُمَّ تَصَدَّقَ عَلَیَّ ، وَلَکِنْ لِیَقُلْ : اللَّہُمَّ امْنُنْ عَلَیَّ۔","","Musannaf Ibn Abi Shaybah 27038","","","كتاب الأدب"
"27039","(۲۷۰۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَن حَفْصَۃَ ، عَنِ الرَّبِیعِ بْنِ زِیَادٍ ، عَن کَعْبٍ قَالَ : وَاللَّہِ مَا اسْتَقَامَ لِعَبْدٍ ثَنَائٌ فِی الأَرْضِ حَتَّی اسْتَقَرَّ لَہُ فِی أَہْلِ السَّمَائِ۔","","Musannaf Ibn Abi Shaybah 27039","","","كتاب الأدب"
"27040","(۲۷۰۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا الْعَوَّامُ بْنُ حَوْشَبٍ قَالَ : الْتَقَیْت أَنَا وَإِیَاسُ بْنُ مُعَاوِیَۃَ بِذَاتِ عِرْقٍ فَذَکَرْنَا إبْرَاہِیمَ التَّیْمِیَّ فَقَالَ إیَاسٌ : لَوْلاَ کَرَامَتُہُ عَلَیَّ لأَثْنَیْتُ عَلَیْہِ فَقُلْت : ہَلْ تَعْرِفُہُ ؟ قَالَ : نَعَمْ ، قُلْتُ : فَلِمَ تَکْرَہُ الثَّنَائَ عَلَیْہِ ، قَالَ : إِنَّہُ کَانَ یُقَالُ : إنَّ الثَّنَائَ مِنَ الْجَزَائِ۔","","Musannaf Ibn Abi Shaybah 27040","","","كتاب الأدب"
"27041","(۲۷۰۴۱) حَدَّثَنَا مُعَاذٌ ، عَن حُمَیْدٍ ، عَنْ أَنَسٍ قَالَ : قالَتِ الْمُہَاجِرُونَ : یَا رَسُولَ اللہِ ، مَا رَأَیْنَا مِثْلَ قَوْمٍ قَدِمْنَا عَلَیْہِمْ أَحْسَنَ بَذْلاً مِنْ کَثِیرٍ ، وَلاَ أَحْسَنَ مُوَاسَاۃً فِی قَلِیلٍ ، کَفَوْنَا المؤنۃ ، وَأَشْرَکُونَا فِی الْمَہْنَأِ ، قَدْ خَشِینَا أَنْ یَذْہَبُوا بِالأَجْرِ کُلِّہِ ، فَقَالَ : لاَ ، مَا أَثْنَیْتُمْ عَلَیْہِمْ وَدَعَوْتُمُ اللَّہَ لَہُمْ۔ (بخاری ۲۱۷۔ ابوداؤد ۴۷۷۹)","Sahih","Musannaf Ibn Abi Shaybah 27041","","","كتاب الأدب"
"27042","(۲۷۰۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا أَشْعَثُ بْنُ سَوَّارٍ ، عَن کُرْدُوسٍ ، عَنْ عَبْدِ اللہِ قَالَ : إنَّ لِلْقُلُوبِ نَشَاطًا وَإِقْبَالاً ، وَإِنَّ لَہَا لَتَوْلِیَۃً وَإِدْبَارًا ، فَحَدِّثُوا النَّاسَ مَا أَقْبَلُوا عَلَیْکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 27042","","","كتاب الأدب"
"27043","(۲۷۰۴۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَن عُثْمَانَ بْنَ غِیَاثٍ ، عَنْ أَبِی السَّلِیْلِ قَالَ : قدِمَ عَلَیْنَا رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَکَانُوا یَجْتَمِعُونَ عَلَیْہِ ، فَصَعِدَ عَلَی ظَہْرِ بَیْتٍ فَحَدَّثَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 27043","","","كتاب الأدب"
"27044","(۲۷۰۴۴) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ قَالَ : أَخْبَرَنَا أَبُو الْعُمَیْسِ ، عَنْ أَبِی طَلْحَۃَ قَالَ : قَدِمَ أَنَسُ بْنُ مَالِکٍ الْکُوفَۃَ فَاجْتَمَعَنا عَلَیْہِ ، قَالَ : فَقُلْنَا : حَدِّثْنَا مَا سَمِعْت مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : وَہُوَ یَقُولُ : أَیُّہَا النَّاسُ ، انْصَرِفُوا عَنی ، حَتَّی أَلْجَأْنَاہُ إلَی حَائِطِ الْقَصْرِ فَقَالَ : لَوْ تَعْلَمُونَ مَا أَعْلَمُ لَبَکَیْتُمْ کَثِیرًا وَلَضَحِکْتُمْ قَلِیلاً أَیُّہَا النَّاسُ ، انْصَرِفُوا عَنی ، فَانْصَرَفْنَا عَنہُ۔ (احمد ۱۸۰)","Hasan","Musannaf Ibn Abi Shaybah 27044","","","كتاب الأدب"
"27045","(۲۷۰۴۵) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا أَبُو ہِلاَلٍ قَالَ : حَدَّثَنَا الْحَسَنُ قَالَ : حَدِّثُوا النَّاسَ مَا أَقْبَلُوا عَلَیْکُمْ بِوُجُوہِہِمْ ، فَإِذَا الْتَفَتُوا فَاعْلَمُوا أَنَّ لَہُمْ حَاجَاتٍ۔ (دارمی ۴۴۹)","","Musannaf Ibn Abi Shaybah 27045","","","كتاب الأدب"
"27046","(۲۷۰۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَن شَقِیقٍ ، عَنْ عَبْدِ اللہِ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَخَوَّلُنَا بِالْمَوْعِظَۃِ مَخَافَۃَ السَّآمَۃِ عَلَیْنَا۔ (مسلم ۲۱۷۲۔ احمد ۴۲۵)","Sahih","Musannaf Ibn Abi Shaybah 27046","","","كتاب الأدب"
"27047","(۲۷۰۴۷) حَدَّثَنَا جَرِیرٌ ، عَن مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، أَنَّہُ کَانَ إذَا رَأَی مِنْ أَصْحَابِہِ ہَشَاشًا یَعْنِی انْبِسَاطًا ذَکَّرَہُمْ۔","","Musannaf Ibn Abi Shaybah 27047","","","كتاب الأدب"
"27048","(۲۷۰۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، وَابْنُ عُیَیْنَۃَ ، وَأَبُو خَالِدٍ الأَحْمَرُ ، عَن مُحَمَّدِ بْنِ عَجْلاَنَ ، عَن بُکَیْر بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَن مَعْمَرٍ ، عَن عُبَیْدِ اللہِ بْنِ عَدِیِّ بْنِ الْخِیَارِ قَالَ : قَالَ عُمَرُ : لاَ تُبَغِّضُوا اللَّہَ إلَی عِبَادِہِ ، یَکُونُ أَحَدُکُمْ إمَامًا فَیُطَوِّلُ عَلَیْہِمْ مَا ہُمْ فِیہِ ، وَیَکُونُ أَحَدُکُمْ قَاصًّا فَیُطَوِّلُ عَلَیْہِمْ مَا ہُمْ فِیہِ۔","Hasan","Musannaf Ibn Abi Shaybah 27048","","","كتاب الأدب"
"27049","(۲۷۰۴۹) حَدَّثَنَا وَکِیعٌ ، عَن مُوسَی بْنِ عُبَیْدَۃَ ، عَن مُحَمَّدِ بْنِ ثَابِتٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا قَالَ الرَّجُلُ لأَخِیہِ : جَزَاک اللَّہُ خَیْرًا ، فَقَدْ أَبْلَغَ فِی الثَّنَائِ۔ (ترمذی ۲۰۳۵)","Da'if","Musannaf Ibn Abi Shaybah 27049","","","كتاب الأدب"
"27050","(۲۷۰۵۰) حَدَّثَنَا وَکِیعٌ ، عَن أُسَامَۃَ بْنِ زَیْدٍ ، عَن طَلْحَۃَ بْنِ عُبَیْدِ اللہِ بْنِ کَرِیزٍ قَالَ : قَالَ عُمَرُ : لَوْ یَعْلَمُ أَحَدُکُمْ مَا لَہُ فِی قَوْلِہِ لأَخِیہِ : جَزَاک اللَّہُ خَیْرًا ، لأَکْثَرَ مِنْہَا بَعْضُکُمْ لِبَعْضٍ۔","","Musannaf Ibn Abi Shaybah 27050","","","كتاب الأدب"
"27051","(۲۷۰۵۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا أَخَذَ مَضْجَعَہُ قَالَ : اللَّہُمَّ إلَیْک أَسْلَمْت نَفْسِی ، وَإِلَیْک وَجَّہْت وَجْہِی ، وَإِلَیْک فَوَّضْت أَمْرِی ، وَإِلَیْک أَلْجَأْت ظَہْرِی ، رَغْبَۃً وَرَہْبَۃً إلَیْک ، لاَ مَلْجَأَ وَلاَ مَنْجَی مِنْک إلاَّ إلَیْک ، آمَنْت بِکِتَابِکَ الَّذِی أَنْزَلْت ، وَبِنَبِیِّکَ الَّذِی أَرْسَلْت ، أَوْ برَسُولِکَ الَّذِی أَرْسَلْت۔ (بخاری ۶۳۱۳۔ ترمذی ۳۳۹۴)","Sahih","Musannaf Ibn Abi Shaybah 27051","","","كتاب الأدب"
"27052","(۲۷۰۵۲) حَدَّثَنَا وَکِیعٌ ، عَن سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَن رِبْعِیٍّ ، عَن حُذَیْفَۃَ قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إذَا نَامَ قَالَ : اللَّہُمَّ بِاسْمِکَ أَحْیَا وَأَمُوتُ ، فَإِذَا اسْتَیْقَظَ قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَحْیَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَیْہِ النُّشُورُ۔ (بخاری ۶۳۱۲۔ ترمذی ۳۴۱۷)","Sahih","Musannaf Ibn Abi Shaybah 27052","","","كتاب الأدب"
"27053","(۲۷۰۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ قَالَ : کُنْتُ قَاعِدًا عِنْدَ عَمَّارٍ فَأَتَاہُ رَجُلٌ فَقَالَ : أَلاَ أُعَلِّمُک کَلِمَاتٍ ، قَالَ کَأَنَّہُ یَرْفَعُہُنَّ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَخَذْت مَضْجَعَک مِنَ اللَّیْلِ فَقُلْ : اللَّہُمَّ أَسْلَمْت نَفْسِی إلَیْک ، وَوَجَّہْت وَجْہِی إلَیْکَ ، وَفَوَّضْت أَمْرِی إلَیْک ، وَأَلْجَأْت ظَہْرِی إلَیْک ، آمَنْت بِکِتَابِکَ الْمُنْزَلِ ، وَنَبِیِّکَ الْمُرْسَلِ ، نَفْسِی خَلَقْتہَا ، لَکَ مَحْیَاہَا وَمَمَاتُہَا ، فَإِنْ کَفَتَّہا فَارْحَمْہَا ، وَإِنْ أَخَّرْتہَا فَاحْفَظْہَا بِحِفْظِ الإِیمَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 27053","","","كتاب الأدب"
"27054","(۲۷۰۵۴) حَدَّثَنَا غُنْدَرٌ ، عَن شُعْبَۃَ ، عَن یَعْلَی بْنِ عَطَائٍ ، قَالَ : سَمِعْتُ عَمْرَو بْنَ عَاصِمٍ یُحَدِّثُ أَنَّہُ سَمِعَ أَبَا ہُرَیْرَۃَ ، أَنَّ أَبَا بَکْرٍ قَالَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَخْبِرْنِی بِشَیْئٍ أَقُولُہُ إذَا أَمْسَیْت وَإِذَا أَصْبَحْت ، قَالَ: قُلِ اللَّہُمَّ ، عَالِمَ الْغَیْبِ وَالشَّہَادَۃِ ، فَاطِرَ السَّمَاوَاتِ وَالأَرْضِ ، رَبَّ کُلِّ شَیْئٍ وَمَلِیکَہُ ، أَشْہَدُ أَنْ لاَ إلَہَ إلاَّ أَنْتَ ، أَعُوذُ بِکَ مِنْ شَرِّ نَفْسِی وَمِنَ الشَّیْطَانِ وَشِرْکِہِ ، قُلْہُ إذَا أَصْبَحْت وَإِذَا أَمْسَیْت ، وَإِذَا أَخَذْت مَضْجَعَک۔ (نسائی ۷۷۱۵۔ دارمی ۲۶۸۹)","Sahih","Musannaf Ibn Abi Shaybah 27054","","","كتاب الأدب"
