hadiths[22]{hadithnumber,text}:
"3706","زید بن ثابت رضی الله عنہ روایت کرتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: رقبیٰ لاگو ہو گا ۱؎۔"
"3707","زید بن ثابت رضی الله عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے رقبیٰ کو اسی کا حق قرار دیا ہے جسے رقبیٰ کیا گیا ہے ۱؎۔"
"3708","عبداللہ بن عباس رضی الله عنہما کہتے ہیں کہ رقبیٰ ( مصلحتاً جائز ) نہیں ہے ( لیکن اگر کسی نے کر دیا ہے ) تو جسے رقبیٰ کیا گیا ہے اس کے ورثاء کو میراث میں ملے گا، دینے والے کو واپس نہ ہو گا۔"
"3709","عبداللہ بن عباس رضی الله عنہما سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”تم اپنے مال کا رقبیٰ نہ کرو، اور جس نے کسی چیز کا رقبیٰ کیا تو وہ چیز اسی کی ہو گی جس کو وہ بطور رقبیٰ دی گئی“۔"
"3710","عبداللہ بن عباس رضی الله عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ ۱؎ لاگو ہو گا، اور وہ اسی کا حق ہو گا جسے وہ عمریٰ کیا گیا ہے، اور رقبیٰ لاگو ہو گا، اور یہ اسی کا ہو گا جسے وہ رقبیٰ کیا گیا ہو اور اپنا ہبہ کر کے واپس لینے والا قے کر کے چاٹنے والے کی طرح ہے“۔"
"3711","عبداللہ بن عباس رضی الله عنہما کہتے ہیں کہ عمریٰ اور رقبیٰ دونوں برابر ہیں ( ان میں کچھ فرق نہیں ) ۔"
"3712","عبداللہ بن عباس رضی الله عنہما کہتے ہیں کہ رقبیٰ اور عمریٰ جائز نہیں ہیں ۱؎ لیکن اگر کسی نے کوئی چیز عمریٰ کسی کو دی تو وہ اسی کی ہو جائے گی جسے عمریٰ میں دی گئی ہے، اور جس نے کسی کو کوئی چیز رقبیٰ کی تو وہ چیز اس کی ہو جائے گی جسے اس نے رقبیٰ کی ہے۔"
"3713","عبداللہ بن عباس رضی الله عنہما کہتے ہیں کہ عمریٰ اور رقبیٰ کرنا جائز نہیں، لیکن جس کسی نے کسی کو کوئی چیز عمریٰ یا رقبیٰ میں دی تو جس کو دی ہے وہ چیز اسی کی ہو جائے گی، اس کی زندگی میں اور اس کے مرنے کے بعد بھی ( یعنی مرنے کے بعد اس کے ورثہ کو ملے گی ) ۔ حنظلہ نے اس حدیث کو مرسلاً بیان کیا ہے۔"
"3714","طاؤس کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”رقبیٰ کرنا جائز نہیں، لیکن جس کسی کو رقبیٰ میں کوئی چیز دی گئی تو ( وہ چیز اسی کی ہو گی اور ) اس میں میراث نافذ ہو گی“۔"
"3715","زید بن ثابت رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ میراث ہے“ ۱؎۔"
"3716","زید بن ثابت رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ وارث کا حق ہے“ ۱؎۔"
"3717","زید بن ثابت رضی الله عنہ نبی اکرم صلی اللہ علیہ وسلم سے روایت کرتے ہیں کہ آپ صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ لاگو ہو گا“۔"
"3718","زید بن ثابت رضی الله عنہ نبی اکرم صلی اللہ علیہ وسلم سے روایت کرتے ہیں کہ آپ صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ وارث کا حق ہے“۔"
"3719","زید بن ثابت رضی الله عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ وارث کا حق ہے“، واللہ اعلم ( اللہ زیادہ بہتر جانتا ہے ) ۔"
"3720","زید بن ثابت رضی الله عنہ نبی اکرم صلی اللہ علیہ وسلم سے روایت کرتے ہیں کہ آپ صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ وارث کا حق ہے“ ۱؎۔"
"3721","زید بن ثابت رضی الله عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ وارث کا حق ہے“۔"
"3722","زید بن ثابت رضی الله عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے عمریٰ کا فیصلہ وارث کے حق میں کیا۔"
"3723","زید بن ثابت رضی الله عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: ”جس نے کوئی چیز ( صرف ) عمر بھر کے لیے دی تو وہ چیز جس کو دی ہے اس کی ہو جائے گی، اس کی زندگی میں بھی اور اس کے مر جانے کے بعد بھی ( رسول اللہ صلی اللہ علیہ وسلم نے فرمایا ) رقبیٰ نہ کرو کیونکہ جس نے رقبیٰ کیا ہے ( وہ اسے نہ ملے گی ) وہ موہوب لہ کے راستہ ہی میں رہے گی“ ۱؎۔"
"3724","عبداللہ بن عباس رضی الله عنہما سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ نافذ ہو گا“ ۱؎۔"
"3725","عبداللہ بن عباس رضی الله عنہما نبی اکرم صلی اللہ علیہ وسلم سے روایت کرتے ہیں کہ آپ صلی اللہ علیہ وسلم نے فرمایا: ”عمریٰ نافذ ہو گا“۔"
"3726","طاؤس کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے عمریٰ اور رقبیٰ کو کاٹ کر الگ کر دیا ۱؎۔"
"3727","جابر رضی الله عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے لوگوں کو خطبہ دیا تو فرمایا: ”عمریٰ نافذ ہو گا“۔"