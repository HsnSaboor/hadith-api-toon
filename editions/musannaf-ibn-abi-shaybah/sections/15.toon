"14830","(۱۴۸۳۰) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : إِذَا شَمَّ الْمُحْرِمُ رَیْحَانًا ، أَوْ مَسَّ طِیبًا أَہْرَاقَ لِذَلِکَ دَمًا۔","","Musannaf Ibn Abi Shaybah 14830","","","كتاب الحج"
"14831","(۱۴۸۳۱) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : فِی الطِّیبِ الْفِدْیَۃُ ، وَفِی الصَّیْدِ الْجَزَائُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14831","","","كتاب الحج"
"14832","(۱۴۸۳۲) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِذَا شَمَّ الْمُحْرِمُ طِیبًا ،کَفَّرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14832","","","كتاب الحج"
"14833","(۱۴۸۳۳) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : إِذَا وَضَعَ الْمُحْرِمُ عَلَی شَیْئٍ مِنْہُ دُہْنًا فِیہِ طِیبٌ ، فَعَلَیْہِ الْکَفَّارَۃُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14833","","","كتاب الحج"
"14834","(۱۴۸۳۴) حدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ، قَالاَ : لاَ بَأْسَ أَنْ یَتَدَاوَی الْمُحْرِمُ بِالْحِنَّائِ ، وَکَرِہَا أَنْ یَخْتَضِبَ بِہَا۔","","Musannaf Ibn Abi Shaybah 14834","","","كتاب الحج"
"14835","(۱۴۸۳۵) حدَّثَنَا وَکِیعً، عَنْ شَرِیکٌ، عَنْ عَبْدِالْکَرِیمِ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: لاَ بَأْسَ أَنْ یَتَدَاوَی الْمُحْرِمُ بِالْحِنَّائِ۔","","Musannaf Ibn Abi Shaybah 14835","","","كتاب الحج"
"14836","(۱۴۸۳۶) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ حَمَّادٍ ، قَالَ : لاَ یَخْتَضِبُ الْمُحْرِمُ بِالْحِنَّائِ ، وَلاَ یَتَوَضَّأُ بِدسبسان۔","","Musannaf Ibn Abi Shaybah 14836","","","كتاب الحج"
"14837","(۱۴۸۳۷) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مِنَ السُّنَّۃِ أَنْ لاَ یُہِلَّ بِالْحَجِّ ، إِلاَّ فِی أَشْہُرِ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 14837","","","كتاب الحج"
"14838","(۱۴۸۳۸) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لاَ یُحْرِمُ بِالْحَجِّ ، إِلاَّ فِی أَشْہُرِ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 14838","","","كتاب الحج"
"14839","(۱۴۸۳۹) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ؛ قَالُوا : لاَ یُحْرِمُ بِالْحَجِّ ، إِلاَّ فِی أَشْہُرِ الْحَجِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 14839","","","كتاب الحج"
"14840","(۱۴۸۴۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ ، قَالَ : قدِمَ رَجُلٌ مِنْ أَہْلِ خُرَاسَانَ ، قَدْ أَحْرَمَ بِالْحَجِّ فِی غَیْرِ أَشْہُرِ الْحَجِّ ، فَقَالَ لَہُ عَطَائٌ : اجْعَلْہَا عُمْرَۃً ، فَإِنَّہُ لَیْسَ لَکَ حَجٌّ ، فَإِنَّ اللَّہَ تَعَالَی یَقُولُ : {الْحَجُّ أَشْہُرٌ مَعْلُومَاتٌ فَمَنْ فَرَضَ فِیہِنَّ الْحَجَّ}۔","","Musannaf Ibn Abi Shaybah 14840","","","كتاب الحج"
"14841","(۱۴۸۴۱) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ عَطَائٍ ، قَالَ : قدِمَ رَجُلٌ مُہِلاَّ بِالْحَجِّ فِی غَیْرِ أَشْہُرِ الْحَجِّ ، فَأَمَرَہُ عَطَائٌ أَنْ یَجْعَلَہَا عُمْرَۃً۔","","Musannaf Ibn Abi Shaybah 14841","","","كتاب الحج"
"14842","(۱۴۸۴۲) حدَّثَنَا شَرِیکٌ ، وَہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ فِی رَجُلٍ أَہَلَّ بِالْحَجِّ فِی غَیْرِ أَشْہُرِ الْحَجِّ ، قَالَ شَرِیکٌ : یَمْضِی ، وَقَالَ ہُشَیْمٌ : یَلْزَمُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14842","","","كتاب الحج"
"14843","(۱۴۸۴۳) حدَّثَنَا شَرِیکٌ ، عَنْ یَزِیدَ الدَّالاَنِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَحِلُّ ، أَوْ یُہِلَّ بِعُمْرَۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14843","","","كتاب الحج"
"14844","(۱۴۸۴۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ ابْنُ أَبِی نُعْمٍ یُہِلُّ بِالْحَجِّ فِی غَیْرِ أَشْہُرِ الْحَجِّ، فَقَالَ عَمْرُو بْنُ مَیْمُونٍ : لَوْ أَدْرَکَ ہَذَا أَصْحَابُ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَرَجَمُوہُ۔","","Musannaf Ibn Abi Shaybah 14844","","","كتاب الحج"
"14845","(۱۴۸۴۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ؛ أَنَّ أَبَا الْحَکَمِ الْبَجَلِیَّ کَانَ یُہِلُّ بِالْحَجِّ فِی غَیْرِ أَشْہُرِ الْحَجِّ ، قَالَ : فَلَقِیَہُ عِکْرِمَۃُ ، فَقَالَ : أَنْتَ رَجُلُ سُوئٍ۔","","Musannaf Ibn Abi Shaybah 14845","","","كتاب الحج"
"14846","(۱۴۸۴۶) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ؛ أَنَّہُمْ کَانُوا لاَ یَرَوْنَ بَأْسًا أَنْ یَشْرَبَ الرَّجُلُ وَہُوَ یَطُوفُ بِالْبَیْتِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14846","","","كتاب الحج"
"14847","(۱۴۸۴۷) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ، عَنْ رَجُلٍ مِنْ آلِ الْوَدَاعِ ، قَالَ : اسْتَسْقَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَطُوفُ بِالْبَیْتِ ، فَقَالَ رَجُلٌ : أَلاَ نَسْقِیکَ مِنْ شَرَابٍ نَصْنَعُہُ ؟ فَأَتَاہُ بِإِنَائٍ فِیہِ نَبِیذُ زَبِیبٍ ، فَقَالَ : أَلاَ أَکْفَأْتَ عَلَیْہِ إنَائً ، أَوْ عَرَضْتَ عَلَیْہِ عُودًا ؟ ثُمَّ شَرِبَ مِنْہُ فَقَطَّبَ ، ثُمَّ دَعَا بِمَائٍ فَصَبَّہُ فِیہِ فَشَرِبَ ؟ وَسَقَی أَصْحَابَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 14847","","","كتاب الحج"
"14848","(۱۴۸۴۸) حدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ، عَنْ عَطَائٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لاَ بَأْسَ بِالشُّرْبِ فِی الطَّوَافِ۔","Hasan","Musannaf Ibn Abi Shaybah 14848","","","كتاب الحج"
"14849","(۱۴۸۴۹) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ خَالِدِ بْنِ سعْدٍ ، عَنْ أَبِی مَسْعُودٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اسْتَسْقَی وَہُوَ یَطُوفُ بِالْبَیْتِ ، فَأُتِیَ بِذَنُوبٍ مِنْ نَبِیذِ السِّقَایَۃِ فَشَرِبَہ۔","Hasan","Musannaf Ibn Abi Shaybah 14849","","","كتاب الحج"
"14850","(۱۴۸۵۰) حدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ دَلَّ حَرَامٌ حَلاَلاً عَلَی صَیْدٍ فَلَمْ یَأْخُذْہُ ، فَلْیَسْتَغْفِرِ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 14850","","","كتاب الحج"
"14851","(۱۴۸۵۱) حدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لَیْسَ عَلَیْہِ شَیْئٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14851","","","كتاب الحج"
"14852","(۱۴۸۵۲) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : قَالَ عُمَرُ : لِیَکُنْ آخِرُ عَہْدِکُمْ بِالْبَیْتِ ، وَلِیَکُنْ آخِرُ عَہْدِکُمْ مِنَ الْبَیْتِ بِالْحَجَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 14852","","","كتاب الحج"
"14853","(۱۴۸۵۳) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : بِأَیِّ شَیْئٍ یَکُونُ آخِرُ عَہْدِی مِنَ الْبَیْتِ ؟ قَالَ : فَقَالَ : بِالْحَجَرِ۔","","Musannaf Ibn Abi Shaybah 14853","","","كتاب الحج"
"14854","(۱۴۸۵۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانُوا یَسْتَحِبُّونَ إِذَا وَدَّعُوا ، أَنْ یَکُونَ آخِرُ عَہْدِہِمْ بِالْحَجَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14854","","","كتاب الحج"
"14855","(۱۴۸۵۵) حدَّثَنَا جَرِیرٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : إِذَا اضْطُرَّ الْمُحْرِمُ إِلَی لُبْسِ الْخُفَّیْنِ ، خَرَقَ ظُہُورَہُمَا وَتَرَکَ فِیہِمَا قَدْرَ مَا تَسْتَمْسِکُ رِجْلاَہُ۔","","Musannaf Ibn Abi Shaybah 14855","","","كتاب الحج"
"14856","(۱۴۸۵۶) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا اضْطُرَّ الْمُحْرِمُ إِلَی الْخُفَّیْنِ ،خَرَقَہُمَا وَتَرَکَ فِیہِمَا قَدْرَ الشِّرَاکِ ، وَیَقْطَعُہُمَا مِنْ قِبَلِ کَعْبَیْہِ۔","","Musannaf Ibn Abi Shaybah 14856","","","كتاب الحج"
"14857","(۱۴۸۵۷) حدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْن بُرْقَانَ ، قَالَ : قَالَ نَافِعٌ : یَقْطَعُ الْخُفَّیْنِ أَسْفَلَ مِنَ الْکَعْبَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14857","","","كتاب الحج"
"14858","(۱۴۸۵۸) حدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : یَتَخَفَّفُ إِذَا لَمْ یَجِدْ نَعْلَیْنِ ، قَالَ : قُلْتُ : أَیَشُقُّہُمَا ؟ قَالَ : إِنَّ اللَّہَ لاَ یُحِبُّ الْفَسَادَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14858","","","كتاب الحج"
"14859","(۱۴۸۵۹) حدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کان یُرَخِّصُ لِلْمُحْرِمِ أَنْ یَلْبَسَ خُفَّیْنِ ،لَیْسَا بِمَقْطُوعَیْنِ۔","","Musannaf Ibn Abi Shaybah 14859","","","كتاب الحج"
"14860","(۱۴۸۶۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنْ لَمْ یَجِدْ نَعْلَیْنِ لَبِسَ الْخُفَّیْنِ أَسْفَلَ مِنَ الْکَعْبَیْنِ۔ (بخاری ۵۷۹۴۔ ابوداؤد ۱۸۲۱)","Sahih","Musannaf Ibn Abi Shaybah 14860","","","كتاب الحج"
"14861","(۱۴۸۶۱) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالْمُطَلَّقَاتِ ثَلاَثًا ، وَالْمُتَوَفَّی عَنْہُنَّ أَزْوَاجُہُنَّ أَن یَحْجُجْنَ فِی عِدَّتِہِنَّ۔","","Musannaf Ibn Abi Shaybah 14861","","","كتاب الحج"
"14862","(۱۴۸۶۲) حدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ ، عَنِ الْقَاسِمِ (ح) وَعَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عَطَائٍ ؛ أَنَّ عَائِشَۃَ أَحَجَّتْ أُمَّ کُلْثُومٍ فِی عِدَّتِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 14862","","","كتاب الحج"
"14863","(۱۴۸۶۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ أَنْ تَحُجَّ فِی عِدَّتِہَا۔","","Musannaf Ibn Abi Shaybah 14863","","","كتاب الحج"
"14864","(۱۴۸۶۴) حدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حَبِیبٍ الْمُعَلِّمِ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الْمُطَلَّقَۃِ ثَلاَثًا ، وَالْمُتَوَفَّی عَنْہَا ، تَحُجَّانِ فِی عِدَّتِہِمَا ؟ فَقَالَ : نَعَمْ ، قَالَ حَبِیبٌ : وَکَانَ الْحَسَنُ یَقُولُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 14864","","","كتاب الحج"
"14865","(۱۴۸۶۵) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ (ح) وَعَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ عُمَرَ رَدَّ نِسْوَۃً حَاجَّاتٍ ، أَوْ مُعْتَمِرَاتٍ ، خَرَجْنَ فِی عِدَّتِہِنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 14865","","","كتاب الحج"
"14866","(۱۴۸۶۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْمِقْدَامِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الْمُتَوَفَّی عَنْہَا ، وَالْمُطَلَّقَۃُ ثَلاَثًا ، لاَ تَحُجُّ ، وَلاَ تَعْتَمِرُ ، وَلاَ تَلْبَسُ مُجَسِّدًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14866","","","كتاب الحج"
"14867","(۱۴۸۶۷) حدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ حُمَیْدٍ الأَعْرَجِ ، عَنْ مُجَاہِدٍ ؛ أَنَّ عُمَرَ ،وَعُثْمَانَ رَدَّا نِسْوَۃً حَاجَّاتٍ وَمُعْتَمِرَاتٍ ، حَتَّی اعْتَدَدْنَ فِی بُیُوتِہِنَّ۔","","Musannaf Ibn Abi Shaybah 14867","","","كتاب الحج"
"14868","(۱۴۸۶۸) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ؛ فِی صَبِیٍّ أَصَابَ حَمَامَۃً مِنْ حَمَامِ الْحَرَمِ، فَقَالَ : اذْبَحْ عَنِ ابْنِکَ شَاۃً۔","","Musannaf Ibn Abi Shaybah 14868","","","كتاب الحج"
"14869","(۱۴۸۶۹) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ أَبِیہِ ، قَالَ : قدِمْنَا وَنَحْنُ غِلْمَانٌ مَعَ حَفْصِ بْنِ عَاصِمٍ ، فَأَخَذْنَا فَرْخًا بِمَکَّۃَ فِی مَنْزِلِنَا ، فَلَعِبنَا وَعَبَثْنا بِہِ حَتَّی قَتَلْنَاہُ ، فَقَالَتْ لَہُ أمْرَأَتُہُ عَائِشَۃُ ابْنَۃُ مُطِیعُ بْنُ الأَسْوَدِ ، فَأَمَرَ بِکَبْشٍ فَذُبِحَ ، فَتَصَدَّقَ بِہِ۔","","Musannaf Ibn Abi Shaybah 14869","","","كتاب الحج"
"14870","(۱۴۸۷۰) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : عَبَثَ بَعْضُ بَنِی عُرْوَۃَ بِفَرْخٍ مِنْ حَمَامِ مَکَّۃَ ، فَأَمَرَ أَبِی بِشَاۃٍ فَذُبِحَتْ ، ثُمَّ تَصَدَّقَ بِہَا۔","","Musannaf Ibn Abi Shaybah 14870","","","كتاب الحج"
"14871","(۱۴۸۷۱) حدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : إِنْ أَصَابَ شَیْئًا مِنَ الصَّیْدِ ، یَعْنِی الصَّبِیَّ ، کَانَ عَلَی الَّذِی یَحُجُّ بِہِ۔","","Musannaf Ibn Abi Shaybah 14871","","","كتاب الحج"
"14872","(۱۴۸۷۲) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : {وَالْبُدْنَ جَعَلْنَاہَا لَکُمْ مِنْ شَعَائِرِ اللہِ} مَا الْبَدَنَۃُ ؟ قَالَ : الْبَعِیرُ وَالْبَقَرَۃُ۔","","Musannaf Ibn Abi Shaybah 14872","","","كتاب الحج"
"14873","(۱۴۸۷۳) حدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَمَّنْ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : الْبَعِیرُ وَالْبَقَرَۃُ۔","","Musannaf Ibn Abi Shaybah 14873","","","كتاب الحج"
"14874","(۱۴۸۷۴) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تَکُونُ الْبُدْنُ إِلاَّ مِنَ الإِبِلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14874","","","كتاب الحج"
"14875","(۱۴۸۷۵) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قَالَ الْقَاسِمُ بْنُ مُحَمَّدٍ : إِنَّ الشَّاۃَ لَنْ تَعْدُوَ أَنْ تَکُونَ نَسِیکَۃ ، وَإِنَّ الْبَقَرَۃَ مِنَ الْبُدْنِ۔","","Musannaf Ibn Abi Shaybah 14875","","","كتاب الحج"
"14876","(۱۴۸۷۶) حدَّثَنَا وَکِیعٌ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ الْکَرِیمِ ، قَالَ : اخْتَلَفَ عَطَائٌ ، وَالْحَکَمُ ، فَقَالَ عَطَائٌ : ہِیَ مِنَ الإِبِلِ وَالْبَقَرِ ، وَقَالَ الْحَکَمُ : ہِیَ مِنَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 14876","","","كتاب الحج"
"14877","(۱۴۸۷۷) حدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ سُلَیْمَانَ بْنِ یَعْقُوبَ ، عَنْ أَبِیہِ ، قَالَ : مَاتَ رَجُلٌ مِنَ الْحَیِّ وَأَوْصَی أَنْ یُنْحَرَ عَنْہُ بَدَنَۃٌ ، فَسَأَلْتُ ابْنَ عَبَّاسٍ عَنِ الْبَقَرَۃِ ؟ فَقَالَ : تُجْزِء ، قَالَ : قُلْتُ : مِنْ أَیٍّ قَوْمٍ أَنْتَ ؟ قَالَ : قُلْتُ : مِنْ بَنِی رَبَاحٍ ، قَالَ : وَأَنَّی لِبَنِی رَبَاحٍ الْبَقَرُ ؟ إِنَّمَا الْبَقَرُ لِلأَزْدِ ، وَعَبْدِ الْقَیسِ۔","Da'if","Musannaf Ibn Abi Shaybah 14877","","","كتاب الحج"
"14878","(۱۴۸۷۸) حدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ رَجُلٍ لَمْ یَکُنْ یُسَمِّیہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ؛ أَنَّہُ کَانَ یَطُوفُ مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ لَہُ : کَمْ تَعُدُّ ؟ ثُمَّ قَالَ : إِنَّمَا سَأَلْتُکَ لِتَحْفَظَ۔","Da'if","Musannaf Ibn Abi Shaybah 14878","","","كتاب الحج"
"14879","(۱۴۸۷۹) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ صَالِحِ بْنِ دِرْہَمٍ ، قَالَ : سَمِعْتُ عبْدَ اللہِ بْنَ عُمَرَ ، وَسُئِلَ عَنِ السَّعْیِ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ؟ فَقَالَ ابْنُ عُمَرَ لِلسَّائِلِ : افْتَتِحْ بِالصَّفَا وَاخْتُمْ بِالْمَرْوَۃِ ، فَإِنْ خَشِیتَ أَنْ لاَ تُحْصِیَ ، فَخُذْ مَعَک أَحْجَارًا ، أَوْ حَصَیَاتٍ ، فَأَلْقَ بِالصَّفَا وَاحِدَۃً وَبِالْمَرْوَۃِ أُخْرَی۔","Sahih","Musannaf Ibn Abi Shaybah 14879","","","كتاب الحج"
"14880","(۱۴۸۸۰) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ؛ أَنَّ سَعِیدَ بْنَ جُبَیْرٍ رَأَی امْرَأَۃً تَطُوفُ بِیَدِہَا حَصَیَاتٌ تَعُدُّ الطَّوَافَ ، فَضَرَبَ یَدَہَا۔","","Musannaf Ibn Abi Shaybah 14880","","","كتاب الحج"
"14881","(۱۴۸۸۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْہَیْثُمِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کُنَّا نَطُوفُ وَعَلَیْنَا خَوَاتِمُنَا ، نَحْفَظُ بِہَا الأَسْبَاعَ۔","","Musannaf Ibn Abi Shaybah 14881","","","كتاب الحج"
"14882","(۱۴۸۸۲) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ إِبْرَاہِیمَ بْنِ أَبِی حَبِیبَۃَ ، عَنْ دَاوُدَ بْنِ الْحُصَیْنِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَرْفَعُ الْمَرْأَۃُ صَوْتَہَا بِالتَّلْبِیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 14882","","","كتاب الحج"
"14883","(۱۴۸۸۳) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ أَبِی الْجُوَیْرِیَۃِ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 14883","","","كتاب الحج"
"14884","(۱۴۸۸۴) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ تَجْہَرُ الْمَرْأَۃُ بِالتَّلْبِیَۃِ۔","","Musannaf Ibn Abi Shaybah 14884","","","كتاب الحج"
"14885","(۱۴۸۸۵) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : خَرَجَ مُعَاوِیَۃُ لَیْلَۃَ النَّفْرِ فَسَمِعَ صَوْتَ تَلْبِیَۃٍ ، فَقَالَ : مَنْ ہَذَا ؟ قَالُوا : عَائِشَۃُ ، اعْتَمَرَتْ مِنَ التَّنْعِیمِ ، فَذُکِرَ ذَلِکَ لِعَائِشَۃَ ، فَقَالَتْ : لَوْ سَأَلَنِی لأَخْبَرْتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14885","","","كتاب الحج"
"14886","(۱۴۸۸۶) حدَّثَنَا عُمَرُ ، عَنْ عِیسَی بْنِ أَبِی عِیسَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لَیْسَ عَلَی النِّسَائِ أَنْ یَرْفَعْنَ أَصْوَاتَہُنَّ بِالتَّلْبِیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 14886","","","كتاب الحج"
"14887","(۱۴۸۸۷) حدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ یَزِیدَ بْنِ عَبْدِ الْمَلِکِ ، عَنِ الْمُغِیرَۃِ بْنِ نَوْفَلٍ ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ ، قَالَ : سُئِلَ أُبَیّ بْنُ کَعْبٍ : ہَلْ یُزَرِّرُ الْمُحْرِمُ عَلَیْہِ طَیْلَسَانًا ؟ قَالَ : لاَ۔","Da'if","Musannaf Ibn Abi Shaybah 14887","","","كتاب الحج"
"14888","(۱۴۸۸۸) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ قَتَادَۃَ یُحَدِّثُ عَنْ یُونُسَ بْنِ جُبَیْرٍ ؛ فِی الطَّیْلَسَانِ الْمُزَرَّرِ لِلْمُحْرِمِ ، قَالَ : یَنْزِعُ أَزْرَارَہُ۔","","Musannaf Ibn Abi Shaybah 14888","","","كتاب الحج"
"14889","(۱۴۸۸۹) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ أَبِی إِسْمَاعِیلَ ، قَالَ : سُئِلَ سَعِیدُ بْنُ جُبَیْرٍ عَنِ الطَّیْلَسَانِ ، یَزرَّہُ الْمُحْرِمُ ؟ فَقَالَ : لاَ تَزْرُرْہُ عَلَیْکَ ، وَلاَ بَأْسَ بِالطَّیْلَسَانِ۔","","Musannaf Ibn Abi Shaybah 14889","","","كتاب الحج"
"14890","(۱۴۸۹۰) حدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ، عَنِ ابْنِ سُوقَۃَ، قَالَ: رَأَی عَلَیَّ سَعِیدُ بْنُ جُبَیْرٍ طَیْلَسَانًا، کَأَنَّ فِیہِ أَزْرَارَ دِیبَاجٍ نَزَعْتُہَا ، فَقَالَ : لِمَ نَزَعْتَہَا ؟ فَقُلْتُ لَہُ : قَالَ لِی أَصْحَابِی : أَتَلْبَسُ ہَذَا وَأَنْتَ مُحْرِمٌ ، فَقَالَ : وَمَا یَضُرُّک۔","","Musannaf Ibn Abi Shaybah 14890","","","كتاب الحج"
"14891","(۱۴۸۹۱) حدَّثَنَا مُحَمَّدُ بْنُ سَوَّائٍ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ بُرْدٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالطَّیْلَسَانِ لِلْمُحْرِمِ ، مَا لَمْ یَزُرَّہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14891","","","كتاب الحج"
"14892","(۱۴۸۹۲) حدَّثَنَا مُحَمَّدُ بْنُ سَوَّائٍ ، عَنْ سَعِیدٍ ؛ أَنَّ الْحَسَنَ کَانَ لاَ یَرَی بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 14892","","","كتاب الحج"
"14893","(۱۴۸۹۳) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یُحْرِمُ فِی الطَّیْلَسَانِ ، أَزْرَارُہُ الدِّیبَاجُ ، وَلاَ یَزُرُّہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14893","","","كتاب الحج"
"14894","(۱۴۸۹۴) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ؛ فِی الْمُحْرِمِ یَلْبَسُ الطَّیْلَسَانَ ، قَالَ : یَلْبَسُہُ ، وَلاَ یَزُرُّہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14894","","","كتاب الحج"
"14895","(۱۴۸۹۵) حدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ ذَرٍّ ، عَنْ أَبِیہِ ؛ أَنْ سَعِیدِ بْنِ جُبَیْرٍ کَانَ یُحْرِمُ فِی الطَّیْلَسَانِ المُدَبجِ ، وَأَنَّ أَبِی کَانَ یَفْعَلُہُ۔","","Musannaf Ibn Abi Shaybah 14895","","","كتاب الحج"
"14896","(۱۴۸۹۶) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُحْرِمُ فِی الطَّیْلَسَانِ ، وَلاَ یَزُرُّہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14896","","","كتاب الحج"
"14897","(۱۴۸۹۷) حدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ بَأْسَ أَنْ یُحْرِمَ فِیہِ ، وَلاَ یَزُرَّہُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14897","","","كتاب الحج"
"14898","(۱۴۸۹۸) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَکَّۃُ حَرَمٌ حَرَّمَہَا اللَّہُ تَعَالَی ، لاَ یَحِلَّ بَیْعُ رِبَاعِہَا ، وَلاَ إِجَارَۃُ بُیُوتِہَا۔","","Musannaf Ibn Abi Shaybah 14898","","","كتاب الحج"
"14899","(۱۴۸۹۹) حدَّثَنَا شَرِیکٌ ، عَنْ إِبْرَاہِیمَ بْنِ الْمُہَاجِرِ ، عَنْ مُجَاہِدٍ ، قَالَ : بُیُوتُ مَکَّۃَ لاَ تَحِلُّ إِجَارَتُہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 14899","","","كتاب الحج"
"14900","(۱۴۹۰۰) حدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أُجُورَ بُیُوتِ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14900","","","كتاب الحج"
"14901","(۱۴۹۰۱) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنِ الْقَاسِمِ، قَالَ: مَنْ أَکَلَ شَیْئًا مِنْ کِرَائِ مَکَّۃَ ، فَإِنَّمَا یَأْکُلُ نَارًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14901","","","كتاب الحج"
"14902","(۱۴۹۰۲) حدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَنَا قَرَأْتُ کِتَابَ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ عَلَی النَّاسِ بِمَکَّۃَ ، یَنْہَاہُمْ عَنْ کِرَائِ بُیُوتِ مَکَّۃَ وَدُورِہَا۔","","Musannaf Ibn Abi Shaybah 14902","","","كتاب الحج"
"14903","(۱۴۹۰۳) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی زِیَادٍ ، عَنِ أَبِی نَجِیحٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : الَّذِینَ یَأْکُلُونَ أُجُورَ بُیُوتِ مَکَّۃَ إنَّمَا یَأْکُلُونَ فِی بُطُونِہِمْ نَارًا۔","Da'if","Musannaf Ibn Abi Shaybah 14903","","","كتاب الحج"
"14904","(۱۴۹۰۴) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ عُمَرُ یَمْنَعُ أَہْلَ مَکَّۃَ أَنْ یَجْعَلُوا لَہَا أَبْوَابًا ، حَتَّی یَنْزِلَ الْحَاجُّ فِی عَرَصَاتِ الدُّورِ۔","","Musannaf Ibn Abi Shaybah 14904","","","كتاب الحج"
"14905","(۱۴۹۰۵) حدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : لَمْ یَکُنْ لِلدُّورِ بِمَکَّۃَ أَبْوَابٌ ، کَانَ أَہْلُ مِصْرَ وَأَہْلُ الْعِرَاقِ یَأْتُونَ بِفُطْرَاتِہِمْ فَیَدْخُلُونَ دُورَ مَکَّۃَ۔","","Musannaf Ibn Abi Shaybah 14905","","","كتاب الحج"
"14906","(۱۴۹۰۶) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ ہِشَامٍ بن حُجَیْرٍ ، قَالَ : کَانَ لِی بَیْتٌ بِمَکَّۃَ فَکُنْتُ أَکْرِیہِ ، فَسَأَلْتُ طَاوُوسًا ؟ فَأَمَرَنِی أَنْ آکُلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14906","","","كتاب الحج"
"14907","(۱۴۹۰۷) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُمَرَ بْنِ سَعِیدِ بْنِ أَبِی حُسَیْنٍ ، قَالَ : أَخْبَرَنِی مَنْ سَمِعَ مُجَاہِدًا یَقُولُ : لاَ أَرَی بِکِرَائِ بُیُوتِ مَکَّۃَ بَأْسًا ، إِلاَّ أَنْ یَتَکَارَی رَجُلٌ فَیَتَرَبَّحَ۔","","Musannaf Ibn Abi Shaybah 14907","","","كتاب الحج"
"14908","(۱۴۹۰۸) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَوَّارٍ ، عَنِ الْوَلِیدِ بْنِ أَبِی ہِشَامٍ ، قَالَ : قَالَ عُثْمَانُ : رِبَاعِی الَّتِی بِمَکَّۃَ یَسْکُنُہَا بَنِیَّ ، وَیُسْکِنُونَہَا مَنْ أَحَبَّوا۔","","Musannaf Ibn Abi Shaybah 14908","","","كتاب الحج"
"14909","(۱۴۹۰۹) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ، وَطَاوُوسٍ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَبِیعُوا شَیْئًا مِنْ رِبَاعِ مَکَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14909","","","كتاب الحج"
"14910","(۱۴۹۱۰) حدَّثَنَا شَرِیکٌ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یَحِلُّ بَیْعُ رِبَاعِہَا۔","","Musannaf Ibn Abi Shaybah 14910","","","كتاب الحج"
"14911","(۱۴۹۱۱) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، رَفَعَہُ ، قَالَ : لاَ یَحِلُّ بَیْعُ رِبَاعِہَا۔","","Musannaf Ibn Abi Shaybah 14911","","","كتاب الحج"
"14912","(۱۴۹۱۲) حدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عُمَرَ بْنِ سَعِیدِ بْنِ أَبِی حُسَیْنٍ ، عَنْ عُثْمَانَ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَلْقَمَۃَ بْنِ نَضْلَۃَ ، قَالَ : کَانَتْ رِبَاعُ مَکَّۃَ فِی زَمَانِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَزَمَانِ أَبِی بَکْرٍ ، وَعُمَرَ تُسَمَّی السَّوَائِبُ ، مَنِ احْتَاجَ سَکَنَ ، وَمَنِ اسْتَغْنَی أَسْکَنَ۔ (ابن ماجہ ۳۱۰۷)","","Musannaf Ibn Abi Shaybah 14912","","","كتاب الحج"
"14913","(۱۴۹۱۳) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اعْتَمَرَ عَامَ الْفَتْحِ مِنَ الْجِعْرَانَۃِ ، فَلَمَّا فَرَغَ مِنْ عُمْرَتِہِ اسْتَخْلَفَ أَبَا بَکْرٍ عَلَی مَکَّۃَ ، وَأَمَرَہُ أَنْ یُعَلِّمَ النَّاسَ الْمَنَاسِکَ ، وَأَنْ یُؤَذِّنَ فِی النَّاسِ : مَنْ حَجَّ الْعَامَ فَہُوَ آمِنٌ ، وَلاَ یَحُجُّ بَعْدَ الْعَامِ مُشْرِکٌ ، وَلاَ یَطُوفُ بِالْبَیْتِ عُرْیَانٌ۔","","Musannaf Ibn Abi Shaybah 14913","","","كتاب الحج"
"14914","(۱۴۹۱۴) حدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَ أَعْرَابِیٌّ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : السَّلاَمُ عَلَیْک یَا غُلاَمَ بَنِی عَبْدِ الْمُطَّلِبِ ، فَقَالَ : وَعَلَیْکَ ، فَقَالَ : إِنِّی رَجُلٌ مِنْ أَخْوَالِکَ مِنْ بَنِی سَعْدِ بْنِ بَکْرٍ ، وَإِنِّی رَسُولُ قَوْمِی إِلَیْک وَوَافِدُہُمْ ، وَإِنِّی سَائِلُکَ فَمُشْتَدَّۃٌ مَسْأَلَتِی إِیَّاکَ ، وَمُنَاشِدُکَ فَمُشْتَدَّۃٌ مُنَاشَدَتِی إِیَّاکَ ، قَالَ : خُذْ عَنْکَ یَا أَخَا بَنِی سَعْدٍ ، قَالَ : فَإِنَّا وَجَدْنَا فِی کِتَابِکَ ، وَأَمَرَتْنَا رُسُلُکَ أَنْ نَحُجَّ الْبَیْتَ الْعَتِیقَ ، فَأُنْشِدُکَ ، أَہُوَ أَمَرَکَ بِذَلِکَ ؟ قَالَ : نَعَمْ۔n(دارمی ۶۵۱۔ بیہقی ۴)","Da'if","Musannaf Ibn Abi Shaybah 14914","","","كتاب الحج"
"14915","(۱۴۹۱۵) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مُحَارِبٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ : وَرَدْنَا الْمَدِینَۃَ ، فَأَتَیْنَا عَبْدَ اللہِ بْنَ عُمَرَ ، فَقَالَ : کُنَّا عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَتَاہُ رَجُلٌ جَیِّدُ الثِّیَابِ ، طَیِّبُ الرِّیحِ، حَسَنُ الْوَجْہِ ، فَقَالَ : السَّلاَمُ عَلَیْک یَا رَسُولَ اللہِ ، فَقَالَ : وَعَلَیْک ، فَقَالَ : یَا رَسُولَ اللہِ ، أَدْنُو مِنْک ؟ فَقَالَ: اُدْنُہْ ، فَدَنَا دَنْوَۃً ، فَقُلْنَا : مَا رَأَیْنَا کَالْیَوْمِ قَطُّ رَجُلاً أَحْسَنَ ثَوْبًا ، وَلاَ أَطْیَبَ رِیحًا ، وَلاَ أَحْسَنَ وَجْہًا، وَلاَ أَشَدَّ تَوْقِیرًا لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ قَالَ : یَا رَسُولَ اللہِ ، أَدْنُو مِنْکَ ؟ قَالَ : نَعَمْ ، فَدَنَا دَنْوَۃً ، فَقُلْنَا مِثْلَ مَقَالَتِنَا ، ثُمَّ قَالَ لَہُ الثَّالِثَۃَ : أَدْنُو مِنْکَ یَا رَسُولَ اللہِ ؟ قَالَ : نَعَمْ ، حَتَّی أَلْزَقَ رُکْبَتَیْہِ بِرُکْبَۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قَالَ : یَا رَسُولَ ، مَا الإِسْلاَمُ ؟ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تُقِیمُ الصَّلاَۃَ ، وَتُؤْتِی الزَّکَاۃَ ، وَتَصُومُ رَمَضَانَ ، وَتَحُجُّ الْبَیْتَ ، وَتَغْتَسِلُ مِنَ الْجَنَابَۃِ ، قَالَ : صَدَقْتَ ، فَقُلْنَا : مَا رَأَیْنَا کَالْیَوْمِ قَطُّ رَجُلاً ، وَاللَّہِ لَکَأَنَّہُ یُعَلِّمُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۱/۵۳)","Da'if","Musannaf Ibn Abi Shaybah 14915","","","كتاب الحج"
"14916","(۱۴۹۱۶) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَجُلاً أَتَاہُ ، فَقَالَ : یَا أَبَا عَبَّاسٍ ، أَبْدَأُ بِالصَّفَا قَبْلَ الْمَرْوَۃِ ، أَوْ بِالْمَرْوَۃِ قَبْلَ الصَّفَا ؟ أَوْ أُصَلِّی قَبْلَ أَنْ أَطُوفَ ، أَوْ أَطُوفَ قَبْلَ أَنْ أُصَلِّیَ ؟ أَوْ أَذْبَحَ قَبْلَ أَنْ أَحْلِقَ ، أَوْ أَحْلِقَ قَبْلَ أَنْ أَذْبَحَ ؟ فَقَالَ ابْنُ عَبَّاسٍ : خُذْ ذَلِکَ مِنْ قِبَلِ الْقُرْآنِ ، فَإِنَّہُ أَجْدَرُ أَنْ تُحْفَظَ ، قَالَ اللَّہُ تَعَالَی : (إِنَّ الصَّفَا وَالْمَرْوَۃَ مِنْ شَعَائِرِ اللہِ) فَالصَّفَا قَبْلَ الْمَرْوَۃِ ، وَقَالَ تَبَارَکَ وَتَعَالَی : (وَلاَ تَحْلِقُوا رُؤُوسَکُمْ حَتَّی یَبْلُغَ الْہَدْیُ مَحِلَّہُ) فَقَالَ : بِالذَّبْحِ قَبْلَ الْحَلْقِ ، وَقَالَ : (طَہِّرَا بَیْتِی لِلطَّائِفِینَ وَالْعَاکِفِینَ وَالرُّکَّعِ السُّجُودِ) ، فَالطَّوَافُ قَبْلَ الصَّلاَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 14916","","","كتاب الحج"
"14917","(۱۴۹۱۷) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ زَیْدِ بْنِ یُثَیْعٍ ، عَنْ عَلِیٍّ ، قَالَ : بَعَثَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ أُنْزِلَتْ بَرَائَۃٌ بِأَرْبَعٍ : أَنْ لاَ یَطُوفَ بِالْبَیْتِ عُرْیَانٌ ، وَلاَ یَقْرَبَ الْمَسْجِدَ مُشْرِکٌ بَعْدَ عَامِہِمْ ہَذَا ، وَمَنْ کَانَ بَیْنَہُ وَبَیْنَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَہْدٌ فَہُوَ إِلَی مُدَّتِہِ ، وَلاَ یَدْخُلُ الْجَنَّۃَ إِلاَّ نَفْسٌ مُسْلِمَۃٌ۔ (احمد ۱/۷۹۔ حاکم ۱۷۸)","Da'if","Musannaf Ibn Abi Shaybah 14917","","","كتاب الحج"
"14918","(۱۴۹۱۸) حدَّثَنَا وَکِیعٌ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، قَالَ : أََمْلَی عَلَیَّ الضَّحَّاکُ مَنَاسِکَ الْحَجِّ۔","Hasan","Musannaf Ibn Abi Shaybah 14918","","","كتاب الحج"
"14919","(۱۴۹۱۹) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حُسَیْنِ بْنِ عُقَیْلٍ ، قَالَ : أََمْلَی عَلَیَّ الضَّحَّاکُ مَنَاسِکَ الْحَجِّ۔","","Musannaf Ibn Abi Shaybah 14919","","","كتاب الحج"
"14920","(۱۴۹۲۰) حدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَتَی جِبْرِیلُ إِبْرَاہِیمَ عَلَیْہِمَا السَّلاَم ، فَرَاحَ بِہِ إِلَی مِنًی ، فَصَلَّی بِہِ الصَّلَوَاتِ جَمِیعًا ، ثُمَّ صَلَّی بِہِ الْفَجْرَ ، ثُمَّ غَدَا بِہِ إِلَی عَرَفَۃَ ، فَنَزَلَ بِہِ حَیْثُ یَنْزِلُ النَّاسُ ، ثُمَّ صَلَّی بِہِ الصَّلاَتَیْنِ جَمِیعًا ، ثُمَّ أَتَی بِہِ الْمَوْقِفَ ، حَتَّی إِذَا کَانَ کَأَعْجَلِ مَا یُصَلِّی الإِنْسَانُ الْمَغْرِبَ أَفَاضَ بِہِ ، فَأَتَی جَمْعًا فَصَلَّی بِہِ الصَّلاَتَیْنِ جَمِیعًا ، ثُمَّ بَاتَ بِہَا حَتَّی إِذَا کَانَ کَأَعْجَلِ مَا یُصَلِّی أَحَدٌ مِنَ النَّاسِ الْفَجْرَ صَلَّی بِہِ ، ثُمَّ وَقَفَ حَتَّی إِذَا کَانَ کَأَبْطَأِ مَا یُصَلِّی أَحَدٌ مِنَ النَّاسِ الْفَجْرَ ، أَفَاضَ بِہِ إِلَی مِنًی ، فَرَمَی الْجَمْرَۃَ ، ثُمَّ ذَبَحَ وَحَلَقَ ، ثُمَّ أَفَاضَ بِہِ ، ثُمَّ أَوْحَی اللَّہُ تَعَالَی بَعْدُ إِلَی نَبِیِّہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : {أَنِ اتَّبِعْ مِلَّۃَ إِبْرَاہِیمَ حَنِیفًا}۔ (ابن خزیمۃ ۲۸۰۴)","Da'if","Musannaf Ibn Abi Shaybah 14920","","","كتاب الحج"
"14921","(۱۴۹۲۱) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ؛ فِی قولہ تعالی : {وَإِذْ یَرْفَعُ إبْرَاہِیمُ الْقَوَاعِدَ مِنَ الْبَیْتِ وَإِسْمَاعِیلُ} قَالَ : لَمَّا فَرَغَ مِنَ البَیتِ جَائَہُ جِبْرِیلُ عَلَیْہِ السَلاَم ، فَأَرَاہُ الطَّوَافَ بِالْبَیْتِ ، وَأَحْسَبُہُ قَالَ : وَالصَّفَا وَالْمَرْوَۃَ ، ثُمَّ انْطَلَقَا إِلَی الْعَقَبَۃِ فَعَرَضَ لَہُمَا الشَّیْطَانُ ، قَالَ : فَأَخَذَ جِبْرِیلُ عَلَیْہِ السَلاَم سَبْعَ حَصَیَاتٍ ، وَأَعْطَی إبْرَاہِیمَ عَلَیْہِ السَلاَم سَبْعَ حَصَیَاتٍ ،فَرَمَی وَکَبَّرَ ، وَقَالَ لإِبْرَاہِیمَ : اِرْمِ وَکَبِّرْ ، قَالَ : فَرَمَیَا وَکَبَّرَا مَعَ کُلِّ رَمْیَۃٍ ، حَتَّی أَفَلَ الشَّیْطَانُ ، ثُمَّ انْطَلَقَا إِلَی الْجَمْرَۃِ الْوُسْطَی ، فَعَرَضَ لَہُمَا الشَّیْطَانُ ، فَأَخَذَ جِبْرِیلُ عَلَیْہِ السَلاَم سَبْعَ حَصَیَاتٍ ، وَأَعْطَی إِبْرَاہِیمَ عَلَیْہِ السَلاَم سَبْعَ حَصَیَاتٍ ، فَرَمَیَا وَکَبَّرَا مَعَ کُلِّ رَمْیَۃٍ حَتَّی أَفَلَ الشَّیْطَانُ ۔ ثُمَّ أَتَیَا الْجَمْرَۃَ الْقُصْوَی ، قَالَ : فَعَرَضَ لَہُمَا الشَّیْطَانُ ، قَالَ : فَأَخَذَ جِبْرِیلُ عَلَیْہِ السَلاَم سَبْعَ حَصَیَاتٍ ، وَأَعْطَی إبْرَاہِیمَ عَلَیْہِ السَلاَم سَبْعَ حَصَیَاتٍ ، وَقَالَ : اِرْمِ وَکَبِّرْ ، فَرَمَیَا وَکَبَّرَا مَعَ کُلِّ رَمْیَۃٍ ، حَتَّی أَفَلَ الشَیطَان ۔ ثُمَّ أَتَی بِہِ إِلیَ مِنًی ، فَقَالَ : ہَاہُنَا یَحْلِقُ النَّاسُ رُؤُوسَہُمْ ، ثُمَّ أَتَی بِہِ جَمْعًا ، فَقَالَ : ہَاہُنَا یَجْمَعُ النَّاسُ الصَّلاَۃَ ، ثُمَّ أَتَی بِہِ عَرَفَاتٍ ، فَقَالَ : عَرَفْتَ ؟ قَالَ : نَعَمْ ، قَالَ : فَمِنْ ثُمَّ سُمِّیَتْ عَرَفَاتٍ۔","","Musannaf Ibn Abi Shaybah 14921","","","كتاب الحج"
"14922","(۱۴۹۲۲) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا دَاوُد بْنُ أَبِی ہِنْدٍ ، عَنْ مُحَمَّدِ بْنِ أَبی مُوسَی ؛ فِی قَوْلِہِ تَعَالَی : {وَمَنْ یُعَظِّمْ شَعَائِرَ اللہِ فَإِنَّہَا مِنْ تَقْوَی الْقُلُوبِ} ، قَالَ : الْوُقُوفُ بِعَرَفَۃَ مِنْ شَعَائِرِ اللہِ ، وَبِجَمْع مِنْ شَعَائِرِ اللہِ ، وَالْجِمَارُ مِنْ شَعَائِرِ اللہِ ، وَالْبُدْنُ مِنْ شَعَائِرِ اللہِ ، وَالْحَلْقُ مِنْ شَعَائِرِ اللہِ ، فَمَنْ یُعَظِّمْہَا فَإِنَّہَا مِنْ تَقْوَی الْقُلُوبِ ۔ قَالَ : وَفِی قَوْلِہِ تَعَالَی : {لَکُمْ فِیہَا مَنَافِعُ إِلَی أَجَلٍ مُسَمًّی} ، قَالَ : لَکُمْ فِی کُلِّ مَشْعَرٍ مَنَافِعُ ، إِلَی أَنْ تَخْرُجُوا مِنْہُ إِلَی غَیْرِہِ ، فَالأَجَلُ الْمُسَمَّی : الْخُرُوجُ مِنْہُ إِلَی غَیْرِہِ ، {ثُمَّ مَحِلُّہَا إِلَی الْبَیْتِ الْعَتِیقِ} قَالَ : مَحِلُّ ہَذِہِ الشَّعَائِرِ کُلِّہَا ، الطَّوَافُ بِالْبَیْتِ۔","","Musannaf Ibn Abi Shaybah 14922","","","كتاب الحج"
"14923","(۱۴۹۲۳) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ {وَاتَّخِذُوا مِنْ مَّقَامِ إِبْرَاہِیمَ مُصَلًّی} قَالَ : ہُوَ الْحَجُّ کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 14923","","","كتاب الحج"
"14924","(۱۴۹۲۴) حدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کَانَ مَعَ ابْنِ عُمَرَ ، فَلَمَّا طَلَعَتِ الشَّمْسُ أَمَرَ بِرَاحِلَتِہِ فَرُحِلَتْ وَارْتَحَلَ مِنْ مِنًی فَسَارَ ، قَالَ : فَإِنْ کَانَ لأَعْجَبُنَا إِلَیْہِ أَسْفَہُنَا ، رَجُلٌ کَانَ یُحَدِّثُہُ عَنِ النِّسَائِ وَیُضْحِکُہُ ، قَالَ : فَلَمَّا صَلَّی الْعَصْرَ وَقَفَ بِعَرَفَۃَ ، فَجَعَلَ یَرْفَعُ یَدَیْہِ ، أَو قَالَ : یَمُدُّ ، قَالَ : وَلاَ أَدْرِی لَعَلَّہُ قَدْ قَالَ : دُونَ أُذُنَیْہِ ، وَجَعَلَ یَقُولُ : اللَّہُ أَکْبَرُ وَلِلَّہِ الْحَمْدُ ، اللَّہُ أَکْبَرُ وَلِلَّہِ الْحَمْدُ ، اللَّہُ أَکْبَرُ وَلِلَّہِ الْحَمْدُ ، لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، اللَّہُمَّ اہْدِنِی بِالْہُدَی ، وَقِنِی بِالتَّقْوَی ، وَاغْفِرْ لِی فِی الآخِرَۃِ وَالأُولَی ، ثُمَّ یَرُدُّ یَدَیْہِ فَیَسْکُتُ کَقَدْرِ مَا کَانَ إِنْسَانٌ قَارِئًا بِفَاتِحَۃِ الْکِتَابِ ، ثُمَّ یَعُودُ فَیَرْفَعُ یَدَیْہِ وَیَقُولُ مِثْلَ ذَلِکَ ، فَلَمْ یَزَلْ یَفْعَلُ ذَلِکَ حَتَّی أَفَاضَ ۔ قَالَ : فَکَانَ سَیْرُہُ إِذَا رَأَی سَعَۃً الْعَنَقَ ، وَإِذَا رَأَی مَضِیقًا أَمْسَکَ ، وَإِذَا أَتَی جَبَلاً مِنْ تِلْکَ الْجِبَالِ وَقَفَ عِنْدَ کُلِّ جَبَلٍ مِنْہَا کَقَدْرِ مَا أَقُولُ ، أَوْ یَقُولُ الْقَائِلُ : وَقِفَتْ یَدَاہَا وَلَمْ تَقِفْ رِجْلاَہَا ، قَالَ : ثُمَّ نَزَلَ مَنْزِلَہُ بِالطَّرِیقِ ، فَانْطَلَقَ وَاتَّبَعْتُہُ فَقُلْتُ : لَعَلَّہُ یَفْعَلُ شَیْئًا مِنَ السُّنَّۃِ ، فَقَالَ : إِنَّمَا أَذْہَبُ حَیْثُ تَعْلَمُ ، فَجَائَ فَتَوَضَّأَ عَلَی رِسْلِہِ ، ثُمَّ رَکِبَ ، وَلَمْ یُصَلِّ حَتَّی أَتَی جَمْعًا ، فَأَقَامَ فَصَلَّی الْمَغْرِبَ ، ثُمَّ انْفَتَلَ إِلَیْنَا ، فَقَالَ : الصَّلاَۃُ جَامِعَۃٌ ، وَلَمْ یَتَجَوَّزْ بَیْنَہُمَا بِشَیْئٍ ۔ قُلتُ : وَلَمْ یَکُن بَیْنَہُمَا إِقَامَۃً إِلاَّ قَولَہُ : الصَّلاَۃُ جَامِعَۃٌ ؟ أَو قَالَ : أَذَانٌ إِلاَّ ذَاکَ ؟ قَالَ : لاَ ۔ ثُمَّ صَلَّی الْعِشَائَ رَکْعَتَیْنِ ، فَصَلَّی خَمْسَ رَکَعَاتٍ لِلْمَغْرِبِ وَالْعِشَائِ ، لَمْ یَتَطَوَّعْ ، أَوْ قَالَ : لَمْ یَتَجَوَّزْ بَیْنَہُمَا بِشَیْئٍ ، ثُمَّ دَعَا بِطَعَامٍ ، فَقَالَ : مَنْ کَانَ یَسْمَعُ صَوْتَنَا فَلْیَأْتِنَا ، قَالَ : کَأَنَّہُ یَرَی أَنَّ ذَاکَ کَذَاک یَنْبَغِی ، ثُمَّ بَاتُوا ، ثُمَّ صَلَّی بِنَا الصُّبْحَ بِسَوَادٍ ، وَلَیْسَ فِی السَّمَائِ نَجْمٌ أَعْرِفُہُ إِلاَ أَرَاہُ ، وَقَرَأَ بِـ : (عَبَسَ وَتَوَلَّی) وَلَمْ یَقْنُتْ قَبْلَ الرُّکُوعِ ، وَلاَ بَعْدَہُ ، ثُمَّ وَقَفَ فَذَکَرَ مِنْ دُعَائِہِ فِی ہَذَا الْمَوْقِفِ کَمَا فَعَلَ فِی مَوْقِفِہِ بِالأَمْسِ ، ثُمَّ أَفَاضَ سَیْرَہُ ، إِذَا رَأَی سَعَۃً الْعَنَقَ ، وَإِذَا رَأَی مَضِیقًا أَمْسَکَ ۔ قَالَ : وَکَانَ ابْنُ عَبَّاسٍ أَخْبَرَنِی أَنَّ الْوَادِی الَّذِی بَیْنَ یَدَیْہِ مِنًی الَّذِی یُدْعَی مُحَسِّرًا یُوضَعُ ۔ فَلَمَّا أَتَی عَلَیْہِ رَکَضَ بِرِجْلِہِ ، فَعَرَفْتُ أَنَّہُ أَرَادَ أَنْ یُوضِعَ فَأَعْیَتْہُ رَاحِلَتُہُ فَأَوْضَعْتُہُ ، فَرَمَی الْجَمْرَۃَ ، فَلَمَّا کَانَ الْغَدُ رَمَی الْجَمْرَۃَ ، قَالَ : أَحْسَبُہُ قَالَ لِی : بِہَاجِرَۃٍ ، ثُمَّ تَقَدَّمَ حَتَّی کَانَ بَیْنَہُمَا وَبَیْنَ الْوُسْطَی ، فَذَکَرَ مِنْ دُعَائِہِ مِثْلَ دُعَائِہِ فِی الْمَوْقِفَیْنِ ، إِلاَّ أَنَّہُ زَادَ : وَأَصْلِحْ لِی، أَو قَالَ : وَأَتْمِمْ لَنَا مَنَاسِکَنَا ، قَالَ : وَکَانَ قِیَامُہُ کَقَدْرِ مَا کَانَ إِنْسَانٌ فِیمَا یُرَی قَارِئًا سُورَۃَ یُوسُفَ ، ثُمَّ رَمَی الْجَمْرَۃَ الْوُسْطَی ، ثُمَّ تَقَدَّمَ فَذَکَرَ مِنْ دُعَائِہِ نَحْوَ ذَاکَ ، وَمِنْ قِیَامِہِ نَحْوَ ذَلِکَ ۔ قَالَ : فَقُلْتُ لِسَالِمٍ ، أَوْ نَافِعٍ : ہَلْ کَانَ یَقُولُ فِی سُکُوتِہِ شَیْئًا ؟ قَالَ : أَمَّا مِنَ السُّنَّۃِ ، فَلاَ۔","Sahih","Musannaf Ibn Abi Shaybah 14924","","","كتاب الحج"
"14925","(۱۴۹۲۵) حدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : دَخَلْنَا عَلَی جَابِرِ بْنِ عَبْدِ اللہِ ، فَسَأَلَ عَنْ الْقَوْمِ حَتَّی انْتَہَی إِلَیَّ ، فَقُلْتُ: أَنَا مُحَمَّدُ بْنُ عَلِیِّ بْنِ حُسَیْنٍ، فَأَہْوَی بِیَدِہِ إِلَی رَأْسِی ، فَنَزَعَ زِرِّی الأَعْلَی، ثُمَّ نَزَعَ زِرِّی الأَسْفَلَ ، ثُمَّ وَضَع کَفَّہُ بَیْنَ ثَدْیَیَّ ، وَأَنَا یَوْمئِذٍ غُلاَمٌ شَابٌّ ، فَقَالَ : مَرْحَبًا بِکَ یَا ابْنَ أَخِی ، سَلْ عَمَّ شِئْتَ ؟ فَسَأَلْتُہُ وَہُوَ أَعْمَی ، وَجَائَ وَقْتُ الصَّلاَۃِ ، فَقَامَ فِی نِسَاجَۃٍ مُلْتَحِفًا بِہَا ، کُلَّمَا وَضَعَہَا عَلَی مَنْکِبِہِ رَجَعَ طَرَفَاہَا إِلَیْہِ ، مِنْ صِغَرِہَا ، وَرِدَاؤُہُ إِلَی جَنْبِہِ عَلَی الْمِشْجَبِ ، فَصَلَّی بِنَا ، فَقُلْتُ : أَخْبِرْنِی عَنْ حَجَّۃِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : بِیَدِہِ ، فَعَقَدَ تِسْعًا ، فَقَالَ : إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَکَثَ تِسْعَ سِنِینَ لَمْ یَحُجَّ ، ثُمَّ أَذَّنَ فِی النَّاسِ فِی الْعَاشِرَۃِ : أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَاجًّ ، فَقَدِمَ الْمَدِینَۃَ بَشَرٌ کَثِیرٌ کُلُّہُمْ یَلْتَمِسُ أَنْ یَأْتَمَّ بِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَیَعْمَلَ مِثْلَ عَمَلِہِ ، فَخَرَجْنَا مَعَہُ حَتَّی أَتَیْنَا ذَا الْحُلَیْفَۃَ ، فَوَلَدَتْ أَسْمَائُ بِنْتُ عُمَیْسٍ مُحَمَّدَ بْنَ أَبِی بَکْرٍ ، فَأَرْسَلَتْ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَسْجِدِ ، کَیْفَ أَصْنَعُ ؟ فَقَالَ : اغْتَسِلِی ، وَاسْتَنْفِرِی بِثَوْبٍ ، وَأَحْرِمِی فَصَلَّی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الْمَسْجِدِ ، فَرَکِبَ الْقَصْوَائَ حَتَّی إِذَا اسْتَوَتْ بِہِ رَاحِلَتَہُ عَلَی الْبَیْدَائِ ، نَظَرْتُ إِلَی مَدَّی بَصَرِی مِنْ بَیْنِ یَدَیْہِ مِنْ رَاکِبٍ وَمَاشٍ ، وَعَنْ یَمِینِہِ مِثْلُ ذَلِکَ ، وَعَنْ یَسَارِہِ مِثْلُ ذَلِکَ ، وَمِنْ خَلْفِہِ مِثْلُ ذَلِکَ ، وَرَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَیْنَ أَظْہُرِنَا وَعَلَیْہِ یَنْزِلُ الْقُرْآنُ ، وَہُوَ یَعْرِفُ تَأْوِیلَہُ ، فَمَا عَمِلَ بِہِ مِنْ شَیْئٍ عَمِلْنَا بِہِ ، فَأَہَلَّ بِالتَّوْحِیدِ : لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ ، لَبَّیْکَ لاَ شَرِیکَ لَکَ لَبَّیْکَ ، إِنَّ الْحَمْدَ وَالنِّعْمَۃَ لَکَ وَالْمُلْکَ ، لاَ شَرِیکَ لَکَ ، وَأَہَلَّ النَّاسُ بِہَذَا الَّذِی یُہِلُّونَ بِہِ ، فَلَمْ یَرُدَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَیْہِمْ شَیْئًا مِنْہُ ، وَلَزِمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَلْبِیَتَہُ۔ وَقَالَ جَابِرٌ : لَسْنَا نَنْوِی إِلاَّ الْحَجَّ ، لَسْنَا نَعْرِفُ الْعُمْرَۃَ ، حَتَّی إِذَا أَتَیْنَا الْبَیْتَ مَعَہُ اسْتَلَمَ الرُّکْنَ فَرَمَلَ ثَلاَثًا، وَمَشَی أَرْبَعًا ، ثُمَّ نَفَدَ إِلَی مَقَامِ إِبْرَاہِیمَ ، فَقَرَأَ : {وَاِتَّخِذُوا مِنْ مَقَامِ إِبْرَاہِیمَ مُصَلًّی} فَجَعَلَ الْمَقَامَ بَیْنَہُ وَبَیْنَ الْبَیْتِ ، فَکَانَ أَبِی یَقُولُ : وَلاَ أَعْلَمُہُ ذَکَرَہُ إِلاَّ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، کَانَ یَقْرَأُ فِی الرَّکْعَتَیْنِ : {قُلْ ہُوَ اللَّہُ أَحَدٌ} وَ{قُلْ یَا أَیُّہَا الْکَافِرُونَ} ، ثُمَّ رَجَعَ إِلَی الرُّکْنِ فَاسْتَلَمَہُ ، ثُمَّ خَرَجَ مِنَ الْبَابِ إِلَی الصَّفَا ، فَلَمَّا دَنَا مِنَ الصَّفَا قَرَأَ : {إِنَّ الصَّفَا وَالْمَرْوَۃَ مِنْ شَعَائِرِ اللہِ} أَبْدَأُ بِمَا بَدَأَ اللَّہُ بِہِ ، فَبَدَأَ بِالصَّفَا فَرَقِی عَلَیْہِ حَتَّی رَأَی الْبَیْتَ ، فَاسْتَقْبَلَ الْبَیْتَ ، وَوَحَّدَ اللَّہَ وَکَبَّرَہُ ، وَقَالَ : لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ لاَ شَرِیکَ لَہُ ، لَہُ الْمُلْکُ وَلَہُ الْحَمْدُ ، وَہُوَ عَلَی کُلِّ شَیْئٍ قَدِیرٌ ، لاَ إلَہَ إِلاَّ اللَّہُ وَحْدَہُ ، أَنْجَزَ وَعدَہُ ، وَنَصَرَ عَبْدَہُ ، وَہَزَمَ الأَحْزَابَ وَحْدَہُ ، ثُمَّ دَعَا بَیْنَ ذَلِکَ ، ثُمَّ قَالَ مِثْلَ ذَلِکَ ، ثَلاَثَ مَرَّاتٍ ۔n ثُمَّ نَزَلَ إِلَی الْمَرْوَۃِ حتَّی انْصَبَّتْ قَدَمَاہُ إِلَی بَطْنِ الْوَادِی ، حَتَّی إِذَا صَعِدْنَا مَشَی حَتَّی أَتَی الْمَرْوَۃَ ، فَفَعَلَ عَلَی الْمَرْوَۃِ کَمَا فَعَلَ عَلَی الصَّفَا ، حَتَّی إِذَا کَانَ آخِرُ طَوَافِہِ عَلَی الْمَرْوَۃِ ، قَالَ : إِنِّی لَوِ اسْتَقْبَلْتُ مِنْ أَمْرِی مَا اسْتَدْبَرْتُ لَمْ أَسُقَ الْہَدْیَ ، وَجَعَلْتُہَا عُمْرَۃً ، فَمَنْ کَانَ مِنْکُمْ لَیْسَ مَعَہُ ہَدْیٌ فَلْیَحِلَّ وَلْیَجْعَلْہَا عُمْرَۃً ، فَقَامَ سُرَاقَۃُ بْنُ جُعْشُمٍ ، فَقَالَ : یَا رَسُولَ اللہِ ، أَلِعَامِنَا ہَذَا ، أَمْ لأَبَدٍ ؟ فَشَبَّکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَصَابِعَہُ وَاحِدَۃً فِی الأُخْرَی ، وَقَالَ : دَخَلَتِ الْعُمْرَۃُ فِی الْحَجِّ ، مَرَّتَیْنِ ، لاَ ، بَلْ لأَبَدٍ أَبَدٍ ۔ وَقَدِمَ عَلِیٌّ مِنَ الْیَمَنِ بِبُدْنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَوَجَدَ فَاطِمَۃَ مِمَّنْ حَلَّ ، وَلَبِسَتْ ثِیَابًا صَبِیغًا ، وَاکْتَحَلَتْ ، فَأَنْکَرَ ذَلِکَ عَلَیْہَا ، فَقَالَتْ : أَبِی أَمَرَنِی بِہَذَا ، قَالَ : فَکَانَ عَلِیٌّ یَقُولُ بِالْعِرَاقِ : فَذَہَبْتُ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُحَرِّشًا عَلَی فَاطِمَۃَ لِلَّذِی صَنَعَتْ ، مُسْتَفْتِیًا لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیمَا ذَکَرَتْ عَنْہُ ، قَالَ : فَأَخْبَرْتُہُ أَنِّی أَنْکَرْتُ ذَلِکَ عَلَیْہَا ، فَقَالَ : صَدَقَتْ صَدَقَتْ ، قَالَ : مَا قُلْتَ حِینَ فَرَضْتَ الْحَجَّ ؟ قَالَ : قُلْتُ : اللَّہُمَّ إِنِّی أُہِلُّ بِمَا أَہَلَّ بِہِ رَسُولُک صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَإِنَّ مَعِی الْہَدْیَ فَلاَ تَحِلَّ ، قَالَ : فَکَانَ جَمَاعَۃُ الْہَدْیِ الَّذِی قَدِمَ بِہِ عَلِیُّ مِنَ الْیَمَنِ ، وَالَّذِی أَتَی بِہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِئَۃ ، قَالَ : فَحَلَّ النَّاسُ کُلُّہُمْ وَقَصَّرُوا إِلاَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَنْ کَانَ مَعَہُ ہَدْیٌ ۔ فَلَمَّا کَانَ یَوْمُ التَّرْوِیَۃِ تَوَجَّہُوا إِلَی مِنًی فَأَہَلُّوا بِالْحَجِّ ، وَرَکِبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَصَلَّی بِہَا الظُّہْرَ وَالْعَصْرَ ، وَالْمَغْرِبَ وَالْعِشَائَ وَالصُّبْحَ ، ثُمَّ مَکَثَ قَلِیلاً حَتَّی طَلَعَتِ الشَّمْسُ ، وَأَمَرَ بِقُبَّۃٍ مِنْ شَعْرٍ فَضُرِبَتْ لَہُ بِنَمِرَۃَ ، فَسَارَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَلاَ تَشُکَّ قُرَیْشٌ ، إِلاَّ أَنَّہُ وَاقِفٌ عِنْدَ الْمَشْعَرِ الْحَرَامِ ، کَمَا کَانَتْ قُرَیْشٌ تَصْنَعُ فِی الْجَاہِلِیَّۃِ ، فَأَجَازَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی أَتَی عَرَفَۃَ فَوَجَدَ الْقُبَّۃَ قَدْ ضُرِبَتْ لَہُ بِنَمِرَۃَ ، فَنَزَلَ بِہَا حَتَّی إِذَا زَاغَتِ الشَّمْسُ أَمَرَ بِالْقَصْوَائِ فَرُحِلَتْ لَہُ ، فَأَتَی بَطْنَ الْوَادِی فَخَطَبَ النَّاسَ ، وَقَالَ : إِنَّ دِمَائَکُمْ وَأَمْوَالَکُمْ حَرَامٌ عَلَیْکُمْ ، کَحُرْمَۃِ یَوْمِکُمْ ہَذَا ، فِی شَہْرِکُمْ ہَذَا ، فِی بَلَدِکُمْ ہَذَا ، أَلاَ کُلَّ شَیْئٍ مِنْ أَمْرِ الْجَاہِلِیَّۃِ تَحْتَ قَدَمیَّ مَوْضُوعٌ ، وَدِمَائُ الْجَاہِلِیَّۃِ مَوْضُوعَۃٌ ، وَإِنَّ أَوَّلَ دَمٍ أَضَعُ مِنْ دِمَائِنَا دَمُ ابْنِ رَبِیعَۃَ بْنِ الْحَارِثِ ، کَانَ مُسْتَرْضِعًا فِی بَنِی سَعْدٍ ، فَقَتَلَتْہُ ہُذَیْلٌ ، وَرِبَا أَہْلِ الْجَاہِلِیَّۃِ مَوْضُوعٌ ، وَأَوَّلُ رِبَاً أَضَعُ رِبَانَا ، رِبَا عَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ ، فَإِنَّہُ مَوْضُوعٌ کُلُّہُ ، فَاتَّقُوا اللَّہَ فِی النِّسَائِ ، فَإِنَّکُمْ أَخَذْتُمُوہُنَّ بِأَمر اللہِ ، وَاسْتَحْلَلْتُمْ فُرُوجَہُنَّ بِکَلِمَۃِ اللہِ ، وَلَکُمْ عَلَیْہِنَّ أَنْ لاَ یُوطِئْنَ فُرُشَکُمْ أَحَدًا تَکْرَہُونَہُ ، فَإِنْ فَعَلْنَ ذَلِکَ فَاضْرِبُوہُنَّ ضَرْبًا غَیْرَ مُبَرِّحٍ ، وَلَہُنَّ عَلَیْکُمْ رِزْقُہُنَّ وَکِسْوَتُہُنَّ بِالْمَعْرُوفِ ، وَقَدْ تَرَکْتُ فِیکُمْ مَا لَنْ تَضِلُّوا بَعْدَہُ إِنَ اعْتَصَمْتُمْ بِہِ ؛ کِتَابُ اللہِ ، وَأَنْتُمْ تُسْأَلُونَ عَنِّی ، فَمَا أَنْتُمْ قَائِلُونَ ؟ قَالُوا : نَشْہَدُ أَنْ قَدْ بَلَّغْتَ وَأَدَّیْتَ وَنَصَحْتَ ، فَقَالَ : بِإِصْبَعِہِ السَّبَّابَۃِ ، یَرْفَعُہَا إِلَی السَّمَائِ وَیَنْکُتُہَا إِلَی النَّاسِ : اللَّہُمَّ اشْہَدْ ، اللَّہُمَّ اشْہَدْ ، ثَلاَثَ مَرَّاتٍ ، ثُمَّ أَذَّنَ ، ثُمَّ أَقَامَ فَصَّلی الظُّہْرَ ، ثُمَّ أَقَامَ فَصَّلی الْعَصْرَ ، وَلَمْ یُصَلِّ بَیْنَہُمَا شَیْئًا ۔ ثُمَّ رَکِبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی أَتَی الْمَوْقِفَ ، فَجَعَلَ بَطْنَ نَاقَتِہِ الْقَصْوَائَ إِلَی الصَّخَرَاتِ ، وَجَعَلَ حَبْلَ الْمُشَاۃِ بَیْنَ یَدَیْہِ ، وَاسْتَقْبَلَ الْقِبْلَۃَ ، فَلَمْ یَزَلْ وَاقِفًا حَتَّی غَرَبَتِ الشَّمْسُ ، وَذَہَبَتِ الصُّفْرَۃُ قَلِیلاً حَتَّی غَابَ الْقُرْصُ ، وَأَرْدَفَ أُسَامَۃَ خَلْفَہُ ، وَدَفَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَدْ شَنَقَ لِلْقَصْوَائِ الزِّمَامَ ، حَتَّی إِنَّ رَأْسَہَا لَیُصِیبُ مَوْرِکَ رَحْلِہِ ، وَیَقُولُ بِیَدِہِ الْیُمْنَی : أَیُّہَا النَّاسُ ، السَّکِینَۃَ السَّکِینَۃَ ، کُلَّمَا أَتَی حَبْلاً مِنَ الْحِبَالِ أَرْخَی لَہَا قَلِیلاً ، حَتَّی تَصْعَدَہ ۔n حَتَّی أَتَی الْمُزْدَلِفَۃَ فَصَلَّی بِہَا الْمَغْرِبَ وَالْعِشَائَ بِأَذَانٍ وَاحِدٍ وَإِقَامَتَیْنِ ، وَلَمْ یُسَبِّحْ بَیْنَہُمَا شَیْئًا ، ثُمَّ اضْطَجَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی طَلَعَ الْفَجْرُ ، وَصَلَّی حِینَ تَبَیَّنَ لَہُ الصُّبْحُ بِأَذَانٍ وَإِقَامَۃٍ ، ثُمَّ رَکِبَ الْقَصْوَائَ حَتَّی أَتَی الْمَشْعَرَ الْحَرَامَ ، فَاسْتَقْبَلَ الْقِبْلَۃَ ، فَدَعَاہُ وَکَبَّرَہُ وَہَلَّلَہُ وَوَحَّدَہُ ، فَلَمْ یَزَلْ وَاقِفًا حَتَّی أَسْفَرَ جِدًّا ، فَدَفَعَ قَبْلَ أَنْ تَطْلُعَ الشَّمْسُ ، وَأَرْدَفَ الْفَضْلَ بْنَ عَبَّاسٍ وَکَانَ رَجُلاً حَسَنَ الشَّعْرِ ، أَبْیَضَ وَسِیمًا ۔ فَلَمَّا دَفَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّتْ ظُعُنٌ یَجْرِینَ ، فَطَفِقَ الْفَضْلُ یَنْظُرُ إِلَیْہِنَّ ، فَوَضَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدَہُ عَلَی وَجْہِہِ ، فَحَوَّلَ الْفَضْلُ وَجْہَہُ إلَی الشِّقِّ الآخَرِ یَنْظُرُ ، فَحَوَّلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَدَہُ مِنَ الشِّقِّ الآخَرِ عَلَی وَجْہِ الْفَضْلِ ، فَصْرِفُ وَجْہَہُ مِنَ الشِّقِّ الآخَرِ یَنْظُرُ ، حَتَّی أَتَی مُحَسِّراً فَحَرَّکَ قَلِیلاً ، ثُمَّ سَلَکَ الطَّرِیقَ الْوُسْطَی الَّتِی تُخْرِجُ إِلَی الْجَمْرَۃِ الْکُبْرَی، حَتَّی أَتَی الْجَمْرَۃَ الَّتِی عِنْدَ الشَّجَرَۃِ فَرَمَاہَا بِسَبْعِ حَصَیَاتٍ ، یُکَبِّرُ مَعَ کُلِّ حَصَاۃٍ مِنْہَا ، مِثْلِ حَصَی الْخَذْفِ ، رَمَی مِنْ بَطْنِ الْوَادِی ، ثُمَّ انْصَرَفَ إِلَی الْمَنْحَرِ ، فَنَحَرَ ثَلاَثًا وَسِتِّینَ بِیَدِہِ ، ثُمَّ أَعْطَی عَلِیًّا فَنَحَرَ مَا غَبَرَ مِنْہَا ، وَأَشْرَکَہُ فِی ہَدْیِہِ ، وَأَمَرَ مِنْ کُلِّ بَدَنَۃٍ بِبَضْعَۃٍ فَجُعِلَتْ فِی قِدْرٍ ، فَطُبِخَتْ ، فَأَکَلاَ مِنْ لَحْمِہَا وَشَرِبَا مِنْ مَرَقِہَا ۔ ثُمَّ رَکِبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَفَاضَ إِلَی الْبَیْتِ ، فَصَلَّی بِمَکَّۃَ الظُّہْرَ ، فَأَتَی بَنِی عَبْدِ الْمُطَّلِبِ یَسْقُونَ عَلَی زَمْزَمَ ، فَقَالَ : انْزِعُوا بَنِی عَبْدِ الْمُطَّلِبِ ، فَلَوْلاَ أَنْ یَغْلِبَکُمَ النَّاسُ عَلَی سِقَایَتِکُمْ لَنَزَعْتُ مَعَکُمْ ، فَنَاوَلُوہُ دَلْوًا فَشَرِبَ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14925","","","كتاب الحج"
"14926","(۱۴۹۲۶) حدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مَسْرُوقٍ ، قَالَ : أُمِرْتُمْ فِی الْکِتَابِ بِإِقَامَۃِ أَرْبَعٍ ؛ بِإِقَامَۃِ الصَّلاَۃِ ، وَإِیتَائِ الزَّکَاۃِ ، وَإِقَامَۃِ الْحَجِّ ، وَالْعُمْرَۃِ۔","","Musannaf Ibn Abi Shaybah 14926","","","كتاب الحج"
"14927","(۱۴۹۲۷) حدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُ سُئِلَ عَنِ الدَّجَاجَۃِ السِّنْدِیَّۃِ یُخْرَجُ بِہَا مِنَ الْحَرَمِ ؟ فَقَالاَ : لاَ ، ہِیَ صَیْدٌ۔","","Musannaf Ibn Abi Shaybah 14927","","","كتاب الحج"
"14928","(۱۴۹۲۸) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّ أَزْوَاجَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُنَّ یَطُفْنَ مَعَ الرِّجَالِ ، قَالَ عَطَائٌ : وَقَالَتِ امْرَأَۃٌ لِعَائِشَۃَ : تَعَالَیْ إِلَی الْحَجَرِ فَاسْتَلِمِیہِ ، قَالَتْ : انفُذی عَنْکِ۔","","Musannaf Ibn Abi Shaybah 14928","","","كتاب الحج"
"14929","(۱۴۹۲۹) حدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَحْتَشَّ الْمُحْرِمُ۔","","Musannaf Ibn Abi Shaybah 14929","","","كتاب الحج"
"14930","(۱۴۹۳۰) حدَّثَنَا رَوْحُ بْنُ عُبَادَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 14930","","","كتاب الحج"
"14931","(۱۴۹۳۱) حدَّثَنَا أَبُو أُسَامَۃُ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ فِیمَنِ اضْطُرَّ إِلَی مَیْتَۃٍ وَصَیْدٍ : یَأْکُلُ الْمَیْتَۃَ ، وَلاَ یَأْکُلُ الصَّیْدَ ، وَلاَ یَعْرِضُ لَہُ ، یَعْنِی الْمُحْرِمَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14931","","","كتاب الحج"
"14932","(۱۴۹۳۲) حدَّثَنَا ہُشَیْمٌ ، عَنِ الحَجَّاجِ ، عَنْ عَطَائٍ ، قَالَ : یُلَبَّی عَنِ الأَخْرَسِ وَالصَّبِیِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 14932","","","كتاب الحج"
"14933","(۱۴۹۳۳) حدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، وَہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی امْرَأَۃٍ قَدِمَتْ مُعْتَمِرَۃً وَہِیَ حَائِضٌ ، قَالَ : تُہِلُّ بِالْحَجِّ عَلَی عُمْرَتِہَا ، وَتَمْضِی إِلَی عَرَفَاتٍ وَہِیَ قَارِنٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14933","","","كتاب الحج"
"14934","(۱۴۹۳۴) حدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنْ عَطَائٍ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14934","","","كتاب الحج"
"14935","(۱۴۹۳۵) حدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إِبْرَاہِیمَ بْنِ نَافِعٍ ، عَنْ طَاوُوسٍ ، قَالَ : سَمِعْتُہُ سُئِلَ عَنْ رَجُلٍ أَرَادَ أَنْ یُلَبِّیَ فَکَبَّرَ ؟ قَالَ : یُجْزِئْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14935","","","كتاب الحج"
"14936","(۱۴۹۳۶) حدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : یَرْجِعُ۔","","Musannaf Ibn Abi Shaybah 14936","","","كتاب الحج"
"14937","(۱۴۹۳۷) حدَّثَنَا مُعَاوِیَۃُ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : یُجْزِئْہُ۔","","Musannaf Ibn Abi Shaybah 14937","","","كتاب الحج"
"14938","(۱۴۹۳۸) حدَّثَنَا عَبْدُ الْعَزِیزِ الْعَمِّیُّ ، قَالَ : سُئِلَ مَطَرٌ ، وَأَنَا أَسْمَعُ عَنِ امْرَأَۃٍ اسْتَأْذَنَتْ زَوْجَہَا فِی الْحَجِّ فَلَمْ یَأْذَنْ لَہَا ، فَاسْتَأْذَنَتْہُ أَنْ تَزُورَ فَأَذِنَ لَہَا ، فَضَمَّتْ عَلَیْہَا ثِیَابًا لَہَا بَیضَائَ وَصَرَخَتْ بِالْحَجِّ ؟ قَالَ : فَأَتَوُا الْحَسَنَ فَسَأَلُوہُ ؟ فَقَالَ الْحَسَنُ : اللَّکَعَۃُ لَیْسَ لَہَا ذَاکَ ، قَالَ مَطَرٌ : وَسُئِلَ قَتَادَۃُ ؟ فَقَالَ : ہِیَ مُحْرِمَۃٌ ، قَالَ مَطَرٌ : فَانْطَلَقَتُ إِلَی مَکَّۃَ فَسَأَلَتُ الْحَکَمَ بْنَ عُتَیْبَۃَ ؟ فَقَالَ : ہِیَ مُحْرِمَۃٌ ، قَالَ مَطَرٌ : فَأَمَرْتُ رَجُلاً فَسَأَلَ عَطَائَ بْنَ أَبِی رَبَاحٍ ؟ فَقَالَ : لاَ ، وَلاَ نِعْمَۃُ عَیْنٍ ، لَیْسَ لَہَا ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 14938","","","كتاب الحج"
"14939","(۱۴۹۳۹) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا کَانَتِ الْفَرِیضَۃُ ، وَکَانَ لَہَا مَحْرَمٌ ، فَلاَ بَأْسَ أَنْ تَخْرُجَ ، وَلاَ تَسْتَأْذِنَ زَوْجَہَا۔","","Musannaf Ibn Abi Shaybah 14939","","","كتاب الحج"
"14940","(۱۴۹۴۰) حدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْمَرْأَۃِ الَّتِی لَمْ تَحُجَّ ، قَالَ : تَسْتَأْذِنُ زَوْجَہَا ، فَإِنْ أَذِنَ لَہَا فَذَاکَ أَحَبَّ إِلَیَّ ، وَإِنْ لَمْ یَأْذَنْ لَہَا خَرَجَتْ مَعَ ذِی مَحْرَمٍ ، فَإِنَّ ذَلِکَ فَرِیضَۃٌ مِنْ فَرَائِضِ اللہِ تَعَالَی لَیْسَ لَہُ فِیہَا طَاعَۃٌ۔","","Musannaf Ibn Abi Shaybah 14940","","","كتاب الحج"
"14941","(۱۴۹۴۱) حدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ، عَنْ إِبْرَاہِیمَ ، قَالَ: مَا کَانَ أَصْحَابُنَا یَعْتَنِقُونَ الْبَیْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 14941","","","كتاب الحج"
"14942","(۱۴۹۴۲) حدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانُ ، عَنْ رَجُلٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہ کان لاَ یَعْتَنِقُ الْبَیْتَ۔","Da'if","Musannaf Ibn Abi Shaybah 14942","","","كتاب الحج"
"14943","(۱۴۹۴۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إِبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ؛ أَنَّ عُمَرَ الْتَزَمَ الْحَجَرَ وَقَبَّلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 14943","","","كتاب الحج"
"14944","(۱۴۹۴۴) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، قَالَ : سَأَلْتُ جَابِرَ بْنَ عَبْدِ اللہِ عَنْ رَجُلٍ اعْتَمَرَ فَطَافَ بِالْبَیْتِ ، ثُمَّ أَرَادَ أَنْ یَقَعَ عَلَی أَہْلِہِ ، قَبْلَ أَنْ یَطُوفَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ ؟ فَقَالَ : لاَ ، حَتَّی یَطُوفَ بَیْنَ الصَّفَا وَالْمَرْوَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 14944","","","كتاب الحج"
"14945","(۱۴۹۴۵) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَنَسِ بْنِ سَعْدٍ ؛ أَنَّ رَجلاً اسْتَفْتَی سَعِیدَ بْنَ جُبَیرٍ قَالَ : حَجَجْتُ وَامْرَأَتِی ، فَوَقَعْتُ بِہَا قَبْلَ أَنْ أَُقَصِّرَ ؟ فَقَالَ سَعِیدٌ : أَہْرِقْ دَمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 14945","","","كتاب الحج"
"14946","(۱۴۹۴۶) حدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، أَو سَعِیدِ بْنِ جُبَیرٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ قَالَ : فِی امْرَأَۃٍ وَقَعَ عَلِیہَا زَوجُہَا ، وَقَد قَصَّرَتِ الْمَرْأَۃُ ، وَلَمْ یُقَصِّرِ الرَّجُلُ ، قَالَ : عَلَیہ دَمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 14946","","","كتاب الحج"
"14947","(۱۴۹۴۷) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : جَائَ رَجُلٌ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إِنَّ أُخْتِی مَاتَتْ وَلَمْ تَحُجَّ ، أَفَأَحُجُّ عَنْہَا ؟ قَالَ : أَرَأَیْتَ لَوْ کَانَ عَلَیْہَا دَیْنٌ فَقَضَیْتَہُ ؟ وَاللَّہُ أَحَقُّ بِالْوَفَائِ وَالْقَضَائِ۔ (بخاری ۶۶۹۹۔ احمد ۱/۲۳۹)","Sahih","Musannaf Ibn Abi Shaybah 14947","","","كتاب الحج"
"14948","(۱۴۹۴۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ رَجُلٍ یُقَالُ لَہُ : یُوسُفُ ، عَنِ ابْنِ الزُّبَیْرِ ؛ قَالَ : أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنَّ أَبِی مَاتَ وَلَمْ یَحُجَّ ، أَفَأَحُجُّ عَنْہُ ؟ قَالَ : أَنْتَ أَکْبَرُ وَلَدِہ ؟ قَالَ : نَعَمْ ، قَالَ : فَحُجَّ عَنِ أَبِیکَ ، أَرَأَیْتَ لَوْ کَانَ عَلَی أَبِیکَ دَیْنٌ قَضَیْتَہُ ؟n(نسائی ۳۶۲۴۔ احمد ۴/۳ )","Da'if","Musannaf Ibn Abi Shaybah 14948","","","كتاب الحج"
"14949","(۱۴۹۴۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَسْلَمَ ، عْن عَطَائٍ ، قَالَ : یُحَجُّ عَنِ الْمَیِّتِ ، وَإِنْ لَمْ یُوصِ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14949","","","كتاب الحج"
"14950","حدَّثَنَا أَبُو مُحَمَّدٍ عَبْدُ اللہِ بْنُ یُونُسَ ، قَالَ : حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ الْعَبْسِیُّ ، قَالَ :n(۱۴۹۵۰) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ ضُبَاعَۃَ ، قَالَتْ : دَخَلَ عَلَیَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا أَشْتَکِی ، فَقَالَ : مَا تُرِیدِینَ ، أَتَحُجِّینَ الْعَامَ ؟ قَالَتْ : إِنِّی لَمُعْتَلَّۃٌ یَا رَسُولَ اللہِ ، قَالَ : حُجِّی وَقُولِی : مَحِلِّی مِنَ الأَرْضِ حَیْثُ حَبَسْتنِی۔ (مسلم ۱۰۴۔ ابن ماجہ ۲۹۳۷)n(","Sahih","Musannaf Ibn Abi Shaybah 14950","","","كتاب الحج"
"14951","(۱۴۹۵۱) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ ، عَنْ مَیْسَرَۃَ ، عَنْ عَلِیٍّ ؛ أَنَّہُ کَانَ یَقُولُ : اللَّہُمَّ حَجَّۃً إِنْ تَیَسَّرَتْ ، أَوْ عُمْرَۃً ، إِنْ أَرَادَ الْعُمْرَۃَ ، وَإِلاَّ فَلاَ حَرَجَ۔","Da'if","Musannaf Ibn Abi Shaybah 14951","","","كتاب الحج"
"14952","(۱۴۹۵۲) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُفْیَانُ بْنُ حُسَیْنٍ ، عَنْ أَبِی بِشْرٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ عَلَی ضُبَاعَۃَ ابْنَۃِ الزُّبَیْرِ وَہِیَ تُرِیدُ الْحَجَّ ، فَقَالَ لَہَا : اشْتَرِطِی عِنْدَ إِحْرَامِکَ : وَمَحِلِّی حَیْثُ حَبَسْتنِی ، فَإِنَّ ذَلِکَ لَک۔ (مسلم ۱۰۶۔ ابن ماجہ ۲۹۳۸)","Sahih","Musannaf Ibn Abi Shaybah 14952","","","كتاب الحج"
"14953","(۱۴۹۵۳) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتْ : إذَا حَجَجْتَ فَاشْتَرِطْ قُلْ : اللَّہُمَّ الْحَجَّ عَمَدْتُ ، وَإِیَّاہُ أَرَدْتُ ، فَإِنْ تَیَسَّرَ الْحَجُّ فَہُوَ الْحَجُّ ، فَإِنْ حُبِسْتُ فَعُمْرَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 14953","","","كتاب الحج"
"14954","(۱۴۹۵۴) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : رَأَیْتَہُ وَضَعَ رِجْلَہُ فِی الْغَرْزِ ، ثُمَّ قَالَ : اللَّہُمَّ إنِّی أُرِیدُ حَجَّۃً إِنْ تَیَسَّرَتْ ، وَإِلاَّ فَعُمْرَۃٌ إِنْ تَیَسَّرَتْ۔","No Data Available","Musannaf Ibn Abi Shaybah 14954","","","كتاب الحج"
"14955","(۱۴۹۵۵) حدَّثَنَا سَلاَّمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ الأَسْوَدُ تُقَادُ لَہُ رَاحِلَتُہُ ، فَإِذَا أَتَی جَبَّانَۃً عرْزَمَ وَأَرَادَ أَنْ یَرْکَبَ ، قَالَ : اللَّہُمَّ حَجَّۃً إِنْ تَیَسَّرَتْ ، وَإِلاَّ عُمْرَۃً إِنْ تَیَسَّرَتْ ، ثُمَّ یُلَبِّی بِالْحَجِّ۔","","Musannaf Ibn Abi Shaybah 14955","","","كتاب الحج"
"14956","(۱۴۹۵۶) حدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : کَانَ أَبِی لاَ یَرَی الاشْتِرَاطَ فِی الْحَجِّ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 14956","","","كتاب الحج"
"14957","(۱۴۹۵۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ (ح) وَسَلاَّمٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا لاَ یَشْتَرِطُونَ ، وَلاَ یَرَوْنَ الشَّرْطَ فِیہِ شَیْئًا ، قَالَ سَلاَّمٌ فِی حَدِیثِہِ : لَوْ أَنَّ رَجُلاً اُبْتُلِیَ۔","","Musannaf Ibn Abi Shaybah 14957","","","كتاب الحج"
"14958","(۱۴۹۵۸) حدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : رَأَی عُثْمَانُ رَجُلاً وَاقِفًا بِعَرَفَۃَ ، فَقَالَ لَہُ : اشْتَرَطْتَ ، قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 14958","","","كتاب الحج"
"14959","(۱۴۹۵۹) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنْ عُثْمَانَ ، نَحْوَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 14959","","","كتاب الحج"
"14960","(۱۴۹۶۰) حدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعِ بْنِ صَبِیحٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ؛ فِی الْمُحْرِمِ یَشْتَرِطُ ، قَالاَ : لَہُ شَرْطُہُ۔","","Musannaf Ibn Abi Shaybah 14960","","","كتاب الحج"
"14961","(۱۴۹۶۱) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ؛ أَنَّ شُرَیْحًا کَانَ یَشْتَرِطُ فِی الْحَجِّ فَیَقُولُ : إنَّکَ قَدْ عَرَفْتَ نِیَّتِی وَمَا أُرِیدُ ، فَإِنْ کَانَ أَمْرًا أُتَمِّمْہُ فَہُوَ أَحَبَّ إلَیَّ ، وَإِنْ کَانَ غَیْرَ ذَلِکَ فَلاَ حَرَجَ۔ قَالَ أَبُو بَکْرٍ : بَلَغَنِی أَنَّ أَبَا مُعَاوِیَۃَ رَجَعَ عَنْ ہَذَا الْحَدِیثِ۔","","Musannaf Ibn Abi Shaybah 14961","","","كتاب الحج"
"14962","(۱۴۹۶۲) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ طَاوُوسٍ ، قَالَ : الاشْتِرَاطُ فِی الْحَجِّ لَیْسَ بِشَیْئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14962","","","كتاب الحج"
"14963","(۱۴۹۶۳) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِلاَلِ بْنِ خَبَّابٍ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ : أَرَأَیْتَ الاشْتِرَاطَ فِی الْحَجِّ ؟ قَالَ : إنَّمَا الاشْتِرَاطُ فِی الْحَجِّ فِیمَا بَیْنَ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 14963","","","كتاب الحج"
"14964","(۱۴۹۶۴) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ؛ فِی الاشْتِرَاطِ ، قَالاَ : لَیْسَ بِشَیْئٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 14964","","","كتاب الحج"
"14965","(۱۴۹۶۵) حدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ شُعْبَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : کَانَ عَلْقَمَۃُ یَشْتَرِطُ فِی الْحَجِّ ، وَلاَ یَرَاہُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 14965","","","كتاب الحج"
"14966","(۱۴۹۶۶) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْمُسْتَثْنِی وَغَیْرُ الْمُسْتَثْنِی سَوَائٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14966","","","كتاب الحج"
"14967","(۱۴۹۶۷) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِلاَلِ بْنِ خَبَّابٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ عَلَی ضُبَاعَۃَ ، فَقَالَ : لَہَا : مَا تُرِیدِینَ الْحَجَّ الْعَامَ ؟ قَالَتْ : یَا رَسُولَ اللہِ ، إِنِّی عُلَیْلَۃٌ ، قَالَ : حُجِّی وَاشْتَرِطِی قَالَتْ : کَیْفَ أَقُولُ ؟ قَالَ : قُولِی : لَبَّیْکَ اللَّہُمَّ لَبَّیْکَ ، مَحِلِّی مِنَ الأَرْضِ حَیْثُ حَبَسْتنِی۔n(ابوداؤد ۱۷۷۳۔ ترمذی ۹۴۱)","Sahih","Musannaf Ibn Abi Shaybah 14967","","","كتاب الحج"
"14968","(۱۴۹۶۸) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ أَبِی إِسْحَاقَ، عَنْ عُمَیْرَۃ بْنِ زِیَادٍ، عَنْ عَبْدِاللہِ، قَالَ: إذَا حَجَجْتَ فَاشْتَرِطْ۔","Da'if","Musannaf Ibn Abi Shaybah 14968","","","كتاب الحج"
"14969","(۱۴۹۶۹) حدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مُحَمَّدِ بْنِ ہِلاَلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ اللہِ الْحَارِثِ ؛ أَنَّہُ کَانَ یَشْتَرِطُ فِی الْعُمْرَۃِ۔","","Musannaf Ibn Abi Shaybah 14969","","","كتاب الحج"
"14970","(۱۴۹۷۰) حدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَعَطَائٍ قَالاَ : فِی الْعَبْدِ یُعْتَقُ بَعْدَ مَا یَنْفِرُ النَّاسُ مِنْ عَرَفَاتٍ ، أَوْ قَالَ یَحْتَلِمُ الْغُلاَمُ ، أَوْ تَحِیضُ الْجَارِیَۃُ ، أَوْ بِجَمْعٍ ، فَرَجَعُوا إلَی عَرَفَاتٍ ، فَوَقَفُوا قَبْلَ طُلُوعِ الْفَجْرِ ، فَقَدْ أَجْزَأَتْ عَنْہُمْ حَجَّۃُ الإِسْلاَمِ۔","","Musannaf Ibn Abi Shaybah 14970","","","كتاب الحج"
"14971","(۱۴۹۷۱) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَحُجُّ عَنِ الرَّجُلِ فَیَفْضُلُ مَعَہُ ، قَالَ : یُعْلِمُہُمْ ، فَإِنْ سَلَّمُوہُ وَإِلاَّ رَدَّہُ۔","","Musannaf Ibn Abi Shaybah 14971","","","كتاب الحج"
"14972","(۱۴۹۷۲) حدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مُحَمَّدِ بْنِ عَبَّادِ بْنِ جَعْفَرٍ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ جَائَ یَوْمَ التَّرْوِیَۃِ فَقَبَّلَ الْحَجَرَ ، ثُمَّ سَجَدَ عَلَیْہِ ، فَعَلَ ذَلِکَ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 14972","","","كتاب الحج"
"14973","(۱۴۹۷۳) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُسَیْنِ بْنِ عَبْدِ اللہِ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ ابْنَ عَبَّاسٍ سَجَدَ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 14973","","","كتاب الحج"
"14974","(۱۴۹۷۴) حدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ؛ أَنَّ عُمَرَ سَجَدَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 14974","","","كتاب الحج"
"14975","(۱۴۹۷۵) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَابِسِ بْنِ رَبِیعَۃَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ اسْتَلَمَ الْحَجَرَ وَقَبَّلَہُ ، وَقَالَ : لَوْلاَ أَنِّی رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقَبِّلُک مَا قَبَّلْتُکَ۔n(بخاری ۱۶۰۵۔ ابوداؤد ۱۸۶۸)","Sahih","Musannaf Ibn Abi Shaybah 14975","","","كتاب الحج"
"14976","(۱۴۹۷۶) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ؛ أَنَّ عُمَرَ قَبَّلَ الْحَجَرَ ثَلاَثًا وَسَجَدَ عَلَیْہِ لِکُلِّ قُبْلَۃٍ ، وَذُکِرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ۔","","Musannaf Ibn Abi Shaybah 14976","","","كتاب الحج"
"14977","(۱۴۹۷۷) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عِصَامٍ ، عَنْ عَبْدِ اللہِ بْنِ سَرْجَسٍ ، قَالَ : رَأَیْتُ الأُصَیْلَعَ عُمَرَ قَبَّلَ الْحَجَرَ ، وَقَالَ : إنِّی لأَعْلَمُ أَنَّکَ حَجَرٌ لاَ تَضُرُّ وَلاَ تَنْفَعُ ، وَلَوْلاَ أَنِّی رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُقَبِّلُکَ مَا قَبَّلْتُکَ۔ (احمد ۳۵۔ مسلم ۲۵۰)","Sahih","Musannaf Ibn Abi Shaybah 14977","","","كتاب الحج"
"14978","(۱۴۹۷۸) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْدِ بْنِ غَفَلَۃَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ قَبَّلَ الْحَجَرَ وَالْتَزَمَہُ ، وَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِکَ حَفِیًّا۔ n(مسلم ۹۲۶۔ احمد ۵۴)","Sahih","Musannaf Ibn Abi Shaybah 14978","","","كتاب الحج"
"14979","(۱۴۹۷۹) حدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، قَالَ : رَأَیْتُ طَاوُوسًا فَعَلَہُ ، یَعْنِی سَجَدَ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14979","","","كتاب الحج"
"14980","(۱۴۹۸۰) حدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ السُّدِّیِّ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: مَا بَیْنَ جَبَلَیْ مُزْدَلِفَۃَ فَہُوَ الْمَشْعَرُ الْحَرَامُ۔","No Data Available","Musannaf Ibn Abi Shaybah 14980","","","كتاب الحج"
"14981","(۱۴۹۸۱) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : لَمْ أَجِدْ أَحَدًا یُخْبِرُنِی عَنِ الْمَشْعَرِ الْحَرَامِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14981","","","كتاب الحج"
"14982","(۱۴۹۸۲) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ بْنَ عَمرو عَنِ الْمَشْعَرِ الْحَرَامِ ؟ فَسَکَتَ حَتَّی إذَا تَہَبَّطَتْ أَیْدِی رَوَاحِلِنَا بِالْمُزْدَلِفَۃِ ، قَالَ : أَیْنَ السَّائِلُ عَنِ الْمَشْعَرِ الْحَرَامِ ؟ ہَذَا الْمَشْعَرُ الْحَرَامُ۔","Sahih","Musannaf Ibn Abi Shaybah 14982","","","كتاب الحج"
"14983","(۱۴۹۸۳) حدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنْ مُثَنًّی ، عَنْ عَطَائٍ ؛ فِی قَوْلِہِ : (الْمَشْعَرِ الْحَرَامِ) ، قَالَ : ہُوَ قُزَحٌ ، ہُوَ الْمُزْدَلِفَۃُ کُلُّہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 14983","","","كتاب الحج"
"14984","(۱۴۹۸۴) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : النَّظَرُ إلَی الْبَیْتِ عِبَادَۃٌ ، وَالطَّوَافُ بِالْبَیْتِ صَلاَۃٌ۔","","Musannaf Ibn Abi Shaybah 14984","","","كتاب الحج"
"14985","(۱۴۹۸۵) حدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : النَّظَرُ إلَی الْبَیْتِ عِبَادَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14985","","","كتاب الحج"
"14986","(۱۴۹۸۶) حدَّثَنَا وَکِیعٌ ، وَعُبَیْدِ اللہِ ، عَنْ أَبَانَ بْنِ عَبْدِ اللہِ الْبَجَلِیِّ ، عَنْ عَطَائٍ ، قَالَ : النَّظَرُ إلَی الْبَیْتِ عِبَادَۃٌ۔","","Musannaf Ibn Abi Shaybah 14986","","","كتاب الحج"
"14987","(۱۴۹۸۷) حدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنِی أَبُو نُعَیْمٍ النَّخَعِیُّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : النَّظَرُ إلَی الْبَیْتِ عِبَادَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 14987","","","كتاب الحج"
"14988","(۱۴۹۸۸) حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ؛ کَانُوا یَکْرَہُونَ أَنْ یَدْخُلَ الْبَیْتَ رَجُلٌ عَلَیْہِ حِذَائٌ۔","","Musannaf Ibn Abi Shaybah 14988","","","كتاب الحج"
"14989","(۱۴۹۸۹) حدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ بْنِ الْمُزَنِیِّ ؛ أَنَّ عَطَائً وَطَاوُسًا ، وَمُجَاہِدًا قَالُوا فِی الْمُحْرِمِ یُصِیبُ الْقَطَاۃَ ، قَالُوا : فِیہَا شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 14989","","","كتاب الحج"
"14990","(۱۴۹۹۰) حدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، قَالَ : سَأَلَ رَجُلٌ سَالِمًا ، وَالْقَاسِمَ عْن قَطَاۃٍ أَصَابَہَا وَہُوَ مُحْرِمٌ ؟ فَقَالَ أَحَدُہُمَا : یَتَصَدَّقُ بِنِصْفِ مُدٍّ ، وَقَالَ الآخَرُ : نِصْفُ مُدٍّ خَیْرٌ مِنْ قَطَاۃٍ۔","","Musannaf Ibn Abi Shaybah 14990","","","كتاب الحج"
"14991","(۱۴۹۹۱) حدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ عَبْدِ اللہِ بْنِ مُؤَمَّلٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، عَنِ ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ ؛ فِی مُحْرِمٍ قَتَلَ قَطَاۃً ، فَقَالاَ : ثُلُثَا مُدٍّ ، وَثُلُثَا مُدٍّ أَجْزَأَُ فِی بَطْنِ مِسْکینٍ مِنْ قَطَاۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 14991","","","كتاب الحج"
"14992","(۱۴۹۹۲) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ صَالِحٍ الْفَزَارِیِّ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ ؛ سُئِلَ عَنْ مُحْرِمٍ قَتَلَ قَطَاۃً ؟ قَالَ : یَتَصَدَّقُ بِمُدٍّ۔","","Musannaf Ibn Abi Shaybah 14992","","","كتاب الحج"
"14993","(۱۴۹۹۳) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ خَالِہِ الْحَارِثِ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : إذَا دَخَلَتِ الْعَشْرُ فَلاَ یَأْخُذْ مِنْ شَعْرِہِ ، وَلاَ مِنْ أَظْفَارِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 14993","","","كتاب الحج"
"14994","(۱۴۹۹۴) حدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ قَالَ : مَنْ کَانَ یُرِیدُ أَنْ یُضَحِّیَ فَلاَ یَأْخُذْ مِنْ شَعْرِہِ ، وَلاَ مِنْ أَظْفَارِہِ شَیْئًا إِذَا أَہَلَّ ذُو الْحِجَّۃِ۔","","Musannaf Ibn Abi Shaybah 14994","","","كتاب الحج"
"14995","(۱۴۹۹۵) حدَّثَنَا شَرِیکٌ ، عَنِ الأَحْلاَفِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَرِہَ أَنْ یَأْخُذَ مِنْ شَعْرِہِ إذَا أَرَادَ الْحَجَّ ، قَالَ : فَسَأَلْتُ عِکْرِمَۃَ ؟ قَالَ : أَفَلاَ یَدَعُ النِّسَائَ ؟۔","","Musannaf Ibn Abi Shaybah 14995","","","كتاب الحج"
"14996","(۱۴۹۹۶) حدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَرِہَ أَنْ یَأْخُذَ مِنْ شَعْرِہِ إذَا تَقَارَبَ الْحَجُّ۔","","Musannaf Ibn Abi Shaybah 14996","","","كتاب الحج"
"14997","(۱۴۹۹۷) حدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ إِسْحَاقَ بْنِ یَحْیَی ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ أَرَادَ الْحَجَّ فَلاَ یَأْخُذْ مِنْ شَعْرِہِ شَیْئًا۔","Da'if","Musannaf Ibn Abi Shaybah 14997","","","كتاب الحج"
"14998","(۱۴۹۹۸) حدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ شَرِیکٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَأْخُذُ مِنْ شَعْرِہِ وَہُوَ یُرِیدُ الْحَجَّ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 14998","","","كتاب الحج"
"14999","(۱۴۹۹۹) حدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ أَبِی بَکْرِ بْنِ سَالِمٍ ، عَنْ سَالِمٍ ؛ أَنَّہُ کَانَ یَجُزُّ رَأْسَہُ فِی النِّصْفِ مِنْ شَعْبَانَ ، ثُمَّ یَخْرُجُ حَاجًّا۔","No Data Available","Musannaf Ibn Abi Shaybah 14999","","","كتاب الحج"
"15000","(۱۵۰۰۰) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُحِبُّ فِی الْعَشْرِ أَنْ یَکُفَّ عَنْ شَعْرِہِ وَأَظْفَارِہِ ، وَکَانَ لاَ یَرَی بِالتَّنَوُّرِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 15000","","","كتاب الحج"
"15001","(۱۵۰۰۱) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ عِکْرِمَۃَ ، وَسَالِمًا ، وَعَطَائً ،وَطَاوُوسًا ، وَالْقَاسِمَ ؟ فَقَالُوا : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 15001","","","كتاب الحج"
"15002","(۱۵۰۰۲) حدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی إِسْمَاعِیلَ ، قَالَ : حدَّثَتْنِی أُمِّی عَنْ جَدَّتِہَا ؛ أَنَّہَا سَمِعَتْ أُمَّ سَلَمَۃَ أُمَّ الْمُؤْمِنِینَ تَقُولُ : مَنْ کَانَ یُضَحِّی عَنْہُ ، فَہَلَّ ہِلاَلُ ذِی الْحِجَّۃِ فَلاَ یَأْخُذْ مِنْ شَعْرِہِ شَیْئًا حَتَّی یُضَحِّیَ ، فَذَکَرْتُ ذَلِکَ لإِبْرَاہِیمَ ؟ فَقَالَ : مَا سَمِعْتُ بِہَذَا۔","Da'if","Musannaf Ibn Abi Shaybah 15002","","","كتاب الحج"
"15003","(۱۵۰۰۳) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ تَوْفِیرَ الشَّعْرِ ، إِذَا أَرَادُوا أَنْ یُحْرِمُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 15003","","","كتاب الحج"
"15004","(۱۵۰۰۴) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ عُثْمَانَ بْنِ عُبَیْدِ اللہِ بْنِ أَبِی رَافِعٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ ہُرْمُزَ الأَعْرَجِ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَخَذَ مِنْ رَأْسِ رَجُلٍ مِنْ قُرَیْشٍ ، یُقَالُ لَہُ : مُحَمَّدُ بْنُ أَبِی رَبِیعَۃَ ، کَانَ ذَا شَعْرٍ ، بِالشَّجَرَۃِ قَبْلَ أَنْ یُحْرِمَ۔","Hasan","Musannaf Ibn Abi Shaybah 15004","","","كتاب الحج"
"15005","(۱۵۰۰۵) حدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ، وَعَطَائِ بْنِ یَسَارٍ ، وَأَبِی بَکْرِ بْنِ سُلَیْمَانَ بْنِ أَبِی حثَمَۃَ ؛ قَالُوا : لاَ بَأْسَ أَنْ یَأْخُذَ الرَّجُلُ مِنْ شَعْرِہِ وَأَظْفَارِہِ فِی الْعَشْرِ۔","","Musannaf Ibn Abi Shaybah 15005","","","كتاب الحج"
"15006","(۱۵۰۰۶) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَطَائٍ قَالَ : لاَ بَأْسَ بِالتَّنَوُّرِ فِی الْعَشْرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 15006","","","كتاب الحج"
