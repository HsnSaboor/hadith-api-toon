hadiths[2]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"182","اللّهُـمَّ بارِكْ لَهُمْ فيما رَزَقْـتَهُم، وَاغْفِـرْ لَهُـمْ وَارْحَمْهُمْ","","","","","Comprehensive types of good and manners"
"183","اللّهُـمَّ أَطْعِمْ مَن أَطْعَمَني، وَاسْقِ مَن سقاني","","","","","Comprehensive types of good and manners"
