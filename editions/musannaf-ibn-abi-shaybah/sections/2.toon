hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1003","(۱۰۰۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالَ : لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 1003","","","كتاب الطهارة"
"1004","(۱۰۰۴) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنْ حَفْصَۃَ ، عَنْ أُمِّ عَطِیَّۃَ ، قَالَتْ : کُنَّا لاَ نَرَی التَّرِیَّۃَ شَیْئًا۔","Sahih","Musannaf Ibn Abi Shaybah 1004","","","كتاب الطهارة"
"1005","(۱۰۰۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا لاَ یَرَوْنَ بِالصُّفْرَۃِ وَالْکُدْرَۃِ بَأْسًا ، یَعْنِی : بَعْدَ الْغُسْلِ۔","","Musannaf Ibn Abi Shaybah 1005","","","كتاب الطهارة"
"1006","(۱۰۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْقَعْقَاعِ ، عَنْ إبْرَاہِیمَ ؛ فِی الْمَرْأَۃِ تَرَی الصُّفْرَۃَ بَعْدَ الْغُسْلِ ، قَالَ : تَوَضَّأُ وَتُصَلِّی۔","","Musannaf Ibn Abi Shaybah 1006","","","كتاب الطهارة"
"1007","(۱۰۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ ؛ فِی الْمَرْأَۃِ تَرَی الصُّفْرَۃَ بَعْدَ الْغُسْلِ ، قَالَ : تَوَضَّأُ وَتُصَلِّی۔","","Musannaf Ibn Abi Shaybah 1007","","","كتاب الطهارة"
"1008","(۱۰۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا رَأَتْہَا بَعْدَ الْغُسْلِ ، فَإِنَّہَا تَسْتَثْفِرُ وَتَوَضَّأُ وَتُصَلِّی۔","","Musannaf Ibn Abi Shaybah 1008","","","كتاب الطهارة"
"1009","(۱۰۰۹) حَدَّثَنَا عَبْد الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : لاَ تَغْتَسِلْ حَتَّی تَرَی طُہْرًا أَبْیَضَ کَالْقَصَّۃ۔","","Musannaf Ibn Abi Shaybah 1009","","","كتاب الطهارة"
"1010","(۱۰۱۰) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قُلْتُ لَہُ : الطُّہْرُ مَا ہُوَ؟ قَالَ: الأَبْیَضُ الْجُفُوفُ، الَّذِی لَیْسَ مَعَہُ صُفْرَۃٌ ، وَلاَ مَائٌ ۔ الْجُفُوفُ : الأَبْیَضُ۔","","Musannaf Ibn Abi Shaybah 1010","","","كتاب الطهارة"
"1011","(۱۰۱۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : أَرْسَلْتُ إلَی رَائطَۃَ مَوْلاَۃِ عَمْرَۃَ ، فَأَخْبَرَنِی الرَّسُولُ أَنَّہَا قَالَتْ : کَانَتْ عَمْرَۃُ تَقُولُ لِلنِّسَائِ : إذَا إحْدَاکُنَّ أَدْخَلَتِ الْکُرْسُفَۃَ فَخَرَجَتْ مُتَغَیِّرَۃً فَلاَ تُصَلِّیَنَّ حَتَّی لاَ تَرَی شَیْئًا۔","","Musannaf Ibn Abi Shaybah 1011","","","كتاب الطهارة"
"1012","(۱۰۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ بَکْرٍ ، عَنْ یُونُسَ بْنِ یَزِیدَ الأَیْلِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : سَأَلْتُہُ عَمَّا یَتْبَعُ الْحَیْضَۃَ مِنَ الصُّفْرَۃِ وَالْکُدْرَۃِ ؟ قَالَ : ہُوَ مِنَ الْحَیْضَۃِ ، وَتُمْسِکُ عَنِ الصَّلاَۃِ حَتَّی تَنْقَی۔","","Musannaf Ibn Abi Shaybah 1012","","","كتاب الطهارة"
"1013","(۱۰۱۳) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ فَاطِمَۃَ بِنْتِ الْمُنْذِرِ ، عَنْ أَسْمَائَ بِنْتِ أَبِی بَکْرٍ ، قَالَتْ : کُنَّا فِی حِجْرِہَا مَعَ بَنَاتِ ابْنَتِہَا فَکَانَتْ إحْدَانَا تَطْہُرُ ، ثُمَّ تُصَلِّی ، ثُمَّ تُنَکَّسُ بِالصُّفْرَۃِ الْیَسِیرَۃِ ، فَنسْأَلُہَا ؟ فَتَقُولُ : اعْتَزِلْنَ الصَّلاَۃَ مَا رَأَیْتُنَّ ذَلِکَ ، حَتَّی لاَ تَرَیْنَ إِلاَّ الْبَیَاضَ خَالِصًا۔","Hasan","Musannaf Ibn Abi Shaybah 1013","","","كتاب الطهارة"
"1014","(۱۰۱۴) حَدَّثَنَا مَعْنُ بْنُ عِیسَی، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ عَمَّتِہِ ، عَنِ ابْنَۃِ زَیْدِ بْنِ ثَابِتٍ، أَنَّہُ بَلَغَہَا أَنَّ نِسَائً کُنَّ یَدْعُونَ بِالْمَصَابِیحِ فِی جَوْفِ اللَّیْلِ یَنْظُرْنَ إلَی الطُّہْرِ ، فَکَانَتْ تَعِیبُ عَلَیْہِنَّ وَتَقُولُ : مَا کُنَّ النِّسَائُ یَصْنَعْنَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 1014","","","كتاب الطهارة"
"1015","(۱۰۱۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ، قَالَتْ : سُئِلَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَنْ دَمِ الْحَیْضَۃِ یَکُونُ فِی الثَّوْبِ ؟ فَقَالَ : اقْرُصِیہِ بِالْمَائِ ، وَاغْسِلِیہِ وَصَلِّی فِیہِ۔n(بخاری ۳۰۷۔ نسائی ۲۸۵)","Hasan","Musannaf Ibn Abi Shaybah 1015","","","كتاب الطهارة"
"1016","(۱۰۱۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حَجَّاجٍ ، عَنْ ثَابِتٍ ، عَنْ عَدِیِّ بْنِ دِینَارٍ ؛ أَنَّ أُمَّ حُصَیْنٍ سَأَلَتِ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، عَنْ دَمِ الْحَیْضِ یَکُونُ فِی الثَّوْبِ ؟ فَقَالَ : حُکِّیہِ بِضِلَعٍ ، وَاغْسِلِیہِ بِمَائٍ وَسِدْرٍ ، وَصَلِّی فِیہِ۔ (احمد ۳۵۵۔ ابن ماجہ ۶۲۸)","","Musannaf Ibn Abi Shaybah 1016","","","كتاب الطهارة"
"1017","(۱۰۱۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، عَنْ أُمِّہِ ، عَنْ أُمِّ سَلَمَۃَ ؛ أَنَّ امْرَأَۃً سَأَلَتْہَا عَنِ الْحَائِضِ تَلْبَسُ الثَّوْبَ تُصَلِّی فِیہِ ؟ فَقَالَتْ أُمُّ سَلَمَۃَ : إِنْ کَانَ فِیہِ دَمٌ غَسَلَتْ مَوْضِعَ الدَّمِ ، وَإِلا صَلَّتْ فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1017","","","كتاب الطهارة"
"1018","(۱۰۱۸) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ؛ أَنَّ نِسَائَ عَبْدِ اللہِ بْنِ عُمَرَ وَأُمَّہَاتِ أَوْلاَدِہِ کُنَّ یَحِضْنَ ، فَإِذَا طَہُرْنَ لَمْ یَغْسِلْنَ ثِیَابَہُنَّ الَّتِی کُنَّ یَلْبَسْنَ فِی حَیْضَتِہِنَّ ، وَکَانَ ابْنُ عُمَرَ یَقُول : إِنْ رَأَیْتُنَّ دَمًا فَاغْسِلْنَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1018","","","كتاب الطهارة"
"1019","(۱۰۱۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُہُ عَنْ دَمِ الْحَیْضَۃِ یَکُونُ فِی الثَّوْبِ ؟ فَقَالَ : قَالَتْ عَائِشَۃُ : إنَّمَا یَکْفِی إحْدَاکُنَّ أَنْ تَغْسِلَہُ بِالْمَائِ۔","","Musannaf Ibn Abi Shaybah 1019","","","كتاب الطهارة"
"1020","(۱۰۲۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : لاَ تَغْسِلُ الْمَرْأَۃُ ثِیَابَ حَیْضَتِہَا إِنْ شَائَتْ إِلاَّ أَنْ تَرَی دَمًا فَتَغْسِلَہُ۔","","Musannaf Ibn Abi Shaybah 1020","","","كتاب الطهارة"
"1021","(۱۰۲۱) حَدَّثَنَا أَبُو عَامِرٍ الْعَقَدِیُّ ، عَنْ أَفْلَحَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَتِ الْحَائِضُ تَلْبَسُ ثِیَابَہَا ، ثُمَّ تَطْہُرُ ، فَإِنْ لَمْ تَرَ فِی ثَوْبِہَا نَضَحَتْہُ ، ثُمَّ صَلَّتْ فِیہِ۔","","Musannaf Ibn Abi Shaybah 1021","","","كتاب الطهارة"
"1022","(۱۰۲۲) حَدَّثَنَا مُحَمَّدُ بنْ بکر ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ إنْسَانٌ لِعَطَائٍ : الْحَائِضُ تَطْہُرُ وَفِی ثَوْبِہَا الدَّمُ ، وَلَیْسَ یَکْفِیہَا أَنْ تَغْسِلَ الدَّمَ قَطُّ وَتَدَعَ ثَوْبَہَا بَعْدُ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 1022","","","كتاب الطهارة"
"1023","(۱۰۲۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی الْحَائِضِ یُصِیبُ ثَوْبَہَا مِنْ دَمِہَا ، قَالَ : تَغْسِلُہُ ، ثُمَّ یُلَطَّخُ مَکَانُہُ بِالْوَرْسِ وَالزَّعْفَرَانِ ، أَوِ الْعَنْبَرِ۔","","Musannaf Ibn Abi Shaybah 1023","","","كتاب الطهارة"
"1024","(۱۰۲۴) حَدَّثَنَا أَبُوبَکْرِ بْنُ عَیَّاشٍ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَغْسِلُ الْمَرْأَۃُ مَا أَصَابَ ثِیَابَہَا مِنْ دَمِ الْحَیْضِ، وَلَیْسَ النَّضْحُ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 1024","","","كتاب الطهارة"
"1025","(۱۰۲۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ مُعَاذٍ ؛ أَنَّ امْرَأَۃً سَأَلَتْ عَائِشَۃَ عَنْ نَضْحِ الدَّمِ فِی الثَّوْبِ ؟ فَقَالَتْ : اغْسِلِیہِ بِالْمَائِ ، فَإِنَّ الْمَائَ لَہُ طَہُورٌ۔","Sahih","Musannaf Ibn Abi Shaybah 1025","","","كتاب الطهارة"
"1026","(۱۰۲۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَن عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنِ الْمَرْأَۃِ الْحَائِضِ ، یُصِیبُ ثَوْبَہَا الدَّمُ ، فَتَغْسِلُہُ فَیَبْقَی فِیہِ مِثَالُ الدَّمِ ، أَتُصَلِّی فِیہِ ؟ قَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 1026","","","كتاب الطهارة"
"1027","(۱۰۲۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : الْمَرْأَۃُ تُصَلِّی فِی ثِیَابِہَا الَّتِی تَحِیضُ فِیہَا ، إِلاَّ أَنْ یُصِیبَ مِنْہَا شَیْئًا ، فَتَغْسِلَ مَوْضِعَ الدَّمِ۔","","Musannaf Ibn Abi Shaybah 1027","","","كتاب الطهارة"
"1028","(۱۰۲۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، قَالَ : سَأَلْتُہُ عَنِ الْمَرْأَۃِ تَحِیضُ فِی الثَّوْبِ ؟ قَالَ : لاَ بَأْسَ بِہِ ، إِلاَّ أَنْ تَرَی شَیْئًا فَتَغْسِلَہُ۔","","Musannaf Ibn Abi Shaybah 1028","","","كتاب الطهارة"
"1029","(۱۰۲۹) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ فِی ثَوْبِ الْحَائِضِ ، قَالَ : تَغْسِلُ مَکَانَ الدَّمِ۔","","Musannaf Ibn Abi Shaybah 1029","","","كتاب الطهارة"
"1030","(۱۰۳۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا طَہُرَتِ الْحَائِضُ لَمْ یَقْرَبْہَا زَوْجُہَا حَتَّی تَغْتَسِلَ۔","","Musannaf Ibn Abi Shaybah 1030","","","كتاب الطهارة"
"1031","(۱۰۳۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 1031","","","كتاب الطهارة"
"1032","(۱۰۳۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس ، قَالَ : إذَا طَہُرَتِ الْمَرْأَۃُ مِنَ الدَّمِ فَأَرَادَ الرَّجُلُ الشَّبِقُ أَنْ یَأْتِیَہَا ، فَلْیَأْمُرْہَا أَنْ تَوَضَّأَ ، ثُمَّ لِیُصِبْ مِنْہَا إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 1032","","","كتاب الطهارة"
"1033","(۱۰۳۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ؛ فِی الْحَائِضِ یَنْقَطِعُ عَنْہَا الدَّمُ ، قَالَ : لاَ یَأْتِیہَا حَتَّی تَحِلَّ لَہَا الصَّلاَۃُ۔","","Musannaf Ibn Abi Shaybah 1033","","","كتاب الطهارة"
"1034","(۱۰۳۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا انْقَطَعَ الدَّمُ فَأَصَابَ زَوْجَہَا شَبَقٌ ، یَخَافُ فِیہِ عَلَی نَفْسِہِ فَلْیَأْمُرْہَا بِغَسْلِ فَرْجِہَا ، ثُمَّ یُصِیبُ مِنْہَا إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 1034","","","كتاب الطهارة"
"1035","(۱۰۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ أَنْ یَأْتِیَ الرَّجُلُ امْرَأَتَہُ وَقَدْ طَہُرَتْ ، قَبْلَ أَنْ تَغْتَسِلَ۔","","Musannaf Ibn Abi Shaybah 1035","","","كتاب الطهارة"
"1036","(۱۰۳۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ أَبِی سَلَمَۃَ ، وَسُلَیْمَانَ بْنِ یَسَارٍ قَالاَ : لاَ یَأْتِیہَا زَوْجُہَا حَتَّی تَغْتَسِلَ۔","","Musannaf Ibn Abi Shaybah 1036","","","كتاب الطهارة"
"1037","(۱۰۳۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ کَانَ یَقُولُ : لاَ یَغْشَی الرَّجُلُ الْمَرْأَۃَ إذَا طَہُرَتْ مِنَ الْحَیْضَۃِ حَتَّی تَغْتَسِلَ۔","","Musannaf Ibn Abi Shaybah 1037","","","كتاب الطهارة"
"1038","(۱۰۳۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی الْمُنِیبِ ، عَنْ عِکْرِمَۃَ ، قَالَ : إذَا انْقَطَعَ عَنْہَا الدَّمُ فَلاَ یَأْتِیہَا حَتَّی تَطْہُرَ ، فَإِذَا طَہُرَتْ فَلْیَأْتِہَا کَمَا أَمَرَہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 1038","","","كتاب الطهارة"
"1039","(۱۰۳۹) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا طَہُرَتِ الْحَائِضُ فَلَمْ تَجِدْ مَائً تَیَمَّمُ ، وَیَأْتِیہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 1039","","","كتاب الطهارة"
"1040","(۱۰۴۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِنْ کَانَتِ الْمَرْأَۃُ حَائِضًا فَرَأَتِ الطُّہْرَ فِی سَفَرٍ ، تَیَمَّمَتِ الصَّعِیدَ لِطُہْرِہَا ، ثُمَّ أَصَابَ مِنْہَا إِنْ شَائَ","","Musannaf Ibn Abi Shaybah 1040","","","كتاب الطهارة"
"1041","حَدَّثَنَا الْحَسَنُ بْنُ سَعِیدٍ ، قَالَ : حدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بَقِیُّ بْنُ مَخْلَدٍ ، قَالَ : حَدَّثَنَا أَبُو بَکْرٍ عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ ، قَالَ :n(۱۰۴۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، قَالَ : قَدِمَ عَلَی رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ نَفَرٌ مِنْ بَنِی قُشَیْرٍ فَقَالُوا: إنَّا نَعْزُبُ عَنِ الْمَائِ ، وَمَعَنَا أَہْلُونَا وَلَیْسَ مَعَنَا مِنَ الْمَائِ إِلاَّ لِشِفَاہِنَا ، قَالَ: نَعَمْ ، وَإِنْ کَانَ ذَلِکَ سَنَۃً ، أَوْ سَنَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 1041","","","كتاب الطهارة"
"1042","(۱۰۴۲) حَدَّثَنَا جَرِیرٌ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ فِی سَفَرٍ مَعَ أُنَاسٍ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فِیہِمْ عَمَّارُ بْنُ یَاسِرٍ ، فَکَانُوا یُقَدِّمُونَہُ یُصَلِّی بِہِمْ لِقَرَابَتِہِ مِنْ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَصَلَّی بِہِمْ ذَاتَ یَوْمٍ ، ثُمَّ الْتَفَتَ إلَیْہِمْ فَضَحِکَ فَأَخْبَرَہُمْ أَنَّہُ أَصَابَ مِنْ جَارِیَۃٍ لَہُ رُومِیَّۃٍ ، وَصَلَّی بِہِمْ وَہُوَ جُنُبٌ مُتَیَمِّمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 1042","","","كتاب الطهارة"
"1043","(۱۰۴۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ ، سُئِلَ عَنِ الرَّجُلِ یَعْزُبُ وَمَعَہُ أَہْلُہُ ؟ قَالَ : یَأْتِی أَہْلَہُ وَیَتَیَمَّمُ۔","","Musannaf Ibn Abi Shaybah 1043","","","كتاب الطهارة"
"1044","(۱۰۴۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ أَبِی الْعَوَّامِ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ ابْنِ عُمَرَ فَجَائَ أَعْرَابِیٌّ ، فَقَالَ لَہُ : إنَّا نَعْزُبُ فِی الْمَاشِیَۃِ عَنِ الْمَائِ ، فَیَحْتَاجُ أَحَدُنَا إلَی أَنْ یُصِیبَ أَہْلَہُ ، قَالَ : أَمَّا ابْنُ عُمَرَ فَلَمْ یَکُنْ لِیَفْعَلَہُ ، وَأَمَّا أَنْتَ فَإِذَا وَجَدْت الْمَائَ فَاغْتَسِلْ۔","Da'if","Musannaf Ibn Abi Shaybah 1044","","","كتاب الطهارة"
"1045","(۱۰۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ أَبِی عَبْدِ اللہِ الْمَوْصِلِیِّ ، قَالَ : کَانَ ابْنُ عَوْفٍ ، وَابْنُ عَبَّاسٍ ، وَابْنُ عُمَرَ فِی سَفَرٍ لاَ یَجِدُونَ الْمَائَ ، فَوَاقَعَ ابْنُ عَبَّاسٍ ، فَعَابُوا ذَلِکَ عَلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1045","","","كتاب الطهارة"
"1046","(۱۰۴۶) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا إذَا کَانَ الرَّجُلُ فِی سَفَرٍ وَلَیْسَ مَعَہُ مَائٌ ، أَنْ یُصِیبَ مِنْ أَہْلِہِ ، ثُمَّ یَتَیَمَّمَ۔","","Musannaf Ibn Abi Shaybah 1046","","","كتاب الطهارة"
"1047","(۱۰۴۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامِ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : إذَا کَانَ الرَّجُلُ فِی سَفَرٍ ، وَبَیْنَہُ وَبَیْنَ الْمَائِ لَیْلَتَانِ ، أَوْ ثَلاَثٌ فَلاَ بَأْسَ أَنْ یُصِیبَ مِنْ أَہْلِہِ ، ثُمَّ یَتَیَمَّمَ۔","","Musannaf Ibn Abi Shaybah 1047","","","كتاب الطهارة"
"1048","(۱۰۴۸) حَدَّثَنَا حَفْصٌ ، عَنْ شَیْخٍ ، قَالَ : کَانَ سَالِمٌ یُجَامِعُ عَلَی غَیْرِ مَائٍ وَیَتَیَمَّمُ ، إذَا کَانَ الْمَائُ جَامِدًا۔","","Musannaf Ibn Abi Shaybah 1048","","","كتاب الطهارة"
"1049","(۱۰۴۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا کَانَ بِأَرْضٍ فَلاَۃٍ ، فَأَصَابَہُ شَبَقٌ یَخَافُ فِیہِ عَلَی نَفْسِہِ ، وَمَعَہُ امْرَأَتُہُ ، فَلْیَقَعْ عَلَیْہَا إِنْ شَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 1049","","","كتاب الطهارة"
"1050","(۱۰۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّ أَبَا ذَرٍّ کَانَ فِی سَفَرٍ ، فَوَطِیئَ أَہْلَہُ وَلَیْسَ عِنْدَہُ مَائٌ۔","","Musannaf Ibn Abi Shaybah 1050","","","كتاب الطهارة"
"1051","(۱۰۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ أَبِی عُبَیْدَۃَ ؛ أَنَّہُ کَرِہَ أَنْ یُجَامِعَ وَہُوَ لاَ یَجِدُ الْمَائَ۔","","Musannaf Ibn Abi Shaybah 1051","","","كتاب الطهارة"
"1052","(۱۰۵۲) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، قَالَ : کُنَّا مَعَ ابْنِ عَبَّاسٍ فِی سَفَرٍ وَمَعَہُ جَارِیَۃٌ لَہُ ، فَتَخَلَّفَ ، فَأَصَابَ مِنْہَا ثُمَّ أَدْرَکَنَا ، فَقَالَ : مَعَکُمْ مَائٌ ؟ قُلْنَا : لاَ ، قَالَ : أَمَا إنِّی قَدْ عَلِمْت ذَاکَ ، فَتَیَمَّمَ۔","Sahih","Musannaf Ibn Abi Shaybah 1052","","","كتاب الطهارة"
"1053","(۱۰۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَزِینٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا قَامَ أَحَدُکُمْ مِنَ اللَّیْلِ فَلاَ یَغْمِسْ یَدَہُ فِی الإِنَائِ ، حَتَّی یَغْسِلَہَا ثَلاَثَ مَرَّاتٍ ، فَإِنَّہُ لاَ یَدْرِی أَیْنَ بَاتَتْ یَدُہُ۔ (مسلم ۲۳۳۔ ابوداؤد ۱۰۴)","Sahih","Musannaf Ibn Abi Shaybah 1053","","","كتاب الطهارة"
"1054","(۱۰۵۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا قَامَ أَحَدُکُمْ مِنْ نَوْمِہِ ، فَلْیُفْرِغْ عَلَی یَدِہِ مِنْ إنَائِہِ ثَلاَثَ مَرَّاتٍ ، فَإِنَّہُ لاَ یَدْرِی أَیْنَ بَاتَتْ یَدُہُ۔ (مسلم ۲۳۳۔ ترمذی۲۴)","Hasan","Musannaf Ibn Abi Shaybah 1054","","","كتاب الطهارة"
"1055","(۱۰۵۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا قَامَ أَحَدُکُمْ مِنَ اللَّیْلِ ، فَلاَ یُدْخِلْ یَدَہُ فِی الإِنَائِ حَتَّی یَغْسِلَہَا۔ (احمد ۵۰۷۔ مسلم ۲۳۳)","Hasan","Musannaf Ibn Abi Shaybah 1055","","","كتاب الطهارة"
"1056","(۱۰۵۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا اسْتَیْقَظَ الرَّجُلُ مِنْ نَوْمِہِ ، فَلاَ یُدْخِلْ یَدَہُ فِی الإِنَائِ حَتَّی یَغْسِلَہَا۔","","Musannaf Ibn Abi Shaybah 1056","","","كتاب الطهارة"
"1057","(۱۰۵۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : النَّائِمُ وَالْمُسْتَیْقِظُ سَوَائٌ ، إذَا وَجَبَ عَلَیْہِ الْوُضُوئُ ، فَلاَ یُدْخِلْ یَدَہُ فِی الإِنَائِ حَتَّی یَغْسِلَہَا۔","","Musannaf Ibn Abi Shaybah 1057","","","كتاب الطهارة"
"1058","(۱۰۵۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ إذَا ذُکِرَ عِنْدَہُمْ حَدِیثُ أَبِی ہُرَیْرَۃَ قَالُوا : کَیْفَ یَصْنَعُ أَبُو ہُرَیْرَۃَ بِالْمِہْرَاسِ الَّذِی بِالْمَدِینَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 1058","","","كتاب الطهارة"
"1059","(۱۰۵۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیدَۃَ ؛ أَنَّہُ کَانَ یُدْخِلُ یَدَہُ فِی الإِنَائِ إذَا خَرَجَ مِنَ الْمَخْرَجِ ، قَبْلَ أَنْ یَغْسِلَہَا۔","","Musannaf Ibn Abi Shaybah 1059","","","كتاب الطهارة"
"1060","(۱۰۶۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ یَخْرُجُ مِنَ الْخَلاَئِ ، ثُمَّ یَضَعُ یَدَہُ فِی الإِنَائِ قَبْلَ أَنْ یَغْسِلَہَا۔","","Musannaf Ibn Abi Shaybah 1060","","","كتاب الطهارة"
"1061","(۱۰۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ بَالَ ، ثُمَّ أَدْخَلَ یَدَہُ فِی الإِنَائِ قَبْلَ أَنْ یَغْسِلَہَا۔","","Musannaf Ibn Abi Shaybah 1061","","","كتاب الطهارة"
"1062","(۱۰۶۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عِیسَی بْنِ الْمُغِیرَۃِ الْحَرَامِیِّ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الرَّجُلِ یَغْمِسُ یَدَہُ فِی الإِنَائِ ، قَبْلَ أَنْ یَغْسِلَہَا ؟ فَقَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 1062","","","كتاب الطهارة"
"1063","(۱۰۶۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مَہْدِیِّ بْنِ مَیْمُونٍ ، عَنْ إسْمَاعِیلَ بْنِ إبْرَاہِیمَ ، قَالَ : رَأَیْتُ سَالِمًا ذَہَبَ فَبَالَ ، ثُمَّ أَدْخَلَ یَدَیْہِ جَمِیعًا فِی الإِنَائِ قَبْلَ أَنْ یَغْسِلَہُمَا۔","","Musannaf Ibn Abi Shaybah 1063","","","كتاب الطهارة"
"1064","(۱۰۶۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الصَّلْتِ بْنِ بَہْرَامَ ، قَالَ : رَأَیْتُ إبْرَاہِیمَ بَالَ ، ثُمَّ أَدْخَلَ یَدَہُ فِی الإِنَائِ قَبْلَ أَنْ یَغْسِلَہَا ، قَالَ : فَصِحْت بِہِ ، قَالَ : فَتَبَسَّمَ وَقَالَ : مَا مِنْ رَجُلٍ أَشَدُّ فِی ہَذَا مِنِّی ، إنِّی لَمْ أُدْخِلْہَا إِلاَّ وَہِیَ طَاہِرَۃٌ۔","","Musannaf Ibn Abi Shaybah 1064","","","كتاب الطهارة"
"1065","(۱۰۶۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنْ أَبِیہِ ، عَنِ الْبَرَائِ ؛ أَنَّہُ أَدْخَلَ یَدَہُ فِی الْمَطْہَرَۃِ قَبْلَ أَنْ یَغْسِلَہَا ۔ قَالَ الأَعْمَش : ہَذَا حَرْفٌ أَسْتَحْسِنُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 1065","","","كتاب الطهارة"
"1066","(۱۰۶۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، قَالَ : حدَّثَنَا أَبُو إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : دَعَا بِمَائٍ فَغَسَلَ یَدَیْہِ ثَلاَثًا ، قَبْلَ أَنْ یُدْخِلَہُمَا فِی الإِنَائِ ، ثُمَّ قَالَ : ہَکَذَا رَأَیْت رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ صَنَعَ۔","Da'if","Musannaf Ibn Abi Shaybah 1066","","","كتاب الطهارة"
"1067","(۱۰۶۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا بَالَ الرَّجُلُ ، أَوْ أَحْدَثَ فَلاَ یُدْخِلْ یَدَہُ فِی الإِنَائِ حَتَّی یَغْسِلَہَا۔","","Musannaf Ibn Abi Shaybah 1067","","","كتاب الطهارة"
"1068","(۱۰۶۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سلمِ بْنِ أَبِی الذَّیَّالِ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَرَدْتُمْ أَنْ تَوَضَّؤُوا ، فَلاَ تَغْمِسُوا أَیْدِیَکُمْ فِی الإِنَائِ حَتَّی تُنَقُّوہَا۔","","Musannaf Ibn Abi Shaybah 1068","","","كتاب الطهارة"
"1069","(۱۰۶۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی حَیَّۃَ ، قَالَ : رَأَیْتُ عَلِیًّا تَوَضَّأَ فَأَنْقَی کَفَّیْہِ ثُمَّ غَسَلَ وَجْہَہُ وَذِرَاعَیْہِ ، ثُمَّ قَالَ : إنَّمَا أَرَدْتُ أَنْ أُرِیَکُمْ طُہُورَ رَسُولِ اللہِ صلی اللہ علیہ وسلم۔","Hasan","Musannaf Ibn Abi Shaybah 1069","","","كتاب الطهارة"
"1070","(۱۰۷۰) حَدَّثَنَا أَبُوالأَحْوَصِِ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ، قَالَ: کَانَ یُقَالُ: اغْسِلِ الشَّعْرَ وَأَنْقِ الْبَشَرَۃَ، فِی الْجَنَابَۃِ۔","","Musannaf Ibn Abi Shaybah 1070","","","كتاب الطهارة"
"1071","(۱۰۷۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : تَحْتَ کُلِّ شَعَرَۃٍ جَنَابَۃٌ ، فَبُلُّوا الشَّعَرَ، وَأَنْقُوا الْبَشَرَۃَ۔","","Musannaf Ibn Abi Shaybah 1071","","","كتاب الطهارة"
"1072","(۱۰۷۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، قَالَ : خَرَجَ حُذَیْفَۃُ ، وَقَدْ طَمَّ شَعَرَہُ ، فَقَالَ : إنَّ تَحْتَ کُلِّ شَعَرَۃٍ لاَ یُصِیبُہَا الْمَائُ جَنَابَۃٌ ، فَعَافُوہَا ، فَلِذَلِکَ عَادَیْت رَأْسِی کَمَا تَرَوْنَ۔","","Musannaf Ibn Abi Shaybah 1072","","","كتاب الطهارة"
"1073","(۱۰۷۳) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ زَاذَانَ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ تَرَکَ مَوْضِعَ شَعَرَۃٍ مِنْ جَسَدِہِ مِنْ جَنَابَۃٍ لَمْ یَغْسِلْہَا ، فُعِلَ بِہِ کَذَا وَکَذَا مِنَ النَّارِ ، قَالَ عَلِیٌّ : فَمِنْ ثَمَّ عَادَیْتُ شَعَرِی ، قَالَ : وَکَانَ یَجُزُّ شَعَرَہُ۔ (احمد ۱/۱۰۱۔ ابوداؤد ۲۵۳)","Shadh","Musannaf Ibn Abi Shaybah 1073","","","كتاب الطهارة"
"1074","(۱۰۷۴) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ قُرَّۃَ ، عَنِ الْحَسَنِ ، قَالَ : تَحْتَ کُلِّ شَعَرَۃٍ جَنَابَۃٌ ، قَالَ : وَقَالَ : أَبُو ہُرَیْرَۃَ : أَمَّا أَنَا فَأَبُلُّ الشَّعَرَ ، وَأُنْقِی الْبَشَرَ۔ (ابوداؤد ۲۵۲۔ ترمذی ۱۰۶)","","Musannaf Ibn Abi Shaybah 1074","","","كتاب الطهارة"
"1075","(۱۰۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ إذَا اغْتَسَلَ مِنَ الْجَنَابَۃِ ، أَدْخَلَ الْمَائَ فِی عَیْنَیْہِ ، وَأَدْخَلَ یَدَہُ فِی سُرَّتِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 1075","","","كتاب الطهارة"
"1076","(۱۰۷۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا أَجْنَبَ الرَّجُلُ وَبِہِ الْجِرَاحَۃُ وَالْجُدَرِیُّ ، فَخُوِّفَ عَلَی نَفْسِہِ إِنْ ہُوَ اغْتَسَلَ ، قَالَ : یَتَیَمَّمُ بِالصَّعِیدِ۔","Da'if","Musannaf Ibn Abi Shaybah 1076","","","كتاب الطهارة"
"1077","(۱۰۷۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ۔ وَعَنِ الْحَسَنِ ، وَالشَّعْبِیِّ ؛ أَنَّہُمْ قَالُوا فِی الَّذِی بِہِ الْجُرْحُ وَالْمَحْصُوبُ وَالْمَجْدُورُ : یَتَیَمَّمُ۔","","Musannaf Ibn Abi Shaybah 1077","","","كتاب الطهارة"
"1078","(۱۰۷۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ فِی صَاحِبِ الْقُرُوحِ وَالَّذِی یَخَافُ عَلَی نَفْسِہِ : یَتَیَمَّمُ۔","","Musannaf Ibn Abi Shaybah 1078","","","كتاب الطهارة"
"1079","(۱۰۷۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ۔ وَعَنِ الْحَکَمِ ، عَنِ الْمِقْسَمِ قَالاَ ؛ فِی الرَّجُلِ تَکُونُ بِہِ الْقُرُوحُ وَالْجُرُوحُ وَالْجُدَرِیُّ لاَ یَسْتَطِیعُ الْمَائَ أَنَّہُ یَتَیَمَّمُ۔","","Musannaf Ibn Abi Shaybah 1079","","","كتاب الطهارة"
"1080","(۱۰۸۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَزْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ فِی الرَّجُلِ یَکُونُ بِہِ الْجُرُوحُ ، أَوِ الْقُرُوحُ ، أَوِ الْمَرَضُ فَتُصِیبُہُ الْجَنَابَۃُ ، فَیَکْبُرَ عَلَیْہِ الْغُسْلُ ، قَالَ : یَتَیَمَّمُ۔","","Musannaf Ibn Abi Shaybah 1080","","","كتاب الطهارة"
"1081","(۱۰۸۱) حَدَّثَنَا ابْنُ غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ؛ فِی الْمَرِیضِ یَجْنُبُ فَیُخَافُ عَلَیْہِ إنِ اغْتَسَلَ ، قَالَ : یَتَیَمَّمُ۔","","Musannaf Ibn Abi Shaybah 1081","","","كتاب الطهارة"
"1082","(۱۰۸۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ، أَنَّہُ قَالَ فِی الْمَجْدُورِ وَأَشْبَاہِہِ : إذَا خُشِیَ عَلَیْہِمْ ، فَہُمْ بِمَنْزِلَۃِ الْمُسَافِرِ یَتَیَمَّمُ۔","","Musannaf Ibn Abi Shaybah 1082","","","كتاب الطهارة"
"1083","(۱۰۸۳) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ إِسْحَاقَ بْنِ أَبِی فَرْوَۃَ ، عَنْ عَطَائٍ ؛ أَنَّ رَجُلاً احْتَلَمَ عَلَی عَہْدِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ وَہُوَ مَجْدُورٌ ، فَغَسَّلُوہُ ، فَمَاتَ ، فَبَلَغَ ذَلِکَ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : ضَیَّعُوہُ ضَیَّعَہُمُ اللَّہُ ، قَتَلُوہُ قَتَلَہُمُ اللَّہُ۔ (ابوداؤد ۳۴۰)","Da'if","Musannaf Ibn Abi Shaybah 1083","","","كتاب الطهارة"
"1084","(۱۰۸۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یُقْرِئُنَا الْقُرْآنَ عَلَی کُلِّ حَالٍ ، إِلاَّ الْجَنَابَۃَ۔ (ابوداؤد ۲۳۲۔ ترمذی ۱۴۶۔ احمد ۱/۱۳۴)","Hasan","Musannaf Ibn Abi Shaybah 1084","","","كتاب الطهارة"
"1085","(۱۰۸۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، وَوَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 1085","","","كتاب الطهارة"
"1086","(۱۰۸۶) حَدَّثَنَا حَفْصٌ، وَأَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ شَقِیقٍ، عَنْ عَبِیْدَۃَ، عَنْ عُمَرَ، قَالَ: لاَ یَقْرَأُ الْجُنُبُ الْقُرْآنَ۔","Sahih","Musannaf Ibn Abi Shaybah 1086","","","كتاب الطهارة"
"1087","(۱۰۸۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ ابْنَ مَسْعُودٍ کَانَ یَمْشِی نَحْوَ الْفُرَاتِ ، وَہُوَ یُقْرِئُ رَجُلاً ، فَبَالَ ابْنُ مَسْعُودٍ فَکَفَّ الرَّجُلُ عَنْہُ ، فَقَالَ : ابْنُ مَسْعُودٍ : مَا لَکَ ؟ قَالَ : إنَّک بُلْت ، فَقَالَ ابْنُ مَسْعُودٍ : إنِّی لَسْتُ بِجُنُبِ۔","","Musannaf Ibn Abi Shaybah 1087","","","كتاب الطهارة"
"1088","(۱۰۸۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ، عَنْ إبْرَاہِیمَ، عَنِ الأَسْوَدِ، قَالَ: لاَ یَقْرَأُ الْجُنُبُ۔","","Musannaf Ibn Abi Shaybah 1088","","","كتاب الطهارة"
"1089","(۱۰۸۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ یَقْرَأُ الْجُنُبُ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 1089","","","كتاب الطهارة"
"1090","(۱۰۹۰) حَدَّثَنَا شَرِیکٌ ، عَنْ فِرَاسٍ ، عَنْ عَامِرٍ ، قَالَ : الْجُنُبُ وَالْحَائِضُ لاَ یَقْرَآنِ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 1090","","","كتاب الطهارة"
"1091","(۱۰۹۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَیَّارٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : لاَ یَقْرَأُ الْجُنُبُ وَالْحَائِضُ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 1091","","","كتاب الطهارة"
"1092","(۱۰۹۲) حَدَّثَنَا شَرِیکٌ، عَنْ عَامِرِ بْنِ السِّمْطِ، عَنْ أَبِی الْغَرِیفِ، عَنْ عَلِیٍّ، قَالَ: لاَ یَقْرَأُ، وَلاَ حَرْفًا، یَعْنِی: الْجُنُبُ۔","Hasan","Musannaf Ibn Abi Shaybah 1092","","","كتاب الطهارة"
"1093","(۱۰۹۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَقْرَأُ الْجُنُبُ الْقُرْآنَ ، وَقَالَ : إِنَّہُ إذَا قَرَأَ صَلَّی۔","","Musannaf Ibn Abi Shaybah 1093","","","كتاب الطهارة"
"1094","(۱۰۹۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَقْرَأَ الْجُنُبُ وَالْحَائِضُ الشَّیئَ مِنَ الْقُرْآنِ۔","","Musannaf Ibn Abi Shaybah 1094","","","كتاب الطهارة"
"1095","(۱۰۹۵) أَخْبَرَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَقْرَأَ الْجُنُبُ الآیَۃَ وَالآیَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 1095","","","كتاب الطهارة"
"1096","(۱۰۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ۔ وَعَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، وَسَعِیدِ بْنِ جُبَیْرٍ ؛ فِی الْحَائِضِ وَالْجُنُبِ یَسْتَفْتِحُونَ رَأْسَ الآیَۃِ ، وَلاَ یُتِمُّونَ آخِرَہَا۔","","Musannaf Ibn Abi Shaybah 1096","","","كتاب الطهارة"
"1097","(۱۰۹۷) حَدَّثَنَا شَرِیکٌ ، عَنْ عَامِرِ بْنِ السِّمْطِ ، عَنْ أَبِی الْغَرِیفِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ یَقْرَأُ ، وَلاَ حَرْفًا۔","Hasan","Musannaf Ibn Abi Shaybah 1097","","","كتاب الطهارة"
"1098","(۱۰۹۸) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ عُمَرَ بْنِ عَبْدِ اللہِ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ : تَقْرَأُ الْحَائِضُ وَالْجُنُبُ ؟ قَالَ : الآیَۃَ وَالآیَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 1098","","","كتاب الطهارة"
"1099","(۱۰۹۹) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ عُمَرَ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ مَعْقِلٍ ، مِثْلَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 1099","","","كتاب الطهارة"
"1100","(۱۱۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَقْرَأُ الْجُنُبُ الْقُرْآنَ ، قَالَ : فَذَکَرْتُہُ لإِبْرَاہِیمَ ، فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 1100","","","كتاب الطهارة"
"1101","(۱۱۰۱) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : الْحَائِضُ لاَ تَقْرَأُ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 1101","","","كتاب الطهارة"
"1102","(۱۱۰۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : الْحَائِضُ لاَ تَقْرَأُ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 1102","","","كتاب الطهارة"
"1103","(۱۱۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَقْرَأ مِمَّا دُونَ الآیَۃِ ، وَلاَ تَقْرَأُ آیَۃً تَامَّۃً۔","","Musannaf Ibn Abi Shaybah 1103","","","كتاب الطهارة"
"1104","(۱۱۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عُمَرَ ، قَالَ : لاَ تَقْرَأُ الْحَائِضُ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 1104","","","كتاب الطهارة"
"1105","(۱۱۰۵) حَدَّثَنَا شَرِیکٌ ، عَنْ فِرَاسٍ ، عَنْ عَامِرٍ ؛ لاَ تَقْرَأُ الْقُرْآنَ۔","","Musannaf Ibn Abi Shaybah 1105","","","كتاب الطهارة"
"1106","(۱۱۰۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : کُنَّا مَعَ سَلْمَانَ فِی حَاجَۃٍ ، فَذَہَبَ فَقَضَی حَاجَتَہُ ثُمَّ رَجَعَ ، فَقُلْنَا لَہُ : تَوَضَّأْ ، یَا أَبَا عَبْدِ اللہِ لَعَلَّنَا أَنْ نَسْأَلَک عَنْ آیٍ مِنَ الْقُرْآنِ ؟ قَالَ : قَالَ : فَاسْأَلُوا ، فَإِنِّی لاَ أَمَسُّہُ ، إِنَّہُ لاَ یَمَسُّہُ إِلاَّ الْمُطَہَّرُونَ ، قَالَ : فَسَأَلْنَاہُ ، فَقَرَأَ عَلَیْنَا قَبْلَ أَنْ یَتَوَضَّأَ۔","Sahih","Musannaf Ibn Abi Shaybah 1106","","","كتاب الطهارة"
"1107","(۱۱۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ یَزِیدِ بْنِ مُعَاوِیَۃَ ، عَنْ عَلْقَمَۃَ وَالأَسْوَدِ ؛ أَنَّ سَلْمَانَ قَرَأَ عَلَیْہِمَا بَعْدَ الْحَدَثِ۔","Sahih","Musannaf Ibn Abi Shaybah 1107","","","كتاب الطهارة"
"1108","(۱۱۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ ، قَالَ : کَانَا یَقْرَآنِ أَجْزَائَہُمَا مِنَ الْقُرْآنِ بَعْدَ مَا یَخْرُجَانِ مِنَ الْخَلاَئِ ، قَبْلَ أَنْ یَتَوَضَّأَ۔","Sahih","Musannaf Ibn Abi Shaybah 1108","","","كتاب الطهارة"
"1109","(۱۱۰۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ أَبَا ہُرَیْرَۃَ کَانَ یَخْرُجُ مِنَ الْمَخْرَجِ ، ثُمَّ یَحْدُرُ السُّورَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 1109","","","كتاب الطهارة"
"1110","(۱۱۱۰) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ؛ أَنَّ عُمَرَ قَضَی حَاجَتَہُ ، ثُمَّ أَخَذَ یَقْرَأُ ، فَقَالَ لَہُ أَبُو مَرْیَمَ : لَوْ تَوَضَّأْت یَا أَمِیرَ الْمُؤْمِنِینَ ، فَقَالَ لَہُ عُمَرُ : أَمُسَیْلِمَۃُ أَفْتَاک ذَاکَ ؟!۔","","Musannaf Ibn Abi Shaybah 1110","","","كتاب الطهارة"
"1111","(۱۱۱۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ۔ وَعَنْ أَبِی مَرْیَمَ ، عْن عُمَرَ ، بِمِثْلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1111","","","كتاب الطهارة"
"1112","(۱۱۱۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : خَرَجَ عُمَرُ مِنَ الْخَلاَئِ فَقَرَأَ آیَۃً مِنْ کِتَابِ اللہِ ، فَقِیلَ لَہُ : أَتَقْرَأُ وَقَدْ أَحْدَثْت؟ قَالَ : أَفَیَقْرَأُ ذَلِکَ مُسَیْلِمَۃُ ؟۔","","Musannaf Ibn Abi Shaybah 1112","","","كتاب الطهارة"
"1113","(۱۱۱۳) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ سَلِمَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یُقْرِئُنَا الْقُرْآنَ عَلَی کُلِّ حَالٍ ، مَا لَمْ یَکُنْ جُنُبًا۔","Hasan","Musannaf Ibn Abi Shaybah 1113","","","كتاب الطهارة"
"1114","(۱۱۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ نَافِعِ بْنِ جُبَیْرٍ ؛ أَنَّہُ لَمْ یَرَ بَأْسًا بِالْقُرْآنِ عَلَی غَیْرِ طَہَارَۃٍ۔","","Musannaf Ibn Abi Shaybah 1114","","","كتاب الطهارة"
"1115","(۱۱۱۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ حُمَیْدٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ عَلِیُّ بْنُ حُسَیْنٍ یَقْرَأُ الْقُرْآنَ بَعْدَ الْحَدَثِ۔","","Musannaf Ibn Abi Shaybah 1115","","","كتاب الطهارة"
"1116","(۱۱۱۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یُہْرِیقُ الْمَائَ ، یَقْرَأُ الْقُرْآنَ ؟ قَالَ : یَکُونُ عَلَی طُہْرٍ أَحَبُّ إلَیَّ ، إِلاَّ أَنْ یَکُونَ یَقْرَأُ طَرَفَ الآیَۃِ ، أَوِ الشَّیْئَ۔","","Musannaf Ibn Abi Shaybah 1116","","","كتاب الطهارة"
"1117","(۱۱۱۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : رُبَّمَا نَزَلْتُ وَأَنَا فِی السَّفَرِ لاَقْضِیَ حَاجَتِی مِنَ الْغَائِطِ وَالْبَوْلِ ، فَمَا أَلْحَقُ بِأَصْحَابِی حَتَّی أَقْرَأَ جُزْئً ا مِنَ الْقُرْآنِ ، قَبْلَ أَنْ أَتَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1117","","","كتاب الطهارة"
"1118","(۱۱۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کُنْتُ أَقْرَأُ فِی الْمُصْحَفِ ، فَخَرَجَ أَبِی مِنَ الْخَلاَئِ ، وَقَدْ تَعَایَیْتُ فِی آیَۃٍ ، فَأَذْکَرَنِیہَا۔","","Musannaf Ibn Abi Shaybah 1118","","","كتاب الطهارة"
"1119","(۱۱۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : اقْرَإِ الْقُرْآنَ عَلَی کُلِّ حَالٍ مَا لَمْ تَکُنْ جُنُبًا۔","Da'if","Musannaf Ibn Abi Shaybah 1119","","","كتاب الطهارة"
"1120","(۱۱۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ یَقْرَأُ بَعْدَ الْحَدَثِ۔","","Musannaf Ibn Abi Shaybah 1120","","","كتاب الطهارة"
"1121","(۱۱۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : اقْرَإِ الْقُرْآنَ عَلَی کُلِّ حَالٍ مَا لَمْ تَکُنْ جُنُبًا۔","","Musannaf Ibn Abi Shaybah 1121","","","كتاب الطهارة"
"1122","(۱۱۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ؛ أَنَّہُ کَانَ مَعَہُ رَجُلٌ فَبَالَ ثُمَّ جَائَ ، فَقَالَ لَہُ ابْنُ مَسْعُودٍ : اِقْرَہْ۔","","Musannaf Ibn Abi Shaybah 1122","","","كتاب الطهارة"
"1123","(۱۱۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ؛ أَنَّ ابْنَ عَبَّاسٍ ، وَابْنَ عُمَرَ کَانَا یَقْرَآنِ الْقُرْآنَ بَعْدَ مَا یَخْرُجَانِ مِنَ الْحَدَثِ ، قَبْلَ أَنْ یَتَوَضّآ۔","Sahih","Musannaf Ibn Abi Shaybah 1123","","","كتاب الطهارة"
"1124","(۱۱۲۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عَطَائٍ ، عَنْ زَاذَانَ ، عَنْ عَلِیٍّ ، قَالَ : إذَا أَجْنَبَ الرَّجُلُ فِی أَرْضٍ فَلاَۃٍ وَمَعَہُ مَائٌ یَسِیرٌ ، فَلْیُؤْثِرْ نَفْسَہُ بِالْمَائِ ، وَلْیَتَیَمَّمْ بِالصَّعِیدِ۔","Da'if","Musannaf Ibn Abi Shaybah 1124","","","كتاب الطهارة"
"1125","(۱۱۲۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوس قَالاَ : إذَا کُنْتَ فِی سَفَرٍ وَلَیْسَ مَعَک مِنَ الْمَائِ إِلاَّ یَسِیرٌ ، فَتَیَمَّمْ ، وَاسْتَبِقْ مَائَکَ۔","","Musannaf Ibn Abi Shaybah 1125","","","كتاب الطهارة"
"1126","(۱۱۲۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا کُنْتَ مُسَافِرًا وَأَنْتَ جُنُبٌ ، أَوْ أَنْتَ عَلَی غَیْرِ وُضُوئٍ ، فَخِفْت إِنْ تَوَضَّأْت أَنْ تَمُوتَ مِنَ الْعَطَشِ ، فَلاَ تَوَضَّہْ وَاحْبِسْہُ لِنَفْسِک۔","Da'if","Musannaf Ibn Abi Shaybah 1126","","","كتاب الطهارة"
"1127","(۱۱۲۷) حَدَّثَنَا حُمَیْدٌ ، عَنْ حَسَنٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 1127","","","كتاب الطهارة"
"1128","(۱۱۲۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ؛ أَنَّ عُمَرَ کَانَ إذَا بَالَ تَیَمَّمَ ، قَالَ : أَتَیَمَّمُ حَتَّی یَحِلَّ لِی التَّسْبِیحُ۔","","Musannaf Ibn Abi Shaybah 1128","","","كتاب الطهارة"
"1129","(۱۱۲۹) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا بَالَ فَأَرَادَ أَنْ یَأْکُلَ تَوَضَّأَ ، وَلَمْ یَغْسِلْ رِجْلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 1129","","","كتاب الطهارة"
"1130","(۱۱۳۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ ، قَالَ : کُنَّا نَکُونُ عِنْدَ إبْرَاہِیمَ فَیَذْہَبُ فَیَبُولُ ، ثُمَّ یَجِیئُ فَیَمَسُّ الْمَائَ وَیَقُولُ : کَانُوا یَسْتَحِبُّونَ أَنْ یَمَسُّوا الْمَائَ إذَا بَالُوا۔","","Musannaf Ibn Abi Shaybah 1130","","","كتاب الطهارة"
"1131","(۱۱۳۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ طَاوُوسٍ ، قَالَ کِلاَہُمَا : رَأَیْتُ ابْنَ عُمَرَ ، وَابْنَ عَبَّاسٍ إذَا خَرَجَا مِنَ الْغَائِطِ تُلُقِّیَا بِتَوْرٍ ، فَیَغْسِلاَنِ وُجُوہَہُمَا وَأَیْدِیَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 1131","","","كتاب الطهارة"
"1132","(۱۱۳۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : بَلَغَنِی أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لَمْ یَدْخُلِ الْخَلاَئَ إِلاَّ تَوَضَّأَ ، أَوْ مَسَّ مَائً۔","","Musannaf Ibn Abi Shaybah 1132","","","كتاب الطهارة"
"1133","(۱۱۳۳) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ ، قَالَ : أَخْبَرَنِی عُرْوَۃُ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا بَکْرٍ الصِّدِّیقَ ، قَالَ ، وَہُوَ یَخْطُبُ النَّاسَ : یَا مَعْشَرَ الْمُسْلِمِینَ ، اسْتَحْیُوا مِنَ اللہِ ، فَوَالَّذِی نَفْسِی بِیَدِہِ إنِّی لاَظَلُّ حِین أَذْہَبُ إلَی الْغَائِطِ فِی الْفَضَائِ ، مُغَطّیًا رَأْسِی اسْتِحْیَائً مِنْ رَبِّی۔","Sahih","Musannaf Ibn Abi Shaybah 1133","","","كتاب الطهارة"
"1134","(۱۱۳۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، عَنْ أَبِی مُوسَی ، قَالَ : إنِّی لاَغْتَسِلُ فِی الْبَیْتِ الْمُظْلِمِ ، فَأَحْنِی ظَہْرِی إذَا أَخَذْتُ ثَوْبِی حَیَائً مِنْ رَبِّی۔","Sahih","Musannaf Ibn Abi Shaybah 1134","","","كتاب الطهارة"
"1135","(۱۱۳۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی جَعْفَرٍ الْخِطْمِیِّ ، عَنْ عُمَارَۃَ بْنِ خُزَیْمَۃَ ، وَالْحَارِثِ بْنِ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی قُرَادٍ ، قَالَ : حَجَجْت مَعَ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَذَہَبَ لِحَاجَتِہِ ، فَأَبْعَدَ۔n(احمد ۳/۴۴۳۔ ابن ماجہ ۳۳۴)","Sahih","Musannaf Ibn Abi Shaybah 1135","","","كتاب الطهارة"
"1136","(۱۱۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُوسَی بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ مَوْلًی لِعَائِشَۃَ ، عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتْ : مَا نَظَرْت ، أَوْ مَا رَأَیْت فَرْجَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَطُّ۔n(احمد ۶/۶۳۔ ترمذی ۳۵۹)","Da'if","Musannaf Ibn Abi Shaybah 1136","","","كتاب الطهارة"
"1137","(۱۱۳۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ ، قَالَ : رَآنِی أَبِی ، أَنَا وَرَجُلٌ نَغْتَسِلُ ، یَصُبُّ عَلَیَّ وَأَصُبُّ عَلَیْہِ ، قَالَ : فَصَاحَ بِنَا وَقَالَ : أَیَرَی الرَّجُلُ عَوْرَۃَ الرَّجُلِ ؟! وَاللَّہِ إنِّی لاَرَاکُمَ الْخَلَفَ۔","","Musannaf Ibn Abi Shaybah 1137","","","كتاب الطهارة"
"1138","(۱۱۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، قَالَ : قَالَ عُمَرُ : لاَ یَرَی الرَّجُلُ عَوْرَۃَ الرَّجُلِ ، أَوْ قَالَ : لاَ یَنْظُرُ الرَّجُلُ إلَی عَوْرَۃِ الرَّجُلِ۔","","Musannaf Ibn Abi Shaybah 1138","","","كتاب الطهارة"
"1139","(۱۱۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، عَنْ عُبَادَۃَ بْنِ نُسَیٍّ ، عَنْ قَیْسِ بْنِ الْحَارِثِ ، عَنْ سَلْمَانَ ، قَالَ : لأَنْ أَمُوتَ ثُمَّ أُنْشَرَ، ثُمَّ أَمُوتَ ثُمَّ أُنْشَرَ، ثُمَّ أَمُوتَ ثُمَّ أُنْشَرَ، أَحَبُّ إلَیَّ مِنْ أَنْ أَرَی عَوْرَۃَ الرَّجُلِ، أَوْ یَرَاہَا مِنِّی۔","Sahih","Musannaf Ibn Abi Shaybah 1139","","","كتاب الطهارة"
"1140","(۱۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ عُبَادَۃَ بْنِ نُسَیٍّ ، عَنْ أَبِی مُوسَی ، قَالَ : لأَنْ أَمُوتَ ثُمَّ أُنْشَرَ أَحَبُّ إلَیَّ مِنْ أَنْ تُرَی عَوْرَتِی۔","Hasan","Musannaf Ibn Abi Shaybah 1140","","","كتاب الطهارة"
"1141","(۱۱۴۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، قَالَ : أَمَرَنِی أَبِی إذَا دَخَلْتُ الْخَلاَئَ أَنْ أُقَنِّعَ رَأْسِی ، قُلْتُ : لِمَ أَمَرَک بِذَلِکَ ؟ قَالَ : لاَ أَدْرِی۔","","Musannaf Ibn Abi Shaybah 1141","","","كتاب الطهارة"
"1142","(۱۱۴۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، قَالَ : أَخْبَرَنِی زَیْدُ بْنُ أَسْلَمَ ، عْن عَبْدِ الرَّحْمَنِ بْنِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَنْظُرُ الرَّجُلُ إلَی عَوْرَۃِ الرَّجُلِ ، وَلاَ الْمَرْأَۃُ إلَی عَوْرَۃِ الْمَرْأَۃِ۔ (ابوداؤد ۴۰۱۴۔ نسائی ۹۲۲۹)q","Sahih","Musannaf Ibn Abi Shaybah 1142","","","كتاب الطهارة"
"1143","(۱۱۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : کُنْتُ مَعَ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، فَقَالَ : یَا مُغِیرَۃُ ، خُذِ الإِدَاوَۃَ ، قَالَ : فَأَخَذْتُہَا ، ثُمَّ خَرَجْت مَعَہُ ، فَانْطَلَقَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ حَتَّی تَوَارَی عَنِّی ، فَقَضَی حَاجَتَہُ۔ (بخاری ۳۶۳۔ نسائی ۹۶۶۳)","Sahih","Musannaf Ibn Abi Shaybah 1143","","","كتاب الطهارة"
"1144","(۱۱۴۴) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنِی إسْمَاعِیلُ بْنُ عَبْدِ الْمَلِکِ ، عَنِ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : خَرَجْت مَعَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، وَکَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لاَ یَأْتِی الْبَرَازَ حَتَّی یَتَغَیَّبَ ، فَلاَ یُرَی۔ (ابوداؤد ۲۔ ابن ماجہ ۳۳۵)","Da'if","Musannaf Ibn Abi Shaybah 1144","","","كتاب الطهارة"
"1145","(۱۱۴۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : قَالَ عَبْدُ اللہِ بْنُ عُمَرَ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا أَرَادَ الْحَاجَۃَ بَرَزَ حَتَّی لاَ یَرَی أَحَدًا ، وَکَانَ لاَ یَرْفَعُ ثَوْبَہُ حَتَّی یَدْنُوَ مِنَ الأَرْضِ۔ (ترمذی ۱۴)","","Musannaf Ibn Abi Shaybah 1145","","","كتاب الطهارة"
"1146","(۱۱۴۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ أَبُو مُوسَی : مَا أَقَمْتُ صُلْبِی فِی غُسْلِی مُنْذُ أَسْلَمْت۔","","Musannaf Ibn Abi Shaybah 1146","","","كتاب الطهارة"
"1147","(۱۱۴۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : أَغْتَسِلُ مِنْ مَائِ الْحَمَّامِ ؟ قَالَ : إذَا أَخَذْتہ مِنْ حَجْرۃٍ أَجْزَأَک۔","","Musannaf Ibn Abi Shaybah 1147","","","كتاب الطهارة"
"1148","(۱۱۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَوِ اغْتَسَلْتُ مِنْہُ مَا اغْتَسَلْت بِہِ۔","","Musannaf Ibn Abi Shaybah 1148","","","كتاب الطهارة"
"1149","(۱۱۴۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : قُلْتُ لَہُ : الْحَمَّامُ یَدْخُلُہُ الْمَجُوسُ وَالْجُنُبُ ؟ فَقَالَ : الْمَائُ طَہُورٌ ، لاَ یُنَجِّسُہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 1149","","","كتاب الطهارة"
"1150","(۱۱۵۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، قَالَ : یُجْزِئُ الْجُنُبَ مَائُ الْحَمَّامِ۔","","Musannaf Ibn Abi Shaybah 1150","","","كتاب الطهارة"
"1151","(۱۱۵۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَدْخُلُہُ ، وَإِذَا کَانَ عِنْدَ خُرُوجِہِ اسْتَقْبَلَ الْمِیزَابَ ، فَاغْتَسَلَ ، ثُمَّ خَرَجَ۔","","Musannaf Ibn Abi Shaybah 1151","","","كتاب الطهارة"
"1152","(۱۱۵۲) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ؛ أَنَّہُ کَانَ یَدْخُلُ وَیَغْتَسِلُ فِیہِ وَیَقُولُ: لَوِ اغْتَسَلْتُ مِنْہُ مَا دَخَلتُہ۔","","Musannaf Ibn Abi Shaybah 1152","","","كتاب الطهارة"
"1153","(۱۱۵۳) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : حدَّثَنَا ہُرَیْمٌ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ عَلْقَمَۃُ وَالأَسْوَدُ یَغْتَسِلاَنِ مِنْ مَائِ الْحَمَّامِ ، وَلاَ یَغْلِیَانِہِ بِغُسْلٍ۔","","Musannaf Ibn Abi Shaybah 1153","","","كتاب الطهارة"
"1154","(۱۱۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنِ الْہَزْہَازِ ، عَنِ ابْنِ أَبْزَی ، قَالَ : إنَّمَا جُعِلَ الْحَمَّامُ لِیُتَطَہَّرَ بِہِ ، وَلاَ یُتَطَہَّرَ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 1154","","","كتاب الطهارة"
"1155","(۱۱۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنِ ابْنِ أَبْزَی ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 1155","","","كتاب الطهارة"
"1156","(۱۱۵۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ یَحْیَی بْنِ عُبَیْدٍ الْبَہْرَانِیِّ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ عَنْ مَائِ الْحَمَّامِ ؟ فَقَالَ : الْمَائُ لاَ یَجْنُبُ۔","Sahih","Musannaf Ibn Abi Shaybah 1156","","","كتاب الطهارة"
"1157","(۱۱۵۷) حَدَّثَنَا عَبِیْدَۃَ بْنُ حُمَیْدٍ ، عَنْ أَبِی فَرْوَۃَ الْہَمْدَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلْتُہُ أَتَغْتَسِلُ مِنْ مَائِ الْحَمَّامِ إذَا کُنْتَ جُنُبًا ؟ قَالَ : نَعَمْ ، ثُمَّ أَعُدُّہُ أَبْلَغَ الْغُسْلِ ، قَالَ : فَقُلْتُ لَہُ : أَتَغْتَسِلُ إذَا خَرَجْت مِنْہُ ؟ قَالَ : لِمَ أَدْخُلُہُ إذن؟","","Musannaf Ibn Abi Shaybah 1157","","","كتاب الطهارة"
"1158","(۱۱۵۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی رَجَائٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَغْتَسِلَ مِنْ مَائِ الْحَمَّامِ۔","","Musannaf Ibn Abi Shaybah 1158","","","كتاب الطهارة"
"1159","(۱۱۵۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سَیَّارٍ ، قَالَ : رَأَیْتُ الشَّعْبِیَّ خَرَجَ مِنَ الْحَمَّامِ فَجَعَلَ یَخُوضُ مَائَ الْحَمَّامِ ، وَلَمْ یَغْسِلْ قَدَمَیْہِ ، قَالَ : فَقُلْتُ لَہُ فِی ذَلِکَ ؟ فَقَالَ : إنِّی رَجُلٌ یُنْظَرُ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 1159","","","كتاب الطهارة"
"1160","(۱۱۶۰) حَدَّثَنَا جَرِیرٌ ، عَنِ الْمُغِیرَۃِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: الغُسْلُ مِن مَاء الْحَمَّامِ۔","","Musannaf Ibn Abi Shaybah 1160","","","كتاب الطهارة"
"1161","(۱۱۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ؛ أَنَّہُ کَانَ یَغْتَسِلُ مِنَ الْحَمَّامِ۔","Sahih","Musannaf Ibn Abi Shaybah 1161","","","كتاب الطهارة"
"1162","(۱۱۶۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَائَانِ لاَ یُجْزِیَانِ : مَائُ الْبَحْرِ ، وَمَائُ الْحَمَّامِ۔","Da'if","Musannaf Ibn Abi Shaybah 1162","","","كتاب الطهارة"
"1163","(۱۱۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعَۃَ بْنِ کُلْثُومٍ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : إذَا خَرَجْتَ مِنَ الْحَمَّامِ ، فَاغْتَسِلْ۔","","Musannaf Ibn Abi Shaybah 1163","","","كتاب الطهارة"
"1164","(۱۱۶۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ بَأْسَ بِنَخرِ الدَّابَّۃِ۔","","Musannaf Ibn Abi Shaybah 1164","","","كتاب الطهارة"
"1165","(۱۱۶۵) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِلُعَابِ الْحِمَارِ۔","","Musannaf Ibn Abi Shaybah 1165","","","كتاب الطهارة"
"1166","(۱۱۶۶) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ حَمَّادٍ ، قَالَ : أَتَّقِی مَا یَسِیلُ مِنْ فَمِ الدَّابَّۃِ۔","","Musannaf Ibn Abi Shaybah 1166","","","كتاب الطهارة"
"1167","(۱۱۶۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : سَأَلْتُ یُونُسَ عَنْ عَرَقِ الْحِمَار وَلُعَابِہِ یُصِیبُ الثَّوْبَ ؟ فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا إِلاَّ أَنْ یَقْذَرَہُمَا۔","","Musannaf Ibn Abi Shaybah 1167","","","كتاب الطهارة"
"1168","(۱۱۶۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَن کَلْبٍ أَصَابَ ثَوْبِی ؟فَقَالَ : أَلَطَّخَک بِشَیْئٍ؟ فَقُلْتُ : لا، فَقَالَ : لاَ یَضُرُّک۔","","Musannaf Ibn Abi Shaybah 1168","","","كتاب الطهارة"
"1169","(۱۱۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ عبیدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِلُعَابِ الْحِمَارِ۔","","Musannaf Ibn Abi Shaybah 1169","","","كتاب الطهارة"
"1170","(۱۱۷۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ : أَنَّہُمَا کَانَا یَکْرَہَانِ دُخُولَ الْحَمَّامِ۔","","Musannaf Ibn Abi Shaybah 1170","","","كتاب الطهارة"
"1171","(۱۱۷۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ تَدْخُلِ الْحَمَّامَ ، فَإِنَّہُ مِمَّا أَحْدَثُوا مِنَ النَّعِیمِ۔","Sahih","Musannaf Ibn Abi Shaybah 1171","","","كتاب الطهارة"
"1172","(۱۱۷۲) حَدَّثَنَا جَرِیرٌ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی زُرْعَۃَ ، قَالَ : قَالَ عَلِیٌّ : بِئْسَ الْبَیْتُ الْحَمَّامُ۔","Sahih","Musannaf Ibn Abi Shaybah 1172","","","كتاب الطهارة"
"1173","(۱۱۷۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا دَاوُد بْنُ عَمْرٍو ، عَنْ عَطِیَّۃَ بْنِ قَیْسٍ ، عَنْ أَبِی الدَّرْدَائِ ؛ أَنَّہُ کَانَ یَدْخُلُ الْحَمَّامَ ، قَالَ : وَکَانَ یَقُولُ : نِعْمَ الْبَیْتُ الْحَمَّامُ ، یُذْہِبُ الصَّنَّۃ ، یَعْنِی : الْوَسَخَ ، وَیُذَکِّرُ النَّارَ۔","Hasan","Musannaf Ibn Abi Shaybah 1173","","","كتاب الطهارة"
"1174","(۱۱۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ دَخَلَ الْحَمَّامَ۔","Da'if","Musannaf Ibn Abi Shaybah 1174","","","كتاب الطهارة"
"1175","(۱۱۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ دَخَلَ حَمَّامَ الْجُحْفَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 1175","","","كتاب الطهارة"
"1176","(۱۱۷۶) حَدَّثَنَا جَرِیرٌ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نِعْمَ الْبَیْتُ الْحَمَّامُ ، یُذْہِبُ الدَّرَنَ ، وَیُذَکِّرُ النَّارَ۔","Sahih","Musannaf Ibn Abi Shaybah 1176","","","كتاب الطهارة"
"1177","(۱۱۷۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ عُثْمَانَ بْنِ قَیْسٍ ، قَالَ : خَرَجْتُ مَعَ جَرِیرٍ یَوْمَ جُمُعَۃٍ إلَی حَمَّامٍ لَہُ بِالْعَاقُولِ۔","Da'if","Musannaf Ibn Abi Shaybah 1177","","","كتاب الطهارة"
"1178","(۱۱۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ لِی عَلَی الْحُسَیْنِ بْنِ عَلِیٍّ دَیْنٌ ، فَأَتَیْتُہُ أَتَقَاضَاہُ ، فَوَجَدْتُہ قَدْ خَرَجَ مِنَ الْحَمَّامِ وَقَدْ أَثَّرَ الْحِنَّائُ بِأَظَافِرِہِ ، وَجَارِیَۃٌ لَہُ تَحُکُّ عَنْہُ أَثَرَ الْحِنَّائِ بِقَارُورَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 1178","","","كتاب الطهارة"
"1179","(۱۱۷۹) حَدَّثَنَا وَکِیعٌ، عَنْ قُرَّۃَ، عَنْ عَطِیَّۃَ، عَنِ ابْنِ عُمَرَ، قَالَ: نِعْمَ الْبَیْتُ الْحَمَّامُ، یُذْہِبُ الدَّرَنَ، وَیُذَکِّرُ النَّارَ۔","Da'if","Musannaf Ibn Abi Shaybah 1179","","","كتاب الطهارة"
"1180","(۱۱۸۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ ، مَرَرْتُ إلَی الْحَمَّامِ فَرَآنِی أَبُو صَادِقٍ ، فَقَالَ: مَعَک إزَارٌ فَإِنَّ عَلِیًّا کَانَ یَقُولُ ، مَنْ کَشَفَ عَوْرَتَہُ أَعْرَضَ عَنْہُ الْمَلَکُ۔","Hasan","Musannaf Ibn Abi Shaybah 1180","","","كتاب الطهارة"
"1181","(۱۱۸۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا مَنْصُورٌ ، عَنْ قَتَادَۃَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ کَتَبَ لاَ یَدْخُلْ أَحَدٌ الْحَمَّامَ إِلاَّ بِمِئْزَرٍ۔","","Musannaf Ibn Abi Shaybah 1181","","","كتاب الطهارة"
"1182","(۱۱۸۲) حَدَّثَنَا زِیَادُ بْنُ الرَّبِیعِ ، عَنْ غَالِبِ الْقَطَّانِ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ إلَی عَامِلِہِ عَلَی الْبَصْرَۃِ ، أَمَّا بَعْدُ : فَانْہَ مَنْ قِبَلَکَ أَنْ یَدْخُلُوا الْحَمَّامَ إِلاَّ بِمِئْزَرٍ۔","","Musannaf Ibn Abi Shaybah 1182","","","كتاب الطهارة"
"1183","(۱۱۸۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ دَاوُدَ الضَّبِّیِّ ، عَنْ مُسْلِمٍ الْبَطِینِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : حَرَامٌ عَلَیْہِ دُخُولُ الْحَمَّامِ ، بِغَیْرِ إِزَار۔","","Musannaf Ibn Abi Shaybah 1183","","","كتاب الطهارة"
"1184","(۱۱۸۴) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ زِیَادِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : رَأَیْتُ أَبَا جَعْفَرٍ دَخَلَ الْحَمَّامَ وَعَلَیْہِ إزَارٌ إلَی الرُّکْبَتَیْنِ ، وَفِیہِ أُنَاسٌ بِغَیْرِ أُزُر۔","","Musannaf Ibn Abi Shaybah 1184","","","كتاب الطهارة"
"1185","(۱۱۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ سَلَمَۃَ وَأَشْعَثَ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَدْخُلَ الْحَمَّامَ بِغَیْرِ إِزَارٍ ، وَکَرِہَ أَنْ یَدْخُلَہُ بِإِزَارٍ ، وَغَیْرُہ لَیْسَ بِإِزَارٍ ، یَقُولُ : یُرَی عَوْرَتُہُ۔","","Musannaf Ibn Abi Shaybah 1185","","","كتاب الطهارة"
"1186","(۱۱۸۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : کَتَبَ عُمَرُ إلَی أُمَرَائِ الأَجْنَادِ : أَنْ لاَ یَدْخُلَ رَجُلٌ الْحَمَّامَ إِلاَّ بِمِئْزَرٍ ، وَلاَ امْرَأَۃٌ إِلاَّ مِنْ سُقَمٍ۔","","Musannaf Ibn Abi Shaybah 1186","","","كتاب الطهارة"
"1187","(۱۱۸۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ قَالَ : إذَا دَخَلَ أَحَدُکُمُ الْحَمَّامَ، أَوِ الْفُرَاتَ فَلْیَتَّزِرْ ، وَیَلْبَسْ ثِیَابًا۔","","Musannaf Ibn Abi Shaybah 1187","","","كتاب الطهارة"
"1188","(۱۱۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَضْرِبُ صَاحِبَ الْحَمَّامِ ، وَمَنْ دَخَلَہُ بِغَیْرِ إزَارٍ۔","","Musannaf Ibn Abi Shaybah 1188","","","كتاب الطهارة"
"1189","(۱۱۸۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ یَجْلِدُ فِی الْمِنْدِیلِ فِی الْحَمَّامِ، وَیُعَاقِبُ صَاحِبَ الْحَمَّامِ۔","","Musannaf Ibn Abi Shaybah 1189","","","كتاب الطهارة"
"1190","(۱۱۹۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَبْدُ اللہِ بْنُ شَدَّادٍ ، عَنْ أَبِی عُذْرَۃَ ، وَکَانَ قَدْ أَدْرَکَ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ نَہَی الرِّجَالَ وَالنِّسَائَ عَنِ الْحَمَّامَاتِ ، إِلاَّ مَرِیضَۃً ، أَوْ نُفَسَائَ۔ (ابوداؤد ۴۰۰۵۔ ترمذی ۲۸۰۲)","","Musannaf Ibn Abi Shaybah 1190","","","كتاب الطهارة"
"1191","(۱۱۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ رَفَعَہُ ؛ قَالَ : مَنْ دَخَلَہُ مِنْکُمْ فَلْیَسْتَتِرْ۔","","Musannaf Ibn Abi Shaybah 1191","","","كتاب الطهارة"
"1192","(۱۱۹۲) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، عَنْ کَامِلٍ ، عَنْ حَبِیبٍ ، قَالَ : دَخَلَ الْحَمَّامَ عَطَائٌ ، وَطَاوُوس ، وَمُجَاہِدٌ ، فَاطَّلَوْا فِیہِ۔","","Musannaf Ibn Abi Shaybah 1192","","","كتاب الطهارة"
"1193","(۱۱۹۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، وَأَبُو بَکْرٍ ، وَعُمَرُ ، لاَ یَطَّلُونَ۔","","Musannaf Ibn Abi Shaybah 1193","","","كتاب الطهارة"
"1194","(۱۱۹۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : فَلَمَّا رَأَتْہُ حَسِبَتْہُ لُجَّۃً وَکَشَفَتْ عَنْ سَاقَیْہَا ، فَإِذَا امْرَأَۃٌ شَعْرَائُ ، قَالَ : فَقَالَ سُلَیْمَانُ : مَا یُذْہِبُ ہَذَا ؟ قَالُوا : النُّورَۃُ ، قَالَ : فَجُعِلَتِ النُّورَۃُ یَوْمَئِذٍ۔","","Musannaf Ibn Abi Shaybah 1194","","","كتاب الطهارة"
"1195","(۱۱۹۵) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ الْحَسَنُ رَجُلاً أَزَبَّ ، وَکَانَ لاَ یَطَّلِی۔","","Musannaf Ibn Abi Shaybah 1195","","","كتاب الطهارة"
"1196","(۱۱۹۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ ؛ أَنَّ سَالِمًا اطَّلَی مَرَّۃً ، وَتَسَرْوَلَ أُخْرَی۔","","Musannaf Ibn Abi Shaybah 1196","","","كتاب الطهارة"
"1197","(۱۱۹۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ : اطَّلَی فِی الْعَشْر۔","","Musannaf Ibn Abi Shaybah 1197","","","كتاب الطهارة"
"1198","(۱۱۹۸) حَدَّثَنَا ہُشَیْمٌ وَشَرِیکٌ ، عَنْ لَیْثٍ أَبِی الْمَشْرَفِیِّ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا اطَّلَی وَلِیَ عَانَتَہُ۔ (ابن ماجہ ۳۷۵۲)","Majhul","Musannaf Ibn Abi Shaybah 1198","","","كتاب الطهارة"
"1199","(۱۱۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ الأَسَدِیِّ ، عَنْ عَلِیِّ بْنِ أَبِی عَائِشَۃَ ، قَالَ : کَانَ عُمَرُ رَجُلاً أَہْلَبَ ، فَکَانَ یَحْلِقُ عَنْہُ الشَّعَرَ ، وَذُکِرَتْ لَہُ النُّورَۃَ فَقَالَ : النُّورَۃُ مِنَ النَّعِیمِ۔","","Musannaf Ibn Abi Shaybah 1199","","","كتاب الطهارة"
"1200","(۱۲۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَ : مَنْ بَالَ فِی مُغْتَسَلِہِ ، فَلَمْ یَتَطَہَّرْ۔","","Musannaf Ibn Abi Shaybah 1200","","","كتاب الطهارة"
"1201","(۱۲۰۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَا طَہَّرَ اللَّہُ رَجُلاً یَبُولُ فِی مُغْتَسَلِہِ ، وَقَالَ عَطَائٌ : إذَا کَانَ یَسِیلُ فَلاَ بَأْسَ۔","Da'if","Musannaf Ibn Abi Shaybah 1201","","","كتاب الطهارة"
"1202","(۱۲۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ زَاذَانَ وَمَیْسَرَۃَ: أَنَّہُمَا کَرِہَا أَنْ یَبُولَ الرَّجُلُ فِی الْمُغْتَسَلِ۔","","Musannaf Ibn Abi Shaybah 1202","","","كتاب الطهارة"
"1203","(۱۲۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ الْحَسَنُ یَکْرَہُ أَنْ یَبُولَ الرَّجُلُ فِی مُغْتَسَلِہِ۔","","Musannaf Ibn Abi Shaybah 1203","","","كتاب الطهارة"
"1204","(۱۲۰۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ الْحَسَنُ یَکْرَہُ أَنْ یَبُولَ فِی مُغْتَسَلِہِ ۔ قَالَ : وقَالَ بَکْرُ بْنُ عَبْدِ اللہِ : کَانَ یَقُولُ : ہُوَ یُہَیِّجُ الْوَسْوَسَۃَ۔","","Musannaf Ibn Abi Shaybah 1204","","","كتاب الطهارة"
"1205","(۱۲۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ رَبِّہِ بْنِ أَبِی رَاشِدٍ ، قَالَ : قُلْتُ لِرَیْطَۃَ سُرِّیَّۃِ أَنَسٍ : کَانَ أَنَسٌ یَبُولُ فِی مُسْتَحَمِّہِ؟ قَالَتْ : لاَ ، کُنْتُ أَضَعُ لَہُ تَوْرًا فَیَبُولُ فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1205","","","كتاب الطهارة"
"1206","(۱۲۰۶) حَدَّثَنَا عُمَرُ ، عَنْ عِیسَی ، عَنِ الشَّعْبِیِّ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَرِہَ الْبَوْلَ فِی الْمُغْتَسَلِ۔","Sahih","Musannaf Ibn Abi Shaybah 1206","","","كتاب الطهارة"
"1207","(۱۲۰۷) حَدَّثَنَا عُمَرُ ، عَنْ أَفْلَحَ ، قَالَ : رَأَیْتُ الْقَاسِمَ یَبُولُ فِی مُغْتَسَلِہِ۔","","Musannaf Ibn Abi Shaybah 1207","","","كتاب الطهارة"
"1208","(۱۲۰۸) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ قَتَادَۃَ ، عَنْ عُقْبَۃَ بْنِ صُہْبَانَ ، قَالَ : سَمِعْتُ عَبْدَ اللہِ بْنَ مُغَفَّلٍ الْمُزَنِیّ یَقُولُ : الْبَوْلُ فِی الْمُغْتَسَلِ یَأْخُذُ مِنْہُ الْوَسْوَاسَ۔","Sahih","Musannaf Ibn Abi Shaybah 1208","","","كتاب الطهارة"
"1209","(۱۲۰۹) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَمَّنْ سَمِعَ أَنَسَ بْنَ مَالِکٍ یَقُولُ: إنَّمَا کُرِہَ الْبَوْلُ فِی الْمُغْتَسَلِ، مَخَافَۃَ اللَّمَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 1209","","","كتاب الطهارة"
"1210","(۱۲۱۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَلْبَسَ الرَّجُلُ الْخَاتَمَ ، وَیَدْخُلَ بِہِ الْخَلاَئَ ، وَیُجَامِعَ فِیہِ ، وَیَکُونَ فِیہِ اسْمُ اللہِ۔","","Musannaf Ibn Abi Shaybah 1210","","","كتاب الطهارة"
"1211","(۱۲۱۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَامَ ، عْن عِکْرِمَۃَ ، قَالَ : کَانَ ابْنُ عَبَّاسٍ إذَا دَخَلَ الْخَلاَئَ نَاوَلَنِی خَاتَمَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 1211","","","كتاب الطهارة"
"1212","(۱۲۱۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ فِی الرَّجُلِ یَدْخُلُ الْمَخْرَجَ وَفِی یَدِہِ خَاتَمٌ فِیہِ اسْمُ اللہِ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1212","","","كتاب الطهارة"
"1213","(۱۲۱۳) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : کَانَ یَقُولُ : إذَا دَخَلَ الرَّجُلُ الْخَلاَئَ وَعَلَیْہِ خَاتَمٌ فِیہِ ذِکْرُ اللہِ تَعَالَی جَعَلَ الْخَاتَمَ مِمَّا یَلِی بَطْنَ کَفِّہِ ، ثُمَّ عَقَدَ عَلَیْہِ بِإِصْبَعِہِ۔","","Musannaf Ibn Abi Shaybah 1213","","","كتاب الطهارة"
"1214","(۱۲۱۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنِ الْمِنْہَالِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ سُلَیْمَانُ بْنُ دَاوُد إذَا دَخَلَ الْخَلاَئَ ، نَزَعَ خَاتَمَہُ فَأَعْطَاہُ امْرَأَتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1214","","","كتاب الطهارة"
"1215","(۱۲۱۵) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ نَافِعٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ لِلإِنْسَانِ أَنْ یَدْخُلَ الْکَنِیفَ ، وَعَلَیْہِ خَاتَمٌ فِیہِ اسْمُ اللہِ۔","","Musannaf Ibn Abi Shaybah 1215","","","كتاب الطهارة"
"1216","(۱۲۱۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، قَالَ : سَأَلْتُ ابْنَ أَبِی نَجِیحٍ ؛ عَنِ الرَّجُلِ یَدْخُلُ الْخَلاَئَ وَمَعَہُ الدَّرَاہِمُ الْبِیضُ ؟ فَقَالَ : کَانَ مُجَاہِدٌ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 1216","","","كتاب الطهارة"
"1217","(۱۲۱۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا أَنْ یَدْخُلَ الرَّجُلُ الْخَلاَئَ وَمَعَہُ الدَّرَاہِمُ الْبِیضُ ، قَالَ : وَکَانَ الْقَاسِمُ بْنُ مُحَمَّدٍ یَکْرَہُہُ ، وَلاَ یَرَی بِالْبَیْعِ وَالشِّرَائِ بِہَا بَأْسًا۔","","Musannaf Ibn Abi Shaybah 1217","","","كتاب الطهارة"
"1218","(۱۲۱۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ إذَا دَخَلَ الْخَلاَئَ وَمَعَہُ الدَّرَاہِمُ، أَعْطَاہَا إنْسَانًا یَمْسِکُہَا حَتَّی یَتَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1218","","","كتاب الطهارة"
"1219","(۱۲۱۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُہُ عَنِ الرَّجُلِ یَبُولُ وَمَعَہُ الدَّرَاہِمُ الْبِیضُ ؟ قَالَ : لَیْسَ لِلنَّاسِ بُدٌّ مِنْ حِفْظِ أَمْوَالِہِمْ۔","","Musannaf Ibn Abi Shaybah 1219","","","كتاب الطهارة"
"1220","(۱۲۲۰) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ ، قَالَ: أَحَبُّ إلَیَّ أَنْ یَکُونَ بَیْنَ جِلْدِی ، أَوْ کَفِّی ، وَبَیْنَہُمَا ثَوْبٌ۔","","Musannaf Ibn Abi Shaybah 1220","","","كتاب الطهارة"
"1221","(۱۲۲۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یمسّ الدِّرْہَمَ الأَبْیَضَ وَہُوَ عَلَی غَیْرِ وُضُوئٍ۔","","Musannaf Ibn Abi Shaybah 1221","","","كتاب الطهارة"
"1222","(۱۲۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْقَاسِمِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِمَسِّ الدِّرْہَمِ الأَبْیَضِ وَہُوَ عَلَی غَیْرِ وُضُوئٍ۔","","Musannaf Ibn Abi Shaybah 1222","","","كتاب الطهارة"
"1223","(۱۲۲۳) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الْہَیْثُمِ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ الرَّجُلِ یَمَسُّ الدَّرَاہِمَ الْبِیضَ عَلَی غَیْرِ وُضُوئٍ ؟ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 1223","","","كتاب الطهارة"
"1224","(۱۲۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ: لاَ بَأْسَ أَنْ یَمَسَّہَا عَلَی غَیْرِ وُضُوئٍ۔","","Musannaf Ibn Abi Shaybah 1224","","","كتاب الطهارة"
"1225","(۱۲۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ رُبَیع ، قَالَ : کَرِہَہُ ابْنُ سِیرِینَ۔","","Musannaf Ibn Abi Shaybah 1225","","","كتاب الطهارة"
"1226","(۱۲۲۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ وَسَالِمٍ قَالاَ : لاَ یَمَسُّ الرَّجُلُ الدَّرَاہِمَ فِیہَا کِتَابُ اللہِ وَہُوَ جُنُبٌ، قَالَ: وَقَالَ عَطَائٌ وَالْقَاسِمُ : یَمَسُّہَا إذَا کَانَتْ مَصْرُورَۃً فِی خِرْقَۃٍ۔","","Musannaf Ibn Abi Shaybah 1226","","","كتاب الطهارة"
"1227","(۱۲۲۷) حَدَّثَنَا جَرِیرٌ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ؛ قَالَ : یَکْرَہُ أَنْ یُذْکَرَ اللَّہَ وَہُوَ جَالِسٌ عَلَی خَلاَئِہ، وَالرَّجُلُ یُوَاقِعُ امْرَأَتَہُ ، لأَنَّہُ ذُو الْجَلاَلِ یُجَلُّ عَنْ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 1227","","","كتاب الطهارة"
"1228","(۱۲۲۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، قَالَ : لاَ تَشْہَدُ الْمَلاَئِکَۃُ عَلَی خَلاَئِک۔","","Musannaf Ibn Abi Shaybah 1228","","","كتاب الطهارة"
"1229","(۱۲۲۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَیَّارٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : اثْنَتَانِ لاَ یَذْکُرُ اللَّہَ الْعَبْدُ فِیہِمَا : إذَا أَتَی الرَّجُلُ أَہْلَہُ یَبْدَأُ فَیُسَمِّی اللَّہَ ، وَإِذَا کَانَ فِی الْخَلاَئِ۔","","Musannaf Ibn Abi Shaybah 1229","","","كتاب الطهارة"
"1230","(۱۲۳۰) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَرْبَعَۃٌ لاَ یَقْرَؤُونَ الْقُرْآنَ : عِنْدَ الْخَلاَئِ ، وَعِنْدَ الْجِمَاعِ ، وَالْجُنُبُ ، وَالْحَائِضُ ، إِلاَّ الْجُنُبَ وَالْحَائِضَ ، فَإِنَّہُمَا یَقْرَآنِ الآیَۃَ وَنَحْوَہَا۔","","Musannaf Ibn Abi Shaybah 1230","","","كتاب الطهارة"
"1231","(۱۲۳۱) حَدَّثَنَا وَکِیعٌ ، قَالَ: حدَّثَنَا سُفْیَانُ ، عَنْ عَطَائِ بْنِ أَبِی مَرْوَانِ الأَسْلَمِیِّ ، عَنْ أَبِیہِ ، عَنْ کَعْبٍ ، قَالَ : قَالَ مُوسَی عَلَیْہِ السَّلاَمُ : أَیْ رَبِّ أَقَرِیبٌ أَنْتَ فَأُنَاجِیک ، أَمْ بَعِیدٌ فَأُنَادِیک ؟ قَالَ : یَا مُوسَی ، أَنَا جَلِیسُ مَنْ ذَکَرَنِی ، قَالَ : یَا رَبِّ فَإِنَّا نَکُونُ مِنَ الْحَالِ عَلَی حَالٍ نُعَظِّمُک ، أَوْ نُجِلُّک أَنْ نَذْکُرَک عَلَیْہَا ؟ قَالَ : وَمَا ہِیَ ؟ قَالَ : الْجَنَابَۃُ وَالْغَائِطُ ، قَالَ : یَا مُوسَی ، اُذْکُرْنِی عَلَی کُلِّ حَالٍ۔","","Musannaf Ibn Abi Shaybah 1231","","","كتاب الطهارة"
"1232","(۱۲۳۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ؛ فِی الرَّجُلِ یَعْطِسُ عَلَی الْخَلاَئِ ، قَالَ : یَحْمَدُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 1232","","","كتاب الطهارة"
"1233","(۱۲۳۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَحْمَدُ اللَّہَ ، فَإِنَّہُ یَصْعَدُ۔","","Musannaf Ibn Abi Shaybah 1233","","","كتاب الطهارة"
"1234","(۱۲۳۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : یَحْمَدُ اللَّہَ فِی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 1234","","","كتاب الطهارة"
"1235","(۱۲۳۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ سُئِلَ عَنِ الرَّجُلِ یَعْطِسُ فِی الْخَلاَئِ ؟ قَالَ : لاَ أَعْلَمُ بَأْسًا بِذِکْرِ اللہِ۔","","Musannaf Ibn Abi Shaybah 1235","","","كتاب الطهارة"
"1236","(۱۲۳۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ؛ فِی الرَّجُلِ یَعْطِسُ فِی الْخَلاَئِ ، قَالَ : قَالَ أَبُو مَیْسَرَۃَ : مَا أُحِبُّ أَنْ أَذْکُرَ اللَّہَ إِلاَّ فِی مَکَان طَیِّبٍ ۔ قَالَ : قَالَ مَنْصُورٌ : قَالَ إبْرَاہِیمُ : یَحْمَدُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 1236","","","كتاب الطهارة"
"1237","(۱۲۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ أَخبَرنَا قَزَعَۃُ بْنُ سُوَیْد ، قَالَ : سَأَلْتُ ابْنَ أَبِی مُلَیْکَۃَ عَنِ الرَّجُلِ یَعْطِسُ وَہُوَ عَلَی الْخَلاَئِ ؟ قَالَ : یَحْمَدُ اللَّہَ۔","","Musannaf Ibn Abi Shaybah 1237","","","كتاب الطهارة"
"1238","(۱۲۳۸) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، وَنَافِعٍ ، قَالَ : کَانَا لاَ یَرَیَانِ بَأْسًا بِبَوْلِ الْبَعِیرِ ، قَالَ : وَأَصَابَنِی ؟ فَلَمْ یَرَیَا بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 1238","","","كتاب الطهارة"
"1239","(۱۲۳۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ ، عَنْ عَطَائٍ ؛ أَنَّہُ سُئِلَ عَنْ بَوْلِ الْبَعِیرِ یُصِیبُ ثَوْبَ الرَّجُلِ ؟ فَقَالَ : وَمَا عَلَیْک لَوْ أَصَابَک ؟ وَقَالَ حَمَّادٌ : إنِّی لأَغْتَسِلُ الْبَوْلَ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 1239","","","كتاب الطهارة"
"1240","(۱۲۴۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : سَأَلَ الْحَکَمُ بْنُ صَفْوَانَ إِبْرَاہِیمَ عَن بَوْلِ الْبَعِیرِ یُصِیبُ ثَوْبَ الرَّجُلِ ؟ قَالَ : لاَ بَأْسَ بِہِ ، أَلَیْسَ یُشْرَبُ وَیُتَدَاوَی بِہِ۔","","Musannaf Ibn Abi Shaybah 1240","","","كتاب الطهارة"
"1241","(۱۲۴۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا اجْتُرَّ فَلاَ بَأْسَ بِبَوْلِہِ۔","","Musannaf Ibn Abi Shaybah 1241","","","كتاب الطهارة"
"1242","(۱۲۴۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : رُخِّصَ فِی أَبْوَالِ ذَوَاتِ الْکُرُوشِ۔","","Musannaf Ibn Abi Shaybah 1242","","","كتاب الطهارة"
"1243","(۱۲۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ بَوْلِ الشَّاۃِ ؟ فَقَالَ : حَمَّادٌ : یُغْسَلُ ، وَقَالَ الْحَکَمُ : لاَ۔","","Musannaf Ibn Abi Shaybah 1243","","","كتاب الطهارة"
"1244","(۱۲۴۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَرَی أَنْ تُغْسل الأَبْوَالُ کُلُّہَا۔","","Musannaf Ibn Abi Shaybah 1244","","","كتاب الطهارة"
"1245","(۱۲۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَغْسِلُ الْبَوْلَ کُلَّہُ ، وَکَانَ یُرَخِّصُ فِی أَبْوَالِ ذَوَاتِ الْکُرُوشِ۔","","Musannaf Ibn Abi Shaybah 1245","","","كتاب الطهارة"
"1246","(۱۲۴۶) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ یَعْلَی بْنِ حَکِیمٍ ، عَنْ نَافِعٍ ، وَعَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ أَنَّہُمَا قَالاَ : اغْسِلْ مَا أَصَابَک مِنْ أَبْوَالِ الْبَہَائِمِ۔","","Musannaf Ibn Abi Shaybah 1246","","","كتاب الطهارة"
"1247","(۱۲۴۷) حَدَّثَنَا وَکِیعٌ، عَنْ أَبِیہِ، عَنْ مَیْسَرَۃَ، مَوْلًی لِلْحَیِّ، قَالَ: سَأَلْتُ الشَّعْبِیَّ عَنْ بَوْلِ التَّیْسِ؟ فَقَالَ: لاَ تَغْسِلْہُ۔","","Musannaf Ibn Abi Shaybah 1247","","","كتاب الطهارة"
"1248","(۱۲۴۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ ، قَالَ : مَا أُکِلَ لَحْمُہُ فَلاَ بَأْسَ بِبَوْلِہِ۔","","Musannaf Ibn Abi Shaybah 1248","","","كتاب الطهارة"
"1249","(۱۲۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ شُعْبَۃَ ، عَنْ عُمَارَۃَ بْنِ أَبِی حَفْصَۃَ ، قَالَ : سَمِعْتُ أَبَا مِجْلَزٍ یَقُولُ : قُلْتُ لاِبْنِ عُمَرَ : بَعَثْت جَمَلِی فَبَالَ ، فَأَصَابَنِی بَوْلُہُ ، قَالَ : اغْسِلْہُ ، قُلْتُ : إنَّمَا کَانَ انْتُضِحَ کَذَا وَکَذَا یَعْنِی : یقلِّلہ ، قَالَ : اغْسِلْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1249","","","كتاب الطهارة"
"1250","(۱۲۵۰) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ، عَنْ عِیسَی بْنِ کَثِیرٍ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ: بَوْلُ الْبَہِیمَۃِ وَالإِنْسَان سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 1250","","","كتاب الطهارة"
"1251","(۱۲۵۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ ابْنِ شُبْرُمَۃَ ، قَالَ : کُنْتُ مَعَ الشَّعْبِیِّ فِی السُّوقِ ، فَبَالَ بَغْلٌ فَتَنَحَّیْت مِنْہُ ، فَقَالَ: مَا عَلَیْک لَوْ أَصَابَک۔","","Musannaf Ibn Abi Shaybah 1251","","","كتاب الطهارة"
"1252","(۱۲۵۲) حَدَّثَنَا شَرِیکٌ ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِنَضْحِ أَبْوَالِ الدَّوَابِّ۔","","Musannaf Ibn Abi Shaybah 1252","","","كتاب الطهارة"
"1253","(۱۲۵۳) حَدَّثَنَا شَرِیکٌ ، عَنِ الْحَسَنِ ، عَنْ عُبَیْدِ اللہِ ، عَنْ إِبْرَاہِیمَ ، وَجَابِرٍ ، عَنْ عَامِرٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 1253","","","كتاب الطهارة"
"1254","(۱۲۵۴) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ ، قَالَ : إذَا انْتَضَحَ عَلَیْک بَوْلُ الدَّابَّۃِ فَرَأَیْتُ أَثَرَہُ فَاغْسِلْہُ ، وَإِنْ لَمْ تَرَ أَثَرَہُ فَدَعْہُ۔","","Musannaf Ibn Abi Shaybah 1254","","","كتاب الطهارة"
"1255","(۱۲۵۵) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یُرَخِّصُ فِی أَبْوَالِ الْخَفَافِیشِ۔","","Musannaf Ibn Abi Shaybah 1255","","","كتاب الطهارة"
"1256","(۱۲۵۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَقُولُ : مَا خَرَجَ مِنَ الْجُرْحِ فَہُوَ بِمَنْزِلَۃِ الدَّمِ ، وَفِیہِ الْوُضُوئُ۔","","Musannaf Ibn Abi Shaybah 1256","","","كتاب الطهارة"
"1257","(۱۲۵۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ، قَالَ : سَمِعْتُہُ یَقُولُ : الْقَیْحُ وَالدَّمُ سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 1257","","","كتاب الطهارة"
"1258","(۱۲۵۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : الْقَیْحُ وَالصَّدِید لَیْسَ فِیہِ وُضُوئٌ۔","","Musannaf Ibn Abi Shaybah 1258","","","كتاب الطهارة"
"1259","(۱۲۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّہُ کَانَ لاَ یَرَی الْقَیْحَ شَیْئًا ، قَالَ: إنَّمَا ذَکَرَ اللَّہُ الدَّمَ۔","","Musannaf Ibn Abi Shaybah 1259","","","كتاب الطهارة"
"1260","(۱۲۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ۔ وَعَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ قَالُوا : مَا خَرَجَ مِنَ الْبَثْرَۃِ مِنْ شَیْئٍ فَہُوَ بِمَنْزِلَۃِ الدَّمِ۔","","Musannaf Ibn Abi Shaybah 1260","","","كتاب الطهارة"
"1261","(۱۲۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : کُنَّا جُلُوسًا مَعَ عَبْدِ اللہِ إذْ وَقَعَ عَلَیْہِ خُرْئُ عُصْفُورٍ ، فَقَالَ لَہُ : ہَکَذَا بِیَدِہِ ، نَفَضَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 1261","","","كتاب الطهارة"
"1262","(۱۲۶۲) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : رَأَیْتُہُ ، وَأُلْقِیَ عَلَیْہِ طَیْرٌ مِنْ طَیْرِ مَکَّۃَ ، فَجَعَلَ یَمْسَحُہُ بِیَدِہِ۔","","Musannaf Ibn Abi Shaybah 1262","","","كتاب الطهارة"
"1263","(۱۲۶۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ، قَالَ: سَقَطَتْ ہَامَۃٌ عَلَی الْحَسَنِ فَذَرَقَتْ عَلَیْہِ ، فَقَالَ لَہُ بَعْضُ الْقَوْمِ : نَأْتِیک بِمَائٍ تَغْسِلُہُ ؟ فَقَالَ : لاَ ، وَجَعَلَ یَمْسَحُہُ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 1263","","","كتاب الطهارة"
"1264","(۱۲۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الأَشْہَبِ السَّعْدِیِّ ، قَالَ : رَأَیْتُ یَزِیدَ بْنَ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، أَبَا الْعَلاَئِ ذَرَقَ عَلَیْہِ طَیْرٌ وَہُوَ یُصَلِّی ، فَمَسَحَہُ ثُمَّ مَضَی فِی صَلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 1264","","","كتاب الطهارة"
"1265","(۱۲۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، قَالَ : رَأَیْتُ سَالِمًا سَلَحَ عَلَیْہِ طَیْرٌ فَمَسَحَہُ وَقَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1265","","","كتاب الطهارة"
"1266","(۱۲۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ خُرْئِ الطَّیْرِ ؟ فَقَالاَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1266","","","كتاب الطهارة"
"1267","(۱۲۶۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَالِمِ بْنِ أَبِی الذَّیَّالِ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ صَلَّی ، فَلَمَّا قَضَی صَلاَتَہُ أَبْصَرَ فِی ثَوْبِہِ خُرْئَ دَجَاجٍ ، فَقَالَ : إنَّمَا ہُوَ طَیْرٌ۔","","Musannaf Ibn Abi Shaybah 1267","","","كتاب الطهارة"
"1268","(۱۲۶۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ شُعْبَۃَ ، عَنْ غَیْلاَنَ ، عَنْ حَمَّادٍ ؛ أَنَّہُ کَرِہَ ذَرْقَ الدَّجَاجِ۔","","Musannaf Ibn Abi Shaybah 1268","","","كتاب الطهارة"
"1269","(۱۲۶۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ؛ أَنَّہُ کَانَ یَسْتَحِبُّ أَنْ لاَ یَنَامَ إِلاَّ عَلَی طَہَارَۃٍ۔","","Musannaf Ibn Abi Shaybah 1269","","","كتاب الطهارة"
"1270","(۱۲۷۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَسْتَحِبُّ أَنْ لاَ یَنَامَ إِلاَّ عَلَی طَہَارَۃٍ۔","","Musannaf Ibn Abi Shaybah 1270","","","كتاب الطهارة"
"1271","(۱۲۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : مَنْ بَاتَ طَاہِرًا عَلَی ذِکْرٍ ، کَانَ عَلَی فِرَاشِہِ مَسْجِدًا لَہُ حَتَّی یَقُومَ۔","","Musannaf Ibn Abi Shaybah 1271","","","كتاب الطهارة"
"1272","(۱۲۷۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مَنِ اسْتَطَاعَ مِنْکُمْ أَنْ یَبِیتَ طَاہِرًا عَلَی ذِکْرٍ ، مُسْتَغْفِرًا لِذُنُوبِہِ ، فَإِنَّہُ بَلَغَنَا أَنَّ الأَرْوَاحَ تُبْعَثُ عَلَی مَا قُبِضَتْ عَلَیْہِ۔ (بخاری ۱۲۶۵۔ مسلم ۹۳)","","Musannaf Ibn Abi Shaybah 1272","","","كتاب الطهارة"
"1273","(۱۲۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی صَالِحٍ الْحَنَفِیِّ ، قَالَ : إذَا آوَی الرَّجُلُ إلَی فِرَاشِہِ طَاہِرًا مَسَحَہُ الْمَلَکُ۔ (ترمذی ۳۵۲۶)","","Musannaf Ibn Abi Shaybah 1273","","","كتاب الطهارة"
"1274","(۱۲۷۴) حَدَّثَنَا ابْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنْ شَہْرٍ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : مَنْ بَاتَ ذَاکِرًا طَاہِرًا ، ثُمَّ تَعَارَّ مِنَ اللَّیْلِ ، لَمْ یَسْأَلِ اللَّہَ حَاجَۃً لِلدُّنْیَا وَالآخِرَۃِ إِلاَّ أَعْطَاہُ اللَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 1274","","","كتاب الطهارة"
"1275","(۱۲۷۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الأَعْمَشِ ، قَالَ : حُدِّثْت عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ إذَا قَامَ مِنَ اللَّیْلِ تَیَمَّم۔","","Musannaf Ibn Abi Shaybah 1275","","","كتاب الطهارة"
"1276","(۱۲۷۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ أخْبَرَنَا الْعَوَّامُ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَمْرِو بْنِ عَبَسَۃَ ، قَالَ : إذَا آوَی الرَّجُلُ إلَی فِرَاشِہِ عَلَی طُہْرٍ ، فَذَکَرَ اللَّہَ حَتَّی تَغْلِبَہُ عَیْنَاہُ ، وَکَانَ أَوَّلُ مَا یَقُولُ حِینَ یَسْتَیْقِظُ : سُبْحَانَک لاَ إلَہَ إِلاَّ أَنْتَ اغْفِرْ لِی ، انْسَلَخَ مِنْ ذُنُوبِہِ کَمَا تَنْسَلِخُ الْحَیَّۃُ مِنْ جِلْدِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 1276","","","كتاب الطهارة"
"1277","(۱۲۷۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : سُئِلَ عَلِیٌّ عَنِ الرَّجُلِ یَمَسُّ اللَّحْمَ النِّیء ، فَیُصِیبُ یَدَہُ مِنْہُ شَیْئٌ ؟ قَالَ : لاَ عَلَیْہِ أَنْ لاَ یَتَوَضَّأَ إذَا مَسَّہُ۔","","Musannaf Ibn Abi Shaybah 1277","","","كتاب الطهارة"
"1278","(۱۲۷۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : لَیْسَ عَلَیْہِ وُضُوئٌ ، إِلاَّ أَنْ یَغْسِلَ یَدَہُ۔","","Musannaf Ibn Abi Shaybah 1278","","","كتاب الطهارة"
"1279","(۱۲۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : یَتَوَضَّأُ مِنَ اللَّحْمِ النِّیء ۔","","Musannaf Ibn Abi Shaybah 1279","","","كتاب الطهارة"
"1280","(۱۲۸۰) حَدَّثَنَا غُنْدَرٌ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ مَسَّ لَحْمًا نَیْئًا، قَالَ: لاَ بَأْسَ بِہِ، وَلَیْسَ عَلَیْہِ وُضُوئٌ۔","","Musannaf Ibn Abi Shaybah 1280","","","كتاب الطهارة"
"1281","(۱۲۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : إِنْ کَانَ أَصَابَ یَدَہُ أَثَرٌ مِنْہُ فَلْیَغْسِلْ یَدَہُ ، وَإِلاَّ فَلاَ یَغْسِلْہَا۔","","Musannaf Ibn Abi Shaybah 1281","","","كتاب الطهارة"
"1282","(۱۲۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ غَالِبٍ ، عَنْ أَبِی جَعْفَرٍ ۔ وَعَنْ لَیْثٍ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یُصِیبُ ثَوْبَہُ الْبَوْلُ فَلاَ یُدْری أَیْنَ ہُوَ ، قَالاَ : یَغْسِلُ الثَّوْبَ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 1282","","","كتاب الطهارة"
"1283","(۱۲۸۳) حَدَّثَنَا حُمَیْدٌ ، عَنْ أَبِیہِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : یَغْسِلُ الثَّوْبَ کُلَّہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1283","","","كتاب الطهارة"
"1284","(۱۲۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی بَکْرِ بْن حَفْصٍ ، عَنْ عَائِشَۃَ ابْنَۃِ سَعْدٍ ، عَنْ عَائِشَۃَ زَوْجِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؛ فِی الْبَوْلِ یُصِیبُ الثَّوْبَ ، قَالَتْ : تَرُشُّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 1284","","","كتاب الطهارة"
"1285","(۱۲۸۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ سُئِلَ عَنِ الثَّوْبِ یُصِیبُہُ الْبَوْلُ ، فَلاَ یُدْری أَیْنَ مَکَانُہُ ؟ قَالَ : إذَا اسْتَیْقَنَ غَسَلَہُ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 1285","","","كتاب الطهارة"
"1286","(۱۲۸۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ فِی رَجُلٍ أَصَابَ ثَوْبَہُ بَوْلٌ فَخَفِیَ عَلَیْہِ ، قَالَ : یَنْضَحُہُ ۔ قَالَ شُعْبَۃُ : وَأَخْبَرَنِی عَبْدُ الْخَالِقِ ، عَنْ حَمَّادٍ ، أَنَّہُ قَالَ : یَنْضَحُہُ ۔ وَسَأَلْت ابْنَ شُبْرُمَۃَ ، فَقَالَ : یَتَحَرَّی ذَلِکَ الْمَکَانَ وَیَغْسِلُہُ۔","","Musannaf Ibn Abi Shaybah 1286","","","كتاب الطهارة"
"1287","(۱۲۸۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الْمَرْأَۃِ تَخْضِبُ یَدَیْہَا عَلَی غَیْرِ وُضُوئٍ ، ثُمَّ تَحْضُرُہَا الصَّلاَۃُ ، قَالَ : تَنْزِعُ مَا عَلَی یَدَیْہَا إذَا أَرَادَتْ أَنْ تُصَلِّیَ۔","","Musannaf Ibn Abi Shaybah 1287","","","كتاب الطهارة"
"1288","(۱۲۸۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَسْتَحِبُّ أَنْ تَخْتَضِبَ الْمَرْأَۃُ إِذَا اخْتَضَبَتْ وَہِیَ حَائِضٌ، فَإِنِ اخْتَضَبَتْ وَہِیَ غَیْرُ حَائِضٍ فَلاَ بَأْسَ، غَیْرَ أَنَّہَا إذَا نَامَتْ، أَوْ أَحْدَثَتْ أَطْلَقَتْہُ وَتَوَضَّأَتْ۔","","Musannaf Ibn Abi Shaybah 1288","","","كتاب الطهارة"
"1289","(۱۲۸۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَبِی سَعِیدٍ ، رَضِیعٍ کَانَ لِعَائِشَۃَ ، قَالَ : سَأَلَتِ امْرَأَۃٌ عَائِشَۃَ أمَّ الْمُؤْمِنِینَ ، أَأُصَلِّی فِی الْخِضَابِ ؟ قَالَتْ : اُسْلُتِیہِ وَارْغِمِیہِ۔","","Musannaf Ibn Abi Shaybah 1289","","","كتاب الطهارة"
"1290","(۱۲۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ الْفَضْلِ ، عَنْ حَیَّۃَ بِنْتِ عَبْدِ اللہِ ، عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتِ : اُمْرُطِیہِ عِنْدَ الصَّلاَۃِ مَرْطًا ، فَقَدْ کُنْتُ أَفْعَلُہُ ، وَکُنْتُ أَحْسَنَ الْجَوَارِی ، أَوْ أَخَوَاتِی ، خِضَابًا۔","Da'if","Musannaf Ibn Abi Shaybah 1290","","","كتاب الطهارة"
"1291","(۱۲۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نِسَاؤُنَا یَخْتَضِبْنَ أَحْسَنَ خِضَابٍ ، یَخْتَضِبْنَ بَعْدَ الْعِشَائِ وَیَنْزِعْنَ قَبْلَ الْفَجْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 1291","","","كتاب الطهارة"
"1292","(۱۲۹۲) حَدَّثَنَا وَکِیعٌ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، عَنْ عَلْقَمَۃَ ، أَنَّہُ کَانَ یَأْمُرُ نِسَائَہُ یَخْتَضِبْنَ فِی أَیَّامِ حَیْضِہِنَّ۔","","Musannaf Ibn Abi Shaybah 1292","","","كتاب الطهارة"
"1293","(۱۲۹۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنِ امْرَأَۃٍ مِنْہُمْ ؛ أَنَّہَا أَرْسَلَتْ إلَی سَالِمٍ تَسْأَلُہُ عَنِ الْخِضَابِ وَتَحْضُرُ الصَّلاَۃَ ؟ فَقَالَ : انْزِعِیہِ وَتَوَضَّئِی وَصَلِّی۔","","Musannaf Ibn Abi Shaybah 1293","","","كتاب الطهارة"
"1294","(۱۲۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَمَّنْ سَمِعَ عَائِشَۃَ ، قَالَتْ : لأَنْ تُقْطَعَانِ أَحَبُّ إلَیَّ مِنْ أَنْ أَمْسَحَ عَلَی الْخِضَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 1294","","","كتاب الطهارة"
"1295","(۱۲۹۵) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَ یَسْتَحِبُّ أَنْ تَخْتَضِبَ الْمَرْأَۃُ وَہِیَ حَائِضٌ۔","","Musannaf Ibn Abi Shaybah 1295","","","كتاب الطهارة"
"1296","(۱۲۹۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ أُمِّ قَیْسٍ ابْنَۃِ مِحْصَنٍ ، قَالَتْ : دَخَلْت بِابْنٍ لِی عَلَی رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لَمْ یَأْکُلِ الطَّعَامَ ، فَبَالَ عَلَیْہِ ، فَدَعَا بِمَائٍ فَرَشَّہُ۔n(بخاری ۲۲۳۔ ابوداؤد ۳۷۷)","Sahih","Musannaf Ibn Abi Shaybah 1296","","","كتاب الطهارة"
"1297","(۱۲۹۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ قَابُوسَ بْنِ الْمُخَارِقِ ، عَنْ لُبَابَۃَ ابْنَۃِ الْحَارِثِ ، قَالَتْ : بَالَ الْحُسَیْنُ بْنُ عَلِیٍّ فِی حَجْرِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقُلْتُ : یَا رَسُولَ اللہِ ، أَعْطِنِی ثَوْبَک وَالْبَسْ ثَوْبًا غَیْرَہُ ، فَقَالَ : إنَّمَا یُنْضَحُ مِنْ بَوْلِ الذَّکَرِ ، وَیُغْسَلُ مِنْ بَوْلِ الأُنْثَی۔ (ابوداؤد ۳۷۸۔ ابن خزیمۃ ۲۸۲)","","Musannaf Ibn Abi Shaybah 1297","","","كتاب الطهارة"
"1298","(۱۲۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِصَبِیٍّ ، فَبَالَ عَلَیْہِ، فَأَتْبَعَہُ الْمَائَ وَلَمْ یَغْسِلْہُ۔ (مسلم ۱۰۲۔ ابن ماجہ ۵۲۳)","Sahih","Musannaf Ibn Abi Shaybah 1298","","","كتاب الطهارة"
"1299","(۱۲۹۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَخِیہِ عِیسَی ، عَنْ أَبِیہِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ جَدِّہِ أَبِی لَیْلَی ، قَالَ : کُنَّا عِنْدَ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ جُلُوسًا ، فَجَائَ الْحُسَیْنُ بْنُ عَلِیٍّ یَحْبُو حَتَّی جَلَسَ عَلَی صَدْرِہِ ، فَبَالَ عَلَیْہِ ، قَالَ : فَابْتَدَرْنَاہُ لِنَأْخُذَہُ ، فَقَالَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : ابْنِی ابْنِی ، ثُمَّ دَعَا بِمَائٍ ، فَصَبَّہُ عَلَیْہِ۔ (طحاوی ۹۴)","Da'if","Musannaf Ibn Abi Shaybah 1299","","","كتاب الطهارة"
"1300","(۱۳۰۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : دَخَلَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَلَی أُمِّ الْفَضْلِ ، وَمَعَہَا حُسَیْنٌ فَنَاوَلَتْہُ إیَّاہُ ، فَبَالَ عَلَی بَطْنِہِ ، أَوْ عَلَی صَدْرِہِ ، فَأَرَادَتْ أَنْ تَأْخُذہ مِنْہُ ، فَقَالَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : لاَ تُزْرِمِی ابْنِی ، لاَ تُزْرِمِی ابْنِی ، فَإِنَّ بَوْلَ الْغُلاَمِ یُرْشَحُ ، أَوْ یُنْضَحُ ، وَبَوْلَ الْجَارِیَۃِ یُغْسَلُ۔","Hasan","Musannaf Ibn Abi Shaybah 1300","","","كتاب الطهارة"
"1301","(۱۳۰۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی حَرْبِ بْنِ أَبِی الأَسْوَدِ ، قَالَ : قَالَ عَلِیٌّ : بَوْلُ الْغُلاَمِ یُنْضَحُ ، وَبَوْلُ الْجَارِیَۃِ یُغْسَلُ۔ (ابوداؤد ۳۸۰)","Sahih","Musannaf Ibn Abi Shaybah 1301","","","كتاب الطهارة"
"1302","(۱۳۰۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، قَالَ : کِلاَہُمَا یُنْضَحَانِ مَا لَمْ یَأْکُلاَ الطَّعَامَ۔","","Musannaf Ibn Abi Shaybah 1302","","","كتاب الطهارة"
"1303","(۱۳۰۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الْفَضْلِ بْنِ دَلْہَمٍ ، عَنِ الْحَسَنِ ، عَنْ أُمِّہِ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : یُغْسَلُ بَوْلُ الْجَارِیَۃِ، وَیُنْضَحُ بَوْلُ الْغُلاَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 1303","","","كتاب الطهارة"
"1304","(۱۳۰۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُجْرَی عَلَی بَوْلِ الصَّبِیِّ الْمَائُ۔","","Musannaf Ibn Abi Shaybah 1304","","","كتاب الطهارة"
"1305","(۱۳۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْنٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إِنْ کَانَ طَعِمَ غُسِلَ ، وَإِنْ لَمْ یَکُنْ طَعِمَ صُبَّ عَلَیْہِ الْمَائُ۔","","Musannaf Ibn Abi Shaybah 1305","","","كتاب الطهارة"
"1306","(۱۳۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ وَاقِدٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ لَہُ رَجُلٌ : یَحْمِلُ أَحَدُنَا الصَّبِیَّ فَیُصِیبُہُ مِنْ أَذَاہُ ؟ قَالَ : إِنْ کَانَ طَعِمَ غُسِلَ ، وَإِنْ لَمْ یَکُنْ طَعِمَ صُبَّ عَلَیْہِ الْمَائُ۔","","Musannaf Ibn Abi Shaybah 1306","","","كتاب الطهارة"
"1307","(۱۳۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : یُصَبُّ الْمَائُ عَلَی بَوْلِ الصَّبِیِّ۔","","Musannaf Ibn Abi Shaybah 1307","","","كتاب الطهارة"
"1308","(۱۳۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ بُکَیْر ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : الصَّبِیُّ مَا لَمْ یَأْکُلِ الطَّعَامَ ، تَغْسِلُ ثَوْبَک مِنْ بَوْلِہِ وَسَلْحِہِ أَیْضًا ؟ قَالَ : اُرْشُشْ عَلَیْہِ الْمَائَ ، أَوِ اصْبُبْ عَلَیْہِ ۔ قُلْتُ : فَالصَّبِیُّ یُلْعَقُ قَبْلَ أَنْ یَأْکُلَ الطَّعَامَ مِنَ السَّمْنِ وَالْعَسَلِ ، وَذَلِکَ طَعَامٌ ؟ قَالَ : اُرْشُشْ عَلَیْہِ ، أَوِ اصْبُبْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 1308","","","كتاب الطهارة"
"1309","(۱۳۰۹) حَدَّثَنَا مُحَمَّدُ بْنُ بُکَیْر ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ شِہَابٍ ، قَالَ : مَضَتِ السُّنَّۃُ أَنَّہُ یُرَشُّ بَوْلُ مَنْ لَمْ یَأْکُلِ الطَّعَامَ ، وَمَضَتِ السُّنَّۃُ بِغَسْلِ بَوْلِ مَنْ أَکَلَ الطَّعَامَ مِنَ الصِّبْیَانِ۔","","Musannaf Ibn Abi Shaybah 1309","","","كتاب الطهارة"
"1310","(۱۳۱۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ الْحَسَنِ ، قَالَ : حَدَّثَنِی مَنْ رَأَی النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ بَالَ قَاعِدًا ، فَتَفَاجَّ حَتَّی ظَنَنَّا أَنَّ وَرِکَہُ سَیَنْفَکُّ۔","Sahih","Musannaf Ibn Abi Shaybah 1310","","","كتاب الطهارة"
"1311","(۱۳۱۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنِی أَبُو حَرَّۃَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا بَالَ تَفَاجَّ حَتَّی یُرْثَی لَہُ۔","","Musannaf Ibn Abi Shaybah 1311","","","كتاب الطهارة"
"1312","(۱۳۱۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَسَنَۃَ ، قَالَ : خَرَجَ عَلَیْنَا النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ وَفِی یَدِہِ کَہَیْئَۃِ الدَّرَقَۃِ ، قَالَ : فَوَضَعَہَا ثُمَّ جَلَسَ فَبَالَ إلَیْہَا ، فَقَالَ بَعْضُہُمْ : اُنْظُرُوا إلَیْہِ ، یَبُولُ کَمَا تبُولُ الْمَرْأَۃُ ، فَسَمِعَہُ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : وَیْحَک مَا عَلِمْت مَا أَصَابَ صَاحِبَ بَنِی إسْرَائِیلَ ، کَانُوا إذَا أَصَابَہُمُ الْبَوْلُ قَرَضُوہُ بِالْمَقَارِیضِ ، فَنَہَاہُمْ فَعُذِّبَ فِی قَبْرِہِ۔n(ابوداؤد ۲۳۔ ابن ماجہ ۳۴۶)","Sahih","Musannaf Ibn Abi Shaybah 1312","","","كتاب الطهارة"
"1313","(۱۳۱۳) حَدَّثَنَا وَکِیعٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَرَّ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ بِقَبْرَیْنِ ، فَقَالَ : إنَّہُمَا لَیُعَذَّبَانِ ، وَمَا یُعَذَّبَانِ فِی کَبِیرٍ ، أَمَّا أَحَدُہُمَا فَکَانَ لاَ یَسْتَترُ مِنْ بَوْلِہِ ، وَأَمَّا الأَخَرُ فَکَانَ یَمْشِی بِالنَّمِیمَۃِ۔ (بخاری ۶۰۵۲۔ ابن ماجہ ۳۴۷۔)","Sahih","Musannaf Ibn Abi Shaybah 1313","","","كتاب الطهارة"
"1314","(۱۳۱۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، قَالَ : سَمِعْتُ أَبَا وَائِلٍ یُحَدِّثُ ، أَنَّ أَبَا مُوسَی کَانَ یُشَدِّدُ فِی الْبَوْلِ ، فَقَالَ : کَانَتْ بَنُو إسْرَائِیلَ إذَا أَصَابَ أَحَدَہُمُ الْبَوْلُ یُتْبِعُہُ بِالْمِقْرَاضَیْن۔ (بخاری ۲۲۶۔ مسلم ۲۲۸)","Sahih","Musannaf Ibn Abi Shaybah 1314","","","كتاب الطهارة"
"1315","(۱۳۱۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَکْثَرُ عَذَابِ الْقَبْرِ مِنَ الْبَوْلِ۔ (احمد ۲/۳۸۸۔ دارقطنی ۱۲۸)","Sahih","Musannaf Ibn Abi Shaybah 1315","","","كتاب الطهارة"
"1316","(۱۳۱۶) حَدَّثَنَا یَعْلَی ، قَالَ : حدَّثَنَا قُدَامَۃُ بْنُ عَبْدِ اللہِ الْعَامِرِیُّ ، قَالَ حَدَّثَتْنِی جَسْرۃُ ، قَالَتْ حَدَّثَتْنِی عَائِشَۃُ ، قَالَتْ : دَخَلَتْ عَلَیَّ امْرَأَۃٌ مِنَ الْیَہُودِ ، فَقَالَتْ : إنَّ عَذَابَ الْقَبْرِ مِنَ الْبَوْلِ قُلْتُ : کَذَبْت ، قَالَتْ : بَلَی ، إِنَّہُ لَیُقْرَضُ مِنْہُ الْجِلْدُ وَالثَّوْبُ ، قَالَتْ : فَخَرَجَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إلَی الصَّلاَۃِ ، وَقَدِ ارْتَفَعَتْ أَصْوَاتُنَا ، فَقَالَ : مَا ہَذَا ؟ فَأَخْبَرْتُہُ ، فَقَالَ : صَدَقَتْ۔ (احمد ۶/۶۱۔ نسائی ۹۹۶۶)","Da'if","Musannaf Ibn Abi Shaybah 1316","","","كتاب الطهارة"
"1317","(۱۳۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَسْوَدُ بْنُ شَیْبَانَ ، قَالَ : حَدَّثَنَا بَحْرُ بْنُ مَرَّارٍ ، عَنْ جَدِّہِ أَبِی بَکْرَۃَ ، قَالَ : مَرَّ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ بِقَبْرَیْنِ ، فَقَالَ : إنَّہُمَا لَیُعَذَّبَانِ ، وَمَا یُعَذَّبَانِ فِی کَبِیرٍ ؛ أَمَّا أَحَدُہُمَا فَیُعَذَّبُ فِی الْبَوْلِ ، وَأَمَّا الآخَرُ فَفِی الْغِیبَۃِ۔ (احمد ۳۹۔ ابن ماجہ ۳۴۹)","","Musannaf Ibn Abi Shaybah 1317","","","كتاب الطهارة"
"1318","(۱۳۱۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی وَائِلٍ ، عَنْ حُذَیْفَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَتَی سُبَاطَۃَ قَوْمٍ ، فَبَالَ عَلَیْہَا قَائِمًا۔ (بخاری ۲۲۴۔ مسلم ۲۲۸)","","Musannaf Ibn Abi Shaybah 1318","","","كتاب الطهارة"
"1319","(۱۳۱۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدٍ ، قَالَ : رَأَیْتُ عُمَرَ بَالَ قَائِمًا۔","Sahih","Musannaf Ibn Abi Shaybah 1319","","","كتاب الطهارة"
"1320","(۱۳۲۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ وَحُصَیْنٍ ، عَنْ أَبِی ظَبْیَانَ ، قَالَ : رَأَیْتُ عَلِیًّا بَالَ قَائِمًا۔","Sahih","Musannaf Ibn Abi Shaybah 1320","","","كتاب الطهارة"
"1321","(۱۳۲۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ قَبِیصَۃَ ؛ أَنَّہُ رَأَی زَیْدَ بْنَ ثَابِتٍ یَبُولُ قَائِمًا۔","Sahih","Musannaf Ibn Abi Shaybah 1321","","","كتاب الطهارة"
"1322","(۱۳۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ عَبْدِ اللہِ الرُّومِیِّ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَبُولُ قَائِمًا۔","Da'if","Musannaf Ibn Abi Shaybah 1322","","","كتاب الطهارة"
"1323","(۱۳۲۳) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : حدَّثَنِی رَجُلٌ مِنْ بَنِی سَعْدٍ مِنْ أَخْوَالِ الْمُحَرَّرِ بْنِ أَبِی ہُرَیْرَۃَ ، قَالَ : رَأَیْتُ أَبَا ہُرَیْرَۃَ بَالَ قَائِمًا۔","Da'if","Musannaf Ibn Abi Shaybah 1323","","","كتاب الطهارة"
"1324","(۱۳۲۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَحْیَی ، عَنْ عُمَرَ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَبُولُ قَائِمًا ، فَقُلْتُ : یَا أَبَا مُحَمَّدٍ ، تَبُولُ قَائِمًا ؟ أَمَا تَخْشَی أَنْ یُصِیبَک ؟ فَقَالَ لِی : أَمَا تَبُولُ أَنْتَ قَائِمًا ؟ قُلْتُ : لاَ ، قُلْتُ : ذَاکَ أَدوی لَکَ۔","","Musannaf Ibn Abi Shaybah 1324","","","كتاب الطهارة"
"1325","(۱۳۲۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی خَالِدٍ ، قَالَ : رَأَیْتُ الشَّعْبِیَّ یَبُولُ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 1325","","","كتاب الطهارة"
"1326","(۱۳۲۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : رَأَیْتُ مُحَمَّدًا یَبُولُ قَائِمًا ، وَکَانَ لاَ یَرَی بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 1326","","","كتاب الطهارة"
"1327","(۱۳۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : رَأَیْتُ أَبِی یَبُولُ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 1327","","","كتاب الطهارة"
"1328","(۱۳۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ طُعْمَۃَ الْجَعْفَرِیِّ ، قَالَ : رَأَیْتُ یَزِیدَ بْنَ الأَصَمِّ یَبُولُ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 1328","","","كتاب الطهارة"
"1329","(۱۳۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنْ عَبْدِ الْعَزِیزِ أَبِی عَبْدِ اللہِ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا بَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَائِمًا إِلاَّ مَرَّۃً ، فِی کَثِیبٍ أَعْجَبَہُ۔","","Musannaf Ibn Abi Shaybah 1329","","","كتاب الطهارة"
"1330","(۱۳۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، قَالَ : رَأَیْتُ الْحَکَمَ یَبُولُ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 1330","","","كتاب الطهارة"
"1331","(۱۳۳۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَابْنُ إدْرِیسَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ سَعْدَ بْنَ عُبَادَۃَ بَالَ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 1331","","","كتاب الطهارة"
"1332","(۱۳۳۲) حَدَّثَنَا شَرِیکٌ ، عَنِ الْمِقْدَامِ بْنِ شُرَیْحٍ بْنِ ہانِیئٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : مَنْ حَدَّثَک أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ بَالَ قَائِمًا ، فَلاَ تُصَدِّقْہُ ، أَنَا رَأَیْتُہُ یَبُولُ قَاعِدًا۔ (احمد ۶/۲۱۳۔ ابن راھویہ ۱۵۷۰)","Hasan","Musannaf Ibn Abi Shaybah 1332","","","كتاب الطهارة"
"1333","(۱۳۳۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، وَابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنْ عُمَرَ ، قَالَ : مَا بُلْت قَائِمًا مُنْذُ أَسْلَمْت۔","Sahih","Musannaf Ibn Abi Shaybah 1333","","","كتاب الطهارة"
"1334","(۱۳۳۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ الْبَوْلَ قَائِمًا ، وَالشُّرْبَ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 1334","","","كتاب الطهارة"
"1335","(۱۳۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : قَالَ عَبْدُ اللہِ : مِنَ الْجَفَائِ أَنْ یَبُولَ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 1335","","","كتاب الطهارة"
"1336","(۱۳۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ کَہْمَسٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، قَالَ : کَانَ یُقَالُ : مِنَ الْجَفَائِ أَنْ تَبُولَ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 1336","","","كتاب الطهارة"
"1337","(۱۳۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حُرَیْثٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : مِنَ الْجَفَائِ أَنْ یَبُولَ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 1337","","","كتاب الطهارة"
"1338","(۱۳۳۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ : سَمِعْتُہُ یَقُولُ : کَانَ ابْنُ سِیرِینَ رُبَّمَا بَزَقَ فَیَقُولُ لِلرَّجُلِ : اُنْظُرْ ، ہَلْ تَغَیَّرَ الرِّیقُ ؟ فَإِنْ کَانَ تَغَیَّرَ بَزَقَ الثَّانِیَۃَ ، فَإِنْ کَانَ فِی الثَّالِثَۃِ مُتَغَیِّرًا ، کَأَنَّہُ یَتَوَضَّأُ ، وَإِنْ لَمْ یَکُنْ فِی الثَّالِثَۃِ مُتَغَیِّرًا لَمْ یَرَ وُضُوئً۔","","Musannaf Ibn Abi Shaybah 1338","","","كتاب الطهارة"
"1339","(۱۳۳۹) حَدَّثَنَا إبْرَاہِیمُ بْنُ صَدَقَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ بَزَقَ فَرَأَی فِی بُزَاقِہِ دَمًا ، أَنَّہُ لَمْ یَرَ ذَلِکَ شَیْئًا حَتَّی یَکُونَ دَمًا عَبِیطًا۔","","Musannaf Ibn Abi Shaybah 1339","","","كتاب الطهارة"
"1340","(۱۳۴۰) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی الصُّفْرَۃَ شَیْئًا إِلاَّ أَنْ یَکُونَ دَمًا عَبِیطًا ، یَعْنِی : فِی الْبُزَاقِ۔","","Musannaf Ibn Abi Shaybah 1340","","","كتاب الطهارة"
"1341","(۱۳۴۱) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ سِنَانٍ الْبُرْجُمِیِّ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَبْزُقُ ، فَیَکُونُ فِی بُزَاقِہِ الدَّمُ ، قَالَ : إذَا غَلَبَتِ الْحُمْرَۃُ الْبَیَاضَ تَوَضَّأَ ، وَإِذَا غَلَبَ الْبَیَاضُ الْحُمْرَۃَ لَمْ یَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 1341","","","كتاب الطهارة"
"1342","(۱۳۴۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی سَارَۃَ ، قَالَ : رَأَیْتُ سَالِمًا بَزَقَ دَمًا أَحْمَرَ ، ثُمَّ دَعَا بِمَائٍ فَمَضْمَضَ ، وَلَمْ یَتَوَضَّأْ وَدَخَلَ الْمَسْجِدَ۔","","Musannaf Ibn Abi Shaybah 1342","","","كتاب الطهارة"
"1343","(۱۳۴۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : رَأَیْتُ ابْنَ أَبِی أَوْفَی بَزَقَ وَہُوَ یُصَلِّی ، ثُمَّ مَضَی فِی صَلاَتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1343","","","كتاب الطهارة"
"1344","(۱۳۴۴) حَدَّثَنَا الْمُحَارِبِیُّ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَمَّادٍ؛ فِی الرَّجُلِ یَکُونُ عَلَی وُضُوئٍ ، فَیَرَی الصُّفْرَۃَ فِی الْبُزَاقِ، فَقَالَ : لَیْسَ بِشَیْئٍ ، إِلاَّ أَنْ یَکُونَ دَمٌ سَائِل۔","","Musannaf Ibn Abi Shaybah 1344","","","كتاب الطهارة"
"1345","(۱۳۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ جَابِرٍ ، عَنْ سَالِمٍ ، وَالْقَاسِمِ ؛ فِی الصُّفْرَۃِ فِی الْبُزَاقِ قَالاَ : دَعْ مَا یَرِیبُک إلَی مَا لاَ یَرِیبُک۔","","Musannaf Ibn Abi Shaybah 1345","","","كتاب الطهارة"
"1346","(۱۳۴۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ شَرِیکٍ ، عَنْ جَابِرِ ،عَنْ عَامِرٍ ؛ فِی الرَّجُلِ یَخْرُجُ فِی رِیقِہِ الصُّفْرَۃُ ، قَالَ: لاَ یَضُرُّہُ۔","","Musannaf Ibn Abi Shaybah 1346","","","كتاب الطهارة"
"1347","(۱۳۴۷) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، قَالَ : سَمِعْتُ الْحَارِثَ الْعُکْلِیَّ یَقُولُ ، ؛ فِی الرَّجُلِ یَبْزُقُ وَفِی بُزَاقِہِ الدَّمُ ، قَالَ : إذَا غَلَبَ الدَّمُ الْبُزَاقَ فَفِیہِ الْوُضُوئُ۔","","Musannaf Ibn Abi Shaybah 1347","","","كتاب الطهارة"
"1348","(۱۳۴۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، قَالَ : إذَا ظَہَرَ الدَّمُ عَلَی الْبُزَاقِ فَتَوَضَّہ۔","","Musannaf Ibn Abi Shaybah 1348","","","كتاب الطهارة"
"1349","(۱۳۴۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَائِشَۃَ ، عَنْ عُمَرَ ، قَالَ : یُغْسَلُ الْبَوْلُ مَرَّتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 1349","","","كتاب الطهارة"
"1350","(۱۳۵۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَبُولُ فَیَنْتَضِحُ عَلَی فَخِذَیْہِ وَسَاقَیْہِ ، قَالَ : یَنْضَحُہُ بِالْمَائِ۔","","Musannaf Ibn Abi Shaybah 1350","","","كتاب الطهارة"
"1351","(۱۳۵۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الرَّشُّ بِالرَّشِّ ، وَالصَّبُّ بِالصَّبِّ۔","","Musannaf Ibn Abi Shaybah 1351","","","كتاب الطهارة"
"1352","(۱۳۵۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَسْحَۃً ، أَوْ مَسْحَتَیْنِ فِی الْبَوْلِ۔","","Musannaf Ibn Abi Shaybah 1352","","","كتاب الطهارة"
"1353","(۱۳۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : جَائَتْ فَاطِمَۃُ ابْنَۃُ أَبِی حُبَیْشٍ إلَی النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إنِّی امْرَأَۃٌ أُسْتَحَاضُ فَلاَ أَطْہُرُ ، أَفَأَدَعُ الصَّلاَۃَ ؟ قَالَ : لاَ ، إنَّمَا ذَلِکَ عِرْقٌ وَلَیْسَ بِالْحَیْضَۃِ ، فَإِذَا أَقْبَلَتِ الْحَیْضَۃُ فَدَعِی الصَّلاَۃَ ، فَإِذَا أَدْبَرَتْ فَاغْسِلِی عَنْک الدَّمَ وَصَلِّی۔ (بخاری ۲۲۸۔ ابوداؤد ۲۸۶)","Sahih","Musannaf Ibn Abi Shaybah 1353","","","كتاب الطهارة"
"1354","(۱۳۵۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : جَائَتْ فَاطِمَۃُ ابْنَۃُ أَبِی حُبَیْشٍ إلَی النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إنِّی امْرَأَۃٌ أُسْتَحَاضُ فَلاَ أَطْہُرُ ، أَفَادَعُ الصَّلاَۃَ ؟ قَالَ : لاَ ، إنَّمَا ذَلِکَ عِرْقٌ وَلَیْسَ بِالْحَیْضَۃِ ، اجْتَنِبِی الصَّلاَۃَ أَیَّامَ حَیْضَتک ، ثُمَّ اغْتَسِلِی ، وَتَوَضَّئِی لِکُلِّ صَلاَۃٍ ، ثُمَّ صَلِّی ، وَإِنْ قَطَرَ الدَّمُ عَلَی الْحَصِیرِ۔ (ابوداؤد ۳۰۲۔ ابن ماجہ ۶۲۴)","Sahih","Musannaf Ibn Abi Shaybah 1354","","","كتاب الطهارة"
"1355","(۱۳۵۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : سَأَلَتِ امْرَأَۃٌ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : إنِّی أُسْتَحَاضُ فَلاَ أَطْہُرُ ، أَفَأَدَعُ الصَّلاَۃَ ؟ قَالَ : لاَ، وَلَکِنْ دَعِی قَدْرَ الأَیَّامِ وَاللَّیَالِی الَّتِی کُنْت تَحِیضِینَ وَقَدْرَہُنَّ ، ثُمَّ اغْتَسِلِی وَاسْتَثْفِرِی وَصَلِّی ۔ إِلاَّ أَنَّ ابْنَ نُمَیْرٍ قَالَ : أُمُّ سَلَمَۃَ اسْتَفْتَتِ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتِ : امْرَأَۃٌ تُہْرَاقُ الدَّمَ ؟ فَقَالَ : تَنْتَظِرُ قَدْرَ الأَیَّامِ وَاللَّیَالِی الَّتِی کَانَتْ تَحِیض ، أَوْ قَدْرَہُنَّ مِنَ الشَّہْرِ ، ثُمَّ ذَکَرَ مِثْلَ حَدِیثِ أَبِی أُسَامَۃَ۔n(ابوداؤد ۲۷۸۔ ابن ماجہ ۶۲۳)","Sahih","Musannaf Ibn Abi Shaybah 1355","","","كتاب الطهارة"
"1356","(۱۳۵۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ أُمَّ حَبِیبَۃَ ابْنَۃَ جَحْشٍ اُسْتُحِیضَتْ ، فَسَأَلَتِ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، أَوْ سُئِلَ لَہَا ؟ فَأَمَرَہَا أَنْ تَنْظُرَ أَیَّامَ أَقْرَائِہَا ، ثُمَّ تَغْتَسِلَ ، فَإِنْ رَأَتْ شَیْئًا بَعْدَ ذَلِکَ تَوَضَّأَتْ وَاحْتَشَتْ وَصَلَّتْ۔ (ابوداؤد ۳۰۹۔ البیہقی ۳۵۱)","","Musannaf Ibn Abi Shaybah 1356","","","كتاب الطهارة"
"1357","(۱۳۵۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ؛ أَنَّ فَاطِمَۃَ ابْنَۃَ أَبِی حُبَیْشٍ اُسْتُحِیضَتْ، فَسَأَلَتِ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، أَوْ سُئِلَ لَہَا ؟ فَأَمَرَہَا أَنْ تَدَعَ الصَّلاَۃَ أَیَّامَ أَقْرَائِہَا ، ثُمَّ تَغْتَسِلَ فِیمَا سِوَی ذَلِکَ ، ثُمَّ تَسْتَثْفِرَ بِثَوْبٍ وَتُصَلِّیَ۔ (دارقطنی ۱۰)","","Musannaf Ibn Abi Shaybah 1357","","","كتاب الطهارة"
"1358","(۱۳۵۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنِ الْحَکَمِ ، عَنْ أَبِی جَعْفَرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَمَرَ الْمُسْتَحَاضَۃَ إذَا مَضَتْ أَیَّامُ أَقْرَائِہَا ، أَنْ تَغْتَسِلَ وَتَوَضَّأَ لِکُلِّ صَلاَۃٍ وَتُصَلِّیَ۔","","Musannaf Ibn Abi Shaybah 1358","","","كتاب الطهارة"
"1359","(۱۳۵۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ امْرَأَۃَ مَسْرُوقٍ سَأَلَتْ عَائِشَۃَ عَنِ الْمُسْتَحَاضَۃِ ؟ قَالَتْ : تَوَضَّأ لِکُلِّ صَلاَۃٍ وَتَحْتَشِی وَتُصَلِّی۔","","Musannaf Ibn Abi Shaybah 1359","","","كتاب الطهارة"
"1360","(۱۳۶۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ الْمُجَالِدِ ، وَدَاوُد ، عَنِ الشَّعْبِیِّ ، قَالَ : أَرْسَلْتُ امْرَأَتِی إلَی امْرَأَۃِ مَسْرُوقٍ فَسَأَلَتْہَا عَنِ الْمُسْتَحَاضَۃِ ، فَذَکَرَتْ عَنْ عَائِشَۃَ أَنَّہَا قَالَتْ : تَجْلِسُ أَیَّامَ أَقْرَائِہَا ، ثُمَّ تَغْتَسِلُ وَتَوَضَّأ لِکُلِّ صَلاَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 1360","","","كتاب الطهارة"
"1361","(۱۳۶۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَعْقَاعِ بْنِ حَکِیمٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ الْمُسْتَحَاضَۃِ ؟ فَقَالَ : مَا أَحَدٌ أَعْلَمُ بِہَذَا مِنِّی ، إذَا أَقْبَلَتِ الْحَیْضَۃُ فَلْتَدَعِ الصَّلاَۃَ ، وَإِذَا أَدْبَرَتْ فَلْتَغْتَسِلْ، وَلْتَغْسِلْ عَنْہَا الدَّمَ ، وَلْتَوَضَّأْ لِکُلِّ صَلاَۃٍ۔","","Musannaf Ibn Abi Shaybah 1361","","","كتاب الطهارة"
"1362","(۱۳۶۲) حَدَّثَنَا حَفْصٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : الْمُسْتَحَاضَۃُ تَغْتَسِلُ وَتَوَضَّأُ لِکُلِّ صَلاَۃٍ۔","","Musannaf Ibn Abi Shaybah 1362","","","كتاب الطهارة"
"1363","(۱۳۶۳) حَدَّثَنَا حَاتِمُ، عَنْ عَبْدِالرَّحْمَنِ بْنِ حَرْمَلَۃَ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ؛ فِی الْمَرْأَۃِ الَّتِی تُسْتَحَاضُ، فَتُطَاوِلُہَا حَیْضَتُہَا ، تَغْتَسِلُ فَتَسْتَنْقِی ، ثُمَّ تَجْعَلُ کُرْسُفًا کَمَا یَجْعَلُ الرَّاعِفُ ، وَتَسْتَثْفِرُ بِثَوْبٍ ، ثُمَّ تُصَلِّی۔","","Musannaf Ibn Abi Shaybah 1363","","","كتاب الطهارة"
"1364","(۱۳۶۴) حَدَّثَنَا جَرِیرٌ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تُؤَخِّرُ الظُّہْرَ وَتُعَجِّلُ الْعَصْرَ، وَتَغْتَسِلُ مَرَّۃً وَاحِدَۃً ، وَتُؤَخِّرُ الْمَغْرِبَ وَتُعَجِّلُ الْعِشَائَ ، وَتَغْتَسِلُ مَرَّۃً وَاحِدَۃً ، ثُمَّ تَغْتَسِلُ لِلْفَجْرِ ، ثُمَّ تَقْرِنُ بَیْنَہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 1364","","","كتاب الطهارة"
"1365","(۱۳۶۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : تَجْلِسُ أَیَّامَ حَیْضَتِہَا الَّتِی کَانَتْ تَحِیضُ فِیہَا ، فَإِذَا مَضَتْ تِلْکَ الأَیَّامُ اغْتَسَلَتْ ، ثُمَّ تُؤَخِّرُ مِنَ الظُّہْرِ وَتُعَجِّلُ مِنَ الْعَصْرِ ، ثُمَّ تُصَلِّیہِمَا بِغُسْلٍ وَاحِدٍ ، کُلَّ وَاحِدَۃٍ مِنْہُمَا فِی وَقْتٍ ، ثُمَّ لِتَغْسِلْ لِلْمَغْرِبِ وَالْعِشَائِ ، وَتُؤَخِّرُ مِنَ الْمَغْرِبِ وَتُعَجِّلُ مِنَ الْعِشَائِ ، ثُمَّ تُصَلِّی کُلَّ وَاحِدَۃٍ مِنْہُمَا فِی وَقْتٍ ، ثُمَّ تَغْتَسِلُ لِلْفَجْرِ۔","","Musannaf Ibn Abi Shaybah 1365","","","كتاب الطهارة"
"1366","(۱۳۶۶) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : تَغْتَسِلُ مِنَ الظُّہْرِ إلَی الظُّہْرِ۔","","Musannaf Ibn Abi Shaybah 1366","","","كتاب الطهارة"
"1367","(۱۳۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُمَیٍّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 1367","","","كتاب الطهارة"
"1368","(۱۳۶۸) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، أَنَّ عَلِیًّا ، وَابْنَ عَبَّاسٍ قَالاَ فِی الْمُسْتَحَاضَۃِ : تَغْتَسِلُ لِکُلِّ صَلاَۃٍ۔","","Musannaf Ibn Abi Shaybah 1368","","","كتاب الطهارة"
"1369","(۱۳۶۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : تَغْتَسِلُ لِلظُّہْرِ وَالْعَصْرِ غُسْلاً، وَلِلْمَغْرِبِ وَالْعِشَائِ غُسْلاً ، وَلِلْفَجْرِ غُسْلاً۔","","Musannaf Ibn Abi Shaybah 1369","","","كتاب الطهارة"
"1370","(۱۳۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنِ الْمِنْہَالِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : کُنْتُ عِنْدَ ابْنِ عَبَّاسٍ ، فَجَائَتِ امْرَأَۃٌ بِکِتَابٍ فَقَرَأَتْہُ ، فَإِذَا فِیہِ إنِّی امْرَأَۃٌ مُسْتَحَاضَۃٌ ، وَإِنَّ عَلِیًّا قَالَ : تَغْتَسِلُ لِکُلِّ صَلاَۃٍ ، فَقَالَ ابْنُ عَبَّاسٍ: مَا أَجِدُ لَہَا إِلاَّ مَا قَالَ عَلِیٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 1370","","","كتاب الطهارة"
"1371","(۱۳۷۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ؛ فِی الْمُسْتَحَاضَۃِ تُؤَخِّرُ مِنَ الظُّہْرِ وَتُعَجِّلُ مِنَ الْعَصْرِ ، وَتُؤَخِّرُ الْمَغْرِبَ وَتُعَجِّلُ الْعِشَائَ ، قَالَ : وَأَظُنُّہُ ، قَالَ : وَتَغْتَسِلُ لِلْفَجْرِ ۔ قَالَ : فَذَکَرْت ذَلِکَ لاِبْنِ الزُّبَیْرِ ، وَابْنِ عَبَّاسٍ فَقَالاَ : مَا نَجِدُ لَہَا إِلاَّ مَا قَالَ عَلِیٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 1371","","","كتاب الطهارة"
"1372","(۱۳۷۲) حَدَّثَنَا صَفْوَانُ بْنُ عِیسَی ، عَنْ مُحَمَّدِ بْنِ عُثْمَانَ الْمَخْزُومِیِّ ، قَالَ : سَأَلْتُ سَالِمًا وَالْقَاسِمَ عَنِ الْمُسْتَحَاضَۃِ ، فَقَالَ أَحَدُہُمَا : تَنْتَظِرُ أَیَّامَ أَقْرَائِہَا ، فَإِذَا مَضَتْ أَیَّامُ أَقْرَائِہَا اغْتَسَلَتْ وَصَلَّتْ ، وَقَالَ الآخَرُ : تَغْتَسِلُ مِنَ الظُّہْرِ إلَی الظُّہْرِ۔","","Musannaf Ibn Abi Shaybah 1372","","","كتاب الطهارة"
"1373","(۱۳۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ طَلْحَۃَ ، عَنْ عَمِّہِ عِمْرَانَ بْنِ طَلْحَۃَ ، عَنْ أُمِّہِ حَمْنَۃَ ابْنَۃِ جَحْشٍ ؛ أَنَّہَا اُسْتُحِیضَتْ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَأَتَتْ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إنِّی اُسْتُحِضْت حَیْضَۃً مُنْکَرَۃً شَدِیدَۃً ، فَقَالَ لَہَا : احْتَشِی کُرْسُفًا ، قَالَتْ : إِنَّہُ أَشَدُّ مِنْ ذَلِکَ ، إنِّی أَثُجُّ ثَجًّا ، قَالَ : تَلَجَّمِی وَتَحَیَّضِی فِی کُلِّ شَہْرٍ فِی عِلْمِ اللہِ سِتَّۃَ أَیَّامٍ ، أَوْ سَبْعَۃً ، ثُمَّ اغْتَسِلِی غُسْلاً ، وَصَلِّی وَصُومِی ثَلاَثًا وَعِشْرِینَ ، أَوْ أَرْبَعًا وَعِشْرِینَ وَأَخِّرِی الظُّہْرَ وَقَدِّمِی الْعَصْرَ ، وَاغْتَسِلِی لَہُمَا غُسْلاً ، وَأَخِّرِی الْمَغْرِبَ وَقَدِّمِی الْعِشَائَ وَاغْتَسِلِی لَہُمَا غُسْلاً ، وَہَذَا أَحَبُّ الأَمْرَیْنِ إلَیَّ۔ (ابن ماجہ ۶۲۷۔ ابوداؤد ۲۹۱)","Da'if","Musannaf Ibn Abi Shaybah 1373","","","كتاب الطهارة"
"1374","(۱۳۷۴) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی الْیَقْظَانِ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْمُسْتَحَاضَۃُ تَدَعُ الصَّلاَۃَ أَیَّامَ أَقْرَائِہَا ، ثُمَّ تَغْتَسِلُ ، وَتَوَضَّأُ لِکُلِّ صَلاَۃٍ ، وَتَصُومُ وَتُصَلِّی۔n(ابوداؤد ۳۰۱۔ ترمذی ۱۲۶)","Da'if","Musannaf Ibn Abi Shaybah 1374","","","كتاب الطهارة"
"1375","(۱۳۷۵) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی الْیَقْظَانِ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 1375","","","كتاب الطهارة"
"1376","(۱۳۷۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنِی إسْمَاعِیلُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عَبْدِ اللہِ ؛ أَنَّہُ سَمِعَ أَبَا جَعْفَرٍ یَقُولُ فِی الْمُسْتَحَاضَۃِ : إنَّمَا ہِیَ رَکْضَۃٌ مِنَ الشَّیْطَانِ ، فَإِنْ غَلَبَہَا الدَّمُ اسْتَثْفَرَتْ وَتَغْتَسِلُ بَعْدَ قُرْئِہَا وَتَوَضَّأُ ، کَمَا قَالَتْ عَائِشَۃُ۔","","Musannaf Ibn Abi Shaybah 1376","","","كتاب الطهارة"
"1377","(۱۳۷۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : اسْتُحِیضَتِ امْرَأَۃٌ مِنْ آلِ أَنَسٍ ، فَأَمَرُونِی فَسَأَلْت ابْنَ عَبَّاسٍ ؟ فَقَالَ : أَمَّا مَا رَأَتِ الدَّمَ الْبَحْرَانِیَّ فَلاَ تُصَلِّی ، وَإِذَا رَأَتِ الطُّہْرَ وَلَوْ سَاعَۃً مِنَ النَّہَارِ فَلْتَغْتَسِلْ وَتُصَلِّی۔","Sahih","Musannaf Ibn Abi Shaybah 1377","","","كتاب الطهارة"
"1378","(۱۳۷۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ زَیْنَبَ بِنْتِ أُمِّ سَلَمَۃَ ، قَالَتْ : رَأَیْت ابْنَۃَ جَحْشٍ ، وَکَانَتْ مُسْتَحَاضَۃً تَخْرُجُ مِنَ الْمِرْکَنِ وَالدَّمُ غَالِبُہُ ، ثُمَّ تُصَلِّی۔","","Musannaf Ibn Abi Shaybah 1378","","","كتاب الطهارة"
"1379","(۱۳۷۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنِ الْحَسَنِ ، قَالَ : تَغْتَسِلُ مِنْ صَلاَۃِ الظُّہْرِ إلَی مِثْلِہَا مِنَ الْغَدِ۔","","Musannaf Ibn Abi Shaybah 1379","","","كتاب الطهارة"
"1380","(۱۳۸۰) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ صَنَعَ ہَذِہِ الْمَطْہَرَۃَ ، وَقَدْ عَلِمَ أَنَّہُ یَتَوَضَّأُ مِنْہَا الأَسْوَدُ وَالأَبْیَضُ ، قَالَ : وَکَانَ یَنْسَکِبُ مِنْ وُضُوئِ النَّاسِ فِی جَوْفِہَا ، فَسَأَلْت عَطَائً ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 1380","","","كتاب الطهارة"
"1381","(۱۳۸۱) حَدَّثَنَا وَکِیعُ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ الْبَرَائَ بْنَ عازِبٍ بَالَ ، ثُمَّ جَائَ إلَی مَطْہَرَۃِ الْمَسْجِدِ فَتَوَضَّأَ مِنْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 1381","","","كتاب الطهارة"
"1382","(۱۳۸۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عِیسَی بْنِ الْمُغِیرَۃِ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الْمَطْہَرَۃِ الَّتِی یُدْخِلُ النَّاسُ أَیْدِیَہُمْ فِیہَا ؟ فَقَالَ : الْمَائُ لاَ یُنَجِّسُہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 1382","","","كتاب الطهارة"
"1383","(۱۳۸۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، قَالَ : کَانَ مُجَاہِدٌ یَتَوَضَّأُ مِنْ وُضُوئِ النَّاسِ۔","","Musannaf Ibn Abi Shaybah 1383","","","كتاب الطهارة"
"1384","(۱۳۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عِصْمَۃَ بْنِ زَامِلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ تَوَضَّأَ مِنَ الْمَطْہَرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 1384","","","كتاب الطهارة"
"1385","(۱۳۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُزَاحِمٍ ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : أَکُوزُ عَجُوزٍ مُخَمَّرٌ أَحَبُّ إلَیْک أَنْ أَتَوَضَّأَ مِنْہُ ، أَوِ الْمَطْہَرَۃُ الَّتِی یُدْخِلُ فِیہَا الْجَزَّارُ یَدَہُ ؟ قَالَ : مِنَ الْمَطْہَرَۃِ الَّتِی یُدْخِلُ الْجَزَّارُ فِیہَا یَدَہُ۔","","Musannaf Ibn Abi Shaybah 1385","","","كتاب الطهارة"
"1386","(۱۳۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ صَالِحٍ ، عَنْ سَعِیدِ بْنِ عَبْدِ اللہِ بْنِ ضِرَارٍ ، عَنْ أَبِیہِ ، قَالَ : إنِّی لاَتَوَضَّأُ مِنَ الْمِیضَأَۃِ الَّتِی فِی السُّوقِ إذْ جَائَ عَبْدُ اللہِ ، فَقَالَ : یَا ہَذَا ، أَیْنَ ہَوَاک الْیَوْمَ ؟ قَالَ : قُلْتُ : بِالشَّامِ۔","Da'if","Musannaf Ibn Abi Shaybah 1386","","","كتاب الطهارة"
"1387","(۱۳۸۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : رَأَیْتُ رَجُلاً یَتَوَضَّأُ فِی ذَلِکَ الْحَوْضِ مُنْکَشِفًا ؟ فَقَالَ : لاَ بَأْسَ بِہِ ، قَدْ جَعَلَہُ ابْنُ عَبَّاسٍ ، وَقَدْ عَلِمَ أَنَّہُ یَتَوَضَّأُ مِنْہُ الأَبْیَضُ وَالأَسْوَدُ۔","Sahih","Musannaf Ibn Abi Shaybah 1387","","","كتاب الطهارة"
"1388","(۱۳۸۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ اللہِ بْنِ الْمُغِیرَۃِ ، عَنْ بَعْضِ بَنِی مُدْلِجٍ ؛ أَنَّہُ سَأَلَ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یَا رَسُولَ اللہِ ، إنَّا نَرْکَبُ الأَرْمَاثَ فِی الْبَحْرِ لِلصَّیْدِ ، فَنَحْمِلُ مَعَنَا الْمَائَ لِلشَّفَۃِ ، فَإِذَا حَضَرَتِ الصَّلاَۃُ ، فَإِنْ تَوَضَّأَ أَحَدُنَا بِمَائِہِ عَطِشَ ، وَإِنْ تَوَضَّأَ بِمَائِ الْبَحْرِ وَجَدَ فِی نَفْسِہِ ؟ فَزَعَمَ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ہُوَ الطَّہُورُ مَاؤُہُ ، الْحَلاَلُ مَیْتَتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1388","","","كتاب الطهارة"
"1389","(۱۳۸۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ أَبِی الطُّفَیْلِ ، قَالَ : سُئِلَ أَبُو بَکْرٍ الصِّدِّیقُ ، أَیُتَوَضَّأُ مِنْ مَائِ الْبَحْرِ ؟ فَقَالَ : ہُوَ الطَّہُورُ مَاؤُہُ وَالْحَلاَلُ مَیْتَتُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1389","","","كتاب الطهارة"
"1390","(۱۳۹۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی یَزِیدَ الْمَدَنِیِّ ، قَالَ : حدَّثَنِی أَحَدُ الصَّیَّادِینَ ، قَالَ : لَمَّا قَدِمَ عُمَرُ أَمِیرُ الْمُؤْمِنِینَ الْجَارَ ، یَتَعَاہَدُ طَعَامَ الرِّزْقِ ، قَالَ : قُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ ؛ إنَّا نَرْکَبُ أَرْمَاثَنَا ہَذِہِ فَنَحْمِلُ مَعَنَا الْمَائَ لِلشَّفَۃِ ، فَیَزْعُمُ أُنَاسٌ أَنَّ مَائَ الْبَحْرِ لاَ یُطَہِّرُ ، فَقَالَ : وَأَیُّ مَائٍ أَطْہَرُ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 1390","","","كتاب الطهارة"
"1391","(۱۳۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ عُمَرَ سُئِلَ عَنْ مَائِ الْبَحْرِ ؟ فَقَالَ : وَأَیُّ مَائٍ أَنْظَفُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 1391","","","كتاب الطهارة"
"1392","(۱۳۹۲) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سِنَانِ بْنِ سَلَمَۃَ ؛ أَنَّہُ سَأَلَ ابْنَ عَبَّاسٍ عَنْ مَائِ الْبَحْرِ ؟ فَقَالَ : بَحْرَانِ لاَ یَضُرُّک مِنْ أَیِّہِمَا تَوَضَّأْت ؛ مَائُ الْبَحْرِ وَمَائُ الْفُرَاتِ۔","","Musannaf Ibn Abi Shaybah 1392","","","كتاب الطهارة"
"1393","(۱۳۹۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ لَیْثٍ ، عَنْ عَطائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : صَیْدُ الْبَحْرِ حَلاَلٌ ، وَمَاؤُہُ طَہُورٌ۔","Da'if","Musannaf Ibn Abi Shaybah 1393","","","كتاب الطهارة"
"1394","(۱۳۹۴) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ بَأْسَ بِالْوُضُوئِ مِنْ مَائِ الْبَحْرِ۔","","Musannaf Ibn Abi Shaybah 1394","","","كتاب الطهارة"
"1395","(۱۳۹۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِہِ ، ہُوَ طَہُورٌ۔","","Musannaf Ibn Abi Shaybah 1395","","","كتاب الطهارة"
"1396","(۱۳۹۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غَیَّاثٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ سُئِلَ عَنْ مَاء الْبَحْرِ ، یُتَوَضَّأُ مِنْہُ ؟ فَقَالَ : أَلَیْسَ نَأْکُلُ حِیتَانَہُ ؟۔","","Musannaf Ibn Abi Shaybah 1396","","","كتاب الطهارة"
"1397","(۱۳۹۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : مَائُ الْبَحْرِ أَذْہَبُ لِلْوَسَخِ مِنْ غَیْرِہِ ، وَکَانَ یَرَاہُ طَہُورًا۔","","Musannaf Ibn Abi Shaybah 1397","","","كتاب الطهارة"
"1398","(۱۳۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَائُ الْبَحْرِ یُجْزِیئُ ، وَالْعَذْبُ أَحَبُّ إلَیَّ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 1398","","","كتاب الطهارة"
"1399","(۱۳۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ ، عَنْ عَطَائٍ ، قَالَ : مَائُ الْبَحْرِ طَہُورٌ۔","","Musannaf Ibn Abi Shaybah 1399","","","كتاب الطهارة"
"1400","(۱۴۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : إذَا أُلْجِئْت إلَیْہِ فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1400","","","كتاب الطهارة"
"1401","(۱۴۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَمْرِو بْنِ سَعْدٍ الْجَارِی ، قَالَ : جَائَ عُمَرُ الْجَارَ فَدَعَا بِمَنَادِیلَ ، فَقَالَ : اغْتَسِلُوا مِنْ مَائِ الْبَحْرِ ، فَإِنَّہُ مُبَارَکٌ۔","Da'if","Musannaf Ibn Abi Shaybah 1401","","","كتاب الطهارة"
"1402","(۱۴۰۲) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ صَفْوَانَ بْنِ سُلَیْمٍ ، عَنْ سَعِیدِ بْنِ سَلَمَۃَ ، عَنِ الْمُغِیرَۃِ بْنِ أَبِی بُرْدَۃَ سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : الْبَحْرُ الطَّہُورُ مَاؤُہُ ، الْحَلاَلُ مَیْتَتُہُ۔ (ابوداؤد ۸۴۔ ترمذی ۶۹)","Sahih","Musannaf Ibn Abi Shaybah 1402","","","كتاب الطهارة"
"1403","(۱۴۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عُقْبَۃَ بْنِ صُہْبَانَ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : التَّیَمُّمُ أَحَبُّ إلَیَّ مِنَ الْوُضُوئِ مِنْ مَائِ الْبَحْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 1403","","","كتاب الطهارة"
"1404","(۱۴۰۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی أَیُّوبَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : مَائُ الْبَحْرِ لاَ یُجْزِیئُ مِنْ وُضُوئٍ ، وَلاَ جَنَابَۃٍ ، إنَّ تَحْتَ الْبَحْرِ نَارًا ، ثُمَّ مَائً ، ثُمَّ نَارًا۔","Sahih","Musannaf Ibn Abi Shaybah 1404","","","كتاب الطهارة"
"1405","(۱۴۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَائَانِ لاَ یُجْزِئَانِ مِنْ غُسْلِ الْجَنَابَۃِ ؛ مَائُ الْبَحْرِ وَمَائُ الْحَمَّامِ۔","Da'if","Musannaf Ibn Abi Shaybah 1405","","","كتاب الطهارة"
"1406","(۱۴۰۶) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی جَعْفَرٍ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّہُ رَکِبَ الْبَحْرَ ، فَنَفِدَ مَاؤُہُ ، فَتَوَضَّأَ بِنَبِیذٍ ، وَکَرِہَ أَنْ یَتَوَضَّأَ بِمَائِ الْبَحْرِ۔","","Musannaf Ibn Abi Shaybah 1406","","","كتاب الطهارة"
"1407","(۱۴۰۷) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ الدَّالاَنِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَالَ : لَیْسَ عَلَی مَنْ نَامَ سَاجِدًا وُضُوئٌ ، حَتَّی یَضْطَجِعَ ، فَإِذَا اضْطَجَعَ اسْتَرْخَتْ مَفَاصِلُہُ۔ (احمد ۱/۲۵۶۔ ابو یعلی ۲۴۸۷)","","Musannaf Ibn Abi Shaybah 1407","","","كتاب الطهارة"
"1408","(۱۴۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَخْفِقُونَ بِرُؤُوسِہِمْ یَنْتَظِرُونَ الْعِشَائَ ، ثُمَّ یَقُومُونَ فَیُصَلُّونَ ، وَلاَ یَتَوَضَّؤُونَ۔ (ابوداؤد ۲۰۲۔ ترمذی ۷۸)","Sahih","Musannaf Ibn Abi Shaybah 1408","","","كتاب الطهارة"
"1409","(۱۴۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَنْ نَامَ وَہُوَ جَالِسٌ فَلاَ وُضُوئَ عَلَیْہِ، فَإِنِ اضْطَجَعَ فَعَلَیْہِ الْوُضُوئُ۔","Hasan","Musannaf Ibn Abi Shaybah 1409","","","كتاب الطهارة"
"1410","(۱۴۱۰) حَدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَنَامُ فِی رُکُوعِہِ وَسُجُودِہِ ، ثُمَّ یُصَلِّی ، وَلاَ یَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 1410","","","كتاب الطهارة"
"1411","(۱۴۱۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ نَامَ فِی الْمَسْجِدِ حَتَّی نَفَخَ ، ثُمَّ قَامَ فَصَلَّی وَلَمْ یَتَوَضَّأْ ، وَقَالَ : النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَنَامُ عَیْنَاہُ ، وَلاَ یَنَامُ قَلْبُہُ۔","","Musannaf Ibn Abi Shaybah 1411","","","كتاب الطهارة"
"1412","(۱۴۱۲) حَدَّثَنَا حَفْصٌ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ لاَ یَرَی عَلَی مَنْ نَامَ قَاعِدًا وُضُوئًا۔","Sahih","Musannaf Ibn Abi Shaybah 1412","","","كتاب الطهارة"
"1413","(۱۴۱۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ شُرَحْبِیلَ بْنِ مُسْلِمٍ ، وَمُحَمَّدِ بْنِ زِیَادٍ الأَلْہَانِیِّ قَالاَ : کَانَ أَبُو أُمَامَۃَ یَنَامُ وَہُوَ جَالِسٌ حَتَّی یَمْتَلِئَ نَوْمًا ، ثُمَّ یَقُومَ فَیُصَلِّیْ وَلاَ یَتَوَضَّأُ۔","Sahih","Musannaf Ibn Abi Shaybah 1413","","","كتاب الطهارة"
"1414","(۱۴۱۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنِی مَالِکُ بْنُ أَنَسٍ ، قَالَ : أَخْبَرَنِی زَیْدُ بْنُ أَسْلَمَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ : مَنْ وَضَع جَنْبَہُ فَلْیَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 1414","","","كتاب الطهارة"
"1415","(۱۴۱۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ۔ وَابْنِ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُ عَبِیدَۃَ عَنْہُ ؟ فَقَالَ : ہُوَ أَعْلَمُ بِنَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 1415","","","كتاب الطهارة"
"1416","(۱۴۱۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَبْدُ الْمَلِکِ ، عَنْ عَطَائٍ ، أَنَّہُ قَالَ : مَنْ نَامَ سَاجِدًا ، أَوْ قَائِمًا ، أَوْ جَالِسًا فَلاَ وُضُوئَ عَلَیْہِ ، فَإِنْ نَامَ مُضْطَجِعًا فَعَلَیْہِ الْوُضُوئُ۔","","Musannaf Ibn Abi Shaybah 1416","","","كتاب الطهارة"
"1417","(۱۴۱۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 1417","","","كتاب الطهارة"
"1418","(۱۴۱۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالنَّوْمِ فِی الْقُعُودِ ، وَیَکْرَہُہُ فِی الاضْطِجَاعِ۔","","Musannaf Ibn Abi Shaybah 1418","","","كتاب الطهارة"
"1419","(۱۴۱۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یَخْفِقُ بِرَأْسِہِ ، ثُمَّ یَقُومُ فَیُصَلِّی۔","","Musannaf Ibn Abi Shaybah 1419","","","كتاب الطهارة"
"1420","(۱۴۲۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَنَامُ حَتَّی یَنْفُخَ ، ثُمَّ یَقُومَ فَیُصَلِّیَ وَلاَ یَتَوَضَّأُ۔ (ابن ماجہ ۴۷۴۔ ابن راھویہ ۱۴۹۰)","Sahih","Musannaf Ibn Abi Shaybah 1420","","","كتاب الطهارة"
"1421","(۱۴۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : ذَاکَرَتْہُ الْحَکَمَ وَحَمَّادًا فَقَالاَ : لَیْسَ عَلَیْہِ الْوُضُوئُ حَتَّی یَضَعَ جَنْبَہُ۔","","Musannaf Ibn Abi Shaybah 1421","","","كتاب الطهارة"
"1422","(۱۴۲۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا نَامَ الرَّجُلُ قَائِمًا ، أَوْ قَاعِدًا لَمْ یَجِبْ عَلَیْہِ الْوُضُوئُ ، فَإِذَا وَضَع جَنْبَہُ وَجَبَ عَلَیْہِ الْوُضُوئُ۔","","Musannaf Ibn Abi Shaybah 1422","","","كتاب الطهارة"
"1423","(۱۴۲۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : وَجَبَ الْوُضُوئُ عَلَی کُلِّ نَائِمٍ إِلاَّ مَنْ خَفَقَ بِرَأْسِہِ خَفْقَۃً ، أَوْ خَفْقَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 1423","","","كتاب الطهارة"
"1424","(۱۴۲۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدِ بْنِ یَزِیدَ ، عَنْ أَبِی نَضْرَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : زُرْت خَالَتِی مَیْمُونَۃَ فَوَافَقْت لَیْلَۃَ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَقَامَ مِنَ اللَّیْلِ یُصَلِّی ، ثُمَّ نَامَ فَلَقَدْ سَمِعْت صَفِیرَہُ ، قَالَ : ثُمَّ جَائَ بِلاَلٌ یُؤْذِنُہُ بِالصَّلاَۃِ فَخَرَجَ إلَی الصَّلاَۃِ وَلَمْ یَتَوَضَّأْ ، وَلَمْ یَمَسَّ مَائً۔","Sahih","Musannaf Ibn Abi Shaybah 1424","","","كتاب الطهارة"
"1425","(۱۴۲۵) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ مَنْصُورِ بْنِ أَبِی الأَسْوَدِ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَنَامُ وَہُوَ سَاجِدٌ ، فَمَا یُعْرَفُ نَوْمُہُ إِلاَّ بِنَفْخِہِ ، ثُمَّ یَقُومُ فَیَمْضِی فِی صَلاَتِہِ۔ (احمد ۱/۴۲۶۔ ابن ماجہ ۴۷۵)","","Musannaf Ibn Abi Shaybah 1425","","","كتاب الطهارة"
"1426","(۱۴۲۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ طَارِقٍ بَیَّاعِ النَّوَی ، قَالَ : حدَّثَتْنِی مَنِیعَۃُ ابْنَۃُ وَقَّاصٍ ، عَنْ أَبِیہَا ؛ أَنَّ أَبَا مُوسَی کَانَ یَنَامُ بَیْنَہُنَّ حَتَّی یَغُطَّ ، فَنُنَبِّہُہُ ، فَیَقُولُ : ہَلْ سَمِعْتُمُونِی أَحْدَثْتُ ؟ فَنَقُولُ : لاَ، فَیَقُومُ فَیُصَلِّی۔","Da'if","Musannaf Ibn Abi Shaybah 1426","","","كتاب الطهارة"
"1427","(۱۴۲۷) حَدَّثَنَا ہُشَیْمٌ ، وَابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیرِیِّ ، عَنْ خَالِدِ بْنِ غَلَّاقٍ العیشیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَنِ اسْتَحَقَّ نَوْمًا فَقَدْ وَجَبَ عَلَیْہِ الْوُضُوئُ ۔ زَادَ ابْنُ عُلَیَّۃَ : قَالَ الْجُرَیرِیُّ : فَسَأَلْنَا عَنِ اسْتِحْقَاقِ النَّوْمِ ؟ فَقَالوا: إذَا وَضَع جَنْبَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 1427","","","كتاب الطهارة"
"1428","(۱۴۲۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَنَامُ وَہُوَ جَالِسٌ ؟ قَالَ : إنَّمَا ہُوَ وِکَائٌ ، فَإِذَا ضَیَّعْتُہُ ۔ أَیْ : یَقُولُ : یَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 1428","","","كتاب الطهارة"
"1429","(۱۴۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ الْوَلِیدِ الشَّنِّیِّ ، عَنْ عِکْرِمَۃَ ، قَالَ : إنَّمَا ہُوَ وِکَائٌ فَإِذَا نَامَ تَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1429","","","كتاب الطهارة"
"1430","(۱۴۳۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَرَی عَلَی مَنْ نَامَ جَالِسًا وُضُوئً ا۔","","Musannaf Ibn Abi Shaybah 1430","","","كتاب الطهارة"
"1431","(۱۴۳۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، وَعَمْرٍو ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : مَنْ دَخَلَہُ النَّوْمُ فَلْیَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 1431","","","كتاب الطهارة"
"1432","(۱۴۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ قَالاَ : إذَا خَالَطَ النَّوْمُ قَلْبَہُ قَائِمًا ، أَوْ جَالِسًا تَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1432","","","كتاب الطهارة"
"1433","(۱۴۳۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنِی مَالِکُ بْنُ أَنَسٍ ، قَالَ : أَخْبَرَنِی زَیْدُ بْنُ أَسْلَمَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ : مَنْ وَضَع جَنْبَہُ فَلْیَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 1433","","","كتاب الطهارة"
"1434","(۱۴۳۴) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبَانُ الْعَطَّارُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، قَالَ : إذَا اسْتَثْقَلَ نَوْمًا وَہُوَ قَاعِدٌ تَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1434","","","كتاب الطهارة"
"1435","(۱۴۳۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْحَارِثِ بْنِ سُوَیْد ، قَالَ : قَالَ عَبْدُ اللہِ : لأَنْ أَتَوَضَّأَ مِنْ کَلِمَۃٍ خَبِیثَۃٍ ، أَحَبُّ إلَیَّ مِنْ أَنْ أَتَوَضَّأَ مِنْ طَعَامٍ طَیِّبٍ۔","Sahih","Musannaf Ibn Abi Shaybah 1435","","","كتاب الطهارة"
"1436","(۱۴۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَنْ ذَکْوَانَ أَبِی صَالِحٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : یَتَوَضَّأُ أَحَدُکُمْ مِنَ الطَّعَامِ الطَّیِّبِ ، وَلاَ یَتَوَضَّأُ مِنَ الْکَلِمَۃِ الْخَبِیثَۃِ ، یَقُولُہَا لِأَخِیہِ۔","Hasan","Musannaf Ibn Abi Shaybah 1436","","","كتاب الطهارة"
"1437","(۱۴۳۷) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : نُبِّئْت أَنَّ شَیْخًا مِنَ الأَنْصَارِ کَانَ یَمُرُّ بِمَجْلِسٍ لَہُمْ فَیَقُولُ : أَعِیدُوا الْوُضُوئَ ، فَإِنَّ بَعْضَ مَا تَقُولُونَ أَشَرُّ مِنَ الْحَدَثِ۔","","Musannaf Ibn Abi Shaybah 1437","","","كتاب الطهارة"
"1438","(۱۴۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ قُلْتُ لِعَبِیدَۃَ : مِمَّا یُعَادُ الْوُضُوئُ ؟ قَالَ : مِنَ الْحَدَثِ ، وَأَذَی الْمُسْلِمِ۔","","Musannaf Ibn Abi Shaybah 1438","","","كتاب الطهارة"
"1439","(۱۴۳۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنِ الْحَارِثِ ، قَالَ : کُنْتُ آخذًا بِیَدِ إبْرَاہِیمَ فَذَکَرْت رَجُلاً فَاغْتَبْتُہُ ، قَالَ : فَقَالَ لِی : ارْجِعْ فَتَوَضَّأْ ، کَانُوا یَعُدُّونَ ہَذَا ہُجْرًا۔","","Musannaf Ibn Abi Shaybah 1439","","","كتاب الطهارة"
"1440","(۱۴۴۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُوسَی بْنِ أَبِی الْفُرَاتِ ، قَالَ : سَأَلَ رَجُلاَنِ عَطَائً فَقَالَ : مَرَّ بِنَا رَجُلٌ فَقُلْنَا : الْمُخَنَّثُ ، قَالَ : قُلْتُمَا لَہُ قَبْلَ أَنْ تُصَلَّیَا ، أَوْ بَعْدَ مَا صَلَّیْتُمَا ؟ فَقَالاَ : قَبْلَ أَنْ نُصَلِّیَ ، فَقَالَ : تَوَضَّآ ، وَعُودَا لِصَلاَتِکُمَا ، فَإِنَّکُمَا لَمْ تَکُنْ لَکُمَا صَلاَۃٌ۔","","Musannaf Ibn Abi Shaybah 1440","","","كتاب الطهارة"
"1441","(۱۴۴۱) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ؛ أَنَّ أَبَا صَالِحٍ انْتَشَدَ شِعْرًا فِیہِ ہِجَائٌ ، فَدَعَا بِمَائٍ فَتَمَضْمَضَ۔","","Musannaf Ibn Abi Shaybah 1441","","","كتاب الطهارة"
"1442","(۱۴۴۲) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ فِی شَیْئٍ مِنَ الْکَلاَمِ وُضُوئٌ ؛ شِعْرٌ وَ غَیْرُہُ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 1442","","","كتاب الطهارة"
"1443","(۱۴۴۳) حَدَّثَنَا الْفَضْلُ ، عَنْ أَبِی خَلْدَۃَ ، عَنْ أَبِی الْعَالِیَۃِ ، قَالَ : لَیْسَ فِی الْکَلاَمِ وَالسِّبَابِ وَالصَّخَبِ وُضُوئٌ۔","","Musannaf Ibn Abi Shaybah 1443","","","كتاب الطهارة"
"1444","(۱۴۴۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ فِی الْکَسْرِ إذْ جُبِرَ عَلَی طَہَارَۃٍ : یمسح بَعْدَ ذَلِکَ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 1444","","","كتاب الطهارة"
"1445","(۱۴۴۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ یَقُولُ فِی الْکَسْرِ إذَا جُبِرَ : یَمسح عَلَی الْجَبَائِرِ۔","","Musannaf Ibn Abi Shaybah 1445","","","كتاب الطهارة"
"1446","(۱۴۴۶) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ التَّیْمِیِّ ، قَالَ : سَأَلْتُ طَاوُوسًا عَنِ الْجُرْحِ یَکُون بِوَجْہِ الرَّجُلِ ، أَوْ بِبَعْضِ جَسَدِہِ عَلَیْہِ الدَّوَائُ أَوِ الْخِرْقَۃُ ؟ قَالَ : إِنْ خَشِیَ مَسَحَ عَلَی الْخِرْقَۃِ ، وَإِنْ لَمْ یَخْشَ نَزَعَ الْخِرْقَۃَ۔","","Musannaf Ibn Abi Shaybah 1446","","","كتاب الطهارة"
"1447","(۱۴۴۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ وَدَاوُد ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّہُ اشْتَکَی رِجْلَہُ فَعَصَبَہَا وَتَوَضَّأَ وَمَسَحَ عَلَیْہَا وَقَالَ : إِنَّہَا مَرِیضَۃٌ۔","","Musannaf Ibn Abi Shaybah 1447","","","كتاب الطهارة"
"1448","(۱۴۴۸) حَدَّثَنَا مُعَاذٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : کَانَ بِی جُرْحٌ مِنَ الطَّاعُونِ ، فَسَأَلْت أَبَا مِجْلَزٍ ، فَقَالَ : امْسَحْ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 1448","","","كتاب الطهارة"
"1449","(۱۴۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ یُوسُفَ بْنِ مَاہَکَ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ؛ فِی الرَّجُلِ یَکُونُ بِہِ الْجُرْحُ ، قَالَ : یَغْتَسِلُ وَیَغْسِلُ مَا حَوْلَہُ۔","","Musannaf Ibn Abi Shaybah 1449","","","كتاب الطهارة"
"1450","(۱۴۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : یَمْسَحُ مَا حَوْلَہُ۔","","Musannaf Ibn Abi Shaybah 1450","","","كتاب الطهارة"
"1451","(۱۴۵۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، وَالْحَسَنِ أَنَّہُمَا کَانَا یَقُولاَنِ : یَمْسَحُ عَلَی الْجَبَائِرِ۔","","Musannaf Ibn Abi Shaybah 1451","","","كتاب الطهارة"
"1452","(۱۴۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شُعْبَۃَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، قَالَ : أَصَابَنِی مَحْمَلٌ ہَاہُنَا ، وَوَضَعَ شُعْبَۃُ إصْبَعَہُ فِی أَصْلِ حَاجِبِہِ ، فَعَصَبْتُ عَلَیْہِ عِصَابًا ، فَسَأَلْت سَعِیدَ بْنَ جُبَیْرٍ أَمْسَحُ عَلَیْہِ ؟ فَقَالَ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 1452","","","كتاب الطهارة"
"1453","(۱۴۵۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ یُوسُفَ بْنِ مَاہَکَ ، قَالَ : نَزَلَ بِنَا ضَیْفٌ فَاحْتَلَمَ وَبِہِ جُرْحٌ ، فَأَتَیْنَا عُبَیْدَ بْنَ عُمَیْرٍ فَذَکَرنَا ذَلِکَ لَہُ ، فَقَالَ : یَغْسِلُ مَا حَوْلَہُ ، وَلاَ یُمِسَّہُ الْمَائَ۔","","Musannaf Ibn Abi Shaybah 1453","","","كتاب الطهارة"
"1454","(۱۴۵۴) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : إذَا کَانَ فِی الْیَدِ ، أَوِ الرِّجْلِ الْجُرْحُ فَخَشِیَ عَلَیْہِ صَاحِبُہُ إِنْ أَصَابَہُ الْمَائُ ، مَسَحَ عَلَی الْخِرْقَۃِ إذَا تَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1454","","","كتاب الطهارة"
"1455","(۱۴۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَمْسَحُ عَلَیْہِ ، فَإِنَّ اللَّہَ یَعْذِرُ بِالْعُذْرِ۔","","Musannaf Ibn Abi Shaybah 1455","","","كتاب الطهارة"
"1456","(۱۴۵۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : یَمْسَحُ الرَّجُلُ إذَا خَشِیَ عَلَی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 1456","","","كتاب الطهارة"
"1457","(۱۴۵۷) حَدَّثَنَا مُعْتَمِرُ بْنُ عِمْرَانَ ، عَنْ أَبِی مِجْلَزٍ ، أَنَّہُ قَالَ : یَمْسَحُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 1457","","","كتاب الطهارة"
"1458","(۱۴۵۸) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا ہِشَامُ بْنُ الْغَازِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : مَنْ کَانَ بِہِ جُرْحٌ مَعْصُوبٌ فَخَشِیَ عَلَیْہِ الْعَنَتَ ، فَلْیَمْسَحْ مَا حَوْلَہُ ، وَلاَ یَغْسِلْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1458","","","كتاب الطهارة"
"1459","(۱۴۵۹) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبْجَرَ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَمْسَحُ عَلَی الْعِرْقِ۔","","Musannaf Ibn Abi Shaybah 1459","","","كتاب الطهارة"
"1460","(۱۴۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ الْعَیْزَارِ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، قَالَ : رَأَی عُمَرُ بْنُ الْخَطَّابِ رَجُلاً حَکَّ إبْطَہُ ، أَوْ مَسَّہُ ، فَقَالَ لَہُ : قمْ فَاغْسِلْ یَدَک ، أَوْ تَطَہَّرْ۔","","Musannaf Ibn Abi Shaybah 1460","","","كتاب الطهارة"
"1461","(۱۴۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : مَنْ نَقَّی أَنْفَہُ ، أَوْ مَسَّ إبْطَہُ تَوَضَّأَ۔","Da'if","Musannaf Ibn Abi Shaybah 1461","","","كتاب الطهارة"
"1462","(۱۴۶۲) حَدَّثَنَا خَلفُ بْنُ خَلِیفَۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَیْسَ فِی نَتْفِ الإِبْطِ وُضُوئٌ۔","Da'if","Musannaf Ibn Abi Shaybah 1462","","","كتاب الطهارة"
"1463","(۱۴۶۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ یَمَسُّ أَنْفَہُ وَیَنْتِفُ إبْطَہُ ؟ فَلَمْ یَرَ بِہِ بَأْسًا ، إِلاَّ أَنْ یُدْمِیَہُ۔","","Musannaf Ibn Abi Shaybah 1463","","","كتاب الطهارة"
"1464","(۱۴۶۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : ہَؤُلاَئِ یَقُولُونَ : مَنْ مَسَّ إبْطَہُ أَعَادَ الْوُضُوئَ ، وَأَنَا أَقُولُ ذَلِکَ ، وَلاَ أَدْرِی مَا ہَذَا۔","","Musannaf Ibn Abi Shaybah 1464","","","كتاب الطهارة"
"1465","(۱۴۶۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنِ الأَعْمَشِ، عَنْ مُجَاہِدٍ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ؛ أَنَّہُ کَانَ یَغْتَسِلُ مِنْ نَتْفِ الإِبْطِ۔","","Musannaf Ibn Abi Shaybah 1465","","","كتاب الطهارة"
"1466","(۱۴۶۶) حَدَّثَنَا أَبُو خَالِدٍ ، وَلَیْسَ بِالأَحْمَرِ ، عَنْ ہِشَامٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَوْنِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ، وَالزُّہْرِیِّ قَالاَ : إذَا مَسَّ الرَّجُلُ إبْطَہُ أَعَادَ الْوُضُوئَ۔","","Musannaf Ibn Abi Shaybah 1466","","","كتاب الطهارة"
"1467","(۱۴۶۷) حَدَّثَنَا ہُشَیْمٌ أَخْبَرَنَا الْمُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا سَالَ الدَّمُ نُقِضَ الْوُضُوئُ۔","","Musannaf Ibn Abi Shaybah 1467","","","كتاب الطهارة"
"1468","(۱۴۶۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی الْوُضُوئَ مِنَ الدَّمِ إِلاَّ مَا کَانَ سَائِلاً۔","","Musannaf Ibn Abi Shaybah 1468","","","كتاب الطهارة"
"1469","(۱۴۶۹) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَخْرُجُ مِنْ یَدِہِ الدَّمُ ، وَلاَ یُجَاوِزُ الدَّمُ مَکَانَہُ ؟ قَالَ : یَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 1469","","","كتاب الطهارة"
"1470","(۱۴۷۰) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَنْ مَنْصُورٍ ؛ أَنَّہُ سَأَلَ إبْرَاہِیمَ عَنْ ذَلِکَ ؟ فَقَالَ : لاَ یَتَوَضَّأُ حَتَّی یَخْرُجَ۔","","Musannaf Ibn Abi Shaybah 1470","","","كتاب الطهارة"
"1471","(۱۴۷۱) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا بَرَزَ الدَّمُ مِنَ الأَنْفِ فَظَہَرَ ، فَفِیہِ الْوُضُوئُ۔","","Musannaf Ibn Abi Shaybah 1471","","","كتاب الطهارة"
"1472","(۱۴۷۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : الْوُضُوئُ وَاجِبٌ مِنْ کُلِّ دَمٍ قَاطِرٍ۔n قَالَ : وَسَمِعْت الْحَکَمَ یَقُولُ : مِنْ کُلِّ دَمٍ سَائِلٍ۔","","Musannaf Ibn Abi Shaybah 1472","","","كتاب الطهارة"
"1473","(۱۴۷۳) قَالَ أَبُو بَکْرٍ : سَمِعْت ابْنَ إدْرِیسَ یَقُولُ : سَمِعْت مَالِکَ بْنَ أَنَسٍ یَقُولُ : لَیْسَ الْوُضُوئُ إِلاَّ مِنَ السَّبِیلَیْنِ ؛ الْغَائِطِ وَالْبَوْلِ۔","","Musannaf Ibn Abi Shaybah 1473","","","كتاب الطهارة"
"1474","(۱۴۷۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ أَدْخَلَ أَصَابِعَہُ فِی أَنْفِہِ فَخَرَجَ دَمٌ فَمَسَحَہُ فَصَلَّی ، وَلَمْ یَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 1474","","","كتاب الطهارة"
"1475","(۱۴۷۵) حَدَّثَنَا شَرِیکٌ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بِالْقَطْرَۃِ وَالْقَطْرَتَیْنِ مِنَ الدَّمِ فِی الصَّلاَۃِ بَأْسًا۔","Hasan","Musannaf Ibn Abi Shaybah 1475","","","كتاب الطهارة"
"1476","(۱۴۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالشِّقَاقِ یَخْرُجُ مِنْہُ الدَّمُ۔","","Musannaf Ibn Abi Shaybah 1476","","","كتاب الطهارة"
"1477","(۱۴۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالدَّمِ إذَا خَرَجَ مِنْ أَنْفِ الرَّجُلِ ، إِنِ اسْتَطَاعَ أَنْ یَفْتِلَہُ بِإِصْبَعِہِ إِلاَّ أَنْ یَسِیلَ ، أَوْ یَقْطُرَ۔","","Musannaf Ibn Abi Shaybah 1477","","","كتاب الطهارة"
"1478","(۱۴۷۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنِ التَّیْمِیِّ ، عَنْ بَکْرٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ عَصَرَ بَثْرَۃً فِی وَجْہِہِ فَخَرَجَ شَیْئٌ مِنْ دَمٍ ، فَحَکَّہُ بَیْنَ إصْبَعَیْہِ ، ثُمَّ صَلَّی وَلَمْ یَتَوَضَّأْ۔","Sahih","Musannaf Ibn Abi Shaybah 1478","","","كتاب الطهارة"
"1479","(۱۴۷۹) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَانَ لاَ یَرَی فِی الدَّمِ السَّائِلِ وُضُوئًا یَغْسِلُ مِنْہُ الدَّمَ ، ثُمَّ حَسْبُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 1479","","","كتاب الطهارة"
"1480","(۱۴۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْعَلاَئِ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، فَقُلْتُ : إنِّی أَتَوَضَّأُ وَآخُذُ الدَّلْوَ فَأَسْتَسْقِی بِہِ فَیَخْدِشُنِی الْحَبْلُ ، أَوْ یُصِیبُنِی الْخَدْشُ فَیَخْرُجُ مِنْہُ الدَّمُ ؟ قَالَ : اغْسِلْہُ وَلاَ تَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 1480","","","كتاب الطهارة"
"1481","(۱۴۸۱) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ غَیْلاَنَ بْنِ جَامِعٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : أَنْبَأَنَا مَنْ رَأَی أَبَا ہُرَیْرَۃَ یُدْخِلُ أَصَابِعَہُ فِی أَنْفِہِ ، فَیَخْرُجُ عَلَیْہَا الدَّمُ ، فَیَحُتُّہُ ثُمَّ یَقُومُ فَیُصَلِّی۔","Da'if","Musannaf Ibn Abi Shaybah 1481","","","كتاب الطهارة"
"1482","(۱۴۸۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ حَبِیبِ بْنِ أَبِی ثَابِتٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّہُ أَدْخَلَ إصْبَعَہُ فِی أَنْفِہِ فَخَرَجَ عَلَیْہَا دَمٌ فَمَسَحَہُ بِالأَرْضِ ، أَوْ بِالتُّرَابِ ثُمَّ صَلَّی۔","","Musannaf Ibn Abi Shaybah 1482","","","كتاب الطهارة"
"1483","(۱۴۸۳) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : رَأَیْتُ أَبَا سَوَّارٍ الْعَدَوِیَّ عَصَرَ بَثْرَۃً ، ثُمَّ صَلَّی وَلَمْ یَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 1483","","","كتاب الطهارة"
"1484","(۱۴۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَقُولُ لِبَنِیہِ : لاَ تَوَضَّؤُوا مِنَ الدُّمَّلِ إِلاَّ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 1484","","","كتاب الطهارة"
"1485","(۱۴۸۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ سَیْفٍ ، قَالَ : کَانَ بِمُجَاہِدٍ قَرْحَۃٌ تَمْصُلُ ، فَکَانَ لاَ یَتَوَضَّأُ ، وَیُصِیبُ ثَوْبَہُ فَلاَ یَغْسِلُہُ۔","","Musannaf Ibn Abi Shaybah 1485","","","كتاب الطهارة"
"1486","(۱۴۸۶) حَدَّثَنَا جَرِیرٌ ، عَنِ الْقَعْقَاعِ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : رَجُلٌ بِہِ دَمَامِیلُ کَثِیرَۃٌ فَلاَ تَزَالُ تَسِیلُ ؟ قَالَ : یَغْسِلُ مَکَانہَا وَیَتَوَضَّأُ وَیُبَادِرُ فَیُصَلِّی۔","","Musannaf Ibn Abi Shaybah 1486","","","كتاب الطهارة"
"1487","(۱۴۸۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ بِہِ النَّاصُورُ ؟ فَقَالَ : یُصَلِّی وَإِنْ سَالَ مِنْ قَرْنِہِ إلَی قَدَمِہِ۔","","Musannaf Ibn Abi Shaybah 1487","","","كتاب الطهارة"
"1488","(۱۴۸۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدِ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُصَلِّی وَفِی ثَوْبِہِ الْحُبُونُ، قَالَ : لاَ یَغْسِلُہُ حَتَّی یَبْرَأَ ، فَإِذَا بَرَأَ غَسَلَ ثَوْبَہُ ۔ قَالَ : وَقَدْ رَأَیْت إبْرَاہِیمَ یُصَلِّی وَفِی ثَوْبِہِ صَدِیدٌ مِنْ حُبُونٍ کَانَتْ بِہِ۔","","Musannaf Ibn Abi Shaybah 1488","","","كتاب الطهارة"
"1489","(۱۴۸۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أُمَیٍّ ، قَالَ : رَأَیْتُ طَاوُوسًا یُصَلِّی وَکَأَنَّ ثَوْبَہُ نِطْع مِنْ قُرُوحٍ کَانَتْ بِسَاقَیْہِ۔","","Musannaf Ibn Abi Shaybah 1489","","","كتاب الطهارة"
"1490","(۱۴۹۰) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : یَتَوَضَّأُ۔","Da'if","Musannaf Ibn Abi Shaybah 1490","","","كتاب الطهارة"
"1491","(۱۴۹۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنْ حَیَّانَ الْجَوْفِی ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَتَوَضَّأُ۔","Sahih","Musannaf Ibn Abi Shaybah 1491","","","كتاب الطهارة"
"1492","(۱۴۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نُبَاتَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 1492","","","كتاب الطهارة"
"1493","(۱۴۹۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنِ الزُّہْرِیِّ ؛ فِی الْمَرْأَۃِ وَالرَّجُلِ یَخْرُجُ مِنْہُمَا الشَّیئُ بَعْدَ مَا یَغْتَسِلاَنِ ، قَالَ : یَغْسِلاَنِ فَرْجَہُمَا وَیَتَوَضَّآنِ۔","","Musannaf Ibn Abi Shaybah 1493","","","كتاب الطهارة"
"1494","(۱۴۹۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ وَغَیْرِہِ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَغْتَسِلُ مِنَ الْجَنَابَۃِ ، ثُمَّ یَخْرُجُ مِنْ ذَکَرِہِ شَیْئٌ مِنَ الْمَنِیِّ ، قَالَ : إِنْ کَانَ بَالَ قَبْلَ أَنْ یَغْتَسِلَ فَلاَ یُعِیدُ الْغُسْلَ ، وَإِنْ کَانَ لَمْ یَبُلْ فَلیعِد الْغُسْلَ۔","","Musannaf Ibn Abi Shaybah 1494","","","كتاب الطهارة"
"1495","(۱۴۹۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الرَّجُلِ یَغْتَسِلُ مِنَ الْجَنَابَۃِ ، فَیَخْرُجُ مِنْ ذَکَرِہِ الشَّیئُ ؟ فَقَالاَ : یَغْسِلُ ذَکَرَہُ۔","","Musannaf Ibn Abi Shaybah 1495","","","كتاب الطهارة"
"1496","(۱۴۹۶) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ فِی الْمَرْأَۃِ یَخْرُجُ مِنْہَا الشَّیئُ مِنْ مَائِ الرَّجُلِ بَعْدَ الْغُسْلِ ، قَالَ : عَلَیْہَا الْوُضُوئُ۔","","Musannaf Ibn Abi Shaybah 1496","","","كتاب الطهارة"
"1497","(۱۴۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنْ حَمَّادٍ ، عَنْ رِبْعِیِّ بْنِ حِرَاشٍ ، قَالَ : قَالَ سَلْمَانُ : إذَا أَحَکَّ أَحَدُکُمْ جِلْدَہُ ، فَلاَ یَمْسَحْہُ بِبُزَاقِہِ ، فَإِنَّ الْبُزَاقَ لَیْسَ بِطَاہِرٍ۔","Hasan","Musannaf Ibn Abi Shaybah 1497","","","كتاب الطهارة"
"1498","(۱۴۹۸) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، قَالَ : قِیلَ لَہُ : ہَلْ کَانَ إبْرَاہِیمُ یَکْرَہُ الْبُزَاقَ ؟ قَالَ : إنَّمَا کَانَ یَکْرَہُ أَنْ یَحُکَّ الرَّجُلُ جِلْدَہُ ، ثُمَّ یُتْبِعَہُ بِرِیقِہِ ، فَإِنَّ ذَلِکَ لَیْسَ بِطَہُورٍ۔","","Musannaf Ibn Abi Shaybah 1498","","","كتاب الطهارة"
"1499","(۱۴۹۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ یَکْرَہُ أَنْ یُجْعَلَ الْبُزَاقُ عَلَی الْقُرْحَۃِ تَکُونُ بِہِ۔","","Musannaf Ibn Abi Shaybah 1499","","","كتاب الطهارة"
"1500","(۱۵۰۰) حَدَّثَنَا زَاجِرُ بْنُ الصَّلْتِ ، عَنِ الْحَارِثِ بْنِ مَالِکٍ ، قَالَ : انْطَلَقْتُ إلَی مَنْزِلِ الْحَسَنِ وَجَائَہُ رَجُلٌ فَسَأَلَہُ، فَقَالَ : یَا أَبَا سَعِیدٍ : الرَّجُلُ یَحُکُّ إمَّا جَسَدَہُ ، وَإِمَّا ذِرَاعَیْہِ ، ثُمَّ یَقُولُ بِرِیقِہِ عَلَیْہِ ، فَیَمْسَحُہُ عَلَیْہِ ، یَتَوَضَّأُ مِنْہُ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 1500","","","كتاب الطهارة"
"1501","(۱۵۰۱) حَدَّثَنَا سَعِیدُ بْنُ یَحْیَی الْحِمْیَرِیُّ ، قَالَ : حدَّثَنَا أَبُو الْعَلاَئِ ، قَالَ : کُنَّا عِنْدَ قَتَادَۃَ فَتَذَاکَرُوا عِنْدَہُ قَوْلَ إبْرَاہِیمَ وَقَوْلَ الْکُوْفِیینَ فِی الْبُزَاقِ : یُغْسَلُ ، قَالَ : فَحَکَّ قَتَادَۃُ سَاقَہُ ، ثُمَّ أَخَذَ مِنْ رِیقِہِ شَیْئًا ، ثُمَّ أَمَرَّہُ عَلَیْہِ لِیُرِیَنَا أَنَّہُ لَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 1501","","","كتاب الطهارة"
"1502","(۱۵۰۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَبِی ہَارُونَ الْغَنَوِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : قَالَ ابْنُ عُمَرَ : إذَا اغْتَسَلَ أَحَدُکُمْ مِنَ الْجَنَابَۃِ فَبَالَ قَبْلَ أَنْ یَفْرُغَ مِنْ غُسْلِہِ فَلْیُفْرِغْ عَلَی رَأْسِہِ الْمَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 1502","","","كتاب الطهارة"
"1503","(۱۵۰۳) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ أَبِی ہَارُونَ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : یُعِیدُ ، یَعْنِی : الْغُسْلَ۔","Sahih","Musannaf Ibn Abi Shaybah 1503","","","كتاب الطهارة"
"1504","(۱۵۰۴) حَدَّثَنَا وَکِیعٌ، عَنْ حَمَّادِ بْنِ زَیْدٍ، عَنْ یَحْیَی بْنِ عَتِیقٍ، عَنِ ابْنِ سِیرِینَ، قَالَ: لاَ یَعُودُ إلَی غُسْلٍ مُؤْتَنَفٍ۔","","Musannaf Ibn Abi Shaybah 1504","","","كتاب الطهارة"
"1505","(۱۵۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثِ بْنِ أَبِی سُلَیْمٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ قَالَ فِی الْجُنُبِ یَنْتَہِی إلَی الْبِئْرِ وَلَیْسَ مَعَہُ إنَائٌ، قَالَ : یُدْلِی ثَوْبَہُ فِی الْبِئْرِ ، ثُمَّ یَعْصِرُہُ عَلَی جَسَدِہِ۔","","Musannaf Ibn Abi Shaybah 1505","","","كتاب الطهارة"
"1506","(۱۵۰۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ الْجُنُبِ یَنْتَہِی إلَی الْغَدِیرِ ؟ قَالَ : یَغْتَسِلُ فِی نَاحِیَۃٍ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 1506","","","كتاب الطهارة"
"1507","(۱۵۰۷) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا نَسْتَحِبُّ أَنْ نَأْخُذَ مِنْ مَائِ الْغَدِیرِ وَنَغْتَسِلَ بِہِ فِی نَاحِیَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 1507","","","كتاب الطهارة"
"1508","(۱۵۰۸) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَنْ یُبَالَ فِی الْمَائِ الرَّاکِدِ۔ (مسلم ۹۴۔ نسائی ۳۵)","Da'if","Musannaf Ibn Abi Shaybah 1508","","","كتاب الطهارة"
"1509","(۱۵۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لاَ یَبُلْ أَحَدُکُمْ فِی الْمَائِ الدَّائِمِ ، ثُمَّ یَغْتَسِلْ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 1509","","","كتاب الطهارة"
"1510","(۱۵۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنُ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لاَ یَبُلْ أَحَدُکُمْ فِی الْمَائِ الدَّائِمِ ، ثُمَّ یَتَطَہَّرْ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1510","","","كتاب الطهارة"
"1511","(۱۵۱۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : لاَ یَبُلْ أَحَدُکُمْ فِی الْمَائِ الدَّائِمِ ، وَلاَ یَغْتَسِلْ فِیہِ مِنْ جَنَابَۃٍ۔ (ابوداؤد ۷۱۔ احمد ۲/۴۳۳)","Hasan","Musannaf Ibn Abi Shaybah 1511","","","كتاب الطهارة"
"1512","(۱۵۱۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا مُعَاوِیَۃُ بْنُ صَالِحٍ ، قَالَ : أَخْبَرَنِی أَبُو مَرْیَمَ ، عْن أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ یَبُلْ أَحَدُکُمْ فِی الْمَائِ الرَّاکِدِ ، ثُمَّ یَتَوَضَّأُ مِنْہُ۔ (احمد ۵۳۲)","Sahih","Musannaf Ibn Abi Shaybah 1512","","","كتاب الطهارة"
"1513","(۱۵۱۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ رَافِعِ بْنِ خَدِیجٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ قِیلَ : یَا رَسُولَ اللہِ ، أَنَتَوَضَّأُ مِنْ بِئْرِ بُضَاعَۃَ ، قَالَ : وَہِیَ بِئْرٌ یُلْقَی فِیہَا الْحِیَضُ وَلَحْمُ الْکِلاَبِ وَالنَّتِنُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إنَّ الْمَائَ طَہُورٌ لاَ یُنَجِّسُہُ شَیْئٌ۔ (ابوداؤد ۶۸۔ ترمذی ۶۶)","Da'if","Musannaf Ibn Abi Shaybah 1513","","","كتاب الطهارة"
"1514","(۱۵۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ الأَعْرَابِیِّ ، قَالَ : حدَّثَنَا فِی مَجْلِسِ الأَشْیَاخِ قَبْلَ وَقْعَۃِ ابْنِ الأَشْعَثِ شَیْخٌ ، فَکَانَ یَقُصُّ عَلَیْنَا ، قَالَ : بَلَغَنِی أَنَّ أَصْحَابَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانُوا فِی مَسِیرٍ لَہُمْ فَانْتَہَوْا إلَی غَدِیرٍ فِی نَاحِیَۃٍ مِنْہُ جِیفَۃٌ ، فَأَمْسَکُوا عَنْہُ حَتَّی أَتَاہُمْ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَقَالُوا : یَا رَسُولَ اللہِ ، ہَذِہِ الْجِیفَۃُ فِی نَاحِیَتِہِ ، فَقَالَ : اسْقُوا وَاسْتَقُوا ، فَإِنَّ الْمَائَ یُحِلُّ ، وَلاَ یُحَرِّمُ۔ (بیہقی ۲۵۸)","Da'if","Musannaf Ibn Abi Shaybah 1514","","","كتاب الطهارة"
"1515","(۱۵۱۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : مَرَّ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ بِغَدِیرٍ فَقَالُوا : یَا رَسُولَ اللہِ ، إنَّ الْکِلاَبَ تَلَغُ فِیہِ وَالسِّبَاعُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : لِلسَّبُعِ مَا أَخَذَ فِی بَطْنِہِ، وَلِلْکَلْبِ مَا أَخَذَ فِی بَطْنِہِ ، فَاشْرَبُوا وَتَوَضَّؤُوا۔ قَالَ : فَشَرَبُوا وَتَوَضَّؤُوا۔ (بیہقی ۲۵۸)","","Musannaf Ibn Abi Shaybah 1515","","","كتاب الطهارة"
"1516","(۱۵۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، عَنْ مَیْمُونِ بْنِ أَبِی شَبِیبٍ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ مَرَّ بِحَوْضٍ مِجَنَّۃٍ ، فَقَالَ : اسْقُونِی مِنْہُ ، فَقَالُوا : إِنَّہُ تَرِدُہُ السِّبَاعُ وَالْکِلاَبُ وَالْحَمِیرُ ، فَقَالَ : لَہَا مَا حَمَلَتْ فِی بُطُونِہَا : وَمَا بَقِیَ فَہُوَ لَنَا طَہُورٌ وَشَرَابٌ۔","","Musannaf Ibn Abi Shaybah 1516","","","كتاب الطهارة"
"1517","(۱۵۱۷) حَدَّثَنَا ہُشَیْمٌ ، قَال : أَخْبَرنَا حُصَیْنٌ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَتَی عَلَی حَوْضٍ مِنَ الْحِیَاضِ فَأَرَادَ أَنْ یَتَوَضَّأَ وَیَشْرَبَ ، فَقَالَ أَہْلُ الْحَوْضِ : إِنَّہُ تَلَغُ فِیہِ الْکِلاَبُ وَالسِّبَاعُ ، فَقَالَ عُمَرُ : إنَّ لَہَا مَا وَلَغَتْ فِی بُطُونِہَا ، قَالَ : فَشَرِبَ وَتَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1517","","","كتاب الطهارة"
"1518","(۱۵۱۸) حَدَّثَنَا سُفیان ابْنُ عُیَیْنَۃَ ، عَنْ مَنْبُوذٍ ، عَنْ أُمِّہِ ؛ أَنَّہَا کَانَتْ تُسَافِرُ مَعَ مَیْمُونَۃَ فَتَمُرُّ بِالْغَدِیرِ فِیہِ الْجِعْلاَنُ وَالْبَعْرُ فَیُسْتَقَی لَہَا مِنْہُ ، فَتَتَوَضَّأُ وَتَشْرَبُ۔","Da'if","Musannaf Ibn Abi Shaybah 1518","","","كتاب الطهارة"
"1519","(۱۵۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَبِیبِ بْنِ شِہَابٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ سَأَلَ أَبَا ہُرَیْرَۃَ عَنْ سُؤْرِ الْحَوْضِ تَرِدُہَا السِّبَاعُ وَیَشْرَبُ مِنْہُ الْحِمَارُ ؟ فَقَالَ : لاَ یُحَرِّمُ الْمَائَ شَیْئٌ۔","Sahih","Musannaf Ibn Abi Shaybah 1519","","","كتاب الطهارة"
"1520","(۱۵۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ إسْرَائِیلَ ، عَنِ الزِّبْرِقَانِ ، قَالَ : حدَّثَنَا کَعْبُ بْنُ عَبْدِ اللہِ ، قَالَ : کُنَّا مَعَ حُذَیْفَۃَ فَانْتَہَیْنَا إلَی غَدِیرٍ فِیہِ الْمَیْتَۃُ وَتَغْتَسِلُ فِیہِ الْحَائِضُ ، فَقَالَ : الْمَائُ لاَ یُجنبُ ۔","Da'if","Musannaf Ibn Abi Shaybah 1520","","","كتاب الطهارة"
"1521","(۱۵۲۱) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : الْمَائُ طَہُورٌ لاَ یُنَجِّسُہُ إِلاَّ النَّجِسُ ، یَعْنِی : الْمُشْرِکَ۔","","Musannaf Ibn Abi Shaybah 1521","","","كتاب الطهارة"
"1522","(۱۵۲۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْمَائُ لاَ یُجْنِب۔","","Musannaf Ibn Abi Shaybah 1522","","","كتاب الطهارة"
"1523","(۱۵۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ أَبِی الرَّبِیعِ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : الْمَائُ لاَ یُنَجِّسُہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 1523","","","كتاب الطهارة"
"1524","(۱۵۲۴) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ الْجُرَیرِیِّ ، عَمَّنْ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ : الْمَائُ لاَ یُنَجِّسُہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 1524","","","كتاب الطهارة"
"1525","(۱۵۲۵) حَدَّثَنَا یَزِیدُ بْنُ الْمِقْدَامِ ، عَنْ أَبِیہِ الْمِقْدَامِ ، عَنْ جَدِّہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : إِنَّہُ لَیْسَ یَکُونُ عَلَی الْمَائِ جَنَابَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 1525","","","كتاب الطهارة"
"1526","(۱۵۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : أَنْزَلَ اللَّہُ الْمَائَ طَہُورًا فَلاَ یُنَجِّسُہُ شَیْئٌ ، وَرُبَّمَا قَالَ : لاَ یُنَجِّسُہُ شَیْئٌ ،قَالَ دَاوُد : وَذَلِکَ أَنَّا سَأَلْنَاہُ عَنِ الْغُدْرَانِ وَالْحِیَاضِ تَلَغُ فِیہَا الْکِلاَبُ۔","","Musannaf Ibn Abi Shaybah 1526","","","كتاب الطهارة"
"1527","(۱۵۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِلْقَاسِمِ بْنِ مُحَمَّدٍ : الْغَدِیرُ نَأْتِیہِ وَقَدْ وَلَغَ فِیہِ الْکِلاَبُ وَشَرِبَ مِنْہُ الْحِمَارُ ، نَشْرَبُ مِنْہُ ؟ قَالَ ابْنُ عَوْنٍ : أَوْ قُلْتُ : نَتَوَضَّأُ مِنْہُ ؟ فَنَظَرَ إلَیَّ فَقَالَ : إذَا أَتَی أَحَدُکُمُ الْغَدِیرَ یَنْتَظِرُ حَتَّی یَسْأَلَ : أَیُّ کَلْبٍ وَلَغَ فِیہِ أَوْ أَیُّ حِمَارٍ شَرِبَ مِنْ ہَذَا ؟۔","","Musannaf Ibn Abi Shaybah 1527","","","كتاب الطهارة"
"1528","(۱۵۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، قَالَ : سُئِلَ الْحَسَنُ عَنِ الْحِیَاضِ الَّتِی تَکُونُ فِی طَرِیقِ مَکَّۃَ تَرِدُہَا الْحَمِیرُ وَالسِّبَاعُ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1528","","","كتاب الطهارة"
"1529","(۱۵۲۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : الْمَائُ طَہُورٌ لاَ یُنَجِّسُہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 1529","","","كتاب الطهارة"
"1530","(۱۵۳۰) حَدَّثَنَا وَکِیعٌ، عَنِ الأَعْمَشِ، عَنْ أَبِی عَمْرٍو الْبَہْرَانِیِّ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: الْمَائُ طَہُورٌ لاَ یُنَجِّسُہُ شَیْئٌ۔","Hasan","Musannaf Ibn Abi Shaybah 1530","","","كتاب الطهارة"
"1531","(۱۵۳۱) حَدَّثَنَا جَرِیرٌ ، عَنْ عِیسَی بْنِ الْمُغِیرَۃِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْمَائُ لاَ یَنْجُسُ۔","","Musannaf Ibn Abi Shaybah 1531","","","كتاب الطهارة"
"1532","(۱۵۳۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ رَبِّہِ ، عَنْ صَالِحٍ ؛ أَنَّ جَابِرَ بْنَ زَیْدِ ، قَالَ لِرَجُلٍ : صُبَّ عَلَیَّ ، وَہُوَ فِی الْحَمَّامِ ، قَالَ : إنِّی جُنُبٌ ، فَقَالَ : قُمْ فَاغْتَسِلْ فَإِنَّ الْمَائَ لاَ یُنَجِّسُہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 1532","","","كتاب الطهارة"
"1533","(۱۵۳۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَیْرِ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمَائِ یَکُونُ بِأَرْضِ الْفَلاَۃِ ، وَمَا یَنُوبُہُ مِنَ السِّبَاعِ وَالدَّوَابِّ ؟ فَقَالَ : إذَا کَانَ الْمَائُ قُلَّتَیْنِ لَمْ یَحْمِلِ الْخَبَثَ۔n(ابوداؤد ۶۵۔ ترمذی ۶۷)","Hasan","Musannaf Ibn Abi Shaybah 1533","","","كتاب الطهارة"
"1534","(۱۵۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ جَعْفَرِ بْنِ الزُّبَیْرِ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ ، أَوْ نَحْوَہُ۔ (ابن حبان ۱۲۴۹)","Hasan","Musannaf Ibn Abi Shaybah 1534","","","كتاب الطهارة"
"1535","(۱۵۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : إذَا کَانَ الْمَائُ أَرْبَعِینَ قُلَّۃً لَمْ یُنَجِّسْہُ شَیْئٌ۔","Sahih","Musannaf Ibn Abi Shaybah 1535","","","كتاب الطهارة"
"1536","(۱۵۳۶) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ ، عَنِ الْمُثَنَّی ، عَنْ سَلَمَۃَ بْنِ وَہْرَام ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا کَانَ الْمَائُ ذَنُوبَیْنِ لَمْ یُنَجِّسْہُ شَیْئٌ۔","Da'if","Musannaf Ibn Abi Shaybah 1536","","","كتاب الطهارة"
"1537","(۱۵۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَاصِمِ بْنِ الْمُنْذِرِ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا بَلَغَ الْمَائُ قُلَّتَیْنِ لَمْ یَحْمِلْ نَجِسًا ۔ أَوْ کَلِمَۃً نَحْوَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 1537","","","كتاب الطهارة"
"1538","(۱۵۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : إِذَا بَلَغَ الْمَائُ أَنْ یَکُونَ کُرًّا لَمْ یَحْمِلْ نَجَسًا۔","","Musannaf Ibn Abi Shaybah 1538","","","كتاب الطهارة"
"1539","(۱۵۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ یَزِیدَ ، عَنْ مَسْرُوقٍ ، قَالَ : إِذَا کَانَ الْمَائُ کُرًّا فَلاَ یُنْجِسُہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 1539","","","كتاب الطهارة"
"1540","(۱۵۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ابْنِ أَبِی الْفُرَاتِ ، عَنْ مُحَمَّدِ بْنِ زَید ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْمَائُ الرَّاکِدُ لاَ یُنَجِّسُہُ شَیْئٌ إذَا کَانَ قَدْرَ ثَلاَثِ قِلاَلٍ۔","","Musannaf Ibn Abi Shaybah 1540","","","كتاب الطهارة"
"1541","(۱۵۴۱) حَدَّثَنَا یَزِیدُ ، عَنْ أَبِی إِسْحَاقَ) ، عَنْ مُجَاہِدٍ ، قَالَ : إذَا کَانَ الْمَائُ قُلَّتَیْنِ لاَ یُنَجِّسُہُ شَیْئٌ ، قَالَ شَرِیکٌ : قُلْتُ لأَبِی إِسْحَاقَ : مَا یَعْنِی بِالْقُلَّتَیْنِ ؟ قَالَ : الْجَرَّتَیْنِ۔","","Musannaf Ibn Abi Shaybah 1541","","","كتاب الطهارة"
"1542","(۱۵۴۲) حَدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : إذَا کَانَ الْمَائُ کُرًّا لَمْ یُنَجِّسْہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 1542","","","كتاب الطهارة"
"1543","(۱۵۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، قَالَ : إذَا بَلَغَ الْمَائُ أَرْبَعِینَ قُلَّۃً لَمْ یُنَجِّسْہُ شَیْئٌ ۔ أَوْ کَلِمَۃً نَحْوَہَا۔","","Musannaf Ibn Abi Shaybah 1543","","","كتاب الطهارة"
"1544","(۱۵۴۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَمَسُّونَ الْحِنَّائَ بَعْدَ النُّورَۃِ ، وَکَانُوا یَکْرَہُونَ أَنْ یُؤَثِّرَ فِی الأَظْفَارِ۔","","Musannaf Ibn Abi Shaybah 1544","","","كتاب الطهارة"
"1545","(۱۵۴۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الْحِنَّائِ وَالْخَلُوقِ لِلرَّجُلِ بَعْدَ النُّورَۃِ ، قَالَ : أَمَّا الْحِنَّائُ فَلاَ بَأْسَ ، وَأَمَّا الْخَلُوقُ فَإِنِّی أَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 1545","","","كتاب الطهارة"
"1546","(۱۵۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ لِی عَلَی الْحَسَنِ بْنِ عَلِیٍّ دَیْنٌ ، فَأَتَیْتُہُ أَتَقَاضَاہُ فَوَجَدْتُہُ قَدْ خَرَجَ مِنَ الْحَمَّامِ وَقَدْ أَثَّرَ الْحِنَّائُ بِأَظَافِیرِہِ ، وَجَارِیَۃٌ تَحُکُّ عَنْہُ الْحِنَّائَ بِقَارُورَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 1546","","","كتاب الطهارة"
"1547","(۱۵۴۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَطْلُوا بِدُرْدِیِّ الْخَمْرِ بَعْدَ النُّورَۃِ۔","","Musannaf Ibn Abi Shaybah 1547","","","كتاب الطهارة"
"1548","(۱۵۴۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ ، عَنْ دُرْدِیِّ الْخَمْرِ ہَلْ یَصْلُحُ أَنْ یُتَدَلَّکَ بِہِ فِی الْحَمَّامِ ، أَوْ یُتَدَاوَی بِشَیْئٍ مِنْہُ فِی جِرَاحَۃٍ ، أَوْ سِوَاہَا ؟ قَالَ : ہُوَ رِجْسٌ ، وَأَمَرَ اللَّہُ تَعَالَی بِاجْتِنَابِہِ۔","","Musannaf Ibn Abi Shaybah 1548","","","كتاب الطهارة"
"1549","(۱۵۴۹) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ لَیْثٍ ، عَنْ یَحْیَی بْنِ عَبَّادٍ ، قَالَ : خَرَجَ أَبُو الدَّرْدَائِ مِنَ الْمَسْجِدِ فَبَالَ ، ثُمَّ دَخَلَ فَتحَدَّث مَعَ أَصْحَابِہِ ، وَلَمْ یَمَسَّ مَائً۔","Da'if","Musannaf Ibn Abi Shaybah 1549","","","كتاب الطهارة"
"1550","(۱۵۵۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ ہَذَا ، أَحْسَبُہُ قَبْلَ وَقْعَۃِ ابْنِ الأَشْعَثِ ، أَنَّ عَلِیًّا بَالَ ، ثُمَّ اجْتَازَ فِی الْمَسْجِدِ قَبْلَ أَنْ یَتَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1550","","","كتاب الطهارة"
"1551","(۱۵۵۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ بَأْسَ أَنْ تَدْخُلَ الْمَسْجِدَ عَلَی غَیْرِ وُضُوئٍ۔","","Musannaf Ibn Abi Shaybah 1551","","","كتاب الطهارة"
"1552","(۱۵۵۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ أَبُو السَّوَّارِ یَکْرَہُ أَنْ یَتَعَمَّدَ الرَّجُلُ أَنْ یَجْلِسَ فِی الْمَسْجِدِ عَلَی غَیْرِ وُضُوئٍ۔","","Musannaf Ibn Abi Shaybah 1552","","","كتاب الطهارة"
"1553","(۱۵۵۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِدٍ ؛ قَالَ : کَانَ أَبُو الضُّحَی یَبُولُ ، ثُمَّ یَدْخُلُ الْمَسْجِدَ الْجَامِعَ فَیُحَدِّثُنَا۔","","Musannaf Ibn Abi Shaybah 1553","","","كتاب الطهارة"
"1554","(۱۵۵۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ؛ أَنَّہُ کَانَ یَجِیئُ مِنَ الْحَدَثِ ، ثُمَّ یَجْلِسُ فِی الْمَسْجِدِ قَبْلَ أَنْ یَتَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1554","","","كتاب الطهارة"
"1555","(۱۵۵۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ؛ فِی الرَّجُلِ یُحْدِثُ قَالاَ : یَمُرُّ فِی الْمَسْجِدِ مَارًّا ، وَلاَ یَجْلِسُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 1555","","","كتاب الطهارة"
"1556","(۱۵۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ أَنْ یَجْلِسَ فِیہِ عَلَی غَیْرِ وُضُوئٍ۔","","Musannaf Ibn Abi Shaybah 1556","","","كتاب الطهارة"
"1557","(۱۵۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عَنِ الرَّجُلِ یَجْلِسُ فِی الْمَسْجِدِ عَلَی غَیْرِ وُضُوئٍ ؟ قَالَ: أَنَا السَّاعَۃَ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 1557","","","كتاب الطهارة"
"1558","(۱۵۵۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَعِیدٍ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ جَائَ مِنَ الْحَدَثِ فَجَلَسَ وَأَخْرَجَ رِجْلَیْہِ مِنَ الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 1558","","","كتاب الطهارة"
"1559","(۱۵۵۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخبرنَا النَّزَّالُ الْعَصَرِیُّ ، قَالَ : رَأَیْتُ خُلَیدًا أَبَا سُلَیْمَانَ بَالَ ، ثُمَّ دَخَلَ مَسْجِدَ بَنِی عَصَرٍ فَجَلَسَ۔","","Musannaf Ibn Abi Shaybah 1559","","","كتاب الطهارة"
"1560","(۱۵۶۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : کَانَ الْجُنُبُ یَمُرُّ فِی الْمَسْجِدِ مُجْتَازًا۔","Sahih","Musannaf Ibn Abi Shaybah 1560","","","كتاب الطهارة"
"1561","(۱۵۶۱) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ ؛ أَنَّ عَلِیًّا کَانَ یَمُرُّ فِی الْمَسْجِدِ وَہُوَ جُنُبٌ ، فَقَالَ لَہُ بَعْضُ أَصْحَابِنَا مِمَّنْ سَمِعْت ہَذَا ؟ ، قَالَ : سَمِعْتُہُ قَرِیبًا مِنْ خَمْسِینَ سَنَۃً۔","","Musannaf Ibn Abi Shaybah 1561","","","كتاب الطهارة"
"1562","(۱۵۶۲) حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : الْجُنُبُ یَمُرُّ فِی الْمَسْجِدِ ، وَلاَ یَجْلِسُ فِیہِ ، ثُمَّ قَرَأَ : {وَلاَ جُنُبًا إِلاَّ عَابِرِی سَبِیلٍ}۔","Hasan","Musannaf Ibn Abi Shaybah 1562","","","كتاب الطهارة"
"1563","(۱۵۶۳) حَدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعیدٍ ۔ وَعَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 1563","","","كتاب الطهارة"
"1564","(۱۵۶۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ {وَلاَ جُنُبًا إِلاَّ عَابِرِی سَبِیلٍ} قَالَ : لاَ یَمُرُّ الْجُنُبُ فِی الْمَسْجِدِ إِلاَّ أَنْ لاَ یَجِدَ طَرِیقًا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 1564","","","كتاب الطهارة"
"1565","(۱۵۶۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ ہِشَامٍ ، عَنِ الحسن ؛ قَالَ : الْجُنُبُ وَالْحَائِضُ یَمُرَّانِ فِی الْمَسْجِدِ ، وَلاَ یَمْکُثَانِ فِیہِ۔","","Musannaf Ibn Abi Shaybah 1565","","","كتاب الطهارة"
"1566","(۱۵۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ صَاحِبِ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : الْجُنُبُ یَجْتَازُ فِی الْمَسْجِدِ ، وَلاَ یَجْلِسُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 1566","","","كتاب الطهارة"
"1567","(۱۵۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، قَالَ : کَانَ الرَّجُلُ مِنْہُمْ یُجْنِبُ ، ثُمَّ یَتَوضأ ثُمَّ یَدْخُلُ الْمَسْجِدَ فَیَجِلس فِیہِ۔","","Musannaf Ibn Abi Shaybah 1567","","","كتاب الطهارة"
"1568","(۱۵۶۸) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی قولہ تعالی : {وَلاَ جُنُبًا إِلاَّ عَابِرِی سَبِیلٍ} قَالَ : الْجُنُبُ یَمُرُّ فِی الْمَسْجِدِ۔","","Musannaf Ibn Abi Shaybah 1568","","","كتاب الطهارة"
"1569","(۱۵۶۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ جَابِرٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ؛ قَالَ : لاَ یَمُرُّ الْجُنُبُ فِی الْمَسْجِدِ إِلاَّ أَنْ یُلْجَأَ إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 1569","","","كتاب الطهارة"
"1570","(۱۵۷۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ ، قَالَ : قُلْتُ لِلْحَسَنِ : تُصِیبُنِی الْجَنَابَۃُ فَأَسْتَطْرِقُ الْمَسْجِدَ ، وَآخُذُ مِنْ قِبَلِ دَارِ عَبْدِ اللہِ بْنِ عُمَیْرٍ ؟ قَالَ : بَلَ اسْتَطْرِقْ إذَا کَانَ أَقْرَبَ۔","","Musannaf Ibn Abi Shaybah 1570","","","كتاب الطهارة"
"1571","(۱۵۷۱) حَدَّثَنَا ہُشَیْمٌ ، وَابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ طَافَ عَلَی نِسَائِہِ فِی لَیْلَۃٍ بِغُسْلٍ وَاحِدٍ۔ (ابوداؤد ۲۲۰۔ ابن حبان ۱۲۰۶)","Sahih","Musannaf Ibn Abi Shaybah 1571","","","كتاب الطهارة"
"1572","(۱۵۷۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ ، عَنْ عَمَّتِہِ ، عَنْ أَبِی رَافِعٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ طَافَ عَلَی نِسَائِہِ فِی لَیْلَۃٍ ، فَاغْتَسَلَ عِنْدَ کُلِّ امْرَأَۃٍ مِنْہُنَّ غُسْلاً ، فَقُلْتُ : یَا رَسُولَ اللہِ ، لَوِ اغْتَسَلْت غُسْلاً وَاحِدًا ؟ فَقَالَ : ہَذَا أَطْہَرُ وَأَطْیَبُ ، أَوْ أَطْہَرُ وَأَنْظَفُ۔n(ابوداؤد ۲۲۱۔ احمد ۶/۱۰)","Da'if","Musannaf Ibn Abi Shaybah 1572","","","كتاب الطهارة"
"1573","(۱۵۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : قَالَ سُلَیْمَانُ بْنُ دَاوُد : لأَطُوفَنَّ اللَّیْلَۃَ عَلَی مِئَۃ امْرَأَۃٍ فَتَلِدُ کُلُّ امْرَأَۃٍ مِنْہُنَّ غُلاَمًا یَضْرِبُ بِالسَّیْفِ فِی سَبِیلِ اللہِ۔ (احمد ۲/۵۰۶)","Sahih","Musannaf Ibn Abi Shaybah 1573","","","كتاب الطهارة"
"1574","(۱۵۷۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ سَعْدَ بْنَ مَالِکٍ طَافَ عَلَی تِسْعِ جَوَارٍ لَہُ فِی لَیْلَۃٍ ، ثُمَّ أَقَامَ الْعَاشِرَۃَ فَقَامَتْ فَنَامَ فَاسْتَحْیَتْ أَنْ تُوقِظَہُ۔","","Musannaf Ibn Abi Shaybah 1574","","","كتاب الطهارة"
"1575","(۱۵۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَغْسِلَ الرَّجُلُ یَدَہُ بِشَیْئٍ مِنَ الدَّقِیقِ وَالسَّوِیقِ۔","","Musannaf Ibn Abi Shaybah 1575","","","كتاب الطهارة"
"1576","(۱۵۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زَائِدَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، قَالَ : أَکَلْتُ مَعَ إبْرَاہِیمَ سَمَکًا فَدَعَا لِی بِسَوِیقٍ فَغَسَلْتُ یَدَیَّ۔","","Musannaf Ibn Abi Shaybah 1576","","","كتاب الطهارة"
"1577","(۱۵۷۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ حَمَّادٍ ؛ أَنَّہُ لَمْ یَرَ بِہِ بَأْسًا ، وَقَالَ : یُکْرَہُ مِنْہُ فَسَادُہُ۔","","Musannaf Ibn Abi Shaybah 1577","","","كتاب الطهارة"
"1578","(۱۵۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، قَالَ : سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنِ الرَّجُلِ یَغْسِلُ یَدَہُ بِالدَّقِیقِ وَالْخُبْزِ مِنَ الْغَمْرِ ؟ فَقَالَ : لاَ بَأْسَ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 1578","","","كتاب الطهارة"
"1579","(۱۵۷۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَغْسِلَ یَدَہُ بِدَقِیقٍ ، أَوْ بِطَحِینٍ۔","","Musannaf Ibn Abi Shaybah 1579","","","كتاب البيوع والأقضية"
"1580","(۱۵۸۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ؛ أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 1580","","","كتاب البيوع والأقضية"
"1581","(۱۵۸۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ؛ أَنَّہُ کَانَتْ لَہُ خِرْقَۃٌ یَتَمَسَّحُ بِہَا۔","","Musannaf Ibn Abi Shaybah 1581","","","كتاب الطهارة"
"1582","(۱۵۸۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزَیْدِ بْنِ عَبْدِ اللہِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، قَالَ : کَانَ لَہُ مِنْدِیلٌ یَتَمَسَّحُ بِہِ بَعْدَ الْوُضُوئِ۔","Da'if","Musannaf Ibn Abi Shaybah 1582","","","كتاب الطهارة"
"1583","(۱۵۸۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنِ ابْنِ أَبِی خَالِدٍ ، عَنْ عُمَرَ بْنِ یَعْلَی ، عَنْ أَبِیہِ یَعْلَی ؛ أَنَّہُ کَانَ لاَ یَرَی بِمَسْحِ الْوَجْہِ بِالْمِنْدِیلِ بَعْدَ الْوُضُوئِ بَأْسًا۔","Da'if","Musannaf Ibn Abi Shaybah 1583","","","كتاب الطهارة"
"1584","(۱۵۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ حَکِیمِ بْنِ جَابِرٍ ، قَالَ : أَرْسَلَ أَبِی مَوْلاَۃً لَنَا إلَی الْحَسَنِ بْنِ عَلِیٍّ ، فَرَأَتْہُ تَوَضَّأَ فَأَخَذَ خِرْقَۃً بَعْدَ الْوُضُوئِ فَتَمَسَّحَ بِہَا ، فَکَأَنَّہَا مَقَتَتْہُ ، فرأت من اللیل کَأَنَّہَا تَقَیَّأُ کبِدہا۔","Da'if","Musannaf Ibn Abi Shaybah 1584","","","كتاب الطهارة"
"1585","(۱۵۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أُمِّ غُرَابٍ ، قَالَتْ : حَدَّثَتْنِی بُنَانَۃُ خَادِمٌ لأُمِّ الْبَنِینَ امْرَأَۃِ عُثْمَانَ ؛ أَنَّ عُثْمَانَ تَوَضَّأَ فَمَسَحَ وَجْہَہُ بِالْمِنْدِیلِ۔","Da'if","Musannaf Ibn Abi Shaybah 1585","","","كتاب الطهارة"
"1586","(۱۵۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ سُوَیْد مَوْلَی عَمْرِو بْنِ حُرَیْثٍ ؛ أَنَّ عَلِیًّا اغْتَسَلَ ، ثُمَّ أَخَذَ ثَوْبًا فَدَخَلَ فِیہِ ، یَعْنِی : تَنَشَّفَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1586","","","كتاب الطهارة"
"1587","(۱۵۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، قَالَ : رَأَیْتُ بِشْرَ بْنَ أَبِی سَعِیدٍ یَتَمَسَّحُ بِالْمِنْدِیلِ۔","","Musannaf Ibn Abi Shaybah 1587","","","كتاب الطهارة"
"1588","(۱۵۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، عَنْ مَسْرُوقٍ ، أَنَّہُ کَانَتْ لَہُ خِرْقَۃٌ یَتَنَشَّفُ بِہَا۔","","Musannaf Ibn Abi Shaybah 1588","","","كتاب الطهارة"
"1589","(۱۵۸۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بِمَسْحِ الْوَجْہِ بِالْمِنْدِیلِ بَعْدَ الْوُضُوئِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 1589","","","كتاب الطهارة"
"1590","(۱۵۹۰) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ؛ أَنَّ الْحَسَنَ ، وَابْنَ سِیرِینَ کَانَا لاَ یَرَیَانِ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 1590","","","كتاب الطهارة"
"1591","(۱۵۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أُسَیْرِ بْنِ الرَّبِیعِ بْنِ عُمَیْلَۃَ ، قَالَ : رَأَیْتُ أَبِی وَأَبَا الأَحْوَصِ یَتَمْسَحَانِ بِالْمِنْدِیلِ بَعْدَ الْوُضُوئِ۔","","Musannaf Ibn Abi Shaybah 1591","","","كتاب الطهارة"
"1592","(۱۵۹۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ رُزَیْقٍ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَتَوَضَّأُ وَیَمْسَحُ وَجْہَہُ وَیَدَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1592","","","كتاب الطهارة"
"1593","(۱۵۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1593","","","كتاب الطهارة"
"1594","(۱۵۹۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنِ الرَّجُلِ یَمْسَحُ وَجْہَہُ بِالْخِرْقَۃِ بَعْدَ مَا یَتَوَضَّأُ؟ فَقَالَ : نَعَمْ ، إذَا کَانَتِ الْخِرْقَۃُ نَظِیفَۃً۔","","Musannaf Ibn Abi Shaybah 1594","","","كتاب الطهارة"
"1595","(۱۵۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَجْلَحِ ، عَنِ الضَّحَّاکِ ، أَنَّہُ سُئِلَ عَنِ الْمِنْدِیلِ بَعْدَ الْوُضُوئِ ؛ فَقَالَ : ہُوَ أَنْقَی لِلْوَجْہِ۔","","Musannaf Ibn Abi Shaybah 1595","","","كتاب الطهارة"
"1596","(۱۵۹۶) حَدَّثَنَا ابْنُ نُمَیْرٍ وَوَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1596","","","كتاب الطهارة"
"1597","(۱۵۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ مَسَحَ وَجْہَہُ بِثَوْبِہِ۔","","Musannaf Ibn Abi Shaybah 1597","","","كتاب الطهارة"
"1598","(۱۵۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شُعْبَۃَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، قَالَ : کَانَ الأَسْوَدُ یَتَمَسَّحُ بِالْمِنْدِیلِ۔","","Musannaf Ibn Abi Shaybah 1598","","","كتاب الطهارة"
"1599","(۱۵۹۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بِہِ بَأْسًا ، وَکَانَ ابْنُ سِیرِینَ یَقُولُ : تَرْکُہُ أَحَبُّ إلَیَّ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 1599","","","كتاب الطهارة"
"1600","(۱۶۰۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِمَسْح الرَّجُل وَجْہَہُ بِالْمِنْدِیلِ۔","","Musannaf Ibn Abi Shaybah 1600","","","كتاب الطهارة"
"1601","(۱۶۰۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ بَکْرٍ ، قَالَ : أَنْفَعُ مَا یَکُونُ الْمِنْدِیلُ فِی الشِّتَائِ۔","","Musannaf Ibn Abi Shaybah 1601","","","كتاب الطهارة"
"1602","(۱۶۰۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِ ، عَنْ سَالِمٍ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَیْمُونَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أُتِیَ بِالْمِنْدِیلِ فَلَمْ یَمَسَّہُ وَجَعَلَ یَقُولُ : بِالْمَائِ ہَکَذَا ، یَعْنِی : یَنْفُضُہُ۔n(مسلم ۲۵۴۔ نسائی ۲۵۰)","Sahih","Musannaf Ibn Abi Shaybah 1602","","","كتاب الطهارة"
"1603","(۱۶۰۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ؛ قَالَ : لاَ تَمَنْدَلْ إذَا تَوَضَّأْتَ۔","Sahih","Musannaf Ibn Abi Shaybah 1603","","","كتاب الطهارة"
"1604","(۱۶۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یُتَمَسَّحُ مِنْ طَہُورِ الْجَنَابَۃِ ، وَلاَ یتمسح مِنْ طَہُورِ الصَّلاَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 1604","","","كتاب الطهارة"
"1605","(۱۶۰۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، وَسَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُمَا کَرِہَا الْمِنْدِیلَ بَعْدَ الْوُضُوئِ۔","","Musannaf Ibn Abi Shaybah 1605","","","كتاب الطهارة"
"1606","(۱۶۰۶) حَدَّثَنَا عَبَّادٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ یَکْرَہُہُ وَیَقُولُ : أَحْدَثْتُمَ الْمَنَادِیلَ۔","","Musannaf Ibn Abi Shaybah 1606","","","كتاب الطهارة"
"1607","(۱۶۰۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا الْعَالِیَۃِ وَسَعِیدَ بْنَ الْمُسَیَّبِ کَرِہَا أَنْ یَمْسَحَ وَجْہَہُ بِالْمِنْدِیلِ بَعْدَ الْوُضُوئِ۔","","Musannaf Ibn Abi Shaybah 1607","","","كتاب الطهارة"
"1608","(۱۶۰۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنَّمَا کَانُوا یَکْرَہُونَ الْمِنْدِیلَ بَعْدَ الْوُضُوئِ مَخَافَۃَ الْعَادَۃِ۔","","Musannaf Ibn Abi Shaybah 1608","","","كتاب الطهارة"
"1609","(۱۶۰۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الصَّلْتِ بْنِ بَہْرَامَ ، عْن عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَرِہَہُ ، وَقَالَ : ہُوَ یُوزَنُ۔","","Musannaf Ibn Abi Shaybah 1609","","","كتاب الطهارة"
"1610","(۱۶۱۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : قَالُوا لِسَلْمَانَ : قَدْ عَلَّمَکُمْ نَبِیُّکُمْ کُلَّ شَیْئٍ حَتَّی الْخِرَائَۃَ ؟ قَالَ : أَجَلْ ، قَدْ نَہَانَا أَنْ نَسْتَقْبِلَ الْقِبْلَۃَ بِغَائِطٍ ، أَوْ بَوْلٍ۔n(ابوداؤد ۷۔ ترمذی ۱۶)","Sahih","Musannaf Ibn Abi Shaybah 1610","","","كتاب الطهارة"
"1611","(۱۶۱۱) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَطَائِ بْنِ یَزِیدَ ، عَنْ أَبِی أَیُّوبَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا ذَہَبَ أَحَدُکُمْ الغَائِطَ فَلاَ یَسْتَقْبِلِ الْقِبْلَۃَ ، وَلاَ یُوَلِّہَا ظَہْرَہُ ، شَرِّقُوا ، أَوْ غَرِّبُوا۔ (بخاری ۱۴۴۔ ابوداؤد ۹)","Sahih","Musannaf Ibn Abi Shaybah 1611","","","كتاب الطهارة"
"1612","(۱۶۱۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابِ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ ، عَنْ رَافِعِ بْنِ إِسْحَاقَ مَوْلَی أَبِی طَلْحَۃَ) ، قَالَ : سَمِعْتُ أَبَا أَیُّوبَ یَقُولُ : مَا أَدْرِی مَا أَصْنَعُ بِہَذِہِ الْکَرَایِیسِ ، وَقَدْ قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا ذَہَبَ أَحَدُکُمَ لِغَائِطٍ ، أَوْ بَوْلٍ فَلاَ تَسْتَقْبِلُوا الْقِبْلَۃَ ، أَوَ قَالَ : الْکَعْبَۃَ بِفَرْجٍ۔ (مالک ۱۔ نسائی ۲۰)","Sahih","Musannaf Ibn Abi Shaybah 1612","","","كتاب الطهارة"
"1613","(۱۶۱۳) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ سُلَیْمَانَ بْنِ بِلاَلٍ ، قَالَ : حدَّثَنِی عَمْرُو بْنُ یَحْیَی الْمَازِنِیُّ ، عَنْ أَبِی زَیْدٍ ، عَنْ مَعْقِلٍ الأَسَدِیِّ ، قَدْ صَحِبَ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَنْ نَسْتَقْبِلَ الْقِبْلَتَیْنِ بِغَائِطٍ ، أَوْ بَوْلٍ۔ (بخاری ۱۷۰۶۔ ابن ماجہ ۳۱۹)","Da'if","Musannaf Ibn Abi Shaybah 1613","","","كتاب الطهارة"
"1614","(۱۶۱۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ یُکْرَہُ أَنْ تُسْتَقْبلَ الْقِبْلَتانِ بِبَوْلٍ۔","","Musannaf Ibn Abi Shaybah 1614","","","كتاب الطهارة"
"1615","(۱۶۱۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَسْتَقْبِلُوا الْقِبْلَۃَ بِغَائِطٍ ، أَوْ بَوْلٍ ، أَوْ یَسْتَدْبِرُوہَا ، وَلَکِنْ عَنْ یَمِینِہَا ، أَوْ عَنْ یَسَارِہَا۔","","Musannaf Ibn Abi Shaybah 1615","","","كتاب الطهارة"
"1616","(۱۶۱۶) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَسْتَقْبِلُوا وَاحِدَۃً مِنَ الْقِبْلَتَیْنِ بِغَائِطٍ ، أَوْ بَوْلٍ۔","","Musannaf Ibn Abi Shaybah 1616","","","كتاب الطهارة"
"1617","(۱۶۱۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَام ، عَنْ طَاوُوسٍ ، قَالَ : حقٌّ للہِ عَلَی کُلِّ مُسْلِمٍ أَنْ یُکْرِمَ قِبْلَۃَ اللہِ فَلاَ یَسْتَقْبِلَ مِنْہَا شَیْئًا ۔ یَقُولُ : فِی غَائِطٍ ، أَوْ بَوْلٍ۔","","Musannaf Ibn Abi Shaybah 1617","","","كتاب الطهارة"
"1618","(۱۶۱۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ رَجُلٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : مَا اسْتَقْبَلْتُ الْقِبْلَۃَ بِخَلاَئِی مُنْذُ کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 1618","","","كتاب الطهارة"
"1619","(۱۶۱۹) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ؛ أَنَّہُ سَمِعَ عَبْدَ اللہِ بْنَ الْحَارِثِ الزُّبَیْدِیَّ یَقُولُ : أَنَا أَوَّلُ مَنْ سَمِعَ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَقُولُ : لاَ یَبُولَنَّ أَحَدُکُمْ مُسْتَقْبِلَ الْقِبْلَۃِ ، وَأَنَا أَوَّلُ مَنْ حَدَّثَ النَّاسَ بِہِ۔ (ابن حبان ۱۴۱۹۔ ۴/احمد ۱۹۱)","Sahih","Musannaf Ibn Abi Shaybah 1619","","","كتاب الطهارة"
"1620","(۱۶۲۰) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا وُہَیْبٌ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ یَحْیَی ، عَنْ أَبِی زَیْدٍ ، عَنْ مَعْقِلِ بْنِ أَبِی مَعْقِلٍ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ نَہَی أَنْ نَسْتَقْبِلَ الْقِبْلَتَیْنِ بِغَائِطٍ ، أَوْ بَوْلٍ۔","Da'if","Musannaf Ibn Abi Shaybah 1620","","","كتاب الطهارة"
"1621","(۱۶۲۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ عَمِّہِ وَاسِعِ بْنِ حَبَّانَ، عَنِ ابْنِ عُمَرَ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ جَالِسًا یَقْضِی حَاجَتَہُ مُتَوَجِّہًا نَحْوَ الْقِبْلَۃِ۔n(بخاری ۱۴۹۔ مسلم ۲۲۴)","Sahih","Musannaf Ibn Abi Shaybah 1621","","","كتاب الطهارة"
"1622","(۱۶۲۲) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ رَجُلٍ ، عَنْ عِرَاکِ بْنِ مَالِکٍ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِخَلاَئِہِ فَحُوِّلَ قِبَلَ الْقِبْلَۃِ ، لَمَّا بَلَغَہُ أَنَّ النَّاسَ کَرِہُوا ذَلِکَ۔ (احمد ۶/۱۸۳۔ دارقطنی ۱/۶۰)","Da'if","Musannaf Ibn Abi Shaybah 1622","","","كتاب الطهارة"
"1623","(۱۶۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ خَالِدِ الحذَّاء ، عَنْ خَالِدِ بْنِ أَبِی الصَّلْتِ ، عَنْ عِرَاکِ بْنِ مَالِکٍ، عَنْ عَائِشَۃَ ، قَالَتْ : ذُکِرَ عِنْدَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، أَنَّ قَوْمًا یَکْرَہُونَ أَنْ یَسْتَقْبِلُوا بِفُرُوجِہِمُ الْقِبْلَۃَ، قَالَت: قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ: اسْتَقْبِلُوا بِمَقَعَدَتِی إلَی الْقِبْلَۃِ۔(احمد ۱۳۶۔ دارقطنی ۷)","","Musannaf Ibn Abi Shaybah 1623","","","كتاب الطهارة"
"1624","(۱۶۲۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : قَالُوا لِسَلْمَانَ : قَدْ عَلَّمَکُمْ نَبِیُّکُمْ کُلَّ شَیْئٍ حَتَّی الْخِرَائَۃَ ، قَالَ : أَجَلْ ، قَدْ نَہَانَا أَنْ نَسْتَنْجِیَ بِالْیَمِینِ۔","Sahih","Musannaf Ibn Abi Shaybah 1624","","","كتاب الطهارة"
"1625","(۱۶۲۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ یَمِینُ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لِطَعَامِہِ وَصَلاَتِہِ ، وَکَانَتْ شِمَالُہُ لِمَا سِوَی ذَلِکَ۔ (احمد ۱۶۵)","Da'if","Musannaf Ibn Abi Shaybah 1625","","","كتاب الطهارة"
"1626","(۱۶۲۶) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَاصِمٍ ، عَنِ الْمُسَیَّبِ (ح) وَقَالَ غَیْرُ حُسَیْنٍ : عَنْ زَائِدَۃَ ، عَنِ الْمُسَیَّبِ ، عَنْ سَوَائٍ ، عَنْ حَفْصَۃَ قَالَتْ : کَانَتْ یَمِینُ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لِطَعَامِہِ ، وَشَرَابِہِ ، وَطُہُورِہِ ، وَثِیَابِہِ ، وَصَلاَتِہِ ، وَکَانَتْ شِمَالُہُ لِمَا سِوَی ذَلِکَ۔ n(نسائی ۱۰۵۹۹۔ طبرانی ۳۵۳)","","Musannaf Ibn Abi Shaybah 1626","","","كتاب الطهارة"
"1627","(۱۶۲۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ: قَالَ عُمَرُ : إِنَّمَا آکُلُ بِیَمِینِی ، وَأَسْتَطِیبُ بِشِمَالِی۔","","Musannaf Ibn Abi Shaybah 1627","","","كتاب الطهارة"
"1628","(۱۶۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُور ، عَنْ إِبْرَاہِیمَ ، قَالَ: کَانَ یُقَالُ : یَمِینُ الرَّجُلِ لِطَعَامِہِ ، وَشَرَابِہِ، وَشِمَالُہُ لِمُخَاطِہِ ، وَاسْتِنْجَائِہِ۔","","Musannaf Ibn Abi Shaybah 1628","","","كتاب الطهارة"
"1629","(۱۶۲۹) حَدَّثَنَا عَبْدُالرَّحیم بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ مُعَاذَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ: مُرُوا أَزْوَاجَکُنَّ أَنْ یَغْسِلُوا أَثَرَ الْغَائِطِ وَالْبَوْلِ ، فَإِنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ یَفْعَلُہُ ، وَأَنَا أَسْتَحْیِیہِمْ۔n(ترمذی ۱۹۔ احمد ۶/۲۳۶)","Sahih","Musannaf Ibn Abi Shaybah 1629","","","كتاب الطهارة"
"1630","(۱۶۳۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخبرنَا مَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ عَائِشَۃَ کَانَتْ تَقُولُ لِلنِّسَائِ : مُرْنَ أَزْوَاجَکُنَّ أَنْ یَسْتَنْجُوا بِالْمَائِ إذَا خَرَجُوا مِنَ الْغَائِطِ۔","Sahih","Musannaf Ibn Abi Shaybah 1630","","","كتاب الطهارة"
"1631","(۱۶۳۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ ذَرٍّ ، عَنْ مُسْلِمِ بْنِ سَبْرَۃَ بْنِ الْمُسَیَّبِ بْنِ نَجَبۃَ ، عَنْ عَمَّتِہِ فُرَیْعَۃَ ، وَکَانَتْ تَحْتَ حُذَیْفَۃَ ، أَنَّہَا قَالَتْ : کَانَ حُذَیْفَۃُ یَسْتَنْجِی بِالْمَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 1631","","","كتاب الطهارة"
"1632","(۱۶۳۲) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ غُنْدَرٍ وَوَکِیعٍ ، عَنْ شُعْبَۃَ ، عَنْ عَطَائِ بْنِ أَبِی مَیْمُونَۃَ ؛ أَنَّہُ سَمِعَ أَنَسًا یَقُولُ : کَانَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَدْخُلُ الْخَلاَئَ فَأَحْمِلُ أَنَا وَغُلاَمٌ نَحْوِی إدَاوَۃً وَعَنَزَۃً ، فَیَسْتَنْجِی بِالْمَائِ۔n(بخاری ۱۵۲۔ مسلم ۷۰)","Sahih","Musannaf Ibn Abi Shaybah 1632","","","كتاب الطهارة"
"1633","(۱۶۳۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : حَدَّثَنَا أَبُو النّجَاشی ، قَالَ : صَحِبْتُ رَافِعَ بْنَ خَدِیجٍ فِی سَفَرٍ ، فَکَانَ یَسْتَنْجِی بِالْمَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 1633","","","كتاب الطهارة"
"1634","(۱۶۳۴) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ؛ أَنَّ أَنَسَ بْنَ مَالِکٍ دَخَلَ الْخَلاَئَ فَدَعَا بِتَوْرٍ وَأُشْنَانٍ۔","Sahih","Musannaf Ibn Abi Shaybah 1634","","","كتاب الطهارة"
"1635","(۱۶۳۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : بَلَغَنِی أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لَمْ یَدْخُلِ الْخَلاَئَ إِلاَّ تَوَضَّأَ ، أَوْ مَسَّ مَائً۔","","Musannaf Ibn Abi Shaybah 1635","","","كتاب الطهارة"
"1636","(۱۶۳۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی سَلَمَۃَ ؛ أَنَّہُ سَمِعَ أَبَا نَضْرَۃَ یُحَدِّثُ ، عَنْ أَبِی سَعْیدٍ مَوْلَی أَبِی أُسَیْدٍ ، وَکَانَ بَدَوِیًّا ، قَالَ: کَانَ أَبُو أُسَیْدٍ إذَا أَتَی الْخَلاَئَ أَتَیْتُہُ بِمَائٍ فَاسْتَبْرَأَ مِنْہُ۔ قَالَ شُعْبَۃُ : یَعْنِی : یَسْتَنْجِی۔","Da'if","Musannaf Ibn Abi Shaybah 1636","","","كتاب الطهارة"
"1637","(۱۶۳۷) حَدَّثَنَا ابْنُ دُکَیْنٍ ، عَنْ قُرَّۃَ ، عَنْ بُدَیْلٍ الْعُقَیْلِیِّ ، عَنْ مُطَرِّفِ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، قَالَ : حدَّثَنِی أَعْرَابِیٌّ ، قَالَ : صَحِبْت أَبَا ذَرٍّ فَکُلُّ أَخْلاَقِہِ أَعْجَبَتنِی إِلاَّ خُلُقاً وَاحِدًا ، قُلْتُ : وَمَا ہُوَ ؟ قَالَ : کَانَ إذَا خَرَجَ مِنَ الْخَلاَئِ اسْتَنْجَی۔","Da'if","Musannaf Ibn Abi Shaybah 1637","","","كتاب الطهارة"
"1638","(۱۶۳۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنِ ابْنِ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ اسْتَطَابَ بِالْمَائِ بَیْنَ رَاحِلتَیْنِ ، قَالَ : فَجَعَلَ أَصْحَابُ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَضْحَکُونَ وَیَقُولُونَ : یَتَوَضَّأُ کَمِثْلِ الْمَرْأَۃِ۔","","Musannaf Ibn Abi Shaybah 1638","","","كتاب الطهارة"
"1639","(۱۶۳۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ؛ أَنَّ أَنَسًا کَانَ یَسْتَنْجِی بِالْحَوْضِ۔","Sahih","Musannaf Ibn Abi Shaybah 1639","","","كتاب الطهارة"
"1640","(۱۶۴۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ مُجَمِّعِ بْنِ یَعْقُوبَ بْنِ مُجَمِّعٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِعُوَیْمِ بْنِ سَاعِدَۃَ : مَا ہَذَا الطُّہُورُ الَّذِی أَثْنَی اللَّہُ عَلَیْکُمْ ؟ قَالُوا : نَغْسِلُ الأَدْبَارَ۔n(احمد ۳/۴۲۲۔ ابن خزیمۃ ۸۳)","","Musannaf Ibn Abi Shaybah 1640","","","كتاب الطهارة"
"1641","(۱۶۴۱) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا مَالِکُ بْنُ مِغْوَلٍ ، قَالَ : سَمِعْتُ سَیَّارًا أَبَا الْحَکَمِ ، غَیْرَ مَرَّۃٍ ، یُحَدِّثُ عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ سَلاَمٍ ، قَالَ : لَمَّا قَدِمَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَلَیْنَا، یَعْنِی : قُبَائَ ، قَالَ : إنَّ اللَّہَ قَدْ أَثْنَی عَلَیْکُمْ فِی الطُّہُورِ خَیْرًا ، أَفَلاَ تُخْبِرُوننی ؟ قَالَ : یَعْنِی قولہ تعالی: {فِیہِ رِجَالٌ یُحِبُّونَ أَنْ یَتَطَہَّرُوا وَاللَّہُ یُحِبُّ الْمُطَّہِّرِینَ} قَالَ : فَقَالُوا : یَا رَسُولَ اللہِ ، إنَّا لَنَجِدُہُ مَکْتُوبًا عَلَیْنَا فِی التَّوْرَاۃِ : الاسْتِنْجَائُ بِالْمَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 1641","","","كتاب الطهارة"
"1642","(۱۶۴۲) حَدَّثَنَا حَفْصٌ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْد ، عَنِ الشَّعْبِیِّ ، قَالَ : لَمَّا نَزَلَتْ ہَذِہِ الآیَۃُ ، قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : یَا أَہْلَ قُبَائَ ، مَا ہَذَا الثَّنَائُ الَّذِی أَثْنَی اللَّہُ عَلَیْکُمْ ؟ قَالُوا : مَا مِنَّا أَحَدٌ إِلاَّ وَہُوَ یَسْتَنْجِی بِالْمَائِ مِنَ الْخَلاَئِ ۔ {فِیہِ رِجَالٌ یُحِبُّونَ أَنْ یَتَطَہَّرُوا وَاللَّہُ یُحِبُّ الْمُطَّہِّرِینَ}۔ (ابوداؤد ۴۵۔ ترمذی ۳۱۰۰)","","Musannaf Ibn Abi Shaybah 1642","","","كتاب الطهارة"
"1643","(۱۶۴۳) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ ہَذِہِ الآیَۃَ نَزَلَتْ فِی أَہْلِ قُبَائَ : {فِیہِ رِجَالٌ یُحِبُّونَ أَنْ یَتَطَہَّرُوا وَاللَّہُ یُحِبُّ الْمُطَّہِّرِینَ} ۔","","Musannaf Ibn Abi Shaybah 1643","","","كتاب الطهارة"
"1644","(۱۶۴۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَزِیدَ الرِّشْکِ ، عَنْ مُعَاذَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : مُرْنَ أَزْوَاجَکُنَّ ، أَوَقَالَتْ : رِجَالَکُنَّ ، أَنْ یَغْسِلُوا عَنْہُمْ أَثَرَ الْحَشّ ، فَإِنَّا نَسْتَحْیِی أَنْ نَأْمُرَہُمْ بِذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 1644","","","كتاب الطهارة"
"1645","(۱۶۴۵) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : قَالَ عَلِیٌّ : إنَّ مَنْ کَانَ قَبْلَکُمْ کَانُوا یَبْعَرُونَ بَعْرًا ، وَإِنَّکُمْ تَثْلِطُونَ ثَلْطًا ، فَأَتْبِعُوا الْحِجَارَۃَ بِالْمَائِ۔","","Musannaf Ibn Abi Shaybah 1645","","","كتاب الطهارة"
"1646","(۱۶۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن ہَمَّامٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : سُئِلَ عَنِ الاِسْتِنْجَائِ بِالْمَائِ ؟ فَقَالَ : إذًا لاَ تَزَالُ یَدَیَّ فِی نَتْنٍ۔","Sahih","Musannaf Ibn Abi Shaybah 1646","","","كتاب الطهارة"
"1647","(۱۶۴۷) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ ، قَالَ: کَانَ الأَسْوَدُ ، وَعَبْدُ الرَّحْمَنِ بْنُ یَزِیدَ یَدْخُلاَنِ الْخَلاَئَ، فَیَسْتَنْجِیَانِ بِأَحْجَارٍ ، وَلاَ یَزِیدَانِ عَلَیْہَا ، وَلاَ یَمَسَّانِ مَائً۔","","Musannaf Ibn Abi Shaybah 1647","","","كتاب الطهارة"
"1648","(۱۶۴۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : ذُکِرَ لَہُ الاسْتِنْجَائُ بِالْمَائِ، فَقَالَ : ذَلِکَ طَہُورُ النِّسَائُ۔","","Musannaf Ibn Abi Shaybah 1648","","","كتاب الطهارة"
"1649","(۱۶۴۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ ذُکِرَ لَہُ الاسْتِنْجَائُ بِالْمَائِ ، فَقَالَ : أَنْتُمْ أَفْعَلُ لِذَلِکَ ، إِنَّہُمْ کَانُوا یَجْتَزِئُونَ بِالْحِجَارَۃِ۔","","Musannaf Ibn Abi Shaybah 1649","","","كتاب الطهارة"
"1650","(۱۶۵۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَمْرِو بْنِ خُزَیْمَۃَ ، عَنْ عُمَارَۃَ بْنِ خُزَیْمَۃَ ، عَنْ خُزَیْمَۃَ بْنِ ثَابِتٍ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فِی الاِسْتِنْجَائِ بِثَلاَثَۃِ أَحْجَارٍ لَیْسَ فِیہَا رَجِیعٌ۔n(ابوداؤد ۴۲۔ ابن ماجہ ۳۱۵)","Da'if","Musannaf Ibn Abi Shaybah 1650","","","كتاب الطهارة"
"1651","(۱۶۵۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا أَبُو بِشْرٍ ، عَنْ طَاوُوسٍ ، قَالَ: الأَسْتِنْجَائُ بِثَلاَثَۃِ أَحْجَارٍ ، قَالَ : قُلْتُ : فَإِنْ لَمْ أَجِدْ ثَلاَثَۃَ أَحْجَارٍ ؟ قَالَ : فَثَلاَثَۃِ أَعْوَادٍ ، قُلْتُ : فَإِنْ لَمْ أَجِدْ ثَلاَثَۃَ أَعْوَادٍ ؟ قَالَ : فَثَلاَثِ حَفَنَاتٍ مِنْ تُرَابٍ۔","","Musannaf Ibn Abi Shaybah 1651","","","كتاب الطهارة"
"1652","(۱۶۵۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، قَالَ : حدَّثَنَا الْحَکَمُ ، قَالَ : الإِسْتِنْجَائُ بِثَلاَثَۃِ أَحْجَارٍ ، فَإِنْ لَمْ یَجْتَزِئْ بِذَلِکَ ، فَبِخَمْسَۃِ أَحْجَارٍ۔","","Musannaf Ibn Abi Shaybah 1652","","","كتاب الطهارة"
"1653","(۱۶۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ الْقِبْطَیّۃِ ، عَنِ ابْنِ الزُّبَیْرِ ؛ أَنَّہُ رَأَی رَجُلاً یَغْسِلُ عَنْہُ أَثَرَ الْغَائِطِ ، فَقَالَ : مَا کُنَّا نَفْعَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1653","","","كتاب الطهارة"
"1654","(۱۶۵۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ سَلْمَانَ ، قَالَ لَہُ بَعْضُ الْمُشْرِکِینَ وَہُمْ یَسْتَہْزِئُونَ : أَرَی صَاحِبَکُمْ وَہُوَ یُعَلِّمُکُمْ حَتَّی الْخِرَائَۃَ ؟ فَقَالَ سَلْمَانُ : أَجَلْ ، أَمَرَنَا أَنْ لاَ نَسْتَقْبِلَ الْقِبْلَۃَ ، وَلاَ نَسْتَنْجِیَ بِدُونِ ثَلاَثَۃِ أَحْجَارٍ۔","Sahih","Musannaf Ibn Abi Shaybah 1654","","","كتاب الطهارة"
"1655","(۱۶۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لِحَاجَۃٍ ، فَقَالَ : الْتَمِسْ لِی ثَلاَثَۃَ أَحْجَارٍ ، فَأَتَیْتُہُ بِحَجَرَیْنِ وَرَوْثَۃٍ ، فَأَخَذَ الْحَجَرَیْنِ ، وَطَرَحَ الرَّوْثَۃَ ، وَقَالَ : إِنَّہَا رِکْسٌ۔ (ترمذی ۱۷۔ احمد ۱/۳۸۸)","","Musannaf Ibn Abi Shaybah 1655","","","كتاب الطهارة"
"1656","(۱۶۵۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا اسْتَجْمَرَ أَحَدُکُمْ فَلْیَسْتَجْمِرْ ثَلاَثًا ، یَعْنِی : یَسْتَنْجِی۔ (مسلم ۲۱۳۔ احمد ۳/۲۹۴)","Hasan","Musannaf Ibn Abi Shaybah 1656","","","كتاب الطهارة"
"1657","(۱۶۵۷) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ یَزِیدَ مَوْلَی سَلَمَۃَ ؛ أَنَّ سَلَمَۃَ کَانَ لاَ یَسْتَنْجِی بِالْمَائِ۔","","Musannaf Ibn Abi Shaybah 1657","","","كتاب الطهارة"
"1658","(۱۶۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَ عَلْقَمَۃُ وَالأَسْوَدُ ، أَوْ عَبْدُ الرَّحْمَنِ بْنُ یَزِیدَ ، لاَ یَزِیدَانِ عَلَی ثَلاَثَۃِ أَحْجَارٍ۔","","Musannaf Ibn Abi Shaybah 1658","","","كتاب الطهارة"
"1659","(۱۶۵۹) حَدَّثَنَا أَبُو بَکْرٍ ، عَنْ حَاتِمِ بْنِ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ لاَ یَسْتَنْجِی بِالْمَائِ، کُنْتُ آتِیہ بِحِجَارَۃٍ مِنَ الْحَرَّۃِ ، فَإِذَا امْتَلأَتْ خَرَجْتُ بِہَا وَطَرَحْتُہَا ، ثُمَّ أَدْخَلْتُ مَکَانَھَا۔","Sahih","Musannaf Ibn Abi Shaybah 1659","","","كتاب الطهارة"
"1660","(۱۶۶۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ الأَسْوَدَ وَعَلْقَمَۃَ کَانَا یَسْتَنْجِیَانِ بِثَلاَثَۃِ أَحْجَارٍ۔","","Musannaf Ibn Abi Shaybah 1660","","","كتاب الطهارة"
"1661","(۱۶۶۱) حَدَّثَنَا حَفْصٌ ، عَنْ غِیَاثٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : لاَ تَسْتَنْجُوا بِالْعِظَامِ ، وَلاَ بِالرَّوْثِ ، فَإِنَّہُمَا زَادُ إخْوَانِکُمْ مِنَ الْجِنِّ۔ (مسلم ۱۵۰۔ ترمذی ۱۸)","Sahih","Musannaf Ibn Abi Shaybah 1661","","","كتاب الطهارة"
"1662","(۱۶۶۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ ، قَالَ : خَرَجْت مَعَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لِحَاجَۃٍ ، فَقَالَ : ائْتِنِی بِشَیْئٍ أَسْتَنْجِی بِہِ ، وَلاَ تُقَرِّبْنِی حَائِلاً، وَلاَ رَجِیعًا۔ (احمد ۱/۴۲۶)","Da'if","Musannaf Ibn Abi Shaybah 1662","","","كتاب الطهارة"
"1663","(۱۶۶۳) حَدَّثَنَا وَکِیعٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ سَلْمَانَ ، قَالَ: أَمَرَنَا أَنْ نَسْتَنْجِیَ ، یَعْنِی : النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، بِثَلاَثَۃِ أَحْجَارٍ لَیْسَ فِیہَا رَجِیعٌ ، وَلاَ عَظْمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 1663","","","كتاب الطهارة"
"1664","(۱۶۶۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَعَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَمْرِو بْنِ خُزَیْمَۃَ ، عَنْ عُمَارَۃَ بْنِ خُزَیْمَۃَ ، عَنْ خُزَیْمَۃَ بْنِ ثَابِتٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : الاسْتِطَابَۃُ بِثَلاَثَۃِ أَحْجَارٍ ، لَیْسَ فِیہَا رَجِیعٌ۔","Da'if","Musannaf Ibn Abi Shaybah 1664","","","كتاب الطهارة"
"1665","(۱۶۶۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَسْتَنْجِیَ الرَّجُلُ بِرَوْثٍ ، أَوْ رَجِیعِ دَابَّۃٍ ، أَوْ بِعَظْمٍ۔","","Musannaf Ibn Abi Shaybah 1665","","","كتاب الطهارة"
"1666","(۱۶۶۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُسْتَنْجِیَ بِالْحَجَرِ الَّذِی قَدِ اسْتُنْجِیَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1666","","","كتاب الطهارة"
"1667","(۱۶۶۷) حَدَّثَنَا حَفْصٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْمَلِکِ ، یَعْنِی ابْنَ مَیْسَرَۃَ ، قَالَ : لاَ بَأْسَ إذَا قَلَبْتَہُ ، أَوْ حَکَکْتَہُ۔","","Musannaf Ibn Abi Shaybah 1667","","","كتاب الطهارة"
"1668","(۱۶۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سِنَانٍ الْبُرْجُمِیِّ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ إذَا کَانَ الْحَجَرُ عَظِیمًا لَہُ حُرُوفٌ أَنْ تُحَرِّفَہُ وَتَقْلِبَہُ فَتَسْتَنْجِیَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1668","","","كتاب الطهارة"
"1669","(۱۶۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ طَلْحَۃَ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَرِہَ أَنْ یُسْتَنْجَی بِمَا قَدِ اسْتُنْجِیَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1669","","","كتاب الطهارة"
"1670","(۱۶۷۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : نُہِیَ أَنْ یَسْتَنْجِیَ الرَّجُلُ بِالْبَعْرَۃِ وَالْعَظْمِ۔","","Musannaf Ibn Abi Shaybah 1670","","","كتاب الطهارة"
"1671","(۱۶۷۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ نَاجِیَۃَ أَبِی خُفَافٍ ، عَنْ عَمَّارٍ ، قَالَ : أَجْنَبْتُ وَأَنَا فِی الإِبِلِ، وَلَمْ أَجِدْ مَائً ، فَتَمَعَّکْتُ تَمَعُّکَ الدَّابَّۃِ ، فَأَتَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرْتُہُ ، فَقَالَ : إنَّمَا کَانَ یَکْفِیکَ مِنْ ذَلِکَ التَّیَمُّمُ۔ (نسائی ۳۰۹۔ احمد ۴/۲۶۳)","","Musannaf Ibn Abi Shaybah 1671","","","كتاب الطهارة"
"1672","(۱۶۷۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عَوْنٍ ، عَنْ أَبِی رَجَائٍ ، قَالَ : حدَّثَنَا عِمْرَانُ بْنُ حُصَیْنٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ فِی سَفَرٍ فَصَلَّی بِالنَّاسِ ، فَإِذَا رَجُلٌ مُعْتَزِلٌ نَاحِیَۃً مِنَ الْقَوْمِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : مَا لَکَ ، لَمْ تُصَلِّ مَعَ النَّاسِ ؟ فَقَالَ : أَصَابَتْنِی جَنَابَۃٌ یَا رَسُولَ اللہِ ، وَلاَ مَائَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : عَلَیْک بِالصَّعِیدِ ، فَإِنَّہُ یَکْفِیک۔ (بخاری ۳۵۷۱۔ مسلم ۳۱۲)","Sahih","Musannaf Ibn Abi Shaybah 1672","","","كتاب الطهارة"
"1673","(۱۶۷۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ رَجُلٍ مِنْ بَنِی عَامِ[corrupt]ٍ ، عَنْ أَبِی ذَرٍّ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الصَّعِیدُ الطَّیِّبُ طَہُورٌ مَا لَمْ یُوجَدِ الْمَائُ وَلَوْ إلَی عَشْرِ حِجَجٍ ، فَإِذَا وَجَدْتَ الْمَائَ فَأَمِسَّہُ بَشَرَتَک۔ (ابوداؤد ۳۳۶۔ احمد ۵/۱۸۰)","Da'if","Musannaf Ibn Abi Shaybah 1673","","","كتاب الطهارة"
"1674","(۱۶۷۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ رِبْعِیٍّ ، عَنْ حُذَیْفَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : جُعِلَتْ تُرْبَتُہَا لَنَا طَہُورًا إذَا لَمْ نَجِدَ الْمَائَ ، یَعْنِی : الأَرْضَ۔ (مسلم ۳۷۱۔ احمد ۵/۳۸۳)","Sahih","Musannaf Ibn Abi Shaybah 1674","","","كتاب الطهارة"
"1675","(۱۶۷۵) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْمِنْہَالِ ، عَنْ عَبَّادِ بْنِ عَبْدِ اللہِ وَزِرٍّ ، عَنْ عَلِیٍّ ؛ {وَلاَ جُنُبًا إِلاَّ عَابِرِی سَبِیلٍ} قَالَ : الْمَارُّ الَّذِی لاَ یَجِدُ الْمَائَ یَتَیَمَّمُ وَیُصَلِّی۔","Da'if","Musannaf Ibn Abi Shaybah 1675","","","كتاب الطهارة"
"1676","(۱۶۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ؛ {وَلاَ جُنُبًا إِلاَّ عَابِرِی سَبِیلٍ} ؛ إِلاَّ أَنْ تَکُونُوا مُسَافِرِینَ فَتَیَمَّمُوا۔","","Musannaf Ibn Abi Shaybah 1676","","","كتاب الطهارة"
"1677","(۱۶۷۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ {وَلاَ جُنُبًا إِلاَّ عَابِرِی سَبِیلٍ} قَالَ : ہُوَ الْمُسَافِرُ۔","Sahih","Musannaf Ibn Abi Shaybah 1677","","","كتاب الطهارة"
"1678","(۱۶۷۸) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : ہُمُ الْمُسَافِرُونَ لاَ یَجِدُونَ الْمَائَ۔","","Musannaf Ibn Abi Shaybah 1678","","","كتاب الطهارة"
"1679","(۱۶۷۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عُمَرَ ، قَالَ : لاَ یَتَیَمَّمُ الْجُنُبُ وَإِنْ لَمْ یَجِدِ الْمَائَ شَہْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 1679","","","كتاب الطهارة"
"1680","(۱۶۸۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : إذَا کُنْتَ فِی سَفَرٍ فَأَجْنَبْتَ فَلاَ تُصَلِّ حَتَّی تَجِدَ الْمَائَ ، وَإِنْ أَحْدَثْتَ فَتَیَمَّمْ ، ثُمَّ صَلِّ۔","","Musannaf Ibn Abi Shaybah 1680","","","كتاب الطهارة"
"1681","(۱۶۸۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ أَبِی سِنَانٍ ، عَنِ الضَّحَّاکِ ، قَالَ : رَجَعَ عَبْدُ اللہِ عَنْ قَوْلِہِ فِی التَّیَمُّمِ۔","","Musannaf Ibn Abi Shaybah 1681","","","كتاب الطهارة"
"1682","(۱۶۸۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ زُبَیْدٍ ، قَالَ : أَجْنَبْت فَلَمْ أَجِدِ الْمَائَ ، فَسَأَلْت أَبَا عَطِیَّۃَ ؟ فَقَالَ: لاَ تُصَلِّ ، وَسَأَلْت سَعِیدَ بْنَ جُبَیْرٍ ؟ فَقَالَ : تَیَمَّمْ وَصَلِّ۔","","Musannaf Ibn Abi Shaybah 1682","","","كتاب الطهارة"
"1683","(۱۶۸۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، قَالَ : کُنْتُ جَالِسًا مَعَ عَبْدِ اللہِ ، وَأَبِی مُوسَی ، فَقَالَ أَبُو مُوسَی : یَا أَبَا عَبْدِ الرَّحْمَنِ ، أَرَأَیْتَ لَوْ أَنَّ رَجُلاً أَجْنَبَ فَلَمْ یَجِدِ الْمَائَ شَہْرًا ، کَیْفَ یَصْنَعُ بِالصَّلاَۃِ ؟ فَقَالَ عَبْدُ اللہِ : لاَ یَتَیَمَّمُ وَإِنْ لَمْ یَجِدِ الْمَائَ شَہْرًا ، فَقَالَ أَبُو مُوسَی : فَکَیْفَ بِہَذِہِ الآیَۃِ فِی سُورَۃِ الْمَائِدَۃِ : {فَإِنْ لَمْ تَجِدُوا مَائً فَتَیَمَّمُوا صَعِیدًا طَیِّبًا} فَقَالَ عَبْدُ اللہِ : لَوْ رُخِّصَ لَہُمْ فِی ہَذَا لأَوْشَکُوا إذَا بَرَدَ عَلَیْہِمُ الْمَائُ أَنْ یَتَیَمَّمُوا بِالصَّعِیدِ۔ (مسلم ۱۱۰۔ بخاری ۳۴۷)","Sahih","Musannaf Ibn Abi Shaybah 1683","","","كتاب الطهارة"
"1684","(۱۶۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ قَالَ : أَجْنَبَ أَبُو ذَرٍّ ، وَہُوَ مِنَ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَلَی مَسِیرَۃِ ثَلاَثٍ ، فَجَائَہُ وَقَدِ انْصَرَفَ مِنْ صَلاَۃِ الصُّبْحِ وَتَبَرَّزَ لِحَاجَتِہِ ، فَالْتَفَتَ إلَیْہِ فَوَضَعَ یَدَہُ فِی التُّرَابِ فَمَسَحَ وَجْہَہُ وَکَفَّیْہِ۔","","Musannaf Ibn Abi Shaybah 1684","","","كتاب الطهارة"
"1685","(۱۶۸۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ تَیَمَّمَ فِی مِرْبَدِ النَّعَمِ ، فَقَالَ : بِیَدَیْہِ عَلَی الأَرْضِ فَمَسَحَ بِہِمَا وَجْہَہُ ، ثُمَّ ضَرَبَ بِہِمَا عَلَی الأَرْضِ ضَرْبَۃً أُخْرَی ، ثُمَّ مَسَحَ بِہِمَا یَدَیْہِ إلَی الْمِرْفَقَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 1685","","","كتاب الطهارة"
"1686","(۱۶۸۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : سَأَلْتُ سَالِمًا عَنِ التَّیَمُّمِ ؟ قَالَ : فَضَرَبَ بِیَدَیْہِ عَلَی الأَرْضِ فَمَسَحَ بِہِمَا وَجْہَہُ ، ثُمَّ ضَرَبَ بِیَدَیْہِ عَلَی الأَرْضِ ضَرْبَۃً أُخْرَی فَمَسَحَ بِہِمَا یَدَیْہِ إلَی الْمِرْفَقَیْنِ۔","","Musannaf Ibn Abi Shaybah 1686","","","كتاب الطهارة"
"1687","(۱۶۸۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ حَبِیبِ بْنِ الشَّہِیدِ؛ أَنَّہُ سَمِعَ الْحَسَنَ سُئِلَ عَنِ التَّیَمُّمِ؟ فَضَرَبَ بِیَدَیْہِ إِلی الأَرْضِ ضَرْبَۃً فَمَسَحَ بِہِمَا وَجْہَہُ ، ثُمَّ ضَرَبَ بِیَدَیْہِ عَلَی الأَرْضِ ضَرْبَۃً أُخْرَی فَمَسَحَ بِہِمَا یَدَیْہِ إلَی الْمِرْفَقَیْنِ۔","","Musannaf Ibn Abi Shaybah 1687","","","كتاب الطهارة"
"1688","(۱۶۸۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : التَّیَمُّمُ ضَرْبَۃٌ لِلْوَجْہِ وَلِلْیَدَیْنِ إلَی الْمِرْفَقَیْنِ ۔ وَوَصَفَ لَنَا دَاوُد : فَضَرَبَ بِیَدَیْہِ عَلَی الأَرْضِ ضَرْبَۃً ، ثُمَّ نَفَضَہُمَا ، ثُمَّ مَسَحَ بِہِمَا کَفَّیْہِ ، ثُمَّ مَسَحَ بِہِمَا وَجْہَہُ وَذِرَاعَیْہِ إلَی الْمِرْفَقَیْنِ۔","","Musannaf Ibn Abi Shaybah 1688","","","كتاب الطهارة"
"1689","(۱۶۸۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، قَالَ : قَالَ أَبُو مُوسَی لِعَبْدِ اللہِ : أَلَمْ تَسْمَعْ قَوْلَ عَمَّارٍ : بَعَثَنِی رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فِی حَاجَۃٍ فَأَجْنَبْتُ فَلَمْ أَجِدِ الْمَائَ فَتَمَرَّغْت فِی الصَّعِیدِ کَمَا تَمَرَّغُ الدَّابَّۃُ ، ثُمَّ أَتَیْتُ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَذَکَرْت ذَلِکَ لَہُ ، فَقَالَ : إنَّمَا کَانَ یَکْفِیک أَنْ تَقُولَ بِیَدَیْک ہَکَذَا ، ثُمَّ ضَرَبَ بِیَدَیْہِ الأَرْضَ ضَرْبَۃً وَاحِدَۃً ، ثُمَّ مَسَحَ الشِّمَالَ عَلَی الْیَمِینِ وَظَاہِرَ کَفَّیْہِ وَوَجْہَہُ ؟ فَقَالَ عَبْدُ اللہِ : أَوْ لَمْ تَرَ عُمَرَ لَمْ یَقْنَعْ بِقَوْلِ عَمَّارٍ؟ ۔","Sahih","Musannaf Ibn Abi Shaybah 1689","","","كتاب الطهارة"
"1690","(۱۶۹۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنِ ابْنِ أَبْزَی ، عَنْ أَبِیہِ ، قَالَ : قَالَ عَمَّارٌ لِعُمَرَ : أَمَا تَذْکُرُ یَوْمًا کُنَّا فِی کَذَا وَکَذَا فَأَجْنَبْنَا فَلَمْ نَجِدِ الْمَائَ فَتَمَعَّکْنَا فِی التُّرَابِ ، فَلَمَّا قَدِمْنَا عَلَی النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ذَکَرْنَا ذَلِکَ لَہُ ، فَقَالَ : إنَّمَا یَکْفِیک ہَذَا ، ثُمَّ ضَرَبَ الأَعْمَشُ بِیَدَیْہِ ضَرْبَۃً ، ثُمَّ نَفَخَہُمَا ، ثُمَّ مَسَحَ بِہِمَا وَجْہَہُ وَکَفَّیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 1690","","","كتاب الطهارة"
"1691","(۱۶۹۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ فِی التَّیَمُّمِ : یَضْرِبُ بِیَدَیْہِ الأَرْضَ وَیَمْسَحُ بِہِمَا وَجْہَہُ وَکَفَّیْہِ۔","","Musannaf Ibn Abi Shaybah 1691","","","كتاب الطهارة"
"1692","(۱۶۹۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ؛ قَالَ : کَانَ یُحبُّ أَنْ یَبْلُغَ بِالتَّیَمُّمِ الْمِرْفَقَیْنِ۔","","Musannaf Ibn Abi Shaybah 1692","","","كتاب الطهارة"
"1693","(۱۶۹۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ قَالَ : التَّیَمُّمُ ضَرْبَتَانِ : ضَرْبَۃٌ لِلْوَجْہِ ، وَضَرْبَۃٌ لِلذِّرَاعَیْنِ إلَی الْمِرْفَقَیْنِ۔","","Musannaf Ibn Abi Shaybah 1693","","","كتاب الطهارة"
"1694","(۱۶۹۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ الْجَعْدِ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ سِیرِینَ وَصَالِحٍ أَبِی الْخَلِیلِ أَنَّہُمَا قَالاَ : التَّیَمُّمُ الوَجْہُ وَالْکَفَّانِ ۔ وَقَالَ سَعِیدُ بْنُ الْمُسَیَّبِ ، وَابْنُ عُمَرَ : الوَجْہُ وَالذِّرَاعَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 1694","","","كتاب الطهارة"
"1695","(۱۶۹۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أُمِرَ بِالتَّیَمُّمِ فِیمَا أُمِرَ فِیہِ بِالْغُسْلِ ، یَعْنِی : إنَّمَا ہُوَ الوَجْہُ وَالذِّرَاعَانِ۔","","Musannaf Ibn Abi Shaybah 1695","","","كتاب الطهارة"
"1696","(۱۶۹۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : التَّیَمُّمُ ضَرْبَتَانِ : ضَرْبَۃٌ لِلْوَجْہِ وَضَرْبَۃٌ لِلیَدیْنِ۔","","Musannaf Ibn Abi Shaybah 1696","","","كتاب الطهارة"
"1697","(۱۶۹۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی مَالِکٍ ، عَنْ عَمَّارٍ ؛ أَنَّہُ تَیَمَّمَ فَمَسَحَ بِیَدَیْہِ التُّرَابَ ، ثُمَّ نَفَضَہُمَا ، ثُمَّ مَسَحَ بِہِمَا وَجْہَہُ وَیَدَیْہِ ، وَلَمْ یَمْسَحْ ذِرَاعَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 1697","","","كتاب الطهارة"
"1698","(۱۶۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عَزْرَۃَ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ، عَنْ عَمَّارٍ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ فِی التَّیَمُّمِ : ضَرْبَۃٌ لِلْوَجْہِ وَالْکَفَّیْنِ۔n(ابن حبان ۱۳۰۸۔ ابوداؤد ۳۳۱)","Sahih","Musannaf Ibn Abi Shaybah 1698","","","كتاب الطهارة"
"1699","(۱۶۹۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : رَأَیْتُہُ یَضْرِبُ بِیَدَیْہِ الأَرْضَ ، ثُمَّ نَفَضَہُمَا ، ثُمَّ یَمْسَحُ بِہِمَا وَجْہَہُ۔","","Musannaf Ibn Abi Shaybah 1699","","","كتاب الطهارة"
"1700","(۱۷۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَزْرَۃَ بْنِ ثَابِتٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّہُ ضَرَبَ بِیَدَیْہِ الأَرْضَ ضَرْبَۃً فَمَسَحَ بِہِمَا وَجْہَہُ ، ثُمَّ ضَرَبَ بِہِمَا الأَرْضَ ضَرْبَۃً أُخْرَی فَمَسَحَ بِہِمَا ذِرَاعَیْہِ إلَی الْمِرْفَقَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 1700","","","كتاب الطهارة"
"1701","(۱۷۰۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ بُرْدٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : لَمَّا نَزَلَتْ آیَۃُ التَّیَمُّمِ لَمْ أَدْرِ کَیْفَ أَصْنَعُ ، فَأَتَیْت النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَلَمْ أَجِدْہُ ، فَانْطَلَقْتُ أَطْلُبُہُ فَاسْتَقْبَلْتُہُ ، فَلَمَّا رَآنی عَرَفَ الَّذِی جِئْتُ لَہُ ، فَبَالَ ، ثُمَّ ضَرَبَ بِیَدَیْہِ الأَرْضَ فَمَسَحَ بِہِمَا وَجْہَہُ وَکَفَّیْہِ۔","","Musannaf Ibn Abi Shaybah 1701","","","كتاب الطهارة"
"1702","(۱۷۰۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ؛ أَنَّہُ قَالَ فِی التَّیَمُّم ضَرْبَتَانِ : ضَرْبَۃٌ لِلْوَجْہِ ، وَضَرْبَۃٌ لِلذِّرَاعَیْنِ إلَی الْمِرْفَقَیْنِ۔","","Musannaf Ibn Abi Shaybah 1702","","","كتاب الطهارة"
"1703","(۱۷۰۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : تَیَمَّمُ لِکُلِّ صَلاَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 1703","","","كتاب الطهارة"
"1704","(۱۷۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ یُصَلَّی بِالتَّیَمُّمِ إِلاَّ صَلاَۃٌ وَاحِدَۃٌ۔","","Musannaf Ibn Abi Shaybah 1704","","","كتاب الطهارة"
"1705","(۱۷۰۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ یَنْقُضُ التَّیَمُّمَ إِلاَّ الْحَدَثُ۔","","Musannaf Ibn Abi Shaybah 1705","","","كتاب الطهارة"
"1706","(۱۷۰۶) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ الْمُثَنَّی بْنِ الصَّبَّاحِ ، عَنْ عَطَائٍ ، قَالَ : یُصَلَّی بِالتَّیَمُّمِ الصَّلَوَاتُ کُلُّہَا مَا لَمْ یُحْدِثْ۔","","Musannaf Ibn Abi Shaybah 1706","","","كتاب الطهارة"
"1707","(۱۷۰۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہَمَّامٍ ، عَنْ عَامِرٍ الأَحْوَلِ ، عَنْ عَمْرِو بْنِ الْعَاصِ ، قَالَ : یَتَیَمَّمُ لِکُلِّ صَلاَۃٍ ۔ وَکَانَ یُفتی بِذَلِکَ قَتَادَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 1707","","","كتاب الطهارة"
"1708","(۱۷۰۸) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنْ ثَوْرٍ ، عَنْ مَکْحُولٍ ، قَالَ : لاَ یُصَلَّی تَطَوُّعًا بِتَیَمُّمٍ ، وَلاَ یُصَلَّی صَلاَتَانِ بِتَیَمُّمٍ وَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 1708","","","كتاب الطهارة"
"1709","(۱۷۰۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : کَانَ یُعْجِبُہُ أَنْ یَتَیَمَّمَ لِکُلِّ صَلاَۃٍ۔","","Musannaf Ibn Abi Shaybah 1709","","","كتاب الطهارة"
"1710","(۱۷۱۰) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ، عَنْ أَبِی حَنِیفَۃَ، عَنْ حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: الْمُتَیَمِّمُ عَلَی تَیَمُّمِہِ مَا لَمْ یُحْدِثْ۔","","Musannaf Ibn Abi Shaybah 1710","","","كتاب الطهارة"
"1711","(۱۷۱۱) حَدَّثَنَا شَرِیکٌ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : یَتَلَوَّمُ الْجُنُبُ مَا بَیْنَہُ وَبَیْنَ آخِرِ الْوَقْتِ۔","Da'if","Musannaf Ibn Abi Shaybah 1711","","","كتاب الطهارة"
"1712","(۱۷۱۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا قَالاَ : لاَ یَتَیَمَّمُ مَا رَجَا أَنْ یَقْدِرَ عَلَی الْمَائِ فِی الْوَقْتِ۔","","Musannaf Ibn Abi Shaybah 1712","","","كتاب الطهارة"
"1713","(۱۷۱۳) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا کُنْتَ فِی الْحَضَرِ وَحَضَرَتِ الصَّلاَۃُ وَلَیْسَ عِنْدَکَ مَائٌ فَانْتَظِرِ الْمَائَ ، فَإِنْ خَشِیتَ فَوْتَ الصَّلاَۃِ فَتَیَمَّمْ وَصَلِّ۔","","Musannaf Ibn Abi Shaybah 1713","","","كتاب الطهارة"
"1714","(۱۷۱۴) حَدَّثَنَا جَرِیرٌ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ: أَطْیَبُ الصَّعِیدِ: الْحَرْثُ أَو: أَرْضُ الْحَرْثِ۔","Da'if","Musannaf Ibn Abi Shaybah 1714","","","كتاب الطهارة"
"1715","(۱۷۱۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا أَدْرَکَتِ الرَّجُلَ الصَّلاَۃُ ، وَلَمْ یَجِدِ الْمَائَ ، وَلَمْ یَصِلْ إلَی الأَرْضِ ضَرَبَ بِیَدَیْہِ عَلَی سَرْجِہِ وَعَلَی لِبَدِہِ ، ثُمَّ تَیَمَّمَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1715","","","كتاب الطهارة"
"1716","(۱۷۱۶) حَدَّثَنَا رَوَّادُ بْنُ جَرَّاحٍ ، أَبُو عِصَامٍ ، عَنْ صَدَقَۃَ بْنِ یَزِیدَ ، عَنْ حَمَّادٍ ، قَالَ : یُتَیَمَّمُ بِالصَّعِیدِ وَالْجِصِّ وَالْجَبَلِ وَالرَّمْلِ۔","","Musannaf Ibn Abi Shaybah 1716","","","كتاب الطهارة"
"1717","(۱۷۱۷) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : کُلُّ شَیْئٍ ضَرَبْتَ عَلَیْہِ بِیَدَیْکَ فَہُوَ صَعِیدٌ حَتَّی غُبَارُ لِبَدِک۔","","Musannaf Ibn Abi Shaybah 1717","","","كتاب الطهارة"
"1718","(۱۷۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : یُتَیَمَّم بِالْکلأِ وَالْجَبَلِ۔","","Musannaf Ibn Abi Shaybah 1718","","","كتاب الطهارة"
"1719","(۱۷۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ ، عَنْ أَبِی عُثْمَانَ النَّہْدی ، قَالَ : بَلَغَنِی أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: تَمَسَّحُوا بِہَا فَإِنَّہَا بِکُمْ بَرَّۃٌ ، یَعْنِی : الأَرْضَ۔ (طبرانی ۴۱۶)","","Musannaf Ibn Abi Shaybah 1719","","","كتاب الطهارة"
"1720","(۱۷۲۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ زَمْعَۃَ بْنِ صَالِحٍ ، عَنْ عِیسَی بْنِ أَزْدَادَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا بَالَ أَحَدُکُمْ فَلْیَنْترْ ذَکَرَہُ ثَلاَثَ نَتَرَاتٍ۔ (احمد ۴/۳۴۷۔ ابن ماجہ ۳۲۶)","Da'if","Musannaf Ibn Abi Shaybah 1720","","","كتاب الطهارة"
"1721","(۱۷۲۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی الشَّعْثَائِ ، قَالَ : إذَا بُلْتَ فَامْسَحْ ذَکَرَک مِنْ أَسْفَلَ ، فَإِنَّہُ یَنْقَطِعُ۔","","Musannaf Ibn Abi Shaybah 1721","","","كتاب الطهارة"
"1722","(۱۷۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زَمْعَۃَ بْنِ صَالِحٍ ، عَنْ عِیسَی بْنِ یَزْدَادَ ، عَنْ أَبِیہِ ، أَنَّہُ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا بَالَ أَحَدُکُمْ فَلْیَنْترْ ذَکَرَہُ ثَلاَثًا ، قَالَ زَمْعَۃُ : فَإِنَّ ذَلِکَ یُجْزِئُ عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 1722","","","كتاب الطهارة"
"1723","(۱۷۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمْزَۃَ الزَّیَّاتِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ زَاذَانَ ، عَنْ عَلِیٍّ : فِی الْفَأْرَۃِ تَقَعُ فِی الْبِئْرِ ، قَالَ: تُنزحُ إلَی أَنْ یَغْلِبَہُمُ الْمَائُ۔","","Musannaf Ibn Abi Shaybah 1723","","","كتاب الطهارة"
"1724","(۱۷۲۴) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الْحَسَنِ ؛ فِی الْفَأْرَۃِ تَقَعُ فِی الْبِئْرِ ، قَالَ : یُسْتَقَی مِنْہَا أَرْبَعُونَ دَلْوًا۔","","Musannaf Ibn Abi Shaybah 1724","","","كتاب الطهارة"
"1725","(۱۷۲۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الْجُرَذِ ، أَوِ السِّنَّوْرِ یَقَعُ فِی الْبِئْرِ ، قَالَ : یَدْلُوا مِنْہَا أَرْبَعِینَ دَلْوًا ، قَالَ مُغِیرَۃُ : حتَّی یَتَغَیَّرَ الْمَائُ۔","","Musannaf Ibn Abi Shaybah 1725","","","كتاب الطهارة"
"1726","(۱۷۲۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیث ، عَنْ عَطَائٍ ، قَالَ : إذَا وَقَعَ الْجُرَذُ فِی الْبِئْرِ نُزِحَ مِنْہَا عِشْرُونَ دَلْوًا ، فَإِنْ تَفَسَّخَ فَأَرْبَعُونَ دَلْوًا ، فَإِذَا وَقَعَتِ الشَّاۃُ نُزِحَ مِنْہَا أَرْبَعُونَ دَلْوًا ، فَإِنْ تَفَسَّخَتْ نُزِحَتْ کُلُّہَا ، أَوْ مِئَۃ دَلْوٍ۔","","Musannaf Ibn Abi Shaybah 1726","","","كتاب الطهارة"
"1727","(۱۷۲۷) حَدَّثَنَا ہُشَیْمٌ، عَنْ عَبْدِاللہِ بْنِ سَبْرَۃَ، عَنِ الشَّعْبِیِّ؛ أَنَّہُ قَالَ: یُدْلَی مِنْہَا سَبْعُونَ دَلْوًا، یَعْنِی: فِی الدَّجَاجَۃِ۔","","Musannaf Ibn Abi Shaybah 1727","","","كتاب الطهارة"
"1728","(۱۷۲۸) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الْبِئْرِ تَقَعُ فَتَمُوتُ فِیہَا الدَّجَاجَۃُ وَأَشْبَاہُہَا ، قَالَ : اسْتَقِ مِنْہَا دَلْوًا وَتَوَضَّأْ مِنْہَا ، فَإِنْ ہِیَ تَفَسَّخَتِ اسْتَقِ مِنْہَا أَرْبَعِینَ دَلْوًا۔","","Musannaf Ibn Abi Shaybah 1728","","","كتاب الطهارة"
"1729","(۱۷۲۹) حَدَّثَنَا الْمُحَارِبِیُّ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَمَّادٍ ؛ فِی الْبِئْرِ یَقَعُ فِیہَا الدَّجَاجَۃُ وَالْکَلْبُ وَالسِّنَّوْرُ فَیَمُوتُ ، قَالَ : یَنْزِحُ مِنْہَا ثَلاَثِینَ ، أَوْ أَرْبَعِینَ دَلْوًا۔","","Musannaf Ibn Abi Shaybah 1729","","","كتاب الطهارة"
"1730","(۱۷۳۰) حَدَّثَنَا عُبَیْدُاللہِ بْنُ مُوسَی، عَنْ جَعْفَرِ بْنِ بُرْقَانَ، عَنِ الزُّہْرِیِّ؛ فِی الدَّابَّۃِ تَقَعُ فِی الْبِئْرِ، قَالَ: إِنْ لَمْ یَتَغَیَّرْ طَعْمُ الْمَائِ وَلاَ رِیحُہُ ، فَلاَ أَرَی بِالْمَائِ بَأْسًا ، فَإِنْ تَغَیَّرَ طَعْمُ الْمَائِ وَرِیحُہُ نَزَحُوا مِنْہَا حَتَّی یَطِیبَ الْمَائُ۔","","Musannaf Ibn Abi Shaybah 1730","","","كتاب الطهارة"
"1731","(۱۷۳۱) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ؛ فِی الدَّجَاجَۃِ تَقَعُ فِی الْبِئْرِ ، قَالَ : یُسْتَقَی مِنْہَا أَرْبَعُونَ دَلْوًا۔","","Musannaf Ibn Abi Shaybah 1731","","","كتاب الطهارة"
"1732","(۱۷۳۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ خَالِدِ بْنِ سَلَمَۃَ ؛ أَنَّ عَلِیًّا سُئِلَ عَنْ صَبِیٍّ بَالَ فِی الْبِئْرِ ؟ قَالَ : تُنْزَحُ۔","Hasan","Musannaf Ibn Abi Shaybah 1732","","","كتاب الطهارة"
"1733","(۱۷۳۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنْ عَطَائٍ ؛ أَنَّ حَبَشِیًّا وَقَعَ فِی زَمْزَمَ فَمَاتَ ، قَالَ : فَأَمَرَ ابْنُ الزُّبَیْرِ أنْ یُنْزَفَ مَائُ زَمْزَمَ ، قَالَ : فَجَعَلَ الْمَائُ لاَ یَنْقَطِعُ ، قَالَ : فَنَظَرُوا فَإِذَا عَیْنٌ تَنْبُعُ مِنْ قِبَلِ الْحَجَرِ الأَسْوَدِ ، قَالَ : فَقَالَ ابْنُ الزُّبَیْرِ : حَسْبُکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 1733","","","كتاب الطهارة"
"1734","(۱۷۳۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ زِنْجِیًّا وَقَعَ فِی زَمْزَمَ فَمَاتَ ، قَالَ : فَأَنْزَلَ إلَیْہِ رَجُلاً فَأَخْرَجَہُ ، ثُمَّ قَالَ : انْزِفُوا مَا فِیہَا مِنْ مَائٍ ، ثُمَّ قَالَ لِلَّذِی فِی الْبِئْرِ : ضَعْ دَلْوَک مِنْ قِبَلِ الْعَیْنِ الَّتِی تَلِی الْبَیْتَ ، أَوِ الرُّکْنَ فَإِنَّہَا مِنْ عُیُونِ الْجَنَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 1734","","","كتاب الطهارة"
"1735","(۱۷۳۵) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدَ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ زَیْدِ بْنِ خَالِدٍ الْجُہَنِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَسَّ فَرْجَہُ فَلْیَتَوَضَّأْ۔n(احمد ۵/۱۹۴۔ طبرانی ۵۲۲۲)","Hasan","Musannaf Ibn Abi Shaybah 1735","","","كتاب الطهارة"
"1736","(۱۷۳۶) حَدَّثَنَا مُعَلَّی بْنُ مَنْصُورٍ ، قَالَ: حدَّثَنَا الْہَیْثُمُ بْنُ حُمَیْدٍ ، عَنِ الْعَلاَئِ بْنِ الْحَارِثِ ، عَنْ مَکْحُولٍ ، عَنْ عَنْبَسَۃَ بْنِ أَبِی سُفْیَانَ ، عَنْ أُمِّ حَبِیبَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَسَّ فَرْجَہُ فَلْیَتَوَضَّأْ۔ (ابن ماجہ ۴۸۱)","","Musannaf Ibn Abi Shaybah 1736","","","كتاب الطهارة"
"1737","(۱۷۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، قَالَ : سَمِعْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ یُحَدِّثُ أَبِی ، قَالَ : ذَاکَرَنِی مَرْوَانُ مَسَّ الذَّکَرِ ، فَقُلْتُ : لَیْسَ فِیہِ وُضُوئٌ ، قَالَ : فَإِنَّ بُسْرَۃَ ابْنَۃَ صَفْوَانَ تُحَدِّثُ فِیہِ ، فَبَعَثَ إلَیْہَا رَسُولاً فَذَکَرَ أَنَّہَا حَدَّثَتْ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ مَسَّ ذَکَرَہُ فَلْیَتَوَضَّأْ۔n(ابوداؤد ۱۸۳۔ ترمذی ۸۳)","Sahih","Musannaf Ibn Abi Shaybah 1737","","","كتاب الطهارة"
"1738","(۱۷۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُ عَبِیْدَۃَ عَنْ قولہ تعالی : {أَوْ لاَمَسْتُمُ النِّسَائَ} ؟ فَقَالَ : بِیَدِہِ ، فَظَنَنْت مَا عَنَی فَلَمْ أَسْأَلْہُ ، قَالَ : وَنُبِّئْتُ ، أَنَّ ابْنَ عُمَرَ کَانَ إذَا مَسَّ فَرْجَہُ تَوَضَّأَ ، قَالَ مُحَمَّدٌ : فَظَنَنْت أَنَّ قَوْلَ ابْنِ عُمَرَ وَقَوْلَ عَبِیْدَۃَ شَیْئٌ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 1738","","","كتاب الطهارة"
"1739","(۱۷۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شُعْبَۃَ ، عَنْ یَزِیدَ الرِّشْکِ ، قَالَ : سَمِعْتُ جَابِرَ بْنَ زَیْدٍ یَقُولُ : إذَا مَسَّہُ مُتَعَمِّدًا أَعَادَ الْوُضُوئَ۔","","Musannaf Ibn Abi Shaybah 1739","","","كتاب الطهارة"
"1740","(۱۷۴۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : إذَا أَمْسَکَ ذَکَرَہُ تَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1740","","","كتاب الطهارة"
"1741","(۱۷۴۱) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، أَنَّہُ سَمِعَ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُول : مَنْ مَسَّ ذَکَرَہُ فَالْوُضُوئُ عَلَیْہِ وَاجِبٌ۔","","Musannaf Ibn Abi Shaybah 1741","","","كتاب الطهارة"
"1742","(۱۷۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، قَالَ : کُنْتُ أُمْسِکُ عَلَی أَبِی الْمُصْحَفَ ، فَأَدْخَلْتُ یَدَیَّ ہَکَذَا ، یَعْنِی : مَسَّ ذَکَرَہُ ، فَقَالَ لَہُ : تَوَضَّأْ۔","Sahih","Musannaf Ibn Abi Shaybah 1742","","","كتاب الطهارة"
"1743","(۱۷۴۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ صَلَّی یَوْمًا مِنَ الضُّحَی ، وَقَالَ : إنِّی کُنْتُ مَسِسْت ذَکَرِی فَنَسِیتُ۔","Sahih","Musannaf Ibn Abi Shaybah 1743","","","كتاب الطهارة"
"1744","(۱۷۴۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ إذَا مَسَّ فَرْجَہُ أَعَادَ الْوُضُوئَ۔","Sahih","Musannaf Ibn Abi Shaybah 1744","","","كتاب الطهارة"
"1745","(۱۷۴۵) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، قَالَ : سَمِعْتُ ابْنَ أَبِی نَجِیحٍ یَذْکُرُ ، قَالَ : قَالَ عَطَائٌ وَمُجَاہِدٌ : مَنْ مَسَّ ذَکَرَہُ فَلْیَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 1745","","","كتاب الطهارة"
"1746","(۱۷۴۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ أَخِی الزُّہْرِیِّ قَالَ سَمِعْتُ الزُّہْرِیَّ یَقُولُ : مَنْ مَسَّ ذَکَرَہُ تَوَضَّأَ۔","","Musannaf Ibn Abi Shaybah 1746","","","كتاب الطهارة"
"1747","(۱۷۴۷) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ قَتَادَۃَ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ قَالاَ : مَنْ مَسَّ ذَکَرَہُ تَوَضَّأَ۔","Sahih","Musannaf Ibn Abi Shaybah 1747","","","كتاب الطهارة"
"1748","(۱۷۴۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ خُضَیْرٍ ، قَالَ : سُئِلَ طَاوُوس عَنْ مَسِّ الذَّکَرِ وَالرَّجُلُ فِی الصَّلاَۃِ ؟ فَقَالَ : أُفٍّ أُفٍّ ، وَلِمَ یَمَسُّہُ ؟ یَتَوَضَّأ۔","","Musannaf Ibn Abi Shaybah 1748","","","كتاب الطهارة"
"1749","(۱۷۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ؛ أَنَّ أَخَاہُ أَرْقَمَ بْنَ شُرَحْبِیلَ سَأَلَ ابْنَ مَسْعُودٍ ، فَقَالَ : إنِّی أَحْتَکُّ فَأُفْضِی بِیَدَیَّ إلَی فَرْجِی ؟ فَقَالَ ابْنُ مَسْعُودٍ : إِنْ عَلِمْتَ أَنَّ مِنْک بِضْعَۃً نَجِسَۃً فَاقْطَعْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 1749","","","كتاب الطهارة"
"1750","(۱۷۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، قَالَ : سَأَلَ رَجُلٌ سَعْدًا عَنْ مَسِّ الذَّکَرِ ؟ فَقَالَ : إِنْ عَلِمْت أَنَّ مِنْک بِضْعَۃً نَجِسَۃً فَاقْطَعْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 1750","","","كتاب الطهارة"
"1751","(۱۷۵۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ حُذَیْفَۃَ بْنِ الْیَمَانِ ، أَنَّہُ قَالَ : مَا أُبَالِی مَسِسْت ذَکَرِی ، أَوْ أُذُنِی۔","Sahih","Musannaf Ibn Abi Shaybah 1751","","","كتاب الطهارة"
"1752","(۱۷۵۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ قَیْسِ بْنِ سَکَنٍ ، قَالَ : قَالَ عَبْدُ اللہِ : مَا أُبَالِی مَسِسْت ذَکَرِی ، أَوْ إبْہَامِی ، أَوْ أُذُنِی ، أَوْ أَنْفِی۔","Hasan","Musannaf Ibn Abi Shaybah 1752","","","كتاب الطهارة"
"1753","(۱۷۵۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، مِثْلَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 1753","","","كتاب الطهارة"
"1754","(۱۷۵۴) حَدَّثَنَا ابْنُ فُضَیْلٍ وَوَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عُمَیْرِ بْنِ سَعِیْدٍ ، قَالَ : کُنْتُ جَالِسًا فِی مَجْلِسٍ فِیہِ عَمَّارُ بْنُ یَاسِرٍ ، فَسُئِلَ عَنْ مَسِّ الذَّکَرِ فِی الصَّلاَۃِ ؟ فَقَالَ : مَا ہُوَ إِلاَّ بِضْعَۃٌ مِنْک ، وَإِنَّ لِکَفِّکَ مَوْضِعًا غَیْرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1754","","","كتاب الطهارة"
"1755","(۱۷۵۵) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ؛ أَنَّ عِمْرَانَ بْنَ حُصَیْنٍ ، قَالَ : مَا أُبَالِی إیَّاہُ مَسِسْت ، أَوْ بَطْنَ فَخِذِی ، یَعْنِی : ذَکَرَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 1755","","","كتاب الطهارة"
"1756","(۱۷۵۶) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، عَنْ قَیْسِ بْنِ طَلْقٍ ، عَنْ أَبِیہِ طَلْقِ بْنِ عَلِیٍّ ، قَالَ : خَرَجْنَا وَفْدًا حَتَّی قَدِمْنَا عَلَی رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَبَایَعْنَاہُ وَصَلَّیْنَا مَعَہُ ، فَجَائَ رَجُلٌ ، فَقَالَ : یَا رَسُولَ اللہِ ، مَا تَرَی فِی مَسِّ الذَّکَرِ فِی الصَّلاَۃِ ؟ فَقَالَ : وَہَلْ ہُوَ إِلاَّ بِضْعَۃٌ ، أَوْ مُضْغَۃٌ مِنْک ؟n(ابوداؤد ۱۸۴۔ ترمذی ۸۵)","Hasan","Musannaf Ibn Abi Shaybah 1756","","","كتاب الطهارة"
"1757","(۱۷۵۷) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ، قَالَ : سُئِلَ عَلِیٌّ عَنِ الرَّجُلِ یَمَسُّ ذَکَرَہُ ؟ قَالَ : لاَ بَأْسَ۔","Da'if","Musannaf Ibn Abi Shaybah 1757","","","كتاب الطهارة"
"1758","(۱۷۵۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : سَأَلْتُہُ عَنْ مَسِّ الذَّکَرِ فِی الصَّلاَۃِ ؟ فَقَالَ : مَا أُبَالِی مَسَسْتُہُ ، أَوْ أَنْفِی۔","","Musannaf Ibn Abi Shaybah 1758","","","كتاب الطهارة"
"1759","(۱۷۵۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَمَسَّ الرَّجُلُ ذَکَرَہُ فِی الصَّلاَۃِ۔","","Musannaf Ibn Abi Shaybah 1759","","","كتاب الطهارة"
"1760","(۱۷۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی حَمْزَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ حُذَیْفَۃُ : مَا أُبَالِی مَسَسْتُہُ ، أَوْ طَرَفَ أَنْفِی ، وَقَالَ عَلِیٌّ : مَا أُبَالِی مَسِسْتُہُ ، أَمْ طَرَفَ أُذُنِی۔","Da'if","Musannaf Ibn Abi Shaybah 1760","","","كتاب الطهارة"
"1761","(۱۷۶۱) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، عَنْ إبْرَاہِیمَ بْنِ نَافِعٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، قَالَ : قَالَ طَاوُوس وَسَعِیدُ بْنُ جُبَیْرٍ : مَنْ مَسَّ ذَکَرَہُ وَہُوَ لاَ یُرِیدُ فَلَیْسَ عَلَیْہِ وُضُوئٌ","","Musannaf Ibn Abi Shaybah 1761","","","كتاب الطهارة"
"1762","(۱۷۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ الزُّبَیْرِ ، عَنِ الْقَاسِمِ ، عَنْ أَبِی أُمَامَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنْ مَسِّ الذَّکَرِ ؟ فَقَالَ : ہَلْ ہُوَ إِلاَّ حِذْوَۃٌ مِنْک۔ (عبدالرزاق ۴۲۵۔ ابن ماجہ ۴۸۴)","Da'if","Musannaf Ibn Abi Shaybah 1762","","","كتاب الطهارة"
"1763","(۱۷۶۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : حَدَّثَنَا زَائِدَۃُ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ سُئِلَ عَنْ مَسِّ الذَّکَرِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 1763","","","كتاب الطهارة"
"1764","(۱۷۶۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ عْن رَجُلٍ تَنَخَّع فَوَقَعَتْ نُخَاعَتُہُ فِی طَہُورِہِ ؟ فَقَالَ : یَأْخُذُہَا ہَکَذَا فَیَطْرَحُہَا ، وَقَالَ شُعْبَۃُ : بِیَدِہِ یَصِفُ ، أَنَّہُ یَغْرِفُہَا مِنَ الإِنَائِ فَیَطْرَحُہَا۔","","Musannaf Ibn Abi Shaybah 1764","","","كتاب الطهارة"
"1765","(۱۷۶۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی النُّخَاعَۃِ قَالَ : خُذْہَا وَخُذْ مَا حَمَلَتْ ، فَإِنْ کَانَ فِیہَا بُزَاقٌ أَفْسَدَتِ الطَّہُورَ ، أَوِ الْمَائَ۔","","Musannaf Ibn Abi Shaybah 1765","","","كتاب الطهارة"
"1766","(۱۷۶۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ؛ فِی النُّخَامَۃِ تَقَعُ فِی الْمَائِ ، قَالَ : أَلْقِہَا وَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 1766","","","كتاب الطهارة"
"1767","(۱۷۶۷) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : اللَّمْسُ بِالْیَدِ۔","","Musannaf Ibn Abi Shaybah 1767","","","كتاب الطهارة"
"1768","(۱۷۶۸) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ الْجِمَاعُ۔","Sahih","Musannaf Ibn Abi Shaybah 1768","","","كتاب الطهارة"
"1769","(۱۷۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ دَاوُدَ ، عَنْ جَعْفَرِ بْنِ إیَاسٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 1769","","","كتاب الطهارة"
"1770","(۱۷۷۰) حَدَّثَنَا حَفْصٌ، عَنْ أَشْعَثَ، عَنِ الشَّعْبِیِّ، عَنْ أَصْحَابِ عَبْدِاللہِ ، عَنْ عَبْدِاللہِ، قَالَ: اللَّمْسُ مَا دُونَ الْجِمَاعِ۔","","Musannaf Ibn Abi Shaybah 1770","","","كتاب الطهارة"
"1771","(۱۷۷۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، عَنْ أَصْحَابِ عَلِیٍّ ، عَنْ عَلِیٍّ : {أَوْ لاَمَسْتُمُ النِّسَائَ} قَالَ : ہُوَ الْجِمَاعُ۔","Da'if","Musannaf Ibn Abi Shaybah 1771","","","كتاب الطهارة"
"1772","(۱۷۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ الْجِمَاعُ۔","Sahih","Musannaf Ibn Abi Shaybah 1772","","","كتاب الطهارة"
"1773","(۱۷۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، قَالَ : مَا دُونَ الْجِمَاعِ۔","","Musannaf Ibn Abi Shaybah 1773","","","كتاب الطهارة"
"1774","(۱۷۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُ عَبِیْدَۃَ عَنْ قولہ تعالی : {أَوْ لاَمَسْتُمُ النِّسَائَ} فَقَالَ : بِیَدِہِ فَظَنَنْت مَا عَنَی فَلَمْ أَسْأَلْہُ۔","","Musannaf Ibn Abi Shaybah 1774","","","كتاب الطهارة"
"1775","(۱۷۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ أَبِی عُبَیْدَۃَ ، قَالَ : مَا دُونَ الْجِمَاعِ۔","","Musannaf Ibn Abi Shaybah 1775","","","كتاب الطهارة"
"1776","(۱۷۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُ عَبِیْدَۃَ عَنْ قولہ تعالی : {أَوْ لاَمَسْتُمُ النِّسَائَ} فَقَالَ : بِیَدِہِ ہَکَذَا ، وَقَبَضَ کَفَّہُ۔","","Musannaf Ibn Abi Shaybah 1776","","","كتاب الطهارة"
"1777","(۱۷۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَال[corrupt] : الْمُلاَمَسَۃُ الْجِمَاعُ۔","","Musannaf Ibn Abi Shaybah 1777","","","كتاب الطهارة"
"1778","(۱۷۷۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْمُلاَمَسَۃُ مَا دُونَ الْجِمَاعِ۔","","Musannaf Ibn Abi Shaybah 1778","","","كتاب الطهارة"
"1779","(۱۷۷۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : اخْتَلَفْت أَنَا وَأُنَاسٌ مِنَ الْعَرَبِ فِی اللَّمْسِ ، فَقُلْتُ : أَنَا وَأُنَاسٌ مِنَ الْمَوَالِی : اللَّمْسُ مَا دُونَ الْجِمَاعِ ، وَقَالَتِ الْعَرَبُ: ہُوَ الْجِمَاعُ ، فَأَتَیْنَا ابْنَ عَبَّاسٍ ، فَقَالَ : غَلَبَتِ الْعَرَبُ ، ہُوَ الْجِمَاعُ۔","Sahih","Musannaf Ibn Abi Shaybah 1779","","","كتاب الطهارة"
"1780","(۱۷۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ ، قَالَ : الْقُبْلَۃُ مِنَ اللَّمْسِ وَفِیہَا الْوُضُوئُ ، وَاللَّمْسُ مَا دُونَ الْجِمَاعِ۔","","Musannaf Ibn Abi Shaybah 1780","","","كتاب الطهارة"
"1781","(۱۷۸۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : اللَّمْسُ وَالْمَسُّ وَالْمُبَاشَرَۃُ إلَی الْجِمَاعِ ، وَلَکِنَّ اللَّہَ یَکْنِیْ مَا شَائَ لِمَا شَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 1781","","","كتاب الطهارة"
"1782","(۱۷۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ فِی قَطْرَۃِ خَمْرٍ وَقَعَتْ فِی مَائٍ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 1782","","","كتاب الطهارة"
"1783","(۱۷۸۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْحُبِّ ) تَقْطُرُ فِیہِ الْقَطْرُ مِنَ الْخَمْرِ ، أَوِ الدَّمِ؟ قَالَ : یُہْرَاقُ۔","","Musannaf Ibn Abi Shaybah 1783","","","كتاب الطهارة"
"1784","(۱۷۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْیدِ اللہِ بْنِ أَبِی زِیَادٍ ، قَالَ : رَأَیْتُ مُجَاہِدًا یَتَوَضَّأُ فَنَضَحَ فَرْجَہُ ، وَذُکِرَ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَعَلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 1784","","","كتاب الطهارة"
"1785","(۱۷۸۵) حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَۃَ ، عَنْ یَزِیدَ مَوْلَی سَلَمَۃَ ؛ أَنَّ سَلَمَۃَ کَانَ یَنْضَحُ بَیْنَ جِلْدِہِ وَثِیَابِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 1785","","","كتاب الطهارة"
"1786","(۱۷۸۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، قَالَ : کَانَ ابْنُ عُمَرَ إذَا تَوَضَّأَ نَضَحَ فَرْجَہُ ، قَالَ عُبَیْدُ اللہِ : وَکَانَ أَبِی یَفْعَلُ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 1786","","","كتاب الطهارة"
"1787","(۱۷۸۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنِ مِقْسَم ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إنَّ الشَّیْطَانَ یَأْتِی أَحَدَکُمْ وَہُوَ فِی الصَّلاَۃِ فَیَبلَّ إحْلِیلِہِ حَتَّی یُرِیَہُ أَنَہُ قَدْ أَحْدَثَ، فَمَنْ رَابَہُ ذَلِکَ فَلْیَنْتَضِحْ بِالْمَائِ، فَمَنْ رَابَہُ مِنْ ذَلِکَ شَیْء فَلْیَقُلْ: ہُوَ عَمَلُ الْمَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 1787","","","كتاب الطهارة"
"1788","(۱۷۸۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ مَوْلًی لابْنِ أَزْہَرَ ، قَالَ : شَکَوْت إلَی ابْنِ عُمَرَ الْبَوْلَ ، فَقَالَ : إذَا تَوَضَّأْت فَانْضَحْ وَالْہَ عَنْہُ ، فَإِنَّہُ مِنَ الشَّیْطَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 1788","","","كتاب الطهارة"
"1789","(۱۷۸۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، قَالَ : أَخْبَرَنِی أَخِی ، قَالَ : سَأَلْتُ الْقَاسِمَ عَنِ الْبِلَّۃِ أَجِدُہَا فِی الصَّلاَۃِ ؟ فَقَالَ : یَا ابْنَ أَخِی ، انْضَحْہُ وَالْہَ عَنْہُ ، فَإِنَّمَا ہُوَ مِنَ الشَّیْطَانِ ، قَالَ : فَفَعَلْتُ فَذَہَبَ عَنِّی۔","","Musannaf Ibn Abi Shaybah 1789","","","كتاب الطهارة"
"1790","(۱۷۹۰) حَدَّثَنَا خَالِدُ بْنُ حَیَّانَ ، عَنْ جَعْفَرٍ ، قَالَ : جَائَ رَجُلٌ إلَی مَیْمُونِ بْنِ مِہْرَانَ فَشَکَی إلَیْہِ بِلَّۃً یَجِدُہَا ، فَقَالَ لَہُ مَیْمُونٌ : إذَا أَنْتَ تَوَضَّأْت فَانْضَحْ فَرْجَک ، وَمَا یَلِیہِ مِنْ ثَوْبِکَ بِالْمَائِ ، فَإِنْ وَجَدْت مِنْ ذَلِکَ شَیْئًا فَقُلْ : ہُوَ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 1790","","","كتاب الطهارة"
"1791","(۱۷۹۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ إذَا تَوَضَّأَ فَفَرَغَ ، قَالَ : بِکَفٍّ مِنْ مَائٍ فِی إزَارِہِ ہَکَذَا۔","","Musannaf Ibn Abi Shaybah 1791","","","كتاب الطهارة"
"1792","(۱۷۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، قَالَ : قَالَ مَنْصُورٌ : حَدَّثَنِی مُجَاہِدٌ ، عَنِ الْحَکَمِ بْنِ سُفْیَانَ الثَّقَفِیِّ ؛ أَنَّہُ رَأَی النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ ثُمَّ أَخَذَ کَفًّا مِنْ مَائٍ فَنَضَحَ بِہِ فَرْجَہُ۔n(ابوداؤد ۱۶۸۔ احمد ۴۰۹)","","Musannaf Ibn Abi Shaybah 1792","","","كتاب الطهارة"
"1793","(۱۷۹۳) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا ابْنُ لَہِیعَۃَ ، عَنْ عُقَیْلٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ عُرْوَۃَ ، عَنْ أُسَامَۃَ بْنِ زَیْدِ بْنِ حَارِثَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ تَوَضَّأَ ثُمَّ أَخَذَ کَفًّا مِنْ مَائٍ فَنَضَحَ بِہِ فَرْجَہُ۔n(احمد ۱۶۱۔ ابن ماجہ ۴۹۲)","Da'if","Musannaf Ibn Abi Shaybah 1793","","","كتاب الطهارة"
"1794","(۱۷۹۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ حُذَیْفَۃَ بْنِ الْیَمَانِ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا قَامَ فَتَہَجَّدَ یَشُوصُ فَاہُ بِالسِّوَاکِ۔ (بخاری ۱۱۳۶۔ مسلم ۴۶)","Sahih","Musannaf Ibn Abi Shaybah 1794","","","كتاب الطهارة"
"1795","(۱۷۹۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ حُذَیْفَۃَ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ ، إِلاَّ أَنَّہُ لَمْ یَقُلْ بِالسِّوَاکِ۔ (مسلم ۲۲۰)","Sahih","Musannaf Ibn Abi Shaybah 1795","","","كتاب الطهارة"
"1796","(۱۷۹۶) حَدَّثَنَا شَرِیکٌ ، عَنِ الْمِقْدَامِ بْنِ شُرَیْحٍ ، عَنْ أَبِیہِ ، قَالَ : سَأَلْتُ عَائِشَۃَ قُلْتُ : أَخْبِرِینِی بِأَیِّ شَیْئٍ کَانَ یَبْدَأُ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا دَخَلَ عَلَیْکِ ؟ قَالَتْ : کَانَ یَبْدَأُ بِالسِّوَاکِ۔ n(مسلم ۲۲۰۔ ابوداؤد ۵۲)","Hasan","Musannaf Ibn Abi Shaybah 1796","","","كتاب الطهارة"
"1797","(۱۷۹۷) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِی سَلَمَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ ، عَنْ زَیْدِ بْنِ خَالِدٍ الْجُہَنِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : لَوْلاَ أَنْ أَشُقَّ عَلَی أُمَّتِی لأَمَرْتُہُمْ بِالسِّوَاکِ عِنْدَ کُلِّ صَلاَۃٍ ، قَالَ : فَکَانَ زَیْدُ بْنُ خَالِدٍ سِوَاکُہُ عَلَی أُذُنِہِ مَوْضِعَ الْقَلَمِ مِنْ أُذُنِ الْکَاتِبِ ، فَلاَ یَقُومُ لِصَلاَۃٍ إِلاَّ اسْتَنَّ ، ثُمَّ رَدَّہُ فِی مَوْضِعِہِ۔ (ابوداؤد ۴۸۔ ترمذی ۲۳)","","Musannaf Ibn Abi Shaybah 1797","","","كتاب الطهارة"
"1798","(۱۷۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : لَوْلاَ أَنْ أَشُقَّ عَلَی أُمَّتِی لأَمَرْتُہُمْ بِالسِّوَاکِ عِنْدَ کُلِّ وُضُوئٍ۔n(احمد ۲/۴۳۳۔ نسائی ۳۰۳۷)","Sahih","Musannaf Ibn Abi Shaybah 1798","","","كتاب الطهارة"
"1799","(۱۷۹۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ حَرَامِ بْنِ عُثْمَانَ ، عَنْ أَبِی عَتِیقٍ ، عَنْ جَابِرٍ ، قَالَ : کَانَ یَسْتَاکُ إذَا أَخَذَ مَضْجَعَہُ ، وَإِذَا قَامَ مِنَ اللَّیْلِ ، وَإِذَا خَرَجَ إلَی الصُّبْحِ ، قَالَ : فَقُلْتُ لَہُ : قَدْ شَقَقْتَ عَلَی نَفْسِکَ بِہَذَا السِّوَاکِ ؟ فَقَالَ : إنَّ أُسَامَۃَ أَخْبَرَنِی أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ یَسْتَاکُ ہَذَا السِّوَاکَ۔","Da'if","Musannaf Ibn Abi Shaybah 1799","","","كتاب الطهارة"
"1800","(۱۸۰۰) حَدَّثَنَا عَثَّامُ بْنُ عَلِیٍّ ، عَنِ الأَعْمَشِ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یُصَلِّی رَکْعَتَیْنِ ، ثُمَّ یَسْتَاکُ۔ (احمد ۱/۲۱۸۔ نسائی ۴۰۵)","Hasan","Musannaf Ibn Abi Shaybah 1800","","","كتاب الطهارة"
"1801","(۱۸۰۱) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مَنْصُورٍ ، عَنْ شَقِیقٍ ، عَنْ حُذَیْفَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا قَامَ مِنَ اللَّیْلِ یَشُوصُ فَاہُ بِالسِّوَاکِ۔","Sahih","Musannaf Ibn Abi Shaybah 1801","","","كتاب الطهارة"
"1802","(۱۸۰۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، قَالَ : حَدَّثَنِی عَل[corrupt]یُّ بْنُ زَیْدِ بْنِ جُدْعَانَ ، قَالَ حَدَّثَتْنِی أُمُّ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ لاَ یَرْقُدُ لَیْلاً ، وَلاَ نَہَارًا فَیَسْتَیْقِظُ إِلاَّ تَسَوَّکَ قَبْلَ أَنْ یَتَوَضَّأَ۔n(ابن سعد ۴۸۳۔ احمد ۶/۱۲۱)","Da'if","Musannaf Ibn Abi Shaybah 1802","","","كتاب الطهارة"
"1803","(۱۸۰۳) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا إبْرَاہِیمُ بْنُ إسْمَاعِیلَ بْنِ أَبِی حَبِیبَۃَ ، قَالَ : أَخْبَرَنِی دَاوُد بْنُ الْحُصَیْنِ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : السِّوَاکُ مَطْہَرَۃٌ لِلْفَمِ ، مَرْضَاۃٌ لِلرَّبِّ۔ (احمد ۶/۱۴۶۔ دارمی ۶۸۴)","Da'if","Musannaf Ibn Abi Shaybah 1803","","","كتاب الطهارة"
"1804","(۱۸۰۴) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ التَّمِیمِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَقَدْ کُنَّا نُؤْمَرُ بِالسِّوَاکِ حَتَّی ظَنَنَّا ، أَنَّہُ سَیَنْزِلُ فِیہِ۔ (طیالسی ۲۷۳۹)","Hasan","Musannaf Ibn Abi Shaybah 1804","","","كتاب الطهارة"
"1805","(۱۸۰۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ صَالِحِ بْنِ کَیْسَانَ ؛ أَنَّ عُبَادَۃَ بْنَ الصَّامِتِ وَأَصْحَابَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانُوا یَرُوحُونَ وَالسِّوَاکُ عَلَی آذَانِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 1805","","","كتاب الطهارة"
"1806","(۱۸۰۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ قَرْمٍ ، عَنْ أَبِی حَبِیبٍ ، عَنْ رَجُلٍ مِنْ أَہْلِ الْحِجَازِ ، عَنْ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَوْلاَ أَنْ أَشُقَّ عَلَی أُمَّتِی لأَمَرْتُہُمْ بِالسِّوَاکِ عِنْدَ کُلِّ صَلاَۃٍ۔ (طبرانی فی الکبیر ۳۲۵)","Da'if","Musannaf Ibn Abi Shaybah 1806","","","كتاب الطهارة"
"1807","(۱۸۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ جُحَادَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : السِّوَاکُ مَطْہَرَۃٌ لِلْفَمِ جَلاَئٌ لِلْعَینِ۔","","Musannaf Ibn Abi Shaybah 1807","","","كتاب الطهارة"
"1808","(۱۸۰۸) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ عَبْدِ اللہِ بْنِ یَسَارٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی، عَنْ بَعْضِ أَصْحَابِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، رَفَعَہُ ، قَالَ : لَوْلاَ أَنْ أَشُقَّ عَلَی أُمَّتِی لَفَرَضْتُ عَلَی أُمَّتِی السِّوَاکَ کَمَا فَرَضْتُ عَلَیْہِمُ الطَّہُورَ۔ (احمد ۵/۴۱۰۔ البزار ۱۳۰۲)","","Musannaf Ibn Abi Shaybah 1808","","","كتاب الطهارة"
"1809","(۱۸۰۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِِ ، عَنْ وَاصِلٍ ، عَنْ أَبِی سُورَۃَ ابْنِ أَخِی أَبِی أَیُّوبَ ، عَنْ أَبِی أَیُّوبَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ یَسْتَاکُ فِی اللَّیْلَۃِ مِرَارًا۔ (احمد ۵/۴۱۷)","Da'if","Musannaf Ibn Abi Shaybah 1809","","","كتاب الطهارة"
"1810","(۱۸۱۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا قَامَ أَحَدُکُمْ مِنَ اللَّیْلِ فَلْیَسْتَکْ ، فَإِنَّ الرَّجُلَ إذَا قَامَ مِنَ اللَّیْلِ فَتَسَوَّکَ ، ثُمَّ تَوَضَّأَ ثُمَّ قَامَ إلَی الصَّلاَۃِ ، جَائَہُ الْمَلَکُ حَتَّی یَقُومَ خَلْفَہُ یَسْتَمِعُ الْقُرْآنَ ، فَلاَ یَزَالُ یَدْنُو مِنْہُ حَتَّی یَضَعَ فَاہُ عَلَی فِیہِ ، فَلاَ یَقْرَأُ آیَۃً إِلاَّ دَخَلَتْ جَوْفَہُ۔ (بزار ۶۰۳)","Sahih","Musannaf Ibn Abi Shaybah 1810","","","كتاب الطهارة"
"1811","(۱۸۱۱) حَدَّثَنَا جَرِیرٌ، عَنْ مَنْصُورٍ، عَنِ الْحَکَمِ، قَالَ: نَزَلْتُ عَلَی مُجَاہِدٍ فَکَانَ أَشَدَّ شَیْئٍ مُوَاظَبَۃً عَلَی السِّوَاکِ۔","","Musannaf Ibn Abi Shaybah 1811","","","كتاب الطهارة"
"1812","(۱۸۱۲) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ الأَصَمِّ ، قَالَ : کَانَ سِوَاکُ مَیْمُونَۃَ ابْنَۃِ الْحَارِثِ زَوْجِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ مُنْقَعًا فِی مَائٍ ، فَإِنْ شَغَلَہَا عَنْہُ عَمَلٌ ، أَوْ صَلاَۃٌ ، وَإِلا فَأَخَذَتْہُ وَاسْتَاکَتْ۔","Hasan","Musannaf Ibn Abi Shaybah 1812","","","كتاب الطهارة"
"1813","(۱۸۱۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، قَالَ : قَالَ أَبُو أَیُّوبَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : أَرْبَعٌ مِنْ سُنَنِ الْمُرْسَلِینَ : التَّعَطُّر ، وَالنِّکَاحُ ، وَالسِّوَاکُ ، وَالْحِنَّائُ۔ n(ترمذی ۱۰۸۰۔ احمد ۵/۴۲۱)","","Musannaf Ibn Abi Shaybah 1813","","","كتاب الطهارة"
"1814","(۱۸۱۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الأَوْزَاعِیُّ ، عَنْ حَسَّانَ بْنِ عَطِیَّۃَ ، قَالَ : الْوُضُوئُ شَطْرُ الإِیمَانِ ، وَالسِّوَاکُ شَطْرُ الْوُضُوئِ ، وَلَوْلاَ أَنْ أَشُقَّ عَلَی أُمَّتِی لأَمَرْتُہُمْ بِالسِّوَاکِ عِنْدَ کُلِّ صَلاَۃٍ ۔ رَکْعَتَانِ یَسْتَاکُ فِیہِمَا الْعَبْدُ أَفْضَلُ مِنْ سَبْعِینَ رَکْعَۃً لاَ یَسْتَاکُ فِیہَا۔","","Musannaf Ibn Abi Shaybah 1814","","","كتاب الطهارة"
"1815","(۱۸۱۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لأَنْ أَکُونَ اسْتَقْبَلْتُ مِنْ أَمْرِی مَا اسْتَدْبَرْتُ، یَعْنِی: فِی السِّوَاکِ ، أَحَبُّ إلَیَّ مِنْ وَصیفَیْنِ ، قَالَ : وَکَانَ ابْنُ عُمَرَ لاَ یَأْکُلُ الطَّعَامَ إِلاَّ اسْتَنَّ ، یَعْنِی : اسْتَاکَ۔","Sahih","Musannaf Ibn Abi Shaybah 1815","","","كتاب الطهارة"
"1816","(۱۸۱۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : سَمِعْتُ مُجَاہِدًا ، قَالَ : اسْتَبْطَأَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ جِبْرِیلَ ، فَقَالَ : وَکَیْفَ نَأْتِیکُمْ وَأَنْتُمْ لاَ تَقُصُّونَ أَظْفَارَکُمْ ، وَلاَ تُنَقُّونَ بَرَاجِمَکُمْ ، وَلاَ تَسْتَاکُونَ۔","","Musannaf Ibn Abi Shaybah 1816","","","كتاب الطهارة"
"1817","(۱۸۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنْ سُلَیْمَانَ بْنِ سَعدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : اسْتَاکُوا وَتَنَظَّفُوا ، وَأَوْتِرُوا فَإِنَّ اللَّہَ وِتْرٌ یُحِبُّ الْوِتْرَ۔","","Musannaf Ibn Abi Shaybah 1817","","","كتاب الطهارة"
"1818","(۱۸۱۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمُنْذِرِ بْنِ ثَعْلَبَۃَ الْعَبْدِیِّ ، عَنْ عَبْدِ اللہِ بْنِ بُرَیْدَۃَ الأَسْلَمِیِّ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا اسْتَیْقَظَ مِنْ أَہْلِہِ دَعَا جَارِیَۃً یُقَالُ لَہَا : بَرِیرَۃُ بِالسِّوَاکِ۔","","Musannaf Ibn Abi Shaybah 1818","","","كتاب الطهارة"
"1819","(۱۸۱۹) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ مُحَمَّدِ بْنِ جُحَادَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : السِّوَاکُ جَلاَئٌ لِلْعَیْنِ طَہُورٌ لِلْفَمِ۔","","Musannaf Ibn Abi Shaybah 1819","","","كتاب الطهارة"
"1820","(۱۸۲۰) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إسْرَائِیلُ، عَنْ أَبِی إِسْحَاقَ، عَنِ التَّمِیمِیِّ، قَالَ: سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ السِّوَاکِ؟ فَقَالَ : لَمْ یَزَلْ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَأْمُرُ بِہِ حَتَّی ظَنَنَّا أَنَّہُ سَیَنْزِلُ عَلَیْہِ فِیہِ۔","Hasan","Musannaf Ibn Abi Shaybah 1820","","","كتاب الطهارة"
"1821","(۱۸۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ صَالِحِ بْنِ کَیْسَانَ ، قَالَ : کَانَ الرَّجُلُ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَرُوحُ وَالسِّوَاکُ عَلَی أُذُنِہِ۔","","Musannaf Ibn Abi Shaybah 1821","","","كتاب الطهارة"
"1822","(۱۸۲۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَارِثِ ، عَنْ شُعَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : أَکْثَرْتُ عَلَیْکُمْ فِی السِّوَاکِ۔ (بخاری ۸۸۸۔ احمد ۳/۱۴۳)","Sahih","Musannaf Ibn Abi Shaybah 1822","","","كتاب الطهارة"
"1823","(۱۸۲۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ مَوْلًی لِلْحَیِّ ، قَالَ : کَانَ أَبُو عُبَیْدَۃَ یَسْتَاکُ بَعْدَ الْوِتْرِ قَبْلَ الرَّکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 1823","","","كتاب الطهارة"
"1824","(۱۸۲۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ السِّوَاکِ ؟ فَقَالَ : وَمَنْ یُطِیقُ السِّوَاکَ ؟ کَانُوا یَسْتَاکُونَ بَعْدَ الْوِتْرِ قَبْلَ الرَّکْعَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 1824","","","كتاب الطهارة"
"1825","(۱۸۲۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، وَأَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَسْتَاکُ مَرَّتَیْنِ قَبْلَ الْفَجْرِ وَقَبْلَ الظُّہْرِ۔","","Musannaf Ibn Abi Shaybah 1825","","","كتاب الطهارة"
"1826","(۱۸۲۶) حَدَّثَنَا جَرِیرٌ ، عَنِ الأَعْمَشِ ، قَالَ : کَانَ یَحْیَی بْنُ وَثَّابٍ یَسْتَاکُ فِی الْمَسْجِدِ ، فَإِذَا أُقِیمَتِ الصَّلاَۃُ صَلَّی ، وَلَمْ یَمَسَّ مَائً۔","","Musannaf Ibn Abi Shaybah 1826","","","كتاب الطهارة"
"1827","(۱۸۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، عَنْ جَرِیرٍ ؛ أَنَّہُ کَانَ یَسْتَاکُ وَیَأْمُرُہُمْ أَنْ یَتَوَضَّؤُوا بِفَضْلِ سِوَاکِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 1827","","","كتاب الطهارة"
"1828","(۱۸۲۸) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالْوُضُوئِ مِنْ فَضْلِ السِّوَاکِ۔","","Musannaf Ibn Abi Shaybah 1828","","","كتاب الطهارة"
"1829","(۱۸۲۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ سَلْمِ بْنِ أَبِی الذیَّالِ ، عَنِ الْحَسَنِ ؛ فِی الْمَرْأَۃِ یُصِیبُ ثَوْبَہَا مِنْ لَبَنِہَا أَتُصَلِّی ، وَلاَ تَغْسِلُ ثَوْبَہَا ؟ قَالَ : مَا بِلَبَنِہَا مِنْ نَجِسٍ۔","","Musannaf Ibn Abi Shaybah 1829","","","كتاب الطهارة"
"1830","(۱۸۳۰) حَدَّثَنَا مَالِکُ بْنُ إسْمَاعِیلَ ، قَالَ : حدَّثَنَا جَعْفَرٌ الأَحْمَرُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِلَبَنِ الْمَرْأَۃِ أَنْ یُصِیبَ ثَوْبَہَا ، یَعْنِی : لَبَنَہَا۔","","Musannaf Ibn Abi Shaybah 1830","","","كتاب الطهارة"
"1831","(۱۸۳۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : قامَ رَجُلٌ مِنْ عِنْدِ ابْنِ عَبَّاسٍ ، فَقَالَ لَہُ : أَیْنَ؟ قَالَ : أُرِیقُ الْمَائَ ، قَالَ : لاَ تَقُلْ أُرِیقُ وَلَکِنْ قُلْ : أَبُولُ۔","Sahih","Musannaf Ibn Abi Shaybah 1831","","","كتاب الطهارة"
"1832","(۱۸۳۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُحَمَّدِ بْنِ مَیْسَرَۃَ ، عَنِ الأَزْرَقِ بْنِ قَیْسٍ ، أَنَّہُ سَمِعَ ابْنَ عُمَرَ ؛ أَنَّہُ کَرِہَ أَنْ یَقُولَ: أَقُومُ أُہریق الْمَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 1832","","","كتاب الطهارة"
"1833","(۱۸۳۳) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ بِلاَلٍ ، عَنْ سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنْ أَبِیہِ ، أَنَّ عُمَرَ قَالَ لِرَجُلٍ : لاَ تَقُلْ : أُہْرِیقُ الْمَائَ ، وَلَکِنْ قُلْ : أَبُولُ۔","Hasan","Musannaf Ibn Abi Shaybah 1833","","","كتاب الطهارة"
"1834","(۱۸۳۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ قَیْسٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ؛ أَنَّہُ کَرِہَ أَنْ یَقُولَ : أُہْرِیقُ الْمَائَ۔","Da'if","Musannaf Ibn Abi Shaybah 1834","","","كتاب الطهارة"
"1835","(۱۸۳۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ، عَنْ أَبِی رَافِعٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ لَقِیَہُ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فِی طَرِیقٍ مِنْ طُرُقِ الْمَدِینَۃِ وَہُوَ جُنُبٌ ، فَانْسَلَّ فَذَہَبَ فَاغْتَسَلَ ، فَفَقَدَہُ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا جَائَہُ قَالَ : أَیْنَ کُنْت یَا أَبَا ہُرَیْرَۃَ ؟ قَالَ : یَا رَسُولَ اللہِ ، لَقِیتَنِی وَأَنَا جُنُبٌ ، فَکَرِہْتُ أَنْ أُجَالِسَک حَتَّی أَغْتَسِلَ ، فَقَالَ : سُبْحَانَ اللہِ ، إنَّ الْمُؤْمِنَ لاَ یَنْجُسُ۔ (بخاری ۲۸۵۔ ابوداؤد ۲۳۴)","Sahih","Musannaf Ibn Abi Shaybah 1835","","","كتاب الطهارة"
"1836","(۱۸۳۶) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ وَاصِلٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ حُذَیْفَۃَ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لَقِیَہُ وَہُوَ جُنُبٌ ، فَأَعْرَضَ عَنْہُ فَاغْتَسَلَ ، ثُمَّ جَائَ ، فَقَالَ : إنَّ الْمُؤْمِنَ لاَ یَنْجُسُ۔ (ابوداؤد ۲۳۳۔ نسائی ۲۶۴)","Sahih","Musannaf Ibn Abi Shaybah 1836","","","كتاب الطهارة"
"1837","(۱۸۳۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : نُبِّئْتُ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ رَأَی حُذَیْفَۃَ فَرَاغَ فَقَالَ : أَلَمْ أَرَک ؟ فَقَالَ : بَلَی یَا رَسُولَ اللہِ ، وَلَکِنِّی کُنْتُ جُنُبًا ، فَقَالَ : إنَّ الْمُؤْمِنَ لاَ یَنْجُسُ۔","","Musannaf Ibn Abi Shaybah 1837","","","كتاب الطهارة"
"1838","(۱۸۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا زَکَرِیَّا بْنُ أَبِی زَائِدَۃَ ، قَالَ : سَمِعْتُ عَامِرًا یَذْکُرُ عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ یُجْنِبُ الْمَائُ ، وَلاَ الثَّوْبُ ، وَلاَ الأَرْضُ ، وَلاَ الإِنْسَان۔","Sahih","Musannaf Ibn Abi Shaybah 1838","","","كتاب الطهارة"
"1839","(۱۸۳۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی رَزِینٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا وَلَغَ الْکَلْبُ فِی إنَائِ أَحَدِکُمْ فَلْیَغْسِلْہُ سَبْعَ مَرَّاتٍ۔ (مسلم ۸۹۔ نسائی ۶۵)","Sahih","Musannaf Ibn Abi Shaybah 1839","","","كتاب الطهارة"
"1840","(۱۸۴۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : طَہُورُ إنَائِ أَحَدِکُمْ إذَا وَلَغَ فِیہِ الْکَلْبُ أَنْ یَغْسِلَہُ سَبْعَ مَرَّاتٍ ، أُولاَہُنَّ بِالتُّرَابِ۔ n(مسلم ۲۳۴۔ احمد ۲/۴۲۷)","Sahih","Musannaf Ibn Abi Shaybah 1840","","","كتاب الطهارة"
"1841","(۱۸۴۱) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ فِی الْکَلْبِ یَلَغُ فِی الإِنَائِ ، یُغْسَلُ سَبْعَ مَرَّاتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 1841","","","كتاب الطهارة"
"1842","(۱۸۴۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ حَرْمَلَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ ، قَالَ : اغْسِلْ إنَائَکَ مِنَ الْکَلْبِ سَبْعًا۔","","Musannaf Ibn Abi Shaybah 1842","","","كتاب الطهارة"
"1843","(۱۸۴۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الْکَلْبِ یَلَغُ فِی الإِنَائِ ، قَالَ : اغْسِلْہُ حَتَّی تُنْقِیَہُ۔","","Musannaf Ibn Abi Shaybah 1843","","","كتاب الطهارة"
"1844","(۱۸۴۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : اغْسِلْہُ حَتَّی تُنْقِیَہُ۔","","Musannaf Ibn Abi Shaybah 1844","","","كتاب الطهارة"
"1845","(۱۸۴۵) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی التَّیَّاحِ ، قَالَ : سَمِعْتُ مُطَرِّفًا یُحَدِّثُ عَنِ ابْنِ الْمُغَفَّلِ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَالَ : إذَا وَلَغَ الْکَلْبُ فِی الإنَائِ ، فَاغْسِلُوہُ سَبْعَ مَرَّاتٍ ، وَعَفِّرُوہُ الثَّامِنَۃَ بِالتُّرَابِ۔ (ابوداؤد ۷۵۔ نسائی ۷۰)","Sahih","Musannaf Ibn Abi Shaybah 1845","","","كتاب الطهارة"
"1846","(۱۸۴۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی طِینِ الْمَطَرِ یُصِیبُ ألثَّوْبَ ، قَالَ : إِنْ شَائَ غَسَلَہُ، وَإِنْ شَائَ تَرَکَہُ حَتَّی یَجِفَّ ، ثُمَّ یَفْرُکَہُ۔","","Musannaf Ibn Abi Shaybah 1846","","","كتاب الطهارة"
"1847","(۱۸۴۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ مُجَاہِدًا ، عَنْ طِینِ الْمَطَرِ یُصِیبُ الثَّوْبَ ؟ فَقَالَ : إذَا یَبِسَ فَحُتَّہُ۔","","Musannaf Ibn Abi Shaybah 1847","","","كتاب الطهارة"
"1848","(۱۸۴۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجِ بْنِ دِینَارٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ ، عَنْ طِینِ الْمَطَرِ یُصِیبُ ثَوْبِی ؟ فَقَالَ : الأَرْضُ الطَّیِّبَۃُ تُطِّیَبُ الأَرْضَ الْخَبِیثَۃَ۔","","Musannaf Ibn Abi Shaybah 1848","","","كتاب الطهارة"
"1849","(۱۸۴۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : کَانَتْ لِعُبَیْدِ بْنِ عُمَیْرٍ خُصْلَتَانِ ، فَکَانَ إذَا تَوَضَّأَ مَسَحَ عَلَیْہِمَا۔","","Musannaf Ibn Abi Shaybah 1849","","","كتاب الطهارة"
"1850","(۱۸۵۰) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : أَیُّ جَوَانِبِ رَأْسِکَ مَسَحْتَ أَجْزَأَک۔","","Musannaf Ibn Abi Shaybah 1850","","","كتاب الطهارة"
"1851","(۱۸۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ الأَزْرَقِ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَیُّ جَوَانِبِ رَأْسِکَ مَسَحْتَ أَجْزَأَک۔","","Musannaf Ibn Abi Shaybah 1851","","","كتاب الطهارة"
"1852","(۱۸۵۲) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ مَسَحَ مُقَدَّمَ رَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 1852","","","كتاب الطهارة"
"1853","(۱۸۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، قَالَ بَلَغَنِی ، أَنَّ ابْنَ عُمَرَ کَانَ یَقُولُ : یَکْفِیہِ مِنَ الْمَائِ ہَکَذَا ، وَوَصَفَ أَنَّہُ یَغْمِسُہُمَا فِی الْمَائِ ، ثُمَّ یَمْسَحُ رَأْسَہُ ہَکَذَا ؛ وَوَضَعَ کَفَّیْہِ وَسَطَ رَأْسِہِ ، ثُمَّ أَمَرَّہُمَا إلَی مُقَدَّمِ رَأْسِہِ۔","","Musannaf Ibn Abi Shaybah 1853","","","كتاب الطهارة"
"1854","(۱۸۵۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، قَالَ : سَأَلْتُ ابْنَ سِیرِینَ عَنِ الرَّجُلِ یَبُولُ فِی بَیْتِہِ الَّذِی یُصَلِّی فِیہِ ؟ فَکَرِہَہُ ، وَسَأَلْت الْحَسَنَ ، فَقَالَ : نَعَمْ ، وَلاَ یَتْرُکُہُ۔","","Musannaf Ibn Abi Shaybah 1854","","","كتاب الطهارة"
"1855","(۱۸۵۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ بَکْرِ بْنِ مَاعِزٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، یَحْسِبُہُ عَنْ أَبِیہِ ، قَالَ : لاَ تَبُولُ فِی طَسْتٍ فِی بَیْتٍ تُصَلِّی فِیہِ ، وَلاَ تَبُلْ فِی مُغْتَسَلِک۔","Sahih","Musannaf Ibn Abi Shaybah 1855","","","كتاب الطهارة"
"1856","(۱۸۵۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ مُحَارِبٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ بَوْلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 1856","","","كتاب الطهارة"
"1857","(۱۸۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ بْنِ أَبِی الْوَسِیمِ ، عَنْ سَلْمَانَ أَبِی شَدَّادٍ ، قَالَ : کَانَ أَبُو رَافِعٍ مَوْلَی النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَأْمُرُنِی أَنْ أُنَاوِلَہُ الْمِبْوَلَۃَ ، وَہُوَ عَلَی فِرَاشِہِ فَیَبُولُ فِیہَا۔","Da'if","Musannaf Ibn Abi Shaybah 1857","","","كتاب الطهارة"
"1858","(۱۸۵۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، قَالَ : حَدَّثَنَا سَعِیدُ بْنُ أَبِی بُرْدَۃَ ، قَالَ : رَأَیْتُ أَبَا وَائِلٍ جَالِسًا فِی مَسْجِدِ الْبَیْتِ ، ثُمَّ دَعَا بِطَسْتٍ فَبَالَ فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 1858","","","كتاب الطهارة"
"1859","(۱۸۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، عَنِ الْغُسْلِ وَالْوُضُوئِ بِالثَّلْجِ ؟ فَقَالَ : یَکْسِرُہُ وَیَغْتَسِلُ وَیَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 1859","","","كتاب الطهارة"
"1860","(۱۸۶۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَالْحَکَمِ قَالاَ : لاَ بَأْسَ بِالْوُضُوئِ بِالثَّلْجِ۔","","Musannaf Ibn Abi Shaybah 1860","","","كتاب الطهارة"
"1861","(۱۸۶۱) حَدَّثَنَا حَفْصٌ ، عَنْ شَیْخٍ ، قَالَ : کَانَ سَالِمٌ یَتَیَمَّمُ إذَا کَانَ الْمَائُ جَامِدًا۔","","Musannaf Ibn Abi Shaybah 1861","","","كتاب الطهارة"
"1862","(۱۸۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : وَکَانَ سُفْیَانُ یَسْتَحْسِنُہُ وَیَغْتَسِلُ مِنْہُ وَیَتَوَضَّأُ۔","Hasan","Musannaf Ibn Abi Shaybah 1862","","","كتاب الطهارة"
"1863","(۱۸۶۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ بْنِ عَبْدِ الْمَلِکِ ، عَنِ الْحَسَنِ ؛ سُئِلَ عَنْ رَجُلٍ اغْتَسَلَ بِالثَّلْجِ فَأَصَابَہُ الْبَرْدُ فَمَاتَ ؟ فَقَالَ : یَا لَہَا مِنْ شَہَادَۃٍ۔","","Musannaf Ibn Abi Shaybah 1863","","","كتاب الطهارة"
"1864","(۱۸۶۴) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، قَالَ : أَخْبَرَنَا دَاوُد بْنُ عَمْرٍو ، عَنْ بُسْرِ بْنِ عُبَیْدِ اللہِ الْحَضْرَمِیِّ ، عَنْ أَبِی إدْرِیسَ الْخَوْلاَنِیِّ ، قَالَ : حَدَّثَنَا عَوْفُ بْنُ مَالِکٍ الأَشْجَعِیُّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِالْمَسْحِ عَلَی الْخُفَّیْنِ فِی غَزْوَۃِ تَبُوکَ ؛ ثَلاَثَۃَ أَیَّامٍ وَلَیَالِیہِنَّ لِلْمُسَافِرِ ، وَیَوْمًا وَلَیْلَۃً لِلْمُقِیمِ۔n(احمد ۶/۲۷۔ دارقطنی ۱۸)","Hasan","Musannaf Ibn Abi Shaybah 1864","","","كتاب الطهارة"
"1865","(۱۸۶۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ، عَنْ أَفْلَحَ مَوْلَی أَبِی أَیُّوبَ ، عَنْ أَبِی أَیُّوبَ ؛ أَنَّہُ کَانَ یَأْمُرُ بِالْمَسْحِ عَلَی الْخُفَّیْنِ ، وَکَانَ ہُوَ یَغْسِلُ قَدَمَیْہِ ، فَقِیلَ لَہُ فِی ذَلِکَ : کَیْفَ تَأْمُرُ بِالْمَسْحِ وَأَنْتَ تَغْسِلُ؟ فَقَالَ: بِئْسَ مَا لِی إِنْ کَانَ مَہْنَأۃً لَکُمْ وَمَأْثَمۃً عَلَیَّ ، قَدْ رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَفْعَلُہُ وَیَأْمُرُ بِہِ ، وَلَکِنْ حُبِّبَ إلَیَّ الْوُضُوئُ۔ (احمد ۵/۴۲۱)","Sahih","Musannaf Ibn Abi Shaybah 1865","","","كتاب الطهارة"
"1866","(۱۸۶۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ أَخْبَرَنَا الأَعْمَش ، عَنْ أَبِی وَائِلٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَتَی سُبَاطَۃَ قَوْمٍ فَبَالَ عَلَیْہَا ، فَأَتَیْتُہُ بِمَائٍ فَتَوَضَّأَ ، وَمَسَحَ عَلَی خُفَّیْہِ۔ (ابوداؤد ۲۴۔ ترمذی ۱۳)","Sahih","Musannaf Ibn Abi Shaybah 1866","","","كتاب الطهارة"
"1867","(۱۸۶۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ أَخْبَرَنَا حُصَیْنٌ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، وَعَنْ أَبِی سُفْیَانَ ، أَنَّہُمَا سَمِعَا الْمُغِیرَۃَ بْنَ شُعْبَۃَ یُحَدِّثُ ، قَالَ : کُنْتُ مَعَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ فَبَرَزَ لِحَاجَتِہِ ، فَلَمَّا فَرَغَ أَتَیْتُہُ بِإِدَاوَۃٍ فِیہَا مَائٌ ، فَصَبَّہ عَلَیْہِ ، وَکَانَ عَلَیْہِ جُبَّۃٌ ضَیِّقَۃُ الْکُمَّیْنِ ، قَالَ : فَأَخْرَجَ یَدَہُ مِنْ تَحْتِ الْجُبَّۃِ ، فَغَسَلَ ذِرَاعَیْہِ ، وَمَسَحَ عَلَی خُفَّیْہِ۔ (بخاری ۱۸۲۔ مسلم ۲۶۹)","Sahih","Musannaf Ibn Abi Shaybah 1867","","","كتاب الطهارة"
"1868","(۱۸۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن ہَمَّامٍ ، قَالَ : بَالَ جَرِیرُ بْنُ عَبْدِ اللہِ وَتَوَضَّأَ وَمَسَحَ عَلَی خُفَّیْہِ ، فَقِیلَ لَہُ : أَتَفْعَلُ ہَذَا ؟ فَقَالَ : وَمَا یَمْنَعُنِی وَقَدْ رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَفْعَلُہُ ؟ قَالَ إبْرَاہِیمُ : فَکَانَ یُعْجِبُنَا حَدِیثُ جَرِیرٍ لأَنَّ إسْلاَمَہُ کَانَ بَعْدَ نُزُولِ الْمَائِدَۃِ۔n(بخاری ۳۸۷۔ مسلم ۲۲۷)","Sahih","Musannaf Ibn Abi Shaybah 1868","","","كتاب الطهارة"
"1869","(۱۸۶۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، قَالَ : حدَّثَنَا ضَمُرَۃَ بْنُ حَبِیبٍ ، عَنْ جَرِیرِ بْنِ عَبْدِ اللہِ، قَالَ : قَدِمْتُ عَلَی رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ بَعْدَ نُزُولِ سُورَۃِ الْمَائِدَۃِ ، فَرَأَیْتُہُ یَمْسَحُ عَلَی الْخُفَّیْنِ۔n(دارقطنی ۱۹۳)","Da'if","Musannaf Ibn Abi Shaybah 1869","","","كتاب الطهارة"
"1870","(۱۸۷۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوقٍ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : کُنْتُ مَعَ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ ، فَقَالَ : یَا مُغِیرَۃُ ، خُذِ الإِدَاوَۃَ ، قَالَ : فَأَخَذْتُہَُا ثُمَّ خَرَجْتُ مَعَہُ ، فَانْطَلَقَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ حَتَّی تَوَارَی عَنِّی فَقَضَی حَاجَتَہُ ، ثُمَّ جَائَ وَعَلَیْہِ جُبَّۃٌ شَامِیَّۃٌ ضَیِّقَۃُ الْکُمَّیْنِ ، فَذَہَبَ لِیُخْرِجَ یَدَہُ مِنْ کُمِّہَا ، فَضَاقَتْ ، فَأَخْرَجَ یَدَہُ مِنْ أَسْفَلِہَا ، فَصَبَبْتُ عَلَیْہِ ، فَتَوَضَّأَ وُضُوئَہُ لِلصَّلاَۃِ ، ثُمَّ مَسَحَ عَلَی خُفَّیْہِ ثُمَّ صَلَّی۔","Sahih","Musannaf Ibn Abi Shaybah 1870","","","كتاب الطهارة"
"1871","(۱۸۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ کَعْبِ بْنِ عُجْرَۃَ ، عَنْ بِلاَلٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ مَسَحَ عَلَی الْخُفَّیْنِ وَالْخِمَارِ۔","Sahih","Musannaf Ibn Abi Shaybah 1871","","","كتاب الطهارة"
"1872","(۱۸۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لَمَّا کَانَ یَوْمُ فَتْحِ مَکَّۃَ تَوَضَّأَ ، وَمَسَحَ عَلَی خُفَّیْہِ ، فَقَالَ لَہُ عُمَرُ : یَا رَسُولَ اللہِ ، رَأَیْتُک الْیَوْمَ صَنَعْتَ شَیْئًا لَمْ تَکُنْ لِتَصْنَعَہُ قَبْلَ الْیَوْمِ ، فَقَالَ : یَا عُمَرُ ، عَمْدًا صَنَعْتُہُ۔n(ابوداؤد ۱۷۴۔ ترمذی ۶۱)","Sahih","Musannaf Ibn Abi Shaybah 1872","","","كتاب الطهارة"
"1873","(۱۸۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ دَلْہَمِ بْنِ صَالِحٍ ، عَنْ حُجَیْرِ بْنِ عَبْدِ اللہِ الْکِنْدِیِّ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّجَاشِیَّ أَہْدَی إلَی النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ خُفَّیْنِ سَاذَجَیْنِ أَسْوَدَیْنِ ، فَلَبِسَہُمَا ثُمَّ تَوَضَّأَ ، وَمَسَحَ عَلَیْہِمَا۔ (ابوداؤد ۱۵۶۔ ترمذی ۲۸۲۰)","Da'if","Musannaf Ibn Abi Shaybah 1873","","","كتاب الطهارة"
"1874","(۱۸۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، قَالَ : حدَّثَنَا حَمَّادٌ ، عَنْ إِبْرَاہِیمَ ، عَن أَبِی عَبْدِ اللہِ الْجَدَلِیِّ ، عَنْ خُزَیْمَۃَ بْنِ ثَابِتٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَقُولُ : الْمَسْحُ لِلْمُسَافِرِ ثَلاثَۃٌ ، وَلِلْمُقِیمِ یَوْمٌ وَلَیْلَۃٌ۔ (ابوداؤد ۱۵۸۔ طبرانی ۳۷۶۳)","","Musannaf Ibn Abi Shaybah 1874","","","كتاب الطهارة"
"1875","(۱۸۷۵) حَدَّثَنا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ التَّیْمی ، عَنْ أَبِی عَبْدِ اللہِ الْجَدَلِیِّ ، عَنْ خُزَیْمَۃَ بْنِ ثَابِتٍ قَالَ : جَعَلَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ لِلْمُسَافِرِ یَمْسَحُ ثَلاَثًا ، وَلَوِ اسْتَزَدْنَاہُ لَزَادَنَا۔n(طیالسی ۱۲۱۸۔ طبرانی ۳۷۵۶)","Sahih","Musannaf Ibn Abi Shaybah 1875","","","كتاب الطهارة"
"1876","(۱۸۷۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ إبْرَاہِیمَ التَّیْمِیِّ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ أَبِی عَبْدِ اللہِ الْجَدَلِیِّ ، عَنْ خُزَیْمَۃَ بْنِ ثَابِتٍ قَالَ : جَعَلَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ الْمَسْحَ عَلَی الْخُفَّیْنِ ثَلاَثَۃَ أَیَّامٍ لِلْمُسَافِرِ، وَیَوْمًا لِلْمُقِیمِ، وَلَوْ مَضَی السَّائِلُ فِی مَسْأَلَتِہِ لَجَعَلَہَا خَمْسًا۔(ترمذی ۹۵۔ ابوداؤد ۱۵۸)","Sahih","Musannaf Ibn Abi Shaybah 1876","","","كتاب الطهارة"
"1877","(۱۸۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا حَجَّاجُ بْنُ أَرْطَاۃَ ، عَنْ یَحْیَی بْنِ عُبَیْدٍ البَہْرَانِیِّ ، عَنْ مُحَمَّدِ بْنِ سَعْدٍ ، قَالَ : وَکَانَ یَتَوَضَّأُ بِالزَّاوِیَۃِ ، فَخَرَجَ عَلَیْنَا ذَاتَ یَوْمٍ مِنَ الْبَرَازِ ، فَتَوَضَّأَ ، وَمَسَحَ عَلَی خُفَّیْہِ ، فَتَعَجَّبْنَا وَقُلْنَا : مَا ہَذَا ؟ فَقَالَ : حَدَّثَنِی أَبِی أَنَّہُ رَأَی رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فَعَلَ مِثْلَ مَا فَعَلْتُ۔n(احمد ۱/۱۸۶)","","Musannaf Ibn Abi Shaybah 1877","","","كتاب الطهارة"
"1878","(۱۸۷۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْقَاسِمِ بْنِ مُخَیْمِرَۃَ ، عَنْ شُرَیْحِ بْنِ ہَانِیئٍ الْحَارِثِیِّ ، قَالَ : سَأَلْتُ عَائِشَۃَ عَنِ الْمَسْحِ ، فَقَالَتْ : اِئْتِ عَلِیًّا ، فَإِنَّہُ أَعْلَمُ بِذَلِکَ مِنِّی فَاسْأَلْہُ ، فَأَتَیْتُ عَلِیًّا فَسَأَلْتُہُ عَنِ الْمَسْحِ ؟ فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَأْمُرُنَا أَنْ یَمْسَحَ الْمُقِیمُ یَوْمًا وَلَیْلَۃً ، وَالْمُسَافِرُ ثَلاَثًا۔ (مسلم ۲۳۲۔ احمد ۱/۱۱۳)","Sahih","Musannaf Ibn Abi Shaybah 1878","","","كتاب الطهارة"
"1879","(۱۸۷۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَاصِمٍ ، عَنْ ذِرٍّ ، قَالَ : أتَیْتُ صَفْوَانَ بْنَ عَسَّالٍ الْمُرَادِیَّ ، فَقَالَ : مَا جَائَ بِکَ ؟ قُلْتُ : ابْتِغَائَ الْعِلْمِ ، قَالَ : فَإِنَّ الْمَلاَئِکَۃَ تَضَعُ أَجْنِحَتَہَا لِطَالِبِ الْعِلْمِ۔n قَالَ : وَکَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إذَا کُنَّا فِی سَفَرٍ أَمَرَنَا أَنْ لاَ نَنْزِعَ أَخْفَافَنَا ثَلاَثَۃَ أَیَّامٍ ، إِلاَّ مِنْ جَنَابَۃٍ وَلَکِنْ مِنْ غَائِطٍ ، وَ بَوْلٍ ، وَنَوْمٍ۔ (ترمذی ۳۵۳۵۔ احمد ۴/۲۳۹)","Da'if","Musannaf Ibn Abi Shaybah 1879","","","كتاب الطهارة"
"1880","(۱۸۸۰) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : حَدَّثَنَا أَیُّوبُ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی إدْرِیسَ ، عَنْ بِلاَلٍ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَمْسَحُ عَلَی الْمُوقَیْنِ وَالْخِمَارِ۔ n(ابن خزیمۃ ۱۸۹۔ احمد ۱۵)","","Musannaf Ibn Abi Shaybah 1880","","","كتاب الطهارة"
"1881","(۱۸۸۱) حَدَّثَنَا یُونُسُ ، عَنْ دَاوُدَ بْنِ أَبِی الْفُرَاتِ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ أَبِی شُرَیْحٍ ، عَنْ أَبِی مُسْلِمٍ مَوْلَی زَیْدِ بْنِ صُوحَانَ ، قَالَ : کُنْتُ مَعَ سَلْمَانَ ، فَرَأَی رَجُلاً یَنْزِعُ خُفَّیْہِ لِلْوُضُوئِ ، فَقَالَ لَہُ سَلْمَانُ : امْسَحْ عَلَی خُفَّیْک وَعَلَی خِمَارِکَ وَامْسَحْ بِنَاصِیَتِکَ ، فَإِنِّی رَأَیْت رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَمْسَحُ عَلَی الْخُفَّیْنِ وَالْخِمَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 1881","","","كتاب الطهارة"
"1882","(۱۸۸۲) حَدَّثَنَا یَحْیَی بْنُ إِسْحَاقَ ، قَالَ : حَدَّثَنَا یَحْیَی بْنُ أَیُّوبَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ رَزِینٍ ، عَنْ مُحَمَّدِ بْنِ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ أَیُّوبَ بْنِ قَطَنٍ الْکِنْدِیِّ ، عَنْ أُبَیِّ بْنِ عِمَارَۃَ الأَنْصَارِیِّ ، قَالَ : وَکَانَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَدْ صَلَّی فِی بَیْتِہِ لِلْقِبْلَتَیْنِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، أَمْسَحُ عَلَی الْخُفَّیْنِ ؟ قَالَ : نَعَمْ ، قَالَ: قُلْتُ: یَا رَسُولَ اللہِ ، یَوْمًا ؟ قَالَ : نَعَمْ وَیَوْمَیْنِ ، قُلْتُ : یَا رَسُولَ اللہِ ، یَوْمَیْنِ ؟ قَالَ : نَعَمْ ، وَثَلاَثَۃً ، قَالَ : قُلْتُ: یَا رَسُولَ اللہِ ، وَثَلاَثَۃً ؟ قَالَ : نَعَمْ ، وَمَا شِئْت۔ (ابوداؤد ۱۵۹۔ طبرانی ۵۴۵)","Da'if","Musannaf Ibn Abi Shaybah 1882","","","كتاب الطهارة"
"1883","(۱۸۸۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إسْمَاعِیلَ بْنِ مُحَمَّدٍ ، عَنْ حَمْزَۃَ بْنِ الْمُغِیرَۃِ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ قَضَی حَاجَتَہُ ، ثُمَّ جَائَ فَتَوَضَّأَ ، وَمَسَحَ بِرَأْسِہِ ، وَمَسَحَ عَلَی خُفَّیْہِ۔n(مسلم ۳۱۸۔ عبدالرزاق ۷۴۹)","Sahih","Musannaf Ibn Abi Shaybah 1883","","","كتاب الطهارة"
"1884","(۱۸۸۴) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ خَالِدِ بْنِ أَبِی بَکْر ، أَخْبَرَنِی سَالِمُ بْنُ عَبْدِ اللہِ ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ سَأَلَہُ سَعْدُ بْنُ أَبِی وَقَّاصٍ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ ؟ فَقَالَ عُمَرُ : سَمِعْت النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَأْمُرُ بِالْمَسْحِ عَلَی الْخُفَّیْنِ ، إذَا لبسہُمَا وَہُمَا طَاہِرَتَانِ۔ (ابویعلی ۱۷۱)","","Musannaf Ibn Abi Shaybah 1884","","","كتاب الطهارة"
"1885","(۱۸۸۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، وَیَحْیَی بْنُ آدَمَ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَاصِمٍ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ، عَنْ عُمَرَ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَمْسَحُ عَلَی الْخُفَّیْنِ بِالْمَائِ فِی السَّفَرِ۔n(احمد ۱/۵۴)","Da'if","Musannaf Ibn Abi Shaybah 1885","","","كتاب الطهارة"
"1886","(۱۸۸۶) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ شَیْبَانَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، أَنَّ جَعْفَرَ بْنَ عَمْرِو بْنِ أُمَیَّۃَ أَخْبَرَہُ ، أَنَّ أَبَاہُ أَخْبَرَہُ ، أَنَّہُ رَأَی رَسُول اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَمْسَحُ عَلَی الْخُفَّیْنِ۔n(بخاری ۲۰۴۔ احمد ۵/۲۸۸)","Hasan","Musannaf Ibn Abi Shaybah 1886","","","كتاب الطهارة"
"1887","(۱۸۸۷) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، قَالَ : حدَّثَنَا الأَوْزَاعِیُّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ جَعْفَرِ بْنِ عَمْرِو بْنِ أُمَیَّۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ مَسَحَ عَلَی الْخُفَّیْنِ وَالْعِمَامَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 1887","","","كتاب الطهارة"
"1888","(۱۸۸۸) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ، قَالَ : خَطَبَنَا الْمُغِیرَۃُ بْنُ شُعْبَۃَ ، فَقَالَ : أَیُّہَا النَّاسُ ، إنِّی کُنْتُ مَعَ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ فِی رَکْبٍ ، فَنَزَلَ فَقَضَی حَاجَتَہُ ، فَأَتَیْتُہُ بِمَائٍ فَتَوَضَّأَ ، وَمَسَحَ عَلَی خُفَّیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 1888","","","كتاب الطهارة"
"1889","(۱۸۸۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ عَمْرِو بْنِ وَہْبٍ الثَّقَفِیِّ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ذَہَبَ لِیَحْسِرَ یَدَہُ ، وَعَلَیْہِ جُبَّۃٌ شَامِیَّۃٌ ضَیِّقَۃُ الْکُمَّیْنِ ، فَأَخْرَجَ یَدَہُ مِنْ تَحْتِہَا إخْرَاجًا ، فَغَسَلَ وَجْہَہُ وَیَدَیْہِ ، ثُمَّ مَسَحَ بِنَاصِیَتِہِ ، وَمَسَحَ عَلَی الْعِمَامَۃِ ، وَمَسَحَ عَلَی الْخُفَّیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 1889","","","كتاب الطهارة"
"1890","(۱۸۹۰) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا عَبْدُ الْوَہَّابِ ، قَالَ : حَدَّثَنَا الْمُہَاجِرُ مَوْلَی الْبَکَرَاتِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرۃَ، عَنْ أَبِیہِ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ جَعَلَ لِلْمُسَافِرِ یَمْسَحُ ثَلاَثَۃَ أَیَّامٍ وَلَیَالِیہِنَّ، وَلِلْمُقِیمِ یَوْمًا وَلَیْلَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 1890","","","كتاب الطهارة"
"1891","(۱۸۹۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ أَخْبَرَنَا یَزِیدُ بْنُ أَبِی زِیَادٍ ، قَالَ : حدَّثَنَا زَیدُ بْنُ وَہْبٍ ، قَالَ : کَتَبَ إلَیْنَا عُمَرُ بْنُ الْخَطَّابِ فِی الْمَسْحِ عَلَی الْخُفَّیْنِ ؛ ثَلاَثَۃَ أَیَّامٍ وَلَیَالِیہِنَّ لِلْمُسَافِرِ ، وَیَوْمًا وَلَیْلَۃً لِلْمُقِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 1891","","","كتاب الطهارة"
"1892","(۱۸۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی مَالِکٍ الأَشْجَعِیِّ ، عَنْ أَبِی حَازِمٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ، قَالَ فِی الْمَسْحِ عَلَی الْخُفَّیْنِ : لِلْمُسَافِرِ ثَلاَثٌ وَلِلْمُقِیمِ یَوْمٌ إلَی اللَّیْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 1892","","","كتاب الطهارة"
"1893","(۱۸۹۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، قَالَ : قلْنَا لِنُبَاتَۃَ الْجُعْفِیِّ ، وَکَانَ أَجْرَأَنَا عَلَی عُمَرَ : یَسْأَلہُ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ ، فَسَأَلَہُ ، فَقَالَ : لِلْمُسَافِرِ ثَلاَثَۃُ أَیَّامٍ ، وَلِلْمُقِیمِ یَوْمٌ وَلَیْلَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 1893","","","كتاب الطهارة"
"1894","(۱۸۹۴) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا جَرِیرُ بْنُ أَیُّوبَ ، عَنْ أَبِی زُرْعَۃَ بْنِ عَمْرٍو قَالَ : رَأَیْتُ جَرِیرًا یَمْسَح عَلَی خُفَّیْہِ ، قَالَ : وَقَالَ أَبُو زُرْعَۃَ : قَالَ أَبُو ہُرَیْرَۃَ : قَالَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ : إذَا أَدْخَلَ أَحَدُکُمْ رِجْلَیْہِ فِی خُفَّیْہِ وَہُمَا طَاہِرَتَانِ فَلْیَمْسَحْ عَلَیْہِمَا ؛ ثَلاَثًا لِلْمُسَافِرِ ، وَیَوْمًا لِلْمُقِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 1894","","","كتاب الطهارة"
"1895","(۱۸۹۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، وَسَعْدَ بْنَ مَالِکٍ ، وَابْنَ مَسْعُودٍ کَانُوا یَمْسَحُونَ عَلَی الْخُفَّیْنِ۔","","Musannaf Ibn Abi Shaybah 1895","","","كتاب الطهارة"
"1896","(۱۸۹۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ ؟ فَقَالَ : امْسَحْ عَلَیْہِمَا۔","Da'if","Musannaf Ibn Abi Shaybah 1896","","","كتاب الطهارة"
"1897","(۱۸۹۷) حَدَّثَنَا ہُشَیْمٌ قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : مَسَحَ أَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی الْخُفَّیْنِ ، فَمَنْ تَرَکَ ذَلِکَ رَغْبَۃً عَنْہُ ، فَإِنَّمَا ہُوَ مِنَ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 1897","","","كتاب الطهارة"
"1898","(۱۸۹۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا حُصَیْنٌ ، عَنْ مُحَارِبٍ ، عَنِ ابْنِ عُمَرَ قَالَ: اخْتَلَفْتُ أَنَا وَسَعْدٌ بِالْقَادِسیَّۃِ فِی الْمَسْحِ عَلَی الْخُفَّیْنِ ، فَقَالَ سَعْدٌ: امْسَحْ عَلَیْہِمَا ، وَأَنْکرْتُ أَنَا ذَلِکَ، فَلَمَّا قَدِمْنَا عَلَی عُمَرَ بْنِ الْخَطَّابِ، ذَکَرَ ذَلِکَ لَہُ سَعْدٌ، فَقَالَ لَہُ: أَلَمْ تَرَ أَنَّ ابْنَ عُمَرَ یُنْکِرُ الْمَسْحَ عَلَی الْخُفَّیْنِ؟ قَالَ: فَقُلْتُ: یَا أَمِیرَ الْمُؤْمِنِینَ، أَنَّ سَعْدًا یَقُولُ : إِمْسَحْ عَلَیْہِمَا بَعْدَ الْحَدَثِ قَالَ : فَقَالَ عُمَرُ : أَلاَّ بَعْدَ الْحَدَثِ ، أَلاَّ بَعْدَ الْخِرَائَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 1898","","","كتاب الطهارة"
"1899","(۱۸۹۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَکَمِ بْنِ الأَعْرَجِ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ ، فَقَالَ : اخْتَلَفْتُ أَنَا وَسَعْدٌ فِی ذَلِکَ وَنَحْنُ بِجَلُولاَئَ ، فَقَالَ سَعْدٌ : امْسَحْ عَلَیْہِمَا ، فَأَنْکَرْتُ ذَلِکَ ، فَلَمَّا قَدِمْنَا عَلَی عُمَرَ ، ذَکَرْتُ لَہُ ذَلِکَ ، قَالَ : فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، إِنَّہُ یَقُولُ : یمسح عَلَیْہِمَا بَعْدَ الْحَدَثِ ، فَقَالَ عُمَرُ : أَلاَّ بَعْدَ الْخِرَائَۃِ ، أَلاَّ بَعْدَ الْحَدَثِ۔","Sahih","Musannaf Ibn Abi Shaybah 1899","","","كتاب الطهارة"
"1900","(۱۹۰۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ إِبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ ، أَنَّہُ کَانَ یَقُولُ فِی الْمَسْحِ عَلَی الْخُفَّیْنِ : ثَلاثَۃُ أَیَّامٍ وَلَیَالِیہِنَّ لِلْمُسَافِرِ ، وَیَوْمٌ وَلَیْلَۃٌ لِلْمُقِیمِ۔","","Musannaf Ibn Abi Shaybah 1900","","","كتاب الطهارة"
"1901","(۱۹۰۱) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا غَیْلاَنُ بْنُ عَبْدِ اللہِ ، مَوْلَی بَنِی مَخْزُومٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، سَأَلَہُ رَجُلٌ مِنَ الأَنْصَارِ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ قَالَ : ثَلاَثَۃُ أَیَّامٍ لِلْمُسَافِرِ ، وَلِلْمُقِیمِ یَوْمٌ وَلَیْلَۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 1901","","","كتاب الطهارة"
"1902","(۱۹۰۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَنْ عَمْرِو بْنِ الْحَارِثِ قَالَ : صَحِبْتُ ابْنَ مَسْعُودٍ فِی سَفَرٍ ، فَلَمْ یَنْزِعْ خُفَّیْہِ ثَلاَثًا۔","Sahih","Musannaf Ibn Abi Shaybah 1902","","","كتاب الطهارة"
"1903","(۱۹۰۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ عَمْرِو بْنِ الْحَارِثِ قَالَ : خَرَجْتُ مَعَ عَبْدِ اللہِ إِلَی الْمَدَائِنِ ، فَمَسَحَ عَلَی الْخُفَّیْنِ ثَلاَثًا ، لاَ یَنْزِعُہُ۔","","Musannaf Ibn Abi Shaybah 1903","","","كتاب الطهارة"
"1904","(۱۹۰۴) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْقَاسِمِ بْنِ مُخَیْمِرَۃَ ، عَنْ شُرَیْحِ بْنِ ہَانِیئٍ قَالَ : قَالَ عَلِیٌّ : لِلْمُسَافِرِ ثَلاَثُ لَیَالٍ ، وَیَوْمٌ وَلَیْلَۃٌ لِلْمُقِیمِ۔","Sahih","Musannaf Ibn Abi Shaybah 1904","","","كتاب الطهارة"
"1905","(۱۹۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لِلْمُسَافِرِ ثَلاَثٌ ، وَلِلْمُقِیمِ یَوْمٌ وَلَیْلَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 1905","","","كتاب الطهارة"
"1906","(۱۹۰۶) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَلْعٍ ، عَنْ عَبْدِ خَیْرٍ ؛ أَنَّ عَلِیًّا مَسَحَ عَلَی الْخُفَّیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 1906","","","كتاب الطهارة"
"1907","(۱۹۰۷) حَدَّثَنَا حَفْصٌ، عَنِ الأَعْمَشِ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَبْدِ خَیْرٍ، عَنْ عَلِیٍّ قَالَ: لَوْ کَانَ الدِّینُ بِالرَّأْیِ، لَکَانَ بَاطِنُ الْقَدَمَیْنِ أَوْلَی وَأَحَقَّ بِالْمَسْحِ مِنْ ظَاہِرِہِمَا، وَلَکِنِّی رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَسَحَ ظَاہِرَہُمَا۔","","Musannaf Ibn Abi Shaybah 1907","","","كتاب الطهارة"
"1908","(۱۹۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ مَسَحَ۔","Sahih","Musannaf Ibn Abi Shaybah 1908","","","كتاب الطهارة"
"1909","(۱۹۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبَّادِ بْنِ إِسْحَاقَ ، عَنْ أَبِی عُبَیْدَۃَ بْنَ مُحَمَّدِ بْنِ عَمَّارٍ ، قَالَ : سَأَلْتُ جَابِرًا عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ ؟ فَقَالَ : سُنَّۃٌ۔","Hasan","Musannaf Ibn Abi Shaybah 1909","","","كتاب الطهارة"
"1910","(۱۹۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْعَلاَئِ بْنِ الشِّخِّیرِ ، عَنْ عِیَاضِ بْنِ نَضْلَۃَ ، قَالَ : خَرَجْنَا مَعَ أَبِی مُوسَی فِی بَعْضِ الْبَسَاتِینِ ، فَأَخَذَ فِی حَاجَۃٍ ، وَانْطَلَقْتُ لِحَاجَتِی ، فَرَجَعْتُ وَأَنَا أُرِیدُ أَنْ أَخْلَعَ خُفِّی ، فَقَالَ : ذَرْہُمَا وَامْسَحْ عَلَیْہِمَا ، حَتَّی تَضَعْہُمَا حَیْثُ تَنَامُ۔","Da'if","Musannaf Ibn Abi Shaybah 1910","","","كتاب الطهارة"
"1911","(۱۹۱۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسیُّ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، قَالَ : سَمِعْتُ جَابِرَ بْنَ سَمُرَۃَ ، قَالَ : مَا أُبَالِی لَوْ لَمْ أَنْزَعْ خُفِّی ثَلاَثًا۔","Hasan","Musannaf Ibn Abi Shaybah 1911","","","كتاب الطهارة"
"1912","(۱۹۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سَوَادَۃَ بْنِ أَبِی الأَسْوَدِ ، عَنْ أَبِیہِ قَالَ : قَالَ عَبْدُ اللہِ بْنِ عَمْرٍو : عَلَیْکُمْ بِہَذِہِ الْخِفَافِ السُّوْدِ فَالْبِسُوہَا ، فَہُوَ أَجْدَرُ أَنْ تَمْسَحُوا عَلَیْہَا۔","Hasan","Musannaf Ibn Abi Shaybah 1912","","","كتاب الطهارة"
"1913","(۱۹۱۳) حَدَّثَنَا وَکِیعٌ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ الطَّائِیِّ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ، عَنْ رَجُلٍ؛ أَنَّ سَمُرَۃَ مَسَحَ عَلَی الْخُفَّیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 1913","","","كتاب الطهارة"
"1914","(۱۹۱۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، وَعُبَیْدُ اللہِ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ الطَّائِیِّ ، عَنْ عَلیِّ بْنِ رَبِیعَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ مَسَحَ عَلَی الْخُفَّیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 1914","","","كتاب الطهارة"
"1915","(۱۹۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، وَابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : نُبِّئْتُ أَنَّ أَبَا أَیُّوبَ کَانَ یَأْمُرُ أَصْحَابَہُ بِالْمَسْحِ عَلَی الْخُفَّیْنِ۔","","Musannaf Ibn Abi Shaybah 1915","","","كتاب الطهارة"
"1916","(۱۹۱۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیْرَۃُ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ جَرِیرُ بْنُ عَبْدِ اللہِ یَمْسَحُ عَلَی الْخُفَّیْنِ ، قَالَ : وَکَانَ أَعْجَبُ إِلیَّ ، لأَنَّ إِسْلاَمَ جَرِیرٍ إِنَّمَا کَانَ بَعْدَ نُزُولِ الْمَائِدَۃِ۔","","Musannaf Ibn Abi Shaybah 1916","","","كتاب الطهارة"
"1917","(۱۹۱۷) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَخِیہِ عِیسَی بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ عُمَرَ بْنَ الْخَطَّابِ بَالَ فَتَوَضَّأَ ، وَمَسَحَ عَلَی خُفَّیْہِ قَالَ : حَتَّی إِنِّی لَأَنْظرُ إِلَی أَثَرِ أَصَابِعہِ عَلَی خُفَّیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1917","","","كتاب الطهارة"
"1918","(۱۹۱۸) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : الْمَسْحُ عَلَی الْخُفَّیْنِ خَطًّا بِالأَصَابِعِ۔","","Musannaf Ibn Abi Shaybah 1918","","","كتاب الطهارة"
"1919","(۱۹۱۹) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الْعَلاَئِ قَالَ : بَعَثَنَا عَلِیٌّ إِلَی صِفِّینَ ، وَاسْتَعْملَ عَلَیْنَا قَیْسَ بْنَ سَعْدٍ ، خَادِمَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَسِرْنَا حَتَّی أَتیْنَا مَسْکَنَ ، فَرَأَیْتُ قَیْسًا بَالَ ثُمَّ أَتَی شَطَّ دِجْلَۃَ فَتَوَضَّأَ ، وَمَسَحَ عَلَی خُفَّیْہِ ، فَرَأَیْتُ أَثَرَ أَصَابِعِہِ عَلَی خُفَّیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1919","","","كتاب الطهارة"
"1920","(۱۹۲۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ، عَنْ أَبِی عُثْمَانَ، قَالَ: اخْتَلَفَ ابْنُ عُمَرَ وَسَعْدٌ فِی الْمَسْحِ عَلَی الْخُفَّیْنِ، فَقَالَ سَعْدٌ : امْسَحْ۔","Sahih","Musannaf Ibn Abi Shaybah 1920","","","كتاب الطهارة"
"1921","(۱۹۲۱) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ طَلْحَۃَ بْنَ یَحْیَی ، عَنْ أَبَانَ بْنِ عُثْمَانَ قَالَ : سَأَلْتُ سَعْدَ بْنَ أَبِی وَقَّاصٍ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ ؟ فَقَالَ : نَعَمْ ، ثَلاَثَۃُ أَیَّامٍ وَلَیَالِیہِنَّ لِلْمُسَافِرِ ، وَیَوْمٌ وَلَیْلَۃٌ لِلْمُقِیمِ۔","Hasan","Musannaf Ibn Abi Shaybah 1921","","","كتاب الطهارة"
"1922","(۱۹۲۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا عَبْدُ الْوَارِثِ ، قَالَ : حَدَّثَنَا أَیُّوبُ السِّخْتِیَانِیُّ ، عَنْ یَزِیدَ بْنِ مُعْنقٍ ، عَنْ مُطَرِّفٍ قَالَ : دَخَلْتُ عَلَی عَمَّارٍ ، فَوَافَقْتُہُ وَہُوَ فِی الْخَلاَئِ ، فَخَرَجَ فَتَوَضَّأَ ، وَمَسَحَ عَلَی الْخُفَّیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 1922","","","كتاب الطهارة"
"1923","(۱۹۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ مُوسَی بْنِ سَلَمَۃَ الْہُذَلِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَمْسَحُ الْمُسَافِرُ عَلَی الْخُفَّیْنِ ثَلاَثَۃَ أَیَّامٍ وَلَیَالِیہِنَّ ، وَلِلْمُقِیمِ یَوْمٌ وَلَیْلَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 1923","","","كتاب الطهارة"
"1924","(۱۹۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُ الْحَسَنَ فِی جِنَازَۃٍ فَبَالَ ، ثُمَّ جَائَ فَتَوَضَّأَ وَمَسَحَ عَلَی خُفَّیْہِ۔","","Musannaf Ibn Abi Shaybah 1924","","","كتاب الطهارة"
"1925","(۱۹۲۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یَحْیَی بْنِ أَبِی إِسْحَاقَ ، أَنَّہُ سَمِعَ أَنَسَ بْنَ مَالِکٍ ، سُئِلَ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ؟ فَقَالَ : امْسَحْ عَلَیْہِمَا ، فَقَالُوا لَہُ : أَسَمِعْتَہُ مِنَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : لاَ ، وَلَکِنْ سَمِعْتُہُ مِمَّنْ لَمْ یُتَّہَمْ مِنْ أَصْحَابِنَا یَقُولُونَ : الْمَسْحُ عَلَی الْخُفَّیْنِ ، وَإِنْ صَنَعَ کَذَا وَکَذَا ، لاَ یَکْنِی۔","Hasan","Musannaf Ibn Abi Shaybah 1925","","","كتاب الطهارة"
"1926","(۱۹۲۶) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ قَالَ : قَالَ سَعِیدُ بْنُ الْمُسَیِّبِ : إِذَا أَدْخَلْتَ رِجْلَیْکَ فِی الْخُفِّ وَہُمَا طَاہِرَتَانِ وَأَنْتَ مُقِیمٌ ، کَفَاکَ إِلَی مِثْلِہَا مِنَ الْغَدِ ، وَلِلْمُسَافِرِ ثَلاَثُ لَیَالٍ۔","","Musannaf Ibn Abi Shaybah 1926","","","كتاب الطهارة"
"1927","(۱۹۲۷) حَدَّثَنَا یَعْلَی بْنُ مُوسَی الْجُہَنِیُّ ، عَنْ عَمْرِو الْجَمَالِ الأَسْوَدِ قَالَ : سَأَلْتُ عَنْہُ سَالِمًا ؟فَقَالَ : لِلْمُسَافِرِ ثَلاَثَۃُ أَیَّامٍ وَثَلاَثُ لَیَالٍ ، وَلِلْمُقِیمِ یَوْمٌ وَلَیْلَۃٌ۔","","Musannaf Ibn Abi Shaybah 1927","","","كتاب الطهارة"
"1928","(۱۹۲۸) حَدَّثَنَا وَکِیعٌ، عَنْ عَلِیِّ بْنِ صَالِحٍ، عَنْ عَبْدِ الأَعْلَی بْنِ عَامِرٍ، قَالَ: رَأَیْتُ ابْنَ الْحَنَفِیَّۃِ یَمْسَحُ عَلَی خُفَّیْہِ۔","","Musannaf Ibn Abi Shaybah 1928","","","كتاب الطهارة"
"1929","(۱۹۲۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عُبَیْدَۃَ ، عَنْ إِبْرَاہِیمَ قَالَ : مَسَحَ عَلَی الْخُفَّیْنِ ثَمَانِیۃٌ مِنْ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ عُمَرُ بْنُ الْخَطَّابِ ، وَسَعْدُ بْنُ أَبِی وَقَّاصٍ ، وَابْنُ مَسْعُودٍ ، وَأَبُو مَسْعُودٍ الأَنْصَارِیُّ ، وَحُذَیْفَۃُ، وَالْمُغِیرَۃُ بْنُ شُعْبَۃَ ، وَالْبَرَائُ بْنُ عَازِبٍ۔","Da'if","Musannaf Ibn Abi Shaybah 1929","","","كتاب الطهارة"
"1930","(۱۹۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بَیَانٍ ، عَنْ قَیْسٍ ، عَنْ رَجُلٍ ، قَالَ بَیَانٌ : أُرَاہُ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لَوْ تَحَرَّجْتُ مِنَ الْمَسْحِ عَلَی الْخُفَّیْنِ ، لَتَحَرَّجْتُ مِنَ الصَّلاَۃِ فِیہِمَا۔","","Musannaf Ibn Abi Shaybah 1930","","","كتاب الطهارة"
"1931","(۱۹۳۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ قَالَ : کَانَ إِبْرَاہِیمُ فِی سَفَرٍ ، فَأَتَی عَلَیْہِمْ یَوْمٌ حَارٌّ ، قَالَ : لَوْلاَ خِلاَفُ السُّنَّۃِ لَنَزَعْتُ خُفِّی۔","","Musannaf Ibn Abi Shaybah 1931","","","كتاب الطهارة"
"1932","(۱۹۳۲) حَدَّثَنَا حَفْصٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ بَالَ ، ثُمَّ تَوَضَّأَ وَمَسَحَ عَلَی خُفَّیْہِ ، ثُمَّ دَخَلَ الْمَسْجِدَ وَصَلَّی۔","","Musannaf Ibn Abi Shaybah 1932","","","كتاب الطهارة"
"1933","(۱۹۳۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : رَأَیْتُ إِبْرَاہِیمَ النَّخَعِیَّ ، وَإِبْرَاہِیمَ بْنَ سُوَیْدٍ ، أَحْدَثَا ، ثُمَّ تَوَضَّآ وَمَسَحَا عَلَی خُفَّیْہِمَا۔","","Musannaf Ibn Abi Shaybah 1933","","","كتاب الطهارة"
"1934","(۱۹۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : سَأَلْتُ الْحَارِثَ بْنَ سُوَیْدٍ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ ؟ فَقَالَ : امْسَحْ ، فَقُلْتُ : وَإِنْ دَخَلْتُ الْخَلاَئَ ؟ فَقَالَ : وَإِنْ دَخَلْتَ الْخَلاَئَ عَشْرَ مَرَّاتٍ۔","","Musannaf Ibn Abi Shaybah 1934","","","كتاب الطهارة"
"1935","(۱۹۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عَاصِمٌ قَالَ : رَأَیْتُ أَنَسَ بْنَ مَالِکٍ بَالَ ، ثُمَّ تَوَضَّأَ وَمَسَحَ عَلَی nعِمَامَتِہِ وَخُفَّیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 1935","","","كتاب الطهارة"
"1936","(۱۹۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا جَرِیرُ بْنُ أَیُّوبَ ، عَنْ أَبِی زُرْعَۃَ بْنَ عَمْرِو بْنِ جَرِیرٍ ، قَالَ : رَأَیْتُ جَرِیرًا مَسَحَ عَلَی خُفَّیْہِ۔nقَالَ: وَقَالَ أَبُو زُرْعَۃَ : قَالَ أَبُو ہُرَیْرَۃَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا أَدْخَلَ أَحَدُکُمْ رِجْلَیْہِ فِی خُفَّیْہِ وَہُمَا طَاہِرَتَانِ فَلْیَمْسَحْ عَلَیْہِمَا ؛ ثَلاَثٌ لِلْمُسَافِرِ ، وَیَوْمٌ لِلْمُقِیمِ۔","Da'if","Musannaf Ibn Abi Shaybah 1936","","","كتاب الطهارة"
"1937","(۱۹۳۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، قَالَ: أَخْبَرَنَا عَاصِمٌ ، قَالَ: رَأَیْتُ أَنَسًا بَالَ، ثُمَّ تَوَضَّأَ وَمَسَحَ عَلَی عِمَامَتِہِ وَخُفَّیْہِ۔","","Musannaf Ibn Abi Shaybah 1937","","","كتاب الطهارة"
"1938","(۱۹۳۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ، عَنِ الْحَارِثِ بْنِ سُوَیْدٍ، عَنْ عَبْدِ اللہِ ، قَالَ: ثَلاَثٌ لِلْمُسَافِرِ ، وَلِلْمُقِیمِ یَوْمٌ وَلَیْلَۃٌ قَالَ: وَقَالَ الْحَارِثُ : مَا أَخْلَعُ خُفِّی حَتَّی آتِیَ فِرَاشِی۔","Sahih","Musannaf Ibn Abi Shaybah 1938","","","كتاب الطهارة"
"1939","(۱۹۳۹) حَدَّثَنَا الْفَضْلُ بْنُ أَنَسٍ ، عَنْ أَبَانَ بْنِ عَبْدِ اللہِ ، عَمَّنْ حَدَّثَ عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَسَحَ عَلَی الْخُفَّیْنِ۔ (ابن ماجہ ۵۵۵۔ ابن حبان ۱۳۳۴)","Da'if","Musannaf Ibn Abi Shaybah 1939","","","كتاب الطهارة"
"1940","(۱۹۴۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَعِیدٍ ، قَالَ : رَأَیْتُ عَلِیَّ بْنَ رَبِیعَۃَ یَمْسَحُ عَلَی الْخُفَّیْنِ وَیَقُولُ : مَا فِی نَفْسِی مِنْہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 1940","","","كتاب الطهارة"
"1941","(۱۹۴۱) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حَدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَنْ أَبِی عَبْدِ اللہِ ، مَوْلَی التَّیْمِ بْنِ مُرَّۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : کُنْتُ جَالِسًا مَعَ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، فَمَرَّ بِنَا بِلاَلٌ ، فَسَأَلْنَاہُ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ ؟ فَقَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْضِی حَاجَتَہُ ثُمَّ یَخْرُجُ ، فَنَأْتِیہِ بِالْمَائِ ، فَیَتَوَضَّأُ وَیَمْسَحُ عَلَی الْمُوقَیْنِ وَالْعِمَامَۃِ۔ (ابوداؤد ۱۵۴۔ احمد ۶/۱۳)","Da'if","Musannaf Ibn Abi Shaybah 1941","","","كتاب الطهارة"
"1942","(۱۹۴۲) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی ، عَنْ لَیْثٍ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ کَعْبٍ ، عَنْ بِلاَلٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَأَبَا بَکْرٍ ، وَعُمَرَ ، کَانُوا یَمْسَحُونَ عَلَی الْخُفَّیْنِ وَالْخِمَارِ۔ (طبرانی ۱۰۶۲)","Da'if","Musannaf Ibn Abi Shaybah 1942","","","كتاب الطهارة"
"1943","(۱۹۴۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ نُسیْرِ بْنِ ذُعْلوق ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ سَعْدَ بْنَ مَالِکٍ مَسَحَ عَلَی الْخُفَّیْنِ ، فَأَنْکَرَ ذَلِکَ عَلَیْہِ ابْنُ عُمَرَ ، فَذَکَرَہُ لأَبِیہِ ، فَقَالَ : سَعْدُ بْنُ مَالِکٍ أَعْلَمُ مِنْکَ۔","Hasan","Musannaf Ibn Abi Shaybah 1943","","","كتاب الطهارة"
"1944","(۱۹۴۴) حَدَّثَنَا یَحْیَی ، عَنْ مَنْصُورٍ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ یَعِیشَ الْبَکْرِیِّ ، عَنِ ابْنِ عُمَرَ ، أَتَاہُ رَجُلٌ فَقَالَ : امْسَحْ ؟ فَقَالَ عَبْدُ اللہِ : إِنِّی لَأَدْخُلُ ثُمَّ أَخْرُجُ ، فأَمْسَحُ عَلَی الْخُفِّ۔","Da'if","Musannaf Ibn Abi Shaybah 1944","","","كتاب الطهارة"
"1945","(۱۹۴۵) حَدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ إِسْحَاقَ مَوْلَی زَائِدَۃَ ؛ أَنَّ سَعْدَ بْنَ أَبِی وَقَّاصٍ خَرَجَ مِنَ الْخَلاَئِ فَتَوَضَّأَ وَمَسَحَ عَلَی خُفَّیْہِ ، فَقِیلَ لَہُ : أَتَمْسَحُ عَلَیْہِمَا وَقَدْ خَرَجْتَ مِنَ الْخَلاَئِ ؟ قَالَ : نَعَمْ ، إِذَا أَدْخَلْتَ الْقَدَمَیْنِ الْخُفَّیْنِ وَہُمَا طَاہِرَتَانِ فَامْسَحْ عَلَیْہِمَا ، وَلاَ تَخْلَعْہُمَا إِلاَّ لِجَنَابَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 1945","","","كتاب الطهارة"
"1946","(۱۹۴۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مَنْصُورٌ ، وَیُونُسُ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ فِی الْمَسْحِ عَلَی الْخُفَّیْنِ : امْسَحْ عَلَیْہِمَا ، وَلاَ تَجْعَلْ لِذَلِکَ وَقْتًا إِلاَّ مِنْ جَنَابَۃٍ۔","","Musannaf Ibn Abi Shaybah 1946","","","كتاب الطهارة"
"1947","(۱۹۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ؛ أَنَّہُ کَانَ لاَ یُوَقِّتُ فِی الْمَسْحِ ، وَیَقُولُ : امْسَحْ مَا شِئْتَ۔","","Musannaf Ibn Abi Shaybah 1947","","","كتاب الطهارة"
"1948","(۱۹۴۸) حَدَّثَنَا عَثَّامُ بْنُ عَلِیٍّ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یُوَقِّتُ فِی الْمَسْحِ۔","","Musannaf Ibn Abi Shaybah 1948","","","كتاب الطهارة"
"1949","(۱۹۴۹) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنَ صَالِحٍ ، عَنْ عِیَاضِ بْنِ عَبْدِ اللہِ الْقُرَشِیِّ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ؛ أَنَّ أَبَا عُبَیْدَۃَ بْنَ الْجَرَّاحِ بَعَثَ عُقْبَۃَ بْنَ عَامِرٍ الْجُہَنِیَّ إِلَی عُمَرَ بْنِ الْخَطَّابِ بِفَتْحِ دِمَشْقَ ، فَخَرَجَ یَوْمَ الْجُمُعَۃِ ، وَقَدِمَ یَوْمَ الْجُمُعَۃِ ، فَسَأَلَہُ عُمَرُ مَتَی خَرَجْتَ ؟ فَأَخْبَرَہُ ، وَقَالَ : لَمْ أَخْلَعْ لِی خُفًّا مُنْذُ خَرَجْتُ ، قَالَ عُمَرُ : قَدْ أَحْسَنْتَ۔","","Musannaf Ibn Abi Shaybah 1949","","","كتاب الطهارة"
"1950","(۱۹۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَفْصٍ ، عَنِ الشَّعْبِیِّ قَالَ : سَأَلُوہُ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ ؟ فَقَالَ : ہَکَذَا ، وَأَمَرَّ یَدَیْہِ إِلَی أَسْفَلَ","","Musannaf Ibn Abi Shaybah 1950","","","كتاب الطهارة"
"1951","(۱۹۵۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ (ح) ، وَمُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُمَا قَالاَ فِی الْمَسْحِ عَلَی الْخُفَّیْنِ : ہَکَذَا ، وَوَصَفَا الْمَسْحَ إِلَی فَوْقِ أَصَابِعِہِمَا۔","","Musannaf Ibn Abi Shaybah 1951","","","كتاب الطهارة"
"1952","(۱۹۵۲) حَدَّثَنَا جَرِیرٌ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ قَالَ : یَمْسَحُہُمَا مِنْ ظَاہِرِ قَدَمَیْہِ إِلَی أَطْرَافِ أَصَابِعِہِ۔","","Musannaf Ibn Abi Shaybah 1952","","","كتاب الطهارة"
"1953","(۱۹۵۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْمَسْحُ عَلَی الْخُفَّیْنِ ہَکَذَا ، وَأَمَرَّ یَدَیْہِ مِنْ ظَہْرِ قَدَمَیْہِ إِلَی أَطْرَافِ خُفَّیْہِ","","Musannaf Ibn Abi Shaybah 1953","","","كتاب الطهارة"
"1954","(۱۹۵۴) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : الْمَسْحُ عَلَی الْخُفَّیْنِ خَطًّا بِالأَصَابِعِ۔","","Musannaf Ibn Abi Shaybah 1954","","","كتاب الطهارة"
"1955","(۱۹۵۵) حَدَّثَنَا مَخْلَدُ بْنُ یَزِیدَ ، وَکَانَ ثِقَۃً ، عَنْ سَعِیدِ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : سَأَلْتُ الزُّہْرِیَّ عَنِ الْمَسْحِ عَلَی الْخُفَّیْنِ ؟ فَقَالَ بِیَدِہِ ہَکَذَا ، وَأَمَرَّ أَصَابِعَہُ مِنْ مُقَدَّمِ رِجْلِہِ إِلَی فَوْقِہَا۔","","Musannaf Ibn Abi Shaybah 1955","","","كتاب الطهارة"
"1956","(۱۹۵۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : لَأَنْ أَحُزَّہمَا بِالسَّکَاکِینِ أَحَبُّ إِلَیَّ مِنْ أَنْ أَمْسَحَ عَلَیْہِمَا۔","Sahih","Musannaf Ibn Abi Shaybah 1956","","","كتاب الطهارة"
"1957","(۱۹۵۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إِسْمَاعِیلَ بْنَ سَالِمٍ ، قَالَ : خَرَجَ مُجَاہِدٌ وَأَصْحَابٌ لَہُ ، فِیہِمْ عَبْدَۃُ بْنُ أَبِی لُبَابَۃَ ، قَالَ : خَرَجُوا حُجَّاجَا ، فَکَانَ عَبْدَۃُ یَؤُمُّہُمْ فِی الصَّلاَۃِ ، قَالَ : فَبَرَزَ ذَاتَ یَوْمٍ لِحَاجَتِہِ ، فأَبْطَأَ عَلَیْہِمْ ، فَلَمَّا جَائَ قَالَ لَہُ مُجَاہِدٌ : مَا حَبَسکَ ؟ قَالَ : إِنَّما قَضَیْتُ حَاجَتِی ، ثُمَّ تَوَضَّأْتُ ، وَمَسَحْتُ عَلَی خُفِّی ، فَقَالَ لَہُ مُجَاہِدٌ: تَقَدَّمْ فَصَلِّ بِنَا ، فَمَا أَدْرِی مَا حَسْبُ صَلاَتِکَ۔","","Musannaf Ibn Abi Shaybah 1957","","","كتاب الطهارة"
"1958","(۱۹۵۸) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عَلِیٌّ : سَبَقَ الْکِتَابُ الْخُفَّیْنِ۔","","Musannaf Ibn Abi Shaybah 1958","","","كتاب الطهارة"
"1959","(۱۹۵۹) حَدَّثَنَا عَلیُّ بْنُ مُسْہِرٍ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: سَبَقَ الْکِتَابُ الْخُفَّیْنِ۔","","Musannaf Ibn Abi Shaybah 1959","","","كتاب الطهارة"
"1960","(۱۹۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ رَوْحِ بْنِ الْقَاسِمِ ، عَنِ ابْنِ طَاوُوُسٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : لَوْ قَالُوا ذَلِکَ فِی السَّفَرِ وَالْبَرَدِ الشَّدِیدِ۔","Sahih","Musannaf Ibn Abi Shaybah 1960","","","كتاب الطهارة"
"1961","(۱۹۶۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ ضِرَارِ بْنِ مُرَّۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : مَا أُبَالِی مَسَحْتُ عَلَی الْخُفَّیْنِ ، أَوْ مَسَحْتُ عَلَی ظَہْرِ بُخْتِیِّی ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 1961","","","كتاب الطهارة"
"1962","(۱۹۶۲) حَدَّثَنَا ہُشَیْمٌ، عَنِ الْقَاسِمِ بْنِ أَبِی أَیُّوبَ قَالَ : رَآنِی سَعِیدُ بْنُ جُبَیْرٍ وَأَنَا أَمْسَحُ عَلَی خُفَّیْنِ لِی أَبْیضیْنِ، قَالَ : فَقَالَ لِی : مَا تُفْسِدُ خُفَّیْکَ۔","","Musannaf Ibn Abi Shaybah 1962","","","كتاب الطهارة"
"1963","(۱۹۶۳) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ فِطْرٍ ، قَالَ : قُلْتُ لِعَطَائٍ : إِنَّ عِکْرِمَۃَ ، یَقُولُ : قَالَ ابْنُ عَبَّاسٍ : سَبَقَ الْکِتَابُ الْخُفَّیْنِ ، فَقَالَ عَطَائٌ : کَذِبَ عِکْرِمَۃُ ، أَنَا رَأَیْتُ ابْنَ عَبَّاسٍ یَمْسَحُ عَلَیْہِمَا۔","Hasan","Musannaf Ibn Abi Shaybah 1963","","","كتاب الطهارة"
"1964","(۱۹۶۴) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حَدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، قَالَ : حَدَّثَنَا إِسْمَاعِیلُ بْنُ سُمَیْعٍ ، قَالَ : حَدَّثَنِی أَبُو رَزِینٍ قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : مَا أُبَالِی عَلَی ظَہْرِ خُفِّی مَسَحْتُ ، أَوْ عَلَی ظَہْرِ حِمَارٍ۔","Sahih","Musannaf Ibn Abi Shaybah 1964","","","كتاب الطهارة"
"1965","(۱۹۶۵) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حَدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، قَالَ : سَمِعْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ، عَنْ عَائِشَۃَ ، قَالَتْ : لَأَنْ أَحُزَّہمَا ، أَوْ أَحُزَّ أَصَابِعِی بِالسِّکِّینِ أَحَبُّ إِلَیَّ مِنْ أَنْ أَمْسَحَ عَلَیْہِمَا۔","Sahih","Musannaf Ibn Abi Shaybah 1965","","","كتاب الطهارة"
"1966","(۱۹۶۶) حَدَّثَنَا جَرِیرٌ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْمَسْحُ عَلَی الْخُفَّیْنِ مَرَّۃً۔","","Musannaf Ibn Abi Shaybah 1966","","","كتاب الطهارة"
"1967","(۱۹۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : یَمْسحُ عَلَی الْخُفَّیْنِ مَسْحَۃً وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 1967","","","كتاب الطهارة"
"1968","(۱۹۶۸) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ سُلَیْمَانَ، قَالَ: رَأَیْتُ إِبْرَاہِیمَ، تَوَضَّأَ وَمَسَحَ عَلَی خُفَّیْہِ مَرَّۃً وَاحِدَۃً۔","","Musannaf Ibn Abi Shaybah 1968","","","كتاب الطهارة"
"1969","(۱۹۶۹) حَدَّثَنَا الْحَنَفِیُّ ، عَنْ أَبِی عَامِرٍ الْخَزَّازِ قَالَ : حَدَّثَنَا الْحَسَنُ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَالَ ، ثُمَّ جَائَ حَتَّی تَوَضَّأَ وَمَسَحَ عَلَی خُفَّیْہِ ، وَوَضَعَ یَدَہُ الْیُمْنَی عَلَی خُفِّہِ الْاَیْمَنِ ، وَیَدَہُ الْیُسْرَی عَلَی خُفِّہِ الْاَیْسَرِ ، ثُمَّ مَسَحَ أَعْلاَہُمَا مَسْحَۃً وَاحِدَۃً ، حَتَّی کَأَنِّی أَنْظُرُ إِلَی أَصَابِعِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی الْخُفَّیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 1969","","","كتاب الطهارة"
"1970","(۱۹۷۰) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ الدَّالاَنِیِّ ، عَنْ یَحْیَی بْنِ إِسْحَاقَ بْنَ أَبِی طَلْحَۃَ ، عَنْ رَجُلٍ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ فِی الرَّجُلِ یَمْسَحُ عَلَی خُفَّیْہِ ، ثُمَّ یَبْدُو لَہُ أَنْ یَنْزِعَ خُفَّیْہِ ، قَالَ : یَغْسِلُ قَدَمَیْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 1970","","","كتاب الطهارة"
"1971","(۱۹۷۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ زَ[corrupt]َرِیَّا بْنِ أَبِی الْعَتِیکِ ، عَنِ الشَّعْبِیِّ ، قَالَ : یَغْسِلُ قَدَمَیْہِ۔","","Musannaf Ibn Abi Shaybah 1971","","","كتاب الطهارة"
"1972","(۱۹۷۲) حَدَّثَنَا حَفْصٌ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ قَالَ : إِذَا مَسَحَ ثُمَّ خَلَعَ ، غَسَلَ قَدَمَیْہِ۔","","Musannaf Ibn Abi Shaybah 1972","","","كتاب الطهارة"
"1973","(۱۹۷۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ جَہْمٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا خَلَعَ أَحَدَ الْخُفَّیْنِ ، أَعَادَ الْوُضُوئَ۔","","Musannaf Ibn Abi Shaybah 1973","","","كتاب الطهارة"
"1974","(۱۹۷۴) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَکْحُولٍ ، وَالزُّہْرِیِّ قَالاَ : إِذَا مَسَحَ ثُمَّ خَلَعَ ، قَالاَ : یُعِیدُ الْوُضُوئَ۔","","Musannaf Ibn Abi Shaybah 1974","","","كتاب الطهارة"
"1975","(۱۹۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ؛ إِذَا خَلَعَہُمَا ، أَوْ إحْداہُمَا اسْتَأْنَفَ الْوُضُوئَ۔","","Musannaf Ibn Abi Shaybah 1975","","","كتاب الطهارة"
"1976","(۱۹۷۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إِسْمَاعِیلَ ، عَنِ ابْنِ سِیرِینَ قَالَ : یُعِیدُ الْوُضُوئَ۔","","Musannaf Ibn Abi Shaybah 1976","","","كتاب الطهارة"
"1977","(۱۹۷۷) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ قَالاَ : یَتَوَضَّأُ۔","","Musannaf Ibn Abi Shaybah 1977","","","كتاب الطهارة"
"1978","(۱۹۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ عَبْدِ الْجَبَّارِ الْہَمْدَانِیِّ، عَنِ الشَّعْبِیِّ ، قَالَ: إِذَا خُلِعَ الْخُفُّ خُلِعَ الْمَسْحُ۔","","Musannaf Ibn Abi Shaybah 1978","","","كتاب الطهارة"
"1979","(۱۹۷۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، وَمَنْصُورٌ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : إِذَا مَسَحَ عَلَی خُفَّیْہِ بَعْدَ الْحَدَثِ ثُمَّ خَلَعَہُمَا ، إِنَّہُ عَلَی طَہَارَۃٍ فَلْیُصَلِّ۔","","Musannaf Ibn Abi Shaybah 1979","","","كتاب الطهارة"
"1980","(۱۹۸۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، وَالأَعْمَشُ ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، عَنْ إِبْرَاہِیمَ ، أَنَّہُ رَأَی إِبْرَاہِیمَ فَعَلَ ذَلِکَ ، ثُمَّ خَلَعَ خُفَّیْہِ ، قَالَ : ثُمَّ صَلَّی وَلَمْ یَتَوَضَّأْ۔","","Musannaf Ibn Abi Shaybah 1980","","","كتاب الطهارة"
"1981","(۱۹۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إِسْمَاعِیلَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ طَاوُوسٍ ، ؛ فِی الرَّجُلِ یَمْسَحُ ، ثُمَّ یَخْلَعُ ، قَالَ : کَانَ یَقُولُ : ہُوَ عَلَی طَہَارَۃٍ۔","","Musannaf Ibn Abi Shaybah 1981","","","كتاب الطهارة"
"1982","(۱۹۸۲) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، عَنْ کَثِیرِ بْنِ شِنْظِیرٍ ، قَالَ : سَأَلْتُ الْحَسَنَ ، وَعَطَائً ، عَنْ رَجُلٍ تَوَضَّأَ وَمَسَحَ عَلَی خُفَّیْہِ ثُمَّ خَلَعَہُمَا ؟ قَالاَ : یُصَلِّی ، وَلاَ یَغْسِلُ قَدَمَیْہِ۔","","Musannaf Ibn Abi Shaybah 1982","","","كتاب الطهارة"
"1983","(۱۹۸۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَنْ ہَمَّامٍ ؛ أَنَّ أَبَا مَسْعُودٍ کَانَ یَمْسَحُ عَلَی الْجَوْرَبَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 1983","","","كتاب الطهارة"
"1984","(۱۹۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ خَالِدِ بْنِ سَعْدٍ ، عَنْ عُقْبَۃَ بْنِ عَمْرٍو ؛ أَنَّہُ مَسَحَ عَلَی جَوْرَبَیْنِ مِنْ شَعَرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 1984","","","كتاب الطهارة"
"1985","(۱۹۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُذَیْلٍ ، عَنْ مُغِیرَۃَ بْنِ شُعْبَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَسَحَ عَلَی الْجَوْرَبَیْنِ وَالنَّعْلَیْنِ۔ (ترمذی ۹۹۔ ابوداؤد ۱۶۰)","Shadh","Musannaf Ibn Abi Shaybah 1985","","","كتاب الطهارة"
"1986","(۱۹۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَنابٍ ، عَنْ أَبِیہِ ، عَنْ جُلاَسِ بْنِ عَمْرٍو ؛ أَنَّ عُمَرَ تَوَضَّأَ یَوْمَ جُمُعَۃٍ ، وَمَسَحَ عَلَی جَوْرَبَیْہِ وَنَعْلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1986","","","كتاب الطهارة"
"1987","(۱۹۸۷) حَدَّثَنَا أَبُو بَکْرِ بْنِ عَیَّاشٍ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : الْجَوْرَبَانِ وَالنَّعْلاَنِ بِمَنْزِلَۃِ الْخُفَّیْنِ۔","","Musannaf Ibn Abi Shaybah 1987","","","كتاب الطهارة"
"1988","(۱۹۸۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ n(ح) وَشُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیِّبِ ، وَالْحَسَنِ أَنَّہُمَا قَالاَ : یُمْسَحُ عَلَی الْجَوْرَبَیْنِ إِذَا کَانَا صَفِیقَیْنِ۔","","Musannaf Ibn Abi Shaybah 1988","","","كتاب الطهارة"
"1989","(۱۹۸۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَمْسَحُ عَلَی الْجَوْرَبَیْنِ۔","","Musannaf Ibn Abi Shaybah 1989","","","كتاب الطهارة"
"1990","(۱۹۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّہُ کَانَ یَمْسَحُ عَلَی الْجَوْرَبَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 1990","","","كتاب الطهارة"
"1991","(۱۹۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی غَالِبٍ ، قَالَ : رَأَیْتُ أَبَا أُمَامَۃَ یَمْسَحُ عَلَی الْجَوْرَبَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 1991","","","كتاب الطهارة"
"1992","(۱۹۹۲) حَدَّثَنَا أَبُو بَکْرِ بْنِ عَیَّاشٍ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ خِلاسٍ قَالَ : رَأَیْتُ عَلِیًّا بَالَ ، ثُمَّ مَسَحَ عَلَی جَوْرَبَیْہِ وَنَعْلَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 1992","","","كتاب الطهارة"
"1993","(۱۹۹۳) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ، عَنْ جُوَیْبِرٍ، عَنِ الضَّحَّاکِ؛ أَنَّہُ کَانَ یَقُولُ فِی الْمَسْحِ عَلَی الْجَوْرَبَیْنِ: لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 1993","","","كتاب الطهارة"
"1994","(۱۹۹۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ وَاصِلٍ ، عَنْ سَعِیدِ بْنِ عَبْدِ اللہِ بْنِ ضِرَارٍ ؛ أَنَّ أَنَسَ بْنَ مَالِکٍ تَوَضَّأَ وَمَسَحَ عَلَی جَوْرَبَیْنِ مَِرْعِزَّی۔","","Musannaf Ibn Abi Shaybah 1994","","","كتاب الطهارة"
"1995","(۱۹۹۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ إِسْمَاعِیلَ بْنِ أُمَیَّۃَ ، قَالَ : بَلَغَنِی أَنَّ الْبَرَائَ بْنَ عَازِبٍ کَانَ لاَ یَرَی بِالْمَسْحِ عَلَی الْجَوْرَبَیْنِ بَأْسًا۔nوَبَلَغَنِی عَنْ سَعْدِ بْنِ أَبِی وَقَّاصٍ ، وَسَعِیدِ بْنِ الْمُسَیِّبِ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِالْمَسْحِ عَلَی الْجَوْرَبَیْنِ۔","","Musannaf Ibn Abi Shaybah 1995","","","كتاب الطهارة"
"1996","(۱۹۹۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ قَالَ : حَدَّثَنَا إِسْمَاعِیلُ بْنُ رَجَائٍ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ الْبَرَائَ تَوَضَّأَ فَمَسَحَ عَلَی الْجَوْرَبَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 1996","","","كتاب الطهارة"
"1997","(۱۹۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزِّبْرِقَانِ الْعَبْدِیِّ ، عَنْ کَعْبِ بْنِ عَبْدِ اللہِ ، أَنَّ عَلِیًّا بَالَ ، ثُمَّ تَوَضَّأَ وَمَسَحَ عَلَی الْجَوْرَبَیْنِ وَالنَّعْلَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 1997","","","كتاب الطهارة"
"1998","(۱۹۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا یَزِیدُ بْنُ مُرْدَانْبَہَ ، عَنِ الْوَلِیدِ بْنِ سَرِیعٍ ، عَنْ عَمْرِو بْنِ کُرَیْبٍ ، أَنَّ عَلِیًّا تَوَضَّأَ وَمَسَحَ عَلَی الْجَوْرَبَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 1998","","","كتاب الطهارة"
"1999","(۱۹۹۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَنْ وَاصِلٍ الأَحْدَبِ ، عَنْ أَبِی وَائِلٍ ، عَنْ عُقْبَۃَ بْنِ عَمْرٍو ؛ أَنَّہُ تَوَضَّأَ وَمَسَحَ عَلَی الْجَوْرَبَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 1999","","","كتاب الطهارة"
"2000","(۲۰۰۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ یُسَیْرِ بْنِ عَمْرٍو ، قَالَ : رَأَیْتُ أَبَا مَسْعُودٍ بَالَ، ثُمَّ تَوَضَّأَ وَمَسَحَ عَلَی الْجَوْرَبَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 2000","","","كتاب الطهارة"
"2001","(۲۰۰۱) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ ، عَنْ أَبِی الْعُمَیْسِ ، عَنْ فُرَاتٍ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ تَوَضَّأَ وَمَسَحَ عَلَی الْجَوْرَبَیْنِ وَالنَّعْلَیْنِ.","","Musannaf Ibn Abi Shaybah 2001","","","كتاب الطهارة"
"2002","(۲۰۰۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ ؛ أَنَّہُ مَسَحَ عَلَی الْجَوْرَبَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 2002","","","كتاب الطهارة"
"2003","(۲۰۰۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : الْمَسْحُ عَلَی الْجَوْرَبَیْنِ بِمَنْزِلَۃِ الْمَسْحِ عَلَی الْخُفَّیْنِ۔","","Musannaf Ibn Abi Shaybah 2003","","","كتاب الطهارة"
"2004","(۲۰۰۴) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ عَبَّادِ بْنِ رَاشِدٍ ، قَالَ : سَأَلْتُ نَافِعًا عَنِ الْمَسْحِ عَلَی الْجَوْرَبَیْنِ ؟ فَقَالَ : ہُمَا بِمَنْزِلَۃِ الْخُفَّیْنِ۔","","Musannaf Ibn Abi Shaybah 2004","","","كتاب الطهارة"
