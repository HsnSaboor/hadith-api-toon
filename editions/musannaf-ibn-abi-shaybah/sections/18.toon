hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"17035","(۱۷۰۳۵) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ : لاَ یَنْبَغِی لِلرَّجُلِ أَنْ یَجْمَعَ بَیْنَ امْرَأَۃٍ وَعَمَّتِہَا مِنَ الرَّضَاعَۃِ مِمَّا مَلَکَتِ الْیَمِینُ۔","","Musannaf Ibn Abi Shaybah 17035","","","كتاب النكاح"
"17036","(۱۷۰۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ یَوْمَ فَتَحَ مَکَّۃَ : لاَ تُنْکَحُ الْمَرْأَۃُ عَلَی عَمَّتِہَا وَلاَ عَلَی خَالَتِہَا۔n(احمد ۲/۲۰۷۔ عبدالرزاق ۱۰۷۵۱)","Hasan","Musannaf Ibn Abi Shaybah 17036","","","كتاب النكاح"
"17037","(۱۷۰۳۷) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ حَدَّثَنَا جَعْفَرِ بْنِ بُرْقَانَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُزَوَّجَ الْمَرْأَۃُ عَلَی عَمَّتِہَا وَلاَ عَلَی خَالَتِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17037","","","كتاب النكاح"
"17038","(۱۷۰۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حُسَیْنٍ الْمُعَلِّمِ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ أَنَّ رَجُلاً تَزَوَّجَ امْرَأَۃً عَلَی خَالَتِہَا فَضَرَبَہُ عُمَرُ وَفَرَّقَ بَیْنَہُمَا۔","Hasan","Musannaf Ibn Abi Shaybah 17038","","","كتاب النكاح"
"17039","(۱۷۰۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعقِلٍ ، عَنْ عَطَائٍ وَیَزِیدُ بْنُ إِبراہِیم ، عَنِ الْحَسَنِ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُنْکَحَ الْمَرْأَۃُ عَلَی عَمَّتِہَا ، أَوْ عَلَی خَالَتِہَا۔","","Musannaf Ibn Abi Shaybah 17039","","","كتاب النكاح"
"17040","(۱۷۰۴۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ قَالَ : یُکْرَہُ الْجَمْعُ بَیْنَ ابْنَتَیِ الْعَمِّ لِفَسَادٍ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17040","","","كتاب النكاح"
"17041","(۱۷۰۴۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو أَنَّ الْحَسَنَ بْنَ مُحَمَّدٍ أَخْبَرَہُ أَنَّ ابْنًا لِعَلِیٍّ جَمَعَ بَیْنَ ابْنَتَی عَمٍّ لَہُ قَالَ : فَأُدْخِلَتَا عَلَیْہِ فِی لَیْلَۃٍ۔","","Musannaf Ibn Abi Shaybah 17041","","","كتاب النكاح"
"17042","(۱۷۰۴۲) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ، عَنْ عَمْرٍو، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُجْمَعَ بَیْنَ الْقَرَابَۃِ مِنْ أَجْلِ الْقَطِیعَۃِ۔","","Musannaf Ibn Abi Shaybah 17042","","","كتاب النكاح"
"17043","(۱۷۰۴۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : سُئِلَ : ہَلْ یَصْلُحُ لِلْمَرْأَۃِ أَنْ تُزَوَّجَ عَلَی ابْنَۃِ عَمِّہَا ؟ قَالَ : تِلْکَ الْقَطِیعَۃُ وَلاَ تَصْلُحُ الْقَطِیعَۃُ۔","","Musannaf Ibn Abi Shaybah 17043","","","كتاب النكاح"
"17044","(۱۷۰۴۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ حَدَّثَنِی خَالِدٌ الْفَأْفَاء ، عَنْ عِیسَی بْنِ طَلْحَۃَ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُنْکَحَ الْمَرْأَۃُ عَلَی قَرَابَتِہَا مَخَافَۃَ الْقَطِیعَۃِ۔ (ابوداؤد ۲۰۸۔ عبدالرزاق ۱۰۷۶۷)","","Musannaf Ibn Abi Shaybah 17044","","","كتاب النكاح"
"17045","(۱۷۰۴۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِیہِ أَنَّ سِبَاعَ بْنَ ثَابِتٍ تَزَوَّجَ ابْنَۃَ رَبَاحِ بْنِ وَہْبٍ وَلَہُ ابْنٌ مِنْ غَیْرِہَا وَلَہَا ابْنَۃٌ مِنْ غَیْرِہِ فَفَجَرَ الْغُلاَمُ بِالْجَارِیَۃِ فَظَہَرَ بِالْجَارِیَۃِ حَمْلٌ فَرُفِعَا إلَی عُمَرَ بْنِ الْخَطَّابِ فَاعْتَرَفَا فَجَلَدَہُمَا وَحَرَص أَنْ یُجْمَعَ بَیْنَہُمَا فَأَبَی الْغُلاَمُ۔","Sahih","Musannaf Ibn Abi Shaybah 17045","","","كتاب النكاح"
"17046","(۱۷۰۴۶) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ فِی رَجُلٍ وَامْرَأَۃٍ أَصَابَ کُلُّ وَاحِدٍ مِنْہُمَا مِنَ الآخَرِ حَدًّا ثُمَّ أَرَادَ أَنْ یَتَزَوَّجَہَا ، قَالَ : لاَ بَأْسَ ، أَوَّلُہُ سِفَاحٌ وَآخِرُہُ نِکَاحٌ۔","Hasan","Musannaf Ibn Abi Shaybah 17046","","","كتاب النكاح"
"17047","(۱۷۰۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ قَالَ : أَوَّلُہُ سِفَاحٌ وَآخِرُہُ نِکَاحٌ۔","","Musannaf Ibn Abi Shaybah 17047","","","كتاب النكاح"
"17048","(۱۷۰۴۸) حَدَّثَنَا وَکِیعٌ ، عَنِ أَبِی جُنَابٍ ، عَنْ بُکَیْرِ بْنِ الأَخْنَسِ ، عَنْ أَبِیہِ قَالَ : قرَأْت مِنَ اللَّیْلِ (حم عسق) فَمَرَرْت بِہَذِہِ الآیَۃِ : {وَہُوَ الَّذِی یَقْبَلُ التَّوْبَۃَ ، عَنْ عِبَادِہِ وَیَعْفُو ، عَنِ السَّیِّئَاتِ وَیَعْلَمُ مَا تَفْعَلُونَ} فَغَدَوْت إلَی عَبْدِ اللہِ أَسْأَلُہُ عَنْہَا فَأَتَاہُ رَجُلٌ فَسَأَلَہُ ، عَنِ الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ ثُمَّ یَتَزَوَّجُہَا فَقَرَأَ عَبْدُ اللہِ : {وَہُوَ الَّذِی یَقْبَلُ التَّوْبَۃَ ، عَنْ عِبَادِہِ وَیَعْفُو ، عَنِ السَّیِّئَاتِ}۔","Da'if","Musannaf Ibn Abi Shaybah 17048","","","كتاب النكاح"
"17049","(۱۷۰۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ عن عُرْوَۃَ بن عَبْدِ اللہِ بْنِ قُشَیرٍ ، عَنْ أَبِی الأَشْعَثِ ، عَنِ ابْنِ عُمَرَ قَالَ : أَوَّلُہُ سِفَاحٌ وَآخِرُہُ نِکَاحٌ أوَ أَوَّلُہُ حَرَامٌ وَآخِرُہُ حَلاَلٌ۔","Hasan","Musannaf Ibn Abi Shaybah 17049","","","كتاب النكاح"
"17050","(۱۷۰۵۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ؛ أَنَّ رَجُلاً فَجَرَ بِامْرَأَۃٍ وَہُمَا بِکْرَانِ فَجَلَدَہُمَا أَبُو بَکْرٍ وَنَفَاہُمَا ثُمَّ زَوَّجَہَا إیَّاہُ بَعْدَ الْحَوْلِ۔","","Musannaf Ibn Abi Shaybah 17050","","","كتاب النكاح"
"17051","(۱۷۰۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَام ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لاَ بَأْسَ أَنْ یَتَزَوَّجَہَا۔","","Musannaf Ibn Abi Shaybah 17051","","","كتاب النكاح"
"17052","(۱۷۰۵۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ قَالَ : سَأَلَہُ رَجُلٌ ، عَنْ رَجُلٍ فَجَرَ بِامْرَأَۃٍ ، أَیَتَزَوَّجُہَا ؟ قَالَ : نَعَمْ ، وَتَلاَ ہَذِہِ الآیَۃَ : {وَہُوَ الَّذِی یَقْبَلُ التَّوْبَۃَ ، عَنْ عِبَادِہِ وَیَعْفُو ، عَنِ السَّیِّئَاتِ}۔","","Musannaf Ibn Abi Shaybah 17052","","","كتاب النكاح"
"17053","(۱۷۰۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ شَیْبَۃَ أَبِی نَعَامَۃَ قَالَ : سُئِلَ سَعِیدُ بْنُ جُبَیْرٍ وَأَنَا أَسْمَعُ ، عَنْ رَجُلٍ فَجَرَ بِامْرَأَۃٍ ، أَیَتَزَوَّجُہَا ؟ قَالَ : أَوَّلُہُ سِفَاحٌ وَآخِرُہُ نِکَاحٌ أَحَلَّہَا لَہُ مَالُہُ۔","","Musannaf Ibn Abi Shaybah 17053","","","كتاب النكاح"
"17054","(۱۷۰۵۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : سُئِلَ عَنِ الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ ثُمَّ یَتَزَوَّجُہَا ، قَالَ : ہُوَ أَحَقُّ بِہَا ، ہُوَ أَفْسَدَہَا۔","","Musannaf Ibn Abi Shaybah 17054","","","كتاب النكاح"
"17055","(۱۷۰۵۵) حَدَّثَنَا وَکِیعٌ، عَنْ عُمَرَ بْنِ الْوَلِیدِ، عَنْ عِکْرِمَۃَ قَالَ: لاَ بَأْسَ ، ہُوَ بِمَنْزِلَۃِ رَجُلٍ سَرَقَ نَخْلَۃً ثُمَّ اشْتَرَاہَا۔","","Musannaf Ibn Abi Shaybah 17055","","","كتاب النكاح"
"17056","(۱۷۰۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ حَسَّانَ ، قَالَ : سَمِعْتُ حَنْظَلَۃَ قَالَ : سَأَلْتُ سَالِمًا عَنْہُ ، فَقَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 17056","","","كتاب النكاح"
"17057","(۱۷۰۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ قَالَ : إذَا تَابَا وَأَصْلَحَا فَلاَ بَأْسَ بہ۔","","Musannaf Ibn Abi Shaybah 17057","","","كتاب النكاح"
"17058","(۱۷۰۵۸) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، عَنْ دَاوُدَ ، عَنْ یَزِیدَ بْنِ أَبِی مَنْصُورٍ ، أَوِ ابْنِ مَنْصُورٍ ، عَنْ صِلَۃَ بْنِ أَشْیَمَ قَالَ : لاَ بَأْسَ إِنْ کَانَا تَائِبَیْنِ فَاللَّہُ أَوْلَی بِتَوْبَتِہِمَا ، وَإِنْ کَانَا زَانِیَیْنِ فَالْخَبِیثُ عَلَی الْخَبِیثِ۔","","Musannaf Ibn Abi Shaybah 17058","","","كتاب النكاح"
"17059","(۱۷۰۵۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ قَالَ : بَلَغَنِی أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ سُئِلَ عَنِ امْرَأَۃٍ أَصَابَتْ خَطِیئَۃً ثُمَّ رُئِیَ مِنْہَا خَیْرًا ، أَیَنْکِحُہَا الرَّجُلُ ؟ فَقَالَ لَہُ عمر کَمَا بَلَغَنِی : أتظن أنی أنہاک ؟۔","","Musannaf Ibn Abi Shaybah 17059","","","كتاب النكاح"
"17060","(۱۷۰۶۰) حَدَّثَنَا سفیان بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ قَالَ : سُئِلَ ابْنُ عَبَّاسٍ ، عَنْ رَجُلٍ زَنَی بِامْرَأَۃٍ فَأَرَادَ أَنْ یَتَزَوَّجَہَا ، قَالَ : الآنَ أَصَابَ الْحَلاَلَ۔","Sahih","Musannaf Ibn Abi Shaybah 17060","","","كتاب النكاح"
"17061","(۱۷۰۶۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ قَالاَ : إذَا فَجَرَ الرَّجُلُ بِالْمَرْأَۃِ فَإِنَّہَا تَحِلُّ لَہُ۔","","Musannaf Ibn Abi Shaybah 17061","","","كتاب النكاح"
"17062","(۱۷۰۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ بشر ، عَنْ سَعِیدٍ حَدَّثَنَا قَتَادَۃُ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ وَجَابِرِ بْنِ عَبْدِ اللہِ وسعید بْنِ جُبَیْرٍ فِی الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ ثُمَّ یَتَزَوَّجُہَا قَالُوا : لاَ بَأْسَ بِذَلِکَ إذَا تَابَا وَأَصْلَحَا۔","","Musannaf Ibn Abi Shaybah 17062","","","كتاب النكاح"
"17063","(۱۷۰۶۳) حَدَّثَنَا مُحَمَّدُ بْنُ بشر قَالَ حَدَّثَنَا : سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ فِی الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ ثُمَّ یَتَزَوَّجُہَا ، قَالَ : کَانَ أَوَّلَہُ سِفَاحٌ وَآخِرَہُ نِکَاحٌ ، أَوَّلُہُ حَرَامٌ وَآخِرُہُ حَلاَلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 17063","","","كتاب النكاح"
"17064","(۱۷۰۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَمْرِو بْنِ مَرْوَانَ ، عَنْ عَبْدِ الرَّحْمَنِ الصُّدَائِیِّ ، عَنْ علِیٍّ قَالَ : جَائَ إلَیْہِ رَجُلٌ ، فَقَالَ : إنَّ لِی ابْنَۃَ عَمٍّ أَہْوَاہَا وَقَدْ کُنْت نِلْت مِنْہَا ، فَقَالَ : إِنْ کَانَ شَیْئًا بَاطِنًا یَعْنِی الْجِمَاعَ فَلاَ ، وَإِنْ کَانَ شَیْئًا ظَاہِرًا یَعْنِی الْقُبْلَۃَ فَلاَ بَأْسَ۔","Da'if","Musannaf Ibn Abi Shaybah 17064","","","كتاب النكاح"
"17065","(۱۷۰۶۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ عن الحکم ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ قَالَ : لاَ یَزَالاَنِ زَانِیَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 17065","","","كتاب النكاح"
"17066","(۱۷۰۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قالَتْ عَائِشَۃُ : لاَ یَزَالاَنِ زَانِیَیْنِ مَا اصْطَحَبَا۔","Sahih","Musannaf Ibn Abi Shaybah 17066","","","كتاب النكاح"
"17067","(۱۷۰۶۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ أَنَّہُ قَالَ : ہُمَا زَانِیَانِ ، لِیَجْعَلَ بَیْنَہُ وَبَیْنَہَا الْبَحْرُ۔","","Musannaf Ibn Abi Shaybah 17067","","","كتاب النكاح"
"17068","(۱۷۰۶۸) حَدَّثَنَا أَسْبَاطٌ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی الْجَہْمِ ، عَنِ الْبَرَائِ فِی الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ ثُمَّ یَتَزَوَّجُہَا ، قَالَ : لاَ یَزَالاَنِ زَانِیَیْنِ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 17068","","","كتاب النكاح"
"17069","(۱۷۰۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنْ عِیسَی بن حِطَّان ، عَنْ مُسْلِمِ بْنِ سَلاَّمٍ ، عَنْ عَلِیِّ بْنِ طَلْقٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ اللَّہَ لاَ یَسْتَحْیِی مِنَ الْحَقِّ ، لاَ تَأْتُوا النِّسَائَ فِی أَعْجَازِہِنَّ ، أَوْ قَالَ : فِی أَدْبَارِہِنَّ۔ (ترمذی ۱۱۶۶۔ دارمی ۱۱۴۱)","Da'if","Musannaf Ibn Abi Shaybah 17069","","","كتاب النكاح"
"17070","(۱۷۰۷۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ ، عَنْ مَخْرَمَۃَ بْنِ سُلَیْمَانَ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لاَ یَنْظُرُ اللَّہُ إلَی رَجُلٍ أَتَی رَجُلاً ، أَوِ امْرَأَۃً فِی دُبُرِہَا۔n(ترمذی ۱۱۶۵۔ ابن حبان ۴۴۱۸)","Hasan","Musannaf Ibn Abi Shaybah 17070","","","كتاب النكاح"
"17071","(۱۷۰۷۱) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُؤْتَی النِّسَائُ فِی أَعْجَازِہِنَّ وَقَالَ : إنَّ اللَّہَ لاَ یَسْتَحْیِی مِنَ الْحَقِّ۔","Da'if","Musannaf Ibn Abi Shaybah 17071","","","كتاب النكاح"
"17072","(۱۷۰۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی أَیُّوبَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرو قَالَ : ہِیَ اللُّوطِیَّۃُ الصُّغْرَی۔ (نسائی ۸۹۹۷)","Sahih","Musannaf Ibn Abi Shaybah 17072","","","كتاب النكاح"
"17073","(۱۷۰۷۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عُقْبَۃَ بْنِ وَسَّاجٍ ، قَالَ : قَالَ أَبُو الدَّرْدَائِ : وَہَلْ یَفْعَلُ ذَلِکَ إلاَّ کَافِرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 17073","","","كتاب النكاح"
"17074","(۱۷۰۷۴) حَدَّثَنَا وَکِیعٌ، عَنْ ہَمَّامِ، عَنْ قَتَادَۃَ، عَنْ عُقْبَۃَ بن وساج، عَنْ أَبِی الدَّرْدَائِ قَالَ: وَہَلْ یَفْعَلُ ذَلِکَ إلاَّ کَافِرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 17074","","","كتاب النكاح"
"17075","(۱۷۰۷۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَبِی عَبْدِ اللہِ الشَّقَرِیِّ ، عَنْ أَبِی الْقَعْقَاعِ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : مَحَاشُّ النِّسَائِ عَلَیْکُمْ حَرَامٌ۔","Da'if","Musannaf Ibn Abi Shaybah 17075","","","كتاب النكاح"
"17076","(۱۷۰۷۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : مَنْ أَتَاہُ مِنَ الرِّجَالِ وَالنِّسَائِ فَقَدْ کَفَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 17076","","","كتاب النكاح"
"17077","(۱۷۰۷۷) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَکِیمٍ الأَثْرَمِ ، عَنْ أَبِی تَمِیمَۃَ الْہُجَیْمِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : مَنْ أَتَی حَائِضًا ، أَوِ امْرَأَۃً فِی دُبُرِہَا فَقَدْ کَفَرَ بِمَا أُنْزِلَ عَلَی مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ۔n(ابوداؤد ۳۸۹۹۔ دارمی ۱۱۳۶)","","Musannaf Ibn Abi Shaybah 17077","","","كتاب النكاح"
"17078","(۱۷۰۷۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عَبْدِ اللہِ بْنِ الْحُصَیْنِ الْخَطْمِیِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ قَیْسٍ الْخَطْمِیِّ ، عَنْ ہَرَمِی بْنِ عَبْدِ اللہِ ، قَالَ : سَمِعْتُ خُزَیْمَۃَ بْنَ ثَابِتٍ یَقُولُ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إنَّ اللَّہَ لاَ یَسْتَحْیِی مِنَ الْحَقِّ ، لاَ تَأْتُوا النِّسَائَ فِی أعجازہن۔n(طبرانی ۳۷۴۰۔ بیہقی ۱۹۶)","Da'if","Musannaf Ibn Abi Shaybah 17078","","","كتاب النكاح"
"17079","(۱۷۰۷۹) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، عَنْ وُہَیب ، عَنْ سُہَیْلِ بْنِ أَبِی صَالِحٍ ، عَنِ الْحَارِثِ بْنِ مُخَلَّدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَنْظُرُ اللَّہُ إلَی رَجُلٍ جَامَعَ امْرَأَۃً فِی دُبُرِہَا۔n(ابوداؤد ۲۱۵۵۔ ابن ماجہ ۱۹۲۳)","Hasan","Musannaf Ibn Abi Shaybah 17079","","","كتاب النكاح"
"17080","(۱۷۰۸۰) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ : حَدَّثَنَا الصَّلْتُ بْنِ بَہْرَامَ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنِ مَسْعُودٍ ، عَنْ أَبِی الْمُعْتَمِرِ ، أَوْ أَبِی الْجُوَیْرِیَۃِ قَالَ : نَادَی عَلِیٌّ عَلَی الْمِنْبَرِ ، فَقَالَ : سَلُونِی سَلُونِی ، فَقَالَ رَجُلٌ : أَتُؤْتَی النِّسَائُ فِی أَدْبَارِہِنَّ ؟ فَقَالَ : سَفَلْتَ سَفَّلَ اللَّہُ بِکَ ، أَلَمْ تَرَ أَنَّ اللَّہَ تَعَالَی یَقُولُ : {أَتَأْتُونَ الْفَاحِشَۃَ} الآیَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 17080","","","كتاب النكاح"
"17081","(۱۷۰۸۱) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَتْ إحْدَانَا إذَا کَانَتْ حَائِضًا أَمَرَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تَتَّزِرَ بِإِزَارٍ ثُمَّ یُبَاشِرُہَا۔ (بخاری ۳۰۰۔ مسلم ۲۴۲)","Sahih","Musannaf Ibn Abi Shaybah 17081","","","كتاب النكاح"
"17082","(۱۷۰۸۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَتْ إحْدَانَا إذَا کَانَتْ حَائِضًا أَمَرَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تَأْتَزِرَ فِی فور حَیْضَتِہَا ثُمَّ یُبَاشِرُہَا ، وَأَیُّکُمْ یَمْلِکُ إرْبَہُ کَمَا کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَمْلِکُ إرْبَہُ۔ (بخاری ۳۰۲۔ مسلم ۲)","Sahih","Musannaf Ibn Abi Shaybah 17082","","","كتاب النكاح"
"17083","(۱۷۰۸۳) حَدَّثَنَا عَبَّادُ بْنُ عَوَّامٍ ، وَعَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ قَالَ : أَخْبَرَتْنِی مَیْمُونَۃُ زَوْجُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ النَّبِیِّ بِنَحْوٍ مِنْہُ۔ (بخاری ۳۰۳۔ احمد ۶/۳۳۶)","Sahih","Musannaf Ibn Abi Shaybah 17083","","","كتاب النكاح"
"17084","(۱۷۰۸۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَبْدَۃَ أَنَّ أُمَّ سَلَمَۃَ قَالَتْ : نُفِسْتُ وَأَنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَعْنِی حِضْتُ فِی فِرَاشِی فَذَہَبْتُ لأَتَأَخَّرَ ، فَقَالَ : مَکَانَکِ إِنَّما کَانَ یَکْفِیکِ أَنْ تَجْعَلِی عَلَیْکِ ثَوْبًا۔n(طبرانی ۱۱۶۰۲)","","Musannaf Ibn Abi Shaybah 17084","","","كتاب النكاح"
"17085","(۱۷۰۸۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ خَالِدٍ، عَنْ عِکْرِمَۃَ، عَنْ أُمِّ سَلَمَۃَ فِی مُضَاجَعَۃِ الْحَائِضِ: إذَا کَانَ عَلَی فَرْجِہَا خِرْقَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 17085","","","كتاب النكاح"
"17086","(۱۷۰۸۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، عَنْ عَلِیٍّ قَالَ : مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17086","","","كتاب النكاح"
"17087","(۱۷۰۸۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَا فَوْقَ الإِزَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 17087","","","كتاب النكاح"
"17088","(۱۷۰۸۸) حَدَّثَنَا جریر، عَنْ یَزِید، قَالَ: سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ: لَکَ مَا فَوْقَ الإِزَارِ وَلاَ تَطَّلِعْ عَلَی مَا تَحْتَہُ۔","","Musannaf Ibn Abi Shaybah 17088","","","كتاب النكاح"
"17089","(۱۷۰۸۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، عَنْ عَائِشَۃَ أَنَّہَا سُئِلَتْ : مَا لِلرَّجُلِ مِنِ امْرَأَتِہِ وَہِیَ حَائِضٌ ؟ قَالَتْ : مَا فَوْقَ الإِزَارِ۔","Sahih","Musannaf Ibn Abi Shaybah 17089","","","كتاب النكاح"
"17090","(۱۷۰۹۰) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا ألقت عَلَی فَرْجِہَا خِرْقَۃً فَیُبَاشِرُہَا۔","","Musannaf Ibn Abi Shaybah 17090","","","كتاب النكاح"
"17091","(۱۷۰۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّیْبَانِیِّ قَالَ : إذَا کَفَّتِ الْحَائِضَۃُ عَنْہَا الأَذَی فَاصْنَعْ بِہَا مَا شِئْتَ۔","","Musannaf Ibn Abi Shaybah 17091","","","كتاب النكاح"
"17092","(۱۷۰۹۲) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : یَأْتِیہَا مَا أخطأ الدَّمُ۔","","Musannaf Ibn Abi Shaybah 17092","","","كتاب النكاح"
"17093","(۱۷۰۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرِ بْنِ حَبِیبٍ الْجَرْمِیِّ قَالَ : سَأَلْتُ أَبَا قِلاَبَۃَ : مَا لِلرَّجُلِ مِنِ امْرَأَتِہِ وَہِیَ حَائِضٌ؟ قَالَ : یَذْکُرُونَ مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17093","","","كتاب النكاح"
"17094","(۱۷۰۹۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الصَّلْتِ بْنِ بَہْرَامَ ، عَنْ إبْرَاہِیمَ قَالَ : لَکَ مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17094","","","كتاب النكاح"
"17095","(۱۷۰۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَکِینٍ ، عَنْ عِکْرِمَۃَ قَالَ : مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17095","","","كتاب النكاح"
"17096","(۱۷۰۹۶) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ أَنَّہُ سَمِعَ رَجُلاً یَسْأَلُ سَعِیدَ بْنَ الْمُسَیَّبِ ، فَقَالَ : أُبَاشِرُ امْرَأَتِی وَہِیَ حَائِضٌ ؟ قَالَ : اجْعَلْ بَیْنَکَ وَبَیْنَ ذَلِکَ مِنْہَا ثَوْبًا ثُمَّ بَاشِرْہَا۔","","Musannaf Ibn Abi Shaybah 17096","","","كتاب النكاح"
"17097","(۱۷۰۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ غَیْلاَنَ ، عَنِ الْحَکَمِ قَالَ : لاَ بَأْسَ أَنْ یَضَعَہُ عَلَی الْفَرْجِ وَلاَ یدْخِلْہُ۔","","Musannaf Ibn Abi Shaybah 17097","","","كتاب النكاح"
"17098","(۱۷۰۹۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ شَیْبَۃَ بْنِ ہِشَامٍ الرَّاسِبِیِّ قَالَ : سَأَلْتُ سَالِمًا ، عَنِ الرَّجُلِ یُضَاجِعُ امْرَأَتَہُ وَہِیَ حَائِضٌ ، فَقَالَ : أَمَّا نَحْنُ آلَ عُمَرَ فَنَعْزِلُہُنَّ۔","","Musannaf Ibn Abi Shaybah 17098","","","كتاب النكاح"
"17099","(۱۷۰۹۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17099","","","كتاب النكاح"
"17100","(۱۷۱۰۰) حَدَّثَنَا أَسْبَاطٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیْدَۃَ ، فِی الْحَائِضِ : لَکَ مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17100","","","كتاب النكاح"
"17101","(۱۷۱۰۱) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنِ ابْنِ شِہَابٍ ، عَنْ حَبِیبٍ مَوْلَی عُرْوَۃَ ، عَنْ نَدْبَۃَ مَوْلاَۃِ مَیْمُونَۃَ ، عَنْ مَیْمُونَۃَ زَوْجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُبَاشِرُ الْمَرْأَۃَ مِنْ نِسَائِہِ وَہِیَ حَائِضٌ إذَا کَانَ عَلَیْہَا إزَارٌ یَبْلُغُ أَنْصَافَ الْفَخِذَیْنِ ، أَوِ الرُّکْبَتَیْنِ مُحْتَجِرَۃً بِہِ۔n(ابوداؤد ۲۷۱۔ احمد ۶/۳۳۶)","Da'if","Musannaf Ibn Abi Shaybah 17101","","","كتاب النكاح"
"17102","(۱۷۱۰۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ قَالَ : لاَ بَأْسَ أنْ یَلعَب عَلَی بَطْنِہَا وَبَیْنَ فَخِذَیْہَا۔","","Musannaf Ibn Abi Shaybah 17102","","","كتاب النكاح"
"17103","(۱۷۱۰۳) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ طَارِقٍ ، عَنْ عَاصِمِ بْنِ عَمْرٍو الْبَجَلِیِّ قَالَ : خَرَجَ نَاسٌ مِنْ أَہْلِ الْعِرَاقِ فَلَمَّا قَدِمُوا عَلَی عُمَرَ قَالَ لَہُمْ : مِمَّنْ أَنْتُمْ ؟ قَالُوا : مِنْ أَہْلِ الْعِرَاقِ ، قَالَ : فَبِإِذْنٍ جِئْتُمْ ؟ قَالُوا ، نَعَمْ ، فَسَأَلُوہ عَمَّا یَحِلُّ لِلرَّجُلِ مِنِ امْرَأَتِہِ وَہِیَ حَائِضٌ ، فَقَالَ : سَأَلْتُمُونِی ، عَنْ خِصَالٍ مَا سَأَلَنِی عنہن أَحَدٌ بَعْدَ أَنْ سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَمَّا مَا لِلرَّجُلِ مِنِ امْرَأَتِہِ وَہِیَ حَائِضٌ فَلَہُ مَا فَوْقَ الإِزَارِ۔","","Musannaf Ibn Abi Shaybah 17103","","","كتاب النكاح"
"17104","(۱۷۱۰۴) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَقُولُ : إنِّی فِیک لرَاغِبٌ وَإِنِّی أُرِیدُ امْرَأَۃً أَمْرُہَا کَذَا وَکَذَا وَیُعَرِّضُ لَہَا بِالْقَوْلِ۔","Sahih","Musannaf Ibn Abi Shaybah 17104","","","كتاب النكاح"
"17105","(۱۷۱۰۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ یَقُولُ : إنَّک جَمِیلَۃٌ وَإِنَّک لَنَافِقَۃٌ إنَّک إلَی خَیْرٍ ، وَیُکْرَہُ أَنْ یَقُولَ : لاَ تَفُوتِینِی بِنَفْسِکِ وَإِنِّی عَلَیْکِ لَحَرِیصٌ۔","","Musannaf Ibn Abi Shaybah 17105","","","كتاب النكاح"
"17106","(۱۷۱۰۶) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِذَلِکَ کُلِّہِ۔","","Musannaf Ibn Abi Shaybah 17106","","","كتاب النكاح"
"17107","(۱۷۱۰۷) حَدَّثَنَا حَفْصٌ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ قَالَ : کَانَ یُکْرَہُ أَنْ یَقُولَ : إذَا انْقَضَتْ عِدَّتُہَا تَزَوَّجْتُکِ وَیَقُولُ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 17107","","","كتاب النكاح"
"17108","(۱۷۱۰۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : یَقُولُ : إنِّی بِکِ لَمُعْجَبٌ وَإِنِّی فِیک لَرَاغِبٌ فَلاَ تَفُوتِینَا بِنَفْسِک۔","","Musannaf Ibn Abi Shaybah 17108","","","كتاب النكاح"
"17109","(۱۷۱۰۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : یَقُولُ : إنَّک لَجَمِیلَۃٌ وَإِنَّک لَنَافِقَۃٌ وَإِنَّک لإِلَی خَیْرٍ۔","","Musannaf Ibn Abi Shaybah 17109","","","كتاب النكاح"
"17110","(۱۷۱۱۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ فِی الْمَرْأَۃِ یُتَوَفَّی عَنْہَا زَوْجُہَا فَیُرِیدُ الرَّجُلُ خِطْبَتَہَا وَکَلاَمَہَا قَالَ : یَقُولُ : إنِّی بِکِ لَمُعْجَبٌ وَإِنِّی فِیکِ لَرَاغِبٌ وَإِنِّی عَلَیْکِ لَحَرِیصٌ وَأَشْبَاہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17110","","","كتاب النكاح"
"17111","(۱۷۱۱۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیْدَۃَ فِی قَوْلِہِ : {وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ : یَذْکُرُہَا إلَی وَلِیِّہَا وَلاَ یُشْعِرنَہَا۔","","Musannaf Ibn Abi Shaybah 17111","","","كتاب النكاح"
"17112","(۱۷۱۱۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِفَاطِمَۃَ بِنْتِ قَیْسٍ : انْتَقِلِی إلَی أُمِّ شَرِیکٍ وَلاَ تَفُوتِینَا بِنَفْسِکِ۔ (مسلم ۳۹۔ ابوداؤد ۲۲۸۱)","","Musannaf Ibn Abi Shaybah 17112","","","كتاب النكاح"
"17113","(۱۷۱۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ ، عَنْ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ {إلاَّ أَنْ تَقُولُوا قَوْلاً مَعْرُوفًا} قَالَ : یقول : إنِّی فِیک لَرَاغِبٌ وَإِنِّی لأَرْجُو أَنْ یَجْمَعَ اللَّہُ بَیْنَکِ وَبَیْنِی۔","","Musannaf Ibn Abi Shaybah 17113","","","كتاب النكاح"
"17114","(۱۷۱۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : یَقُولُ : إنَّک لَجَمِیلَۃٌ وَإِنَّک لَنَافِقَۃٌ ، وَإِنْ قَضَی اللَّہُ أَمْرًا کَانَ۔","","Musannaf Ibn Abi Shaybah 17114","","","كتاب النكاح"
"17115","(۱۷۱۱۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ عن إبراہیم قَالَ : لاَ بَأْسَ بالہدیۃ فِی تَعْرِیضِ النِّکَاحِ۔","","Musannaf Ibn Abi Shaybah 17115","","","كتاب النكاح"
"17116","(۱۷۱۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ بشر ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لَفَاطِمَۃَ : لاَ تَفُوتِینَا بِنَفْسِکِ۔","","Musannaf Ibn Abi Shaybah 17116","","","كتاب النكاح"
"17117","(۱۷۱۱۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ {وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ : یَعْرِضُ الرَّجُلُ فَیَقُولُ : إنِّی أُرِیدُ أَنْ أَتَزَوَّجَ ، وَلاَ یَنْصِبْ فِی الْخِطْبَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 17117","","","كتاب النكاح"
"17118","(۱۷۱۱۸) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ عَمَّارِ بْنِ رُزَیْقٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ : {وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ : یَقُولُ ، إنِّی فِیکِ لَرَاغِبٌ وَلَوَدِدْتُ أَنِّی تَزَوَّجْتُکِ حَتَّی یُعْلِمَہَا إِنَّہُ یُرِیدُ تَزْوِیجَہَا مِنْ غَیْرِ أَنْ یُوجِبَ عُقْدَۃً ، أَوْ یُعَاہِدَہَا عَلَی عَہْدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 17118","","","كتاب النكاح"
"17119","(۱۷۱۱۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ قَالَ : تَلاَ ہَذِہِ الآیَۃَ {وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ : یَقُولُ فِی الْعِدَّۃِ : إنِّی عَلَیْکِ لَحَرِیصٌ وَإِنِّی فِیکِ لَرَاغِبٌ وَنَحْوَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 17119","","","كتاب النكاح"
"17120","(۱۷۱۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ : { وَلاَ جُنَاحَ عَلَیْکُمْ فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ : یَقُولُ : إنَّکِ لَجَمِیلَۃٌ وَإِنَّکِ لَنَافِقَۃٌ ، وَإِنْ قَضَی اللَّہُ شَیْئًا کَانَ۔","","Musannaf Ibn Abi Shaybah 17120","","","كتاب النكاح"
"17121","(۱۷۱۲۱) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : {فِیمَا عَرَّضْتُمْ بِہِ مِنْ خِطْبَۃِ النِّسَائِ} قَالَ: قَوْلُ الرَّجُلِ لِلْمَرْأَۃِ : إنَّکِ لَجَمِیلَۃٌ وَإِنَّکِ لَنَافِقَۃٌ وَإِنَّکِ لإِلَی خَیْرٍ ، وَلْیَکُنْ ذِکْرُ خِطْبَتِہَا فِی نَفْسِہِ ، لاَ یُبْدِیہِ لَہَا ، ہَذَا کُلُّہُ حِلٌّ مَعْرُوفٌ۔","","Musannaf Ibn Abi Shaybah 17121","","","كتاب النكاح"
"17122","(۱۷۱۲۲) حَدَّثَنَا شَرِیکٌ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ أَبِی الضُّحَی فِی قَوْلِہِ : {إلاَّ أَنْ تَقُولُوا قَوْلاً مَعْرُوفًا} قَالَ : یَقُولُ : إنِّی لأَشْتَہِیکِ۔","","Musannaf Ibn Abi Shaybah 17122","","","كتاب النكاح"
"17123","(۱۷۱۲۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عَبْدِ اللہِ بْنِ قَیْسٍ أَنَّ غُلاَمًا لأَبِی مُوسَی ، وَکَانَ صَاحِبَ إبِلِہِ تَزَوَّجَ أَمَۃً لِبَنِی جَعْدَۃَ وَسَاقَ إلَیْہَا خَمْسَ ذَوْدٍ فَحُدِّثَ أَبُو مُوسَی فَأَرْسَلَ إلَیْہِمْ: أَرْسِلُوا إلَیَّ غُلاَمِی وَمَالِی، فَقَالُوا : أَمَّا الْغُلاَمُ فَغُلاَمُکَ ، وَأَمَّا الْمَالُ فَقَدِ اسْتَحَلَّ بِہِ فَرْجَ صَاحِبَتِنَا فَاخْتَصَمُوا إلَی عُثْمَانَ بْنِ عَفَّانَ فَقَضَی لَہُمْ عُثْمَانُ بِخُمُسَی مَا اسْتَحَلَّ بِہِ فَرْجَ صَاحِبَتِہِمْ وَرَدَّ عَلَی أَبِی مُوسَی ثَلاَثَۃَ أَخْمَاسِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 17123","","","كتاب النكاح"
"17124","(۱۷۱۲۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ قَالَ : تَزَوَّجَ عَبْدٌ لأَبِی مُوسَی فِی إمْرَۃِ ع[corrupt]مَرَ عَلَی خَمْسِ قَلاَئِصَ فَرُفِعَ ذَلِکَ إلَی عُمَرَ فَجَعَلَ لِلْمَرْأَۃِ قَلُوصَیْنِ وَِلأَبِی مُوسَی ثَلاَثَ قَلاَئِصَ ، أَوْ أَعْطَاہَا ثَلاَثَ قَلاَئِصَ وَرَدَّ عَلَی أَبِی مُوسَی قَلُوصَیْنِ قَالَ : أُرَاہُ تَزَوَّجَ بِغَیْرِ إذْنِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 17124","","","كتاب النكاح"
"17125","(۱۷۱۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ تَمَّامٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ صَدَاقَ لَہَا ، ہِیَ أَبَاحَتْ فَرْجَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17125","","","كتاب النكاح"
"17126","(۱۷۱۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنْ عَامِرٍ قَالَ : یَأْخُذُ مِنْہَا مَا اسْتَہْلَکَتْ ، وَمَا لَمْ تَسْتَہْلِکْ۔","","Musannaf Ibn Abi Shaybah 17126","","","كتاب النكاح"
"17127","(۱۷۱۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : یُؤْخَذُ مِنْہَا مَا لَمْ تَسْتَہْلِکْ ، فَأَمَّا مَا اسْتَہْلَکَتْ فَلاَ شَیْئَ۔","","Musannaf Ibn Abi Shaybah 17127","","","كتاب النكاح"
"17128","(۱۷۱۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنِ الْعَبْدِ یَتَزَوَّجُ الْمَرْأَۃَ بِغَیْرِ إذْنِ مَوَالِیہِ ، قَالَ: یُفَرَّقُ بَیْنَہُمَا وَلاَ صَدَاقَ لَہَا ، یُؤْخَذُ مِنْہَا مَا أَخَذَتْ۔","","Musannaf Ibn Abi Shaybah 17128","","","كتاب النكاح"
"17129","(۱۷۱۲۹) حَدَّثَنَا غُنْدَرٌ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ؛ فِی مَمْلُوکٍ تَزَوَّجَ بِغَیْرِ إذْنِ سَیِّدِہِ فَدَخَلَ بِہَا قَالَ لَہَا مَا أَخَذَتْ۔","","Musannaf Ibn Abi Shaybah 17129","","","كتاب النكاح"
"17130","(۱۷۱۳۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی الْعَبْدِ إذَا تَزَوَّجَ بِغَیْرِ إذْنِ سَیِّدِہِ فَلَیْسَ بِنِکَاحٍ وَلَیْسَ لَہَا بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 17130","","","كتاب النكاح"
"17131","(۱۷۱۳۱) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ فِی عَبْدٍ تَزَوَّجَ بِغَیْرِ إذْنِ مَوْلاَہُ وَسَاقَ صَدَاقًا ، قَالَ: إِنْ کَانَ دَخَلَ بِہَا فَلَہَا الصَّدَاقُ ، وَإِنْ لَمْ یَدْخُلْ بِہَا أَخَذَ الْمَوْلَی الصَّدَاقَ۔","","Musannaf Ibn Abi Shaybah 17131","","","كتاب النكاح"
"17132","(۱۷۱۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، قَالَ : سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَیُّمَا عَبْدٍ تَزَوَّجَ بِغَیْرِ إذْنِ مَوْلاَہُ فَہُوَ عَاہِرٌ۔ (ابوداؤد ۲۰۸۰۔ احمد ۳۷۷)","Da'if","Musannaf Ibn Abi Shaybah 17132","","","كتاب النكاح"
"17133","(۱۷۱۳۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ہَمَّامٌ قَالَ حَدَّثَنَا الْقَاسِمُ بْنُ عَبْدِ الْوَاحِدِ ، عَنْ عَبْدِ اللہِ بْنِ مُحَمَّدِ بْنِ عَقِیلٍ ، عَنْ جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَیُّمَا عَبْدٍ تَزَوَّجَ أو قَالَ : نکح بِغَیْرِ إذْنِ أَہْلِہِ فَہُوَ عَاہِرٌ۔ (حاکم ۱۹۴۔ احمد ۳/۳۸۲)","Da'if","Musannaf Ibn Abi Shaybah 17133","","","كتاب النكاح"
"17134","(۱۷۱۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : نِکَاحُ الْعَبْدِ بِغَیْرِ إذْنِ سَیِّدِہِ زِنًا ، وَیُعَاقَبُ الَّذِی زَوَّجَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 17134","","","كتاب النكاح"
"17135","(۱۷۱۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ کَانَ إذَا تَزَوَّجَ عَبْدُہُ بِغَیْرِ إذْنٍ ضَرَبَہُ الْحَدَّ۔","Sahih","Musannaf Ibn Abi Shaybah 17135","","","كتاب النكاح"
"17136","(۱۷۱۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْجَرِیرِیِّ قَالَ : سَأَلْتُ غُنَیْمَ بْنَ قَیْسٍ ، قُلْتُ : الْعَبْدُ یَتَزَوَّجُ بِغَیْرِ إذْنِ سَیِّدِہِ ، أَزَانٍ ہُوَ ؟ قَالَ : قَدْ عَصَی ، قُلْتُ : أَزَانٍ ہُوَ ؟ قَالَ : قَدْ عَصَی۔","","Musannaf Ibn Abi Shaybah 17136","","","كتاب النكاح"
"17137","(۱۷۱۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ فِی الْعَبْدِ یَتَزَوَّجُ بِغَیْرِ إذْنِ مَوْلاَہُ ، قَالَ : قدْ کَانَ فِی شَیْئٍ فَسَلُوا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 17137","","","كتاب النكاح"
"17138","(۱۷۱۳۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ قَالَ : لاَ یَتَزَوَّجُ الْعَبْدُ إلاَّ بِإِذْنِ مَوْلاَہُ۔","","Musannaf Ibn Abi Shaybah 17138","","","كتاب النكاح"
"17139","(۱۷۱۳۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنِ الشَّعْبِیِّ فِی قَوْلِہِ : {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} قَالَ : لاَ یَأْخُذُ عَلَیْہَا عَہْدًا وَلاَ مِیثَاقًا أَلاَّ تَزَوَّجَ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 17139","","","كتاب النكاح"
"17140","(۱۷۱۴۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} یَخْطُبُہَا فِی عِدَّتِہَا۔","","Musannaf Ibn Abi Shaybah 17140","","","كتاب النكاح"
"17141","(۱۷۱۴۱) حَدَّثَنَا عبد الوہاب الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ قَالَ : {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} قَالَ : یَلْقَی الْوَلِیَّ فَیَذْکُرُ رَغْبَۃً وَحِرْصًا۔","","Musannaf Ibn Abi Shaybah 17141","","","كتاب النكاح"
"17142","(۱۷۱۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ، عَنْ سَعِیدٍ قَالَ : لاَ یُقَاضِیہَا فی الْعِدَّۃِ أَنْ لاَ تَزَوَّجَ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 17142","","","كتاب النكاح"
"17143","(۱۷۱۴۳) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : (وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا) قَوْلُ الرَّجُلِ لِلْمَرْأَۃِ : لاَ تَفُوتِینِی بِنَفْسِکِ فَإِنِّی نَاکِحُکِ ، ہَذَا لاَ یَحِلُّ۔","","Musannaf Ibn Abi Shaybah 17143","","","كتاب النكاح"
"17144","(۱۷۱۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مَخْلَدٍ ، وَالْحَسَنِ : {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} قَالاَ : الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17144","","","كتاب النكاح"
"17145","(۱۷۱۴۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عِمْرَانَ ، عَنِ الْحَسَنِ : {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} قَالَ : الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17145","","","كتاب النكاح"
"17146","(۱۷۱۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنِ الْحَسَنِ قَالَ سَمِعْتُہُ یَقول {وَلَکِنْ لاَ تُوَاعِدُوہُنَّ سِرًّا} قَالَ: الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17146","","","كتاب النكاح"
"17147","(۱۷۱۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّی ، عَنْ إبْرَاہِیمَ قَالَ : الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17147","","","كتاب النكاح"
"17148","(۱۷۱۴۸) حَدَّثَنَا جَرِیرٌ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ قَالَ : الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17148","","","كتاب النكاح"
"17149","(۱۷۱۴۹) حدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبی ہِلال عَن حَیَّانَ الأَعْرَجِ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17149","","","كتاب النكاح"
"17150","(۱۷۱۵۰) حدَّثَنَا یَحْیَی بْنُ یَمَانٍ، عَنْ سُفْیَانَ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ، عَنِ الضَّحَّاکِ قَالَ: لاَ یُقَاضِیہَا أَنْ لاَ تَزَوَّجَ غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 17150","","","كتاب النكاح"
"17151","(۱۷۱۵۱) حدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ حَنَش بْنِ الْمُعْتَمِرِ قَالَ : أُتِیَ عَلِیٌّ برَجُلٍ قَدْ أَقَرَّ عَلَی نَفْسِہِ بِالزِّنَا ، فَقَالَ لَہُ علی : أُحْصِنْتَ ؟ قَالَ : نَعَمْ قَالَ : إذًا تُرْجَمُ ، قَالَ فَرَفَعَہُ إلَی السِّجْنِ فَلَمَّا کَانَ الْعَشِیّ دَعَا بِہِ فَقَصَّ أَمْرَہُ عَلَی النَّاسِ ، فَقَالَ رَجُلٌ مِنَ النَّاسِ : إنَّہُ قَدْ تَزَوَّجَ امْرَأَۃً لَمْ یَدْخُلْ بِہَا ، فَفَرِحَ بِذَلِکَ عَلِیٌّ فَضَرَبَہُ الْحَدَّ وَفَرَّقَ بَیْنَہُ وَبَیْنَ امْرَأَتِہِ وَأَعْطَاہَا نِصْفَ الصَّدَاقِ فِیمَا یُرَی سِمَاک۔","Da'if","Musannaf Ibn Abi Shaybah 17151","","","كتاب النكاح"
"17152","(۱۷۱۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ وَعَنْ أَشْعَثَ ، عَنِ الْحَسَنِ أنَّ الْبِکْرَ إذَا زَنَتْ جُلِدَتْ وَفُرِّقَ بَیْنَہَا وَبَیْنَ زَوْجِہَا وَلَیْسَ لَہَا شَیْئٌ ثُمَّ تَأَوَّلَ الْحَسَنُ ہَذِہِ الآیَۃَ : {وَلاَ تَعْضُلُوہُنَّ لِتَذْہَبُوا بِبَعْضِ مَا آتَیْتُمُوہُنَّ إلاَّ أَنْ یَأْتِینَ بِفَاحِشَۃٍ مُبَیِّنَۃٍ}۔","Da'if","Musannaf Ibn Abi Shaybah 17152","","","كتاب النكاح"
"17153","(۱۷۱۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ ، یُفَرَّقُ بَیْنَہُمَا وَلاَ صَدَاقَ لَہَا۔","","Musannaf Ibn Abi Shaybah 17153","","","كتاب النكاح"
"17154","(۱۷۱۵۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ ثُمَّ تَزْنِی قَبْلَ أَنْ یَدْخُلَ بِہَا ، قَالَ: یُفَرَّقُ بَیْنَہُمَا وَلاَ صَدَاقَ لَہَا وَجَلْدُ مِئَۃٍ وَنَفْیُ سَنَۃٍ ، وَإِنْ ہُوَ زَنَی فُرِّقَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17154","","","كتاب النكاح"
"17155","(۱۷۱۵۵) حَدَّثَنَا جَرِیرٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : ہِیَ امْرَأَتُہُ یُقَامُ عَلَیْہِ الْحَدُّ ، إِنْ شَائَ طَلَّقَ ، وَإِنْ شَائَ أَمْسَکَ کَمَا أَنَّہُ لَوْ فَجَرَ لَمْ تُنْزَعْ عَنْہُ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 17155","","","كتاب النكاح"
"17156","(۱۷۱۵۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ فِی رَجُلٍ زَنَی قَبْلَ أَنْ یَدْخُلَ بِامْرَأَتِہِ ، فَکَانَ مِنْ رَأْیِہِ أَنْ لاَ یُفَرَّقَ بَیْنَہُ وَبَیْنَ امْرَأَتِہِ۔","","Musannaf Ibn Abi Shaybah 17156","","","كتاب النكاح"
"17157","(۱۷۱۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَأَصَابَ أَحَدُہُمَا فَاحِشَۃً قَبْلَ أَنْ یَدْخُلَ بِہَا قَالَ : یُجْلَدُ وَلاَ یُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17157","","","كتاب النكاح"
"17158","(۱۷۱۵۸) حدَّثَنَا ابن فُضَیل عَن ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنْ صَفِیَّۃَ بِنْتِ أَبِی عُبَیْدٍ قَالَتْ : تَزَوَّجَ رَجُلٌ امْرَأَۃً ثُمَّ فَجَرَ بِأُخْرَی قَبْلَ أَنْ یَدْخُلَ بِامْرَأَتِہِ فَجَلَدَہُ أَبُو بَکْرٍ مِئَۃً وَنَفَاہُ سَنَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 17158","","","كتاب النكاح"
"17159","(۱۷۱۵۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْخَلِیلِ أَنَّ أَبَا عَلْقَمَۃَ الْہَاشِمِیَّ حدَّثَنَا أَنَّ أَبَا سَعِیدٍ الْخُدْرِیَّ حَدَّثَہُمْ : أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعَثَ یَوْمَ حُنَیْنٍ سَرِیَّۃً فَأَصَابُوا حَیًّا مِنَ الْعَرَبِ یَوْمَ أَوْطَاسٍ فَہَزَمُوہُمْ وَقَتَلُوہُمْ وَأَصَابُوا نِسَائً لَہُنَّ أَزْوَاجٌ من زنی ، فَکَانَ أُنَاسٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تأثموا مِنْ غِشْیَانِہِنَّ مِنْ أَجْلِ أَزْوَاجِہِنَّ فَأَنْزَلَ اللَّہُ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} مِنْہُنَّ فحلال لَکُمْ۔ (مسلم ۳۳۔ ابوداؤد ۲۱۴۸)","Sahih","Musannaf Ibn Abi Shaybah 17159","","","كتاب النكاح"
"17160","(۱۷۱۶۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عن إبْرَاہِیمَ قَالَ : قَالَ عَلِیٌّ ، فِی قولہ تعالی: {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ : ذَوَاتُ الأَزْوَاجِ مِنَ الْمُشْرِکِینَ۔","","Musannaf Ibn Abi Shaybah 17160","","","كتاب النكاح"
"17161","(۱۷۱۶۱) حَدَّثَنَا عبد الوہاب الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : سَبَایَا کَانَ لَہُنَّ أَزْوَاجٌ قَبْلَ أَنْ یُسْبَیْنَ۔","","Musannaf Ibn Abi Shaybah 17161","","","كتاب النكاح"
"17162","(۱۷۱۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ أَنَسٍ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ : ذَوَاتُ الأَزْوَاجِ۔","Sahih","Musannaf Ibn Abi Shaybah 17162","","","كتاب النكاح"
"17163","(۱۷۱۶۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زمعۃ ، عَنِ الزُّہْرِیِّ ، عَنِ سعید بْنِ الْمُسَیَّبِ قَالَ : ذَوَاتُ الأَزْوَاجِ ، یَرْجِعُ ذَلِکَ إلَی أَنَّ اللَّہَ تَعَالَی حَرَّمَ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17163","","","كتاب النكاح"
"17164","(۱۷۱۶۴) حَدَّثَنَا عبد اللہ بْنُ إدْرِیسَ ، عَنْ أَشْعَثَ وَہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ عَبِیدَۃَ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ بِیَدِہِ ہَکَذَا وَأَشَارَ بِالأَرْبَعِ : إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ۔","","Musannaf Ibn Abi Shaybah 17164","","","كتاب النكاح"
"17165","(۱۷۱۶۵) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنِ الصَّلْتِ، عَنْ إبْرَاہِیمَ قَالَ: کُلُّ ذَاتِ زَوْجٍ عَلَیْک حَرَامٌ إلاَّ مَا أَصَبْتَ مِنَ السَّبَایَا۔","","Musannaf Ibn Abi Shaybah 17165","","","كتاب النكاح"
"17166","(۱۷۱۶۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ قَالَ : نَزَلَتْ یَوْمَ أَوْطَاسٍ۔","","Musannaf Ibn Abi Shaybah 17166","","","كتاب النكاح"
"17167","(۱۷۱۶۷) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنْ أَشْعَثَ ، عَنْ حَسَنٍ قَالَ : کُلُّ ذَاتِ زَوْجٍ عَلَیْک حَرَامٌ إلاَّ مَا مَلَکَتْ یَمِینُک یَعْنِی مِنَ السَّبَایَا۔","Hasan","Musannaf Ibn Abi Shaybah 17167","","","كتاب النكاح"
"17168","(۱۷۱۶۸) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنِ الْحَسَنِ بْنِ مُحَمَّدٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 17168","","","كتاب النكاح"
"17169","(۱۷۱۶۹) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : ہُوَ الزِّنَا ، وَقَالَ مُجَاہِدٌ : ہُوَ الزِّنَا ، وَقَالَ عِکْرِمَۃُ : ہُوَ الزِّنَا {إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} وَقَالَ ابْنُ عَبَّاسٍ : {إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} یَنْزِعُ الرَّجُلُ وَلِیدَتہ امْرَأَۃَ عَبْدِہِ وَقَالَ غَیْرُہُ : سَبَایَا الْعَدُوِّ یُوطَأْنَ إذَا مَا سُبِیَتْ أَزْوَاجُہُنَّ۔","","Musannaf Ibn Abi Shaybah 17169","","","كتاب النكاح"
"17170","(۱۷۱۷۰) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : أَرْبَعٌ۔","","Musannaf Ibn Abi Shaybah 17170","","","كتاب النكاح"
"17171","(۱۷۱۷۱) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ مَکْحُولٍ قَالَ : أَرْبَعٌ۔","","Musannaf Ibn Abi Shaybah 17171","","","كتاب النكاح"
"17172","(۱۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَن عَبْدِ اللہِ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} قَالَ : ذَوَاتُ الأَزْوَاجِ۔","","Musannaf Ibn Abi Shaybah 17172","","","كتاب النكاح"
"17173","(۱۷۱۷۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ فِی قَوْلِہِ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ : کُلُّ ذَاتِ زَوْجٍ عَلَیْکَ حَرَامٌ إلاَّ مَا مَلَکَتْ یَمِینُکَ ، أَوْ تَشْتَرِیہَا۔","","Musannaf Ibn Abi Shaybah 17173","","","كتاب النكاح"
"17174","(۱۷۱۷۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : کُلُّ ذَاتِ زَوْجٍ عَلَیْکَ حَرَامٌ إلاَّ مَا مَلَکَتْ یَمِینُکَ مِنَ السَّبَایَا یُرِیدُ {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ}۔","","Musannaf Ibn Abi Shaybah 17174","","","كتاب النكاح"
"17175","(۱۷۱۷۵) حَدَّثَنَا عُبَیْدُ اللہِ قَالَ : أَخْبَرَنَا إسْرَائِیلُ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مَکْحُولٍ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ : ذَوَاتُ الأَزْوَاجِ۔","","Musannaf Ibn Abi Shaybah 17175","","","كتاب النكاح"
"17176","(۱۷۱۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی السَّوْدَائِ قَالَ : سَأَلْتُ عِکْرِمَۃَ عَنْہَا ، فَقَالَ : لاَ أَدْرِی ، وَسَأَلْتُ الشَّعْبِیَّ ، فَقَالَ : ہِیَ کُلُّ ذَاتِ زَوْجٍ۔","","Musannaf Ibn Abi Shaybah 17176","","","كتاب النكاح"
"17177","(۱۷۱۷۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} قَالَ : من النساء کُلِّہِنَّ إلاَّ ذَوَاتِ الأَزْوَاجِ مِنَ السَّبَایَا۔","Da'if","Musannaf Ibn Abi Shaybah 17177","","","كتاب النكاح"
"17178","(۱۷۱۷۸) حَدَّثَنَا غُنْدَرٌ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی قَوْلِہِ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} قَالَ : الزِّنَا ، وَقَالَ مُجَاہِدٌ : ہُوَ الزِّنَا ، وَقَالَ ابْنُ عَبَّاسٍ : ہُوَ الزِّنَا إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ یَنْزِعُ الرَّجُلُ وَلِیدَتہ امْرَأَۃَ عَبْدِہِ فَیَطَؤُہَا إِنْ شَائَ ، وَقَالَ غَیْرُہُ : سَبَایَا الْعَدُوِّ۔","","Musannaf Ibn Abi Shaybah 17178","","","كتاب النكاح"
"17179","(۱۷۱۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ الْحَسَنِ قَالَ : حدثنا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدٍ فِی قَوْلِہِ : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} قَالَ : نَزَلَتْ فِی نِسَائِ أَہْلِ حُنَیْنٍ ، لَمَّا افْتَتَحَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حُنَیْنًا أَصَابَ الْمُسْلِمُونَ السَّبَایَا ، فَکَانَ الرَّجُلُ إذَا أَرَادَ أَنْ یَأْتِیَ الْمَرْأَۃَ مِنْہُنَّ قَالَتْ : إنَّ لِی زَوْجًا فَأَتَوُا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرُوا ذَلِکَ لَہُ فَأَنْزَلَ اللَّہُ تَعَالَی : {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} قَالَ : السَّبَایَا مِنْ ذَوَاتِ الأَزْوَاجِ۔","","Musannaf Ibn Abi Shaybah 17179","","","كتاب النكاح"
"17180","(۱۷۱۸۰) حَدَّثَنَا شَبَابَۃُ، عَنْ وَرْقَائَ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ مُجَاہِدٍ: {وَالْمُحْصَنَاتُ مِنَ النِّسَائِ} نہی، عَنِ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17180","","","كتاب النكاح"
"17181","(۱۷۱۸۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ طَارِقٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لاَ تَغُرَّنَّکُمْ ہَذِہِ الآیَۃُ {إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} إنَّمَا عَنَی بِہِ الإِمَائَ وَلَمْ یَعْنِ بِہا الْعَبِیدَ۔","","Musannaf Ibn Abi Shaybah 17181","","","كتاب النكاح"
"17182","(۱۷۱۸۲) حَدَّثَنَا جَرِیرٍ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی رَزِینٍ فِی قَوْلِہِ : {لاَ یَحِلُّ لَکَ النِّسَائُ مِنْ بَعْدُ} قَالَ : لاَ یَحِلُّ لَکَ مِنَ الْمُشْرِکَاتِ إلاَّ مَا سَبَیْتَ ، أَوْ مَا مَلَکَتْ یَمِینُکَ۔","","Musannaf Ibn Abi Shaybah 17182","","","كتاب النكاح"
"17183","(۱۷۱۸۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : مِنْ مُسْلِمَۃٍ وَلاَ نَصْرَانِیَّۃٍ وَلاَ کَافِرَۃٍ۔","","Musannaf Ibn Abi Shaybah 17183","","","كتاب النكاح"
"17184","(۱۷۱۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ قَالَ : {لاَ یَحِلُّ لَکَ النِّسَائُ مِنْ بَعْدُ} قَالَ: نِسَائُ الأُمَمِ مِنْ أَہْلِ الْکِتَابِ۔","","Musannaf Ibn Abi Shaybah 17184","","","كتاب النكاح"
"17185","(۱۷۱۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ بَذِیْمَۃَ ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ : {لاَ یَحِلُّ لَکَ النِّسَائُ مِنْ بَعْدُ} قَالَ : مِنْ بَعْدِ ہَذَا السَّبَبِ۔","","Musannaf Ibn Abi Shaybah 17185","","","كتاب النكاح"
"17186","(۱۷۱۸۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی مُوسَی ، عَنْ زِیَادٍ قَالَ : قیل لأُبَیٍّ : لَوْ ہَلَکَ أَزْوَاجُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَلَّ لَہُ أَنْ یَتَزَوَّجَ ؟ قَالَ : وَمَنْ یَمْنَعُہُ ؟ أَحَلَّ اللَّہُ لَہُ ضَرْبًا مِنَ النِّسَائِ ، فَکَانَ یَتَزَوَّجُ مِنْہُنَّ مَنْ شَائَ ، ثُمَّ تَلاَ ہَذِہِ الآیَۃَ : {یَا أَیُّہَا النَّبِیُّ إنَّا أَحْلَلْنَا لَکَ أَزْوَاجَک اللاَّتِی} حَتَّی خَتَمَ الآیَۃَ۔ (طبری ۲۹۔ دارمی ۲۲۴۰)","Da'if","Musannaf Ibn Abi Shaybah 17186","","","كتاب النكاح"
"17187","(۱۷۱۸۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ قَالَتْ : مَا مَاتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی أُحِلَّ لَہُ النِّسَائَ۔ (ترمذی ۳۲۱۶۔ احمد ۴۱)","Sahih","Musannaf Ibn Abi Shaybah 17187","","","كتاب النكاح"
"17188","(۱۷۱۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ : {وَلاَ أَنْ تَبَدَّلَ بِہِنَّ مِنْ أَزْوَاجٍ وَلَوْ أَعْجَبَک حُسْنُہُنَّ} قَالَ : لاَ تَبَدَّلُ بِہِنَّ یَہُودِیَّاتٍ وَلاَ نَصْرَانِیَّاتٍ۔","","Musannaf Ibn Abi Shaybah 17188","","","كتاب النكاح"
"17189","(۱۷۱۸۹) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ قَالَ : مِنْ أَہْلِ الْکِتَابِ ، أَوْ أَعْرَابِیَّۃٍ۔","","Musannaf Ibn Abi Shaybah 17189","","","كتاب النكاح"
"17190","(۱۷۱۹۰) حَدَّثَنَا عُبَیدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنِ السدِّی ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ فِی قَوْلِہِ : {وَلاَ أَنْ تَبَدَّلَ بِہِنَّ مِنْ أَزْوَاجٍ} قَالَ : ذَلِکَ لَوْ طَلَّقَہُنَّ لَمْ یَحِلَّ لَہُ أَنْ یَسْتَبْدِلَ ، قَالَ : وَقَدْ کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْکِحُ مَا شَائَ بَعْدَ مَا نَزَلَتْ ، وَنَزَلَتْ وَتَحْتَہُ تِسْعُ نِسْوَۃٍ وَتَزَوَّجَ أُمَّ حَبِیبَۃَ وَجُوَیْرِیَۃَ۔","","Musannaf Ibn Abi Shaybah 17190","","","كتاب النكاح"
"17191","(۱۷۱۹۱) حَدَّثَنَا عَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنِ الْحَسَنِ : {وَلاَ أَنْ تَبَدَّلَ بِہِنَّ مِنْ أَزْوَاجٍ} قَالَ: قَصَرَہُ اللَّہُ عَلَی نِسَائِہِ التِّسْعِ اللاَّتِی مَاتَ عَنْہُنَّ ، قَالَ : قَالَ عَلِیٌّ : فَأَخْبَرْت بِذَلِکَ عَلِیَّ بْنَ حُسَیْنٍ ، فَقَالَ : بل کَانَ لَہُ أَنْ یَتَزَوَّجَ۔","","Musannaf Ibn Abi Shaybah 17191","","","كتاب النكاح"
"17192","(۱۷۱۹۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ شُبْرُمَۃَ ، عَنْ عِکْرِمَۃَ : (الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً) لاَ یَزْنِی الزَّانِی إلاَّ بِزَانِیَۃٍ۔","","Musannaf Ibn Abi Shaybah 17192","","","كتاب النكاح"
"17193","(۱۷۱۹۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : {الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً أَوْ مُشْرِکَۃً} قَالَ : کَانَ یُقَالُ نَسَخَتْہَا الَّتِی بَعْدَہَا {وَأَنْکِحُوا الأَیَامَی مِنْکُمْ} قَالَ : وَکَانَ یُقَالُ إنَّہَا مِنْ أَیَامَی الْمُسْلِمِینَ۔","","Musannaf Ibn Abi Shaybah 17193","","","كتاب النكاح"
"17194","(۱۷۱۹۴) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ یَعْلَی بْنِ مُسْلِمٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ: لاَ یَزْنِی إلاَّ بِزَانِیَۃٍ ، أَوْ مُشْرِکَۃٍ۔","","Musannaf Ibn Abi Shaybah 17194","","","كتاب النكاح"
"17195","(۱۷۱۹۵) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ إبْرَاہِیمَ بْنِ الْمُہَاجِرِ، عَنْ مُجَاہِدٍ قَالَ سَمِعْتُہُ یَقُولُ: کُنَّ بَغَایَا فِی الْجَاہِلِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 17195","","","كتاب النكاح"
"17196","(۱۷۱۹۶) حَدَّثَنَا عَبْدَۃَ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَاصِمِ بْنِ الْمُنْذِرِ قَالَ : سَأَلْتُ عُرْوَۃَ ، عَنْ قَوْلِہِ : {الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً أَوْ مُشْرِکَۃً} قَالَ : کُنَّ نِسَائً بَغَایَا فِی الْجَاہِلِیَّۃِ لَہُنَّ رَایَاتٌ یُعْرَفْنَ بِہَا۔","","Musannaf Ibn Abi Shaybah 17196","","","كتاب النكاح"
"17197","(۱۷۱۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشعبی قَالَ : نِسَائٌ کُنَّ یَکْرِینَ أَنْفُسَہُنَّ فِی الْجَاہِلِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 17197","","","كتاب النكاح"
"17198","(۱۷۱۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ ، عَنِ الضَّحَّاکِ فِی قَوْلِہِ : (الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً أَوْ مُشْرِکَۃً وَالزَّانِیَۃُ لاَ یَنْکِحُہَا إلاَّ زَانٍ أَوْ مُشْرِکٌ) قَالَ : لاَ یَزْنِی حِینَ یَزْنِی إلاَّ بِزَانِیَۃٍ وَلاَ تَزْنِی حِینَ تَزْنِی إلاَّ بِزَانٍ مِثْلِہَا۔","","Musannaf Ibn Abi Shaybah 17198","","","كتاب النكاح"
"17199","(۱۷۱۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 17199","","","كتاب النكاح"
"17200","(۱۷۲۰۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ شُعْبَۃَ مَوْلَی ابْنِ عَبَّاسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : بَغَایَا کُنَّ فِی الْجَاہِلِیَّۃِ یَجْعَلْنَ عَلَی أَبْوَابِہِنَّ رَایَاتٍ کَرَایَاتِ الْبَیَاطِرَۃِ ، یَأْتِیہِنَّ النَّاسُ ، یُعْرَفْنَ بِذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 17200","","","كتاب النكاح"
"17201","(۱۷۲۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ عَاصِمِ بْنِ الْمُنْذِرِ ، عَنْ عُرْوَۃَ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 17201","","","كتاب النكاح"
"17202","(۱۷۲۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : {الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً أَوْ مُشْرِکَۃً} یَعْنِی بِالنِّکَاحِ : یُجَامِعُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 17202","","","كتاب النكاح"
"17203","(۱۷۲۰۳) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنِ الْحَارِثِ ، عَنْ إبْرَاہِیمَ قَالَ لاَ یُجَامِعُہَا إلاَّ زَانٍ أَوْ مُشْرِکٌ۔","","Musannaf Ibn Abi Shaybah 17203","","","كتاب النكاح"
"17204","(۱۷۲۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ التَّمَّارُ العُصْفُریّ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ : کُنَّ بَغَایَا بِمَکَّۃَ قَبْلَ الإِسْلاَمِ ، فَکَانَ رِجَالٌ یَتَزَوَّجُونَہُنَّ فَیُنْفِقْنَ عَلَیْہِمْ مَا أَصَبْنَ فَلَمَّا جَائَ الإِسْلاَمُ تَزَوَّجَہُنَّ رِجَالٌ مِنْ أَہْلِ الإِسْلاَمِ فَحَرَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَلِکَ عَلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 17204","","","كتاب النكاح"
"17205","(۱۷۲۰۵) حَدَّثَنَا عَفَّانُ قَالَ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنِ ابْنِ عَبَّاسٍ : (الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً أَوْ مُشْرِکَۃً) قَالَ : الزَّانِی لاَ یزنی إلاَّ بِزَانِیَۃٍ ، أَوْ مُشْرِکَۃٍ وَلَکِنَّ اللَّہَ کَنَّی۔","","Musannaf Ibn Abi Shaybah 17205","","","كتاب النكاح"
"17206","(۱۷۲۰۶) حَدَّثَنَا شَبَابَۃُ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : (الزَّانِی لاَ یَنْکِحُ إلاَّ زَانِیَۃً) بَغَایَا مُتَعَالِنَاتٌ کُنَّ فِی الْجَاہِلِیَّۃِ فَقِیلَ لَہُنَّ : ہَذَا حَرَامٌ فَأَرَادُوا نِکَاحَہُنَّ فَحَرَّمَ اللَّہُ عَلَیْہِمْ نِکَاحَہُنَّ۔","","Musannaf Ibn Abi Shaybah 17206","","","كتاب النكاح"
"17207","(۱۷۲۰۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : أَحَلُّ النِّسَائِ للزَّانِی الزَّانِیَۃُ قَالَ : وَسَأَلْتُ الْحَسَنَ ، فَقَالَ : إنا لاَ نُفتِی فِی الْمَسْتُورِ وَلَکِنِ الْمَحْدُودُ لاَ یَتَزَوَّجُ إلاَّ مَحْدُودَۃً۔","","Musannaf Ibn Abi Shaybah 17207","","","كتاب النكاح"
"17208","(۱۷۲۰۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنِ ابْنِ سَابِطٍ أَنَّ عَلِیًّا أُتِیَ بِمَحْدُودٍ تَزَوَّجَ امْرَأَۃً غَیْرَ مَحْدُودَۃٍ فَفَرَّقَ بَیْنَہُمَا۔","Da'if","Musannaf Ibn Abi Shaybah 17208","","","كتاب النكاح"
"17209","(۱۷۲۰۹) حَدَّثَنَا بَکَّارُ بْنُ عَبْدِ اللہِ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَخِیہِ عَبْدِ اللہِ بْنِ عُبَیْدَۃَ أَنَّ مَوْلاَۃً لِبَنِی حَارِثَۃَ جُلِدَتْ حَدَّ الزِّنَا فَأَرَادَ رَجُلٌ أَنْ یَتَزَوَّجَہَا فَاسْتَشَارَ أَبَا ہُرَیْرَۃَ ، فَقَالَ: لاَ، إلاَّ أَنْ تَکُونَ عَمِلْتَ مِثْلَ عَمَلِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17209","","","كتاب النكاح"
"17210","(۱۷۲۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ أَنَّ رَجُلاً أَرَادَ أَنْ یُزَوِّجَ ابْنَۃً ، فَقَالَتْ : إنِّی أَخْشَی أَنْ أَفْضَحَکَ ، إنِّی قَدْ بَغَیْتُ ، فَأَتَی عُمَرَ ، فَقَالَ : أَلَیْسَتْ قَدْ تَابَتْ ؟ قَالَ : نَعَمْ ، قَالَ : فَزَوِّجْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 17210","","","كتاب النكاح"
"17211","(۱۷۲۱۱) حدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ أَنَّ امْرَأَۃَ رِفَاعَۃَ الْقُرَظِیِّ جَائَتْ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : إنِّی کُنْتُ عِنْدَ رِفَاعَۃَ الْقُرَظِیِّ فَطَلَّقَنِی فَبَتَّ طَلاَقِی فَتَزَوَّجْتُ عَبْدَ الرَّحْمَنِ بْنَ الزَّبِیْرِ وَإِنَّمَا مَعَہُ مِثْلُ ہُدْبَۃِ الثَّوْبِ ، فَتَبَسَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَقَالَ : تُرِیدِینَ أَنْ تَرْجِعِی إلَی رِفَاعَۃَ ؟ لاَ حَتَّی تَذُوقِی عُسَیْلَتَہُ وَیَذُوقَ عُسَیْلَتَکِ۔ (بخاری ۲۶۳۹۔ مسلم ۱۱۱)","Sahih","Musannaf Ibn Abi Shaybah 17211","","","كتاب النكاح"
"17212","(۱۷۲۱۲) حَدَّثَنَا أبو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ قَالَتْ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تحل لہ حَتَّی یَذُوقَ الآخر عُسَیْلَتَہَا وَتَذُوقَ عُسَیْلَتَہُ۔ (ابوداؤد ۲۳۰۳۔ احمد ۶/۴۲)","Sahih","Musannaf Ibn Abi Shaybah 17212","","","كتاب النكاح"
"17213","(۱۷۲۱۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مثل حدیث الأعمش۔ (بخاری ۵۲۶۱۔ مسلم ۱۱۵)","Sahih","Musannaf Ibn Abi Shaybah 17213","","","كتاب النكاح"
"17214","(۱۷۲۱۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَحْوہ۔n(بخاری ۵۲۶۵۔ مسلم ۱۱۴)","Sahih","Musannaf Ibn Abi Shaybah 17214","","","كتاب النكاح"
"17215","(۱۷۲۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ سُلَیْمَانَ بْنِ رَزِینٍ ، عَنِ ابْنِ عُمَرَ قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا فَتَزَوَّجَتْ زَوْجًا غَیْرَہُ فَأَغْلَقَ الْبَابَ وَأَرْخَی السِّتْرَ ثُمَّ طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا قَالَ : لاَ تَحِلُّ لَہُ حَتَّی تَنْکِحَ زَوْجًا غَیْرَہُ وَتَذُوقَ عُسَیْلَتَہُ۔n قَالَ وَکِیعٌ بأخرۃ : رَزِینِ بْنِ سُلَیْمَانَ۔ (احمد ۲/۲۵۔ بیہقی ۳۷۵)","Da'if","Musannaf Ibn Abi Shaybah 17215","","","كتاب النكاح"
"17216","(۱۷۲۱۶) حَدَّثَنَا شَریک ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : قَالَ عَلِیٌّ : لاَ تَحِلُّ لَہُ حَتَّی یَہُزَّہَا بِہِ ہَزِیزَ الْبِکْرِ ، قَالَ : وَقَالَتْ عَائِشَۃُ : حَتَّی یَذُوقَ الآخَرُ عُسَیْلَتَہَا وَتَذُوقَ عُسَیْلَتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 17216","","","كتاب النكاح"
"17217","(۱۷۲۱۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَحْیَی بْنِ یَزِیدَ الْہُنَائی ، عَنْ أَنَسٍ قَالَ : لاَ تَحِلُّ لِلأَوَّلِ حَتَّی یُجَامِعَہَا الآخَرُ وَیَدْخُلَ بِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 17217","","","كتاب النكاح"
"17218","(۱۷۲۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی تِحْیَی ، قَالَ : قَالَ أَبُو ہُرَیْرَۃَ : لاَ تَحِلُّ لِلأَوَّلِ حَتَّی یُجَامِعَہَا الآخَرُ۔","Hasan","Musannaf Ibn Abi Shaybah 17218","","","كتاب النكاح"
"17219","(۱۷۲۱۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَن عَبْدِ اللہِ : لاَ تَحِلُّ لَہُ حَتَّی یُشَفْشِفَہَا بِہِ ، وَقَالَ علی: حَتَّی تَذُوقَ عُسَیْلَتَہُ۔","","Musannaf Ibn Abi Shaybah 17219","","","كتاب النكاح"
"17220","(۱۷۲۲۰) حدَّثَنَا الأَشْیَبُ الْحَسَنُ بْنُ مُوسَی ، عَنْ شَیْبَانَ ، عَنْ یَحْیَی ، عَنْ أَبِی الْحَارِثِ الْغِفَارِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : حَتَّی تَذُوقَ عُسَیْلَتَہُ۔ (ابن جریر ۴۷۷)","Da'if","Musannaf Ibn Abi Shaybah 17220","","","كتاب النكاح"
"17221","(۱۷۲۲۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خالد عن أَبِی قِلاَبَۃَ ، عَنْ أَنَسٍ قَالَ : إذَا تَزَوَّجَ الرَّجُلُ الْبِکْرَ عَلَی امْرَأَتِہِ أَقَامَ عِنْدَہَا سَبْعًا وَإِذَا تَزَوَّجَ الثَّیِّبَ أَقَامَ عِنْدَہَا ثَلاَثًا ، قَالَ خَالِدٌ : قَالَ أَبُو قِلاَبَۃَ : أَمَا لَوْ قُلْتُ : إنَّہُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَکِنَّہَا سُنَّۃٌ قَالَ خَالِدٌ : فَحَدَّثْتُ بِہِ ابْنَ سِیرِینَ ، فَقَالَ : زِدْتُمْ ہَذِہِ أَرْبَعًا وَہَذِہِ لَیْلَۃً۔n(بخاری ۵۲۱۳۔ مسلم ۱۰۸۴)","Sahih","Musannaf Ibn Abi Shaybah 17221","","","كتاب النكاح"
"17222","(۱۷۲۲۲) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لِلْبِکْرِ سَبْعًا وَلِلثَّیِّبِ ثَلاَثًا۔ (دارمی ۲۲۰۹۔ مسلم ۱۰۸۴)","","Musannaf Ibn Abi Shaybah 17222","","","كتاب النكاح"
"17223","(۱۷۲۲۳) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إسحاق ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَنَسٍ ، عَنِ النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بمثلہ۔ (دارمی ۲۲۰۹)","","Musannaf Ibn Abi Shaybah 17223","","","كتاب النكاح"
"17224","(۱۷۲۲۴) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ عن سفیان ، عَنْ مُحَمَّدِ بْنِ أَبِی بَکْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ أُمِّ سَلَمَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا تَزَوَّجَ أُمَّ سَلَمَۃَ أَقَامَ عِنْدَہَا ثَلاَثًا وَقَالَ لَہَا : إنَّہُ لَیْسَ بِکِ عَلَی أَہْلِکِ ہَوَانٌ ، إِنْ شِئْتِ سَبَّعْتُ لَکِ ، وَإِنْ سَبَّعْتُ لَکِ سَبَّعْتُ لِنِسَائِی۔ (مسلم ۱۰۸۳۔ ابوداؤد ۲۱۱۵)","Sahih","Musannaf Ibn Abi Shaybah 17224","","","كتاب النكاح"
"17225","(۱۷۲۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : لَمَّا تَزَوَّجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُمَّ سَلَمَۃَ أَقَامَ عِنْدَہَا ثَلاَثًا وَقَالَ : إِنْ شِئْتِ سَبَّعْتُ لَکِ ، وَإِنْ سَبَّعْتُ لَکِ سَبَّعْتُ لِغَیْرِکِ ، قِیلَ لِلْحَکَمِ : مَنْ حَدَّثَک ہَذَا الْحَدِیثَ ؟ فَقَالَ : ہَذَا الْحَدِیثُ عِنْدَ أَہْلِ الْحِجَازِ مَعْرُوفٌ۔","","Musannaf Ibn Abi Shaybah 17225","","","كتاب النكاح"
"17226","(۱۷۲۲۶) حَدَّثَنَا عَبْدَۃ بن سلیمان ، عَنْ أَبِی سَعِیدٍ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ قَالاَ : إذَا تَزَوَّجَ الْبِکْرَ عَلَی امْرَأَتِہِ أَقَامَ عِنْدَہَا سَبْعًا وَإِذَا تَزَوَّجَ الثَّیِّبَ عَلَی امْرَأَتِہِ ، أَقَامَ عِنْدَہَا ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 17226","","","كتاب النكاح"
"17227","(۱۷۲۲۷) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسِ بْنِ مَالِکٍ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 17227","","","كتاب النكاح"
"17228","(۱۷۲۲۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : لِلْبِکْرِ ثَلاَثًا وَلِلثَّیِّبِ لَیلَتَین۔","","Musannaf Ibn Abi Shaybah 17228","","","كتاب النكاح"
"17229","(۱۷۲۲۹) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ یُقِیمُ عِنْدَ الْبِکْرِ ثَلاَثًا ولِلثَّیِّبِ لَیْلَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 17229","","","كتاب النكاح"
"17230","(۱۷۲۳۰) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : یُقِیمُ عِنْدَ الْبِکْرِ ثَلاَثًا وَیَقْسِمُ وَإِذَا تَزَوَّجَ الثَّیِّبَ أَقَامَ لَیْلَتَیْنِ ثُمَّ یَقْسِمُ۔","","Musannaf Ibn Abi Shaybah 17230","","","كتاب النكاح"
"17231","(۱۷۲۳۱) حدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ إبْرَاہِیمَ بَلَغَہُ قَالَ : الْبِکْرُ ثَلاَثًا وَالثَّیِّبُ لَیْلَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 17231","","","كتاب النكاح"
"17232","(۱۷۲۳۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَام ، عَنْ عِکْرِمَۃَ قَالَ : لِلْبِکْرِ سَبْعًا وَلِلثَّیِّبِ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 17232","","","كتاب النكاح"
"17233","(۱۷۲۳۳) حَدَّثَنَا أَبُو قَطَنٍ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ قَالاَ : ہُمَا سَوَائٌ فِی الْقَسْمِ۔","","Musannaf Ibn Abi Shaybah 17233","","","كتاب النكاح"
"17234","(۱۷۲۳۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ وَخِلاَسٍ قَالُوا : إذَا تَزَوَّجَ الْبِکْرَ عَلَی امْرَأَتِہِ أَقَامَ عنْدَہَا ثَلاَثًا ثُمَّ یَقْسِمُ ، وَإِذَا تَزَوَّجَ الثَّیِّبَ أَقَامَ لَیْلَتَیْنِ ثُمَّ یَقْسِمُ۔","","Musannaf Ibn Abi Shaybah 17234","","","كتاب النكاح"
"17235","(۱۷۲۳۵) حَدَّثَنَا یَزِیدُ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ قَالَ : مِنَ السُّنَّۃِ لِلْبِکْرِ سَبْعًا وَلِلثَّیِّبِ ثَلاَثًا ، قَالَ حُمَیْدٌ : وَقَالَ الْحَسَنُ : سَبْعًا وَلَیْلَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 17235","","","كتاب النكاح"
"17236","(۱۷۲۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ غَیْلاَنَ بْنِ جَامِعٍ ، عَنْ عَبْدِ الْمَلِکِ الزرَّاد ، عَنِ الشَّعْبِیِّ ، عَنْ قَمِیر ، عَنْ عَائِشَۃَ قَالَتْ : الْمُسْتَحَاضَۃُ لاَ یَأْتِیہَا زَوْجُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 17236","","","كتاب النكاح"
"17237","(۱۷۲۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَ[corrupt]َّہُ کَرِہَ أَنْ یُجَامِعَہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 17237","","","كتاب النكاح"
"17238","(۱۷۲۳۸) حَدَّثَنَا عَبْدُ الوَہَّاب الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَأْتِیَ الرَّجُلُ امْرَأَتَہُ وَہِیَ مُسْتَحَاضَۃٌ۔","","Musannaf Ibn Abi Shaybah 17238","","","كتاب النكاح"
"17239","(۱۷۲۳۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : لاَ یَغْشَاہَا وَلاَ تَصُومُ۔","","Musannaf Ibn Abi Shaybah 17239","","","كتاب النكاح"
"17240","(۱۷۲۴۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، قَالَ: قَالَ الشَّعْبِیُّ: لاَ تَصُومُ وَلاَ یَغْشَاہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 17240","","","كتاب النكاح"
"17241","(۱۷۲۴۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ قَالَ: قُلْتُ لِسُلَیْمَانَ بْنِ یَسَارٍ: یَأْتِیہَا زَوْجُہَا؟ قَالَ: مَا نَقُولُ فِیہِ إلاَّ مَا سَمِعْنَا۔","","Musannaf Ibn Abi Shaybah 17241","","","كتاب النكاح"
"17242","(۱۷۲۴۲) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عِکْرِمَۃَ قَالَ : الْمُسْتَحَاضَۃُ یَأْتِیہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 17242","","","كتاب النكاح"
"17243","(۱۷۲۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ قَالَ : بَلَغَنِی أَنَّ الْحَجَّاجَ قَالَ : إذَا شَکَّتْ فِی الْحَیْضِ اغْتَسَلَتْ وَصَلَّتْ وَلاَ یَقْرَبُہَا حَتَّی تَطْہُرَ ، فَقَالَ : بِئْسَ مَا قَالَ ، الصَّلاَۃُ أَعْظَمُ حُرْمَۃً۔","","Musannaf Ibn Abi Shaybah 17243","","","كتاب النكاح"
"17244","(۱۷۲۴۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ قَالَ : یَأْتِیہَا زَوْجُہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17244","","","كتاب النكاح"
"17245","(۱۷۲۴۵) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنْ عَطَائٍ قَالَ : یَأْتِیہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 17245","","","كتاب النكاح"
"17246","(۱۷۲۴۶) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ : یَغْشَاہَا زَوْجُہَا إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 17246","","","كتاب النكاح"
"17247","(۱۷۲۴۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ َشُعْبَۃَ ، عَنْ حَمَّادٍ فِی الْمُسْتَحَاضَۃِ : یَأْتِیہَا زَوْجُہَا وَتَصُومُ۔","","Musannaf Ibn Abi Shaybah 17247","","","كتاب النكاح"
"17248","(۱۷۲۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سفیان عن سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ فی المستحاضۃ قَالَ : یَأْتِیہَا ، الصَّلاَۃُ أَعْظَمُ حُرْمَۃً۔","","Musannaf Ibn Abi Shaybah 17248","","","كتاب النكاح"
"17249","(۱۷۲۴۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ سعید بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ فِی الْمُسْتَحَاضَۃِ : تَصُومُ وَتُصَلِّی وَتَقْضِی الْمَنَاسِکَ وَیَغْشَاہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 17249","","","كتاب النكاح"
"17250","(۱۷۲۵۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : الْمُسْتَحَاضَۃُ تَصُومُ وَتُصَلِّی وَیَأْتِیہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 17250","","","كتاب النكاح"
"17251","(۱۷۲۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرِ بْنِ مُوسَی ، عَنْ أَبِی جَعْفَرٍ قَالَ : الْمُسْتَحَاضَۃُ یَأْتِیہَا زَوْجُہَا۔","","Musannaf Ibn Abi Shaybah 17251","","","كتاب النكاح"
"17252","(۱۷۲۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : قَالَ شُرَیْحٌ : ہُوَ الزَّوْجُ یَعنِِْی {الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ}۔","","Musannaf Ibn Abi Shaybah 17252","","","كتاب النكاح"
"17253","(۱۷۲۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی مُلَیْکَۃَ ، قَالَ : قَالَ سَعِیدُ بْنُ جُبَیْرٍ : {الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} ہُوَ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17253","","","كتاب النكاح"
"17254","(۱۷۲۵۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قَالَ مُجَاہِدٌ : {الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} ہُوَ الزَّوْجُ ، {إلاَّ أَنْ یَعْفُونَ} ترد الْمَرْأَۃُ شَطْرَہَا {أَوْ یَعْفُوَا الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} إتْمَامُ الزَّوْجِ الصَّدَاقَ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 17254","","","كتاب النكاح"
"17255","(۱۷۲۵۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ شُرَیْحٍ ، وَعن إِسماعیل ، عَنِ الشَّعبی ، عَنْ شُرَیْحٍ وَجُوَیْبِرٌ ، عَنِ الضَّحَّاکِ قَالُوا : ہُوَ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17255","","","كتاب النكاح"
"17256","(۱۷۲۵۶) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ الْمُسَیَّبِ : {إلاَّ أَنْ یَعْفُونَ أَوْ یَعْفُوَا الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} قَالَ : الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ الزَّوْجُ ، إِنْ شَائَتْ أَنْ تَعْفُوَ ہِیَ فَلاَ تَأْخُذْ مِنْ صَدَاقِہَا شَیْئًا ، وَإِنْ شَائَ فَہُوَ بَیْنَہُمَا نِصْفَیْنِ۔","","Musannaf Ibn Abi Shaybah 17256","","","كتاب النكاح"
"17257","(۱۷۲۵۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَمرو أَنَّ نَافِعَ بْنَ جُبَیْرٍ طَلَّقَ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا فَأَتَمَّ لَہَا الصَّدَاقَ وَقَالَ : أَنَا أَحَقُّ بِالْعَفْوِ۔","","Musannaf Ibn Abi Shaybah 17257","","","كتاب النكاح"
"17258","(۱۷۲۵۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ أَفْلَحَ بن سَعِیدٍ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ کَعْبٍ یَقُولُ : {الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} ہُوَ الزَّوْجُ ، یُعْطِی مَا عِنْدَہُ عَفْوًا۔","","Musannaf Ibn Abi Shaybah 17258","","","كتاب النكاح"
"17259","(۱۷۲۵۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ قَالَ : {الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} الزَّوْجُ ، وَأَمَّا قَوْلُہُ : {إلاَّ أَنْ یَعْفُونَ أَوْ یَعْفُوَا الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} فَہِیَ الْمَرْأَۃُ یُطَلِّقُہَا زَوْجُہَا قَبْلَ أَنْ یَدْخُلَ بِہَا فَإِمَّا أَنْ تَعْفُوَ ، عَنِ النِّصْفِ لِزَوْجِہَا وَإِمَّا أَنْ یَعْفُوَ زَوْجُہَا فَیُکْمِلَ لَہَا الصَّدَاقَ۔","","Musannaf Ibn Abi Shaybah 17259","","","كتاب النكاح"
"17260","(۱۷۲۶۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ شُرَیْحٍ قَالَ : ہُوَ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17260","","","كتاب النكاح"
"17261","(۱۷۲۶۱) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الشَّعْبِیِّ قَالَ : ہُوَ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17261","","","كتاب النكاح"
"17262","(۱۷۲۶۲) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ طَاوُوسٍ ، وَمُجَاہِدٍ قَالاَ: {الَّذِیْ بِیَدِہٖ عُقْدَۃُ النِّکَاحِ} ہُوَ الْوَلِیُّ وَقَالَ سَعِیدُ بْنُ جُبَیْرٍ : ہُوَ الزَّوْجُ ، فَکَلَّمَاہُ فِی ذَلِکَ فَمَا بَرِحَا حَتَّی تَابَعَا سَعِیدًا۔","","Musannaf Ibn Abi Shaybah 17262","","","كتاب النكاح"
"17263","(۱۷۲۶۳) حَدَّثَنَا حُمَیْدٌ ، عَنِ الْحَسَنِ ، عَنْ سَالِمٍ ، عَنْ سَعِیدٍ قَالَ : ہُوَ الزَّوْجُ۔","Hasan","Musannaf Ibn Abi Shaybah 17263","","","كتاب النكاح"
"17264","(۱۷۲۶۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ، عَنْ عَمَّارِ بْنِ أَبِی عَمَّارٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : {الَّذِیْ بِیَدِہٖ عُقْدَۃُ النِّکَاحِ} الزَّوْجُ۔","Da'if","Musannaf Ibn Abi Shaybah 17264","","","كتاب النكاح"
"17265","(۱۷۲۶۵) حَدَّثَنَا ابْنُ الدَّرَاوَرْدِیِّ ، عَنْ عُمَرَ مَوْلَی غُفْرَۃَ أَنَّ مُحَمَّدَ بْنَ کَعْبٍ کَانَ یَقُولُ : {الَّذِیْ بِیَدِہٖ عُقْدَۃُ النِّکَاحِ} الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17265","","","كتاب النكاح"
"17266","(۱۷۲۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ وَوَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عِیسَی بْنِ عاصم ، عَنْ عَلِیٍّ قَالَ : الزَّوْجُ۔n(بیہقی ۲۵۱۔ طبری ۲۳۷)","","Musannaf Ibn Abi Shaybah 17266","","","كتاب النكاح"
"17267","(۱۷۲۶۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ شُرَیْحٍ قَالَ : ہُوَ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17267","","","كتاب النكاح"
"17268","(۱۷۲۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ قَالَ : ہُوَ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17268","","","كتاب النكاح"
"17269","(۱۷۲۶۹) حَدَّثَنَا مَرْوَانُ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ قَالَ : ہُوَ الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17269","","","كتاب النكاح"
"17270","(۱۷۲۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ: {إلاَّ أَنْ یَعْفُونَ أَوْ یَعْفُوَا الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} قَالَ : الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17270","","","كتاب النكاح"
"17271","(۱۷۲۷۱) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ خُصَیْفٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، وَمُجَاہِدٍ قَالاَ : {الَّذِیْ بِیَدِہٖ عُقْدَۃُ النِّکَاحِ} الزَّوْجُ۔","","Musannaf Ibn Abi Shaybah 17271","","","كتاب النكاح"
"17272","(۱۷۲۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : ہُوَ الْوَلِیُّ۔","","Musannaf Ibn Abi Shaybah 17272","","","كتاب النكاح"
"17273","(۱۷۲۷۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی رَجَائٍ قَالَ: سُئِلَ الْحَسَنُ ، عَنِ {الَّذِیْ بِیَدِہٖ عُقْدَۃُ النِّکَاحِ} قَالَ: ہُوَ الْوَلِیُّ۔","","Musannaf Ibn Abi Shaybah 17273","","","كتاب النكاح"
"17274","(۱۷۲۷۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ قَالَ : ہُوَ الْوَلِیُّ۔","","Musannaf Ibn Abi Shaybah 17274","","","كتاب النكاح"
"17275","(۱۷۲۷۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنْ عِکْرِمَۃَ قَالَ ہُوَ الْوَلِیُّ۔","","Musannaf Ibn Abi Shaybah 17275","","","كتاب النكاح"
"17276","(۱۷۲۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ ہُوَ الْوَلِیُّ۔","","Musannaf Ibn Abi Shaybah 17276","","","كتاب النكاح"
"17277","(۱۷۲۷۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ الأَبُ۔","","Musannaf Ibn Abi Shaybah 17277","","","كتاب النكاح"
"17278","(۱۷۲۷۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : ہُوَ الْوَلِیُّ۔","","Musannaf Ibn Abi Shaybah 17278","","","كتاب النكاح"
"17279","(۱۷۲۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ الزُّہْرِیِّ {إلاَّ أَنْ یَعْفُونَ} قَالَ : الثَّیِّبَاتُ {أَوْ یَعْفُوَا الَّذِی بِیَدِہِ عُقْدَۃُ النِّکَاحِ} وَلِیُّ الْبِکْرِ۔","","Musannaf Ibn Abi Shaybah 17279","","","كتاب النكاح"
"17280","(۱۷۲۸۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : رَضِیَ اللَّہُ بِالْعَفْوِ وَأَمَرَ بِہِ فَإِنْ عَفَتْ عَفَتْ ، وَإِنْ أَبَتْ وَعَفَا وَلِیُّہَا جَازَ ، وَإِنْ أَبَتْ۔","","Musannaf Ibn Abi Shaybah 17280","","","كتاب النكاح"
"17281","(۱۷۲۸۱) حَدَّثَنَا زِیَادُ بْنُ الرَّبِیعِ ، عَنْ صَالِحٍ الدَّہَّانِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ} قَالَ : الْکَفُّ وَرُقْعَۃُ الْوَجْہِ۔","Hasan","Musannaf Ibn Abi Shaybah 17281","","","كتاب النكاح"
"17282","(۱۷۲۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ مَا ظَہَرَ مِنْہَا} قَالَ : الثِّیَابُ۔","Sahih","Musannaf Ibn Abi Shaybah 17282","","","كتاب النكاح"
"17283","(۱۷۲۸۳) حَدَّثَنَا حَفْصٌ ، عَنْ عِمرَان بْنِ سُلَیْمَانَ ، عَنْ أَبِی صَالِحٍ ، وَعِکْرِمَۃَ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ} قَالاَ : الْکُحْلُ وَالْخَاتَمُ وَالثِّیَابُ۔","","Musannaf Ibn Abi Shaybah 17283","","","كتاب النكاح"
"17284","(۱۷۲۸۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ {وَلاَ یُبْدِینَ زِینَتَہُنَّ} قَالَ : مَا فَوْقَ الدِّرْعِ إلاَّ مَا ظَہَرَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 17284","","","كتاب النكاح"
"17285","(۱۷۲۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلْقَمَۃَ بْنِ مَرْثَدٍ ، عَنْ إبْرَاہِیمَ قَالَ : الثِّیَابُ۔","","Musannaf Ibn Abi Shaybah 17285","","","كتاب النكاح"
"17286","(۱۷۲۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ قَالَ ، الْکُحْلُ وَالثِّیَابُ۔","","Musannaf Ibn Abi Shaybah 17286","","","كتاب النكاح"
"17287","(۱۷۲۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أُمِّ شَبِیبٍ ، عَنْ عَائِشَۃَ قَالَتْ : الْقُلْبُ وَالْفَتْخَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 17287","","","كتاب النكاح"
"17288","(۱۷۲۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ مَاہَانَ : إلاَّ مَا ظَہَرَ مِنْہَا ، قَالَ : الثِّیَابُ۔","","Musannaf Ibn Abi Shaybah 17288","","","كتاب النكاح"
"17289","(۱۷۲۸۹) حَدَّثَنَا مُعْتَمر ، عَنْ یُونُسَ ، عَنِ ابْنِ شِہَابٍ ، عَنِ الْحَسَنِ قَالَ : الْوَجْہُ وَالثِّیَابُ۔","","Musannaf Ibn Abi Shaybah 17289","","","كتاب النكاح"
"17290","(۱۷۲۹۰) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ قَالَ : حدَّثَنَا ہِشَامُ بْنُ الْغَازِ قَالَ : حدَّثَنَا نَافِعٌ عن ابْنِ عُمَرَ قَالَ : الزِّینَۃُ الظَّاہِرَۃُ: الْوَجْہُ وَالْکَفَّانِ۔","Sahih","Musannaf Ibn Abi Shaybah 17290","","","كتاب النكاح"
"17291","(۱۷۲۹۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ قَالَ : حدَّثَنَا ہِشَامُ بْنُ الْغَازِ ، قَالَ : سَمِعْتُ عَطَائً یَقُولُ : الزِّینَۃُ الظَّاہِرَۃُ : الْخِضَابُ وَالْکُحْلُ۔","","Musannaf Ibn Abi Shaybah 17291","","","كتاب النكاح"
"17292","(۱۷۲۹۲) حَدَّثَنَا شَبَابَۃُ ، عَنْ ہِشَامٍ ، قَالَ : سَمِعْتُ مَکْحُولاً یَقُولُ : الزِّینَۃُ الظَّاہِرَۃُ : الْوَجْہُ وَالْکَفَّانِ۔","","Musannaf Ibn Abi Shaybah 17292","","","كتاب النكاح"
"17293","(۱۷۲۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ قَالَ : الثِّیَابُ۔","","Musannaf Ibn Abi Shaybah 17293","","","كتاب النكاح"
"17294","(۱۷۲۹۴) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ قَالَ : حدَّثَنَا عَطَائُ بْنُ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ مَا ظَہَرَ مِنْہَا} الْخَاتَمُ وَالْخِضَابُ وَالْکُحْلُ۔","","Musannaf Ibn Abi Shaybah 17294","","","كتاب النكاح"
"17295","(۱۷۲۹۵) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا سَعِیدُ بْنُ زَیْدٍ قَالَ : حدَّثَنَا لَیْثٌ ، عَنْ مُجَاہِدٍ قَالَ : الْخِضَابُ وَالْکُحْلُ۔","","Musannaf Ibn Abi Shaybah 17295","","","كتاب النكاح"
"17296","(۱۷۲۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ قَالَ: الزِّینَۃُ زِینَتَانِ : زِینَۃٌ ظَاہِرَۃٌ وَزِینَۃٌ بَاطِنَۃٌ لاَ یَرَاہَا إلاَّ الزَّوْجُ ، وَأَمَّا الزِّینَۃُ الظَّاہِرَۃُ فَالثِّیَابُ ، وَأَمَّا الزِّینَۃُ الْبَاطِنَۃُ فَالْکُحْلُ وَالسِّوَارُ وَالْخَاتَمُ۔","","Musannaf Ibn Abi Shaybah 17296","","","كتاب النكاح"
"17297","(۱۷۲۹۷) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ مَا ظَہَرَ مِنْہَا} قَالَ : وَجْہُہَا وَکَفُّہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17297","","","كتاب النكاح"
"17298","(۱۷۲۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلم ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : کَفُّہَا وَوَجْہُہَا۔","","Musannaf Ibn Abi Shaybah 17298","","","كتاب النكاح"
"17299","(۱۷۲۹۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سَلَمَۃُ بْنُ سَابُورَ ، عَنْ عَبْدِ الْوَارِثِ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ مَا ظَہَرَ مِنْہَا} قَالَ : الْکَفُّ وَالْخَاتَمُ۔","","Musannaf Ibn Abi Shaybah 17299","","","كتاب النكاح"
"17300","(۱۷۳۰۰) حَدَّثَنَا أَحْمَدُ بْنُ بَشِیرٍ ، عَنِ ابْنِ شُبْرُمَۃَ ، عَنْ عِکْرِمَۃَ قَالَ : {مَا ظَہَرَ مِنْہَا} قَالَ : الْوَجْہُ وَثُغْرَۃُ النَّحْرِ۔","","Musannaf Ibn Abi Shaybah 17300","","","كتاب النكاح"
"17301","(۱۷۳۰۱) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْخَلِیلِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ أُمِّ الْفَضْلِ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُحَرِّمُ الرَّضْعَۃُ وَالرَّضْعَتَانِ وَالْمَصَّۃُ وَالْمَصَّتَانِ۔n(مسلم ۱۸۔ احمد ۶/۳۳۹)","Sahih","Musannaf Ibn Abi Shaybah 17301","","","كتاب النكاح"
"17302","(۱۷۳۰۲) حَدَّثَنَا عَبْدَۃُ ، وَابْنُ نُمَیْرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ الزُّبَیْرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تُحَرِّمُ الْمَصَّۃُ وَالْمَصَّتَانِ۔ (ابن حبان ۴۲۲۵۔ احمد ۴/۴)","Sahih","Musannaf Ibn Abi Shaybah 17302","","","كتاب النكاح"
"17303","(۱۷۳۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ أَبِیہِ ، عَنْ مَسْرُوقٍ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّمَا الرَّضَاعَۃُ مِنَ الْمَجَاعَۃِ۔ (بخاری ۵۱۰۲۔ مسلم ۳۲)","Sahih","Musannaf Ibn Abi Shaybah 17303","","","كتاب النكاح"
"17304","(۱۷۳۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ قَالَ : لاَ تُحَرِّمُ الغبقۃ وَلاَ الْغَبْقَتَانِ۔n(بیہقی ۴۵۷)","Sahih","Musannaf Ibn Abi Shaybah 17304","","","كتاب النكاح"
"17305","(۱۷۳۰۵) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ قَالَ : سَأَلْتُ ابْنَ الزُّبَیْرِ ، عَنِ الرَّضَاعِ ، فَقَالَ : لاَ تُحَرِّمُ الرَّضْعَۃُ وَلاَ الرَّضْعَتَانِ وَلاَ الثَّلاَثُ۔","","Musannaf Ibn Abi Shaybah 17305","","","كتاب النكاح"
"17306","(۱۷۳۰۶) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ حَنْظَلَۃَ ، عَنْ سَالِمٍ ، عَنْ زَیْدٍ قَالَ : لاَ تُحَرِّمُ الرَّضْعَۃُ وَلاَ الرَّضْعَتَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 17306","","","كتاب النكاح"
"17307","(۱۷۳۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرِ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ قَالَ : یُحَرِّمُ مِنْہُ مَا فَتَقَ الأَمْعَائَ۔","","Musannaf Ibn Abi Shaybah 17307","","","كتاب النكاح"
"17308","(۱۷۳۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : إنَّمَا یُحَرِّمُ مِنَ الرَّضَاعِ مَا أَنْبَتَ اللَّحْمَ وَأَنْشَزَ الْعَظْمَ۔","Sahih","Musannaf Ibn Abi Shaybah 17308","","","كتاب النكاح"
"17309","(۱۷۳۰۹) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ، قَالَ: قَالَ أَبُو مُوسَی: لاَ یُحَرِّمُ الرَّضَاعُ إلاَّ مَا أَنْبَتَ اللَّحْمَ وَالدَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 17309","","","كتاب النكاح"
"17310","(۱۷۳۱۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ قَالَ : کَانَتْ عَائِشَۃُ إذَا أَرَادَتْ أَنْ یَدْخُلَ عَلَیْہَا أَحَدٌ أَمَرَتْ بِہِ فَأُرْضِعَ فَأَمَرَتْ أُمَّ کُلْثُومٍ أَنْ تُرْضِعَ سَالِمًا عَشْرَ رَضَعَاتٍ فَأَرْضَعَتْہُ ثَلاَثًا فَمَرِضَتْ ، فَکَانَ لاَ یَدْخُلُ عَلَیْہَا وَأَمَرَتْ فَاطِمَۃَ بِنْتَ عُمَرَ أَنْ تُرْضِعَ عَاصِمَ بْنَ سَعْدٍ مَوْلًی لَہُمْ عَشْرَ رَضَعَاتٍ ، فَأَرْضَعَتْہُ فَکَانَ یَدْخُلُ عَلَیْہَا۔ (عبدالرزاق ۱۳۹۲۹)","Sahih","Musannaf Ibn Abi Shaybah 17310","","","كتاب النكاح"
"17311","(۱۷۳۱۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ قَالَ : کَتَبْتُ إلَی إبْرَاہِیمَ أَسْأَلُہُ ، عَنِ الرَّضَاعِ فَکَتَبَ إلَیَّ أَنَّ عَلِیًّا ، وَعَبْدَ اللہِ کَانَا یَقُولاَنِ : قَلِیلُہُ وَکَثِیرُہُ حَرَامٌ۔","","Musannaf Ibn Abi Shaybah 17311","","","كتاب النكاح"
"17312","(۱۷۳۱۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ ابْنُ مَسْعُودٍ : یُحَرِّمُ قَلِیلُ الرَّضَاعِ کَمَا یُحَرِّمُ کَثِیرُہُ ، وَقَالَ مُجَاہِدٌ : قَوْلُ ابْنِ مَسْعُودٍ أَحَبُّ إلَیَّ۔","Da'if","Musannaf Ibn Abi Shaybah 17312","","","كتاب النكاح"
"17313","(۱۷۳۱۳) حَدَّثَنَا وَکِیعٌ عن سفیان ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ وسُئِلَ عَنِ المرأۃ تُرْضِعُ الصَّبِیَّ الرَّضْعَۃَ ، فَقَالَ : إذَا عقا الصَّبِیُّ حَرُمَتْ عَلَیْہِ ، وَمَا وَلَدَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 17313","","","كتاب النكاح"
"17314","(۱۷۳۱۴) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ قَالَ : اشْتَرَطَ عَشْرَ رَضَعَاتٍ ثُمَّ قِیلَ : إنَّ الرَّضْعَۃَ الْوَاحِدَۃَ تُحَرِّمُ۔","","Musannaf Ibn Abi Shaybah 17314","","","كتاب النكاح"
"17315","(۱۷۳۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ قَالَ : الْحَکَمُ وَحَمَّادٌ قَالاَ : الْمَصَّۃُ تُحَرِّمُ۔","","Musannaf Ibn Abi Shaybah 17315","","","كتاب النكاح"
"17316","(۱۷۳۱۶) حَدَّثَنَا أَبُو خَالِدٍ الأحمر ، عَنْ حَجَّاجٍ ، عَنْ حَبِیبٍ ، عَنْ طَاوُوسٍ قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ ، فَقَالَ : الْمَرَّۃُ الْوَاحِدَۃُ تُحَرِّمُ۔","","Musannaf Ibn Abi Shaybah 17316","","","كتاب النكاح"
"17317","(۱۷۳۱۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ قَالَ : سَأَلْتُ ابن عمر ، فَقَالَ الْمَصَّۃُ الْوَاحِدَۃُ تُحَرِّمُ۔","","Musannaf Ibn Abi Shaybah 17317","","","كتاب النكاح"
"17318","(۱۷۳۱۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ [corrupt]َٔبِیہِ وَعن حُمَیْدٍ الأَعْرَجِ ، عَنْ مُجَاہِدٍ وعَمَّنْ سَمِعَ عَطَائً ، قَالَ زَمْعَۃُ : وَسَمِعْتُ عَمْرَو بْنَ دِینَارٍ یَقُولُ : قَالُوا : یُحَرِّمُ قَلِیلُ الرَّضَاعِ وَکَثِیرُہُ۔","","Musannaf Ibn Abi Shaybah 17318","","","كتاب النكاح"
"17319","(۱۷۳۱۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أُرِیدَ عَلَی ابْنَۃِ حَمْزَۃَ بْنِ عَبْدِ الْمُطَّلِبِ ، فَقَالَ : إنَّہَا ابْنَۃُ أَخِی مِنَ الرَّضَاعَۃِ وَإِنَّہُ یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔ (بخاری ۲۶۴۵۔ مسلم ۱۳ )","Sahih","Musannaf Ibn Abi Shaybah 17319","","","كتاب النكاح"
"17320","(۱۷۳۲۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ قَالَ : قُلْتُ : یَا رَسُولَ اللہِ مَا لَکَ تَنوَّقُ فِی قُرَیْشٍ وَتَدَعُنَا قَالَ : عِنْدَکُمْ شَیْئٌ ؟ قُلْتُ : نَعَمْ ، ابنْۃ حَمْزَۃَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّہَا لاَ تَحِلُّ لِی ، إنَّہَا بِنْتُ أَخِی مِنَ الرَّضَاعَۃِ۔ (مسلم ۱۱۔ احمد ۱/۸۲)","Sahih","Musannaf Ibn Abi Shaybah 17320","","","كتاب النكاح"
"17321","(۱۷۳۲۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : أَتَانِی عَمِّی مِنَ الرَّضَاعَۃِ أَفْلَحُ بن أَبِی الْقُعَیْسِ یَسْتَأْذِنُ عَلَیَّ بَعْدَ مَا ضُرِبَ الْحِجَابُ فَأَبَیْتُ أَنْ آذَنَ لَہُ حَتَّی دَخَلَ عَلَیَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّہُ عَمُّک فَأْذَنِی لَہُ قالت : إنَّمَا أَرْضَعْتنِی الْمَرْأَۃُ وَلَمْ یُرْضِعْنِی الرَّجُلُ قَالَ : تَرِبَتْ یَدَاک، أَوْ یَمِینُک۔ (مسلم ۱۰۶۹۔ ابن ماجہ ۱۹۴۸)","Sahih","Musannaf Ibn Abi Shaybah 17321","","","كتاب النكاح"
"17322","(۱۷۳۲۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ زَیْنَبَ بِنْتِ أُمِّ سَلَمَۃَ ، عَنْ أُمِّ سَلَمَۃَ أن أُمَّ حَبِیبَۃَ قَالَتْ : یَا رَسُولَ اللہِ ، ہَلْ لَکَ فِی أُخْتِی ابْنَۃِ أَبِی سُفْیَانَ ؟ قَالَ : إنَّہَا لاَ تَحِلُّ لِی قَالَتْ : فَإِنَّہُ قَدْ بَلَغَنِی أَنَّک تَخْطُبُ دُرَّۃَ بِنْتَ أَبِی سَلَمَۃَ قَالَ : بِنْتُ أَبِی سَلَمَۃَ ؟ قَالَتْ : نَعَمْ ، قَالَ : وَاللَّہِ إِنْ لَمْ تَکُنْ رَبِیبَتِی فِی حِجْرِی مَا حَلَّتْ لِی ، إنَّہَا ابْنَۃُ أَخِی مِنَ الرَّضَاعَۃِ ، أَرْضَعَتْنِی وَأَبَاہَا ثُوَیْبَۃُ فَلاَ تَعْرِضْنَ عَلَیَّ بَنَاتِکُنَّ وَلاَ أَخَوَاتِکُنَّ۔n(بخاری ۵۱۰۶۔ مسلم ۱۰۷۲)","","Musannaf Ibn Abi Shaybah 17322","","","كتاب النكاح"
"17323","(۱۷۳۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ قَالَ : کَانَتْ عَائِشَۃُ تُحَرِّمُ مِنَ الرَّضَاعَۃِ مَا تُحَرِّمُ مِنَ الْوِلاَدَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 17323","","","كتاب النكاح"
"17324","(۱۷۳۲۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مُوسَی بْنِ أَیُّوبَ قَالَ : حدَّثَنِی عَمِّی إیَاسُ بْنُ عَامِرٍ ، قَالَ : قَالَ عَلِیٌّ : لاَ تَنْکِحْ مَنْ أَرْضَعَتْہُ امْرَأَۃُ أَخِیک وَلاَ امْرَأَۃُ أَبِیک وَلاَ امْرَأَۃُ ابْنِک۔","Hasan","Musannaf Ibn Abi Shaybah 17324","","","كتاب النكاح"
"17325","(۱۷۳۲۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔","Da'if","Musannaf Ibn Abi Shaybah 17325","","","كتاب النكاح"
"17326","(۱۷۳۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ دَاوُدَ، عَنْ أَبِی مَعْشَرٍ، عَنْ إبْرَاہِیمَ قَالَ: یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔","","Musannaf Ibn Abi Shaybah 17326","","","كتاب النكاح"
"17327","(۱۷۳۲۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ قَالَ : أُرَاہُ ، عَنْ عَبْدِ اللہِ قَالَ : یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 17327","","","كتاب النكاح"
"17328","(۱۷۳۲۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عِرَاکِ بْنِ مَالِکٍ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔ (مسلم ۹۔ ابن ماجہ ۱۹۳۷)","Hasan","Musannaf Ibn Abi Shaybah 17328","","","كتاب النكاح"
"17329","(۱۷۳۲۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ إِبْرَاہِیمَ بن عَبْدِ الأَعْلَی ، قَالَ : سَمِعْتُ سُوَیْد بْنَ غَفَلَۃَ یَقُولُ : یَحْرُمُ مِنَ الرَّضَاعَۃِ مَا یَحْرُمُ مِنَ النَّسَبِ۔","","Musannaf Ibn Abi Shaybah 17329","","","كتاب النكاح"
"17330","(۱۷۳۳۰) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ أَنَّہُ قِیلَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَلْ لَکَ فِی بِنْتِ حَمْزَۃَ ؟ فَقَالَ : إنَّہَا لاَ تَحِلُّ لِی ، إنَّہَا ابْنَۃُ أَخِی مِنَ الرَّضَاعَۃِ۔ (بخاری ۴۲۵۱)","Sahih","Musannaf Ibn Abi Shaybah 17330","","","كتاب النكاح"
"17331","(۱۷۳۳۱) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی الضُّحَی ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الْحَوْلَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 17331","","","كتاب النكاح"
"17332","(۱۷۳۳۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ قَالَ عَبْدُ اللہِ لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الْحَوْلَیْنِ۔","","Musannaf Ibn Abi Shaybah 17332","","","كتاب النكاح"
"17333","(۱۷۳۳۳) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ زُبَیْدٍ قَالَ قَالَ عَلِیٌّ : لاَ یُحَرِّمُ مِنَ الرَّضَاعِ إلاَّ مَا کَانَ فِی الْحَوْلَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 17333","","","كتاب النكاح"
"17334","(۱۷۳۳۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الْحَوْلَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 17334","","","كتاب النكاح"
"17335","(۱۷۳۳۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ رَضَاعَ بَعْدَ الْفِصَالِ۔","Sahih","Musannaf Ibn Abi Shaybah 17335","","","كتاب النكاح"
"17336","(۱۷۳۳۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ، عَنِ ابْنِ عُمَرَ، عَنْ عُمَرَ، قَالَ لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الصِّغَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 17336","","","كتاب النكاح"
"17337","(۱۷۳۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ عُمَرُ : لاَ رَضَاعَ بَعْدَ الْفِصَالِ۔","Hasan","Musannaf Ibn Abi Shaybah 17337","","","كتاب النكاح"
"17338","(۱۷۳۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَنَابٍ ، عَنْ إسْمَاعِیلَ بْنِ رَجَائٍ ، عَنِ النَّزَّالِ بْنِ سَبْرَۃَ ، عَنْ عَلِیٍّ قَالَ : لاَ رَضَاعَ بَعْدَ الْفِصَالِ۔","Da'if","Musannaf Ibn Abi Shaybah 17338","","","كتاب النكاح"
"17339","(۱۷۳۳۹) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ یَحْیَی بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ ، عَنْ جَدِّہِ أَنَّہُ سَأَلَ أُمَّ سَلَمَۃَ ، عَنِ الرَّضَاعِ ، فَقَالَتْ : لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الْمَہْدِ قَبْلَ الْفِطَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 17339","","","كتاب النكاح"
"17340","(۱۷۳۴۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ أَنَّ أَبَا ہُرَیْرَۃَ سُئِلَ عَنِ الرَّضَاعِ ، فَقَالَ : لاَ یُحَرِّمُ مِنَ الرَّضَاعِ إلاَّ مَا فَتَقَ الأَمْعَائَ ، وَکَانَ فِی الثَّدْیِ قَبْلَ الْفِطَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 17340","","","كتاب النكاح"
"17341","(۱۷۳۴۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ حَجَّاج بْنِ حَجَّاج ، عَنْ أَبِی ہُرَیْرَۃَ بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 17341","","","كتاب النكاح"
"17342","(۱۷۳۴۲) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ : حدَّثَنَا ہِشَامُ بْنُ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ حَجَّاج بْنِ حَجَّاج ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ بِمِثْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 17342","","","كتاب النكاح"
"17343","(۱۷۳۴۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، وَأَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ أَنَّ عَلْقَمَۃَ مَرَّ بِامْرَأَۃٍ وَہِیَ تُرْضِعُ صَبِیًّا لَہَا بَعْدَ الْحَوْلَیْنِ ، فَقَالَ : لاَ تسقیہ داء ک۔","","Musannaf Ibn Abi Shaybah 17343","","","كتاب النكاح"
"17344","(۱۷۳۴۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ قَالَ : إذَا فُطِمَ الصَّبِیُّ فَلاَ رَضَاعَ بَعْدَ الْفِطَامِ۔","","Musannaf Ibn Abi Shaybah 17344","","","كتاب النكاح"
"17345","(۱۷۳۴۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ یُحَرِّمُ مِنَ الرَّضَاعِ إلاَّ مَا کَانَ فِی الصِّغَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 17345","","","كتاب النكاح"
"17346","(۱۷۳۴۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لاَ رَضَاعَ إلاَّ مَا کَانَ فِی الْمَہْدِ ، وَإِلاَّ مَا أَنْبَتَ اللَّحْمَ وَالدَّمَ۔","","Musannaf Ibn Abi Shaybah 17346","","","كتاب النكاح"
"17347","(۱۷۳۴۷) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : مَا کَانَ مِنْ رضاع ، أَوْ سَعُوطٍ فِی السَّنَتَیْنِ فَہُوَ رَضَاعٌ ، وَمَا کَانَ بَعْدُ فَلَیْسَ بِرَضَاعٍ۔","","Musannaf Ibn Abi Shaybah 17347","","","كتاب النكاح"
"17348","(۱۷۳۴۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنِ عَبْدِ اللہِ وَحَسَنٍ ابْنَی مُحَمَّدٍ ، عَنْ أَبِیہِمَا أَنَّ عَلِیًّا قَالَ لابْنِ عَبَّاسٍ : أَمَا عَلِمْتَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی ، عَنِ الْمُتْعَۃِ وَعَنْ لُحُومِ الْحُمُرِ الأَہْلِیَّۃِ ؟۔n(بخاری ۴۲۱۶۔ مسلم ۲۹)","Sahih","Musannaf Ibn Abi Shaybah 17348","","","كتاب النكاح"
"17349","(۱۷۳۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنِ الرَّبِیعِ بْنِ سَبْرَۃَ الْجُہَنِیِّ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی یَوْمَ الْفَتْحِ ، عَنْ مُتْعَۃِ النِّسَائِ۔ (مسلم ۲۶۔ ابوداؤد ۲۰۶۶)","Sahih","Musannaf Ibn Abi Shaybah 17349","","","كتاب النكاح"
"17350","(۱۷۳۵۰) حَدَّثَنَا عَبْدَۃُ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، عَنِ الرَّبِیعِ بْنِ سَبْرَۃَ ، عَنْ أَبِیہِ قَالَ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَائِمًا بَیْنَ الرُّکْنِ وَالْبَابِ وَہُوَ یَقُولُ : أَیُّہَا النَّاسُ ، إنِّی کُنْتُ قد أَذِنْتُ لَکُمْ فِی الاِسْتِمْتَاعِ، أَلاَ وَإِنَّ اللَّہَ حَرَّمَہَا إلَی یَوْمِ الْقِیَامَۃِ فَمَنْ کَانَ عِنْدَہُ مِنْہُنَّ شَیْئٌ فَلْیُخَلِّ سَبِیلَہُ وَلاَ تَأْخُذُوا مِمَّا آتَیْتُمُوہُنَّ شَیْئًا۔n(مسلم ۲۵۔ ابن ماجہ ۱۹۶۲)","Sahih","Musannaf Ibn Abi Shaybah 17350","","","كتاب النكاح"
"17351","(۱۷۳۵۱) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ زِیَادٍ قَالَ : حدَّثَنَا أَبُو الْعُمَیْسِ ، عَنْ إیَاسِ بْنِ سَلَمَۃَ ، عَنْ أَبِیہِ قَالَ : رَخَّصَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَامَ أَوْطَاسٍ فِی الْمُتْعَۃِ ثَلاَثًا ثُمَّ نَہَی عَنْہَا۔n(مسلم ۱۸۔ احمد ۴/۵۵)","Sahih","Musannaf Ibn Abi Shaybah 17351","","","كتاب النكاح"
"17352","(۱۷۳۵۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ عُمَرُ : لَوْ تَقَدَّمْتُ فِیہَا لَرَجَمْتُ یَعْنِی الْمُتْعَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 17352","","","كتاب النكاح"
"17353","(۱۷۳۵۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : نَہَی عُمَرَ ، عَنْ مُتْعَتَیْنِ مُتْعَۃِ النِّسَائِ وَمُتْعَۃِ الْحَجِّ۔","Sahih","Musannaf Ibn Abi Shaybah 17353","","","كتاب النكاح"
"17354","(۱۷۳۵۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ قَالَ : سُئِلَ عَنْ مُتْعَۃِ النِّسَائِ ، فَقَالَ : لاَ نَعْلَمُہَا إلاَّ السِّفَاحَ۔","Sahih","Musannaf Ibn Abi Shaybah 17354","","","كتاب النكاح"
"17355","(۱۷۳۵۵) حَدَّثَنَا عَبدَۃ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ سُئِلَ عَنِ الْمُتْعَۃِ ، فَقَالَ : حرَامٌ فَقِیلَ لَہُ : إنَّ ابْنَ عَبَّاسٍ یُفْتِی بِہَا ، فَقَالَ : فَہَلاَّ تَزَمْزَمَ بِہَا فِی زَمَانِ عُمَرَ۔","Sahih","Musannaf Ibn Abi Shaybah 17355","","","كتاب النكاح"
"17356","(۱۷۳۵۶) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّہُ قَالَ : رَحِمَ اللَّہُ عُمَرَ ، لَوْلاَ إِنَّہُ نَہَی ، عَنِ الْمُتْعَۃِ صَارَ الزِّنَا جِہَارًا۔","Sahih","Musannaf Ibn Abi Shaybah 17356","","","كتاب النكاح"
"17357","(۱۷۳۵۷) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : وَاللَّہِ مَا کَانَتِ الْمُتْعَۃُ إلاَّ ثَلاَثَۃَ أَیَّامٍ أَذِنَ لَہُمْ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیہَا ، مَا کَانَتْ قَبْلَ ذَلِکَ وَلاَ بَعْدُ۔ (عبدالرزاق ۱۴۰۴۰)","Hasan","Musannaf Ibn Abi Shaybah 17357","","","كتاب النكاح"
"17358","(۱۷۳۵۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حَدَّثَنِی عَبْدُ اللہِ بْنُ الْوَلِیدِ ، قَالَ : قَالَ لِی ابْنُ ذُؤَیبٍ : سَمِعْتُ ابْنَ الزُّبَیْرِ یَخْطُبُ وَہُوَ یَقُولُ : إنَّ الذِّئْبَ یُکَنَّی أَبَا جَعْدَۃَ ، أَلاَ وَإِنَّ الْمُتْعَۃَ ہِیَ الزِّنَا۔","Da'if","Musannaf Ibn Abi Shaybah 17358","","","كتاب النكاح"
"17359","(۱۷۳۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُمَرَ ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ ، عَنِ طَاوُوسٍ قَالَ : کَانَتْ سُنَّۃُ الْمُتْعَۃِ سُنَّۃَ النِّکَاحِ إلاَّ أَنَّ الأَجَلَ کَانَ فِی أَیْدِیہِنَّ۔","","Musannaf Ibn Abi Shaybah 17359","","","كتاب النكاح"
"17360","(۱۷۳۶۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : لَوْ أُتِیتُ بِرَجُلٍ تَمَتَّعَ بِامْرَأَۃٍ لَرَجَمْتُہُ إِنْ کَانَ أُحْصِنَ فَإِنْ کَانَ لَمْ یَکُنْ أُحْصِنَ ضَرَبْتُہُ۔","","Musannaf Ibn Abi Shaybah 17360","","","كتاب النكاح"
"17361","(۱۷۳۶۱) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ ہِشَامِ بْنِ الْغَازِ ، قَالَ : سَمِعْتُ مَکْحُولاً یَقُولُ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ إلَی أَجَلٍ قَالَ : ذَلِکَ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17361","","","كتاب النكاح"
"17362","(۱۷۳۶۲) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ قَیْسٍ ، عَنْ عَبْدِ اللہِ قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ شَبَابٌ قَالَ فَقُلْنَا : یَا رَسُولَ اللہِ ، أَلاَ نَسْتَخْصِی ؟ قَالَ : لاَ ثُمَّ رَخَّصَ لَنَا أَنْ نَنْکِحَ الْمَرْأَۃَ بِالثَّوْبِ إلَی الأَجَلِ ثُمَّ قَرَأَ عَبْدُ اللہِ : {یَا أَیُّہَا الَّذِینَ آمَنُوا لاَ تُحَرِّمُوا طَیِّبَاتِ مَا أَحَلَّ اللَّہُ لَکُمْ}۔","Sahih","Musannaf Ibn Abi Shaybah 17362","","","كتاب النكاح"
"17363","(۱۷۳۶۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ قَبِیصَۃَ بْنِ جَابِرٍ ، عَنْ عُمَرَ ، قَالَ : لاَ أُوتَی بِمُحِلٍّ وَلاَ مُحَلَّلٍ لَہُ إلاَّ رَجَمْتُہُمَا۔","Sahih","Musannaf Ibn Abi Shaybah 17363","","","كتاب النكاح"
"17364","(۱۷۳۶۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ قَالَ : لَعَنَ اللَّہُ الْمُحِلَّ وَالْمُحَلَّلَ لَہُ وَالْمُحَلَّلَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 17364","","","كتاب النكاح"
"17365","(۱۷۳۶۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ الْمُغِیرَۃِ بْنِ نَوْفَلٍ أَنَّ ابْنَ عُمَرَ سُئِلَ عَنْ تَحْلِیلِ الْمَرْأَۃِ لِزَوْجِہَا قَالَ : ذَلِکَ السِّفَاحُ ، لَوْ أَدْرَکَکُمْ عُمَرُ لَنَکَّلَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 17365","","","كتاب النكاح"
"17366","(۱۷۳۶۶) حَدَّثَنَا وَکِیعٌ ، عَنِ أَبِی شِہَابٍ ، عَنْ جَبَلَۃَ بْنِ دَعْلَجٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : الْمُحَلِّلُ مَلْعُونٌ۔","","Musannaf Ibn Abi Shaybah 17366","","","كتاب النكاح"
"17367","(۱۷۳۶۷) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ وَعَنْ یُونُسَ، عَنِ الْحَسَنِ قَالاَ: إذَا ہَمَّ أَحَدُ الثَّلاَثَۃِ فَسَدَ النِّکَاحُ۔","","Musannaf Ibn Abi Shaybah 17367","","","كتاب النكاح"
"17368","(۱۷۳۶۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنْ رَجُلٍ تَزَوَّجَ امْرَأَۃً لِیُحِلَّہَا لِزَوْجِہَا ، فَقَالَ الْحَکَمُ : یُمْسِکُہَا وَقَالَ حَمَّادٌ : أَحَبُّ إلَیَّ أَنْ یُفَارِقَہَا۔","","Musannaf Ibn Abi Shaybah 17368","","","كتاب النكاح"
"17369","(۱۷۳۶۹) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً لِیُحِلَّہَا لِزَوْجِہَا وَہُوَ لاَ یَعْلَمُ قَالَ : لاَ یَصْلُحُ ذَلِکَ إذَا کَانَ تَزَوَّجَہَا لَیُحِلَّہَا۔","","Musannaf Ibn Abi Shaybah 17369","","","كتاب النكاح"
"17370","(۱۷۳۷۰) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ قَالَ : لُعِنَ الْمُحِلُّ وَالْمُحَلَّلُ لَہُ۔","","Musannaf Ibn Abi Shaybah 17370","","","كتاب النكاح"
"17371","(۱۷۳۷۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمُحِلَّ وَالْمُحَلَّلَ لَہُ۔ (ترمذی ۱۸۲۰۔ احمد ۱/۴۶۲)","Sahih","Musannaf Ibn Abi Shaybah 17371","","","كتاب النكاح"
"17372","(۱۷۳۷۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُجَالِدٍ ، عَنْ عَامِرٍ ، عَنِ جابر بْنِ عَبْدِ اللہِ ، عَنْ عَلِیٍّ قَالَ لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمُحِلَّ وَالْمُحَلَّلَ لَہُ۔ (ابوداؤد ۲۰۷۰۔ احمد ۱/۸۳)","Da'if","Musannaf Ibn Abi Shaybah 17372","","","كتاب النكاح"
"17373","(۱۷۳۷۳) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُوسَی بْنِ أَبِی الْفُرَاتِ ، عَنْ عَمْرِو بْنِ دِینَارٍ أنَّہُ سُئِلَ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَہُ فَجَائَ رَجُلٌ مِنْ أَہْلِ الْقَرْیَۃِ بِغَیْرِ عِلْمِہِ وَلاَ عِلْمِہَا فَأَخْرَجَ شَیْئًا مِنْ مَالِہِ فَتَزَوَّجَہَا بہ لِیُحِلَّہَا لَہُ ، فَقَالَ : لاَ ، ثُمَّ ذَکَرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنْ مِثْلِ ذَلِکَ ، فَقَالَ : لاَ حَتَّی یَنْکِحَہَا مُرْتَغِِبًا لِنَفْسِہِ ، حَتَّی یَتَزَوَّجَہَا مُرْتَغِِبًا لِنَفْسِہِ ، فَإِذَا فَعَلَ ذَلِکَ لَمْ تَحِلَّ لَہُ حَتَّی یذُوقَ الْعُسَیْلَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 17373","","","كتاب النكاح"
"17374","(۱۷۳۷۴) حَدَّثَنَا مُعَاذٌ قَالَ : حدَّثَنَا عَبَّادُ بْنُ مَنْصُورٍ قَالَ : جَائَ رَجُلٌ إلَی الْحَسَنِ ، فَقَالَ : إنَّ رَجُلاً مِنْ قَوْمِی طَلَّقَ امْرَأَتَہُ ثَلاَثًا فَنَدِمَ وَنَدِمَتْ ، فَأَرَدْتُ أَنْ أَنْطَلِقَ فَأَتَزَوَّجَہَا وَأَصْدُقَہَا صَدَاقًا ثُمَّ أَدْخُلَ بِہَا کَمَا یَدْخُلُ الرَّجُلُ بِامْرَأَتِہِ ، ثُمَّ أُطَلِّقَہَا حَتَّی تَحِلَّ لِزَوْجِہَا ، قَالَ ، فَقَالَ لَہُ الْحَسَنُ : اتَّقِ اللَّہَ یَا فَتَی وَلاَ تَکُونَنَّ مِسْمَارَ نَارٍ لِحُدُودِ اللہِ۔","","Musannaf Ibn Abi Shaybah 17374","","","كتاب النكاح"
"17375","(۱۷۳۷۵) حَدَّثَنَا الْمُعَلَّی بْنُ مَنْصُورٍ قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ جَعْفَرٍ ، عَنْ عُثْمَانَ بْنِ مُحَمَّدٍ الأَخْنَسِیِّ ، عَنِ الْمَقْبُرِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمُحِلَّ وَالْمُحَلَّلَ لَہُ۔n(ترمذی ۴۳۷۔ احمد ۲/۳۲۳)","Hasan","Musannaf Ibn Abi Shaybah 17375","","","كتاب النكاح"
"17376","(۱۷۳۷۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ أَبِی السَّنَابِلِ قَالَ : وَضَعَتْ سُبَیْعَۃُ بِنْتُ الْحَارِثِ حَمْلَہَا بَعْدَ وَفَاۃِ زَوْجِہَا بِبِضْعٍ وَعِشْرِینَ لَیْلَۃً فَلَمَّا تَعَلَّتْ مِنْ نِفَاسِہَا تَشَوَّفَتْ فَعِیبَ ذَلِکَ عَلَیْہَا وَذُکِرَ أَمْرُہَا لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إِنْ تَفْعَلْ فَقَدْ مَضَی أَجَلُہَا۔n(طبرانی ۸۹۶۔ دارمی ۲۲۸۱)","","Musannaf Ibn Abi Shaybah 17376","","","كتاب النكاح"
"17377","(۱۷۳۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ یحیی بْنِ سَعِیدٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ أَبِی سَلَمَۃَ قَالَ : کُنْتُ أَنَا ، وَابْنُ عَبَّاسٍ ، وَأَبُو ہُرَیْرَۃَ فَتَذَاکَرْنَا : الرَّجُلُ یَمُوتُ ، عَنِ الْمَرْأَۃِ فَتَضَعُ بَعْدَ وَفَاتِہِ بِیَسِیرٍ فَقُلْتُ : إذَا وَضَعَتْ فَقَدْ حَلَّتْ وَقَالَ ابْنُ عَبَّاسٍ : أَجَلُہَا آخِرُ الأَجَلَیْنِ فَتَرَاجَعَا بِذَلِکَ ، فَقَالَ أَبُو ہُرَیْرَۃَ : أَنَا مَعَ ابْنِ أَخِی یَعْنِی أَبَا سَلَمَۃَ فَبَعَثُوا کُرَیْبًا مَوْلَی ابْنِ عَبَّاسٍ إلَی أُمِّ سَلَمَۃَ ، فَقَالَتْ : إنَّ سُبَیْعَۃَ الأَسْلَمِیَّۃَ وَضَعَتْ بَعْدَ وَفَاۃِ زَوْجِہَا بِأَرْبَعِینَ لَیْلَۃً ، وَإِنَّ رَجُلاً مِنْ بَنِی عَبْدِ الدَّارِ یُکَنَّی أَبَا السَّنَابِلِ خَطَبَہَا وَأَخْبَرَہَا أَنَّہَا قَدْ حَلَّتْ فَأَرَادَتْ أَنْ تَتَزَوَّجَ غَیْرَہُ ، فَقَالَ لَہَا أَبُو السَّنَابِلِ : إنَّک لَمْ تَحِلِّینَ فَذَکَرَتْ ذَلِکَ سُبَیْعَۃُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَمَرَہَا أَنْ تَتَزَوَّجَ۔ (مسلم ۱۲۲۔ ترمذی ۱۱۲۳)","Sahih","Musannaf Ibn Abi Shaybah 17377","","","كتاب النكاح"
"17378","(۱۷۳۷۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنِ الْمِسْوَرِ أَنَّ سُبَیْعَۃَ وَضَعَتْ بَعْدَ وَفَاۃِ زَوْجِہَا بِشَہْرٍ فَأَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَمَرَہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تَزَوَّجَ۔ (بخاری ۵۳۲۰۔ احمد ۴/۳۲۷)","Sahih","Musannaf Ibn Abi Shaybah 17378","","","كتاب النكاح"
"17379","(۱۷۳۷۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، قَالَ : قَالَ : سَمِعْتُ رَجُلاً مِنَ الأَنْصَارِ یُحَدِّثُ ابْنَ عُمَرَ یَقُولُ : سَمِعْتُ أَبَاک یَقُولُ : لَوْ وَضَعَتِ الْمُتَوَفَّی عَنْہَا زَوْجُہَا ذَا بَطْنِہَا وَہُوَ عَلَی السَّرِیرِ فَقَدْ حَلَّتْ۔","Sahih","Musannaf Ibn Abi Shaybah 17379","","","كتاب النكاح"
"17380","(۱۷۳۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ مَوْہَبٍ ، عَنْ صَالِحِ بْنِ کَیْسَانَ ، عَنْ عُمَرَ وَعُثْمَانَ قَالاَ : إذَا وَضَعَتْ وَہُوَ فِی جَانِبِ الْبَیْتِ فِی أَکْفَانِہِ فَقَدْ حَلَّتْ۔","Da'if","Musannaf Ibn Abi Shaybah 17380","","","كتاب النكاح"
"17381","(۱۷۳۸۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ عُمَرَ اسْتَشَارَ عَلِیَّ بْنَ أَبِی طَالِبٍ رضی اللہ عنہ وَزَیْدَ بْنَ ثَابِتٍ قَالَ زَیْدٌ : قدْ حَلَّتْ وَقَالَ عَلِیٌّ : أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا قَالَ زَیْدٌ: أَرَأَیْتَ إِنْ کَانَتْ یَئیسًا قَالَ عَلِیٌّ : فَآخِرُ الأَجَلَیْنِ قَالَ عُمَرُ : لَوْ وَضَعَتْ ذَا بَطْنِہَا وَزَوْجُہَا عَلَی نَعْشِہِ لَمْ یَدْخُلْ حُفْرَتَہُ لَکَانَتْ قَدْ حَلَّتْ۔","","Musannaf Ibn Abi Shaybah 17381","","","كتاب النكاح"
"17382","(۱۷۳۸۲) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ، عَنْ مُسْلِمٍ، عَنْ مَسْرُوقٍ، قَالَ: قَالَ عَبْدُ اللہِ: وَاللَّہِ مَنْ شَائَ لَقَاسَمْتُہُ لَنَزَلَتْ سُورَۃُ النِّسَائِ الْقُصْرَی بَعْدَ أَرْبَعَۃِ أَشْہُرٍ وَعَشْرًا۔ (ابوداؤد ۲۳۰۱۔ ابن ماجہ ۲۰۳۰)","Sahih","Musannaf Ibn Abi Shaybah 17382","","","كتاب النكاح"
"17383","(۱۷۳۸۳) حَدَّثَنَا عبد الوہاب الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ أَنَّہُ قَالَ فِی الْمُتَوَفَّی عَنْہَا زَوْجُہَا وَہِیَ حَامِلٌ : إذَا وَضَعَتْ حَلَّتْ۔","","Musannaf Ibn Abi Shaybah 17383","","","كتاب النكاح"
"17384","(۱۷۳۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ وَہِیَ حَامِلٌ ، أَوْ تُوُفِّیَ عَنْہَا فَإِنَّ أَجَلَہَا أَنْ تَضَعَ حَمْلَہَا۔","","Musannaf Ibn Abi Shaybah 17384","","","كتاب النكاح"
"17385","(۱۷۳۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : أَجَلُ کُلِّ حَامِلٍ أَنْ تَضَعَ حَمْلَہَا قَالَ : وَکَانَ عَلِیٌّ یَقُولُ : آخِرُ الأَجَلَیْنِ۔","","Musannaf Ibn Abi Shaybah 17385","","","كتاب النكاح"
"17386","(۱۷۳۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ مُسْلِمٍ وَلَمْ یُذْکَرْ فِیہِ مَسْرُوقٌ ، عَنْ عَلِیٍّ أَنَّہُ کَانَ یَقُولُ : آخِرُ الأَجَلَیْنِ۔","","Musannaf Ibn Abi Shaybah 17386","","","كتاب النكاح"
"17387","(۱۷۳۸۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنْ عَمْرِو بْنِ سَالِمٍ قَالَ : قَالَ أُبَیُّ بْنُ کَعْبٍ : یَا رَسُولَ اللہِ ، إنَّ عِدَدًا مِنْ عِدَدِ النِّسَائِ لَمْ یُذْکَرْ فِی کِتَابِ اللہِ ، الصِّغَارُ وَالْکِبَارُ وَأُولاَتُ الأَحْمَالِ فَأَنْزَلَ اللَّہُ تَعَالَی : {وَاللاَّئِی یَئِسْنَ مِنَ الْمَحِیضِ مِنْ نِسَائِکُمْ إنِ ارْتَبْتُمْ فَعِدَّتُہُنَّ ثَلاَثَۃُ أَشْہُرٍ وَاللاَّئِی لَمْ یَحِضْنَ وَأُولاَتُ الأَحْمَالِ أَجَلُہُنَّ أَنْ یَضَعْنَ حَمْلَہُنَّ}۔ (حاکم ۴۹۲۔ ابن جریر ۱۴۱)","","Musannaf Ibn Abi Shaybah 17387","","","كتاب النكاح"
"17388","(۱۷۳۸۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ قَالَ : کُنْتُ فِی حَلْقَۃٍ فِیہَا عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی قَالَ : فَقَالَ : آخِرُ الأَجَلَیْنِ قَالَ : فَذَکَرْتُ حَدِیثَ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنْ سُبَیْعَۃَ قَالَ فَضمَزَ لِی أَصْحَابُہُ قَالَ: فَقُلْتُ : إنِّی لَجَرِیئٌ عَلَی عَبْدِ اللہِ بْنِ عُتْبَۃَ إِنْ کَذَبْتُ عَلَیْہِ وَہُوَ فِی نَاحِیَۃِ المَسْجِد۔n(بخاری ۴۵۳۲۔ نسائی ۵۷۱۵)","Da'if","Musannaf Ibn Abi Shaybah 17388","","","كتاب النكاح"
"17389","(۱۷۳۸۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ فِی الْحَامِلِ الْمُتَوَفَّی عَنْہَا زَوْجُہَا : عِدَّتُہَا آخِرُ الأَجَلَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 17389","","","كتاب النكاح"
"17390","(۱۷۳۹۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ الزُّہْرِیِّ، عَنْ عُبَیْدِ اللہِ، عَنْ أَبِیہِ قَالَ: وَضَعَتْ سُبَیْعَۃُ بَعْدَ وَفَاۃِ زَوْجِہَا بِعِشْرِینَ، أَوْ بِشَہْرٍ ، أَوْ نَحْوِ ذَلِکَ فَمَرَّ بِہَا أَبُو السَّنَابِلِ بْنُ بَعْکَکٍ ، فَقَالَ : قَدْ تَصَنَّعْتِ لِلأَزْوَاجِ ؟ لاَ ، حَتَّی یَأْتِیَ عَلَیْک أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا فَأَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَتْ ذَلِکَ لَہُ، فَقَالَ: قَدْ حَلَلْتِ لِلأَزْوَاجِ۔n(بخاری ۵۳۱۹۔ بیہقی ۴۱۹)","","Musannaf Ibn Abi Shaybah 17390","","","كتاب النكاح"
"17391","(۱۷۳۹۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ وَعَمْرِو بْنِ عُتْبَۃَ أَنَّہُمَا کَتَبَا إلَی سُبَیْعَۃَ بِنْتِ الْحَارِثِ یَسْأَلاَنِہَا عَنْ أَمْرِہَا فَکَتَبَتْ إلَیْہِمَا أَنَّہَا وَضَعَتْ بَعْدَ وَفَاۃِ زَوْجِہَا بِخَمْسَۃٍ وَعِشْرِینَ لَیْلَۃً فَتَہَیَّأَتْ تَطْلُبُ الْخَیْرَ فَمَرَّ بِہَا أَبُو السَّنَابِلِ بْنُ بَعْکَکٍ ، فَقَالَ : قدْ أَسْرَعْتِ ، اعْتَدِّی آخِرَ الأَجَلَیْنِ أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا فَأَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْتُ : یَا رَسُولَ اللہِ ، اسْتَغْفِرْ لِی ، فَقَالَ : وَمَا ذَاکِ ؟ فَأَخْبَرَتْہُ الْخَبَرَ ، فَقَالَ : إِنْ وَجَدْتِ زَوْجًا صَالِحًا فَتَزَوَّجِی۔ (بخاری ۵۳۱۹۔ مسلم ۱۱۲۲)","Sahih","Musannaf Ibn Abi Shaybah 17391","","","كتاب النكاح"
"17392","(۱۷۳۹۲) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مَعْقِلٍ قَالَ : شَہِدْتُ عَلِیًّا وَسَأَلَہُ رَجُلٌ عَنِ امْرَأَۃٍ تُوُفِّیَ عَنْہَا زَوْجُہَا وَہِیَ حَامِلٌ قَالَ : تَتَرَبَّصُ أَبْعَدَ الأَجَلَیْنِ ، فَقَالَ رَجُل إِنَّ ابْنَ مَسْعُودٍ: یَقُولُ تَسْفِی نَفْسَہَا ؟ فَقَالَ عَلِیٌّ : إنَّ فَرُّوخَ لاَ یَعْلَمُ۔","Sahih","Musannaf Ibn Abi Shaybah 17392","","","كتاب النكاح"
"17393","(۱۷۳۹۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ أَنَّہُ سُئِلَ عَنْ رَجُلٍ تَزَوَّجَ امْرَأَۃً فَمَاتَ عَنْہَا وَلَمْ یَدْخُلْ بِہَا وَلَمْ یَفْرِضْ لَہَا صَدَاقًا ، فَقَالَ عَبْدُ اللہِ : لَہَا الصَّدَاقُ وَلَہَا الْمِیرَاثُ وَعَلَیْہَا الْعِدَّۃُ ، فَقَالَ مَعْقِلُ بْنُ یَسَارٍ : شَہِدْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی فِی بِرْوَعَ بِنْتِ وَاشِقٍ مِثْلَ ذَلِکَ۔ (ابن ماجہ ۱۸۹۱۔ احمد ۴/۲۸۰)","Sahih","Musannaf Ibn Abi Shaybah 17393","","","كتاب النكاح"
"17394","(۱۷۳۹۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ : مِثْلَہُ۔n(ابوداؤد ۲۱۰۸۔ ابن ماجہ ۱۸۹۱)","Sahih","Musannaf Ibn Abi Shaybah 17394","","","كتاب النكاح"
"17395","(۱۷۳۹۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ بِنَحْوٍ مِنْ حَدِیثِ ابْنِ مَہْدِیٍّ ، عَنْ فِرَاسٍ۔ (ترمذی ۱۱۴۵۔ ابوداؤد ۲۱۰۸)","Sahih","Musannaf Ibn Abi Shaybah 17395","","","كتاب النكاح"
"17396","(۱۷۳۹۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ أن ابْنَ عُمَرَ زَوَّجَ ابْنًا لَہُ امْرَأَۃً مِنْ أَہْلِہِ ، فَتُوُفِّیَ قَبْلَ أَنْ یَدْخُلَ بِہَا ، وَلَمْ یُسَمِّ لَہَا صَدَاقًا ، فَطَلَبُوا إلَی ابْنِ عُمَرَ الصَّدَاقَ ، فَقَالَ : لَیْسَ لَہَا صَدَاقٌ ، فَأَبَوْا أَنْ یَرْضَوْا بِذَلِکَ، فَجَعَلُوا بَیْنَہُمْ زَیْدَ بْنَ ثَابِتٍ ، فَأَتَوْہُ فَقَالَ : لَیْسَ لَہَا صَدَاقٌ۔","Sahih","Musannaf Ibn Abi Shaybah 17396","","","كتاب النكاح"
"17397","(۱۷۳۹۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ قَالَ قَالَ زَیْدُ بْنُ ثَابِتٍ تَرِثُ وَتَعْتَدُّ۔","","Musannaf Ibn Abi Shaybah 17397","","","كتاب النكاح"
"17398","(۱۷۳۹۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی الشَّعْثَائِ ، وَعَطَائٍ فِی الَّذِی یُفَوَّضُ إلَیْہِ فَیَمُوتُ قَبْلَ أَنْ یَفْرِضَ قَالاَ : لَہَا الْمِیرَاثُ وَلَیْسَ لَہَا صَدَاقٌ۔","","Musannaf Ibn Abi Shaybah 17398","","","كتاب النكاح"
"17399","(۱۷۳۹۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرو وَعَطَائِ بْنِ السَّائِبِ ، عَنْ عَبْدِ خَیْرٍ یُرَی أَنَّہُ عَنْ عَلِیٍّ قَالَ : لَہَا الْمِیرَاثُ وَلاَ صَدَاقَ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17399","","","كتاب النكاح"
"17400","(۱۷۴۰۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ أَنَّ رَجُلاً بِالْمَدِینَۃِ تَزَوَّجَ امْرَأَۃً فَلَمْ یَفْرِضْ لَہَا وَلَمْ یَدْخُلْ بِہَا قَالُوا : لَہَا الْمِیرَاثُ وَلاَ مَہْرَ لَہَا وَقَالَ مَسْرُوقٌ : لاَ یَکُونُ مِیرَاثٌ حَتَّی یَکُونَ قَبْلَہُ مَہْرٌ۔","","Musannaf Ibn Abi Shaybah 17400","","","كتاب النكاح"
"17401","(۱۷۴۰۱) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَہَا نِصْفُ الصَّدَاقِ ، أَوِ الصَّدَاقُ ، شَکَّ أَبُو بَکْرٍ۔","","Musannaf Ibn Abi Shaybah 17401","","","كتاب النكاح"
"17402","(۱۷۴۰۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلْقَمَۃَ قَالَ : جَائَ رَجُلٌ إلَی ابْنِ مَسْعُودٍ ، فَقَالَ : إنَّ رَجُلاً مِنَّا تَزَوَّجَ امْرَأَۃً وَلَمْ یَفْرِضْ لَہَا وَلَمْ یُجَامِعْہَا حَتَّی مَاتَ ، فَقَالَ ابْنُ مَسْعُودٍ : مَا سُئِلْت عَنْ شَیْئٍ مُنْذُ فَارَقْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَشَدَّ عَلَیَّ مِنْ ہَذَا، سَلُوا غَیْرِی فَتَرَدَّدُوا فِیہَا شَہْرًا قَالَ: فَقَالَ: مَنْ أَسْأَلُ وَأَنْتُمْ أَخِیَّۃُ أَصْحَابِ مُحَمَّدٍ بِہَذَا الْبَلَدِ؟ فَقَالَ: سَأَقُولُ فِیہَا بِرَأْیِی فَإِنْ یَکُنْ صَوَابًا فَمِنَ اللہِ ، وَإِنْ یَکُنْ خَطَأً فَمِنِّی وَمِنَ الشَّیْطَانِ ، أَرَی أَنَّ لَہَا مَہْرَ نِسَائِہَا لاَ وَکْسَ وَلاَ شَطَطَ وَلَہَا الْمِیرَاثُ وَعَلَیْہَا عِدَّۃُ الْمُتَوَفَّی عَنْہَا زَوْجُہَا ، فَقَالَ: نَاسٌ مِنْ أَشْجَعَ : نَشْہَدُ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی مِثْلَ الَّذِی قَضَیْت فِی امْرَأَۃٍ مِنَّا یُقَالُ لَہَا بِرْوَعُ ابْنَۃُ وَاشِقٍ قَالَ : فَمَا رَأَیْتُ ابْنَ مَسْعُودٍ فَرِحَ بِشَیْئٍ مَا فَرِحَ یَوْمَئِذٍ بِہِ۔(ابن حبان ۴۱۰۱۔ حاکم ۱۸۰)","Sahih","Musannaf Ibn Abi Shaybah 17402","","","كتاب النكاح"
"17403","(۱۷۴۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ قَالَ : تَزَوَّجَ ابْنٌ لِعَبْدِ اللہِ بْنِ عُمَرَ بِنْتًا لِعُبَیْدِ اللہِ بْنِ عُمَرَ کَانَتْ أُمُّہَا أَسْمَائَ بِنْتَ زَیْدِ بْنِ الْخَطَّابِ فَتُوُفِّیَ وَلَمْ یَکُنْ فَرَضَ لَہَا صَدَاقًا فَطَلَبُوا مِنْہُ الصَّدَاقَ وَالْمِیرَاثَ ، فَقَالَ ابْنُ عُمَرَ : لَہَا الْمِیرَاثُ وَلاَ صَدَاقَ لَہَا فَأَبَوْا ذَلِکَ عَلَی ابْنِ عُمَرَ فَجَعَلُوا بَیْنَہُمْ زَیْدَ بْنَ ثَابِتٍ ، فَقَالَ زَیْدٌ : لَہَا الْمِیرَاثُ وَلاَ صَدَاقَ لَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 17403","","","كتاب النكاح"
"17404","(۱۷۴۰۴) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عَبْدِ خَیْرٍ ، عَنْ عَلِیٍّ قَالَ : لَہَا الْمِیرَاثُ وَلاَ صَدَاقَ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17404","","","كتاب النكاح"
"17405","(۱۷۴۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الَّتِی یُتَوَفَّی عَنْہَا زَوْجُہَا قَبْلَ أَنْ یَفْرِضَ لَہَا وَقَبْلَ أَنْ یَدْخُلَ بِہَا : أَنَّ لَہَا صَدَاقَ نِسَائِہَا وَیُحَدِّثُ بِذَلِکَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَعِدَّۃَ الْمُتَوَفَّی وَلَہَا الْمِیرَاثُ۔ (سعید بن منصور ۹۳۳۔ عبدالرزاق ۱۰۹۰۰)","Hasan","Musannaf Ibn Abi Shaybah 17405","","","كتاب النكاح"
"17406","(۱۷۴۰۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَمَّنْ أَخْبَرَہُ ، عَنْ عَلِیٍّ قَالَ : لَہَا الْمِیرَاثُ وَلاَ صَدَاقَ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17406","","","كتاب النكاح"
"17407","حدثنا أبو عبد الرحمن بقی بن مخلد ، قَالَ : حدثنا أبو بکر عبد اللہ بن محمد بن أبی شیبۃ ، قال:n(۱۷۴۰۷) حَدَّثَنَا جَعْفَرُ بْنُ عَوْنٍ قَالَ : أَخْبَرَنَا رَبِیعَۃُ بن عُثْمَانَ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ نَہَارٍ الْعَبْدِیِّ، وَکَانَ مِنْ أَصْحَابِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِی سَعِیدٍ أَنَّ رَجُلاً أَتَی بِابْنَۃٍ لَہُ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ ابْنَتِی ہَذِہِ أَبَتْ أَنْ تَتَزَوَّجَ قَالَ ، فَقَالَ لَہَا : أَطِیعِی أَبَاک قَالَ ، قَالَتْ : لاَ حَتَّی تُخْبِرَنِی مَا حَقُّ الزَّوْجِ عَلَی زَوْجَتِہِ ؟ فَرَدَّدَتْ عَلَیْہِ مَقَالَتَہَا قَالَ ، فَقَالَ : حَقُّ الزَّوْجِ عَلَی زَوْجَتِہِ أَنْ لَوْ کَانَ بِہِ قُرْحَۃٌ فَلَحَسَتْہَا ، أَوِ ابْتَدَرَ مَنْخِرَاہُ صَدِیدًا ، أَوْ دَمًا ثُمَّ لَحَسَتْہُ مَا أَدَّتْ حَقَّہُ قَالَ ، فَقَالَتْ : وَالَّذِی بَعَثَک بِالْحَقِّ لاَ أَتَزَوَّجُ أَبَدًا قَالَ ، فَقَالَ : لاَ تُنْکِحُوہُنَّ إلاَّ بِإِذْنِہِنَّ۔ (ابن حبان ۴۱۶۴۔ حاکم ۱۸۸)","Hasan","Musannaf Ibn Abi Shaybah 17407","","","كتاب النكاح"
"17408","(۱۷۴۰۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی نَصْرٍ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ مُسَاوِرٍ الْحِمْیَرِیِّ ، عَنْ أُمہِ قَالَت : سَمِعْتُ أُمَّ سَلَمَۃَ تَقُولُ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَیُّمَا امْرَأَۃٍ مَاتَتْ وَزَوْجُہَا عَنْہَا رَاضٍ دَخَلَتِ الْجَنَّۃَ۔ (ترمذی ۱۱۶۱۔ طبرانی ۸۸۴)","Da'if","Musannaf Ibn Abi Shaybah 17408","","","كتاب النكاح"
"17409","(۱۷۴۰۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ قَالَ : أَتَتِ امْرَأَۃٌ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، مَا حَقُّ الزَّوْجِ عَلَی زوجتہ ؟ قَالَ : لاَ تَمْنَعُہُ نَفْسَہَا وَلَوْ کَانَتْ عَلَی ظَہْرِ قَتَبٍ قَالَتْ : یَا رَسُولَ اللہِ ، مَا حَقُّ الزَّوْجِ عَلَی زَوْجَتِہِ ؟ قَالَ : لاَ تَصَدَّقُ بِشَیْئٍ مِنْ بَیْتِہِ إلاَّ بِإِذْنِہِ فَإِنْ فَعَلَتْ کَانَ لَہُ الأَجْرُ وَعَلَیْہَا الْوِزْرُ ، قَالَتْ : یَا نَبِی اللہ مَا حَقُّ الزَّوْجِ عَلَی امرأتہ قَالَ : لاَ تَخْرُجَ مِنْ بَیْتِہِ إِلا بِإِذْنِہِ فَإِنْ فَعَلَتْ لَعَنَتْہَا مَلاَئِکَۃُ اللہِ وَمَلاَئِکَۃُ الرَّحْمَۃِ وَمَلاَئِکَۃُ الْغَضَبِ حَتَّی تَتُوبَ ، أَوْ تراجع قَالَتْ : یَا نَبِیَّ اللہِ : فَإِنْ کَانَ لَہَا ظَالِمًا ؟ قَالَ : وَإِنْ کَانَ لَہَا ظَالِمًا ، قَالَتْ : وَالَّذِی بَعَثَک بِالْحَقِّ لاَ یَمْلِکُ عَلَیَّ أَمْرِی أَحَدٌ بَعْدَ ہَذَا أَبَدًا مَا بَقِیتُ۔","Da'if","Musannaf Ibn Abi Shaybah 17409","","","كتاب النكاح"
"17410","(۱۷۴۱۰) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ بُشَیرِ بْنِ یَسَارٍ ، عَنْ حُصَیْنِ بْنِ مِحْصَنٍ أَنَّ عَمَّۃً لَہُ أَتَتِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَطْلُبُ حَاجَۃً فَلَمَّا قَضَتْ حَاجَتَہَا قَالَ : أَلَکِ زَوْجٌ ؟ قَالَتْ : نَعَمْ ، قَالَ : فَأَیْنَ أَنْتِ مِنْہُ ؟ قَالَتْ : مَا آلُوہُ خَیْرًا إلاَّ مَا عَجَزْتُ عَنْہُ قَالَ : انْظُرِی ، فَإِنَّہُ جَنَّتُکِ وَنَارُکِ۔n(احمد ۴/۳۴۱۔ حاکم ۱۸۹)","Da'if","Musannaf Ibn Abi Shaybah 17410","","","كتاب النكاح"
"17411","(۱۷۴۱۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ أَبِی ظَبْیَانَ قَالَ : لَمَّا قَدِمَ مُعَاذٌ مِنَ الْیَمَنِ قَالَ : یَا رَسُولَ اللہِ ، رَأَیْنَا قَوْمًا یَسْجُدُ بَعْضُہُمْ لِبَعْضٍ أَفَلاَ نَسْجُدُ لَکَ ؟ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ ، إنَّہُ لاَ یَسْجُدُ أَحَدٌ لأَحَدٍ دون اللہ وَلَوْ کُنْتُ آمِرًا أَحَدًا یَسْجُدُ لأَحَدٍ لأَمَرْتُ النِّسَائَ یَسْجُدْنَ لأَزْوَاجِہِنَّ۔","","Musannaf Ibn Abi Shaybah 17411","","","كتاب النكاح"
"17412","(۱۷۴۱۲) حَدَّثَنَا عبد اللہ بْنُ نُمَیْرٍ قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ أَبِی ظَبْیَانَ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، عَنْ مُعَاذِ بْنِ جَبَلٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِ حَدِیثِ أَبِی مُعَاوِیَۃَ۔ (ابن ماجہ ۱۸۵۳۔ حارث ۴۹۸)","Da'if","Musannaf Ibn Abi Shaybah 17412","","","كتاب النكاح"
"17413","(۱۷۴۱۳) حَدَّثَنَا عبد اللہ بْنُ إدْرِیسَ ، عَنِ الأَعْمَشِِ ، عَنِ الْمِنْہَالِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ قَالَ : ثَلاَثَۃٌ لاَ تُجَاوِزُ صَلاَۃُ أَحَدِہِمْ رَأْسَہُ ، إمَامٌ أَمَّ قَوْمًا وَہُمْ لَہُ کَارِہُونَ ، وَامْرَأَۃٌ تَعْصِی زَوْجَہَا ، وَعَبْدٌ آبِقٌ مِنْ سَیِّدِہِ۔","","Musannaf Ibn Abi Shaybah 17413","","","كتاب النكاح"
"17414","(۱۷۴۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ بْنِ خَالِدٍ ، عَنِ امْرَأَۃٍ مِنْ بَنِی عُطَارِدٍ یُقَالُ لَہَا رَبِیعَۃُ قَالَتْ : قالَتْ عَائِشَۃُ : یَا مَعاشِرَ النِّسَائِ ، لَوْ تَعْلَمْنَ حَقَّ أَزْوَاجِکُنَّ عَلَیْکُنَّ لَجَعَلَتِ الْمَرْأَۃُ مِنْکُنَّ تَمْسَحُ الْغُبَارَ ، عَنْ وَجْہِ زَوْجِہَا بِحُرِّ وَجْہِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17414","","","كتاب النكاح"
"17415","(۱۷۴۱۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ زِیَادِ بْنِ أَبِی الْجَعْدِ ، عَنْ عَمْرِو بْنِ الْحَارِثِ بْن الْمُصْطَلِقِ قَالَ : کَانَ یُقَالُ : أَشَدُّ النَّاسِ عَذَابًا اثْنَانِ : امْرَأَۃٌ تَعْصِی زَوْجَہَا وَإِمَامُ قوْمٍ وَہُمْ لَہُ کَارِہُونَ۔","","Musannaf Ibn Abi Shaybah 17415","","","كتاب النكاح"
"17416","(۱۷۴۱۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ حُمَیْدٍ، عَنْ أُمِّہِ قَالَتْ: کُنَّ نِسَائُ أَہْلِ الْمَدِینَۃِ إذَا أَرَدْنَ أَنْ یَبْنِینَ بِامْرَأَۃٍ عَلَی زَوْجِہَا بَدَأْنَ بِعَائِشَۃَ فَأَدْخَلْنَہَا عَلَیْہَا فَتَضَعُ یَدَہَا عَلَی رَأْسِہَا تَدْعُو لَہَا وَتَأْمُرُہَا بِتَقْوَی اللہِ وَحَقِّ الزَّوْجِ۔","Da'if","Musannaf Ibn Abi Shaybah 17416","","","كتاب النكاح"
"17417","(۱۷۴۱۷) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ یَنْبَغِی لِشَیْئٍ أَنْ یَسْجُدَ لِشَیْئٍ وَلَوْ کَانَ ذَلِکَ لَکَانَ النِّسَائُ لأَزْوَاجِہِنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 17417","","","كتاب النكاح"
"17418","(۱۷۴۱۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا دَعَا الرَّجُلُ امْرَأَتَہُ إلَی فِرَاشِہِ فَأَبَتْ فَبَاتَ غَضْبَانَ عَلَیْہَا لَعَنَتْہَا الْمَلاَئِکَۃُ حَتَّی تُصْبِحَ۔n(بخاری ۵۱۹۳۔ مسلم ۱۲۲)","Sahih","Musannaf Ibn Abi Shaybah 17418","","","كتاب النكاح"
"17419","(۱۷۴۱۹) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عَائِشَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ کُنْتُ آمِرًا أَحَدًا أَنْ یَسْجُدَ لأَحَدٍ لأَمَرْتُ الْمَرْأَۃَ أَنْ تَسْجُدَ لِزَوْجِہَا وَلَوْ أَنَّ رَجُلاً أَمَرَ امْرَأَتَہُ أَنْ تَنْتَقِلَ مِنْ جَبَلٍ أَحْمَرَ إلَی جَبَلٍ أَسْوَدَ ، أَوْ مِنْ جَبَلٍ أَسْوَدَ إلَی جَبَلٍ أَحْمَرَ کَانَ نَوْلَہَا أَنْ تَفْعَلَ۔","Da'if","Musannaf Ibn Abi Shaybah 17419","","","كتاب النكاح"
"17420","(۱۷۴۲۰) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرو ، عَنْ عَبْدِ اللہِ بْنِ بَدْرٍ ، عَنْ قَیْسِ بْنِ طَلْقٍ ، عَنْ أَبِیہِ طَلْقِ بْنِ عَلِیٍّ قَالَ : جَلَسْنا عِنْدَ نَبِیِّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَمِعْتُ نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا دَعَا الرَّجُلُ زَوْجَتَہُ لِحَاجَتِہِ فَلْتَأْتِہِ ، وَإِنْ کَانَتْ عَلَی التَّنُّورِ۔ (ترمذی ۱۱۶۰۔ احمد ۴/۲۳)","Hasan","Musannaf Ibn Abi Shaybah 17420","","","كتاب النكاح"
"17421","(۱۷۴۲۱) حَدَّثَنَا ابْنُ نُمَیْرٍ قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ إبْرَاہِیمَ قَالَ : کَانُوا یَقُولُونَ : لَوْ أَنَّ امْرَأَۃً مَصَّتْ أَنْفَ زَوْجِہَا مِنَ الْجُذَامِ حَتَّی تَمُوتَ مَا أَدَّتْ حَقَّہُ۔","","Musannaf Ibn Abi Shaybah 17421","","","كتاب النكاح"
"17422","(۱۷۴۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : سَمِعْتُ الْقَاسِمَ بْنَ مُخَیْمِرَۃَ یَذْکُرُ أَنَّ سَلْمَانَ قَدَّمَہُ قَوْمٌ لِیُصَلِّیَ بِہِمْ فَأَبَی عَلَیْہِمْ حَتَّی دَفَعُوہُ ، فَلَمَّا صَلَّی بِہِمْ قَالَ : أَکُلُّکُمْ رَاضٍ ؟ قَالُوا : نَعَمْ ، قَالَ : الْحَمْدُ لِلَّہِ ، إنِّی سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : ثَلاَثَۃٌ لاَ تُقْبَلُ صَلاَتُہُمْ : الْمَرْأَۃُ تَخْرُجُ مِنْ بَیْتِ زَوْجِہَا بِغَیْرِ إذْنِہِ وَالْعَبْدُ الآبِقُ وَالرَّجُلُ یَؤُمُّ قَوْمًا وَہُمْ لَہُ کَارِہُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 17422","","","كتاب النكاح"
"17423","(۱۷۴۲۳) حَدَّثَنَا عَلِیُّ بْنُ حَسَنِ بْنِ شَقِیقٍ ، قَالَ : حَدَّثَنِی حُسَیْنُ بْنُ وَاقِدٍ قَالَ : حدَّثَنَا أَبُو غَالِبٍ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ثَلاَثَۃٌ لاَ تُجَاوِزُ صَلاَتُہُمْ آذَانَہُمْ حَتَّی یَرْجِعُوا : الْعَبْدُ الآبِقُ وَامْرَأَۃٌ بَاتتْ وَزَوْجُہَا عَلَیْہَا سَاخِطٌ وَإِمَامُ قَوْمٍ وَہُمْ لَہُ کَارِہُونَ۔","Da'if","Musannaf Ibn Abi Shaybah 17423","","","كتاب النكاح"
"17424","(۱۷۴۲۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ زَیْدِ بْنِ وَہْبٍ قَالَ : کَتَبَ إلَیْنَا عُمَرُ : إنَّ الْمَرْأَۃَ لاَ تَصُومُ تَطَوُّعًا إلاَّ بِإِذْنِہِ یَعْنِی زَوْجَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17424","","","كتاب النكاح"
"17425","(۱۷۴۲۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَصُومُ تَطَوُّعًا وَہُوَ شَاہِدٌ إلاَّ بِإِذْنِہِ یَعْنِی زَوْجَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17425","","","كتاب النكاح"
"17426","(۱۷۴۲۶) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو عن یَحْیَی بْنِ جَعْدَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : خَیْرُ فَائِدَۃٍ اسْتَفَادَہَا الْمُسْلِمُ بَعْدَ الإِسْلاَمِ امْرَأَۃٌ جَمِیلَۃٌ ، تَسُرُّہُ إذَا نَظَرَ إلَیْہَا وَتُطِیعُہُ إذَا أَمَرَہَا وَتَحْفَظُہُ إذَا غَابَ عَنْہَا فِی مَالِہِ وَنَفْسِہَا۔ (ابوداؤد ۱۶۶۱۔ سعید بن منصور ۵۰۱)","","Musannaf Ibn Abi Shaybah 17426","","","كتاب النكاح"
"17427","(۱۷۴۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : مَا اسْتَفَادَ رَجُلٌ ، أَوْ قَالَ عَبْدٌ بَعْدَ إیمَانٍ بِاللَّہِ خَیْرًا مِنِ امْرَأَۃٍ حَسَنَۃِ الْخُلُقِ وَدُودٍ وَلُودٍ ، وَمَا اسْتَفَادَ رَجُلٌ بَعْدَ الْکُفْرِ بِاللَّہِ شَرًّا مِنِ امْرَأَۃٍ سَیِّئَۃِ الْخُلُقِ حَدِیدَۃِ اللِّسَانِ ثُمَّ قَالَ : إنَّ مِنْہُنَّ غُنْمًا لاَ یُحْذَی مِنْہُ وَإِنَّ مِنْہُنَّ غُلاً یُفْدَی مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 17427","","","كتاب النكاح"
"17428","(۱۷۴۲۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی قَالَ : مَثَلُ الْمَرْأَۃِ الصَّالِحَۃِ عِنْدَ الرَّجُلِ کَمَثَلِ التَّاجِ الْمَخُوصِ بِالذَّہَبِ عَلَی رَأْسِ الْمَلِکِ وَمَثَلُ الْمَرْأَۃِ السَّوْئِ عِنْدَ الرَّجُلِ الصَّالِحِ مَثَلُ الْحِمْلِ الثَّقِیلِ عَلَی الشَّیْخِ الْکَبِیرِ۔","Sahih","Musannaf Ibn Abi Shaybah 17428","","","كتاب النكاح"
"17429","(۱۷۴۲۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِی مُوسَی قَالَ : ثَلاَثَۃٌ یَدْعُونَ فَلاَ یُسْتَجَابُ لَہُمْ : رَجُلٌ آتی سَفِیہًا مَالَہُ وَقَالَ اللَّہُ تَبَارَکَ وَتَعَالَی : {وَلاَ تُؤْتُوا السُّفَہَائَ أَمْوَالَکُم} وَرَجُلٌ کَانَتْ عِنْدَہُ امْرَأَۃٌ سَیِّئَۃُ الْخُلُقِ فَلَمْ یُطَلِّقْہَا ، أَوْ لَمْ یُفَارِقْہَا وَرَجُلٌ کَانَ لَہُ عَلَی رَجُلٍ حَقٌّ فَلَمْ یُشْہِدْ عَلَیْہِ۔","Sahih","Musannaf Ibn Abi Shaybah 17429","","","كتاب النكاح"
"17430","(۱۷۴۳۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی نَصْرٍ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ ہِلاَلِ بْنِ یَِسَافٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو قَالَ : أَلاَ أُخْبِرُکُمْ بِالثَّلاَثِ الْفَوَاقِرِ ، قَالَ : وَمَا ہُنَّ ؟ قَالَ : إمَامٌ جَائِرٌ ، إِنْ أَحْسَنْتَ لَمْ یَشْکُرْ ، وَإِنْ أَسَأْتَ لَمْ یَغْفِرْ وَجَارُ سَوْئٍ إِنْ رَأَی حَسَنَۃً غَطَّاہَا ، وَإِنْ رَأَی سَیِّئَۃً أَفْشَاہَا وَامْرَأَۃُ السَّوْئِ إِنْ شَہِدْتَہَا غَاظَتکَ ، وَإِنْ غِبْتَ عَنْہَا خَانَتْکَ۔","Sahih","Musannaf Ibn Abi Shaybah 17430","","","كتاب النكاح"
"17431","(۱۷۴۳۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ جَعْدَۃَ بْنِ ہُبَیْرَۃَ أنہ کَانَ إذَا زَوَّجَ شَیْئًا مِنْ بَنَاتِہِ خَلاَ بِہَا فَنَہَاہَا ، عَنْ سَیِّئِ الأَخْلاَقِ وَأَمَرَہَا بِأَحْسَنِہَا۔","","Musannaf Ibn Abi Shaybah 17431","","","كتاب النكاح"
"17432","(۱۷۴۳۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا شَیْبَانُ قَالَ أَخْبَرَنَا عَبْدُ الْمَلِکِ بْنُ عُمَیْرٍ ، عَنْ زَیْدِ بْنِ عُقْبَۃَ ، عَنْ سَمُرَۃَ بْنِ جُنْدُبٍ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : النِّسَائُ ثَلاَثَۃٌ : امْرَأَۃٌ ہَیِّنَۃٌ لَیِّنَۃٌ عَفِیفَۃٌ مُسْلِمَۃٌ وَدُودٌ وَلُودٌ تُعِینُ أَہْلَہَا عَلَی الدَّہْرِ ، وَلاَ تُعِینُ الدَّہْرَ عَلَی أَہْلِہَا ، وَقَلَّ مَا تَجِدُہَا ، ثَانِیَۃٌ : امْرَأَۃٌ عَفِیفَۃٌ مُسْلِمَۃٌ إنَّمَا ہِیَ وِعَائٌ لِلْوَلَدِ لَیْسَ عِنْدَہَا غَیْرُ ذَلِکَ ، ثَالِثَۃٌ : غُلٌّ قَمِلٌ یَجْعَلُہَا اللَّہُ فِی عُنُقِ مَنْ یَشَائُ وَلاَ یَنْزِعُہَا غَیْرُہُ ، الرِّجَالُ ثَلاَثَۃٌ : رَجُلٌ عَفِیفٌ مُسْلِمٌ عَاقِلٌ یَأْتَمِرُ فِی الأُمُورِ إذَا أَقْبَلَتْ وَتَشَبَّہت ، فَإِذَا وَقَعَتْ خَرَجَ مِنْہَا بِرَأْیِہِ وَرَجُلٌ عَفِیفٌ مُسْلِمٌ لَیْسَ لَہُ رَأْیٌ فَإِذَا وَقَعَ الأَمْرُ أَتَی ذَا الرَّأْیِ وَالْمَشْورَۃِ فَشَاوَرَہُ وَاسْتَأْمَرَہُ ثُمَّ نَزَلَ عِنْدَ أَمْرِہِ، وَرَجُلٌ حَائِرٌ بَائِرٌ لاَ یَأْتَمِرُ رُشْدًا وَلاَ یُطِیعُ مُرْشِدًا۔","Sahih","Musannaf Ibn Abi Shaybah 17432","","","كتاب النكاح"
"17433","(۱۷۴۳۳) حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ، عَنْ جَابِرِ بن عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إنَّ الْمَرْأَۃَ تُنْکَحُ عَلَی دِینِہَا وَمَالِہَا وَجَمَالِہَا فَعَلَیْکَ بِذَاتِ الدِّینِ تَرِبَتْ یَدَاک۔ (مسلم ۱۰۸۷۔ ترمذی ۱۰۸۶)","Sahih","Musannaf Ibn Abi Shaybah 17433","","","كتاب النكاح"
"17434","(۱۷۴۳۴) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حَدَّثَنِی مُحَمَّدُ بْنُ مُوسَی الْمَدَنِیُّ قَالَ : أَخْبَرَنِی سَعْدُ بْنُ إِسْحَاقَ ، عَنْ عَمَّتِہِ، عَنْ أَبِی سَعِیدٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: تُنْکَحُ الْمَرْأَۃُ عَلَی إحْدَی خِصَالٍ ثَلاَثٍ: تُنْکَحُ الْمَرْأَۃُ عَلَی مَالِہَا ، عَلَی جَمَالِہَا ، تُنْکَحُ عَلَی دِینِہَا ، عَلَیْک بِذَاتِ الدِّینِ وَالْخُلُقِ تَرِبَتْ یَمِینُکَ۔n(حاکم ۱۶۱۔ احمد ۳/۸۰)","Hasan","Musannaf Ibn Abi Shaybah 17434","","","كتاب النكاح"
"17435","(۱۷۴۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ یَحْیَی بْنِ جَعْدَۃَ رَفَعَہُ قَالَ : تُنْکَحُ الْمَرْأَۃُ عَلَی دِینِہَا وَخُلُقِہَا وَمَالِہَا وَجَمَالِہَا ، أَیْنَ بِکَ ، عَنْ ذَاتِ الْخُلُقِ وَالدِّینِ ، تَرِبَتْ یَمِینُکَ۔ (سعید بن منصور ۵۰۲)","","Musannaf Ibn Abi Shaybah 17435","","","كتاب النكاح"
"17436","(۱۷۴۳۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ یَحْیَی بْنِ جَعْدَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: تُنْکَحُ الْمَرْأَۃُ عَلَی مَالِہَا وَعَلَی حَسَبِہَا وَعَلَی جَمَالِہَا وَعَلَی دِینِہَا فَعَلَیْکَ بِذَاتِ الدِّینِ، تَرِبَتْ یَمِینُکَ۔","","Musannaf Ibn Abi Shaybah 17436","","","كتاب النكاح"
"17437","(۱۷۴۳۷) حدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمٍ ، عَنْ کُرَیْبٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَوْ أَنَّ أَحَدَکُمْ إذَا أَرَادَ أَنْ یَأْتِیَ أَہْلَہُ قَالَ : بِسْمِ اللہِ اللَّہُمَّ جَنِّبْنَا الشَّیْطَانَ وَجَنِّبِ الشَّیْطَانَ مَا رَزَقْتنَا ، فَإِنَّہُ إِنْ یُقْدَرْ بَیْنَہُمَا وَلَدٌ فِی ذَلِکَ لَمْ یَضُرَّہُ شَیْطَانٌ أَبَدًا۔ (بخاری ۳۲۷۱۔ مسلم ۱۱۶)","Sahih","Musannaf Ibn Abi Shaybah 17437","","","كتاب النكاح"
"17438","(۱۷۴۳۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ مَوْلَی أَبِی أُسَیْدٍ قَالَ : تَزَوَّجْتُ وَأَنَا مَمْلُوکٌ فَدَعَوْتُ نَفَرًا مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِیہِمُ ابْنُ مَسْعُودٍ ، وَأَبُو ذَرٍّ وَحُذَیْفَۃُ قَالَ : وَأُقِیمَتِ الصَّلاَۃُ قَالَ : فَذَہَبَ أَبُو ذَرٍّ لِیَتَقَدَّمَ فَقَالُوا : إلَیْکَ ، قَالَ : أَوَ کَذَلِکَ ؟ قَالُوا : نَعَمْ ، قَالَ : فَتَقَدَّمْتُ إلَیْہِمْ وَأَنَا عَبْدٌ مَمْلُوکٌ وَعَلَّمُونِی فَقَالُوا : إذَا أُدْخِلَ عَلَیْکَ أَہْلُکَ فَصَلِّ عَلَیْکَ رَکْعَتَیْنِ ثُمَّ سَلِ اللَّہَ تَعَالَی مِنْ خَیْرِ مَا دَخَلَ عَلَیْکَ وَتَعَوَّذْ بِہِ مِنْ شَرِّہِ ثُمَّ شَأْنَکَ وَشَأْنَ أَہْلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 17438","","","كتاب النكاح"
"17439","(۱۷۴۳۹) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنِ ابْنِ أَخِی عَلْقَمَۃَ بن قَیس، عَنْ عَلْقَمَۃَ أَنَّ ابْنَ مَسْعُودٍ کَانَ إذا غَشِیَ أَہْلَہُ فَأَنْزَلَ قَالَ: اللَّہُمَّ لاَ تَجْعَلْ لِلشَّیْطَانِ فِیمَا رَزَقْتنَا نَصِیبًا۔","Da'if","Musannaf Ibn Abi Shaybah 17439","","","كتاب النكاح"
"17440","(۱۷۴۴۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : کَانَتْ لاَ تُزَفُّ بِالْمَدِینَۃِ جَارِیَۃٌ إلَی زَوْجِہَا حَتَّی یُمَرَّ بِہَا فِی الْمَسْجِدِ فَتُصَلِّیَ فِیہِ قَالَ أَبُو بَکْرٍ : قَالَ : أُرَاہُ قَالَ : رَکْعَتَیْنِ وَحَتَّی یُمَرَّ بِہَا عَلَی أَزْوَاجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَیَدْعُونَ لَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17440","","","كتاب النكاح"
"17441","(۱۷۴۴۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ یُقَالُ لَہُ أَبُو جَرِیرٍ ، فَقَالَ : إنِّی تَزَوَّجْتُ جَارِیَۃً شَابَّۃً وَإِنِّی أَخَافُ أَنْ تَفْرَکَنِی قَالَ ، فَقَالَ عَبْدُ اللہِ : إنَّ الإِلْفَ مِنَ اللہِ وَالْفَرْکَ مِنَ الشَّیْطَانِ، یُرِیدُ أَنْ یُکَرِّہَ إلَیْکُمْ مَا أَحَلَّ اللَّہُ لَکُمْ ، فَإِذَا أَتَتْک فَمُرْہَا فَلْتُصَلِّ خلفک رَکْعَتَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 17441","","","كتاب النكاح"
"17442","(۱۷۴۴۲) حدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ خُصَیْفٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {وَلاَ تُمْسِکُوا بِعِصَمِ الْکَوَافِرِ} قَالَ : إذَا لَحِقَتِ امْرَأَۃُ الْمُسْلِمِ بِالْمُشْرِکِینَ لَمْ یُعْتَدَّ بِہَا مِنْ نِسَائِہِ۔","","Musannaf Ibn Abi Shaybah 17442","","","كتاب النكاح"
"17443","(۱۷۴۴۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 17443","","","كتاب النكاح"
"17444","(۱۷۴۴۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِعَبْدِ الرَّحْمَنِ بن عوف : أَوْلِمْ وَلَوْ بِشَاۃٍ یَعْنِی ، حِینَ تَزَوَّجَ۔ (بخاری ۲۰۴۹۔ ابوداؤد ۲۱۰۲)","Sahih","Musannaf Ibn Abi Shaybah 17444","","","كتاب النكاح"
"17445","(۱۷۴۴۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ زُہَیْرٍ ، عَنْ بَیَانٍ ، قَالَ : سَمِعْتُ أَنَسًا یَقُولُ : بَنَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِامْرَأَۃٍ فَأَرْسَلَنِی فَدَعَوْتُ رِجَالاً إلَی الطَّعَامِ۔ (بخاری ۵۱۷۰۔ ترمذی ۳۲۱۹)","Sahih","Musannaf Ibn Abi Shaybah 17445","","","كتاب النكاح"
"17446","(۱۷۴۴۶) حَدَّثَنَا جَرِیرٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْحَکَمِ قَالَ : لَمَّا تَزَوَّجَ بِلاَلٌ أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِذَہَبٍ، قَالَ لِبِلاَلٍ : سُقْ ہَذَا ، ثُمَّ قَالَ : أَعِینُوا أَخَاکُمْ فِی وَلِیمَتِہِ۔ (ابوداؤد ۲۲۶۔ سعید بن منصور ۵۸۸)","","Musannaf Ibn Abi Shaybah 17446","","","كتاب النكاح"
"17447","(۱۷۴۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورِ بن صَفِیَّۃَ ، عَنْ أُمِّہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَوْلَمَ عَلَی بَعْضِ نِسَائِہِ بِمُدَّیْنِ مِنْ شَعِیرٍ۔ (نسائی ۶۶۰۷۔ احمد ۶/۱۱۳)","Sahih","Musannaf Ibn Abi Shaybah 17447","","","كتاب النكاح"
"17448","(۱۷۴۴۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ حَفْصَۃَ قَالَتْ : لَمَّا تَزَوَّجَ أَبِی : سِیرِینُ دَعَا أَصْحَابَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَبْعَۃَ أَیَّامٍ فَلَمَّا کَانَ یَوْمُ الأَنْصَارِ دَعَاہُمْ وَدَعَا أُبَیَّ بْنَ کَعْبٍ وَزَیْدَ بْنَ ثَابِتٍ قالَ ہِشَامٌ : وَأَظُنُّہُ قَالَ وَمُعَاذًا قَالَ : فَکَانَ أُبَیٌّ صَائِمًا فَلَمَّا طَعِمُوا دَعَا أُبَیّ بْنُ کَعْبٍ وَأَمَّنَ الْقَوْمُ۔","","Musannaf Ibn Abi Shaybah 17448","","","كتاب النكاح"
"17449","(۱۷۴۴۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ قَالَ : أَوْلَمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِزَیْنَبَ فَأَشْبَعَ الْمُسْلِمِینَ خُبْزًا وَلَحْمًا۔ (بخاری ۴۷۹۳۔ مسلم ۱۰۴۸)","Sahih","Musannaf Ibn Abi Shaybah 17449","","","كتاب النكاح"
"17450","(۱۷۴۵۰) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنِی مَالِکُ بْنَ دِینَارٍ قَالَ حَدَّثَتْنِی عَجُوزٌ مِنَ الْحَیِّ قَالَتْ : زَوَّجَ أَبُو مُوسَی الأَشْعَرِیُّ بَعْضَ بَنِیہِ قَالَتْ : فَأَوْلَمَ عَلَیْہِ فَدَعَا نَاسًا۔","Da'if","Musannaf Ibn Abi Shaybah 17450","","","كتاب النكاح"
"17451","(۱۷۴۵۱) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ قَالَ : کَانَ ابْنُ عُمَرَ یُطْعِمُ عَلَی خِتَانِ الصِّبْیَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 17451","","","كتاب النكاح"
"17452","(۱۷۴۵۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ أَبِی إسْرَائِیلَ، عَنِ الأَعْمَشِ أن أَبَا وَائِلٍ: أَوْلَمَ بِرَأْسِ بَقَرَۃٍ وَأَرْبَعَۃِ أَرْغِفَۃٍ۔","","Musannaf Ibn Abi Shaybah 17452","","","كتاب النكاح"
"17453","(۱۷۴۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ قَالَ : عَرَّسْتُ فِی عَہْدِ أَبِی فَآذَنَ أَبِی النَّاسَ ، وَکَانَ فِیمَنْ آذَنَ لأَبِی أَیُّوبَ۔","Hasan","Musannaf Ibn Abi Shaybah 17453","","","كتاب النكاح"
"17454","(۱۷۴۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ یُونُسَ الأَیْلِیِّ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ أَنَّ حَمْزَۃَ بْنَ عَبْدِ اللہِ بْنِ عُمَرَ نَحَرَ جَزُورًا۔","","Musannaf Ibn Abi Shaybah 17454","","","كتاب النكاح"
"17455","(۱۷۴۵۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُمَرَ بْنِ حَمْزَۃَ قَالَ : أَخْبَرَنِی سَالِمُ بْنُ عَبْدِ اللہِ قَالَ : خَتَنَنِی أَبِی أَنَا وَنُعَیْمَ بْنَ عَبْدِ اللہِ فَذَبَحَ عَلَیْنَا کَبْشًا وَلَقَدْ رَأَیْتُنَا نَجْدِلُ بِہِ عَلَی الْغِلْمَانِ۔","","Musannaf Ibn Abi Shaybah 17455","","","كتاب النكاح"
"17456","(۱۷۴۵۶) حدَّثَنَا حدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ قَالَ : کَانَ یقال : إِنَّ خَوْلَۃَ بِنْتَ حَکِیمٍ مِنَ اللاَّتِی وَہَبْنَ أَنْفُسَہُنَّ لِلنَّبِیِّ علیہ السلام۔ (بخاری ۵۱۱۳۔ مسلم ۵۰)","","Musannaf Ibn Abi Shaybah 17456","","","كتاب النكاح"
"17457","(۱۷۴۵۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ : {وَامْرَأَۃً مُؤْمِنَۃً إِنْ وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ} قَالَ : لم تَہَبْ نَفْسَہَا۔","","Musannaf Ibn Abi Shaybah 17457","","","كتاب النكاح"
"17458","(۱۷۴۵۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : کَتَبَ عَبْدُ الْمَلِکِ إلَی أَہْلِ الْمَدِینَۃِ یَسْأَلُہُمْ قَالَ : فَکَتَبَ إلَیْہِ عَلِیٌّ قَالَ شُعْبَۃُ : وَظَنِّی أَنَّہُ ابْنُ حُسَیْنٍ قَالَ : وَأَخْبَرَنِی أَبَانُ بْنُ تَغْلِبَ ، عَنِ الْحَکَمِ أَنَّہُ عَلِیُّ بْنُ حُسَیْنٍ قَالَ : ہِیَ امْرَأَۃٌ مِنَ الأَزْدِ یُقَالُ لَہَا أَمُّ شَرِیکٍ وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔n(نسائی ۸۹۲۸۔ احمد ۶/۴۶۲)","","Musannaf Ibn Abi Shaybah 17458","","","كتاب النكاح"
"17459","(۱۷۴۵۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : حَدَّثَنِی عَبْدُ اللہِ بْنُ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ أَنَّہَا امْرَأَۃٌ مِنَ الأَنْصَارِ وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ وَہِیَ مِمَّنْ أَرْجَأَ۔","","Musannaf Ibn Abi Shaybah 17459","","","كتاب النكاح"
"17460","(۱۷۴۶۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ قَالَ : وَحَدَّثَنِی أَہْلُ الْمَدِینَۃِ أَنَّہُمْ کَانُوا یَقُولُونَ لِلشَّیْئِ : لَہُوَ أَعْظَمُ نَحِیًّا مِنْ نَحِیِّ أُمِّ شَرِیکٍ۔","","Musannaf Ibn Abi Shaybah 17460","","","كتاب النكاح"
"17461","(۱۷۴۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ وَعُمَرَ بْنِ الْحَکَمِ ، وَعَبْدِ اللہِ بْنِ عُبَیدۃَ قَالُوا : الَّتِی وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَیْمُونَۃُ۔ (طبری ۲۳۔ بیہقی ۵۵)","Da'if","Musannaf Ibn Abi Shaybah 17461","","","كتاب النكاح"
"17462","(۱۷۴۶۲) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ وَرْقَائَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ : {وَامْرَأَۃً مُؤْمِنَۃً إِنْ وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ} قَالَ : بِغَیْرِ صَدَاقٍ۔","","Musannaf Ibn Abi Shaybah 17462","","","كتاب النكاح"
"17463","(۱۷۴۶۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : (وَامْرَأَۃً مُؤْمِنَۃً إِنْ وَہَبَتْ نَفْسَہَا لِلنَّبِیِّ) قَالَ : فَعَلَتْ وَلَمْ یَفْعَلْ۔","","Musannaf Ibn Abi Shaybah 17463","","","كتاب النكاح"
"17464","(۱۷۴۶۴) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَوْفٍ قَالَ : حدَّثَنَا أَشْیَاخُ عُمَرِیِین مِنْ جُلَسَائِ قَسَامَۃَ بْنِ زُہَیْرٍ أَنَّ ہَمَّامَ بْنَ عُمَیْرٍ رَجُلٌ مِنْ بَنِی تَیْمِ اللہِ کَانَ جَمَعَ بَیْنَ أُخْتَیْنِ فِی الْجَاہِلِیَّۃِ فَلَمْ یُفَرِّقْ بَیْنَ وَاحِدَۃٍ مِنْہُمَا حَتَّی کَانَ فِی خِلاَفَۃِ عُمَرَ وَأَنَّہُ رُفِعَ شَأْنُہُ إلَی عُمَرَ فَأَرْسَلَ إلَیْہِ ، فَقَالَ : اخْتَرْ إحْدَاہُمَا وَاللَّہِ لَئِنْ قَرَبْتِ الأُخْرَی لأَضْرِبَنَّ رَأْسَکَ۔","Da'if","Musannaf Ibn Abi Shaybah 17464","","","كتاب النكاح"
"17465","(۱۷۴۶۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : إذَا أَسْلَمَ وَعِنْدَہُ أُخْتَانِ حَبَسَ الأُولَی مِنْہُمَا إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 17465","","","كتاب النكاح"
"17466","(۱۷۴۶۶) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ بْنِ أَبِی فَرْوَۃَ ، عَنْ أَبِی وَہْبٍ الْجَیْشَانِیِّ ، عَنْ أَبِی خِرَاشٍ الرُّعَیْنِیِّ ، عَنِ الدَّیْلَمِیِّ قَالَ : قدِمْتُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَعِنْدِی أُخْتَانِ تَزَوَّجْتُہُمَا فِی الْجَاہِلِیَّۃِ ، فَقَالَ : إذَا رَجَعْت فَطَلِّقْ إحْدَاہُمَا۔ (ترمذی ۱۱۲۹۔ احمد ۴/۲۳۲)","Da'if","Musannaf Ibn Abi Shaybah 17466","","","كتاب النكاح"
"17467","(۱۷۴۶۷) حدَّثَنَا ابْنُ عُلَیَّۃَ وَمَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ قَالَ : أَسْلَمَ غَیْلاَنُ بْنُ سَلَمَۃ الثَّقَفِیُّ وَتَحْتَہُ عَشْرُ نِسْوَۃٍ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : خُذْ مِنْہُنَّ أَرْبَعًا۔n(دار قطنی ۲۷۱۔ بیہقی ۱۸۳)","","Musannaf Ibn Abi Shaybah 17467","","","كتاب النكاح"
"17468","(۱۷۴۶۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُسْلِمُ وَعِنْدَہُ عَشْرُ ، أَوْ سِتُّ نِسْوَۃٍ قَالَ : یُمْسِکُ مِنْہُنَّ أَرْبَعًا۔","","Musannaf Ibn Abi Shaybah 17468","","","كتاب النكاح"
"17469","(۱۷۴۶۹) حَدَّثَنَا بَکْرُ بْنُ عَبْدِ الرَّحْمَنِ قَالَ : حدَّثَنَا عِیسَی بْنُ الْمُخْتَارِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ حُمَیْضَۃَ بْنِ الشَّمَرْدَلِ ، عَنْ قَیْسِ بْنِ الْحَارِثِ الأَسَدِیِّ أَنَّہُ أَسْلَمَ وَعِنْدَہُ ثَمَانِ نِسْوَۃٍ فَأَمَرَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَخْتَارَ مِنْہُنَّ أَرْبَعًا۔ (ابوداؤد ۲۲۳۶۔ ابن ماجہ ۱۹۵۲)","Da'if","Musannaf Ibn Abi Shaybah 17469","","","كتاب النكاح"
"17470","(۱۷۴۷۰) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ فِی قَوْلِہِ : {غَیْرِ أُولِی الإِرْبَۃِ} قَالَ : الَّذِی لَمْ یَبْلُغْ أرْبُہُ أَنْ یَطَّلِعَ عَلَی عَوْرَۃِ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 17470","","","كتاب النكاح"
"17471","(۱۷۴۷۱) حَدَّثَنَا ابْنُ إدْرِیسَ أَظُنُّہُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ فِی قَوْلِہِ : {غَیْرِ أُولِی الإِرْبَۃِ} قَالَ : ہو الأَبْلَہُ الَّذِی لاَ یَعْرِفُ أَمْرَ النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 17471","","","كتاب النكاح"
"17472","(۱۷۴۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {غَیْرِ أُولِی الإِرْبَۃِ مِنَ الرِّجَالِ} قَالَ : الَّذِی لاَ أرب لہ بِالنِّسَائِ۔","","Musannaf Ibn Abi Shaybah 17472","","","كتاب النكاح"
"17473","(۱۷۴۷۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : الْمَعْتُوہُ۔","","Musannaf Ibn Abi Shaybah 17473","","","كتاب النكاح"
"17474","(۱۷۴۷۴) حدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّد ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : ہُوَ الَّذِی یَقُولُونَ : أَحْمَقُ","","Musannaf Ibn Abi Shaybah 17474","","","كتاب النكاح"
"17475","(۱۷۴۷۵) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ رَجُلٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ہُوَ الَّذِی لاَ تَسْتَحْیِی مِنْہُ النِّسَائُ۔","Da'if","Musannaf Ibn Abi Shaybah 17475","","","كتاب النكاح"
"17476","(۱۷۴۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَوْنٍ ، عَنْ عِکْرِمَۃَ قَالَ : ہُوَ الَّذِی لاَ یَقُومُ إرْبُہُ۔","","Musannaf Ibn Abi Shaybah 17476","","","كتاب النكاح"
"17477","(۱۷۴۷۷) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ قَالَ : فَرَّقَ عُمَرُ بْنُ الْخَطَّابِ بَیْنَہُمَا وَجَعَلَ صَدَاقَہَا فِی بَیْتِ الْمَالِ وَقَالَ الزُّہْرِیُّ : لَمْ یَکُنْ صَدَاقُہَا فِی بَیْتِ الْمَالِ ، ہُوَ بِمَا أَصَابَ مِنْ فَرْجِہَا۔","","Musannaf Ibn Abi Shaybah 17477","","","كتاب النكاح"
"17478","(۱۷۴۷۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ صَالِحِ بْنِ مُسْلِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عُمَرُ : یُفَرَّقُ بَیْنَہُمَا وَیُجعَلُ صَدَاقَہَا فِی بَیْتِ الْمَالِ وَقَالَ عَلِی : یُفَرَّقُ بَیْنَہُمَا وَلَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا۔","","Musannaf Ibn Abi Shaybah 17478","","","كتاب النكاح"
"17479","(۱۷۴۷۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیِّبِ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَلَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا۔","","Musannaf Ibn Abi Shaybah 17479","","","كتاب النكاح"
"17480","(۱۷۴۸۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَیُلْقَی الصَّدَاقُ فِی بَیْتِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 17480","","","كتاب النكاح"
"17481","(۱۷۴۸۱) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : کُلُّ نِکَاحٍ فَاسِدٍ نَحْوَ الَّذِی تُزَوَّجُ فِی عِدَّتِہَا وَأَشْبَاہِہِ ، ہَذَا مِنَ النِّکَاحِ الْفَاسِدِ إذَا کَانَ قَدْ دَخَلَ بِہَا فَلَہَا الصَّدَاقُ وَیُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17481","","","كتاب النكاح"
"17482","(۱۷۴۸۲) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ أَنَّہُ قَالَ : یُفَرَّقُ بَیْنَہَا وَبَیْنَ زَوْجِہَا وَیَکُونُ لَہَا الْمَہْرُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا۔","","Musannaf Ibn Abi Shaybah 17482","","","كتاب النكاح"
"17483","(۱۷۴۸۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ قَالَ : قضَی عُمَرُ فِی امْرَأَۃٍ تَزَوَّجَتْ فِی عِدَّتِہَا أَنْ یُفَرَّقَ بَیْنَہُمَا مَا عَاشَا وَیُجْعَلُ صَدَاقُہَا فِی بَیْتِ الْمَالِ وَقَالَ : کَانَ نِکَاحُہَا حَرَامًا فَصَدَاقُہَا حَرَامًا ، وَقَضَی فِیہَا عَلِیٌّ أَنْ یُفَرَّقَ بَیْنَہُمَا وَتُوَفِّیَ عِدَّۃَ مَا بَقِیَ مِنَ الزَّوْجِ الأَوَّلِ ثُمَّ تَعْتَدُّ ثَلاَثَۃَ قُرُوئٍ وَلَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا ثُمَّ إِنْ شَائَ خَطَبَہَا بَعْدَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17483","","","كتاب النكاح"
"17484","(۱۷۴۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَبْدِ اللہِ بْنِ حَبِیبٍ قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَقِیَ امْرَأَۃً فَأَعْجَبَتْہُ فَرَجَعَ إلَی أُمِّ سَلَمَۃَ وَعِنْدَہَا نِسْوَۃٌ یَدُفن طِیبًا قَالَ : فَعَرَفْنَ فِی وَجْہِہِ فَأَخْلَیْنَہُ فَقَضَی حَاجَتَہُ فَخَرَجَ ، فَقَالَ : مَنْ رَأَی مِنْکُمُ امْرَأَۃً فَأَعْجَبَتْہُ فَلِیَأْتِ أَہْلَہُ فَلْیُوَاقِعْہَا فَإِنَّ مَعَہَا مِثْلُ الَّذِی مَعَہَا۔ (مسلم ۹)","","Musannaf Ibn Abi Shaybah 17484","","","كتاب النكاح"
"17485","(۱۷۴۸۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ عَبْدِ اللہِ بْنِ حَبِیبٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِ حَدِیثِ أَبِی حَصِینٍ إلاَّ إِنَّہُ لَمْ یَذْکُرْ : یَدُفْنَ طِیبًا۔","","Musannaf Ibn Abi Shaybah 17485","","","كتاب النكاح"
"17486","(۱۷۴۸۶) حَدَّثَنَا وَکِیعٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ حُلاَّمٍ قَالَ قَالَ عَبْدُ اللہِ : مَنْ رَأَی مِنْکُمُ امْرَأَۃً فَأَعْجَبَتْہُ فَلْیُوَاقِع أَہْلَہُ فَإِنَّ مَعَہُنَّ مِثْلَ الَّذِی مَعَہُنَّ۔ (دارمی ۲۲۱۵)","Da'if","Musannaf Ibn Abi Shaybah 17486","","","كتاب النكاح"
"17487","(۱۷۴۸۷) حَدَّثَنَا عَبِیدَۃُ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی امْرَأَۃً ، فَأَتَی أُمَّ سَلَمَۃَ فَوَاقَعَہَا وَقَالَ : إذَا رَأَی أحدکم امْرَأَۃً تُعْجِبُہُ فَلْیَأْتِ أَہْلَہُ فَإِنَّ مَعَہُنَّ مِثْلَ الَّذِی مَعَہُنَّ۔","","Musannaf Ibn Abi Shaybah 17487","","","كتاب النكاح"
"17488","(۱۷۴۸۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیرِ ، عَنْ جَابِرٍ بِنَحْوِ حَدِیثِ عَبْدِ اللہِ۔n(مسلم۹۔ ابوداؤد ۲۱۴۴)","Da'if","Musannaf Ibn Abi Shaybah 17488","","","كتاب النكاح"
"17489","(۱۷۴۸۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ مُطَرِّفٍ فِی الرَّجُلِ یَرَی الْمَرْأَۃَ تُعْجِبُہُ قَالَ : یَذْکُرُ أَخْسَائَ الْبَقَرِ۔","","Musannaf Ibn Abi Shaybah 17489","","","كتاب النكاح"
"17490","(۱۷۴۹۰) حَدَّثَنَا زید بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلِ یَرَی الْمَرْأَۃَ فتعجبہ قَالَ : یَذْکُرُ مَنَاتِنہَا۔","","Musannaf Ibn Abi Shaybah 17490","","","كتاب النكاح"
"17491","(۱۷۴۹۱) حدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، قَالَ : سَمِعْتُ النَّخَعِیّ قَالَ : تَزَوَّجَ الأَشْعَثُ امْرَأَۃً عَلَی حُکْمِہَا فَرُفِعَ إلَی عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ : أَرْضِہَا أَرْضِہَا۔","","Musannaf Ibn Abi Shaybah 17491","","","كتاب النكاح"
"17492","(۱۷۴۹۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : إذا تَزَوَّجَ الرَّجُلُ الْمَرْأَۃَ عَلَی حُکْمِہَا ، أَوْ حُکْمِہِ فَجَارٍ فِی الصَّدَاقِ أو جَارُوا رُدَّ ذَاکَ إلَی صَدَاقِ مِثْلِہَا لاَ وَکْسَ وَلاَ شَطَطَ وَالنِّکَاحُ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 17492","","","كتاب النكاح"
"17493","(۱۷۴۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہِلاَلٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ قَالَ : خَطَبَ عَمْرُو بْنُ حُرَیْثٍ إلَی عَدِیِّ بْنِ حَاتِمٍ ابْنَتَہُ فَأَبَی إلاَّ عَلَی حُکْمِہِ فَرَجَعَ عَمْرٌو فَاسْتَشَارَ أَصْحَابَہُ فَقَالُوا : أَتُرِیدُ أَنْ تُحَکِّمَ رَجُلاً مِنْ طیئٍ فِی عَقْدِکَ فَأَبَتْ نَفْسُہُ فَتَزَوَّجَہَا عَلَی حُکْمِہِ ثُمَّ انْصَرَفَ فَحَکَّمَ عَدِیٌّ سُنَّۃَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَمَانِینَ وَأَرْبَعِ مِئَۃٍ ، فَبَعَثَ إلَیْہِ عَمْرٌو بِعَشَرَۃِ آلاَفٍ وَقَالَ : جَہِّزْہَا۔","","Musannaf Ibn Abi Shaybah 17493","","","كتاب النكاح"
"17494","(۱۷۴۹۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ أَنَّ الأَشْعَثَ تَزَوَّجَ امْرَأَۃً عَلَی حُکْمِہَا فَسَأَلَہُ عُمَرُ عَنْہَا ، فَقَالَ : بِتُّ لَیْلَۃً لاَ یَعْلَمُہَا إلاَّ اللَّہُ مَخَافَۃَ أَنْ تَحْکُمَ عَلَیَّ فِی مَالِ قَیْسٍ ، فَقَالَ : لَیْسَ ذَلِکَ لَہَا إنَّمَا لَہَا مَہْرُ نِسَائِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17494","","","كتاب النكاح"
"17495","(۱۷۴۹۵) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی حُکْمِہِ فَمَاتَتِ الْمَرْأَۃُ قَبْلَ أَنْ یَحْکُمَ الرَّجُلُ قَالَ : لَہَا صَدَاقُ نِسَائِہَا۔","","Musannaf Ibn Abi Shaybah 17495","","","كتاب النكاح"
"17496","(۱۷۴۹۶) حَدَّثَنَا یَعْلَی ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی حُکْمِہِ فَحَکَمَ عَشَرَۃَ دَرَاہِمَ قَالَ : یَجُوزُ ، قَدْ کَانَ الْمُسْلِمُونَ یَتَزَوَّجُونَ عَلَی أَقَلَّ مِنْ ذَلِکَ وَأَکْثَرَ۔","","Musannaf Ibn Abi Shaybah 17496","","","كتاب النكاح"
"17497","(۱۷۴۹۷) حَدَّثَنَا حُمَیْدُ بنُ عَبْدِ الرَّحْمَنِ ، عَنِ السَّرِیِّ بْنِ یَحْیَی ، عَنِ الْحَسَنِ قَالَ : قَالَ رَجُلٌ لآخَرَ : بِالرِّفَائِ والبَنِیْنَ، فَقَالَ رَسُوْلَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَقُوْلُوْا ہَکَذَا قُوْلُوْا : بَارَکَ اللَّہُ فِیْکَ وَبَارَکَ عَلَیْکَ۔","Hasan","Musannaf Ibn Abi Shaybah 17497","","","كتاب النكاح"
"17498","(۱۷۴۹۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّ عَقِیلَ بْنَ أَبِی طَالِبٍ تَزَوَّجَ امْرَأَۃً مِنْ بَنِی جُشَمٍ فَدَعَاہُمْ فَقَالُوا : بِالرِّفَائِ وَالبَنِیْنَ ، فَقَالَ : لاَ تَقُوْلُوْا ذَاکَ : قَالُوا : کَیْفَ نَقُوْلُ یَا أَبَا یَزِیْدٍ ؟ قَالَ : تَقُوْلُوْنَ : بَارَکَ اللَّہُ لَکَ وَبَارَکَ عَلَیْکَ فَإنَّا کُنَّا نَقُوْلُ ، أَوْ نُؤْمَرُ بِذَلِکَ۔ (ابن ماجہ ۱۹۰۶۔ احمد ۱/۴۵۱)","Hasan","Musannaf Ibn Abi Shaybah 17498","","","كتاب النكاح"
"17499","(۱۷۴۹۹) حدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ بْنِ عُبَیْدٍ ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، عَنْ أَبِی زُرْعَۃَ بْنِ عَمْرٍو ، عَنْ جَرِیرٍ قَالَ: سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ نَظْرَۃِ الْفُجَائَۃِ فَأَمَرَنِی أَنْ أَصْرِفَ بَصَرِی۔n(مسلم ۱۶۹۹۔ ابوداؤد ۲۱۴۱)","Sahih","Musannaf Ibn Abi Shaybah 17499","","","كتاب النكاح"
"17500","(۱۷۵۰۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنِ الْعَلاَئِ بْنِ زِیَادٍ قَالَ : کَانَ یُقَالُ : لاَ تُتْبِعَنَّ نَظَرَکَ حُسْنَ رِدَائِ امْرَأَۃٍ فَإِنَّ النَّظَرَ یَجْعَلُ شَہْوَۃً فِی الْقَلْبِ۔","","Musannaf Ibn Abi Shaybah 17500","","","كتاب النكاح"
"17501","(۱۷۵۰۱) حَدَّثَنَا جَرِیرٌ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنِ الشَّعْبِیِّ قَالَ : (قُلْ لِلْمُؤْمِنِینَ یَغُضُّوا مِنْ أَبْصَارِہِمْ) قُلْتُ لِلشَّعْبِیِّ : الرَّجُلُ یَنْظُرُ الْمَرْأَۃَ لاَ یَرَی مِنْہَا مُحَرَّمًا قَالَ : مَا لَکَ أَنْ تثقبہا بِعَیْنِکَ ؟۔","","Musannaf Ibn Abi Shaybah 17501","","","كتاب النكاح"
"17502","(۱۷۵۰۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ قَالَ : نَظْرَۃٌ یَہْوَاہَا الْقَلْبُ فَلاَ خَیْرَ فِیہَا۔","","Musannaf Ibn Abi Shaybah 17502","","","كتاب النكاح"
"17503","(۱۷۵۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ أَبِی رَبِیعَۃَ الإِیَادِیِّ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ لِعَلِیٍّ : لاَ تُتْبِعِ النَّظْرَۃَ النَّظْرَۃَ فَإِنَّمَا لَکَ الأُولَی وَلَیْسَ لَکَ الآخِرَۃُ۔(ترمذی ۲۷۷۷۔ ابوداؤد ۲۱۴۲)","Da'if","Musannaf Ibn Abi Shaybah 17503","","","كتاب النكاح"
"17504","(۱۷۵۰۴) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ مُوسَی الْجُہَنِیِّ قَالَ : کُنْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ فِی طَرِیقٍ فَاسْتَقْبَلَتْنَا امْرَأَۃٌ أو جاریۃ قَالَ : فَنَظَرْنَا إلَیْہَا جَمِیعًا قَالَ ثُمَّ إنَّ سَعِیدًا غَضَّ بَصَرَہُ فَنَظَرْتُ أنا ، قَالَ : فَقَالَ لِی سَعِیدٌ : الأُولَی لَکَ وَالثَّانِیَۃُ عَلَیْکَ۔","","Musannaf Ibn Abi Shaybah 17504","","","كتاب النكاح"
"17505","(۱۷۵۰۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ ، عَنْ قَیْسٍ قَالَ : کَانَ یُقَالُ : النَّظْرَۃُ الأُولَی لاَ یَمْلِکُہَا أَحَدٌ وَلَکِنِ الَّذِی یَدُسُّ النَّظَرَ دَسًّا۔","","Musannaf Ibn Abi Shaybah 17505","","","كتاب النكاح"
"17506","(۱۷۵۰۶) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ دَاوُدَ أَبِی الہیثم قَالَ قَالَ رَجُلٌ لاِِبْنِ سِیرِینَ : أَسْتَقْبِلُ الْقِبْلَۃَ فِی الطَّرِیقِ أَلَیْسَ لِی النَّظْرَۃُ الأُولَی ثُمَّ أَصْرِفُ عَنْہَا بَصَرِی ؟ قَالَ : أَمَا تَقْرَأُ الْقُرْآنَ : {یَغُضُّوا مِنْ أَبْصَارِہِمْ} {یَعْلَمُ خَائِنَۃَ الأَعْیُنِ، وَمَا تُخْفِی الصُّدُورُ}۔","","Musannaf Ibn Abi Shaybah 17506","","","كتاب النكاح"
"17507","(۱۷۵۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ خَالِدِ بْنِ مَحدُوجٍ ، قَالَ : سَمِعْتُ أَنَسًا یَقُولُ : إذَا لَقِیتَ الْمَرْأَۃَ فَغُضَّ عَیْنَیکَ حَتَّی تَمْضِیَ۔","Da'if","Musannaf Ibn Abi Shaybah 17507","","","كتاب النكاح"
"17508","(۱۷۵۰۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ قَالَ : لاَ یَضُرُّک حُسْنُ امْرَأَۃٍ مَا لَمْ تَعْرِفْہَا۔","","Musannaf Ibn Abi Shaybah 17508","","","كتاب النكاح"
"17509","(۱۷۵۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ عَمْرِو بْنِ سَعِیدٍ ، قَالَ : قَالَ سَعْدُ بْنُ أَبِی وَقَّاصٍ : بَیْنَا أَنَا أَطُوفُ بِالْبَیْتِ إذْ رَأَیْتُ امْرَأَۃً فَأَعْجَبَنِی دَلُّہَا فَأَرَدْتُ أَنْ أَسْأَلَ عَنْہَا فَوَجَدْتُہَا مَشْغُولَۃً وَلاَ یَضُرُّکَ حُسْنُ امْرَأَۃٍ مَا لَمْ تَعْرِفْہَا۔","","Musannaf Ibn Abi Shaybah 17509","","","كتاب النكاح"
"17510","(۱۷۵۱۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ طَاوُوسٍ أَنَّہُ کَرِہَ أَنْ یَنْظُرَ الرَّجُلُ إلَی الْمَرْأَۃِ إلاَّ أَنْ یَکُونَ زَوْجًا ، أَوْ ذَا مَحْرَمٍ۔","","Musannaf Ibn Abi Shaybah 17510","","","كتاب النكاح"
"17511","(۱۷۵۱۱) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : أَخْبَرَنِی أَبُو عُمَیْرٍ ، عَنْ أَیُّوبَ قَالَ : کَانَ طَاوُوسٌ لاَ یَصْحَبُ رُفْقَۃً فِیہَا امْرَأَۃٌ۔","","Musannaf Ibn Abi Shaybah 17511","","","كتاب النكاح"
"17512","(۱۷۵۱۲) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ ، عَنْ سَلَمَۃَ بْنِ أَبِی طُفَیْلٍ ، عَنْ عَلِیٍّ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : یَا عَلِیُّ ، إنَّ لَکَ کَنْزًا فِی الْجَنَّۃِ وَإِنَّکَ ذُو قَرْنَیْہَا فَلاَ تُتْبِعِ النَّظْرَۃَ النَّظْرَۃَ فَإِنَّمَا لَکَ الأُولَی وَلَیْسَتْ لَکَ الآخِرَۃُ۔ (احمد ۱/۱۵۹۔ دارمی ۲۷۰۹)","Da'if","Musannaf Ibn Abi Shaybah 17512","","","كتاب النكاح"
"17513","(۱۷۵۱۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : {یَعْلَمُ خَائِنَۃَ الأَعْیُنِ ، وَمَا تُخْفِی الصُّدُورُ} قَالَ : الرَّجُلُ یَکُونُ فِی الْقَوْمِ فَتَمُرُّ بِہِمُ الْمَرْأَۃُ فَیُرِیہِمْ أَنَّہُ یَغُضُّ بَصَرَہُ عَنْہَا فَإِنْ رَأَی مِنْہُمْ غَفَلَۃً نَظَرَ إلَیْہَا فَإِنْ خَافَ أَنْ یَفْطَنُوا بِہِ غَضَّ بَصَرَہُ وَقَدِ اطَّلَعَ اللَّہُ مِنْ قَلْبِہِ أَنَّہُ وَدَّ أَنَّہُ نَظَرَ إلَی عَوْرَتِہَا۔","","Musannaf Ibn Abi Shaybah 17513","","","كتاب النكاح"
"17514","(۱۷۵۱۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : قَالَ أَبُو مُوسَی : لأَنْ تَمْتَلِئَ مَنْخِرَیَّ مِنْ رِیحِ جِیفَۃٍ أَحَبُّ إلَیَّ مِنْ أَنْ تَمْتَلِئَا مِنْ رِیحِ امْرَأَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 17514","","","كتاب النكاح"
"17515","(۱۷۵۱۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : لأَنْ أُزَاحِمَ بَعِیرًا مَطْلِیًّا بِقَطِرَانٍ أَحَبُّ إلَیَّ مِنْ أَنْ أُزَاحِمَ امْرَأَۃً۔","","Musannaf Ibn Abi Shaybah 17515","","","كتاب النكاح"
"17516","(۱۷۵۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَابِتِ بْنِ عُمَارَۃَ ، عَنْ غُنَیْمِ بْنِ قَیْسٍ ، عَنْ أَبِی مُوسَی قَالَ : کُلُّ عَیْنٍ فَاعِلَۃٌ یَعْنِی زَانِیَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 17516","","","كتاب النكاح"
"17517","(۱۷۵۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ تَطْلِیقَۃً ، أَوْ تَطْلِیقَتَیْنِ قَبْلَ أَنْ یَدْخُلَ بِہَا ثُمَّ غَشِیَہَا وَہُوَ یَرَی أَنَّ لَہُ عَلَیْہَا رَجْعَۃً قَالَ : لَہَا الصَّدَاقُ وَیُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17517","","","كتاب النكاح"
"17518","(۱۷۵۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ، ثُمَّ غَشِیَہَا وَہُوَ یَرَی أَنَّ لَہُ عَلَیْہَا رَجْعَۃً قَالَ : لَہَا الصَّدَاقُ کَامِلاً لِغِشْیَانِہِ إیَّاہَا۔","","Musannaf Ibn Abi Shaybah 17518","","","كتاب النكاح"
"17519","(۱۷۵۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ عن مَطَرٍ ، عَنِ الْحَکَمِ قَالَ : لَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17519","","","كتاب النكاح"
"17520","(۱۷۵۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : لَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17520","","","كتاب النكاح"
"17521","(۱۷۵۲۱) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَہَا صَدَاقٌ وَنِصْفُ۔","","Musannaf Ibn Abi Shaybah 17521","","","كتاب النكاح"
"17522","(۱۷۵۲۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا وَاحِدَۃً ثُمَّ غَشِیَہَا وَہُوَ یَرَی أَنَّ لَہُ عَلَیْہَا الرَّجْعَۃَ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَلَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17522","","","كتاب النكاح"
"17523","(۱۷۵۲۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ: لَہَا صَدَاقٌ وَنِصْفٌ وَقَالَ الْحَکَمُ: لَہَا الصَّدَاقُ۔","","Musannaf Ibn Abi Shaybah 17523","","","كتاب النكاح"
"17524","(۱۷۵۲۴) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ الْمُثَنَّی ، عَنْ عَطَائٍ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ثَلاَثًا وَجَہِلَ فَأَصَابَہَا قَالَ : لَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17524","","","كتاب النكاح"
"17525","(۱۷۵۲۵) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عَطَائٍ قَالَ : لَہَا صَدَاقٌ وَنِصْفٌ۔","","Musannaf Ibn Abi Shaybah 17525","","","كتاب النكاح"
"17526","(۱۷۵۲۶) حَدَّثَنَا حَفْصٌ ، عَنْ مِسْعَرٍ ، عَنْ حَمَّادٍ قَالَ : صَدَاقٌ وَنِصْفُ۔","","Musannaf Ibn Abi Shaybah 17526","","","كتاب النكاح"
"17527","(۱۷۵۲۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَبِیبٍ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : سُئِلَ عَمَّنْ تَزَوَّجَ امْرَأَۃً فَطَلَّقَہَا قَبْلَ أَنْ یَمَسَّہَا ثُمَّ قِیلَ لَہُ : إنَّہَا لَمْ تَحْرُمْ عَلَیْکَ فَدَخَلَ بِہَا بِالنِّکَاحِ الأَوَّلِ فَمَکَثَتْ عِنْدَہُ سَنَتَیْنِ فَوَلَدَتْ لَہُ أَوْلاَدًا فَعَلِمَ بِذَلِکَ أَنَّہَا عَلَیْہِ حَرَامٌ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَیُعْطِی الْمَرْأَۃَ بِنِکَاحِہَا الأَوَّلِ نِصْفَ مَہْرِہَا ومن دُخُولِہِ بِہَا وَمُجَامَعَتِہِ إیَّاہَا مَہْرًا کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17527","","","كتاب النكاح"
"17528","(۱۷۵۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : لَہَا الصَّدَاقُ۔","","Musannaf Ibn Abi Shaybah 17528","","","كتاب النكاح"
"17529","(۱۷۵۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَہَا صَدَاقٌ وَنِصْفُ۔","","Musannaf Ibn Abi Shaybah 17529","","","كتاب النكاح"
"17530","(۱۷۵۳۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ وَمِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ أَنَّ أَمَۃً أُعْتِقَتْ فَاخْتَارَتْ نَفْسَہَا قَبْلَ أَنْ یُدْخَلَ بِہَا قَالَ : لاَ شَیْئَ لَہَا ، لاَ یُجْمَعُ عَلَیْہِ أَمْرٌ یَذْہَبُ بِنَفْسِہَا وَمَالِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 17530","","","كتاب النكاح"
"17531","(۱۷۵۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : إذَا أُعْتِقَتِ الأَمَۃُ وَہِیَ تَحْتَ الْعَبْدِ فَخُیِّرَتْ فَاخْتَارَتْ نَفْسَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا فَلاَ صَدَاقَ لَہَا وَہِیَ تَطْلِیقَۃٌ بَائِنَۃٌ۔","","Musannaf Ibn Abi Shaybah 17531","","","كتاب النكاح"
"17532","(۱۷۵۳۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ تزَوَّجَ أَمَتَہُ عَلَی مَہْرٍ مُسَمًّی ثُمَّ أَعْتَقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا زَوْجُہَا فَتُخَیَّرُ فَتَخْتَارُ نَفْسَہَا قَالَ : یَبْطُلُ النِّکَاحُ وَیُرَدُّ عَلَی الزَّوْجِ مَہْرُہُ۔","","Musannaf Ibn Abi Shaybah 17532","","","كتاب النكاح"
"17533","(۱۷۵۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا اخْتَارَتْ نَفْسَہَا وَقَدْ أُعْتِقَتْ قَبْلَ أَنْ یَدْخُلَ بِہَا فَلاَ صَدَاقَ لَہَا۔","","Musannaf Ibn Abi Shaybah 17533","","","كتاب النكاح"
"17534","(۱۷۵۳۴) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ ہِشَامٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ قَالَ : لاَ شَیْئَ لَہَا۔","","Musannaf Ibn Abi Shaybah 17534","","","كتاب النكاح"
"17535","(۱۷۵۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : لاَ یَسَعُہَا أَنْ تَقَارَّہُ حَتَّی تُرَافِعَہُ إلَی السُّلْطَانِ فَإِمَّا حَدٌّ وَإِمَّا مُلاَعَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 17535","","","كتاب النكاح"
"17536","(۱۷۵۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا أکْذَبَ نَفْسَہُ عِنْدَ رَہْطٍ تَسَاکَنَا وَاسْتَغْفَرَ رَبَّہُ وَلاَ یَعُودُ لِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17536","","","كتاب النكاح"
"17537","(۱۷۵۳۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا قَذَفَہَا بِالزِّنَا إِنْ شَائَ أَکْذَبَ نَفْسَہُ وَجُلِدَ وَرُدَّتْ إلَیْہِ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 17537","","","كتاب النكاح"
"17538","(۱۷۵۳۸) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنِ الشَّعْبِیِّ فِی الرَّجُلِ یَقْذِفُ امْرَأَتَہُ بِالزِّنَا ثُمَّ لاَ تُرَافِعُہُ قَالَ : یُکَذِّبُ نَفْسَہُ وَہُمَا عَلَی نِکَاحِہِمَا۔","","Musannaf Ibn Abi Shaybah 17538","","","كتاب النكاح"
"17539","(۱۷۵۳۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ قَالَ لَہَا نِصْفُ الصَّدَاقِ وَلاَ مِیرَاثَ لَہَا ، وَلاَ عِدَّۃَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17539","","","كتاب النكاح"
"17540","(۱۷۵۴۰) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 17540","","","كتاب النكاح"
"17541","(۱۷۵۴۱) حَدَّثَنَا عَبْدَۃُ وَمُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَہَا نِصْفُ الصَّدَاقِ وَلاَ مِیرَاثَ لَہَا وَلاَ عِدَّۃَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17541","","","كتاب النكاح"
"17542","(۱۷۵۴۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ أَنَّہُ کَانَ یَقُولُ : إذَا طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا وَہُوَ مَرِیضٌ فَإِنَّہَا لاَ تَرِثُہُ وَلاَ عِدَّۃَ عَلَیْہَا وَلَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17542","","","كتاب النكاح"
"17543","(۱۷۵۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ أَنَّہُ قَالَ : لَہَا الصَّدَاقُ کَامِلاً وَلاَ مِیرَاثَ لَہَا وَلاَ عِدَّۃَ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17543","","","كتاب النكاح"
"17544","(۱۷۵۴۴) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّہُ کَانَ یَقُولُہُ۔","","Musannaf Ibn Abi Shaybah 17544","","","كتاب النكاح"
"17545","(۱۷۵۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ قَالَ : لَہَا الصَّدَاقُ کَامِلاً وَلَہَا الْمِیرَاثُ وَعَلَیْہَا الْعِدَّۃُ۔","","Musannaf Ibn Abi Shaybah 17545","","","كتاب النكاح"
"17546","(۱۷۵۴۶) حَدَّثَنَا جَرِیرٌ ، عَنِ الْمُغِیرَۃِ ، عَنِ الْحَارِثِ قَالَ : إذَا طَلَّقَ امْرَأَتَہُ فِی مَرَضِہِ ثَلاَثًا ، أَوْ تَطْلِیقَۃً قَبْلَ أَنْ یَدْخُلَ بِہَا فَلاَ مِیرَاثَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17546","","","كتاب النكاح"
"17547","(۱۷۵۴۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ قَالَ : إذَا طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا فَلاَ مِیرَاثَ لَہَا۔","","Musannaf Ibn Abi Shaybah 17547","","","كتاب النكاح"
"17548","(۱۷۵۴۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سَیْفٍ ، عَنِ ابْنِ أَبِی نُجَیْحٍ ، عَنْ مُجَاہِدٍ أَنَّہُ کَرِہَ أَنْ یَتَزَوَّجَ الرَّجُلُ امْرَاَۃَ زَوْجِ أُمِّہِ قَالَ : وَکَانَ طَاوُوْسٌ وَعَطَاء لاَ یَرَیَانِ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 17548","","","كتاب النكاح"
"17549","(۱۷۵۴۹) حَدَّثَنَا وَکِیْعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ قَالَ : لاَ بَأسَ أَنْ یَتَزَوَّجَ الرَّجُلُ امْرَاَۃَ زَوْجِ أُمِّہِ۔","","Musannaf Ibn Abi Shaybah 17549","","","كتاب النكاح"
"17550","(۱۷۵۵۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَبِیبِ بْنُ أَبِی حَبِیبٍ ، عَنْ عَمْرِو بنِ ہَرِمٍ ، عَنْ جَابِرٍ بْنِ زَیْدٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : لاَ تُزَاحِمْ مَنْ زَاحَمَ أَبُوکَ ، زَوْجَ أُمِّکَ۔","Hasan","Musannaf Ibn Abi Shaybah 17550","","","كتاب النكاح"
"17551","(۱۷۵۵۱) حدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ فِی الْمَرْأَۃِ تَزَوَّج وَلَہَا زَوْجٌ قَالَ : إِنْ جَائَتْ بِہِ وَہُوَ یَشُکُّ فِیْہِ فَہُوَ للأَوَّلِ ، وَإِنْ جَائَتْ بِہِ وَہُوَ لاَ یَشُکُّ فِیْہِ فَہُوَ لِلآخَرِ۔","","Musannaf Ibn Abi Shaybah 17551","","","كتاب النكاح"
"17552","(۱۷۵۵۲) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ وَتَزَوَّجَہَا آخَرٌ فی عدتہا وَقَدْ حَاضَتْ حَیْضَۃً : الوَلَدُ لِلآخَرِ۔","","Musannaf Ibn Abi Shaybah 17552","","","كتاب النكاح"
"17553","(۱۷۵۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ مُجَاہِدٍ قَالَ : إذَا قَبَّلَہَا ، أَوْ لَمَسَہَا ، أَوْ نَظَرَ إلَی فَرْجِہَا حَرُمَتْ عَلَیْہِ ابْنَتُہَا۔","","Musannaf Ibn Abi Shaybah 17553","","","كتاب النكاح"
"17554","(۱۷۵۵۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا قَبَّلَ الأُمَّ لَمْ تَحِلَّ لَہُ ابْنَتُہَا وَإِذَا قَبَّلَ ابْنَتَہَا لَمْ تَحِلَّ لَہُ أُمُّہَا۔","","Musannaf Ibn Abi Shaybah 17554","","","كتاب النكاح"
"17555","(۱۷۵۵۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یُقَبِّلُ الْمَرْأَۃَ ، أَوْ یَلْمِسُہَا ، أَوْ یَأْتِیہَا فِی غَیْرِ فَرْجِہَا ، إِنْ شَائَ تَزَوَّجَہَا ، وَإِنْ شَائَ تَزَوَّجَ ابْنَتَہَا ، وَإِنْ کَانَتِ الْبِنْتَ ، تَزَوَّجَ الأُمَّ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 17555","","","كتاب النكاح"
"17556","(۱۷۵۵۶) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ وَأَبِی ہَاشِمٍ قَالاَ : فِی الرَّجُلِ یُقَبِّلُ أم امْرَأتہ ، أَوِ ابْنَتَہَا ، قَالاَ : حَرُمَتْ عَلَیْہِ امرأتہ۔","","Musannaf Ibn Abi Shaybah 17556","","","كتاب النكاح"
"17557","(۱۷۵۵۷) حَدَّثَنَا شَرِیکٌ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی مَالِکٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ یَنْظُرَ الْمَمْلُوکُ إلَی شَعْرِ مَوْلاَتِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 17557","","","كتاب النكاح"
"17558","(۱۷۵۵۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تَضَعَ الْمَرْأَۃُ ثَوْبَہَا عِنْدَ مَمْلُوکِہَا ، وَإِنْ کَانَ یُکْرَہُ أَنْ یَرَی شَعْرَہَا۔","","Musannaf Ibn Abi Shaybah 17558","","","كتاب النكاح"
"17559","(۱۷۵۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ أَنَّہُمَا کَرِہَا أَنْ یَرَی الْعَبْدُ شَعْرَ مَوْلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 17559","","","كتاب النكاح"
"17560","(۱۷۵۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : تَسْتَتِرُ الْمَرْأَۃُ مِنْ غُلاَمِہَا۔","","Musannaf Ibn Abi Shaybah 17560","","","كتاب النكاح"
"17561","(۱۷۵۶۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ طَارِقٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لاَ تَغُرَّنَّکُمْ ہَذِہِ الآیَۃُ : {إلاَّ مَا مَلَکَتْ أَیْمَانُکُمْ} إنَّمَا عَنَی بِہَا الإِمَائَ وَلَمْ یَعْنِ بِہَا الْعَبِیدَ۔","","Musannaf Ibn Abi Shaybah 17561","","","كتاب النكاح"
"17562","(۱۷۵۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ أَنَّہُ کَرِہَ أَنْ یَدْخُلَ الْمَمْلُوکُ عَلَی مَوْلاَتِہِ بِغَیْرِ إذْنِہَا۔","","Musannaf Ibn Abi Shaybah 17562","","","كتاب النكاح"
"17563","(۱۷۵۶۳) حَدَّثَنَا ابْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ جُوِیبرٍ ، عَنِ الضَّحَّاکِ أَنَّہُ کَرِہَ أَنْ یَنْظُرَ الْمَمْلُوکُ إلَی شَعْرِ مَوْلاَتِہِ۔","","Musannaf Ibn Abi Shaybah 17563","","","كتاب النكاح"
"17564","(۱۷۵۶۴) حَدَّثَنَا جَرَیْرٌ ، عَنْ مُغِیْرَۃُ ، عَنِ الشَّعْبِیِّ أَنَّہُ کَرِہَ أَنْ یُسِفَّ الرَّجُلُ النَّظَرَ إِلَی أُخْتِہِ أَو ابْنَتِہِ۔","","Musannaf Ibn Abi Shaybah 17564","","","كتاب النكاح"
"17565","(۱۷۵۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ أَنَّہُ کَرِہَ أَنْ یَنْظُرَ الرَّجُلُ إلَی شَعْرِ ابْنَتِہِ ، أَوْ أُخْتِہِ۔","","Musannaf Ibn Abi Shaybah 17565","","","كتاب النكاح"
"17566","(۱۷۵۶۶) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی الرَّجُلِ یَرَی مِنَ النِّسَائِ مَا یُحَرِّمُ عَلَیْہِ نِکَاحَہُ رُؤُوسُہُنَّ یَسْتَتِرْنَ أَحَبُّ إلَیَّ ، وَإِنْ رَأَی فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 17566","","","كتاب النكاح"
"17567","(۱۷۵۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ ، عَنْ أَبِی صَالِحٍ أَنَّ الْحَسَنَ وَالْحُسَیْنَ کَانَا یَدْخُلاَنِ عَلَی أُخْتِہِمَا أُمِّ کُلْثُومٍ وَہِیَ تمتشط۔","Sahih","Musannaf Ibn Abi Shaybah 17567","","","كتاب النكاح"
"17568","(۱۷۵۶۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْمَرْأَۃِ تَضَعُ خِمَارَہَا عِنْدَ أَخِیہَا قَالَ وَاللَّہِ مَا لَہَا ذَاکَ۔","","Musannaf Ibn Abi Shaybah 17568","","","كتاب النكاح"
"17569","(۱۷۵۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ أَنَّہُ کَرِہَ أَنْ یَنْظُرَ إلَی شَعَرِ کُلِّ ذِی مَحْرَمٍ۔","","Musannaf Ibn Abi Shaybah 17569","","","كتاب النكاح"
"17570","(۱۷۵۷۰) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، عَنْ مُوَرِّقٍ أَنَّہُ کَانَ یُفَلِّی أُمَّہُ۔","","Musannaf Ibn Abi Shaybah 17570","","","كتاب النكاح"
"17571","(۱۷۵۷۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ أَنَّ طَلْقًا کَانَ یُذَوِّبُ أُمَّہُ۔","","Musannaf Ibn Abi Shaybah 17571","","","كتاب النكاح"
"17572","(۱۷۵۷۲) حَدَّثَنَا وکیع عن شریک عن رجل عن الضحاک أنہ کان یمشط أمہ۔","","Musannaf Ibn Abi Shaybah 17572","","","كتاب النكاح"
"17573","(۱۷۵۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ أَنَّہُ قَالَ : لاَ بَأْسَ أَنْ یَنْظُرَ إلَی شَعْرِ أُمِّہِ وَأَنْ تَسْتَتِرَ أَحَبُّ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 17573","","","كتاب النكاح"
"17574","(۱۷۵۷۴) حَدَّثَنَا یَعْلَی ، عَنْ سُفْیَانَ ، عَنْ مُزَاحِمِ بْنِ زُفَرَ ، عَنِ الضَّحَّاکِ قَالَ : لَوْ دَخَلْتُ عَلَی أُمِّی لَقُلْت : أَیَّتُہَا الْعَجُوزُ ، غَطِّی رَأْسَک۔","","Musannaf Ibn Abi Shaybah 17574","","","كتاب النكاح"
"17575","(۱۷۵۷۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ سُفْیَانَ ، عَنْ سَالِمِ بْنِ أَبِی حَفْصَۃَ ، عَنْ مُنْذِرٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ أَنَّہُ کَانَ یُذَوِّبُ أُمَّہُ۔","","Musannaf Ibn Abi Shaybah 17575","","","كتاب النكاح"
"17576","(۱۷۵۷۶) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ ، عَنْ مُزَاحِمٍ ، عَنِ الضَّحَّاکِ قَالَ: لَوْ دَخَلْتُ عَلَی أُمِّی لَقُلْت : غَطِّی رَأْسَکِ۔","","Musannaf Ibn Abi Shaybah 17576","","","كتاب النكاح"
"17577","(۱۷۵۷۷) حَدَّثَنَا وَکِیعٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ عِکْرِمَۃَ قَالَ : مُبَاشَرَۃُ الرَّجُلِ أُخْتَہُ أو أُمَّہُ شُعْبَۃٌ مِنَ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17577","","","كتاب النكاح"
"17578","(۱۷۵۷۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ قَالَ : کَانَ الْحَسَنُ وَالْحُسَیْنُ لاَ یَرَیَانِ أُمَّہَاتِ الْمُؤْمِنِینَ ، وَکَانَ ابْنُ عَبَّاسٍ یَرَی أَنَّ رُؤْیَتَہُنَّ لَہُمَا حِلٌّ۔","Hasan","Musannaf Ibn Abi Shaybah 17578","","","كتاب النكاح"
"17579","(۱۷۵۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ أَیَرَی الرَّجُلُ رَأْسَ خَتَِنَتِہِ قَالَ : فَتَلاَ عَلَیَّ الآیَۃَ: {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ لِبُعُولَتِہِنَّ ، أَوْ آبَائِہِنَّ ، أَوْ آبَائِ بُعُولَتِہِنَّ ، أَوْ أَبْنَائِہِنَّ ، أَوْ أَبْنَائِ بُعُولَتِہِنَّ ، أَوْ إخْوَانِہِنَّ ، أَوْ بَنِی إخْوَانِہِنَّ ، أَوْ بَنِی أَخَوَاتِہِنَّ} الآیَۃَ ، فَقَالَ : أَرَاہَا فِیہِنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 17579","","","كتاب النكاح"
"17580","(۱۷۵۸۰) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ قَالَ : أَخْبَرَنَا دَاوُد ، عَنِ الشَّعْبِیِّ ، وَعِکْرِمَۃَ فِی ہَذِہِ : {وَلاَ یُبْدِینَ زِینَتَہُنَّ إلاَّ لِبُعُولَتِہِنَّ ، أَوْ آبَائِہِنَّ ، أَوْ آبَائِ بُعُولَتِہِنَّ} حَتَّی فَرَغَ مِنْہَا قَالاَ : لَمْ یُذْکَرَ الْعَمُّ وَالْخَالُ لأَنَّہُمَا ینعتان لأَبْنَائِہِمَا وَقَالاَ : لاَ تَضَعُ خِمَارَہَا عِنْدَ الْعَمِّ وَالْخَالِ۔","","Musannaf Ibn Abi Shaybah 17580","","","كتاب النكاح"
"17581","(۱۷۵۸۱) حَدَّثَنَا عَبَّادُ بْنُ العَوَّامِ ، عَنْ صَخْرِ بْنُ جُوَیْرِیَۃَ ، عَنْ نَافِعٍ أَنَّ ابْنَ عُمَرَ سُئِلَ عَنِ امْرَأَۃٍ أَحَلَّتْ جَارِیَتَہَا لِزَوْجِہَا ، فَقَالَ ابْنُ عُمَرَ لاَ أَدْرِی ، لَعَلَّ ہَذَا لَوْ کَانَ عَلَی عَہْدِ عُمَرَ لَرَجَمَہُ ، إنَّہَا لاَ تَحِلُّ لَکَ جَارِیَۃٌ إلاَّ جَارِیَۃً إِنْ شِئْتَ بِعْتہَا ، وَإِنْ شِئْتَ أَعْتَقْتہَا ، وَإِنْ شِئْتَ وَہَبْتہَا ، وَإِنْ شِئْتَ أَنْکَحْتہَا مَنْ شِئْت۔","Sahih","Musannaf Ibn Abi Shaybah 17581","","","كتاب النكاح"
"17582","(۱۷۵۸۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ یَحِلُّ فَرْجٌ إلاَّ بِمِلْکٍ ، أَوْ نِکَاحٍ ، إِنْ طَلَّقَ جَازَ ، وَإِنْ أَعْتَقَ جَازَ ، وَإِنْ وَہَبَ جَازَ۔","Hasan","Musannaf Ibn Abi Shaybah 17582","","","كتاب النكاح"
"17583","(۱۷۵۸۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : سَأَلْتُہ عَنِ امْرَأَۃٍ تُحِلُّ وَلِیدَتَہَا لابْنِہَا قَالَ : لاَ تَحِلُّ لَہُ إلاَّ بِنِکَاحٍ ، أَوْ بِہِبَۃٍ ، أَوْ بِشِرَائٍ۔","","Musannaf Ibn Abi Shaybah 17583","","","كتاب النكاح"
"17584","(۱۷۵۸۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : لاَ یُعَارُ الْفَرْجُ ، وَإِنْ وَقَعَ عَلَیْہَا فَہِیَ لَہُ۔","","Musannaf Ibn Abi Shaybah 17584","","","كتاب النكاح"
"17585","(۱۷۵۸۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی الرَّجُلِ قَالَ لآخَرَ : جَارِیَتِی لَکَ تَطَؤُہَا فَإِنْ حَمَلَتْ فَہِیَ لَکَ ، وَإِنْ لَمْ تَحْمِلْ رَدَدْتہَا عَلَیَّ ، قَالَ : إذَا وَطِئَہَا فَہِیَ لَہُ۔","","Musannaf Ibn Abi Shaybah 17585","","","كتاب النكاح"
"17586","(۱۷۵۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ وَعَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالاَ : إذَا أُحِلَّ لَہُ فَرْجُہَا فَہِیَ لَہُ۔","","Musannaf Ibn Abi Shaybah 17586","","","كتاب النكاح"
"17587","(۱۷۵۸۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ مُطَرِّفٍ ، عَنْ رَجُلٍ ، عَنْ إبْرَاہِیمَ فِی امْرَأَۃٍ أَحَلَّتْ لِرَجُلٍ جَارِیَتَہَا فَوَلَدَتْ مِنْہُ ، فَقَالَ إبْرَاہِیمُ : ہَذَا فَرْجٌ أَتَاہُ بِجَہَالَۃٍ فَأُلْحِقْ بِہِ الْوَلَدَ وَادْفَعْ إلَی ہَذِہِ وَلِیدَتَہَا۔","","Musannaf Ibn Abi Shaybah 17587","","","كتاب النكاح"
"17588","(۱۷۵۸۸) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ قَالَ : الْفَرْجُ لاَ یُعَارُ۔","","Musannaf Ibn Abi Shaybah 17588","","","كتاب النكاح"
"17589","(۱۷۵۸۹) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ قَالَ : حدَّثَنِی مُوسَی بْنُ خَیْشُومٍ قَالَ سَأَلَ عِکْرِمَۃَ رَجُلٌ قَالَ : أَمَۃٌ لِصَاحِبَتِی أَحَلَّتْہَا لِی قَالَ : لاَ تَحِلُّ لَکَ إلاَّ أَنْ تَمْلِکَ رَقَبَتَہَا۔","","Musannaf Ibn Abi Shaybah 17589","","","كتاب النكاح"
"17590","(۱۷۵۹۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَقَعُ عَلَی مُکَاتَبَتِہِ قَالَ یَحسبُ لَہَا صَدَاقُ مِثْلِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 17590","","","كتاب النكاح"
"17591","(۱۷۵۹۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ قَالَ : إذَا غَشِیَ مُکَاتَبَتَہُ فَہِیَ أُمُّ وَلَدِہِ۔","","Musannaf Ibn Abi Shaybah 17591","","","كتاب النكاح"
"17592","(۱۷۵۹۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ فِی رَجُل وَطِیئَ مُکَاتَبَتَہُ قَالَ إِنْ کَانَ اسْتَکْرَہَہَا فَعَلَیْہِ الْعُقْرُ وَالْحَدُّ ، وَإِنْ کَانَتْ طَاوَعَتْہُ فَعَلَیْہِ الْحَدُّ وَلَیْسَ عَلَیْہِ الْعُقْرُ۔","","Musannaf Ibn Abi Shaybah 17592","","","كتاب النكاح"
"17593","(۱۷۵۹۳) حَدَّثَنَا ابْنُ إدْرِیسَ قَالَ: کَانَ ابْنُ أَبِی لَیْلَی یَقُولُ: تَعُودُ الْمُکَاتَبَۃُ فَتَکُونُ أُمَّ وَلَدٍ یَعْنِی إذَا وَطِئَہَا فَوَلَدَتْ۔","","Musannaf Ibn Abi Shaybah 17593","","","كتاب النكاح"
"17594","(۱۷۵۹۴) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الرَّجُلِ یُکَاتِبُ امْرَأَتَہُ وَیَشْتَرِطُ عَلَیْہَا فِی الْمُکَاتَبَۃِ أَنْ یَطَأَہَا قَالَ : لاَ بَأْسَ بِہِ ، لَہُ شَرْطُہُ وَلَہُ أَنْ یَطَأَہَا۔","","Musannaf Ibn Abi Shaybah 17594","","","كتاب النكاح"
"17595","(۱۷۵۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْن أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ وَطِیئَ مُکَاتَبَتَہُ ، فَقَالَ : مَا رَقَّ مِنْہَا مہر لِمَا أُعْتِقَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 17595","","","كتاب النكاح"
"17596","(۱۷۵۹۶) حدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ قَالَ : لَیْسَ عَلَی زَانٍ عُقْرٌ۔","","Musannaf Ibn Abi Shaybah 17596","","","كتاب النكاح"
"17597","(۱۷۵۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنْ عَبْدِ رَجُلٍ اسْتَکْرَہَ حُرَّۃً قَالاَ: لاَ عُقْرَ عَلَیْہِ، لاَ یَضُرُّک حُرَّۃً کَانَتْ ، أَوْ أَمَۃً۔","","Musannaf Ibn Abi Shaybah 17597","","","كتاب النكاح"
"17598","(۱۷۵۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ وَعَنْ رَجُلٍ ، عَنِ الزُّہْرِیِّ قَالاَ : إِنْ کَانَتْ بِکْرًا فَالْعُقْرُ وَالْحَدُّ ، وَإِنْ کَانَتْ ثَیِّبًا فَالْحَدُّ۔","","Musannaf Ibn Abi Shaybah 17598","","","كتاب النكاح"
"17599","(۱۷۵۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ یَجْتَمِعُ حَدٌّ وَلاَ صَدَاقٌ عَلَی زَانٍ۔","","Musannaf Ibn Abi Shaybah 17599","","","كتاب النكاح"
"17600","(۱۷۶۰۰) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا أَوْقَعْتُ عَلَیْہِ الْحَدَّ لَمْ آخُذْ مِنْہُ الْعُقْرَ۔","","Musannaf Ibn Abi Shaybah 17600","","","كتاب النكاح"
"17601","(۱۷۶۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ یَزِیْدَ بْنِ مُعْنِق قَالَ : قَالَ ابْنُ عُمَرَ : لأَنْ یجعل فِی رَأْسِی مِخْیَطٌ حَتَّی یخبو أَحَبُّ إلَیَّ مِنْ أَنْ تُقَبِّلَ رَأْسِی امْرَأَۃٌ لَیْسَتْ بِمَحْرَمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 17601","","","كتاب النكاح"
"17602","(۱۷۶۰۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : لأَنْ یثقب القمل دِمَاغ رَجُلٍ خَیْرٌ لَہُ مِنْ أَنْ تُفَلیہ امْرَأَۃٌ یَحِلُّ لَہُ نِکَاحُہَا ، قَالَ : وَذَکَرَ أَنَّ امْرَأَۃً کَانَتْ تُفَلِّی مَرَّۃ رَجُلاً فَقَبَّلَتْہُ۔","","Musannaf Ibn Abi Shaybah 17602","","","كتاب النكاح"
"17603","(۱۷۶۰۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، قَالَ : سَمِعْتُ الْحَسَنَ یَقُولُ : لاَ یَحِلُّ لِأَمْرَأَۃٍ تَغْسِلُ رَأْسَ رَجُلٍ لَیْسَ بَیْنَہَا وَبَیْنَہُ مَحْرَمٌ۔","","Musannaf Ibn Abi Shaybah 17603","","","كتاب النكاح"
"17604","(۱۷۶۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ بَشِیرِ بْنِ عُقْبَۃَ قَالَ : حدَّثَنِی یَزِیدُ بْنُ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، عَنْ مَعْقِلِ بْنِ یَسَارٍ قَالَ : لأَنْ یَعْمِدَ أَحَدُکُمْ إلَی مِخْیَطٍ فَیَغْرِزُ بِہِ فِی رَأْسِی أَحَبُّ إلَیَّ مِنْ أَنْ تَغْسِلَ رَأْسِی امْرَأَۃٌ لَیْسَتْ مِنِّی ذَاتَ مَحْرَمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 17604","","","كتاب النكاح"
"17605","(۱۷۶۰۵) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ قَتَادَۃَ یَقُولُ : سَافَرْت مَعَ امْرَأَۃٍ إلَی مَکَّۃَ نَصَفَ وَإِنَّ فِیہَا لَبَقیۃً فَکَانَتْ تَغْسِلُ رَأْسِی ، أَوْ تُفَلِّی رَأْسِی۔","","Musannaf Ibn Abi Shaybah 17605","","","كتاب النكاح"
"17606","(۱۷۶۰۶) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ سُفْیَانَ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، عَنْ أَبِی مُوسَی قَالَ : أَتَیْتُ امْرَأَۃً مِنْ قَوْمِی فَغَسَلَتْ ثِیَابِی وَمَشَطَتْ رَأْسِی۔","Sahih","Musannaf Ibn Abi Shaybah 17606","","","كتاب النكاح"
"17607","(۱۷۶۰۷) حدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ عَنِ الْحَسَنِ فِی الرَّجُلِ یَتَزَوَّجُ الأَمَۃَ قَالَ : لَیْسَ لَہُ أَنْ یُخْرِجَہَا مِنَ المِصْرِ۔","","Musannaf Ibn Abi Shaybah 17607","","","كتاب النكاح"
"17608","(۱۷۶۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَطَائٍ وَمَکْحُولٍ قَالاَ : لَیْسَ لَہُمْ بُدٌّ من أَنْ یَسْتَخْدِمُوہَا۔","","Musannaf Ibn Abi Shaybah 17608","","","كتاب النكاح"
"17609","(۱۷۶۰۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ بْنِ مُوسَی ، عَنِ ابْنِ قُسَیْطٍ أَنَّ سعِیدَ بْنَ الْمُسَیَّبِ سُئِلَ عَنْ رَجُلٍ بُشِّرَ بِجَارِیَۃٍ ، فَقَالَ بَعْضُ الْقَوْمِ : ہَبْہَا لِی ، فَقَالَ سَعِیدُ بْنُ الْمُسَیَّبِ ، لَمْ تَحِلَّ الْمَوْہُوبَۃُ لأَحَدٍ بَعْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَوْ أَصْدَقَہَا سَوْطًا حَلَّتْ لَہُ۔","","Musannaf Ibn Abi Shaybah 17609","","","كتاب النكاح"
"17610","(۱۷۶۱۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ قَالَ : لاَ یَحِلُّ لأَحَدٍ أَنْ یَہَبَ ابْنَتَہُ بِغَیْرِ مَہْرٍ إلاَّ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 17610","","","كتاب النكاح"
"17611","(۱۷۶۱۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنْ رَجُلٍ وَہَبَ ابْنَتَہُ لِرَجُلٍ فَقَالاَ : لاَ یَجُوزُ إلاَّ بِصَدَاقٍ۔","","Musannaf Ibn Abi Shaybah 17611","","","كتاب النكاح"
"17612","(۱۷۶۱۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عُبیدِ اللہِ بْنِ عُبَیْدٍ قَالَ : سُئِلَ مَکْحُولٌ ، عَنِ الرَّجُلِ یَہَبُ أُخْتَہُ ، أَوِ ابْنَتَہُ لِلرَّجُل وَلاَ یَفْرِضُ لَہَا صَدَاقًا ، فَقَالَ مَکْحُولٌ وَالزُّہْرِیُّ : لَمْ تَحِلَّ الْمَوْہُوبَۃُ لأَحَدٍ بَعْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 17612","","","كتاب النكاح"
"17613","(۱۷۶۱۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : أَیُّمَا امْرَأَۃٍ وَہَبَہَا أَبُوہَا لِرَجُلٍ ، أَوْ وَہَبَتْ نَفْسَہَا لِرَجُلٍ فَلَہَا مہر مِثْلُہَا إِنْ دَخَلَ بِہَا ، وَإِلاَّ فَإِنَّمَا عَلَیْہِ الْمُتْعَۃُ إِنْ طَلَّقَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا۔","","Musannaf Ibn Abi Shaybah 17613","","","كتاب النكاح"
"17614","(۱۷۶۱۴) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ قَالَ : سُئِلَ عَطَائٌ ، عَنِ امْرَأَۃٍ وَہَبَتْ نَفْسَہَا لِرَجُلٍ قَالَ : لاَ یَکُونُ إلاَّ بِصَدَاقٍ۔","Sahih","Musannaf Ibn Abi Shaybah 17614","","","كتاب النكاح"
"17615","(۱۷۶۱۵) حَدَّثَنَا عَبدَۃ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ أَنَّہَا قَالَتْ : مَا تَسْتَحِی امْرَأَۃٌ أَنْ تَہَبَ نَفْسَہَا لِرَجُلٍ حَتَّی أَنْزَلَ اللَّہُ تَعَالَی : {تُرْجِی مَنْ تَشَائُ مِنْہُنَّ وَتُؤْوِی إلَیْک مَنْ تَشَائُ} قَالَتْ : فَقُلْتُ: إنَّ رَبَّک لَیُسَارِعُ لَکَ فِی ہَوَاک۔ (بخاری ۵۱۱۳۔ مسلم ۵۰)","","Musannaf Ibn Abi Shaybah 17615","","","كتاب النكاح"
"17616","(۱۷۶۱۶) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ فِی امْرَأَۃٍ وَہَبَتْ نَفْسَہَا لِرجُلٍ ، فَقَالَ : لاَ یَصْلُحُ إلاَّ بِصَدَاقٍ ، لَمْ یَکُنْ ذَلِکَ إلاَّ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 17616","","","كتاب النكاح"
"17617","(۱۷۶۱۷) حَدَّثَنَا ہُشَیْم ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِیْمَنْ تَزَوَّجَ ذَاتَ مَحْرَمٍ مِنْہُ فَدَخَلَ بَہَا قَالَ : لَہَا الصَّدَاقُ۔","","Musannaf Ibn Abi Shaybah 17617","","","كتاب النكاح"
"17618","(۱۷۶۱۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أنہ قَالَ : لَہَا مَا أَخَذَتْ۔","","Musannaf Ibn Abi Shaybah 17618","","","كتاب النكاح"
"17619","(۱۷۶۱۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 17619","","","كتاب النكاح"
"17620","(۱۷۶۲۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ قَالَ : لاَ صَدَاقَ لَہَا دَخَلَ بِہَا ، أَوْ لَمْ یَدْخُلْ بِہَا ، أَیَصْدُقُ الرَّجُلُ أُخْتَہُ ، أَوْ أُمَّہُ ؟۔","","Musannaf Ibn Abi Shaybah 17620","","","كتاب النكاح"
"17621","(۱۷۶۲۱) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ تَزَوَّجَ أُخْتَہُ فِی الرَّضَاعَۃِ وَہُوَ لاَ یَعْلَمُ ثُمَّ عَلِمَ بَعْدَ ذَلِکَ قَالَ : بَطَلَ النِّکَاحُ فَإِنْ دَخَلَ بِہَا فَلَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا ، وَإِنْ لَمْ یَکُنْ دَخَلَ بِہَا فُرِّقَ بَیْنَہُمَا وَلاَ صَدَاقَ۔","","Musannaf Ibn Abi Shaybah 17621","","","كتاب النكاح"
"17622","(۱۷۶۲۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنِ الْحَکَمِ فِی رَجُلٍ تَزَوَّجَ أُخْتَہُ ، أَوْ أُخْتَ امْرَأَتِہِ مِنَ الرَّضَاعَۃِ فَدَخَلَ بِہَا وَہُوَ لاَ یَشْعُرُ قَالَ : لَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17622","","","كتاب النكاح"
"17623","(۱۷۶۲۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنِ الْحَسَنِ قَالَ : لَہَا الصَّدَاقُ بما أحدث۔","","Musannaf Ibn Abi Shaybah 17623","","","كتاب النكاح"
"17624","(۱۷۶۲۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ قَالَ : کُلُّ جِمَاعٍ دُرِئَ فِیہِ الْحَدُّ فَفِیہِ الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17624","","","كتاب النكاح"
"17625","(۱۷۶۲۵) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً فَإِذَا ہِیَ أُخْتُہُ مِنَ الرَّضَاعَۃِ فَأَصَابَہَا وَلَمْ یَشْعُرْ بِہَا قَالَ : یُفَرَّقُ بَیْنَہُمَا وَلَیْسَ لَہَا الصَّدَاقُ کُلُّہُ ، لَہَا بَعْضُہُ۔","","Musannaf Ibn Abi Shaybah 17625","","","كتاب النكاح"
"17626","(۱۷۶۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیْمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَزَوَّجَہَا وَہِیَ ابْنَۃُ تِسْعٍ وَمَاتَ عَنْہَا وَہِیَ ابْنَۃُ ثَمَانَ عَشَرَۃَ۔ (مسلم ۷۲۔ احمد ۴۲)","Sahih","Musannaf Ibn Abi Shaybah 17626","","","كتاب النكاح"
"17627","(۱۷۶۲۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ أَنَّ الزُّبَیْرَ زَوَّجَ ابْنَۃً لَہُ صَغِیرَۃً حِینَ نُفِسَتْ یَعْنِی حِینَ وُلِدَتْ۔","Sahih","Musannaf Ibn Abi Shaybah 17627","","","كتاب النكاح"
"17628","(۱۷۶۲۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ أَنَّہُ زَوَّجَ ابْنًا لَہُ ابْنَۃً لِمُصْعَبٍ صَغِیرَۃً۔","","Musannaf Ibn Abi Shaybah 17628","","","كتاب النكاح"
"17629","(۱۷۶۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّ عُمَرَ خَطَبَ إلَی عَلِیٍّ ابْنَتَہُ أُمَّ کُلْثُومٍ ، فَقَالَ عَلِیٌّ : إنَّہَا صَغِیرَۃٌ فَانْظُرْ إلَیْہَا ، فَأَرْسَلَہَا إلَیْہِ بِرِسَالَۃٍ فَمَازَحَہَا ، فَقَالَتْ : لَوْلاَ أَنَّک شَیْخٌ ، أَوْ لَوْلاَ أَنَّک أَمِیرُ الْمُؤْمِنِینَ فَأَعْجَبَ عُمَرَ مُصَاہَرَتُہُ فَخَطَبَہَا فَأَنْکَحَہَا إیَّاہُ۔","Hasan","Musannaf Ibn Abi Shaybah 17629","","","كتاب النكاح"
"17630","(۱۷۶۳۰) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ، عَنِ ابْنِ جُرَیْجٍ، عَنِ ابْنِ طَاوُوسٍ، عَنْ أَبِیہِ أَنَّہُ کَانَ یَکْرَہُ نِکَاحَ الصَّغِیرَیْنِ۔","","Musannaf Ibn Abi Shaybah 17630","","","كتاب النكاح"
"17631","(۱۷۶۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ قَالَ : کَانَ الحسن لاَ یُعْجِبُہُ نِکَاحُ الصِّغَارِ۔","","Musannaf Ibn Abi Shaybah 17631","","","كتاب النكاح"
"17632","(۱۷۶۳۲) حَدَّثَنَا مُحَمَّدُ بِنُ فُضَیْلٍ ، عَنْ یَزِیْدَ بِنْ أَبِی زِیَادٍ ، عَنْ زَیْدٍ بِنْ وَہْبٍ قَالَ : کَتَبَ إلَیْنَا عُمَرُ إِنَّ الأَعْرَابِیَّ لاَ یَنْکِحُ الْمُہَاجِرَۃَ ، یُخْرِجَہَا مِنْ دَارِ الْہِجْرَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 17632","","","كتاب النكاح"
"17633","(۱۷۶۳۳) حَدَّثَنَا عَبَّادُ بِنَ العَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الحَسَنِ أَنَّہُ کَرِہَ أَنْ یَتَزَوَّجَ الأَعْرَابِیُّ المُہَاجِرَۃَ۔","","Musannaf Ibn Abi Shaybah 17633","","","كتاب النكاح"
"17634","(۱۷۶۳۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ مُحَمَّدٍ بِنْ سَالِمٍ ، عَنِ الشَّعْبِیِّ أَنَّہُ کَرِہَ أَنْ یَتَزَوَّجَ الأَعْرَابِیُّ المُہَاجِرَۃَ لِیُخْرِجَہَا مِنَ المِصْرِ۔","","Musannaf Ibn Abi Shaybah 17634","","","كتاب النكاح"
"17635","(۱۷۶۳۵) حَدَّثَنَا عَبِیْدَۃُ بِنْ حُمَیْدٍ ، عَنِ الرَّکِیْنِ ، عَنْ أَبِیہِ قَالَ : خَطَبَ مَنْظُوْرُ بِنْ زَبَّان إِلَی خَالِہِ وَکَانَا حَاجَّیْنِ ، أَوْ مُعْتَمِرَیْنِ فَقَالَ : نَعَمْ إَذَا رَجَعْتُ أَنْکَحْتُکَ ، فَخَرَجَ إِلَیْہَا أَخُوْہَاَ ابْنُ أُمِّہَا وَأَبِیْہَا فَأَنْکَحَہَا ابْنَ خَالِہَا فَقَدِمَ وَقَد أنکحت ، فَغَضِبَ أَبُوہَا غَضَبًا شَدِیْدًا وَقَالَ : إِنِّی أبرأ إِلَی اللہِ مِنْ ہَذَا النِّکَاحِ ، إِنِّی سَمِعْتُ عُمَرَ یَقُوْلُ : لاَ یُنْکَحُ المُہَاجِرَاتُ الأَعْرَابَ۔","Da'if","Musannaf Ibn Abi Shaybah 17635","","","كتاب النكاح"
"17636","(۱۷۶۳۶) حَدَّثَنَا ابْنُ إدْرِیس ، عَنِ ابْنِ جُرَیْجٍ ، عن الزہری ، عَنْ عَمْرِو بْنِ الشَّرِیدِ قَالَ : سُئِلَ ابْنُ عَبَّاسٍ ، عَنْ رَجُلٍ لَہُ امْرَأَۃٌ وَسُرِّیَّۃٌ ولدت إحْدَاہُمَا غُلاَمًا وَأَرْضَعَتْ إحْدَاہُمَا جَارِیَۃً ہَلْ یَصْلُحُ لِلْغُلاَمِ أَنْ یَتَزَوَّجَ الْجَارِیَۃَ ؟ قَالَ : لاَ ، اللِّقَاحُ وَاحِدٌ۔","","Musannaf Ibn Abi Shaybah 17636","","","كتاب النكاح"
"17637","(۱۷۶۳۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ أَنَّہُ کَرِہَ لَبَنَ الْفَحْلِ وَکَرِہَ قَوْلَ إبْرَاہِیمَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 17637","","","كتاب النكاح"
"17638","(۱۷۶۳۸) حَدَّثَنَا ہُشَیْمٌ ، وَابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَرِہَہُ یَعْنِی لَبَنَ الْفَحْلِ۔","","Musannaf Ibn Abi Shaybah 17638","","","كتاب النكاح"
"17639","(۱۷۶۳۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَبْدِ اللہِ بْنِ سَبْرَۃَ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 17639","","","كتاب النكاح"
"17640","(۱۷۶۴۰) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : کَانَ یَرَی لَبَنَ الْفَحْلِ یُحَرِّم۔","","Musannaf Ibn Abi Shaybah 17640","","","كتاب النكاح"
"17641","(۱۷۶۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سفیان ، عَنْ خُصَیْفٍ ، عَنْ سَالِمٍ أنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 17641","","","كتاب النكاح"
"17642","(۱۷۶۴۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ قَالَ : سَأَلْتُ الْقَاسِمَ بْنَ مُحَمَّدٍ : قُلْتُ امْرَأَۃ أَبِی أَرْضَعَتْ جَارِیَۃً مِنْ عَرَضِ النَّاسِ بِلِبَانِ إخْوَتِی مِنْ أَبِی ، تَحِلُّ لِی ؟ قَالَ : لاَ ، أَبُوک أَبُوہَا ، وَسَأَلْت طَاوُوسًا ، فَقَالَ مِثْلَ ذَلِکَ وَسَأَلْت الْحَسَنَ ، فَقَالَ مِثْلَ ذَلِکَ وَسَأَلْت مُجَاہِدًا ، فَقَالَ : اخْتَلَفَ فِیہِ النَّاسُ وَلاَ أَقُولُ فِیہَا شَیْئًا وَسَأَلْت ابْنَ سِیرِینَ ، فَقَالَ مِثْلَ قَوْلِ مُجَاہِدٍ۔","","Musannaf Ibn Abi Shaybah 17642","","","كتاب النكاح"
"17643","(۱۷۶۴۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ قَالَ : ذَکَرْت ذَلِکَ لِمُحَمَّدِ بْنِ سِیرِینَ ، فَقَالَ نُبِّئْت أَنَّ أُنَاسًا مِنْ أَہْلِ الْمَدِینَۃِ اخْتَلَفُوا فِیہِ فَمِنْہُمْ مَنْ کَرِہَہُ وَمِنْہُمْ مَنْ لَمْ یَکْرَہْہُ وَمَنْ کَرِہَ أَفْضَلُ فِی أَنْفُسِنَا مِمَّنْ لَمْ یَکْرَہْہُ ، وَکَانَ الْقَاسِمُ بْنُ مُحَمَّدٍ فِیمَنْ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 17643","","","كتاب النكاح"
"17644","(۱۷۶۴۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو قَالَ : قدِمَ الزُّہْرِیُّ المدینۃ فِی أَوَّلِ خِلاَفَۃِ ہِشَامٍ فَذَکَرَ أَنَّ عُرْوَۃَ کَانَ یُحَدِّثُ ، عَنْ عَائِشَۃَ أَنَّ أَبَا الْقُعَیْسِ جَائَ یَسْتَأْذِنُ عَلَی عَائِشَۃَ وَقَدْ أَرْضَعَتْہُمَا امْرَأَۃُ أَخِیہِ فَأَبَتْ أَنْ تَأْذَنَ لَہُ فَزَعَمَ عُرْوَۃُ أَنَّ عَائِشَۃَ ذَکَرَتْ ذَلِکَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : فَہَلاَّ أَذِنْت لَہُ ؟ فَإِنَّ الرَّضَاعَۃَ تُحَرِّمُ مَا تُحَرِّمُ الْوِلاَدَۃُ فَفَزِعَ أَہْلُ الْمَدِینَۃِ لِذَلِکَ فَطَلَّقَ عَبْدُ اللہِ بْنُ أَبِی حَبِیبَۃَ مَوْلَی الزُّبَیْرِ امْرَأَتَہُ عِنْدَ ذَلِکَ۔","Hasan","Musannaf Ibn Abi Shaybah 17644","","","كتاب النكاح"
"17645","(۱۷۶۴۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ قَالَ : ذُکِرَ لَبَنُ الْفَحْلِ ، فَقَالَ وَقَدْ کَرِہَہُ أُنَاسٌ وَرَخَّصَ فِیہِ أُنَاسٌ ، فَکَانَ مَنْ کَرِہَہُ عِنْدَ النَّاسِ أَفْضَلُ ، وَکَانَ الْقَاسِمُ بْنُ مُحَمَّدٍ مِمَّنْ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 17645","","","كتاب النكاح"
"17646","(۱۷۶۴۶) حَدَّثَنَا مَالِکٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ ہِشَامٍ أَنَّ أَبَاہُ کَرِہَ لَبَنَ الْفَحْلِ۔","","Musannaf Ibn Abi Shaybah 17646","","","كتاب النكاح"
"17647","(۱۷۶۴۷) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی عُبَیدَۃَ بْنِ عَبْدِ اللہِ بْنِ زَمْعَۃَ عَن أُمِہ زَینَب ابنَۃ أَبِی سَلَمَۃَ قَالَت : کَانَتْ أَسْمَائُ أَرْضَعَتْنِی ، وَکَانَ الزُّبَیْرُ یَدْخُلُ عَلَیَّ وَأَنَا أَمْتَشِطُ وَیَأْخُذُ الْقَرْنَ مِنْ قُرُونِی وَیَقُولُ : أَقْبِلِی عَلیَّ فحدثنی بربی أنَّہُ أَبِی وَأن مَا وَلَدَ إخْوَتِی ، فَلَمَّا کَانَ یوم الْحَرَّۃِ أَرْسَلَ عَبْدُ اللہِ بْنُ الزُّبَیْرِ یَخْطُبُ ابْنَتِی عَلَی حَمْزَۃَ بن الزُّبَیْر وَحَمْزَۃُ وَمُصْعَبٌ لِلْکَلْبِیَّۃِ فَأَرْسَلْت إلَیْہِ : ہَلْ تَصْلُحُ لَہُ ؟ فَأَرْسَلَ إلَیَّ : إنَّمَا تُرِیدِینَ مَنْعِی بِنْتَکِ وَأَنَا أَخُوک ، وَمَا وَلَدَتْ أَسْمَائُ فَہُمْ إخْوَتُک وما وَلَدُ الزُّبَیْرِ لِغَیْرِ أَسْمَائَ فَلَیْسَ لَکَ بِإِخْوَۃٍ فَأَرْسِلِی فَسَلِی فَأَرْسَلْتُ فَسَأَلْتُ وَأَصْحَابُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَوَافِرُونَ وَأُمَّہَاتُ الْمُؤْمِنِینَ فَقَالُوا : إنَّ الرَّضَاعَۃَ مِنْ قِبَلِ الرِّجَالِ لاَ تُحَرِّمُ شَیْئًا۔","Hasan","Musannaf Ibn Abi Shaybah 17647","","","كتاب النكاح"
"17648","(۱۷۶۴۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ قَالَ : سَأَلْتُ أَبَا سَلَمَۃَ بْنَ عَبْدِ الرَّحْمَنِ وَسَعِیدَ بْنَ الْمُسَیَّبِ وَعَطَائً وَسُلَیْمَانَ ابْنَی یَسَارٍ ، عَنِ الرَّضَاعَۃِ مِنْ قِبَلِ الرِّجَالِ فَقَالُوا : لاَ تُحَرِّمُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 17648","","","كتاب النكاح"
"17649","(۱۷۶۴۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو قَالَ : حدَّثَنِی آل رَافِعِ بْنِ خَدِیجٍ أَنَّ رَافِعَ بْنَ خَدِیجٍ زَوَّجَ ابْنَتَہُ ابْنَ أَخِیہِ رِفَاعَۃَ بْنِ خَدِیجٍ وَقَدْ أَرْضَعَتْہَا أُمُّ وَلَدٍ لَہُ سِوَی أُمِّ ابنہِ الَّذِی أَنْکَحَہَا إیَّاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 17649","","","كتاب النكاح"
"17650","(۱۷۶۵۰) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَعَنْ جَابِرٍ ، عَنْ عَامِرٍ أَنَّہُمَا کَانَا لاَ یَرَیَانِ لَبَنَ الْفَحْلِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 17650","","","كتاب النكاح"
"17651","(۱۷۶۵۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ أَنَّہُ لَمْ یَرَ بِلَبَنِ الْفَحْلِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 17651","","","كتاب النكاح"
"17652","(۱۷۶۵۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ قَالَ : أَوَّلُ مَا سَمِعْت بِلَبَنِ الْفَحْلِ وَنَحْنُ بِمَکَّۃَ فَجَعَلَ إیَاسُ بْنُ مُعَاوِیَۃَ یَقُولُ : وَمَا بَأْسُ ہَذَا وَمَنْ یَکْرَہُ ہَذَا ؟۔","","Musannaf Ibn Abi Shaybah 17652","","","كتاب النكاح"
"17653","(۱۷۶۵۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ لاَ یَرَی لَبَنَ الْفَحْلِ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 17653","","","كتاب النكاح"
"17654","(۱۷۶۵۴) حَدَّثَنَا عُبَید اللہِ بْنُ مُوسَی ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ أَنَّہُ کَانَ لاَ یَرَی بِلَبَنِ الْفَحْلِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 17654","","","كتاب النكاح"
"17655","(۱۷۶۵۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَہْلِ بْنِ سَعْدٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَّقَ بَیْنَ الْمُتَلاَعِنَیْنِ وَقَالَ حسَابُکُمَا عَلَی اللہِ۔ (بخاری ۶۸۵۴۔ ابوداؤد ۲۲۴۵)","Sahih","Musannaf Ibn Abi Shaybah 17655","","","كتاب النكاح"
"17656","(۱۷۶۵۶) حَدَّثَنَا یَزِیدُ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَّقَ بَیْنَہُمَا وَقَضَی أَنْ لاَ قُوتَ لَہا عَلَیہ وَلاَ نَفَقَۃَ۔ (ابوداؤد ۲۲۵۰۔ طیالسی ۲۶۶۷)","Da'if","Musannaf Ibn Abi Shaybah 17656","","","كتاب النكاح"
"17657","(۱۷۶۵۷) حَدَّثَنَا حَفْصٌ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ، عَنْ عُمَرَ، قَالَ: الْمُتَلاَعِنَانِ یُفَرَّقُ بَیْنَہُمَا وَلاَ یَجْتَمِعَانِ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 17657","","","كتاب النكاح"
"17658","(۱۷۶۵۸) حَدَّثَنَا وَکِیعٌ، عَنْ قَیْسٍ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَلِیٍّ وعَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ قَالاَ: لاَ یَجْتَمِعَا الْمُتَلاَعِنَانِ أَبَدًا۔","Da'if","Musannaf Ibn Abi Shaybah 17658","","","كتاب النكاح"
"17659","(۱۷۶۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : الْمُتَلاَعِنَانِ لاَ یَجْتَمِعَا فِی مِصْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 17659","","","كتاب النكاح"
"17660","(۱۷۶۶۰) حَدَّثَنَا حَفْصٌ قَالَ : سَأَلْتُ عَمرًا ، فَقَالَ : کَانَ الْحَسَنُ یُفَرِّقُ بَیْنَہُمَا فَلاَ یَجْتَمِعَانِ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 17660","","","كتاب النكاح"
"17661","(۱۷۶۶۱) حَدَّثَنَا جَرِیرٌ عَن مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا لاَعَنَ الرَّجُلُ امْرَأَتَہُ فُرِّقَ بَیْنَہُمَا فَلاَ یَجْتَمِعَانِ أَبَدًا۔","","Musannaf Ibn Abi Shaybah 17661","","","كتاب النكاح"
"17662","(۱۷۶۶۲) حَدَّثَنَا یَزِیدُ ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : لاَ یَجْتَمِعَانِ۔","","Musannaf Ibn Abi Shaybah 17662","","","كتاب النكاح"
"17663","(۱۷۶۶۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ قَالَ : لاَ یَجْتَمِعَانِ۔","","Musannaf Ibn Abi Shaybah 17663","","","كتاب النكاح"
"17664","(۱۷۶۶۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ قَالَ : لاَ یَجْتَمِعَانِ۔","","Musannaf Ibn Abi Shaybah 17664","","","كتاب النكاح"
"17665","(۱۷۶۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ قَالَ : الْمُتَلاَعِنَانِ لاَ یَجْتَمِعَانِ۔","","Musannaf Ibn Abi Shaybah 17665","","","كتاب النكاح"
"17666","(۱۷۶۶۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ إِسْحَاقَ ، عَنِ ابْنِ شِہَابٍ قَالَ : مَضَتِ السُّنَّۃُ أَنَّہُمَا إذَا فُرِّقَ بَیْنَہُمَا لَمْ یَجْتَمِعَا أَبَدًا۔","","Musannaf Ibn Abi Shaybah 17666","","","كتاب النكاح"
"17667","(۱۷۶۶۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : فِی رَجُلٍ لاَعَنَ ثُمَّ أَکْذَبَ نَفْسَہُ فِی الْعِدَّۃِ قَالَ : إذَا لاَعَنَ انْقَطَعَ مَا بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17667","","","كتاب النكاح"
"17668","(۱۷۶۶۸) حدَّثَنَا حَفْصٌ، عَنْ دَاوُدَ، عَنِ سَعِیدِ بْنِ الْمُسَیَّبِ فِیَ المُلاَعِنِ یُکَذِّبُ نَفْسَہُ قَالَ: یُضْرَبُ وَہُوَ خَاطِب۔","","Musannaf Ibn Abi Shaybah 17668","","","كتاب النكاح"
"17669","(۱۷۶۶۹) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إِنْ أَکْذَبَ نَفْسَہُ جُلِدَ وَأُلْزِقَ بِہِ الْوَلَدُ وَرُدَّتْ إلَیْہِ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 17669","","","كتاب النكاح"
"17670","(۱۷۶۷۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حَمَّادٍ أَنہ سُئِلَ عَنِ الْمُتَلاَعِنَیْنِ ، فَقَالَ : یَتَزَوَّجُہَا إِنْ أَکْذَبَ نَفْسَہُ۔","","Musannaf Ibn Abi Shaybah 17670","","","كتاب النكاح"
"17671","(۱۷۶۷۱) حدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَمْرٍو، عَنْ سَعَیْدِ بِنْ جُبَیْرٍ، عَنِ ابْنِ عُمَرَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَرَّقَ بَیْنَ المُتَلاَعِنَیْنِ وَقَالَ : حِسَابُکُمَا عَلَی اللہِ ، أَحَدُکُمَا کَاذِبٌ لاَ سَبِیْلَ لَکَ عَلَیْہَا فَقَالَ : یَا رَسُوْلَ اللہِ! فَمَالِی؟ قَالَ: لاَ مَالَ لَکَ ، إِنْ کُنْتَ صَادِقَاً فَہُوَ بِمَا اسْتَحْلَلْتَ مِنْ فَرْجِہَا ، وَإِنْ کُنْتَ کَاذِبَاً فَذَلِکَ أَبْعَدُ لَکَ۔n(بخاری ۵۳۵۰۔ مسلم ۵)","Sahih","Musannaf Ibn Abi Shaybah 17671","","","كتاب النكاح"
"17672","(۱۷۶۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ سَعِیْدِ بِنِ جُبَیْرٍ أَنَّہُ فَرَّقَ بَیْنَ المُتَلاَعِنَیْنِ قَالَ : فَتَعَلَّقَ بِہَا فَقَالَ : مَالِی ، فَقُلْتُ لاَ مَالَ لَکَ ، قَالَ : فَانْطَلَقَ إِلَی أَبِی بُرْدَۃَ وَقَالَ : یَذْہَبُ مَالِی وَامْرَأَتِی جَمِیعًا ؟ قَالَ : لاَ ، قَالَ : إِنَّ الَّذِی أَمَرْتَہُ أَنْ یُلاَعِنَ بَیْنَنَا قَالَ لاَ شَیْئَ لَکَ ، قَالَ : وَفَعَلَ ذَلِکَ ؟ قَالَ : نَعَمْ! قَالَ : فَجِئْتُ قَالَ : فَقَالَ أَبُو بُرْدَۃَ : مَا یَقُوْلُ ہَذَا ؟ قَالَ : قُلْتُ : وَمَا یَقُوْلُ ؟ قَالَ : یَقُوْلُ : ذَہَبَتِ امْرَأَتُہُ وَمَالُہُ ، قَالَ : قُلْتُ : مَا یَحْمِلُ الفُسَّاقَ عَلَی أَنْ یَزْنُوا ؟ یَتَزَوَّجُ المَرْأَۃَ ثُمَّ یَقْذِفُہَا ثُمَّ یُلاَعِنُہَا ویَأْخُذُ مَالَہُ ؟ قَالَ : فَکَتَبَ بِہِ إِلَی الحَجَّاجِ قَالَ : فَقَالَ : صَدَقَ ، قَالَ : ثُمَّ إِنَّ رَجُلاً أَتَانِی ، قَالَ : فَظَنَنْتُ أَنَّ الحَجَّاجَ أَمَرَہُ ، فَقَالَ : الَّذِی قُلْتَ أَشَیْئٌ قُلْتَہُ بِرَأْیِکَ ، أَوْ شَیْئٌ بَلَغَکَ ؟ قُلْتُ : قَضَی بِہِ رَسُوْلُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی أُخْتِ بَنِی العَجْلاَن۔n(بخاری ۵۳۴۹۔ مسلم ۴)","","Musannaf Ibn Abi Shaybah 17672","","","كتاب النكاح"
"17673","(۱۷۶۷۳) حَدَّثَنَا عِیْسَی بْنُ یُوْنُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بِنْ أَبِی کَثِیْرٍ أَنَّ عَلِیَّاً أُتِیَ فِیَ امْرَأَۃٍ تَزَوَّجَتْ رَجُلاً عَلَی أَنَّ عَلَیْہَا الصَّدَاقَ وبِیَدِہَا الفُرْقَۃُ والجِمَاعُ ، فَقَالَ عَلِیٌّ : خَالَفْتَ السُّنَّۃَ وَوَلَّیْتَ الأَمْرَ غَیْرَ أَہْلِہِ، عَلَیْکَ الصَّدَاقُ وَبِیَدِکَ الجِمَاعُ والفُرْقَۃُ ، وَلَکَ السُّنَّۃُ۔","","Musannaf Ibn Abi Shaybah 17673","","","كتاب النكاح"
"17674","(۱۷۶۷۴) حَدَّثَنَا غُنْدَرٌ عَنْ أَشْعَثَ ، عَنِ الحَسَنِ قَالَ : لَیْسَ لِلنِّسَائِ أَنْ یَصْدُقْنَ الرِّجَالَ۔","","Musannaf Ibn Abi Shaybah 17674","","","كتاب النكاح"
"17675","(۱۷۶۷۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَمَّادِ بْنِ أبِی الدَّرْدَائِ قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنْ رَجُلٍ زَوَّجَ أُخْتَاً لَہُ بِوَاسِطَۃٍ فَکَرِہَتْ قَالَ: ہِیَ أَحَقُّ بِنَفْسِہَا قُلْتُ: إِنَّہُ أَخُوْہَا لأَبِیْہَا وَأُمِّہَا۔ قَالَ: ہِیَ أَحَقُّ بِنَفْسِہَا مِنْ أَبِیْہَا إِذَا کَرِہَتْ۔","","Musannaf Ibn Abi Shaybah 17675","","","كتاب النكاح"
"17676","(۱۷۶۷۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الحَسَنِ فِی رَجُلٍ زَوَّجَ أُخْتَہُ وأَبُوہَا غَائِبٌ قَالَ : الأَمْرُ إِلَی أَبِیْہَا۔","","Musannaf Ibn Abi Shaybah 17676","","","كتاب النكاح"
"17677","(۱۷۶۷۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ بَکْرٍ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ قَالَ : خَطَبْت امْرَأَۃً ، فَقَالَ لِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَلْ نَظَرْت إلَیْہَا ؟ قُلْتُ : لاَ ، قَالَ : فَانْظُرْ إلَیْہَا ، فَإِنَّہُ أَحْرَی أَنْ یُؤْدَمَ بَیْنَکُمَا۔n(ترمذی ۱۰۸۷۔ ابن ماجہ ۱۸۶۵)","","Musannaf Ibn Abi Shaybah 17677","","","كتاب النكاح"
"17678","(۱۷۶۷۸) حَدَّثَنَا یُونُسُ بن مُحَمَّدٍ قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنِ زِیَاد قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ دَاوُدَ بْنِ الْحُصَیْنِ ، عَنْ وَاقِدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ سَعْدِ بْنِ مُعَاذٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا خَطَبَ أَحَدُکُمَ امْرَأَۃً فَإِنِ اسْتَطَاعَ أَنْ یَنْظُرَ مِنْہَا إلَی مَا یَدْعُوہُ إلَی نِکَاحِہَا فَلْیَفْعَلْ فَخَطَبْت جَارِیَۃً مِنْ بَنِی سَلِمَۃَ فَکُنْت أَتَخَبَّأُ تَحْتَ الْکَرَبِ حَتَّی نَظَرْت مِنْہَا إلَی مَا یَدْعُونِی إلَی نِکَاحِہَا فَتَزَوَّجْتہَا۔","","Musannaf Ibn Abi Shaybah 17678","","","كتاب النكاح"
"17679","(۱۷۶۷۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ مُحَمَّدِ بْنِ سُلَیْمَانَ ، عَنْ عَمِّہِ سَہْلِ بْنِ أَبِی حَثْمَۃَ ، عَنْ مُحَمَّدِ بْنِ مَسْلَمَۃَ قَالَ : خَطَبْت امْرَأَۃً فَجَعَلْتُ أَتَخَبَّأُ لَہَا حَتَّی نَظَرْت إلَیْہَا فِی نَخْلٍ لَہَا فَقِیلَ لہ: أَتَفْعَلُ ہَذَا وَأَنْتَ صَاحِبُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : فَقُلْتُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا أَلْقَی اللَّہُ فِی قَلْبِ امْرِئٍ مِنْکُمْ خِطْبَۃَ امْرَأَۃٍ فَلاَ بَأْسَ أَنْ یَنْظُرَ إلَیْہَا۔ (طبرانی ۵۰۰)","Da'if","Musannaf Ibn Abi Shaybah 17679","","","كتاب النكاح"
"17680","(۱۷۶۸۰) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنِ ابن طَاوُوسٍ قَالَ : أَرَدْت أَنْ أَتَزَوَّجَ امْرَأَۃً ، فَقَالَ لِی أَبِی : اذْہَبْ فَانْظُرْ إلَیْہَا قَالَ : فَلَبِسْت وَتَہَیَّأْت فَلَمَّا رَآنِی قَالَ : لاَ تَذْہَبْ۔","","Musannaf Ibn Abi Shaybah 17680","","","كتاب النكاح"
"17681","(۱۷۶۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ رَبِیعٍ ، عَنِ الْحَسَنِ قَالَ : لاَ بَأْسَ أَنْ یَنْظُرَ إلَیْہَا قَبْلَ أَنْ یَتَزَوَّجَہَا۔","","Musannaf Ibn Abi Shaybah 17681","","","كتاب النكاح"
"17682","(۱۷۶۸۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زَمْعَۃَ ، عَنِ الزُّہْرِیِّ فِی الرَّجُلِ یَتَزَوَّجُ الْمَرْأَۃَ قَالَ : لاَ بَأْسَ أَنْ یَنْظُرَ إلَیْہَا قَبْلَ أَنْ یَتَزَوَّجَہَا لأَنَّ اللَّہَ عَزَّ وَجَلَّ یَقُولُ : {وَلَوْ أَعْجَبَک حُسْنُہُنَّ}۔","","Musannaf Ibn Abi Shaybah 17682","","","كتاب النكاح"
"17683","(۱۷۶۸۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عن سہل بن مُحَمَّدِ بْنِ أَبِی حَثْمَۃَ ، عَنْ عَمِّہِ سلیمان بْنِ أَبِی حَثْمَۃَ قَالَ : رَأَیْتُ مُحَمَّدَ بْنَ مَسْلَمَۃَ یُطَارِدُ نُبَیْتَۃَ بِنْتَ الضَّحَّاکِ وَہِیَ عَلَی إِنْجَارٍ مِنْ أَنَاجِیرِ الْمَدِینَۃِ بِبَصَرِہِ ، فَقُلْتُ : أَتَفْعَلُ ہَذَا ؟ قَالَ : نَعَمْ ، سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إذَا أَلْقَی اللَّہُ فِی قَلْبِ امْرِئٍ خِطْبَۃَ امْرَأَۃٍ فَلاَ بَأْسَ أَنْ یَنْظُرَ إلَیْہَا۔ (ابن حبان ۴۰۴۲)","Da'if","Musannaf Ibn Abi Shaybah 17683","","","كتاب النكاح"
"17684","(۱۷۶۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ قَالَ : سَأَلْتُ عَبِیْدَۃَ ، عَنْ قَوْلِہِ : {فِی یَتَامَی النِّسَائِ اللاَّتِی لاَ تُؤْتُونَہُنَّ مَا کُتِبَ لَہُنَّ وَتَرْغَبُونَ أَنْ تَنْکِحُوہُنَّ} قَالَ : تَرْغَبُونَ فِیہِنَّ۔","","Musannaf Ibn Abi Shaybah 17684","","","كتاب النكاح"
"17685","(۱۷۶۸۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ فِی ہَذِہِ : تَرْغَبُونَ عَنْہُنَّ۔","","Musannaf Ibn Abi Shaybah 17685","","","كتاب النكاح"
"17686","(۱۷۶۸۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ فِی قَوْلِہِ : {وَمَا یُتْلَی عَلَیْکُمْ فِی الْکِتَابِ فِی یَتَامَی النِّسَائِ اللاَّتِی لاَ تُؤْتُونَہُنَّ مَا کُتِبَ لَہُنَّ وَتَرْغَبُونَ أَنْ تَنْکِحُوہُنَّ} قَالَتْ : أُنْزِلَتْ فِی الْیَتِیمَۃِ تَکُونُ عِنْدَ الرَّجُلِ فَتَشْرَکُہُ فِی مَالِہِ فَیَرْغَبُ عَنْہا أَنْ یَتَزَوَّجَہَا وَیَکْرَہَ أَنْ یَتَزَوَّجَہَا غَیْرُہُ فَیَشْرَکَہُ فِی مَالِہِ فَیَعْضُلَہَا فَلاَ یَتَزَوَّجُہَا وَلاَ یُزَوِّجُہَا غَیْرَہُ۔ (بخاری ۵۱۳۱۔ مسلم ۲۳۱۵)","Sahih","Musannaf Ibn Abi Shaybah 17686","","","كتاب النكاح"
"17687","(۱۷۶۸۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، عَنْ عُمَرَ ، قَالَ : مَنْ کَانَتْ عِنْدَہُ فِی حِجْرِہِ تَرَکَۃٌ بِہَا عُوَارٌ فَلْیَضُمَّہَا إلَیْہِ ، وَإِنْ کَانَتْ رَغبَۃً بِہِ فَلْیُزَوِّجْہَا غَیْرَہُ۔","","Musannaf Ibn Abi Shaybah 17687","","","كتاب النكاح"
"17688","(۱۷۶۸۸) حَدَّثَنَا عُبَیْدُ اللہِ عن إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی سَلَمَۃَ : {وَتَرْغَبُونَ أَنْ تَنْکِحُوہُنَّ} قَالَ : الْمَرْأَۃُ یَکُونُ بِہَا عَرَجٌ ، أَوْ عَوَرٌ فَلاَ یَنْکِحُونَہَا حَتَّی یَرِثُوہَا۔","","Musannaf Ibn Abi Shaybah 17688","","","كتاب النكاح"
"17689","(۱۷۶۸۹) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ عَمَّارٍ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ : {وَمَا یُتْلَی عَلَیْکُمْ فِی الْکِتَابِ فِی یَتَامَی النِّسَائِ} قَالَ : مَا یُتْلَی عَلَیْکُمْ فِی أَوَّلِ السُّورَۃِ مِنَ الْمَوَارِیثِ ، وَکَانُوا لاَ یُوَرِّثُونَ امْرَأَۃً وَلاَ صَبِیًّا حَتَّی یَحْتَلِمَ۔","","Musannaf Ibn Abi Shaybah 17689","","","كتاب النكاح"
"17690","(۱۷۶۹۰) حَدَّثَنَا عُبَیْدُ اللہِ عن إسْرَائِیلَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی مَالِکٍ فِی قَوْلِ اللہِ : {وَمَا یُتْلَی عَلَیْکُمْ فِی الْکِتَابِ فِی یَتَامَی النِّسَائِ اللاَّتِی لاَ تُؤْتُونَہُنَّ مَا کُتِبَ لَہُنَّ وَتَرْغَبُونَ أَنْ تَنْکِحُوہُنَّ} ، فَقَالَ : کَانَتِ الْمَرْأَۃُ إذَا کَانَتْ عِنْدَ وَلِیٍّ رَغِبَ عَنْ حَسَبِہَا ، أَوْ حُسْنِہَا ، شَکَّ أَبُو بَکْرٍ ، ثُمَّ تَزَوَّجَہَا وَلَمْ یَتْرُکْ أَحَدًا یَتَزَوَّجُہَا : {وَالْمُسْتَضْعَفِینَ مِنَ الْوِلْدَانِ وَأَنْ تَقُومُوا لِلْیَتَامَی بِالْقِسْطِ} قَالَ : کَانُوا لاَ یُوَرِّثُونَ إلاَّ الأَکْبَرَ فَالأَکْبَرَ۔","","Musannaf Ibn Abi Shaybah 17690","","","كتاب النكاح"
"17691","(۱۷۶۹۱) حَدَّثَنَا أَبُو خَالِد الأَحْمَر، عَنْ حَجَّاجِ، عَنْ قَتَادَۃَ، عَنِ الحَسَنِ أَنَّہُ کَرِہَ ذَبَائِحَہُمْ وَنِسَائَہُمْ، یَعْنِی الصَّابِئِیْنَ۔","","Musannaf Ibn Abi Shaybah 17691","","","كتاب النكاح"
"17692","(۱۷۶۹۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی مَالِکٍ : {فَانْکِحُوا مَا طَابَ لَکُمْ مِنَ النِّسَائِ} قَالَ : مَا حَلَّ لَکُمْ مِنَ النِّسَائِ ، ذَلِکَ أَدْنَی أَلاَّ تَعُولُوا۔","","Musannaf Ibn Abi Shaybah 17692","","","كتاب النكاح"
"17693","(۱۷۶۹۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ { وَإِنْ خِفْتُمْ أَلاَّ تقْسِطُوا فِی الْیَتَامَی فَانْکِحُوا مَا طَابَ لَکُمْ مِنَ النِّسَائِ} یَقُولُ : مَا أَحْلَلْت لَکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 17693","","","كتاب النكاح"
"17694","(۱۷۶۹۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ : { وَإِنْ خِفْتُمْ أَلاَّ تُقْسِطُوا فِی الْیَتَامَی} قَالَ : کَانَ الرَّجُلُ مِنْ قُرَیْشٍ یَکُونُ عِنْدَہُ النِّسْوَۃُ وَیَکُونُ عِنْدَہُ الأَیْتَامُ فَیَذْہَبُ مَالُہُ فَیَمِیلُ عَلَی الأَیْتَامِ فَنَزَلَتْ ہَذِہِ الآیَۃُ : {فَانْکِحُوا مَا طَابَ لَکُمْ مِنَ النِّسَائِ}۔","","Musannaf Ibn Abi Shaybah 17694","","","كتاب النكاح"
"17695","(۱۷۶۹۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ قَالَ : قَوْلُہُ : {وَالْمُحْصَنَاتُ مِنَ الَّذِینَ أُوتُوا الْکِتَابَ مِنْ قَبْلِکُمْ} قَالَ : إِحْصَانُ الیَہُوْدِیَۃِ وَالنَّصْرَانِیَۃِ أَنْ تَغْتَسِلَ مِنَ الجَنَابَۃِ وأَنْ تُحْصِنَ فَرْجَہَا۔","","Musannaf Ibn Abi Shaybah 17695","","","كتاب النكاح"
"17696","(۱۷۶۹۶) حَدَّثَنَا إدْرِیسُ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قولہ : {وَالْمُحْصَنَاتُ مِنَ الَّذِینَ أُوتُوا الْکِتَابَ مِنْ قَبْلِکُمْ} قَالَ: العَفَائِفُ۔","","Musannaf Ibn Abi Shaybah 17696","","","كتاب النكاح"
"17697","(۱۷۶۹۷) حدَّثَنَا ابْنُ إِدْرِیْسُ، عَنْ لَیْثٍ، عَنْ مُجَاہِدٍ قَالَ: {عَلِمَ اللّہُ أَنَّکُمْ سَتَذْکُرُونَہُنَّ} قَالَ: ذِکْرُہُ إِیَّاہَا فِی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 17697","","","كتاب النكاح"
"17698","(۱۷۶۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیْدَ ، عَنِ الحَسَنِ : {عَلِمَ اللّہُ أَنَّکُمْ سَتَذْکُرُونَہُنَّ} قَالَ : فِیَ الخِطْبَۃِ۔","","Musannaf Ibn Abi Shaybah 17698","","","كتاب النكاح"
"17699","(۱۷۶۹۹) أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ إِسْمَاعِیْل بِنْ رَافِعٍ ، عَنْ زَیْدِ بِنْ أَسْلَمَ ، قَالَ : سَمِعْتُہ یَقُوْلُ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ نَکَحَ امْرَأَۃً وَہُوَ یُرِیْدُ أَنْ یَذْہَبَ بِمَہْرِہَا فَہُوَ عِنْدَ اللہِ زَانٍ یَوْمَ القِیَامَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 17699","","","كتاب النكاح"
"17700","(۱۷۷۰۰) حَدَّثَنَا وَکِیْعٌ ، عَنْ مَالِکِ بِنِ مِغْوَلٍ ، عَنْ أُمِّ ہَمَدَانَ ، عَنْ عَمَّتِہَا ، عَنْ عَائِشَۃَ وَأُمِّ سَلَمَۃَ قَالَتَا : لَیْسَ شَیْئٌ أَشَدُّ مِنْ مَہْرِ امْرَأَۃٍ ، أَوْ أَجْرِ أَجِیْرٍ۔","Da'if","Musannaf Ibn Abi Shaybah 17700","","","كتاب النكاح"
"17701","(۱۷۷۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ ، عَنِ الحَکَمِ قَالَ: لاَ بأْسَ أَنْ یَتَزَوَّجَہا عَلَی مَا بَقِیَ مِنْ کِتَابَتِہَا۔","","Musannaf Ibn Abi Shaybah 17701","","","كتاب النكاح"
"17702","(۱۷۷۰۲) حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، عَنْ ہُرَیْمِ ، عَنْ بَیَانٍ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عَبَّاسٍ : {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ : تَمِیلُوا۔","Sahih","Musannaf Ibn Abi Shaybah 17702","","","كتاب النكاح"
"17703","(۱۷۷۰۳) حَدَّثَنَا جَرِیرٌ، عَنْ مُفَضَّلِ بْنِ مُہَلْہِلٍ، عَنْ مُغِیرَۃَ، عَنْ أَبِی رَزِینٍ {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ: تَمِیلُوا۔","","Musannaf Ibn Abi Shaybah 17703","","","كتاب النكاح"
"17704","(۱۷۷۰۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یُونُسَ ، عَنْ مُجَاہِدٍ : {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ : تَمِیلُوا۔","","Musannaf Ibn Abi Shaybah 17704","","","كتاب النكاح"
"17705","(۱۷۷۰۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ قُرَّۃَ ، عَنِ الْحَسَنِ : {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ : تَمِیلُوا۔","","Musannaf Ibn Abi Shaybah 17705","","","كتاب النكاح"
"17706","(۱۷۷۰۶) حَدَّثَنَا عَثَّام بْنُ عَلِیٍّ وَمُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی مَالِکٍ : {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ : تَمِیلُوا۔","","Musannaf Ibn Abi Shaybah 17706","","","كتاب النكاح"
"17707","(۱۷۷۰۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ جُوَیْبِر ، عَنِ الضَّحَّاکِ : {ذَلِکَ أَدْنَی أَنْ لاَ تَعُولُوا} قَالَ : تَمِیلُوا۔","","Musannaf Ibn Abi Shaybah 17707","","","كتاب النكاح"
"17708","(۱۷۷۰۸) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالاَ : یَجُوزُ تَزْوِیجُ الْمَرِیضِ وَبَیْعُہُ وَشِرَاؤُہُ۔","","Musannaf Ibn Abi Shaybah 17708","","","كتاب النكاح"
"17709","(۱۷۷۰۹) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إبْرَاہِیمَ فِی الْمَرِیضِ ہُوَ یَتَزَوَّجُ؟ قَالَ: ہُوَ جَائِزٌ مِنْ غَیْرِ الثَّلاَثِ۔","","Musannaf Ibn Abi Shaybah 17709","","","كتاب النكاح"
"17710","(۱۷۷۱۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : أَرَادَ عَبْدُ الرَّحْمَنِ ابْنُ أُمِّ الْحَکَمِ أَنْ یَشْتَرِیَ ثُمُنَہُ مِنْ بِنْتِ جَرِیرٍ وَہُوَ مَرِیضٌ فَأَبَتْ فَتَزَوَّجَ عَلَیْہَا ثَلاَثًا وَہُوَ مَرِیضٌ فَجَازَ۔","","Musannaf Ibn Abi Shaybah 17710","","","كتاب النكاح"
"17711","(۱۷۷۱۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ قَالَ : إنَّ مُعَاوِیَۃَ أَجَازَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 17711","","","كتاب النكاح"
"17712","(۱۷۷۱۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ الْبَاہِلِیِّ قَالَ : سَأَلْتُ عَطَائً عَنْ رَجُلٍ یَتَزَوَّجُ وَہُوَ مَرِیضٌ أَیَجُوزُ ذَلِکَ ؟ فَقَالَ : إنَّ النَّاسَ یَقُولُونَ إنَّہُ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 17712","","","كتاب النكاح"
"17713","(۱۷۷۱۳) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ یَتَزَوَّجُ وَہُوَ مَرِیضٌ قَالَ : إِنْ کَانَ مُضَارًّا لَمْ یَجُزْ ، وَإِنْ کَانَ إنَّمَا تَزَوَّجَہَا لِتَقُومَ عَلَیْہِ فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 17713","","","كتاب النكاح"
"17714","(۱۷۷۱۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْخَالِقِ ، عَنْ حَمَّادٍ فِی الرَّجُلِ یَتَزَوَّجُ فِی مَرَضِہِ قَالَ : ہُوَ مِنْ ثُلُثہ۔","","Musannaf Ibn Abi Shaybah 17714","","","كتاب النكاح"
"17715","(۱۷۷۱۵) حَدَّثَنَا أَبُو عَاصِمٍ ، عَنِ ابْنِ جُرَیْجٍ قَالَ : سَأَلْتُ عَطَائً ، عَنِ الْمَرِیضِ یَتَزَوَّجُ ؟ قَالَ : مَا أَرَاہُ إلاَّ حَدَثًا۔","","Musannaf Ibn Abi Shaybah 17715","","","كتاب النكاح"
"17716","(۱۷۷۱۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی الرَّجُلِ یَتَزَوَّجُ فِی مَرَضہ قَالَ : لاَ یَجُوزُ۔","","Musannaf Ibn Abi Shaybah 17716","","","كتاب النكاح"
"17717","(۱۷۷۱۷) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ خَلِیفَۃَ بْنِ غَالِبٍ قَالَ : سَأَلْتُ نَافِعًا عَنْہُ ، فَقَالَ : ہُوَ جَائِزٌ وَتَرِثُہُ وَتَأْخُذُ صَدَاقَہَا۔","","Musannaf Ibn Abi Shaybah 17717","","","كتاب النكاح"
"17718","(۱۷۷۱۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ خَلِیفَۃَ بْنِ غَالِبٍ ، عَنْ نَافِعٍ أَنَّ ابْنَ أَبِی رَبِیعَۃَ تَزَوَّجَ وَہُوَ مَرِیضٌ أَرَادَ أَنْ تَرِثَہُ ، وَکَانَ بَیْنَہُ وَبَیْنَہَا قَرَابَۃٌ۔","","Musannaf Ibn Abi Shaybah 17718","","","كتاب النكاح"
"17719","(۱۷۷۱۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیْدٍ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ مَسْرُوْقٍ قَالَ : کَانَتِ المَرْأَۃُ إِذَا ذَہَبَتْ إِلَی المُشْرِکِیْنَ أَعْطَوْا زَوْجَہَا مِثْلَ مَہْرِہَا وَإِذَا ذَہَبَتْ إِلَی قَوْمٍ لَیْسَ بَیْنَہَا وَبَیْنَہُمْ عَہْدٌ مِنَ المُشْرِکِیْنَ {فَعَاقَبْتُمْ} فَأَصَبْتُمْ غَنِیْمَۃً {فَآتُوا الَّذِینَ ذَہَبَتْ أَزْوَاجُہُم مِّثْلَ مَا أَنفَقُوا} یَقُوْلُ : ٰاتُوْا زَوْجَہَا مِنَ الغَنِیْمَۃِ مِثْلَ مَہْرِہَا۔","","Musannaf Ibn Abi Shaybah 17719","","","كتاب النكاح"
"17720","(۱۷۷۲۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیْدٍ ، عَنْ سُفْیَانَ ، عَنْ خَصِیْفٍ ، عَنْ مُجَاہِدٍ مِثْلَہُ ، أَوْ نَحْوَہُ۔","","Musannaf Ibn Abi Shaybah 17720","","","كتاب النكاح"
"17721","(۱۷۷۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُخْتَارِ بْنِ منیح ، عَنْ قَتَادَۃَ ، عَنْ عُرْوَۃَ بْنِ الزُّبَیْرِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : تَخَیَّرُوا لِنُطَفِکُمْ (ابن عدی ۲۱۸۷)","Da'if","Musannaf Ibn Abi Shaybah 17721","","","كتاب النكاح"
"17722","(۱۷۷۲۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیم أَنَّ عَلْقَمَۃَ کَانَ إذَا تَزَوَّجَ تَزَوَّجَ إلَی أَدْنَی بَیْتَۃٍ۔","","Musannaf Ibn Abi Shaybah 17722","","","كتاب النكاح"
"17723","(۱۷۷۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ الرَّبَذِیِّ ، عَنْ عَبْدِ اللہِ بْنِ خِرَاشٍ قَالَ : رَأَیْتُ أَبَا ذَرٍّ بِالرَّبَذَۃِ وَعِنْدَہُ امْرَأَۃٌ لَہُ سَحْمَائُ ، أَوْ شَحْبَائُ قَالَ : وَہُوَ فِی مِظَلَّۃٍ لَہُ سَوْدَائَ قَالَ : فَقِیلَ لَہُ : یَا أَبَا ذَرٍّ ، لَوِ اتَّخَذْت امْرَأَۃً ہی أَرْفَعَ مِنْ ہَذِہِ ، فَقَالَ : وَاللَّہِ لأَنْ أَتَّخِذَ امْرَأَۃً تَضَعُنِی أَحَبُّ إلَیَّ مِنْ أَنْ أَتَّخِذَ امْرَأَۃً تَرْفَعُنِی۔","Da'if","Musannaf Ibn Abi Shaybah 17723","","","كتاب النكاح"
"17724","(۱۷۷۲۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : قَالَ : عُمَرُ بْنُ الْخَطَّابِ : مَا بَقِیَ فِیَّ مِنْ أَخْلاَقِ الْجَاہِلِیَّۃِ شَیْئٌ إلاَّ أَنِّی لَسْتُ أُبَالِی أَیَّ الْمُسْلِمِینَ نَکَحْتُ وَأَیَّہُمْ أَنْکَحْتُ۔","","Musannaf Ibn Abi Shaybah 17724","","","كتاب النكاح"
"17725","(۱۷۷۲۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَ عَلْقَمَۃُ یَخْطُبُ إلَی مَنْ ہُوَ أَسْفَلُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 17725","","","كتاب النكاح"
"17726","(۱۷۷۲۶) حَدَّثَنَا یَزِیدُ قَالَ : حدَّثَنَا ہِشَام ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ؛ أَنَّ رَجُلاً تَزَوَّجَ ابْنَۃَ عَبْدٍ خَیَّاطٍ فَوَلَدَتْ عِنْدَہُ غُلاَمًا فَانْتَفَی مِنْہُ ، فَقَالَ لَہُ شُرَیْحٌ : مَا الَّذِی دَلَّک عَلَی أَنْ تَزَوَّجَ بِنْتَ عَبْدٍ خَیَّاطٍ وَأَنْتَ رَجُلٌ مِنَ الْعَرَبِ فِی شَرَفٍ مِنَ الْعَطَائِ ہو الَّذِی دَعَاک إلَی أَنْ تَنْتَفِیَ مِنْہُ ۔","","Musannaf Ibn Abi Shaybah 17726","","","كتاب النكاح"
"17727","(۱۷۷۲۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکٍ ، عَنْ إِسْمَاعِیلَ مَوْلَی بَنِی مَخْزُوْمٍ قَالَ : سَأَلْتُ عَطَائً عَنِ امْرَأَۃٍ قَالَتْ لِعَبْدِہَا: أُعْتِقَکَ عَلَی أَنْ تَزَوَّجَنِی فَقَالَ : لَوْ أَنَّہَا بَدَأَتْ یَعْتِقُہُ ! قَالَ : وَسَأَلْتُ عَبْدَ اللہِ بْنَ عُبَیْدِ بْنِ عُمَیْرٍ فَقَالَ مِثْلَ قَوْلِ عَطَائٍ ، قَالَ : فَسَأَلْتُ مُجَاہِدًا فغَضِبَ وَقَالَ : فِی ہَذِہِ عُقُوْبَۃٌ مِنَ اللہِ وَمِنَ السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 17727","","","كتاب النكاح"
"17728","(۱۷۷۲۸) حَدَّثَنَا وَکِیْعٌ ، عَنْ إِسْمَاعِیْلَ بَنْ مُسْلِمٍ ، عَنْ عَطَائٍ وَعبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ قَالاَ : تَعْتِقُہُ وَلاَ تُشَاطِرُہُ وَقَالَ مُجَاہِدٌ : فِی ہَذِہِ عُقُوْبَۃٌ مِنَ اللہِ وَمِنَ السُّلْطَانِ۔","","Musannaf Ibn Abi Shaybah 17728","","","كتاب النكاح"
"17729","(۱۷۷۲۹) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی قَوْلِہِ : {وَأُحْضِرَتِ الأَنْفُسُ الشُّحَّ} قَالَ : فِی النَّفَقَۃِ۔","","Musannaf Ibn Abi Shaybah 17729","","","كتاب النكاح"
"17730","(۱۷۷۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : نُصِیبُہَا مِنْ نَفْسِہِ وَمِنْ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 17730","","","كتاب النكاح"
"17731","(۱۷۷۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ قَالَ : النَّفَقَۃُ وَالأَیَّامُ۔","","Musannaf Ibn Abi Shaybah 17731","","","كتاب النكاح"
"17732","(۱۷۷۳۲) حدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ : {أَوْ أَکْنَنتُمْ فِی أَنفُسِکُمْ} قَالَ : ذَکَرَہُ إِیَّاہُ فِی نَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 17732","","","كتاب النكاح"
"17733","(۱۷۷۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الحَسَنِ : {أَوْ أَکْنَنتُمْ فِی أَنفُسِکُمْ} : الخِطْبَۃَ۔","","Musannaf Ibn Abi Shaybah 17733","","","كتاب النكاح"
"17734","(۱۷۷۳۴) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ وَحَمَّادٍ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا لِلنُّفَسَائِ أَنْ تُزَوَّجَ حَتَّی تَطْہُرَ۔","","Musannaf Ibn Abi Shaybah 17734","","","كتاب النكاح"
"17735","(۱۷۷۳۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ وَالْمُسَیِّبِ بْنِ رَافِعٍ أَنَّہُمَا قَالاَ فِی النُّفَسَائِ: لاَ تُزَوَّجُ حَتَّی یَذْہَبَ الدَّمُ۔","","Musannaf Ibn Abi Shaybah 17735","","","كتاب النكاح"
"17736","(۱۷۷۳۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ قَالاَ : فِی النُّفَسَائِ : تُزَوَّجُ ، وَإِنْ لَمْ یَذْہَبِ الدَّمُ۔","","Musannaf Ibn Abi Shaybah 17736","","","كتاب النكاح"
"17737","(۱۷۷۳۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : کَانَ یَکْرَہُہُ فَإِنْ تَزَوَّجَتْ فَالنِّکَاحُ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 17737","","","كتاب النكاح"
"17738","(۱۷۷۳۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الجَلْد بِنْ أَیُّوْبٍ ، عَنْ مَعَاوِیَۃ بْنِ قُرّۃ ، عَنْ عَائِذِ بْنِ عَمْروٍ رَجُلٌ مِنْ أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَ مِمَّنْ بَایَعَ تَحْتَ الشَّجَرَۃِ ؛ أَنَّ امْرَأَۃً مِنْ نِسَائِہِ نَفَسَتْ فَرَأَتِ الطُّہْرَ لِعِشْرِیَنَ لَیْلَۃً فَاغْتَسَلَتْ ثُمَّ جَائَتْ فَدَخَلَتْ مَعَہُ فِی لِحَافِہِ فَقَالَ : مَنْ ہَذِہِ ؟ فَقَالَتْ : فُلاَنَۃُ ، فَقَالَ : أَوَلَیْسَ قَدْ نَفِسْت ؟ قَالَتْ : إذًا قَدْ رَأَیْت الطُّہْرَ ، قَالَ : فَضَرَبَہَا بِرِجْلِہِ حَتَّی أَخْرَجَہَا مِنَ اللِّحَافِ وَقَالَ : لاَ تغُرنی عَنْ دِینِی حَتَّی یَمْضِیَ أَرْبَعُونَ یَوْمًا۔","Da'if","Musannaf Ibn Abi Shaybah 17738","","","كتاب النكاح"
"17739","(۱۷۷۳۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، عَنْ عُثْمَانَ بْنِ أَبِی الْعَاصِ أَنَّہُ قَالَ : لِنِسَائِہِ : لاَ تَشَرَّفْنَ لِی دُونَ أَرْبَعِینَ لَیْلَۃً فِی النِّفَاسِ۔","Da'if","Musannaf Ibn Abi Shaybah 17739","","","كتاب النكاح"
"17740","(۱۷۷۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ اللہِ بْنِ یَسَارٍ ، عَنْ عُمَرَ ، قَالَ : تَجْلِسُ النُّفَسَائُ أَرْبَعِینَ یَوْمًا۔","Da'if","Musannaf Ibn Abi Shaybah 17740","","","كتاب النكاح"
"17741","(۱۷۷۴۱) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ أَبِیہِ، عَنِ الْحَسَنِ قَالَ: تَرَبَّصُ النُّفَسَائُ أَرْبَعِینَ یَوْمًا ثُمَّ تَغْتَسِلُ وَتُصَلِّی، وَقَالَ الشَّعْبِیُّ : تَرَبَّصُ شَہْرَیْنِ ثُمَّ ہِیَ بِمَنْزِلَۃِ الْمُسْتَحَاضَۃِ۔","","Musannaf Ibn Abi Shaybah 17741","","","كتاب النكاح"
"17742","(۱۷۷۴۲) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : لاَ تَجْلِسُ النُّفَسَائُ أَکْثَرَ مِنْ أَرْبَعِینَ لیلۃ ، وقَالَ : عَطَائٌ : تَجْلِسُ عَادَتَہَا الَّتِی اعْتَادَتْ ، وَلاَ تَجْلِسُ أَکْثَرَ مِنْ أَرْبَعِینَ لَیْلَۃً۔","","Musannaf Ibn Abi Shaybah 17742","","","كتاب النكاح"
"17743","(۱۷۷۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ یُوسُفَ بْنِ مَاہَکٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : تَجْلِسُ النُّفَسَائُ نَحْوًا مِنْ أَرْبَعِینَ یَوْمًا۔","Sahih","Musannaf Ibn Abi Shaybah 17743","","","كتاب النكاح"
"17744","(۱۷۷۴۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زُہَیْرٍ قَالَ : حدَّثَنَا عَلِیُّ بْنُ عَبْدِ الأَعْلَی ، عَنْ أَبِی سَہْلٍ ، عَنْ مُسَّۃَ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : کَانَتِ النُّفَسَائُ تَقْعُدُ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْبَعِینَ یَوْمًا ، وَکُنَّا نُلَطِّخُ عَلَی وُجُوہِنَا الْوَرْسَ مِنَ الْکَلَفِ۔ (ترمذی ۱۳۹۔ ابوداؤد ۳۱۵)","Da'if","Musannaf Ibn Abi Shaybah 17744","","","كتاب النكاح"
"17745","(۱۷۷۴۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ أَنَّہُ سَأَلَ ابْنَ عَبَّاسٍ عَنْ رَجُلٍ اشْتَرَی جَارِیَۃً وَہِیَ حَامِلٌ أَیَطَأُہَا ؟ قَالَ : لاَ ، وَقَرَأَ : (وَأُولاَتُ الأَحْمَالِ أَجَلُہُنَّ أَنْ یَضَعْنَ حَمْلَہُنَّ)۔","Sahih","Musannaf Ibn Abi Shaybah 17745","","","كتاب النكاح"
"17746","(۱۷۷۴۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ قَالَ : قُلْتُ لَہُ : إنَّ أَبَا مُوسَی نَہَی حِینَ فَتَحَ تُسْتَرَ : أَلاَ تُوطَأُ الْحَبَالَی ، وَلاَ یُشَارِکُ الْمُشْرِکِینَ فِی أَوْلاَدِہِمْ ، فَإِنَّ الْمَائَ یَزِیدُ فِی الْوَلَدِ ، أَشَیْئٌ قَالَہُ بِرَأْیِہِ ؟ أَوْ شَیْئٌ رَوَاہُ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ أَوْطَاسٍ أَنْ تُوطَأَ حَامِلٌ حَتَّی تَضَعَ ، أَوْ حَائل حَتَّی تُسْتَبْرَأَ۔","","Musannaf Ibn Abi Shaybah 17746","","","كتاب النكاح"
"17747","(۱۷۷۴۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی قِلاَبَۃَ قَالَ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ مِنَّا مَنْ وَطِیئَ حُبْلَی۔","","Musannaf Ibn Abi Shaybah 17747","","","كتاب النكاح"
"17748","(۱۷۷۴۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَہُ۔ (احمد ۱/۲۵۶۔ طبرانی ۱۲۰۹۰)","","Musannaf Ibn Abi Shaybah 17748","","","كتاب النكاح"
"17749","(۱۷۷۴۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی مَرْزُوقٍ ، مَوْلَی تُجِیبَ ، قَالَ : غَزَوْنَا مَعَ رُوَیْفِعِ بْنِ ثَابِتٍ الأَنْصَارِیِّ نَحْوَ الْمَغْرِبِ فَفَتَحْنَا قَرْیَۃً یُقَالُ لَہَا جَرْبَۃُ قَالَ : فَقَامَ فِینَا خَطِیبًا ، فَقَالَ : إنِّی لاَ أَقُولُ فِیکُمْ إلاَّ مَا سَمِعْت مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ فِینَا یَوْمَ خَیْبَرَ قَالَ : مَنْ کَانَ یُؤْمِنُ بِاللَّہِ وَالْیَوْمِ الآخِرِ فَلاَ یُسْقِیَنَّ مَائَہُ زَرْعَ غَیْرِہِ۔ (احمد ۴/۱۰۸۔ طبرانی ۴۴۸۳)","Hasan","Musannaf Ibn Abi Shaybah 17749","","","كتاب النكاح"
"17750","(۱۷۷۵۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ حَنَشٍ الصَّنْعَانِیِّ ، عَنْ أَبِی مَرْزُوقٍ ، مَوْلَی تُجِیبَ ، عَنْ رُوَیْفِعِ بْنِ ثَابِتٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 17750","","","كتاب النكاح"
"17751","(۱۷۷۵۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ اللہِ بْنِ زَیْدٍ ، عَنْ عَلِیٍّ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنْ تُوطَأَ الْحَامِلُ حَتَّی تَضَعَ ، أَوِ الْحَائِضُ حَتَّی تُسْتَبْرَأَ بِحَیْضَۃٍ۔","","Musannaf Ibn Abi Shaybah 17751","","","كتاب النكاح"
"17752","(۱۷۷۵۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ صِلَۃَ وَقُثَمٍ وَنَاجِیَۃَ بْنِ کَعْبٍ قَالُوا : أَیُّمَا رَجُلٍ اشْتَرَی جَارِیَۃً حُبْلَی فَلاَ یَطَؤُہَا حَتَّی تَضَعَ حَمْلَہَا وَأَیُّمَا رَجُلٍ اشْتَرَی جَارِیَۃً فَلاَ یَقْرَبْہَا حَتَّی تَحِیضَ۔","","Musannaf Ibn Abi Shaybah 17752","","","كتاب النكاح"
"17753","(۱۷۷۵۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : نُہِیَ أَنْ یَطَأَ الرَّجُلُ وَلِیدَۃً ، أَوِ امْرَأَۃً وَفِی بَطْنِہَا جَنِینٌ لِغَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 17753","","","كتاب النكاح"
"17754","(۱۷۷۵۴) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ قَالَ: لَمَّا فُتِحَتْ تُسْتَرُ أَصَابَ أَبُو مُوسَی سَبَایَا فَکَتَبَ إلَیْہِ عُمَرُ أَنْ لاَ یَقَعَ أَحَدٌ عَلَی امْرَأَۃٍ حبلی حَتَّی تَضَعَ وَلاَ تُشَارِکُوا الْمُسْلِمِینَ فِی أَوْلاَدِہمْ فَإِنَّ الْمَائَ تَمَامُ الْوَلَدِ۔","Da'if","Musannaf Ibn Abi Shaybah 17754","","","كتاب النكاح"
"17755","(۱۷۷۵۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ مَعْمَرٍ، عَنْ عَمْرِو بْنِ مُسْلِمٍ، عَنْ طَاوُوسٍ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ مُنَادِیًا فنادی فِی غَزْوَۃٍ غَزَاہَا ؛ أَنْ لاَ یَطَأَ الرِّجَالُ حَامِلاً حَتَّی تَضَعَ ، وَلاَ حَائِلاً حَتَّی تَحِیضَ۔","","Musannaf Ibn Abi Shaybah 17755","","","كتاب النكاح"
"17756","(۱۷۷۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ قَالَ : حدَّثَنَا الْقَاسِمُ وَمَکْحُولٌ ، عَنْ أَبِی أُمَامَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی یَوْمَ خَیْبَرَ عن أَنْ تُوطَأَ الْحَبَالَی حَتَّی یَضَعْنَ۔","Da'if","Musannaf Ibn Abi Shaybah 17756","","","كتاب النكاح"
"17757","(۱۷۷۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَنْ یَزِیدَ بْنِ خُمَیْرٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَیْرِ بْنِ نُفَیْرٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی الدَّرْدَائِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ عَلَی امْرَأَۃٍ مُجِحٍّ وَہِیَ عَلَی بَابِ خِبَائٍ ، أَوْ فُسْطَاطٍ ، فَقَالَ : لِمَنْ ہَذِہِ ؟ فَقَالُوا : لِفُلاَنٍ ، قَالَ : أَیُلِمُّ بِہَا ؟ قَالُوا : نَعَمْ ، قَالَ : لَقَدْ ہَمَمْت أَنْ أَلْعَنَہُ لَعْنَۃً تَدْخُلُ مَعَہُ قَبْرَہُ ، فَکَیْفَ یَسْتَخْدِمُہُ وَہُوَ یَغْذُوہُ فِی بَصَرِہِ وَسَمْعِہِ ، کَیْفَ یَرِثُہُ وَہُوَ لاَ یَحِلُّ لَہُ۔n(مسلم ۱۰۶۶۔ ابوداؤد ۲۱۴۹)","Sahih","Musannaf Ibn Abi Shaybah 17757","","","كتاب النكاح"
"17758","(۱۷۷۵۸) حَدَّثَنَا ہُشَیْم ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ أَنَّ رَجُلاً کَانَتْ عِنْدَہُ یَتِیْمَۃٌ وکَانَتْ تَحْضُرُ مَعَہُ طَعَامَہُ قَالَ : فَخَافَتِ امْرَأَتہ أَنْ یَتَزَوَّجَہَا عَلَیْہَا قَالَ : وَغَابَ الرَّجُلُ غَیْبَۃً فَاسْتَعَانَتِ امْرَأَتہ نِسْوَۃً عَلَیْہَا فَضَبَطْنَہَا لَہَا وَأَفْسَدَتْ عُذْرَتَہَا بِیَدِہَا ، وَقَدِمَ الرَّجُلُ فَجَعَلَ یَفْقِدُہَا ، عَنْ مَائِدَتِہِ ، فَقَالَ لاِمْرَأَتِہِ : مَا شَأْنُ فُلاَنَۃَ لاَ تَحْضُرُ طَعَامِی کَمَا کَانَتْ تَحْضُرُ ؟ فَقَالَتْ : دَعْ عَنْک فُلاَنَۃَ ، فَقَالَ : مَا شَأْنُہَا ؟ قَالَ : فَقَذَفَتْہَا قَالَ : فَانْطَلَقَ الرجل حَتَّی دَخَلَ عَلَیْہَا ، فَقَالَ : مَا شَأْنُک ؟ مَا أَمْرُک ؟ قَالَ : فَجَعَلَتْ لاَ تَزِیدُ عَلَی الْبُکَائِ ، فَقَالَ : أَخْبِرِینِی فَأَخْبَرَتْہُ قَالَ : فَانْطَلَقَ إلَی عَلِیٍّ رضی اللہ عنہ فَذَکَرَ ذَلِکَ لَہُ فَأَرْسَلَ إلَی امْرَأَۃِ الرَّجُلِ وَإِلَی النِّسْوَۃِ فَسَأَلَہُنَّ قَالَ : فَمَا لَبِثْنَ أَنِ اعْتَرَفْنَ قَالَ : فَقَالَ لِلْحَسَنِ : اقْضِ فِیہَا ، فَقَالَ الْحَسَنُ : أَرَی الْحَدَّ عَلَی مَنْ قَذَفَہَا وَالْعُقْرَ عَلَیْہَا وَعَلَی الْمُمْسِکَاتِ قَالَ : فَقَالَ عَلِیٌّ : لَوْ کُلِّفت إبِلٌ طَحِینًا لَطَحَنَتْ قَالَ : وَمَا یَطْحَنُ یَوْمَئِذٍ بَعِیرٌ۔","Hasan","Musannaf Ibn Abi Shaybah 17758","","","كتاب النكاح"
"17759","(۱۷۷۵۹) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ أَنَّ جَوَارٍ أَرْبَعًا اجْتَمَعْنَ ، فَقَالَتْ إحْدَاہُنَّ : ہِیَ رَجُلٌ ، وَقَالَتِ الأُخْرَی : ہِیَ امْرَأَۃٌ وَقَالَتِ الثَّالِثَۃُ : أَنَا أَبُو الَّتِی زَعَمَتْ أَنَّہَا امْرَأَۃٌ وَقَالَتِ الرَّابِعَۃُ : أَنَا أَبُو الذی زَعَمَتْ أَنَّہَا رَجُلٌ، فَخَطَبَتِ الَّتِی زَعَمَتْ أَنَّہَا أَبُو الرَّجُلِ إلَی الَّتِی زَعَمَتْ أَنَّہَا أَبُو الْمَرْأَۃِ ، فَزَوَّجَتْہَا، فَأَفْسَدَتِ الَّتِی زَعَمَتْ أَنَّہَا رَجُلٌ الْجَارِیَۃَ الَّتِی زَوَّجَتْہَا ، فَاخْتَصَمُوا إلَی عَبْدِ الْمَلِکِ بْنِ مَرْوَانَ ، فَجَعَلَ صَدَاقَہَا عَلَی أَرْبَعَتِہِنَّ ، وَرَفَعَ حِصَّۃَ الَّتِی زَعَمَتْ أَنَّہَا امْرَأَۃٌ ، لأَنَّہَا أَمْکَنَتْ مِنْ نَفْسِہَا ، قَالَ : فَذَکَرَتْ ذَلِکَ لِعَبْدِ اللہِ بْنِ مَعقِلٍ الْمُزَنِیّ ، فَقَالَ : لَوْ أَنِّی وُلِّیتُ ذَلِکَ لَمْ أَرَ الصَّدَاقَ إلاَّ عَلَی الَّتِی أَفْسَدَتْہَا۔","","Musannaf Ibn Abi Shaybah 17759","","","كتاب النكاح"
"17760","(۱۷۷۶۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ أَنَّ امْرَأَۃً افْتَضَّتْ جَارِیَۃً بِأُصْبُعِہَا وَقَالَتْ : إنَّہَا زَنَتْ فَرَفَعَتْ إلَی عَلِیٍّ فَغَرَّمَہَا الْعُقْرَ وَضَرَبَہَا ثَمَانِینَ لِقَذْفِہَا إیَّاہَا۔","","Musannaf Ibn Abi Shaybah 17760","","","كتاب النكاح"
"17761","(۱۷۷۶۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنِ الشَّعْبِیِّ ؛ أَنَّ نِسْوَۃً کُنَّ بِالشَّامِ ، فَأَشِرْنَ وَبَطِرن وَلَعِبْنَ الْحُزُقَّۃَ ، فَرَکِبَتْ وَاحِدَۃٌ الأُخْرَی ، وَنَخَسَتِ الأُخْرَی ، فَأَذْہَبَتْ عُذْرَتَہَا ، فَرُفِعَ ذَلِکَ إلَی عَبْدِ الْمَلِکِ بْنِ مَرْوَانَ ، فَسَأَلَ عَنْ ذَلِکَ فَضَالَۃَ بْنَ عُبَیْدٍ وَقَبِیصَۃَ بْنَ ذُؤَیْبٍ ، فَقَالاَ : عَلَیْہِنَّ الدِّیَۃُ، وَیُرْفَعُ نَصِیبَ وَاحِدَۃٍ ، وَقَالَ ابْنُ مُعْقِلٍ : یَرَی مِنْ نَطَفِہَا إلَی نَاخِسَتِہَا ، وَقَالَ الشَّعْبِیُّ : وَأَنَا أَرَی ذَلِکَ وَلَہَا عُقْرُہَا۔","","Musannaf Ibn Abi Shaybah 17761","","","كتاب النكاح"
"17762","(۱۷۷۶۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ؛ أَنَّ جَارِیَتَیْنِ کَانَتَا بِالْحَمَّامِ ، فَدَفَعَتْ إحْدَاہُمَا الأُخْرَی فَانْتَقَضَتْ عُذْرَتُہَا ، فَقَضَی لَہَا شُرَیْحٌ : عَلَیْہَا بِمِثْلِ صَدَاقِہَا۔","","Musannaf Ibn Abi Shaybah 17762","","","كتاب النكاح"
"17763","(۱۷۷۶۳) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ أنَّہُ قَالَ فِی رَجُلَیْنِ تَزَوَّجَا أُخْتَیْنِ فَأُدْخِلَ عَلَی کُلِّ وَاحِدٍ مِنْہُمَا امْرَأَۃُ صَاحِبِہِ قَالَ لَہُمَا الصَّدَاقُ وَیَرْجِعُ الزَّوْجَانِ عَلَی مَنْ غَیَّرَہُمَا۔","","Musannaf Ibn Abi Shaybah 17763","","","كتاب النكاح"
"17764","(۱۷۷۶۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ أَنَّ عَلِیًّا قَالَ ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 17764","","","كتاب النكاح"
"17765","(۱۷۷۶۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ قَالَ ذَلِکَ أَیْضًا۔","","Musannaf Ibn Abi Shaybah 17765","","","كتاب النكاح"
"17766","(۱۷۷۶۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ قَالَ : تَزَوَّجَ أَخَوَانِ أُخْتَیْنِ ، فَأُدْخِلَتِ امْرَأَۃُ ہَذَا عَلَی ہَذَا ، وَامْرَأَۃُ ہَذَا عَلَی ہَذَا ، فَرُفِعَ ذَلِکَ إلَی عَلِیٍّ ، فَرَدَّ کُلَّ وَاحِدَۃٍ مِنْہُمَا إلَی زَوْجِہَا ، وَأَمَرَ زَوْجَہَا أَنْ لاَ یَقْرَبَہَا حَتَّی تَنْقَضِیَ عِدَّتُہَا ، وَجَعَلَ لِکُلِّ وَاحِدَۃٍ مِنْہُمَا الصَّدَاقَ عَلَی الَّذِی وَطِئَہَا لِغِشْیَانِہِ إیَّاہَا ، وَجَعَلَ جَہَازَہَا وَالْغُرْمَ عَلَی الَّذِی زَوَّجَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 17766","","","كتاب النكاح"
"17767","(۱۷۷۶۷) حدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی بَکْرٍ عَنَ أَبی مَسْعُوْدٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ مَہْرِ البَغِیِّ۔ (بخاری ۲۲۳۷۔ ترمذی ۱۲۷۶)","Sahih","Musannaf Ibn Abi Shaybah 17767","","","كتاب النكاح"
"17768","(۱۷۷۶۸) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا أَبَانُ الْعَطَّارُ قَالَ : حَدَّثَنِی یَحْیَی بْنُ أَبِی کَثِیرٍ ، عَنْ إبْرَاہِیمَ بْنِ قَارِظٍ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، عَنْ رَافِعِ بْنِ خَدِیجٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : کَسْبُ الْحَجَّامِ خَبِیثٌ وَمَہْرُ الْبَغِیِّ خَبِیثٌ۔ (مسلم ۱۱۹۹۔ ابوداؤد ۳۴۱۴)","Sahih","Musannaf Ibn Abi Shaybah 17768","","","كتاب النكاح"
"17769","(۱۷۷۶۹) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ کَسْب مَہْرِ الْبَغِیِّ۔ (احمد ۴/۳۰۸)","Sahih","Musannaf Ibn Abi Shaybah 17769","","","كتاب النكاح"
"17770","(۱۷۷۷۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ الْجَبَّارِ بْنِ عَبَّاسٍ ، عَنْ عَوْنِ بْنِ أَبِی جُحَیْفَۃَ ، عَنْ أَبِیہِ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ مَہْرِ الْبَغِیِّ۔ (ابویعلی ۸۹۲۔ طبرانی ۲۷۳)","Hasan","Musannaf Ibn Abi Shaybah 17770","","","كتاب النكاح"
"17771","(۱۷۷۷۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ فِی قَوْلِہِ : {وَمَنْ یُکْرِہْہُّنَّ فَإِنَّ اللَّہَ مِنْ بَعْدِ إکْرَاہِہِنَّ غَفُورٌ رَحِیمٌ} قَالَ : کَانَ عَبْدُ اللہِ بْنُ أُبَیِّ ابْنُ سَلُولَ یَقُولُ لِجَارِیَتِہِ : اذْہَبِی فَابْغِینَا شَیْئًا فَأَنْزَلَ اللَّہُ تَعَالَی : {وَلاَ تُکْرِہُوا فَتَیَاتِکُمْ عَلَی الْبِغَائِ إِنْ أَرَدْنَ تَحَصُّنًا لِتَبْتَغُوا عَرَضَ الْحَیَاۃِ الدُّنْیَا وَمَنْ یُکْرِہْہُّنَّ فَإِنَّ اللَّہَ مِنْ بَعْدِ إکْرَاہِہِنَّ غَفُورٌ رَحِیمٌ}۔ (مسلم ۲۶)","Hasan","Musannaf Ibn Abi Shaybah 17771","","","كتاب النكاح"
"17772","(۱۷۷۷۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : کَانُوا یُکْرِہُونَ أَنْ یَتَزَوَّجُوا عَلَی الدِّرْہَمِ وَالدِّرْہَمَیْنِ مِثْلَ مَہْرِ الْبَغِیِّ۔","","Musannaf Ibn Abi Shaybah 17772","","","كتاب النكاح"
"17773","(۱۷۷۷۳) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ أَبِی ہُرَیْرَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ مَہْرِ الْبَغِیِّ۔","Da'if","Musannaf Ibn Abi Shaybah 17773","","","كتاب النكاح"
"17774","(۱۷۷۷۴) حَدَّثَنَا مُعَاذُ بنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الحَسَنِ فِی رَجُلٍ تَزَوَّجَ أَمَۃً وَحُرَّۃً فِی عُقْدَۃٍ قَالَ : یُفَرَّقُ بَیْنَہُ وَبَیْنَ الأَمَۃِ ، أَوْ فِی رَجُلٍ تَزَوَّجَ أُخْتَیْنِ فِی عُقْدَۃٍ قَالَ : یُفَرَّقُ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17774","","","كتاب النكاح"
"17775","(۱۷۷۷۵) حَدَّثَنَا حَفْصُ بنُ غِیَاثٍ ، عَنْ أَبِی حَنِیْفَۃَ ، عَنْ حَمَّادٍ ، عَنْ إِبرَاہِیْمَ قَالَ : إِذَا تَزَوَّجَ حُرَّۃً وَأَمَۃً فِی عُقْدَۃٍ فَسَدَ نِکَاحُہُمَا۔","","Musannaf Ibn Abi Shaybah 17775","","","كتاب النكاح"
"17776","(۱۷۷۷۶) حَدَّثَنَا عَبْدَۃُ بنَ سُلَیْمَان ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الحَسَنِ ؛ فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً ، [corrupt]ُمَّ دَخَلَ بِہَا ، ثُمَّ مَاتَ ، ثُمَّ قَامَتِ البَیِّنَۃُ أَنَّہَا أُخْتُہُ مِنَ الرَّضَاعَۃِ قَالَ : لَہَا الصَّدَاقُ وَلاَ مِیْرَاثَ لَہَا۔","","Musannaf Ibn Abi Shaybah 17776","","","كتاب النكاح"
"17777","(۱۷۷۷۷) حَدَّثَنَا حَفْصُ بنُ غِیَاثٍ ، عَنِ الحَجَّاجِ ، عَنِ الرُّکَیْنِ ؛ أَنَّ المُغِیْرَۃَ ابْنَ شُعْبَۃَ خَطَبَ امْرَأَۃً، وَہُوَ وَلِیُّہَا، ومَعَہُ أَوْلِیَائُ مِثْلَہُ ، فأَمَرَ بَعْضَ أَوْلِیَائِہَا أَنْ یُزَوِّجَہَا إِیَّاہُ۔","","Musannaf Ibn Abi Shaybah 17777","","","كتاب النكاح"
"17778","(۱۷۷۷۸) حَدَّثَنَا مُعَاذُ بنُ مَعَاذٍ ، عَنْ أشْعَثَ ، عَنِ الحَسَنِ قَالَ : إِذَا أَرَادَ وَلِیُّ المَرْأَۃِ أَنْ یُزَوَّجِہَا بإِذْنِہَا مِنْ نَفْسِہِ وَلَّی أَمْرَہَا رَجُلاً ثُمَّ تَزَوَّجَہَا بِشَہَادَۃِ العُدُوْلِ۔","","Musannaf Ibn Abi Shaybah 17778","","","كتاب النكاح"
"17779","(۱۷۷۷۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ أَنَّہُ کَانَ لاَ یُجِیْزُ نِکَاحَ المُضْطَہَدِ۔","","Musannaf Ibn Abi Shaybah 17779","","","كتاب النكاح"
"17780","(۱۷۷۸۰) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : لاَ نِکَاحَ لِمُضْطَہَدٍ۔","","Musannaf Ibn Abi Shaybah 17780","","","كتاب النكاح"
"17781","(۱۷۷۸۱) حَدَّثَنَا عَبْدُ الأَعْلَی قَالَ : سُئِلَ عَنْ رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی عَاجِلٍ أَوْ آجِلٍ فَدَخَلَ بِہَا فَادَّعَتْ أنَّہُ لَمْ یَِبَِرأ إِلِیْہَا مِنَ العَاجِلِ فَقَالَ : حَدَّثَنَا سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّہُ کَانَ یَقُوْلُ : المَخْرَجُ عَلَیْہَا فِیَ العَاجِلِ ، أَنَّہُ بَقِیَ عَلَیْہِ کَذَا وکَذَا وَدُخُوْلُہُ عَلَیْہَا أَبْرَأَہُ۔","","Musannaf Ibn Abi Shaybah 17781","","","كتاب النكاح"
"17782","(۱۷۷۸۲) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنِ الحَسَنِ ومَطَرٍ، عَنِ الحَسَنِ أَنَّہُ کَانَ یَقُوْلُ: المَخْرَجُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 17782","","","كتاب النكاح"
"17783","(۱۷۷۸۳) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ أَنَّہُ شَکَّ فِی وَلَدٍ لَہُ فَأَمَرَ أَنْ یُدْعَی لَہُ الْقَافَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 17783","","","كتاب النكاح"
"17784","(۱۷۷۸۴) حَدَّثَنَا أَبُوبَکْرِ بْنُ عَیَّاشٍ، عَنْ أَسْلَمَ الْمُنْقِرِیِّ ، عَنْ عبد اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ قَالَ : بَاعَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ جَارِیَۃً کَانَ وَقَعَ عَلَیْہَا قَبْلَ أَنْ یَسْتَبْرِئَہَا فَظَہَرَ بِہَا حَمْلٌ عِنْدَ الَّذِی اشْتَرَاہَا فَخَاصَمَہُ إلَی عُمَرَ ، فَقَالَ عُمَرُ ہَلْ کُنْت تَقَعُ عَلَیْہَا ؟ قَالَ : نَعَمْ ، قَالَ : فَبِعْتہَا قَبْلَ أَنْ تَسْتَبْرِئَہَا ؟ قَالَ : نَعَمْ ، قَالَ : مَا کُنْت لِذَلِکَ بِخَلِیقٍ ، قَالَ : فَدَعَا الْقَافَۃَ فَنَظَرُوا إلَیْہِ فَأَلْحَقُوہُ بِہِ ، قَالَ : فَوُلِدَ لَہُ مِنْہَا ولد کَثِیرٌ فَمَا عَیَّرُوہُ بِہِ۔","","Musannaf Ibn Abi Shaybah 17784","","","كتاب النكاح"
"17785","(۱۷۷۸۵) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ عَطَائٍ فِی الرَّجُلِ یَشُکُّ فِی وَلَدِہِ قَالَ : مُرْہُ فَلْیَسْتَلْحِقْہُ فَإِنَّ عُمَرَ بْنَ الْخَطَّابِ قَالَ : مَنْ أَقَرَّ أَنَّہُ أَصَابَ وَلِیدَۃً ، أَوْ غَشِیَ أَلْحَقْنَا بِہِ وَلَدَہَا ، وَسَأَلْت عِکْرِمَۃَ بْنِ خَالِدٍ ، فَقَالَ : مُرْہُ فَلْیَسْتَلْحِقْہُ۔","","Musannaf Ibn Abi Shaybah 17785","","","كتاب النكاح"
"17786","(۱۷۷۸۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ رَجَائِ بْنِ حَیْوَۃَ ، عَنْ قَبِیصَۃَ بْنِ ذُؤَیْبٍ ، قَالَ : قَالَ عُمَرُ : حَصِّنُوہُنَّ ، أَوْ لاَ تُحْصِنُوہُنَّ ، لاَ تَلِدُ امْرَأَۃٌ مِنْہُنَّ عَلَی فِرَاشِ أَحَدِکُمْ إلاَّ أَلْحَقْتہ بِہِ یَعْنِی السَّرَارِیَّ۔","Sahih","Musannaf Ibn Abi Shaybah 17786","","","كتاب النكاح"
"17787","(۱۷۷۸۷) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمَّار ، عَنْ أَبِی مُسْلِمٍ ، عَنْ أَبِی عمْرَانَ ، عَنْ أَبِی یَحْیَی قَالَ: رَأَیْتُ رَجُلاً سَأَلَ ابْنَ عَبَّاسٍ ، فَقَالَ : یَا أبا عَبَّاسٍ إنِّی رَجُلٌ أَعْبَثُ بِذَکَرِی حَتَّی أُنْزِلَ ، قَالَ : فَقَالَ ابْنُ عَبَّاسٍ: أُفٍّ أُفٍّ ، ہُوَ خَیْرٌ مِنَ الزِّنَا وَنِکَاحُ الإِمَائِ خَیْرٌ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 17787","","","كتاب النكاح"
"17788","(۱۷۷۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عِصَام بْنِ قُدَامَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ ہُوَ الْفَاعِلُ بِنَفْسِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 17788","","","كتاب النكاح"
"17789","(۱۷۷۸۹) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ شَیْخٍ قَالَ: سُئِلَ ابْنُ عُمَرَ عَنْہَا یَعْنِی الْخَضْخَضَۃَ ، فَقَالَ: ذَاکَ الْفَاعِلُ بِنَفْسِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 17789","","","كتاب النكاح"
"17790","(۱۷۷۹۰) حَدَّثَنَا وَکِیعٌ، عَنْ أَفْلَحَ، عَنِ الْقَاسِمِ قَالَ: سُئِلَ عَنِ {الَّذِینَ ہُمْ لِفُرُوجِہِمْ حَافِظُونَ إلاَّ عَلَی أَزْوَاجِہِمْ، أَوْ مَا مَلَکَتْ أَیْمَانُہُمْ فَإِنَّہُمْ غَیْرُ مَلُومِینَ فَمَنِ ابْتَغَی وَرَائَ ذَلِکَ فَأُولَئِکَ ہُمَ الْعَادُونَ}: فَمَنِ ابْتَغَی وَرَائَ ذَلِکَ فَہُوَ عَادٍ۔","","Musannaf Ibn Abi Shaybah 17790","","","كتاب النكاح"
"17791","(۱۷۷۹۱) حدَّثَنَا ابْنُ نُمَیْرٍ وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الشِّغَارِ ، وَزَادَ ابْنُ نُمَیْرٍ : الشِّغَارُ أَنْ یَقُولَ الرَّجُلُ : زَوِّجْنِی ابْنَتَکَ حَتَّی أُزَوِّجَک ابْنَتِی ، أَوْ زَوِّجْنِی أُخْتَکَ حَتَّی أُزَوِّجَک أُخْتِی۔ (مسلم ۶۱۔ ابن ماجہ ۱۸۸۴)","Sahih","Musannaf Ibn Abi Shaybah 17791","","","كتاب النكاح"
"17792","(۱۷۷۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ وَعَبْدَۃ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ: نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الشِّغَارِ۔(بخاری ۶۹۶۰۔ مسلم ۵۸)","Da'if","Musannaf Ibn Abi Shaybah 17792","","","كتاب النكاح"
"17793","(۱۷۷۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ معقل ، عَنْ عَطَائٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلہ۔","","Musannaf Ibn Abi Shaybah 17793","","","كتاب النكاح"
"17794","(۱۷۷۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إِبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ قَالَ : کَانُوا یَکْرَہُونَ الشِّغَارَ وَالشِّغَارُ : الرَّجُلُ یُزَوِّجُ الرَّجُلَ عَلَی أَنْ یُزَوِّجَہُ بِغَیْرِ مَہْرٍ۔","Sahih","Musannaf Ibn Abi Shaybah 17794","","","كتاب النكاح"
"17795","(۱۷۷۹۵) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ فِی الْمُشَاغِرَیْنِ : یُقَرَّانِ عَلَی نِکَاحِہِمَا وَیُؤْخَذُ لِکُلِّ وَاحِدٍ مِنْہُمَا صَدَاقٌ۔","","Musannaf Ibn Abi Shaybah 17795","","","كتاب النكاح"
"17796","(۱۷۷۹۶) حَدَّثَنَا عَفَّانُ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ شِغَارَ فِی الإِسْلاَمِ۔ (ترمذی ۱۱۲۳۔ ابوداؤد ۲۵۷۴)","Hasan","Musannaf Ibn Abi Shaybah 17796","","","كتاب النكاح"
"17797","(۱۷۷۹۷) حَدَّثَنَا عُمَرُ بْنُ ہَارُونَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الشِّغَارِ۔ (مسلم ۶۲۔ احمد ۳/۳۳۹)","Da'if","Musannaf Ibn Abi Shaybah 17797","","","كتاب النكاح"
"17798","(۱۷۷۹۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِِ ، عَنِ الْمَسْعُودِیِّ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ قَالَ : عَلَّمَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ خُطْبَۃَ الصَّلاَۃِ وَخُطْبَۃَ الْحَاجَۃِ فَأَمَّا خُطْبَۃُ الصَّلاَۃِ فَالتَّشَہُّدُ ، وَأَمَّا خُطْبَۃُ الْحَاجَۃِ ، فَـ إِنَّ : الْحَمْدَ لِلَّہِ نَسْتَعِینُہُ وَنَسْتَغْفِرُہُ وَنَعُوذُ بِاللَّہِ مِنْ شُرُورِ أَنْفُسِنَا مَنْ یَہْدِہِ اللَّہُ فَلاَ مُضِلَّ لَہُ ، وَمَنْ یُضْلِلْ فَلاَ ہَادِیَ لَہُ ، وَأَشْہَدُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ وَأَشْہَدُ أنَّ مُحَمَّدًا عَبْدُہُ وَرَسُولُہُ ، ثُمَّ یَقْرَأُ ثَلاَثَ آیَاتٍ مِنْ کِتَابِ اللہِ : {اتَّقُوا اللَّہَ حَقَّ تُقَاتِہِ وَلاَ تَمُوتُنَّ إلاَّ وَأَنْتُمْ مُسْلِمُونَ} {وَاتَّقُوا اللَّہَ الَّذِی تَسَائَلُونَ بِہِ وَالأَرْحَامَ إنَّ اللَّہَ کَانَ عَلَیْکُمْ رَقِیبًا} {اتَّقُوا اللَّہَ وَقُولُوا قَوْلاً سَدِیدًا یُصْلِحْ لَکُمْ أَعْمَالَکُمْ وَیَغْفِرْ لَکُمْ ذُنُوبَکُمْ} ثُمَّ تَعْمِدُ لِحَاجَتِک۔ (ابوداؤد ۲۱۱۱۔ احمد ۱/۴۳۲)","","Musannaf Ibn Abi Shaybah 17798","","","كتاب النكاح"
"17799","(۱۷۷۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ أَنَّ الْحُسَیْنَ بْنَ عَلِیٍّ کَانَ یُزَوِّجُ بَعْضَ بَنَاتِ الْحَسَنِ وَہُوَ یتعرق العرق۔","","Musannaf Ibn Abi Shaybah 17799","","","كتاب النكاح"
"17800","(۱۷۸۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ نَصْرٍ ، عَنْ عَطَائٍ أَنَّہُ قَرَأَ بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ ثُمَّ زَوَّجَ۔","","Musannaf Ibn Abi Shaybah 17800","","","كتاب النكاح"
"17801","(۱۷۸۰۱) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ أَنَّ مَسْرُوقًا زَوَّجَ شُرَیْحًا وَلَمْ یَخْطُبْ ثُمَّ قَالَ : قَدْ قُضِیت تِلْکَ الْحَاجَۃَ۔","","Musannaf Ibn Abi Shaybah 17801","","","كتاب النكاح"
"17802","(۱۷۸۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، قَالَ : سَمِعْتُ عُرْوَۃَ بْنَ الزُّبَیْرِ یَقُولُ : خَطَبْت إلَی ابْنِ عُمَرَ ابْنَتَہُ ، فَقَالَ : إِنَّ ابْنَ أَبِی عَبْدِ اللہِ لأَہْلٌ أَنْ یُنْکَحَ ؟ نَحْمَدُ اللَّہَ وَنُصَلِّی عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَقَدْ زَوَّجْنَاک عَلَی مَا أَمَرَ اللَّہُ: {إمْسَاکٌ بِمَعْرُوفٍ ، أَوْ تَسْرِیحٌ بِإِحْسَانٍ} قَالَ : شُعْبَۃُ : أَحْسَبُہُ قَالَ : أَنْکَحَ عُمَرُ بْنُ الْخَطَّابِ رَجُلاً وَہُوَ یَمْشِی ، قَالَ : شُعْبَۃُ : قَالَ أَبُو بَکْرِ بْنُ حَفْصٍ : لاَ أَدْرِی الَّذِی قَالَ: أَحْسَبُہُ عُرْوَۃُ بْنُ الزُّبَیْرِ أَوِ ابْنُ عُمَرَ۔ (بیہقی ۱۴۷)","Sahih","Musannaf Ibn Abi Shaybah 17802","","","كتاب النكاح"
"17803","(۱۷۸۰۳) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ اللہِ بْنِ مُسْلِمٍ ، عَنْ حُمَیْدَۃَ مَوْلاَۃٍ لِعُمَرَ بْنِ عَبْدِ الْعَزِیزِ قَالَتْ : کَانَ عُمَرُ یَقُولُ : لاَ تَدَعِینَ بَنَاتِی یَنَمْنَ مُسْتَلْقِیَاتٍ عَلَی ظُہُورِہِنَّ فَإِنَّ الشَّیْطَانَ یَظَلُّ یَطْمَعُ مَا دُمْنَ کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17803","","","كتاب النكاح"
"17804","(۱۷۸۰۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ قَالَ : کَانَ ابْنُ سِیرِینَ یَکْرَہُ أَنْ تَکُونَ الْمَرْأَۃُ مُسْتَلْقِیَۃً۔","","Musannaf Ibn Abi Shaybah 17804","","","كتاب النكاح"
"17805","(۱۷۸۰۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : إذَا أَسْلَمَتِ الْمَرْأَۃُ وَلَہَا زَوْجٌ یَہُودِیٌّ ، أَوْ نَصْرَانِیٌّ ، أَوْ مَجُوسِیٌّ ، وَلَمْ یُسْلِمْ ہُوَ فَلاَ شَیْئَ لَہَا مَا لَمْ یَدْخُلْ بِہَا۔","","Musannaf Ibn Abi Shaybah 17805","","","كتاب النكاح"
"17806","(۱۷۸۰۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ شَیْئَ لَہَا۔","","Musannaf Ibn Abi Shaybah 17806","","","كتاب النكاح"
"17807","(۱۷۸۰۷) حَدَّثَنَا عَبَّادُ بن العَوام ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَلَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17807","","","كتاب النكاح"
"17808","(۱۷۸۰۸) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ بْنِ أَبِی حَفْصَۃَ ، عَنْ شُعْبَۃَ ، عَنِ الْہَیْثُمِ ، عَنْ حَمَّادٍ قَالَ : لَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17808","","","كتاب النكاح"
"17809","(۱۷۸۰۹) حَدَّثَنَا یَزِیدُ، عَنْ حَبِیبٍ ، عَنْ عَمْرِو بْنِ ہَرِمٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ؛ سُئِلَ عَنْ رَجُلٍ کَانَتْ تَحْتَہُ نَصْرَانِیَّۃٌ فَأَسْلَمَتْ ، وَأَبَی زَوْجُہَا أَنْ یُسْلِمَ قَالَ : أَرَی أَنْ یُفَرَّقَ بَیْنَہُمَا ، فَإِنْ کَانَ دَخَلَ بِہَا فَلَہَا الْمَہْرُ کَامِلاً ، وَإِنْ لَمْ یَکُنْ دَخَلَ بِہَا رَدَّتْ إلَیْہِ مَا أَعْطَاہَا۔","","Musannaf Ibn Abi Shaybah 17809","","","كتاب النكاح"
"17810","(۱۷۸۱۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّہُ قَالَ : لَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17810","","","كتاب النكاح"
"17811","(۱۷۸۱۱) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الشَّیْبَانِیِّ ، عَمَّنْ حَدَّثَہُ عَنْ مَسْرُوقٍ أَنَّہُ قَالَ : فِی رَجُلٍ أَقَرَّ لامْرَأَتِہِ بِصَدَاقِہَا فِی مَرَضِہِ قَالَ : لاَ یَجُوزُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17811","","","كتاب النكاح"
"17812","(۱۷۸۱۲) حَدَّثَنَا ہُشَیْمٌ ، عَنِ الْعَوَّامِ أَنَّ مَسْرُوقًا أَجَازَ إقْرَارَہُ۔","","Musannaf Ibn Abi Shaybah 17812","","","كتاب النكاح"
"17813","(۱۷۸۱۳) حَدَّثَنَا ہُشَیْمٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ قَالَ : یَجُوزُ إقْرَارُہُ لَہَا بِصَدَاقِ مِثْلِہَا۔","","Musannaf Ibn Abi Shaybah 17813","","","كتاب النكاح"
"17814","(۱۷۸۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یُجِیزُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17814","","","كتاب النكاح"
"17815","(۱۷۸۱۵) حَدَّثَنَا ہُشَیْمٌ ، عَنْ بَعْضِ أَصْحَابِہِ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ لاَ یُجِیزُ إقْرَارَہُ لَہَا لأَنَّہَا وَارِثٌ ، وَلاَ یَجُوزُ وَصِیَّۃٌ لِوَارِثٍ۔","","Musannaf Ibn Abi Shaybah 17815","","","كتاب النكاح"
"17816","(۱۷۸۱۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : الْقَوْلُ قَوْلُ الرَّجُلِ وَقَالَ حَمَّادُ ، وَابْنُ ذَکْوَانَ : الْقَوْلُ قَوْلُہَا مَا بَیْنَہَا وَبَیْنَ مَہْرِ مِثْلِہَا۔","","Musannaf Ibn Abi Shaybah 17816","","","كتاب النكاح"
"17817","(۱۷۸۱۷) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ : ہُوَ قَوْلُہَا مَا بَیْنَہَا وَبَیْنَ صَدَاقِ نِسَائِہَا۔","","Musannaf Ibn Abi Shaybah 17817","","","كتاب النكاح"
"17818","(۱۷۸۱۸) حَدَّثَنَا عَبْدُالرَّحْمَنِ بْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنْ عَطَائِ بْنِ السَّائِبِ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ وَعَنْ إسْمَاعِیلَ بْنِ سَالِمٍ، عَنِ الشَّعْبِیِّ قَالاَ: فِی رَجُلٍ تَزَوَّجَ امْرَأَۃً عَلَی عَاجِلٍ، أَوْ آجِلٍ فَدَخَلَ بِہَا قَالاَ: الْبَیِّنَۃُ أَنَّہُ دَفَعَہُ إلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17818","","","كتاب النكاح"
"17819","(۱۷۸۱۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ فِی الْمَرْأَۃِ تَدَّعِی الصَّدَاقَ بَعْدَ وَفَاۃِ زَوْجِہَا قَالَ : یَسْأَلُہَا الْبَیِّنَۃَ۔","","Musannaf Ibn Abi Shaybah 17819","","","كتاب النكاح"
"17820","(۱۷۸۲۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنِ الْحَکَمِ قَالَ : بینتہا وَقَالَ حَمَّادٌ : صَدَاقُ نِسَائِہَا۔","","Musannaf Ibn Abi Shaybah 17820","","","كتاب النكاح"
"17821","(۱۷۸۲۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : الْبَیِّنَۃُ عَلَی أَہْلِ الصَّدَاقِ أَوْلِیَائِ الْمَرْأَ[corrupt]ِ وَعَلَی أَہْلِ الرَّجُلِ الْمُخْرَجِ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17821","","","كتاب النكاح"
"17822","(۱۷۸۲۲) حدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنِ الْفُضَیْلِ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلِ یَقْذِفُ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا قَالَ : یُلاَعِنُہَا وَلَہَا نِصْفُ الصَّدَاقِ فَإِنْ ظَہَرَ بِہَا حَمْلٌ فَلَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17822","","","كتاب النكاح"
"17823","(۱۷۸۲۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ قَالَ : إذَا قَذَفَ الرَّجُلُ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا لاَعَنَہَا وَلَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17823","","","كتاب النكاح"
"17824","(۱۷۸۲۴) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَابْنِ عُمَرَ قَالاَ : إذَا قَذَفَہَا قَبْلَ أَنْ یَدْخُلَ بِہَا لاَعَنَہَا وَلَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17824","","","كتاب النكاح"
"17825","(۱۷۸۲۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 17825","","","كتاب النكاح"
"17826","(۱۷۸۲۶) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 17826","","","كتاب النكاح"
"17827","(۱۷۸۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا قَذَفَ الرَّجُلُ امْرَأَتَہُ قَبْلَ أَنْ یَدْخُلَ بِہَا لاَعَنَ وَلَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17827","","","كتاب النكاح"
"17828","(۱۷۸۲۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ قَالَ : إذَا کَانَ بِہَا حَمْلٌ فَلَہَا الصَّدَاقُ کَامِلاً۔","","Musannaf Ibn Abi Shaybah 17828","","","كتاب النكاح"
"17829","(۱۷۸۲۹) حَدَّثَنَا أَبُو بَحْرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : یُلاَعِنُ وَلَہَا نِصْفُ الصَّدَاقِ۔","","Musannaf Ibn Abi Shaybah 17829","","","كتاب النكاح"
"17830","(۱۷۸۳۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْسِمُ بَیْنَ نِسَائِہِ فَیَعْدِلُ ثُمَّ یَقُولُ : اللَّہُمَّ ہَذِہِ قِسْمَتِی فِیمَا أَمْلِکُ فَلاَ تَلُمْنِی فِیمَا تَمْلِکُ أَنْتَ وَلاَ أَمْلِکُ۔","","Musannaf Ibn Abi Shaybah 17830","","","كتاب النكاح"
"17831","(۱۷۸۳۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ: أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ، عَنْ عَائِشَۃَ قَالَتْ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقْسِمُ بَیْنَ نِسَائِہِ فَیَعْدِلُ ثُمَّ یَقُولُ : اللَّہُمَّ ہَذَا فِعْلِی فِیمَا أَمْلِکُ فَلاَ تَلُمْنِی فِیمَا تَمْلِکُ وَلاَ أَمْلِکُ۔ (احمد ۶/۱۴۴۔ ابن حبان ۴۲۰۵)","","Musannaf Ibn Abi Shaybah 17831","","","كتاب النكاح"
"17832","(۱۷۸۳۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ أَنَّ مُعَاذًا کَانَتْ لَہُ امْرَأَتَانِ ، وَکَانَ یَکْرَہُ أَنْ یَتَوَضَّأَ فِی یَوْمِ ہَذِہِ عِنْدَ ہَذِہِ ، أَوْ یَکُونَ فِی یَوْمِ ہَذِہِ عِنْدَ ہَذِہِ۔","","Musannaf Ibn Abi Shaybah 17832","","","كتاب النكاح"
"17833","(۱۷۸۳۳) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہَارُونَ بْنِ إبْرَاہِیمَ ، قَالَ : سَمِعْتُ مُحَمَّدًا یَقُولُ فِی الذی لہ امْرَأَتَانِ : یُکْرَہُ أَنْ یَتَوَضَّأَ فِی بَیْتِ إحْدَاہُمَا دُونَ الأُخْرَی۔","","Musannaf Ibn Abi Shaybah 17833","","","كتاب النكاح"
"17834","(۱۷۸۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ بکر ، عَنْ عُبَیْدٍ أَبِی الْحَزمِ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : کَانَتْ لِی امْرَأَتَانِ فَکُنْت أَعْدِلُ بَیْنَہُمَا حَتَّی فِی الْقُبَلِ۔","","Musannaf Ibn Abi Shaybah 17834","","","كتاب النكاح"
"17835","(۱۷۸۳۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ شَرِیکٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ یَعْدِلُوا بَیْنَ النِّسَائِ حَتَّی فِی الطِّیبِ ، یَتَطَیَّبُ لِہَذِہِ کَمَا یَتَطَیَّبُ لِہَذِہِ۔","","Musannaf Ibn Abi Shaybah 17835","","","كتاب النكاح"
"17836","(۱۷۸۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلِ یَجْمَعُ بَیْنَ الضَّرَائِرِ ، فَقَالَ : إِنْ کَانُوا لَیُسَوُّونَ بَیْنَہُمْ حَتَّی تَبْقَی الْفَضْلَۃُ مِمَّا لاَ یُکَالُ مِنَ السَّوِیقِ وَالطَّعَامِ ، فَیَقْسِمُونَہُ کَفًّا کَفًّا إذَا کَانَ یَبْقَی الشَّیْئُ مِمَّا لاَ یَسْتَطِعْ کَیْلَہُ۔","","Musannaf Ibn Abi Shaybah 17836","","","كتاب النكاح"
"17837","(۱۷۸۳۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : لَمَّا مَرِضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اسْتَحَلَّ نِسَائَہُ أَنْ یُمَرَّضَ فِی بَیْتِ عَائِشَۃَ قَالَ : فَأَحْلَلْنَ لَہُ ، فَکَانَ فِی بَیْتِ عَائِشَۃَ۔n(بخاری ۱۹۸۔ مسلم ۹۱)","","Musannaf Ibn Abi Shaybah 17837","","","كتاب النكاح"
"17838","(۱۷۸۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامِ بْنِ یَحْیَی ، عَنْ قَتَادَۃَ ، عَنِ النَّضْرِ بْنِ أَنَسٍ ، عَنْ بَشِیرِ بْنِ نَہِیکٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَت لَہُ امْرَأَتَانِ ، فَکَانَ یَمِیلُ مَعَ إحْدَاہُمَا عَلَی الأُخْرَی بُعِثَ یَوْمَ الْقِیَامَۃِ وَأَحَدُ شِقَّیْہِ سَاقِطٌ۔ (ترمذی ۱۱۴۱۔ ابوداؤد ۲۱۲۶)","Sahih","Musannaf Ibn Abi Shaybah 17838","","","كتاب النكاح"
"17839","(۱۷۸۳۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ غَالِبٍ قَالَ : سَأَلْتُ الْحَسَنَ ، أَوْ سُئِلَ عَنْ رَجُلٍ تَکُونُ لَہُ امْرَأَتَانِ فِی بَیْتٍ قَالَ : کَانُوا یَکْرَہُونَ الْوَجْسَ وَہُوَ أَنْ یَطَأَ إحْدَاہُمَا وَالأُخْرَی تری ، أَوْ تَسْمَعُ۔","","Musannaf Ibn Abi Shaybah 17839","","","كتاب النكاح"
"17840","(۱۷۸۴۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ أَبِی شَیْبَۃَ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ یُحَدِّثُ عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ یَنَامُ بَیْنَ جَارِیَتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 17840","","","كتاب النكاح"
"17841","(۱۷۸۴۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ شَرِیکٍ، عَنْ لَیْثٍ، عَنْ عَطَائٍ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَنَامَ الرَّجُلُ بَیْنَ الأَمَتَیْنِ۔","","Musannaf Ibn Abi Shaybah 17841","","","كتاب النكاح"
"17842","(۱۷۸۴۲) ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ عزرۃ عن شریح أَنّہ قَالَ فی رَجُلٍ أُہْدیَتْ إلَیْہِ امْرَأَتُہُ فَزَعَمَ أَنَّہُ لَمْ یَدْخُلْ بِہَا ، وَأَقَرَّتْ ہِیَ بِذَلِکَ ، فَقَضَی لَہَا بِنِصْفِ الصَّدَاقِ ، وَأَلْزَمَہَا الْعِدَّۃَ وَقَالَ : لاَ أُصدِّقُکَ عَلَی نَفْسِکَ وَلاَ أُصدِّقُکِ لِنَفْسِک۔","","Musannaf Ibn Abi Shaybah 17842","","","كتاب النكاح"
"17843","(۱۷۸۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ قَالَ : عَلَیْہِ کَامِلاً إِنْ شَائَتْ أَخَذَتْہُ ، وَإِنْ شَائَتْ تَرَکَتْہُ۔","","Musannaf Ibn Abi Shaybah 17843","","","كتاب النكاح"
"17844","(۱۷۸۴۴) حدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ قَالَ : سَأَلَ الشَّعْبِیَّ رَجُلٌ ، فَقَالَ رَجُلٌ قَالَ لِلرَّجُلِ : إذَا مَضَی شَوَّالٌ زَوَّجْتُک ابْنَتِی ، فَقَالَ : لَیْسَ ہَذَا بِنِکَاحٍ۔","","Musannaf Ibn Abi Shaybah 17844","","","كتاب النكاح"
"17845","(۱۷۸۴۵) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ فِی الْعَبْدِ یَتَزَوَّجُ بِإِذْنِ مَوْلاَہُ قَالَ : عَلَیْہِ النَّفَقَۃُ۔","","Musannaf Ibn Abi Shaybah 17845","","","كتاب النكاح"
"17846","(۱۷۸۴۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنِ الْحَسَنِ قَالَ : لاَ تَحَسَّرُ الْمَرْأَۃُ عِنْدَ وَلَدٍ وَلا وَالِدٍ وَلاَ أَخٍ إلاَّ عِنْدَ زَوْجِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 17846","","","كتاب النكاح"
"17847","(۱۷۸۴۷) حَدَّثَنَا وَکِیعٌ ، وَابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزَّعْرَائِ ، عَنْ عِکْرِمَۃَ قَالَ : مُبَاشَرَۃُ الرَّجُلِ أُمَّہُ وَأُخْتَہُ شُعْبَۃٌ مِنَ الزِّنَا۔","","Musannaf Ibn Abi Shaybah 17847","","","كتاب النكاح"
"17848","(۱۷۸۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ سَلْمَانَ قَالَ : مَا أُبَالِی إذَا خَلَوْت بِأَہْلِی وَأَغْلَقْت بَابِی وَأَرْخَیْت سِتْرِی حَدَّثْت بِہِ النَّاسَ ، أَوْ صَنَعْت ذَلِکَ وَالنَّاسُ یَنْظُرُونَ۔","Sahih","Musannaf Ibn Abi Shaybah 17848","","","كتاب النكاح"
"17849","(۱۷۸۴۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عُمَر بْنِ حَمْزَۃَ الْعُمَرِیِّ قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ سَعْدٍ مَوْلًی لأَبِی سُفْیَانَ ، قَالَ : سَمِعْتُ أَبَا سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ مِنْ شَرِّ النَّاسِ عِنْدَ اللہِ مَنْزِلَۃً یَوْمَ الْقِیَامَۃِ الرَّجُلَ یُفْضِی إلَی امْرَأَتِہِ وَتُفْضِی إلَیْہِ ثُمَّ یَنْشُرُ سِرَّہَا۔n(مسلم ۱۲۴۔ ابوداؤد ۴۸۳۷)","","Musannaf Ibn Abi Shaybah 17849","","","كتاب النكاح"
"17850","(۱۷۸۵۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنِ الطُّفَاوِیِّ ، عَنْ أَبِی ہریرۃ قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عسی أَحَدُکُمْ یُخْبِرُ بِمَا صَنَعَ بِأَہْلِہِ ؟ وَعَسَی إحْدَاکُنَّ أَنْ تُخْبِرَ بِمَا یصْنَعُ بِہَا زَوْجُہَا ، فَقَامَتِ امْرَأَۃٌ سَوْدَائُ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إنَّہُمْ لَیَفْعَلُونَ وَإِنَّہُنَّ لَیَفْعَلْنَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: أَلاَ أُخْبِرُکُمْ بِمَثَلِ ذَلِکَ؟ إنما مَثَلُ ذَلِکَ کَمَثَلِ شَیْطَانٍ لَقِیَ شَیْطَانَۃً فَوَقَعَ عَلَیْہَا فِی الطَّرِیقِ وَالنَّاسُ یَنْظُرُونَ فَقَضَی حَاجَتَہُ مِنْہَا وَالنَّاسُ یَنْظُرُونَ۔(ابوداؤد ۴۰۱۵۔ احمد ۲/۵۴۰)","Da'if","Musannaf Ibn Abi Shaybah 17850","","","كتاب النكاح"
"17851","(۱۷۸۵۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَوَّامٍ ، عَنْ مُجَاہِدٍ : {وَإِذَا مَرُّوا بِاللَّغْوِ مَرُّوا کِرَامًا} قَالَ : کانوا إذَا أَتَوْا عَلَی ذِکْرِ النِّکَاحِ کَنَوْا عَنْہُ۔","","Musannaf Ibn Abi Shaybah 17851","","","كتاب النكاح"
"17852","(۱۷۸۵۲) حَدَّثَنَا حَفْصٌ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ، عَنْ حَبِیبٍ قَالَ: کَانَ عُمَرُ لاَ یُجِیزُ النِّکَاحَ فِی عَامِ سَنَۃٍ یَعْنِی مَجَاعَۃً۔","","Musannaf Ibn Abi Shaybah 17852","","","كتاب النكاح"
"17853","(۱۷۸۵۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا أنْکَحَ الْمَرْأَۃَ الْوَلِیُّ فَلَمْ تَرْضَ ثُمَّ رَضِیَتْ بَعْدُ لَمْ یَصْلُحْ ذَلِکَ النِّکَاحُ حَتَّی یَکُونَ نِکَاحٌ جَدِیدٌ۔","","Musannaf Ibn Abi Shaybah 17853","","","كتاب النكاح"
"17854","(۱۷۸۵۴) حدَّثَنَا ہُشَیْمٌ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عُمَرَ ، قَالَ: إذَا أَقَرَّ بِوَلَدِہِ مَرَّۃً وَاحِدَۃً فَلَیْسَ لَہُ أَنْ یَنْفِیَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 17854","","","كتاب النكاح"
"17855","(۱۷۸۵۵) حَدَّثَنَا حَفْصٌ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ قَالَ : إذَا أَقَرَّ بِہِ فَلَیْسَ لَہُ أَنْ یَنْفِیَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 17855","","","كتاب النكاح"
"17856","(۱۷۸۵۶) حَدَّثَنَا حَفْصٌ، عَنْ مُجَالِدٍ، عَنْ شُرَیْحٍ قَالَ: إذَا أَقَرَّ بِہِ، أَوْ ہُنِّئَ بِہِ، أَوْ أَوْلَمَ عَلَیْہِ فَلَیْسَ لَہُ أَنْ یَنْتَفِیَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 17856","","","كتاب النكاح"
"17857","(۱۷۸۵۷) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ وَغَیْرِہِ ، عَنْ عُمَرَ ، قَالَ : إذَا أَقَرَّ بِالْوَلَدِ طَرْفَۃَ عَیْنٍ فَلَیْسَ لَہُ أَنْ یَنْفِیَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 17857","","","كتاب النكاح"
"17858","(۱۷۸۵۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ، عَنْ مُجَالِدٍ، عَنِ الشَّعْبِیِّ قَالَ: جَائَ رَجُلٌ بِابْنٍ لَہُ قَدْ أَقَرَّ بِہِ ثُمَّ أَرَادَ أَنْ یَنْفِیَہُ فَشَہِدُوا أَنَّہُ وُلِدَ فِی بَیْتِہِ وَأَنَّہُمْ ہَنَّؤُوہُ بِہِ وَأَقَرَّ بِہِ ، فَقَالَ شُرَیْحٌ : الْزَمْ وَلَدَک قَالَ عَامِرٌ : کان عُمَرَ یَقْضِی بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17858","","","كتاب النكاح"
"17859","(۱۷۸۵۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالَ : إذَا أَقَرَّ الرَّجُلُ بِوَلَدِہِ فَلَیْسَ لَہُ أَنْ یَنْفِیَہُ عَلَی حَالٍ۔","","Musannaf Ibn Abi Shaybah 17859","","","كتاب النكاح"
"17860","(۱۷۸۶۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ وَعُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا أَقَرَّ بِالْوَلَدِ فَلَیْسَ لَہُ أَنْ یَنْتَفِیَ مِنْہُ ، وَقَالَ حَمَّادٌ : إذَا أَقَرَّ بِالْحَمْلِ فَلَیْسَ لَہُ أَنْ یُنْکِرَہُ ، إِنْ شَائَ یَقُولُ : أَخْطَأْت فِی الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 17860","","","كتاب النكاح"
"17861","(۱۷۸۶۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ قَالَ : إذَا تَبَیَّنَ حَمْلُ سُرِّیَّتِہِ فَلَہُ إنْکَارُہُ مَا لَمْ یُقِرَّ بِہِ بَعْدَ مَا تَضَعُ ، وَإِنْ کَانَ قَدْ أَقَرَّ بِالْحَمْلِ ثُمَّ أَنْکَرَہُ بَعْدَ مَا تَضَعُ فَلَہُ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 17861","","","كتاب النكاح"
"17862","(۱۷۸۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ قَالَ : إذَا أَقَرَّ بِوَلَدِہِ ثُمَّ نَفَاہُ لَزِمَہُ۔","","Musannaf Ibn Abi Shaybah 17862","","","كتاب النكاح"
"17863","(۱۷۸۶۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا انْتَفَی الرَّجُلُ مِنْ وَلَدِہِ لاَعَنَ أُمَّہُ إِنْ کَانَتْ حَیَّۃً ، وَإِنْ کَانَتْ قَدْ مَاتَتْ جُلِدَ الْحَدَّ وَأُلْزِقَ بِہِ الْوَلَدُ فَإِنْ کَانَ ابْنَ سُرِّیَّۃٍ صَارَ عَبْدًا۔","","Musannaf Ibn Abi Shaybah 17863","","","كتاب النكاح"
"17864","(۱۷۸۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ وَالْحَکَمِ قَالاَ : إذَا أَقَرَّ بِوَلَدِہِ ثُمَّ نَفَاہُ قَالَ الْحَکَمُ : یُضْرَبُ وَقَالَ حَمَّادٌ : یَلْزَمُ الْوَلَدُ بِالإِقْرَارِ وَیُلاَعِنُ وَذَکَرَ أَنَّ سُفْیَانَ کَانَ یَقُولُہُ۔","","Musannaf Ibn Abi Shaybah 17864","","","كتاب النكاح"
"17865","(۱۷۸۶۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ سُفْیَانَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ فِی الرَّجُلِ یُقِرُّ بِوَلَدِہِ ثُمَّ یَنْتَفِی مِنْہُ قَالَ : یُلاَعِنُ بِکِتَابِ اللہِ وَیَلْزَمُ الْوَلَدُ بِقَضَائِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 17865","","","كتاب النكاح"
"17866","(۱۷۸۶۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ فِی رَجُلٍ أَقَرَّ بِوَلَدٍ لہ مِنْ جَارِیَتِہِ حَتَّی صَارَ رَجُلاً وَزَوَّجَہُ ثُمَّ أَنْکَرَہُ قَالَ : لَیْسَ إنْکَارُہُ بِشَیْئٍ ، یُلْزَقُ بِہِ۔","","Musannaf Ibn Abi Shaybah 17866","","","كتاب النكاح"
"17867","(۱۷۸۶۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ قَالَ لَہُ : أَنْ یَنْفِیَہُ ، وَإِنْ کَانَ رَجُلاً۔","","Musannaf Ibn Abi Shaybah 17867","","","كتاب النكاح"
"17868","(۱۷۸۶۸) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَاصِمٍ قَالَ : جَائَتِ امْرَأَۃٌ إلَی أَبِی مُوسَی وَأَبُوہَا وَزَوْجُہَا وَأُمُّہَا وَہِیَ حُبْلَی یَقُولُ زَوْجُہَا : ہِیَ جَارِیَۃٌ وَإِنَّمَا کُنْت أَلْعَبُ مَعَہَا فَکَلَّمَ الْجَارِیَۃَ ، فَقَالَتْ : زَوَّجَنِیہِ أَبِی وَأُمِّی ، وَکَانَ یَدْخُلُ عَلَیَّ فَیَصْنَعُ بِی مَا یَصْنَعُ الرَّجُلُ بِامْرَأَتِہِ قَالَ : فَضَرَبَ رَأْسَہُ بِالدِّرَّۃِ وَقَالَ : ہِیَ امْرَأَتُک وَالْوَلَدُ وَلَدُک۔","","Musannaf Ibn Abi Shaybah 17868","","","كتاب النكاح"
"17869","(۱۷۸۶۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ وَہُوَ قَوْلُ قَتَادَۃَ : {إذَا أُحْصِنَّ} قَالَ : إذَا أَحْصَنَتْہُنَّ الْبُعُولَۃُ۔","","Musannaf Ibn Abi Shaybah 17869","","","كتاب النكاح"
"17870","(۱۷۸۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَقْرَؤُہَا : {فَإِذَا أُحْصِنَّ} یَقُولُ : إذَا تَزَوَّجْنَ۔","","Musannaf Ibn Abi Shaybah 17870","","","كتاب النكاح"
"17871","(۱۷۸۷۱) حَدَّثَنَا ابْنُ إدْرِیسَ، عَنِ الأَعْمَشِِ، عَنْ إبْرَاہِیمَ، عَنِ الأَسْوَدِ، عَنْ عَائِشَۃَ قَالَتْ: کَانَ زَوْجُ بَرِیرَۃَ حُرًّا۔","","Musannaf Ibn Abi Shaybah 17871","","","كتاب النكاح"
"17872","(۱۷۸۷۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ قَالَ : کَانَ زَوْجُہَا حُرًّا۔","","Musannaf Ibn Abi Shaybah 17872","","","كتاب النكاح"
"17873","(۱۷۸۷۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ أَبِی مَعْشَرٍ ، عَنِ النَّخَعِیِّ ، عَنِ الأَسْوَدِ أَنَّ عَائِشَۃَ حَدَّثَتْہُ : أن زَوْجَ بَرِیرَۃَ کَانَ حُرًّا حِینَ أُعْتِقَتْ۔","","Musannaf Ibn Abi Shaybah 17873","","","كتاب النكاح"
"17874","(۱۷۸۷۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنْ صَفِیَّۃَ ابْنَۃِ أَبِی عُبَیْدٍ قَالَتْ : کَانَ زَوْجُ بَرِیرَۃَ عَبْدًا۔","","Musannaf Ibn Abi Shaybah 17874","","","كتاب النكاح"
"17875","(۱۷۸۷۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّ زَوْجَ بَرِیرَۃَ کَانَ عَبْدًا۔","Hasan","Musannaf Ibn Abi Shaybah 17875","","","كتاب النكاح"
"17876","(۱۷۸۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ عِکْرِمَۃَ ، أَنَّ زَوْجَ بَرِیرَۃَ کَانَ عَبْدًا أَسْوَدَ یُقَالُ لَہُ مُغِیثٌ ، عَبْدٌ لِبَنِی الْمُغِیرَۃِ مِنْ بَنِی مَخْزُومٍ۔","","Musannaf Ibn Abi Shaybah 17876","","","كتاب النكاح"
"17877","(۱۷۸۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ عَبْدًا أَسْوَدَ لِبَنِی الْمُغِیرَۃِ یُقَالُ لَہُ مُغِیثٌ کَأَنِّی أَنْظُرُ إلَیْہِ فِی طُرُقِ الْمَدِینَۃِ یَتْبَعُہَا وَدُمُوعُہُ تسیل عَلَی لِحْیَتِہِ یَتَرَضَّاہَا کَی تَخْتَارَہُ فَلَمْ تَخْتَرْہُ یَعْنِی زَوْجَ بَرِیرَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 17877","","","كتاب النكاح"
"17878","(۱۷۸۷۸) حَدَّثَنَا حَفْصٌ، عَنْ ہِشَامٍ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: کان زَوْجُ بَرِیرَۃَ عَبْدا أَسْوَدُ یُقَالُ لَہُ مُغِیثٌ۔","Sahih","Musannaf Ibn Abi Shaybah 17878","","","كتاب النكاح"
"17879","(۱۷۸۷۹) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ أَنَّہَا أَعْتَقَتْ بَرِیرَۃَ فَخَیَّرَہَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَ لَہَا زَوْجٌ حُرٌّ۔","Sahih","Musannaf Ibn Abi Shaybah 17879","","","كتاب النكاح"
"17880","(۱۷۸۸۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ سِمَاکٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : کَانَ زَوْجُ بَرِیرَۃَ عَبْدًا۔","Hasan","Musannaf Ibn Abi Shaybah 17880","","","كتاب النكاح"
"17881","(۱۷۸۸۱) حدَّثَنَا وَکِیعٌ ، عَنْ زِیَادِ بْنِ خَیْثَمَۃَ ، عَنْ نُعَیْمِ بْنِ أَبِی ہِنْدٍ ، عَنْ عُمَرَ الأَعْوَرِ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، قَالَ : قَالَتْ عَائِشَۃُ : الْبَیَاضُ نِصْفُ الْحُسْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 17881","","","كتاب النكاح"
"17882","(۱۷۸۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ قَالَ : أعْطِیَ یُوسُفُ وَأُمُّہُ ثُلُثَ الْحُسْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 17882","","","كتاب النكاح"
"17883","(۱۷۸۸۳) حَدَّثَنَا عَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : أُعْطِیَ یُوسُفُ شَطْرَ الْحُسْنِ۔ (احمد ۳/۱۴۸۔ حاکم ۵۷۰)","Sahih","Musannaf Ibn Abi Shaybah 17883","","","كتاب النكاح"
"17884","(۱۷۸۸۴) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْجَرِیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنِ الطُّفَاوِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ یُبَاشِرُ الرَّجُلُ الرَّجُلَ وَلاَ الْمَرْأَۃُ الْمَرْأَۃَ إِلاَّ الْوَالِدُ وَلَدَہُ أَوِ الْوَلَدُ وَالِدَہُ۔n(ابوداؤد ۴۰۱۵۔ احمد ۲/۳۲۵)","Da'if","Musannaf Ibn Abi Shaybah 17884","","","كتاب النكاح"
"17885","(۱۷۸۸۵) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، عَنْ عبد اللہِ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُبَاشِرَ الْمَرْأَۃُ الْمَرْأَۃَ فِی ثَوْبٍ وَاحِدٍ أَجْلَ أَنْ تَصِفَہَا لِزَوْجِہَا۔ (بخاری ۵۲۴۰۔ ابوداؤد ۲۱۴۳)","Sahih","Musannaf Ibn Abi Shaybah 17885","","","كتاب النكاح"
"17886","(۱۷۸۸۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنِ الضَّحَّاکِ بْنِ عُثْمَانَ قَالَ : أخبرنی زَیْدُ بْنُ أَسْلَمَ ، عْن عَبْدِ الرَّحْمَنِ بْنِ أَبِی سَعِیدٍ الْخُدْرِیِّ ، عَنْ أَبِیہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : لاَ تُفْضِی الْمَرْأَۃُ إلَی الْمَرْأَۃِ فِی ثَوْبٍ وَاحِدٍ وَلاَ الرَّجُلُ إلَی الرَّجُلِ فِی ثَوْبٍ وَاحِدٍ۔ (ترمذی ۲۷۹۳۔ ابوداؤد ۴۰۱۴)","Hasan","Musannaf Ibn Abi Shaybah 17886","","","كتاب النكاح"
"17887","(۱۷۸۸۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ قَالَ : حَدَّثَنَی یَحْیَی بْنُ أَیُّوبَ الْمِصْرِیُّ قَالَ : أَخْبَرَنِی عَیَّاشُ بْنُ عَبَّاسٍ الْحِمْیَرِیُّ ، عَنْ أَبِی الْحُصَیْنِ الْحَجَرِیِّ الْہَیْثَمِ ، عَنْ عَامِرٍ الْحَجَرِیِّ ، قَالَ : سَمِعْتُ أَبَا رَیْحَانَۃَ صَاحِبَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنْ مُعَاکَمَۃِ ، أَوْ مُکَاعَمَۃِ الْمَرْأَۃِ الْمَرْأَۃَ لَیْسَ بَیْنَہُمَا شَیْئٌ ، ومُعَاکَمَۃِ أَوْ مُکَاعَمَۃِ الرَّجُلِ الرَّجُلَ فِی شِعَارٍ لَیْسَ بَیْنَہُمَا شَیْئٌ۔n(ابوداؤد ۴۰۴۶۔ احمد ۴/۱۳۴)","Da'if","Musannaf Ibn Abi Shaybah 17887","","","كتاب النكاح"
"17888","(۱۷۸۸۸) حَدَّثَنَا أَحْمَدُ بْنُ عَبْدِ اللہِ ، عَنِ أبی شِہَابٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُبَاشِرَ الرَّجُلُ الرَّجُلَ وَالْمَرْأَۃُ الْمَرْأَۃَ قَالَ ابْنُ أَبِی لَیْلَی : وَأَنَا أَرَی فِی ذَلِکَ تَعْزِیرًا۔ (حاکم ۲۸۷۔ احمد ۳/۳۴۸)","Da'if","Musannaf Ibn Abi Shaybah 17888","","","كتاب النكاح"
"17889","(۱۷۸۸۹) حَدَّثَنَا عُبَید اللہِ ، عَنْ إسْرَائِیلَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُبَاشِرَ الرَّجُلُ الرَّجُلَ وَالْمَرْأَۃُ الْمَرْأَۃَ۔ (احمد ۱/۳۱۴۔ ابن حبان ۵۵۸۲)","","Musannaf Ibn Abi Shaybah 17889","","","كتاب النكاح"
"17890","(۱۷۸۹۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ أَنَّ رَجُلاً سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَسْتَأْذِنُ عَلَی أُمِّی ؟ قَالَ : نَعَمْ ، أَتُحِبُّ أَنْ تَرَاہَا عُرْیَانَۃً۔ (بیہقی ۹۷)","","Musannaf Ibn Abi Shaybah 17890","","","كتاب النكاح"
"17891","(۱۷۸۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ مُسْلِمِ بْنِ نذیر ، عَنْ حُذَیْفَۃَ قَالَ : إِنْ لَمْ تَفْعَلْ أَوْشَکَ أَنْ تَرَی مِنْہَا مَا یَسُوئُک۔","Sahih","Musannaf Ibn Abi Shaybah 17891","","","كتاب النكاح"
"17892","(۱۷۸۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، قَالَ : قَالَ رجل لِعُمَرَ : أسْتَأْذِنُ عَلَی أُمِّی ؟ قَالَ : نَعَمْ ، اسْتَأْذِنْ عَلَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 17892","","","كتاب النكاح"
"17893","(۱۷۸۹۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ قَالَ : جَائَ إلَیْہِ رَجُلٌ ، فَقَالَ: أَسْتَأْذِنُ عَلَی أُمِّی ؟ قَالَ : نَعَمْ ، مَا عَلَی کُلِّ أَحْیَانِہَا تُحِبُّ أَنْ تَرَاہَا۔","Sahih","Musannaf Ibn Abi Shaybah 17893","","","كتاب النكاح"
"17894","(۱۷۸۹۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ قَالَ : کَانَ عَطَائٌ وَأَخَوَاتٌ لَہُ بِمَکَّۃَ فِی بَیْتٍ وَأَہْلُ مَکَّۃَ یَخْتَلِفُ أَحَدُہُمْ إلَی أَہْلِہِ فِی اللَّیْلِ مِرَارًا ، فَکَانَ یَأْتِیہِنَّ بِاللَّیْلِ فَسَأَلَ ابْنَ عَبَّاسٍ : أَسْتَأْذِنُ عَلَیْہِنَّ کُلَّمَا دَخَلْت؟ فَقَالَ : نَعَمْ ، وَلَمْ یُرَخِّصْ لَہُ فِی الدُّخُولِ عَلَیْہِنَّ بِغَیْرِ إذْنٍ۔","Sahih","Musannaf Ibn Abi Shaybah 17894","","","كتاب النكاح"
"17895","(۱۷۸۹۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : اسْتَأْذِنْ عَلَی أُمِّکَ ، وَإِنْ کَانَتْ عَجُوزًا۔","Da'if","Musannaf Ibn Abi Shaybah 17895","","","كتاب النكاح"
"17896","(۱۷۸۹۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، عَنْ ہُزَیْلٍ ، عَنْ عَبْدِ اللہِ قَالَ : عَلَیْکُمْ أَنْ تَسْتَأْذِنُوا عَلَی أُمَّہَاتِکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 17896","","","كتاب النكاح"
"17897","(۱۷۸۹۷) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ کُرْدُوسٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ قَالَ : یَسْتَأْذِنُ الرَّجُلُ عَلَی أَبِیہِ وَأُمِّہِ وَعَلَی ابْنِہِ وَعَلَی أخیہ وعلی أُخْتِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 17897","","","كتاب النكاح"
"17898","(۱۷۸۹۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، وعَنْ ہِشَامٍ ، عَنِ الْحَسَنِ قَالاَ یَسْتَأْذِنُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17898","","","كتاب النكاح"
"17899","(۱۷۸۹۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی السَّلِیلِ ، عَنْ صِلَۃَ قَالَ یَسْتَأْذِنُ الرَّجُلُ عَلَی أُمِّہِ۔","","Musannaf Ibn Abi Shaybah 17899","","","كتاب النكاح"
"17900","(۱۷۹۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عن قتادۃ عَنْ أَبِی ہُرَیْرَۃَ أَنَّہُ قَالَ یستأذن علیہا یعنی علی أمہ۔","","Musannaf Ibn Abi Shaybah 17900","","","كتاب النكاح"
"17901","(۱۷۹۰۱) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ قَالَ سَأَلْتُ عِکْرِمَۃَ قَالَ : قُلْتُ أَیَسْتَأْذِنُ الرَّجُلُ عَلَی أُمِّہِ وَعَلَی أُخْتِہِ ؟ قَالَ : نَعَمْ ، اسْتَأْذِنْ عَلَیْہِمَا۔","","Musannaf Ibn Abi Shaybah 17901","","","كتاب النكاح"
"17902","(۱۷۹۰۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِِ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی الْبَخْتَرِیِّ قَالَ : سَأَلَ رَجُلٌ عِکْرِمَۃَ أَسْتَأْذِنُ عَلَی أُمِّی ؟ قَالَ : نَعَمْ ، اسْتَأْذِنْ عَلَی أُمِّک۔","","Musannaf Ibn Abi Shaybah 17902","","","كتاب النكاح"
"17903","(۱۷۹۰۳) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ مِسْعَرٍ، عَنْ عَمْرِو بْنِ مُرَّۃَ، عَنْ أَبِی الْبَخْتَرِیِّ قَالَ: وَأَخُو الْمَرْأَۃِ یَسْتَأْذِنُ عَلَیْہَا۔","","Musannaf Ibn Abi Shaybah 17903","","","كتاب النكاح"
"17904","(۱۷۹۰۴) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ سَمِعَ ابْنَ عَبَّاسٍ یَقُولُ : إنَّہُ لَمْ یُؤْمَرْ بِہَا أَکْثَرُ النَّاسِ الإِذْنَ وَإِنِّی آمُرُ جَارِیَتِی ہذہ أَنْ تَسْتَأْذِنَ عَلَیَّ۔","Sahih","Musannaf Ibn Abi Shaybah 17904","","","كتاب النكاح"
"17905","(۱۷۹۰۵) حَدَّثَنَا أَبُو خَالِدٍ، عَنْ عبدالملک، عَنْ عَطَائٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: غَلَبَ الشَّیْطَانُ النَّاسِ عَلَی الاستئذان فِی السَّاعَاتِ {الَّذِینَ مَلَکَتْ أَیْمَانُکُمْ وَالَّذِینَ لَمْ یَبْلُغُوا الْحُلُمَ مِنْکُمْ}۔","","Musannaf Ibn Abi Shaybah 17905","","","كتاب النكاح"
"17906","(۱۷۹۰۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ مُحَمَّدِ فی قولہ {وَالَّذِینَ لَمْ یَبْلُغُوا الْحُلُمَ مِنْکُمْ} قَالَ : کَانَ أَہْلُنا یُعَلِّمُونَا أَنْ نُسَلِّمَ قَالَ : فَکَانَ أَحَدُنَا إذَا جَائَ یَقُولُ : السَّلاَمُ عَلَیْکُمْ أَیَدْخُلُ فُلاَنٌ ؟۔","","Musannaf Ibn Abi Shaybah 17906","","","كتاب النكاح"
"17907","(۱۷۹۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ قَالَ : نَزَلَتْ فِی النِّسَائِ: {لِیَسْتَأْذِنْکُمُ الَّذِینَ مَلَکَتْ أَیْمَانُکُمْ}۔","","Musannaf Ibn Abi Shaybah 17907","","","كتاب النكاح"
"17908","(۱۷۹۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی عَائِشَۃَ ، عَنِ الشَّعْبِیِّ : {لِیَسْتَأْذِنْکُمُ الَّذِینَ مَلَکَتْ أَیْمَانُکُمْ} قَالَ : لَیْسَتْ بِمَنْسُوخَۃٍ قُلْتُ : فَإِنَّ النَّاسَ لاَ یَعْمَلُونَ بِہَا قَالَ : اللَّہُ الْمُسْتَعَانُ۔","","Musannaf Ibn Abi Shaybah 17908","","","كتاب النكاح"
"17909","(۱۷۹۰۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حَنْظَلَۃَ ، قَالَ : سَمِعْتُ الْقَاسِمَ وَسُئِلَ عَنِ الإِذْنِ ، فَقَالَ : اسْتَأْذِنْ عِنْدَ کُلِّ عَوْرَۃٍ ثُمَّ ہُوَ طَوَافٌ بَعْدَہَا۔","","Musannaf Ibn Abi Shaybah 17909","","","كتاب النكاح"
"17910","(۱۷۹۱۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ : {وَلاَ تَعْزِمُوا عُقْدَۃَ النِّکَاحِ حَتَّی یَبْلُغَ الْکِتَابُ أَجَلَہُ} قَالَ: انْقِضَائُ الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 17910","","","كتاب النكاح"
"17911","(۱۷۹۱۱) حَدَّثَنَا وَکِیعٌ وَالْفَضْلُ ، عَنْ سُفْیَانَ ، عَنْ لَیث ، عَنْ مُجَاہِدٍ : {وَلاَ تَعْزِمُوا عُقْدَۃَ النِّکَاحِ حَتَّی یَبْلُغَ الْکِتَابُ أَجَلَہُ} قَالَ : انْقِضَائُ الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 17911","","","كتاب النكاح"
"17912","(۱۷۹۱۲) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إسْرَائِیلَ ، عَنِ السُّدِّیِّ ، عَنْ أَبِی مَالِکٍ : {وَلاَ تَعْزِمُوا عُقْدَۃَ النِّکَاحِ حَتَّی یَبْلُغَ الْکِتَابُ أَجَلَہُ} قَالَ : لاَ تُوَاعِدُوہَا فِی عِدَّتِہَا إِنِّی أَتَزَوَّجُک حین تَنْقَضِیَ عِدَّتُک۔","","Musannaf Ibn Abi Shaybah 17912","","","كتاب النكاح"
"17913","(۱۷۹۱۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ مَنْصُورٍ، عَنْ مُجَاہِدٍ : {وَاہْجُرُوہُنَّ فِی الْمَضَاجِعِ} قَالَ : لاَ تَقْرَبْہَا۔","","Musannaf Ibn Abi Shaybah 17913","","","كتاب النكاح"
"17914","(۱۷۹۱۴) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ: قوْلُہُ {وَاہْجُرُوہُنَّ فِی الْمَضَاجِعِ} قَالاَ: لاَ یُضَاجِعُہَا۔","","Musannaf Ibn Abi Shaybah 17914","","","كتاب النكاح"
"17915","(۱۷۹۱۵) حَدَّثَنَا حَفْصٌ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ، عَنْ أَبِی الضُّحَی، عَنِ ابْنِ عَبَّاسٍ: {وَاہْجُرُوہُنَّ فِی الْمَضَاجِعِ} قَالَ: إذَا أَطَاعَتْہُ فِی الْمَضْجَعِ فَلَیْسَ لَہُ أَنْ یَضْرِبَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 17915","","","كتاب النكاح"
"17916","(۱۷۹۱۶) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ قَالَ : حدَّثَنَا شَرِیکٌ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ وَمِقْسَمٍ : قَوْلُہُ {وَاہْجُرُوہُنَّ فِی الْمَضَاجِعِ وَاضْرِبُوہُنَّ} قَالَ : مِقْسَمٌ : وَلاَ تَقْرَبُ فِرَاشَہَا وَقَالَ عِکْرِمَۃُ : ہُوَ الْکَلاَمُ وَقَالاَ جَمِیعًا : {واضْرِبُوہُنَّ} ضَرْبٌ غَیْرُ مُبَرِّحٍ۔","","Musannaf Ibn Abi Shaybah 17916","","","كتاب النكاح"
"17917","(۱۷۹۱۷) حَدَّثَنَا عَفَّانُ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ : {واضْرِبُوہُنَّ} قَالَ : ضَرْبًا غَیْرُ مُبَرِّحٍ غَیْرُ مُؤَثِّرٍ۔","","Musannaf Ibn Abi Shaybah 17917","","","كتاب النكاح"
"17918","(۱۷۹۱۸) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ أَبِی سَلاَّمٍ الْفِہْرِیِّ ، قَالَ : سَمِعْتُ عَلِیَّ بْنَ عَبْدِ اللہِ بْنِ عَبَّاسٍ یَقُولُ : إذَا جَامَعْتَ فَاسْتَتِرْ۔","","Musannaf Ibn Abi Shaybah 17918","","","كتاب النكاح"
"17919","(۱۷۹۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا جَامَعَ أَحَدُکُمْ فَلْیَسْتَتِرْ وَلاَ یَتَجَرَّدَانِ تَجَرُّدَ الْعَیْرَیْنِ۔ (طبرانی ۷۶۸۳۔ بزار ۱۴۴۸)","","Musannaf Ibn Abi Shaybah 17919","","","كتاب النكاح"
"17920","(۱۷۹۲۰) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ أَبِی سَلاَّمٍ الفہری ، قَالَ : سَمِعْتُ عَلِیَّ بْنَ عَبْدِ اللہِ بْنِ عَبَّاسٍ یَنْہَی مُسْلِمًا أَنْ یُرَاضِعَ نَصْرَانِیًّا۔","","Musannaf Ibn Abi Shaybah 17920","","","كتاب النكاح"
"17921","(۱۷۹۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ غَالِبٍ أَبِی الْہُذَیْلِ ، عَنْ أَبِی جَعْفَرٍ أَنَّہُ کَرِہَ أَنْ تُرْضِعَ الْیَہُودِیَّۃُ وَالنَّصْرَانِیَّۃ الصَّبِیَّ وَقَالَ : إنَّہَا تَشْرَبُ الْخَمْرَ۔","","Musannaf Ibn Abi Shaybah 17921","","","كتاب النكاح"
"17922","(۱۷۹۲۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرب ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ قَالَ : کَانَ یَکْرَہُ أَنْ تُرْضِعَ امْرَأَتہ بِلَبَنِ الْفُجُورِ۔","","Musannaf Ibn Abi Shaybah 17922","","","كتاب النكاح"
"17923","(۱۷۹۲۳) حَدَّثَنَا شَرِیکٌ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ بَأْسَ بِرَضَاعِ الزَّانِیَۃِ ، أَوْ لَبَنِ الْمَجُوسِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 17923","","","كتاب النكاح"
"17924","(۱۷۹۲۴) حَدَّثَنَا ہُشَیْمٌ قَالَ : أَخْبَرَنَا مَنْصُورٌ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَائِشَۃَ أَنَّہَا کَانَتْ تَقُولُ لِلنِّسَائِ : لاَ تَصِفننی لأَزْوَاجِکُنَّ۔","","Musannaf Ibn Abi Shaybah 17924","","","كتاب النكاح"
"17925","(۱۷۹۲۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ إسْمَاعِیلَ الْمَکِّیِّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا تَزَوَّجَ الرجل أَمَۃً وَقَعَ عَلَیْہَا وَلَمْ یَسْتَبْرِئْہَا۔","","Musannaf Ibn Abi Shaybah 17925","","","كتاب النكاح"
"17926","(۱۷۹۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ إِذَا تَزَوَّجَہَا لَمْ یَسْتَبْرِئْہَا۔","","Musannaf Ibn Abi Shaybah 17926","","","كتاب النكاح"
"17927","(۱۷۹۲۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ قَالَ : إذَا تَزَوَّجَ الأَمَۃَ تَزَوُّجًا لَمْ یَسْتَبْرِئْہَا۔","","Musannaf Ibn Abi Shaybah 17927","","","كتاب النكاح"
"17928","(۱۷۹۲۸) حَدَّثَنَا ابْنُ مُسْہِرٍ ، وَأَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَخْطُبُ الرَّجُلُ عَلَی خِطْبَۃِ أَخِیہِ وَلاَ یَبِع عَلَی بَیْعِ أَخِیہِ إلاَّ أَنْ یَأْذَنَ لَہُ۔n(مسلم ۵۰۔ ابوداؤد ۲۰۷۴)","Sahih","Musannaf Ibn Abi Shaybah 17928","","","كتاب النكاح"
"17929","(۱۷۹۲۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَخْطُب عَلَی خِطْبَۃِ أَخِیہِ۔ (مسلم ۵۲۰۔ ترمذی ۱۱۳۴)","Sahih","Musannaf Ibn Abi Shaybah 17929","","","كتاب النكاح"
"17930","(۱۷۹۳۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُدْرِکٍ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَزْنِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ۔","Da'if","Musannaf Ibn Abi Shaybah 17930","","","كتاب النكاح"
"17931","(۱۷۹۳۱) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ شُعْبَۃَ ، عَنْ فِرَاسٍ ، عَنْ مُدْرِکٍ ، عَنِ ابْنِ أَبِی أَوْفَی ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِثْلَہُ۔ (طیالسی ۸۲۳۔ احمد ۴/۳۵۲)","Hasan","Musannaf Ibn Abi Shaybah 17931","","","كتاب النكاح"
"17932","(۱۷۹۳۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ عَبَّادٍ ، عَنْ أَبَانَ بْنِ عُثْمَانَ قَالَ : یُعْرَفُ الزُّنَاۃُ بِنَتْنِ فُرُوجِہِمْ یَوْمَ الْقِیَامَۃِ۔","","Musannaf Ibn Abi Shaybah 17932","","","كتاب النكاح"
"17933","(۱۷۹۳۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ قَالَ : إنَّ أَکْبَرَ مَا یُصِیبُ النَّاسَ مِنَ الذُّنُوبِ الزِّنَا ، ہُوَ شَہْوَۃٌ وَلَیْسَ لَہُ رِیحٌ فَیُؤخَذ وَلاَ یَکَادُ تُقَامُ حُدُودُہُ۔","","Musannaf Ibn Abi Shaybah 17933","","","كتاب النكاح"
"17934","(۱۷۹۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سُفْیَانَ ، عَنْ زَکَرِیَّا بْنِ صُہَیْبٍ ، عَنْ أَبِی صَالِحٍ قَالَ : بَلَغَنِی أَنَّ أَکْثَرَ ذُنُوبِ أَہْلِ الْجَنَّۃِ فِی النِّسَائِ۔","","Musannaf Ibn Abi Shaybah 17934","","","كتاب النكاح"
"17935","(۱۷۹۳۵) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ قَالَ لِغِلْمَانِہِ : مَنْ أَرَادَ مِنْکُمُ الْبَائَۃَ زَوَّجْنَاہُ ، لاَ یَزْنِی مِنْکُمُ الزَّانِی إلاَّ نَزَعَ اللَّہُ نُورَ الإِیمَانِ مِنْ قَلْبِہِ فَإِنْ شَائَ أَنْ یَرُدَّہُ رَدَّہُ ، وَإِنْ شَائَ أَنْ یَمْنَعَہُ مَنَعَہُ۔","Hasan","Musannaf Ibn Abi Shaybah 17935","","","كتاب النكاح"
"17936","(۱۷۹۳۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ الْعَوَّامِ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ قَالَ : الإِیمَانُ نزہٌ فَمَنْ زَنَی فَارَقَہُ الإِیمَانُ فَمَنْ لاَمَ نَفْسَہُ وَرَاجَعَ رَاجَعَہُ الإِیمَانُ۔","Sahih","Musannaf Ibn Abi Shaybah 17936","","","كتاب النكاح"
"17937","(۱۷۹۳۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی عُثْمَانَ ، عَنْ أُسَامَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا تَرَکْت بَعْدِی عَلَی أُمَّتِی فِتْنَۃً أَضَرَّ عَلَی الرِّجَالِ مِنَ النِّسَائِ۔n(بخاری ۵۰۹۶۔ مسلم ۲۰۹۷)","Hasan","Musannaf Ibn Abi Shaybah 17937","","","كتاب النكاح"
"17938","(۱۷۹۳۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَمْ یَکُنْ کُفْرُ مَنْ مَضَی إلاَّ مِنْ قِبَلِ النِّسَائِ وَہُوَ کَائِنٌ کُفْرُ مَنْ بَقِیَ مِنْ قِبَلِ النِّسَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 17938","","","كتاب النكاح"
"17939","(۱۷۹۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَحْیَی بْنِ عَبَّادِ بن عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ قَالَتْ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ۔","","Musannaf Ibn Abi Shaybah 17939","","","كتاب النكاح"
"17940","(۱۷۹۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ بَعْجَۃَ الْجُہَنِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (بخاری ۲۴۷۵۔ مسلم ۱۰۰)","","Musannaf Ibn Abi Shaybah 17940","","","كتاب النكاح"
"17941","(۱۷۹۴۱) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ قَالَ : حدَّثَنِی یَحْیَی بْنُ أَیُّوبَ الْمِصْرِیُّ قَالَ : حَدَّثَنِی یَزِیدُ بْنُ أَبِی حَبِیبٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ أَنَّ عُمَرَ بْنَ الْخَطَّابِ رُفِعَ إلَیْہِ خَصِیٌّ تَزَوَّجَ امْرَأَۃً وَلَمْ یُعْلِمْہَا فَفَرَّقَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 17941","","","كتاب النكاح"
"17942","(۱۷۹۴۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ سَعِیدِ بْنِ یُوسُفَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ أَنَّ عَلِیَّ بْنَ أَبِی طَالِبٍ کان یقُول : لاَ یَنْکِحُ الْخَصِیُّ حُرَّۃً مُسْلِمَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 17942","","","كتاب النكاح"
"17943","(۱۷۹۴۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ حَمَّادًا ، عَنْ رَجُلٍ زَوَّجَ ابْنَتَہُ ثُمَّ مَاتَ الزَّوْجُ وَلَمْ تَعْلَمِ الابْنَۃُ بِذَلِکَ ، فَقَالَ : لاَ تَرِثُ وَسَأَلْت الْحَکَمَ ، فَقَالَ : تَرِثُ۔","","Musannaf Ibn Abi Shaybah 17943","","","كتاب النكاح"
"17944","(۱۷۹۴۴) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ دَاوُدَ بْنِ جُبَیْرٍ قَالَ : زَفَّ سَعِیدُ بْنُ جُبَیْرٍ ابْنَتَہُ إلَی زَوْجِہَا۔","","Musannaf Ibn Abi Shaybah 17944","","","كتاب النكاح"
"17945","(۱۷۹۴۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ رَجُلٍ حَدَّثَہُ أَنَّ امْرَأَۃً سَأَلَتِ ابْنَہَا أَنْ یُزَوِّجَہَا فَکَرِہَ ذَلِکَ ، وَذَہَبَ إلَی عُمَرَ فَذَکَر ذَلِکَ لَہُ ، فَقَالَ عمر : اذْہَبْ فَإِذَا کَانَ غَدًا أَتَیْتُکُمْ قَالَ : فَجَائَ عُمَرُ فَکَلَّمَہَا وَلَمْ یُکْثِرْ ثُمَّ أَخَذَ بِیَدِ ابْنِہَا ، فَقَالَ لَہُ : زَوِّجْہَا فَوَالَّذِی نَفْسُ عُمَرَ بِیَدِہِ لَوْ أَنَّ حَنْتَمَۃَ بِنْتَ ہِشَامٍ یَعْنِی عُمَرُ أُمَّ نَفْسِہِ سَأَلَتْنِی أَنْ أُزَوِّجَہَا لَزَوَّجْتہَا ، فَزَوَّجَ الرَّجُلُ أُمَّہُ۔","Da'if","Musannaf Ibn Abi Shaybah 17945","","","كتاب النكاح"
"17946","(۱۷۹۴۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ وَإِسْمَاعِیلَ بْنِ عَبْدِ اللہِ بْنِ أَبِی طَلْحَۃَ أَنَّ أَبَا طَلْحَۃَ خَطَبَ أُمَّ سُلَیْمٍ ، فَقَالَتْ : یَا أَبَا طَلْحَۃَ أَلَسْتَ تَعْلَمُ أَنَّ آلَہَتِکَ الَّتِی تَعْبُدُ خَشَبَۃً تنبت مِنَ الأَرْضِ ، نَجَرَہَا حَبَشِیُّ بَنِی فُلاَنٍ قَالَ : بَلَی ، قَالَتْ : فَلاَ تَسْتَحْیِی مِنْ ذَلِکَ أسلم فَإِنَّک إِنْ أَسْلَمْتَ لَمْ أُرِدْ مِنْک صَدَاقًا غَیْرَہُ قَالَ حَتَّی أَنْظُرَ قَالَ : فَذَہَبَ ثُمَّ جَائَ ، فَقَالَ : أَشْہَدُ أَنْ لاَ إلَہَ إلاَّ اللَّہُ وَأَنَّ مُحَمَّدًا رَسُولُ اللہِ قَالَتْ : یَا أَنَسُ ، قُمْ فَزَوِّجْ أَبَا طَلْحَۃَ ، فَزَوَّجَہَا۔","","Musannaf Ibn Abi Shaybah 17946","","","كتاب النكاح"
"17947","(۱۷۹۴۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حَدَّثَنا حُسَیْنُ بْنُ وَاقِدٍ قَالَ : حدَّثَنِی یَزِیدُ النَّحْوِیُّ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا قَدِمَ مِنْ مَغَازِیہِ قَبَّلَ فَاطِمَۃَ۔ (بخاری ۳۶۲۳۔ مسلم ۹۷)","","Musannaf Ibn Abi Shaybah 17947","","","كتاب النكاح"
"17948","(۱۷۹۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ مِغْوَلٍ ، عَنْ أَبِی حَصِینٍ ، عَنْ مُجَاہِدٍ أَنَّ أَبَا بَکْرٍ قَبَّلَ رَأْسَ عَائِشَۃَ۔","","Musannaf Ibn Abi Shaybah 17948","","","كتاب النكاح"
"17949","(۱۷۹۴۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أیمن ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ أَنَّ خَالِدَ بْنَ الْوَلِیدِ اسْتَشَارَ أُخْتَہُ فِی شَیْئٍ فَأَشَارَتْ علیہ فَقَبَّلَ رَأْسَہَا۔ (ترمذی ۱۱۷۲۔ دارمی ۲۷۸۲)","","Musannaf Ibn Abi Shaybah 17949","","","كتاب النكاح"
"17950","(۱۷۹۵۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِرٍ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُدْخلَ عَلَی الْمُغِیبَاتِ۔","Da'if","Musannaf Ibn Abi Shaybah 17950","","","كتاب النكاح"
"17951","(۱۷۹۵۱) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ وَمِسْعَرٍ ، عَنْ سَعِیدِ بْنِ إبْرَاہِیمَ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ، قَالَ: قَالَ عُمَرُ: أَلاَ لاَ یَلِجُ رَجُلٌ عَلَی امْرَأَۃٍ إلاَّ وَہِیَ ذَاتُ مَحْرَمٍ مِنْہُ ، وَإِنْ قِیلَ : حَمْوُہَا ؟ أَلاَ إنَّ حَمْوَہَا الْمَوْتُ۔","","Musannaf Ibn Abi Shaybah 17951","","","كتاب النكاح"
"17952","(۱۷۹۵۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی مَعْبَدٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : سَمِعْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : أَلاَ لاَ یَخْلُوَنَّ رَجُلٌ بِامْرَأَۃٍ إلاَّ وَمَعَہَا ذُو مَحْرَمٍ۔ (بخاری ۳۰۰۶۔ مسلم ۴۲۴)","Sahih","Musannaf Ibn Abi Shaybah 17952","","","كتاب النكاح"
"17953","(۱۷۹۵۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی زُبَیْرٍ ، عَنْ جَابِرٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : أَلاَ لاَ یَبِیتَنَّ رَجُلٌ عِنْدَ امْرَأَۃٍ إلاَّ أَنْ یَکُونَ نَاکِحًا ، أَوْ ذَا مَحْرَمٍ۔ (مسلم ۱۹۔ ابن حبان ۵۵۸۷)","Sahih","Musannaf Ibn Abi Shaybah 17953","","","كتاب النكاح"
"17954","(۱۷۹۵۴) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ قَالَ : حدَّثَنَا لَیْثُ بْنُ سَعْدٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ أَبِی الْخَیْرِ ، عَنْ عُقْبَۃَ بْنِ عَامِرٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إیَّاکُمْ وَالدُّخُولَ عَلَی النِّسَائِ ، فَقَالَ رَجُلٌ مِنَ الأَنْصَارِ : یَا رَسُولَ اللہِ ، إلاَّ الْحَمْوَ ؟ فَقَالَ : الْحَمْوُ الْمَوْتُ۔ (بخاری ۵۲۳۲۔ مسلم ۲۱)","Sahih","Musannaf Ibn Abi Shaybah 17954","","","كتاب النكاح"
"17955","(۱۷۹۵۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَمِعْتُ ذَکْوَانَ یُحَدِّثُ عَنْ مَوْلًی لِعَمْرِو بْنِ الْعَاصِ أنَّہُ أَرْسَلَہُ إلَی عَلِیٍّ یَسْتَأْذِنُ عَلَی أَسْمَائَ ابْنَۃِ عُمَیْسٍ فَأَذِنَ لَہُ حَتَّی إذَا فَرَغَ مِنْ حَاجَتِہِ سَأَلَ الْمَوْلَی عَمْرًا عَنْ ذَلِکَ ، فَقَالَ إنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَانَا أَنْ نَدْخُلَ عَلَی النِّسَائِ بِغَیْرِ إذْنِ أَزْوَاجِہِنَّ۔n(ترمذی ۲۷۷۹۔ احمد ۴/۲۰۳)","Da'if","Musannaf Ibn Abi Shaybah 17955","","","كتاب النكاح"
"17956","(۱۷۹۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ زِیَادِ بْنِ فَیَّاضٍ ، عَنْ تَمِیمِ بْنِ سَلَمَۃَ قَالَ : قَالَ عَمْرُو بْنُ الْعَاصِ : نُہِینَا أَنْ نَدْخُلَ عَلَی الْمُغِیبَاتِ إلاَّ بِإِذْنِ أَزْوَاجِہِنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 17956","","","كتاب النكاح"
"17957","(۱۷۹۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا أَنْ یَتَزَوَّجَ الرَّجُلُ عَلَی کَذَا وَکَذَا وَصِیفًا۔","","Musannaf Ibn Abi Shaybah 17957","","","كتاب النكاح"
"17958","(۱۷۹۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ بَأْسَ أَنْ یَتَزَوَّجَ الرَّجُلُ عَلَی بِنْتٍ وَخَادِمٍ وَعَلَی الْوُصَفَائِ وَالْوَصَائِفِ۔","","Musannaf Ibn Abi Shaybah 17958","","","كتاب النكاح"
"17959","(۱۷۹۵۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْعَلاَئِ بْنِ عَبْدِ الْکَرِیمِ الْیَامِیِّ ، عَنْ عَمَّارِ بْنِ عِمْرَانَ رَجُلٍ مِنْ زَیْدِ اللہِ ، عَنِ امْرَأَۃٍ مِنْہُمْ ، عَنْ عَائِشَۃَ أَنَّہَا شَوَّفَتْ جَارِیَۃً وَطَافَتْ بِہَا وَقَالَتْ : لَعَلَّنَا نَتَصَید بِہَا شَبَابَ قُرَیْشٍ۔","Da'if","Musannaf Ibn Abi Shaybah 17959","","","كتاب النكاح"
"17960","(۱۷۹۶۰) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنْ أَبِی حَازِمٍ ، عَنْ سَہْلِ بْنِ سَعْدٍ السَّاعِدِیِّ أَنَّہُمْ مَرُّوا عَلَیْہِ بِجَارِیَۃٍ قَدْ زُیِّنَتْ قَالَ : فَدَعَا بِہَا وَنَظَرَ إلَیْہَا وَأَجْلَسَہَا فِی حِجْرِہِ ، وَمَسَحَ عَلَی رَأْسِہَا وَدَعَا لَہَا بِالْبَرَکَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 17960","","","كتاب النكاح"
"17961","(۱۷۹۶۱) حَدَّثَنَا وَکِیعٌ قَالَ : حدَّثَنَا أُسَامَۃُ بْنُ زَیْدٍ ، عَنْ بَعْضِ أَشْیَاخِہِ قَالَ قَالَ : عُمَرُ : إذَا أَرَادَ أحَدٌ مِنْکُمْ أَنْ یُحَسِّنَ الْجَارِیَۃَ فَلْیُزَیِّنْہَا وَلْیَطَّوَّفْ بِہَا یَتَعَرَّضُ بِہَا رِزْقَ اللہِ۔","Da'if","Musannaf Ibn Abi Shaybah 17961","","","كتاب النكاح"
"17962","(۱۷۹۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ : لاَ تُکْرِہُوا فَتَیَاتِکُمْ عَلَی الرجل الدَّمِیمِ مِنَ الرِّجَالِ فَإِنَّہُنَّ یُحْبِبْنَ مِنْ ذَلِکَ مَا تُحِبُّونَ۔","","Musannaf Ibn Abi Shaybah 17962","","","كتاب النكاح"
"17963","(۱۷۹۶۳) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَتَزَوَّجَ الرَّجُلُ فِی أَرْضِ الْحَرْبِ وَیَدَعُ وَلَدَہُ فِیہِمْ۔","","Musannaf Ibn Abi Shaybah 17963","","","كتاب النكاح"
"17964","(۱۷۹۶۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ أَنَّہُ کَرِہَ نِکَاحَ نَصَارَی أَہْلِ الرُّومِ مِنْ غَیْرِ أَہْلِ الْعَہْدِ قَالَ : فَوَصَفَ مُحَمَّدٌ الرَّجُلَ یَکُونُ أَسِیرًا فَیُرِیدُ أَنْ یَتَزَوَّجَ فَیَکْرَہُ ذَلِکَ لَہُ۔","","Musannaf Ibn Abi Shaybah 17964","","","كتاب النكاح"
"17965","(۱۷۹۶۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : لاَ یُحْصِنُ الرَّجُلَ نِکَاحُ الْحَرَامِ۔","","Musannaf Ibn Abi Shaybah 17965","","","كتاب النكاح"
"17966","(۱۷۹۶۶) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ، عَنْ عَبْدِالْعَزِیزِ بْنِ عُبَیْدِاللہِ عن الشعبی قَالَ لاَ یُحْصِنُ الرَّجُلَ نِکَاحُ الْحَرَامِ۔","","Musannaf Ibn Abi Shaybah 17966","","","كتاب النكاح"
"17967","(۱۷۹۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ بُدَیل بْنِ مَیْسَرَۃَ ، عَنْ أَبِی عَطِیَّۃَ ، عَنِ امْرَأَۃٍ مِنْہُمْ قَالَت : سَمِعْتُ عُمَرَ یَنْہَی عَنِ النَّقْشِ وَالتَّطَارِیفِ فِی الْخِضَابِ۔","Da'if","Musannaf Ibn Abi Shaybah 17967","","","كتاب النكاح"
"17968","(۱۷۹۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا قَالَ حَدَّثَتْنِی أُمَیَّۃُ قَالَتْ : کُنْت أُقین الْعَرَائِسَ بِالْمَدِینَۃِ فَسَأَلْت عَائِشَۃَ عَنِ الْخِضَابِ ، فَقَالَتْ : لاَ بَأْسَ بِہِ مَا لَمْ یَکُنْ فِیہِ نَقْشٌ۔","Da'if","Musannaf Ibn Abi Shaybah 17968","","","كتاب النكاح"
"17969","(۱۷۹۶۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِد ، عَنْ شَیْخٍ أَنَّ عُمَرَ نَہَی عَنْ نَقْشٍ فِی الْخِضَابِ وَالتَّطَارِیفِ۔","Da'if","Musannaf Ibn Abi Shaybah 17969","","","كتاب النكاح"
"17970","(۱۷۹۷۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عَبْدِ اللہِ بْنِ حَفْصٍ ، عَنْ یَعْلَی بْنِ مُرَّۃَ قَالَ : مَرَرْت عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا مُتَخَلِّقٌ بِالزَّعْفَرَانِ ، فَقَالَ لِی : یَا یَعْلَی ، ہَلْ لَکَ امْرَأَۃٌ ؟ فَقُلْتُ : لاَ ، قَالَ : فَاذْہَبْ فَاغْسِلْہُ ثُمَّ اغْسِلْہُ ثُمَّ لاَ تَعُدْ ، قَالَ : فَغَسَلْتہ ثُمَّ غَسَلْتہ ثُمَّ لَمْ أَعُدْ۔n(ترمذی ۲۸۱۶۔ احمد ۴/۱۷۱)","Da'if","Musannaf Ibn Abi Shaybah 17970","","","كتاب النكاح"
"17971","(۱۷۹۷۱) حَدَّثَنَا مُعْتَمِرٌ وَجَرِیرٌ ، عَنِ الرُّکَیْنِ ، عَنِ الْقَاسِمِ بْنِ حَسَّانَ ، عَنْ عَمِّہِ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، عَنْ عَبْدِ اللہِ أَنَّ نَبِیَّ اللہِ کَرِہَ الصُّفْرَۃَ یَعْنِی الْخَلُوقَ۔ (ابوداؤد ۴۲۱۹۔ ابویعلی ۵۰۷۴)","Da'if","Musannaf Ibn Abi Shaybah 17971","","","كتاب النكاح"
"17972","(۱۷۹۷۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ التَّزَعْفُرِ۔ (مسلم ۱۶۶۳۔ ابوداؤد ۴۱۷۶)","Sahih","Musannaf Ibn Abi Shaybah 17972","","","كتاب النكاح"
"17973","(۱۷۹۷۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ الْحَسَنِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی سَوَّادَ بْنَ عَمْرٍو مُتَخَلِّقًا، فَقَالَ : خطْ خطْ ، وَرْسْ وَرْسْ۔ (عبدالرزاق ۱۸۰۳۸)","","Musannaf Ibn Abi Shaybah 17973","","","كتاب النكاح"
"17974","(۱۷۹۷۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنْ کَثِیرٍ مَوْلَی ابْنِ سَمُرَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَقْرَبُ الْمَلاَئِکَۃُ مُتَضَمِّخًا بِخَلُوقٍ۔","Hasan","Musannaf Ibn Abi Shaybah 17974","","","كتاب النكاح"
"17975","(۱۷۹۷۵) حَدَّثَنَا أَبُو دَاوُدَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ أَنَّ الأَشْعَرِیَّ لَمَّا قَدِمَ الْبَصْرَۃَ رَأَی قَیْسَ بْنَ عُبَادٍ وَعَلَیْہِ أَثَرُ صُفْرَۃٍ، أَوْ قَالَ: خَلُوقٍ قَالَ: فَنَظَرَ إلَیْہِ فَانْطَلَقَ فغَسَلُہُ ثُمَّ جَائَ، فَقَالَ الأَشْعَرِیُّ: مَا أَسْرَعُ مَا أعتب ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 17975","","","كتاب النكاح"
"17976","(۱۷۹۷۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی أنَّہُ دُعِیَ إلَی عُرْسٍ بِلَیْلٍ فَادَّہَنَ بِدُہْنٍ فِیہِ صُفْرَۃٌ فَأَصْبَحَ وَفِی لِحْیَتِہِ صُفْرَۃٌ فَغَسَلَہَا فَلَمْ یَذْہَبْ فَغَسَلَہَا بِصَابُونٍ۔","","Musannaf Ibn Abi Shaybah 17976","","","كتاب النكاح"
"17977","(۱۷۹۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، عَنْ یَحْیَی بْنِ یَعْمَُرَ ، عَنْ عَمَّارٍ قَالَ : قَدِمْت مِنَ سَفَرٍ فَمَسَّحَنِی أَہْلِی بِشَیْئٍ مِنَ صُفْرَۃٍ فَأَتَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَلَّمْت عَلَیْہِ فَلَمْ یَرُدَّ عَلَیَّ وَلَمْ یُرَحِّبْ بِی وَقَالَ : انْطَلِقْ فَاغْسِلْ عَنْک ہَذَا ، فَذَہَبْتُ فَغَسَلْتُہُ فَبَقِیَ مِنْ أَثَرِہِ شَیْئٌ فَأَتَیْتُہُ فَسَلَّمْت عَلَیْہِ فَلَمْ یَرُدَّ عَلَیَّ وَلَمْ یُرَحِّبْ بِی ، فَقَالَ : انْطَلِقْ فَاغْسِلْ عَنْک ہَذَا ، فَذَہَبْتُ فَغَسَلْتہ ثُمَّ جِئْت فَسَلَّمْت عَلَیْہِ فَرَحَّبَ بِی وَقَالَ : إنَّ الْمَلاَئِکَۃَ لاَ تَقْرَبُ جِنَازَۃَ کَافِرٍ وَلاَ جُنُبٍ وَلاَ مُتَضَمِّخٍ بِخَلُوقٍ۔ (مسندہ ۴۴۱)","","Musannaf Ibn Abi Shaybah 17977","","","كتاب النكاح"
"17978","(۱۷۹۷۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ، عَنِ النُّعْمَانِ بْنِ سَعْدٍ قَالَ : رَأَیْتُ الْمُغِیرَۃَ بْنَ شُعْبَۃَ مُضَمَّخًا بِالْخَلُوقِ کَأَنَّہُ عُرْجُونٌ۔","Da'if","Musannaf Ibn Abi Shaybah 17978","","","كتاب النكاح"
"17979","(۱۷۹۷۹) حَدَّثَنَا ہُشَیْمُ بْنُ أَبِی سَاسَانَ ، عَنْ أَبَانَ بْنِ کَثِیرٍ النَّہْشَلِیِّ قَالَ : رَأَیْتُ أَنَسًا قَدْ مَسَحَ ذِرَاعَیْہِ بِشَیْئٍ مِنْ خَلُوقٍ مِنْ وَضَحٍ کَانَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 17979","","","كتاب النكاح"
"17980","(۱۷۹۸۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ: الْوَلَدُ لِلْفِرَاشِ۔ (بخاری ۲۴۲۱۔ مسلم ۱۰۸۱)","Sahih","Musannaf Ibn Abi Shaybah 17980","","","كتاب النكاح"
"17981","(۱۷۹۸۱) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِیہِ ، عَنْ عُمَرَ ، قَالَ : قضَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْوَلَدِ لِلْفِرَاشِ۔ (احمد ۲۵۔ ابویعلی ۱۹۹)","Da'if","Musannaf Ibn Abi Shaybah 17981","","","كتاب النكاح"
"17982","(۱۷۹۸۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ وَأَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْوَلَدُ لِلْفِرَاشِ۔ (مسلم ۱۰۸۱۔ ترمذی ۱۱۵۷)","Sahih","Musannaf Ibn Abi Shaybah 17982","","","كتاب النكاح"
"17983","(۱۷۹۸۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا حُسَیْنُ الْمُعَلِّمُ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْوَلَدُ لِلْفِرَاشِ وَلِلْعَاہِرِ الأَثْلَبُ قِیلَ : وَمَا الأَثْلَبُ ؟ قَالَ : الْحَجَرُ۔n(ابوداؤد ۲۲۶۸۔ احمد ۲/۱۷۹)","Hasan","Musannaf Ibn Abi Shaybah 17983","","","كتاب النكاح"
"17984","(۱۷۹۸۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ شُرَحْبِیلَ بْنِ مُسْلِمٍ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ الْبَاہِلِیَّ یَقُولُ : سَمِعْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : الْوَلَدُ لِلْفِرَاشِ۔ (ترمذی ۲۱۲۰۔ ابوداؤد ۲۲۶۹)","Hasan","Musannaf Ibn Abi Shaybah 17984","","","كتاب النكاح"
"17985","(۱۷۹۸۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا مَہْدِیُّ بْنُ مَیْمُونٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی یَعْقُوبَ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ قَالَ: حَدَّثَنِی رَبَاحٌ الْحَبَشِیُّ، عَنْ عُثْمَانَ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَضَی بِالْوَلَدِ لِلْفِرَاشِ۔","Da'if","Musannaf Ibn Abi Shaybah 17985","","","كتاب النكاح"
"17986","(۱۷۹۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْوَلَدُ لِلْفِرَاشِ وَلِلْعَاہِرِ الْحَجَرُ۔ (بخاری ۶۷۵۰۔ احمد ۲/۳۸۶)","Sahih","Musannaf Ibn Abi Shaybah 17986","","","كتاب النكاح"
"17987","(۱۷۹۸۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ ، عَنْ عَمْرِو بْنِ خَارِجَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : الْوَلَدُ لِلْفِرَاشِ۔","Da'if","Musannaf Ibn Abi Shaybah 17987","","","كتاب النكاح"
"17988","(۱۷۹۸۸) حُدِّثْتُ عن جَرِیر ، عَنْ مُغِیرَۃَ ، عَن أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ قَالَ: الْوَلَدُ لِلْفِرَاشِ۔ (ابویعلی ۵۱۲۶۔ ابن حبان ۴۱۰۴)","","Musannaf Ibn Abi Shaybah 17988","","","كتاب النكاح"
"17989","(۱۷۹۸۹) حَدَّثَنَا أَبُو أُسَامَۃَ قَالَ : حدَّثَنِی شُعْبَۃُ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنِ الرَّجُلِ یَلْحَقُ بِأَرْضِ الْعَدُوِّ أَتَتَزَوَّجُ امْرَأَتُہُ ؟ قَالَ : أَحَدُہُمَا : لاَ ، وَقَالَ : الآخَرُ : نَعَمْ۔","","Musannaf Ibn Abi Shaybah 17989","","","كتاب النكاح"
"17990","(۱۷۹۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَمَّادِ بْنِ زَیْدٍ قَالَ : حدَّثَنَا عَاصِمٌ قَالَ عُمَرُ بْنُ الْخَطَّابِ : عَلَیْکُمْ بِالأَبْکَارِ مِنَ النِّسَائِ فَإِنَّہُنَّ أَعْذَبُ أَفْوَاہًا وَأَصَحُّ أَرْحَامًا وَأَرْضَی بِالْیَسِیرِ۔","","Musannaf Ibn Abi Shaybah 17990","","","كتاب النكاح"
"17991","(۱۷۹۹۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنْ عَمْرِو بْنِ قَیْسٍ ، عَنْ رَجُلٍ ، عَنِ ابْنِ مَسْعُودٍ قَالَ : تَزَوَّجُوا الأَبْکَارَ فَإِنَّہُنَّ أَقَلُّ خِبًّا وَأَشَدُّ وُدًّا۔","Da'if","Musannaf Ibn Abi Shaybah 17991","","","كتاب النكاح"
"17992","(۱۷۹۹۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ بْنِ خُثَیْمٍ ، عَنْ مَکْحُولٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عَلَیْکُمْ بِالْجَوَارِی الشَّوَابِّ فَانْکِحُوہُنَّ فَإِنَّہُنَّ أَطْیَبُ أَفْوَاہًا وَأَعَزُّ أَخْلاَقًا أفیح أَرْحَامًا۔ (سعید بن منصور ۵۱۴۔ عبدالرزاق ۱۹۳۴۲)","","Musannaf Ibn Abi Shaybah 17992","","","كتاب النكاح"
"17993","(۱۷۹۹۳) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنِ الأَعْمَشِِ ، عَنْ سَالِمٍ ، عَنْ جَابِرٍ ، قَالَ : سَأَلَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : بِکْرًا تَزَوَّجْت أَمْ ثَیِّبًا ؟ قَالَ : قُلْتُ : لاَ بَلْ ثَیِّبًا قَالَ : فَہَلاَّ جَارِیَۃً تُلاَعِبُہَا وَتُلاَعِبُک۔n(ابوداؤد ۲۰۴۱۔ بیہقی ۳۵۱)","Sahih","Musannaf Ibn Abi Shaybah 17993","","","كتاب النكاح"
"17994","(۱۷۹۹۴) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ الْعَبْدِیِّ، عَنْ نُبَیْحِ بْنِ عَبْدِ اللہِ الْعَنَزِیِّ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ قَالَ: مَشَیْت مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ: أَلَک امْرَأَۃٌ یَا جَابِرُ؟ قُلْتُ: نَعَمْ ، فَقَالَ : ثَیِّبًا نَکَحْت أَمْ بِکْرًا ؟ قُلْتُ: تَزَوَّجْتہَا وَہِیَ ثَیِّبٌ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَلَوْلاَ تَزَوَّجْتہا جَارِیَۃً تُلاَعِبُہَا قَالَ : قُلْتُ لَہُ : قتل أبی مَعَک یَوْم کَذَا وَکَذَا وَترَکَ جَوَارِیًا لہ فَکَرِہْت أَنْ أَضُمَّ إلَیْہِنَّ جَارِیَۃً ، فَتَزَوَّجْت ثَیِّبًا تَقْصَعُ قَمْلَ إحْدَاہُنَّ ، وَتَخِیطُ دِرْعَ إحْدَاہُنَّ إذَا تَخَرَّقَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فَإِنَّک نِعِمَّا رَأَیْت۔ (مسلم ۵۵۔ احمد ۳/۳۵۸)","Sahih","Musannaf Ibn Abi Shaybah 17994","","","كتاب النكاح"
"17995","(۱۷۹۹۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : مَا بَقِیَ فِی شَیْئٍ مِنْ أَخْلاَقِ الْجَاہِلِیَّۃِ ، إلاَّ أَنِّی لاَ أُبَالِی إلی أَیِٔ الْمُسْلِمِینَ نَکَحْتُ وَأَیَّہُمْ أَنْکَحْتُ۔","","Musannaf Ibn Abi Shaybah 17995","","","كتاب النكاح"
"17996","(۱۷۹۹۶) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عُمَرَ ، أَنَّہُ نَہَی أَنْ یَتَزَوَّجَ الْعَرَبِیُّ الأَمَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 17996","","","كتاب النكاح"
"17997","(۱۷۹۹۷) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو الْکَلْبِیُّ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ أَبِی سَلَمَۃَ قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ کَثِیرِ بْنِ الصَّلْتِ قَالَ نَکَحَ مَوْلًی لَنَا عَرَبِیَّۃً فَأُوتِیَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ لیستعدی عَلَیْہِ ، فَقَالَ : وَاللَّہِ لَقَدْ عَدَا مَوْلَی أَلِ کَثِیرٍ طَوْرَہُ۔","","Musannaf Ibn Abi Shaybah 17997","","","كتاب النكاح"
"17998","(۱۷۹۹۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبٍ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ طَلْحَۃَ ، قَالَ : قَالَ عُمَرُ : لأَمْنَعَنَّ فُرُوجَ ذَوَاتِ الأَحْسَابِ مِنَ النِّسَائِ إلاَّ مِنَ الأَکْفَائِ۔","","Musannaf Ibn Abi Shaybah 17998","","","كتاب النكاح"
"17999","(۱۷۹۹۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنِی مِسْعَر ، قَالَ : حَدَّثَنِی عُمَرُ بْنُ قَیْسٍ ، عَنْ عَمْرِو بْنِ أَبِی قُرَّۃَ الْکِنْدِیِّ قَالَ : عَرَضَ أَبِی عَلَی سَلْمَانَ أُخْتًا لہ فَأَبَی وَتَزَوَّجَ مَوْلاَۃً لَہُ یُقَالُ لَہَا بُقَیْرَۃُ۔","Sahih","Musannaf Ibn Abi Shaybah 17999","","","كتاب النكاح"
"18000","(۱۸۰۰۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الْکِنْدِیِّ ، عَنْ سَلْمَانَ قَالَ : لاَ نَؤُمُّہُمْ وَلاَ نَنْکِحُ نِسَائَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 18000","","","كتاب النكاح"
"18001","(۱۸۰۰۱) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنِ ابْنِ أَبِی ذِئْبٍ قَالَ قَالَ ابْنُ شِہَابٍ فِی الْعَرَبِیِّ وَالْمَوْلَی : لاَ یَسْتَوِیَانِ فِی النَّسَبِ۔","","Musannaf Ibn Abi Shaybah 18001","","","كتاب النكاح"
"18002","(۱۸۰۰۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ : حدَّثَنَا حَسَنٌ ، قَالَ : سَأَلْتُ ابْنَ أَبِی لَیْلَی ، عَنِ الْکُفُؤِ فِی النِّکَاحِ ، فَقَالَ : فِی الدِّینِ وَالْمَنْصِبِ قَالَ : قُلْتُ : فِی الْمَالِ ؟ قَالَ : لاَ۔","","Musannaf Ibn Abi Shaybah 18002","","","كتاب النكاح"
"18003","(۱۸۰۰۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ شَقِیقٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ أَحَدَ أَغْیَرُ مِنَ اللہِ وَلِذَلِکَ حَرَّمَ الْفَوَاحِشَ مَا ظَہَرَ مِنْہَا ، وَمَا بَطَنَ۔n(مسلم ۳۳۔ بخاری ۷۴۰۳)","Sahih","Musannaf Ibn Abi Shaybah 18003","","","كتاب النكاح"
"18004","(۱۸۰۰۴) حَدَّثَنَا الْحُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ وَرَّادٍ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ أَتَعْجَبُونَ مِنْ غَیْرَۃِ سَعْدٍ ؟ فَوَاللَّہِ لأَنَا أَغْیَرُ مِنْ سَعْدٍ وَاللَّہُ أَغْیَرُ مِنِّی وَمن ا[corrupt]َجْلِ غَیْرَۃِ اللہِ حَرَّمَ الْفَوَاحِشَ مَا ظَہَرَ مِنْہَا ، وَمَا بَطَنَ۔ (بخاری ۷۴۱۶۔ مسلم ۱۷)","Sahih","Musannaf Ibn Abi Shaybah 18004","","","كتاب النكاح"
"18005","(۱۸۰۰۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا الْحَجَّاجُ بْنُ أَبِی عُثْمَانَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ إبْرَاہِیمَ ، عَنِ ابْنِ عَتِیکٍ الأَنْصَارِیِّ ، عَنْ أَبِیہِ ، قَالَ : قَالَ : نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مِنَ الْغَیْرَۃِ مَا یُحِبُّ اللَّہُ وَمِنْہَا مَا یُبْغِضُ اللَّہُ فَأَمَّا الْغَیْرَۃُ الَّتِی یُحِبُّ اللَّہُ فَالْغَیْرَۃُ فِی الرِّیبَۃِ ، وَأَمَّا الْغَیْرَۃُ الَّتِی یُبْغِضُ اللَّہُ فَالْغَیْرَۃُ فِی غَیْرِ رِیبَۃٍ۔ (احمد ۵/۴۴۵۔ دارمی ۲۲۲۶)","Da'if","Musannaf Ibn Abi Shaybah 18005","","","كتاب النكاح"
"18006","(۱۸۰۰۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، قَالَ : قَالَ عَبْدُ اللہِ : احْبِسُوا النِّسَائَ فِی الْبُیُوتِ فَإِنَّ النِّسَائَ عَوْرَۃٌ وَإِنَّ الْمَرْأَۃَ إذَا خَرَجَتْ مِنْ بَیْتِہَا اسْتَشْرَفَہَا الشَّیْطَانُ وَقَالَ : لَہَا : إنَّک لاَ تَمُرِّینَ بِأَحَدٍ إلاَّ أُعْجِبَ بِک۔ (ترمذی ۱۱۷۳۔ ابن حبان ۵۵۹۸)","Sahih","Musannaf Ibn Abi Shaybah 18006","","","كتاب النكاح"
"18007","(۱۸۰۰۷) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ حَارِثَۃَ بْنِ مُضَرِّبٍ ، قَالَ : قَالَ عُمَرُ : اسْتَعِینُوا عَلَی النِّسَائِ بِالْعُرْیِ إنَّ إحْدَاہُنَّ إذَا کَثُرَتْ ثِیَابُہَا وَحَسُنَتْ زِینَتُہَا أَعْجَبَہَا الْخُرُوجُ۔","Sahih","Musannaf Ibn Abi Shaybah 18007","","","كتاب النكاح"
"18008","(۱۸۰۰۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ رَجَائٍ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ سُمَیٍّ ، عَنْ أَبِی بَکْرٍ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ بْنِ ہِشَامٍ قَالَ : کُلُّ شَیْئٍ مِنَ الْمَرْأَۃِ عَوْرَۃٌ حَتَّی ظُفُرُہَا۔","","Musannaf Ibn Abi Shaybah 18008","","","كتاب النكاح"
"18009","(۱۸۰۰۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنِّی غَیُورٌ وَإِنَّ إبْرَاہِیمَ کَانَ غَیُورًا ، وَمَا مِنَ امْرِئٍ لاَ یَغَارُ إلاَّ مَنْکُوسُ الْقَلْبِ۔","Da'if","Musannaf Ibn Abi Shaybah 18009","","","كتاب النكاح"
"18010","(۱۸۰۱۰) حَدَّثَنَا یَحْیَی بْنُ الْیَمَانِ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ وَمُطَرِّفٍ، عَنِ الشَّعْبِیِّ قَال: إذَا دُرِأَ اللِّعَانَ أُلْزِقَ بِہِ الْوَلَدُ۔","","Musannaf Ibn Abi Shaybah 18010","","","كتاب النكاح"
"18011","(۱۸۰۱۱) حَدَّثَنَا یَحْیَی بْنُ الْیَمَانِ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ َمُجَاہِدٍ ، وَعَطَائٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 18011","","","كتاب النكاح"
"18012","(۱۸۰۱۲) حَدَّثَنَا یَحْیَی بْنُ آدَمَ قَالَ: حدَّثَنَا زُہَیْرٌ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا لَمْ یَکُنْ لِعَانٌ أُلْحِقَ الْوَلَدُ بِالْوَالِدِ۔","","Musannaf Ibn Abi Shaybah 18012","","","كتاب النكاح"
"18013","(۱۸۰۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ قَالاَ : إذَا زَنَی الرَّجُلُ بِالْمَرْأَۃِ فَلَیْسَ لَہُ أَنْ یَتَزَوَّجَ ابْنَتَہَا وَلاَ أُمَّہَا۔","","Musannaf Ibn Abi Shaybah 18013","","","كتاب النكاح"
"18014","(۱۸۰۱۴) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ قَالَ : إذَا أَتَی الرَّجُلُ الْمَرْأَۃَ حَرَامًا حَرُمَتْ عَلَیْہِ ابْنَتُہَا وَإِذَا أَتَی ابْنَتَہَا حَرُمَتْ عَلَیْہِ أُمُّہَا۔","","Musannaf Ibn Abi Shaybah 18014","","","كتاب النكاح"
"18015","(۱۸۰۱۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ فِی الرَّجُلِ یَفْجُرُ بِالْمَرْأَۃِ قَالاَ : لاَ یَحِلُّ لَہُ شَیْئٌ مِنْ بَنَاتِہَا۔","","Musannaf Ibn Abi Shaybah 18015","","","كتاب النكاح"
"18016","(۱۸۰۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ مُسَبِّحٍ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ ، عَنْ رَجُلٍ فَجَرَ بِأَمَۃٍ ثُمَّ أَرَادَ أَنْ یَتَزَوَّجَ أُمَّہَا قَالَ : لاَ یَتَزَوَّجُہَا۔","","Musannaf Ibn Abi Shaybah 18016","","","كتاب النكاح"
"18017","(۱۸۰۱۷) حدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سَیْفٌ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ طَاوُوسٍ ، أَنَّہُ کَانَ یَقُولُ : لو أنَّ رَجُلاً تَزَوَّجَ امْرَأَۃً فَطَلَّقَہَا ، أَوْ مَاتَ عَنْہَا وَلَہَا ابْنَۃٌ ، یَحِلُّ لابْنِ الرَّجُلِ أَنْ یَتَزَوَّجَہَا۔","","Musannaf Ibn Abi Shaybah 18017","","","كتاب النكاح"
"18018","(۱۸۰۱۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سَیْفٌ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 18018","","","كتاب النكاح"
"18019","(۱۸۰۱۹) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ قَالَ : حدَّثَنَا سَیْفٌ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 18019","","","كتاب النكاح"
"18020","(۱۸۰۲۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سَیْفٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عِکْرِمَۃَ مَوْلَی ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَرِہَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 18020","","","كتاب النكاح"
"18021","(۱۸۰۲۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، وَوَکِیعٌ ، وَحَفْصٌ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ مَالِکِ بْنِ الْحَارِثِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ عَبْدِ اللہِ ؛ {فَطَلِّقُوہُنَّ لِعِدَّتِہِنَّ} قَالَ : فِی غَیْرِ جِمَاعٍ۔","","Musannaf Ibn Abi Shaybah 18021","","","كتاب الجنة"
"18022","(۱۸۰۲۲) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ ، قَالَ : إذَا أَرَادَ الرَّجُلُ أَنْ یُطَلِّقَ امْرَأَتَہُ ، فَلْیُطَلِّقْہَا طَاہِرًا فِی غَیْرِ جِمَاعٍ۔","Sahih","Musannaf Ibn Abi Shaybah 18022","","","كتاب الجنة"
"18023","(۱۸۰۲۳) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ الدَّالاَنِیِّ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ الْحِمْیَرِیِّ ، قَالَ : بَلَغَ أَبَا مُوسَی أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَدَ عَلَیْہِمْ ، فَأَتَاہُ فَذَکَرَ ذَلِکَ لَہُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَقُولُ أَحَدُکُمْ : قَدْ تَزَوَّجْتُ ، قَدْ طَلَّقْتُ وَلَیْسَ کَذَا عِدَّۃُ الْمُسْلِمِینَ ، طَلِّقُوا الْمَرْأَۃَ فِی قُبُلِ عِدَّتِہَا۔ (ابن ماجہ ۲۰۱۷۔ ابن حبان ۴۲۶۵)","","Musannaf Ibn Abi Shaybah 18023","","","كتاب الجنة"
"18024","(۱۸۰۲۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : سَمِعْتُ مُجَاہِدًا یُحَدِّثُ عَنِ ابْنِ عَبَّاسٍ ؛ فِی ہَذَا الْحَرْفِ : {یَا أَیُّہَا النَّبِیُّ إذَا طَلَّقْتُمُ النِّسَائَ فَطَلِّقُوہُنَّ لِعِدَّتِہِنَّ} قَالَ : فِی قُبُلِ عِدَّتِہِنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 18024","","","كتاب الجنة"
"18025","(۱۸۰۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ ، عَنِ ابْنِ سِیرِینَ قَالَ : قَالَ رَجُلٌ ، یَعْنِی عَلِیًّا ، لَوْ أَنَّ النَّاسَ أَصَابُوا حَدَّ الطَّلاَقِ مَا نَدِمَ رَجُلٌ عَلَی امْرَأَۃٍ ، یُطَلِّقُہَا وَہِیَ حَامِلٌ قَدْ تَبَیَّنَ حَمْلُہَا ، أَوْ طَاہِرٌ لَمْ یُجَامِعْہَا مُنْذُ طَہُرَت ، یَنْتَظِرُ حَتَّی إذَا کَانَ فِی قُبُلِ عِدَّتِہَا طَلَّقَہَا ، فَإِنْ بَدَا لَہُ أَنْ یُرَاجِعَہَا رَاجَعَہَا ، وَإِنْ بَدَا لَہُ أَنْ یُخَلِّیَ سَبِیلَہَا خَلَّی سَبِیلَہَا۔","","Musannaf Ibn Abi Shaybah 18025","","","كتاب الجنة"
"18026","(۱۸۰۲۶) حدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا قَالاَ : طَلاَقُ السُّنَّۃِ فِی قُبُلِ الْعِدَّۃِ ، یُطَلِّقُہَا طَاہِرًا فِی غَیْرِ جِمَاعٍ ، وَإِنْ کَانَ بِہَا حَمْلٌ طَلَّقَہَا مَتَی شَائَ۔","","Musannaf Ibn Abi Shaybah 18026","","","كتاب الجنة"
"18027","(۱۸۰۲۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : طَلَّقْتُ امْرَأَتِی وَہِیَ حَائِضٌ ، فَذَکَرَ ذَلِکَ عُمَرُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : مُرْہُ فَلْیُرَاجِعْہَا حَتَّی تَطْہُرَ ، ثُمَّ تَحِیضَ ، ثُمَّ تَطْہُرَ ، ثُمَّ إِنْ شَائَ طَلَّقَہَا قَبْلَ أَنْ یُجَامِعَہَا ، وَإِنْ شَائَ أَمْسَکَہَا ، فَإِنَّہَا الْعِدَّۃُ الَّتِی قَالَ اللَّہُ۔n(مسلم ۱۰۹۴۔ مالک ۵۳)","Sahih","Musannaf Ibn Abi Shaybah 18027","","","كتاب الجنة"
"18028","(۱۸۰۲۸) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ قَالَ : طَلَّقَ ابْنُ عُمَرَ امْرَأَتَہُ وَہِیَ حَائِضٌ ، فَأَتَی عُمَرُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرَہُ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مُرْہُ فَلْیُرَاجِعْہَا ، ثُمَّ لِیُطَلِّقْہَا طَاہِرًا فِی غَیْرِ جِمَاعٍ۔","","Musannaf Ibn Abi Shaybah 18028","","","كتاب الجنة"
"18029","(۱۸۰۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، مَوْلَی آلِ طَلْحَۃَ ، عَنْ سَالِمٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ طَلَّقَ امْرَأَتَہُ وَہِیَ حَائِضٌ ، فَذَکَرَ ذَلِکَ عُمَرُ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مُرْہُ فَلْیُرَاجِعْہَا ثُمَّ لِیُطَلِّقْہَا طَاہِرًا ، أَوْ حَامِلاً۔ (مسلم ۵۔ ابوداؤد ۲۱۷۴)","Sahih","Musannaf Ibn Abi Shaybah 18029","","","كتاب الجنة"
"18030","(۱۸۰۳۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ قَالَ : إذَا طَلَّقَہَا فِی طُہْرٍ قَدْ جَامَعَہَا فِیہِ ، لَمْ تَعْتَدَّ فِیہِ بِتِلْکَ الْحَیْضَۃِ۔","","Musannaf Ibn Abi Shaybah 18030","","","كتاب الجنة"
"18031","(۱۸۰۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ بَیَانٍ ، عَنِ الشَّعْبِیِّ قَالَ : إذَا طَلَّقَہَا وَہِیَ طَاہِرٌ فَقَدْ طَلَّقَہَا لِلسُّنَّۃِ ، وَإِنْ کَانَ قَدْ جَامَعَہَا۔","","Musannaf Ibn Abi Shaybah 18031","","","كتاب الجنة"
"18032","(۱۸۰۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عِکْرِمَۃَ ، وَمُجَاہِدٍ ؛ (فَطَلِّقُوہُنَّ لِعِدَّتِہِنَّ) قَالاَ : طَاہِرًا فِی غَیْرِ جِمَاعٍ۔","","Musannaf Ibn Abi Shaybah 18032","","","كتاب الجنة"
"18033","(۱۸۰۳۳) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدِ ، عَنْ مُحَمَّدٍ ؛ (فَطَلِّقُوہُنَّ لِعِدَّتِہِنَّ) قَالَ : طَاہِرًا ، أَوْ حَامِلاً۔","","Musannaf Ibn Abi Shaybah 18033","","","كتاب الجنة"
"18034","(۱۸۰۳۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیدَۃَ ، عَنْ عَلِیٍّ قَالَ : مَا طَلَّقَ رَجُلٌ طَلاَقَ السُّنَّۃِ فَنَدِمَ۔","Sahih","Musannaf Ibn Abi Shaybah 18034","","","كتاب الجنة"
"18035","(۱۸۰۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَبْدِ اللہِ قَالَ : طَلاَقُ السُّنَّۃِ فِی قُبُلِ الطُّہْرِ مِنْ غَیْرِ جِمَاعٍ","","Musannaf Ibn Abi Shaybah 18035","","","كتاب الجنة"
"18036","(۱۸۰۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَصِ ، عَنْ عَبْدِ اللہِ قَالَ : مَنْ أَرَادَ الطَّلاَقَ الَّذِی ہُوَ الطَّلاَقُ فَلْیُطَلِّقْہَا تَطْلِیقَۃً ، ثُمَّ یَدَعَہَا حَتَّی تَحِیضَ ثَلاَثَ حِیَضٍ۔","Sahih","Musannaf Ibn Abi Shaybah 18036","","","كتاب الجنة"
