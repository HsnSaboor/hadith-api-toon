hadiths[627]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"18151","عَنِ الثَّوْرِيِّ , عَنْ أَبِي الْمِقْدَامِ , قَالَ :  أَخْبَرَنِي مَنْ رَأَى عَلِيًّايَقْطَعُ يَدَ رَجُلٍ مِنَ الْمَفْصِلِ ""","","","","","The Book of the People of the Two Books"
"18152","عَنِ الثَّوْرِيِّ , عَنْ يَحْيَى بْنِ عَبْدِ اللَّهِ التَّيْمِيِّ , عَنْ حِبَالِ بْنِ رُفَيْدَةَ التَّيْمِيِّ ، أَنَّ عَلِيًّا :  كَانَيَقْطَعُ الرِّجْلَ مِنَ الْكَفِّ ""","","","","","The Book of the People of the Two Books"
"18153","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو ابْنُ دِينَارٍ , أَنَّ نَجْدَةَ بْنَ عَامِرٍ , كَتَبَ إِلَى ابْنِ عَبَّاسٍ :السَّارِقُ يَسْرِقُ فَتُقْطَعُ يَدُهُ , ثُمَّ يَعُودُ فَتُقْطَعُ يَدُهُ الأُخْرَى ؟ ، قَالَ اللَّهُ تَعَالَى :  فَاقْطَعُوا أَيْدِيَهُمَا , قَالَ :  بَلَى , وَلَكِنْ يَدُهُ وَرِجْلُهُ مِنْ خِلافٍ ""قَالَ : قَالَ عَمْرٌو : سَمِعْتُهُ مِنْ عَطَاءٍ مُنْذُ أَرْبَعِينَ سَنَةً""","","","","","The Book of the People of the Two Books"
"18154","عَنْ مَعْمَرٍ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , قَالَ : كَانَ عَلِيٌّ : لا يَقْطَعُ إِلا الْيَدَ وَالرِّجْلَ , وَإِنْ سَرَقَ بَعْدَ ذَلِكَ سُجِنَ , وَنُكِّلَ , وَكَانَ يَقُولُ : إِنِّي لأَسْتَحْيِي اللَّهَ , أَلا أَدَعَ لَهُ يَدًا يَأْكُلُ بِهَا وَيَسْتَنْجِي ""","","","","","The Book of the People of the Two Books"
"18155","عَنْ مَعْمَرٍ , عَنْ مَنْصُورٍ , عَنِ إِبْرَاهِيمَ , قَالَ :  كَانُوا يَقُولُونَ :لا يُتْرَكُ ابْنُ آدَمَ مِثْلَ الْبَهِيمَةِ , لَيْسَ لَهُ يَدٌ يَأْكُلُ بِهَا , وَيَسْتَنْجِي بِهَا ""","","","","","The Book of the People of the Two Books"
"18156","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ , عَنْ سِمَاكِ بْنِ حَرْبٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَائِذٍ الأَزْدِيِّ , عَنْ عُمَرَ , أَنَّهُ أُتِيَ بِرَجُلٍ قَدْ سَرَقَ , يُقَالُ لَهُ : سَدُومٌ , فَقَطَعَهُ , ثُمَّ أُتِيَ بِهِ الثَّانِيَةَ , فَقَطَعَهُ , ثُمَّ أُتِيَ بِهِ الثَّالِثَةَ , فَأَرَادَ أَنْ يَقْطَعَهُ , فَقَالَ لَهُ عَلِيٌّ : لا تَفْعَلْ ، إِنَّمَا عَلَيْهِ يَدٌ وَرِجْلٌ ، وَلَكِنِ احْبِسْهُ ""","","","","","The Book of the People of the Two Books"
"18157","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ أَبِي الضُّحَى : أَنَّ عَلِيًّا :  كَانَ يَقُولُإِذَا سَرَقَ قُطِعَتْ يَدُهُ , ثُمَّ إِذَا سَرَقَ الثَّانِيَةَ , قُطِعَتْ رِجْلُهُ , فَإِنْ سَرَقَ بَعْدَ ذَلِكَ لَمْ نَرَ عَلَيْهِ قَطْعًا ""","","","","","The Book of the People of the Two Books"
"18158","عَنْ مَعْمَرٍ , عَنْ خَالِدٍ الْحَذَّاءِ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : شَهِدْتُ لَرَأَيْتُ عُمَرَ قَطَعَ رِجْلَ رَجُلٍ , بَعْدَ يَدٍ وَرِجْلٍ ، سَرَقَ الثَّالِثَةَ ""","","","","","The Book of the People of the Two Books"
"18159","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ , عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ :  أَنَّسَارِقًا مَقْطُوعَ الْيَدِ وَالرِّجْلِ سَرَقَ حُلِيًّا لأَسْمَاءَ , فَقَطَعَهُ أَبُو بَكْرٍ الثَّالِثَةَ ، قَالَ : حَسِبْتُهُ قَالَ : يَدَهُ ""","","","","","The Book of the People of the Two Books"
"18160","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , وَغَيْرِهِ , قَالَ :  إِنَّمَاقَطَعَ أَبُو بَكْرٍ رِجْلَهُ , وَكَانَ مَقْطُوعَ الْيَدِ ""، قَالَ الزُّهْرِيُّ : "" وَلَمْ يَبْلُغْنَا فِي السُّنَّةِ إِلا قَطْعُ الْيَدِ وَالرِّجْلِ , لا يُزَادُ عَلَى ذَلِكَ ""","","","","","The Book of the People of the Two Books"
"18161","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ :  إِنَّمَاقَطَعَ أَبُو بَكْرٍ رِجْلَ الَّذِي قَطَعَ يَعْلَى بْنُ أُمَيَّةَ ، وَكَانَ مَقْطُوعَ الْيَدِ قَبْلَ ذَلِكَ ""","","","","","The Book of the People of the Two Books"
"18162","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : إِذَا سَرَقَ السَّارِقُ قُطِعَتْ يَدُهُ , فَإِنْ سَرَقَ الثَّانِيَةَ قُطِعَتْ رِجْلُهُ , فَإِنْ سَرَقَ الثَّالِثَةَ قُطِعَتْ يَدُهُ , فَإِنْ سَرَقَ الرَّابِعَةَ قُطِعَتْ رِجْلُهُ ""","","","","","The Book of the People of the Two Books"
"18163","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ رَبِّهِ بْنُ أَبِي أُمَيَّةَ ، أَنَّ الْحَارِثَ بْنَ عَبْدِ اللَّهِ بْنِ أَبِي رَبِيعَةَ حَدَّثَهُ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أُتِيَ بِعَبْدٍ سَرَقَ , فَأُتِيَ بِهِ أَرْبَعَ مَرَّاتٍ , فَتَرَكَهُ , ثُمَّ أُتِيَ بِهِ الْخَامِسَةَ فَقَطَعَ يَدَهُ , ثُمَّ السَّادِسَةَ فَقَطَعَ رِجْلَهُ , ثُمَّ السَّابِعَةَ فَقَطَعَ يَدَهُ , ثُمَّ الثَّامِنَةَ فَقَطَعَ رِجْلَهُ ""","","","","","The Book of the People of the Two Books"
"18164","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ عُرْوَةَ , عَنْ عَائِشَةَ , قَالَتْ : كَانَ رَجُلٌ أَسْوَدُ يَأْتِي أَبَا بَكْرٍ فَيُدْنِيهِ , وَيُقْرِئُهُ الْقُرْآنَ , حَتَّى بَعَثَ سَاعِيًا ، أَوْ قَالَ : سَرِيَّةً ، فَقَالَ : أَرْسِلْنِي مَعَهُ , فَقَالَ :  بَلْ تَمْكُثُ عِنْدَنَا , فَأَبَى , فَأَرْسَلَهُ مَعَهُ , وَاسْتَوْصَى بِهِ خَيْرًا "" , فَلَمْ يَغِبْ عَنْهُ إِلا قَلِيلا حَتَّى جَاءَ قَدْ قُطِعَتْ يَدُهُ , فَلَمَّا رَآهُ أَبُو بَكْرٍ فَاضَتْ عَيْنَاهُ , وَقَالَ : "" مَا شَأْنُكَ ؟ ، قَالَ : مَا زِدْتُ عَلَى أَنَّهُ كَانَ يُوَلِّينِي شَيْئًا مِنْ عَمَلِهِ , فَخُنْتَهُ فَرِيضَةً وَاحِدَةً , فَقَطَعَ يَدِي , فَقَالَ أَبُو بَكْرٍ :"" تَجِدُونَ الَّذِي قَطَعَ يَدَ هَذَا يَخُونَ أَكْثَرَ مِنْ عِشْرِينَ فَرِيضَةً , وَاللَّهِ لَئِنْ كُنْتُ صَادِقًا لأُقِيدَنَّكَ مِنْهُ "" , قَالَ : ثُمَّ أَدْنَاهُ وَلَمْ يُحَوِّلْ مَنْزِلَتَهُ الَّتِي كَانَتْ لَهُ مِنْهُ , قَالَ : وَكَانَ الرَّجُلُ يَقُومُ مِنَ اللَّيْلِ فَيَقْرَأُ , فَإِذَا سَمِعَ أَبُو بَكْرٍ صَوْتَهُ قَالَ : "" تَالَلَّهِ لَرَجُلٌ قَطَعَ هَذَا "" , قَالَ : فَلَمْ يَعِرْ إِلا قَلِيلا حَتَّى فَقَدَ آلُ أَبِي بَكْرٍ حُلِيًّا لَهُمْ وَمَتَاعًا , فَقَالَ أَبُو بَكْرٍ : "" طَرَقَ الْحَيَّ اللَّيْلَةَ "" , فَقَامَ الأَقْطَعُ فَاسْتَقْبَلَ الْقِبْلَةَ , وَرَفَعَ يَدَهُ الصَّحِيحَةَ وَالأُخْرَى الَّتِي قُطِعَتْ , فَقَالَ : اللَّهُمَّ أَظْهِرْ عَلَى مَنْ سَرَقَهُمْ , أَوْ نَحْوَ هَذَا "", وَكَانَ مَعْمَرٌ رُبَّمَا يَقُولُ : اللَّهُمَّ أَظْهِرْ عَلَى مَنْ سَرَقَ أَهْلَ هَذَا الْبَيْتِ الصَّالِحِينَ , قَالَ : فَمَا انْتَصَفَ النَّهَارُ حَتَّى ظَهَرُوا عَلَى الْمَتَاعِ عِنْدَهُ , فَقَالَ لَهُ أَبُو بَكْرٍ : "" وَيْلَكَ إِنَّكَ لَقَلِيلُ الْعِلْمِ بِاللَّهِ , فَأَمَرَ بِهِ , فَقُطِعَتْ رِجْلُهُ "" ، قَالَ مَعْمَرٌ : وَأَخْبَرَنِي أَيُّوبُ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ نَحْوَهُ إِلا أَنَّهُ قَالَ : كَانَ إِذَا سَمِعَ أَبُو بَكْرٍ صَوْتَهُ مِنَ اللَّيْلِ , قَالَ : مَا لَيْلُكَ بِلَيْلِ سَارِقٍ""","","","","","The Book of the People of the Two Books"
"18165","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي غَيْرُ وَاحِدٍ مِنْ أَهْلِ الْمَدِينَةِ ، مِنْهُمْ إِسْمَاعِيلُ بْنُ مُحَمَّدِ بْنِ سَعْدٍ ، أَنَّ يَعْلَىقَطَعَ يَدَ السَّارِقِ وَرِجْلَهُ , فَسَرَقَ الثَّالِثَةَ , فَقَطَعَ أَبُو بَكْرٍ يَدَهُ الثَّانِيَةَ  , ثُمَّ ذَكَرَ نَحْوَ حَدِيثِ الزُّهْرِيِّ ، قَالَ : فَكَانَ أَبُو بَكْرٍ , يَقُولُ : "" لَجَرَاءَتُهُ عَلَى اللَّهِ أَغْيَظُ عِنْدِي مِنْ سَرِقَتِهِ ""، قَالَ ابْنُ جُرَيْجٍ : وَأَخْبَرَنِي عَبْدُ اللَّهِ بْنُ أَبِي بَكْرٍ : أَنَّ اسْمَهُ جَبْرٌ أَوْ جُبَيْرٌ""","","","","","The Book of the People of the Two Books"
"18166","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ :  فِيرَجُلٍ أَشَلِّ الْيَدِ سَرَقَ , قَالَ : تُقْطَعُ يَدُهُ وَإِنْ كَانَتْ شَلاءَ ""","","","","","The Book of the People of the Two Books"
"18167","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ :  أَنَّهُ سُئِلَ عَنْسَارِقٍ قُرِّبَ لِيُقْطَعَ ، فَقَدَّمَ شِمَالَهُ , فَقُطِعَتْ , قَالَ : يُتْرَكُ وَلا يُزَادُ عَلَى ذَلِكَ ""","","","","","The Book of the People of the Two Books"
"18168","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , مِثْلَ قَوْلِ الشَّعْبِيّ : لا يُزَادُ عَلَى ذَلِكَ ، قَدْ أُقِيمَ عَلَيْهِ الْحَدُّ ""","","","","","The Book of the People of the Two Books"
"18169","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ عِكْرِمَةَ بْنِ خَالِدٍ , قَالَ : كَانَ عَلِيٌّ : لا يَقْطَعُ سَارِقًا حَتَّى يَأْتِيَ بِالشُّهَدَاءِ , فَيُوقِفَهُمْ عَلَيْهِ وَيَسْجُنَهُ , فَإِنْ شَهِدُوا عَلَيْهِ قَطَعَهُ , وَإِنْ نَكَلُوا تَرَكَهُ "", قَالَ : فَأُتِيَ مَرَّةً بِسَارِقٍ , فَسَجَنَهُ , حَتَّى إِذَا كَانَ الْغَدُ , دَعَا بِهِ وَبِالشَّاهِدَيْنِ , فَقِيلَ : تَغَيَّبَ الشَّهِيدَانِ ، فَخَلَّى سَبِيلَ السَّارِقِ , وَلَمْ يَقْطَعْهُ""","","","","","The Book of the People of the Two Books"
"18170","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ :  فِيرَجُلٍ شَهِدَ عَلَيْهِ رَجُلٌ أَنَّهُ سَرَقَ بِأَرْضٍ , وَشَهِدَ عَلَيْهِ آخَرُ أَنَّهُ سَرَقَ بِأَرْضٍ أُخْرَى , قَالَ : "" لا قَطْعَ عَلَيْهِ ""","","","","","The Book of the People of the Two Books"
"18171","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ :  فِيرَجُلٍ وُجِدَ يَسْرِقُ ، فَاعْتَرَفَ أَنَّهُ قَدْ سَرَقَ قَبْلَ ذَلِكَ ، قَالَ : تُقْطَعُ يَدُهُ ، لا يُزَادُ عَلَى ذَلِكَ ""","","","","","The Book of the People of the Two Books"
"18172","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ :  إِنْسَرَقَ ثُمَّ سَرَقَ وَلَمْ يُحَدَّ ، قُطِعَ مَرَّةً وَاحِدَةً , وَكَذَلِكَ الزَّانِي ""، وَقَالَ ابْنُ شِهَابٍ مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18173","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , وَالأَعْمَشِ , عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِيهِ , قَالَ : جَاءَ رَجُلٌ إِلَى عَلِيٍّ , فَقَالَ :  إِنِّي سَرَقْتُ فَرَدَّهُ , فَقَالَ : إِنِّي سَرَقْتُ , فَقَالَ :شَهِدْتَ عَلَى نَفْسِكَ مَرَّتَيْنِ "" ، فَقَطَعَهُ ، قَالَ : فَرَأَيْتُ يَدَهُ فِي عُنُقِهِ مُعَلَّقَةً""","","","","","The Book of the People of the Two Books"
"18174","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِيهِ , أَنَّ رَجُلا أَتَى إِلَى عَلِيٍّ , فَقَالَ :  إِنِّي سَرَقْتُ , فَانْتَهَرَهُ وَسَبَّهُ , فَقَالَ : إِنِّي سَرَقْتُ , فَقَالَ عَلِيٌّ :اقْطَعُوهُ ، قَدْ شَهِدَ عَلَى نَفْسِهِ مَرَّتَيْنِ , فَلَقَدْ رَأَيْتُهَا فِي عُنُقِهِ ""","","","","","The Book of the People of the Two Books"
"18175","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : رَجُلٌ شَهِدَ عَلَى نَفْسِهِ مَرَّةً وَاحِدَةً , قَالَ : حَسْبُهُ ""","","","","","The Book of the People of the Two Books"
"18176","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : لا يَجُوزُ الاعْتِرَافُ بَعْدَ عُقُوبَةٍ فِي حَدٍّ وَلا غَيْرِهِ ""","","","","","The Book of the People of the Two Books"
"18177","عَنْ سُفْيَانَ , قَالَ : إِذَا اعْتَرَفَ بِسَرِقَةٍ , ثُمَّ أَنْكَرَ عِنْدَ السُّلْطَانِ , فَإِنْ نَكَلَ تُرِكَ , وَغَرِمَ مَا اعْتَرَفَ بِهِ , وَلَمْ يُقْطَعْ , أَوْ سَرَقَ , ثُمَّ مَاتَ قَبْلَ أَنْ يُقْطَعَ , تُؤْخَذُ السَّرِقَةُ مِنْ مَالِهِ إِذَا لَمْ يُقَمْ عَلَيْهِ الْحَدُّ , وَلَمْ يَذْهَبِ الْمَالُ ""","","","","","The Book of the People of the Two Books"
"18178","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنِ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , أَنَّ رَجُلا كَانَ مَعَ قَوْمٍ يُتَّهَمُونَ بِهَوًى , فَأَصْبَحَ يَوْمًا قَتِيلا , فَاتُّهِمَ بِهِ رَجُلٌ مِنَ الْقَوْمِ , فَأَرْسَلَ لَهُ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ : وَأَمَرَ بِالسِّيَاطِ , فَقَالَ الرَّجُلُ : أَيُّهَا الْمُسْلِمُونَ ! إِنِّي وَاللَّهِ مَا قَتَلْتُهُ ، وَإِنْ جَلَدَنِي لأَعْتَرِفَنَّ ، فَأَمَرَ بِهِ عُمَرُ "" فَاسْتُحْلِفَ , وَخَلَّى سَبِيلَهُ ""","","","","","The Book of the People of the Two Books"
"18179","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , قَالَ : رَهَّبَ قَوْمٌ غُلامًا حَتَّى اعْتَرَفَ لَهُمْ بِبَعْضِ مَا أَرَادُوا , ثُمَّ أَنْكَرَ بَعْدُ , فَخَاصَمُوهُ إِلَى شُرَيْحٍ , فَقَالَ : هُوَ هَذَا إِنْ شَاءَ اعْتَرَفَ , وَلَمْ يُجِزِ اعْتِرَافَهُ بِالتَّهْدِيدِ ""","","","","","The Book of the People of the Two Books"
"18180","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , قَالَ : الْمِحْنَةُ بِدْعَةٌ ""","","","","","The Book of the People of the Two Books"
"18181","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ , عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ شريح , قَالَ : الْقَيْدُ كَرْهٌ , وَالْوَعِيدُ كَرْهٌ , وَالسِّجْنُ كَرْهٌ , وَالضَّرْبُ كَرْهٌ ""","","","","","The Book of the People of the Two Books"
"18182","عَنِ الثَّوْرِيِّ , عَنِ الشَّيْبَانِيِّ ، عَنْ حَنْظَلَةَ , عَنْ أَبِيهِ , عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : لَيْسَ الرَّجُلُ أَمِينًا عَلَى نَفْسِهِ إِذَا أَجَعْتَهُ , أَوْ أَوْثَقْتَهُ , أَوْ ضَرَبْتَهُ ""","","","","","The Book of the People of the Two Books"
"18183","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ عِكْرِمَةَ بْنِ خَالِدٍ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ  أُتِيَ بِسَارِقٍ فَاعْتَرَفَ ، قَالَ :أَرَى يَدَ رَجُلٍ مَا هِيَ بِيَدِ سَارِقٍ ، فَقَالَ الرَّجُلُ : وَاللَّهِ مَا أَنَا بِسَارِقٍ وَلَكِنَّهُمْ تَهَدَّدُونِي ، فَخَلَّى سَبِيلَهُ ، وَلَمْ يَقْطَعْهُ ""","","","","","The Book of the People of the Two Books"
"18184","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ :  فِيرَجُلٍ بَاعَ حُرًّا , وَقَالَ : الثَّمَنُ بَيْنِي وَبَيْنَكَ , قَالَ : يُعَاقَبَانِ ، وَيُرَدُّ الثَّمَنُ إِلَى الَّذِي ابْتَاعَهُ ""، قَالَ مَعْمَرٌ : وَأَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ يَقُولُهُ""","","","","","The Book of the People of the Two Books"
"18185","عَنْ سُفْيَانَ :  فِيالرَّجُلِ يَبِيعُ الْحُرَّ ، قَالَ : لا قَطْعَ عَلَيْهِ , وَلا بَيْعَ لَهُ , وَعَلَيْهِ تَعْزِيرٌ ""","","","","","The Book of the People of the Two Books"
"18186","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ :  يَكُونُعَبْدًا كَمَا أَقَرَّ بِالْعُبُودِيَّةِ عَلَى نَفْسِهِ ""، قَالَ قَتَادَةُ : وَقَالَ عَلِيٌّ : "" لا يَكُونُ عَبْدًا ، وَيُقْطَعُ الْبَائِعُ ""","","","","","The Book of the People of the Two Books"
"18187","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ :  أَنَّ رَجُلا بَاعَ ابْنَتَهُ فَوَقَعَ عَلَيْهَا الْمُبْتَاعُ , وَقَالَ أَبُوهَا : حَمَلَتْنِي الْحَاجَةُ عَلَى بَيْعِهَا , قَالَ :"" يُجْلَدُ الأَبُ وَالْجَارِيَةُ مِائَةً مِائَةً , إِنْ كَانَتِ الْجَارِيَةُ قَدْ بَلَغَتْ , وَيُرَدُّ الثَّمَنُ إِلَى الْمُبْتَاعِ , وَعَلَى الْمُبْتَاعِ صَدَاقُهَا بِمَا أَصَابَ مِنْهَا , ثُمَّ يَغْرَمُهُ لَهُ الأَبُ , إِلا أَنْ يَكُونَ الْمُبْتَاعُ قَدْ عَلِمَ أَنَّهَا حُرَّةً , فَعَلَيْهِ الصَّدَاقُ , لا يَغْرَمُهُ لَهُ الأَبُ , وَعَلَيْهِ مِائَةُ جَلْدَةٍ , وَإِنْ كَانَتْ جَارِيَةً لا تَعْقِلُ , فَالنَّكَالُ عَلَى الأَبِ ""","","","","","The Book of the People of the Two Books"
"18188","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , قَالَ : لا يُبَاعُ الأَحْرَارُ , وَلا يُتَصَدَّقُ بِهِمْ ""","","","","","The Book of the People of the Two Books"
"18189","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : لا يُبَاعُ الأَحْرَارُ ""","","","","","The Book of the People of the Two Books"
"18190","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً ، عَنْ رَجُلٍ أَقَرَّ أَنَّهُ عَبْدٌ ، قَالَ : لا يَكُونُ الْحُرُّ عَبْدًا ""","","","","","The Book of the People of the Two Books"
"18191","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ , عَنِ إِبْرَاهِيمَ , قَالَ : قُلْتُ لَهُ : رَجُلٌ حُرٌّ أَقَرَّ بِالْعُبُودِيَّةِ , فَرُهِنَ ، قَالَ : هُوَ رَهْنٌ حَتَّى يَفُكَّ نَفْسَهُ كَمَا غَرَّهُمْ ""","","","","","The Book of the People of the Two Books"
"18192","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ ، قَالَ : سَأَلْتُهُ عَنْ رَجُلٍ سَرَقَ عَبْدًا أَعْجَمِيًا لا يَفْقَهُ ، قَالَ : "" تُقْطَعُ يَدُهُ ""","","","","","The Book of the People of the Two Books"
"18193","عَنِ الثَّوْرِيِّ ، عَنْ إِسْمَاعِيلَ , عَنِ الْحَسَنِ , قَالَ : مَنْ سَرَقَ صَغِيرًا حُرًّا , أَوْ عَبْدًا فَفِيهِ الْقَطْعُ "" ، قَالَ : وَقَالَ إِبْرَاهِيمُ : "" يُقَامُ الْحَدُّ عَلَى الْكَبِيرِ , وَلَيْسَ عَلَى الصَّغِيرِ شَيْءٌ ""","","","","","The Book of the People of the Two Books"
"18194","عَنْ سُفْيَانَ , يَقُولُ : مَا سَرَقَ مِنْ صَغِيرٍ مَمْلُوكٍ فَفِيهِ الْقَطْعُ , وَمَنْ سَرَقَ مِنْ صَغِيرٍ حُرًّا أَوْ مَمْلُوكًا بَلَغَ , فَلا قَطْعَ عَلَيْهِ "" , قَالَ سُفْيَانُ : إِذَا بَاعَ امْرَأَتَهُ الرَّجُلُ ، فَوَقَعَ عَلَيْهَا الْمُشْتَرِي , فَوَلَدَتْ , ثُمَّ عَلِمَ بَعْدَ ذَلِكَ بِهِ ؟ قَالَ : "" تُرَدُّ عَلَى زَوْجِهَا , وَلا تَكُونُ فُرْقَةً , وَتُعَزَّرُ الْمَرْأَةُ وَزَوْجُهَا ""","","","","","The Book of the People of the Two Books"
"18195","عَنِ ابْنِ التَّيْمِيِّ , عَنِ ابْنِ شُبْرُمَةَ , قَالَ : دَعَانِي /يُوسُفُ بْنُ عُمَرَ فَسَأَلَنِي عَنْ رَجُلٍ بَاعَ امْرَأَتَهُ ، أَعَلَيْهِ قَطْعٌ ؟ ، قَالَ : قُلْتُ : لا ، بَلَغَنَا أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ فِي حَجَّةِ الْوَدَاعِ :إِنَّمَا أَخَذْتُمُوهُنَّ بِأَمَانَةِ اللَّهِ , فَهِي عِنْدَنَا أَمَانَةٌ ، خَانَهَا , لا قَطْعَ عَلَيْهِ ، قَالَ : فَضَرَبَهُ ضَرْبًا كَانَ أَشَدَّ عَلَيْهِ مِنَ الْقَطْعِ","","","","","The Book of the People of the Two Books"
"18196","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : أُخْبِرْتُ أَنَّ عَلِيًّا قَطَعَ الْبَائِعَ , وَقَالَ : لا يَكُونُ الْحُرُّ عَبْدًا "" ، قَالَ : وَقَالَ ابْنُ عَبَّاسٍ : "" لَيْسَ عَلَيْهِ قَطْعٌ , وَعَلَيْهِ شَبِيهٌ بِالْقَطْعِ ، الْحَبْسُ ""","","","","","The Book of the People of the Two Books"
"18197","عَنْ أَبِي بَكْرِ بْنِ عَبْدِ اللَّهِ ، أَنَّ عَمْرَو بْنَ سُلَيْمٍ , مَوْلاهُمْ أَخْبَرَهُ ، أَنَّ سَعِيدَ بْنَ الْمُسَيِّبِ :  سُئِلَ عَنْ رَجُلٍ يَبِيعُ وَلَدَهُ , قَالَ : "" إِنْبَاعَ مَنْ قَدْ بَلَغَ الْعَقْلَ , فَأَقَرَّ بِذَلِكَ , فَعَلَى الْمَرْأَةِ إِنْ أُصِيبَتِ الْحَدُّ , وَعَلَى أَبِيهَا الْعُقُوبَةُ الْمُؤْلِمَةُ , وَأَدَاءُ ثَمَنِهَا عَلَى أَبِيهَا , وَوَلَدُهَا فِي مَوْضِعِ وَلَدِ حَلالٍ , وَإِنْ كَانَ رَجُلا قَدْ بَلَغَ الْعَقْلَ , فَعَلَيْهِ وَعَلَى أَبِيهِ الْعُقُوبَةُ الْمُؤْلِمَةُ , وَعَلَى أَبِيهِ غُرْمُ ثَمَنِهِ ""","","","","","The Book of the People of the Two Books"
"18198","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ :  أَنَّهُقَطَعَ رَجُلا فِي غُلامٍ سَرَقَهُ ""","","","","","The Book of the People of the Two Books"
"18199","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : السَّارِقُ يُوجَدُ فِي الْبَيْتِ , قَدْ جَمَعَ الْمَتَاعَ وَلَمْ يَخْرُجْ بِهِ , قَالَ "" لا قَطْعَ عَلَيْهِ حَتَّى يَخْرُجَ بِهِ "" قَالَ : وَقَالَ لِي عَمْرُو بْنُ دِينَارٍ : "" مَا أَرَى عَلَيْهِ مِنْ قَطْعٍ ""","","","","","The Book of the People of the Two Books"
"18200","عَنِ ابْنِ جُرَيْجٍ , عَنْ سُلَيْمَانَ بْنِ مُوسَى , أَنَّ عُثْمَانَ :قَضَى أَنَّهُ لا قَطْعَ عَلَيْهِ , وَإِنْ كَانَ قَدْ جَمَعَ الْمَتَاعَ فَأَرَادَ أَنْ يَسْرِقَ , حَتَّى يُحَوِّلَهُ , وَيَخْرُجَ بِهِ ""","","","","","The Book of the People of the Two Books"
"18201","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ شُعَيْبٍ ، أَنَّ سَارِقًا نَقَبَ خِزَانَةَ الْمُطَّلِبِ بْنِ أَبِي وَدَاعَةَ ، فَوُجِدَ فِيهَا قَدْ جَمَعَ الْمَتَاعَ , وَلَمْ يَخْرُجْ بِهِ ، فَأُتِيَ بِهِ ابْنُ الزُّبَيْرِ فَجَلَدَهُ , وَأَمَرَ بِهِ أَنْ يُقْطَعَ , فَمَرَّ ابْنُ عُمَرَ فَسَأَلَ , فَأُخْبِرَ , فَأَتَى ابْنَ الزُّبَيْرِ ، فَقَالَ : أَمَرْتَ بِهِ أَنْ يُقْطَعَ ؟ ، قَالَ : نَعَمْ , قَالَ : "" فَمَا شَأْنُ الْجَلْدِ ؟ ، قَالَ : قَالَ ابْنُ الزُّبَيْرِ : غَضِبْتُ ، قَالَ ابْنُ عُمَرَ : "" وَلَيْسَ عَلَيْهِ قَطْعٌ حَتَّى يَخْرُجَ بِهِ مِنَ الْبَيْتِ , أَرَأَيْتَ لَوْ رَأَيْتَ رَجُلا بَيْنَ رِجْلَيِ امْرَأَةٍ , لَمْ يُصِبْهَا أَكُنْتَ حَادَّهُ ؟ "" قَالَ : لا , قَالَ : لَعَلَّهُ سَوْفَ يَتُوبُ قَبْلَ أَنْ يُوَاقِعَهَا ، قَالَ : "" وَهَذَا كَذَلِكَ ، مَا يُدْرِيكَ لَعَلَّهُ قَدْ كَانَ نَازِعًا , وَتَائِبًا , وَتَارِكًا لِلْمَتَاعِ ""","","","","","The Book of the People of the Two Books"
"18202","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ إِذَا وُجِدَ السَّارِقُ فِي الْبَيْتِ قَدْ جَمَعَ الْمَتَاعَ فِي الْبَيْتِ فَلَمْ يَخْرُجْ بِهِ , فَلا قَطْعَ عَلَيْهِ , وَلَكِنْ يُنَكَّلُ ""","","","","","The Book of the People of the Two Books"
"18203","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ بَعْضِ الأُمَرَاءِ ، قَالَ : لا يُقْطَعُ ، هُوَ رَجُلٌ أَرَادَ أَنْ يَسْرِقَ فَلَمْ يَدْعُوهُ ""","","","","","The Book of the People of the Two Books"
"18204","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : إِذَا جَمَعَ الْمَتَاعَ فَخَرَجَ بِهِ مِنَ الْبَيْتِ إِلَى الدَّارِ , فَعَلَيْهِ الْقَطْعُ ""","","","","","The Book of the People of the Two Books"
"18205","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي السَّفَرِ , عَنِ الشَّعْبِيِّ , قَالَ : لا يُقْطَعُ السَّارِقُ حَتَّى يَخْرُجَ بِالْمَتَاعِ مِنَ الْبَيْتِ , وَتَفْسِيرُهُ عِنْدَنَا مَا دَامَ فِي مِلْكِ الرَّجُلِ , فَلا قَطْعَ عَلَيْهِ ""، عَنِ الثَّوْرِيِّ , عَنْ يُونُسَ , عَنِ الْحَسَنِ , مِثْلَ قَوْلِ الشَّعْبِيِّ""","","","","","The Book of the People of the Two Books"
"18206","عَنِ الثَّوْرِيِّ , عَنِ إِبْرَاهِيمَ , عَنْ حُسَيْنِ ابْنِ عَبْدِ اللَّهِ بْنِ ضُمَيْرَةَ , عَنْ أَبِيهِ , عَنْ جَدِّهِ , عَنْ عَلِيٍّ ، قَالَ : لا تُقْطَعُ يَدُ السَّارِقِ حَتَّى يُخْرِجَ الْمَتَاعَ مِنَ الْبَيْتِ ""","","","","","The Book of the People of the Two Books"
"18207","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , قَالَ : وَجَدَ ابْنُ عُمَرَ لِصًّا فِي دَارِهِ ، فَخَرَجَ عَلَيْهِ بِالسَّيْفِ صَلْتًا , فَجَعَلَ يَتَقَلَّبُ وَهُوَ يَحْبِسُ عَنْهُ , قَالَ : فَلَوْلا أَنَّا نَهْنَهْنَاهُ لَضَرَبَهُ بِهِ ""","","","","","The Book of the People of the Two Books"
"18208","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو بَكْرِ بْنُ عَبْدِ اللَّهِ , قَالَ عَبْدُ الرَّزَّاقِ : وَسَأَلْتُ عَنْهُ أَبَا بَكْرٍ فَأَخْبَرَنِي بِهِ ، أَنَّ خَالِدَ بْنَ سَعِيدٍ حَدَّثَهُ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، وَعُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، أَنَّهُمَا سُئِلا عَنِ : السَّارِقُ يَسْرِقُ , فَيَطْرَحُ السَّرِقَةَ , وَيُوجَدُ فِي الْبَيْتِ الَّذِي يَسْرِقُ مِنْهُ , لَمْ يَخْرُجْ ؟ ، فَقَالا : عَلَيْهِ الْقَطْعُ ""","","","","","The Book of the People of the Two Books"
"18209","عَنْ مَعْمَرٍ , عَنْ خُصَيْفٍ الْجَزَرِيِّ , قَالَ : فَقَدَ قَوْمٌ مَتَاعًا لَهُمْ مِنْ بَيْتِهِمْ , فَرَأَوْا نَقْبًا فِي الْبَيْتِ , فَخَرَجُوا يَنْظُرُونَ فَإِذَا هُمْ بِرَجُلَيْنِ يَسْعَيَانِ , فَأَدْرَكُوا أَحَدَهُمَا مَعَهُ مَتَاعُهُمْ , وَأَفْلَتَهُمُ الآخَرُ , قَالَ : فَأَتَيْنَا بِهِ , فَقَالَ : لَمْ أَسْرِقْ وَإِنَّمَا اسْتَأْجَرَنِي هَذَا ، يَعْنِي الَّذِي أَفْلَتَهُمْ ، وَدَفَعَ إِلَيَّ هَذَا الْمَتَاعَ لأَحْمِلَهُ ، لا أَدْرِي مِنْ أَيْنَ جَاءَ بِهِ , قَالَ خُصَيْفٌ : فَكَتَبْنَا فِيهِ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ : فَأَمَرَنَا أَنْ نُنَكِّلَهُ , وَنُخَلِّدَهُ السِّجْنَ , وَلا نَقْطَعَهُ ""","","","","","The Book of the People of the Two Books"
"18210","عَنِ الْحَجَّاجِ , عَنْ حُصَيْنٍ , عَنِ الشَّعْبِيِّ , عَنِ الْحَارِثِ , قَالَ : أُتِيَ عَلِيٌّ بِرَجُلٍ نَقَبَ بَيْتًا فَلَمْ يَقْطَعْهُ , وَعَزَّرَهُ أَسْوَاطًا ""","","","","","The Book of the People of the Two Books"
"18211","عَنْ أَبِي بَكْرِ بْنِ عَيَّاشٍ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ :  أَنَّهُأُتِيَ بِرَجُلٍ نَقَبَ بَيْتًا , فَلَمْ يَقْطَعْهُ ""","","","","","The Book of the People of the Two Books"
"18212","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ :  فِيالرَّجُلِ يُوجَدُ مَعَهُ الْمَتَاعُ , فَيَعْرِفُهُ أَهْلُهُ , فَيَقُولُ : ابْتَعْتُهُ ، قَالَ : لا قَطْعَ عَلَيْهِ ، وَلَكِنَّهُ إِنْ كَانَ مُتَّهَمًا بُحِثَ عَنْ أَمْرِهِ , فَإِنْ ظُهِرَ عَلَيْهِ قُطِعَ , وَيُرَدُّ الْمَتَاعُ إِلَى أَهْلِهِ ""، وَكَذَلِكَ قَالَ قَتَادَةُ إِلا قَوْلَهُ : بُحِثَ عَنْ أَمْرِهِ""","","","","","The Book of the People of the Two Books"
"18213","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ شُرَيْحٍ , قَالَ : سَمِعْتُهُ يَقُولُ : أَتَشْهَدُونَ أَنَّهُ مَتَاعُهُ ؟ لا تَعْلَمُونَهُ بَاعَ , وَلا وَهَبَ , ثُمَّ يَأْخُذُ يَمِينَهُ بِاللَّهِ , مَا بِعْتُ , وَلا وَهَبْتُ , وَلا أَهْلَكْتُ , وَلا أَدَّيْتُ لِيَهْلِكَ ، ثُمَّ يُرَدُّ إِلَيْهِ مَتَاعُهُ , إِلا أَنْ يَجِيءَ الآخَرُ بِأَمْرٍ يُثْبِتُ يَسْتَحِقُّ بِهِ ""","","","","","The Book of the People of the Two Books"
"18214","عَنْ إِسْرَائِيلَ , عَنْ سِمَاكِ بْنِ حَرْبٍ , عَنْ حَجَّاجِ بْنِ أَبْجَرَ , قَالَ : شَهِدْتُ عَلِيًّا وَأُتِيَ بِرَجُلٍ سُرِقَ مِنْهُ ثَوْبٌ , فَوَجَدَهُ مَعَ السَّارِقِ , فَأَقَامَ عَلَيْهِ الْبَيِّنَةَ , فَقَالَ عَلِيٌّ : ادْفَعْ إِلَى هَذَا ثَوْبَهُ , وَاتَّبِعْ أَنْتَ مَنِ اشْتَرَيْتَ مِنْهُ ""، وَأَخْبَرَنِي جَابِرٌ , عَنْ عَامِرٍ , عَنْ عَلِيٍّ أَنَّهُ قَضَى بِمِثْلِ ذَلِكَ""","","","","","The Book of the People of the Two Books"
"18215","عَنِ الثَّوْرِيِّ ، عَنْ رَجُلٍ اشْتَرَى عَبْدًا , فَسَافَرَ بِهِ , فَعَرَفَ مَعَهُ الْعَبْدَ مَسْرُوقًا , قَالَ : أَقْضِي عَلَيْهِ , وَأُحِيلُهُ عَلَى الَّذِي اشْتَرَى مِنْهُ ""","","","","","The Book of the People of the Two Books"
"18216","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : اسْتَعَارَ رَجُلٌ مَتَاعًا ثُمَّ بَاعَهُ ، فَوَجَدَ الرَّجُلُ مَتَاعَهُ عِنْدَ الَّذِي اشْتَرَاهُ ، فَخَاصَمْ فِيهِ أَنَسَ بْنَ سِيرِينَ إِلَى قَاضٍ كَانَ بِالْبَصْرَةِ يُقَالُ لَهُ : عَمِيرَةُ بْنُ يَثْرِبِيٍّ ، فَقَالَ لأَنَسٍ : اطْلُبْ صَاحِبَكَ الَّذِي أَعَرْتَهُ ""","","","","","The Book of the People of the Two Books"
"18217","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : سَرَقَ رَجُلٌ مَالِي , فَوَجَدْتُهُ قَدْ بَاعَهُ , قَالَ : فَخُذْهُ حَيْثُ وَجَدْتَهُ "" قُلْتُ : وَائْتَمَنْتُهُ عَلَيْهِ ، فَخَانَهُ فَبَاعَهُ , قَالَ : "" خُذْهُ حَيْثُ وَجَدْتَهُ ، سُبْحَانَ اللَّهِ مَا هُوَ إِلا ذَلِكَ "" قُلْتُ : فَاسْتَعَارَنِيهِ فَبَاعَهُ , قَالَ : "" وَكَذَلِكَ فَخُذْهُ ، قَالَ : قُلْتُ : فَسَرَقَ رَجُلٌ عَبْدًا لِي ، فَمَهَرَهُ امْرَأَةً وَأَصَابَهَا ، قَالَ : "" سَمِعْنَا أَنَّهُ يُقَالُ : خُذْ مَالَكَ حَيْثُ وَجَدْتَهُ ، فَخُذْ عَبْدَكَ مِنْهَا ""","","","","","The Book of the People of the Two Books"
"18218","قَالَ : وَلَقَدْ أَخْبَرَنِي عِكْرِمَةُ بْنُ خَالِدٍ , أَنَّ أُسَيْدَ بْنَ ظُهَيْرٍ الأَنْصَارِيَّ , أَخْبَرَهُ أَنَّهُ كَانَ عَامِلا عَلَى الْيَمَامَةِ ، وَأَنَّ مَرْوَانَ كَتَبَ إِلَيْهِ ، أَنَّ مُعَاوِيَةَ كَتَبَ إِلَيَّ : أَيُّمَا رَجُلٍ سُرِقَ مِنْهُ سَرِقَةً , فَهُوَ أَحَقُّ بِهَا حَيْثُ وَجَدَهَا , قَالَ : وَكَتَبَ بِذَلِكَ مَرْوَانُ إِلَيَّ ، فَكَتَبْتُ إِلَى مَرْوَانَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَضَى بِأَنَّهُ إِذَا كَانَ الَّذِي ابْتَاعَهَا مِنَ الَّذِي سَرَقَهَا غَيْرَ مُتَّهَمٍ , يُخَيِّرُ سَيِّدَهَا ، فَإِنْ شَاءَ أَخَذَ الَّذِي سُرِقَ مِنْهُ بِثَمَنِهِ , وَإِنْ شَاءَ اتَّبَعَ سَارِقَهُ "" ، ثُمَّ قَضَى بِذَلِكَ بَعْدُ أَبُو بَكْرٍ ، وَعُمَرُ وَعُثْمَانُ ، قَالَ : فَبَعَثَ مَرْوَانُ بِكِتَابِي إِلَى مُعَاوِيَةَ ، قَالَ : فَكَتَبَ مُعَاوِيَةُ إِلَى مَرْوَانَ : إِنَّكَ لَسْتَ أَنْتَ وَلا أُسَيْدُ بْنُ ظُهَيْرٍ بِقَاضِيَيْنِ عَلَيَّ ، وَلَكِنِّي أَقْضِي فِيمَا وُلِّيتُ عَلَيْكُمَا , فَأَنْفِذْ لِمَا أَمَرْتُكَ بِهِ , فَبَعَثَ مَرْوَانُ إِلَيَّ بِكِتَابِ مُعَاوِيَةَ ، فَقُلْتُ : لا أَقْضِي بِهِ مَا وُلِّيتُ ، يَعْنِي بِقَوْلِ مُعَاوِيَةَ""","","","","","The Book of the People of the Two Books"
"18219","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ عُرْوَةَ , عَنْ عَائِشَةَ , قَالَتْ : كَانَتِ امْرَأَةٌ مَخْزُومِيَّةٌ تَسْتَعِيرُ الْمَتَاعَ , وَتَجْحَدُهُ , فَأَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِقَطْعِ يَدِهَا , فَأَتَى أَهْلُهَا أُسَامَةَ بْنَ زَيْدٍ فَكَلَّمُوهُ , فَكَلَّمَ أُسَامَةُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهَا , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  يَا أُسَامَةُ ،لا تَزَالُ تَكَلَّمُ فِي حَدٍّ مِنْ حُدُودِ اللَّهِ "" , ثُمَّ قَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَطِيبًا , فَقَالَ : "" إِنَّمَا هَلَكَ مَنْ كَانَ قَبْلَكُمْ , بِأَنَّهُ إِذَا سَرَقَ فِيهِمُ الشَّرِيفُ تَرَكُوهُ , وَإِذَا سَرَقَ فِيهِمُ الضَّعِيفُ قَطَعُوهُ , وَالَّذِي نَفْسِي بِيَدِهِ , لَوْ كَانَتْ فَاطِمَةُ ابْنَةُ مُحَمَّدٍ لَقَطَعَ يَدَهَا ""","","","","","The Book of the People of the Two Books"
"18220","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , قَالَ : أَخْبَرَنِي حَسَنُ بْنُ مُحَمَّدِ بْنِ عَلِيٍّ , قَالَ : سَرَقَتِ امْرَأَةٌ ، قَالَ عَمْرٌو : حَسِبْتُ أَنَّهُ قَالَ : مِنْ بَنَاتِ الْكَعْبَةِ , فَأُتِيَ بِهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَجَاءَ عُمَرُ بْنُ أَبِي سَلَمَةَ , فَقَالَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنَّهَا عَمَّتِي , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لَوْ كَانَتْ فَاطِمَةُ بِنْتُ مُحَمَّدٍ لَقَطَعْتُ يَدَهَا ""قَالَ عَمْرٌو : فَلَمْ أُشِكِّكْ حِينَ قَالَ حَسَنٌ : قَالَ عُمَرُ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنَّهَا عَمَّتِي , إِنَّهَا بِنْتُ الأَسْوَدِ بْنِ عَبْدِ الأَسَدِ , ابْنَةُ أَخِي سُفْيَانَ بْنِ عَبْدِ الأَسَدِ , قَالَ عَمْرُو بْنُ دِينَارٍ : وَأَخْبَرَنِي عِكْرِمَةُ بْنُ خَالِدٍ , عَنْ أَبِي بَكْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ , قَالَ : اسْتَعَارَتْ بِنْتُ الأَسْوَدِ بْنِ عَبْدِ الأَسَدِ شَيْئًا كَاذِبَةً فَكَتَمَتْهُ , فَقَطَعَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : حَسِبْتُ مِنْ فَاطِمَةَ""","","","","","The Book of the People of the Two Books"
"18221","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ، أَظُنُّ عِكْرِمَةُ بْنُ خَالِدٍ ، أَنَّ أَبَا بَكْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ أَخْبَرَهُ , أَنَّ امْرَأَةً جَاءَتِ امْرَأَةٌ ، فَقَالَتْ : إِنَّ فُلانَةَ تَسْتَعِيرُكِ حُلِيًّا وَهِي كَاذِبَةٌ , فَأَعَارَتْهَا إِيَّاهُ , فَمَكَثَتْ أَيَّامًا لا تَرَى حُلِيَّهَا , فَجَاءَتِ الَّتِي كَذَبَتْ عَنْ فِيهَا , فَسَأَلَتْهَا حُلِيَّهَا , فَقَالَتْ : مَا اسْتَعَرْتُكِ مِنْ شَيْءٍ ، فَرَجَعَتْ إِلَى الأُخْرَى فَسَأَلَتْهَا حُلِيَّهَا ، فَأَنْكَرَتْ أَنْ تَكُونَ اسْتَعَارَتْ مِنْهَا شَيْئًا , فَجَاءَتِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَدَعَاهَا , فَقَالَتْ : وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا اسْتَعَرْتُ مِنْهَا شَيْئًا , فَقَالَ : اذْهَبُوا فَخُذُوهُ مِنْ تَحْتِ فِرَاشِهَا "" فَقُطِعَتْ , فَكَرِهَ النَّاسُ أَنْ يُؤْوُهَا , فَقَالَ : "" قَدْ قَضَيْنَا مَا عَلَيْهَا , فَمَنْ شَاءَ فَلْيُؤْوِهَا ""، قَالَ ابْنُ جُرَيْجٍ : وَأَخْبَرَنِي بِشْرُ بْنُ تَيْمٍ : أَنَّهَا أُمُّ عَمْرٍو ابْنَةُ سُفْيَانَ بْنِ عَبْدِ الأَسَدِ , قَالَ : لا أَجِدُ غَيْرَهَا ، يَقُولُ : لا أَعْرِفُ هَذَا النَّسَبَ إِلا فِيهَا""","","","","","The Book of the People of the Two Books"
"18222","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ , أَنَّهُ سَمِعَ سَعِيدَ بْنَ الْمُسَيِّبِ , يَقُولُ : أُتِيَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِامْرَأَةٍ فِي بَيْتٍ عَظِيمٍ مِنْ بُيُوتِ قُرَيْشٍ , قَدْ أَتَتْ نَاسًا فَقَالَتْ :  إِنَّ آلَ فُلانٍيَسْتَعِيرُونَكُمْ كَذَا وَكَذَا , فَأَعَارُوهَا , ثُمَّ أَتَوْا أُولَئِكَ فَأَنْكَرُوا أَنْ يَكُونُوا اسْتَعَارُوهُمْ , وَأَنْكَرَتْ هِيَ أَنْ تَكُونَ اسْتَعَارَتْهُمْ , فَقَطَعَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""","","","","","The Book of the People of the Two Books"
"18223","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ الْمُنْكَدِرِ ، قَالَ : آوَتْهَا امْرَأَةُ أُسَيْدِ بْنِ حُضَيْرٍ ، فَجَاءَ أُسَيْدٌ فَإِذَا هِيَ قَدْ ذَكَرَتْهَا ، فَلامَهَا , وَقَالَ :لا أَضَعُ ثَوْبِي حَتَّى آتِيَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَهُ ، فَذَكَرَ ذَلِكَ لَهُ ، فَقَالَ : رَحِمَتْهَا رَحِمَهَا اللَّهُ","","","","","The Book of the People of the Two Books"
"18224","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , قَالَ : قَطَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَدَ رَجُلٍ ، فَمَرَّ بِهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَقَدْ بَنَى لَهُ رَجُلٌ خَيْمَةً يَسْتَظِلُّ بِهَا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  مَنْ آوَى هَذَا الْمُصَابَ ؟ "" قَالُوا : آوَاهُ عَاتِكٌ أَوِ ابْنُ عَاتِكٍ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :"" اللَّهُمَّ بَارِكْ عَلَى عَاتِكٍ , وَآلِ عَاتِكٍ , كَمَا آوَوْا عَبْدَكَ هَذَا الْمُصَابَ ""","","","","","The Book of the People of the Two Books"
"18225","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  إِنِاسْتَعَارَ إِنْسَانٌ إِنْسَانًا مَتَاعًا كَاذِبًا عَنْ فِي إِنْسَانٍ فَكَتَمَهُ , قَالَ : لا يُقْطَعُ ، زَعَمُوا ""","","","","","The Book of the People of the Two Books"
"18226","عَنْ مَعْمَرٍ , عَنْ بَعْضِ أَصْحَابِهِ , عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ  فِيجَارِيَةٍ اسْتَعَارَتْ حُلِيًّا عَلَى أَلْسِنَةِ مَوَالِيهَا , ثُمَّ أَبِقَتْ , فَقَالَ مَوَالِيهَا : مَا أَمَرْنَاهَا بِشَيْءٍ , قَالَ : إِذَا لَمْ يُقْدَرْ عَلَى الَّذِي أَخَذَتِ الْجَارِيَةُ , فَالْحُلِيُّ فِي عُنُقِ الْجَارِيَةِ ""","","","","","The Book of the People of the Two Books"
"18227","عَنِ الثَّوْرِيِّ :  فِي الَّذِييَسْتَعِيرُ الْمَتَاعَ , ثُمَّ يَجْحَدُهُ عِنْدَ قَاضٍ , ثُمَّ قَامَتِ الْبَيِّنَةُ , أُخِذَ بِهِ , وَإِذَا جَحَدَهُ عِنْدَ النَّاسِ فَلَيْسَ بِشَيْءٍ , وَالَّذِي يَسْتَعِيرُ عَلَى فَمِ إِنْسَانٍ , لَيْسَ عَلَيْهِ فِيهِ قَطْعٌ ""","","","","","The Book of the People of the Two Books"
"18228","عَنِ الثَّوْرِيِّ :  فِيجَارِيَةٍ تَسْتَعِيرُ عَلَى أَلْسِنَةِ مَوَالِيهَا , قَالَ : لَيْسَ عَلَى الْجَارِيَةِ شَيْءٌ , وَلا عَلَى مَوَالِيهَا , لأَنَّ الَّذِينَ أَعْطُوهَا ضَيَّعُوهَا ""","","","","","The Book of the People of the Two Books"
"18229","عَنْ هِشَامٍ , عَنْ مُحَمَّدِ بْنِ سِيرِينَ , قَالَ : أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِجَزُورٍ فَنُحِرَتْ ، فَأَنْهَبَ النَّاسُ لَحْمَهَا , فَبَعَثَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُنَادِيًا يَقُولُ :  إِنَّاللَّهَ وَرَسُولَهُ يَنْهَاكُمْ عَنِ النُّهْبَةِ , فَرَدُّوهُ ، فَقَسَمَهُ بَيْنَهُمْ ""","","","","","The Book of the People of the Two Books"
"18230","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ , قَالَ : أَخْبَرَنَا سِمَاكُ بْنُ حَرْبٍ , عَنْ ثَعْلَبَةَ بْنِ الْحَكَمِ , قَالَ : أَصَبْنَا يَوْمَ خَيْبَرَ غَنَمًا ، فَانْتَهَبَهَا النَّاسُ ، فَجَاءَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَقُدُورُهُمْ تَغْلِي , فَقَالَ : مَا هَذَا ؟ فَقَالُوا : نُهْبَةٌ يَا رَسُولَ اللَّهِ ! قَالَ : أَكْفِئُوهَا ، فَإِنَّ النُّهْبَةَ لا تَحِلُّ , فَكَفَئُوا مَا بَقِيَ فِيهَا ""","","","","","The Book of the People of the Two Books"
"18231","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ : أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِجَزُورٍ فَنُحِرَتْ , فَانْتَهَبَ النَّاسُ لَحْمَهَا , فَأَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُنَادِيًا فَنَادَى : إِنَّ اللَّهَ وَرَسُولَهُ يَنْهَاكُمْ عَنِ النُّهْبَةِ ""","","","","","The Book of the People of the Two Books"
"18232","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَمْرَو بْنَ شُعَيْبٍ , يَقُولُ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنِ انْتَهَبَ نُهْبَةً ذَاتَ شَرَفٍ , أَوْ آوَى مُحْدِثًا فِي الإِسْلامِ , أَوْ تَوَلَّى مَوْلَى قَوْمٍ بِغَيْرِ إِذْنِهِمْ , فَعَلَيْهِ لَعْنَةُ اللَّهِ , لا صَرْفَ عَنْهَا ، وَلا عَدْلَ ""","","","","","The Book of the People of the Two Books"
"18233","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي أَبُو الزُّبَيْرِ , قَالَ : قَالَ جَابِرُ بْنُ عَبْدِ اللَّهِ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لَيْسَ عَلَى الْمُنْتَهِبِ قَطْعٌ , وَمَنِ انْتَهَبَ نُهْبَةً مَشْهُورَةً فَلَيْسَ مِنَّا , لَيْسَ مِثْلَنَا ""، قَالَهُ ابْنُ جُرَيْجٍ , عَنْ يَاسِينَ , أَنَّهُ سَمِعَ أَبَا الزُّبَيْرِ ، يُحَدِّثُ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18234","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْكَرِيمِ أَبُو أُمَيَّةَ , عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ أَحْدَثَ فِيهَا حَدَثًا , أَوْ آوَى مُحْدِثًا , أَوْ تَوَلَّى مَوْلَى قَوْمٍ بِغَيْرِ إِذْنِهِمْ , فَعَلَيْهِ لَعْنَةُ اللَّهِ , لا صَرْفَ عَنْهَا وَلا عَدْلَ "" ، قَالَ : وَقَالَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ : وَمَا الْحَدَثُ يَا رَسُولَ اللَّهِ ؟ ، قَالَ : "" مَنِ انْتَهَبَ نُهْبَةً يَرْفَعُ لَهَا النَّاسُ إِلَيْهِ أَبْصَارَهُمْ , أَوْ مَثَّلَ بِغَيْرِ حَدٍّ , أَوْ سَنَّ سُنَّةً لَمْ تَكُنْ "" قُلْتُ لِعَبْدِ الْكَرِيمِ : قَوْلُهُ مَنْ أَحْدَثَ فِيهَا ؟ قَالَ : مَكَّةَ الْحَرَامَ ، وَزَادَ آخَرُونَ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" أَوْ قَتَلَ بِغَيْرِ حَقٍّ ""","","","","","The Book of the People of the Two Books"
"18235","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنَا جَعْفَرُ بْنُ مُحَمَّدٍ , عَنْ أَبِيهِ , عَنْ جَدِّهِ ، أَنَّهُ وُجِدَ مَعَ سَيْفِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَحِيفَةٌ مُعَلَّقَةٌ بِقَائِمِ السَّيْفِ فِيهَا :  إِنَّأَعْتَى النَّاسِ عَلَى اللَّهِ الْقَاتِلُ غَيْرَ قَاتِلِهِ , وَالضَّارِبُ غَيْرَ ضَارِبِهِ , وَمَنْ آوَى مُحْدِثًا لَمْ يُقْبَلْ مِنْهُ يَوْمَ الْقِيَامَةِ صَرْفٌ وَلا عَدْلٌ , وَمَنْ تَوَلَّى غَيْرَ مَوْلاهُ , فَقَدْ كَفَرَ بِمَا أُنْزِلَ عَلَى مُحَمَّدٍ "" قُلْتُ لِجَعْفَرٍ : مَنْ آوَى مُحْدِثًا الَّذِي يَقْتُلُ ؟ قَالَ : "" نَعَمْ ""","","","","","The Book of the People of the Two Books"
"18236","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : مَنْ أَحْدَثَ حَدَثًا , أَوْ آوَى مُحْدِثًا ، فَعَلَيْهِ لَعْنَةُ اللَّهِ وَالْمَلائِكَةِ وَالنَّاسِ أَجْمَعِينَ ""، قَالَ مَعْمَرٌ : وَقَالَ جَعْفَرُ بْنُ مُحَمَّدٍ : قِيلَ : يَا رَسُولَ اللَّهِ ! مَا الْمُحْدِثُ ؟ قَالَ : "" مَنْ جَلَدَ بِغَيْرِ حَدٍّ ، أَوْ قَتَلَ بِغَيْرِ حَقٍّ ""","","","","","The Book of the People of the Two Books"
"18237","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ :  إِنِاخْتَلَسَ إِنْسَانٌ مَتَاعَ إِنْسَانٍ ؟ ، قَالَ : لا يُقْطَعُ ""، وَقَالَهَا لِي عَمْرُو بْنُ دِينَارٍ""","","","","","The Book of the People of the Two Books"
"18238","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : اخْتَلَسَ رَجُلٌ مَتَاعًا , فَأَرَادَ مَرْوَانُ أَنْ يَقْطَعَ يَدَهُ ، فَقَالَ لَهُ زَيْدُ بْنُ ثَابِتٍ تِلْكَ الْخُلْسَةُ الظَّاهِرَةُ لا قَطْعَ فِيهَا , وَلَكِنْ نَكَالٌ وَعُقُوبَةُ ""","","","","","The Book of the People of the Two Books"
"18239","عَنِ الثَّوْرِيِّ , عَنْ سِمَاكِ بْنِ حَرْبٍ , عَنِ ابْنِ عُبَيْدِ بْنِ الأَبْرَصِ وَهُوَ زَيْدُ بْنُ دِثَارٍ , قَالَ : اخْتَلَسَ رَجُلٌ ثَوْبًا فَأُتِيَ بِهِ عَلِيٌّ , فَقَالَ : إِنَّمَا كُنْتُ أَلْعَبُ مَعَهُ ، فَقَالَ : كُنْتَ تَعْرِفُهُ ؟ "" قَالَ : نَعَمْ , فَخَلَّى سَبِيلَهُ ""","","","","","The Book of the People of the Two Books"
"18240","عَنِ الثَّوْرِيِّ , عَنْ إِسْمَاعِيلَ بْنِ مُسْلِمٍ , عَنِ الْحَسَنِ , عَنْ عَلِيٍّ , قَالَ :  سُئِلَ عَنِ الْخُلْسَةِ , فَقَالَ :تِلْكَ الدَّعَرَةُ الْمُعْلَنَةُ لا قَطْعَ فِيهَا ""","","","","","The Book of the People of the Two Books"
"18241","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ لا قَطْعَ فِيهَا إِنَّمَا الْقَطْعُ فِيمَا . . . . . ""","","","","","The Book of the People of the Two Books"
"18242","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , قَالَ : كَتَبَ إِيَاسُ بْنُ مُعَاوِيَةَ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِي ثَلاثِ قَضِيَّاتٍ ، مِنْهَا الْمُخْتَلِسُ ، قَالَ : فَأَقْرَأَنِي إِيَاسٌ الْكِتَابَ حِينَ جَاءَهُ , فَإِذَا فِيهِ أَنْ : يُعَاقَبَ الْمُخْتَلِسُ , وَيُخَلَّدَ الْحَبْسَ ، السِّجْنَ ""","","","","","The Book of the People of the Two Books"
"18243","عَنْ مَعْمَرٍ , عَنْ سِمَاكِ بْنِ الْفَضْلِ , قَالَ : كَتَبَ ابْنُ عَبْدِ الْعَزِيزِ إِلَى عُرْوَةَ بِالْيَمَنِ : الَّذِي يُؤْخَذُ عَلانِيَةً اخْتِلاسًا لا يُقْطَعُ فِيهِ , إِنَّمَا يُقْطَعُ فِيمَا يُؤْخَذُ مِنْ وَرَاءِ غَلْقٍ خُفْيَةً , لَيْسَ فِيهِ مُخَالَسَةٌ , وَلا مُجَاهَرَةٌ ""","","","","","The Book of the People of the Two Books"
"18244","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : لا قَطْعَ عَلَى الْمُخْتَلِسِ ، وَلَكِنْ يُسْجَنُ وَيُعَاقَبُ ""","","","","","The Book of the People of the Two Books"
"18245","عَنْ هُشَيْمِ بْنِ بَشِيرٍ , عَنْ عَبْدِ اللَّهِ بْنِ سَبْرَةَ الْهَمْدَانِيِّ , عَنِ الشَّعْبِيِّ , قَالَ : لَيْسَ عَلَى الْمُخْتَلِسِ قَطْعٌ ""","","","","","The Book of the People of the Two Books"
"18246","عَنِ ابْنِ جُرَيْجٍ , عَنْ أَبِي الزُّبَيْرِ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لَيْسَ عَلَى الْمُخْتَلِسِ قَطْعٌ ""","","","","","The Book of the People of the Two Books"
"18247","عَنْ يَاسِينَ , أَنَّ أَبَا الزُّبَيْرِ , أَخْبَرَهُ , عَنْ جَابِرٍ , قَالَ : لَيْسَ عَلَى الْخَائِنِ , وَلا عَلَى الْمُنْتَهِبِ , وَلا عَلَى الْمُخْتَلِسِ قَطْعٌ ، قُلْتُ : أَعَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ ، قَالَ : فَعَنْ مَنْ ؟ ""","","","","","The Book of the People of the Two Books"
"18248","عَنِ ابْنِ جُرَيْجٍ , عَنْ أَبِي الزُّبَيْرِ , عَنْ جَابِرٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لَيْسَ عَلَى الْخَائِنِ قَطْعٌ ""","","","","","The Book of the People of the Two Books"
"18249","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْخِيَانَةُ ؟ قَالَ : لا قَطْعَ فِيهَا وَلا حَدَّ يُعْلَمُ ""، قَالَ ابْنُ جُرَيْجٍ : وَقَالَ لِي عَمْرُو بْنُ دِينَارٍ : مَا بَلَغَنِي فِيهَا مِنْ شَيْءٍ""","","","","","The Book of the People of the Two Books"
"18250","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ بْنُ مُسْلِمٍ , أَنَّ أَبَا بَكْرٍ الصِّدِّيقَ , قَالَ :  فِيالْخِيَانَةِ لا قَطْعَ فِيهَا ""","","","","","The Book of the People of the Two Books"
"18251","عَنْ مَعْمَرٍ , قَالَ :  بَلَغَنِي أَنَّفِي الْخِيَانَةِ نَكَالا ""","","","","","The Book of the People of the Two Books"
"18252","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ لَيْسَ عَلَى الْخَائِنِ قَطْعٌ ""","","","","","The Book of the People of the Two Books"
"18253","قَالَ : وَسُئِلَ الزُّهْرِيُّ :  عَنْرَجُلٍ ضَافَ قَوْمًا فَاخْتَانَهُمْ ، فَلَمْ يَرَ عَلَيْهِ قَطْعًا ""","","","","","The Book of the People of the Two Books"
"18254","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ السَّائِبِ بْنِ يَزِيدَ , قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ , وَجَاءَهُ عَبْدُ اللَّهِ بْنُ عَمْرٍو الْحَضْرَمِيُّ بِغُلامٍ لَهُ ، فَقَالَ لَهُ : إِنَّ غُلامِي هَذَا سَرَقَ فَاقْطَعْ يَدَهُ , فَقَالَ عُمَرُ : مَا سَرَقَ ؟ ، قَالَ : مِرْآةَ امْرَأَتِي ، قِيمَتُهَا سِتُّونَ دِرْهَمًا , قَالَ : أَرْسِلْهُ فَلا قَطْعَ عَلَيْهِ , خَادِمُكُمْ أَخَذَ مَتَاعَكُمْ , وَلَكِنَّهُ لَوْ سَرَقَ مِنْ غَيْرِكُمْ قُطِعَ ""","","","","","The Book of the People of the Two Books"
"18255","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , أَنَّ مَعْقِلَ بْنَ مُقَرِّنٍ , سَأَلَ ابْنَ مَسْعُودٍ , فَقَالَ : عَبْدٌ لِي سَرَقَ مِنْ عَبْدِي ؟ ، قَالَ : اقْطَعْهُ , ثُمَّ قَالَ : لا , مَالُكَ أَخَذَ مَالَكَ ، قَالَ : جَارِيَتِي زَنَتْ , قَالَ : اجْلِدْهَا خَمْسِينَ ""","","","","","The Book of the People of the Two Books"
"18256","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , أَنَّ ابْنَ مَسْعُودٍ سَأَلَهُ مَعْقِلُ بْنُ مُقَرِّنٍ , قَالَ : غُلامٌ لِي سَرَقَ مِنْ غُلامٍ لِي شَيْئًا ، أَعَلَيْهِ قَطْعٌ ؟ ، قَالَ : لا ، مَالُكَ بَعْضُهُ فِي بَعْضٍ ""","","","","","The Book of the People of the Two Books"
"18257","عَنْ مَعْمَرٍ , قَالَ : لا يُقْطَعُ الْعَبْدُ بِشَهَادَةِ سَيِّدِهِ وَحْدَهُ ""","","","","","The Book of the People of the Two Books"
"18258","عَنِ الثَّوْرِيِّ , قَالَ :  إِنْسَرَقَ الْمُكَاتَبُ مِنْ سَيِّدِهِ شَيْئًا , لَمْ يُقْطَعْ , وَإِنْ سَرَقَ السَّيِّدُ مِنَ الْمُكَاتَبِ شَيْئًا , لَمْ يُقْطَعْ ""","","","","","The Book of the People of the Two Books"
"18259","عَنِ الثَّوْرِيِّ , عَنْ سِمَاكِ بْنِ حَرْبٍ , عَنِ ابْنِ عُبَيْدِ بْنِ الأَبْرَصِ وَهُوَ زَيْدُ بْنُ دِثَارٍ , قَالَ : أُتِيَ عَلِيٌّ بِرَجُلٍ سَرَقَ مِنَ الْخُمُسِ ، فَقَالَ : لَهُ فِيهِ نَصِيبٌ ، هُوَ جَائِزٌ , فَلَمْ يَقْطَعْهُ ، سَرَقَ مِغْفَرًا ""","","","","","The Book of the People of the Two Books"
"18260","عَنْ مَعْمَرٍ , عَنْ مُغِيرَةَ , عَنِ الشَّعْبِيِّ , قَالَ : لا يُقْطَعُ مَنْ سَرَقَ مِنْ بَيْتِ الْمَالِ , لأَنَّ لَهُ فِيهِ نَصِيبًا ""","","","","","The Book of the People of the Two Books"
"18261","عَنْ عَبْدِ اللَّهِ بْنِ مُحَرَّرٍ , قَالَ : أَخْبَرَنِي مَيْمُونُ بْنُ مِهْرَانَ , قَالَ :  أُتِيَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِعَبْدٍ قَدْ سَرَقَ مِنَ الْخُمُسِ , فَقَالَ :مَالُ اللَّهِ سَرَقَ بَعْضُهُ بَعْضًا ، لَيْسَ عَلَيْهِ قَطْعٌ ""","","","","","The Book of the People of the Two Books"
"18262","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحْرِزِ بْنِ الْقَاسِمِ , عَنْ غَيْرِ وَاحِدٍ مِنَ الثِّقَةِ ، أَنَّ رَجُلا عَدَا عَلَى بَيْتِ مَالِ الْكُوفَةِ فَسَرَقَهُ ، فَأَجْمَعَ ابْنُ مَسْعُودٍ لِقَطْعِهِ ، فَكَتَبَ إِلَى عُمَرَ بْنِ الْخَطَّابِ ، فَكَتَبَ عُمَرُ : لا تَقْطَعْهُ ، فَإِنَّ لَهُ فِيهِ حَقًّا ""","","","","","The Book of the People of the Two Books"
"18263","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ ، قَالَ : سَمِعْتُهُ يَقُولُ فِي مَنْ سَرَقَ قُبُورَ الْمَوْتَى , قَالَ :  أَخَذَهُمْ مَرْوَانُ بِالْمَدِينَةِفَنَكَّلَهُمْ نَكَالا مُوجِعًا , وَطَوَّفَهُمْ , وَنَهَاهُمْ , وَلَمْ يَقْطَعْهُمْ ""","","","","","The Book of the People of the Two Books"
"18264","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : إِذَا وُجِدُوا بَعْدَ نَبْشِ الْقُبُورِ , وَأَخَذُوا ثِيَابَهَمْ قُطِعَتْ أَيْدِيهِمْ ""","","","","","The Book of the People of the Two Books"
"18265","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : مَا بَلَغَنِي فِي الْمُخْتَفِي شَيْءٌ ""","","","","","The Book of the People of the Two Books"
"18266","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ لِي عَمْرُو بْنُ دِينَارٍ , قَالَ : قَطَعَ عَبَّادُ بْنُ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ يَدَ غُلامٍ , وَرِجْلَهُ اخْتَفَى ""","","","","","The Book of the People of the Two Books"
"18267","قَالَ ابْنُ جُرَيْجٍ : وَبَلَغَنِي عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، أَنَّهُ قَالَ : سَوَاءٌ مَنْ سَرَقَ أَحْيَاءَنَا , وَأَمْوَاتَنَا ""","","","","","The Book of the People of the Two Books"
"18268","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قَالَ : إِذَا سَرَقَ النَّبَّاشُ مَا يُقْطَعُ فِي مِثْلِهِ قُطِعَ ""","","","","","The Book of the People of the Two Books"
"18269","عَنِ الثَّوْرِيِّ ، عَنْ عُمَرَ بْنِ أَيُّوبَ , قَالَ : سَمِعْتُ الشَّعْبِيَّ , يَقُولُ : نَقْطَعُ فِي أَمْوَاتِنَا كَمَا نَقْطَعُ فِي أَحْيَائِنَا ""، قَالَ سُفْيَانُ : "" وَالَّذِي أَحَبُّ إِلَيْنَا لا قَطْعَ عَلَيْهِمْ وَلَكِنْ نَكَالٌ ""","","","","","The Book of the People of the Two Books"
"18270","عَنِ الثَّوْرِيِّ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ , أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ :  كَانَ يَقُولُفِيهِ الْقَطْعُ ""، وَلا يَأْخُذُ بِهِ الثَّوْرِيُّ""","","","","","The Book of the People of the Two Books"
"18271","عَنْ مُحَمَّدِ بْنِ رَاشِدْ , قَالَ : أَخْبَرَنِي يَحْيَى الْغَسَّانِيُّ , قَالَ : كَتَبْتُ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ  فِيالنَّبَّاشِ ، فَكَتَبَ إِلَيَّ أَنَّهُ سَارِقٌ ""","","","","","The Book of the People of the Two Books"
"18272","عَنِ الثَّوْرِيِّ , قَالَ : لا نَرَى عَلَى النَّبَّاشِ قَطْعًا , وَإِنِ انْطَلَقَ بِهِ إِلَى بَيْتِهِ , لأَنَّهُ بِمَنْزِلَةِ دَرَاهِمَ مَدْفُونةٍ فِي الأَرْضِ , لا نَرَى عَلَيْهِ فِي اسْتِخْراجِهَا قَطْعًا , وَإِنْ أَخَذَ النَّبَّاشُ مِنَ الثِّيَابِ شَيْئًا , عُزِّرَ وَغُرِّمَ ""","","","","","The Book of the People of the Two Books"
"18273","عَنِ ابْنِ جُرَيْجٍ , عَنْ صَفْوَانَ بْنِ سُلَيْمٍ ,  أَنَّ رَجُلا مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَوَجَدَ رَجُلا يَخْتَفِي الْقُبُورَ ، فَقَتَلَهُ فَأَهْدَرَ عُمَرُ دَمَهُ ""","","","","","The Book of the People of the Two Books"
"18274","عَنْ إِبْرَاهِيمَ , عَنْ صَفْوَانَ بْنِ سُلَيْمٍ , قَالَ :مَاتَ رَجُلٌ بِالْمَدِينَةِ ، فَخَافَ أَخُوهُ أَنْ يُخْتَفَى قَبْرُهُ ، فَحَرَسَهُ , وَأَقْبَلَ الْمُخْتَفِي , فَسَكَتَ عَنْهُ , حَتَّى اسْتَخْرَجَ أَكْفَانَهُ , ثُمَّ أَتَاهُ فَضَرَبَهُ بِالسَّيْفِ حَتَّى بَرَدَ , فَرُفِعَ ذَلِكَ إِلَى عُمَرَ بْنِ الْخَطَّابِ فَأَهْدَرَ دَمَهُ ""","","","","","The Book of the People of the Two Books"
"18275","عَنْ إِبْرَاهِيمَ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ أَبِي بَكْرٍ , عَنْ عَبْدِ اللَّهِ بْنِ عَامِرِ بْنِ رَبِيعَةَ ، أَنَّهُ وَجَدَ قَوْمًا يَخْتَفُونَ الْقُبُورَ بِالْيَمَنِ عَلَى عَهْدِ عُمَرَ بْنِ الْخَطَّابِ ، فَكَتَبَ إِلَى عُمَرَ  فَكَتَبَ إِلَيْهِ عُمَرُ : أَنْيَقْطَعَ أَيْدِيَهُمْ ""","","","","","The Book of the People of the Two Books"
"18276","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ , عَنْ عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ , عَنْ عَائِشَةَ , أَنَّهَا قَالَتْ : لُعِنَ الْمُخْتَفِي وَالْمُخْتَفِيَةُ ""","","","","","The Book of the People of the Two Books"
"18277","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ , قَالَ :  أُتِيَ الشَّعْبِيُّ بِقَفَّافٍفَضَرَبَهُ أَسْوَاطًا , وَخَلَّى سَبِيلَهُ , قَالَ : وَالْقَفَّافُ الَّذِي يَزِنُ الدَّرَاهِمَ فَيَسْرِقُ مِنْهَا ""","","","","","The Book of the People of the Two Books"
"18278","عَنِ الثَّوْرِيِّ :  عَنْ أَصْحَابِهِمْ فِيالطَّرَّارِ عَلَيْهِ الْقَطْعُ لأَنَّهَا مَصْرُورَةٌ , وَهِيَ بِمَنْزِلَةِ الْبَيْتِ , وَالطَّرَّارُ : الَّذِي يَسْرِقُ الدَّرَاهِمَ الْمَصْرُورَةَ ""","","","","","The Book of the People of the Two Books"
"18279","عَنْ مَعْمَرٍ , عَنْ بَهْزِ بْنِ حَكِيمِ بْنِ مُعَاوِيَةَ , عَنْ أَبِيهِ , عَنْ جَدِّهِ , قَالَ : أَخَذَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَاسًا مِنْ قَوْمِي فِي تُهْمَةٍ ، فَحَبَسَهُمْ , فَجَاءَ رَجُلٌ مِنْ قَوْمِي النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ يَخْطُبُ ، فَقَالَ :  يَا مُحَمَّدُ !عَلَى مَا تَحْبِسُ جِيرَتِي ؟ فَصَمَتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْهُ ، فَقَالَ : إِنَّ النَّاسَ يَقُولُونَ إِنَّكَ لَتَنْهَى عَنِ الشَّرِّ ، وَتَسْتَخْلِي بِهِ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" مَا يَقُولُ ؟ "" فَجَعَلْتُ أَعْرِضُ بَيْنَهُمَا بِكَلامٍ مَخَافَةَ أَنْ يَسْمَعَهَا , فَيَدْعُو عَلَى قَوْمِي دَعْوَةً لا يُفْلِحُونَ بَعْدَهَا ، قَالَ : فَلَمْ يَزَلِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى فَهِمَهَا ، فَقَالَ : "" قَدْ قَالُوهَا ؟ "" ، وَقَالَ قَائِلُهَا مِنْهُمْ ، وَاللَّهِ لَوْ فَعَلْتُ لَكَانَ عَلَيَّ , وَمَا كَانَ عَلَيْهِمْ ، خَلُّوا لَهُ عَنْ جِيرَانِهِ ""","","","","","The Book of the People of the Two Books"
"18280","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ , عَنْ عِرَاكِ بْنِ مَالِكٍ , قَالَ : أَقْبَلَ رَجُلانِ مِنْ بَنِي غِفَارٍ حَتَّى نَزَلا مَنْزِلا بِضَجْنَانَ مِنْ مِيَاهِ الْمَدِينَةِ ، وَعِنْدَهَا نَاسٌ مِنْ غَطَفَانَ ، عِنْدَهُمْ ظَهْرٌ لَهُمْ ، فَأَصْبَحَ الْغَطَفَانِيُّونَ قَدْ أَضَلُّوا قَرِينَتَيْنِ مِنْ إِبِلِهِمْ , فَاتَّهَمُوا الْغِفَارِيَّيْنِ , فَأَقْبَلُوا بِهِمَا إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَذَكَرُوا لَهُ أَمْرَهُمْ , فَحَبَسَ أَحَدَ الْغِفَارِيَّيْنِ , وَقَالَ لِلآخَرِ : اذْهَبْ فَالْتَمِسْ "" ، فَلَمْ يَكُنْ إِلا يَسِيرًا حَتَّى جَاءَ بِهِمَا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لأَحَدِ الْغِفَارِيَّيْنِ ، قَالَ : حَسِبْتُ أَنَّهُ قَالَ الْمَحْبُوسَ عِنْدَهُ : "" اسْتَغْفِرْ لِي ! "" , قَالَ : غَفَرَ اللَّهُ لَكَ يَا رَسُولَ اللَّهِ , فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ "" وَلَكَ ، وَقَتَلَكَ فِي سَبِيلِهِ ""قَالَ : فَقُتِلَ يَوْمَ الْيَمَامَةِ ""","","","","","The Book of the People of the Two Books"
"18281","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ أَبِي مُلَيْكَةَ , يَقُولُ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ أَبِي عَامِرٍ , قَالَ : انْطَلَقْتُ فِي رَكْبٍ حَتَّى إِذَا جِئْنَا ذَا الْمَرْوَةِ سُرِقَتْ عَيْبَةٌ لِي وَمَعَنَا رَجُلٌ يُتَّهَمُ , فَقَالَ أَصْحَابِي : يَا فُلانُ ، أَدِّ عَيْبَتَهُ ! فَقَالَ : مَا أَخَذْتُهَا ، فَرَجَعْتُ إِلَى عُمَرَ بْنِ الْخَطَّابِ فَأَخْبَرْتُهُ :  كَمْ أَنْتُمْ ؟ ، فَعَدَدْتُهُمْ ، فَقَالَ : أَظُنُّهُ صَاحِبَهَا الَّذِي اتُّهِمَ ، قُلْتُ : لَقَدْ أَرَدْتُ يَا أَمِيرَ الْمُؤْمِنِينَ أَنْ آتِيَ بِهِ مَصْفُودًا , قَالَ :أَتَأْتِي بِهِ مَصْفُودًا بِغَيْرِ بَيِّنَةٍ ؟ لا أَكْتُبُ لَكَ فِيهَا ، وَلا أَسْأَلُ لَكَ عَنْهَا ، قَالَ : فَغَضِبَ , قَالَ : "" فَمَا كَتَبَ لِي فِيهَا ، وَلا سَأَلَ عَنْهَا ""","","","","","The Book of the People of the Two Books"
"18282","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : إِنْ وَجَدْتَ سَرِقَةً مَعَ رَجُلِ سَوْءٍ يُتَّهَمُ , فَقَالَ : ابْتَعْتُهَا فَلَمْ يَنْقُدْ مَنِ ابْتَاعَهَا مِنْهُ ، أَوْ قَالَ : أَخَذْتُهَا لَمْ يُقْطَعْ وَلَمْ يُعَاقَبْ ، وَكَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ إِلَى عَبْدِ الْعَزِيزِ بْنِ عَبْدِ اللَّهِ بِكِتَابٍ قَرَأْتُهُ  أَنْإِذَا وُجِدَ الْمَتَاعُ مَعَ الرَّجُلِ الْمُتَّهَمِ ، فَقَالَ : ابْتَعْتُهُ فَلَمْ يَنْقُدْهُ فَاشْدُدْهُ فِي السِّجْنِ وِثَاقًا , وَلا تُخَلِّيهِ بِكَلامِ أَحَدٍ حَتَّى يَأْتِيَ أَمْرُ اللَّهِ ""، فَذَكَرْتُ ذَلِكَ لِعَطَاءٍ ، فَأَنْكَرَهُ""","","","","","The Book of the People of the Two Books"
"18283","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو بَكْرٍ , عَنِ ابْنِ سِيرِينَ , قَالَ : شَهِدْتُ شُرَيْحًا يُؤْتَى بِهِمْ مَعَهُمُ السَّرِقَةُ فَيَقُولُ : ابْتَعْتُهُ ، فَيَقُولُ شريح : أَظْهَرْتَ السَّرِقَةَ , وَكَتَمْتَ السَّارِقَ , فَيُكْشَفُ عَنْ ذَلِكَ كَشْفًا شَدِيدًا , وَلَمْ يَقْطَعْ فِيهِ ""","","","","","The Book of the People of the Two Books"
"18284","عَنْ سُفْيَانَ ، فِي رَجُلٍ وَامْرَأَتَيْنِ شَهِدُوا عَلَى رَجُلٍ أَنَّهُ سَرَقَ ثَوْبًا ثَمَنُهُ عِشْرُونَ دِرْهَمًا ، قَالَ : نُجِيزُ شَهَادَتَهُمْ فِي الْمَالِ ، وَلا نَقْطَعُهُ ""","","","","","The Book of the People of the Two Books"
"18285","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ ، فِي السَّارِقِ , قَالَ : حَسْبُهُ الْقَطْعُ , وَإِنْ كَانَ مُوسِرًا لا يَغْرَمُ مَعَ الْقَطْعِ , إِلا أَنْ تُوجَدَ السَّرِقَةُ عِنْدَهُ بِعَيْنِهَا ، فَتُؤْخَذَ مِنْهُ ""","","","","","The Book of the People of the Two Books"
"18286","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ , عَنِ الشَّعْبِيِّ , قَالَ : لا غُرْمَ عَلَى السَّارِقِ إِلا أَنْ يُوجَدَ شَيْءٌ بِعَيْنِهِ إِذَا قُطِعُ ""","","","","","The Book of the People of the Two Books"
"18287","عَنْ هشيم , عَنْ أَشْعَثَ , عَنِ ابْنِ سِيرِينَ , قَالَ : إِذَا وُجِدَتِ السَّرِقَةُ مَعَ السَّارِقِ أُخِذَتْ مِنْهُ , وَإِذَا لَمْ تُوجَدْ مَعَهُ قُطِعَتْ يَدُهُ , وَلا ضَمَانَ عَلَيْهِ ""","","","","","The Book of the People of the Two Books"
"18288","عَنِ الثَّوْرِيِّ ، عَنْ حَمَّادٍ , قَالَ : هُوَ دَيْنٌ عَلَى السَّارِقِ , تُقْطَعُ يَدُهُ , وَيُؤْخَذُ مِنْهُ ""، قَالَ سُفْيَانُ : "" وَقَوْلُ الشَّعْبِيِّ أَحَبُّ إِلَيَّ ""","","","","","The Book of the People of the Two Books"
"18289","عَنْ مَعْمَرٍ , قَالَ :  سَمِعْنَا أَنَّالسَّارِقَ تُوجَدُ مَعَهُ سَرِقَتُهُ يُقْطَعُ , وَيُرَدُّ الْمَتَاعُ إِلَى أَهْلِهِ , لَمْ نَسْمَعْ فِيهِ غُرْمًا إِذَا لَمْ يُوجَدِ الْمَتَاعُ مَعَهُ ""","","","","","The Book of the People of the Two Books"
"18290","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ :  فِيرَجُلٍ قَتَلَ رَجُلا وَأَخَذَ مَالَهُ ، قَالَ : يُقْتَلُ بِهِ وَيُغْرَمُ بِمِثْلِ مَالِهِ الَّذِي أَخَذَ مِنْهُ ""، عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ ابْنُ شِهَابٍ مِثْلَ ذَلِكَ""","","","","","The Book of the People of the Two Books"
"18291","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : مَنْ سَرَقَ خَمْرًا مِنْ أَهْلِ الْكِتَابِ قُطِعَ ، قَالَ عَطَاءٌ : "" زَعَمُوا فِي الْخَمْرِ , وَلَحْمِ الْخِنْزِيرِ يَسْرِقُهُ الْمُسْلِمُ مِنْ أَهْلِ الْكِتَابِ , يُقْطَعُ مِنْ أَجْلِ أَنَّهُ لَهُمْ حِلٌّ فِي دِينِهِمْ , فَإِنْ سَرَقَ ذَلِكَ مِنْ مُسْلِمٍ , فَلا قَطْعَ ""","","","","","The Book of the People of the Two Books"
"18292","عَنْ مَعْمَرٍ , عَنِ ابْنِ أَبِي نَجِيحٍ , عَنْ عَطَاءٍ , قَالَ : مَنْ سَرَقَ خَمْرًا مِنْ أَهْلِ الْكِتَابِ قُطِعَ , وَإِنْ سَرَقَ مِنَ الْمُسْلِمِينَ لَمْ يُقْطَعْ ""","","","","","The Book of the People of the Two Books"
"18293","عَنِ الثَّوْرِيِّ , قَالَ : لا قَطْعَ عَلَى مَنْ سَرَقَ مِنْ أَهْلِ الْكِتَابِ خَمْرًا , وَلَكِنْ يَغْرَمُ ثَمَنَهَا ""، قَالَ : وَقَالَ ابْنُ أَبِي نَجِيحٍ , عَنْ عَطَاءٍ : "" يُقْطَعُ ""","","","","","The Book of the People of the Two Books"
"18294","عَنِ ابْنِ مُبَارَكٍ , عَنِ الثَّوْرِيِّ , عَنْ جابِرٍ الْجُعْفِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ كَيْسَانَ , قَالَ : أَرَادَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ أَنْ يَقْطَعَ رَجُلا سَرَقَ دَجَاجَةً ، فَقَالَ لَهُ أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  إِنَّ عُثْمَانَ بْنَ عَفَّانَ : "" كَانَلا يَقْطَعُ فِي الطَّيْرِ ""، قَالَ الثَّوْرِيُّ : "" وَيُسْتَحْسَنُ أَلا يُقْطَعَ مَنْ سَرَقَ مِنْ ذِي مَحْرَمٍ ، خَالِهِ , أَوْ عَمِّهِ , أَوْ ذَاتِ مَحْرَمٍ ""","","","","","The Book of the People of the Two Books"
"18295","عَنِ ابْنِ جُرَيْجٍ , قَالَ : بَلَغَنِي عَنْ عَامِرٍ , قَالَ : لَيْسَ عَلَى زَوْجِ الْمَرْأَةِ فِي سَرِقَةِ مَتَاعِهَا قَطْعٌ ""، قَالَ ابْنُ جُرَيْجٍ : وَقَالَ عَبْدُ الْكَرِيمِ : "" لَيْسَ عَلَى الْمَرْأَةِ فِي سَرِقَةِ مَتَاعِهِ قَطْعٌ "" ، قَالَ : "" وَفِي الْخِيَانَةِ مِنْ هَذَا بَيَانٌ ""","","","","","The Book of the People of the Two Books"
"18296","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ شُعَيْبٍ , وَغَيْرِهِ مِمَّنْ يَرْضَى بِهِ قَالُوا : لا قَطْعَ فِي رِيشٍ , وَإِنْ كَانَ ثَمَنُهُ دِينَارًا وَكَثُرَ ""، يَعْنِي الطَّائِرَ وَمَا أَشْبَهَهُ""","","","","","The Book of the People of the Two Books"
"18297","عَنِ الثَّوْرِيِّ :  فِيالرَّجُلِ يَقْطَعُ عَشَرَةَ أَيْدٍ , قَالَ : يَقُولُ : مَنْ رَضِيَ مِنْكُمْ أَنْ تُقْطَعَ يَدُهُ قَطَعْنَاهَا , وَيَأْخُذَ الْبَاقُونَ الدِّيَةَ , فَإِنْ أَخَذَ بَعْضُهُمُ الدِّيَةَ , قُطِعَتْ يَدَاهُ كِلْتَاهُمَا لِلَّذِينَ أَرَادُوا الْقِصَاصَ , وَكَانَ مَا بَقِيَ دَيْنًا عَلَيْهِ لِمَنْ بَقِيَ مِنْهُمْ , وَإِنْ أَبَوْا إِلا الْقَوَدَ قُطِعَ لَهُمْ جَمِيعًا , وَكَانَ مَا بَقِيَ مِنَ الدِّيَةِ بَيْنَهُمَا جَمِيعًا ""","","","","","The Book of the People of the Two Books"
"18298","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ لا تُقْطَعُ يَدَانِ بِيَدٍ ""","","","","","The Book of the People of the Two Books"
"18299","عَنْ مَعْمَرٍ :  فِيرَجُلٍ سَرَقَ مِنْ رَجُلٍ مَتَاعًا , ثُمَّ جَاءَ آخَرُ فَسَرَقَهُ مِنَ السَّارِقِ , قَالَ : يُقْطَعُ السَّارِقُ الأَوَّلُ , وَأَمَّا الَّذِي سَرَقَهُ مِنَ السَّارِقِ , فَلَيْسَ عَلَيْهِ قَطْعٌ , وَعَلَيْهِ الْغُرْمُ ""، عَنِ ابْنِ الْمُبَارَكِ , عَنِ الثَّوْرِيِّ , مِثْلَ قَوْلِ مَعْمَرٍ ، إِلا أَنَّ الثَّوْرِيَّ , قَالَ : "" عَلَيْهِ غُرْمُ مَا أَخَذَ ""","","","","","The Book of the People of the Two Books"
"18300","عَنْ سَعِيدِ بْنِ عَبْدِ الْعَزِيزِ , عَنْ هِلالِ بْنِ سَعْدٍ ، أَنَّ رَجُلا دَخَلَ الْحَمَّامَ وَتَرَكَ بُرْنُسًا لَهُ , فَجَاءَ رَجُلٌ فَسَرَقَهُ , فَوَجَدَهُ صَاحِبُهُ , فَجَاءَ بِهِ إِلَى أَبِي الدَّرْدَاءِ , فَقَالَ : أَقِمْ عَلَى هَذَا حَدَّ اللَّهِ ، فَقَالَ أَبُو الدَّرْدَاءِ ، أَخْبَرَنَا مَالِكُ بْنُ عَدِيٍّ إِنِّي أَعُوذُ بِاللَّهِ مِنْكَ ، قَالَ : أَتْرُكُهُ ؟ ، قَالَ : "" نَعَمِ اتْرُكْهُ ""، يَعْنِي أَنَّ سَارِقَ الْحَمَّامِ لا يُقْطَعُ""","","","","","The Book of the People of the Two Books"
"18301","عَنِ الثَّوْرِيِّ , عَنْ رَجُلٍ , عَنِ الْحَسَنِ , قَالَ : أُتِيَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِسَارِقٍ سَرَقَ طَعَامًا ، فَلَمْ يَقْطَعْهُ ""، قَالَ سُفْيَانُ : "" وَهُوَ الَّذِي يَفْسُدُ مِنْ نَهَارِهِ لَيْسَ لَهُ بَقَاءٌ ، الثَّرِيدُ وَاللَّحْمُ ، وَمَا أَشْبَهَهُ ، فَلَيْسَ فِيهِ قَطْعٌ , وَلَكِنْ يُعَزَّرُ ، وَإِذَا كَانَتِ الثَّمَرَةُ فِي شَجَرَتِهَا فَلَيْسَ فِيهِ قَطْعٌ ، وَلَكِنْ يُعَزَّرُ ""","","","","","The Book of the People of the Two Books"
"18302","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ , أَنَّ مُحَمَّدَ بْنَ يَحْيَى بْنِ حَبَّانَ أَخْبَرَهُ , عَنْ رَجُلٍ , عَنْ رَافِعِ بْنِ خَدِيجٍ , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : لا قَطْعَ فِي ثَمَرٍ وَلا كَثْرٍ ""","","","","","The Book of the People of the Two Books"
"18303","عَنْ مُحَمَّدٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , أَنَّ رَافِعَ بْنَ خَدِيجٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا قَطْعَ فِي ثَمَرٍ وَلا كَثْرٍ ""، وَالْكَثْرُ : الْجُمَّارُ الَّذِي يَكُونُ فِي النَّخْلِ إِذَا نُزِعَتِ الْجُمَّارَةُ هَلَكَتِ النَّخْلَةُ""","","","","","The Book of the People of the Two Books"
"18304","عَنْ مُحَمَّدٍ , عَنْ عَطَاءٍ الْخُرَاسَانِيِّ , قَالَ : إِنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : مَنْ أَخَذَ مِنَ الثَّمَرِ شَيْئًا , فَلَيْسَ عَلَيْهِ قَطْعٌ , حَتَّى يُؤْوِيَهُ إِلَى الْمَرَابِدِ وَالْجَرَائِنِ , فَإِنْ أَخَذَ مِنْهُ بَعْدَ ذَلِكَ مَا يُسَاوِي رُبْعَ دِينَارٍ , قُطِعَ "", وَالْمَرَابِدُ أَيْضًا : الْجَرَائِنُ""","","","","","The Book of the People of the Two Books"
"18305","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً , يَقُولُ :  كَانَ مَنْ مَضَى يُؤْتَى أَحَدُهُمْ بِالسَّارِقِ , فَيَقُولُ : أَسَرَقْتَ ؟ قُلْ : لا , أَسَرَقْتَ ؟ قُلْ : لا "" عِلْمِي أَنَّهُ سَمَّى أَبَا بَكْرٍ , وَعُمَرَ ، وَأَخْبَرَنِي : أَنَّ عَلِيًّا"" أُتِيَ بِسَارِقَيْنِ مَعَهُمَا سَرِقَتُهُما , فَخَرَجَ فَضَرَبَ النَّاسَ بِالدِّرَّةِ , حَتَّى تَفَرَّقُوا عَنْهُمَا , وَلَمْ يَدْعُ بِهِمَا وَلَمْ يَسْأَلْ عَنْهُمَا ""","","","","","The Book of the People of the Two Books"
"18306","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ عِكْرِمَةَ بْنِ خَالِدٍ , قَالَ : أُتِيَ عُمَرُ بْنُ الْخَطَّابِ بِرَجُلٍ فَسَأَلَهُ : أَسَرَقْتَ ؟ ، قُلْ : لا "" , فَقَالَ : لا , "" فَتَرَكَهُ وَلَمْ يَقْطَعْهُ ""","","","","","The Book of the People of the Two Books"
"18307","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , عَنْ أَبِي مَسْعُودٍ الأَنْصَارِيِّ ، أَنَّهُأُتِيَ بِامْرَأَةٍ سَرَقَتْ جَمَلا , فَقَالَ :  أَسَرَقْتِ ؟ ، قُولِي : لا ""","","","","","The Book of the People of the Two Books"
"18308","عَنِ الثَّوْرِيِّ , عَنْ عَلِيِّ بْنِ الأَقْمَرِ , عَنْ يَزِيدَ بْنِ أَبِي كَبْشَةَ , عَنْ أَبِي الدَّرْدَاءِ رَضِيَ اللَّهُ تَعَالَى عَنْهُ :  أَنَّهُأُتِيَ بِامْرَأَةٍ سَرَقَتْ يُقَالُ لَهَا : سَلامَةُ , فَقَالَ لَهَا : "" يَا سَلامَةُ ، أَسَرَقْتِ ؟ قُولِي : لا , قَالَتْ : لا , "" فَدَرَأَ عَنْهَا ""","","","","","The Book of the People of the Two Books"
"18309","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ خُصَيْفَةَ , أَنَّهُ سَمِعَ ابْنَ ثَوْبَانَ , يَقُولُ : أُتِيَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِسَارِقٍ سَرَقَ شَمْلَةً , فَقِيلَ : يَا رَسُولَ اللَّهِ ! إِنَّ هَذَا سَارِقٌ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا إِخَالُهُ سَرَقَ ، أَسَرَقْتَ وَيْحَكَ ؟ , قَالَ : نَعَمْ , قَالَ : اقْطَعُوا يَدَهُ , ثُمَّ احْسِمُوهَا , ثُمَّ ائْتُونِي بِهِ "" , فَفُعِلَ ذَلِكَ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" تُبْ إِلَى اللَّهِ "" , قَالَ : تُبْتُ إِلَى اللَّهِ , قَالَ : "" اللَّهُمَّ تُبْ عَلَيْهِ ""، عَنِ الثَّوْرِيِّ , عَنْ يَزِيدَ بْنِ خُصَيْفَةَ , عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18310","عَنْ مَعْمَرٍ , عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ : أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَطَعَ سَارِقًا , ثُمَّ أَمَرَ بِهِ فَحُسِمَ , ثُمَّ قَالَ :  تُبْ إِلَى اللَّهِ "" , قَالَ : أَتُوبُ إِلَى اللَّهِ , قَالَ : "" اللَّهُمَّ تُبْ عَلَيْهِ "" , ثُمَّ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّالسَّارِقَ إِذَا قُطِعَتْ يَدُهُ , وَقَعَتْ فِي النَّارِ , فَإِنْ عَادَ تَبِعَهَا , وَإِنْ تَابَ اسْتَشْلاهَا ""، يَعْنِي : اسْتَرْجَعَهَا""","","","","","The Book of the People of the Two Books"
"18311","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ ، أَنَّ صَفْوَانَ أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِسَارِقِ بُرْدِهِ :  فَأَمَرَ بِهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْتُقْطَعَ يَدُهُ , فَقَالَ : لَمْ أُرِدْ هَذَا يَا رَسُولَ اللَّهِ ! هُوَ عَلَيْهِ صَدَقَةٌ , قَالَ : فَهَلا قَبْلَ أَنْ تَأْتِيَ بِهِ ""","","","","","The Book of the People of the Two Books"
"18312","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ عُرْوَةَ بْنِ الزُّبَيْرِ , يَقُولُ : أَخْبَرَنِي فُرَافِصَةُ بْنُ عُمَيْرٍ الْحَنَفِيُّ بْنُ عَبْدِ الدَّارِ , أَنَّ سَارِقًا أُخِذَ مِنْهُ سَرِقَتُهُ , قَالَ : فَأَخَذْنَاهُ وَلاثَ بِهِ النَّاسُ ، فَجَاءَ الزُّبَيْرُ , فَقَالَ : مَا هَذَا ؟ "" فَأَخْبَرْنَاهُ , فَقَالَ : "" اعْفُوهُ ، قُلْنَا : يَا أَبَا عَبْدِ اللَّهِ , تَكَلَّمُ فِي سَارِقٍ مَعَهُ سَرِقَتُهُ ؟ قَالَ : "" نَعَمْ ، اعْفُوهُ , مَا لَمْ يَبْلُغْ حُكْمُهُ , فَإِذَا بَلَغَ حُكْمُهُ لَمْ يَحِلَّ لَهُ أَنْ يَدَعَهُ , وَلا لِشَافِعٍ أَنْ يَشْفَعَ لَهُ ""","","","","","The Book of the People of the Two Books"
"18313","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , أَنَّ الْفُرَافِصَةَ ,  مَرَّ بِهِ الزُّبَيْرُ وَقَدْ أَخَذَ سَارِقًا , وَمَعَهُ نَاسٌ , فَشَفَعَ لَهُ , فَقَالَ الْفُرَافِصَةُ : نُبَلِّغُهُ الأَمِيرَ ، فَإِنْ شَاءَ عَفَا عَنْهُ , فَقَالَ الزُّبَيْرُ"" إِذَا عَفَا عَنْهُ الأَمِيرُ فَلا عَافَاهُ اللَّهُ ""","","","","","The Book of the People of the Two Books"
"18314","عَنْ أَيُّوبَ , عَنْ عِكْرِمَةَ ، أَنَّ عَمَّارَ بْنَ يَاسِرٍ أَخَذَ سَارِقًا , ثُمَّ قَالَ : أَسْتُرُهُ لَعَلَّ اللَّهَ يَسْتُرُنِي ""","","","","","The Book of the People of the Two Books"
"18315","عَنِ الثَّوْرِيِّ , قَالَ : أَخْبَرَنِي أَبِي , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , أَنَّهُ : أَخَذَ سَارِقًا فَزَوَّدَهُ , وَأَرْسَلَهُ وَأَنَّ عَمَّارًا "" أَخَذَ سَارِقَ عَيْبَتِهِ , فَدُلَّ عَلَيْهِ , فَلَمْ يَهْجُهُ , وَتَرَكَهُ ""","","","","","The Book of the People of the Two Books"
"18316","عَنْ إِبْرَاهِيمَ بْنِ طَهْمَانَ , عَنْ مُوسَى بْنِ عُقْبَةَ , عَنْ عَبْدِ اللَّهِ بْنِ يَزِيدَ , عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : قَالَ أَبُو بَكْرٍ الصِّدِّيقُ لَوْ لَمْ أَجِدْ لِلسَّارِقِ , وَالزَّانِي , وَشارِبِ الْخَمْرِ إِلا ثَوْبِي لأَحْبَبْتُ أَنْ أَسْتُرَهُ عَلَيْهِ ""","","","","","The Book of the People of the Two Books"
"18317","عَنِ الثَّوْرِيِّ , عَنْ مُطَّرِحٍ , عَنِ الْحَسَنِ , قَالَ : قَالَ عُمَرُ رَوِّغِ السَّارِقَ وَلا تُرَوِّعْهُ "" يَقُولُ : "" انْفُوهُ , صِحْ بِهِ ، وَلا تَرْصُدْهُ ""","","","","","The Book of the People of the Two Books"
"18318","عَنْ مَعْمَرٍ , عَنْ مُحَمَّدِ بْنِ وَاسِعٍ , عَنْ أَبِي صَالِحٍ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ سَتَرَ عَلَى مُسْلِمٍ سَتَرَ اللَّهُ عَلَيْهِ فِي الآخِرَةِ , وَمَنْ نَفَّسَ عَنْ مُسْلِمٍ كُرْبَةً , نَفَّسَ اللَّهُ عَنْهُ كُرْبَةً فِي الآخِرَةِ , وَاللَّهُ فِي عَوْنِ الْمُسْلِمِ مَا كَانَ فِي عَوْنِ أَخِيهِ ""","","","","","The Book of the People of the Two Books"
"18319","عَنْ مَعْمَرٍ , عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ , عَنْ أَبِيهِ , عَنْ أَبِي هُرَيْرَةَ ، قَالَ : لا أَدْرِي أَرَفَعَهُ أَمْ لا , قَالَ : مَنْ سَتَرَ عَلَى مُسْلِمٍ سَتَرَهُ اللَّهُ ""","","","","","The Book of the People of the Two Books"
"18320","أَخْبَرَنَا مُحَمَّدُ بْنُ رَاشِدٍ , قَالَ : أَخْبَرَنَا سُلَيْمَانُ بْنُ مُوسَى , عَنْ مَنْ حَدَّثَهُ , عَنْ رَجُلٍ مِنَ الأَنْصَارِ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ خَرَجَ مِنَ الْمَدِينَةِ إِلَى عُقْبَةَ بْنِ عَامِرٍ وَهُوَ أَمِيرٌ عَلَى مِصْرَ يَسْأَلُهُ عَنْ حَدِيثٍ سَمِعَاهُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ جَمِيعًا ، فَسَأَلَهُ عَنْهُ , فَقَالَ عُقْبَةُ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : مَنْ سَتَرَ أَخَاهُ فِي فَاحِشَةٍ رَآهَا عَلَيْهِ , سَتَرَهُ اللَّهُ فِي الدُّنْيَا وَالآخِرَةِ ""، قَالَ سُلَيْمَانُ : "" وَدُعِيَ عُثْمَانُ فِي وِلايَتِهِ إِلَى قَوْمٍ عَلَى أَمْرٍ قَبِيحٍ ، فَرَاحَ إِلَيْهِمْ ، فَلَمْ يُصَادِفْهُمْ , وَرَأَى أَمْرًا قَبِيحًا , فَحَمِدَ اللَّهَ إِذْ لَمْ يُصَادِفْهُمْ , وَأَعْتَقَ رَقَبَةً ""","","","","","The Book of the People of the Two Books"
"18321","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ الْمُنْكَدِرِ , عَنْ أَبِي أَيُّوبَ , وَعَنْ مَسْلَمَةَ بْنِ مَخْلَدٍ ، أَنَّ النَّبِي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ سَتَرَ مُسْلِمًا سَتَرَهُ اللَّهُ فِي الدُّنْيَا وَالآخِرَةِ , وَمَنْ نَجَّى مَكْرُوبًا , فَكَّ اللَّهُ عَنْهُ كُرْبَةً مِنْ كُرَبِ يَوْمِ الْقِيَامَةِ , وَمَنْ كَانَ فِي حَاجَةِ أَخِيهِ كَانَ اللَّهُ فِي حَاجَتِهِ ""","","","","","The Book of the People of the Two Books"
"18322","قَالَ ابْنُ جُرَيْجٍ : وَرَكِبَ أَبُو أَيُّوبَ إِلَى عُقْبَةَ بْنِ عَامِرٍ ، بِمِصْرَ ، فَقَالَ : إِنِّي سَائِلُكَ عَنْ أَمْرٍ لَمْ يَبْقَ مَنْ حَضَرَهُ إِلا أَنَا وَأَنْتَ , كَيْفَ سَمِعْتَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : مَنْ سَتَرَ مُؤْمِنًا فِي الدُّنْيَا عَلَى عَوْرَةٍ , سَتَرَهُ اللَّهُ يَوْمَ الْقِيَامَةِ ""، فَرَجَعَ إِلَى الْمَدِينَةِ وَمَا حَلَّ رَحْلَهُ ، يُحَدِّثُ بِهَذَا الْحَدِيثِ أَبُو سَعِيدٍ عَطَاءً""","","","","","The Book of the People of the Two Books"
"18323","عَنِ ابْنِ جُرَيْجٍ , وَالْمُثَنَّى , قَالا : أَخْبَرَنَا عَمْرُو بْنُ شُعَيْبٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : تَعَافَوْا فِيمَا بَيْنَكُمْ قَبْلَ أَنْ تَأْتُونِي , فَمَا بَلَغَنِي مِنْ حَدٍّ فَقَدْ وَجَبَ ""","","","","","The Book of the People of the Two Books"
"18324","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , أَنَّ قَالُوا لِصَفْوَانَ بْنِ أُمَيَّةَ بْنِ خَلَفٍ بَعْدَ الْفَتْحِ لا دِينَ لِمَنْ لا هِجْرَةَ لَهُ , فَجَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُهَاجِرًا ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  لَتَرْجِعَنَّ أَبَا وَهْبٍ إِلَى أَبَاطِحَ مَكَّةَ ، قَالَ :هَذَا سَارِقٌ سَرَقَ خَمِيصَةً لِي ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اقْطَعُوا يَدَهُ ، قَالَ : هِيَ لَهُ يَا رَسُولَ اللَّهِ ! قَالَ : فَهَلا قَبْلَ أَنْ تَأْتِيَنِي بِهِ , فَأَمَّا إِذَا جِئْتَنِي بِهِ , فَلا ""، فَقُطِعَتْ يَدُهُ ، وَرَجَعَ صَفْوَانُ إِلَى مَكَّةَ ""","","","","","The Book of the People of the Two Books"
"18325","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالَ : قِيلَ لِصَفْوَانَ بْنِ أُمَيَّةَ : هَلَكَ مَنْ لَيْسَتْ لَهُ هِجْرَةٌ ، فَحَلَفَ أَلا يَغْسِلَ رَأْسَهُ حَتَّى يَأْتِيَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَرَكِبَ رَاحِلَتَهُ ثُمَّ انْطَلَقَ ، فَصَادَفَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عِنْدَ بَابِ الْمَسْجِدِ , فَقَالَ :  يَا رَسُولَ اللَّهِ ! إِنَّهُ قِيلَ لِي : هَلَكَ مَنْ لا هِجْرَةَ لَهُ ، فَآلَيْتُ بِيَمِينٍ أَلا أَغْسِلَ رَأْسِي حَتَّى آتِيَكَ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" إِنَّ صَفْوَانَسَمِعَ بِالإِسْلامِ فَرَضِيَ بِهِ دِينًا , وَإِنَّ الْهِجْرَةَ قَدِ انْقَطَعَتْ بَعْدَ الْفَتْحِ , وَلَكِنْ جِهَادٌ وَنِيَّةٌ , وَإِذَا اسْتُنْفِرْتُمْ فَانْفِرُوا , ثُمَّ جَاءَ بِسَارِقِ خَمِيصَتِهِ , فَأَمَرَ بِهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ تُقْطَعَ يَدُهُ "" ، فَقَالَ : لَمْ أُرِدْ هَذَا يَا رَسُولَ اللَّهِ ! هُوَ عَلَيْهِ صَدَقَةٌ ، قَالَ : "" فَهَلا قَبْلَ أَنْ تَأْتِيَنِي بِهِ ""","","","","","The Book of the People of the Two Books"
"18326","عَنِ ابْنِ جُرَيْجٍ , عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ , أَنَّ رَجُلا جَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : يَا رَسُولَ اللَّهِ ! إِنِّي أَصَبْتُ حَدًّا , فَأَقِمْهُ عَلَيَّ , فَلَمْ يَسْأَلْهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْهُ ، وَأُقِيمَتِ الصَّلاةُ , فَقَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَصَلَّى ، وَذَلِكَ الرَّجُلُ مَعَهُ , فَلَمَّا انْصَرَفَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَدْرَكَهُ الرَّجُلُ ، فَقَالَ : يَا رَسُولَ اللَّهِ ,أَنَا صَاحِبُ الْحَدِّ فَأَقِمْهُ عَلَيَّ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَلَيْسَ قَدْ صَلَّيْتَ مَعَنَا آنِفًا ؟ ، قَالَ : بَلَى ، قَالَ : فَاذْهَبْ فَإِنَّهُ قَدْ غُفِرَ لَكَ ""","","","","","The Book of the People of the Two Books"
"18327","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ الشَّعْبِيِّ , قَالَ : أَشْرَفَ ابْنُ مَسْعُودٍ عَلَى دَارِهِ بِالْكُوفَةِ فَإِذَا هِيَ قَدْ غُصَّتْ بِالنَّاسِ , فَقَالَ : مَنْ جَاءَ يَسْتَفْتِينَا فَلْيَجْلِسْ نُفْتِيهِ إِنْ شَاءَ اللَّهُ , وَمَنْ جَاءَ يُخَاصِمُ فَلْيَقْعُدْ حَتَّى نَقْضِيَ بَيْنَهُ وَبَيْنَ خَصْمِهِ إِنْ شَاءَ اللَّهُ , وَمَنْ جَاءَ يُرِيدُ أَنْ يُطْلِعَنَا عَلَى عَوْرَةٍ قَدْ سَتَرَهَا اللَّهُ عَلَيْهِ , فَلْيَسْتَتِرْ بِسِتْرِ اللَّهِ , وَلْيَقْبَلْ عَافِيَةَ اللَّهِ , وَلْيُسْرِرْ تَوْبَتَهُ إِلَى الَّذِي يَمْلِكُ مَغْفِرَتَهَا , فَإِنَّا لا نَمْلِكُ مَغْفِرَتَهَا , وَلَكِنَّا نُقِيمُ عَلَيْهِ حَدَّهَا , وَنُمْسِكُ عَلَيْهِ بِعَارِهَا ""","","","","","The Book of the People of the Two Books"
"18328","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ خَرَجَ لَيْلَةً يَحْرُسُ رُفْقَةً نَزَلَتْ بِنَاحِيَةِ الْمَدِينَةِ , حَتَّى إِذَا كَانَ فِي بَعْضِ اللَّيْلِ , مَرَّ بِبَيْتٍ فِيهِ نَاسٌ ، قَالَ : حَسِبْتُ أَنَّهُ قَالَ : يَشْرَبُونَ , فَثَارَ بِهِمْ "" أَفِسْقًا ؟ ، فَقَالَ بَعْضُهُمْ : بَلَى ، أَفِسْقًا ؟ قَدْ نَهَاكَ اللَّهُ عَنْ هَذَا ""، فَرَجَعَ عُمَرُ وَتَرَكَهُمْ""","","","","","The Book of the People of the Two Books"
"18329","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ مُصْعَبِ بْنِ زُرَارَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنِ الْمِسْوَرِ بْنِ مَخْرَمَةَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ , أَنَّهُ حَرَسَ لَيْلَةً مَعَ عُمَرَ بْنِ الْخَطَّابِ ، فَبَيْنَا هُمْ يَمْشُونَ شَبَّ لَهُمْ سِرَاجٌ فِي بَيْتٍ , فَانْطَلَقُوا يَؤُمُّونَهُ , حَتَّى إِذَا دَنَوْا مِنْهُ ، إِذَا بَابٌ مُجَافٍ عَلَى قَوْمٍ لَهُمْ فِيهِ أَصْوَاتٌ مُرْتَفِعَةٌ وَلَغَطٌ , فَقَالَ عُمَرُ وَأَخَذَ بِيَدِ عَبْدِ الرَّحْمَنِ : أَتَدْرِي بَيْتُ مَنْ هَذَا ؟ ، قَالَ : قُلْتُ : لا , قَالَ : هُوَ رَبِيعَةَ بْنِ أُمَيَّةَ بْنِ خَلَفٍ ، وَهُمُ الآنَ شُرَّبٌ ، فَمَا تَرَى ؟ قَالَ عَبْدُ الرَّحْمَنِ : أَرَى قَدْ أَتَيْنَا مَا نَهَانَا اللَّهُ عَنْهُ ، نَهَانَا اللَّهُ فَقَالَ :  وَلا تَجَسَّسُوا فَقَدْ تَجَسَّسْنَا ""فَانْصَرَفَ عَنْهُمْ عُمَرُ وَتَرَكَهُمْ ""","","","","","The Book of the People of the Two Books"
"18330","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , أَنَّ عُمَرَ حُدِّثَ ، أَنَّ أَبَا مِحْجَنٍ الثَّقَفِيَّ يَشْرَبُ الْخَمْرَ فِي بَيْتِهِ , هُوَ وَأَصْحَابٌ لَهُ , فَانْطَلَقَ عُمَرُ حَتَّى دَخَلَ عَلَيْهِ , فَإِذَا لَيْسَ عِنْدَهُ إِلا رَجُلٌ , فَقَالَ أَبُو مِحْجَنٍ  يَا أَمِيرَ الْمُؤْمِنِينَ ! إِنَّ هَذَا لا يَحِلُّ لَكَ , قَدْ نَهَى اللَّهُ عَنِ التَّجَسُّسِ , فَقَالَ عُمَرُ : ""مَا يَقُولُ هَذَا ؟ فَقَالَ لَهُ زَيْدُ بْنُ ثَابِتٍ , وَعَبْدُ الرَّحْمَنِ بْنُ الأَرْقَمِ : "" صَدَقَ يَا أَمِيرَ الْمُؤْمِنِينَ ! هَذَا مِنَ التَّجَسُّسِ "", قَالَ : "" فَخَرَجَ عُمَرُ وَتَرَكَهُ ""","","","","","The Book of the People of the Two Books"
"18331","عَنِ ابْنِ عُيَيْنَةَ , عَنِ الأَعْمَشِ , عَنْ زَيْدِ بْنِ وَهْبٍ , قَالَ : قِيلَ لابْنِ مَسْعُودٍ : هَلَكَ الْوَلِيدُ بْنُ عُقْبَةَ تَقْطُرُ لِحْيَتُهُ خَمْرًا , قَالَ :  قَدْ نُهِينَاعَنِ التَّجَسُّسِ , فَإِنْ يَظْهَرْ لَنَا نُقِمْ عَلَيْهِ ""","","","","","The Book of the People of the Two Books"
"18332","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي بُدَيْلٌ الْعُقَيْلِيُّ , عَنْ أَبِي الرِّضَا , قَالَ : رُفِعَ إِلَى عَلِيٍّ رَجُلُ فَقِيلَ : سَرَقَ , فَقَالَ لَهُ : كَيْفَ سَرَقْتَ ؟ ، فَأَخْبَرَهُ بِأَمْرٍ لَمْ يَرَ عَلَيْهِ فِيهِ قَطْعًا , فَضَرَبَهُ أَسْوَاطًا , وَخَلَّى سَبِيلَهُ ""","","","","","The Book of the People of the Two Books"
"18333","عَنِ ابْنِ جُرَيْجٍ , قَالَ : كَانَ عَطَاءٌ , يَقُولُ : لا تُقْطَعُ يَدُ السَّارِقِ فِيمَا دُونَ عَشَرَةِ دَرَاهِمَ ""","","","","","The Book of the People of the Two Books"
"18334","عَنِ الثَّوْرِيِّ ، عَنِ ابْنِ أَبِي نَجِيحٍ , عَنْ عَطَاءٍ , قَالَ : تُقْطَعُ الْيَدُ فِي عَشَرَةِ دَرَاهِمَ ""","","","","","The Book of the People of the Two Books"
"18335","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ شُعَيْبٍ فِي حَدِيثِ اللُّقَطَةِ ، قَالَ فِيهِ : وَثَمَنُ الْمِجَنِّ عَشَرَةُ دَرَاهِمَ ""","","","","","The Book of the People of the Two Books"
"18336","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ , عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , عَنِ ابْنِ مَسْعُودٍ , قَالَ :  كَانَلا تُقْطَعُ الْيَدُ إِلا فِي دِينَارٍ ، أَوْ عَشَرَةِ دَرَاهِمَ ""","","","","","The Book of the People of the Two Books"
"18337","عَنِ الْمُثَنَّى , عَنْ عَمْرِو بْنِ شُعَيْبٍ , عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا سَرَقَ السَّارِقُ , مَا يَبْلُغُ ثَمَنَ الْمِجَنِّ قُطِعَتْ يَدُهُ , وَكَانَ ثَمَنُ الْمِجَنِّ عَشَرَةَ دَرَاهِمَ ""","","","","","The Book of the People of the Two Books"
"18338","عَنِ الْحَسَنِ بْنِ عُمَارَةَ , عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ , عَنْ يَحْيَى بْنِ الْجَزَّارِ , عَنْ عَلِيٍّ , قَالَ : لا يُقْطَعُ فِي أَقَلَّ مِنْ دِينَارٍ ، أَوْ عَشَرَةِ دَرَاهِمَ ""","","","","","The Book of the People of the Two Books"
"18339","عَنْ يَحْيَى بْنِ يَزِيدَ , وَغَيْرِهِ , عَنِ الثَّوْرِيِّ , عَنْ عَطِيَّةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : أُتِيَ عُمَرُ بْنُ الْخَطَّابِ بِرَجُلٍ سَرَقَ ثَوْبًا , فَقَالَ لِعُثْمَانَ : قَوِّمْهُ ، فَقَوَّمَهُ ثَمَانِيَةَ دَرَاهِمَ ، فَلَمْ يَقْطَعْهُ ""","","","","","The Book of the People of the Two Books"
"18340","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : لا تُقْطَعُ الْيَدُ إِلا فِي تُرْسٍ أَوْ حَجَفَةٍ "" ، قَالَ : سَأَلْتُ إِبْرَاهِيمَ : مَا قِيمَتُهَا ؟ قَالَ : "" دِينَارٌ ""","","","","","The Book of the People of the Two Books"
"18341","عَنْ مَعْمَرٍ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قَالَ : تُقْطَعُ يَدُ السَّارِقِ فِي دِينَارٍ أَوْ قِيمَتِهِ ""","","","","","The Book of the People of the Two Books"
"18342","عَنْ إِبْرَاهِيمَ , عَنْ دَاوُدَ بْنِ الْحُصَيْنِ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : ثَمَنُ الْمِجَنِّ الَّذِي يُقْطَعُ فِيهِ دِينَارٌ ""، قَالَ : وَأَخْبَرَنَا دَاوُدُ بْنُ الْحُصَيْنِ , عَنِ ابْنِ الْمُسَيِّبِ , مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18343","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : كَانَ مَرْوَانُ يُحَدِّثُ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَطَعَ يَدَ رَجُلٍ فِي مِجَنٍّ ""وَالْمِجَنُّ : التُّرْسُ""","","","","","The Book of the People of the Two Books"
"18344","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ ابْنُ عُرْوَةَ , قَالَ : أَخْبَرَنَا عُرْوَةُ : أَنَّ سَارِقًا لَمْ يُقْطَعْ فِي عَهْدِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي أَدْنَى مِنْ مِجَنٍّ , حَجَفَةٍ أَوْ تُرْسٍ ، وَكُلُّ وَاحِدٍ مِنْهَا يَوْمَئِذٍ ذُو ثَمَنٍ , وَأَنَّ السَّارِقَ لَمْ يَكُنْ يُقْطَعُ فِي عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الشَّيْءِ التَّافِهِ ""","","","","","The Book of the People of the Two Books"
"18345","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , قَالَ : قَطَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَدَ سَارِقٍ فِي مِجَنٍّ ، وَالْمِجَنُّ يَوْمَئِذٍ ذُو ثَمَنٍ ""","","","","","The Book of the People of the Two Books"
"18346","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عَمْرَةَ , عَنْ عَائِشَةَ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : تُقْطَعُ يَدُ السَّارِقِ فِي رُبُعِ دِينَارٍ فَصَاعِدًا ""","","","","","The Book of the People of the Two Books"
"18347","عَنْ مَعْمَرٍ , عَنْ عَطَاءٍ الْخُرَاسَانِيِّ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : إِذَا أَخَذَ السَّارِقُ مَا يُسَاوِي رُبُعَ دِينَارٍ قُطِعَ ""","","","","","The Book of the People of the Two Books"
"18348","عَنْ مَعْمَرٍ , أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ كَتَبَ :  أَنْتُقْطَعَ يَدُ السَّارِقِ فِي رُبُعِ دِينَارٍ ""","","","","","The Book of the People of the Two Books"
"18349","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ , عَنْ عَمْرَةَ , عَنْ عَائِشَةَ , قَالَتْ : تُقْطَعُ يَدُ السَّارِقِ فِي رُبُعِ دِينَارٍ ""","","","","","The Book of the People of the Two Books"
"18350","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ سُلَيْمَانَ بْنِ يَسَارٍ , قَالَ : لا تُقْطَعُ الْخَمْسُ إِلا فِي الْخَمْسِ الدَّنَانِيرِ ""، عَنِ ابْنِ جُرَيْجٍ , عَنْ رَجُلٍ , عَنِ الْحَسَنِ , مِثْلَ قَوْلِ قَتَادَةَ""","","","","","The Book of the People of the Two Books"
"18351","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَطَعَ يَدَ سَارِقٍ فِي مِجَنٍّ ثَمَنُهُ ثَلاثَةُ دَرَاهِمَ ""","","","","","The Book of the People of the Two Books"
"18352","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَطَعَ فِي مِجَنٍّ ثَمَنُهُ ثَلاثَةُ دَرَاهِمَ ""، عَنِ الثَّوْرِيِّ , عَنْ أَيُّوبَ السَّخْتِيَانِيِّ , وَأَيُّوبَ بْنِ مُوسَى , وَإِسْمَاعِيلَ بْنِ أُمَيَّةَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18353","عَنِ الثَّوْرِيِّ , عَنْ حُمَيْدٍ الطَّوِيلِ , عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : قَطَعَ أَبُو بَكْرٍ فِي مِجَنٍّ مَا يُسَاوِي ، أَوْ مَا يَسُرُّنِي أَنَّهُ لِي بِثَلاثَةِ دَرَاهِمَ ""، قَالَ الثَّوْرِيُّ : وَأَخْبَرَنِي شُعْبَةُ , عَنْ قَتَادَةَ , عَنْ أَنَسٍ , قَالَ : "" خَمْسَةُ دَرَاهِمَ ""","","","","","The Book of the People of the Two Books"
"18354","عَنِ ابْنِ عُيَيْنَةَ , عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنِ ابْنِ الْمُسَيِّبِ :  أَنَّسَارِقًا سَرَقَ أُتْرُنْجَةً ثَمَنُهَا ثَلاثَةُ دَرَاهِمَ ، فَقَطَعَ عُثْمَانُ يَدَهُ ""قَالَ : "" وَالأُتْرُنْجَةُ : خَرَزَةٌ مِنْ ذَهَبٍ تَكُونُ فِي عُنُقِ الصَّبِيِّ "" ، عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18355","عَنِ الثَّوْرِيِّ , أَوْ غَيْرِهِ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , أَنَّ شُرَطَ عُثْمَانَ كَانُوا يَسْرِقُونَ السِّيَاطَ , فَبَلَغَ ذَلِكَ عُثْمَانَ , فَقَالَ :  أُقْسِمُ بِاللَّهِ لَتَتْرُكُنَّ هَذَا , أَوْلا أُوتَى بِرَجُلٍ مِنْكُمْ سَرَقَ سَوْطَ صَاحِبِهِ , إِلا فَعَلْتُ بِهِ وَفَعَلْتُ ""","","","","","The Book of the People of the Two Books"
"18356","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي جَعْفَرُ بْنُ مُحَمَّدٍ , عَنْ أَبِيهِ , أَنَّ عَلِيًّا ، قَطَعَ فِي بَيْضَةٍ مِنْ حَدِيدٍ ""","","","","","The Book of the People of the Two Books"
"18357","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ أَبِي مُلَيْكَةَ ، أَنَّ عَبْدَيْنِ عَدَوْا ، وَهُوَ عَامَلُ الطَّائِفِ ، عَلَى خِمَارِ امْرَأَة ، فَسَأَلَتْهُمَا , فَقَالا : حَمَلَنَا عَلَيْهِ الْجُوعُ , وَاضْطُرِرْنَا إِلَيْهِ , قُلْتُ : أَكَانَا آبِقَيْنِ ؟ ، قَالَ : لَمْ أَعْلَمْ , قَالَ : فَكَتَبْتُ فِيهِمَا إِلَى ابْنِ عَبَّاسٍ , وَإِلَى عُبَيْدِ بْنِ عُمَيْرٍ , وَعَبَّادِ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ , فَكَتَبَ عَبَّادٌ  أَنِ اقْطَعْهُمَا "" , وَكَتَبَ عُبَيْدُ بْنُ عُمَيْرٍ : "" أَنْ قَدْ أُحِلَّ الْمَيْتَةُ , وَالدَّمُ , وَلَحْمُ الْخِنْزِيرِ لِمَنِ اضْطُرَّ "" , وَكَتَبَ ابْنُ عَبَّاسٍ وَقَدْ كُنْتُ كَتَبْتُ إِلَيْهِ بِمَا اعْتَلا بِهِ مِنَ الْجُوعِ , فَكَتَبَ : "" أَنْ قَدْأَصَبْتَ ، لا تَقْطَعْهُمَا , وَغَرِّمْ سَادَتَهُمَا ثَمَنَ الْخِمَارِ , وَإِنْ كَانَ فِيهِمَا جَلْدٌ فَاجْلِدْهُمَا , لِئَلا يَعْتَلَّ الْعَبْدُ بِالْجُوعِ ""","","","","","The Book of the People of the Two Books"
"18358","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي هِشَامُ بْنُ عُرْوَةَ , عَنْ عُرْوَةَ , أَنَّ يَحْيَى بْنَ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ , أَخْبَرَهُ عَنْ أَبِيهِ , قَالَ : تُوُفِّيَ حَاطِبٌ وَتَرَكَ أَعْبُدًا , مِنْهُمْ مَنْ يَمْنَعُهُ , مِنْ سِتَّةِ آلافٍ يَعْمَلُونَ فِي مَالِ الْحَاطِبِ يُشَمِّرَانِ ، فَأَرْسَلَ إِلَيَّ عُمَرُ ذَاتَ يَوْمٍ ظُهْرًا , وَهُمْ عِنْدَهُ , فَقَالَ :  هَؤُلاءِ أَعْبُدُكَ سَرَقُوا ، وَقَدَ وَجَبَ عَلَيْهِمْ مَا وَجَبَ عَلَى السَّارِقِ ، وَانْتَحَرُوا نَاقَةً لِرَجُلٍ مِنْ مُزَيْنَةَ ، اعْتَرَفُوا بِهَا وَمَعَهُمُ الْمُزَنِيُّ ، فَأَمَرَ عُمَرُ أَنْ تُقْطَعَ أَيْدِيهِمْ "" ، ثُمَّ أَرْسَلَ وَرَاءَهُ , فَرَدَّهُ , ثُمَّ قَالَ لِعَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ : "" أَمَا وَاللَّهِلَوْلا أَنِّي أَظُنُّ أَنَّكُمْ تَسْتَعْمِلُونَهُمْ , وَتُجِيعُونَهُمْ , حَتَّى لَوْ أَنَّ أَحَدَهُمْ يَجِدُ مَا حَرَّمَ اللَّهُ عَلَيْهِ لأَكَلَهُ , لَقَطَعْتُ أَيْدِيَهُمْ , وَلَكِنْ وَاللَّهُ إِذْ تَرَكْتُهُمْ لأُغَرِّمَنَّكَ غَرَامَةُ تُوجِعُكَ "" , ثُمَّ قَالَ لِلْمُزَنِيِّ : كَمْ ثَمَنُهَا ؟ ، قَالَ : "" كُنْتُ أَمْنَعُهَا مِنْ أَرْبَعِ مِائَةٍ "" ، قَالَ : أَعْطِهِ ثَمَانِ مِائَةٍ ""","","","","","The Book of the People of the Two Books"
"18359","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , عَنْ يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ , أَنَّ غِلْمَةً لأَبِيهِ عَبْدِ الرَّحْمَنِ بْنِ حَاطِبٍ سَرَقُوا بَعِيرًا , فَانْتَحَرُوهُ , فَوُجِدَ عِنْدَهُمْ جِلْدُهُ , وَرَأْسُهُ , فَرُفِعَ أَمْرُهُمْ إِلَى عُمَرَ بْنِ الْخَطَّابِ  فَأَمَرَ بِقَطْعِهِمْ "" , فَمَكَثُوا سَاعَةً , وَمَا نُرَى إِلا أَنْ قَدْ فَرَغَ مِنْ قَطْعِهِمْ , ثُمَّ قَالَ عُمَرُ : "" عَلَيَّ بِهِمْ "" , ثُمَّ قَالَ لِعَبْدِ الرَّحْمَنِ : "" وَاللَّهُ ,إِنِّي لأَرَاكَ تَسْتَعْمِلُهُمْ , ثُمَّ تُجِيعُهُمْ , وَتُسِيءُ إِلَيْهِمْ , حَتَّى لَوْ وَجَدُوا مَا حَرَّمَ اللَّهُ عَلَيْهِمْ , لَحَلَّ لَهُمْ "" , ثُمَّ قَالَ لِصَاحِبِ الْبَعِيرِ : "" كَمْ كُنْتَ تُعْطَى لِبَعِيرِكَ ؟ "" قَالَ : أَرْبَعَ مِائَةِ دِرْهَمٍ , قَالَ لِعَبْدِ الرَّحْمَنِ : "" قُمْ ، فَاغْرَمْ لَهُمْ ثَمَانِ مِائَةِ دِرْهَمْ ""","","","","","The Book of the People of the Two Books"
"18360","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ : قَطَعَ يَدَ غُلامٍ لَهُ سَرَقَ , وَجَلَدَ عَبْدًا لَهُ زَنَى ، مِنْ غَيْرِ أَنْ يَرْفَعَهُمَا ""","","","","","The Book of the People of the Two Books"
"18361","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ رَبِّهِ بْنُ أَبِي أُمَيَّةَ , أَنَّ الْحَارِثَ بْنَ عَبْدِ اللَّهِ بْنِ أَبِي رَبِيعَةَ حَدَّثَهُ ، وَابْنَ سَابِطٍ الأَحْوَلُ , عَنِ ابْنِ جُرَيْجٍ , قَالَ : إِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أُتِيَ بِعَبْدٍ قَدْ سَرَقَ , فَقِيلَ : يَا رَسُولَ اللَّهِ ! هَذَا عَبْدٌ قَدْ سَرَقَ , وَوُجِدَ مَعَهُ سَرِقَتُهُ , وَقَامَتِ الْبَيِّنَةُ عَلَيْهِ , قَالَ رَجُلٌ : يَا نَبِيَّ اللَّهِ ! هَذَا عَبْدُ بَنِي فُلانٍ أَيْتَامٍ , لَيْسَ لَهُمْ مَالٌ غَيْرُهُ , فَتَرَكَهُ , ثُمَّ أُتِيَ بِهِ الثَّانِيَةَ , ثُمَّ الثَّالِثَةَ , ثُمَّ الرَّابِعَةَ , كُلُّ ذَلِكَ يُقَالُ لَهُ فِيهِ كَمَا قِيلَ فِي الأُولَى , قَالَ : ثُمَّ أُتِيَ بِهِ الْخَامِسَةَ فَقَطَعَ يَدَهُ , ثُمَّ السَّادِسَةَ فَقَطَعَ رِجْلَهُ , ثُمَّ السَّابِعَةَ فَقَطَعَ يَدَهُ , ثُمَّ الثَّامِنَةَ فَقَطَعَ رِجْلَهُ ""، ثُمَّ قَالَ الْحَارِثُ : أَرْبَعٌ بِأَرْبَعَ , أَعْفَاهُ أَرْبَعًا , وَعَاقَبَهُ أَرْبَعًا""","","","","","The Book of the People of the Two Books"
"18362","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدٍ , عَنْ أَبِي الزِّنَادِ , عَنْ عَبْدِ اللَّهِ بْنِ عَامِرٍ , أَنَّ أَبَا بَكْرٍ : قَطَعَ يَدَ عَبْدٍ سَرَقَ ""","","","","","The Book of the People of the Two Books"
"18363","عَنِ ابْنِ جُرَيْجٍ , عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ , عَنْ بَعْضِ أَهْلِهِ أَنَّهُ : حَضَرَ أَبَا بَكْرٍ قَطَعَ يَدَ عَبْدٍ سَرَقَ ""","","","","","The Book of the People of the Two Books"
"18364","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : دَخَلْتُ عَلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، فَسَأَلَنِي :  أَيُقْطَعُ الْعَبْدُ الآبِقُ إِذَا سَرَقَ ؟ قُلْتُ : لَمْ أَسْمَعْ فِيهِ بِشَيْءٍ , فَقَالَ لِي عُمَرُ : فَإِنَّ عُثْمَانَ وَمَرْوَانَ لا يَقْطَعَانِهِ , قَالَ الزُّهْرِيُّ : فَلَمَّا اسْتُخْلِفَ يَزِيدُ بْنُ عَبْدِ الْمَلِكِ رُفِعَ إِلَيْهِ عَبْدٌ آبِقٌ , فَسَأَلَنِي عَنْهُ , فَأَخْبَرْتُهُ مَا أَخْبَرَنِي بِهِ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ , عَنْ عُثْمَانَ وَمَرْوَانَ , فَقَالَ أَسَمِعْتَ فِيهِ بِشَيْءٍ ؟ فَقُلْتُ لا , إِلا مَا أَخْبَرَنِي بِهِ عُمَرُ , قَالَ : فَوَاللَّهِ لأَقْطَعَنَّهُ , قَالَ الزُّهْرِيُّ : فَحَجَجْتُ عَامِي , فَلَقِيتُ سَالِمَ بْنَ عَبْدِ اللَّهِ , فَأَخْبَرَنِي أَنَّ غُلامًا لِعَبْدِ اللَّهِ بْنِ عُمَرَ سَرَقَ وَهُوَ آبِقٌ , فَرَفَعَهُ ابْنُ عُمَرَ إِلَى سَعِيدِ بْنِ الْعَاصِ وَهُوَ عَلَى الْمَدِينَةِ , فَقَالَ : ""لَيْسَ عَلَيْهِ قَطْعٌ , إِنَّكَ لا تَقْطَعُ آبِقًا "" قَالَ : "" فَذَهَبَ بِهِ ابْنُ عُمَرَ فَقَطَعَهُ , وَقَامَ عَلَيْهِ , حَتَّى قُطِعَ ""","","","","","The Book of the People of the Two Books"
"18365","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ رُزَيْقٍ , صَاحِبِ أَيْلَةَ أَنَّهُ كَتَبَ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ فِي آبِقٍ سَرَقَ , قَالَ : وَكُنْتُ أَسْمَعُ أَنَّ الآبِقَ لا يُقْطَعُ , قَالَ : فَكَتَبَ إِلَيَّ عُمَرُ :  أَنَّ اللَّهَ يَقُولُ : وَالسَّارِقُ وَالسَّارِقَةُ فَاقْطَعُوا أَيْدِيَهُمَا , "" فَإِنْ سَرَقَ سَرِقَةً تَبْلُغُ رُبُعَ دِينَارٍ , وَقَامَتْ عَلَيْهِ بَيِّنَةٌ عَادِلَةٌ فَاقْطَعْهُ ""، عَنِ الثَّوْرِيِّ , عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنْ رُزَيْقٍ , مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18366","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , قَالَ : أَبَقَ غُلامٌ لابْنِ عُمَرَ ، فَمَرَّ بِهِ عَلَى غِلْمَةٍ لِعَائِشَةَ ، فَسَرَقَ مِنْهُمْ جِرَابًا فِيهِ تَمْرٌ , وَرَكِبَ حِمَارًا لَهُمْ , فَأُتِيَ بِهِ ابْنُ عُمَرَ  فَبَعَثَ بِهِ إِلَى سَعِيدِ بْنِ الْعَاصِ وَهُوَ أَمِيرٌ عَلَى الْمَدِينَةِ ، فَقَالَ :سَمِعْتُ أَلا يُقْطَعَ آبِقًا , قَالَ : فَأَرْسَلَتْ إِلَيْهِ عَائِشَةُ : إِنَّمَا غِلْمَتِي غِلْمَتُكَ , وَإِنَّمَا جَاعَ وَرَكِبَ الْحِمَارَ يَتَبَلَّغُ عَلَيْهِ , فَلا تَقْطَعْهُ ، فَقَطَعَهُ ابْنُ عُمَرَ ""","","","","","The Book of the People of the Two Books"
"18367","عَنِ الثَّوْرِيِّ , وَمَعْمَرٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ مُجَاهِدٍ , عَنِ ابْنِ عَبَّاسٍ , أَنَّهُ كَانَ : لا يَرَى عَلَى عَبْدٍ آبِقٍ سَرَقَ قَطْعًا ""","","","","","The Book of the People of the Two Books"
"18368","عَنْ إِبْرَاهِيمَ , عَنْ صَالِحِ بْنِ كَيْسَانَ , قَالَ :  أُتِيَ ابْنُ الزُّبَيْرِبِعَبْدٍ سَارِقٍ ، فَقَطَعَ يَدَهُ ""","","","","","The Book of the People of the Two Books"
"18369","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , قَالَ : جِيءَ إِلَى مَرْوَانَ بِرَجُلٍ سَرَقَ شَاةً , فَإِذَا إِنْسَانٌ مَجْهُودٌ مَضْرُورٌ , فَقَالَ مَا أَرَى هَذَا أَخَذَهَا إِلا مِنْ ضَرُورَةِ , فَلَمْ يَقْطَعْهُ ""","","","","","The Book of the People of the Two Books"
"18370","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , قَالَ : قَالَ عُمَرُ : لا يُقْطَعُ فِي عِذْقٍ ، وَلا عَامِ السَّنَةِ ""","","","","","The Book of the People of the Two Books"
"18371","عَنْ مَعْمَرٍ , عَنْ أَبَانَ , أَنَّ رَجُلا جَاءَ إِلَى عُمَرَ بْنِ الْخَطَّابِ فِي نَاقَةٍ نُحِرَتْ , فَقَالَ لَهُ عُمَرُ : هَلْ لَكَ فِي نَاقَتَيْنِ بِهَا عِشَارِيَّتَيْنِ مُرْبِغَتَيْنِ سَمِينَتَيْنِ ؟ ، قَالَ : بِنَاقَتِكَ ، فَإِنَّا لا نَقْطَعُ فِي عَامِ السَّنَةِ ""، الْمُرْبِغَتَانِ : الْمُوطِيَتَانِ""","","","","","The Book of the People of the Two Books"
"18372","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ  كَانَمَنْ مَضَى يُجِيزُونَ اعْتِرَافَ الْعَبِيدِ عَلَى أَنْفُسِهِمْ , حَتَّى اتَّهَمَتِ الْقُضَاةُ الْعَبِيدَ أَنَّهُمْ إِنَّمَا يَفْعَلُونَ ذَلِكَ كَرَاهِيَةً لِسَادَاتِهِمْ , وَفِرَارًا مِنْهُمْ , فَاتَّهَمُوهُمْ فِي بَعْضِ الَّذِي يُشْكِلُ ""","","","","","The Book of the People of the Two Books"
"18373","عَنِ ابْنِ جُرَيْجٍ , قَالَ : كَانَ عَطَاءٌ , يَقُولُ : لا يَجُوزُ اعْتِرَافُ الْعَبْدِ عَلَى نَفْسِهِ ""","","","","","The Book of the People of the Two Books"
"18374","عَنِ ابْنِ جُرَيْجٍ , عَنْ سُلَيْمَانَ بْنِ مُوسَى , قَالَ : لا يَجُوزُ اعْتِرَافُ الْعَبِيدِ فِينَا , إِلا عَلَى الْحُدُودِ ""","","","","","The Book of the People of the Two Books"
"18375","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي زِيَادٌ , أَنَّهُ سَمِعَ ابْنَ شِهَابٍ , يَزْعُمُ أَنَّ ابْنَ عُمَرَ أَشَارَ عَلَى طَارِقٍ فِي عَبْدٍ اعْتَرَفَ عَلَى نَفْسِهِ ، قَالَ : إِذَا جَاءَ بِالْعَلامَةِ ، يَقُولُ : إِذَا صَدَّقَ نَفْسَهُ , فَأَقِمْ عَلَيْهِ الْحَدَّ ""، قَالَ ابْنُ جُرَيْجٍ : وَأَخْبَرَنِي عَبْدُ الْكَرِيمِ نَحْوًا مِنْ ذَلِكَ""","","","","","The Book of the People of the Two Books"
"18376","عَنِ الثَّوْرِيِّ ، عَنْ جَابِرٍ , قَالَ : سَأَلْتُ الشَّعْبِيَّ , عَنْ عَبْدٍ اعْتَرَفَ عَلَى نَفْسِهِ بِالسَّرِقَةِ , قَالَ : لا يَجُوزُ اعْتِرَافُهُ ""","","","","","The Book of the People of the Two Books"
"18377","عَنِ الثَّوْرِيِّ ، عَنْ عَبْدِ اللَّهِ بْنِ عِيسَى , وَجَابِرٍ , عَنِ الشَّعْبِيِّ , قَالَ : لا يَجُوزُ اعْتِرَافُ الصَّغِيرِ , وَلا الْمَمْلُوكِ فِي الْجِرَاحَةِ ""","","","","","The Book of the People of the Two Books"
"18378","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قَالَ : مَا اعْتَرَفَ الْعَبْدُ بِهِ مِنْ شَيْءٍ يُقَامُ عَلَيْهِ فِي جَسَدِهِ , فَإِنَّهُ لا يُتَّهَمُ فِي جَسَدِهِ , وَمَا اعْتَرَفَ بِهِ مِنْ شَيْءٍ يُخْرِجُهُ مِنْ مَوَالِيهِ , فَلا يَجُوزُ اعْتِرَافُهُ ""","","","","","The Book of the People of the Two Books"
"18379","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : لا يَجُوزُ اعْتِرَافُ الْعَبْدِ إِلا فِي سَرِقَةٍ أَوْ زِنًا ""","","","","","The Book of the People of the Two Books"
"18380","عَنِ الثَّوْرِيِّ , عَنْ أَبِي مَالِكٍ الأَشْجَعِيِّ ، عَنْ أَشْيَاخٍ لَهُمْ :  أَنَّ عَبْدًا لأَشْجَعَ يُقَالُ لَهُ : أَبُو جَمِيلَةَاعْتَرَفَ بِالزِّنَا عِنْدَ عَلِيٍّ أَرْبَعَ مَرَّاتٍ فَأَقَامَ عَلَيْهِ الْحَدَّ ""","","","","","The Book of the People of the Two Books"
"18381","أَخْبَرَنَا مَعْمَرٌ , عَنْ رَجُلٍ , عَنْ عِكْرِمَةَ , مَوْلَى ابْنِ عَبَّاسٍ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ فِي الْجِرَاحِ الَّتِي لَمْ يَقْضِ فِيهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَلا أَبُو بَكْرٍ , فَقَضَى فِي الْمُوضِحَةِ الَّتِي فِي جَسَدِ الإِنْسَانِ وَلَيْسَتْ فِي رَأْسِهِ , أَنَّ كُلَّ عَظْمٍ لَهُ نَذْرٌ مُسَمًّى , فَفِي مُوضِحَتِهِ نِصْفُ عُشْرِ نَذْرِهِ مَا كَانَتْ , فَإِذَا كَانَتِ الْمُوضِحَةُ فِي الْيَدِ فَنِصْفُ عُشْرِ نَذْرِهَا , مَا لَمْ تَكُنْ فِي الأَصَابِعِ , فَإِذَا كَانَتْ مُوضِحَةً فِي إِصْبَعٍ , فَفِيهَا نِصْفُ عُشْرِ نَذْرِ الإِصْبَعِ , فَمَا كَانَ فَوْقَ الأَصَابِعِ فِي الْكَفِّ , فَنَذْرُهَا مِثْلُ مُوضِحَةِ الذِّرَاعِ وَالْعُضُدِ , وَفِي الرِّجْلِ مِثْلُ مَا فِي الْيَدِ , وَمَا كَانَتْ مِنْ مَنْقُولَةٍ تَنْقُلُ عِظَامَهَا فِي الذِّرَاعِ , أَوِ الْعَضُدِ أَوِ السَّاقِ أَوِ الْفَخِذِ ، فَهِيَ نِصْفُ مَنْقُولَةِ الرَّأْسِ , وَقَضَى فِي الأَنَامِلِ فِي كُلِّ أُنْمُلَةٍ بِثَلاثِ قَلائِصَ , وَثُلُثِ قَلُوصٍ ، وَقَضَى فِي الظُّفُرِ إِذَا اعْوَرَّ وَفَسَدَ بِقَلُوصٍ ، وَقَضَى بِالدِّيَةِ عَلَى أَهْلِ الْقُرَى اثْنَيْ عَشَرَ أَلْفَ دِرْهَمٍ ، وَقَالَ : "" إِنِّي أَرَى الزَّمَانَ يَخْتَلِفُ , وَأَخْشَى عَلَيْكُمُ الْحُكَّامَ بَعْدِي , أَنْ يُصَابَ الرَّجُلُ الْمُسْلِمُ فَتَذْهَبَ دِيَتُهُ بَاطِلا , أَوْ تُرْفَعَ دِيَتُهُ بِغَيْرِ حَقٍّ , فَتُحْمَلَ عَلَى أَقْوَامٍ مُسْلِمِينَ فَتَجْتَاحَهُمْ , فَلَيْسَ عَلَى أَهْلِ الْعَيْنِ زِيَادَةٌ فِي تَغْلِيظِ عَقْلٍ فِي الشَّهْرِ الْحَرَامِ , وَلا فِي الْحُرْمَةِ , وَعَقَلُ أَهْلِ الْقُرَى تَغْلِيظٌ كُلُّهُ ، لا زِيَادَةَ فِيهِ عَلَى اثْنَيْ عَشَرَ أَلْفًا , وَقَضَى فِي الْمَرْأَةِ إِذَا غُلِبَتْ عَلَى نَفْسِهَا فَافْتُضَّتْ عُذْرَتِهَا بِثُلُثِ دِيَتِهَا , وَلا حَدَّ عَلَيْهَا , وَقَضَى فِي الْمَجُوسِ بِثَمَانِ مِائَةِ دِرْهَمٍ , وَقَالَ : إِنَّمَا هُوَ عَبْدٌ لَيْسَ مِنْ أَهْلِ الْكِتَابِ ، فَتَكُونَ دِيَتُهُ مِثْلَ دِيَتِهِمْ ""","","","","","The Book of the People of the Two Books"
"18382","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَمْرُو بْنُ شُعَيْبٍ ، قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنْمَاتَ الْوَلَدُ أَوِ الْوَالِدُ عَنْ مَالٍ أَوْ وَلاءٍ ، فَهُوَ لِوَرَثَتِهِ مَنْ كَانُوا , وَقَضَى أَنَّ الأَخَ لِلأَبِ وَالأُمَّ أَوْلَى الْكَلالَةِ بِالْمِيرَاثِ , ثُمَّ الأَخَ لِلأَبِ أَوْلَى مِنْ بَنِي الأَخِ لِلأَبِ وَالأُمِّ , فَإِذَا كَانُوا بَنُو الأَبِ وَالأُمِّ , وَبَنُو الأَبِ بِمَنْزِلَةٍ وَاحِدَةٍ , فَبَنُو الأَبِ وَالأُمِّ أَوْلَى مِنْ بَنِي الأَبِ , فَإِذَا كَانَ بَنُو الأَبِ أَرْفَعَ مِنْ بَنِي الأُمِّ وَالأَبِ بِأَبٍ ، فَبَنُو الأَبِ أَوْلَى , وَإِذَا اسْتَوَوْا فِي النَّسَبِ , فَبَنُو الأَبِ وَالأُمِّ أَوْلَى مِنْ بَنِي الأَبِ , وَقَضَى أَنَّ الْعَمَّ لِلأَبِ وَالأُمِّ أَوْلَى مِنَ الْعَمِّ لِلأَبِ , وَأَنَّ الْعَمَّ لِلأَبِ أَوْلَى مِنْ بَنِي الْعَمِّ لِلأَبِ وَالأُمِّ , فَإِذَا كَانُوا بَنُو الأَبِ وَالأُمِّ وَبَنُو الأَبِ بِمَنْزِلَةٍ وَاحِدَةٍ نَسَبًا وَاحِدًا فَبَنُو الأَبِ وَالأُمِّ أَوْلَى مِنْ بَنِي الأَبِ , فَإِذَا اسْتَوَوْا فِي النَّسَبِ , فَبَنُو الأَبِ وَالأُمِّ أَوْلَى مِنْ بَنِي الأَبِ , لا يَرِثُ عَمٌّ وَلا ابْنُ عَمٍّ , مَعَ أَخٍ وَابْنِ أَخِ , الأَخِ وَابْنُ الأَخِ مَا كَانَ مِنْهُمْ أَحَدٌ أَوْلَى بِالْمِيرَاثِ , مَا كَانُوا مِنَ الْعَمِّ وَابْنِ الْعَمِّ , وَقَضَى أَنَّهُ مَنْ كَانَتْ لَهُ عَصَبَةٌ , مِنَ الْمُحَرَّرِينَ , فَلَهُمْ مِيرَاثُهُمْ عَلَى فَرَائِضِهِمْ فِي كِتَابِ اللَّهِ , مَا لَمْ تَسْتَوْعِبْ فَرَائِضُهُمْ مَالَهُ كُلَّهُ , رُدَّ عَلَيْهِمْ مَا بَقِي مِنْ مِيرَاثِهِ عَلَى فَرَائِضِهِمْ , حَتَّى يَرِثُوا مَالَهُ كُلَّهُ , وَقَضَى أَنَّ الْكَافِرَ لا يَرِثُ الْمُسْلِمَ , وَإِنْ لَمْ يَكُنْ لَهُ وَارِثٌ غَيْرُهُ , وَأَنَّ الْمُسْلِمَ لا يَرِثُ الْكَافِرَ , مَا كَانَ لَهُ وَارِثٌ يَرِثُهُ أَوْ قَرَابَةٌ بِهِ , فَإِنْ لَمْ يَكُنْ لَهُ وَارِثٌ يَرِثُهُ أَوْ قَرَابَةٌ بِهِ وَرِثَهُ الْمُسْلِمُ بِالإِسْلامِ , وَقَضَى أَنَّ كُلَّ مَالْ قُسِمَ فِي الْجَاهِلِيَّةِ , فَهُوَ عَلَى قِسْمَةِ الْجَاهِلِيَّةِ , وَأَنَّ مَا أَدْرَكَ الإِسْلامُ وَلَمْ يُقْسَمْ فَهُوَ عَلَى قِسْمَةِ الإِسْلامِ","","","","","The Book of the People of the Two Books"
"18383","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ :  شَهِدْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَقْضِي بِالدَّيْنِ قَبْلَ الْوَصِيَّةِ ، وَأَنْتُمْ تَقْرَءُونَ :  مِنْ بَعْدِ وَصِيَّةٍ يُوصَى بِهَا أَوْ دَيْنٍ , وَأَنَّ أَعْيَانَ بَنِي الأُمِّ يَتَوَارَثُونَ دُونَ بَنِي الْعَلاتِ , الإِخْوَةِ لِلأَبِ وَالأُمِّ دُونَ الإِخْوَةِ لِلأُمِّ""","","","","","The Book of the People of the Two Books"
"18384","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : اقْسِمِ الْمَالَ بَيْنِ أَهْلِ الْفَرَائِضِ عَلَى كِتَابِ اللَّهِ , فَمَا تَرَكَتِ الْفَرَائِضُ فَلأَوْلَى رَجُلٍ ذَكَرٍ ""","","","","","The Book of the People of the Two Books"
"18385","أَخْبَرَنَا مَعْمَرٌ , عَنْ سِمَاكِ بْنِ الْفَضْلِ , عَنْ وَهْبِ بْنِ مُنَبِّهٍ , عَنِ الْحَكَمِ بْنِ مَسْعُودٍ الثَّقَفِيِّ , قَالَ : قَضَى عُمَرُ بْنُ الْخَطَّابِ فِي امْرَأَةٍ تُوُفِّيَتْ وَتَرَكَتْ زَوْجَهَا وَأُمَّهَا , وَإِخْوَتَهَا لأُمِّهَا ، وَإِخْوَتَهَا لأَبِيهَا وَأُمِّهَا , فَأَشْرَكَ عُمَرُ بَيْنَ الإِخْوَةِ لِلأُمِّ , وَالإِخْوَةِ لِلأَبِ وَالأُمِّ فِي الثُّلُثِ , فَقَالَ لَهُ رَجُلٌ : إِنَّكَ لَمْ تُشَرِّكْ بَيْنَهُمْ عَامَ كَذَا وَكَذَا , فَقَالَ عُمَرُ : تِلْكَ عَلَى مَا قَضَيْنَا يَوْمَئِذٍ , وَهَذِهِ عَلَى مَا قَضَيْنَا ""","","","","","The Book of the People of the Two Books"
"18386","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ , قَالَ : إِذَا لَمْ يَبْقَ إِلا الثُّلُثُ بَيْنَ الإِخْوَةِ مِنَ الأَبِ وَالأُمِّ , وَبَيْنَ الإِخْوَةِ مِنَ الأُمِّ , فَهُمْ فِيهِ شُرَكَاءُ ، لِلذَّكَرِ مِثْلُ حَظِّ الأُنْثَى ""","","","","","The Book of the People of the Two Books"
"18387","أَخْبَرَنَا معمر , عَنِ الزُّهْرِيِّ , ، وَقَتَادَةَ , قَالا :  فِيالثُّلُثِ الَّذِي يَكُونُ لِلإِخْوَةِ مِنَ الأُمِّ هُمْ فِيهِ سَوَاءٌ ، الذِّكْرُ وَالأُنْثَى ""، قَالَ مَعْمَرٌ : "" وَالنَّاسُ عَلَيْهِ ""","","","","","The Book of the People of the Two Books"
"18388","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , عَنْ أَبِيهِ ,  أَنَّهُ كَانَ يَقُولُ فِي امْرَأَةٍ تُوُفِّيَتْ , وَتَرَكَتْ زَوْجَهَا وَأُمَّهَا وَإِخْوَتَهَا مِنْ أُمِّهَا , وَأُخْتَهَا مِنْ أُمِّهَا وَأَبِيهَا : "" لأُمِّهَا السُّدُسُ , وَلِزَوْجِهَا الشَّطْرُ , وَالثُّلُثُ بَيْنَ الإِخْوَةِ مِنَ الأُمِّ وَالأُخْتِ مِنَ الأَبِ وَالأُمِّ "" وَأَنَّ عُمَرَ بْنَ الْخَطَّابِ كَانَ يَقُولُ : ""أَلْقُوا أَبَاهَا فِي الرِّيحِ , أَمَّا الأُخْتُ لِلأَبِ , وَالأُمِّ فَإِنَّهَا لا تَرِثُ بِهِ , وَإِنَّمَا وَرِثَتْ مَعَ الإِخْوَةِ , مِنْ أَجْلِ أَنَّهَا ابْنَةُ أُمِّهِمْ "" , قَالَ : "" فَإِنْ كَانَ مَعَ الإِخْوَةِ لِلأُمِّ أُخْتٌ لأَبٍ , فَلا شَيْءَ لَهَا "" قُلْتُ : فَكَيْفَ يَقْتَسِمُونَ الثُّلُثَ ؟ قَالَ : كَانَ ابْنُ عَبَّاسٍ ، يَقُولُ : "" لا أَجِدُ إِلا  لِلذَّكَرِ مِثْلُ حَظِّ الأُنْثَيَيْنِ ""قَالَ ابْنُ طَاوُسٍ : "" فَإِنْ كَانَ لَهُ إِخْوَةٌ فَلأُمِّهِ السُّدُسُ ""","","","","","The Book of the People of the Two Books"
"18389","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , وَالأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قَالَ : كَانَ عُمَرُ ، وَعَبْدُ اللَّهِ ، وَزَيْدٌ ، يَقُولُونَ :  فِيامْرَأَةٍ تَرَكَتْ زَوْجَهَا , وَأُمَّهَا , وَإِخْوَتَهَا لأُمِّهَا , وَإِخْوَتَهَا لأُمِّهَا وَأَبِيهَا , قَالُوا : لَمْ يَزِدْهُمْ أَبُوهُمْ إِلا قُرْبًا ""","","","","","The Book of the People of the Two Books"
"18390","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ :  أَنَّهُ كَانَلا يُوَرِّثُ الإِخْوَةَ لِلأَبِ وَالأُمِّ مَعَ هَذِهِ الْفَرِيضَةِ شَيْئًا ""، عَنِ الثَّوْرِيِّ , عَنْ سُلَيْمَانَ التَّيْمِيِّ , عَنْ أَبِي مِجْلَزٍ , قَالَ : "" كَانَ عَلِيٌّ لا يُشْرِكُهُمْ , وَكَانَ عُثْمَانُ يُشْرِكُهُمْ ""","","","","","The Book of the People of the Two Books"
"18391","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ مَعْبَدِ بْنِ خَالِدٍ , عَنْ مَسْرُوقٍ : فِي بِنْتَيْنِ وَبَنِي ابْنٍ ذُكُورًا وَإِنَاثًا , قَالَ مَسْرُوقٌ :  كَانَتْ عَائِشَةُتُشْرِكُ بَيْنَهُمْ "" ، ثُمَّ قَالَ : وَكَانَ ابْنُ مَسْعُودٍ , يَقُولُ : "" لِلذُّكْرَانِ دُونَ الإِنَاثِ , وَالأَخَوَاتُ بِمَنْزِلَةِ الْبَنَاتِ ""","","","","","The Book of the People of the Two Books"
"18392","أَخْبَرَنَا الثَّوْرِيُّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , عَنْ عَلْقَمَةَ , قَالَ : قَدِمَ مَسْرُوقٌ مِنَ الْمَدِينَةِ , فَقَالَ لَهُ عَلْقَمَةُ : هَلْ كَانَ أَحَدٌ مِنْ أَصْحَابِكَ أَثْبَتَ عِنْدَكَ مِنْ عَبْدِ اللَّهِ فِي هَذَا ؟ وَكَانَ عَبْدُ اللَّهِ لا يُشْرِكُ بَيْنَهُمْ , قَالَ : لا , وَلَكِنِّي لَقِيتُ زَيْدَ بْنَ ثَابِتٍ , وَأَهْلَ الْمَدِينَةِ وَهُمْ يُشْرِكُونَ بَيْنَهُمْ ""","","","","","The Book of the People of the Two Books"
"18393","أَخْبَرَنَا مَعْمَرٌ , وَالثَّوْرِيُّ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ ,  أَنَّ رَجُلا تُوُفِّيَ , وَتَرَكَ امْرَأَتَهُ وَأَبَوَيْهِ , فِي خِلافَةِ عُثْمَانَفَجَعَلَهَا عُثْمَانُ مِنْ أَرْبَعَةِ أَسْهُمٍ , أَعْطَى امْرَأَتَهُ سَهْمًا , وَأُمَّهُ ثُلُثَ الْفَضْلِ , وَأَبَاهُ مَا بَقِيَ ""","","","","","The Book of the People of the Two Books"
"18394","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ مَنْصُورٍ , وَالأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ عَبْدُ اللَّهِ : كَانَ عُمَرُ : إِذَا سَلَكَ طَرِيقًا فَتَبِعْنَاهُ فِيهِ , وَجَدْنَاهُ سَهْلا ، قَضَى فِي امْرَأَةٍ وَأَبَوَيْنِ , فَجَعَلَهَا مِنْ أَرْبَعَةٍ لامْرَأَتِهِ الرُّبُعُ , وَلِلأُمِّ ثُلُثُ مَا بَقِي , وَلِلأَبِ الْفَضْلُ ""، أَخْبَرَنَا الثَّوْرِيُّ , وَمَعْمَرٌ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , عَنْ أَبِي الْمُهَلَّبِ , أَنَّ عُثْمَانَ قَضَى بِمِثْلِ قَوْلِ عُمَرَ ، عَنِ الثَّوْرِيِّ , عَنْ عِيسَى , عَنِ الشَّعْبِيِّ , عَنْ زَيْدِ بْنِ ثَابِتٍ مِثْلَ ذَلِكَ""","","","","","The Book of the People of the Two Books"
"18395","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ أَبِي عَبْدِ اللَّهِ , عَنْ فُضَيْلِ بْنِ عَمْرٍو , عَنْ إِبْرَاهِيمَ , قَالَ : خَالَفَ ابْنُ عَبَّاسٍ أَهْلَ الصَّلاةِ فِي زَوْجٍ وَأَبَوَيْنِ , فَجَعَلَ النِّصْفَ لِلزَّوْجِ , وَلِلأُمِّ الثُّلُثَ مِنْ رَأْسِ الْمَالِ , وَلِلأَبِ مَا بَقِيَ ""","","","","","The Book of the People of the Two Books"
"18396","عَنِ الثَّوْرِيِّ , عَنْ أَبِيهِ , عَنِ الْمُسَيَّبِ بْنِ رَافِعٍ , عَنْ عَبْدِ اللَّهِ , قَالَ : مَا كَانَ اللَّهُ لِيَرَانِي أَنْ أُفَضِّلَ أُمًّا عَلَى أَبٍ ""","","","","","The Book of the People of the Two Books"
"18397","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ الأَصْبَهَانِيِّ , عَنْ عِكْرِمَةَ , قَالَ : أَرْسَلَنِي ابْنُ عَبَّاسٍ إِلَى زَيْدِ بْنِ ثَابِتٍ أَسْأَلُهُ عَنْ زَوْجٍ وَأَبَوَيْنِ , فَقَالَ : لِلزَّوْجِ النِّصْفُ , وَلِلأُمِّ ثُلُثُ مَا بَقِيَ , وَلِلأَبِ الْفَضْلُ "" , فَقَالَ ابْنُ عَبَّاسٍ : أَفِي كِتَابِ اللَّهِ وَجَدْتَهُ أَمْ رَأْيٌ تَرَاهُ ؟ ، قَالَ : "" بَلْ رَأْيٌ أُرَاهُ , لا أَرَى أَنْ أُفَضِّلَ أُمًّا عَلَى أَبٍ "" وَكَانَ ابْنُ عَبَّاسٍ : "" يَجْعَلُ لَهَا الثُّلُثَ مِنْ جَمِيعِ الْمَالِ ""","","","","","The Book of the People of the Two Books"
"18398","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيِّبِ , عَنْ زَيْدِ بْنِ ثَابِتٍ :  فِيزَوْجٍ وَأَبَوَيْنِ لِلزَّوْجِ النِّصْفُ , وَلِلأُمِّ ثُلُثُ مَا بَقِيَ , وَلِلأَبِ الْفَضْلُ ""","","","","","The Book of the People of the Two Books"
"18399","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ , قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : أَحْصَى اللَّهُ رَمْلَ عَالِجٍ , وَلَمْ يُحْصِ هَذَا , مَا بَالٌ فِي مَالٍ ثُلُثَانِ وَنِصْفٌ ""يَعْنِي : أَنَّ الْفَرِيضَةَ لا تُعَوَّلُ""","","","","","The Book of the People of the Two Books"
"18400","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : جَاءَ ابْنَ عَبَّاسٍ مَرَّةً رَجُلٌ , فَقَالَ : رَجُلٌ تُوُفِّيَ وَتَرَكَ بِنْتَهُ ، وَأُخْتَهُ لأَبِيهِ وَأُمِّهِ , فَقَالَ ابْنُ عَبَّاسٍ : لابْنَتِهِ النِّصْفُ , وَلَيْسَ لأُخْتِهِ شَيْءٌ ، مَا بَقِي هُوَ لِعَصَبَتِهِ ، فَقَالَ لَهُ الرَّجُلُ : إِنَّ عُمَرَ قَدْ قَضَى بِغَيْرِ ذَلِكَ ، قَدْ جَعَلَ لِلأُخْتِ النِّصْفَ , وَلِلْبِنْتِ النِّصْفَ ، فَقَالَ ابْنُ عَبَّاسٍ : أَنْتُمْ أَعْلَمُ أَمِ اللَّهُ ؟ ! ""، قَالَ مَعْمَرٌ : فَلَمْ أَدْرِ مَا قَوْلُهُ : أَنْتُمْ أَعْلَمُ أَمِ اللَّهُ , حَتَّى لَقِيتُ ابْنَ طَاوُسٍ ، فَذَكَرْتُ ذَلِكَ لَهُ ، فَقَالَ ابْنُ طَاوُسٍ : أَخْبَرَنِي أَبِي , أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ ، يَقُولُ : قَالَ اللَّهُ تَعَالَى :  إِنِ امْرُؤٌ هَلَكَ لَيْسَ لَهُ وَلَدٌ وَلَهُ أُخْتٌ فَلَهَا نِصْفُ مَا تَرَكَ قَالَ ابْنُ عَبَّاسٍ : "" فَقُلْتُمْ أَنْتُمْ لَهَا النِّصْفُ وَإِنْ كَانَ لَهُ وَلَدٌ ""","","","","","The Book of the People of the Two Books"
"18401","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , قَالَ : أَخْبَرَنِي أَبِي ، أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ , يَقُولُ : لَوَدِدْتُ أَنِّي وَهَؤُلاءِ الَّذِينَ يُخَالِفُونِي فِي الْفَرِيضَةِ , نَجْتَمِعُ فَنَضَعُ أَيْدِيَنَا عَلَى الرُّكْنِ , ثُمَّ نَبْتَهِلُ , فَنَجْعَلُ لَعْنَةَ اللَّهِ عَلَى الْكَاذِبِينَ ""","","","","","The Book of the People of the Two Books"
"18402","عَنِ الثَّوْرِيِّ , عَنِ الأَشْعَثِ بْنِ أَبِي الشَّعْثَاءِ , عَنِ الأَسْوَدِ بْنِ يَزِيدَ , أَنَّ مُعَاذَ بْنَ جَبَلٍ : قَضَى بِالْيَمَنِ فِي بِنْتٍ وَأُخْتٍ , فَجَعَلَ لِلْبِنْتِ النِّصْفَ , وَلِلأُخْتِ النِّصْفَ ""","","","","","The Book of the People of the Two Books"
"18403","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , أَنَّ مُعَاذًا قَضَى بِالْيَمَنِ فِي بِنْتٍ وَأُخْتٍ , فَجَعَلَ لِلْبِنْتِ النِّصْفَ , وَلِلأُخْتِ النِّصْفَ ""","","","","","The Book of the People of the Two Books"
"18404","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالَ : كَانَ ابْنُ عَبَّاسٍ ، يَقُولُ :  فِيالسُّدُسِ الَّذِي حَجَبَهُ الإِخْوَةُ لِلأُمِّ هُوَ لِلإِخْوَةِ , قَالَ : "" لا يَكُونُ لِلأَبِ ، إِنَّمَا تَقْبِضُهُ الأُمُّ لِيَكُونَ لِلإِخْوَةِ ""","","","","","The Book of the People of the Two Books"
"18405","قَالَ ابْنُ طَاوُسٍ : وَبَلَغَنِي أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَعْطَاهُمُ السُّدُسَ "" , قَالَ : فَلَقِيتُ بَعْضَ وَلَدِ ذَلِكَ الرَّجُلِ الَّذِي أُعْطِيَ إِخْوَتُهُ السُّدُسَ , فَقَالَ : بَلَغَنَا أَنَّهَا كَانَتْ وَصِيَّةً لَهُمْ ""","","","","","The Book of the People of the Two Books"
"18406","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : إِنَّمَا يَأْخُذُهُ الأَبُ ، لأَنَّهُ يُؤْخَذُ بِالنَّفَقَةِ عَلَيْهِمْ , وَلا تُؤْخَذُ الأُمُّ بِهِ ""","","","","","The Book of the People of the Two Books"
"18407","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالَ : كَانَ ابْنُ عَبَّاسٍ , يَقُولُ : السُّدُسُ الَّذِي حَجَزَتْهُ الأُمُّ لِلإِخْوَةِ "" قُلْتُ : فَالإِخْوَةُ مِنَ الأُمِّ ؟ قَالَ : "" مَا إِخَالُهُمْ إِلا إِيَّاهُمْ "" , قُلْتُ : أَمِثْلُهُمُ الإِخْوَةُ مِنَ الأَبِ ، وَمِنَ الأَبِ وَالأُمِّ ؟ قَالَ : "" فَمَهْ ! ""وَقَدْ كُنْتُ سَمِعْتُ مِنْ بَعْضِ أَشْيَاخِنَا عَنِ ابْنِ عَبَّاسٍ ذَلِكَ""","","","","","The Book of the People of the Two Books"
"18408","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , أَنَّ ابْنَ عَبَّاسٍ كَانَ يَقُولُ : الْمِيرَاثُ لِلْوَلَدِ , فَانْتَزَعَ اللَّهُ تَعَالَى مِنْهُ لِلزَّوْجِ وَالْوَالِدِ ""","","","","","The Book of the People of the Two Books"
"18409","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ أَبِي قَيْسٍ , عَنْ هُزَيْلِ بْنِ شُرَحْبِيلَ , عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : قَضَى فِي رَجُلٍ تَرَكَ ابْنَتَهُ , وَابْنَةَ ابْنِهِ ، وَأُخْتَهُ , فَجَعَلَ لِلابْنَةِ النِّصْفَ , وَلابْنَةِ الابْنِ السُّدُسَ , وَمَا بَقِيَ فَلِلأُخْتِ "", قَالَ الثَّوْرِيُّ : عَنْ أَبِي قَيْسٍ , عَنْ هُزَيْلٍ , قَالَ : جَاءَ رَجُلٌ إِلَى أَبِي مُوسَى الأَشْعَرِيِّ , وَسَلْمَانَ بْنِ رَبِيعَةَ الْبَاهِلِيِّ ، فَسَأَلَهُمَا عَنْهَا , فَقَالا : لِلْبِنْتِ النِّصْفُ , وَلِلأُخْتِ النِّصْفَ , وَلَيْسَ لِبِنْتِ الابْنِ شَيْءٌ ، وَإِيتِ ابْنَ مَسْعُودٍ فَإِنَّهُ سَيُتَابِعُنَا , قَالَ : فَجَاءَ الرَّجُلُ إِلَى عَبْدِ اللَّهِ فَأَخْبَرَهُ بِمَا قَالا , قَالَ : "" ضَلَلْتُ إِذًا وَمَا أَنَا مِنَ الْمُهْتَدِينَ , وَلَكِنْ سَأَقْضِي فِيهَا بِقَضَاءِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ "" ، ثُمَّ ذَكَرَ مِثْلَ الْحَدِيثِ الأَوَّلِ""","","","","","The Book of the People of the Two Books"
"18410","عَنِ الثَّوْرِيِّ , قَالَ : أَخْبَرَنِي الأَعْمَشُ , وَأَبُو سَهْلٍ , عَنِ الشَّعْبِيِّ , قَالَ :  إِذَا كَانَ بَنَاتٌ ، وَبَنَاتُ ابْنٍ ، وَابْنُ ابْنٍ نُظِرَ , فَإِنْ كَانَتِ الْمُقَاسَمَةُ أَكْثَرَ مِنَ السُّدُسِ أَعْطَاهُمُ السُّدُسَ , وَإِنْ كَانَ السُّدُسُ أَكْثَرَ مِنَ الْمُقَاسَمَةِ أَعْطَاهُنَّ الْمُقَاسَمَةَ "" وَكَانَ غَيْرُهُ : "" يُشْرِكُهُنَّ "" ، وَبَلَغَنَا عَنِ ابْنِ عَبَّاسٍ أَنَّهُ كَانَ يَقُولُ : ""الْفَرَائِضُ لا نُعِيلُهَا عَنْ سِتَّةِ أَسْهُمٍ ""، ذَكَرَهُ عَطَاءٌ , عَنِ ابْنِ عَبَّاسٍ , وَبَلَغَنَا عَنْ عَلِيٍّ أَنَّهُ أُتِيَ فِي امْرَأَةٍ وَأَبَوَيْنِ وَبَنَاتٍ ، فَقَالَ لِلْمَرْأَةِ : "" أَرَى ثُمْنَكِ قَدْ صَارَ تُسْعًا ""","","","","","The Book of the People of the Two Books"
"18411","أَخْبَرَنَا هِشَامُ بْنُ حَسَّانَ , عَنْ مُحَمَّدِ بْنِ سِيرِينَ , عَنْ شُرَيْحٍ :  فِيزَوْجٍ ، وَأُمٍّ ، وَأَخَوَاتٍ لأَبٍ وَأُمٍّ , وَإِخْوَةِ لأُمٍّ ، أَنَّهُ جَعَلَهَا مِنْ عَشَرَةٍ ""","","","","","The Book of the People of the Two Books"
"18412","عَنِ الثَّوْرِيِّ , قَالَ : كَانَ ابْنُ عَبَّاسٍ يَقُولُ : لا تُعَوَّلُ الْفَرَائِضُ , تُعَوَّلُ الْمَرْأَةُ , وَالزَّوْجُ, وَالأَبُ , وَالأُمُّ "" يَقُولُ : "" هَؤُلاءِ لا يَنْقُصُونَ , إِنَّمَا النُّقْصَانُ فِي الْبَنَاتِ وَالْبَنِينَ , وَالإِخْوَةِ وَالأَخَوَاتِ ""","","","","","The Book of the People of the Two Books"
"18413","أَخْبَرَنَا الثَّوْرِيُّ , قَالَ : لا يَرِثُ مِنَ النِّسَاءِ إِلا سِتٌّ : ابْنَةٌ , وَابْنَةُ ابْنٍ , وَأُمٌّ , وَامْرَأَةٌ , وَجَدَّةٌ , وَأُخْتُ , وَأَدْنَى الْعَصَبَةِ الابْنُ , ثُمَّ ابْنُ الابْنِ , ثُمَّ الأَبُ , ثُمَّ الْجَدُّ , ثُمَّ الأَخُ , ثُمَّ ابْنُ الأَخِ , ثُمَّ الْعَمُّ , ثُمَّ ابْنُ الْعَمِّ , ثُمَّ بَنُو الْعَمِّ ، الأَقْرَبِ فَالأَقْرَبِ , قَالَ : وَجَدُّ الْجَدِّ بِمَنْزِلَةِ الْجَدِّ , إِذَا لَمْ يَكُنْ دُونَهُ أَبٌ , بِمَنْزِلَةِ ابْنِ الابْنِ ""","","","","","The Book of the People of the Two Books"
"18414","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لابْنِ طَاوُسٍ :  تَرَكَ أَبَاهُ وَأُمَّهُ ، وَابْنَتَهُ كَيْفَ ؟ ، قَالَ :"" لابْنَتِهِ النِّصْفُ لا يُزَادُ , وَالسُّدُسُ لِلأَبِ , وَالسُّدُسُ لِلأُمِّ , ثُمَّ السُّدُسُ الآخَرُ لِلأَبِ "" , قُلْتُ : فَإِنْ تَرَكَ أُمَّهُ ، وَابْنَتَهُ ، فَلابْنَتِهِ النِّصْفُ ، وَلأُمِّهِ الثُّلُثُ ؟ ، قَالَ : "" نَعَمْ ، لا يُزَادُ الْبِنْتُ عَلَى النِّصْفِ "" ، ثُمَّ أَخْبَرَنِي عَنْ أَبِيهِ أَنَّهُ قَالَ : "" أَلْحِقُوا الْمَالَ بِالْفَرَائِضِ , فَمَا تَرَكَتِ الْفَرَائِضُ مِنْ فَضْلٍ فَلأَدْنَى رَجُلٍ ذَكَرٍ "" قُلْتُ : قَوْلُهُ : "" أَلْحِقُوا الْمَالَ بِالْفَرَائِضِ "" الَّتِي ذُكِرَتْ فِي الْقُرْآنِ ؟ قَالَ : "" نَعَمْ ""","","","","","The Book of the People of the Two Books"
"18415","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ ابْنَ طَاوُسٍ , عَنْ بِنْتٍ , وَأُخْتٍ , فَقَالَ كَانَ أَبِي يَذْكُرُ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ رَجُلٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهَا شَيْئًا , وَكَانَ طَاوُسٌ لا يَرْضَى بِذَلِكَ الرَّجُلِ , قَالَ :  كَانَ أَبِييُمْسِكُ فِيهَا , فَلا يَقُولُ فِيهَا شَيْئًا , وَقَدْ كَانَ يُسْأَلُ عَنْهَا ""","","","","","The Book of the People of the Two Books"
"18416","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ عَبْدِ اللَّهِ بْنِ عُتْبَةَ , قَالَ : أَخْبَرَنِي الضَّحَّاكُ بْنُ قَيْسٍ : إِذْ كَانَ بِالشَّامِ طَاعُونٌ فَكَانَتِ الْقَبِيلَةُ تَمُوتُ بِأَسْرِهَا , حَتَّى تَرِثَهَا الْقَبِيلَةُ الأُخْرَى , فَكَتَبَ فِيهِمْ إِلَى عُمَرَ بْنِ الْخَطَّابِ ، فَكَتَبَ : إِذَا كَانَ بَنُو الأَبِ سَوَاءً , فَبَنُو الأُمِّ أَوْلَى , وَإِذَا كَانَ بَنُو الأَبِ أَقْرَبَ بِأَبٍ , فَهُمْ أَوْلَى مِنْ بَنِي الأَبِ وَالأُمِّ ""","","","","","The Book of the People of the Two Books"
"18417","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنِ الأَسْوَدِ , أَنَّ مُعَاذًا قَضَى بِالْيَمَنِ فِي ابْنَةٍ وَأُخْتٍ , فَجَعَلَ لِلابْنَةِ النِّصْفَ , وَلِلأُخْتِ النِّصْفَ ""","","","","","The Book of the People of the Two Books"
"18418","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنِ الشَّعْبِيِّ , قَالَ عُمَرُ أَوَّلُ جَدٍّ وَرِثَ فِي الإِسْلامِ ""","","","","","The Book of the People of the Two Books"
"18419","عَنِ ابْنِ التَّيْمِيِّ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , قَالَ : سَمِعْتُ الشَّعْبِيَّ , يَقُولُ : خُذْ مِنْ شَأْنِ الْجَدِّ بِمَا اجْتَمَعَ عَلَيْهِ النَّاسُ ""","","","","","The Book of the People of the Two Books"
"18420","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ عَبِيدَةَ السَّلْمَانِيِّ , قَالَ : سَأَلْتُهُ عَنْ فَرِيضَةٍ فِيهَا جَدٌّ , فَقَالَ :  لَقَدْحَفِظْتُ مِنْ عُمَرَ بْنِ الْخَطَّابِ فِيهَا مِائَةُ قَضِيَّةٍ مُخْتَلِفَةٍ ""، قَالَ : قُلْتُ : عَنْ عُمَرَ ؟ قَالَ : عَنْ معُمَرَ ، عَنْ هِشَامِ بْنِ حَسَّانَ , عَنْ عَبِيدَةَ , مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18421","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , أَنَّ عُمَرَ , قَالَ :  إِنِّي قَدْقَضَيْتُ فِي الْجَدِّ قَضِيَّاتٍ مُخْتَلِفَةً , لَمْ آلُ فِيهَا عَنِ الْحَقِّ ""","","","","","The Book of the People of the Two Books"
"18422","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , أَنَّ عُمَرَ , قَالَ : أُشْهِدُكُمْ أَنِّي لَمْ أَقْضِ فِي الْجَدِّ قَضَاءً ""","","","","","The Book of the People of the Two Books"
"18423","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , قَالَ : قَالَ ابْنُ عُمَرَ أَجْرَأُكُمْ عَلَى جَرَاثِيمَ جَهَنَّمَ , أَجْرَأُكُمْ عَلَى الْجَدِّ ""","","","","","The Book of the People of the Two Books"
"18424","عَنْ مَعْمَرٍ , قَالَ : أَخْبَرَنِي أَيُّوبُ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , عَنْ رَجُلٍ مِنْ مُرَادٍ , قَالَ : سَمِعْتُ عَلِيًّا , يَقُولُ : مَنْ سَرَّهُ أَنْ يَتَقَحَّمَ جَرَاثِيمَ جَهَنَّمَ , فَلْيَقْضِ بَيْنَ الْجَدِّ وَالإِخْوَةِ ""","","","","","The Book of the People of the Two Books"
"18425","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ مِنْ أَبِي يُحَدِّثُ , أَنَّ ابْنَ الزُّبَيْرِ كَتَبَ إِلَى أَهْلِ الْعِرَاقِ أَنَّ الَّذِي قَالَ لَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لَوْ كُنْتُ مُتَّخِذًا خَلِيلا حَتَّى أَلْقَى اللَّهُ سِوَى اللَّهُ لاتَّخَذْتُ أَبَا بَكْرٍ خَلِيلا كَانَ يَجْعَلُ الْجَدَّ أَبًا ""","","","","","The Book of the People of the Two Books"
"18426","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , وَقَتَادَةَ , أَنَّ أَبَا بَكْرٍجَعَلَ الْجَدَّ أَبًا ، قَالَ مَعْمَرٌ : "" وَكَانَ قَتَادَةُ يُفْتِي بِهِ "" ، قَالَ مَعْمَرٌ : وَلا أَعْلَمُ الزُّهْرِيَّ إِلا أَخْبَرَنِي أَنَّ : "" عُثْمَانَ كَانَ يَجْعَلُ الْجَدَّ أَبًا ""","","","","","The Book of the People of the Two Books"
"18427","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ , أَنَّ عُرْوَةَ حَدَّثَهُ , عَنْ مَرْوَانَ ,  أَنَّ عُمَرَ حِينَطُعِنَ اسْتَشَارَهُمْ فِي الْجَدِّ "" , فَقَالَ لَهُ عُثْمَانُ : "" إِنْ نَتَّبِعْ رَأْيَكَ فَإِنَّ رَأْيَكَ رُشْدٌ , وَإِنْ نَتَّبِعْ رَأْيَ الشَّيْخِ قَبْلَكَ , فَنِعْمَ ذُو الرَّأْيِ كَانَ""","","","","","The Book of the People of the Two Books"
"18428","أَخْبَرَنَا مَعْمَرٌ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , أَنَّ عُمَرَ , قَالَ :  إِنِّي كُنْتُقَضَيْتُ فِي الْجَدِّ قَضَاءً , فَإِنْ شِئْتُمْ أَنْ تَأْخُذُوا بِهِ فَافْعَلُوا "" ، فَقَالَ عُثْمَانُ : "" إِنْ نَتَّبِعْ رَأْيَكَ فَإِنَّ رَأْيَكَ رُشْدٌ , وَإِنْ نَتَّبِعْ رَأْيَ الشَّيْخِ قَبْلَكَ , فَنِعْمَ ذُو الرَّأْيِ كَانَ ""","","","","","The Book of the People of the Two Books"
"18429","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرٍو , عَنْ عَطَاءٍ , عَنِ ابْنِ عَبَّاسٍ :  أَنَّهُ كَانَيَرَى الْجَدَّ أَبًا ، وَيَتْلُو هَذِهِ الآيَةَ :  مِلَّةَ آبَائِي إِبْرَاهِيمَ وَإِسْحَاقَ ، قَالَ : وَقَالَ ابْنُ عَبَّاسٍ : "" لَوْ عَلِمَتِ الْجِنُّ أَنَّهُ يَكُونُ فِي الإِنْسِ جَدٌّ مَا قَالُوا :  تَعَالَى جَدُّ رَبِّنَا ""","","","","","The Book of the People of the Two Books"
"18430","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , أَنَّ ابْنَ عَبَّاسٍ :  كَانَيَجْعَلُ الْجَدَّ أَبًا ""، قَالَ ابْنُ جُرَيْجٍ , وَأَخْبَرَنِي ابْنُ طَاوُسٍ , عَنْ أَبِيهِ , عَنِ ابْنِ عَبَّاسٍ , مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18431","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , عَنِ ابْنِ عَبَّاسٍ :  أَنَّهُ كَانَيَجْعَلُ الْجَدَّ أَبًا ""","","","","","The Book of the People of the Two Books"
"18432","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , أَنَّ عَلِيًّا :  كَانَيَجْعَلُ الْجَدَّ أَبًا ""، فَأَنْكَرَ قَوْلَ عَطَاءٍ ذَلِكَ , عَنْ عَلِيٍّ بَعْضُ أَهْلِ الْعِرَاقِ""","","","","","The Book of the People of the Two Books"
"18433","عَنِ الثَّوْرِيِّ , عَنْ عِيسَى , عَنِ الشَّعْبِيِّ , قَالَ : كَانَ عُمَرُ كَرِهَ الْكَلامَ فِي الْجَدِّ حَتَّى صَارَ جَدًّا ، فَقَالَ لَهُ : كَانَ مِنْ رَأْيِي , وَرَأْيِ أَبِي بَكْرٍ L4945 :  أَنَّالْجَدَّ أَوْلَى مِنَ الأَخِ , وَأَنَّهُ لا بُدَّ مِنَ الْكَلامِ فِيهِ , فَخَطَبَ النَّاسَ , ثُمَّ سَأَلَهُمْ هَلْ سَمِعْتُمْ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهِ شَيْئًا ؟ فَقَامَ رَجُلٌ فَقَالَ : رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" أَعْطَاهُ الثُّلُثَ "" , قَالَ : مَنْ مَعَهُ ؟ قَالَ : لا أَدْرِي , قَالَ : ثُمَّ خَطَبَ النَّاسَ أَيْضًا , فَقَالَ رَجُلٌ : "" شَهِدْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَعْطَاهُ السُّدُسَ "" , قَالَ : مَنْ مَعَهُ ؟ قَالَ : لا أَدْرِي ، فَسَأَلَ عَنْهَا زَيْدَ بْنَ ثَابِتٍ , فَضَرَبَ لَهُ مَثَلَ شَجَرَةٍ خَرَجَتْ لَهَا أَغْصَانٌ , قَالَ : فَذَكَرَ شَيْئًا لا أَحْفَظُهُ , "" فَجَعَلَ لَهُ الثُّلُثَ "", قَالَ الثَّوْرِيُّ : وَبَلَغَنِي أَنَّهُ قَالَ لَهُ : "" يَا أَمِيرَ الْمُؤْمِنِينَ ! شَجَرَةٌ نَبَتَتْ فَانْشَعَبَ مِنْهَا غُصْنٌ , فَانْشَعَبَ مِنَ الْغُصْنِ غُصْنَانِ , فَمَا جَعَلَ الْغُصْنَ الأَوَّلَ أَوْلَى مِنَ الْغُصْنِ الثَّانِي ؟ وَقَدْ خَرَجَ الْغُصْنَانِ مِنَ الْغُصْنِ الأَوَّلِ "" قَالَ : ثُمَّ سَأَلَ عَلِيًّا ، فَضَرَبَ لَهُ مَثَلَ وَادٍ سَالَ فِيهِ سَيْلٌ , فَجَعَلَهُ أَخًا فِيمَا بَيْنَهُ وَبَيْنَ سِتَّةٍ , "" فَأَعْطَاهُ السُّدُسَ "" , وَبَلَغَنِي عَنْهُ أَنَّ عَلِيًّا حِينَ سَأَلَهُ عُمَرُ جَعَلَ لَهُ سَيْلا سَالَ , وَانْشَعَبَتْ مِنْهُ شُعْبَةٌ , ثُمَّ انْشَعَبَتْ شُعْبَتَانِ , فَقَالَ : "" أَرَأَيْتَ لَوْ أَنَّ مَاءَ هَذِهِ الشُّعْبَةِ الْوُسْطَى يَبِسَ أَكَانَ يَرْجِعُ إِلَى الشُّعْبَتَيْنِ جَمِيعًا ؟ "" ، قَالَ الشَّعْبِيُّ : فَكَانَ زَيْدٌ يَجْعَلُهُ أَخًا حَتَّى يَبْلُغَ ثَلاثَةً هُوَ ثَالِثُهُمْ , فَإِنْ زَادُوا عَلَى ذَلِكَ أَعْطَاهُ الثُّلُثَ ، وَكَانَ عَلِيٌّ يَجْعَلُهُ أَخًا مَا بَيْنَهُ وَبَيْنَ سِتَّةٍ هُوَ سَادِسُهُمْ , يُعْطِيهِ السُّدُسَ , فَإِنْ زَادُوا عَلَى سِتَّةٍ أَعْطَاهُ السُّدُسَ , وَصَارَ مَا بَقِيَ بَيْنَهُمْ""","","","","","The Book of the People of the Two Books"
"18434","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , قَالَ : دَعَا عُمَرُ بْنُ الْخَطَّابِ عَلِيَّ بْنَ أَبِي طَالِبٍ , وَزَيْدَ بْنَ ثَابِتٍ , وَعَبْدَ اللَّهِ بْنَ عَبَّاسٍ :  فَسَأَلَهُمْعَنِ الْجَدِّ , فَقَالَ عَلِيٌّ "" لَهُ الثُّلُثُ عَلَى كُلِّ حَالٍ "" ، وَقَالَ زَيْدٌ : "" لَهُ الثُّلُثُ مَعَ الإِخْوَةِ , وَلَهُ السُّدُسُ مِنْ جَمِيعِ الْفَرِيضَةِ , وَيُقَاسِمُ مَا كَانَتِ الْمُقَاسَمَةُ خَيْرًا لَهُ "" , وَقَالَ ابْنُ عَبَّاسٍ : "" هُوَ أَبٌ ، فَلَيْسَ لِلإِخْوَةِ مَعَهُ مِيرَاثٌ "" وَقَدْ قَالَ اللَّهُ تَعَالَى :  مِلَّةَ أَبِيكُمْ إِبْرَاهِيمَ وَبَيْنَنَا وَبَيْنَهُ آبَاءٌ , قَالَ : "" فَأَخَذَ عُمَرُ بِقَوْلِ زَيْدٍ ""","","","","","The Book of the People of the Two Books"
"18435","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , قَالَ :  إِنَّمَا هَذِهِفَرَائِضُ عُمَرَ , وَلَكِنَّ زَيْدًا أَثَارَهَا بَعْدَهُ , وَفَشَتْ عَنْهُ ""","","","","","The Book of the People of the Two Books"
"18436","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : كَانَ عُمَرُ بْنُ الْخَطَّابِ يُشْرِكُ بَيْنَ الْجَدِّ وَالأَخِ إِذَا لَمْ يَكُنْ غَيْرُهُمَا , وَيَجْعَلُ لَهُ الثُّلُثَ مَعَ الأَخَوَيْنِ , وَمَا كَانَتِ الْمُقَاسَمَةُ خَيْرًا لَهُ قَاسَمَ ، وَلا يُنْقِصُ مِنَ السُّدُسِ فِي جَمِيعِ الْمَالِ "" قَالَ : "" ثُمَّ أَثَارَهَا زَيْدٌ بَعْدَهُ ، وَفَشَتْ عَنْهُ ""","","","","","The Book of the People of the Two Books"
"18437","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ , أَنَّهُ قَرَأَ كِتَابًا مِنْ مُعَاوِيَةَ إِلَى زَيْدِ بْنِ ثَابِتٍ  يَسْأَلُهُ عَنِ الْجَدِّ وَالأَخِ ، فَكَتَبَ إِلَيْهِ يَقُولُ : اللَّهُ أَعْلَمُ ، وَحَضَرْتُ الْخَلِيفَتَيْنِ قَبْلَكَ ، يُرِيدُ عُمَرَ ، وَعُثْمَانَ ،"" يَقْضِيَانِ لِلْجَدِّ مَعَ الأَخِ الْوَاحِدِ النِّصْفَ , وَمَعَ الاثْنَيْنِ الثُّلُثَ , فَإِذَا كَانُوا أَكْثَرَ مِنْ ذَلِكَ , لَمْ يُنْقِصْ مِنَ الثُّلُثِ شَيْئًا ""","","","","","The Book of the People of the Two Books"
"18438","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قَالَ : كَانَ زَيْدُ بْنُ ثَابِتٍ يُشْرِكُ الْجَدَّ مَعَ الإِخْوَةِ , وَالأَخَوَاتِ إِلَى الثُّلُثِ , فَإِذَا بَلَغَ الثُّلُثَ أَعْطَاهُ الثُّلُثَ , وَكَانَ لِلإِخْوَةِ وَالأَخَوَاتِ مَا بَقِيَ , وَيُقَاسِمُ بِالأَخِ لِلأَبِ , ثُمَّ يَرُدُّ عَلَى أَخِيهِ ، وَلا يُوَرِّثُ أَخًا لأُمٍّ مَعَ جَدٍّ شَيْئًا , وَيُقَاسِمُ بِالإِخْوَةِ مِنَ الأَبِ , الأَخَوَاتِ مِنَ الأَبِ وَالأُمِّ , وَلا يُوَرِّثُهُمْ شَيْئًا , وَإِذَا كَانَ أَخٌ لِلأَبِ وَالأُمِّ أَعْطَاهُ النِّصْفَ , وَإِذَا كَانَ أَخَوَاتٌ وَجَدٌّ , أَعْطَاهُ مَعَ الأَخَوَاتِ الثُّلُثَ , وَلَهُنَّ الثُّلُثَانِ , فَإِنْ كَانَتَا أُخْتَيْنِ , أَعْطَاهُمَا النِّصْفَ وَلَهُ النِّصْفَ ""","","","","","The Book of the People of the Two Books"
"18439","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قَالَ : كَانَ عَلِيٌّ يُشْرِكُ الْجَدَّ إِلَى سِتَّةٍ مَعَ الإِخْوَةِ , وَيُعْطِي كُلَّ صَاحِبِ فَرِيضَةٍ فَرِيضَتَهُ , وَلا يُوَرِّثُ أَخًا لِلأُمِّ مَعَ الْجَدِّ , وَلا أُخْتًا لِلأُمِّ , وَلا يُقَاسِمُ بِالأَخِ لِلأَبِ مَعَ الأَخِ لِلأُمِّ وَالأَبِ وَالْجَدِّ , وَلا يَزِيدُ الْجَدَّ مَعَ الْوَلَدِ عَلَى السُّدُسِ , إِلا أَنْ يَكُونَ مَعَهُ غَيْرُهُ أَخٌ وَأُخْتٌ , وَإِذَا كَانَتْ أُخْتٌ لأَبٍ وَأُمٍّ , وَجَدٌّ وَأَخٌ لأَبٍ ، أَعْطَى الأُخْتَ النِّصْفَ , وَمَا بَقِيَ أَعْطَاهُ الْجَدَّ وَالأَخَ بَيْنَهُمَا نِصْفَيْنِ , فَإِنْ كَثُرَ الإِخْوَةُ شَرَكَهُ مَعَهُمْ حَتَّى يَكُونَ السُّدُسُ , خَيْرًا لَهُ مِنَ الْمُقَاسَمَةِ , فَإِذَا كَانَ السُّدُسُ خَيْرًا لَهُ أَعْطَاهُ السُّدُسَ ""","","","","","The Book of the People of the Two Books"
"18440","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , أَنَّ ابْنَ مَسْعُودٍ شَرَكَ الْجَدَّ إِلَى ثَلاثَةِ إِخْوَةٍ , فَإِذَا كَانُوا أَكْثَرَ مِنْ ذَلِكَ أَعْطَاهُ الثُّلُثَ , فَإِنْ كُنَّ أَخَوَاتٍ أَعْطَاهُنَّ الْفَرِيضَةَ , وَمَا بَقِيَ فَلِلْجَدِّ , وَكَانَ لا يُوَرِّثُ أَخًا لأُمٍّ , وَلا أُخْتًا لأُمٍّ مَعَ الْجَدِّ , وَكَانَ يَقُولُ : "" لا يُقَاسِمُ أَخٌ لأَبٍ , أُخْتًا لأَبٍ وَأُمٍّ مَعَ جَدٍّ , وَكَانَ يَقُولُ فِي أُخْتٍ لأَبٍ وَأُمٍّ , وَأَخٍ لأَبٍ ، وَجَدٍّ : لِلأُخْتِ لِلأَبِ وَالأُمِّ النِّصْفُ , وَمَا بَقِيَ فَلِلْجَدِّ , وَلَيْسَ لِلأَخِ لِلأَبِ شَيْءٌ ""","","","","","The Book of the People of the Two Books"
"18441","عَنِ ابْنِ عُيَيْنَةَ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , عَنِ الشَّعْبِيِّ , قَالَ :  لَمْ يَكُنْ أَحَدٌ مِنْ أَصْحَابِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَجْعَلُ بَنِي الأَخِ بِمَنْزِلَةِ أَبِيهِمْ , إِلا عَلِيٌّ , وَلَمْ يَكُنْ أَحَدٌ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَفْقَهَ أَصْحَابًا مِنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ ""","","","","","The Book of the People of the Two Books"
"18442","عَنِ الثَّوْرِيِّ , قَالَ : لَمْ يَكُنْ أَحَدٌ يُوَرِّثُ ابْنَ أَخٍ مَعَ جَدِّهِ ""","","","","","The Book of the People of the Two Books"
"18443","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قَالَ :  كَانَ عُمَرُ ، وَابْنُ مَسْعُودٍ :لا يُفَضِّلانِ أُمًّا عَلَى جَدٍّ ""","","","","","The Book of the People of the Two Books"
"18444","عَنْ رَجُلٍ , عَنِ الشَّعْبِيِّ , قَالَ : اخْتَلَفَ عَلِيٌّ , وَابْنُ مَسْعُودٍ , وَزَيْدُ بْنُ ثَابِتٍ , وَعُثْمَانُ , وَابْنُ عَبَّاسٍفِي جَدٍّ ، وَأُمٍّ ، وَأُخْتٍ لأَبٍ وَأُمٍّ , فَقَالَ عَلِيٌّ :  لِلأُخْتِ النِّصْفُ , وَلِلأُمِّ الثُّلُثُ , وَلِلْجَدِّ السُّدُسُ "" ، وَقَالَ ابْنُ مَسْعُودٍ : "" لِلأُخْتِ النِّصْفُ , وَلِلأُمِّ السُّدُسُ , وَلِلْجَدِّ الثُّلُثُ "" , وَقَالَ عُثْمَانُ : "" لِلأُمِّ الثُّلُثُ , وَلِلأُخْتِ الثُّلُثُ , وَلِلْجَدِّ الثُّلُثُ "" ، وَقَالَ زَيْدٌ : "" هِيَ عَلَى تِسْعَةِ أَسْهُمٍ , لِلأُمِّ الثُّلُثُ , وَمَا بَقِي فَثُلُثَانِ لِلْجَدِّ , وَالثُّلُثُ لِلأُخْتِ "" , وَقَالَ ابْنُ عَبَّاسٍ : "" لِلأُمِّ الثُّلُثُ , وَمَا بَقِي فَلِلْجَدِّ , وَلَيْسَ لِلأُخْتِ شَيْءٌ ""، عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الْوَاحِدِ , عَنْ إِسْمَاعِيلَ , عَنْ رَجَاءٍ , عَنْ إِبْرَاهِيمَ , مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18445","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ أَبِي إِسْحَاقَ , قَالَ : أَتَيْتُ شُرَيْحًا فَسَأَلْتُهُ عَنْ أُمٍّ , وَأَخٍ , وَجَدٍّ , وَزَوْجٍ , فَقَالَ لِلزَّوْجِ الشَّطْرُ , وَلِلأُمِّ الثُّلُثُ "" , قَالَ : ثُمَّ سَكَتَ ، فَعَاوَدْتُهُ , فَقَالَ : "" لِلْبَعْلِ الشَّطْرُ , وَلِلأُمِّ الثُّلُثُ "" , قَالَ : ثُمَّ سَكَتَ ، فَعَاوَدْتُهُ , فَقَالَ : "" لِلْبَعْلِ الشَّطْرُ , وَلِلأُمِّ الثُّلُثُ "", قَالَ : فَقَالَ الَّذِي يَقُومُ عَلَى رَأْسِهِ : إِنَّهُ لا يَقُولُ فِي الْجَدِّ شَيْئًا ، قَالَ : "" فَأَتَيْتُ عُبَيْدَةَ السَّلْمَانِيَّ فَفَرَضَهَا عَلَى سِتَّةٍ : لِلزَّوْجِ النِّصْفُ , وَلِلأُمِّ سَهْمٌ , وَلِلأَخِ سَهْمٌ , وَلِلْجَدِّ سَهْمٌ "" ، قَالَ الثَّوْرِيُّ : وَبَلَغَنِي أَنَّهُ قَالَ : "" هَكَذَا قَسَمَهَا ابْنُ مَسْعُودٍ ""","","","","","The Book of the People of the Two Books"
"18446","أَخْبَرَنَا الثَّوْرِيُّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , عَنْ مَسْرُوقٍ , عَنْ عَبْدِ اللَّهِ , أَنَّهُ قَالَ :  فِيجَدٍّ , وَبِنْتٍ , وَأُخْتٍ فَرِيضَتُهُمْ مِنْ أَرْبَعَةٍ : لِلْبِنْتِ سَهْمَانِ , وَلِلْجَدِّ سَهْمٌ , وَلِلأُخْتِ سَهْمٌ , وَإِنْ كَانَتْ أُخْتَانِ جَعَلَهَا مِنْ ثَمَانِيَةٍ : لِلْبِنْتِ النِّصْفُ أَرْبَعَةً , وَلِلْجَدِّ سَهْمَانِ , وَلِلأُخْتَيْنِ لِكُلِّ وَاحِدَةٍ مِنْهُمَا سَهْمٌ , فَإِنْ كُنَّ ثَلاثَ أَخَوَاتٍ جَعَلَهَا مِنْ عَشَرَةِ أَسْهُمٍ : لِلْبِنْتِ النِّصْفُ خَمْسَةُ أَسْهُمٍ , وَلِلْجَدِّ سَهْمَانِ , وَلِلأَخَوَاتِ ثَلاثَةُ أَسْهُمٍ ، لِكُلِّ وَاحِدَةٍ مِنْهُنَّ سَهْمٌ ""","","","","","The Book of the People of the Two Books"
"18447","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , أَنَّ عُمَرَ قَضَى فِي جَدٍّ , وَأُمٍّ , وَأُخْتٍ , فَجَعَلَ لِلأُخْتِ النِّصْفَ , وَلِلأُمِّ سَهْمًا , وَلِلْجَدِّ سَهْمَيْنِ ، لَمْ يُفَضِّلْ أُمًّا عَلَى جَدٍّ ""","","","","","The Book of the People of the Two Books"
"18448","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , أَنَّ عَبْدَ اللَّهِ ، قَالَ : فِي أُمٍّ , وَأُخْتٍ , وَزَوْجٍ , وَجَدٍّ هِيَ مِنْ ثَمَانِيَةٍ : لِلأُخْتِ النِّصْفُ ثَلاثَةً , وَلِلزَّوْجِ النِّصْفُ ثَلاثَةً , وَلِلأُمِّ سَهْمٌ , وَلِلْجَدِّ سَهْمٌ "" ، وَقَالَ عَلِيٌّ : "" هِيَ مِنْ تِسْعَةٍ : لِلزَّوْجِ ثَلاثَةٌ , وَلِلأُخْتِ ثَلاثَةٌ , وَلِلأُمِّ سَهْمَانِ , وَلِلْجَدِّ سَهْمٌ "" ، وَقَالَ زَيْدٌ : "" هِيَ مِنْ سَبْعَةٍ وَعِشْرِينَ ، وَهِيَ الأَكْدَرِيَّةُ ، وَيَعْنِي : أُمَّ الْفُرُّوجِ ، جَعَلَهَا مِنْ تِسْعَةِ أَسْهُمٍ , ثُمَّ ضَرَبَهَا فِي ثَلاثَةٍ , فَصَارَتْ سَبْعَةً وَعِشْرِينَ : فَلِلزَّوْجِ تِسْعَةٌ , وَلِلأُمِّ سِتَّةٌ , وَلِلْجَدِّ ثَمَانِيَةٌ , وَلِلأُخْتِ أَرْبَعَةٌ ""","","","","","The Book of the People of the Two Books"
"18449","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , قَالَ : قَالَ عَبْدُ اللَّهِ :  فِيامْرَأَةٍ , وَأُمٍّ , وَأَخٍ , وَجَدٍ هِيَ مِنْ أَرْبَعَةٍ : لِكُلِّ إِنْسَانٍ مِنْهُمْ سَهْمٌ ""، وَقَالَ غَيْرُ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , عَنْ عَبْدِ اللَّهِ , قَالَ : "" هِيَ مِنْ أَرْبَعَةٍ وَعِشْرِينَ : لِلأُمِّ السُّدُسُ أَرْبَعَةً , وَللمَرْأةِ الرُّبُعُ سِتَّةً , وَمَا بَقِي بَيْنَ الْجَدِّ وَالأَخِ سَبْعَةً ""","","","","","The Book of the People of the Two Books"
"18450","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ ، عَنْ إِبْرَاهِيمَ , أَنَّ عَبْدَ اللَّهِ كَانَ يَقُولُ :  فِيجَدٍّ , وَأُخْتٍ لأَبٍ , وَأُمٍّ , وَأَخَوَيْنِ لِلأَبِ : لِلأُخْتِ النِّصْفُ , وَمَا بَقِي لِلْجَدِّ , وَلَيْسَ لِلأَخَوَيْنِ شَيْءٌ ""","","","","","The Book of the People of the Two Books"
"18451","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قَالَ : لَمْ يَكُنْ أَحَدٌ مِنْ أَصْحَابِ مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُوَرِّثُ أَخًا لأُمٍّ مَعَ جَدٍّ ""","","","","","The Book of the People of the Two Books"
"18452","عَنِ الثَّوْرِيِّ , قَالَ :  إِذَا كَانَجَدٌّ , وَأُخْتٌ فَهِيَ مِنْ ثَلاثَةٍ : لِلْجَدِّ اثْنَانِ , وَلِلأُخْتِ وَاحِدٌ , فَإِنْ كُنَّ ثَلاثَ أَخَوَاتٍ وَجَدٍ ، فَهِيَ عَلَى خَمْسَةٍ , فَإِذَا كُنَّ أَرْبَعًا وَجَدًّا ، فَهِيَ عَلَى سِتَّةٍ , فَإِذَا كُنَّ خَمْسًا , فَاضْرِبْ ثَلاثَةً فِي خَمْسَةٍ , فَتَكُونُ عَلَى خَمْسَةَ عَشَرَ , فَإِذَا كَانَ الثُّلُثُ خَيْرًا لِلْجَدِّ , فَاضْرِبِ الثُّلُثَ فِي نِصْفٍ , ثُمَّ تَأْخُذُ الثُّلُثَ مِنْ جَمِيعِ الْمَالِ , فَتَدْفَعُهُ إِلَى الْجَدِّ , وَمَا بَقِيَ عَلَى قَدْرِ سِهَامِهِمْ , فَإِذَا لُحِقَتْ أُمٌّ مَعَ أُخْتٍ وَجَدٍّ فَهِيَ مِنْ تِسْعَةٍ , لِلأُمِّ الثُّلُثُ , وَبَقِيَ سِتَّةٌ ، فَلِلْجَدِّ أَرْبَعَةٌ ، وَاثْنَانِ لِلأُخْتِ , فَإِنْ لُحِقَتْ أُخْرَى , فَهِيَ مِنْ سِتَّةٍ , ثُمَّ ضُرِبَتْ سِتَّةٌ فِي أَرْبَعَةٍ فَذَلِكَ أَرْبَعَةٌ وَعِشْرُونَ , لِلأُمِّ السُّدُسُ أَرْبَعَةً , وَلِلْجَدِّ عَشَرَةٌ , وَلِلأُخْتَيْنِ عَشَرَةٌ , فَإِذَا كُنَّ ثَلاثَ أَخَوَاتٍ وَجَدًّا , فَهِيَ مِنْ سِتَّةٍ , فَالسُّدُسُ لِلأُمِّ , وَيَبْقَى خَمْسَةٌ , بَيْنَهُنَّ ثَلاثَةُ أَخْمَاسٍ لِلأَخَوَاتِ , وَخُمُسَانِ لِلْجَدِّ , فَإِنْ كُنَّ أَرْبَعَ أَخَوَاتٍ وَجَدًّا , صَارَتِ الْمُقَاسَمَةُ وَالثُّلُثُ سَوَاءً , فَهِيَ مِنْ ثَمَانِيَةَ عَشَرَ , لِلأُمِّ ثَلاثَةٌ هُوَ السُّدُسُ , وَلِلْجَدِّ ثُلُثُ مَا بَقِيَ خَمْسَةً , وَعَشَرَةٌ بَيْنَ الأَخَوَاتِ , وَمَا كَثُرَ مِنَ الأَخَوَاتِ فَهِيَ عَلَى ثَمَانِيَةَ عَشَرَ , يُدْفَعُ السُّدُسُ إِلَى الأُمِّ , وَثُلُثُ مَا بَقِيَ لِلْجَدِّ , فَإِنِ اسْتَقَامَ , فَمَا بَقِيَ لِلأَخَوَاتِ , وَإِلا ضُرِبَ جَمِيعًا فِي الأَخَوَاتِ ""","","","","","The Book of the People of the Two Books"
"18453","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قَالَ : حُدِّثْتُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَطْعَمَ ثَلاثَ جَدَّاتٍ السُّدُسَ ""، قَالَ : قُلْتُ لإِبْرَاهِيمَ : مَا هُنَّ ؟ قَالَ : "" جَدَّتَا أَبِيهِ ، أُمُّ أُمِّهِ ، وَأُمُّ أَبِيهِ ، وَجَدَّتُهُ أُمُّ أُمِّهِ ""","","","","","The Book of the People of the Two Books"
"18454","أَخْبَرَنَا معمر , عَنْ قَتَادَةَ , قَالَ :  إِذَا كُنَّالْجَدَّاتُ أَرْبَعًا , طُرِحَتْ أُمُّ أَبِي الأُمِّ , وَوَرِثْنَ السُّدُسَ أَثْلاثًا بَيْنَهُنَّ ""","","","","","The Book of the People of the Two Books"
"18455","عَنِ الثَّوْرِيِّ ، عَنْ أَشْعَثَ , عَنِ الشَّعْبِيِّ , قَالَ : جِئْنَ أَرْبَعُ جَدَّاتٍ إِلَى مَسْرُوقٍ ، فَوَرَّثَ ثَلاثًا , وَألْغَى جَدَّةَ أُمِّ أَبِي الأُمِّ ""","","","","","The Book of the People of the Two Books"
"18456","أَخْبَرَنَا معمر , عَنِ الزُّهْرِيِّ , قَالَ : لا يَرِثُ الْجَدُّ أَبُو الأُمِّ شَيْئًا ""","","","","","The Book of the People of the Two Books"
"18457","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ قَبِيصَةَ بْنِ ذُؤَيْبٍ , قَالَ : جَاءَتِ الْجَدَّةُ إِلَى أَبِي بَكْرٍ تَطْلُبُ مِيرَاثَهَا مِنَ ابْنِ ابْنِهَا ، أَوِ ابْنِ ابْنَتِهَا ، لا أَدْرِي أَيَّتُهُمَا هِيَ , فَقَالَ أَبُو بَكْرٍ :  لا أَجِدُ لَكَ فِي الْكِتَابِ شَيْئًا ، وَمَا سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْضِي لَكَ بِشَيْءٍ , وَسَأَسْأَلُ النَّاسَ الْعَشِيَّةَ , فَلَمَّا صَلَّى الظُّهْرَ , أَقْبَلَ عَلَى النَّاسِ , فَقَالَ : إِنَّالْجَدَّةَ أَتَتْنِي تَسْأَلُنِي مِيرَاثَهَا مِنَ ابْنِ ابْنِهَا ، أَوِ ابْنِ ابْنَتِهَا , وَإِنِّي لَمْ أَجِدْ لَهَا فِي الْكِتَابِ شَيْئًا , وَلَمْ أَسْمَعِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْضِي لَهَا بِشَيْءٍ , فَهَلْ سَمِعَ أَحَدٌ مِنْكُمْ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهَا شَيْئًا ؟ فَقَامَ الْمُغِيرَةُ ابْنُ شُعْبَةَ , فَقَالَ : "" شَهِدْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْضِي لَهَا بِالسُّدُسِ "" , فَقَالَ : هَلْ سَمِعَ ذَلِكَ مَعَكَ أَحَدٌ ؟ فَقَامَ مُحَمَّدُ بْنُ مَسْلَمَةَ ، فَقَالَ : "" شَهِدْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقْضِي لَهَا بِالسُّدُسِ "" فَأَعْطَاهَا أَبُو بَكْرٍ السُّدُسَ , فَلَمَّا كَانَتْ خِلافَةُ عُمَرَ جَاءَتْهُ الْجَدَّةُ الَّتِي تُخَالِفُهَا ، فَقَالَ عُمَرُ : "" إِنَّمَا كَانَ الْقَضَاءُ فِي غَيْرِكِ ، وَلَكِنْ إِذَا اجْتَمَعْتُمَا فَالسُّدُسُ بَيْنَكُمَا ، وَأَيَّتُكُمَا خَلَتْ بِهِ فَهُوَ لَهَا ""","","","","","The Book of the People of the Two Books"
"18458","عَنِ ابْنِ عُيَيْنَةَ , عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ , قَالَ : جَاءَتْ جَدَّاتٌ إِلَى أَبِي بَكْرٍ فَأَعْطَى الْمِيرَاثَ أُمَّ الأُمِّ دُونَ أُمِّ الأَبِ "" , فَقَالَ لَهُ رَجُلٌ مِنَ الأَنْصَارِ مِنْ بَنِي حَارِثَةَ يُقَالُ لَهُ : عَبْدُ الرَّحْمَنِ بْنُ سَهْلٍ : يَا خَلِيفَةَ رَسُولِ اللَّهِ ! قَدْ أَعْطَيْتَ الْمِيرَاثَ الَّتِي لَوْ أَنَّهَا مَاتَتْ لَمْ يَرِثْهَا , "" فَجَعَلَ الْمِيرَاثَ بَيْنَهُمَا ""","","","","","The Book of the People of the Two Books"
"18459","أَخْبَرَنَا الثَّوْرِيُّ ، عَنِ ابْنِ ذَكْوَانَ , عَنْ خَارِجَةَ بْنِ زَيْدٍ , قَالَ :  إِذَا كَانَتِالْجَدَّةُ مِنْ قِبَلِ الأُمِّ هِيَ أَقْعَدُ , فَأَعْطِهَا السُّدُسَ ، وَإِذَا كَانَتِ الْجَدَّةُ مِنْ قِبَلِ الأُمِّ هِيَ أَقْعَدُ , فَشَرِّكْ بَيْنَهُمَا ""","","","","","The Book of the People of the Two Books"
"18460","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ أَبِي الزِّنَادِ , قَالَ : أَدْرَكْتُ خَارِجَةَ بْنَ زَيْدٍ , وَطَلْحَةَ بْنَ عَبْدِ اللَّهِ بْنِ عَوْفٍ , وَسُلَيْمَانَ بْنَ يَسَارٍ , يَقُولُونَ :  إِذَا كَانَتِالْجَدَّةُ مِنْ قِبَلِ الأُمِّ هِيَ أَقْرَبُ فَهِيَ أَحَقُّ بِهِ , وَإِذَا كَانَتْ أَبْعَدَ فَهُمَا سَوَاءٌ ""، أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيِّبِ , أَنَّ زَيْدَ بْنَ ثَابِتٍ , كَانَ يَقُولُ ذَلِكَ ، عَنِ الثَّوْرِيِّ , عَنْ فِطْرٍ , عَنْ شَيْخٍ , عَنْ زَيْدِ بْنِ ثَابِتٍ , مِثْلَ ذَلِكَ""","","","","","The Book of the People of the Two Books"
"18461","عَنْ مَعْمَرٍ , عَنِ الْحَجَّاجِ بْنِ أَرْطَاةَ , عَنِ الشَّعْبِيِّ , قَالَ : كَانَ زَيْدٌ : يَقْضِي لِلْجَدَّتَيْنِ أَيَّتُهُمَا كَانَتْ أَقْرَبَ فَهِيَ أَوْلَى "" ، وَكَانَ ابْنُ مَسْعُودٍ : "" يُسَاوِي بَيْنَهُنَّ كَانَتْ أَقْرَبَ أَوْ لَمْ تَكُنْ أَقْرَبَ ""","","","","","The Book of the People of the Two Books"
"18462","عَنِ الثَّوْرِيِّ , عَنْ أَشْعَثَ , وَأَبِي سَهْلٍ , عَنِ الشَّعْبِيِّ , قَالَ : كَانَ عَلِيٌّ ، وَزَيْدُ بْنُ ثَابِتٍ لا يُوَرِّثَانِ الْجَدَّةَ مَعَ ابْنِهَا , وَيُوَرِّثَانِ الْقُرْبَى مِنَ الْجَدَّاتِ مِنْ قِبَلِ الأَبِ , أَوْ مِنْ قِبَلِ الأُمِّ "" ، قَالَ : "" وَكَانَ عَبْدُ اللَّهِ يُوَرِّثُ الْجَدَّةَ مَعَ ابْنِهَا , وَمَا قَرُبَ مِنَ الْجَدَّاتِ , وَمَا بَعُدَ مِنْهُنَّ جَعَلَ لَهُنَّ السُّدُسَ إِذَا كُنَّ مِنْ مَكَانَيْنِ شَتَّى , وَإِذَا كُنَّ مِنْ مَكَانٍ وَاحِدٍ وَرَّثَ الْقُرْبَى ""","","","","","The Book of the People of the Two Books"
"18463","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , أَنَّ عُثْمَانَ لَمْ يُوَرَّثِ الْجَدَّةَ إِنْ كَانَ ابْنُهَا حَيًّا ، وَالنَّاسُ عَلَيْهِ ""","","","","","The Book of the People of the Two Books"
"18464","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , وَالأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ عَبْدُ اللَّهِ : لا يَحْجُبُ الْجَدَّاتِ إِلا الأُمُّ ""","","","","","The Book of the People of the Two Books"
"18465","عَنِ الثَّوْرِيِّ , عَنْ أَشْعَثَ , عَنِ ابْنِ سِيرِينَ , قَالَ : أَوَّلُ جَدَّةٍ أَطْعَمَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أُمُّ أَبٍ مَعَ ابْنِهَا ""","","","","","The Book of the People of the Two Books"
"18466","أَخْبَرَنَا ابْنُ جُرَيْجٍ , وَالثَّوْرِيُّ , وَابْنُ عُيَيْنَةَ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , قَالَ : سَمِعْتُ سَعِيدَ بْنَ الْمُسَيِّبِ , يَقُولُ : وَرَّثَ عُمَرُ بْنُ الْخَطَّابِ جَدَّةً مَعَ ابْنِهَا ""، قَالَ ابْنُ جُرَيْجٍ , وَابْنُ عُيَيْنَةَ : "" امْرَأَةً مِنْ ثَقِيفٍ إِحْدَى بَنِي نَضْلَةَ ""","","","","","The Book of the People of the Two Books"
"18467","أَخْبَرَنَا هِشَامُ بْنُ حَسَّانَ , عَنْ أَنَسِ بْنِ سِيرِينَ , أَنَّ شُرَيْحًا :  كَانَيُوَرِّثُ الْجَدَّةَ مَعَ ابْنِهَا وَهُوَ حَيٌّ ""","","","","","The Book of the People of the Two Books"
"18468","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ أَبِي الشَّعْثَاءِ , قَالَ : تَرِثُ الْجَدَّةُ مَعَ ابْنِهَا ""","","","","","The Book of the People of the Two Books"
"18469","أَخْبَرَنَا مَعْمَرٌ , عَنْ بِلالِ بْنِ أَبِي بُرْدَةَ , أَنَّ أَبَا مُوسَى الأَشْعَرِيَّ :  كَانَيُوَرِّثُ الْجَدَّةَ مَعَ ابْنِهَا وَقَضَى بِذَلِكَ بِلالٌ , وَهُوَ أَمِيرٌ عَلَى الْبَصْرَةِ ""","","","","","The Book of the People of the Two Books"
"18470","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ شِهَابٍ , قَالَ : أَوَّلُ مَنْ وَرَّثَ الْجَدَّتَيْنِ عُمَرُ بْنُ الْخَطَّابِ ، فَجَمَعَ بَيْنَهُمَا ""","","","","","The Book of the People of the Two Books"
"18471","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيِّبِ , قَالَ : كَانَ زَيْدُ بْنُ ثَابِتٍ : لا يُوَرِّثُ الْجَدَّةَ أُمَّ الأَبِ وَابْنُهَا حَيٌّ ""","","","","","The Book of the People of the Two Books"
"18472","عَنْ مَعْمَرٍ , عَنْ رَجُلٍ مِنْ وَلَدِ أَبِي بُرْدَةَ , عَنْ أَبِي بُرْدَةَ ، أَنَّ أَبَا مُوسَى الأَشْعَرِيَّ : وَرَّثَهَا وَابْنَهَا حَيٌّ ، وَقَضَى بِذَلِكَ بِلالٌ فِي وِلايَتِهِ عَلَى الْبَصْرَةِ ""","","","","","The Book of the People of the Two Books"
"18473","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ شُرَيْح :  أَنَّهُوَرَّثَهَا مَعَ ابْنِهَا ""","","","","","The Book of the People of the Two Books"
"18474","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , وَالأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ عَبْدُ اللَّهِ :الإِخْوَةُ الْمَمْلُوكُونَ وَالنَّصَارَى يَحْجُبُونَ الأُمَّ , وَلا يَرِثُونَ ، قَالَ الثَّوْرِيُّ فِي هَذَا الْحَدِيثِ , عَنِ الأَعْمَشِ , عَنِ إِبْرَاهِيمَ : "" وَإِنَّمَا تَحْجُبُ الْمَرْأَةُ ، وَالزَّوْجُ ، وَالأُمُّ , وَلا يَحْجُبُ غَيْرُهُمْ ""","","","","","The Book of the People of the Two Books"
"18475","عَنِ الثَّوْرِيِّ , عَنْ أَبِي سَهْلٍ , عَنِ الشَّعْبِيِّ , أَنَّ عَلِيًّا ، وَزَيْدًا , قَالا : لا يَحْجُبُونَ وَلا يَرِثُونَ ""، قَالَ الثَّوْرِيُّ : "" وَالْقَاتِلُ عِنْدَنَا بِتِلْكَ الْمَنْزِلَةِ لا يَحْجُبُ وَلا يَرِثُ ""","","","","","The Book of the People of the Two Books"
"18476","عَنِ الثَّوْرِيِّ , قَالَ : أَخْبَرَنِي رَجُلٌ , عَنِ ابْنِ سِيرِينَ , عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : لا يَحْجُبُ مَنْ لا يَرِثُ ""","","","","","The Book of the People of the Two Books"
"18477","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ عُرْوَةَ , عَنْ أَبِيهِ  أَنَّهُ سَأَلَهُ عَنْرَجُلٍ تُوُفِّيَ , وَتَرَكَ أَمَةً مَمْلُوكَةً , وَجَدَّتَهُ أُمَّ أُمِّهِ حُرَّةً ، هَلْ تَرِثُهُ ؟ قَالَ : "" نَعَمْ ، تَرِثُهُ ""","","","","","The Book of the People of the Two Books"
"18478","عَنِ ابْنِ عُيَيْنَةَ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , عَنْ أَبِي عَمْرٍو الشَّيْبَانِيِّ  أَنَّ مَوْلًى لِقَوْمٍ مَاتَ , وَلَمْ يَتْرُكْ إِلا ابْنَ أَخٍ لَهُ , وَأَخُوهُ مَمْلُوكٌ , وَقَدْ كَانَقَضَى شُرَيْحٍ بِالْمِيرَاثِ لِلْمَوَالِي , فَقِيلَ لأَخِيهِ "" هَلْ لَكَ مِنْ وَلَدٍ ؟ "" , قَالَ : نَعَمِ ، ابْنٌ حُرٌّ ، فَأَتَى شُرَيْحًا : "" فَرَدَّ عَلَيْهِ الْمِيرَاثَ ""","","","","","The Book of the People of the Two Books"
"18479","أَخْبَرَنَا معمر , عَنْ قَتَادَةَ , قَالَ : لا يَحْجُبُ الْقَاتِلُ , وَلا يَرِثُ , قَالَ : وَالْعَبْدُ , وَالْيَهُودِيُّ , وَالنَّصْرَانِيُّ بِتِلْكَ الْمَنْزِلَةِ ""","","","","","The Book of the People of the Two Books"
"18480","عَنِ الثَّوْرِيِّ , عَنْ سَلَمَةَ بْنِ كُهَيْلٍ , عَنْ أَبِي صَادِقٍ ، عَنْ عَلِيٍّ , قَالَ : لا يَحْجُبُ مَنْ لا يَرِثُ ""","","","","","The Book of the People of the Two Books"
"18481","عَنْ مَعْمَرٍ , عَنْ زَيْدِ بْنِ أَسْلَمَ , قَالَ : جَاءَ رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : يَا رَسُولَ اللَّهِ ! رَجُلٌ تُوُفِّيَ وَتَرَكَ خَالَتَهُ , وَعَمَّتَهُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : الْخَالَةُ وَالْعَمَّةُ ! "" يُرَدِّدُهُمَا , كَذَلِكَ يَنْتَظِرُ الْوَحْيَ فِيهِمَا , فَلَمْ يَأْتِهِ فِيهِمَا شَيْءٌ "" فَعَاوَدَ الرَّجُلُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعْدَ ذَلِكَ ، وَعَادَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمِثْلِ قَوْلِهِ ثَلاثَ مَرَّاتٍ ، فَلَمْ يَأْتِهِ فِيهِمَا شَيْءٌ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" لَمْ يَأْتِنِي فِيهِمَا شَيْءٌ ""","","","","","The Book of the People of the Two Books"
"18482","أَخْبَرَنَا معمر , عَنِ الزُّهْرِيِّ , قَالَ : الْعَمَّةُ وَالْخَالَةُ لا تَرِثَانِ شَيْئًا ""","","","","","The Book of the People of the Two Books"
"18483","عَنْ إِبْرَاهِيمَ بْنِ أَبِي يَحْيَى , عَنْ صَفْوَانَ بْنِ سُلَيْمٍ , أَنَّ رَجُلا جَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ :  يَا رَسُولَ اللَّهِرَجُلٌ تَرَكَ خَالَتَهُ وَعَمَّتَهُ ، فَلَمْ يَنْزِلْ عَلَيْهِ فِي ذَلِكَ شَيْءٌ , فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" لَيْسَ لَهُمَا شَيْءٌ ""","","","","","The Book of the People of the Two Books"
"18484","أَخْبَرَنَا الثَّوْرِيُّ , عَنِ الْحَسَنِ بْنِ عَمْرٍو الْفُقَيْمِيِّ , عَنْ غَالِبِ بْنِ عَبَّادٍ ، عَنْ قَيْسِ بْنِ حَبْتَرٍ النَّهْشَلِيِّ ، قَالَ : كَتَبَ عَبْدُ الْمَلِكِ بْنُ مَرْوَانَ يَسْأَلُ عَنْ عَمَّةٍ , وَخَالَةٍ , فَقَالَ شَيْخٌ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ جَعَلَ لِلْعَمَّةِ الثُّلُثَيْنِ , وَلِلْخَالَةِ الثُّلُثَ ""فَهَمَّ عَبْدُ الْمَلِكِ أَنْ يَكْتُبَ بِهَا , ثُمَّ قَالَ : فَأَيْنَ زَيْدُ بْنُ ثَابِتٍ ؟""","","","","","The Book of the People of the Two Books"
"18485","عَنِ الثَّوْرِيِّ , عَنْ يُونُسَ , عَنِ الْحَسَنِ , أَنَّ عُمَرَ : قَضَى فِي عَمَّةٍ وَخَالَةٍ , جَعَلَ لِلْعَمَّةِ الثُّلُثَانِ , وَلِلْخَالَةِ الثُّلُثَ ""","","","","","The Book of the People of the Two Books"
"18486","أَخْبَرَنَا مَعْمَرٌ , عَنْ حَفْصِ بْنِ سُلَيْمَانَ , وَغَيْرِهِ , عَنِ الْحَسَنِ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ : وَرَّثَ الْعَمَّةَ وَالْخَالَةَ , جَعَلَ لِلْعَمَّةِ الثُّلُثَيْنِ , وَلِلْخَالَةِ الثُّلُثَ ""","","","","","The Book of the People of the Two Books"
"18487","عَنِ الثَّوْرِيِّ , عَنْ مُحَمَّدِ بْنِ سَالِمٍ , عَنِ الشَّعْبِيِّ ، عَنِ ابْنِ مَسْعُودٍ , قَالَ : الْعَمَّةُ مَنْزِلَةِ الأَبِ , وَالْخَالَةُ بِمَنْزِلَةِ الأُمِّ , وَبِنْتُ الأَخِ بِمَنْزِلَةِ الأَخِ , وَكُلُّ ذِي رَحِمٍ يَنْزِلُ بِمَنْزِلَةِ رَحِمِهِ , الَّتِي يَرِثُ بِهَا إِذَا لَمْ يَكُنْ وَارِثٌ ذُو قَرَابَةٍ ""","","","","","The Book of the People of the Two Books"
"18488","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ , عَنِ الشَّعْبِيِّ ، عَنْ مَسْرُوقٍ , قَالَ : أَنْزِلُوهُمْ بِمَنْزِلَةِ آبَائِهِمْ ""","","","","","The Book of the People of the Two Books"
"18489","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَبْدُ الْكَرِيمِ بْنُ أَبِي الْمُخَارِقِ ، فِي رَجُلٍ تَرَكَ عَمَّتَهُ وَخَالَتَهُ لِعَمَّتِهِ ثُلُثَا مَالِهِ , وَلِخَالَتِهِ الثُّلُثُ ، قُلْتُ لِعَبْدِ الْكَرِيمِ : فَأَمٌّ مَعَهُمَا , قَالَ :  يَرَوْنَ وَأَنَا أَنَّ الأُمَّ أَحَقُّ "" , قُلْتُ لِعَبْدِ الْكَرِيمِ : فَابْنُهُ مَعَ الْخَالَةِ وَالْعَمَّةِ ؟ ، فَقَالَ : "" يَرَوْنَ وَأَنَا أَنَّ الْبِنْتَ لَهَا الْمَالُ كُلُّهُ دُونَهُمَا "" , قُلْتُ لِعَبْدِ الْكَرِيمِ : فَابْنَةُ بِنْتِ عَمَّةٍ وَخَالَةٌ ؟ قَالَ : "" لِبِنْتِ بِنْتِ الْعَمَّةِ الثُّلُثَانِ ، وَلِلْخَالَةِ الثُّلُثُ "" ، قَالَ : وَيَقُولُونَ عَنِ ابْنِ مَسْعُودٍ : "" أَنَّهُقَضَى فِي أُمٍّ , وَأَخٍ مِنْ أُمٍّ : لأَخِيهِ السُّدُسَ , وَمَا بَقِيَ لأُمِّهِ ""","","","","","The Book of the People of the Two Books"
"18490","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ :  فِيرَجُلٍ تَرَكَ ابْنَتَهُ , وَعَمَّتَهُ , وَخَالَتَهُ , قَالَ "" لابْنَتِهِ الْمَالُ كُلُّهُ ""","","","","","The Book of the People of the Two Books"
"18491","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالَ : إِذَا تَرَكَ الرَّجُلُ أُخْتَهُ لأُمِّهِ , وَهَذَا الضَّرْبُ مَعَ الْخَالَةِ وَالْعَمَّةِ , فَالْمَالُ كُلُّهُ لأُخْتِهِ لأُمِّهِ ""","","","","","The Book of the People of the Two Books"
"18492","عَنِ الثَّوْرِيِّ , عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ , عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ , عَنْ عَمِّهِ وَاسِعِ بْنِ حَبَّانَ , قَالَ : تُوُفِّيَ ثَابِتُ بْنُ الدَّحْدَاحَةِ وَكَانَ رَجُلا أَتِيًا فِي بَنِي أُنَيفٍ أَوْ فِي بَنِي الْعَجْلانِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : هَلْ لَهُ مِنْ وَارِثٍ ؟ "" , فَلَمْ يَجِدُوا لَهُ وَارِثًا , قَالَ : فَدَفَعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِيرَاثَهُ إِلَى ابْنِ أُخْتِهِ أَبِي لُبَابَةَ بْنِ عَبْدِ الْمُنْذِرِ ""","","","","","The Book of the People of the Two Books"
"18493","عَنْ إِبْرَاهِيمَ بْنِ أَبِي يَحْيَى , عَنْ صَالِحِ بْنِ كَيْسَانَ , عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ , قَالَ : مَاتَ ابْنُ الدَّحْدَاحَةِ وَلَمْ يَدَعْ وَارِثًا غَيْرَ ابْنِ أُخْتِهِ أَبِي لُبَابَةَ بْنِ عَبْدِ الْمُنْذِرِ فَأَعْطَاهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِيرَاثَهُ ""","","","","","The Book of the People of the Two Books"
"18494","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , قَالَ : سَمِعْتُ بِالْمَدِينَةِ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : اللَّهُ وَرَسُولُهُ مَوْلَى مَنْ لا مَوْلَى لَهُ , وَالْخَالُ وَارِثُ مَنْ لا وَارِثَ لَهُ ""، عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , عَنْ رَجُلٍ مُصَدِّقٍ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَ حَدِيثِ مَعْمَرٍ""","","","","","The Book of the People of the Two Books"
"18495","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ مُسْلِمٍ , قَالَ : حَدَّثَنَا طَاوُسٌ , عَنْ عَائِشَةَ , أَنَّهَا قَالَتْ : اللَّهُ وَرَسُولُهُ مَوْلَى مَنْ لا مَوْلَى لَهُ , وَالْخَالُ وَارِثُ مَنْ لا وَارِثَ لَهُ ""","","","","","The Book of the People of the Two Books"
"18496","عَنِ الثَّوْرِيِّ ، عَنْ سُلَيْمَانَ الشَّيْبَانِيِّ , عَنِ الشَّعْبِيِّ ، قَالَ :  فِيبِنْتِ أَخٍ , وَعَمَّةٍ "" الْمَالُ لِبِنْتِ الأَخِ , وَلَيْسَ لِلْعَمَّةِ شَيْءٌ "" وَقَالَ غَيْرُهُ : "" الْمَالُ بَيْنَهُمَا نِصْفَانِ ""","","","","","The Book of the People of the Two Books"
"18497","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قَالَ : إِذَا تُوُفِّيَ الرَّجُلُ وَتَرَكَ ابْنَتَهُ , وَإِخْوَتَهُ لأُمِّهِ , وَأَخْوَالَهُ وَعَمَّتَهُ , وَهَذَا الضَّرْبَ ، فَالْمَالُ كُلُّهُ لابْنَتِهِ ""","","","","","The Book of the People of the Two Books"
"18498","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ ، عَنْ إِبْرَاهِيمَ , قَالَ : كَانَ يُقَالُ : ذُو السَّهْمِ أَحَقُّ مِمَّنْ لا سَهْمَ لَهُ ""","","","","","The Book of the People of the Two Books"
"18499","عَنِ الثَّوْرِيِّ , عَنْ مُحَمَّدِ بْنِ سَالِمٍ , عَنِ الشَّعْبِيِّ , وَقَالَهُ مَنْصُورٌ , قَالا : كَانَ عَلِيٌّ يَرُدُّ عَلَى كُلِّ ذِي سَهْمٍ بِقَدْرِ سَهْمِهِ ، إِلا الزَّوْجَ وَالْمَرْأَةَ "" , وَكَانَ عَبْدُ اللَّهِ : "" لا يَرُدُّ عَلَى أُخْتٍ لأُمٍّ مَعَ أُمٍّ , وَلا عَلَى بِنْتِ ابْنٍ مَعَ بِنْتٍ لِصُلْبٍ , وَلا عَلَى أُخْتٍ لأَبٍ مَعَ أُخْتٍ لأَبٍ وَأُمٍّ , وَلا عَلَى جَدَّةٍ ، وَلا عَلَى امْرَأَةٍ ، وَلا عَلَى زَوْجٍ ""","","","","","The Book of the People of the Two Books"
"18500","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قَالَ : كَانَ يُقَالُ : ذُو السَّهْمِ أَحَقُّ مِمَّنَ لا سَهْمَ لَهُ ""","","","","","The Book of the People of the Two Books"
"18501","عَنْ هُشَيْمٍ , عَنْ أَبِي إِسْحَاقَ الشَّيْبَانِيِّ , عَنِ الشَّعْبِيِّ ، قَالَ : قِيلَ لَهُ :  إِنَّ أَبَا عُبَيْدَةَوَرَّثَ أُخْتًا الْمَالَ كُلَّهُ "" , فَقَالَ الشَّعْبِيُّ : "" مَنْ هُوَ خَيْرٌ مِنْ أَبِي عُبَيْدَةَ قَدْ فَعَلَ ذَلِكَ ، كَانَ عَبْدُ اللَّهِ بْنُ مَسْعُودٍ يَفْعَلُ ذَلِكَ ""","","","","","The Book of the People of the Two Books"
"18502","عَنْ هُشَيْمٍ , عَنْ مُغِيرَةَ , عَنِ الشَّعْبِيِّ , قَالَ : مَا رَدَّ زَيْدُ بْنُ ثَابِتٍ عَلَى ذَوِي الْقَرَابَاتِ شَيْئًا قَطُّ ""","","","","","The Book of the People of the Two Books"
"18503","عَنِ الثَّوْرِيِّ , عَنْ مُحَمَّدِ بْنِ سَالِمٍ , عَنِ الشَّعْبِيِّ , عَنْ خَارِجَةَ بْنِ زَيْدٍ , عَنْ زَيْدٍ :  أَنَّهُ كَانَيُعْطِي أَهْلَ الْفَرَائِضِ فَرَائِضَهُمْ , وَيَجْعَلُ مَا بَقِيَ فِي بَيْتِ الْمَالِ ""","","","","","The Book of the People of the Two Books"
"18504","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : ذُكِرَ لِعَلِيٍّ :  فِي رَجُلٍ تَرَكَ بَنِي عَمِّهِ أَحَدُهُمْ أَخُوهُ لأُمِّهِ ، أَنَّ ابْنَ مَسْعُودٍ جَعَلَ الْمَالَ لَهُ كُلَّهُ , فَقَالَ : ""رَحِمَ اللَّهُ عَبْدَ اللَّهِ إِنْ كَانَ لَفَقِيهًا ، لَوْ كُنْتُ أَنَا لَجَعَلْتُ لَهُ سَهْمَهُ ثُمَّ شَرَكْتُ بَيْنَهُمْ "", عَنِ الثَّوْرِيِّ ، عَنْ خَالِدٍ الْحَذَّاءِ , عَنِ ابْنِ سِيرِينَ , عَنْ شُرَيْحٍ , أَنَّهُ كَانَ يَقُولُ فِيهَا بِقَوْلِ عَبْدِ اللَّهِ""","","","","","The Book of the People of the Two Books"
"18505","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي وَائِلٍ , قَالَ : جَاءَنَا كِتَابُ عُمَرَ بْنِ الْخَطَّابِ :  إِذَا كَانَالْعَصَبَةُ أَحَدُهُمْ أَقْرَبُ بِأُمٍّ فَأَعْطِهِ الْمَالَ ""","","","","","The Book of the People of the Two Books"
"18506","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ عَبْدِ اللَّهِ بْنِ عُتْبَةَ , قَالَ : أَخْبَرَنِي الضَّحَّاكُ بْنُ قَيْسٍ , أَنَّهُ كَانَ بِالشَّامِ طَاعُونٌ فَكَانَتِ الْقَبِيلَةُ تَمُوتُ بِأَسْرِهَا حَتَّى تَرِثَهَا الْقَبِيلَةُ الأُخْرَى , فَكَتَبَ فِيهِمْ إِلَى عُمَرَ بْنِ الْخَطَّابِ ، فَكَتَبَ عُمَرُ :  إِذَا كَانَبَنُو الأَبِ سَوَاءً , فَأَوْلاهُمْ بَنُو الأُمِّ , وَإِذَا كَانَ بَنُو الأَبِ أَقْرَبَ , فَهُمْ أَوْلَى مِنْ بَنِي الأَبِ وَالأُمِّ ""","","","","","The Book of the People of the Two Books"
"18507","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , قَالَ : كَتَبَ هِشَامُ بْنُ هُبَيْرَةَ قَاضٍ كَانَ لأَهْلِ الْبَصْرَةِ ، إِلَى شُرَيْحٍ يَسْأَلُهُ عَنْ رَجُلٍ طَلَّقَ امْرَأَتَهُ وَهُوَ مَرِيضٌ , وَعَنْ رَجُلٍ اعْتَرَفَ بِوَلَدِهِ عِنْدَ مَوْتِهِ , وَعَنِ امْرَأَةٍ تُوُفِّيَتْ وَتَرَكَتِ ابْنَيْ عَمِّهَا ، أَحَدُهُمَا زَوْجُهَا ، وَالآخَرُ أَخُوهَا لأُمِّهَا , فَكَتَبَ إِلَيْهِ شُرَيْحٌ :  فِيالَّتِي طَلَّقَ وَهُوَ مَرِيضٌ : أَنَّهَا تَرِثُهُ مَا كَانَتْ فِي الْعِدَّةِ , وَكَتَبَ إِلَيْهِ فِي الَّذِي اعْتَرَفَ بِوَلَدِهِ عِنْدَ الْمَوْتِ : أَنَّهُ يَلْحَقُ بِهِ , وَكَتَبَ إِلَيْهِ فِي الَّتِي تُوُفِّيَتْ ، وَتَرَكَتِ ابْنَيْ عَمِّهَا أَحَدُهُمَا زَوْجُهَا ، وَالآخَرُ أَخُوهَا لأُمِّهَا : لِزَوْجِهَا النِّصْفُ ، وَلأَخِيهَا لأُمِّهَا السُّدُسُ , وَمَا بَقِيَ فَهُوَ بَيْنَهُمَا ""","","","","","The Book of the People of the Two Books"
"18508","عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ عَمْرُو بْنُ شُعَيْبٍ : وَقَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَنَّكُلَّ مُسْتَلْحَقٍ ادُّعِيَ بَعْدَ أَبِيهِ ، ادَّعَاهُ وَارِثُهُ , فَقَضَى أَنَّهُ إِنْ كَانَ مِنْ أَمَةٍ أَصَابَهَا وَهُوَ يَمْلِكُهَا فَقَدْ لَحِقَ بِمَنِ اسْتَلْحَقَهُ , وَلَيْسَ لَهُ مِنْ مِيرَاثِ أَبِيهِ الَّذِي يُدْعَى لَهُ شَيْءٌ , إِلا أَنْ يُوَرِّثَهُ مَنِ اسْتَلْحَقَهُ فِي نَصِيبِهِ , وَأَنَّهُ مَا كَانَ مِنْ مِيرَاثٍ وَرِثُوهُ بَعْدَ أَنِ ادُّعِيَ فَلَهُ نَصِيبُهُ مِنْهُ , وَقَضَى أَنَّهُ إِنْ كَانَ مِنْ أَمَةٍ لا يَمْلِكُهَا أَبُوهُ الَّذِي يُدْعَى لَهُ , أَوْ مِنْ حُرَّةٍ عَهَرَ بِهَا , فَقَضَى أَنَّهُ لا يَلْحَقُ وَلا يَرِثُ , وَإِنْ كَانَ الَّذِي يُدْعَى لَهُ هُوَ ادَّعَاهُ , فَإِنَّهُ وَلَدُ زِنًا لأَهْلِ أُمِّهِ مَنْ كَانُوا حُرَّةً أَوْ أَمَةً ""","","","","","The Book of the People of the Two Books"
"18509","وَقَالَ : الْوَلَدُ لِلْفِرَاشِ وَلِلْعَاهِرِ الْحَجَرُ ""","","","","","The Book of the People of the Two Books"
"18510","عَنِ ابْنِ جُرَيْجٍ قَالَ : قَالَ لِي مُحَمَّدُ بْنُ أَبِي لَيْلَى :  إِنْمَاتَ رَجُلٌ وَكَانَتْ لَهُ جَارِيَةٌ لَهَا وَلَدٌ يَشْهَدُ بِهِ ذَوَا عَدْلٍ مِنَ الْوَرَثَةِ أَنَّ أَبَاهُمْ قَدْ أَلْحَقَهُ وَاعْتَرَفَ بِهِ فَهُوَ وَارِثٌ مَعَهُمْ , وَإِنْ كَانَا رَجُلَيْنِ ابْنَيِ الْمُتَوَفَّى شَهِدَ أَحَدُهُمَا أَنَّ أَبَاهُ قَدِ اسْتَلْحَقَهُ ، وَأَنْكَرَ الآخَرُ ، فَيَقُولُ : وَيُخْتَلَفُ فِيهَا , نَقُولُ : لِلَّذِي أَنْكَرَ شَطْرُ الْمِيرَاثِ , وَلِلَّذِي اعْتَرَفَ وَشَهِدَ ثُلُثُ الْمِيرَاثِ , وَلِلَّذِي ادُّعِيَ سُدُسُ الْمِيرَاثِ , سُدُسُهُ فِي شَطْرِ الَّذِي اعْتَرَفَ وَشَهِدَ , وَسُدُسُهُ الآخَرُ فِي شَطْرِ الَّذِي أَنْكَرَ ، فَلَمْ يَعْتَرِفْ وَلَمْ يَشْهَدْ بِهِ "" , قُلْتُ : وَكَذَلِكَ يَقُولُونَ فِي الَّذِي يَعْتَرِفُ بِهِ بَعْضُ الْوَرَثَةِ وَيَقْضُونَ بِحِصَّةِ مَا وَرِثُوا ؟ قَالَ : "" نَعَمْ "" , قُلْتُ : إِنْ كَانَ رَجُلانِ وَرِثَا مِائَةَ دِينَارٍ ، فَشَهِدَ أَحَدُهُمَا أَنَّ عَلَى صَاحِبِهِ عَشَرَةَ دَنَانِيرَ , وَأَنْكَرَ الآخَرُ "" قَضَى الَّذِي شَهِدَ خَمْسَةً ""، قَالَ مُحَمَّدٌ : لا نَرْفَعُ شَيْئًا مِنْ هَذَا إِلَى أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَلَكِنْ إِلَى فُقَهَائِنَا دُونَ ذَلِكَ ، قَالَ ابْنُ جُرَيْجٍ : وَأَقُولُ أَنَا : "" إِنْ شَهِدَ وَاحِدٌ مِنَ الْوَرَثَةِ عَلَى حَقٍّ لِقَوْمٍ ، وَأَنْكَرَ الآخَرُونَ فَيَمِينُ الطَّالِبِ مَعَ شَهَادَتِهِ ""","","","","","The Book of the People of the Two Books"
"18511","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي بَعْضُ أَصْحَابِنَا ، أَنَّ طَاوُسًا : قَضَى فِي بَنِي أَبٍ بِالْجَنَدِ ، شَهِدَ أَحَدُهُمْ أَنَّ أَبَاهُ اسْتَلْحَقَ عَبْدًا كَانَ بَيْنَهُمْ , فَلَمْ يُجِزْ طَاوُسٌ اسْتلْحَاقَهُ إِيَّاهُ , وَلَمْ يُلْحِقْهُ بِالنَّسَبِ ، وَلَكِنَّهُ أَعْطَى الْعَبْدَ خُمْسَ الْمِيرَاثِ فِي مَالِ الَّذِي شَهِدَ أَنَّ أَبَاهُ اسْتَلْحَقَهُ ، وَأَعْتَقَ مَا بَقِيَ مِنَ الْعَبْدِ فِي مَالِ الَّذِي شَهِدَ ""","","","","","The Book of the People of the Two Books"
"18512","عَنِ الثَّوْرِيِّ :  فِي الْوَارِثِ يَعْتَرِفُ بِدَيْنٍ عَلَى الْمَيِّتِ , قَالَ : قَالَ حَمَّادٌ : ""يُسْتَوْفَى مَا فِي يَدَيِ الْمُعْتَرِفِ ، لأَنَّهُ لَيْسَ لِوَارِثٍ شَيْءٌ حَتَّى يُقْضَى الدَّيْنُ "" , قَالَ حَمَّادٌ : "" وَإِذَا شَهِدَ اثْنَانِ مِنَ الْوَرَثَةِ بِالنَّسَبِ , فَلا شَهَادَةَ لَهُمَا لأَنَّهُمَا يَدْفَعَانِ عَنْ أَنْفُسِهِمَا ، وَلَكِنْ يُؤْخَذُ مِنْ نَصِيبِهِمَا "", أَخْبَرَنَا الثَّوْرِيُّ , عَنْ مُغِيرَةَ , عَنِ الشَّعْبِيِّ , أَنَّهُ قَالَ : "" بِالْحِصَصِ "" , وَقَالَهُ ابْنُ أَبِي لَيْلَى""","","","","","The Book of the People of the Two Books"
"18513","عَنِ الثَّوْرِيِّ ، عَنْ مَنْصُورٍ , أَوْ غَيْرِهِ , عَنْ إِبْرَاهِيمَ , قَالَ : إِذَا شَهِدَ اثْنَانِ مِنَ الْوَرَثَةِ جَازَ عَلَيْهِمْ فِي جَمِيعِ الْمَالِ ""، قَالَ الثَّوْرِيُّ , وَأَخْبَرَنِي الأَشْعَثُ بْنُ سَوَّارٍ , عَنِ الْحَسَنِ مِثْلَ ذَلِكَ , قَالَ : وَأَخْبَرَنِي الْقَاسِمُ بْنُ الْوَلِيدِ , عَنِ الْحَارِثِ , عَنْ إِبْرَاهِيمَ مِثْلَهُ , عَنْ عَبْدِ اللَّهِ , عَنْ شُعْبَةَ , عَنْ يُونُسَ , عَنِ الْحَسَنِ مِثْلَ ذَلِكَ , قَالَ شُعْبَةُ : وَأَخْبَرَنِي الْحَكَمُ , عَنْ إِبْرَاهِيمَ , قَالَ : "" إِذَا شَهِدَ اثْنَانِ مِنَ الْوَرَثَةِ فِي الدَّيْنِ جَازَ فِي نَصِيبِهِمَا "" مِثْلَ قَوْلِ حَمَّادٍ""","","","","","The Book of the People of the Two Books"
"18514","عَنِ الثَّوْرِيِّ , فِي ثَلاثَةِ إِخْوَةٍ أَقَرَّ أَحَدُهُمْ بِأَخٍ لَهُ , وَجَحَدَ الآخَرَانِ , وَتَرَكَ ثَلاثَةَ آلافِ دِرْهَمٍ , قَالَ : كَانَ حَمَّادٌ يَقُولُ : يَدْخُلُ عَلَى الَّذِي أَقَرَّ بِهِ نِصْفُ الأَلْفِ "" , قَالَ : وَكَانَ غَيْرُهُ يَقُولُ : "" يَجُوزُ عَلَيْهِ فِي نَصِيبِهِ ، فَيَكُونُ عَلَيْهِ فِي نَصِيبِهِ الرُّبُعُ رُبْعُ الأَلْفِ , وَكُلُّ شَيْءٍ وَرِثَهُ الَّذِي ادَّعَاهُ فِيمَا يَسْتَقْبِلُ مِنْ قَرَابَةٍ أَوْ وَلاءٍ , فَإِنَّ الْمُدَّعَى يُشَارِكُهُ فِيهِ عَلَى هَذَا الْحِسَابِ وَلا يَلْحَقُ بِالنَّسَبِ , وَلا يَتَوَارَثَانِ , وَمَنْ نَفَى الْمُدَّعَى لَمْ يُجْلَدْ لَهُ , وَإِنْ نَفَاهُ الَّذِي ادَّعَاهُ لَمْ يُجْلَدْ , وَإِنْ شَهِدَ اثْنَانِ أُحْرِزَ الْمِيرَاثُ وَلَحِقَ بِالنَّسَبِ , وَلَيْسَ لِلَّذِي ادَّعَاهُ أَنْ يَنْتَفِيَ مِنْهُ فِي الْمِيرَاثِ إِذَا شَهِدَ اثْنَانِ مِنَ الْوَرَثَةِ أَوْ غَيْرُهُمْ ""","","","","","The Book of the People of the Two Books"
"18515","عَنِ الثَّوْرِيِّ , قَالَ : إِذَا أَقَرَّ رَجُلٌ لِرَجُلٍ أَنَّهُ أَخُوهُ , وَأَقَرَّ لَهُ بِدَيْنٍ ، كَانَ لَهُ أَوْكَسُهُمَا إِذَا لَمْ يَكُنْ لَهُ بَيِّنَةٌ , وَإِذَا مَاتَ الَّذِي ادَّعَاهُ فَقَدِ انْقَطَعَ الَّذِي بَيْنَهُمَا ""","","","","","The Book of the People of the Two Books"
"18516","عَنْ مَعْمَرٍ :  فِي الرَّجُلِ يَقُولُ عِنْدَ مَوْتِهِ :ابْنُ جَارِيَتِي هَذِهِ ابْنِي , فَيَشْهَدُ بِذَلِكَ بَعْضُ وَلَدِهِ , قَالَ : "" سَمِعْنَا أَنَّ مِيرَاثَهُ فِي نَصِيبِ الَّذِي شَهِدَ بِهِ "" , قَالَ : "" فَإِنْ لَمْ يَشْهَدْ إِلا وَاحِدٌ وَرِثَ فِي نَصِيبِهِ مِثْلَ نَصِيبِهِ , أَوْ لَحِقَ مَعَهُمْ , وَلا يَرِثُ أَبَاهُ ، وَلا يُدْعَى لَهُ حَتَّى يَشْهَدَ اثْنَانِ ""","","","","","The Book of the People of the Two Books"
"18517","عَنِ الثَّوْرِيِّ , قَالَ :  لَوْ أَنَّامْرَأَةً جَاءَتْ بِغُلامٍ فَقَالَتْ : هَذَا ابْنِي مِنْ رَجُلٍ تَزَوَّجْتُهُ ، لَمْ تُصَدَّقْ بِذَلِكَ ، إِلا أَنْ تَجِيءَ بِبَيِّنَةٍ , لأَنَّهَا أَرَادَتْ أَنْ تُخْرِجَ قَوْمًا مِنْ مِيرَاثِهِمْ , وَلَيْسَ بَيْنَهُمْ وَبَيْنَ ذَلِكَ الْغُلامِ وِرَاثَةٌ , وَالرَّجُلُ إِذَا جَاءَ بِغُلامٍ فَادَّعَاهُ ، وَرِثَهُ وَلَحِقَهُ , لَيْسَ الرَّجُلُ كَالْمَرْأَةِ , قَالَ : وَلَوْ أَنَّ رَجُلا انْتَفَى مِنَ ابْنٍ لَهُ , ثُمَّ ادَّعَاهُ الْجَدُّ بَعْدُ , فَقَالَ : هُوَ ابْنُ ابْنِي لَمْ يَلْحَقْ بِنَسَبِهِ ، وَلَمْ تَجُزْ شَهَادَةُ الْجَدِّ لَهُ ، وَلا يَتَوَارَثُ الْجَدُّ وَالْغُلامُ إِلا فِي الْمَالِ الَّذِي تَرَكَ أَبُو الْغُلامِ ""","","","","","The Book of the People of the Two Books"
"18518","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , قَالَ : أَعْتَقَتِ امْرَأَةٌ صَبِيًّا ، أَوْ إِنْسَانًا ، فَضَمَّهُ إِلَيْهِ رَجُلٌ , فَجَعَلَ يُنْفِقُ عَلَيْهِ , فَقَالَتِ الْمَرْأَةُ لابْنِهَا : خَاصِمْهُ إِلَى شُرَيْحٍ , فَقَالَ : أَعْتَقَتْ أُمِّي هَذَا ، وَإِنَّ هَذَا ضَمَّهُ إِلَيْهِ وَأَخَذَهُ , فَقَالَ الرَّجُلُ : وَجَدْتُ إِنْسَانًا ضَائِعًا فَضَمَمْتُهُ إِلَيَّ وَأَنْفَقْتُ عَلَيْهِ , فَقَالَ شُرَيْحٌ : هُوَ مَعَ مِنْ يَنْفَعُهُ ""","","","","","The Book of the People of the Two Books"
"18519","عَنْ مَعْمَرٍ , عَنْ جَابِرِ بْنِ يَزِيدَ الْجُعْفِيِّ , عَنِ الشَّعْبِيِّ ، أَنَّ عُمَرَ ، وَعَلِيًّا قَضَيَا فِي الْقَوْمِ يَمُوتُونَ جَمِيعًا ، لا يُدْرَى أَيُّهُمْ يَمُوتُ قَبْلُ ، أَنَّ بَعْضَهُمْ يَرِثُ بَعْضًا ""","","","","","The Book of the People of the Two Books"
"18520","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ ، أَنَّ عُمَرَ وَرَّثَ بَعْضَهُمْ مِنْ بَعْضٍ مِنْ تِلادِ أَمْوَالِهِمْ , لا يُوَرِّثُهُمْ مِمَّا يَرِثُ بَعْضُهُمْ مِنْ بَعْضٍ شَيْئًا ""","","","","","The Book of the People of the Two Books"
"18521","عَنِ الثَّوْرِيِّ , عَنْ حَرِيشٍ , عَنْ أَبِيهِ , عَنْ عَلِي :  أَنَّأَخَوَيْنِ قُتِلا بِصِفِّينَ ، أَوْ رَجُلٌ وَابْنُهُ ، فَوَرَّثَ أَحَدَهُمَا مِنَ الآخَرِ ""","","","","","The Book of the People of the Two Books"
"18522","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ أَبِي لَيْلَى , أَنَّ عُمَرَ ، وَعَلِيًّا ، قَالا :  فِيقَوْمٍ غَرِقُوا جَمِيعًا لا يُدْرَى أَيُّهُمْ مَاتَ قَبْلُ , كَأَنَّهُمْ كَانُوا إِخْوَةً ثَلاثَةً مَاتُوا جَمِيعًا ، لِكُلِّ رَجُلٍ مِنْهُمْ أَلْفُ دِرْهَمٍ وَأُمُّهُمْ حَيَّةٌ : يَرِثُ هَذَا أُمَّهُ وَأَخُوهُ , وَيَرِثُ هَذَا أُمَّهُ وَأَخُوهُ , فَيَكُونُ لِلأُمِّ مِنْ كُلِ رَجُلٍ مِنْهُمْ سُدُسُ مَا تَرَكَ , وَلِلإِخْوَةِ مَا بَقِيَ ، كُلُّهُمْ كَذَلِكَ , ثُمَّ تَعُودُ الأُمُّ فَتَرِثُ سِوَى السُّدُسِ الَّذِي وَرِثَتْ أَوَّلَ مَرَّةٍ مِنْ كُلِّ رَجُلٍ مِمَّا وَرِثَ مِنْ أَخِيهِ الثُّلُثَ ""","","","","","The Book of the People of the Two Books"
"18523","عَنِ ابْنِ جُرَيْجٍ , وَقَالَ حُمَيْدٌ الأَعْرَجُ : يُؤْخَذُ مِيرَاثُ هَذَا , فَيُجْعَلُ فِي مَالِ هَذَا , وَيُؤْخَذُ مِيرَاثُ هَذَا , فَيُجْعَلُ فِي مِيرَاثِ هَذَا ""","","","","","The Book of the People of the Two Books"
"18524","عَنِ الثَّوْرِيِّ ، عَنِ الأَعْمَشِ , وَمَنْصُورٍ , ومغيرة , عَنْ إِبْرَاهِيمَ :  أَنَّهُوَرَّثَ الْغَرْقَى بَعْضَهُمْ مِنْ بَعْضٍ ""","","","","","The Book of the People of the Two Books"
"18525","عَنِ الثَّوْرِيِّ ، عَنْ أَبِي سَهْلٍ ،  أَنَّهُ سَأَلَ إِبْرَاهِيمَ عَنْثَلاثَةِ إِخْوَةٍ غَرِقُوا أَوْ مَاتُوا جَمِيعًا , وَلَهُمْ أُمٌّ حَيَّةٌ "" فَوَرَّثَهَا مِنْ كُلِّ وَاحِدٍ السُّدُسَ , ثُمَّ وَرَّثَ بَعْضَهُمْ مِنْ بَعْضٍ , ثُمَّ وَرَّثَهَا بَعْدَ الثُّلُثِ مِنْ كُلِّ وَاحِدٍ مِمَّا وَرِثَ مِنْ صَاحِبِهِ ""","","","","","The Book of the People of the Two Books"
"18526","عَنِ الثَّوْرِيِّ ، عَنْ مُغِيرَةَ , عَنِ الْهَيْثَمِ بْنِ قَطَنٍ , قَالَ : مَاتَتِ امْرَأَتِي وَابْنَتِي جَمِيعًا ، غَرِقُوا أَوْ أَصَابَهُمْ شَيْءٌ , فَوَرَّثَ شُرَيْحٌ بَعْضَهُمْ مِنْ بَعْضٍ ""","","","","","The Book of the People of the Two Books"
"18527","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ أَبِي الزَّعْرَاءِ ، عَنْ عَبْدِ اللَّهِ بْنِ عُتْبَةَ بْنِ مَسْعُودٍ :  أَنَّهُوَرَّثَ بَعْضَهُمْ مِنْ بَعْضٍ ""","","","","","The Book of the People of the Two Books"
"18528","أَخْبَرَنَا الثَّوْرِيُّ , وَابْنُ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ أَبِي الْمِنْهَالِ ، عَنْ إِيَاسِ بْنِ عَبْدِ وَكَانَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَنَّقَوْمًا وَقَعَ عَلَيْهِمْ بَيْتٌ ، فَوَرَّثَ بَعْضَهُمْ مِنْ بَعْضٍ ""","","","","","The Book of the People of the Two Books"
"18529","عَنْ عَبَّادِ بْنِ كَثِيرٍ , عَنْ أَبِي الزِّنَادِ , عَنْ خَارِجَةَ بْنِ زَيْدٍ , عَنْ زَيْدِ بْنِ ثَابِتٍ :  أَنَّهُ كَانَيُوَرِّثُ الأَحْيَاءَ مِنَ الأَمْوَاتِ , وَلا يُوَرِّثُ الْمَوْتَى بَعْضَهُمْ مِنْ بَعْضٍ ""","","","","","The Book of the People of the Two Books"
"18530","عَنِ الثَّوْرِيِّ ، وَمَعْمَرٍ , عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ , عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ :  أَنَّهُوَرَّثَ الأَحْيَاءَ مِنَ الأَمْوَاتِ , وَلَمْ يُوَرِّثِ الأَمْوَاتَ بَعْضَهُمْ مِنْ بَعْضٍ "", قَالَ مَعْمَرٌ : كَتَبَ بِذَلِكَ , قَالَ : قَضَى عُمَرُ بْنُ عَبْدِ الْعَزِيزِ بِمِثْلِ ذَلِكَ""","","","","","The Book of the People of the Two Books"
"18531","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : مَضَتِ السُّنَّةُ بِأَنْ يَرِثَ كُلُّ مَيِّتٍ وَارِثَهُ الْحَيَّ , وَلا يَرِثُ الْمَوْتَى بَعْضُهُمْ بَعْضًا ""، عَنِ ابْنِ جُرَيْجٍ , عَنِ الزُّهْرِيِّ ، مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18532","عَنِ ابْنِ جُرَيْجٍ , عَنْ يَحْيَى بْنِ سَعِيدٍ :  أَنَّأَهْلَ الْحَرَّةَ وَأَصْحَابَ الْجَمَلِ لَمْ يَتَوَارَثُوا ""","","","","","The Book of the People of the Two Books"
"18533","أَخْبَرَنَا عَبَّادُ بْنٌ كَثِيرٍ , عَنْ أَبِي الزِّنَادِ , عَنْ خَارِجَةَ بْنِ زَيْدٍ , عَنْ زَيْدِ بْنِ ثَابِتٍ :  أَنَّهُوَرَّثَ الأَحْيَاءَ مِنَ الأَمْوَاتِ ، وَلَمْ يُوَرِّثِ الْمَوْتَى بَعْضَهُمْ مِنْ بَعْضٍ ، وَكَانَ ذَلِكَ يَوْمَ الْحَرَّةِ ""","","","","","The Book of the People of the Two Books"
"18534","قَالَ عَبْدُ الرَّزَّاقِ : وَأَخْبَرَنَاهُ أَيْضًا , عَنْ أَبِي الزِّنَادِ , عَنْ خَارِجَةَ بْنِ زَيْدٍ ، أَنَّ أَبَا بَكْرٍ :قَضَى فِي أَهْلِ الْيَمَامَةِ مِثْلَ قَوْلِ زَيْدَ بْنَ ثَابِتٍ :  وَرَّثَ الأَحْيَاءَ مِنَ الأَمْوَاتِ , وَلَمْ يُوَرِّثِ الأَمْوَاتَ بَعْضَهُمْ مِنْ بَعْضٍ ""","","","","","The Book of the People of the Two Books"
"18535","عَنْ أَبِي مُطِيعٍ , قَالَ : أُخْرِجَ عَبَّادُ بْنُ كَثِيرٍ بَعْدَ ثَلاثِ سِنِينَ مِنْ قَبْرِهِ لَمْ يُفْقَدْ مِنْهُ إِلا شَعَرَاتٌ "" قَالَ : "" فَعَلِمْنَا أَنَّ هَذَا يَدُلُّنَا عَلَى فَضْلِهِ , وَكَانَ عِنْدَنَا ثِقَةً ""","","","","","The Book of the People of the Two Books"
"18536","عَنِ الثَّوْرِيِّ , عَنْ أَبِي سَهْلٍ , عَنِ الشَّعْبِيِّ ، أَنَّ عَلِيًّا ، وَابْنَ مَسْعُودٍ :  كَانَايُوَرِّثَانِ الْمَجُوسَ مِنْ مَكَانَيْنِ ""","","","","","The Book of the People of the Two Books"
"18537","عَنِ الثَّوْرِيِّ ، عَنْ رَجُلٍ , عَنْ إِبْرَاهِيمَ :  أَنَّهُ كَانَيُوَرِّثُهُمْ مِنْ مَكَانَيْنِ ""","","","","","The Book of the People of the Two Books"
"18538","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : يُوَرِّثُهُمْ بَأَقْرَبِ الأَرْحَامِ إِلَيْهِ ""","","","","","The Book of the People of the Two Books"
"18539","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , وَغَيْرِهِ , قَالَ : لا يَتَوَارَثُونَ حَتَّى يُشْهَدَ عَلَى النَّسَبِ ""","","","","","The Book of the People of the Two Books"
"18540","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , عَنْ شُرَيْحٍ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ كَتَبَ إِلَيْهِ : أَلا يُورَّثَ الْحَمِيلُ إِلا بِبَيِّنَةٍ ""، عَنْ مَعْمَرٍ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , عَنْ شُرَيْحٍ مِثْلَهُ , عَنِ الثَّوْرِيِّ , عَنْ مُجَالِدٍ , عَنِ الشَّعْبِيِّ , عَنْ شُرَيْحٍ مِثْلَهُ , قَالَ الثَّوْرِيُّ : "" وَنَحْنُ عَلَى هَذَا ، لا نُوَرِّثُهُ إِلا بِبَيِّنَةٍ ""","","","","","The Book of the People of the Two Books"
"18541","أَخْبَرَنَا معمر , عَنْ عَاصِمِ بْنِ سُلَيْمَانَ , قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ : أَلا يَتَوَارَثَ الْحَمِيلانِ فِي وِلادَةِ الْكُفْرِ ""","","","","","The Book of the People of the Two Books"
"18542","أَخْبَرَنَا معمر , قَالَ : أَخْبَرَنِي عَاصِمٌ , أَنَّ الْحَسَنَ , وَابْنَ سِيرِينَ عَابَا ذَلِكَ عَلَيْهِ , وَقَالا مَا شَأْنُهُمْ لا يَتَوَارَثُونَ إِذَا عُرِفُوا وَقَامَتِ الْبَيِّنَةُ ؟ ""","","","","","The Book of the People of the Two Books"
"18543","عَنْ إِبْرَاهِيمَ بْنِ أَبِي يَحْيَى , عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرٍ , قَالَ :  كَانَ عُثْمَانُ"" لا يُوَرِّثُ بِوِلادَةِ الأَعَاجِمِ إِذَا وُلِدُوا فِي غَيْرِ الإِسْلامِ ""","","","","","The Book of the People of the Two Books"
"18544","عَنْ إِسْرَائِيلَ , عَنْ أَشْعَثَ بْنِ أَبِي الشَّعْثَاءِ , قَالَ :  خَاصَمْتُ إِلَى شُرَيْحٍ فِيمَوْلاةٍ لِلْحَيِّ مَاتَتْ عَنْ مَالٍ كَثِيرٍ , فَجَاءَ رَجُلٌ فَخَاصَمَ مَوَالِيهَا , وَجَاءَ بِالْبَيِّنَةِ أَنَّهَا كَانَتْ تَقُولُ : أَخِي , فَأَعْطَاهُ شُرَيْحٌ الْمَالَ كُلَّهُ ""","","","","","The Book of the People of the Two Books"
"18545","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : كُلُّ نَسَبٍ تُوُصِلَ عَلَيْهِ فِي الإِسْلامِ فَهُوَ وَارِثٌ مَوْرُوثٌ ""","","","","","The Book of the People of the Two Books"
"18546","أَخْبَرَنَا مَعْمَرٌ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ،  أَنَّ عُثْمَانَ : "" كَانَلا يُوَرِّثُ بِوِلادَةِ أَهْلِ الشِّرْكِ ""","","","","","The Book of the People of the Two Books"
"18547","عَنْ مَعْمَرٍ , عَمَّنْ سَمِعَ إِبْرَاهِيمَ ، يَقُولُ : إِذَا تَوَاصَلُوا فِي الإِسْلامِ وَرِثَ بَعْضُهُمْ مِنْ بَعْضٍ ""","","","","","The Book of the People of the Two Books"
"18548","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيِّبِ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ كَتَبَ فِي الْجَدِّ وَالْكَلالَةِ كِتَابًا , فَمَكَثَ يَسْتَخِيرُ اللَّهَ , يَقُولُ : اللَّهُمَّ إِنْ عَلِمْتَ فِيهِ خَيْرًا فَأَمْضِهِ "" حَتَّى إِذَا طُعِنَ , دَعَا بِالْكِتَابِ ، فَمَحَى ، فَلَمْ يَدْرِ أَحَدٌ مَا كَانَ فِيهِ , فَقَالَ : "" إِنِّي كَتَبْتُ فِي الْجَدِّ وَالْكَلالَةِ كِتَابًا , وَكُنْتُ أَسْتَخِيرُ اللَّهَ فِيهِ , فَرَأَيْتُ أَنْ أَتْرُكَكُمْ عَلَى مَا كُنْتُمْ عَلَيْهِ ""","","","","","The Book of the People of the Two Books"
"18549","عَنِ الثَّوْرِيِّ , عَنْ عَمْرِو بْنِ مُرَّةَ , عَنْ عُمَرَ , قَالَ : ثَلاثٌ لأَنْ يَكُونَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيَّنَهُنَّ لَنَا أَحَبُّ إِلَيَّ مِنَ الدُّنْيَا وَمَا فِيهَا : الْخِلافَةُ , وَالْكَلالَةُ , وَالرِّبَا ""","","","","","The Book of the People of the Two Books"
"18550","عَنِ ابْنِ جُرَيْجٍ , وَابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ مُحَمَّدِ بْنِ طَلْحَةَ بْنِ يَزِيدَ بْنِ رُكَانَةَ , قَالَ : قَالَ عُمَرُ : لأَنْ أَكُونَ سَأَلْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ ثَلاثَةٍ أَحَبُّ إِلَيَّ مِنْ حُمْرِ النَّعَمِ : عَنِ الْكَلالَةِ , وَعَنِ الْخَلِيفَةِ بَعْدَهُ , وَعَنْ قَوْمٍ قَالُوا : نُقِرُّ بِالزَّكَاةِ فِي أَمْوَالِنَا , وَلا نُؤَدِّيهَا إِلَيْكَ ، أَيَحِلُّ قِتَالُهُمْ أَمْ لا ؟ "" قَالَ : "" وَكَانَ أَبُو بَكْرٍ يَرَى الْقِتَالَ ""","","","","","The Book of the People of the Two Books"
"18551","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : قَالَ لِي عُمَرُ حِينَ طُعِنَ : اعْقِلْ عَنِّي ثَلاثًا : الإِمَارَةُ شُورَى , وَفِي فِدَاءِ الْعَرَبِ مَكَانَ كُلِّ عَبْدٍ عَبْدٌ ، وَفِي ابْنِ الأَمَةِ عَبْدَانِ , وَفِي الْكَلالَةِ مَا قُلْتُ "", قَالَ : قُلْتُ لابْنِ طَاوُسٍ : مَا قَالَ ؟ فَأَبَى أَنْ يُخْبِرَنِي""","","","","","The Book of the People of the Two Books"
"18552","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ طَاوُسٍ , عَنْ أَبِيهِ , عَنِ ابْنِ عَبَّاسٍ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَوْصَى عِنْدَ الْمَوْتِ , فَقَالَ : "" الْكَلالَةُ كَمَا قُلْتُ "" قَالَ ابْنُ عَبَّاسٍ : وَمَا قُلْتَ ؟ قَالَ : "" مِنْ لا وَلَدَ ""","","","","","The Book of the People of the Two Books"
"18553","عَنِ ابْنِ عُيَيْنَةَ , عَنْ سُلَيْمَانَ الأَحْوَلِ , عَنْ طَاوُسٍ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : إِنِّي لأَحْدَثُهُمْ عَهْدًا بِعُمَرَ ، فَقَالَ : الْكَلالَةُ مَا قُلْتُ "" , قَالَ : وَمَا قُلْتَ ؟ قَالَ : "" مِنْ لا وَلَدَ "" حَسِبْتُ أَنَّهُ قَالَ : "" وَلا وَالِدَ ""","","","","","The Book of the People of the Two Books"
"18554","أَخْبَرَنَا ابْنُ جُرَيْجٍ , وَابْنُ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ حَسَنِ بْنِ مُحَمَّدِ بْنِ عَلِيٍّ , قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : الْكَلالَةُ مِنْ لا وَلَدَ وَلا وَالِدَ ""، زَادَ ابْنُ عُيَيْنَةَ , قَالَ : حَسَنُ بْنُ مُحَمَّدٍ , قُلْتُ لابْنِ عَبَّاسٍ : "" فَإِنَّ اللَّهَ يَقُولُ :  إِنِ امْرُؤٌ هَلَكَ لَيْسَ لَهُ وَلَدٌ قَالَ : فَانْتَهَرَنِي ""","","","","","The Book of the People of the Two Books"
"18555","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ ، عَنْ أَبِي بَكْرٍ أَنَّهُ قَالَ : الْكَلالَةُ مَا خَلا الْوَلَدَ وَالْوَالِدَ ""","","","","","The Book of the People of the Two Books"
"18556","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَاصِمِ بْنِ سُلَيْمَانَ , عَنِ الشَّعْبِيِّ , قَالَ : كَانَ أَبُو بَكْرٍ يَقُولُ : الْكَلالَةُ مِنْ لا وَلَدَ لَهُ , وَلا وَالِدَ "" , قَالَ : وَكَانَ عُمَرُ يَقُولُ : "" الْكَلالَةُ مِنْ لا وَلَدَ لَهُ "" ، فَلَمَّا طُعِنَ عُمَرُ , قَالَ : "" إِنِّي لأَسْتَحْيِي اللَّهَ أَنْ أُخَالِفَ أَبَا بَكْرٍ ، أَرَى الْكَلالَةَ مَا عَدَا الْوَلَدَ وَالْوَالِدَ ""","","","","","The Book of the People of the Two Books"
"18557","أَخْبَرَنَا معمر , عَنِ الزُّهْرِيِّ ، وَقَتَادَةَ , وأبي إسحاق ، عَنْ عَمْرِو بْنِ شُرَحْبِيلَ , قَالَ : الْكَلالَةُ مِنْ لَيْسَ لَهُ وَلَدٌ وَلا وَالِدٌ ""","","","","","The Book of the People of the Two Books"
"18558","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , قَالَ :  نَزَلَتْ : قُلِ اللَّهُ يُفْتِيكُمْ فِي الْكَلالَةِ وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي مَسِيرٍ لَهُ , وَإِلَى جَنْبِهِ حُذَيْفَةُ بْنُ الْيَمَانِ , فَبَلَّغَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حُذَيْفَةَ "" , وَبَلَّغَهَا حُذَيْفَةُ عُمَرَ بْنَ الْخَطَّابِ وَهُوَ يَسِيرُ خَلْفَ حُذَيْفَةَ , فَلَمَّا اسْتُخْلِفَ عُمَرُ سَأَلَ حُذَيْفَةَ عَنْهَا ، وَرَجَا أَنْ يَكُونَ عِنْدَهُ تَفْسِيرُهَا , فَقَالَ لَهُ حُذَيْفَةُ : وَاللَّهِ إِنَّكَ لأَحْمَقُ إِنْ ظَنَنْتَ أَنَّ إِمَارَتَكَ تَحْمِلُنِي أَنْ أُحَدِّثَكَ فِيهَا مَا لَمْ أُحَدِّثْكَ يَوْمَئِذٍ , فَقَالَ عُمَرُ : لَمْ أُرِدْ هَذَا رَحِمَكَ اللَّهُ ""، قَالَ مَعْمَرٌ : فَأَخْبَرَنِي أَيُّوبُ , عَنِ ابْنِ سِيرِينَ ، أَنَّ عُمَرَ كَانَ إِذَا قَرَأَ :  يُبَيِّنُ اللَّهُ لَكُمْ أَنْ تَضِلُّوا قَالَ : "" اللَّهُمَّ مَنْ بَيَّنْتَ لَهُ الْكَلالَةَ فَلَمْ تُبَيِّنْ لِي ""","","","","","The Book of the People of the Two Books"
"18559","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ طَاوُسٍ ، أَنَّ عُمَرَ :  أَمَرَ حَفْصَةَ أَنْ تَسْأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِالْكَلالَةِ ، فَأَمْهَلَتْهُ حَتَّى إِذَا لَبِسَ ثِيَابَهُ فَسَأَلَتْهُ , "" فَأَمْلَهَا عَلَيْهَا فِي كَتِفٍ "" , فَقَالَ عُمَرُ : أَمَرَكِ بِهَذَا , "" مَا أَظُنُّهُ أَنْ يَفْهَمَهَا ، أَوَلَمْ تَكْفِهِ آيَةُ الصَّيْفِ ؟ "" , فَأَتَتْ بِهَا عُمَرَ فَقَرَأَهَا ، فَلَمَّا قَرَأَ :  يُبَيِّنُ اللَّهُ لَكُمْ أَنْ تَضِلُّوا قَالَ : اللَّهُمَّ مِنْ بَيَّنْتَ لَهُ فَلَمْ تُبَيِّنْ لِي ""","","","","","The Book of the People of the Two Books"
"18560","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ ، أَنَّ عُمَرَ أَمَرَ حَفْصَةَ أَنْ تَسْأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْكَلالَةِ ""","","","","","The Book of the People of the Two Books"
"18561","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ أَنَّ ابْنَ عَبَّاسٍ ، قَالَ : لَمَّا تُوُفِّيَ أَبُو بَكْرٍ أَخَذَ حَلِيفٌ لَهُ سُدُسَ مَالِهِ "" ، قَالَ لَهُ ابْنُ عَبَّاسٍ : وَكَانَ يُؤْمَرُ بِذَلِكَ , قَالَ : فَسَأَلْتُ أَنَا عَنْ ذَلِكَ ، فَلَمْ أَجِدْ أَحَدًا يَعْرِفُ ذَلِكَ ""","","","","","The Book of the People of the Two Books"
"18562","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ فِي قَوْلِهِ :  وَلِكُلٍّ جَعَلْنَا مَوَالِيَ ، قَالَ : "" هُمُ الأَوْلِيَاءُ "" , قَالَ :  وَالَّذِينَ عَقَدَتْ أَيْمَانُكُمْ قَالَ : "" كَانَ الرَّجُلُ فِي الْجَاهِلِيَّةِ يُعَاقِدُ الرَّجُلَ فَيَقُولُ : دَمِي دَمُكَ , وَهَدْمِي هَدْمُكَ ، وَتَرِثُنِي وَأَرِثُكَ ، وَتَطْلُبُ بِدَمِي وَأَطْلُبُ بِدَمِكَ , فَلَمَّا جَاءَ الإِسْلامُ بَقِيَ مِنْهُمْ نَاسٌ , فَأُمِرُوا أَنْ يُؤْتُوهُمْ نَصِيبَهُمْ مِنَ الْمِيرَاثِ وَهُوَ السُّدُسُ , ثُمَّ نُسِخَ ذَلِكَ بِالْمِيرَاثِ بَعْدُ "" , فَقَالَ :  وَأُولُو الأَرْحَامِ بَعْضُهُمْ أَوْلَى بِبَعْضٍ ""","","","","","The Book of the People of the Two Books"
"18563","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ فِي قَوْلِهِ :  وَلِكُلٍّ جَعَلْنَا مَوَالِيَ قَالَ : "" هُمُ الأَوْلِيَاءُ ""  وَالَّذِينَ عَقَدَتْ أَيْمَانُكُمْ قَالَ : "" كَانَ هَذَا حِلْفًا فِي الْجَاهِلِيَّةِ , فَلَمَّا جَاءَ الإِسْلامُ أُمِرُوا أَنْ يُؤْتُوهُمْ نَصِيبَهُمْ مِنَ النَّصْرِ ، وَالْوَلاءِ ، وَالْمَشُورَةِ ، وَلا مِيرَاثَ ""","","","","","The Book of the People of the Two Books"
"18564","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : لا حِلْفَ فِي الإِسْلامِ وَتَمَسَّكُوا بِحِلْفِ الْجَاهِلِيَّةِ ""","","","","","The Book of the People of the Two Books"
"18565","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ : قَضَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ مَنْ كَانَ حَلِيفًا فِي الْجَاهِلِيَّةِ فَهُوَ عَلَى حِلْفِهِ ، وَلَهُ نَصِيبُهُ مِنَ الْعَقْلِ وَالنَّصْرِ , يَعْقِلُ عَنْهُ مِنْ حَالَفَ وَمِيرَاثُهُ لِعَصَبَتِهِ مِنْ كَانُوا "" , وَقَالُوا : "" لا حِلْفَ فِي الإِسْلامِ , وَتَمَسَّكُوا بِحِلْفِ الْجَاهِلِيَّةِ , فَإِنَّ اللَّهَ لَمْ يَزِدْهُ فِي الإِسْلامِ إِلا شِدَّةً "" قَالَ عَمْرٌو : "" وَقَضَى عُمَرُ بْنُ الْخَطَّابِ أَنَّهُ مَنْ كَانَ حَلِيفًا أَوْ عَدِيدًا فِي قَوْمٍ قَدْ عَقَلُوا عَنْهُ وَنَصَرُوهُ , فَمِيرَاثُهُ لَهُمْ إِذَا لَمْ يَكُنْ وَارِثٌ يُعْلَمُ ""","","","","","The Book of the People of the Two Books"
"18566","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ شُعَيْبٍ , قَالَ  قَضَى عُمَرُ بْنُ الْخَطَّابِ أَنَّمِنْ هَلَكَ مِنَ الْمُسْلِمِينَ لا وَارِثَ لَهُ يُعْلَمُ , وَلَمْ يَكُنْ مَعَ قَوْمٍ يُعَاقِلُهُمْ وَيُعَادُّهُمْ , فَمِيرَاثُهُ بَيْنَ الْمُسْلِمِينَ فِي مَالِ اللَّهِ الَّذِي يُقْسَمُ بَيْنَهُمْ ""","","","","","The Book of the People of the Two Books"
"18567","عَنِ الثَّوْرِيِّ , عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ , عَنِ الشَّعْبِيِّ , عَنْ شُرَيْحٍ , أَنَّهُ قَالَ : يُورَّثُ الأَسِيرُ فِي أَيْدِي الْعَدُوِّ "", وَقَالَهُ إِبْرَاهِيمُ""","","","","","The Book of the People of the Two Books"
"18568","عَنِ الثَّوْرِيِّ , قَالَ : إِذَا قُتِلَ الْمُرْتَدُّ فَمَالُهُ لِوَرَثَتِهِ , وَإِذَا لَحِقَ بِأَرْضِ الْحَرْبِ فَمَالُهُ لِلْمُسْلِمِينَ ""","","","","","The Book of the People of the Two Books"
"18569","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ مُغِيرَةَ , عَنِ الشَّعْبِيِّ ، عَنْ عَلِي :  أَنَّهُوَرَّثَ خُنْثَى ذَكَرًا مِنْ حَيْثُ يَبُولُ ""","","","","","The Book of the People of the Two Books"
"18570","أَخْبَرَنَا معمر , عَنْ قَتَادَةَ , قَالَ : سَأَلْتُ سَعِيدَ بْنَ الْمُسَيِّبِ عَنِالَّذِي يُخْلَقُ خَلْقَ الْمَرْأَةِ وَخَلْقَ الرَّجُلِ كَيْفَ يُوَرَّثُ ؟ : فَقَالَ  مِنْ أَيِّهِمَا بَالَ وُرِّثَ "" , قَالَ : فَقَالَ ابْنُ الْمُسَيِّبِ : "" أَرَأَيْتَ إِنْ كَانَ يَبُولُ مِنْهُمَا جَمِيعًا ؟ "" فَقُلْتُ : "" لا أَدْرِي "" , فَقَالَ : "" انْظُرْ مِنْ أَيِّهِمَا يَخْرُجُ الْبَوْلُ أَسْرَعَ فَعَلَى ذَلِكَ يُوَرَّثُ ""، عَنِ ابْنِ عُيَيْنَةَ , عَنْ سَعِيدِ بْنِ أَبِي عَرُوبَةَ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيِّبِ ، مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18571","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : حُدِّثْتُ أَنَّ عَامِرَ بْنَ الظَّرْبِ الْعَروَانِيَّ :  وَكَانَيَقْضِي بَيْنَ النَّاسِ فِي الْجَاهِلِيَّةِ , فَاخْتُصِمَ إِلَيْهِ فِي خُنْثَى ذَكَرٍ , فَلَمْ يَعْلَمْ حَتَّى أَشَارَتْ عَلَيْهِ جَارِيَتُهُ رَاعِيَةُ غَنَمِهِ أَنِ انْظُرْ فَمِنْ حَيْثُ بَالَ فَوَرِّثْهُ ""","","","","","The Book of the People of the Two Books"
"18572","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ أَنَّهُ اخْتُصِمَ إِلَى لَقِيطِ بْنِ زُرَارَةَ فِي مِثْلِ ذَلِكَ : فَلَمْ يَدْرِ حَتَّى أَشَارَتْ عَلَيْهِ خُصَيْلَةُ جَارِيَتُهُ رَاعِيَةُ غَنَمِهِ بِأَنْ يُلْحِقَهُ مِنْ حَيْثُ يَبُولُ ""","","","","","The Book of the People of the Two Books"
"18573","قَالَ ابْنُ جُرَيْجٍ : حُدِّثْتُ عَنْ زَيْدِ بْنِ أَسْلَمَ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : لا تَسْأَلُوا أَهْلَ الْكِتَابِ عَنْ شَيْءٍ , فَإِنَّهُمْ إِنْ يَهْدُوكُمْ قَدْ أَضَلُّوا أَنْفُسَهُمْ "" , قِيلَ : يَا رَسُولَ اللَّهِ ! أَلا نُحَدِّثُ عَنْ بَنِي إِسْرَائِيلَ ؟ ، قَالَ : "" تَحَدَّثُوا وَلا حَرَجَ ""","","","","","The Book of the People of the Two Books"
"18574","أَخْبَرَنَا الأَوْزَاعِيُّ , عَنْ حَسَّانِ بْنِ عَطِيَّةَ , عَنْ أَبِي كَبْشَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ الْعَاصِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : بَلِّغُوا عَنِّي وَلَوْ آيَةً , وَحَدِّثُوا عَنْ بَنِي إِسْرَائِيلَ وَلا حَرَجَ , فَمَنَ كَذَبَ عَلَيَّ فَلْيَتَبَوَّأْ مَقْعَدَهُ مِنَ النَّارِ ""","","","","","The Book of the People of the Two Books"
"18575","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ , عَنْ عَطَاءِ بْنِ يَسَارٍ , قَالَ : كَانَتْ يَهُودُ يُحَدِّثُونَ أَصْحَابَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَيَسِيخُونَ كَأَنَّهُمْ يَتَعَجَّبُونَ , فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تُصَدِّقُوهُمْ , وَلا تُكَذِّبُوهُمْ "" , وَقُولُوا :  آمَنَّا بِالَّذِي أُنْزِلَ إِلَيْنَا وَأُنْزِلَ إِلَيْكُمْ وَإِلَهُنَا وَإِلَهُكُمْ وَاحِدٌ وَنَحْنُ لَهُ مُسْلِمُونَ ""","","","","","The Book of the People of the Two Books"
"18576","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ عُمَارَةَ , عَنْ حُرَيْثِ بْنِ ظُهَيْرٍ , قَالَ : قَالَ عَبْدُ اللَّهِ لا تَسْأَلُوا أَهْلَ الْكِتَابِ عَنْ شَيْءٍ , فَإِنَّهُمْ لَنْ يَهْدُوكُمْ وَقَدْ أَضَلُّوا أَنْفُسَهُمْ ، فَتُكَذِّبُونَ بِحَقٍّ , أَوْ تُصَدِّقُونَ بِبَاطِلٍ , وَإِنَّهُ لَيْسَ أَحَدٌ مِنْ أَهْلِ الْكِتَابِ إِلا فِي قَلْبِهِ تَالِيَةٌ تَدْعُوهُ إِلَى اللَّهِ وَكِتَابِهِ ""قَالَ : وَزَادَ مَعْنٌ , عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ عَبْدِ اللَّهِ فِي هَذَا الْحَدِيثِ , أَنَّهُ قَالَ : "" إِنْ كُنْتُمْ سَائِلِيهُمْ لا مَحَالَةَ , فَانْظُرُوا مَا قَضَى كِتَابُ اللَّهِ فَخُذُوهُ , وَمَا خَالَفَ كِتَابَ اللَّهِ فَدَعُوهُ ""","","","","","The Book of the People of the Two Books"
"18577","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , وَعَنْ عَبْدِ اللَّهِ بْنِ ثَابِتٍ , وَقَالَ : عَنِ الشَّعْبِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ ثَابِتٍ , قَالَ : جَاءَ عُمَرُ بْنُ الْخَطَّابِ ، فَقَالَ : يَا رَسُولَ اللَّهِ ! إِنِّي مَرَرْتُ بِأَخٍ لِي مِنْ يَهُودَ ، فَكَتَبَ لِي جَوَامِعَ مِنَ التَّوْرَاةِ , قَالَ : أَفَلا أَعْرِضُهَا عَلَيْكَ ؟ فَتَغَيَّرَ وَجْهُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ عَبْدُ اللَّهِ : مَسَخَ اللَّهُ عَقْلَكَ ، أَلا تَرَى مَا بِوَجْهِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ عُمَرُ : رَضِيتُ بِاللَّهِ رَبًّا ، وَبِالإِسْلامِ دِينًا ، وَبِمُحَمَّدٍ رَسُولا , قَالَ : فَسُرِّيَ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , ثُمَّ قَالَ :  وَالَّذِي نَفْسِي بِيَدِهِلَوْ أَصْبَحَ فِيكُمْ مُوسَى فَاتَّبَعْتُمُوهُ وَتَرَكْتُمُونِي , لَضَلَلْتُمْ ، إِنَّكُمْ حَظِّي مِنَ الأُمَمِ ، وَأَنَا حَظُّكُمْ مِنَ النَّبِيِّينَ ""","","","","","The Book of the People of the Two Books"
"18578","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , قَالَ : أَخْبَرَنَا ابْنُ أَبِي نَمْلَةَ الأَنْصَارِيُّ , أَنَّ أَبَا نَمْلَةَ ، أَخْبَرَهُ أَنَّهُ بَيْنَا هُوَ جَالِسٌ عِنْدَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذْ جَاءَهُ رَجُلٌ مِنَ الْيَهُودِ ، وَمُرَّ بِجِنَازَةٍ , فَقَالَ : يَا مُحَمَّدُ هَلْ تَكَلَّمُ ؟ فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  اللَّهُ أَعْلَمُ "" , فَقَالَ : الْيَهُودِيُّ : إِنَّهَا تَكَلَّمُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" مَا حَدَّثَكُمْأَهْلُ الْكِتَابِ فَلا تُصَدِّقُوهُمْ وَلا تُكَذِّبُوهُمْ ، وَقُولُوا : آمَنَّا بِاللَّهِ وَبِكُتُبِهِ وَرُسُلِهِ ، فَإِنْ كَانَ بَاطِلا لَمْ تُصَدِّقُوهُ , وَإِنْ كَانَ حَقًّا لَمْ تُكَذِّبُوهُ ""","","","","","The Book of the People of the Two Books"
"18579","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ ، أَنَّ ابْنَ عَبَّاسٍ ، قَالَ : كَيْفَ تَسْأَلُوهُمْ عَنْ شَيْءٍ وَكِتَابُ اللَّهِ بَيْنَ أَظْهُرِكُمْ ؟ ""","","","","","The Book of the People of the Two Books"
"18580","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , عَنْ عَوْفِ بْنِ مَالِكٍ الأَشْجَعِيِّ :  أَنَّ رَجُلا يَهُودِيًّا ، أَوْ نَصْرَانِيًّا نَخَسَ بِامْرَأَةٍ مُسْلِمَةٍ , ثُمَّ حَثَى عَلَيْهَا التُّرَابَ يُرِيدُهَا عَلَى نَفْسِهَا , فَرُفِعَ ذَلِكَ إِلَى عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ : "" إِنَّلِهَؤُلاءِ عَهْدًا مَا وَفَوْا لَكُمْ بِعَهْدِكُمْ , فَإِذَا لَمْ يُوفُوا لَكُمْ بِعَهْدٍ فَلا عَهْدَ لَهُمْ "" ، قَالَ : فَصَلَبَهُ عُمَرَ""","","","","","The Book of the People of the Two Books"
"18581","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ :  إِنْ كَانَبَيْنَ مُسْلِمٍ وَكَافِرٍ قَرَابَةٌ قَرِيبَةٌ فَلْيَعُدْهُ "" ، وَقَالَهُ عَمْرُو بْنُ دِينَارٍ , قَالَ عَطَاءٌ : "" فَإِنْ لَمْ تَكُنْ بَيْنَهُمَا قَرَابَةٌ فَلا يَعُدْهُ ""، وَقَالَ عَمْرٌو : "" لِيَعُدْهُ وَإِنْ لَمْ تَكُنْ بَيْنَهُمَا قَرَابَةٌ ، رَأْيًا ""","","","","","The Book of the People of the Two Books"
"18582","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَمِعْتُ سُلَيْمَانَ بْنَ مُوسَى , يَقُولُ : نَعُودُهُمْ وَإِنْ لَمْ تَكُنْ بَيْنَنَا وَبَيْنَهُمْ قَرَابَةٌ ""","","","","","The Book of the People of the Two Books"
"18583","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ , قَالَ عَبْدُ الرَّزَّاقِ : وَسَمِعْتُهُ أَنَا مِنْ عَبْدِ اللَّهِ بْنِ عَمْرِو بْنِ عَلْقَمَةَ , عَنِ ابْنِ أَبِي حُسَيْنٍ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ لَهُ جَارٌ يَهُودِيٌّ لا بَأْسَ بِخُلُقِهِ , فَمَرِضَ , فَعَادَهُ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي أَصْحَابِهِ , فَقَالَ : أَتَشْهَدُ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَنَّ مُحَمَّدًا رَسُولُ اللَّهِ "" , فَنَظَرَ إِلَى أَبِيهِ ، فَسَكَتَ أَبُوهُ وَسَكَتَ الْفَتَى , ثُمَّ الثَّانِيَةَ , ثُمَّ الثَّالِثَةَ , فَقَالَ : أَبُوهُ فِي الثَّالِثَةِ : قُلْ مَا قَالَ لَكَ , فَفَعَلَ ثُمَّ مَاتَ ، فَأَرَادَتِ الْيَهُودُ أَنْ تَلِيَهُ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" نَحْنُ أَوْلَى بِهِ مِنْكُمْ ، فَغَسَّلَهُ ، وَكَفَّنَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَحَنَّطَهُ وَصَلَّى عَلَيْهِ ""","","","","","The Book of the People of the Two Books"
"18584","أَخْبَرَنَا ابْنُ التَّيْمِيِّ , عَنْ أَبِيهِ , قَالَ : أَنْبَأَنِي قَتَادَةُ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ لِرَجُلٍ نَصْرَانِيٍّ :  أَسْلِمْ أَبَا الْحَارِثِ ! "" , فَقَالَ النَّصْرَانِيُّ : قَدْ أَسْلَمْتُ , فَقَالَ لَهُ : "" أَسْلِمْ أَبَا الْحَارِثِ ! "" , فَقَالَ : قَدْ أَسْلَمْتُ , فَقَالَ لَهُ الثَّالِثَةَ : "" أَسْلِمْ أَبَا الْحَارِثِ ! "" فَقَالَ : قَدْ أَسْلَمْتُ قَبْلَكَ ، فَغَضِبَ ، وَقَالَ : ""كَذَبْتَ ، حَالَ بَيْنَكَ وَبَيْنَ الإِسْلامِ خِلالٌ ثَلاثٌ : شَرِيكُ الْخَمْرِ ، وَلَمْ يَقُلْ : شُرْبُكَ ، وَأَكْلُكَ الْخِنْزِيرَ , وَدُعَاؤُكَ لِلَّهِ وَلَدًا ""","","","","","The Book of the People of the Two Books"
"18585","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنِ ابْنِ أَبِي نَجِيحٍ , قَالَ : سَمِعْتُ مُجَاهِدًا ، يَقُولُ لِغُلامٍ لَهُ نَصْرَانِيٍّ :  يَا جَرِيرُ ،أَسْلِمْ ! "" , ثُمَّ قَالَ : "" هَكَذَا كَانَ يُقَالُ لَهُمْ ""","","","","","The Book of the People of the Two Books"
"18586","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ ، أَنَّ مُحَمَّدَ بْنَ الأَسْوَدِ بْنِ خَلَفٍ ، أَخْبَرَهُ أَنَّ أَبَاهُ الأَسْوَدَ :  رَأَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيُبَايِعُ النَّاسَ يَوْمَ الْفَتْحِ "" ، قَالَ : "" جَلَسَ عِنْدَ قَرْنِ مَسْقَلَةَ "" وَقَرَنُ مَسْقَلَةَ الَّذِي تُهْرِيقُ إِلَيْهِ بُيُوتُ ابْنِ أَبِي يَمَامَةَ ، وَهِيَ دَارُ ابْنِ سَمُرَةَ وَمَا حَوْلَهَا , وَالَّذِي يُهْرِيقُ مَا أَدْبَرَ مِنْهَا عَلَى دَارِ ابْنِ عَامِرٍ ، وَمَا أَقْبَلَ مِنْهَا عَلَى دَارِ ابْنِ سَمُرَةَ وَمَا حَوْلَهَا ، قَالَ الأَسْوَدُ : "" فَرَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ جَالِسٌ , فَجَاءَهُ النَّاسُ الْكِبَارُ وَالصِّغَارُ , فَبَايَعُوهُ عَلَى الإِسْلامِ , وَشَهَادَةِ الإِيمَانِ بِاللَّهِ , وَشَهَادَةِ أَنْ لا إِلَهَ إِلا اللَّهُ , وَأَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ ""","","","","","The Book of the People of the Two Books"
"18587","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَبَّاسُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ مِينَاءَ ، أَنَّ رَجُلَيْنِ مِنْ مُزَيْنَةَ كَانَا رَجُلَيْ سَوْءٍ قَدْ قَطَعَا الطَّرِيقَ ، وَقَتَلا , فَمَرَّ بِهِمَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَتَوَضَّئَا وَصَلَّيَا , ثُمَّ بَايَعَا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَقَالا :  يَا رَسُولَ اللَّهِ ! قَدْ أَرَدْنَا أَنَّ نَأْتِيَكَ , فَقَدْ قَصَّرَ اللَّهُ خَطْوَنَا , فَقَالَ :مَا أَسْمَاؤُكُمَا ؟ "" فَقَالا : الْمُهَانَانِ , قَالَ : "" بَلْ أَنْتُمَا الْمُكْرَمَانِ ""","","","","","The Book of the People of the Two Books"
"18588","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أُخْبِرْتُ , عَنْ عُثَيْمِ بْنِ كُلَيْبٍ , عَنْ أَبِيهِ , عَنْ جَدِّهِ ، أَنَّهُ جَاءَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : قَدْ أَسْلَمْتُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَلْقِ عَنْكَ شَعْرَ الْكُفْرِ "" , يَقُولُ : "" احْلِقْ ""","","","","","The Book of the People of the Two Books"
"18589","قَالَ ابْنُ جُرَيْجٍ : وَأَخْبَرَنِي آخَرُ عَنْهُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ لآخَرَ : أَلْقِ عَنْكَ شَعْرَ الْكُفْرِ وَاخْتَتِنْ ""","","","","","The Book of the People of the Two Books"
"18590","أَخْبَرَنَا الثَّوْرِيُّ , عَنِ الأَغَرِّ , عَنْ خَلِيفَةِ بْنِ حُصَيْنٍ , عَنْ جَدِّهِ قَيْسِ بْنِ عَاصِمٍ , قَالَ :  أَتَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَنَا أُرِيدُ الإِسْلامَ ، فَأَسْلَمْتُ , فَأَمَرَنِي أَنْأَغْتَسِلَ بِمَاءٍ وَسِدْرٍ ، فَاغْتَسَلْتُ بِمَاءٍ وَسِدْرٍ ""","","","","","The Book of the People of the Two Books"
"18591","أَخْبَرَنَا عُبَيْدُ اللَّهِ , وَعَبْدُ اللَّهِ ابْنَا عُمَرَ , عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ , عَنْ أَبِي هُرَيْرَةَ ، أَنَّ ثُمَامَةَ الْحَنَفِيَّ أُسِرَ فَأَسْلَمَ , فَجَاءَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَبَعَثَ بِهِ إِلَى حَائِطِ أَبِي طَلْحَةَ  وَأَمَرَهُ أَنْيَغْتَسِلَ , فَاغْتَسَلَ وَصَلَّى رَكْعَتَيْنِ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : "" قَدْ حَسُنَ إِسْلامُ أَخِيكُمْ ""","","","","","The Book of the People of the Two Books"
"18592","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ ، قَالَ : سَمِعْتُهُ يَقُولُ :  فِيالَّذِي يُسْلِمُ : يُؤْمَرُ بِالْغُسْلِ ""","","","","","The Book of the People of the Two Books"
"18593","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : حُدِّثْتُ حَدِيثًا رُفِعَ إِلَى عَلِيٍّ :  فِييَهُودِيٍّ , أَوْ نَصْرَانِيٍّ تَزَنْدَقَ ، قَالَ : دَعُوهُ تَحَوَّلَ مِنْ دِينٍ إِلَى دِينٍ ""","","","","","The Book of the People of the Two Books"
"18594","سَمِعْتُ أَبَا حَنِيفَةَ , قَالَ : رُفِعَ إِلَى عَلِيٍّ يَهُودِيٌّ , أَوْ نَصْرَانِيٌّ تَزَنْدَقَ , قَالَ : دَعُوهُ تَحَوَّلَ مِنْ كُفْرٍ إِلَى كُفْرٍ ""قَالَ عَبْدُ الرَّزَّاقِ : فَقُلْتُ لَهُ : عَمَّنْ هَذَا ؟ فَقَالَ : عَنْ سِمَاكِ بْنِ حَرْبٍ , عَنْ قَابُوسِ بْنِ الْمُخَارِقِ , أَنَّ مُحَمَّدَ بْنَ أَبِي بَكْرٍ كَتَبَ فِيهِ إِلَى عَلِيٍّ ، فَكَتَبَ إِلَيْهِ عَلِيٌّ بِهَذَا""","","","","","The Book of the People of the Two Books"
"18595","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي خَلادٌ ، أَنَّ عَمْرَو بْنَ شُعَيْبٍ , أَخْبَرَهُ أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ : لا نَدَعُ يَهُودِيًّا , وَلا نَصْرَانِيًّا يُنَصِّرُ وَلَدَهُ , وَلا يُهَوِّدُهُ فِي مُلْكِ الْعَرَبِ ""","","","","","The Book of the People of the Two Books"
"18596","أَخْبَرَنَا معمر , عَمَّنْ سَمِعَ الْحَسَنَ , يَقُولُ : مِنَ السُّنَّةِ أَنْ تُهْدَمَ الْكَنَائِسُ الَّتِي فِي الأَمْصَارِ الْقَدِيمَةِ وَالْحَدِيثَةِ ""","","","","","The Book of the People of the Two Books"
"18597","قَالَ معمر ، وَقَالَ لِي عَمْرُو بْنُ مَيْمُونِ بْنِ مِهْرَانَ : وَسَأَلْتُهُ عَنْ ذَلِكَ , فَقَالَ : إِنَّمَا صَالَحُوا عَلَى دِينِهِمْ يَقُولُ : لا تُهْدَمُ ""","","","","","The Book of the People of the Two Books"
"18598","أَخْبَرَنَا عَمِّي وَهْبُ بْنُ نَافِعٍ ، قَالَ : شَهِدْتُ كِتَابَ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ إِلَى عُرْوَةَ بْنِ مُحَمَّدٍ :  أَنْتُهْدَمَ الْكَنَائِسُ الْقَدِيمَةُ "" , شَهِدْتُهُ يَهْدِمُهَا , فَأُعِيدَتْ , فَلَمَّا قَدِمَ رَجَاءٌ دَعَانِي ، فَشَهِدْتُ عَلَى كِتَابِ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، فَهَدَمَهَا ثَانِيَةً""","","","","","The Book of the People of the Two Books"
"18599","أَخْبَرَنَا ابْنُ التَّيْمِيِّ , عَنْ أَبِيهِ , قَالَ : حَدَّثَنِي شَيْخٌ مِنْ أَهْلِ الْمَدِينَةِ يُقَالُ لَهُ : حَنَشٌ أَبُو عَلِيٍّ , أَنَّ عِكْرِمَةَ أَخْبَرَهُ , قَالَ : سُئِلَ ابْنُ عَبَّاسٍ : هَلْ لِلْمُشْرِكِينَ أَنْ يَتَخِذُوا الْكَنَائِسَ فِي أَرْضِ الْعَرَبِ ؟ فَقَالَ ابْنُ عَبَّاسٍ : أَمَّا مَا مَصَّرَ الْمُسْلِمُونَ فَلا تُرْفَعُ فِيهِ كَنِيسَةٌ ، وَلا بِيعَةٌ , وَلا صَلِيبٌ , وَلا سِنَانٌ , وَلا يُنْفَخُ فِيهَا بِبُوقٍ , وَلا يُضْرَبُ فِيهَا بِنَاقُوسٍ , وَلا يَدْخُلُ فِيهَا خَمْرٌ وَلا خِنْزِيرٌ , وَمَا كَانَتْ مِنْ أَرْضٍ صُولِحُوا صُلْحًا , فَعَلَى الْمُسْلِمِينَ أَنْ يَفُوا لَهُمْ بِصُلْحِهِمْ ""تَفْسِيرُ مَا مَصَّرَ الْمُسْلِمُونَ , يَقُولُ : "" مَا كَانَتْ مِنْ أَرْضِهِمْ أَوْ أَخَذُوهَا عَنْوَةً ""","","","","","The Book of the People of the Two Books"
"18600","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ مَيْمُونِ بْنِ مِهْرَانَ ، قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ :  أَنْيُمْنَعَ النَّصَارَى بِالشَّامِ أَنْ يَضْرِبُوا نَاقُوسًا "" , قَالَ : "" وَنُهُوا أَنْ يُفَرِّقُوا رُءُوسَهُمْ , وَأَمَرَ بِجَزِّ نَوَاصِيهُمْ , وَأَنْ يَشُدُّوا مَنَاطِقَهُمْ ، وَلا يَرْكَبُوا عَلَى سُرُجٍ , وَلا يَلْبَسُوا عَصْبًا وَلا خَزًّا ، وَلا يَرْفَعُوا صُلُبَهُمْ فَوْقَ كَنَائِسِهِمْ , فَإِنْ قَدَرُوا عَلَى أَحَدٍ مِنْهُمْ فَعَلَ مِنْ ذَلِكَ شَيْئًا بَعْدَ التَّقَدُّمِ إِلَيْهِ , فَإِنَّ سَلَبَهُ لِمَنْ وَجَدَهُ "" , قَالَ : "" وَكَتَبَ أَنْ تُمْنَعَ نِسَاؤُهُمْ أَنْ يَرْكَبْنَ الرَّحَائِلَ ""","","","","","The Book of the People of the Two Books"
"18601","عَنِ الثَّوْرِيِّ , عَنْ سِمَاكٍ , عَنْ قَابُوسٍ , عَنْ أَبِيهِ , قَالَ : كَتَبَ مُحَمَّدُ بْنُ أَبِي بَكْرٍ إِلَى عَلِيٍّ  يَسْأَلُهُ عَنْمُسْلِمٍ زَنَى بِنَصْرَانِيَّةٍ , فَكَتَبَ إِلَيْهِ : أَقِمِ الْحَدَّ عَلَى الْمُسْلِمِ ، وَارْدُدِ النَّصْرَانِيَّةَ إِلَى أَهْلِ دِينِهَا ""","","","","","The Book of the People of the Two Books"
"18602","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ عَطَاءٌ :  نَحْنُمُخَيَّرُونَ ، إِنْ شِئْنَا حَكَمْنَا بَيْنَهُمْ , وَإِنْ شِئْنَا لَمْ نَحْكُمْ , فَإِنْ حَكَمْنَا حَكَمْنَا بَيْنَهُمْ بِحُكْمِنَا بَيْنَنَا ، وَتَرَكْنَاهُمْ فِي حُكْمِهِمْ بَيْنَهُمْ "" فَذَلِكَ قَوْلُهُ :  وَأَنِ احْكُمْ بَيْنَهُمْ ، وَقَالَ عَمْرُو بْنُ شُعَيْبٍ مِثْلَ ذَلِكَ ، فَذَلِكَ قَوْلُهُ :  فَاحْكُمْ بَيْنَهُمْ أَوْ أَعْرِضْ عَنْهُمْ ""","","","","","The Book of the People of the Two Books"
"18603","أَخْبَرَنَا معمر , عَنِ الزُّهْرِيِّ , قَالَ مَضَتِ السُّنَّةُ أَنْ يُرَدُّوا فِي حُقُوقِهِمْ وَمَوَارِيثِهُمْ إِلَى أَهْلِ دِينِهِمْ , إِلا أَنْ يَأْتُوا رَاغِبِينَ فِي حَدٍّ نَحْكُمُ بَيْنَهُمْ فِيهِ ، فَنَحْكُمُ بَيْنَهُمْ بِكِتَابِ اللَّهِ "" قَالَ اللَّهُ لِرَسُولِهِ :  وَإِنْ حَكَمْتَ فَاحْكُمْ بَيْنَهُمْ بِالْقِسْطِ ""","","","","","The Book of the People of the Two Books"
"18604","أَخْبَرَنَا الثَّوْرِيُّ , عَنِ السُّدِّيِّ , عَنْ عِكْرِمَةُ , قَالَ :  نَسَخَتْ قَوْلُهُ : فَاحْكُمْ بَيْنَهُمْ أَوْ أَعْرِضْ عَنْهُمْ , قَوْلَهُ :  احْكُمْ بَيْنَهُمْ بِمَا أَنْزَلَ اللَّهُ ""","","","","","The Book of the People of the Two Books"
"18605","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , وَعَامِرٍ ، قَالا :  إِنْشَاءَ الْوَالِي قَضَى بَيْنَهُمْ , وَإِنْ شَاءَ أَعْرَضَ عَنْهُمْ , فَإِنْ قَضَى بَيْنَهُمْ قَضَى بِمَا أَنْزَلَ اللَّهُ ""","","","","","The Book of the People of the Two Books"
"18606","أَخْبَرَنَا مَعْمَرٌ , عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، أَنَّ عُمَرَ كَتَبَ إِلَى عَدِيِّ بْنِ عَدِيٍّ : إِذَا جَاءَكَ أَهْلُ الْكِتَابِ فَاحْكُمْ بَيْنَهُمْ ""","","","","","The Book of the People of the Two Books"
"18607","أَخْبَرَنَا معمر , عَنِ ابْنِ شُبْرُمَةَ , قَالَ :  رَأَيْتُ الشَّعْبِيَّيَحُدُّ يَهُودِيًّا حَدًّا فِي فِرْيَةٍ فِي الْمَسْجِدِ وَعَلَيْهِ قَمِيصٌ ""","","","","","The Book of the People of the Two Books"
"18608","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ :  إِنْزَنَى رَجُلٌ مِنْ أَهْلِ الْكِتَابِ بِمُسْلِمَةٍ , أَوْ سَرَقَ لِمُسْلِمٍ شَيْئًا ، أُقِيمَ عَلَيْهِ ، وَلَمْ يُعْرِضِ الإِمَامُ عَنْ ذَلِكَ , يَقُولُونَ فِي كُلِّ شَيْءٍ بَيْنَ الْمُسْلِمِينَ وَبَيْنَهُمْ , فَإِنَّهُ لا يُعْرِضُ عَنْهُ ""","","","","","The Book of the People of the Two Books"
"18609","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ إِسْمَاعِيلَ بْنِ مُحَمَّدٍ , وَيَعْقُوبَ بْنِ عُتْبَةَ , وَغَيْرِهُمَا : زَعَمُوا أَلا حَدَّ عَلَى مَنْ رَمَاهُمْ إِلا أَنْ يُنَكِّلَ السُّلْطَانُ ""","","","","","The Book of the People of the Two Books"
"18610","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ , عَنْ أَبِيهِ , قَالَ :  سَأَلْتُهُهَلْ عَلَى مِنْ قَذَفَ أَهْلَ الذِّمَّةِ حَدٌّ ؟ ، قَالَ : "" لا أَرَى عَلَيْهِ حَدًّا ""، قَالَ ابْنُ جُرَيْجٍ : وَسَمِعْتُ نَافِعًا , يَقُولُ : "" لا حَدَّ عَلَيْهِ ""","","","","","The Book of the People of the Two Books"
"18611","أَخْبَرَنَا معمر , عَنِ الزُّهْرِيِّ , قَالَ : لا حَدَّ عَلَى مِنْ رَمَى يَهُودِيًّا أَوْ نَصْرَانِيًّا ""","","","","","The Book of the People of the Two Books"
"18612","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ طَارِقِ بْنِ عَبْدِ الرَّحْمَنِ , وَمُطَرِّفِ بْنِ طَرِيفٍ , قَالَ : كُنَّا عِنْدَ الشَّعْبِيِّ فَرُفِعَ إِلَيْهِ رَجُلانِ مُسْلِمٌ وَنَصْرَانِيٌّ ، قَذَفَ كُلُّ وَاحِدٍ مِنْهُمَا صَاحِبَهُ , فَضَرَبَ النَّصْرَانِيَّ لِلْمُسْلِمِ ثَمَانِينَ , وَقَالَ لِلنَّصْرَانِيِّ : مَا فِيكَ أَعْظَمُ مِنْ قَذْفِهِ هَذَا , فَتَرَكَهُ "", فَرُفِعَ ذَلِكَ إِلَى عَبْدِ الْحَمِيدِ ، فَكَتَبَ فِيهِ إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ يَذْكُرُ مَا صَنَعَ الشَّعْبِيُّ ، فَكَتَبَ عُمَرُ يُحَسِّنُ صَنِيعَ الشَّعْبِيِّ""","","","","","The Book of the People of the Two Books"
"18613","قَالَ الثَّوْرِيُّ : مَنْ قَذَفَ يَهُودِيًّا أَوْ نَصْرَانِيًّا فَلَيْسَ عَلَيْهِ حَدٌّ , وَإِنْ قَذَفَ نَصْرَانِيٌّ نَصْرَانِيَّةً لا يُضْرَبُ بَعْضُهُمْ لِبَعْضٍ إِنْ تَخَاصَمُوا إِلَى أَهْلِ الإِسْلامِ , كَمَا لا يُضْرَبُ لَهُمْ مُسْلِمٌ إِذَا قَذَفَهَمْ ، كَذَلِكَ لا يُضْرَبُ بَعْضُهُمْ لِبَعْضٍ ""","","","","","The Book of the People of the Two Books"
"18614","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : قَالَ لِي عَطَاءٌ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أُمِرْتُ أَنْ أُقَاتِلَهُمْ حَتَّى يَقُولُوا : لا إِلَهَ إِلا اللَّهُ , فَإِذَا قَالُوهَا أَحْرَزُوا دِمَاءَهُمْ وَأَمْوَالَهُمْ , إِلا بِحَقِّهَا وَحِسَابُهُمْ عَلَى اللَّهِ ""","","","","","The Book of the People of the Two Books"
"18615","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، يَقُولُ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : قَاتِلُوا النَّاسَ حَتَّى يَقُولُوا : لا إِلَهَ إِلا اللَّهُ , فَإِذَا فَعَلُوا ذَلِكَ عَصَمُوا دِمَاءَهُمْ وَأَمْوَالَهُمْ , إِلا بِحَقِّهَا وَحِسَابُهُمْ عَلَى اللَّهِ ""","","","","","The Book of the People of the Two Books"
"18616","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً , فَقُلْتُ : الْمَجُوسُ أَهْلُ الْكِتَابِ ؟ ، قَالَ "" لا "" , قُلْتُ : فَالأَسْبَذِيُّونَ ؟ ، قَالَ : "" وُجِدَ كِتَابُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَهُمْ زَعَمُوا ، بَعْدَ إِذْ أَرَادَ عُمَرُ أَنْ يَأْخُذَ الْجِزْيَةَ مِنْهُمْ ، فَلَمَّا وَجَدَهُ تَرَكَهُمْ , قَالَ : قَدْ زَعَمُوا ذَلِكَ ""","","","","","The Book of the People of the Two Books"
"18617","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي جَعْفَرُ بْنُ مُحَمَّدٍ , عَنْ أَبِيهِ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ خَرَجَ فَمَرَّ عَلَى نَاسٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهِمْ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ , فَقَالَ : مَا أَدْرِي مَا أَصْنَعُ فِي هَؤُلاءِ الْقَوْمِ الَّذِينَ لَيْسُوا مِنَ الْعَرَبِ ، وَلا مِنْ أَهْلِ الْكِتَابِ ، يُرِيدُ الْمَجُوسَ ، فَقَالَ عَبْدُ الرَّحْمَنِ : أَشْهَدُ لَسَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : سُنُّوا بِهِمْ سُنَّةَ أَهْلِ الْكِتَابِ ""","","","","","The Book of the People of the Two Books"
"18618","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي جَعْفَرٌ أَيْضًا , عَنْ أَبِيهِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَتَبَ لأَهْلِ هَجَرَ : أَلا يُحْمَلَ عَلَى مُحْسِنٍ ذَنْبُ مُسِيءٍ , وَإِنِّي لَوْ جَاهَدْتُكُمْ أَخْرَجْتُكُمْ مِنْ هَجَرَ ""","","","","","The Book of the People of the Two Books"
"18619","أَخْبَرَنَا مَعْمَرٌ , قَالَ : سَمِعْتُ الزُّهْرِيَّ , يَسْأَلُ :أَتُؤْخَذُ الْجِزْيَةُ مِمَّنْ لَيْسَ مِنْ أَهْلِ الْكِتَابِ ؟ ، قَالَ :  نَعَمْ ، أَخَذَهَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ أَهْلِ الْبَحْرَيْنِ , وَعُمَرُ مِنْ أَهْلِ السَّوَادِ , وَعُثْمَانُ مِنْ بَرْبَرٍ ""","","","","","The Book of the People of the Two Books"
"18620","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ قَيْسِ بْنِ مُسْلِمٍ , عَنِ الْحَسَنِ بْنِ مُحَمَّدِ بْنِ عَلِيٍّ , قَالَ : كَتَبَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى مَجُوسِ هَجَرَ يَدْعُوهُمْ إِلَى الإِسْلامِ , فَمَنْ أَسْلَمَ قَبِلَ مِنْهُ الْحَقَّ , وَمَنْ أَبَى كَتَبَ عَلَيْهِ الْجِزْيَةَ ، وَأَنْ لا تُؤْكَلَ لَهُمْ ذَبِيحَةٌ , وَأَلا تُنْكَحَ لَهُمُ امْرَأَةٌ ""","","","","","The Book of the People of the Two Books"
"18621","أَخْبَرَنَا معمر , عَنْ قَتَادَةَ , وَغَيْرِهِ :  أَنَّهُ كَانَيُؤْخَذُ مِنْ مَجُوسِ أَهْلِ الْبَحْرَيْنِ أَرْبَعَةٌ وَعِشْرِينَ دِرْهَمًا فِي السَّنَةِ عَلَى كُلِّ رَجُلٍ ""","","","","","The Book of the People of the Two Books"
"18622","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ قَيْسِ بْنِ مُحَمَّدٍ , أَوْ مُحَمَّدِ بْنِ قَيْسٍ , عَنِ الشَّعْبِيِّ , قَالَ :  كَانَأَهْلُ السَّوَادِ لَيْسَ لَهُمْ عَهْدٌ , فَلَمَّا أُخِذَ مِنْهُمُ الْخَرَاجُ ، كَانَ لَهُمْ عَهْدٌ ""","","","","","The Book of the People of the Two Books"
"18623","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : صَالَحَ عَبْدَةَ الأَوْثَانِ عَلَى الْجِزْيَةِ , إِلا مَنْ كَانَ مِنْهُمْ مِنَ الْعَرَبِ ، وَقَبِلَ الْجِزْيَةَ مِنْ أَهْلِ الْبَحْرَيْنِ وَكَانُوا مَجُوسًا ""","","","","","The Book of the People of the Two Books"
"18624","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ يَعْقُوبَ بْنِ عُتْبَةَ , وَإِسْمَاعِيلَ بْنِ مُحَمَّدٍ , وَغَيْرِهِمَا  أَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَأَخَذَ الْجِزْيَةَ مِنْ مَجُوسِ هَجَرَ, وَأَنَّ عُمَرَ بْنَ الْخَطَّابِ أَخَذَ مِنْ مَجُوسِ السَّوَادِ , وَأَنَّ عُثْمَانَ أَخَذَ مِنْ بَرْبَرٍ ""","","","","","The Book of the People of the Two Books"
"18625","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , عَنْ بَجَالَةَ التَّمِيمِيِّ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ :  لَمْ يُرِدْ أَنْ يَأْخُذَ الْجِزْيَةَ مِنَ الْمَجُوسِ حَتَّى شَهِدَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ "" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَأَخَذَهَا مِنْ مَجُوسِ هَجَرَ ""","","","","","The Book of the People of the Two Books"
"18626","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ شَيْخٍ مِنْهُمْ يُقَالُ لَهُ : أَبُو سَعْدٍ , عَنْ رَجُلٍ شَهِدَ ذَلِكَ أَحْسَبُهُ نَصْرَ بْنَ عَاصِمٍ , أَنَّ الْمُسْتَوْرِدَ بْنَ عَلْقَمَةَ ، كَانَ فِي مَجْلِسٍ أَوْ فَرْوَةَ بْنَ نَوْفَلٍ الأَشْجَعِيَّ , فَقَالَ رَجُلٌ : لَيْسَ عَلَى الْمَجُوسِ جِزْيَةٌ ، فَقَالَ الْمُسْتَوْرِدُ : أَنْتَ تَقُولُ هَذَا ؟  وَقَدْأَخَذَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ مَجُوسِ هَجَرَ ، وَاللَّهِ لَمَا أَخْفَيْتَ أَخْبَثُ مِمَّا أَظْهَرْتَ ، فَذَهَبَ بِهِ حَتَّى دَخَلا عَلَى عَلِيٍّ وَهُوَ فِي قَصْرٍ جَالِسٌ فِي قُبَّةٍ , فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ ! زَعَمَ هَذَا أَنَّهُ لَيْسَ عَلَى الْمَجُوسِ جِزْيَةٌ ، وَقَدْ عَلِمْتَ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَخَذَهَا مِنْ مَجُوسِ هَجَرَ ، فَقَالَ عَلِيٌّ : "" إِلَيْنَا يَقُولُ : اجْلِسَا ، وَاللَّهِ مَا عَلَى الأَرْضِ الْيَوْمَ أَحَدٌ أَعْلَمَ بِذَلِكَ مِنِّي , كَانَ الْمَجُوسُ أَهْلَ كِتَابٍ يَعْرِفُونَهُ ، وَعَلْمٍ يَدْرِسُونَهُ , فَشَرِبَ أَمِيرُهُمُ الْخَمْرَ ، فَوَقَعَ عَلَى أُخْتِهِ ، فَرَآهُ نَفَرٌ مِنَ الْمُسْلِمِينَ , فَلَمَّا أَصْبَحَ , قَالَتْ أُخْتُهُ : إِنَّكَ قَدْ صَنَعْتَ بِهَا كَذَا وَكَذَا ، وَقَدْ رَآكَ نَفَرٌ لا يَسْتُرُونَ عَلَيْكَ , فَدَعَا أَهْلَ الطَّمَعِ فَأَعْطَاهُمْ ، ثُمَّ قَالَ لَهُمْ : قَدْ عَلِمْتُمْ أَنَّ آدَمَ أَنْكَحَ بَنِيهِ بَنَاتَهُ , فَجَاءَ أُولَئِكَ الَّذِينَ رَأَوْهُ , فَقَالُوا : وَيْلا لِلأَبْعَدِ ، إِنَّ فِي ظَهْرِكَ حَدًّا , فَقَتَلَهُمْ ، وَهُمُ الَّذِينَ كَانُوا عِنْدَهُ , ثُمَّ جَاءَتِ امْرَأَةٌ فَقَالَتْ لَهُ : بَلَى ، قَدْ رَأَيْتُكَ , فَقَالَ لَهَا : وَيْحًا لِبَغِيِّ بَنِي فُلانٍ , قَالَتْ : أَجَلْ ، وَاللَّهِ لَقَدْ كُنْتُ بَغِيَّةً ثُمَّ تُبْتُ ، فَقَتَلَهَا , ثُمَّ أُسْرِيَ عَلَى مَا فِي قُلُوبِهِمْ وَعَلَى كُتُبِهِمْ ، فَلَمْ يَصِحَّ عِنْدَهُمْ شَيْءٌ ""","","","","","The Book of the People of the Two Books"
"18627","أَخْبَرَنَا معمر , عَنْ قَتَادَةَ ، وَغَيْرِهِ :  أَنَّهُ كَانَيُؤْخَذُ مِنْ مَجُوسِ أَهْلِ الْبَحْرَيْنِ أَرْبَعَةٌ وَعِشْرُونَ دِرْهَمًا فِي السَّنَةِ عَلَى كُلِّ رَجُلٍ ""","","","","","The Book of the People of the Two Books"
"18628","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ :  سَأَلْتُ عَطَاءً عَنِالْجِزْيَةِ ، فَقَالَ : مَا عَلِمْنَا شَيْئًا إِلا مَا صُولِحُوا عَلَيْهِ , ثُمَّ أَحْرَزُوا كُلَّ شَيْءٍ مِنْ أَمْوَالِهِمْ "", قَالَ : وَقَالَ لِي ذَلِكَ عَمْرُو بْنُ دِينَارٍ""","","","","","The Book of the People of the Two Books"
"18629","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُوسَى بْنُ عُقْبَةَ , عَنْ نَافِعٍ ، أَنَّهُ حَدَّثَ عَنْ عُمَرَ :  أَنَّهُضَرَبَ الْجِزْيَةَ عَلَى كُلِّ رَجُلٍ بَلَغَ الْحُلُمَ أَرْبَعِينَ دِرْهَمًا ، أَوْ أَرْبَعَةَ دَنَانِيرَ ، فَجَعَلَ الْوَرِقَ عَلَى مَنْ كَانَ مِنْهُمْ بِالْعِرَاقِ لأَنَّهَا أَرْضُ وَرِقٍ , وَجَعَلَ الذَّهَبَ عَلَى أَهْلِ الشَّامِ وَمِصْرَ لأَنَّهَا أَرْضُ الذَّهَبِ , وَضَرَبَ عَلَيْهِمْ مَعَ ذَلِكَ أَرْزَاقَ الْمُسْلِمِينَ وَكِسْوَتَهُمُ الَّتِي كَانَ عُمَرُ يَكْسُوَهَا النَّاسَ ، وَضِيَافَةَ مِنْ نَزَلَ بِهِمْ مِنَ الْمُسْلِمِينَ ثَلاثَ لَيَالٍ وَأَيَّامِهِنَّ ""","","","","","The Book of the People of the Two Books"
"18630","قَالَ ابْنُ جُرَيْجٍ , قَالَ مُوسَى , قَالَ نَافِعٌ : سَمِعْتُ أَسْلَمَ مَوْلَى عُمَرَ ، يُحَدِّثَ ابْنَ عُمَرَ :  أَنَّأَهْلَ الْجِزْيَةِ مِنْ أَهْلِ الشَّامِ أَتَوْا عُمَرَ ، فَقَالُوا : إِنَّ الْمُسْلِمِينَ إِذَا نَزَلُوا بِنَا كَلَّفُونَا الْغَنَمَ وَالدَّجَاجَ , فَقَالَ عُمَرُ "" أَطْعِمُوهُمْ مِنْ طَعَامِكُمُ الَّذِي تَأْكُلُونَ ، وَلا تَزِيدُوهُمْ عَلَى ذَلِكَ ""","","","","","The Book of the People of the Two Books"
"18631","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , عَنْ أَسْلَمَ , أَنَّ عُمَرَ : ضَرَبَ الْجِزْيَةَ ، وَكَتَبَ بِذَلِكَ إِلَى أُمَرَاءِ الأَجْنَادِ أَلا يَضْرِبُوا الْجِزْيَةَ إِلا عَلَى مِنْ جَرَتْ عَلَيْهِ الْمُوسَى ، وَلا يَضْرِبُوهَا عَلَى صَبِيٍّ ، وَلا عَلَى امْرَأَةٍ , فَضَرَبَ عَلَى أَهْلِ الْعِرَاقِ أَرْبَعِينَ دِرْهَمًا عَلَى كُلِّ رَجُلٍ , وَضَرَبَ عَلَيْهِمْ أَيْضًا خَمْسَةَ عَشَرَ صَاعًا , وَضَرَبَ عَلَى أَهْلِ الشَّامِ أَرْبَعَةَ دَنَانِيرَ عَلَى كُلِّ رَجُلٍ , وَضَرَبَ عَلَيْهِمْ أَيْضًا مُدَّيْنِ مِنْ قَمْحٍ , وَثَلاثَةَ أَقْسَاطٍ مِنْ زَيْتٍ ، وَكَذَا وَكَذَا شَيْئًا مِنَ الْعَسَلِ وَالْوَدَكِ ، لَمْ يَحْفَظْهُ أَيُّوبُ أَوْ نَافِعٌ ، وَضَرَبَ عَلَى أَهْلِ مِصْرَ أَرْبَعَةَ دَنَانِيرَ عَلَى كُلِّ رَجُلٍ مِنْهُمْ , وَضَرَبَ عَلَيْهِمْ إِرْدَبًّا مِنْ قَمْحٍ ، وَشَيْئًا لا يَحْفَظُهُ ، وَكِسْوَةَ أَمِيرِ الْمُؤْمِنِينَ ضَرِيبَةً مَضْرُوبَةً , وَعَلَيْهِمْ ضِيَافَةُ الْمُسْلِمِينَ ثَلاثًا , يُطْعِمُونَهُمْ مِمَّا يَأْكُلُونَ مِمَّا يَحِلُّ لِلْمُسْلِمِينَ مِنْ طَعَامِهِمْ , فَلَمَّا قَدِمَ عُمَرُ الشَّامَ شَكَوْا إِلَيْهِ أَنَّهُمْ يُكَلِّفُونَا الدَّجَاجَ , فَقَالَ عُمَرُ : "" لا تُطْعِمُوهُمْ إِلا مِمَّا تَأْكُلُونَ مِمَّا يَحِلُّ لَهُمْ مِنْ طَعَامِكُمْ ""","","","","","The Book of the People of the Two Books"
"18632","أَخْبَرَنَا مَعْمَرٌ , عَنِ الأَعْمَشِ , عَنْ شَقِيقِ بْنِ سَلَمَةَ , عَنْ مَسْرُوقِ بْنِ الأَجْدَعِ , قَالَ :  بَعَثَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُعَاذًا إِلَى الْيَمَنِ ، فَأَمَرَهُ أَنْيَأْخُذَ الْجِزْيَةَ مِنْ كُلِّ حَالِمٍ وَحَالِمَةٍ دِينَارًا أَوْ قِيمَتُهُ مَعَافِرِيٌّ ""","","","","","The Book of the People of the Two Books"
"18633","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنْ رَجُلٍ مِنْ بَنِي غِفَارٍ , قَالَ : قَالَ عُمَرُ : لا تَشْتَرُوا رَقِيقَ أَهْلِ الذِّمَّةِ ، فَإِنَّهُمْ أَهْلُ خَرَاجٍ يُؤَدِّي بَعْضُهُمْ عَنْ بَعْضٍ ""يَعْنِي : بِلادَهَمْ""","","","","","The Book of the People of the Two Books"
"18634","قَالَ الثَّوْرِيُّ :  وَذَلِكَإِلَى الْوَالِي يَزِيدُ عَلَيْهِمْ بِقَدْرِ يُسْرِهِمْ ، وَيَضَعُ عَنْهُمْ بِقَدْرِ حَاجَتِهِمْ , وَلَيْسَ لِذَلِكَ وَقْتٌ يَنْظُرُ فِيهِ الْوَالِي عَلَى قَدْرِ مَا يُطِيقُونَ , فَأَمَّا مَا لَمْ يُؤْخَذْ عَنْوَةً حَتَّى صُولِحُوا صُلْحًا , فَلا يُزَادُ عَلَيْهِمْ شَيْءٌ عَلَى مَا صُولِحُوا عَلَيْهِ , وَالْجِزْيَةُ عَلَى مَا صُولِحُوا عَلَيْهِ مِنْ قَلِيلٍ أَوْ كَثِيرٍ فِي أَرَضِيهِمْ , وَأَعْنَاقِهِمْ "" , يَقُولُ : "" لَيْسَ عَلَيْهِمْ زَكَاةٌ فِي أَمْوَالِهِمْ ""","","","","","The Book of the People of the Two Books"
"18635","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنِ ابْنِ أَبِي نَجِيحٍ , قَالَ : قُلْتُ لِمُجَاهِدٍ : مَا شَأْنُ أَهْلِ الشَّامِ مِنْ أَهْلِ الْكِتَابِ تُؤْخَذُ مِنْهُمُ الْجِزْيَةُ أَرْبَعَةُ دَنَانِيرَ , وَمِنْ أَهْلِ الْيَمَنِ دِينَارٌ ؟ ، قَالَ : ذَلِكَ مِنْ قِبَلِ الْيَسَارِ ""","","","","","The Book of the People of the Two Books"
"18636","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ مَنْصُورٍ , عَنْ هِلالِ بْنِ يَسَافٍ , عَنْ رَجُلٍ مِنْ جُهَيْنَةَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : لَعَلَّكُمْ أَنْ تُقَاتِلُوا قَوْمًا فَتَظْهَرُوا عَلَيْهِمْ , فَيَتَّقُونَكُمْ بِأَمْوَالِهِمْ دُونَ أَنْفُسِهِمْ وَأَبْنَائِهِمْ , فَيُصَالِحُوكُمْ ، فَلا تُصِيبُوا مِنْهُمْ غَيْرَ ذَلِكَ ""","","","","","The Book of the People of the Two Books"
"18637","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ عُمَرَ , عَنْ نَافِعٍ , عَنْ أَسْلَمَ مَوْلَى عُمَرَ , أَنَّ عُمَرَ كَتَبَ إِلَى أُمَرَاءِ الأَجْنَادِ : أَلا يَضْرِبُوا الْجِزْيَةَ عَلَى النِّسَاءِ ، وَلا عَلَى الصِّبْيَانِ , وَأَنْ يَضْرِبُوا الْجِزْيَةَ عَلَى مِنْ جَرَتْ عَلَيْهِ الْمُوسَى مِنَ الرِّجَالِ , وَأَنْ يَخْتِمَا فِي أَعْنَاقِهِمْ وَيَجُزُّوا نَوَاصِيَهُمْ مَنِ اتَّخَذَ مِنْهُمْ شَعْرًا , وَيُلْزِمُوهُمُ الْمَنَاطِقَ , وَيَمْنَعُوهُمُ الرُّكُوبَ إِلا عَلَى الأَكُفِّ عَرْضًا "" قَالَ : يَقُولُ : رِجْلاهُ مِنْ شِقٍّ وَاحِدٍ , قَالَ عَبْدُ اللَّهِ : "" وَفَعَلَ ذَلِكَ بِهِمْ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ حِينَ وَلِيَ ""، وَقَالَ عَبْدُ اللَّهِ فِي حَدِيثِ نَافِعٍ , عَنْ أَسْلَمَ : "" وَضَرَبَ عُمَرُ الْجِزْيَةَ عَلَى مَنْ كَانَ بِالشَّامِ مِنْهُمْ ، أَرْبَعَةَ دَنَانِيرَ عَلَى كُلِّ رَجُلٍ , وَمُدَّيْنِ مِنَ الطَّعَامِ , وَقِسْطَيْنِ أَوْ ثَلاثَةٍ مِنْ زَيْتٍ , وَضَرَبَ عَلَى مَنْ كَانَ بِمِصْرَ أَرْبَعَةَ دَنَانِيرَ , وَإِرْدَبَّيْنِ مِنَ الطَّعَامِ وَشَيْئًا ذَكَرَهُ , وَضَرَبَ عَلَى مَنْ كَانَ بِالْعِرَاقِ أَرْبَعِينَ دِرْهَمًا وَخَمْسَةَ عَشَرَ قَفِيزًا ، وَشَيْئًا لا نَحْفَظُهُ , وَضَرَبَ عَلَيْهِمْ مَعَ ذَلِكَ ضِيَافَةَ مِنْ مَرَّ عَلَيْهِمْ مِنَ الْمُسْلِمِينَ ثَلاثَةَ أَيَّامٍ , وَضَرَبَ عَلَيْهِمْ ثِيَابًا , وَذَكَرَ عَسَلا لَمْ نَحْفَظْهُ ""","","","","","The Book of the People of the Two Books"
"18638","أَخْبَرَنَا الْخُرَاسَانِيُّ , قَالَ : حَدَّثَنِي ابْنُ لَهِيعَةَ , قَالَ : أَخْبَرَنِي خَالِدُ بْنُ أَبِي عِمْرَانَ ، أَنَّ عَامِرَ بْنَ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ ، حَدَّثَهُ أَنَّ رَجُلا حَاصَ بِمُخَلاةٍ فِيهَا حَشِيشٌ وَشَيْئًا أَخَذَهَا مِنْ أَهْلِ الذِّمَّةِ ، فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِلرَّجُلِ : خُذْ هَذَا ! , فَقَالَ : أَخَذْتُهُ وَلَيْسَ بِشَيْءٍ , فَقَالَ : أَخْفَرْتَ ذِمَّتِي ، أَخْفَرْتَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَذَهَبَ الرَّجُلُ فَأَعْطَاهَا صَاحِبَهَا , ثُمَّ أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَأَخَذَهُ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :أَلَمْ تَحْتَجْ إِلَى مَا أَخَذْتَ ؟ قَالَ : بَلَى , قَالَ : فَهُوَ إِلَى الَّذِي أَخَذْتَ لَهُ أَحْوَجُ","","","","","The Book of the People of the Two Books"
"18639","أَخْبَرَنَا ابْنُ أَبِي لَيْلَى :  أَنَّجَيْشًا مَرُّوا بِزَرْعِ رَجُلٍ مِنْ أَهْلِ الذِّمَّةِ فَأَرْسَلُوا فِيهِ دَوَابَّهُمْ ، وَحَبَسَ رَجُلٌ مِنْهُمْ دَابَّتَهُ , وَجَعَلَ يَتَّبِعُ بِهَا الْمَرْعَى ، وَيَمْنَعُهَا مِنَ الزَّرْعِ , فَجَاءَ الذِّمِّيُّ إِلَى الَّذِي حَبَسَ دَابَّتَهُ , فَقَالَ : "" كَفَانِيكَ اللَّهُ ، أَوْ كَفَانِي اللَّهُ بِكَ , فَلَوْلا أَنْتَ كَفَيْتَ هَؤُلاءِ ، وَلَكِنْ تَدْفَعُ عَنْ هَؤُلاءِ بِكَ ""","","","","","The Book of the People of the Two Books"
"18640","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنْ أَبِي مِجْلَزٍ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ بَعَثَ عَمَّارَ بْنَ يَاسِرٍ ، وَعَبْدَ اللَّهِ بْنَ مَسْعُودٍ ، وَعُثْمَانَ بْنَ حُنَيْفٍ ، إِلَى الْكُوفَةِ ، فَجَعَلَ عَمَّارًا عَلَى الصَّلاةِ وَالْقِتَالِ , وَجَعَلَ عَبْدَ اللَّهِ عَلَى الْقَضَاءِ وَبَيْتِ الْمَالِ , وَجَعَلَ عُثْمَانَ بْنَ حُنَيْفٍ عَلَى مِسَاحَةِ الأَرْضِ , وَجَعَلَ لَهُمْ كُلَّ يَوْمٍ شَاةً نِصْفُهَا وَسَوَاقِطُهَا لِعَمَّارٍ , وَرُبْعُهَا لابْنِ مَسْعُودٍ , وَرُبْعُهَا لابْنِ حُنَيْفٍ , ثُمَّ قَالَ "" مَا أَرَى قَرْيَةً تُؤْخَذُ مِنْهَا كُلَّ يَوْمٍ شَاةٌ إِلا سَيَسْرُعُ ذَلِكَ فِيهَا "" , ثُمَّ قَالَ : "" أَنْزَلْتُكُمْ وَنَفْسِي مِنْ هَذَا الْمَالِ كَوَالِي الْيَتِيمِ  وَمَنْ كَانَ غَنِيًّا فَلْيَسْتَعْفِفْ وَمَنْ كَانَ فَقِيرًا فَلْيَأْكُلْ بِالْمَعْرُوفِ ""، فَقَسَمَ عُثْمَانُ عَلَى كُلِّ رَأْسٍ مِنْ أَهْلِ الذِّمَّةِ أَرْبَعَةً وَعِشْرِينَ دِرْهَمًا لِكُلِّ عَامٍ , وَلَمْ يَضْرِبْ عَلَى النِّسَاءِ وَالصِّبْيَانِ مِنْ ذَلِكَ شَيْئًا , ثُمَّ مَسَحَ سَوَادَ أَهْلِ الْكُوفَةِ مِنْ أَرْضِ أَهْلِ الذِّمَّةِ ، فَجَعَلَ عَلَى الْجَرِيبِ مِنَ النَّخْلِ عَشَرَةَ دَرَاهِمَ , وَعَلَى الْجَرِيبِ مِنَ الْعِنَبِ ثَمَانِيَةَ دَرَاهِمَ , وَعَلَى الْجَرِيبِ مِنَ الْقَصَبِ سِتَّةَ دَرَاهِمَ , وَعَلَى الْجَرِيبِ مِنَ الْبُرِّ أَرْبَعَةَ دَرَاهِمَ , وَعَلَى الْجَرِيبِ مِنَ الشَّعِيرِ دِرْهَمَيْنِ , فَرَضِيَ بِذَلِكَ عُمَرُ""","","","","","The Book of the People of the Two Books"
"18641","أَخْبَرَنَا مَعْمَرٌ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , أَنَّ إِبْرَاهِيمَ بْنَ سَعْدٍ , سَأَلَ ابْنَ عَبَّاسٍ ، وَكَانَ عَامِلا بِعَدَنَ ، فَقَالَ لابْنِ عَبَّاسٍ : مَا فِي أَمْوَالِ الذِّمَّةِ ؟ ، قَالَ : الْعَفْوُ , فَقَالَ : إِنَّهُمْ يَأْمُرُونَا بِكَذَا وَكَذَا ؟ ، قَالَ : "" فَلا تَعْمَلْ لَهُمْ "" , قُلْتُ : فَمَا فِي الْعَنْبَرِ ؟ قَالَ : "" إِنْ كَانَ فِيهِ شَيْءٌ فَالْخُمُسُ ""","","","","","The Book of the People of the Two Books"
"18642","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنْ رُزَيْقٍ صَاحِبِ مُكُوسِ مِصْرَ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ كَتَبَ إِلَيْهِ : مَنْ مَرَّ بِكَ مِنَ الْمُسْلِمِينَ وَمَعَهُ مَالٌ يَتَّجِرُ بِهِ , فَخُذْ مِنْهُ صَدَقَتَهُ ، مِنْ كُلِّ أَرْبَعِينَ دِينَارًا دِينَارًا , فَمَا نَقَصَ مِنْهُ إِلَى عِشْرِينَ , فَبِحِسَابِ ذَلِكَ , فَإِنْ نَقَصَ ثُلُثُ دِينَارٍ فَلا تَأْخُذْ مِنْهُ شَيْئًا , وَمَنْ مَرَّ بِكَ مِنْ أَهْلِ الْكِتَابِ وَأَهْلِ الذِّمَّةِ مِمَّنْ يَتَّجِرُ ، فَخُذْ مِنْهُ مِنْ كُلِّ عِشْرِينَ دِينَارًا دِينَارًا , فَمَا نَقَصَ فَبِحِسَابِ ذَلِكَ إِلَى عَشَرَةِ دَنَانِيرَ , فَإِنْ نَقَصَ ثُلُثُ دِينَارٍ فَلا تَأْخُذْ مِنْهُ شَيْئًا ""","","","","","The Book of the People of the Two Books"
"18643","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ أَيْضًا , أَنَّ أَوَّلَ مَنْ أَخَذَ نِصْفَ الْعُشُورِ مِنْ أَهْلِ الذِّمَّةِ إِذَا اتَّجَرُوا عُمَرُ بْنُ الْخَطَّابِ ، كَانَ يَأْخُذُ مِنْ تُجَّارِ أَنْبَاطِ أَهْلِ الشَّامِ إِذَا قَدِمُوا الْمَدِينَةَ ""","","","","","The Book of the People of the Two Books"
"18644","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ عَمْرِو ابْنِ شُعَيْبٍ , قَالَ :  كَتَبَ أَهْلُ مَنْبَجٍ وَمَنْ وَرَاءَ بَحْرِ عَدْنَ إِلَى عُمَرَ بْنِ الْخَطَّابِ يَعْرِضُونَ عَلَيْهِ أَنْيَدْخُلُوا بِتِجَارَتِهِمْ أَرْضَ الْعَرَبِ ، وَلَهُ مِنْهَا الْعُشُورُ , فَسَأَلَ عُمَرُ أَصْحَابَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , "" فَأَجْمِعُوا عَلَى ذَلِكَ ، فَهُوَ أَوَّلُ مِنْ أَخَذَ مِنْهُمُ الْعُشُورَ ""","","","","","The Book of the People of the Two Books"
"18645","أَخْبَرَنَا مَعْمَرٌ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , قَالَ : يُؤْخَذُ مِنْ أَهْلِ الْكِتَابِ الضِّعْفُ مِمَّا يُؤْخَذُ مِنَ الْمُسْلِمِينَ مِنَ الذَّهَبِ وَالْفِضَّةِ , فَعَلَ ذَلِكَ عُمَرُ بْنُ الْخَطَّابِ , وَعُمَرُ بْنُ عَبْدِ الْعَزِيزِ ""","","","","","The Book of the People of the Two Books"
"18646","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنْ أَبِيهِ ، أَنَّ عُمَرَ :  كَانَيَأْخُذُ مِنَ النَّبَطِ ، مِنَ الْحِنْطَةِ وَالزَّيْتِ الْعُشْرَ , يُرِيدُ بِذَلِكَ أَنْ يُكْثِرَ الْحَمْلَ , وَيَأْخُذُ مِنَ الْقِطْنِيَّةِ نِصْفَ الْعُشْرِ ""يَعْنِي : مِنَ الْحِمَّصِ وَالْعَدَسِ وَمَا أَشْبَهَهُمَا""","","","","","The Book of the People of the Two Books"
"18647","أَخْبَرَنَا سَعِيدُ بْنُ عَبْدِ الْعَزِيزِ التَّنُوخِيُّ ، قَالَ : أَخْبَرَنِي إِبْرَاهِيمُ بْنُ أَبِي عَبْلَةَ , قَالَ : كَانَتْ لِي أَرْضٌ بِجِزْيَتِهَا , فَكَتَبَ فِيهَا عَامِلِي إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، فَكَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ :  أَنِاقْبِضِ الْجِزْيَةَ وَالْعُشُورَ , ثُمَّ خُذْ مِنْهُ الْفَضْلَ ""يَعْنِي : أَنْ يَأْخُذَ مِنْهُ أَيُّهُمَا أَكْثَرُ""","","","","","The Book of the People of the Two Books"
"18648","أَخْبَرَنَا مَعْمَرٌ , عَنْ عَلِيِّ بْنِ الْحَكَمِ الْبُنَانِيِّ , عَنْ مُحَمَّدِ بْنِ زَيْدٍ , عَنْ إِبْرَاهِيمَ النَّخَعِيِّ ،  أَنَّ رَجُلا أَسْلَمَ عَلَى عَهْدِ عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ : ضَعُوا الْجِزْيَةَ عَنْ أَرْضِي , فَقَالَ لَهُ عُمَرُ : إِنَّأَرْضَكَ أُخِذَتْ عَنْوَةً "" , قَالَ : وَجَاءَ رَجُلٌ إِلَى عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ : إِنَّ أَهْلَ أَرْضِي كَذَا وَكَذَا ، يُطِيقُونَ مِنَ الْخَرَاجِ أَكْثَرَ مِمَّا عَلَيْهِمْ ، فَقَالَ : "" لَيْسَ إِلَيْهِمْ سَبِيلٌ ، إِنَّمَا صُولِحُوا صُلْحًا ""","","","","","The Book of the People of the Two Books"
"18649","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ ، أَنَّ رَجُلا مِنْ أَهْلِ نَجْرَانَ أَسْلَمَ , فَأَرَادُوا أَنْ يَأْخُذُوا مِنْهُ الْجِزْيَةَ ، أَوْ كَمَا قَالَ : فَأَبَى , فَقَالَ عُمَرُ : إِنَّمَا أَنْتَ مُتَعَوِّذٌ "" ، فَقَالَ الرَّجُلُ : إِنَّ فِي الإِسْلامِ لَمَعَاذًا إِنْ فَعَلْتُ , فَقَالَ عُمَرُ : "" صَدَقْتَ وَاللَّهِ ! إِنَّ فِي الإِسْلامِ لَمَعَاذًا ""","","","","","The Book of the People of the Two Books"
"18650","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : لا يَنْبَغِي لِمُسْلِمٍ أَنْ يُعْطِيَ الْجِزْيَةَ أَنْ يُقِرَّ بِالصَّغَارِ وَالذُّلِّ "", سَمِعْتُ غَيْرَ وَاحِدٍ يَذْكُرُ ذَلِكَ""","","","","","The Book of the People of the Two Books"
"18651","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ حَبِيبِ ابْنِ أَبِي ثَابِتٍ , قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ وَأَتَاهُ رَجُلٌ , فَقَالَ :  آخُذُ الأَرْضَ فَأَتَقَبَّلُهَا أَرْضَ جِزْيَةٍ ، فَأُعَمِّرُهَا وَأُؤَدِّي خَرَاجَهَا ، فَنَهَاهُ , ثُمَّ جَاءَهُ آخَرُ فَنَهَاهُ , ثُمَّ جَاءَهُ آخَرُ فَنَهَاهُ , ثُمَّ قَالَ :لا تَعْمَدْ إِلَى مَا وَلَّى اللَّهُ هَذَا الْكَافِرَ ، فَتُحِلَّهُ مِنْ عُنُقِهِ وَتَجْعَلُهُ فِي عُنُقِكَ , ثُمَّ تَلا :  قَاتِلُوا الَّذِينَ لا يُؤْمِنُونَ بِاللَّهِ  حَتَّى صَاغِرُونَ ""","","","","","The Book of the People of the Two Books"
"18652","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ كُلَيْبِ بْنِ وَائِلٍ , قَالَ : سَأَلْتُ ابْنَ عُمَرَ : كَيْفَ تَرَى فِي شِرَاءِ الأَرْضِ ؟ ، قَالَ : حَسَنٌ "" , قُلْتُ : يَأْخُذُونَ مِنِّي مِنْ كُلِّ جَرِيبٍ قَفِيزًا وَدِرْهَمًا , قَالَ : "" تُجْعَلُ فِي عُنُقِكَ صَغَارًا ""","","","","","The Book of the People of the Two Books"
"18653","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ جَعْفَرِ بْنِ بُرْقَانَ , قَالَ : أَخْبَرَنَا مَيْمُونُ بْنُ مِهْرَانَ , قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، يَقُولُ : مَا أُحِبُّ أَنَّ الأَرْضَ كُلَّهَا لِي جِزْيَةٌ بِخَمْسَةِ دَرَاهِمَ ، أُقِرُّ فِيهَا بِالصَّغَارِ ""","","","","","The Book of the People of the Two Books"
"18654","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ الْحَسَنِ , قَالَ : كَتَبَ عُمَرُ بْنُ الْخَطَّابِ : أَلا تَشْتَرُوا مِنْ عَقَّارِ أَهْلِ الذِّمَّةِ ، وَلا مِنْ بِلادِهِمْ شَيْئًا ""","","","","","The Book of the People of the Two Books"
"18655","أَخْبَرَنَا معمر , عَمَّنْ ، سَمِعَ الْحَسَنَ ، قَالَ :  فِيالْمُرْتَدِّ مِيرَاثُهُ لِلْمُسْلِمِينَ , وَقَدْ كَانُوا يُطَيِّبُونَهُ لِوَرَثَتِهِ ، قَالَ : وَقَالَ قَتَادَةُ : "" مِيرَاثُهُ لأَهْلِ دِينِهِ ""","","","","","The Book of the People of the Two Books"
"18656","أَخْبَرَنَا معمر , عَنْ إِسْحَاقَ بْنِ رَاشِدٍ , أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ كَتَبَ فِي رَجُلٍ مِنَ الْمُسْلِمِينَ أُسِرَ , فَتَنَصَّرَ : إِذَا عُلِمَ بِذَلِكَ بَرِئَتْ مِنْهُ امْرَأَتُهُ , وَاعْتَدَّتْ مِنْهُ ثَلاثَةَ قُرُوءٍ ، وَدُفِعَ مَالُهُ إِلَى وَرَثَتِهِ الْمُسْلِمِينَ ""","","","","","The Book of the People of the Two Books"
"18657","أَخْبَرَنَا الثَّوْرِيُّ :  فِيالْمُرْتَدِّ إِذَا قُتِلَ فَمَالُهُ لِوَرَثَتِهِ , وَإِذَا لَحِقَ بِأَرْضِ الْحَرْبِ فَمَالُهُ لِلْمُسْلِمِينَ ، لا أَعْلَمُهُ إِلا قَالَ : إِلا أَنْ يَكُونَ لَهُ وَارِثٌ عَلَى دِينِهِ فِي أَرْضٍ ، فَهُوَ أَحَقُّ بِهِ ""","","","","","The Book of the People of the Two Books"
"18658","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ ، أَنَّ عُمَرَ ، قَالَ : أَهْلُ الشِّرْكِ نَرِثُهُمْ وَلا يَرِثُونَا ""","","","","","The Book of the People of the Two Books"
"18659","أَخْبَرَنَا عَبْدُ الْمَلِكِ الذِّمَارِي , عَنِ الثَّوْرِيِّ ، عَنْ مُوسَى بْنِ أَبِي كَثِيرٍ , قَالَ :  سَأَلْتُ ابْنَ الْمُسَيِّبِ عَنِالْمُرْتَدِّ ، كَمْ تَعْتَدُّ امْرَأَتُهُ ؟ ، قَالَ : ثَلاثَةَ قُرُوءٍ ، قُلْتُ : إِنَّهُ قُتِلَ ؟ ، قَالَ : "" فَأَرْبَعَةَ أَشْهُرٍ وَعَشْرًا ، قُلْتُ : أَيُوصَلُ مِيرَاثُهُ ؟ ، قَالَ : مَا يُوصَلُ مِيرَاثُهُ ، قُلْتُ : وَيَرِثُهُ بَنُوهُ ؟ ، قَالَ : "" نَرِثُهُمْ وَلا يَرِثُونَا ""","","","","","The Book of the People of the Two Books"
"18660","أَخْبَرَنَا مَعْمَرٌ , عَنِ الأَعْمَشِ , عَنْ أَبِي عَمْرٍو الشَّيْبَانِيِّ , قَالَ : أُتِيَ عَلِيٌّ بِشَيْخٍ كَانَ نَصْرَانِيًّا , فَأَسْلَمَ ، ثُمَّ ارْتَدَّ عَنِ الإِسْلامِ , فَقَالَ لَهُ عَلِيٌّ : لَعَلَّكَ إِنَّمَا ارْتَدَتَّ لأَنْ تُصِيبَ مِيرَاثًا , ثُمَّ تَرْجِعَ إِلَى الإِسْلامِ ؟ ، قَالَ : لا , قَالَ : فَارْجِعْ إِلَى الإِسْلامِ "" , قَالَ : أَمَا حَتَّى أَلْقَى الْمَسِيحَ فَلا , فَأَمَرَ بِهِ عَلِيٌّ فَضُرِبَتْ عُنُقُهُ ، وَدُفِعَ مِيرَاثُهُ إِلَى وَلَدِهِ الْمُسْلِمِينَ "", أَخْبَرَنَا مَعْمَرٌ , وَابْنُ جُرَيْجٍ , قَالا : بَلَغَنَا أَنَّ ابْنَ مَسْعُودٍ , قَالَ : فِي مِيرَاثِ الْمُرْتَدِّ مِثْلَ قَوْلِ عَلِيٍّ""","","","","","The Book of the People of the Two Books"
"18661","أَخْبَرَنَا معمر , قَالَ قَتَادَةُ : مِيرَاثُهُ لأَهْلِ دِينِهِ ""","","","","","The Book of the People of the Two Books"
"18662","أَخْبَرَنَا عَبْدُ الْمَلِكِ الذِّمَارِيُّ , عَنِ الثَّوْرِيِّ ، عَنْ عَمْرِو بْنِ عُبَيْدٍ , عَنِ الْحَسَنِ , قَالَ :  كَانَالْمُسْلِمُونَ يُطَيِّبُونَ لِوَرَثَةِ الْمُرْتَدِّ مِيرَاثَهُ ""","","","","","The Book of the People of the Two Books"
"18663","أَخْبَرَنَا عَبْدُ الْمَلِكِ الذِّمَارِي , عَنِ الثَّوْرِيِّ , قَالَ : بَلَغَنَا أَنَّ عَلِيًّا وَرَّثَ وَرَثَةَ مُسْتَوْرِدٍ الْعِجْلِيِّ مَالَهُ ""","","","","","The Book of the People of the Two Books"
"18664","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ سَعِيدٍ , عَنِ الْحَجَّاجِ , عَنِ الْحَكَمِ , أَنَّ عَلِيًّا ، قَالَ : مِيرَاثُ الْمُرْتَدِّ لِوَلَدِهِ ""","","","","","The Book of the People of the Two Books"
"18665","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : النَّاسُ فَرِيقَانِ , فَرِيقٌ يَقُولُ : مِيرَاثُ الْمُرْتَدِّ لِلْمُسْلِمِينَ ، لأَنَّهُ سَاعَةَ يَكْفُرُ يُوقَفُ عَنْهُ ، فَلا يُقْدَرُ مِنْهُ عَلَى شَيْءٍ حَتَّى يُنْظَرَ أَيُسْلِمُ أَمْ يَكْفُرُ ، مِنْهُمُ النَّخَعِيُّ , وَالشَّعْبِيُّ , وَالْحَكَمُ بْنُ عُتَيْبَةَ "" ، وَفَرِيقٌ يَقُولُونَ : "" لأَهْلِ دِينِهِ ""","","","","","The Book of the People of the Two Books"
"18666","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ لِي عَطَاءٌ : لا يَرِثُ مُسْلِمٌ كَافِرًا , وَلا كَافِرٌ مُسْلِمًا "" , وَقَالَ ذَلِكَ عَمْرُو بْنُ دِينَارٍ""","","","","","The Book of the People of the Two Books"
"18667","أَخْبَرَنَا مَعْمَرٌ , وَابْنُ جُرَيْجٍ , عَنِ ابْنِ شِهَابٍ , عَنْ عَلِي بْنِ حُسَيْنٍ , عَنْ عَمْرِو بْنِ عُثْمَانَ , عَنْ أُسَامَةَ بْنِ زَيْدٍ , أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : لا يَرِثُ الْمُسْلِمُ الْكَافِرَ , وَلا الْكَافِرُ الْمُسْلِمَ ""","","","","","The Book of the People of the Two Books"
"18668","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ عَمْرِو بْنِ شُعَيْبٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَتَوَارَثُ أَهْلُ مِلَّتَيْنِ شَتَّى ""","","","","","The Book of the People of the Two Books"
"18669","قَالَ : وَقَضَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَتَوَارَثُ الْمُسْلِمُونَ وَالنَّصَارَى وَأَبُو بَكْرٍ , وَعُمَرُ , وَعُثْمَانُ ""","","","","","The Book of the People of the Two Books"
"18670","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مَيْمُونُ بْنُ مِهْرَانَ , عَنْ رَجُلٍ مِنْ كِنْدَةَ يُقَالُ لَهُ : الْعُرْسُ بْنُ قَيْسٍ ، قَالَ : شَيْخٌ كَبِيرٌ كَانَ يُسْتَعْمَلُ عَلَى الْحِيرَةِ فَأَخْبَرَنِي ، أَنَّهُ أَخْبَرَهُ أَنَّالأَشْعَثَ بْنَ قَيْسٍ مَاتَتْ عَمَّةٌ لَهُ يَهُودِيَّةٌ , فَجَاءَ عُمَرَ بْنَ الْخَطَّابِ فِي مِيرَاثِهَا يَطْلُبُهُ ,  فَأَبَى عُمَرُ أَنْ يُورِّثَهُ إِيَّاهَا ، وَوَرَّثَهَا الْيَهُودَ ""","","","","","The Book of the People of the Two Books"
"18671","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي يَحْيَى بْنُ سَعِيدٍ ، قَالَ : سَمِعْتُ سُلَيْمَانَ بْنَ يَسَارٍ يَذْكُرُ , أَنَّ مُحَمَّدَ بْنَ الأَشْعَثِ أَخْبَرَهُ , أَنَّ عَمَّةً لَهُ تُوُفِّيَتْ يَهُودِيَّةٌ , فَذَكَرَ ذَلِكَ الأَشْعَثُ لِعُمَرَ , فَقَالَ : لا يَرِثُهَا إِلا أَهْلُ دِينِهَا ""","","","","","The Book of the People of the Two Books"
"18672","أَخْبَرَنَا معمر , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ ، قَالَ : لا يَتَوَارَثُ أَهْلُ مِلَّتَيْنِ شَتَّى ""","","","","","The Book of the People of the Two Books"
"18673","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , أَوْ غَيْرِهِ , أَنَّ عُمَرَ ، قَالَ : لا يَرِثُ أَهْلُ الْمِلَلِ ، وَلا يَرِثُونَا ""","","","","","The Book of the People of the Two Books"
"18674","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : لا يَرِثُ الْيَهُودُ , وَلا النَّصَارَى الْمُسْلِمِينَ , وَلا يَرِثُونَهُمْ ، إِلا أَنْ يَكُونَ عَبْدَ الرَّجُلِ أَوْ أَمَتَهُ ""","","","","","The Book of the People of the Two Books"
"18675","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : أَخْبَرَنِي مِنْ , سَمِعَ عِكْرِمَةَ :  وَسُئِلَ عَنْرَجُلٍ أَعْتَقَ عَبْدًا لَهُ نَصْرَانِيًّا , فَمَاتَ الْعَبْدُ وَتَرَكَ مَالا , قَالَ : مِيرَاثُهُ لأَهْلِ دِينِهِ ""","","","","","The Book of the People of the Two Books"
"18676","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : حُدِّثْتُ ، عَنْ مَكْحُولٍ ، قَالَ :  إِنْمَاتَ عَبْدٌ لَكَ نَصْرَانِيًّا , فَوَجَدْتَ لَهُ ذَهَبًا عَيْنًا ثَمَنَ الْخَمْرِ وَالْخَنَازِيرِ فَخُذْهَا , وَإِنْ وَجَدْتَ خَمْرًا أَوْ خِنْزِيرًا فَلا , فَإِنْ لَمْ يَكُنْ لَهُ أَقَارِبُ وَرِثَهُ الْمُسْلِمُ بِالإِسْلامِ ""","","","","","The Book of the People of the Two Books"
"18677","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ عَلِي بْنِ حُسَيْنٍ ,  أَنَّ أَبَا طَالِبٍ ،وَرِثَهُ عَقِيلٌ وَطَالِبٌ ، وَلَمْ يَرِثْهِ عَلِي وَلا جَعْفَرٌ ، لأَنَّهُمَا كَانَا مُسْلِمَيْنِ ""","","","","","The Book of the People of the Two Books"
"18678","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ عَمْرِو بْنِ شُعَيْبٍ يَرْفَعُهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَنَّالْمُسْلِمَ لا يَرِثُ الْكَافِرَ , مَا كَانَ لَهُ ذُو قَرَابَةٍ مِنْ أَهْلِ دِينِهِ ""","","","","","The Book of the People of the Two Books"
"18679","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ عَمْرِو بْنِ شُعَيْبٍ يَرْفَعُهُ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  أَنَّالْمُسْلِمَ لا يَرِثُ الْكَافِرَ , مَا كَانَ لَهُ ذُو قَرَابَةٍ مِنْ أَهْلِ دِينِهِ , فَإِنْ لَمْ يَكُنْ لَهُ وَارِثٌ وَرِثَهُ الْمُسْلِمُ بِالإِسْلامِ ""","","","","","The Book of the People of the Two Books"
"18680","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ عَطَاءٌ , وَابْنُ أَبِي لَيْلَى :  إِنْمَاتَ مُسْلِمٌ وَلَهُ وَلَدُ نَصَارَى فَلَمْ يُقْسَمْ مَالُهُ حَتَّى أَسْلَمَ وَلَدُهُ النَّصَارَى فَلا حَقَّ لَهُمْ , وَقَعَتِ الْمَوَارِيثُ قَبْلَ أَنْ يُسْلِمُوا "" , قَالَ : "" وَكَذَلِكَ الْعَبْدُ يَمُوتُ أَبُوهُ الْحُرُّ ، فَلا يُقْسَمُ مِيرَاثُهُ حَتَّى يُعْتَقَ ""، أَخْبَرَنَا عَبْدُ الْمَلِكِ بْنُ الصَّبَّاحِ , عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ ، مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18681","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ ، قَالَ : سَمِعْتُ أَبَا الشَّعْثَاءِ , يَقُولُ :  إِنْمَاتَ مُسْلِمٌ وَلَهُ وَلَدٌ مُسْلِمٌ وَكَافِرٌ ، فَلَمْ يُقْسَمْ مِيرَاثُهُ حَتَّى أَسْلَمَ الْكَافِرُ , وَرِثَهُ مَعَ الْمُؤْمِنِ وَرِثَا جَمِيعًا ، فَلَمْ يُعْجِبْنِي ""","","","","","The Book of the People of the Two Books"
"18682","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : سَمِعْتُ الزُّهْرِيَّ , يَقُولُ : إِذَا وَقَعَتِ الْمَوَارِيثُ فَمَنْ أَسْلَمَ عَلَى مِيرَاثٍ فَلا شَيْءَ لَهُ ""","","","","","The Book of the People of the Two Books"
"18683","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , عَنْ رَجُلٍ كَتَبَ إِلَيْهِ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ , أَمَّا بَعْدُ ! فَإِنَّكَ كَتَبْتَ إِلَيّ أَنْ أُرْسِلَ يَزِيدَ بْنَ قَتَادَةَ الْعَنَزِيَّ , وَإِنِّي سَأَلْتُهُ , فَقَالَ : تُوُفِّيَتْ أُمِّي نَصْرَانِيَّةٌ وَأَنَا مُسْلِمٌ , وَإِنَّهَا تَرَكَتْ ثَلاثِينَ عَبْدًا وَوَلِيدَةً , وَمِائَتَيْ نَخْلَةٍ , فَرَكِبْنَا فِي ذَلِكَ إِلَى عُمَرَ بْنِ الْخَطَّابِ  فَقَضَى : أَنَّ مِيرَاثَهَا لِزَوْجِهَا وَلابْنِ أَخِيهَا ، وَهُمَا نَصْرَانِيَّانِ , وَلَمْ يُورِّثْنِي شَيْئًا "" , فَقَالَ يَزِيدُ بْنُ قَتَادَةَ : تُوُفِّيَ جَدِّي وَهُو مُسْلِمٌ ، وَكَانَ بَايَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَشَهِدَ مَعَهُ حُنَيْنًا ، وَتَرَكَ ابْنَتَهُ , فَوَرَّثَنِي عُثْمَانُ مَالَهُ كُلَّهُ ، وَلَمْ يُورِّثِ ابْنَتَهُ شَيْئًا , فَأَحْرَزْتُ الْمَالَ عَامًا أَوْ عَامَيْنِ , ثُمَّ أَسْلَمَتِ ابْنَتَهُ , فَرَكِبْتُ إِلَى عُثْمَانَ ، فَسَأَلَ عَبْدَ اللَّهِ بْنَ الأَرْقَمِ ، فَقَالَ لَهُ : كَانَ عُمَرُ يَقْضِي :"" مِنْ أَسْلَمَ عَلَى مِيرَاثٍ قَبْلَ أَنْ يُقْسَمَ بِأَنَّ لَهُ مِيرَاثًا وَاجِبًا بِإِسْلامِهِ , فَوَرَّثَهَا عُثْمَانُ نَصِيبَهَا مِنَ الأَوَّلِ "", كُلُّ ذَلِكَ وَأَنَا شَاهِدٌ""","","","","","The Book of the People of the Two Books"
"18684","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ لِي عَطَاءٌ وَسَأَلْتُهُ , فَقَالَ :  إِنْ كَانَنَصْرَانِيَّانِ فَأَسْلَمَ أَحَدُهُمَا وَلَهُمَا أَوْلادٌ صِغَارٌ , فَمَاتَ أَوْلادُهُمْ وَلَهُمْ مَالٌ , فَلا يَرِثُهُمْ أَبُوهُمُ الْمُسْلِمُ ، وَلَكِنْ تَرِثُهُمْ أُمُّهُمْ , وَمَا بَقِيَ فَلأَهْلِ دِينِهِمْ "" قُلْتُ : إِنَّهُمْ صِغَارٌ لا دِينَ لَهُمْ ؟ قَالَ : "" وَلَكِنْ وُلِدُوا فِي النَّصْرَانِيَّةِ عَلَى النَّصْرَانِيَّةِ وَلَقَدْ كَانَ , قَالَ لِي مَرَّةً : يَرِثُهُمُ الْمُسْلِمُ مِيرَاثَهُ مِنْ أَبَوَيْهِ , وَلا أَعْلَمُهُ إِلا قَدْ قَالَ : يَرِثُهُمَا وَلَدُهُمَا الصَّغِيرُ وَيَرِثَانِهِ ، حَتَّى يَجْمَعَ بَيْنَهُمَا دِينٌ , أَوْ يُفَرِّقَ "" وَقَدْ ذَكَرْتُهُمَا لِعَمْرِو بْنِ دِينَارٍ ، قُلْتُ : أَبَوَاهُ نَصْرَانِيَّانِ ؟ قَالَ : "" كُنْتُ مُعْطِيًا مَالَهُمَا وَلَدَهُمَا "" قُلْتُ لِعَمْرٍو : فَكَيْفَ وَالْوَلَدُ عَلَى الْفِطْرَةِ ؟ ، قَالَ : "" فَلِمَ تُسْبَى إِذًا أَوْلادُ أَهْلِ الشِّرْكِ وَهُمْ عَلَى الْفِطْرَةُ , وَهُمْ مُسْلِمُونَ ؟ "" فَسَكَتُّ""","","","","","The Book of the People of the Two Books"
"18685","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : سَمِعْتُ سُلَيْمَانَ بْنَ مُوسَى , يُخْبِرُ عَطَاءً ، قَالَ : الأَمْرُ الَّذِي مَضَى فِي أَوَّلِنَا ، الَّذِي يُعْمَلُ بِهِ ، وَلا نَشُكُّ فِيهِ ، وَنَحْنُ عَلَيْهِ ، أَنَّ النَّصْرَانِيَّيْنِ بَيْنَهُمَا وَلَدُهُمَا صَغِيرٌ , أَنَّهُمَا يَرِثَانِهِ وَيَرِثُهُمَا ، حَتَّى يُفَرَّقَ بَيْنَهُمَا دِينٌ أَوْ يَجْمَعَ , فَإِنْ أَسْلَمَتْ أُمُّهُ وَرِثَتْهِ بِكِتَابِ اللَّهِ , وَمَا بَقِيَ لِلْمُسْلِمِينَ , وَإِنْ كَانَ أَبَوَاهُ نَصْرَانِيَّيْنِ وَهُو صَغِيرٌ ، وَلَهُ أَخٌ مِنْ أُمِّهِ مُسْلِمٌ أَوْ أُخْتٌ مُسْلِمَةٌ وَرِثَهُ أَخُوهُ أَوْ أُخْتُهُ بِكِتَابِ اللَّهِ , ثُمَّ كَانَ مَا بَقِيَ لِلْمُسْلِمِينَ "" , قَالَ : "" وَلا يُصَلَّى عَلَى أَبْنَاءِ النَّصَارَى ، وَلا يَتَّبِعُوهُمْ إِلَى قُبُورِهِمْ , وَيَدْفِنُهُمْ فِي مَقْبَرَتِهِمْ ، وَإِنْ قَتَلَ مُسْلِمٌ مِنْ أَبْنَائِهِمْ عَمْدًا لَمْ يُقْتَلْ بِهِ ، وَكَانَتْ دِيَتُهُ دِيَةَ نَصَارَى ""","","","","","The Book of the People of the Two Books"
"18686","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قُلْتُ لِسُلَيْمَانَ : فَوَلَدٌ صَغِيرٌ بَيْنَ مُشْرِكَيْنِ , فَأَسْلَمَ أَحَدُهُمَا وَوَلَدُهُمَا ، صَغِيرٌ فَمَاتَ أَبُوهُمْ ؟ : قَالَ : "" يَرِثُ وَلَدُهُمَا الْمُسْلِمُ مِنْ أَبَوَيْهِ , وَلا يَرِثُ الْكَافِرُ مِنْهُمَا ، الْوِرَاثَةُ حِينَئِذٍ بَيْنَ الْوَلَدِ وَبَيْنَ الْمُسْلِمِ , وَلا يَرِثُ الْكَافِرُ حِينَئِذٍ مِنْ أَبَوَيْهِ شَيْئًا ""","","","","","The Book of the People of the Two Books"
"18687","أَخْبَرَنَا مَعْمَرُ ، عَنْ رَجُلٍ , عَنِ الْحَسَنِ , وَعَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قَالا : أوْلاهُمَا بِهِ الْمُسْلِمُ يَرِثَانِهِ وَيَرِثُهُمَا ""، أَخْبَرَنَا الثَّوْرِيُّ , عَنْ يُونُسَ , عَنِ الْحَسَنِ , مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18688","قَالَ الثَّوْرِيُّ :  فِينَصْرَانِيٍّ مَاتَ وَامْرَأَتُهُ حُبْلَى , ثُمَّ أَسْلَمَتْ قَبْلَ أَنْ تَلِدَ , ثُمَّ وَلَدَتْ فَمَاتَتْ , قَالَ : يَرِثُهُمَا وَلَدُهُمَا جَمِيعًا ، لأَنَّهُ وَقَعَ لَهُ مِيرَاثُ أَبِيهِ حِينَ مَاتَ أَبُوهُ , ثُمَّ مَاتَتْ أُمُّهُ , فَأَتْبَعَهَا عَلَى مِلَّتِهَا ، فَوَرِثَهَا ""","","","","","The Book of the People of the Two Books"
"18689","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنْ عِكْرِمَةَ ، قَالَ :  بَاعَتْ صَفِيَّةُ زَوْجُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دَارًا لَهَا مِنْ مُعَاوِيَةَ بِمِائَةِ أَلْفٍ , فَقَالَتْ لِذِي قَرَابَةٍ لَهَا مِنَ الْيَهُودِ :أَسْلِمْ , فَإِنَّكَ إِنْ أَسْلَمْتَ وَرِثْتَنِي ، فَأَبَى ، فَأَوْصَتْ بِهِ ""، قَالَ بَعْضُهُمْ : بِثَلاثِينَ أَلْفًا""","","","","","The Book of the People of the Two Books"
"18690","قَالَ ابْنُ جُرَيْجٍ ، قَالَ لِي مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى :  فِيأَهْلِ بَيْتٍ مِنْ يَهُودَ مَاتَ أَبُوهُمْ وَلَمْ يُقْسَمْ مِيرَاثُهُ حَتَّى أَسْلَمُوا "" لَيْسَ عَلَى قِسْمَةِ الإِسْلامِ , وَقَعَتِ الْمَوَارِيثُ قَبْلَ أَنْ يُسْلِمُوا ""","","","","","The Book of the People of the Two Books"
"18691","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ أَبِي الشَّعْثَاءِ ، قَالَ : إِذَا مَاتَ الرَّجُلُ وَتَرَكَ ابْنَهُ عَبْدًا , فَأُعْتِقَ قَبْلَ أَنْ يُقْسَمَ الْمِيرَاثُ فَلَهُ , يَقُولُ : يَرِثُ ""","","","","","The Book of the People of the Two Books"
"18692","أَخْبَرَنَا مَعْمَرٌ , عَنِ ابْنِ طَاوُسٍ , عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ , وَمُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ جَابِرِ بْنِ زَيْدٍ , قَالا : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَا كَانَ مِنْ قَسْمٍ فِي الْجَاهِلِيَّةِ فَهُو عَلَى قِسْمَةِ الْجَاهِلِيَّةِ , وَمَا أَدْرَكَ الإِسْلامُ لَمْ يُقْسَمْ فَهُو عَلَى قِسْمَةِ الإِسْلامِ ""، أَخْبَرَنَا مَعْمَرٌ , عَنِ ابْنِ جُرَيْجٍ , عَنْ سُلَيْمَانَ بْنِ مُوسَى , عَنْ نَافِعٍ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18693","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , وَعَنْ أَيُّوبَ , عَنْ أَبِي قِلابَةَ , أَنَّ عُمَرَ بْنَ الْخَطَّابِ ، قَالَ : مِنْ أَسْلَمَ عَلَى مِيرَاثٍ قَبْلَ أَنْ يُقْسَمَ وَرِثَ مِنْهُ ""","","","","","The Book of the People of the Two Books"
"18694","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ , عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : إِذَا مَاتَ الرَّجُلُ وَتَرَكَ ابْنَهُ عَبْدًا ، فَأُعْتِقَ قَبْلَ أَنْ يُقْسَمَ الْمِيرَاثُ , فَلا شَيْءَ لَهُ ""","","","","","The Book of the People of the Two Books"
"18695","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ أَنَا وَمُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى :  إِنْتَزَوَّجَ الْمَجُوسِيُّ ابْنَتَهُ , فَوَلَدَتْ لَهُ ابْنَتَيْنِ , فَمَاتَ ، ثُمَّ أَسْلَمْنَ , فَمَاتَتْ إِحْدَى ابْنَتَيِ ابْنَتِهِ ، فَلأُخْتِهَا لأَبِيهَا وَأُمِّهَا الشَّطْرُ ، وَلأُمِّهَا السُّدُسُ ، حَجَبْتَهَا نَفْسُهَا مِنْ أَجْلِ أَنَّهَا أُخْتُ ابْنَتِهَا ، وَحَجَبَتْهَا ابْنَتُهَا الْبَاقِيَةُ ، أُخْتُ ابْنَتِهَا , ثُمَّ لِلأُمِّ أَيْضًا مَا لِلأُخْتِ مِنَ الأَبِ "" ، وَقَالَ الثَّوْرِيُّ مِثْلَ قَوْلِهِمَا : "" لأُخْتِهَا لأَبِيهَا وَأُمِّهَا النِّصْفُ ، وَلِلأُخْتِ مِنَ الأَبِ السُّدُسُ تَكْمِلَةَ الثُّلُثَيْنِ , وَهِيَ الأُمُّ ، وَلَهَا السُّدُسُ لأَنَّهَا أُمٌّ حَجَبَتْ نَفْسَهَا ، وَلأَنَّهَا أُخْتٌ ، فَصَارَ لَهَا الثُّلُثُ ""","","","","","The Book of the People of the Two Books"
"18696","أَخْبَرَنَا معمر , عَنْ قَتَادَةَ , وَعَمْرُو بْنُ عُبَيْدٍ , قَالا : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ إِلَى عَدِيِّ بْنِ أَرْطَاةَ ،  أَنْ سَلِ الْحَسَنَ بْنَ عَلِيٍّ ، عَنِالْمَجُوسِ وَالأُمَّهَاتِ , فَسَأَلْتُهُ , فَقَالَ : وَنِكَاحِ الأَخَوَاتِ الشِّرْكُ الَّذِي هُمْ عَلَيْهِ أَعْظَمُ مِنْ ذَلِكَ , وَإِنَّمَا خُلِّيَ بَيْنَهُمْ وَبَيْنَهُ مِنْ أَجْلِ الْجِزْيَةِ ""","","","","","The Book of the People of the Two Books"
"18697","أَخْبَرَنَا الثَّوْرِيُّ , عَنِ الشَّعْبِيِّ ,  أَنَّ عَلِيًّا ، وَابْنَ مَسْعُودٍ ، قَالا : "" فِيالْمَجُوسِيِّ يَرِثُ مِنْ مَكَانَيْنِ ""","","","","","The Book of the People of the Two Books"
"18698","أَخْبَرَنَا معمر , عَنِ الزُّهْرِيِّ :  فِيالْمَجُوسِيِّ , قَالَ : نُورِّثُهُمْ بِأَقْرَبِ الأَرْحَامِ إِلَيْهِ ""، قَالَ الثَّوْرِيُّ فِي مَجُوسِيٍّ تَزَوَّجَ أُخْتَهُ ، فَوَلَدَتْ لَهُ بِنْتًا , فَأَسْلَمُوا ثُمَّ مَاتَ , قَالَ : "" بِنْتُهُ تَرِثُ النِّصْفَ , وَالنِّصْفُ لأُخْتِهِ لأَنَّهَا عَصَبَةٌ , وَقَالَ فِي مَجُوسِيٍّ تَزَوَّجَ أُمَّهُ فَوَلَدَتْ بِنْتَيْنِ , فَأَسْلَمُوا ، فَمَاتَ الرَّجُلُ : لابْنَتَيْهِ الثُّلُثَانِ ، وَلأُمِّهِ السُّدُسُ , ثُمَّ مَاتَتْ إِحْدَى الْبِنْتَيْنِ تَرِثُ ابْنَتُهَا النِّصْفَ , وَالأُمُّ صَارَتْ أُمًّا وَجَدَّةً ، فَحَجَبَتْهَا نَفْسُهَا , فَوَرَّثْنَاهَا مِيرَاثَ الأُمِّ ، وَلا نُعْطِيهَا مِيرَاثَ الْجَدَّةِ , نَقُولُ : لأَنَّ الأُمَّ حِينَ أَسْلَمُوا انْفَسَخَ النِّكَاحُ ، فَلا يَنْبَغِي لَهُ أَنْ يُقِيمَ بَعْدَ الإِسْلامِ عَلَى أُمِّهِ ، وَلا عَلَى أُخْتِهِ وَرَّثْنَاهُ بِالْقَرَابَةِ ""","","","","","The Book of the People of the Two Books"
"18699","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ :  مَا قَوْلُهُ : إِلا أَنْ تَفْعَلُوا إِلَى أَوْلِيَائِكُمْ مَعْرُوفًا ؟ ، قَالَ : الْعَطَاءُ "" , قُلْتُ : عَطَاءُ الْمُؤْمِنِ الْكَافِرَ بَيْنَهُمَا قَرَابَةٌ ؟ ، قَالَ : "" نَعَمْ , عَطَاؤُهُ إِيَّاهُ حَيًّا ، وَوَصِيَّتُهُ لَهُ ""","","","","","The Book of the People of the Two Books"
"18700","أَخْبَرَنَا معمر , عَنْ قَتَادَةَ :  فِي قَوْلِهِ : إِلا أَنْ تَفْعَلُوا إِلَى أَوْلِيَائِكُمْ مَعْرُوفًا ، قَالَ : إِلا أَنْ يَكُونَ لَكَ ذُو قَرَابَةٍ لَيْسَ عَلَى دِينِكَ فَتُوصِي لَهُ بِالشَّيْءِ ، هُوَ وَلِيُّكَ فِي النَّسَبِ ، وَلَيْسَ وَلِيَّكَ فِي الدِّينِ ""وَقَالَ الْحَسَنُ مِثْلَ ذَلِكَ""","","","","","The Book of the People of the Two Books"
"18701","أَخْبَرَنِي هِشَامُ بْنُ عُرْوَةَ , عَنْ أَبِيهِ , عَنْ أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ , قَالَتْ :  قَدِمَتْ أُمِّي وَهِيَ مُشْرِكَةٌ فِي عَهْدِ قُرَيْشٍ ، إِذْ عَاهَدُوا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَمَدَّتْهُمْ ، فَاسْتَفْتَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقُلْتُ : إِنَّأُمِّي قَدِمَتْ وَهِيَ رَاغِبَةٌ أَفَأَصِلُهَا ؟ ، قَالَ : "" نَعَمْ ، صِلِي أُمَّكَ ""","","","","","The Book of the People of the Two Books"
"18702","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ ، قَالَ : تَجُوزُ وَصِيَّةُ الْمُسْلِمِ لِلنَّصْرَانِيِّ ""","","","","","The Book of the People of the Two Books"
"18703","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ لَيْثٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ ،  أَنَّ صَفِيَّةَ زَوْجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَأَوْصَتْ لِنَسِيبٍ لَهَا نَصْرَانِيٍّ ""","","","","","The Book of the People of the Two Books"
"18704","قَالَ الثَّوْرِيُّ : لا تَجُوزُ وَصِيَّةٌ لأَهْلِ الْحَرْبِ ""","","","","","The Book of the People of the Two Books"
"18705","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ لَيْثٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ ،  أَنَّ صَفِيَّةَ زَوْجَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَأَوْصَتْ لِنَسِيبٍ لَهَا يَهُودِيٍّ ""","","","","","The Book of the People of the Two Books"
"18706","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قُلْتُ لِعَطَاءٍ : أَيُبَاعُ الْعَبْدُ الْمُسْلِمُ مِنَ الْكَافِرِ ؟ ، قَالَ : "" لا ، رَأْيًا ""، وَقَالَ لِي عَمْرُو بْنُ دِينَارٍ : "" لا ، رَأْيًا ""","","","","","The Book of the People of the Two Books"
"18707","قَالَ ابْنُ جُرَيْجٍ , وَسَمِعْتُ سُلَيْمَانَ بْنَ مُوسَى , يَقُولُ : لا يَسْتَرِقُّ عِنْدَنَا كَافِرٌ مُسْلِمًا ""","","","","","The Book of the People of the Two Books"
"18708","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : سُئِلَ ابْنُ شِهَابٍ :  عَنْنَصْرَانِيٍّ كَانَتْ عِنْدَهُ أَمَةٌ لَهُ نَصْرَانِيَّةٌ , فَوَلَدَتْ مِنْهُ ، ثُمَّ أَسْلَمَتْ , قَالَ : يُفَرِّقُ الإِسْلامُ بَيْنَهُمَا ، وَتُعْتَقُ هِيَ وَوَلَدُهَا ""","","","","","The Book of the People of the Two Books"
"18709","قَالَ ابْنُ جُرَيْجٍ , وَسَمِعْتُ سُلَيْمَانَ بْنَ مُوسَى , يَقُولُ : لا يَسْتَرِقُّ عِنْدَهُ كَافِرٌ مُسْلِمًا ""","","","","","The Book of the People of the Two Books"
"18710","قَالَ الثَّوْرِيُّ :  فِيأُمِّ وَلَدٍ نَصْرَانِيٍّ أَسْلَمَتْ ، قَالَ "" تُقَوِّمُ نَفْسَهَا ، وَتَسْعَى فِي قِيمَتِهَا ، وَتُعْزَلُ مِنْهُ , فَإِنْ مَاتَ عَتَقَتْ , وَإِنْ هُوَ أَسْلَمَ بَعْدَ سِعايَتِهَا سَعَتْ , وَلَمْ تَرْجِعْ إِلَيْهِ , وَإِنْ مَاتَ وَهُو نَصْرَانِيٌّ أَوْ مُسْلِمٌ فَلا سِعَايَةَ عَلَيْهَا "" وَقَالَ الثَّوْرِيُّ : "" فِي مُدَبَّرِ النَّصْرَانِيِّ يُسْلِمُ مِثْلَ مَا قَالَ فِي أُمِّ وَلَدِهِ ""","","","","","The Book of the People of the Two Books"
"18711","أَخْبَرَنَا معمر , وَالثَّوْرِيٌّ , عَنْ عَمْرِو بْنِ مَيْمُونٍ ، قَالَ : كَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ :  فِيرَقِيقِ أَهْلِ الذِّمَّةِ يُسْلِمُونَ ، يَأْمُرُ بِبَيْعِهِمْ ""، قَالَ الثَّوْرِيُّ : "" وَكَذَلِكَ نَقُولُ : يُبَاعُونَ ""","","","","","The Book of the People of the Two Books"
"18712","قَالَ الثَّوْرِيُّ :  فِيرَجُلٍ يُسْلِمُ عِنْدَهُ الْعَبْدُ فَيَكْتُمُهُ أَوْ يُغَيِّبُهُ , قَالَ : يُعَزَّرُ وَيُبَاعُ الْعَبْدُ ""","","","","","The Book of the People of the Two Books"
"18713","أَخْبَرَنَا 94 ابْنُ جُرَيْجٍ 94 ، قَالَ : أَخْبَرَنِي بَعْضُ أَهْلِ الرِّضَا ، أَنَّ نَصْرَانِيًّا أَعْتَقَ مُسْلِمًا , قَالَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ : أَعْطُوهُ قِيمَتَهُ مِنْ بَيْتِ الْمَالِ ، وَوَلاؤُهُ لِلْمُسْلِمِينَ ""","","","","","The Book of the People of the Two Books"
"18714","سُئِلَ الثَّوْرِيُّ عَنْتُجَّارِ الْمُسْلِمِينَ , يَدْخُلُونَ بِلادَ الْعَجَمِ فَيَسْتَرِقُّ بَعْضُهُمْ بَعْضًا هَلْ يَصْلُحُ لَهُ أَنْ يَشْتَرِيَهُمْ وَهُو يَعْلَمُ ؟ ، قَالَ : نَعَمْ ""","","","","","The Book of the People of the Two Books"
"18715","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ عُمَرُ بْنُ عَبْدِ الْعَزِيزِ : إِذَا أَعْتَقَ الْيَهُودِيُّ الْمُسْلِمَ أُعْطِيَ قِيمَتَهُ مِنْ بَيْتِ الْمَالِ ، وَوَلاؤُهُ لِلْمُسْلِمِينَ ""","","","","","The Book of the People of the Two Books"
"18716","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ ابْنُ شِهَابٍ :  فِيرَجُلٍ مِنْ أَهْلِ الْكِتَابِ اشْتَرَى أَمَةً مُسْلِمَةً سِرًّا , فَوَلَدَتْ لَهُ , قَالَ : "" يُغَرَّبُ وَتُنْتَزَعُ مِنْهُ ""","","","","","The Book of the People of the Two Books"
"18717","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ لِي عَطَاءٌ : لا يَدْخُلُ الْحَرَمَ كُلَّهُ مُشْرِكٌ , وَتَلا :  بَعْدَ عَامِهِمْ هَذَا "" , قَالَ ابْنُ جُرَيْجٍ : وَقَالَ لِي عَطَاءٌ قَوْلُهُ :  الْمَسْجِدَ الْحَرَامَ "" الْحَرَمُ كُلُّهُ "" ، قَالَ ابْنُ جُرَيْجٍ : وَقَالَ ذَلِكَ عَمْرُو بْنُ دِينَارٍ : "" لا يَدْخُلُ الْمَسْجِدَ الْحَرَامِ ""","","","","","The Book of the People of the Two Books"
"18718","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ , أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ ,  يَقُولُ فِي هَذِهِ الآيَةِ : إِنَّمَا الْمُشْرِكُونَ نَجَسٌ فَلا يَقْرَبُوا الْمَسْجِدَ الْحَرَامَ قَالَ : "" لا ، إِلا أَنْ يَكُونَ عَبْدًا , أَوْ أَحَدًا مِنْ أَهْلِ الْجِزْيَةِ ""","","","","","The Book of the People of the Two Books"
"18719","أَخْبَرَنَا معمر , عَنِ ابْنِ أَبِي نَجِيحٍ ، قَالَ : أَدْرَكْتُ وَمَا يُتْرَكُ يَهُودِيٌّ وَلا نَصْرَانِيٌّ يَدْخُلُ الْحَرَمَ ""","","","","","The Book of the People of the Two Books"
"18720","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَجْتَمِعُ بِأَرْضِ الْعَرَبِ ، أَوْ قَالَ : بِأَرْضِ الْحِجَازِ دِينَانِ ""، قَالَ الزُّهْرِيُّ : فَلِذَلِكَ أَجْلاهُمْ عُمَرُ""","","","","","The Book of the People of the Two Books"
"18721","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ ، قَالَ : كَانَ عُمَرُ : لا يَدَعُ الْيَهُودِيَّ ، وَالنَّصْرَانِيَّ ، وَالْمَجُوسِيَّ إِذَا دَخَلُوا الْمَدِينَةَ أَنْ يُقِيمُوا بِهَا إِلا ثَلاثًا قَدْرَ مَا يَبِيعُونَ سِلْعَتَهُمْ "" , فَلَمَّا أُصِيبَ عُمَرُ ، قَالَ : "" قَدْ كُنْتُ أَمَرْتُكُمْ أَلا تُدْخِلُوا عَلَيْنَا مِنْهُمْ أَحَدًا , وَلَوْ كَانَ الْمُصَابُ غَيْرِي كَانَ لَهُ فِيهِ أَمْرٌ "" ، قَالَ : وَكَانَ يَقُولُ : "" لا يَجْتَمِعُ بِهَا دِينَانِ ""","","","","","The Book of the People of the Two Books"
"18722","أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ ، قَالَ : لَمَّا طُعِنَ عُمَرُ أَرْسَلَ إِلَى نَاسٍ مِنَ الْمُهَاجِرِينَ فِيهِمْ عَلِي ، فَقَالَ أَعَنْ مَلأٍ مِنْكُمْ كَانَ هَذَا ؟ "" , فَقَالَ عَلِي : مَعَاذَ اللَّهِ أَنْ يَكُونَ عَنْ مَلأٍ مِنَّا , وَلَوِ اسْتَطَعْنَا أَنْ نَزِيدَ مِنْ أعْمَارِنَا فِي عُمُرِكَ لَفَعَلْنَا , قَالَ : قَدْ كُنْتُ نَهَيْتُكُمْ أَنْ يَدْخُلَ عَلَيْنَا مِنْهُمْ أَحَدٌ ""","","","","","The Book of the People of the Two Books"
"18723","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ مُوسَى بْنِ عُقْبَةَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ ، قَالَ :  كَانَتِالْيَهُودُ وَالنَّصَارَى وَمَنْ كَانَ سِوَاهُمْ مِنَ الْكُفَّارِ مِنْ جَاءَ الْمَدِينَةَ مِنْهُمْ سَفْرًا لا يُقِيمُونَ فِيهَا ثَلاثَةَ أَيَّامٍ عَلَى عَهْدِ عُمَرَ ، وَلا نَدْرِي أَكَانَ يُفْعَلُ ذَلِكَ بِهِمْ قَبْلُ أَمْ لا ""","","","","","The Book of the People of the Two Books"
"18724","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ مُسْلِمِ بْنِ أَبِي مَرْيَمَ , عَنْ عَلِي بْنِ حُسَيْنٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَخْرَجَ الْيَهُودَ مِنَ الْمَدِينَةِ ""","","","","","The Book of the People of the Two Books"
"18725","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ مُوسَى بْنِ عُقْبَةَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ  أَنَّ يَهُودَ بَنِي النَّضِيرِ وَقُرَيْظَةَ حَارَبُوا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَأَجْلَى بَنِي النَّضِيرِ , وَأَقَرَّ قُرَيْظَةَ وَمَنْ عَلَيْهِمْ , حَتَّى حَارَبَتْهِ قُرَيْظَةُ بَعْدَ ذَلِكَ , فَقَتَلَ رِجَالَهُمْ , وَقَسَّمَ نِسَاءَهُمْ , وَأَوْلادَهُمْ , وَأَمْوَالَهُمْ بَيْنَ الْمُسْلِمِينَ , إِلا بَعْضَهُمْ لَحِقُوا بِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَأَمَّنَهُمْ , وَأَسْلَمُواوَأَجْلَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَهُودَ الْمَدِينَةِ كُلَّهُمْ , بَنِي قَيْنُقَاعَ , وَهُمْ قَوْمُ عَبْدِ اللَّهِ بْنِ سَلامٍ , وَيَهُودَ بَنِي حَارِثَةَ , وَكُلَّ يَهُودِيٍّ كَانَ بِالْمَدِينَةِ ""","","","","","The Book of the People of the Two Books"
"18726","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : أَخْبَرَنِي عُمَرُ بْنُ الْخَطَّابِ أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , يَقُولُ : لأُخْرِجَنَّ الْيَهُودَ وَالنَّصَارَى مِنْ جَزِيرَةِ الْعَرَبِ ، حَتَّى لا أَدَعَ فِيهَا إِلا مُسْلِمًا ""","","","","","The Book of the People of the Two Books"
"18727","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مُوسَى بْنُ عُقْبَةَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , أَنَّ عُمَرَ :  أَجْلَى الْيَهُودَ وَالنَّصَارَى مِنْ أَرْضِ الْحِجَازِ ، وَكَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمَّا ظَهَرَ عَلَى خَيْبَرَ أَرَادَ أَنْ يُخْرِجَ الْيَهُودَ مِنْهَا ، وَكَانَتِ الأَرْضُ حِينَ ظَهَرَ عَلَيْهَا لِلَّهُ وَلِرَسُولِهِ وَلِلْمُسْلِمِينَ , فَأَرَادَ إِخْرَاجَ الْيَهُودِ مِنْهَا ، فَسَأَلَتِ الْيَهُودُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُقِرَّهُمْ بِهَا عَلَى أَنْ يَكْفُوهُ عَمَلَهَا ، وَلَهُمْ نِصْفُ الثَّمَرِ , فَقَالَ لَهُمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :نُقِرُّكُمْ بِهَا عَلَى ذَلِكَ مَا شِئْنَا "" فَقَرُّوا بِهَا حَتَّى أَجْلاهُمْ عُمَرُ إِلَى تَيْمَاءَ وَأَرِيحَاءَ ""","","","","","The Book of the People of the Two Books"
"18728","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيِّبِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَجْتَمِعُ بِأَرْضِ الْعَرَبِ أَوْ قَالَ : بِأَرْضِ الْحِجَازِ دِينَانِ ""، قَالَ : فَفَحَصَ عَنْ ذَلِكَ عُمَرُ حَتَّى وَجَدَ عَلَيْهِ الثَّبْتُ ، قَالَ الزُّهْرِيُّ : فَلِذَلِكَ أَجْلاهُمْ عُمَرُ""","","","","","The Book of the People of the Two Books"
"18729","أَخْبَرَنَا مَالِكٌ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي حَكِيمٍ , أَنَّهُ سَمِعَ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ , يَقُولُ : آخِرُ مَا تَكَلَّمَ بِهِ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ قَالَ : قَاتَلَ اللَّهُ الْيَهُودَ وَالنَّصَارَى ، اتَّخَذُوا قُبُورَ أَنْبِيَائِهِمْ مَسَاجِدَ , لا يَبْقَى ، أَوْ قَالَ : لا يَجْتَمِعُ دِينَانِ بِأَرْضِ الْعَرَبِ ""","","","","","The Book of the People of the Two Books"
"18730","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيِّبِ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : دَفَعَ خَيْبَرَ إِلَى يَهُودَ عَلَى أَنْ يَعْمَلُوا فِيهَا وَلَهُمْ شَطْرُ ثَمَرِهَا , فَقَضَى عَلَى ذَلِكَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَأَبُو بَكْرٍ , وَصَدْرًا مِنْ خِلافَةِ عُمَرَ ""","","","","","The Book of the People of the Two Books"
"18731","ثُمَّ أُخْبِرَ عُمَرُ أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ فِي وَجَعِهِ الَّذِي مَاتَ فِيهِ : لا يَجْتَمِعُ بِأَرْضِ الْعَرَبِ ، أَوْ قَالَ : بِأَرْضِ الْحِجَازِ دِينَانِ ""، فَفَحَصَ عَنْ ذَلِكَ حَتَّى وَجَدَ عَلَيْهِ الثَّبْتَ ، ثُمَّ دَعَاهُمْ , فَقَالَ : مَنْ كَانَ عِنْدَهُ عَهْدٌ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَلْيَأْتِ , وَإِلا فَإِنِّي مُجْلِيكُمْ ، فَأَجْلاهُمْ مِنْهَا ""","","","","","The Book of the People of the Two Books"
"18732","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعُ عُمَرُ بْنُ الْخَطَّابِ رَجُلا مِنَ الْيَهُودِ قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : كَأَنِّيبِكَ قَدْ وَضَعْتَ كُورَكَ عَلَى بَعِيرِكَ , ثُمَّ سِرْتَ لَيْلَةً بَعْدَ لَيْلَةٍ , فَقَالَ عُمَرُ : إِنَّهُ وَاللَّهِ لا تَمْشُونَ بِهَا , فَقَالَ الْيَهُودِيُّ : وَاللَّهِ , مَا رَأَيْتُ كَلِمَةً أَشَدَّ عَلَى مَنْ قَالَهَا ، وَلا أَهْوَنَ عَلَى مَنْ قِيلَتْ لَهُ مِنْهَا","","","","","The Book of the People of the Two Books"
"18733","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ سُلَيْمَانَ الأَحْوَلِ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : يَوْمُ الْخَمِيسِ ، وَمَا يَوْمُ الْخَمِيسِ ؟ ثُمَّ بَكَى حَتَّى خَضَبَ دَمْعُهُ الْحَصَا , فَقُلْتُ : يَا أَبَا عَبَّاسٍ ! وَمَا يَوْمُ الْخَمِيسِ ؟ ، قَالَ : اشْتَدَّ بِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَجَعُهُ , فَقَالَ : ائْتُونِي أَكْتُبْ لَكُمْ كِتَابًا لا تَضِلُّوا بَعْدَهُ أَبَدًا "" , قَالَ : فَتَنَازَعُوا ، وَلا يَنْبَغِي عِنْدَ نَبِيٍّ تَنَازُعٌ , فَقَالُوا : مَا شَأْنُهُ ، اسْتَفْهِمُوهُ ، أَهَجَرَ ؟ فَقَالَ : "" دَعُونِي ، فَالَّذِي أَنَا فِيهِ خَيْرٌ مِمَّا تَدْعُونِي إِلَيْهِ "" , قَالَ : فَأَوْصَى عِنْدَ مَوْتِهِ بِثَلاثٍ , فَقَالَ : "" أَخْرِجُوا الْمُشْرِكِينَ مِنْ جَزِيرَةِ الْعَرَبِ , وَأَجِيزُوا الْوَفْدَ بِنَحْوٍ مِمَّا كُنْتُ أُجِيزُهُمْ بِهِ "", قَالَ : فَإِمَّا أَنْ يَكُونَ سَعِيدٌ سَكَتَ عَنِ الثَّالِثَةِ , وَإِمَّا أَنْ يَكُونَ قَالَهَا ، فَنَسِيتُهَا""","","","","","The Book of the People of the Two Books"
"18734","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : بَلَغَنِي أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَوْصَى عِنْدَ مَوْتِهِ بِأَنْلا يُتْرَكَ يَهُودِيٌّ وَلا نَصْرَانِيٌّ بِالْحِجَازِ , وَأَنْ يُمْضَى جَيْشُ أُسَامَةَ إِلَى الشَّامِ , وَأَوْصَى بِالْقِبْطِ خَيْرًا ، فَإِنَّ لَهُمْ قَرَابَةً","","","","","The Book of the People of the Two Books"
"18735","عَنِ الْحَسَنِ بْنِ عُمَارَةَ , عَنْ عَدِيِّ بْنِ ثَابِتٍ , عَنْ أَبِي ظَبْيَانَ ، قَالَ : سَمِعْتُ عَلِيًّا يَقُولُ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا وُلِّيتَ الأَمْرَ بَعْدِي فَأَخْرِجْ أَهْلَ نَجْرَانَ مِنْ جَزِيرَةِ الْعَرَبِ ""","","","","","The Book of the People of the Two Books"
"18736","قَالَ : وَأَخْبَرَنَا ابْنُ التَّيْمِيِّ , عَنْ لَيْثٍ , عَنْ طَاوُسٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : لا يُشارِكُكُمُ الْيَهُودُ وَالنَّصَارَى فِي أَمْصَارِكُمْ إِلا أَنْ يُسْلِمُوا , فَمَنِ ارْتَدَّ مِنْهُمْ فَأَبَى ، فَلا يُقْبَلُ مِنْهُ دُونَ دَمِهِ ""","","","","","The Book of the People of the Two Books"
"18737","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ كَعْبِ بْنِ مَالِكٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا مَلَكْتُمُ الْقِبْطَ فَأَحْسِنُوا إِلَيْهِمْ فَإِنَّ لَهُمْ ذِمَّةً وَرَحِمًا ""، قَالَ مَعْمَرٌ : قُلْتُ لِلزُّهْرِيِّ : يَعْنِي أُمَّ إِبْرَاهِيمَ ابْنَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : "" لا ، بَلْ أُمَّ إِسْمَاعِيلَ ""","","","","","The Book of the People of the Two Books"
"18738","أَخْبَرَنَا مَعْمَرٌ ، قَالَ : كُنْتُ عِنْدَ يَحْيَى بْنِ أَبِي كَثِيرٍ بِالْيَمَامَةِ ، فَأَرَدْتُ أَنْ أَخْرَجَ , وَكَانَ فِي الطَّرِيقِ مَوْضِعُ مَفَازَةْ ، فَلَمْ أَجِدْ أَحَدًا , فَخَرَجَ إِلَى قَوْمٍ مِنَ الْيَهُودِ فَأَتَاهُمْ ، فَاسْتَوْصَاهُمْ بِي , فَلَمَّا سِرْتُ مَعَهُمْ , قَالُوا لِي فِي الطَّرِيقِ : كَيْفَ أَرْسَلَكَ يَحْيَى مَعَنَا ؟ وَهُو يُرْوَى عَنْ نَبِيِّكُمْ أَنَّهُ : لا يَخْلُو يَهُودِيٌّ مَعَ مُسْلِمٍ إِلا هَمَّ بِقَتْلِهِ "" , قَالَ : فَتَخَوَّفْتُهُمْ ، فَسَلَّمَ اللَّهُ مِنْهُمْ""","","","","","The Book of the People of the Two Books"
"18739","أَخْبَرَنَا الثَّوْرِيُّ :  وَسُئِلَ عَنْ رَقِيقِ الْعَجَمِ يَخْرُجُونَ مِنَ الْبَحْرِ أَوْ مِنْ غَيْرِهِ , هَلْ يُبَاعُونَ مِنَ الْيَهُودِ وَالنَّصَارَى ؟ ، فَقَالَ :إِذَا كَانُوا كِبَارًا عُرِضَ عَلَيْهِمُ الإِسْلامُ , فَإِنْ أَسْلَمُوا فَذَاكَ , وَإِلا بِيعُوا مِنَ الْيَهُودِ وَالنَّصَارَى إِنْ شَاءَ صَاحِبُهُمْ , وَالَّذِي يُسْتَحَبُّ مِنْ ذَلِكَ أَنَّ الْيَهُودَ وَالنَّصَارَى إِذَا مَلَكُهُمُ الْمُسْلِمُ بِبَيْعٍ أَوْ سَبْيٍ فَإِنَّهُ يَدْعُوهُمْ إِلَى الإِسْلامِ , فَإِنْ أَبَوْا إِلا التَّمَسُّكَ بِدِينِهِمْ , فَإِنَّ الْمُسْلِمَ إِنْ شَاءَ بَاعَهُمْ مِنْ أَهْلِ الذِّمَّةِ , وَلا يَبِيعُهُمْ مِنْ أَحَدٍ مِنْ أَهْلِ الْحَرْبِ , وَإِنْ كَانُوا عَلَى غَيْرِ دِينٍ مِثْلَ الْهِنْدِ وَالزِّنْجِ , فَإِنَّ الْمُسْلِمَ لا يَبِيعُهُمْ مِنْ أَحَدٍ مِنْ أَهْلِ الذِّمَّةِ , وَلا مِنْ أَهْلِ الْحَرْبِ , وَلا يَبِيعُهُمْ إِلا مِنَ الْمُسْلِمِينَ , لأَنَّهُ يُجِيبُونَ إِذَا دُعُوا , وَلَيْسَ لَهُمْ دِينٌ يَتَمَسَّكُونَ بِهِ , وَلا يَنْبَغِي أَنْ يُتْرَكَ الْيَهُودُ وَالنَّصَارَى يُهَوِّدُونَهُمْ وَلا يُنَصِّرُونَهُمْ , وَإِذَا كَانَ الْعَجَمُ صِغَارًا لَمْ يُبَاعُوا مِنَ الْيَهُودِ وَالنَّصَارَى , لا يُبَاعُونَ إِلا مِنَ الْمُسْلِمِينَ , وَإِذَا مَاتُوا صِغَارًا عِنْدَ الْمُسْلِمِ صَلَّى عَلَيْهِمْ , وَإِنْ لَمْ يَكُنْ خَرَجَ بِهِمْ مِنْ بِلادِهِمْ , فَإِنَّهُ يُصَلِّي عَلَيْهِمْ إِذَا وَقَعُوا فِي يَدَيْهِ "" ، قَالَ الثَّوْرِيُّ : وَقَالَ حَمَّادٌ : "" إِذَا مُلِكَ الصَّغِيرُ فَهُو مُسْلِمٌ ""","","","","","The Book of the People of the Two Books"
"18740","أَخْبَرَنَا عَبْدُ الْمَلِكِ بْنُ الصَّبَّاحِ , عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ ، عَنْ عَوْفِ بْنِ مَالِكٍ الأَشْجَعِيِّ :  أَنَّيَهُودِيًّا أَوْ نَصْرَانِيًّا نَخَسَ بِامْرَأَةٍ مُسْلِمَةٍ , ثُمَّ حَثَى عَلَيْهَا التُّرَابَ يُرِيدُهَا عَلَى نَفْسِهَا , فَرُفِعَ ذَلِكَ إِلَى عُمَرَ بْنِ الْخَطَّابِ ، فَقَالَ عُمَرُ : "" إِنَّ لِهَؤُلاءِ عَهْدًا مَا وَفَوْا لَكُمْ بِعَهْدِكُمْ , فَإِذَا لَمْ يَفُوا فَلا عَهْدَ لَهُمْ "" ، فَصَلَبَهُ عُمَرُ""","","","","","The Book of the People of the Two Books"
"18741","أَخْبَرَنَا الأَسْلَمِيُّ , عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ , عَنْ أَبِيهِ ,  أَنَّ امْرَأَةً مُسْلِمَةً اسْتَأْجَرَتْ يَهُودِيًّا ، أَوْ نَصْرَانِيًّا ، فَانْطَلَقَ مَعَهَا ، فَلَمَّا أَتَيَا أَكَمَةً تَوَارَى بِهَا , ثُمَّ غَشِيَهَا , قَالَ أَبُو صَالِحٍ وَكُنْتُ رَمَقْتُهَا مَغْشِيَّةً حِينَ غَشِيَهَا , فَضَرَبْتُهُ ، فَلَمْ أَتْرُكْهُ حَتَّى رَأَيْتُ أَنِّي قَدْ قَتَلْتُهُ , فَانْطَلَقَ إِلَى أَبِي هُرَيْرَةَ فَأَخْبَرَهُ , قَالَ : فَدَعَانِي ، فَأَخْبَرْتُهُ ، فَأَرْسَلَ إِلَى الْمَرْأَةِ فَوَافَقَتْنِي عَلَى الْخَبَرِ , قَالَ أَبُو هُرَيْرَةَ"" مَا عَلَى هَذَا أَعْطَيْنَاكُمُ الْعَهْدَ ، فَأَمَرَ بِهِ ، فَقُتِلَ ""","","","","","The Book of the People of the Two Books"
"18742","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي مِنْ أُصَدِّقُ ، أَنَّ يَهُودِيًّا ، أَوْ نَصْرَانِيًّا نَخَسَ بِامْرَأَةٍ مُسْلِمَةٍ , فَسَقَطَتْ , فَضَرَبَ عُمَرُ بْنُ الْخَطَّابِ رَقَبَتَهُ , وَقَالَ : مَا عَلَى هَذَا صَالَحْنَاكُمْ ""","","","","","The Book of the People of the Two Books"
"18743","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أُخْبِرْتُ ، أَنَّ أَبَا عُبَيْدَةَ بْنَ الْجَرَّاحِ  قَتَلَ كَذَلِكَرَجُلا أَرَادَ امْرَأَةً عَلَى نَفْسِهَا , وَأَبُو هُرَيْرَةَ كَذَلِكَ , وَذَلِكَ أَنَّ رَجُلا مِنْ أَهْلِ الْكِتَابِ أَرَادَ أَنْ يَبْتَزَّ مُسْلِمَةً نَفْسَهَا ، وَرَجُلٌ يَنْظُرُ , فَسَأَلَ أَبُو هُرَيْرَةَ الرَّجُلَ حَيْثُ لا تَسْمَعُ الْمُسْلِمَةُ ، وَالْمُسْلِمَةَ حَيْثُ لا يَسْمَعُ الرَّجُلُ , فَلَمَّا اتَّفَقَا أَمَرَ بِقَتْلِهِ , وَلَقَدْ قِيلَ لِي : إِنَّ الرَّجُلَ أَبُو صَالِحٍ الزَّيَّاتُ "" قَالَ : "" وَقَضَى بِذَلِكَ عَبْدُ الْمَلِكِ فِي جَارِيَةٍ مِنَ الأَعْرَابِ ، افْتَضَّهَا رَجُلٌ مِنْ أَهْلِ الْكِتَابِ ، فَقَتَلَهُ وَأَعْطَى الْجَارِيَةَ مَالَهُ ""","","","","","The Book of the People of the Two Books"
"18744","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ ابْنُ شِهَابٍ :  فِيرَجُلٍ مِنْ أَهْلِ الْكِتَابِ اشْتَرَى أَمَةً مُسْلِمَةً سِرًّا , فَوَلَدَتْ لَهُ , قَالَ : يُعَذَّبُ , وَتُنْتَزَعُ مِنْهُ ""، قَالَ الثَّوْرِيُّ : "" فِي الذِّمِّيِّ يُسْلِمُ عِنْدَهُ الْعَبْدُ فَيَكْتُمُهُ أَوْ يُغَيِّبُهُ , قَالَ : "" يُعَزَّرُ وَيُبَاعُ الْعَبْدُ ""","","","","","The Book of the People of the Two Books"
"18745","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : قَالَ لِي عَطَاءٌ : مِنْ سَرَقَ الْخَمْرَ مِنْ أَهْلِ الْكِتَابِ قُطِعَ ""، أَخْبَرَنَا مَعْمَرٌ , وَالثَّوْرِيُّ , عَنِ ابْنِ أَبِي نَجِيحٍ , عَنْ عَطَاءٍ ، مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18746","أَخْبَرَنَا الْحَسَنُ بْنُ عُمَارَةَ , عَنِ الْحَكَمِ , عَنْ إِبْرَاهِيمَ ، قَالَ : إِذَا أَسْلَمَ عَبْدٌ نَصْرَانِيٌّ جُبِرَ عَلَى بَيْعِهِ ""","","","","","The Book of the People of the Two Books"
"18747","أَخْبَرَنَا ابْنُ الْمُبَارَكِ ، قَالَ : أَخْبَرَنَا حَكِيمُ بْنُ رُزَيْقٍ , أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِيزِ كَتَبَ إِلَى أَبِيهِ :  أَمَّا بَعْدُ , فَإِنِّيكَتَبْتُ إِلَى عُمَّالِنَا أَلا يَتْرُكُوا عِنْدَ نَصْرَانِيٍّ مَمْلُوكًا مُسْلِمًا إِلا أُخِذَ فَبِيعَ , وَلا امْرَأَةً مُسْلِمَةً تَحْتَ نَصْرَانِيٍّ إِلا فَرَّقُوا بَيْنَهُمَا ، فَأَنْفِذْ ذَلِكَ فِيمَنْ قِبَلَكَ ""","","","","","The Book of the People of the Two Books"
"18748","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ :  سُئِلَ ابْنُ شِهَابٍ عَنْنَصْرَانِيٍّ كَانَتْ عِنْدَهُ أَمَةٌ لَهُ نَصْرَانِيَّةٌ , فَوَلَدَتْ مِنْهُ ثُمَّ أَسْلَمَتْ , قَالَ : يُفَرِّقُ الإِسْلامُ بَيْنَهُمَا , وَتُعْتَقُ هِيَ وَوَلَدُهَا "" قَالَ : فَأَقُولُ أَنَا : "" لا تُعْتَقُ حَتَّى يُدْعَى إِلَى الإِسْلامِ , فَإِنْ أَبَى أَنْ يُسْلِمَ عَتَقَتْ , فَإِنْ أَسْلَمَ كَانَتْ أَمَتَهُ ""","","","","","The Book of the People of the Two Books"
"18749","أَخْبَرَنَا ابْنُ مُبَارَكٍ ، قَالَ : أَخْبَرَنِي حَرْمَلَةُ بْنُ عِمْرَانَ , أَنَّ عَلِي بْنَ طَلِيقٍ أَخْبَرَهُ ، أَنَّ أُمَّ وَلَدِ نَصْرَانِيٍّ مِنْ أَهْلِ فِلَسْطِينَ أَسْلَمَتْ , فَكَتَبَ فِيهَا إِلَى عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ، فَكَتَبَ :  أَنِابْعَثْ رِجَالا أَنْ يُقَوِّمُوهَا قِيمَةً , فَإِذَا انْتَهَتْ قِيمَتُهَا فَادْفَعُوهَا إِلَيْهِ مِنْ بَيْتِ الْمَالِ , وَخُلِّيَ سَبِيلُهَا ، فَإِنَّهَا امْرَأَةٌ مِنَ الْمُسْلِمِينَ ""","","","","","The Book of the People of the Two Books"
"18750","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي خَلادٌ , أَنَّ عَمْرَو بْنَ شُعَيْبٍ أَخْبَرَهُ ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ :  كَانَلا يَدَعُ يَهُودِيًّا وَلا نَصْرَانِيًّا يُنَصِّرُ وَلَدَهُ , وَلا يُهَوِّدُهُ فِي مُلْكِ الْعَرَبِ ""","","","","","The Book of the People of the Two Books"
"18751","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ بَجَالَةَ التَّمِيمِيَّ ، قَالَ : كُنْتُ كَاتِبًا لِجَزْءِ بْنِ مُعَاوِيَةَ عَمِّ الأَحْنَفِ بْنِ قَيْسٍ ، فَأَتَى كِتَابُ عُمَرَ قَبْلَ مَوْتِهِ بِسَنَةٍ : اقْتُلُوا كُلَّ سَاحِرٍ , وَفَرِّقُوا بَيْنَ كُلِّ ذِي مَحْرَمٍ مِنَ الْمَجُوسِ , وَانْهَهُمْ عَنِ الزَّمْزَمَةِ "", قَالَ : فَقَتَلْنَا ثَلاثَ سَوَاحِرَ , وَصَنَعَ جَزْءٌ طَعَامًا كَثِيرًا , فَدَعَا الْمَجُوسَ , فَأَلْقُوا أَخِلَّةً كَانُوا يَأْكُلُونَ بِهَا قَدْرَ وِقْرِ بَغْلٍ أَوْ بَغْلَيْنِ مِنْ وَرِقٍ , وَأَكَلُوا بِغَيْرِ زَمْزَمَةٍ""","","","","","The Book of the People of the Two Books"
"18752","قَالَ : وَلَمْ يَكُنْ أَخَذَ الْجِزْيَةَ مِنَ الْمَجُوسِ حَتَّى شَهِدَ عَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ  أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَأَخَذَهَا مِنْ مَجُوسِ هَجَرَ ""، أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ بَجَالَةَ التَّمِيمِيَّ , يُحَدِّثُ أَبَا الشَّعْثَاءِ , وَعَمْرَو بْنَ أَوْسٍ عِنْدَ صُفَّةِ زَمْزَمَ فِي إِمَارَةِ مُصْعَبِ بْنِ الزُّبَيْرِ ، ثُمَّ ذَكَرَ مِثْلَ حَدِيثِ ابْنِ جُرَيْجٍ""","","","","","The Book of the People of the Two Books"
"18753","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ أَبِي إِسْحَاقَ الشَّيْبَانِيِّ , عَنْ كُرْدُوسٍ التَّغْلِبِيِّ ، قَالَ : قَدِمَ عَلَى عُمَرَ رَجُلٌ مِنْ بَنِي تَغْلِبَ ، فَقَالَ لَهُ عُمَرُ :  إِنَّهُ قَدْ كَانَلَكُمْ نَصِيبٌ فِي الْجَاهِلِيَّةِ , فَخُذُوا نَصِيبَكُمْ مِنَ الإِسْلامِ , فَصَالَحَهُ عَلَى أَنْ أُضَعِّفَ عَلَيْهِمُ الْجِزْيَةَ , وَأَلا يُنَصِّرُوا الأَبْنَاءَ ""","","","","","The Book of the People of the Two Books"
"18754","أَخْبَرَنَا ابْنُ التَّيْمِيِّ , عَنْ أَبِي عَوَانَةَ , عَنِ الْكَلْبِيِّ , عَنِ الأَصْبَعِ بْنِ نُبَاتَةَ , عَنْ عَلِي بْنِ أَبِي طَالِبٍ ، قَالَ :  شَهِدْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حِينَصَالَحَ نَصَارَى بَنِي تَغْلِبَ عَلَى أَنْ لا يُنَصِّرُوا الأَبْنَاءَ , فَإِنْ فَعَلُوا فَلا عَهْدَ لَهُمْ "" قَالَ : وَقَالَ عَلِي : "" لَوْ قَدْ فَرَغْتُ لَقَاتَلْتُهُمْ ""","","","","","The Book of the People of the Two Books"
"18755","أَخْبَرَنَا ابْنُ جُرَيْجٍ , عَنْ إِسْمَاعِيلَ , وَيَعْقُوبَ , وَغَيْرِهِمَا ، قَالُوا : لا يُقْتَلُ سَاحِرُهُمْ , وَهُو أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَدْ صُنِعَ بِهِ بَعْضُ ذَلِكَ فَلَمْ يَقْتُلِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَاحِبَهُ , وَكَانَ مِنْ أَهْلِ الْعَهْدِ ، وَخَبَرُ جَزْءِ بْنِ مُعَاوِيَةَ فِي كِتَابِ عُمَرَ إِلَيْهِ أَنْ يُقْتَلَ سَاحِرٌ , وَخَبَرُ جُنْدُبٍ حِينَ قَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :يَضْرِبُ ضَرْبَةً يُفَرِّقُ بِهَا بَيْنَ الْحَقِّ وَالْبَاطِلِ , وَفِي الْعُقُولِ مَكْرٌ مِنَ السَّاحِرِ","","","","","The Book of the People of the Two Books"
"18756","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيِّبِ ، وَعُرْوَةَ بْنِ الزُّبَيْرِ , أَنَّيَهُودَ بَنِي رُزَيْقٍ سَحَرُوا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَلَمْ يُذْكَرْ أَنَّهُ قَتَلَ مِنْهُمْ أَحَدًا","","","","","The Book of the People of the Two Books"
"18757","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ الأَعْلَى , عَنْ سُويْدِ بْنِ غَفَلَةَ ، قَالَ : بَلَغَ عُمَرَ  أَنَّعُمَّالَهُ يَأْخُذُونَ الْخَمْرَ فِي الْجِزْيَةِ , فَنَشَدَهُمْ ثَلاثًا , فَقَالَ بِلالٌ : إِنَّهُمْ لَيَفْعَلُونَ ذَلِكَ , فَقَالَ : "" فَلا يَفْعَلُوا , وَلَكِنْ وَلُّوهُمْ بَيْعَهَا , فَإِنَّ الْيَهُودَ حُرِّمَتْ عَلَيْهِمُ الشُّحُومُ , فَبَاعُوهَا وَأَكَلُوا أَثْمَانَهَا ""","","","","","The Book of the People of the Two Books"
"18758","أَخْبَرَنَا الثَّوْرِيُّ عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ ، قَالَ : إِذَا مَرَّ أَهْلُ الذِّمَّةِ بِالْخَمْرِ أَخَذَ مِنْهَا الْعَاشِرُ الْعُشْرَ , يُقَوِّمُهَا ثُمَّ يَأْخُذُ مِنْ قِيمَتِهَا الْعُشْرَ ""","","","","","The Book of the People of the Two Books"
"18759","أَخْبَرَنَا الثَّوْرِيُّ ، عَنْ إِبْرَاهِيمَ بْنِ الْمُهَاجِرِ , أَنَّهُ سَمِعَ زِيَادَ بْنَ حُدَيْرٍ ، قَالَ :  إِنَّأَوَّلَ عَاشِرٍ عَشَّرَ فِي الإِسْلامِ لأَنَا , وَمَا كُنَّا نُعَشِّرُ مُسْلِمًا وَلا مُعَاهَدًا "" قُلْتُ : فَمَنْ كُنْتُمْ تُعَشِّرُونَ ؟ قَالَ : "" نَصَارَى بَنِي تَغْلِبَ "", قَالَ إِبْرَاهِيمُ : فَحَدَّثَنِي إِنْسَانٌ ، عَنْ زِيَادٍ ، قَالَ : قُلْتُ لَهُ : كَمْ كُنْتُمْ تُعَشِّرُونَ ؟ قَالَ : "" نِصْفَ الْعُشْرِ ""","","","","","The Book of the People of the Two Books"
"18760","أَخْبَرَنَا الثَّوْرِيُّ ، قَالَ : أَخْبَرَنِي عَبْدُ الرَّحْمَنِ بْنُ خَالِدٍ , عَنْ عَبْدِ اللَّهِ بْنِ مُغَفَّلٍ , أَنَّ زِيَادَ بْنَ حُدَيْرٍ , حَدَّثَهُ أَنَّهُ كَانَ يُعَشِّرُ فِي إِمَارَةِ عُمَرَ ، وَلا يُعَشِّرُ مُسْلِمًا وَلا مُعَاهَدًا , قُلْتُ لَهُ : فَمَنْ كُنْتُمْ تُعَشِّرُونَ ؟ ، قَالَ : "" تُجَّارَ أَهْلِ الْحَرْبِ كَمَا يُعَشِّرُونَا إِذَا أَتَيْنَاهُمْ "", قَالَ : وَكَانَ زِيَادٌ عَامِلا لِعُمَرَ""","","","","","The Book of the People of the Two Books"
"18761","أَخْبَرَنَا عَبْدُ اللَّهِ , عَنْ شُعْبَةَ , عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ ، قَالَ : سَمِعْتُ إِبْرَاهِيمَ يُحَدِّثُ ، عَنْ زِيَادِ بْنِ حُدَيْرٍ ، وَكَانَ زِيَادٌ حَيًّا يَوْمَئِذٍ  أَنَّ عُمَرَ بَعَثَهُ مُصَدِّقًا ، وَأَمَرَهُ أَنْيَأْخُذَ مِنْ نَصَارَى بَنِي تَغْلِبَ الْعُشْرَ , وَمِنْ نَصَارَى أَهْلِ الْكِتَابِ نِصْفَ الْعُشْرَ ""","","","","","The Book of the People of the Two Books"
"18762","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ قَيْسِ بْنِ مُسْلِمٍ , عَنْ طَارِقِ بْنِ شِهَابٍ ، قَالَ : كَتَبَ عُمَرُ بْنُ الْخَطَّابِ فِي دِهْقَانَةٍ مِنْ أَهْلِ نَهَرِ الْمَلِكِ أَسْلَمَتْ , وَلَهَا أَرْضٌ كَثِيرَةٌ , فَكُتِبَ فِيهَا إِلَى عُمَرَ ، فَكَتَبَ :  أَنِادْفَعَ إِلَيْهَا أَرْضَهَا تُؤَدِّي عَنْهَا الْخَرَاجَ ""","","","","","The Book of the People of the Two Books"
"18763","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ ،  أَنَّ الرُّفَيْلَ دِهْقَانَ نَهْرَيْ كَرْبَلاءَ أَسْلَمَ ,فَفَرَضَ لَهُ عُمَرُ عَلَى أَلْفَيْنِ ، وَدَفَعَ إِلَيْهِ أَرْضَهُ يُؤَدِّي عَنْهَا الْخَرَاجَ ""","","","","","The Book of the People of the Two Books"
"18764","أَخْبَرَنَا هُشَيْمُ بْنُ بَشِيرٍ ، قَالَ : أَخْبَرَنِي سَيَّارٌ أَبُو الْحَكَمِ , عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ , أَنَّ عَلِي بْنَ أَبِي طَالِبٍ قَالَ لِدِهْقَانٍ : إِنْ أَسْلَمْتَ وَضَعْتُ الدِّينَارَ عَنْ رَأْسِكَ ""","","","","","The Book of the People of the Two Books"
"18765","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ عَمْرِو بْنِ مَيْمُونٍ الأَوْدِيِّ ، قَالَ : سَمِعْتُ عُمَرَ قَبْلَ قَتْلِهِ بِأَرْبَعٍ وَهُو وَاقِفٌ عَلَى رَاحِلَتِهِ عَلَى حُذَيْفَةَ بْنِ الْيَمَانِ , وَعُثْمَانَ بْنِ حُنَيْفٍ ، فَقَالَ : انْظُرُوا مَا قِبَلَكُمَا ! لا تَكُونَا حَمَّلْتُمَا الأَرْضَ مَا لا تُطِيقُ "" , فَقَالَ حُذَيْفَةُ : حَمَّلْنَا الأَرْضَ أَمْرًا هِيَ لَهُ مُطِيقَةٌ , وَقَدْ تَرَكْتُ لَهُمْ مِثْلَ الَّذِي أَخَذْتُ مِنْهُمْ , وَقَالَ عُثْمَانُ بْنُ حُنَيْفٍ : حَمَّلْتُ الأَرْضَ أَمْرًا هِيَ لَهُ مُطِيقَةٌ , وَقَدْ تَرَكْتُ لَهُمْ فَضْلا يَسِيرًا , فَقَالَ : "" انْظُرُوا مَا قِبَلَكُمَا ! لا تَكُونَا حَمَّلْتُمُ الأَرْضَ مَا لا تُطِيقُ , فَإِنِ اللَّهُ سَلَّمَنِي لأَدَعَنَّ أَرَامِلَ أَهْلِ الْعِرَاقِ وَهُنَّ لا يَحْتَجْنَ إِلَى أَحَدٍ بَعْدِي ""","","","","","The Book of the People of the Two Books"
"18766","أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنِ ابْنِ أَبِي نَجِيحٍ , عَنْ مُجَاهِدٍ ، قَالَ : أَيُّمَا مَدِينَةٍ فُتِحَتْ عَنْوَةً فَهُمْ أَرِقَّاءُ , وَأَمْوَالُهُمْ لِلْمُسْلِمِينَ , فَإِنْ أَسْلَمُوا قَبْلَ أَنْ يُقْسَمُوا فَهُمْ أَحْرَارٌ وَأَمْوَالُهُمْ لِلْمُسْلِمِينَ ""","","","","","The Book of the People of the Two Books"
"18767","قَالَ الثَّوْرِيُّ :  فَمَنِاحْتَاجَ مِنْ أَهْلِ الذِّمَّةِ فَلَمْ يَجِدْ مَا يُؤَدِّي فِي جِزْيَتِهِ , قَالَ : يُسْتَأْنَى بِهِ حَتَّى يَجِدَ فَيُؤَدِّيَ ، وَلَيْسَ عَلَيْهِ غَيْرُ ذَلِكَ , فَإِنْ أَيْسَرَ أُخِذَ بِمَا مَضَى , فَإِنْ عَجَزَ عَنْ شَيْءٍ مِنَ الصُّلْحِ الَّذِي صَالَحَ عَلَيْهِ ، وُضِعَ عَنْهُ إِذَا عُرِفَ عَجْزُهُ ، يَضَعُهُ عَنْهُ الإِمَامُ ""","","","","","The Book of the People of the Two Books"
"18768","أَخْبَرَنَا ابْنُ جُرَيْجٍ ، قَالَ : أَخْبَرَنِي سُلَيْمَانُ الأَحْوَلُ ، عَنْ طَاوُسٍ ، قَالَ : إِذَا تَدَارَكَ عَلَى الرَّجُلِ جِزْيَتَانِ أُخِذَتِ الأُولَى ""","","","","","The Book of the People of the Two Books"
"18769","أَخْبَرَنَا عَبْدُ اللَّهِ , عَنْ شُعْبَةَ , عَنْ مُعَاوِيَةَ أَبِي عَبْدِ اللَّهِ الْعَسْقَلانِيِّ ، قَالَ : أَخْبَرَنِي مَنْ رَأَى عَبْدَ اللَّهِ بْنَ مُحَيْرِيزٍ : يُصَافِحُ رَجُلا نَصْرَانِيًّا فِي دِمَشْقَ ""","","","","","The Book of the People of the Two Books"
"18770","أَخْبَرَنَا الْحَسَنُ بْنُ عُمَارَةَ , عَنِ الْحَكَمِ , عَنْ إِبْرَاهِيمَ ، قَالَ :  كَانُوايَكْرَهُونَ أَنْ يَأْكُلُوا مَعَ الْيَهُودِ وَالنَّصَارَى ، وَأَنْ يُصَافِحُوا ""","","","","","The Book of the People of the Two Books"
"18771","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : كَنَّى صَفْوَانَ بْنَ أُمَيَّةَ وَهُو يَوْمَئِذٍ مُشْرِكٌ ، جَاءَهُ عَلَى فَرَسٍ ، فَقَالَ : "" انْزِلْ أَبَا وَهْبٍ ""","","","","","The Book of the People of the Two Books"
"18772","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , أَنَّ عُمَرَ : كَنَّى الْفُرَافِصَةَ الْحَنَفِيَّ وَهُو نَصْرَانِيٌّ , فَقَالَ لَهُ : أَبَا حَسَّانَ ""، أَخْبَرَنَا ابْنُ عُيَيْنَةَ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ عُمَرَ ، مِثْلَهُ""","","","","","The Book of the People of the Two Books"
"18773","حَدَّثَنَا مَعْمَرٌ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ ، قَالَ :  هَذِهِ قَضِيَّةُ مُعَاذِ بْنِ جَبَلٍ فِيمَنْ أَعْتَقَ اللَّهُ مِنْ مُسْتَحْمِ حِمْيَرٍ :"" فَمَنِ اسْتَحْمَى قَوْمًا أَوْ لَهُمْ أَحْرَارٌ وَجِيرَانٌ مُسْتَضْعَفُونَ , فَإِنَّ لِلْمَوْهُوبِ لَهُ مَا . . . . فِي بَيْتِهِ حَتَّى دَخَلَ الإِسْلامَ , وَمَنْ كَانَ مُهْمَلا يُعْطِي الْخَرَاجَ فَإِنَّهُ عَتِيقٌ , وَمَنْ كَانَ مُشْتَرًى أَوْ مَغْنُومًا مِنْ عَدُو الدِّينِ لا يُدْعَى بَعْضُهُمْ عَلَى بَعْضٍ فِي الْقِتَالِ ، فَإِنَّهُ لِوَجْهِ الَّذِي اشْتَرَاهُ أَوْ غَنِمَهُ , وَمَنْ جَاءَ بِجِزْيَةٍ بَيِّنَةٍ أَوْ فِدَاءٍ بَيِّنٍ فَإِنَّهُ عَتِيقٌ , وَمَنْ نَزَعَ يَدَهُ فِي الْجَاهِلِيَّةِ مِنْ رَبِّهِ , ثُمَّ لَمْ يُقْدَرْ عَلَيْهِ حَتَّى دَخَلَ الإِسْلامَ فَإِنَّهُ عَتِيقٌ , وَمَنْ نَزَعَ يَدَهُ فِي السِّلْمِ إِلَى الْمُسْلِمِينَ وَرَبُّهُ كَافِرٌ فَإِنَّهُ عَتِيقٌ , وَمَنْ كَانَتْ لَهُ أَرْضٌ فَهُو أَحَقُّ بِهَا , وَهِيَ أَرْضُهُ وَأَرْضُ أَبِيهِ , وَهِيَ نَفْلُهُ وَلَمْ تُنْزَعْ مِنْهُ حَتَّى دَخَلَ الإِسْلامَ , فَلَهُ مَا أَسْلَمَ عَلَيْهِ مِنْهَا وَهِيَ تَحْتَهُ , وَمَنْ كَانَتْ لَهُ أَرْضٌ أَوْ لأَبِيهِ , أَوْ وُهِبَتْ لَهُ أَرْضٌ فَأَكَلَهَا حَتَّى دَخَلَ الإِسْلامَ , فَإِنَّهَا لَهُ , وَمَنْ مَنَحَ أَرْضًا وَلَيْسَتْ بِأَرْضٍ لِلْمَمْنُوحِ فَإِنَّهَا لِلْمَانِحِ , وَأَنَّ كُلَّ عَارِيَةٍ مَرْدُودَةٌ إِلَى رَبِّهَا , وَأَنَّ كُلَّ بَشَرِ أَرْضٍ إِذَا أَسْلَمَ عَلَيْهَا صَاحِبُهَا فَإِنَّهُ لا يُخْرَجُ مِنْهَا مَا أَعْطَى رَبُّهَا بَشَرَهَا , رُبُعَ الْمَسْقَوِيِّ وَعُشْرَ الْمطمي , إِلا أَنْ يُسْتَجَارَ بِهَا , فَيَعْرِضَهَا عَلَى بَشَرِهَا بِثَمَنٍ , فَإِنْ لَمْ يَبِعْهَا فَلْيَبِعْهَا مِمَّنْ شَاءَ , وَمَنْ ذَهَبَ إِلَى مِخْلافٍ غَيْرِ مِخْلافِ عَثِرِيِّهَا فَإِنَّ عُشُورَهُ صَدَقَةٌ إِلَى أَمِيرِ عَشِيرَتِهِ , وَمَنْ رَهَنَ رَهْنًا أَرْضًا , فَلْيَحْتَسِبِ الْمَرْهُونُ ثَمَرَهَا مِنْ عَامِ حَجَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى تُوُفِّيَ , وَمَنْ كَانَتْ لَهُ جَارِيَةٌ عُرِفَتْ لَهُ , وَلَمْ يَغْلِبْهُ عَلَيْهَا أَحَدٌ فِي الْجَاهِلِيَّةِ حَتَّى أَسْلَمَ , وَلَمْ يُحْدِثْ , فَإِنَّهَا لِرَبِّهَا , وَمَنْ حَرَثَ أَرْضًا لَيْسَ لَهَا رَبٌّ فِي الْجَاهِلِيَّةِ حَتَّى دَخَلَ الإِسْلامَ لَمْ تَكُنْ مَنِيحَةً , فَمَنْ أَكَلَهَا حَتَّى دَخَلَ الإِسْلامَ وَلَمْ يُعْطِ عَلَيْهَا حَقًّا فَإِنَّهَا لَهُ , وَمَنِ اشْتَرَى أَرْضًا بِمَالِهِ فَإِنَّهَا لَهُ , وَمَنْ أَصْدَقَ امْرَأَةً صَدَقَةً فَإِنَّ لَهَا صَدَقَتَهُ , وَمَنْ أَصْدَقَ امْرَأَتَهُ رَقِيقًا , أَوْ لَهُمْ أَحْرَارٌ وَأَصْدَقَهُمْ إِيَّاهَا , فَإِنْ كَانَتْ أَخْرَجَتْهُمْ مِنْ أَهْلِيهِمْ فَإِنَّهُمْ لَهَا , وَإِنْ كَانَتْ لَمْ تُخْرِجْهَا مِنْ أَهْلِيهِمْ وَأَوَّلُهُمْ أَحْرَارٌ , فَإِنَّ لَهَا اثْنَتَيْ عَشْرَةَ أُوقِيَّةً مِنْ ذَهَبٍ , وَإِنَّهُمْ يُعْتَقُونَ , وَمَنْ وَهَبَ أَرْضًا عَلَى أَنْ يُسْمَعَ لَهُ وَيُطِيعَ وَيَخْدُمَهُ , فَإِنَّهَا لِلَّذِي وُهِبَتْ لَهُ , إِنْ كَانَ يَأْكُلُهَا حَتَّى دَخَلَ الإِسْلامَ , وَمَنْ وَهَبَ أَرْضًا لِرَجُلٍ حَتَّى يَرْضَى أَوْ يَأْمَنَ بِهَا فَهِيَ لِلَّذِي وَهَبَهَا لَهُ , هَذِهِ قَضِيَّةُ مُعَاذٍ وَالأَمِيرُ أَبُو بَكْرٍ ""","","","","","The Book of the People of the Two Books"
"18774","قَالَ : أَخْبَرَنَا مَعْمَرٌ , عَنْ أَيُّوبَ , أَنَّهُ أَخَذَ هَذَا الْكِتَابَ مِنْ عَمْرِو بْنِ دِينَارٍ , هَذَا مَا أَقَرَّ بِهِ وَقَضَى فِي مَالِهِ عَلِيُّ بْنُ أَبِي طَالِبٍ : تَصَدَّقَ بِيَنْبُعَ ابْتِغَاءَ مَرْضَاةِ اللَّهِ لِيُولِجَنِي الْجَنَّةَ , وَيَصْرِفَ النَّارَ عَنِّي , وَيَصْرِفَنِي عَنِ النَّارِ , فَهِيَ فِي سَبِيلِ اللَّهِ وَوَجْهِهِ , يُنْفَقُ فِي كُلِّ نَفَقَةٍ مِنْ سَبِيلِ اللَّهِ وَوَجْهِهِ , فِي الْحَرْبِ وَالسِّلْمِ , وَالْخَيْرِ وَذَوِي الرَّحِمِ , وَالْقَرِيبِ وَالْبَعِيدِ , لا يُبَاعُ , وَلا يُوهَبُ , وَلا يُورَّثُ , كُلُّ مَالٍ فِي يَنْبُعَ , غَيْرَ أَنَّ رَبَاحًا وَأَبَا نِيزَرٍ وَجُبَيْرًا إِنْ حَدَثَ بِي حَدَثٌ لَيْسَ عَلَيْهِمْ سَبِيلٌ , وَهُمْ مُحَرَّرُونَ مَوَالٍ يَعْمَلُونَ فِي الْمَالِ خَمْسَ حِجَجٍ , وَفِيهِ نَفَقَاتُهُمْ وَرِزْقُهُمْ , وَرِزْقُ أَهْلِيهِمْ , فَذَلِكَ الَّذِي أَقْضِي فِيمَا كَانَ لِي فِي يَنْبُعَ جَانِبِهِ حَيًّا أَنَا أَوْ مَيِّتًا , وَمَعَهَا مَا كَانَ لِي بِوَادِي أُمِّ الْقُرَى مِنْ مَالٍ وَرَقِيقٍ حَيًّا أَنَا أَوْ مَيِّتًا , وَمَعَ ذَلِكَ الأُذَيْنَةُ وَأَهْلُهَا حَيًّا أَنَا أَوْ مَيِّتًا , وَمَعَ ذَلِكَ رَعْدٌ وَأَهْلُهَا , غَيْرَ أَنَّ زُرَيْقًا مِثْلُ مَا كَتَبْتُ لأَبِي نِيزَرٍ وَرَبَاحٍ وَجُبَيْرٍ ، وَأَنَّ يَنْبُعَ وَمَا فِي وَادِي الْقُرَى وَالأُذَيْنَةِ وَرَعْدٌ يُنْفَقُ فِي كُلِّ نَفَقَةٍ ابْتِغَاءً بِذَلِكَ وَجْهَ اللَّهِ فِي سَبِيلِهِ يَوْمَ تَسْوَدُّ وُجُوهٌ وَتَبْيَضُّ وُجُوهٌ , لا يُبَعْنَ , وَلا يُوهَبْنَ , وَلا يُورَّثْنَ إِلا إِلَى اللَّهِ , هُوَ يَتَقَبَّلَهُنَّ وَهُو يَرِثُهُنَّ , فَذَلِكَ قَضِيَّةٌ بَيْنِي وَبَيْنَ اللَّهِ الغدَ مِنْ يَوْمِ قَدِمْتُ مَسْكَنَ حَيًّا أَنَا أَوْ مَيِّتًا , فَهَذَا مَا قَضَى عَلِيٌّ فِي مَالِهِ وَاجِبَةً بَتْلَةً , ثُمَّ يَقُومُ عَلَى ذَلِكَ بَنُو عَلِيٍّ بِأَمَانَةٍ وَإِصْلاحٍ , كَإِصْلاحِهِمْ أَمْوَالَهُمْ , يُزْرَعُ وَيُصْلَحُ كَإِصْلاحِهِمْ أَمْوَالَهُمْ , وَلا يُبَاعُ مِنْ أَوْلادِ عَلِيٍّ مِنْ هَذِهِ الْقُرَى الأَرْبَعِ وَدِيَّةٌ وَاحِدَةٌ , حَتَّى يَسُدَّ أَرْضَهَا غِرَاسُهَا , قَائِمَةً عِمَارَتُهَا لِلْمُؤْمِنِينَ أَوَّلِهِمْ وَآخِرِهِمْ , فَمَنْ وَلِيَهَا مِنَ النَّاسِ فَأُذَكِّرُ اللَّهَ إِلا جَهَدَ وَنَصَحَ , وَحَفِظَ أَمَانَتَهُ , هَذَا كِتَابُ عَلِيِّ بْنِ أَبِي طَالِبٍ بِيَدِهِ إِذْ قَدِمَ مَسْكَنَ , وَقَدْ أَوْصَيْتُ . . . . الْفَقِيرَيْنِ فِي سَبِيلِ اللَّهِ وَاجِبَةً بَتْلَةً , وَمَالُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى نَاحِيَتِهِ يُنْفَقُ فِي سَبِيلِ اللَّهِ وَوَجْهِهِ , وَذِي الرَّحِمِ , وَالْفُقَرَاءِ , وَالْمَسَاكِينِ , وَابْنِ السَّبِيلِ , يَأْكُلُ مِنْهُ عُمَّالُهُ بِالْمَعْرُوفِ غَيْرَ الْمُنْكَرِ بِأَمَانَةٍ وَإِصْلاحٍ , كَإِصْلاحِهِ مَالَهُ , يَزْرَعُ وَيَنْصَحُ وَيَجْتَهِدُ , هَذَا مَا قَضَى عَلِيُّ بْنُ أَبِي طَالِبٍ فِي هَذِهِ الأَمْوَالِ الَّتِي كَتَبَ فِي هَذِهِ الصَّحِيفَةِ , وَاللَّهُ الْمُسْتَعَانُ عَلَى كُلِّ حَالٍ , أَمَّا بَعْدُ , فَإِنَّ وَلائِدِي اللاتِي أَطُوفُ عَلَيْهِنَّ التِّسْعَ عَشْرَةَ , مِنْهُنَّ أُمَّهَاتُ أَوْلادٍ , وَأَوْلادُهُنَّ أَحْيَاءٌ مَعَهُنَّ , وَمِنْهُنَّ حَبَالَى , وَمِنْهُنَّ مِنْ لا وَلَدَ لَهَا , فَقَضَيْتُ إِنْ حَدَثَ بِي حَدَثٌ فِي هَذَا الْغَزْوِ , أَنَّ مَنْ كَانَ مِنْهُنَّ لَيْسَ لَهَا وَلَدٌ ، وَلَيْسَتْ بِحُبَلَى عَتِيقَةٌ لِوَجْهِ اللَّهِ , لَيْسَ لأَحَدٍ عَلَيْهَا سَبِيلٌ , وَمَنْ كَانَ مِنْهُنَّ حُبْلَى أَوْ لَهَا وَلَدٌ , تُمْسَكُ عَلَى وَلَدِهَا , فَهِيَ مِنْ حَظِّهِ , فَإِنْ مَاتَ وَلَدُهَا وَهِيَ حَيَّةٌ فَلَيْسَ لأَحَدٍ عَلَيْهَا سَبِيلٌ ، هَذَا مَا قَضَيْتُ فِي وَلائِدِي التِّسْعَ عَشْرَةَ ""، وَشَهِدَ عُبَيْدُ اللَّهِ بْنُ أَبِي رَافِعٍ , وَهَيَّاجُ بْنُ أَبِي هَيَّاجٍ , وَكَتَبَ عَلِيٌّ بِيَدِهِ : "" لِعَشْرِ لَيَالٍ خَلَوْنَ مِنْ جُمَادَى الأُولَى سَنَةَ تِسْعٍ وَثَلاثِينَ سَنَةً ""","","","","","The Book of the People of the Two Books"
"18775","بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ :هَذَا كِتَابُ عَبْدِ اللَّهِ عُمَرَ أَمِيرِ الْمُؤْمِنِينَ فِي ثَمْغٍ أَنَّهُ إِنْ تُوُفِّيَ أَنَّهُ إِلَى حَفْصَةَ مَا عَاشَتْ , تُنْفِقُ ثَمَرَهُ حَيْثُ أَرَاهَا اللَّهُ , فَإِنْ تُوُفِّيَتْ فَإِنَّهُ إِلَى ذِي الرَّأْيِ مِنْ أَهْلِهَا , أَلا يَشْتَرِيَ أَصْلَهُ أَبَدًا , وَلا يُوهَبَ , وَمَنْ وَلِيَهُ فَلا حَرَجَ عَلَيْهِ فِي ثَمَرِهِ , إِنْ أَكَلَ أَوْ آكَلَ صَدِيقًا غَيْرَ مُتَمَوِّلٍ مِنْهُ مَالا , فَمَا عَفَا عَنْهُ مِنْ ثَمَرِهِ فَهُو لِلسَّائِلِ , وَالْمَحْرُومِ , وَالضِيفِ , وَذِي الْقُرْبَى , وَابْنِ السَّبِيلِ , وَفِي سَبِيلِ اللَّهِ , يُنْفِقُهُ حَيْثُ أَرَاهُ اللَّهُ مِنْ ذَلِكَ , وَإِنْ تُوُفِّيَتُ , وَمِائَةُ الْوَسْقِ الَّذِي أَطْعَمَنِي مُحَمَّدٌ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْوَادِي بِيَدِي , لَمْ أُهْلِكْهَا , فَإِنَّهَا مَعَ ثَمْغٍ عَلَى السُّنَّةِ الَّتِي أَمَرْتُ بِهَا , وَإِنْ شَاءَ وَلِيُّ ثَمْغٍ اشْتَرَى مِنْ ثَمَرِهِ رَقِيقًا لِعَمَلِهِ "", وَكَتَبَ مُعَيْقِيبٌ وَشَهِدَ عَبْدُ اللَّهِ بْنُ الأَرْقَمِ ""","","","","","The Book of the People of the Two Books"
"18776","بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ :هَذَا مَا أَوْصَى بِهِ عَبْدُ اللَّهِ عُمَرُ أَمِيرُ الْمُؤْمِنِينَ , إِنْ حَدَثَ بِهِ حَدَثٌ "" أَنَّ ثَمْغًا , وَصِرْمَةَ بْنَ الأَكْوَعِ صَدَقَةٌ , وَالْعَبْدَ الَّذِي فِيهِ , وَمِائَةَ السَّهُمُ الَّذِي بِخَيْبَرَ ، وَرَقِيقَهُ الَّذِي فِيهِ , وَالْمِائَةَ الَّتِي أَطْعَمَنِي مُحَمَّدٌ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَلِيهِ حَفْصَةُ مَا عَاشَتْ , ثُمَّ يَلِيهِ ذُو الرَّأْيِ مِنْ أَهْلِهِ , لا يُبَاعُ ، وَلا يُشْتَرَى ، يُنْفِقُهُ حَيْثُ رَأَى ، مِنَ السَّائِلِ , وَالْمَحْرُومِ , وَذِي الْقُرْبَى , وَلا حَرَجَ عَلَى وَلِيِّهِ إِنْ أَكَلَ أَوْ آكَلَ , أَوِ اشْتَرَى رَقِيقًا مِنْهُ ""","","","","","The Book of the People of the Two Books"
"18777","بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ : هَذَا مَا قَضَى عَمْرُو بْنُ الْعَاصِ فِي الْوَهْطِ : "" قَضَى أَنَّهُصَدَقَةٌ فِي سَبِيلِ الصَّدَقَةِ الَّتِي أَمَرَ اللَّهُ بِهَا , عَلَى سُنَّةِ صَدَقَاتِ الْمُسْلِمِينَ , وَتَصَدَّقَ بِهَا ابْتِغَاءَ وَجْهِ اللَّهِ , وَالدَّارِ الآخِرَةِ , لا يُبَاعُ ، وَلا يُوهَبُ ، وَلا يُورَثُ , حَتَّى يَرِثَهُ اللَّهُ قَائِمًا عَلَى أُصُولِهِ , وَلا يَرِثُهُ , وَلا يَجُوزُ لأَحَدٍ مِنَ النَّاسِ تَغْيِيرُ شَيْءٍ مِنَ الَّذِي قَضَيْتُ فِيهِ وَعَهِدْتُ ، وَأُحَرِّمُهُ بِمَا حَرَّمَ اللَّهُ أَمْوَالَ الْمُسْلِمِينَ ، وَأَنْفُسَهُمْ ، وَصَدَقَاتِهِمْ , وَلا يُبَاعُ , وَلا يُورَثُ وَلا يُهْلَكُ , وَلا يُغَيَّرُ قَضَائِي الَّذِي قَضَيْتُ فِيهِ ، وَتَرَكْتُهُ عَلَيْهِ , وَلا يَحِلُّ لِمُسْلِمٍ يَعْبُدُ اللَّهَ تَبْدِيلُ شَيْءٍ مِنْهُ , وَلا تَغْيِيرُهُ عَنْ عَهْدِهِ , وَالَّذِي جَعَلْتُهُ لَهُ ، وَهُو إِلَى وَلِيٍّ مِنْ آلِ عَمْرِو بْنِ الْعَاصِ ، وَوَلِيُّهُ مِنْهُمِ الْمُصْلِحُ غَيْرُ الْمُفْسِدِ , وَالْمُتَّبِعُ فِيهِ قَضَائِي وَعَهْدِي , فَمَنْ أَرَادَ أَنْ يُنْقِصَهُ ، أَوْ يُغَيِّرَ شَيْئًا مِنْهُ ، فَهُو السَّفِيهُ الْمُبْطِلُ الَّذِي لا قَضَاءَ لَهُ فِي صَدَقَتِي , وَلا أَمْرَ , وَلَمْ أَكْتُبْ كِتَابِي هَذَا إِلا خَشْيَةَ أَنْ يُلْحَقَ فِيهِ سَفِيهٌ . . . . بِقَرَابَةٍ ، لا يَعْلَمُ شَأْنَ صَدَقَتِي , وَالَّذِي تَرَكْتُهَا عَلَيْهِ وَعَهِدْتُ فِيهَا ، فَيُحَدِّثُ نَفْسَهُ بِمَا لا يَحِلُّ لَهُ , وَلا يَجُوزُ لِقِلَّةِ عِلْمِهِ وَسَفَهِ رَأْيِهِ ، فَلَيْسَ لأَحَدٍ مِنْ أُولَئِكَ فِي صَدَقَتِي حَقٌّ , وَلا أَمْرٌ , وَأُحَرِّجُ بِاللَّهِ عَلَى كُلِّ مُسْلِمٍ يَعْبُدُ اللَّهَ مِنْ ذِي قَرَابَةٍ أَوْ غَيْرِهِ ، وَإِمَامٍ وَلاهُ اللَّهُ أَمْرَ الْمُسْلِمِينَ ، أَنْ يُغَيِّرَ صَدَقَتِي عَنْ مَا وَصَّيْتُ فِيهَا أَوْ قَضَيْتُ ، وَتَرَكْتُهَا عَلَيْهِ ، طَلْحَةُ بْنُ عُبَيْدِ اللَّهِ , وَمَعْبَدُ بْنُ مَعْمَرٍ وَعَبْدُ الرَّحْمَنِ بْنُ عَوْفٍ , وَأَبُو جَهْمِ بْنُ حُذَيْفَةَ , وَالْحَارِثُ بْنُ الْحَكَمِ , وَسَعْدُ بْنُ أَبِي وَقَّاصٍ , وَعَبْدُ الرَّحْمَنِ بْنُ مُطِيعٍ , وَجُبَيْرُ بْنُ الْحُويْرِثِ , وَأَبُو سُفْيَانَ بْنُ مَاهِدٍ , وَنَافِعُ بْنُ طَرِيفٍ , وَكُتِبَ لِعَشْرِ لَيَالٍ خَلَوْنَ مِنَ الْمُحَرَّمِ مِنْ سَنَةِ تِسْعٍ وَعِشْرِينَ ""","","","","","The Book of the People of the Two Books"
