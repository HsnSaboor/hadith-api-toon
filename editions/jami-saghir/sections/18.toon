hadiths[188]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3963","«عائد المريض في مخرفة الجنة فإذا جلس عنده غمرته الرحمة»","صحيح","Sahih al-Jami al-Saghir 3963","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3964","«عائد المريض يمشي في مخرفة الجنة حتى يرجع»","صحيح","Sahih al-Jami al-Saghir 3964","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3965","«عائشة زوجتي في الجنة»","صحيح","Sahih al-Jami al-Saghir 3965","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3966","«عادى الله من عادى عليا»","صحيح","Sahih al-Jami al-Saghir 3966","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3967","«عارية مؤداة»","صحيح","Sahih al-Jami al-Saghir 3967","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3968","«عاشوراء يوم العاشر»","صحيح","Sahih al-Jami al-Saghir 3968","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3969","«عالجيها بكتاب الله»","صحيح","Sahih al-Jami al-Saghir 3969","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3970","«عامة أهل النار النساء»","صحيح","Sahih al-Jami al-Saghir 3970","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3971","«عامة عذاب القبر من البول»","صحيح","Sahih al-Jami al-Saghir 3971","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3972","«عباد الله لتسون صفوفكم أو ليخالفن الله بين وجوهكم»","صحيح","Sahih al-Jami al-Saghir 3972","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3973","«عباد الله! وضع الله الحرج إلا امرءا اقترض امرءا ظلما فذاك يحرج ويهلك عباد الله! تدأووا فإن الله تعالى لم يضع داء إلا وضع له دواء إلا داء واحدا: الهرم»","صحيح","Sahih al-Jami al-Saghir 3973","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3974","«عبادة في الهرج والفتنة كهجرة إلي»","صحيح","Sahih al-Jami al-Saghir 3974","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3975","«عبد الله بن سلام عاشر عشرة في الجنة»","صحيح","Sahih al-Jami al-Saghir 3975","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3976","«عتق النسمة أن تنفرد بعتقها وفك الرقبة أن تعين في عتقها»","صحيح","Sahih al-Jami al-Saghir 3976","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3977","«عثمان أحيا أمتي.. ... »","صحيح","Sahih al-Jami al-Saghir 3977","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3978","«عثمان حيي تستحيي منه الملائكة»","صحيح","Sahih al-Jami al-Saghir 3978","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3979","«عثمان في الجنة»","صحيح","Sahih al-Jami al-Saghir 3979","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3980","«عجبا لأمر المؤمن إن أمره كله له خير وليس ذلك لأحد إلا للمؤمن إن أصابته سراء شكر وكان خيرا له وإن أصابته ضراء صبر فكان خيرا له»","صحيح","Sahih al-Jami al-Saghir 3980","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3981","«عجب ربنا من رجل غزا في سبيل الله فانهزم أصحابه فعلم ما عليه فرجع حتى أهريق دمه فيقول الله عز وجل لملائكته: انظروا إلى عبدي رجع رغبة فيما عندي وشفقة مما عندي حتى أهريق دمه»","حسن","Sahih al-Jami al-Saghir 3981","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3982","«عجب ربنا من قوم يقادون إلى الجنة في السلاسل»","صحيح","Sahih al-Jami al-Saghir 3982","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3983","«عجبت لأقوام يساقون إلى الجنة في السلاسل وهم كارهون»","حسن","Sahih al-Jami al-Saghir 3983","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3984","«عجبت لصبر أخي يوسف وكرمه والله يغفر له حيث أرسل إليه ليستفتى في الرؤيا ولو كنت أنا لم أفعل حتى أخرج وعجبت لصبره وكرمه والله يغفر له أتي ليخرج فلم يخرج حتى أخبرهم بعذره ولو كنت أنا لبادرت» . الباب ولولا الكلمة لما لبث في السجن حيث يبتغي الفرج من عند غير الله عز وجل","صحيح","Sahih al-Jami al-Saghir 3984","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3985","«عجبت للمؤمن إن الله تعالى لم يقض له قضاء إلا كان خيرا له»","صحيح","Sahih al-Jami al-Saghir 3985","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3986","«عجبت للمسلم إذا أصابته مصيبة احتسب وصبر وإذا أصابه خير حمد الله وشكر إن المسلم يؤجر في كل شيء حتى في اللقمة يرفعها إلى فيه»","صحيح","Sahih al-Jami al-Saghir 3986","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3987","«عجبت من قوم من أمتي يركبون البحر كالملوك على الأسرة»","صحيح","Sahih al-Jami al-Saghir 3987","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3988","«عجلت أيها المصلي! إذا صليت فقعدت فاحمد الله بما هوأهله ثم صل علي ثم ادعه»","صحيح","Sahih al-Jami al-Saghir 3988","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3989","«عجلوا الإفطار وأخروا السحور»","صحيح","Sahih al-Jami al-Saghir 3989","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3990","«عجلوا الخروج إلى مكة فإن أحدكم لا يدري ما يعرض له من مرض أو حاجة»","حسن","Sahih al-Jami al-Saghir 3990","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3991","«عدد آنية الحوض كعدد نجوم السماء»","صحيح","Sahih al-Jami al-Saghir 3991","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3992","«عذاب القبر حق»","صحيح","Sahih al-Jami al-Saghir 3992","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3993","«عذاب أمتي في دنياها»","صحيح","Sahih al-Jami al-Saghir 3993","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3994","«عذاب هذه الأمة جعل بأيديها في دنياها»","صحيح","Sahih al-Jami al-Saghir 3994","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3995","«عذبت امرأة في هرة حبستها حتى ماتت جوعا فدخلت فيها النار قال الله: لا أنت أطعمتيها ولا سقيتيها حين حبستيها ولا أنت أرسلتيها فأكلت من خشاش الأرض»","صحيح","Sahih al-Jami al-Saghir 3995","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3996","«عذبت امرأة في هر ربطته حتى مات ولم ترسله فيأكل من خشاش الأرض فوجبت لها النار بذلك»","صحيح","Sahih al-Jami al-Saghir 3996","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3997","«عرج بي حتى ظهرت بمستوى أسمع فيه صريف الأقلام»","صحيح","Sahih al-Jami al-Saghir 3997","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3998","«عرش كعرش موسى»","صحيح","Sahih al-Jami al-Saghir 3998","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"3999","«عرضت علي الأمم فرأيت النبي ومعه الرهط والنبي ومعه الرجل والرجلان والنبي وليس معه أحد إذ رفع لي سواد عظيم فظننت أنهم أمتي فقيل لي: هذا موسى وقومه ولكن انظر إلى الأفق فإذا سواد عظيم فقيل لي: انظر إلى الأفق الآخر فإذا سواد عظيم فقيل لي: هذه أمتك ومعهم سبعون ألفا يدخلون الجنة بغير حساب ولا عذاب هم الذين لا يرقون ولا يسترقون ولا يتطيرون ولا يكتوون وعلى ربهم يتوكلون»","صحيح","Sahih al-Jami al-Saghir 3999","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4000","«عرضت علي الأيام فعرض علي فيها يوم الجمعة فإذا هي كمرآة بيضاء وإذا في وسطها نكتة سوداء فقلت: ما هذه؟ قيل: الساعة»","صحيح","Sahih al-Jami al-Saghir 4000","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4001","«عرضت علي الجنة حتى لومددت يدي تنأولت من قطوفها وعرضت علي النار فجعلت أنفخ خشية أن يغشاكم حرها ورأيت فيها سارق بدنة رسول الله ورأيت فيها أخا بني دعدع سارق الحجيج فإذا فطن له قال: هذا عمل المحجن ورأيت فيها امرأة طويلة سوداء تعذب في هرة ربطتها فلم تطعمها ولم تسقها ولم تدعها تأكل من خشاش الأرض حتى ماتت وإن الشمس والقمر لا ينكسفان لموت أحد ولا لحياته ولكنهما آيتان من آيات الله فإذا انكسف أحدهما فاسعوا إلى ذكر الله عز وجل»","صحيح","Sahih al-Jami al-Saghir 4001","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4002","«عرضت علي الجنة والنار آنفا في عرض هذا الحائط فلم أر كاليوم في الخير والشر ولو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا»","صحيح","Sahih al-Jami al-Saghir 4002","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4003","«عرضت علي أمتي بأعمالها حسنها وسيئها فرأيت في محاسن أعمالها إماطة الأذى عن الطريق ورأيت في سيء أعمالها النخاعة في المسجد لم تدفن»","صحيح","Sahih al-Jami al-Saghir 4003","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4004","«عرض علي الأنبياء فإذا موسى ضرب من الرجال كأنه من رجال شنوءة ورأيت عيسى ابن مريم فإذا أقرب من رأيت به شبها عروة بن مسعود ورأيت إبراهيم فإذا أقرب من رأيت به شبها صاحبكم - يعني نفسه صلى الله عليه وسلم - ورأيت جبريل فإذا أقرب من رأيت به شبها دحية»","صحيح","Sahih al-Jami al-Saghir 4004","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4005","«عرفة كلها موقف»","صحيح","Sahih al-Jami al-Saghir 4005","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4006","«عرفة كلها موقف وارتفعوا عن بطن عرنة ومزدلفة كلها موقف وارتفعوا عن بطن محسر ومنى كلها منحر»","صحيح","Sahih al-Jami al-Saghir 4006","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4007","«عريشا كعريش موسى ثمام وخشيبات والأمر أعجل من ذلك»","حسن","Sahih al-Jami al-Saghir 4007","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4008","«عسى رجل يحدث بما يكون بينه وبين أهله أو عسى امرأة تحدث بما يكون بينها وبين زوجها فلا تفعلوا فإن مثل ذلك مثل شيطان لقي شيطانة في ظهر الطريق فغشيها والناس ينظرون»","حسن","Sahih al-Jami al-Saghir 4008","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4009","«عشر من الفطرة: قص الشارب وإعفاء اللحية والسواك واستنشاق الماء وقص الأظفار وغسل البراجم ونتف الإبط وحلق العانة وانتقاص الماء»","حسن","Sahih al-Jami al-Saghir 4009","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4010","«عشرة في الجنة: النبي في الجنة وأبوبكر في الجنة وعمر في الجنة وعثمان في الجنة وعلي في الجنة وطلحة في الجنة والزبير بن العوام في الجنة وسعد بن مالك في الجنة وعبد الرحمن ابن عوف في الجنة وسعيد بن زيد في الجنة»","صحيح","Sahih al-Jami al-Saghir 4010","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4011","«عصبة من المسلمين يفتحون البيت الأبيض بيت كسرى»","صحيح","Sahih al-Jami al-Saghir 4011","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4012","«عصابتان من أمتي أحرزهما الله من النار عصابة تغزو الهند وعصابة تكون مع عيسى ابن مريم»","صحيح","Sahih al-Jami al-Saghir 4012","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4013","«عظم الأجر عند عظم المصيبة وإذا أحب الله قوما ابتلاهم»","صحيح","Sahih al-Jami al-Saghir 4013","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4014","«عقر دار الإسلام بالشام»","حسن","Sahih al-Jami al-Saghir 4014","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4015","«عقل أهل الذمة نصف عقل المسلمين»","حسن","Sahih al-Jami al-Saghir 4015","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4016","«عقل شبه العمد مغلظ مثل عقل العمد ولا يقتل صاحبه»","حسن","Sahih al-Jami al-Saghir 4016","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4017","«عقوبة هذه الأمة بالسيف»","صحيح","Sahih al-Jami al-Saghir 4017","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4018","«علام تدغرن أولادكن بهذا العلاق؟! عليكن بهذا العود الهندي فإن فيه سبعة أشفية من سبعة أدواء منها ذات الجنب ويسعط به من العذرة ويلد به من ذات الجنب»","صحيح","Sahih al-Jami al-Saghir 4018","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4019","«علام تومئون بأيديكم كأنها أذناب خيل شمس؟! وإنما يكفي أحدكم أن يضع يده على فخذه ثم يسلم على أخيه من على يمينه وشماله»","صحيح","Sahih al-Jami al-Saghir 4019","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4020","«علام يقتل أحدكم أخاه إذا رأى أحدكم من أخيه ما يعجبه فليدع له بالبركة»","صحيح","Sahih al-Jami al-Saghir 4020","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4021","«علقوا السوط حيث يراه أهل البيت»","صحيح","Sahih al-Jami al-Saghir 4021","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4022","«علقوا السوط حيث يراه أهل البيت فإنه أدب لهم»","حسن","Sahih al-Jami al-Saghir 4022","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4023","«علم لا يقال به ككنز لا ينفق منه»","صحيح","Sahih al-Jami al-Saghir 4023","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4024","«علم لا ينفع ككنز لا ينفق منه»","صحيح","Sahih al-Jami al-Saghir 4024","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4025","«علموا الصبي ابن سبع سنين واضربوه عليها ابن عشر»","صحيح","Sahih al-Jami al-Saghir 4025","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4026","«علموا أولادكم الصلاة إذا بلغوا سبعا واضربوهم عليها إذا بلغوا عشرا وفرقوا بينهم في المضاجع»","صحيح","Sahih al-Jami al-Saghir 4026","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4027","«علموا ويسروا ولا تعسروا وبشروا ولا تنفروا وإذا غضب أحدكم فليسكت»","صحيح","Sahih al-Jami al-Saghir 4027","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4028","«علمي حفصة رقية النملة»","صحيح","Sahih al-Jami al-Saghir 4028","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4029","«على أنقاب المدينة ملائكة لا يدخلها الطاعون ولا الدجال»","صحيح","Sahih al-Jami al-Saghir 4029","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4030","«على ذروة كل بعير شيطان فامتهنوهن بالركوب فإنما يحمل الله تعالى»","صحيح","Sahih al-Jami al-Saghir 4030","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4031","«على ظهر كل بعير شيطان فإذا ركبتموها فسموا الله ثم لا تقصروا عن حاجاتكم»","صحيح","Sahih al-Jami al-Saghir 4031","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4032","«على كل باب من أبواب المسجد ملكان يكتبان الأول فالأول فكرجل قدم بدنة وكرجل قدم بقرة وكرجل قدم شاة وكرجل قدم طيرا وكرجل قدم بيضة فإذا قعد الإمام طويت الصحف»","صحيح","Sahih al-Jami al-Saghir 4032","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4033","«على كل بطن عقولة»","صحيح","Sahih al-Jami al-Saghir 4033","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4034","«على كل رجل مسلم في كل سبعة أيام غسل يوم وهو يوم الجمعة»","صحيح","Sahih al-Jami al-Saghir 4034","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4035","«على كل سلامى من ابن آدم في كل يوم صدقة ويجزي عن ذلك كله ركعتا الضحى»","صحيح","Sahih al-Jami al-Saghir 4035","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4036","«على كل محتلم رواح الجمعة وعلى كل من راح الجمعة الغسل»","صحيح","Sahih al-Jami al-Saghir 4036","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4037","«على كل مسلم صدقة فإن لم يجد فيعمل بيده فينفع نفسه ويتصدق فإن لم يستطع فيعين ذا الحاجة الملهوف فإن لم يفعل فيأمر بالخير فإن لم يفعل فيمسك عن الشر فإنه له صدقة»","صحيح","Sahih al-Jami al-Saghir 4037","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4038","«على كل نفس في كل يوم طلعت عليه الشمس صدقة منه على نفسه من أبواب الصدقة: التكبير وسبحان الله والحمد لله ولا إله إلا الله واستغفر الله ويأمر بالمعروف وينهى عن المنكر ويعزل الشوك عن طريق الناس والعظم والحجر وتهدي الأعمى وتسمع الأصم والأبكم حتى يفقه وتدل المستدل على حاجة له قد علمت مكانها وتسعى بشدة ساقيك إلى اللهفان المستغيث وترفع بشدة ذراعيك مع الضعيف كل ذلك من أبواب الصدقة منك على نفسك ولك في جماعك زوجتك أجر أرأيت لوكان لك ولد فأدرك ورجوت أجره فمات أكنت تحتسب به؟ فأنت خلقته؟ فأنت هديته؟ فأنت كنت ترزقه؟ فكذلك فضعه في حلاله وجنبه حرامه فإن شاء الله أحياه وإن شاء أماته ولك أجر»","صحيح","Sahih al-Jami al-Saghir 4038","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4039","«عليك السمع والطاعة في عسرك ويسرك ومنشطك ومكرهك وأثرة عليك»","صحيح","Sahih al-Jami al-Saghir 4039","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4040","«عليك بالخيل فإن الخيل معقود في نواصيها الخير إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 4040","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4041","«عليك بالرفق إن الرفق لا يكون في شيء إلا زانه ولا ينزع من شيء إلا شانه»","صحيح","Sahih al-Jami al-Saghir 4041","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4042","«عليك بالرفق وإياك والعنف والفحش»","صحيح","Sahih al-Jami al-Saghir 4042","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4043","«عليك بالصعيد فإنه يكفيك»","صحيح","Sahih al-Jami al-Saghir 4043","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4044","«عليك بالصوم فإنه لا مثل له»","صحيح","Sahih al-Jami al-Saghir 4044","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4045","«عليك بالهجرة فإنه لا مثل لها» عليك بالجهاد فإنه لا مثل لها.....، عليك بالصوم فإنه لا مثل له عليك بالسجود فإنك لا تسجد لله سجدة إلا رفعك الله بها درجة وحط عنك بها خطيئة","صحيح","Sahih al-Jami al-Saghir 4045","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4046","«عليك بتقوى الله تعالى والتكبير على كل شرف»","حسن","Sahih al-Jami al-Saghir 4046","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4047","عليك بجمل الدعاء وجوامعه قولي: اللهم إني أسألك من الخير كله عاجله وآجله ما علمت منه وما لم أعلم وأعوذ بك من الشر كله عاجله وآجله ما علمت منه وما لم أعلم وأسألك الجنة وما قرب إليها من قول أو عمل وأعوذ بك من النار وما قرب إليها من قول أو عمل وأسألك مما سألك به محمد صلى الله عليه وسلم وأعوذ بك مما تعوذ به محمد صلى الله عليه وسلم وما قضيت لي من قضاء فاجعل عاقبته رشدا","صحيح","Sahih al-Jami al-Saghir 4047","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4048","«عليك بحسن الخلق وطول الصمت فوالذي نفسي بيده ما تجمل الخلائق بمثلهما»","حسن","Sahih al-Jami al-Saghir 4048","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4049","«عليك بحسن الكلام وبذل الطعام»","صحيح","Sahih al-Jami al-Saghir 4049","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4050","«عليك بكثرة السجود فإنك لا تسجد لله سجدة إلا رفعك الله بها درجة وحط بها عنك خطيئة»","صحيح","Sahih al-Jami al-Saghir 4050","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4051","«عليكم بأسقية الأدم التي يلاث على أفواهها»","صحيح","Sahih al-Jami al-Saghir 4051","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4052","«عليكم باصطناع المعروف فإنه يمنع مصارع السوء وعليكم بصدقة السر فإنها تطفئ غضب الرب عز وجل»","صحيح","Sahih al-Jami al-Saghir 4052","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4053","عليكم بالأبكار فإنهن أعذب أفواها وأنتق أرحاما، وأسخن أقبالا وأرضى باليسير من العمل","حسن","Sahih al-Jami al-Saghir 4053","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4054","«عليكم بالإثمد عند النوم فإنه يجلو البصر وينبت الشعر»","صحيح","Sahih al-Jami al-Saghir 4054","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4055","«عليكم بالإثمد فإنه منبتة للشعر مذهبة للقذى مصفاة للبصر»","حسن","Sahih al-Jami al-Saghir 4055","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4056","«عليكم بالإثمد فإنه يجلو البصر وينبت الشعر»","صحيح","Sahih al-Jami al-Saghir 4056","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4057","«عليكم بالأسود البهيم ذي النقطتين فإنه شيطان»","صحيح","Sahih al-Jami al-Saghir 4057","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4058","«عليكم بالباءة فمن لم يستطع فعليه بالصوم فإنه له وجاء»","صحيح","Sahih al-Jami al-Saghir 4058","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4059","«عليكم بألبان البقر فإنها ترم من كل الشجر وهو شفاء من كل داء»","صحيح","Sahih al-Jami al-Saghir 4059","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4060","«عليكم بألبان البقر فإنها دواء وأسمانها فإنها شفاء! وإياكم ولحومها فإن لحومها داء»","صحيح","Sahih al-Jami al-Saghir 4060","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4061","«عليكم بألبان البقر فإنها شفاء وسمنها دواء ولحمها داء»","صحيح","Sahih al-Jami al-Saghir 4061","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4062","«عليكم بالبياض من الثياب فليلبسها أحياؤكم وكفنوا فيها موتاكم فإنها خير ثيابكم»","صحيح","Sahih al-Jami al-Saghir 4062","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4063","«عليكم بالجهاد في سبيل الله فإنه باب من أبواب الجنة يذهب الله به الهم والغم»","صحيح","Sahih al-Jami al-Saghir 4063","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4064","«عليكم بالدلجة فإن الأرض تطوى بالليل»","صحيح","Sahih al-Jami al-Saghir 4064","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4065","«عليكم بالرمي فإنه من خير لعبكم»","صحيح","Sahih al-Jami al-Saghir 4065","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4066","«عليكم بالرمي فإنه من خير لهوكم»","صحيح","Sahih al-Jami al-Saghir 4066","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4067","«عليكم بالسنا والسنوت فإن فيهما شفاء من كل داء إلا السام وهو الموت»","حسن","Sahih al-Jami al-Saghir 4067","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4068","«عليكم بالسواك فإنه مطيبة للفم مرضاة للرب»","صحيح","Sahih al-Jami al-Saghir 4068","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4069","«عليكم بالشام»","صحيح","Sahih al-Jami al-Saghir 4069","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4070","«عليكم بالشام فإنها صفوة بلاد الله يسكنها خيرته من خلقه فمن أبى فليلحق بيمنه وليسق من غدره فإن الله عز وجل تكفل لي بالشام وأهله»","صحيح","Sahih al-Jami al-Saghir 4070","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4071","«عليكم بالصدق فإن الصدق يهدي إلى البر وإن البر يهدي إلى الجنة وما يزال الرجل يصدق ويتحرى الصدق حتى يكتب عند الله صديقا وإياكم والكذب فإن الكذب يهدي إلى الفجور وإن الفجور يهدي إلى النار وما يزال الرجل يكذب ويتحرى الكذب حتى يكتب عند الله كذابا»","صحيح","Sahih al-Jami al-Saghir 4071","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4072","«عليكم بالصدق فإنه مع البر وهما في الجنة وإياكم والكذب فإنه مع الفجور وهما في النار وسلوا الله اليقين والمعافاة فإنه لم يؤت أحد بعد اليقين خيرا من المعافاة ولا تحاسدوا ولا تباغضوا ولا تقاطعوا ولا تدابروا وكونوا عباد الله إخوانا كما أمركم الله»","صحيح","Sahih al-Jami al-Saghir 4072","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4073","«عليكم بالغنم فإنها من دواب الجنة وصلوا في مراحها وامسحوا رغامها»","صحيح","Sahih al-Jami al-Saghir 4073","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4074","«عليكم بثياب البياض فليلبسها أحياؤكم وكفنوا فيها موتاكم»","صحيح","Sahih al-Jami al-Saghir 4074","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4075","«عليكم بثياب البيض فالبسوها وكفنوا فيها موتاكم»","صحيح","Sahih al-Jami al-Saghir 4075","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4076","«عليكم بحصى الخذف الذي ترمى به الجمرة»","صحيح","Sahih al-Jami al-Saghir 4076","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4077","«عليكم برخصة الله التي رخص لكم»","صحيح","Sahih al-Jami al-Saghir 4077","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4078","«عليكم بشواب النساء فإنهن أطيب أفواها وأنتق أرحاما وأسخن أقبالا»","صحيح","Sahih al-Jami al-Saghir 4078","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4079","«عليكم بقيام الليل فإنه دأب الصالحين قبلكم وقربة إلى الله تعالى ومنهاة عن الإثم وتكفير للسيئات، ومطردة للداء عن الجسد»","صحيح","Sahih al-Jami al-Saghir 4079","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4080","«عليكم بلحم الظهر فإنه من أطيبه»","حسن","Sahih al-Jami al-Saghir 4080","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4081","«عليكم بهذا السحور فإنه هو الغداء المبارك»","صحيح","Sahih al-Jami al-Saghir 4081","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4082","«عليكم بهذا العود الهندي فإن فيه سبعة أشفية يستعط به من العذرة ويلد به من ذات الجنب»","صحيح","Sahih al-Jami al-Saghir 4082","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4083","«عليكم بهذه الحبة السوداء فإن فيها شفاء من كل داء إلا السام وهو الموت»","صحيح","Sahih al-Jami al-Saghir 4083","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4084","«عليكم بهذه الصلاة في بيوتكم - يعني سنة المغرب»","صحيح","Sahih al-Jami al-Saghir 4084","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4085","«عليكم من الأعمال بما تطيقون فإن الله لا يمل حتى تملوا»","صحيح","Sahih al-Jami al-Saghir 4085","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4086","«عليكم هديا قاصدا فإنه من يشاد هذا الدين يغلبه»","صحيح","Sahih al-Jami al-Saghir 4086","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4087","«عليكن بالتسبيح والتهليل والتقديس واعقدن بالأنامل فإنهن مسئولات مستنطقات ولا تغفلن فتنسين الرحمة»","حسن","Sahih al-Jami al-Saghir 4087","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4088","«عليهم ما حملوا وعليكم ما حملتم»","صحيح","Sahih al-Jami al-Saghir 4088","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4089","«علي بن أبي طالب مولى من كنت مولاه»","صحيح","Sahih al-Jami al-Saghir 4089","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4090","«علي مني بمنزلة هارون من موسى إلا أنه لا نبي بعدي»","صحيح","Sahih al-Jami al-Saghir 4090","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4091","«علي مني وأنا من علي ولا يؤدي عني إلا أنا أو علي»","حسن","Sahih al-Jami al-Saghir 4091","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4092","«علي يقضي ديني»","حسن","Sahih al-Jami al-Saghir 4092","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4093","«عمدا صنعته يا عمر»","حسن","Sahih al-Jami al-Saghir 4093","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4094","«عمر أمتي بين الستين سنة إلى سبعين»","صحيح","Sahih al-Jami al-Saghir 4094","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4095","«عمروبن العاص من صالحي قريش»","صحيح","Sahih al-Jami al-Saghir 4095","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4096","«عمران بيت المقدس خراب يثرب وخراب يثرب خروج الملحمة وخروج الملحمة فتح القسطنطينية وفتح القسطنطينية خروج الدجال»","صحيح","Sahih al-Jami al-Saghir 4096","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4097","«عمرة في رمضان تعدل حجة»","صحيح","Sahih al-Jami al-Saghir 4097","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4098","«عمرة في رمضان كحجة معي»","صحيح","Sahih al-Jami al-Saghir 4098","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
"4099","«عمل هذا قليلا وأجر كثيرا»","صحيح","Sahih al-Jami al-Saghir 4099","","","الأحاديث المبدوءة بحرف العين Hadith Beginning with the Letter 'Ayn (ع)"
