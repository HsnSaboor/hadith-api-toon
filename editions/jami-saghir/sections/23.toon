hadiths[473]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"5026","«لأخرجن اليهود والنصارى من جزيرة العرب حتى لا أدع إلا مسلما»","صحيح","Sahih al-Jami al-Saghir 5026","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5027","«لأذودن عن حوضي رجالا كما تذاد الغريبة من الإبل»","صحيح","Sahih al-Jami al-Saghir 5027","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5028","«لأعلمن أقواما من أمتي يأتون يوم القيامة بحسنات أمثال جبال تهامة بيضاء فيجعلها الله هباء منثورا أما إنهم إخوانكم ومن جلدتكم ويأخذون من الليل كما تأخذون ولكنهم قوم إذا خلوا بمحارم الله انتهكوها»","صحيح","Sahih al-Jami al-Saghir 5028","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5029","«لألقين الله من قبل أن أعطي أحدا من مال أحد شيئا بغير طيب نفس إنما البيع عن تراض»","صحيح","Sahih al-Jami al-Saghir 5029","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5030","«لله أشد فرحا بتوبة عبده حين يتوب إليه من أحدكم كان على راحلته بأرض فلاة فانفلتت منه وعليها طعامه وشرابه فأيس منها فأتى شجرة فاضطجع في ظلها قد أيس من راحلته فبينما هوكذلك إذ هوبها قائمة عنده فأخذ بخطامها ثم قال من شدة الفرح: اللهم أنت عبدي وأنا ربك! أخطأ من شدة الفرح»","صحيح","Sahih al-Jami al-Saghir 5030","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5031","«لله أشد فرحا بتوبة عبده من أحدكم إذا سقط عليه بعيره قد أضله بأرض فلاة»","صحيح","Sahih al-Jami al-Saghir 5031","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5032","«لله أفرح بتوبة أحدكم من أحدكم بضالته إذا وجدها»","صحيح","Sahih al-Jami al-Saghir 5032","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5033","«لله أفرح بتوبة العبد من رجل نزل منزلا وبه مهلكه ومعه راحلته عليها طعامه وشرابه فوضع رأسه فنام نومة فاستيقظ وقد ذهبت راحلته فطلبها حتى إذا اشتد عليه الحر والعطش قال: أرجع إلى مكاني الذي كنت فيه فأنام حتى أموت ثم رفع رأسه فإذا راحلته عنده عليها زاده: طعامه وشرابه! فالله أشد فرحا بتوبة العبد المؤمن من هذا براحلته وزاده»","صحيح","Sahih al-Jami al-Saghir 5033","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5034","«لله أقدر عليك منك عليه»","صحيح","Sahih al-Jami al-Saghir 5034","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5035","«لأن أطأ على جمرة أحب إلي من أن أطأ على قبر»","صحيح","Sahih al-Jami al-Saghir 5035","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5036","«لأن أقعد مع قوم يذكرون الله تعالى من صلاة الغداة حتى تطلع الشمس أحب إلي من أن أعتق أربعة من ولد إسماعيل ولأن أقعد مع قوم يذكرون الله من صلاة العصر إلى أن تغرب الشمس أحب إلي من أن أعتق أربعة»","حسن","Sahih al-Jami al-Saghir 5036","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5037","«لأن أقول سبحان الله والحمد لله ولا إله إلا الله والله أكبر أحب إلي مما طلعت عليه الشمس»","صحيح","Sahih al-Jami al-Saghir 5037","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5038","«لأن أمشي على جمرة أو سيف أو أخصف نعلي برجلي أحب إلي من أن أمشي على قبر مسلم وما أبالي أوسط القبر قضيت حاجتي أو وسط السوق»","صحيح","Sahih al-Jami al-Saghir 5038","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5039","«لأن تصلي المرأة في بيتها خير لها من أن تصلي في حجرتها ولأن تصلي في حجرتها خير لها من أن تصلي في الدار ولأن تصلي في الدار خير لها من أن تصلي في المسجد»","حسن","Sahih al-Jami al-Saghir 5039","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5040","«لأن يأخذ أحدكم حبله ثم يغدوإلى الجبل فيحتطب فيبيع فيأكل ويتصدق خير له من أن يسأل الناس»","صحيح","Sahih al-Jami al-Saghir 5040","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5041","«لأن يأخذ أحدكم حبله فيأتي الجبل فيجيء بحزمة الحطب على ظهره فيبيعها فيكف الله بها وجهه خير له من أن يسأل الناس أعطوه أو منعوه»","صحيح","Sahih al-Jami al-Saghir 5041","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5042","«لأن يجلس أحدكم على جمرة فتحرق ثيابه فتخلص إلى جلده خير له من أن يجلس على قبر»","صحيح","Sahih al-Jami al-Saghir 5042","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5043","«لأن يزني الرجل بعشر نسوة خير له من أن يزني بامرأة جاره ولأن يسرق الرجل من عشرة أبيات أيسر له من أن يسرق من بيت جاره»","صحيح","Sahih al-Jami al-Saghir 5043","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5044","«لأن يطأ الرجل على جمرة خير له من أن يطأ على قبر»","صحيح","Sahih al-Jami al-Saghir 5044","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5045","«لأن يطعن في رأس أحدكم بمخيط من حديد خير له من أن يمس امرأة لا تحل له»","صحيح","Sahih al-Jami al-Saghir 5045","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5046","«لأن يغدو أحدكم فيحتطب على ظهره فيتصدق منه ويستغني به عن الناس خير له من أن يسأل رجلا أعطاه أو منعه ذلك بأن اليد العليا أفضل من اليد السفلى وابدأ بمن تعول»","صحيح","Sahih al-Jami al-Saghir 5046","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5047","«لأن يقوم أحدكم أربعين خير له من أن يمر بين يدي المصلي»","صحيح","Sahih al-Jami al-Saghir 5047","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5048","«لأن يمتلئ جوف أحدكم قيحا حتى يريه خير له من أن يمتلئ شعرا»","صحيح","Sahih al-Jami al-Saghir 5048","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5049","«لأن يمتلئ جوف رجل قيحا حتى يريه خير له من أن يمتلئ شعرا»","صحيح","Sahih al-Jami al-Saghir 5049","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5050","«لأن يمنح الرجل أخاه أرضه خير له من أن يأخذ عليها خراجا معلوما»","صحيح","Sahih al-Jami al-Saghir 5050","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5051","«لأنا أعلم بما مع الدجال من الدجال معه نهران يجريان أحدهما رأي العين ماء أبيض والآخر رأي العين نار تأجج فإما أدركهن واحد منكم فليأت النهر الذي يراه نارا ثم ليغمس ثم ليطأطئ رأسه فيشرب فإنه ماء بارد وإن الدجال ممسوح العين اليسرى عليها ظفرة غليظة مكتوب بين عينيه كافر يقرؤه كل مؤمن كاتب وغير كاتب»","صحيح","Sahih al-Jami al-Saghir 5051","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5052","«لئن بقيت إلى قابل لأصومن التاسع»","صحيح","Sahih al-Jami al-Saghir 5052","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5053","«لئن عشت إن شاء الله لأخرجن اليهود والنصارى من جزيرة العرب»","صحيح","Sahih al-Jami al-Saghir 5053","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5054","«لئن عشت إن شاء الله لأنهيهن أن يسمى رباح ونجيح وأفلح ويسار»","صحيح","Sahih al-Jami al-Saghir 5054","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5055","«لئن كنت كما قلت فكأنما تسفهم المل ولا يزال معك من الله ظهير عليهم ما دمت على ذلك»","صحيح","Sahih al-Jami al-Saghir 5055","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5056","«لأنهين أن يسمى بنافع وبركة ويسار»","صحيح","Sahih al-Jami al-Saghir 5056","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5057","«لبيك إله الحق لبيك»","صحيح","Sahih al-Jami al-Saghir 5057","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5058","«لبيك اللهم لبيك إنما الخير خير الآخرة»","حسن","Sahih al-Jami al-Saghir 5058","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5059","«لبيك اللهم لبيك لبيك لا شريك لك لبيك إن الحمد والنعمة لك والملك لا شريك لك»","صحيح","Sahih al-Jami al-Saghir 5059","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5060","«لبن الدر يحلب بنفقته إذا كان مرهونا والظهر يركب بنفقته إذا كان مرهونا وعلى الذي يركب ويحلب النفقة»","صحيح","Sahih al-Jami al-Saghir 5060","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5061","«لتأخذوا عني مناسككم فإني لا أدري لعلي لا أحج بعد حجتي هذه»","صحيح","Sahih al-Jami al-Saghir 5061","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5062","""لتؤدن الحقوق إلى أهلها يوم القيامة حتى يقاد للشاة الجلحاء من الشاة القرناء تنطحها""","صحيح","Sahih al-Jami al-Saghir 5062","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5063","«لتتبعن سنن الذين من قبلكم شبرا بشبر أو ذراعا بذراع حتى لوسلكوا جحر ضب لسلكتموه قالوا: اليهود والنصارى؟ قال: فمن؟»","صحيح","Sahih al-Jami al-Saghir 5063","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5064","«لتخرج العواتق وذوات الخدور والحيض ويشهدن الخير ودعوة المؤمنين ويعتزل الحيض المصلى»","صحيح","Sahih al-Jami al-Saghir 5064","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5065","«لتدخلن الجنة إلا من أبى وشرد على الله كشراد البعير»","صحيح","Sahih al-Jami al-Saghir 5065","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5066","«لتدع الصلاة في كل شهر أيام قرئها ثم تتوضأ لكل صلاة فإنما هو عرق»","صحيح","Sahih al-Jami al-Saghir 5066","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5067","«لتركبن سنن من كان قبلكم شبرا بشبر وذراعا بذراع حتى لو أن أحدهم دخل جحر ضب لدخلتم وحتى لوأن أحدهم جامع امرأته بالطريق لفعلتموه»","صحيح","Sahih al-Jami al-Saghir 5067","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5068","«لتزدحمن هذه الأمة على الحوض ازدحام إبل وردت لخمس»","حسن","Sahih al-Jami al-Saghir 5068","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5069","«لتستحلن طائفة من أمتي الخمر باسم يسمونها إياه»","صحيح","Sahih al-Jami al-Saghir 5069","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5070","«لتسون لصفوفكم في صلاتكم أو ليخالفن الله بين قلوبكم»","صحيح","Sahih al-Jami al-Saghir 5070","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5071","«لتفتحن عصابة من المسلمين كنز آل كسرى الذي في الأبيض»","صحيح","Sahih al-Jami al-Saghir 5071","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5072","«لتقيمن صفوفكم أو ليخالفن الله بين وجوهكم»","صحيح","Sahih al-Jami al-Saghir 5072","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5073","«لتملأن الأرض جورا وظلما فإذا ملئت جورا وظلما يبعث الله رجلا مني اسمه اسمي واسم أبيه اسم أبي فيملؤها عدلا وقسطا كما ملئت جورا وظلما فلا تمنع السماء شيئا من قطرها ولا الأرض شيئا من نباتها يمكث فيكم سبعا أو ثمانيا فإن أكثر فتسعا»","صحيح","Sahih al-Jami al-Saghir 5073","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5074","«لتملأن الأرض ظلما وعدوانا ثم ليخرجن رجل من أهل بيتي حتى يملأها قسطا وعدلا كما ملئت ظلما وعدوانا»","صحيح","Sahih al-Jami al-Saghir 5074","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5075","«لتنقضن عرى الإسلام عروة عروة فكلما انتقضت عروة تشبث الناس بالتي تليها فأولهن نقضا الحكم وآخرهن الصلاة»","صحيح","Sahih al-Jami al-Saghir 5075","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5076","«لتنتظر عدة الليالي والأيام التي كانت تحيضهن من الشهر قبل أن يصيبها الذي أصابها فلتترك الصلاة قبل ذلكم من الشهر فإذا خلفت ذلك فلتغتسل ثم لتستثفر بثوب ثم لتصلي»","صحيح","Sahih al-Jami al-Saghir 5076","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5077","«لزوال الدنيا أهون على الله من قتل رجل مسلم»","صحيح","Sahih al-Jami al-Saghir 5077","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5078","«لزوال الدنيا أهون على الله من قتل مؤمن بغير حق»","صحيح","Sahih al-Jami al-Saghir 5078","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5079","«لست أنا حملتكم ولكن الله حملكم وإني والله إن شاء الله لا أحلف على يمين فأرى غيرها خيرا منها إلا أتيت الذي هوخير وتحللتها»","صحيح","Sahih al-Jami al-Saghir 5079","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5080","«لست من الدنيا وليست مني إني بعثت والساعة نستبق»","صحيح","Sahih al-Jami al-Saghir 5080","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5081","«لصوت أبي طلحة في الجيش خير من ألف رجل»","صحيح","Sahih al-Jami al-Saghir 5081","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5082","«لصوت أبي طلحة في الجيش خير من فئة»","صحيح","Sahih al-Jami al-Saghir 5082","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5083","«لعلك آذاك هوامك؟ احلق رأسك وصم ثلاثة أيام وأطعم ستة مساكين أو أنسك شاة»","صحيح","Sahih al-Jami al-Saghir 5083","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5084","«لعلك ترزق به»","صحيح","Sahih al-Jami al-Saghir 5084","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5085","«لعلك تريدين أن ترجعي إلى رفاعة؟ لا حتى تذوقي عسيلته ويذوق عسيلتك»","صحيح","Sahih al-Jami al-Saghir 5085","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5086","«لعلكم ستدركون أقواما يصلون الصلاة لغير وقتها فإن أدركتموهم فصلوا الصلاة لوقتها وصلوا معهم واجعلوها سبحة»","صحيح","Sahih al-Jami al-Saghir 5086","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5087","«لعله تنفعه شفاعتي يوم القيامة فيجعل في ضحضاح من النار يبلغ كعبيه يغلي منه أم دماغه» يعني أبا طالب","صحيح","Sahih al-Jami al-Saghir 5087","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5088","«لعله يخفف عنهما ما لم ييبسا»","صحيح","Sahih al-Jami al-Saghir 5088","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5089","«لعن الله آكل الربا وموكله وشاهده وكاتبه»","صحيح","Sahih al-Jami al-Saghir 5089","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5090","«لعن الله آكل الربا وموكله وشاهديه وكاتبه هم فيه سواء»","صحيح","Sahih al-Jami al-Saghir 5090","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5091","«لعن الله الخمر وشاربها وساقيها وبائعها ومبتاعها وعاصرها ومعتصرها وحاملها والمحمولة إليه وآكل ثمنها»","صحيح","Sahih al-Jami al-Saghir 5091","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5092","«لعن الله الخامشة وجهها والشاقة جيبها والداعية بالويل والثبور»","حسن","Sahih al-Jami al-Saghir 5092","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5093","«لعن الله الراشي والمرتشي في الحكم»","صحيح","Sahih al-Jami al-Saghir 5093","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5094","«لعن الله الربا وآكله وموكله وكاتبه وشاهده وهم يعلمون والواصلة والمستوصلة والواشمة والمستوشمة والنامصة والمتنمصة»","صحيح","Sahih al-Jami al-Saghir 5094","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5095","«لعن الله الرجل يلبس لبسة المرأة والمرأة تلبس لبسة الرجل»","صحيح","Sahih al-Jami al-Saghir 5095","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5096","«لعن الله الرجلة من النساء»","صحيح","Sahih al-Jami al-Saghir 5096","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5097","«لعن الله السارق يسرق البيضة فتقطع يده ويسرق الحبل فتقطع يده»","صحيح","Sahih al-Jami al-Saghir 5097","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5098","«لعن الله العقرب ما تدع المصلي وغير المصلي اقتلوها في الحل والحرم»","صحيح","Sahih al-Jami al-Saghir 5098","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5099","«لعن الله العقرب ما تدع نبيا ولا غيره إلا لدغتهم»","صحيح","Sahih al-Jami al-Saghir 5099","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5100","«لعن الله المتشبهات من النساء بالرجال والمتشبهين من الرجال بالنساء»","صحيح","Sahih al-Jami al-Saghir 5100","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5101","«لعن الله المحلل والمحلل له»","صحيح","Sahih al-Jami al-Saghir 5101","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5102","«لعن الله المختفي والمختفية»","صحيح","Sahih al-Jami al-Saghir 5102","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5103","«لعن الله المخنثين من الرجال والمترجلات من النساء»","صحيح","Sahih al-Jami al-Saghir 5103","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5104","«لعن الله الواشمات والمستوشمات والنامصات والمتنمصات والمتفلجات للحسن المغيرات خلق الله»","صحيح","Sahih al-Jami al-Saghir 5104","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5105","«لعن الله الواصلة والمستوصلة والواشمة والمستوشمة»","صحيح","Sahih al-Jami al-Saghir 5105","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5106","«لعن الله اليهود اتخذوا قبور أنبيائهم مساجد»","صحيح","Sahih al-Jami al-Saghir 5106","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5107","«لعن الله اليهود إن الله حرم عليهم الشحوم فباعوها وأكلوا ثمنها وإن الله إذا حرم على قوم أكل شيء حرم عليهم ثمنه»","صحيح","Sahih al-Jami al-Saghir 5107","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5108","«لعن الله اليهود والنصارى اتخذوا قبور أنبيائهم مساجد»","صحيح","Sahih al-Jami al-Saghir 5108","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5109","«لعن الله زوارات القبور»","صحيح","Sahih al-Jami al-Saghir 5109","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5110","«لعن الله من يسم في الوجه»","صحيح","Sahih al-Jami al-Saghir 5110","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5111","«لعن الله من سب أصحابي»","حسن","Sahih al-Jami al-Saghir 5111","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5112","«لعن الله من لعن والديه ولعن الله من ذبح لغير الله ولعن الله من أوى محدثا ولعن الله من غير منار الأرض»","صحيح","Sahih al-Jami al-Saghir 5112","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5113","«لعن الله من مثل بالحيوان»","صحيح","Sahih al-Jami al-Saghir 5113","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5114","«لعنة الله على الراشي والمرتشي»","صحيح","Sahih al-Jami al-Saghir 5114","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5115","«لغدوة أو روحة في سبيل الله خير مما تطلع عليه الشمس وتغرب ولقاب قوس في الجنة خير مما تطلع عليه الشمس وتغرب»","صحيح","Sahih al-Jami al-Saghir 5115","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5116","«لغدوة في سبيل الله أو روحة خير من الدنيا وما فيها ولقاب قوس أحدكم أو موضع قده في الجنة خير من الدنيا وما فيها ولو اطلعت امرأة من نساء أهل الجنة إلى الأرض لملأت ما بينهما ريحا ولأضاءت ما بينهما ولنصيفها على رأسها خير من الدنيا وما فيها»","صحيح","Sahih al-Jami al-Saghir 5116","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5117","«لقد أعجبني أن تكون صلاة المسلمين واحدة حتى لقد هممت أن أبث رجالا في الدور ينادون الناس لحين الصلاة وحتى هممت أن آمر رجالا يقومون على الآطام ينادون المسلمين بحين الصلاة»","صحيح","Sahih al-Jami al-Saghir 5117","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5118","«لقد أعذر الله إلى عبد أحياه حتى بلغ ستين أو سبعين سنة لقد أعذر الله إليه»","صحيح","Sahih al-Jami al-Saghir 5118","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5119","«لقد أمرت بالسواك حتى خفت على أسناني»","صحيح","Sahih al-Jami al-Saghir 5119","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5120","""لقد أنزلت علي آية هي أحب إلي من الدنيا جميعا: {إِنَّا فَتَحْنَا لَكَ} إلى قوله {عَظِيماً}","صحيح","Sahih al-Jami al-Saghir 5120","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5121","«لقد أنزلت علي الليلة سورة لهي أحب إلي مما طلعت عليه الشمس: {إِنَّا فَتَحْنَا لَكَ فَتْحاً مُبِيناً} »","صحيح","Sahih al-Jami al-Saghir 5121","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5122","«لقد أوتي أبو موسى مزمارا من مزامير آل دأود»","صحيح","Sahih al-Jami al-Saghir 5122","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5123","«لقد أوتي أبو موسى من أصوات آل دأود»","صحيح","Sahih al-Jami al-Saghir 5123","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5124","«لقد أوتي هذا من مزامير آل دأود. يعني أبا موسى»","صحيح","Sahih al-Jami al-Saghir 5124","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5125","«لقد أوذيت في الله وما يؤذى أحد وأخفت في الله وما يخاف أحد ولقد أتت علي ثلاثون من بين يوم وليلة وما لي ولبلال طعام يأكله ذوكبد إلا شيء يواريه إبط بلال»","صحيح","Sahih al-Jami al-Saghir 5125","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5126","«لقد أوصاني جبريل بالجار حتى ظننت أنه يورثه»","صحيح","Sahih al-Jami al-Saghir 5126","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5127","«لقد تاب توبة لوتابها أهل المدينة لقبل منهم»","صحيح","Sahih al-Jami al-Saghir 5127","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5128","«لقد تابت توبة لوقسمت بين سبعين من أهل المدينة لوسعتهم وهل وجدت توبة أفضل من أن جادت بنفسها لله»","صحيح","Sahih al-Jami al-Saghir 5128","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5129","«لقد تحجرت واسعا»","صحيح","Sahih al-Jami al-Saghir 5129","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5130","«لقد حظرت رحمة الله واسعة إن الله تعالى خلق مائة رحمة فأنزل رحمة يتعاطف بها الخلائق جنها وإنسها وبهائمها وعنده تسعة وتسعون أتقولون: هوأضل أم بعيره؟»","صحيح","Sahih al-Jami al-Saghir 5130","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5131","«لقد دنت مني الجنة حتى لو اجترأت عليها لجئتكم بقطاف من قطافها ودنت مني النار حتى قلت: أي رب! وأنا فيهم؟ ورأيت امرأة تخدشها هرة لها فقلت: ما شأن هذه؟ قال: حبستها حتى ماتت جوعا لا هي أطعمتها ولا هي أرسلتها تأكل من خشاش الأرض»","صحيح","Sahih al-Jami al-Saghir 5131","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5132","«لقد رأيت الآن منذ صليت لكم: الجنة والنار ممثلتين في قبلة هذا الجدار فلم أر كاليوم في الخير والشر»","صحيح","Sahih al-Jami al-Saghir 5132","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5133","«لقد رأيت الملائكة تغسل حمزة»","حسن","Sahih al-Jami al-Saghir 5133","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5134","«لقد رأيت رجلا يتقلب في الجنة في شجرة قطعها من ظهر الطريق كانت تؤذي الناس»","صحيح","Sahih al-Jami al-Saghir 5134","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5135","«لقد رأيتني في الحجر وقريش تسألني عن مسراي فسألتني عن أشياء من بيت المقدس لم أثبتها فكربت كربا ما كربت مثله قط فرفعه الله لي أنظر إليه ما يسألوني عن شيء إلا أنبأتهم به وقد رأيتني في جماعة من الأنبياء فإذا موسى قائم يصلي فإذا رجل جعد ضرب كأنه من رجال شنوءة وإذا عيسى ابن مريم قائم يصلي أقرب الناس به شبها عروة ابن مسعود الثقفي وإذا إبراهيم قائم يصلي أشبه الناس به صاحبكم - يعني نفسه - فحانت الصلاة فأممتهم فلما فرغت من الصلاة قال قائل: يا محمد! هذا مالك صاحب النار فسلم عليه فالتفت إليه فبدأني بالسلام»","صحيح","Sahih al-Jami al-Saghir 5135","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5136","""لقد سألتني عن عظيم وإنه ليسير على من يسره الله عليه تعبد الله لا تشرك به شيئا وتقيم الصلاة المكتوبة وتؤتي الزكاة المفروضة وتصوم رمضان وتحج البيت. ألا أدلك على أبواب الخير؟ الصوم جنة والصدقة تطفئ الخطيئة كما يطفئ الماء النار وصلاة الرجل في جوف الليل. ألا أخبرك برأس الأمر وعموده وذروة سنامه؟ رأس الأمر الإسلام من أسلم سلم وعموده الصلاة وذروة سنامه الجهاد. ألا أخبرك بملاك ذلك كله؟ كف عليك هذا - وأشار إلى لسانه - قال: يا نبي الله! وإنا لمؤاخذون بما نتكلم به؟ قال: ثكلتك أمك يا معاذ! وهل يكب الناس في النار على وجوههم إلا حصائد ألسنتهم""","صحيح","Sahih al-Jami al-Saghir 5136","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5137","""لقد طاف الليلة بآل محمد نساء كثير كلهن تشكو زوجها من الضرب وايم الله لا تجدون أولئك خياركم""","صحيح","Sahih al-Jami al-Saghir 5137","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5138","«لقد قرأتها - يعني سورة الرحمن - على الجن ليلة الجن فكانوا أحسن مردودا منكم كنت كلما أتيت على قوله {فَبِأَيِّ آلاءِ رَبِّكُمَا تُكَذِّبَانِ} قالوا: ولا بشيء من نعمك ربنا نكذب فلك الحمد»","حسن","Sahih al-Jami al-Saghir 5138","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5139","«لقد قلت بعدك أربع كلمات ثلاث مرات لووزنت بما قلت منذ اليوم لوزنتهن: سبحان الله وبحمده عدد خلقه ورضا نفسه وزنة عرشه ومداد كلماته»","صحيح","Sahih al-Jami al-Saghir 5139","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5140","«لقد قلت كلمة لومزجت بماء البحر لمزجته»","صحيح","Sahih al-Jami al-Saghir 5140","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5141","«لقد لقيت من قومك وكان أشد ما لقيت منهم يوم العقبة إذ عرضت نفسي على ابن عبد ياليل بن عبد كلال فلم يجبني إلى ما أردت فانطلقت وأنا مهموم على وجهي فلم أستفق إلا وأنا بقرن الثعالب فرفعت رأسي فإذا أنا بسحابة قد أظلتني فنظرت فإذا فيها جبريل فناداني فقال: إن الله قد سمع كلام قومك لك وما ردوا عليك وقد بعث إليك ملك الجبال لتأمره بما شئت فيهم فناداني ملك الجبال فسلم علي ثم قال يا محمد! فقال ذلك فما شئت إن شئت أطبق عليهم الأخشبين قلت: بل أرجوأن يخرج الله من أصلابهم من يعبد الله وحده لا يشرك به شيئا»","صحيح","Sahih al-Jami al-Saghir 5141","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5142","«لقد هممت أن آمر رجلا يصلي بالناس ثم أحرق على رجال يتخلفون عن الجمعة بيوتهم»","صحيح","Sahih al-Jami al-Saghir 5142","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5143","«لقد هممت أن أرسل إلى أبي بكر وأنبه فأعهد أن يقول القائلون أو يتمنى المتمنون ثم قلت: يأبى الله ويدفع المؤمنون»","صحيح","Sahih al-Jami al-Saghir 5143","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5144","«لقد هممت أن ألعنه لعنا يدخل معه قبره كيف يورثه وهو لا يحل له؟ كيف يستخدمه وهو لا يحل له؟!»","صحيح","Sahih al-Jami al-Saghir 5144","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5145","«لقد هممت أن أنهى عن الغيلة حتى ذكرت أن الروم وفارس يصنعون ذلك فلا يضر أو لادهم»","صحيح","Sahih al-Jami al-Saghir 5145","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5146","«لقد هممت أن لا أقبل هدية إلا من قرشي أو أنصاري أو ثقفي أو دوسي»","صحيح","Sahih al-Jami al-Saghir 5146","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5147","«لقلب ابن آدم أشد انقلابا من القدر إذا استجمعت غليانا»","صحيح","Sahih al-Jami al-Saghir 5147","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5148","«لقنوا موتاكم لا إله إلا الله»","صحيح","Sahih al-Jami al-Saghir 5148","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5149","«لقنوا موتاكم لا إله إلا الله فإن نفس المؤمن تخرج رشحا ونفس الكافر تخرج من شدقه كما تخرج نفس الحمار»","حسن","Sahih al-Jami al-Saghir 5149","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5150","«لقنوا موتاكم لا إله إلا الله فإنه من كان آخر كلامه لا إله إلا الله عند الموت دخل الجنة يوما من الدهر وإن أصابه قبل ذلك ما أصابه»","صحيح","Sahih al-Jami al-Saghir 5150","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5151","«لقيام رجل في الصف في سبيل الله عز وجل ساعة أفضل من عبادة ستين سنة»","صحيح","Sahih al-Jami al-Saghir 5151","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5152","«لقيت إبراهيم ليلة أسري بي فقال: يا محمد أقرئ أمتك مني السلام وأخبرهم أن الجنة طيبة التربة عذبة الماء وأنها قيعان وأن غراسها سبحان الله والحمد لله ولا إله إلا الله والله أكبر»","حسن","Sahih al-Jami al-Saghir 5152","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5153","«لقيد سوط أحدكم من الجنة خير مما بين السماء والأرض»","صحيح","Sahih al-Jami al-Saghir 5153","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5154","«لك بها سبعمائة ناقة مخطومة في الجنة»","صحيح","Sahih al-Jami al-Saghir 5154","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5155","«لك بها يوم القيامة سبعمائة ناقة كلها مخطومة»","صحيح","Sahih al-Jami al-Saghir 5155","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5156","«لك في كل ذات كبد حرى أجر»","صحيح","Sahih al-Jami al-Saghir 5156","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5157","«لك ما نويت يا يزيد ولك ما أخذت يا معن»","صحيح","Sahih al-Jami al-Saghir 5157","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5158","«لكم أنتم أهل السفينة هجرتان»","صحيح","Sahih al-Jami al-Saghir 5158","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5159","«لكم كل عظم ذكر اسم الله عليه يقع في أيديكم أوفر ما يكون لحما وكل بعرة علف لدوابكم فلا تستنجوا بهما فإنهما طعام إخوانكم»","صحيح","Sahih al-Jami al-Saghir 5159","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5160","«لكن أحسن الجهاد وأجمله حج مبرور»","صحيح","Sahih al-Jami al-Saghir 5160","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5161","«لكل ابن آدم حظه من الزنا فزنا العين النظر وزنا اللسان المنطق والأذنان زناهما الاستماع واليدان يزنيان فزناهما البطش والرجلان يزنيان فزناهما المشي والفم يزني وزناه القبل»","صحيح","Sahih al-Jami al-Saghir 5161","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5162","«لكل أمة أمين وأمين أمتي أبو عبيدة بن الجراح»","صحيح","Sahih al-Jami al-Saghir 5162","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5163","«لكل أمة مجوس ومجوس أمتي الذين يقولون لا قدر إن مرضوا فلا تعودوهم وإن ماتوا فلا تشهدوهم»","حسن","Sahih al-Jami al-Saghir 5163","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5164","«لكل داء دواء فإذا أصيب دواء الداء برئ بإذن الله تعالى»","صحيح","Sahih al-Jami al-Saghir 5164","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5165","«لكل سورة حظها من الركوع والسجود»","صحيح","Sahih al-Jami al-Saghir 5165","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5166","«لكل سهوسجدتان بعد ما يسلم»","حسن","Sahih al-Jami al-Saghir 5166","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5167","«لكل غادر لواء عند استه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5167","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5168","«لكل غادر لواء يعرف به يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5168","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5169","«لكل غادر لواء ينصب بغدرته»","صحيح","Sahih al-Jami al-Saghir 5169","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5170","«لكل غادر لواء يوم القيامة يرفع له بقدر غدرته ألا ولا غادر أعظم غدرا من أمير عامة»","صحيح","Sahih al-Jami al-Saghir 5170","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5171","«لكل قرن سابق»","صحيح","Sahih al-Jami al-Saghir 5171","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5172","«لكل قرن من أمتي سابقون»","صحيح","Sahih al-Jami al-Saghir 5172","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5173","«لكل نبي تركة وضيعة وإن تركتي وضيعتي الأنصار فاحفظوني فيهم»","حسن","Sahih al-Jami al-Saghir 5173","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5174","«لكل نبي دعوة دعا بها في أمته فاستجيب له وإني أريد إن شاء الله أن أدخر دعوتي شفاعة لأمتي يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5174","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5175","«لكل نبي دعوة قد دعا بها في أمته وإني خبأت دعوتي شفاعة لأمتي يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5175","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5176","«لكل نبي دعوة مستجابة فتعجل كل نبي دعوته وإني خبأت دعوتي شفاعة لأمتي يوم القيامة فهي نائلة إن شاء الله من مات من أمتي لا يشرك بالله شيئا»","صحيح","Sahih al-Jami al-Saghir 5176","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5177","«لكل نبي دعوة يدعوبها فأريد أن أختبئ دعوتي شفاعة لأمتي يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5177","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5178","«لكل نبي دعوة مستجابة يدعوبها فيستجاب له فيؤتاها وإني خبأت دعوتي شفاعة لأمتي يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5178","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5179","«للابنة النصف ولابنة الابن السدس وما بقي فللأخت»","صحيح","Sahih al-Jami al-Saghir 5179","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5180","«للبكر سبع وللثيب ثلاث»","صحيح","Sahih al-Jami al-Saghir 5180","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5181","""للتوبة باب بالمغرب مسيرة سبعين عاما لا يزال كذلك حتى يأتي بعض آيات ربك طلوع الشمس من مغربها ""","حسن","Sahih al-Jami al-Saghir 5181","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5182","«للشهيد عند الله سبع خصال: يغفر له في أول دفعة من دمه ويرى مقعده من الجنة ويحلى حلة الإيمان ويزوج اثنين وسبعين زوجة من الحور العين ويجار من عذاب القبر ويأمن من الفزع الأكبر ويوضع على رأسه تاج الوقار الياقوتة منه خير من الدنيا وما فيها ويشفع في سبعين إنسانا من أهل بيته»","صحيح","Sahih al-Jami al-Saghir 5182","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5183","«للصائم فرحتان فرحة حين يفطر وفرحة حين يلقى ربه»","صحيح","Sahih al-Jami al-Saghir 5183","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5184","«للصائمين باب في الجنة يقال له: الريان لا يدخل فيه أحد غيرهم فإذا دخل آخرهم أغلق من دخل فيه شرب ومن شرب لم يظمأ أبدا»","صحيح","Sahih al-Jami al-Saghir 5184","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5185","«للعبد المملوك الصالح أجران»","صحيح","Sahih al-Jami al-Saghir 5185","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5186","«للغازي أجره وللجاعل أجره وأجر الغازي»","صحيح","Sahih al-Jami al-Saghir 5186","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5187","«للمائد أجر شهيد وللغريق أجر شهيدين»","صحيح","Sahih al-Jami al-Saghir 5187","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5188",""" للمؤمن على المؤمن ست خصال: يعوده إذا مرض ويشهده إذا مات ويجبيه إذا دعاه ويسلم عليه إذا لقيه ويشمته إذا عطس وينصح له إذا غاب أو شهد ""","صحيح","Sahih al-Jami al-Saghir 5188","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5189","«للمسافر ثلاثة أيام ولياليهن وللمقيم يوم وليلة في المسح على الخفين»","صحيح","Sahih al-Jami al-Saghir 5189","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5190","«للمسلم على المسلم أربع خلال: يشمته إذا عطس ويجيبه إذا دعاه ويشهده إذا مات ويعوده إذا مرض»","صحيح","Sahih al-Jami al-Saghir 5190","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5191","«للمملوك طعامه وكسوته بالمعروف ولا يكلف من العمل إلا ما يطيق»","صحيح","Sahih al-Jami al-Saghir 5191","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5192","«للمملوك طعامه وكسوته ولا يكلف إلا ما يطيق فإن كلفتموهم فأعينوهم ولا تعذبوا عباد الله خلقا أمثالكم»","حسن","Sahih al-Jami al-Saghir 5192","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5193","«للمهاجرين إقامة بعد الصدر ثلاث»","صحيح","Sahih al-Jami al-Saghir 5193","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5194","""لم أنه عن البكاء إنما نهيت عن صوتين أحمقين فاجرين صوت عند نغمة مزمار شيطان ولعب وصوت عند مصيبة خمش وجوه وشق جيوب ورنة شيطان وإنما هذه رحمة ""","صحيح","Sahih al-Jami al-Saghir 5194","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5195","«لم تحسدنا اليهود بشيء ما حسدونا بـ.....، التسليم والتأمين, ... ...»","صحيح","Sahih al-Jami al-Saghir 5195","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5196","«لم تحل الغنائم لأحد سود الرءوس من قبلكم كانت تجمع وتنزل نار من السماء فتأكلها»","صحيح","Sahih al-Jami al-Saghir 5196","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5197","«لم يبعث الله تعالى نبيا إلا بلُغةِ قومه»","صحيح","Sahih al-Jami al-Saghir 5197","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5198","«لم يبق من النبوة إلا المبشرات الرؤيا الصالحة»","صحيح","Sahih al-Jami al-Saghir 5198","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5199",""" لم يتكلم في المهد إلا ثلاثة: عيسى. وكان في بني إسرائيل رجل يقال له: جريج يصلي جاءته أمه فدعته فقال: أجيبها أو أصلي؟ فقالت: اللهم لا تمته حتى تريه وجوه المومسات وكان جريج في صومعة فتعرضت له امرأة فكلمته فأبى فأتت راعيا فأمكنته من نفسها فولدت غلاما فقالت: من جريج فأتوه فكسروا صومعته فأنزلوه وسبوه فتوضأ وصلى ثم أتى الغلام فقال: من أبوك يا غلام؟ قال: الراعي قالوا: نبني صومعتك من ذهب قال: لا إلا من طين. وكانت امرأة ترضع ابنا لها من بني إسرائيل فمر بها رجل راكب ذو شارة فقالت: اللهم اجعل ابني مثله فترك ثديها وأتى على الراكب فقال: اللهم لا تجعلني مثله ثم أقبل على ثديها يمصه ثم مرت بأمة فقالت: اللهم لا تجعل ابني مثل هذه فترك ثديها وقال اللهم اجعلني مثلها فقالت: لم ذاك؟ فقال: الراكب جبار من الجبابرة، وهذه الأمة يقولون سرقت زنت ولم تفعل""","صحيح","Sahih al-Jami al-Saghir 5199","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5200","«لم ير للمتحابين مثل النكاح»","صحيح","Sahih al-Jami al-Saghir 5200","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5201","«لم يقبر نبي إلا حيث يموت»","صحيح","Sahih al-Jami al-Saghir 5201","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5202","«لم يكذب إبراهيم إلا ثلاث كذبات: ثنتين منهن في ذات الله قوله: {إِنِّي سَقِيمٌ} وقوله: {بَلْ فَعَلَهُ كَبِيرُهُمْ هَذَا} وبينما هو ذات يوم وسارة إذ أتى على جبار من الجبابرة فقيل له: إن هاهنا رجلا معه امرأة من أحسن الناس فأرسل إليه فسأله عنها فقال: من هذه؟ قال: أختي فأتى سارة فقال: يا سارة ليس على وجه الأرض مؤمن غيري وغيرك وإن هذا سألني فأخبرته أنك أختي فلا تكذبيني فأرسل إليها فلما دخلت عليه ذهب يتنأولها بيده فأخذ فقال: ادعي الله لي ولا أضرك فدعت الله فأطلق ثم تناولها ثانية فأخذ مثلها أو أشد فقال: ادعي الله لي ولا أضرك فدعت فأطلق فدعا بعض حجبته فقال: إنك لم تأتني بإنسان! إنما أتيتني بشيطان! فأخدمها هاجر فأتته وهو قائم يصلي فأومأ بيده مهيا؟ قالت: رد الله كيد الفاجر في نحره وأخدم هاجر»","صحيح","Sahih al-Jami al-Saghir 5202","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5203","«لم يكذب من نمى بين اثنين ليصلح»","صحيح","Sahih al-Jami al-Saghir 5203","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5204","«لم يمنع قوم زكاة أموالهم إلا منعوا القطر من السماء ولولا البهائم لم يمطروا»","صحيح","Sahih al-Jami al-Saghir 5204","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5205","«لما أصيب إخوانكم بأحد جعل الله أرواحهم في جوف طير خضر ترد أنهار الجنة تأكل من ثمارها وتأوي إلى قناديل من ذهب معلقة في ظل العرش فلما وجدوا طيب مأكلهم ومشربهم ومقيلهم قالوا: من يبلغ إخواننا عنا أنا أحياء في الجنة نرزق لئلا يزهدوا في الجهاد ولا يتكلوا عند الحرب؟ فقال الله تعالى: أنا أبلغهم عنكم»","صحيح","Sahih al-Jami al-Saghir 5205","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5206","«لما أغرق الله فرعون قال:» آمنت أنه لا إله إلا الذي آمنت به بنوا إسرائيل قال جبريل: يا محمد! فلو رأيتني وأنا آخذ من حال البحر فأدسه في فيه مخافة أن تدركه الرحمة""","صحيح","Sahih al-Jami al-Saghir 5206","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5207","«لما توفي آدم غسلته الملائكة بالماء وترا وألحدوا له وقالوا: هذه سنة آدم في ولده»","صحيح","Sahih al-Jami al-Saghir 5207","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5208",""" لما خلق الله آدم مسح ظهره فسقط من ظهره كل نسمة هوخالقها إلى يوم القيامة ثم جعل بين عيني كل إنسان منهم وبيصا من نور ثم عرضهم على آدم فقال: أي رب من هؤلاء؟ قال: هؤلاء ذريتك فرأى رجلا منهم أعجبه نور ما بين عينيه فقال: أي رب من هذا؟ قال: رجل من ذريتك في آخر الأمم يقال له داود قال: أي رب كم عمره؟ قال ستون سنة قال: فزده من عمري أربعين سنة: قال: إذن يكتب ويختم ولا يبدل فلما انقضى عمر آدم جاء ملك الموت فقال: أو لم يبق من عمري أربعون سنة؟ قال: أو لم تعطها ابنك دأود؟ فجحدت ذريته ونسي آدم فنسيت ذريته وخطئ آدم فخطئت ذريته""","صحيح","Sahih al-Jami al-Saghir 5208","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5209","«لما خلق الله آدم ونفخ فيه الروح عطس فقال: الحمد لله فحمد الله بإذنه فقال له ربه: يرحمك الله يا آدم! اذهب إلى أولئك الملائكة إلى ملأ منهم جلوس فقل: السلام عليكم قالوا: وعليك السلام ورحمة الله ثم رجع إلى ربه فقال: إن هذه تحيتك وتحية بنيك بينهم فقال الله له ويداه مقبوضتان: اختر أيهما شئت قال: اخترت يمين ربي وكلتا يدي ربي يمين مباركة ثم بسطها فإذا فيها آدم وذريته فقال أي رب! ما هؤلاء؟ قال: هؤلاء ذريتك فإذا كل إنسان مكتوب عمره بين عينيه فإذا فيهم رجل أضوؤهم أو من أضوئهم قال: يا رب من هذا؟ قال: هذا ابنك داود وقد كتبت له عمر أربعين سنة قال يا رب زد في عمره قال: ذاك الذي كتبت له قال: أي رب فإني قد جعلت له من عمري ستين سنة قال: أنت وذاك ثم أسكن الجنة ما شاء الله ثم أهبط منها فكان آدم يعد لنفسه فأتاه ملك الموت فقال له آدم: قد تعجلت قد كتب لي ألف سنة قال بلى ولكنك جعلت لابنك داود ستين سنة فجحد فجحدت ذريته ونسي فنسيت ذريته فمن يومئذ أمر بالكتاب والشهود»","صحيح","Sahih al-Jami al-Saghir 5209","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5210",""" لما خلق الله الجنة قال لجبريل: اذهب فانظر إليها فذهب فنظر إليها ثم جاء فقال: أي رب! وعزتك لا يسمع بها أحد إلا دخلها ثم حفها بالمكاره ثم قال: يا جبريل! اذهب فانظر إليها فذهب ثم نظر إليها ثم جاء فقال: أي رب! وعزتك لقد خشيت أن لا يدخلها أحد فلما خلق الله النار قال: يا جبريل! اذهب فانظر إليها فذهب فنظر إليها ثم جاء فقال: وعزتك لا يسمع بها أحد فيدخلها فحفها بالشهوات ثم قال: يا جبريل اذهب فانظر إليها فذهب فنظر إليها فقال: أي رب وعزتك لقد خشيت أن لا يبقى أحد إلا دخلها""","صحيح","Sahih al-Jami al-Saghir 5210","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5211","«لما صور الله تعالى آدم في الجنة تركه ما شاء الله أن يتركه فجعل إبليس يطيف به ينظر إليه فلما رآه أجوف عرف أنه خلق لا يتمالك»","صحيح","Sahih al-Jami al-Saghir 5211","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5212","«لما عرج بي رأيت إدريس في السماء الرابعة»","صحيح","Sahih al-Jami al-Saghir 5212","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5213","«لما عرج بي ربي عز وجل مررت بقوم لهم أظفار من نحاس يخمشون وجههم وصدورهم فقلت: من هؤلاء يا جبريل؟ قال: هؤلاء الذين يأكلون لحوم الناس ويقعون في أعراضهم»","صحيح","Sahih al-Jami al-Saghir 5213","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5214","«لما قضى الله الخلق كتب في كتابه فهو عنده فوق العرش: إن رحمتي غلبت غضبي»","صحيح","Sahih al-Jami al-Saghir 5214","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5215","«لما كذبتني قريش حين أسري بي إلى بيت المقدس قمت في الحجر فجلى الله لي بيت المقدس فطفقت أخبرهم عن آياته وأنا أنظر إليه»","صحيح","Sahih al-Jami al-Saghir 5215","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5216",""" لما نفخ في آدم الروح مارت وطارت فصارت في رأسه، فعطس فقال: الحمد لله رب العالمين فقال الله: يرحمك الله""","صحيح","Sahih al-Jami al-Saghir 5216","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5217","«لن تقرأ شيئا أبلغ عند الله من: {قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ} »","صحيح","Sahih al-Jami al-Saghir 5217","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5218","«لن تنقطع الهجرة ما قوتل الكفار»","صحيح","Sahih al-Jami al-Saghir 5218","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5219","«لن يبرح الناس يتساءلون: هذا الله خالق كل شيء فمن خلق الله؟»","صحيح","Sahih al-Jami al-Saghir 5219","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5220","«لن يبرح هذا الدين قائما يقاتل عليه عصابة من المسلمين حتى تقوم الساعة»","صحيح","Sahih al-Jami al-Saghir 5220","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5221","«لن يجمع الله تعالى على هذه الأمة سيفين: سيفا منها وسيفا من عدوها»","صحيح","Sahih al-Jami al-Saghir 5221","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5222","«لن يدخل أحدا عمله الجنة ولا أنا إلا أن يتغمدني الله بفضل رحمته فسددوا وقاربوا ولا يتمنى أحدكم الموت إما محسن فلعله يزداد خيرا وإما مسيء فلعله أن يستعتب»","صحيح","Sahih al-Jami al-Saghir 5222","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5223","«لن يدخل النار رجل شهد بدرا والحديبية»","صحيح","Sahih al-Jami al-Saghir 5223","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5224","«لن يعجز الله هذه الأمة من نصف يوم»","صحيح","Sahih al-Jami al-Saghir 5224","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5225","«لن يفلح قوم ولو اأمرهم امرأة»","صحيح","Sahih al-Jami al-Saghir 5225","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5226","«لن يلج الدرجات العلى من تكهن أو استقسم أو رجع من سفر تطيرا»","حسن","Sahih al-Jami al-Saghir 5226","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5227","«لن يلج النار أحد شهد بدرا أو بيعة الرضوان»","صحيح","Sahih al-Jami al-Saghir 5227","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5228","«لن يلج النار أحد صلى قبل طلوع الشمس وقبل غروبها»","صحيح","Sahih al-Jami al-Saghir 5228","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5229","«لن ينجي أحدا منكم عمله ولا أنا إلا أن يتغمدني الله برحمته ولكن سددوا وقاربوا واغدوا وروحوا وشيء من الدلجة والقصد القصد تبلغوا»","صحيح","Sahih al-Jami al-Saghir 5229","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5230","«لن يوافي عبد يوم القيامة يقول: لا إله إلا الله يبتغي بها وجه الله إلا حرم الله عليه النار»","صحيح","Sahih al-Jami al-Saghir 5230","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5231","«لن يهلك الناس حتى يعذروا من أنفسهم»","صحيح","Sahih al-Jami al-Saghir 5231","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5232","«لواء الغادر يوم القيامة عند استه»","صحيح","Sahih al-Jami al-Saghir 5232","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5233","«لوآمن بي عشرة من اليهود لآمن بي اليهود»","صحيح","Sahih al-Jami al-Saghir 5233","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5234","«لوأخذتم إهابها يطهرها الماء والقرظ»","صحيح","Sahih al-Jami al-Saghir 5234","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5235","«لوأخطأتم حتى تبلغ خطاياكم السماء ثم تبتم لتاب الله عليكم»","حسن","Sahih al-Jami al-Saghir 5235","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5236","«لوأصبحت أكثر مما أصبحت لركعتهما وأحسنتهما وأجملتهما» . يعني ركعتي الفجر","صحيح","Sahih al-Jami al-Saghir 5236","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5237","«لوأعطيتها أخوالك كان أعظم لأجرك»","صحيح","Sahih al-Jami al-Saghir 5237","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5238","«لو أفلت أحد من ضمة القبر لأفلت هذا الصبي»","صحيح","Sahih al-Jami al-Saghir 5238","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5239","«لوأمرت أحدا أن يسجد لأحد لأمرت المرأة أن تسجد لزوجها ... ...»","صحيح","Sahih al-Jami al-Saghir 5239","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5240","«لو أن ابن آدم هرب من رزقه كما يهرب من الموت لأدركه رزقه كما يدركه الموت»","حسن","Sahih al-Jami al-Saghir 5240","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5241","«لو أن أحدكم إذا أراد أن يأتي أهله قال: بسم الله اللهم جنبينا الشيطان وجنب الشيطان ما رزقتنا فإنه إن قضي بينهما ولد من ذلك لم يضره الشيطان أبدا»","صحيح","Sahih al-Jami al-Saghir 5241","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5242","«لو أن أحدكم إذا نزل منزلا قال: أعوذ بكلمات الله التامة من شر ما خلق لم يضره في ذلك المنزل شيء حتى يرتحل منه»","صحيح","Sahih al-Jami al-Saghir 5242","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5243","«لو أن العباد لم يذنبوا لخلق الله خلقا يذنبون ثم يستغفرون ثم يغفر لهم وهو الغفور الرحيم»","صحيح","Sahih al-Jami al-Saghir 5243","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5244","«لو أن الله عذب أهل سمواته وأهل أرضه لعذبهم وهو غير ظالم لهم ولو رحمهم لكانت رحمته لهم خير من أعمالهم ولو أنفقت مثل أحد ذهبا في سبيل الله ما قبله الله منك حتى تؤمن بالقدر فتعلم أن ما أصابك لم يكن ليخطئك وما أخطأك لم يكن ليصيبك ولو مت على غير هذا لدخلت النار»","صحيح","Sahih al-Jami al-Saghir 5244","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5245","«لو أن الماء الذي يكون منه الولد أهرقته على صخرة لأخرج الله تعالى منها ولدا وليخلقن الله نفسا هو خالقها»","حسن","Sahih al-Jami al-Saghir 5245","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5246","«لو أن امرءا اطلع عليك بغير إذن فحذفته بحصاة ففقأت عينه لم يكن عليك جناح»","صحيح","Sahih al-Jami al-Saghir 5246","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5247","«لو أن أهل السماء والأرض اشتركوا في دم مؤمن لكبهم الله عز وجل في النار»","صحيح","Sahih al-Jami al-Saghir 5247","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5248","«لو أن حجرا مثل سبع خلفات ألقي عن شفير جهنم هوى فيها سبعين خريفا لا يبلغ قعرها»","صحيح","Sahih al-Jami al-Saghir 5248","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5249","«لو أن رجلا يجر على وجهه من يوم ولد إلى يوم يموت هرما في مرضاة الله تعالى لحقره يوم القيامة»","حسن","Sahih al-Jami al-Saghir 5249","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5250","«لو أن قطرة من الزقوم قطرت في دار الدنيا لأفسدت على أهل الدنيا معايشهم فكيف بمن تكون طعامه؟»","صحيح","Sahih al-Jami al-Saghir 5250","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5251","«لو أن ما يقل ظفر مما في الجنة بدا لتزخرفت له ما بين خوافق السموات والأرض ولو أن رجلا من أهل الجنة اطلع فبدا أسأوره لطمس ضوء الشمس كما تطمس الشمس ضوء النجوم»","صحيح","Sahih al-Jami al-Saghir 5251","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5252","«لو أنكم إذا خرجتم من عندي تكونون على الحال الذي تكونون عليه لصافحتكم الملائكة بطرق المدينة»","صحيح","Sahih al-Jami al-Saghir 5252","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5253","""لو أنكم تكونون على كل حال على الحالة التي أنتم عليها عندي لصافحتكم الملائكة بأكفهم ولزارتكم في بيوتكم ولو لم تذنبوا لجاء الله بقوم يذنبون كي يغفر لهم""","صحيح","Sahih al-Jami al-Saghir 5253","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5254","«لو أنكم توكلون على الله تعالى حق توكله لرزقكم كما يرزق الطير تغدوخماصا وتروح بطانا»","صحيح","Sahih al-Jami al-Saghir 5254","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5255","«لو أني استقبلت من أمري ما استدبرت لم أسق الهدي ولجعلتها عمرة فمن كان منكم ليس معه هدي فليحل وليجعلها عمرة»","صحيح","Sahih al-Jami al-Saghir 5255","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5256","«لو أني استقبلت من أمري ما استدبرت ما أهديت ولولا أن معي الهدي لأحللت»","صحيح","Sahih al-Jami al-Saghir 5256","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5257","«لو أهدي إلي كراع لقبلت ولو دعيت عليه لأجبت»","صحيح","Sahih al-Jami al-Saghir 5257","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5258","«لوتركنا هذا الباب للنساء»","صحيح","Sahih al-Jami al-Saghir 5258","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5259","«لو تعلم المرأة حق الزوج لم تقعد ما حضر غداؤه وعشاؤه حتى يفرغ منه»","صحيح","Sahih al-Jami al-Saghir 5259","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5260","«لو تعلمون قدر رحمة الله لاتكلتم عليها»","صحيح","Sahih al-Jami al-Saghir 5260","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5261","«لو تعلمون ما ادخر لكم ما حزنتم على ما زوي عنكم»","صحيح","Sahih al-Jami al-Saghir 5261","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5262","«لو تعلمون ما أعلم لبكيتم كثيرا ولضحكتم قليلا ولخرجتم إلى الصعدات تجأرون إلى الله تعالى......... ... »","حسن","Sahih al-Jami al-Saghir 5262","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5263","«لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا»","صحيح","Sahih al-Jami al-Saghir 5263","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5264","«لو تعلمون ما في الصف الأول ما كانت إلا قرعة»","صحيح","Sahih al-Jami al-Saghir 5264","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5265","«لو تعلمون ما لكم عند الله لأحببتم أن تزدادوا فاقة وحاجة»","صحيح","Sahih al-Jami al-Saghir 5265","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5266","«لو جمع القرآن في إهاب ما أحرقه الله بالنار»","حسن","Sahih al-Jami al-Saghir 5266","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5267","«لو خرجتم إلى ذود لنا فشربتم من ألبانها وأبوالها»","صحيح","Sahih al-Jami al-Saghir 5267","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5268","«لو دعيت إلى ذراع أو كراع لأجبت ولو أهدي إلي ذراع أو كراع لقبلت»","صحيح","Sahih al-Jami al-Saghir 5268","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5269","«لو دنا مني لخطفته الملائكة عضوا عضوا» . - يعني أبا جهل -","صحيح","Sahih al-Jami al-Saghir 5269","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5270","«لو رأيتني وأنا أستمع قراءتك البارحة فقد أوتيت مزمارا من مزامير آل دأود»","صحيح","Sahih al-Jami al-Saghir 5270","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5271","«لو رجمت أحدا بغير بينة لرجمت هذه»","صحيح","Sahih al-Jami al-Saghir 5271","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5272","«لو عاش إبراهيم لكان صديقا نبيا»","صحيح","Sahih al-Jami al-Saghir 5272","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5273","«لو علمت أنك تنظر لطعنت بها في عينك إنما جعل الاستئذان من أجل البصر»","صحيح","Sahih al-Jami al-Saghir 5273","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5274","«لو غفر لكم ما تأتون إلى البهائم لغفر لكم كثير»","حسن","Sahih al-Jami al-Saghir 5274","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5275","«لو قضي كان»","صحيح","Sahih al-Jami al-Saghir 5275","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5276","«لو قلت بسم الله لرفعتك الملائكة والناس ينظرون إليك حتى تلج بك في جوالسماء»","صحيح","Sahih al-Jami al-Saghir 5276","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5277","«لوقلت نعم لوجبت ولو وجبت لم تقوموا بها ولو لم تقوموا بها عذبتم»","صحيح","Sahih al-Jami al-Saghir 5277","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5278","«لوقلتها وأنت تملك أمرك أفلحت كل الفلاح»","صحيح","Sahih al-Jami al-Saghir 5278","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5279","«لوكان أسامة جارية لكسوته وحليته حتى أنفقه»","صحيح","Sahih al-Jami al-Saghir 5279","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5280","«لوكان الإيمان عند الثريا لتنأوله رجال من فارس»","صحيح","Sahih al-Jami al-Saghir 5280","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5281","«لوكان الإيمان عند الثريا لذهب به رجل من أبناء فارس حتى يتنأوله»","صحيح","Sahih al-Jami al-Saghir 5281","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5282","«لوكان القرآن في إهاب ما أكلته النار»","حسن","Sahih al-Jami al-Saghir 5282","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5283","«لوكان المطعم بن عدي حيا ثم كلمني في هؤلاء النتنى لأطلقتهم له» - يعني أسارى بدر -","صحيح","Sahih al-Jami al-Saghir 5283","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5284","«لوكان بعدي نبي لكان عمر بن الخطاب»","حسن","Sahih al-Jami al-Saghir 5284","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5285","«لوكان ذلك ضارا ضر فارس والروم» - يعني الغيل -","صحيح","Sahih al-Jami al-Saghir 5285","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5286","«لو كان شيء سابق القدر لسبقته العين»","صحيح","Sahih al-Jami al-Saghir 5286","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5287","«لو كان شيء سابق القدر لسبقته العين وإذا استغسلتم فاغسلوا»","صحيح","Sahih al-Jami al-Saghir 5287","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5288","«لو كان لابن آدم واد من مال لابتغى إليه ثانيا ولو كان له واديان لابتغى لهما ثالثا ولا يملأ جوف ابن آدم إلا التراب ويتوب الله على من تاب»","صحيح","Sahih al-Jami al-Saghir 5288","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5289","«لو كان لابن آدم واد من نخل لتمنى مثله ثم تمنى مثله حتى يتمنى أودية ولا يملأ جوف ابن آدم إلا التراب»","صحيح","Sahih al-Jami al-Saghir 5289","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5290","«لو كان لي مثل أحد ذهبا لسرني أن لا يمر على ثلاث وعندي منه شيء إلا شيء أرصده لدين»","صحيح","Sahih al-Jami al-Saghir 5290","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5291","«لو كان مسلما فأعتقتم عنه أو تصدقتم عنه أو حججتم عنه بلغه ذلك»","حسن","Sahih al-Jami al-Saghir 5291","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5292","«لوكانت الدنيا تعدل عند الله جناح بعوضة ما سقى كافرا منها شربة ماء»","صحيح","Sahih al-Jami al-Saghir 5292","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5293","«لوكانت سورة واحدة لكفت الناس»","صحيح","Sahih al-Jami al-Saghir 5293","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5294","«لوكنت آمرا أحدا أن يسجد لأحد لأمرت المرأة أن تسجد لزوجها»","صحيح","Sahih al-Jami al-Saghir 5294","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5295","«لوكنت آمرا أحدا أن يسجد لغير الله لأمرت المرأة أن تسجد لزوجها والذي نفس محمد بيده لا تؤدي المرأة حق ربها حتى تؤدي حق زوجها كله حتى لوسألها نفسها وهي على قتب لم تمنعه»","حسن","Sahih al-Jami al-Saghir 5295","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5296","«لوكنت متخذا من أهل الأرض خليلا لاتخذت ابن أبي قحافة خليلا ولكن صاحبكم خليل الله»","صحيح","Sahih al-Jami al-Saghir 5296","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5297","«لوكنت متخذا من أمتي خليلا دون ربي لاتخذت أبا بكر خليلا ولكن أخي وصاحبي»","صحيح","Sahih al-Jami al-Saghir 5297","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5298","«لوكنت متخذا خليلا لاتخذت أبا بكر خليلا ولكنه أخي وصاحبي وقد اتخذ الله صاحبكم خليلا»","صحيح","Sahih al-Jami al-Saghir 5298","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5299","«لو كنتم تغرفون من بطحان ما زدتم»","صحيح","Sahih al-Jami al-Saghir 5299","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5300","«لو لم أحتضنه لحن إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5300","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5301","«لو لم تذنبوا لجاء الله تعالى بقوم يذنبون ليغفر لهم»","صحيح","Sahih al-Jami al-Saghir 5301","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5302","«لو لم تكله لأكلتم منه ولقام بكم»","صحيح","Sahih al-Jami al-Saghir 5302","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5303","«لو لم تكونوا تذنبون لخفت عليكم ما هوأكبر من ذلك العجب العجب»","حسن","Sahih al-Jami al-Saghir 5303","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5304","«لو لم يبق من الدنيا إلا يوم لطول الله ذلك اليوم حتى يبعث فيه رجل من أهل بيتي يواطئ اسمه اسمي واسم أبيه اسم أبي يملأ الأرض قسطا وعدلا كما ملئت ظلما وجورا»","صحيح","Sahih al-Jami al-Saghir 5304","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5305","«لو لم يبق من الدهر إلا يوم لبعث الله رجلا من أهل بيتي يملؤها عدلا كما ملئت جورا»","صحيح","Sahih al-Jami al-Saghir 5305","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5306","«لو نجا أحد من ضمة القبر لنجا سعد بن معاذ ولقد ضم ضمة ثم روخي عنه»","صحيح","Sahih al-Jami al-Saghir 5306","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5307","«لو نجا أحد من ضمة القبر لنجا هذا الصبي»","صحيح","Sahih al-Jami al-Saghir 5307","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5308","«لو نزل موسى فاتبعتموه وتركتموني لضللتم أنا حظكم من النبيين وأنتم حظي من الأمم»","حسن","Sahih al-Jami al-Saghir 5308","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5309","«لولا أخشى أنها من الصدقة لأكلتها»","صحيح","Sahih al-Jami al-Saghir 5309","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5310","«لولا الهجرة لكنت امرءا من الأنصار ولو سلك الناس واديا أو شعبا لسلكت وادي الأنصار وشعبهم»","صحيح","Sahih al-Jami al-Saghir 5310","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5311","«لولا الهجرة لكنت امرءا من الأنصار ولو سلك الناس واديا أو شعبا لكنت مع الأنصار»","صحيح","Sahih al-Jami al-Saghir 5311","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5312","«لولا أن أشق على المؤمنين لأمرتهم بتأخير العشاء وبالسواك عند كل صلاة»","صحيح","Sahih al-Jami al-Saghir 5312","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5313","«لولا أن أشق على أمتي لأمرتهم أن يؤخروا العشاء إلى ثلث الليل أو نصفه»","صحيح","Sahih al-Jami al-Saghir 5313","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5314","«لولا أن أشق على أمتي لأمرتهم أن يصلوها هكذا» - يعني العشاء نصف الليل -","صحيح","Sahih al-Jami al-Saghir 5314","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5315","«لولا أن أشق على أمتي لأمرتهم بالسواك عند كل صلاة»","صحيح","Sahih al-Jami al-Saghir 5315","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5316","«لولا أن أشق على أمتي لأمرتهم بالسواك عند كل صلاة ولأخرت العشاء إلى ثلث الليل»","صحيح","Sahih al-Jami al-Saghir 5316","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5317","«لولا أن أشق على أمتي لأمرتهم بالسواك مع كل وضوء»","صحيح","Sahih al-Jami al-Saghir 5317","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5318","«لولا أن أشق على أمتي لأمرتهم عند كل صلاة بوضوء ومع كل وضوء بسواك»","حسن","Sahih al-Jami al-Saghir 5318","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5319","«لولا أن أشق على أمتي لفرضت عليهم السواك مع الوضوء ولأخرت العشاء الآخرة إلى نصف الليل»","صحيح","Sahih al-Jami al-Saghir 5319","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5320","«لولا أن الرسل لا تقتل لضربت أعناقكما»","صحيح","Sahih al-Jami al-Saghir 5320","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5321","«لولا أن الكلاب أمة من الأمم لأمرت بقتلها فاقتلوا منها كل أسود بهيم وما من أهل بيت يرتبطون كلبا إلا نقص من عملهم كل يوم قيراط إلا كلب صيد أو كلب حرث أو كلب غنم»","صحيح","Sahih al-Jami al-Saghir 5321","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5322","«لولا أن الكلاب أمة من الأمم لأمرت بقتلها كلها فاقتلوا منها الأسود البهيم»","صحيح","Sahih al-Jami al-Saghir 5322","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5323","«لولا أن الناس حديث عهدهم بكفر وليس عندي من النفقة ما يقوى على بنيانه لكنت أدخلت فيه من الحجر خمسة أذرع ولجعلت لها بابا يدخل الناس منه وبابا يخرج منه»","صحيح","Sahih al-Jami al-Saghir 5323","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5324","«لولا أن تجد صفية في نفسها لتركته حتى تأكل العافية حتى يحشر من بطونها» - يعني حمزة -","حسن","Sahih al-Jami al-Saghir 5324","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5325","«لولا أن لا تدافنوا لدعوت الله أن يسمعكم عذاب القبر»","صحيح","Sahih al-Jami al-Saghir 5325","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5326","«لولا أن قومك حديث عهد بجاهلية لهدمت الكعبة ولجعلت لها بابين»","صحيح","Sahih al-Jami al-Saghir 5326","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5327","«لولا أن قومك حديثوعهد بجاهلية لأنفقت كنز الكعبة في سبيل الله ولجعلت بابها بالأرض ولأدخلت فيها من الحجر»","صحيح","Sahih al-Jami al-Saghir 5327","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5328","«لولا أنك رسول لضربت عنقك»","صحيح","Sahih al-Jami al-Saghir 5328","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5329","«لولا أنكم تذنبون لخلق الله خلقا يذنبون فيغفر لهم»","صحيح","Sahih al-Jami al-Saghir 5329","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5330","«لولا بنو إسرائيل لم يخبث الطعام ولم يخنز اللحم ولولا حواء لم تخن أنثى زوجها»","صحيح","Sahih al-Jami al-Saghir 5330","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5331","«لولا حداثة عهد قومك بالكفر لنقضت البيت فبنيته على أساس إبراهيم وجعلت له خلفا فإن قريشا لما بنت البيت استقصرت»","صحيح","Sahih al-Jami al-Saghir 5331","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5332","«لولا ضعف الضعيف وسقم السقيم لأخرت صلاة العتمة»","صحيح","Sahih al-Jami al-Saghir 5332","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5333","«لولا ما مضى من كتاب الله لكان لي ولها شأن»","صحيح","Sahih al-Jami al-Saghir 5333","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5334","«لولا ما مس الحجر من أنجاس الجاهلية ما مسه ذوعاهة إلا شفي وما على الأرض شيء من الجنة غيره»","صحيح","Sahih al-Jami al-Saghir 5334","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5335","«لو يعطى الناس بدعواهم لادعى ناس دماء رجال وأموالهم ولكن اليمين على المدعى عليه»","صحيح","Sahih al-Jami al-Saghir 5335","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5336","«لو يعلم الذي يشرب وهو قائم ما في بطنه لاستقاء»","صحيح","Sahih al-Jami al-Saghir 5336","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5337","«لو يعلم المار بين يدي المصلي ماذا عليه لكان أن يقف أربعين خيرا له من أن يمر بين يديه»","صحيح","Sahih al-Jami al-Saghir 5337","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5338","«لو يعلم المؤمن ما عند الله من العقوبة ما طمع في الجنة أحد ولو يعلم الكافر ما عند الله من الرحمة ما قنط من الجنة أحد»","صحيح","Sahih al-Jami al-Saghir 5338","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5339","«لو» يعلم الناس ما في النداء والصف الأول ثم لم يجدوا إلا أن يستهموا عليه لاستهموا ولو يعلمون ما في التهجير لاستبقوا إليه ولو يعلمون ما في العتمة والصبح لأتوهما ولو حبوا ""","صحيح","Sahih al-Jami al-Saghir 5339","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5340","«لو» يعلم الناس ما في صلاة العشاء وصلاة الفجر لأتوهما ولو حبوا""","صحيح","Sahih al-Jami al-Saghir 5340","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5341","«لو» يعلم الناس من الوحدة ما أعلم ما سار راكب بليل وحده ""","صحيح","Sahih al-Jami al-Saghir 5341","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5342","«لو» يعلم صاحب المسألة ما له فيها لم يسأل""","صحيح","Sahih al-Jami al-Saghir 5342","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5343","""ليأتين على أمتي ما أتى على بني إسرائيل حذوالنعل بالنعل....., وإن بني إسرائيل تفرقت على ثنتين وسبعين ملة وتفترق أمتي على ثلاث وسبعين ملة كلهم في النار إلا ملة واحدة ما أنا عليه وأصحابي""","حسن","Sahih al-Jami al-Saghir 5343","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5344","«ليأتين على الناس زمان لا يبالي المرء بما أخذ المال؟ أمن حلال أم من حرام؟»","صحيح","Sahih al-Jami al-Saghir 5344","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5345","«ليأتين على الناس زمان يطوف الرجل فيه بالصدقة من الذهب ثم لا يجد أحدا يأخذها منه ويرى الرجل الواحد يتبعه أربعون امرأة يلذن به من قلة الرجال وكثرة النساء»","صحيح","Sahih al-Jami al-Saghir 5345","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5346","«ليأتين هذا الحجر يوم القيامة له عينان يبصر بهما ولسان ينطق به يشهد على من استلمه بحق»","صحيح","Sahih al-Jami al-Saghir 5346","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5347","«ليأخذ كل رجل برأس راحلته فإن هذا منزل حضرنا فيه الشيطان»","صحيح","Sahih al-Jami al-Saghir 5347","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5348","«ليأكل أحدكم بيمينه وليشرب بيمينه وليأخذ بيمينه فإن الشيطان يأكل بشماله ويشرب بشماله ويعطي بشماله ويأخذ بشماله»","صحيح","Sahih al-Jami al-Saghir 5348","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5349","«ليأكل كل رجل من أضحيته»","صحيح","Sahih al-Jami al-Saghir 5349","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5350","«ليؤمكم أكثركم قراءة للقرآن»","صحيح","Sahih al-Jami al-Saghir 5350","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5351","«ليؤمن هذا البيت جيش يغزونه حتى إذا كانوا ببيداء من الأرض يخسف بأوسطهم وينادي أولهم آخرهم ثم يخسف بهم فلا يبقى إلا الشريد الذي يخبر عنهم»","صحيح","Sahih al-Jami al-Saghir 5351","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5352","«ليبلغ الشاهد الغائب»","صحيح","Sahih al-Jami al-Saghir 5352","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5353","«ليبلغ شاهدكم غائبكم لا تصلوا بعد الفجر إلا سجدتين»","صحيح","Sahih al-Jami al-Saghir 5353","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5354","«ليبيتن أقوام من أمتي على أكل ولهوولعب ثم ليصبحن قردة وخنازير»","حسن","Sahih al-Jami al-Saghir 5354","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5355","«ليتخذ أحدكم قلبا شاكرا ولسانا ذاكرا وزوجة مؤمنة تعينه على أمر الآخرة»","صحيح","Sahih al-Jami al-Saghir 5355","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5356","«ليتصدق الرجل من صاع بره وليتصدق من صاع تمره»","صحيح","Sahih al-Jami al-Saghir 5356","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5357","«ليتق أحدكم وجهه عن النار ولو بشق تمرة»","صحيح","Sahih al-Jami al-Saghir 5357","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5358","""ليتكلف أحدكم من العمل ما يطيق فإن الله تعالى لا يمل حتى تملوا وقاربوا وسددوا ""","صحيح","Sahih al-Jami al-Saghir 5358","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5359","«ليتمنين أقوام لوأكثروا من السيئات الذين بدل الله عز وجل سيئاتهم حسنات»","حسن","Sahih al-Jami al-Saghir 5359","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5360","«ليتمنين أقوام ولو اهذا الأمر أنهم خروا من الثريا وأنهم لم يلوا شيئا»","حسن","Sahih al-Jami al-Saghir 5360","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5361","«ليحجن هذا البيت وليعتمرن بعد خروج يأجوج ومأجوج»","صحيح","Sahih al-Jami al-Saghir 5361","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5362","«ليخرجن قوم من أمتي من النار بشفاعتي يسمون الجهنميين»","صحيح","Sahih al-Jami al-Saghir 5362","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5363","«ليدخلن الجنة بشفاعة رجل ليس بنبي مثل الحيين: ربيعة ومضر إنما أقول ما أقول»","صحيح","Sahih al-Jami al-Saghir 5363","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5364","«ليدخلن الجنة بشفاعة رجل من أمتي أكثر من بني تميم»","صحيح","Sahih al-Jami al-Saghir 5364","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5365",""" ليدخلن الجنة من أمتي سبعون ألفا أو سبعمائة ألف، متماسكون آخذ بعضهم بيد بعض لا يدخل أولهم حتى يدخل آخرهم وجوههم على صورة القمر ليلة البدر""","صحيح","Sahih al-Jami al-Saghir 5365","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5366","«ليدخلن الجنة من أمتي سبعون ألفا لا حساب عليهم ولا عذاب مع كل ألف سبعون ألفا»","صحيح","Sahih al-Jami al-Saghir 5366","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5367","«ليراجعها ثم يمسكها حتى تطهر ثم تحيض فتطهر فإن بدا له أن يطلقها فليطلقها طاهرا قبل أن يمسها فتلك العدة التي أمر الله أن يطلق لها النساء»","صحيح","Sahih al-Jami al-Saghir 5367","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5368","«ليردن علي ناس من أصحابي الحوض حتى إذا رأيتهم وعرفتهم اختلجوا دوني فأقول: يا رب! أصحابي أصحابي فيقال لي: إنك لا تدري ما أحدثوا بعدك»","صحيح","Sahih al-Jami al-Saghir 5368","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5369","«ليس أحد أحب إليه المدح من الله ولا أحد أكثر معاذير من الله»","صحيح","Sahih al-Jami al-Saghir 5369","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5370","«ليس أحد أصبر على أذى سمعه من الله تعالى إنهم ليدعون له ولدا ويجعلون له أندادا وهو مع ذلك يعافيهم ويرزقهم»","صحيح","Sahih al-Jami al-Saghir 5370","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5371","«ليس أحد أفضل عند الله من مؤمن يعمر في الإسلام لتكبيره وتحميده وتسبيحه وتهليله»","صحيح","Sahih al-Jami al-Saghir 5371","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5372","«ليس أحد من أمتي يعول ثلاث بنات أو ثلاث أخوات فيحسن إليهن إلا كن له سترا من النار»","صحيح","Sahih al-Jami al-Saghir 5372","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5373","«ليس الخبر كالمعاينة»","صحيح","Sahih al-Jami al-Saghir 5373","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5374","«ليس الخبر كالمعاينة: إن الله تعالى أخبر موسى بما صنع قومه في العجل فلم يلق الألواح فلما عاين ما صنعوا ألقى الألواح فانكسرت»","صحيح","Sahih al-Jami al-Saghir 5374","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5375","«ليس الشديد بالصرعة إنما الشديد الذي يملك نفسه عند الغضب»","صحيح","Sahih al-Jami al-Saghir 5375","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5376","«ليس الصيام من الأكل والشرب إنما الصيام من اللغووالرفث فإن سابك أحد أو جهل عليك فقل إني صائم إني صائم»","صحيح","Sahih al-Jami al-Saghir 5376","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5377","«ليس الغنى عن كثرة العرض ولكن الغنى غنى النفس»","صحيح","Sahih al-Jami al-Saghir 5377","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5378","«ليس الفجر بالأبيض المستطيل في الأفق ولكنه الأحمر المعترض»","صحيح","Sahih al-Jami al-Saghir 5378","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5379","«ليس الكذاب بالذي يصلح بين الناس فينمي خيرا ويقول خيرا»","صحيح","Sahih al-Jami al-Saghir 5379","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5380","«ليس المؤمن الذي لا يأمن جاره بوائقه»","صحيح","Sahih al-Jami al-Saghir 5380","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5381","«ليس المؤمن بالطعان ولا اللعان ولا الفاحش ولا البذي»","صحيح","Sahih al-Jami al-Saghir 5381","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5382","«ليس المؤمن بالذي يشبع وجاره جائع إلى جنبه»","صحيح","Sahih al-Jami al-Saghir 5382","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5383","«ليس المسكين الذي ترده الأكلة والأكلتان ولكن المسكين الذي ليس له غنى ويستحي ولا يسأل الناس إلحافا»","صحيح","Sahih al-Jami al-Saghir 5383","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5384","«ليس المسكين الذي يطوف على الناس فترده اللقمة واللقمتان والتمرة والتمرتان ولكن المسكين الذي لا يجد غنى يغنيه ولا يفطن له فيتصدق عليه ولا يقوم فيسأل الناس»","صحيح","Sahih al-Jami al-Saghir 5384","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5385","«ليس الواصل بالمكافئ ولكن الواصل الذي إذا انقطعت رحمه وصلها»","صحيح","Sahih al-Jami al-Saghir 5385","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5386","«ليس بك هوان على أهلك إن شئت سبعت عندك وسبعت لنسائي وإن شئت ثلثت ثم درت»","صحيح","Sahih al-Jami al-Saghir 5386","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5387","«ليس بمؤمن من لا يأمن جاره غوائله»","حسن","Sahih al-Jami al-Saghir 5387","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5388","«ليس بين العبد والشرك إلا ترك الصلاة فإذا تركها فقد أشرك»","صحيح","Sahih al-Jami al-Saghir 5388","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5389","«ليس بيني وبين عيسى نبي وإنه نازل فإذا رأيتموه فاعرفوه رجل مربوع إلى الحمرة والبياض ينزل بين ممصرتين كأن رأسه يقطر وإن لم يصبه بلل فيقاتل الناس على الإسلام فيدق الصليب ويقتل الخنزير ويضع الجزية ويهلك الله في زمانه الملل كلها إلا الإسلام ويهلك المسيح الدجال فيمكث في الأرض أربعين سنة ثم يتوفى فيصلي عليه المسلمون»","صحيح","Sahih al-Jami al-Saghir 5389","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5390","«ليس شيء أثقل في الميزان من الخلق الحسن»","صحيح","Sahih al-Jami al-Saghir 5390","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5391","«ليس شيء أطيع الله تعالى فيه أعجل ثوابا من صلة الرحم وليس شيء أعجل عقابا من البغي وقطيعة الرحم واليمين الفاجرة تدع الديار بلاقع»","صحيح","Sahih al-Jami al-Saghir 5391","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5392","«ليس شيء أكرم على الله تعالى من الدعاء»","حسن","Sahih al-Jami al-Saghir 5392","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5393","«ليس شيء إلا وهو أطوع لله تعالى من ابن آدم»","حسن","Sahih al-Jami al-Saghir 5393","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5394","«ليس شيء خيرا من ألف مثله إلا الإنسان»","حسن","Sahih al-Jami al-Saghir 5394","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5395","«ليس شيء من الإنسان إلا يبلى إلا عظم واحد وهو عجب الذنب ومنه يركب الخلق يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5395","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5396","«ليس شيء من الجسد إلا وهو يشكو ذرب اللسان»","صحيح","Sahih al-Jami al-Saghir 5396","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5397","«ليس على أبيك كرب بعد اليوم»","صحيح","Sahih al-Jami al-Saghir 5397","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5398","«ليس على الرجل طلاق فيما لا يملك ولا عتاق فيما لا يملك ولا بيع فيما لا يملك»","حسن","Sahih al-Jami al-Saghir 5398","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5399","«ليس على الماء جنابة»","صحيح","Sahih al-Jami al-Saghir 5399","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5400","«ليس على المختلس قطع»","صحيح","Sahih al-Jami al-Saghir 5400","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5401","«ليس على المسلم في عبده ولا في فرسه صدقة»","صحيح","Sahih al-Jami al-Saghir 5401","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5402","«ليس على المنتهب ولا على المختلس ولا على الخائن قطع»","صحيح","Sahih al-Jami al-Saghir 5402","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5403","«ليس على النساء حلق إنما على النساء التقصير»","صحيح","Sahih al-Jami al-Saghir 5403","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5404","«ليس على رجل نذر فيما لا يملك ولعن المؤمن كقتله ومن قتل نفسه بشيء عذب به يوم القيامة ومن حلف بملة سوى الإسلام كاذبا فهو كما قال ومن قذف مؤمنا بكفر فهو كقتله»","صحيح","Sahih al-Jami al-Saghir 5404","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5405","«ليس على مسافر جمعة»","صحيح","Sahih al-Jami al-Saghir 5405","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5406","«ليس على ولد الزنا من وزر أبويه شيء»","حسن","Sahih al-Jami al-Saghir 5406","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5407","«ليس عليها غسل حتى تنزل كما أنه ليس على الرجل غسل حتى ينزل»","صحيح","Sahih al-Jami al-Saghir 5407","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5408","«ليس عليكم في غسل ميتكم غسل إذا غسلتموه فإن ميتكم ليس بنجس فحسبكم أن تغسلوا أيديكم»","صحيح","Sahih al-Jami al-Saghir 5408","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5409","«ليس في الأوقاص شيء»","صحيح","Sahih al-Jami al-Saghir 5409","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5410","«ليس في الجنة شيء مما في الدنيا إلا الأسماء»","صحيح","Sahih al-Jami al-Saghir 5410","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5411","«ليس في الخضروات زكاة»","صحيح","Sahih al-Jami al-Saghir 5411","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5412","«ليس في الخيل والرقيق زكاة إلا زكاة الفطر في الرقيق»","صحيح","Sahih al-Jami al-Saghir 5412","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5413","«ليس في العبد صدقة إلا صدقة الفطر»","صحيح","Sahih al-Jami al-Saghir 5413","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5414","«ليس في المأمومة قود»","حسن","Sahih al-Jami al-Saghir 5414","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5415","«ليس في النوم تفريط إنما التفريط في اليقظة أن تؤخر صلاة حتى يدخل وقت صلاة أخرى»","صحيح","Sahih al-Jami al-Saghir 5415","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5416","«ليس فيما دون خمسة أوسق من التمر صدقة وليس فيما دون خمس ذود من الإبل صدقة وليس فيما دون خمس أواق من الورق صدقة»","صحيح","Sahih al-Jami al-Saghir 5416","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5417","«ليس فيما دون خمسة أوساق من تمر ولا حب صدقة»","صحيح","Sahih al-Jami al-Saghir 5417","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5418","«ليس فيما دون خمس من الإبل صدقة وليس في الأربع شيء فإذا بلغت خمسا ففيها شاة إلى أن تبلغ تسعا فإذا بلغت عشرا ففيها شاتان إلى أن تبلغ أربع عشرة فإذا بلغت خمس عشرة ففيها ثلاث شياه إلى أن تبلغ تسع عشرة فإذا بلغت عشرين ففيها أربع شياه إلى أن تبلغ أربعا وعشرين فإذا بلغت خمسا وعشرين ففيها بنت مخاض إلى خمس وثلاثين فإن لم تكن بنت مخاض فابن لبون ذكر فإن زادت بعيرا ففيها بنت لبون إلى أن تبلغ خمسا وأربعين فإن زادت بعيرا ففيها حقة إلى أن تبلغ ستين فإن زادت بعيرا ففيها جذعة إلى أن تبلغ خمسا وسبعين فإن زادت بعيرا ففيها بنتا لبون إلى أن تبلغ تسعين فإن زادت بعيرا ففيها حقتان إلى أن تبلغ عشرين ومائة ثم في كل خمسين حقة وفي كل أربعين بنت لبون»","صحيح","Sahih al-Jami al-Saghir 5418","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5419","«ليس لأحد على أحد فضل إلا بالدين أو عمل صالح حسب الرجل أن يكون فاحشا بذيا بخيلا جبانا»","صحيح","Sahih al-Jami al-Saghir 5419","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5420","«ليس لقاتل ميراث»","صحيح","Sahih al-Jami al-Saghir 5420","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5421","«ليس للقاتل شيء وإن لم يكن له وارث فوارثه أقرب الناس إليه ولا يرث القاتل شيئا»","حسن","Sahih al-Jami al-Saghir 5421","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5422","«ليس للقاتل من الميراث شيء»","صحيح","Sahih al-Jami al-Saghir 5422","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5423","«ليس لله شريك»","صحيح","Sahih al-Jami al-Saghir 5423","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5424","«ليس للمرأة أن تنتهك شيئا من مالها إلا بإذن زوجها»","صحيح","Sahih al-Jami al-Saghir 5424","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5425","«ليس للنساء وسط الطريق»","حسن","Sahih al-Jami al-Saghir 5425","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5426","«ليس لنا مثل السوء العائد في هبته كالكلب يعود في قيئه»","صحيح","Sahih al-Jami al-Saghir 5426","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5427","«ليس لي أن أدخل بيتا مزوقا»","صحيح","Sahih al-Jami al-Saghir 5427","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5428","«ليس من البر الصيام في السفر»","صحيح","Sahih al-Jami al-Saghir 5428","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5429","«ليس من البر الصيام في السفر فعليكم برخصة الله التي رخص لكم فاقبلوها»","صحيح","Sahih al-Jami al-Saghir 5429","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5430","«ليس من بلد إلا سيطؤه الدجال إلا مكة والمدينة وليس نقب من أنقابها إلا عليه الملائكة حافين تحرسها فينزل بالسبخة فترجف المدينة بأهلها ثلاث رجفات يخرج إليه منها كل كافر ومنافق»","صحيح","Sahih al-Jami al-Saghir 5430","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5431","«ليس من رجل ادعى لغير أبيه وهو يعلمه إلا كفر ومن ادعى ما ليس له فليس منا وليتبوأ مقعده من النار ومن دعا رجلا بالكفر أو قال عدو الله وليس كذلك إلا حار عليه ولا يرمي رجل رجلا بالفسق ولا يرميه بالكفر إلا ارتدت عليه إن لم يكن صاحبه كذلك»","صحيح","Sahih al-Jami al-Saghir 5431","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5432","«ليس من عمل يوم إلا وهو يختم عليه فإذا مرض المؤمن قالت الملائكة: يا ربنا! عبدك فلان قد حبسته فيقول الرب: اختموا له على مثل عمله حتى يبرأ أو يموت»","صحيح","Sahih al-Jami al-Saghir 5432","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5433","«ليس منا من تشبه بالرجال من النساء ولا من تشبه بالنساء من الرجال»","صحيح","Sahih al-Jami al-Saghir 5433","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5434","«ليس منا من تشبه بغيرنا لا تشبهوا باليهود ولا بالنصارى فإن تسليم اليهود الإشارة بالأصابع وتسليم النصارى الإشارة بالأكف»","حسن","Sahih al-Jami al-Saghir 5434","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5435","«ليس منا من تطير ولا من تطير له أو تكهن أو تكهن له أو تسحر أو تسحر له»","صحيح","Sahih al-Jami al-Saghir 5435","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5436","«ليس منا من حلف بالأمانة ومن خبب على امرئ زوجته أو مملوكه فليس منا»","صحيح","Sahih al-Jami al-Saghir 5436","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5437","«ليس منا من خبب امرأة على زوجها أو عبدا على سيده»","صحيح","Sahih al-Jami al-Saghir 5437","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5438","«ليس منا من سلق ومن حلق ومن خرق»","صحيح","Sahih al-Jami al-Saghir 5438","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5439","«ليس منا من عمل بسنة غيرنا»","حسن","Sahih al-Jami al-Saghir 5439","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5440","«ليس منا من غش»","صحيح","Sahih al-Jami al-Saghir 5440","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5441","«ليس منا من لطم الخدود وشق الجيوب ودعا بدعوى الجاهلية»","صحيح","Sahih al-Jami al-Saghir 5441","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5442","«ليس منا من لم يتغن بالقرآن»","صحيح","Sahih al-Jami al-Saghir 5442","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5443","«ليس منا من لم يجل كبيرنا ويرحم صغيرنا! ويعرف لعالمنا حقه»","حسن","Sahih al-Jami al-Saghir 5443","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5444","«ليس منا من لم يرحم صغيرنا ويعرف شرف كبيرنا»","صحيح","Sahih al-Jami al-Saghir 5444","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5445","«ليس منا من لم يرحم صغيرنا ويوقر كبيرنا»","صحيح","Sahih al-Jami al-Saghir 5445","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5446","«ليس يتحسر أهل الجنة على شيء إلا على ساعة مرت بهم لم يذكروا الله عز وجل فيها»","أقرب","Sahih al-Jami al-Saghir 5446","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5447","«ليست السنة بأن لا تمطروا ولكن السنة أن تمطروا وتمطروا ولا تنبت الأرض شيئا»","صحيح","Sahih al-Jami al-Saghir 5447","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5448","«ليسترجع أحدكم في كل شيء حتى في شسع نعله فإنها من المصائب»","ضعيف","Sahih al-Jami al-Saghir 5448","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5449","«ليستغن أحدكم عن الناس بقضيب سواك»","صحيح","Sahih al-Jami al-Saghir 5449","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5450","«ليسلم الراكب على الراجل وليسلم الراجل على القاعد وليسلم الأقل على الأكثر فمن أجاب السلام فهو له ومن لم يجب فلا شيء له»","صحيح","Sahih al-Jami al-Saghir 5450","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5451","«ليسوقن الرجل من قحطان الناس بعصا»","صحيح","Sahih al-Jami al-Saghir 5451","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5452","«ليشترك النفر في الهدي»","صحيح","Sahih al-Jami al-Saghir 5452","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5453","«ليشربن أناس من أمتي الخمر يسمونها بغير اسمها»","صحيح","Sahih al-Jami al-Saghir 5453","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5454","«ليشربن أناس من أمتي الخمر يسمونها بغير اسمها ويضرب على رءوسهم بالمعازف والقينات يخسف الله بهم الأرض ويجعل منهم قردة وخنازير»","صحيح","Sahih al-Jami al-Saghir 5454","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5455","«ليصل أحدكم نشاطه فإذا كسل أو فتر فليقعد»","صحيح","Sahih al-Jami al-Saghir 5455","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5456","«ليصل الرجل في المسجد الذي يليه ولا يتبع المساجد»","صحيح","Sahih al-Jami al-Saghir 5456","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5457","«ليصيبن ناسا سفع من النار عقوبة بذنوب عملوها ثم يدخلهم الله الجنة بفضل رحمته فيقال لهم: الجهنميون»","صحيح","Sahih al-Jami al-Saghir 5457","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5458","«ليضع أحدكم بين يديه مثل مؤخرة الرحل ولا يضره ما مر بين يديه»","صحيح","Sahih al-Jami al-Saghir 5458","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5459","«ليعز المسلمين في مصائبهم المصيبة بي»","صحيح","Sahih al-Jami al-Saghir 5459","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5460","«ليغشين أمتي من بعدي فتن كقطع الليل المظلم يصبح الرجل فيها مؤمنا ويمسي كافرا يبيع أقوام دينهم بعرض من الدنيا قليل»","صحيح","Sahih al-Jami al-Saghir 5460","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5461","«ليفرن الناس من الدجال في الجبال»","صحيح","Sahih al-Jami al-Saghir 5461","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5462","«ليقتلن ابن مريم الدجال بباب لد»","صحيح","Sahih al-Jami al-Saghir 5462","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5463","«ليقرأن القرآن ناس من أمتي يمرقون من الإسلام كما يمرق السهم من الرمية»","صحيح","Sahih al-Jami al-Saghir 5463","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5464","«ليكف أحدكم من الدنيا خادم ومركب»","حسن","Sahih al-Jami al-Saghir 5464","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5465","«ليكف الرجل منكم كزاد الراكب»","صحيح","Sahih al-Jami al-Saghir 5465","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5466","«ليكونن في أمتي أقوام يستحلون الخز والحرير والخمر والمعازف ولينزلن أقوام إلى جنب علم تروح عليهم سارحتهم فيأتيهم آت لحاجته فيقولون له: ارجع إلينا غدا فيبعثهم الله ويقع العلم عليهم ويمسخ منهم آخرين قردة وخنازير إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5466","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5467","«ليكونن في هذه الأمة خسف وقذف ومسخ وذلك إذا شربوا الخمور واتخذوا القينات وضربوا بالمعازف»","صحيح","Sahih al-Jami al-Saghir 5467","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5468","""ليلة أسري بي رأيت موسى وإذا هورجل ضرب كأنه من رجال شنوءة ورأيت عيسى فإذا هورجل ربعة أحمر كأنما خرج من ديماس. ورأيت إبراهيم وأنا أشبه ولده به. ثم أتيت بإناءين في أحدهما لبن وفي الآخر خمر فقيل لي: اشرب أيهما شئت فأخذت اللبن فشربته فقيل لي: أصبت الفطرة أما إنك لوأخذت الخمر غوت أمتك""","صحيح","Sahih al-Jami al-Saghir 5468","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5469","«ليلة أسري بي ما مررت على ملأ من الملائكة إلا أمروني بالحجامة»","صحيح","Sahih al-Jami al-Saghir 5469","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5470","«ليلة الضيف حق على كل مسلم فمن أصبح الضيف بفنائه فهو له عليه دين إن شاء اقتضى وإن شاء ترك»","صحيح","Sahih al-Jami al-Saghir 5470","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5471","«ليلة القدر في العشر الأواخر في الخامسة أو الثالثة»","صحيح","Sahih al-Jami al-Saghir 5471","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5472","«ليلة القدر ليلة بلجة لا حارة ولا باردة,.......... ولا يرمى فيها بنجم ومن علامة يومها تطلع الشمس لا شعاع لها»","حسن","Sahih al-Jami al-Saghir 5472","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5473","«ليلة القدر ليلة سابعة أو تاسعة وعشرين إن الملائكة تلك الليلة في الأرض أكثر من عدد الحصى»","حسن","Sahih al-Jami al-Saghir 5473","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5474","«ليلة القدر ليلة سبع وعشرين»","صحيح","Sahih al-Jami al-Saghir 5474","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5475","«ليلة القدر ليلة سمحة طلقة لا حارة ولا باردة تصبح الشمس صبيحتها ضعيفة حمراء»","صحيح","Sahih al-Jami al-Saghir 5475","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5476","«ليليني منكم أولوا الأحلام والنهى ثم الذين يلونهم ثم الذين يلونهم ولا تختلفوا فتختلف قلوبكم وإياكم وهيشات الأسواق»","صحيح","Sahih al-Jami al-Saghir 5476","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5477","«لينبعث من كل رجلين أحدهما والأجر بينهما»","صحيح","Sahih al-Jami al-Saghir 5477","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5478","«لينتقضن الإسلام عروة عروة»","صحيح","Sahih al-Jami al-Saghir 5478","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5479","«لينتهين أقوام عن رفعهم أبصارهم عند الدعاء في الصلاة إلى السماء أو لتخطفن أبصارهم»","صحيح","Sahih al-Jami al-Saghir 5479","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5480","«لينتهين أقوام عن ودعهم الجمعات أو ليختمن الله على قلوبهم ثم ليكونن من الغافلين»","صحيح","Sahih al-Jami al-Saghir 5480","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5481","«لينتهين أقوام يرفعون أبصارهم إلى السماء في الصلاة أو لا ترجع إليهم أبصارهم»","صحيح","Sahih al-Jami al-Saghir 5481","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5482","«لينتهين أقوام يفتخرون بآبائهم الذين ماتوا إنما هم فحم جهنم أو ليكونن أهون على الله من الجعل الذي يدهده الخرء بأنفه إن الله أذهب عنكم عبية الجاهلية وفخرها بالآباء إنما هو مؤمن تقي أو فاجر شقي الناس كلهم بنوآدم وآدم خلق من التراب»","صحيح","Sahih al-Jami al-Saghir 5482","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5483","«لينصرن الرجل أخاه ظالما أو مظلوما إن كان ظالما فلينهه فإنه له نصرة وإن كان مظلوما فلينصره»","صحيح","Sahih al-Jami al-Saghir 5483","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5484","«ليودن أهل العافية يوم القيامة أن جلودهم قرضت بالمقاريض مما يرون من ثواب أهل البلاء»","حسن","Sahih al-Jami al-Saghir 5484","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5485","«ليودن رجل أنه خر من عند الثريا وأنه لم يل من أمر الناس شيئا»","حسن","Sahih al-Jami al-Saghir 5485","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5486","«ليوشكن رجل أن يتمنى أنه خر من الثريا ولم يل من أمر الناس شيئا»","حسن","Sahih al-Jami al-Saghir 5486","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5487","«لي الواجد يحل عرضه وعقوبته»","حسن","Sahih al-Jami al-Saghir 5487","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5488","«اللبن في المنام فطرة»","حسن","Sahih al-Jami al-Saghir 5488","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5489","«اللحد لنا والشق لغيرنا»","صحيح","Sahih al-Jami al-Saghir 5489","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5490","«اللحد لنا والشق لغيرنا من أهل الكتاب»","صحيح","Sahih al-Jami al-Saghir 5490","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5491","«الذي تفوته صلاة العصر كأنما وتر أهله وماله»","صحيح","Sahih al-Jami al-Saghir 5491","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5492","«الذي لا يتم ركوعه وينقر في سجوده مثل الجائع يأكل التمرة والتمرتين لا يغنيان عنه شيئا»","حسن","Sahih al-Jami al-Saghir 5492","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5493","«الذي لا ينام حتى يوتر حازم»","صحيح","Sahih al-Jami al-Saghir 5493","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5494","«الذي يخنق نفسه يخنقها في النار والذي يطعنها يطعنها في النار»","صحيح","Sahih al-Jami al-Saghir 5494","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5495","«الذي يسأل من غير حاجة كمثل الذي يلتقط الجمر»","صحيح","Sahih al-Jami al-Saghir 5495","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5496","«الذي يشرب في آنية الفضة إنما يجرجر في بطنه نار جهنم»","صحيح","Sahih al-Jami al-Saghir 5496","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5497","«الذي يقرأ القرآن وهو ماهر به مع السفرة الكرام البررة والذي يقرؤه وهو عليه شاق له أجران»","صحيح","Sahih al-Jami al-Saghir 5497","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
"5498","«اللهو في ثلاث: تأديب فرسك ورميك بقوسك وملاعبتك أهلك»","صحيح","Sahih al-Jami al-Saghir 5498","","","الأحاديث المبدوءة بحرف اللام Hadith Beginning with the Letter Lam (ل)"
