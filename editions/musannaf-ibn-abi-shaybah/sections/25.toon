hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"24049","(۲۴۰۴۹) حَدَّثَنَا یَحْیَی بْنُ أَبِی بُکَیْرٍ ، قَالَ : حدَّثَنَا زُہَیْرُ بْنُ مُحَمَّدٍ ، عَنْ یَزِیدَ بْنِ خُصَیْفَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ اللہِ بْنِ کَعْبٍ ، عَنْ نَافِعٍ ، عَنْ عُثْمَانَ بْنِ أَبِی الْعَاصِ الثَّقَفِیِّ ، قَالَ : قَدِمْتُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَبِی وَجَعٌ قَدْ کَادَ یُبْطِلُنِی ، فَقَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اجْعَلْ یَدَکَ الْیُمْنَی عَلَیْہِ ، ثُمَّ قُلْ : بِسْمِ اللہِ ، أَعُوذُ بِعِزَّۃِ اللہِ وَقُدْرَتِہِ مِنْ شَرِّ مَا أَجِدُ ، سَبْعَ مَرَّاتٍ ، فَفَعَلْتُ ذَلِکَ ، فَشَفَانِی اللَّہُ۔\n(مسلم ۶۷۔ احمد ۴/۲۱۷)","Sahih","Musannaf Ibn Abi Shaybah 24049","","","كتاب الطب"
"24050","(۲۴۰۵۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سُلَیْمَانَ بْنِ عَمْرِو بْنِ الأَحْوَص ، عَنْ أُمِّہِ أُمِّ جُنْدَبٍ ، قَالَتْ : رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تَبِعَتْہُ امْرَأَۃٌ مِنْ خَثْعَمَ مَعَہَا صَبِیٌّ لَہَا بِہِ بَلاَئٌ ، فَقَالَتْ : یَا رَسُولَ اللہِ ، إِنَّ ہَذَا ابْنِی وَبَقِیَّۃُ أَہْلِی ، وَبِہِ بَلاَئٌ لاَ یَتَکَلَّمُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اِئْتُونِی بِشَیْئٍ مِنْ مَائٍ ، فَأُتِیَ بِہِ فَغَسَلَ فِیہِ یَدَیْہِ ، وَمَضْمَضَ فَاہُ ، ثُمَّ أَعْطَاہَا ، فَقَالَ : اسْقِیہِ مِنْہُ ، وَصُبِّی عَلَیْہِ مِنْہُ ، وَاسْتَشْفِی اللَّہَ لَہُ ۔ فَلَقِیتُ الْمَرْأَۃَ فَقُلْتُ : لَوْ وَہَبْتِ لِی مِنْہُ ، فَقَالَتْ : إِنَّمَا ہُوَ لِہَذَا الْمُبْتَلَی ، فَلَقِیتُ الْمَرْأَۃَ مِنَ الْحَوْلِ ، فَسَأَلْتُہَا عَنِ الْغُلاَمِ ؟ فَقَالَتْ : بَرَأَ ، وَعَقَلَ عَقْلاً لَیْسَ کَعُقُولِ النَّاسِ۔\n(ابن ماجہ ۳۵۳۲۔ طبرانی ۲۵)","Da'if","Musannaf Ibn Abi Shaybah 24050","","","كتاب الطب"
"24051","(۲۴۰۵۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ أَبِی حَیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی الْحُسَیْنِ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : نَزَلَ مَلَکَانِ ، فَجَلَسَ أَحَدُہُمَا عِنْدَ رَأْسِی وَالآخَرُ عِنْدَ رِجْلِی ، فَقَالَ الَّذِی عِنْدَ رِجْلِی لِلَّذِی عِنْدَ رَأْسِی : مَا بِہِ ؟ قَالَ : حُمَّی شَدِیدَۃٌ، قَالَ: عَوِّذْہُ ، قَالَ : فَمَا نَفَثَ ، وَلاَ نَفَخَ ، فَقَالَ : بِسْمِ اللہِ أَرْقِیکَ ، وَاللَّہُ یَشْفِیکَ ، خُذْہَا فَلْتَہْنِیْکَ۔ (طبرانی ۱۰۹۳)","Da'if","Musannaf Ibn Abi Shaybah 24051","","","كتاب الطب"
"24052","(۲۴۰۵۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : حدَّثَنِی خَارِجَۃُ بْنُ الصَّلْتِ ؛ أَنَّ عَمَّہ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا رَجَعَ مَرَّ عَلَی أَعْرَابِیٍّ مَجْنُونٍ مُوثَقٍ فِی الْحَدِیدِ ، فَقَالَ بَعْضُہُمْ : أَعِنْدَکَ شَیْئٌ تُدَاوِیہِ بِہِ ؟ فَإِنَّ صَاحِبَکُمْ قَدْ جَائَ بِخَیْرٍ ، فَرَقَیْتُہُ بِأُمِّ الْقُرْآنِ ثَلاَثَۃَ أَیَّامٍ ، کُلَّ یَوْمٍ مَرَّتَیْنِ ، فَبَرَأَ ، فَأَعْطَوْنِی مِئَۃ شَاۃٍ ، فَلَمَّا قَدِمْتُ أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرْتُہُ فَقَالَ : أَقُلْتَ غَیْرَ ہَذَا ؟ فَقُلْتُ : لاَ ، قَالَ : کُلْہَا بِسْمِ اللہِ ، فَلَعَمْرِی لِمَنْ أَکَلَ بِرُقْیَۃِ بَاطِلٍ ، لَقَدْ أَکَلْتَ بِرُقْیَۃِ حَقٍّ۔ (ابوداؤد ۳۸۹۳۔ احمد ۵/۲۱۰)","Hasan","Musannaf Ibn Abi Shaybah 24052","","","كتاب الطب"
"24053","(۲۴۰۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ جَعْفَرِ بْنِ إِیَاسٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : بَعَثَنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ثَلاَثِینَ رَاکِبًا فِی سَرِیَّۃٍ ، قَالَ : فَنَزَلْنَا بِقَوْمٍ فَسَأَلْنَاہُمَ الْقِرَی ، فَلَمْ یَقْرُونَا ، قَالَ : فَلُدِغَ سَیِّدُہُمْ ، قَالَ : فَأَتَوْنَا فَقَالُوا : أَفِیکُمْ أَحَدٌ یَرْقِی مِنَ الْعَقْرَبِ ؟ قَالَ : قُلْتُ : نَعَمْ ، لَکِنِی لاَ أَرْقِیہِ حَتَّی تُعْطُونَا غَنَمًا ، قَالَ : فَقَالُوا : فَإِنَّا نُعْطِیکُمْ ثَلاَثِینَ شَاۃً ، قَالَ : فَقَبِلْنَا ، قَالَ : فَقَرَأْتُ فَاتِحَۃَ الکتاب سَبْعَ مَرَّاتٍ ، قَالَ : فَبَرَأَ ، فَقُلْنَا : لاَ تَعْجَلُوا حَتَّی تَأْتُوا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : فَلَمَّا قَدِمْنَا عَلَیْہِ، قَالَ : فَذَکَرْتُ لَہُ الَّذِی صَنَعْتُ ، قَالَ : أَوَ مَا عَلِمْتَ أَنَّہَا رُقْیَۃٌ ؟ اقْسِمُوا الْغَنَمَ ، وَاضْرِبُوا لِی مَعَکُمْ بِسَہْمٍ۔\n(ترمذی ۲۰۶۳۔ احمد ۳/۱۰)","Sahih","Musannaf Ibn Abi Shaybah 24053","","","كتاب الطب"
"24054","(۲۴۰۵۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : أَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلٌ فَقَالَ : إِنِّی رَقَیْتُ فُلاَنًا ، وَکَانَ بِہِ جُنُونٌ ، فَأُعْطِیتُ قَطِیعًا مِنْ غَنَمٍ ، وَإِنَّمَا رَقَیْتُہُ بِالْقُرْآنِ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَخَذَ بِرُقْیَۃِ بَاطِلٍ ، فَقَدْ أَخَذْتَ بِرُقْیَۃِ حَقٍّ۔","","Musannaf Ibn Abi Shaybah 24054","","","كتاب الطب"
"24055","(۲۴۰۵۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، قَالَ : أَخْبَرَنِی عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ یَعْلَی بْنِ مُرَّۃَ ، قَالَ : خَرَجْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ حَتَّی إِذَا کُنَّا بِبَعْضِ الطَّرِیقِ مَرَرْنَا بِامْرَأَۃٍ جَالِسَۃٍ وَمَعَہَا صَبِیٌّ لَہَا ، فَقَالَتْ : یَا رَسُولَ اللہِ ، ابْنِی ہَذَا بِہِ بَلاَئٌ ، وَأَصَابَنَا مِنْہُ بَلاَئٌ ، یُؤْخَذُ فِی الْیَوْمِ لاَ أَدْرِی کَمْ مَرَّۃً ؟ فَقَالَ : نَاوِلِینِیہِ ، فَرَفَعَتْہُ إِلَیْہِ ، فَجَعَلَہُ بَیْنَہُ وَبَیْنَ وَاسِطَۃِ الرَّحْلِ ، ثُمَّ فَغَرَ فَاہُ ، ثُمَّ نَفَثَ فِیہِ ثَلاَثًا : بِسْمِ اللہِ ، أَنَا عَبْدُ اللہِ ، إِخْسَأْ عَدُوَّ اللہِ ، ثُمَّ نَاوَلَہَا إِیَّاہُ ، ثُمَّ قَالَ : اِلْقَیْنَا فِی الرَّجْعَۃِ فِی ہَذَا الْمَکَانِ ، فَأَخْبِرِینَا مَا فَعَلَ ؟ قَالَ : فَذَہَبْنَا ثُمَّ رَجَعْنَا فَوَجَدْنَاہَا فِی ذَلِکَ الْمَکَانِ مَعَہَا شِیَاہٌ ثَلاَثٌ ، فَقَالَ : مَا فَعَلَ صَبِیُّکِ ؟ فَقَالَتْ : وَالَّذِی بَعَثَکَ بِالْحَقِّ ، مَا أَحَسَسْنَا مِنْہُ بِشَیْئٍ حَتَّی السَّاعَۃِ ، فَاجْتَزرْ ہَذِہِ الْغَنَمَ ، قَالَ : انْزِلْ فَخُذْ مِنْہَا وَاحِدَۃً ، وَرُدَّ الْبَقِیَّۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 24055","","","كتاب الطب"
"24056","(۲۴۰۵۶) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : أَخْبَرَنَا إِسْرَائِیلُ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عُمَارَۃَ بْنِ عَبْدٍ ، عَنْ عَلِیٍّ ، قَالَ : لاَ رُقْیَۃَ إِلاَّ مِمَا أَخَذَ سُلَیْمَانُ مِنْہ الْمِیثَاقَ۔","Da'if","Musannaf Ibn Abi Shaybah 24056","","","كتاب الطب"
"24057","(۲۴۰۵۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عُرْوَۃَ بْنِ عَامِرٍ ، عَنْ عُبَیْدِ بْنِ رِفَاعَۃَ الزُّرَقِیِّ ، قَالَ : قالَتْ أَسْمَائُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ بَنِی جَعْفَرٍ تُسْرِعُ إِلَیْہِمُ الْعَیْنُ ، فَأَسْتَرْقِی لَہُمْ مِنَ الْعَیْنِ ؟ قَالَ : نَعَمْ، فَلَوْ کَانَ شَیْئٌ سَابِقَ الْقَدَرِ لَسَبَقَتْہُ الْعَیْنُ۔ (ترمذی ۲۰۵۹۔ ابن ماجہ ۳۵۱۰)","","Musannaf Ibn Abi Shaybah 24057","","","كتاب الطب"
"24058","(۲۴۰۵۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ نَافِعٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ؛ أَنَّ عُرْوَۃَ بْنَ الزُّبَیْرِ أَخْبَرَہُ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ بَیْتَ أُمِّ سَلَمَۃَ ، فَإِذَا صَبِیٌّ فِی الْبَیْتِ یَشْتَکِی ، فَسَأَلَہُمْ عَنْہُ؟ فَقَالُوا: نَظُنُّ أَنَّ بِہِ الْعَیْنَ، فَزَعَمَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: أَلاَ تَسْتَرْقُونَ لَہُ مِنَ الْعَیْنِ۔\n(بخاری ۵۷۳۹۔ مالک ۴)","","Musannaf Ibn Abi Shaybah 24058","","","كتاب الطب"
"24059","(۲۴۰۵۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی نَجِیحٍ ، عَنْ عَبْدِ اللہِ بْنِ بَابَیْہ ، مَوْلَی جُبَیْرِ بْنِ مُطْعِمٍ ، قَالَ : قالَتْ أَسْمَائُ بِنْتُ عُمَیْسٍ : قُلْتُ : یَا رَسُولَ اللہِ ، إِنَّ الْعَیْنَ تُسْرِعُ إِلَی بَنِی جَعْفَرٍ ، فَأَسْتَرْقِی لَہُمْ ؟ قَالَ : نَعَمْ ، فَلَوْ قُلْتُ لِشَیْئٍ یَسْبِقُ الْقَدَرَ ، لَقُلْتُ : إِنَّ الْعَیْنَ تَسْبِقُہُ۔","","Musannaf Ibn Abi Shaybah 24059","","","كتاب الطب"
"24060","(۲۴۰۶۰) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا عَمَّارُ بْنُ رُزَیْقٍ ، عَنْ عَبْدِ اللہِ بْنِ عِیسَی ، عَنْ أُمَیَّۃَ بْنِ ہِنْدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرِ بْنِ رَبِیعَۃَ ، عَنْ أَبِیہِ ، قَالَ : انْطَلَقْتُ أَنَا وَسَہْلُ بْنُ حُنَیْفٍ نَلْتَمِسُ الْخَمِرَ ، فَوَجَدْنَا خَمِرًا، أَوْ غَدِیرًا ، وَکَانَ أَحَدُنَا یَسْتَحْیِی أَنْ یَغْتَسِلَ وَأَحَدٌ یَرَاہُ ، فَاسْتَتَرَ مِنِّی حَتَّی إِذَا رَأَی أَنْ قَدْ فَعَلَ ، نَزَعَ جُبَّۃً عَلَیْہِ مِنْ کِسَائٍ ، ثُمَّ دَخَلَ الْمَائَ ، فَنَظَرْتُ إِلَیْہِ فَأَعْجَبَنِی خَلْقُہُ ، فَأَصَبْتُہُ مِنْہَا بِعَیْنٍ ، فَأَخَذَتْہُ قَفْقَفَۃٌ وَہُوَ فِی الْمَائِ، فَدَعَوْتُہُ فَلَمْ یُجِبْنِی، فَانْطَلَقْتُ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَخْبَرْتُہُ الْخَبَرَ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: قُومُوا، فَأَتَاہُ، فَرَفَعَ عَنْ سَاقِہِ، ثُمَّ دَخَلَ إِلَیْہِ الْمَائَ، فَلَمَّا أَتَاہُ ضَرَبَ صَدْرَہُ، ثُمَّ قَالَ: اللَّہُمَّ أَذْہِبْ حَرَّہَا وَبَرْدَہَا وَوَصَبَہَا ، ثُمَّ قَالَ : قُمْ ، فَقَامَ : فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا رَأَی أَحَدُکُمْ مِنْ نَفْسِہِ، أَوْ مَالِہِ ، أَوْ أَخِیہِ ، مَا یُعْجِبُہُ ، فَلْیَدْعُ بِالْبَرَکَۃِ ، فَإِنَّ الْعَیْنَ حَقٌّ۔ (احمد ۴۴۷۔ حاکم ۲۱۵)","Da'if","Musannaf Ibn Abi Shaybah 24060","","","كتاب الطب"
"24061","(۲۴۰۶۱) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی أُمَامَۃَ بْنِ سَہْلٍ بن حُنَیفٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَامِرًا مَرَّ بِہِ وَہُوَ یَغْتَسِلُ ، فَقَالَ : مَا رَأَیْتُ کَالْیَوْمِ قَطُّ ، وَلاَ جِلْدَ مُخَبَّأَۃٍ ، فَلُبِطَ بِہِ حَتَّی مَا یَعْقِلُ لِشِدَّۃِ الْوَجَعِ ، فَأَخْبَرَ بِذَلِکَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَدَعَاہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَتَغَیَّظَ عَلَیْہِ ، وَقَالَ : قَتَلْتَہُ ، عَلاَمَ یَقْتُلُ أَحَدُکُمْ أَخَاہُ ؟ أَلاَ بَرَّکْتَ ؟ فَأَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِذَلِکَ ، فَقَالَ : اغْسِلُوہُ ، فَاغْتَسَلَ فَخَرَجَ مَعَ الرَّکْبِ۔\n وَقَالَ الزُّہْرِیُّ : إِنَّ ہَذَا مِنَ الْعِلْمِ ، غَسَلَ الَّذِی عَانَہُ ، قَالَ : یُؤْتَی بِقَدَحِ مَائٍ ، فَیُدْخِلُ یَدَہُ فِی الْقَدَحِ ، فَیُمَضْمِضُ وَیَمُجَّہُ فِی الْقَدَحِ ، وَیَغْسِلُ وَجْہَہُ فِی الْقَدَحِ ، ثُمَّ یَصُبُّ بِیَدِہِ الْیُسْرَی عَلَی کَفِّہِ الْیُمْنَی ، ثُمَّ بِیَدِہِ الْیُمْنَی عَلَی کَفِّہِ الْیُسْرَی ، وَیُدْخِلُ یَدَہُ الْیُسْرَی فَیَصُبُّ عَلَی مِرْفَقِ یَدِہِ الْیُمْنَی ، وَبِیَدِہِ الْیُمْنَی عَلَی مِرْفَقِ یَدِہِ الْیُسْرَی ، ثُمَّ یَغْسِلُ قَدَمہ الْیُمْنَی ثُمَّ یَغْسِلُ یَدَہُ الْیُمْنَی ، فَیَغْسِلُ قَدَمہ الْیُسْرَی ، ثُمَّ یَدَہُ الْیُمْنَی فَیَغْسِلُ الرُّکْبَتَیْنِ ، وَیَأْخُذُ دَاخِلَۃ إِزَارِہِ ، فَیَصُبُّ عَلَی رَأْسِہِ صَبَّۃً وَاحِدَۃً ، وَلاَ یَدَعُ الْقَدَحَ حَتَّی یَفْرُغَ۔\n(احمد ۳/۴۸۶۔ ابن حبان ۶۱۰۶)","Sahih","Musannaf Ibn Abi Shaybah 24061","","","كتاب الطب"
"24062","(۲۴۰۶۲) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا کَانَتْ تَأْمُرُ الْمَعِینَ أَنْ یَتَوَضَّأَ ، فَیَغْتَسِلَ الَّذِی أَصَابَتْہُ الْعَیْنُ۔","","Musannaf Ibn Abi Shaybah 24062","","","كتاب الطب"
"24063","(۲۴۰۶۳) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، قَالَ : حدَّثَنَا وُہَیْبٌ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْعَیْنُ حَقٌّ ، وَإِذَا اسْتُغْسِلَ فَلْیَغْتَسِلْ۔ (مسلم ۴۲۔ ابن حبان ۶۱۰۸)","Sahih","Musannaf Ibn Abi Shaybah 24063","","","كتاب الطب"
"24064","(۲۴۰۶۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ یَحْیَی ؛ أَنَّ الْوَلِیدَ بْنَ الْوَلِیدِ بْنِ الْمُغِیرَۃِ الْمَخْزُومِیَّ شَکَا إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَدِیثَ نَفْسٍ وَجَدَہ ، وَإِنَّہُ قَالَ : إِذَا أَتَیْتَ فِرَاشِکَ فَقُلْ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ غَضَبِہِ ، وَعِقَابِہِ ، وَشَرِّ عِبَادِہِ ، وَمِنْ ہَمَزَاتِ الشَّیَاطِینِ ، وَأَنْ یَحْضُرُونِ ، فَوَالَّذِی نَفْسِی بِیَدِہِ لاَ یَضُرُّک شَیْئٌ حَتَّی تُصْبِحَ۔ (ترمذی ۳۵۲۸۔ احمد ۴/۵۷)","","Musannaf Ibn Abi Shaybah 24064","","","كتاب الطب"
"24065","(۲۴۰۶۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ زَکَرِیَّا ، عَنْ مُصْعَبِ بْنِ شَیْبَۃَ ، عَنْ یَحْیَی بْنِ جَعْدَۃَ ، قَالَ : کَانَ خَالِدُ بْنُ الْوَلِیدِ یفْزَعُ مِنَ اللَّیْلِ حَتَّی یَخْرُجَ وَمَعَہُ سَیْفُہُ ، فَخُشِیَ عَلَیْہِ أَنْ یُصِیبَ أَحَدًا ، فَشَکَا ذَلِکَ إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : إِنَّ جِبْرِیلَ قَالَ لِی : إِنَّ عِفْرِیتًا مِنَ الْجِنِّ یَکِیدُکَ ، فَقُلْ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ الَّتِی لاَ یُجَاوِزُہنَّ بَرٌّ ، وَلاَ فَاجِرٌ مِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا ذَرَأَ فِی الأَرْضِ وَمَا یَخْرُجُ مِنْہَا ، وَمِنْ شَرِّ فِتَنِ اللَّیْلِ وَالنَّہَارِ ، وَمِنْ شَرِّ کُلِّ طَارِقٍ إِلاَّ طَارِقًا یَطْرُقُ بِخَیْرٍ یَا رَحْمَنُ ، فَقَالَہُنَّ خَالِد ، فَذَہَب ذَلِکَ عَنہُ۔","","Musannaf Ibn Abi Shaybah 24065","","","كتاب الطب"
"24066","(۲۴۰۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : حدَّثَنَا مَکْحُولٌ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَمَّا دَخَلَ مَکَّۃَ تَلَقَّتْہُ الْجِنُّ بِالشَّرَرِ یَرْمُونَہُ ، فَقَالَ جِبْرِیل : یَا مُحَمَّدُ ، تَعَوَّذ بِہَؤُلاَئِ الْکَلِمَاتِ : فَزُجِرُوا عَنْہُ ، فَقَالَ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّاتِ الَّتِی لاَ یُجَاوِزہُنَّ بَرٌّ ، وَلاَ فَاجِرٌ مِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا بُثَّ فِی الأَرْضِ وَمَا یَخْرُجُ مِنْہَا ، وَمِنْ شَرِّ فِتَنِ اللَّیْلِ وَالنَّہَارِ ، وَمِنْ شَرِّ کُلِّ طَارِقٍ إِلاَّ طَارِقًا یَطْرُقُ بِخَیْرٍ یَا رَحْمَنُ۔","","Musannaf Ibn Abi Shaybah 24066","","","كتاب الطب"
"24067","(۲۴۰۶۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْعَلاَئِ ، عَنْ عُثْمَانَ بْنِ أَبِی الْعَاصِ ؛ أَنَّہُ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنَّ الشَّیْطَانَ قَدْ حَالَ بَیْنَ صَلاَتِی وَبَیْنَ قِرَائَ تِی ، قَالَ : ذَلِکَ شَیْطَانٌ یُقَالُ لَہُ : خِنْزَبٌ ، فَإِذَا مَا أَحْسَسْتَہُ فَاتْفِلْ عَلَی یَسَارِکَ ثَلاَثًا ، وَتَعَوَّذْ بِاللَّہِ مِنْ شَرِّہِ۔\n(مسلم ۱۷۲۹۔ احمد ۴/۲۱۶)","Sahih","Musannaf Ibn Abi Shaybah 24067","","","كتاب الطب"
"24068","(۲۴۰۶۸) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَعْفَرُ بْنُ سُلَیْمَانَ ، قَالَ : حَدَّثَنَا أَبُو التَّیَّاحِ ، قَالَ : سَأَلَ رَجُلٌ عَبْدَ اللہِ بْنَ خَنْبَشٍ : کَیْفَ صَنَعَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ کَادَتْہُ الشَّیَاطِینُ ؟ قَالَ : جَائَ تِ الشَّیَاطِینُ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الأَوْدِیَۃِ ، وَتَحَدَّرَتْ عَلَیْہِ مِنَ الْجِبَالِ ، وَفِیہِمْ شَیْطَانٌ مَعَہُ شُعْلَۃٌ مِنْ نَارٍ ، یُرِیدُ أَنْ یُحَرِّقَ بِہَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأُرْعِبَ مِنْہُ ؟ قَالَ جَعْفَرٌ : أَحْسَبُہُ جَعَلَ یَتَأَخَّرُ ، وَجَائَ جِبْرِیلُ فَقَالَ : یَا مُحَمَّدُ ، قُلْ ، قَالَ : وَمَا أَقُولُ ؟ قَالَ : قُلْ : أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّاتِ الَّتِی لاَ یُجَاوِزُہُنَّ بَرٌّ ، وَلاَ فَاجِرٌ مِنْ شَرِّ مَا خَلَقَ ، وَذَرَأَ وَبَرَأَ ، وَمِنْ شَرِّ مَا یَنْزِلُ مِنَ السَّمَائِ ، وَمِنْ شَرِّ مَا یَعْرُجُ فِیہَا ، وَمِنْ شَرِّ مَا ذَرَأَ فِی الأَرْضِ ، وَمِنْ شَرِّ مَا یَخْرُجُ مِنْہَا ، وَمِنْ شَرِّ فِتَنِ اللَّیْلِ وَالنَّہَارِ ، وَمِنْ شَرِّ کُلِّ طَارِقٍ إِلاَّ طَارِقًا یَطْرُقُ بِخَیْرٍ یَا رَحْمَنُ، قَالَ : فَطُفِئَتْ نَارُ الشَّیَاطِینَ ، وَہَزَمَہُمَ اللَّہُ۔\n(احمد ۳/۴۱۹۔ ابویعلی ۶۸۴۴)","Hasan","Musannaf Ibn Abi Shaybah 24068","","","كتاب الطب"
"24069","(۲۴۰۶۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنَا الأَعْمَشُ ، عَنْ مُجَاہِدٍ ، قَالَ : کُنْتُ أَلْقَی مِنْ رُؤْیَۃِ الْغُولِ وَالشَّیَاطِینِ بَلاَئً وَأَرَی خَیَالاً ، فَسَأَلْتُ ابْنَ عَبَّاسٍ ؟ فَقَالَ : أَخْبِرنِی عَلَی مَا رَأَیْتَ ، وَلاَ تُفْرَقنَّ مِنْہُ ، فَإِنَّہُ یَفْرَقُ مِنْکَ کَمَا تَفْرَقُ مِنْہُ ، وَلاَ تَکُنْ أَجْبَنَ السَّوَادَیْنِ ، قَالَ مُجَاہِدٌ : فَرَأَیْتُہُ فَأَسْنَدْتُ عَلَیْہِ بِعَصَا حَتَّی سَمِعْتُ وَقْعَتَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24069","","","كتاب الطب"
"24070","(۲۴۰۷۰) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا ابْنَ عَوْنٍ ، عَنْ إِبْرَاہِیمَ النَّخَعِیِّ ، قَالَ : کَانُوا إِذَا رَأَی أَحَدُہُمْ فِی مَنَامِہِ مَا یَکْرَہُ ، قَالَ : أَعُوذُ بِمَا عَاذَتْ بِہِ مَلاَئِکَۃُ اللہِ وَرُسُلُہُ مِنْ شَرِّ مَا رَأَیْتُ فِی مَنَامِی ، أَنْ یُصِیبَنِیَ مِنْہُ شَیْئٌ أَکْرَہُہُ فِی الدُّنْیَا وَالآخِرَۃِ۔","","Musannaf Ibn Abi Shaybah 24070","","","كتاب الطب"
"24071","(۲۴۰۷۱) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا فَزِعَ أَحَدُکُمْ فِی نَوْمِہِ ، فَلْیَقُلْ : بِسْمِ اللہِ ، أَعُوذُ بِکَلِمَاتِ اللہِ التَّامَّۃِ مِنْ غَضَبِہِ ، وَسوء عِقَابِہِ ، وَشَرِّ عِبَادِہِ ، وَمِنْ شَرِّ الشَّیَاطِینِ وَمَا یَحْضُرُونِ۔","","Musannaf Ibn Abi Shaybah 24071","","","كتاب الطب"
"24072","(۲۴۰۷۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَخِیہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : إِذَا حَسَّ أَحَدُکُمْ بِالشَّیْطَانِ ، فَلْیَنْظُرْ إِلَی الأَرْضِ وَلْیَتَعَوَّذْ۔","","Musannaf Ibn Abi Shaybah 24072","","","كتاب الطب"
"24073","(۲۴۰۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَوَی سَعْدًا فِی أَکْحَلِہِ مَرَّتَیْنِ۔ (ابوداؤد ۳۸۶۲۔ ابن ماجہ ۳۴۹۴)","Sahih","Musannaf Ibn Abi Shaybah 24073","","","كتاب الطب"
"24074","(۲۴۰۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : دَخَلْنَا عَلَی خَبَّابٍ نَعُودُہُ ، وَقَدِ اکْتَوَی سَبْعًا فِی بَطْنِہِ۔ (بخاری ۵۶۷۲۔ ترمذی ۹۷۰)","Sahih","Musannaf Ibn Abi Shaybah 24074","","","كتاب الطب"
"24075","(۲۴۰۷۵) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ اکْتَوَی مِنَ اللَّقْوَۃِ ، وَاسْتَرْقَی مِنَ الْعَقْرَبِ۔","Sahih","Musannaf Ibn Abi Shaybah 24075","","","كتاب الطب"
"24076","(۲۴۰۷۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبْجَرَ ، عَنْ سَیَّارٍ ، عَنْ قَیْسٍ ، عَنْ جَرِیرٍ ، قَالَ: أَقْسَمَ عَلَیَّ عُمَرُ لأَکْتَوِیَنَّ۔","Hasan","Musannaf Ibn Abi Shaybah 24076","","","كتاب الطب"
"24077","(۲۴۰۷۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّہُ اکْتَوَی مِنَ اللَّقْوَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 24077","","","كتاب الطب"
"24078","(۲۴۰۷۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ ثَابِتٍ، عَنْ أَنَسٍ، قَالَ: کَوَانِی أَبُو طَلْحَۃَ، وَاکْتَوَی مِنَ اللَّقْوَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 24078","","","كتاب الطب"
"24079","(۲۴۰۷۹) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ مُحَمَّدِ بْنِ عَبْدِالرَّحْمَنِ بْنِ سَعْد بْنِ زُرَارَۃَ، سَمِعْتُ عَمِّی یَحْیَی، وَمَا أَدرَکتُ رَجلاً مِنَّا بِہِ شَبیہًا ، یُحَدِّث ، أَنَّ سَعْدَ بْنَ زُرَارَۃَ أَخَذَہُ وَجَعٌ فِی حَلْقِہِ ، یُقَالُ لَہُ : الذَّبْحُ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لأُبْلِغَنَّ ، أَوْ لأُبْلِیَنَّ فِی أَبِی أُمَامَۃَ عُذْرًا ، فَکَوَاہُ بِیَدِہِ ، فَمَاتَ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : میتَۃُ سَوْئٍ لِلْیَہُودِ ، یَقُولُونَ : فَہَلاَّ دَفَعَ عَنْ صَاحِبِہِ ، وَمَا أَمْلِکُ لَہُ وَلاَ لِنَفْسِی شَیْئًا۔\n(ابن ماجہ ۳۴۹۲۔ حاکم ۲۱۴)","Sahih","Musannaf Ibn Abi Shaybah 24079","","","كتاب الطب"
"24080","(۲۴۰۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ سَالِمِ بْنِ أَبِی حَفْصَۃَ ، عَنْ شَیْبَانَ اللَّحَّامِ ، قَالَ : کَوَانِی ابْنُ الْحَنَفِیَّۃِ فِی رَأْسِی۔","Da'if","Musannaf Ibn Abi Shaybah 24080","","","كتاب الطب"
"24081","(۲۴۰۸۱) حَدَّثَنَا عَبْدُ السَّلاَمِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ؛ أَنَّہُ دَخَلَ عَلَیْہِ وَقَدْ کَوَی غُلاَمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24081","","","كتاب الطب"
"24082","(۲۴۰۸۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنْ مُطَرِّفِ بْنِ شِخِّیرٍ ، قَالَ : کَانَ عِمْرَانُ بْنُ حُصَیْنٍ یَنْہَی عَنِ الْکَیِّ ، ثُمَّ اکْتَوَی بَعْدُ۔","Sahih","Musannaf Ibn Abi Shaybah 24082","","","كتاب الطب"
"24083","(۲۴۰۸۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عِمْرَانُ بْنُ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : کَانَ عِمْرَانُ بْنُ حُصَیْنٍ یَنْہَی عَنِ الْکَیِّ ، فَابْتُلِیَ فَاکْتَوَی ، فَجَعَلَ بَعْدَ ذَلِکَ یَعَجُّ ، وَیَقُولُ : اکْتَوَیْتُ کَیَّۃً بِنَارٍ ، مَا أَبْرَأَتْ مِنْ أَلَمٍ ، وَلاَ أَشْفَتْ مِنْ سَقَمٍ۔","Sahih","Musannaf Ibn Abi Shaybah 24083","","","كتاب الطب"
"24084","(۲۴۰۸۴) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الأَحْوَص ، عَنْ عَبْدِ اللہِ ، قَالَ : أُتِیَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِرَجُلٍ نُعِتَ لَہُ الْکَیُّ ، فَقَالَ لَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اُکْوُوہُ ، أَوْ ارْضِفُوہُ۔ (احمد ۱/۳۹۰۔ طبرانی ۱۰)","Sahih","Musannaf Ibn Abi Shaybah 24084","","","كتاب الطب"
"24085","(۲۴۰۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ سَعِیدِ بْنِ حَیَّانَ ، عَنْ سَیَّارٍ أَبِی حَمْزَۃَ ، عَنْ قَیْسٍ ، عَنْ جَرِیرٍ ، قَالَ : أَقْسَمَ عَلَیَّ عُمَرُ لأَکْتَوِیَنَّ۔","Hasan","Musannaf Ibn Abi Shaybah 24085","","","كتاب الطب"
"24086","(۲۴۰۸۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی الْعُمَیْسِ ، عَنِ الْحَسَنِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَتْ لِلْحَسَنِ بْنِ عَلِیٍّ بُخْتِیَّۃٌ ، قَدْ مَالَ سَنَامُہَا عَلَی جَنْبِہَا ، فَأَمَرَنِی أَنْ أَقْطَعَہُ وَأَکْوِیَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24086","","","كتاب الطب"
"24087","(۲۴۰۸۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّ ابْنَ عُمَرَ کَوَی ابْنًا لَہُ وَہُوَ مُحْرِمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 24087","","","كتاب الطب"
"24088","(۲۴۰۸۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : عُرِضَتْ عَلَیَّ الأُمَمُ ، فَإِذَا سَوَادٌ عَظِیمٌ ، فَقُلْتُ : ہَذِہِ أُمَّتِی ؟ فَقِیلَ : ہَذَا مُوسَی وَقَوْمُہُ ، قَالَ : ثُمَّ قِیلَ لِی : اُنْظُرْ إِلَی الأُفُقِ ، فَنَظَرْتُ فَإِذَا سَوَادٌ قَدْ مَلأَ الأُفُقَ ، قَالَ : فَقِیلَ : ہَذِہِ أُمَّتُکَ ، وَیَدْخُلُ الْجَنَّۃَ سِوَاہَا سَبْعُونَ أَلْفًا بِغَیْرِ حِسَابٍ۔\n ثُمَّ دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَلَمْ یُبَیِّنْ لَہُمْ ، فَأَفَاضَ الْقَوْمُ ، فَقَالُوا : نَحْنُ الَّذِینَ آمَنَّا بِاللَّہِ وَاتَّبَعْنَا رَسُولَہُ ، فَنَحْنُ ہُمْ ، أَوْ أَوْلاَدُنَا الَّذِینَ وُلِدُوا فِی الإِسْلاَمِ ، قَالَ : فَبَلَغَ ذَلِکَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : ہُمُ الَّذِینَ لاَ یَسْتَرْقُونَ ، وَلاَ یَتَطَیَّرُونَ ، وَلاَ یَکْتَوُونَ ، وَعَلَی رَبِّہِمْ یَتَوَکَّلُونَ۔\n(بخاری ۶۵۴۱۔ مسلم ۳۷۴)","Sahih","Musannaf Ibn Abi Shaybah 24088","","","كتاب الطب"
"24089","(۲۴۰۸۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : اشْتَکَی رَجُلٌ مِنَّا شَکْوَی شَدِیدَۃً ، فَقَالَ الأَطِبَّائُ : لاَ یَبْرَأُ إِلاَّ بِالْکَیِّ ، فَأَرَادَ أَہْلُہُ أَنْ یَکْوُوہُ ، فَقَالَ بَعْضُہُمْ : لاَ ، حَتَّی نَسْتَأْمِرَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَاسْتَأْمَرُوہُ ، فَقَالَ : لاَ ، فَبَرِأَ الرَّجُلُ ، فَلَمَّا رَآہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : ہَذَا صَاحِبُ بَنِی فُلاَنٍ ؟ قَالُوا : نَعَمْ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ ہ??ذَا لَوْ کُوِیَ ، قَالَ النَّاسُ : إِنَّمَا أَبْرَأَہُ الْکَیُّ۔","Da'if","Musannaf Ibn Abi Shaybah 24089","","","كتاب الطب"
"24090","(۲۴۰۹۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ حَسَّانَ بْنِ أَبِی وَجْزَۃَ ، قَالَ : حدَّثَنِی عَقَّارٌ ، عَنْ أَبِیہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ قَالَ : لَمْ یَتَوَکَّلْ مَنِ اسْتَرْقَی وَاکْتَوَی۔\n(ترمذی ۲۰۵۵۔ احمد ۴/۲۵۱)","Hasan","Musannaf Ibn Abi Shaybah 24090","","","كتاب الطب"
"24091","(۲۴۰۹۱) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، قَالَ : حدَّثَنَا شَیْبَانُ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ، عَنِ ابْنِ مَسْعُودٍ : قَالَ : تَحَدَّثْنَا عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَاتَ لَیْلَۃٍ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: سَبْعُونَ أَلْفًا یَدْخُلُونَ الْجَنَّۃَ لاَ حِسَابَ عَلَیْہِمْ : الَّذِینَ لاَ یَکْتَوُونَ ، وَلاَ یَسْتَرْقُونَ ، وَلاَ یَتَطَیَّرُونَ ، وَعَلَی رَبِّہِمْ یَتَوَکَّلُونَ۔ (بخاری ۹۱۱۔ طبرانی ۹۷۶۹)","Hasan","Musannaf Ibn Abi Shaybah 24091","","","كتاب الطب"
"24092","(۲۴۰۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : مَنِ اکْتَوَی کَیَّۃً بِنَارٍ خَاصَمَ فِیہِ الشَّیْطَانُ۔","","Musannaf Ibn Abi Shaybah 24092","","","كتاب الطب"
"24093","(۲۴۰۹۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : أَخَذَتْنِی ذَاتُ الْجَنْبِ فِی زَمَنِ عُمَرَ ، فَدُعِی رَجُلٌ مِنَ الْعَرَبِ أَنْ یَکْوِیَنِی ، فَأَبَی إِلاَّ أَنْ یَأْذَنَ لَہُ عُمَرُ ، فَذَہَبَ أَبِی إِلَی عُمَرَ ، فَأَخْبَرَہُ الْقِصَّۃَ ، فَقَالَ عُمَرُ : لاَ تَقْربِ النَّارَ ، فَإِنَّ لَہُ أَجَلاً لَنْ یَعْدُوَہُ ، وَلَنْ یَقْصُرَ عَنْہُ۔","Hasan","Musannaf Ibn Abi Shaybah 24093","","","كتاب الطب"
"24094","(۲۴۰۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جَعْفَرٍ ، عَنْ عِمْرَانَ بْنِ أَبِی أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنْہَی عَنِ الْحَمِیمِ ، وَأَکْرَہُ الْکَیَّ۔ (احمد ۴/۱۵۶۔ طبرانی ۱۷)","Da'if","Musannaf Ibn Abi Shaybah 24094","","","كتاب الطب"
"24095","(۲۴۰۹۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : بَعَثَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی أُبَیِّ بْنِ کَعْبٍ طَبِیبًا ، فَقَطَعَ مِنْہُ عِرْقًا ، ثُمَّ کَوَاہُ عَلَیْہِ۔ (مسلم ۷۳۔ ابوداؤد ۳۸۶۰)","Hasan","Musannaf Ibn Abi Shaybah 24095","","","كتاب الطب"
"24096","(۲۴۰۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَکِینٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عِمْرَانَ بْنِ حُصَیْنٍ ؛ أَنَّہُ قَطَعَ الْعُرُوقَ۔","Hasan","Musannaf Ibn Abi Shaybah 24096","","","كتاب الطب"
"24097","(۲۴۰۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَکِینٍ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ عِنْدَ مَائِی ، فَقُلْتُ لَہُ : أَیَّ شَیْئٍ تَصْنَعُ ہَاہُنَا ؟ فَقَالَ : أَقَطْعُ عِرْقَ کَذَا لابْنِ أَخِی۔","","Musannaf Ibn Abi Shaybah 24097","","","كتاب الطب"
"24098","(۲۴۰۹۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، قَالَ : سَمِعْتُ مُجَاہِدًا یَقُولُ : قُطِعَتْ مِنِّی عِرْقٌ ، أَوْ عُرُوقٌ۔","","Musannaf Ibn Abi Shaybah 24098","","","كتاب الطب"
"24099","(۲۴۰۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، قَالَ : رَأَیْتُ عُرْوَۃَ أَصَابَہُ ہَذَا الدَّائُ ، یَعْنِی الأَکِلَۃَ ، فَقَطَعَ رِجْلَہُ مِنَ الرُّکْبَۃِ۔","","Musannaf Ibn Abi Shaybah 24099","","","كتاب الطب"
"24100","(۲۴۱۰۰) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبْجَر ، عَنْ عَامِرٍ ، قَالَ : یُمْسَحُ عَلَی الْعِرقِ۔","","Musannaf Ibn Abi Shaybah 24100","","","كتاب الطب"
"24101","(۲۴۱۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ الْبَطَّ ، وَقَطْعَ الْعُرُوقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24101","","","كتاب الطب"
"24102","(۲۴۱۰۲) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ ثَابِتٍ ، عَنِ أَبِی رَافِعٍ ، قَالَ : رَآنِی عُمَرُ مَعْصُوبَۃً یَدَیَّ ، أَوْ رِجْلِیَّ ، فَانْطَلَقَ بِی إِلَی الطَّبِیبِ ، فَقَالَ : بُطَّہُ ، فَإِنَّ الْمِدَّۃَ إِذَا تُرِکَتْ بَیْنَ الْعَظْمِ وَاللَّحْمِ أَکَلَتْہُ ، قَالَ : فَکَانَ الْحَسَنُ یَکْرَہُ الْبَطَّ۔","Sahih","Musannaf Ibn Abi Shaybah 24102","","","كتاب الطب"
"24103","(۲۴۱۰۳) حَدَّثَنَا مُعْتَمر، عَنِ ابْنِ عَوْنٍ، عَنِ الْحَسَنِ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَبُطَّ الْجُرْحَ ، وَیَقُولُ: یُوضَعُ عَلَیْہِ دَوَائٌ۔","","Musannaf Ibn Abi Shaybah 24103","","","كتاب الطب"
"24104","(۲۴۱۰۴) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یَکْرَہُ قَطْعَ اللَّہَاۃِ ، وَلاَ أُرَاہُ کَرِہَہُ لِشَیْئٍ مِنَ الدِّینِ۔","","Musannaf Ibn Abi Shaybah 24104","","","كتاب الطب"
"24105","(۲۴۱۰۵) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنْ سَہْلٍ أَبِی الأَسَدِ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، قَالَ : جَائَ ظِِئْرٌ لَنَا إِلَی عَبْدِ اللہِ بِصَبِیٍّ لَہُمْ قَدْ سَقَطَتْ لَہَاتُہُ ، فَأَرَادُوا أَنْ یَقْطَعُوہَا ، فَقَالَ ابْنُ مَسْعُودٍ : لاَ تَقْطَعُوہَا ، وَلَکِنْ إِنْ کَانَ فِی أَجَلِہِ تَأْخِیرٌ بَرَأَ ، وَإِلاَّ لَمْ تَکُونُوا قَطَعْتُمُوہَا۔","Sahih","Musannaf Ibn Abi Shaybah 24105","","","كتاب الطب"
"24106","(۲۴۱۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْمُخْتَارِ ، قَالَ : سُئِلَ الْحَسَنُ عَنْ أَلْبَانِ الأُتُنِ ؟ فَقَالَ : حَرَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لُحُومَہَا وَأَلْبَانَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 24106","","","كتاب الطب"
"24107","(۲۴۱۰۷) حَدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لُحُومُ الحُمُرِ وَأَلْبَانُہَا حَرَامٌ۔","","Musannaf Ibn Abi Shaybah 24107","","","كتاب الطب"
"24108","(۲۴۱۰۸) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بِشُرْبِ أَلْبَانِ الأُتُنِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24108","","","كتاب الطب"
"24109","(۲۴۱۰۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا یَکْرَہَانِ أَنْ یُتَدَاوَی بِأَلْبَانِ الأُتُنِ ، وَقَالاَ : ہِیَ حَرَامٌ۔","","Musannaf Ibn Abi Shaybah 24109","","","كتاب الطب"
"24110","(۲۴۱۱۰) حَدَّثَنَا عُبَیْدُ اللہِ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ، عَنْ مُجَاہِدٍ ، قَالَ: سَأَلْتُُہُ عَنْ شُرْبِ أَلْبَانِ الأُتُنِ؟ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 24110","","","كتاب الطب"
"24111","(۲۴۱۱۱) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إِسْرَائِیلَ ، عَنْ مَجْزَأَۃَ بْنِ زَاہِرٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ اشْتَکَی رُکْبَتَیْہِ ،فَنُعِتَ لَہُ أَنْ یَسْتَنْقِعَ فِی أَلْبَانِ الأُتُنِ ، فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 24111","","","كتاب الطب"
"24112","(۲۴۱۱۲) حَدَّثَنَا یَحْیَی بْنُ سُلَیْمٍ الطَّائِفِیُّ ، عَنْ إِسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ عَطَائٍ ، قَالَ : کَانَ لاَ یَرَی بِأَلْبَانِ الأُتُنِ بَأْسًا أَنْ یُتَدَاوَی بِہَا۔","","Musannaf Ibn Abi Shaybah 24112","","","كتاب الطب"
"24113","(۲۴۱۱۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنْ أَلْبَانِ الأُتُنِ ؟ فَقَالاَ : مَنْ کَرِہَ لُحُومَہَا کَرِہَ أَلْبَانَہَا۔","","Musannaf Ibn Abi Shaybah 24113","","","كتاب الطب"
"24114","(۲۴۱۱۴) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ إِبْرَاہِیمَ ؛ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 24114","","","كتاب الطب"
"24115","(۲۴۱۱۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حَجَّاجِ بْنِ أَبِی عُثْمَانَ ، قَالَ : حدَّثَنِی أَبُو رَجَائٍ ، مَوْلَی أَبِی قِلاَبَۃَ ، عَنْ أَبِی قِلاَبَۃَ، قَالَ : حَدَّثَنِی أَنَسُ بْنُ مَالِکٍ ؛ أَنَّ نَفَرًا مِنْ عُکَلٍ ثَمَانِیَۃً قَدِمُوا عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَبَایَعُوہُ عَلَی الإِسْلاَمِ ، فَاسْتَوْخَمُوا الأَرْضَ ، وَسَقِمَتْ أَجْسَادُہُمْ ، فَشَکَوْا ذَلِکَ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : أَلاَ تَخْرُجُون مَعَ رَاعِینَا فِی إِبِلِہِ فَتُصِیبُوا مِنْ أَبْوَالِہَا وَأَلْبَانِہَا ؟ قَالُوا : بَلَی ، فَخَرَجُوا فَشَرِبُوا مِنْ أَبْوَالِہَا وَأَلْبَانِہَا۔ (بخاری ۶۸۹۹۔ مسلم ۱۲)","Sahih","Musannaf Ibn Abi Shaybah 24115","","","كتاب الرد على أبي حنيفة"
"24116","(۲۴۱۱۶) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِیُّ ، عَنْ لَیْثٍ ، عَنِ ابْنِ طَاوُوسٍ ؛ أَنَّ أَبَاہُ کَانَ یَشْرَبُ أَبْوَالَ الإِبِلِ وَیَتَدَاوَی بِہَا۔","","Musannaf Ibn Abi Shaybah 24116","","","كتاب الرد على أبي حنيفة"
"24117","(۲۴۱۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ بَأْسَ بِأَبْوَالِ الإِبِلِ أَنْ یُتَدَاوَی بِہَا۔","","Musannaf Ibn Abi Shaybah 24117","","","كتاب الرد على أبي حنيفة"
"24118","(۲۴۱۱۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَہَا۔","","Musannaf Ibn Abi Shaybah 24118","","","كتاب الرد على أبي حنيفة"
"24119","(۲۴۱۱۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ یُسْأَلُ عَنْ شُرْبِ أَبْوَالِ الإِبِلِ ؟ فَیَقُولُ : لاَ أَدْرِی مَا ہَذَا ؟۔","","Musannaf Ibn Abi Shaybah 24119","","","كتاب الرد على أبي حنيفة"
"24120","(۲۴۱۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : کَانَ جُبَارٌ الْمَشْرَقِیُّ یَصِفُ أَبْوَالَ الإِبِلِ ، وَلَوْ کَانَ بِہِ بَأْسٌ لَمْ یَصِفْہَا۔","","Musannaf Ibn Abi Shaybah 24120","","","كتاب الرد على أبي حنيفة"
"24121","(۲۴۱۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَنْشَقَ أَبْوَالَ الإِبِلِ۔","","Musannaf Ibn Abi Shaybah 24121","","","كتاب الرد على أبي حنيفة"
"24122","(۲۴۱۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ حَبِیبَۃَ بِنْتِ یَسَارٍ ، عَنْ أُمِّہَا ، عَنْ عَائِشَۃَ ؛ أَنَّہَا سُئِلَتْ عَنِ الصَّبِیِّ یُنقَعُ فِی الْبَوْلِ ، أَوْ یُوْجَرُ ؟ فَکَرِہَتْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24122","","","كتاب الرد على أبي حنيفة"
"24123","(۲۴۱۲۳) حَدَّثَنَا الْفَضْلُ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : کَانَ رَجُلٌ بِہِ خَنَازِیرٌ ، فَتَدَاوی بِأَبْوَالِ الإِبِلِ وَالأَرَاکِ ، تُطْبَخُ أَبْوَالُ الإِبِلِ وَالأَرَاکُ ، فَأَخَذَ النَّاسُ یَسْأَلُونَہُ فَیَأْبَی ، فَلَقِیَ ابْنَ مَسْعُودٍ فَقَالَ : أَخْبِرِ النَّاسَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 24123","","","كتاب الرد على أبي حنيفة"
"24124","(۲۴۱۲۴) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ مَکْحُولٍ ، وَعَبْدَۃُ ، عَنْ أُمِّ عَبْدِ اللہِ ابْنَۃِ خَالِدِ بْنِ مَعْدَانَ ، عَنْ أَبِیہَا ؛ أَنَّہُ کَانَ لاَ یَرَی بِشُرْبِ التِّرْیَاقِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 24124","","","كتاب الطب"
"24125","(۲۴۱۲۵) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ صَفْوَانَ بْنِ عَمْرٍو السَّکْسَکِیِّ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ لَمَّا وَلَّی الْوَلِیدَ بْنَ ہِشَامٍ الْقُرَشِیَّ ، وَعَمْرَو بْنَ قَیْسٍ السَّکُونِیَّ بَعَثَ الصَّائِفَۃَ ، زَوَّدَہُمَا التِّرْیَاقَ مِنَ الْخَزَائِنِ ، وَأَمَرَہُمَا أَنَّ مَنْ جَائَ یَلْتَمِسُ التِّرْیَاقَ أَنْ یُعْطُوہُ إِیَّاہُ۔","","Musannaf Ibn Abi Shaybah 24125","","","كتاب الطب"
"24126","(۲۴۱۲۶) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، قَالَ : وَصَفَ لِی أَبُو قِلاَبَۃَ صِفَۃَ التِّرْیَاقِ ، فَقَالَ : یَخْرُجُ رِجَالٌ عَلَیْہِمْ خِفَافٌ مِنْ خَشَبٍ ، وَبِأَیْدِیہِمْ شَیْئٌ قَدْ ذَکَرَہُ ، فَیَصِیدُونَ الْحَیَّاتِ ، فَیَمْسَحُونَ مَا یَلِی رُؤُوسَہَا وَأَذْنَابَہَا ، لِیَجْمع مَا کَانَ مِنْ دَمٍ ، ثُمَّ یَطْرَحُونَہَا فِی الْقِدْرِ فَیَطْبُخُونَہَا ، فَذَاکَ أَجْوَدُ التِّرْیَاقِ۔","","Musannaf Ibn Abi Shaybah 24126","","","كتاب الطب"
"24127","(۲۴۱۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : ذَکَرْتُہُ لَہُ ، فَقَالَ : أَوَلَیْسَ قَدْ نُہِیَ عَنْ کُلِّ ذِی نَابٍ ؟ فَہِیَ ذَاتُ أَنْیَابٍ وَحُمَۃٍ۔","","Musannaf Ibn Abi Shaybah 24127","","","كتاب الطب"
"24128","(۲۴۱۲۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أَمَرَ ابْنُ عُمَرَ بِالتِّرْیَاقِ فَسُقِیَ ، وَلَوْ عَلِمَ مَا فِیہِ مَا أَمَرَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 24128","","","كتاب الطب"
"24129","(۲۴۱۲۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَرِہَہُ ، یَعْنِی التِّرْیَاقَ۔","No Data Available","Musannaf Ibn Abi Shaybah 24129","","","كتاب الطب"
"24130","(۲۴۱۳۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنِ الْحَسَنِ ، قَالَ : سَمِعْتُہُ وَسُئِلَ عَنِ التِّرْیَاقِ ، وَقِیلَ لَہُ: إِنَّہُ یُجْعَلُ فِیہِ الأَوْزَاغُ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 24130","","","كتاب الطب"
"24131","(۲۴۱۳۱) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، قَالَ : حدَّثَنَا سَعِیدُ بْنُ أَبِی أَیُّوبَ ، قَالَ : حَدَّثَنَا شرَاحْیلُ بْنُ یزید الْمَعَافِرِیُّ ، قَالَ : سَمِعْتُ عَبْدَ الرَّحْمَن بْنَ رَافِعٍ التَّنُوخِیَّ یَقُولُ : سَمِعْتُ عَبْدَ اللہِ بْنَ عَمْرٍو یَقُولُ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا أُبَالِی مَا أَتَیْتُ ، وَمَا ارْتَکَبْتُ إِنْ أَنَا شَرِبْتُ تِرْیَاقًا ، أَوْ تَعَلَّقْتُ تَمِیمَۃً ، أَوْ قُلْتُ شِعْرًا مِنْ قِبَلِ نَفْسِی۔ (احمد ۲/۲۲۳۔ ابوداؤد ۳۸۶۵)","Da'if","Musannaf Ibn Abi Shaybah 24131","","","كتاب الطب"
"24132","(۲۴۱۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ رِزَامِ بْنِ سَعِیدٍ ، عَنْ أَبِی الْمَعَارِکِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ یَمْنَعنَّ أَحَدُکُمْ مَرِیضًا طَعَامًا یَشْتَہِیہِ ، لَعَلَّ اللَّہَ أَنْ یَشْفِیَہُ ، فَإِنَّ اللَّہَ یَجْعَلُ شِفَائَ ہُ حَیْثُ شَائَ ۔","Da'if","Musannaf Ibn Abi Shaybah 24132","","","كتاب الطب"
"24133","(۲۴۱۳۳) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا فُلَیْحُ بْنُ سُلَیْمَانَ ، عَنْ أَیُّوبَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ بْنِ أَبِی صَعْصَعَۃَ ، عَنْ یَعْقُوب بْن أَبِی یَعْقُوب ، عَنْ أُمِّ الْمُنْذِرِ الْعَدَوِیَّۃِ ، قَالَتْ : دَخَلَ عَلَیَّ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَمَعَہُ عَلِیٌّ وَہُوَ نَاقِہٌ ، وَلَنَا دَوَالِی مُعَلَّقَۃٌ ، قَالَتْ : فَقَامَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَکَلَ ، وَقَامَ عَلِیٌّ فَأَکَلَ ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَہْلاً فَإِنَّک نَاقِہٌ ، قَالَ : فَجَلَسَ عَلِیٌّ ، وَأَکَلَ مِنْہَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، ثُمَّ صَنَعْتُ لَہُمْ سِلْقًا وَشَعِیرًا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لِعَلِیٍّ : مِنْ ہَذَا أَصِبْ۔ (ابوداؤد ۳۸۵۲۔ ترمذی ۲۰۳۷)","Hasan","Musannaf Ibn Abi Shaybah 24133","","","كتاب الطب"
"24134","(۲۴۱۳۴) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : أُہْدِیَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قِنَاعٌ مِنْ تَمْرٍ ، وَعَلِیٌّ مَحْمُومٌ ، قَالَ : فَنَبَذَ إِلَیْہِ تَمْرَۃً ، ثُمَّ أُخْرَی ، حَتَّی نَاوَلَہُ سَبْعًا ، ثُمَّ کَفَّ یَدَہُ ، وَقَالَ : حَسْبُکَ۔","","Musannaf Ibn Abi Shaybah 24134","","","كتاب الطب"
"24135","(۲۴۱۳۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْحُمَّی مِنْ فَیْحِ جَہَنَّمَ ، فَأَبْرِدُوہَا بِالْمَائِ ۔ (بخاری ۳۲۶۳۔ مسلم ۸۱)","Sahih","Musannaf Ibn Abi Shaybah 24135","","","كتاب الطب"
"24136","(۲۴۱۳۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ فَاطِمَۃَ ، عَنْ أَسْمَائَ ؛ أَنَّہَا کَانَتْ تُؤْتَی بِالْمَرْأَۃِ الْمَوْعُوکَۃِ ، فَتَدْعُو بِالْمَائِ فَتَصُبَّہُ فِی جَیْبِہَا ، وَتَقُولُ : إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : أَبْرِدُوہَا بِالْمَائِ ، فَإِنَّہَا مِنْ فَیْحِ جَہَنَّمَ۔ (ابن ماجہ ۳۴۷۴۔ مسلم ۱۷۳۲)","Sahih","Musannaf Ibn Abi Shaybah 24136","","","كتاب الطب"
"24137","(۲۴۱۳۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ عَبَایَۃَ بْنِ رِفَاعَۃَ ، قَالَ : أَخْبَرَنِی رَافِعُ بْنُ خَدِیجٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْحُمَّی مِنْ فَوْرِ جَہَنَّمَ ، فَأَبْرِدُوہَا بِالْمَائِ ۔\n(مسلم ۱۷۳۳۔ بخاری ۵۷۲۶)","Sahih","Musannaf Ibn Abi Shaybah 24137","","","كتاب الطب"
"24138","(۲۴۱۳۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَمُحَمَّدُ بْنُ بِشْرٍ ، قَالاَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنَّ شِدَّۃَ الْحُمَّی مِنْ فَیْحِ جَہَنَّمَ ، فَأَبْرِدُوہَا بِالْمَائِ ۔ (بخاری ۳۲۶۴۔ مسلم ۷۸)","Sahih","Musannaf Ibn Abi Shaybah 24138","","","كتاب الطب"
"24139","(۲۴۱۳۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، عَنْ أَبِی جَمْرَۃَ ، قَالَ : کُنْتُ أَدْفَعُ النَّاسَ عَنِ ابْنِ عَبَّاسٍ ، فَاحْتُبِسْتُ أَیَّامًا ، فَقَالَ : مَا حَبَسَکَ ؟ قُلْتُ : الْحُمَّی ، قَالَ : إِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنَّ الْحُمَّی مِنْ فَیْحِ جَہَنَّمَ ، فَأَبْرِدُوہَا بِمَائِ زَمْزَمَ۔ (احمد ۱/۲۹۱۔ حاکم ۴۰۳)","Sahih","Musannaf Ibn Abi Shaybah 24139","","","كتاب الطب"
"24140","(۲۴۱۴۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنِ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ إِذَا حُمَّ بَلَّ ثَوْبَہُ ، ثُمَّ لَبِسَہُ ، ثُمَّ قَالَ : إِنَّہَا مِنْ فَیْحِ جَہَنَّمَ ، فَأَبْرِدُوہَا بِالْمَائِ ۔","Da'if","Musannaf Ibn Abi Shaybah 24140","","","كتاب الطب"
"24141","(۲۴۱۴۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عَبَّادُ بْنُ مَنْصُورٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : خَیْرُ یَوْمٍ تَحْتَجِمُونَ فِیہِ سَبْعَ عَشْرَۃَ ، وَتِسْعَ عَشْرَۃَ ، وَإِحْدَی وَعِشْرِینَ۔ (ترمذی ۲۰۵۳۔ احمد ۱/۳۵۴)","Da'if","Musannaf Ibn Abi Shaybah 24141","","","كتاب الطب"
"24142","(۲۴۱۴۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، وَیَزِیدُ بْنُ ہَارُونَ ، عَنْ عَاصِمٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَان یُعْجبُہُ أَن یَحْتَجِم مِنَ السَبْع عَشرَۃَ إِلَی العِشْرِینَ۔","","Musannaf Ibn Abi Shaybah 24142","","","كتاب الطب"
"24143","(۲۴۱۴۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ مَکْحُولٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنِ احْتَجَمَ یَوْمَ الأَرْبِعَائِ ، وَیَوْمَ السَّبْتِ ، فَأَصَابَہُ وَضَحٌ فَلاَ یَلُومَنَّ إِلاَّ نَفْسَہُ۔ (حاکم ۴۰۹۔ ابن ماجہ ۳۴۸۷)","Da'if","Musannaf Ibn Abi Shaybah 24143","","","كتاب الطب"
"24144","(۲۴۱۴۴) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ کَانَ مُحْتَجِمًا ، فَلْیَحْتَجِمْ یَوْمَ السَّبْتِ۔","Da'if","Musannaf Ibn Abi Shaybah 24144","","","كتاب الطب"
"24145","(۲۴۱۴۵) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ أَمْثَلَ مَا تَدَاوَیْتُمْ بِہِ ، الْحِجَامَۃُ ، وَالْقُسْطُ الْہِنْدِیُّ لِصِبْیَانِکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 24145","","","كتاب الطب"
"24146","(۲۴۱۴۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الشَّیْبَانِیِّ ، عَنْ یُسَیْرِ بْنِ عَمْرٍو ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِی الْحَجْمِ شِفَائٌ۔","Sahih","Musannaf Ibn Abi Shaybah 24146","","","كتاب الطب"
"24147","(۲۴۱۴۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالُوا : طُبَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَبَعَثَ إِلَی رَجُلٍ فَحَجَمَہُ۔","","Musannaf Ibn Abi Shaybah 24147","","","كتاب الطب"
"24148","(۲۴۱۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : دَخَلَ عُیَیْنَۃُ بْنُ حِصْنٍ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَحْتَجِم ، فَقَالَ : مَا ہَذَا ؟ قَالَ : خَیْرُ مَا تَدَاوَتْ بِہِ الْعَرَبُ۔","","Musannaf Ibn Abi Shaybah 24148","","","كتاب الطب"
"24149","(۲۴۱۴۹) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنْ کَانَ فِی شَیْئٍ مِمَّا تُدَاوَوْا بِہِ خَیْرٌ ، فَفِی الْحِجَامَۃِ۔\n(ابوداؤد ۲۰۹۵۔ احمد ۲/۴۲۳)","Hasan","Musannaf Ibn Abi Shaybah 24149","","","كتاب الطب"
"24150","(۲۴۱۵۰) حَدَّثَنَا أَبُو نُعَیْمٍ ، عَنْ زُہَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : حدَّثَنِی حُصَیْنُ بْنُ أَبِی الْحُرِّ ، عَنْ سَمُرَۃَََ بْنِ جُنْدُبٍ ، قَالَ : کُنْتُ عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَدَعَا حَجَّامًا ، فَأَمَرَہُ أَنْ یَحْجُمَہُ ، فَأَخْرَجَ مَحَاجِمَ مِنْ قُرُونٍ ، فَأَلْزَمَہَا إِیَّاہُ ، وَشَرَطَہُ بِطَرَفِ شَفْرَۃٍ ، فَصَبَّ الدَّمُ وَأَنَا عِنْدَہُ ، فَدَخَلَ عَلَیْہِ رَجُلٌ مِنْ بَنِی فَزَارَۃَ ، فَقَالَ : مَا ہَذَا یَا رَسُولَ اللہِ ؟ عَلاَمَ تُمَکِّنُ ہَذَا مِنْ جِلْدِکَ یَقْطَعُہُ ، قَالَ : فَسَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : ہَذَا الْحَجْمُ ، قَالَ : وَمَا الْحَجْمُ ؟ قَالَ : مِن خَیْرِ مَا تَدَاوَی بِہِ النَّاسُ۔\n(حاکم ۲۰۸۔ احمد ۵/۹ )","Sahih","Musannaf Ibn Abi Shaybah 24150","","","كتاب الطب"
"24151","(۲۴۱۵۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عَبَّادُ بْنُ مَنْصُورٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا مَرَرْتُ بِمَلَاٍ مِنَ الْمَلاَئِکَۃِ لَیْلَۃَ أُسْرِیَ بِی إِلاَّ قَالُوا : عَلَیْکَ بِالْحِجَامَۃِ یَا مُحَمَّدُ۔ (ترمذی ۲۰۵۳۔ ابن ماجہ ۳۴۷۷)","Da'if","Musannaf Ibn Abi Shaybah 24151","","","كتاب الطب"
"24152","(۲۴۱۵۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ مِنْ بَنِی سَلِمَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنْ کَانَ فِی شَیْئٍ مِمَّا تُعَالِجُونَ بِہِ شِفَائٌ ، فَفِی شَرْطَۃٍ مِنْ مِحْجَمٍ ، أَوْ فِی شَرْبَۃٍ مِنْ عَسَلٍ ، أَوْ لَذْعَۃٍ مِنْ نَارٍ یُصِیبُ بِہَا أَلْمًا ، وَمَا أُحِبُّ أَنْ أَکْتَوِیَ۔","","Musannaf Ibn Abi Shaybah 24152","","","كتاب الطب"
"24153","(۲۴۱۵۳) حَدَّثَنَا الْفَضْلُ ، قَالَ : حَدَّثَنَا ابْنُ الْغَسِیلِ ، عَنْ عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَۃَ ، قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللہِ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إِنْ کَانَ فِی شَیْ??ٍ مِنْ أَدْوِیَتِکُمْ خَیْرٌ ، فَفِی شَرْطَۃِ مِحْجَمٍ ، أَوْ فِی شَرْبَۃٍ مِنْ عَسَلٍ ، أَوْ لَذْعَۃٍ بِنَارٍ تُوَافِقُ الدَّائَ ، وَمَا أُحِبُّ أَنْ أَکْتَوِیَ۔\n(بخاری ۵۶۸۳۔ مسلم ۷۱)","Sahih","Musannaf Ibn Abi Shaybah 24153","","","كتاب الطب"
"24154","(۲۴۱۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ شُعْبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی الْمُتَوَکِّلِ النَّاجِی ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : جَائَ رَجُلٌ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : یَا رَسُولَ اللہِ ، إِنَّ أَخِی اسْتَطْلَقَ بَطْنُہُ ، قَالَ : اسْقِہِ عَسَلاً ، فَسَقَاہُ ، فَأَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، إِنِّی سَقَیْتُہُ فَلَمْ یَزِدْہُ إِلاَّ اسْتِطْلاَقًا ، قَالَ : اسْقِہِ عَسَلاً ، فَسَقَاہُ ، فَأَتَی رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا رَسُولَ اللہِ ، إِنِّی سَقَیْتُہُ فَلَمْ یَزِدْہُ إِلاَّ اسْتِطْلاَقًا ، قَالَ: اسْقِہِ عَسَلاً ، فَإِمَّا فِی الثَّالِثَۃِ ، وَإِمَّا فِی الرَّابِعَۃِ حَسِبْتَہُ قَالَ: فَشُفِیَ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : صَدَقَ اللَّہُ ، وَکَذَبَ بَطْنُ أَخِیکَ۔ (بخاری ۵۶۸۴۔ مسلم ۹۱)","Sahih","Musannaf Ibn Abi Shaybah 24154","","","كتاب الطب"
"24155","(۲۴۱۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ یَعْفُور بْنِ الْمُغِیرَۃ ، عَنْ علِیٍّ ، قَالَ : إِذَا اشْتَکَی أَحَدُکُمْ شَیْئًا فَلْیَسْأَلِ امْرَأَتَہُ ثَلاَثَۃَ دَرَاہِمَ مِنْ صَدَاقِہَا ، فَیَشْتَرِی بِہِ عَسَلاً ، فَیَشْرَبْہُ بِمَائِ السَّمَائِ ، فَیَجْمَعُ اللَّہُ الْہَنِیئَ الْمَرِیئَ ، وَالْمَائَ الْمُبَارَکَ ، وَالشِّفَائَ ۔","Da'if","Musannaf Ibn Abi Shaybah 24155","","","كتاب الطب"
"24156","(۲۴۱۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ نُسَیرٍ ، عَنْ بَکْرِ بْنِ مَاعِزٍ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ، قَالَ : مَا لِلنُّفَسَائِ عِنْدِی إِلاَّ التَّمْرُ ، وَلاَ لِلْمَرِیضِ إِلاَّ الْعَسَلُ۔","","Musannaf Ibn Abi Shaybah 24156","","","كتاب الطب"
"24157","(۲۴۱۵۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَابْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ خَیْثَمَۃَ ، عَنِ الأَسْوَدِ ، قَالَ : قَالَ عَبْدُ اللہِ : عَلَیْکُمْ بِالشِّفَائَ یْنِ : الْقُرْآنِ وَالْعَسَلِ۔ (ابن ماجہ ۳۴۵۲۔ حاکم ۲۰۰)","Sahih","Musannaf Ibn Abi Shaybah 24157","","","كتاب الطب"
"24158","(۲۴۱۵۸) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَتَی رَجُلٌ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَشَکَا إِلَیْہِ بَطْنَ أَخِیہِ ، فَقَالَ: عَلَیْکَ بِالْعَسَلِ، ثُمَّ عَادَ إِلَیْہِ فَقَالَ: کَأَنَّہُ، فَقَالَ: کَذَبَ بَطْنُ أَخِیک، وَصَدَقَ الْقُرْآنُ، عَلَیْکَ بِالْعَسَلِ۔","","Musannaf Ibn Abi Shaybah 24158","","","كتاب الطب"
"24159","(۲۴۱۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ لِلنُّفَسَائِ الرَّطبَ۔","No Data Available","Musannaf Ibn Abi Shaybah 24159","","","كتاب الطب"
"24160","(۲۴۱۶۰) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : مَا لِلنُّفَسَائِ إِلاَّ الرَّطبُ ، لأِنَّ اللَّہَ تَعَالَی جَعَلَہُ رِزْقًا لِمَرْیَمَ۔","","Musannaf Ibn Abi Shaybah 24160","","","كتاب الطب"
"24161","(۲۴۱۶۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عَمْرِو بْنِ حُرَیْثٍ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْکَمْأَۃُ مِنَ الْمَنِّ ، وَہِیَ شِفَائٌ لِلْعَیْنِ۔ (بخاری ۴۴۷۸۔ مسلم ۱۵۷)","Sahih","Musannaf Ibn Abi Shaybah 24161","","","كتاب الطب"
"24162","(۲۴۱۶۲) حَدَّثَنَا عُبَیْدُ اللہِ ، قَالَ : أَخْبَرَنَا شَیْبَانُ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : خَرَجَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَفِی یَدِہِ أَکْمُؤٌ ، فَقَالَ : ہَؤُلاَئِ مِنَ الْمَنِّ ، وَہِیَ شِفَائٌ لِلْعَیْنِ۔ (ابن ماجہ ۳۴۵۳۔ احمد ۳/۴۸)","Sahih","Musannaf Ibn Abi Shaybah 24162","","","كتاب الطب"
"24163","(۲۴۱۶۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنِ الْقَاسِمِ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْکَمْأَۃُ مِنَ الْمَنِّ ، وَہِیَ شِفَائٌ لِلْعَیْنِ۔ (دارمی ۲۸۴۰)","Da'if","Musannaf Ibn Abi Shaybah 24163","","","كتاب الطب"
"24164","(۲۴۱۶۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عُمَرَ بْنِ حُسَیْنٍ ، عن رَجُلٍ مِنْ وَلَدِ حُذَیْفَۃَ ، عَنْ عَامِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْکَمْأَۃُ مِنَ الْمَنِّ ، وَمَاؤُہَا شِفَائٌ لِلْعَیْنِ۔","","Musannaf Ibn Abi Shaybah 24164","","","كتاب الطب"
"24165","(۲۴۱۶۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عَمْرِو بْنِ حُرَیْثٍ ، عَنْ سَعِیدِ بْنِ زَیْدٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْکَمْأَۃُ مِنَ الْمَنِّ ، وَمَاؤُہَا شِفَائٌ لِلْعَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 24165","","","كتاب الطب"
"24166","(۲۴۱۶۶) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، عَنْ شَیْخٍ مِنْ أَہْلِ وَاسِطٍ ، قَالَ : سَأَلْتُ أَبَا عِیَاضٍ عَنْ شَعْرِ الْخِنْزِیرِ یُوضَعُ عَلَی جُرْحِ الدَّابَّۃِ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 24166","","","كتاب الطب"
"24167","(۲۴۱۶۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا یَکْرَہَانِ أَنْ یُطْلَی رَأْسُ الصَّبِیِّ مِنْ دَمِ الْعَقِیقَۃ ، وَقَالَ الْحَسَنُ : رِجْسٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 24167","","","كتاب الطب"
"24168","(۲۴۱۶۸) حَدَّثَنَا عُمَرُ بْنُ سَعْدٍ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَرِہَ مَرَارَۃَ الذِّئْبِ۔","","Musannaf Ibn Abi Shaybah 24168","","","كتاب الطب"
"24169","(۲۴۱۶۹) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ بَشِیرِ بْنِ عُقْبَۃَ النَّاجِی ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنْ قَطْعِ الْبَوَاسِیرِ ؟ فَکَرِہَہُ ، وَقَالَ : اجْعَلْ عَلَیْہِ دُہْنَ خَلٍّ۔","","Musannaf Ibn Abi Shaybah 24169","","","كتاب الطب"
"24170","(۲۴۱۷۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قُلْتُ لِمُحَمَّدٍ : الرَّجُلُ یَسْطُو عَلَی النَّاقَۃِ ؟ قَالَ : مَا أَرَی ذَلِکَ إِلاَّ مِنَ الْفَسَادِ۔","","Musannaf Ibn Abi Shaybah 24170","","","كتاب الطب"
"24171","(۲۴۱۷۱) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24171","","","كتاب الطب"
"24172","(۲۴۱۷۲) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ أَبِی عَوَانَۃَ، عَنْ مُغِیرَۃَ، عَنِ الْحَارِثِ، قَالَ: إِذَا کَانَ الْجُنْدبَادسْتَر ذَکِیًّا، فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 24172","","","كتاب الطب"
"24173","(۲۴۱۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ سُئِلَ عَنِ الْجُنْدبَادسْتَر ؟ فَقَالَ : إِذَا کَانَ ذَکِیًّا فَلاَ بَأْسَ بِہِ ، وَکَانَ یَکْرَہُ غَیْرَ الذَّکِیِّ۔","","Musannaf Ibn Abi Shaybah 24173","","","كتاب الطب"
"24174","(۲۴۱۷۴) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ دَاوُدَ ، قَالَ : سُئِلَ الشَّعْبِیُّ عَنْ رَجُلٍ یَتَدَاوَی بِلَحْمِ کَلْبٍ ؟ فَقَالَ : إِنْ تَدَاوَی بِہِ فَلاَ شَفَاہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 24174","","","كتاب الطب"
"24175","(۲۴۱۷۵) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ أَصَابَتْہُ حُمَّی رِبْعٍ ، فَنُعِتَ لَہُ جَنْبُ ثَعْلَبٍ ، فَأَبَی أَنْ یَأْکُلَہُ۔","","Musannaf Ibn Abi Shaybah 24175","","","كتاب الطب"
"24176","(۲۴۱۷۶) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : أَخْبَرَنَا سُفْیَانُ ، عَنِ الأَعْمَشِ ، عَنْ ذَکْوَانَ ، عَنْ عَائِشَۃَ ، قَالَتْ : إِذَا کَانَتْ حُمَّی رِبْعٍ فَلْیَأْخُذْ ثَلاَثَۃَ أَرْبَاعٍ مِنْ سَمْنٍ ، وَرُبُعًا مِنْ لَبَنٍ ، ثُمَّ یَشْرَبْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24176","","","كتاب الطب"
"24177","(۲۴۱۷۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ سَعِیدِ بْنِ خَالِدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عُثْمَانَ ، قَالَ : ذَکَرَ طَبِیبٌ عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَوَائً یُجْعَلُ فِیہِ الضِّفْدَعُ ، فَنَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ قَتْلِ الضِّفْدِعِ۔ (ابوداؤد ۵۲۲۷۔ احمد ۳/۴۹۹)","Sahih","Musannaf Ibn Abi Shaybah 24177","","","كتاب الطب"
"24178","(۲۴۱۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ زُرَارَۃَ بْنِ أَوْفَی ، عَنْ أَبِی الْحَکَمِ الْبَجَلِیِّ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لاَ تَقْتُلُوا الضَّفَادِعَ ، فَإِنَّ نَقِیقَہَا الَّذِی تَسْمَعُونَ ، تَسْبِیحٌ۔","Sahih","Musannaf Ibn Abi Shaybah 24178","","","كتاب الطب"
"24179","(۲۴۱۷۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، عَنِ الْحَسَنِ ، قَالَ : الثَّعْلَبُ مِنَ السِّبَاعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24179","","","كتاب الطب"
"24180","(۲۴۱۸۰) حَدَّثَنَا مَخْلَدُ بْنُ یَزِیدَ ، وَکَانَ ثِقَۃً ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ سُئِلَ عَنْ رَجُلٍ وُجِعَ کَبِدُہُ ، فَنُعِتَ لَہُ أَنْ یُسْرَم عَلَی کَبِدِہِ ، وَأَنْ یَشْرَبَ مِنْ دَمِہِ ؟ فَقَالَ : لاَ بَأْسَ ، ہِیَ ضَرُورَۃٌ ۔ قَالَ ابْنُ جُرَیْجٍ : قُلْتُ لَہُ : أَلَیْسَ الدَّمُ حَرَامًا ؟ قَالَ : ذَلِکَ مِنْ ضَرُورَۃٍ۔","","Musannaf Ibn Abi Shaybah 24180","","","كتاب الطب"
"24181","(۲۴۱۸۱) حَدَّثَنَا شَرِیکٌ، عَنْ جَابِرٍ، عَنْ أَبِی جَعْفَرٍ، قَالَ: إِذَا اضْطُرَّ إِلَی مَا حَرُمَ عَلَیْہِ فَمَا حَرُمَ عَلَیْہِ، فَہُوَ لَہُ حَلاَلٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 24181","","","كتاب الطب"
"24182","(۲۴۱۸۲) حَدَّثَنَا مَخْلَدُ بْنُ یَزِیدَ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سُئِلَ عَطَائٌ عَنِ الْمَرْأَۃِ تَمُوتُ وَفِی بَطْنِہَا وَلَدٌ ، یَسْطُو عَلَیْہِ الرَّجُلُ فَیَسْتَخْرِجُہُ ؟ فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 24182","","","كتاب الطب"
"24183","(۲۴۱۸۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَسْطُوَ الرَّجُلُ عَلَی الْمَرْأَۃِ ، إِذَا لَمْ یَقْدِرُوا عَلَی امْرَأَۃٍ تُعَالِجُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24183","","","كتاب الطب"
"24184","(۲۴۱۸۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : قَالَتْ أُمُّ سِنَانٍ : إِذَا أَنَا مِتُّ فَشُقُّوا بَطْنِی ، فَإِنَّ فِیہِ سَیِّدَ غَطَفَانَ ، قَالَ : فَلَمَّا مَاتَتْ شَقُّوا بَطْنَہَا فَاسْتَخْرَجُوا سِنَانًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24184","","","كتاب الطب"
"24185","(۲۴۱۸۵) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : قَالَ الْحَارِثُ بْنُ کَلَدَۃَ ، وَکَانَ طَبِیبَ الْعَرَبِ ؛ أَکْرَہُ الشَّمْسَ لِثَلاث ، تُثْقلُ الرِّیحَ ، وَتُبْلِی الثَّوْبَ ، وَتُخْرِجُ الدَّائَ الدَّفِینَ۔","","Musannaf Ibn Abi Shaybah 24185","","","كتاب الطب"
"24186","(۲۴۱۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ مَحْفُوظِ بن عَلْقَمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَأَی رَجُلاً فِی الشَّمْسِ ، فَقَالَ : تَحَوَّلْ إِلَی الظِّلِّ فَإِنَّہُ مُبَارَکٌ۔","","Musannaf Ibn Abi Shaybah 24186","","","كتاب الطب"
"24187","(۲۴۱۸۷) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، وَأَبُو أُسَامَۃَ ، عَنْ إِسْمَاعِیل ، عَنْ قَیْسٍ ، قَالَ : جَائَ أَبِی وَالنَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَخْطُبُ ، فَقَامَ بَیْنَ یَدَیْہِ فِی الشَّمْسِ ، فَأَمَرَ بِہِ ، فَحُوِّلَ إِلَی الظِّلِّ۔","","Musannaf Ibn Abi Shaybah 24187","","","كتاب الطب"
"24188","(۲۴۱۸۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ سَمُرَۃََ ، قَالَ : قَالَ عُمَرُ : اسْتَقْبِلُوا الشَّمْسَ بِجِبَاہِکُمْ ، فَإِنَّہَا حَمَّامُ الْعَرَبِ۔","","Musannaf Ibn Abi Shaybah 24188","","","كتاب الطب"
"24189","(۲۴۱۸۹) حدَّثَنَا سُفْیَانُ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجاہِد ؛ قَالَ : مَائُ زَمْزَمَ شِفَائٌ لِمَا شُرِبَ لَہُ۔","","Musannaf Ibn Abi Shaybah 24189","","","كتاب الطب"
"24190","(۲۴۱۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ عَطَائٍ ؛ فِی مَائِ زَمْزَمَ یُخْرج بِہِ مِنَ الْحَرَمِ ، فَقَالَ : انْتَقَلَ کَعْبٌ بِثِنْتَیْ عَشْرَۃَ رَاوِیَۃٍ إِلَی الشَّام یَسْتَشفُونَ بِہَا۔","","Musannaf Ibn Abi Shaybah 24190","","","كتاب الطب"
"24191","(۲۴۱۹۱) حَدَّثَنَا سَعِیدُ بْنُ زَکَرِیَّا ، وَزَیْدُ بْنُ حُبَابٍ ، عَنْ عَبْدِ اللہِ بْنِ الْمُؤَمِّلِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَائُ زَمْزَمَ لِمَا شُرِبَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24191","","","كتاب الطب"
"24192","(۲۴۱۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عَاصِمُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی عُثْمَانَ النَّہْدِیِّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ غَزَا بِأَصْحَابِہِ ، فَمَرَّ قَوْمٌ مُسْغِبُونَ ، یَعْنِی جِیَاعًا ، بِشَجَرَۃٍ خَضْرَائَ فَأَکَلُوا مِنْہَا ، فَکَأَنَّمَا مَرَّتْ بِہِمْ رِیحٌ فَأَخْمَدَتْہُمْ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قرِّسُوا الْمَائَ فِی الشِّنَانِ ، ثُمَّ صُبُّوہُ عَلَیْکُمْ فِیمَا بَیْنَ الأَذَانَیْنِ مِنَ الصُّبْحِ ، وَاحْدُرُوا الْمَائَ حَدْرًا ، وَاذْکُرُوا اسْمَ اللہِ عَلَیْہِ ، فَفَعَلُوا ذَلِکَ ، فَکَأَنَّمَا نَشِطُوا مِنْ عُقْلٍ۔","","Musannaf Ibn Abi Shaybah 24192","","","كتاب الطب"
"24193","(۲۴۱۹۳) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، قَالَ : حَدَّثَنَا عَاصِمٌ الأَحْوَلُ ، قَالَ : أَکَلَ ابْنُ سِیرِینَ یَوْمًا ثُمَّ اتَّکَأَ عَلَی یَمِینِہِ ، قَالَ : فَقُلْتُ : إِنَّ الأَطِبَّائَ یَکْرَہُونَ أَنْ یَأْکُلَ الرَّجُلُ وَیَتَّکِئَ عَلَی یَمِینِہِ ، فَقَالَ : إِنَّ کَعْبًا لَمْ یَکُنْ یَکْرَہُ ذَلِکَ ، کَانَ یَقُولُ : تَوَسَّدْ یَمِینَک ، ثُمَّ اسْتَقْبِلِ الْقِبْلَۃَ ، فَإِنَّہَا وَفَاؤُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24193","","","كتاب الطب"
"24194","(۲۴۱۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا إِسْمَاعِیلُ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : مَرِضَ رَجُلٌ بِالْمَدَائِنِ، قَالَ : أُرَاہُ مِنَ الْمُنَافِقِینَ ، فَقَالَ حُذَیْفَۃُ : احْمِلُوہُ عَلَی مَائَ الْفُرَاتِ ، فَإِنَّ مَائِ الْفُرَاتِ أَخَفَّ مِنْ مَائِ دِجْلَۃَ ، قَالَ : فَحُمِلَ فَمَاتَ۔","Sahih","Musannaf Ibn Abi Shaybah 24194","","","كتاب الطب"
"24195","(۲۴۱۹۵) حَدَّثَنَا إِسْحَاقُ الأَزْرَقُ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ؛ أَنَّہُ کَانَ یَکْرَہُ الدَّوَائَ یُجْعَلُ فِیہِ الْبَوْلُ ، وَیَنْہَی عَنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24195","","","كتاب الطب"
"24196","(۲۴۱۹۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْن خُثَیْمٍ ، عَنْ عَطَائٍ ؛ فِی الْمَرْأَۃِ تَنْکَسِرُ ، قَالَ : لاَ بَأْسَ أَنْ یُجَبِّرَہَا الرَّجُلُ۔","","Musannaf Ibn Abi Shaybah 24196","","","كتاب الطب"
"24197","(۲۴۱۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ الْوَلِیدِ الْمَزَنِیِّ ، عَنِ امْرَأَۃٍ مِنْ أَہْلِہِ ، عَنْ عَبْدِ اللہِ بْنِ مُغَفَّلٍ ؛ أَنَّہُ قَالَ فِی امْرَأَۃٍ بِہَا جُرْحٌ : یُجْعَلُ نِطْعٌ ، ثُمَّ یُقَوِّرُہُ ، ثُمَّ یُدَاوِیہَا۔","","Musannaf Ibn Abi Shaybah 24197","","","كتاب الطب"
"24198","(۲۴۱۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، قَالَ : قُلْتُ لِجَابِرِ بْنِ زَیْدٍ : الْمَرْأَۃُ یَنْکَسِرُ مِنْہَا الْفَخِذُ ، أَوِ الذِّرَاعُ ، أَجْبُرُہُ ؟ قَالَ : نَعَمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 24198","","","كتاب الطب"
"24199","(۲۴۱۹۹) حَدَّثَنَا عَلِیُّ بْنُ غُرَابٍ ، عَنْ زَمْعَۃَ ، عَنْ سَلَمَۃَ بْنِ وَہْرَامٍ ، قَالَ : سَأَلْتُ طَاوُوسًا عَنِ الْمَرْأَۃِ یَکُونُ بِہَا الْجُرْحُ ، کَیْفَ یُدَاوِیہَا الطَّبِیبُ ؟ قَالَ : یُجِیبُ مَوْضِعَ الْجُرْحِ مِنَ الثَّوْبِ ، ثُمَّ یُدَاوِیہَا الطَّبِیبُ۔","","Musannaf Ibn Abi Shaybah 24199","","","كتاب الطب"
"24200","(۲۴۲۰۰) حَدَّثَنَا شَرِیکٌ، عَنِ ابْنِ أَبْجَرَ ، عَنِ الشَّعْبِیِّ ؛ سُئِلَ عَنِ الْمَرْأَۃِ یَکُونُ بِہَا الْجُرْحُ ؟ قَالَ : یُخْرَقُ مَوْضِعُہُ، ثُمَّ یُدَاوِیہَا الرَّجُلُ۔","","Musannaf Ibn Abi Shaybah 24200","","","كتاب الطب"
"24201","(۲۴۲۰۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ؛ فِی الْمَرْأَۃِ تَنْکَسِرُ، قَالَ: لاَ بَأْسَ أَنْ یُجَبِّرہَا الرَّجُلُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24201","","","كتاب الطب"
"24202","(۲۴۲۰۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : سَمِعْتُ ابْنَ أَبْجَرَ یَقُولُ : دَعْ عَشَائَ اللَّیْلِ ، إِلاَّ أَنْ تَکُونَ صَائِمًا۔","","Musannaf Ibn Abi Shaybah 24202","","","كتاب الطب"
"24203","(۲۴۲۰۳) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، قَالَ : سَمِعْتُ ابْنَ أَبْجَرَ ، یَقُولُ : اللَّحْمُ کُلُّہُ حَارٌّ۔","","Musannaf Ibn Abi Shaybah 24203","","","كتاب الطب"
"24204","(۲۴۲۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ: حدَّثَنِی مَرْزُوقُ بْنُ عَبْدِ الرَّحْمَنِ أَبُو حَسَّانِ الْمُؤَذِّنُ ، قَالَ: حَدَّثَنَا مَطَرٌ الْوَرَّاقُ؛ أَنَّ نَبِیًّا مِنَ الأَنْبِیَائِ شَکَا إِلَی اللہِ الضَّعْفَ ، فَأَمَرَہُ أَنْ یَطْبُخَ اللَّحْمَ بِاللَّبَنِ ، فَإِنَّ الْقُوَّۃَ فِیہِمَا۔","No Data Available","Musannaf Ibn Abi Shaybah 24204","","","كتاب الطب"
"24205","(۲۴۲۰۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ صُبَیْحٍ مَوْلَی بَنِی مَرْوَانَ ، عَنْ مَکْحُولٍ ، قَالَ: سَمِعْتُہُ یَقُولُ فِی الرَّہْصَۃِ: بِسْمِ اللہِ ، اللَّہُمَّ أَنْتَ الْوَاقِی ، وَأَنْتَ الْبَاقِی ، وَأَنْتَ الشَّافِی ، قَالَ : ثُمَّ یَعْقِدُ خَیْطًا فِیہِ حَدِیدٌ ، أَوْ شَعْرٌ ، ثُمَّ یَرْبِطُ بِہِ الرَّہْصَۃَ۔","","Musannaf Ibn Abi Shaybah 24205","","","كتاب الطب"
"24206","(۲۴۲۰۶) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : بَعَثَہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِلَی الْیَمَنِ ، فَسَأَلَہُ عَنْ أَشْرِبَۃٍ تُصْنَعُ بِہَا : الْبِتْعُ ، وَالْمِزْرُ ، وَالذُّرَۃُ ، فَقَالَ : کُلَّ مُسْکِرٍ حَرَامٌ۔\n(بخاری ۴۲۴۴۔ مسلم ۷۵)","Sahih","Musannaf Ibn Abi Shaybah 24206","","","كتاب الأشربة"
"24207","(۲۴۲۰۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَائِشَۃَ ؛ تَبْلُغُ بِہِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُّ شَرَابٍ أَسْکَرَ ، فَہُوَ حَرَامٌ۔ (بخاری ۵۵۸۶۔ مسلم ۶۹)","Sahih","Musannaf Ibn Abi Shaybah 24207","","","كتاب الأشربة"
"24208","(۲۴۲۰۸) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ: کُلُّ مُسْکِرٍ حَرَامٌ ، قَالَ : وَقَالَ ابْنُ عُمَرَ : کُلُّ مُسْکِرٍ خَمْرٌ۔ (مسلم ۷۳۔ ابوداؤد ۳۶۷۱)","Da'if","Musannaf Ibn Abi Shaybah 24208","","","كتاب الأشربة"
"24209","(۲۴۲۰۹) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ أَبِی عُثْمَانَ ، عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ ، عَنْ عَائِشَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کُلُّ مُسْکِرٍ حَرَامٌ۔ (ابوداؤد ۳۶۸۰۔ احمد ۶/۷۲)","Da'if","Musannaf Ibn Abi Shaybah 24209","","","كتاب الأشربة"
"24210","(۲۴۲۱۰) حَدَّثَنَا قَبِیصَۃُ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ بَذِیمَۃَ ، عَنْ قَیْسِ بْنِ حَبْتَرٍ ، عَنِ ابْنِ عَبَّاسٍ ، عن النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کُلُّ مُسْکِرٍ حَرَامٌ۔ (ابوداؤد ۳۶۷۲)","Sahih","Musannaf Ibn Abi Shaybah 24210","","","كتاب الأشربة"
"24211","(۲۴۲۱۱) حَدَّثَنَا مُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ مَرْثَدِ بْنِ عَبْدِ اللہِ الْیَزَنِیِّ ، عَنْ دَیْلَمٍ الْحِمْیَرِیِّ قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقُلْتُ : یَا رَسُولَ اللہِ ، إِنَّا بِأَرْضٍ بَارِدَۃٍ نُعَالِجُ بِہَا عَمَلاً شَدِیدًا ، وَإِنَّا نَتَّخِذُ شَرَابًا مِنْ ہَذَا الْقَمْحِ نَتَقَوَّی بِہِ عَلَی أَعْمَالِنَا ، وَعَلَی بَرْدِ بِلاَدِنَا ؟ قَالَ : ہَلْ یُسْکِرُ ؟ قُلْتُ : نَعَمْ ، قَالَ : فَاجْتَنِبُوہُ ، قَالَ : ثُمَّ جِئْتُہُ مِنْ بَیْنِ یَدَیْہِ ، فَقُلْتُ لَہُ مِثْلَ ذَلِکَ ، فَقَالَ: ہَلْ یُسْکِرُ؟ قُلْتُ: نَعَمْ، قَالَ: فَاجْتَنِبُوہُ، قُلْتُ: إِنَّ النَّاسَ غَیْرُ تَارِکِیہِ ، قَالَ: فَإِنْ لَمْ یَتْرُکُوہُ فَاقْتُلُوہُمْ۔\n(ابوداؤد ۳۶۷۶۔ احمد ۴/۲۳۱)","","Musannaf Ibn Abi Shaybah 24211","","","كتاب الأشربة"
"24212","(۲۴۲۱۲) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ سِرَاجِ بْنِ عُقْبَۃَ ، عَنْ عَمَّتِہِ خَالِدَۃَ بِنْتِ طَلْقٍ ، قَالَتْ : حدَّثَنِی أَبِی ، قَالَ : کُنَّا جُلُوسًا عِنْدَ نَبِیِّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَجَائَ صُحَارُ عَبْدِ الْقَیْسِ ، فَقَالَ : یَا رَسُولَ اللہِ ، مَا تَرَی فِی شَرَابٍ نَصْنَعُہُ مِنْ ثِمَارِنَا ؟ قَالَ : فَأَعْرَضَ عَنْہُ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی سَأَلَہُ ثَلاَثَ مَرَّاتٍ ، ثُمَّ قَامَ بِنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصَلَّی ، فَلَمَّا قَضَی الصَّلاَۃَ ، قَالَ : مَنِ السَّائِلُ عَنِ الْمُسْکِرِ ؟ یَا سَائِلاً عَنِ الْمُسْکِرِ ، لاَ تَشْرَبْہُ ، وَلاَ تَسْقِہِ أَحَدًا مِنَ الْمُسْلِمِینَ ، فَوَالَّذِی نَفْسُ مُحَمَّدٍ بِیَدِہِ ، مَا شَرِبَہُ قَطُّ رَجُلٌ ابْتِغَائَ لَذَّۃِ سُکْرِہِ ، فَیَسْقِیَہُ اللَّہُ خَمْرًا یَوْمَ الْقِیَامَۃِ۔ (طبرانی ۸۲۵۹)","Hasan","Musannaf Ibn Abi Shaybah 24212","","","كتاب الأشربة"
"24213","(۲۴۲۱۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُّ مُسْکِرٍ حَرَامٌ۔","Hasan","Musannaf Ibn Abi Shaybah 24213","","","كتاب الأشربة"
"24214","(۲۴۲۱۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبَانَ بْنِ عَبْدِ اللہِ الْبَجَلِیِّ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قَالَ نَبِیُّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلُّ مُسْکِرٍ حَرَامٌ۔ (ابوداؤد ۳۶۷۸۔ احمد ۲/۱۷۱)","Hasan","Musannaf Ibn Abi Shaybah 24214","","","كتاب الأشربة"
"24215","(۲۴۲۱۵) حَدَّثَنَا عَبْد اللہِ بْنُ نُمَیْرٍ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنِ الْحَکَمِ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أُمِّ سَلَمَۃَ ، قَالَتْ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ کُلٍّ مُسْکِرٍ وَمُفَتِّرٍ۔ (احمد ۶/۳۰۹۔ ابوداؤد ۳۶۷۹)","Da'if","Musannaf Ibn Abi Shaybah 24215","","","كتاب الأشربة"
"24216","(۲۴۲۱۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْرُوفِ بْنِ وَاصِلٍ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُنْتُ نَہَیْتُکُمْ عَنِ الأَشْرِبَۃِ فِی ظُرُوفِ الأُدُمِ ، فَاشْرَبُوا فِی کُلِّ وِعَائٍ غَیْرَ أَنْ لاَ تَشْرَبُوا مُسْکِرًا۔ (ابوداؤد ۳۶۹۱)","Sahih","Musannaf Ibn Abi Shaybah 24216","","","كتاب الأشربة"
"24217","(۲۴۲۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اشْرَبُوا فِی الأَسْقِیَۃِ کُلِّہَا ، وَلاَ تَشْرَبُوا مُسْکِرًا۔","Sahih","Musannaf Ibn Abi Shaybah 24217","","","كتاب الأشربة"
"24218","(۲۴۲۱۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ أَبِی حَیَّانَ ، عَنْ أَبِیہِ ، عَنْ مَرْیَمَ بِنْتِ طَارِقٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا ، قَالَتْ : کُلُّ مُسْکِرٍ حَرَامٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24218","","","كتاب الأشربة"
"24219","(۲۴۲۱۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُلَّ مُسْکِرٍ حَرَامٌ ، وَقَالَ ابْنُ عُمَرَ : کُلُّ مُسْکِرٍ خَمْرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 24219","","","كتاب الأشربة"
"24220","(۲۴۲۲۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی بُرْدَۃَ ، قَالَ : قَالَ عُمَرُ : إِنَّ ہَذِہِ الأَنْبِذَۃَ تُنْبَذُ مِنْ خَمْسَۃِ أَشْیَائَ؛ مِنَ التَّمْرِ ، وَالزَّبِیبِ ، وَالْعَسَلِ ، وَالْبُرِّ ، وَالشَّعِیرِ ، فَمَا خَمَّرْتَہُ مِنْہَا ، ثُمَّ عَتَّقْتَہُ ، فَہُوَ خَمْرٌ۔","","Musannaf Ibn Abi Shaybah 24220","","","كتاب الأشربة"
"24221","(۲۴۲۲۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الْمُخْتَارِ ، قَالَ : سَأَلْتُ أَنَسًا عَنِ النَّبِیذِ ؟ فَقَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الظُّرُوفِ الْمُزَفَّتَۃِ ، وَقَالَ : کُلُّ مُسْکِرٍ حَرَامٌ۔ (مسلم ۳۱۔ احمد ۱۱۲)","Sahih","Musannaf Ibn Abi Shaybah 24221","","","كتاب الأشربة"
"24222","(۲۴۲۲۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ أَبِی حَیَّانَ ، عَنْ أَبِیہِ ، عَنْ مَرْیَمَ بِنْتِ طَارِقٍ ، قَالَتْ : دَخَلْتُ عَلَی عَائِشَۃَ فِی نِسَائٍ مِنْ نِسَائِ الأَنْصَارِ ، فَجَعَلْنَ یَسْأَلْنَہَا عَنِ الظُّرُوفِ الَّتِی یُنْبَذُ فِیہَا ؟ فَقَالَتْ : یَا نِسَائَ الْمُؤْمِنِینَ ، إِنَّکُنَّ لَتُکثرن ظُرُوفًا وَتَسْأَلْنَ عنہا ، مَا کَانَ کَثِیرٌ مِنْہَا عَلَی عَہْدِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَاتَّقِینَ اللَّہَ ، وَمَا أَسْکَرَ إِحْدَاکُنَّ مِنَ الأَشْرِبَۃِ فَلْتَجْتَنِبْہُ ، وَإِنْ أَسْکَرَ مَائُ حُبِّہَا ، فَإِنَّ کُلَّ مُسْکِرٍ حَرَامٌ۔ (حاکم ۱۴۷)","Da'if","Musannaf Ibn Abi Shaybah 24222","","","كتاب الأشربة"
"24223","(۲۴۲۲۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، وَطَاوُوسٍ ، وَمُجَاہِدٍ ؛ قَالُوا : قلِیلُ مَا أَسْکَرَ ، کَثِیرُہُ حَرَامٌ۔\n(بخاری ۴۶۱۹۔ مسلم ۲۳۲۲)","","Musannaf Ibn Abi Shaybah 24223","","","كتاب الأشربة"
"24224","(۲۴۲۲۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَبِی حَیَّانَ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَمِعْتُ عُمَرَ بْنَ الْخَطَّابِ یَخْطُبُ عَلَی مِنْبَرِ الْمَدِینَۃِ یَقُولُ : یَا أَیُّہَا النَّاسُ ، أَلا إِنَّہُ نَزَلَ تَحْرِیمُ الْخَمْرِ یَوْمَ نَزَلَ ، وَہِیَ مِنْ خَمْسَۃِ أَشْیَائَ ؛ مِنَ الْعِنَبِ ، وَالتَّمْرِ ، وَالْعَسَلِ ، وَالْحِنْطَۃِ ، وَالشَّعِیرِ ، وَالْخَمْرُ مَا خَامَرَ الْعَقْلَ۔","Sahih","Musannaf Ibn Abi Shaybah 24224","","","كتاب الأشربة"
"24225","(۲۴۲۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : ذُکِرَ لِی أَنَّ عُبَیْدَ اللہِ وَأَصْحَابَہُ شَرِبُوا شَرَابًا بِالشَّامِ ، وَأَنَا سَائِلٌ عَنْہُ ، فَإِنْ کَانَ مُسْکِرًا جَلَدْتُہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 24225","","","كتاب الأشربة"
"24226","(۲۴۲۲۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، قَالَ : رَأَیْتُ عُمَرَ یَحُدَّہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 24226","","","كتاب الأشربة"
"24227","(۲۴۲۲۷) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، قَالَ: حدَّثَنَا حَاتِمُ بْنُ حُرَیْثٍ ، عَنْ مَالِکِ بْنِ أَبِی مَرْیَمَ، قَالَ : تَذَاکَرْنَا الطِّلاَئَ ، فَدَخَلَ عَلَیْنَا عَبْدُ الرَّحْمَنِ بْنُ غَنْمٍ فَتَذَاکَرْنَاہُ فَقَالَ : حَدَّثَنِی أَبُو مَالِکٍ الأَشْعَرِیُّ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ: یَشْرَبُ أُنَاسٌ مِنْ أُمَّتِی الْخَمْرَ ، یُسَمُّونَہَا بِغَیْرِ اسْمِہَا ، یُضْرَبُ عَلَی رُؤُوسِہِمْ بِالْمَعَازِفِ وَالْقَیْنَاتِ ، یَخْسِفُ اللَّہُ بِہِمُ الأَرْضَ ، وَیَجْعَلُ مِنْہُمُ الْقِرَدَۃَ وَالْخَنَازِیرَ۔\n(ابوداؤد ۳۶۸۱۔ احمد ۵/۳۴۲)","Da'if","Musannaf Ibn Abi Shaybah 24227","","","كتاب الأشربة"
"24228","(۲۴۲۲۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ سَعْدِ بْنِ أَوْسٍ ، عَنْ بِلاَلِ بْنِ یَحْیَی ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَنِ ابْنِ مُحَیْرِیزٍ ، عَنِ ابْنِ السِّمْطِ ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیَسْتَحِلَّنَّ آخِرُ أُمَّتِی الْخَمْرَ بِاسْمٍ تُسَمِّیہَا۔ (احمد ۵/۳۱۸۔ بزار ۲۶۸۹)","Da'if","Musannaf Ibn Abi Shaybah 24228","","","كتاب الأشربة"
"24229","(۲۴۲۲۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا الثَّوْرِیُّ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنْ ذَرِّ بْنِ عَبْدِ اللہِ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَبِیہِ ، قَالَ : سَأَلْتُ أُبَیَّ بْنَ کَعْبٍ عَنِ النَّبِیذِ ؟ قَالَ : عَلَیْکَ بِالْمَائِ ، عَلَیْکَ بِالسَّوِیقِ ، عَلَیْکَ بِالْعَسَلِ ، عَلَیْکَ بِاللَّبَنِ الَّذِی نَجَعَتْ بِہِ ، قَالَ ، فَعَاوَدْتُہُ فَقَالَ : الْخَمْرَ تُرِیدُ ؟۔","Sahih","Musannaf Ibn Abi Shaybah 24229","","","كتاب الأشربة"
"24230","(۲۴۲۳۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ، عَنْ عَبِیْدَۃَ ، قَالَ : أَحْدَثَ النَّاسُ أَشْرِبَۃً مَا أَدْرِی مَا ہِیَ ، فَلَیْسَ لِی شَرَابٌ مُنْذُ عِشْرِینَ سَنَۃً إِلاَّ الْمَائُ وَاللَّبَنُ وَالْعَسَلُ۔","","Musannaf Ibn Abi Shaybah 24230","","","كتاب الأشربة"
"24231","(۲۴۲۳۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، قَالَ : حدَّثَنَا أَبُو کَثِیرٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْخَمْرُ مِنْ ہَاتَیْنِ الشَّجَرَتَیْنِ ؛ مِنَ الْعِنَبَۃِ وَالنَّخْلَۃِ۔ \n(مسلم ۱۵۔ ابوداؤد ۳۶۷۰)","Sahih","Musannaf Ibn Abi Shaybah 24231","","","كتاب الأشربة"
"24232","(۲۴۲۳۲) حَدَّثَنَا زَیْدُ بْنُ حُبَابِ ، قَالَ : حدَّثَنَا الضَّحَّاکُ بْنُ عُثْمَانَ ، قَالَ : حَدَّثَنِی بُکَیْر بْنُ عَبْدِ اللہِ بْنِ الأَشَجِّ ، قَالَ : أُرَاہُ عَنْ عَامِرِ بْنِ سَعْدِ بْنِ أَبِی وَقَّاصٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَنْہَاکُمْ عَنْ قَلِیلِ مَا أَسْکَرَ کَثِیرُہُ۔ (نسائی ۵۱۱۹۔ دارمی ۲۰۹۹)","","Musannaf Ibn Abi Shaybah 24232","","","كتاب الأشربة"
"24233","(۲۴۲۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَعْفَرٍ ، عَنِ الرَّبِیعِ ، عَنْ أَبِی الْعَالِیَۃِ ، أَوْ غَیْرِہِ، عَنِ ابْنِ مُغَفَّلٍ، قَالَ: أَنَا شَہِدْتُ مَعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ نَبِیذِ الْجَرِّ ، وَأَنَا شَہِدْتُہُ رَخَّصَ وَقَالَ : اجْتَنِبُوا کُلَّ مُسْکِرٍ۔ (طحاوی ۲۲۹۔ احمد ۴/۸۷)","","Musannaf Ibn Abi Shaybah 24233","","","كتاب الأشربة"
"24234","(۲۴۲۳۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ ہُبَیْرَۃَ ، عَنْ عَلِیٍّ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْجِعَۃِ۔ (ترمذی ۳۶۵۴۔ ابن ماجہ ۳۶۵۴)","Hasan","Musannaf Ibn Abi Shaybah 24234","","","كتاب الأشربة"
"24235","(۲۴۲۳۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ، قَالَ : سَأَلْتُ أَبَا عَمْرٍو الشَّیْبَانِیَّ عَنِ الْجِعَۃِ ؟فَقَالَ : شَرَابٌ یُصْنَعُ بِالْیَمَنِ مِنَ الشَّعِیرِ۔","","Musannaf Ibn Abi Shaybah 24235","","","كتاب الأشربة"
"24236","(۲۴۲۳۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الْجُوَیْرِیَّۃِ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ الْبَاذِق ؟ فَقَالَ : سَبَقَ مُحَمَّدٌ الْبَاذِقَ، أَنَا أَوَّلُ الْعَرَبِ سَأَلَ ابْنَ عَبَّاسٍ عَنْ ذَلِکَ۔ (بخاری ۵۵۹۸۔ نسائی ۵۱۱۶)","Sahih","Musannaf Ibn Abi Shaybah 24236","","","كتاب الأشربة"
"24237","(۲۴۲۳۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : بَلَغَنِی عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : کَانَ قَوْمٌ عَلَی شَرَابٍ ، فَسَکِرَ رَجُلٌ مِنْہُمْ ، فَجَلَدَہُمْ کُلَّہُمْ۔","","Musannaf Ibn Abi Shaybah 24237","","","كتاب الأشربة"
"24238","(۲۴۲۳۸) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الْعَلاَئِ بْنِ الْمِنْہَالِ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، قَالَ : أُتِیَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ بِقَوْمٍ قَعَدُوا عَلَی شَرَابٍ، مَعَہُمْ رَجُلٌ صَائِمٌ ، فَضَرَبَہُمْ وَقَالَ: لاَ تَقْعُدُوا مَعَہُمْ حَتَّی یَخُوضُوا فِی حَدِیثٍ غَیْرِہِ۔","","Musannaf Ibn Abi Shaybah 24238","","","كتاب الأشربة"
"24239","(۲۴۲۳۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ عَلِیِّ بْنِ زَیْدٍ، عَنْ رَبِیعَۃَ بْنِ النَّابِغَۃِ، عَنْ أَبِیہِ، عَنْ عَلِیٍّ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کُنْتُ نَہَیْتُکُمْ عَنْ ہَذِہِ الأَوْعِیَۃِ فَاشْرَبُوا فِیہَا ، وَاجْتَنِبُوا مَا أَسْکَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 24239","","","كتاب الأشربة"
"24240","(۲۴۲۴۰) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، قَالَ : قُلْتُ لَہُ : کَانَ أَبُوکَ یَشْرَبُ النَّبِیذَ؟ قَالَ : نَعَمْ ، حَتَّی لَقِیَ عَبْدَ اللہِ بْنَ عُمَرَ فَنَہَاہُ عَنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24240","","","كتاب الأشربة"
"24241","(۲۴۲۴۱) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ إِسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، عَنْ عُمَرَ ، قَالَ : کَانَ مُنَادِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا قَامَ إِلَی الصَّلاَۃِ نَادَی : {لاَ تَقْرَبُوا الصَّلاَۃَ وَأَنْتُمْ سُکَارَی}۔\n(ابوداؤد ۳۶۶۲۔ ترمذی ۳۰۴۹)","Sahih","Musannaf Ibn Abi Shaybah 24241","","","كتاب الأشربة"
"24242","(۲۴۲۴۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، عَنِ ابْنِ مُحَیْرِیزٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیَشْرَبَنَّ طَائِفَۃٌ مِنْ أُمَّتِی الْخَمْرَ بِاسْمٍ یُسَمُّونَہَا إِیَّاہُ۔ (عبدالرزاق ۱۷۰۵۵)","","Musannaf Ibn Abi Shaybah 24242","","","كتاب الأشربة"
"24243","(۲۴۲۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنْ شَیْخٍ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ یَقُولُ : السَّکْرُ مِنَ الْکَبَائِرِ۔","Da'if","Musannaf Ibn Abi Shaybah 24243","","","كتاب الأشربة"
"24244","(۲۴۲۴۴) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، قَالَ : حدَّثَنَا إِسْرَائِیلُ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنِ الشَّعْبِیِّ ، عَنِ النُّعْمَانِ بْنِ بَشِیرٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مِنَ الْحِنْطَۃِ خَمْرٌ ، وَمِنَ الشَّعِیرِ خَمْرٌ ، وَمِنَ الزَّبِیبِ خَمْرٌ ، وَمِنَ الْعَسَلِ خَمْرٌ۔ (ابوداؤد ۳۶۶۸۔ ترمذی ۱۸۷۲)","Hasan","Musannaf Ibn Abi Shaybah 24244","","","كتاب الأشربة"
"24245","(۲۴۲۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ فُرَاتِ بْنِ سَلْمَان ، عَنْ رَجُلٍ مِنْ جُلَسَائِ الْقَاسِمِ، عَنْ عَائِشَۃَ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوَّلُ مَا یُکْفأ فِی الإِسْلاَمِ بِشَرَابٍ ، یُقَالُ لَہُ : الطِّلاَئُ ۔\n(ابویعلی ۴۷۱۲)","Da'if","Musannaf Ibn Abi Shaybah 24245","","","كتاب الأشربة"
"24246","(۲۴۲۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَیَّانَ ، عَنِ الشَّعْبِیِّ ، عَنْ عَائِشَۃَ ، قَالَتْ : حدَثَتْ أَشْرِبَۃٌ لَوْ کَانَتْ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 24246","","","كتاب الأشربة"
"24247","(۲۴۲۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ رَجُلاً قَالَ لابْنِ عُمَرَ : إِنَّ أَہْلَنَا یَنْبِذُونَ شَرَابًا لَہُمْ غَدْوَۃً فَیَشْرَبُونَہُ عَشِیَّۃً ، وَیَنْبِذُونَ عَشِیَّۃً فَیَشْرَبُونَہُ غَدْوَۃً ، قَالَ ابْنُ عُمَرَ : أَنْہَاکَ عَنِ السَّکَرِ قَلِیلِہِ وَکَثِیرِہِ ، وَأُشْہِدُ اللَّہَ عَلَیْک ، أَنَّ أَہْلَ خَیْبَرَ یَنْبِذُونَ شَرَابًا لَہُمْ مِنْ کَذَا وَکَذَا ، یُسَمُّونَہُ کَذَا وَکَذَا ، وَہِیَ الْخَمْرُ ، وَإِنَّ أَہْلَ فَدَک یَنْبِذُونَ شَرَابًا مِنْ کَذَا وَکَذَا ، یُسَمُّونَہَا کَذَا وَکَذَا ، وَہِیَ الْخَمْرُ ، فَعَدَّ أَرْبَعَۃَ أَشْرِبَۃٍ أَحَدُہَا الْعَسَلُ ۔ قَالَ ابْنُ عَوْنٍ : وَکَانَ ابْنُ سِیرِینَ یُسَمِّیہَا کُلَّہَا إِلاَّ الْعَسَلَ۔","Sahih","Musannaf Ibn Abi Shaybah 24247","","","كتاب الأشربة"
"24248","(۲۴۲۴۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ مَالِکِ بْنِ عُمَیْرٍ ؛ أَنَّ صَعْصَعَۃَ بْنَ صُوحَانَ أَتَی عَلِیًّا فَسَلَّمَ عَلَیْہِ ، فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، اِنْہِنَا عَمَّا نَہَاکَ عَنْہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قَالَ : نَہَانَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ ، وَالْحَنْتَمِ ، وَالْمُقَیَّرِ ، وَالْجِعَۃِ۔\n(ابوداؤد ۳۶۹۰۔ احمد ۱/۱۳۸)","Da'if","Musannaf Ibn Abi Shaybah 24248","","","كتاب الأشربة"
"24249","(۲۴۲۴۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الدُّبَّائِ ، وَالْحَنْتَمِ ، وَالْمُزَفَّتِ ، وَالنَّقِیرِ۔ (بخاری ۵۳۔ مسلم ۴۸)","Sahih","Musannaf Ibn Abi Shaybah 24249","","","كتاب الأشربة"
"24250","(۲۴۲۵۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : أَشْہَدُ عَلَی ابْنِ عَبَّاسٍ ، وَابْنِ عُمَرَ ، أَنَّہُمَا شَہِدَا أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الدُّبَّائِ ،وَالْحَنْتَمِ ، وَالْمُزَفَّتِ ، وَالنَّقِیرِ۔ (مسلم ۱۵۸۰۔ ابوداؤد ۳۶۸۳)","Sahih","Musannaf Ibn Abi Shaybah 24250","","","كتاب الأشربة"
"24251","(۲۴۲۵۱) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، وَمُحَمَّدُ بْنُ عُبَیْدٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُنْبَذَ فِی الْمُزَفَّتِ ، وَالدُّبَّائِ ، وَالْحَنْتَمِ ، وَالنَّقِیرِ۔\n(مسلم ۱۵۷۷۔ ابن حبان ۵۴۰۴)","Hasan","Musannaf Ibn Abi Shaybah 24251","","","كتاب الأشربة"
"24252","(۲۴۲۵۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی إسْمَاعِیلَ ، عَنْ عُمَارَۃَ بْنِ عَاصِمٍ الْعَنَزِیِّ ، قَالَ : دَخَلْتُ عَلَی أَنَسِ بْنِ مَالِکٍ فَسَأَلْتُہُ عَنِ النَّبِیذِ ، فَقَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ وَالْمُزَفَّتِ؟ فَأَعَدْتُہَا عَلَیْہِ فَقَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ وَالْمُزَفَّتِ ، فَأَعَدْتُہَا عَلَیْہِ فَقَالَ: نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ وَالْمُزَفَّتِ۔ (بخاری ۵۵۸۷۔ مسلم ۱۵۷۷)","Da'if","Musannaf Ibn Abi Shaybah 24252","","","كتاب الأشربة"
"24253","(۲۴۲۵۳) حَدَّثَنَا عَلِیُّ بْنُ إِسْحَاقَ ، عَنِ ابْنِ مُبَارَکٍ ، عَنْ وِقَائٍ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ، عَنْ سَمُرَۃََ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ وَالْمُزَفَّتِ۔ (احمد ۵/۱۷)","Hasan","Musannaf Ibn Abi Shaybah 24253","","","كتاب الأشربة"
"24254","(۲۴۲۵۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ وَالنَّقِیرِ وَالْمُزَفَّتِ۔ (مسلم ۱۵۸۳۔ احمد ۳/۳۸۴)","Sahih","Musannaf Ibn Abi Shaybah 24254","","","كتاب الأشربة"
"24255","(۲۴۲۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُحَارِبٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الدُّبَّائِ ، وَالْحَنْتَمِ ، وَالْمُزَفَّتِ ، قَالَ : وَأُرَاہُ قَالَ : وَالنَّقِیرِ۔ (مسلم ۱۵۸۲۔ احمد ۲/۴۲)","Sahih","Musannaf Ibn Abi Shaybah 24255","","","كتاب الأشربة"
"24256","(۲۴۲۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : خَطَبَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ النَّاسَ ذَاتَ یَوْمٍ ، فَجِئْتُ وَقَدْ فَرَغَ ، فَسَأَلْتُ النَّاسَ : مَاذَا قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالُوا : نَہَی أَنْ یُنْبَذَ فِی الْمُزَفَّتِ وَالْقَرْعِ۔ (مسلم ۱۵۸۱۔احمد ۲/۵۴)","Sahih","Musannaf Ibn Abi Shaybah 24256","","","كتاب الأشربة"
"24257","(۲۴۲۵۷) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃُ ، عَنْ سَلَمَۃَ ، قَالَ : قَالَ أَبُو الْحَکَمِ : حَدَّثَنِی أَخِی ، عَنْ أَبِی سَعِیدٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ نَبِیذِ الْجَرِّ ، وَالدُّبَّائِ ، وَالْمُزَفَّتِ۔ (احمد ۶۶۔ ابویعلی ۱۳۰۲)","Sahih","Musannaf Ibn Abi Shaybah 24257","","","كتاب الأشربة"
"24258","(۲۴۲۵۸) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حَدَّثَنَا شُعْبَۃَ ، عَنْ بُکَیْرِ بْنِ عَطَائٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَعْمُرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ ، وَالْمُزَفَّتِ ، وَالْحَنْتَمِ۔ (ترمذی ۷۱۳۔ ابن ماجہ ۳۴۰۴)","Sahih","Musannaf Ibn Abi Shaybah 24258","","","كتاب الأشربة"
"24259","(۲۴۲۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، عَنْ عَائِشَۃَ ، قَالَتْ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ وَالْحَنْتَمِ وَالْمُزَفَّتِ ، وَقَالَتْ : الْحَنْتَمُ جِرَارٌ یُجَائُ بِہَا مِنْ مِصْرَ ، یُعْمَلُ فِیہَا الْخَمْرُ۔\n(بخاری ۵۵۹۵۔ مسلم ۱۵۷۸)","","Musannaf Ibn Abi Shaybah 24259","","","كتاب الأشربة"
"24260","(۲۴۲۶۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَشْعَثَ بْنِ عُمَیْرٍ الْعَبْدِیِّ ، عَنْ أَبِیہِ ، قَالَ : أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَفْدُ عَبْدِ الْقَیْسِ ، فَلَمَّا أَرَادُوا الاِنْصِرَافَ قَالُوا : قَدْ حَفِظْتُمْ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کُلَّ شَیْئٍ سَمِعْتُمْ مِنْہُ ، فَسَلُوہُ عَنِ النَّبِیذِ ؟ فَأَتَوْہُ فَقَالُوا : یَا رَسُولَ اللہِ ، إِنَّا بِأَرْضٍ وَخِمَۃٍ لاَ یُصْلِحُنَا فِیہَا إِلاَّ الشَّرَابُ ، قَالَ : فَقَالَ : وَمَا شَرَابُکُمْ ؟ قَالُوا : النَّبِیذُ ، قَالَ : فِی أَیِّ شَیْئٍ تَشْرَبُونَہُ ؟ قَالُوا: فِی النَّقِیرِ ، قَالَ : فَلاَ تَشْرَبُوا فِی النَّقِیرِ ، قَالَ : فَخَرَجُوا فَقَالُوا : وَاللَّہِ لاَ یُصَالِحُنَا قَوْمُنَا عَلَی ہَذَا ، فَرَجَعُوا فَسَأَلُوہُ ، فَقَالَ لَہُمْ مِثْلَ ذَلِکَ ، ثُمَّ عَادُوا ، فَقَالَ لَہُمْ : لاَ تَشْرَبُوا فِی النَّقِیرِ فَیَضْرِبَ مِنْکُمُ الرَّجُلُ ابْنَ عَمِّہِ ضَرْبَۃً لاَ یَزَالُ مِنْہَا أَعْرَجَ إِلَی یَوْمِ الْقِیَامَۃِ ، قَالَ : فَضَحِکُوا ، قَالَ : مِنْ أَیِّ شَیْئٍ تَضْحَکُونَ ؟ قَالُوا: یَا رَسُولَ اللہِ ، وَالَّذِی بَعَثَکَ بِالْحَقِّ لَقَدْ شَرِبْنَا فِی نَقِیرٍ لَنَا فَقَامَ بَعْضُنَا إِلَی بَعْضٍ ، فَضَرَبَ ہَذَا ضَرْبَۃً عَرِجَ مِنْہَا إِلَی یَوْمِ الْقِیَامَۃِ۔ (الطبرانی ۱۲۲)","Da'if","Musannaf Ibn Abi Shaybah 24260","","","كتاب الأشربة"
"24261","(۲۴۲۶۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سُلَیْمَانُ التَّیْمِیُّ ، عَنْ أَسْمَائَ بِنْتِ یَزِیدَ ، عَنِ ابْنِ عَمٍّ لَہَا ، یُقَالُ لَہُ: أَنَسٌ ، أَنَّہُ سَمِعَ ابْنَ عَبَّاسٍ یَقُولُ : أَلَمْ یَقُلِ اللَّہُ تَعَالَی : {وَمَا أَتَاکُمَ الرَّسُولُ فَخُذُوہُ وَمَا نَہَاکُمْ عَنْہُ فَانْتَہُوا}؟ قَالُوا: بَلَی ، قَالَ: أَلَمْ یَقُلَ اللَّہُ تَعَالَی: {وَمَا کَانَ لِمُؤْمِنٍ وَلاَ مُؤْمِنَۃٍ إذَا قَضَی اللَّہُ وَرَسُولُہُ أَمْرًا}؟ قَالَ: فَأَشْہَدُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ نَہَی عَنْ نَبِیذِ النَّقِیرِ، وَالْمُزَفَّتِ، وَالدُّبَّائِ، وَالْحَنْتَمِ۔\n(نسائی ۵۱۵۴)","Da'if","Musannaf Ibn Abi Shaybah 24261","","","كتاب الأشربة"
"24262","(۲۴۲۶۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی شِمْرٍ الضُّبَعِیِّ ، قَالَ سَمِعْت عَائِذَ بْنَ عَمْرٍو یَنْہَی عَنِ الْحَنْتَمِ ، وَالدُّبَّائِ ، وَالْمُزَفَّتِ ، وَالنَّقِیرِ ، قَالَ : فَقُلْتُ لَہُ : عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : نَعَمْ۔\n(احمد ۵/۶۴۔ طبرانی ۲۹)","Hasan","Musannaf Ibn Abi Shaybah 24262","","","كتاب الأشربة"
"24263","(۲۴۲۶۳) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ نَبِیذِ الْجَرِّ ، وَالدُّبَّائِ ، وَالْمُزَفَّتِ ، وَعَنِ الظُّرُوفِ کُلِّہَا۔\n(ابن ماجہ ۴۰۸۔ احمد ۲/۵۴۰)","Sahih","Musannaf Ibn Abi Shaybah 24263","","","كتاب الأشربة"
"24264","(۲۴۲۶۴) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، عَنْ عَاصِمٍ الأَحْوَلِ ، عَنْ فُضَیْلِ بْنِ زَیْدٍ، قَالَ : کُنَّا عِنْدَ عَبْدِ اللہِ بْنِ مُغَفَّلٍ فَتَذَاکَرْنَا الشَّرَابَ فَقَالَ : الْخَمْرُ حَرَامٌ ، فَقُلْتُ : الْخَمْرُ حَرَامٌ فِی کِتَابِ اللہِ ، قَالَ : فَأَیُّ شَیْئٍ تُرِیدُ ؟ تُرِیدُ مَا سَمِعْتُہُ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنِ الدُّبَّائِ ، وَالْحَنْتَمِ ، وَالْمُزَفَّتِ۔ (احمد ۴/۸۷۔ دارمی ۲۱۱۲)","Sahih","Musannaf Ibn Abi Shaybah 24264","","","كتاب الأشربة"
"24265","(۲۴۲۶۵) حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِیَادٍ ، قَالَ : حَدَّثَنَا کُلَیْبُ بْنُ وَائِلٍ ، قَالَ : حَدَّثَتْنِی رَبِیبَۃُ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَحْسَبُہَا زَیْنَبَ ، قَالَتْ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ ، وَالْحَنْتَمِ ، وَأُرَی فِیہِ النَّقِیرَ۔ (بخاری ۳۴۹۲۔ طبرانی ۷۱۶)","Hasan","Musannaf Ibn Abi Shaybah 24265","","","كتاب الأشربة"
"24266","(۲۴۲۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی فَرْوَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ؛ أَنَّہُ کَرِہَ الْمُزَفَّتَ وَقَالَ : لأَنْ أَشْرَبَ بَوْلَ حِمَارٍ أَحَبَّ إِلَیَّ مِنْ أَنْ أَشْرَبَ فِی مُزَفَّتٍ۔","","Musannaf Ibn Abi Shaybah 24266","","","كتاب الأشربة"
"24267","(۲۴۲۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی ہَارُونَ الْعَبْدِیِّ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْمُزَفَّتِ۔ (عبدالرزاق ۱۶۹۳۰)","Da'if","Musannaf Ibn Abi Shaybah 24267","","","كتاب الأشربة"
"24268","(۲۴۲۶۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ سَعْدِ بْنِ عُبَیْدَۃَ ، عَنِ الْبَرَائِ ، قَالَ : أَمَرَنِی عُمَرُ أَنْ أُنَادِیَ یَوْمَ الْقَادِسِیَّۃِ : لاَ نَبِیذَ فِی دُبَّائٍ ، وَلاَ حَنْتَمٍ ، وَلاَ مُزَفَّتٍ۔","Sahih","Musannaf Ibn Abi Shaybah 24268","","","كتاب الأشربة"
"24269","(۲۴۲۶۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ نَافِعٍ ، قَالَ سَأَلْتُ ابْنَ عُمَرَ عَنِ الطِّلاَئِ یُطْبَخُ ؟ فَقَالَ : لاَ بَأْسَ ، قُلْتُ : إِنَّہُ فِی مُزَفَّتٍ ، قَالَ : لاَ تَشْرَبْہُ فِی مُزَفَّتٍ۔","Da'if","Musannaf Ibn Abi Shaybah 24269","","","كتاب الأشربة"
"24270","(۲۴۲۷۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنْ رَجُل ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ نَہَی عَنِ الْمُزَفَّتِ۔","Da'if","Musannaf Ibn Abi Shaybah 24270","","","كتاب الأشربة"
"24271","(۲۴۲۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ ، وَالْمُزَفَّتِ ، وَالْحَنْتَمِ ، وَالنَّقِیرِ ، وَأَنْ یُخْلَطَ الْبَلَحُ بِالزَّہْوِ۔\n(مسلم۳۔ نسائی ۵۰۵۷)","Sahih","Musannaf Ibn Abi Shaybah 24271","","","كتاب الأشربة"
"24272","(۲۴۲۷۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْمُخْتَارِ بْنِ فُلْفُلٍ ، قَالَ : سَأَلْتُ أَنَسَ بْنَ مَالِکٍ عَنِ النَّبِیذِ ؟ قَالَ : اجْتَنِبْ مُسْکِرَہُ فِی کُلِّ شَیْئٍ ، وَاجْتَنِبْ مَا سِوَی ذَلِکَ فِیمَا زُفِّتَ فِی دَنٍّ ، أَوْ قِرْبَۃٍ ، أَوْ قَرْعَۃٍ ، أَوْ جَرَّۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 24272","","","كتاب الأشربة"
"24273","(۲۴۲۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا عَبْدُ الْخَالِقِ بْنُ سَلَمَۃَ ، قَالَ ، سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ یَقُولُ: سَمِعْتُ ابْنَ عُمَرَ یَقُولُ عِنْدَ ہَذَا الْمِنْبَرِ ، وَأَشَارَ إِلَی مِنْبَرِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : قَدِمَ وَفْدُ عَبْدِ الْقَیْسِ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَأَلُوہُ عَنِ الأَشْرِبَۃِ ؟ فَنَہَاہُمْ عَنِ الدُّبَّائِ ، وَالنَّقِیرِ ، وَالْحَنْتَمِ ، فَقُلْتُ : یَا أَبَا مُحَمَّدٍ ، الْمُزَفَّتِ ؟ وَظَنَنَّا أَنَّہُ نَسِیَہُ ، فَقَالَ : لَمْ أَسْمَعْہُ یَوْمَئِذٍ مِنِ ابْنِ عُمَرَ۔\n(مسلم ۱۵۸۳۔ احمد ۲/۴۱)","Sahih","Musannaf Ibn Abi Shaybah 24273","","","كتاب الأشربة"
"24274","(۲۴۲۷۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی التَّیَّاحِ ، عَنْ حَفْصٍ اللَّیْثِیِّ ، عَنْ عِمْرَانَ بْنِ الْحُصَیْنِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْحَنْتَمِ۔ (ترمذی ۱۷۳۸۔ احمد ۴/۴۲۷)","Da'if","Musannaf Ibn Abi Shaybah 24274","","","كتاب الأشربة"
"24275","(۲۴۲۷۵) حَدَّثَنَا عُبَیْدُ بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الدُّبَّائِ وَالْمُزَفَّتِ۔ (بخاری ۵۵۹۵۔ مسلم ۳۵)","Sahih","Musannaf Ibn Abi Shaybah 24275","","","كتاب الأشربة"
"24276","(۲۴۲۷۶) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ قَالَ : قُلْتُ لِعَائِشَۃَ : مَا نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مِنَ الأَشْرِبَۃِ ؟ قَالَتْ : نَہَی عَنِ الدُّبَّائِ وَالْمُزَفَّتِ۔ \n قَالَ إِبْرَاہِیمُ : فَقُلْتُ لِلأََسْوَدِ : فَالْحَنْتَمُ وَالْجِرَارُ الْخُضْرُ ؟ فَقَالَ : تُرِیدُ أَنْ نَقُولَ مَا لَمْ یُقَلْ۔","Sahih","Musannaf Ibn Abi Shaybah 24276","","","كتاب الأشربة"
"24277","(۲۴۲۷۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی حَمْزَۃَ جَارٍ لَہُمْ ، قَالَ : سَمِعْتُ ہِلاَلاً رَجُلاً مِنْ بَنِی مَازِنٍ یُحَدِّثُ ، عَنْ سُوَیْد بْنِ مُقَرِّنٍ ، قَالَ : أَتَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِنَبِیذٍ فِی جَرَّۃٍ ، فَسَأَلْتُہُ ؟ فَنَہَانِی عَنْہُ ، فَأَخَذْتُ الْجَرَّۃَ فَکَسَرْتہَا۔ (احمد ۳/۴۴۷۔ طیالسی ۹۲۶۴)","Da'if","Musannaf Ibn Abi Shaybah 24277","","","كتاب الأشربة"
"24278","(۲۴۲۷۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ نَبِیذِ الْجَرِّ الأَخْضَرِ ، قُلْتُ : فَالأَبْیَضُ ؟ قَالَ : لاَ أَدْرِی۔ (مسلم ۱۵۸۰۔ ترمذی ۱۸۷۷)","Sahih","Musannaf Ibn Abi Shaybah 24278","","","كتاب الأشربة"
"24279","(۲۴۲۷۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ أُمَیْنَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ نَبِیذِ الْجَرِّ۔ (ابن ماجہ ۳۴۰۷۔ عبدالرزاق ۱۶۹۶۴)","Da'if","Musannaf Ibn Abi Shaybah 24279","","","كتاب الأشربة"
"24280","(۲۴۲۸۰) حَدَّثَنَا ابْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ جَرِّ الأَخْضَرِ ، قُلْتُ : فَالأَبْیَضُ ؟ قَالَ : لاَ أَدْرِی۔ (بخاری ۵۵۹۶۔ احمد ۴/۳۵۳)","Sahih","Musannaf Ibn Abi Shaybah 24280","","","كتاب الأشربة"
"24281","(۲۴۲۸۱) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدِ بْنِ یَزِیدَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ أَسِیدٍ ، قَالَ : قَالَ رَجُلٌ لابْنِ الزُّبَیْرِ: أَفْتِنَا فِی نَبِیذِ الْجَرِّ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ نَبِیذِ الْجَرِّ۔\n(احمد ۴/۳۔ بزار ۲۲۲۷)","Da'if","Musannaf Ibn Abi Shaybah 24281","","","كتاب الأشربة"
"24282","(۲۴۲۸۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی حَیَّانَ ، عَنْ عَبَایَۃَ بْنِ رِفَاعَۃَ ، أَنَّ جَدَّہُ رَافِعَ بْنَ خَدِیجٍ رَأَی جَرَّۃً خَضْرَائَ لأَہْلِہِ فِی الشَّمْسِ ، فَأَخَذَ جُلْمُودًا فَرَمَاہَا فَکَسَرَہَا ، فَإِذَا فِیہَا سَمْنٌ فَقَالَ : أَدْرِکُوا سَمْنَکُمْ۔\n قَالَ یَحْیَی : ظَنَّ فِیہَا نَبِیذًا۔","Sahih","Musannaf Ibn Abi Shaybah 24282","","","كتاب الأشربة"
"24283","(۲۴۲۸۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ حُصَیْنٍ ، عَنِ امْرَأَۃٍ مِنْ بَنِی شَیْبَانَ ، أَنَّ زَوْجَہَا أَتَاہُمْ فَحَدَّثَہُمْ ؛ أَنَّ أَمِیرَ الْمُؤْمِنِینَ عَلِیًّا نَہَاہُمْ عَنْ نَبِیذِ الْجَرِّ ، قَالَ : فَکَسَرْنَا جَرَّۃً لَنَا۔","Da'if","Musannaf Ibn Abi Shaybah 24283","","","كتاب الأشربة"
"24284","(۲۴۲۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عُیَیْنَۃَ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا بُرْدَۃَ قَدِمَ مِنْ سَفَرٍ ، فَبَدَأَ بِمَنْزِلِ أَبِی بَکْرَۃَ، فَرَأَی فِی الْبَیْتِ جَرَّۃً ، فَقَالَ : مَا ہَذِہِ ؟ فَقِیلَ : فِیہَا نَبِیذٌ لأَبِی بَکْرَۃَ ، فَقَالَ : وَدِدْتُ أَنَّکُمْ حَوَّلْتُمُوہَا فِی سِقَائٍ ۔","Sahih","Musannaf Ibn Abi Shaybah 24284","","","كتاب الأشربة"
"24285","(۲۴۲۸۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ دَاوُدَ بْنِ فَرَاہِیجَ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَنْہَی عَنْ نَبِیذِ الْجَرِّ۔","Da'if","Musannaf Ibn Abi Shaybah 24285","","","كتاب الأشربة"
"24286","(۲۴۲۸۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ وَذَکَرُوا النَّبِیذَ ، فَقَالَ : لاَ أَرَی بِہِ بَأْسًا فِی السِّقَائِ ، وَأَکْرَہُہُ فِی الْجَرِّ الأَخْضَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24286","","","كتاب الأشربة"
"24287","(۲۴۲۸۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی رَجَائٍ ، عَنْ مَالِکِ بْنِ دِینَارٍ ؛ أَنَّ جَابِرَ بْنَ زَیْدٍ وَالْحَسَنَ کَانَا یَکْرَہَانِ نَبِیذَ الْجَرِّ۔","No Data Available","Musannaf Ibn Abi Shaybah 24287","","","كتاب الأشربة"
"24288","(۲۴۲۸۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ شُعْبَۃَ ، عَنْ ثَابِتٍ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : نُہِیَ عَنْ نَبِیذِ الْجَرِّ ؟ قَالَ: زَعَمُوا ذَاکَ ، قُلْتُ : عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ قَالَ : زَعَمُوا ذَاکَ ، قُلْتُ : أَنْتَ سَمِعْتَہُ ؟ قَالَ : زَعَمُوا ذَاکَ ، قَالَ : وَصَرَفَہُ اللَّہُ عَنِّی۔ (مسلم ۵۰۔ احمد ۳۵)","Sahih","Musannaf Ibn Abi Shaybah 24288","","","كتاب الأشربة"
"24289","(۲۴۲۸۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا شُعْبَۃُ ، عَنْ أَبِی جَمْرَۃَ ؛ أَنَّ امْرَأَۃً أَتَتِ ابْنَ عَبَّاسٍ ، وَقَدْ کُنْتُ حَلَفْتُ أَنْ لاَ أَسْأَلَ عَنْ نَبِیذِ الْجَرِّ ، فَقَالَتْ لِی : سَلْہُ ، فَأَبَیْتُ أَنْ أَسْأَلَہُ ، فَسَأَلَہُ رَجُلٌ عَنْ نَبِیذِ الْجَرِّ ؟ فَنَہَاہُ، فَقُلْتُ : یَا أَبَا عَبَّاسٍ ، إِنِّی أَنْتَبِذُ فِی جَرٍّ أَخْضَرَ ، فَأَشْرَبُہُ حُلْوًا طَیِّبًا فَیُقَرْقِرُ بَطْنِی ، فَقَالَ : لاَ تَشْرَبْہُ ، وَإِنْ کَانَ أَحْلَی مِنَ الْعَسَلِ۔ (مسلم ۲۴)","Sahih","Musannaf Ibn Abi Shaybah 24289","","","كتاب الأشربة"
"24290","(۲۴۲۹۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا سُلَیْمَانُ التَّیْمِیُّ ، عَنْ طَاوُوسٍ ؛ أَنَّ رَجُلاً أَتَی ابْنَ عُمَرَ فَقَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ نَبِیذِ الْجَرِّ ؟ فَقَالَ ابْنُ عُمَرَ : نَعَمْ ، فَقَالَ طَاوُوسٌ : وَاللَّہِ إنِّی سَمِعْتُہُ مِنْہُ۔ (مسلم ۵۳۔ احمد ۲/۳۵)","Sahih","Musannaf Ibn Abi Shaybah 24290","","","كتاب الأشربة"
"24291","(۲۴۲۹۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، قَالَ : حَدَّثَنِی یَعْلَی بْنُ حَکِیمٍ ، عَنْ صُہَیْرَۃَ بِنْتِ جَیْفَرٍ ، سَمِعَہُ مِنْہَا ، قَالَتْ : حَجَجْنَا ثُمَّ انْصَرَفْنَا إِلَی الْمَدِینَۃِ ، فَدَخَلْنَا عَلَی صَفِیَّۃَ بِنْتِ حُیَیٍّ ، فَوَافَقْنَا عِنْدَہَا نِسْوَۃً مِنْ أَہْلِ الْکُوفَۃِ ، فَقُلْنَ لَنَا : إِنْ شِئْتُنَّ سَأَلْنَا وَسَمِعْتُنَّ ، وَإِنْ شِئْتُنَّ اسْأَلْنَ وَسَمِعْنَا ، فَقُلْنَ : سَلْنَ ، فَسَأَلْنَ عَنْ أَشْیَائَ مِنْ أَمْرِ الْمَرْأَۃِ وَزَوْجِہَا ، وَمِنْ أَمْرِ الْمَحِیضِ ، وَسَأَلْنَ عَنْ نَبِیذِ الْجَرِّ ، فَقَالَتْ : أَکْثَرْتُنَّ یَا أَہْلَ الْعِرَاقِ عَلَیْنَا فِی نَبِیذِ الْجَرِّ ، حَرَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَبِیذَ الْجَرِّ ، مَا عَلَی إِحْدَاکُنَّ أَنْ تَطْبُخَ تَمْرَہَا ، ثُمَّ تَدْلُکُہُ ، ثُمَّ تُصَفِّیہِ فَتَجْعَلُہُ فِی سِقَائِہَا ، وَتُوکِئُ عَلَیْہِ ، فَإِذَا طَابَ شَرِبَتْ وَسَقَتْ زَوْجَہَا۔\n(احمد ۶/۳۳۷۔ ابویعلی ۷۱۱۷)","Da'if","Musannaf Ibn Abi Shaybah 24291","","","كتاب الأشربة"
"24292","(۲۴۲۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ شُمَیْسَۃَ أُمِّ سَلَمَۃَ الْعَتَکِیَّۃِ ، قَالَتْ : سَمِعْتُ عَائِشَۃَ تَقُولُ : لاَ تَشْرَبْنَ فِی رَاقُودٍ ، وَلاَ جَرَّۃٍ ، وَلاَ قَرْعَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 24292","","","كتاب الأشربة"
"24293","(۲۴۲۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ الْمُبَارَکِ ، عَنْ کَرِیمَۃَ بِنْتِ ہَمَّامٍ ، عَنْ عَائِشَۃَ ، أَنَّہَا سَمِعَتْہَا تَقُولُ : إِیَّاکُمْ وَنَبِیذَ الْجَرِّ الأَخْضَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 24293","","","كتاب الأشربة"
"24294","(۲۴۲۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الأَعْلَی بْنِ کَیْسَانَ ، قَالَ : سَمِعْتُ ابْنَ أَبِی الْہُذَیْلِ یَقُولُ : مَا فِی نَفْسِی مِنْ نَبِیذِ الْجَرِّ شَیْئٌ إِلأَ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ نَہَی عَنْہُ ، وَکَانَ إِمَامَ عَدْلٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 24294","","","كتاب الأشربة"
"24295","(۲۴۲۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانٍ ، عَنْ مَیْمُونٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَشْرَبْ نَبِیذَ الْجَرِّ۔","Sahih","Musannaf Ibn Abi Shaybah 24295","","","كتاب الأشربة"
"24296","(۲۴۲۹۶) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : السَّکَرُ خَمْرٌ۔","","Musannaf Ibn Abi Shaybah 24296","","","كتاب الأشربة"
"24297","(۲۴۲۹۷) حَدَّثَنَا شَرِیکٌ ، عَنْ أَبِی فَرْوَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : السَّکَرُ خَمْرٌ۔","","Musannaf Ibn Abi Shaybah 24297","","","كتاب الأشربة"
"24298","(۲۴۲۹۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، وَإِبْرَاہِیمَ ، وَأَبِی رَزِینٍ ، قَالُوا : السَّکَرُ خَمْرٌ۔","","Musannaf Ibn Abi Shaybah 24298","","","كتاب الأشربة"
"24299","(۲۴۲۹۹) حَدَّثَنَا ہُشَیْمٌ، عَنِ ابْنِ شُبْرُمَۃَ، عَنْ أَبِی زُرْعَۃَ بْنِ عَمْرِو بنِ جَرِیرٍ، قَالَ: ہِیَ الْخَمْرُ، وَہِیَ أَلأَمُ مِنَ الْخَمْرِ۔","","Musannaf Ibn Abi Shaybah 24299","","","كتاب الأشربة"
"24300","(۲۴۳۰۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : ہِیَ الْخَمْرُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24300","","","كتاب الأشربة"
"24301","(۲۴۳۰۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ حَرْبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ سُئِلَ عَنِ السَّکَرِ ؟ فَقَالَ : الْخَمْرُ لَیْسَ لَہَا کُنْیَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24301","","","كتاب الأشربة"
"24302","(۲۴۳۰۲) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : جَائَ إِلَی عَبْدِ اللہِ نَفَرٌ مِنَ الأَعْرَابِ یَسْأَلُونَہُ عَنِ السَّکَرِ ؟ فَقَالَ : إِنَّ اللَّہَ لَمْ یَجْعَلْ شِفَائَ کُمْ فِیمَا حَرَّمَ عَلَیْکُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 24302","","","كتاب الأشربة"
"24303","(۲۴۳۰۳) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ أَبِی حَصِینٍ ، عَنْ یَحْیَی ، عَنْ مَسْرُوقٍ ، عَنْ عَبْدِ اللہِ ؛ مِثْلَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24303","","","كتاب الأشربة"
"24304","(۲۴۳۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : اشْتَکَی رَجُلٌ مِنَ الْحَیِّ بَطْنَہُ ، فَقِیلَ لَہُ : إِنَّ بِکَ الصَّفْرَ ، فَنَعَتُوا لَہُ السَّکَرَ ، فَأَرْسَلَ إِلَی عَبْدِ اللہِ یَسْأَلُہُ عَنْ ذَلِکَ ؟ فَقَالَ عَبْدُ اللہِ : إِنَّ اللَّہَ تَعَالَی لَمْ یَجْعَلْ شِفَائَ کُمْ فِیمَا حَرَّمَ عَلَیْکُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 24304","","","كتاب الأشربة"
"24305","(۲۴۳۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، وَسُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : السَّکَرُ خَمْرٌ۔","","Musannaf Ibn Abi Shaybah 24305","","","كتاب الأشربة"
"24306","(۲۴۳۰۶) حَدَّثَنَا شَرِیکٌ ، عَنْ سَلَمَۃَ بْنِ تَمَّامٍ ، عَنْ عَامِرٍ ، قَالَ : السَّکَرُ خَمْرٌ۔","","Musannaf Ibn Abi Shaybah 24306","","","كتاب الأشربة"
"24307","(۲۴۳۰۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ أَبِی وَائِلٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : نَبِیذُ الْعِنَبِ خَمْرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24307","","","كتاب الأشربة"
"24308","(۲۴۳۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ اللہِ بْنِ الْوَلِیدِ ، قَالَ حَدَّثَتْنِی مَیْمُونَۃُ بِنْتُ عَبْدِ الرَّحْمَنِ بْنِ مَعْقِلٍ ؛ أَنَّ أَبَاہَا سُئِلَ عَنْ نَبِیذِ نَقِیعِ الزَّبِیبِ ؟ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 24308","","","كتاب الأشربة"
"24309","(۲۴۳۰۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنْ بُکَیْر مَوْلًی لِعَبْدِ اللہِ بْنِ مَسْعُودٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لأَنْ أَکُونَ حِمَارًا یُسْتَقَی عَلَیَّ أَحَبَّ إِلَیَّ مِنْ أَنْ أَشْرَبَ نَبِیذَ زَبِیبٍ مُعَتَّقٍ۔","","Musannaf Ibn Abi Shaybah 24309","","","كتاب الأشربة"
"24310","(۲۴۳۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، وَعَامِرٍ ، وَعَطَائٍ ؛ أَنَّہُمْ کَرِہُوا نَبِیذَ الْعِنَبِ۔","","Musannaf Ibn Abi Shaybah 24310","","","كتاب الأشربة"
"24311","(۲۴۳۱۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ حَرْبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ سُئِلَ عَنْ نَقِیعِ الزَّبِیبِ ؟ فَقَالَ : الْخَمْرُ اجْتَنِبُوہَا۔","Da'if","Musannaf Ibn Abi Shaybah 24311","","","كتاب الأشربة"
"24312","(۲۴۳۱۲) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ بُکَیْر ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لأَنْ أَکُونَ حِمَارًا یُسْتَق??ی عَلَیَّ ، أَحَبَّ إِلَیَّ مِنْ أَنْ أَشْرَبَ نَبِیذَ زَبِیبٍ مُعَتَّقٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 24312","","","كتاب الأشربة"
"24313","(۲۴۳۱۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَبِی حَنِیفَۃَ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : اشْرَبْ نَبِیذَ الزَّبِیبِ الْمُنْقَعِ ، مَا دَامَ حُلْوًا یَحْرو اللِّسَانَ۔","","Musannaf Ibn Abi Shaybah 24313","","","كتاب الأشربة"
"24314","(۲۴۳۱۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی عُمَرَ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُنْقَعُ لَہُ الزَّبِیبُ ، فَیَشْرَبُہُ الْیَوْمَ ، وَالْغَدَ ، وَبَعْدَ الْغَدِ ، إِلَی أَنْ یُمْسِی الثَّالِثَۃَ ، ثُمَّ یَأْمُرُ بِہِ فَیُسْقَی ، أَوْ یُہْرَاقَ۔ (مسلم ۱۵۸۹۔ ابوداؤد ۳۷۰۶)","Sahih","Musannaf Ibn Abi Shaybah 24314","","","كتاب الأشربة"
"24315","(۲۴۳۱۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ صَفْوَانَ ، قَالَ : سَمِعْتُ أَبِی یُحَدِّثُ ، عَنْ أُمِّہِ ، قَالَتْ : کُنْتُ أَمْغَثُ لِعُثْمَانَ الزَّبِیبَ غَدْوَۃً فَیَشْرَبُہُ عَشِیَّۃً ، أَوْ أَمْغَثُہُ عَشِیَّۃً فَیَشْرَبُہُ غَدْوَۃً ، فَقَالَ لَہَا عُثْمَانُ : لَعَلَّکِ تَجْعَلِینَ فِیہِ زَہْوًا ؟ قَالَتْ : رُبَّمَا فَعَلْتُ ، قَالَ ، فَلاَ تَفْعَلِی۔","Da'if","Musannaf Ibn Abi Shaybah 24315","","","كتاب الأشربة"
"24316","(۲۴۳۱۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ مُوسَی بْنِ طَرِیفٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَ یُنْبَذُ لِعَلِیٍّ زَبِیبٌ فِی جَرَّۃٍ بَیْضَائَ ، فَیَشْرَبُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24316","","","كتاب الأشربة"
"24317","(۲۴۳۱۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ نَافِعٍ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : إِنِّی أَنْبِذُ نَبِیذَ زَبِیبٍ ، فَیَجِیئُ نَاسٌ مِنْ أَصْحَابِنَا فَیَقْذِفُونَ فِیہِ التَّمْرَ ، فَیُفْسِدُونَہُ عَلَیَّ ، فَکَیْفَ تَرَی ؟ قَالَ : لاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 24317","","","كتاب الأشربة"
"24318","(۲۴۳۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ عِکْرِمَۃَ ؛ فِی نَبِیذِ الْعِنَبِ ، قَالَ : کَان أَعْلاَہُ حَرَامًا ، وَأَسْفَلُہُ حَرَامًا۔","","Musannaf Ibn Abi Shaybah 24318","","","كتاب الأشربة"
"24319","(۲۴۳۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِنَبِیذِ الْعَصِیرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24319","","","كتاب الأشربة"
"24320","(۲۴۳۲۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ حُلاَمِ بْنِ صَالِحٍ ، عَنْ سُلَیْکِ بْنِ مِسْحَلٍ ، قَالَ : خَرَجَ عُمَرُ حَاجًّا ، أَوْ مُعْتَمِرًا ، فَنَزَلَ عَلَی مَائٍ فَدَعَا بِسُفْرَۃٍ ، فَأَکَلَ وَأَکَلَ الْقَوْمُ ، ثُمَّ دَعَا بِشَرَابٍ ، فَأُتِیَ بِقَدَحٍ مِنْ نَبِیذٍ ، فَقَالَ : ادْفَعْہُ إِلَی عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، فَلَمَّا شَمَّہُ رَدَّہُ ، ثُمَّ دَفَعَہُ إِلَی سَعْدِ بْنِ أبِی وَقَّاصٍ ، فَلَمَّا شَمَّہُ رَدَّہُ ، قَالَ : فَہَاتِہِ فَذَاقَہُ ، فَقَالَ : یَا عَجْلاَنُ ، یَعْنِی غُلاَمَہُ ، مَا ہَذَا ؟ فَقَالَ : یَا أَمِیرَ الْمُؤْمِنِینَ ، جَعَلْتُ زَبِیبًا فِی سِقَائٍ ، ثُمَّ عَلَّقْتُہُ بِبَطْنِ الرَّاحِلَۃِ وَصَبَبْتُ عَلَیْہِ مِنَ الْمَائِ ، قَالَ : اِئْتِ بِشَاہِدَیْنِ عَلَی مَا تَقُولُ ، فَجَائَ بِشَاہِدَیْنِ ، فَشَہِدَا ، فَقَالَ : أَیْ بُنَیَّ ، اغْسِلْ سِقَائَ ک یَلِنُ لَنَا شَرَابُہُ ، فَإِنَّ السِّقَائَ یَغْتَلِمُ۔","Hasan","Musannaf Ibn Abi Shaybah 24320","","","كتاب الأشربة"
"24321","(۲۴۳۲۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مَنْصُورِ بْنِ حَیَّانَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : سَأَلَہُ رَجُلٌ ، فَقَالَ : نَعْمِدُ إِلَی الزَّبِیبِ فَنَغْسِلُہُ مِنْ غُبَارِہِ ، ثُمَّ نَجْعَلُہُ فِی دَنٍّ ، أَوْ فِی خَابِیَۃٍ ، فَنَدَعُہُ فِی الشِّتَائِ شَہْرَیْنِ ، وَفِی الصَّیْفِ أَقَلَّ مِنْ ذَلِکَ ؟ فَقَالَ سَعِیدٌ : تِلْکَ الْخَمْرُ اجْتَنِبُوہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 24321","","","كتاب الأشربة"
"24322","(۲۴۳۲۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ قتادۃ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ (ح) وَعَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالاَ : لاَ بَأْسَ بِشُرْبِ الْعَصِیرِ مَا لَمْ یَغْلِ ۔ قَالَ سَعِیدٌ : إِذَا غَلاَ ، فَہُوَ خَمْرٌ اجْتَنِبْہُ ، وَقَالَ إِبْرَاہِیمُ : إِذَا غَلاَ فَدَعْہُ۔","","Musannaf Ibn Abi Shaybah 24322","","","كتاب الأشربة"
"24323","(۲۴۳۲۳) حَدَّثَنَا جَرِیر ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إِذَا غَلاَ فَلا تَشْرَبہُ۔","","Musannaf Ibn Abi Shaybah 24323","","","كتاب الأشربة"
"24324","(۲۴۳۲۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ لاَ یَرَی بِالْعَصِیرِ بَأْسًا مَا لَمْ یُزْبِدْ ، فَإِذَا أَزَبَدَ نَہَی عَنْہُ ، وَقَالَ : إِنَّمَا یُزْبِدُ الْخَمْرُ۔","","Musannaf Ibn Abi Shaybah 24324","","","كتاب الأشربة"
"24325","(۲۴۳۲۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ خُصَیْفٍ ، قَالَ : سَأَلْتُ سَعِیدًا عَنِ الْعَصِیرِ ؟ فَقَالَ : اشْرَبْہُ مِنْ یَوْمٍ وَلَیْلَۃٍ۔","","Musannaf Ibn Abi Shaybah 24325","","","كتاب الأشربة"
"24326","(۲۴۳۲۶) حَدَّثَنَا مُحَمَّدٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ أَبِی حَکِیمٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : اشْرَبِ الْعَصِیرَ مَا لَمْ یَہْدُِرْ۔","No Data Available","Musannaf Ibn Abi Shaybah 24326","","","كتاب الأشربة"
"24327","(۲۴۳۲۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَبِی یَعْفُورَ عَبْدِ الرَّحْمَنِ بْنِ عُبَیْدٍ الْعَامِرِیِّ ، عَنْ أَیْمَنَ أَبِی ثَابِتٍ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ ابْنِ عَبَّاسٍ ، فَجَائَ ہُ رَجُلٌ فَسَأَلَہُ عَنِ الْعَصِیرِ ؟ فَقَالَ : اشْرَبْہُ مَا دَامَ طَرِیًّا۔","Hasan","Musannaf Ibn Abi Shaybah 24327","","","كتاب الأشربة"
"24328","(۲۴۳۲۸) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ بَأْسَ بِشُرْبِ الْعَصِیرِ مَا لَمْ یَغْلِ ثَلاَثًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24328","","","كتاب الأشربة"
"24329","(۲۴۳۲۹) حَدَّثَنَا حَفْصٌ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : اشْرَبْہُ ثَلاَثًا ، مَا لَمْ یَغْلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24329","","","كتاب الأشربة"
"24330","(۲۴۳۳۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَوَکِیعٌ ، عَنْ ہِشَامِ بْنِ عَائِذٍ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَنِ الْعَصِیرِ ؟ فَقَالَ : اشْرَبْہُ مَا لَمْ یَتَغَیَّرْ۔","No Data Available","Musannaf Ibn Abi Shaybah 24330","","","كتاب الأشربة"
"24331","(۲۴۳۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِشُرْبِہِ وَبَیْعِہِ مَا لَمْ یَغْلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24331","","","كتاب الأشربة"
"24332","(۲۴۳۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، وَأَبِی جَعْفَرٍ ، وَعَطَائٍ ، قَالُوا : اشْرَبِ الْعَصِیرَ ابنَ یَوْمٍ وَلَیْلَۃٍ۔","","Musannaf Ibn Abi Shaybah 24332","","","كتاب الأشربة"
"24333","(۲۴۳۳۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ دِینَارٍ ، عَنِ الْحَسَنِ ، قَالَ : اشْرَبِ الْعَصِیرَ مَا لَمْ یَتَغَیَّرْ۔","No Data Available","Musannaf Ibn Abi Shaybah 24333","","","كتاب الأشربة"
"24334","(۲۴۳۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ سُئِلَ عَنِ الْعَصِیرِ ؟ قَالَ : اشْرَبْہُ مَا لَمْ یَأْخُذْہُ شَیْطَانُہُ ، قِیلَ : وَفِی کَمْ یَأْخُذُہُ شَیْطَانُہُ ؟ قَالَ : فِی ثَلاَثٍ۔","Sahih","Musannaf Ibn Abi Shaybah 24334","","","كتاب الأشربة"
"24335","(۲۴۳۳۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا بَشِیرُ بْنُ عُقْبَۃَ ، قَالَ : سَأَلْتُ ابْنَ سِیرِینَ عَنْ عَصِیرِ الْعِنَبِ ؟ فَقَالَ : عَصِیرُ یَوْمِہِ فِی مَعْصَرَتِہِ ، قَالَ : اشْرَبْہُ فِی یَوْمِہِ ، فَإِنِّی أَکْرَہُ إِذَا حُوِّلَ فِی إِنَائٍ ، أَوْ وِعَائٍ ، وَقَالَ : عَلَیْکُمْ بِسُلاَفَۃِ الْعِنَبِ ، فَإِنَّہَا أَطْیَبُہُ ، فَاشْرَبْہُ۔","","Musannaf Ibn Abi Shaybah 24335","","","كتاب الأشربة"
"24336","(۲۴۳۳۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَاسْتَسْقَی ، فَقَالَ رَجُلٌ : أَلاَ نُسْقِیکَ نَبِیذًا ؟ قَالَ : بَلَی ، قَالَ : فَخَرَجَ الرَّجُلُ یَشْتَدُّ ، فَجَائَ بِقَدَحٍ فِیہِ نَبِیذٌ ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَلاَ خَمَّرْتَہُ وَلَوْ أَنْ تَعْرُضَ عَلَیْہِ عُودًا۔\n(مسلم ۹۴۔ ابوداؤد ۳۷۲۷)","Shadh","Musannaf Ibn Abi Shaybah 24336","","","كتاب الأشربة"
"24337","(۲۴۳۳۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَتَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ السِّقَایَۃَ ، فَقَالَ : اُسْقُونِی مِنْ ہَذَا ، فَقَالَ الْعَبَّاسُ : أَلاَ نَسْقِیکَ مِمَّا نَصْنَعُ فِی الْبُیُوتِ؟ قَالَ : لاَ ، وَلَکِنَ اسْقُونِی مِمَّا یَشْرَبُ النَّاسُ ، قَالَ : فَأُتِیَ بِقَدَحٍ مِنْ نَبِیذٍ فَذَاقَہُ فَقَطَّبَ ، ثُمَّ قَالَ : ہَلُمُّوا مَائً ، فَصَبَّہُ عَلَیْہِ ، ثُمَّ قَالَ : زِدْ فِیہِ ، مَرَّتَیْنِ ، أَوْ ثَلاَثًا ، ثُمَّ قَالَ : إِذَا أَصَابَکُمْ ہَذَا فَاصْنَعُوا بِہِ ہَکَذَا۔\n(دارقطنی ۸۱)","Da'if","Musannaf Ibn Abi Shaybah 24337","","","كتاب الأشربة"
"24338","(۲۴۳۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنْ قُرَّۃَ الْعِجْلِیّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ الْقَعْقَاعِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنَّا عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأُتِیَ بِقَدَحٍ فِیہِ شَرَابٌ ، فَقَرَّبَہُ ثُمَّ رَدَّہُ ، فَقَالَ لَہُ بَعْضُ جُلَسَائِہِ : حَرَامٌ ہُوَ یَا رَسُولَ اللہِ ؟ قَالَ : فَقَالَ : رُدُّوہُ ، فَرَدُّوہُ ، ثُمَّ دَعَا بِمَائٍ فَصَبَّہُ عَلَیْہِ ، ثُمَّ شَرِبَ ، فَقَالَ : اُنْظُرُوا ہَذِہِ الأَشْرِبَۃَ ، إِذَا اغْتَلَمَتْ عَلَیْکُمْ فَاقْطَعُوا مُتُونَہَا بِالْمَائِ ۔ (نسائی ۵۲۰۵۔ بیہقی ۳۰۵)","Da'if","Musannaf Ibn Abi Shaybah 24338","","","كتاب الأشربة"
"24339","(۲۴۳۳۹) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ خَالِدِ بْنِ سَعْدٍ ، عَنْ أَبِی مَسْعُودٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَطِشَ وَہُوَ یَطُوفُ بِالْبَیْتِ حَوْلَ الْکَعْبَۃِ ، فَاسْتَسْقَی فَأُتِیَ بِنَبِیذٍ مِنَ السِّقَایَۃِ ، فَشَمَّہُ فَقَطَّبَ، فَقَالَ: عَلَیَّ بِذَنُوبٍ مِن زَمْزَمَ، فَصَبَّ عَلَیْہِ وَشَرِبَ، فَقَالَ رَجُلٌ: حَرَامٌ ہُوَ یَا رَسُولَ اللہِ؟ فَقَالَ: لاَ۔ \n(نسائی ۵۲۱۲۔ بیہقی ۳۰۴)","","Musannaf Ibn Abi Shaybah 24339","","","كتاب الأشربة"
"24340","(۲۴۳۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُنْبَذُ لَہُ فِی سِقَائٍ ، فَإِذَا لَمْ یَکُنْ سِقَائٌ ، نُبِذَ لَہُ فِی تَوْرٍ ۔ قَالَ أَشْعَثُ : وَالتَّوْرُ مِنْ لِحَائِ الشَّجَرِ۔\n(مسلم ۱۵۸۴۔ ابوداؤد ۳۶۹۵)","Da'if","Musannaf Ibn Abi Shaybah 24340","","","كتاب الأشربة"
"24341","(۲۴۳۴۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ زَاذَانَ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ النَّبِیذِ ؟ فَقُلْتُ لَہُ : إِنَّ لَنَا لُغَۃً غَیْرَ لُغَتِکُمْ ، فَفَسِّرْہُ لَنَا بِلُغَتِنَا ، فَقَالَ ابْنُ عُمَرَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْحَنْتَمَۃِ ، وَہِیَ الْجَرَّۃُ ، وَنَہَی عَنِ الدُّبَّائِ ، وَہِیَ الْقَرْعَۃُ ، وَعَنِ الْمُزَفَّتِ وَہِیَ الْمُقَیَّرُ ، وَعَنِ النَّقِیرِ ، وَہِیَ النَّخْلَۃُ ، وَأَمَرَ أَنْ یُنْبَذَ فِی الأَسْقِیَۃِ۔ (مسلم ۱۵۸۳۔ ترمذی ۱۸۶۸)","Sahih","Musannaf Ibn Abi Shaybah 24341","","","كتاب الأشربة"
"24342","(۲۴۳۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، عَنْ أُمَیْنَۃَ ؛ أَنَّہَا سَمِعَتْ عَائِشَۃَ تَقُولُ : أَتَعْجِزُ إِحْدَاکُنَّ أَنْ تَتَّخِذَ مِنْ مَسْکِ أُضْحِیَّتِہَا سِقَائً فِی کُلِّ عَامٍ ، فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی ، أَوْ مَنَعَ عَنْ نَبِیذِ الْجَرِّ ، وَالْمُزَفَّتِ ، وَأَشْیَائَ نَسِیَہَا التَّیْمِیُّ۔","Da'if","Musannaf Ibn Abi Shaybah 24342","","","كتاب الأشربة"
"24343","(۲۴۳۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ سِمَاکٍ ، عَنْ رَجُلٍ ؛ أَنَّہُ سَأَلَ الْحَسَنَ بْنَ عَلِیٍّ عَنِ النَّبِیذِ ؟ فَقَالَ : اشْرَبْ ، فَإِذَا رَہِبْتَ أَنْ تَسْکَرَ فَدَعْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24343","","","كتاب الأشربة"
"24344","(۲۴۳۴۴) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنْ نَبِیذِ السِّقَائِ الَّذِی یُوکَی وَیُعَلَّقُ ؟ فَقَالَ : لاَ أَعْلَمُ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 24344","","","كتاب الأشربة"
"24345","(۲۴۳۴۵) حَدَّثَنَا خَالِدُ بْنُ حَرْمَلَۃَ الْعَبْدِیُّ ، عَنِ الْوَلِیدِ بْنِ عَمْرٍو ابْنِ أَخِی أَبِی نَضْرَۃَ ؛ أَنَّہُ سَأَلَ الْحَسَنَ عَنِ الْجُفِّ ؟ فَقَالَ : وَمَا الْجُفُّ ؟ قَالَ : سِقَائٌ عَلَی ثَلاَثِ قَوَائِمَ ، یُوکَی مِنْ أَعْلاَہ وَمِنْ أَسْفَلِہِ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 24345","","","كتاب الأشربة"
"24346","(۲۴۳۴۶) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ، عَنْ عَمْرِو بْنِ مَیْمُونٍ، قَالَ: قَالَ عُمَرُ: إِنَّا نَشْرَبُ ہَذَا الشَّرَابَ الشَّدِیدَ ، لِنَقْطَعَ بِہِ لُحُومَ الإِبِلِ فِی بُطُونِنَا أَنْ یُؤْذِیَنَا ، فَمَنْ رَابَہُ مِنْ شَرَابِہِ شَیْئٌ ، فَلْیَمْزُجْہُ بِالْمَائِ ۔","Sahih","Musannaf Ibn Abi Shaybah 24346","","","كتاب الأشربة"
"24347","(۲۴۳۴۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ قَیْسِ بْنِ أَبِی حَازِمٍ ، قَالَ : حَدَّثَنِی عُتْبَۃُ بْنُ فَرْقَدٍ ، قَالَ : قَدِمْتُ عَلَی عُمَرَ ، فَدَعَا بِعُسٍّ مِنْ نَبِیذٍ قَدْ کَادَ یَصِیرُ خَلاًّ ، فَقَالَ : اشْرَبْ ، فَأَخَذْتُہُ فَشَرِبْتُہُ ، فَمَا کِدْتُ أَنْ أَسِیغَہُ ، ثُمَّ أَخَذَہُ فَشَرِبَہُ ، ثُمَّ قَالَ : یَا عُتْبَۃُ ، إِنَّا نَشْرَبُ ہَذَا النَّبِیذَ الشَّدِیدَ لِنَقْطَعَ بِہِ لُحُومَ الإِبِلِ فِی بُطُونِنَا أَنْ یُؤْذِیَنَا۔","Sahih","Musannaf Ibn Abi Shaybah 24347","","","كتاب الأشربة"
"24348","(۲۴۳۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن ہَمَّامٍ ، قَالَ : أُتِیَ عُمَرُ بِنَبِیذِ زَبِیبٍ مِنْ نَبِیذِ زَبِیبِ الطَّائِفِ ، قَالَ : فَلَمَّا ذَاقَہُ قَطَّبَ فَقَالَ : إِنَّ لِنَبِیذِ زَبِیبِ الطَّائِفِ لَعُرَامًا ، ثُمَّ دَعَا بِمَائٍ فَصَبَّہُ عَلَیْہِ فَشَرِبَ ، وَقَالَ : إِذَا اشْتَدَّ عَلَیْکُمْ فَصُبُّوا عَلَیْہِ الْمَائَ وَاشْرَبُوا۔","Sahih","Musannaf Ibn Abi Shaybah 24348","","","كتاب الأشربة"
"24349","(۲۴۳۴۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّ قَوْمًا مِنْ ثَقِیفٍ لَقُوا عُمَرَ بْنَ الْخَطَّابِ وَہُوَ قَرِیبٌ مِنْ مَکَّۃَ ، فَدَعَاہُمْ بِأَنْبِذَتِہِمْ ، فَأَتَوْہُ بِقَدَحٍ مِنْ نَبِیذٍ فَقَرَّبَہُ مِنْ فِیہِ ، ثُمَّ دَعَا بِمَائٍ فَصَبَّہُ عَلَیْہِ مَرَّتَیْنِ ، أَوْ ثَلاَثًا ، فَقَالَ : اکْسِرُوہُ بِالْمَائِ ۔","Sahih","Musannaf Ibn Abi Shaybah 24349","","","كتاب الأشربة"
"24350","(۲۴۳۵۰) حَدَّثَنَا شَرِیکٌ، عَنْ إِبْرَاہِیمَ ، عَن مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : إِنِّی رَجُلٌ مِعْجَارُ الْبَطْنِ ، أَوْ مِشْعَارُ الْبَطْنِ، فَأَشْرَبُ ہَذَا السَّوِیقَ فَلاَ یُلاَئِمُنِی ، وَأَشْرَبُ ہَذَا اللَّبَنَ فَلاَ یُلاَئِمُنِی ، وَأَشْرَبُ ہَذَا النَّبِیذَ الشَّدِیدَ فَیُسَہِّلُ بَطْنِی۔","","Musannaf Ibn Abi Shaybah 24350","","","كتاب الأشربة"
"24351","(۲۴۳۵۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ عِمْرَانَ بْنِ مُسْلِمٍ ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : کُنْتُ أَشْرَبُ النَّبِیذَ مَعَ أَبِی الدَّرْدَائِ وَأَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالشَّامِ ، فِی الْحِبَابِ الْعِظَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 24351","","","كتاب الأشربة"
"24352","(۲۴۳۵۲) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَنِ الشَّمَّاسِ ، قَالَ : قَالَ عَبْدُ اللہِ : مَا یَزَالُ الْقَوْمُ وَإِنَّ شَرَابَہُمْ لَحَلاَلٌ ، حَتَّی یَصِیرَ عَلَیْہِمْ حَرَامًا۔","Da'if","Musannaf Ibn Abi Shaybah 24352","","","كتاب الأشربة"
"24353","(۲۴۳۵۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، قَالَ : لَمَّا طُعِنَ عُمَرُ أَتَاہُ الطَّبِیبُ ، فَقَالَ : أَیُّ الشَّرَابِ أَحَبَّ إِلَیْک ؟ قَالَ : النَّبِیذُ۔","Sahih","Musannaf Ibn Abi Shaybah 24353","","","كتاب الأشربة"
"24354","(۲۴۳۵۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ أَبِی حَصِینٍ ، قَالَ : رَأَیْتُ زِرَّ بْنَ حُبَیْشٍ یَشْرَبُ نَبِیذَ الْخَوَابِی۔","","Musannaf Ibn Abi Shaybah 24354","","","كتاب الأشربة"
"24355","(۲۴۳۵۵) حَدَّثَنَا حَفْصٌ ، عَنْ حُمَیْدِ بْنِ سُلَیْمَانَ ، عَنْ مُجَاہِدٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : کُنْت أَنْبِذُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکُنْت آخُذُ الْقُبْضَۃَ مِنَ الزَّبِیبِ فَأُلْقِیہَا فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 24355","","","كتاب الأشربة"
"24356","(۲۴۳۵۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، قَالَ : قَالَ عَامِرٌ : اشْرَبُوا نَبِیذَ الْعُرْسِ ، وَلاَ تَسْکَرُوا مِنْہُ۔","","Musannaf Ibn Abi Shaybah 24356","","","كتاب الأشربة"
"24357","(۲۴۳۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عِیسَی بْنِ الْمُسَیَّبِ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ أَبِی لَیْلَی ، قَالَ : أَشْہَدُ عَلَی الْبَدْرِیِّینَ أَنَّہُمْ کَانُوا یَشْرَبُونَ نَبِیذَ الْعُرْسِ۔","Da'if","Musannaf Ibn Abi Shaybah 24357","","","كتاب الأشربة"
"24358","(۲۴۳۵۸) حَدَّثَنَا أَبُو مُعاویَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ ، عَنْ أَبِیہِ ، عَنْ أَبِی ذَرٍّ ، قَالَ : یَکْفِینِی کُلَّ یَوْمٍ شَرْبَۃٌ مِنْ مَائٍ ، أَوْ شَرْبَۃٌ مِنْ نَبِیذٍ ، أَوْ شَرْبَۃٌ مِنْ لَبَنٍ ، وَفِی الْجُمُعَۃِ قَفِیزٌ مِنْ قَمْحٍ۔","Sahih","Musannaf Ibn Abi Shaybah 24358","","","كتاب الأشربة"
"24359","(۲۴۳۵۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ عَنِ النَّبِیذِ الشَّدِیدِ ؟ فَقَالَ : جَلَسَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَجْلِسًا بِمَکَّۃَ ، فَجَائَ ہُ رَجُلٌ فَجَلَسَ إِلَی جَنْبِہِ ، فَوَجَدَ مِنْہُ رِیحًا شَدِیدَۃً ، فَقَالَ : مَا ہَذَا الَّذِی شَرِبْتَ ؟ فَقَالَ : نَبِیذٌ ، فَقَالَ : جِئْنِی مِنْہُ ، قَالَ : فَدَعَا بِمَائٍ فَصَبَّہُ عَلَیْہِ وَشَرِبَ ، ثُمَّ قَالَ : إِذَا اغْتَلَمَتْ عَلَیْکُم أَسْقِیَتُکُمْ فَاکْسِرُوہَا بِالْمَائِ ۔","Da'if","Musannaf Ibn Abi Shaybah 24359","","","كتاب الأشربة"
"24360","(۲۴۳۶۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : صَنَعْتُ طَعَامًا فَدَعَوْتُ أَصْحَابَ عَبْدِاللہِ؛ عَمْرَو بْنَ شُرَحْبِیلَ، وَعَبْدَ اللہ بْنَ ذِئْبٍ، وَعُمَارَۃَ، وَمُرَّۃَ الْہَمْدَانِیَّ، وَعَمْرَو بْنَ مَیْمُونٍ فَسَقَیْتہمُ النَّبِیذَ وَالطِّلاَ فَشَرِبُوا ، فَقَالَ الأَعْمَشُ : قُلْتُ لَہُ : کَانُوا یَرَوْنَ الْخَوَابِی ؟ قَالَ : نَعَمْ ، کَانُوا یَنْظُرُونَ إِلَیْہَا وَہُمْ یَسْتَقُونَ مِنْہَا۔","","Musannaf Ibn Abi Shaybah 24360","","","كتاب الأشربة"
"24361","(۲۴۳۶۱) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَشْرَبُ النَّبِیذَ ، یُنْبَذُ لَہُ غَدْوَۃً فَیَشْرَبُہُ عَشِیَّۃً۔","","Musannaf Ibn Abi Shaybah 24361","","","كتاب الأشربة"
"24362","(۲۴۳۶۲) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ أَبِی حَیَّانَ، عَنْ یُوسُفَ، قَالَ: کَانَ الْحَسَنُ یُدْعَی إِلَی الْعُرْسِ، فَیَشْرَبُ مِنْ نَبِیذِہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 24362","","","كتاب الأشربة"
"24363","(۲۴۳۶۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : أَعْرَسْتُ فَدَعَوْتُ أَصْحَابَ عَلِیٍّ ، وَأَصْحَابَ عَبْدِ اللہِ ، مِنْ أَصْحَابِ عَلِیٍّ ؛ عُمَارَۃُ بْنُ عَبْدٍ ، وَہُبَیْرَۃُ بْنُ یَرِیْمَ ، وَالْحَارِثُ الأَعْوَرُ ، وَمِنْ أَصْحَابِ عَبْدِ اللہِ ؛ عَلْقَمَۃُ بْنُ قَیْسٍ ، وَعَبْدُ الرَّحْمَن بْنُ یَزِیدَ ، وَعَبْدُ اللہ بْنُ ذِئْبٍ ، فَنَبَذْت لَہُمْ فِی الْخَوَابِی ، فَکَانُوا یَشْرَبُونَ مِنْہَا ، فَقُلْتُ : وَہُمْ یَرَوْنَہَا ؟ قَالَ : نَعَمْ ، یَنْظُرُونَ إِلَیْہَا۔","","Musannaf Ibn Abi Shaybah 24363","","","كتاب الأشربة"
"24364","(۲۴۳۶۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : النَّبِیذُ حَلاَلٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 24364","","","كتاب الأشربة"
"24365","(۲۴۳۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ سُفْیَانَ الْعَطَّارِ ، قَالَ : سَأَلَ رَجُلٌ مَاہَانَ الْحَنَفِیَّ ، فَقَالَ : یَا أَبَا سَالِمٍ ، مَا تَقُولُ فِی النَّبِیذِ ؟ فَقَالَ : أَقُولُ فِی النَّبِیذِ : إِنَّ مَنْ حَرَّمَ مَا أَحَلَّ اللَّہُ ، کَمَنْ أَحَلَّ مَا حَرَّمَ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 24365","","","كتاب الأشربة"
"24366","(۲۴۳۶۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْعَلاَئِ ، قَالَ : انْتَہَی قَوْلُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی الأَشْرِبَۃِ إِلَی أَنْ قَالَ : لاَ تَشْرَبُوا مَا یُسَفِّہُ أَحْلاَمَکُمْ ، وَمَا یُذْہِبُ أَمْوَالَکُمْ۔","","Musannaf Ibn Abi Shaybah 24366","","","كتاب الأشربة"
"24367","(۲۴۳۶۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَاصِمٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّہُ کَانَ لاَ یَنْبِذُ إِلاَّ فِی سِقَائٍ مُوکی۔","","Musannaf Ibn Abi Shaybah 24367","","","كتاب الأشربة"
"24368","(۲۴۳۶۸) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرٍو ، عَنْ عُجِیبَۃَ بْنِ عَبْدِ الْحَمِیدِ ، عَنْ عَمِّہِ قَیْسِ بْنِ طَلْقٍ ، عَنْ أَبِیہِ طَلْقِ بْنِ عَلِیٍّ، قَالَ : جَلَسْنَا عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَجَائَ وَفْدُ عَبْدِ الْقَیْسِ فَقَالَ : مَا لَکُمْ قَدِ اصْفَرَّتْ أَلْوَانُکُمْ ، وَعَظُمَتْ بُطُونُکُمْ ، وَظَہَرَتْ عُرُوقُکُمْ ؟ قَالَ : قَالُوا : أَتَاکَ سَیِّدُنَا فَسَأَلَکَ عَنْ شَرَابٍ کَانَ لَنَا مُوَافِقًا فَنَہَیْتَہُ عَنْہُ ، وَکُنَّا بِأَرْضٍ مُحِِمَّۃٍ ، قَالَ : فَاشْرَبُوا مَا طَابَ لَکُمْ۔ (طبرانی ۸۲۵۶)","Hasan","Musannaf Ibn Abi Shaybah 24368","","","كتاب الأشربة"
"24369","(۲۴۳۶۹) حَدَّثَنَا جَرِیر ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ خَیرَ فِی النَبِیذِ إِذَا کَان حُلوًا۔","","Musannaf Ibn Abi Shaybah 24369","","","كتاب الأشربة"
"24370","(۲۴۳۷۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، قَالَ : دَعَانَا رَجُلٌ إِلَی طَعَامٍ فَأَکَلْنَا ، ثُمَّ أَتَانَا بِشَرَابٍ ، فَشَرِبَ الْقَوْمُ وَلَمْ أَشْرَبْ ، قَالَ : فَنَظَرَ إِلَیَّ بَکْرٌ ، یَعْنِی ابْنَ مَاعِزٍ ، نَظْرَۃً ظَنَنْتُ أَنَّہُ مَقَتَنِی۔","","Musannaf Ibn Abi Shaybah 24370","","","كتاب الأشربة"
"24371","(۲۴۳۷۱) حَدَّثَنَا یَزِیدُ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا دَخَلْتْ عَلَی أَخِیکَ ، فَسَلْہُ عَنْ شَرَابِہِ ، فَإِنْ کَانَ نَبِیذُ سِقائٍ فَاشْرَبْ۔","","Musannaf Ibn Abi Shaybah 24371","","","كتاب الأشربة"
"24372","(۲۴۳۷۲) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ أَبِی مِسْکِینٍ ، عَنْ ہُزَیْلِ بْنِ شُرَحْبِیلَ ، قَالَ : مَرَّ عُمَرُ بْنُ الْخَطَّابِ عَلَی ثَقِیفٍ فَاسْتَسْقَاہُمْ ، فَقَالُوا : أَخْبِؤُوا نَبِیذَکُمْ ، فَسَقَوْہُ مَائً ، فَقَالَ : اسْقُونِی مِنْ نَبِیذِکُمْ یَا مَعْشَرَ ثَقِیفٍ ، قَالَ : فَسَقَوْہُ ، فَأَمَرَ الْغُلاَمَ فَصَبَّ ، ثُمَّ أَمْسَکَ بِیَدِہِ ، ثُمَّ قَالَ : یَا مَعْشَرَ ثَقِیفٍ ، إِنَّکُمْ تَشْرَبُونَ مِنْ ہَذَا الشَّرَابِ الشَّدِیدِ ، فَأَیَّکُمْ رَابَہُ مِنْ شَرَابِہِ شَیْئٌ ، فَلْیَکْسِرْہُ بِالْمَائِ ۔","","Musannaf Ibn Abi Shaybah 24372","","","كتاب الأشربة"
"24373","(۲۴۳۷۳) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الأَسْوَدِ ، قَالَ : کَانَ عَبْدُ اللہِ یُنْبَذُ لَہُ فِی الْجَرِّ الأَخْضَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 24373","","","كتاب الأشربة"
"24374","(۲۴۳۷۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْمجَالِدِ بْنِ أَبِی رَاشِدٍ ، قَالَ : دَخَلَ عَمْرُو بْنُ حُرَیْثٍ عَلَی عَبْدِ اللہِ فِی حَاجَۃٍ ، قَالَ : فَقَالَ عَبْدُ اللہِ : یَا جَارِیَۃُ ، اسْقِینَا نَبِیذًا ، فَسَقَتْہُ مِنْ جَرٍّ أَخْضَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 24374","","","كتاب الأشربة"
"24375","(۲۴۳۷۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ خَالِدِ بْنِ سَعْدٍ ، عَنْ أُمِّ وَلَدٍ لأَبِی مَسْعُودٍ الأَنْصَارِیِّ ، قَالَتْ : کُنْتُ أَنْبِذُ لأَبِی مَسْعُودٍ فِی الْجَرِّ الأَخْضَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 24375","","","كتاب الأشربة"
"24376","(۲۴۳۷۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی الْحَارِثِ التَّیْمِیِّ ، عَنْ أُمِّ مَعْبَدٍ ، قَالَ : قَالَتْ : یَا بُنَیَّ ، إِنَّ مُحَرِّمَ مَا أَحَلَّ اللَّہُ ، کَمُسْتَحِلِّ مَا حَرَّمَ اللَّہُ، إِنِّی کُنْتُ أَنْبِذُ النَّبِیذَ لِقَرَظَۃَ بْنِ کَعْبٍ، وَکَانَ رَجُلاً قَدْ آتَاہُ اللَّہُ خَیْرًا کَثِیرًا، فَیَسْقِیہِ أَصْحَابَ مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَکَانَ یَغْشَاہُ مِنْہُمْ ؛ مُعَاذُ بْنُ جَبَلٍ ، وَزَیْدُ بْنُ أَرْقَمَ ، فِی الدَّنِّ الْمُزَفَّتِ ، وَالْجَرِّ الأَخْضَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 24376","","","كتاب الأشربة"
"24377","(۲۴۳۷۷) حَدَّثَنَا وَکِیعٌ، عَنِ الْحَسَنِ بْنِ حَکِیمٍ، عَنْ أُمِّہِ؛ أَنَّ أَبَا بَرْزَۃَ کَانَ یَرَی أَہْلَہُ یَنْبِذُونَ فِی الْجَرِّ، وَلاَ یَنْہَاہُمْ۔","Da'if","Musannaf Ibn Abi Shaybah 24377","","","كتاب الأشربة"
"24378","(۲۴۳۷۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُسْلِمٍ ، قَالَ : کَانَ ابْنُ أَبِی أَوْفَی یَشْرَبُ نَبِیذَ الْجَرِّ الأَخْضَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 24378","","","كتاب الأشربة"
"24379","(۲۴۳۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ أُم مُوسَی ، قَالتْ : کُنْتُ أَنْبِذُ لعَلِیٍّ فِی الْجَرِّ الأَخْضَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 24379","","","كتاب الأشربة"
"24380","(۲۴۳۸۰) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنْ أَبِی ہَارُونَ الْغَنَوِیِّ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : صَنَعَ قَیْسُ بْنُ عُبَادٍ لأُنَاسٍ مِنَ الْقُرَّائِ طَعَامًا ، ثُمَّ سَقَاہُمْ نَبِیذًا ، ثُمَّ قَالَ : تَدْرُونَ مَا النَّبِیذُ الَّذِی سَقَیْتُکُمْ ؟ قَالُوا : نَعَمْ ، سَقَیْتنَا نَبِیذًا ، قَالَ : لاَ ، وَلَکِنَّہُ نَبِیذُ جَرٍّ ، أَوْ جِرَارٍ ، ثُمَّ انْطَلَقَ إِلَی مَعْقِلِ بْنِ یَسَارٍ ، قَالَ : فَقَالَ : فِیمَا یُنْبَذُ لَکَ ؟ فَدَعَا الْجَارِیَۃَ ، فَجَائَ تْ بِجَرٍّ أَخْضَرَ ، فَقَالَ : یُنْبَذُ لِی فِی ہَذَا۔","Sahih","Musannaf Ibn Abi Shaybah 24380","","","كتاب الأشربة"
"24381","(۲۴۳۸۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ ثَعْلَبَۃَ ، قَالَ : دَخَلْتُ عَلَی أَنَسِ بْنِ مَالِکٍ ، فَأَکَلْنَا عِنْدَہُ ، ثُمَّ دَعَا بِجُرَیرَۃٍ خَضْرَائَ فِیہَا نَبِیذٌ ، فَسَقَانَا۔","Da'if","Musannaf Ibn Abi Shaybah 24381","","","كتاب الأشربة"
"24382","(۲۴۳۸۲) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن ہَمَّامٍ ، قَالَ : کَانَ یُنْبَذُ لِعَبْدِ اللہِ النَّبِیذُ فِی جِرَارٍ خُضْرٍ فَیَشْرَبُہُ ، وَکَانَ یُنْبَذُ لأُسَامَۃَ بْنِ زَیْدٍ فِی جَرٍّ أَخْضَرَ فَیَشْرَبُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24382","","","كتاب الأشربة"
"24383","(۲۴۳۸۳) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ شَقِیقٍ ، قَالَ : کَانَ ابْنُ مَسْعُودٍ یُنْبَذُ لَہُ فِی الْجَرِّ الأَخْضَرِ ، وَکَانَ شَقِیقٌ یَشْرَب النَبِیذَ فِی الْجَرِّ الأَخْضَر۔","Sahih","Musannaf Ibn Abi Shaybah 24383","","","كتاب الأشربة"
"24384","(۲۴۳۸۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ ، وَأَبِی مَسْعُودٍ ، وَأُسَامَۃَ ؛أَنَّہُمْ کَانُوا یَشْرَبُونَ نَبِیذَ الْجَرِّ۔","","Musannaf Ibn Abi Shaybah 24384","","","كتاب الأشربة"
"24385","(۲۴۳۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : رَأَیْتُ عَبْدَ الرَّحْمَن بْنَ أَبِی لَیْلَی یَشْرَبُ نَبِیذَ الْجَرِّ الأَخْضَرِ ، بَعْدَ مَا یَسْکُنُ غَلَیَانُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24385","","","كتاب الأشربة"
"24386","(۲۴۳۸۶) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ، عَنْ أَبِی فَرْوَۃَ، قَالَ: سَقَانِی عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی فِی جَرٍّ أَخْضَرَ، وَفِیہِ دُرْدِیٌّ ، وَسَقَیْتُہُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 24386","","","كتاب الأشربة"
"24387","(۲۴۳۸۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَبِی فَرْوَۃَ الْجُہَنِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنْ عَبْدِ اللہِ ، قَالَ : کَانَ یَشْرَبُ نَبِیذَ الْجَرِّ الأَخْضَرِ۔","Sahih","Musannaf Ibn Abi Shaybah 24387","","","كتاب الأشربة"
"24388","(۲۴۳۸۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ عَمْرُو بْنُ شُرَحْبِیلَ یَنْبِذُ فِی الدَّنِّ ، وَیَنْبِذُ فِی الْجَرِّ الأَخْضَرِ۔","","Musannaf Ibn Abi Shaybah 24388","","","كتاب الأشربة"
"24389","(۲۴۳۸۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ ابْنُ الْحَنَفِیَّۃِ یَشْرَبُ نَبِیذَ الْجَرِّ الأَخْضَرِ۔","","Musannaf Ibn Abi Shaybah 24389","","","كتاب الأشربة"
"24390","(۲۴۳۹۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حُمْرَانَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ : حدَّثَتْنِی أُمُّ حَفْصٍ ، قَالَتْ : کُنْتُ أَنْبِذُ لِعِمْرَانَ بْنِ حُصَیْنٍ فِی جَرٍّ۔ (ابن سعد ۲۹۰)","Da'if","Musannaf Ibn Abi Shaybah 24390","","","كتاب الأشربة"
"24391","(۲۴۳۹۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، عَنْ مَسْرُوقٍ ؛ أَنَّہُ کَانَ یَشْرَبُ نَبِیذَ الْجَرِّ۔","","Musannaf Ibn Abi Shaybah 24391","","","كتاب الأشربة"
"24392","(۲۴۳۹۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، قَالَ : دَخَلْتُ عَلَی إِبْرَاہِیمَ ، وَالشَّعْبِیِّ ، وَہِلاَلِ بْنِ یَسَاف ، وَشَقِیقٍ ، وَسَعِیدِ بْنِ جُبَیْرٍ وَہُمْ فِی بُیُوتِہِمْ ، فَرَأَیْتہمْ یَشْرَبُونَ نَبِیذَ الْجَرِّ الأَخْضَرِ۔","","Musannaf Ibn Abi Shaybah 24392","","","كتاب الأشربة"
"24393","(۲۴۳۹۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ؛ أَنَّہُ دَعَاہُمْ فِی عُرْسِہِ ، فَسَقَاہُمْ نَبِیذَ جَرٍّ أَخْضَرَ ، قَالَ : وَکَانَ إِبْرَاہِیمُ یَدْعُوہُمْ فِی عُرْسِہِ فَیَسْقِیہِمْ فِی جَرٍّ أَخْضَرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 24393","","","كتاب الأشربة"
"24394","(۲۴۳۹۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَالِکِ بْنِ دِینَارٍ ، عَنْ أَبِی رَافِعٍ ؛ أَنَّہُ کَانَ یَشْرَبُ نَبِیذَ الْجَرِّ۔","","Musannaf Ibn Abi Shaybah 24394","","","كتاب الأشربة"
"24395","(۲۴۳۹۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : إِنَّا نَنْبِذُ فِی الْجَرِّ الأَخْضَرِ ، ثُمَّ نُضِیفُہُ فِی الدَّوْرَقِ الْمُقَیَّرِ ، أَوْ فِی الإِنَائِ الْمُقَیَّرِ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 24395","","","كتاب الأشربة"
"24396","(۲۴۳۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حُمْرَانَ بْنِ عَبْدِ الْعَزِیزِ ، قَالَ حَدَّثَتْنِی أُمُّ حَفْصٍ سُرِّیَّۃُ عِمْرَانَ بْنِ حُصَیْنٍ ، قَالَتْ : کُنْت أَنْتَبِذُ لِعِمْرَانَ بْنِ حُصَیْنٍ فِی الْجَرِّ الأَخْضَرِ فَیَشْرَبُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24396","","","كتاب الأشربة"
"24397","(۲۴۳۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مَالِکٍ ، عَنِ الضَّحَّاکِ ؛ أَنَّہُ کَانَ یَشْرَبُ نَبِیذَ السَّوِیقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24397","","","كتاب الأشربة"
"24398","(۲۴۳۹۸) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ أَبِی عَوَانَۃَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَخِیہِ عِیسَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی، قَالَ: کُنْتُ أَشْرَبُ النَّبِیذَ فِی الْجِرَارِ الْخُضْرِ، مَعَ الْبَدْرِیَّۃِ مِنْ أَصحَاب مُحَمَّدٍ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","Da'if","Musannaf Ibn Abi Shaybah 24398","","","كتاب الأشربة"
"24399","(۲۴۳۹۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ غَیْلاَنَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : رَأَیْتُ أَبَا عُبَیْدَۃَ بْنَ عَبْدِ اللہِ بْنِ مَسْعُودٍ یَشْرَبُ النَّبِیذَ فِی جَرٍّ أَخْضَرَ ، وَقَالَ : إِنَّ مُحَرِّمَ مَا أَحَلَّ اللَّہُ ، کَمُسْتَحِلِّ مَا حَرَّمَ اللَّہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24399","","","كتاب الأشربة"
"24400","(۲۴۴۰۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، قَالَ : شَرِبْتُہُ عِنْدَ إِبْرَاہِیمَ نَبِیذًا فِی جَرٍّ أَخْضَرَ۔","","Musannaf Ibn Abi Shaybah 24400","","","كتاب الأشربة"
"24401","(۲۴۴۰۱) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی الْمُغِیرَۃِ ، عَنْ أَبِیہِ ؛ أَنَّ أَبَا بَرْزَۃَ کَانَ یُنْبَذُ لَہُ فِی جَرٍّ أَخْضَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 24401","","","كتاب الأشربة"
"24402","(۲۴۴۰۲) حَدَّثَنَا عَبْدُ الصَّمَدِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی رَافِعٍ ؛ أَنَّ أَبَاہُ کَانَ یُنْبَذُ لَہُ فِی جَرٍّ، فَکَانَ یَشْرَبُہُ حُلْوًا بِالسَّوِیقِ۔","Hasan","Musannaf Ibn Abi Shaybah 24402","","","كتاب الأشربة"
"24403","(۲۴۴۰۳) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ یُنْبَذُ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی جَرٍّ أَخْضَرَ۔ (طبرانی ۷۴۲۸)","Da'if","Musannaf Ibn Abi Shaybah 24403","","","كتاب الأشربة"
"24404","(۲۴۴۰۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الضَّحَّاکِ بْنِ یَسَارٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ الشِّخِّیرِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ صُحَارٍ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، إِنِّی رَجُلٌ مِسْقَامٌ ، فَأْذَنْ لِی فِی جَرَّۃٍ أَنْتَبِذُ فِیہَا ، فَأَذِنَ لِی۔ \n(احمد ۳۱۔ بزار ۲۹۱۰)","Da'if","Musannaf Ibn Abi Shaybah 24404","","","كتاب الأشربة"
"24405","(۲۴۴۰۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حَدَّثَنَا مِسْعَرٌ ، عَنْ سَہْلٍ أَبِی الأَسْدِ ، عَنْ مُسْرَدٍ ، قَالَ : کَانَ نَبِیذُ سَعْدٍ فِی جَرَّۃٍ خَضْرَائَ ، قَالَ : وَقَالَ : لاَ تَقُلْ اسْقِنِی مُحَطَّمًا۔","Da'if","Musannaf Ibn Abi Shaybah 24405","","","كتاب الأشربة"
"24406","(۲۴۴۰۶) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ سِمَاکِ بْنِ حَرْبٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ: حدَّثَتْنِی أُمُّ أَبِی عُبَیْدَۃَ، أَوْ أُمُّ عُبَیْدَۃَ أَنَّہُمْ کَانُوا یَنْبِذُونَ فِی الْجَرِّ الأَخْضَرِ، فَیَرَاہُمْ عَبْدُ اللہِ وَلاَ یَنْہَی عَنْ ذَلِکَ۔(عبدالرزاق ۱۶۹۵۳)","Da'if","Musannaf Ibn Abi Shaybah 24406","","","كتاب الأشربة"
"24407","(۲۴۴۰۷) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ الطَّوِیلِ ، عَنْ عُقْبَۃَ بْنِ مَیْسَرَۃَ ، قَالَ : کُنَّا عِنْدَ مَعْقِلِ بْنِ یَسَارٍ فَدَعَا بِطَعَامٍ فَأَکَلْنَا ، ثُمَّ أُتِینَا بِقَدَحٍ مِنْ نَبِیذٍ فَشَرِبَ وَشَرِبْنَا ، حَتَّی انْتَہَی إِلَی ابْنٍ لَہُ ، فَأَبَی أَنْ یَشْرَبَ ، فَأَخَذَ مَعْقِلٌ عَصًی کَانَتْ عِنْدَہُ ، فَضَرَبَ بِہَا رَأْسَہُ فَشَجَّہُ ، ثُمَّ قَالَ لَہُ : أَتَفْعَلُ کَذَا وَکَذَا ، وَذَکَرَ مِنْ مَسَاوِئِہِ وَتَأْبَی أَنْ تَشْرَبَ مِنْ شَرَابٍ شَرِبَہُ أَبُوکَ وَعُمُومَتُکَ ، لأَنَّہُ نَبِیذُ جَرٍّ ؟۔","Da'if","Musannaf Ibn Abi Shaybah 24407","","","كتاب الأشربة"
"24408","(۲۴۴۰۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ مِسْحَاجِ بْنِ مُوسَی ، قَالَ : کُنْتُ نَازِلاً فِی دَارِ أَنَسٍ ، فَرَأَیْتُہُ یَشْرَبُ النَّبِیذَ فِی جَرٍّ أَخْضَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 24408","","","كتاب الأشربة"
"24409","(۲۴۴۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، قَالَ : حدَّثَنِی عَاصِمُ بْنُ بَہْدَلَۃَ ، قَالَ : أَدْرَکْتُ رِجَالاً کَانُوا یَتَّخِذُونَ ہَذَا اللَّیْلَ جَمَلاً ، یَشْرَبُونَ نَبِیذَ الْجَرِّ ، وَیَلْبَسُونَ الْمُعَصْفَرَ ، مِنْہُمْ زِرٌّ ، وَأَبُو وَائِلٍ۔","","Musannaf Ibn Abi Shaybah 24409","","","كتاب الأشربة"
"24410","(۲۴۴۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، أَنَّہُ کَانَ یَشْرَبُ النَّبِیذَ لِثَلاَثٍ۔","","Musannaf Ibn Abi Shaybah 24410","","","كتاب الأشربة"
"24411","(۲۴۴۱۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ أَبِی بُرْدَۃَ ، یَعْنِی ابْنَ نِیَارٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : اشْرَبُوا فِی الظُّرُوفِ ، وَلاَ تَسْکَرُوا۔\n(نسائی ۵۱۸۷۔ طبرانی ۲۲)","Shadh","Musannaf Ibn Abi Shaybah 24411","","","كتاب الأشربة"
"24412","(۲۴۴۱۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ الْحَارِثِ التَّیْمِیِّ ، عَنْ عَمْرِو بْنِ عَامِرٍ ، عَنْ أَنَسٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ النَّبِیذِ فِی ہَذِہِ الظُّرُوفِ ، ثُمَّ قَالَ : نَہَیْتُکُمْ عَنِ النَّبِیذِ ، فَاشْرَبُوا فِیمَا شِئْتُمْ ، مَنْ شَائَ أَوْکَی سِقَائَ ہُ عَلَی إِثْمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 24412","","","كتاب الأشربة"
"24413","(۲۴۴۱۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ مُحَارِبٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : نَہَیْتُکُمْ عَنِ النَّبِیذِ إِلاَّ فِی سِقَائٍ ، فَاشْرَبُوا فِی الأَسْقِیَۃِ کُلِّہَا ، وَلاَ تَشْرَبُوا مُسْکِرًا۔","Sahih","Musannaf Ibn Abi Shaybah 24413","","","كتاب الأشربة"
"24414","(۲۴۴۱۴) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ یَحْیَی بْنِ الْحَارِثِ، عَنْ عَمْرِو بْنِ عَامِرٍ، عَنْ أَنَسٍ، قَالَ: نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الأَنْبِذَۃِ فِی الأَوْعِیَۃِ ، ثُمَّ قَالَ بَعْدُ : إِنِّی نَہَیْتُکُمْ عَنِ الأَنْبِذَۃِ فِی الأَوْعِیَۃِ ، فَاشْرَبُوا فِیمَا شِئْتُمْ ، مَنْ شَائَ أَوْکَأَ سِقَائَ ہُ عَلَی إِثْمٍ۔","Da'if","Musannaf Ibn Abi Shaybah 24414","","","كتاب الأشربة"
"24415","(۲۴۴۱۵) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ سُلَیْمَانَ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی عِیَاضٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : قِیلَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لَیْسَ کُلُّ النَّاسِ یَجِدُ وِعَائً ، فَأَذِنَ لَہُمْ فِی شَیْئٍ مِنْہُ ، یَعْنِی الظُّرُوفَ۔ (بخاری ۵۵۹۳۔ مسلم ۶۶)","Sahih","Musannaf Ibn Abi Shaybah 24415","","","كتاب الأشربة"
"24416","(۲۴۴۱۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَلِیِّ بْنِ زَیْدٍ ، عَنْ رَبِیعَۃَ بْنِ النَّابِغَۃِ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : کُنْتُ نَہَیْتُکُمْ عَنْ ہَذِہِ الأَوْعِیَۃِ ، فَاشْرَبُوا فِیہَا ، وَاجْتَنِبُوا کُلَّ مَا أَسْکَرَ۔","Da'if","Musannaf Ibn Abi Shaybah 24416","","","كتاب الأشربة"
"24417","(۲۴۴۱۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ الْحَارِثِ التَّیْمِیِّ ، عَنْ یَحْیَی بْنِ غَسَّانَ التَّیْمِیِّ ، عَنِ ابْنِ الرَّسِیمِ ، وَکَانَ رَجُلاً مِنْ أَہْلِ ہَجَرَ ، وَکَانَ فَقِیہًا حَدَّثَ ، عَنْ أَبِیہِ ؛ أَنَّہُ انْطَلَقَ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی وَفْدٍ فِی صَدَقَۃٍ یَحْمِلُہَا إِلَیْہِ ، قَالَ : فَنَہَاہُمْ عَنِ النَّبِیذِ فِی ہَذِہِ الظُّرُوفِ ، فَرَجَعُوا إِلَی أَرْضِہِمْ ، وَہِیَ أَرْضُ تِہَامَۃَ حَارَّۃً ، فَاسْتَوْخَمُوہَا ، فَرَجَعُوا إِلَیْہِ الْعَامَ الثَّانِیَ فِی صَدَقَاتِہِمْ ، فَقَالُوا : یَا رَسُولَ اللہِ ، إِنَّک نَہَیْتَنَا عَنْ ہَذِہِ الأَوْعِیَۃِ فَتَرَکْنَاہَا ، وَشَقَّ ذَلِکَ عَلَیْنَا ، فَقَالَ : اذْہَبُوا فَاشْرَبُوا فِیمَا شِئْتُمْ، مَنْ شَائَ أَوْکَی سِقَائَ ہُ عَلَی إِثْمَ۔ (احمد ۳/۴۸۱۔ طبرانی ۴۶۳۴)","Da'if","Musannaf Ibn Abi Shaybah 24417","","","كتاب الأشربة"
"24418","(۲۴۴۱۸) حَدَّثَنَا عُ??َرُ بْنُ سَعْدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمٍ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الظُّرُوفِ ، فَشَکَتْ إِلَیْہِ الأَنْصَارُ ، فَقَالُوا : لَیْسَ لَنَا أَوْعِیَۃٌ ، فَقَالَ : فَلاَ إِذَنْ۔\n(بخاری ۵۵۹۲۔ ترمذی ۱۸۷۰)","Sahih","Musannaf Ibn Abi Shaybah 24418","","","كتاب الأشربة"
"24419","(۲۴۴۱۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادٍ ، قَالَ : حدَّثَنَا فَرْقَدٌ السَّبَخِیُّ ، قَالَ : حَدَّثَنَا جَابِرُ بْنُ یَزِیدَ ، قَالَ: حَدَّثَنَا مَسْرُوقٌ، عَنْ عَبْدِ اللہِ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنِّی نَہَیْتُکُمْ عَنْ ہَذِہِ الأَوْعِیَۃِ، وَإِنَّ الأَوْعِیَۃَ لاَ تُحِلُّ شَیْئًا ، وَلاَ تُحَرِّمُہُ ، فَاشْرَبُوا فِیہَا۔","Da'if","Musannaf Ibn Abi Shaybah 24419","","","كتاب الأشربة"
"24420","(۲۴۴۲۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ طَارِقِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کُلُّ حَلاَلٍ فِی کُلِّ ظَرْفٍ حَلاَلٌ ، وَکُلُّ حَرَامٍ فِی کُلِّ ظَرْفٍ حَرَامٌ۔","Sahih","Musannaf Ibn Abi Shaybah 24420","","","كتاب الأشربة"
"24421","(۲۴۴۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدِ بْنِ سَعِیدٍ الْبَجَلِیِّ ، عَنْ أَبِی الشَّعْثَائِ الْکِنْدِیِّ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سَمِعْتُہُ یَقُولُ : الأَوْعِیَۃُ لاَ تُحِلُّ شَیْئًا ، وَلاَ تُحَرِّمُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24421","","","كتاب الأشربة"
"24422","(۲۴۴۲۲) حَدَّثَنَا عَبْدَۃُ، عَنْ صَالِحٍ، عَنِ الشَّعْبِیِّ ، قَالَ: نَبِیذُ الْمِزْرِ أَشَدُّ مِنْ نَبِیذِ الدَّنِّ ، وَمَا حَرَّمَ إِنَائٌ ، وَلاَ أَحَلَّ۔","","Musannaf Ibn Abi Shaybah 24422","","","كتاب الأشربة"
"24423","(۲۴۴۲۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنِ الزُّبَیْرِ بْنِ عَدِیِّ ، قَالَ : ذُکِرَ عِنْدَ شُرَیْحٍ الأَسْقِیَۃُ الَّتِی تُنْبَذُ فِیہَا ، فَقَالَ شُرَیْحٌ : مَا یُحْلِلْنَ شَیْئًا ، وَلاَ یُحَرِّمْنَ ، وَلَکِنَ اُنْظُرُوا مَا تَجْعَلُونَ فِیہِ مِنْ حَلاَلٍ ، أَوْ حَرَامٍ۔","","Musannaf Ibn Abi Shaybah 24423","","","كتاب الأشربة"
"24424","(۲۴۴۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ رَجُلٍ مِنْ بَنِی بَجِیلَۃَ ، عنِ ابْنِ عَبَّاسٍ ، قَالَ : کُلُّ حَلاَلٍ فِی کُلِّ ظَرْفٍ حَلاَلٌ ، وَکُلُّ حَرَامٍ فِی کُلِّ ظَرْفٍ حَرَامٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24424","","","كتاب الأشربة"
"24425","(۲۴۴۲۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ إِسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ مُسْلِمٍ الْبَطِینِ ، قَالَ : سَأَلْتُ أَبَا عَمْرٍو الشَّیْبَانِیَّ عَنِ الْجِعَۃِ ؟ قَالَ : شَرَابٌ یُصْنَعُ بِالْیَمَنِ مِنَ الشَّعِیرِ۔","","Musannaf Ibn Abi Shaybah 24425","","","كتاب الأشربة"
"24426","(۲۴۴۲۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُحَمَّدِ بْنِ أَبِی إِسْمَاعِیلَ ، عَنْ عُمَارَۃَ بْنِ عَاصِمٍ ، عَنْ أَنَسٍ ، قَالَ : الْحَنْتَمُ جِرَارٌ حُمْرٌ ، کَانَتْ تَأْتِینَا مِنْ مِصْرَ۔","Da'if","Musannaf Ibn Abi Shaybah 24426","","","كتاب الأشربة"
"24427","(۲۴۴۲۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، وَوَکِیعٌ ، عَنِ الصَّلْتِ بْنِ بَہْرَامَ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ عَنِ الْحَنْتَمِ ؟ قَالَ : کَانَتْ جِرَارًا حُمْرًا مُقَیَّرَۃً ، یُؤْتَی بِہَا مِنَ الشَّامِ ، یُقَالُ لَہَا : الْحَنْتَمُ۔","","Musannaf Ibn Abi Shaybah 24427","","","كتاب الأشربة"
"24428","(۲۴۴۲۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی الْحَارِثِ التَّیْمِیِّ ، عَنْ أُمِّ مَعْبَدٍ ، قَالَ : قُلْتُ : مَا قَالَ فِی ہَذِہِ الأَوْعِیَۃِ ؟ فَقَالَتْ : عَلَی الْخَبِیرِ سَقَطْتَ ، أَمَّا الْحَنَاتِمُ فَحَنَاتِمُ الْعَجَمِ ، الَّتِی یَدْخُلُ فِیہَا الرَّجُلُ فَیَکْنِسُہَا کَنْسًا : ظُرُوفُ الْخَمْرِ ، وَأَمَّا الدُّبَّائُ فَالْقَرْعُ ، وَأَمَّا الْمُزَفَّتُ فَالزِّقَاقُ الْمُقَیَّرَۃُ أَجْوَافُہَا ، الْمُلَوَّنَۃُ أَشْعَارُہَا بِالْقَارِ : ظُرُوفُ الْخَمْرِ ، وَأَمَّا النَّقِیرُ فَالنَّخْلَۃُ الثَّابِتَۃُ عُرُوقُہَا فِی الأَرْضِ ، الْمَنْقُورَۃُ نَقْرًا۔","","Musannaf Ibn Abi Shaybah 24428","","","كتاب الأشربة"
"24429","(۲۴۴۲۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : إِنَّمَا کَانَتِ الْحَنَاتِمُ جِرَارًا حُمْرًا مُزَفَّتَۃً ، یُؤْتَی بِہَا مِنْ مِصْرَ ، وَلَیْسَتْ بِالْجِرَارِ الْخُضْرِ۔","","Musannaf Ibn Abi Shaybah 24429","","","كتاب الأشربة"
"24430","(۲۴۴۳۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : الْحَنْتَمُ جِرَارٌ خُضْرٌ کَانَ یُجَائُ بِہَا مِنْ مِصْرَ ، فِیہَا الْخَمْرُ۔","","Musannaf Ibn Abi Shaybah 24430","","","كتاب الأشربة"
"24431","(۲۴۴۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْحَنْتَمُ الْجِرَارُ کُلُّہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 24431","","","كتاب الأشربة"
"24432","(۲۴۴۳۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی إِسْحَاقَ الشَّیْبَانِیِّ ، قَالَ : قُلْتُ لأَبِی بُرْدَۃَ : مَا الْبِتْعُ ؟ قَالَ : نَبِیذُ الْعَسَلِ، وَالْمِزْرُ نَبِیذُ الشَّعِیرِ۔","","Musannaf Ibn Abi Shaybah 24432","","","كتاب الأشربة"
"24433","(۲۴۴۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالَ : سَأَلْتُُہُمَا عَنِ النَّبِیذِ فِی الرَّصَاصِ ؟ فَکَرِہَاہُ۔","","Musannaf Ibn Abi Shaybah 24433","","","كتاب الأشربة"
"24434","(۲۴۴۳۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الْمُخْتَارِ ، قَالَ : سَأَلْتُ أَنَسًا ، فَقُلْتُ : الْقَارُورَۃِ وَالرَّصَاصِ ؟ فَقَالَ : لاَ بَأْسَ بِہِمَا ، فَقُلْتُ : إِنَّ النَّاسَ یَقُولُونَ ؟ قَالَ : فَدَعْ مَا یَرِیبُکَ إِلَی مَا لاَ یَرِیبُکَ۔","Sahih","Musannaf Ibn Abi Shaybah 24434","","","كتاب الأشربة"
"24435","(۲۴۴۳۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی سَلَمَۃَ ، قَالَ : جِئْتُ وَہُمْ یَذْکُرُونَ نَبِیذَ الْجَرِّ عِنْدَ عِکْرِمَۃَ ، فَسَأَلَہُ إِنْسَانٌ عَنِ الرَّصَاصِ ؟ فَقَالَ : ذَلِکَ أَخْبَثُ ، أَوْ أَشَرُّ۔","","Musannaf Ibn Abi Shaybah 24435","","","كتاب الأشربة"
"24436","(۲۴۴۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبَانَ بْنِ صَمْعَۃَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَہُ فِی الرَّصَاصِ۔","","Musannaf Ibn Abi Shaybah 24436","","","كتاب الأشربة"
"24437","(۲۴۴۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَبِی الأَشْہَبِ جَعْفَرِ بْنِ الْحَارِثِ النَّخَعِیِّ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ عَنْ نَبِیذِ الرَّصَاصِ ؟ فَرَخَّصَ لِی فِی ذَلِکَ ، فَکَانَ لِجَدِّی جَرَّۃٌ مِنْ رَصَاصٍ یُنْبَذُ فِیہَا۔","Da'if","Musannaf Ibn Abi Shaybah 24437","","","كتاب الأشربة"
"24438","(۲۴۴۳۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، قَالَ : رَأَیْتُ إِبرَہِیمَ ، وَخَیْثَمَۃَ ،وَالْمُسَیَّبَ بْنَ رَافِعٍ مَعَہُم نَبِیذٌ فِی رَصَاصٍ یَشْرَبُونَہُ۔","","Musannaf Ibn Abi Shaybah 24438","","","كتاب الأشربة"
"24439","(۲۴۴۳۹) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، قَالَ : کَانَ أَبُو قِلاَبَۃَ یُنْبَذُ لَہُ فِی سِقَائٍ ، ثُمَّ یُحَوِّلُہُ فِی بَاطیَّۃٍ مِنْ رَصَاصٍ۔","","Musannaf Ibn Abi Shaybah 24439","","","كتاب الأشربة"
"24440","(۲۴۴۴۰) حَدَّثَنَا الْفَضْلُ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : حدَّثَنِی غَیْلاَنُ بْنُ عُمَیْرَۃَ ، قَالَ : لَقِیتُ ابْنَ عُمَرَ ، فَسَأَلْتُہُ عَنِ الأَشْرِبَۃِ ؟ فَرَخَّصَ لِی فِی الرَّصَاصِ۔","Da'if","Musannaf Ibn Abi Shaybah 24440","","","كتاب الأشربة"
"24441","(۲۴۴۴۱) حَدَّثَنَا أَبُو خَالِدٍ ، وَلَیْسَ بِالأَحْمَرِ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ أَنَّہُ کَانَ یُنْبَذُ لَہُ فِی جَرَّۃٍ مِنْ رَصَاصٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 24441","","","كتاب الأشربة"
"24442","(۲۴۴۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ حُمَیْدٍ ، عَنْ بَکْرٍ ؛ أَنَّہُ کَانَ یُنْبَذُ لَہُ فِی الْقَوَارِیرِ۔","","Musannaf Ibn Abi Shaybah 24442","","","كتاب الأشربة"
"24443","(۲۴۴۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبَانَ بْنِ صَمْعَۃَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ رَخَّصَ فِی الزُّجَاجِ ، یَعْنِی النَّبِیذَ۔","","Musannaf Ibn Abi Shaybah 24443","","","كتاب الأشربة"
"24444","(۲۴۴۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْرُوفِ بْنِ وَاصِلٍ ، قَالَ حَدَّثَتْنِی وَالِدَتِی ، عَنِ امْرَأَۃٍ ، یُقَالُ لَہَا : بِنْتُ الأَقْعَصِ ، وَکَانَتْ کَنَّۃً لِعَبْدِ اللہِ بْنِ عُمَرَ ، أَنَّہَا أَتَتِ ابْنَ عُمَرَ بِجَرَّۃٍ خَضْرَائَ ، فَقَالَ : مَا ہَذَا ؟ قَالَتْ : نَنْبِذُ فِی ہَذِہِ ، فَأَدْخَلَ ابْنُ عُمَرَ یَدَہُ فِی جَوْفِہَا ، فَقَالَ : عَزَمْتُ عَلَیْکِ لَتَشْرَبِنَّ فِیہَا ، فَإِنَّمَا ہِیَ مِثْلُ الْقَارُورَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 24444","","","كتاب الأشربة"
"24445","(۲۴۴۴۵) حدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، قَالَ : رَأَیْتُ مُحَمَّدًا یَشْرَبُ فِی الْقَوَارِیرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24445","","","كتاب الأشربة"
"24446","(۲۴۴۴۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ بْنِ حَکِیمٍ ، عَنْ أُمِّہ ، عَنْ أَبِی بَرْزَۃَ ؛ أَنَّہُ کَرِہَ الشُّرْبَ فِی الزُّجَاجِ۔","Da'if","Musannaf Ibn Abi Shaybah 24446","","","كتاب الأشربة"
"24447","(۲۴۴۴۷) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنِ الْمُخْتَارِ بْنِ فُلْفُلٍ ، قَالَ : سَأَلْتُ أَنَسًا فَقُلْتُ : الْقَارُورَۃُ وَالرَّصَاصَۃُ ؟ قَالَ : لاَ بَأْسَ بِہِمَا ، قُلْتُ : فَإِنَّ النَّاسَ یَقُولُونَ ؟ قَالَ : دَعْ مَا یَرِیبُکَ إِلَی مَا لاَ یَرِیبُک۔","Sahih","Musannaf Ibn Abi Shaybah 24447","","","كتاب الأشربة"
"24448","(۲۴۴۴۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، قَالَ : جِئْتُ إِلَی سَعِیدِ بْنِ جُبَیْرٍ بِجَرَّۃٍ خَضْرَائَ ، فَأَدْخَلَ یَدَہُ فِیہَا فَقُلْتُ : أَنَنْبِذُ فِی ہَذِہِ ؟ قَالَ : نَعَمْ ، ہِیَ بِمَنْزِلَۃِ الْقَارُورَۃِ۔","","Musannaf Ibn Abi Shaybah 24448","","","كتاب الأشربة"
"24449","(۲۴۴۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، قَالَ : شَرِبْتُ عِنْدَ إِبْرَاہِیمَ ثَلاَثَ قَوَارِیرَ مِنْ نَبِیذٍ۔","","Musannaf Ibn Abi Shaybah 24449","","","كتاب الأشربة"
"24450","(۲۴۴۵۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ النَّضْرِ بْنِ مُطَرِّفِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ عَبْدُ اللہِ یُنْبَذُ لَہُ فِی جَرٍّ ، وَیُجْعَلُ لَہُ فِیہِ عَکَرٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24450","","","كتاب الأشربة"
"24451","(۲۴۴۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدِ بْنِ الْمَعْدِلِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ عُمَرَ أُتِیَ بِنَبِیذٍ مِنْ نَبِیذِ الشَّامِ ، فَشَرِبَ مِنْہُ وَقَالَ : أَقْلَلْتُمْ عَکَرَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24451","","","كتاب الأشربة"
"24452","(۲۴۴۵۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَبِی فَرْوَۃَ ، قَالَ : سَقَانِی عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی نَبِیذَ جَرٍّ وَفِیہِ دُرْدِیٌّ ، وَسَقَیْتُہُ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24452","","","كتاب الأشربة"
"24453","(۲۴۴۵۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ أَبِی وَائِلٍ ، قَالَ : کَانَ یَسْقِینَا نَبِیذًا یُؤْذِینَا رِیحُ دُرْدِیِّہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24453","","","كتاب الأشربة"
"24454","(۲۴۴۵۴) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، قَالَ : سَأَلْتُ أَبَا جَعْفَرٍ ، عَنِ الرَّوْبَۃِ ، قَالَ : وَمَا الرَّوْبَۃُ ؟ قُلْتُ : الدُّرْدِیَّ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 24454","","","كتاب الأشربة"
"24455","(۲۴۴۵۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَنْبِذُ الطِّلاَئَ یَجْعَلُ فِیہِ الدُّرْدِیَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 24455","","","كتاب الأشربة"
"24456","(۲۴۴۵۶) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ إبْرَاہِیمَ ، وَالشَّعْبِیِّ ؛ أَنَّہُمَا کَانَا یَجْعَلاَنِ فِی نَبِیذِہِمَا الدُّرْدِیَّ۔","","Musannaf Ibn Abi Shaybah 24456","","","كتاب الأشربة"
"24457","(۲۴۴۵۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ، أَنَّہُمَا کَانَا یَکْرَہَانِ الْعَکَرَ۔","","Musannaf Ibn Abi Shaybah 24457","","","كتاب الأشربة"
"24458","(۲۴۴۵۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ؛ أَنَّہُ کَانَ یَکْرَہُ الْعَکَرَ۔","No Data Available","Musannaf Ibn Abi Shaybah 24458","","","كتاب الأشربة"
"24459","(۲۴۴۵۹) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ : أَنَّہُ کَرِہَ الْعَکَرَ وَقَالَ : ہُوَ خَمْرٌ۔","","Musannaf Ibn Abi Shaybah 24459","","","كتاب الأشربة"
"24460","(۲۴۴۶۰) حدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ، عَنْ قَتَادَۃَ، عَنْ أَنَسٍ؛ أَنَّ أَبَا عُبَیْدَۃَ، وَمُعَاذَ بْنَ جَبَلٍ، وَأَبَا طَلْحَۃَ کَانُوا یَشْرَبُونَ مِنَ الطِّلاَئِ مَا ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24460","","","كتاب الأشربة"
"24461","(۲۴۴۶۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ دَاوُدَ بْنِ أَبِی ہِنْدٍ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ الشَّرَابِ الَّذِی کَانَ عُمَرُ بْنُ الْخَطَّابِ أَجَازَہُ لِلنَّاسِ ؟ قَالَ : ہُوَ الطِّلاَئُ الَّذِی قَدْ طُبِخَ حَتَّی ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24461","","","كتاب الأشربة"
"24462","(۲۴۴۶۲) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ مَیْمُونٍ ، عَنْ أُمِّ الدَّرْدَائِ ، قَالَتْ : کُنْتُ أَطْبُخُ لأَبِی الدَّرْدَائِ الطِّلاَئَ مَا ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثُہُ فَیَشْرَبُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24462","","","كتاب الأشربة"
"24463","(۲۴۴۶۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ مَیْمُونٍ ، عَنْ أُمِّ الدَّرْدَائِ ، عَنْ أَبِی الدَّرْدَائِ ؛ أَنَّہُ کَانَ یَشْرَبُ مِنَ الطِّلاَئِ مَا ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثُہُ۔","","Musannaf Ibn Abi Shaybah 24463","","","كتاب الأشربة"
"24464","(۲۴۴۶۴) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنْ أَبَانَ بْنِ عَبْدِ اللہِ الْبَجَلِیِّ ، عَنْ رَجُلٍ قَدْ سَمَّاہُ ، قَالَ : کَانَ عَلِیٌّ یَرْزُقُ النَّاسَ مِنَ الطِّلاَئِ مَا ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24464","","","كتاب الأشربة"
"24465","(۲۴۴۶۵) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْحَسَنِ بْنِ عَمْرٍو ، عَنْ فُضَیْلِ بْنِ عَمْرٍو ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : مَا تَرَی فِی الطِّلاَئِ ؟ قَالَ : مَا ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثُہُ ، وَمَا أَرَی بِالْمنصَّفِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 24465","","","كتاب الأشربة"
"24466","(۲۴۴۶۶) حَدَّثَنَا وَکِیعٌ ، عَنْ بَشِیرِ بْنِ الْمُہَاجِرِ ، عَنِ الْحَسَنِ ، قَالَ : اشْرَبْ مَا ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثُہُ۔","","Musannaf Ibn Abi Shaybah 24466","","","كتاب الأشربة"
"24467","(۲۴۴۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعْدِ بْنِ أَوْسٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : کَانَ أَنَسُ بْنُ مَالِکٍ سَقِیمَ الْبَطْنِ ، فَأَمَرَنِی أَنْ أَطْبُخَ لَہُ طِلاَئً حَتَّی ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثُہُ ، فَکَانَ یَشْرَبُ مِنْہُ الشَّرْبَۃَ عَلَی إِثْرِ الطَّعَامِ۔","Da'if","Musannaf Ibn Abi Shaybah 24467","","","كتاب الأشربة"
"24468","(۲۴۴۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ حَکِیمِ بْنِ جُبَیْرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : اشْرَبْ مِنَ الطِّلاَئِ مَا ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24468","","","كتاب الأشربة"
"24469","(۲۴۴۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، قَالَ : سَمِعْتُ أَعْرَابِیًّا سَأَلَ سَعِیدَ بْنَ الْمُسَیَّبِ عَنِ الطِّلاَئِ عَلَی النِّصْفِ ؟ فَکَرِہَہُ ، وَقَالَ : عَلَیْک بِاللَّبَنِ۔","","Musannaf Ibn Abi Shaybah 24469","","","كتاب الأشربة"
"24470","(۲۴۴۷۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، وَأَبِی جُحَیْفَۃَ ، قَالاَ : کَانَ عَلِیٌّ یَرْزُقُنَا الطِّلاَئَ ، قَالَ : قُلْتُ : کَیْفَ کَانَ ؟ قَالَ : کُنَّا نَأْتَدِمُہُ بِالْخُبْزِ ، وَنَحْتَاسُہُ بِالْمَائِ ۔","Da'if","Musannaf Ibn Abi Shaybah 24470","","","كتاب الأشربة"
"24471","(۲۴۴۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ عَلِیِّ بْنِ سُلَیْمٍ ، قَالَ : سَمِعْتُ أنَسًا یَقُولُ : إِنِّی لأََشْرَبُ الطِّلاَئَ الْحُلْوَ الْقَارِصَ۔","Hasan","Musannaf Ibn Abi Shaybah 24471","","","كتاب الأشربة"
"24472","(۲۴۴۷۲) حَدَّثَنَا حَمَّاد بن خَالِدٍ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَن سَالِمِ بْنِ سَالِمٍ قَال : دَخَلتُ عَلَی أَبِی أُمَامَۃَ وَہُوَ یَشْرَبُ طِلاَئَ الرَّبِّ۔","Da'if","Musannaf Ibn Abi Shaybah 24472","","","كتاب الأشربة"
"24473","(۲۴۴۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ خَالِدٍ ، عَنْ عُثْمَانَ بْنِ قَیْسٍ ، قَالَ : خَرَجْتُ مَعَ جَرِیرٍ یَوْمَ الْجُمُعَۃِ إِلَی حَمَّامٍ لَہُ بِالْعَاقُولِ ، فَأُتِینَا بِطَعَامٍ فَأَکَلْنَا ، ثُمَّ أُتِینَا بِعَسَلٍ وَطِلاَئٍ ، فَقَالَ : جَرِیرٌ : اشْرَبُوا أَنْتُمُ الْعَسَلَ ، وَشَرِبَ ہُوَ الطِّلاَئَ وَقَالَ : إِنَّہُ یُسْتَنْکَرُ مِنْکُمْ ، وَلاَ یُسْتَنْکَرُ مِنِّی ، قُلْتُ : أَیُّ الطِّلاَئِ ہُوَ ؟ قَالَ : کُنْتُ أَجِدُ رِیحَہُ کَمَکَانِ تِلْکَ ، وَأَوْمَأَ بِیَدِہِ إِلَی أَقْصَی حَلَقَۃٍ فِی الْقَوْمِ۔","Da'if","Musannaf Ibn Abi Shaybah 24473","","","كتاب الأشربة"
"24474","(۲۴۴۷۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنِ الْمُغِیرَۃِ بْنِ الْمُنْتَشِر ابْنِ أَخِی مَسْرُوقٍ ، قَالَ : قُلْتُ لَہُ : کَانَ مَسْرُوقٌ یَشْرَبُ الطِّلاَئَ ؟ قَالَ : نَعَمْ ، کَانَ یَطْبُخُہُ ثُمَّ یَشْرَبُہُ۔","","Musannaf Ibn Abi Shaybah 24474","","","كتاب الأشربة"
"24475","(۲۴۴۷۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ ، عَنْ أَبِی جَرِیرٍ ، عَنِ النَّضْرِ بْنِ أَنَسٍ ، قَالَ : غَزَا أَبُو عُبَیْدَۃَ بْنُ الْجَرَّاحِ فَأَتَی أَرْضَ الشَّامِ ، فَقِیلَ لأَبِی عُبَیْدَۃَ : إِنَّ ہَاہُنَا شَرَابًا تَشْرَبُہُ النَّصَارَی فِی صَوْمِہِمْ ، قَالَ : فَشَرِبَ مِنْہُ أَبُو عُبَیْدَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 24475","","","كتاب الأشربة"
"24476","(۲۴۴۷۶) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا إِسْمَاعِیلُ ، عَنْ مُغِیرَۃَ ، عَنْ شُرَیْحٍ ؛ أَنَّ خَالِدَ بْنَ الْوَلِیدِ کَانَ یَشْرَبُ الطِّلاَئَ بِالشَّامِ۔","Da'if","Musannaf Ibn Abi Shaybah 24476","","","كتاب الأشربة"
"24477","(۲۴۴۷۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی بْنِ عُبَیْدٍ أَبِی عُمَرَ ، قَالَ : ذُکِرَ عِنْدَ ابْنِ عَبَّاسٍ الطِّلاَئُ ، وَذَکَرُوا طَبْخَہُ ، فَقَالَ ابْنُ عَبَّاسٍ : إِنَّ النَّارَ لاَ تُحِلُّ شَیْئًا ، وَلاَ تُحَرِّمُہُ لأَنَّ أَوَّلَہُ کَانَ حَلاَلاً۔","Sahih","Musannaf Ibn Abi Shaybah 24477","","","كتاب الأشربة"
"24478","(۲۴۴۷۸) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ کَانَ یَشْرَبُ الطِّلاَئَ الشَّدِیدَ۔","No Data Available","Musannaf Ibn Abi Shaybah 24478","","","كتاب الأشربة"
"24479","(۲۴۴۷۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَلِیِّ بْنِ بَذِیمَۃَ ، عَنْ أَبِی عُبَیْدَۃَ ؛ أَنَّہُ کَانَ یَشْرَبُ الطِّلاَئَ عِنْدَ مَرْوَانَ ، مَا یُحَمِّرُ وَجْنَتَیہِ۔","","Musannaf Ibn Abi Shaybah 24479","","","كتاب الأشربة"
"24480","(۲۴۴۸۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یَشْتَرِی الطِّلاَئَ مِمَّنْ لاَ یَدْرِی مَنْ صَنَعَہُ ، ثُمَّ یَشْرَبُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24480","","","كتاب الأشربة"
"24481","(۲۴۴۸۱) حَدَّثَنَا شَرِیکٌ ، عَنِ السُّدِّیِّ ، عَنْ شَیْخٍ مِنَ الْحَضْرَمِیِّینَ ، قَالَ : قسَّمَ عَلِیٌّ طِلاَئً ، فَبَعَثَ إِلَیَّ بِقِدْرٍ ، فَکُنَّا نَأْکُلُہُ بِالْخُبْزِ کَمَا نَأْکُلُہُ بِالْکَامِخِ۔","Da'if","Musannaf Ibn Abi Shaybah 24481","","","كتاب الأشربة"
"24482","(۲۴۴۸۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَن مُوسَی بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ الأَنْصَارِیِّ ، قَالَ : کَانَتْ لِعَبْدِ الرَّحْمَنِ بْنِ بِشْرٍ الأَنْصَارِیِّ قَرْیَۃٌ یُصْنَعُ لَہُ بِہَا طَعَامٌ ، فَدَعَا نَاسًا مِنْ أَصْحَابِہِ فَأَکَلُوا ، ثُمَّ أُتُوا بِشَرَابٍ مِنَ الطِّلاَئِ ، وَفِیہِمْ أُنَاسٌ مِنْ أَہْلِ بَدْرٍ ، فَقَالُوا : مَا ہَذَا ؟ قَالُوا : شَرَابٌ یَصْنَعُہُ ابْنُ بِشْرٍ لِنَفْسِہِ ، فَقَالُوا : ہُوَ الرَّجُلُ لاَ یُرْغَبُ عَنْ شَرَابِہِ ، فَشَرِبُوا۔","","Musannaf Ibn Abi Shaybah 24482","","","كتاب الأشربة"
"24483","(۲۴۴۸۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، عَنْ عَلِیٍّ ، قَالَ : کَانَ یَرْزُقُنَا الطِّلاَئَ ، فَقُلْتُ لَہُ: مَا ہَیْئَتُہُ ؟ قَالَ : أَسْوَدُ ، یَأْخُذُہُ أَحَدُنَا بِإِصْبعِہِ۔","","Musannaf Ibn Abi Shaybah 24483","","","كتاب الأشربة"
"24484","(۲۴۴۸۴) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ الْوَلِیدِ الْمُزَنِیُّ ، قَالَ : حَدَّثَنِی عَبْدُ الْمَلِکِ بْنُ عُمَیْرٍ، عَنْ أَبِی الْہَیَّاجِ ؛ أَنَّ الْحَجَّاجَ دَعَاہُ فَقَالَ : أَرِنِی کِتَابَ عُمَرَ إِلَی عَمَّارٍ فِی شَأْنِ الطِّلاَئِ ، فَخَرَجَ وَہُوَ حَزِینٌ، فَلَقِیَہُ الشَّعْبِیُّ فَسَأَلَہُ ، فَأَخْبَرَہُ عَمَا قَالَ لَہُ الْحَجَّاجُ ، فَقَالَ لَہُ الشَّعْبِیُّ : ہَلمَّ صَحِیفَۃً وَدَوَاۃً ، فَوَاللَّہِ مَا سَمِعْتُہُ مِنْ أَبِیکَ إِلاَّ مَرَّۃً وَاحِدَۃً ، فَأَمْلَی عَلَیْہِ : بِسْمِ اللہِ الرَّحْمَنِ الرَّحِیمِ ، مِنْ عَبْدِ اللہِ عُمَرَ أَمِیرِ الْمُؤْمِنِینَ إِلَی عَمَّارِ بْنِ یَاسِرٍ ، أَمَّا بَعْدُ ؛ فَإِنِّی أُتِیتُ بِشَرَابٍ مِنْ قِبَلِ الشَّامِ ، فَسَأَلْتُ عَنْہُ کَیْفَ یُصْنَعُ ؟ فَأَخْبَرُونِی أَنَّہُمْ یَطْبُخُونَہُ حَتَّی یَذْہَبَ ثُلُثَاہُ وَیَبْقَی ثُلُثُہُ ، فَإِذَا فُعِلَ ذَلِکَ بِہِ ذَہَبَ رَسُّہُ وَرِیحُ جُنُونِہِ ، وَذَہَبَ حَرَامُہُ وَبَقِیَ حَلاَلُہُ ، قَالَ عَبْدُ اللہِ : وَأُرَاہُ قَالَ : وَالطَّیِّبُ مِنْہُ ، فَإِذَا أَتَاکَ کِتَابِی ہَذَا فَمُرْ مَنْ قِبَلَکَ فَلْیَتَوَسَّعُوا بِہِ فِی أَشْرِبَتِہِمْ ، وَالسَّلاَمُ۔","Da'if","Musannaf Ibn Abi Shaybah 24484","","","كتاب الأشربة"
"24485","(۲۴۴۸۵) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ أَبِیہِ ؛ أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَرِہَ الْمُنَصَّفَ ، وَبَعَثَ إِلَی أَہْلِ الأَمْصَارِ یَنْہَاہُمْ۔","","Musannaf Ibn Abi Shaybah 24485","","","كتاب الأشربة"
"24486","(۲۴۴۸۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ دَاوُدَ بْنِ إبْرَاہِیمَ ، قَالَ : قُلْتُ لِطَاوُوسٍ : أَرَأَیْتَ ہَذَا الْعَصِیرَ الَّذِی یُطْبَخُ عَلَی النِّصْفِ وَالثُّلُثِ وَنَحْوِ ذَلِکَ ؟ قَالَ : أَرَأَیْتَ ہَذَا الَّذِی مِنْ نَحْوِ الْعَسَلِ إِنْ شِئْتَ أَکَلْتَ بِہِ الْخُبْزَ ، وَإِنْ شِئْتَ صَبَبْتَ عَلَیْہِ مَائً فَشَرِبْتَہُ ، وَمَا دُونَہُ فَلاَ تَشْرَبْہُ ، وَلاَ تَبِعْہُ ، وَلاَ تَنْتَفِعَنَّ بِثَمَنِہِ۔","","Musannaf Ibn Abi Shaybah 24486","","","كتاب الأشربة"
"24487","(۲۴۴۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ بَشِیرِ بْنِ الْمُہَاجِرِ ، عَنْ عِکْرِمَۃَ ، وَالْحَسَنِ ، قَالاَ : اشْرَبْ مِنَ الطِّلاَئِ مَا ذَہَبَ ثُلُثَاہُ وَبَقِیَ ثُلُثُہُ۔","","Musannaf Ibn Abi Shaybah 24487","","","كتاب الأشربة"
"24488","(۲۴۴۸۸) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ بُرَیْدِ بْنِ أَبِی مَرْیَمَ ، عْن أَنَسِ بْنِ مَالِکٍ ، قَالَ : کُنَّا نَنْبِذُ الرُّطَبَ وَالْبُسْرَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَلَمَّا نَزَلَ تَحْرِیمُ الْخَمْرِ ہَرَقْنَاہُمَا مِنَ الأَوْعِیَۃِ ، ثُمَّ تَرَکْنَاہُمَا۔ (طحاوی ۲۱۳)","Sahih","Musannaf Ibn Abi Shaybah 24488","","","كتاب الأشربة"
"24489","(۲۴۴۸۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ النَّجْرَانِیِّ ، قَالَ : قُلْتُ لِعَبْدِ اللہِ بْنِ عُمَرَ : إِنَّا بِأَرْضٍ ذَاتِ تَمْرٍ وَزَبِیبٍ ، فَہَلْ یُخْلَطُ التَّمْرُ وَالزَّبِیبُ فَنَنْبِذُہُمَا جَمِیعًا ؟ قَالَ : لاَ ، قُلْتُ : لِمَ ؟ قَالَ : إِنَّ رَجُلاً سَکِرَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَأُتِیَ بِہِ النَّبِیُّ وَہُوَ سَکْرَانُ ، فَضَرَبَہُ ، ثُمَّ سَأَلَہُ عَنْ شَرَابِہِ ، قَالَ : شَرِبْتُ نَبِیذًا ، قَالَ : أَیَّ نَبِیذٍ ؟ قَالَ : نَبِیذُ تَمْرٍ وَزَبِیبٍ ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَخْلِطُوہُمَا، فَإِنَّ کُلَّ وَاحِدٍ مِنْہُمَا یَکْفِی وَحْدَہُ۔ (احمد ۲۵۔ ابویعلی ۵۷۵۶)","Da'if","Musannaf Ibn Abi Shaybah 24489","","","كتاب الأشربة"
"24490","(۲۴۴۹۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ الْعَبْدِیُّ ، عَنْ حَجَّاجِ بْنِ أَبِی عُثْمَانَ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تَنْبِذُوا التَّمْرَ وَالزَّبِیبَ جَمِیعًا ، وَلاَ تَنْبِذُوا الزَّہْوَ وَالرُّطَبَ ، وَانْبِذُوا کُلَّ وَاحِدٍ مِنْہُمَا عَلَی حِدَۃٍ۔ (بخاری ۵۶۰۲۔ مسلم ۲۴)","Sahih","Musannaf Ibn Abi Shaybah 24490","","","كتاب الأشربة"
"24491","(۲۴۴۹۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ حَبِیبٍ ، عَنْ أَبی أَرْطَاۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الزَّہْوِ وَالتَّمْرِ ، وَعَنِ الزَّبِیبِ وَالتَّمْرِ۔ (احمد ۳/۵۸۔ ابویعلی ۱۱۷۱)","Da'if","Musannaf Ibn Abi Shaybah 24491","","","كتاب الأشربة"
"24492","(۲۴۴۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَبِیبٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُخْلَطَ التَّمْرُ وَالزَّبِیبُ جَمِیعًا ، وَأَنْ یُخْلَطَ الْبُسْرُ وَالتَّمْرُ جَمِیعًا ، وَکَتَبَ إلَی أَہْلِ جُرَشَ یَنْہَاہُمْ عَنْ خَلْطِ التَّمْرِ وَالزَّبِیبِ۔ (مسلم ۲۷۔ احمد ۱/۳۳۶)","Sahih","Musannaf Ibn Abi Shaybah 24492","","","كتاب الأشربة"
"24493","(۲۴۴۹۳) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُنْبَذَ التَّمْرُ وَالزَّبِیبُ جَمِیعًا ، وَالتَّمْرُ وَالْبُسْرُ جَمِیعًا۔ (بخاری ۵۶۰۱۔ مسلم ۱۵۷۴)","Sahih","Musannaf Ibn Abi Shaybah 24493","","","كتاب الأشربة"
"24494","(۲۴۴۹۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، عَنْ عُقْبَۃَ بْنِ عَبْدِ الْغَافِرِ ، قَالَ : کَانَ أَبُو سَعِیدٍ الْخُدْرِیِّ یَنْہَی أَنْ یُجْمَعَ بَیْنَ التَّمْرِ وَالزَّبِیبِ۔","Sahih","Musannaf Ibn Abi Shaybah 24494","","","كتاب الأشربة"
"24495","(۲۴۴۹۵) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ حُمَیْدٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ یَکْرَہُ الْبُسْرَ وَحْدَہُ ، وَأَنْ یُجْمَعَ بَیْنَہُ وَبَیْنَ التَّمْرِ ، وَلاَ یَرَی بَأْسًا بِالتَّمْرِ وَالزَّبِیبِ وَیَقُولُ : حلاَلاَنِ اجْتَمَعَا أَوْ تَفَرَّقَا ، قَالَ : وَکَانَ الْحَسَنُ یَکْرَہُ أَنْ یُجْمَعَ بَیْنَ التَّمْرِ وَالزَّبِیبِ۔","Sahih","Musannaf Ibn Abi Shaybah 24495","","","كتاب الأشربة"
"24496","(۲۴۴۹۶) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ سِمَاکِ بْنِ مُوسَی الضَّبِّیِّ ، قَالَ : رَأَیْتُ جَارِیَۃَ أَنَسِ بْنِ مَالِکٍ تَقْطَعُ التَّذْنِیبَ مِنَ الْبُسْرِ ، فَتَنْبِذُہُ عَلَی حِدَۃٍ ، وَتنْبِذُ الْبُسْرِ عَلَی حِدَۃٍ۔","","Musannaf Ibn Abi Shaybah 24496","","","كتاب الأشربة"
"24497","(۲۴۴۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَاتِمِ بْنِ أَبِی صَغِیرَۃَ ، عَنْ أَبِی مُصْعَبٍ الْمَدَنِیِّ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : لَمَّا حُرِّمَتِ الْخَمْرُ کَانُوا یَأْخُذُونَ الْبُسْرَ فَیَقْطَعُونَ مِنْہُ کُلَّ مُذَنَّبٍ ، ثُمَّ یَأْخُذُ الْبُسْرَ فَیَفْضَخُہُ ، ثُمَّ یَشْرَبُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24497","","","كتاب الأشربة"
"24498","(۲۴۴۹۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَارِبٍ ، عَنْ جَابِرٍ ، قَالَ : الْبُسْرُ وَالتَّمْرُ خَمْرٌ۔","Sahih","Musannaf Ibn Abi Shaybah 24498","","","كتاب الأشربة"
"24499","(۲۴۴۹۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، وَمُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، قَالَ : سَأَلَ رَجُلٌ عُمَرَ عَنِ الْفَضِیخِ، فَقَالَ : وَمَا الْفَضِیخُ ؟ قَالَ : بُسْرٌ یُفْضَخُ ثُمَّ یُخْلَطُ بِالتَّمْرِ ، فَقَالَ : ذَاکَ الْفَضُوخُ ، قَالَ : حُرِّمَتِ الْخَمْرُ وَمَا شَرَابٌ غَیْرُہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24499","","","كتاب الأشربة"
"24500","(۲۴۵۰۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : یُکْرَہُ خَلْطُ الْبُسْرِ وَالتَّمْرِ ، وَالزَّبِیبِ وَالتَّمْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 24500","","","كتاب الأشربة"
"24501","(۲۴۵۰۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ یَزِیدَ بْنِ کَیْسَانَ ، قَالَ : سَأَلْتُ أَبَا الشَّعْثَائِ جَابِرَ بْنَ زَیْدٍ عَنِ الْفَضِیخِ ؟ قَالَ : وَمَا الْفَضِیخُ ؟ قُلْتُ : الْبُسْرُ وَالتَّمْرُ ، فَقَالَ : وَاللَّہِ لأَنْ تَأْخُذَ الْمَائَ وَتَغْلِیَہُ فَتَجْعَلَہُ فِی بَطْنِکَ ، خَیْرٌ مِنْ أَنْ تَجْمَعَہُمَا جَمِیعًا فِی بَطْنِک۔","","Musannaf Ibn Abi Shaybah 24501","","","كتاب الأشربة"
"24502","(۲۴۵۰۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ أَشْعَثَ ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ ، قَالَ : کَانَ أبُو مَسْعُودٍ الأَنْصَارِیُّ یَأْمُرُ أَہْلَہُ بِقَطْعِ الْمُذَنَّبِ مِنَ الْبُسْرِ ، فَیُنْبَذُ کُلُّ وَاحِدٍ مِنْہُمَا عَلَی حِدَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 24502","","","كتاب الأشربة"
"24503","(۲۴۵۰۳) حَدَّثَنَا عَفَّانُ بْنُ مُسْلِمٍ، قَالَ: حدَّثَنَا الْمُثَنَّی بْنُ عَوْفٍ، قَالَ: حَدَّثَنَا أَبُو عَبْدِ اللہِ الْجَسْرِیُّ، عَنْ مَعْقِلِ بْنِ یَسَارٍ؛ أَنَّہُ سَأَلَہُ عَنِ الشَّرَابِ؟ فَقَالَ: کُنَّا بِالْمَدِینَۃِ وَکَانَتْ کَثِیرَۃَ التَّمْرِ ، فَحَرَّمَ عَلَیْنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْفَضِیخَ ، قَالَ : جَائَ رَجُلٌ یَسْأَلُہُ عَنْ أُمِّہِ ، قَدْ بَلَغَتْ سِنًّا لاَ تَأْکُلُ الطَّعَامَ ، أَیَسْقِیہَا النَّبِیذَ؟ قَالَ: قُلْتُ لَہُ : یَا مَعْقِلَ بْنَ یَسَارٍ ، قَالَ : مَا أَمَرْتَہُ بِہِ ؟ قَالَ : أَمَرْتُہُ أَنْ لاَ یَسْقِیَہَا۔ (طبرانی ۵۰۵۔ طیالسی ۹۳۴)","Sahih","Musannaf Ibn Abi Shaybah 24503","","","كتاب الأشربة"
"24504","(۲۴۵۰۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ التَّمْرِ وَالزَّبِیبِ یُخْلَطَانِ ، وَعَنِ الْبُسْرِ وَالتَّمْرِ یُخْلَطَانِ۔ (مسلم ۲۰۔ ترمذی ۱۸۷۷)","Sahih","Musannaf Ibn Abi Shaybah 24504","","","كتاب الأشربة"
"24505","(۲۴۵۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : کُنَّا فِی بَیْتِ أَبِی طَلْحَۃَ وَمَعَنَا سُہَیْلُ بْنُ بَیْضَائَ ، وَأُبَیُّ بْنُ کَعْبٍ ، وَأَبُو عُبَیْدَۃَ ، وَہُمْ یَشْرَبُونَ شَرَابًا لَہُمْ ، إِذْ نَادَی مُنَادٍ : أَلاَ إِنَّ الْخَمْرَ قَدْ حُرِّمَتْ ، فَوَاللَّہِ مَا نَظَرُوا أَصِدْقٌ ، أَوْ کَذِبٌ حَتَّی قَالُوا : یَا أَنَسُ ، أَکْفِئْ مَا بَقِیَ فِی الإِنَائِ ، فَأَکْفَأْنَاہُ ، وَہُوَ یَوْمَئِذٍ الْبُسْرُ وَالتَّمْرُ ، فَوَاللَّہِ مَا عَادُوا فِیہَا حَتَّی لَقُوا اللَّہَ۔ (مسلم ۱۵۷۰۔ ابوداؤد ۳۶۶۵)","Sahih","Musannaf Ibn Abi Shaybah 24505","","","كتاب الأشربة"
"24506","(۲۴۵۰۶) حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تَجْمَعُوا بَیْنَ الزَّہْوِ وَالرُّطَبِ ، وَالزَّبِیبِ وَالتَّمْرِ ، انْبِذُوا کُلَّ وَاحِدٍ مِنْہُمَا عَلَی حِدَۃٍ۔ (مسلم ۱۵۷۶۔ ابن حبان ۵۳۸۱)","Hasan","Musannaf Ibn Abi Shaybah 24506","","","كتاب الأشربة"
"24507","(۲۴۵۰۷) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، عَنْ عَمَّارِ بْنِ رُزَیْقٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : کَانَ الرَّجُلُ یَمُرُّ عَلَی أَصْحَابِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُمْ مُتَوَافِرُونَ ، فَیَلْعَنُونَہُ وَیَقُولُونَ : ہَذَا یَشْرَبُ الْخَلِیطَیْنِ : الزَّبِیبَ وَالتَّمْرَ۔","Da'if","Musannaf Ibn Abi Shaybah 24507","","","كتاب الأشربة"
"24508","(۲۴۵۰۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ عَدِیِّ بْنِ ثَابِتٍ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ؛ أَنَّہُ کَانَ یَشْرَبُ الطِّلاَئَ عَلَی النِّصْفِ۔","Sahih","Musannaf Ibn Abi Shaybah 24508","","","كتاب الأشربة"
"24509","(۲۴۵۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ جَبْرٍ ، قَالَ : رَأَیْتُ أَبَا جُحَیْفَۃَ یَشْرَبُ الطِّلاَئَ عَلَی النِّصْفِ۔","Da'if","Musannaf Ibn Abi Shaybah 24509","","","كتاب الأشربة"
"24510","(۲۴۵۱۰) حَدَّثَنَا وَکِیعٌ، عَنْ جَرِیرِ بْنِ أَیُّوبَ، عَنْ أَبِی زُرْعَۃَ بْنِ عَمْرِو بْنِ جَرِیرٍ؛ أَنَّ جَرِیرًا کَانَ یَشْرَبُہُ عَلَی النِّصْفِ۔","Da'if","Musannaf Ibn Abi Shaybah 24510","","","كتاب الأشربة"
"24511","(۲۴۵۱۱) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ سُلَیْمَانَ، وَوَکِیعٌ، عَنْ عُبَیْدَۃَ، عَنْ خَیْثَمَۃَ، عَنْ أَنَسٍ؛ أَنَّہُ کَانَ یَشْرَبُہُ عَلَی النِّصْفِ۔","Da'if","Musannaf Ibn Abi Shaybah 24511","","","كتاب الأشربة"
"24512","(۲۴۵۱۲) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ أَشْعَثَ ، عَنْ جَعْفَرِ ؛ أَنَّ ابْنَ أَبْزَی کَانَ یَشْرَبُ الطِّلاَئَ عَلَی النِّصْفِ۔","","Musannaf Ibn Abi Shaybah 24512","","","كتاب الأشربة"
"24513","(۲۴۵۱۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنِ الْمُنْذِرِ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ؛ أَنَّہُ کَانَ یشْرَبُ الطِّلاَئَ الْمقدی ، یَعْنِی مَا طُبِخَ عَلَی النِّصْفِ۔","","Musannaf Ibn Abi Shaybah 24513","","","كتاب الأشربة"
"24514","(۲۴۵۱۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ شُرَیْحٌ یَشْرَبُ الطِّلاَئَ عَلَی النِّصْفِ ، یَشْرَبُ الطِّلاَئَ الشَّدِیدَ ، یَعْنِی الْمُنَصَّفَ۔","","Musannaf Ibn Abi Shaybah 24514","","","كتاب الأشربة"
"24515","(۲۴۵۱۵) حَدَّثَنَا شَرِیکٌ ، عَنْ أَیُّوبَ ، قَالَ : رَأَیْتُ أَبَا عُبَیْدَۃَ یَشْرَبُہُ عَلَی النِّصْفِ۔","","Musannaf Ibn Abi Shaybah 24515","","","كتاب الأشربة"
"24516","(۲۴۵۱۶) حَدَّثَنَا ابْنُ أَبِی غنیۃَ ، عَن إِسْمَاعِیلَ ، عَنْ قَیْسٍ ، أّنَّہُ کَانَ یَشْرَبُہُ عَلَی النِّصْفِ۔","","Musannaf Ibn Abi Shaybah 24516","","","كتاب الأشربة"
"24517","(۲۴۵۱۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دِینَارٍ الأَعْرَجِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : شَرِبَ عِنْدِی الطِّلاَئَ عَلَی النِّصْفِ۔","","Musannaf Ibn Abi Shaybah 24517","","","كتاب الأشربة"
"24518","(۲۴۵۱۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، وَوَکِیعٌ ، عَنِ الأَعْمَشِ ؛ أَنَّ إِبْرَاہِیمَ کَانَ یَشْرَبُہُ عَلَی النِّصْفِ۔","","Musannaf Ibn Abi Shaybah 24518","","","كتاب الأشربة"
"24519","(۲۴۵۱۹) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ یَحْیَی ، قَالَ : رَأَیْتُہُ یَشْرَبُ الطِّلاَئَ عَلَی النِّصْفِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24519","","","كتاب الأشربة"
"24520","(۲۴۵۲۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ؛ أَنَّہُ کَانَ یَشْرَبُ مَعَہُ الطِّلاَئَ عَلَی النِّصْفِ ، قَالَ : فَشَرِبَ وَسَقَانِی۔","No Data Available","Musannaf Ibn Abi Shaybah 24520","","","كتاب الأشربة"
"24521","(۲۴۵۲۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ؛ أَنَّہُ کَانَ یُنْبَذُ لَہُ الطِّلاَئُ وَیُجْعَلُ فِیہِ دُرْدِیٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 24521","","","كتاب الأشربة"
"24522","(۲۴۵۲۲) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنِ أَبِی سِنَانٍ ، عَنْ ثَابِتٍ ، عَنِ الضَّحَّاکِ ؛ أَنَّہُ کَانَ یَنْبِذُ الْبُخْتُجَ۔","","Musannaf Ibn Abi Shaybah 24522","","","كتاب الأشربة"
"24523","(۲۴۵۲۳) حَدَّثَنَا إِسْحَاقُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ اللہِ بْنِ جَابِرٍ ، عَنْ مُجَاہِدٍ ؛ فِی نَبِیذِ الْبُخْتُجِ ، قَالَ : کَانَ نَائِمًا فَأَنْبَہْتُہُ۔","","Musannaf Ibn Abi Shaybah 24523","","","كتاب الأشربة"
"24524","(۲۴۵۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِنَبِیذِ الْبُخْتُجِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24524","","","كتاب الأشربة"
"24525","(۲۴۵۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی حُجَیْرٍ ، قَالَ : سَقَانَا الضَّحَّاکُ نَبِیذَ الْبُخْتُجِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24525","","","كتاب الأشربة"
"24526","(۲۴۵۲۶) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُئِلَ مُحَمَّدٌ عَنْ فَضِیخِ الْبُسْرِ وَحْدَہُ ؟ قَالَ : لاَ أَدْرِی مَا ہُوَ۔","","Musannaf Ibn Abi Shaybah 24526","","","كتاب الأشربة"
"24527","(۲۴۵۲۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَاتِمِ بْنِ أَبِی صَغِیرَۃَ ، عَنْ أَبِی مُصْعَبٍ الْمَدَنِیِّ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ: کُنَّا نَأْخُذُ الْبُسْرَ فَنَفْضَخُہُ ، ثُمَّ نَشْرَبُہُ۔","","Musannaf Ibn Abi Shaybah 24527","","","كتاب الأشربة"
"24528","(۲۴۵۲۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ شَرِبَ الْفَضِیخَ عِنْدَ مَسْجِدِ الْفَضِیخِ۔ (احمد ۲/۱۰۶۔ ابویعلی ۵۷۰۷)","Da'if","Musannaf Ibn Abi Shaybah 24528","","","كتاب الأشربة"
"24529","(۲۴۵۲۹) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ ، قَالاَ : لاَ بَأْسَ أَنْ یُفْتَضَخَ الْعِذْقُ بِمَا فِیہِ۔","","Musannaf Ibn Abi Shaybah 24529","","","كتاب الأشربة"
"24530","(۲۴۵۳۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مِسحاجٍ ، قَالَ : سَمِعْتُ أَنَسًا وَہُوَ یَأْمُرُ خَادِمَہُ أَنْ یَقْطَعَ الرُّطَبَ مِنَ الْبُسْرِ ، فَیَنْتَبِذُ کُلَّ وَاحِدٍ مِنْہُمَا عَلَی حِدَۃٍ۔","Hasan","Musannaf Ibn Abi Shaybah 24530","","","كتاب الأشربة"
"24531","(۲۴۵۳۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَرِہَ الْفَضِیخَ ، وَإِنْ کَانَ مَحْضًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24531","","","كتاب الأشربة"
"24532","(۲۴۵۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ ، لاَ بَأْسَ بِالتَّذْنُوبِ۔","","Musannaf Ibn Abi Shaybah 24532","","","كتاب الأشربة"
"24533","(۲۴۵۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ، عَنِ النُّعْمَانِ بْنِ الْمُنْذِرِ، عَنْ مَکْحُولٍ؛ أَنَّہُ کَانَ یَکْرَہُ الْمُرِّیَّ الَّذِی یُجْعَلُ فِیہِ الْخَمْرُ۔","","Musannaf Ibn Abi Shaybah 24533","","","كتاب الأشربة"
"24534","(۲۴۵۳۴) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ دَاوُدَ بْنِ عَمْرٍو ، عَنْ مَکْحُولٍ ، عَنْ أَبِی الدَّرْدَائِ ؛ فِی الْمُرِّیِّ یُجْعَلُ فِیہِ الْخَمْرُ ، قَالَ : لاَ بَأْسَ بِہِ ، ذَبَحَتْہُ الشَّمْسُ وَالْمِلْحُ۔","","Musannaf Ibn Abi Shaybah 24534","","","كتاب الأشربة"
"24535","(۲۴۵۳۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : مَنْ شَرِبَ الْخَمْرَ فِی الدُّنْیَا لَمْ یَشْرَبْہَا فِی الآخِرَۃِ ، إِلاَّ أَنْ یَتُوبَ۔ (مسلم ۷۸۔ احمد ۲/۲۱)","Sahih","Musannaf Ibn Abi Shaybah 24535","","","كتاب الأشربة"
"24536","(۲۴۵۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : قَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ شَرِبَ الْخَمْرَ فَجَعَلَہَا فِی بَطْنِہِ ، لَمْ تُقْبَلْ لَہُ صَلاَۃٌ سَبْعًا ، إِنْ مَاتَ فِیہَا مَاتَ کَافِرًا ، فَإِنْ أَذْہَبَتْ عَقْلَہُ عَنْ شَیْئٍ مِنَ الْفَرَائِضِ ، لَمْ تُقْبَلْ لَہُ صَلاَۃٌ أَرْبَعِینَ یَوْمًا ، فَإِنْ مَاتَ فِیہَا مَاتَ کَافِرًا۔ (نسائی ۵۱۷۹۔ طبرانی ۱۳۴۹۲)","Da'if","Musannaf Ibn Abi Shaybah 24536","","","كتاب الأشربة"
"24537","(۲۴۵۳۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ حَسَّانِ بْنِ أَبِی وَجْزَۃَ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لأَنْ أَزْنِیَ أَحَبَّ إِلَیَّ مِنْ أَنْ أَشْرَبَ خَمْرًا ، إِنِّی إِذَا شَرِبْتُ الْخَمْرَ تَرَکْتُ الصَّلاَۃَ ، وَمَنْ تَرَکَ الصَّلاَۃَ فَلاَ دِینَ لَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24537","","","كتاب الأشربة"
"24538","(۲۴۵۳۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ الْعَوَّامِ بْنِ حَوْشَبٍ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : مُعَاقِرُ الْخَمْرِ کَعَابِدِ اللاَّتِ وَالْعُزَّی۔","Hasan","Musannaf Ibn Abi Shaybah 24538","","","كتاب الأشربة"
"24539","(۲۴۵۳۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ وَائِلِ بْنِ أبِی بَکْرٍ ، عَنْ أبِی بَکْرٍ ، عَنْ أَبِی بُرْدَۃَ ، عَنْ أبِی مُوسَی ، أَنَّہُ کَانَ یَقُولُ : مَا أُبَالِی أَشَرِبْتُ الْخَمْرَ ، أَمْ عَبَدْتُ ہَذِہِ السَّارِیَۃِ مِنْ دُونِ اللہِ۔","Sahih","Musannaf Ibn Abi Shaybah 24539","","","كتاب الأشربة"
"24540","(۲۴۵۴۰) حَدَّثَنَا ابْنُ مُبَارَکٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ سُلَیْمَانَ بْنِ حَبِیبٍ ؛ أَنَّ ابْنَ عُمَرَ قَالَ : لَوْ أَدْخَلْتُ إِصْبَعِی فِی خَمْرٍ مَا أَحْبَبْتُ أَنْ تَرْجِعَ إِلَیَّ۔","Sahih","Musannaf Ibn Abi Shaybah 24540","","","كتاب الأشربة"
"24541","(۲۴۵۴۱) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ عُرْوَۃَ بْنِ رُوَیْمٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَوَّلُ مَا نَہَانِی رَبِّی ؛ عَنْ شُرْبِ الْخَمْرِ ، وَعِبَادَۃِ الأَوْثَانِ ، وَمُلاَحَاۃِ الرِّجَالِ۔ (ابوداؤد ۵۰۶)","","Musannaf Ibn Abi Shaybah 24541","","","كتاب الأشربة"
"24542","(۲۴۵۴۲) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی عَوْنٍ ، عَنِ ابْنِ شَدَّادٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : حُرِّمَتِ الْخَمْرُ بِعَیْنِہَا ، قَلِیلِہَا وَکَثِیرِہَا ، وَالسَّکَرُ مِنْ کُلِّ شَرَابٍ۔","Sahih","Musannaf Ibn Abi Shaybah 24542","","","كتاب الأشربة"
"24543","(۲۴۵۴۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن أَبِیہِ ؛ أَنَّہُ سَمِعَ عُثْمَانَ یَخْطُبُ ، فَذَکَرَ الْخَمْرَ فَقَالَ : ہِیَ مَجْمَعُ الْخَبَائِثِ ، أَوْ ہِی أُمُّ الْخَبَائِثِ ، ثُمَّ أَنْشَأَ یُحَدِّثُ عَنْ بَنِی إسْرَائِیلَ فَقَالَ : إِنَّ رَجُلاً خُیِّرَ بَیْنَ أَنْ یَقْتُلَ صَبِیًّا ، أَوْ یَمْحُوَ کِتَابًا ، أَوْ یَشْرَبَ خَمْرًا ، فَاخْتَارَ الْخَمْرَ فَمَا بَرِحَ حَتَّی فَعَلَہُنَّ کُلَّہُنَّ۔\n(ابن حبان ۵۳۴۸۔ بیہقی ۲۸۷)","Sahih","Musannaf Ibn Abi Shaybah 24543","","","كتاب الأشربة"
"24544","(۲۴۵۴۴) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ طَلْحَۃَ ، عَنْ مَسْرُوقٍ ، قَالَ : شَارِبُ الْخَمْرِ کَعَابِدِ الْوَثَنِ۔","","Musannaf Ibn Abi Shaybah 24544","","","كتاب الأشربة"
"24545","(۲۴۵۴۵) حَدَّثَنَا مُحَمَّدُ بْنُ سُلَیْمَانَ الأَصْبَہَانِیُّ ، عَنْ سُہَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ : مُدْمِنُ الْخَمْرِ کَعَابِدِ الْوَثَنِ۔ (بخاری ۳۸۶۔ ابن ماجہ ۳۳۷۵)","Da'if","Musannaf Ibn Abi Shaybah 24545","","","كتاب الأشربة"
"24546","(۲۴۵۴۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَحْیَی بْنِ عَبَّادِ بْنِ عَبْدِ اللہِ بْنِ الزُّبَیْرِ ، عَنْ أَبِیہِ ، قَالَ : کُنَّا عِنْدَ عَائِشَۃَ ، فَمَرَّتْ جَلَبَۃٌ عَلَی بَابِہَا ، فَسَمِعَتِ الصَّوْتَ ، فَقَالَتْ : مَا ہَذَا ؟ فَقَالُوا : رَجُلٌ ضُرِبَ فِی الْخَمْرِ ، قَالَتْ سُبْحَانَ اللہِ ، سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ ، وَلاَ یَشْرَبُ الْخَمْرَ حِینَ یَشْرَبُ وَہُوَ مُؤْمِنٌ ، وَلاَ یَسْرِقُ السَّارِقُ حِینَ یَسْرِقُ وَہُوَ مُؤْمِنٌ ، فَإِیَّاکُمْ إِیَّاکُمْ۔","","Musannaf Ibn Abi Shaybah 24546","","","كتاب الأشربة"
"24547","(۲۴۵۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَزْنِی الزَّانِی حِینَ یَزْنِی وَہُوَ مُؤْمِنٌ ، وَلاَ یَسْرِقُ حِینَ یَسْرِقُ وَہُوَ مُؤْمِنٌ ، وَلاَ یَشْرَبُ الْخَمْرَ حِینَ یَشْرَبُ وَہُوَ مُؤْمِنٌ ، وَلاَ یَنْتَہِبُ نُہْبَۃً ، یَرْفَعُ النَّاسُ فِیہَا أَبْصَارَہُمْ وَہُوَ مُؤْمِنٌ۔\n(نسائی ۷۱۲۶)","Hasan","Musannaf Ibn Abi Shaybah 24547","","","كتاب الأشربة"
"24548","(۲۴۵۴۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُدْرِکٍ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَشْرَبُ الْخَمْرَ حِینَ یَشْرَبُہَا وَہُوَ مُؤْمِنٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24548","","","كتاب الأشربة"
"24549","(۲۴۵۴۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ کَانَ یَنہَی أَنْ تُسْقَی الْبَہَائِمُ الْخَمْرَ۔","Sahih","Musannaf Ibn Abi Shaybah 24549","","","كتاب الأشربة"
"24550","(۲۴۵۵۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ بَلَغَہُ أَنَّ نِسَائً یَمْتَشِطْنَ بِالْخَمْرِ ، فَقَالَ : أَلْقَی اللَّہُ فِی رُؤُوسِہِنَّ الْحَاصَّۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 24550","","","كتاب الأشربة"
"24551","(۲۴۵۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ مُجَالِدٍ ، عَنْ أَبِی السَّفَرِ ، عَنِ امْرَأَتِہِ ؛ أَنَّ عَائِشَۃَ سُئِلَتْ عَنِ الْمَرْأَۃِ تَمْتَشِطُ بِالْعَسَلَۃِ فِیہَا الْخَمْرُ ؟ فَنَہَتْ عَنْ ذَلِکَ أَشَدَّ النَّہْیِ۔","Da'if","Musannaf Ibn Abi Shaybah 24551","","","كتاب الأشربة"
"24552","(۲۴۵۵۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ حَمَّادٍ، عَنْ إِبْرَاہِیمَ، عَن حُذَیْفَۃَ، قَالَ : تَمْتَشِطُ بِالْخَمْرِ؟ لاَ طَیَّبَہَا اللَّہُ۔","","Musannaf Ibn Abi Shaybah 24552","","","كتاب الأشربة"
"24553","(۲۴۵۵۳) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ نَافِعٍ ، قَالَ : کَانَتْ لابْنِ عُمَرَ بُخْتِیَّۃٌ ،وَإِنَّہَا مَرِضَتْ فَوُصِفَ لِی أَنْ أُدَاوِیَہَا بِالْخَمْرِ ، فَدَاوَیْتُہَا ، ثُمَّ قُلْتُ لابْنِ عُمَرَ : إِنَّہُمْ وَصَفُوا لِی أَنْ أُدَاوِیَہَا بِالْخَمْرِ ، قَالَ : فَفَعَلْتُ ؟ قُلْتُ : لاَ ، وَقَدْ کُنْتُ فَعَلْتُ ، قَالَ : أَمَا إِنَّکَ لَوْ فَعَلْتَ لَعَاقَبْتُکَ۔","Hasan","Musannaf Ibn Abi Shaybah 24553","","","كتاب الأشربة"
"24554","(۲۴۵۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لاَ یَدْخُلُ الْجَنَّۃَ مُدْمِنُ الْخَمْرِ ، وَلاَ عَاقٌّ ، وَلاَ مَنَّانٌ۔ (نسائی ۵۱۸۲۔ احمد ۲/۱۶۴)","Da'if","Musannaf Ibn Abi Shaybah 24554","","","كتاب الأشربة"
"24555","(۲۴۵۵۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، وَمُجَاہِدٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَدْخُلُ الْجَنَّۃَ عَاقٌّ ، وَلاَ مُدْمِنٌ ، وَلاَ مَنَّانٌ۔ (بیہقی ۷۸۷۴)","Da'if","Musannaf Ibn Abi Shaybah 24555","","","كتاب الأشربة"
"24556","(۲۴۵۵۶) حَدَّثَنَا یَحْیَی بْنُ إِسْحَاقَ ، قَالَ : أَخْبَرَنَا یَحْیَی بْنُ أَیُّوبَ ، عَنْ عُبَیْدِ اللہِ بْنِ زُحَرَ ، عَنْ بَکْرِ بْنِ سَوَادَۃَ، عَنْ قَیْسِ بْنِ سَعْدِ بْنِ عُبَادَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنَّ رَبِّی حَرَّمَ عَلَیَّ الْخَمْرَ ، وَالْکُوبَۃَ ، وَالْقِنِّینَ ، یَعْنِی الْعُودَ ، ثُمَّ قَالَ : إِیَّاکُمْ وَالتّغْبِیرَ ، فَإِنَّہَا خَمْرُ الْعَالم۔ (احمد ۳/۴۲۲۔ بیہقی ۲۲۲)","Da'if","Musannaf Ibn Abi Shaybah 24556","","","كتاب الأشربة"
"24557","(۲۴۵۵۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عَبْدُ الْعَزِیزِ ، قَالَ : حَدَّثَنِی نَافِعٌ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَزَلَ تَحْرِیمُ الْخَمْرِ وَإِنَّ بِالْمَدِینَۃِ خَمْسَۃَ أَشْرِبَۃٍ یَدْعُونَہَا الْخَمْرَ ، مَا فِیہَا خَمْرُ الْعِنَبِ۔ (بخاری ۴۶۱۶۔ مسلم ۳۲)","Sahih","Musannaf Ibn Abi Shaybah 24557","","","كتاب الأشربة"
"24558","(۲۴۵۵۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی إِسْحَاقَ الشَّیْبَانِیِّ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : لَمَّا أُسْرِیَ بِالنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أُوتِیَ بِدَابَّۃٍ حَتَّی أَتَی بَیْتَ الْمَقْدِسِ ، فَأُتِیَ بِإِنَائَیْنِ ؛ فِی وَاحِدٍ خَمْرٌ ، وَفِی آخَرَ لَبَنٌ ، فَأَخَذَ اللَّبَنَ ، فَقَالَ لَہُ جِبْرِیلُ : ہُدِیْتَ ، وَہُدِیَتْ أُمَّتُکَ۔ (ابن جریر ۱۵)","","Musannaf Ibn Abi Shaybah 24558","","","كتاب الأشربة"
"24559","(۲۴۵۵۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ وَائِلِ بْنِ دَاوُد التَّیْمِیِّ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ ، قَالَ : قَالَ الأَشْعَرِیُّ : لأَنْ أُصَلِّی لِسَارِیَۃٍ أَحَبَّ إِلَیَّ مِنْ أَنْ أَشْرَبَ الْخَمْرَ۔","","Musannaf Ibn Abi Shaybah 24559","","","كتاب الأشربة"
"24560","(۲۴۵۶۰) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ أَبِی الأَشْہَبِ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا یَسُرُّنِی أَنِّی شَرِبْتُ إنَائً مِنْ خَمْرٍ ، وَأَنِّی تَصَدَّقْتُ بِمِثْلِہِ ذَہَبًا۔","Hasan","Musannaf Ibn Abi Shaybah 24560","","","كتاب الأشربة"
"24561","(۲۴۵۶۱) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ قَیْسٍ ، عَنْ مَکْحُولٍ ، قَالَ : أَوْصَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَعْضَ أَہْلِی أَلاَ یَشْرَبَ الْخَمْرَ ، فَإِنَّ شُرْبَہَا مِفْتَاحُ کُلِّ شَرٍّ۔","Da'if","Musannaf Ibn Abi Shaybah 24561","","","كتاب الأشربة"
"24562","(۲۴۵۶۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ أَبِی حَیَّانَ، قَالَ: أَخْبَرَنِی أَبُو الْفُرَاتِ، عَنْ أَبِی دَاوُدَ ، قَالَ: کُنْتُ عِنْدَ مِنْبَرِ حُذَیْفَۃَ وَہُوَ بِالْمَدَائِنِ ، فَحَمِدَ اللَّہَ وَأَثْنَی عَلَیْہِ ، ثُمَّ قَالَ : أَمَّا بَعْدُ فَإِنَّ بَائِعَ الْخَمْرِ وَشَارِبَہَا فِی الإِثْمِ سَوَائٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24562","","","كتاب الأشربة"
"24563","(۲۴۵۶۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ زُبَیْدٍ ، عَنْ خَیْثَمَۃَ ؛ أَنَّہُ سَمِعَہُ یَقُولُ : کُنْتُ قَاعِدًا عِنْدَ عَبْدِ اللہِ بْنِ عَمْرٍو ، فَذَکَرَ الْکَبَائِرَ حَتَّی ذَکَرَ الْخَمْرَ ، فَکَأَنَّ رَجُلاً تَہَاوَنَ بِہَا ، فَقَالَ عَبْدُ اللہِ بْنُ عَمْرٍو : لاَ یَشْرَبُہَا رَجُلٌ مُصْبِحًا إِلاَّ ظَلَّ مُشْرِکًا حَتَّی یُمْسِیَ۔","Sahih","Musannaf Ibn Abi Shaybah 24563","","","كتاب الأشربة"
"24564","(۲۴۵۶۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ النُّعْمَانِ بْنِ أَبِی عَیَّاشٍ ، قَالَ : أرْسَلْنَا إِلَی عَبْدِ اللہِ بْنِ عَمْرٍو نَسْأَلُہُ عَنْ أَیِّ الْکَبَائِرِ أَکْبَرُ ؟ فَقَالَ : الْخَمْرُ ، فَأَعَدْنَا إِلَیْہِ الرَّسُولَ ، فَقَالَ : الْخَمْرُ ، إِنَّہُ مَنْ شَرِبَہَا لَمْ تُقْبَلْ لَہُ صَلاَۃٌ سَبْعًا ، فَإِنْ سَکِرَ لَمْ تُقْبَلْ لَہُ صَلاَۃٌ أَرْبَعِینَ یَوْمًا ، فَإِنْ مَاتَ فِیہَا مَاتَ مِیتَۃً جَاہِلِیَّۃً۔","Sahih","Musannaf Ibn Abi Shaybah 24564","","","كتاب الأشربة"
"24565","(۲۴۵۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حَدَّثَنَا سَعِیدُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ رَبِیعَۃَ بْنِ یَزِیدَ ، عَنِ ابْنِ الدَّیْلَمِیِّ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ بْنَ عَمْرٍو عَنْ شَارِبِ الْخَمْرِ ؟ فَقَالَ : لاَ تُقْبَلُ لَہُ صَلاَۃٌ أَرْبَعِینَ یَوْمًا ، أَوْ أَرْبَعِینَ لَیْلَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 24565","","","كتاب الأشربة"
"24566","(۲۴۵۶۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ فِی الْحُبِّ تَقَعُ فِیہِ الْقَطْرَۃُ مِنَ الْخَمْرِ ، أَوِ الدَّمِ ، قَالَ : یُہْرَاقُ۔","","Musannaf Ibn Abi Shaybah 24566","","","كتاب الأشربة"
"24567","(۲۴۵۶۷) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ التَّیْمِیِّ ، عَنْ أُمِّ حِرَاشٍ ؛ أَنَّہَا رَأَتْ عَلِیًّا یَصْطَبِغُ بِخَلِّ الْخَمْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 24567","","","كتاب الأشربة"
"24568","(۲۴۵۶۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، عَنْ أَبِی الزَّاہِرِیَّۃِ ، عَنْ جُبَیْرِ بْنِ نُفَیْرٍ ، قَالَ : اخْتَلَفَ رَجُلاَنِ مِنْ أَصْحَابِ مُعَاذٍ فِی خَلِّ الْخَمْرِ ، فَسَأَلاَ أَبَا الدَّرْدَائِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔","Hasan","Musannaf Ibn Abi Shaybah 24568","","","كتاب الأشربة"
"24569","(۲۴۵۶۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنْ مُسَرْبَلٍ الْعَبْدِیِّ ، عَنْ أُمِّہِ ، قَالَتْ : سَأَلْتُ عَائِشَۃَ عَنْ خَلِّ الْخَمْرِ ، قَالَتْ : لاَ بَأْسَ بِہِ ، ہُوَ إِدَامٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24569","","","كتاب الأشربة"
"24570","(۲۴۵۷۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ نَافِعٍ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَأْکُلَ مِمَّا کَانَ خَمْرًا فَصَارَ خَلاًّ۔","Da'if","Musannaf Ibn Abi Shaybah 24570","","","كتاب الأشربة"
"24571","(۲۴۵۷۱) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ لاَ یَقُولُ : خَلُّ خَمْرٍ ، وَیَقُولُ : خَلُّ الْعِنَبِ ، وَکَانَ یَصْطَبِغُ فِیہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24571","","","كتاب الأشربة"
"24572","(۲۴۵۷۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ یَحْیَی بْنِ عَتِیقٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِخَلِّ الْخَمْرِ۔","","Musannaf Ibn Abi Shaybah 24572","","","كتاب الأشربة"
"24573","(۲۴۵۷۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ إِسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، قَالَ : رَأَیْتُ سَعِیدَ بْنَ جُبَیْرٍ یَصْطَبِغُ بِخَلِّ خَمْرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 24573","","","كتاب الأشربة"
"24574","(۲۴۵۷۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِخَلِّ خَمْرٍ۔","","Musannaf Ibn Abi Shaybah 24574","","","كتاب الأشربة"
"24575","(۲۴۵۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ السُّدِّیِّ ، عَنْ یَحْیَی بْنِ عَبَّادٍ ، عَنْ أَنَسٍ ؛ أَنَّ أَبَا طَلْحَۃَ سَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ أَیْتَامٍ وَرِثُوا خَمْرًا ، أَیَجْعَلُہُ خَلاًّ ؟ فَکَرِہَہُ۔ (ابوداؤد ۳۶۶۷۔ احمد ۱۱۹)","Hasan","Musannaf Ibn Abi Shaybah 24575","","","كتاب الأشربة"
"24576","(۲۴۵۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مُثَنَّی بْنِ سَعِیدٍ ، قَالَ : شَہِدْتُ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ إلَی عَامِلِہِ بِوَاسِطٍ أَنْ لاَ تَحْمِلُوا الْخَمْرَ مِنْ قَرْیَۃٍ إلَی قَرْیَۃٍ ، وَمَا أَدْرَکْتَ فَاجْعَلْہُ خَلاًّ۔","","Musannaf Ibn Abi Shaybah 24576","","","كتاب الأشربة"
"24577","(۲۴۵۷۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنِ الْقَاسِمِ ، عَنْ أَسْلَمَ ، قَالَ : قَالَ عُمَرُ : لاَ بَأْسَ بِخَلٍّ وَجَدْتَہُ مَعَ أَہْلِ الْکِتَابِ ، مَا لَمْ تَعْلَمْ أَنَّہُمْ تَعَمَّدُوا فَسَادَہَا بَعْدَ مَا صَارَتْ خَمْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 24577","","","كتاب الأشربة"
"24578","(۲۴۵۷۸) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، قَالَ : لاَ بَأْسَ أَنْ یُحَوَّلَ الْخَمْرُ خَلاًّ۔","","Musannaf Ibn Abi Shaybah 24578","","","كتاب الأشربة"
"24579","(۲۴۵۷۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، وَحَفْصٌ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَاوَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إدَاوَۃً مِنْ زَمْزَمَ ، فَشَرِبَہَا وَہُوَ قَائِمٌ۔ (مسلم ۱۶۰۲۔ احمد ۲۲۰)","Sahih","Musannaf Ibn Abi Shaybah 24579","","","كتاب الأشربة"
"24580","(۲۴۵۸۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ مُسْلِمٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ یَشْرَبُ قَائِمًا۔","Sahih","Musannaf Ibn Abi Shaybah 24580","","","كتاب الأشربة"
"24581","(۲۴۵۸۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِی سِنَانٍ ، عَنْ أَبِی الْمُعَارِکِ ، قَالَ : سَأَلْتُ أَبَا ہُرَیْرَۃَ عَنْ شُرْبِ الرَّجُلِ وَہُوَ قَائِمٌ ؟ قَالَ : لاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 24581","","","كتاب الأشربة"
"24582","(۲۴۵۸۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ عَلِیًّا کَانَ یَشْرَبُ وَہُوَ قَائِمٌ۔","","Musannaf Ibn Abi Shaybah 24582","","","كتاب الأشربة"
"24583","(۲۴۵۸۳) حَدَّثَنَا مُعْتَمِرٌ ، عن مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّ سَعْدًا وَعَائِشَۃَ کَانَا لاَ یَرَیَانِ بَأْسًا بِالشُّرْبِ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 24583","","","كتاب الأشربة"
"24584","(۲۴۵۸۴) حَدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ شَرِبَ مِنْ قِرْبَۃٍ وَہُوَ قَائِمٌ۔","Hasan","Musannaf Ibn Abi Shaybah 24584","","","كتاب الأشربة"
"24585","(۲۴۵۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مَیْسَرَۃَ ، قَالَ : رَأَیْتُ عَلِیًّا شَرِبَ قَائِمًا ، فَقُلْتُ : شَرِبْتَ قَائِمًا ؟ فَقَالَ : لَئِنْ شَرِبْتُ قَائِمًا ، لَقَدْ رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَشْرَبُ قَائِمًا ، وَلَئِنْ شَرِبْتُ قَاعِدًا ، لَقَدْ رَأَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَشْرَبُ قَاعِدًا۔ (احمد ۱/۱۱۴)","Da'if","Musannaf Ibn Abi Shaybah 24585","","","كتاب الأشربة"
"24586","(۲۴۵۸۶) حَدَّثَنَا شَرِیکٌ ، عَنْ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ عَامِرٍ ؛ أَنَّہُ رَأَی ابْنَ عُمَرَ یَشْرَبُ قَائِمًا۔","Hasan","Musannaf Ibn Abi Shaybah 24586","","","كتاب الأشربة"
"24587","(۲۴۵۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، قَالَ : رَأَیْتُ سَالِمًا یَشْرَبُ وَہُوَ قَائِمٌ۔","","Musannaf Ibn Abi Shaybah 24587","","","كتاب الأشربة"
"24588","(۲۴۵۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَجْلاَنَ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عْنہُ ؟ فَقَالَ : لاَ بَأْسَ بِہِ ، إِنْ شِئْتَ قَائِمًا ، وَإِنْ شِئْتَ قَاعِدًا۔","","Musannaf Ibn Abi Shaybah 24588","","","كتاب الأشربة"
"24589","(۲۴۵۸۹) حَدَّثَنَا یَحیی بن سَعِید ، عَنْ مُجَالِد قَالَ : رَأَیْتُ الشعبِی یَشْرَبُ قَائِمًا ، وَقَاعِدًا۔","","Musannaf Ibn Abi Shaybah 24589","","","كتاب الأشربة"
"24590","(۲۴۵۹۰) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ وَاقِدٍ ، عَنْ زَاذَانَ ، قَالَ : لاَ بَأْسَ بِالشُّرْبِ قَائِمًا ، وَالْجُلُوسُ حِلْمٌ۔","","Musannaf Ibn Abi Shaybah 24590","","","كتاب الأشربة"
"24591","(۲۴۵۹۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ، عَنِ الْحَسَنِ بْنِ الْحَکَمِ، عَنِ الْحُرِّ بْنِ صَیَّاحٍ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عُمَرَ فَقَالَ: مَا تَرَی فِی الشُّرْبِ قَائِمًا ؟ فَقَالَ ابْنُ عُمَرَ : إِنِّی أَشْرَبُ وَأَنَا قَائِمٌ ، وَآکُلُ وَأَنَا أَمْشِی۔","Sahih","Musannaf Ibn Abi Shaybah 24591","","","كتاب الأشربة"
"24592","(۲۴۵۹۲) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، عَنْ یَزِیدَ بْنِ عُطَارِدٍ أَبِی الْبَزَرَی ، قَالَ : قَالَ ابْنُ عُمَرَ : کُنَّا نَشْرَبُ وَنَحْنُ قِیَامٌ ، وَنَأْکُلُ وَنَحْنُ نَسْعَی عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۲/۲۹)","Da'if","Musannaf Ibn Abi Shaybah 24592","","","كتاب الأشربة"
"24593","(۲۴۵۹۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، قَالَ : سَأَلْتُ طَاوُوسًا ، وَسَعِیدَ بْنَ جُبَیْرٍ عَنِ الشُّرْبِ قَائِمًا ؟ فَلَمْ یَرَیَا بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 24593","","","كتاب الأشربة"
"24594","(۲۴۵۹۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ مُجَاہِدٍ، قَالَ: أَخْبَرَنِی مَنْ رَأَی عَلِیًّا بِالْکُوفَۃِ یَشْرَبُ قَائِمًا۔","Da'if","Musannaf Ibn Abi Shaybah 24594","","","كتاب الأشربة"
"24595","(۲۴۵۹۵) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عن عَامِرَ بْنَ عَبْدِ اللہِ بن الزُبَیر قَالَ : رَأَیتُ أَبِی یَشْرَبُ وَہُوَ قَائِمٌ۔","Hasan","Musannaf Ibn Abi Shaybah 24595","","","كتاب الأشربة"
"24596","(۲۴۵۹۶) حَدَّثَنَا حَفْصٌ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنَّا نَشْرَبُ وَنَحْنُ قِیَامٌ ، وَنَأْکُلُ وَنَحْنُ نَمْشِی عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔ (احمد ۱۰۸۔ دارمی ۲۱۲۶)","","Musannaf Ibn Abi Shaybah 24596","","","كتاب الأشربة"
"24597","(۲۴۵۹۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، قَالَ : قَالَ لِی سَعِیدُ بْنُ جُبَیْرٍ : اشْرَبُ قَائِمًا۔","","Musannaf Ibn Abi Shaybah 24597","","","كتاب الأشربة"
"24598","(۲۴۵۹۸) حَدَّثَنَا أَبُوالأَحْوَصِ، عَنْ عَبْدِ اللہِ بْنِ شَرِیکٍ، عَنْ بِشْرِ بْنِ غَالِبٍ، قَالَ: رَأَیْتُ الْحُسَیْنَ شَرِبَ وَہُوَ قَائِمٌ۔","Hasan","Musannaf Ibn Abi Shaybah 24598","","","كتاب الأشربة"
"24599","(۲۴۵۹۹) حَدَّثَنَا وَکِیعٌ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ، عَنْ قَتَادَۃَ، عَنْ أَبِی عِیسَی الآُسْوَارِیِّ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ، قَالَ : زَجَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ رَجُلاً شَرِبَ قَائِمًا۔ (مسلم ۱۱۴۔ ابویعلی ۹۸۴)","Sahih","Musannaf Ibn Abi Shaybah 24599","","","كتاب الأشربة"
"24600","(۲۴۶۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الشُّرْبِ قَائِمًا۔ (مسلم ۱۶۰۱۔ ابوداؤد ۳۷۱۰)","Sahih","Musannaf Ibn Abi Shaybah 24600","","","كتاب الأشربة"
"24601","(۲۴۶۰۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ ، عَنْ أَنَسٍ ؛ أَنَّہُ سَأَلَہُ عَنِ الشُّرْبِ قَائِمًا ؟ فَکَرِہَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24601","","","كتاب الأشربة"
"24602","(۲۴۶۰۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ یَکْرَہُ الشُّرْبَ قَائِمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24602","","","كتاب الأشربة"
"24603","(۲۴۶۰۳) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ إِبْرَاہِیمَ ، قَالَ: إِنَّمَا کُرِہَ الشُّرْبُ قَائِمًا لِدَائٍ یَأْخُذُ الْبَطْنَ۔","","Musannaf Ibn Abi Shaybah 24603","","","كتاب الأشربة"
"24604","(۲۴۶۰۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ ہِشَام ، عَنِ الْحَسَنِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الشُّرْبِ مِنْ أَفْوَاہِ الأَسْقِیَۃِ۔ (مسند ۵۴۴)","Hasan","Musannaf Ibn Abi Shaybah 24604","","","كتاب الأشربة"
"24605","(۲۴۶۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ بْنِ عَبْدِ اللہِ بْنِ عُتْبَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : شَرِبَ رَجُلٌ مِنْ سِقَائٍ فَانْسَابَ فِی بَطْنِہِ جَانٌّ ، فَنَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ اخْتِنَاثِ الأَسْقِیَۃِ۔ (مسلم ۱۱۰۔ ابوداؤد ۳۷۱۳)","Sahih","Musannaf Ibn Abi Shaybah 24605","","","كتاب الأشربة"
"24606","(۲۴۶۰۶) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الشُّرْبِ مِنْ فِی السِّقَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 24606","","","كتاب الأشربة"
"24607","(۲۴۶۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الشُّرْبِ مِنْ فِی السِّقَائِ۔","","Musannaf Ibn Abi Shaybah 24607","","","كتاب الأشربة"
"24608","(۲۴۶۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنِ ابْنِ بِنْتِ أَنَسِ بْنِ مَالِکٍ ، عَنْ أَنَسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ دَخَلَ عَلَی أُمِّ سُلَیْمٍ وَفِی الْبَیْتِ قِرْبَۃٌ مُعَلَّقَۃٌ ، فَشَرِبَ مِنْ فِیہَا وَہُوَ قَائِمٌ۔ (احمد ۶/۳۷۶۔ طبرانی ۲۵)","Da'if","Musannaf Ibn Abi Shaybah 24608","","","كتاب الأشربة"
"24609","(۲۴۶۰۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالشُّرْبِ مِنْ فِی الإِدَاوَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 24609","","","كتاب الأشربة"
"24610","(۲۴۶۱۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ سَالِمٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ، قَالَ: رَأَیْتُ ابْنَ عُمَرَ یَشْرَبُ مِنْ فِی الإِدَاوَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 24610","","","كتاب الأشربة"
"24611","(۲۴۶۱۱) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی رَوَّادٍ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ یَشْرَبُ مِنْ فِی السِّقَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 24611","","","كتاب الأشربة"
"24612","(۲۴۶۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، قَالَ : رَأَیْتُ سَالِمَ بْنَ عَبْدِ اللہِ یَشْرَبُ مِنْ فِی الإِدَاوَۃِ۔","","Musannaf Ibn Abi Shaybah 24612","","","كتاب الأشربة"
"24613","(۲۴۶۱۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنْ زَیْدِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ ، عَنْ أُمِّ سَلَمَۃَ زَوْجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ الَّذِی یَأْکُلُ وَیَشْرَبُ فِی آنِیَۃِ الذَّہَبِ وَالْفِضَّۃِ ، فَإِنَّمَا یُجَرْجَرُ فِی بَطْنِہِ نَارُ جَہَنَّمَ۔ (مسلم ۱۶۳۴۔ احمد ۶/۳۰۶)","Sahih","Musannaf Ibn Abi Shaybah 24613","","","كتاب الأشربة"
"24614","(۲۴۶۱۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنْ زَیْدِ بْنِ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ ، عَنْ أُمِّ سَلَمَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلہ۔","Sahih","Musannaf Ibn Abi Shaybah 24614","","","كتاب الأشربة"
"24615","(۲۴۶۱۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : اسْتَسْقَی حُذَیْفَۃُ بِالْمَدَائِنِ ، فَأَتَاہُ دِہْقَانٌ بِإِنَائٍ مِنْ فِضَّۃٍ فِیہِ شَرَابٌ ، فَأَرَادَ أَنْ یَضْرِبَ بِہِ وَجْہَہُ ، فَقِیلَ لَہُ : إِنَّ الدَّہَاقِینَ یُکْرِمُونَ الأُمَرَائَ بِہَذَا ، قَالَ : إِنِّی کُنْتُ نَہَیْتُہُ ، وَاتَّخَذْتُ عَلَیْہِ الْحُجَّۃَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَانَا أَنْ نَشْرَبَ فِی الْفِضَّۃِ وَالذَّہَبِ۔ (مسلم ۱۶۳۷)","Da'if","Musannaf Ibn Abi Shaybah 24615","","","كتاب الأشربة"
"24616","(۲۴۶۱۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ مُعَاوِیَۃَ بْنِ سُوَیْد بْنِ مُقَرِّنٍ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الشُّرْبِ فِی الْفِضَّۃِ ، فَإِنَّہُ مَنْ شَرِبَ فِیہِ فِی الدُّنْیَا ، لَمْ یَشْرَبْ فِیہِ فِی الآخِرَۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 24616","","","كتاب الأشربة"
"24617","(۲۴۶۱۷) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الْعَلاَئِ ، عَنْ یَعْلَی بْنِ النُّعْمَانِ ، قَالَ : قَالَ عُمَرُ : مَنْ شَرِبَ فِی قَدَحٍ مُفَضَّضٍ ، سَقَاہُ اللَّہُ یَوْمَ الْقِیَامَۃِ جَمْرًا۔","","Musannaf Ibn Abi Shaybah 24617","","","كتاب الأشربة"
"24618","(۲۴۶۱۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ رَجُلٍ ، عَنْ أَنَسِ بْنِ مَالِکٍ ؛ أَنَّہُ أُتِیَ بِجَامٍ مِنْ فِضَّۃٍ فِیہِ خَبِیصٌ ، فَأَمَرَ بِہِ فَحُوِّلَ عَلَی رَغِیفٍ ، ثُمَّ أَکَلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24618","","","كتاب الأشربة"
"24619","(۲۴۶۱۹) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ زَاذَانُ ، وَمَیْسَرَۃُ ، وَسَعِیدُ بْنُ جُبَیْرٍ لاَ یَشْرَبُونَ فِی آنِیَۃِ الذَّہَبِ وَالْفِضَّۃِ ، وَلاَ یَدَّہِنُونَ فِی مَدَاہِنِ الذَّہَبِ وَالْفِضَّۃِ۔","","Musannaf Ibn Abi Shaybah 24619","","","كتاب الأشربة"
"24620","(۲۴۶۲۰) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ ثَابِتِ بْنِ عُبَیْدٍ، عَنْ بَشِیرِ بْنِ أَبِی مَسْعُودٍ؛ أَنَّہُ أُتِیَ بِإِنَائٍ مِنْ فِضَّۃٍ، فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 24620","","","كتاب الأشربة"
"24621","(۲۴۶۲۱) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، قَالَ : کَانَ زَاذَانُ ، وَمَیْسَرَۃُ ، وَسَعِیدُ بْنُ جُبَیْرٍ یَشْرَبُونَ مِنَ الآنِیَۃِ الْمُفَضَّضَۃِ۔","","Musannaf Ibn Abi Shaybah 24621","","","كتاب الأشربة"
"24622","(۲۴۶۲۲) حَدَّثَنَا جَرِیرٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یَشْرَبُ فِی إِنَائٍ مُضَبَّبٍ بِفِضَّۃٍ ، وَیَشْرَبُ فِی قَدَحٍ فِیہِ حَلْقَۃٌ مِنْ وَرِقٍ۔","","Musannaf Ibn Abi Shaybah 24622","","","كتاب الأشربة"
"24623","(۲۴۶۲۳) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ عِمْرَانَ أَبِی الْعَوَّامِ الْقَطَّانِ ، عَنْ قَتَادَۃَ ؛ أَنَّ عِمْرَانَ بْنَ حُصَیْنٍ ، وَأَنَسَ بْنَ مَالِکٍ کَانَا یَشْرَبَانِ فِی الإِنَائِ الْمُفَضَّضِ۔","Da'if","Musannaf Ibn Abi Shaybah 24623","","","كتاب الأشربة"
"24624","(۲۴۶۲۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، قَالَ : دَخَلْتُ عَلَی الْقَاسِمِ بْنِ مُحَمَّدٍ وَہُوَ مَحْمُومٌ ، وَعَلَی صَدْرِہِ قَدَحٌ مُفَضَّضٌ فِیہِ مَائٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 24624","","","كتاب الأشربة"
"24625","(۲۴۶۲۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، وَعَبْدُ الرَّحْمَن بْنُ مَہْدِیٍّ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إِبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، قَالَ : رَأَیْتُ طَاوُوسًا یَشْرَبُ فِی قَدَحٍ مُضَبَّبٍ بِوَرِقٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 24625","","","كتاب الأشربة"
"24626","(۲۴۶۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ زِیَادٍ الدِّمَشْقِیِّ ، عَنْ سُلَیْمَانَ بْنِ حَبِیبٍ ، وَسُلَیْمَانَ بْنِ دَاوُد ، قَالاَ : أَتَیْنَا عُمَرَ بْنَ عَبْدِ الْعَزِیزِ بِشَرَابٍ فِی قَدَحٍ مُفَضَّضٍ ، فَوَضَعَ فَاہُ بَیْنَ الضَّبتین فَشَرِبَ ، وَقَالَ : لاَ تُعِیدَاہُ عَلَیَّ۔","","Musannaf Ibn Abi Shaybah 24626","","","كتاب الأشربة"
"24627","(۲۴۶۲۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ إِسْرَائِیلَ ، عَنْ جَابِرٍ ، قَالَ : رَأَیْتُ أَبَا جَعْفَرٍ یَشْرَبُ فِی قَدَحٍ جیَشَانِیٍّ کَثِیرِ الْفِضَّۃِ ، وَسَقَانِی۔","","Musannaf Ibn Abi Shaybah 24627","","","كتاب الأشربة"
"24628","(۲۴۶۲۸) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ مُعَاوِیَۃَ بْنَ قُرَّۃَ ، قُلْتُ : آتِی الصَّیَارِفَ فَأُوتَی بِقَدَحٍ مِنْ فِضَّۃٍ، أَشْرَبُ فِیہِ ؟ قَالَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 24628","","","كتاب الأشربة"
"24629","(۲۴۶۲۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَشْرَبُ مِنْ قَدَحٍ فِیہِ حَلْقَۃُ فِضَّۃٍ ، وَلاَ ضَبَّۃُ فِضَّۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 24629","","","كتاب الأشربة"
"24630","(۲۴۶۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرٍ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ؛ أَنَّہُ أُتِیَ بِقَدَحٍ مُفَضَّضٍ ، فَکَرِہَ أَنْ یَشْرَبَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 24630","","","كتاب الأشربة"
"24631","(۲۴۶۳۱) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَرِہَا أَنْ یُضَبَّبَ الْقَدَحُ بِذَہَبٍ ، أَوْ فِضَّۃٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 24631","","","كتاب الأشربة"
"24632","(۲۴۶۳۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَشْرَبَ فِی قَدَحٍ فِیہِ فِضَّۃٌ۔","","Musannaf Ibn Abi Shaybah 24632","","","كتاب الأشربة"
"24633","(۲۴۶۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، قَالَ : أَتَیْتُ الْمُطَّلِبَ بْنَ عَبْدِ اللہِ بْنِ حَنْطَبٍ بِقَدَحٍ مُفَضَّضٍ ، فَلَمْ یَشْرَبْ فِیہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24633","","","كتاب الأشربة"
"24634","(۲۴۶۳۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ ابْنُ عُمَرَ یَکْرَہُ أَنْ یَشْرَبَ فِی قَدَحٍ فِیہِ حَلْقَۃٌ مِنْ فِضَّۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 24634","","","كتاب الأشربة"
"24635","(۲۴۶۳۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابن أَبِی رَوَّادٍ ، عَن نَافِع ، عن ابْن عُمَرَ ؛ أَنَّہُ کَانَ لاَ یَشْرَبُ فِی إِناء مُفَضَّضٍ۔","Hasan","Musannaf Ibn Abi Shaybah 24635","","","كتاب الأشربة"
"24636","(۲۴۶۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ سَالِمٍ ؛ أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24636","","","كتاب الأشربة"
"24637","(۲۴۶۳۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، عَنْ أُمِّ عَمْرٍو بِنْتِ أَبِی عَمْرٍو ، قَالَتْ : کَانَتْ عَائِشَۃُ تَنْہَانَا أَنْ نَتَحَلَّی الذَّہَبَ ، أَوْ نُضَبِّبَ الآنِیَۃَ ، أَوْ نُحَلِّقَہَا بِالْفِضَّۃِ ، فَمَا بَرِحْنَا حَتَّی رَخَّصَتْ لَنَا وَأَذِنَتْ لَنَا أَنْ نَتَحَلَّی الذَّہَبَ ، وَمَا أَذِنَتْ لَنَا ، وَلاَ رَخَّصَتْ لَنَا أَنْ نُحَلِّقَ الآنِیَۃَ ، أَوْ نُضَبِّبَہَا بِالْفِضَّۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 24637","","","كتاب الأشربة"
"24638","(۲۴۶۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ أَنْ یَشْرَبَ فِی قَدَحٍ مُفَضَّضٍ۔","","Musannaf Ibn Abi Shaybah 24638","","","كتاب الأشربة"
"24639","(۲۴۶۳۹) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ، عَنْ زَائِدَۃَ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، وَابْنِ عَبَّاسٍ، قَالاَ : کَانَ یُکْرَہُ أَنْ یُشْرَبَ مِنْ ثُلْمَۃِ الْقَدَحِ ، أَوْ مِنْ عِنْدِ أُذُنِ الْقَدَحِ۔","Hasan","Musannaf Ibn Abi Shaybah 24639","","","كتاب الأشربة"
"24640","(۲۴۶۴۰) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یُشْرَبَ مِنَ الثُّلْمَۃِ تَکُونُ فِی الإِنَائِ ، أَوْ یُشْرَبُ مِنْ قِبَلِ أُذُنِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24640","","","كتاب الأشربة"
"24641","(۲۴۶۴۱) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ إِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یَشْرَبَ مِمَّا یَلِی عُرْوَۃَ الْقَدَحِ ، أَوِ الثُّلْمَۃِ تَکُونُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 24641","","","كتاب الأشربة"
"24642","(۲۴۶۴۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ سَالِمٍ ، عَنْ عَطَائٍ ؛ أَنَّہُ کَانَ لاَ یَرَی بِالشُّرْبِ بِالنَّفَسِ الْوَاحِدِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24642","","","كتاب الأشربة"
"24643","(۲۴۶۴۳) حَدَّثَنَا حَاتِمُ بْنُ إِسْمَاعِیلَ ، عَنْ عَبْدِ اللہِ بْنِ یَزِیدَ ، قَالَ : لَمْ أَرَ أَحَدًا کَانَ أَعْجَلَ إِفْطَارًا مِنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، کَانَ لاَ یَنْتَظِرُ مُؤَذِّنًا ، وَیُؤْتَی بِقَدَحٍ مِنْ مَائٍ فَیَشْرَبُہُ بِنَفَسٍ وَاحِدٍ ، لاَ یَقْطَعُہُ حَتَّی یَفْرُغَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 24643","","","كتاب الأشربة"
"24644","(۲۴۶۴۴) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، قَالَ : نُبِّئْتُ عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، قَالَ : رَآنِی عُمَرُ بْنُ عَبْدِ الْعَزِیزِ وَأَنَا أَشْرَبُ ، فَجَعَلْتُ أَقْطَعُ شَرَابِی وَأَتَنَفَّسُ ، فَقَالَ : إِنَّمَا نُہِیَ أَنْ یُتَنَفَّسَ فِی الإِنَائِ ، فَإِذَا لَمْ تَتَنَفَّسْ فِی الإِنَائِ ، فَاشْرَبْہُ إِنْ شِئْتَ بِنَفَسٍ وَاحِدٍ۔","","Musannaf Ibn Abi Shaybah 24644","","","كتاب الأشربة"
"24645","(۲۴۶۴۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، قَالَ : رَآنِی أَبِی وَنَحْنُ نَشْرَبُ بِنَفَسٍ وَاحِدٍ فَنَہَانَا ، أَوْ نَہَانِی۔","","Musannaf Ibn Abi Shaybah 24645","","","كتاب الأشربة"
"24646","(۲۴۶۴۶) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَرِہَ الشُّرْبَ بِنَفَسٍ وَاحِدٍ ، وَقَالَ : ہُوَ شُرْبُ الشَّیْطَانِ۔","","Musannaf Ibn Abi Shaybah 24646","","","كتاب الأشربة"
"24647","(۲۴۶۴۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : نَہَی أَنْ یُتَنَفَّسَ فِی الإِنَائِ ، وَأَنْ یُنْفَخَ فِیہِ۔ (ابوداؤد ۳۷۲۱۔ ترمذی ۱۸۸۸)","Sahih","Musannaf Ibn Abi Shaybah 24647","","","كتاب الأشربة"
"24648","(۲۴۶۴۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِذَا شَرِبَ أَحَدُکُمْ فَلاَ یَتَنَفَّسُ فِی الإِنَائِ۔\n(بخاری ۵۶۳۰۔ مسلم ۶۵)","Sahih","Musannaf Ibn Abi Shaybah 24648","","","كتاب الأشربة"
"24649","(۲۴۶۴۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَانَ یَکْرَہُ أَنْ یُتَنَفَّسَ فِی الإِنَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24649","","","كتاب الأشربة"
"24650","(۲۴۶۵۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عَزْرَۃَ بْنِ ثَابِتٍ ، عَنْ ثُمَامَۃَ ، قَالَ : کَانَ أَنَسٌ إِذَا شَرِبَ تَنَفَّسَ مَرَّتَیْنِ ، أَوْ ثَلاَثًا ، وَحَدَّثَ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إِذَا شَرِبَ تَنَفَّسَ فِی الإِنَائِ ، ثَلاَثًا۔ (بخاری ۵۶۳۱۔ احمد ۳/۱۱۴)","Sahih","Musannaf Ibn Abi Shaybah 24650","","","كتاب الأشربة"
"24651","(۲۴۶۵۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِیسِیُّ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یَتَنَفَّسُ ثَلاَثًا إِذَا شَرِبَ۔","","Musannaf Ibn Abi Shaybah 24651","","","كتاب الأشربة"
"24652","(۲۴۶۵۲) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : إِذَا شَرِبْت فَتَنَفَّسْ فِی الإِنَائِ ثَلاَثًا۔","","Musannaf Ibn Abi Shaybah 24652","","","كتاب الأشربة"
"24653","(۲۴۶۵۳) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی بَکْرٍ ، قَالَ : جَلَسَ رَجُلٌ إِلَی ابْنِ عَبَّاسٍ فَقَالَ لَہُ : مِنْ أَیْنَ جِئْتَ ؟ قَالَ : شَرِبْتُ مِنْ مَائِ زَمْزَمَ ، قَالَ : فَشَرِبْتَ مِنْہَا کَمَا یَنْبَغِی ؟ قَالَ : إِذَا شَرِبْتَ مِنْہَا فَاسْتَقْبِلِ الْکَعْبَۃَ ، وَاذْکُرِ اسْمَ اللہِ ، وَتَنَفَّسْ ثَلاَثًا۔","Da'if","Musannaf Ibn Abi Shaybah 24653","","","كتاب الأشربة"
"24654","(۲۴۶۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَزْرَۃَ بْنِ ثَابِتٍ ، عَنْ ثُمَامَۃَ بْنِ عَبْدِ اللہِ ، عَنْ أَنَسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَتَنَفَّسُ فِی الإِنَائِ ثَلاَثًا۔ (مسلم ۱۲۲)","Sahih","Musannaf Ibn Abi Shaybah 24654","","","كتاب الأشربة"
"24655","(۲۴۶۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشام ، عَنْ أَبِی عِصَام ، عَنْ أَنَسٍ قَالَ : کَانَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَتَنَفَّسُ فِی الإِنَائِ ثَلاَثًا ، وَیَقُولُ : ہُوَ أَہْنَأُ ، وَأَمْرَأُ ، وَأَبْرَأُ۔(مسلم ۱۲۳۔ ترمذی ۱۸۸۴)","Sahih","Musannaf Ibn Abi Shaybah 24655","","","كتاب الأشربة"
"24656","(۲۴۶۵۶) حَدَّثَنَا أَبُو الأَحْوَصِ، عَنْ سِمَاکٍ ، قَالَ: کُنْتُ فِی مَجْلِسِ مِنْ مَجَالِس الأَنْصَارِ فَأُتِیَ بَعْضُہُمْ بِشَرَابٍ، فَلَمَّا أَرَادَ أَنْ یَشْرَبَ نَفَخَ فِیہِ، فَقَالَ بَعْضُ الْقَوْمِ: مَہْلاً، فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَنْہَی عَنْہُ۔","","Musannaf Ibn Abi Shaybah 24656","","","كتاب الأشربة"
"24657","(۲۴۶۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ أَیُّوبَ بْنِ حَبِیبٍ مَوْلَی بَنِی زُہْرَۃَ ، عَنْ أَبِی الْمُثَنَّی الْجُہَنِیِّ ، قَالَ : کُنْتُ عِنْدَ مَرْوَانَ بْنِ الْحَکَمِ فَدَخَلَ أَبُو سَعِیدٍ ، فَقَالَ لَہُ : سَمِعْتَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنِ النَّفْخِ فِی الشَّرَابِ ؟ قَالَ : نَعَم ، قَالَ : فَقَالَ رَجُلٌ : إِنِّی لاَ أُرْوَی بِنَفَسٍ وَاحِدٍ ، قَالَ : أَبِنِ الإِنَائَ عَنْ فِیکَ ، ثُمَّ تَنَفَّسْ ، قَالَ : فَإِنْ رَأَیْتُ قَذَرًا ؟ قَالَ : فَأَہْرِقْہُ۔ (ابوداؤد ۳۷۱۵۔ دارمی ۲۱۲۱)","Sahih","Musannaf Ibn Abi Shaybah 24657","","","كتاب الأشربة"
"24658","(۲۴۶۵۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ النَّفْخِ فِی الطَّعَامِ وَالشَّرَابِ ، قَالَ : وَلَمْ أَرَ أَحَدًا أَشَدَّ فِی ذَلِکَ مِنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ۔","","Musannaf Ibn Abi Shaybah 24658","","","كتاب الأشربة"
"24659","(۲۴۶۵۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی أَنْ یُتَنَفَّسَ فِی الإِنَائِ ، وَأَنْ یُنْفَخَ فِیہِ۔","Sahih","Musannaf Ibn Abi Shaybah 24659","","","كتاب الأشربة"
"24660","(۲۴۶۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ ثَوْرٍ ، عَنْ یَزِیدَ ذِی الأَرْشِ ، عَنْ مَوْلاَۃً لِثَوْبَانَ ، قَالَتْ : أَتَیْتُ ثَوْبَانَ بِشَرَابٍ فَنَفَخْتُ فِیہِ ، فَأَبَی أَنْ یَشْرَبَ۔","Da'if","Musannaf Ibn Abi Shaybah 24660","","","كتاب الأشربة"
"24661","(۲۴۶۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَاشِمِ بْنِ البَرِیدِ ، عَنِ الْقَاسِمِ بْنِ مُسْلِمٍ مَوْلَی الْحَسَنِ بْنِ عَلِیٍّ ، قَالَ : اسْتَسْقَی عَلِیٌّ ، فَأَتَیْتُہُ بِشَرَابٍ فَنَفَخْتُ فِیہِ ، فَأَبَی أَنْ یَشْرَبَہُ ، وَقَالَ : اشْرَبْہُ أَنْتَ۔","Da'if","Musannaf Ibn Abi Shaybah 24661","","","كتاب الأشربة"
"24662","(۲۴۶۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّہُ کَانَ یَکْرَہُ النَّفْخَ فِی الطَّعَامِ وَالشَّرَابِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24662","","","كتاب الأشربة"
"24663","(۲۴۶۶۳) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 24663","","","كتاب الأشربة"
"24664","(۲۴۶۶۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ إِیَاسٍ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ النَّفْخَ فِی الطَّعَامِ وَالشَّرَابِ۔","","Musannaf Ibn Abi Shaybah 24664","","","كتاب الأشربة"
"24665","(۲۴۶۶۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنْ یَحْیَی ، عَنْ عَبْدِ اللہِ بْنِ أَبِی قَتَادَۃَ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ النَّفْخِ فِی الإِنَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 24665","","","كتاب الأشربة"
"24666","(۲۴۶۶۶) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ الأَوْزَاعِیِّ ، عَنْ وَاصِلٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ لَمْ یَکُنْ یَرَی بِالنَّفْخِ فِی الطَّعَامِ وَالشَّرَابِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24666","","","كتاب الأشربة"
"24667","(۲۴۶۶۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ؛ أَنَّہُ کَانَ یَنْفُخُ فِی الطَّعَامِ وَالشَّرَابِ۔","","Musannaf Ibn Abi Shaybah 24667","","","كتاب الأشربة"
"24668","(۲۴۶۶۸) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : أُتِیَ عَبْدُ اللہِ بِشَرَابٍ ، فَقَالَ : نَاوِلْ عَلْقَمَۃَ ، نَاوِلِ الأَسْوَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 24668","","","كتاب الأشربة"
"24669","(۲۴۶۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ؛ بِنَحْوٍ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24669","","","كتاب الأشربة"
"24670","(۲۴۶۷۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ، عَنِ الأَعْمَشِ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ ، قَالَ : أُتِیَ عَبْدُ اللہِ بِشَرَابٍ، فَقَالَ : نَاوِلْ عَلْقَمَۃَ ، نَاوِلِ الأَسْوَدَ۔","Sahih","Musannaf Ibn Abi Shaybah 24670","","","كتاب الأشربة"
"24671","(۲۴۶۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلَمَۃَ بْنِ مُحْرِزٍ ، قَالَ : اسْتَسْقَی طَاوُوسٌ ، فَأُتِیَ بِشَرَابٍ ، فَعَرَضَہُ عَلَی عَبْدِ اللہِ بْنِ الْحَسَنِ ، فَقَالَ : اشْرَبْ۔","","Musannaf Ibn Abi Shaybah 24671","","","كتاب الأشربة"
"24672","(۲۴۶۷۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ غَیْلاَنَ بْنِ یَزِیدَ ، قَالَ : دُعِیَ أَبُو عُبَیْدَۃَ إِلَی وَلِیمَۃٍ ، فَأُتِیَ بِشَرَابٍ ، فَنَاوَلَ مَنْ عَلَی یَمِینِہِ۔","","Musannaf Ibn Abi Shaybah 24672","","","كتاب الأشربة"
"24673","(۲۴۶۷۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : أَخْبَرَنِی شُعْبَۃُ ، عَنْ عُمَارَۃَ بْنِ أَبِی حَفْصَۃَ ، عَنْ عِکْرِمَۃَ ، قَالَ : أُتِیَ عُمَرُ بِشَرَابٍ ، وَہُوَ بِالْمَوْقِفِ عَشِیَّۃَ عَرَفَۃَ ، فَشَرِبَ ثُمَّ نَاوَلَ سَیِّدَ أَہْلِ الْیَمَنِ وَہُوَ عَنْ یَمِینِہِ، فَقَالَ: إِنِّی صَائِمٌ، فَقَالَ : عَزَمْتُ عَلَیْکَ إِلاَّ أَفْطَرْتَ وَأَمَرْتَ أَصْحَابَکَ فَأَفْطَرُوا۔","","Musannaf Ibn Abi Shaybah 24673","","","كتاب الأشربة"
"24674","(۲۴۶۷۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، سَمِعَہُ مِنْ أَنَسٍ ، قَالَ : قدِمَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا ابْنُ عَشْرٍ ، وَتُوُفِّیَ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَأَنَا ابْنُ عِشْرِینَ ، وَکُنَّ أُمَّہَاتِی یَحْثُثْنَنِی عَلَی خِدْمَتِہِ ، فَدَخَلَ عَلَیْنَا دَارَنَا، فَحَلَبْنَا لَہُ مِنْ شَاۃٍ دَاجِنٍ لَنَا، وَشِیْبَ لَہُ مِنْ بِئْرٍ فِی الدَّارِ، وَأَبُو بَکْرٍ عَنْ شِمَالِہِ ، وَأَعْرَابِیٌّ عَنْ یَمِینِہِ، وَکَانَ عُمَرُ نَاحِیَۃً ، فَقَالَ عُمَرُ : یَا رَسُولَ اللہِ ، أَعْطِ أَبَا بَکْرٍ ، فَأَعْطَی الأَعْرَابِیَّ ، وَقَالَ : الأَیْمَنُ فَالأَیْمَنُ۔\n(مسلم ۱۲۵۔ مالک ۱۷)","Sahih","Musannaf Ibn Abi Shaybah 24674","","","كتاب الأشربة"
"24675","(۲۴۶۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُحِبُّ الْعَسَلَ ، وَیُحِبُّ الْحَلْوَاء ۔ (بخاری ۵۹۹۔ مسلم ۱۱۰۱)","Sahih","Musannaf Ibn Abi Shaybah 24675","","","كتاب الأشربة"
"24676","(۲۴۶۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ ، عَنِ الزُّہْرِیِّ ، قَالَ : کَانَ أَحَبَّ الشَّرَابِ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْحُلْوُ الْبَارِدُ۔ (ترمذی ۱۸۹۶)","","Musannaf Ibn Abi Shaybah 24676","","","كتاب الأشربة"
"24677","(۲۴۶۷۷) حَدَّثَنَا وَکِیعٌ، عَنْ شَرِیکٍ، عَنْ عَلِیِّ بْنِ سُلَیْمٍ، قَالَ: سَمِعْتُ أَنَسًا یَقُولُ: إِنِّی لأَشْرَبُ الطِّلاَئَ الْحُلْوَ الْقَارِص۔","Da'if","Musannaf Ibn Abi Shaybah 24677","","","كتاب الأشربة"
"24678","(۲۴۶۷۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ : أَیُّ الشَّرَابِ أَحَبُّ إِلَیْکَ ؟ قَالَ : الْحُلْوُ الْبَارِدُ۔","","Musannaf Ibn Abi Shaybah 24678","","","كتاب الأشربة"
"24679","(۲۴۶۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُنْقَعُ لَہُ الزَّبِیبُ فِی قِرْبَۃٍ عَشِیَّۃً ، فَیَشْرَبُہُ غُدْوَۃً ، وَیُنْقَعُ لَہُ غُدْوَۃً ، فَیَشْرَبُہُ عَشِیَّۃً۔","Sahih","Musannaf Ibn Abi Shaybah 24679","","","كتاب الأشربة"
"24680","(۲۴۶۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ أُمِّ غُرَابٍ ، عَن بُنَانَۃَ ، قَالَتْ : کُنْتُ أَنْقَعُ لِعُثمَانَ الزَّبِیبَ عِشَائً ، فَیَشْرَبُ مِنْہُ ، وَیَأْکُلُ مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24680","","","كتاب الأشربة"
"24681","(۲۴۶۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلُ ، عَنْ جَابِرٍ ، عَنْ مُحَمَّد بن عَلِی ، وَعَامِر ، وَعَطَاء ؛ قَالُوا : لاَ بَأْسَ أَن یُنْقَعُ الزَّبِیبُ غُدْوَۃً ، وَیُشرَبُ عَشِیَّۃً۔","","Musannaf Ibn Abi Shaybah 24681","","","كتاب الأشربة"
"24682","(۲۴۶۸۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مُغِیرَۃَ، عَنْ إِبْرَاہِیمَ، قَالَ: لاَ بَأْسَ بِنَقِیعِ الزَّبِیبِ، قَالَ سُفْیَانُ: مَا لَمْ یَغْلِ۔","","Musannaf Ibn Abi Shaybah 24682","","","كتاب الأشربة"
"24683","(۲۴۶۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سَلاَّمِ بْنِ مِسْکِینٍ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِنَبِیذِ الزَّبِیبِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24683","","","كتاب الأشربة"
"24684","(۲۴۶۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مَالِکٍ ، عَنِ الضَّحَّاکِ ، قَالَ مَرَّۃً : عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِنَّمَا النَّبِیذُ ؛ الَّذِی إِذَا بَلَغَ فَسَدَ ، وَأَمَّا مَا ازْدَادَ عَلَی طُولِ التَّرْکِ جَوْدَۃً ، فَلاَ خَیْرَ فِیہِ۔","Da'if","Musannaf Ibn Abi Shaybah 24684","","","كتاب الأشربة"
"24685","(۲۴۶۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ رَجُلٍ ، یُقَالَ لَہُ : عِیسَی ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ؛ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24685","","","كتاب الأشربة"
"24686","(۲۴۶۸۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الشَّعْثَائِ ، عَنْ مُعَاذٍ ، قَالَ : نَہَی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ غُبَیْرَائِ السَّکَرِ۔","","Musannaf Ibn Abi Shaybah 24686","","","كتاب الأشربة"
"24687","(۲۴۶۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ خَارِجَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن عَطَائِ بْنِ یَسَارٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ غُبَیْرَائِ السَّکَرِ۔ (مالک ۱۰)","Da'if","Musannaf Ibn Abi Shaybah 24687","","","كتاب الأشربة"
"24688","(۲۴۶۸۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن ہَمَّامِ بْنِ الْحَارِثِ ، قَالَ : أُتِیَ عُمَرُ بِنَبِیذِ زَبِیبٍ ، فَشَرِبَ مِنْہُ ، فَقَطَّبَ ، فَدَعَا بِمَائٍ فَصَبَّہُ عَلَیْہِ ، ثُمَّ شَرِبَ۔","Sahih","Musannaf Ibn Abi Shaybah 24688","","","كتاب الأشربة"
"24689","(۲۴۶۸۹) حَدَّثَنَا وَکِیعٌ، عَنْ مِسْعَرٍ، عَنِ أَبِی عَوْنٍ، قَالَ: أَتَی عُمَرُ قَوْمًا مِنْ ثَقِیفٍ، قَدْ حَضَرَ طَعَامُہُمْ، فَقَالَ: کُلُوا الثَّرِیدَ قَبْلَ اللَّحْمِ ، فَإِنَّہُ یَسُدَّ مَکَانَ الْخَلَلِ ، وَإِذَا اشْتَدَّ نَبِیذُکُمْ فَاکْسِرُوہُ بِالْمَائِ ، وَلاَ تَسْقُوہُ الأَعْرَابَ۔","","Musannaf Ibn Abi Shaybah 24689","","","كتاب الأشربة"
"24690","(۲۴۶۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُمَیَّۃَ ، قَالَتْ : سَمِعْتُ عَائِشَۃَ تَقُولُ : إِنْ خَشِیتَ مِنْ نَبِیذِکَ فَاکْسِرْہُ بِالْمَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 24690","","","كتاب الأشربة"
"24691","(۲۴۶۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ قُرَّۃَ الْعِجْلِیّ ، عَنْ عَبْدِ الْمَلِکِ بْنِ الْقَعْقَاعِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کُنَّا عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأُتِیَ بِقَدَحٍ فِیہِ شَرَابٌ ، فَقَرَّبَہُ إِلَی فِیہِ ، ثُمَّ رَدَّہُ ، فَقَالَ لَہُ بَعْضُ جُلَسَائِہِ : أَحَرَامٌ ہُوَ یَا رَسُولَ اللہِ ؟ قَالَ : فَقَالَ : رُدُّوہُ ، فَرَدَّوہُ ، ثُمَّ دَعَا بِمَائٍ فَصَبَّہُ عَلَیْہِ ، ثُمَّ شَرِبَہُ ، فَقَالَ : اُنْظُرُوا ہَذِہِ الأَشْرِبَۃَ ، فَإِذَا اغْتَلَمَتْ عَلَیْکُمْ فَاقْطَعُوا مُتُونَہَا بِالْمَائِ۔","Da'if","Musannaf Ibn Abi Shaybah 24691","","","كتاب الأشربة"
"24692","(۲۴۶۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ الْمُبَارَکِ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ سَالِمٍ الدَّوْسِیِّ ؛ أَنَّہُ سَمِعَ أَبَا ہُرَیْرَۃَ یَقُولُ : مَنْ رَابَہُ مِنْ نَبِیذِہِ فَلْیَشُنَّ عَلَیْہِ الْمَائَ ، فَیَذْہَبُ حَرَامُہُ ، وَیَبْقَی حَلاَلُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 24692","","","كتاب الأشربة"
"24693","(۲۴۶۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ أَبِی کَثِیرٍ الْحَنَفِیِّ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَنْ رَابَہُ مِنْ شَرَابِہِ شَیْئٌ ، فَلْیَکْسِرْہُ بِالْمَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 24693","","","كتاب الأشربة"
"24694","(۲۴۶۹۴) حَدَّثَنَا وَکِیعٌ، عَنْ عَبْدِ الْوَاحِدِ بْنِ أَیْمَنَ، عَنْ أَبِیہِ، عَنْ نَافِعِ بْنِ عَبْدِ الْحَارِثِ ، قَالَ: قَالَ عُمَرُ: اشْرَبُوا ہَذَا النَّبِیذَ فِی ہَذِہِ الأَسْقِیَۃِ ، فَإِنَّہُ یُقِیمُ الصُّلْبَ ، وَیَہْضِمُ مَا فِی الْبَطْنِ ، وَإِنَّہُ لَمْ یَغْلِبْکُمْ مَا وَجَدْتُمُ الْمَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 24694","","","كتاب الأشربة"
"24695","(۲۴۶۹۵) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ مُنْذِرِ بْنِ أَبِی الْمُنْذِرِ ، قَالَ : رَأَیْتُ ابْنَ عَبَّاسٍ یَکْرَعُ فِی حَوْضِ زَمْزَمَ وَہُوَ قَائِمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24695","","","كتاب الأشربة"
"24696","(۲۴۶۹۶) حَدَّثَنَا ابْنُ عُلیَّۃ ، عَنْ عُمَارَۃَ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَرِہَ الْکَرْعَ فِی النَّہَرِ۔","","Musannaf Ibn Abi Shaybah 24696","","","كتاب الأشربة"
"24697","(۲۴۶۹۷) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ فُلَیْحِ بْنِ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ الْحَارِثِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ: دَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی رَجُلٍ مِنَ الأَنْصَارِ وَہُوَ یُؤْتِی الْمَائَ فِی حَائِطٍ وَمَعَہُ صَاحِبٌ لَہُ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : ہَلْ عِنْدَکَ مَائٌ بَاتَ فِی ہَذِہِ اللَّیْلَۃِ فِی شَنٍّ ، وَإِلاَّ کَرَعْنا۔\n(بخاری ۵۶۱۳۔ ابوداؤد ۳۷۱۷)","Hasan","Musannaf Ibn Abi Shaybah 24697","","","كتاب الأشربة"
"24698","(۲۴۶۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ لَیْثٍ ، عَنْ سَعِیدِ بْنِ عَامِرٍ ، عَنِ ابن عُمَرُ ، قَالَ : مَرَرْنَا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی بِرْکَۃِ مَائٍ ، فَجَعَلْنَا نَکْرَعُ فِیہَا ، فَقَالَ : لاَ تَکْرَعُوا ، وَلَکِنِ اغْسِلُوا أَیْدِیَکُمْ ، وَاشْرَبُوا فِیہَا ، فَإِنَّہُ لَیْسَ مِنْ إِنَائٍ أَطْیَبُ مِنَ الْیَدِ۔ (ابن ماجہ ۳۴۳۳۔ ابویعلی ۵۶۷۵)","Da'if","Musannaf Ibn Abi Shaybah 24698","","","كتاب الأشربة"
"24699","(۲۴۶۹۹) حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، قَالَ : أَفَضْتُ مَعَ سَعِیدِ بْنِ جُبَیْرٍ عَشِیَّۃَ النَّحْرِ ، فَأَتَی حَوْضًا فِیہِ مَائُ زَمْزَمَ ، فَغَرَفَ بِیَدِہِ فَشَرِبَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 24699","","","كتاب الأشربة"
"24700","(۲۴۷۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّ أَبَا حُمَیْدٍ أَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِشَرَابٍ وَہُوَ بِالْبَقِیعِ ، فَقَالَ : أَلاَ خَمَّرْتَہُ ، وَلَوْ أَنْ تَعْرُضَ عَلَیْہِ عُودًا۔ (نسائی ۶۶۳۳۔ احمد ۳/۲۹۴)","Sahih","Musannaf Ibn Abi Shaybah 24700","","","كتاب الأشربة"
"24701","(۲۴۷۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ فِطْرٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : غَلِّقُوا أَبْوَابَکُمْ ، وَخَمِّرُوا آنِیَتَکُمْ ، وَأَوْکِئُوا أَسْقِیَتکُمْ۔ (احمد ۳/۳۰۱۔ مالک ۹۲۸)","Sahih","Musannaf Ibn Abi Shaybah 24701","","","كتاب الأشربة"
"24702","(۲۴۷۰۲) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُس ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی الْوَدَّاکِ جَبْرِ بْنِ نَوْفٍ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ : کُنَّا نُؤْمَرُ أَنْ نُوْکِِی الأَسْقِیَۃَ۔","Hasan","Musannaf Ibn Abi Shaybah 24702","","","كتاب الأشربة"
"24703","(۲۴۷۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَبِیبِ بْنِ جُرَیِّ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُعْجِبُہُ الإِنَائُ الْمُطْبَقُ۔","","Musannaf Ibn Abi Shaybah 24703","","","كتاب الأشربة"
"24704","(۲۴۷۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی جَعْفَرٍ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، عَنْ زَاذَانَ ، قَالَ : إِذَا بَاتَ الإِنَائُ غَیْرَ مُخَمَّرٍ تَفَلَ فِیہِ الشَّیْطَانُ ، فَذَکَرْت ذَلِکَ لإِبْرَاہِیمَ فَقَالَ : أَوْ شَرِبَ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 24704","","","كتاب الأشربة"
"24705","(۲۴۷۰۵) حَدَّثَنَا وَکِیعٌ، عَنْ سَلاَّمِ بْنِ الْقَاسِمِ، عَنْ أُمِّہِ، عَنْ أُمِّ سَعِیدٍ، قَالَتْ: أَتَیْتُ عَلِیًّا بِسَحُورٍ، فَوَضَعْتُہُ بَیْنَ یَدَیْہِ وَہُوَ یُصَلِّی ، فَلَمَّا صَلَّی ، قَالَ : ہَلاَّ خَمَّرْتِیہِ ، ہَلْ رَأَیْتِ الشَّیْطَانَ حِینَ وَلَغَ فِیہِ؟ أَہْرِقِیہِ ، وَأَبَی أَنْ یَشْرَبَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24705","","","كتاب الأشربة"
"24706","(۲۴۷۰۶) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ ہَارُونَ مَوْلَی قُرَیْشٍ ، قَالَ : رَأَیْتُ الْمُطَّلِبَ بْنَ حَنْطَبٍ یَشْرَبُ سَوِیقَ لَوْزٍ مُمَسَّکٍ۔","","Musannaf Ibn Abi Shaybah 24706","","","كتاب الأشربة"
"24707","(۲۴۷۰۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَوَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی الْمُخْتَارِ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَاقِی الْقَوْمِ آخِرُہُمْ۔ (ابوداؤد ۳۷۱۸۔ احمد ۴/۳۵۴)","Hasan","Musannaf Ibn Abi Shaybah 24707","","","كتاب الأشربة"
"24708","(۲۴۷۰۸) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ ثَابِتٍ ، عَنْ عَبْدِ اللہِ بْنِ رَبَاحٍ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَاقِی الْقَوْمِ آخِرُہُمْ۔ (مسلم ۳۱۱۔ ترمذی ۱۸۹۴)","Sahih","Musannaf Ibn Abi Shaybah 24708","","","كتاب الأشربة"
"24709","(۲۴۷۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، عَنْ بَکْرِ بْنِ عَبْدِ اللہِ المُزَنِیِّ ، عَنْ عَبْدِ اللہِ بْنِ رَبَاحٍ ، عَنْ أَبِی قَتَادَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : سَاقِی الْقَوْمِ آخِرُہُمْ۔","Hasan","Musannaf Ibn Abi Shaybah 24709","","","كتاب الأشربة"
"24710","(۲۴۷۱۰) حدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : لاَ بَأْسَ بِشُرْبِ الْمَائِ الَّذِی یُوضَعُ لِلصَّدَقَۃِ۔","","Musannaf Ibn Abi Shaybah 24710","","","كتاب الأشربة"
"24711","(۲۴۷۱۱) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ جَعْفَرٍ ، عَنْ أُمِّ بَکْرٍ ابْنَۃِ الْمِسْوَرِ ، قَالَتْ : کَانَ الْمِسْوَرُ لاَ یَشْرَبُ مِنَ الْمَائِ الَّذِی یُوضَعُ فِی الْمَسْجِدِ ، وَیَکْرَہُہُ ، وَیَرَی أَنَّہُ صَدَقَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24711","","","كتاب الأشربة"
"24712","(۲۴۷۱۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ سَعْدُ بْنُ عُبَادَۃَ : یَا رَسُولَ اللہِ ، مُرْنِی بِصَدَقَۃٍ ، قَالَ : اسْقِ الْمَائَ ، قَالَ : فَنَصَبَ سِقَائَیْنِ ، فَلَمْ یَزَالاَ مَنْصُوبَیْنِ ، رُبَّمَا سَعَیْتُ بَیْنَہُمَا وَأَنَا غُلاَمٌ۔\n(ابوداؤد ۱۶۷۶۔ احمد ۶/۷)","Hasan","Musannaf Ibn Abi Shaybah 24712","","","كتاب الأشربة"
"24713","(۲۴۷۱۳) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ الْعُکْلِیُّ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : عَقَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْحَسَنِ وَالْحُسَیْنِ۔ (نسائی ۴۵۳۹۔ احمد ۵/۳۵۵)","Hasan","Musannaf Ibn Abi Shaybah 24713","","","كتاب العقيقة"
"24714","(۲۴۷۱۴) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا مُغِیرَۃُ بْنُ مُسْلِمٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : عَقَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْحَسَنِ وَالْحُسَیْنِ۔ (ابویعلی ۱۹۲۹۔ طبرانی ۲۵۷۳)","Da'if","Musannaf Ibn Abi Shaybah 24714","","","كتاب العقيقة"
"24715","(۲۴۷۱۵) حَدَّثَنَا أَبُو خَالِدٍ، وَیَعْلَی بْنُ عُبَیْدٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ عِکْرِمَۃَ، قَالَ: عُقَّ عَنِ الْحَسَنِ وَالْحُسَیْنِ۔","","Musannaf Ibn Abi Shaybah 24715","","","كتاب العقيقة"
"24716","(۲۴۷۱۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی بَکْرٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیِّ بْنِ حُسَیْنٍ ، عَنْ عَلِیٍّ ، قَالَ : عَقَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْحَسَنِ بِشَاۃٍ ،فَقَالَ : یَا فَاطِمَۃُ ، اِحْلِقِی رَأْسَہُ وَتَصَدَّقِی بِزِنَۃِ شَعْرِہِ ، فَوَزَنُوہُ فَکَانَ وَزْنُہُ دِرْہَمًا ، أَوْ بَعْضَ دِرْہَمٍ۔ (ترمذی ۱۵۱۹۔ مالک ۲)","","Musannaf Ibn Abi Shaybah 24716","","","كتاب العقيقة"
"24717","(۲۴۷۱۷) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ شَرِیکٍ ، عَنِ ابْنِ عَقِیلٍ ، عَنْ عَلِیِّ بْنِ الْحُسَیْنِ ، عَنْ أَبِی رَافِعٍ ، قَالَ : قالَتْ فَاطِمَۃُ : یَا رَسُولَ اللہِ ، أَلاَ أَعُقَّ عَنِ ابْنِی دَمًا ، قَالَ : لاَ ، احْلِقِی رَأْسَہُ وَتَصَدَّقِی بِوَزْنِہِ عَلَی الْمَسَاکِینِ أَوَاقِی مِنْ وَرِقٍ ، أَوْ فِضَّۃٍ۔ (احمد ۶/۳۹۰۔ طبرانی ۹۱۷)","Da'if","Musannaf Ibn Abi Shaybah 24717","","","كتاب العقيقة"
"24718","(۲۴۷۱۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : لَوْ أَعْلَمُ أَنَّہُ لَمْ یُعَقَّ عَنِّی ، لَعَقَقْتُ عَنْ نَفْسِی۔","No Data Available","Musannaf Ibn Abi Shaybah 24718","","","كتاب العقيقة"
"24719","(۲۴۷۱۹) حَدَّثَنَا ابْنُ فُضَیْلٍ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ، قَالَ: کَانَ یُؤْمَرُ بِالْعَقِیقَۃِ وَلَوْ بِعُصْفُورٍ۔ (بیہقی ۷۱)","","Musannaf Ibn Abi Shaybah 24719","","","كتاب العقيقة"
"24720","(۲۴۷۲۰) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃََ ، عَنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : الْغُلاَمُ رَہِینَۃٌ بِعَقِیقَتِہِ ، یُذْبَحُ عَنْہُ۔ (ابوداؤد ۲۸۳۱۔ ترمذی ۱۵۲۲)","Hasan","Musannaf Ibn Abi Shaybah 24720","","","كتاب العقيقة"
"24721","(۲۴۷۲۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامٍ ، عَنْ حَفْصَۃَ ابْنَۃِ سِیرِینَ ، عَنْ سَلْمَانَ بْنِ عَامِرٍ ؛ أَنَّہُ سَمِعَ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : إِنَّ مَعَ الْغُلاَمِ عَقِیقَتُہُ ، فَأَرِیقُوا عَنْہُ دَمًا ، وَأَمِیطُوا عَنْہُ الأَذَی۔\n(ابن ماجہ ۳۱۶۴۔ احمد ۴/۱۷)","","Musannaf Ibn Abi Shaybah 24721","","","كتاب العقيقة"
"24722","(۲۴۷۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عْن رَجُلٍ مِنْ بَنِی ضَمْرَۃَ ، عَنْ أَبِیہِ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْعَقِیقَۃِ ؟ فَقَالَ : لاَ یُحِبّ اللَّہُ الْعُقُوقَ ، مَنْ وُلِدَ لَہُ مِنْکُمْ وَلَدٌ ، فَأَحَبَّ أَنْ یَنْسُکَ عَنْہُ فَلْیَفْعَلْ۔ (مالک ۵۰۰)","Da'if","Musannaf Ibn Abi Shaybah 24722","","","كتاب العقيقة"
"24723","(۲۴۷۲۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عُبَیْدِاللہِ بْنِ أَبِی یَزِیدَ، عَنْ أَبِیہِ، عَنْ سَبَّاعِ بْنِ ثَابِتٍ، عَنْ أُمِّ کُرْزٍ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : عَنِ الْغُلاَمِ شَاتَانِ مُکَافِئَتَانِ ، وَعَنِ الْجَارِیَۃِ شَاۃٌ ، لاَ یَضُرُّکُمْ إِنَاثًا کُنَّ أَمْ ذُکْرَانًا۔\n(ابوداؤد ۲۸۲۹۔ ترمذی ۱۵۱۶)","Shadh","Musannaf Ibn Abi Shaybah 24723","","","كتاب العقيقة"
"24724","(۲۴۷۲۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ ، عَنْ حَبِیبَۃَ بِنْتِ مَیْسَرَۃَ ، عَنْ أُمِّ کُرْزٍ ؛ سَمِعَتْ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : عَنِ الْغُلاَمِ شَاتَانِ مُکَافِأَتَانِ ، وَعَنِ الْجَارِیَۃِ شَاۃٌ۔ (احمد ۶/۴۲۲۔ دارمی ۱۹۶۶)","Da'if","Musannaf Ibn Abi Shaybah 24724","","","كتاب العقيقة"
"24725","(۲۴۷۲۵) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ أَسْلَمَ ، عْن عَطَائٍ ؛ أَنَّ أُمَّ السِّبَاعِ سَأَلَتْ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَعُقَّ عَنْ أَوْلاَدِی ؟ قَالَ : نَعَمْ ، عَنِ الْغُلاَمِ شَاتَانِ ، وَعَنِ الْجَارِیَۃِ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 24725","","","كتاب العقيقة"
"24726","(۲۴۷۲۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ یَزِید ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : عَنِ الْغُلاَمِ شَاتَانِ ، وَعَنِ الْجَارِیَۃِ شَاۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24726","","","كتاب العقيقة"
"24727","(۲۴۷۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : سُئِلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْعَقِیقَۃِ ؟ فَقَالَ : لاَ أُحِبُّ الْعُقُوقَ ، مَنْ وُلِدَ لَہُ مَوْلُودٌ ، فَأَحَبَّ أَنْ یَنْسُکَ عَنْہُ فَلْیَفْعَلْ؛ عَنِ الْغُلاَمِ شَاتَانِ ، وَعَنِ الْجَارِیَۃِ شَاۃٌ۔ (ابوداؤد ۲۸۳۵۔ احمد ۲/۱۸۵)","Hasan","Musannaf Ibn Abi Shaybah 24727","","","كتاب العقيقة"
"24728","(۲۴۷۲۸) حَدَّثَنَا شِہَابُ بْنُ مُحَمَّدٍ الْغَاضِرِیُّ ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، قَالَ : فِی الْعَقِیقَۃِ شَاتَانِ مُکَافِأَتَانِ ، وَعَنِ الْجَارِیَۃِ شَاۃٌ۔","","Musannaf Ibn Abi Shaybah 24728","","","كتاب العقيقة"
"24729","(۲۴۷۲۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عُثْمَانَ ، عَنْ یُوسُفَ بْنِ مَاہِکٍ ، عَنْ حَفْصَۃَ بِنْتِ عَبْدِ الرَّحْمَنِ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا قَالَتْ : أَمَرَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ نَعُقَّ عَنِ الْغُلاَمِ شَاتَانِ ، وَعَنِ الْجَارِیَۃِ شَاۃً۔ (ترمذی ۱۵۱۳۔ احمد ۶/۱۵۸)","Hasan","Musannaf Ibn Abi Shaybah 24729","","","كتاب العقيقة"
"24730","(۲۴۷۳۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتْ : السُّنَّۃُ عَنِ الْغُلاَمِ شَاتَانِ مُکَافِأَتَانِ ، وَعَنِ الْجَارِیَۃِ شَاۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 24730","","","كتاب العقيقة"
"24731","(۲۴۷۳۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ؛ أَنَّہُ کَانَ یَقُولُ: عَنِ الْجَارِیَۃِ وَعَنِ الْغُلاَمِ، شَاۃٌ، شَاۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 24731","","","كتاب العقيقة"
"24732","(۲۴۷۳۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَعِیدٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَعُقُّ عَنِ الْغُلاَمِ وَالْجَارِیَۃِ ، شَاۃً ، شَاۃً۔","No Data Available","Musannaf Ibn Abi Shaybah 24732","","","كتاب العقيقة"
"24733","(۲۴۷۳۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ یَعُقُّ عَنِ الْغُلاَمِ وَالْجَارِیَۃِ شَاۃً ، شَاۃً۔","","Musannaf Ibn Abi Shaybah 24733","","","كتاب العقيقة"
"24734","(۲۴۷۳۴) حَدَّثَنَا ابْنُ إِدْرِیسَ ، عَنْ یَزِیدَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : شَاۃً ، شَاۃً۔","","Musannaf Ibn Abi Shaybah 24734","","","كتاب العقيقة"
"24735","(۲۴۷۳۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : ہُمَا سَوَائٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 24735","","","كتاب العقيقة"
"24736","(۲۴۷۳۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ؛ أَنَّہُ کَانَ یَقُولُ فِی الْعَقِیقَۃِ : یُعَقُّ عَنِ الْغُلاَمِ وَالْجَارِیَۃِ ، شَاۃً ، شَاۃً۔","","Musannaf Ibn Abi Shaybah 24736","","","كتاب العقيقة"
"24737","(۲۴۷۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃََ ، عَنْ نَبِیِّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : یُذْبَحُ عَنْہُ یَوْمَ السَّابِعِ ، وَیُحْلَقُ رَأْسُہُ وَیُسَمَّی۔","Hasan","Musannaf Ibn Abi Shaybah 24737","","","كتاب العقيقة"
"24738","(۲۴۷۳۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِالْعَقِیقَۃِ یَوْمَ السَّابِعِ لِلْمَوْلُودِ ، وَوَضْعِ الأَذَی ، وَتَسْمِیَتِہِ۔","","Musannaf Ibn Abi Shaybah 24738","","","كتاب العقيقة"
"24739","(۲۴۷۳۹) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا أَنْ یُعَقَّ قَبْلَ السَّابِعِ ، أَوْ بَعْدَہُ ، وَکَانَ یَقُولُ : اجْعَلْ لَحْمَ الْعَقِیقَۃِ کَیْفَ شِئْتَ۔","","Musannaf Ibn Abi Shaybah 24739","","","كتاب العقيقة"
"24740","(۲۴۷۴۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّہُ قَالَ : فِی الْعَقِیقَۃِ شَاۃٌ مُسِنَّۃٌ ، تُذْبَحُ عَنْہُ یَوْمَ سَابِعِہِ، وَیُحْلَقُ رَأْسُہُ ، وَیُسَمَّی۔","","Musannaf Ibn Abi Shaybah 24740","","","كتاب العقيقة"
"24741","(۲۴۷۴۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَعْیَنَ ، عَنْ أَبِی جَعْفَرٍ، قَالَ : کَانَتْ فَاطِمَۃُ تَعُقُّ عَنْ وَلَدِہَا یَوْمَ السَّابِعِ ، وَتُسَمِّیہِ ، وَتَخْتِنُہُ ،وَتَحْلِقُ رَأْسَہُ ، وَتَتَصَدَّقُ بِوَزْنِہِ وَرِقًا۔","","Musannaf Ibn Abi Shaybah 24741","","","كتاب العقيقة"
"24742","(۲۴۷۴۲) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عَبْدُ الْوَارِثِ ، قَالَ : حَدَّثَنَا عَطَائُ بْنُ السَّائِبِ ، عَنْ مُحَارِبِ بْنِ دِثَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ فِی الْعَقِیقَۃِ : تُذْبَحُ عَنْہُ یَوْمَ السَّابِعِ ، وَیُحْلَقُ رَأْسُہُ ، وَیُتَصَدَّقُ بِوَزْنِ شَعْرِہِ فِضَّۃً ، وَیُلَطَّخُ رَأْسُہُ بِالدَّمِ۔","Da'if","Musannaf Ibn Abi Shaybah 24742","","","كتاب العقيقة"
"24743","(۲۴۷۴۳) حَدَّثَنَا عَبْدُ اللہِ بْنُ مُبَارَکِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ أَنَّہُمَا کَانَا یَکْرَہَانِ مِنَ الْعَقِیقَۃِ مَا یَکْرَہَانِ مِنَ الأُضْحِیَّۃِ ، قَالَ : وَہِیَ عِنْدَہُمَا بِمَنْزِلَۃِ الأُضْحِیَّۃِ ، یَأْکُلُ وَیُطْعِمُ۔","","Musannaf Ibn Abi Shaybah 24743","","","كتاب العقيقة"
"24744","(۲۴۷۴۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ، قَالَتْ: تُجْعَلُ جُدُولاً، فَیُطْبَخُ، فَیَأْکُلُ وَیُطْعِمُ۔","Sahih","Musannaf Ibn Abi Shaybah 24744","","","كتاب العقيقة"
"24745","(۲۴۷۴۵) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِالْعَقِیقَۃِ الَّتِی عَقَّتْہَا فَاطِمَۃُ عَنِ الْحَسَنِ وَالْحُسَیْنِ ، یَبْعَثُوا إِلَی الْقَابِلَۃِ مِنْہَا بِرِجْلٍ ، قَالَ : وَلاَ یُکْسَرُ مِنْہَا عَظْمٌ۔\n(ابوداؤد ۳۷۹)","","Musannaf Ibn Abi Shaybah 24745","","","كتاب العقيقة"
"24746","(۲۴۷۴۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، عَنْ عَائِشَۃَ ، قَالَتْ : تُطْبَخُ جُدُولاً ، وَلاَ یُکْسَرُ مِنْہَا عَظْمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 24746","","","كتاب العقيقة"
"24747","(۲۴۷۴۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : سَأَلْتُہُ عَنِ الْعَقِیقَۃِ ؟ فَقَالَ : لاَ تُکْسَرُ عِظَامُہَا وَرَأْسُہَا ، وَلاَ یُمَسّ الصَّبِیّ بِشَیْئٍ مِنْ دَمِہَا۔","","Musannaf Ibn Abi Shaybah 24747","","","كتاب العقيقة"
"24748","(۲۴۷۴۸) حَدَّثَنَا وَکِیعٌ، عَنِ النَّہَّاسِ بْنِ قَہْمٍ، قَالَ: سَمِعْتُ عَطَائً یَقُولُ: کَانُوا یَسْتَحِبُّونَ أَنْ لاَ یُکْسَرَ لِلْعَقِیقَۃِ عَظْمٌ۔","","Musannaf Ibn Abi Shaybah 24748","","","كتاب العقيقة"
"24749","(۲۴۷۴۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَام ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَرِہَا أَنْ یُلَطَّخَ رَأْسُ الصَّبِیِّ بِشَیْئٍ مِنْ دَمِ الْعَقِیقَۃِ ، وَقَالَ الْحَسَنُ : الدَّمُ رِجْسٌ۔","","Musannaf Ibn Abi Shaybah 24749","","","كتاب العقيقة"
"24750","(۲۴۷۵۰) حَدَّثَنَا عُثْمَانُ بْنُ مَطَرٍ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، قَالَ: إِذَا ضَحَّوا عَنِ الْغُلاَمِ فَقَدْ أَجْزَأَتْ عَنِ الْعَقِیقَۃِ۔","","Musannaf Ibn Abi Shaybah 24750","","","كتاب العقيقة"
"24751","(۲۴۷۵۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، وَابْنِ سِیرِینَ، قَالاَ: تُجْزِئُ عَنْہُ مِنَ الْعَقِیقَۃِ الأُضْحِیَّۃُ۔","","Musannaf Ibn Abi Shaybah 24751","","","كتاب العقيقة"
"24752","(۲۴۷۵۲) حَدَّثَنَا عُثْمَانُ بْنُ مَطَرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، قَالَ : لاَ تُجْزِئُ عَنْہُ حَتَّی یُعَقَّ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 24752","","","كتاب العقيقة"
"24753","(۲۴۷۵۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ قَتَادَۃَ ، قَالَ : یُسَمِّی عَلَی الْعَقِیقَۃِ کَمَا یُسَمِّی عَلَی الأُضْحِیَّۃِ : بِسْمِ اللہِ ، عَقِیقَۃُ فُلاَنٍ۔","","Musannaf Ibn Abi Shaybah 24753","","","كتاب العقيقة"
"24754","(۲۴۷۵۴) حَدَّثَنَا عُثْمَانُ بْنُ مَطَرٍ ، عَنْ سَعِیدٍ ، قَالَ : سُئِلَ قَتَادَۃُ: کَیْفَ تُنْحَرُ الْعَقِیقَۃُ ؟ قَالَ : یَسْتَقْبِلُ بِہَا الْقِبْلَۃَ ، ثُمَّ یَضَعُ الشَّفْرَۃَ عَلَی حَلْقِہَا ، ثُمَّ یَقُولُ: اللَّہُمَّ مِنْکَ وَلَکَ ، عَقِیقَۃُ فُلاَنٍ ، بِسْمِ اللہِ وَاللَّہُ أَکْبَرُ، ثُمَّ یَذْبَحُہَا۔","","Musannaf Ibn Abi Shaybah 24754","","","كتاب العقيقة"
"24755","(۲۴۷۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حُرَیْثِ بْنِ السَّائِبِ ، عَنِ الْحَسَنِ ؛ أَنَّ أَنَسَ بْنَ مَالِکٍ کَانَ یَعُقُّ عَنْ وَلَدِہِ بِالْجُزُرِ۔","Hasan","Musannaf Ibn Abi Shaybah 24755","","","كتاب العقيقة"
"24756","(۲۴۷۵۶) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ؛ أَنَّہُمَا کَانَا لاَ یَرَیَانِ عَنْ الْجَارِیَۃِ عَقِیقَۃٌ۔","","Musannaf Ibn Abi Shaybah 24756","","","كتاب العقيقة"
"24757","(۲۴۷۵۷) حَدَّثَنَا حُرَیثُ ، عَنْ جَرِیر ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی وَائِلٍ ، قَالَ : لاَ یُعَقُّ عَنِ الْجَارِیَۃِ ، وَلاَ تُکْرَمُ۔","","Musannaf Ibn Abi Shaybah 24757","","","كتاب العقيقة"
"24758","(۲۴۷۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَارُونَ بْنِ أَبِی إِبْرَاہِیمَ ، عَن عَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ؛ أَنَّ رَجُلاً سَأَلَہُ عَنِ الأَرْنَبِ ؟ فَقَالَ : لاَ بَأْسَ بِہَا ، قَالَ : إِنَّہَا تَحِیضُ ، قَالَ : إِنَّ الَّذِی یَعْلَمُ حَیْضَہَا یَعْلَمُ طُہْرَہَا ، وَإِنَّمَا ہِیَ حَامِلٌ مِنَ الْحَوَامِلِ۔","","Musannaf Ibn Abi Shaybah 24758","","","كتاب الأطعمة"
"24759","(۲۴۷۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ ہِشَامِ بْنِ زَیْدِ بْنِ أَنَسٍ ، عَنْ أَنَسٍ ، قَالَ : سَمِعْتُہُ یَقُولُ : أَنْفَجْنَا أَرْنَبًا بِمَرِّ الظَّہْرَانِ ، فَسَعَی عَلَیْہَا الْغِلْمَانُ حَتَّی لَغِبُوا ، ثُمَّ أَدْرَکْتُہَا ، فَأَتَیْتُ بِہَا أَبَا طَلْحَۃَ فَذَبَحَہَا ، ثُمَّ بَعَثَ مَعِی إِلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِوَرَکِہَا ، فَقَبِلَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 24759","","","كتاب الأطعمة"
"24760","(۲۴۷۶۰) حَدَّثَنَا وَکِیعٌ ، عَنْ طَلْحَۃَ بْنِ یَحْیَی ، عَنْ مُوسَی بْنِ طَلْحَۃَ ؛ أَنَّ رَجُلاً سَأَلَ عُمَرَ عَنِ الأَرْنَبِ ؟ فَقَالَ عُمَرُ : لَوْلاَ أَنِّی أَکْرَہُ أَنْ أَزِیدَ فِی الْحَدِیثِ ، أَوْ أَنْقُصَ مِنْہُ ، وَسَأُرْسِلُ لَکَ إِلَی رَجُلٍ ، فَأَرْسَلَ إِلَی عَمَّارٍ فَجَائَ ، فَقَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَنَزَلْنَا فِی مَوْضِعِ کَذَا وَکَذَا ، قَالَ : فَأَہْدَی إِلَیْہِ رَجُلٌ مِنَ الأَعْرَابِ أَرْنَبًا فَأَکَلْنَاہَا ، فَقَالَ الأَعْرَابِیُّ : إِنِّی رَأَیْتُ دَمًا ، فَقَالَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ بَأْسَ۔\n(احمد ۱/۳۱۔ ابو یعلی ۱۶۱۲)","","Musannaf Ibn Abi Shaybah 24760","","","كتاب الأطعمة"
"24761","(۲۴۷۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہَمَّامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ سَعْدٍ ؛ أَنَّہُ أَکَلَہَا ، قَالَ : فَقُلْت لِسَعِیدٍ : مَا تَقُولُ فِیہَا ؟ قَالَ : کُنْتُ آکُلُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 24761","","","كتاب الأطعمة"
"24762","(۲۴۷۶۲) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إِبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ عُبَیْدِ بْنِ سَعْدٍ ؛ أَنَّ بِلاَلاً رَمَی أَرْنَبًا بِعَصی ، فَکَسَرَ قَوَائِمَہَا ، فَذَبَحَہَا فَأَکَلَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 24762","","","كتاب الأطعمة"
"24763","(۲۴۷۶۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ الْحَسَن ، قَالَ : کَانَ لاَ یَرَی بِأَکْلِ الأَرْنَبِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 24763","","","كتاب الأطعمة"
"24764","(۲۴۷۶۴) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : الأَرْنَبُ حَلاَلٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 24764","","","كتاب الأطعمة"
"24765","(۲۴۷۶۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی الْوَسِیمِ ، قَالَ : سَأَلْتُ حَسَنَ بْنَ حَسَنِ بْنِ عَلِیٍّ عَنِ الأَرْنَبِ ؟ فَقَالَ : أَعَافُہَا ، وَلاَ أُحَرِّمُہَا عَلَی الْمُسْلِمِینَ۔","Hasan","Musannaf Ibn Abi Shaybah 24765","","","كتاب الأطعمة"
"24766","(۲۴۷۶۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مُحَمَّدِ بْنِ صَیفِی ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِأَرْنَبَیْنِ قد َذَبَحْتُہُمَا بِمَرْوَۃَ ، فَأَمَرَنِی بِأَکْلِہِمَا۔","Sahih","Musannaf Ibn Abi Shaybah 24766","","","كتاب الأطعمة"
"24767","(۲۴۷۶۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا دَاوُد بْنُ أَبِی ہِنْدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مُحَمَّدِ بْنِ صَفْوَانَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ مِثْلَ حَدِیثِ أَبِی الأَحْوَص۔","Sahih","Musannaf Ibn Abi Shaybah 24767","","","كتاب الأطعمة"
"24768","(۲۴۷۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ؛ أَنَّہُ کَرِہَ أَکْلَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 24768","","","كتاب الأطعمة"
"24769","(۲۴۷۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَکِینٍ ، عَنْ عِکْرِمَۃَ ؛ أَنَّہُ کَرِہَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 24769","","","كتاب الأطعمة"
"24770","(۲۴۷۷۰) حَدَّثَنَا وَکِیعٌ، عَنْ ہَمَّامٍ، عَنْ قَتَادَۃَ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، عَنِ ابْنِ عَمْرٍو، أَوِ ابْنِ عُمَرَ؛ أَنَّہُ کَرِہَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 24770","","","كتاب الأطعمة"
"24771","(۲۴۷۷۱) حَدَّثَنَا یَحْیَی بْنُ وَاضِحٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَبْدِ الْکَرِیمِ بْنِ أَبِی الْمُخَارِقِ ، عَنْ حِبَّانَ بْنِ جَزْئٍ ، عَنْ أَخِیہِ خُزَیْمَۃَ بْنِ جَزْئٍ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، جِئْتُکَ لأَسْأَلَکَ عَنْ أَحْنَاشِ الأَرْضِ ، مَا تَقُولُ فِی الأَرْنَبِ ؟ قَالَ : لاَ آکُلُہُ ، وَلاَ أُحَرِّمُہُ ، قُلْتُ : فَإِنِّی آکُلُ مِمَا لَمْ تُحَرِّمْہُ ، وَلِمَ یَا رَسُولَ اللہِ ؟ قَالَ : أُنْبِئْتُ أَنَّہَا تَدْمَی۔ (بخاری ۷۰۵۔ ابن ماجہ ۳۲۴۵)","Da'if","Musannaf Ibn Abi Shaybah 24771","","","كتاب الأطعمة"
"24772","(۲۴۷۷۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : أَخْبَرَنِی نَافِعٌ ، قَالَ : قِیلَ لابْنِ عُمَرَ : إِنَّ سَعْدًا یَأْکُلُ الضِّبَاعَ ، فَلَمْ یُنْکِرْ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 24772","","","كتاب الأطعمة"
"24773","(۲۴۷۷۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِأَکْلِہَا ، وَقَالَ : ہِیَ صَیْدٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 24773","","","كتاب الأطعمة"
"24774","(۲۴۷۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْمِنْہَالِ نَصْرِ بْنِ أَوْسٍ ، عَنْ عَمِّہِ عَبْدِ اللہِ بْنِ زَیْدٍ ، قَالَ : سَأَلْتُ أَبَا ہُرَیْرَۃَ عَنِ الضَّبُعِ ؟ قَالَ : نَعْجَۃٌ مِنَ الْغَنَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 24774","","","كتاب الأطعمة"
"24775","(۲۴۷۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْقِلٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : لضَبُعٌ أَحَبُّ إِلَیَّ مِنْ کَبْشٍ۔","Hasan","Musannaf Ibn Abi Shaybah 24775","","","كتاب الأطعمة"
"24776","(۲۴۷۷۶) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عُبَیْدِ اللہِ بْنِ إِبْرَاہِیمَ الْمَکِّیِّ ، عَنْ مَوْلًی لَہُمْ ، عَنْ جَابِرٍ ، قَالَ : الضَّبُعُ صَیْدٌ فَکُلْہَا ، وَلاَ تَصِدْہَا فِی الْحَرَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 24776","","","كتاب الأطعمة"
"24777","(۲۴۷۷۷) حَدَّثَنَا یَحْیَی بْنُ وَاضِحٍ ، عَنِ ابْنِ إِسْحَاقَ ، عَنْ عَبْدِ الْکَرِیمِ بْنِ أَبِی الْمُخَارِقِ ، عَنْ حِبَّانَ بْنِ جَزْئٍ ، عَنْ أَخِیہِ خُزَیْمَۃَ بْنِ جَزْئٍ ، قَالَ : قُلْتُ یَا رَسُولَ اللہِ ، مَا تَقُولُ فِی الضَّبُعِ ؟ قَالَ : وَمَنْ یَأْکُلُ الضَّبُعَ ؟۔","Da'if","Musannaf Ibn Abi Shaybah 24777","","","كتاب الأطعمة"
"24778","(۲۴۷۷۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : کَانَتِ الْعَرَبُ تَأْکُلُ الضَّبُعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 24778","","","كتاب الأطعمة"
"24779","(۲۴۷۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی ہَارُونَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : کَانَ أَحَدُنَا لأَنْ یُہْدَی إِلَیْہِ الضَّبُعُ الْمُلَوَّنَۃُ ، أَحَبَّ إِلَیْہِ مِنَ الدَّجَاجَۃِ السَّمِینَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 24779","","","كتاب الأطعمة"
"24780","(۲۴۷۸۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ فَرَعَۃَ ، وَلاَ عَتِیرَۃَ۔ (بخاری ۵۴۷۴۔ مسلم ۱۵۶۲)","Sahih","Musannaf Ibn Abi Shaybah 24780","","","كتاب الأطعمة"
"24781","(۲۴۷۸۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ فَرَعَۃَ ، وَلاَ عَتِیرَۃَ۔\n قَالَ الزُّہْرِیُّ : أَمَّا الْفَرَعُ ؛ فَإِنَّہُ أَوَّلُ نِتَاجٍ یُنْتِجُونَہُ مِنْ مَوَاشِیہِمْ یَذْبَحُونَہُ لآلِہَتِہِمْ ، وَالْعَتِیرَۃُ فِی رَجَبٍ۔\n(بخاری ۵۴۷۳۔ مسلم ۳۸)","Sahih","Musannaf Ibn Abi Shaybah 24781","","","كتاب الأطعمة"
"24782","(۲۴۷۸۲) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ؛ أَنَّ عَلِیًّا ، وَابْنَ مَسْعُودٍ کَانَا لاَ یَرَیَانِ الْعَتِیرَۃَ۔","","Musannaf Ibn Abi Shaybah 24782","","","كتاب الأطعمة"
"24783","(۲۴۷۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنِ الْقَاسِمِ ، قَالَ : سَأَلْتُہُ عَنِ الْعَتِیرَۃِ ؟ قَالَ : تِلْکَ الرَّجَبِیَّۃُ ذَبَائِحُ أَہْلِ الْجَاہِلِیَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24783","","","كتاب الأطعمة"
"24784","(۲۴۷۸۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنِ الْعَتِیرَۃِ ؟ فَقَالَ : جِیرَانُک أَفْعَلُ النَّاسِ لَہَا ، قُلْتُ : مَا ہِیَ ؟ قَالَ : فِی عَشْرٍ بقینَ مِنْ رَجَبٍ۔","","Musannaf Ibn Abi Shaybah 24784","","","كتاب الأطعمة"
"24785","(۲۴۷۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مُبَارَکٍ ، عَنِ الْحَسَنِ ، قَالَ : الْعَتِیرَۃُ ذَبَائِحُ أَہْلِ الْجَاہِلِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 24785","","","كتاب الأطعمة"
"24786","(۲۴۷۸۶) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، قَالَ : حَدَّثَنَا ابْنُ عَوْنٍ ، قَالَ : أَنْبَأَنِی أَبُو رَمْلَۃَ ، عَنْ مِخْنَفِ بْنِ سُلَیْمٍ ؛ ذَکَرَ وُقُوفًا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِعَرَفَۃَ ، فَقَالَ : یَا أَیُّہَا النَّاسُ ، إِنَّ عَلَی کُلِّ بَیْتٍ فِی کُلِّ عَامٍ أَضْحَی وَعَتِیرَۃٌ ، أَتَدْرُونَ مَا الْعَتِیرَۃُ ؟ قَالَ : ہِیَ الَّتِی یُسَمِّیہَا النَّاسُ الرَّجَبِیَّۃُ۔ (ابوداؤد ۲۷۸۱۔ ترمذی ۱۵۱۸)","Da'if","Musannaf Ibn Abi Shaybah 24786","","","كتاب الأطعمة"
"24787","(۲۴۷۸۷) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ یَذْبَحُ فِی کُلِّ رَجَبٍ ، قَالَ مُعَاذٌ : وَرَأَیْتُ عَتِیرَۃَ ابْنِ عَوْنٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 24787","","","كتاب الأطعمة"
"24788","(۲۴۷۸۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا دَاوُد بْنُ قَیْسٍ ، قَالَ : حَدَّثَنِی عَمْرُو بْنُ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْفَرَعِ ؟ قَالَ : الْفَرَعُ حَقٌّ ، وَلأَنْ تَتْرُکَہُ حَتَّی یَکُونَ شُغْزُبَا ابْنَ مَخَاضٍ ، أَوِ ابْنَ لَبُونٍ ، فَتَحْمِلَ عَلَیْہِ فِی سَبِیلِ اللہِ ، أَوْ تُعْطِیَہُ أَرْمَلَۃً ، خَیْرٌ مِنْ أَنْ تَذْبَحَہُ تُلْصِقُ لَحْمَہُ بِوَبَرِہِ ، وَتَکْفَء إِنَائَک ، وَتُوَلِّہِ نَاقَتَک۔ \n وَسَأَلَہُ عَنِ الْعَتِیرَۃِ ؟ فَسَکَتَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَسَأَلَ بَعْضُ الْقَوْمِ عُمَرَ عَنِ الْعَتِیرَۃِ ؟ فَقَالَ : کُنَّا نُسَمِّیہَا الرَّجَبِیَّۃَ ، وَیَذْبَحُ أَہْلُ الْبَیْتِ الشَّاۃَ فِی رَجَب فَیَأْکُلُونَہَا۔ (ابوداؤد ۲۸۳۵۔ حاکم ۲۳۶)","Hasan","Musannaf Ibn Abi Shaybah 24788","","","كتاب الأطعمة"
"24789","(۲۴۷۸۹) حَدَّثَنَا عَفَّانُ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، قَالَ : أَخْبَرَنَا عَبْدُ اللہِ بْنُ عُثْمَانَ بْنِ خُثَیْمٍ ، عَنْ یُوسُفَ بْنِ مَاہِکٍ ، عَنْ حفْصَۃَ بِنْتِ عَبْدِ الرَّحْمَنِ ، عَنْ عَائِشَۃَ ؛ أَنَّہَا قَالَتْ : أَمَرَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْفَرَعِ فِی کُلِّ خَمْسِ شِیَاہٍ شَاۃٌ۔ (ابوداؤد ۲۸۲۶۔ عبدالرزاق ۷۹۹۷)","","Musannaf Ibn Abi Shaybah 24789","","","كتاب الأطعمة"
"24790","(۲۴۷۹۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إِبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، وَابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ، قَالَ : سُئِلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْفَرَعِ ؟ فَقَالَ : فَرِّعُوا إِنْ شِئْتُمْ ، وَأَنْ تُغَذُّوہُ حَتَّی یَبْلُغَ فَتَحْمِلُوا عَلَیْہِ فِی سَبِیلِ اللہِ ، أَوْ تَصِلُوا بِہِ قَرَابَۃً ، خَیْرٌ مِنْ أَنْ تَذْبَحُوا ، یَخْتَلِطُ لَحْمُہُ بِشَعْرِہِ۔","","Musannaf Ibn Abi Shaybah 24790","","","كتاب الأطعمة"
"24791","(۲۴۷۹۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، قَالَ : حَدَّثَنَا یَعْلَی بْنُ عَطَائٍ ، عَنْ وَکِیعٍ الْعُقَیْلِیِّ ، عَنْ عَمِّہِ أَبِی رَزِینٍ ، وَہُوَ لَقِیطُ بْنُ عَامِرٍ ؛ أَنَّہُ قَالَ : یَا رَسُولَ اللہِ ، إِنَّا کُنَّا نَذْبَحُ فِی رَجَبٍ ذَبَائِحَ فَنَأْکُلُ مِنْہَا ، وَنُطْعِمُ مَنْ جَائَنَا ؟ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ بَأْسَ بِذَلِکَ ۔ قَالَ : فَقَالَ وَکِیعٌ : لاَ أَدَعُہَا أَبَدًا۔\n(احمد ۱۳۔ دارمی ۱۹۶۵)","Da'if","Musannaf Ibn Abi Shaybah 24791","","","كتاب الأطعمة"
"24792","(۲۴۷۹۲) حَدَّثَنَا أَبُو خَالِدٍ ، وَوَکِیعٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ فَاطِمَۃَ بِنْتِ الْمُنْذِرِ ، عَنْ أَسْمَائَ بِنْتِ أَبِی بَکْرٍ ، قَالَتْ : نَحَرْنَا فَرَسًا عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَکَلْنَا مِنْ لَحْمِہِ ، أَوْ أَصَبْنَا مِنْ لَحْمِہِ۔\n(بخاری ۵۵۱۰۔ مسلم ۳۴۵)","Sahih","Musannaf Ibn Abi Shaybah 24792","","","كتاب الأطعمة"
"24793","(۲۴۷۹۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : أَکَلْنَا لُحُومَ الْخَیْلِ یَوْمَ خَیْبَرَ ، وَلُحُومَ الْحُمُرِ الْوَحْشِیَّۃِ۔ (مسلم ۱۵۴۱۔ ابن ماجہ ۳۱۹۱)","Hasan","Musannaf Ibn Abi Shaybah 24793","","","كتاب الأطعمة"
"24794","(۲۴۷۹۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : أَطْعَمَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لُحُومَ الْخَیْلِ ، وَنَہَانَا عَنْ لُحُومِ الْحُمُرِ۔ (ترمذی ۱۷۹۳۔ نسائی ۴۸۴۰)","Sahih","Musannaf Ibn Abi Shaybah 24794","","","كتاب الأطعمة"
"24795","(۲۴۷۹۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْکُلُونَ لُحُومَ الْخَیْلِ فِی مَغَازِیہِمْ۔","Hasan","Musannaf Ibn Abi Shaybah 24795","","","كتاب الأطعمة"
"24796","(۲۴۷۹۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : نَحَرَ أَصْحَابُ عَبْدِ اللہِ فَرَسًا فَقَسَمُوہُ بَیْنَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 24796","","","كتاب الأطعمة"
"24797","(۲۴۷۹۷) حَدَّثَنَا سَلاَّمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانَ أَصْحَابُنَا یَأْکُلُونَ لُحُومَ الْخَیْلِ۔","","Musannaf Ibn Abi Shaybah 24797","","","كتاب الأطعمة"
"24798","(۲۴۷۹۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّ الأَسْوَدَ أَکَلَ لَحْمَ فَرَسٍ۔","","Musannaf Ibn Abi Shaybah 24798","","","كتاب الأطعمة"
"24799","(۲۴۷۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ؛ أَنَّ شُرَیْحًا أَکَلَ لَحْمَ فَرَسٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 24799","","","كتاب الأطعمة"
"24800","(۲۴۸۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سَأَلْتُ مُحَمَّدًا عَنْ لُحُومِ الْخَیْلِ ؟ فَلَمْ یَرَ بِہَا بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24800","","","كتاب الأطعمة"
"24801","(۲۴۸۰۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ عَطَاء ، قَالَ : لاَ بَأْسَ بِہَا۔","","Musannaf Ibn Abi Shaybah 24801","","","كتاب الأطعمة"
"24802","(۲۴۸۰۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : أَدْرَکْتہمْ یَقْتَسِمُونَ لُحُومَ الْخَیْلِ۔","","Musannaf Ibn Abi Shaybah 24802","","","كتاب الأطعمة"
"24803","(۲۴۸۰۳) حَدَّثَنَا وَکِیعٌ ، وَعَلِیُّ بْنُ ہَاشِمٍ، عَنِ ابْنِ أَبِی لَیْلَی، عَنِ الْمِنْہَالِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : سَأَلَہُ رَجُلٌ عَنْ أَکْلِ الْفَرَسِ ؟ وَقَالَ وَکِیعٌ : عَنْ أَکْلِ الْخَیْلِ ، فَقَرَأَ ہَذِہِ الآیَۃَ : {وَالأَنْعَامَ خَلَقَہَا لَکُمْ فِیہَا دِفْئٌ} الآیَۃَ ، قَالَ : فَکَرِہَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 24803","","","كتاب الأطعمة"
"24804","(۲۴۸۰۴) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : لاَ بَأْسَ بِلَحْمِ الْفَرَسِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24804","","","كتاب الأطعمة"
"24805","(۲۴۸۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مَوْلَی نَافِعِ بْنِ عَلْقَمَۃَ ؛ أَنَّ ابْنَ عَبَّاسٍ کَانَ یَکْرَہُ لُحُومَ الْخَیْلِ ، وَالْبِغَالِ ، وَالْحَمِیرِ ، وَکَانَ یَقُولُ : قَالَ اللَّہُ جَلَّ ثَنَاؤُہُ : {وَالأَنْعَامَ خَلَقَہَا لَکُمْ فِیہَا دِفْئٌ وَمَنَافِعُ وَمِنْہَا تَأْکُلُونَ} فَہَذِہِ لِلْأَکْلِ {وَالْخَیْلَ وَالْبِغَالَ وَالْحَمِیرَ لِتَرْکَبُوہَا} فَہَذِہِ لِلرُّکُوبِ۔","Da'if","Musannaf Ibn Abi Shaybah 24805","","","كتاب الأطعمة"
"24806","(۲۴۸۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ الْجَزَرِیِّ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : کُنَّا نَأْکُلُ لُحُومَ الْخَیْلِ ، فَأَمَّا الْبِغَالُ فَلاَ۔ (بیہقی ۳۲۷۔ ابن جریر ۸۳)","Sahih","Musannaf Ibn Abi Shaybah 24806","","","كتاب الأطعمة"
"24807","(۲۴۸۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ إِبْرَاہِیمَ ؛ أَنَّہُ کَرِہَ لَحْمَ الْبَغْلِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24807","","","كتاب الأطعمة"
"24808","(۲۴۸۰۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ سُئِلَ عَنْ لُحُومِ الْخَیْلِ ؟ فَقَالَ : {وَالْخَیْلَ وَالْبِغَالَ وَالْحَمِیرَ لِتَرْکَبُوہَا} ، کَأَنَّہُ کَرِہَ لُحُومَہَا۔","","Musannaf Ibn Abi Shaybah 24808","","","كتاب الأطعمة"
"24809","(۲۴۸۰۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ إِبْرَاہِیمَ بْنِ حُمَیْدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بَِأْکْلِ لَحْمِ الْبَغْلِ۔","","Musannaf Ibn Abi Shaybah 24809","","","كتاب الأطعمة"
"24810","(۲۴۸۱۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ إِسْحَاقَ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرِو بْنِ ضَمْرَۃَ الْفَزَارِیِّ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی سَلِیطٍ ، عَنْ أَبِیہِ أَبِی سَلِیطٍ ، وَکَانَ بَدْرِیًّا ، قَالَ : لَقَدْ أَتَانَا نَہْیُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ أَکْلِ الْحُمُرِ وَنَحْنُ بِخَیْبَرَ ، وَإِنَّ الْقُدُورَ لَتَفُورُ بِہَا ، فَکَفَأْنَاہَا عَلَی وُجُوہِہَا۔\n(طبرانی ۵۸۰۔ احمد ۳/۴۱۹)","Da'if","Musannaf Ibn Abi Shaybah 24810","","","كتاب الأطعمة"
"24811","(۲۴۸۱۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ لُحُومِ الْحُمُرِ۔","Sahih","Musannaf Ibn Abi Shaybah 24811","","","كتاب الأطعمة"
"24812","(۲۴۸۱۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ لُحُومِ الْحُمُرالأَہْلِیَّۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 24812","","","كتاب الأطعمة"
"24813","(۲۴۸۱۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عَبْدِ اللہِ ، وَالْحَسَنِ ابْنَیْ مُحَمَّدٍ ، عَنْ أَبِیہِمَا ؛ أَنَّ عَلِیًّا قَالَ لابْنِ عَبَّاسٍ : أَمَا عَلِمْت أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْمُتْعَۃِ ، وَعَنْ لُحُومِ الْحُمُرِ الأَہْلِیَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 24813","","","كتاب الأطعمة"
"24814","(۲۴۸۱۴) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْبَرَائِ ، قَالَ : أَصَابَ النَّاسَ یَوْمَ خَیْبَرَ جُوعٌ شَدِیدٌ ، فَأَصَابُوا حُمُرًا أَہْلِیَّۃً ، فَطَبَخُوا مِنْہَا ، فَأَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِالْقُدُورِ فَأُکْفِئَتْ۔ \n(بخاری ۴۲۲۲۔ مسلم ۲۹)","Sahih","Musannaf Ibn Abi Shaybah 24814","","","كتاب الأطعمة"
"24815","(۲۴۸۱۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ نَہَی عَنْ لُحُومِ الْحُمُرِ الأَہْلِیَّۃِ یَوْمَ خَیْبَرَ۔ (بخاری ۴۲۱۸۔ مسلم ۲۴)","Sahih","Musannaf Ibn Abi Shaybah 24815","","","كتاب الأطعمة"
"24816","(۲۴۸۱۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مُعَاوِیَۃَ بْنِ صَالِحٍ ، قَالَ : حدَّثَنِی الْحَسَنُ بْنُ جَابِرٍ ، عَنِ الْمِقْدَامِ بْنِ مَعْدِی کَرْبَ الْکِنْدِیِّ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَرَّمَ أَشْیَائَ ، حَتَّی ذَکَرَ الْحُمُرَ الإِنْسِیَّۃَ۔\n(ابوداؤد ۴۵۹۴۔ ترمذی ۲۶۶۴)","Hasan","Musannaf Ibn Abi Shaybah 24816","","","كتاب الأطعمة"
"24817","(۲۴۸۱۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : لَمَّا کَانَ یَوْمُ خَیْبَرَ ذَبَحَ النَّاسُ الْحُمُرَ ، فَأَغْلَوْا بِہَا الْقُدُورَ ، فَأَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَبَا طَلْحَۃَ فَنَادَی ، إِنَّ اللَّہَ وَرَسُولَہُ یَنْہَیانکُمْ عَنْ لُحُومِ الْحُمُرِ الأَہْلِیَّۃِ ، فَإِنَّہَا رِجْسٌ ، فَأُکْفِئَتِ الْقُدُورُ۔\n(مسلم ۳۴۔ احمد ۳/۱۱۱)","Sahih","Musannaf Ibn Abi Shaybah 24817","","","كتاب الأطعمة"
"24818","(۲۴۸۱۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : حَدَّثَنَا الْقَاسِمُ ، وَمَکْحُولٌ ، عَنْ أَبِی أُمَامَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی یَوْمَ خَیْبَرَ عَنْ أَکْلِ الْحِمَارِ الأَہْلِیِّ۔","Da'if","Musannaf Ibn Abi Shaybah 24818","","","كتاب الأطعمة"
"24819","(۲۴۸۱۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ بْنَ أَبِی أَوْفَی عَنْ لُحُومِ الْحُمُرِ الأَہْلِیَّۃِ ؟ فَقَالَ : أَصَابَتْنَا مَجَاعَۃٌ یَوْمَ خَیْبَرَ ، وَنَحْنُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَقَدْ أَصَبْنَا لِلْقَوْمِ حُمُرًا خَارِجَۃً مِنَ الْمَدِینَۃِ ، فَنَحَرْنَاہَا ، وَإِنَّ قُدُورَنَا لَتَغْلِی ، إِذْ نَادَی مُنَادِی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنْ أَکْفِئُوا الْقُدُورَ ، وَلاَ تَطْعَمُوا مِنْ لُحُومِ الْحُمُرِ شَیْئًا ، فَقُلْتُ : حَرَّمَہَا تَحْرِیمَ مَاذَا ؟ فَقَالَ : تَحَدَّثْنَا بَیْنَنَا ، فَقُلْنَا : حَرَّمَہَا الْبَتَّۃَ ، وَحَرَّمَہَا مِنْ أَجْلِ أَنَّہَا لَمْ تُخَمَّسْ۔ (بخاری ۴۲۲۰۔ مسلم ۱۵۳۸)","Sahih","Musannaf Ibn Abi Shaybah 24819","","","كتاب الأطعمة"
"24820","(۲۴۸۲۰) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَرَّمَ یَوْمَ خَیْبَرَ الْحِمَارَ الإِنْسِیَّ۔ (ترمذی ۱۷۹۵۔ احمد ۲/۳۶۶)","Hasan","Musannaf Ibn Abi Shaybah 24820","","","كتاب الأطعمة"
"24821","(۲۴۸۲۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، قَالَ : حدَّثَنَا أَبُو الْوَدَّاکِ ، قَالَ : حَدَّثَنَا أَبُو سَعِیدٍ الْخُدْرِیِّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؛ أَنَّہُ مَرَّ بِالْقُدُورِ وَہِیَ تَغْلِی فَقَالَ لَنَا : مَا ہَذِہِ الْحُمُرُ ، أَہْلِیَّۃٌ ، أَمْ وَحْشِیَّۃٌ ؟ فَقُلْنَا : لاَ ، بَلْ أَہْلِیَّۃٌ ، قَالَ : فَأَکْفِئوہَا ، قَالَ : فَأَکْفَأْنَاہَا ، وَإِنَّا لَجِیَاعٌ نَشْتَہِیہِ۔ (ابو یعلی ۱۱۷۸)","Hasan","Musannaf Ibn Abi Shaybah 24821","","","كتاب الأطعمة"
"24822","(۲۴۸۲۲) حَدَّثَنَا شَرِیکٌ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لُحُومُہَا وَأَلْبَانُہَا حَرَامٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 24822","","","كتاب الأطعمة"
"24823","(۲۴۸۲۳) حَدَّثَنَا یَحْیَی بْنُ وَاضِحٍ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَاصِمِ بْنِ عُمَرَ بْنِ قَتَادَۃَ الظَّفَرِیِّ ، عَنْ سلْمَی بِنْتِ نَصْرٍ ، عَنْ رَجُلٍ مِنْ بَنِی مُرَّۃَ ، قَالَ : أَتَیْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْتُ : یَا رَسُولَ اللہِ ، إِنَّ جَلَّ مَالِی الْحُمُرُ ، أَفَأُصِیبُ مِنْہَا ؟ قَالَ : أَلَیْسَ تَرْعَی الْفَلاَۃَ ، وَتَأْکُلُ الشَّجَرَ ؟ قُلْتُ : بَلَی ، قَالَ : فَأَصِبْ مِنْہَا۔ (مسند ۶۵۶)","Da'if","Musannaf Ibn Abi Shaybah 24823","","","كتاب الأطعمة"
"24824","(۲۴۸۲۴) حَدَّثَنَا شَرِیکٌ ، عَنْ مَنْصُورٍ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، عَنْ غَالِبِ بْنِ ذیخ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، أَصَابَتْنَا سَنَۃٌ ، وَسَمِینُ مَالِی فِی الْحُمُرِ ، فَقَالَ : کُلْ مِنْ سَمِینِ مَالِکَ ، فَإِنَّمَا قَذِرْتُہَا مِنْ جَوالِّ الْقَرْیَۃِ۔\n(ابوداؤد ۳۸۰۳۔ طبرانی ۶۷۰)","Hasan","Musannaf Ibn Abi Shaybah 24824","","","كتاب الأطعمة"
"24825","(۲۴۸۲۵) حَدَّثَنَا شَرِیکٌ ، عَنِ الأَعْمَشِ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : إِنَّمَا کُرِہَتْ إِبْقَائً عَلَی الظَّہْرِ ، یَعْنِی لُحُومَ الْحُمُرِ۔","","Musannaf Ibn Abi Shaybah 24825","","","كتاب الأطعمة"
"24826","(۲۴۸۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ عُبَیْدِ بْنِ الْحَسَنِ ، عَنِ ابْنِ مَعْقِلٍ ، عَنْ أُنَاسٍ مِنْ مُزَیْنَۃَ الظَّاہِرَۃِ ، قَالَ : قَالَ غَالِبُ بْنُ أَبْجَرَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قُلْتُ : لَمْ یَبْقَ مِنْ مَالِی إِلاَّ أَحَمِرَۃٌ ؟ قَالَ : أَطْعِمْ أَہْلَک مِنْ سَمِینِ مَالِکَ ، قَالَ : إِنَّمَا کَرِہْتُ لَکُمْ جَوالَّ الْقَرْیَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 24826","","","كتاب الأطعمة"
"24827","(۲۴۸۲۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَسَنَۃَ ، قَالَ : کُنْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی سَفَرٍ فَأَصَبْنَا ضِبَابًا ، فَکَانَتِ الْقُدُورُ تَغْلِی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَا ہَذَا ؟ فَقُلْنَا : ضِبَابٌ أَصَبْنَاہَا ، قَالَ : إِنَّ أُمَّۃً مِنْ بَنِی إِسْرَائِیلَ مُسِخَتْ ، وَأَنَا أَخْشَی أَنْ تَکُونَ ہَذِہِ ، قَالَ : فَأَکْفَأَہَا وَإِنَّا لَجِیَاعٌ۔ (احمد ۴/۱۹۶۔ ابویعلی ۹۳۱)","Sahih","Musannaf Ibn Abi Shaybah 24827","","","كتاب الأطعمة"
"24828","(۲۴۸۲۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ عَلَی الْمِنْبَرِ عَنِ الضَّبِّ؟ فَقَالَ: لاَ آکُلُہُ، وَلاَ أُحَرِّمُہُ۔ (مسلم ۱۵۴۲۔ احمد ۲/۱۳)","Sahih","Musannaf Ibn Abi Shaybah 24828","","","كتاب الأطعمة"
"24829","(۲۴۸۲۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا دَاوُد بْنُ أَبِی ہِنْدٍ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ ، قَالَ: جَائَ رَجُلٌ إِلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : إِنَّا بِأَرْضٍ مُضِبَّۃٍ ، فَمَا تَأْمُرُنِی ؟ فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ أُمَّۃً مِنْ بَنِی إِسْرَائِیلَ مُسِخَتْ دَوَابَّ ، وَلاَ أَدْرِی فِی أَیِّ الدَّوَابِّ ہِیَ ، فَلَمْ یَأْمُرْ ، وَلَمْ یَنْہَ۔ (مسلم ۵۰۔ ابن ماجہ ۳۲۴۰)","Sahih","Musannaf Ibn Abi Shaybah 24829","","","كتاب الأطعمة"
"24830","(۲۴۸۳۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، عَنْ ثَابِتِ بْنِ وَدِیعَۃَ، قَالَ : أُتِیَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِضَبٍّ ، فَقَالَ : أُمَّۃٌ مُسِخَتْ ، وَاللَّہُ أَعْلَمُ۔\n(احمد ۴/۲۲۰۔ طیالسی ۱۲۲۰)","Sahih","Musannaf Ibn Abi Shaybah 24830","","","كتاب الأطعمة"
"24831","(۲۴۸۳۱) حَدَّثَنَا عُبَیْدُ بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، قَالَتْ : أُہْدِیَ لِرَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ضَبٌّ ، فَلَمْ یَأْکُلْ مِنْہُ ، قَالَتْ : فَقُلْتُ : یَا رَسُولَ اللہِ ، أَلاَ أُطْعِمُہُ السُّؤَّالَ ؟ قَالَ : لاَ تُطْعِمِی السُّؤَّالَ إِلاَّ مِمَّا تَأْکُلِینَ۔ (احمد ۶/۱۰۵)","","Musannaf Ibn Abi Shaybah 24831","","","كتاب الأطعمة"
"24832","(۲۴۸۳۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، عَنْ مَیْمُونَۃَ زَوْجِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَتْ : أُہْدِیَ لَنَا ضَبٌّ فَصَنَعْتُہُ ، فَدَخَلَ عَلَیْہَا رَجُلاَنِ مِنْ قَوْمِہَا ، فَأَتْحَفَتْہُمَا بِہِ ، فَدَخَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُمَا یَأْکُلاَنِ ، فَوَضَعَ یَدَہُ ، ثُمَّ رَفَعَہَا ، فَطَرَحَا مَا فِی أَیْدِیہِمَا ، فَقَالَ لَہُمَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : کُلاَ ، فَإِنَّکُمَا أَہْلُ نَجْدٍ تَأْکُلُونَہَا ، وَإِنَّا أَہْلُ الْمَدِینَۃِ نَعَافُہَا۔\n(ابویعلی ۷۰۴۸)","Da'if","Musannaf Ibn Abi Shaybah 24832","","","كتاب الأطعمة"
"24833","(۲۴۸۳۳) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا أَبُو عَوَانَۃَ ، قَالَ : حَدَّثَنَا عَبْدُ الْمَلِکِ بْنُ عُمَیْرٍ ، عَنْ حُصَیْنٍ رَجُلٍ مِنْ بَنِی فَزَارَۃَ ، عَنْ سَمُرَۃََ بْنِ جُنْدُبٍ ، قَالَ : أَتَی نَبِیَّ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَعْرَابِیٌّ وَہُوَ یَخْطُبُ ، فَقَطَعَ عَلَیْہِ خُطْبَتَہُ ، فَقَالَ : یَا رَسُولَ اللہِ ، کَیْفَ تَقُولُ فِی الضَّبِّ ؟ قَالَ : إِنَّ أُمَّۃً مِنْ بَنِی إِسْرَائِیلَ مُسِخَتْ ، فَلاَ أَدْرِی أَیَّ الدَّوَابِّ مُسِخَتْ۔ (طبرانی ۲۲۲۴)","Hasan","Musannaf Ibn Abi Shaybah 24833","","","كتاب الأطعمة"
"24834","(۲۴۸۳۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ یَزِیدَ بْنِ الأَصَمِّ ، قَالَ : دَعَانَا عَرُوسٌ بِالْمَدِینَۃِ ، فَقَرَّبَ إِلَیْنَا ثَلاَثَۃَ عَشَرَ ضَبًّا ، فَآکِلٌ وَتَارِکٌ ، فَلَقِیتُ ابْنَ عَبَّاسٍ مِنَ الْغَدِ فَأَخْبَرْتہ ، فَأَکْثَرَ الْقَوْمُ حَوْلَہُ حَتَّی قَالَ بَعْضُہُمْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ آکُلُہُ ، وَلاَ أَنْہَی عَنْہُ ، وَلاَ أُحِلُّہُ ، وَلاَ أُحَرِّمُہُ ، فَقَالَ ابْنُ عَبَّاسٍ : فَبِئْسَ مَا قُلْتُمْ ، إِنَّمَا بُعِثَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُحِلاًّ وَمُحَرِّمًا ، بَیْنَمَا ہُوَ عِنْدَ مَیْمُونَۃَ، وَعِنْدَہُ الْفَضْلُ بْنُ عَبَّاسٍ، وَخَالِدُ بْنُ الْوَلِیدِ ، وَامْرَأَۃٌ أُخْرَی ، إِذْ قُرِّبَ إِلَیْہِ خِوَانٌ عَلَیْہِ لَحْمٌ ، فَلَمَّا أَرَادَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَأْکُلَ ، قَالَتْ لَہُ مَیْمُونَۃُ : إِنَّہُ لَحْمُ ضَبٍّ ، فَکَفَّ یَدَہُ وَقَالَ : إِنَّ ہَذَا اللَّحْمَ لَمْ آکُلْہُ قَطُّ ، وَقَالَ لَہُمْ: کُلُوا، فَأَکَلَ مِنْہُ الْفَضْلُ بْنُ عَبَّاسٍ، وَخَالِدُ بْنُ الْوَلِیدِ، وَالْمَرْأَۃُ، وَقَالَتْ مَیْمُونَۃُ: لاَ آکُلُ إِلاَّ مِنْ شَیْئٍ یَأْکُلُ مِنْہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔(مسلم ۱۵۴۵۔ احمد ۱/۲۹۴)","Sahih","Musannaf Ibn Abi Shaybah 24834","","","كتاب الأطعمة"
"24835","(۲۴۸۳۵) حَدَّثَنَا عَبْدُالرَّحِیمِ بْنُ سُلَیْمَانَ، عَنِ الزِّبْرِقَانِ، قَالَ: أُہْدِیَ لِشَقِیقِ بْنِ سَلَمَۃَ ضَبٌّ مَشْوِیٌّ، فَأَکَلْتُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 24835","","","كتاب الأطعمة"
"24836","(۲۴۸۳۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : خَرَجَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَخْرَجًا ، فَأَصَابَتْہُمْ مَجَاعَۃٌ ، فَأَتَاہُ رَجُلٌ وَمَعَہُ ضِبَابٌ ، فَأَہْدَاہَا لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَنَظَرَ إِلَیْہَا فَقَالَ : مُسِخَ سِبْطٌ مِنْ بَنِی إِسْرَائِیلَ دَوَابَّ فِی الأَرْضِ ، فَلَمْ یَأْکُلْہُ ، وَلَمْ یَنْہَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 24836","","","كتاب الأطعمة"
"24837","(۲۴۸۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ أَبِی عَوْنٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَدَ رِیحَ ضَبٍّ فَرَخَّصَ لَہُمْ فِی أَکْلِہِ۔","","Musannaf Ibn Abi Shaybah 24837","","","كتاب الأطعمة"
"24838","(۲۴۸۳۸) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ؛ أَنَّ عُمَرَ رَأَی رَجُلاً حَسَنَ الْجِسْمِ ، فَسَأَلَہُ أَوْ أَخَبَرہُ ، فَقَالَ : مَنْ أَکَلَ الضِّبَابَ ، فَقَالَ عُمَرُ : وَدِدْتُ أَنَّ فِی کُلِّ جُحْرِ ضَبٍّ ضَبَّیْنِ۔","","Musannaf Ibn Abi Shaybah 24838","","","كتاب الأطعمة"
"24839","(۲۴۸۳۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : سُئِلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الضَّبِّ ؟ فَقَالَ : لاَ آکُلُہُ ، وَلاَ أُحَرِّمُہُ۔ (عبدالرزاق ۸۶۷۳)","","Musannaf Ibn Abi Shaybah 24839","","","كتاب الأطعمة"
"24840","(۲۴۸۴۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا دَاوُدُ ، عَنْ أَبِی نَضْرَۃَ ، قَالَ : قَالَ عُمَرُ : إِنَّ اللَّہَ لَیَنْفَعُ بِالضَّبِّ ، فَإِنَّہُ لَطَعَامُ عَامَّۃِ الرُّعَاۃِ ، وَلَوْ کَانَ عِنْدِی لَطَعِمْتُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 24840","","","كتاب الأطعمة"
"24841","(۲۴۸۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زِیَادِ بْنِ عِلاَقَۃَ ، عَنْ سَعْدِ بْنِ مَعْبَدٍ ؛ أَنَّ عُمَرَ رَأَی رَجُلاً مِنْ مُحَارِبٍ سَمِینًا فِی عَامِ سَنَۃٍ ، فَقَالَ : مَا طَعَامُکَ ؟ قَالَ : الضِّبَابُ ، قَالَ : وَدِدْتُ أَنَّ فِی کُلِّ جُحْرِ ضَبٍّ ضَبَّیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 24841","","","كتاب الأطعمة"
"24842","(۲۴۸۴۲) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنْ قَتَادَۃَ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: قَالَ عُمَرُ: ضَبٌّ أَحَبَّ إِلَیَّ مِنْ دَجَاجَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 24842","","","كتاب الأطعمة"
"24843","(۲۴۸۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ تَوْبَۃَ الْعَنْبَرِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الضَّبِّ ؟ فَقَالَ : حَلاَلٌ لاَ بَأْسَ بِہِ ، وَلَکِنِّی أَعَافُہُ۔","","Musannaf Ibn Abi Shaybah 24843","","","كتاب الأطعمة"
"24844","(۲۴۸۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْمِنْہَالِ ، عَنْ عَمِّہِ ، قَالَ : سَأَلْتُ أَبَا ہُرَیْرَۃَ عَنِ الضَّبِّ ؟ فَقَالَ : لَسْت بِآکِلِہِ ، وَلاَ زَاجِر عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24844","","","كتاب الأطعمة"
"24845","(۲۴۸۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ أَبِی عَوْنٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَدَ رِیحَ ضَبٍّ ، فَقَالَ : إِنِّی ، أَوْ إِنَّا مِنْ قَوْمٍ لاَ نَأْکُلُہُ ، وَرَخَّصَ لَہُمْ فِی أَکْلِہِ۔","","Musannaf Ibn Abi Shaybah 24845","","","كتاب الأطعمة"
"24846","(۲۴۸۴۶) حَدَّثَنَا وَکِیعٌ، عَنْ عَبْدِالْجَبَّارِ بْنِ عَبَّاسٍ، عَنْ عرَیْبٍ الْہَمْدَانِیِّ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ؛ أَنَّہُ کَرِہَ الضَّبَّ۔","","Musannaf Ibn Abi Shaybah 24846","","","كتاب الأطعمة"
"24847","(۲۴۸۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، قَالَ : سَأَلْتُ ابْنَ الْحَنَفِیَّۃِ عَنِ الضَّبِّ ؟ فَقَالَ : إِنْ أَعْجَبَکَ فَکُلْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24847","","","كتاب الأطعمة"
"24848","(۲۴۸۴۸) حَدَّثَنَا عَبْدَۃُ ، عَنِ الرُّکَیْنِ ، عَنْ عِصْمَۃَ بْنِ رِبْعِیٍّ ، قَالَ : قدِمْنَا عَلَی عُمَرَ وَنَحْنُ أُنَاسٌ سِمَانٌ حَسَنَۃٌ ہَیْئَتُنَا ، قَالَ : فَقَالَ : مَا طَعَامُکُمْ ؟ قُلْنَا : الضِّبَابُ ، قَالَ : فَقَالَ عُمَرُ : وَتُجْزِیکُمْ ؟ قُلْنَا : نَعَمْ ، فَقَالَ : وَدِدْت أَنَّ مَعَ کُلِّ ضَبٍّ ، مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24848","","","كتاب الأطعمة"
"24849","(۲۴۸۴۹) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : جَائَ رَجُلٌ إِلَی ابْنِ عَبَّاسٍ فَقَالَ : آکُلُ الطِّحَالَ ؟ قَالَ : نَعَمْ ، إِنَّمَا حُرِّمَ الدَّمُ الْمَسْفُوحُ۔","","Musannaf Ibn Abi Shaybah 24849","","","كتاب الأطعمة"
"24850","(۲۴۸۵۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ زَکَرِیَّا ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی مَیْسَرَۃَ ، قَالَ : إِنِّی آکُلُ الطِّحَالَ وَمَا یُعْجِبُنِی ، وَلَکِنِّی أَکْرَہُ أَنْ أُحَرِّمَہُ۔","","Musannaf Ibn Abi Shaybah 24850","","","كتاب الأطعمة"
"24851","(۲۴۸۵۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی بِالطِّحَالِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 24851","","","كتاب الأطعمة"
"24852","(۲۴۸۵۲) حَدَّثَنَا عَبْدُالرَّحِیمِ، وَوَکِیعٌ، عَنْ فِطْرٍ، عَنْ مُنْذِرٍ، عَنْ مُحَمَّدِ بْنِ الْحَنَفِیَّۃِ؛ أَنَّہُ کَانَ إِذَا سُئِلَ عَنِ الْجِرِّی، وَالطِّحَالِ ، قَالَ وَکِیعٌ : وَأَشْیَائَ مِمَّا یُکْرَہُ ؟ تَلاَ ہَذِہِ الآیَۃَ : {قُلْ لاَ أَجِدُ فِیمَا أُوحِیَ إِلَیَّ مُحَرَّمًا}۔","","Musannaf Ibn Abi Shaybah 24852","","","كتاب الأطعمة"
"24853","(۲۴۸۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، أَوْ غَیْرِہِ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالطِّحَالِ۔","","Musannaf Ibn Abi Shaybah 24853","","","كتاب الأطعمة"
"24854","(۲۴۸۵۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ عَلِیِّ بْنِ أَبِی طَالِبٍ ، قَالَ : کَانَ لاَ یَأْکُلُ الْجِرِّیثَ وَالطِّحَالَ۔","","Musannaf Ibn Abi Shaybah 24854","","","كتاب الأطعمة"
"24855","(۲۴۸۵۵) حَدَّثَنَا وَکِیعٌ، عَنْ إِسْرَائِیلَ، عَنْ أَبِی إِسْحَاقَ، عَنِ الْحَارِثِ، عَنْ عَلِیٍّ، قَالَ: الطِّحَالُ لُقْمَۃُ الشَّیْطَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 24855","","","كتاب الأطعمة"
"24856","(۲۴۸۵۶) حَدَّثَنَا جَرِیرٌ ، عَنْ قَابُوسَ ، عَنْ أَبِیہِ ؛ أَنَّ امْرَأَۃً سَأَلَتْ عَائِشَۃَ قَالَتْ : إِنَّ لَنَا أَظْآرًا مِنَ الْمَجُوسِ ، وَإِنَّہُ یَکُونُ لَہُمُ الْعِیدُ فَیُہْدُونَ لَنَا ؟ فَقَالَتْ : أَمَّا مَا ذُبِحَ لِذَلِکَ الْیَوْمِ فَلاَ تَأْکُلُوا ، وَلَکِنْ کُلُوا مِنْ أَشْجَارِہِمْ۔","Da'if","Musannaf Ibn Abi Shaybah 24856","","","كتاب الأطعمة"
"24857","(۲۴۸۵۷) حَدَّثَنَا وَکِیعٌ، عَنِ الْحَسَنِ بْنِ حَکِیمٍ، عَنْ أُمِّہِ، عَنْ أَبِی بَرْزَۃَ؛ أَنَّہُ کَانَ لَہُ سُکَّانٌ مَجُوسٌ، فَکَانُوا یُہْدُونَ لَہُ فِی النَّیْرُوزِ وَالْمِہْرَجَانِ ، فَکَانَ یَقُولُ لأَہْلِہِ : مَا کَانَ مِنْ فَاکِہَۃٍ فَکُلُوہُ ، وَمَا کَانَ مِنْ غَیْرِ ذَلِکَ فَرُدُّوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24857","","","كتاب الأطعمة"
"24858","(۲۴۸۵۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی وَائِلٍ ، وَإِبْرَاہِیمَ ، قَالاَ : لَمَّا قَدِمَ الْمُسْلِمُونَ أَصَابُوا مِنْ أَطْعِمَۃِ الْمَجُوسِ ؛ مِنْ جُبْنِہِمْ وَمِنْ خُبْزِہِمْ ، فَأَکَلُوا وَلَمْ یَسْأَلُوا عَنْ شَیْئٍ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 24858","","","كتاب الأطعمة"
"24859","(۲۴۸۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَکْرَہُ أَنْ یَأْکُلَ مِمَّا طَبَخَ الْمَجُوسُ فِی قُدُورِہِمْ ، وَلَمْ یَکُنْ یَرَی بَأْسًا أَنْ یَأْکُلَ مِنْ طَعَامِہِمْ مِمَّا سِوَی ذَلِکَ ؛ خُبْزًا ، أَوْ سَمْنًا ، أَوْ کَامِخًا ، أَوْ شِیرَازًا ، أَوْ لَبَنًا۔","","Musannaf Ibn Abi Shaybah 24859","","","كتاب الأطعمة"
"24860","(۲۴۸۶۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِخُبْزِ الْمَجُوسِ۔","","Musannaf Ibn Abi Shaybah 24860","","","كتاب الأطعمة"
"24861","(۲۴۸۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تَأْکُلْ مِنْ طَعَامِ الْمَجُوسِ إِلاَّ الْفَاکِہَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 24861","","","كتاب الأطعمة"
"24862","(۲۴۸۶۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، عَنْ أَبِی بَرْزَۃَ ، قَالَ : کُنَّا فِی غَزَاۃٍ لَنَا فَلَقِینَا أُنَاسًا مِنَ الْمُشْرِکِینَ ، فَأَجْہَضْنَاہُمْ عَنْ مَلَّۃٍ لَہُمْ ، فَوَقَعْنَا فِیہَا فَجَعَلْنَا نَأْکُلُ مِنْہَا ، وَکُنَّا نَسْمَعُ فِی الْجَاہِلِیَّۃِ أَنَّہُ مَنْ أَکَلَ الْخُبْزَ سَمِنَ ، فَلَمَّا أَکَلْنَا تِلْکَ الْخُبْزَۃَ جَعَلَ أَحَدُنَا یَنْظُرُ فِی عِطْفَیْہِ ، ہَلْ سَمِنَ ؟۔","","Musannaf Ibn Abi Shaybah 24862","","","كتاب الأطعمة"
"24863","(۲۴۸۶۳) حَدَّثَنَا یَزِیدُ ، قَالَ : أَخْبَرَنَا ہِشَامٌ ، عَنِ الْحَسَنِ ، وَمُحَمَّدٍ ، قَالاَ : کَانَ الْمُشْرِکُونَ یَجِیئُونَ بِالسَّمْنِ فِی ظُرُوفِہِمْ ، فَیَشْتَرِیہِ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَالْمُسْلِمُونَ فَیَأْکُلُونَہُ ، وَنَحْنُ نَأْکُلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24863","","","كتاب الأطعمة"
"24864","(۲۴۸۶۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ عَنِ السَّمْنِ الْجَبَلِیِّ ؟ فَقَالَ : الْعَرَبِیُّ أَحَبَّ إِلَیَّ مِنْہُ ، وَإِنَّا لَنَأْکُلُ مِنَ الْجَبَلِیِّ۔","","Musannaf Ibn Abi Shaybah 24864","","","كتاب الأطعمة"
"24865","(۲۴۸۶۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدِ ؛ أَنَّہُ کَانَ لاَ یَرَی بِالسَّمْنِ الْجَبَلِیِّ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 24865","","","كتاب الأطعمة"
"24866","(۲۴۸۶۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنْ أَبِی عُثْمَانَ ، قَالَ : کُنَّا نَأْکُلُ السَّمْنَ ، وَلاَ نَأْکُلُ الْوَدَکَ ، وَلاَ نَسْأَلُ عَنِ الظُّرُوفِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24866","","","كتاب الأطعمة"
"24867","(۲۴۸۶۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ أَنَّ عَامِرَ بْنَ عَبْدِ اللہِ کَانَ یَکْرَہُ مِنَ السَّمْنِ مَا یَجِیئُ مِنْ ہَذَا ، یَعْنِی الْجَبَلَ ، وَلاَ یَرَی بَأْسًا بِمَا یَجِیئُ مِنْ ہَاہُنَا ، یَعْنِی الْبَادِیَۃَ۔","","Musannaf Ibn Abi Shaybah 24867","","","كتاب الأطعمة"
"24868","(۲۴۸۶۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ لاَ یَرَی بِأَکْلِ السَّمْنِ الْمَائِیِّ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 24868","","","كتاب الأطعمة"
"24869","(۲۴۸۶۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی رَزِینٍ ، قَالَ : کَانُوا یَنْقُلُونَ السَّمْنَ الْجَبَلِیَّ بِمَائِ الْجُبْنِ۔","","Musannaf Ibn Abi Shaybah 24869","","","كتاب الأطعمة"
"24870","(۲۴۸۷۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ مَکْحُولٍ ، عَنْ أَبِی إِدْرِیسَ ، عَنْ أَبِی ثَعْلَبَۃَ الْخُشَنِیِّ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، إِنَّا نَغْزُو أَرْضَ الْعَدُوِّ فَنَحْتَاجُ إِلَی آنِیَتِہِمْ ، قَالَ : اسْتَغْنُوا عنہا مَا اسْتَطَعْتُمْ ، فَإِنْ لَمْ تَجِدُوا غَیْرَہَا فَاغْسِلُوہَا ، وَکُلُوا فِیہَا وَاشْرَبُوا۔ (طبرانی ۵۶۸)","","Musannaf Ibn Abi Shaybah 24870","","","كتاب الأطعمة"
"24871","(۲۴۸۷۱) حَدَّثَنَا إِسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ بُرْدٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : کُنَّا نَغْزُو مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَرْضَ الْمُشْرِکِینَ ، فَلاَ نَمْتَنِعُ أَنْ نَأْکُلَ فِی آنِیَتِہِمْ ، وَنَشْرَبَ فِی أَسْقِیَتِہِمْ۔ (ابوداؤد ۳۸۳۴۔ احمد ۳/۳۲۷)","Hasan","Musannaf Ibn Abi Shaybah 24871","","","كتاب الأطعمة"
"24872","(۲۴۸۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عُرْوَۃَ بْنِ عَبْدِ اللہِ الْقُشَیْرِیِّ أَبِی الْمِنْہَالِ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَظْہَرُونَ عَلَی الْمُشْرِکِینَ ، فَیَأْکُلُونَ فِی أَوْعِیَتِہِمْ ، وَیَشْرَبُونَ فِی أَسْقِیَتِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 24872","","","كتاب الأطعمة"
"24873","(۲۴۸۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانُ ، عَنْ جَابِرِ ، عَنِ عَبْدِ اللہِ بْنِ نُجَیّ ؛ أَنَّ حُذَیْفَۃَ اسْتَسْقَی ، فَأتَاہُ دِہْقَانُ بِبَاطِیَّۃً فِیہَا خَمْرٌ ، فَغَسَلَہَا وَشَرِبَ فِیہَا۔","Da'if","Musannaf Ibn Abi Shaybah 24873","","","كتاب الأطعمة"
"24874","(۲۴۸۷۴) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانُوا یَکْرَہُونَ آنِیَۃَ الْکُفَّارِ ، فَإِنْ لَمْ یَجِدُوا مِنْہَا بُدًّا غَسَلُوہَا وَطَبَخُوا فِیہَا۔","Sahih","Musannaf Ibn Abi Shaybah 24874","","","كتاب الأطعمة"
"24875","(۲۴۸۷۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إِذَا احْتَجْتُمْ إِلَی قُدُورِ الْمَجُوسِ وَآنِیَتِہِمْ ، فَاغْسِلُوہَا وَاطْبُخُوا فِیہَا۔","","Musannaf Ibn Abi Shaybah 24875","","","كتاب الأطعمة"
"24876","(۲۴۸۷۶) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ الْوَلِیدِ الشَّنِّی ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنْ قُدُورِ الْمَجُوسِ ؟ فَقَالَ : اغْسِلْہَا وَاطْبُخْ فِیہَا۔","","Musannaf Ibn Abi Shaybah 24876","","","كتاب الأطعمة"
"24877","(۲۴۸۷۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَیْمُونَۃَ ؛ سُئِلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ فَأْرَۃٍ وَقَعَتْ فِی سَمْنٍ ، فَمَاتَتْ ؟ فَقَالَ : أَلْقُوہَا وَمَا حَوْلَہَا ، وَکُلُوہُ۔ (بخاری ۵۵۳۸۔ ابوداؤد ۳۸۳۷)","Sahih","Musannaf Ibn Abi Shaybah 24877","","","كتاب الأطعمة"
"24878","(۲۴۸۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سُئِلَ عَنْ فَأْرَۃٍ مَاتَتْ فِی سَمْنٍ ؟ فَقَالَ : فَأَمَرَ بِہَا أَنْ تُؤْخَذَ وَمَا حَوْلَہَا فَتُطْرَحَ۔ (ابوداؤد ۳۸۳۸)","","Musannaf Ibn Abi Shaybah 24878","","","كتاب الأطعمة"
"24879","(۲۴۸۷۹) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ مَیْسَرَۃَ ، عَنْ عَلِیٍّ ؛ فِی الْفَأْرَۃِ تَقَعُ فِی السَّمْنِ ، قَالَ : إِنْ کَانَ ذَائِبًا فَأَہْرِقْہُ ، وَإِنْ کَانَ جَامِدًا فَأَلْقِہَا وَمَا حَوْلَہَا ، وَکُلْ بَقِیَّتَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24879","","","كتاب الأطعمة"
"24880","(۲۴۸۸۰) حَدَّثَنَا ہُشَیمٌ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّ الأَشْعَرِیَّ سُئِلَ عَنْ سَمْنٍ مَاتَ فِیہِ وَزَغٌ ؟ فَقَالَ : بِیعُوہ بَیْعًا ، وَلاَ تَبِیعُوہُ مِنْ مُسْلِمٍ۔","","Musannaf Ibn Abi Shaybah 24880","","","كتاب الأطعمة"
"24881","(۲۴۸۸۱) حَدَّثَنَا ہُشَیمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ نَافِعٍ ؛ أَنَّ جُرَذًا وَقَعَ فِی قِدْرٍ لآلِ ابْنِ عُمَرَ ، فَسُئِلَ ؟ فَقَالَ : انْتَفِعُوا بِہِ ، وَادْہِنُوا بِہِ الأَدَمَ۔","","Musannaf Ibn Abi Shaybah 24881","","","كتاب الأطعمة"
"24882","(۲۴۸۸۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنْ صَفِیَّۃَ بِنْتِ أَبِی عُبَیْدٍ ؛ أَنَّ جَرًّا لآلِ ابْنِ عُمَرَ فِیہِ عِشْرُونَ فَرْقًا مِنْ سَمْنٍ ، أَوْ زِیَادَۃٌ ، وَقَعَتْ فِیہِ فَأْرَۃٌ فَمَاتَتْ ، فَأَمَرَہُمَ ابْنُ عُمَرَ أَنْ یَسْتَصْبِحُوا بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 24882","","","كتاب الأطعمة"
"24883","(۲۴۸۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حُمْرَانَ بْنِ أَعْیُنٍ ، عَنْ أَبِی حَرْبِ بْنِ أَبِی الأَسْوَدِ ، قَالَ : سُئِلَ ابْنُ مَسْعُودٍ عَنْ فَأْرَۃٍ وَقَعَتْ فِی سَمْنٍ فَمَاتَتْ ؟ فَقَالَ : إِنَّمَا حَرَّمَ اللَّہُ مِنَ الْمَیْتَۃِ لَحْمَہَا وَدَمَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 24883","","","كتاب الأطعمة"
"24884","(۲۴۸۸۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ یَحْیَی بْنِ أَیُّوبَ ، قَالَ : أَخْبَرَنِی أَبُو قُبَیْلٍ ، عَنْ تُبَیعٍ بْنِ امْرَأَۃِ کَعْبٍ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ فِی الزَّیْتِ تَقَعُ فِیہِ الْفَأْرَۃُ ، فَتَمُوتُ : إِنَّہُ لاَ یَحِلُّ أَکْلُہُ لِمُسْلِمٍ ، وَلاَ لِیَہُودِیٍّ ، وَلاَ لِنَصْرَانِیٍّ۔","Hasan","Musannaf Ibn Abi Shaybah 24884","","","كتاب الأطعمة"
"24885","(۲۴۸۸۵) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ جُمَیْلِ بْنِ عُبَیْدٍ الطَّائِیِّ ، قَالَ : حدَّثَنِی ثُمَامَۃُ بْنُ عَبْدِ اللہِ بْنِ أَنَسٍ ، عَنْ جَدِّہِ أَنَسٍ ؛ أَنَّہُ سُئِلَ عَنِ الْفَأْرَۃِ تَقَعُ فِی السَّمْنِ ، أَوِ الزَّیْتِ؟ قَالَ: إِنْ کَانَ جَامِدًا أُخِذَتْ وَمَا حَوْلَہَا فَأُلْقِیَ، وَأُکِلَ مَا بَقِیَ ، وَإِنْ کَانَ ذَائِبًا اسْتَصْبِحُوا بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 24885","","","كتاب الأطعمة"
"24886","(۲۴۸۸۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ ثَابِتِ بْنِ الْحَجَّاجِ ، قَالَ : قالَتْ عَائِشَۃُ : إِنْ کَانَ جَامِدًا فَأَلْقِہَا وَمَا یَلِیہَا ، وَکُلْ مَا بَقِیَ ، وَإِنْ کَانَ مَائِعًا فَلاَ تَأْکُلْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24886","","","كتاب الأطعمة"
"24887","(۲۴۸۸۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : إذَا وَقَعَ الْجُرَدُ فِی السَّمْنِ الذَّائِبِ فَمَاتَتْ فِیہِ لَمْ یُؤْکَلْ ، وَإِنْ کَانَ جَامِدًا أُلْقِیَ الْجُرَدُ وَمَا حَوْلَہُ ، وأَُکِلَ مَا سِوَی ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 24887","","","كتاب الأطعمة"
"24888","(۲۴۸۸۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنِی یُونُسُ ، أَنَّ الْحَسَنَ وَمُحَمَّدًا ، قَالاَ : لَہُ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 24888","","","كتاب الأطعمة"
"24889","(۲۴۸۸۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 24889","","","كتاب الأطعمة"
"24890","(۲۴۸۹۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : إِنْ کَانَ جَامِدًا فَأَلْقِہَا وَمَا یَلِیہَا وَکُلْ مَا بَقِیَ ، وَإِنْ کَانَ ذَائِبًا فَاسْتَصْبِحْ بِہِ وَلاَ تَأْکُلْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 24890","","","كتاب الأطعمة"
"24891","(۲۴۸۹۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ؛ أَنَّ فَأْرَۃً وَقَعَتْ فِی زَیْتٍ ، فَسَأَلُوا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ؟ فَقَالَ : اسْتَصْبِحُوا بِہِ وَلاَ تَأْکُلُوہُ ۔ وَکَانَ مَکْحُولٌ یَقُولُ : إذَا وَقَعَتْ فِی السَّمْنِ ، فَکَانَ جَامِدًا أُلْقِیَ وَمَا حَوْلَہُ وَأُکِلَ مَا سِوَی ذَلِکَ ، وَإِنْ کَانَ ذَائِبًا لَمْ یُؤْکَلْ مِنْہُ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 24891","","","كتاب الأطعمة"
"24892","(۲۴۸۹۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ؛ سُئِلَ عَنْ فَأْرَۃٍ وَقَعَتْ فِی سَمْنٍ جَامِدٍ ؟ فَأَمَرَ أَنْ یُلْقَی مَا حَوْلَہَا ، وَیُؤْکَلُ بَقِیَّتُہُ۔","","Musannaf Ibn Abi Shaybah 24892","","","كتاب الأطعمة"
"24893","(۲۴۸۹۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا أَبُو حَمْزَۃَ ، قَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ وَسُئِلَ عَنِ الْجُبْنِ ؟ قَالَ : ضَعِ السِّکِّینَ فِیہِ ، وَاذْکُرِ اسْمَ اللہِ ، وَکُلْ۔","Hasan","Musannaf Ibn Abi Shaybah 24893","","","كتاب الأطعمة"
"24894","(۲۴۸۹۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حَیَّانَ الأَزْدِیِّ ، قَالَ ، سَأَلْتُ ابْنَ عُمَرَ عَنِ الْجُبْنِ ؟ فَقَالَ : مَا یَأْتِینَا مِنَ الْعِرَاقِ شَیْئٌ ہُوَ أَعْجَبُ إِلَیْنَا مِنْہُ۔","","Musannaf Ibn Abi Shaybah 24894","","","كتاب الأطعمة"
"24895","(۲۴۸۹۵) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ قَرْظَۃَ ، قَالَ : قَالَ عُمَر : کُلُوا الْجُبْنَ فَإِنَّہ لَبَأٌ وَلَبَنٌ۔","Da'if","Musannaf Ibn Abi Shaybah 24895","","","كتاب الأطعمة"
"24896","(۲۴۸۹۶) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ تَمْلِکَ ، قَالَتْ : سَأَلْتُ أُمَّ سَلَمَۃَ ؟ فَقَالَتْ : ضَعِی فِیہِ سِکِّینَکِ ، وَاذْکُرِی اسْمَ اللہِ جَلَّ وَعَزَّ ، وَکُلِی۔","Da'if","Musannaf Ibn Abi Shaybah 24896","","","كتاب الأطعمة"
"24897","(۲۴۸۹۷) حَدَّثَنَا سَلاَّمٌ ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَنْ مُنْذِرٍ ، عَنِ ابْنِ الْحَنَفِیَّۃِ ، قَالُوا : کُلُوا الْجُبْنَ عَرْضًا۔","","Musannaf Ibn Abi Shaybah 24897","","","كتاب الأطعمة"
"24898","(۲۴۸۹۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ رَبِیعَۃَ ، عَنْ خَالَتِہِ ، قَالَتْ : جَائَنَا جُبْنٌ مِنَ الْعِرَاقِ ، فَأَرْسَلَتْ إِلَی عَائِشَۃَ ، فَقَالَتْ : کُلِی وَأَطْعِمِینِی۔","Da'if","Musannaf Ibn Abi Shaybah 24898","","","كتاب الأطعمة"
"24899","(۲۴۸۹۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : حدَّثَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَتَبَ عُمَرُ : اُذْکُرُوا اسْمَ اللہِ عَلَی الْجُبْنِ وَکُلُوا ، قَالَ إبْرَاہِیمُ : فَلَمَّا سَافَرْنَا إلَی ہَذِہِ الْجِبَالِ فَرَأَیْنَا مِنْ صَنِیعِ الأَعَاجِمِ مَا رَأَیْنَا کَرِہْنَاہُ ، إِلاَّ أَنْ نسْأَلَ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 24899","","","كتاب الأطعمة"
"24900","(۲۴۹۰۰) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ مَنْصُورٍ ، عَنْ عُبَیْدِ بْنِ أَبِی الْجَعْدِ ، عَنْ قَیْسِ بْنِ السَّکَنِ ، قَالَ : قَالَ عَبْدُ اللہِ : لاَ تَأْکُلُوا مِنَ الْجُبْنِ إِلاَّ مَا صَنَعَ الْمُسْلِمُونَ وَأَہْلُ الْکِتَابِ۔","Hasan","Musannaf Ibn Abi Shaybah 24900","","","كتاب الأطعمة"
"24901","(۲۴۹۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ ، عَنْ أَبِی الْعَالِیَۃِ ، عَنْ سُوَیْد ، غُلاَمٍ کَانَ لِسَلْمَانَ وَأَثْنَی عَلَیْہِ خَیْرًا ، قَالَ : لَمَّا افْتَتَحْنَا الْمَدَائِنَ خَرَجَ النَّاسُ فِی طَلَبِ الْعَدُوِّ ، قَالَ : قَالَ سَلْمَانُ : وَقَدْ أَصَبْنَا سَلَّۃً ، فَقَالَ : افْتَحُوہَا فَإِنْ کَانَ طَعَامًا أَکَلْنَاہُ ، وَإِنْ کَانَ مَالاً دَفَعْنَاہُ إِلَی ہَؤُلاَئِ ، قَالَ : فَفَتَحْنَاہَا فَإِذَا أَرْغِفَۃٌ حُوَّارَی ، وَإِذَا جُبْنَۃٌ وَسِکِّینٌ ، قَالَ : وَکَانَ أَوَّلُ مَا رَأَتِ الْعَرَبُ الْحُوَّاری ، فَجَعَلَ سَلْمَانُ یَصِفُ لَہُمْ کَیْفَ یُعْمَلُ ، ثُمَّ أَخَذَ السِّکِّینَ وَجَعَلَ یَقْطَعُ ، وَقَالَ : بِسْمِ اللہِ کُلُوا۔","Hasan","Musannaf Ibn Abi Shaybah 24901","","","كتاب الأطعمة"
"24902","(۲۴۹۰۲) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، وَابْنِ سِیرِینَ، قَالاَ: لاَ بَأْسَ بِمَا صَنَعَ أَہْلُ الْکِتَابِ مِنَ الْجُبْنِ۔","","Musannaf Ibn Abi Shaybah 24902","","","كتاب الأطعمة"
"24903","(۲۴۹۰۳) حَدَّثَنَا عَبَّادٌ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ عَنِ الْجُبْنِ ؟ فَقَالَ : مَا صَنَعَ الْمُسْلِمُونَ وَأَہْلُ الْکِتَابِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24903","","","كتاب الأطعمة"
"24904","(۲۴۹۰۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ : لاَ تَأْکُلْ مِنَ الْجُبْنِ إِلاَّ مَا صَنَعَ الْمُسْلِمُونَ ، وَالْیَہُودُ ، وَالنَّصَارَی ، فَأَمَّا الْمَجُوسُ فَلاَ تَحِلُّ لَنَا ذَبَائِحُہُمْ ، فَکَیْفَ یَحِلُّ لَنَا جُبْنُہُمْ ؟۔","No Data Available","Musannaf Ibn Abi Shaybah 24904","","","كتاب الأطعمة"
"24905","(۲۴۹۰۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أَبِی وَائِلٍ ، وَإِبْرَاہِیمَ ، قَالاَ : لَمَّا قَدِمَ الْمُسْلِمُونَ أَصَابُوا مِنْ أَطْعِمَۃِ الْمَجُوسِ ، مِنْ خُبْزِہِمْ وَجُبْنِہِمْ ، فَأَکَلُوا وَلَمْ یَسْأَلُوا عَنْ ذَلِکَ ، وَوُصِفَ الْجُبْنُ لِعُمَرَ ، فَقَالَ : اُذْکُرُوا اسْمَ اللہِ عَلَیْہِ ، وَکُلُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24905","","","كتاب الأطعمة"
"24906","(۲۴۹۰۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لَمَّا أَتَیْنَا الْجَبَلَ فَرَأَیْنَا صَنِیعَہُمْ ،کَرِہْنَاہُ۔","","Musannaf Ibn Abi Shaybah 24906","","","كتاب الأطعمة"
"24907","(۲۴۹۰۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ أُمِّ مُوسَی ، عَنْ عَلِیٍّ ، قَالَ : إِذَا لَمْ تَدْرُوا مَنْ صَنَعَہُ ، فَاذْکُرُوا اسْمَ اللہِ عَلَیْہِ ، وَکُلُوہُ۔","Da'if","Musannaf Ibn Abi Shaybah 24907","","","كتاب الأطعمة"
"24908","(۲۴۹۰۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ شَقِیقٍ ، عَنْ عَمْرِو بْنِ شُرَحْبِیلَ ، قَالَ : ذَکَرْنَا الْجُبْنَ عِنْدَ عُمَرَ، فَقُلْنَا لَہُ : إِنَّہُ یُصْنَعُ فِیہِ أَنَافِح الْمَیْتَۃِ ، فَقَالَ : سَمُّوا عَلَیْہِ وَکُلُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24908","","","كتاب الأطعمة"
"24909","(۲۴۹۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَحْشٍ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، عَنِ الْحَسَنِ بْنِ عَلِیٍّ ؛ أَنَّہُ سُئِلَ عَنِ الْجُبْنِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ ، ضَعِ السِّکِّینَ ، وَاذْکُرِ اسْمَ اللہِ عَلَیْہِ وَکُلْ۔","Da'if","Musannaf Ibn Abi Shaybah 24909","","","كتاب الأطعمة"
"24910","(۲۴۹۱۰) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ عَمْرِو بْنِ عُثْمَانَ ، عَنْ مُوسَی بْنِ طَلْحَۃَ ، قَالَ : سَمِعْتُہُ یَذْکُرُ : أَنَّ طَلْحَۃَ کَانَ یَضَعُ السِّکِّینَ ، وَیَذْکُرُ اسْمَ اللہِ ، وَیَقْطَعُ وَیَأْکُلُ۔","Sahih","Musannaf Ibn Abi Shaybah 24910","","","كتاب الأطعمة"
"24911","(۲۴۹۱۱) حَدَّثَنَا حَفْصٌ ، عَنِ الزِّبْرِقَانِ ، عَنْ أَبِی رَزِینٍ ، قَالَ : لاَ بَأْسَ بِالْجُبْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24911","","","كتاب الأطعمة"
"24912","(۲۴۹۱۲) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ عُمَارَۃَ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ ، قَالَ : کَانُوا یَتَزَوَّدُونَ الْجُبْنَ فِی أَسْفَارِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 24912","","","كتاب الأطعمة"
"24913","(۲۴۹۱۳) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنْ عَمْرِو بْنِ مَنْصُورٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : أُتِیَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی غَزْوَۃِ تَبُوکَ بِجُبْنَۃٍ ، فَقِیلَ : إِنَّ ہَذَا طَعَامٌ یَصْنَعُہُ الْمَجُوسُ ، فَقَالَ : اُذْکُرُوا اسْمَ اللہِ عَلَیْہِ ، وَکُلُوہُ۔\n(ابوداؤد ۳۸۱۵)","","Musannaf Ibn Abi Shaybah 24913","","","كتاب الأطعمة"
"24914","(۲۴۹۱۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ سَالِمٍ ؛ أَنَّہُ کَانَ یَأْکُلُ الْجُبْنَ الْکُوفِیَّ۔","","Musannaf Ibn Abi Shaybah 24914","","","كتاب الأطعمة"
"24915","(۲۴۹۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عُثْمَانَ الشَّحَّامِ ، قَالَ : حدَّثَنَا النَّوْشَجَانُ أَبُو الْمُغِیرَۃِ ، قَالَ : سَأَلْتُ ابْنَ عَبَّاسٍ عَنِ الْجُبْنِ ؟ فَقَالَ : مَا یَأْتِینَا مِنَ الْعِرَاقِ فَاکِہَۃ أَعْجَبُ إِلَیْنَا مِنَ الْجُبْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 24915","","","كتاب الأطعمة"
"24916","(۲۴۹۱۶) حَدَّثَنَا عَبِیدَۃُ بْنُ حُمَیْدٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ عُبَیْدَۃَ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عُمَرَ عَنِ الْجُبْنِ ؟ فَقَالَ لَہُ ابْنُ عُمَرَ : وَمَا الْجُبْنُ ؟ قَال : مِن اللَّبَن ، فَقَالَ لَہُ ابْنُ عُمَرَ : کُلِ الْجُبْنَ وَاشْرَبْہُ ، فَقَالَ : إِنَّ فِیہِ مَیْتَۃً ؟ فَقَالَ لَہُ ابْنُ عُمَرَ : فَلاَ تَأْکُلِ الْمَیْتَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 24916","","","كتاب الأطعمة"
"24917","(۲۴۹۱۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ عَلِیٍّ الأَزْدِیِّ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : إِنَّا نُسَافِرُ فَنَمُرُّ بِالرُّعْیَانِ ، وَالصَّبِیِّ ، وَالْمَرْأَۃِ ، فَیُطْعِمُونَا لَحْمًا مَا نَدْرِی مَا جِنْسہ ؟ فَقَالَ : مَا أَطْعَمَکَ الْمُسْلِمُونَ فَکُلْ۔","Hasan","Musannaf Ibn Abi Shaybah 24917","","","كتاب الأطعمة"
"24918","(۲۴۹۱۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ سَعِیدِ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : إِذَا دَخَلْتَ عَلَی أَخِیکَ الْمُسْلِمِ فَأَطْعَمَک طَعَامًا فَکُلْ وَلاَ تَسْأَلْ ، فَإِنْ سَقَاکَ شَرَابًا فَاشْرَبْ وَلاَ تَسْأَلْ ، فَإِنْ رَابَکَ مِنْہُ شَیْئٌ فَشُجَّہُ بِالْمَائِ۔","Hasan","Musannaf Ibn Abi Shaybah 24918","","","كتاب الأطعمة"
"24919","(۲۴۹۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُمَرَ الأَنْصَارِیِّ ، قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِکٍ یَقُولُ : إِذَا دَخَلْتَ عَلَی رَجُلٍ لاَ تَتَّہِمُہُ فِی بَطْنِہِ ، فَکُلْ مِنْ طَعَامِہِ ، وَاشْرَبْ مِنْ شَرَابِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 24919","","","كتاب الأطعمة"
"24920","(۲۴۹۲۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إِبْرَاہِیمَ بْنِ إِسْمَاعِیلَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : مَا وَجَدْتَ فِی بَیْتِ الْمُسْلِمِ ، فَکُلْ۔","Da'if","Musannaf Ibn Abi Shaybah 24920","","","كتاب الأطعمة"
"24921","(۲۴۹۲۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : دَخَلْنَا عَلَی رَاعٍ دَعَانَا لِطَعَامٍ ، وَأَتَانَا بِنَبِیذٍ فَکَرِہْتُہُ ، فَأَخَذَہُ عَلِیٌّ ، قَالَ أَبُو بَکْرٍ : یَنْبَغِی أَنْ یَکُونَ ابْنُ الْحُسَیْنِ بْنُ عَلِیٍّ فَشَرِبَہُ ، وَقَالَ : إِذَا دَخَلْتَ عَلَی أَخِیکَ الْمُسْلِمِ فَکُلْ مِنْ طَعَامِہِ ، وَاشْرَبْ مِنْ شَرَابِہِ۔","","Musannaf Ibn Abi Shaybah 24921","","","كتاب الأطعمة"
"24922","(۲۴۹۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ عُمَیْرٍ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : إِذَا دَخَلْتَ بَیْتَ مُسْلِمٍ فَکُلْ مِنْ طَعَامِہِ ، وَاشْرَبْ مِنْ شَرَابِہِ۔","","Musannaf Ibn Abi Shaybah 24922","","","كتاب الأطعمة"
"24923","(۲۴۹۲۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : قالُوا : یَا رَسُولَ اللہِ ، إِنَّ الأَعْرَابَ یَأْتُونَنَا بِلَحْمٍ لاَ نَدْرِی مَا ہُوَ ، ذُکِرَ اسْمُ اللہِ عَلَیْہِ ، أَمْ لاَ ؟ فَقَالَ : سَمُّوا عَلَیْہِ ، وَکُلُوہُ۔ (بخاری ۲۰۵۷۔ دارمی ۱۹۷۶)","Sahih","Musannaf Ibn Abi Shaybah 24923","","","كتاب الأطعمة"
"24924","(۲۴۹۲۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، سَمِعَ أَبَا بَکْرِ بْنَ عُبَیْدِ اللہِ بن عَبْدِ اللہِ ، یُخْبِرُ عَنْ جَدِّہِ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : إِنَّ الشَّیْطَانَ یَأْکُلُ بِشِمَالِہِ وَیَشْرَبُ بِشِمَالِہِ ، فَإِذَا أَکَلَ أَحَدُکُمْ فَلْیَأْکُلْ بِیَمِینِہِ ، وَلِیَشْرَبْ بِیَمِینِہِ۔ (مسلم ۱۰۵۔ ابوداؤد ۳۷۷۰)","Sahih","Musannaf Ibn Abi Shaybah 24924","","","كتاب الأطعمة"
"24925","(۲۴۹۲۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا ہِشَامُ بْنُ حَسَّانَ ، عَنْ عَبْدِ اللہِ بْنِ دِہْقَانَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا أَکَلَ أَحَدُکُمْ فَلْیَأْکُلْ بِیَمِینِہِ ، وَلْیَشْرَبْ بِیَمِینِہِ ، فَإِنَّ الشَّیْطَانَ یَأْکُلُ بِشِمَالِہِ ، وَیَشْرَبُ بِشِمَالِہِ۔ (احمد ۳/۲۰۲۔ ابویعلی ۴۲۵۶)","Da'if","Musannaf Ibn Abi Shaybah 24925","","","كتاب الأطعمة"
"24926","(۲۴۹۲۶) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ، عَنْ عَبْدِالْمَلِکِ، عَنْ عُبَیْدِ بْنِ سَلْمَان، عَنِ الضَّحَّاکِ بْنِ مُزَاحِمٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ : لاَ تَأْکُلُوا بِشَمَائِلِکُمْ ، وَلا تَشرَبُوا بِشَمَائِلِکُمْ ، فَإِنَّ آدَمَ أَکَلَ بِشِمَالِہِ وَنَسِیَ ، فَأَوْرَثَہُ ذَلِکَ النِّسْیَانَ۔","Hasan","Musannaf Ibn Abi Shaybah 24926","","","كتاب الأطعمة"
"24927","(۲۴۹۲۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الْوَلِیدِ بْنِ کَثِیرٍ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، سَمِعَہُ مِنْ عُمَرَ بْنِ أَبِی سَلَمَۃَ ، قَالَ : کُنْتُ غُلاَمًا فِی حِجْرِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَکَانَتْ یَدِی تَطِیشُ فِی الصَّحْفَۃِ ، فَقَالَ لِی : یَا غُلاَمُ ، سَمِّ اللَّہَ ، وَکُلْ بِیَمِینِکَ ، وَکُلْ مِمَّا یَلِیکَ۔ (بخاری ۵۳۷۶۔ مسلم ۱۰۸)","Sahih","Musannaf Ibn Abi Shaybah 24927","","","كتاب الأطعمة"
"24928","(۲۴۹۲۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ ہِشَامِ بن عُروَۃَ ، عْن أَبِیہِ ، عَنْ أَبِی وَجْزَۃَ السَّعْدِیِّ ، عَن رَجُلٍ مِنْ مُزَیْنَۃَ ، عَن عُمَرَ بْنِ أَبِی سَلَمَۃَ ، قَالَ : دَخَلتُ عَلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ یَأْکُل ، فَقَالَ : اجْلِسْ یَابُنَی ، وَقُلْ : بِسْمِ اللہِ ، وَکُلْ بِیَمِینِکَ ، وَکُلْ مِمَّا یَلِیکَ۔ (ابوداؤد ۳۷۷۱۔ نسائی ۶۷۵۶)","Da'if","Musannaf Ibn Abi Shaybah 24928","","","كتاب الأطعمة"
"24929","(۲۴۹۲۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ عُمَارَۃَ بْنِ مُطَرِّفٍ ، عَنْ بُرَیْد بْنِ أَبِی مَرْیَمَ ، عْن أَبِیہِ ، قَالَ : رَأَی عُمَرُ بْنُ الْخَطَّابِ رَجُلاً وَقَدْ ضَرَبَ بِیَدِہِ الْیُسْرَی لِیَأْکُلَ بِہَا، قَالَ: لاَ، إِلاَّ أَنْ تَکُونَ یَدُکَ عَلِیلَۃً، أَوْ مُعْتَلَّۃً۔","Hasan","Musannaf Ibn Abi Shaybah 24929","","","كتاب الأطعمة"
"24930","(۲۴۹۳۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ جَابِرِ بْنِ صُبْحٍ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی جَرْوَۃَ ، عَنْ عَمَّتِہِ ؛ أَنَّ عَائِشَۃَ رَأَتِ امْرَأَۃً تَأْکُلُ بِشِمَالِہَا ، فَنَہَتْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 24930","","","كتاب الأطعمة"
"24931","(۲۴۹۳۱) حَدَّثَنَا أَزْہَرُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : شَرِبْتُ عِنْدَ مُحَمَّدٍ بِشِمَالِی ، فَلَمْ یَنْہَنِی۔","","Musannaf Ibn Abi Shaybah 24931","","","كتاب الأطعمة"
"24932","(۲۴۹۳۲) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ إِیَاسِ بْنِ سَلَمَۃَ ؛ أَنَّ أَبَاہُ حَدَّثَہُ : أَنَّ رَجُلاً أَکَلَ عِنْدَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِشِمَالِہِ ، فَقَالَ : کُلْ بِیَمِینِکَ ، قَالَ : لاَ أَسْتَطِیعُ ، قَالَ : لاَ اسْتَطَعْتَ ، مَا مَنَعَہُ إِلاَّ الْکِبْرُ ، قَالَ : فَمَا رَفَعَہَا إِلَی فِیہِ۔ (مسلم ۱۰۷۔ احمد ۴/۴۵)","Sahih","Musannaf Ibn Abi Shaybah 24932","","","كتاب الأطعمة"
"24933","(۲۴۹۳۳) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یَأْکُلَ أَحَدُنَا بِشِمَالِہِ۔ (مسلم ۱۰۴۔ ابوداؤد ۴۱۳۴)","Sahih","Musannaf Ibn Abi Shaybah 24933","","","كتاب الأطعمة"
"24934","(۲۴۹۳۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا طَعِمَ أَحَدُکُمْ فَلاَ یَمْسَحْ یَدَہُ حَتَّی یَمُصَّہَا ، فَإِنَّہُ لاَ یَدْرِی فِی أَیِّ طَعَامِہِ یُبَارَکُ لَہُ فِیہِ۔\n(مسلم ۱۶۰۷۔ ابن ماجہ ۳۲۷۰)","Hasan","Musannaf Ibn Abi Shaybah 24934","","","كتاب الأطعمة"
"24935","(۲۴۹۳۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو بْنِ دِینَار ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا أَکَلَ أَحَدُکُمْ طَعَامًا ، فَلاَ یَمْسَحْہَا حَتَّی یَلْعَقَہَا ، أَوْ یُلْعِقَہَا۔ (بخاری ۵۴۵۶۔ مسلم ۱۲۹)","Sahih","Musannaf Ibn Abi Shaybah 24935","","","كتاب الأطعمة"
"24936","(۲۴۹۳۶) حَدَّثَنَا سُوَیْد بْنُ عَمْرٍو ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، قَالَ : کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا أَکَلَ لَعِقَ أَصَابِعَہُ الثَّلاَثَ ، وَقَالَ : أَمَرَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ نَسْلُتَ الصَّحْفَۃَ ، وَقَالَ : إِنَّ أَحَدَکُمْ لاَ یَدْرِی فِی أَیِّ طَعَامِہِ یُبَارَکُ لَہُ فِیہِ۔ (مسلم ۱۶۰۷۔ ابوداؤد ۳۸۴۱)","Sahih","Musannaf Ibn Abi Shaybah 24936","","","كتاب الأطعمة"
"24937","(۲۴۹۳۷) حَدَّثَنَا ابْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ ، عَنْ سَعْدِ بْنِ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ کَعْبِ بْنِ مَالِکٍ، عَنْ أَبِیہِ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ لَعِقَ أَصَابِعَہُ الثَّلاَثَ مِنَ الطَّعَامِ۔ (مسلم ۱۳۱۔ نسائی ۶۷۵۲)","Sahih","Musannaf Ibn Abi Shaybah 24937","","","كتاب الأطعمة"
"24938","(۲۴۹۳۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمٍ ، عَنْ عَطَائٍ ، قَالَ : قَالَ عُمَرُ : لاَ یَصْلُحُ لِمُسْلِمٍ إِذَا أَکَلَ طَعَامًا أَنْ یَمْسَحَ یَدَہُ حَتَّی یَلْعَقَہَا ، أَوْ یُلْعِقَہَا۔","","Musannaf Ibn Abi Shaybah 24938","","","كتاب الأطعمة"
"24939","(۲۴۹۳۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا رَأَیْتُ ابْنَ عُمَرَ یَتَوَضَّأُ مِنْ طَعَامٍ قَطُّ ، وَکَانَ یَلْعَقُ أَصَابِعَہُ الثَّلاَثَ ، ثُمَّ یَمْسَحُ یَدَہُ بِالتُّرَابِ۔","Sahih","Musannaf Ibn Abi Shaybah 24939","","","كتاب الأطعمة"
"24940","(۲۴۹۴۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ إِسْمَاعِیلَ بْنِ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : کَانَ أَصْحَابُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا قُرِّبَ الطَّعَامُ لاَ یَمْسَحُونَ أَیْدِیَہُمْ ، حَتَّی یُنَقُّوہَا بِاللَّعْقِ۔","Sahih","Musannaf Ibn Abi Shaybah 24940","","","كتاب الأطعمة"
"24941","(۲۴۹۴۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، قَالَ : قُلْتُ لِعُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ : کُنْتَ تَشْہَدُ طَعَامَ ابْنِ عَبَّاسٍ ؟ قَالَ : نَعَمْ ، قُلْتُ : فَأَیْش کُنْتَ تَرَاہُ یَصْنَعُ ؟ قَالَ : کُنْتُ أَرَاہُ یَلْعَقُ أَصَابِعَہُ الثَّلاَثَ۔","Sahih","Musannaf Ibn Abi Shaybah 24941","","","كتاب الأطعمة"
"24942","(۲۴۹۴۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِلَعْقِ الأَصَابِعِ وَالصَّحْفَۃِ ، وَقَالَ : إِنَّکُمْ لاَ تَدْرُونَ فِی أَیِّہِ الْبَرَکَۃُ۔ (مسلم ۱۳۳)","Sahih","Musannaf Ibn Abi Shaybah 24942","","","كتاب الأطعمة"
"24943","(۲۴۹۴۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی صَالِحٍ ، وَأَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا فَرَغَ أَحَدُکُمْ مِنْ طَعَامِہِ ، فَلْیَلْعَقْ أَصَابِعَہُ ، فَإِنَّہُ لاَ یَدْرِی فِی أَیِّ طَعَامِہِ یُبَارَکُ لَہُ۔\n(مسلم ۱۳۶)","Sahih","Musannaf Ibn Abi Shaybah 24943","","","كتاب الأطعمة"
"24944","(۲۴۹۴۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یَلْعَقُ أَصَابِعَہُ الثَّلاَثَ إِذَا أَکَلَ ، وَقَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّہُ لاَ یَدْرِی فِی أَیِّ طَعَامِہِ الْبَرَکَۃُ۔ (احمد ۲/۷)","Sahih","Musannaf Ibn Abi Shaybah 24944","","","كتاب الأطعمة"
"24945","(۲۴۹۴۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا وَقَعَتِ اللُّقْمَۃُ مِنْ یَدِ أَحَدِکُمْ ، فَلْیَمْسَحْ مَا عَلَیْہَا مِنَ الأَذَی وَلْیَأْکُلْہَا۔\n(مسلم ۱۶۰۷۔ ابن ماجہ ۳۲۷۹)","Hasan","Musannaf Ibn Abi Shaybah 24945","","","كتاب الأطعمة"
"24946","(۲۴۹۴۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ حُمَیْدٍ ، عَنْ أَنَسٍ ؛ أَنَّ لُقْمَۃً سَقَطَتْ مِنْ یَدِہِ فَطَلَبَہَا حَتَّی وَجَدَہَا ، وَقَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا سَقَطَتْ لُقْمَۃُ أَحَدِکُمْ ، فَلْیُمِطْ مَا عَلَیْہَا ، ثُمَّ لِیَأْکُلْہَا ، وَلاَ یَدَعْہَا لِلشَّیْطَانِ۔ (احمد ۱۰۰)","Sahih","Musannaf Ibn Abi Shaybah 24946","","","كتاب الأطعمة"
"24947","(۲۴۹۴۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِذَا وُضِعَ الطَّعَامُ فَکُلُوا مِنْ حَافَّتِہِ وَدَعُوا وَسَطَہُ ، فَإِنَّ البَرَکَۃَ تَنْزِلُ فِی وَسَطِہِ۔ (ابوداؤد ۳۷۶۶۔ ترمذی ۱۸۰۵)","Da'if","Musannaf Ibn Abi Shaybah 24947","","","كتاب الأطعمة"
"24948","(۲۴۹۴۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِید ، عَن مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إِذَا وُضِعَتِ القَصْعَۃُ ، فَکُلُوا مِنْ حَوَالِیْہَا ، وَذَرُوا ذِرْوَتَہَا ، فَإِنَّ فِی ذِرْوَتِہَا الْبَرَکَۃُ۔","Da'if","Musannaf Ibn Abi Shaybah 24948","","","كتاب الأطعمة"
"24949","(۲۴۹۴۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ سَعِیدِ بْنِ حُوَیْرِثٍ ، سَمِعْت ابْنَ عَبَّاسٍ یَقُولُ : کُنَّا عِنْدَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَجَائَ مِنَ الْغَائِطِ وَأُتِیَ بِطَعَامٍ ، فَقِیلَ لَہُ : أَلاَ تَتَوَضَّأُ ؟ قَالَ : لَمْ أُصَلِّ فَأَتَوَضَّأَ۔\n(مسلم ۱۱۹۔ احمد ۱/۲۲۱)","Sahih","Musannaf Ibn Abi Shaybah 24949","","","كتاب الأطعمة"
"24950","(۲۴۹۵۰) حَدَّثَنَا حَفْصٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : خَرَجَ عُمَرُ بْنُ الْخَطَّابِ مِنَ الْخَلاَئِ وَأُتِیَ بِطَعَامٍ ، فَقَالُوا : نَدْعُو بِوَضُوئٍ ، فَقَالَ : إِنَّمَا آکُلُ بِیَمِینِی ، وَأَسْتَطِیبُ بِشِمَالِی ، فَأَکَلَ وَلَمْ یَمَسَّ مَائً۔","Sahih","Musannaf Ibn Abi Shaybah 24950","","","كتاب الأطعمة"
"24951","(۲۴۹۵۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ أَبِیہِ ؛ أَنَّ ابْنَ مَسْعُودٍ دَعَا رَجُلاً إِلَی طَعَامِہِ ، فَقَالَ : إِنِّی قَدْ بُلْتُ ، قَالَ : إِنَّک لَمْ تَبُلْ فِی یَدِک۔","","Musannaf Ibn Abi Shaybah 24951","","","كتاب الأطعمة"
"24952","(۲۴۹۵۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ أَبِیہِ ، قَالَ : دَعَا عَبْدُ اللہِ رَجُلاً إِلَی طَعَامِہِ ، فَقَالَ : إِنِّی قَدْ بُلْتُ ، قَالَ : بَوْلُک لَیْسَ فِی یَدِک۔","Sahih","Musannaf Ibn Abi Shaybah 24952","","","كتاب الأطعمة"
"24953","(۲۴۹۵۳) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ أَخِی الزُّہْرِیِّ ، قَالَ : أَخْبَرَتْنِی أُخْتِی ؛ أَنَّہَا رَأَتِ الزُّہْرِیَّ یَأْکُلُ بِخَمْسٍ ، فَسَأَلَتْہُ عَنْ ذَلِکَ ؟ فَقَالَ : کَانَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْکُلُ بِالْخَمْسِ۔","Da'if","Musannaf Ibn Abi Shaybah 24953","","","كتاب الأطعمة"
"24954","(۲۴۹۵۴) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنْ خَالِدِ بْنِ أَبِی بَکْرٍ ، قَالَ : رَأَیْتُ الْقَاسِمَ ، وَسَالِمًا یَأْکُلاَنِ بِثَلاَثِ أَصَابِعَ۔","","Musannaf Ibn Abi Shaybah 24954","","","كتاب الأطعمة"
"24955","(۲۴۹۵۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنِ ابْنٍ لِکَعْبٍ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَأْکُلُ بِأَصَابِعِہِ الثَّلاَثِ ، وَیَلْعَقُہُنَّ۔ (مسلم ۱۶۰۵۔ ابوداؤد ۳۸۴۴)","","Musannaf Ibn Abi Shaybah 24955","","","كتاب الأطعمة"
"24956","(۲۴۹۵۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عِیسَی بْنِ حِطَّانَ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ إِذَا اشْتَکَی صَدْرَہُ ، صُنِعَ لَہُ الْحَسْوُ فِیہِ الثُّومُ فَیَحْسُوہُ۔","Hasan","Musannaf Ibn Abi Shaybah 24956","","","كتاب الأطعمة"
"24957","(۲۴۹۵۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَاصِمٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ کَانَ إِذَا اشْتَکَی صَدْرَہُ ، صُنِعَ لَہُ الْحَسَائُ فِیہِ الثُّومُ ، فَیَحْسُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24957","","","كتاب الأطعمة"
"24958","(۲۴۹۵۸) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ أَبِی عُبَیْدٍ حَاجِبِ سُلَیْمَانَ ، عَنْ نُعَیْمِ بْنِ سَلاَمۃ ، قَالَ : دَخَلْتُ عَلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، فَوَجَدْتہ یَأْکُلُ ثُومًا مَسْلُوقًا بِمِلْحٍ وَزَیْتٍ۔","","Musannaf Ibn Abi Shaybah 24958","","","كتاب الأطعمة"
"24959","(۲۴۹۵۹) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : سُئِلَ عِکْرِمَۃُ عَنْہُ ؟ فَقَالَ : إِنَّا لَنَأْکُلُہُ الأسْبُوعَ وَالأسْبُوعَیْنِ ، وَلَکِنَّا نَخْرُجُ مِنَ الْمَدِینَۃِ۔","","Musannaf Ibn Abi Shaybah 24959","","","كتاب الأطعمة"
"24960","(۲۴۹۶۰) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ مَنْصُورٍ ، عَنِ ابْنِ سِیرِینَ ؛ أَنَّہُ کَانَ لاَ یَرَی بِالثُّومِ وَالْبَصَلِ نِیْئًا بَأْسًا۔","","Musannaf Ibn Abi Shaybah 24960","","","كتاب الأطعمة"
"24961","(۲۴۹۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : إِنَّا لَنَأْکُلُ الثُّومَ ،وَالْبَصَلَ ، وَالْکُرَّاثَ۔","No Data Available","Musannaf Ibn Abi Shaybah 24961","","","كتاب الأطعمة"
"24962","(۲۴۹۶۲) حدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إِبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِالثُّومِ فِی الطَّبِیخِ۔","","Musannaf Ibn Abi Shaybah 24962","","","كتاب الأطعمة"
"24963","(۲۴۹۶۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : قَالَ عُمَرُ : مَنْ أَکَلَ مِنْ ہَاتَیْنِ الشَّجَرَتَیْنِ شَیْئًا ، فَلْیُذْہِبْ رِیحَہُمَا نضجًا ، یَعْنِی الْبَصَلَ ، وَالْکُرَّاثَ۔","","Musannaf Ibn Abi Shaybah 24963","","","كتاب الأطعمة"
"24964","(۲۴۹۶۴) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ ہِشَامٍ، عَنْ مُحَمَّدٍ، قَالَ: مَا أَعْلَمُ بِأَکْلِ الثُّومِ بَأْسًا ، إِلاَّ أَنْ یَکْرَہَ رَجُلٌ رِیحَہُ۔","","Musannaf Ibn Abi Shaybah 24964","","","كتاب الأطعمة"
"24965","(۲۴۹۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ یُنْضِجُہُ فِی الْقُدُورِ وَیَأْکُلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 24965","","","كتاب الأطعمة"
"24966","(۲۴۹۶۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِیہِ ، عَنْ أُمِّ أَیُّوبَ ، قَالَتْ : نَزَلَ عَلَیْنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَصَنَعْنَا لَہُ طَعَامًا فِیہِ مِنْ بَعْضِ الْبُقُولِ ، فَکَرِہَہُ ، وَقَالَ : إِنِّی لَسْتُ مِثْلَکُمْ ، إِنِّی أَخَافُ أَنْ أُوذِیَ صَاحِبِی۔","Sahih","Musannaf Ibn Abi Shaybah 24966","","","كتاب الأطعمة"
"24967","(۲۴۹۶۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنْ أَکَلَ مِنْ ہَذِہِ الْبَقْلَۃِ ، فَلاَ یَقْرَبَ الْمَسْجِدَ حَتَّی یَذْہَبَ رِیحُہَا ، یَعْنِی الثُّومَ۔","Sahih","Musannaf Ibn Abi Shaybah 24967","","","كتاب الأطعمة"
"24968","(۲۴۹۶۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ سَالِمِ بْنِ عَبْدِ اللہِ بْنِ یَزِیدَ ، عَنْ طَبَّاخِ حُذَیْفَۃَ ، قَالَ : کَانَ حُذَیْفَۃُ یَأْمُرُنِی أَنْ لاَ أَجْعَلَ فِی طَعَامِہِ کُرَّاثًا۔","Da'if","Musannaf Ibn Abi Shaybah 24968","","","كتاب الأطعمة"
"24969","(۲۴۹۶۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ عَدِیٍّ ، عَنْ زِرِّ بْنِ حُبَیْشٍ ، عَنْ حُذَیْفَۃَ ، قَالَ : مَنْ أَکَلَ الثُّومَ ، فَلاَ یَقْرَبْنَا ثَلاَثًا۔","Sahih","Musannaf Ibn Abi Shaybah 24969","","","كتاب الأطعمة"
"24970","(۲۴۹۷۰) حَدَّثَنَا إِسْمَاعِیلُ ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ، عَنْ أَبِی بُرْدَۃَ؛ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَجَدَ مِنَ الْمُغِیرَۃِ رِیحَ ثُومٍ، فَقَالَ: أَلَمْ أَنْہَکُمْ عَنْ ہَذِہِ الشَّجَرَۃِ؟ فَقَالَ: یَا رَسُولَ اللہِ، أَقْسَمْتُ عَلَیْک لَتُدْخِلَنَّ یَدَک ، قَالَ : وَعَلَیْہِ جُبَّۃٌ ، أَوْ قَمِیصٌ ، فَأَدْخَلَ یَدَہُ فَإِذَا عَلَی صَدْرِہِ عِصَابٌ ، قَالَ : أَرَی لَکَ عُذْرًا۔","","Musannaf Ibn Abi Shaybah 24970","","","كتاب الأطعمة"
"24971","(۲۴۹۷۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ، عَنْ أَبِی الرَّبَاب، عَنْ مَعْقِلِ بْنِ یَسَارٍ، قَالَ: سَمِعْتُہُ یَقُولُ: کُنَّا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی مَسِیرَۃٍ فَقَالَ : مَنْ أَکَلَ مِنْ ہَذِہِ الشَّجَرَۃِ ، فَلاَ یَقْرَبَنَّ مُصَلاَّنَا۔","Da'if","Musannaf Ibn Abi Shaybah 24971","","","كتاب الأطعمة"
"24972","(۲۴۹۷۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُعْتَمِرٌ ، عَنْ أَبِیہِ ، قَالَ : رَأَی الْحَسَنُ مَعَ أُمِّہِ کُرَّاثًا ، فَقَالَ : یَا أُمَّتَاہُ ، أَلْقِ ہَذِہِ الشَّجَرَۃَ الْخَبِیثَۃَ۔","","Musannaf Ibn Abi Shaybah 24972","","","كتاب الأطعمة"
"24973","(۲۴۹۷۳) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَکَلَ مِنْ ہَذِہِ الْبَقْلَۃِ ، فَلاَ یَقْرَبَنَّ مَسْجِدَنَا ، أَوْ قَالَ : الْمَسْجِدَ۔","Da'if","Musannaf Ibn Abi Shaybah 24973","","","كتاب الأطعمة"
"24974","(۲۴۹۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُلَیْمَانَ بْنِ الْمُغِیرَۃِ ، عَنْ حُمَیْدِ بْنِ ہِلاَلٍ ، عَنْ أَبِی بُرْدَۃَ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، قَالَ : أَکَلْتُ ثُومًا ثُمَّ أَتَیْتُ مُصَلَّی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَوَجَدْتہ قَدْ سَبَقَنِی بِرَکْعَۃٍ ، فَلَمَّا صَلَّی قُمْتُ أَقْضِی ، فَوَجَد الرِّیحَ ، فَقَالَ : مَنْ أَکَلَ مِنْ ہَذِہِ الْبَقْلَۃَ ، فَلاَ یَقْرَبَنَّ مَسْجِدَنَا حَتَّی یَذْہَبَ رِیحُہَا ، قَالَ الْمُغِیرَۃُ : فَلَمَّا قَضَیْتُ الصَّلاَۃَ أَتَیْتہُ ، فَقُلْتُ : یَا رَسُولَ اللہِ ، إِنَّ لِی عُذْرًا ، نَاوِلْنِی یَدَک ، قَالَ : فَوَجَدْتُہُ وَاللَّہِ سَہْلاً ، فَنَاوَلَنِی یَدَہُ ، فَأَدْخَلْتُہَا إِلَی صَدْرِی فَوَجَدَہُ مَعْصُوبًا ، فَقَالَ : إِنَّ لَکَ عُذْرًا۔","Sahih","Musannaf Ibn Abi Shaybah 24974","","","كتاب الأطعمة"
"24975","(۲۴۹۷۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ یُونُسَ بْنِ أَبِی إِسْحَاقَ ، عَنْ عُمَیْرِ بْنِ قُمَیْمٍ ، عَنْ شَرِیکِ بْنِ حَنْبَلٍ ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ أَکَلَ مِنْ ہَذِہِ الْبَقْلَۃِ الْخَبِیثَۃِ فَلاَ یَقْرَبَنَّ مَسْجِدَنَا ، یَعْنِی الثُّومَ۔","Da'if","Musannaf Ibn Abi Shaybah 24975","","","كتاب الأطعمة"
"24976","(۲۴۹۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَالِمِ بْنِ أَبِی الْجَعْدِ ، عَنْ مَعْدَانَ بْنِ أَبِی طَلْحَۃَ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ قَالَ : إِنَّکُمْ لَتَأْکُلُونَ شَجَرَتَیْنِ لاَ أَرَاہُمَا إِلاَّ خَبِیثَتَیْنِ ، ہَذَا الثُّومُ ، وَہَذَا الْبَصَلُ ، کُنْت أَرَی الرَّجُلَ عَلَی عَہْدِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُوجَدُ رِیحُہُ مِنْہُ ، فَیُؤْخَذُ بِیَدِہِ حَتَّی یُخْرَجَ بِہِ إِلَی الْبَقِیعِ ، فَمَنْ کَانَ آکِلَہُمَا لاَ بُدَّ فَلْیُمِتْہُمَا طَبْخًا۔ (مسلم ۳۹۷۔ احمد ۱/۲۷)","Sahih","Musannaf Ibn Abi Shaybah 24976","","","كتاب الأطعمة"
"24977","(۲۴۹۷۷) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ لَیْثٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ، عَنْ أَبِی الْخَیْرِ، عَنْ أَبِی رُہْمٍ السَّمَاعِیِّ؛ أَنَّ أَبَا أَیُّوبَ حَدَّثَہُ عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ قَالَ : إِنَّ فِیہِ بَصَلاً فَکُلُوہُ ، وَکَرِہْت أَکْلَہُ مِنْ أَجْلِہِ ، یَعْنِی الْمَلَکَ ، وَأَمَّا أَنْتُمْ فَکُلُوہُ۔ (مسلم ۱۷۰۔ احمد ۵/۴۱۳)","Sahih","Musannaf Ibn Abi Shaybah 24977","","","كتاب الأطعمة"
"24978","(۲۴۹۷۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَرِہَ أَکْلَ الثُّومِ ، وَالْبَصَلِ ،وَالْکُرَّاثِ۔","No Data Available","Musannaf Ibn Abi Shaybah 24978","","","كتاب الأطعمة"
"24979","(۲۴۹۷۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ أَبِی أُمَیَّۃَ ، عَنِ الْحَسَنِ ، قَالَ : مَا یَسُرُّنِی أَنِّی أَکَلْتُہُ ، یَعْنِی الثُّومَ ، وَلاَ أَنَّ لِی زِنَتَہُ ذَہَبًا۔","","Musannaf Ibn Abi Shaybah 24979","","","كتاب الأطعمة"
"24980","(۲۴۹۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ جَبَلَۃَ بْنِ سُحَیْمٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الْقِرَانِ ، إِلاَّ أَنْ تَسْتَأْذِنَ أَصْحَابَکَ۔ (بخاری ۵۴۴۶۔ ترمذی ۱۸۱۴)","Sahih","Musannaf Ibn Abi Shaybah 24980","","","كتاب الأطعمة"
"24981","(۲۴۹۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مُوسَی بْنِ دِہْقَانَ ، قَالَ : رَأَیْتُ سَالِمَ بْنَ عَبْدِ اللہِ یَأْکُلُ التَّمْرَ کَفًّا کَفًّا۔","","Musannaf Ibn Abi Shaybah 24981","","","كتاب الأطعمة"
"24982","(۲۴۹۸۲) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِی جَحْشٍ ، عَنْ أَبِی ہُرَیْرَۃَ ؛ أَنَّہُ أَکَلَ مَعَ أَصْحَابِہِ تَمْرًا ، فَقَالَ : إِنِّی قَدْ قَارَنْتُ فَقَارِنُوا۔","Da'if","Musannaf Ibn Abi Shaybah 24982","","","كتاب الأطعمة"
"24983","(۲۴۹۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَبِیبَۃَ بِنْتِ عَبَّادٍ ، عَنْ أُمِّہَا ، قَالَتْ : سَأَلْتُ عَائِشَۃَ عَنِ الْقِرَانِ بَیْنَ التَّمْرَتَیْنِ ؟ فَقَالَتْ : لَوْ کَانَ حَلاَلاً کَانَ دَنَائَۃً۔","Da'if","Musannaf Ibn Abi Shaybah 24983","","","كتاب الأطعمة"
"24984","(۲۴۹۸۴) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : حدَّثَنَا یَعْقُوبُ بْنُ مُحَمَّدِ بْنِ طَحْلاَئَ ، قَالَ : حَدَّثَنَا أَبُو الرِّجَالِ ، عَنْ أُمِّہِ عَمْرَۃَ ، عَنْ عَائِشَۃَ ، قَالَتْ : قَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا عَائِشَۃُ ، بَیْتٌ لَیْسَ فِیہِ تَمْرٌ جِیَاعٌ أَہْلُہُ۔ (مسلم ۱۵۳۔ ابوداؤد ۳۸۲۷)","Sahih","Musannaf Ibn Abi Shaybah 24984","","","كتاب الأطعمة"
"24985","(۲۴۹۸۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ أَبِی مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَسْتَحِبُّونَ أَنْ لاَ یُفَارِقَ بُیُوتَہُمُ التَّمْرُ ، قَالَ إِبْرَاہِیمُ : وَسَأُفَسِّرُہُ : کَانَ إِذَا دَخَلَ عَلَیْہِمُ الدَّاخِلُ فَأَرَادُوا کَرَامَتَہُ ، فَحَبَسُوہُ وَقَرَّبُوہُ مِنْ قَرِیبٍ ، فَإِنْ أَکَلَ مِنْہُ أَکْرَمُوہُ ، وَإِنْ لَمْ یَأْکُلْ فَقَدْ أَجْزَأَ عَنْہُمْ۔ قَالَ إِبْرَاہِیمُ : وَأُخْرَی ؛ یَجِیئُ السَّائِلُ وَلَیْسَ عِنْدَ أَہْلِ الْبَیْتِ خُبْزٌ ، وَلاَ یُوَاتِی أَنْفُسَہُمْ أَنْ یَحْثُوا لَہُ مِنَ الدَّقِیقِ وَالْحِنْطَۃِ ، فَیُعْطُونَہُ التَّمْرَۃَ وَالتَّمْرَتَیْنِ وَنَحْوَ ذَلِکَ ، فَیُغْنِی عَنْ أَہْلِ الْبَیْتِ ، وَیَسْتَقِیمُ بِہِ السَّائِلُ۔","","Musannaf Ibn Abi Shaybah 24985","","","كتاب الأطعمة"
"24986","(۲۴۹۸۶) حَدَّثَنَا حَفْصٌ ، عَنْ مُصْعَبٍ بْنِ سُلَیْمٍ ، عَنْ أَنَسٍ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْکُلُ مُفْعیًا تَمْرًا۔ (مسلم ۱۶۱۶۔ ابوداؤد ۳۷۶۵)","Hasan","Musannaf Ibn Abi Shaybah 24986","","","كتاب الأطعمة"
"24987","(۲۴۹۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، وَمُحَمَّدُ بْنُ بِشْرٍ ، عَنْ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی بُرْدَۃَ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّ اللَّہَ لَیَرْضَی عَنِ الْعَبْدِ أَنْ یَأْکُلَ الأَکْلَۃَ فَیَحْمَدَہُ عَلَیْہَا ، أَوْ یَشْرَبَ الشَّرْبَۃَ فَیَحْمَدَہُ عَلَیْہَا۔ (مسلم ۸۹۔ ترمذی ۱۸۱۶)","Sahih","Musannaf Ibn Abi Shaybah 24987","","","كتاب الأطعمة"
"24988","(۲۴۹۸۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ: حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ یَزِیدَ بْنُ جَابِرٍ ، قَالَ: حَدَّثَنَا بِشْرُ بْنُ زِیَادٍ ، عَنْ سُلَیْمَانَ بْنِ عَبْدِ اللہِ، عَنْ عِتْرِیسِ بْنِ عُرْقُوبٍ، قَالَ: قَالَ عَبْدُ اللہِ: مَنْ قَالَ حِینَ یُوضَعُ طَعَامُہُ: بِسْمِ اللہِ خَیْرُ الأَسْمَائِ، لِلَّہِ مِا فِی الأَرْضِ وَفِی السَّمَائِ، لاَ یَضُرُّ مَعَ اسْمِہِ دَائٌ، اللَّہُمَّ اجْعَلْ فِیہِ بَرَکَۃً وَعَافِیَۃً وَشِفَائً ، فَلاَ یَضُرُّہُ ذَلِکَ الطَّعَامُ مَا کَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 24988","","","كتاب الأطعمة"
"24989","(۲۴۹۸۹) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إِذَا طَعِمْتَ فَنَسِیتَ أَنْ تُسَمِّیَ ، فَقُلْ : بِسْمِ اللہِ فِی أَوَّلِہِ وَآخِرِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 24989","","","كتاب الأطعمة"
"24990","(۲۴۹۹۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَن تَمِیمِ بْنِ سَلَمَۃَ ، قَالَ : حُدِّثْتُ أَنَّ الرَّجُلَ إِذَا ذَکَرَ اسْمَ اللَّہَ عَلَی طَعَامِہِ وَحَمِدَہُ عَلَی آخِرِہِ ، لَمْ یُسْأَلْ عَنْ نَعِیمِ ذَلِکَ الطَّعَامِ۔","","Musannaf Ibn Abi Shaybah 24990","","","كتاب الأطعمة"
"24991","(۲۴۹۹۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ ، عَنِ الْحَارِثِ بْنِ سُوَیْد ، قَالَ : کَانَ سَلْمَانُ إِذَا طَعِمَ یَقُول : الْحَمْدُ لِلَّہِ الَّذِی کَفَانَا الْمُؤْونَۃَ ، وَأَوْسَعَ لَنَا الرِّزْقَ۔","Sahih","Musannaf Ibn Abi Shaybah 24991","","","كتاب الأطعمة"
"24992","(۲۴۹۹۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ، عَنْ حَجَّاجٍ، عَنْ رِیَاحِ بْنِ عَبِیدَۃَ، عَنْ مَوْلًی لأَبِی سَعِیدٍ، عَنْ أَبِی سَعِیدٍ، قَالَ: کَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ إِذَا أَکَلَ طَعَامًا، قَالَ: الْحَمْدُ لِلَّہِ الَّذِی أَطْعَمَنَا وَسَقَانَا ، وَجَعَلَنَا مُسْلِمِینَ۔ (ترمذی ۳۴۵۷۔ ابوداؤد ۳۸۴۶)","","Musannaf Ibn Abi Shaybah 24992","","","كتاب الأطعمة"
"24993","(۲۴۹۹۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدَّثَنَا مِسْعَرٌ ، عَنْ ہِلاَلٍ ، عَنْ عُرْوَۃَ ؛ أَنَّہُ کَانَ إِذَا وُضِعَ الطَّعَامُ ، قَالَ : سُبْحَانَکَ مَا أَحْسَنَ مَا تُبْلِینَا ، سُبْحَانَکَ مَا أَحْسَنَ مَا تُعْطِینَا ، رَبَّنَا وَرَبَّ أَبْنَائِنَا ، وَرَبَّ آبَائِنَا الأَوَّلِینَ ، قَالَ: ثُمَّ یُسَمِّی اللَّہَ جَلَّ ثَنَاؤُہُ ، وَیَضَعُ یَدَہُ۔","","Musannaf Ibn Abi Shaybah 24993","","","كتاب الأطعمة"
"24994","(۲۴۹۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمِ بْنِ أَبِی النَّجُودِ ، عَنْ ذَکْوَانَ أَبِی صَالِحٍ ، عَنْ عَائِشَۃَ ؛ أَنَّہُ قَدَّمَ إِلَیْہَا طَعَامٌ ، فَقَالَتْ : ائْتدِمُوہُ ، فَقَالُوا : وَمَا إِدَامُہُ ؟ قَالَتْ : تَحْمَدُونَ اللَّہَ عَلَیْہِ إِذَا فَرَغْتُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 24994","","","كتاب الأطعمة"
"24995","(۲۴۹۹۵) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی سَعِیدٍ ، قَالَ : کَانَ أَبُو سَعِیدٍ الْخُدْرِیِّ إِذَا وُضِعَ الطَّعَامُ ، قَالَ : الْحَمْدُ لِلَّہِ الَّذِی أَطْعَمَنَا وَسَقَانَا ، وَجَعَلَنَا مُسْلِمِینَ۔","Da'if","Musannaf Ibn Abi Shaybah 24995","","","كتاب الأطعمة"
"24996","(۲۴۹۹۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی سَعِیدٍ ، عَنْ أَبِیہِ ؛ بِمِثْلِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 24996","","","كتاب الأطعمة"
"24997","(۲۴۹۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الْجُرَیْرِیِّ ، عَنْ أَبِی الْوَرْدِ ، عَنِ ابْنِ أَعْبَدَ ، أَوِ ابْنِ مَعْبَدٍ ، قَالَ : قَالَ عَلِیٌّ : تَدْرِی مَا حَقُّ الطَّعَامِ ؟ قُلْتُ : وَمَا حَقُّہُ ؟ قَالَ : تَقُولُ بِسْمِ اللہِ ، اللَّہُمَّ بَارِکْ لَنَا فِیمَا رَزَقْتَنَا ، قَالَ : تَدْرِی مَا شُکْرُہُ ؟ قُلْتُ : وَمَا شُکْرُہُ ؟ قَالَ : تَقُولُ : الْحَمْدُ لِلَّہِ الَّذِی أَطْعَمَنَا وَسَقَانَا۔","Da'if","Musannaf Ibn Abi Shaybah 24997","","","كتاب الأطعمة"
"24998","(۲۴۹۹۸) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ ؛ أَنَّہُ کَانَ یَقُولُ : الْحَمْدُ لِلَّہِ الَّذِی أَطْعَمَنَا وَسَقَانَا۔","","Musannaf Ibn Abi Shaybah 24998","","","كتاب الأطعمة"
"24999","(۲۴۹۹۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إِدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ إِبْرَاہِیمَ التَّیْمِیِّ ؛ أَنَّہُ کَانَ یَقُولُ : الْحَمْدُ لِلَّہِ الَّذِی کَفَانَا الْمُؤْونَۃَ ، وَأَحْسَنَ لَنَا الرِّزْقَ۔","No Data Available","Musannaf Ibn Abi Shaybah 24999","","","كتاب الأطعمة"
"25000","(۲۵۰۰۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، قَالَ : کَانَ أَبِی لاَ یُؤْتَی بِطَعَامٍ وَلاَ شَرَابٍ ، حَتَّی الشَّرْبَۃَ مِنَ الدَّوَائِ ، فَیَطْعَمُہُ ، أَوْ یَشْرَبُہُ حَتَّی یَقُولَ : الْحَمْدُ لِلَّہِ الَّذِی ہَدَانَا ، وَأَطْعَمَنَا ، وَسَقَانَا وَنَعَّمَنَا ، اللَّہُ أَکْبَرُ ، اللَّہُمَّ أَلْفَتْنَا نِعْمَتُکَ بِکُلِّ شَرٍّ ، وَأَصْبَحْنَا وَأَمْسَیْنَا مِنْہَا بِکُلِّ خَیْرٍ ، نَسْأَلُک تَمَامَہَا وَشُکْرَہَا ، لاَ خَیْرَ إِلاَّ خَیْرُک ، وَلاَ إِلَہَ غَیْرُک ، إِلَہَ الصَّالِحِینَ ، وَرَبَّ الْعَالَمِینَ ، الْحَمْدُ لِلَّہِ رَبِّ الْعَالَمِینَ ، لاَ إِلَہَ إِلاَّ اللَّہُ ، مَا شَائَ اللَّہُ ، لاَ قُوَّۃَ إِلاَّ بِاللَّہِ ، اللَّہُمَّ بَارِکْ لَنَا فِیمَا رَزَقْتنَا ، وَقِنَا عَذَابَ النَّارِ۔","","Musannaf Ibn Abi Shaybah 25000","","","كتاب الأطعمة"
"25001","(۲۵۰۰۱) حَدَّثَنَا الْحَسَنُ بْنُ مُوسَی ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ کَانَ إِذَا فَرَغَ مِنْ طَعَامِہِ ، قَالَ : اللَّہُمَّ أَشْبَعْتَ وَأَرْوَیْتَ فَہَنِّئْنَا ، وَرَزَقْتَنَا فَأَکْثَرْتَ وَأَطْیَبْتَ فَزِدْنَا۔","","Musannaf Ibn Abi Shaybah 25001","","","كتاب الأطعمة"
"25002","(۲۵۰۰۲) حَدَّثَنَا مُعَاوِیَۃُ بْنُ ہِشَامٍ ، قَالَ : أَخْبَرَنَا عَمَّارُ بْنُ رُزَیْقٍ ، عَنْ إِبْرَاہِیمَ بْنِ أَبِی حَفْصَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ؛ أَنَّہُ قَالَ : إِذَا وُضِعَ الطَّعَامُ فَسَمَّیْتَ فَکُلْ مَا جِیئَ بِہِ ، فَإِنَّہُ یُجْزِئُک التَّسْمِیَۃُ الأُولَی۔","","Musannaf Ibn Abi Shaybah 25002","","","كتاب الأطعمة"
"25003","(۲۵۰۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یَزِیدَ بْنِ أَبِی زِیَادٍ ، قَالَ : أَخْبَرَنِی مَنْ رَأَی ابْنَ عَبَّاسٍ یَأْکُلُ مُتَّکِئًا۔","Da'if","Musannaf Ibn Abi Shaybah 25003","","","كتاب الأطعمة"
"25004","(۲۵۰۰۴) حَدَّثَنَا فُضَیْلُ بْنُ عِیَاضٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا أَکَلَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مُتَّکِئًا قَط إِلاَّ مَرَّۃً ، قَالَ : اللَّہُمَّ إِنِّی عَبْدُک وَرَسُولُک۔","","Musannaf Ibn Abi Shaybah 25004","","","كتاب الأطعمة"
"25005","(۲۵۰۰۵) حَدَّثَنَا ہِشَامٌ ، عَنْ حُصَیْنٍ ، قَالَ : لَمَّا قدِمَ خَالِدُ بْنُ الْوَلِیدِ ہَاہُنَا ، إِذَا ہُوَ بِمَسْلَحَۃٍ لآلِ فَارِسٍ ، عَلَیْہِمْ رَجُلٌ یُقَالُ لَہُ : ہزارمرد ، قَالَ : فَذَکَرُوا مِنْ عِظَمِ خَلْقِہِ وَشَجَاعَتِہِ ، قَالَ : فَقَتَلَہُ خَالِدُ بْنُ الْوَلِیدِ ، ثُمَّ دَعَا بِغَدَائِہِ فَتَغَدَّی وَہُوَ مُتَّکِئٌ عَلَی جِیفَتِہِ ، یَعْنِی جَسَدَہُ۔","","Musannaf Ibn Abi Shaybah 25005","","","كتاب الأطعمة"
"25006","(۲۵۰۰۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : إِنْ کُنَّا نَأْکُلُ وَنَحْنُ مُتَّکِئُونَ۔","","Musannaf Ibn Abi Shaybah 25006","","","كتاب الأطعمة"
"25007","(۲۵۰۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَأْکُلُوا تُکَاۃً ، مَخَافَۃَ أَنْ تَعْظُمَ بُطُونُہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 25007","","","كتاب الأطعمة"
"25008","(۲۵۰۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ أَبِی ہِلاَلٍ ، قَالَ : رَأَیْتُ ابْنَ سِیرِینَ یَأْکُلُ مُتَّکِئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25008","","","كتاب الأطعمة"
"25009","(۲۵۰۰۹) حَدَّثَنَا شَرِیکٌ ، عَنْ عَلِیِّ بْنِ الأَقْمَرِ ، عَنْ أَبِی جُحَیْفَۃَ ، یَرْفَعُہُ ، قَالَ : أَمَّا أَنَا فَلاَ آکُلُ مُتَّکِئًا۔ (بخاری ۵۳۹۸۔ ترمذی ۱۸۳۰)","Hasan","Musannaf Ibn Abi Shaybah 25009","","","كتاب الأطعمة"
"25010","(۲۵۰۱۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : حدَّثَنَا حُسَامُ بْنُ مِصَکٍّ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : دَخَلْتُ عَلَی عَبِیدَۃَ فَسَأَلْتُہُ عَنِ الرَّجُلِ یَأْکُلُ مُتَّکِئًا ؟ فَأَکَلَ مُتَّکِئًا۔","","Musannaf Ibn Abi Shaybah 25010","","","كتاب الأطعمة"
"25011","(۲۵۰۱۱) حَدَّثَنَا وَکِیعٌ ، وَأَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ أَبِی عَمْرٍو الشَّیْبَانِیِّ ، قَالَ : رَأَی عَبْدُ اللہِ بْنُ مَسْعُودٍ مَعَ رَجُلٍ دَرَاہِمَ ، فَقَالَ : أَیُّ شَیْئٍ تَصْنَعُ بِہَذِہِ الدَّرَاہِمِ ؟ فَقَالَ : ہَذِہِ یَا أَبَا عَبْدِ الرَّحْمَنِ ثَلاَثُونَ دِرْہَمًا ، أُرِیدُ أَنْ أَشْتَرِیَ بِہَا سَمْنًا لِرَمَضَانَ ، فَقَالَ : تَجْعَلُہُ فِی السُّکُرُّجَۃِ وَتَأْکُلُہُ ؟ قَالَ : نَعَمْ ، قَالَ : اذْہَبْ فَادْفَعْہَا إِلَی امْرَأَتِکَ ، وَمُرْہَا أَنْ تَشْتَرِیَ کُلَّ یَوْمٍ بِدِرْہَمٍ لَحْمًا ، فَہُوَ خَیْرٌ لَک۔","","Musannaf Ibn Abi Shaybah 25011","","","كتاب الأطعمة"
"25012","(۲۵۰۱۲) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَمَّنْ حَدَّثَہُ ، قَالَ : مَرَّ جَابِرٌ عَلَی عُمَرَ بِلَحْمٍ قَدِ اشْتَرَاہُ بِدِرْہَمٍ ، قَالَ : فَقَالَ لَہُ عُمَرُ : مَا ہَذَا ؟ قَالَ : اشْتَرَیْتُہُ بِدِرْہَمٍ ، قَالَ : أَکُلَّمَا اشْتَہَیْتَ شَیْئًا اشْتَرَیْتَہُ ؟ لاَ تَکُنْ مِنْ أَہْلِ ہَذِہِ الآیَۃِ : {أَذْہَبْتُمْ طَیِّبَاتِکُمْ فِی حَیَاتِکُمَ الدُّنْیَا}۔","Da'if","Musannaf Ibn Abi Shaybah 25012","","","كتاب الأطعمة"
"25013","(۲۵۰۱۳) حَدَّثَنَا ابْنُ عُلَیۃ ، عَنْ حَمْزَۃَ بْنِ عَبْدِ اللہِ ؛ أَنَّ الْحَسَنَ کَانَ لَہُ کُلَّ یَوْمٍ نِصْفُ دِرْہَمٍ لَحْمًا۔","","Musannaf Ibn Abi Shaybah 25013","","","كتاب الأطعمة"
"25014","(۲۵۰۱۴) حَدَّثَنَا ابْنُ عُلَیۃ ، عَنْ رَجَائِ بْنِ أَبِی سَلَمَۃَ ، قَالَ : کَانَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ یَصنَعُ طَعَامًا یَحْضُرُہُ ، فَلاَ یَأْکُلُ مِنْہُ فَلاَ یَأْکُلُونَ ، فَقَالَ : مَا شَأْنُہُمْ لاَ یَأْکُلُونَ ؟ فَقَالُوا : إِنَّک لاَ تَأْکُلُ فَلاَ یَأْکُلُونَ ، فَأَمَرَ بِدِرْہَمٍ کُلَّ یَوْمٍ مِنْ صُلْبِ مَالِہِ فَأَنْفَقَہَا فِی الطَّبْخِ ، فَأَکَلَ وَأَکَلُوا۔","","Musannaf Ibn Abi Shaybah 25014","","","كتاب الأطعمة"
"25015","(۲۵۰۱۵) حَدَّثَنَا حُمَیْدٌ، وَالْفَضْلُ، عَنْ زُہَیْرٍ، عَنْ أَبِی إِسْحَاقَ، قَالَ: کَانَ الشَّعْبِیُّ یَشْتَرِی کُلَّ جُمُعَۃٍ بِدِرْہَمٍ لَحْمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 25015","","","كتاب الأطعمة"
"25016","(۲۵۰۱۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ زُہَیْرٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : قَالَ عُمَرُ : یَکْفِی أَہْلَ الْبَیْتِ فِی الشَّہْرِ بِثَلاَثَۃِ دَرَاہِمَ لَحْمٍ۔","","Musannaf Ibn Abi Shaybah 25016","","","كتاب الأطعمة"
"25017","(۲۵۰۱۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سَعِیدِ بْنِ عُبَیْدٍ ، عَنْ عَلِیِّ بْنِ رَبِیعَۃَ ، قَالَ : کَانَ لِعَلِیٍّ امْرَأَتَانِ ، کَانَ یَشْتَرِی کُلَّ یَوْمٍ لِہَذِہِ بِنِصْفِ دِرْہَمٍ لَحْمًا ، وَلِہَذِہِ بِنِصْفِ دِرْہَمٍ لَحمًا۔","Hasan","Musannaf Ibn Abi Shaybah 25017","","","كتاب الأطعمة"
"25018","(۲۵۰۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ حِزَامِ بْنِ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عُمَرُ لِبَنِیہِ : لاَ تُدِیمُوا أَکْلَ اللَّحْمِ ، وَلاَ تُلَظُوا بِالْمَائِ الْعَذْبِ ، وَلاَ تُدِیمُوا لبْسَ الْقَمِیصِ۔","Da'if","Musannaf Ibn Abi Shaybah 25018","","","كتاب الأطعمة"
"25019","(۲۵۰۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ بْنِ رَافِعٍ ، عَنِ الْقَعْقَاعِ بْنِ حَکِیمٍ ، قَالَ : قَالَتْ عَائِشَۃُ : یَا بَنِی تَمِیمٍ ، لاَ تُدِیمُوا أَکْلَ اللَّحْمِ ، فَإِنَّ لَہُ ضَرَاوَۃً کَضَرَاوَۃِ الْخَمْرِ۔","Da'if","Musannaf Ibn Abi Shaybah 25019","","","كتاب الأطعمة"
"25020","(۲۵۰۲۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ، عَنْ أَبِیہِ، قَالَ: إِنْ کَانَ الرَّجُلُ لَیُعَابُ بِأَنْ لاَ یَصْبِرَ عَن اللَّحْمِ۔","","Musannaf Ibn Abi Shaybah 25020","","","كتاب الأطعمة"
"25021","(۲۵۰۲۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ حَبِیبِ بْنِ شَہِیدٍ ، عَنِ ابْنِ بُرَیْدَۃَ ؛ أَنَّ سَلْمَانَ کَانَ یَصْنَعُ الطَّعَامَ مِنْ کَسْبِہِ، فَیَدْعُو الْمَجْذُومِینَ فَیَأْکُلُ مَعَہُمْ۔","Sahih","Musannaf Ibn Abi Shaybah 25021","","","كتاب الأطعمة"
"25022","(۲۵۰۲۲) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ رَجُلٍ ؛ أَنَّہُ رَأَی ابْنَ عُمَرَ یَأْکُلُ مَعَ مَجْذُومٍ ، فَجَعَلَ یَضَعُ یَدَہُ مَوْضِعَ یَدِ الْمَجْذُومِ۔","Da'if","Musannaf Ibn Abi Shaybah 25022","","","كتاب الأطعمة"
"25023","(۲۵۰۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : قدِمَ عَلَی أَبِی بَکْرٍ وَفْدٌ مِنْ ثَقِیفٍ ، فَأُتِیَ بِطَعَامٍ ، فَدَنَا الْقَوْمُ وَتَنَحَّی رَجُلٌ بِہِ ہَذَا الدَّائُ ، یَعْنِی : الْجُذَامَ ، فَقَالَ لَہُ أَبُو بَکْرٍ : اُدْنُہُ ، فَدَنَا ، فَقَالَ : کُلْ ، فَأَکَلَ وَجَعَلَ أَبُو بَکْرٍ یَضَعُ یَدَہُ مَوْضِعَ یَدِہِ۔","","Musannaf Ibn Abi Shaybah 25023","","","كتاب الأطعمة"
"25024","(۲۵۰۲۴) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ مُفَضَّلِ بْنِ فَضَالَۃَ ، عَنْ حَبِیبِ بْنِ شَہِیدٍ ، عَنْ مُحَمَّدِ بْنِ الْمُنْکَدِرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخَذَ بِیَدِ مَجْذُومٍ فَوَضَعَہَا مَعَہُ فِی قَصْعَۃٍ ، فَقَالَ : کُلْ ، بِسْمِ اللہِ ثِقَۃً بِاللَّہِ ، وَتَوَکُّلاً عَلَی اللہِ۔ (ابوداؤد ۳۹۲۱۔ ابن ماجہ ۳۵۴۲)","Da'if","Musannaf Ibn Abi Shaybah 25024","","","كتاب الأطعمة"
"25025","(۲۵۰۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ یَحْیَی بْنِ جَعْدَۃَ ، قَالَ : جَائَ رَجُلٌ أَسْوَدُ بِہِ جُدَرِیٌّ قَدْ تَقَشَّرَ ، لاَ یَجْلِسُ إِلَی جَنْبِ أَحَدٍ إِلاَّ أَقَامَہُ ، فَأَخَذَہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَجْلَسَہُ إِلَی جَنْبِہِ۔","","Musannaf Ibn Abi Shaybah 25025","","","كتاب الأطعمة"
"25026","(۲۵۰۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی بُکَیْر ، عَنْ عِکْرِمَۃَ ، قَالَ : لَزِقَ بِابْنِ عَبَّاسٍ مَجْذُومٌ ، فَقُلْت لَہُ : تَلْزَقُ بِمَجْذُومٍ ؟ قَالَ : فَامْضِی ، فَلَعَلَّہُ خَیْرٌ مِنِّی وَمِنْک۔","Sahih","Musannaf Ibn Abi Shaybah 25026","","","كتاب الأطعمة"
"25027","(۲۵۰۲۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ قَیْسٍ ، عَنْ مِقْسَمٍ ، قَالَ : کَانُوا یَتَّقُونَ أَنْ یَأْکُلُوا مَعَ الأَعْمَی وَالأَعْرَجِ وَالْمَرِیضِ ، حَتَّی نَزَلَتْ ہَذِہِ الآیَۃُ : {لَیْسَ عَلَی الأَعْمَی حَرَجٌ وَلاَ عَلَی الأَعْرَجِ حَرَجٌ وَلاَ عَلَی الْمَرِیضِ حَرَجٌ}۔","","Musannaf Ibn Abi Shaybah 25027","","","كتاب الأطعمة"
"25028","(۲۵۰۲۸) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِ ، عَنْ مُنْذِرٍ ، عَنِ الرَّبِیعِ بْنِ خُثَیْمٍ ؛ أَنَّہُ قَالَ لأَہْلِہِ : اصْنَعُوا لِی خَبِیصًا ، قَالَ : فَصَنَعُوا ، قَالَ : فَدَعَا رَجُلاً کَانَ بِہِ خَبَلٌ ، قَالَ : فَجَعَلَ الرَّبِیعُ یُلْقِمُہُ وَلُعَابُہُ یَسِیلُ ، فَلَمَّا أَکَلَ وَخَرَجَ، قَالَتْ لَہُ أَہْلُہُ : تَکَلَّفْنَا وَصَنَعْنَا فِیہِ ، أَطْعَمْتَہُ ؟ مَا یَدْرِی ہَذَا مَا أَکَلَ ، قَالَ الرَّبِیعُ : لَکِنَ اللَّہُ یَدْرِی۔","","Musannaf Ibn Abi Shaybah 25028","","","كتاب الأطعمة"
"25029","(۲۵۰۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ نَافِعِ بْنِ الْقَاسِمِ ، عَنْ جَدَّتِہِ أُمِّ الْقَاسِمِ ، عَنْ عَائِشَۃَ ، قَالَتْ : کَانَ لِی مَوْلًی مَجْذُومٌ، فَکَانَ یَنَامُ عَلَی فِرَاشِی ، وَیَأْکُلُ فِی صِحَافِی ، وَلَوْ کَانَ عَاشَ کَانَ بَقِی عَلَی ذَلِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 25029","","","كتاب الأطعمة"
"25030","(۲۵۰۳۰) حَدَّثَنَا ہُشَیْمٌ ، وَشَرِیکٌ ، عَنْ یَعْلَی بْنِ عَطَائٍ ، عَنْ عَمْرِو بْنِ الشَّرِیدِ ، عَنْ أَبِیہِ ، قَالَ : کَانَ فِی وَفْدِ ثَقِیفٍ رَجُلٌ مَجْذُومٌ ، فَأَرْسَلَ إِلَیْہِ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إِنَّا قَدْ بَایَعْنَاک فَارْجِعْ۔ (مسلم ۱۲۶۔ احمد ۴/۳۸۹)","Sahih","Musannaf Ibn Abi Shaybah 25030","","","كتاب الأطعمة"
"25031","(۲۵۰۳۱) حَدَّثَنَا وَکِیعٌ ، عَنِ النَّہَّاسِ بْنِ قَہْمٍ ، عَنْ شَیْخٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یَقُولُ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : فِرَّ مِنَ الْمَجْذُومِ ، فِرَارَک مِنَ الأَسَدِ۔ (بخاری ۴۱۷۔ احمد ۲/۴۴۳)","Da'if","Musannaf Ibn Abi Shaybah 25031","","","كتاب الأطعمة"
"25032","(۲۵۰۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ اللہِ بْنِ سَعِیدٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ بْنِ عَمْرِو بْنِ عُثْمَانَ ، عَنْ أُمِّہِ فَاطِمَۃَ بِنْتِ حُسَیْنٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: لاَ تُدِیمُوا النَّظَرَ إِلَی الْمَجْذُومِینَ۔\n(بخاری ۴۱۷۔ احمد ۱/۲۳۳)","Da'if","Musannaf Ibn Abi Shaybah 25032","","","كتاب الأطعمة"
"25033","(۲۵۰۳۳) حَدَّثَنَا مُحَمَّدُ بْنُ سَوَائٍ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّہُ کَانَ یُعْجِبُہُ أَنْ یُتَّقَی الْمَجْذُومُ۔\n(عبدالرزاق ۲۰۳۳۱)","","Musannaf Ibn Abi Shaybah 25033","","","كتاب الأطعمة"
"25034","(۲۵۰۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْمُؤْمِنُ یَأْکُلُ فِی مِعًی وَاحِدٍ ، وَالْکَافِرُ یَأْکُلُ فِی سَبْعَۃِ أَمْعَائٍ۔ (بخاری ۵۳۹۴۔ مسلم ۱۶۳۱)","Sahih","Musannaf Ibn Abi Shaybah 25034","","","كتاب الأطعمة"
"25035","(۲۵۰۳۵) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: الْمُؤْمِنُ یَأْکُلُ فِی مِعًی وَاحِدٍ ، وَالْکَافِرُ یَأْکُلُ فِی سَبْعَۃِ أَمْعَائٍ۔ (مسلم ۱۶۳۱۔ احمد ۳/۳۳۳)","Sahih","Musannaf Ibn Abi Shaybah 25035","","","كتاب الأطعمة"
"25036","(۲۵۰۳۶) حَدَّثَنَا مُحَمَّدُ بْنُ کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْمُؤْمِنُ یَأْکُلُ فِی مِعًی وَاحِدٍ ، وَالْکَافِرُ یَأْکُلُ فِی سَبْعَۃِ أَمْعَائٍ۔\n(ترمذی ۱۸۱۹۔ احمد ۲/۴۳۵)","Hasan","Musannaf Ibn Abi Shaybah 25036","","","كتاب الأطعمة"
"25037","(۲۵۰۳۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا الأَعْمَشُ ، قَالَ : أَظُنُّ أَبَا خَالِدٍ الْوَالِبِیَّ ذَکَرَہُ عَنْ مَیْمُونَۃَ ، قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْکَافِرُ یَأْکُلُ فِی سَبْعَۃِ أَمْعَائٍ ، وَالْمُؤْمِنُ یَأْکُلُ فِی مِعًی وَاحِدٍ۔\n(احمد ۶/۳۳۵۔ طبرانی ۱۳)","Hasan","Musannaf Ibn Abi Shaybah 25037","","","كتاب الأطعمة"
"25038","(۲۵۰۳۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، قَالَ : حدَّثَنِی عُبَیْدٌ الأَغَرُّ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، عَنْ جَہْجَاہٍ الْغِفَارِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْکَافِرُ یَأْکُلُ فِی سَبْعَۃِ أَمْعَائٍ ، وَالْمُؤْمِنُ یَأْکُلُ فِی مِعًی وَاحِدٍ۔ (طبرانی ۲۱۵۲)","Da'if","Musannaf Ibn Abi Shaybah 25038","","","كتاب الأطعمة"
"25039","(۲۵۰۳۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی سُفْیَانَ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : طَعَامُ الْوَاحِدِ یَکْفِی الاِثْنَیْنِ ، وَطَعَامُ الاِثْنَیْنِ یَکْفِی الأَرْبَعَۃَ۔ (مسلم ۱۸۱۔ ترمذی ۱۸۲۰)","Hasan","Musannaf Ibn Abi Shaybah 25039","","","كتاب الأطعمة"
"25040","(۲۵۰۴۰) حَدَّثَنَا حَفْصٌ، عَنْ إِسْمَاعِیلَ بْنِ أَبِی خَالِدٍ، عَنْ أَبِیہِ، قَالَ: دَخَلْتُ عَلَی رَجُلٍ وَہُوَ یَأْکُلُ تَمْرًا وَیَتَمَجَّعُ لَبَنًا ، فَقَالَ : ہَلُمَّ وَسَمِّ ، فَإِنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یُسَمِّیہِمَا الأَطْیَبَیْنِ۔(احمد ۳/۴۷۴)","Da'if","Musannaf Ibn Abi Shaybah 25040","","","كتاب الأطعمة"
"25041","(۲۵۰۴۱) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ أَبِیہِ ، قَالَ : دَخَلْتُ عَلَی عَلِیٍّ فِی یَوْمٍ شَاتٍ ، وَفِی یَدِہِ شَرَابٌ ، فَنَاوَلَنِی فَقَالَ : اشْرَبْ ، قُلْتُ : وَمَا ہُوَ ؟ قَالَ : ثُلُثٌ عَسَلٌ ، وَثُلُثٌ سَمْنٌ ، وَثُلُثٌ لَبَنٌ ، فَقُلْتُ: لاَ أُرِیدُہُ ، فَقَالَ : أَمَا إِنَّک لَوْ شَرِبْتَہُ لَمْ تَزَلْ دَفِیئًا شَبْعَانًا سَائِرَ یَوْمِکَ۔","Da'if","Musannaf Ibn Abi Shaybah 25041","","","كتاب الأطعمة"
"25042","(۲۵۰۴۲) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، قَالَ: رَأَیْتُ إِبْرَاہِیمَ ، وَخَیْثَمَۃَ یَأْکُلاَنِ أَلْیَۃً بِعَسَلٍ۔","","Musannaf Ibn Abi Shaybah 25042","","","كتاب الأطعمة"
"25043","(۲۵۰۴۳) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، قَالَ : حدَّثَنَا إِبْرَاہِیمُ بْنُ سَعْدٍ ، عَنْ أَبِیہِ ، عَنْ عَبْدِ اللہِ بْنِ جَعْفَرٍ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَأْکُلُ الرُّطَبَ بِالْقِثَّائِ۔","Sahih","Musannaf Ibn Abi Shaybah 25043","","","كتاب الأطعمة"
"25044","(۲۵۰۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ یَأْکُلُ الْبِطِّیخَ بِالرُّطَبِ۔\n(ترمذی ۲۰۰۔ احمد ۳/۱۴۲)","","Musannaf Ibn Abi Shaybah 25044","","","كتاب الأطعمة"
"25045","(۲۵۰۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : أَتَیْنَا ابْنَ سِیرِینَ ، فَقَالَ : مَا أَدْرِی مَا أُطْعِمُک ، لَیْسَ مِنْکُمْ رَجُلٌ إِلاَّ وَفِی بَیْتِہِ ، ثُمَّ أَخْرَجَ لَنَا شُہْدَۃً فَجَعَلَ یُطْعِمُنَا۔","","Musannaf Ibn Abi Shaybah 25045","","","كتاب الأطعمة"
"25046","(۲۵۰۴۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ مُجَاہِدٍ ، قَالَ : لَیْسَ الْقِرْدُ مِنْ بَہِیمَۃِ الأَنْعَامِ۔","","Musannaf Ibn Abi Shaybah 25046","","","كتاب الأطعمة"
"25047","(۲۵۰۴۷) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ؛ أَنَّہُ کَرِہَ الْقُنْفُذَ۔","No Data Available","Musannaf Ibn Abi Shaybah 25047","","","كتاب الأطعمة"
"25048","(۲۵۰۴۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنِ ابْنِ طَاوُوسٍ ، عَنْ أَبِیہِ ؛ أَنَّہُ کَانَ لاَ یَرَی بِأَکْلِ الوَبْرِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 25048","","","كتاب الأطعمة"
"25049","(۲۵۰۴۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی یَعْفُورَ ، عَنِ ابْنِ أَبِی أَوْفَی ، قَالَ : غَزَوْتُ مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ سَبْعَ غَزَوَاتٍ نَأْکُلُ الْجَرَادَ۔ (مسلم ۱۵۴۶۔ ترمذی ۱۸۲۱)","Sahih","Musannaf Ibn Abi Shaybah 25049","","","كتاب الأطعمة"
"25050","(۲۵۰۵۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ شَبِیبٍ ، عَنْ جُنْدُبٍ ، رَجُلٌ مِنْہُمْ ، سَأَلَ ابْنَ عَبَّاسٍ عَنْ أَکْلِ الْجَرَادِ ؟ فَقَالَ : لاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 25050","","","كتاب الأطعمة"
