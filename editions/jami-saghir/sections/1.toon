hadiths[2809]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"1","«آتى باب الجنة يوم القيامة فأستفتح فيقول الخازن: من أنت؟ فأقول: محمد, فيقول: بك أمرت أن لا أفتح لأحد قبلك»","صحيح","Sahih al-Jami al-Saghir 1","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2","«آخر ما أدرك الناس من كلام النبوة الأولى: إذا لم تستح فاصنع ما شئت»","صحيح","Sahih al-Jami al-Saghir 2","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"3","«آخر من يحشر راعيان من مزينة يريدان المدينة ينعقان بغنمهما فيجدانها وحشا حتى إذا بلغا ثنية الوداع خرا على وجوههما»","صحيح","Sahih al-Jami al-Saghir 3","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"4","آخر من يدخل الجنة رجل يمشي على الصراط فهو يمشي مرة ويكبو مرة وتسفعه النار مرة, فإذا جاوزها التفت إليها فقال: تبارك الذي نجاني منك, لقد أعطاني الله شيئا ما أعطاه أحدا من الأولين والآخرين! فترفع له شجرة فيقول أي رب أدنني من هذه الشجرة فلأستظل بظلها وأشرب من مائها فيقول الله يا ابن آدم لعلي إن أعطيتكها سألتني غيرها؟ فيقول: لا يا رب ويعاهده أن لا يسأله غيرها وربه يعذره؛ لأنه يرى ما لا صبر له عليه فيدنيه منها فيستظل بظلها ويشرب من مائها, ثم ترفع له شجرة أخرى هي أحسن من الأولى, فيقول: أي رب أدنني من هذه لأشرب من مائها وأستظل بظلها لا أسألك غيرها, فيقول يا ابن آدم ألم تعاهدني ألا تسألني غيرها؟ فيقول لعلي إن أدنيتك منها تسألني غيرها؟ فيعاهده أن لا يسأله غيرها وربه يعذره لأنه يرى ما لا صبر له عليه فيدنيه منها فيستظل بظلها ويشرب من مائها, ثم ترفع له شجرة عند باب الجنة وهي أحسن من الأوليين, فيقول أي رب أدنني من هذه فلأستظل بظلها وأشرب من مائها لا أسألك غيرها فيقول: يا ابن آدم ألم تعاهدني أن لا تسألني غيرها؟ قال: بلى يا رب أدنني من هذه لا أسألك غيرها وربه يعذره لأنه يرى ما لا صبر له عليه فيدنيه منها فإذا أدناه منها سمع أصوات أهل الجنة فيقول: أي رب أدخلنيها فيقول: يا ابن آدم ما يعريني منك؟ أيرضيك أن أعطيك الدنيا ومثلها معها؟ فيقول: أي رب أتستهزئ مني وأنت رب العالمين؟ فيقول: إني لا أستهزئ منك ولكني على ما أشاء قادر","صحيح","Sahih al-Jami al-Saghir 4","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"5","«آكل الربا وموكله وكاتبه وشاهداه إذا علموا ذلك والواشمة والموشومة للحسن ولاوي الصدقة والمرتد أعرابيا بعد الهجرة ملعونون على لسان محمد يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 5","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"6","«آكل كما يأكل العبد فوا الذي نفسي بيده لو كانت الدنيا تزن عند الله جناح بعوضة ما سقى منها كافرا كأسا»","صحيح","Sahih al-Jami al-Saghir 6","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"7","«آكل كما يأكل العبد وأجلس كما يجلس العبد»","صحيح","Sahih al-Jami al-Saghir 7","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"8","«آكل كما يأكل العبد وأجلس كما يجلس العبد فإنما أنا عبد»","صحيح","Sahih al-Jami al-Saghir 8","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"9","«آالفقر تخافون؟ والذي نفسي بيده لتصبن عليكم الدنيا صبا حتى لا يزيغ قلب أحدكم إن أزاغه إلا هي, وأيم الله لقد تركتكم على مثل البيضاء ليلها ونهارها سواء»","حسن","Sahih al-Jami al-Saghir 9","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"10","«آمركم بأربع وأنهاكم عن أربع آمركم بالإيمان بالله وحده أتدرون ما الإيمان بالله وحده؟ شهادة أن لا إله إلا الله وأن محمدا رسول الله وإقام الصلاة وإيتاء الزكاة وصيام رمضان وأن تؤدوا خمس ما غنمتم وأنهاكم عن الدباء والنقير والحنتم والمزفت احفظوهن وأخبروا بهن من وراءكم»","","Sahih al-Jami al-Saghir 10","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"11","«آمركم بأربع وأنهاكم عن أربع اعبدوا الله ولا تشركوا به شيئا وأقيموا الصلاة وآتوا الزكاة وصوموا رمضان وأعطوا الخمس من الغنائم وأنهاكم عن أربع: عن الدباء والحنتم والمزفت والنقير»","","Sahih al-Jami al-Saghir 11","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"12","«آمركم بثلاث وأنهاكم عن ثلاث آمركم أن تعبدوا الله ولا تشركوا به شيئا وأن تعتصموا بحبل الله جميعا ولا تفرقوا وتسمعوا وتطيعوا لمن ولاه الله أمركم وأنهاكم عن قيل وقال وكثرة السؤال وإضاعة المال»","صحيح","Sahih al-Jami al-Saghir 12","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"13","«آمروا النساء في أنفسهن فإن الثيب تعرب عن نفسها وإذن البكر صمتها»","صحيح","Sahih al-Jami al-Saghir 13","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"14","«آمروا اليتيمة في نفسها وإذنها صماتها»","صحيح","Sahih al-Jami al-Saghir 14","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"15","«آية الإيمان حب الأنصار وآية النفاق بغض الأنصار»","صحيح","Sahih al-Jami al-Saghir 15","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"16","«آية المنافق ثلاث: إذا حدث كذب وإذا وعد أخلف وإذا ائتمن خان»","صحيح","Sahih al-Jami al-Saghir 16","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"17","«ائت حرثك أنى شئت وأطعمها إذا طعمت واكسها إذا اكتسيت ولا تقبح الوجه ولا تضرب»","حسن","Sahih al-Jami al-Saghir 17","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"18","«ائتدموا بالزيت وادهنوا به فإنه يخرج من شجرة مباركة»","حسن","Sahih al-Jami al-Saghir 18","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"19","«ائتدموا من هذه الشجرة - يعني الزيت - ومن عرض عليه طيب فليصب منه»","حسن","Sahih al-Jami al-Saghir 19","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"20","«ائتوا الدعوة إذا دعيتم»","صحيح","Sahih al-Jami al-Saghir 20","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"21","«ائذنوا للنساء أن يصلين بالليل في المسجد»","صحيح","Sahih al-Jami al-Saghir 21","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"22","«ائذنوا للنساء بالليل إلى المساجد»","صحيح","Sahih al-Jami al-Saghir 22","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"23","«أبى الله أن يجعل لقاتل المؤمن توبة»","صحيح","Sahih al-Jami al-Saghir 23","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"24","«أبى الله والمؤمنون أن يختلف عليك يا أبا بكر»","صحيح","Sahih al-Jami al-Saghir 24","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"25","«أبايعك على أن تعبد الله لا تشرك به شيئا وتقيم الصلاة المكتوبة وتؤتي الزكاة وتنصح لكل مسلم وتبرأ من الشرك»","صحيح","Sahih al-Jami al-Saghir 25","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"26","أبايعكم على أن لا تشركوا بالله شيئا ولا تسرقوا ولا تزنوا ولا تقتلوا أولادكم ولا تأتوا ببهتان تفترونه بين أيديكم وأرجلكم ولا تعصوني في معروف فمن وفى منكم فأجره على الله ومن أصاب من ذلك شيئا فأخذ به في الدنيا فهو له كفارة وطهور ومن ستره الله فذلك ¤ إلى الله عز وجل إن شاء عذبه وإن شاء غفر له","صحيح","Sahih al-Jami al-Saghir 26","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"27","«ابدأ بمن تعول»","صحيح","Sahih al-Jami al-Saghir 27","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"28","«ابدأ بنفسك فتصدق عليها فإن فضل شيء فلأهلك فإن فضل شيء عن أهلك فلذي قرابتك فإن فضل عن ذي قرابتك شيء فهكذا وهكذا»","صحيح","Sahih al-Jami al-Saghir 28","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"29","«أبردوا بالظهر»","صحيح","Sahih al-Jami al-Saghir 29","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"30","«أبردوا بالظهر فإن شدة الحر من فيح جهنم»","صحيح","Sahih al-Jami al-Saghir 30","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"31","«أبشر عمار! تقتلك الفئة الباغية»","صحيح","Sahih al-Jami al-Saghir 31","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"32","«أبشر فإن الله تعالى يقول: هي ناري أسلطها على عبدي المؤمن في الدنيا لتكون حظه من النار يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 32","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"33","«أبشروا إن من نعمة الله عليكم أنه ليس أحد من الناس يصلي هذه الساعة غيركم»","صحيح","Sahih al-Jami al-Saghir 33","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"34","«أبشروا فإن هذا القرآن طرفه بيد الله وطرفه بأيديكم فتمسكوا به فإنكم لن تهلكوا ولن تضلوا بعده أبدا»","صحيح","Sahih al-Jami al-Saghir 34","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"35","«أبشروا وبشروا من وراءكم أنه من شهد أن لا إله إلا الله صادقا بها دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 35","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"36","«أبشروا هذا ربكم قد فتح بابا من أبواب السماء يباهي بكم الملائكة يقول: انظروا إلى عبادي قد قضوا فريضة وهم ينظرون أخرى»","صحيح","Sahih al-Jami al-Saghir 36","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"37","«أبشري يا أم العلاء فإن مرض المسلم يذهب خطاياه كما تذهب النار خبث الحديد»","صحيح","Sahih al-Jami al-Saghir 37","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"38","«أبشري يا عائشة! أما الله فقد برأك»","صحيح","Sahih al-Jami al-Saghir 38","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"39","«أبغض الرجال إلى الله: الألد الخصم»","صحيح","Sahih al-Jami al-Saghir 39","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"40","«أبغض الناس إلى الله ثلاثة: ملحد في الحرم ومبتغ في الإسلام سنة الجاهلية ومطلب دم امرئ بغير حق ليهريق دمه»","صحيح","Sahih al-Jami al-Saghir 40","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"41","«ابغوني الضعفاء فإنما ترزقون وتنصرون بضعفائكم»","صحيح","Sahih al-Jami al-Saghir 41","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"42","«ابن آدم ستون وثلاثمائة مفصل على كل واحد منها في كل يوم صدقة فالكلمة الطيبة يتكلم بها الرجل صدقة وعون الرجل أخاه على الشيء صدقة والشربة من الماء يسقيها صدقة وإماطة الأذى عن الطريق صدقة»","صحيح","Sahih al-Jami al-Saghir 42","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"43","«ابن أخت القوم منهم»","صحيح","Sahih al-Jami al-Saghir 43","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"44","«ابن السبيل أول شارب يعني من زمزم»","صحيح","Sahih al-Jami al-Saghir 44","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"45","«ابنا العاص مؤمنان: هشام وعمرو»","صحيح","Sahih al-Jami al-Saghir 45","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"46","«أبن القدح عن فيك ثم تنفس»","صحيح","Sahih al-Jami al-Saghir 46","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"47","«ابناي هذان: الحسن والحسين: سيدا شباب أهل الجنة وأبوهما خير منهما»","صحيح","Sahih al-Jami al-Saghir 47","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"48","«ابن سمية ما عرض عليه أمران قط إلا اختار الأرشد منهما»","صحيح","Sahih al-Jami al-Saghir 48","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"49","«أبني! لا ترموا جمرة العقبة حتى تطلع الشمس»","صحيح","Sahih al-Jami al-Saghir 49","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"50","«أبو بكر في الجنة وعمر في الجنة وعثمان في الجنة وعلي في الجنة وطلحة في الجنة والزبير في الجنة وعبد الرحمن بن عوف في الجنة وسعد بن أبي وقاص في الجنة وسعيد بن زيد في الجنة وأبو عبيدة بن الجراح في الجنة»","صحيح","Sahih al-Jami al-Saghir 50","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"51","«أبو بكر وعمر: سيدا كهول أهل الجنة من الأولين والآخرين إلا النبيين والمرسلين»","صحيح","Sahih al-Jami al-Saghir 51","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"52","«أبو سفيان بن الحارث خير أهلي»","حسن","Sahih al-Jami al-Saghir 52","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"53","«أتاكم أهل اليمن هم أرق أفئدة وألين قلوبا الإيمان يمان والحكمة يمانية والفخر والخيلاء في أصحاب الإبل والسكينة والوقار في أهل الغنم»","صحيح","Sahih al-Jami al-Saghir 53","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"54","«أتاكم أهل اليمن هم أضعف قلوبا وأرق أفئدة الفقه يمان والحكمة يمانية»","صحيح","Sahih al-Jami al-Saghir 54","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"55","«أتاكم شهر رمضان شهر مبارك فرض الله عليكم صيامه تفتح فيه أبواب الجنة وتغلق فيه أبواب الجحيم وتغل فيه مردة الشياطين وفيه ليلة هي خير من ألف شهر من حرم خيرها فقد حرم»","صحيح","Sahih al-Jami al-Saghir 55","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"56","«أتاني آت من عند ربي فخيرني بين أن يدخل نصف أمتي الجنة وبين الشفاعة فاخترت الشفاعة وهي لمن مات لا يشرك بالله شيئا»","صحيح","Sahih al-Jami al-Saghir 56","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"57","«أتاني آت من عند ربي عز وجل فقال: من صلى عليك من أمتك صلاة كتب الله له بها عشر حسنات ومحا عنه عشر سيئات ورفع له عشر درجات ورد عليه مثلها»","صحيح","Sahih al-Jami al-Saghir 57","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"58","«أتاني الليلة آت من عند ربي فقال: صل في هذا الوادي المبارك - يعني العقيق - وقل عمرة في حجة»","صحيح","Sahih al-Jami al-Saghir 58","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"59","أتاني الليلة ربي تبارك وتعالى في أحسن صورة فقال: يا محمد هل تدري فيم يختصم الملأ الأعلى؟ قلت لا فوضع يده بين كتفي حتى وجدت بردها بين ثديي فعلمت ما في السموات وما في الأرض فقال: يا محمد هل تدري فيم يختصم الملأ الأعلى؟ قلت: نعم في الكفارات والدرجات والكفارات: المكث في المساجد بعد الصلوات والمشي على الأقدام إلى الجماعات وإسباغ الوضوء في المكاره قال: صدقت يا محمد! ومن فعل ذلك عاش بخير ومات بخير وكان من خطيئته كيوم ولدته أمه وقال: يا محمد إذا صليت فقل اللهم إني أسألك فعل الخيرات وترك المنكرات وحب المساكين وأن تغفر لي وترحمني وتتوب علي وإذا أردت بعبادك فتنة فاقبضني إليك غير مفتون والدرجات: إفشاء السلام وإطعام الطعام والصلاة بالليل والناس نيام","صحيح","Sahih al-Jami al-Saghir 59","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"60","«أتاني جبريل بالحمى والطاعون فأمسكت الحمى في المدينة وأرسلت الطاعون إلى الشام فالطاعون شهادة لأمتي ورحمة لهم ورجس على الكافرين»","صحيح","Sahih al-Jami al-Saghir 60","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"61","«أتاني جبريل فأخبرني أن أمتي ستقتل ابني هذا - يعني الحسين - وأتاني بتربة من تربتة حمراء»","صحيح","Sahih al-Jami al-Saghir 61","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"62","«أتاني جبريل فأمرني أن آمر أصحابي ومن معي أن يرفعوا أصواتهم بالتلبية»","صحيح","Sahih al-Jami al-Saghir 62","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"63","«أتاني جبريل فبشرني أن الحسن والحسين: سيدا شباب أهل الجنة»","صحيح","Sahih al-Jami al-Saghir 63","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"64","«أتاني جبريل فبشرني أنه من مات من أمتك لا يشرك بالله شيئا دخل الجنة فقلت: وإن زنى وإن سرق؟ فقال: وإن زنى وإن سرق»","صحيح","Sahih al-Jami al-Saghir 64","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"65","«أتاني جبريل فقال: إن الله يأمرك أن تقرئ أمتك القرآن على حرف فقلت: أسأل الله معافاته ومغفرته فإن أمتي لا تطيق ذلك ثم أتاني الثانية فقال: إن الله يأمرك أن تقرئ أمتك القرآن على حرفين فقلت: أسأل الله معافاته ومغفرته إن أمتي لا تطيق ذلك ثم جاءني الثالثة فقال: إن الله يأمرك أن تقرئ أمتك القرآن على ثلاثة أحرف فقلت: أسأل الله معافاته ومغفرته وإن أمتي لا تطيق ذلك ثم جاءني الرابعة فقال: إن الله عز وجل يأمرك أن تقرئ أمتك القرآن على سبعة أحرف فأيما حرف قرءوا عليه فقد أصابوا»","صحيح","Sahih al-Jami al-Saghir 65","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"66","«أتاني جبريل فقال: بشر أمتك أنه من مات لا يشرك بالله شيئا دخل الجنة قلت: يا جبريل وإن سرق وإن زنى؟ قال: نعم قلت: وإن سرق وإن زنى؟ قال: نعم قلت: وإن سرق وإن زنى؟ قال: نعم وإن شرب الخمر»","صحيح","Sahih al-Jami al-Saghir 66","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"67","«أتاني جبريل فقال لي: إن الله يأمرك أن تأمر أصحابك أن يرفعوا أصواتهم بالتلبية فإنها من شعائر الحج»","صحيح","Sahih al-Jami al-Saghir 67","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"68","أتاني جبريل فقال: إني كنت أتيتك البارحة فلم يمنعني أن أكون دخلت عليك البيت الذي كنت فيه إلا أنه كان على الباب ¤ تماثيل وكان في البيت قرام ستر فيه تماثيل وكان في البيت كلب فمر برأس التمثال الذي في البيت فليقطع فيصير كهيئة الشجرة ومر بالستر فليقطع فيجعل وسادتين منبذتين توطئان ومر بالكلب فليخرج","صحيح","Sahih al-Jami al-Saghir 68","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"69","«أتاني جبريل فقال: يا رسول الله هذه خديجة قد أتتك معها إناء فيه إدام أو طعام أو شراب فإذا هي قد أتتك فاقرأ عليها السلام من ربها ومني وبشرها ببيت في الجنة من قصب لا صخب فيها ولا نصب»","صحيح","Sahih al-Jami al-Saghir 69","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"70","«أتاني جبريل, فقال: يا محمد! اشتكيت؟ قلت: نعم, قال: بسم الله أرقيك, من كل شيء يؤذيك, من شر كل نفس, وعين حاسد, بسم الله أرقيك, والله يشفيك»","صحيح","Sahih al-Jami al-Saghir 70","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"71","«أتاني جبريل فقال: يا محمد! أما يرضيك أن ربك عز وجل يقول: إنه لا يصلي عليك من أمتك أحد صلاة إلا صليت عليه بها عشر ولا يسلم عليك أحد من أمتك تسليمة إلا سلمت عليه عشرا فقلت: بلى أي رب!»","صحيح","Sahih al-Jami al-Saghir 71","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"72","«أتاني جبريل فقال: يا محمد! إن الله عز وجل لعن الخمر وعاصرها ومعتصرها وشاربها وحاملها والمحمولة إليه وبائعها ومبتاعها وساقيها ومسقيها»","صحيح","Sahih al-Jami al-Saghir 72","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"73","«أتاني جبريل فقال: يا محمد! عش ما شئت فإنك ميت وأحبب من شئت فإنك مفارقه واعمل ما شئت فإنك مجزي به واعلم أن شرف المؤمن قيامه بالليل وعزه استغناؤه عن الناس»","حسن","Sahih al-Jami al-Saghir 73","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"74","«أتاني جبريل فقال: يا محمد! قل قلت: وما أقول؟ قال: قل أعوذ بكلمات الله التامات التي لا يجاوزهن بر ولا فاجر من شر ما خلق وذرأ وبرأ ومن شر ما ينزل من السماء ومن شر ما يعرج فيها ومن شر ما ذرأ في الأرض وبرأ ومن شر ما يخرج منها ومن شر فتن الليل والنهار ومن شر كل طارق يطرق إلا طارقا يطرق بخير يا رحمن»","صحيح","Sahih al-Jami al-Saghir 74","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"75","«أتاني جبريل فقال: يا محمد! من أدرك أحد والديه فمات فدخل النار فأبعده الله قل: آمين فقلت: آمين قال: يا محمد من أدرك شهر رمضان فمات فلم يغفر له فأدخل النار فأبعده الله قل: آمين فقلت: آمين قال: ومن ذكرت عنده فلم يصل عليك فمات فدخل النار فأبعده الله قل: آمين فقلت: آمين»","صحيح","Sahih al-Jami al-Saghir 75","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"76","أتاني جبريل في أول ما أوحي إلي فعلمني الوضوء ¤ والصلاة فلما فرغ [من] الوضوء أخذ غرفة من الماء فنضح بها فرجه","صحيح","Sahih al-Jami al-Saghir 76","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"77","«أتاني جبريل من عند الله تبارك وتعالى فقال: يا محمد! إن الله عز وجل يقول: إني قد فرضت على أمتك خمس صلوات فمن وافى بهن على وضوئهن ومواقيتهن وركوعهن وسجودهن كان له عندي بهن عهد أن ادخله بهن الجنة ومن لقيني قد انتقص من ذلك شيئا فليس له عندي عهد إن شئت عذبته وإن شئت رحمته»","صحيح","Sahih al-Jami al-Saghir 77","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"78","«أتاني جبريل وميكائيل فقعد جبريل عن يميني وميكائيل عن يساري فقال جبريل: يا محمد اقرأ القرآن على حرف فقال ميكائيل: استزده فقلت: زدني فقال: اقرأه على ثلاثة أحرف فقال ميكائيل: استزده فقلت: زدني كذلك حتى بلغ سبعة أحرف فقال: اقرأه على سبعة أحرف كلها شاف كاف»","صحيح","Sahih al-Jami al-Saghir 78","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"79","«أتاني ملك فسلم علي نزل من السماء لم ينزل قبلها فبشرني أن الحسن والحسين: سيدا شباب أهل الجنة وأن فاطمة سيدة نساء أهل الجنة»","صحيح","Sahih al-Jami al-Saghir 79","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"80","«أتحب أن يلين قلبك وتدرك حاجتك؟ ارحم اليتيم وامسح رأسه وأطعمه من طعامك يلن قلبك وتدرك حاجتك»","صحيح","Sahih al-Jami al-Saghir 80","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"81","«أتحبون أيها الناس أن تجتهدوا في الدعاء؟ قولوا: اللهم أعنا على شكرك وذكرك وحسن عبادتك»","صحيح","Sahih al-Jami al-Saghir 81","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"82","«اتخذوا الغنم فإنها بركة»","صحيح","Sahih al-Jami al-Saghir 82","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"83","«اتخذي غنما فإنها تروح بخير وتغدوا بخير»","حسن","Sahih al-Jami al-Saghir 83","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"84","«أتدرون أين تذهب هذه الشمس؟ إن هذه تجري حتى تنتهي إلى مستقرها تحت العرش فتخر ساجدة فلا تزال كذلك حتى يقال لها: ارتفعي ارجعي من حيث جئت فترجع فتصبح طالعة من مطلعها ثم تجري حتى تنتهي إلى مستقرها تحت العرش فتخر ساجدة فلا تزال كذلك حتى يقال لها: ارتفعي ارجعي من حيث جئت فترجع فتصبح طالعة من مطلعها ثم تجري لا يستنكر الناس منها شيئا حتى تنتهي إلى مستقرها ذاك تحت العرش فيقال لها: ارتفعي أصبحي طالعة من مغربك فتصبح طالعة من مغربها أتدرون متى ذاكم؟ حين {لَا يَنْفَعُ نَفْساً إِيمَانُهَا لَمْ تَكُنْ آمَنَتْ مِنْ قَبْلُ أَوْ كَسَبَتْ فِي إِيمَانِهَا خَيْراً}»","صحيح","Sahih al-Jami al-Saghir 84","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"85","«أتدرون ما العضه؟ نقل الحديث من بعض الناس إلى بعض ليفسدوا بينهم»","صحيح","Sahih al-Jami al-Saghir 85","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"86","«أتدرون ما الغيبة؟ ذكرك أخاك بما يكره إن كان فيه ما تقول فقد اغتبته وإن لم يكن فيه فقد بهته»","صحيح","Sahih al-Jami al-Saghir 86","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"87","[أتدرون ما المفلس؟ إن المفلس من أمتي من يأتي يوم القيامة بصلاة وصيام وزكاة ويأتي قد شتم هذا وقذف هذا وأكل مال هذا وسفك دم هذا وضرب هذا فيعطى هذا من حسناته وهذا من حسناته فإن فنيت حسناته قبل أن يقضى ما عليه أخذ من خطاياهم فطرحت عليه ثم طرح في النار]","صحيح","Sahih al-Jami al-Saghir 87","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"88","أتدرون ما هذان الكتابان؟ فقال للذي في يده اليمنى: هذا كتاب من رب العالمين فيه أسماء أهل الجنة وأسماء آبائهم وقبائلهم ثم أجمل على آخرهم فلا يزاد فيهم ولا ينقص منهم أبدا ثم قال للذي في شماله: هذا كتاب من رب العالمين فيه أسماء أهل النار وأسماء آبائهم وقبائلهم ثم أجمل على آخرهم فلا يزاد فيهم ولا ينقص منهم أبدا سددوا وقاربوا فإن صاحب الجنة يختم له بعمل أهل الجنة وإن عمل أي عمل وإن صاحب النار يختم له بعمل أهل النار وإن عمل أي عمل فرغ ربكم من العباد {فَرِيقٌ فِي الْجَنَّةِ وَفَرِيقٌ فِي السَّعِيرِ}","صحيح","Sahih al-Jami al-Saghir 88","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"89","«أترضون أن تكونوا ربع أهل الجنة؟ أترضون أن تكونوا ثلث أهل الجنة؟ أترضون أن تكونوا شطر أهل الجنة؟ إن الجنة لا يدخلها إلا نفس مسلمة وما أنتم في الشرك إلا كالشعرة البيضاء في جلد الثور الأسود أو كالشعرة السوداء في جلد الثور الأحمر»","صحيح","Sahih al-Jami al-Saghir 89","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"90","«اتركوا الحبشة ما تركوكم فإنه لا يستخرج كنز الكعبة إلا ذو السويقتين من الحبشة»","حسن","Sahih al-Jami al-Saghir 90","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"91","«اتركوني ما تركتكم فإذا حدثتكم فخذوا عني فإنما هلك من كان قبلكم بكثرة سؤالهم واختلافهم على أنبيائهم»","صحيح","Sahih al-Jami al-Saghir 91","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"92","«أتريد أن تكون فتانا يا معاذ؟ إذا صليت بالناس فاقرأ ب {َالشَّمْسِ وَضُحَاهَا} و {سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى} و {َاللَّيْلِ إِذَا يَغْشَى} و {اقْرَأْ بِاسْمِ رَبِّكَ} »","صحيح","Sahih al-Jami al-Saghir 92","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"93","«أتريد أن تميتها موتات؟ هلا حددت شفرتك قبل أن تضجعها»","صحيح","Sahih al-Jami al-Saghir 93","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"94","«أتزعمون أني من آخركم وفاة؟ ألا وإني من أولكم وفاة وتتبعوني أفنادا يقتل بعضكم بعضا»","صحيح","Sahih al-Jami al-Saghir 94","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"95","«أتسمعون ما أسمع؟ إني لأسمع أطيط السماء وما تلام أن تئط وما فيها موضع شبر إلا وعليه ملك ساجد أو قائم»","صحيح","Sahih al-Jami al-Saghir 95","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"96","«أتعلم؟ أول زمرة تدخل الجنة من أمتي فقراء المهاجرين يأتون يوم القيامة إلى باب الجنة ويستفتحون فيقول لهم الخزنة: أو قد حوسبتم؟ قالوا: بأي شيء نحاسب وإنما كانت أسيافنا على عواتقنا في سبيل الله حتى متنا على ذلك؟ فيفتح لهم فيقيلون فيها أربعين عاما قبل أن يدخلها الناس»","صحيح","Sahih al-Jami al-Saghir 96","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"97","«اتق الله حيثما كنت وأتبع السيئة الحسنة تمحها وخالق الناس بخلق حسن»","حسن","Sahih al-Jami al-Saghir 97","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"98","«اتق الله ولا تحقرن من المعروف شيئا ولو أن تفرغ من دلوك في إناء المستسقي وأن تلقى أخاك ووجهك إليه منبسط وإياك وإسبال الإزار فإن إسبال الإزار من المخيلة ولا يحبها الله وإن امرؤ شتمك وعيرك بأمر ليس هو فيك فلا تعيره بأمر هو فيه ودعه يكون وباله عليه وأجره لك ولا تسبن أحدا»","صحيح","Sahih al-Jami al-Saghir 98","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"99","«اتق الله يا أبا الوليد لا تأتي يوم القيامة ببعير تحمله وله رغاء أو بقرة لها خوار أو شاة لها ثؤاج»","صحيح","Sahih al-Jami al-Saghir 99","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"100","«اتق المحارم تكن أعبد الناس وارض بما قسم الله لك تكن أغنى الناس وأحسن إلى جارك تكن مؤمنا وأحب للناس ما تحب لنفسك تكن مسلما ولا تكثر الضحك فإن كثرة الضحك تميت القلب»","حسن","Sahih al-Jami al-Saghir 100","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"101","«اتقوا الظلم فإن الظلم ظلمات يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 101","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"102","«اتقوا الظلم فإن الظلم ظلمات يوم القيامة واتقوا الشح فإن الشح أهلك من كان قبلكم وحملهم على أن سفكوا دماءهم واستحلوا محارمهم»","صحيح","Sahih al-Jami al-Saghir 102","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"103","«اتقوا الله فإن أخونكم عندنا من طلب العمل»","حسن","Sahih al-Jami al-Saghir 103","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"104","«اتقوا الله في البهائم المعجمة فاركبوها صالحة وكلوها صالحة»","صحيح","Sahih al-Jami al-Saghir 104","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"105","«اتقوا الله في الصلاة وما ملكت أيمانكم»","صحيح","Sahih al-Jami al-Saghir 105","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"106","«اتقوا الله فيما ملكت أيمانكم»","صحيح","Sahih al-Jami al-Saghir 106","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"107","«اتقوا الله واعدلوا في أولادكم»","صحيح","Sahih al-Jami al-Saghir 107","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"108","«اتقوا الله وصلوا أرحامكم»","حسن","Sahih al-Jami al-Saghir 108","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"109","«اتقوا الله وصلوا خمسكم وصوموا شهركم وأدوا زكاة أموالكم طيبة بها أنفسكم وأطيعوا ذا أمركم تدخلوا جنة ربكم»","صحيح","Sahih al-Jami al-Saghir 109","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"110","«اتقوا اللاعنين: الذي يتخلى في طريق الناس أو في ظلهم»","صحيح","Sahih al-Jami al-Saghir 110","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"111","«اتقوا المجذوم كما يتقى الأسد»","صحيح","Sahih al-Jami al-Saghir 111","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"112","«اتقوا الملاعن الثلاث: البراز في الموارد وقارعة الطريق والظل»","حسن","Sahih al-Jami al-Saghir 112","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"113","«اتقوا الملاعن الثلاث: أن يقعد أحدكم في ظل يستظل فيه أو في طريق أو في نقع ماء»","حسن","Sahih al-Jami al-Saghir 113","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"114","«اتقوا النار ولو بشق تمرة»","صحيح","Sahih al-Jami al-Saghir 114","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"115","«اتقوا النار ولو بشق تمرة فإن لم تجدوا فبكلمة طيبة»","صحيح","Sahih al-Jami al-Saghir 115","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"116","«اتقوا بيتا يقال له الحمام فمن دخله فليستتر»","صحيح","Sahih al-Jami al-Saghir 116","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"117","«اتقوا دعوة المظلوم فإنها تحمل على الغمام يقول الله: وعزتي وجلالي لأنصرنك ولو بعد حين»","صحيح","Sahih al-Jami al-Saghir 117","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"118","«اتقوا دعوة المظلوم فإنها تصعد إلى السماء كأنها شرارة»","صحيح","Sahih al-Jami al-Saghir 118","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"119","«اتقوا دعوة المظلوم وإن كان كافرا فإنه ليس دونها حجاب»","حسن","Sahih al-Jami al-Saghir 119","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"120","«اتقوا هذه المذابح» - يعني المحاريب -","صحيح","Sahih al-Jami al-Saghir 120","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"121","«أتموا الركوع والسجود فوالذي نفسي بيده إني لأراكم من وراء ظهري إذا ركعتم وإذا سجدتم»","صحيح","Sahih al-Jami al-Saghir 121","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"122","«أتموا الصف المقدم ثم الذي يليه فما كان من نقص فليكن من الصف المؤخر»","صحيح","Sahih al-Jami al-Saghir 122","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"123","«أتموا الصفوف فإني أراكم خلف ظهري»","صحيح","Sahih al-Jami al-Saghir 123","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"124","«أتموا الوضوء ويل للأعقاب من النار»","صحيح","Sahih al-Jami al-Saghir 124","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"125","«أتي الله عز وجل بعبد من عباده آتاه الله مالا فقال له: ماذا عملت في الدنيا؟ فقال: ما عملت من شيء يا رب إلا أنك آتيتني مالا فكنت أبايع الناس وكان من خلقي أن أيسر على الموسر وأنظر المعسر. قال الله تعالى: أنا أحق بذلك منك تجاوزوا عن عبدي»","صحيح","Sahih al-Jami al-Saghir 125","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"126","«إتيان النساء في أدبارهن حرام»","صحيح","Sahih al-Jami al-Saghir 126","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"127","أتيت بالبراق وهو دابة أبيض طويل فوق الحمار ودون البغل يضع حافره عند منتهى طرفه فركبته حتى أتيت بيت المقدس فربطته بالحلقة التي تربط بها الأنبياء, ثم دخلت المسجد فصليت فيه ركعتين, ثم خرجت فجاءني جبريل بإناء من خمر وإناء من لبن فاخترت اللبن فقال جبريل: اخترت الفطرة, ثم عرج بنا إلى السماء فاستفتح جبريل فقيل: من أنت؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد بعث إليه؟ قال: قد بعث إليه ففتح لنا فإذا أنا بآدم فرحب بي ودعا لي بخير; ثم عرج بنا إلى السماء الثانية فاستفتح جبريل فقيل: من أنت؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد بعث إليه؟ قال: قد بعث إليه ففتح لنا فإذا أنا بابني الخالة: عيسى بن مريم ويحيى بن زكريا فرحبا بي ودعوا لي بخير, ثم عرج بنا إلى السماء الثالثة فاستفتح جبريل فقيل: من أنت؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد بعث إليه؟ قال: قد بعث إليه ففتح لنا فإذا أنا بيوسف وإذا هو قد أعطي شطر الحسن فرحب بي ودعا لي بخير, ثم عرج بنا إلى السماء الرابعة فاستفتح جبريل فقيل: من هذا؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد بعث إليه؟ قال: قد بعث إليه ففتح لنا فإذا أنا بإدريس فرحب بي ودعا لي بخير قال الله تعالى: {وَرَفَعْنَاهُ مَكَاناً عَلِيّاً} , ¤ ثم عرج بنا إلى السماء الخامسة فاستفتح جبريل فقيل: من هذا؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد بعث إليه؟ قال: قد بعث إليه ففتح لنا فإذا أنا بهارون فرحب بي ودعا لي بخير; ثم عرج بنا إلى السماء السادسة فاستفتح جبريل فقيل: من هذا؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد بعث إليه؟ قال: قد بعث إليه ففتح لنا فإذا أنا بموسى فرحب بي ودعا لي بخير, ثم عرج بنا إلى السماء السابعة فاستفتح جبريل فقيل: من هذا؟ قال: جبريل قيل: ومن معك؟ قال: محمد قيل: وقد بعث إليه؟ قال: قد بعث إليه ففتح لنا فإذا أنا بإبراهيم مسندا ظهره إلى البيت المعمور وإذا هو يدخله كل يوم سبعون ألف ملك لا يعودون إليه, ثم ذهب بي إلى سدرة المنتهى وإذا ورقها كآذان الفيلة وإذا ثمرها كالقلال فلما غشيها من أمر الله ما غشي تغيرت فما أحد من خلق الله يستطيع أن ينعتها من حسنها, فأوحى الله إلي ما أوحى ففرض علي خمسين صلاة في كل يوم وليلة; ¤ فنزلت إلى موسى فقال: ما فرض ربك على أمتك قلت: خمسين صلاة قال: ارجع إلى ربك فسله التخفيف فإن أمتك لا تطيق ذلك فإني قد بلوت بني إسرائيل وخبرتهم فرجعت إلى ربي فقلت: يا رب خفف عن أمتي فحط عني خمسا; ¤ فرجعت إلى موسى فقلت: حط عني خمسا قال: إن أمتك لا يطيقون ذلك فارجع إلى ربك فسله التخفيف, ¤ فلم أزل أرجع بين ربي وبين موسى حتى قال: يا محمد إنهن خمس ¤ صلوات كل يوم وليلة لكل صلاة عشر فذلك خمسون صلاة ومن هم بحسنة فلم يعلمها كتبت له حسنة فإن عملها كتبت له عشرا, ومن هم بسيئة فلم يعملها لم تكتب شيئا فإن عملها كتبت سيئة واحدة; فنزلت حتى انتهيت إلى موسى فأخبرته فقال: ارجع إلى ربك فسله التخفيف فقلت: قد رجعت إلى ربي حتى استحييت منه","صحيح","Sahih al-Jami al-Saghir 127","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"128","«أتيت بالبراق وهو دابة أبيض طويل يضع حافره عند منتهى طرفه فلم نزايل ظهره أنا وجبريل حتى أتيت بيت المقدس, ففتحت لي أبواب السماء ورأيت الجنة والنار»","حسن","Sahih al-Jami al-Saghir 128","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"129","«أتيت ليلة أسري بي على قوم تقرض شفاههم بمقاريض من نار كلما قرضت وفت, فقلت: يا جبريل من هؤلاء؟ قال: خطباء أمتك الذين يقولون ما لا يفعلون ويقرءون كتاب الله ولا يعملون بت»","حسن","Sahih al-Jami al-Saghir 129","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"130","«أتيت ليلة أسري بي فانطلق بي إلى زمزم فشرح عن صدري ثم غسل بماء زمزم ثم أنزل»","صحيح","Sahih al-Jami al-Saghir 130","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"131","«اثبت أحد! فإنما عليك نبي وصديق وشهيدان»","صحيح","Sahih al-Jami al-Saghir 131","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"132","«اثبت حراء! فإنما عليك نبي أو صديق أو شهيد»","صحيح","Sahih al-Jami al-Saghir 132","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"133","«أثقل الصلاة على المنافقين صلاة العشاء وصلاة الفجر ولو يعلمون ما فيهما لأتوهما ولو حبوا, ولقد هممت أن آمر بالصلاة فتقام ثم آمر رجلا فيصلي بالناس ثم أنطلق معي برجال معهم حزم من حطب إلى قوم لا يشهدون الصلاة فأحرق عليهم بيوتهم بالنار»","صحيح","Sahih al-Jami al-Saghir 133","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"134","«أثقل شيء في الميزان الخلق الحسن»","صحيح","Sahih al-Jami al-Saghir 134","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"135","«أثقل شيء في ميزان المؤمن خلق حسن إن الله يبغض الفاحش المتفحش البذي»","صحيح","Sahih al-Jami al-Saghir 135","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"136","«اثنان لا تجاوز صلاتهما رءوسهما: عبد آبق من مواليه حتى يرجع وامرأة عصت زوجها حتى ترجع»","صحيح","Sahih al-Jami al-Saghir 136","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"137","«اثنان يعجلهما الله في الدنيا: البغي وعقوق الوالدين»","صحيح","Sahih al-Jami al-Saghir 137","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"138","«اثنتان في الناس هما بهم كفر: الطعن في الأنساب والنياحة على الميت»","صحيح","Sahih al-Jami al-Saghir 138","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"139","«اثنتان يكرههما ابن آدم: يكره الموت والموت خير له من الفتنة, ويكره قلة المال وقلة المال أقل للحساب»","صحيح","Sahih al-Jami al-Saghir 139","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"140","«اثنتان تدخلان الجنة: من حفظ ما بين لحييه ورجليه دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 140","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"141","اجتمع إحدى عشرة امرأة في الجاهلية فتعاقدن أن يتصادقن بينهن ولا يكتمن من أخبار أزواجهن شيئا. فقالت الأولى: زوجي لحم جمل غث على رأس جبل, وعر لا سهل فيرتقى ولا سمين فينتقل. قالت الثانية: زوجي لا أبث خبره إني أخاف أن لا أذره إن أذكره أذكر عجره وبجره. قالت الثالثة: زوجي العشنق إن أنطق أطلق وإن أسكت أعلق. قالت الرابعة: زوجي إن أكل لف وإن شرب اشتف وإن اضطجع التف ولا يولج الكف ليعلم البث. ¤ قالت الخامسة: زوجي عياياء, طباقاء, كل داء له داء, شجك أو فلك, أو جمع كلا لك. ¤ وقالت السادسة: زوجي كليل تهامة لا حر ولا قر, ولا مخافة ولا سآمة. ¤ وقالت السابعة: زوجي إن دخل فهد وإن خرج أسد ولا يسأل عما عهد. ¤ وقالت الثامنة: زوجي المس مس أرنب والريح ريح زرنب, وأنا أغلبه والناس يغلب. ¤ قالت التاسعة: زوجي رفيع العماد طويل النجاد عظيم الرماد قريب البيت من الناد. ¤ قالت العاشرة: زوجي مالك وما مالك؟ مالك خير من ذلك, له إبل قليلات المسارح كثيرات المبارك, إذا سمعن صوت المزاهر أيقن أنهن هوالك. ¤ قالت الحادية عشرة: زوجي أبو زرع وما أبو زرع؟ أناس من حلي أذني وملأ من شحم عضدي وبجحني فبجحت إلي نفسي, وجدني في أهل غنيمة بشق, فجعلني في أهل صهيل وأطيط ودائس ومنق فعنده أقول فلا أقبح وأرقد فأتصبح, وأشرب فأتقمح أم أبي زرع وما أم أبي زرع؟ عكومها رداح وبيتها فساح, ابن أبي زرع وما ابن أبي زرع؟ مضجعه كمسل شطبة وتشبعه ذراع الجفرة, بنت أبي زرع وما بنت أبي زرع؟ طوع أبيها وطوع أمها وملء كسائها وعطف ردائها وزين أهلها وغيظ جارتها, جارية أبي زرع وما جارية أبي زرع؟ لا تبث حديثنا تبثيثا ولا تنقث ميرتنا تنقيثا ولا تملأ بيتنا تعثيثا, خرج أبو زرع والأوطاب تمخض فمر بامرأة معها ابنان لها كالفهدين يلعبان من تحت خصرها برمانتين, فطلقني ونكحها, فنكحت بعده ¤ رجلا سريا ركب شريا وأخذ خطيا وأراح علي نعما سريا وأعطاني من كل رائحة زوجا فقال: كلي أم زرع وميري أهلك فلو جمعت كل شيء أعطانيه ما ملأ أصغر إناء من آنية أبي زرع, فقال النبي صلى الله عليه وسلم: [يا عائشة! كنت لك كأبي زرع لأم زرع إلا أن أبا زرع طلق وأنا لا أطلق] . ¤ (طب) عن عائشة ورواه [خ الترمذي في الشمائل] موقوفا إلا قوله: [كنت لك كأبي زرع] فرفعاه قالوا: وهو يؤيد رفع الحديث كله","صحيح","Sahih al-Jami al-Saghir 141","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"142","«اجتمعوا على طعامكم واذكروا اسم الله يبارك لكم فيه»","حسن","Sahih al-Jami al-Saghir 142","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"143","«اجتنب الغضب»","صحيح","Sahih al-Jami al-Saghir 143","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"144","«اجتنبوا السبع الموبقات: الشرك بالله والسحر وقتل النفس التي حرم الله إلا بالحق وأكل الربا وأكل مال اليتيم والتولي يوم الزحف وقذف المحصنات المؤمنات الغافلات»","صحيح","Sahih al-Jami al-Saghir 144","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"145","«اجتنبوا الكبائر السبع: الشرك بالله وقتل النفس والفرار من الزحف وأكل مال اليتيم وأكل الربا وقذف المحصنة والتعرب بعد الهجرة»","حسن","Sahih al-Jami al-Saghir 145","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"146","«اجتنبوا الكبائر وسددوا وأبشروا»","حسن","Sahih al-Jami al-Saghir 146","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"147","«اجتنبوا كل مسكر»","صحيح","Sahih al-Jami al-Saghir 147","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"148","«اجتنبوا ما أسكر»","صحيح","Sahih al-Jami al-Saghir 148","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"149","«اجتنبوا هذه القاذورات التي نهى الله تعالى عنها فمن ألم بشيء منها فليستتر بستر الله وليتب إلى الله, فإنه من يبد لنا صفحته نقم عليه كتاب الله»","صحيح","Sahih al-Jami al-Saghir 149","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"150","«اجعل بين أذانك وإقامتك نفسا حتى يقضي المتوضئ حاجته في مهل ويفرغ الآكل من طعامه في مهل»","حسن","Sahih al-Jami al-Saghir 150","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"151","«اجعلوا آخر صلاتكم بالليل وترا»","صحيح","Sahih al-Jami al-Saghir 151","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"152","«اجعلوا بينكم وبين الحرام سترا من الحلال من فعل ذلك استبرأ لعرضه ودينه, ومن أرتع فيه كان كالمرتع إلى جنب الحمى يوشك أن يقع فيه, وإن لكل ملك حمى وإن حمى الله في الأرض محارمه»","صحيح","Sahih al-Jami al-Saghir 152","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"153","«اجعلوا بينكم وبين النار حجابا ولو بشق تمرة»","حسن","Sahih al-Jami al-Saghir 153","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"154","«اجعلوا من صلاتكم في بيوتكم ولا تتخذوها قبورا»","صحيح","Sahih al-Jami al-Saghir 154","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"155","«اجلس فقد آذيت وأنيت» - قاله للذي تخطى يوم الجمعة -","صحيح","Sahih al-Jami al-Saghir 155","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"156","«اجلس يا أبا تراب!» - قاله لعلي -","صحيح","Sahih al-Jami al-Saghir 156","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"157","«أجملوا في طلب الدنيا فإن كلا ميسر لما كتب له منها»","صحيح","Sahih al-Jami al-Saghir 157","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"158","«أجيبوا الداعي ولا تردوا الهدية ولا تضربوا المسلمين»","صحيح","Sahih al-Jami al-Saghir 158","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"159","«أجيبوا هذه الدعوة إذا دعيتم لها»","صحيح","Sahih al-Jami al-Saghir 159","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"160","«أحب الأديان إلى الله تعالى الحنيفية السمحة»","حسن","Sahih al-Jami al-Saghir 160","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"161","«أحب الأسماء إلى الله عبد الله وعبد الرحمن»","صحيح","Sahih al-Jami al-Saghir 161","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"162","«أحب الأسماء إلى الله عبد الله وعبد الرحمن والحارث»","صحيح","Sahih al-Jami al-Saghir 162","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"163","«أحب الأعمال إلى الله أدومها وإن قل»","صحيح","Sahih al-Jami al-Saghir 163","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"164","«أحب الأعمال إلى الله الصلاة لوقتها ثم بر الوالدين ثم الجهاد في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 164","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"165","«أحب الأعمال إلى الله أن تموت ولسانك رطب من ذكر الله»","حسن","Sahih al-Jami al-Saghir 165","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"166","«أحب الأعمال إلى الله إيمان بالله ثم صلة الرحم ثم الأمر بالمعروف والنهي عن المنكر وأبغض الأعمال إلى الله الإشراك بالله ثم قطيعة الرحم»","حسن","Sahih al-Jami al-Saghir 166","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"167","«أحب البلاد إلى الله مساجدها وأبغض البلاد إلى الله أسواقها»","صحيح","Sahih al-Jami al-Saghir 167","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"168","«أحب الجهاد إلى الله كلمة حق تقال لإمام جائر»","حسن","Sahih al-Jami al-Saghir 168","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"169","«أحب الحديث إلي أصدقه»","صحيح","Sahih al-Jami al-Saghir 169","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"170","«أحب الصيام إلى الله صيام داود وكان يصوم يوما ويفطر يوما وأحب الصلاة إلى الله صلاة داود كان ينام نصف الليل ويقوم ثلثه وينام سدسه»","صحيح","Sahih al-Jami al-Saghir 170","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"171","«أحب الطعام إلى الله ما كثرت عليه الأيدي»","حسن","Sahih al-Jami al-Saghir 171","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"172","«أحب العباد إلى الله تعالى أنفعهم لعياله»","حسن","Sahih al-Jami al-Saghir 172","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"173","«أحب الكلام إلى الله تعالى أربع: سبحان الله والحمد لله ولا إله إلا الله والله أكبر ولا يضرك بأيهن بدأت»","صحيح","Sahih al-Jami al-Saghir 173","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"174","«أحب الكلام إلى الله أن يقول العبد: سبحان الله وبحمده»","صحيح","Sahih al-Jami al-Saghir 174","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"175","«أحب الكلام إلى الله تعالى ما اصطفاه الله لملائكته: سبحان ربي وبحمده سبحان ربي وبحمده سبحان ربي وبحمده»","صحيح","Sahih al-Jami al-Saghir 175","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"176","«أحب الناس إلى الله أنفعهم, وأحب الأعمال إلى الله عز وجل سرور تدخله على مسلم أو تكشف عنه كربة أو تقضي عنه دينا أو تطرد عنه جوعا, ولأن أمشي مع أخي المسلم في حاجة أحب إلي من أن أعتكف في المسجد شهرا, ومن كف غضبه ستر الله عورته, ومن كظم غيظا ولو شاء أن يمضيه أمضاه ملأ الله قلبه رضا يوم القيامة, ومن مشى مع أخيه المسلم في حاجته حتى يثبتها له أثبت الله تعالى قدمه يوم تزل الأقدام, وإن سوء الخلق ليفسد العمل كما يفسد الخل العسل»","حسن","Sahih al-Jami al-Saghir 176","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"177","«أحب الناس إلي عائشة ومن الرجال أبوها»","صحيح","Sahih al-Jami al-Saghir 177","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"178","«أحبب حبيبك هونا ما عسى أن يكون بغيضك يوما ما وأبغض بغيضك هونا ما عسى أن يكون حبيبك يوما ما»","صحيح","Sahih al-Jami al-Saghir 178","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"179","«أحب عباد الله إلى الله أحسنهم خلقا»","صحيح","Sahih al-Jami al-Saghir 179","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"180","«أحب للناس ما تحب لنفسك»","صحيح","Sahih al-Jami al-Saghir 180","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"181","«احبس أصلها وسبل ثمرتها»","صحيح","Sahih al-Jami al-Saghir 181","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"182","«احبسوا صبيانكم حتى تذهب فوعة العشاء, فإنها ساعة تخترق فيها الشياطين»","صحيح","Sahih al-Jami al-Saghir 182","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"183","«احتج آدم وموسى فحج آدم موسى»","صحيح","Sahih al-Jami al-Saghir 183","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"184","«احتج آدم وموسى فقال موسى: أنت آدم الذي خلقك الله بيده ونفخ فيك من روحه وأسجد لك ملائكته وأسكنك جنته, أخرجت الناس من الجنة بذنبك وأشقيتهم! قال آدم: يا موسى أنت الذي اصطفاك الله برسالاته وبكلامه وأنزل عليك التوراة أتلومني على أمر كتبه الله على قبل أن يخلقني؟! فحج آدم موسى!»","صحيح","Sahih al-Jami al-Saghir 184","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"185","«احتجت الجنة والنار فقالت الجنة: يدخلني الضعفاء والمساكين, وقالت النار: يدخلني الجبارون والمتكبرون: فقال الله للنار: أنت عذابي أنتقم بك ممن شئت, وقال للجنة: أنت رحمتي أرحم بك من شئت ولكل واحدة منكما ملؤها»","صحيح","Sahih al-Jami al-Saghir 185","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"186","[احثوا التراب في وجوه المداحين]","صحيح","Sahih al-Jami al-Saghir 186","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"187","«احثوا في أفواه المداحين التراب»","صحيح","Sahih al-Jami al-Saghir 187","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"188","«احجج عن أبيك واعتمر»","صحيح","Sahih al-Jami al-Saghir 188","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"189","«أحد أحد»","صحيح","Sahih al-Jami al-Saghir 189","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"190","«أحد يا سعد»","صحيح","Sahih al-Jami al-Saghir 190","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"191","«أحد جبل يحبنا ونحبه»","صحيح","Sahih al-Jami al-Saghir 191","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"192","«احذروا الدنيا فإنها خضرة حلوة»","صحيح","Sahih al-Jami al-Saghir 192","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"193","«أحرج اسم عند الله يوم القيامة رجل يسمى: ملك الأملاك»","صحيح","Sahih al-Jami al-Saghir 193","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"194","«أحسن الناس قراءة: الذي إذا قرأ رأيت أنه يخشى الله»","صحيح","Sahih al-Jami al-Saghir 194","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"195","«أحسنوا إقامة الصفوف في الصلاة»","صحيح","Sahih al-Jami al-Saghir 195","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"196","«أحسنوا إلى محسن الأنصار واعفوا عن مسيئهم»","صحيح","Sahih al-Jami al-Saghir 196","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"197","«احشدوا فإني سأقرأ عليكم ثلث القرآن فقرأ: {قُلْ هُوَ اللَّهُ أَحَدٌ} , وقال: ألا إنها تعدل ثلث القرآن»","صحيح","Sahih al-Jami al-Saghir 197","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"198","«أحصوا هلال شعبان لرمضان»","حسن","Sahih al-Jami al-Saghir 198","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"199","«أحصوا هلال شعبان لرمضان ولا تخلطوا برمضان إلا أن يوافق ذلك صياما كان يصومه أحدكم, وصوموا لرؤيته وأفطروا لرؤيته فإن غم عليكم فأكملوا العدة ثلاثين يوما فإنها ليست تغمى عليكم العدة»","صحيح","Sahih al-Jami al-Saghir 199","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"200","[احضروا الجمعة وادنوا من الإمام فإن الرجل لا يزال يتباعد حتى يؤخر في الجنة وإن دخلها]","صحيح","Sahih al-Jami al-Saghir 200","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"201","«احضروا الجمعة وادنوا من الإمام فإن الرجل ليتخلف عن الجمعة حتى أنه يتخلف عن الجنة وإنه لمن أهلها»","حسن","Sahih al-Jami al-Saghir 201","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"202","«احفروا وأعمقوا وأوسعوا وادفنوا الاثنين والثلاثة في قبر واحد وقدموا أكثرهم قرآنا»","صحيح","Sahih al-Jami al-Saghir 202","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"203","«احفظ عورتك إلا من زوجتك أو ما ملكت يمينك قيل: إذا كان القوم بعضهم في بعض؟ قال: إن استطعت أن لا يرينها أحد فلا يرينها قيل: إذا كان أحدنا خاليا؟ قال: الله أحق أن يستحيا منه من الناس»","حسن","Sahih al-Jami al-Saghir 203","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"204","«احفظ لسانك»","صحيح","Sahih al-Jami al-Saghir 204","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"205","«احفظ لسانك ثكلتك أمك معاذ! وهل يكب الناس على وجوههم إلا ألسنتهم» ؟","صحيح","Sahih al-Jami al-Saghir 205","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"206","«احفظوني في أصحابي ثم الذين يلونهم ثم الذين يلونهم ثم يفشوا الكذب حتى يشهد الرجل وما يستشهد ويحلف وما يستحلف»","صحيح","Sahih al-Jami al-Saghir 206","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"207","«أحفوا الشوارب واعفوا اللحى»","صحيح","Sahih al-Jami al-Saghir 207","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"208","«أحفهما جميعا أو انعلهما جميعا وإذا لبست فابدأ باليمنى وإذا خلعت فابدأ باليسرى»","صحيح","Sahih al-Jami al-Saghir 208","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"209","«أحل الذهب والحرير لأناث أمتي وحرم على ذكورها»","صحيح","Sahih al-Jami al-Saghir 209","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"210","«أحلت لنا ميتتان ودمان فأما الميتتان: فالحوت والجراد وأما الدمان: فالكبد والطحال»","صحيح","Sahih al-Jami al-Saghir 210","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"211","«احلفوا بالله وبروا واصدقوا فإن الله يحب أن يحلف به»","صحيح","Sahih al-Jami al-Saghir 211","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"212","«احلقوه كله أو اتركوه كله»","صحيح","Sahih al-Jami al-Saghir 212","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"213","أحيانا يأتيني - يعني الوحي - في مثل صلصلة الجرس وهو أشده علي فيفصم عني وقد وعيت ما قال, وأحيانا يتمثل ¤ لي الملك رجلا فيكلمني فأعي ما يقول","صحيح","Sahih al-Jami al-Saghir 213","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"214","«أخاف على أمتي من بعدي ثلاثا: حيف الأئمة وإيمانا بالنجوم وتكذيبا بالقدر»","صحيح","Sahih al-Jami al-Saghir 214","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"215","«أخاف على أمتي من بعدي خصلتين: تكذيبا بالقدر وتصديقا بالنجوم»","صحيح","Sahih al-Jami al-Saghir 215","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"216","«أخاف عليكم ستا: إمارة السفهاء وسفك الدم وبيع الحكم وقطيعة الرحم ونشوا يتخذون القرآن مزامير وكثرة الشرط»","صحيح","Sahih al-Jami al-Saghir 216","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"217","«أخبرك بعمل إن أخذت به أدركت من كان قبلك وفت من يكون بعدك إلا أحدا أخذ بمثل ذلك, تسبح خلف كل صلاة ثلاثا وثلاثين وتكبر ثلاثا وثلاثين وتحمد أربعا وثلاثين»","صحيح","Sahih al-Jami al-Saghir 217","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"218","«أخبرني جبريل أن الحجم أنفع ما تداوى به الناس»","صحيح","Sahih al-Jami al-Saghir 218","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"219","«أخبرني جبريل أن حسينا يقتل بشاطئ الفرات»","صحيح","Sahih al-Jami al-Saghir 219","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"220","«أخبروني بشجرة شبه الرجل المسلم لا يتحات ورقها ولا ولا ولا, تؤتي أكلها كل حين؟ هي النخلة»","صحيح","Sahih al-Jami al-Saghir 220","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"221","«اختتن إبراهيم وهو ابن ثمانين سنة بالقدوم»","صحيح","Sahih al-Jami al-Saghir 221","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"222","«اختر منهن أربعا وفارق سائرهن»","صحيح","Sahih al-Jami al-Saghir 222","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"223","«أخذ الراية زيد فأصيب ثم أخذها جعفر فأصيب ثم أخذها عبد الله بن رواحة فأصيب ثم أخذها خالد عن غير إمرة ففتح الله عليه وما يسرني أنهم عندنا - أو قال - وما يسرهم أنهم عندنا»","صحيح","Sahih al-Jami al-Saghir 223","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"224","[أخذ الله عز وجل مني الميثاق كما أخذ من النبيين ميثاقهم وبشر بي عيسى ابن مريم ورأت أمي في منامها أنه خرج من بين رجليها سراج أضاءت له قصور الشام]","حسن","Sahih al-Jami al-Saghir 224","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"225","«أخذنا فألك من فيك»","صحيح","Sahih al-Jami al-Saghir 225","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"226","«أخر الكلام في القدر لشرار أمتي في آخر الزمان»","حسن","Sahih al-Jami al-Saghir 226","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"227","«أخر عني يا عمر, إني خيرت فاخترت, قد قيل لي: {اسْتَغْفِرْ لَهُمْ أَوْ لا تَسْتَغْفِرْ لَهُمْ إِنْ تَسْتَغْفِرْ لَهُمْ سَبْعِينَ مَرَّةً فَلَنْ يَغْفِرَ اللَّهُ لَهُمْ} , لو أعلم أني لو زدت على السبعين غفر له لزدت»","صحيح","Sahih al-Jami al-Saghir 227","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"228","«أخروا الأحمال فإن الأيدي مغلقة والأرجل موثقة»","صحيح","Sahih al-Jami al-Saghir 228","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"229","«اخرج فناد في الناس: من شهد أن لا إله إلا الله وجبت له الجنة»","صحيح","Sahih al-Jami al-Saghir 229","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"230","«أخرجوا المخنثين من بيوتكم»","صحيح","Sahih al-Jami al-Saghir 230","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"231","«أخرجوا المشركين من جزيرة العرب وأجيزوا الوفد بنحو ما كنت أجيزهم»","صحيح","Sahih al-Jami al-Saghir 231","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"232","«أخرجوا اليهود والنصارى من جزيرة العرب»","صحيح","Sahih al-Jami al-Saghir 232","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"233","«أخرجوا يهود الحجاز وأهل نجران من جزيرة العرب واعلموا أن شر الناس الذين اتخذوا قبور أنبيائهم مساجد»","صحيح","Sahih al-Jami al-Saghir 233","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"234","«اخرجي إليه فإنه لا يحسن الاستئذان فقولي له: فليقل: السلام عليكم أأدخل؟»","صحيح","Sahih al-Jami al-Saghir 234","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"235","«اخرجي فجذي نخلك لعلك أن تصدقي منه أو تفعلي خيرا»","صحيح","Sahih al-Jami al-Saghir 235","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"236","«اخفضي ولا تنهكي فإنه أنضر للوجه وأحظى عند الزوج»","صحيح","Sahih al-Jami al-Saghir 236","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"237","«أخنع الأسماء عند الله يوم القيامة رجل تسمى ملك الأملاك لا مالك إلا الله»","صحيح","Sahih al-Jami al-Saghir 237","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"238","«إخوانكم خولكم جعلهم الله قنية تحت أيديكم فمن كان أخوه تحت يده فليطعمه من طعامه وليلبسه من لباسه ولا يكلفه ما يغلبه فإن كلفه ما يغلبه فليعنه»","صحيح","Sahih al-Jami al-Saghir 238","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"239","«أخوف ما أخاف على أمتي كل منافق عليم اللسان»","صحيح","Sahih al-Jami al-Saghir 239","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"240","«أد الأمانة ألى من ائتمنك ولا تخن من خانك»","صحيح","Sahih al-Jami al-Saghir 240","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"241","«أدوا صاعا من بر أو قمح بين اثنين أو صاعا من تمر أو صاعا من شعير على كل حر وعبد صغير وكبير»","صحيح","Sahih al-Jami al-Saghir 241","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"242","«أدوا صاعا من طعام في الفطر»","صحيح","Sahih al-Jami al-Saghir 242","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"243","«أدخل الله الجنة رجلا كان سهلا مشتريا وبائعا وقاضيا ومقتضيا»","حسن","Sahih al-Jami al-Saghir 243","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"244","«ادع إلى ربك الذي إن مسك ضر فدعوته كشف عنك, والذي إن أضللت بأرض قفر فدعوته رد عليك, والذي إن أصابتك سنة فدعوته أنبت لك»","صحيح","Sahih al-Jami al-Saghir 244","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"245","«ادعوا الله وأنتم موقنون بالإجابة واعلموا أن الله لا يستجيب دعاء من قلب غافل لاه»","حسن","Sahih al-Jami al-Saghir 245","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"246","«ادعوا الناس وبشروا ولا تنفروا ويسروا ولا تعسروا»","صحيح","Sahih al-Jami al-Saghir 246","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"247","«ادعي أبا بكر أباك وأخاك حتى أكتب كتابا فإني أخاف أن يتمنى متمن ويقول قائل: أنا أولى ويأبى الله والمؤمنون إلا أبا بكر»","صحيح","Sahih al-Jami al-Saghir 247","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"248","«ادفعوها إلى خالتها فإن الخالة أم»","صحيح","Sahih al-Jami al-Saghir 248","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"249","«ادفنوا القتلى في مصارعهم»","صحيح","Sahih al-Jami al-Saghir 249","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"250","«أدن اليتيم منك وألطفه وامسح برأسه وأطعمه من طعامك فإن ذلك يلين قلبك ويدرك حاجتك»","حسن","Sahih al-Jami al-Saghir 250","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"251","«أدن يا بني فسم الله وكل بيمينك وكل مما يليك»","صحيح","Sahih al-Jami al-Saghir 251","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"252","«أدنى أهل النار عذابا ينتعل بنعلين من نار يغلي دماغه من حرارة نعليه»","صحيح","Sahih al-Jami al-Saghir 252","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"253","«أديموا الحج والعمرة فإنهما ينفيان الفقر والذنوب كما ينفي الكير خبث الحديد»","صحيح","Sahih al-Jami al-Saghir 253","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"254","«إذا آتاك الله مالا فلير أثر نعمة الله عليك وكرامته»","صحيح","Sahih al-Jami al-Saghir 254","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"255","«إذا آتاك الله مالا فلير عليك فإن الله يحب أن يرى أثره على عبده حسنا ولا يحب البؤس ولا التباؤس»","حسن","Sahih al-Jami al-Saghir 255","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"256","«إذا آتاك الله تعالى مالا لم تسأله ولم تشره إليه نفسك فاقبله فإنما هو رزق ساقه الله إليك»","صحيح","Sahih al-Jami al-Saghir 256","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"257","«إذا ابتعت طعاما فلا تبعه حتى تستوفيه»","صحيح","Sahih al-Jami al-Saghir 257","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"258","«إذا ابتلى الله العبد المسلم ببلاء في جسده قال الله عز وجل: أكتب له صالح عمله فإن شفاه غسله وطهره وإن قبضه غفر له ورحمه»","حسن","Sahih al-Jami al-Saghir 258","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"259","«إذا أبردتم إلي بريدا فابعثوه حسن الوجه حسن الاسم»","صحيح","Sahih al-Jami al-Saghir 259","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"260","«إذا أبق العبد لم تقبل له صلاة»","صحيح","Sahih al-Jami al-Saghir 260","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"261","«إذا أتى أحدكم الصلاة والإمام على حال فليصنع كما يصنع الإمام»","صحيح","Sahih al-Jami al-Saghir 261","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"262","«إذا أتى أحدكم الغائط فلا يستقبل القبلة ولا يولها ظهره ولكن شرقوا أو غربوا»","صحيح","Sahih al-Jami al-Saghir 262","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"263","«إذا أتى أحدكم أهله ثم أراد أن يعود فليتوضأ»","صحيح","Sahih al-Jami al-Saghir 263","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"264","إذا أتى أحدكم خادمه بطعامه قد كفاه علاجه ودخانه, ¤ فليجلسه معه فإن لم يجلسه معه فليناوله أكله أو أكلتين","صحيح","Sahih al-Jami al-Saghir 264","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"265","«إذا أتى أحدكم على ماشية فإن كان فيها صاحبها فليستأذن فإن أذن له فليحتلب وليشرب, وإن لم يكن فيها فليصوت ثلاثا فإن أجابه أحد فليستأذنه فإن لم يجبه أحد فليحتلب وليشرب ولا يحمل»","حسن","Sahih al-Jami al-Saghir 265","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"266","«إذا أتى الرجل القوم فقالوا له: مرحبا فمرحبا به يوم القيامة يوم يلقى ربه, وإذا أتى الرجل القوم فقالوا له: قحطا فقحطا له يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 266","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"267","«إذا أتاكم السائل فضعوا في يده ولو ظلفا محرقا»","صحيح","Sahih al-Jami al-Saghir 267","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"268","«إذا أتاكم المصدق فلا يصدر عنكم إلا وهو راض»","صحيح","Sahih al-Jami al-Saghir 268","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"269","«إذا أتاكم كريم قوم فأكرموه»","حسن","Sahih al-Jami al-Saghir 269","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"270","«إذا أتاكم من ترضون خلقه ودينه فزوجوه إن لا تفعلوا تكن فتنة في الأرض وفساد عريض»","حسن","Sahih al-Jami al-Saghir 270","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"271","«إذا اتسع الثوب فتعطف به على منكبيك ثم صل, وإن ضاق عن ذلك فشد به حقوك ثم صل بغير رداء»","صحيح","Sahih al-Jami al-Saghir 271","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"272","«إذا أتيت الصلاة فأتها بوقار وسكينة فصل ما أدركت واقض ما فاتك»","صحيح","Sahih al-Jami al-Saghir 272","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"273","«إذا أتيت أهلك فاعمل عملا كيسا»","صحيح","Sahih al-Jami al-Saghir 273","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"274","«إذا أتيت على راعي إبل فناد يا راعي الإبل ثلاثا فإذا أجابك, وإلا فاحلب واشرب من غير أن تفسد, وإذا أتيت على حائط فناد يا صاحب الحائط ثلاثا فإن أجابك وإلا فكل من غير أن تفسد»","صحيح","Sahih al-Jami al-Saghir 274","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"275","«إذا أتيتم الصلاة فعليكم بالسكينة ولا تأتوها وأنتم تسعون فما أدركتم فصلوا وما فاتكم فأتموا»","صحيح","Sahih al-Jami al-Saghir 275","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"276","«إذا أتيت مضجعك فتوضأ وضوئك للصلاة ثم اضطجع على شقك الأيمن ثم قل: اللهم أسلمت وجهي إليك وفوضت أمري إليك وألجأت ظهري إليك رغبة ورهبة إليك لا ملجأ ولا منجا منك إلا إليك آمنت بكتابك الذي أنزلت وبنبيك الذي أرسلت فإن مت من ليلتك فأنت على الفطرة واجعلهن آخر ما تتكلم به»","صحيح","Sahih al-Jami al-Saghir 276","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"277","«إذا أثنى عليك جيرانك أنك محسن فأنت محسن وإذا أثنى عليك جيرانك أنك مسيء فأنت مسيء»","صحيح","Sahih al-Jami al-Saghir 277","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"278","«إذا أجمرتم الميت فأجمروه ثلاثا»","صحيح","Sahih al-Jami al-Saghir 278","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"279","«إذا أحب أحدكم أخاه فليعلمه أنه يحبه»","صحيح","Sahih al-Jami al-Saghir 279","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"280","«إذا أحب أحدكم أخاه في الله فليعلمه فإنه أبقى في الألفة وأثبت في المودة»","حسن","Sahih al-Jami al-Saghir 280","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"281","«إذا أحب أحدكم صاحبه فليأته في منزله فليخبره أنه يحبه لله»","صحيح","Sahih al-Jami al-Saghir 281","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"282","«إذا أحب الله عبدا حماه في الدنيا كما يحمي أحدكم سقيمه الماء»","صحيح","Sahih al-Jami al-Saghir 282","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"283","«إذا أحب الله عبدا نادى جبريل: إن الله يحب فلانا فأحبه فيحبه جبريل فينادي جبريل في أهل السماء: إن الله يحب فلانا فأحبوه فيحبه أهل السماء ثم يوضع له القبول في الأرض»","صحيح","Sahih al-Jami al-Saghir 283","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"284","«إذا أحب الله عبدا نادى جبريل: إني قد أحببت فلانا فأحبه فينادي في السماء ثم تنزل له المحبة في الأرض فذلك قوله تعالى: {إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ سَيَجْعَلُ لَهُمُ الرَّحْمَنُ وُدّاً} » وإذا أبغض الله عبدا نادى جبريل إني أبغضت فلانا فينادي في السماء ثم تنزل له البغضاء في الأرض","صحيح","Sahih al-Jami al-Saghir 284","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"285","«إذا أحب الله قوما ابتلاهم»","صحيح","Sahih al-Jami al-Saghir 285","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"286","«إذا أحدث أحدكم في صلاته فليأخذ بأنفه ثم لينصرف»","صحيح","Sahih al-Jami al-Saghir 286","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"287","«إذا أحسن أحدكم إسلامه فكل حسنة يعملها يكتب له عشرة أمثالها إلى سبعمائة ضعف, وكل سيئة يعملها يكتب له مثلها حتى يلقى الله»","صحيح","Sahih al-Jami al-Saghir 287","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"288","«إذا اختلف البيعان فالقول قول البائع والمبتاع بالخيار»","صحيح","Sahih al-Jami al-Saghir 288","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"289","«إذا اختلف البيعان وليس بينهما بينة فهو ما يقول رب السلعة أو يتتاركان»","صحيح","Sahih al-Jami al-Saghir 289","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"290","«إذا اختلف البيعان وليس بينهما بينة والمبيع قائم بعينه فالقول ما قال البائع أو يتركان البيع»","صحيح","Sahih al-Jami al-Saghir 290","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"291","«إذا اختلفتم في الطريق فاجعلوه سبعة أذرع»","صحيح","Sahih al-Jami al-Saghir 291","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"292","«إذا أخذت مضجعك من الليل فاقرأ {قُلْ يَا أَيُّهَا الْكَافِرُونَ} ثم نم على خاتمتها فإنها براءة من الشرك»","حسن","Sahih al-Jami al-Saghir 292","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"293","«إذا أدخل أحدكم رجليه في خفيه وهما طاهرتان فليمسح عليهما ثلاثا للمسافر ويوما للمقيم»","صحيح","Sahih al-Jami al-Saghir 293","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"294","إذا أدرك أحدكم سجدة من صلاة العصر قبل أن ¤ تغرب الشمس فليتم صلاته وإذا أدرك سجدة من صلاة الصبح قبل أن تطلع الشمس فليتم صلاته","صحيح","Sahih al-Jami al-Saghir 294","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"295","«أدى العبد حق الله وحق مواليه كان له أجران»","صحيح","Sahih al-Jami al-Saghir 295","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"296","«إذا أذن ابن أم مكتوم فكلوا واشربوا وإذا أذن بلال فلا تأكلوا ولا تشربوا»","صحيح","Sahih al-Jami al-Saghir 296","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"297","«إذا أذن المؤذن فلا يخرج أحد حتى يصلي»","صحيح","Sahih al-Jami al-Saghir 297","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"298","«إذا أذنت المغرب فاحدرها مع الشمس حدرا»","صحيح","Sahih al-Jami al-Saghir 298","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"299","«إذا أراد أحدكم أن يذهب إلى الخلاء وأقيمت الصلاة فليذهب إلى الخلاء»","صحيح","Sahih al-Jami al-Saghir 299","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"300","«إذا أراد أحدكم أن يزوج ابنته فليستأمرها»","صحيح","Sahih al-Jami al-Saghir 300","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"301","«إذا أراد أحدكم من امرأته حاجته فليأتها وإن كانت على تنور»","صحيح","Sahih al-Jami al-Saghir 301","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"302","إذا أراد الله بالأمير خيرا جعل له وزير صدق إن نسي ¤ ذكره وإن ذكر أعانه وإذا أراد به غير ذلك جعل له وزير سوء إن نسي لم يذكره وإن ذكر لم يعنه","صحيح","Sahih al-Jami al-Saghir 302","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"303","«إذا أراد الله بأهل بيت خيرا أدخل عليهم الرفق»","صحيح","Sahih al-Jami al-Saghir 303","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"304","«إذا أراد الله بعبد خيرا استعمله, قيل: ما يستعمله؟ قال: يفتح له عملا صالحا بين يدي موته حتى يرضي عليه من حوله»","صحيح","Sahih al-Jami al-Saghir 304","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"305","«إذا أراد بعبد خيرا استعمله قيل: كيف يستعمله؟ قال: يوفقه لعمل صالح قبل الموت ثم يقبضه عليه»","صحيح","Sahih al-Jami al-Saghir 305","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"306","«إذا أراد الله بعبد خيرا طهره قبل موته قالوا: وما طهور العبد؟ قال: عمل صالح يلهمه إياه حتى يقبضه عليه»","صحيح","Sahih al-Jami al-Saghir 306","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"307","«إذا أراد الله بعبد خيرا عسله قيل: وما عسله؟ قال: يفتح له عملا صالحا قبل موته ثم يقبضه عليه»","صحيح","Sahih al-Jami al-Saghir 307","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"308","«إذا أراد الله بعبده الخير عجل له العقوبة في الدنيا وإذا أراد بعبده الشر أمسك عنه بذنبه حتى يوافي به يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 308","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"309","«إذا أراد الله بقوم عذابا أصاب العذاب من كان فيهم ثم بعثوا على أعمالهم»","صحيح","Sahih al-Jami al-Saghir 309","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"310","«إذا أراد الله خلق شيء لم يمنعه شيء»","صحيح","Sahih al-Jami al-Saghir 310","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"311","«إذا أراد الله قبض عبد بأرض جعل له فيها حاجة»","صحيح","Sahih al-Jami al-Saghir 311","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"312","«إذا أردت أن تبزق فلا تبزق عن يمينك ولكن عن يسارك إن كان فارغا فإن لم يكن فارغا فتحت قدمك»","صحيح","Sahih al-Jami al-Saghir 312","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"313","«إذا أرسلت كلابك المعلمة وذكرت اسم الله فكل مما أمسكن عليك وإن قتلن إلا أن يأكل الكلب فإني أخاف أن يكون إنما أمسكه على نفسه, وإن خالطها كلاب من غيرها فلا تأكل فإنك لا تدري أيها قتل, وإن رميت الصيد فوجدته بعد يوم أو يومين ليس به إلا أثر سهمك فكل, وإن وقع في الماء فلا تأكل»","صحيح","Sahih al-Jami al-Saghir 313","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"314","إذا أرسلت كلبك المعلم فقتل فكل, وإذا أكل فلا تأكل فإنما أمسك على نفسه, وإن وجدت معه كلبا آخر فلا تأكل فإنما سميت على كلبك ولم تسم على كلب آخر","صحيح","Sahih al-Jami al-Saghir 314","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"315","«إذا أرسلت كلبك المكلب وذكرت وسميت فكل ما أمسك عليك كلبك المكلب وإن قتل, وإن أرسلت كلبك الذي ليس بمكلب وأدركت ذكاته فكل وكل ما رد عليك سهمك وإن قتل وسم الله»","صحيح","Sahih al-Jami al-Saghir 315","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"316","«إذا أرسلت كلبك فاذكر اسم الله فإن أمسك عليك فأدركته حيا فاذبحه فإن أدركته قد قتله ولم يأكل منه فكله, وإن وجدت مع كلبك كلبا غيره قد قتل فلا تأكل فإنك لا تدري أيها قتله وإن رميت بسهمك فاذكر اسم الله فإن غاب عنك يوما فلم تجد فيه إلا أثر سهمك فكل إن شئت وإن وجدته غريقا في الماء فلا تأكل فإنك لا تدري الماء قتله أو سهمك؟»","صحيح","Sahih al-Jami al-Saghir 316","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"317","«إذا أسأت فأحسن»","حسن","Sahih al-Jami al-Saghir 317","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"318","«إذا استأذن أحدكم ثلاثا فلم يؤذن له فليرجع»","صحيح","Sahih al-Jami al-Saghir 318","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"319","«إذا استأذنت أحدكم امرأته إلى المسجد فلا يمنعها»","صحيح","Sahih al-Jami al-Saghir 319","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"320","«إذا استأذن على الرجل وهو يصلي فإذنه التسبيح, وإذا استأذن على المرأة وهي تصلى فإذنها التصفيق»","صحيح","Sahih al-Jami al-Saghir 320","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"321","«إذا استجمر أحدكم فليوتر»","صحيح","Sahih al-Jami al-Saghir 321","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"322","«إذا استطاب أحدكم فلا يستطب بيمينه ليستنج بشماله»","صحيح","Sahih al-Jami al-Saghir 322","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"323","«إذا استعطرت المرأة فمرت على القوم ليجدوا ريحها فهي زانية»","صحيح","Sahih al-Jami al-Saghir 323","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"324","«إذا استقبلت القبلة فكبر ثم اقرأ بأم القرآن ثم اقرأ بما شئت فإذا ركعت فاجعل راحتيك على ركبتيك وامدد ظهرك ومكن لركوعك, فإذا رفعت رأسك فأقم صلبك حتى ترجع العظام إلى مفاصلها, فإذا سجدت فمكن سجودك فإذا جلست فاجلس على فخذك اليسرى ثم اصنع كذلك في كل ركعة وسجدة»","حسن","Sahih al-Jami al-Saghir 324","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"325","«إذا استلج أحدكم في اليمين فإنه آثم له عند الله من الكفارة التي أمر بها» . واسلج كرر الأيمان وأكدها","صحيح","Sahih al-Jami al-Saghir 325","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"326","«إذا استلقى أحدكم على قفاه فلا يضع إحدى رجليه على الأخرى»","صحيح","Sahih al-Jami al-Saghir 326","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"327","«إذا استنشقت فاستنثر وإذا استجمرت فأوتر»","صحيح","Sahih al-Jami al-Saghir 327","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"328","«إذا استهل المولود ورث»","صحيح","Sahih al-Jami al-Saghir 328","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"329","«إذا استيقظ أحدكم فليقل: الحمد لله الذي رد على روحي وعافاني في جسدي وأذن لي بذكره»","حسن","Sahih al-Jami al-Saghir 329","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"330","«إذا استيقظ أحدكم من منامه فتوضأ فليستنثر ثلاث مرات فإن الشيطان يبيت على خياشيمه»","صحيح","Sahih al-Jami al-Saghir 330","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"331","«إذا استيقظ أحدكم من نومه فلا يدخل يده الإناء حتى يغسلها»","صحيح","Sahih al-Jami al-Saghir 331","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"332","«إذا استيقظ أحدكم من نومه فلا يدخل يده في الإناء حتى يغسلها ثلاثا فإن أحدكم لا يدري أين باتت يده»","صحيح","Sahih al-Jami al-Saghir 332","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"333","«إذا استيقظ الرجل من الليل وأيقظ أهله وصليا ركعتين كتبا من الذاكرين الله كثيرا والذاكرات»","صحيح","Sahih al-Jami al-Saghir 333","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"334","«إذا استيقظت فصل»","صحيح","Sahih al-Jami al-Saghir 334","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"335","«إذا أسلم الرجل فهو أحق بأرضه وماله»","حسن","Sahih al-Jami al-Saghir 335","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"336","«إذا أسلم العبد فحسن إسلامه كتب الله له كل حسنة كان أسلفها ومحيت عنه كل سيئة كان أزلفها, ثم كان بعد ذلك القصاص الحسنة بعشر أمثالها إلى سبعمائة ضعف والسيئة بمثلها إلا أن يتجاوز الله عنها»","صحيح","Sahih al-Jami al-Saghir 336","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"337","«إذا أسلم العبد فحسن إسلامه يكفر الله عنه كل سيئة كان زلفها وكان بعد ذلك القصاص الحسنة بعشر أمثالها إلى سبعمائة ضعف والسيئة بمثلها إلا أن يتجاوز الله عنها»","صحيح","Sahih al-Jami al-Saghir 337","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"338","«إذا أشار الرجل على أخيه بالسلاح فهما على جرف جهنم فإذا قتله وقعا فيه جميعا»","صحيح","Sahih al-Jami al-Saghir 338","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"339","«إذا اشتد الحر فأبردوا بالصلاة فإن شدة الحر من فيح جهنم»","صحيح","Sahih al-Jami al-Saghir 339","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"340","«إذا اشتد الحر فأبردوا بالظهر فإن شدة الحر من فيح جهنم»","صحيح","Sahih al-Jami al-Saghir 340","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"341","«إذا اشترى أحدكم الجارية فليقل: اللهم إني أسألك خيرها وخير ما جبلتها عليه وأعوذ بك من شرها وشر ما جبلتها عليه وليدع بالبركة, وإذا اشترى أحدكم بعيرا فليأخذ بذروة سنامه وليدع بالبركة وليقل مثل ذلك»","حسن","Sahih al-Jami al-Saghir 341","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"342","«إذا اشتريت مبيعا فلا تبعه حتى تقبضه»","صحيح","Sahih al-Jami al-Saghir 342","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"343","«إذا اشتكى العبد المسلم قال الله تعالى للذين يكتبون: اكتبوا له أفضل ما كان يعمل إذا كان طلقا حتى أطلقه»","صحيح","Sahih al-Jami al-Saghir 343","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"344","«إذا اشتكى المؤمن أخلصه من الذنوب كما يخلص الكير خبث الحديد»","صحيح","Sahih al-Jami al-Saghir 344","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"345","«إذا اشتكى عينيه وهو محرم ضمدهما بالصبر»","صحيح","Sahih al-Jami al-Saghir 345","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"346","«إذا اشتكيت فضع يدك حيث تشتكي ثم قل: بسم الله أعوذ بعزة الله وقدرته من شر ما أجد من وجعي هذا ثم ارفع يدك ثم أعد ذلك وترا»","صحيح","Sahih al-Jami al-Saghir 346","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"347","«إذا أصاب أحدكم مصيبة فليذكر مصيبته بي فإنها من أعظم المصائب»","صحيح","Sahih al-Jami al-Saghir 347","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"348","«إذا أصاب أحدكم هم أو لأواء فليقل: الله الله ربي لا أشرك به شيئا»","حسن","Sahih al-Jami al-Saghir 348","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"349","«إذا أصاب المكاتب حدا أو ورث ميراثا فإنه يورث على قدر ما عتق ويقام عليه بقدر ما عتق منه»","صحيح","Sahih al-Jami al-Saghir 349","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"350","«إذا أصاب ثوب إحداكن الدم من الحيضة فلتقرصه ثم لتنضحه بالماء ثم لتصلي فيه»","صحيح","Sahih al-Jami al-Saghir 350","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"351","إذا أصبح ابن آدم فإن الأعضاء كلها تكفر اللسان فتقول: اتق الله فينا فإنما نحن بك فإن استقمت استقمنا وإن ¤ اعوججت اعوججنا","حسن","Sahih al-Jami al-Saghir 351","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"352","«إذا أصبح أحدكم فليقل: أصبحنا وأصبح الملك لله رب العالمين اللهم إني أسألك خير هذا اليوم فتحه ونصره ونوره وبركته وهداه وأعوذ بك من شر ما فيه وشر ما قبله وشر ما بعده ثم إذا أمسى فليقل مثل ذلك»","حسن","Sahih al-Jami al-Saghir 352","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"353","«إذا أصبح أحدكم فليقل: اللهم بك أصبحنا وبك أمسينا وبك نحيا وبك نموت وإليك المصير، وإذا أمسى فليقل: اللهم بك أمسينا وبك أصبحنا وبك نحيا وبك نموت وإليك النشور»","حسن","Sahih al-Jami al-Saghir 353","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"354","«إذا أصبحتم فقولوا: اللهم بك أصبحنا وبك أمسينا وبك نحيا وبك نموت وإليك المصير»","صحيح","Sahih al-Jami al-Saghir 354","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"355","«إذا اصطحب رجلان مسلمان فحال بينهما شجر أو حجر أو مدر فليسلم أحدهما على الآخر ويتباذلوا السلام»","حسن","Sahih al-Jami al-Saghir 355","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"356","«إذا أطال أحدكم الغيبة فلا يطرق أهله ليلا»","صحيح","Sahih al-Jami al-Saghir 356","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"357","«إذا اطمأن الرجل إلى الرجل ثم قتله بعدما اطمأن إليه نصب له يوم القيامة لواء غدر»","صحيح","Sahih al-Jami al-Saghir 357","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"358","«إذا أعطى الله أحدكم خيرا فليبدأ بنفسه وأهل بيته»","صحيح","Sahih al-Jami al-Saghir 358","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"359","«إذا أعطيت شيئا من غير أن تسأل فكل وتصدق»","صحيح","Sahih al-Jami al-Saghir 359","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"360","«إذا أفاد أحدكم امرأة أو خادما أو دابة فليأخذ بناصيتها وليدع بالبركة وليقل: اللهم إني أسألك من خيرها وخير ما جبلت عليه وأعوذ بك من شرها وشر ما جبلت عليه وإن كان بعيرا فليأخذ بذروة سنامه»","حسن","Sahih al-Jami al-Saghir 360","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"361","«إذا أفضى أحدكم بيده إلى فرجه فليتوضأ»","صحيح","Sahih al-Jami al-Saghir 361","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"362","«إذا أفضى أحدكم بيده إلى فرجه وليس بينه وبينها حجاب ولا ستر فقد وجب عليه الوضوء»","صحيح","Sahih al-Jami al-Saghir 362","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"363","إذا أفطر أحدكم فليفطر على تمر فإنه بركة فإن لم يجد تمرا فليفطر على الماء فإنه طهور","ضعيف","Sahih al-Jami al-Saghir 363","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"364","«إذا أقبل الليل من هاهنا وأدبر النهار من هاهنا وغربت الشمس فقد أفطر الصائم»","صحيح","Sahih al-Jami al-Saghir 364","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"365","«إذا اقترب الزمان لم تكد رؤيا الرجل المسلم تكذب وأصدقهم رؤيا أصدقهم حديثا»","صحيح","Sahih al-Jami al-Saghir 365","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"366","«إذا أقعد المؤمن في قبره أتي ثم شهد أن لا إله إلا الله وأن محمد رسول الله فذلك قوله: {يُثَبِّتُ اللَّهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ} »","صحيح","Sahih al-Jami al-Saghir 366","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"367","«إذا أقيمت الصلاة فطوفي على بعيرك من وراء الناس»","صحيح","Sahih al-Jami al-Saghir 367","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"368","«إذا أقيمت الصلاة فكبر ثم اقرأ ما تيسر من القرآن ثم اركع حتى تطمئن راكعا ثم ارفع حتى تعتدل قائما ثم اسجد حتى تطمئن ساجدا ثم ارفع حتى تطمئن جالسا ثم اسجد حتى تطمئن ساجدا ثم افعل ذلك في صلاتك كلها»","صحيح","Sahih al-Jami al-Saghir 368","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"369","«إذا أقيمت الصلاة فلا تأتوها وأنتم تسعون وأتوها وأنتم تمشون وعليكم السكينة فما أدركتم فصلوا وما فاتكم فأتموا»","صحيح","Sahih al-Jami al-Saghir 369","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"370","«إذا أقيمت الصلاة فلا تقوموا حتى تروني»","صحيح","Sahih al-Jami al-Saghir 370","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"371","«إذا أقيمت الصلاة فلا صلاة إلا المكتوبة»","صحيح","Sahih al-Jami al-Saghir 371","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"372","«إذا أقيمت الصلاة وأحدكم صائم فليبدأ بالعشاء قبل صلاة المغرب ولا تعجلوا عن عشائكم»","صحيح","Sahih al-Jami al-Saghir 372","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"373","«إذا أقيمت الصلاة وأراد الرجل الخلاء فليبدأ بالخلاء»","صحيح","Sahih al-Jami al-Saghir 373","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"374","«إذا أقيمت الصلاة وحضر العشاء فابدءوا بالعشاء»","صحيح","Sahih al-Jami al-Saghir 374","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"375","«إذا اكتحل أحدكم فليكتحل وترا وإذا استجمر فليستجمر وترا»","حسن","Sahih al-Jami al-Saghir 375","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"376","«إذا أكثبوكم فارموهم بالنبل واستبقوا نبلكم»","صحيح","Sahih al-Jami al-Saghir 376","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"377","«إذا اكفر الرجل أخاه فقد باء بها أحدهما»","صحيح","Sahih al-Jami al-Saghir 377","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"378","«إذا أكل أحدكم طعاما فسقطت لقمته فليمط ما رابه منها ثم ليطعمها ولا يدعها للشيطان»","صحيح","Sahih al-Jami al-Saghir 378","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"379","«إذا أكل أحدكم طعاما فلا يمسح يده بالمنديل حتى يلعقها أو يلعقها»","صحيح","Sahih al-Jami al-Saghir 379","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"380","«إذا أكل أحدكم طعاما فليذكر اسم الله فإن نسي أن يذكر الله في أوله فليقل: بسم الله على أوله وآخره»","صحيح","Sahih al-Jami al-Saghir 380","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"381","«إذا أكل أحدكم طعاما فليقل: اللهم بارك لنا فيه وأبدلنا خيرا منه وإذا شرب لبنا فليقل: اللهم بارك لنا فيه وزدنا منه فإنه ليس شيء يجزي من الطعام والشراب إلا اللبن»","حسن","Sahih al-Jami al-Saghir 381","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"382","«إذا أكل أحدكم طعاما فليلعق أصابعه فإنه لا يدري في أي طعامه تكون البركة»","صحيح","Sahih al-Jami al-Saghir 382","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"383","إذا أكل أحدكم فليأكل بيمينه وإذا شرب فليشرب بيمينه، ¤ فإن الشيطان يأكل بشماله ويشرب بشماله","صحيح","Sahih al-Jami al-Saghir 383","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"384","«إذا أكل أحدكم فليأكل بيمينه وليشرب بيمينه وليأخذ بيمينه وليعط بيمينه فإن الشيطان يأكل بشماله ويشرب بشماله ويأخذ بشماله ويعطي بشماله»","صحيح","Sahih al-Jami al-Saghir 384","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"385","«إذا التقى الختانان فقد وجب الغسل»","صحيح","Sahih al-Jami al-Saghir 385","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"386","«إذا التقى الختانان وغابت الحشفة فقد وجب الغسل أنزل أم لم ينزل»","حسن","Sahih al-Jami al-Saghir 386","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"387","«إذا التقى المسلمان بسيفيهما فقتل أحدهما صاحبه فالقاتل والمقتول في النار قيل: يا رسول الله هذا القاتل فما بال المقتول؟ قال: إنه كان حريصا على قتل صاحبه»","صحيح","Sahih al-Jami al-Saghir 387","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"388","«إذا التقى المسلمان وحمل أحدهما على أخيه السلاح فهما على جرف جهنم فإذا قتل أحدهما صاحبه دخلاها جميعا» *","صحيح","Sahih al-Jami al-Saghir 388","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"389","«إذا ألقى الله في قلب امرئ خطبة امرأة فلا بأس أن ينظر إليها»","صحيح","Sahih al-Jami al-Saghir 389","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"390","«إذا أمذى أحدكم ولم يمسها فليغسل ذكره وأنثييه ثم ليتوضأ وليصل»","صحيح","Sahih al-Jami al-Saghir 390","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"391","«إذا أم أحدكم الناس فليخفف فإن فيهم الصغير والكبير والضعيف والمريض وذا الحاجة وإذا صلى لنفسه فليطول ما شاء»","صحيح","Sahih al-Jami al-Saghir 391","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"392","«إذا أم الرجل القوم فلا يقم في مكان أرفع من مقامهم»","صحيح","Sahih al-Jami al-Saghir 392","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"393","إذا أممت الناس: فاقرأ ب {وَالشَّمْسِ وَضُحَاهَا} و {سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى} و {وَاللَّيْلِ إِذَا يَغْشَى}","صحيح","Sahih al-Jami al-Saghir 393","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"394","«إذا أممت قوما فأخف بهم الصلاة»","صحيح","Sahih al-Jami al-Saghir 394","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"395","«إذا أمن الإمام فأمنوا فإنه من وافق تأمينه تأمين الملائكة غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 395","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"396","«إذا أمن القارئ فأمنوا فإن الملائكة تؤمن فمن وافق تأمينه تأمين الملائكة غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 396","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"397","«إذا انتصف شعبان فلا تصوموا حتى يكون رمضان»","صحيح","Sahih al-Jami al-Saghir 397","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"398","«إذا انتعل أحدكم فليبدأ باليمنى وإذا خلع فليبدأ باليسرى لتكون اليمنى أولهما تنعل وآخرهما تنزع»","صحيح","Sahih al-Jami al-Saghir 398","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"399","«إذا انتهى أحدكم إلى المجلس فإن وسع له فليجلس وإلا فلينظر إلى أوسع مكان يراه فليجلس فيه»","حسن","Sahih al-Jami al-Saghir 399","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"400","«إذا انتهى أحدكم إلى المجلس فليسلم فإن بدا له أن يجلس فليجلس ثم إذا قام فليسلم فليست الأولى أحق من الآخرة»","صحيح","Sahih al-Jami al-Saghir 400","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"401","«إذا أنزل الله بقوم عذابا أصاب العذاب من كان فيهم ثم بعثوا على أعمالهم»","صحيح","Sahih al-Jami al-Saghir 401","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"402","«إذا أنفق الرجل على أهله نفقة وهو يحتسبها كانت له صدقة»","صحيح","Sahih al-Jami al-Saghir 402","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"403","«إذا أنفقت المرأة من بيت زوجها عن غير أمره فلها نصف أجره»","صحيح","Sahih al-Jami al-Saghir 403","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"404","«إذا أنفقت المرأة من بيت زوجها غير مفسدة كان لها أجرها بما أنفقت ولزوجها أجره بما كسب وللخازن مثل ذلك لا ينقص بعضهم من أجر بعض شيئا»","صحيح","Sahih al-Jami al-Saghir 404","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"405","«إذا انقطع شسع أحدكم فلا يمش في نعل واحدة حتى يصلح شسعه ولا يمشي في خف واحد ولا يأكل بشماله ولا يحتب بالثوب الواحد ولا يلتحف الصماء»","صحيح","Sahih al-Jami al-Saghir 405","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"406","«إذا انقطع شسع نعل أحدكم فلا يمش في الأخرى حتى يصلحها»","صحيح","Sahih al-Jami al-Saghir 406","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"407","«إذا أوى أحدكم إلى فراشه فلينفضه بداخلة إزاره فإنه لا يدري ما خلفه عليه ثم ليضطجع على شقه الأيمن ثم ليقل: باسمك ربي وضعت جنبي وبك أرفعه إن أمسكت نفسي فارحمها وإن أرسلتها فاحفظها بما تحفظ به عبادك الصالحين»","صحيح","Sahih al-Jami al-Saghir 407","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"408","«إذا باتت المرأة هاجرة فراش زوجها لعنتها الملائكة حتى تصبح»","صحيح","Sahih al-Jami al-Saghir 408","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"409","«إذا باع أحدكم الشاة أو اللقحة فلا يحفلها»","صحيح","Sahih al-Jami al-Saghir 409","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"410","«إذا بال أحدكم فلا يمس ذكره بيمينه وإذا دخل الخلاء فلا يتمسح بيمينه وإذا شرب فلا يتنفس في الإناء»","صحيح","Sahih al-Jami al-Saghir 410","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"411","«إذا بايعت فقل لا خلابة»","صحيح","Sahih al-Jami al-Saghir 411","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"412","«إذا بدا حاجب الشمس فأخروا الصلاة حتى تبرز وإذا غاب حاجب الشمس فأخروا الصلاة حتى تغيب»","صحيح","Sahih al-Jami al-Saghir 412","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"413","«إذا بعثتم إلى رجلا فابعثوه حسن الوجه حسن الاسم»","صحيح","Sahih al-Jami al-Saghir 413","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"414","«إذا بلغ الرجل من أمتي ستين سنة فقد أعذر الله إليه في العمر»","صحيح","Sahih al-Jami al-Saghir 414","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"415","«إذا بلغ الله العبد ستين سنة فقد أعذر إليه وأبلغ إليه في العمر»","صحيح","Sahih al-Jami al-Saghir 415","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"416","«إذا بلغ الماء قلتين لم يحمل الخبث»","صحيح","Sahih al-Jami al-Saghir 416","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"417","«إذا بلغ الماء قلتين لم ينجسه شيء»","صحيح","Sahih al-Jami al-Saghir 417","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"418","«إذا بلغ أولادكم سبع سنين ففرقوا بين فرشهم وإذا بلغوا عشر سنين فاضربوهم على الصلاة»","صحيح","Sahih al-Jami al-Saghir 418","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"419","«إذا بلغ بنوا أبي العاص ثلاثين رجلا اتخذوا عباد الله خولا ومال الله دولا وكتاب الله دغلا»","صحيح","Sahih al-Jami al-Saghir 419","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"420","«إذا بلغت حي على الفلاح فقل: الصلاة خير من النوم»","صحيح","Sahih al-Jami al-Saghir 420","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"421","«إذا بويع خليفتان فاقتلوا الآخر منهما»","صحيح","Sahih al-Jami al-Saghir 421","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"422","«إذا تبايع الرجلان فكل واحد منها بالخيار ما لم يتفرقا وكانا جميعا أو يخير أحدهما الآخر فإن خير أحدهما الآخر فتبايعا على ذلك فقد وجب البيع وإن تفرقا بعد أن تبايعا ولم يترك واحد منهما البيع فقد وجب البيع»","صحيح","Sahih al-Jami al-Saghir 422","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"423","«إذا تبايعتم بالعينة وأخذتم أذناب البقر ورضيتم بالزرع وتركتم الجهاد سلط الله عليكم ذلا لا ينزعه حتى ترجعوا إلى دينكم»","صحيح","Sahih al-Jami al-Saghir 423","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"424","«إذا تبعتم الجنازة فلا تجلسوا حتى توضع»","صحيح","Sahih al-Jami al-Saghir 424","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"425","«إذا تثاءب أحدكم فليرده ما استطاع فإن أحدكم إذا قال: ها ضحك منه الشيطان»","صحيح","Sahih al-Jami al-Saghir 425","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"426","«إذا تثاءب أحدكم فليضع يده على فيه فإن الشيطان يدخل مع التثاؤب»","صحيح","Sahih al-Jami al-Saghir 426","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"427","«إذا تثاءب أحدكم في الصلاة فليكظم ما ستطاع فإن الشيطان يدخل»","صحيح","Sahih al-Jami al-Saghir 427","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"428","«إذا تزوج أحدكم فليقل له: بارك الله لك وبارك عليك»","صحيح","Sahih al-Jami al-Saghir 428","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"429","«إذا تزوج البكر على الثيب أقام عندها سبعا وإذا تزوج الثيب على البكر أقام عندها ثلاثا»","صحيح","Sahih al-Jami al-Saghir 429","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"430","إذا تزوج العبد فقد استكمل نصف الدين فليتق ¤ الله في النصف الباقي","حسن","Sahih al-Jami al-Saghir 430","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"431","«إذا سميتم بي فلا تكنوا بي»","صحيح","Sahih al-Jami al-Saghir 431","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"432","«إذا تشهد أحدكم فليتعوذ من أربع: من عذاب جهنم وعذاب القبر وفتنة المحيا والممات ومن شر المسيح الدجال ثم يدعو لنفسه بما بدا له»","صحيح","Sahih al-Jami al-Saghir 432","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"433","«إذا تصافح المسلمان لم تفرق أكفهما حتى يغفر لهما»","صحيح","Sahih al-Jami al-Saghir 433","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"434","«إذا تطهر الرجل ثم مر إلى المسجد يرعى الصلاة كتب له كاتبه بكل خطوة يخطوها إلى المسجد عشر حسنات والقاعد يرعى الصلاة كالقانت ويكتب من المصلين من حين يخرج من بيته حتى يرجع إليه»","صحيح","Sahih al-Jami al-Saghir 434","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"435","«إذا تقاضى إليك رجلان فلا تقض للأول حتى تسمع كلام الآخر فسوف تدري كيف تقضي»","حسن","Sahih al-Jami al-Saghir 435","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"436","«إذا تكلم الله بالوحى سمع أهل السماء الدنيا صلصلة كجر السلسلة على الصفا فيصعقون فلا يزالون كذلك حتى يأتيهم جبريل حتى إذا جاءهم جبريل فزع عن قلوبهم فيقولون: يا جبريل ماذا قال ربك؟ فيقول: الحق. فيقولون: الحق الحق»","صحيح","Sahih al-Jami al-Saghir 436","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"437","«إذا تمنى أحدكم فليكثر فإنما يسأل ربه»","صحيح","Sahih al-Jami al-Saghir 437","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"438","«إذا تنخم أحدكم فلا يتنخمن قبل وجهه ولا عن يمينه وليبصقن عن يساره أو تحت قدمه اليسرى»","صحيح","Sahih al-Jami al-Saghir 438","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"439","«إذا تنخم أحدكم وهو في المسجد فليغيب نخامته لا تصيب جلد مؤمن أو ثوبه فتؤذيه»","حسن","Sahih al-Jami al-Saghir 439","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"440","«إذا توضأ أحدكم فأحسن الوضوء ثم خرج إلى الصلاة لم يرفع قدمه اليمنى إلا كتب الله عز وجل له حسنة ولم يضع قدمه اليسرى إلا حط الله عنه سيئة فليقرب أحدكم أو ليبعد فإن أتي المسجد فصلى في جماعة غفر له فإن أتي المسجد وقد صلوا بعضا وبقي بعض صلى ما أدرك وأتم ما بقي فإن أتي المسجد وقد صلوا فأتم الصلاة كان كذلك»","صحيح","Sahih al-Jami al-Saghir 440","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"441","إذا توضأ أحدكم فأحسن الوضوء ثم خرج إلى المسجد ¤ لا ينزعه إلا الصلاة لم تزل رجله اليسرى تمحو عنه سيئة وتكتب له اليمنى حسنة حتى يدخل المسجد ولو يعلم الناس ما في العتمة والصبح لأتوهما ولو حبوا","صحيح","Sahih al-Jami al-Saghir 441","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"442","«إذا توضأ أحدكم فأحسن وضوءه ثم خرج عامدا إلى المسجد فلا يشبكن بين يديه فإنه في صلاة»","صحيح","Sahih al-Jami al-Saghir 442","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"443","«إذا توضأ أحدكم فليجعل في أنفه ماء ثم يستنثر وإذا استجمر فليوتر»","صحيح","Sahih al-Jami al-Saghir 443","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"444","«إذا توضأ أحدكم فليجعل في أنفه ماء ثم لينتثر وإذا استنثر فليستنثر وترا»","صحيح","Sahih al-Jami al-Saghir 444","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"445","«إذا توضأ أحدكم في بيته ثم أتى المسجد كان في صلاة حتى يرجع فلا يقل هكذا: وشبك بين أصابعه»","صحيح","Sahih al-Jami al-Saghir 445","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"446","«إذا توضأ أحدكم للصلاة فلا يشبك بين أصابعه»","صحيح","Sahih al-Jami al-Saghir 446","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"447","«إذا توضأ أحدكم ولبس خفيه فليصل فيهما وليمسح عليهما ثم لا يخلعهما إن شاء إلا من جنابة»","صحيح","Sahih al-Jami al-Saghir 447","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"448","«إذا توضأ الرجل المسلم خرجت خطاياه من سمعه وبصره ويديه ورجليه فإن قعد قعد مغفورا له»","حسن","Sahih al-Jami al-Saghir 448","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"449","«إذا توضأ العبد المؤمن فتمضمض خرجت الخطايا من فيه فإذا استنثر خرجت الخطايا من أنفه فإذا غسل وجهه خرجت الخطايا من وجهه حتى تخرج من تحت أشفار عينيه فإذا غسل يديه خرجت الخطايا من يديه حتى تخرج من تحت أضفار يديه فإذا مسح برأسه خرجت الخطايا من رأسه حتى تخرج من أذنيه فإذا غسل رجليه خرجت الخطايا من رجليه حتى تخرج من تحت أضفار رجليه ثم كان مشيه إلى المسجد وصلاته له نافلة»","صحيح","Sahih al-Jami al-Saghir 449","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"450","«إذا توضأ العبد المسلم أو المؤمن فغسل وجهه خرج من وجهه كل خطيئة نظر إليها بعينيه مع الماء أو مع آخر قطر الماء فإذا غسل يديه خرجت من يديه كل خطيئة كان بطشتها يداه مع الماء أو مع آخر قطر الماء فإذا غسل رجليه خرجت كل خطيئة مشتها رجلاه مع الماء أو مع آخر قطر الماء حتى يخرج نقيا من الذنوب»","صحيح","Sahih al-Jami al-Saghir 450","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"451","«إذا توضأت فانتثر وإذا استجمرت فأوتر»","صحيح","Sahih al-Jami al-Saghir 451","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"452","«إذا توضأت فخلل أصابع يديك ورجليك»","صحيح","Sahih al-Jami al-Saghir 452","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"453","«إذا توضأت فخلل الأصابع»","صحيح","Sahih al-Jami al-Saghir 453","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"454","«إذا توضأتم فابدءوا بميامنكم»","صحيح","Sahih al-Jami al-Saghir 454","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"455","«إذا توفي أحدكم فوجد شيئا فليكفن في ثوب حبرة»","صحيح","Sahih al-Jami al-Saghir 455","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"456","«إذا ثوب للصلاة فلا تأتوها وأنتم تسعون وأتوها وعليكم السكينة فما أدركتم فصلوا وما فاتكم فأتموا فإن أحدكم إذا كان يعمد إلى الصلاة فهو في صلاة»","صحيح","Sahih al-Jami al-Saghir 456","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"457","«إذا جاء أحدكم الجمعة فلا يقيمن أحدا من مقعده ثم يقعد فيه»","صحيح","Sahih al-Jami al-Saghir 457","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"458","«إذا جاء أحدكم الجمعة فليغتسل»","صحيح","Sahih al-Jami al-Saghir 458","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"459","إذا جاء أحدكم إلى الصلاة فليمش على هينة ¤ فليصل ما أدرك وليقض ما سبقه","صحيح","Sahih al-Jami al-Saghir 459","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"460","«إذا جاء أحدكم المسجد فليصل سجدتين من قبل أن يجلس ثم ليقعد بعد إن شاء أو ليذهب لحاجته»","صحيح","Sahih al-Jami al-Saghir 460","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"461","«إذا جاء أحدكم إلى المسجد فلينظر فإن رأى في نعليه قذرا أو أذى فليمسحه وليصل فيهما»","صحيح","Sahih al-Jami al-Saghir 461","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"462","«إذا جاء أحدكم إلى مجلس فأوسع له فليجلس فإنها كرامة أكرمه الله بها وأخوه المسلم فإن لم يوسع له فلينظر أوسع موضع فليجلس فيه»","حسن","Sahih al-Jami al-Saghir 462","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"463","«إذا جاء أحدكم فأوسع له أخوه فإنما هي كرامة أكرمه الله بها»","حسن","Sahih al-Jami al-Saghir 463","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"464","«إذا جاء أحدكم يوم الجمعة والإمام يخطب فليصل ركعتين وليتجوز فيهما»","صحيح","Sahih al-Jami al-Saghir 464","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"465","«إذا جاء أحد يطلب ثمن الكلب فاملأ كفه ترابا»","صحيح","Sahih al-Jami al-Saghir 465","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"466","إذا جاء الرجل يعود مريضا فليقل: اللهم اشف ¤ عبدك فلانا ينكأ لك عدوا أو يمش لك إلى الصلاة","حسن","Sahih al-Jami al-Saghir 466","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"467","«إذا جئت فصل مع الناس وإن كنت قد صليت»","صحيح","Sahih al-Jami al-Saghir 467","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"468","«إذا جئتم الصلاة ونحن سجودا فاسجدوا ولا تعدوها شيئا ومن أدرك الركعة فقد أدرك الصلاة»","صحيح","Sahih al-Jami al-Saghir 468","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"469","«إذا جاء خادم أحدكم بطعامه فليقعده معه أو ليناوله منه فإنه هو الذي ولي حره ودخانه»","صحيح","Sahih al-Jami al-Saghir 469","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"470","«إذا جاء رمضان فتحت أبواب الجنة وغلقت أبواب النار وصفدت الشياطين»","صحيح","Sahih al-Jami al-Saghir 470","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"471","«إذا جاء رمضان فتحت أبواب الرحمة وغلقت أبواب جهنم وسلسلت الشياطين»","صحيح","Sahih al-Jami al-Saghir 471","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"472","«إذا جاء رمضان فصم ثلاثين إلا أن ترى الهلال قبل ذلك»","صحيح","Sahih al-Jami al-Saghir 472","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"473","«إذا جاءك من هذا المال شيء وأنت غير مستشرف ولا سائل فخذه وما لا فلا تتبعه نفسك»","صحيح","Sahih al-Jami al-Saghir 473","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"474","«إذا جامع الرجل امرأته ثم أكسل فليغسل ما أصاب المرأة منه ثم ليتوضأ»","صحيح","Sahih al-Jami al-Saghir 474","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"475","«إذا جاوز الختان الختان فقد وجب الغسل»","صحيح","Sahih al-Jami al-Saghir 475","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"476","«إذا جعلت بين يديك مثل مؤخرة الرحل فلا يضرك من مر بين يديك»","صحيح","Sahih al-Jami al-Saghir 476","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"477","«إذا جلس أحدكم على حاجته فلا يستقبل القبلة ولا يستدبرها»","صحيح","Sahih al-Jami al-Saghir 477","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"478","«إذا جلس إليك الخصمان فسمعت من أحدهما فلا تقض لأحدهما حتى تسمع من الآخر كما سمعت من الأول فإنك إذا فعلت ذلك تبين لك القضاء»","حسن","Sahih al-Jami al-Saghir 478","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"479","إذا جلس بين شعبها الأربع ثم جهدها فقد وجب ¤ عليه الغسل وإن لم ينزل","صحيح","Sahih al-Jami al-Saghir 479","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"480","«إذا جلس بين شعبها الأربع ومس الختان الختان فقد وجب الغسل»","صحيح","Sahih al-Jami al-Saghir 480","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"481","«إذا جمرتم الميت فأوتروا»","صحيح","Sahih al-Jami al-Saghir 481","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"482","«إذا جمع الله الأولين والآخرين ليوم لا ريب فيه نادى مناد: من كان أشرك في عمل عمله لله أحدا فليطلب ثوابه من عنده فإن الله أغنى الشركاء عن الشرك»","حسن","Sahih al-Jami al-Saghir 482","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"483","«إذا جمع الله الأولين والآخرين يوم القيامة يرفع لكل غادر لواء فقيل: هذه غدرة فلان ابن فلان»","صحيح","Sahih al-Jami al-Saghir 483","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"484","«إذا حاك في نفسك شيء فدعه»","صحيح","Sahih al-Jami al-Saghir 484","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"485","إذا حج الصبي فهي له حجة حتى يعقل فإذا عقل عليه حجة أخرى وإذا حج الأعرابي فهي له حجة فإذا هاجر فعليه حجة ¤ أخرى","صحيح","Sahih al-Jami al-Saghir 485","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"486","«إذا حدث الرجل بحديث ثم التفت فهي أمانة»","حسن","Sahih al-Jami al-Saghir 486","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"487","«إذا حضر أحدكم الأمر يخشى فواته فليصل هذه الصلاة - يعني الجمع بين الصلاتين -»","حسن","Sahih al-Jami al-Saghir 487","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"488","«إذا حضر أحدكم الصلاة في مسجده فليجعل لبيته نصيبا من صلاته فإن الله جاعل في بيته من صلاته خيرا»","صحيح","Sahih al-Jami al-Saghir 488","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"489","«إذا حضر العلماء ربهم يوم القيامة كان معاذ بن جبل بين أيديهم بقذفة حجر»","صحيح","Sahih al-Jami al-Saghir 489","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"490","إذا حضر المؤمن أتته ملائكة الرحمة بحريرة بيضاء فيقولون: اخرجي راضية مرضيا عنك إلى روح وريحان ورب غير غضبان فيخرج كأطيب ريح المسك حتى إنه ليناوله بعضهم بعضا حتى يأتوا به باب السماء فيقولون: ما أطيب هذا الريح التي جاءتكم من الأرض! فيأتون به أرواح المؤمنين فلهم أشد فرحا به من أحدكم بغائبه يقدم عليه فيسألونه: ماذا فعل فلان؟ ماذا فعل فلان؟ فيقولون: دعوه فإنه كان في غم الدنيا فإذا قال: أما أتاكم؟ قالوا: ذهب به إلى أمه الهاوية، ¤ وإن الكافر إذا حضر أتته ملائكة العذاب بمسح فيقولون: اخرجي ساخطة مسخوطا عليك إلى عذاب الله فيخرج كأنتن ريح جيفة حتى يأتوا بها باب الأرض فيقولون: ما أنتن هذه الريح؟ حتى يأتوا بها أرواح الكفار","صحيح","Sahih al-Jami al-Saghir 490","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"491","«إذا حضرتم الميت فقولوا خيرا فإن الملائكة يؤمنون على ما تقولون»","صحيح","Sahih al-Jami al-Saghir 491","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"492","«إذا حضرتم موتاكم فأغمضوا البصر فإن البصر يتبع الروح وقولوا خيرا فإن الملائكة تؤمن على ما يقول أهل البيت»","حسن","Sahih al-Jami al-Saghir 492","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"493","«إذا حكم الحاكم فاجتهد فأصاب فله أجران وإذا حكم فاجتهد فأخطأ فله أجر واحد»","صحيح","Sahih al-Jami al-Saghir 493","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"494","«إذا حكمتم فاعدلوا وإذا قتلتم فأحسنوا فإن الله محسن يحب المحسنين»","حسن","Sahih al-Jami al-Saghir 494","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"495","«إذا حلف أحدكم فلا يقل ما شاء الله وشئت ولكن ليقل ما شاء الله ثم شئت»","حسن","Sahih al-Jami al-Saghir 495","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"496","«إذا حلم أحدكم فلا يحدث الناس بتلعب الشيطان في المنام»","صحيح","Sahih al-Jami al-Saghir 496","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"497","«إذا حم أحدكم فليسن عليه الماء البارد ثلاث ليال من السحر»","صحيح","Sahih al-Jami al-Saghir 497","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"498","«إذا ختنت فلا تنهكي فإن ذلك أحظى للمرأة وأحب إلى البعل»","حسن","Sahih al-Jami al-Saghir 498","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"499","«إذا خرج الرجل من بيته فقال: بسم الله توكلت على الله لا حول ولا قوة إلا بالله فيقال له: حسبك قد هديت وكفيت ووقيت فيتنحى له الشيطان فيقول له شيطان آخر: كيف لك برجل قد هدي وكفي ووقي؟»","صحيح","Sahih al-Jami al-Saghir 499","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"500","«إذا خرج ثلاثة في سفر فليؤمروا أحدهم»","صحيح","Sahih al-Jami al-Saghir 500","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"501","«إذا خرجت إحداكن إلى المسجد فلا تقربن طيبا»","صحيح","Sahih al-Jami al-Saghir 501","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"502","«إذا خرجت اللعنة من في صاحبها نظرت فإن وجدت مسلكا في الذي وجهت إليه وإلا عادت إلى الذي خرجت منه»","حسن","Sahih al-Jami al-Saghir 502","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"503","«إذا خرجت المرأة إلى المسجد فلتغتسل من الطيب كما تغتسل من الجنابة»","صحيح","Sahih al-Jami al-Saghir 503","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"504","«إذا خرجت روح العبد المؤمن تلقاها ملكان يصعدان بها - فذكر من ريح طيبها - ويقول أهل السماء: روح طيبة جاءت من قبل الأرض صلى الله عليك وعلى جسد كنت تعمرينه فينطلق به إلى ربه ثم يقول: انطلقوا به إلى آخر الأجل، وإن الكافر إذا خرجت روحه - فذكر من نتنها - ويقول أهل السماء: روح خبيثة جاءت من قبل الأرض فيقال: انطلقوا به إلى آخر الأجل»","صحيح","Sahih al-Jami al-Saghir 504","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"505","«إذا خرجت من منزلك فصل ركعتين تمنعانك مخرج السوء, وإذا دخلت إلى منزلك فصل ركعتين تمنعانك مدخل السوء»","حسن","Sahih al-Jami al-Saghir 505","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"506","«إذا خطب أحدكم المرأة فإن استطاع أن ينظر منها إلى ما يدعوه إلى نكاحها فليفعل»","حسن","Sahih al-Jami al-Saghir 506","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"507","«إذا خطب أحدكم المرأة فلا جناح عليه أن ينظر إليها إذا كان إنما ينظر إليها لخطبته وإن كانت لا تعلم»","صحيح","Sahih al-Jami al-Saghir 507","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"508","«إذا خفضت فأشمي ولا تنهكي فإنه أحسن للوجه وأرضى للزوج»","حسن","Sahih al-Jami al-Saghir 508","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"509","إذا خفضت فأشمي ولا تنهكي فإنه أسرى ¤ للوجه وأحظى عند الزوج","حسن","Sahih al-Jami al-Saghir 509","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"510","«إذا خلص المؤمنون من النار حبسوا بقنطرة بين الجنة والنار فيتقاصون مظالم كانت بينهم في الدنيا حتى إذا نقوا وهذبوا أذن لهم بدخول الجنة فوالذي نفس محمد بيده لأحدهم بمسكنه في الجنة أدل منه بمسكنه كان في الدنيا»","صحيح","Sahih al-Jami al-Saghir 510","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"511","«إذا دبغ الإهاب فقد طهر»","صحيح","Sahih al-Jami al-Saghir 511","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"512","«إذا دبغ جلد الميتة فحسبه فلينتفع به»","صحيح","Sahih al-Jami al-Saghir 512","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"513","«إذا دخل أحدكم المسجد فلا يجلس حتى يصلي ركعتين»","صحيح","Sahih al-Jami al-Saghir 513","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"514","«إذا دخل أحدكم المسجد فليسلم على النبي وليقل: اللهم افتح لي أبواب رحمتك وإذا خرج فليسلم على النبي وليقل: اللهم اعصمني من الشيطان»","صحيح","Sahih al-Jami al-Saghir 514","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"515","«إذا دخل أحدكم المسجد فليسلم على النبي وليقل: اللهم افتح لي أبواب رحمتك وإذا خرج فليسلم على النبي وليقل: اللهم إني أسألك من فضلك»","صحيح","Sahih al-Jami al-Saghir 515","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"516","«إذا دخل أحدكم المسجد فليصل على النبي صلى الله عليه وسلم وليقل: اللهم افتح لي أبواب رحمتك وإذا خرج فليسلم على النبي وليقل: اللهم إني أسألك من فضلك»","صحيح","Sahih al-Jami al-Saghir 516","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"517","«إذا دخل أحدكم إلى القوم فأوسع له فليجلس فإنما هي كرامة من الله أكرمه بها أخوه المسلم فإن لم يوسع له فلينظر أوسعها مكانا فليجلس فيه»","حسن","Sahih al-Jami al-Saghir 517","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"518","«إذا دخل أحدكم على أخيه المسلم فأطعمه من طعامه فليأكل ولا يسأل عنه وإن سقاه من شرابه فليشرب ولا يسأل عنه»","صحيح","Sahih al-Jami al-Saghir 518","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"519","«إذا دخل الرجل بيته فذكر اسم الله تعالى حين يدخل وحين يطعم قال الشيطان: لا مبيت لكم ولا عشاء هاهنا وإن دخل فلم يذكر اسم الله عند دخوله قال الشيطان: أدركتم المبيت وإن لم يذكر اسم الله عند مطعمه قال: أدركتم المبيت والعشاء»","صحيح","Sahih al-Jami al-Saghir 519","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"520","«إذا دخل العشر وأراد أحدكم أن يضحي فلا يمس من شعره ولا من بشره شيئا»","صحيح","Sahih al-Jami al-Saghir 520","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"521","«إذا دخل أهل الجنة الجنة وأهل النار النار نادى مناد: يا أهل الجنة إن لكم عند الله موعدا يريد أن ينجزكموه فيقولون: وما هو؟ ألم يثقل الله موازيننا ويبيض وجوهنا ويدخلنا الجنة وينجنا من النار؟ فيكشف الحجاب فينظرون إليه فوالله ما أعطاهم الله شيئا أحب إليهم من النظر إليه ولا أقر لأعينهم»","صحيح","Sahih al-Jami al-Saghir 521","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"522","«إذا دخل أهل الجنة الجنة وأهل النار النار يجاء بالموت كأنه كبش أملح فيوقف بين الجنة والنار فيقال: يا أهل الجنة هل تعرفون هذا؟ فيشرئبون فينظرون ويقولون: نعم هذا الموت وكلهم قد رآه, ثم ينادى: يا أهل النار هل تعرفون هذا؟ فيشرئبون فينظرون فيقولون: نعم هذا الموت وكلهم قد رآه فيؤمر به فيذبح ويقال: يا أهل الجنة خلود ولا موت ويا أهل النار خلود ولا موت»","صحيح","Sahih al-Jami al-Saghir 522","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"523","«إذا دخل أهل الجنة الجنة يقول الله تعالى: تريدون شيئا أزيدكم؟ فيقولون: ألم تبيض وجوهنا؟ ألم تدخلنا الجنة وتنجنا من النار؟ فيكشف الحجاب فما أعطوا شيئا أحب إليهم من النظر إلى ربهم»","صحيح","Sahih al-Jami al-Saghir 523","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"524","«إذا دخل أهل الجنة الجنة يقول الله عز وجل: هل تشتهون شيئا فأزيدكم؟ فيقولون: ربنا وما فوق ما أعطيتنا؟ فيقول: رضواني أكبر»","صحيح","Sahih al-Jami al-Saghir 524","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"525","إذا دخلت ليلا فلا تدخل على أهلك حتى ¤ تستحد المغيبة، وتمتشط الشعثة","صحيح","Sahih al-Jami al-Saghir 525","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"526","«إذا دخلتم بيتا فسلموا على أهله فإذا خرجتم فأودعوا أهله بسلام»","حسن","Sahih al-Jami al-Saghir 526","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"527","«إذا دخلت مسجدا فصل مع الناس وإن كنت قد صليت»","صحيح","Sahih al-Jami al-Saghir 527","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"528","«إذا دخل شهر رمضان فتحت أبواب الجنة وغلقت أبواب جهنم وسلسلت الشياطين»","صحيح","Sahih al-Jami al-Saghir 528","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"529","«إذا دعا أحدكم أخاه فليجب عرسا كان أو نحوه»","صحيح","Sahih al-Jami al-Saghir 529","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"530","«إذا دعا أحدكم فلا يقل: اللهم اغفر لي إن شئت وليعزم المسألة وليعظم الرغبة فإن الله لا يعظم عليه شيء أعطاه»","صحيح","Sahih al-Jami al-Saghir 530","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"531","«إذا دعا أحدكم فليعزم المسألة ولا يقل: اللهم إن شئت فأعطني فإن الله لا مستكره له»","صحيح","Sahih al-Jami al-Saghir 531","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"532","إذا دعا الرجل امرأته إلى فراشه فأبت فبات غضبان ¤ عليها لعنتها الملائكة حتى تصبح","صحيح","Sahih al-Jami al-Saghir 532","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"533","«إذا دعا الرجل امرأته إلى فراشه فلتجب وإن كانت على ظهر قتب»","صحيح","Sahih al-Jami al-Saghir 533","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"534","«إذا دعا الرجل زوجته لحاجته فلتأته وإن كانت على التنور»","صحيح","Sahih al-Jami al-Saghir 534","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"535","«إذا دعا الغائب لغائب قال له الملك: ولك مثل ذلك»","صحيح","Sahih al-Jami al-Saghir 535","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"536","«إذا دعي أحدكم إلى الوليمة فليأتها»","صحيح","Sahih al-Jami al-Saghir 536","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"537","«إذا دعي أحدكم إلى طعام فليجب فإن شاء طعم وإن شاء لم يطعم»","صحيح","Sahih al-Jami al-Saghir 537","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"538","«إذا دعي أحدكم إلى طعام فليجب فإن كان مفطرا فليأكل وإن كان صائما فليدع بالبركة»","صحيح","Sahih al-Jami al-Saghir 538","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"539","«إذا دعي أحدكم إلى طعام فليجب فإن كان مفطرا فليأكل وإن كان صائما فليصل»","صحيح","Sahih al-Jami al-Saghir 539","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"540","«إذا دعي أحدكم إلى طعام وهو صائم فليقل: إني صائم»","صحيح","Sahih al-Jami al-Saghir 540","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"541","«إذا دعي أحدكم إلى وليمة عرس فليجب»","صحيح","Sahih al-Jami al-Saghir 541","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"542","«إذا دعي أحدكم إلى وليمة فليجب وإن كان صائما»","صحيح","Sahih al-Jami al-Saghir 542","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"543","«إذا دعي أحدكم فجاء مع الرسول: فإن ذلك له إذن»","صحيح","Sahih al-Jami al-Saghir 543","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"544","«إذا دعيتم إلى كراع فأجيبوا»","صحيح","Sahih al-Jami al-Saghir 544","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"545","«إذا ذكر أصحابي فأمسكوا وإذا ذكرت النجوم فأمسكوا وإذا ذكر القدر فأمسكوا»","صحيح","Sahih al-Jami al-Saghir 545","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"546","«إذا ذكرتم بالله فانتهوا»","حسن","Sahih al-Jami al-Saghir 546","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"547","«إذا ذهب أحدكم إلى الغائط فليذهب معه بثلاثة أحجار يستطيب بهن فإنها تجزي عنه»","صحيح","Sahih al-Jami al-Saghir 547","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"548","«إذا رأى أحدكم الرؤيا الحسنة فليفسرها وليخبر بها وإذا رأى الرؤيا القبيحة فلا يفسرها ولا يخبر بها»","صحيح","Sahih al-Jami al-Saghir 548","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"549","«إذا رأى أحدكم الرؤيا يحبها فإنما هي من الله فليحمد الله عليها وليحدث بها وإذا رأى غير ذلك مما يكره فإنما هي من الشيطان فليستعذ بالله ولا يذكرها لأحد فإنها لا تضره»","صحيح","Sahih al-Jami al-Saghir 549","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"550","«إذا رأى أحدكم الرؤيا يحبها فإنما هي من الله فليحمد الله عليها وليحدث بها، وإذا رأى غير ذلك مما يكره فإنما هي من الشيطان فليستعذ بالله من شرها ولا يذكرها لأحد فإنها لا تضره»","صحيح","Sahih al-Jami al-Saghir 550","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"551","«إذا رأى أحدكم الرؤيا يكرهها فليبصق عن يساره ثلاثا وليستعذ بالله من الشيطان ثلاثا وليتحول عن جنبه الذي كان عليه»","صحيح","Sahih al-Jami al-Saghir 551","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"552","«إذا رأى أحدكم المرأة التي تعجبه فليرجع إلى أهله حتى يقع بهم فإن ذلك معهم»","صحيح","Sahih al-Jami al-Saghir 552","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"553","«إذا رأى أحدكم جنازة فإن لم يكن ماشيا معها فليقم حتى يخلفها أو تخلفه أو توضع من قبل أن تخلفه»","صحيح","Sahih al-Jami al-Saghir 553","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"554","«إذا رأى أحدكم رؤيا يكرهها فليتحول وليتفل عن يساره ثلاثا وليسأل الله من خيرها وليتعوذ بالله من شرها»","صحيح","Sahih al-Jami al-Saghir 554","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"555","«إذا رأى أحدكم مبتلى فقال: الحمد لله الذي عافاني مما ابتلاك به وفضلني عليك وعلى كثير من عباده تفضيلا، كان شكر تلك النعمة»","حسن","Sahih al-Jami al-Saghir 555","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"556","«إذا رأى أحدكم من نفسه أو ماله أو من أخيه ما يعجبه فليدع له بالبركة فإن العين حق»","صحيح","Sahih al-Jami al-Saghir 556","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"557","«إذا رأى المؤمن ما فسح له في قبره فيقول: دعوني أبشر أهلي فيقال له: اسكن»","صحيح","Sahih al-Jami al-Saghir 557","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"558","«إذا رأت فأنزلت فعليها الغسل»","صحيح","Sahih al-Jami al-Saghir 558","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"559","«إذا راح أحدكم إلى الجمعة فليغتسل»","صحيح","Sahih al-Jami al-Saghir 559","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"560","«إذا رأيت الأمة ولدت ربتها ورأيت أصحاب البنيان يتطاولون بالبنيان ورأيت الحفاة الجياع العالة كانوا رءوس الناس فذلك من معالم الساعة وأشراطها»","صحيح","Sahih al-Jami al-Saghir 560","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"561","«إذا رأيت الله تعالى يعطي العبد من الدنيا ما يحب وهو مقيم على معاصيه فإنما ذلك منه استدراج»","صحيح","Sahih al-Jami al-Saghir 561","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"562","«إذا رأيت المذي فاغسل ذكرك وتوضأ وضوءك للصلاة وإذا نضحت الماء فاغتسل»","صحيح","Sahih al-Jami al-Saghir 562","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"563","«إذا رأيت الناس قد مرجت عهودهم وخفت أماناتهم وكانوا هكذا - وشبك بين أنامله - فالزم بيتك واملك عليك لسانك وخذ ما تعرف ودع ما تنكر، وعليك بخاصة أمر نفسك ودع عنك أمر العامة»","صحيح","Sahih al-Jami al-Saghir 563","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"564","«إذا رأيتم آية فاسجدوا»","حسن","Sahih al-Jami al-Saghir 564","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"565","«إذا رأيتم الجنازة فقوموا فمن تبعها فلا يقعد حتى توضع»","صحيح","Sahih al-Jami al-Saghir 565","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"566","«إذا رأيتم الجنازة فقوموا لها حتى تخلفكم أو توضع»","صحيح","Sahih al-Jami al-Saghir 566","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"567","«إذا رأيتم الرجل يتعزى بعزاء الجاهلية، فأعضوه بهن أبيه ولا تكنوا»","صحيح","Sahih al-Jami al-Saghir 567","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"568","«إذا رأيتم الليل قد أقبل من هاهنا فقد أفطر الصائم»","صحيح","Sahih al-Jami al-Saghir 568","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"569","[إذا رأيتم المداحين فاحثوا في وجوههم التراب]","صحيح","Sahih al-Jami al-Saghir 569","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"570","«إذا رأيتم الناس قد مرجت عهودهم وخفت أماناتهم وكانوا هكذا - وشبك بين أصابعه - فالزم بيتك واملك عليك لسانك وخذ بما تعرفه ودع ما تنكر وعليك بأمر خاصة نفسك ودع عنك أمر العامة»","صحيح","Sahih al-Jami al-Saghir 570","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"571","«إذا رأيتم الهلال فصوموا وإذا رأيتموه فأفطروا فإن غم عليكم فاقدروا له»","صحيح","Sahih al-Jami al-Saghir 571","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"572","«إذا رأيتم الهلال فصوموا وإذا رأيتموه فأفطروا فإن أغمي عليكم فعدوا ثلاثين يوما»","صحيح","Sahih al-Jami al-Saghir 572","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"573","«إذا رأيتم من يبيع أو يبتاع في المسجد فقولوا: لا أربح الله تجارتك وإذا رأيتم من ينشد فيه ضالة فقولوا: لا رد الله عليك ضالتك»","صحيح","Sahih al-Jami al-Saghir 573","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"574","إذا رأيتم هلال ذي الحجة وأراد أحدكم أن يضحي ¤ فليمسك عن شعره وأظفاره","صحيح","Sahih al-Jami al-Saghir 574","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"575","«إذا رأيتني على مثل هذه الحالة - يعني البول - فلا تسلم علي فإنك إن فعلت ذلك لم أرد عليك»","صحيح","Sahih al-Jami al-Saghir 575","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"576","«إذا ركبتم هذه البهائم العجم فانجوا عليها فإذا كانت سنة فانجوا وعليكم بالدلجة فإنما يطويها الله»","صحيح","Sahih al-Jami al-Saghir 576","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"577","«إذا ركعت فضع كفيك على ركبتيك حتى تطمئن وإذا سجدت فأمكن جبهتك من الأرض حتى تجد حجم الأرض»","حسن","Sahih al-Jami al-Saghir 577","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"578","«إذا رمى أحدكم جمرة العقبة فقد حل له كل شيء إلا النساء»","صحيح","Sahih al-Jami al-Saghir 578","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"579","«إذا رميت الصيد فأدركته بعد ثلاث ليال وسهمك فيه فكله ما لم ينتن»","صحيح","Sahih al-Jami al-Saghir 579","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"580","«إذا رميت بالمعراض الصيد فخرق فكله وإن أصابه بعرضه فلا تأكله فإنه وقيذ»","صحيح","Sahih al-Jami al-Saghir 580","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"581","«إذا رميت بسهمك وغاب ثلاثة أيام وأدركته فكله ما لم ينتن»","صحيح","Sahih al-Jami al-Saghir 581","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"582","«إذا رويت أهلك من اللبن غبوقا فاجتنب ما نهى الله عنه من ميتة»","صحيح","Sahih al-Jami al-Saghir 582","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"583","«إذا زار أحدكم أخاه فجلس عنده فلا يقومن حتى يستأذنه»","صحيح","Sahih al-Jami al-Saghir 583","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"584","«إذا زار أحدكم قوما فلا يصل بهم وليصل بهم رجل منهم»","صحيح","Sahih al-Jami al-Saghir 584","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"585","«إذا زخرفتم مساجدكم وحليتم مصاحفكم فالدمار عليكم»","حسن","Sahih al-Jami al-Saghir 585","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"586","«إذا زنى العبد خرج منه الإيمان فكان على رأسه كالظلة فإذا أقلع رجع إليه»","صحيح","Sahih al-Jami al-Saghir 586","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"587","«إذا زنت أمة أحدكم فتبين زناها فليجلدها ولا يثرب، ثم إن زنت فليجلدها ولا يثرب، ثم إن زنت الثالثة فليبعها ولو بحبل من شعر»","صحيح","Sahih al-Jami al-Saghir 587","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"588","«إذا سافرتما فأذنا وأقيما وليؤمكما أكبركما»","صحيح","Sahih al-Jami al-Saghir 588","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"589","«إذا سافرتم في الخصب فأعطوا الإبل حظها من الأرض وإذا سافرتم في السنة فأسرعوا عليها السير وإذا عرستم بالليل فاجتنبوا الطريق فإنها طرق الدواب ومأوى الهوام بالليل»","صحيح","Sahih al-Jami al-Saghir 589","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"590","«إذا ساق الله إليك رزقا من غير مسألة ولا إشراف نفس فخذه فإن الله أعطاكه»","صحيح","Sahih al-Jami al-Saghir 590","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"591","«إذا سأل أحدكم فليكثر فإنما يسأل ربه»","صحيح","Sahih al-Jami al-Saghir 591","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"592","«إذا سألتم الله تعالى فاسألوه الفردوس فإنه سر الجنة»","صحيح","Sahih al-Jami al-Saghir 592","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"593","«إذا سألتم الله تعالى فاسألوه ببطون أكفكم ولا تسألوه بظهورها»","صحيح","Sahih al-Jami al-Saghir 593","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"594","«إذا سبك رجل بما يعلم منك فلا تسبه بما تعلم منه فيكون أجر ذلك لك ووباله عليه»","صحيح","Sahih al-Jami al-Saghir 594","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"595","«إذا سجد أحدكم فلا يبرك كما يبرك البعير وليضع يديه قبل ركبتيه»","صحيح","Sahih al-Jami al-Saghir 595","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"596","«إذا سجد أحدكم فليعتدل ولا يفترش ذراعيه افتراش الكلب»","صحيح","Sahih al-Jami al-Saghir 596","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"597","«إذا سجد العبد سجد معه سبعة آراب: وجهه وكفاه وركبتاه وقدماه»","صحيح","Sahih al-Jami al-Saghir 597","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"598","«إذا سجدت فضع كفيك وارفع مرفقيك»","صحيح","Sahih al-Jami al-Saghir 598","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"599","«إذا سرتم في أرض خصبة فأعطوا الدواب حظها وإذا سرتم في أرض مجدبة فانجوا عليها وإذا عرستم فلا تعرسوا على قارعة الطريق فإنها مأوى كل دابة»","صحيح","Sahih al-Jami al-Saghir 599","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"600","«إذا سرتك حسنتك وساءتك سيئتك فأنت مؤمن»","صحيح","Sahih al-Jami al-Saghir 600","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"601","«إذا سقطت لقمة أحدكم فليمط عنها الأذى وليأكلها ولا يدعها للشيطان وليسلت أحدكم الصحفة فإنكم لا تدرون في أي طعامكم تكون البركة»","صحيح","Sahih al-Jami al-Saghir 601","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"602","«إذا سقطت لقمة أحدكم فليمط ما بها من الأذى وليأكلها ولا يدعها للشيطان ولا يمسح يده بالمنديل حتى يلعقها أو يلعقها فإنه لا يدري في أي طعامه البركة»","صحيح","Sahih al-Jami al-Saghir 602","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"603","«إذا سكر أحدكم فاجلدوه ثم إن سكر فاجلدوه ثم إن سكر فاجلدوه فإن عاد الرابعة فاقتلوه»","صحيح","Sahih al-Jami al-Saghir 603","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"604","«إذا سل أحدكم سيفا لينظر إليه فأراد أن يناوله أخاه فليغمده ثم يناوله إياه»","حسن","Sahih al-Jami al-Saghir 604","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"605","«إذا سلم عليكم أحدا من أهل الكتاب فقولوا: وعليكم»","صحيح","Sahih al-Jami al-Saghir 605","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"606","«إذا سلم عليكم اليهود فإنما يقول أحدهم: السام عليك فقل: وعليك»","صحيح","Sahih al-Jami al-Saghir 606","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"607","«إذا سمع أحدكم النداء والإناء على يده فلا يضعه حتى يقضي حاجته منه»","صحيح","Sahih al-Jami al-Saghir 607","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"608","«إذا سمعت الرجل يقول: هلك الناس فهو أهلكهم»","صحيح","Sahih al-Jami al-Saghir 608","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"609","«إذا سمعت النداء فأجب داعي الله»","صحيح","Sahih al-Jami al-Saghir 609","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"610","«إذا سمعت جيرانك يقولون: قد أحسنت فقد أحسنت وإذا سمعتهم يقولون: قد أسأت فقد أسأت»","صحيح","Sahih al-Jami al-Saghir 610","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"611","«إذا سمعتم أصوات الديكة فسلوا الله من فضله فإنها رأت ملكا وإذا سمعتم نهيق الحمير فتعوذوا بالله من الشيطان فإنها رأت شيطانا»","صحيح","Sahih al-Jami al-Saghir 611","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"612","«إذا سمعتم الحديث عني تعرفه قلوبكم وتلين له أشعاركم وأبشاركم وترون أنه منكم قريب فأنا أولاكم به، وإذا سمعتم الحديث عني تنكره قلوبكم وتنفر منه أشعاركم وأبشاركم وترون أنه بعيد منكم فأنا أبعدكم منه»","حسن","Sahih al-Jami al-Saghir 612","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"613","«إذا سمعتم المؤذن فقولوا مثل ما يقول ثم صلوا علي فإنه من صلى علي صلاة صلى الله عليه بها عشرا ثم سلوا الله لي الوسيلة فإنها منزلة في الجنة لا تنبغي إلا لعبد من عباد الله وأرجوا أن أكون أنا هو فمن سأل لي الوسيلة حلت عليه الشفاعة»","صحيح","Sahih al-Jami al-Saghir 613","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"614","«إذا سمعتم المؤذن يثوب بالصلاة فقولوا كما يقول»","حسن","Sahih al-Jami al-Saghir 614","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"615","«إذا سمعتم النداء فقولوا مثل ما يقول المؤذن»","صحيح","Sahih al-Jami al-Saghir 615","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"616","«إذا سمعتم بالطاعون بأرض فلا تدخلوا عليه وإذا وقع وأنتم بأرض فلا تخرجوا فرارا منه»","صحيح","Sahih al-Jami al-Saghir 616","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"617","«إذا سمعتم بالطاعون بأرض فلا تدخلوا عليه وإذا وقع وأنتم بأرض فلا تخرجوا منها فرارا منه»","صحيح","Sahih al-Jami al-Saghir 617","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"618","«إذا سمعتم بقوم قد خسف فيهم هاهنا قريبا فقد أظلت الساعة»","حسن","Sahih al-Jami al-Saghir 618","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"619","«إذا سمعتم من يعتزي بعزاء الجاهلية فأعضوه ولا تكنوا»","صحيح","Sahih al-Jami al-Saghir 619","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"620","«إذا سمعتم نباح الكلاب ونهيق الحمير بالليل فتعوذا بالله من الشيطان فإنهن يرين ما لا ترون وأقلوا الخروج إذا هدأت الرجل فإن الله عز وجل يبث في ليلة من خلقه ما يشاء وأجيفوا الأبواب واذكروا اسم الله عليها فإن الشيطان لا يفتح بابا أجيف وذكر اسم الله عليه وغطوا الجرار وأوكئوا القرب وأكفئوا الآنية»","صحيح","Sahih al-Jami al-Saghir 620","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"621","«إذا سميت الكيل فكله»","صحيح","Sahih al-Jami al-Saghir 621","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"622","«إذا سها أحدكم في صلاته فلم يدر واحدة صلى أو اثنتين فليبن على واحدة فإن لم يدر ثلاثا صلى أو أربعا فليبن على ثلاث وليسجد سجدتين قبل أن يسلم»","صحيح","Sahih al-Jami al-Saghir 622","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"623","«إذا سها الإمام فاستتم قائما فعليه سجدتا السهو وإذا لم يستتم قائما فلا سهو عليه»","صحيح","Sahih al-Jami al-Saghir 623","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"624","«إذا شرب أحدكم فلا يتنفس في الإناء فإذا أراد أن يعود فلينح الإناء ثم ليعد إن كان يريده»","حسن","Sahih al-Jami al-Saghir 624","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"625","إذا شرب أحدكم فلا يتنفس في الإناء وإذا أتى الخلاء فلا ¤ يمس ذكره بيمينه ولا يتمسح بيمينه","صحيح","Sahih al-Jami al-Saghir 625","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"626","«إذا شرب أحدكم فلا يشرب بنفس واحد»","صحيح","Sahih al-Jami al-Saghir 626","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"627","«إذا شرب الكلب في إناء أحدكم فليغسله سبع مرات»","صحيح","Sahih al-Jami al-Saghir 627","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"628","«إذا شربتم اللبن فتمضمضوا منه فإن له دسما»","صحيح","Sahih al-Jami al-Saghir 628","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"629","«إذا شربوا الخمر فاجلدوهم ثم إن شربوها فاجلدوهم ثم إن شربوها فاجلدوهم ثم إن شربوا فاقتلوهم»","صحيح","Sahih al-Jami al-Saghir 629","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"630","«إذا شك أحدكم في الاثنتين والواحدة فليجعلها واحدة وإذا شك في الاثنتين والثلاث فليجعلها اثنتين وإذا شك في الثلاث والأربع فليجعلها ثلاثا حتى يكون الوهم في الزيادة ثم ليتم ما بقي من صلاته ثم يسجد سجدتين وهو جالس قبل أن يسلم»","صحيح","Sahih al-Jami al-Saghir 630","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"631","«إذا شك أحدكم في صلاته فلم يدر اثنتين صلى أو ثلاثا فليلق الشك وليبن على اليقين»","صحيح","Sahih al-Jami al-Saghir 631","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"632","«إذا شك أحدكم في صلاته فلم يدر كم صلى ثلاثا أم أربعا؟ فليطرح الشك وليبن على ما استيقن ثم ليسجد سجدتين قبل أن يسلم فإن كان صلى خمسا شفعن له صلاته وإن كان صلى إتماما لأربع كانتا ترغيما للشيطان»","صحيح","Sahih al-Jami al-Saghir 632","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"633","«إذا شك أحدكم في صلاته فليلق الشك وليبن على اليقين فإن استيقن التمام سجد سجدتين فإن كانت صلاته تامة كانت الركعة نافلة والسجدتان نافلة وإن كانت ناقصة كانت الركعة تمام الصلاة والسجدتان ترغمان أنف الشيطان»","حسن","Sahih al-Jami al-Saghir 633","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"634","«إذا شهدت إحداكن العشاء فلا تمس طيبا»","صحيح","Sahih al-Jami al-Saghir 634","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"635","«إذا شهر المسلم على أخيه سلاحا فلا تزال ملائكة الله تلعنه حتى يشيمه عنه»","حسن","Sahih al-Jami al-Saghir 635","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"636","«إذا صار أهل الجنة إلى الجنة وأهل النار إلى النار جيء بالموت حتى يجعل بين الجنة والنار ثم يذبح ثم ينادي مناد: يا أهل الجنة خلود لا موت، يا أهل النار خلود لا موت، فيزداد أهل الجنة فرحا إلى فرحهم، ويزداد أهل النار حزنا إلى حزنهم»","صحيح","Sahih al-Jami al-Saghir 636","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"637","«إذا صلى أحدكم إلى سترة فليدن منها لا يمر الشيطان بينه وبينها»","صحيح","Sahih al-Jami al-Saghir 637","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"638","«إذا صلى أحدكم إلى شيء يستره من الناس فأراد أحد أن يجتاز بين يديه فليدفعه فإن أبى فليقاتله فإنما هو شيطان»","صحيح","Sahih al-Jami al-Saghir 638","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"639","«إذا صلى أحدكم الجمعة فلا يصل بعدها شيئا حتى يتكلم أو يخرج»","صحيح","Sahih al-Jami al-Saghir 639","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"640","«إذا صلى أحدكم الجمعة فليصل بعدها أربعا»","صحيح","Sahih al-Jami al-Saghir 640","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"641","«إذا صلى أحدكم فليصل إلى سترة وليدن منها ولا يدع أحدا يمر بين يديه فإن جاء أحد يمر فليقاتله فإنما هو شيطان»","صحيح","Sahih al-Jami al-Saghir 641","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"642","«إذا صلى أحدكم ركعتي الفجر فليضطجع على جنبه الأيمن»","صحيح","Sahih al-Jami al-Saghir 642","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"643","«إذا صلى أحدكم فخلع نعليه فلا يؤذ بهما أحدا ليجعلهما بين رجليه أو ليصل فيهما»","صحيح","Sahih al-Jami al-Saghir 643","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"644","«إذا صلى أحدكم فلا يبصق بين يديه ولا عن يمينه وليبصق عن يساره أو تحت قدمه»","صحيح","Sahih al-Jami al-Saghir 644","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"645","«إذا صلى أحدكم فلا يضع نعليه عن يمينه ولا عن يساره فتكون عن يمين غيره إلا أن لا يكون عن يساره أحد وليضعها بين رجليه»","صحيح","Sahih al-Jami al-Saghir 645","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"646","«إذا صلى أحدكم فلم يدري كيف صلى فليسجد سجدتين وهو جالس»","حسن","Sahih al-Jami al-Saghir 646","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"647","«إذا صلى أحدكم فليأتزر وليرتد»","صحيح","Sahih al-Jami al-Saghir 647","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"648","«إذا صلى أحدكم فليبدأ بتحميد الله تعالى والثناء عليه ثم ليصل على النبي ثم ليدع بعد بما شاء»","صحيح","Sahih al-Jami al-Saghir 648","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"649","إذا صلى أحدكم فليتم ركوعه ولا ينقر في سجوده فإنما مثل ذلك كمثل الجائع يأكل التمرة والتمرتين فماذا يغنيان عنه"".؟","حسن","Sahih al-Jami al-Saghir 649","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"650","«إذا صلى أحدكم فليصل إلى سترة وليدن من سترته لا يقطع الشيطان عليه صلاته»","صحيح","Sahih al-Jami al-Saghir 650","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"651","«إذا صلى أحدكم فليصل إلى سترة وليدن منها ولا يدع أحدا يمر بين يديه فإن جاء أحد يمر فليقاتله فإنه شيطان»","صحيح","Sahih al-Jami al-Saghir 651","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"652","«إذا صلى أحدكم فليلبس ثوبيه فإن الله تعالى أحق من تزين له»","صحيح","Sahih al-Jami al-Saghir 652","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"653","«إذا صلى أحدكم فليلبس نعليه أو ليخلعهما بين رجليه ولا يؤذ بهما غيره»","صحيح","Sahih al-Jami al-Saghir 653","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"654","«إذا صلى أحدكم في بيته ثم دخل المسجد والقوم يصلون فليصل معهم تكون له نافلة»","صحيح","Sahih al-Jami al-Saghir 654","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"655","«إذا صلى أحدكم في ثوب واحد فليخالف بطرفيه على عاتقيه»","صحيح","Sahih al-Jami al-Saghir 655","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"656","«إذا صلى أحدكم في ثوب واحد فليشده على حقويه ولا تشتملوا كاشتمال اليهود»","صحيح","Sahih al-Jami al-Saghir 656","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"657","«إذا صلى أحدكم في رحله ثم أدرك الإمام ولم يصل فليصل معه فإنها له نافلة»","صحيح","Sahih al-Jami al-Saghir 657","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"658","«إذا صلى أحدكم للناس فليخفف فإن فيهم الضعيف والسقيم والكبير وإذا صلى أحدكم لنفسه فليطول ما شاء»","صحيح","Sahih al-Jami al-Saghir 658","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"659","«إذا صلى الأمير* جالسا فصلوا جلوسا»","صحيح","Sahih al-Jami al-Saghir 659","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"660","«إذا صلت المرأة خمسها وصامت شهرها وحصنت فرجها وأطاعت زوجها قيل لها: ادخلي الجنة من أي أبواب الجنة شئت»","صحيح","Sahih al-Jami al-Saghir 660","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"661","إذا صلت المرأة خمسها وصامت شهرها وحفظت ¤ فرجها وأطاعت زوجها دخلت الجنة","صحيح","Sahih al-Jami al-Saghir 661","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"662","«إذا صلوا على جنازة فأثنوا خيرا يقول الرب: أجزت شهادتهم فيما يعلمون وأغفر له ما لا يعلمون»","صحيح","Sahih al-Jami al-Saghir 662","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"663","«إذا صليت الصبح فأمسك عن الصلاة حتى تطلع الشمس فإنها تطلع بين قرني الشيطان فإذا طلعت فصل فإن الصلاة محضورة متقبلة حتى تعتدل على رأسك مثل الرمح فأمسك فإن تلك الساعة التي تسجر فيها جهنم وتفتح فيها أبوابها حتى ترتفع الشمس على حاجبك الأيمن فإذا زالت عن حاجبك الأيمن فصل فإن الصلاة محضورة متقبلة حتى تصلي العصر ثم دع الصلاة حتى تغيب الشمس»","صحيح","Sahih al-Jami al-Saghir 663","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"664","«إذا صليت فلا تبزقن بين يديك ولا عن يمينك ولكن ابزق تلقاء شمالك إن كان فارغا وإلا فتحت قدمك اليسرى وادلكه»","صحيح","Sahih al-Jami al-Saghir 664","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"665","«إذا صليت فلا تبسط ذراعيك بسط السبع وادعم على راحتيك وجاف مرفقيك عن ضبعيك»","صحيح","Sahih al-Jami al-Saghir 665","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"666","«إذا صليتما في رحالكما ثم أتيتما الإمام فصليا معه فتكون لكما نافلة والتي في رحالكما فريضة»","صحيح","Sahih al-Jami al-Saghir 666","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"667","«إذا صليتما في رحالكما ثم أتيتما مسجد جماعة فصليا معهم فإنها لكما نافلة»","صحيح","Sahih al-Jami al-Saghir 667","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"668","«إذا صليتم الجمعة فصلوا بعدها أربعا»","صحيح","Sahih al-Jami al-Saghir 668","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"669","«إذا صليتم على الميت فأخلصوا له الدعاء»","حسن","Sahih al-Jami al-Saghir 669","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"670","«إذا صليتم علي فقولوا: اللهم صل على محمد النبي الأمي وعلى آل محمد كما صليت على إبراهيم وعلى آل إبراهيم وبارك على محمد النبي الأمي وعلى آل محمد كما باركت على إبراهيم وعلى آل إبراهيم إنك حميد مجيد»","حسن","Sahih al-Jami al-Saghir 670","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"671","«إذا صليتم فاتزروا وارتدوا ولا تشبهوا باليهود»","صحيح","Sahih al-Jami al-Saghir 671","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"672","إذا صليتم فأقيموا صفوفكم ثم ليؤمكم أحدكم فإذا كبر فكبروا وإذا قرأ فأنصتوا وإذا قال: {غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ} فقولوا: آمين يحبكم الله وإذا كبر وركع فكبروا واركعوا فإن الإمام يركع قبلكم ويرفع قبلكم فتلك بتلك، وإذا قال: سمع الله لمن حمده فقولوا: اللهم ربنا لك الحمد يسمع الله لكم وإذا كبر وسجد فكبروا واسجدوا فإن الإمام يسجد قبلكم ويرفع قبلكم فتلك بتلك، وإذا كان عند القعدة فليكن من أول قول أحدكم التحيات الطيبات الصلوات لله السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين أشهد أن لا إله إلا الله وأشهد أن محمد عبده ورسوله","صحيح","Sahih al-Jami al-Saghir 672","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"673","«إذا صمت من الشهر ثلاثا فصم ثلاث عشرة وأربع عشرة وخمس عشرة»","صحيح","Sahih al-Jami al-Saghir 673","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"674","«إذا ضرب أحدكم خادمه فليتق الوجه»","حسن","Sahih al-Jami al-Saghir 674","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"675","«إذا ضن الناس بالدينار والدرهم وتبايعوا بالعينة وتبعوا أذناب البقر وتركوا الجهاد في سبيل الله أدخل الله تعالى عليهم ذلا لا يرفعه عنهم حتى يراجعوا دينهم»","صحيح","Sahih al-Jami al-Saghir 675","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"676","«إذا طبخ أحدكم قدرا فليكثر مرقها ثم ليناول جاره منها»","صحيح","Sahih al-Jami al-Saghir 676","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"677","إذا طبختم اللحم فأكثروا المرق فإنه أوسع وأبلغ ¤ للجيران","صحيح","Sahih al-Jami al-Saghir 677","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"678","«إذا طلع الفجر فلا صلاة إلا ركعتي الفجر»","صحيح","Sahih al-Jami al-Saghir 678","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"679","«إذا ظهر الزنا والربا في قرية فقد أحلوا بأنفسهم عذاب الله»","صحيح","Sahih al-Jami al-Saghir 679","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"680","«إذا ظهر السوء في الأرض أنزل الله بأسه بأهل الأرض وإن كان فيهم قوم صالحون يصيبهم ما أصاب الناس ثم يرجعون إلى رحمة الله ومغفرته»","صحيح","Sahih al-Jami al-Saghir 680","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"681","«إذا عاد أحدكم مريضا فليقل: اللهم اشف عبدك ينكأ لك عدوا أو يمشي لك إلى صلاة»","حسن","Sahih al-Jami al-Saghir 681","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"682","«إذا عاد الرجل أخاه المسلم مشى في خرافة الجنة حتى يجلس فإذا جلس غمرته الرحمة فإن كان غدوة صلى عليه سبعون ألف ملك حتى يمسي وإن كان عشيا صلى عليه سبعون ألف ملك حتى يصبح»","صحيح","Sahih al-Jami al-Saghir 682","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"683","«إذا عطس أحدكم فحمد الله فشمتوه وإذا لم يحمد الله فلا تشمتوه»","صحيح","Sahih al-Jami al-Saghir 683","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"684","«إذا عطس أحدكم فليشمته جليسه فإن زاد على ثلاث فهو مزكوم ولا يشمت بعد ثلاث»","صحيح","Sahih al-Jami al-Saghir 684","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"685","«إذا عطس أحدكم فليضع كفيه على وجهه وليخفض صوته»","حسن","Sahih al-Jami al-Saghir 685","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"686","«إذا عطس أحدكم فليقل: الحمد لله رب العالمين وليقل له: يرحمك الله وليقل هو: يغفر الله لنا ولكم»","صحيح","Sahih al-Jami al-Saghir 686","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"687","«إذا عطس أحدكم فليقل: الحمد لله على كل حال وليقل له من حوله: يرحمك الله وليقل هو لمن حوله: يهديكم الله ويصلح بالكم»","صحيح","Sahih al-Jami al-Saghir 687","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"688","«إذا عطس أحدكم فليقل: الحمد لله فإذا قال فليقل له أخوه أو صاحبه: يرحمك الله فإذا قال له: يرحمك الله فليقل: يهديكم الله ويصلح بالكم»","صحيح","Sahih al-Jami al-Saghir 688","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"689","«إذا عملت الخطيئة في الأرض كان من شهدها فكرهها كمن غاب عنها ومن غاب عنها فرضيها كان كمن شهدها»","حسن","Sahih al-Jami al-Saghir 689","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"690","«إذا عملت سيئة فأتبعها حسنة تمحها»","صحيح","Sahih al-Jami al-Saghir 690","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"691","«إذا عملت مرقة فأكثر ماءها واغرف لجيرانك منها»","صحيح","Sahih al-Jami al-Saghir 691","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"692","«إذا غابت الشمس فكفوا صبيانكم فإنها ساعة ينتشر فيها الشياطين»","صحيح","Sahih al-Jami al-Saghir 692","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"693","«إذا غضب أحدكم فليسكت»","صحيح","Sahih al-Jami al-Saghir 693","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"694","«إذا غضب أحدكم وهو قائم فليجلس فإن ذهب عنه الغضب وإلا فليضطجع»","صحيح","Sahih al-Jami al-Saghir 694","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"695","«إذا غضب الرجل فقال: أعوذ بالله سكن غضبه»","صحيح","Sahih al-Jami al-Saghir 695","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"696","«إذا غضبت فاجلس»","صحيح","Sahih al-Jami al-Saghir 696","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"697","إذا فتحت عليكم فارس والروم أي قوم أنتم؟ ¤ - قيل: نكون كما أمر الله - قال: أو غير ذلك؟ تتنافسون ثم تتحاسدون ثم تتدابرون ثم تتباغضون ثم تنطلقون في مساكن المهاجرين فتجعلون بعضهم على رقاب بعض","صحيح","Sahih al-Jami al-Saghir 697","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"698","«إذا فتحت مصر فاستوصوا بالقبط خيرا فإن لهم ذمة ورحما»","صحيح","Sahih al-Jami al-Saghir 698","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"699","«إذا فرغ أحدكم من التشهد الأخير فليتعوذ بالله من أربع يقول: اللهم إني أعوذ بك من عذاب جهنم ومن عذاب القبر ومن فتنة المحيا والممات ومن شر فتنة المسيح الدجال»","صحيح","Sahih al-Jami al-Saghir 699","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"700","«إذا فرغ أحدكم من صلاته فليدع بأربع ثم ليدع بعد بما شاء: اللهم إني أعوذ بك من عذاب جهنم وعذاب القبر وفتنة المحيا والممات وفتنة المسيح الدجال»","صحيح","Sahih al-Jami al-Saghir 700","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"701","«إذا فزع أحدكم من النوم فليقل: أعوذ بكلمات الله التامة من غضبه وعقابه وشر عباده ومن همزات الشياطين وأن يحضرون فإنها لن تضره»","حسن","Sahih al-Jami al-Saghir 701","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"702","«إذا فسد أهل الشام فلا خير فيكم ولا تزال طائفة من أمتي منصورين لا يضرهم من خذلهم حتى تقوم الساعة»","صحيح","Sahih al-Jami al-Saghir 702","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"703","«إذا قاتل أحدكم أخاه فليجتنب الوجه»","صحيح","Sahih al-Jami al-Saghir 703","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"704","«إذا قال أحدكم في الصلاة: آمين وقالت الملائكة في السماء: آمين فوافقت إحداهما الأخرى غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 704","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"705","«إذا قال الإمام: سمع الله لمن حمده فقولوا: اللهم ربنا لك الحمد فإنه من وافق قوله قول الملائكة غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 705","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"706","«إذا قال الإمام: سمع الله لمن حمده فقولوا: اللهم ربنا ولك الحمد»","صحيح","Sahih al-Jami al-Saghir 706","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"707","«إذا قال الإمام: {غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ} فقولوا: آمين فإنه من وافق قوله قول الملائكة غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 707","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"708","إذا قال الرجل لأخيه: جزاك الله خيرا فقد أبلغ في ¤ الثناء","صحيح","Sahih al-Jami al-Saghir 708","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"709","«إذا قال الرجل لأخيه: يا كافر فقد باء بها أحدهما»","صحيح","Sahih al-Jami al-Saghir 709","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"710","«إذا قال الرجل لأخيه: يا كافر فهو كقتله ولعن المؤمن كقتله»","صحيح","Sahih al-Jami al-Saghir 710","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"711","«إذا قال الرجل للمنافق: يا سيدي فقد أغضب ربه»","حسن","Sahih al-Jami al-Saghir 711","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"712","«إذا قال الرجل: هلك الناس فهو أهلكهم»","صحيح","Sahih al-Jami al-Saghir 712","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"713","«إذا قال العبد: لا إله إلا الله والله أكبر قال الله: صدق عبدي لا إله إلا أنا وأنا أكبر، فإذا قال: لا إله إلا الله وحده قال: صدق عبدي لا إله إلا أنا وحدي فإذا قال: لا إله إلا الله لا شريك له قال: صدق عبدي لا إله إلا أنا ولا شريك لي، فإذا قال: لا إله إلا الله له الملك وله الحمد قال: صدق عبدي لا إله إلا أنا لي الملك ولي الحمد، فإذا قال: لا إله إلا الله ولا حول ولا قوة إلا بالله قال: صدق عبدي لا إله إلا أنا ولا حول ولا قوة إلا بي من رزقهن عند موته لم تمسه النار»","صحيح","Sahih al-Jami al-Saghir 713","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"714","«إذا قال المؤذن: الله أكبر الله أكبر فقال أحدكم: الله أكبر الله أكبر، ثم قال: أشهد أن لا إله إلا الله قال: أشهد أن لا إله إلا الله، ثم قال: أشهد أن محمدا رسول الله قال: أشهد أن محمدا رسول الله، ثم قال: حي على الصلاة قال: لا حول ولا قوة إلا بالله، ثم قال: حي على الفلاح قال: لا حول ولا قوة إلا بالله، ثم قال: الله أكبر الله أكبر قال: الله أكبر الله أكبر ثم قال: لا إله إلا الله قال: لا إله إلا الله من قلبه دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 714","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"715","«إذا قام أحدكم إلى الصلاة فلا يبزق أمامه فإنما يناجي الله تبارك وتعالى ما دام في مصلاه، ولا عن يمينه فإن عن يمينه ملكا، وليبصق عن يساره أو تحت قدمه فيدفنها»","صحيح","Sahih al-Jami al-Saghir 715","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"716","«إذا قام أحدكم عن فراشه ثم رجع إليه فلينفضه بصنفة إزاره ثلاث مرات فإنه لا يدري ما خلفه عليه بعده، وإذا اضطجع فليقل: باسمك ربي وضعت جنبي وبك أرفعه فإن أمسكت نفسي فارحمها وإن أرسلتها فاحفظها بما تحفظ به عبادك الصالحين، فإذا استيقظ فليقل: الحمد لله الذي عافاني في جسدي ورد على روحي وأذن لي بذكره»","حسن","Sahih al-Jami al-Saghir 716","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"717","إذا قام أحدكم من الليل فاستعجم القرآن على لسانه فلم ¤ يدر ما يقول فليضطجع","صحيح","Sahih al-Jami al-Saghir 717","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"718","«إذا قام أحدكم من النوم فأراد أن يتوضأ فلا يدخل يده في الإناء حتى يغسلها فإنه لا يدري أين باتت يده ولا على ما وضعها»","صحيح","Sahih al-Jami al-Saghir 718","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"719","«إذا قام أحدكم يصلي فإنه يستره إذا كان بين يديه مثل آخرة الرحل فإذا لم يكن بين يديه مثل آخرة الرحل فإنه يقطع صلاته الحمار والمرأة والكلب الأسود قيل: ما بال الكلب الأسود من الكلب الأحمر؟ قال: الكلب الأسود شيطان»","صحيح","Sahih al-Jami al-Saghir 719","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"720","«إذا قام أحدكم يصلي من الليل فليستك فإن أحدكم إذا قرأ في صلاته وضع ملك فاه على فيه ولا يخرج من فيه شيء إلا دخل فم الملك»","صحيح","Sahih al-Jami al-Saghir 720","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"721","«إذا قام الإمام في الركعتين فإن ذكر قبل أن يستوي قائما فليجلس فإن استوى قائما فلا يجلس ويسجد سجدتي السهو»","صحيح","Sahih al-Jami al-Saghir 721","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"722","«إذا قام الرجل من مجلسه ثم رجع إليه فهو أحق به»","صحيح","Sahih al-Jami al-Saghir 722","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"723","«إذا قام الرجل يتوضأ ليلا أو نهارا فأحسن الوضوء واستن ثم قام فصلى أطاف به الملك ودنا منه حتى يضع فاه على فيه فما يقرأ إلا في فيه، وإذا لم يستن أطاف به ولا يضع فاه على فيه»","صحيح","Sahih al-Jami al-Saghir 723","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"724","«إذا قبر الميت أتاه ملكان أسودان أزرقان يقال لأحدهما المنكر وللآخر النكير فيقولان: ما كنت تقول في هذا الرجل؟ فيقول: ما كان يقول هو: عبد الله ورسوله أشهد أن لا إله إلا الله وأن محمد عبده ورسوله، فيقولان: قد كنا نعلم أنك تقول، ثم يفسح له في قبره سبعون ذراعا في سبعين ثم ينور له فيه ثم يقال: نم فيقول: أرجع إلى أهلي فأخبرهم، فيقولان: نم كنومة العروس الذي لا يوقظه إلا أحب أهله إليه، حتى يبعثه الله من مضجعه ذلك، وإن كان منافقا قال: سمعت الناس يقولون قولا فقلت مثله لا أدري فيقولان: قد كنا نعلم أنك تقول ذلك فيقال للأرض: التئمي عليه فتلتئم عليه فتختلف أضلاعه فلا يزال فيها معذبا حتى يبعثه الله من مضجعه ذلك»","حسن","Sahih al-Jami al-Saghir 724","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"725","«إذا قدم أحدكم ليلا فلا يأتين أهله طروقا؛ حتى تستحد المغيبة وتمتشط الشعثة»","صحيح","Sahih al-Jami al-Saghir 725","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"726","«إذا قدم العشاء وحضرت الصلاة فابدءوا به قبل أن تصلوا صلاة المغرب ولا تعجلوا عن عشائكم»","صحيح","Sahih al-Jami al-Saghir 726","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"727","«إذا قرأ ابن آدم السجدة فسجد اعتزل الشيطان يبكي يقول: يا ويله أمر ابن آدم بالسجود فسجد فله الجنة وأمرت بالسجود فعصيت فلي النار»","صحيح","Sahih al-Jami al-Saghir 727","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"728","«إذا قرأ الإمام فأنصتوا»","صحيح","Sahih al-Jami al-Saghir 728","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"729","«إذا قرأتم {الْحَمْدُ لِلَّهِ} فاقرءوا {بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ} إنها أم القرآن وأم الكتاب والسبع المثاني و {بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ} إحدى آياتها»","صحيح","Sahih al-Jami al-Saghir 729","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"730","«إذا قسمت الأرض وحدت فلا شفعة فيها»","صحيح","Sahih al-Jami al-Saghir 730","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"731","«إذا قضى أحدكم الصلاة في مسجده فليجعل لبيته نصيبا من صلاته فإن الله تعالى جاعل في بيته من صلاته خيرا»","صحيح","Sahih al-Jami al-Saghir 731","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"732","«إذا قضى أحدكم حجه فليعجل الرجوع إلى أهله فإنه أعظم لأجره»","حسن","Sahih al-Jami al-Saghir 732","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"733","«إذا قضى أحدكم صلاته في المسجد ثم رجع إلى بيته فليصل في بيته ركعتين وليجعل لبيته نصيبا من صلاته فإن الله جاعل في بيته من صلاته خيرا»","صحيح","Sahih al-Jami al-Saghir 733","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"734","«إذا قضى الله تعالى الأمر في السماء ضربت الملائكة بأجنحتها خضعانا لقوله كأنه سلسلة على صفوان، فإذا فزع عن قلوبهم ق الوا ماذا قال ربكم؟ قالوا ل لذي قال الحق وهو العلي الكبير، فيسمعها مسترقوا السمع ومسترقوا السمع هكذا واحد فوق آخر فربما أدرك الشهاب المستمع قبل أن يرمي بها إلى صاحبه فيحرقه، وربما لم يدركه حتى يرمي بها إلى الذي يليه إلى الذي هو أسفل منه حتى يلقوها إلى الأرض، فتلقى على فم الساحر فيكذب معها مئة كذبة فيصدق فيقولون: ألم تخبرنا يوم كذا وكذا يكون كذا وكذا فوجدناه حقا للكلمة التي سمعت من السماء»","صحيح","Sahih al-Jami al-Saghir 734","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"735","«إذا قضى الله تعالى لعبد أن يموت بأرض جعل الله له إليها حاجة»","صحيح","Sahih al-Jami al-Saghir 735","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"736","«إذا قعد بين شعبها الأربع وألزق الختان بالختان فقد وجب الغسل»","صحيح","Sahih al-Jami al-Saghir 736","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"737","إذا قلت لصاحبك والإمام يخطب يوم الجمعة: أنصت ¤ فقد لغوت","صحيح","Sahih al-Jami al-Saghir 737","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"738","«إذا قمت إلى الصلاة فأسبغ الوضوء ثم استقبل القبلة فكبر ثم اقرأ ما تيسر معك من القرآن ثم اركع حتى تطمئن راكعا ثم ارفع حتى تستوي قائما ثم اسجد حتى تطمئن ساجدا ثم ارفع حتى تستوي قائما ثم افعل ذلك في صلاتك كلها»","صحيح","Sahih al-Jami al-Saghir 738","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"739","«إذا قمت إلى الصلاة فأسبغ الوضوء واجعل الماء بين أصابع يديك ورجليك»","صحيح","Sahih al-Jami al-Saghir 739","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"740","«إذا قمت إلى الصلاة فتوضأ كما أمرك الله، ثم قم فاستقبل القبلة ثم كبر فإن كان معك قرآن فاقرأه، وإن لم يكن معك قرآن فاحمد الله وهلله وكبره، فإذا ركعت فاركع حتى تطمئن ثم ارفع رأسك فاعتدل قائما ثم اسجد فاعتدل ساجدا ثم ارفع رأسك فاعتدل قاعدا حتى تقضي صلاتك فإذا فعلت ذلك فقد تمت صلاتك وإن انتقصت من ذلك شيئا فإنما انتقصت من صلاتك»","صحيح","Sahih al-Jami al-Saghir 740","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"741","إذا قمت إلى الصلاة فكبر ثم اقرأ ما تيسر معك من ¤ القرآن ثم اركع حتى تطمئن راكعا ثم ارفع حتى تعتدل قائما ثم اسجد حتى تطمئن ساجدا ثم ارفع حتى تطمئن جالسا ثم اسجد حتى تطمئن ساجدا ثم افعل ذلك في صلاتك كلها","صحيح","Sahih al-Jami al-Saghir 741","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"742","«إذا قمت في صلاتك فصل صلاة مودع ولا تكلم بكلام تعتذر منه واجمع الإياس مما في أيدي الناس»","صحيح","Sahih al-Jami al-Saghir 742","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"743","«إذا قمتم في الصلاة فلا تسبقوا قارئكم بالركوع والسجود ولكن هو يسبقكم»","صحيح","Sahih al-Jami al-Saghir 743","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"744","«إذا كان اثنان يتناجيان فلا تدخل بينهما»","صحيح","Sahih al-Jami al-Saghir 744","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"745","«إذا كان أجل أحدكم بأرض أتى له حاجة إليها فإذا بلغ أقصى أثره قبضه الله إليه فتقول الأرض يوم القيامة رب هذا ما استودعتني»","صحيح","Sahih al-Jami al-Saghir 745","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"746","«إذا كان أحدكم صائما فليفطر على التمر فإن لم يجد التمر فعلى الماء فإن الماء طهور»","صحيح","Sahih al-Jami al-Saghir 746","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"747","«إذا كان أحدكم فقيرا فليبدأ بنفسه فإن كان فضل فعلى عياله فإن كان فضل فعلى ذي قرابته فإن كان فضل فهاهنا وهاهنا»","صحيح","Sahih al-Jami al-Saghir 747","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"748","«إذا كان أحدكم في الشمس فقلص عنه الظل وصار بعضه في الظل وبعضه في الشمس فليقم»","صحيح","Sahih al-Jami al-Saghir 748","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"749","«إذا كان أحدكم في الصلاة فلا يرفع بصره إلى السماء أن يلتمع بصره»","صحيح","Sahih al-Jami al-Saghir 749","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"750","«إذا كان أحدكم في الصلاة فوجد حركة في دبره أحدث أو لم يحدث؟ فأشكل عليه فلا ينصرف حتى يسمع صوتا أو يجد ريحا»","صحيح","Sahih al-Jami al-Saghir 750","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"751","«إذا كان أحدكم في المسجد فوجد ريحا بين أليتيه فلا يخرج حتى يسمع صوتا أو يجد ريحا»","صحيح","Sahih al-Jami al-Saghir 751","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"752","[إذا كان أحدكم في صلاة فإنه يناجي ربه فلينظر أحدكم ما يقول في صلاته ولا ترفعوا أصواتكم فتؤذوا المؤمنين]","صحيح","Sahih al-Jami al-Saghir 752","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"753","«إذا كان أحدكم يصلي فلا يبصق قبل وجهه فإن الله قبل وجهه إذا صلى»","صحيح","Sahih al-Jami al-Saghir 753","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"754","«إذا كان أحدكم يصلي فلا يدع أحدا يمر بين يديه وليدرأه ما استطاع فإن أبى فليقاتله فإنما هو شيطان»","صحيح","Sahih al-Jami al-Saghir 754","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"755","«إذا كان أحدكم يصلي فلا يدع أحدا يمر بين يديه وليدرأه ما استطاع فإن أبى فليقاتله فإن معه القرين»","صحيح","Sahih al-Jami al-Saghir 755","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"756","«إذا كان أحدكم يصلي فلا يرفع بصره إلى السماء لا يلتمع» *","صحيح","Sahih al-Jami al-Saghir 756","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"757","«إذا كان العام المقبل صمنا يوم التاسع»","صحيح","Sahih al-Jami al-Saghir 757","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"758","«إذا كان الماء قلتين فإنه لا ينجس»","صحيح","Sahih al-Jami al-Saghir 758","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"759","إذا كان أول ليلة من شهر رمضان صفدت الشياطين ومردة ¤ الجن وغلقت أبواب النار فلم يفتح منها باب وفتحت أبواب الجنة فلم يغلق منها باب وينادي مناد كل ليلة: يا باغي الخير أقبل ويا باغي الشر أقصر ولله عتقاء من النار وذلك كل ليلة","حسن","Sahih al-Jami al-Saghir 759","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"760","«إذا كانت الفتنة بين المسلمين فاتخذ سيفا من خشب»","حسن","Sahih al-Jami al-Saghir 760","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"761","«إذا كانت عند الرجل امرأتان فلم يعدل بينهما جاء يوم القيامة وشقه ساقط»","صحيح","Sahih al-Jami al-Saghir 761","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"762","«إذا كان ثلاثة جميعا فلا يتناجى اثنان دون الثالث»","صحيح","Sahih al-Jami al-Saghir 762","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"763","«إذا كان ثلاثة في سفر فليؤمروا أحدهم»","صحيح","Sahih al-Jami al-Saghir 763","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"764","«إذا كان جنح الليل فكفوا صبيانكم فإن الشياطين تنتشر حينئذ فإذا ذهب ساعة من الليل فخلوهم وأغلقوا الأبواب واذكروا اسم الله فإن الشيطان لا يفتح بابا مغلقا، وأوكئوا قربكم واذكروا اسم الله وخمروا آنيتكم واذكروا اسم الله ولو أن تعرضوا عليه شيئا وأطفئوا مصابيحكم»","صحيح","Sahih al-Jami al-Saghir 764","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"765","إذا كان دم الحيض فإنه دم أسود يعرف، فإذا كان ¤ ذلك فأمسكي عن الصلاة وإذا كان الآخر فتوضئي وصلي فإنما هو عرق","صحيح","Sahih al-Jami al-Saghir 765","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"766","«إذا كان رمضان فاعتمري فيه فإن عمرة فيه تعدل حجة»","صحيح","Sahih al-Jami al-Saghir 766","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"767","«إذا كان شيء من أمر دنياكم فأنتم أعلم به وإذا كان شيء من أمر دينكم فإلي»","صحيح","Sahih al-Jami al-Saghir 767","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"768","«إذا كان لأحدكم ثوبان فليصل فيهما فإن لم يكن إلا ثوب فليأتزر ولا يشتمل اشتمال اليهود»","صحيح","Sahih al-Jami al-Saghir 768","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"769","«إذا كان لأحدكم خادم قد كفاه المشقة فليطعمه فإن لم يفعل فليناوله اللقمة»","صحيح","Sahih al-Jami al-Saghir 769","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"770","«إذا كان لأحدكم شعر فليكرمه»","صحيح","Sahih al-Jami al-Saghir 770","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"771","«إذا كان ليلة النصف من شعبان اطلع الله إلى خلقه فيغفر للمؤمنين ويملي للكافرين ويدع أهل الحقد بحقدهم حتى يدعوه»","حسن","Sahih al-Jami al-Saghir 771","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"772","«إذا كانوا ثلاثة فلا يتناج اثنان دون الثالث»","صحيح","Sahih al-Jami al-Saghir 772","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"773","«إذا كانوا ثلاثة فليؤمهم أحدهم وأحقهم بالإمامة أقرؤهم»","صحيح","Sahih al-Jami al-Saghir 773","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"774","«إذا كان يوم الجمعة قعدت الملائكة على أبواب المسجد يكتبون من جاء من الناس على قدر منازلهم، فرجل قدم جزورا ورجل قدم بقرة ورجل قدم شاة ورجل قدم دجاجة ورجل قدم عصفورا ورجل قدم بيضة، فإذا أذن المؤذن وجلس الإمام على المنبر طووا الصحف ودخلوا المسجد يستمعون الذكر»","صحيح","Sahih al-Jami al-Saghir 774","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"775","إذا كان يوم الجمعة كان على كل باب من أبواب المسجد ملائكة يكتبون الناس على قدر منازلهم الأول فالأول فإذا جلس الإمام ¤ طووا الصحف وجاءوا يستمعون الذكر ومثل المهجر كمثل الذي يهدي بدنة ثم كالذي يهدي بقرة ثم كالذي يهدي الكبش ثم كالذي يهدي الدجاجة ثم كالذي يهدي البيضة","صحيح","Sahih al-Jami al-Saghir 775","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"776","«إذا كان يوم الجمعة وليلة الجمعة فأكثروا الصلاة علي»","حسن","Sahih al-Jami al-Saghir 776","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"777","«إذا كان يوم القيامة أدنيت الشمس من العباد حتى تكون قيد ميل أو اثنين فتصهرهم الشمس فيكونون في العرق كقدر أعمالهم فمنهم من يأخذه إلى عقبيه ومنهم من يأخذه إلى ركبتيه ومنهم من يأخذه إلى حقويه ومنهم من يلجمه إلجاما»","صحيح","Sahih al-Jami al-Saghir 777","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"778","«إذا كان يوم القيامة أعطى الله تعالى كل رجل من هذه الأمة رجلا من الكفار فيقال له: هذا فداؤك من النار»","صحيح","Sahih al-Jami al-Saghir 778","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"779","«إذا كان يوم القيامة بعث الله إلى كل مؤمن ملكا معه كافر فيقول الملك للمؤمن: يا مؤمن هاك هذا الكافر فهذا فداؤك من النار»","صحيح","Sahih al-Jami al-Saghir 779","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"780","«إذا كان يوم القيامة شفعت فقلت: يا رب أدخل الجنة من كان في قلبه خردلة من إيمان فيدخلون ثم يقول: أدخل الجنة من كان في قلبه أدنى شيء»","صحيح","Sahih al-Jami al-Saghir 780","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"781","«إذا كان يوم القيامة كنت إمام النبيين وخطيبهم وصاحب شفاعتهم غير فخر»","حسن","Sahih al-Jami al-Saghir 781","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"782","«إذا كان يوم القيامة نادى مناد: من عمل عملا لغير الله فليطلب ثوابه ممن عمله له»","حسن","Sahih al-Jami al-Saghir 782","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"783","«إذا كان يوم صوم أحدكم فلا يرفث ولا يجهل فإن امرء شاتمه أو قاتله فليقل: إني صائم إني صائم»","صحيح","Sahih al-Jami al-Saghir 783","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"784","«إذا كبر الإمام فكبروا وإذا ركع فاركعوا وإذا سجد فاسجدوا وإذا رفع رأسه من الركوع فارفعوا وإذا صلى جالسا فصلوا جلوسا أجمعين»","صحيح","Sahih al-Jami al-Saghir 784","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"785","«إذا كره الاثنان اليمين أو استحباها فليستهما عليها»","صحيح","Sahih al-Jami al-Saghir 785","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"786","«إذا كنتم ثلاثة فلا يتناج رجلان دون الآخر حتى تختلطوا بالناس فإن ذلك يحزنه»","صحيح","Sahih al-Jami al-Saghir 786","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"787","«إذا لبستم وإذا توضأتم فابدءوا بميامنكم»","صحيح","Sahih al-Jami al-Saghir 787","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"788","«إذا لعب الشيطان بأحدكم في منامه فلا يحدث به الناس»","صحيح","Sahih al-Jami al-Saghir 788","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"789","«إذا لقي أحدكم أخاه فليسلم عليه فإن حالت بينهما شجرة أو حائط أو حجر ثم لقيه فليسلم عليه»","صحيح","Sahih al-Jami al-Saghir 789","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"790","«إذا لقي الرجل أخاه المسلم فليقل: السلام عليكم ورحمة الله»","صحيح","Sahih al-Jami al-Saghir 790","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"791","«إذا لقيتم المشركين في الطريق فلا تبدءوهم بالسلام واضطروهم إلى أضيقها»","صحيح","Sahih al-Jami al-Saghir 791","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"792","«إذا مات أحدكم عرض عليه مقعده بالغداة والعشي إن كان من أهل الجنة فمن أهل الجنة وإن كان من أهل النار فمن أهل النار يقال له: هذا مقعدك حتى يبعثك الله إليه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 792","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"793","«إذا مات الإنسان انقطع عمله إلا من ثلاث صدقة جارية أو علم ينتفع به أو ولد صالح يدعو له»","صحيح","Sahih al-Jami al-Saghir 793","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"794","«إذا مات صاحبكم فدعوه لا تقعوا فيه»","صحيح","Sahih al-Jami al-Saghir 794","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"795","«إذا مات ولد العبد قال الله تعالى لملائكته: قبضتم ولد عبدي؟ فيقولون: نعم فيقول: قبضتم ثمرة فؤاده؟ فيقولون: نعم، فيقول: ماذا قال عبدي؟ فيقولون: حمدك واسترجع فيقول الله تعالى: ابنوا لعبدي بيتا في الجنة وسموه بيت الحمد»","حسن","Sahih al-Jami al-Saghir 795","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"796","«إذا مر أحدكم في مسجدنا أو في سوقنا ومعه نبل فليمسك على نصالها بكفه لا يعقر مسلما»","صحيح","Sahih al-Jami al-Saghir 796","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"797","إذا مر بالنطفة اثنتان وأربعون ليلة بعث الله إليها ملكا فصورها وخلق سمعها وبصرها وجلدها ولحمها وعظامها، ثم قال: يا رب أذكر أم أنثى؟ فيقضي ربك ما شاء ويكتب الملك، ثم ¤ يقول: يا رب أجله فيقول ربك ما شاء ويكتب الملك ثم يقول: يا رب رزقه فيقضي ربك ما شاء ويكتب الملك ثم يخرج الملك بالصحيفة في يده فلا يزيد على أمر ولا ينقص","صحيح","Sahih al-Jami al-Saghir 797","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"798","«إذا مر رجال بقوم فسلم رجل من الذين مروا على الجلوس ورد من هؤلاء واحد أجزأ عن هؤلاء وعن هؤلاء»","صحيح","Sahih al-Jami al-Saghir 798","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"799","«إذا مرض العبد أو سافر كتب الله تعالى له من الأجر مثل ما كان يعمل صحيحا مقيما»","صحيح","Sahih al-Jami al-Saghir 799","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"800","«إذا مرض العبد قال الله للكرام الكاتبين: اكتبوا لعبدي مثل الذي كان يعمل حتى أقبضه أو أعافيه»","صحيح","Sahih al-Jami al-Saghir 800","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"801","«إذا مشت أمتي المطيطاء وخدمها أبناء الملوك أبناء فارس والروم سلط شرارها على خيارها»","صحيح","Sahih al-Jami al-Saghir 801","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"802","«إذا مضى شطر الليل أو ثلثاه ينزل الله إلى السماء الدنيا فيقول: هل من سائل فيعطى؟ هل من داع فيستجاب له؟ هل من مستغفر فيغفر له؟ حتى ينفجر الصبح»","صحيح","Sahih al-Jami al-Saghir 802","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"803","«إذا نادى المنادي فتحت أبواب السماء واستجيب الدعاء»","صحيح","Sahih al-Jami al-Saghir 803","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"804","«إذا نام أحدكم وفي يده ريح غمر فلم يغسل يده فأصابه شيء فلا يلومن إلا نفسه»","صحيح","Sahih al-Jami al-Saghir 804","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"805","«إذا نزل أحدكم منزلا فليقل: أعوذ بكلمات الله التامات من شر ما خلق فإنه لا يضره شيء حتى يرتحل عنه»","صحيح","Sahih al-Jami al-Saghir 805","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"806","«إذا نسي أحدكم اسم الله على طعامه فليقل إذا ذكر: باسم الله أوله وآخره»","صحيح","Sahih al-Jami al-Saghir 806","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"807","«إذا نسي أحدكم صلاة أو نام عنها فليصليها إذا ذكرها»","صحيح","Sahih al-Jami al-Saghir 807","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"808","«إذا نظر أحدكم إلى من فضل عليه من المال والخلق فلينظر إلى من هو أسفل منه»","صحيح","Sahih al-Jami al-Saghir 808","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"809","«إذا نعس أحدكم وهو في المسجد فليتحول من مجلسه ذلك إلى غيره»","صحيح","Sahih al-Jami al-Saghir 809","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"810","«إذا نعس أحدكم وهو يصلي فليرقد حتى يذهب عنه النوم فإن أحدكم إذا صلى وهو ناعس لا يدري لعله يذهب يستغفر فيسب نفسه»","صحيح","Sahih al-Jami al-Saghir 810","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"811","«إذا نعس أحدكم وهو يصلي فلينصرف فلينم حتى يعلم ما يقول»","صحيح","Sahih al-Jami al-Saghir 811","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"812","«إذا نعس أحدكم يوم الجمعة فليتحول إلى مقعد صاحبه وليتحول صاحبه إلى مقعده»","صحيح","Sahih al-Jami al-Saghir 812","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"813","«إذا نعس الرجل وهو يصلي فلينصرف لعله يدعو على نفسه وهو لا يدري»","صحيح","Sahih al-Jami al-Saghir 813","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"814","«إذا نكح العبد بغير إذن مولاه فنكاحه باطل»","حسن","Sahih al-Jami al-Saghir 814","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"815","«إذا نمتم فأطفئوا المصباح فإن الفأرة تأخذ الفتيلة فتحرق أهل البيت وأغلقوا الأبواب وأوكئوا الأسقية وخمروا الشراب»","صحيح","Sahih al-Jami al-Saghir 815","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"816","«إذا نمتم فأطفئوا سرجكم فإن الشيطان يدل مثل هذه على هذا فيحرقكم»","صحيح","Sahih al-Jami al-Saghir 816","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"817","«إذا نودي بالصلاة أدبر الشيطان وله ضراط، حتى لا يسمع التأذين فإذا قضي النداء أقبل حتى إذا ثوب بالصلاة أدبر حتى إذا قضي التثويب أقبل حتى يخطر بين المرء ونفسه يقول: اذكر كذا واذكر كذا لما لم يكن يذكر حتى يظل الرجل لا يدري كم صلى»","صحيح","Sahih al-Jami al-Saghir 817","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"818","«إذا نودي بالصلاة فتحت أبواب السماء واستجيب الدعاء»","صحيح","Sahih al-Jami al-Saghir 818","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"819","«إذا نهق الحمار فتعوذا بالله من الشيطان الرجيم»","صحيح","Sahih al-Jami al-Saghir 819","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"820","«إذا وجد أحدكم ألما فليضع يده حيث يجد ألمه وليقل سبع مرات: أعوذ بعزة الله وقدرته على كل شيء من شر ما أجد»","صحيح","Sahih al-Jami al-Saghir 820","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"821","«إذا وجد أحدكم ذلك يعني المذي فلينضح فرجه وليتوضأ وضوءه للصلاة»","صحيح","Sahih al-Jami al-Saghir 821","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"822","إذا وجد أحدكم في بطنه شيئا فأشكل عليه أخرج ¤ منه شيء أم لا؟ فلا يخرجن من المسجد حتى يسمع صوتا أو يجد ريحا","صحيح","Sahih al-Jami al-Saghir 822","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"823","«إذا وجد أحدكم في صلاته رزا فلينصرف فليتوضأ»","صحيح","Sahih al-Jami al-Saghir 823","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"824","«إذا وجدت المرأة في المنام ما يجد الرجل فلتغتسل»","صحيح","Sahih al-Jami al-Saghir 824","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"825","«إذا وزنتم فأرجحوا»","صحيح","Sahih al-Jami al-Saghir 825","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"826","«إذا وسد الأمر إلى غير أهله فانتظر الساعة»","صحيح","Sahih al-Jami al-Saghir 826","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"827","«إذا وضع أحدكم بين يديه مثل مؤخرة الرحل فليصل ولا يبال من مر وراء ذلك»","صحيح","Sahih al-Jami al-Saghir 827","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"828","«إذا وضع السيف في أمتي لم يرتفع عنها إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 828","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"829","«إذا وضع الطعام فخذوا من حافته وذروا وسطه فإن البركة تنزل في وسطه»","صحيح","Sahih al-Jami al-Saghir 829","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"830","إذا وضعت الجنازة واحتملها الرجال على أعناقهم ¤ فإن كانت صالحة قالت: قدموني وإن كانت غير صالحة قالت لأهلها: يا ويلها أين تذهبون بها؟ يسمع صوتها كل شيء إلا الإنسان ولو سمعها الإنسان لصعق","صحيح","Sahih al-Jami al-Saghir 830","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"831","«إذا وضع عشاء أحدكم وأقيمت الصلاة فابدءوا بالعشاء ولا يعجل حتى يفرغ منه»","صحيح","Sahih al-Jami al-Saghir 831","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"832","«إذا وضعتم موتاكم في قبورهم فقولوا: بسم الله وعلى سنة رسول الله»","صحيح","Sahih al-Jami al-Saghir 832","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"833","«إذا وطئ الأذى أحدكم بنعله فإن التراب له طهور»","صحيح","Sahih al-Jami al-Saghir 833","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"834","«إذا وطئ الأذى بخفيه فطهورهما التراب»","صحيح","Sahih al-Jami al-Saghir 834","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"835","«إذا وقع الذباب في إناء أحدكم فليغمسه فإن في أحد جناحيه داء وفي الآخر شفاء وإنه يتقي بجناحه الذي فيه الداء فليغمسه كله ثم لينزعه»","صحيح","Sahih al-Jami al-Saghir 835","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"836","«إذا وقع الذباب في إناء أحدكم فليمقله فيه فإن في أحد جناحيه سما وفي الآخر شفاء وإنه يقدم السم ويؤخر الشفاء»","صحيح","Sahih al-Jami al-Saghir 836","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"837","«إذا وقع الذباب في شراب أحدكم فليغمسه ثم لينزعه فإن في أحد جناحيه داء وفي الآخر شفاء»","صحيح","Sahih al-Jami al-Saghir 837","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"838","«إذا وقعت الحدود وصرفت الطرق فلا شفعة»","صحيح","Sahih al-Jami al-Saghir 838","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"839","«إذا ولج الرجل بيته فليقل: اللهم إني أسألك خير المولج وخير المخرج باسم الله ولجنا وباسم الله خرجنا وعلى الله ربنا توكلنا ثم يسلم على أهله»","صحيح","Sahih al-Jami al-Saghir 839","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"840","«إذا ولغ الكلب في الإناء فاغسلوه سبع مرات وعفروه الثامنة بالتراب»","صحيح","Sahih al-Jami al-Saghir 840","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"841","«إذا ولغ الكلب في إناء أحدكم فليرقه ثم ليغسله سبع مرات»","صحيح","Sahih al-Jami al-Saghir 841","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"842","«إذا ولغ الكلب في إناء أحدكم فليغسله سبع مرات»","صحيح","Sahih al-Jami al-Saghir 842","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"843","«إذا ولغ الكلب في إناء أحدكم فليغسله سبع مرات أولاهن بالتراب»","صحيح","Sahih al-Jami al-Saghir 843","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"844","«إذا ولي أحدكم أخاه فليحسن كفنه»","صحيح","Sahih al-Jami al-Saghir 844","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"845","«إذا ولي أحدكم أخاه فليحسن كفنه فإنهم يبعثون في أكفانهم ويتزاورون في أكفانهم»","صحيح","Sahih al-Jami al-Saghir 845","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"846","«إذا هلك كسرى فلا كسرى بعده وإذا هلك قيصر فلا قيصر بعده والذي نفسي بيده لتنفقن كنوزهما في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 846","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"847","«إذا هم أحدكم بالأمر فليركع ركعتين من غير الفريضة ثم ليقل: اللهم إني أستخيرك بعلمك وأستقدرك بقدرتك وأسألك من فضلك العظيم فإنك تقدر ولا أقدر وتعلم ولا أعلم وأنت علام الغيوب، اللهم فإن كنت تعلم هذا الأمر وتسميه باسمه خيرا لي في ديني ومعاشي وعاقبة أمري فاقدره لي ويسره لي ثم بارك لي فيه، اللهم وإن كنت تعلمه شرا لي في ديني ومعاشي وعاقبة أمري فاصرفني عنه واصرفه عني واقدر لي الخير حيث كان ثم رضني به»","صحيح","Sahih al-Jami al-Saghir 847","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"848","«اذبحوا لله في أي شهر كان وبروا لله وأطعموا»","صحيح","Sahih al-Jami al-Saghir 848","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"849","«اذكر الموت في صلاتك فإن الرجل إذا ذكر الموت في صلاته لحري أن يحسن صلاته وصل صلاة رجل لا يظن أنه يصلي صلاة غيرها وإياك وكل أمر يعتذر منه»","حسن","Sahih al-Jami al-Saghir 849","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"850","«أذن في الناس أن من كان أكل فليصم بقية يومه ومن لم يكن أكل فليصم فإن اليوم يوم عاشوراء»","صحيح","Sahih al-Jami al-Saghir 850","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"851","«أذن في الناس أنه من شهد أن لا إله إلا الله وحده لا شريك له مخلصا دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 851","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"852","«إذنك علي أن يرفع الحجاب وأن تستمع لسوادي حتى أنهاك»","صحيح","Sahih al-Jami al-Saghir 852","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"853","«أذن لي أن أحدث عن ملك من حملة العرش رجلاه في الأرض السفلى وعلى قرنه العرش وبين شحمة أذنيه وعاتقه خفقان الطير سبعمائة عام يقول ذلك الملك سبحانك حيث كنت»","صحيح","Sahih al-Jami al-Saghir 853","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"854","«أذن لي أن أحدث عن ملك من ملائكة الله تعالى حملة العرش ما بين شحمة أذنه إلى عاتقه مسيرة سبعمائة سنة»","صحيح","Sahih al-Jami al-Saghir 854","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"855","«أذهب الباس رب الناس اشف أنت الشافي لا شفاء إلا شفاؤك شفاء لا يغادر سقما»","صحيح","Sahih al-Jami al-Saghir 855","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"856","«اذهبا وتوخيا ثم استهما ثم اقتسما ثم ليحلل كل واحد منكما صاحبه»","حسن","Sahih al-Jami al-Saghir 856","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"857","«اذهب بنعلي هاتين فمن لقيت من وراء هذا الحائط يشهد أن لا إله إلا الله مستيقنا بها قلبه فبشره بالجنة»","صحيح","Sahih al-Jami al-Saghir 857","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"858","«اذهب فاغتسل بماء وسدر وألق عنك شعر الكفر»","حسن","Sahih al-Jami al-Saghir 858","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"859","«اذهب فانظر إليها فإنه أحرى أن يؤدم بينكما»","صحيح","Sahih al-Jami al-Saghir 859","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"860","اذهب فإن في البيت ثلاثة منهم غلام قد صلى ¤ فخذه ولا تضربه فإنا قد نهينا عن ضرب أهل الصلاة","حسن","Sahih al-Jami al-Saghir 860","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"861","«اذهب فقد ملكتكها بما معك من القرآن»","حسن","Sahih al-Jami al-Saghir 861","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"862","«اذهبوا إلى صاحبكم فأخبروه أن ربي قد قتل ربه الليلة - يعني كسرى -»","صحيح","Sahih al-Jami al-Saghir 862","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"863","«اذهبوا بهذا الماء فإذا قدمتم بلدكم فاكسروا بيعتكم وانضحوا مكانها من هذا الماء واتخذوها مسجدا»","صحيح","Sahih al-Jami al-Saghir 863","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"864","«اذهبوا بهذه الخميصة إلى أبي جهم بن حذيفة وأتوني بأنبجانيته فإنها ألهتني آنفا في صلاتي»","صحيح","Sahih al-Jami al-Saghir 864","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"865","«اذهبوا به - يعني بأبي قحافة - إلى بعض نسائه فليغيره بشيء وجنبوه السواد»","صحيح","Sahih al-Jami al-Saghir 865","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"866","«أرى أن تجعلها في الأقربين»","صحيح","Sahih al-Jami al-Saghir 866","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"867","«أرى رؤياكم قد تواطأت في السبع الأواخر فمن كان متحريها فليتحرها في السبع الأواخر»","صحيح","Sahih al-Jami al-Saghir 867","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"868","«أرأف أمتي بأمتي أبو بكر وأشدهم في دين الله عمر وأصدقهم حياء عثمان وأقضاهم علي وأفرضهم زيد بن ثابت وأقرؤهم أبي وأعلمهم بالحلال والحرام معاذ بن جبل ألا وإن لكل أمة أمينا وأمين هذه الأمة أبو عبيدة بن الجراح»","صحيح","Sahih al-Jami al-Saghir 868","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"869","«أراني الليلة عند الكعبة فرأيت رجلا آدم كأحسن ما أنت راء من أدم الرجال له لمة كأحسن ما أنت راء من اللمم قد رجلها فهي تقطر ماء متكئا على رجلين يطوف بالبيت فسألت من هذا؟ فقيل لي: المسيح ابن مريم، ثم إذا أنا برجل جعد قطط أعور العين اليمنى كأنها عنبة طافية فسألت من هذا؟ فقيل لي: المسيح الدجال»","صحيح","Sahih al-Jami al-Saghir 869","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"870","«أراني في المنام أتسوك بسواك فجاءني رجلان أحدهما أكبر من الآخر فناولت السواك الأصغر منهما فقيل لي: كبر فدفعته إلى الأكبر منهما»","صحيح","Sahih al-Jami al-Saghir 870","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"871","«أرأيتكم ليلتكم هذه؟ فإن على رأس مئة سنة منها لا يبقى من هو على ظهر الأرض أحدا»","صحيح","Sahih al-Jami al-Saghir 871","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"872","«أربى الربا شتم الأعراض................. ... »","صحيح","Sahih al-Jami al-Saghir 872","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"873","«أربع إذا كن فيك فلا عليك ما فاتك من الدنيا صدق الحديث وحفظ الأمانة وحسن الخلق وعفة مطعم»","صحيح","Sahih al-Jami al-Saghir 873","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"874","«أربع أفضل الكلام لا يضرك بأيهن بدأت: سبحان الله والحمد لله ولا إله إلا الله والله أكبر»","صحيح","Sahih al-Jami al-Saghir 874","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"875","«أربع بقين في أمتي من أمر الجاهلية ليسوا بتاركيها: الفخر بالأحساب والطعن في الأنساب والاستسقاء بالنجوم والنياحة على الميت، وإن النائحة إذا لم تتب قبل الموت جاءت يوم القيامة عليها سربال من قطران ودرع من لهب النار»","صحيح","Sahih al-Jami al-Saghir 875","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"876","«أربعة أنهار من أنهار الجنة سيحان وجيحان والنيل والفرات»","صحيح","Sahih al-Jami al-Saghir 876","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"877","أربعة تجري عليهم أجورهم بعد الموت: من مات مرابطا ¤ في سبيل الله ومن علم علما أجري له عمله ما عمل به ومن تصدق بصدقة فأجرها يجري له ما وجدت ورجل ترك ولدا صالحا فهو يدعو له","حسن","Sahih al-Jami al-Saghir 877","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"878","«أربعة دنانير: دينار أعطيته مسكينا ودينار أعطيته في رقبة ودينار أنفقته في سبيل الله ودينار أنفقته على أهلك أفضلها الذي أنفقته على أهلك»","صحيح","Sahih al-Jami al-Saghir 878","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"879","«أربعة من الدواب لا يقتلن: النملة والنحلة والهدهد والصرد»","صحيح","Sahih al-Jami al-Saghir 879","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"880","«أربعة يبغضهم الله تعالى: البياع الحلاف والفقير المختال والشيخ الزاني والإمام الجائر»","صحيح","Sahih al-Jami al-Saghir 880","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"881","أربعة يحتجون يوم القيامة: رجل أصم لا يسمع شيئا ورجل أحمق ورجل هرم ورجل مات في فترة: فأما الأصم فيقول: رب لقد جاء الإسلام وما أسمع شيئا وأما الأحمق فيقول: رب جاء الإسلام وما أعقل شيئا والصبيان يحذفونني بالبعر، وأما الهرم فيقول: رب لقد جاء الإسلام وما أعقل شيئا، وأما الذي مات في الفترة فيقول: رب ما أتاني لك رسول فيأخذ مواثيقهم ليطيعنه، فيرسل إليهم أن ادخلوا النار فمن ¤ دخلها كانت عليه بردا وسلاما ومن لم يدخلها سحب إليها","صحيح","Sahih al-Jami al-Saghir 881","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"882","«أربع ركعات قبل الظهر يعدلن بصلاة السحر»","حسن","Sahih al-Jami al-Saghir 882","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"883","«أربع في أمتي من أمر الجاهلية لا يتركوهن: الفخر في الأحساب والطعن في الأنساب والاستسقاء بالنجوم والنياحة»","صحيح","Sahih al-Jami al-Saghir 883","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"884","«أربع في أمتي من أمر الجاهلية لم يدعهن الناس: الطعن في الأنساب والنياحة على الميت والأنواء مطرنا بنوء كذا وكذا والإعداء جرب بعير فأجرب مئة بعير فمن أجرب البعير الأول» ؟!","حسن","Sahih al-Jami al-Saghir 884","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"885","«أربع قبل الظهر ليس فيهن تسليم تفتح لهن أبواب السماء»","حسن","Sahih al-Jami al-Saghir 885","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"886","«أربع لا يجزين في الأضاحي: العوراء البين عورها والمريضة البين مرضها والعرجاء البين ظلعها والعجفاء التي لا تنقي»","صحيح","Sahih al-Jami al-Saghir 886","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"887","«أربع من السعادة: المرأة الصالحة والمسكن الواسع والجار الصالح والمركب الهنيء، وأربع من الشقاء: المرأة السوء والجار السوء والمركب السوء والمسكن الضيق»","صحيح","Sahih al-Jami al-Saghir 887","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"888","«أربع من عمل الأحياء تجري للأموات: رجل ترك عقبا صالحا يدعو له ينفعه دعاؤهم ورجل تصدق بصدقة جارية من بعده له أجرها ما جرت بعده ورجل علم علما فعمل به من بعده له مثل أجر من عمل به من غير أن ينقص من أجر من يعمل به شيء»","حسن","Sahih al-Jami al-Saghir 888","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"889","«أربع من كن فيه كان منافقا خالصا ومن كانت فيه خصلة منهن كانت فيه خصلة من النفاق حتى يدعها: إذا ائتمن خان وإذا حدث كذب وإذا عاهد غدر وإذا خاصم فجر»","صحيح","Sahih al-Jami al-Saghir 889","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"890","«أربع من كن فيه كان منافقا خالصا ومن كانت فيه خصلة منهن كانت فيه خصلة من النفاق حتى يدعها: إذا حدث كذب وإذا وعد أخلف وإذا عاهد غدر وإذا خاصم فجر»","صحيح","Sahih al-Jami al-Saghir 890","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"891","«أربعون خصلة أعلاهن منحة العنز لا يعمل عبد بخصلة منها رجاء ثوابها وتصديق موعودها إلا أدخله الله تعالى بها الجنة»","صحيح","Sahih al-Jami al-Saghir 891","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"892","«ارجع إلى أبويك فاستأذنهما فإن أذنا لك فجاهد وإلا فبرهما»","صحيح","Sahih al-Jami al-Saghir 892","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"893","«ارجعوا إلى أهليكم فكونوا فيهم وعلموهم ومروهم وصلوا كما رأيتموني أصلي فإذا حضرت الصلاة فليؤذن لكم أحدكم وليؤمكم أكبركم»","صحيح","Sahih al-Jami al-Saghir 893","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"894","«أرحامكم أرحامكم»","صحيح","Sahih al-Jami al-Saghir 894","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"895","«أرحم أمتي بأمتي أبو بكر وأشدهم في أمر الله عمر وأصدقهم حياء عثمان وأقرؤهم لكتاب الله أبي بن كعب وأفرضهم زيد بن ثابت وأعلمهم بالحلال والحرام معاذ بن جبل ولكل أمة أمين وأمين هذه الأمة أبو عبيدة بن الجراح»","صحيح","Sahih al-Jami al-Saghir 895","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"896","«ارحم من في الأرض يرحمك من في السماء»","صحيح","Sahih al-Jami al-Saghir 896","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"897","«ارحموا ترحموا واغفروا يغفر لكم، ويل لأقماع القول ويل للمصرين الذين يصرون على ما فعلوا وهم يعلمون»","صحيح","Sahih al-Jami al-Saghir 897","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"898","أرسل ملك الموت إلى موسى فلما جاءه صكه ففقأ ¤ عينه فرجع إلى ربه فقال: أرسلتني إلى عبد لا يريد الموت فرد الله إليه عينه، وقال ارجع إليه وقل له: يضع يده على متن ثور فله بما غطت يده بكل شعرة سنة. قال: أي رب! ثم ماذا؟ قال: ثم الموت. قال: فالآن، فسأل الله أن يدنيه من الأرض المقدسة رمية بحجر فلو كنت ثم لأريتكم قبره إلى جانب الطريق تحت الكثيب الأحمر","صحيح","Sahih al-Jami al-Saghir 898","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"899","«أرض الجنة خبزة بيضاء»","صحيح","Sahih al-Jami al-Saghir 899","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"900","«ارضخي ما استطعت ولا توعي فيوعي الله عليك»","صحيح","Sahih al-Jami al-Saghir 900","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"901","«أرضوا مصدقيكم»","صحيح","Sahih al-Jami al-Saghir 901","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"902","«ارفع إزارك واتق الله»","صحيح","Sahih al-Jami al-Saghir 902","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"903","«ارفعوا عن بطن عرنة وارفعوا عن بطن محسر»","صحيح","Sahih al-Jami al-Saghir 903","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"904","«ارفعوا عن بطن محسر وعليكم بمثل حصا الخذف»","صحيح","Sahih al-Jami al-Saghir 904","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"905","«أرقاءكم أرقاءكم فأطعموهم مما تأكلون وألبسوهم مما تلبسون وإن جاءوا بذنب لا تريدون أن تغفروه فبيعوا عباد الله ولا تعذبوهم»","حسن","Sahih al-Jami al-Saghir 905","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"906","«ارقي ما لم يكن شرك بالله»","صحيح","Sahih al-Jami al-Saghir 906","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"907","«اركبوا الهدي بالمعروف حتى تجدوا ظهرا»","صحيح","Sahih al-Jami al-Saghir 907","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"908","«اركبوا هذه الدواب سالمة واتدعوها سالمة ولا تتخذوها كراسي لأحاديثكم في الطرق والأسواق فرب مركوبة خير من راكبها وأكثر ذكرا منه»","صحيح","Sahih al-Jami al-Saghir 908","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"909","«اركعوا هاتين الركعتين في بيوتكم: السبحة بعد المغرب»","حسن","Sahih al-Jami al-Saghir 909","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"910","«ارموا الجمرة بمثل حصى الخذف»","صحيح","Sahih al-Jami al-Saghir 910","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"911","«ارموا بني إسماعيل فإن أباكم كان راميا»","صحيح","Sahih al-Jami al-Saghir 911","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"912","«أرواح المؤمنين في أجواف طير خضر تعلق في أشجار الجنة حتى يردها الله إلى أجسادها يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 912","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"913","«أريت الجنة فرأيت امرأة أبي طلحة ثم سمعت خشخشة أمامي فإذا بلال»","صحيح","Sahih al-Jami al-Saghir 913","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"914","«أريت قوما من أمتي يركبون ظهر البحر كالملوك على الأسرة»","صحيح","Sahih al-Jami al-Saghir 914","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"915","«أريتك في المنام مرتين يحملك الملك في سرقة من حرير فيقول: هذه امرأتك فأكشف عنها فإذا أنت هي فأقول: إن يكن هذا من عند الله يمضه»","صحيح","Sahih al-Jami al-Saghir 915","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"916","«أريت ليلة القدر ثم أنسيتها وأراني صبيحتها أسجد في ماء وطين»","صحيح","Sahih al-Jami al-Saghir 916","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"917","«أريت ليلة القدر ثم أيقظني بعض أهلي فنسيتها فالتمسوها في العشر الغوابر»","صحيح","Sahih al-Jami al-Saghir 917","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"918","«أريت ما تلقى أمتي من بعدي وسفك بعضهم دماء بعض وكان ذلك سابقا من الله كما سبق في الأمم قبلهم فسألته أن يوليني شفاعة فيهم يوم القيامة ففعل»","صحيح","Sahih al-Jami al-Saghir 918","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"919","«إزرة المؤمن إلى أنصاف ساقيه»","صحيح","Sahih al-Jami al-Saghir 919","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"920","«إزرة المؤمن إلى عضلة ساقيه ثم إلى الكعبين فما كان أسفل من ذلك ففي النار»","صحيح","Sahih al-Jami al-Saghir 920","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"921","«إزرة المؤمن إلى نصف الساق ولا جناح عليه فيما بينه وبين الكعبين ما كان أسفل من الكعبين فهو في النار من جر إزاره بطرا لم ينظر الله إليه»","صحيح","Sahih al-Jami al-Saghir 921","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"922","«ازهد في الدنيا يحبك الله وازهد فيما أيدي الناس يحبك الناس»","صحيح","Sahih al-Jami al-Saghir 922","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"923","«ازهد في الدنيا يحبك الله وأما الناس فانبذ إليهم هذا يحبوك»","صحيح","Sahih al-Jami al-Saghir 923","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"924","«أسامة أحب الناس إلي»","صحيح","Sahih al-Jami al-Saghir 924","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"925","«إسباغ الوضوء شطر الإيمان والحمد لله تملأ الميزان والتسبيح والتكبير يملأ السموات والأرض والصلاة نور والزكاة برهان والصبر ضياء والقرآن حجة لك أو عليك كل الناس يغدو فبائع نفسه فمعتقها أو موبقها»","صحيح","Sahih al-Jami al-Saghir 925","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"926","«إسباغ الوضوء في المكاره وإعمال الأقدام إلى المساجد وانتظار الصلاة بعد الصلاة يغسل الخطايا غسلا»","صحيح","Sahih al-Jami al-Saghir 926","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"927","«أسبغ الوضوء وخلل بين الأصابع وبالغ في الاستنشاق إلا أن تكون صائما»","صحيح","Sahih al-Jami al-Saghir 927","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"928","«أسبغوا الوضوء»","صحيح","Sahih al-Jami al-Saghir 928","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"929","«استأخرن فإنه ليس لكن أن تحققن الطريق عليكن بحافات الطريق»","حسن","Sahih al-Jami al-Saghir 929","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"930","«استأمروا النساء في أبضاعهن»","صحيح","Sahih al-Jami al-Saghir 930","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"931","«استبرءوهن بحيضة - يعني السبايا -»","صحيح","Sahih al-Jami al-Saghir 931","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"932","«استجيروا بالله من عذاب القبر فإن عذاب القبر حق»","صحيح","Sahih al-Jami al-Saghir 932","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"933","«استحيوا فإن الله لا يستحيي من الحق لا تأتوا النساء في أدبارهن»","حسن","Sahih al-Jami al-Saghir 933","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"934","«استحيوا فإن الله لا يستحيي من الحق لا يحل مأتى النساء في حشوشهن»","حسن","Sahih al-Jami al-Saghir 934","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"935","«استحيوا من الله تعالى حق الحياء من استحيا من الله حق الحياء فليحفظ الرأس وما وعى وليحفظ البطن وما حوى وليذكر الموت والبلا ومن أراد الآخرة ترك زينة الحياة الدنيا فمن فعل ذلك فقد استحيا من الله حق الحياء»","حسن","Sahih al-Jami al-Saghir 935","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"936","استذكروا القرآن فهو أشد تفصيا من صدور الرجال ¤ من النعم من عقلها","صحيح","Sahih al-Jami al-Saghir 936","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"937","«استرقوا لها فإن بها النظرة»","صحيح","Sahih al-Jami al-Saghir 937","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"938","«استعيذوا بالله من العين فإن العين حق»","صحيح","Sahih al-Jami al-Saghir 938","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"939","«استعيذوا بالله من الفقر والعيلة ومن أن تظلموا أو تظلموا»","حسن","Sahih al-Jami al-Saghir 939","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"940","«استعيذوا بالله من شر جار المقام فإن جار المسافر إذا شاء أن يزايل زايل»","صحيح","Sahih al-Jami al-Saghir 940","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"941","«استعيذوا بالله من عذاب القبر استعيذوا بالله من عذاب جهنم استعيذوا بالله من فتنة المسيح الدجال استعيذوا بالله من فتنة المحيا والممات»","صحيح","Sahih al-Jami al-Saghir 941","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"942","«استعيذوا بالله من عذاب القبر إنهم يعذبون في قبورهم عذابا تسمعه البهائم»","صحيح","Sahih al-Jami al-Saghir 942","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"943","«استعينوا على إنجاح الحوائج بالكتمان فإن كل ذي نعمة محسود»","صحيح","Sahih al-Jami al-Saghir 943","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"944","«استغفروا ربكم إني استغفر الله وأتوب إليه كل يوم مئة مرة»","صحيح","Sahih al-Jami al-Saghir 944","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"945","«استغفروا لأخيكم وسلوا له التثبيت فإنه الآن يسأل»","صحيح","Sahih al-Jami al-Saghir 945","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"946","«استغفروا لماعز بن مالك لقد تاب توبة لو قسمت بين أمة لوسعتهم»","صحيح","Sahih al-Jami al-Saghir 946","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"947","«استغنوا عن الناس ولو بشوص السواك»","صحيح","Sahih al-Jami al-Saghir 947","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"948","«استفت نفسك وإن أفتاك المفتون»","حسن","Sahih al-Jami al-Saghir 948","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"949","«استقبل صلاتك فلا صلاة لمن صلى خلف الصف وحده»","صحيح","Sahih al-Jami al-Saghir 949","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"950","«استقرءوا القرآن من أربعة: من عبد الله بن مسعود وسالم مولى أبي حذيفة وأبي بن كعب ومعاذ بن جبل»","صحيح","Sahih al-Jami al-Saghir 950","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"951","«استقم وليحسن خلقك للناس»","حسن","Sahih al-Jami al-Saghir 951","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"952","«استقيموا ولن تحصوا واعلموا أن خير أعمالكم الصلاة ولا يحافظ على الوضوء إلا مؤمن»","صحيح","Sahih al-Jami al-Saghir 952","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"953","«استقيموا ونعما إن استقمتم وخير أعمالكم الصلاة ولن يحافظ على الوضوء إلا مؤمن»","صحيح","Sahih al-Jami al-Saghir 953","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"954","«استكثروا من النعال فإن الرجل لا يزال راكبا ما دام منتعلا»","صحيح","Sahih al-Jami al-Saghir 954","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"955","«استمتعوا من هذا البيت فإنه قد هدم مرتين ويرفع في الثالثة»","صحيح","Sahih al-Jami al-Saghir 955","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"956","«استنثروا مرتين بالغتين أو ثلاثا»","صحيح","Sahih al-Jami al-Saghir 956","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"957","«أستودع الله دينك وأمانتك وخواتيم عملك»","صحيح","Sahih al-Jami al-Saghir 957","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"958","«أستودعك الله الذي لا تضيع ودائعه»","صحيح","Sahih al-Jami al-Saghir 958","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"959","«استوصوا بالأنصار خيرا»","صحيح","Sahih al-Jami al-Saghir 959","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"960","«استوصوا بالنساء خيرا فإن المرأة خلقت من ضلع وإن أعوج شيء في الضلع أعلاه فإن ذهبت تقيمه كسرته وإن تركته لم يزل أعوج فاستوصوا بالنساء خيرا»","صحيح","Sahih al-Jami al-Saghir 960","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"961","«استووا ولا تختلفوا فتختلف قلوبكم وليلني منكم أولو الأحلام والنهي ثم الذين يلونهم ثم الذين يلونهم»","صحيح","Sahih al-Jami al-Saghir 961","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"962","«أسرع قبائل العرب فناء قريش يوشك أن تمر المرأة بالنعل فتقول: هذه نعل قرشي»","صحيح","Sahih al-Jami al-Saghir 962","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"963","«أسرعكن لحاقا بي أطولكن يدا»","صحيح","Sahih al-Jami al-Saghir 963","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"964","«أسرعوا بالجنازة فإن تك صالحة فخير تقدمونها إليه وإن تك سوى ذلك فشر تضعونه عن رقابكم»","صحيح","Sahih al-Jami al-Saghir 964","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"965","أسرف رجل على نفسه فلما حضره الموت ¤ أوصى بنيه فقال: إذا أنا مت فأحرقوني ثم اسحقوني ثم اذروني في البحر فوالله لئن قدر علي ربي ليعذبني عذابا ما عذبه أحدا ففعلوا ذلك به فقال الله للأرض: أدي ما أخذت فإذا هو قائم فقال: ما حملك على ما صنعت؟ قال خشيتك يا رب فغفر له بذلك","صحيح","Sahih al-Jami al-Saghir 965","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"966","«أسرق الناس الذي يسرق صلاته: لا يتم ركوعها ولا سجودها، وأبخل الناس من بخل بالسلام»","صحيح","Sahih al-Jami al-Saghir 966","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"967","«أسعد الناس بشفاعتي يوم القيامة من قال: لا إله إلا الله خالصا مخلصا من قلبه»","صحيح","Sahih al-Jami al-Saghir 967","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"968","«اسعوا فإن الله قد كتب عليكم السعي»","صحيح","Sahih al-Jami al-Saghir 968","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"969","«أسفر بصلاة الصبح حتى يرى القوم مواقع نبلهم»","صحيح","Sahih al-Jami al-Saghir 969","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"970","«أسفروا بالفجر فإنه أعظم للأجر»","صحيح","Sahih al-Jami al-Saghir 970","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"971","«أسلم الناس وآمن عمرو بن العاص»","حسن","Sahih al-Jami al-Saghir 971","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"972","«أسلمت على ما أسلفت من خير»","صحيح","Sahih al-Jami al-Saghir 972","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"973","«أسلم ثم قاتل»","صحيح","Sahih al-Jami al-Saghir 973","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"974","«أسلم وإن كنت كارها»","صحيح","Sahih al-Jami al-Saghir 974","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"975","«أسلم سالمها الله وغفار غفر الله لها أما والله ما أنا قلته ولكن الله قاله»","صحيح","Sahih al-Jami al-Saghir 975","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"976","«أسلم وغفار وأشجع ومزينة وجهينة ومن كان من بني كعب موالي دون الناس والله ورسوله مولاهم»","صحيح","Sahih al-Jami al-Saghir 976","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"977","«أسلم وغفار وشيء من مزينة وجهينة خير عند الله من أسد وتميم وهوازن وغطفان»","صحيح","Sahih al-Jami al-Saghir 977","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"978","«أسلم وغفار ومزينة خير من تميم وأسد وغطفان وعامر بن صعصعة»","صحيح","Sahih al-Jami al-Saghir 978","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"979","«اسم الله الأعظم الذي إذا دعي به أجاب في ثلاث سور من القرآن في البقرة وآل عمران وطه»","صحيح","Sahih al-Jami al-Saghir 979","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"980","«اسم الله الأعظم في هاتين الآيتين: {وَإِلَهُكُمْ إِلَهٌ وَاحِدٌ لا إِلَهَ إِلَّا هُوَ الرَّحْمَنُ الرَّحِيمُ} وفاتحة آل عمران {الم، اللَّهُ لا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ} »","حسن","Sahih al-Jami al-Saghir 980","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"981","«اسمحوا يسمح لكم»","صحيح","Sahih al-Jami al-Saghir 981","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"982","«اسمح يسمح لك»","صحيح","Sahih al-Jami al-Saghir 982","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"983","«اسمع وأطع ولو لعبد حبشي مجدع الأطراف»","صحيح","Sahih al-Jami al-Saghir 983","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"984","«اسمعوا وأطيعوا فإنما عليهم ما حملوا وعليكم ما حملتم»","صحيح","Sahih al-Jami al-Saghir 984","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"985","«اسمعوا وأطيعوا وإن استعمل عليكم عبد حبشي كأن رأسه زبيبة»","صحيح","Sahih al-Jami al-Saghir 985","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"986","«أسوأ الناس سرقة الذي يسرق من صلاته لا يتم ركوعها ولا سجودها ولا خشوعها»","صحيح","Sahih al-Jami al-Saghir 986","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"987","«أشبه من رأيت بجبريل دحية الكلبي»","صحيح","Sahih al-Jami al-Saghir 987","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"988","«اشتد غضب الله على من زعم أنه ملك الأملاك لا ملك إلا الله»","صحيح","Sahih al-Jami al-Saghir 988","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"989","«اشترى رجل من رجل عقارا له فوجد الرجل الذي اشترى العقار في عقاره جرة فيها ذهب فقال الذي اشترى العقار: خذ ذهبك مني إنما اشتريت منك الأرض ولم أبتع الذهب، وقال الذي له الأرض: إنما بعتك الأرض وما فيها فتحاكما إلى رجل فقال الذي تحاكما إليه: ألكما ولد؟ قال أحدهما: لي غلام، وقال الآخر: لي جارية. قال: أنكحوا الغلام الجارية وأنفقوا على أنفسكما منه وتصدقوا»","صحيح","Sahih al-Jami al-Saghir 989","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"990","«اشتكت النار إلى ربها فقالت: يا رب أكل بعضي بعضا فأذن لها بنفسين نفس في الشتاء ونفس في الصيف فهو أشد ما تجدون من الحر وأشد ما تجدون من الزمهرير»","صحيح","Sahih al-Jami al-Saghir 990","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"991","«اشتكت النار إلى ربها وقالت: يا رب أكل بعضي بعضا فجعل لها نفسين نفسا في الشتاء ونفسا في الصيف فأما نفسها في الشتاء فهو زمهرير وأما نفسها في الصيف فسموم»","صحيح","Sahih al-Jami al-Saghir 991","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"992","أشد الناس بلاء الأنبياء ثم الأمثل فالأمثل يبتلى الرجل على حسب دينه فإن كان في دينه صلبا اشتد بلاؤه، وإن كان في دينه رقة ابتلي على قدر دينه فما يبرح البلاء بالعبد حتى يتركه يمشي ¤ على الأرض وما عليه خطيئة","صحيح","Sahih al-Jami al-Saghir 992","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"993","«أشد الناس بلاء الأنبياء ثم الأمثل فالأمثل يبتلى الناس على قدر دينهم فمن ثخن دينه اشتد بلاؤه ومن ضعف دينه ضعف بلاؤه وإن الرجل ليصيبه البلاء حتى يمشي في الناس ما عليه خطيئة»","صحيح","Sahih al-Jami al-Saghir 993","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"994","«أشد الناس بلاء الأنبياء الصالحون ثم الأمثل فالأمثل»","صحيح","Sahih al-Jami al-Saghir 994","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"995","«أشد الناس بلاء الأنبياء ثم الصالحون لقد كان أحدهم يبتلى بالفقر حتى ما يجد إلا العباءة يجوبها فيلبسها ويبتلى بالقمل حتى يقتله ولأحدهم كان أشد فرحا بالبلاء من أحدكم بالعطاء»","صحيح","Sahih al-Jami al-Saghir 995","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"996","«أشد الناس بلاء الأنبياء ثم الذين يلونهم ثم الذين يلونهم»","صحيح","Sahih al-Jami al-Saghir 996","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"997","«أشد الناس عذابا عند الله يوم القيامة: الذين يضاهون بخلق الله»","صحيح","Sahih al-Jami al-Saghir 997","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"998","«أشد الناس عذابا للناس في الدنيا أشد الناس عذابا عند الله يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 998","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"999","«أشد الناس عذابا يوم القيامة: المصورون يقال لهم: أحيوا ما خلقتم»","صحيح","Sahih al-Jami al-Saghir 999","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1000","«أشد الناس عذابا يوم القيامة رجل قتل نبيا أو قتله نبي أو رجل يضل الناس بغير علم أو مصور يصور التماثيل»","حسن","Sahih al-Jami al-Saghir 1000","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1001","«أشد الناس يوم القيامة عذابا إمام جائر»","حسن","Sahih al-Jami al-Saghir 1001","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1002","«أشد أمتي حياء: عثمان بن عفان»","صحيح","Sahih al-Jami al-Saghir 1002","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1003","«أشد أمتي لي حبا قوم يكونون بعدي يود أحدهم أنه فقد أهله وماله وأنه رآني»","صحيح","Sahih al-Jami al-Saghir 1003","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1004","«أشعر كلمة تكلمت بها العرب كلمة لبيد: ألا كل شيء ما خلا الله باطل»","صحيح","Sahih al-Jami al-Saghir 1004","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1005","«اشفع الأذان وأوتر الإقامة»","صحيح","Sahih al-Jami al-Saghir 1005","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1006","«اشفعوا تؤجروا»","صحيح","Sahih al-Jami al-Saghir 1006","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1007","«اشفعوا تؤجروا ويقضي الله على لسان نبيه ما شاء»","صحيح","Sahih al-Jami al-Saghir 1007","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1008","«أشكر الناس لله أشكرهم للناس»","صحيح","Sahih al-Jami al-Saghir 1008","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1009","«أشهد أن لا إله إلا الله وأني رسول الله لا يلقى الله بهما عبد غير شاك فيهما إلا دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 1009","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1010","«أشيدوا النكاح»","حسن","Sahih al-Jami al-Saghir 1010","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1011","«أشيدوا النكاح وأعلنوه»","حسن","Sahih al-Jami al-Saghir 1011","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1012","«أصابع اليدين والرجلين سواء»","صحيح","Sahih al-Jami al-Saghir 1012","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1013","«أصدق كلمة قالها الشاعر كلمة لبيد: ألا كل شيء ما خلا الله باطل»","صحيح","Sahih al-Jami al-Saghir 1013","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1014","«اصرف بصرك»","صحيح","Sahih al-Jami al-Saghir 1014","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1015","«اصنعوا لآل جعفر طعاما فإنه قد أتاهم ما يشغلهم»","حسن","Sahih al-Jami al-Saghir 1015","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1016","«اصنعوا ما بدا لكم فما قضى الله تعالى فهو كائن وليس من كل الماء يكون الولد»","صحيح","Sahih al-Jami al-Saghir 1016","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1017","«أضل الله عن الجمعة من كان قبلنا فكان لليهود يوم السبت وكان للنصارى يوم الأحد فجاء الله بنا فهدانا الله ليوم الجمعة فجعل الجمعة والسبت والأحد، وكذلك هم تبع لنا يوم القيامة نحن الآخرون من أهل الدنيا والأولون يوم القيامة المقضي لهم قبل الخلائق»","صحيح","Sahih al-Jami al-Saghir 1017","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1018","«اضمنوا لي ستا من أنفسكم أضمن لكم الجنة اصدقوا إذا حدثتم وأوفوا إذا وعدتم وأدوا إذا ائتمنتم واحفظوا فروجكم وغضوا أبصاركم وكفوا أيديكم»","حسن","Sahih al-Jami al-Saghir 1018","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1019","أطب الكلام وأفش السلام وصل الأرحام وصل ¤ بالليل والناس نيام ثم ادخل الجنة بسلام","صحيح","Sahih al-Jami al-Saghir 1019","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1020","«أطت السماء ويحق لها أن تئط، والذي نفس محمد بيده ما فيها موضع شبر إلا وفيه جبهة ملك ساجد يسبح لله بحمده»","صحيح","Sahih al-Jami al-Saghir 1020","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1021","«أطعموا الطعام وأطيبوا الكلام»","صحيح","Sahih al-Jami al-Saghir 1021","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1022","«أطعموا الطعام وأفشوا السلام تورثوا الجنان»","صحيح","Sahih al-Jami al-Saghir 1022","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1023","«أطفال المؤمنين في جبل في الجنة يكفلهم إبراهيم وسارة حتى يردهم إلى آبائهم يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1023","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1024","«أطفال المشركين خدم أهل الجنة»","صحيح","Sahih al-Jami al-Saghir 1024","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1025","«أطفئوا المصابيح إذا رقدتم وأغلقوا الأبواب وأوكئوا الأسقية وخمروا الطعام والشراب ولو بعود تعرضه عليه»","صحيح","Sahih al-Jami al-Saghir 1025","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1026","«اطلبوا استجابة الدعاء عند التقاء الجيوش وإقامة الصلاة ونزول الغيث»","صحيح","Sahih al-Jami al-Saghir 1026","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1027","«اطلبوا ليلة القدر في العشر الأواخر فإن غلبتم فلا تغلبوا في السبع البواقي»","صحيح","Sahih al-Jami al-Saghir 1027","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1028","«اطلبوا ليلة القدر في العشر الأواخر في تسع يبقين وسبع يبقين وخمس يبقين وثلاث يبقين»","صحيح","Sahih al-Jami al-Saghir 1028","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1029","«اطلبوا ليلة القدر في العشر الأواخر من رمضان»","صحيح","Sahih al-Jami al-Saghir 1029","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1030","«اطلعت في الجنة فرأيت أكثر أهلها الفقراء واطلعت في النار فرأيت أكثر أهلها النساء»","صحيح","Sahih al-Jami al-Saghir 1030","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1031","«أطول الناس أعناقا يوم القيامة المؤذنون»","صحيح","Sahih al-Jami al-Saghir 1031","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1032","«أطيب الطيب المسك»","صحيح","Sahih al-Jami al-Saghir 1032","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1033","«أطيب الكسب عمل الرجل بيده وكل بيع مبرور»","صحيح","Sahih al-Jami al-Saghir 1033","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1034","«أطيعوني ما كنت بين أظهركم وعليكم بكتاب الله أحلوا حلاله وحرموا حرامه»","صحيح","Sahih al-Jami al-Saghir 1034","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1035","«أظلتكم فتن كقطع الليل المظلم أنجى الناس منها صاحب شاهقة يأكل من رسل غنمه أو رجل من وراء الدروب أخذ بعنان فرسه يأكل من ظل سيفه»","صحيح","Sahih al-Jami al-Saghir 1035","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1036","«أظنكم قد سمعتم أن أبا عبيدة قدم بشيء من البحرين فأبشروا وأملوا ما يسركم فوالله ما الفقر أخشى عليكم ولكن أخشى عليكم أن تبسط عليكم الدنيا كما بسطت على من كان قبلكم فتنافسوها كما تنافسوها فتهلككم كما أهلكتهم»","صحيح","Sahih al-Jami al-Saghir 1036","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1037","«اعبد الله كأنك تراه فإن لم تكن تراه فإنه يراك واحسب نفسك مع الموتى واتق دعوة المظلوم فإنها مستجابة»","حسن","Sahih al-Jami al-Saghir 1037","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1038","«اعبد الله كأنك تراه وعد نفسك في الموتى وإياك ودعوات المظلوم فإنهن مجابات وعليك بصلاة الغداة وصلاة العشاء فأشهدهما فلو تعلمون ما فيهما لأتيتموهما ولو حبوا»","حسن","Sahih al-Jami al-Saghir 1038","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1039","اعبد الله لا تشرك به شيئا وأقم الصلاة المكتوبة وأد الزكاة المفروضة وحج واعتمر وصم رمضان وانظر ما تحب ¤ للناس أن يأتوه إليك فافعله بهم وما تكره أن يأتوه إليك فذرهم منه","صحيح","Sahih al-Jami al-Saghir 1039","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1040","«اعبد الله ولا تشرك به شيئا واعمل لله كأنك تراه واعدد نفسك في الموتى واذكر الله تعالى عند كل حجر وكل شجر وإذا عملت سيئة فاعمل بجنبها حسنة السر بالسر والعلانية بالعلانية»","حسن","Sahih al-Jami al-Saghir 1040","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1041","«اعبدوا الرحمن وأفشوا السلام وأطعموا الطعام تدخلوا الجنان»","صحيح","Sahih al-Jami al-Saghir 1041","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1042","«اعتدلوا في السجود ولا يبسط أحدكم ذراعيه انبساط الكلب»","صحيح","Sahih al-Jami al-Saghir 1042","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1043","«أعتموا بهذه الصلاة فإنكم قد فضلتم بها على سائر الأمم ولم تصلها أمة قبلكم»","صحيح","Sahih al-Jami al-Saghir 1043","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1044","«أعجز الناس من عجز عن الدعاء وأبخل الناس من بخل بالسلام»","صحيح","Sahih al-Jami al-Saghir 1044","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1045","اعدد ستا بين يدي الساعة: موتي ثم فتح بيت المقدس ثم موتان يأخذ فيكم كقعاص الغنم، ثم استفاضة المال حتى يعطى الرجل مائة دينار فيظل ساخطا، ثم فتنة لا يبقى بيت من العرب إلا دخلته، ثم هدنة تكون بينكم وبين بني الأصفر فيغدرون فيأتونكم تحت ثمانين غاية تحت كل غاية اثنا عشر ألفا","صحيح","Sahih al-Jami al-Saghir 1045","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1046","«اعدلوا بين أولادكم في النحل كما تحبون أن يعدلوا بينكم في البر واللطف»","صحيح","Sahih al-Jami al-Saghir 1046","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1047","«أعذر الله إلى امرئ أخر أجله حتى بلغ ستين سنة»","صحيح","Sahih al-Jami al-Saghir 1047","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1048","«اعرضوا علي رقاكم لا بأس بالرقى ما لم يكن فيه شرك»","صحيح","Sahih al-Jami al-Saghir 1048","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1049","«أعرضوا عن الناس ألم تر أنك إن ابتغيت الريبة في الناس أفسدتهم أو كدت تفسدهم»","حسن","Sahih al-Jami al-Saghir 1049","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1050","«اعرف عددها ووعاءها ووكاءها ثم عرفها سنة فإن جاء صاحبها وإلا فهي كسبيل مالك»","صحيح","Sahih al-Jami al-Saghir 1050","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1051","اعرفوا أنسابكم تصلوا أرحامكم فإنه لا قرب ¤ ¤ بالرحم إذا قطعت وإن كانت قريبة ولا بعد بها إذا وصلت وإن كانت بعيدة","صحيح","Sahih al-Jami al-Saghir 1051","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1052","«اعزل الأذى عن طريق المسلمين»","صحيح","Sahih al-Jami al-Saghir 1052","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1053","«اعزل عنها إن شئت فإنه سيأتيها ما قدر لها»","صحيح","Sahih al-Jami al-Saghir 1053","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1054","«أعط كل سورة حظها من الركوع والسجود»","صحيح","Sahih al-Jami al-Saghir 1054","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1055","«أعطوا الأجير أجره قبل أن يجف عرقه»","حسن","Sahih al-Jami al-Saghir 1055","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1056","«أعطيت خمسا لم يعطهن أحد من الأنبياء قبلي: نصرت بالرعب مسيرة شهر وجعلت لي الأرض مسجدا وطهورا فأيما رجل من أمتي أدركته الصلاة فليصل وأحلت لي الغنائم ولم تحل لأحد قبلي وأعطيت الشفاعة وكان النبي يبعث إلى قومه خاصة وبعثت إلى الناس عامة»","صحيح","Sahih al-Jami al-Saghir 1056","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1057","أعطيت سبعين ألفا من أمتي يدخلون الجنة بغير حساب وجوههم كالقمر ليلة البدر قلوبهم على قلب رجل واحد فاستزدت ¤ ربي عز وجل فزادني مع كل واحد سبعين ألفا","صحيح","Sahih al-Jami al-Saghir 1057","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1058","«أعطيت فواتح الكلام وجوامعه وخواتمه»","صحيح","Sahih al-Jami al-Saghir 1058","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1059","«أعطيت مكان التوراة السبع الطوال وأعطيت مكان الزبور المئين وأعطيت مكان الإنجيل المثاني وفضلت بالمفصل»","صحيح","Sahih al-Jami al-Saghir 1059","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1060","«أعطيت هذه الآيات من آخر سورة البقرة من كنز تحت العرش لم يعطها نبي قبلي»","صحيح","Sahih al-Jami al-Saghir 1060","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1061","«أعطي ولا توكي فيوكي عليك»","صحيح","Sahih al-Jami al-Saghir 1061","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1062","«أعطي يوسف شطر الحسن»","صحيح","Sahih al-Jami al-Saghir 1062","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1063","«أعطي يوسف وأمه شطر الحسن»","صحيح","Sahih al-Jami al-Saghir 1063","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1064","«أعظم الأيام عند الله يوم النحر ثم يوم القر»","صحيح","Sahih al-Jami al-Saghir 1064","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1065","«أعظم الناس أجرا في الصلاة أبعدهم إليها ممشى فأبعدهم والذي ينتظر الصلاة حتى يصليها مع الإمام أعظم أجرا من الذي يصليها ثم ينام»","صحيح","Sahih al-Jami al-Saghir 1065","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1066","«أعظم الناس فرية اثنان: شاعر يهجوا القبيلة بأسرها ورجل انتفى من أبيه»","صحيح","Sahih al-Jami al-Saghir 1066","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1067","«أعفوا اللحى وجزوا الشوارب وغيروا شيبكم ولا تشبهوا باليهود والنصارى»","صحيح","Sahih al-Jami al-Saghir 1067","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1068","«اعقلها وتوكل»","حسن","Sahih al-Jami al-Saghir 1068","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1069","«اعلم أنك لا تسجد لله سجدة إلا رفع الله لك بها درجة وحط عنك بها خطيئة»","صحيح","Sahih al-Jami al-Saghir 1069","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1070","«اعلموا أنه ليس منكم من أحد إلا مال وارثه أحب إليه من ماله، مالك ما قدمت ومال وارثك ما أخرت»","صحيح","Sahih al-Jami al-Saghir 1070","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1071","«اعلم يا أبا مسعود أن الله أقدر عليك منك على هذا الغلام»","صحيح","Sahih al-Jami al-Saghir 1071","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1072","«أعلنوا النكاح»","حسن","Sahih al-Jami al-Saghir 1072","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1073","«أعمار أمتي ما بين الستين إلى السبعين وأقلهم من يجوز ذلك»","صحيح","Sahih al-Jami al-Saghir 1073","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1074","«اعملوا فكل ميسر لما خلق له»","صحيح","Sahih al-Jami al-Saghir 1074","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1075","«أعوذ بعزتك الذي لا إله إلا أنت أن تضلني أنت الحي الذي لا يموت والجن والإنس يموتون»","صحيح","Sahih al-Jami al-Saghir 1075","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1076","«اغتسلوا يوم الجمعة واغسلوا رءوسكم وإن لم تكونوا جنبا ومسوا من الطيب»","حسن","Sahih al-Jami al-Saghir 1076","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1077","اغتنم خمسا قبل خمس: حياتك قبل موتك وصحتك قبل سقمك وفراغك قبل شغلك وشبابك قبل هرمك وغناك قبل ¤ فقرك","صحيح","Sahih al-Jami al-Saghir 1077","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1078","«اغزوا باسم الله وفي سبيل الله وقاتلوا من كفر بالله اغزوا ولا تغلوا ولا تغدروا ولا تمثلوا ولا تقتلوا وليدا وإذا لقيت عدوك من المشركين فادعهم إلى ثلاث خصال فأيتهن ما أجابوك فاقبل منهم وكف عنهم: ادعهم إلى الإسلام فإن أجابوك فاقبل منهم وكف عنهم ; ثم ادعهم أن التحول من دارهم إلى دار المهاجرين وأخبرهم أنهم إن فعلوا ذلك فلهم ما للمهاجرين وعليهم ما على المهاجرين فإن أبوا أن يتحولوا منها فأخبرهم أنهم يكونون كأعراب المسلمين يجري عليهم حكم الله الذي يجري على المؤمنين ولا يكون لهم في الغنيمة والفيء شيء إلا أن يجاهدوا مع المسلمين فإن هم أبوا فسلهم الجزية فإن هم أجابوك فاقبل منهم وكف عنهم فإن أبوا فاستعن بالله وقاتلهم وإذا حاصرت أهل حصن وأرادوك أن تجعل لهم ذمة الله وذمة نبيه فلا تجعل لهم ذمة الله ولا ذمة نبيه ولكن اجعل لهم ذمتك وذمة أصحابك فإنكم إن تخفروا ذممكم وذمم أصحابكم أهون من أن تخفروا ذمة الله وذمة رسوله وإذا حاصرت أهل الحصن فأرادوك أن تنزلهم على حكم الله فلا تنزلهم على حكم الله ولكن أنزلهم على حكمك فإنك لا تدري أتصيب حكم الله فيهم أم لا»","صحيح","Sahih al-Jami al-Saghir 1078","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1079","اغسلوه بماء وسدر وكفنوه في ثوبيه ولا ¤ تمسوه طيبا ولا تخمروا رأسه ولا تحنطوه فإن الله يبعثه يوم القيامة ملبيا","صحيح","Sahih al-Jami al-Saghir 1079","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1080","«أغلقوا أبوابكم وخمروا آنيتكم وأطفئوا سرجكم وأوكئوا أسقيتكم فإن الشيطان لا يفتح بابا مغلقا ولا يكشف غطاء ولا يحل وكاء وإن الفويسقة تضرم البيت على أهله»","صحيح","Sahih al-Jami al-Saghir 1080","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1081","«أغيظ رجل على الله يوم القيامة وأخبثه وأغيظه عليه رجل كان يسمى ملك الأملاك لا ملك إلا الله»","صحيح","Sahih al-Jami al-Saghir 1081","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1082","«افترقت اليهود على إحدى وسبعين فرقة فواحدة في الجنة وسبعون في النار وافترقت النصارى على اثنتين وسبعين فرقة فإحدى وسبعون في النار وواحدة في الجنة والذي نفس محمد بيده لتفترقن أمتي على ثلاث وسبعين فرقة فواحدة في الجنة واثنتان وسبعون في النار»","صحيح","Sahih al-Jami al-Saghir 1082","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1083","«افترقت اليهود على إحدى وسبعين فرقة وتفرقت النصارى على اثنتين وسبعين فرقة وتفرقت أمتي على ثلاث وسبعين فرقة»","صحيح","Sahih al-Jami al-Saghir 1083","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1084","«أفرض أمتي زيد بن ثابت»","صحيح","Sahih al-Jami al-Saghir 1084","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1085","«أفش السلام وأطعم الطعام وصل الأرحام وقم بالليل والناس نيام وادخل الجنة بسلام»","صحيح","Sahih al-Jami al-Saghir 1085","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1086","«أفشوا السلام بينكم تحابوا»","صحيح","Sahih al-Jami al-Saghir 1086","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1087","«أفشوا السلام تسلموا»","حسن","Sahih al-Jami al-Saghir 1087","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1088","«أفشوا السلام كي تعلوا»","صحيح","Sahih al-Jami al-Saghir 1088","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1089","«أفشوا السلام وأطعموا الطعام وكونوا إخوانا كما أمركم الله»","صحيح","Sahih al-Jami al-Saghir 1089","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1090","«أفضل الإسلام الحنيفية السمحة»","حسن","Sahih al-Jami al-Saghir 1090","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1091","«أفضل الأعمال الإيمان بالله وحده ثم الجهاد ثم حجة برة تفضل سائر الأعمال كما بين مطلع الشمس إلى مغربها»","صحيح","Sahih al-Jami al-Saghir 1091","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1092","أفضل الأعمال الإيمان بالله وحده ثم الجهاد ثم حجة مبرورة تفضل سائر الأعمال كما بين مطلع الشمس إلى ¤ مغربها","صحيح","Sahih al-Jami al-Saghir 1092","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1093","«أفضل الأعمال الصلاة في أول وقتها»","صحيح","Sahih al-Jami al-Saghir 1093","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1094","«أفضل الأعمال الصلاة لوقتها وبر الوالدين»","صحيح","Sahih al-Jami al-Saghir 1094","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1095","«أفضل الأعمال الصلاة لوقتها وبر الوالدين والجهاد في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 1095","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1096","«أفضل الأعمال أن تدخل على أخيك المؤمن سرورا أو تقضي عنه دينا أو تطعمه خبزا»","حسن","Sahih al-Jami al-Saghir 1096","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1097","«أفضل الإيمان الصبر والسماحة»","صحيح","Sahih al-Jami al-Saghir 1097","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1098","«أفضل الأيام عند الله يوم الجمعة»","صحيح","Sahih al-Jami al-Saghir 1098","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1099","«أفضل الجهاد أن يجاهد الرجل نفسه وهواه»","صحيح","Sahih al-Jami al-Saghir 1099","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1100","«أفضل الجهاد كلمة حق عند سلطان جائر»","صحيح","Sahih al-Jami al-Saghir 1100","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1101","«أفضل الحج العج والثج»","حسن","Sahih al-Jami al-Saghir 1101","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1102","«أفضل الدعاء دعاء يوم عرفة وأفضل ما قلت أنا والنبيون من قبلي: لا إله إلا الله وحده لا شريك له»","حسن","Sahih al-Jami al-Saghir 1102","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1103","«أفضل الدنانير: دينار ينفقه الرجل على عياله ودينار ينفقه الرجل على دابته في سبيل الله ودينار ينفقه الرجل على أصحابه في سبيل الله عز وجل»","صحيح","Sahih al-Jami al-Saghir 1103","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1104","«أفضل الذكر: لا إله إلا الله وأفضل الدعاء: الحمد لله»","حسن","Sahih al-Jami al-Saghir 1104","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1105","«أفضل الرقاب أغلاها ثمنا وأنفسها عند أهله»","صحيح","Sahih al-Jami al-Saghir 1105","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1106","«أفضل الساعات جوف الليل الأخير»","صحيح","Sahih al-Jami al-Saghir 1106","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1107","«أفضل الشهداء الذين يقاتلون في الصف الأول فلا يلفتون وجوههم حتى يقتلوا أولئك يتلبطون في الغرف العلى من الجنة يضحك إليهم ربك فإذا ضحك ربك إلى عبد في موطن فلا حساب عليه»","صحيح","Sahih al-Jami al-Saghir 1107","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1108","«أفضل الشهداء من سفك دمه وعقر جواده»","صحيح","Sahih al-Jami al-Saghir 1108","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1109","«أفضل الصدقات ظل فسطاط في سبيل الله عز وجل أو منحة خادم في سبيل الله أو طروقة فحل في سبيل الله»","حسن","Sahih al-Jami al-Saghir 1109","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1110","«أفضل الصدقة الصدقة على ذي الرحم الكاشح»","صحيح","Sahih al-Jami al-Saghir 1110","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1111","«أفضل الصدقة أن تصدق وأنت صحيح شحيح تأمل الغنى وتخشى الفقر ولا تمهل حتى إذا بلغت الحلقوم قلت: لفلان كذا ولفلان كذا ألا وقد كان لفلان كذا»","صحيح","Sahih al-Jami al-Saghir 1111","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1112","«أفضل الصدقة جهد المقل وابدأ بمن تعول»","صحيح","Sahih al-Jami al-Saghir 1112","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1113","«أفضل الصدقة سقي الماء»","حسن","Sahih al-Jami al-Saghir 1113","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1114","«أفضل الصدقة ما ترك غنى واليد العليا خير من اليد السفلى وابدأ بمن تعول» (تقول المرأة: إما أن تطعمني وإما أن تطلقني ويقول العبد: أطعمني واستعملني; ويقول الابن: أطعمني إلى من تدعني؟!)","صحيح","Sahih al-Jami al-Saghir 1114","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1115","«أفضل الصدقة ما كان عن ظهر غنى واليد العليا خير من اليد السفلى وابدأ بمن تعول»","صحيح","Sahih al-Jami al-Saghir 1115","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1116","«أفضل الصلاة بعد المكتوبة الصلاة في جوف الليل وأفضل الصيام بعد شهر رمضان شهر الله المحرم»","صحيح","Sahih al-Jami al-Saghir 1116","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1117","«أفضل الصلاة صلاة المرء في بيته إلا المكتوبة»","صحيح","Sahih al-Jami al-Saghir 1117","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1118","«أفضل الصلاة طول القنوت»","صحيح","Sahih al-Jami al-Saghir 1118","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1119","«أفضل الصلوات عند الله صلاة الصبح يوم الجمعة في جماعة»","صحيح","Sahih al-Jami al-Saghir 1119","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1120","«أفضل الصوم صوم أخي داود كان يصوم يوما ويفطر يوما ولا يفر إذا لاقى»","صحيح","Sahih al-Jami al-Saghir 1120","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1121","«أفضل الصيام بعد رمضان الشهر الذي تدعونه المحرم»","صحيح","Sahih al-Jami al-Saghir 1121","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1122","«أفضل العبادة الدعاء»","صحيح","Sahih al-Jami al-Saghir 1122","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1123","«أفضل العمل الصلاة لوقتها والجهاد في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 1123","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1124","«أفضل العمل إيمان بالله وجهاد في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 1124","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1125","«أفضل القرآن {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ} »","صحيح","Sahih al-Jami al-Saghir 1125","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1126","«أفضل الكسب بيع مبرور وعمل الرجل بيده»","صحيح","Sahih al-Jami al-Saghir 1126","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1127","«أفضل الكلام: سبحان الله والحمد لله ولا إله إلا الله والله أكبر»","صحيح","Sahih al-Jami al-Saghir 1127","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1128","«أفضل المؤمنين أحسنهم خلقا»","صحيح","Sahih al-Jami al-Saghir 1128","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1129","«أفضل المؤمنين إسلاما من سلم المسلمون من لسانه ويده وأفضل المؤمنين إيمانا أحسنهم خلقا وأفضل المهاجرين من هجر ما نهى الله تعالى عنه وأفضل الجهاد من جاهد نفسه في ذات الله عز وجل»","صحيح","Sahih al-Jami al-Saghir 1129","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1130","«أفضل الناس مؤمن بين كريمين»","صحيح","Sahih al-Jami al-Saghir 1130","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1131","«أفضل الناس مؤمن يجاهد في سبيل الله بنفسه وماله ثم مؤمن في شعب من الشعاب يتقي الله ويدع الناس من شره»","صحيح","Sahih al-Jami al-Saghir 1131","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1132","أفضل الهجرتين الهجرة البانة والهجرة البانة: ¤ أن تثبت مع رسول الله وهجرة البادية: أن ترجع إلى باديتك وعليك السمع والطاعة في عسرك ويسرك ومكرهك ومنشطك وأثرة عليك","صحيح","Sahih al-Jami al-Saghir 1132","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1133","«أفضل أيام الدنيا أيام العشر»","صحيح","Sahih al-Jami al-Saghir 1133","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1134","«أفضل صلاتكم في بيوتكم إلا المكتوبة»","صحيح","Sahih al-Jami al-Saghir 1134","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1135","«أفضل نساء أهل الجنة خديجة بنت خويلد وفاطمة بنت محمد ومريم بنت عمران وآسية بنت مزاحم امرأة فرعون»","صحيح","Sahih al-Jami al-Saghir 1135","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1136","«أفطر الحاجم والمحجوم»","صحيح","Sahih al-Jami al-Saghir 1136","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1137","«أفطر عندكم الصائمون وأكل طعامكم الأبرار وصلت عليكم الملائكة»","صحيح","Sahih al-Jami al-Saghir 1137","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1138","«أفلح من هدي إلى الإسلام وكان عيشه كفافا وقنع بت»","صحيح","Sahih al-Jami al-Saghir 1138","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1139","«إقامة حد من حدود الله خير من مطر أربعين ليلة في بلاد الله»","حسن","Sahih al-Jami al-Saghir 1139","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1140","«اقبل الحديقة وطلقها تطليقة»","صحيح","Sahih al-Jami al-Saghir 1140","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1141","«أقبل وأدبر واتق الدبر والحيضة»","حسن","Sahih al-Jami al-Saghir 1141","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1142","«اقتدوا باللذين من بعدي: أبي بكر وعمر»","صحيح","Sahih al-Jami al-Saghir 1142","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1143","«اقتدوا باللذين من بعدي: أبي بكر وعمر واهتدوا بهدي عمار وما حدثكم ابن مسعود فاقبلوه»","صحيح","Sahih al-Jami al-Saghir 1143","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1144","«اقتدوا باللذين من بعدي من أصحابي: أبي بكر وعمر واهتدوا بهدي عمار وتمسكوا بعهد ابن مسعود»","صحيح","Sahih al-Jami al-Saghir 1144","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1145","«اقتربت الساعة ولا تزداد منهم إلا بعدا»","حسن","Sahih al-Jami al-Saghir 1145","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1146","«اقتربت الساعة ولا يزداد الناس على الدنيا إلا حرصا ولا يزدادون من الله إلا بعدا»","حسن","Sahih al-Jami al-Saghir 1146","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1147","«اقتلوا الأسودين في الصلاة: الحية والعقرب»","صحيح","Sahih al-Jami al-Saghir 1147","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1148","«اقتلوا الحيات فإنا لم نسالمهن منذ حاربناهن»","صحيح","Sahih al-Jami al-Saghir 1148","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1149","«اقتلوا الحيات كلهن فمن خاف ثأرهن فليس منا»","صحيح","Sahih al-Jami al-Saghir 1149","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1150","«اقتلوا الحيات والكلاب واقتلوا ذا الطفيتين والأبتر فإنهما يلتمسان البصر ويسقطان الحبل»","صحيح","Sahih al-Jami al-Saghir 1150","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1151","«اقتلوا الحية والعقرب وإن كنتم في الصلاة»","صحيح","Sahih al-Jami al-Saghir 1151","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1152","«اقتلوا ذا الطفيتين فإنه يلتمس البصر ويصيب الحبل»","صحيح","Sahih al-Jami al-Saghir 1152","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1153","اقتلوا ذا الطفيتين والأبتر فإنهما يطمسان البصر ¤ ويسقطان الحبل","صحيح","Sahih al-Jami al-Saghir 1153","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1154","«اقرأ القرآن في أربعين»","حسن","Sahih al-Jami al-Saghir 1154","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1155","«اقرأ القرآن في ثلاث إن استطعت»","صحيح","Sahih al-Jami al-Saghir 1155","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1156","«اقرأ القرآن في خمس»","صحيح","Sahih al-Jami al-Saghir 1156","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1157","«اقرأ القرآن في كل شهر اقرأه في خمس وعشرين اقرأه في خمس عشرة اقرأه في عشر اقرأه في سبع لا يفقهه من يقرؤه في أقل من ثلاث»","صحيح","Sahih al-Jami al-Saghir 1157","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1158","«اقرأ القرآن في كل شهر اقرأه في عشرين ليلة اقرأه في عشر اقرأه في سبع ولا تزد على ذلك»","صحيح","Sahih al-Jami al-Saghir 1158","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1159","«اقرأ المعوذات في دبر كل صلاة»","صحيح","Sahih al-Jami al-Saghir 1159","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1160","«اقرأ المعوذتين فإنك لن تقرأ بمثلهما»","صحيح","Sahih al-Jami al-Saghir 1160","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1161","اقرأ {قُلْ يَا أَيُّهَا الْكَافِرُونَ} . عند منامك فإنها براءة من الشرك","صحيح","Sahih al-Jami al-Saghir 1161","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1162","«أقرأني جبريل القرآن على حرف فراجعته فلم أزل استزيده فيزيدني حتى انتهى إلى سبعة أحرف»","صحيح","Sahih al-Jami al-Saghir 1162","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1163","«اقرءوا القرآن على سبعة أحرف فأيما قرأتم أصبتم ولا تماروا فيه فإن المراء فيه كفر»","صحيح","Sahih al-Jami al-Saghir 1163","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1164","«اقرءوا القرآن فإنكم تؤجرون عليه أما إني لا أقول: ألم حرف ولكن ألف عشر ولام عشر وميم عشر فتلك ثلاثون»","صحيح","Sahih al-Jami al-Saghir 1164","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1165","«اقرءوا القرآن فإنه يأتي يوم القيامة شفيعا لأصحابه، اقرءوا الزهراوين: البقرة وآل عمران فإنهما يأتيان يوم القيامة كأنهما غمامتان أو غيايتان أو كأنهما فرقان من طير صواف يحاجان عن أصحابهما، اقرءوا سورة البقرة فإن أخذها بركة وتركها حسرة ولا تستطيعها البطلة»","صحيح","Sahih al-Jami al-Saghir 1165","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1166","«اقرءوا القرآن ما ائتلفت عليه قلوبكم فإذا اختلفتم فيه فقوموا»","صحيح","Sahih al-Jami al-Saghir 1166","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1167","«اقرءوا القرآن وابتغوا به الله تعالى من قبل أن يأتي قوم يقيمونه إقامة القدح يتعجلونه ولا يتأجلونه»","حسن","Sahih al-Jami al-Saghir 1167","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1168","«اقرءوا القرآن واعملوا به ولا تجفوا عنه ولا تغلوا فيه ولا تأكلوا به ولا تستكثروا به»","صحيح","Sahih al-Jami al-Saghir 1168","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1169","«اقرءوا القرآن وسلوا الله به قبل أن يأتي قوم يقرءون القرآن فيسألون به الناس»","صحيح","Sahih al-Jami al-Saghir 1169","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1170","«اقرءوا سورة البقرة في بيوتكم فإن الشيطان لا يدخل بيتا يقرأ فيه سورة البقرة»","صحيح","Sahih al-Jami al-Saghir 1170","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1171","«اقرءوا كما علمتم فإنما أهلك من كان قبلكم اختلافهم على أنبيائهم»","حسن","Sahih al-Jami al-Saghir 1171","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1172","«اقرءوا هاتين الآيتين اللتين في آخر سورة البقرة فإن ربي أعطانيهما من تحت العرش»","صحيح","Sahih al-Jami al-Saghir 1172","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1173","«أقرب ما يكون الرب من العبد في جوف الليل الآخر فإن استطعت أن تكون ممن يذكر الله في تلك الساعة فكن»","صحيح","Sahih al-Jami al-Saghir 1173","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1174","«أقرب ما يكون العبد إلى الله وهو ساجد»","صحيح","Sahih al-Jami al-Saghir 1174","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1175","«أقرب ما يكون العبد من ربه وهو ساجد فأكثروا الدعاء»","صحيح","Sahih al-Jami al-Saghir 1175","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1176","«أقربكم مني مجلسا يوم القيامة أحسنكم خلقا»","حسن","Sahih al-Jami al-Saghir 1176","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1177","«أقروا الطير على مكناتها»","صحيح","Sahih al-Jami al-Saghir 1177","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1178","«اقسموا المال بين أهل الفرائض على كتاب الله فما تركت الفرائض فلأولى رجل ذكر»","صحيح","Sahih al-Jami al-Saghir 1178","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1179","«أقصر من جشائك فإن أكثر الناس شبعا في الدنيا أكثرهم جوعا في الآخرة»","حسن","Sahih al-Jami al-Saghir 1179","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1180","«اقضوا الله فالله أحق بالوفاء»","صحيح","Sahih al-Jami al-Saghir 1180","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1181","«اقطعوا في ربع الدينار ولا تقطعوا فيما هو أدنى من ذلك»","صحيح","Sahih al-Jami al-Saghir 1181","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1182","«أقل أمتي أبناء السبعين»","صحيح","Sahih al-Jami al-Saghir 1182","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1183","«أقل أمتي الذين يبلغون السبعين»","حسن","Sahih al-Jami al-Saghir 1183","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1184","«أقلوا الخروج بعد هدأة الرجل فإن لله تعالى دواب يبثهن في الأرض في تلك الساعة»","صحيح","Sahih al-Jami al-Saghir 1184","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1185","«أقيلوا ذوي الهيئات عثراتهم إلا الحدود»","صحيح","Sahih al-Jami al-Saghir 1185","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1186","«أقيموا الركوع والسجود فوالله إني لأراكم من بعد ظهري إذا ركعتم وإذا سجدتم»","صحيح","Sahih al-Jami al-Saghir 1186","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1187","«أقيموا الصفوف فإنما تصفون بصفوف الملائكة وحاذوا بين المناكب وسدوا الخلل ولينوا بأيدي إخوانكم ولا تذروا فرجات للشيطان ومن وصل صفا وصله الله ومن قطع صفا قطعه الله عز وجل»","صحيح","Sahih al-Jami al-Saghir 1187","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1188","«أقيموا الصفوف في الصلاة فإن إقامة الصف من حسن الصلاة»","صحيح","Sahih al-Jami al-Saghir 1188","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1189","«أقيموا الصلاة وآتوا الزكاة وحجوا واعتمروا واستقيموا يستقم بكم»","حسن","Sahih al-Jami al-Saghir 1189","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1190","«أقيموا حدود الله تعالى في البعيد والقريب ولا تأخذكم بالله لومة لائم»","صحيح","Sahih al-Jami al-Saghir 1190","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1191","«أقيموا صفوفكم فوالله لتقيمن صفوفكم أو ليخالفن الله بين قلوبكم»","صحيح","Sahih al-Jami al-Saghir 1191","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1192","«أقيموا صفوفكم لا تخللكم الشياطين كأنها أولاد الحذف قيل: يا رسول الله وما أولاد الحذف؟ قيل: سود جرد بأرض اليمن»","صحيح","Sahih al-Jami al-Saghir 1192","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1193","«أقيموا صفوفكم وتراصوا فإني أراكم من خلف ظهري»","صحيح","Sahih al-Jami al-Saghir 1193","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1194","أقيموا صفوفكم وتراصوا فوالذي نفسي بيده إني ¤ لأرى الشياطين بين صفوفكم كأنها غنم عفر","صحيح","Sahih al-Jami al-Saghir 1194","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1195","«أكبر الكبائر الإشراك بالله وقتل النفس وعقوق الوالدين وشهادة الزور»","صحيح","Sahih al-Jami al-Saghir 1195","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1196","«اكتب فوالذي نفسي بيده ما يخرج منه إلا حق»","صحيح","Sahih al-Jami al-Saghir 1196","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1197","«اكتحلوا بالإثمد فإنه يجلوا البصر وينبت الشعر»","صحيح","Sahih al-Jami al-Saghir 1197","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1198","«أكثر الدعاء بالعافية»","حسن","Sahih al-Jami al-Saghir 1198","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1199","«أكثر الناس شبعا في الدنيا أطولهم جوعا في الآخرة»","حسن","Sahih al-Jami al-Saghir 1199","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1200","«أكثرت عليكم في السواك»","صحيح","Sahih al-Jami al-Saghir 1200","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1201","«أكثر خطايا ابن آدم في لسانه»","حسن","Sahih al-Jami al-Saghir 1201","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1202","«أكثر عذاب القبر من البول»","صحيح","Sahih al-Jami al-Saghir 1202","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1203","«أكثر منافقي أمتي قراؤها»","صحيح","Sahih al-Jami al-Saghir 1203","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1204","«أكثر من السجود فإنه ليس من مسلم يسجد لله تعالى سجدة إلا رفعه الله بها درجة في الجنة وحط عنه بها خطيئة»","صحيح","Sahih al-Jami al-Saghir 1204","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1205","«أكثر من لا حول ولا قوة إلا بالله فإنها من كنز الجنة»","صحيح","Sahih al-Jami al-Saghir 1205","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1206","«أكثر من يموت من أمتي بعد قضاء الله وقدره بالعين»","حسن","Sahih al-Jami al-Saghir 1206","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1207","«أكثروا الصلاة علي فإن الله وكل بي ملكا عند قبري فإذا صلى علي رجل من أمتي قال لي ذلك الملك: يا محمد إن فلان ابن فلان صلى عليك الساعة»","حسن","Sahih al-Jami al-Saghir 1207","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1208","«أكثروا الصلاة علي في يوم الجمعة فإنه ليس يصلي علي أحد يوم الجمعة إلا عرضت على صلاته»","صحيح","Sahih al-Jami al-Saghir 1208","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1209","«أكثروا الصلاة علي يوم الجمعة وليلة الجمعة فمن صلى علي صلاة صلى الله عليه عشرا»","حسن","Sahih al-Jami al-Saghir 1209","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1210","«أكثروا ذكر هاذم اللذات: الموت»","صحيح","Sahih al-Jami al-Saghir 1210","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1211","«أكثروا ذكر هاذم اللذات: الموت فإنه لم يذكره أحد في ضيق من العيش إلا وسعه عليه ولا ذكره في سعة إلا ضيقها عليه»","حسن","Sahih al-Jami al-Saghir 1211","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1212","«أكثروا من شهادة: أن لا إله إلا الله قبل أن يحال بينكم وبينها ولقنوها موتاكم»","حسن","Sahih al-Jami al-Saghir 1212","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1213","«أكثروا من غرس الجنة فإنه عذب ماؤها طيب ترابها فأكثروا من غراسها: لا حول ولا قوة إلا بالله»","حسن","Sahih al-Jami al-Saghir 1213","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1214","«أكثروا من قول: لا حول ولا قوة إلا بالله فإنها من كنوز الجنة»","صحيح","Sahih al-Jami al-Saghir 1214","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1215","«أكثروا من هذه النعال فإن الرجل لا يزال راكبا ما انتعل»","صحيح","Sahih al-Jami al-Saghir 1215","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1216","«أكرم الناس أتقاهم»","صحيح","Sahih al-Jami al-Saghir 1216","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1217","«أكرم الناس يوسف بن يعقوب بن إسحاق بن إبراهيم»","صحيح","Sahih al-Jami al-Saghir 1217","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1218","«أكرم شعرك وأحسن إليه»","حسن","Sahih al-Jami al-Saghir 1218","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1219","«أكرموا الخبز»","حسن","Sahih al-Jami al-Saghir 1219","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1220","«أكرموا الشعر»","صحيح","Sahih al-Jami al-Saghir 1220","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1221","«اكسروا فيها قسيكم - يعني في الفتنة - واقطعوا فيها أوتاركم والزموا فيها أجواف بيوتكم وكونوا فيها كالخير من ابني آدم»","صحيح","Sahih al-Jami al-Saghir 1221","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1222","«اكشف البأس رب الناس»","صحيح","Sahih al-Jami al-Saghir 1222","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1223","«اكشف البأس رب الناس! إله الناس»","صحيح","Sahih al-Jami al-Saghir 1223","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1224","«اكشف البأس رب الناس! لا يكشف الكرب غيرك»","صحيح","Sahih al-Jami al-Saghir 1224","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1225","اكفلوا لي بست أكفل لكم بالجنة: إذا حدث ¤ أحدكم فلا يكذب وإذا ائتمن فلا يخن وإذا وعد فلا يخلف وغضوا أبصاركم وكفوا أيديكم واحفظوا فروجكم","حسن","Sahih al-Jami al-Saghir 1225","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1226","«أكل طعامكم الأبرار وصلت عليكم الملائكة وأفطر عندكم الصائمون»","صحيح","Sahih al-Jami al-Saghir 1226","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1227","«أكل كل ذي ناب من السباع حرام»","صحيح","Sahih al-Jami al-Saghir 1227","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1228","«اكلفوا من العمل ما تطيقون فإن الله لا يمل حتى تملوا وإن أحب العمل إلى الله تعالى أدومه وإن قل»","صحيح","Sahih al-Jami al-Saghir 1228","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1229","«اكلفوا من العمل ما تطيقون فإن خير العمل أدومه وإن قل»","صحيح","Sahih al-Jami al-Saghir 1229","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1230","«أكمل المؤمنين إيمانا أحسنهم خلقا»","صحيح","Sahih al-Jami al-Saghir 1230","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1231","«أكمل المؤمنين إيمانا أحسنهم خلقا الموطئون أكنافا الذين يألفون ويؤلفون ولا خير فيمن لا يألف ولا يؤلف»","حسن","Sahih al-Jami al-Saghir 1231","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1232","أكمل المؤمنين إيمانا أحسنهم خلقا وخياركم خياركم ¤ لنسائهم","صحيح","Sahih al-Jami al-Saghir 1232","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1233","«ألبان البقر شفاء وسمنها دواء ولحومها داء»","صحيح","Sahih al-Jami al-Saghir 1233","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1234","«البس جديدا وعش حميدا ومت شهيدا ويرزقك الله قرة عين في الدنيا والآخرة» - قاله لعمر بن الخطاب -","حسن","Sahih al-Jami al-Saghir 1234","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1235","«البسوا الثياب البيض فإنها أطهر وأطيب وكفنوا فيها موتاكم»","صحيح","Sahih al-Jami al-Saghir 1235","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1236","«البسوا من ثيابكم البياض فإنها من خير ثيابكم وكفنوا فيها موتاكم وإن من خير أكحالكم الإثمد يجلوا البصر وينبت الشعر»","صحيح","Sahih al-Jami al-Saghir 1236","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1237","«التمسوا الساعة التي ترجى في يوم الجمعة بعد العصر إلى غيبوبة الشمس»","حسن","Sahih al-Jami al-Saghir 1237","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1238","«التمسوا ليلة القدر آخر ليلة من رمضان»","صحيح","Sahih al-Jami al-Saghir 1238","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1239","«التمسوا ليلة القدر في العشر الأواخر من رمضان في وتر فإني قد رأيتها فنسيتها»","صحيح","Sahih al-Jami al-Saghir 1239","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1240","«التمسوا ليلة القدر ليلة سبع وعشرين»","صحيح","Sahih al-Jami al-Saghir 1240","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1241","«التمس ولو خاتما من حديد»","صحيح","Sahih al-Jami al-Saghir 1241","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1242","«التمسوها في العشر الأواخر فإن ضعف أحدكم أو عجز فلا يغلبن على السبع البواقي»","صحيح","Sahih al-Jami al-Saghir 1242","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1243","«التمسوها في العشر الأواخر: في تسع تبقين أو سبع تبقين أو خمس تبقين أو ثلاث تبقين أو آخر ليلة»","صحيح","Sahih al-Jami al-Saghir 1243","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1244","«التمسوها في العشر الأواخر من رمضان: في تاسعة تبقى وفي سابعة تبقى وفي خامسة تبقى»","صحيح","Sahih al-Jami al-Saghir 1244","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1245","«التمسوها في العشر الأواخر من رمضان والتمسوها في التاسعة والسابعة والخامسة»","صحيح","Sahih al-Jami al-Saghir 1245","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1246","«ألحقوا الفرائض بأهلها فما بقي فلأولى رجل ذكر»","صحيح","Sahih al-Jami al-Saghir 1246","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1247","«الزم بيتك»","صحيح","Sahih al-Jami al-Saghir 1247","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1248","«الزم رجلها فثم الجنة»","حسن","Sahih al-Jami al-Saghir 1248","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1249","«إلزمها فإن الجنة تحت أقدامها» - يعني الوالدة -","حسن","Sahih al-Jami al-Saghir 1249","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1250","«ألظوا ب» ياذا [الجلال والإكرام]","صحيح","Sahih al-Jami al-Saghir 1250","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1251","«ألق عنك شعر الكفر ثم اختتن»","حسن","Sahih al-Jami al-Saghir 1251","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1252","«الله الطبيب»","صحيح","Sahih al-Jami al-Saghir 1252","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1253","«الله مع القاضي ما لم يجر فإذا جار تخلى الله عنه ولزمه الشيطان»","حسن","Sahih al-Jami al-Saghir 1253","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1254","«الله ورسوله مولى من لا مولى له والخال وارث من لا وارث له»","صحيح","Sahih al-Jami al-Saghir 1254","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1255","«اللهم اجعل أوسع رزقك علي عند كبر سني وانقطاع عمري»","حسن","Sahih al-Jami al-Saghir 1255","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1256","«اللهم اجعل بالمدينة ضعفي ما جعلت بمكة من البركة»","صحيح","Sahih al-Jami al-Saghir 1256","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1257","«اللهم اجعل رزق آل محمد في الدنيا قوتا»","صحيح","Sahih al-Jami al-Saghir 1257","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1258","«اللهم اجعل فناء أمتي قتلا في سبيلك بالطعن والطاعون»","صحيح","Sahih al-Jami al-Saghir 1258","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1259","«اللهم اجعل في قلبي نورا وفي لساني نورا وفي بصري نورا وفي سمعي نورا وعن يميني نورا وعن يساري نورا ومن فوقي نورا ومن تحتي نورا ومن أمامي نورا ومن خلفي نورا واجعل لي في نفسي نورا وأعظم لي نورا»","صحيح","Sahih al-Jami al-Saghir 1259","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1260","اللهم احفظني بالإسلام قائما واحفظني بالإسلام قاعدا واحفظني بالإسلام راقدا ولا تشمت بي عدوا ولا حاسدا اللهم ¤ إني أسألك من كل خير خزائنه بيدك وأعوذ بك من كل شر خزائنه بيدك","حسن","Sahih al-Jami al-Saghir 1260","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1261","«اللهم أحيني مسكينا وأمتني مسكينا واحشرني في زمرة المساكين»","صحيح","Sahih al-Jami al-Saghir 1261","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1262","«اللهم استر عورتي وآمن روعتي واقض عني ديني»","حسن","Sahih al-Jami al-Saghir 1262","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1263","«اللهم أصلح لي ديني الذي هو عصمة أمري وأصلح لي دنياي التي فيها معاشي وأصلح لي آخرتي التي فيها معادي واجعل الحياة زيادة لي في كل خير واجعل الموت راحة لي من كل شر»","صحيح","Sahih al-Jami al-Saghir 1263","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1264","«اللهم اغفر لي خطيئتى وجهلي وإسرافي في أمري وما أنت أعلم به مني اللهم اغفر لي خطئي وعمدي وهزلي وجدي وكل ذلك عندي، اللهم اغفر لي ما قدمت وما أخرت وما أسررت وما أعلنت أنت المقدم وأنت المؤخر وأنت على كل شيء قدير»","صحيح","Sahih al-Jami al-Saghir 1264","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1265","اللهم اغفر لي ذنبي ووسع لي في داري وبارك لي ¤ في رزقي","حسن","Sahih al-Jami al-Saghir 1265","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1266","«اللهم اغفر لي ذنوبي وخطاياي كلها اللهم أنعشني واجبرني واهدني لصالح الأعمال والأخلاق فإنه لا يهدي لصالحها ولا يصرف سيئها إلا أنت»","حسن","Sahih al-Jami al-Saghir 1266","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1267","«اللهم اغفر لي وارحمني وألحقني بالرفيق الأعلى»","صحيح","Sahih al-Jami al-Saghir 1267","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1268","«اللهم اقسم لنا من خشيتك ما يحول بيننا وبين معاصيك ومن طاعتك ما تبلغنا به جنتك ومن اليقين ما يهون علينا مصيبات الدنيا ومتعنا بأسماعنا وأبصارنا وقوتنا ما أحييتنا واجعله الوارث منا واجعل ثأرنا على من ظلمنا وانصرنا على من عادانا ولا تجعل مصيبتنا في ديننا ولا تجعل الدنيا أكبر همنا ولا مبلغ علمنا ولا تسلط علينا من لا يرحمنا»","حسن","Sahih al-Jami al-Saghir 1268","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1269","«اللهم أمتعني بسمعي وبصري حتى تجعلهما الوارث مني وعافني في ديني وفي جسدي وانصرني ممن ظلمني حتى تريني فيه ثأري، اللهم إني أسلمت نفسي إليك وفوضت أمري إليك وألجأت ظهري إليك وخليت وجهي إليك لا ملجأ ولا منجى منك إلا إليك آمنت برسولك الذي أرسلت وبكتابك الذي أنزلت»","صحيح","Sahih al-Jami al-Saghir 1269","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1270","«اللهم أنت خلقت نفسي وأنت توفاها لك مماتها ومحياها إن أحييتها فاحفظها وإن أمتها فاغفر لها اللهم إني أسألك العافية»","صحيح","Sahih al-Jami al-Saghir 1270","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1271","«اللهم إن إبراهيم حرم مكة فجعلها حراما وإني حرمت المدينة ما بين مأزميها أن لا يراق فيها دم ولا يحمل فيها سلاح لقتال ولا يخبط فيها شجرة إلا لعلف اللهم بارك لنا في مدينتنا اللهم بارك لنا في صاعنا اللهم بارك لنا في مدنا اللهم اجعل مع البركة بركتين والذي نفسي بيده ما من المدينة شعب ولا نقب إلا عليه ملكان يحرسانها حتى تقدموا إليها»","صحيح","Sahih al-Jami al-Saghir 1271","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1272","«اللهم إن إبراهيم كان عبدك وخليلك دعاك لأهل مكة بالبركة وأنا محمد عبدك ورسولك أدعوك لأهل المدينة أن تبارك لهم في مدهم وصاعهم مثلي ما باركت لأهل مكة مع البركة بركتين»","صحيح","Sahih al-Jami al-Saghir 1272","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1273","«اللهم إني أتخذ عندك عهدا لن تخلفنيه فإنما أنا بشر فأيما مؤمن آذيته أو شتمته أو جلدته أو لعنته فاجعلها له صلاة وزكاة وقربة تقربه بها إليك يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1273","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1274","اللهم إني أسألك العفة والعافية في دنياي وديني وأهلي ¤ ومالي اللهم استر عورتي وآمن روعتي واحفظني من بين يدي ومن خلفي وعن يميني وعن شمالي ومن فوقي وأعوذ بك أن اغتال من تحتي","صحيح","Sahih al-Jami al-Saghir 1274","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1275","«اللهم إني أسألك الهدى والتقى والعفاف والغنى»","صحيح","Sahih al-Jami al-Saghir 1275","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1276","«اللهم إني أسألك من الخير كله عاجله وآجله ما علمت منه وما لم أعلم وأعوذ بك من الشر كله عاجله وآجله ما علمت منه وما لم أعلم اللهم إني أسألك من خير ما سألك به عبدك ونبيك وأعوذ بك من شر ما عاذ به عبدك ونبيك اللهم إني أسألك الجنة وما قرب إليها من قول أو عمل وأعوذ بك من النار وما قرب إليها من قول أو عمل وأسألك أن تجعل كل قضاء قضيته لي خيرا»","صحيح","Sahih al-Jami al-Saghir 1276","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1277","«اللهم إني أسألك من الخير كله ما علمت منه وما لم أعلم وأعوذ بك من الشر كله ما علمت منه وما لم أعلم»","صحيح","Sahih al-Jami al-Saghir 1277","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1278","«اللهم إني أسألك من فضلك ورحمتك فإنه لا يملكها إلا أنت»","صحيح","Sahih al-Jami al-Saghir 1278","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1279","اللهم إني أسألك وأتوجه إليك بنبيك محمد نبي الرحمة يا محمد إني توجهت بك إلى ربي في حاجتي هذه لتقضى لي ¤ اللهم فشفعه في","صحيح","Sahih al-Jami al-Saghir 1279","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1280","«اللهم إني أعوذ برضاك من سخطك وبمعافاتك من عقوبتك وأعوذ بك منك لا أحصي ثناء عليك أنت كما أثنيت على نفسك»","صحيح","Sahih al-Jami al-Saghir 1280","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1281","«اللهم إني أعوذ بك من البرص والجنون والجذام ومن سيء الأسقام»","صحيح","Sahih al-Jami al-Saghir 1281","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1282","«اللهم إني أعوذ بك من التردي والهدم والغرق والحرق وأعوذ بك أن يتخبطني الشيطان عند الموت وأعوذ بك أن أموت في سبيلك مدبرا وأعوذ بك أن أموت لديغا»","صحيح","Sahih al-Jami al-Saghir 1282","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1283","«اللهم إني أعوذ بك من الجوع فإنه بئس الضجيع وأعوذ بك من الخيانة فإنها بئست البطانة»","حسن","Sahih al-Jami al-Saghir 1283","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1284","«اللهم إني أعوذ بك من العجز والكسل والجبن والبخل والهرم وأعوذ بك من عذاب القبر وأعوذ بك من عذاب النار وأعوذ بك من فتنة المحيا والممات»","صحيح","Sahih al-Jami al-Saghir 1284","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1285","«اللهم إني أعوذ بك من العجز والكسل والجبن والبخل والهرم والقسوة والغفلة والعيلة والذلة والمسكنة وأعوذ بك من الفقر والكفر والفسوق والشقاق والنفاق والسمعة والرياء وأعوذ بك من الصمم والبكم والجنون والجذام والبرص وسيء الأسقام»","صحيح","Sahih al-Jami al-Saghir 1285","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1286","«اللهم إني أعوذ بك من العجز والكسل والجبن والبخل والهرم وعذاب القبر وفتنة الدجال اللهم آت نفسي تقواها وزكها أنت خير من زكاها أنت وليها ومولاها اللهم إني أعوذ بك من علم لا ينفع ومن قلب لا يخشع ومن نفس لا تشبع ومن دعوة لا يستجاب لها»","صحيح","Sahih al-Jami al-Saghir 1286","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1287","«اللهم إني أعوذ من الفقر والقلة والذلة وأعوذ بك من أن أظلم أو أظلم»","صحيح","Sahih al-Jami al-Saghir 1287","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1288","اللهم إني أعوذ بك من الكسل والهرم والمأثم والمغرم ومن فتنة القبر وعذاب القبر ومن فتنة النار وعذاب النار ومن شر فتنة الغنى وأعوذ بك من فتنة الفقر وأعوذ بك من فتنة المسيح الدجال اللهم اغسل عني خطاياي بالماء والثلج والبرد ونق قلبي من الخطايا كما ينقى الثوب الأبيض من الدنس وباعد بيني وبين ¤ خطاياي كما باعدت بين المشرق والمغرب","صحيح","Sahih al-Jami al-Saghir 1288","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1289","«اللهم إني أعوذ بك من الهم والحزن والعجز والكسل والبخل والجبن وضلع الدين وغلبة الرجال»","صحيح","Sahih al-Jami al-Saghir 1289","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1290","«اللهم إني أعوذ بك من جار السوء في دار المقامة فإن جار البادية يتحول»","حسن","Sahih al-Jami al-Saghir 1290","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1291","«اللهم إني أعوذ بك من زوال نعمتك وتحول عافيتك وفجأة نقمتك وجميع سخطك»","صحيح","Sahih al-Jami al-Saghir 1291","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1292","«اللهم إني أعوذ بك من شر سمعي ومن شر بصري ومن شر لساني ومن شر قلبي ومن شر منيتي»","صحيح","Sahih al-Jami al-Saghir 1292","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1293","«اللهم إني أعوذ بك من شر ما عملت ومن شر ما لم أعمل»","صحيح","Sahih al-Jami al-Saghir 1293","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1294","«اللهم إني أعوذ بك من عذاب القبر وأعوذ بك من عذاب النار وأعوذ بك من فتنة المحيا والممات وأعوذ بك من فتنة المسيح الدجال»","صحيح","Sahih al-Jami al-Saghir 1294","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1295","اللهم إني أعوذ بك من علم لا ينفع وعمل لا يرفع ¤ ودعاء لا يسمع","صحيح","Sahih al-Jami al-Saghir 1295","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1296","«اللهم إني أعوذ بك من غلبة الدين وغلبة العدو وشماتة الأعداء»","صحيح","Sahih al-Jami al-Saghir 1296","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1297","«اللهم إني أعوذ بك من قلب لا يخشع ومن دعاء لا يسمع ومن نفس لا تشبع ومن علم لا ينفع أعوذ بك من هؤلاء الأربع»","صحيح","Sahih al-Jami al-Saghir 1297","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1298","«اللهم إني أعوذ بك من منكرات الأخلاق والأعمال والأهواء والأدواء»","صحيح","Sahih al-Jami al-Saghir 1298","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1299","«اللهم إني أعوذ بك من يوم السوء ومن ليلة السوء ومن ساعة السوء ومن صاحب السوء ومن جار السوء في دار المقامة»","حسن","Sahih al-Jami al-Saghir 1299","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1300","«اللهم بارك لأمتي في بكورها»","صحيح","Sahih al-Jami al-Saghir 1300","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1301","«اللهم بعلمك الغيب وقدرتك على الخلق أحيني ما علمت الحياة خيرا لي وتوفني إذا علمت الوفاة خيرا لي اللهم وأسألك خشيتك في الغيب والشهادة وأسألك كلمة الإخلاص في الرضا والغضب وأسألك القصد في الفقر والغنى وأسألك نعيما لا ينفد وأسألك قرة عين لا تنقطع وأسألك الرضا بالقضاء وأسألك برد العيش بعد الموت وأسألك لذة النظر إلى وجهك والشوق إلى لقائك في غير ضراء مضرة ولا فتنة مضلة اللهم زينا بزينة الإيمان واجعلنا هداة مهتدين»","صحيح","Sahih al-Jami al-Saghir 1301","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1302","«اللهم حجة لا رياء فيها ولا سمعة»","صحيح","Sahih al-Jami al-Saghir 1302","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1303","«اللهم رب الناس! مذهب الباس اشف أنت الشافي لا شافي إلا أنت اشف شفاء لا يغادر سقما»","صحيح","Sahih al-Jami al-Saghir 1303","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1304","«اللهم رب جبريل وميكائيل وإسرافيل ومحمد صلى الله عليه وسلم نعوذ بك من النار»","حسن","Sahih al-Jami al-Saghir 1304","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1305","«اللهم رب جبريل وميكائيل ورب إسرافيل أعوذ بك من حر النار ومن عذاب القبر»","حسن","Sahih al-Jami al-Saghir 1305","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1306","«اللهم {رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ} »","صحيح","Sahih al-Jami al-Saghir 1306","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1307","«اللهم كما حسنت خلقي فحسن خلقي»","صحيح","Sahih al-Jami al-Saghir 1307","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1308","«اللهم لا عيش إلا عيش الآخرة»","صحيح","Sahih al-Jami al-Saghir 1308","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1309","«اللهم لك أسلمت وبك آمنت وعليك توكلت وإليك أنبت وبك خاصمت اللهم إني أعوذ بعزتك لا إله إلا أنت أن تضلني أنت الحي الذي لا يموت والجن والإنس يموتون»","صحيح","Sahih al-Jami al-Saghir 1309","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1310","«اللهم متعني بسمعي وبصري واجعلهما الوارث مني وانصرني على من ظلمني وخذ منه بثأري»","حسن","Sahih al-Jami al-Saghir 1310","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1311","«اللهم من آمن بك وشهد أني رسولك فحبب إليه لقاءك وسهل عليه قضاءك وأقلل له من الدنيا ومن لم يؤمن بك ويشهد أني رسولك فلا تحبب إليه لقاءك ولا تسهل عليه قضاءك وكثر له من الدنيا»","صحيح","Sahih al-Jami al-Saghir 1311","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1312","«اللهم من ولي من أمر أمتي شيئا فشق عليهم فاشقق عليه ومن ولي من أمر أمتي شيئا فرفق بهم فارفق به»","صحيح","Sahih al-Jami al-Saghir 1312","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1313","«ألم تروا إلى الإنسان إذا مات شخص بصره فذاك حين يتبع بصره نفسه»","صحيح","Sahih al-Jami al-Saghir 1313","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1314","«ألم تروا ما قال ربكم؟ قال: ما أنعمت على عبادي من نعمة إلا أصبح فريق منهم بها كافرين يقولون: الكواكب وبالكواكب»","صحيح","Sahih al-Jami al-Saghir 1314","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1315","«ألم تعلموا ما لقي صاحب بني إسرائيل؟ كانوا إذا أصابهم البول قطعوا ما أصابه البول منهم فنهاهم عن ذلك فعذب في قبره»","صحيح","Sahih al-Jami al-Saghir 1315","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1316","«أليس قد مكث هذا بعده سنة فأدرك رمضان فصامه وصلى كذا وكذا سجدة في السنة؟ فلما بينهما أبعد مما بين السماء والأرض»","صحيح","Sahih al-Jami al-Saghir 1316","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1317","«أما إن ابنك هذا لا يجني عليك ولا تجني عليه»","صحيح","Sahih al-Jami al-Saghir 1317","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1318","«أما إنك لو قلت حين أمسيت: أعوذ بكلمات الله التامات من شر ما خلق لم تضرك»","صحيح","Sahih al-Jami al-Saghir 1318","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1319","«أما إنك لو لم تعطه شيئا كتب عليك كذبة»","حسن","Sahih al-Jami al-Saghir 1319","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1320","«أما إنها ستكون لكم الأنماط»","صحيح","Sahih al-Jami al-Saghir 1320","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1321","«أما إنه لئن حلف على ماله ليأكله ظلما ليلقين الله وهو عنه معرض»","صحيح","Sahih al-Jami al-Saghir 1321","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1322","«أما إنه لم تهلك الأمم قبلكم حتى وقعوا في مثل هذا يضربون القرآن بعضه ببعض ما كان من حلال فأحلوه وما كان من حرام فحرموه وما كان من متشابه فآمنوا به»","صحيح","Sahih al-Jami al-Saghir 1322","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1323","«أما إنه لو قال: بسم الله لكفاكم فإذا أكل أحدكم طعاما فليقل: بسم الله فإن نسي أن يقول: بسم الله في أوله فليقل: بسم الله أوله وآخره»","صحيح","Sahih al-Jami al-Saghir 1323","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1324","«أما إنه لو قال حين أمسى: أعوذ بكلمات الله التامات من شر ما خلق ما ضره لدغ عقرب حتى يصبح»","صحيح","Sahih al-Jami al-Saghir 1324","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1325","«أما إنه لا يدرك قوم بعدكم صاعكم ولا مدكم»","صحيح","Sahih al-Jami al-Saghir 1325","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1326","أما بلغكم أني لعنت من وسم البهيمة في وجهها أو ¤ ضربها في وجهها""؟","صحيح","Sahih al-Jami al-Saghir 1326","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1327","«أما ترضى أن تكون لهم الدنيا ولنا الآخرة؟»","صحيح","Sahih al-Jami al-Saghir 1327","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1328","«أما رأيت العارض الذي عرض لي قبيل؟ هو ملك من الملائكة لم يهبط إلى الأرض قط قبل هذه الليلة استأذن ربه عز وجل أن يسلم علي ويبشرني أن الحسن والحسين سيدا شباب أهل الجنة وأن فاطمة سيدة نساء أهل الجنة»","صحيح","Sahih al-Jami al-Saghir 1328","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1329","«أما علمت أن الإسلام يهدم ما كان قبله وأن الهجرة تهدم ما كان قبلها وأن الحج يهدم ما كان قبله؟»","صحيح","Sahih al-Jami al-Saghir 1329","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1330","«أما علمت أن الملائكة لا تدخل بيتا فيه صورة وأن من صنع الصور يعذب يوم القيامة فيقال: أحيوا ما خلقتم؟»","صحيح","Sahih al-Jami al-Saghir 1330","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1331","[أما علمت أنك ومالك من كسب أبيك]","حسن","Sahih al-Jami al-Saghir 1331","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1332","«أما علمت أن ملكا ينادي في السماء يقول: اللهم اجعل لمال منفق خلفا واجعل لمال ممسك تلفا؟»","حسن","Sahih al-Jami al-Saghir 1332","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1333","«أما كان يجد هذا ما يسكن به رأسه؟ أما كان يجد هذا ما يغسل به ثيابه؟»","صحيح","Sahih al-Jami al-Saghir 1333","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1334","«أما مررت بوادي قومك ممحلا ثم تمر به خضرا ثم تمر به ممحلا ثم تمر به خضرا؟ {كَذَلِكَ يُحْيِي اللَّهُ الْمَوْتَى} »","حسن","Sahih al-Jami al-Saghir 1334","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1335","«أما والله إني لأتقاكم لله وأخشاكم له»","صحيح","Sahih al-Jami al-Saghir 1335","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1336","«أما والله إني لأخشاكم لله وأتقاكم له لكني أصوم وأفطر وأصلي وأرقد وأتزوج النساء فمن رغب عن سنتي فليس مني»","صحيح","Sahih al-Jami al-Saghir 1336","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1337","«أما والله إني لأمين في السماء وأمين في الأرض»","صحيح","Sahih al-Jami al-Saghir 1337","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1338","«أما والله لو كان أسامة جارية حليتها وزينتها حتى أنفقها»","صحيح","Sahih al-Jami al-Saghir 1338","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1339","«أما والله لولا أن الرسل لا تقتل لضربت أعناقكما»","حسن","Sahih al-Jami al-Saghir 1339","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1340","أما يخشى أحدكم إذا رفع رأسه في الصلاة أن لا يرجع ¤ إليه بصره؟","صحيح","Sahih al-Jami al-Saghir 1340","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1341","«أما يخشى أحدكم إذا رفع رأسه قبل الإمام أن يجعل الله رأسه رأس حمار أو يجعل الله صورته صورة حمار؟»","صحيح","Sahih al-Jami al-Saghir 1341","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1342","«أما إبراهيم فانظروا إلى صاحبكم وأما موسى فجعد آدم كأني أنظر إليه انحدر في الوادي يلبي على جمل أحمر مخطوم بخلبة»","صحيح","Sahih al-Jami al-Saghir 1342","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1343","«أما الرجل فلينثر رأسه فليغسله حتى يبلغ أصول الشعر وأما المرأة فلا عليها أن لا تنقضه لتغرف على رأسها ثلاث غرفات تكفيها»","صحيح","Sahih al-Jami al-Saghir 1343","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1344","«أما أنا فآخذ بكفي ثلاثا فأصب على رأسي ثم أفيض على سائر جسدي»","صحيح","Sahih al-Jami al-Saghir 1344","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1345","«أما أنا فأفيض على رأسي ثلاثا»","صحيح","Sahih al-Jami al-Saghir 1345","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1346","«أما أنا فلا آكل متكئا»","صحيح","Sahih al-Jami al-Saghir 1346","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1347","«أما أنت يا جعفر فأشبهت خلقي وخلقي وأما أنت يا علي فمني وأنا منك وأما أنت يا زيد فأخونا ومولانا والجارية عند خالتها فإن الخالة والدة»","صحيح","Sahih al-Jami al-Saghir 1347","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1348","«أما أنت يا جعفر فأشبه خلقك خلقي وأشبه خلقي خلقك وأنت مني وشجرتي وأما أنت يا علي فختني وأبوولدي وأنا منك وأنت مني وأما أنت يا زيد فمولاي ومني وإلي وأحب القوم إلي»","صحيح","Sahih al-Jami al-Saghir 1348","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1349","«أما أول أشراط الساعة فنار تخرج من المشرق فتحشر الناس إلى المغرب وأما أول ما يأكل أهل الجنة فزيادة كبد الحوت وأما شبه الولد أباه وأمه فإذا سبق ماء الرجل ماء المرأة نزع إليه الولد وإذا سبق ماء المرأة ماء الرجل نزع إليها»","صحيح","Sahih al-Jami al-Saghir 1349","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1350","«أما أهل النار الذين هم أهلها فإنهم لا يموتون فيها ولا يحيون ولكن ناس أصابتهم النار بذنوبهم فأماتتهم إماتة حتى إذا كانوا فحما أذن بالشفاعة فجيء بهم ضبائر ضبائر فبثوا على أنهار الجنة ثم قيل: يا أهل الجنة أفيضوا عليهم فينبتون نبات الحبة تكون في حميل السيل»","صحيح","Sahih al-Jami al-Saghir 1350","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1351","أما بعد ألا أيها الناس! فإنما أنا بشر يوشك أن يأتيني ¤ رسول ربي فأجيب وأنا تارك فيكم ثقلين أولهما كتاب الله فيه الهدى والنور من استمسك به وأخذ به كان على الهدى ومن أخطأه ضل فخذوا بكتاب الله تعالى واستمسكوا به وأهل بيتي أذكركم الله في أهل بيتي أذكركم الله في أهل بيتي","صحيح","Sahih al-Jami al-Saghir 1351","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1352","«أما بعد أيها الناس! فإن الناس يكثرون ويقل الأنصار حتى يكونوا في الناس بمنزلة الملح في الطعام فمن ولي منكم أمرا يضر فيه أحدا وينفع فيه أحدا فليقبل من محسنهم ويتجاوز عن مسيئهم»","صحيح","Sahih al-Jami al-Saghir 1352","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1353","«أما بعد فإن أصدق الحديث كتاب الله وإن أفضل الهدي هدي محمد وشر الأمور محدثاتها وكل محدثة بدعة وكل بدعة ضلالة وكل ضلالة في النار، أتتكم الساعة بغتة بعثت أنا والساعة هكذا صبحتكم الساعة ومستكم أنا أولى بكل مؤمن من نفسه من ترك مالا فلأهله ومن ترك دينا أوضياعا فإلي وعلي وأنا ولي المؤمنين»","صحيح","Sahih al-Jami al-Saghir 1353","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1354","أما بعد فإن الله أنزل في كتابه {يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ} إلى آخر الآية: {يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ} إلى قوله: {هُمُ الْفَائِزُونَ} , ¤ تصدقوا قبل أن لا تصدقوا تصدق رجل من ديناره تصدق رجل من درهمه تصدق رجل من بره تصدق رجل من تمره من شعيره لاتحقرن شيئا من الصدقة ولو بشق تمرة","صحيح","Sahih al-Jami al-Saghir 1354","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1355","«أما بعد فإنه لم يخف على شأنكم الليلة ولكني خشيت أن يفرض عليكم صلاة الليل فتعجزوا عنها»","صحيح","Sahih al-Jami al-Saghir 1355","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1356","«أما بعد فما بال أقوام يشترطون شروطا ليست في كتاب الله ما كان من شرط ليس في كتاب الله فهو باطل وإن كان مائة شرط قضاء الله أحق وشرط الله أوثق وإنما الولاء لمن أعتق»","صحيح","Sahih al-Jami al-Saghir 1356","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1357","«أما بعد فما بال العامل نستعمله فيأتينا فيقول: هذا من عملكم وهذا أهدي إلي أفلا قعد في بيت أبيه وأمه فينظر هل يهدى له أم لا؟ فوالذي نفس محمد بيده لا يغل أحدكم منها شيئا إلا جاء به يوم القيامة يحمله على عنقه إن كان بعيرا جاء به له رغاء وإن كانت بقرة جاء بها لها خوار وإن كانت شاة جاء بها تيعر فقد بلغت»","صحيح","Sahih al-Jami al-Saghir 1357","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1358","«أما بعد فوالله إني لأعطي الرجل وأدع الرجل والذي أدع أحب إلي من الذي أعطي ولكني أعطي أقواما لما أرى في قلوبهم من الجزع والهلع وأكل أقواما إلى ما جعل الله في قلوبهم من الغنى والخير منهم عمرو بن تغلب»","صحيح","Sahih al-Jami al-Saghir 1358","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1359","«أما بعد يا معشر قريش! فإنكم أهل هذا الأمر ما لم تعصوا الله فإذا عصيتموه بعث عليكم من يلحاكم كما يلحى هذا القضيب»","صحيح","Sahih al-Jami al-Saghir 1359","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1360","«أما خروجك من بيتك تؤم البيت الحرام فإن لك بكل وطأة تطؤها راحلتك يكتب الله لك بها حسنة ويمحو عنك بها سيئة; وأما وقوفك بعرفة فإن الله عز وجل ينزل إلى السماء الدنيا فيباهي بهم الملائكة فيقول: هؤلاء عبادي جاءوني شعثا غبرا من كل فج عميق يرجون رحمتي ويخافون عذابي ولم يروني فكيف لو رأوني؟ فلو كان عليك مثل رمل عالج، أو مثل أيام الدنيا أو مثل قطر السماء ذنوبا غسلها الله عنك; وأما رميك الجمار فإنه مدخور لك; وأما حلقك رأسك فإن لك بكل شعرة تسقط حسنة فإذا طفت بالبيت خرجت من ذنوبك كيوم ولدتك أمك»","حسن","Sahih al-Jami al-Saghir 1360","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1361","أما فتنة الدجال فإنه لم يكن نبي إلا قد حذر أمته وسأحذركموه بحديث لم يحذره نبي أمته إنه أعور وإن الله ليس بأعور مكتوب بين عينيه كافر يقرأه كل مؤمن; وأما فتنة القبر فبي تفتنون وعني تسألون فإذا كان الرجل الصالح ¤ أجلس في قبره غير فزع ثم يقال له: ما هذا الرجل الذي كان فيكم؟ فيقول: محمد رسول الله جاءنا بالبينات من عند الله فصدقناه فيفرج له فرجة قبل النار فينظر إليها يحطم بعضها بعضا فيقال له: انظر إلى ما وقاك الله ثم يفرج له فرجة إلى الجنة فينظر إلى زهرتها وما فيها فيقال له: هذا مقعدك منها ويقال له: على اليقين كنت وعليه مت وعليه تبعث إن شاء الله، وإذا كان الرجل السوء أجلس في قبره فزعا فيقال له: ما كنت تقول؟ فيقول: لا أدري فيقال: ما هذا الرجل الذي كان فيكم؟ فيقول: سمعت الناس يقولون قولا فقلت كما قالوا فيفرج له فرجة من قبل الجنة فينظر إلى زهرتها وما فيها فيقال له: انظر إلى ما صرف الله عنك ثم يفرج له فرجة قبل النار فينظر إليها يحطم بعضها بعضا ويقال: هذا مقعدك منها على الشك كنت وعليه مت وعليه تبعث إن شاء الله ثم يعذب","حسن","Sahih al-Jami al-Saghir 1361","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1362","أما قطع السبيل فإنه لا يأتي عليك إلا قليل حتى يخرج العير إلى مكة بغير خفير; وأما العيلة فإن الساعة لا تقوم حتى يطوف أحدكم بصدقته ولا يجد من يقبلها منه; ثم ليقفن أحدكم بين يدي الله ليس بينه وبينه حجاب ولا ترجمان يترجم له ثم ليقولن له: ألم أوتك مالا؟ فليقولن: بلى، ثم ليقولن: ألم أرسل إليك رسولا؟ فليقولن: بلى فينظر عن يمينه فلا يرى إلا النار ثم ينظر عن شماله فلا يرى إلا النار فليتقين أحدكم ¤ النار ولوبشق تمرة فإن لم يجد فبكلمة طيبة","صحيح","Sahih al-Jami al-Saghir 1362","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1363","«أما ما ذكرت من آنية أهل الكتاب فإن وجدتم غيرها فلا تأكلوا فيها وإن لم تجدوا غيرها فاغسلوها وكلوا فيها وما صدت بقوسك وذكرت اسم الله عليه فكله وما صدت بكلبك المعلم وذكرت اسم الله عليه فكل وما صدت بكلبك غير المعلم فأدركت ذكاته فكل»","صحيح","Sahih al-Jami al-Saghir 1363","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1364","«أمامكم حوض كما بين جرباء وأذرح»","صحيح","Sahih al-Jami al-Saghir 1364","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1365","«أمثل ما تداويتم به الحجامة والقسط البحري»","صحيح","Sahih al-Jami al-Saghir 1365","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1366","«أمر ابن آدم أن يسجد على سبعة أعظم»","صحيح","Sahih al-Jami al-Saghir 1366","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1367","«أمرت الرسل أن لا تأكل إلا طيبا ولا تعمل إلا صالحا»","حسن","Sahih al-Jami al-Saghir 1367","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1368","«أمرت أن أبشر خديجة ببيت في الجنة من قصب لا صخب فيها ولا نصب»","صحيح","Sahih al-Jami al-Saghir 1368","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1369","«أمرت أن أسجد على سبعة أعظم: على الجبهة واليدين والركبتين وأطراف القدمين ولا نكفت الثياب ولا الشعر»","صحيح","Sahih al-Jami al-Saghir 1369","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1370","«أمرت أن أقاتل الناس حتى يشهدوا أن لا إله إلا الله وأني رسول الله فإذا قالوها عصموا مني دماءهم وأموالهم إلا بحقها وحسابهم على الله»","صحيح","Sahih al-Jami al-Saghir 1370","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1371","«أمرت أن أقاتل الناس حتى يشهدوا أن لا إله إلا الله وأني رسول الله ويقيموا الصلاة ويؤتوا الزكاة فإذا فعلوا ذلك عصموا مني دماءهم وأموالهم إلا بحقها وحسابهم على الله»","صحيح","Sahih al-Jami al-Saghir 1371","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1372","«أمرت أن أقاتل الناس حتى يشهدوا أن لا إله إلا الله ويؤمنوا بي وبما جئت به فإذا فعلوا ذلك فقد عصموا مني دماءهم وأموالهم إلا بحقها وحسابهم على الله عز وجل»","صحيح","Sahih al-Jami al-Saghir 1372","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1373","«أمرت أن أقاتل الناس حتى يقولوا لا إله إلا الله فمن قال لا إله إلا الله فقد عصم مني ماله ونفسه إلا بحقه وحسابه على الله»","صحيح","Sahih al-Jami al-Saghir 1373","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1374","«أمرت أن أقرأ القرآن على سبعة أحرف كل شاف كاف»","صحيح","Sahih al-Jami al-Saghir 1374","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1375","«أمرت بالسواك حتى خشيت أن أدرد»","صحيح","Sahih al-Jami al-Saghir 1375","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1376","«أمرت بالسواك حتى خشيت أن يكتب علي»","حسن","Sahih al-Jami al-Saghir 1376","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1377","«أمرت بالسواك حتى خفت على أسناني»","صحيح","Sahih al-Jami al-Saghir 1377","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1378","«أمرت بقرية تأكل القرى يقولون يثرب وهي المدينة تنفي الناس كما ينفي الكير خبث الحديد»","صحيح","Sahih al-Jami al-Saghir 1378","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1379","«أمركن مما يهمني بعدي ولن يصبر عليكن إلا الصابرون»","صحيح","Sahih al-Jami al-Saghir 1379","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1380","«أمرنا بإسباغ الوضوء»","صحيح","Sahih al-Jami al-Saghir 1380","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1381","«أمرنا بالتسبيح في أدبار الصلوات ثلاثا وثلاثين تسبيحة وثلاثا وثلاثين تحميدة وأربعا وثلاثين تكبيرة»","صحيح","Sahih al-Jami al-Saghir 1381","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1382","«أمرني جبريل أن أكبر»","صحيح","Sahih al-Jami al-Saghir 1382","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1383","«أمرني جبريل بالسواك حتى ظننت أني سأدرد»","صحيح","Sahih al-Jami al-Saghir 1383","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1384","«أمرني جبريل برفع الصوت في الإهلال فإنه من شعار الحج»","صحيح","Sahih al-Jami al-Saghir 1384","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1385","«امسحوا رغام الغنم وطيبوا مراحها وصلوا في جانب مراحها فإنها من دواب الجنة»","صحيح","Sahih al-Jami al-Saghir 1385","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1386","«امسحوا على الخفاف ثلاثة أيام»","صحيح","Sahih al-Jami al-Saghir 1386","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1387","«أمسك عليك بعض مالك فهو خير لك»","صحيح","Sahih al-Jami al-Saghir 1387","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1388","أمسكوا عليكم أموالكم ولا تفسدوها فإنه من ¤ أعمر عمرى فهي للذي أعمرها حيا وميتا ولعقبه","صحيح","Sahih al-Jami al-Saghir 1388","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1389","«امشوا أمامي خلوا ظهري للملائكة»","صحيح","Sahih al-Jami al-Saghir 1389","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1390","«أمط الأذى عن الطريق فإنه لك صدقة»","صحيح","Sahih al-Jami al-Saghir 1390","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1391","«املك عليك لسانك»","صحيح","Sahih al-Jami al-Saghir 1391","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1392","«املك عليك لسانك وليسعك بيتك وابك على خطيئتك»","صحيح","Sahih al-Jami al-Saghir 1392","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1393","«املك يدك»","صحيح","Sahih al-Jami al-Saghir 1393","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1394","«أم القرآن هي: السبع المثاني والقرآن العظيم»","صحيح","Sahih al-Jami al-Saghir 1394","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1395","«أمتي الغر المحجلون»","صحيح","Sahih al-Jami al-Saghir 1395","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1396","«أمتي هذه أمة مرحومة ليس عليها عذاب في الآخرة إنما عذابها في الدنيا الفتن والزلازل والقتل والبلايا»","صحيح","Sahih al-Jami al-Saghir 1396","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1397","«أمتي يوم القيامة غر من السجود محجلون من الوضوء»","صحيح","Sahih al-Jami al-Saghir 1397","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1398","«أم قومك ومن أم قوما فليخفف فإن فيهم الكبير وإن فيهم المريض وإن فيهم الضعيف وإن فيهم ذا الحاجة فإذا صلى أحدكم وحده فليصل كيف شاء»","صحيح","Sahih al-Jami al-Saghir 1398","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1399","«أمك ثم أمك ثم أمك ثم أباك ثم الأقرب فالأقرب»","حسن","Sahih al-Jami al-Saghir 1399","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1400","«أمك وأباك وأختك وأخاك وأدناك أدناك»","حسن","Sahih al-Jami al-Saghir 1400","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1401","«أمنوا إذا قرئ {غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ} »","صحيح","Sahih al-Jami al-Saghir 1401","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1402","«أمني جبريل عند البيت مرتين فصلى بي الظهر حين زالت الشمس وكانت قدر الشراك وصلى بي العصر حين كان ظله مثله وصلى بي المغرب حين أفطر الصائم وصلى بي العشاء حين غاب الشفق وصلى بي الفجر حين حرم الطعام والشراب على الصائم فلما كان الغد صلى بي الظهر حين كان ظله مثله وصلى بي العصر حين كان ظله مثليه وصلى بي المغرب حين أفطر الصائم وصلى بي العشاء إلى ثلث الليل وصلى بي الفجر فأسفر ثم التفت إلي وقال: يا محمد هذا وقت الأنبياء من قبلك والوقت ما بين هذين الوقتين»","صحيح","Sahih al-Jami al-Saghir 1402","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1403","«أمناء المسلمين على صلاتهم وسحورهم هم المؤذنون»","حسن","Sahih al-Jami al-Saghir 1403","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1404","«أمهلوا حتى ندخل ليلا لكي تمتشط الشعثة وتستحد المغيبة»","صحيح","Sahih al-Jami al-Saghir 1404","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1405","«أميطي عنا قرامك هذا فإنه لا تزال تصاويره تعرض لي في صلاتي»","صحيح","Sahih al-Jami al-Saghir 1405","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1406","«أمين هذه الأمة أبوعبيدة بن الجراح»","صحيح","Sahih al-Jami al-Saghir 1406","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1407","«إن أبيتم إلا أن تجلسوا فاهدوا السبيل وردوا السلام وأعينوا المظلوم»","صحيح","Sahih al-Jami al-Saghir 1407","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1408","«إن اتخذت شعرا فأكرمه»","حسن","Sahih al-Jami al-Saghir 1408","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1409","«إن أحببتم أن يحبكم الله تعالى ورسوله فأدوا إذا ائتمنتم واصدقوا إذا حدثتم وأحسنوا جوار من جاوركم»","حسن","Sahih al-Jami al-Saghir 1409","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1410","«إن أردت أن يلين قلبك فأطعم المسكين وامسح رأس اليتيم»","حسن","Sahih al-Jami al-Saghir 1410","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1411","«إن أمر عليكم عبد مجدع أسود يقودكم بكتاب الله فاسمعوا له وأطيعوا»","صحيح","Sahih al-Jami al-Saghir 1411","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1412","«إن أنتم قدرتم عليه فاقتلوه ولا تحرقوه بالنار فإنه إنما يعذب بالنار رب النار»","صحيح","Sahih al-Jami al-Saghir 1412","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1413","إن بعت من أخيك تمرا فأصابه جائحة فلا يحل ¤ لك أن تأخذ منه شيئا بم تأخذ مال أخيك بغير حق؟!","صحيح","Sahih al-Jami al-Saghir 1413","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1414","«إن بيتم فليكن شعاركم» حم لا ينصرون","صحيح","Sahih al-Jami al-Saghir 1414","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1415","«إن تصدق الله يصدقك»","صحيح","Sahih al-Jami al-Saghir 1415","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1416","«إن تطعنوا في إمارته فقد كنتم تطعنون في إمارة أبيه من قبل وأيم الله إن كان لخليقا بالإمارة وإن كان لمن أحب الناس إلي وإن هذا لمن أحب الناس إلي بعده وأوصيكم به فإنه من صالحيكم - يعني أسامة بن زيد -»","صحيح","Sahih al-Jami al-Saghir 1416","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1417","«إن تغفر اللهم تغفر جما وأي عبد لك لا ألمَّا»","صحيح","Sahih al-Jami al-Saghir 1417","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1418","«إن شئت حبست أصلها وتصدقت بها»","صحيح","Sahih al-Jami al-Saghir 1418","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1419","«إن شئتما أعطيتكما ولا حظ فيها لغني ولا لقوي مكتسب»","صحيح","Sahih al-Jami al-Saghir 1419","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1420","«إن شئتم أنبأتكم عن الإمارة وما هي؟ أولها ملامة وثانيها ندامة وثالثها عذاب يوم القيامة إلا من عدل»","حسن","Sahih al-Jami al-Saghir 1420","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1421","«إن عشت إن شاء الله لأنهين أمتي أن يسموا نافعا وأفلح وبركة»","صحيح","Sahih al-Jami al-Saghir 1421","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1422","«إن عطب منها شيء فانحره ثم اغمس نعله في دمه ثم اضرب صفحته ثم خل بينه وبين الناس فليأكلوه»","صحيح","Sahih al-Jami al-Saghir 1422","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1423","«إن عطب منها شيء فخشيت عليه موتا فاذبحها ثم اغمس نعلها في دمها ثم اضرب بها صفحتها ولا تطعم منها أنت ولا أحد من أهل رفقتك واقسمها»","صحيح","Sahih al-Jami al-Saghir 1423","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1424","«إن قامت الساعة وفي يد أحدكم فسيلة فإن استطاع أن لا تقوم حتى يغرسها فليغرسها»","صحيح","Sahih al-Jami al-Saghir 1424","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1425","«إن قتلت في سبيل الله صابرا محتسبا مقبلا غير مدبر كفر الله عنك خطاياك إلا الدين كذلك قال لي جبريل آنفا»","صحيح","Sahih al-Jami al-Saghir 1425","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1426","«إن قضى الله تعالى شيئا ليكونن وإن عزل»","صحيح","Sahih al-Jami al-Saghir 1426","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1427","«إن كان الشؤم في شيء ففي الدار والمرأة والفرس»","صحيح","Sahih al-Jami al-Saghir 1427","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1428","«إن كان خرج يسعى على ولده صغارا فهو في سبيل الله وإن كان خرج يسعى على أبوين شيخين كبيرين فهو في سبيل الله وإن كان خرج يسعى على نفسه يعفها فهو في سبيل الله وإن كان خرج يسعى رياء ومفاخرة فهو في سبيل الشيطان»","صحيح","Sahih al-Jami al-Saghir 1428","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1429","«إن كان عندك ماء بات هذه الليلة في شن فاسقنا وإلا كرعنا»","صحيح","Sahih al-Jami al-Saghir 1429","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1430","«إن كان في شيء مما تداوون به خير فالحجامة»","صحيح","Sahih al-Jami al-Saghir 1430","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1431","«إن كان في شيء من أدويتكم خير ففى شرطة محجم أو شربة من عسل أو لذعة بنار توافق داء وما أحب أن أكتوي»","صحيح","Sahih al-Jami al-Saghir 1431","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1432","إن كان ينفعهم ذلك فليصنعوه فإني إنما ظننت ظنا فلا تؤاخذوني بالظن ولكن إذا حدثتكم عن الله شيئا فخذوا به فإني ¤ لن أكذب على الله","صحيح","Sahih al-Jami al-Saghir 1432","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1433","«إن كنت ألممت بذنب فاستغفري الله وتوبي إليه فإن التوبة من الذنب: الندم والاستغفار»","صحيح","Sahih al-Jami al-Saghir 1433","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1434","«إن كنت صائما فصم أيام الغر»","حسن","Sahih al-Jami al-Saghir 1434","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1435","«إن كنت صائما فعليك بالغر البيض: ثلاث عشرة وأربع عشرة وخمس عشرة»","حسن","Sahih al-Jami al-Saghir 1435","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1436","«إن كنت عبدا لله فارفع إزارك»","صحيح","Sahih al-Jami al-Saghir 1436","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1437","«إن كنتم آنفا تفعلون فعل فارس والروم يقومون على ملوكهم وهم قعود فلا تفعلوا ائتموا بأئمتكم إن صلى قائما فصلوا قياما وإن صلى قاعدا فصلوا قعودا»","صحيح","Sahih al-Jami al-Saghir 1437","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1438","«إن كنتم تحبون حلية الجنة وحريرها فلا تلبسوها في الدنيا»","صحيح","Sahih al-Jami al-Saghir 1438","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1439","إن لم تجدوا إلا مرابض الغنم وأعطان الإبل ¤ فصلوا في مرابض الغنم ولا تصلوا في أعطان الإبل فإنها خلقت من الشياطين","صحيح","Sahih al-Jami al-Saghir 1439","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1440","«إن لم تجدي له شيئا تعطينه إياه إلا ظلفا محرقا فادفعيه إليه في يده»","صحيح","Sahih al-Jami al-Saghir 1440","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1441","«إن نزلتم بقوم فأمروا لكم بما ينبغي للضيف فاقبلوا فإن لم يفعلوا فخذوا منهم حق الضيف الذي ينبغي لهم»","صحيح","Sahih al-Jami al-Saghir 1441","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1442","«إن وجدتم غير آنيتهم - يعني أهل الكتاب - فلا تأكلوا فيها وإن لم تجدوا فاغسلوها وكلوا فيها»","صحيح","Sahih al-Jami al-Saghir 1442","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1443","«إن يعش هذا الغلام فعسى أن لا يبلغ الهرم حتى تقوم الساعة»","صحيح","Sahih al-Jami al-Saghir 1443","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1444","«إن يكن هو فلن تسلط عليه وإن لم يكن هو فلا خير لك في قتله»","صحيح","Sahih al-Jami al-Saghir 1444","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1445","إن يمنح أحدكم أخاه خير له من أن يأخذ عليه ¤ خرجا معلوما","صحيح","Sahih al-Jami al-Saghir 1445","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1446","«أنا ابن العواتك من سليم»","حسن","Sahih al-Jami al-Saghir 1446","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1447","«أنا أبوالقاسم الله يعطي وأنا أقسم»","حسن","Sahih al-Jami al-Saghir 1447","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1448","«أنا أتقاكم لله وأعلمكم بحدود الله»","صحيح","Sahih al-Jami al-Saghir 1448","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1449","«إناء كإناء وطعام كطعام»","صحيح","Sahih al-Jami al-Saghir 1449","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1450","«أنا أكثر الأنبياء تبعا يوم القيامة وأنا أول من يقرع باب الجنة»","صحيح","Sahih al-Jami al-Saghir 1450","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1451","«أنا النبي لا كذب أنا ابن عبد المطلب»","صحيح","Sahih al-Jami al-Saghir 1451","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1452","«أنا أولى الناس بعيسى بن مريم في الدنيا والآخرة ليس بيني وبينه نبي والأنبياء أولاد علات أمهاتهم شتى ودينهم واحد»","صحيح","Sahih al-Jami al-Saghir 1452","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1453","أنا أولى بالمؤمنين في كتاب الله فأيكم ما ترك دينا أو ضيعة فادعوني فأنا وليه وأيكم ما ترك مالا فليؤثر بماله عصبته ¤ من كان","صحيح","Sahih al-Jami al-Saghir 1453","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1454","«أنا أولى بالمؤمنين من أنفسهم فمن توفي من المؤمنين فترك دينا فعلي قضاؤه ومن ترك مالا فهو لورثته»","صحيح","Sahih al-Jami al-Saghir 1454","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1455","«أنا أولى بكل مؤمن من نفسه فمن ترك دينا أو ضيعة فإلي ومن ترك مالا فلورثته وأنا مولى من لا مولى له أرث ماله وأفك عانيه والخال مولى من لا مولى له يرث ماله ويعقل عنه»","حسن","Sahih al-Jami al-Saghir 1455","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1456","«أنا أولى بكل مؤمن من نفسه فمن ترك دينا فعلي ومن ترك مالا فلورثته»","صحيح","Sahih al-Jami al-Saghir 1456","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1457","«أنا أول الناس يشفع في الجنة وأنا أكثر الأنبياء تبعا»","صحيح","Sahih al-Jami al-Saghir 1457","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1458","«أنا أول شفيع في الجنة لم يصدق نبي من الأنبياء ما صدقت وإن من الأنبياء نبيا ما يصدقه من أمته إلا رجل واحد»","صحيح","Sahih al-Jami al-Saghir 1458","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1459","«أنا أول من يأخذ بحلقة باب الجنة فأقعقعها»","صحيح","Sahih al-Jami al-Saghir 1459","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1460","«أنا بريء ممن حلق وسلق وخرق»","صحيح","Sahih al-Jami al-Saghir 1460","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1461","«أنا بريء من كل مسلم يقيم بين أظهر المشركين لا تراءى نارهما»","حسن","Sahih al-Jami al-Saghir 1461","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1462","«أنا حرب لمن حاربتم وسلم لمن سالمتم»","حسن","Sahih al-Jami al-Saghir 1462","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1463","«أنا دعوة إبراهيم وكان آخر من بشر بي عيسى بن مريم»","صحيح","Sahih al-Jami al-Saghir 1463","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1464","«أنا زعيم بيت في ربض الجنة لمن ترك المراء وإن كان محقا وبيت في وسط الجنة لمن ترك الكذب وإن كان مازحا وبيت في أعلى الجنة لمن حسن خلقه»","حسن","Sahih al-Jami al-Saghir 1464","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1465","أنا زعيم لمن آمن بي وأسلم وهاجر ببيت في ¤ ربض الجنة وبيت في وسط الجنة وبيت في أعلى غرف الجنة، وأنا زعيم لمن آمن بي وأسلم وجاهد في سبيل الله ببيت في ربض الجنة وبيت في وسط الجنة وبيت في أعلى غرف الجنة، فمن فعل ذلك لم يدع للخير مطلبا ولا من الشر مهربا يموت حيث شاء أن يموت","صحيح","Sahih al-Jami al-Saghir 1465","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1466","أنا سيد الناس يوم القيامة وهل تدرون مم ذلك؟ يجمع الله الأولين والآخرين في صعيد واحد يسمعهم الداعي وينفذهم البصر وتدنوالشمس منهم فيبلغ الناس من الغم والكرب ما لا يطيقون ولا يحتملون فيقول بعض الناس لبعض: ألا ترون ما قد بلغكم؟ ألا تنظرون من يشفع لكم إلى ربكم؟ فيقول بعض الناس لبعض: ائتوا آدم فيأتون آدم فيقولون: يا آدم أنت أبونا أنت أبوالبشر خلقك الله بيده ونفخ فيك من روحه وأمر الملائكة فسجدوا لك اشفع لنا إلى ربك ألا ترى ما نحن فيه؟ ألا ترى ما قد بلغنا؟ فيقول لهم آدم: إن ربي قد غضب اليوم غضبا لم يغضب قبله مثله ولن يغضب بعده مثله وإنه نهاني عن الشجرة فعصيته نفسي نفسي نفسي اذهبوا إلى غيري اذهبوا إلى نوح; فيأتون نوحا فيقولون: أنت أول الرسل إلى أهل الأرض وسماك الله {عَبْداً شَكُوراً} اشفع لنا إلى ربك ألا ترى ما نحن فيه؟ ألا ترى ما قد بلغنا؟ فيقول لهم نوح: إن ربي قد غضب اليوم غضبا لم يغضب قبله مثله ولن يغضب بعده مثله وإنه قد كانت لي دعوة دعوت بها على قومي نفسي نفسي نفسي اذهبوا إلى غيري اذهبوا إلى إبراهيم; فيأتون إبراهيم فيقولون: يا إبراهيم؟ أنت نبي الله وخليله من أهل الأرض اشفع لنا إلى ربك ألا ترى ما ¤ نحن فيه؟ ألا ترى ما قد بلغنا؟ فيقول لهم إبراهيم: إن ربي قد غضب اليوم غضبا لم يغضب قبله مثله ولن يغضب بعده مثله وإني قد كنت كذبت ثلاث كذبات نفسي نفسي نفسي اذهبوا إلى غيري اذهبوا إلى موسى; فيأتون موسى فيقولون: يا موسى! أنت رسول الله فضلك الله برسالاته وبكلامه على الناس اشفع لنا إلى ربك ألا ترى ما نحن فيه؟ ألا ترى ما قد بلغنا؟ فيقول: إن ربي قد غضب اليوم غضبا لم يغضب قبله مثله ولن يغضب بعده مثله وإني قتلت نفسا لم أومر بقتلها نفسي نفسي نفسي اذهبوا إلى غيري اذهبوا إلى عيسى; فيأتون عيسى! فيقولون: يا عيسى أنت رسول الله وكلمته ألقاها إلى مريم وروح منه وكلمت الناس في المهد اشفع لنا إلى ربك ألا ترى ما نحن فيه؟ ألا ترى ما قد بلغنا؟ فيقول لهم عيسى: إن ربي قد غضب اليوم غضبا لم يغضب قبله مثله ولن يغضب بعده مثله نفسي نفسي نفسي اذهبوا إلى غيري اذهبوا إلى محمد; فيأتوني فيقولون: يا محمد! أنت رسول الله وخاتم الأنبياء وغفر الله لك ما تقدم من ذنبك وما تأخر اشفع لنا إلى ربك ألا ترى ما نحن فيه؟ ألا ترى ما قد بلغنا؟ فأنطلق فآتي تحت العرش فأقع ساجدا لربي ثم يفتح الله علي ويلهمني من محامده وحسن الثناء عليه شيئا لم يفتحه لأحد قبلي ثم يقال: يا محمد! ارفع رأسك سل تعط واشفع تشفع فأرفع رأسي فأقول: يا رب! أمتي أمتي فيقال: يا محمد أدخل الجنة من أمتك من لا حساب عليه من الباب الأيمن من أبواب الجنة وهم شركاء الناس فيما سوى ذلك من الأبواب والذي نفسي بيده إن ما بين مصراعين من مصاريع الجنة لكما بين مكة وهجر أوكما بين مكة وبصرى","صحيح","Sahih al-Jami al-Saghir 1466","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1467","«أنا سيد ولد آدم يوم القيامة وأول من ينشق عنه القبر وأول شافع وأول مشفع»","صحيح","Sahih al-Jami al-Saghir 1467","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1468","«أنا سيد ولد آدم يوم القيامة ولا فخر وبيدي لواء الحمد ولا فخر وما من نبي يومئذ آدم فمن سواه إلا تحت لوائي وأنا أول شافع وأول مشفع ولا فخر»","صحيح","Sahih al-Jami al-Saghir 1468","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1469","«أنا فرطكم على الحوض»","صحيح","Sahih al-Jami al-Saghir 1469","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1470","«أنا فرطكم على الحوض أنتظركم ليرفع لي رجال منكم حتى إذا عرفتهم اختلجوا دوني فأقول: رب أصحابي! رب أصحابي! فيقال: إنك لا تدري ما أحدثوا بعدك»","صحيح","Sahih al-Jami al-Saghir 1470","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1471","«أنا فرطكم على الحوض ولأنازعن أقواما ثم لأغلبن عليهم فأقول: يا رب أصحابي أصحابي! فيقول: إنك لا تدري ما أحدثوا بعدك»","صحيح","Sahih al-Jami al-Saghir 1471","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1472","«أنا محمد بن عبد الله بن عبد المطلب إن الله تعالى خلق الخلق فجعلني في خيرهم ثم جعلهم فرقتين فجعلني في خيرهم فرقة ثم جعلهم قبائل فجعلني في خيرهم قبيلة ثم جعلهم بيوتا فجعلني في خيرهم بيتا فأنا خيركم بيتا وأنا خيركم نفسا»","صحيح","Sahih al-Jami al-Saghir 1472","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1473","«أنا محمد وأحمد والمقفي والحاشر ونبي التوبة ونبي الرحمة»","صحيح","Sahih al-Jami al-Saghir 1473","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1474","«أنا وارث من لا وارث له أفك عانيه وأرث ماله والخال وارث من لا وارث له يفك عانيه ويرث ماله»","صحيح","Sahih al-Jami al-Saghir 1474","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1475","«أنا وكافل اليتيم في الجنة هكذا»","صحيح","Sahih al-Jami al-Saghir 1475","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1476","«أنا وكافل اليتيم له أولغيره في الجنة والساعي على الأرملة والمسكين كالمجاهد في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 1476","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1477","«انبذوه على غدائكم واشربوه على عشائكم وانبذوه على عشائكم واشربوه على غدائكم وانبذوه في الشنان ولا تنبذوه في القلل فإنه إذا تأخر عن عصره صار خلا»","صحيح","Sahih al-Jami al-Saghir 1477","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1478","«أنت أحق بصدر دابتك مني إلا أن تجعله لي»","صحيح","Sahih al-Jami al-Saghir 1478","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1479","«أنت أخونا ومولانا - قاله لزيد بن حارثة -»","صحيح","Sahih al-Jami al-Saghir 1479","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1480","«أنت إمامهم واقتد بأضعفهم واتخذ مؤذنا لا يأخذ على أذانه أجرا»","صحيح","Sahih al-Jami al-Saghir 1480","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1481","«أنت رفيق والله الطبيب»","صحيح","Sahih al-Jami al-Saghir 1481","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1482","«أنت عتيق الله من النار» - قاله لأبي بكر -","صحيح","Sahih al-Jami al-Saghir 1482","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1483","«أنت مع من أحببت»","صحيح","Sahih al-Jami al-Saghir 1483","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1484","«أنت مني بمنزلة هارون من موسى إلا أنه لا نبي بعدي»","صحيح","Sahih al-Jami al-Saghir 1484","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1485","«أنت مني وأنا منك» - قاله لعلي -","صحيح","Sahih al-Jami al-Saghir 1485","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1486","«أنت ومالك لأبيك»","صحيح","Sahih al-Jami al-Saghir 1486","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1487","«أنت ومالك لوالدك إن أولادكم من أطيب كسبكم فكلوا من كسب أولادكم»","صحيح","Sahih al-Jami al-Saghir 1487","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1488","«أنتم أعلم بأمر دنياكم»","صحيح","Sahih al-Jami al-Saghir 1488","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1489","«أنتم الغر المحجلون يوم القيامة من إسباغ الوضوء...... ... »","صحيح","Sahih al-Jami al-Saghir 1489","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1490","«أنتم شهداء الله في الأرض والملائكة شهداء الله في السماء»","صحيح","Sahih al-Jami al-Saghir 1490","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1491","«انتدب الله لمن خرج في سبيله لا يخرجه إلا إيمان بي وتصديق برسلي أن أرجعه بما نال من أجر أوغنيمة أو أدخله الجنة ولولا أن أشق على أمتي ما قعدت خلف سرية ولوددت أني أقتل في سبيل الله ثم أحيا ثم أقتل ثم أحيا ثم أقتل ثم أحيا»","صحيح","Sahih al-Jami al-Saghir 1491","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1492","«انتسب رجلان على عهد موسى فقال أحدهما: أنا فلان ابن فلان حتى عد تسعة فمن أنت لا أم لك؟ قال: أنا فلان ابن فلان ابن الإسلام فأوحى الله إلى موسى أن قل لهذين المنتسبين: أما أنت أيها المنتسب إلى تسعة في النار فأنت عاشرهم في النار، وأما أنت أيها المنتسب إلى اثنين في الجنة فأنت ثالثهما في الجنة»","صحيح","Sahih al-Jami al-Saghir 1492","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1493","«انتعلوا وتخففوا وخالفوا أهل الكتاب»","صحيح","Sahih al-Jami al-Saghir 1493","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1494","«انزعوا بني عبد المطلب! فلولا أن تغلبكم الناس على سقايتكم لنزعت معكم»","صحيح","Sahih al-Jami al-Saghir 1494","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1495","«أنزل القرآن على سبعة أحرف»","صحيح","Sahih al-Jami al-Saghir 1495","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1496","«أنزل القرآن من سبعة أبواب على سبعة أحرف كلها شاف كاف»","صحيح","Sahih al-Jami al-Saghir 1496","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1497","«أنزلت صحف إبراهيم أول ليلة من شهر رمضان وأنزلت التوراة لست مضت من رمضان وأنزل الإنجيل لثلاث عشرة مضت من رمضان وأنزل الزبور لثمان عشرة خلت من رمضان وأنزل القرآن لأربع وعشرين خلت من رمضان»","حسن","Sahih al-Jami al-Saghir 1497","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1498","«أنزلت علي آنفا سورة {ِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ فَصَلِّ لِرَبِّكَ وَانْحَرْ ِنَّ إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ} أتدرون ما الكوثر؟ فإنه نهر وعدنيه ربي عليه خير كثير هو حوضي ترد عليه أمتي يوم القيامة آنيته كعدد النجوم فيختلج العبد منهم فأقول: رب إنه من أمتي فيقول: ما تدري ما أحدث بعدك»","صحيح","Sahih al-Jami al-Saghir 1498","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1499","أنزل علي آيات لم ير مثلهن قط {قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ} ¤ و {قُلْ أَعُوذُ بِرَبِّ النَّاسِ}","صحيح","Sahih al-Jami al-Saghir 1499","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1500","«انزل عنه فلا تصحبنا بملعون لا تدعوا على أنفسكم ولا تدعوا على أولادكم ولا تدعوا على أموالكم لا توافقوا من الله ساعة يسأل فيها عطاء فيستجيب لكم»","صحيح","Sahih al-Jami al-Saghir 1500","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1501","«انصر أخاك ظالما أو مظلوما إن يك ظالما فاردده عن ظلمه وإن يك مظلوما فانصره»","صحيح","Sahih al-Jami al-Saghir 1501","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1502","«انصر أخاك ظالما أو مظلوما قيل: كيف أنصره ظالما؟ قال: تحجزه عن الظلم فإن ذلك نصره»","صحيح","Sahih al-Jami al-Saghir 1502","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1503","«انطلق أبا مسعود! لا ألفينك يوم القيامة تجيء على ظهرك بعير من إبل الصدقة له رغاء قد غللته»","صحيح","Sahih al-Jami al-Saghir 1503","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1504","انطلق ثلاثة رهط ممن كان قبلكم حتى أووا المبيت إلى غار فدخلوه فانحدرت عليهم صخرة من الجبل فسدت عليهم الغار فقالوا: إنه لا ينجيكم من هذه الصخرة إلا أن تدعوا الله بصالح أعمالكم; قال رجل منهم: اللهم كان لي أبوان شيخان كبيران وكنت لا أغبق قبلهما أهلا ولا مالا فنأى بي في طلب شيء يوما فلم ¤ أرح عليهما حتى ناما فحلبت لهما غبوقهما فوجدتهما نائمين فكرهت أن أغبق قبلهما أهلا أو مالا فلبثت والقدح على يدي أنتظر استيقاظهما حتى برق الفجر فاستيقظا فشربا غبوقهما اللهم إن كنت فعلت ذلك ابتغاء وجهك ففرج عنا ما نحن فيه من هذه الصخرة؟ فانفرجت شيئا لا يستطيعون الخروج; وقال الآخر: اللهم كانت لي ابنة عم كانت أحب الناس إلى فأردتها على نفسها فامتنعت مني حتى ألمت بها سنة من السنين فجاءتني فأعطيتها عشرين ومائة دينار على أن تخلي بيني وبين نفسها ففعلت حتى إذا قدرت عليها قالت: لا أحل لك أن تفض الخاتم إلا بحقه فتحرجت من الوقوع عليها فانصرفت عنها وهي أحب الناس إلي وتركت الذهب الذي أعطيتها اللهم إن كنت فعلت ذلك ابتغاء وجهك فافرج عنا ما نحن فيه فانفرجت الصخرة غير أنهم لا يستطيعون الخروج منها; وقال الثالث: اللهم استأجرت أجراء فأعطيتهم أجرهم غير رجل واحد ترك الذي له وذهب فثمرت أجره حتى كثرت منه الأموال فجاءني بعد حين فقال: يا عبد الله أدني أجري فقلت له: كل ما ترى من أجرك من الإبل والبقر والغنم والرقيق فقال: يا عبد الله لا تستهزئ بي فقلت: إني لا أستهزئ بك فأخذه كله فاستاقه فلم يترك منه شيئا اللهم فإن كنت فعلت ذلك ابتغاء وجهك فافرج عنا ما نحن فيه فانفرجت الصخرة فخرجوا يمشون","صحيح","Sahih al-Jami al-Saghir 1504","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1505","«انظر فإنك لست بخير من أحمر ولا أسود إلا أن تفضله بتقوى»","حسن","Sahih al-Jami al-Saghir 1505","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1506","«انظرن من إخوانكن؟ فإنما الرضاعة من المجاعة»","صحيح","Sahih al-Jami al-Saghir 1506","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1507","«انظروا إلى من هو أسفل منكم ولا تنظروا إلى من هو فوقكم فهو أجدر أن لا تزدروا نعمة الله عليكم»","صحيح","Sahih al-Jami al-Saghir 1507","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1508","«انظروا قريشا فخذوا من قولهم وذروا فعلهم»","صحيح","Sahih al-Jami al-Saghir 1508","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1509","«انظري أين أنت منه؟ فإنما هو جنتك ونارك»","حسن","Sahih al-Jami al-Saghir 1509","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1510","«أنعت لك الكرسف فإنه يذهب الدم»","حسن","Sahih al-Jami al-Saghir 1510","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1511","«انفذ على رسلك حتى تنزل بساحتهم ثم ادعهم إلى الإسلام وأخبرهم بما يجب عليهم من حق الله فيه فوالله لأن يهدي الله بك رجل واحدا خير لك من أن يكون لك حمر النعم»","صحيح","Sahih al-Jami al-Saghir 1511","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1512","«أنفق يا بلال! ولا تخش من ذي العرش إقلالا»","صحيح","Sahih al-Jami al-Saghir 1512","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1513","«أنفقي ولا تحصي فيحصي الله عليك ولا توعي فيوعي الله عليك»","صحيح","Sahih al-Jami al-Saghir 1513","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1514","«انكحوا فإني مكاثر بكم»","صحيح","Sahih al-Jami al-Saghir 1514","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1515","«إن آثاركم تكتب»","صحيح","Sahih al-Jami al-Saghir 1515","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1516","«إن آدم خلق من ثلاث تربات: سوداء وبيضاء وحمراء»","حسن","Sahih al-Jami al-Saghir 1516","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1517","«إن آل بني فلان ليسوا لي بأولياء إنما وليي الله وصالحوا المؤمنين»","صحيح","Sahih al-Jami al-Saghir 1517","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1518","«إن آل جعفر قد شغلوا بشأن ميتهم فاصنعوا لهم طعاما»","حسن","Sahih al-Jami al-Saghir 1518","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1519","«إن أبخل الناس من بخل بالسلام وأعجز الناس من عجز عن الدعاء»","صحيح","Sahih al-Jami al-Saghir 1519","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1520","إن إبراهيم ابني وإنه مات في الثدي وإن له ظئرين ¤ يكملان رضاعه في الجنة","صحيح","Sahih al-Jami al-Saghir 1520","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1521","«إن إبراهيم حرم بيت الله وأمنه وإني حرمت المدينة ما بين لابتيها لا يقلع عضاهها ولا يصاد صيدها»","صحيح","Sahih al-Jami al-Saghir 1521","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1522","«إن إبراهيم حرم مكة وإني حرمت ما بين لابتيها - يريد المدينة -»","صحيح","Sahih al-Jami al-Saghir 1522","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1523","«إن إبراهيم حرم مكة ودعا لها وإني حرمت المدينة كما حرم إبراهيم مكة ودعوت لها في مدها وصاعها مثل ما دعا إبراهيم لمكة»","صحيح","Sahih al-Jami al-Saghir 1523","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1524","«إن إبراهيم لما ألقي في النار لم يكن في الأرض دابة إلا أطفأت النار عنه غير الوزغ فإنها كانت تنفخ عليه»","صحيح","Sahih al-Jami al-Saghir 1524","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1525","«إن أبر البر أن يصل الرجل أهل ود أبيه بعد أن يولي الأب»","صحيح","Sahih al-Jami al-Saghir 1525","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1526","إن إبليس يضع عرشه على الماء ثم يبعث سراياه فأدناهم منه منزلة أعظمهم فتنة يجيء أحدهم فيقول: فعلت كذا وكذا فيقول: ما صنعت شيئا، ويجيء أحدهم فيقول: ما تركته حتى فرقت بينه ¤ وبين أهله فيدنيه منه ويقول: نعم أنت!","صحيح","Sahih al-Jami al-Saghir 1526","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1527","«إن ابن آدم إن أصابه حر قال: حس وإن أصابه برد قال: حس»","صحيح","Sahih al-Jami al-Saghir 1527","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1528","«إن ابني هذا سيد ولعل الله أن يصلح به بين فئتين عظيمتين من المسلمين»","صحيح","Sahih al-Jami al-Saghir 1528","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1529","«إن ابني هذين ريحانتاي من الدنيا»","صحيح","Sahih al-Jami al-Saghir 1529","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1530","«إن أبواب الجنة تحت ظلال السيوف»","صحيح","Sahih al-Jami al-Saghir 1530","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1531","«إن أبواب الربا اثنان وسبعون حوبا أدناه كالذي يأتي أمه في الإسلام»","صحيح","Sahih al-Jami al-Saghir 1531","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1532","«إن أبواب السماء تفتح إلى زوال الشمس فلا ترتج حتى يصلى الظهر فأحب أن يصعد لي فيها خير»","صحيح","Sahih al-Jami al-Saghir 1532","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1533","«إن أتقاكم وأعلمكم بالله أنا»","صحيح","Sahih al-Jami al-Saghir 1533","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1534","«إن أحب أسمائكم عند الله: عبد الله وعبد الرحمن»","صحيح","Sahih al-Jami al-Saghir 1534","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1535","«إن أحبكم إلي وأقربكم مني في الآخرة مجالس أحاسنكم أخلاقا وإن أبغضكم إلي وأبعدكم مني في الآخرة أسوؤكم أخلاقا الثرثارون المتفيهقون المتشدقون»","صحيح","Sahih al-Jami al-Saghir 1535","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1536","«إن أحد جبل يحبنا ونحبه»","صحيح","Sahih al-Jami al-Saghir 1536","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1537","«إن أحدكم إذا قام في صلاته فإنه يناجي ربه وإن ربه بينه وبين القبلة فلا يبزقن أحدكم قبل قبلته ولكن عن يساره أو تحت قدمه»","صحيح","Sahih al-Jami al-Saghir 1537","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1538","«إن أحدكم إذا قام يصلي إنما يناجي ربه فلينظر كيف يناجيه؟»","صحيح","Sahih al-Jami al-Saghir 1538","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1539","إن أحدكم إذا قام يصلي جاء الشيطان فلبس عليه حتى لا يدري كم صلى؟ فإذا وجد ذلك أحدكم فليسجد سجدتين وهو جالس","صحيح","Sahih al-Jami al-Saghir 1539","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1540","«إن أحدكم إذا كان في الصلاة فإن الله قبل وجهه فلا يتنخمن أحد منكم قبل وجهه في الصلاة»","صحيح","Sahih al-Jami al-Saghir 1540","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1541","«إن أحدكم إذا كان في صلاته فإنه يناجي ربه فلا يبزقن بين يديه ولا عن يمينه، ولكن عن يساره وتحت قدمه»","صحيح","Sahih al-Jami al-Saghir 1541","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1542","«إن أحدكم يأتيه الشيطان فيقول: من خلقك؟ فيقول: الله فيقول: فمن خلق الله؟ فإذا وجد ذلك أحدكم فليقل: آمنت بالله ورسوله فإن ذلك يذهب عنه»","صحيح","Sahih al-Jami al-Saghir 1542","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1543","«إن أحدكم يجمع خلقه في بطن أمه أربعين يوما نطفة ثم يكون علقة مثل ذلك ثم يكون مضغة مثل ذلك ثم يبعث الله إليه ملكا ويؤمر بأربع كلمات ويقال له: اكتب عمله ورزقه وأجله وشقي أو سعيد ثم ينفخ فيه الروح فإن الرجل منكم ليعمل بعمل أهل الجنة حتى لا يكون بينه وبينها إلا ذراع فيسبق عليه الكتاب فيعمل بعمل أهل النار فيدخل النار وإن الرجل ليعمل بعمل أهل النار حتى ما يكون بينه وبينها إلا ذراع فيسبق عليه الكتاب فيعمل بعمل أهل الجنة فيدخل الجنة»","صحيح","Sahih al-Jami al-Saghir 1543","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1544","«إن أحساب أهل الدنيا: الذين يذهبون إليه هذا المال»","حسن","Sahih al-Jami al-Saghir 1544","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1545","«إن أحسن ما دخل الرجل على أهله إذا قدم من سفر أول الليل»","صحيح","Sahih al-Jami al-Saghir 1545","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1546","«إن أحسن ما غيرتم به هذا الشيب: الحناء والكتم»","صحيح","Sahih al-Jami al-Saghir 1546","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1547","«إن أحق الشروط أن توفوا به ما استحللتم به الفروج»","صحيح","Sahih al-Jami al-Saghir 1547","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1548","«إن أحق ما أخذتم عليه أجرا كتاب الله»","صحيح","Sahih al-Jami al-Saghir 1548","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1549","«إن أخاكم النجاشي قد مات فقوموا فصلوا عليه»","صحيح","Sahih al-Jami al-Saghir 1549","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1550","«إن أخاك محبوس بدينه فاقض عنه»","صحيح","Sahih al-Jami al-Saghir 1550","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1551","«إن أخوف ما أخاف على أمتي الأئمة المضلون»","صحيح","Sahih al-Jami al-Saghir 1551","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1552","«إن أخوف ما أخاف على أمتي عمل قوم لوط»","صحيح","Sahih al-Jami al-Saghir 1552","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1553","«إن أخوف ما أخاف على أمتي في آخر زمانها: النجوم وتكذيب بالقدر وحيف السلطان»","صحيح","Sahih al-Jami al-Saghir 1553","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1554","«إن أخوف ما أخاف على أمتي كل منافق عليم اللسان»","صحيح","Sahih al-Jami al-Saghir 1554","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1555","«إن أخوف ما أخاف عليكم الشرك الأصغر الرياء يقول الله يوم القيامة إذا جزي الناس بأعمالهم: اذهبوا إلى الذين كنتم تراءون في الدنيا فانظروا هل تجدون عندهم جزاء»","صحيح","Sahih al-Jami al-Saghir 1555","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1556","«إن أخوف ما أخاف عليكم بعدي كل منافق عليم اللسان»","صحيح","Sahih al-Jami al-Saghir 1556","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1557","إن أدنى أهل الجنة منزلا رجل صرف الله وجهه عن النار قبل الجنة ومثل له شجرة ذات ظل فقال: أي رب قدمني إلى هذه الشجرة فأكون في ظلها فقال الله: هل عسيت أن تسألني غيره؟ قال: لا وعزتك فقدمه الله إليها ومثل له شجرة ذات ظل وثمر فقال: أي رب قدمني إلى هذه الشجرة فأكون في ظلها وآكل من ثمرها فقال الله: هل عسيت إن أعطيتك ذلك أن تسألني غيره؟ فيقول: لا وعزتك فيقدمه الله إليها فيمثل الله له شجرة أخرى ذات ظل وثمر وماء فيقول: أي رب قدمني إلى هذه الشجرة فأكون في ظلها وآكل من ثمرها وأشرب من مائها فيقول له: هل عسيت إن فعلت أن تسألني ¤ غيره؟ فيقول: لا وعزتك لا أسألك غيره فيقدمه الله إليها فيبرز له باب الجنة فيقول: أي رب قدمني إلى باب الجنة فأكون تحت سجاف الجنة فأرى أهلها فيقدمه الله إليها فيرى الجنة وما فيها فيقول: أي رب أدخلني الجنة فيدخل الجنة فإذا دخل الجنة قال: هذا لي؟ فيقول الله له: تمن فيتمنى ويذكره الله عز وجل سل من كذا وكذا حتى إذا انقطعت به الأماني قال الله: هو لك وعشرة أمثاله ثم يدخله الله الجنة فيدخل عليه زوجتاه من الحور العين فيقولان: الحمد لله الذي أحياك لنا وأحيانا لك فيقول: ما أعطي أحد مثل ما أعطيت وأدنى أهل النار عذابا ينعل من نار بنعلين يغلي دماغه من حرارة نعليه","صحيح","Sahih al-Jami al-Saghir 1557","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1558","«إن أرواح الشهداء في جوف طير خضر لها قناديل معلقة تحت العرش تسرح من الجنة حيث شاءت ثم تأوي إلى تلك القناديل فاطلع إليهم ربهم اطلاعة فقال: هل تشتهون شيئا؟ قالوا: أي شيء نشتهي ونحن نسرح من الجنة حيث شئنا؟ فيفعل ذلك بهم ثلاث مرات فلما رأوا أنهم لم يتركوا من أن يسألوا قالوا: يا رب نريد أن ترد أرواحنا في أجسادنا حتى نرجع إلى الدنيا فنقتل في سبيلك مرة أخرى! فلما رأى أن ليس لهم حاجة تركوا»","صحيح","Sahih al-Jami al-Saghir 1558","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1559","«إن أرواح الشهداء في طير خضر تعلق من ثمار الجنة»","صحيح","Sahih al-Jami al-Saghir 1559","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1560","«إن أرواح المؤمنين في طير خضر تعلق بشجر الجنة»","صحيح","Sahih al-Jami al-Saghir 1560","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1561","إن أزواج أهل الجنة ليغنين أزواجهن بأحسن أصوات ما سمعها أحد قط [إن مما يغنين: ¤ نحن الخيرات الحسان ... أزواج قوم كرام ¤ ينظرن بقرة أعيان ¤ وإن مما يغنين به: ¤ نحن الخالدات فلا يمتنه ... نحن الآمنات فلا يخفنه ¤ نحن المقيمات فلا يظعنه]","صحيح","Sahih al-Jami al-Saghir 1561","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1562","«إن أشد الناس بلاء الأنبياء ثم الذين يلونهم ثم الذين يلونهم»","صحيح","Sahih al-Jami al-Saghir 1562","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1563","«إن أشد الناس عذابا يوم القيامة: المصورون»","صحيح","Sahih al-Jami al-Saghir 1563","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1564","«إن أشد هذه الأمة بعد نبيها حياء: عثمان»","صحيح","Sahih al-Jami al-Saghir 1564","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1565","إن أصحاب هذه الصور يعذبون يوم ¤ القيامة فيقال لهم: أحيوا ما خلقتم","صحيح","Sahih al-Jami al-Saghir 1565","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1566","«إن أطيب ما أكلتم من كسبكم وإن أولادكم من كسبكم»","صحيح","Sahih al-Jami al-Saghir 1566","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1567","«إن أعظم الذنوب عند الله رجل تزوج امرأة فلما قضى حاجته منها طلقها وذهب بمهرها ورجل استعمل رجلا فذهب بأجرته وآخر يقتل دابة عبثا»","حسن","Sahih al-Jami al-Saghir 1567","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1568","«إن أعظم المسلمين في المسلمين جرما: من سأل عن شيء لم يحرم على المسلمين فحرم عليهم من أجل مسألته»","صحيح","Sahih al-Jami al-Saghir 1568","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1569","«إن أعظم الناس عند الله فرية: لرجل هاجى رجلا فهجا القبيلة بأسرها، ورجل انتفى من أبيه وزنى أمه»","صحيح","Sahih al-Jami al-Saghir 1569","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1570","«إن أعمال العباد تعرض يوم الاثنين ويوم الخميس»","صحيح","Sahih al-Jami al-Saghir 1570","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1571","«إن أفضل عباد الله يوم القيامة: الحمادون»","صحيح","Sahih al-Jami al-Saghir 1571","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1572","إن أفضل ما تداويتم به: الحجامة والقسط ¤ البحري فلا تعذبوا صبيانكم بالغمز","صحيح","Sahih al-Jami al-Saghir 1572","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1573","«إن أقربكم مني منزلا يوم القيامة: أحاسنكم أخلاقا في الدنيا»","حسن","Sahih al-Jami al-Saghir 1573","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1574","«إن أقل ساكني الجنة: النساء»","صحيح","Sahih al-Jami al-Saghir 1574","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1575","«إن أقواما بالمدينة خلفنا ما سلكنا شعبا ولا واديا إلا وهم معنا حبسهم العذر»","صحيح","Sahih al-Jami al-Saghir 1575","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1576","«إن أقواما يخرجون من النار يحترقون فيها إلا دارات وجوههم حتى يدخلون الجنة»","صحيح","Sahih al-Jami al-Saghir 1576","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1577","«إن أكثر الناس شبعا في الدنيا أطولهم جوعا يوم القيامة»","حسن","Sahih al-Jami al-Saghir 1577","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1578","«إن أكمل المؤمنين إيمانا أحسنهم خلقا وإن حسن الخلق ليبلغ درجة الصوم والصلاة»","صحيح","Sahih al-Jami al-Saghir 1578","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1579","إن الإبل خلقت من الشياطين وإن وراء كل بعير ¤ شيطانا","حسن","Sahih al-Jami al-Saghir 1579","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1580","«إن الإسلام بدأ غريبا وسيعود غريبا كما بدأ فطوبى للغرباء»","صحيح","Sahih al-Jami al-Saghir 1580","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1581","«إن الإسلام بدأ غريبا وسيعود غريبا كما بدأ وهو يأرز بين المسجدين كما تأرز الحية في جحرها»","صحيح","Sahih al-Jami al-Saghir 1581","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1582","«إن الأشعريين إذا أرملوا في الغزو أو قل طعام عيالهم بالمدينة جعلوا ما كان عندهم في ثوب واحد ثم اقتسموه بينهم في إناء واحد بالسوية فهم مني وأنا منهم»","صحيح","Sahih al-Jami al-Saghir 1582","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1583","«إن الأعمال ترفع يوم الاثنين والخميس فأحب أن يرفع عملي وأنا صائم»","صحيح","Sahih al-Jami al-Saghir 1583","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1584","إن الأمانة نزلت في جذر قلوب الرجال ثم نزل القرآن فعلموا من القرآن وعلموا من السنة ينام الرجل النومة فتقبض الأمانة من قلبه فيظل أثرها مثل الوكت ثم ينام النومة فتقبض ¤ الأمانة من قلبه فيظل أثرها مثل المجل كجمر دحرجته على رجلك فنفط فتراه منتبرا وليس فيه شيء فيصبح الناس يتبايعون لا يكاد أحد يؤدي الأمانة حتى يقال: إن في بني فلان رجلا أمينا! حتى يقال للرجل: ما أجلده؟ ما أظرفه؟ ما أعقله؟ وما في قلبه حبة خردل من إيمان","صحيح","Sahih al-Jami al-Saghir 1584","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1585","«إن الأمير إذا ابتغى الريبة في الناس أفسدهم»","صحيح","Sahih al-Jami al-Saghir 1585","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1586","«إن الأنبياء يتباهون أيهم أكثر أصحابا من أمته فأرجو أن أكون يومئذ أكثرهم كلهم واردة وإن كل رجل منهم يومئذ قائم على حوض ملآن معه عصا يدعو من عرف من أمته ولكل أمة سيما يعرفهم بها نبيهم»","حسن","Sahih al-Jami al-Saghir 1586","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1587","«إن الأنصار قد قضوا الذي عليهم وبقي الذي عليكم فاقبلوا من محسنهم وتجاوزوا عن مسيئهم»","صحيح","Sahih al-Jami al-Saghir 1587","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1588","«إن الأوعية لا تحرم شيئا فانتبذوا فيما بدا لكم واجتنبوا كل مسكر»","صحيح","Sahih al-Jami al-Saghir 1588","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1589","إن الإيمان ليأرز إلى المدينة كما تأرز الحية إلى ¤ جحرها","صحيح","Sahih al-Jami al-Saghir 1589","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1590","«إن الإيمان ليخلق في جوف أحدكم كما يخلق الثوب فاسألوا الله تعالى: أن يجدد الإيمان في قلوبكم»","صحيح","Sahih al-Jami al-Saghir 1590","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1591","«إن البركة تنزل في وسط الطعام فكلوا من حافته ولا تأكلوا من وسطه»","صحيح","Sahih al-Jami al-Saghir 1591","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1592","«إن البلايا أسرع إلى من يحبني من السيل إلى منتهاه»","حسن","Sahih al-Jami al-Saghir 1592","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1593","«إن البيت الذي فيه الصور لا تدخله الملائكة»","صحيح","Sahih al-Jami al-Saghir 1593","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1594","«إن التجار هم الفجار»","صحيح","Sahih al-Jami al-Saghir 1594","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1595","«إن الجذعة تجزي مما تجزي منه الثنية»","صحيح","Sahih al-Jami al-Saghir 1595","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1596","«إن الجذع من الضأن يوفي مما يوفي منه الثني من المعز»","صحيح","Sahih al-Jami al-Saghir 1596","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1597","«إن الجماء لتقتص من القرناء يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1597","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1598","«إن الجنة لتشتاق إلى ثلاثة: علي وعمار وسلمان»","حسن","Sahih al-Jami al-Saghir 1598","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1599","«إن الحج والعمرة لمن سبيل الله وإن عمرة في رمضان تعدل حجة»","صحيح","Sahih al-Jami al-Saghir 1599","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1600","«إن الحسن والحسين هما ريحانتاي من الدنيا»","صحيح","Sahih al-Jami al-Saghir 1600","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1601","«إن الحمد لله وسبحان الله ولا إله إلا الله والله أكبر لتساقط من ذنوب العبد كما تساقط ورق هذه الشجرة»","حسن","Sahih al-Jami al-Saghir 1601","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1602","إن الحور العين لتغنين في الجنة يقلن: ¤ نحن الحور الحسان ... خبئنا لأزواج كرام","صحيح","Sahih al-Jami al-Saghir 1602","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1603","«إن الحياء والإيمان قرنا جميعا فإذا رفع أحدهما رفع الآخر»","صحيح","Sahih al-Jami al-Saghir 1603","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1604","«إن الخمر من العصير والزبيب والتمر والحنطة والشعير والذرة وإني أنهاكم عن كل مسكر»","حسن","Sahih al-Jami al-Saghir 1604","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1605","«إن الدال على الخير كفاعله»","صحيح","Sahih al-Jami al-Saghir 1605","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1606","«إن الدجال ممسوح العين اليسرى عليها ظفرة مكتوب بين عينيه كافر»","صحيح","Sahih al-Jami al-Saghir 1606","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1607","«إن الدجال يخرج من قبل المشرق من مدينة يقال لها: خراسان يتبعه أقوام كأن وجوههم المجان المطرقة»","صحيح","Sahih al-Jami al-Saghir 1607","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1608","«إن الدنيا حلوة خضرة فمن أصاب منها شيئا من حله فذاك الذي يبارك له فيه وكم من متخوض في مال الله ومال رسوله له النار يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1608","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1609","«إن الدنيا ملعونة ملعون ما فيها إلا ذكر الله وما والاه وعالما أو متعلما»","حسن","Sahih al-Jami al-Saghir 1609","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1610","«إن الدين النصيحة لله ولكتابه ولرسوله ولأئمة المسلمين وعامتهم»","صحيح","Sahih al-Jami al-Saghir 1610","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1611","«إن الدين يسر ولا يشاد الدين أحد إلا غلبه فسددوا وقاربوا وأبشروا واستعينوا بالغدوة والروحة وشيء من الدلجة»","صحيح","Sahih al-Jami al-Saghir 1611","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1612","«إن الرؤيا تقع على ما تعبر ومثل ذلك مثل رجل رفع رجليه فهو ينتظر متى يضعها فإذا رأى أحدكم رؤيا فلا يحدث بها إلا ناصحا أو عالما»","صحيح","Sahih al-Jami al-Saghir 1612","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1613","«إن الرجل أحق بصدر دابته وصدر فراشه وأن يؤم في رحله»","صحيح","Sahih al-Jami al-Saghir 1613","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1614","«إن الرجل إذا دخل في صلاته أقبل الله عليه بوجهه فلا ينصرف عنه حتى ينقلب أو يحدث حدث سوء»","حسن","Sahih al-Jami al-Saghir 1614","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1615","«إن الرجل إذا صلى مع الإمام حتى ينصرف كتب له قيام ليلة»","صحيح","Sahih al-Jami al-Saghir 1615","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1616","«إن الرجل إذا مات بغير مولده قيس له من مولده إلى منقطع أثره في الجنة»","حسن","Sahih al-Jami al-Saghir 1616","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1617","«إن الرجل لترفع درجته في الجنة فيقول: أنى لي هذا؟ فيقال: باستغفار ولدك لك»","صحيح","Sahih al-Jami al-Saghir 1617","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1618","«إن الرجل ليتكلم بالكلمة لا يرى بها بأسا يهوي بها سبعين خريفا في النار»","صحيح","Sahih al-Jami al-Saghir 1618","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1619","«إن الرجل ليتكلم بالكلمة من رضوان الله تعالى ما يظن أن تبلغ ما بلغت فيكتب الله له بها رضوانه إلى يوم القيامة وإن الرجل ليتكلم بالكلمة من سخط الله تعالى ما يظن أن تبلغ ما بلغت فيكتب الله عليه بها سخطه إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1619","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1620","«إن الرجل ليدرك بحسن خلقه درجات قائم الليل صائم النهار»","صحيح","Sahih al-Jami al-Saghir 1620","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1621","«إن الرجل ليدرك بحسن خلقه درجة القائم بالليل الظامئ بالهواجر»","حسن","Sahih al-Jami al-Saghir 1621","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1622","إن الرجل ليسألني الشيء فأمنعه حتى تشفعوا ¤ فتؤجروا","صحيح","Sahih al-Jami al-Saghir 1622","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1623","«إن الرجل ليعمل الزمن الطويل بعمل أهل الجنة ثم يختم له عمله بعمل أهل النار وإن الرجل ليعمل الزمن الطويل بعمل أهل النار ثم يختم له عمله بعمل أهل الجنة»","صحيح","Sahih al-Jami al-Saghir 1623","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1624","«إن الرجل ليعمل عمل الجنة فيما يبدو للناس وهو من أهل النار وإن الرجل ليعمل عمل النار فيما يبدو للناس وهو من أهل الجنة»","صحيح","Sahih al-Jami al-Saghir 1624","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1625","«إن الرجل ليكون له المنزلة عند الله فما يبلغها بعمل فلا يزال الله يبتليه بما يكره حتى يبلغه إياها»","حسن","Sahih al-Jami al-Saghir 1625","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1626","«إن الرجل لينصرف وما كتب له إلا عشر صلاته تسعها ثمنها سبعها سدسها خمسها ربعها ثلثها نصفها»","حسن","Sahih al-Jami al-Saghir 1626","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1627","«إن الرجل من أهل الجنة ليعطى قوة مائة رجل في الأكل والشرب والشهوة والجماع حاجة أحدهم عرق يفيض من جلده فإذا بطنه قد ضمر»","صحيح","Sahih al-Jami al-Saghir 1627","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1628","إن الرجل من أهل النار ليعظم للنار حتى يكون الضرس ¤ من أضراسه كأحد","صحيح","Sahih al-Jami al-Saghir 1628","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1629","«إن الرحم شجنة آخذة بحجزة الرحمن تصل من وصلها وتقطع من قطعها»","حسن","Sahih al-Jami al-Saghir 1629","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1630","«إن الرزق ليطلب العبد أكثر مما يطلبه أجله»","حسن","Sahih al-Jami al-Saghir 1630","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1631","«إن الرسالة والنبوة قد انقطعت فلا رسول بعدي ولا نبي ولكن المبشرات رؤيا الرجل المسلم وهي جزء من أجزاء النبوة»","صحيح","Sahih al-Jami al-Saghir 1631","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1632","«إن الرقى والتمائم والتولة شرك»","صحيح","Sahih al-Jami al-Saghir 1632","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1633","«إن الركن والمقام ياقوتتان من ياقوت الجنة طمس الله تعالى نورهما ولو لم يطمس نورهما لأضاءتا ما بين المشرق والمغرب»","صحيح","Sahih al-Jami al-Saghir 1633","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1634","«إن الروح إذا قبض تبعه البصر»","صحيح","Sahih al-Jami al-Saghir 1634","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1635","إن الساعة لا تقوم حتى تكون عشر آيات: الدخان والدجال والدابة وطلوع الشمس من مغربها وثلاثة خسوف: خسف ¤ بالمشرق وخسف بالمغرب وخسف بجزيرة العرب ونزول عيسى وفتح يأجوج ومأجوج ونار تخرج من قعر عدن تسوق الناس إلى المحشر تبيت معهم حيث باتوا وتقيل معهم حيث قالوا","صحيح","Sahih al-Jami al-Saghir 1635","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1636","«إن السحور بركة أعطاكموها الله فلا تدعوها»","صحيح","Sahih al-Jami al-Saghir 1636","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1637","«إن السعيد لمن جنب الفتن ولمن ابتلي فصبر»","صحيح","Sahih al-Jami al-Saghir 1637","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1638","«إن السلام اسم من أسماء الله تعالى فأفشوه بينكم»","صحيح","Sahih al-Jami al-Saghir 1638","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1639","«إن السلام اسم من أسماء الله تعالى وضع في الأرض فأفشوا السلام بينكم»","صحيح","Sahih al-Jami al-Saghir 1639","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1640","«إن السلف يجري مجرى شطر الصدقة»","صحيح","Sahih al-Jami al-Saghir 1640","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1641","«إن الشاهد يرى ما لا يرى الغائب»","صحيح","Sahih al-Jami al-Saghir 1641","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1642","إن الشمس والقمر آيتان من آيات الله لا يخسفان ¤ لموت أحد ولا لحياته فإذا رأيتم ذلك فادعوا الله وكبروا وصلوا وتصدقوا يا أمة محمد! والله ما من أحد أغير من الله أن يزني عبده أو تزني أمته يا أمة محمد! والله لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا اللهم هل بلغت","صحيح","Sahih al-Jami al-Saghir 1642","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1643","«إن الشمس والقمر ثوران عقيران في النار»","صحيح","Sahih al-Jami al-Saghir 1643","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1644","«إن الشمس والقمر لا ينكسفان لموت أحد ولا لحياته ولكنهما آيتان من آيات الله يخوف الله بهما عباده فإذا رأيتم ذلك فصلوا وادعوا حتى ينكشف ما بكم»","صحيح","Sahih al-Jami al-Saghir 1644","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1645","«إن الشهر يكون تسعة وعشرين يوما»","صحيح","Sahih al-Jami al-Saghir 1645","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1646","«إن الشيخ يملك نفسه»","حسن","Sahih al-Jami al-Saghir 1646","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1647","«إن الشيطان إذا سمع النداء بالصلاة أحال له ضراط حتى لا يسمع صوته فإذا سكت رجع فوسوس فإذا سمع الإقامة ذهب حتى لا يسمع صوته فإذا سكت رجع فوسوس»","صحيح","Sahih al-Jami al-Saghir 1647","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1648","«إن الشيطان إذا سمع النداء بالصلاة ذهب حتى يكون مكان الروحاء»","صحيح","Sahih al-Jami al-Saghir 1648","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1649","إن الشيطان عرض لي فشد علي ليقطع الصلاة علي فأمكنني الله تعالى منه فذعته ولقد هممت أن أوثقه إلى سارية حتى تصبحوا فتنظروا إليه فذكرت قول سليمان {رَبِ هَبْ لِي مُلْكاً لَا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِي} فرده الله خاسئا","صحيح","Sahih al-Jami al-Saghir 1649","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1650","«إن الشيطان قال: وعزتك يا رب لا أبرح أغوي عبادك ما دامت أرواحهم في أجسادهم فقال الرب: وعزتي وجلالي لا أزال أغفر لهم ما استغفروني»","حسن","Sahih al-Jami al-Saghir 1650","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1651","«إن الشيطان قد أيس أن يعبده المصلون ولكن في التحريش بينهم»","حسن","Sahih al-Jami al-Saghir 1651","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1652","إن الشيطان قعد لابن آدم بأطرقه فقعد له بطريق الإسلام فقال: تسلم وتذر دينك ودين آبائك وآباء آبائك؟ فعصاه فأسلم ثم قعد له بطريق الهجرة فقال: تهاجر وتدع أرضك وسماءك وإنما مثل المهاجر كمثل الفرس في الطول! فعصاه فهاجر ثم قعد ¤ له بطريق الجهاد فقال: تجاهد فهو جهد النفس والمال فتقاتل فتقتل فتنكح المرأة ويقسم المال؟ فعصاه فجاهد فمن فعل ذلك كان حقا على الله أن يدخله الجنة ومن قتل كان حقا على الله أن يدخله الجنة وإن غرق كان حقا على الله أن يدخله الجنة وإن وقصته دابته كان حقا على الله أن يدخله الجنة","صحيح","Sahih al-Jami al-Saghir 1652","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1653","«إن الشيطان ليستحل الطعام الذي لم يذكر اسم الله عليه وإنه لما جاء بهذا الأعرابي ليستحل به فأخذت بيده وجاء بهذه الجارية ليستحل بها فأخذت بيدها فوالذي نفسي بيده إن يده في يدي مع أيديهما»","صحيح","Sahih al-Jami al-Saghir 1653","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1654","«إن الشيطان ليفرق منك يا عمر»","صحيح","Sahih al-Jami al-Saghir 1654","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1655","«إن الشيطان يأتي أحدكم في صلاته فيلبس عليه حتى لا يدري كم صلى فإذا وجد ذلك أحدكم فليسجد سجدتين وهو جالس قبل أن يسلم ثم يسلم»","صحيح","Sahih al-Jami al-Saghir 1655","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1656","«إن الشيطان يأتي أحدكم فيقول: من خلق السماء؟ فيقول: الله فيقول من خلق الأرض؟ فيقول: الله فيقول: من خلق الله؟! فإذا وجد ذلك أحدكم فليقل: آمنت بالله ورسوله»","صحيح","Sahih al-Jami al-Saghir 1656","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1657","إن الشيطان يأتي أحدكم فيقول: من خلقك؟ فيقول: ¤ الله فيقول: فمن خلق الله؟ فإذا وجد أحدكم ذلك فليقل: آمنت بالله ورسله فإن ذلك يذهب عنه","صحيح","Sahih al-Jami al-Saghir 1657","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1658","«إن الشيطان يجري من ابن آدم مجرى الدم»","صحيح","Sahih al-Jami al-Saghir 1658","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1659","«إن الشيطان يحضر أحدكم عند كل شيء من شأنه حتى يحضره عند طعامه فإذا سقطت من أحدكم اللقمة فليمط ما كان بها من أذى ثم ليأكلها ولا يدعها للشيطان فإذا فرغ فليلعق أصابعه فإنه لا يدري في أي طعامه تكون البركة»","صحيح","Sahih al-Jami al-Saghir 1659","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1660","«إن الصالحين يشدد عليهم وإنه لا يصيب مؤمنا نكبة من شوكة فما فوق ذلك إلا حطت عنه بها خطيئة ورفع له بها درجة»","صحيح","Sahih al-Jami al-Saghir 1660","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1661","«إن الصبر عند الصدمة الأولى»","صحيح","Sahih al-Jami al-Saghir 1661","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1662","«إن الصخرة العظيمة لتلقى من شفير جهنم فتهوي بها سبعين عاما ما تفضي إلى قرارها»","صحيح","Sahih al-Jami al-Saghir 1662","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1663","«إن الصدقة لا تحل لنا وإن مولى القوم منهم»","صحيح","Sahih al-Jami al-Saghir 1663","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1664","«إن الصدقة لا تنبغي لآل محمد وإنما هي أوساخ الناس»","صحيح","Sahih al-Jami al-Saghir 1664","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1665","«إن الصدق ليهدي إلى البر وإن البر يهدي إلى الجنة وإن الرجل ليصدق حتى يكتب عند الله صديقا وإن الكذب يهدي إلى الفجور وإن الفجور يهدي إلى النار وإن الرجل ليكذب حتى يكتب عند الله كذابا»","صحيح","Sahih al-Jami al-Saghir 1665","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1666","«إن الصعيد الطيب طهور ما لم تجد الماء ولو إلى عشر حجج فإذا وجدت الماء فأمسه بشرتك»","صحيح","Sahih al-Jami al-Saghir 1666","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1667","«إن الصعيد الطيب وضوء المسلم وإن لم يجد الماء عشر سنين فإذا وجد الماء فليمسه بشرته فإن ذلك هو خير»","صحيح","Sahih al-Jami al-Saghir 1667","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1668","«إن الصلوات الخمس يذهبن بالذنوب كما يذهب الماء الدرن»","صحيح","Sahih al-Jami al-Saghir 1668","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1669","«إن الظلم ظلمات يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1669","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1670","إن العبد إذا أخطاء خطيئة نكتت في قلبه نكته سوداء فإن هو نزع واستغفر وتاب صقل قلبه وإن عاد زيد فيها حتى تعلو على ¤ قلبه وهو الران الذي ذكر الله تعالى {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ}","حسن","Sahih al-Jami al-Saghir 1670","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1671","«إن العبد إذا قام يصلي أتي بذنوبه كلها فوضعت على رأسه وعاتقيه فكلما ركع أو سجد تساقطت عنه»","صحيح","Sahih al-Jami al-Saghir 1671","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1672","«إن العبد إذا لعن شيئا صعدت اللعنة إلى السماء فتغلق أبواب السماء دونها ثم تهبط إلى الأرض فتغلق أبوابها دونها ثم تأخذ يمينا وشمالا فإذا لم تجد مساغا رجعت إلى الذي لعن فإن كان لذلك أهلا وإلا رجعت إلى قائلها»","حسن","Sahih al-Jami al-Saghir 1672","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1673","«إن العبد إذا مرض أوحى الله إلى ملائكته: أنا قيدت عبدي بقيد من قيودي فإن أقبضه أغفر له وإن أعافه فحينئذ يقعد لا ذنب له»","حسن","Sahih al-Jami al-Saghir 1673","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1674","«إن العبد إذا نصح لسيده وأحسن عبادة ربه كان له أجره مرتين»","صحيح","Sahih al-Jami al-Saghir 1674","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1675","إن العبد إذا وضع في قبره وتولى عنه أصحابه حتى أنه يسمع قرع نعالهم أتاه ملكان فيقعدانه فيقولان له: ما كنت تقول في هذا الرجل؟ لمحمد فأما المؤمن فيقول: أشهد أنه عبد الله ورسوله ¤ فيقال: انظر إلى مقعدك من النار قد أبدلك الله به مقعدا من الجنة فيراهما جميعا ويفسح له في قبره سبعون ذراعا ويملأ عليه خضرا إلى يوم يبعثون; وأما الكافر أو المنافق فيقال له ما كنت تقول في هذا الرجل؟ فيقول: لا أدري كنت أقول ما يقول الناس فيقال له: لا دريت ولا تليت ثم يضرب بمطراق من حديد ضربة بين أذنيه فيصيح صيحة يسمعها من يليه غير الثقلين ويضيق عليه قبره حتى تختلف أضلاعه","صحيح","Sahih al-Jami al-Saghir 1675","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1676","إن العبد المؤمن إذا كان في انقطاع من الدنيا وإقبال من الآخرة نزل إليه من السماء ملائكة بيض الوجوه كأن وجوههم الشمس معهم كفن من أكفان الجنة وحنوط من حنوط الجنة حتى يجلسوا منه مد البصر ثم يجيء ملك الموت حتى يجلس عند رأسه فيقول: أيتها النفس الطيبة اخرجي إلى مغفرة من الله ورضوان فتخرج فتسيل كما تسيل القطرة من في السقاء فيأخذها فإذا أخذها لم يدعوها في يده طرفة عين حتى يأخذوها فيجعلوها في ذلك الكفن وفي ذلك الحنوط ويخرج منها كأطيب نفحة مسك وجدت على وجه الأرض فيصعدون بها فلا يمرون على ملأ من الملائكة إلا قالوا ما هذا الروح الطيب؟ فيقولون: فلان ابن فلان بأحسن أسمائه التي كانوا يسمونه بها في الدنيا حتى ينتهوا به إلى سماء الدنيا فيستفتحون له فيفتح له فيشيعه من كل سماء مقربوها إلى السماء التي تليها حتى ينتهي إلى السماء السابعة فيقول الله عز وجل: اكتبوا كتاب عبدي في عليين ¤ وأعيدوا عبدي إلى الأرض فإني منها خلقتهم وفيها أعيدهم ومنها أخرجهم تارة أخرى; فتعاد روحه فيأتيه ملكان فيجلسانه فيقولان له: من ربك؟ فيقول: ربي الله فيقولان له: ما دينك؟ فيقول: ديني الإسلام فيقولان له: ما هذا الرجل الذي بعث فيكم؟ فيقول: هو رسول الله فيقولان له: وما علمك؟ فيقول: قرأت كتاب الله فآمنت به وصدقت فينادي مناد من السماء: أن صدق عبدي فأفرشوه من الجنة وألبسوه من الجنة وافتحوا له بابا إلى الجنة فيأتيه من روحها وطيبها ويفسح له في قبره مد بصره ويأتيه رجل حسن الوجه حسن الثياب طيب الريح فيقول: أبشر بالذي يسرك هذا يومك الذي كنت توعد فيقول له: من أنت؟ فوجهك الوجه يجيء بالخير فيقول: أنا عملك الصالح فيقول: رب أقم الساعة رب أقم الساعة؟ حتى أرجع إلى أهلي ومالي. ¤ وإن العبد الكافر إذا كان في انقطاع من الدنيا وإقبال من الآخرة نزل إليه من السماء ملائكة سود الوجوه معهم المسوح فيجلسون منه مد البصر ثم يجيء ملك الموت حتى يجلس عند رأسه فيقول: أيتها النفس الخبيثة! اخرجي إلى سخط من الله وغضب فتفرق في جسده فينتزعها كما ينتزع السفود من الصوف المبلول فيأخذها فإذا أخذها لم يدعوها في يده طرفة عين حتى يجعلوها في تلك المسوح ويخرج منها كأنتن ريح جيفة وجدت على وجه الأرض فيصعدون بها فلا يمرون بها على ملأ من الملائكة إلا قالوا ما هذا الروح الخبيث؟! فيقولون: فلان ابن فلان بأقبح أسمائه التي كان يسمى بها في الدنيا فيستفتح له فلا يفتح له ثم قرأ: {لَا تُفَتَّحُ لَهُمْ أَبْوَابُ السَّمَاءِ} فيقول الله عز وجل: اكتبوا كتابه في سجين في الأرض السفلى فتطرح روحه ¤ طرحا فتعاد روحه في جسده; ويأتيه ملكان فيجلسانه فيقولان له: من ربك؟ فيقول: هاه هاه لا أدري فيقولان له: ما دينك؟ فيقول: هاه هاه لا أدري فيقولان له: ما هذا الرجل الذي بعث فيكم؟ فيقول: هاه هاه لا أدري فينادي مناد من السماء: أن كذب عبدي فأفرشوه من النار وافتحوا له بابا إلى النار فيأتيه من حرها وسمومها ويضيق عليه قبره حتى تختلف أضلاعه ويأتيه رجل قبيح الوجه قبيح الثياب منتن الريح فيقول: أبشر بالذي يسوؤك هذا يومك الذي كنت توعد فيقول: من أنت فوجهك الوجه يجيء بالشر؟ فيقول: أنا عملك الخبيث فيقول: رب لا تقم الساعة","صحيح","Sahih al-Jami al-Saghir 1676","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1677","«إن العبد ليؤجر في نفقته كلها إلا في البناء»","صحيح","Sahih al-Jami al-Saghir 1677","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1678","«إن العبد ليتكلم بالكلمة ما يتبين فيها يزل بها في النار أبعد ما بين المشرق والمغرب»","صحيح","Sahih al-Jami al-Saghir 1678","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1679","«إن العرق يوم القيامة ليذهب في الأرض سبعين باعا وإنه ليبلغ إلى أفواه الناس أو إلى آذانهم»","صحيح","Sahih al-Jami al-Saghir 1679","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1680","«إن العلماء إذا حضروا ربهم كان معاذ بن جبل بين أيديهم رتوة بحجر»","صحيح","Sahih al-Jami al-Saghir 1680","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1681","«إن العين لتولع بالرجل بإذن الله تعالى حتى يصعد حالقا ثم يتردى منه»","صحيح","Sahih al-Jami al-Saghir 1681","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1682","«إن الغادر ينصب له لواء يوم القيامة فيقال: ألا هذه غدرة فلان بن فلان»","صحيح","Sahih al-Jami al-Saghir 1682","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1683","«إن الفخذ عورة»","صحيح","Sahih al-Jami al-Saghir 1683","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1684","«إن القبر أول منازل الآخرة فإن نجا منه فما بعده أيسر منه وإن لم ينج منه فما بعده أشد منه»","حسن","Sahih al-Jami al-Saghir 1684","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1685","«إن القلوب بين أصبعين من أصابع الله يقلبها»","صحيح","Sahih al-Jami al-Saghir 1685","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1686","«إن الكريم ابن الكريم ابن الكريم يوسف بن يعقوب بن إسحاق بن إبراهيم ولو كنت في السجن ما لبث ثم أتاني الرسول لأجبت ورحمة الله على لوط إن كان ليأوي إلى ركن شديد {قَالَ لَوْ أَنَّ لِي بِكُمْ قُوَّةً أَوْ آوِي إِلَى رُكْنٍ شَدِيدٍ} فما بعث الله بعده نبيا إلا في ذروة من قومه»","حسن","Sahih al-Jami al-Saghir 1686","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1687","إن الذي أمشاهم على أرجلهم في الدنيا قادر ¤ على أن يمشيهم على وجوههم يوم القيامة","صحيح","Sahih al-Jami al-Saghir 1687","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1688","«إن الذي أنزل الداء أنزل الشفاء»","صحيح","Sahih al-Jami al-Saghir 1688","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1689","«إن الذي حرم شربها حرم بيعها» - يعني الخمر -","صحيح","Sahih al-Jami al-Saghir 1689","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1690","«إن الذي لا يؤدي زكاة ماله يمثل إليه ماله يوم القيامة شجاعا أقرع له زبيبتان فيلزمه أو يطوقه يقول: أنا كنزك أنا كنزك»","صحيح","Sahih al-Jami al-Saghir 1690","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1691","«إن الذي يأتي امرأته في دبرها لا ينظر الله إليه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1691","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1692","«إن الذي يأكل أو يشرب في آنية الفضة والذهب إنما يجرجر في بطنه نار جهنم»","صحيح","Sahih al-Jami al-Saghir 1692","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1693","«إن الذي يجر ثيابه من الخيلاء لا ينظر الله إليه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1693","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1694","«إن الذي يكذب علي يبني له بيت في النار»","صحيح","Sahih al-Jami al-Saghir 1694","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1695","«إن الذين يصنعون هذه الصور يعذبون يوم القيامة فيقال لهم: أحيوا ما خلقتم»","صحيح","Sahih al-Jami al-Saghir 1695","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1696","«إن الذين يقطعون السدر يصبون في النار على رءوسهم صبا»","صحيح","Sahih al-Jami al-Saghir 1696","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1697","«إن الله أبى ذلك لكم ورسوله أن يجعل لكم أوساخ أيدي الناس»","صحيح","Sahih al-Jami al-Saghir 1697","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1698","«إن الله أبى علي فيمن قتل مؤمنا ثلاثا»","صحيح","Sahih al-Jami al-Saghir 1698","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1699","«إن الله احتجر التوبة على كل صاحب بدعة»","صحيح","Sahih al-Jami al-Saghir 1699","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1700","«إن الله أحدث في الصلاة أن لا تكلموا إلا بذكر الله وما ينبغي لكم وأن تقوموا لله قانتين»","صحيح","Sahih al-Jami al-Saghir 1700","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1701","إن الله أخذ الميثاق من ظهر آدم بنعمان يوم عرفة وأخرج من صلبه كل ذرية ذرأها فنثرهم بين يديه كالذر ثم ¤ كلمهم قبلا قال: {َألَسْتُ بِرَبِّكُمْ قَالُوا بَلَى}","صحيح","Sahih al-Jami al-Saghir 1701","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1702","«إن الله أخذ ذرية آدم من ظهره ثم {أَشْهَدَهُمْ عَلَى أَنْفُسِهِمْ أَلَسْتُ بِرَبِّكُمْ قَالُوا بَلَى} ثم أفاض بهم في كفيه فقال: هؤلاء في الجنة وهؤلاء في النار فأهل الجنة ميسرون لعمل أهل الجنة وأهل النار ميسرون لعمل أهل النار»","صحيح","Sahih al-Jami al-Saghir 1702","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1703","«إن الله أخرجني من النكاح ولم يخرجني من السفاح»","حسن","Sahih al-Jami al-Saghir 1703","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1704","«إن الله إذا أحب أهل بيت أدخل عليهم الرفق»","صحيح","Sahih al-Jami al-Saghir 1704","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1705","«إن الله تعالى إذا أحب عبدا دعا جبريل فقال: إني أحب فلانا فأحبه فيحبه جبريل ثم ينادي في السماء فيقول: إن الله تعالى يحب فلانا فأحبوه فيحبه أهل السماء ثم يوضع له القبول في الأرض وإذا أبغض عبدا دعا جبريل فيقول: إني أبغض فلانا فأبغضه فيبغضه جبريل ثم ينادي في أهل السماء: إن الله يبغض فلانا فأبغضوه فيبغضونه ثم يوضع له البغضاء في الأرض»","صحيح","Sahih al-Jami al-Saghir 1705","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1706","«إن الله إذا أحب قوما ابتلاهم فمن صبر فله الصبر ومن جزع فله الجزع»","صحيح","Sahih al-Jami al-Saghir 1706","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1707","«إن الله تعالى إذا أراد رحمة أمة من عباده قبض نبيها قبلها فجعله لها فرطا وسلفا بين يديها وإذا أراد هلكة أمة عذبها ونبيها حي فأهلكها وهو ينظر فأقر عينه بهلكتها حين كذبوه وعصوا أمره»","صحيح","Sahih al-Jami al-Saghir 1707","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1708","«إن الله إذا استودع شيئا حفظه»","صحيح","Sahih al-Jami al-Saghir 1708","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1709","«إن الله إذا أطعم نبيا طعمة فهي للذي يقوم من بعده»","صحيح","Sahih al-Jami al-Saghir 1709","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1710","«إن الله تعالى إذا أنزل سطواته على أهل نقمته فوافت آجال قوم صالحين فأهلكوا بهلاكهم ثم يبعثون على نياتهم وأعمالهم»","صحيح","Sahih al-Jami al-Saghir 1710","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1711","«إن الله تعالى إذا أنعم على عبد نعمة يحب أن يرى أثر النعمة عليه ويكره البؤس والتباؤس ويبغض السائل الملحف ويحب الحيي العفيف المتعفف»","صحيح","Sahih al-Jami al-Saghir 1711","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1712","«إن الله إذا أنعم على عبد نعمة يحب أن يرى أثر نعمته على عبده»","صحيح","Sahih al-Jami al-Saghir 1712","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1713","«إن الله إذا كان يوم القيامة ينزل إلى العباد ليقضي بينهم وكل أمة جاثية فأول من يدعو به رجل جمع القرآن ورجل قتل في سبيل الله ورجل كثير المال فيقول الله للقارئ: ألم أعلمك ما أنزلت على رسولي قال: بلى يا رب قال: فماذا عملت بما علمت؟ قال: كنت أقوم به آناء الليل وآناء النهار فيقول الله له: كذبت وتقول له الملائكة: كذبت ويقول الله له: بل أردت أن يقال فلان قارئ فقد قيل ذلك; ويؤتى بصاحب المال فيقول الله له: ألم أوسع عليك حتى لم أدعك تحتاج إلى أحد؟ قال: بلى يا رب قال: فماذا عملت فيما آتيتك؟ قال: كنت أصل الرحم وأتصدق فيقول الله له: كذبت وتقول الملائكة: كذبت ويقول الله: بل أردت أن يقال: فلان جواد فقد قيل ذلك; ويؤتى بالذي قتل في سبيل الله فيقول الله: في ماذا قتلت؟ فيقول: أمرت بالجهاد في سبيلك فقاتلت حتى قتلت فيقول الله له: كذبت وتقول له الملائكة: كذبت ويقول الله: بل أردت أن يقال فلان جريء فقد قيل ذلك; يا أبا هريرة أولئك الثلاثة أول خلق الله تسعر بهم النار يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1713","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1714","إن الله أذن لي أن أحدث عن ديك قد مرقت رجلاه الأرض وعنقه مثنية تحت العرش وهو يقول: سبحانك ما أعظمك! ¤ فيرد عليه: لا يعلم ذلك من حلف بي كاذبا","صحيح","Sahih al-Jami al-Saghir 1714","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1715","«إن الله أرسلني مبلغا ولم يرسلني متعنتا»","صحيح","Sahih al-Jami al-Saghir 1715","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1716","«إن الله استقبل بي الشام وولى ظهري اليمن وقال لي: يا محمد إني جعلت لك ما تجاهك غنيمة ورزقا وما خلف ظهرك مددا ولا يزال الإسلام يزيد وينقص الشرك وأهله حتى تسير المرأتان لا تخشيان إلا جورا والذي نفسي بيده لا تذهب الأيام والليالي حتى يبلغ هذا الدين مبلغ هذا النجم»","صحيح","Sahih al-Jami al-Saghir 1716","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1717","«إن الله تعالى اصطفى كنانة من ولد إسماعيل وصطفى قريشا من كنانة واصطفى من قريش بني هاشم واصطفاني من بني هاشم»","صحيح","Sahih al-Jami al-Saghir 1717","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1718","«إن الله تعالى اصطفى من الكلام أربعا: سبحان الله والحمد لله ولا إله إلا الله والله أكبر فمن قال: سبحان الله كتبت له عشرون حسنة وحطت عنه عشرون سيئة ومن قال: الله أكبر مثل ذلك ومن قال: لا إله إلا الله مثل ذلك ومن قال: الحمد لله رب العالمين من قبل نفسه كتبت له ثلاثون حسنة وحط عنه ثلاثون خطيئة»","صحيح","Sahih al-Jami al-Saghir 1718","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1719","إن الله تعالى اطلع على أهل بدر فقال: اعملوا ما ¤ شئتم فقد غفرت لكم","صحيح","Sahih al-Jami al-Saghir 1719","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1720","«إن الله أعطى كل ذي حق حقه فلا وصية لوارث والولد للفراش وللعاهر الحجر»","صحيح","Sahih al-Jami al-Saghir 1720","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1721","«إن الله أعطاكم ثلث أموالكم عند وفاتكم زيادة في أعمالكم»","حسن","Sahih al-Jami al-Saghir 1721","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1722","«إن الله افترض على العباد خمس صلوات في كل يوم وليلة»","صحيح","Sahih al-Jami al-Saghir 1722","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1723","«إن الله أمرني أن أسمي المدينة طيبة»","صحيح","Sahih al-Jami al-Saghir 1723","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1724","إن الله أمر يحيى بن زكريا بخمس كلمات أن يعمل بهن وأن يأمر بني إسرائيل أن يعملوا بهن فكأنه أبطأ بهن فأوحى الله إلى عيسى: إما أن يبلغهن أو تبلغهن فأتاه عيسى فقال له: إنك أمرت بخمس كلمات أن تعمل بهن وتأمر بني إسرائيل أن يعملوا بهن فإما أن تبلغهن وإما أن أبلغهن فقال له: يا روح الله إني أخشى إن سبقتني أن أعذب أو يخسف بي فجمع يحيى بني إسرائيل في بيت المقدس حتى امتلأ المسجد فقعد على الشرفات فحمد الله وأثنى عليه ثم قال: إن الله أمرني بخمس كلمات أن أعمل بهن وآمركم أن تعملوا بهن; وأولهن: أن تعبدوا الله ولا تشركوا به شيئا فإن مثل من أشرك بالله ¤ كمثل رجل اشترى عبدا من خالص ماله بذهب أو ورق ثم أسكنه دارا فقال: اعمل وارفع إلي فجعل العبد يعمل ويرفع إلى غير سيده فأيكم يرضى أن يكون عبده كذلك؟ وإن الله خلقكم ورزقكم فاعبدوه ولا تشركوا به شيئا. ¤ وأمركم بالصلاة وإذا قمتم إلى الصلاة فلا تلتفتوا فإن الله عز وجل يقبل بوجهه على عبده ما لم يلتفت. ¤ وأمركم بالصيام ومثل ذلك كمثل رجل معه صرة مسك في عصابة كلهم يجد ريح المسك وإن خلوف فم الصائم أطيب عند الله من ريح المسك. ¤ وأمركم بالصدقة ومثل ذلك كمثل رجل أسره العدو فشدوا يديه ¤ إلى عنقه وقدموه ليضربوا عنقه فقال لهم: هل لكم أن أفتدي نفسي منكم؟ فجعل يفتدي نفسه منهم بالقليل والكثير حتى فك نفسه، وأمركم بذكر الله كثيرا ومثل ذلك كمثل رجل طلبه العدو سراعا في أثره فأتى حصنا حصينا فأحرز نفسه فيه وإن العبد أحصن ما يكون من الشيطان إذا كان في ذكر الله تعالى. وأنا آمركم بخمس أمرني الله بهن: الجماعة والسمع والطاعة والهجرة والجهاد في سبيل الله فإنه من فارق الجماعة قيد شبر فقد خلع ربقة الإسلام من عنقه إلا أن يراجع ومن دعا بدعوة الجاهلية فهو من جثاء جهنم وإن صام وصلى وزعم أنه مسلم فادعوا بدعوة الله التي سماكم بها المسلمين المؤمنين عباد الله","صحيح","Sahih al-Jami al-Saghir 1724","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1725","«إن الله أوحى إلي: أن تواضعوا حتى لا يفخر أحد على أحد ولا يبغي أحد على أحد»","حسن","Sahih al-Jami al-Saghir 1725","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1726","«إن الله تعالى أوحى إلي: أن تواضعوا ولا يبغي بعضكم على بعض»","حسن","Sahih al-Jami al-Saghir 1726","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1727","«إن الله أوحى إلي: أنه من سلك مسلكا في طلب العلم سهلت له طريق الجنة ومن سلبت كريمتيه أثبته عليهما الجنة وفضل في علم خير من فضل في عبادة وملاك الدين الورع»","صحيح","Sahih al-Jami al-Saghir 1727","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1728","«إن الله بعثني إلى كل أحمر وأسود ونصرت بالرعب وأحل لي المغنم وجعلت لي الأرض مسجدا وطهورا وأعطيت الشفاعة للمذنبين من أمتي يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1728","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1729","«إن الله تجاوز لأمتي عما توسوس به صدورهم ما لم تعمل أو تتكلم به وما استكرهوا عليه»","صحيح","Sahih al-Jami al-Saghir 1729","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1730","«إن الله تعالى تجاوز لأمتي عما حدثت به أنفسها ما لم تتكلم به أو تعمل به»","صحيح","Sahih al-Jami al-Saghir 1730","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1731","«إن الله تعالى تجاوز لي عن أمتي الخطأ والنسيان وما استكرهوا عليه»","صحيح","Sahih al-Jami al-Saghir 1731","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1732","«إن الله تجاوز لي عن أمتي ما وسوست به صدورها ما لم تعمل أو تتكلم»","صحيح","Sahih al-Jami al-Saghir 1732","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1733","«إن الله تعالى تصدق عليكم عند وفاتكم بثلث أموالكم وجعل ذلك زيادة لكم في أعمالكم»","حسن","Sahih al-Jami al-Saghir 1733","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1734","«إن الله تطاول عليكم في جمعكم هذا فوهب مسيئكم لمحسنكم وأعطى محسنكم ما سأل ادفعوا بسم الله»","صحيح","Sahih al-Jami al-Saghir 1734","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1735","«إن الله تعالى جعل البركة في السحور والكيل»","حسن","Sahih al-Jami al-Saghir 1735","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1736","«إن الله جعل الحق على لسان عمر وقلبه»","صحيح","Sahih al-Jami al-Saghir 1736","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1737","«إن الله تعالى جعل الدنيا كلها قليلا وما بقي منها إلا القليل كالثغب شرب صفوه وبقي كدره»","حسن","Sahih al-Jami al-Saghir 1737","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1738","«إن الله تعالى جعل عذاب هذه الأمة في الدنيا القتل»","صحيح","Sahih al-Jami al-Saghir 1738","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1739","«إن الله تعالى جعل ما يخرج من بني آدم مثلا للدنيا»","حسن","Sahih al-Jami al-Saghir 1739","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1740","[إن الله جعل هذه الأهلة مواقيت فإذا رأيتموه فصوموا وإذا رأيتموه فأفطروا فإن غم عليكم فعدوا ثلاثين]","","Sahih al-Jami al-Saghir 1740","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1741","«إن الله تعالى جميل يحب الجمال»","صحيح","Sahih al-Jami al-Saghir 1741","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1742","«إن الله تعالى جميل يحب الجمال ويحب أن يرى أثر نعمته على عبده ويبغض البؤس والتباؤس»","صحيح","Sahih al-Jami al-Saghir 1742","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1743","«إن الله تعالى جميل يحب الجمال ويحب معالي الأخلاق ويكره سفسافها»","صحيح","Sahih al-Jami al-Saghir 1743","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1744","«إن الله تعالى جواد يحب الجود ويحب معالي الأخلاق ويكره سفسافها»","صحيح","Sahih al-Jami al-Saghir 1744","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1745","«إن الله حبس عن مكة الفيل وسلط عليها رسول الله والمؤمنين ألا فإنها لم تحل لأحد قبلي ولا تحل لأحد بعدي ألا وإنها حلت لي ساعة من نهار ألا وإنها ساعتي هذه حرام لا يختلى شوكها ولا يعضد شجرها ولا يلتقط ساقطتها إلا لمنشد ومن قتل له قتيل فهو بخير النظرين إما أن يعقل وإما أن يقاد أهل القتيل»","صحيح","Sahih al-Jami al-Saghir 1745","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1746","«إن الله حرم الخمر وحرم الميتة وثمنها وحرم الخنزير وثمنه»","صحيح","Sahih al-Jami al-Saghir 1746","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1747","«إن الله حرم على أمتي الخمر والميسر والمزر والكوبة والغبيراء وزادني صلاة الوتر»","صحيح","Sahih al-Jami al-Saghir 1747","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1748","«إن الله حرم عليكم الخمر والميسر والمزر والكوبة وكل مسكر حرام»","صحيح","Sahih al-Jami al-Saghir 1748","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1749","«إن الله تعالى حرم عليكم: عقوق الأمهات ووأد البنات ومنعا وهات وكره لكم: قيل وقال وكثرة السؤال وإضاعة المال»","صحيح","Sahih al-Jami al-Saghir 1749","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1750","«إن الله حرم علي الصدقة وعلى أهل بيتي»","صحيح","Sahih al-Jami al-Saghir 1750","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1751","«إن الله حرم مكة يوم خلق السموات والأرض فهي حرام بحرمة الله إلى يوم القيامة لم تحل لأحد قبلي ولا تحل لأحد بعدي ولم تحل لي قط إلا ساعة من الدهر لا ينفر صيدها ولا يعضد شوكها ولا يختلى خلاها ولا تحل لقطتها إلا لمنشد»","صحيح","Sahih al-Jami al-Saghir 1751","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1752","«إن الله حرم من الرضاعة ما حرم من الولادة»","صحيح","Sahih al-Jami al-Saghir 1752","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1753","«إن الله تعالى حرم من الرضاع ما حرم من النسب»","صحيح","Sahih al-Jami al-Saghir 1753","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1754","«إن الله تعالى حيث خلق الداء خلق الدواء فتداووا»","حسن","Sahih al-Jami al-Saghir 1754","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1755","«إن الله حين خلق الخلق كتب بيده على نفسه: إن رحمتي تغلب غضبي»","صحيح","Sahih al-Jami al-Saghir 1755","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1756","«إن الله تعالى حيي ستير يحب الحياء والستر فإذا اغتسل أحدكم فليستتر»","صحيح","Sahih al-Jami al-Saghir 1756","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1757","«إن الله تعالى حيي كريم يستحي إذا رفع الرجل إليه يديه أن يردهما صفرا خائبتين»","صحيح","Sahih al-Jami al-Saghir 1757","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1758","«إن الله خلق آدم ثم أخذ الخلق من ظهره فقال: هؤلاء في الجنة ولا أبالي وهؤلاء في النار ولا أبالي»","صحيح","Sahih al-Jami al-Saghir 1758","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1759","«إن الله تعالى خلق آدم من قبضة قبضها من جميع الأرض فجاء بنو آدم على قدر الأرض جاء منهم الأحمر والأبيض والأسود وبين ذلك والسهل والحزن والخبيث والطيب وبين ذلك»","صحيح","Sahih al-Jami al-Saghir 1759","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1760","«إن الله تعالى خلق الجنة وخلق النار فخلق لهذه أهلا ولهذه أهلا»","صحيح","Sahih al-Jami al-Saghir 1760","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1761","«إن الله تعالى خلق الخلق حتى إذا فرغ من خلقه قامت الرحم فقال: مه؟ قالت: هذا مقام العائذ بك من القطيعة قال: نعم أما ترضين أن أصل من وصلك وأقطع من قطعك؟ قالت: بلى يا رب قال: فذلك لك»","صحيح","Sahih al-Jami al-Saghir 1761","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1762","«إن الله تعالى خلق الداء والدواء فتداووا ولا تتداووا بحرام»","صحيح","Sahih al-Jami al-Saghir 1762","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1763","«إن الله تعالى خلق الرحمة يوم خلقها مائة رحمة فأمسك عنده تسعا وتسعين رحمة وأرسل في خلقه كلهم رحمة واحدة فلو يعلم الكافر بكل الذي عند الله من الرحمة لم ييأس من الجنة ولو يعلم المؤمن بالذي عند الله من العذاب لم يأمن من النار»","صحيح","Sahih al-Jami al-Saghir 1763","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1764","«إن الله تعالى خلق خلقه في ظلمة فألقى عليهم من نوره فمن أصابه من ذلك النور يومئذ اهتدى ومن أخطأه ضل»","صحيح","Sahih al-Jami al-Saghir 1764","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1765","«إن الله خلق مائة رحمة رحمة منها قسمها بين الخلائق وتسعة وتسعين إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 1765","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1766","«إن الله خلق مائة رحمة فبث بين خلقه رحمة واحدة فهم يتراحمون بها وادخر عنده لأوليائه تسعة وتسعين»","صحيح","Sahih al-Jami al-Saghir 1766","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1767","«إن الله تعالى خلق يوم خلق السموات والأرض مائة رحمة كل رحمة طباق ما بين السماء والأرض فجعل منها في الأرض رحمة فبها تعطف الوالدة على ولدها والوحش والطير بعضها على بعض وأخر تسعا وتسعين فإذا كان يوم القيامة أكملها بهذه الرحمة»","صحيح","Sahih al-Jami al-Saghir 1767","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1768","«إن الله رحيم حيي كريم يستحي من عبده أن يرفع إليه يديه ثم لا يضع فيهما خيرا»","صحيح","Sahih al-Jami al-Saghir 1768","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1769","«إن الله تعالى رضي لهذه الأمة اليسر وكره لها العسر»","صحيح","Sahih al-Jami al-Saghir 1769","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1770","«إن الله رفيق يحب الرفق ويرضاه ويعين عليه ما لا يعين على العنف فإذا ركبتم هذه الدواب العجم فنزلوها منازلها فإن أجدبت الأرض فانجوا عليها فإن الأرض تطوى بالليل ما لا تطوى بالنهار وإياكم والتعريس بالطريق فإنه طريق الدواب ومأوى الحيات»","صحيح","Sahih al-Jami al-Saghir 1770","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1771","«إن الله تعالى رفيق يحب الرفق ويعطي عليه ما لا يعطي على العنف»","صحيح","Sahih al-Jami al-Saghir 1771","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1772","«إن الله زادكم صلاة فحافظوا عليها وهي الوتر»","صحيح","Sahih al-Jami al-Saghir 1772","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1773","إن الله زوى لي الأرض فرأيت مشارقها ومغاربها وإن ملك أمتي سيبلغ ما زوي لي منها وإني أعطيت الكنزين الأحمر والأبيض وإني سألت ربي لأمتي أن لا يهلكوا بسنة عامة ولا يسلط عليهم عدوا من سوى أنفسهم فيستبيح بيضتهم وإن ربي عز وجل قال: يا محمد إني إذا قضيت قضاء فإنه لايرد وإني أعطيتك لأمتك أن لا أهلكهم بسنة عامة وأن لا أسلط عليهم عدوا من سوى أنفسهم فيستبيح بيضتهم ولو اجتمع عليهم من بين أقطارها حتى يكون بعضهم يفني بعضا وإنما أخاف على أمتي الأئمة المضلين وإذا وضع في أمتي ¤ السيف لم يرفع عنهم إلى يوم القيامة ولا تقوم الساعة حتى تلحق قبائل من أمتي بالمشركين حتى تعبد قبائل من أمتي الأوثان وإنه سيكون في أمتي كذابون ثلاثون كلهم يزعم أنه نبي وأنا خاتم النبيين لا نبي بعدي ولا تزال طائفة من أمتي على الحق ظاهرين لا يضرهم من خالفهم حتى يأتي أمر الله","صحيح","Sahih al-Jami al-Saghir 1773","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1774","«إن الله تعالى سائل كل راع عما استرعاه أحفظ ذلك أم ضيعه؟ حتى يسأل الرجل عن أهل بيته»","حسن","Sahih al-Jami al-Saghir 1774","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1775","«إن الله تعالى سمى المدينة طابة»","صحيح","Sahih al-Jami al-Saghir 1775","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1776","إن الله سيخلص رجلا من أمتي على رءوس الخلائق يوم القيامة فينشر عليه تسعة وتسعين سجلا كل سجل مثل مد البصر ثم يقول: أتنكر من هذا شيئا؟ أظلمك كتبتي الحافظون؟ فيقول: لا يا رب فيقول: أفلك عذر؟ فيقول: لا يا رب فيقول: بلى إن لك عندنا حسنة وإنه لا ظلم عليك اليوم فتخرج بطاقة فيها أشهد أن لا إله إلا الله وأشهد أن محمدا عبده ورسوله فيقول: احضر وزنك فيقول: يا رب ما هذه البطاقة مع هذه السجلات؟ فيقال: فإنك لا تظلم فتوضع السجلات في كفة والبطاقة في كفة فطاشت ¤ السجلات وثقلت البطاقة ولا يثقل مع اسم الله تعالى شيء","صحيح","Sahih al-Jami al-Saghir 1776","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1777","«إن الله تعالى صانع كل صانع وصنعته»","صحيح","Sahih al-Jami al-Saghir 1777","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1778","«إن الله ضرب الدنيا لمطعم ابن آدم مثلا وضرب مطعم ابن آدم مثلا للدنيا وإن قزحه وملحه»","حسن","Sahih al-Jami al-Saghir 1778","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1779","«إن الله تعالى عفو يحب العفو»","حسن","Sahih al-Jami al-Saghir 1779","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1780","«إن الله فضلني على الأنبياء بأربع: أرسلني إلى الناس كافة وجعل الأرض كلها لي ولأمتي طهورا ومسجدا فأينما أدرك رجل من أمتي الصلاة فعنده مسجده وعنده طهوره ونصرني بالرعب مسيرة شهر وأحل لي المغانم»","صحيح","Sahih al-Jami al-Saghir 1780","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1781","«إن الله قال: إنا أنزلنا المال لإقام الصلاة وإيتاء الزكاة ولو كان لابن آدم واد لأحب أن يكون له ثان ولو كان له واديان لأحب أن يكون لهما ثالث ولا يملأ جوف ابن آدم إلا التراب ثم يتوب الله على من تاب»","صحيح","Sahih al-Jami al-Saghir 1781","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1782","«إن الله تعالى قال: من عادى لي وليا فقد آذنته بالحرب وما تقرب إلي عبدي بشيء أحب إلى مما افترضته عليه وما يزال عبدي يتقرب إلي بالنوافل حتى أحبه فإذا أحببته كنت سمعه الذي يسمع به وبصره الذي يبصر به ويده التي يبطش بها ورجله التي يمشي بها وإن سألني لأعطينه وإن استعاذني لأعيذنه وما ترددت عن شيء أنا فاعله ترددي عن قبض نفس المؤمن يكره الموت وأنا أكره مساءته»","صحيح","Sahih al-Jami al-Saghir 1782","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1783","«إن الله تعالى قبض أرواحكم حين شاء وردها عليكم حين شاء يا بلال قم فأذن في الناس بالصلاة»","صحيح","Sahih al-Jami al-Saghir 1783","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1784","«إن الله قبض قبضة فقال: هذه إلى الجنة برحمتي وقبض قبضة فقال: هذه إلى النار ولا أبالي»","صحيح","Sahih al-Jami al-Saghir 1784","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1785","«إن الله قد اتخذني خليلا»","صحيح","Sahih al-Jami al-Saghir 1785","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1786","«إن الله تعالى قد أجار أمتي أن تجتمع على ضلالة»","حسن","Sahih al-Jami al-Saghir 1786","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1787","إن الله قد أذهب عنكم عبية الجاهلية وفخرها ¤ بالآباء مؤمن تقي وفاجر شقي أنتم بنو آدم وآدم من تراب ليدعن رجال فخرهم بأقوام إنما هم فحم من فحم جهنم أو ليكونن أهون على الله من الجعلان التي تدفع بأنفها النتن","حسن","Sahih al-Jami al-Saghir 1787","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1788","«إن الله تعالى قد أعطى كل ذي حق حقه فلا وصية لوارث»","صحيح","Sahih al-Jami al-Saghir 1788","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1789","«إن الله قد أعطى كل ذي حق حقه فلا وصية لوارث الولد للفراش وللعاهر الحجر وحسابهم على الله ومن ادعى إلى غير أبيه أو انتمى إلى غير مواليه فعليه لعنة الله التابعة إلى يوم القيامة ولا تنفق امرأة شيئا من بيت زوجها إلا بإذن زوجها قيل: ولا الطعام؟ قال: ذلك أفضل أموالنا»","صحيح","Sahih al-Jami al-Saghir 1789","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1790","«إن الله قد أمده لرؤيته فإن أغمي عليكم فأكملوا العدة»","صحيح","Sahih al-Jami al-Saghir 1790","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1791","«إن الله تعالى قد أوقع أجره على قدر نيته»","صحيح","Sahih al-Jami al-Saghir 1791","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1792","«إن الله قد جعل لجعفر جناحين مضرجين بالدم يطير بهما مع الملائكة»","صحيح","Sahih al-Jami al-Saghir 1792","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1793","«إن الله تعالى قد حرم على النار من قال لا إله إلا الله يبتغي بذلك وجه الله»","صحيح","Sahih al-Jami al-Saghir 1793","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1794","«إن الله قسم لكل وارث نصيبه من الميراث ولا تجوز لوارث وصية الولد للفراش وللعاهر الحجر ومن ادعى إلى غير أبيه أو تولى غير مواليه رغبة عنهم فعليه لعنة الله والملائكة والناس أجمعين ولا يقبل الله منه صرفا ولا عدلا»","صحيح","Sahih al-Jami al-Saghir 1794","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1795","«إن الله تعالى كتب الإحسان على كل شيء فإذا قتلتم فأحسنوا القتلة وإذا ذبحتم فأحسنوا الذبحة وليحد أحدكم شفرته وليرح ذبيحته»","صحيح","Sahih al-Jami al-Saghir 1795","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1796","«إن الله تعالى كتب الحسنات والسيئات ثم بين ذلك فمن هم بحسنة فلم يعملها كتبها الله تعالى عنده حسنة كاملة فإن هم بها فعملها كتبها الله تعالى عنده عشرة حسنات إلى سبعمائة ضعف إلى أضعاف كثيرة وإن هم بسيئة فلم يعملها كتبها الله عنده حسنة كاملة فإن هم بها فعملها كتبها الله تعالى سيئة واحدة ولا يهلك على الله إلا هالك»","صحيح","Sahih al-Jami al-Saghir 1796","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1797","«إن الله تعالى كتب على ابن آدم حظه من الزنا أدرك ذلك لا محالة فزنا العين النظر وزنا اللسان المنطق والنفس تمنى وتشتهي والفرج يصدق ذلك أو يكذبه»","صحيح","Sahih al-Jami al-Saghir 1797","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1798","«إن الله كتب عليكم السعي فاسعوا»","صحيح","Sahih al-Jami al-Saghir 1798","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1799","«إن الله تعالى كتب كتابا قبل أن يخلق السموات والأرض بألفي عام وهو عند العرش وإنه أنزل منه آيتين ختم بهما سورة البقرة ولا يقرآن في دار ثلاث ليال فيقربها الشيطان»","صحيح","Sahih al-Jami al-Saghir 1799","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1800","«إن الله كريم يحب الكرماء جواد يحب الجودة يحب معالي الأخلاق ويكره سفسافها»","صحيح","Sahih al-Jami al-Saghir 1800","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1801","«إن الله كريم يحب الكرم ويحب معالي الأخلاق ويكره سفسافها»","صحيح","Sahih al-Jami al-Saghir 1801","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1802","«إن الله لعن الخمر وعاصرها ومعتصرها وشاربها وساقيها وحاملها والحمولة إليه وبائعها ومشتريها وآكل ثمنها»","صحيح","Sahih al-Jami al-Saghir 1802","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1803","«إن الله تعالى لما خلق الخلق كتب بيده على نفسه: إن رحمتي تغلب غضبي»","صحيح","Sahih al-Jami al-Saghir 1803","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1804","«إن الله تعالى لم يأمرنا فيما رزقنا أن نكسو الحجارة واللبن والطين»","صحيح","Sahih al-Jami al-Saghir 1804","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1805","«إن الله تعالى لم يبعث نبيا ولا خليفة إلا وله بطانتان: بطانة تأمره بالمعروف وتنهاه عن المنكر وبطانة لا تألوه خبالا ومن يوق بطانة السوء فقد وقي»","صحيح","Sahih al-Jami al-Saghir 1805","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1806","«إن الله لم يبعثني معنتا ولا متعنتا ولكن بعثني معلما ميسرا»","صحيح","Sahih al-Jami al-Saghir 1806","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1807","«إن الله تعالى لم يجعل لمسخ نسلا ولا عقبا وقد كانت القردة والخنازير قبل ذلك»","صحيح","Sahih al-Jami al-Saghir 1807","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1808","«إن الله تعالى لم يضع داء إلا وضع له شفاء فعليكم بألبان البقر فإنها ترم من كل الشجر»","صحيح","Sahih al-Jami al-Saghir 1808","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1809","«إن الله تعالى لم ينزل داء إلا أنزل له دواء علمه من علمه وجهله من جهله إلا السام وهو الموت»","صحيح","Sahih al-Jami al-Saghir 1809","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1810","«إن الله تعالى لم ينزل داء إلا أنزل له شفاء إلا الهرم فعليكم بألبان البقر فإنها ترم من كل شجر»","صحيح","Sahih al-Jami al-Saghir 1810","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1811","«إن الله لن يعجزني في أمتي أن يؤخرها نصف يوم» - خمسمائة عام -","صحيح","Sahih al-Jami al-Saghir 1811","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1812","«إن الله لو شاء أن لا يعصى ما خلق إبليس»","حسن","Sahih al-Jami al-Saghir 1812","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1813","«إن الله تعالى ليؤيد الدين بالرجل الفاجر»","صحيح","Sahih al-Jami al-Saghir 1813","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1814","«إن الله تعالى ليحمي عبده المؤمن من الدنيا وهو يحبه كما تحمون مريضكم الطعام والشراب تخافون عليه»","صحيح","Sahih al-Jami al-Saghir 1814","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1815","«إن الله ليربي لأحدكم التمرة واللقمة كما يربي لأحدكم فلوه أو فصيله حتى تكون مثل أحد»","صحيح","Sahih al-Jami al-Saghir 1815","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1816","«إن الله تعالى ليرضى عن العبد أن يأكل الأكلة أو يشرب الشربة فيحمد الله عليها»","صحيح","Sahih al-Jami al-Saghir 1816","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1817","«إن الله ليزيد الكافر عذابا ببكاء أهله عليه»","صحيح","Sahih al-Jami al-Saghir 1817","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1818","«إن الله تعالى ليسأل العبد يوم القيامة حتى يسأله: ما منعك إذا رأيت المنكر أن تنكره؟ فإذا لقن الله العبد حجته قال: يا رب رجوتك وفرقت من الناس»","صحيح","Sahih al-Jami al-Saghir 1818","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1819","«إن الله تعالى ليطلع في ليلة النصف من شعبان فيغفر لجميع خلقه إلا لمشرك أو مشاحن»","حسن","Sahih al-Jami al-Saghir 1819","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1820","«إن الله ليعجب من الصلاة في الجمع»","حسن","Sahih al-Jami al-Saghir 1820","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1821","«إن الله ليعجب من العبد إذا قال: لا إله إلا أنت إني قد ظلمت نفسي فاغفر لي ذنوبي إنه لا يغفر الذنوب إلا أنت قال: عبدي عرف أن له ربا يغفر ويعاقب»","صحيح","Sahih al-Jami al-Saghir 1821","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1822","«إن الله تعالى ليملي للظالم حتى إذا أخذه لم يفلته»","صحيح","Sahih al-Jami al-Saghir 1822","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1823","«إن الله تعالى محسن فأحسنوا»","صحيح","Sahih al-Jami al-Saghir 1823","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1824","«إن الله محسن يحب الإحسان فإذا قتلتم فأحسنوا القتلة وإذا ذبحتم فأحسنوا الذبح وليحد أحدكم شفرته ثم ليرح ذبيحته»","صحيح","Sahih al-Jami al-Saghir 1824","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1825","«إن الله تعالى مع الدائن حتى يقضي دينه ما لم يكن دينه فيما يكره الله»","صحيح","Sahih al-Jami al-Saghir 1825","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1826","«إن الله مع القاضي ما لم يجر عمدا فإذا جار وكله إلى نفسه»","حسن","Sahih al-Jami al-Saghir 1826","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1827","«إن الله تعالى مع القاضي ما لم يجر فإذا جار تبرأ منه وألزمه الشيطان»","حسن","Sahih al-Jami al-Saghir 1827","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1828","«إن الله تعالى مع القاضي ما لم يحف عمدا»","حسن","Sahih al-Jami al-Saghir 1828","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1829","«إن الله تعالى وتر يحب الوتر»","صحيح","Sahih al-Jami al-Saghir 1829","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1830","«إن الله وتر يحب الوتر فإذا استجمرت فأوتر»","صحيح","Sahih al-Jami al-Saghir 1830","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1831","«إن الله تعالى وتر يحب الوتر فأوتروا يا أهل القرآن»","حسن","Sahih al-Jami al-Saghir 1831","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1832","«إن الله ورسوله حرم بيع الخمر والميتة والخنزير والأصنام»","صحيح","Sahih al-Jami al-Saghir 1832","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1833","«إن الله ورسوله ينهيانكم عن لحوم الحمر الأهلية فإنها رجس من عمل الشيطان»","صحيح","Sahih al-Jami al-Saghir 1833","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1834","«إن الله وضع الحق على لسان عمر يقول به»","صحيح","Sahih al-Jami al-Saghir 1834","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1835","«إن الله وضع عن المسافر الصوم وشطر الصلاة»","حسن","Sahih al-Jami al-Saghir 1835","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1836","«إن الله تعالى وضع عن أمتي الخطأ والنسيان وما استكرهوا عليه»","صحيح","Sahih al-Jami al-Saghir 1836","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1837","«إن الله تعالى وكل بالرحم ملكا يقول: أي رب نطفة أي رب علقة أي رب مضغة فإذا أراد الله أن يقضي خلقها قال: أي رب شقي أم سعيد؟ ذكر أو أنثى؟ فما الرزق؟ فما الأجل؟ فيكتب كذلك في بطن أمه»","صحيح","Sahih al-Jami al-Saghir 1837","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1838","«إن الله وملائكته حتى النملة في جحرها وحتى الحوت في البحر ليصلون على معلم الناس الخير»","صحيح","Sahih al-Jami al-Saghir 1838","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1839","«إن الله وملائكته يصلون على الصف الأول»","صحيح","Sahih al-Jami al-Saghir 1839","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1840","«إن الله وملائكته يصلون على الصف الأول سووا صفوفكم وحاذوا بين مناكبكم ولينوا في أيدي إخوانكم وسدوا الخلل فإن الشيطان يدخل فيما بينكم مثل الحذف»","صحيح","Sahih al-Jami al-Saghir 1840","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1841","«إن الله وملائكته يصلون على الصف المقدم والمؤذن يغفر له مد صوته ويصدقه من سمعه من رطب ويابس وله مثل أجر من صلى معه»","صحيح","Sahih al-Jami al-Saghir 1841","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1842","«إن الله وملائكته يصلون على الصفوف المقدمة»","صحيح","Sahih al-Jami al-Saghir 1842","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1843","«إن الله تعالى وملائكته يصلون على الذين يصلون الصفوف ومن سد فرجة رفعه الله بها درجة»","حسن","Sahih al-Jami al-Saghir 1843","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1844","«إن الله تعالى وملائكته يصلون على المتسحرين»","حسن","Sahih al-Jami al-Saghir 1844","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1845","«إن الله هو: الحكم وإليه الحكم»","صحيح","Sahih al-Jami al-Saghir 1845","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1846","«إن الله تعالى هو: الخالق القابض الباسط الرازق المسعر وإني لأرجو أن ألقى الله ولا يطلبني أحد بمظلمة ظلمتها إياه في دم ولا مال»","صحيح","Sahih al-Jami al-Saghir 1846","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1847","إن الله هو: السلام فإذا قعد أحدكم في الصلاة فليقل: التحيات لله والصلوات والطيبات السلام عليك أيها النبي ورحمة الله وبركاته السلام علينا وعلى عباد الله الصالحين فإنكم إذا قلتموها أصابت كل عبد لله صالح في السماء والأرض أشهد أن لا إله إلا ¤ الله وأشهد أن محمدا عبده ورسوله ثم ليتخير من المسألة ما شاء","صحيح","Sahih al-Jami al-Saghir 1847","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1848","«إن الله تعالى لا يجمع أمتي على ضلالة ويد الله على الجماعة....»","صحيح","Sahih al-Jami al-Saghir 1848","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1849","«إن الله لا يحب العقوق»","صحيح","Sahih al-Jami al-Saghir 1849","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1850","«إن الله لا يحب كل فاحش متفحش»","حسن","Sahih al-Jami al-Saghir 1850","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1851","«إن الله تعالى لا يرضى لعبده المؤمن إذا ذهب بصفيه من أهل الأرض فصبر واحتسب بثواب دون الجنة»","حسن","Sahih al-Jami al-Saghir 1851","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1852","«إن الله تعالى لا يستحي من الحق لا تأتوا النساء في أدبارهن»","صحيح","Sahih al-Jami al-Saghir 1852","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1853","إن الله تعالى لا يظلم المؤمن حسنة يعطى عليها في الدنيا ويثاب عليها في الآخرة وأما الكافر فيطعم بحسناته في الدنيا حتى إذا أفضى إلى الآخرة لم تكن له حسنة يعطى بها خيرا","صحيح","Sahih al-Jami al-Saghir 1853","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1854","«إن الله تعالى لا يقبض العلم انتزاعا ينتزعه من العباد ولكن يقبض العلم بقبض العلماء حتى إذا لم يبق عالما اتخذ الناس رءوساء جهالا فسئلوا فأفتوا بغير علم فضلوا وأضلوا»","صحيح","Sahih al-Jami al-Saghir 1854","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1855","«إن الله لا يقبل صلاة بغير طهور ولا صدقة من غلول»","صحيح","Sahih al-Jami al-Saghir 1855","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1856","«إن الله تعالى لا يقبل من العمل إلا ما كان له خالصا وابتغي به وجهه»","حسن","Sahih al-Jami al-Saghir 1856","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1857","«إن الله لا يقدس أمة لا يأخذ الضعيف حقه من القوي وهو غير متعتع»","صحيح","Sahih al-Jami al-Saghir 1857","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1858","«إن الله تعالى لا يقدس أمة لا يعطون الضعيف منهم حقه»","صحيح","Sahih al-Jami al-Saghir 1858","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1859","«إن الله لا يمل حتى تملوا»","صحيح","Sahih al-Jami al-Saghir 1859","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1860","«إن الله تعالى لا ينام ولا ينبغي له أن ينام يخفض القسط ويرفعه ويرفع إليه عمل الليل قبل عمل النهار وعمل النهار قبل عمل الليل حجابه النور لو كشفه لأحرقت سبحات وجهه ما انتهى إليه بصره من خلقه»","صحيح","Sahih al-Jami al-Saghir 1860","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1861","«إن الله لا ينزع العلم منكم بعدما أعطاكموه انتزاعا ولكن يقبض العلماء بعلمهم ويبقى جهال فيسألون فيفتون فيضلون ويضلون»","حسن","Sahih al-Jami al-Saghir 1861","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1862","«إن الله تعالى لا ينظر إلى صوركم وأموالكم ولكن إنما ينظر إلى قلوبكم وأعمالكم»","صحيح","Sahih al-Jami al-Saghir 1862","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1863","«إن الله تعالى لا ينظر إلى مسبل إزاره»","صحيح","Sahih al-Jami al-Saghir 1863","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1864","«إن الله تعالى لا ينظر إلى من يجر إزاره بطرا»","صحيح","Sahih al-Jami al-Saghir 1864","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1865","«إن الله يؤيد حسان بروح القدس ما نافح عن رسول الله»","صحيح","Sahih al-Jami al-Saghir 1865","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1866","«إن الله تعالى يؤيد هذا الدين بأقوام لا خلاق لهم»","صحيح","Sahih al-Jami al-Saghir 1866","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1867","«إن الله يباهي بأهل عرفات أهل السماء فيقول لهم: انظروا إلى عبادي هؤلاء جاءوني شعثا غبرا»","صحيح","Sahih al-Jami al-Saghir 1867","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1868","«إن الله تعالى يباهي ملائكته عشية عرفة بأهل عرفة يقول: انظروا إلى عبادي أتوني شعثا غبرا»","صحيح","Sahih al-Jami al-Saghir 1868","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1869","«إن الله تعالى يبتلي العبد فيما أعطاه فإن رضي بما قسم الله له بورك له فيه ووسعه وإن لم يرض لم يبارك له ولم يزد على ما كتب له»","صحيح","Sahih al-Jami al-Saghir 1869","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1870","«إن الله تعالى يبتلي عبده المؤمن بالسقم حتى يكفر عنه كل ذنب»","صحيح","Sahih al-Jami al-Saghir 1870","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1871","«إن الله تعالى يبسط يده بالليل ليتوب مسيء النهار ويبسط يده بالنهار ليتوب مسيء الليل حتى تطلع الشمس من مغربها»","صحيح","Sahih al-Jami al-Saghir 1871","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1872","«إن الله يبعث الأيام يوم القيامة على هيئتها ويبعث الجمعة زهراء منيرة لأهلها فيحفون بها كالعروس تهدى إلى كريمها تضيء لهم يمشون في ضوءها ألوانهم كالثلج بياضا رياحهم تسطع كالمسك يخوضون في جبال الكافور ينظر إليهم الثقلان ما يطرقون تعجبا حتى يدخلوا الجنة لا يخالطهم أحد إلا المؤذنون المحتسبون»","صحيح","Sahih al-Jami al-Saghir 1872","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1873","«إن الله تعالى يبعث ريحا من اليمن ألين من الحرير فلا تدع أحدا في قلبه مثقال حبة من إيمان إلا قبضته»","صحيح","Sahih al-Jami al-Saghir 1873","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1874","«إن الله تعالى يبعث لهذه الأمة على رأس كل مائة سنة من يجدد لها دينها»","صحيح","Sahih al-Jami al-Saghir 1874","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1875","«إن الله تعالى يبغض البليغ من الرجال الذي يتخلل بلسانه تخلل البقرة بلسانها»","صحيح","Sahih al-Jami al-Saghir 1875","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1876","«إن الله تعالى يبغض السائل الملحف»","صحيح","Sahih al-Jami al-Saghir 1876","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1877","«إن الله تعالى يبغض الفاحش المتفحش»","صحيح","Sahih al-Jami al-Saghir 1877","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1878","«إن الله يبغض كل جعظري جواظ سخاب في الأسواق جيفة بالليل حمار بالنهار عالم بالدنيا جاهل بالآخرة»","صحيح","Sahih al-Jami al-Saghir 1878","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1879","«إن الله تعالى يبغض كل عالم بالدنيا جاهل بالآخرة»","صحيح","Sahih al-Jami al-Saghir 1879","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1880","«إن الله يحب إذا عمل أحدكم عملا أن يتقنه»","حسن","Sahih al-Jami al-Saghir 1880","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1881","«إن الله تعالى يحب الرفق في الأمر كله»","صحيح","Sahih al-Jami al-Saghir 1881","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1882","«إن الله تعالى يحب العبد: التقي الغني الخفي»","صحيح","Sahih al-Jami al-Saghir 1882","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1883","«إن الله تعالى يحب العطاس ويكره التثاؤب»","صحيح","Sahih al-Jami al-Saghir 1883","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1884","«إن الله يحب العطاس ويكره التثاؤب فإذا عطس أحدكم فحمد الله كان حقا على كل مسلم سمعه أن يقول له: يرحمك الله وأما التثاؤب فإنما هو من الشيطان فإذا تثاءب أحدكم فليرده ما استطاع فإن أحدكم إذا قال: ها ضحك منه الشيطان»","صحيح","Sahih al-Jami al-Saghir 1884","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1885","«إن الله تعالى يحب أن تؤتى رخصه كما يحب أن تؤتى عزائمه»","صحيح","Sahih al-Jami al-Saghir 1885","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1886","«إن الله تعالى يحب أن تؤتى رخصه كما يكره أن تؤتى معصيته»","صحيح","Sahih al-Jami al-Saghir 1886","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1887","«إن الله تعالى يحب أن يرى أثر نعمته على عبده»","حسن","Sahih al-Jami al-Saghir 1887","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1888","«إن الله تعالى يحب سمح البيع سمح الشراء سمح القضاء»","صحيح","Sahih al-Jami al-Saghir 1888","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1889","«إن الله يحب معالي الأخلاق ويكره سفسافها»","صحيح","Sahih al-Jami al-Saghir 1889","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1890","«إن الله تعالى يحب معالي الأمور وأشرافها ويكره سفسافها»","صحيح","Sahih al-Jami al-Saghir 1890","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1891","«إن الله تعالى يحب من العامل إذا عمل أن يحسن»","حسن","Sahih al-Jami al-Saghir 1891","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1892","«إن الله يحدث من أمره ما يشاء وإن الله قد أحدث: أن لا تكلموا في الصلاة»","صحيح","Sahih al-Jami al-Saghir 1892","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1893","«إن الله يخرج أقواما من النار بعدما لا يبقى منهم فيها إلا الوجوه فيدخلهم الجنة»","صحيح","Sahih al-Jami al-Saghir 1893","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1894","إن الله تعالى يدني المؤمن فيضع عليه كنفه وستره من الناس ويقرره بذنوبه فيقول: أتعرف ذنب كذا؟ أتعرف ذنب كذا؟ ¤ فيقول: نعم أي رب حتى إذا قرره بذنوبه ورأى في نفسه أنه قد هلك قال: فإني قد سترتها عليك في الدنيا وأنا أغفرها لك اليوم ثم يعطى كتاب حسناته بيمينه; وأما الكافر والمنافق فيقول الأشهاد: هؤلاء الذين كذبوا على ربهم ألا لعنة الله على الظالمين","صحيح","Sahih al-Jami al-Saghir 1894","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1895","«إن الله تعالى يرضى لكم ثلاثا ويكره لكم ثلاثا فيرضى لكم: أن تعبدوه ولا تشركوا به شيئا وأن تعتصموا بحبل الله جميعا ولا تفرقوا وأن تناصحوا من ولاه الله أمركم ويكره لكم: قيل وقال وكثرة السؤال وإضاعة المال»","صحيح","Sahih al-Jami al-Saghir 1895","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1896","«إن الله تعالى يرفع بهذا الكتاب أقواما ويضع به آخرين»","صحيح","Sahih al-Jami al-Saghir 1896","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1897","«إن الله يزيد الكافر عذابا ببعض بكاء أهله عليه»","صحيح","Sahih al-Jami al-Saghir 1897","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1898","«إن الله يطلع على عباده في ليلة النصف من شعبان فيغفر للمؤمنين ويملي للكافرين ويدع أهل الحقد بحقدهم حتى يدعوه»","حسن","Sahih al-Jami al-Saghir 1898","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1899","«إن الله يعذب المصورين بما صوروا»","صحيح","Sahih al-Jami al-Saghir 1899","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1900","«إن الله تعالى يعذب يوم القيامة الذين يعذبون الناس في الدنيا»","صحيح","Sahih al-Jami al-Saghir 1900","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1901","«إن الله تعالى يغار وإن المؤمن يغار وغيرة الله أن يأتي المؤمن ما حرم الله عليه»","صحيح","Sahih al-Jami al-Saghir 1901","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1902","«إن الله تعالى يقبل الصدقة ويأخذها بيمينه فيربيها لأحدكم كما يربي أحدكم مهره حتى أن اللقمة لتصير مثل أحد»","صحيح","Sahih al-Jami al-Saghir 1902","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1903","«إن الله تعالى يقبل توبة العبد ما لم يغرغر»","حسن","Sahih al-Jami al-Saghir 1903","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1904","«إن الله تعالى يقول: إذا أخذت كريمتي عبدي في الدنيا لم يكن له جزاء عندي إلا الجنة»","صحيح","Sahih al-Jami al-Saghir 1904","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1905","«إن الله تعالى يقول: أنا عند ظن عبدي بي إن خيرا فخير وإن شرا فشر»","صحيح","Sahih al-Jami al-Saghir 1905","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1906","«إن الله تعالى يقول: أنا مع عبدي ما ذكرني وتحركت بي شفتاه»","صحيح","Sahih al-Jami al-Saghir 1906","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1907","«إن الله تعالى يقول: إن الصوم لي وأنا أجزي به إن للصائم فرحتين: إذا أفطر فرح وإذا لقي الله تعالى فجزاه فرح والذي نفس محمد بيده لخلوف فم الصائم أطيب عند الله من ريح المسك»","صحيح","Sahih al-Jami al-Saghir 1907","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1908","«إن الله تعالى يقول: إن العز إزاري والكبرياء ردائي فمن نازعني فيهما عذبته»","صحيح","Sahih al-Jami al-Saghir 1908","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1909","«إن الله تعالى يقول: إن عبدا أصححت له جسمه ووسعت عليه في معيشته تمضي عليه خمسة أعوام لا يفد إلي لمحروم»","صحيح","Sahih al-Jami al-Saghir 1909","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1910","«إن الله يقول: إن عبدي المؤمن عندي بمنزلة كل خير يحمدني وأنا أنزع نفسه من بين جنبيه»","صحيح","Sahih al-Jami al-Saghir 1910","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1911","«إن الله تعالى يقول لأهل الجنة: يا أهل الجنة فيقولون: لبيك ربنا وسعديك! والخير في يديك فيقول: هل رضيتم؟ فيقولون: وما لنا لا نرضى وقد أعطيتنا ما لم تعط أحدا من خلقك فيقول: ألا أعطيكم أفضل من ذلك؟ فيقولون: يا رب وأي شيء أفضل من ذلك؟ فيقول: أحل عليكم رضواني فلا أسخط عليكم بعده أبدا»","صحيح","Sahih al-Jami al-Saghir 1911","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1912","«إن الله تعالى يقول: لأهون أهل النار عذابا لو أن لك ما في الأرض من شيء كنت تفتدي به؟ قال: نعم قال: فقد سألتك ما هو أهون من هذا وأنت في صلب آدم أن لا تشرك بي شيئا فأبيت إلا الشرك!»","صحيح","Sahih al-Jami al-Saghir 1912","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1913","«إن الله يقول: يا ابن آدم اكفني أول النهار أربع ركعات أكفك بهن آخر يومك»","صحيح","Sahih al-Jami al-Saghir 1913","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1914","«إن الله تعالى يقول: يا ابن آدم تفرغ لعبادتي أملأ صدرك غنى وأسد فقرك وإن لا تفعل ملأت يديك شغلا ولم أسد فقرك»","صحيح","Sahih al-Jami al-Saghir 1914","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1915","«إن الله تعالى يقول يوم القيامة: أين المتحابون لجلالي اليوم أظلهم في ظلي يوم لا ظل إلا ظلي»","صحيح","Sahih al-Jami al-Saghir 1915","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1916","إن الله تعالى يقول يوم القيامة: يا ابن آدم مرضت فلم تعدني قال: يا رب كيف أعودك وأنت رب العالمين؟ قال: أما علمت أن عبدي فلانا مرض فلم تعده؟ أما علمت أنك لوعدته لوجدتني عنده؟ يا ابن آدم استطعمتك فلم تطعمني فقال: يا رب وكيف أطعمك وأنت رب العالمين؟ قال: أما علمت أنه استطعمك عبدي فلان فلم تطعمه أما علمت أنك لو أطعمته لوجدت ذلك عندي؟ يا ابن آدم استسقيتك فلم تسقني قال: يا رب كيف أسقيك وأنت رب العالمين؟ قال: استسقاك ¤ عبدي فلان فلم تسقه أما إنك لو سقيته لوجدت ذلك عندي","صحيح","Sahih al-Jami al-Saghir 1916","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1917","«إن الله يمهل حتى إذا ذهب من الليل نصفه أو ثلثاه قال: لا يسألن عبادي غيري من يسألني استجب له من يسألني أعطه من يستغفرني أغفر له حتى يطلع الفجر»","صحيح","Sahih al-Jami al-Saghir 1917","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1918","«إن الله تعالى يمهل حتى إذا كان ثلث الليل الآخر نزل إلى سماء الدنيا فنادى: هل من مستغفر؟ هل من تائب؟ هل من سائل؟ هل من داع؟ حتى ينفجر الفجر»","صحيح","Sahih al-Jami al-Saghir 1918","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1919","«إن الله تعالى ينزل المعونة على قدر المؤنة وينزل الصبر على قدر البلاء»","صحيح","Sahih al-Jami al-Saghir 1919","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1920","«إن الله ينشئ السحاب فينطق أحسن النطق ويضحك أحسن الضحك»","صحيح","Sahih al-Jami al-Saghir 1920","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1921","«إن الله ينهاكم أن تأتوا النساء في أدبارهن»","صحيح","Sahih al-Jami al-Saghir 1921","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1922","«إن الله ينهاكم أن تحلفوا بآبائكم»","صحيح","Sahih al-Jami al-Saghir 1922","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1923","إن الله ينهاكم أن تحلفوا بآبائكم فمن كان حالفا فليحلف بالله وإلا فليصمت","صحيح","Sahih al-Jami al-Saghir 1923","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1924","«إن الله يوصيكم بأمهاتكم ثلاثا إن الله تعالى يوصيكم بآبائكم مرتين إن الله تعالى يوصيكم بالأقرب فالأقرب»","صحيح","Sahih al-Jami al-Saghir 1924","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1925","«إن الماء طهور لا ينجسه شيء»","صحيح","Sahih al-Jami al-Saghir 1925","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1926","«إن الماء ليس عليه جنابة ولا ينجسه شيء»","صحيح","Sahih al-Jami al-Saghir 1926","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1927","«إن الماء لا يجنب»","صحيح","Sahih al-Jami al-Saghir 1927","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1928","«إن الماء لا ينجسه شيء»","صحيح","Sahih al-Jami al-Saghir 1928","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1929","«إن المؤذن يغفر له مدى صوته ويصدقه كل رطب ويابس سمع صوته والشاهد عليه خمس وعشرون درجة»","حسن","Sahih al-Jami al-Saghir 1929","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1930","إن المؤمن إذا وضع في قبره أتاه ملك فيقول له: ¤ ما كنت تعبد؟ فإن الله هداه قال: كنت أعبد الله فيقول له: ما كنت تقول في هذا الرجل؟ فيقول: هو عبد الله ورسوله فما يسأل عن شيء غيرها فينطلق به إلى بيت كان في النار فيقال له: هذا بيتك كان في النار ولكن الله عصمك ورحمك فأبدلك به بيتا في الجنة فيقول: دعوني حتى أذهب فأبشر أهلي فيقال له: اسكن; وإن الكافر إذا وضع في قبره أتاه ملك فينتهره فيقول له: ما كنت تعبد؟ فيقول: لا أدري فيقال له: لا دريت ولا تليت فيقال: فما كنت تقول في هذا الرجل؟ فيقول: كنت أقول ما تقول الناس فيضربه بمطراق من حديد بين أذنيه فيصيح صيحة يسمعها الخلق غير الثقلين","صحيح","Sahih al-Jami al-Saghir 1930","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1931","«إن المؤمن تخرج نفسه من بين جنبيه وهو يحمد الله تعالى»","صحيح","Sahih al-Jami al-Saghir 1931","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1932","«إن المؤمن ليدرك بحسن الخلق درجة القائم الصائم»","صحيح","Sahih al-Jami al-Saghir 1932","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1933","«إن المؤمن لا ينجس»","صحيح","Sahih al-Jami al-Saghir 1933","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1934","«إن المؤمن يجاهد بسيفه ولسانه»","صحيح","Sahih al-Jami al-Saghir 1934","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1935","«إن المؤمنين يشدد عليهم لأنه لا تصيب المؤمن نكبة من شوكة فما فوقها ولا وجع إلا رفع الله له بها درجة وحط عنه خطيئة»","صحيح","Sahih al-Jami al-Saghir 1935","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1936","«إن المتبايعين بالخيار في بيعهما ما لم يتفرقا أو يكون البيع خيارا»","صحيح","Sahih al-Jami al-Saghir 1936","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1937","«إن المتحابين بالله في ظل العرش»","صحيح","Sahih al-Jami al-Saghir 1937","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1938","«إن المختلعات والمنتزعات هن المنافقات»","صحيح","Sahih al-Jami al-Saghir 1938","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1939","«إن المرأة إذا أقبلت أقبلت في صورة شيطان فإذا رأى أحدكم امرأة فأعجبته فليأت أهله فإن الذي معها مثل الذي معها»","صحيح","Sahih al-Jami al-Saghir 1939","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1940","«إن المرأة تقبل في صورة شيطان وتدبر في صورة شيطان فإذا رأى أحدكم امرأة أعجبته فليأت أهله فإن ذلك يرد ما في نفسه»","صحيح","Sahih al-Jami al-Saghir 1940","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1941","«إن المرأة تنكح لدينها ومالها وجمالها فعليك بذات الدين تربت يداك»","صحيح","Sahih al-Jami al-Saghir 1941","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1942","«إن المرأة خلقت من ضلع فإن ذهبت تقومها كسرتها وإن تدعها ففيها أود وبلغة»","حسن","Sahih al-Jami al-Saghir 1942","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1943","«إن المرأة خلقت من ضلع لن تستقيم لك على طريقة فإن استمتعت بها استمتعت بها وبها عوج وإن ذهبت تقيمها كسرتها وكسرها طلاقها»","صحيح","Sahih al-Jami al-Saghir 1943","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1944","«إن المرأة خلقت من ضلع وإنك إن ترد إقامة الضلع تكسرها فدارها تعش بها»","صحيح","Sahih al-Jami al-Saghir 1944","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1945","«إن المرأة لتأخذ على القوم - يعني تجير على المسلمين -»","حسن","Sahih al-Jami al-Saghir 1945","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1946","«إن المرد إلى الله إلى جنة أو نار خلود بلا موت وإقامة بلا ظعن»","صحيح","Sahih al-Jami al-Saghir 1946","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1947","«إن المسألة كد يكد بها الرجل وجهه إلا أن يسأل الرجل سلطانا أو في أمر لا بد منه»","صحيح","Sahih al-Jami al-Saghir 1947","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1948","«إن المسلم إذا عاد أخاه المسلم لم يزل في مخرفة الجنة حتى يرجع»","صحيح","Sahih al-Jami al-Saghir 1948","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1949","«إن المسلم المسدد ليدرك درجة الصوام القوام بآيات الله بحسن خلقه وكرم ضريبته»","صحيح","Sahih al-Jami al-Saghir 1949","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1950","«إن المسلم ليؤجر في كل شيء ينفقه إلا في شيء يجعله في هذا التراب»","صحيح","Sahih al-Jami al-Saghir 1950","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1951","«إن المصلي يناجي ربه فلينظر بم يناجيه ولا يجهر بعضكم على بعض بالقرآن»","صحيح","Sahih al-Jami al-Saghir 1951","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1952","«إن المعونة تأتي من الله للعبد على قدر المؤنة وإن الصبر يأتي من الله على قدر المصيبة»","صحيح","Sahih al-Jami al-Saghir 1952","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1953","«إن المقسطين عند الله يوم القيامة على منابر من نور عن يمين الرحمن وكلتا يديه يمين الذين يعدلون في حكمهم وأهليهم وما ولوا»","صحيح","Sahih al-Jami al-Saghir 1953","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1954","«إن المكثرين هم المقلون يوم القيامة إلا من أعطاه الله تعالى خيرا فنفح فيه بيمينه وشماله وبين يديه وورائه وعمل فيه خيرا»","صحيح","Sahih al-Jami al-Saghir 1954","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1955","«إن الملائكة تنزل في العنان فتذكر الأمر قضي في السماء فتسترق الشياطين السمع فتسمعه فتوحيه إلى الكهان فيكذبون معها مائة كذبة من عند أنفسهم»","صحيح","Sahih al-Jami al-Saghir 1955","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1956","«إن الملائكة لتضع أجنحتها لطالب العلم رضا بما يطلب»","صحيح","Sahih al-Jami al-Saghir 1956","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1957","«إن الملائكة لتلعن أحدكم إذا أشار إلى أخيه بحديدة وإن كان أخاه لأبيه وأمه»","صحيح","Sahih al-Jami al-Saghir 1957","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1958","«إن الملائكة ليقومون يوم الجمعة على أبواب المسجد معهم الصحف يكتبون الناس الأول والثاني والثالث حتى إذا خرج الإمام طويت الصحف»","حسن","Sahih al-Jami al-Saghir 1958","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1959","«إن الملائكة لا تحضر الجنب ولا المضمخ بالخلوق حتى يغتسلا»","حسن","Sahih al-Jami al-Saghir 1959","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1960","«إن الملائكة لا تحضر جنازة الكافر بخير ولا المضمخ بالزعفران ولا الجنب»","حسن","Sahih al-Jami al-Saghir 1960","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1961","«إن الملائكة لا تدخل بيتا فيه تماثيل أو صورة»","صحيح","Sahih al-Jami al-Saghir 1961","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1962","«إن الملائكة لا تدخل بيتا فيه كلب»","صحيح","Sahih al-Jami al-Saghir 1962","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1963","«إن الملائكة لا تدخل بيتا فيه كلب ولا صورة»","صحيح","Sahih al-Jami al-Saghir 1963","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1964","«إن المنفق على الخيل في سبيل الله كالباسط يديه بالصدقة لا يقبضها»","حسن","Sahih al-Jami al-Saghir 1964","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1965","«إن الموتى ليعذبون في قبورهم حتى إن البهائم لتسمع أصواتهم»","صحيح","Sahih al-Jami al-Saghir 1965","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1966","«إن الموت فزع فإذا رأيتم الجنازة فقوموا»","صحيح","Sahih al-Jami al-Saghir 1966","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1967","«إن الميت إذا دفن سمع خفق نعالهم إذا ولوا عنه منصرفين»","صحيح","Sahih al-Jami al-Saghir 1967","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1968","إن الميت تحضره الملائكة فإذا كان الرجل صالحا قال: اخرجي أيتها النفس الطيبة كانت في الجسد الطيب اخرجي حميدة وأبشري بروح وريحان ورب غير غضبان فلا يزال يقال لها ذلك حتى تخرج ثم يعرج بها إلى السماء فيستفتح لها فيقال: من هذا؟ فيقول: فلان فيقال: مرحبا بالنفس الطيبة كانت في الجسد الطيب ادخلي حميدة وأبشري بروح وريحان ورب غير غضبان فلا يزال يقال لها ذلك حتى ينتهي بها إلى السماء التي فيها الله تبارك وتعالى; فإذا كان الرجل السوء قال اخرجي أيتها النفس الخبيثة كانت في الجسد الخبيث اخرجي ذميمة وأبشري بحميم وغساق ¤ وآخر من شكله أزواج فلا يزال يقال لها ذلك حتى تخرج ثم يعرج بها إلى السماء فيستفتح لها فيقال: من هذا؟ فيقال: فلان فيقال: لا مرحبا بالنفس الخبيثة كانت في الجسد الخبيث ارجعي ذميمة فإنها لا تفتح لك أبواب السماء فترسل من السماء ثم تصير إلى القبر; فيجلس الرجل الصالح في قبره غير فزع ولا مشعوف ثم يقال له: فيم كنت؟ فيقول: كنت في الإسلام فيقال له: ما هذا الرجل؟ فيقول: محمد رسول الله صلى الله عليه وسلم جاءنا بالبينات من عند الله فصدقناه فيقال له: هل رأيت الله؟ فيقول: ما ينبغي لأحد أن يرى الله فيفرج له فرجة قبل النار فينظر إليها يحطم بعضها بعضا فيقال له: انظر إلى ما وقاك الله تعالى ثم يفرج له فرجة قبل الجنة فينظر إلى زهرتها وما فيها فيقال له: هذا مقعدك ويقال له: على اليقين كنت وعليه مت وعليه تبعث إن شاء الله ; ويجلس الرجل السوء في قبره فزعا مشعوفا فيقال له: فيم كنت؟ فيقول: لا أدري فيقال له: ما هذا الرجل؟ فيقول: سمعت الناس يقولون قولا فقلته! فيفرج له فرجة قبل الجنة فينظر إلى زهرتها وما فيها فيقال له: انظر إلى ما صرف الله عنك ثم يفرج له فرجة إلى النار فينظر إليها يحطم بعضها بعضا فيقال: هذا مقعدك على الشك كنت وعليه مت وعليه تبعث إن شاء الله","صحيح","Sahih al-Jami al-Saghir 1968","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1969","«إن الميت ليعذب ببكاء الحي»","صحيح","Sahih al-Jami al-Saghir 1969","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1970","«إن الميت ليعذب ببكاء أهله عليه»","صحيح","Sahih al-Jami al-Saghir 1970","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1971","«إن الميت يبعث في ثيابه التي يموت فيها»","صحيح","Sahih al-Jami al-Saghir 1971","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1972","«إن النار أدنيت مني حتى نفخت حرها عن وجهي فرأيت فيها صاحب المحجن والذي بحر البحيرة وصاحب حمير وصاحبة الهرة»","صحيح","Sahih al-Jami al-Saghir 1972","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1973","«إن الناس إذا رأوا الظالم فلم يأخذوا على يديه أوشك أن يعمهم الله بعقاب منه»","صحيح","Sahih al-Jami al-Saghir 1973","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1974","«إن الناس إذا رأوا المنكر ولا يغيرونه أوشك أن يعمهم الله بعقابه»","صحيح","Sahih al-Jami al-Saghir 1974","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1975","«إن الناس قد صلوا ورقدوا وإنكم لن تزالوا في صلاة ما انتظرتم الصلاة»","صحيح","Sahih al-Jami al-Saghir 1975","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1976","«إن الناس قد صلوا وناموا وأنتم لم تزالوا في صلاة ما انتظرتم الصلاة ولولا ضعف الضعيف وسقم السقيم لأمرت بهذه الصلاة أن تؤخر إلى شطر الليل»","صحيح","Sahih al-Jami al-Saghir 1976","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1977","«إن الناس لم يعطوا شيئا خيرا من خلق حسن»","صحيح","Sahih al-Jami al-Saghir 1977","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1978","«إن الناس يصيرون يوم القيامة جثا كل أمة تتبع نبيها يقولون: يا فلان اشفع يا فلان اشفع حتى تنتهي الشفاعة إلى محمد صلى الله عليه وسلم فذلك يوم يبعثه الله المقام المحمود»","صحيح","Sahih al-Jami al-Saghir 1978","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1979","«إن الناس يهاجرون إليكم ولا تهاجرون إليهم والذي نفسي بيده لا يحب الأنصار رجل حتى يلقى الله إلا لقي الله وهو يحبه ولا يبغض الأنصار رجل حتى يلقى الله إلا لقي الله وهو يبغضه»","حسن","Sahih al-Jami al-Saghir 1979","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1980","«إن النذر لا يقدم شيئا ولا يؤخر وإنما يستخرج به من البخيل»","صحيح","Sahih al-Jami al-Saghir 1980","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1981","«إن النذر لا يقرب من ابن آدم شيئا لم يكن الله تعالى قدره له ولكن النذر يوافق القدر فيخرج ذلك من البخيل ما لم يكن البخيل يريد أن يخرج»","صحيح","Sahih al-Jami al-Saghir 1981","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1982","«إن النذر نذران فما كان لله فكفارته الوفاء به وما كان للشيطان فلا وفاء له وعليه كفارة يمين»","صحيح","Sahih al-Jami al-Saghir 1982","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1983","«إن النساء شقائق الرجال»","صحيح","Sahih al-Jami al-Saghir 1983","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1984","«إن النطفة تقع في الرحم أربعين ليلة ثم يتسور عليها الملك الذي يخلقها فيقول: يا رب أذكر أو أنثى؟ فيجعله الله ذكرا أو أنثى ثم يقول: يا رب أسوي أو غير سوي؟ فيجعله الله سويا أو غير سوي ثم يقول: يا رب ما رزقه؟ ما أجله؟ ما خلقه؟ ثم يجعله الله شقيا أو سعيدا»","صحيح","Sahih al-Jami al-Saghir 1984","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1985","«إن النفس المخلوقة لكائنة»","صحيح","Sahih al-Jami al-Saghir 1985","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1986","«إن النهبة ليست بأحل من الميتة»","صحيح","Sahih al-Jami al-Saghir 1986","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1987","«إن النهبة لا تحل»","صحيح","Sahih al-Jami al-Saghir 1987","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1988","«إن الوسيلة درجة عند الله ليس فوقها درجة فسلوا الله أن يؤتينيها على الخلق يوم القيامة»","حسن","Sahih al-Jami al-Saghir 1988","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1989","«إن الولد مبخلة مجبنة»","صحيح","Sahih al-Jami al-Saghir 1989","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1990","«إن الولد مبخلة مجبنة مجهلة محزنة»","صحيح","Sahih al-Jami al-Saghir 1990","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1991","«إن الهجرة لا تنقطع ما دام الجهاد»","صحيح","Sahih al-Jami al-Saghir 1991","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1992","«إن الهدى الصالح والسمت الصالح جزء من سبعين جزءا من النبوة»","حسن","Sahih al-Jami al-Saghir 1992","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1993","«إن الهدي الصالح والسمت الصالح والاقتصاد جزء من خمسة وعشرين جزءا من النبوة»","حسن","Sahih al-Jami al-Saghir 1993","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1994","«إن اليدين يسجدان كما يسجد الوجه فإذا وضع أحدكم وجهه فليضع يديه وإذا رفعه فليرفعهما»","صحيح","Sahih al-Jami al-Saghir 1994","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1995","«إن اليوم يوم عاشوراء فمن أكل فلا يأكل شيئا بقية يومه ومن لم يكن أكل أو شرب فليصم»","صحيح","Sahih al-Jami al-Saghir 1995","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1996","«إن اليهود إذا سلم عليكم أحدهم فإنما يقول: السام عليكم فقولوا: وعليكم»","صحيح","Sahih al-Jami al-Saghir 1996","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1997","«إن اليهود ليحسدونكم على السلام والتأمين»","صحيح","Sahih al-Jami al-Saghir 1997","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1998","«إن اليهود والنصارى لا يصبغون فخالفوهم»","صحيح","Sahih al-Jami al-Saghir 1998","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"1999","«إن أمامكم حوضا كما بين جرباء وأذرح فيه أباريق كنجوم السماء من ورده فشرب منه لم يظمأ بعدها أبدا»","صحيح","Sahih al-Jami al-Saghir 1999","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2000","«إن أمامكم حوضا ما بين ناحيتيه كما بين جرباء وأذرح»","صحيح","Sahih al-Jami al-Saghir 2000","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2001","«إن أمامكم عقبة كئودا لا يجوزها المثقلون»","صحيح","Sahih al-Jami al-Saghir 2001","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2002","«إن أمركن مما يهمني بعدي ولن يصبر عليكن بعدي إلا الصابرون - قاله لأزواجه -»","حسن","Sahih al-Jami al-Saghir 2002","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2003","«إن أمر هذه الأمة لا يزال مقاربا حتى يتكلموا في الولدان والقدر»","صحيح","Sahih al-Jami al-Saghir 2003","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2004","«إن أمة من بني إسرائيل مسخت دواب في الأرض وإني لا أدري أي الدواب هي؟»","صحيح","Sahih al-Jami al-Saghir 2004","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2005","«إن أمتي يدعون يوم القيامة غرا محجلين من آثار الوضوء.. ... »","صحيح","Sahih al-Jami al-Saghir 2005","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2006","«إن أم ملدم تخرج خبث ابن آدم كما يخرج الكير خبث الحديد»","صحيح","Sahih al-Jami al-Saghir 2006","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2007","«إن أمن الناس علي في ماله وصحبته أبو بكر ولو كنت متخذا خليلا لاتخذت أبا بكر خليلا ولكن أخوة الإسلام لا يبقين في المسجد خوخة إلا خوخة أبي بكر»","صحيح","Sahih al-Jami al-Saghir 2007","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2008","«إن أناسا من أمتي يأتون بعدي يود أحدهم لو اشترى رؤيتي بأهله وماله»","حسن","Sahih al-Jami al-Saghir 2008","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2009","«إن أوثق عرى الإسلام: أن تحب في الله وتبغض في الله»","حسن","Sahih al-Jami al-Saghir 2009","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2010","«إن أولئك إذا كان فيهم الرجل الصالح فمات بنوا على قبره مسجدا وصوروا فيه تلك الصورة أولئك شرار الخلق عند الله يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2010","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2011","«إن أولى الناس بالله من بدأهم بالسلام»","صحيح","Sahih al-Jami al-Saghir 2011","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2012","إن أولى الناس بي المتقون من كانوا وحيث ¤ كانوا","صحيح","Sahih al-Jami al-Saghir 2012","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2013","«إن أول الآيات خروجا طلوع الشمس من مغربها وخروج الدابة على الناس ضحى فأيتهما ما كانت قبل صاحبتها فالأخرى على أثرها قريبا»","صحيح","Sahih al-Jami al-Saghir 2013","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2014","«إن أول الناس يقضى يوم القيامة عليه رجل استشهد فأتي به فعرفه نعمه فعرفها قال: فما عملت فيها؟ قال: قاتلت فيك حتى استشهدت قال: كذبت ولكنك قاتلت ليقال جريء فقد قيل ثم أمر به فسحب على وجهه حتى ألقي في النار ورجل تعلم العلم وعلمه وقرأ القرآن فأتي به فعرفه نعمه فعرفها قال: فما عملت فيها؟ قال: تعلمت العلم وعلمته وقرأت فيك القرآن قال: كذبت ولكنك تعلمت العلم ليقال عالم وقرأت القرآن ليقال: هو قارئ فقد قيل ثم أمر به فسحب على وجهه حتى ألقي في النار ورجل وسع الله عليه وأعطاه من أصناف المال كله فأتي به فعرفه نعمه فعرفها قال: فما عملت فيها؟ قال: ما تركت من سبيل تحب أن ينفق فيها إلا أنفقت فيها لك قال: كذبت ولكنك فعلت ليقال: هو جواد فقد قيل ثم أمر به فسحب على وجهه ثم ألقي في النار»","صحيح","Sahih al-Jami al-Saghir 2014","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2015","إن أول زمرة يدخلون الجنة على صورة القمر ليلة البدر ثم الذين يلونهم على أشد كوكب دري في السماء إضاءة لا يبولون ولا يتغوطون ولا يتفلون ولا يتمخطون أمشاطهم الذهب ورشحهم المسك ومجامرهم الألوة وأزواجهم ¤ الحور العين أخلاقهم على خلق رجل واحد على صورة أبيهم آدم ستون ذراعا في السماء","صحيح","Sahih al-Jami al-Saghir 2015","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2016","«إن أول شيء خلقه الله القلم فأمره فكتب كل شيء يكون»","صحيح","Sahih al-Jami al-Saghir 2016","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2017","«إن أول ما خلق الله القلم فقال له: اكتب قال: ما أكتب؟ قال: اكتب القدر ما كان وما هو كائن إلى الأبد»","صحيح","Sahih al-Jami al-Saghir 2017","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2018","«إن أول ما خلق الله القلم فقال له: اكتب قال: يا رب وما أكتب؟ قال: اكتب مقادير كل شيء حتى تقوم الساعة من مات على غير هذا فليس مني»","صحيح","Sahih al-Jami al-Saghir 2018","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2019","«إن أول ما نبدأ به في يومنا هذا أن نصلي ثم نرجع فننحر فمن فعل ذلك فقد أصاب سنتنا ومن ذبح قبل ذلك فإنما هو لحم قدمه لأهله ليس من النسك في شيء»","صحيح","Sahih al-Jami al-Saghir 2019","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2020","«إن أول ما يحاسب به العبد يوم القيامة من عمله الصلاة فإن صلحت فقد أفلح وأنجح وإن فسدت فقد خاب وخسر وإن انتقص من فريضة قال الرب: انظروا هل لعبدي من تطوع؟ فيكمل بها ما انتقص من الفريضة ثم يكون سائر عمله على ذلك»","صحيح","Sahih al-Jami al-Saghir 2020","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2021","«إن أول ما يحكم بين العباد في الدماء»","صحيح","Sahih al-Jami al-Saghir 2021","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2022","«إن أول ما يسأل عنه العبد يوم القيامة من النعيم أن يقال له: ألم نصح لك جسمك ونرويك من الماء البارد» ؟","صحيح","Sahih al-Jami al-Saghir 2022","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2023","«إن أول منسك يومكم هذا الصلاة»","حسن","Sahih al-Jami al-Saghir 2023","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2024","«إن أول من سيب السوائب وعبد الأصنام أبو خزاعة عمرو بن عامر وإني رأيته في النار يجر أمعاءه فيها»","صحيح","Sahih al-Jami al-Saghir 2024","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2025","«إن أهل الجاهلية كانوا يقولون: إن الشمس والقمر لا ينخسفان إلا لموت عظيم من عظماء أهل الأرض وإن الشمس والقمر لا ينخسفان لموت أحد ولا لحياته ولكنهما خليقتان من خلقه يحدث الله في خلقه ما شاء فأيهما انخسف فصلوا حتى ينجلي أو يحدث الله أمرا»","صحيح","Sahih al-Jami al-Saghir 2025","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2026","«إن أهل الجنة ليتراءون أهل الغرف في الجنة كما تراءون الكواكب في السماء»","صحيح","Sahih al-Jami al-Saghir 2026","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2027","«إن أهل الجنة ليتراءون أهل الغرف من فوقهم كما تراءون الكوكب الدري الغابر في الأفق من المشرق أو المغرب لتفاضل ما بينهم»","صحيح","Sahih al-Jami al-Saghir 2027","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2028","«إن أهل الجنة ميسرون لعمل أهل الجنة وإن أهل النار ميسرون لعمل أهل النار»","صحيح","Sahih al-Jami al-Saghir 2028","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2029","«إن أهل الجنة يأكلون فيها ويشربون ولا يتفلون ولا يبولون ولا يتغوطون ولا يمتخطون ولكن طعامهم ذلك جشاء ورشح كرشح المسك يلهمون التسبيح والتحميد كما تلهمون أنتم النفس»","صحيح","Sahih al-Jami al-Saghir 2029","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2030","«إن أهل الدرجات العلى يراهم من هو أسفل منهم كما ترون الكوكب الطالع في أفق السماء وإن أبا بكر وعمر منهم وأنعما»","صحيح","Sahih al-Jami al-Saghir 2030","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2031","«إن أهل المعروف في الدنيا هم أهل المعروف في الآخرة وإن أهل المنكر في الدنيا أهل المنكر في الآخرة»","صحيح","Sahih al-Jami al-Saghir 2031","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2032","«إن أهل النار ليبكون حتى لو أجريت السفن في دموعهم جرت وإنهم ليبكون الدم»","حسن","Sahih al-Jami al-Saghir 2032","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2033","إن أهون أهل النار عذابا من له نعلان وشراكان ¤ من نار يغلي منهما دماغه كما يغلي المرجل ما يرى أن أحدا أشد منه عذابا وإنه لأهونهم عذابا","صحيح","Sahih al-Jami al-Saghir 2033","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2034","«إن أهون أهل النار عذابا يوم القيامة رجل يحذى له نعلان من نار يغلي منهما دماغه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2034","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2035","«إن أهون أهل النار عذابا يوم القيامة لرجل يوضع في أخمص قدميه جمرتان يغلي منهما دماغه كما يغلي المرجل بالقمقم»","صحيح","Sahih al-Jami al-Saghir 2035","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2036","«إن بالمدينة أقواما ما سرتم مسيرا ولا أنفقتم من نفقة ولا قطعتم واديا إلا كانوا معكم فيه وهم بالمدينة حبسهم العذر»","صحيح","Sahih al-Jami al-Saghir 2036","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2037","«إن بالمدينة جنا قد أسلموا فإذا رأيتم منهم شيئا فآذنوه ثلاثة أيام فإن بدا لكم بعد ذلك فاقتلوه فإنما هو شيطان»","صحيح","Sahih al-Jami al-Saghir 2037","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2038","«إن بحسبكم القتل»","صحيح","Sahih al-Jami al-Saghir 2038","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2039","«إن بعدي من أمتي قوما يقرءون القرآن لا يجاوز حلاقمهم يمرقون من الدين كما يمرق السهم من الرمية ثم لا يعودون إليه شر الخلق والخليقة»","صحيح","Sahih al-Jami al-Saghir 2039","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2040","«إن بلالا يؤذن بليل فكلوا واشربوا حتى يؤذن ابن أم مكتوم»","صحيح","Sahih al-Jami al-Saghir 2040","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2041","«إن بلالا يؤذن بليل ليوقظ نائمكم وليرجع قائمكم»","صحيح","Sahih al-Jami al-Saghir 2041","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2042","«إن بني إسرائيل افترقت على إحدى وسبعين فرقة وإن أمتي ستفترق على اثنتين وسبعين فرقة كلها في النار إلا واحدة وهي: الجماعة»","صحيح","Sahih al-Jami al-Saghir 2042","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2043","«إن بني إسرائيل كان إذا أصاب أحدهم البول قرضه بالمقراض» فإذا أراد أحدكم أن يبول فليرتد بوله","صحيح","Sahih al-Jami al-Saghir 2043","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2044","«إن بني إسرائيل كتبوا كتابا فاتبعوه وتركوا التوراة»","حسن","Sahih al-Jami al-Saghir 2044","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2045","«إن بني إسرائيل لما هلكوا قصوا»","صحيح","Sahih al-Jami al-Saghir 2045","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2046","«إن بني هشام بن المغيرة استأذنوني في أن ينكحوا ابنتهم علي بن أبي طالب فلا آذن ثم لا آذن ثم لا آذن إلا أن يريد ابن أبي طالب أن يطلق ابنتي وينكح ابنتهم فإنما هي بضعة مني يريبني ما أرابها ويؤذيني ما آذاها»","صحيح","Sahih al-Jami al-Saghir 2046","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2047","«إن بين يدي الساعة الهرج: القتل ما هو قتل الكفار ولكن قتل الأمة بعضها بعضا حتى أن الرجل يلقاه أخوه فيقتله ينتزع عقول أهل ذلك الزمان ويخلف لها هباء من الناس يحسب أكثرهم أنهم على شيء وليسوا على شيء»","صحيح","Sahih al-Jami al-Saghir 2047","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2048","«إن بين يدي الساعة ثلاثين دجالا كذابا»","صحيح","Sahih al-Jami al-Saghir 2048","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2049","«إن بين يدي الساعة فتنا كقطع الليل المظلم يصبح الرجل فيها مؤمنا ويمسي كافرا ويمسي مؤمنا ويصبح كافرا القاعد فيها خير من القائم والقائم فيها خير من الماشي والماشي فيها خير من الساعي فكسروا قسيكم وقطعوا أوتاركم واضربوا سيوفكم بالحجارة فإن دخل على أحد منكم بيته فليكن كخير ابني آدم»","صحيح","Sahih al-Jami al-Saghir 2049","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2050","«إن بين يدي الساعة كذابين فاحذروهم»","صحيح","Sahih al-Jami al-Saghir 2050","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2051","«إن بين يدي الساعة لأياما ينزل فيها الجهل ويرفع فيها العلم ويكثر فيها الهرج والهرج: القتل»","صحيح","Sahih al-Jami al-Saghir 2051","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2052","إن ثلاثة نفر في بني إسرائيل: أبرص وأقرع وأعمى بدا لله أن يبتليهم فبعث إليهم ملكا فأتى الأبرص فقال: أي شيء أحب إليك؟ قال: لون حسن وجلد حسن قد قذرني الناس فمسحه فذهب وأعطي لونا حسنا وجلدا حسنا فقال: أي المال أحب إليك؟ قال: الإبل فأعطي ناقة عشراء فقال: يبارك لك فيها; وأتى الأقرع فقال: أي شيء أحب إليك؟ قال: شعر حسن ويذهب هذا عني قد قذرني الناس فمسحه فذهب وأعطي شعرا حسنا قال: فأي المال أحب إليك؟ قال: البقر فأعطاه بقرة حاملا وقال: يبارك لك فيها; وأتى الأعمى فقال: أي شيء أحب إليك؟ قال: يرد الله إلي بصري فأبصر به الناس فمسحه فرد الله إليه بصره قال: فأي المال أحب إليك؟ قال: الغنم فأعطاه شاة والدا فأنتج هذان وولد هذا فكان لهذا واد من إبل ولهذا واد من بقر ولهذا واد من غنم; ثم إنه أتى الأبرص في صورته وهيئته فقال: رجل مسكين تقطعت به الحبال في سفره فلا بلاغ اليوم إلا بالله ثم بك أسألك بالذي أعطاك ¤ اللون الحسن والجلد الحسن والمال بعيرا أتبلغ عليه في سفري فقال له: إن الحقوق كثيرة فقال له: كأني أعرفك ألم تكن أبرص يقذرك الناس فقيرا فأعطاك الله؟ فقال: لقد ورثت لكابر عن كابر فقال: إن كنت كاذبا فصيرك الله إلى ما كنت; وأتى الأقرع في صورته وهيئته فقال له مثل ما قال لهذا ورد عليه مثل ما رد عليه هذا قال إن كنت كاذبا فصيرك الله إلى ما كنت; وأتى الأعمى في صورته وهيئته فقال: رجل مسكين وابن سبيل وتقطعت بي الحبال في سفري فلا بلاغ اليوم إلا بالله ثم بك أسألك بالذي رد عليك بصرك شاة أتبلغ بها في سفري؟ فقال: قد كنت أعمى فرد الله بصري وفقيرا فخذ ما شئت فوالله لا أحمدك اليوم لشيء أخذته لله فقال: أمسك مالك فإنما ابتليتم فقد رضي الله عنك وسخط على صاحبيك","صحيح","Sahih al-Jami al-Saghir 2052","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2053","«إن جبريل أتاني حين رأيت فناداني فأخفاه منك فأجبته فأخفيته منك ولم يكن يدخل عليك وقد وضعت ثيابك وظننت أن قد رقدت فكرهت أن أوقظك وخشيت أن تستوحشي فقال: إن ربك يأمرك أن تأتي أهل البقيع فتستغفر لهم»","صحيح","Sahih al-Jami al-Saghir 2053","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2054","«إن جبريل كان يعارضني القرآن كل سنة مرة وإنه عارضني العام مرتين ولا أراه إلا حضر أجلي وإنك أول أهل بيتي لحاقا بي فاتقي الله واصبري فإنه نعم السلف أنا لك»","صحيح","Sahih al-Jami al-Saghir 2054","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2055","«إن جبريل لما ركض زمزم بعقبه جعلت أم إسماعيل تجمع البطحاء رحم الله هاجر لو تركتها كانت عينا معينا»","صحيح","Sahih al-Jami al-Saghir 2055","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2056","«إن حسن العهد من الإيمان»","حسن","Sahih al-Jami al-Saghir 2056","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2057","«إن حقا على الله تعالى أن لا يرفع شيئا من أمر الدنيا إلا وضعه»","صحيح","Sahih al-Jami al-Saghir 2057","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2058","«إن حوضي أبعد من أيلة من عدن لهو أشد بياضا من الثلج وأحلى من العسل باللبن ولآنيته أكثر من عدد النجوم وإني لأصد الناس عنه كما يصد الرجل إبل الناس عن حوضه قالوا: أتعرفنا يومئذ؟ قال: نعم لكم سيما ليست لأحد من الأمم تردون علي غرا محجلين من أثر الوضوء»","صحيح","Sahih al-Jami al-Saghir 2058","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2059","«إن حوضي لأبعد من أيلة إلى عدن والذي نفسي بيده لآنيته أكثر من عدد نجوم السماء ولهو أشد بياضا من اللبن وأحلى من العسل والذي نفسي بيده إني لأذود عنه كما يذود الرجل الإبل الغريبة عن حوضه قالوا: يا رسول الله أوتعرفنا؟ قال: نعم تردون علي الحوض غرا محجلين من آثار الوضوء ليست لأحد غيركم»","صحيح","Sahih al-Jami al-Saghir 2059","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2060","إن حوضي من عدن إلى عمان البلقاء ماؤه أشد بياضا من اللبن وأحلى من العسل أكاويبه عدد النجوم من شرب منه شربة لم يظمأ بعدها أبدا أول الناس ورودا عليه فقراء المهاجرين: الشعث رؤوسا الدنس ثيابا الذين لا ينكحون المنعمات ولا تفتح لهم ¤ السدد الذين يعطون الحق الذي عليهم ولا يعطون الذي لهم","صحيح","Sahih al-Jami al-Saghir 2060","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2061","«إن حيضتك ليست في يدك»","صحيح","Sahih al-Jami al-Saghir 2061","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2062","«إن خيار عباد الله الموفون المطيبون»","صحيح","Sahih al-Jami al-Saghir 2062","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2063","«إن خياركم أحسنكم قضاء»","صحيح","Sahih al-Jami al-Saghir 2063","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2064","«إن خير التابعين رجل يقال له: أويس وله والدة هو بها بر لو أقسم على الله لأبره وكان به بياض فمروه فليستغفر لكم»","صحيح","Sahih al-Jami al-Saghir 2064","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2065","«إن خير طيب الرجال ما ظهر ريحه وخفي لونه وخير طيب النساء ما ظهر لونه وخفي ريحه»","صحيح","Sahih al-Jami al-Saghir 2065","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2066","«إن خير ما تحتجمون فيه يوم سبع عشرة وتسع عشرة ويوم إحدى وعشرين»","صحيح","Sahih al-Jami al-Saghir 2066","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2067","«إن داود النبي كان لا يأكل إلا من عمل يده»","صحيح","Sahih al-Jami al-Saghir 2067","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2068","إن دماءكم وأموالكم عليكم حرام كحرمة يومكم هذا في شهركم هذا في بلدكم هذا ألا إن كل شيء من أمر الجاهلية ¤ تحت قدمي موضوع ودماء الجاهلية موضوعة وأول دم أضعه من دمائنا دم ربيعة بن الحارث بن عبد المطلب وربا الجاهلية موضوع وأول ربا أضع من ربانا ربا العباس بن عبد المطلب فإنه موضوع كله فاتقوا الله في النساء فإنكم أخذتموهن بأمانة الله واستحللتم فروجهن بكلمة الله وإن لكم عليهن أن لا يوطئن فرشكم أحدا تكرهونه فإن فعلن ذلك فاضربوهن ضربا غير مبرح ولهن عليكم رزقهن وكسوتهن بالمعروف وإني قد تركت فيكم ما لن تضلوا بعده إن اعتصمتم به كتاب الله وأنتم مسؤلون عني فما أنتم قائلون؟ قالوا: نشهد أنك قد بلغت وأديت ونصحت فقال: اللهم اشهد","صحيح","Sahih al-Jami al-Saghir 2068","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2069","«إن ربك ليعجب من عبده إذا قال: رب اغفر لي ذنوبي وهو يعلم أنه لا يغفر الذنوب غيري»","صحيح","Sahih al-Jami al-Saghir 2069","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2070","«إن ربكم حيي كريم يستحي أن يبسط العبد يديه إليه فيردهما صفرا»","حسن","Sahih al-Jami al-Saghir 2070","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2071","«إن ربي أرسل إلي: أن اقرأ القرآن على حرف فرددت إليه: أن هون على أمتي فأرسل إلي: أن اقرأه على حرفين فرددت إليه: أن هون على أمتي فأرسل إلي: أن اقرأه على سبعة أحرف ولك بكل ردة مسألة تسألنيها قلت: اللهم اغفر لأمتي اللهم اغفر لأمتي وأخرت الثالثة ليوم يرغب إلي فيه الخلق حتى إبراهيم»","صحيح","Sahih al-Jami al-Saghir 2071","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2072","«إن رجالا من العرب يهدي أحدهم الهدية فأعوضه منها بقدر ما عندي ثم يتسخطه فيظل يتسخط فيه علي وايم الله لا أقبل بعد مقامي هذا من رجل من العرب هدية إلا من قرشي أو أنصاري أو ثقفي أو دوسي»","حسن","Sahih al-Jami al-Saghir 2072","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2073","«إن رجالا يتخوضون في مال الله بغير حق فلهم النار يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2073","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2074","«إن رجلا حضره الموت فلما أيس من الحياة أوصى أهله إذا أنا مت فاجمعوا لي حطبا كثيرا جزلا ثم أوقدوا فيه نارا حتى إذا أكلت لحمي وخلصت إلى عظمي فامتحشت فخذوها فاطحنوها ثم انظروا يوما راحا فاذروها في اليم ففعلوا ما أمرهم فجمعه الله وقال له: لم فعلت ذلك؟ قال: من خشيتك فغفر له»","صحيح","Sahih al-Jami al-Saghir 2074","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2075","«إن رجلا قال: والله لا يغفر الله لفلان قال الله: من ذا الذي يتألى علي أن لا أغفر لفلان؟! فإني قد غفرت لفلان وأحبطت عملك»","صحيح","Sahih al-Jami al-Saghir 2075","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2076","إن رجلا قتل تسعة وتسعين نفسا ثم عرضت له التوبة فسأل عن أعلم أهل الأرض؟ فدل على راهب فأتاه فقال: إنه قتل تسعة وتسعين نفسا فهل له من توبة؟ فقال: لا فقتله فكمل ¤ به مائة ثم سأل عن أعلم أهل الأرض؟ فدل على رجل عالم فقال: إنه قتل مائة نفس فهل له من توبة؟ قال: نعم ومن يحول بينه وبين التوبة؟ انطلق إلى أرض كذا وكذا فإن بها أناسا يعبدون الله فاعبد الله معهم ولا ترجع إلى أرضك فإنها أرض سوء فانطلق حتى إذا نصف الطريق أتاه الموت فاختصمت فيه ملائكة الرحمة وملائكة العذاب فقالت ملائكة الرحمة: جاء تائبا مقبلا بقلبه إلى الله تعالى وقالت ملائكة العذاب: إنه لم يعمل خيرا قط فأتاهم ملك في صورة آدمي فجعلوه بينهم فقال: قيسوا بين الأرضين فإلى أيتهما كان أدنى فهو لها فقاسوا فوجدوه أدنى إلى الأرض التي أراد فقبضته ملائكة الرحمة","صحيح","Sahih al-Jami al-Saghir 2076","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2077","«إن رجلا كان قبلكم رغسه الله مالا فقال لبنيه لما حضر: أي أب كنت لكم؟ قالوا: خير أب قال: إني لم أعمل خيرا قط فإذا مت فأحرقوني ثم اسحقوني ثم ذروني في يوم عاصف ففعلوا فجمعه الله فقال: ما حملك؟ قال: مخافتك فتلقاه برحمته»","صحيح","Sahih al-Jami al-Saghir 2077","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2078","إن رجلا لم يعمل خيرا قط وكان يداين الناس فيقول لرسوله: خذ ما تيسر واترك ما عسر وتجاوز لعل الله أن يتجاوز عنا فلما هلك قال الله: هل عملت خيرا قط؟ قال: لا إلا أنه كان لي غلام كنت أداين الناس فإذا بعثته يتقاضى قلت له: خذ ما تيسر واترك ما عسر وتجاوز لعل الله أن يتجاوز عنا قال الله: قد ¤ تجاوزت عنك","صحيح","Sahih al-Jami al-Saghir 2078","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2079","«إن رجلا ممن كان قبلكم أتاه ملك الموت ليقبض نفسه فقال له: هل عملت من خير؟ قال: ما أعلم قال له: انظر قال: ما أعلم شيئا غير أني كنت أبايع الناس وأحارفهم فأنظر المعسر وأتجاوز عن الموسر فأدخله الله الجنة»","صحيح","Sahih al-Jami al-Saghir 2079","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2080","«إن رجلا من أهل الجنة استأذن ربه في الزرع فقال له: ألست فيما شئت؟ قال: بلى ولكن أحب أن أزرع! فبذر فبادر الطرف نباته واستواؤه واستحصاده فكان أمثال الجبال فيقول الله: دونك يا ابن آدم! فإنه لا يشبعك شيء»","صحيح","Sahih al-Jami al-Saghir 2080","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2081","إن رجلا من بني إسرائيل سأل بعض بني إسرائيل أن يسلفه ألف دينار فقال: ائتني بالشهداء أشهدهم فقال: كفى بالله شهيدا قال: فأتني بالكفيل قال: كفى بالله وكيلا قال: صدقت فدفعها إليه إلى أجل مسمى فخرج في البحر فقضى حاجته ثم التمس مركبا يركبها يقدم عليه للأجل الذي أجله فلم يجد مركبا فأخذ خشبة فنقرها فأدخل فيها ألف دينار وصحيفة منه إلى صاحبه ثم زج موضعها ثم أتى بها إلى البحر فقال: اللهم إنك تعلم أني تسلفت فلانا ألف دينار فسألني كفيلا فقلت: كفى بالله وكيلا فرضي بك وسألني شهيدا فقلت: كفى بالله شهيدا فرضي بك وإني جهدت أن أجد مركبا أبعث إليه الذي له فلم أجد وإني أستودعكها فرمى بها إلى البحر حتى ولجت فيه ثم انصرف وهو في ذلك يلتمس مركبا يخرج ¤ إلى بلده فخرج الرجل الذي كان أسلفه ينظر لعل مركبا قد جاء بماله فإذا بالخشبة التي فيها المال فأخذها لأهله حطبا فلما نشرها وجد المال والصحيفة ثم قدم الذي كان أسلفه فأتى بالألف دينار وقال: والله ما زلت جاهدا في طلب مركب لآتيك بمالك فما وجدت مركبا قبل الذي أتيت فيه قال: هل كنت بعثت إلي شيئا؟ قال: أخبرك أني لم أجد مركبا قبل الذي جئت فيه قال: فإن الله قد أدى عنك الذي بعثت في الخشبة فانصرف بالألف دينار راشدا","صحيح","Sahih al-Jami al-Saghir 2081","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2082","«إن رجلا ممن كان قبلكم خرجت به قرحة فلما آذته انتزع سهما من كنانته فنكأها فلم يرقأ الدم حتى مات فقال الله: عبدي بادرني بنفسه حرمت عليه الجنة»","صحيح","Sahih al-Jami al-Saghir 2082","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2083","«إن رجلا يأتيكم من اليمن يقال له: أويس لا يدع باليمن غير أم له قد كان به بياض فدعا الله فأذهبه عنه إلا مثل موضع الدرهم فمن لقيه منكم فمروه فليستغفر لكم»","صحيح","Sahih al-Jami al-Saghir 2083","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2084","«إن روح القدس معك ما هاجيتهم»","صحيح","Sahih al-Jami al-Saghir 2084","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2085","إن روح القدس نفث في روعي أن نفسا لن تموت حتى تستكمل أجلها وتستوعب رزقها فاتقوا الله وأجملوا في الطلب ولا يحملن أحدكم استبطاء الرزق أن يطلبه بمعصية الله فإن الله ¤ تعالى لا ينال ما عنده إلا بطاعته","صحيح","Sahih al-Jami al-Saghir 2085","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2086","«إن روح القدس لا يزال يؤيدك ما نافحت عن الله ورسوله» - قاله لحسان -","صحيح","Sahih al-Jami al-Saghir 2086","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2087","«إن زاهرا باديتنا ونحن حاضروه»","صحيح","Sahih al-Jami al-Saghir 2087","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2088","«إن ساقي القوم آخرهم شربا»","صحيح","Sahih al-Jami al-Saghir 2088","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2089","«إن سبحان الله والحمد لله ولا إله إلا الله والله أكبر تنفض الخطايا كما تنفض الشجرة ورقها»","حسن","Sahih al-Jami al-Saghir 2089","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2090","«إن سليمان بن داود لما بنى بيت المقدس سأل الله عز وجل خلالا ثلاثة: سأل الله حكما يصادف حكمه فأوتيه وسأل الله ملكا لا ينبغي لأحد من بعده فأوتيه وسأل الله حين فرغ من بناء المسجد أن لا يأتيه أحد لا ينهزه إلا الصلاة فيه أن يخرجه من خطيئته كيوم ولدته أمه أما اثنتان فقد أعطيهما وأرجوا أن يكون قد أعطي الثالثة»","صحيح","Sahih al-Jami al-Saghir 2090","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2091","إن سورة من القرآن ثلاثون آية شفعت لرجل حتى غفر ¤ له وهي: {تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ}","حسن","Sahih al-Jami al-Saghir 2091","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2092","«إن سورة من كتاب الله ما هي إلا ثلاثون آية شفعت لرجل فأخرجته من النار وأدخلته الجنة»","حسن","Sahih al-Jami al-Saghir 2092","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2093","«إن سياحة أمتي الجهاد في سبيل الله»","صحيح","Sahih al-Jami al-Saghir 2093","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2094","«إن شر الرعاء الحطمة»","صحيح","Sahih al-Jami al-Saghir 2094","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2095","«إن شر الناس منزلة عند الله يوم القيامة من تركه الناس اتقاء فحشه»","صحيح","Sahih al-Jami al-Saghir 2095","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2096","«إن شهداء أمتي إذن لقليل القتل في سبيل الله شهادة والمطعون شهادة والمرأة تموت بجمع شهادة والغرق والحرق والمجنوب شهادة»","صحيح","Sahih al-Jami al-Saghir 2096","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2097","«إن صاحب الشمال ليرفع القلم ست ساعات عن العبد المسلم المخطئ فإن ندم واستغفر الله منها ألقاها وإلا كتبت واحدة»","حسن","Sahih al-Jami al-Saghir 2097","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2098","«إن صلاة الرجل في الجماعة تزيد على صلاته وحده بخمس وعشرين جزءا»","صحيح","Sahih al-Jami al-Saghir 2098","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2099","«إن طعام الواحد يكفي الاثنين وإن طعام الاثنين يكفي الثلاثة والأربعة وإن طعام الأربعة يكفي الخمسة والستة»","صحيح","Sahih al-Jami al-Saghir 2099","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2100","«إن طول صلاة الرجل وقصر خطبته مئنة من فقهه فأطيلوا الصلاة وأقصروا الخطبة وإن من البيان لسحرا»","صحيح","Sahih al-Jami al-Saghir 2100","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2101","«إن عاشوراء يوم من أيام الله فمن شاء صامه ومن شاء تركه»","صحيح","Sahih al-Jami al-Saghir 2101","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2102","«إن عامة عذاب القبر من البول فتنزهوا منه»","صحيح","Sahih al-Jami al-Saghir 2102","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2103","«إن عبدا أصاب ذنبا فقال: رب أذنبت فاغفره فقال ربه: أعلم عبدي أن له ربا يغفر الذنب ويأخذ به؟ غفرت لعبدي ثم مكث ما شاء الله ثم أصاب ذنبا فقال: ربي أذنبت آخر فاغفر لي قال: أعلم عبدي أن له ربا يغفر الذنب ويأخذ به؟ غفرت لعبدي ثم أصاب ذنبا فقال: رب أذنبت آخر فاغفر لي قال: أعلم عبدي أن له ربا يغفر الذنب ويأخذ به؟ قد غفرت لعبدي فليعمل ما شاء»","صحيح","Sahih al-Jami al-Saghir 2103","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2104","«إن عبد الله بن قيس أعطي مزمارا من مزامير آل داود»","صحيح","Sahih al-Jami al-Saghir 2104","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2105","«إن عبد الله رجل صالح لو كان يكثر الصلاة من الليل»","صحيح","Sahih al-Jami al-Saghir 2105","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2106","«إن عثمان حيي ستير تستحي منه الملائكة»","صحيح","Sahih al-Jami al-Saghir 2106","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2107","«إن عثمان رجل حيي وإني خشيت إن أذنت له وأنا على تلك الحال أن لا يبلغ إلي في حاجته»","صحيح","Sahih al-Jami al-Saghir 2107","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2108","إن عدو الله إبليس جاء بشهاب من نار ليجعله ¤ في وجهي فقلت: أعوذ بالله منك ثلاث مرات ثم قلت: ألعنك بلعنة الله التامة فلم يستأخر ثلاث مرات ثم أردت أن آخذه والله لولا دعوة أخينا سليمان لأصبح موثقا يلعب به ولدان أهل المدينة","صحيح","Sahih al-Jami al-Saghir 2108","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2109","«إن عذاب هذه الأمة جعل في دنياها»","صحيح","Sahih al-Jami al-Saghir 2109","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2110","«إن عظم الجزاء مع عظم البلاء وإن الله تعالى إذا أحب قوما ابتلاهم فمن رضي فله الرضا ومن سخط فله السخط»","حسن","Sahih al-Jami al-Saghir 2110","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2111","«إن عفريتا من الجن تفلت علي البارحة ليقطع على الصلاة فأمكنني الله منه فذعته وأردت أن أربطه إلى سارية من سواري المسجد حتى تصبحوا وتنظروا إليه كلكم فذكرت قول أخي سليمان {رَبِّ اغْفِرْ لِي وَهَبْ لِي مُلْكاً لا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِي} فرده الله خاسئا»","صحيح","Sahih al-Jami al-Saghir 2111","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2112","«إن علما لا ينتفع به ككنز لا ينفق منه في سبيل الله»","حسن","Sahih al-Jami al-Saghir 2112","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2113","«إن عم الرجل صنو أبيه»","صحيح","Sahih al-Jami al-Saghir 2113","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2114","إن غلظ جلد الكافر اثنان وأربعون ذراعا بذراع ¤ الجبار وإن ضرسه مثل أحد وإن مجلسه من جهنم ما بين مكة والمدينة","صحيح","Sahih al-Jami al-Saghir 2114","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2115","«إن فاطمة بضعة مني وأنا أتخوف أن تفتن في دينها وإني لست أحرم حلالا ولا أحل حراما ولكن والله لا تجتمع بنت رسول الله وبنت عدو الله تحت رجل واحد أبدا»","صحيح","Sahih al-Jami al-Saghir 2115","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2116","«إن فسطاط المسلمين يوم الملحمة بالغوطة إلى جانب مدينة يقال لها دمشق من خير مدائن الشام»","صحيح","Sahih al-Jami al-Saghir 2116","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2117","«إن فضل عائشة على النساء كفضل الثريد على سائر الطعام»","صحيح","Sahih al-Jami al-Saghir 2117","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2118","«إن فقراء المهاجرين يسبقون الأغنياء يوم القيامة إلى الجنة بأربعين خريفا»","صحيح","Sahih al-Jami al-Saghir 2118","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2119","«إن فلانا أهدى إلي ناقة فعوضته منها ست بكرات فظل ساخطا لقد هممت أن لا أقبل هدية إلا من قرشي أو أنصاري أو ثقفي أو دوسي»","صحيح","Sahih al-Jami al-Saghir 2119","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2120","«إن في الجمعة لساعة لا يوافقها عبد مسلم وهو قائم يصلي يسأل الله فيها خيرا إلا أعطاه الله إياه»","صحيح","Sahih al-Jami al-Saghir 2120","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2121","«إن في الجنة بابا يقال له: الريان يدخل منه الصائمون يوم القيامة لا يدخل منه أحد غيرهم يقال: أين الصائمون؟ فيقومون فيدخلون منه فإذا دخلوا أغلق فلم يدخل منه أحد»","صحيح","Sahih al-Jami al-Saghir 2121","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2122","«إن في الجنة بحر الماء وبحر العسل وبحر اللبن وبحر الخمر ثم تشقق الأنهار بعد»","صحيح","Sahih al-Jami al-Saghir 2122","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2123","«إن في الجنة غرفا يرى ظاهرها من باطنها وباطنها من ظاهرها أعدها الله تعالى لمن أطعم الطعام وألان الكلام وتابع الصيام وصلى بالليل والناس نيام»","حسن","Sahih al-Jami al-Saghir 2123","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2124","«إن في الجنة لسوقا يأتونها كل جمعة فيها كثبان المسك فتهب ريح الشمال فتحثوا في وجوههم وثيابهم فيزدادون حسنا وجمالا فيرجعون إلى أهليهم وقد ازدادوا حسنا وجمالا فيقول لهم أهلوهم: والله لقد ازددتم بعدنا حسنا وجمالا فيقولون: وأنتم والله لقد ازددتم بعدنا حسنا وجمالا»","صحيح","Sahih al-Jami al-Saghir 2124","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2125","«إن في الجنة لشجرة يسير الراكب الجواد المضمر السريع في ظلها مائة عام ما يقطعها»","صحيح","Sahih al-Jami al-Saghir 2125","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2126","«إن في الجنة مائة درجة أعدها الله للمجاهدين في سبيل الله ما بين الدرجتين كما بين السماء والأرض فإذا سألتم الله فسلوه الفردوس فإنه أوسط الجنة وأعلى الجنة وفوقه عرش الرحمن ومنه تفجر أنهار الجنة»","صحيح","Sahih al-Jami al-Saghir 2126","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2127","«إن في الجنة ما لا عين رأت ولا أذن سمعت ولا خطر على قلب أحد»","صحيح","Sahih al-Jami al-Saghir 2127","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2128","«إن في الحجم شفاء»","صحيح","Sahih al-Jami al-Saghir 2128","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2129","«إن في الصلاة شغلا»","صحيح","Sahih al-Jami al-Saghir 2129","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2130","«إن في الليل لساعة لا يوافقها عبد مسلم يسأل الله تعالى فيها خيرا من أمر الدنيا والآخرة إلا أعطاه إياه وذلك كل ليلة»","صحيح","Sahih al-Jami al-Saghir 2130","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2131","إن في أمتي اثني عشر منافقا لا يدخلون الجنة ولا ¤ يجدون ريحها حتى يلج الجمل في سم الخياط ثمانية منهم تكفيكهم الدبيلة: سراج من النار يظهر في أكتافهم حتى ينجم من صدورهم","صحيح","Sahih al-Jami al-Saghir 2131","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2132","«إن في أمتي خسفا ومسخا وقذفا»","صحيح","Sahih al-Jami al-Saghir 2132","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2133","«إن في ثقيف كذابا ومبيرا»","صحيح","Sahih al-Jami al-Saghir 2133","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2134","«إن في حوضي من الأباريق بعدد نجوم السماء»","صحيح","Sahih al-Jami al-Saghir 2134","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2135","«إن في عجوة العالية شفاء وإنها ترياق من أول البكرة»","صحيح","Sahih al-Jami al-Saghir 2135","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2136","«إن فيك لخصلتين يحبهما الله تعالى: الحلم والأناة»","صحيح","Sahih al-Jami al-Saghir 2136","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2137","«إن في مال الرجل فتنة وفى زوجته فتنة وولده»","صحيح","Sahih al-Jami al-Saghir 2137","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2138","«إن قدر حوضي كما بين أيلة وصنعاء من اليمن وإن فيه من الأباريق كعدد نجوم السماء»","صحيح","Sahih al-Jami al-Saghir 2138","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2139","«إن قريشا أهل أمانة لا يبغيهم العثرات أحد إلا كبه الله لمنخريه»","حسن","Sahih al-Jami al-Saghir 2139","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2140","«إن قريشا حديثو عهد بجاهلية ومصيبة وإني أردت أن أحبوهم وأتألفهم أما ترضون أن يرجع الناس بالدنيا وترجعون برسول الله إلى بيوتكم؟ لو سلك الناس واديا أو شعبا لسلكت وادي الأنصار وشعبهم»","صحيح","Sahih al-Jami al-Saghir 2140","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2141","«إن قلوب بني آدم كلها بين أصبعين من أصابع الرحمن كقلب واحد يصرفه حيث شاء»","صحيح","Sahih al-Jami al-Saghir 2141","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2142","«إن كذبا علي ليس ككذب على أحد فمن كذب علي متعمدا فليتبوأ مقعده من النار»","صحيح","Sahih al-Jami al-Saghir 2142","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2143","«إن كسر عظم المسلم ميتا ككسره حيا»","صحيح","Sahih al-Jami al-Saghir 2143","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2144","«إن كل صلاة تحط ما بين يديها من خطيئة»","صحيح","Sahih al-Jami al-Saghir 2144","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2145","«إن لبيوتكم عمارا فحرجوا عليهن ثلاثا فإن بدا لكم بعد ذلك منهن شيء فاقتلوه»","صحيح","Sahih al-Jami al-Saghir 2145","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2146","«إن لصاحب الحق مقالا»","صحيح","Sahih al-Jami al-Saghir 2146","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2147","«إن لكل أمة أمينا وإن أمين هذه الأمة أبو عبيدة بن الجراح»","صحيح","Sahih al-Jami al-Saghir 2147","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2148","«إن لكل أمة فتنة وإن فتنة أمتي المال»","صحيح","Sahih al-Jami al-Saghir 2148","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2149","«إن لكل دين خلقا وإن خلق الإسلام الحياء»","حسن","Sahih al-Jami al-Saghir 2149","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2150","«إن لكل شيء حقيقة وما بلغ عبد حقيقة الإيمان حتى يعلم أن ما أصابه لم يكن ليخطئه وما أخطأه لم يكن ليصيبه»","صحيح","Sahih al-Jami al-Saghir 2150","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2151","«إن لكل شيء شرة ولكل شرة فترة فإن صاحبها سدد وقارب فارجوه وإن أشير إليه بالأصابع فلا تعدوه»","صحيح","Sahih al-Jami al-Saghir 2151","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2152","«إن لكل عمل شرة ولكل شرة فترة فمن كان فترته إلى سنتي فقد اهتدى ومن كانت إلى غير ذلك فقد هلك»","صحيح","Sahih al-Jami al-Saghir 2152","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2153","«إن لكل غادر لواء يوم القيامة يعرف به عند استه»","صحيح","Sahih al-Jami al-Saghir 2153","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2154","«إن لكل نبي أمينا وأميني أبو عبيدة بن الجراح»","صحيح","Sahih al-Jami al-Saghir 2154","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2155","«إن لكل نبي حواريا وإن حواري الزبير»","صحيح","Sahih al-Jami al-Saghir 2155","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2156","«إن لكل نبي حوضا وإنهم يتباهون أيهم أكثر واردة وإني أرجوا أن أكون أكثرهم واردة»","صحيح","Sahih al-Jami al-Saghir 2156","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2157","«إن لكل نبي دعوة قد دعا بها في أمته فاستجيب له وإني اختبأت دعوتي شفاعة لأمتي يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2157","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2158","«إن لكل نبي ولاة من النبيين وإن وليي أبي وخليل ربي»","صحيح","Sahih al-Jami al-Saghir 2158","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2159","«إن لك ما احتسبت»","صحيح","Sahih al-Jami al-Saghir 2159","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2160","«إن لك من الأجر على قدر نصبك ونفقتك»","صحيح","Sahih al-Jami al-Saghir 2160","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2161","«إن لكم بكل خطوة درجة»","صحيح","Sahih al-Jami al-Saghir 2161","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2162","«إن للإسلام صوى ومنارا كمنار الطريق»","صحيح","Sahih al-Jami al-Saghir 2162","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2163","«إن لله تعالى آنية من أهل الأرض وآنية ربكم قلوب عباده الصالحين وأحبها إليه ألينها وأرقها»","حسن","Sahih al-Jami al-Saghir 2163","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2164","«إن لله تعالى أقواما يختصهم بالنعم لمنافع العباد ويقرها فيهم ما بذلوها فإذا منعوها نزعها منهم فحولها إلى غيرهم»","حسن","Sahih al-Jami al-Saghir 2164","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2165","«إن لله تعالى أهلين من الناس: أهل القرآن هم أهل الله وخاصته»","صحيح","Sahih al-Jami al-Saghir 2165","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2166","«إن لله تعالى تسعة وتسعين اسما مائة إلا واحدا من أحصاها دخل الجنة»","صحيح","Sahih al-Jami al-Saghir 2166","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2167","«إن لله تعالى تسعة وتسعين اسما مائة غير واحد لا يحفظها أحد إلا دخل الجنة وهو وتر يحب الوتر»","صحيح","Sahih al-Jami al-Saghir 2167","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2168","«إن لله تعالى عبادا يعرفون الناس بالتوسم»","حسن","Sahih al-Jami al-Saghir 2168","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2169","«إن لله تعالى عتقاء في كل يوم وليلة لكل عبد منهم دعوة مستجابة»","صحيح","Sahih al-Jami al-Saghir 2169","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2170","«إن لله تعالى عند كل فطر عتقاء من النار وذلك في كل ليلة»","حسن","Sahih al-Jami al-Saghir 2170","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2171","«إن لله تعالى ما أخذ وله ما أعطى وكل شيء عنده بأجل مسمى»","صحيح","Sahih al-Jami al-Saghir 2171","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2172","«إن لله مائة رحمة أنزل منها رحمة واحدة بين الجن والإنس والبهائم والهوام فبها يتعاطفون وبها يتراحمون وبها تعطف الوحوش على ولدها وأخر تسعا وتسعين رحمة يرحم بها عباده يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2172","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2173","إن لله ملائكة سياحين في الأرض فضلا عن ¤ كتاب الناس يطوفون في الطرق يلتمسون أهل الذكر فإذا وجدوا قوما يذكرون الله تنادوا: هلموا إلى حاجاتكم فيحفونهم بأجنحتهم إلى السماء الدنيا فيسألهم ربهم وهو أعلم منهم: ما يقول عبادي؟ فيقولون: يسبحونك ويكبرونك ويحمدونك ويمجدونك فيقول: هل رأوني؟ فيقولون: لا والله ما رأوك فيقول: كيف لو رأوني؟ فيقولون: لو رأوك كانوا أشد لك عبادة وأشد لك تمجيدا وأكثر لك تسبيحا فيقول: فما يسألوني؟ فيقولون: يسألونك الجنة فيقول: وهل رأوها؟ فيقولون: لا والله يا رب ما رأوها فيقول: فكيف لو أنهم رأوها؟ فيقولون: لو أنهم رأوها كانوا أشد عليها حرصا وأشد لها طلبا وأعظم فيها رغبة قال: فمم يتعوذون؟ فيقولون: من النار فيقول الله: هل رأوها؟ فيقولون: لا والله يا رب ما رأوها فيقول: فكيف لو رأوها؟ فيقولون: لو رأوها كانوا أشد منها فرارا وأشد لها مخافة فيقول: فأشهدكم أني قد غفرت لهم فيقول ملك من الملائكة: فيهم فلان ليس منهم إنما جاء لحاجة! فيقول: هم القوم لا يشقى بهم جليسهم","صحيح","Sahih al-Jami al-Saghir 2173","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2174","«إن لله تعالى ملائكة سياحين في الأرض يبلغوني من أمتي السلام»","صحيح","Sahih al-Jami al-Saghir 2174","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2175","«إن لله تعالى ملائكة في الأرض تنطق على ألسنة بني آدم بما في المرء من الخير والشر»","صحيح","Sahih al-Jami al-Saghir 2175","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2176","إن لله تعالى ملكا أعطاه سمع العباد فليس من أحد يصلي علي إلا أبلغنيها وإني سألت ربي أن لا يصلي علي عبد صلاة إلا صلى عليه عشر أمثالها","حسن","Sahih al-Jami al-Saghir 2176","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2177","«إن للتوبة بابا عرض ما بين مصراعيه ما بين المشرق والمغرب لا يغلق حتى تطلع الشمس من مغربها»","حسن","Sahih al-Jami al-Saghir 2177","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2178","«إن للصلاة أولا وآخرا وإن أول وقت صلاة الظهر حين تزول الشمس وآخر وقتها حين يدخل وقت العصر وإن أول وقت العصر حين يدخل وقتها وإن آخر وقتها حين تصفر الشمس وإن أول وقت المغرب حين تغرب الشمس وإن آخر وقتها حين يغيب الشفق وإن أول وقت العشاء الآخرة حين يغيب الشفق وإن آخر وقتها حين ينتصف الليل وإن أول وقت الفجر حين يطلع الفجر وإن آخر وقتها حين تطلع الشمس»","صحيح","Sahih al-Jami al-Saghir 2178","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2179","«إن للطاعم الشاكر من الأجر مثل ما للصائم الصابر»","صحيح","Sahih al-Jami al-Saghir 2179","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2180","«إن للقبر ضغطة لو كان أحد ناجيا منها نجا سعد بن معاذ»","صحيح","Sahih al-Jami al-Saghir 2180","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2181","«إن للقرشي مثل قوة الرجلين من غير قريش»","صحيح","Sahih al-Jami al-Saghir 2181","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2182","«إن للمؤمن في الجنة لخيمة من لؤلؤة واحدة مجوفة طولها ستون ميلا للمؤمن فيها أهلون يطوف عليهم المؤمن فلا يرى بعضهم بعضا»","صحيح","Sahih al-Jami al-Saghir 2182","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2183","«إن للموت فزعا فإذا رأيتم جنازة فقوموا»","صحيح","Sahih al-Jami al-Saghir 2183","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2184","«إن لهذا الحجر لسانا وشفتين يشهد لمن استلمه يوم القيامة بحق»","صحيح","Sahih al-Jami al-Saghir 2184","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2185","«إن لهذه الإبل أوابد كأوابد الوحش فإذا غلبكم منها شيء فافعلوا به هكذا»","صحيح","Sahih al-Jami al-Saghir 2185","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2186","«إن لهذه البيوت عوامر فإذا رأيتم شيئا منها فحرجوا عليها ثلاثا فإن ذهب وإلا فاقتلوه فإنه كافر»","صحيح","Sahih al-Jami al-Saghir 2186","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2187","«إن له دسما - يعني اللبن -»","صحيح","Sahih al-Jami al-Saghir 2187","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2188","«إن له مرضعا في الجنة» - يعني ولده إبراهيم -","صحيح","Sahih al-Jami al-Saghir 2188","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2189","«إن لي خمسة أسماء أنا محمد وأنا أحمد وأنا الحاشر: الذي يحشر الناس على قدمي وأنا الماحي: الذي يمحو الله بي الكفر وأنا العاقب»","صحيح","Sahih al-Jami al-Saghir 2189","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2190","«إن ما بين مصراعين في الجنة لمسيرة أربعين سنة»","صحيح","Sahih al-Jami al-Saghir 2190","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2191","«إن ما قد قدر في الرحم سيكون»","حسن","Sahih al-Jami al-Saghir 2191","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2192","«إن مثل الذي يعمل السيئات ثم يعمل الحسنات كمثل رجل كانت عليه درع ضيقة قد خنقته ثم عمل حسنة فانفكت حلقة ثم عمل أخرى فانفكت الأخرى حتى يخرج إلى الأرض»","حسن","Sahih al-Jami al-Saghir 2192","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2193","«إن مثل الذي يعود في عطيته كمثل الكلب أكل حتى إذا شبع قاء ثم عاد في قيئه فأكله»","صحيح","Sahih al-Jami al-Saghir 2193","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2194","«إن مسح الحجر الأسود والركن اليماني يحطان الخطايا حطا»","صحيح","Sahih al-Jami al-Saghir 2194","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2195","«إن مطعم ابن آدم قد ضرب مثلا للدنيا وإن قزحه وملحه فانظر إلى ما يصير»","حسن","Sahih al-Jami al-Saghir 2195","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2196","«إن مع الدجال إذا خرج ماء ونارا فأما الذي يرى الناس أنها النار فماء بارد وأما الذي يرى الناس أنها ماء بارد فنار تحرق فمن أدرك منكم فليقع في الذي يرى أنها نار فإنه عذب بارد»","صحيح","Sahih al-Jami al-Saghir 2196","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2197","«إن مكة حرمها الله ولم يحرمها الناس فلا يحل لامرئ يؤمن بالله واليوم الآخر أن يسفك بها دما ولا يعضد بها شجرة فإن أحد ترخص لقتال رسول الله صلى الله عليه وسلم فيها فقولوا: إن الله قد أذن لرسوله ولم يأذن لكم وإنما أذن لي ساعة من نهار ثم عادت حرمتها اليوم كحرمتها بالأمس وليبلغ الشاهد الغائب»","صحيح","Sahih al-Jami al-Saghir 2197","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2198","«إن ملكا أتاني فقال: إن ربك يقول لك: أما ترضى أن لا يصلي عليك أحد من أمتك إلا صليت عليه عشرا ولا يسلم عليك إلا سلمت عليه عشرا؟ قلت: بلى»","حسن","Sahih al-Jami al-Saghir 2198","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2199","«إن من إجلال الله إكرام ذي الشيبة المسلم وحامل القرآن غير الغالي فيه والجافي عنه وإكرام ذي السلطان المقسط»","حسن","Sahih al-Jami al-Saghir 2199","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2200","«إن من أحبكم إلي أحسنكم أخلاقا»","صحيح","Sahih al-Jami al-Saghir 2200","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2201","«إن من أحبكم إلي وأقربكم مني مجلسا يوم القيامة أحاسنكم أخلاقا وإن أبغضكم إلي وأبعدكم مني يوم القيامة الثرثارون والمتشدقون والمتفيهقون قالوا: يا رسول الله ما المتفيهقون؟ قال: المتكبرون»","حسن","Sahih al-Jami al-Saghir 2201","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2202","«إن من أحسن الناس صوتا بالقرآن الذي إذا سمعته يقرأ رأيت أنه يخشى الله»","صحيح","Sahih al-Jami al-Saghir 2202","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2203","«إن من أربى الربا الاستطالة في عرض المسلم بغير حق»","صحيح","Sahih al-Jami al-Saghir 2203","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2204","«إن من أشد الناس عذابا يوم القيامة الذين يشبهون بخلق الله»","صحيح","Sahih al-Jami al-Saghir 2204","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2205","«إن من أشراط الساعة أن تقاتلوا قوما ينتعلون نعال الشعر وإن من أشراط الساعة أن تقاتلوا قوما عراض الوجوه كأن وجوههم المجان المطرقة»","صحيح","Sahih al-Jami al-Saghir 2205","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2206","«إن من أشراط الساعة أن يرفع العلم ويظهر الجهل ويفشو الزنا ويشرب الخمر ويذهب الرجال وتبقى النساء حتى يكون لخمسين امرأة قيم واحد»","صحيح","Sahih al-Jami al-Saghir 2206","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2207","«إن من أشراط الساعة أن يلتمس العلم عند الأصاغر»","صحيح","Sahih al-Jami al-Saghir 2207","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2208","«إن من أطيب ما أكل الرجل من كسبه وولده من كسبه»","صحيح","Sahih al-Jami al-Saghir 2208","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2209","«إن من أعظم الجهاد كلمة عدل عند سلطان جائر»","صحيح","Sahih al-Jami al-Saghir 2209","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2210","«إن من أعظم الفرى أن يدعى الرجل إلى غير أبيه أو يرى عينيه ما لم تريا ويقول على رسول الله صلى الله عليه وسلم ما لم يقل»","صحيح","Sahih al-Jami al-Saghir 2210","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2211","«إن من أفرى الفرى أن يرى الرجل عينه في المنام ما لم تر»","صحيح","Sahih al-Jami al-Saghir 2211","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2212","«إن من أفضل أيامكم يوم الجمعة فيه خلق آدم وفيه قبض وفيه النفخة وفيه الصعقة فأكثروا علي من الصلاة فيه فإن صلاتكم معروضة علي إن الله حرم على الأرض أن تأكل أجساد الأنبياء»","صحيح","Sahih al-Jami al-Saghir 2212","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2213","إن من أكبر الكبائر الشرك بالله وعقوق الوالدين واليمين الغموس وما حلف حالف بالله يمين صبر فأدخل فيها مثل ¤ جناح بعوضة إلا جعلت نكتة في قلبه إلى يوم القيامة","حسن","Sahih al-Jami al-Saghir 2213","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2214","«إن من أكبر الكبائر أن يلعن الرجل والديه: يلعن أبا الرجل فيلعن أباه ويلعن أمه فيلعن أمه»","صحيح","Sahih al-Jami al-Saghir 2214","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2215","«إن من البيان سحرا وإن من الشعر حكما»","صحيح","Sahih al-Jami al-Saghir 2215","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2216","«إن من البيان لسحرا»","صحيح","Sahih al-Jami al-Saghir 2216","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2217","«إن من الحنطة خمرا وإن من الشعير خمرا وإن من التمر خمرا وإن من الزبيب خمرا وإن من العسل خمرا وأنا أنهى عن كل مسكر»","صحيح","Sahih al-Jami al-Saghir 2217","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2218","«إن من الشجر شجرة لا يسقط ورقها وإنها مثل المسلم فحدثوني ما هي؟ ثم قال: هي النخلة»","صحيح","Sahih al-Jami al-Saghir 2218","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2219","«إن من الشعر حكمة»","صحيح","Sahih al-Jami al-Saghir 2219","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2220","«إن من العنب خمرا وإن من التمر خمرا وإن من العسل خمرا وإن من البر خمرا وإن من الشعير خمرا»","صحيح","Sahih al-Jami al-Saghir 2220","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2221","«إن من الغيرة ما يحب الله ومنها ما يبغض الله وإن من الخيلاء ما يحب الله ومنها ما يبغض الله فأما الغيرة التي يحبها الله فالغيرة في الريبة وأما الغيرة التي يبغض الله فالغيرة في غير الريبة وأما الخيلاء التي يحبها الله فاختيال الرجل في القتال واختياله عند الصدقة وأما الخيلاء التي يبغض الله فاختيال الرجل في البغي والفخر»","حسن","Sahih al-Jami al-Saghir 2221","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2222","«إن من الفطرة: المضمضة والاستنشاق والسواك وقص الشوارب وتقليم الأظفار ونتف الإبط والاستحداد وغسل البراجم والانتضاح بالماء والاختتان»","حسن","Sahih al-Jami al-Saghir 2222","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2223","«إن من الناس ناسا مفاتيح للخير مغاليق للشر وإن من الناس ناسا مفاتيح للشر مغاليق للخير فطوبى لمن جعل الله مفاتيح الخير على يديه وويل لمن جعل الله مفاتيح الشر على يديه»","حسن","Sahih al-Jami al-Saghir 2223","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2224","«إن من أمتي قوما يعطون مثل أجور أولهم ينكرون المنكر»","صحيح","Sahih al-Jami al-Saghir 2224","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2225","«إن من تمام الصلاة إقامة الصف»","صحيح","Sahih al-Jami al-Saghir 2225","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2226","«إن من شر الناس عند الله يوم القيامة ذا الوجهين»","صحيح","Sahih al-Jami al-Saghir 2226","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2227","«إن من ضئضئ هذا قوما يقرءون القرآن لا يجاوز حناجرهم يقتلون أهل الإسلام ويدعون أهل الأوثان يمرقون من الإسلام كما يمرق السهم من الرمية لئن أدركتهم لأقتلنهم قتل عاد»","صحيح","Sahih al-Jami al-Saghir 2227","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2228","«إن من عباد الله من لو أقسم على الله لأبره»","صحيح","Sahih al-Jami al-Saghir 2228","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2229","«إن من قبل مغرب الشمس بابا مفتوحا عرضه سبعون سنة فلا يزال ذلك الباب مفتوحا حتى تطلع الشمس نحوه فإذا طلعت من نحوه لم ينفع نفسا إيمانها لم تكن آمنت من قبل أو كسبت في إيمانها خيرا»","حسن","Sahih al-Jami al-Saghir 2229","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2230","«إن مما أدرك الناس من كلام النبوة الأولى: إذا لم تستح فاصنع ما شئت»","صحيح","Sahih al-Jami al-Saghir 2230","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2231","«إن مما يلحق المؤمن من عمله وحسناته بعد موته علما نشره وولدا صالحا تركه ومصحفا ورثه أو مسجدا بناه أو بيتا لابن السبيل بناه أو نهرا أجراه أو صدقة أخرجها من ماله في صحته وحياته تلحقه من بعد موته»","حسن","Sahih al-Jami al-Saghir 2231","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2232","«إن موجبات المغفرة بذل السلام وحسن الكلام»","صحيح","Sahih al-Jami al-Saghir 2232","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2233","«إن من ورائكم أياما ينزل فيها الجهل ويرفع فيها العلم ويكثر فيها الهرج: القتل»","صحيح","Sahih al-Jami al-Saghir 2233","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2234","«إن من ورائكم زمان صبر للمتمسك فيه أجر خمسين شهيدا منكم»","صحيح","Sahih al-Jami al-Saghir 2234","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2235","«إن من يمن المرأة تيسير خطبتها وتيسير صداقها وتيسير رحمها»","حسن","Sahih al-Jami al-Saghir 2235","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2236","«إن منكم رجالا لا أعطيهم شيئا أكلهم إلى إيمانهم منهم فرات بن حيان»","صحيح","Sahih al-Jami al-Saghir 2236","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2237","«إن منهم من تأخذه النار إلى كعبيه ومنهم من تأخذه إلى ركبتيه ومنهم من تأخذه إلى حجزته ومنهم من تأخذه إلى عنقه»","صحيح","Sahih al-Jami al-Saghir 2237","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2238","إن موسى قال: يا رب أرنا آدم الذي أخرجنا ونفسه من الجنة فأراه الله آدم قال أنت أبونا آدم؟ فقال له آدم: نعم قال أنت الذي نفخ الله فيك من روحه وعلمك الأسماء كلها وأمر الملائكة فسجدوا لك؟ قال: نعم. قال: فما حملك على أن أخرجتنا ونفسك من ¤ الجنة؟ فقال له آدم: ومن أنت؟ قال: أنا موسى. قال: أنت نبي بني إسرائيل الذي كلمك الله من وراء حجاب لم يجعل بينك وبينه رسولا من خلقه؟ قال: نعم. قال: فما وجدت أن ذلك كان في كتاب الله قبل أن أخلق؟ قال: نعم. قال: فبم تلومني في شيء سبق من الله فيه القضاء قبلي؟ فحج آدم موسى فحج آدم موسى","حسن","Sahih al-Jami al-Saghir 2238","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2239","«إن موسى كان رجلا حييا ستيرا لا يرى من جلده شيء استحياء منه فآذاه من آذاه من بني إسرائيل فقالوا: ما استتر هذا التستر إلا من عيب بجلده إما برص وإما أدرة وإما آفة وإن الله عز وجل أراد أن يبرئه مما قالوا فخلا يوما وحده فوضع ثيابه على الحجر ثم اغتسل فلما فرغ أقبل إلى ثيابه ليأخذها وإن الحجر عدا بثوبه فأخذ موسى عصاه وطلب الحجر فجعل يقول: ثوبي حجر ثوبي حجر! حتى انتهى إلى ملأ من بني إسرائيل فرأوه عريانا أحسن ما خلق الله وبرأه مما يقولون وقام الحجر فأخذ ثوبه فلبسه وطفق بالحجر ضربا بعصاه فوالله إن بالحجر لندبا من أثر ضربه ثلاثا أو أربعا أو خمسا فذلك قوله تعالى: {يَا أَيُّهَا الَّذِينَ آمَنُوا لا تَكُونُوا كَالَّذِينَ آذَوْا مُوسَى فَبَرَّأَهُ اللَّهُ مِمَّا قَالُوا وَكَانَ عِنْدَ اللَّهِ وَجِيها} »","صحيح","Sahih al-Jami al-Saghir 2239","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2240","إن ناسا من أمتي سيماهم التحليق يقرءون القرآن لا يجاوز حلوقهم يمرقون من الدين كما يمرق السهم من ¤ الرمية هم شر الخلق والخليقة","صحيح","Sahih al-Jami al-Saghir 2240","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2241","«إن نفرا من الجن أسلموا بالمدينة فإذا رأيتم أحدا منهم فحذروه ثلاث مرات ثم إن بدا لكم بعد أن تقتلوه فاقتلوه بعد الثلاث»","صحيح","Sahih al-Jami al-Saghir 2241","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2242","«إن هاتين الصلاتين - يعني العشاء والصبح - من أثقل الصلاة على المنافقين ولو يعلمون فضل ما فيهما لأتوهما ولو حبوا عليكم بالصف المقدم فإنه مثل صف الملائكة ولو تعلمون فضيلته لابتدرتموه وصلاة الرجل مع الرجل أزكى من صلاته وحده وصلاته مع الرجلين أزكى من صلاته مع الرجل وما كان أكثر فهو أحب إلى الله تعالى»","حسن","Sahih al-Jami al-Saghir 2242","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2243","«إن هذا اخترط سيفي وأنا نائم فاستيقظت وهو في يده صلتا فقال لي: من يمنعك مني؟ قلت: الله؟ فها هو ذا جالسا!»","صحيح","Sahih al-Jami al-Saghir 2243","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2244","«إن هذا الأمر في قريش لا يعاديهم أحد إلا كبه الله على وجهه ما أقاموا الدين»","صحيح","Sahih al-Jami al-Saghir 2244","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2245","«إن هذا الدينار والدرهم أهلكا من قبلكم هما مهلكاكم»","صحيح","Sahih al-Jami al-Saghir 2245","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2246","«إن هذا الدين متين فأوغلوا فيه برفق»","حسن","Sahih al-Jami al-Saghir 2246","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2247","«إن هذا الشهر قد حضركم وفيه ليلة خير من ألف شهر من حرمها فقد حرم الخير كله ولا يحرم خيرها إلا محروم»","حسن","Sahih al-Jami al-Saghir 2247","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2248","«إن هذا الطاعون رجز وبقية عذاب عذب به قوم فإذا وقع بأرض وأنتم بها فلا تخرجوا منها فرارا منه وإذا وقع بأرض ولستم بها فلا تدخلوها»","صحيح","Sahih al-Jami al-Saghir 2248","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2249","«إن هذا القرآن أنزل على سبعة أحرف فاقرءوا ما تيسر منه»","صحيح","Sahih al-Jami al-Saghir 2249","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2250","«إن هذا المال خضر حلو فمن أخذه بحقه بورك له فيه ومن أخذه بإشراف نفس لم يبارك له فيه وكان كالذي يأكل ولا يشبع واليد العليا خير من اليد السفلى»","صحيح","Sahih al-Jami al-Saghir 2250","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2251","«إن هذا المال خضرة حلوة فمن أصابه بحقه بورك فيه ورب متخوض فيما شاءت نفسه من مال الله ورسوله ليس له يوم القيمة إلا النار»","صحيح","Sahih al-Jami al-Saghir 2251","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2252","«إن هذا المسجد لا يبال فيه وإنما بني لذكر الله والصلاة»","حسن","Sahih al-Jami al-Saghir 2252","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2253","«إن هذا الوباء رجز أهلك الله به الأمم قبلكم وقد بقي منه في الأرض شيء يجيء أحيانا ويذهب أحيانا فإذا وقع بأرض فلا تخرجوا منها فرارا وإذا سمعتم به في أرض فلا تأتوها»","صحيح","Sahih al-Jami al-Saghir 2253","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2254","«إن هذا أمر كتبه الله على بنات آدم فاغتسلي وأهلي بالحج واقضي ما يقضي الحاج غير أن لا تطوفي بالبيت ولا تصلي»","صحيح","Sahih al-Jami al-Saghir 2254","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2255","«إن هذا أمر كتبه الله على بنات آدم فاقضي ما يقضي الحاج غير أن لا تطوفي بالبيت»","صحيح","Sahih al-Jami al-Saghir 2255","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2256","«إن هذا بكى لما فقد من الذكر» - يعني الجِذْع -","صحيح","Sahih al-Jami al-Saghir 2256","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2257","«إن هذا ملك لم ينزل الأرض قط قبل هذه الليلة استأذن ربه أن يسلم علي ويبشرني بأن فاطمة سيدة نساء أهل الجنة وأن الحسن والحسين سيدا شباب أهل الجنة»","صحيح","Sahih al-Jami al-Saghir 2257","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2258","«إن هذا يوم جعله الله عيدا للمسلمين فمن جاء إلى الجمعة فليغتسل وإن كان طيب فليمس منه وعليكم بالسواك»","صحيح","Sahih al-Jami al-Saghir 2258","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2259","«إن هذا يوم كان يصومه أهل الجاهلية فمن أحب أن يصومه فليصمه ومن أحب أن يتركه فليتركه» - يعني يوم عاشوراء -","صحيح","Sahih al-Jami al-Saghir 2259","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2260","«إن هذه الآيات التي يرسل الله لا تكون لموت أحد ولا لحياته ولكن الله يرسلها يخوف بها عباده فإذا رأيتم منها شيئا فافزعوا إلى ذكر الله ودعائه واستغفاره»","صحيح","Sahih al-Jami al-Saghir 2260","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2261","«إن هذه الأمة أمة مرحومة عذابها بأيديها فإذا كان يوم القيامة دفع إلى كل رجل من المسلمين رجل من المشركين فيقال: هذا فداؤك من النار»","صحيح","Sahih al-Jami al-Saghir 2261","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2262","إن هذه الأمة تبتلى في قبورها فلولا أن لا تدافنوا لدعوت الله أن يسمعكم من عذاب القبر الذي أسمع منه تعوذوا بالله من عذاب النار تعوذوا بالله من عذاب القبر تعوذوا بالله من الفتن ما ظهر منها وما بطن تعوذوا بالله من فتنة الدجال","صحيح","Sahih al-Jami al-Saghir 2262","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2263","«إن هذه الحشوش محتضرة فإذا أتى أحدكم الخلاء فليقل: أعوذ بالله من الخبث والخبائث»","صحيح","Sahih al-Jami al-Saghir 2263","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2264","«إن هذه الصدقات إنما هي أوساخ الناس وإنها لا تحل لمحمد ولا لآل محمد»","صحيح","Sahih al-Jami al-Saghir 2264","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2265","«إن هذه الصلاة لا يصلح فيها شيء من كلام الناس إنما هو التسبيح والتكبير وقراءة القرآن»","صحيح","Sahih al-Jami al-Saghir 2265","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2266","«إن هذه الصلاة - يعني العصر - عرضت على من كان قبلكم فضيعوها فمن حافظ منكم اليوم عليها كان له أجره مرتين ولا صلاة بعدها حتى يطلع الشاهد»","صحيح","Sahih al-Jami al-Saghir 2266","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2267","«إن هذه القبور ممتلئة على أهلها ظلمة وإن الله ينورها لهم بصلاتي عليهم»","صحيح","Sahih al-Jami al-Saghir 2267","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2268","إن هذه المساجد لا تصلح لشيء من القذر ¤ والبول والخلاء إنما هي لقراءة القرآن وذكر الله والصلاة","صحيح","Sahih al-Jami al-Saghir 2268","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2269","«إن هذه النار إنما هي عدو لكم فإذا نمتم فأطفئوها عنكم»","صحيح","Sahih al-Jami al-Saghir 2269","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2270","«إن هذه ضجعة لا يحبها الله تعالى»","صحيح","Sahih al-Jami al-Saghir 2270","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2271","«إن هذه ضجعة يبغضها الله تعالى» - يعني الاضطجاع على البطن -","صحيح","Sahih al-Jami al-Saghir 2271","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2272","«إن هذه ليست بالحيضة ولكن هذا عرق فإذا أدبرت الحيضة فاغتسلي وصلي وإذا أقبلت فاتركي لها الصلاة»","صحيح","Sahih al-Jami al-Saghir 2272","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2273","«إن هذه من ثياب الكفار فلا تلبسوها» - يعني المعصفر -","صحيح","Sahih al-Jami al-Saghir 2273","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2274","«إن هذين حرام على ذكور أمتي حل لإناثهم» - يعني الذهب والحرير -","صحيح","Sahih al-Jami al-Saghir 2274","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2275","إن وسادك إذن لعريض طويل إنما هو: سواد ¤ الليل وبياض النهار","صحيح","Sahih al-Jami al-Saghir 2275","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2276","«إن يأجوج ومأجوج ليحفرون السد كل يوم حتى إذا كادوا يرون شعاع الشمس قال الذي عليهم: ارجعوا فستحفرونه غدا فيعيده الله أشد ما كان حتى إذا بلغت مدتهم وأراد الله أن يبعثهم على الناس حضروا حتى إذا كادوا يرون شعاع الشمس قال الذي عليهم: ارجعوا فستحفرونه غدا إن شاء الله واستثنوا فيعودون إليه وهو كهيئته حين تركوه فيحفرونه ويخرجون على الناس فينشفون الماء ويتحصن الناس منهم في حصونهم فيرمون سهامهم إلى السماء فترجع وعليها كهيئة الدم الذي اجفظ فيقولون: قهرنا أهل الأرض وعلونا أهل السماء! فيبعث الله عليهم نغفا في أقفائهم فيقتلهم بها والذي نفسي بيده إن دواب الأرض لتسمن وتشكر شكرا من لحومهم ودمائهم»","صحيح","Sahih al-Jami al-Saghir 2276","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2277","«إن يمين الله ملأى لا يغيضها نفقة سحاء الليل والنهار أرأيتم ما أنفق منذ خلق السموات والأرض؟ فإنه لم يغض ما في يمينه وعرشه على الماء وبيده الأخرى القبض يرفع ويخفض»","صحيح","Sahih al-Jami al-Saghir 2277","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2278","إن يوم الاثنين والخميس يغفر الله فيهما لكل ¤ مسلم إلا مهتجرين يقول: دعهما حتى يصطلحا","صحيح","Sahih al-Jami al-Saghir 2278","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2279","«إن يوم الجمعة سيد الأيام وأعظمها عند الله وهو أعظم عند الله من يوم الأضحى ويوم الفطر فيه خمس خلال: خلق الله فيه آدم وأهبط الله فيه آدم إلى الأرض وفيه توفى الله آدم وفيه ساعة لا يسأل الله فيها العبد شيئا إلا أعطاه إياه ما لم يسأل حراما وفيه تقوم الساعة وما من ملك مقرب ولا سماء ولا أرض ولا رياح ولا جبال ولا بحر إلا وهو يشفق من يوم الجمعة أن تقوم فيه الساعة»","حسن","Sahih al-Jami al-Saghir 2279","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2280","«إنا آل محمد لا تحل لنا الصدقة»","صحيح","Sahih al-Jami al-Saghir 2280","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2281","«إنا آل محمد لا تحل لنا الصدقة وإن مولى القوم من أنفسهم»","صحيح","Sahih al-Jami al-Saghir 2281","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2282","«إنا أمة أمية لا نكتب ولا نحسب»","صحيح","Sahih al-Jami al-Saghir 2282","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2283","«إنا قد اتخذنا خاتما ونقشنا فيه نقشا فلا ينقش أحد على نقشه»","صحيح","Sahih al-Jami al-Saghir 2283","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2284","إنا كنا نهيناكم عن لحومها أن تأكلوها فوق ¤ ثلاث لكي تسعكم فقد جاء الله بالسعة فكلوا وادخروا واتجروا ألا وإن هذه الأيام أيام أكل وشرب وذكر الله","صحيح","Sahih al-Jami al-Saghir 2284","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2285","«إنا لن نستعمل على عملنا من أراده»","صحيح","Sahih al-Jami al-Saghir 2285","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2286","«إنا معشر الأنبياء أمرنا أن نعجل إفطارنا ونؤخر سحورنا ونضع أيماننا على شمائلنا في الصلاة»","صحيح","Sahih al-Jami al-Saghir 2286","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2287","«إنا معشر الأنبياء تنام أعيننا ولا تنام قلوبنا»","صحيح","Sahih al-Jami al-Saghir 2287","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2288","«إنا معشر الأنبياء يضاعف علينا البلاء»","صحيح","Sahih al-Jami al-Saghir 2288","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2289","«إنا نخطب فمن أحب أن يجلس للخطبة فليجلس ومن أحب أن يذهب فليذهب»","صحيح","Sahih al-Jami al-Saghir 2289","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2290","«إنا نهينا أن ترى عوراتنا»","صحيح","Sahih al-Jami al-Saghir 2290","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2291","إنا والله لا نولي على هذا العمل أحدا سأله ¤ ولا أحدا حرص عليه","صحيح","Sahih al-Jami al-Saghir 2291","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2292","«إنا لا نستعين بالمشركين على المشركين»","صحيح","Sahih al-Jami al-Saghir 2292","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2293","«إنا لا نستعين بمشرك»","صحيح","Sahih al-Jami al-Saghir 2293","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2294","«إنا لا نقبل شيئا من المشركين»","صحيح","Sahih al-Jami al-Saghir 2294","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2295","«إنك إن اتبعت عورات الناس أفسدتهم أو كدت تفسدهم»","صحيح","Sahih al-Jami al-Saghir 2295","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2296","«إنك تقدم على قوم أهل كتاب فليكن أول ما تدعوهم إليه عبادة الله فإذا عرفوا الله فأخبرهم أن الله قد فرض عليهم خمس صلوات في يومهم وليلتهم فإذا فعلوا فأخبرهم أن الله قد فرض عليهم زكاة تؤخذ من أموالهم فترد على فقرائهم فإذا أطاعوا بها فخذ منهم وتوق كرائم أموال الناس»","صحيح","Sahih al-Jami al-Saghir 2296","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2297","«إنك دعوتنا خامس خمسة وهذا رجل قد تبعنا فإن شئت أذنت له وإن شئت رجع»","صحيح","Sahih al-Jami al-Saghir 2297","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2298","«إنك ستأتي قوما أهل كتاب فإذا جئتهم فادعهم إلى أن يشهدوا أن لا إله إلا الله وأن محمدا رسول الله فإن هم أطاعوا لك بذلك فأخبرهم أن الله قد فرض عليهم خمس صلوات في كل يوم وليلة فإن هم أطاعوا لك بذلك فأخبرهم أن الله قد فرض عليهم صدقة تؤخذ من أغنيائهم فترد على فقرائهم فإن هم أطاعوا لك بذلك فإياك وكرائم أموالهم واتق دعوة المظلوم فإنه ليس بينها وبين الله حجاب»","صحيح","Sahih al-Jami al-Saghir 2298","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2299","«إنك كالذي قال الأول: اللهم أبغني حبيبا هو أحب إلي من نفسي»","صحيح","Sahih al-Jami al-Saghir 2299","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2300","«إنك لن تخلف بعدي فتعمل عملا صالحا إلا ازددت به درجة ورفعة ثم لعلك أن تخلف حتى ينتفع بك أقوام ويضر بك آخرون اللهم أمض لأصحابي هجرتهم ولا تردهم على أعقابهم لكن البائس سعد بن خولة»","صحيح","Sahih al-Jami al-Saghir 2300","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2301","«إنكم تتمون سبعين أمة أنتم خيرها وأكرمها على الله»","حسن","Sahih al-Jami al-Saghir 2301","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2302","«إنكم تحشرون رجالا وركبانا وتجرون على وجوهكم هاهنا» - وأومأ بيده نحو الشام -","صحيح","Sahih al-Jami al-Saghir 2302","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2303","«إنكم تنتظرون صلاة ما ينتظرها أهل دين غيركم ولولا أن يثقل على أمتي لصليت بهم هذه الساعة»","صحيح","Sahih al-Jami al-Saghir 2303","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2304","«إنكم ستحرصون على الإمارة وإنها ستكون ندامة وحسرة يوم القيامة فنعم المرضعة وبئست الفاطمة»","صحيح","Sahih al-Jami al-Saghir 2304","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2305","«إنكم سترون بعدي أثرة وأمورا تنكرونها أدوا إليهم حقهم وسلوا الله حقكم»","صحيح","Sahih al-Jami al-Saghir 2305","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2306","«إنكم سترون ربكم كما ترون هذا القمر لا تضامون في رؤيته فإن استطعتم أن لا تغلبوا على صلاة قبل طلوع الشمس وصلاة قبل غروبها فافعلوا»","صحيح","Sahih al-Jami al-Saghir 2306","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2307","«إنكم ستفتحون مصر وهي أرض يسمى فيها القيراط فإذا فتحتموها فاستوصوا بأهلها خيرا فإن لهم ذمة ورحما فإذا رأيت رجلين يختصمان في موضع لبنة فاخرج منها»","صحيح","Sahih al-Jami al-Saghir 2307","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2308","«إنكم ستلقون العدو غدا فليكن شعاركم {حم} لا ينصرون»","صحيح","Sahih al-Jami al-Saghir 2308","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2309","إنكم ستلقون بعدي أثرة فاصبروا حتى تلقوني غدا ¤ علي الحوض","صحيح","Sahih al-Jami al-Saghir 2309","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2310","«إنكم شكوتم جدب دياركم واستئخار المطر عن إبان زمانه عنكم وقد أمركم الله عز وجل ووعدكم أن يستجيب لكم {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ الرَّحْمَنِ الرَّحِيمِ مَالِكِ يَوْمِ الدِّينِ} لا إله إلا الله يفعل ما يريد اللهم أنت الله لا إله إلا أنت الغني ونحن الفقراء أنزل علينا الغيث واجعل ما أنزلت لنا قوة وبلاغا إلى حين»","حسن","Sahih al-Jami al-Saghir 2310","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2311","«إنكم لن تدركوا هذا الأمر بالمغالبة»","حسن","Sahih al-Jami al-Saghir 2311","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2312","«إنكم لن تروا ربكم عز وجل حتى تموتوا»","صحيح","Sahih al-Jami al-Saghir 2312","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2313","«إنكم لن تزالوا في صلاة ما انتظرتم الصلاة»","صحيح","Sahih al-Jami al-Saghir 2313","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2314","«إنكم مصبحوا عدوكم والفطر أقوى لكم فأفطروا»","صحيح","Sahih al-Jami al-Saghir 2314","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2315","إنما أجلكم فيما خلا من الأمم كما بين صلاة العصر إلى مغارب الشمس, وإنما مثلكم ومثل اليهود والنصارى كمثل رجل استأجر أجراء فقال: من يعمل من غدوة إلى نصف النهار على قيراط قيراط؟ فعملت اليهود ثم قال: من يعمل من نصف النهار إلى صلاة العصر على قيراط قيراط؟ فعملت النصارى ثم قال: من يعمل من العصر إلى أن ¤ تغيب الشمس على قيراطين قيراطين؟ فأنتم هم فغضبت اليهود والنصارى وقالوا: ما لنا أكثر عملا وأقل عطاء؟ قال: هل ظلمتكم من حقكم شيئا؟ قالوا: لا. قال: فذلك فضلي أوتيه من أشاء","صحيح","Sahih al-Jami al-Saghir 2315","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2316","«إنما أخاف على أمتي الأئمة المضلين»","صحيح","Sahih al-Jami al-Saghir 2316","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2317","إنما أخاف عليكم من بعدي ما يفتح عليكم من زهرة الدنيا وزينتها إنه لا يأتي الخير بالشر إن مما ينبت الربيع يقتل حبطا أو يلم إلا آكلة الخضر فإنها أكلت حتى إذا امتلأت خاصرتاها استقبلت الشمس فثلطت وبالت ثم رتعت وإن هذا المال خضرة حلوة ونعم صاحب المسلم هو لمن أعطاه المسكين واليتيم وابن السبيل فمن أخذه بحقه ووضعه في حقه فنعم المعونة هو ومن أخذه ¤ بغير حقه كان كالذي يأكل ولا يشبع ويكون عليه شهيدا يوم القيامة","صحيح","Sahih al-Jami al-Saghir 2317","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2318","«إنما أرى بني هاشم وبني المطلب شيئا واحدا إنهم لم يفارقونا في جاهلية ولا إسلام»","صحيح","Sahih al-Jami al-Saghir 2318","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2319","«إنما استراح من غفر له»","صحيح","Sahih al-Jami al-Saghir 2319","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2320","«إنما الأعمال كالوعاء إذا طاب أسفله طاب أعلاه وإذا فسد أسفله فسد أعلاه»","صحيح","Sahih al-Jami al-Saghir 2320","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2321","«إنما الإمام جنة يقاتل به»","صحيح","Sahih al-Jami al-Saghir 2321","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2322","«إنما الإمام جنة يقاتل من ورائه ويتقى به فإن أمر بتقوى الله وعدل فإن له بذلك أجرا وإن أمر بغيره فإن عليه وزرا»","صحيح","Sahih al-Jami al-Saghir 2322","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2323","«إنما البيع عن تراض»","صحيح","Sahih al-Jami al-Saghir 2323","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2324","«إنما الدين النصح»","صحيح","Sahih al-Jami al-Saghir 2324","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2325","«إنما الربا في النسيئة»","صحيح","Sahih al-Jami al-Saghir 2325","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2326","«إنما الشؤم في ثلاثة: في الفرس والمرأة والدار»","صحيح","Sahih al-Jami al-Saghir 2326","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2327","«إنما الطاعة في المعروف»","صحيح","Sahih al-Jami al-Saghir 2327","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2328","«إنما العلم بالتعلم وإنما الحلم بالتحلم ومن يتحر الخير يعطه ومن يتق الشر يوقه»","حسن","Sahih al-Jami al-Saghir 2328","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2329","«إنما الماء من الماء»","صحيح","Sahih al-Jami al-Saghir 2329","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2330","«إنما المجالس بالأمانة»","حسن","Sahih al-Jami al-Saghir 2330","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2331","«إنما المدينة كالكير تنفي خبثها وتنصع طيبها»","صحيح","Sahih al-Jami al-Saghir 2331","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2332","«إنما الناس كإبل مائة لا تكاد تجد فيها راحلة»","صحيح","Sahih al-Jami al-Saghir 2332","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2333","«إنما النساء شقائق الرجال»","صحيح","Sahih al-Jami al-Saghir 2333","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2334","«إنما النفقة والسكنى للمرأة إذا كان لزوجها عليها الرجعة»","صحيح","Sahih al-Jami al-Saghir 2334","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2335","«إنما الوتر بالليل»","حسن","Sahih al-Jami al-Saghir 2335","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2336","«إنما الولاء لمن أعتق»","صحيح","Sahih al-Jami al-Saghir 2336","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2337","«إنما أمرت بالوضوء إذا قمت إلى الصلاة»","صحيح","Sahih al-Jami al-Saghir 2337","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2338","«إنما أنا بشر إذا أمرتكم بشيء من دينكم فخذوا به وإذا أمرتكم بشيء من رأيي فإنما أنا بشر»","صحيح","Sahih al-Jami al-Saghir 2338","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2339","«إنما أنا بشر أنسى كما تنسون فإذا نسي أحدكم فليسجد سجدتين وهو جالس»","صحيح","Sahih al-Jami al-Saghir 2339","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2340","«إنما أنا بشر تدمع العين ويخشع القلب ولا نقول ما يسخط الرب والله يا إبراهيم إنا بك لمحزونون»","صحيح","Sahih al-Jami al-Saghir 2340","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2341","«إنما أنا بشر مثلكم وإن الظن يخطئ ويصيب ولكن ما قلت لكم: قال الله فلن أكذب على الله»","صحيح","Sahih al-Jami al-Saghir 2341","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2342","«إنما أنا بشر وإنكم تختصمون إلي فلعل بعضكم أن يكون ألحن بحجته من بعض فأقضي له على نحو ما أسمع فمن قضيت له بحق مسلم فإنما هي قطعة من النار فليأخذها أو ليتركها»","صحيح","Sahih al-Jami al-Saghir 2342","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2343","«إنما أنا بشر وإني اشترطت على ربي عز وجل: أي عبد من المسلمين شتمته أو سببته أن يكون ذلك له زكاة وأجرا»","صحيح","Sahih al-Jami al-Saghir 2343","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2344","«إنما أنا خازن وإنما يعطي الله فمن أعطيته عطاء عن طيب نفس مني فيبارك له فيه ومن أعطيته عطاء عن شره نفس وشدة مسألة فهو كالآكل يأكل ولا يشبع»","صحيح","Sahih al-Jami al-Saghir 2344","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2345","«إنما أنا رحمة مهداة»","صحيح","Sahih al-Jami al-Saghir 2345","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2346","«إنما أنا لكم بمنزلة الوالد أعلمكم فإذا أتى أحدكم الغائط فلا يستقبل القبلة ولا يستدبرها ولا يستطب بيمينه»","حسن","Sahih al-Jami al-Saghir 2346","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2347","«إنما أنا مبلغ والله يهدي وإنما أنا قاسم والله يعطي»","صحيح","Sahih al-Jami al-Saghir 2347","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2348","«إنما أهلك الذين من قبلكم أنهم كانوا إذا سرق فيهم الشريف تركوه وإذا سرق فيهم الضعيف أقاموا عليه الحد»","صحيح","Sahih al-Jami al-Saghir 2348","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2349","«إنما بعثت لأتمم صالح الأخلاق»","صحيح","Sahih al-Jami al-Saghir 2349","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2350","«إنما بعثتم ميسرين ولم تبعثوا معسرين»","صحيح","Sahih al-Jami al-Saghir 2350","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2351","«إنما بعثني الله مبلغا ولم يبعثني متعنتا»","حسن","Sahih al-Jami al-Saghir 2351","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2352","«إنما تفرقكم في الشعاب والأودية من الشيطان»","صحيح","Sahih al-Jami al-Saghir 2352","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2353","«إنما جزاء السلف الحمد والوفاء»","صحيح","Sahih al-Jami al-Saghir 2353","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2354","«إنما جعل الاستئذان من أجل البصر»","صحيح","Sahih al-Jami al-Saghir 2354","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2355","«إنما جعل الإمام جنة فإذا صلى قاعدا فصلوا قعودا وإذا قال سمع الله لمن حمده فقولوا: اللهم ربنا لك الحمد فإذا وافق قول أهل الأرض قول أهل السماء غفر له ما تقدم من ذنبه»","صحيح","Sahih al-Jami al-Saghir 2355","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2356","«إنما جعل الإمام ليؤتم به فإذا صلى قائما فصلوا قياما وإن صلى جالسا فصلوا جلوسا ولا تقوموا وهو جالس كما يفعل أهل فارس بعظمائها»","صحيح","Sahih al-Jami al-Saghir 2356","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2357","«إنما جعل الإمام ليؤتم به فإذا كبر فكبروا وإذا رفع فارفعوا وإذا قال: سمع الله لمن حمده فقولوا: اللهم ربنا ولك الحمد وإذا سجد فاسجدوا وإذا صلى جالسا فصلوا جلوسا أجمعين»","صحيح","Sahih al-Jami al-Saghir 2357","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2358","«إنما جعل الإمام ليؤتم به فإذا كبر فكبروا وإذا قرأ فأنصتوا وإذا قال سمع الله لمن حمده فقولوا: ربنا لك الحمد»","صحيح","Sahih al-Jami al-Saghir 2358","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2359","«إنما جعل الإمام ليؤتم به فإذا كبر فكبروا وإذا قرأ فأنصتوا وإذا قال {غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ} فقولوا: آمين وإذا ركع فاركعوا وإذا قال: سمع الله لمن حمده فقولوا: اللهم ربنا ولك الحمد وإذا سجد فاسجدوا وإذا صلى جالسا فصلوا جلوسا»","صحيح","Sahih al-Jami al-Saghir 2359","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2360","إنما جعل الإمام ليؤتم به فلا تختلفوا عليه وإذا كبر فكبروا وإذا ركع فاركعوا وإذا قال: سمع الله لمن حمده فقولوا: ربنا لك الحمد وإذا سجد فاسجدوا وإذا صلى جالسا ¤ فصلوا جلوسا أجمعين","صحيح","Sahih al-Jami al-Saghir 2360","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2361","«إنما خيرني الله فقال: {اسْتَغْفِرْ لَهُمْ أَوْ لا تَسْتَغْفِرْ لَهُمْ إِنْ تَسْتَغْفِرْ لَهُمْ سَبْعِينَ مَرَّةً} وسأزيده على سبعين»","صحيح","Sahih al-Jami al-Saghir 2361","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2362","«إنما ذلك جبريل ما رأيته في الصورة التي خلق فيها غير هاتين المرتين رأيته منهبطا من السماء سادا عظم خلقه ما بين السماء والأرض»","صحيح","Sahih al-Jami al-Saghir 2362","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2363","«إنما ذلك عرق فانظري فإذا أتى قرؤك فلا تصلي فإذا مر قرؤك فتطهري ثم صلي ما بين القرء إلى القرء»","صحيح","Sahih al-Jami al-Saghir 2363","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2364","«إنما سمي الخضر خضرا لأنه جلس على فروة بيضاء فإذا هي تهتز تحته خضراء»","صحيح","Sahih al-Jami al-Saghir 2364","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2365","«إنما سمي القلب من تقلبه إنما مثل القلب مثل ريشة بالفلاة تعلقت في أصل شجرة يقلبها الريح ظهرا لبطن»","صحيح","Sahih al-Jami al-Saghir 2365","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2366","«إنما فاطمة بضعة مني يؤذيني ما آذاها وينصبني ما أنصبها»","صحيح","Sahih al-Jami al-Saghir 2366","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2367","إنما كان يكفيك أن تضرب بيديك إلى ¤ الأرض فتمسح بهم وجهك وكفيك","صحيح","Sahih al-Jami al-Saghir 2367","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2368","«إنما مثل الجليس الصالح وجليس السوء كحامل المسك ونافخ الكير فحامل المسك إما أن يحذيك وإما أن تبتاع منه وإما أن تجد منه ريحا طيبة ونافخ الكير إما أن يحرق ثيابك وإما أن تجد ريحا خبيثة»","صحيح","Sahih al-Jami al-Saghir 2368","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2369","«إنما مثل الذي يصلي ورأسه معقوص مثل الذي يصلي وهو مكتوف»","صحيح","Sahih al-Jami al-Saghir 2369","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2370","«إنما مثل المؤمن حين يصيبه الوعك أو الحمى كمثل حديدة تدخل النار فيذهب خبثها ويبقى طيبها»","صحيح","Sahih al-Jami al-Saghir 2370","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2371","«إنما مثل المهجر إلى الصلاة كمثل الذي يهدي البدنة ثم الذي على أثره كالذي يهدي البقرة ثم الذي على أثره كالذي يهدي الكبش ثم الذي على أثره كالذي يهدي الدجاجة ثم الذي على أثره كالذي يهدي البيضة»","صحيح","Sahih al-Jami al-Saghir 2371","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2372","«إنما مثل صاحب القرآن كمثل صاحب الإبل المعقلة إن عاهد عليها أمسكها وإن أطلقها ذهبت»","صحيح","Sahih al-Jami al-Saghir 2372","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2373","«إنما نسمة المؤمن طائر يعلق في شجر الجنة حتى يبعثه الله إلى جسده يوم يبعثه»","صحيح","Sahih al-Jami al-Saghir 2373","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2374","«إنما هلك من كان قبلكم باختلافهم في الكتاب»","صحيح","Sahih al-Jami al-Saghir 2374","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2375","«إنما هلكت بنو إسرائيل حين اتخذ هذه نساؤهم» - يعني قصة من شعر -","صحيح","Sahih al-Jami al-Saghir 2375","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2376","«إنما هم قبضتان فقبضة في النار وقبضة في الجنة»","صحيح","Sahih al-Jami al-Saghir 2376","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2377","«إنما هي أربعة أشهر وعشر وقد كانت إحداكن في الجاهلية ترمي بالبعرة على رأس الحول»","صحيح","Sahih al-Jami al-Saghir 2377","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2378","«إنما هي توبة نبي» - يعني سجدة [ص]","صحيح","Sahih al-Jami al-Saghir 2378","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2379","«إنما يبعث الناس على نياتهم»","صحيح","Sahih al-Jami al-Saghir 2379","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2380","«إنما يخرج الدجال من غضبة يغضبها»","صحيح","Sahih al-Jami al-Saghir 2380","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2381","«إنما يرحم الله من عباده الرحماء»","حسن","Sahih al-Jami al-Saghir 2381","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2382","«إنما يزرع ثلاثة: رجل له أرض فهو يزرعها ورجل منح أرضا فهو يزرع ما منح ورجل استكرى أرضا بذهب أو فضة»","حسن","Sahih al-Jami al-Saghir 2382","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2383","«إنما يغسل من بول الأنثى وينضح من بول الذكر»","صحيح","Sahih al-Jami al-Saghir 2383","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2384","«إنما يكفي أحدكم ما كان في الدنيا مثل زاد الراكب»","صحيح","Sahih al-Jami al-Saghir 2384","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2385","«إنما يكفيك أن تحثي على رأسك ثلاث حثيات من ماء ثم تفيضي على سائر جسدك من الماء فإذا أنت قد طهرت»","صحيح","Sahih al-Jami al-Saghir 2385","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2386","«إنما يكفيك من جمع المال خادم ومركب في سبيل الله»","حسن","Sahih al-Jami al-Saghir 2386","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2387","إنما يلبس الحرير في الدنيا من لا خلاق له في ¤ الآخرة","صحيح","Sahih al-Jami al-Saghir 2387","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2388","«إنما ينصر الله هذه الأمة بضعيفها بدعوتهم وصلاتهم وإخلاصهم»","صحيح","Sahih al-Jami al-Saghir 2388","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2389","«إنه اتبعنا رجل لم يكن معنا حين دعينا فإن أذنت له دخل»","صحيح","Sahih al-Jami al-Saghir 2389","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2390","«إنه أوحي إلي أنكم تفتنون في القبور»","صحيح","Sahih al-Jami al-Saghir 2390","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2391","«إنه خلق كل إنسان من بني آدم على ستين وثلاثمائة مفصل فمن كبر الله وحمد الله وهلل الله وسبح الله واستغفر الله وعزل حجرا عن طريق الناس أو شوكة أو عظما عن طريق الناس وأمر بمعروف أو نهى عن منكر عدد تلك الستين والثلاثمائة السلامى فإنه يمسي يومئذ وقد زحزح نفسه عن النار»","صحيح","Sahih al-Jami al-Saghir 2391","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2392","«إنه ستكون فرقة واختلاف فإذا كان كذلك فاكسر سيفك واتخذ سيفا من خشب واقعد في بيتك حتى تأتيك يد خاطئة أو منية قاضية»","حسن","Sahih al-Jami al-Saghir 2392","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2393","«إنه ستكون هنات وهنات فمن أراد أن يفرق أمر هذه الأمة وهي جميع فاضربوه بالسيف كائنا من كان»","صحيح","Sahih al-Jami al-Saghir 2393","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2394","«إنه سيكون أمراء يؤخرون الصلاة عن مواقيتها ألا فصل الصلاة لوقتها ثم ائتهم فإن كانوا قد صلوا كنت قد أحرزت صلاتك وإلا صليت معهم فكانت تلك نافلة»","صحيح","Sahih al-Jami al-Saghir 2394","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2395","«إنه سيكون عليكم أئمة تعرفون وتنكرون فمن أنكر فقد برئ ومن كره فقد سلم ولكن من رضي وتابع»","صحيح","Sahih al-Jami al-Saghir 2395","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2396","«إنه سيكون في هذه الأمة قوم يعتدون في الطهور والدعاء»","صحيح","Sahih al-Jami al-Saghir 2396","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2397","«إنه سيلي أموركم بعدي رجال يعرفونكم ما تنكرون وينكرون عليكم ما تعرفون فلا طاعة لمن عصى الله فلا تضلوا بربكم»","صحيح","Sahih al-Jami al-Saghir 2397","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2398","إنه عرضت علي الجنة والنار فقربت مني الجنة حتى لقد تناولت منها قطفا قصرت يدي عنه وعرضت علي النار فجعلت أتأخر رهبة أن تغشاني ورأيت امرأة حميرية سوداء طويلة تعذب في هرة لها ربطتها فلم تطعمها ولم تسقها ولم تدعها تأكل من خشاش الأرض ورأيت فيها أبا ثمامة عمرو بن مالك يجر قصبه في ¤ النار وإنهم كانوا يقولون: إن الشمس والقمر لا ينكسفان إلا لموت عظيم وإنهما آيتان من آيات الله يريكموها فإذا انكسفا فصلوا حتى تنجلي","صحيح","Sahih al-Jami al-Saghir 2398","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2399","«إنه في ضحضاح من النار ولولا أنا لكان في الدرك الأسفل» - يعني أبا طالب -","صحيح","Sahih al-Jami al-Saghir 2399","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2400","«إنه قد حضر من أبيك ما ليس الله تعالى بتارك منه أحدا لموافاة يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2400","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2401","«إنه قد لعن الموصولات»","صحيح","Sahih al-Jami al-Saghir 2401","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2402","«إنه لم يقبض نبي قط حتى يرى مقعده من الجنة ثم يخير»","صحيح","Sahih al-Jami al-Saghir 2402","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2403","إنه لم يكن نبي قبلي إلا كان حقا عليه أن يدل أمته على ما يعلمه خيرا لهم وينذرهم ما يعلمه شرا لهم وإن أمتكم هذه جعل عافيتها في أولها وسيصيب آخرها بلاء شديد وأمور تنكرونها وتجيء فتن فيرفق بعضها بعضا وتجيء الفتنة فيقول ¤ المؤمن: هذه مهلكتي ثم تنكشف وتجيء الفتنة فيقول المؤمن: هذه هذه; فمن أحب منكم أن يزحزح عن النار ويدخل الجنة فلتأته منيته وهو يؤمن بالله واليوم الآخر وليأت إلى الناس الذي يحب أن يؤتى إليه ومن بايع إماما فأعطاه صفقة يده وثمرة قلبه فليطعه ما استطاع فإن جاء آخر ينازعه فاضربوا عنق الآخر","صحيح","Sahih al-Jami al-Saghir 2403","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2404","«إنه لم يمنعني أن أرد عليك إلا أني كنت أصلي»","صحيح","Sahih al-Jami al-Saghir 2404","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2405","«إنه لم يمنعني أن أرد عليك إلا أني كنت على غير وضوء»","صحيح","Sahih al-Jami al-Saghir 2405","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2406","«إنه لو حدث في الصلاة شيء لنبأتكم به ولكن إنما أنا بشر مثلكم أنسى كما تنسون فإذا نسيت فذكروني وإذا شك أحدكم في صلاته فليتحر الصواب فليتم عليه ثم ليسجد سجدتين»","صحيح","Sahih al-Jami al-Saghir 2406","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2407","«إنه ليأتي الرجل العظيم السمين يوم القيامة لا يزن عند الله جناح بعوضة»","صحيح","Sahih al-Jami al-Saghir 2407","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2408","«إنه ليس بدواء ولكنه داء» - يعني الخمر -","صحيح","Sahih al-Jami al-Saghir 2408","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2409","«إنه ليس شيء بين السماء والأرض إلا يعلم أني رسول الله إلا عاصي الجن والإنس»","حسن","Sahih al-Jami al-Saghir 2409","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2410","«إنه ليس في النوم تفريط إنما التفريط في اليقظة فإذا نسي أحدكم صلاة أو نام عنها فليصلها إذا ذكرها لوقتها من الغد»","صحيح","Sahih al-Jami al-Saghir 2410","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2411","«إنه ليس لنبي أن يدخل بيتا مزوقا»","حسن","Sahih al-Jami al-Saghir 2411","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2412","«إنه ليس لنبي أن يومض»","صحيح","Sahih al-Jami al-Saghir 2412","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2413","«إنه ليس من الناس أحد أمن علي في نفسه وماله من أبي بكر ابن أبي قحافة ولو كنت متخذا من الناس خليلا لاتخذت أبا بكر خليلا ولكن خلة الإسلام أفضل، سدوا عني كل خوخة في هذا المسجد غير خوخة أبي بكر»","صحيح","Sahih al-Jami al-Saghir 2413","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2414","«إنه ليس من فرس عربي إلا يؤذن له مع كل فجر يدعو بدعوتين يقول: اللهم إنك خولتني من خولتني من بني آدم فاجعلني من أحب أهله وماله إليه»","صحيح","Sahih al-Jami al-Saghir 2414","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2415","«إنه ليغان على قلبي وإني لأستغفر الله في اليوم مائة مرة»","صحيح","Sahih al-Jami al-Saghir 2415","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2416","«إنه ليغضب علي أن لا أجد ما أعطيه من سأل منكم وله أوقية أو عدلها فقد سأل إلحافا»","صحيح","Sahih al-Jami al-Saghir 2416","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2417","«إنه من قام مع الإمام حتى ينصرف كتب له قيام ليلة»","صحيح","Sahih al-Jami al-Saghir 2417","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2418","«إنه من لم يسأل الله تعالى يغضب عليه»","صحيح","Sahih al-Jami al-Saghir 2418","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2419","«إنه لا بد للعرس من وليمة»","صحيح","Sahih al-Jami al-Saghir 2419","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2420","إنه لا تتم صلاة أحدكم حتى يسبغ الوضوء كما أمره الله فيغسل وجهه ويديه إلى المرفقين ويمسح رأسه ورجليه إلى الكعبين ثم يكبر الله ويحمده ويمجده ويقرأ ما تيسر من القرآن مما علمه الله وأذن له فيه ثم يكبر فيركع فيضع يديه على ركبتيه ويرفع حتى تطمئن مفاصله وتسترخي ثم يقول: سمع الله لمن حمده فيستوي قائما حتى يأخذ كل عظم مأخذه ويقيم صلبه ثم يكبر فيسجد فيمكن جبهته من الأرض حتى تطمئن مفاصله وتسترخي ثم يكبر فيرفع رأسه فيستوي قاعدا على مقعدته ¤ فيقيم صلبه ثم يكبر فيسجد حتى يمكن وجهه ويسترخي لا تتم صلاة أحدكم حتى يفعل ذلك","صحيح","Sahih al-Jami al-Saghir 2420","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2421","«إنه لا قدست أمة لا يأخذ الضعيف فيها حقه غير متعتع»","صحيح","Sahih al-Jami al-Saghir 2421","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2422","«إنه لا يحبك إلا مؤمن ولا يبغضك إلا منافق» - قاله لعلي -","صحيح","Sahih al-Jami al-Saghir 2422","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2423","«إنه لا يدخل الجنة إلا نفس مسلمة وإن الله ليؤيد هذا الدين بالرجل الفاجر»","صحيح","Sahih al-Jami al-Saghir 2423","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2424","«إنه لا يدخل الجنة إلا نفس مسلمة وأيام منى أيام أكل وشرب»","صحيح","Sahih al-Jami al-Saghir 2424","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2425","«إنه لا ينبغي أن يعذب بالنار إلا رب النار»","صحيح","Sahih al-Jami al-Saghir 2425","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2426","«إنه لا ينبغي لنبي أن تكون له خائنة الأعين»","صحيح","Sahih al-Jami al-Saghir 2426","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2427","إنه يخرج من ضئضئ هذا قوم يتلون كتاب الله ¤ رطبا لا يجاوز حناجرهم يمرقون من الدين كما يمرق السهم من الرمية لئن أدركتهم لأقتلنهم قتل ثمود","صحيح","Sahih al-Jami al-Saghir 2427","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2428","«إنها حرم آمن إنها حرم آمن» - يعني المدينة -","صحيح","Sahih al-Jami al-Saghir 2428","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2429","«إنها ستكون عليكم بعدي أمراء يشغلهم أشياء عن الصلاة لوقتها حتى يذهب وقتها فصلوا الصلاة لوقتها قال رجل: إن أدركتها معهم أصلي معهم؟ قال: نعم إن شئت»","صحيح","Sahih al-Jami al-Saghir 2429","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2430","«إنها ستكون فتن ألا ثم تكون فتنة المضطجع فيها خير من الجالس والجالس فيها خير من القائم والقائم فيها خير من الماشي والماشي فيها خير من الساعي إليها ألا فإذا نزلت أو وقعت فمن كانت له إبل فليلحق بإبله ومن كانت له غنم فليلحق بغنمه ومن كانت له أرض فليلحق بأرضه ومن لم يكن له شيء من ذلك فليعمد إلى سيفه فيدق على حده بحجر ثم لينج إن استطاع النجاء اللهم هل بلغت اللهم هل بلغت»","صحيح","Sahih al-Jami al-Saghir 2430","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2431","«إنها ستكون فتنة القاعد فيها خير من القائم والقائم خير من الماشي والماشي خير من الساعي قيل: أفرأيت إن دخل علي بيتي قال: كن كابن آدم»","صحيح","Sahih al-Jami al-Saghir 2431","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2432","«إنها ستكون فتنة وفرقة واختلاف فإذا كان ذلك فائت بسيفك أحدا فاضربه حتى ينقطع ثم اجلس في بيتك حتى يأتيك يد خاطئة أو منية قاضية»","صحيح","Sahih al-Jami al-Saghir 2432","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2433","«إنها صلاة رغبة ورهبة سألت الله فيها ثلاث خصال فأعطاني اثنتين ومنعني واحدة سألته أن لا يسحتكم بعذاب أصاب من كان قبلكم فأعطانيها وسألته أن لا يسلط على بيضتكم عدوا فيجتاحها فأعطانيها وسألته أن لا يلبسكم شيعا ويذيق بعضكم بأس بعض فمنعنيها»","صحيح","Sahih al-Jami al-Saghir 2433","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2434","«إنها طيبة تنفي الرجال كما تنفي النار خبث الحديد»","صحيح","Sahih al-Jami al-Saghir 2434","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2435","«إنها لمباركة هي طعام طعم وشفاء سقم»","صحيح","Sahih al-Jami al-Saghir 2435","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2436","«إنها ليست بدواء ولكنها داء» - يعني الخمر -","صحيح","Sahih al-Jami al-Saghir 2436","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2437","«إنها ليست بنجس إنها من الطوافين عليكم والطوافات» - يعني الهرة -","صحيح","Sahih al-Jami al-Saghir 2437","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2438","«إنها مباركة إنها طعام طعم» - يعني زمزم -","صحيح","Sahih al-Jami al-Saghir 2438","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2439","«إنها لا يرمى بها لموت أحد ولا لحياته ولكن ربنا تبارك وتعالى إذا قضى أمرا سبح حملة العرش: ماذا قال ربكم؟ فيخبرونهم ماذا قال فيستخبر بعض أهل السموات بعضا حتى يبلغ الخبر هذه السماء الدنيا فيخطف الجن السمع فيقذفون إلى أوليائهم ويرمون فما جاءوا به على وجهه فهو حق ولكنهم يفرقون فيه فيزيدون»","صحيح","Sahih al-Jami al-Saghir 2439","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2440","«إنهما ليعذبان وما يعذبان في كبير أما أحدهما فكان لا يستنزه من البول وأما الآخر فكان يمشي بالنميمة»","صحيح","Sahih al-Jami al-Saghir 2440","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2441","«إنهما ليعذبان وما يعذبان في كبير أما أحدهما فيعذب في البول وأما الآخر فيعذب في الغيبة»","صحيح","Sahih al-Jami al-Saghir 2441","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2442","«إنهم كانوا يسمون بأنبيائهم والصالحين قبلهم»","صحيح","Sahih al-Jami al-Saghir 2442","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2443","«إنهم يبعثون على نياتهم»","صحيح","Sahih al-Jami al-Saghir 2443","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2444","«إنهم يخيروني بين أن يسألوني بالفحش أو يبخلوني ولست بباخل»","صحيح","Sahih al-Jami al-Saghir 2444","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2445","«إني أبرأ إلى الله أن يكون لي منكم خليل فإن الله قد اتخذني خليلا كما اتخذ إبراهيم خليلا ولو كنت متخذا من أمتي خليلا لاتخذت أبا بكر خليلا ألا وإن من كان قبلكم كانوا يتخذون قبور أنبيائهم وصالحيهم مساجد ألا فلا تتخذوا القبور مساجد إني أنهاكم عن ذلك»","صحيح","Sahih al-Jami al-Saghir 2445","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2446","«إني أحدثكم الحديث فليحدث الحاضر منكم الغائب»","صحيح","Sahih al-Jami al-Saghir 2446","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2447","«إني أحرج عليكم حق الضعيفين: اليتيم والمرأة»","حسن","Sahih al-Jami al-Saghir 2447","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2448","«إني أحرم ما بين لابتي المدينة أن يقطع عضاهها أو يقتل صيدها المدينة خير لهم لو كانوا يعلمون لا يدعها أحد رغبة عنها إلا أبدل الله فيها من هو خير منه ولا يثبت أحد على لأوائها وجهدها إلا كنت له شفيعا أو شهيدا يوم القيامة ولا يريد أحد أهل المدينة بشر إلا أذابه الله في النار ذوب الرصاص أو ذوب الملح في الماء»","صحيح","Sahih al-Jami al-Saghir 2448","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2449","«إني أرى ما لا ترون وأسمع ما لا تسمعون أطت السماء وحق لها أن تئط ما فيها موضع أربع أصابع إلا وملك واضع جبهته لله تعالى ساجدا والله لو تعلمون ما أعلم لضحكتم قليلا ولبكيتم كثيرا وما تلذذتم بالنساء على الفرش ولخرجتم إلى الصعدات تجأرون إلى الله»","حسن","Sahih al-Jami al-Saghir 2449","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2450","«إني أراك تحب الغنم والبادية فإذا كنت في غنمك أو باديتك فأذنت للصلاة فارفع صوتك بالنداء فإنه لا يسمع مدى صوت المؤذن جن ولا إنس ولا حجر ولا شيء إلا شهد له يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2450","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2451","«إني أريت ليلة القدر ثم أنسيتها فالتمسوها في العشر الأواخر في الوتر وإني رأيت أني أسجد في ماء وطين من صبيحته ا»","صحيح","Sahih al-Jami al-Saghir 2451","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2452","«إني أعطي رجالا حديثي عهد بكفر أتألفهم أما ترضون أن يذهب الناس بالأموال وترجعون إلى رحالكم برسول الله؟ فوالله لما تنقلبون به خير مما ينقلبون به إنكم سترون بعدي أثرة شديدة فاصبروا حتى تلقوا الله ورسوله فإني فرطكم على الحوض»","صحيح","Sahih al-Jami al-Saghir 2452","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2453","إني أعطي قريشا لأتألفهم لأنهم حديثو عهد ¤ بجاهلية","صحيح","Sahih al-Jami al-Saghir 2453","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2454","«إني أعطي قوما أخاف ظلعهم وجزعهم وأكل قوما إلى ما جعل الله في قلوبهم من الخير والغنى منهم عمرو بن تغلب»","صحيح","Sahih al-Jami al-Saghir 2454","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2455","«إني أوعك كما يوعك رجلان منكم»","صحيح","Sahih al-Jami al-Saghir 2455","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2456","«إني بين أيديكم فرط لكم وأنا شهيد عليكم وإن موعدكم الحوض وإني والله لأنظر إلى حوضي الآن وإني قد أعطيت مفاتيح خزائن الأرض وإني والله ما أخاف عليكم أن تشركوا بعدي ولكني أخاف عليكم الدنيا أن تنافسوا فيها»","صحيح","Sahih al-Jami al-Saghir 2456","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2457","«إني تارك فيكم خليفتين: كتاب الله حبل ممدود ما بين السماء والأرض وعترتي أهل بيتي وإنهما لن يتفرقا حتى يردا علي الحوض»","صحيح","Sahih al-Jami al-Saghir 2457","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2458","«إني تارك فيكم ما إن تمسكتم به لن تضلوا بعدي أحدهما أعظم من الآخر كتاب الله حبل ممدود من السماء إلى الأرض وعترتي أهل بيتي ولن يتفرقا حتى يردا علي الحوض فانظروا كيف تخلفوني فيهما»","صحيح","Sahih al-Jami al-Saghir 2458","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2459","«إني حدثتكم عن الدجال حتى خشيت أن لا تعقلوا إن المسيح الدجال رجل قصير أفحج جعد أعور مطموس العين ليست بناتئة ولا حجراء فإن ألبس عليكم فاعلموا أن ربكم ليس بأعور وأنكم لن تروا ربكم حتى تموتوا»","صحيح","Sahih al-Jami al-Saghir 2459","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2460","«إني حرمت ما بين لابتي المدينة كما حرم إبراهيم مكة»","صحيح","Sahih al-Jami al-Saghir 2460","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2461","«إني خرجت لأخبركم بليلة القدر وإنه تلاحى فلان وفلان فرفعت وعسى أن يكون خيرا لكم فالتمسوها في السبع والتسع والخمس»","صحيح","Sahih al-Jami al-Saghir 2461","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2462","«إني ذاكر لك أمرا ولا عليك أن لا تعجلي حتى تستأمري أبويك إن الله تعالى قال: {يَا أَيُّهَا النَّبِيُّ قُلْ لِأَزْوَاجِكَ - إلى قوله - عَظِيماً} »","صحيح","Sahih al-Jami al-Saghir 2462","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2463","«إني ذكرت وأنا في العصر شيئا من تبر كان عندنا فكرهت أن يبيت فأمرت بقسمه»","صحيح","Sahih al-Jami al-Saghir 2463","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2464","إني راكب غدا إلى يهود فمن انطلق منكم ¤ معي فلا تبدءوهم بالسلام فإن سلموا عليكم فقولوا: وعليكم","صحيح","Sahih al-Jami al-Saghir 2464","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2465","«إني رأيت في المنام كأن جبريل عند رأسي وميكائيل عند رجلي يقول أحدهما لصاحبه: اضرب له مثلا فقال: اسمع سمعت أذنك واعقل عقل قلبك إنما مثلك ومثل أمتك كمثل ملك اتخذ دارا ثم بنى فيها بيتا ثم جعل فيها مائدة ثم بعث رسولا يدعو الناس إلى طعامه فمنهم من أجاب الرسول ومنهم من تركه فالله هو الملك والدار الإسلام والبيت الجنة وأنت يا محمد رسول من أجابك دخل الإسلام ومن دخل الإسلام دخل الجنة ومن دخل الجنة أكل ما فيها»","صحيح","Sahih al-Jami al-Saghir 2465","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2466","«إني صليت صلاة رغبة ورهبة وسألت الله لأمتي ثلاثا فأعطاني اثنتين ورد علي واحدة: سألته أن لا يسلط عليهم عدوا من غيرهم فأعطانيها وسألته أن لا يهلكهم غرقا فأعطانيها وسألته أن لا يجعل بأسهم بينهم فردها علي»","صحيح","Sahih al-Jami al-Saghir 2466","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2467","«إني على الحوض حتى أنظر من يرد علي منكم وسيؤخذ أناس دوني فأقول: يا رب مني ومن أمتي! فيقال: هل شعرت ما عملوا بعدك؟ والله ما برحوا بعدك يرجعون على أعقابهم»","صحيح","Sahih al-Jami al-Saghir 2467","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2468","إني فرطكم على الحوض من مر بي شرب ومن شرب لم يظمأ أبدا وليردن علي أقوام أعرفهم ويعرفوني ¤ ثم يحال بيني وبينهم فأقول: إنهم مني فيقال: إنك لا تدري ما أحدثوا بعدك فأقول: سحقا سحقا لمن بدل بعدي","صحيح","Sahih al-Jami al-Saghir 2468","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2469","«إني فرطكم على الحوض وإن عرضه كما بين أيلة إلى الجحفة، إني لست أخشى عليكم أن تشركوا بعدي ولكن أخشى عليكم الدنيا أن تنافسوا فيها وتقتتلوا فتهلكوا كما هلك من كان قبلكم»","صحيح","Sahih al-Jami al-Saghir 2469","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2470","«إني قد اتخذت خاتما من فضة ونقشت عليه محمد رسول الله فلا ينقش أحد على نقشه»","صحيح","Sahih al-Jami al-Saghir 2470","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2471","«إني قد بدنت فإن ركعت فاركعوا وإذا رفعت فارفعوا وإذا سجدت فاسجدوا ولا ألفين رجلا سبقني إلى الركوع ولا إلى السجود»","صحيح","Sahih al-Jami al-Saghir 2471","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2472","«إني كرهت أن أذكر الله إلا على طهر»","صحيح","Sahih al-Jami al-Saghir 2472","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2473","«إني كنت أمرتكم أن تحرقوا فلانا وفلانا بالنار وإن النار لا يعذب بها إلا الله فإن أخذتموهما فاقتلوهما»","صحيح","Sahih al-Jami al-Saghir 2473","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2474","إني كنت نهيتكم: أن تأكلوا لحوم الأضاحي ¤ إلا ثلاثا فكلوا وأطعموا وادخروا ما بدا لكم وذكرت لكم: أن لا تنبذوا في الظروف: الدباء والمزفت والنقير والحنتم انتبذوا فيما رأيتم واجتنبوا كل مسكر ونهيتكم عن زيارة القبور فمن أراد أن يزور فليزر ولا تقولوا هجرا","صحيح","Sahih al-Jami al-Saghir 2474","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2475","«إني كنت نهيتكم عن زيارة القبور فزوروها لتذكركم زيارتها خيرا وكنت نهيتكم عن لحوم الأضاحي بعد ثلاث فكلوا وأمسكوا ما شئتم وكنت نهيتكم عن الأشربة في الأوعية فاشربوا في أي وعاء شئتم ولا تشربوا مسكرا»","صحيح","Sahih al-Jami al-Saghir 2475","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2476","«إني كنت نهيتكم عن لحوم الأضاحي فوق ثلاث كيما تسعكم فقد جاء الله بالخير فكلوا وتصدقوا وادخروا إن هذه الأيام أيام أكل وشرب وذكر الله»","صحيح","Sahih al-Jami al-Saghir 2476","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2477","«إني لأتوب إلى الله تعالى في اليوم سبعين مرة»","صحيح","Sahih al-Jami al-Saghir 2477","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2478","«إني لأدخل في الصلاة وأنا أريد أن أطيلها فأسمع بكاء الصبي فأتجوز في صلاتي مما أعلم من شدة وجد أمه ببكائه»","صحيح","Sahih al-Jami al-Saghir 2478","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2479","«إني لأراكم من ورائي كما أراكم»","صحيح","Sahih al-Jami al-Saghir 2479","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2480","«إني لأرجو أن أفارقكم ولا يطلبني أحد منكم بمظلمة ظلمته»","صحيح","Sahih al-Jami al-Saghir 2480","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2481","«إني لأرجو أن لا تعجز أمتي عند ربها أن يؤخرهم نصف يوم»","صحيح","Sahih al-Jami al-Saghir 2481","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2482","«إني لأرجو أن لا يدخل النار أحد إن شاء الله ممن شهد بدرا والحديبية»","صحيح","Sahih al-Jami al-Saghir 2482","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2483","«إني لأستغفر الله في اليوم سبعين مرة»","صحيح","Sahih al-Jami al-Saghir 2483","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2484","«إني لأسمع بكاء الصبي فأتجوز في الصلاة»","صحيح","Sahih al-Jami al-Saghir 2484","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2485","إني لأعرف آخر أهل النار خروجا من النار وآخر أهل الجنة دخولا الجنة رجل يؤتى به يوم القيامة فيقال: ¤ اعرضوا عليه صغار ذنوبه وارفعوا عنه كبارها فيقال له: عملت يوم كذا وكذا كذا وكذا وعملت يوم كذا وكذا كذا وكذا فيقول: نعم لا يستطيع أن ينكر وهو مشفق من كبار ذنوبه أن تعرض عليه فيقال له: فإن لك مكان كل سيئة حسنة فيقول: يا رب عملت أشياء لا أراها هاهنا","صحيح","Sahih al-Jami al-Saghir 2485","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2486","«إني لأعرف أصوات رفقة الأشعريين بالقرآن حين يدخلون بالليل وأعرف منازلهم من أصواتهم بالقرآن بالليل وإن كنت لم أر منازلهم حين نزلوا بالنهار»","صحيح","Sahih al-Jami al-Saghir 2486","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2487","«إني لأعرف حجرا بمكة كان يسلم علي قبل أن أبعث»","صحيح","Sahih al-Jami al-Saghir 2487","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2488","«إني لأعطي رجالا وأدع من هو أحب إلي منهم لا أعطيه شيئا مخافة أن يكبوا في النار على وجوههم»","صحيح","Sahih al-Jami al-Saghir 2488","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2489","«إني لأعلم آخر أهل النار خروجا منها وآخر أهل الجنة دخولا الجنة رجل يخرج من النار حبوا فيقول الله له: اذهب فادخل الجنة فيأتيها فيخيل إليه أنها ملأى فيرجع فيقول: يا رب وجدتها ملأى! فيقول الله له: أذهب فأدخل الجنة فإن لك مثل الدنيا وعشرة أمثالها فيقول: أتسخر بي وأنت الملك؟»","صحيح","Sahih al-Jami al-Saghir 2489","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2490","«إني لأعلم إذا كنت عني راضية وإذا كنت علي غضبى أما إذا كنت عني راضية فإنك تقولين: لا ورب محمد وإذا كنت علي غضبى قلت: لا ورب إبراهيم!»","صحيح","Sahih al-Jami al-Saghir 2490","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2491","«إني لأعلم كلمة لو قالها لذهب عنه ما يجد لو قال: أعوذ بالله من الشيطان الرجيم ذهب عنه ما يجد»","صحيح","Sahih al-Jami al-Saghir 2491","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2492","«إني لأعلم كلمة لا يقولها عبد عند موته إلا كانت نورا لصحيفته وإن جسده وروحه ليجدان لها روحا عند الموت»","صحيح","Sahih al-Jami al-Saghir 2492","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2493","«إني لأقوم للصلاة وأنا أريد أن أطول فيها فأسمع بكاء الصبي فأتجوز في صلاتي كراهية أن أشق على أمه»","صحيح","Sahih al-Jami al-Saghir 2493","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2494","«إني لأمزح ولا أقول إلا حقا»","صحيح","Sahih al-Jami al-Saghir 2494","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2495","«إني لأنذركموه - يعني الدجال - وما من نبي إلا قد أنذره قومه ولقد أنذره نوح قومه ولكن سأقول لكم فيه قولا لم يقله نبي لقومه: إنه أعور وإن الله ليس بأعور»","صحيح","Sahih al-Jami al-Saghir 2495","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2496","«إني لأنظر إلى شياطين الجن والإنس قد فروا من عمر»","صحيح","Sahih al-Jami al-Saghir 2496","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2497","«إني لأنقلب إلى أهلي فأجد التمرة ساقطة على فراشي فأرفعها لآكلها ثم أخشى أن تكون صدقة فألقيها»","صحيح","Sahih al-Jami al-Saghir 2497","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2498","«إني لبعقر حوضي يوم القيامة أذود الناس لأهل اليمن وأضربهم بعصاي حتى يرفض عليهم فسئل عن عرضه؟ فقال: من مقامي إلى عمان شرابه أشد بياضا من اللبن وأحلى من العسل يصب فيه ميزابان يمدانه من الجنة أحدهما من ذهب والآخر من ورق»","صحيح","Sahih al-Jami al-Saghir 2498","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2499","«إني لست مثلكم إني أبيت يطعمني ربي ويسقيني»","صحيح","Sahih al-Jami al-Saghir 2499","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2500","«إني لكم فرط على الحوض فإياي لا يأتين أحدكم فيذب عني كما يذب البعير الضال فأقول: فيم هذا؟ فيقال: إنك لا تدري ما أحدثوا بعدك فأقول: سحقا»","صحيح","Sahih al-Jami al-Saghir 2500","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2501","«إني لم أبعث لعانا»","صحيح","Sahih al-Jami al-Saghir 2501","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2502","«إني لم أبعث لعانا وإنما بعثت رحمة»","صحيح","Sahih al-Jami al-Saghir 2502","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2503","«إني لم أؤمر أن أنقب على قلوب الناس ولا أشق بطونهم»","صحيح","Sahih al-Jami al-Saghir 2503","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2504","«إني نسيت أن آمرك أن تخمر القرنين فإنه ليس ينبغي أن يكون في البيت شيء يشغل المصلي»","صحيح","Sahih al-Jami al-Saghir 2504","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2505","«إني نهيت عن زبد المشركين»","صحيح","Sahih al-Jami al-Saghir 2505","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2506","«إني نهيت عن قتل المصلين»","صحيح","Sahih al-Jami al-Saghir 2506","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2507","«إني والله إن شاء الله لا أحلف على يمين فأرى غيرها خيرا منها إلا كفرت عن يميني وأتيت الذي هو خير»","صحيح","Sahih al-Jami al-Saghir 2507","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2508","«إني والله ما قمت مقامي لأمر ينفعكم لرغبة ولا لرهبة ولكن تميما الداري أتاني فأخبرني خبرا» منعني القيلولة من الفرح وقرة العين فأحببت أن أنشر عليكم فرح نبيكم ألا إن تميما الداري أخبرني: أن الريح ألجأتهم إلى جزيرة لا يعرفونها فقعدوا في ¤ قوارب السفينة حتى خرجوا إلى الجزيرة فإذا هم بشيء أهلب كثير الشعر قالوا له: ما أنت؟ قالت: أنا الجساسة; قالوا: أخبرينا قالت: [ما أنا بمخبرتكم شيئا ولا سائلتكم شيئا] ولكن هذا الدير قد رمقتموه فأتوه فإن فيه رجلا بالأشواق إلى أن تخبروه ويخبركم فأتوه فدخلوا عليه فإذا هم بشيخ موثق شديد الوثاق [يظهر الحزن شديد التشكي] فقال لهم: من أين؟ قالوا: من الشام قال: ما فعلت العرب؟ قالوا: نحن قوم من العرب عم تسأل؟ قال: ما فعل هذا الرجل الذي خرج فيكم؟ قالوا: خيرا ناوى قوما فأظهره الله عليهم فأمرهم اليوم جميع: إلههم واحد ودينهم واحد قال: ما فعلت عين زغر؟ قالوا: خيرا يسقون منها زرعهم ويستقون منها لسقيهم قال: ما فعل نخل [بئر عمان] وبيسان؟ قالوا: يطعم ثمره كل عام قال: ما فعلت بحيرة طبرية؟ قالوا: تدفق جنباتها من كثرة الماء; [فزفر ثلاث زفرات] ثم قال: لو انفلت من وثاقي هذا لم أدع أرضا إلا وطئتها برجلي هاتين إلا طيبة ليس لي عليها سبيل [إلى هذا انتهى فرحي] هذه طيبة والذي نفسي بيده ما فيها طريق ضيق ولا واسع ولا سهل ولا جبل إلا وعليه ملك شاهر سيفه إلى يوم القيامة","صحيح","Sahih al-Jami al-Saghir 2508","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2509","«إني وإن داعبتكم فلا أقول إلا حقا»","صحيح","Sahih al-Jami al-Saghir 2509","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2510","«إني لا أخيس بالعهد ولا أحبس البرد»","صحيح","Sahih al-Jami al-Saghir 2510","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2511","«إني لا أدري ما قدر بقائي فيكم فاقتدوا باللذين من بعدي: أبي بكر وعمر وتمسكوا بهدي عمار وما حدثكم ابن مسعود فصدقوه»","صحيح","Sahih al-Jami al-Saghir 2511","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2512","«إني لا أشهد على جور»","صحيح","Sahih al-Jami al-Saghir 2512","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2513","«إني لا أصافح النساء»","صحيح","Sahih al-Jami al-Saghir 2513","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2514","«إني لا أقبل هدية مشرك»","صحيح","Sahih al-Jami al-Saghir 2514","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2515","«أنهى عن كل مسكر أسكر عن الصلاة»","صحيح","Sahih al-Jami al-Saghir 2515","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2516","«أنهاكم عن الزور»","صحيح","Sahih al-Jami al-Saghir 2516","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2517","«أنهاكم عن صيام يومين: الفطر والأضحى»","صحيح","Sahih al-Jami al-Saghir 2517","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2518","«أنهاكم عن قليل ما أسكر كثيره»","صحيح","Sahih al-Jami al-Saghir 2518","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2519","«أنهر الدم بما شئت واذكر اسم الله عليه»","صحيح","Sahih al-Jami al-Saghir 2519","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2520","«انهكوا الشوارب وأعفوا اللحى»","صحيح","Sahih al-Jami al-Saghir 2520","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2521","«اهتز عرش الرحمن لموت سعد بن معاذ»","صحيح","Sahih al-Jami al-Saghir 2521","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2522","«اهج المشركين فإن روح القدس معك» - قاله لحسان -","صحيح","Sahih al-Jami al-Saghir 2522","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2523","«اهج قريشا فإنه أشد عليهم من رشق النبل»","صحيح","Sahih al-Jami al-Saghir 2523","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2524","«أهريقوا علي من سبع قرب لم تحلل أوكيتهن لعلي أعهد إلى الناس»","صحيح","Sahih al-Jami al-Saghir 2524","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2525","«أهل الجنة: جرد مرد كحل لا يفنى شبابهم ولا تبلى ثيابهم»","حسن","Sahih al-Jami al-Saghir 2525","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2526","أهل الجنة عشرون ومائة صف ثمانون منها من هذه ¤ الأمة وأربعون من سائر الأمم","صحيح","Sahih al-Jami al-Saghir 2526","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2527","«أهل الجنة من ملأ الله تعالى أذنيه من ثناء الناس خيرا وهو يسمع وأهل النار من ملأ الله تعالى أذنيه من ثناء الناس شرا وهو يسمع»","صحيح","Sahih al-Jami al-Saghir 2527","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2528","«أهل القرآن أهل الله وخاصته»","صحيح","Sahih al-Jami al-Saghir 2528","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2529","«أهل النار كل جعظري جواظ مستكبر وأهل الجنة الضعفاء المغلوبون»","صحيح","Sahih al-Jami al-Saghir 2529","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2530","«أهل اليمن أرق قلوبا وألين أفئدة وأسمع طاعة»","حسن","Sahih al-Jami al-Saghir 2530","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2531","«أهون الربا كالذي ينكح أمه وإن أربى الربا استطالة المرء في عرض أخيه»","حسن","Sahih al-Jami al-Saghir 2531","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2532","«أهون أهل النار عذابا أبو طالب وهو منتعل بنعلين من نار يغلي منهما دماغه»","صحيح","Sahih al-Jami al-Saghir 2532","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2533","«أهون أهل النار عذابا يوم القيامة رجل يوضع في أخمص قدميه جمرتان يغلي منهما دماغه»","صحيح","Sahih al-Jami al-Saghir 2533","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2534","«أوأملك لك أن نزع الله من قلبك الرحمة» .؟","صحيح","Sahih al-Jami al-Saghir 2534","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2535","«أوإنكم تفعلون ذلك؟ لا عليكم أن لا تفعلوا ذلك فإنها ليست نسمة كتب الله أن تخرج إلا هي خارجة»","صحيح","Sahih al-Jami al-Saghir 2535","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2536","«أوتروا قبل الفجر»","صحيح","Sahih al-Jami al-Saghir 2536","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2537","«أوتروا قبل أن تصبحوا»","صحيح","Sahih al-Jami al-Saghir 2537","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2538","«أوتروا يا أهل القرآن إن الله وتر يحب الوتر»","صحيح","Sahih al-Jami al-Saghir 2538","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2539","«أوثق عرى الإيمان: الموالاة في الله والمعاداة في الله والحب في الله والبغض في الله عز وجل»","صحيح","Sahih al-Jami al-Saghir 2539","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2540","«أوجب طلحة حين صنع برسول الله صلى الله عليه وسلم ما صنع»","حسن","Sahih al-Jami al-Saghir 2540","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2541","«أوصيك أن تستحي من الله تعالى كما تستحي من الرجل الصالح من قومك»","صحيح","Sahih al-Jami al-Saghir 2541","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2542","«أوصيك أن لا تكون لعانا»","صحيح","Sahih al-Jami al-Saghir 2542","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2543","«أوصيك بتقوى الله تعالى فإنه رأس كل شيء وعليك بالجهاد فإنه رهبانية الإسلام وعليك بذكر الله تعالى وتلاوة القرآن فإنه روحك في السماء وذكرك في الأرض»","حسن","Sahih al-Jami al-Saghir 2543","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2544","«أوصيك بتقوى الله تعالى في سر أمرك وعلانيته وإذا أسأت فأحسن ولا تسألن أحدا شيئا ولا تقبض أمانة ولا تقض بين اثنين»","حسن","Sahih al-Jami al-Saghir 2544","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2545","«أوصيك بتقوى الله تعالى والتكبير على كل شرف»","حسن","Sahih al-Jami al-Saghir 2545","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2546","أوصيكم بأصحابي ثم الذين يلونهم ثم يفشو الكذب حتى يحلف الرجل ولا يستحلف ويشهد الشاهد ولا يستشهد ألا لا يخلون رجل بامرأة إلا كان ثالثهما الشيطان عليكم بالجماعة وإياكم والفرقة فإن الشيطان مع الواحد وهو مع الاثنين ¤ أبعد من أراد بحبوحة الجنة فليلزم الجماعة من سرته حسنته وساءته سيئته فذلكم المؤمن","صحيح","Sahih al-Jami al-Saghir 2546","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2547","«أوصيكم بالأنصار فإنهم كرشي وعيبتي وقد قضوا الذي عليهم وبقي الذي لهم فاقبلوا من محسنهم وتجاوزوا عن مسيئهم»","صحيح","Sahih al-Jami al-Saghir 2547","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2548","«أوصيكم بالجار»","صحيح","Sahih al-Jami al-Saghir 2548","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2549","«أوصيكم بتقوى الله والسمع والطاعة وإن أمر عليكم عبد حبشي فإنه من يعش منكم بعدي فسيري اختلافا كثيرا فعليكم بسنتي وسنة الخلفاء المهديين الراشدين تمسكوا بها وعضوا عليها بالنواجذ وإياكم ومحدثات الأمور فإن كل محدثة بدعة وكل بدعة ضلالة»","صحيح","Sahih al-Jami al-Saghir 2549","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2550","«أوف بنذرك»","صحيح","Sahih al-Jami al-Saghir 2550","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2551","«أوف بنذرك فإنه لا وفاء لنذر في معصية الله تعالى ولا فيما لا يملك ابن آدم»","صحيح","Sahih al-Jami al-Saghir 2551","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2552","«أوفي شك أنت يا ابن الخطاب؟! أولئك قوم عجلت لهم طيباتهم في الحياة الدنيا»","صحيح","Sahih al-Jami al-Saghir 2552","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2553","«أوفوا بحلف الجاهلية فإن الإسلام لم يزده إلا شدة ولا تحدثوا حلفا في الإسلام»","حسن","Sahih al-Jami al-Saghir 2553","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2554","«أوكلما نفرنا في سبيل الله تخلف أحدهم له نبيب كنبيب التيس منح إحداهن الكثبة من اللبن؟! والله لا أقدر على أحدهم إلا نكلت به»","صحيح","Sahih al-Jami al-Saghir 2554","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2555","«أولكلكم ثوبان؟»","صحيح","Sahih al-Jami al-Saghir 2555","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2556","«أولم ولو بشاة»","صحيح","Sahih al-Jami al-Saghir 2556","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2557","«أولياء الله تعالى: الذين إذا رءوا ذكر الله تعالى»","حسن","Sahih al-Jami al-Saghir 2557","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2558","«أوما علمت ما أصاب صاحب بني إسرائيل؟ كانوا إذا أصابهم شيء من البول قرضوه بالمقاريض فنهاهم صاحبهم فعذب في قبره»","صحيح","Sahih al-Jami al-Saghir 2558","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2559","«أوما علمت ما شارطت عليه ربي؟ قلت: اللهم إنما أنا بشر فأي المسلمين لعنته أو سببته فاجعله له زكاة وأجرا»","صحيح","Sahih al-Jami al-Saghir 2559","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2560","«أول الآيات طلوع الشمس من مغربها»","صحيح","Sahih al-Jami al-Saghir 2560","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2561","«أول الناس هلاكا: قريش وأول قريش هلاكا: أهل بيتي»","صحيح","Sahih al-Jami al-Saghir 2561","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2562","«أول جيش من أمتي يركبون البحر قد أوجبوا وأول جيش من أمتي يغزون مدينة قيصر مغفور لهم»","صحيح","Sahih al-Jami al-Saghir 2562","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2563","«أول خصمين يوم القيامة جاران»","حسن","Sahih al-Jami al-Saghir 2563","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2564","«أول زمرة تدخل الجنة على صورة القمر ليلة البدر والثانية على لون أحسن من كوكب دري في السماء لكل رجل منهم زوجتان على كل زوجة سبعون حلة يبدو مخ ساقها من ورائها»","صحيح","Sahih al-Jami al-Saghir 2564","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2565","أول زمرة تدخل الجنة على صورة القمر ليلة البدر والذين على أثرهم كأشد كوكب دري في السماء إضاءة قلوبهم على قلب رجل واحد لا اختلاف بينهم ولا تباغض ولا تحاسد لكل امرئ منهم زوجتان كل واحدة منهما يرى مخ سوقها من وراء ¤ لحمها من الحسن يسبحون الله بكرة وعشيا لايسقمون ولا يمتخطون ولا يبصقون آنيتهم الذهب والفضة وأمشاطهم الذهب ووقود مجامرهم الألوة","صحيح","Sahih al-Jami al-Saghir 2565","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2566","«أول زمرة تلج الجنة صورتهم على صورة القمر ليلة البدر لا يبصقون فيها ولا يمتخطون ولا يتغوطون آنيتهم فيها الذهب وأمشاطهم من الذهب والفضة ومجامرهم الألوة ورشحهم المسك ولكل واحد منهم زوجتان يرى مخ سوقها من وراء اللحم من الحسن لا اختلاف بينهم ولا تباغض قلوبهم قلب واحد يسبحون الله بكرة وعشيا»","صحيح","Sahih al-Jami al-Saghir 2566","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2567","«أول شيء يأكله أهل الجنة زيادة كبد الحوت»","صحيح","Sahih al-Jami al-Saghir 2567","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2568","«أول شيء يحشر الناس نار تحشرهم من المشرق إلى المغرب»","صحيح","Sahih al-Jami al-Saghir 2568","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2569","«أول شيء يرفع من هذه الأمة الخشوع حتى لا ترى فيها خاشعا»","صحيح","Sahih al-Jami al-Saghir 2569","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2570","«أول ما تفتقدون من دينكم الأمانة»","صحيح","Sahih al-Jami al-Saghir 2570","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2571","«أول ما يحاسب الناس به يوم القيامة من أعمالهم الصلاة يقول ربنا عز وجل لملائكته وهو أعلم: انظروا في صلاة عبدي أتمها أم نقصها؟ فإن كانت تامة كتبت له تامة وإن كان انتقص منها شيئا قال: انظروا هل لعبدي من تطوع؟ فإن كان له تطوع قال: أتموا لعبدي فريضته ثم تؤخذ الأعمال على ذاكم»","صحيح","Sahih al-Jami al-Saghir 2571","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2572","«أول ما يحاسب به العبد الصلاة وأول ما يقضى بين الناس في الدماء»","صحيح","Sahih al-Jami al-Saghir 2572","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2573","«أول ما يحاسب به العبد يوم القيامة الصلاة فإن صلحت صلح له سائر عمله وإن فسدت فسد سائر عمله»","صحيح","Sahih al-Jami al-Saghir 2573","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2574","«أول ما يحاسب به العبد يوم القيامة صلاته فإن كان أتمها كتبت له تامة وإن لم يكن أتمها قال الله لملائكته: انظروا هل تجدون لعبدي من تطوع فتكملون بها فريضته؟ ثم الزكاة كذلك ثم تؤخذ الأعمال على حسب ذلك»","صحيح","Sahih al-Jami al-Saghir 2574","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2575","«أول ما يرفع من الناس الأمانة وآخر ما يبقى من دينهم الصلاة ورب مصل لا خلاق له عند الله تعالى»","حسن","Sahih al-Jami al-Saghir 2575","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2576","«أول ما يرفع من الناس الخشوع»","صحيح","Sahih al-Jami al-Saghir 2576","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2577","«أول ما يقضى بين الناس يوم القيامة في الدماء»","صحيح","Sahih al-Jami al-Saghir 2577","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2578","«أول ما يهراق من دم الشهيد يغفر له ذنبه كله إلا الدين»","حسن","Sahih al-Jami al-Saghir 2578","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2579","«أول مسجد وضع في الأرض المسجد الحرام ثم المسجد الأقصى وبينهما أربعون سنة ثم أينما أدركتك الصلاة بعد فصل فإن الفضل فيه»","صحيح","Sahih al-Jami al-Saghir 2579","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2580","«أول من غير دين إبراهيم عمرو بن لحي بن قمعة بن خندف أبو خزاعة»","صحيح","Sahih al-Jami al-Saghir 2580","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2581","«أول من فتق لسانه بالعربية المبينة إسماعيل وهو ابن أربع عشرة سنة»","صحيح","Sahih al-Jami al-Saghir 2581","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2582","«أول من يبدل سنتي رجل من بني أمية»","حسن","Sahih al-Jami al-Saghir 2582","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2583","أول من يدعى يوم القيامة: آدم فتتراءى له ذريته فيقال: هذا أبوكم آدم فيقول: لبيك وسعديك فيقول: أخرج بعث جهنم من ذريتك: فيقول: يا رب كم أخرج؟ فيقول: أخرج من كل مائة تسعة وتسعين قالوا: يا رسول الله إذا أخذ منا من كل مائة تسعة ¤ وتسعون فماذا يبقي منا؟ قال: إن أمتي في الأمم كالشعرة البيضاء في الثور الأسود","صحيح","Sahih al-Jami al-Saghir 2583","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2584","«أول من يكسى من الخلائق إبراهيم»","صحيح","Sahih al-Jami al-Saghir 2584","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2585","«أول نبي أرسل نوح»","صحيح","Sahih al-Jami al-Saghir 2585","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2586","«أولاد المشركين خدم أهل الجنة»","صحيح","Sahih al-Jami al-Saghir 2586","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2587","«أولياء الله تعالى الذين إذا رءوا ذكر الله تعالى»","صحيح","Sahih al-Jami al-Saghir 2587","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2588","«أوليس قد جعل الله لكم ما تصدقون به؟ إن بكل تسبيحة صدقة وبكل تكبيرة صدقة وبكل تحميدة صدقة وبكل تهليلة صدقة وأمر بالمعروف صدقة ونهى عن المنكر صدقة وفي بضع أحدكم صدقة قالوا: يا رسول الله أيأتي أحدنا شهوته ويكون له فيها أجر؟ قال: أرأيتم لو وضعها في الحرام أليس كان يكون عليه وزر؟ فكذلك إذا وضعها في الحلال يكون له أجر»","صحيح","Sahih al-Jami al-Saghir 2588","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2589","«ألا أحدثكم بأشقى الناس رجلين؟ أحيمر ثمود الذي عقر الناقة والذي يضربك يا علي على هذه حتى يبل منها هذه»","صحيح","Sahih al-Jami al-Saghir 2589","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2590","«ألا أحدثكم بأمر إن أخذتم به أدركتم من قبلكم ولم يدرككم من بعدكم وكنتم خير من أنتم بين ظهرانيه إلا من عمل مثله؟ تسبحون وتحمدون وتكبرون خلف كل صلاة ثلاثا وثلاثين»","صحيح","Sahih al-Jami al-Saghir 2590","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2591","«ألا أحدثكم حديثا عن الدجال ما حدث به نبي قبلي قومه؟ إنه أعور يجيء معه تمثال الجنة والنار فالتي يقول إنها الجنة هي النار وإني أنذركم به كما أنذر به نوح قومه»","صحيح","Sahih al-Jami al-Saghir 2591","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2592","«ألا أخبرك بأخير سورة في القرآن {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ} »","صحيح","Sahih al-Jami al-Saghir 2592","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2593","«ألا أخبرك بأفضل ما تعوذ به المتعوذون: {قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ} و {قُلْ أَعُوذُ بِرَبِّ النَّاسِ} »","صحيح","Sahih al-Jami al-Saghir 2593","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2594","«ألا أخبرك بأهل النار؟ كل جعظري جواظ مستكبر جماع منوع ألا أخبرك بأهل الجنة؟ كل مسكين لو أقسم على الله تعالى لأبره»","صحيح","Sahih al-Jami al-Saghir 2594","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2595","«ألا أخبركم بأفضل من درجة الصيام والصلاة والصدقة؟ إصلاح ذات البين فإن فساد ذات البين هي الحالقة»","صحيح","Sahih al-Jami al-Saghir 2595","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2596","«ألا أخبركم بالتيس المستعار؟ هو المحل فلعن الله المحل والمحلل له»","حسن","Sahih al-Jami al-Saghir 2596","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2597","«ألا أخبركم بأمر إذا فعلتموه أدركتم من قبلكم وفتم من بعدكم؟ تحمدون الله في دبر كل صلاة وتسبحونه وتكبرونه ثلاث وثلاثين وثلاث وثلاثين وأربعا وثلاثين»","صحيح","Sahih al-Jami al-Saghir 2597","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2598","«ألا أخبركم بأهل الجنة؟ كل ضعيف متضعف لو أقسم على الله لأبره ألا أخبركم بأهل النار؟ كل عتل جواظ جعظري مستكبر»","صحيح","Sahih al-Jami al-Saghir 2598","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2599","«ألا أخبركم بخيار أمرائكم وشرارهم؟ خيارهم الذين تحبونهم ويحبونكم وتدعون لهم ويدعون لكم وشرار أمرائكم الذين تبغضونهم ويبغضونكم وتلعنونهم ويلعنونكم»","صحيح","Sahih al-Jami al-Saghir 2599","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2600","«ألا أخبركم بخير الشهداء؟ الذي يأتي بشهادته قبل أن يسألها»","صحيح","Sahih al-Jami al-Saghir 2600","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2601","ألا أخبركم بخير الناس منزلة؟ رجل ممسك بعنان فرسه في سبيل الله حتى يموت أو يقتل; ألا أخبركم بالذي يتلوه؟ رجل معتزل في شعب يقيم الصلاة ويؤتي الزكاة ويعتزل شرور ¤ الناس; ألا أخبركم بشر الناس؟ رجل يسأل بالله ولا يعطي","صحيح","Sahih al-Jami al-Saghir 2601","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2602","«ألا أخبركم بخير دور الأنصار؟ دار بني النجار ثم دار بني عبد الأشهل ثم دار بني الحارث ثم الخزرج ثم دار بني ساعدة وفي كل دور الأنصار خير»","صحيح","Sahih al-Jami al-Saghir 2602","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2603","«ألا أخبركم بخيركم من شركم؟ خيركم من يرجى خيره ويؤمن شره وشركم من لا يرجى خيره ولا يؤمن شره»","صحيح","Sahih al-Jami al-Saghir 2603","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2604","«ألا أخبركم برجالكم من أهل الجنة؟ النبي في الجنة والشهيد في الجنة والصديق في الجنة والمولود في الجنة والرجل يزور أخاه في ناحية المصر في الله في الجنة; ألا أخبركم بنسائكم من أهل الجنة؟ الودود الولود العئود التي إذا ظلمت قالت: هذه يدي في يدك لا أذوق غمضا حتى ترضى»","حسن","Sahih al-Jami al-Saghir 2604","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2605","«ألا أخبركم بشيء إذا نزل برجل منكم كرب أو بلاء من أمر الدنيا دعا به ففرج عنه؟ دعاء ذي النون: لا إله إلا أنت سبحانك إني كنت من الظالمين»","صحيح","Sahih al-Jami al-Saghir 2605","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2606","ألا أخبركم بصلاة المنافق؟ أن يؤخر العصر حتى إذا ¤ كانت الشمس كثرب البقرة صلاها","صحيح","Sahih al-Jami al-Saghir 2606","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2607","«ألا أخبركم بما هو أخوف عليكم عندي من المسيح الدجال؟ الشرك الخفي: أن يقوم الرجل فيصلي فيزين صلاته لما يرى من نظر رجل»","حسن","Sahih al-Jami al-Saghir 2607","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2608","«ألا أخبركم بما يذهب وحر الصدر؟ صوم ثلاثة أيام من كل شهر»","صحيح","Sahih al-Jami al-Saghir 2608","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2609","«ألا أخبركم بمن تحرم عليه النار غدا؟ على كل هين لين قريب سهل»","صحيح","Sahih al-Jami al-Saghir 2609","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2610","«ألا أدلك على باب من أبواب الجنة؟ لا حول ولا قوة إلا بالله»","صحيح","Sahih al-Jami al-Saghir 2610","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2611","«ألا أدلك على جهاد لا شوكة فيه؟ حج البيت»","صحيح","Sahih al-Jami al-Saghir 2611","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2612","ألا أدلك على سيد الاستغفار؟ اللهم أنت ربي لا إله إلا أنت خلقتني وأنا عبدك وأنا على عهدك ووعدك ما استطعت أعوذ بك من شر ما صنعت وأبوء لك بنعمتك علي وأعترف ¤ بذنوبي فاغفر لي ذنوبي إنه لا يغفر الذنوب إلا أنت لا يقولها أحد حين يمسي فيأتي عليه قدر قبل أن يصبح إلا وجبت له الجنة ولا يقولها حين يصبح فيأتي عليه قدر قبل أن يمسي إلا وجبت له الجنة","صحيح","Sahih al-Jami al-Saghir 2612","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2613","«ألا أدلك على غراس هو خير من هذا؟ تقول: سبحان الله والحمد لله ولا إله إلا الله والله أكبر يغرس لك بكل كلمة منها شجرة في الجنة»","صحيح","Sahih al-Jami al-Saghir 2613","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2614","«ألا أدلك على كلمة من تحت العرش من كنز الجنة؟ تقول: لا حول ولا قوة إلا بالله فيقول الله: أسلم عبدي واستسلم»","صحيح","Sahih al-Jami al-Saghir 2614","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2615","«ألا أدلك على ما هو أكثر من ذكرك الله الليل مع النهار؟ تقول: الحمد لله عدد ما خلق الحمد لله ملء ما خلق الحمد لله عدد ما في السموات وما في الأرض الحمد لله عدد ما أحصى كتابه والحمد لله على ما أحصى كتابه والحمد لله عدد كل شيء والحمد لله ملء كل شيء وتسبح الله مثلهن تعلمهن وعلمهن عقبك من بعدك»","صحيح","Sahih al-Jami al-Saghir 2615","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2616","«ألا أدلك على ما هو خير لك من خادم؟ تسبحين الله ثلاثا وثلاثين وتحمدين ثلاثا وثلاثين وتكبرين أربعا وثلاثين حين تأخذين مضجعك»","صحيح","Sahih al-Jami al-Saghir 2616","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2617","«ألا أدلكم على ما يكفر الله به من الخطايا ويزيد في الحسنات؟ إسباغ الوضوء على المكروهات وكثرة الخطا إلى المساجد وانتظار الصلاة بعد الصلاة»","صحيح","Sahih al-Jami al-Saghir 2617","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2618","«ألا أدلكم على ما يمحو الله به الخطايا ويرفع به الدرجات؟ إسباغ الوضوء على المكاره وكثرة الخطا إلى المساجد وانتظار الصلاة بعد الصلاة فذلكم الرباط فذلكم الرباط فذلكم الرباط»","صحيح","Sahih al-Jami al-Saghir 2618","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2619","«ألا أدلكما على خير مما سألتماه؟ إذا أخذتما مضاجعكما فكبرا الله أربعا وثلاثين واحمدا الله ثلاثا وثلاثين وسبحا ثلاثا وثلاثين فإن ذلك خير لكما من خادم»","صحيح","Sahih al-Jami al-Saghir 2619","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2620","«ألا أستحي من رجل تستحي منه الملائكة؟» - يعني عثمان -","صحيح","Sahih al-Jami al-Saghir 2620","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2621","«ألا أعلمك كلمات إذا قلتهن غفر الله لك وإن كنت مغفورا لك؟ قل: لا إله إلا الله العلي العظيم لا إله إلا الله الحكيم الكريم لا إله إلا الله سبحان الله رب السموات السبع ورب العرش العظيم الحمد لله رب العالمين»","صحيح","Sahih al-Jami al-Saghir 2621","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2622","«ألا أعلمك كلمات تقولها إذا أويت إلى فراشك فإن مت من ليلتك مت على الفطرة وإن أصبحت أصبحت وقد أصبت خيرا؟ تقول: اللهم أسلمت نفسي إليك ووجهت وجهي إليك وفوضت أمري رغبة ورهبة إليك وألجأت ظهري إليك لا ملجأ ولا منجا منك إلا إليك آمنت بكتابك الذي أنزلت وبنبيك الذي أرسلت»","صحيح","Sahih al-Jami al-Saghir 2622","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2623","«ألا أعلمك كلمات تقولهن عند الكرب؟ الله الله ربي لا أشرك به شيئا»","حسن","Sahih al-Jami al-Saghir 2623","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2624","«ألا أعلمك كلمات تقولينها؟ سبحان الله عدد خلقه سبحان الله عدد خلقه سبحان الله عدد خلقه سبحان الله رضا نفسه سبحان الله رضا نفسه سبحان الله رضا نفسه سبحان الله زنة عرشه سبحان الله زنة عرشه سبحان الله زنة عرشه سبحان الله مداد كلماته سبحان الله مداد كلماته سبحان الله مداد كلماته»","صحيح","Sahih al-Jami al-Saghir 2624","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2625","«ألا أعلمك كلمات لو كان عليك مثل جبل صبير دينا أداه الله عنك؟ قل: اللهم اكفني بحلالك عن حرامك وأغنني بفضلك عمن سواك»","حسن","Sahih al-Jami al-Saghir 2625","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2626","ألا أعلمكم شيئا تدركون به من سبقكم وتسبقون به من بعدكم ولا يكون أحد أفضل منكم إلا من صنع مثل ما صنعتم؟ تسبحون وتكبرون وتحمدون في دبر كل صلاة ثلاثا وثلاثين مرة","صحيح","Sahih al-Jami al-Saghir 2626","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2627","«ألا أنبئك بأهل الجنة؟ الضعفاء المغلوبون»","صحيح","Sahih al-Jami al-Saghir 2627","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2628","«ألا أنبئكم بأكبر الكبائر؟ الإشراك بالله وعقوق الوالدين وقول الزور»","صحيح","Sahih al-Jami al-Saghir 2628","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2629","«ألا أنبئكم بخير أعمالكم وأزكاها عند مليككم وأرفعها في درجاتكم وخير لكم من إنفاق الذهب والورق وخير لكم من أن تلقوا عدوكم فتضربوا أعناقهم ويضربوا أعناقكم؟ ذكر الله»","صحيح","Sahih al-Jami al-Saghir 2629","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2630","«ألا أنبئكم ما العضه؟ هي النميمة القالة بين الناس»","صحيح","Sahih al-Jami al-Saghir 2630","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2631","«ألا إن آل أبي فلان ليسوا لي بأولياء إنما وليي الله وصالح المؤمنين»","صحيح","Sahih al-Jami al-Saghir 2631","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2632","«ألا إن الفتنة هاهنا؟ من حيث يطلع قرن الشيطان»","صحيح","Sahih al-Jami al-Saghir 2632","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2633","ألا إن القوة الرمي ألا إن القوة الرمي ألا إن ¤ القوة الرمي","صحيح","Sahih al-Jami al-Saghir 2633","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2634","«ألا إن الله سيفتح لكم الأرض وستكفون المؤنة؟ فلا يعجزن أحدكم أن يلهو بأسهمه»","صحيح","Sahih al-Jami al-Saghir 2634","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2635","«ألا إني أبرأ إلى كل خل من خلته ولو كنت متخذا خليلا لاتخذت أبا بكر خليلا وإن صاحبكم خليل الله»","صحيح","Sahih al-Jami al-Saghir 2635","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2636","«ألا إن المسيح الدجال أعور العين اليمنى كأن عينه عنبة طافية وأراني الليلة عند الكعبة في المنام فإذا رجل آدم كأحسن ما ترى من أدم الرجال تضرب لمته بين منكبيه رجل الشعر يقطر رأسه ماء واضعا يديه على منكبي رجلين وهو بينهما يطوف بالبيت; فقلت: من هذا؟ فقالوا: المسيح ابن مريم ثم رأيت رجلا وراءه جعدا قططا أعور العين اليمنى كأشبه من رأيت بابن قطن واضعا يديه على منكبي رجل يطوف بالبيت فقلت: من هذا؟ فقالوا: المسيح الدجال»","صحيح","Sahih al-Jami al-Saghir 2636","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2637","ألا إن ربي أمرني أن أعلمكم ما جهلتم مما علمني يومي هذا كل مال نحلته عبدا حلال وإني خلقت عبادي حنفاء كلهم وإنهم أتتهم الشياطين فاجتالتهم عن دينهم وحرمت عليهم ما أحللت لهم وأمرتهم أن يشركوا بي ما لم أنزل به سلطانا; وإن الله نظر ¤ إلى أهل الأرض فمقتهم عربهم وعجمهم إلا بقايا من أهل الكتاب وقال: إنما بعثتك لأبتليك وأبتلي بك وأنزلت عليك كتابا لا يغسله الماء تقرؤه نائما ويقظانا وإن الله أمرني أن أحرق قريشا فقلت يا رب إذن يثلغوا رأسي فيدعوه خبزة. قال: استخرجهم كما استخرجوك واغزهم نعزك وأنفق فسننفق عليك وابعث جيشا نبعث خمسة مثله, وقاتل بمن أطاعك من عصاك وأهل الجنة ثلاثة: ذو سلطان مقسط متصدق موفق ورجل رحيم رقيق القلب لكل ذي قربى ومسلم وعفيف متعفف ذو عيال; وأهل النار خمسة: الضعيف الذي لا زبر له الذين هم فيكم تبع لا يبتغون أهلا ولا مالا والخائن الذي لا يخفى له طمع وإن دق إلا خانه ورجل لا يصبح ولا يمسي إلا وهو يخادعك عن أهلك ومالك; وذكر البخل والكذب والشنظير الفحاش","صحيح","Sahih al-Jami al-Saghir 2637","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2638","«ألا إن قتل الخطأ شبه العمد بالسوط والعصا فيه مائة من الإبل مغلظة منها أربعون خلفة في بطونها أولادها»","صحيح","Sahih al-Jami al-Saghir 2638","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2639","«ألا إن كلكم مناج ربه فلا يؤذين بعضكم بعضا ولا يرفع بعضكم على بعض في القراءة»","صحيح","Sahih al-Jami al-Saghir 2639","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2640","«ألا إنما هي أربع: لا تشركوا بالله شيئا ولا تقتلوا النفس التي حرم الله إلا بالحق ولا تزنوا ولا تسرقوا»","صحيح","Sahih al-Jami al-Saghir 2640","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2641","«ألا إن من قبلكم من أهل الكتاب افترقوا على ثنتين وسبعين ملة وإن هذه الملة ستفترق على ثلاث وسبعين ثنتان وسبعون في النار وواحدة في الجنة وهي الجماعة وإنه سيخرج من أمتي أقوام تجارى بهم تلك الأهواء كما يتجارى الكلب لصاحبه لا يبقى منه عرق ولا مفصل إلا دخله»","صحيح","Sahih al-Jami al-Saghir 2641","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2642","«ألا إنه ينصب لكل غادر لواء يوم القيامة بقدر غدرته»","صحيح","Sahih al-Jami al-Saghir 2642","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2643","«ألا إني أوتيت الكتاب ومثله معه ألا يوشك رجل شبعان على أريكته يقول: عليكم بهذا القرآن فما وجدتم فيه من حلال فأحلوه وما وجدتم فيه من حرام فحرموه ألا لا يحل لكم لحم الحمار الأهلي ولا كل ذي ناب من السبع ولا لقطة معاهد إلا أن يستغني عنها صاحبها ومن نزل بقوم فعليهم أن يقروه فإن لم يقروه فله أن يغصبهم بمثل قراه»","صحيح","Sahih al-Jami al-Saghir 2643","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2644","«ألا إني فرط لكم على الحوض وإن بعد ما بين طرفيه مثل ما بين صنعاء وأيلة كأن الأباريق فيه النجوم»","صحيح","Sahih al-Jami al-Saghir 2644","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2645","ألا تأمنوني وأنا أمين من في السماء؟ يأتيني خبر ¤ السماء صباحا ومساء","صحيح","Sahih al-Jami al-Saghir 2645","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2646","«ألا تبايعوني على أن تعبدوا الله ولا تشركوا به شيئا وأن تقيموا الصلوات الخمس وتؤتوا الزكاة وتسمعوا وتطيعوا ولا تسألوا الناس شيئا؟»","صحيح","Sahih al-Jami al-Saghir 2646","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2647","«ألا تسمعون؟ إن الله لا يعذب بدمع العين ولا بحزن القلب ولكن يعذب بهذا - وأشار إلى لسانه - أو يرحم وإن الميت يعذب ببكاء أهله عليه»","صحيح","Sahih al-Jami al-Saghir 2647","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2648","«ألا تصفون كما تصف الملائكة عند ربها؟ يتمون الصلاة بالصفوف الأول ويتراصون في الصف»","صحيح","Sahih al-Jami al-Saghir 2648","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2649","«ألا تعجبون كيف يصرف الله عني شتم قريش ولعنهم يشتمون مذمما ويلعنون مذمما وأنا محمد»","صحيح","Sahih al-Jami al-Saghir 2649","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2650","«ألا تعلمين هذه رقية النملة كما علمتيها الكتابة؟»","صحيح","Sahih al-Jami al-Saghir 2650","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2651","«ألا خمرته ولو أن تعرض عليه عودا؟»","صحيح","Sahih al-Jami al-Saghir 2651","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2652","«ألا رجل يتصدق على هذا فيصلي معه»","صحيح","Sahih al-Jami al-Saghir 2652","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2653","«ألا رجل يمنح أهل بيت ناقة تغدو بغداء وتروح بعشاء؟ إن أجرها لعظيم»","صحيح","Sahih al-Jami al-Saghir 2653","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2654","«ألا شققت عن قلبه حتى تعلم من أجل ذلك قالها أم لا؟ من لك بلا إلا الله يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2654","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2655","«ألا من ظلم معاهدا أو انتقصه حقه أو كلفه فوق طاقته أو أخذ منه شيئا بغير طيب نفس منه فأنا حجيجه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2655","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2656","«ألا هل عسى أحدكم أن يتخذ الصبة من الغنم على رأس ميل أو ميلين فيتعذر عليه الكلأ فيرتفع ثم تجيء الجمعة فلا يجيء ولا يشهدها وتجيء الجمعة فلا يشهدها وتجيء الجمعة فلا يشهدها حتى يطبع على قلبه»","حسن","Sahih al-Jami al-Saghir 2656","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2657","«ألا هل عسى رجل يبلغه الحديث عني وهو متكئ على أريكته فيقول: بيننا وبينكم كتاب الله فما وجدنا فيه حلالا استحللناه وما وجدنا فيه حراما حرمناه وإن ما حرم رسول الله كما حرم الله»","صحيح","Sahih al-Jami al-Saghir 2657","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2658","ألا لا يلومن امرؤ إلا نفسه؛ يبيت وفي يده ريح ¤ غمر","صحيح","Sahih al-Jami al-Saghir 2658","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2659","«أي إخواني لمثل هذا اليوم فأعدوا»","حسن","Sahih al-Jami al-Saghir 2659","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2660","«أيحب أحدكم إذا رجع إلى أهله أن يجد ثلاث خلفات عظام سمان؟ فثلاث آيات يقرأ بهن أحدكم في صلاته خير له من ثلاث خلفات عظام سمان»","صحيح","Sahih al-Jami al-Saghir 2660","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2661","«أيسر أحدكم أن يبصق في وجهه؟ إن أحدكم إذا استقبل القبلة فإنما يستقبل ربه عز وجل والملك عن يمينه فلا يتفل عن يمينه ولا في قبلته وليبصق عن يساره أو تحت قدمه فإن عجل به أمر فليتفل هكذا - يعني في ثوبه -»","حسن","Sahih al-Jami al-Saghir 2661","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2662","«أيعجز أحدكم أن يتقدم أو يتأخر أو عن يمينه أو عن شماله في الصلاة؟» - يعني في السبحة -","صحيح","Sahih al-Jami al-Saghir 2662","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2663","«أيعجز أحدكم أن يقرأ ثلث القرآن في ليلة؟ فإنه من قرأ {قُلْ هُوَ اللَّهُ أَحَدٌ، اللَّهُ الصَّمَدُ} في ليلة فقد قرأ ليلته ثلث القرآن»","صحيح","Sahih al-Jami al-Saghir 2663","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2664","«أيعجز أحدكم أن يقرأ في كل ليلة ثلث القرآن؟ إن الله جزأ القرآن ثلاثة أجزاء فجعل {قُلْ هُوَ اللَّهُ أَحَدٌ} جزءا من أجزاء القرآن»","صحيح","Sahih al-Jami al-Saghir 2664","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2665","«أيعجز أحدكم أن يكسب كل يوم ألف حسنة؟ يسبح الله مائة تسبيحة فيكتب الله له بها ألف حسنة ويحط عنه بها ألف خطيئة»","صحيح","Sahih al-Jami al-Saghir 2665","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2666","«أيمن امرئ وأشأمه ما بين لحييه»","صحيح","Sahih al-Jami al-Saghir 2666","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2667","«إيه يا ابن الخطاب! والذي نفسي بيده ما لقيك الشيطان قط سالكا فجا إلا سلك فجا غير فجك»","صحيح","Sahih al-Jami al-Saghir 2667","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2668","«إياك والتنعم فإن عباد الله ليسوا بالمتنعمين»","حسن","Sahih al-Jami al-Saghir 2668","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2669","«إياك والحلوب»","صحيح","Sahih al-Jami al-Saghir 2669","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2670","«إياك والسمر بعد هدأة الرجل فإنكم لا تدرون ما يأتي الله في خلقه»","حسن","Sahih al-Jami al-Saghir 2670","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2671","«إياك وكل أمر يعتذر منه»","حسن","Sahih al-Jami al-Saghir 2671","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2672","«إياكم وأبواب السلطان فإنه قد أصبح صعبا هبوطا»","صحيح","Sahih al-Jami al-Saghir 2672","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2673","«إياكم والتعريس على جواد الطريق والصلاة عليها فإنها مأوى الحيات والسباع وقضاء الحاجة عليها فإنها الملاعن»","حسن","Sahih al-Jami al-Saghir 2673","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2674","«إياكم والتمادح فإنه الذبح»","صحيح","Sahih al-Jami al-Saghir 2674","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2675","«إياكم والجلوس على الطرقات فإن أبيتم إلا المجالس فأعطوا الطريق حقها غض البصر وكف الأذى ورد السلام والأمر بالمعروف والنهي عن المنكر»","صحيح","Sahih al-Jami al-Saghir 2675","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2676","«إياكم والخذف فإنها تكسر السن وتفقأ العين ولا تنكي العدو»","صحيح","Sahih al-Jami al-Saghir 2676","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2677","«إياكم والدخول على النساء»","صحيح","Sahih al-Jami al-Saghir 2677","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2678","«إياكم والشح فإنما هلك من كان قبلكم بالشح أمرهم بالبخل فبخلوا وأمرهم بالقطيعة فقطعوا وأمرهم بالفجور ففجروا»","صحيح","Sahih al-Jami al-Saghir 2678","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2679","إياكم والظن فإن الظن أكذب الحديث ولا ¤ تجسسوا ولا تحسسوا ولا تنافسوا ولا تحاسدوا ولا تباغضوا ولا تدابروا وكونوا عباد الله إخوانا ولا يخطب الرجل على خطبة أخيه حتى ينكح أو يترك","صحيح","Sahih al-Jami al-Saghir 2679","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2680","«إياكم والغلو في الدين فإنما هلك من كان قبلكم بالغلو في الدين»","صحيح","Sahih al-Jami al-Saghir 2680","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2681","«إياكم والوصال إنكم لستم في ذلك مثلي إني أبيت يطعمني ربي ويسقيني فاكلفوا من العمل ما تطيقون»","صحيح","Sahih al-Jami al-Saghir 2681","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2682","«إياكم ودعوة المظلوم وإن كانت من كافر فإنه ليس لها حجاب دون الله عز وجل»","حسن","Sahih al-Jami al-Saghir 2682","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2683","«إياكم وسوء ذات البين فإنها الحالقة»","حسن","Sahih al-Jami al-Saghir 2683","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2684","«إياكم وكثرة الحديث عني فمن قال علي فليقل حقا أو صدقا ومن تقول علي ما لم أقل فليتبوأ مقعده من النار»","حسن","Sahih al-Jami al-Saghir 2684","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2685","«إياكم وكثرة الحلف في البيع فإنه ينفق ثم يمحق»","صحيح","Sahih al-Jami al-Saghir 2685","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2686","إياكم ومحقرات الذنوب فإنما مثل محقرات الذنوب ¤ كمثل قوم نزلوا بطن واد فجاء ذا بعود وجاء ذا بعود حتى حملوا ما أنضجوا به خبزهم وإن محقرات الذنوب متى يؤخذ بها صاحبها تهلكه","صحيح","Sahih al-Jami al-Saghir 2686","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2687","«إياكم ومحقرات الذنوب فإنهن يجتمعن على الرجل حتى يهلكنه كرجل كان بأرض فلاة فحضر صنيع القوم فجعل الرجل يجيء بالعود والرجل يجيء بالعود حتى جمعوا من ذلك سوادا وأججوا نارا فأنضجوا ما فيها»","حسن","Sahih al-Jami al-Saghir 2687","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2688","«إياكم وهاتين البقلتين المنتنتين أن تأكلوهن وتدخلوا مساجدنا فإن كنتم لا بد آكليهما فاقتلوهما بالنار قتلا»","صحيح","Sahih al-Jami al-Saghir 2688","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2689","«أيام التشريق أيام أكل وشرب وذكر الله»","صحيح","Sahih al-Jami al-Saghir 2689","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2690","«أيام منى أيام أكل وشرب»","صحيح","Sahih al-Jami al-Saghir 2690","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2691","«إياي أن تتخذوا ظهور دوابكم منابر فإن الله تعالى إنما سخرها لكم لتبلغكم إلى بلد لم تكونوا بالغيه إلا بشق الأنفس وجعل لكم الأرض فعليها فاقضوا حاجاتكم»","صحيح","Sahih al-Jami al-Saghir 2691","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2692","«إياي والفرج» - يعني في الصلاة -","صحيح","Sahih al-Jami al-Saghir 2692","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2693","«أيتكن أرادت المسجد فلا تقربن طيبا»","صحيح","Sahih al-Jami al-Saghir 2693","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2694","«أيكم خلف الخارج في أهله وماله بخير كان له مثل نصف أجر الخارج»","صحيح","Sahih al-Jami al-Saghir 2694","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2695","«أيكم كانت له أرض أو نخل فلا يبعها حتى يعرضها على شريكه»","صحيح","Sahih al-Jami al-Saghir 2695","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2696","«أيكم مال وارثه أحب إليه من ماله؟ فإن ماله ما قدم ومال وارثه ما أخر»","صحيح","Sahih al-Jami al-Saghir 2696","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2697","«أيكم يحب أن يغدو كل يوم إلى بطحان أو إلى العقيق فيأتي منه بناقتين كوماوين زهراوين في غير إثم ولا قطع رحم فلأن يغدو أحدكم إلى المسجد فيتعلم أو يقرأ آيتين من كتاب الله خير له من ناقتين وثلاث خير له من ثلاث وأربع خير له من أربع ومن أعدادهن من الإبل»","صحيح","Sahih al-Jami al-Saghir 2697","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2698","«أيما امرئ قال لأخيه: كافر فقد باء بها أحدهما إن كان كما قال وإلا رجعت إليه»","صحيح","Sahih al-Jami al-Saghir 2698","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2699","أيما امرئ مات وعنده مال امرئ بعينه ¤ اقتضى منه شيئا أو لم يقتض فهو أسوة الغرماء","صحيح","Sahih al-Jami al-Saghir 2699","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2700","«أيما امرئ مسلم أعتق امرءا مسلما فهو فكاكه من النار يجزي بكل عظم منه عظما منه وأيما امرأة مسلمة أعتقت امرأة مسلمة فهي فكاكها من النار يجزي بكل عظم منها عظما منها وأيما امرئ مسلم أعتق امرأتين مسلمتين فهما فكاكه من النار يجزي بكل عظمين منهما عظما منه»","صحيح","Sahih al-Jami al-Saghir 2700","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2701","«أيما امرأة استعطرت ثم خرجت فمرت على قوم ليجدوا ريحها فهي زانية وكل عين زانية»","حسن","Sahih al-Jami al-Saghir 2701","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2702","«أيما امرأة أصابت بخورا فلا تشهد معنا العشاء الآخرة»","صحيح","Sahih al-Jami al-Saghir 2702","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2703","«أيما امرأة تطيبت ثم خرجت إلى المسجد لم تقبل لها صلاة حتى تغتسل»","صحيح","Sahih al-Jami al-Saghir 2703","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2704","«أيما امرأة توفي عنها زوجها فتزوجت بعده فهي لآخر أزواجها»","صحيح","Sahih al-Jami al-Saghir 2704","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2705","«أيما امرأة زادت في رأسها شعرا ليس منه فإنه زور تزيد فيه»","صحيح","Sahih al-Jami al-Saghir 2705","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2706","«أيما امرأة سألت زوجها الطلاق من غير ما بأس فحرام عليها رائحة الجنة»","صحيح","Sahih al-Jami al-Saghir 2706","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2707","«أيما امرأة مات لها ثلاثة من الولد كن لها حجابا من النار»","صحيح","Sahih al-Jami al-Saghir 2707","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2708","«أيما امرأة نزعت ثيابها في غير بيتها خرق الله عز وجل عنها ستره»","صحيح","Sahih al-Jami al-Saghir 2708","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2709","«أيما امرأة نكحت بغير إذن وليها فنكاحها باطل فنكاحها باطل فنكاحها باطل فإن دخل بها فلها المهر بما استحل من فرجها فإن اشتجروا فالسلطان ولي من لا ولي له»","صحيح","Sahih al-Jami al-Saghir 2709","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2710","«أيما امرأة وضعت ثيابها في غير بيت زوجها فقد هتكت ستر ما بينها وبين الله عز وجل»","صحيح","Sahih al-Jami al-Saghir 2710","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2711","«أيما إهاب دبغ فقد طهر»","صحيح","Sahih al-Jami al-Saghir 2711","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2712","أيما داع دعا إلى ضلالة فاتبع فإن عليه مثل أوزار من ¤ اتبعه ولا ينقص من أوزارهم شيئا وأيما داع دعا إلى هدى فاتبع فإن له مثل أجور من اتبعه ولا ينقص من أجورهم شيئا","صحيح","Sahih al-Jami al-Saghir 2712","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2713","«أيما راع غش رعيته فهو في النار»","صحيح","Sahih al-Jami al-Saghir 2713","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2714","«أيما رجل آتاه الله علما فكتمه ألجمه الله يوم القيامة بلجام من نار»","صحيح","Sahih al-Jami al-Saghir 2714","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2715","«أيما رجل أعمر رجلا عمرى له ولعقبه فهي له ولمن يرثه من عقبه موروثة»","صحيح","Sahih al-Jami al-Saghir 2715","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2716","«أيما رجل أعمر عمرى لرجل له ولعقبه فإنها للذي أعطيها لا ترجع إلى الذي أعطاها»","صحيح","Sahih al-Jami al-Saghir 2716","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2717","«أيما رجل أفلس ووجد رجل سلعته عنده بعينها فهو أولى بها من غيره»","صحيح","Sahih al-Jami al-Saghir 2717","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2718","«أيما رجل أم قوما وهم له كارهون لم تجز صلاته أذنيه»","حسن","Sahih al-Jami al-Saghir 2718","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2719","أيما رجل باع سلعة فأدرك سلعته بعينها عند رجل وقد أفلس ولم يكن قبض من ثمنها شيئا فهي له وإن كان قبض ¤ من ثمنها شيئا فهي أسوة الغرماء","صحيح","Sahih al-Jami al-Saghir 2719","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2720","«أيما رجل باع متاعا فأفلس الذي ابتاعه ولم يقبض الذي باعه من ثمنه شيئا فوجد متاعه بعينه فهو أحق به وإن مات المشتري فصاحب المتاع أسوة الغرماء»","صحيح","Sahih al-Jami al-Saghir 2720","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2721","«أيما رجل خرج يفرق بين أمتي فاضربوا عنقه»","صحيح","Sahih al-Jami al-Saghir 2721","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2722","«أيما رجل ظلم شبرا من الأرض كلفه الله تعالى أن يحفره حتى يبلغ آخر سبع أرضين ثم يطوقه يوم القيامة حتى يقضى بين الناس»","صحيح","Sahih al-Jami al-Saghir 2722","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2723","«أيما رجل عاهر بحرة أو أمة فالولد ولد زنا لا يرث ولا يورث»","صحيح","Sahih al-Jami al-Saghir 2723","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2724","أيما رجل قام إلى وضوئه يريد الصلاة ثم غسل كفيه نزلت خطيئته من كفيه مع أول قطرة فإذا غسل وجهه نزلت خطيئته من سمعه وبصره مع أول قطرة فإذا غسل يديه إلى المرفقين ورجليه إلى الكعبين سلم من كل ذنب هو له ومن كل خطيئة كهيئته يوم ولدته أمه ¤ فإذا قام إلى الصلاة رفعه الله عز وجل بها درجة وإن قعد قعد سالما","صحيح","Sahih al-Jami al-Saghir 2724","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2725","«أيما رجل مس فرجه فليتوضأ وأيما امرأة مست فرجها فلتتوضأ»","صحيح","Sahih al-Jami al-Saghir 2725","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2726","«أيما رجل مسلم أعتق رجلا مسلما فإن الله تعالى جاعل وقاء كل عظم من عظامه عظما من عظام محرره من النار وأيما امرأة أعتقت امرأة مسلمة فإن الله تعالى جاعل وقاء كل عظم من عظامها عظما من عظام محررتها من النار يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2726","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2727","«أيما رجل مسلم أكفر رجلا مسلما فإن كان كافرا وإلا كان هو الكافر»","صحيح","Sahih al-Jami al-Saghir 2727","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2728","«أيما رجل من أمتي سببته سبة أو لعنته لعنة في غضبي فإنما أنا من ولد آدم أغضب كما تغضبون وإنما بعثني الله رحمة للعالمين فأجعلها عليهم صلاة يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2728","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2729","«أيما صبي حج ثم بلغ الحنث فعليه أن يحج حجة أخرى وأيما أعرابي حج ثم هاجر فعليه أن يحج حجة أخرى وأيما عبد حج ثم أعتق فعليه أن يحج حجة أخرى»","صحيح","Sahih al-Jami al-Saghir 2729","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2730","أيما ضيف نزل بقوم فأصبح الضيف محروما فله أن ¤ يأخذ بقدر قراه ولا حرج عليه","صحيح","Sahih al-Jami al-Saghir 2730","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2731","«أيما عبد أبق من مواليه فقد كفر حتى يرجع إليهم»","صحيح","Sahih al-Jami al-Saghir 2731","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2732","«أيما عبد أصاب شيئا مما نهى الله عنه ثم أقيم عليه حده كفر الله ذلك الذنب»","صحيح","Sahih al-Jami al-Saghir 2732","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2733","«أيما عبد تزوج بغير إذن أهله فهو عاهر»","صحيح","Sahih al-Jami al-Saghir 2733","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2734","«أيما عبد تزوج بغير إذن مواليه فهو زان»","حسن","Sahih al-Jami al-Saghir 2734","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2735","«أيما عبد كاتب على مائة أوقية فأداها إلا عشرة أواق فهو عبد وأيما عبد كاتب على مائة دينار فأداها إلا عشرة دنانير فهو عبد»","حسن","Sahih al-Jami al-Saghir 2735","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2736","«أيما عبد مات في إباقه دخل النار وإن كان قتل في سبيل الله تعالى»","حسن","Sahih al-Jami al-Saghir 2736","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2737","«أيما قرية أتيتموها وأقمتم فيها فسهمكم فيها وأيما قرية عصت الله ورسوله فإن خمسها لله ولرسوله ثم هي لكم»","صحيح","Sahih al-Jami al-Saghir 2737","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2738","«أيما قوم جلسوا فأطالوا الجلوس ثم تفرقوا قبل أن يذكروا الله تعالى أو يصلوا على نبيه كانت عليهم ترة من الله إن شاء عذبهم وإن شاء غفر لهم»","صحيح","Sahih al-Jami al-Saghir 2738","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2739","«أيما مسلم رمى بسهم في سبيل الله فبلغ مخطئا أو مصيبا فله من الأجر كرقبة أعتقها من ولد إسماعيل وأيما رجل شاب في سبيل الله فهو له نور وأيما رجل أعتق رجلا مسلما فكل عضو من المعتق بعضو من المعتق فداء له من النار وأيما رجل قام وهو يريد الصلاة فأفضى الوضوء إلى أماكنه سلم من كل ذنب وخطيئة هي له فإن قام إلى الصلاة رفعه الله تعالى بها درجة وإن رقد رقد سالما»","صحيح","Sahih al-Jami al-Saghir 2739","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2740","«أيما مسلم شهد له أربعة بخير أدخله الله الجنة أو ثلاثة أو اثنان»","صحيح","Sahih al-Jami al-Saghir 2740","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2741","«أيما مسلمين التقيا فأخذ أحدهما بيد صاحبه فتصافحا وحمدا الله تعالى جميعا تفرقا وليس بينهما خطيئة»","صحيح","Sahih al-Jami al-Saghir 2741","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2742","«أيها الناس اتقوا الله وأجملوا في الطلب فإن نفسا لن تموت حتى تستوفي رزقها وإن أبطأ عنها فاتقوا الله وأجملوا في الطلب خذوا ما حل ودعوا ما حرم»","صحيح","Sahih al-Jami al-Saghir 2742","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2743","أيها الناس إذا كان هذا اليوم فاغتسلوا ¤ وليمس أحدكم أفضل ما يجد من دهنه وطيبه","حسن","Sahih al-Jami al-Saghir 2743","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2744","«أيها الناس إن الله طيب لا يقبل إلا طيبا وإن الله أمر المؤمنين بما أمر به المرسلين فقال: {يَا أَيُّهَا الرُّسُلُ كُلُوا مِنَ الطَّيِّبَاتِ وَاعْمَلُوا صَالِحاً إِنِّي بِمَا تَعْمَلُونَ عَلِيمٌ} وقال: {يَا أَيُّهَا الَّذِينَ آمَنُوا كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ} . ثم ذكر الرجل يطيل السفر أشعث أغبر يمد يديه إلى السماء: يا رب يا رب! ومطعمه حرام ومشربه حرام وملبسه حرام وغذي بالحرام فأنى يستجاب لذلك»","حسن","Sahih al-Jami al-Saghir 2744","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2745","«أيها الناس إنه قد كان لي فيكم إخوة وأصدقاء وإني أبرأ إلى الله أن يكون لي فيكم خليل ولو كنت متخذا من أمتي خليلا لاتخذت أبا بكر خليلا وإن ربي اتخذني خليلا كما اتخذ إبراهيم خليلا ألا إن من كان قبلكم كانوا يتخذون قبور أنبيائهم وصالحيهم مساجد ألا فلا تتخذوا القبور مساجد إني أنهاكم عن ذلك»","صحيح","Sahih al-Jami al-Saghir 2745","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2746","«أيها الناس إنه لم يبق من مبشرات النبوة إلا الرؤيا الصالحة يراها المسلم أو ترى له ألا وإني نهيت أن أقرأ القرآن راكعا أو ساجدا فأما الركوع فعظموا فيه الرب وأما السجود فاجتهدوا في الدعاء فقمن أن يستجاب لكم»","صحيح","Sahih al-Jami al-Saghir 2746","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2747","«أيها الناس عليكم بالقصد عليكم بالقصد فإن الله تعالى لا يمل حتى تملوا»","صحيح","Sahih al-Jami al-Saghir 2747","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2748","«أيها الناس قد تركت فيكم ما إن أخذتم به لن تضلوا: كتاب الله وعترتي أهل بيتي»","صحيح","Sahih al-Jami al-Saghir 2748","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2749","«أيها الناس ما زال بكم صنيعكم حتى ظننت أن سيكتب عليكم فعليكم بالصلاة في بيوتكم فإن خير صلاة المرء في بيته إلا الصلاة المكتوبة»","صحيح","Sahih al-Jami al-Saghir 2749","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2750","«أيها الناس لا تتمنوا لقاء العدو واسألوا الله العافية فإذا لقيتموهم فاصبروا واعلموا أن الجنة تحت ظلال السيوف اللهم منزل الكتاب ومجري السحاب وهازم الأحزاب اهزمهم وانصرنا عليهم»","صحيح","Sahih al-Jami al-Saghir 2750","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2751","«الآخذ والمعطي سواء في الربا»","صحيح","Sahih al-Jami al-Saghir 2751","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2752","«الآن حمي الوطيس»","صحيح","Sahih al-Jami al-Saghir 2752","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2753","«الآن حين بردت عليه جلده»","حسن","Sahih al-Jami al-Saghir 2753","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2754","«الآن نغزوهم ولا يغزونا»","صحيح","Sahih al-Jami al-Saghir 2754","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2755","«الآيات خرزات منظومات في سلك فانقطع السلك فيتبع بعضها بعضا»","صحيح","Sahih al-Jami al-Saghir 2755","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2756","«الآيتان من آخر سورة البقرة من قرأهما في ليلة كفتاه»","صحيح","Sahih al-Jami al-Saghir 2756","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2757","الأئمة من قريش أبرارها أمراء أبرارها وفجارها أمراء فجارها وإن أمرت عليكم قريش عبدا حبشيا مجدعا فاسمعوا له وأطيعوا ما لم يخير أحدكم بين إسلامه وضرب عنقه فإن خير بين ¤ إسلامه وضرب عنقه فليقدم عنقه","صحيح","Sahih al-Jami al-Saghir 2757","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2758","«الأئمة من قريش ولهم عليكم حق ولكم مثل ذلك ما إن استرحموا رحموا وإن استحكموا عدلوا وإن عاهدوا وفوا فمن لم يفعل ذلك منهم فعليه لعنة الله والملائكة والناس أجمعين لا يقبل منه صرف ولا عدل»","صحيح","Sahih al-Jami al-Saghir 2758","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2759","«الأبعد فالأبعد من المسجد أعظم أجرا»","صحيح","Sahih al-Jami al-Saghir 2759","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2760","«الإبل عز لأهلها والغنم بركة والخير معقود في نواصي الخيل إلى يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2760","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2761","«الإثمد يجلو البصر وينبت الشعر»","صحيح","Sahih al-Jami al-Saghir 2761","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2762","«الإحسان أن تعبد الله كأنك تراه فإن لم تكن تراه فإنه يراك»","صحيح","Sahih al-Jami al-Saghir 2762","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2763","«الأخوات الأربع ميمونة وأم الفضل وسلمى وأسماء بنت عميس أختهن لأمهن مؤمنات»","صحيح","Sahih al-Jami al-Saghir 2763","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2764","«الأذان تسع عشرة كلمة والإقامة سبع عشرة كلمة»","صحيح","Sahih al-Jami al-Saghir 2764","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2765","«الأذنان من الرأس»","صحيح","Sahih al-Jami al-Saghir 2765","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2766","«الأرض أرض الله والعباد عباد الله من أحيا مواتا فهي له»","حسن","Sahih al-Jami al-Saghir 2766","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2767","«الأرض كلها مسجد إلا المقبرة والحمام»","صحيح","Sahih al-Jami al-Saghir 2767","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2768","«الأرواح جنود مجندة فما تعارف منها ائتلف وما تناكر منها اختلف»","صحيح","Sahih al-Jami al-Saghir 2768","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2769","«الإزار إلى نصف الساق أو إلى الكعبين لا خير في أسفل من ذلك»","صحيح","Sahih al-Jami al-Saghir 2769","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2770","«الإسبال في الإزار والقميص والعمامة من جر منها شيئا خيلاء لم ينظر الله إليه يوم القيامة»","صحيح","Sahih al-Jami al-Saghir 2770","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2771","«الاستئذان ثلاث فإن أذن لك وإلا فارجع»","صحيح","Sahih al-Jami al-Saghir 2771","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2772","«الاستجمار توٌّ ورمي الجمار توّ والسعي بين الصفا والمروة توٌّ والطواف توٌّ وإذا استجمر أحدكم فليستجمر بتوٍّ»","صحيح","Sahih al-Jami al-Saghir 2772","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2773","«الاستنجاء بثلاثة أحجار ليس فيهن رجيع»","حسن","Sahih al-Jami al-Saghir 2773","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2774","«الإسلام: إقام الصلاة وإيتاء الزكاة وحج البيت وصوم شهر رمضان والاغتسال من الجنابة»","صحيح","Sahih al-Jami al-Saghir 2774","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2775","«الإسلام أن تشهد أن لا إله إلا الله وأن محمدا رسول الله وتقيم الصلاة وتؤتي الزكاة وتصوم رمضان وتحج البيت إن استطعت إليه سبيلا»","صحيح","Sahih al-Jami al-Saghir 2775","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2776","«الإسلام أن تعبد الله ولا تشرك به شيئا وتقيم الصلاة وتؤدي الزكاة المفروضة وتصوم رمضان وتحج البيت»","صحيح","Sahih al-Jami al-Saghir 2776","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2777","«الإسلام يجب ما كان قبله»","صحيح","Sahih al-Jami al-Saghir 2777","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2778","«الإسلام يعلو ولا يعلى»","حسن","Sahih al-Jami al-Saghir 2778","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2779","«الأسنان سواء الثنية والضرس سواء»","صحيح","Sahih al-Jami al-Saghir 2779","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2780","«الأسنان سواء خمسا خمسا»","صحيح","Sahih al-Jami al-Saghir 2780","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2781","«الأشرة شر»","حسن","Sahih al-Jami al-Saghir 2781","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2782","«الأصابع سواء عشر عشر من الإبل»","صحيح","Sahih al-Jami al-Saghir 2782","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2783","«الأصابع سواء كلهن فيهن عشر من الإبل»","صحيح","Sahih al-Jami al-Saghir 2783","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2784","«الأصابع سواء والأسنان سواء الثنية والضرس سواء هذه وهذه سواء» - يعني الإبهام والخنصر -","صحيح","Sahih al-Jami al-Saghir 2784","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2785","«الأكثرون هم الأسفلون يوم القيامة إلا من قال بالمال هكذا وهكذا وكسبه من طيب»","حسن","Sahih al-Jami al-Saghir 2785","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2786","«الإمام ضامن فإن أحسن فله ولهم وإن أساء فعليه ولا عليهم»","صحيح","Sahih al-Jami al-Saghir 2786","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2787","«الإمام ضامن والمؤذن مؤتمن اللهم أرشد الأئمة واغفر للمؤذنين»","صحيح","Sahih al-Jami al-Saghir 2787","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2788","«الأمراء من قريش ما عملوا فيكم بثلاث: ما رحموا إذا استرحموا وأقسطوا إذا قسموا وعدلوا إذا حكموا»","صحيح","Sahih al-Jami al-Saghir 2788","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2789","«الأمر أسرع من ذاك»","صحيح","Sahih al-Jami al-Saghir 2789","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2790","«الأنبياء أحياء في قبورهم يصلون»","صحيح","Sahih al-Jami al-Saghir 2790","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2791","«الأنصار شعار والناس دثار ولو أن الناس استقبلوا واديا أو شعبا واستقبلت الأنصار واديا لسلكت وادي الأنصار ولولا الهجرة لكنت امرءا من الأنصار»","صحيح","Sahih al-Jami al-Saghir 2791","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2792","«الأنصار كرشي وعيبتي وإن الناس سيكثرون وهم يقلون فاقبلوا من محسنهم وتجاوزوا عن مسيئهم»","صحيح","Sahih al-Jami al-Saghir 2792","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2793","«الأنصار ومزينة وجهينة وغفار وأشجع ومن كان من بني عبد الدار موالي دون الناس والله ورسوله مولاهم»","صحيح","Sahih al-Jami al-Saghir 2793","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2794","«الأيدي ثلاثة فيد الله العليا ويد المعطي التي تليها ويد السائل السفلى فأعط الفضل ولا تعجز عن نفسك»","صحيح","Sahih al-Jami al-Saghir 2794","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2795","«الإيمان: الصبر والسماحة»","صحيح","Sahih al-Jami al-Saghir 2795","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2796","«الإيمان: أن تؤمن بالله وملائكته وكتابه وبلقائه وبرسله وتؤمن بالبعث الآخر»","صحيح","Sahih al-Jami al-Saghir 2796","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2797","«الإيمان: أن تؤمن بالله وملائكته وكتبه ورسله واليوم الآخر وتؤمن بالقدر خيره وشره»","صحيح","Sahih al-Jami al-Saghir 2797","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2798","«الإيمان: أن تؤمن بالله وملائكته وكتبه ورسله وتؤمن بالجنة والنار والميزان وتؤمن بالبعث بعد الموت وتؤمن بالقدر خيره وشره»","صحيح","Sahih al-Jami al-Saghir 2798","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2799","[الإيمان بضع وسبعون بابا فأدناها إماطة الأذى عن الطريق وأرفعها قول: لا إله إلا الله]","صحيح","Sahih al-Jami al-Saghir 2799","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2800","«الإيمان بضع وسبعون شعبة فأفضلها قول: لا إله إلا الله وأدناها إماطة الأذى عن الطريق والحياء شعبة من الإيمان»","صحيح","Sahih al-Jami al-Saghir 2800","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2801","«الإيمان بضع وستون شعبة والحياء: شعبة من الإيمان»","صحيح","Sahih al-Jami al-Saghir 2801","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2802","«الإيمان قيد الفتك لا يفتك مؤمن»","صحيح","Sahih al-Jami al-Saghir 2802","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2803","«الإيمان يمان»","صحيح","Sahih al-Jami al-Saghir 2803","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2804","«الإيمان يمان ألا إن القسوة وغلظ القلوب في الفدادين عند أصول أذناب الإبل حيث يطلع قرنا الشيطان في ربيعة ومضر»","صحيح","Sahih al-Jami al-Saghir 2804","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2805","«الإيمان يمان والفتنة هاهنا وهاهنا يطلع قرن الشيطان»","حسن","Sahih al-Jami al-Saghir 2805","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2806","الإيمان يمان والكفر قبل المشرق والسكينة لأهل الغنم والفخر والرياء في الفدادين أهل الخيل وأهل الوبر ¤ يأتي المسيح إذا جاء دبر أحد صرفت الملائكة وجهه قبل الشام وهنالك يهلك","صحيح","Sahih al-Jami al-Saghir 2806","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2807","«الأيمن فالأيمن»","صحيح","Sahih al-Jami al-Saghir 2807","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2808","«الأيمنون الأيمنون الأيمنون»","صحيح","Sahih al-Jami al-Saghir 2808","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
"2809","«الأيم أحق بنفسها من وليها والبكر تستأذن في نفسها وإذنها صماتها»","صحيح","Sahih al-Jami al-Saghir 2809","","","الأحاديث المبدوءة بحرف الألف Hadith Beginning with the Letter Alif (أ)"
