hadiths[1002]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"20041","(۲۰۰۴۱) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ کَانَ یَقُولُ : إذَا غَابَ عَنْک لَیْلَۃً ، وَإِنْ وَجَدْت سَہْمَک فِیہِ مِنَ الْغَدِ فَعَرَفْتہ ، فَلاَ تَأْکُلْ۔","","Musannaf Ibn Abi Shaybah 20041","","","كتاب الصيد"
"20042","(۲۰۰۴۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا رَمَیْت الصَّیْدَ فَغَابَ عَنْک لَیْلَۃً فَمَاتَ فَوَجَدْت سَہْمَک فِیہِ فَلاَ تَأْکُلْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20042","","","كتاب الصيد"
"20043","(۲۰۰۴۳) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : سَأَلَہُ رَجُلٌ ، فَقَالَ : إنِّی أَرْمِی الصَّیْدَ فَیَغِیبُ عَنِّی ، ثُمَّ أَجِدُہُ بَعْدَ ذَلِکَ ، فَقَالَ لَہُ : سَعِیدٌ : إِنْ وَجَدْتہ وَلَیْسَ فِیہِ إِلاَّ سَہْمُک فَکُلْ ، وَإِنْ لاَ فَلاَ تَأْکُلْ۔","No Data Available","Musannaf Ibn Abi Shaybah 20043","","","كتاب الصيد"
"20044","(۲۰۰۴۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، أَنَّ عَدِیَّ بْنَ حَاتِمٍ ، قَالَ : یَا رَسُولَ اللہِ ، أَحَدُنَا یَرْمِی الصَّیْدَ فَیَقْتَفِی أَثَرَہُ الْیَوْمَیْنِ وَالثَّلاَثَۃَ ، ثُمَّ یَجِدُہُ مَیِّتًا وفِیہِ سَہْمُہُ أَیَأْکُلُ ؟ قَالَ : نَعَمْ ، إِنْ شَائَ ، أَوَ قَالَ : یَأْکُلُ إِنْ شَائَ۔ (بخاری ۵۴۸۴۔ مسلم ۱۵۳۱)","","Musannaf Ibn Abi Shaybah 20044","","","كتاب الصيد"
"20045","(۲۰۰۴۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ مَیْسَرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الصَّیْدِ أَرْمِیہ فَأَطْلُبُ الأَثَرَ بَعْدَ لَیْلِۃٍ؟ قَالَ : إذَا وَجَدْت سَہْمَک فِیہِ، وَلَمْ یَأْکُلْ مِنْہُ سَبُعٌ فَکُلْ۔ (ترمذی ۱۴۶۸۔ احمد ۴/۳۷۷)","Sahih","Musannaf Ibn Abi Shaybah 20045","","","كتاب الصيد"
"20046","(۲۰۰۴۶) حَدَّثَنَا أَبُو الأَحْوَص ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ مُرَّۃَ ، عَنْ مَسْرُوقٍ ، قَالَ : قَالَ عَبْدُ اللہِ : إذَا رَمَیْت طَیْرًا فَوَقَعَ فِی المَائِ فَلاَ تَأْکُلْ ، فَإِنِّی أَخَافُ ، أَنَّ الْمَائَ قَتَلَہُ ، وَإِنْ رَمَیْت صَیْدًا وَہُوَ عَلَی جَبَلٍ فَتَرَدَّی فَلاَ تَأْکُلْہُ فَإِنِّی أَخَافُ ، أَنَّ التَّرَدِّی الذی أَہْلَکَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20046","","","كتاب الصيد"
"20047","(۲۰۰۴۷) حَدَّثَنَا عبدۃ بن سلیمان ، عن عاصم ، عن الحسن : مثلہ۔","","Musannaf Ibn Abi Shaybah 20047","","","كتاب الصيد"
"20048","(۲۰۰۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرٍ ؛ فِی الرَّجُلِ یَرْمِی الصَّیْدَ فَیَغِیبُ عَنْہُ ، قَالَ : إِنْ وَجَدْتہ لَمْ یَقَعْ فِی المَائِ ، وَلَمْ یَقَعْ مِنْ جَبَلٍ ، وَلَمْ یَأْکُلْ مِنْہُ سَبُعٌ فَکُلْ۔","No Data Available","Musannaf Ibn Abi Shaybah 20048","","","كتاب الصيد"
"20049","(۲۰۰۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ فِی دَجَاجَۃٍ ذُبِحَتْ فَوَقَعَتْ فِی مَائٍ فَکَرِہَ أَکْلَہَا۔","","Musannaf Ibn Abi Shaybah 20049","","","كتاب الصيد"
"20050","(۲۰۰۵۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ أَشْعَثَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا رَمَیْتہ فَوَقَعَ فِی مَائٍ فَلاَ تَأْکُلْہُ ، وَإِذَا رَمَیْتہ فَتَرَدَّی مِنْ جَبَلٍ فَلاَ تَأْکُلْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20050","","","كتاب الصيد"
"20051","(۲۰۰۵۱) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : إذَا وَقَعَ فِی مَائٍ فَلاَ تَأْکُلْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20051","","","كتاب الصيد"
"20052","(۲۰۰۵۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : إذَا رَمَیْت الصَّیْدَ فَوَقَعَ فِی مَائٍ فَلاَ تَأْکُلْ ، وَإِنْ تَرَدَّی مِنْ جَبَلٍ فَلاَ تَأْکُلْ۔","","Musannaf Ibn Abi Shaybah 20052","","","كتاب الصيد"
"20053","(۲۰۰۵۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : إِنْ وَجَدْتہ لَمْ یَتَرَدَّ مِنْ جَبَلٍ ، وَلَمْ یُجَاوِزْ مَائً فَلْتَأْکُلْہُ۔","","Musannaf Ibn Abi Shaybah 20053","","","كتاب الصيد"
"20054","(۲۰۰۵۴) حَدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنْ أُسَامَۃَ ، عَنِ الْقَاسِمِ ؛ فِی رَجُلٍ رَمَی صَیْدًا عَلَی شَاہِقٍ فَتَرَدَّی حَتَّی وَقَعَ عَلَی الأَرْضِ وَہُوَ مَیِّتٌ ، قَالَ : إِنْ کَانَ یَعْلَمُ أَنَّہُ مَاتَ مِنْ رَمْیَتِہِ أَکَلَ ، وَإِنْ کان شَکَّ أَنَّہُ مَاتَ مِنَ التَّرَدِّی لَمْ یَأْکُلْ۔","","Musannaf Ibn Abi Shaybah 20054","","","كتاب الصيد"
"20055","(۲۰۰۵۵) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَعْمَشِ ، عَنْ زَیْدِ بْنِ وَہْبٍ ، قَالَ : سُئِلَ ابْنُ مَسْعُودٍ ، عَنْ رَجُلٍ ضَرَبَ رِجْلَ حِمَارٍ وَحْشٍ فَقَطَعَہَا ، فَقَالَ : دَعُوا مَا سَقَطَ وَذَکُّوا مَا بَقِیَ فَکُلُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20055","","","كتاب الصيد"
"20056","(۲۰۰۵۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا ضَرَبَ الصَّیْدَ فَبَانَ عُضْوٌ لَمْ یَأْکُلْ مَا أَبَانَ وَأَکَلَ مَا بَقِیَ۔","Da'if","Musannaf Ibn Abi Shaybah 20056","","","كتاب الصيد"
"20057","(۲۰۰۵۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الأَعْمَشِ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : إذَا ضَرَبَ الرَّجُلُ الصَّیْدَ فَبَانَ عُضْوٌ مِنْہُ تَرَکَ مَا سَقَطَ وَأَکَلَ مَا بَقِیَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20057","","","كتاب الصيد"
"20058","(۲۰۰۵۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : یَدَعُ مَا أَبَانَ وَیَأْکُلُ مَا بَقِیَ ، فَإِنْ جَزَلَہُ جَزْلاً فَلْیَأْکُلْہ۔","Da'if","Musannaf Ibn Abi Shaybah 20058","","","كتاب الصيد"
"20059","(۲۰۰۵۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنْ حَجَّاجٍ، عَنِ ابْنِ أَبِی نَجِیحٍ، عَنْ مُجَاہِدٍ، وَعَنْ حَجَّاجٍ ، عَنْ عَطَائٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 20059","","","كتاب الصيد"
"20060","(۲۰۰۶۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا أَبَانَ مِنْہُ عُضْوًا تَرَکَ مَا أَبَانَ وَذَکَّی مَا بَقِیَ ، وَإِنْ جَزَلَہُ بِاثْنَیْنِ أَکَلَہُ۔","","Musannaf Ibn Abi Shaybah 20060","","","كتاب الصيد"
"20061","(۲۰۰۶۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی رَجُلٍ ضَرَبَ صَیْدًا فَأَبَانَ مِنْہُ یَدًا ، أَوْ رِجْلاً وَہُوَ حَیٌّ ، ثُمَّ مَاتَ، قَالَ: یَأْکُلُہُ، وَلاَ یَأْکُلُ مَا بَانَ مِنْہُ إِلاَّ أَنْ یَضْرِبَہُ فَیَقْطَعَہُ فَیَمُوتَ مِنْ سَاعَتہ فَإِذَا کَانَ ذَلِکَ فَلْیَأْکُلْہُ کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 20061","","","كتاب الصيد"
"20062","(۲۰۰۶۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یَضْرِبُ الصَّیْدَ بِالشَّیْئِ فَیَبِینُ مِنْہُ الشَّیئُ وَیَتَحَامَلُ مَا کَانَ فِیہِ الرَّأْسُ ، قَالَ : لاَ یَأْکُلُ مَا بَانَ مِنْہُ ، وَإِنْ وَقَعَا جَمِیعًا أَکَلَہُ۔","","Musannaf Ibn Abi Shaybah 20062","","","كتاب الصيد"
"20063","(۲۰۰۶۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، وَعَطَائٍ ، قَالاَ : إذَا ضَرَبَ الصَّیْدَ فَسَقَطَ عَنْہُ عُضْوٌ فَلاَ یَأْکُلہ یعْنِی الْعُضْوَ۔","","Musannaf Ibn Abi Shaybah 20063","","","كتاب الصيد"
"20064","(۲۰۰۶۴) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ حُصَیْنٍ بن عبد الرحمن ، عن مَسْرُوق سُئِلَ عَنْ صَیْدِ الْمَنَاجِلِ ، قَالَ : إِنَّہَا تَقْطَعُ مِنَ الظِّبَائِ وَالْحُمُرِ فَیَبِینُ مِنْہُ الشَّیئُ وَہُوَ حَیٌّ ، فَقَالَ ابْنُ عُمَرَ : مَا أَبَانَ مِنْہُ وَہُوَ حَیٌّ فَدَعْہُ وَکُلْ مَا سِوَی ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 20064","","","كتاب الصيد"
"20065","(۲۰۰۶۵) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ قَالَ فِی الْمَنَاجِلِ الَّتِی تُوضَعُ فَتَمُرُّ بِہَا فَتَقْطَعُ مِنْہَا ، قَالَ : لاَ تَأْکُلْ۔","No Data Available","Musannaf Ibn Abi Shaybah 20065","","","كتاب الصيد"
"20066","(۲۰۰۶۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا وَقَعَ الصَّیْدُ فِی الْحِبَالَۃِ ، فَکَانَ فِیہَا حَدِیدَۃٌ فَأَصَابَ الصَّیْدُ الْحَدِیدَۃَ فَکُلْ ، وَإِنْ لَمْ تُصِبہ الْحَدِیدَۃَ ، فَإِنْ لَمْ تُدْرِکْ ذَکَاتَہُ فَلاَ تَأْکُلْ۔","","Musannaf Ibn Abi Shaybah 20066","","","كتاب الصيد"
"20067","(۲۰۰۶۷) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، أَنَّہُ کَرِہَ صَیْدَ الْمَنَاجِلِ ، وَقَالَ سَالِمٌ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20067","","","كتاب الصيد"
"20068","(۲۰۰۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ صَیْدِ الْمِعْرَاضِ ، فَقَالَ : مَا أَصَبْت بِحَدِّہِ فَکُلْ وَمَا أَصَبْت بِعَرْضِہِ فَہُوَ وَقِیذٌ۔n(بخاری ۵۴۷۵۔ مسلم ۱۵۲۹)","Sahih","Musannaf Ibn Abi Shaybah 20068","","","كتاب الصيد"
"20069","(۲۰۰۶۹) حَدَّثَنَا أَبُو بَکْرٍ ، قَالَ أَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، قَالَ : حدَّثَنَا مُجَالِدٌ ، عَنِ الشَّعْبِیِّ ، عَنْ عَدِیِّ بْنِ حَاتِمٍ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، إنَّا قَوْمٌ نَرْمِی بِالْمِعْرَاضِ فَمَا یَحِلُّ لَنَا ؟ قَالَ : لاَ تَأْکُلْ مَا أَصَبْت بِالْمِعْرَاضِ إِلاَّ مَا ذَکَّیْت۔ (احمد ۲۵۷۔ طبرانی ۱۶۲)","Da'if","Musannaf Ibn Abi Shaybah 20069","","","كتاب الصيد"
"20070","(۲۰۰۷۰) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ حُذَیْفَۃَ ، أَنَّہُ کَانَ یَأْکُلُ مَا قَتَلَ الْمِعْرَاض۔","","Musannaf Ibn Abi Shaybah 20070","","","كتاب الصيد"
"20071","(۲۰۰۷۱) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، وَعَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : قَالَ سَلْمَان : مَا خَزَقَ الْمِعْرَاضُ فَکُلْ۔","Da'if","Musannaf Ibn Abi Shaybah 20071","","","كتاب الصيد"
"20072","(۲۰۰۷۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَأْکُلْ مَا أَصَابَ الْمِعْرَاضُ إِلاَّ أَنْ یَخْزِقَ۔","Da'if","Musannaf Ibn Abi Shaybah 20072","","","كتاب الصيد"
"20073","(۲۰۰۷۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ مِثْلَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 20073","","","كتاب الصيد"
"20074","(۲۰۰۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : حدَّثَنَا مَکْحُولٌ ، أَنَّ رَجُلاً أَتَی فَضَالَۃَ بْنَ عُبَیْدٍ صَاحِبَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِعَصَافِیرَ صَادَہُنَّ بِمِعْرَاضٍ فَمِنْہَا مَا جَعَلَہُ فِی مِخْلاَتِہِ وَمِنْہَا مَا جَعَلَہُ فِی خَیْطٍ ، فَقَالَ : ہَذَا مَا صِدْتُ بِمِعْرَاضٍ ، مِنْہَا مَا أَدْرَکْت ذَکَاتَہُ ، وَمِنْہَا مَا لَمْ أُدْرِکْ ذَکَاتَہُ ، فَقَالَ : مَا أَدْرَکْت ذَکَاتَہُ فَکُلْ ، وَمَا لَمْ تُدْرِکْ ذَکَاتَہُ فَلاَ تَأْکُلْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 20074","","","كتاب الصيد"
"20075","(۲۰۰۷۵) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللہِ ، عَنْ مَکْحُولٍ ، أَنَّ فَضَالَۃَ بْنَ عُبَیْدٍ وَأَبَا مُسْلِمٍ الْخَوْلاَنِیَّ کَانَا یَأْکُلاَنِ مَا قَتَلَ الْمِعْرَاضُ۔","Da'if","Musannaf Ibn Abi Shaybah 20075","","","كتاب الصيد"
"20076","(۲۰۰۷۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ عُبَیْدِ بْنِ سَعْدٍ ، أَنَّ رَجُلاً رَمَی أَرْنَبًا بِعَصًا فَکَسَرَ قَوَائِمَہَا ، ثُمَّ ذَبَحَہَا فَأَکَلَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 20076","","","كتاب الصيد"
"20077","(۲۰۰۷۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْف ، فَقَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ ، عَنِ الْمِعْرَاضِ ، فَقَالَ : لَمْ یَکُنْ مِنْ نُبَالِ الْمُسْلِمِینَ فَلاَ تَأْکُلْ مِنْہُ شَیْئًا إِلاَّ شَیْئًا قَدْ خُزِقَ۔","","Musannaf Ibn Abi Shaybah 20077","","","كتاب الصيد"
"20078","(۲۰۰۷۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرٍ ، قَالَ : سَأَلْتُہُ عَنِ الْمِعْرَاضِ ، فَقَالَ : إذَا کُنت أَصَبْت بِحَدِّہِ فَخَزَقَ کَمَا یَخْزِقُ السَّہْمُ فَکُلْ ، فَإِنْ أَصَابَہُ بِعَرْضِہِ فَلاَ تَأْکُلْ إِلاَّ أَنْ تُذْکِیَہُ۔","","Musannaf Ibn Abi Shaybah 20078","","","كتاب الصيد"
"20079","(۲۰۰۷۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ سَعِیدٍ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِمَا أُصِیبَ بِالْمِعْرَاضِ۔","","Musannaf Ibn Abi Shaybah 20079","","","كتاب الصيد"
"20080","(۲۰۰۸۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ تَأْکُلْ مَا أَصَابَ الْمِعْرَاضُ إِلاَّ أَنْ یَخْزِقَ۔","","Musannaf Ibn Abi Shaybah 20080","","","كتاب الصيد"
"20081","(۲۰۰۸۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ ، قَالَ: لاَ تَأْکُلْ مَا أَصَابَ الْمِعْرَاضُ إِلاَّ أَنْ یَخْزِقَ۔","","Musannaf Ibn Abi Shaybah 20081","","","كتاب الصيد"
"20082","(۲۰۰۸۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ مَا أ??صَابَ الْمِعْرَاضُ إِلاَّ مَا خَزَقَ۔","","Musannaf Ibn Abi Shaybah 20082","","","كتاب الصيد"
"20083","(۲۰۰۸۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ الْقَاسِمِ وَسَالِمٍ أَنَّہُمَا کَانَا یَکْرَہَانِ الْمِعْرَاضَ إِلاَّ مَا أَدْرَکْت ذَکَاتَہُ۔","","Musannaf Ibn Abi Shaybah 20083","","","كتاب الصيد"
"20084","(۲۰۰۸۴) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ مُغِیرَۃَ بْنِ زِیَادٍ ، عَنْ مَکْحُولٍ ، قَالَ: أَمَّا الْمِعْرَاضُ فَقَدْ کَانَ نَاسٌ یَکْرَہُونَہُ، قَالَ : ہُوَ مَوْقُوذَۃٌ وَلَکِنْ إذَا خَزَقَ۔","","Musannaf Ibn Abi Shaybah 20084","","","كتاب الصيد"
"20085","(۲۰۰۸۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ لاَ یَأْکُلُ مَا أَصَابَتِ الْبُنْدُقَۃُ وَالْحَجَرُ وَالْمِعْرَاضُ۔","Sahih","Musannaf Ibn Abi Shaybah 20085","","","كتاب الصيد"
"20086","(۲۰۰۸۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو عن سَعِیدٍ ، قَالَ : قَالَ عَمَّارٌ : إذَا رَمَیْت بِالْحَجَرِ ، أَوِ الْبُنْدُقَۃِ وَذَکَرْت اسْمَ اللہِ فَکُلْ ، وَإِنْ قَتَلَ۔","Sahih","Musannaf Ibn Abi Shaybah 20086","","","كتاب الصيد"
"20087","(۲۰۰۸۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ لاَ یَأْکُلُ مَا أَصَابَتِ الْبُنْدُقَۃُ وَالْحَجَرُ۔","Sahih","Musannaf Ibn Abi Shaybah 20087","","","كتاب الصيد"
"20088","(۲۰۰۸۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنِ الْقَاسِمِ وَسَالِمٍ أَنَّہُمَا کَانَا یَکْرَہَانِ الْبُنْدُقَۃَ إِلاَّ مَا أُدْرِکْت ذَکَاتَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20088","","","كتاب الصيد"
"20089","(۲۰۰۸۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عِیسَی بْنِ الْمُغِیرَۃِ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ عَنِ الْمِعْرَاضِ وَالْبُنْدُقَۃِ ، فَقَالَ : ذَلِکَ مَا یُفْتِی بِہِ أَہْلُ الشَّامِ ، وَإِذَا ہُوَ لاَ یَرَاہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20089","","","كتاب الصيد"
"20090","(۲۰۰۹۰) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تَأْکُلْ مَا أَصَبْت بِالْبُنْدُقَۃِ ، إِلاَّ أَنْ تُذَکِّیَ۔","","Musannaf Ibn Abi Shaybah 20090","","","كتاب الصيد"
"20091","(۲۰۰۹۱) حَدَّثَنَا حَفْصٌ ، عَنْ لیث ، عن مجاہد ، قَالَ : ما أصبت بالبندقۃ أو بالحجر فلا تأکل إلا أن تذکی۔","","Musannaf Ibn Abi Shaybah 20091","","","كتاب الصيد"
"20092","(۲۰۰۹۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : مَا رَدَّ عَلَیْک حَجَرُک فَکُلْ ، وَکَانَ عِکْرِمَۃُ یَکْرَہُہُ وَیَقُولُ : ہُوَ مَوْقُوذَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 20092","","","كتاب الصيد"
"20093","(۲۰۰۹۳) حَدَّثَنَا ابْنُ مُبَارَک ، عَنْ مَعْمَرٍ ، عَنِ ابن أبی نجیح ، عن مجاہد : أنہ کرہہ۔","","Musannaf Ibn Abi Shaybah 20093","","","كتاب الصيد"
"20094","(۲۰۰۹۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ حَرْمَلَۃَ ، قَالَ : کُلُ وَحْشِیَّۃٍ أَصَبْتہَا بِعَصًا ، أَوْ بِحَجَرٍ ، أَوْ بِبُنْدُقَۃٍ وَذَکَرْت اسْمَ اللہِ عَلَیْہِ فکلہا۔","","Musannaf Ibn Abi Shaybah 20094","","","كتاب الصيد"
"20095","(۲۰۰۹۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَتَلَ الْحَجَرُ فَلاَ تَأْکُلْ۔","No Data Available","Musannaf Ibn Abi Shaybah 20095","","","كتاب الصيد"
"20096","(۲۰۰۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ تَأْکُلْ مِنْ صَیْدِ الْبُنْدُقَۃِ إِلاَّ مَا ذَکَّیْت۔","No Data Available","Musannaf Ibn Abi Shaybah 20096","","","كتاب الصيد"
"20097","(۲۰۰۹۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا رَمَی الرَّجُلُ الصَّیْدَ بِالْحَجَرِ ، وبالجُلاَّہِقۃ فَلاَ تَأْکُلْہُ إِلاَّ أَنْ تُدْرِکَ ذَکَاتَہُ۔","","Musannaf Ibn Abi Shaybah 20097","","","كتاب الصيد"
"20098","(۲۰۰۹۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جابر ، عَنْ مَکْحُولٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْجَرَادُ وَالنُّونُ ذَکِیٌّ کُلُّہُ فَکُلُوہُ۔","","Musannaf Ibn Abi Shaybah 20098","","","كتاب الصيد"
"20099","(۲۰۰۹۹) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : قَالَ عُمَرُ : الْحِیتَانُ ذَکِیٌّ کُلُّہَا وَالْجَرَادُ ذَکِیٌّ کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 20099","","","كتاب الصيد"
"20100","(۲۰۱۰۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عَلِیٌّ : الْجَرَادُ وَالْحِیتَانُ ذَکِیٌّ کُلُّہُ ، إِلاَّ مَا مَاتَ فِی الْبَحْرِ ، فَإِنَّہُ مَیْتَۃٌ۔","","Musannaf Ibn Abi Shaybah 20100","","","كتاب الصيد"
"20101","(۲۰۱۰۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی بَکْرِ بْنِ حَفْصٍ ، قَالَ : قَالَ عَبْدُ اللہِ : ذَکَاۃُ الْحُوتِ فَکُّ لَحْیَیْہِ۔","","Musannaf Ibn Abi Shaybah 20101","","","كتاب الصيد"
"20102","(۲۰۱۰۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : ذَکَاۃُ الْحُوتِ أَخْذُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20102","","","كتاب الصيد"
"20103","(۲۰۱۰۳) حَدَّثَنَا وَکِیعٌ، عَنْ إسْرَائِیلَ، عَنْ عَبْدِ الأَعْلَی، عَنِ ابْنِ الْحَنَفِیَّۃِ، قَالَ: ذَکَاۃُ الْحُوتِ أَخْذُہُ وَالْجَرَادُ ذَکِیٌّ۔","No Data Available","Musannaf Ibn Abi Shaybah 20103","","","كتاب الصيد"
"20104","(۲۰۱۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : مَا مَاتَ فِیہِ فَطَفَا فَلاَ تَأْکُلْ۔","Sahih","Musannaf Ibn Abi Shaybah 20104","","","كتاب الصيد"
"20105","(۲۰۱۰۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ وَعَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عن سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّہُمَا کَرِہَا الطَّافِیَ مِنَ السَّمَکِ۔","","Musannaf Ibn Abi Shaybah 20105","","","كتاب الصيد"
"20106","(۲۰۱۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانَ لاَ یَکْرَہُ مِنَ السَّمَکِ شَیْئًا إِلاَّ الطَّافِیَ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20106","","","كتاب الصيد"
"20107","(۲۰۱۰۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عن عمرو ، عن أبی الشعثاء قَالَ : یکرہ الطافی منہ ، وکل ما جزرہ۔","","Musannaf Ibn Abi Shaybah 20107","","","كتاب الصيد"
"20108","(۲۰۱۰۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الأَجْلَحِ ، عَنْ عَبْدِ اللہِ بْن أَبِی الْہُذَیْلِ ، قَالَ : سَأَلَ رَجُلٌ ابْنَ عَبَّاسٍ ، فَقَالَ : إنِّی آتِی الْبَحْرَ فَأَجِدُہُ قَدْ جَفَلَ سَمَکًا کَثِیرًا ، فَقَالَ : کُلْ مَا لَمْ تَرَ سَمَکًا طَافِیًا۔","Sahih","Musannaf Ibn Abi Shaybah 20108","","","كتاب الصيد"
"20109","(۲۰۱۰۹) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ عَلِیٌّ : مَا مَاتَ فِی الْبَحْرِ ، فَإِنَّہُ مَیْتَۃٌ۔","","Musannaf Ibn Abi Shaybah 20109","","","كتاب الصيد"
"20110","(۲۰۱۱۰) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ مِنَ السَّمَکِ مَا یَمُوتُ فِی الْمَائِ إِلاَّ أَنْ یَتَّخِذَ الرَّجُلُ حَظِیرَۃً فَمَا دَخَلَ فِیہَا فَمَاتَ فَلَمْ یَرَ بِأَکْلِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20110","","","كتاب الصيد"
"20111","(۲۰۱۱۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ فِی الْحُوتِ یُوجَدُ فِی الْبَحْرِ مَیِّتًا فَنَہَی عَنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20111","","","كتاب الصيد"
"20112","(۲۰۱۱۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ کَرِہَ الطَّافِیَ مِنْہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20112","","","كتاب الصيد"
"20113","(۲۰۱۱۳) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ الطَّافِیَ۔","","Musannaf Ibn Abi Shaybah 20113","","","كتاب الصيد"
"20114","(۲۰۱۱۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدِ الْحَذَّائِ ، عَنْ مُعَاوِیَۃَ بْنِ قُرَّۃَ ، أَنَّ أَبَا أَیُّوبَ وَجَدَ سَمَکَۃً طَافِیَۃً فَأَکَلَہَا۔","Sahih","Musannaf Ibn Abi Shaybah 20114","","","كتاب الصيد"
"20115","(۲۰۱۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی بَشِیرٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ قَالَ : أَشْہَدُ عَلَی أَبِی بَکْرٍ ، أَنَّہُ قَالَ : السَّمَکَۃُ الطَّافِیَۃُ عَلَی الْمَائِ حَلاَلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20115","","","كتاب الصيد"
"20116","(۲۰۱۱۶) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ عُمَرَ أَنَّہُ لَمْ یَکُنْ یَرَی بِالسَّمَکِ الطَّافِی بَأْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 20116","","","كتاب الصيد"
"20117","(۲۰۱۱۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : بَعَثَنَا النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَعَ أَبِی عُبَیْدَۃَ فِی سَرِیَّۃٍ فَنَفِذَ زَادُنَا فَمَرَرْت بِحُوتٍ قَدْ قَذَفَہُ الْبَحْرُ فَأَرَدْنَا أَنْ نَأْکُلَ مِنْہُ فَنَہَانَا أَبُو عُبَیْدَۃَ ، ثُمَّ قَالَ : نَحْنُ رُسُلُ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَفِی سَبِیلِ اللہِ تبارک وتعالی کُلُوا فَأَکَلْنَا ، قَالَ : فَلَمَّا قَدِمْنَا عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ذَکَرْنَا ذَلِکَ ، فَقَالَ : إِنْ کَانَ بَقِیَ مَعَکُمْ مِنْہُ شَیْئٌ فَابْعَثُوا بِہِ إلَیَّ۔n(بخاری ۲۴۸۳۔ مسلم ۱۷)","Sahih","Musannaf Ibn Abi Shaybah 20117","","","كتاب الصيد"
"20118","(۲۰۱۱۸) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ الْخُدْرِیِّ فِی السَّمَکِ یَجْزُرُ عَنْہُ الْمَائُ ، قَالَ : کُلْ۔","Da'if","Musannaf Ibn Abi Shaybah 20118","","","كتاب الصيد"
"20119","(۲۰۱۱۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عن عمرو ، عن أبی الشعثاء قَالَ : کل ما جزر عنہ۔","","Musannaf Ibn Abi Shaybah 20119","","","كتاب الصيد"
"20120","(۲۰۱۲۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : مَا جَزَرَ عَنْہُ ضَفِیرُ الْبَحْرِ فَکُلْ۔","Sahih","Musannaf Ibn Abi Shaybah 20120","","","كتاب الصيد"
"20121","(۲۰۱۲۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْقَاسِمِ بْنِ رَبِیعَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ، قَالَ : مَا قَذَفَ الْبَحْرُ فَہُوَ حَلاَلٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20121","","","كتاب الصيد"
"20122","(۲۰۱۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزِّنَادِ ، عن الأعرج عَنْ أَبِی سَلَمَۃَ ، عَنْ زَیْدٍ ، وَأَبِی ہُرَیْرَۃَ ، قَالاَ : لاَ بَأْسَ بِمَا قَذَفَ الْبَحْرُ۔","Sahih","Musannaf Ibn Abi Shaybah 20122","","","كتاب الصيد"
"20123","(۲۰۱۲۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ أَنَّہُمَا قَالاَ : إذَا نَضَبَ عَنْہُ الْمَائُ ، ثُمَّ مَاتَ فَلاَ یَرَیَانِ بِأَکْلِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20123","","","كتاب الصيد"
"20124","(۲۰۱۲۴) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ شَہْرِ بْنِ حَوْشَبَ ، عَنْ أَبِی أَیُّوبَ فِی قَوْلِہِ : {مَتَاعًا لَکُمْ وَلِلسَّیَّارَۃِ} قَالَ: مَا لَفَظَ الْبَحْرُ ، وَإِنْ کَانَ مَیْتًا۔","Da'if","Musannaf Ibn Abi Shaybah 20124","","","كتاب الصيد"
"20125","(۲۰۱۲۵) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ حُمَیْدِ بْنِ صَخْرٍ ، عَنْ مُحَمَّدِ بْنِ کَعْبِ الْقُرَظِیِّ ، عَنِ ابْنِ عَبَّاسٍ فِی قَوْلِہِ : {أحِلَّ لَکُمْ صَیْدُ الْبَحْرِ وَطَعَامُہُ} مَا أَلْقَی الْبَحْرُ عَلَی ظَہْرِہِ مَیِّتًا۔","Hasan","Musannaf Ibn Abi Shaybah 20125","","","كتاب الصيد"
"20126","(۲۰۱۲۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَا لَفَظَ عَلَی ظَہْرِہِ مَیِّتًا فَہُوَ طَعَامُہُ۔","Hasan","Musannaf Ibn Abi Shaybah 20126","","","كتاب الصيد"
"20127","(۲۰۱۲۷) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ شَہْرٍ ، عَنْ أَبِی أَیُّوبَ ، قَالَ : مَا لَفَظَ الْبَحْرُ فَہُوَ طَعَامُہُ ، وَإِنْ کَانَ مَیْتًا۔","Da'if","Musannaf Ibn Abi Shaybah 20127","","","كتاب الصيد"
"20128","(۲۰۱۲۸) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی الشَّعْثَائَ ، قَالَ : مَا کُنَّا نَتَحَدَّثُ إِلاَّ أَنَّ طَعَامَہُ مَالِحُہ۔","","Musannaf Ibn Abi Shaybah 20128","","","كتاب الصيد"
"20129","(۲۰۱۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی مِجْلَزٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : طَعَامُہُ مَا قَذَفَ۔","Sahih","Musannaf Ibn Abi Shaybah 20129","","","كتاب الصيد"
"20130","(۲۰۱۳۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا قَذَفَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20130","","","كتاب الصيد"
"20131","(۲۰۱۳۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَرْمَلَۃَ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ سُئِلَ عَنْ صَیْدِ الْبَحْرِ وَطَعَامِہِ ، قَالَ : طَعَامُہُ مَا لَفَظَ وَہُوَ حَیٌّ۔","","Musannaf Ibn Abi Shaybah 20131","","","كتاب الصيد"
"20132","(۲۰۱۳۲) حَدَّثَنَا حَمَّادُ بْنُ أَبِی خَالِدٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنْ سَعْدِ الْجَارِی ، قَالَ : سَأَلْتُ ابْنَ عُمَرَ ، وَابْنَ عَمْرٍو ، عَنِ الْحِیتَانِ تَمُوتُ صَرْدًا ، أَوْ یَقْتُلُ بَعْضُہَا بَعْضًا ، قَالاَ : حَلاَلٌ۔","Hasan","Musannaf Ibn Abi Shaybah 20132","","","كتاب الصيد"
"20133","(۲۰۱۳۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَکْرَہُ الْحُوتَ الَّتِی قَتَلَتْہَا الْحُوتُ۔","","Musannaf Ibn Abi Shaybah 20133","","","كتاب الصيد"
"20134","(۲۰۱۳۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ مَالِکٍ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنْ سَعْدٍ الْجَارِی ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، قَالَ : لاَ بَأْسَ بِہَا۔","Hasan","Musannaf Ibn Abi Shaybah 20134","","","كتاب الصيد"
"20135","(۲۰۱۳۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، قَالَ : سُئِلَ عَبْدُ اللہِ بْنُ عُبَیْدِ بْنِ عُمَیْرٍ ، عَنْ رَجُلٍ رَمَی بِشِصِّہ فَأَخَذَ سَمَکَۃٌ ، فَجَائَتْ سَمَکَۃٌ أُخْرَی فَضَرَبَتْہَا ، فَذَہَبَتْ بِنِصْفِہَا ، قَالَ : یَأْکُلُ مَا بَقِیَ۔","","Musannaf Ibn Abi Shaybah 20135","","","كتاب الصيد"
"20136","(۲۰۱۳۶) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، قَالَ : قُلْتُ لِبُرْدٍ: الرَّجُلُ یَکُونُ عَلَی الرَّحْلِ فَیَطْعَن الْحِمَارَ وَیَذْکُرُ اسْمَ اللہِ، أَوْ یَضْرِبُہُ بِالسَّیْفِ فَذَکَرَ ، عَنْ مَکْحُولٍ ، أَنَّہُ قَالَ : إذَا ذَکَرَ اسْمَ اللہِ حِینَ یَضْرِبُ ، أَوْ یَطْعَنُ فَلَیْسَ بِہِ بَأْسٌ۔","","Musannaf Ibn Abi Shaybah 20136","","","كتاب الصيد"
"20137","(۲۰۱۳۷) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ طَعَنَ صَیْدًا بِرُمْحِہِ وَسَمَّی ، قَالَ : یَأْکُلُہُ۔","","Musannaf Ibn Abi Shaybah 20137","","","كتاب الصيد"
"20138","(۲۰۱۳۸) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنْ یَحْیَی بْنِ یَعْمُرَ ، قَالَ : لاَ یَأْکُلُ مَا یَطْعَن بِہِ فِی الْحَلْقِ ، ثُمَّ یَقْطَعُ العروق ، قَالَ : ذَلِکَ لَیْسَ بِذَبْحٍ وَلَکِنَّہُ الْقَتْلُ۔","","Musannaf Ibn Abi Shaybah 20138","","","كتاب الصيد"
"20139","(۲۰۱۳۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ سِمَاکٍ ، قَالَ : کَانَ الظَّبْیُ یَمُرُّ بِہِمْ فَیَضْرِبُونَہُ بِأَسْیَافِہِمْ فَیَقْطَعُ ہَذَا الْیَدَ وَہَذَا الرِّجْلَ فَسَمِعْت مُصْعَبًا بن الزبیر یَخْطُبُ وَیَنْہَی عَنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 20139","","","كتاب الصيد"
"20140","(۲۰۱۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ صَیْدَ الْکَلْبِ الأَسْوَدِ الْبَہِیمِ۔","","Musannaf Ibn Abi Shaybah 20140","","","كتاب الصيد"
"20141","(۲۰۱۴۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرَ ، عَنْ إبْرَاہِیمَ أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20141","","","كتاب الصيد"
"20142","(۲۰۱۴۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، أَنَّہُ کَانَ یَکْرَہُ صَیْدَ الْکَلْبِ الأَسْوَدِ وَیَقُولُ : أُمِرَ بِقَتْلِہِ فَکَیْفَ یُؤْکَلُ صَیْدُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20142","","","كتاب الصيد"
"20143","(۲۰۱۴۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، أَنَّہُ کَرِہَ صَیْدَ الْکَلْبِ الأَسْوَدِ الْبَہِیمِ۔","","Musannaf Ibn Abi Shaybah 20143","","","كتاب الصيد"
"20144","(۲۰۱۴۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ خَالِدٍ، عَنْ عِکْرِمَۃَ، قَالَ: قَالَ ابْنُ عَبَّاسٍ: مَا أَعْجَزَک مِمَّا فِی یَدِکَ فَہُوَ بِمَنْزِلَۃِ الصَّیْدِ۔","Sahih","Musannaf Ibn Abi Shaybah 20144","","","كتاب الصيد"
"20145","(۲۰۱۴۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : إذَا نَدَّ مِنَ الإِبِلِ وَالْبَقَرِ شَیْئٌ فَاصْنَعُوا بِہِ کَمَا تَصْنَعُونَ بِالْوَحْشِ۔","","Musannaf Ibn Abi Shaybah 20145","","","كتاب الصيد"
"20146","(۲۰۱۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ ، عَنِ الضَّحَّاکِ فِی بَقَرَۃٍ شَرَدَتْ ، قَالَ : ہِیَ بِمَنْزِلَۃِ الصَّیْدِ۔","","Musannaf Ibn Abi Shaybah 20146","","","كتاب الصيد"
"20147","(۲۰۱۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبٍ ، أَنَّ بَعِیرًا نَدَّ فَطَعَنَہُ رَجُلٌ بِالرُّمْحِ فَسُئِلَ عَلِیٌّ عَنْہُ ، فَقَالَ : کُلْہُ وَاہْدِ لِی عَجُزہ۔","","Musannaf Ibn Abi Shaybah 20147","","","كتاب الصيد"
"20148","(۲۰۱۴۸) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ أَنَّہُمَا قَالاَ : إذَا تَوَحَّشَ الْبَعِیرُ أو الْبَقَرَۃُ صُنِعَ بِہِمَا مَا یُصْنَعُ بِالْوَحْشِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 20148","","","كتاب الصيد"
"20149","(۲۰۱۴۹) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَعَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالاَ : ہُوَ بِمَنْزِلَۃِ الصَّیْدِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20149","","","كتاب الصيد"
"20150","(۲۰۱۵۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ زِیَادٍ ابْنِ أَبِی مَرْیَمَ ، أَنَّ حِمَارًا وَحْشِیًّا اسْتَعْصَی عَلَی أَہْلِہِ فَضَرَبُوا عُنُقَہُ فَسُئِلَ ابْنُ مَسْعُودٍ ، فَقَالَ : تِلْکَ أَسْرَعُ الذَّکَاۃِ۔","","Musannaf Ibn Abi Shaybah 20150","","","كتاب الصيد"
"20151","(۲۰۱۵۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : کَانَ حِمَارُ وَحْشٍ فِی دَارِ عَبْدِ اللہِ فَضَرَبَ رَجُلٌ عُنُقَہُ بِالسَّیْفِ وَذَکَرَ اسْمَ اللہِ عَلَیْہِ ، فَقَالَ ابْنُ مَسْعُودٍ : صَیْدٌ فَکُلُوہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20151","","","كتاب الصيد"
"20152","(۲۰۱۵۲) حَدَّثَنَا عَبِیْدَۃُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ بِمِثْلِہِ ، أَوْ نَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 20152","","","كتاب الصيد"
"20153","(۲۰۱۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، أَنَّ حِمَارًا لأَہْلِ عَبْدِ اللہِ ضَرَبَ رَجُلٌ عُنُقَہُ بِالسَّیْفِ فَسُئِلَ عَبْدُ اللہِ ، فَقَالَ : کُلُوہُ ، إنَّمَا ہُوَ صَیْدٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20153","","","كتاب الصيد"
"20154","(۲۰۱۵۴) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، أَنَّ ثَوْرًا حَرِبَ فِی بَعْضِ دُورِ الْمَدِینَۃِ ، فَضَرَبَہُ رَجُلٌ بِالسَّیْفِ ، وَذَکَرَ اسْمَ اللہِ فَسُئِلَ عَنْہُ ، فَقَالَ : ذَکَاۃٌ وَحِیَّۃٌ ، وَأَمَرَہُمْ بِأَکْلِہِ۔","","Musannaf Ibn Abi Shaybah 20154","","","كتاب الصيد"
"20155","(۲۰۱۵۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ سُفْیَانَ ، عَنْ أَبِیہِ ، عَنْ عَبَایَۃَ بْنِ رِفَاعَۃَ ، عَنْ جَدِّہِ رَافِعِ بْنِ خَدِیجٍ، قَالَ : کُنَّا مَعَ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَنَدَّ بَعِیرٌ فَضَرَبَہُ رَجُلٌ بِالسَّیْفِ فَذُکِرَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، فَقَالَ : إنَّ ہَذِہِ الْبَہَائِمَ لَہَا أَوَابِدُ کَأَوَابِدِ الْوَحْشِ فَمَا غلبکم مِنْہَا فَاصْنَعُوا بِہِ ہَکَذَا۔n(بخاری ۲۴۸۸۔ مسلم ۲۰)","Sahih","Musannaf Ibn Abi Shaybah 20155","","","كتاب الصيد"
"20156","(۲۰۱۵۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَیُونُسَ ، عَنِ الْحَسَنِ أَنَّہُمَا لَمْ یَرَیَا بَأْسًا بِمَا مَاتَ مِنَ السَّمَکِ فِی الْحَظِیرَۃِ۔","","Musannaf Ibn Abi Shaybah 20156","","","كتاب الصيد"
"20157","(۲۰۱۵۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَان ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ مِنَ السَّمَکِ مَا یَمُوتُ فِی الْمَائِ إِلاَّ أَنْ یَتَّخِذَ الرَّجُلُ حَظِیرَۃً فَمَا دَخَلَ فِیہَا فَمَاتَ لَمْ یَرَ بأکلہ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20157","","","كتاب الصيد"
"20158","(۲۰۱۵۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ مَعْقِلِ بن عُبَیْدِ اللہِ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : إذَا حَظَّرْت فِی الْمَائِ حَظِیرَۃً فَمَا مَاتَ فِیہَا فَکُلْ۔","","Musannaf Ibn Abi Shaybah 20158","","","كتاب الصيد"
"20159","(۲۰۱۵۹) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ سَعِیدِ بْنِ مَسْرُوقٍ ، عَنْ عَبَایَۃَ بْنِ رِفَاعَۃَ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ : إنَّا نَلْقَی الْعَدُوَّ غَدًا وَلَیْسَ مَعَنَا مُدًی ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : أَرِنْ ، أَوْ أَعْجِلْ مَا أَنْہَرَ الدَّمَ وَذُکِرَ اسْمُ اللہِ عَلَیْہِ فَکُلُوا مَا لَمْ یَکُنْ سِنٌّ ، أَوْ ظُفْرٌ وَسَأُحَدِّثُکُمْ عَنْ ذَلِکَ ، أَمَّا السِّنُّ فَعَظْمٌ وَأَمَّا الظُّفُرُ فَمُدَی الْحَبَشَۃِ۔ (بخاری ۵۵۴۳۔ ابوداؤد ۲۸۱۴)","Sahih","Musannaf Ibn Abi Shaybah 20159","","","كتاب الصيد"
"20160","(۲۰۱۶۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِی إدْرِیسَ ، قَالَ : رَأَیْتُ أَنَسًا أَتَی بِعَصَافِیرَ فَدَعَا بِلِیطَۃٍ فَذَبَحَہُنَّ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 20160","","","كتاب الصيد"
"20161","(۲۰۱۶۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الْمُسَیَّبِ بْنِ رَافِعٍ ، قَالَ : سُئِلَ عَلْقَمَۃُ عَنِ اللِّیطَۃِ یُذْبَحُ بِہَا وَالْمَرْوَۃِ ، فَقَالَ : لاَ بأس بہا وقال : کُلْ مَا أَفْرَی الأَوْدَاجَ إِلاَّ السِّنَّ وَالظُّفُرَ۔","","Musannaf Ibn Abi Shaybah 20161","","","كتاب الصيد"
"20162","(۲۰۱۶۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنِ الأَعْمَشِ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ، قَالاَ: لاَ بَأْسَ بِذَبْحِ اللِّیطَۃِ، أَوَ قَالَ: الْقَصَبَۃَ۔","","Musannaf Ibn Abi Shaybah 20162","","","كتاب الصيد"
"20163","(۲۰۱۶۳) حَدَّثَنَا یَحْیَی ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، قَالَ : تَذَاکَرْنَا عِنْدَ أَبِی الشَّعْثَائَ مَا یُذَکَّی بِہِ ، فَقَالَ : مَا أَفْرَی الأَوْدَاجَ ، ومَا أَفْرَی مَا حَزَّ۔","","Musannaf Ibn Abi Shaybah 20163","","","كتاب الصيد"
"20164","(۲۰۱۶۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : مَا أَفْرَی الأَوْدَاجَ وَأَہْرَاقَ الدَّمَ فکل مَا خَلاَ النَّابَ وَالظُّفُرَ وَالْعَظْمَ۔","","Musannaf Ibn Abi Shaybah 20164","","","كتاب الصيد"
"20165","(۲۰۱۶۵) حَدَّثَنَا خَالِد?? بْنُ حَیَّانَ الرَّقِّیُّ ، عَنْ جَعْفَرِ بْنِ مَیْمُونٍ ، قَالَ : کُلُّ مَا أَفْرَی اللَّحْمَ وَقَطَعَ الأَوْدَاجَ إِلاَّ أَنَّہُمْ کَانُوا یَکْرَہُونَ السِّنَّ وَالظُّفُرَ وَیَقُولُونَ : إنَّہُمَا مُدَی الْحَبَشَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20165","","","كتاب الصيد"
"20166","(۲۰۱۶۶) حَدَّثَنَا عُمَرُ بْنُ أَیُّوبَ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ ذَکَاۃَ إِلاَّ بِالأَسَلِ والظُّرَر ، وَمَا قَطَعَ الأَوْدَاجَ وَفَرَی اللَّحْمَ فَکُلْ مَا خَلاَ السِّنَّ وَالظُّفْرُ۔","","Musannaf Ibn Abi Shaybah 20166","","","كتاب الصيد"
"20167","(۲۰۱۶۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ عَوْفٍ ، عَنْ أَبِی رَجَائٍ ، قَالَ : أَصْعَدْنَا فِی الْحَاجِّ فَأَصَابَ صَاحِبٌ لَنَا أَرْنَبًا فَلَمْ یَجِدْ مَا یُذْکِیہَا بِہِ فَذَبَحَہَا بِظُفُرِہِ فَمَلُّوہَا فَأَکَلُوہَا ، وَأَبَیْتُ أَنْ آکُلَ ، قَالَ : فَلَقِیت ابْنَ عَبَّاسٍ فَذَکَرْت ذَلِکَ لَہُ ، فَقَالَ : أَحْسَنْت حِینَ لَمْ تَأْکُلْ ، قَتَلَہَا خَنْقًا۔","Hasan","Musannaf Ibn Abi Shaybah 20167","","","كتاب الصيد"
"20168","(۲۰۱۶۸) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُذْبَحُ بِسِنٍّ ، وَلاَ عَظْمٍ ، وَلاَ ظُفُرٍ ، وَلاَ قَرْنٍ۔","","Musannaf Ibn Abi Shaybah 20168","","","كتاب الصيد"
"20169","(۲۰۱۶۹) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ سِمَاکٍ ، عَنْ مُرَیِّ بْنِ قَطَرِیِّ، عَنْ عَدِیِّ بْنِ حَاتِمٍ، قَالَ: سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الذَّبِیحَۃِ بِالْمَرْوَۃِ وشقۃ العصا ، فَقَالَ : لاَ بَأْسَ بِہِ وَرَخَّصَ فِیہِ۔n(ابوداؤد ۲۸۱۷۔ ابن ماجہ ۳۱۷۷)","Hasan","Musannaf Ibn Abi Shaybah 20169","","","كتاب الصيد"
"20170","(۲۰۱۷۰) حَدَّثَنَا أَبُو خَالِدٍ ، عَنِ ابْنِ جُرَیْجٍ عَمَّنْ حَدَّثَہُ ، عَنْ رَافِعِ بْنِ خَدِیجٍ ، قَالَ : سَأَلْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الذَّبِیحَۃِ اللِّیطَۃِ ، فَقَالَ : کُلْ مَا فَرَی الأَوْدَاجَ إِلاَّ سِنًّا ، أَوْ ظُفُرًا۔ n(مسلم ۲۲۔ نسائی ۴۴۹۲م)","Da'if","Musannaf Ibn Abi Shaybah 20170","","","كتاب الصيد"
"20171","(۲۰۱۷۱) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ بْنِ سُمَیْعٍ ، عَنْ أَبِی الرَّبِیع سُئِلَ ابْنُ عَبَّاسٍ عَنْ ذَبِیحَۃِ الْقَصَبَۃِ ، إذَا لَمْ یَجِدْ سِکِّینًا ، فَقَالَ : إذَا فرت فَقَطَعَتِ الأَوْدَاجَ کَقَطْعِ السِّکِّینِ وَذُکِرَ اسْمُ اللہِ فَکُلْ ، وَإِذَا ثُلغت ثلغًا فَلاَ تَأْکُلْ وَسَأَلَتْہُ عَنْ ذَبِیحَۃِ الْمَرْوَۃِ إذَا لَمْ یَجِدْ سِکِّینًا ، فَقَالَ : إذَا بَرَتْ فَقَطَعَتِ الأَوْدَاجَ فَکُلْ ، وَإِذَا ثُلِغت ثلغًا فَلاَ تَأْکُلْ۔","Sahih","Musannaf Ibn Abi Shaybah 20171","","","كتاب الصيد"
"20172","(۲۰۱۷۲) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مُحَمَّدِ بْنِ صَیْفِیِّ ، قَالَ : أَتَیْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِأَرْنَبَیْنِ قَدْ ذَبَحْتُہُمَا بِمَرْوَۃَ فَأَمَرَنِی بِأَکْلِہِمَا۔ (ابن ماجہ ۳۱۷۵)","Sahih","Musannaf Ibn Abi Shaybah 20172","","","كتاب الصيد"
"20173","(۲۰۱۷۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنْ مُحَمَّدِ بْنِ صَفْوَانَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِمِثْلِہِ۔ (احمد ۳۔ دارمی ۲۰۱۴)","Sahih","Musannaf Ibn Abi Shaybah 20173","","","كتاب الصيد"
"20174","(۲۰۱۷۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ ، قَالَ : اذْبَحْ بِحَجَرِکَ وحدیدتک وعودک وَعَظْمَک۔","","Musannaf Ibn Abi Shaybah 20174","","","كتاب الصيد"
"20175","(۲۰۱۷۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ إِسْحَاقَ بْنِ سُوَیْد ، عَنْ یَحْیَی بْنِ یَعْمُرَ ، قَالَ : کُلْ مَا یُجْرَحُ ، وَلاَ تَأْکُلُ مَا یُفْدَغُ ، وَکُلُّ شَیْئٍ یَفْرِی الأَوْدَاجَ فَکُلْ وَلَوْ بِلِیطَۃٍ ، أَوْ بشظیۃ حَجَرٍ۔","","Musannaf Ibn Abi Shaybah 20175","","","كتاب الصيد"
"20176","(۲۰۱۷۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، قَالَ : اذْبَحْ بِالْحَجَرِ وَاللِّیطَۃِ وَکُلُّ شَیْئٍ مِنَ الشَّفْرَۃِ مَا لَمْ یَجْرَحْ ، أَوْ یَفْدَغْ۔","","Musannaf Ibn Abi Shaybah 20176","","","كتاب الصيد"
"20177","(۲۰۱۷۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : جَائَ أَعْرَابِیٌّ إلَی الأَسْوَدِ ، فَقَالَ لَہُ : أَذْبَحُ بِالْمَرْوَۃِ ؟ فَقَالَ لَہُ الأَسْوَدُ : لاَ فَلَمَّا قَفَی الأَعْرَابِیُّ قُلْتُ : أَلَیْسَ لاَ بَأْسَ أَنْ یَذْبَحَ بِالْمَرْوَۃِ ؟ قَالَ : إنَّمَا ہَذَا یُرِیدُ أَنْ یَفصد بَعِیرَہُ فَإِذَا مَاتَ ، قَالَ : ذَکَّیْتہ۔","","Musannaf Ibn Abi Shaybah 20177","","","كتاب الصيد"
"20178","(۲۰۱۷۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : إذَا ذَبَحْت بِالْعُودِ وَالْمَرْوَۃِ فَقَطَعْت الأَوْدَاجَ فَلَیْسَ بِہِ بَأْسٌ۔","","Musannaf Ibn Abi Shaybah 20178","","","كتاب الصيد"
"20179","(۲۰۱۷۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سَلَمَۃَ بْنِ بِشْرٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : سَأَلْتُہ عَنِ الذَّبِیحَۃِ بِالْمَرْوَۃِ ، فَقَالَ : إذَا کَانَتْ حَدِیدَۃً لاَ تَرِدُ الأَوْدَاجَ فَکُلْ۔","","Musannaf Ibn Abi Shaybah 20179","","","كتاب الصيد"
"20180","(۲۰۱۸۰) حَدَّثَنَا غُنْدَرٌ، حَدَّثَنَا شُعْبَۃَ، عَنْ عَبْدِ اللہِ بْن أَبِی السَّفَرِ، قَالَ: سَمِعْتُ الشَّعْبِیَّ یَقُولُ: کُلْ ذَبِیحَۃَ الْمَرْوَۃِ۔","","Musannaf Ibn Abi Shaybah 20180","","","كتاب الصيد"
"20181","(۲۰۱۸۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنِ السدی ، عَنِ الْوَلِیدِ بْنِ عُتْبَۃَ ، قَالَ علِیٌّ : إذَا لَمْ تَجِدْ إِلاَّ الْمَرْوَۃَ فَاذْبَحْ بِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 20181","","","كتاب الصيد"
"20182","(۲۰۱۸۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : کُلْ مَا ذُبِحَ بِالشَّفْرَۃِ وَالْمَرْوَۃِ وَالْقَصَبَۃِ وَالْعُودِ ومَا أَفْرَی الأَوْدَاجَ ، وَأَنْہَرَ الدَّمَ ، وَکَانَ یُکْرَہُ السِّنُّ وَالْعَظْمُ وَالظُّفُرُ۔","","Musannaf Ibn Abi Shaybah 20182","","","كتاب الصيد"
"20183","(۲۰۱۸۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ زَیْدِ بْنِ أَسْلَمَ ، عَنْ عَطَائِ بْنِ یَسَارٍ ، أَنَّ غُلاَمًا مِنْ بَنِی حَارِثَۃَ کَانَ یَرْعَی لِقْحَۃً لہ فَأَتَاہَا الْمَوْتُ وَلَیْسَ مَعَہُ مَا یُذْکِیہَا بِہِ فَأَخَذَ وَتَدًا فَنَحَرَہَا فَسَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَمَرَہُ بِأَکْلِہَا۔","","Musannaf Ibn Abi Shaybah 20183","","","كتاب الصيد"
"20184","(۲۰۱۸۴) حَدَّثَنَا جَرِیرٌ ، عَنِ الرُّکَیْنِ ، عَنْ أَبِی طَلْحَۃَ الأَسَدِیِّ ، قَالَ : کُنْتُ جَالِسًا عِنْدَ ابْنِ عَبَّاسٍ فَأَتَاہُ أَعْرَابِیٌّ، فَقَالَ : کُنْت فِی غَنَمٍ فَعَلاَ الذِّئْبُ فبقر النَّعْجَۃُ مِنْ غَنَمِی فَنَثَرَ قَصْبَہَا فِی الأَرْضِ ، فَأ??خَذْت ظِرَارًا مِنَ الأَظرۃِ فَضَرَبْت بَعْضَہُ بِبَعْضٍ حَتَّی صَارَ لِی مِنْہُ کَہَیْئَۃِ السِّکِّینَ فَذَبَحْتُ بِہِ الشَّاۃَ وَأَہْرَقْتُ بِہِ الدَّمَ وَقَطَعْت الْعُرُوقَ ، فَقَالَ : انْظُرْ مَا مَسَّ الأَرْضَ مِنْہَا فَاقْطَعْہُ ، فَإِنَّہُ قَدْ مَاتَ وَکُلْ سَائِرَہَا۔","Hasan","Musannaf Ibn Abi Shaybah 20184","","","كتاب الصيد"
"20185","(۲۰۱۸۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ، عَنْ مِسْعَرٍ، عَنْ عَاصِمٍ، عَنْ زِرٍّ، قَالَ: قَالَ عُمَرُ: لیُذَکِّیَنَّ لَکُمُ الأَسَلُ: الرِّمَاحُ وَالنَّبْلُ۔","Da'if","Musannaf Ibn Abi Shaybah 20185","","","كتاب الصيد"
"20186","(۲۰۱۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ کَعْبِ بْنِ مَالِکٍ ، عَنْ أَبِیہِ ، أَنَّ جُوَیْرِیَۃَ لَہُمْ سَوْدَائَ ذَبَحَتْ شَاۃً بِمَرْوَۃَ ، فَسَأَلَ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ ذَلِکَ فَأَمَرَہُ بِأَکْلِھَا۔(بخاری ۲۳۰۴۔ مسندہ ۵۰۰)","","Musannaf Ibn Abi Shaybah 20186","","","كتاب الصيد"
"20187","(۲۰۱۸۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ حَجَّاجٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : کُلْ مَا أَفْرَی الأَوْدَاجَ إِلاَّ سِنٌّ ، أَوْ ظُفُرٌ۔","","Musannaf Ibn Abi Shaybah 20187","","","كتاب الصيد"
"20188","(۲۰۱۸۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، قَالَ : سُئِلَ مُحَمَّدٌ عَنِ الذَّبِیحَۃِ بِالْعُودِ ، فَقَالَ : کُلْ مَا لَمْ یُفْدَغْ۔","","Musannaf Ibn Abi Shaybah 20188","","","كتاب الصيد"
"20189","(۲۰۱۸۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الذَّکَاۃُ فِی الْحَلْقِ وَاللَّبَّۃِ۔","Sahih","Musannaf Ibn Abi Shaybah 20189","","","كتاب الصيد"
"20190","(۲۰۱۹۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ دَاوُدَ بْنِ أَبِی عَاصِمٍ ، أَنَّ بَعِیرًا تَرَدَّی فِی مَنْہَلٍ مِنْ تِلْکَ الْمَنَاہِلِ فَلَمْ یَسْتَطِیعُوا أَنْ یَنْحَرُوہُ فَسَأَلُوا سَعِیدَ بْنَ الْمُسَیَّبِ ، فَقَالَ : لاَ مَنْحَرَ إِلاَّ مَنْحَرُ إبْرَاہِیمَ علیہ السلام۔","","Musannaf Ibn Abi Shaybah 20190","","","كتاب الصيد"
"20191","(۲۰۱۹۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ نَحْرَ إِلاَّ فِی الْمَنْحَرِ وَالْمَذْبَحِ۔","","Musannaf Ibn Abi Shaybah 20191","","","كتاب الصيد"
"20192","(۲۰۱۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ أَخْبَرَنَا ہِشَامٌ الدَّسْتَوَائِیُّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی الْمَعْرُورِ ، عَنِ ابن الْفَرَافِصَۃِ : أن الفَرَافِصَۃ کَانَ عِنْدَ عُمَرَ فَأَمَرَ مُنَادِیَہُ ، إنَّ النَّحْرَ فِی اللَّبَّۃِ ، وَالْحَلْقِ لِمَنْ قدر وَأَقِرُّوا الأَنْفُسَ حَتَّی تَزْہَقَ۔ (عبدالرزاق ۸۶۱۴)","Da'if","Musannaf Ibn Abi Shaybah 20192","","","كتاب الصيد"
"20193","(۲۰۱۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ ذَبَحَ شَاۃً مِنْ قَفَاہَا فَکَرِہَ أَکْلَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20193","","","كتاب الصيد"
"20194","(۲۰۱۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ رَجُلٍ مِنْ بَنِی حَارِثَۃَ ، عَنْ أَشْیَاخٍ لَہُمْ ، أَنَّ بَعِیرًا تَرَدَّی فِی عین فَسَأَلُوا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْہُ ، فَقَالَ : اطْعَنُوہُ وَکُلُوہُ۔ (طبرانی ۴۳۸۰)","Da'if","Musannaf Ibn Abi Shaybah 20194","","","كتاب الصيد"
"20195","(۲۰۱۹۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ سِیَاہٍ ، عَنْ حَبِیبٍ ، عَنْ مَسْرُوقٍ ، أَنَّ بَعِیرًا تَرَدَّی فِی بِئْرٍ فَصَارَ أَعْلاَہُ أَسْفَلَہُ ، فَقَالَ عَلِیٌّ : قَطِّعُوہُ أَعْضَائً وَکُلُوہُ۔","Hasan","Musannaf Ibn Abi Shaybah 20195","","","كتاب الصيد"
"20196","(۲۰۱۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الْبَعِیرِ یَتَرَدَّی فِی الْبِئْرِ ، فَقَالَ : یُطْعَنُ حَیْثُ قُدِرَ ، وَیُذْکَرُ اسْمُ اللہِ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 20196","","","كتاب الصيد"
"20197","(۲۰۱۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی الْعُشَرَائِ ، عَنْ أَبِیہِ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ ، مَا تَکُونُ الذَّکَاۃُ إِلاَّ فِی الْحَلْقِ وَاللَّبَّۃِ ؟ فَقَالَ : لَوْ طَعَنْتَ فِی فَخِذِہَا لأَجْزَأک۔ (ترمذی ۱۴۸۱۔ ابن اجہ ۳۱۸۴)","Da'if","Musannaf Ibn Abi Shaybah 20197","","","كتاب الصيد"
"20198","(۲۰۱۹۸) حَدَّثَنَا یَحْیَی ، عَنْ أَبِی حَیَّانَ ، عَنْ عَبَایَۃَ ، قَالَ : تَرَدَّی بَعِیرٌ فِی رَکِیَّۃٍ ، وَابْنُ عُمَرَ حَاضِرٌ فَنَزَلَ رَجُلٌ لِیَنْحَرَہُ ، فَقَالَ : لاَ أَقْدِرُ أَنْ أَنْحَرَہُ ، فقال ابْنُ عُمَرَ ، اذْکُرِ اسْمَ اللہِ عَلَیْہِ وَأَجْہِزْ عَلَیْہِ مِنْ قِبَلِ شَاکِلَتِہِ فَفَعَلَ ، فَأُخْرِجَ مُقَطَّعًا فَأَخَذَ مِنْہُ ابْنُ عُمَرَ عُشْرًا بِدِرْہَمَیْنِ ، أَوْ بِأَرْبَعَۃٍ۔","Sahih","Musannaf Ibn Abi Shaybah 20198","","","كتاب الصيد"
"20199","(۲۰۱۹۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، حَدَّثَنَا سُفْیَانُ ، عَنْ حَبِیبٍ ، عَنْ أَبِی الضُّحَی ، عَنْ مَسْرُوقٍ فِی قِرْمَلَ تَرَدَّی فِی بِئْرٍ ، فَقَالَ : قطِّعُوہُ وَکُلُوہُ۔","","Musannaf Ibn Abi Shaybah 20199","","","كتاب الصيد"
"20200","(۲۰۲۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ سِیَاہٍ ، عَنْ أَبِی رَاشِدٍ السَّلْمَانِیِّ ، قَالَ : کُنْتُ أَرْعَی مَنَائِحَ لأَہْلِی بِظَہْرِ الْکُوفَۃِ یَعْنِی الْعِشَارَ ، قَالَ : فَتَرَدَّی مِنْہَا بَعِیرٌ فَخَشِیت أَنْ یَسْبِقنِی بِذَکَاۃٍ فَأَخَذْت حَدِیدَۃً فَوَجَأْت بِہَا فِی جَنْبِہِ ، أَوْ سَنَامِہِ ، ثُمَّ قَطَّعْتہ أَعْضَائً وَفَرَّقْتہ عَلَی سَائِرِ أَہْلِی ، ثُمَّ أَتَیْتُ أَہْلِی فَأَبَوْا أَنْ یَأْکُلُوا حَیْثُ أَخْبَرْتہمْ خَبَرَہُ فَأَتَیْت عَلِیًّا فَقُمْت عَلَی بَابِ قَصْرِہِ فَقُلْت : یَا أَمِیرَ الْمُؤْمِنِینَ ، یَا أَمِیرَ الْمُؤْمِنِینَ ، فَقَالَ : لَبَّیْکَاہُ لَبَّیْکَاہُ ، فَأَخْبَرْتہ خَبَرَہُ ، فَقَالَ : کُلْ وَأَطْعِمْنِی عَجُزَہُ۔","Da'if","Musannaf Ibn Abi Shaybah 20200","","","كتاب الصيد"
"20201","(۲۰۲۰۱) حَدَّثَنَا مُصْعَبٌ ، حَدَّثَنَا یُونُسُ بْنُ أَبِی إِسْحَاقَ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : کَانَ شُرَیْحٌ وَمَسْرُوقٌ یَقُولاَنِ: أَیُّمَا بَعِیرٍ تَرَدَّی فِی بِئْرٍ فَلَمْ یَجِدُوا مَنْحَرَہُ فَلْیَجَؤُوہ بِالسِّکِّینِ فَہُوَ ذَکَاتُہُ۔","","Musannaf Ibn Abi Shaybah 20201","","","كتاب الصيد"
"20202","(۲۰۲۰۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سعید ، عَنْ مُحَمَّدِ بْنِ یَحْیَی بْنِ حَبَّانَ ، عَنْ أَبِی مُرَّۃَ مَوْلَی عَقِیلِ بْنِ أَبِی طَالِبٍ ، قَالَ : رَجَعْت إلَی أَہْلِی وَقَدْ کَانَ لَہُمْ شَاۃٌ فَإِذَا ہِیَ مَیْتَۃٌ فَذَبَحْتہَا فَتَحَرَّکَتْ فَأَتَیْت أَبَا ہُرَیْرَۃَ فَذَکَرْت ذَلِکَ لَہُ فَأَمَرَنِی بِأَکْلِہَا ، قَالَ : ثُمَّ أَتَیْتُ زَیْدَ بْنَ ثابت فَذَکَرْت لَہُ أَمْرَہَا ، فَقَالَ : إنَّ الْمَیِّتَ یَتَحَرَّک۔","Sahih","Musannaf Ibn Abi Shaybah 20202","","","كتاب الصيد"
"20203","(۲۰۲۰۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ عُبَیْدِ بْنِ عُمَیْرٍ فِی الذَّبِیحَۃِ ، قَالَ : إذَا مَصَعَتْ بِذَنَبِہَا ، أَوْ طَرَفَتْ ، أَوْ تَحَرَّکَتْ فَقَدْ حَلَّتْ۔","","Musannaf Ibn Abi Shaybah 20203","","","كتاب الصيد"
"20204","(۲۰۲۰۴) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ أَنَّہُ لَمْ یَرَ بِہَا بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20204","","","كتاب الصيد"
"20205","(۲۰۲۰۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، قَالَ : إذَا ذُکِّیَتْ فَحَرَّکَتْ ذَنَبًا ، أَوْ طَرَفًا ، أَوْ رِجْلاً فَہِیَ ذَکِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 20205","","","كتاب الصيد"
"20206","(۲۰۲۰۶) حَدَّثَنَا عَبَّادُ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی الذَّبِیحَۃِ: إذَا ذُکِّیَتْ فَحَرَّکَتْ طَرَفًا، أَوْ رِجْلاً فَہِیَ ذَکِیّ۔","","Musannaf Ibn Abi Shaybah 20206","","","كتاب الصيد"
"20207","(۲۰۲۰۷) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنِ الصَّبَّاحِ بْنِ ثَابِتٍ ، قَالَ : سَأَلَتْ عَامِرَ بْنِ عَبْدَۃَ ، عَنْ بَطَّۃٍ وَقَعَتْ فِی بِئْرٍ فَأَخْرَجُوہَا وَبِہَا رَمَقٌ ، فَقَالَ : اذْبَحُوہَا وَکُلُوہَا۔","","Musannaf Ibn Abi Shaybah 20207","","","كتاب الصيد"
"20208","(۲۰۲۰۸) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : إذَا طَرَفَتْ بِعَیْنِہَا ، أَوْ مَصَعَتْ بِذَنَبِہَا ، أَوْ رَکَضَتْ بِرِجْلِہَا فَکُلْ۔","","Musannaf Ibn Abi Shaybah 20208","","","كتاب الصيد"
"20209","(۲۰۲۰۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : مَا أَدْرَکْت مِنْ ذَلِکَ یَطْرِفُ بِعَیْنِہِ ، أَوْ یُحَرِّکُ ذَنَبَہُ فَذُبِحَ فَہُوَ حَلاَلٌ ، وَمَا ذُبِحَ فَلَمْ تَطْرِفْ لَہُ عَیْنٌ ، وَلَمْ یَتَحَرَّکْ لَہُ ذَنَبٌ فَہُوَ حَرَامٌ مَیْتَۃٌ۔","","Musannaf Ibn Abi Shaybah 20209","","","كتاب الصيد"
"20210","(۲۰۲۱۰) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ أَبِی شِہَابٍ مُوسَی بْنِ نَافِعٍ ، عَنِ النُّعْمَانِ بْنِ عَلِیٍّ ، قَالَ : مَرَّ سَعِیدُ بْنُ جُبَیْرٍ عَلَی نَعَامَۃٍ مُلْقَاۃٍ عَلَی الْکُنَاسَۃِ تَحَرَّکُ ، فَقَالَ : مَا ہَذِہِ ؟ فَقَالُوا : نَخَافُ أَنْ تَکُونَ مَوْقُوذَۃً ؟ فَقَالَ : کِدْتُمْ تَدَعُونہَا لِلشَّیْطَانِ ، إنَّمَا الْوَقِیذُ مَا مَاتَ فِی وَقِیذِہِ۔","","Musannaf Ibn Abi Shaybah 20210","","","كتاب الصيد"
"20211","(۲۰۲۱۱) حَدَّثَنَا مُعْتَمَرٌ ، عَنْ أَبِیہِ ، عَنْ أَبِی مجلز ، قَالَ : کَانُوا یرجون فِی الْمُنْخَنِقَۃِ وَالْمَوْقُوذَۃِ وَالْمُتَرَدِّیَۃِ إِلاَّ مَا ذَکَّیْتُمْ ، ثُمَّ حَرَّمَ اللَّہُ ذَلِکَ کُلَّہُ إلا ما ذُکِّیَ۔","","Musannaf Ibn Abi Shaybah 20211","","","كتاب الصيد"
"20212","(۲۰۲۱۲) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَرَّمَ یَوْمَ خَیْبَرَ الْمُجَثَّمَۃَ۔ (ترمذی ۱۷۹۵۔ احمد ۲/۳۶۶)","Hasan","Musannaf Ibn Abi Shaybah 20212","","","كتاب الصيد"
"20213","(۲۰۲۱۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنِ الْمُجَثَّمَۃِ۔","","Musannaf Ibn Abi Shaybah 20213","","","كتاب الصيد"
"20214","(۲۰۲۱۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : نَہَی عَنِ الْمُجَثَّمَۃِ۔","","Musannaf Ibn Abi Shaybah 20214","","","كتاب الصيد"
"20215","(۲۰۲۱۵) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : لَمَّا کَانَ یَوْمَ خَیْبَرَ حَرَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ الْمُجَثَّمَۃَ وَالْخِلْسَۃَ وَالنُّہْبَۃَ۔n(ترمذی ۱۴۷۸۔ احمد ۳/۳۲۳)","","Musannaf Ibn Abi Shaybah 20215","","","كتاب الصيد"
"20216","(۲۰۲۱۶) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، حَدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الْمُجَثَّمَۃِ۔ (بخاری ۵۶۲۹۔ ترمذی ۱۸۲۵)","Sahih","Musannaf Ibn Abi Shaybah 20216","","","كتاب الصيد"
"20217","(۲۰۲۱۷) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : قُلْتُ لِعَطَائٍ : أَرَأَیْت لَوْ رَمَیْت دِیکًا ، أَوْ کَبْشًا بِالنَّبْلِ کُنْت تَأْکُلُہُ ؟ قَالَ : لاَ ہُوَ مَیْتَۃٌ۔","","Musannaf Ibn Abi Shaybah 20217","","","كتاب الصيد"
"20218","(۲۰۲۱۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَنْہَی عَنْ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20218","","","كتاب الصيد"
"20219","(۲۰۲۱۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنِ الْمِنْہَالِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، أَنَّ ابْنَ عُمَرَ مَرَّ عَلَی قَوْمٍ نَصَبُوا دَجَاجَۃً یَرْمُونَہَا ، فَقَالَ : لَعَنَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَنْ مَثَّلَ بِالْبَہَائِمِ ۔n(بخاری ۵۵۱۵۔ مسلم ۱۵۴۹)","Sahih","Musannaf Ibn Abi Shaybah 20219","","","كتاب الصيد"
"20220","(۲۰۲۲۰) حَدَّثَنَا عُقْبَۃُ بْنُ خَالِدٍ ، عَنْ مُوسَی بْنِ مُحَمَّدٍ ، قَالَ : أَخْبَرَنِی أَبِی ، عَنْ أَبِی سَعِیدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُمَثَّلَ بِالْبَہَائِمِ۔ (ابن ماجہ ۳۱۸۵)","Da'if","Musannaf Ibn Abi Shaybah 20220","","","كتاب الصيد"
"20221","(۲۰۲۲۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ، عَنْ سُفْیَانَ، عَنْ سِمَاکٍ، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: مَرَّ عَلَی أُنَاسٌ مِنَ الأَنْصَارِ قَدْ وَضَعُوا حَمَامَۃً یَرْمُونَہَا، فَقَالَ: نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُتَّخَذَ الرُّوحُ غَرَضًا۔n(مسلم ۱۵۴۹۔ ترمذی ۱۴۷۵)","","Musannaf Ibn Abi Shaybah 20221","","","كتاب الصيد"
"20222","(۲۰۲۲۲) حَدَّثَنَا یَزِیدُ ، أَخْبَرَنَا شُعْبَۃُ ، عَنْ ہِشَامِ بْنِ زَیْدِ بْنِ أَنَسٍ ، قَالَ : دَخَلْت مَعَ أَنَسٍ دَارَ الإِمَارَۃِ وَقَدْ نَصَبُوا دَجَاجَۃً یَرْمُونَہَا ، فَقَالَ: نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُصَبَّرَ الْبَہَائِمُ۔ n(بخاری ۵۵۱۳۔ مسلم ۱۵۴۹)","Sahih","Musannaf Ibn Abi Shaybah 20222","","","كتاب الصيد"
"20223","(۲۰۲۲۳) حَدَّثَنَا أَبُو الْمُوَرِّعِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُقْتَلَ شَیْئٌ مِنَ الْبَہَائِمِ صَبْرًا۔ (مسلم ۱۵۵۰۔ ابن ماجہ ۳۱۸۸)","","Musannaf Ibn Abi Shaybah 20223","","","كتاب الصيد"
"20224","(۲۰۲۲۴) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ عُبَیْدِ بْنِ تِعْلَی ، عَنْ أَبِی أَیُّوبَ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَنْہَی عَنْ صَبْرِ الْبَہِیمَۃِ وَمَا أُحِبُّ أَنِّی صَبَّرْت دَجَاجَۃً ، وَلاَ أَنَّ لِی کَذَا وَکَذَا۔ (طبرانی ۴۰۰۴۔ احمد ۵/۴۴۲)","","Musannaf Ibn Abi Shaybah 20224","","","كتاب الصيد"
"20225","(۲۰۲۲۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عن أبی إدریس عَنْ أَبِی ثَعْلَبَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ أَکْلِ کُلِّ ذِی نَابٍ مِنَ السِّبَاعِ۔ (بخاری ۵۷۸۰۔ مسلم ۱۵۳۳)","Sahih","Musannaf Ibn Abi Shaybah 20225","","","كتاب الصيد"
"20226","(۲۰۲۲۶) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَیْدِ بْنِ جَابِرٍ ، قَالَ : حدَّثَنَا الْقَاسِمُ وَمَکْحُولٌ ، عَنْ أَبِی أُمَامَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی یَوْمَ خَیْبَرَ ، عَنْ کُلِّ ذِی نَابٍ مِنَ السِّبَاعِ۔","Da'if","Musannaf Ibn Abi Shaybah 20226","","","كتاب الصيد"
"20227","(۲۰۲۲۷) حَدَّثَنَا حُسَیْنُ بْنُ عَلِیٍّ ، عَنْ زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَرَّمَ یَوْمَ خَیْبَرَ کُلَّ ذِی نَابٍ مِنَ السِّبَاعِ۔ (ابوداؤد ۳۷۹۹۔ ترمذی ۱۴۷۹)","Hasan","Musannaf Ibn Abi Shaybah 20227","","","كتاب الصيد"
"20228","(۲۰۲۲۸) حَدَّثَنَا ہُشَیْمُ بْنُ أَبِی بِشْرٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَہَی عَنْ کُلِّ ذِی نَابٍ مِنَ السِّبَاعِ ، وَعَنْ کُلِّ ذِی مِخْلَبٍ مِنَ الطَّیْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 20228","","","كتاب الصيد"
"20229","(۲۰۲۲۹) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی سَلَمَۃَ ، عَنْ جَابِرٍ ، قَالَ: حرَّمَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ خَیْبَرَ کُلَّ ذِی نَابٍ مِنَ السِّبَاعِ وَکُلَّ ذِی مِخْلَبٍ مِنَ الطَّیْرِ۔","","Musannaf Ibn Abi Shaybah 20229","","","كتاب الصيد"
"20230","(۲۰۲۳۰) حَدَّثَنَا یَحْیَی بْنُ آدَمَ ، عَنْ أَبِی عَوَانَۃَ ، عَنْ أَبِی بِشْرٍ ، عَنْ مَیْمُونِ بْنِ مِہْرَانَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ کُلِّ ذِی نَابٍ مِنَ السِّبَاعِ ، وَعَنْ کُلِّ ذِی مِخْلَبٍ مِنَ الطَّیْرِ۔","Sahih","Musannaf Ibn Abi Shaybah 20230","","","كتاب الصيد"
"20231","(۲۰۲۳۱) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : کَانُوا یَکْرَہُونَ کُلَّ ذِی مِخْلَبٍ مِنَ الطَّیْرِ ، وَکُلَّ سَبْعٍ ذِی نَابٍ۔","","Musannaf Ibn Abi Shaybah 20231","","","كتاب الصيد"
"20232","(۲۰۲۳۲) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ مِنَ الطَّیْرِ مَا أَکَلَ الْجِیَفَ۔","","Musannaf Ibn Abi Shaybah 20232","","","كتاب الصيد"
"20233","(۲۰۲۳۳) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کُلُّ شَیْئٍ لَقَطَ مِنَ الطَّیْرِ فَلَیْسَ بِہِ بَأْسٌ ، وَکُلُّ شَیْئٍ نَہَشَ بِمِنْقَارِہِ ، أَوْ أَخَذَ بِمِخْلَبِہِ ، فَکَانَ یَکْرَہُ لَحْمَہُ ، وَکَانَ یَکْرَہُ لَحْمَ الصُّرَدِ۔","","Musannaf Ibn Abi Shaybah 20233","","","كتاب الصيد"
"20234","(۲۰۲۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، قَالَ : قُلْتُ لِمُجَاہِدٍ : إنَّ الْیَہُودَ لاَ یَأْکُلُونَ مِنَ الطَّیْرِ إِلاَّ مَا لَقَطَ ، قَالَ : فَأَعْجَبَ ذَلِکَ مُجَاہِدًا۔","","Musannaf Ibn Abi Shaybah 20234","","","كتاب الصيد"
"20235","(۲۰۲۳۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَتْ عَائِشَۃُ إذَا سُئِلَتْ عَنْ کُلِّ ذِی نَابٍ مِنَ السِّبَاعِ ، وَکُلِّ ذِی مِخْلَبٍ مِنَ الطَّیْرِ ، قَالَتْ : {لاَ أَجِدُ فِیمَا أُوحِیَ إلَیَّ مُحَرَّمًا} ، ثُمَّ تَقُولُ : إنَّ الْبُرمَۃَ لَیَکُونُ فِیہَا الصُّفْرَۃُ۔","Hasan","Musannaf Ibn Abi Shaybah 20235","","","كتاب الصيد"
"20236","(۲۰۲۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ مَعْمَرٍ ، عَنْ مُوسَی ، عَنْ أَبِی جَعْفَرٍ ، أَنَّہُ کَرِہَ أَکْلَ سِبَاعِ الطَّیْرِ وَسِبَاعِ الْوَحْشِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20236","","","كتاب الصيد"
"20237","(۲۰۲۳۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : مَنْ یَأْکُلُ الْغُرَابَ وَقَدْ سَمَّاہُ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَاسِقًا ؟۔ (ابن ماجہ ۳۲۴۸۔ بیہقی ۳۱۷)","","Musannaf Ibn Abi Shaybah 20237","","","كتاب الصيد"
"20238","(۲۰۲۳۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ ، قَالَ : سَمِعْتُ عِکْرِمَۃَ وَسُئِلَ عَنْ لَحْمِ الْغُرَابِ وَالْحُدَیَّا ، فَقَالَ : دَجَاجَۃٌ سَمِینَۃٌ۔","","Musannaf Ibn Abi Shaybah 20238","","","كتاب الصيد"
"20239","(۲۰۲۳۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ سُئِلَ عَنْ لَحْمِ الْغُرَابِ وَالْحُدَیَّۃِ ، فَقَالَ : أَحَلَّ اللَّہُ حَلاَلاً وَحَرَّمَ حَرَامًا وَسَکَتَ عَنْ أَشْیَائَ فَمَا سَکَتَ عَنْہُ فَہُوَ عَفْوٌ عَنْہُ۔","","Musannaf Ibn Abi Shaybah 20239","","","كتاب الصيد"
"20240","(۲۰۲۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ ، عَنْ أَبِیہِ ، قَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20240","","","كتاب الصيد"
"20241","(۲۰۲۴۱) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، أَنَّہُ کَانَ لاَ یَرَی بِالطَّیْرِ کُلِّہِ بَأْسًا إِلاَّ أَنْ تَقْذَرَ مِنْہُ شَیْئًا۔","","Musannaf Ibn Abi Shaybah 20241","","","كتاب الصيد"
"20242","(۲۰۲۴۲) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ عَمَّنْ سَمِعَ إبْرَاہِیمَ مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20242","","","كتاب الصيد"
"20243","(۲۰۲۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مَکِینٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : مَا لَمْ یُحَرَّمْ عَلَیْک فی القرآن فَہُوَ لَکَ حَلاَلٌ۔","","Musannaf Ibn Abi Shaybah 20243","","","كتاب الصيد"
"20244","(۲۰۲۴۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مَعْمَرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : لاَ بَأْسَ بِأَکْلِ الْیَرْبُوعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20244","","","كتاب الصيد"
"20245","(۲۰۲۴۵) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20245","","","كتاب الصيد"
"20246","(۲۰۲۴۶) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِالْیَرْبُوعِ۔","","Musannaf Ibn Abi Shaybah 20246","","","كتاب الصيد"
"20247","(۲۰۲۴۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ دَاوُدَ بْنِ أَبِی الْفُرَاتِ ، عَنْ إبْرَاہِیمَ الصَّائِغِ ، عَنْ عَطَائٍ ، أَنَّہُ قَالَ فِی الذِّئْبِ لاَ یُؤْکَلُ وَالْیَرْبُوعُ یُؤْکَلُ۔","","Musannaf Ibn Abi Shaybah 20247","","","كتاب الصيد"
"20248","(۲۰۲۴۸) حَدَّثَنَا عَبْدُ الرَّزَّاقِ ، عَنْ مَعْمَرٍ ، عَنْ عَطَائٍ الْخُرَاسَانِیِّ ، قَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20248","","","كتاب الصيد"
"20249","(۲۰۲۴۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ أَبِی الْوَسِیمِ ، قَالَ : سَأَلَتْ حَسَنَ بْنَ حُسَیْنِ بْنِ عَلِیٍّ ، عَنِ الْیَرْبُوعِ ، قَالَ: فَأْرُ الْبَرِّیَّۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20249","","","كتاب الصيد"
"20250","(۲۰۲۵۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا ، عَنْ أَکْلِ الْیَرْبُوعِ فَکَرِہَاہُ۔","","Musannaf Ibn Abi Shaybah 20250","","","كتاب الصيد"
"20251","(۲۰۲۵۱) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بْنِ جُبَیْرِ بْنِ شَیْبَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ أُمِّ شَرِیکٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَہَا بِقَتْلِ الأَوْزَاغِ۔ (بخاری ۳۳۰۷۔ مسلم ۱۴۲)","Sahih","Musannaf Ibn Abi Shaybah 20251","","","كتاب الصيد"
"20252","(۲۰۲۵۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنَّہُ أَمَرَ بِقَتْلِہِ ، یَعْنِی الْوَزَغَ۔","","Musannaf Ibn Abi Shaybah 20252","","","كتاب الصيد"
"20253","(۲۰۲۵۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی جَعْفَرٍ الْخِطْمِیِّ ، قَالَ : حدَّثَنِی خَالِی عَبْدُ الرَّحْمَنِ ، عنْ جَدِّی عُقْبَۃَ بْنِ فَاکِہٍ ، قَالَ : أَتَیْتُ زَیْدَ بْنَ ثَابِتٍ نِصْفَ النَّہَارِ فَاسْتَأْذَنْت عَلَیْہِ فَخَرَجَ مُتَّزِرًا ، بِیَدِہِ عَصَی فَقُلْت : أَیْنَ کُنْت فِی ہَذِہِ السَّاعَۃِ ؟ فَقَالَ : کُنْت أَتْبَعُ ہَذِہِ الدَّابَّۃَ ، یَکْتُبُ اللَّہُ بِقَتْلِہَا الْحَسَنَۃَ وَیَمْحُو بِہِ السَّیِّئَۃَ فَاقْتُلْہَا ، وَہِیَ الْوَزَغُ۔ (ابن ماجہ ۱۳۱۶۔ احمد ۴/۷۸)","Da'if","Musannaf Ibn Abi Shaybah 20253","","","كتاب الصيد"
"20254","(۲۰۲۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَۃَ أَنَّہَا کَانَتْ تَقْتُلُ الأَوْزَاغَ۔","Sahih","Musannaf Ibn Abi Shaybah 20254","","","كتاب الصيد"
"20255","(۲۰۲۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ أَنَّہَا کَانَتْ تَفْعَلُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20255","","","كتاب الصيد"
"20256","(۲۰۲۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَبِیبِ بْنِ أَبِی عَمْرَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : مَنْ قَتَلَ وَزَغَۃً کَانَتْ لَہُ بِہَا صَدَقَۃٌ۔","","Musannaf Ibn Abi Shaybah 20256","","","كتاب الصيد"
"20257","(۲۰۲۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ ، قَالَ : مَنْ قَتَلَ وَزَغَۃً کُفِّرَ عَنْہُ سَبْعَ خَطِیئَاتٍ۔","","Musannaf Ibn Abi Shaybah 20257","","","كتاب الصيد"
"20258","(۲۰۲۵۸) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، حَدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ نَافِعٍ ، عَنْ سَائِبَۃٍ مَوْلاَۃٍ لِفَاکِہِ بْنِ الْمُغِیرَۃِ أَنَّہَا دَخَلَتْ عَلَی عَائِشَۃَ فَرَأَتْ فِی بَیْتِہَا رُمْحًا مَوْضُوعًا ، فَقَالَتْ : یَا أُمَّ الْمُؤْمِنِینَ ، مَا تَصْنَعِینَ بِہَذَا ؟ قَالَتْ : نَقْتُلُ بِہَا ہَذِہِ الأَوْزَاغَ ، فَإِنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَخْبَرَنَا أَنَّ إبْرَاہِیمَ خَلِیلَ اللہِ لَمَّا أُلْقِیَ فِی النَّارِ لَمْ تَکُنْ دَابَّۃٌ فِی الأَرْضِ إِلاَّ أَطْفَأَتِ النَّارَ عَنْہُ غَیْرَ الْوَزَغِ ، فَأَنَّہُ کَانَ یَنْفُخُ عَلَیْہِ ، فَأَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِقَتْلِہِ۔ (ابن ماجہ ۳۲۳۱۔ احمد ۶/۱۰۹)","Da'if","Musannaf Ibn Abi Shaybah 20258","","","كتاب الصيد"
"20259","(۲۰۲۵۹) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ مُوسَی بْنِ یَعْقُوبَ ، قَالَ أَخْبَرَتْنِی عَمَّتِی قُرَیْبَۃُ بِنْتُ عَبْدِ اللہِ بْنِ وَہْبٍ ، قَالَتْ : کَانَتْ أُمُّ سَلَمَۃَ تَأْمُرُ بِقَتْلِ الْوَزَغِ۔","Da'if","Musannaf Ibn Abi Shaybah 20259","","","كتاب الصيد"
"20260","(۲۰۲۶۰) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : اقْتُلُوا الْوَزَغَ فِی الْحِلِّ وَالْحَرَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 20260","","","كتاب الصيد"
"20261","(۲۰۲۶۱) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ أبی الْعُمیس ، عن أبیہ ، قَالَ : کانت لعائشۃ قناۃ تقتل بہا الوزغ۔","Da'if","Musannaf Ibn Abi Shaybah 20261","","","كتاب الصيد"
"20262","(۲۰۲۶۲) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ عُثْمَانَ بْنِ الأَسْوَدِ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَانَ یَأْمُرُ بِقَتْلِ الْوَزَغِ۔","","Musannaf Ibn Abi Shaybah 20262","","","كتاب الصيد"
"20263","(۲۰۲۶۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، قَالَ : کُنَّا مَعَ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فِی غَارٍ وَقَدْ أُنْزِلَتْ عَلَیْہِ : {وَالْمُرْسَلاَتِ عُرْفًا} قَالَ : فَنَحْنُ نَأْخُذُہَا مِنْ فِیہِ رَطْبَۃً إذْ دَخَلَتْ عَلَیْنَا حَیَّۃٌ ، فَقَالَ لَنَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : اقْتُلُوہَا ، فَابْتَدَرْنَا لَہَا لِنَقْتُلَہَا فَسَبَقَتْنَا بِنَفْسہَا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : وَقَاہَا اللَّہُ شَرَّکُمْ کَمَا وَقَاکُمْ شَرَّہَا۔ n(بخاری ۱۸۳۰۔ مسلم ۱۳۷)","Sahih","Musannaf Ibn Abi Shaybah 20263","","","كتاب الصيد"
"20264","(۲۰۲۶۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : اقْتُلُوا الْحَیَّاتِ کُلَّہَا عَلَی کُلِّ حَالٍ۔","","Musannaf Ibn Abi Shaybah 20264","","","كتاب الصيد"
"20265","(۲۰۲۶۵) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ عُبَیْد بْنِ عُمَیْرٍ ، عَنْ أبِی الطُّفَیْلِ ، عَنْ عَلِیِّ بْنِ أَبِی طَالِبٍ ، أَنَّہُ کَانَ یَأْمُرُ بِقَتْلِ الْحَیَّاتِ ذِی الطُّفْیتین۔","","Musannaf Ibn Abi Shaybah 20265","","","كتاب الصيد"
"20266","(۲۰۲۶۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُسْلِمٍ ، عَنْ أَبِی صَالِحٍ ، قَالَ عُمَرُ : أَصْلِحُوا مَثَاوِیکُمْ وَأَخِیفُوا الْہَوَامَّ قَبْلَ أَنْ تُخِیفَکُمْ ، فَإِنَّہُ لاَ یَظْہَرُ لَکُمْ مِنْہُنَّ مُسْلِمٌ۔","","Musannaf Ibn Abi Shaybah 20266","","","كتاب الصيد"
"20267","(۲۰۲۶۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عَبْدُ اللہِ : مَنْ قَتَلَ حَیَّۃً قَتَلَ کَافِرًا۔","","Musannaf Ibn Abi Shaybah 20267","","","كتاب الصيد"
"20268","(۲۰۲۶۸) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ أَبِی قَیْسٍ ، عَنْ عَلْقَمَۃَ ، قَالَ : قَالَ عَبْدُ اللہِ : اقْتُلُوا الْحَیَّاتِ کُلَّہَا ، إِلاَّ الَّذِی کَأَنَّہُ مُلمُولٌ ، فَإِنَّہُ جِنُّہَا۔","Hasan","Musannaf Ibn Abi Shaybah 20268","","","كتاب الصيد"
"20269","(۲۰۲۶۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَقْتُلُ الجان ، وَیَأْمُرُ بِقَتْلِہَا وَیَقُولُ : الْجَانُّ مِسخُ الْجِنِّ کَمَا مُسِخَتِ الْقِرَدَۃُ مِنْ بَنِی إسْرَائِیلَ۔","Sahih","Musannaf Ibn Abi Shaybah 20269","","","كتاب الصيد"
"20270","(۲۰۲۷۰) حَدَّثَنَا وَکِیعٌ، عَنْ عِمْرَانَ بْنِ حُدَیْرٍ، عَنْ عِکْرِمَۃَ، قَالَ: کَانَ ابْنُ عُمَرَ یَأْمُرُ بِقَتْلِ الْحَیَّاتِ، ثُمَّ أُمِرَ بِنَبْذِہِنَّ۔","Sahih","Musannaf Ibn Abi Shaybah 20270","","","كتاب الصيد"
"20271","(۲۰۲۷۱) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ أَشْعَثَ ، قَالَ : کَانَ الْحَسَنُ وَمُحَمَّدٌ یَأْمُرَانِ بِقَتْلِ الْحَیَّاتِ إِلاَّ الْجَانَّ الَّذِی کَأَنَّہُ قَصَبَۃُ فِضَّۃٍ۔","","Musannaf Ibn Abi Shaybah 20271","","","كتاب الصيد"
"20272","(۲۰۲۷۲) حَدَّثَنَا ابْنُ فضیل ، عن مغیرۃ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَأْمَرُونُ بِقَتْلِ الْحَیَّاتِ إِلاَّ الْجَانَّ الَّذِی کَأَنَّہُ قَضِیبُ فِضَّۃٍ۔","","Musannaf Ibn Abi Shaybah 20272","","","كتاب الصيد"
"20273","(۲۰۲۷۳) حَدَّثَنَا خلف ابْنُ خَلِیفَۃَ ، عَنِ أَبِی طَلْحَۃَ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : سَأَلْتُہ عَنْ قَتْلِ الْحَیَّاتِ ؟ فَقَالَ : وَدِدْت أَنِّی وَجَدْت مَنْ یَتَّبِعُہُنَّ فَیَقْتُلُہُنَّ ، وَنُعْطِیہ عَنْ ذَلِکَ أَجْرًا۔","","Musannaf Ibn Abi Shaybah 20273","","","كتاب الصيد"
"20274","(۲۰۲۷۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی قَیْسٍ ، عَنْ عَلْقَمَۃَ ، قَالَ : مَا یَضُرُّ أَحَدَکُمْ قَتَلَ حَیَّۃً ، أَوْ قَتَلَ کَافِرًا إِلاَّ الَّذِی کَأَنَّہُ مَیَلٌ ، فَإِنَّہُ جِنُّہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20274","","","كتاب الصيد"
"20275","(۲۰۲۷۵) حَدَّثَنَا عَبْدَۃُ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، عَنْ عَائِشَۃَ ، قَالَتْ : أَمَرَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِقَتْلِ ذِی الطفیتین ، فَإِنَّہُ یَلْتمس الْبَصَرَ ، وَیُصِیبُ الْحَمْلَ یَعْنِی حَیَّۃً خَبِیثَۃً۔ (بخاری ۳۳۰۸۔ مسلم ۱۲۷)","Sahih","Musannaf Ibn Abi Shaybah 20275","","","كتاب الصيد"
"20276","(۲۰۲۷۶) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ ثَابِتٍ الْبُنَانِیِّ ، قَالَ : قَالَ عَبْدُ الرَّحْمَنِ بْنُ أَبِی لَیْلَی : قَالَ أَبُو لَیْلَی : جَائَ رَجُلٌ إلَی النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَسَأَلَہُ عَنِ الْحَیَّاتِ فِی الْبُیُوتِ ؟ فَقَالَ : إِنْ رَأَیْتُمُوہُنَّ فِی مَسَاکِنِکُمْ ، فَقُولُوا لَہُنَّ : نَنْشُدُکُمْ بِالْعَہْدِ الَّذِی أَخَذَ عَلَیْکُمْ نُوحٌ ، نَنْشُدُکُمْ بِالْعَہْدِ الَّذِی أَخَذَ عَلَیْکُمْ سُلَیْمَانُ بْنُ دَاوُد ، أَنْ لاَ تُؤْذُونَا ، فَإِنْ رَأَیْتُمْ مِنْہُنَّ شَیْئًا فَاقْتُلُوہُنَّ۔ (ترمذی ۱۴۸۵۔ ابوداؤد ۵۲۱۸)","Da'if","Musannaf Ibn Abi Shaybah 20276","","","كتاب الصيد"
"20277","(۲۰۲۷۷) حَدَّثَنَا زَیْدُ بْنُ حُبَابٍ ، عَنْ دَاوُدَ بْنِ أَبِی الْفُرَاتِ ، عَنْ مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ أَبِی الأَعْیَنِ الْعَبْدِیِّ ، عَنْ أَبِی الأَحْوَص ، عَنْ عَبْدِ اللہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ قَتَلَ حَیَّۃً قَتَلَ کَافِرًا۔n(احمد ۳۹۴۔ بزار ۱۸۴۷)","Da'if","Musannaf Ibn Abi Shaybah 20277","","","كتاب الصيد"
"20278","(۲۰۲۷۸) حَدَّثَنَا أَبُو دَاوُدَ الْحَفْرِیُّ عُمَرُ بْنُ سَعد ، عَنْ سُفْیَانَ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنْ قَتَلَ حَیَّۃً قَتَلَ کَافِرًا۔","Sahih","Musannaf Ibn Abi Shaybah 20278","","","كتاب الصيد"
"20279","(۲۰۲۷۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : مَنْ قَتَلَ حَیَّۃً فَقَدْ قَتَلَ عَدُوًّا کَافِرًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20279","","","كتاب الصيد"
"20280","(۲۰۲۸۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ عَائِشَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِقَتْلِ الْکِلاَبِ۔ (ابن ماجہ ۳۶۵۱۔ احمد ۶/۱۴۳)","Hasan","Musannaf Ibn Abi Shaybah 20280","","","كتاب الصيد"
"20281","(۲۰۲۸۱) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ مُوسَی بْنِ عُبَیْدَۃَ ، عَنْ أَبَانَ بْنِ صَالِحٍ ، عَنِ الْقَعْقَاعِ بن حَکِیمٍ ، عَنْ سَلْمَی أُمِّ رَافِعٍ ، عَنْ أَبِی رَافِعٍ ، قَالَ : أَمَرَنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حِینَ أَصْبَحَ ، فَلَمْ أَدَعْ کَلْبًا إِلاَّ قَتَلْتہ۔n(طحاوی ۵۳۔ احمد ۶/۳۹۱)","Da'if","Musannaf Ibn Abi Shaybah 20281","","","كتاب الصيد"
"20282","(۲۰۲۸۲) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِقَتْلِ الْکِلاَبِ ، حَتَّی قَتَلْنَا کَلْبَ امْرَأَۃٍ جَائَتْ بِہِ مِنَ الْبَادِیَۃِ۔ (بخاری ۳۳۲۳۔ مسلم ۱۲۰۰)","Sahih","Musannaf Ibn Abi Shaybah 20282","","","كتاب الصيد"
"20283","(۲۰۲۸۳) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی التَّیَّاحِ ، قَالَ : سَمِعْتُ مُطَرِّفًا یُحَدِّثُ عَنِ ابْنِ مُغَفَّلٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِقَتْلِ الْکِلاَبِ ، ثُمَّ قَالَ : مَا لَہُمْ وَلِلْکِلاَبِ ، ثُمَّ رَخَّصَ فِی کَلْبِ الصَّیْدِ۔n(مسلم ۹۳۔ ابوداؤد ۷۵)","Sahih","Musannaf Ibn Abi Shaybah 20283","","","كتاب الصيد"
"20284","(۲۰۲۸۴) حَدَّثَنَا شَبَابَۃُ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الْحَارِثِ ، عَنْ کُرَیْبٍ ، عَنْ أُسَامَۃَ ، قَالَ : دَخَلْتُ عَلَی رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وعلیہ الْکَآبَۃَ فَقُلْتُ : مَا لَکَ یَا رَسُولَ اللہِ ؟ قَالَ : إنَّ جِبْرِیلَ عَلَیْہِ السَّلاَمُ وَعَدَنِی أَنْ یَأْتِیَنِی فلم یأتینی مُنْذُ ثَلاَثٍ ، قَالَ : فأجاز کَلْبٌ ، قَالَ أُسَامَۃُ : فَوَضَعْت یَدِی عَلَی رَأْسِی وَصِحْت ، فَجَعَلَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَا لَکَ یَا أُسَامَۃَ ؟ فَقُلْت : أجاز کَلْبٌ ، فَأَمَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بِقَتْلِہِ فَقُتِلَ۔ (مسلم ۸۲۔ طبرانی ۳۸۷)","Hasan","Musannaf Ibn Abi Shaybah 20284","","","كتاب الصيد"
"20285","(۲۰۲۸۵) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّ عُثْمَانَ أَمَرَ بِقَتْلِ الْکِلاَبِ وَذَبْحِ الْحَمَامِ۔","Sahih","Musannaf Ibn Abi Shaybah 20285","","","كتاب الصيد"
"20286","(۲۰۲۸۶) حَدَّثَنَا یُونُسُ بْنُ مُحَمَّدٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِقَتْلِ الْکِلاَبِ حَتَّی إِنَّ الْمَرْأَۃَ کَانَتْ تَدْخُلُ بِالْکَلْبِ فَیُقْتَلُ قَبْلَ أَنْ تَخْرُجَ ، قَالَ : لَوْلا أَنَّ الْکِلاَبَ أُمَّۃٌ مِنَ الأُمَمِ لأَمَرْتُ بِقَتْلِہَا فَاقْتُلُوا مِنْہَا کُلَّ أَسْوَدَ بَہِیمٍ الَّذِی بَیْنَ عَیْنَیْہِ نُقْطَتَانِ ، فَإِنَّہُ شَیْطَانٌ۔n(مسلم ۴۷۔ ابوداؤد ۲۸۴۰)","Sahih","Musannaf Ibn Abi Shaybah 20286","","","كتاب الصيد"
"20287","(۲۰۲۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بِقَتْلِ الْکِلاَبِ۔ (مسلم ۴۴۔ احمد ۲/۱۱۳)","Sahih","Musannaf Ibn Abi Shaybah 20287","","","كتاب الصيد"
"20288","(۲۰۲۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ مَرَّ علَی حِمَارٍ یُوسَمُ فِی وَجْہِہِ ، فَقَالَ : أَلَمْ أَنْہَ عَنْ ہَذَا ؟ لَعَنَ اللَّہُ مَنْ فَعَلَ ہَذَا۔ (مسلم ۱۰۶۔ ابوداؤد ۲۵۵۷)","Sahih","Musannaf Ibn Abi Shaybah 20288","","","كتاب الصيد"
"20289","(۲۰۲۸۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُضْرَبَ وَجْہُ الدَّابَّۃِ۔","","Musannaf Ibn Abi Shaybah 20289","","","كتاب الصيد"
"20290","(۲۰۲۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، أنہ کرہ أن تُعْلَمَ الصورۃ۔","Sahih","Musannaf Ibn Abi Shaybah 20290","","","كتاب الصيد"
"20291","(۲۰۲۹۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ تُضْرَبَ الصُّورَۃُ۔ (بخاری ۵۵۴۱۔ احمد ۲/۱۱۸)","Sahih","Musannaf Ibn Abi Shaybah 20291","","","كتاب الصيد"
"20292","(۲۰۲۹۲) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَطِیَّۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : رَآنِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی حِمَارٍ مَوْسُومٍ بَیْن عَیْنَیْہِ فَکَرِہَ ذَلِکَ ، وَقَالَ فِیہِ قَوْلاً شَدِیدًا۔","Da'if","Musannaf Ibn Abi Shaybah 20292","","","كتاب الصيد"
"20293","(۲۰۲۹۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنِ الضَّرْبِ فِی الْوَجْہِ ، وَعَنِ الْوَسْمِ فِی الْوَجْہِ۔ (مسلم ۱۰۶)","Sahih","Musannaf Ibn Abi Shaybah 20293","","","كتاب الصيد"
"20294","(۲۰۲۹۴) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَشِ ، عَنْ إبْرَاہِیمَ ، قَالَ : قَالَ عُمَرُ : لاَ یُلْطَمُ الْوَجْہُ ، وَلاَ یُوسَمُ۔","","Musannaf Ibn Abi Shaybah 20294","","","كتاب الصيد"
"20295","(۲۰۲۹۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : نُہِی عَنْ وَسْمِہَا فِی وَجْہِہَا۔","","Musannaf Ibn Abi Shaybah 20295","","","كتاب الصيد"
"20296","(۲۰۲۹۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُکْرَہُ أَنْ تُوسَمَ الْعَجْمَائُ عَلَی خَدِّہَا ، أَوْ تُلْطَمَ ، أَوْ تُجَرَّ بِرِجْلِہَا إلَی مَذْبَحِہَا۔","","Musannaf Ibn Abi Shaybah 20296","","","كتاب الصيد"
"20297","(۲۰۲۹۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لِکُلِّ شَیْئٍ حُرْمَۃٌ ، وَحُرْمَۃُ الْبَہَائِمِ وُجُوہُہَا۔","","Musannaf Ibn Abi Shaybah 20297","","","كتاب الصيد"
"20298","(۲۰۲۹۸) حَدَّثَنَا ابْنُ نُمَیْرٍ ، حَدَّثَنَا عُثْمَانَ بْنُ حَکِیمٍ قَالَ : أَخْبَرَنِی عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ یَعْلَی بْنِ مُرَّۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ لِرَجُلٍ : ہَبْہُ لِی ، أَوَ قَالَ بِعْنِیہِ یَعْنِی جَمَلاً ، قَالَ : ہُوَ لَکَ یَا رَسُولَ اللہِ ، فَوَسَمَہُ سِمَۃَ الصَّدَقَۃِ ، ثُمَّ بَعَثَ بِہِ۔ (احمد ۴/۱۷۳۔ طبرانی ۶۹۴)","Da'if","Musannaf Ibn Abi Shaybah 20298","","","كتاب الصيد"
"20299","(۲۰۲۹۹) حَدَّثَنَا شَرِیکٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : لاَ بَأْسَ فِی السِّمَۃِ فِی مُؤَخَّرِ الأُذُنِ۔","","Musannaf Ibn Abi Shaybah 20299","","","كتاب الصيد"
"20300","(۲۰۳۰۰) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عن یحیی بن سعید، عن سعید بن المسیب، قَالَ: لاَ بأس بالسمۃ فی الأذن۔","","Musannaf Ibn Abi Shaybah 20300","","","كتاب الصيد"
"20301","(۲۰۳۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ مُحَمَّدِ بْنِ زِیَادٍ ، قَالَ : مَرَّ ابْنُ عُمَرَ بِأَبِی وَہُوَ یَسِمُ وَسْمَ قُدَامَۃَ بْنِ مَظْعُونٍ ، فَقَالَ : ابْنُ عُمَرَ : لاَ تُلْحِمْ لاَ تُلْحِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 20301","","","كتاب الصيد"
"20302","(۲۰۳۰۲) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ ہِشَامِ بْنِ زَیْدٍ ، قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِکٍ یَقُولُ : رَأَیْت رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَہُوَ فِی الْمِرْبَدِ یَسِمُ غَنَمًا لَہُ ، أَحْسَبُہُ قَالَ : فِی آذَانہَا۔n(بخاری ۵۵۴۲۔ مسلم ۱۰۹)","Sahih","Musannaf Ibn Abi Shaybah 20302","","","كتاب الصيد"
"20303","(۲۰۳۰۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ إِسْحَاقَ بْنِ سُلَیْمَانَ ، عَنْ أَبِیہِ ، قَالَ: سَأَلْتُ الشَّعْبِیَّ، عَنْ وَسْمِ الْغَنَمِ فِی آذَانِہَا، فَلَمْ یَرَ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20303","","","كتاب الصيد"
"20304","(۲۰۳۰۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، قَالَ : ذَہَبْت مَعَ ابْنِ عُمَرَ إلَی بَنِی مُعَاوِیَۃَ فَنَبَحَتْ عَلَیْنَا کِلاَبٌ ، فَقَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنِ اقْتَنَی کَلْبًا إِلاَّ کَلْبَ ضَارِیَۃٍ ، أَوْ مَاشِیَۃٍ نَقَصَ مِنْ أَجْرِہِ کُلَّ یَوْمٍ قِیرَاطَانِ۔ (بخاری ۵۴۸۰۔ مسلم ۵۲)","Sahih","Musannaf Ibn Abi Shaybah 20304","","","كتاب الصيد"
"20305","(۲۰۳۰۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ اقْتَنَی کَلْبًا ، إِلاَّ کَلْبَ صَیْدٍ ، أَوْ مَاشِیَۃٍ ، نَقَصَ مِنْ أَجْرِہِ کُلَّ یَوْمٍ قِیرَاطَانِ۔ (مسلم ۵۱۔ احمد ۸)","Sahih","Musannaf Ibn Abi Shaybah 20305","","","كتاب الصيد"
"20306","(۲۰۳۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، عَنْ سَالِمٍ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنِ اقْتَنَی کَلْبًا إِلاَّ کَلْبَ صَیْدٍ ، أَوْ مَاشِیَۃٍ نَقَصَ مِنْ أَجْرِہِ کُلَّ یَوْمٍ قِیرَاطَانِ ، قَالَ : وَقَالَ سَالِمٌ : وَقَالَ أَبُو ہُرَیْرَۃَ: أَوْ کَلْبَ حَرْثٍ۔ (بخاری ۵۴۸۱۔ مسلم ۵۴)","Sahih","Musannaf Ibn Abi Shaybah 20306","","","كتاب الصيد"
"20307","(۲۰۳۰۷) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ زَادَ فِیہِ : أَوْ کَلْبَ مَخَافَۃٍ۔","Da'if","Musannaf Ibn Abi Shaybah 20307","","","كتاب الصيد"
"20308","(۲۰۳۰۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ زِرٍّ ، عَنْ عَبْدِ اللہِ ، قَالَ : مَنِ اقْتَنَی کَلْبًا إِلاَّ کَلْبَ قَنْصٍ ، أَوْ مَاشِیَۃٍ نَقَصَ مِنْ أَجْرِہِ کُلَّ یَوْمٍ قِیرَاطان۔ (ابو یعلی ۵۰۲۵)","Da'if","Musannaf Ibn Abi Shaybah 20308","","","كتاب الصيد"
"20309","(۲۰۳۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ عمر بن الولید الشَّنِّی ، عن عکرمۃ قَالَ : إلا کلب زرع ، أو کلب قنص ، أو کلب ماشیۃ ، أو کلب مخافۃ۔","No Data Available","Musannaf Ibn Abi Shaybah 20309","","","كتاب الصيد"
"20310","(۲۰۳۱۰) حَدَّثَنَا عبد الأعلی ، عن برد ، عن مکحول ، قَالَ : من اقتنی کلبا لیس بکلب صید أو ماشیۃ ؛ نقص من أجر أہل بیتہ کل یوم قیراط۔","","Musannaf Ibn Abi Shaybah 20310","","","كتاب الصيد"
"20311","(۲۰۳۱۱) حَدَّثَنَا عَفَّانُ ، حَدَّثَنَا سُلَیْمُ بْنُ حَیَّانَ ، قَالَ : سَمِعْتُ أَبِی یُحَدِّثُ ، عَنْ أَبِی ہُرَیْرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : مَنِ اتَّخَذَ کَلْبًا لَیْسَ بِکَلْبِ الزَّرْعِ ، وَلاَ صَیْدٍ ، وَلاَ مَاشِیَۃٍ فإنہ ینْقُصُ مِنْ أَجْرِہِ کُلَّ یَوْمٍ قِیرَاطٌ۔ (بخاری ۲۳۲۲۔ مسلم ۵۸)","Da'if","Musannaf Ibn Abi Shaybah 20311","","","كتاب الصيد"
"20312","(۲۰۳۱۲) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ یَزِیدَ بْنِ خُصَیْفَۃَ ، عَنِ السَّائِبِ بْنِ یَزِیدَ ، عَنْ سُفْیَانَ بْنِ أَبِی زُہَیْرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : مَنِ اقْتَنَی کَلْبًا لاَ یُغْنِی عَنْہُ زَرْعا ، وَلاَ ضَرْعا نَقَصَ مِنْ أَجْرِہِ کُلَّ یَوْمٍ قِیرَاطٌ۔ (بخاری ۳۳۲۵۔ مسلم ۶۱)","Hasan","Musannaf Ibn Abi Shaybah 20312","","","كتاب الصيد"
"20313","(۲۰۳۱۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: مَنِ اقْتَنَی کَلْبًا نَقَصَ مِنْ أَجْرِہِ کُلَّ یَوْمٍ قِیرَاطٌ۔ (مسلم ۵۰۔ ترمذی ۱۴۸۷)","Sahih","Musannaf Ibn Abi Shaybah 20313","","","كتاب الصيد"
"20314","(۲۰۳۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ أَبِیہِ ، قَالَ : رُخِّصَ فِی الْکِلاَبِ فِی بَیْتِ الْمُعْوِرِ۔","","Musannaf Ibn Abi Shaybah 20314","","","كتاب الصيد"
"20315","(۲۰۳۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ أَبِی یَزِیدَ ، عَنْ أَبِی الفُضَیل ، قَالَ : کَانَ أَنَسٌ یَأْتِینَا وَمَعَہُ کَلْبٌ لَہُ ،فقلنا لہ ، فَقَالَ : إِنَّہُ یَحْرُسُنَا۔","Da'if","Musannaf Ibn Abi Shaybah 20315","","","كتاب الصيد"
"20316","(۲۰۳۱۶) حَدَّثَنَا عَبْدَۃُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَتَّخِذُ کَلْبًا یَحْرُسُ دَارِہِ ، فَقَالَ : لاَ خَیْرَ فِیہِ إِلاَّ أَنْ یَکُونَ کَلْبَ صَیْدٍ۔","","Musannaf Ibn Abi Shaybah 20316","","","كتاب الصيد"
"20317","(۲۰۳۱۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُبَیْدِ اللہِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ أَبِی طَلْحَۃَ ، عنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ صُورَۃٌ ، وَلاَ کَلْبٌ۔ (بخاری ۳۳۲۲۔ مسلم ۱۶۶۵)","Sahih","Musannaf Ibn Abi Shaybah 20317","","","كتاب الصيد"
"20318","(۲۰۳۱۸) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ حُسَیْنِ بْنِ وَاقِدٍ ، عَنِ ابْنِ بُرَیْدَۃَ ، عَنْ أَبِیہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ کَلْبٌ۔ (احمد ۵/۳۵۳)","Hasan","Musannaf Ibn Abi Shaybah 20318","","","كتاب الصيد"
"20319","(۲۰۳۱۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، قَالَ : أَخْبَرَنَا اللَّیْثُ بْنُ سَعْدٍ ، قَالَ : أَخْبَرَنِی بُکَیْر بْنُ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ بُسْرِ بْنِ سَعِیدٍ ، عَنْ زَیْدِ بْنِ خَالِدٍ ، عَنْ أَبِی طَلْحَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ کَلْبٌ ، وَلاَ صُورَۃٌ۔ (بخاری ۵۹۵۸۔ مسلم ۸۵)","Sahih","Musannaf Ibn Abi Shaybah 20319","","","كتاب الصيد"
"20320","(۲۰۳۲۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَلِیِّ بْنِ مُدْرِکٍ ، عَنْ أَبِی زُرْعَۃَ ، عَنْ عَبْدِ اللہِ بْنِ نُجَی ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، أَنَّہُ قَالَ : لاَ تَدْخُلُ الْمَلاَئِکَۃُ بَیْتًا فِیہِ کَلْبٌ ، وَلاَ صُورَۃٌ۔n(ابوداؤد ۲۲۹۔ احمد ۱/۸۳)","Hasan","Musannaf Ibn Abi Shaybah 20320","","","كتاب الصيد"
"20321","(۲۰۳۲۱) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُکْرَہُ أَنْ یَرْمِی طَیْرَ جارہ ، وَإِذَا رَمَاہُ فَعَلَیْہِ ثَمَنُہُ۔","","Musannaf Ibn Abi Shaybah 20321","","","كتاب الصيد"
"20322","(۲۰۳۲۲) حَدَّثَنَا وَکِیعٌ، عَنْ فُضَیْلِ بْنِ غَزْوَانَ، قَالَ: سَمِعْتُ رَجُلاً یَسْأَلُ نَافِعًا عَنْ صَیْدِ حَمَامِ الْمَدِینَۃِ فَکَرِہَہَا۔","","Musannaf Ibn Abi Shaybah 20322","","","كتاب الصيد"
"20323","(۲۰۳۲۳) حَدَّثَنَا أَبُو أُسَامَۃَ ، أَوْ حُدِّثْتُ عَنْہُ ، عَنْ عُثْمَانَ بْنِ غِیَاثٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ صَیْدَ حَمَامِ المدینۃ وَالْأَمْصَارِ۔","","Musannaf Ibn Abi Shaybah 20323","","","كتاب الصيد"
"20324","(۲۰۳۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ أَنْ یُحَالَ الرَّجُلُ یَعْنِی : یَأْذَنَ ہَذَا لِہَذَا فِی حَمَامِہِ وَہَذَا لِہَذَا فِی حَمَامِہِ۔","","Musannaf Ibn Abi Shaybah 20324","","","كتاب الصيد"
"20325","(۲۰۳۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ فُضَیْلٍ ، عَنْ نَافِعٍ ، أَنَّہُ کَرِہَ صَیْدَ حَمَامِ الأَمْصَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20325","","","كتاب الصيد"
"20326","(۲۰۳۲۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، قَالَ : سَأَلْتُ ابْنَ أَبِی لَیْلَی ، عَنْ رَجُلٍ أَصَابَ صَیْدًا بِالْمَدِینَۃِ ، فَقَالَ : یُحْکَمُ عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 20326","","","كتاب الصيد"
"20327","حدثنا أبو عبد الرحمن قال حدثنا أبو بکر ، عبد اللہ بن محمد بن أبی شیبۃ ، قَالَ :n(۲۰۳۲۷) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنْ أَصْحَابِ إِبْرَاہِیمَ ، عَن إبْرَاہِیمَ ، وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَالشَّعْبِیِّ ؛ فِی الشَّرِیکَیْنِ ، قَالاَ : الشَّرِکَۃُ عَلَی مَا اصْطَلَحَا عَلَیْہِ وَالْوَضِیعَۃُ عَلَی الْمَالِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20327","","","كتاب البيوع والأقضية"
"20328","(۲۰۳۲۸) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : إذَا اشْتَرَی الرَّجُلُ الْمَتَاعَ وَأَشْرَکَ فِیہِ أَحَدًا فَالرِّبْحُ عَلَی مَا اشْتَرَطَا عَلَیْہِ وَالْوَضِیعَۃُ عَلَی الْمَالِ۔","","Musannaf Ibn Abi Shaybah 20328","","","كتاب البيوع والأقضية"
"20329","(۲۰۳۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سفیان ، عن عَاصِمٍ الأحْوَلِ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، وَعَنْ سُفْیَانَ ، عَنْ ہِشَامٍ أَبِی کُلَیْبٍ ، عَنْ إبْرَاہِیمَ فِی الشَّرِیکَیْنِ یُخْرِجُ ہَذَا مِئَۃ وَہَذَا مِئَتَیْنِ ، قَالاَ : الرِّبْحُ عَلَی مَا اصْطَلَحَا عَلَیْہِ وَالْوَضِیعَۃُ عَلَی الْمَالِ۔","","Musannaf Ibn Abi Shaybah 20329","","","كتاب البيوع والأقضية"
"20330","(۲۰۳۳۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ، قَالاَ : الرِّبْحُ عَلَی مَا اشْتَرَطَا عَلَیْہِ وَالْوَضِیعَۃُ عَلَی الْمَالِ","","Musannaf Ibn Abi Shaybah 20330","","","كتاب البيوع والأقضية"
"20331","(۲۰۳۳۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ، قَالَ : الرِّبْحُ عَلَی مَا اشْتَرَطَا عَلَیْہِ وَالْوَضِیعَۃُ عَلَی رَأْسِ الْمَالِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20331","","","كتاب البيوع والأقضية"
"20332","(۲۰۳۳۲) حدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ مِثْلَ ذَلِکَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20332","","","كتاب البيوع والأقضية"
"20333","(۲۰۳۳۳) حَدَّثَنَا ہُشَیْمٌ، عَنْ یُونُسَ، عَنِ الْحَسَنِ، قَالَ: الرِّبْحُ عَلَی مَا اشْتَرَطَا عَلَیْہِ وَالْوَضِیعَۃُ عَلَی رَأْسِ الْمَالِ۔","","Musannaf Ibn Abi Shaybah 20333","","","كتاب البيوع والأقضية"
"20334","(۲۰۳۳۴) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا وَقَتَادَۃَ ، عَنْ رَجُلَیْنِ اشْتَرَکَا ، فَجَائَ أَحَدُہُمَا بِأَلْفَیْنِ ، وَجَائَ الآخَرُ بِأَلْفٍ فَاشْتَرَکَا وَاشْتَرَطَا ، أَنَّ الْوَضِیعَۃَ بَیْنَہُمَا وَالرِّبْحَ نِصْفَینِ ، فَقَالَ : الرِّبْحُ عَلَی مَا اشْتَرَطَا عَلَیْہِ وَالْوَضِیعَۃُ عَلَی الْمَالِ۔","","Musannaf Ibn Abi Shaybah 20334","","","كتاب البيوع والأقضية"
"20335","(۲۰۳۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ شُرَیْحٍ ، أَنَّہُ قَالَ : إذَا وَلاَہُ الرَّجُلُ بِصَفْقَۃٍ بِنَسِیئَۃٍ ، ثُمَّ أَدْخَلَ فِیہَا رَجُلٌ آخَرَ فَالضَّمَانُ عَلَی صَاحِبِ الصَّفْقَۃِ وَلَیْسَ عَلَی شَرِیکِہِ شَیْئٌ مَا لَمْ یَکُنْ نَقْدٌ ، فَإِنْ کَانَ نَقْدٌ فَالْوَضِیعَۃُ عَلَی صَاحِبِ النَّقْدِ ، وَالرِّبْحُ عَلَی مَا اصْطَلَحَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 20335","","","كتاب البيوع والأقضية"
"20336","(۲۰۳۳۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی حَصِینٍ ، عَنْ عَلِیٍّ فِی الْمُضَارَب ، أَوِ الشَّرِیکَیْنِ ، قَالَ سُفْیَانُ : لاَ أَدْرِی أَیَّہُمَا قَالَ ، الرِّبْحُ عَلَی مَا اصْطَلَحَا عَلَیْہِ وَالْوَضِیعَۃُ عَلَی الْمَالِ۔","","Musannaf Ibn Abi Shaybah 20336","","","كتاب البيوع والأقضية"
"20337","(۲۰۳۳۷) حَدَّثَنَا غُنْدَرٌ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حُصَیْنٍ ، قَالَ : سُئِلَ طَاوُوس ، وَأَنَا أَسْمَعُ ، عَنْ شَرِیکَیْنِ اشْتَرَکَا ، أَحَدُہُمَا أَکْثَرُ رَأْسَ مَالٍ وَأَسْنَی فِی الْوَضِیعَۃِ فَقَالَ : طَاوُوس : لاَ یُغْرَمُ وَلَہُ رَأْسُ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 20337","","","كتاب البيوع والأقضية"
"20338","(۲۰۳۳۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ فِیمَنِ اشْتَرَی شَیْئًا لَمْ یَنْظُرْ إلَیْہِ کَائِنًا مَا کَانَ ، قَالَ : ہُوَ بِالْخِیَارِ إِنْ شَائَ أَخَذَ ، وَإِنْ شَائَ تَرَکَ۔","","Musannaf Ibn Abi Shaybah 20338","","","كتاب البيوع والأقضية"
"20339","(۲۰۳۳۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، وَعَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20339","","","كتاب البيوع والأقضية"
"20340","(۲۰۳۴۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ ، وَزَادَ فِیہِ : وَہُوَ بِالْخِیَارِ ، وَإِنْ وَجَدَہُ کَمَا شُرِطَ لَہُ۔","","Musannaf Ibn Abi Shaybah 20340","","","كتاب البيوع والأقضية"
"20341","(۲۰۳۴۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنِ الْحَسَنِ ، قَالَ : مَنِ اشْتَرَی شَیْئًا لَمْ یَرَہُ ، فَہُوَ بِالْخِیَارِ إذَا رَآہُ ، وَقَالَ مُحَمَّدٌ : إذَا کَانَ کَمَا وَصَفَ ، فَہُوَ جَائِزٌ۔","","Musannaf Ibn Abi Shaybah 20341","","","كتاب البيوع والأقضية"
"20342","(۲۰۳۴۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، وَابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : إذَا وَجَدَہُ کَمَا وُصِفَ لَہُ ، فَہُوَ جَائِزٌ ، وَلاَ خِیَارَ لَہُ۔","","Musannaf Ibn Abi Shaybah 20342","","","كتاب البيوع والأقضية"
"20343","(۲۰۳۴۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ مَحْمُولٍ ، مَوْلَی آلِ عُمَارَۃَ ، قَالَ : بِعْتُ مِنْ رَجُلٍ بُرْدَیْنِ وَشَرَطْتُ عَلَیْہِ : إِنْ نَشَرَ أَحَدَہُمَا فَقَدْ وَجَبَ ، فَنَشَرَ أَحَدَہُمَا فَلَمْ یَرْضَہُ ، فَجَائَ یَرُدُّہُمَا فَأَبَیْتُ عَلَیْہِ ، فَخَاصَمْتُہُ إلَی شُرَیْحٍ فَقَالَ : لک الرِّضَی ، وَلَیْسَ لَہُ ، إنَّمَا الْبَیْعُ ، عَنْ تَرَاضٍ۔","","Musannaf Ibn Abi Shaybah 20343","","","كتاب البيوع والأقضية"
"20344","(۲۰۳۴۴) حَدَّثَنَا إسْمَاعِیلُ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ اللہِ ، عَنْ مَکْحُولٍ ، رَفَعَہُ ، قَالَ : إذَا اشْتَرَی الرَّجُلُ الشَّیْئَ ، لَمْ یَنْظُرْ إلَیْہِ غَائِبًا عَنْہُ ، فَہُوَ بِالْخِیَارِ ، إذَا نَظَرَ إلَیْہِ ، إِنْ شَائَ أَخَذَ ، وَإِنْ شَائَ تَرَکَ۔ (دارقطنی ۸۔ بیہقی ۲۶۸)","","Musannaf Ibn Abi Shaybah 20344","","","كتاب البيوع والأقضية"
"20345","(۲۰۳۴۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ ، قَالَ : إذَا اشْتَرَی الرَّجُلُ الْعِدْلَ مِنَ الْبُرِّ فَنَظَرَ بَعْضُ التُّجَّارِ إلَی بَعْضِہِ ، فَقَدْ وَجَبَ عَلَیْہِ إذَا لَمْ یَرَ عُوَارًا فِیمَا یَنْظُر إلَیْہِ۔","","Musannaf Ibn Abi Shaybah 20345","","","كتاب البيوع والأقضية"
"20346","(۲۰۳۴۶) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا ، عَنْ رَجُلٍ رَأَی عَبْدًا أَمْسِ فَاشْتَرَاہُ الْیَوْمَ ، قَالاَ : لاَ حَتَّی یَرَاہُ یَوْمَ اشْتَرَاہُ۔","","Musannaf Ibn Abi Shaybah 20346","","","كتاب البيوع والأقضية"
"20347","(۲۰۳۴۷) حَدَّثَنَا ہُشَیْم ، عَنْ أَبِی حَمْزَۃ ، قَالَ : قُلْتُ لابْنِ عَبَّاسٍ : إنَّ أبی رَجُل جَلاَّبًا یَجْلُبُ الْغَنَمَ ، وَإِنَّہُ لَیُشَارِکُ الْیَہُودِیَّ ، وَالنَّصْرَانِیَّ ، قَالَ : لاَ یُشَارِکُ یَہُودِیًّا ، وَلاَ نَصْرَانِیًّا ، وَلاَ مَجُوسِیًّا ، قَالَ : قُلْتُ : لِمَ ؟ قَالَ : لأَِنَّہُمْ یُرْبُونَ وَالرِّبَا لاَ یَحِلُّ۔","Da'if","Musannaf Ibn Abi Shaybah 20347","","","كتاب البيوع والأقضية"
"20348","(۲۰۳۴۸) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ تُشَارِکَ الْیَہُودِیَّ ، وَالنَّصْرَانِیَّ ، وَلاَ یَمُرُّوا عَلَیْکَ فِی صَلاَتِکَ ، فَإِنْ فَعَلُوا فَہُمْ مِثْلُ الْکَلْبِ۔","","Musannaf Ibn Abi Shaybah 20348","","","كتاب البيوع والأقضية"
"20349","(۲۰۳۴۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ أَنَّہُ لَمْ یَکُنْ یَرَی بَأْسًا بِشَرِکَۃِ الْیَہُودِیِّ وَالنَّصْرَانِیِّ إذَا کَانَ الْمُسْلِمُ ہُوَ الَّذِی یلی الشِّرَائَ وَالْبَیْعَ۔","","Musannaf Ibn Abi Shaybah 20349","","","كتاب البيوع والأقضية"
"20350","(۲۰۳۵۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سُلَیْمَانَ أَبِی مُحَمَّدٍ النَّاجِی ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ تُعْطِ الذِّمِّیَّ مَالاً مُضَارَبَۃً ، وَخُذْ مِنْہُ مَالاً مُضَارَبَۃً ، فَإِذَا مَرَرْتَ بِأَصْحَابِ صَدَقَۃٍ فَأَعْلِمْہُمْ أَنَّہُ مَالُ ذِمِّیٍّ۔","","Musannaf Ibn Abi Shaybah 20350","","","كتاب البيوع والأقضية"
"20351","(۲۰۳۵۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَسَنِ بْنِ صَالِحٍ ، عَنْ لَیْثٍ ، قَالَ : کَانَ عَطَائٌ ، وَطَاوُوسٌ ، وَمُجَاہِدٌ یَکْرَہُونَ شَرِکَۃَ الْیَہُودِیِّ وَالنَّصْرَانِیِّ إلا إذَا کَانَ الْمُسْلِمُ ہُوَ یلی الشِّرَائَ وَالْبَیْعَ۔","","Musannaf Ibn Abi Shaybah 20351","","","كتاب البيوع والأقضية"
"20352","(۲۰۳۵۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، قَالَ : لاَ تَصْلُحُ مُشَارَکَۃُ الْمُشْرِکِ فِی حَرْثٍ ، وَلاَ بَیْعٍ یَغِیبُ عَلَیْہِ ، لأَنَّ الْمُشْرِکَ یَسْتَحِلُّ فِی دَیْنِہِ الرِّبَا ، وَثَمَنَ الْخِنْزِیرِ۔","","Musannaf Ibn Abi Shaybah 20352","","","كتاب البيوع والأقضية"
"20353","(۲۰۳۵۳) حَدَّثَنَا زَیْدُ بْنُ حُبَاب ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ ، قَالَ : لاَ بَأْسَ بِشَرِکَۃِ الْیَہُودِیِّ وَالنَّصْرَانِیِّ إذَا کُنْتُ تَعْمَلُ بِالْمَالِ۔","","Musannaf Ibn Abi Shaybah 20353","","","كتاب البيوع والأقضية"
"20354","(۲۰۳۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنْ رَجُلٍ ، عَنِ الْحَسَنِ ، قَالَ : خُذْ مِنْہُمْ مَالاً مُضَارَبَۃً ، وَلاَ تَدْفَعُہُ إلَیْہِمْ۔","","Musannaf Ibn Abi Shaybah 20354","","","كتاب البيوع والأقضية"
"20355","(۲۰۳۵۵) حَدَّثَنَا أَبُو الأَحْوَص سَلاَّمُ بْنُ سُلَیْمٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَتَاہُ رَجُلٌ فَقَالَ : إنِّی أَسْلَفْتُ رَجُلاً أَلْفَ دِرْہَمٍ فِی طَعَامٍ ، فَأَخَذْتُ مِنْہُ نِصْفَ سَلَفِی طَعَامًا ، فَبِعْتُہُ بِأَلْفِ دِرْہَمٍ، ثُمَّ أَتَانِی فَقَالَ : خُذْ بَقِیَّۃَ رَأْسِ مَالِکَ : خَمْسَ مِئَۃٍ ، فَقَالَ ابْنُ عَبَّاسٍ : ذَلِکَ الْمَعْرُوفُ ، وَلَہُ أَجْرَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 20355","","","كتاب البيوع والأقضية"
"20356","(۲۰۳۵۶) حَدَّثَنَا جَرِیرٌ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، وَعَطَائٍ ، قَالاَ : قَالَ ابْنُ عَبَّاسٍ ذَلِکَ الْمَعْرُوفُ۔","Da'if","Musannaf Ibn Abi Shaybah 20356","","","كتاب البيوع والأقضية"
"20357","(۲۰۳۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی مُطَرِّفٍ الأَسَدِیِّ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنْ شُرَیْحٍ أَنَّہُ لَمْ یَرَ بَأْسًا أَنْ یَأْخُذَ بَعْضَ سَلَمِہِ وَبَعْضَ رَأْسِ مَالِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20357","","","كتاب البيوع والأقضية"
"20358","(۲۰۳۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ الْحَنَفِیَّۃِ أَنَّہُ لَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20358","","","كتاب البيوع والأقضية"
"20359","(۲۰۳۵۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : لاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 20359","","","كتاب البيوع والأقضية"
"20360","(۲۰۳۶۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنْ عَطَائٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20360","","","كتاب البيوع والأقضية"
"20361","(۲۰۳۶۱) حَدَّثَنَا أَبُو سَعْدٍ مُحَمَّدُ بْنُ مُیَسَّر ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ أَبِی الشَّعْثَائِ ، قَالَ : إِنْ أَسْلَفَ مِئَۃ دِینَارٍ فِی أَلْفِ فَرَْقٍ فَلاَ بَأْسَ أَنْ یَأْخُذَ مِنْہُ خَمْسَ مِئَۃِ فَرَْقٍ ، وَیَکْتُبَ عَلَیْہِ خَمْسِینَ دِینَارًا۔","","Musannaf Ibn Abi Shaybah 20361","","","كتاب البيوع والأقضية"
"20362","(۲۰۳۶۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنِ الْحَکَمِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 20362","","","كتاب البيوع والأقضية"
"20363","(۲۰۳۶۳) حَدَّثَنَا وَکِیعٌ ، حَدَّثَنَا سُفْیَانُ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ رَجُلٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیٍّ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 20363","","","كتاب البيوع والأقضية"
"20364","(۲۰۳۶۴) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ الدَّالاَنِیِّ ، عَنْ مُوسَی بْنِ أبجر ، عَنْ حُمَیْدِ بْنِ عَبْدِ الرَّحْمَنِ ، أَنَّ رَجُلاً أَسْلَمَ دَرَاہِمَ فَأَخَذَ بَعْضَہُ حِنْطَۃً وَبَعْضَہُ دَرَاہِمَ فَقَالَ : لاَ بَأْسَ ، ذَلِکَ الْمَعْرُوفُ۔","","Musannaf Ibn Abi Shaybah 20364","","","كتاب البيوع والأقضية"
"20365","(۲۰۳۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ مَیْسَرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، أَنَّ عَبْدَ اللہِ بْنَ عَمْرٍو کَانَ یُسْلَفُ لَہُ فِی الطَّعَامِ ، فَقَالَ : لِلَّذِی کَانَ یُسْلِفُ لَہُ : لاَ تَأْخُذْ بَعْضَ رأس مَالِنَا وَبَعْضَ طَعَامِنَا ، وَلَکِنْ خُذْ رَأْسَ مَالِنَا کُلَّہُ ، أَوِ الطَّعَامَ وَافِیًا۔","","Musannaf Ibn Abi Shaybah 20365","","","كتاب البيوع والأقضية"
"20366","(۲۰۳۶۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : سَأَلْتُُہُ عَنْ رَجُلٍ یُسْلِمُ السَّلَمَ فَیَأْخُذُ بَعْضَ سَلَمِہِ دَرَاہِمَ وَبَعْضَ سَلَمِہِ طَعَامًا ، فَقَالَ : لاَ تَأْخُذْ إلاَّ رَأْسَ مَالِکَ ، أَوْ طَعَامًا کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 20366","","","كتاب البيوع والأقضية"
"20367","(۲۰۳۶۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20367","","","كتاب البيوع والأقضية"
"20368","(۲۰۳۶۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی عُمَرَ ، عَنِ الْحَسَنِ ، قَالَ : سَأَلْتُُہُ عَنْہُ فَقَالَ : ہَذَا فَاسِدٌ ، لاَ تَأْخُذْ إلاَّ رَأْسَ مَالِکَ ، أَوْ طَعَامًا کُلَّہُ۔","","Musannaf Ibn Abi Shaybah 20368","","","كتاب البيوع والأقضية"
"20369","(۲۰۳۶۹) حَدَّثَنَا جَرِیرٌ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنْ عَبْدِ اللہِ بْنِ مَعْقِلٍ فِی رَجُلٍ أَسْلَمَ مِئَۃ دِرْہَمٍ فِی طَعَامٍ فَأَخَذَ نِصْفَ سَلَمِہِ طَعَامًا وَعَسُرَ عَلَیْہِ النِّصْفُ فَقَالَ : لاَ خُذْ سَلَمَک ، رَأْسَ مَالِکَ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 20369","","","كتاب البيوع والأقضية"
"20370","(۲۰۳۷۰) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُسْلِمُ فَیَأْخُذُ نِصْفَ سَلَمِہِ وَبَعْضا دِرْہَمٍ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 20370","","","كتاب البيوع والأقضية"
"20371","(۲۰۳۷۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ زَمْعَۃَ ، عَنِ ابْنِ طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَأْخُذَ بَعْضَ سَلَمِہِ وَبَعْضًا طَعَامًا۔","","Musannaf Ibn Abi Shaybah 20371","","","كتاب البيوع والأقضية"
"20372","(۲۰۳۷۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ عَبْدِ اللہِ بْنِ بِشْرٍ عَمَّنْ یَذْکُرُ ، عَنْ أَبِی سَلَمَۃَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَأْخُذَ بَعْضَ سَلَمِہِ وَبَعْضًا حِنْطَۃً۔","","Musannaf Ibn Abi Shaybah 20372","","","كتاب البيوع والأقضية"
"20373","(۲۰۳۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ زَیْدِ بْنِ جُبَیْرٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : خُذْ رَأْسَ سَلَمِکَ ، أَوْ رَأْسَ مَالِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 20373","","","كتاب البيوع والأقضية"
"20374","(۲۰۳۷۴) أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ مُجَاہِدٍ أَنَّہُ : کَرِہَہُ ، وَأَنَّ عَطَائً لَمْ یَرَ بِہِ بَأْسًا","No Data Available","Musannaf Ibn Abi Shaybah 20374","","","كتاب البيوع والأقضية"
"20375","(۲۰۳۷۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ عَمْرِو بْنِ دِینَارٍ، عَنْ جَابِرِ بْنِ زَیْدٍ، أَنَّہُ کَرِہَ أَنْ یَأْخُذَ بَعْضَ سَلَمِہِ وَبَعْضًا طَعَامًا۔","","Musannaf Ibn Abi Shaybah 20375","","","كتاب البيوع والأقضية"
"20376","(۲۰۳۷۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَبِی السَّوْدَائِ ، عَنْ شُرَیْحٍ أَنَّہُ کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 20376","","","كتاب البيوع والأقضية"
"20377","(۲۰۳۷۷) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20377","","","كتاب البيوع والأقضية"
"20378","(۲۰۳۷۸) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنْ سَالِمٍ وَالْقَاسِمِ أَنَّہُمَا کَرِہَا أَنْ یَأْخُذَ بَعْضَ سَلَمِہِ وَبَعْضًا طَعَامًا۔","","Musannaf Ibn Abi Shaybah 20378","","","كتاب البيوع والأقضية"
"20379","(۲۰۳۷۹) حَدَّثَنَا ابْنُ أَبِی عَدِیٍّ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَرِہَ أَنْ یَأْخُذَ بَعْضَ سَلَمِہِ وَبَعْضًا طَعَامًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20379","","","كتاب البيوع والأقضية"
"20380","(۲۰۳۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، وَسُفْیَانُ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، وَسُفْیَانُ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ وَسُفْیَانُ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، عَنْ عَمْرِو بْنِ الْحَارِثِ بْنِ الْمُصْطَلِقِ وَسُفْیَانُ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ ابْنِ معقل أَنَّہُمْ کَرِہُوا أَنْ یَأْخُذَ الرَّجُلُ بَعْضَ سَلَمِہِ وَبَعْضَ رَأْسِ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 20380","","","كتاب البيوع والأقضية"
"20381","(۲۰۳۸۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، وَابْنُ فُضَیْلٍ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ، عَنِ الأَسْوَدِ ، عَنْ عَائِشَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اشْتَرَی مِنْ یَہُودِیٍّ طَعَامًا إلَی أَجَلٍ فَرَہَنَہُ دِرْعَہُ وَلَمْ یَذْکُرِ ابْنُ فُضَیْلٍ : إلَی أَجَلٍ۔ (بخاری ۲۲۰۰۔ مسلم ۱۲۲۶)","Sahih","Musannaf Ibn Abi Shaybah 20381","","","كتاب البيوع والأقضية"
"20382","(۲۰۳۸۲) حَدَّثَنَا حَفْصٌ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ أَبِی حَسَّانَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لاَ بَأْسَ بِالرَّہْنِ فِی السَّلَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 20382","","","كتاب البيوع والأقضية"
"20383","(۲۰۳۸۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ، عَنْ أَیُّوبَ، عَنْ قَتَادَۃَ، عَنْ أَبِی حَسَّانَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لاَ بَأْسَ بِالرَّہْنِ فِی السَّلَمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20383","","","كتاب البيوع والأقضية"
"20384","(۲۰۳۸۴) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ أَیُّوبَ ، عَنْ قَتَادَۃَ ، عَنْ أَبِی حَسَّانَ ، عَنِ ابْنِ عَبَّاسٍ بِنَحْوِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 20384","","","كتاب البيوع والأقضية"
"20385","(۲۰۳۸۵) حَدَّثَنَا حَفْصٌ، وَابْنُ فُضَیْلٍ، عَنِ الأَعْمَش، عَنْ إبْرَاہِیمَ، أَنَّہُ کَانَ لاَ یَرَی بِالرَّہْنِ فِی السَّلَمِ بَأْسًا ، قَالَ: فَقِیلَ لَہُ: إنَّ سَعِیدَ بْنَ جُبَیْرٍ یَقُولُ: ذَلِکَ الرِّبْحُ الْمَضْمُونُ، قَالَ ابراہیم: قَدْ یَأْخُذُ الرَّہْنَ ، ثُمَّ یَرْتَفِعُ السِّعْرُ۔","","Musannaf Ibn Abi Shaybah 20385","","","كتاب البيوع والأقضية"
"20386","(۲۰۳۸۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ الشَّعْبِیَّ ، عَنِ الرَّہْنِ فِی السَّلَمِ فَقَالَ : وَدِدْت أَنِّی لَمْ أَکُنْ أَعْطَیْتُ شَیْئًا إلاَّ بِرَہْنٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 20386","","","كتاب البيوع والأقضية"
"20387","(۲۰۳۸۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَعَطَائٍ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بِالرَّہْنِ فِی السَّلَمِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20387","","","كتاب البيوع والأقضية"
"20388","(۲۰۳۸۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عَبْدُ الْحَمِیدِ بْنُ بَہْرَامَ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أَسْمَائَ بِنْتِ یَزِیدَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ تُوُفِّیَ وَدِرْعُہُ مَرْہُونَۃٌ عِنْدَ یَہُودِیٍّ بِطَعَامٍ۔ (ابن ماجہ ۲۴۳۸)","Da'if","Musannaf Ibn Abi Shaybah 20388","","","كتاب البيوع والأقضية"
"20389","(۲۰۳۸۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : قبِضَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، وَإِنَّ دِرْعَہُ لَمَرْہُونَۃٌ بِثَلاَثِینَ صَاعًا مِنْ شَعِیرٍ أَخَذَہَا رِزْقًا لِعِیَالِہِ۔ (احمد ۲۳۶۔ دارمی ۲۵۸۲)","Sahih","Musannaf Ibn Abi Shaybah 20389","","","كتاب البيوع والأقضية"
"20390","(۲۰۳۹۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، قَالَ : سَأَلْتُ سَالِمًا عَنِ الرَّہْنِ فِی السَّلَمِ فَقَرَأَ (فَرِہَانٌ مَقْبُوضَۃٌ) کَأَنَّہُ لَمْ یَرَ بِہِ بَأْسًا۔","Sahih","Musannaf Ibn Abi Shaybah 20390","","","كتاب البيوع والأقضية"
"20391","(۲۰۳۹۱) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنِ الزِّبْرِقَانِ السَّرَّاجِ ، قَالَ : سَأَلْتُ عَبْدَ اللہِ بْنَ معقل عَنِ السَّلَمِ آخُذُ فِیہِ الرَّہْنَ ، أَوِ الْقَبِیلَ ؟ فَقَالَ : اسْتَوْثِقْ مِنَ الَّذِی لَکَ خیر۔","","Musannaf Ibn Abi Shaybah 20391","","","كتاب البيوع والأقضية"
"20392","(۲۰۳۹۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ، عَنِ ابْنِ عَوْنٍ، عَنْ عَامِرٍ، قَالَ: إنِّی لأَعْجَبُ مِمَّنْ یَکْرَہُ الرَّہْنَ، وَ الْقَبِیلَ فِی السَّلَمِ۔","","Musannaf Ibn Abi Shaybah 20392","","","كتاب البيوع والأقضية"
"20393","(۲۰۳۹۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ تَأْخُذَ ثِقَۃً بِمَالِکَ ، فَقَالَ لَہُ : رَجُلٌ : إنَّ قَوْمًا یَکْرَہُونَ الْقَبِیلَ ، وَلاَ یَرَوْنَ بِالْکَفِیلِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20393","","","كتاب البيوع والأقضية"
"20394","(۲۰۳۹۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ، عَنْ إسْرَائِیلَ، عَنْ جَابِرٍ، عَنْ عَامِرٍ، قَالَ: کَانَ أَصْحَابُ عَبْدِ اللہِ لاَ یَرَوْنَ بِہِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20394","","","كتاب البيوع والأقضية"
"20395","(۲۰۳۹۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20395","","","كتاب البيوع والأقضية"
"20396","(۲۰۳۹۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ وَسَالِمٍ وَالْقَاسِمِ قَالُوا : لاَ بَأْسَ بِالرَّہْنِ فِی السَّلَمِ۔","","Musannaf Ibn Abi Shaybah 20396","","","كتاب البيوع والأقضية"
"20397","(۲۰۳۹۷) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : إذَا کَانَ أَوَّلُہ حَلاَلاً ، فَالرَّہْنُ مِمَّا أُمِرَ بِہِ۔","","Musannaf Ibn Abi Shaybah 20397","","","كتاب البيوع والأقضية"
"20398","(۲۰۳۹۸) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ یَزِیدَ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ سُئِلَ عَنِ الرَّہْنِ فِی السَّلَمِ فَقَالَ : اسْتَوْثِقْ مِنْ مَالک۔","Da'if","Musannaf Ibn Abi Shaybah 20398","","","كتاب البيوع والأقضية"
"20399","(۲۰۳۹۹) حَدَّثَنَا مَالِکٌ حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی خَالِدٍ ، قَالَ : سُئِلَ عَامِرٌ عَنِ الرَّہْنِ فِی السَّلَمِ ، قَالَ : إنِّی لاَ أَقُولُ فِیہِ مِثْلَ قَوْلِ ابْنِ جُبَیْرٍ : إِنَّہُ رِبًا مَضْمُونٌ۔ (عبدالرزاق ۱۴۰۹۲)","","Musannaf Ibn Abi Shaybah 20399","","","كتاب البيوع والأقضية"
"20400","(۲۰۴۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ یَزِیدَ ، عَنْ مِقْسَمٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِالرَّہْنِ وَالْکَفِیلِ فِی السَّلَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 20400","","","كتاب البيوع والأقضية"
"20401","(۲۰۴۰۱) حَدَّثَنَا وَکِیعُ بْنُ الْجَرَّاحِ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی یَزِیدٍ ، عَنْ أَبِی عِیَاضٍ ، أَنَّ عَلِیًّا کَانَ یَکْرَہُ الرَّہْنَ وَالْقَبِیلَ فِی السَّلَمِ۔","","Musannaf Ibn Abi Shaybah 20401","","","كتاب البيوع والأقضية"
"20402","(۲۰۴۰۲) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، قَالَ : سُئِلَ ابْنُ عُمَرَ عَنِ الرَّجُلِ یُسْلِمُ السَّلَمَ وَیَأْخُذُ الرَّہْنَ فَکَرِہَہُ ، وَقَالَ : ذَلِکَ الشَّفُّ الْمَضْمُونُ یَعْنِی الرِّبْحَ۔","Sahih","Musannaf Ibn Abi Shaybah 20402","","","كتاب البيوع والأقضية"
"20403","(۲۰۴۰۳) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ یَزِیدَ وَسَالِمٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ یَکْرَہُ الرَّہْنَ فِی السَّلَمِ۔","Da'if","Musannaf Ibn Abi Shaybah 20403","","","كتاب البيوع والأقضية"
"20404","(۲۰۴۰۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، قَالَ : کُلُّ بَیْعِ نَسَائٍ فَإِنَّہُ یُکْرَہُ الْقَبِیلُ وَالرَّہْنُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 20404","","","كتاب البيوع والأقضية"
"20405","(۲۰۴۰۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بُکَیْرِ بْنِ عَتِیقٍ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ : آخُذُ الرَّہْنَ فِی السَّلَمِ ؟ فَقَالَ : ذَلِکَ رِبْحٌ مَضْمُونٌ ، قَالَ : قُلْتُ : آخُذُ الْکَفِیلَ ؟ قَالَ : ذَلِکَ رِبْحٌ مَضْمُونٌ۔","","Musannaf Ibn Abi Shaybah 20405","","","كتاب البيوع والأقضية"
"20406","(۲۰۴۰۶) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الْجَعْدِ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یَکْرَہُ الرَّہْنَ فِی السَّلَفِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20406","","","كتاب البيوع والأقضية"
"20407","(۲۰۴۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ، عَنْ دَاوُدَ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، أَنَّہُ کَانَ یَکْرَہُ الرَّہْنَ وَالْقَبِیلَ فِی السَّلَمِ۔","","Musannaf Ibn Abi Shaybah 20407","","","كتاب البيوع والأقضية"
"20408","(۲۰۴۰۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ أَبِی مَعْبَدٍ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ لاَ یَرَی بَیْنَ الْعَبْدِ وَبَیْنَ سَیِّدِہِ رِبًا ، وکان یبیع ثمرتہ من غلمانہ قبل أن تطعم۔","Sahih","Musannaf Ibn Abi Shaybah 20408","","","كتاب البيوع والأقضية"
"20409","(۲۰۴۰۹) حَدَّثَنَا حَفْصٌ بن غیاث ، الشیبانی ، عن الشعبی ، قَالَ : لَیْسَ بَیْنَ الْعَبْدِ وَبَیْنَ سَیِّدِہِ رِبًا ؛ یُعْطِیہِ دِرْہَمًا وَیَأْخُذُ مِنْہُ دِرْہَمَیْنِ۔","","Musannaf Ibn Abi Shaybah 20409","","","كتاب البيوع والأقضية"
"20410","(۲۰۴۱۰) حَدَّثَنَا حَفْصٌ ، عَنِ أبی الْعَوَّامِ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لَیْسَ بَیْنَ الْعَبْدِ وَبَیْنَ سَیِّدِہِ رِبًا۔","Sahih","Musannaf Ibn Abi Shaybah 20410","","","كتاب البيوع والأقضية"
"20411","(۲۰۴۱۱) حَدَّثَنَا إسْمَاعِیلُ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، وَعَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، وَعَنْ ہِشَامٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ بَیْنَ الْعَبْدِ وَبَیْنَ سَیِّدِہِ رِبًا۔","","Musannaf Ibn Abi Shaybah 20411","","","كتاب البيوع والأقضية"
"20412","(۲۰۴۱۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إبْرَاہِیمَ وَالشَّعْبِیَّ ، عَنْ رَجُلٍ کَانَ لَہُ عَبْدٌ یُؤَدِّی خَمْسَۃَ دَرَاہِم کُلَّ شَہْرٍ فَقَالَ : أَعْطِنِی مِئَتَیْ دِرْہَمٍ کُلَّ شَہْرٍ وَأُعْطِیکَ کُلَّ شَہْرٍ تِسْعَۃَ دَرَاہِمَ ، قَالَ : فَلَمْ یَرَ بِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20412","","","كتاب البيوع والأقضية"
"20413","(۲۰۴۱۳) حَدَّثَنَا ہُشَیْمٌ، عَنْ یُونُسَ، عَنِ الْحَسَنِ، وَابْنِ سِیرِینَ أَنَّہُمَا کَرِہَا أَنْ یُعْطِیَ الرَّجُلُ مَمْلُوکَہُ الدَّرَاہِمَ عَلَی أَنْ یَزِیدَہُ فِی الْغَلَّۃِ ، وَقَالَ ابْنُ سِیرِینَ : یُعْطِیہِ بدنۃ ، أَوْ دَابَّۃً ، أَوْ غَیْرَ ذَلِکَ مِنَ الْمَنَائِحِ وَیَزِیدُ عَلَیْہِ مَا شَائَ۔","","Musannaf Ibn Abi Shaybah 20413","","","كتاب البيوع والأقضية"
"20414","(۲۰۴۱۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، وَالْحَسَنِ ، قَالاَ : لَیْسَ بَیْنَ الْعَبْدِ وَبَیْنَ سَیِّدِہِ رِبًا۔","","Musannaf Ibn Abi Shaybah 20414","","","كتاب البيوع والأقضية"
"20415","(۲۰۴۱۵) حَدَّثَنَا غُنْدَرٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لَیْسَ بَیْنَ الْمَمْلُوکِ وَبَیْنَ سَیِّدِہِ رِبًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20415","","","كتاب البيوع والأقضية"
"20416","(۲۰۴۱۶) حَدَّثَنَا شَرِیکٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ بِبَیْعِ الرِّطَابِ جَزَّۃً بَعْدَ جَزَّۃٍ۔","","Musannaf Ibn Abi Shaybah 20416","","","كتاب البيوع والأقضية"
"20417","(۲۰۴۱۷) حَدَّثَنَا شَرِیکٌ، عَنْ مُغِیرَۃَ، عَنْ عَامِرٍ، قَالَ: لاَ بَأْسَ بِبَیْعِ الرِّطَابِ الْجَزَّۃَ بَعْدَ الْجَزَّۃِ، وَالْقِطْعَۃَ بَعْدَ الْقِطْعَۃِ۔","","Musannaf Ibn Abi Shaybah 20417","","","كتاب البيوع والأقضية"
"20418","(۲۰۴۱۸) حَدَّثَنَا وَکِیعٌ ، عَنْ بُرَیْدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی بُرْدَۃَ ، قَالَ : سَأَلْتُ عَطَائً ، عَنْ بَیْعِ الرَّطْبَۃِ جَزَّتَیْنِ ، قَالَ : لاَ یَصْلُحُ إلاَّ جَزَّۃً۔","","Musannaf Ibn Abi Shaybah 20418","","","كتاب البيوع والأقضية"
"20419","(۲۰۴۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، أَنَّہُ کَرِہَ بَیْعَ الْقَضْبِ وَالْحِنَّائِ ، وَکَرِہَ بَیْعَ الْخِیَارِ ، وَالْخِرْبِزَ ، إلاَّ جَنْیَۃً۔","","Musannaf Ibn Abi Shaybah 20419","","","كتاب البيوع والأقضية"
"20420","(۲۰۴۲۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، قَالَ : سَأَلْتُ عِکْرِمَۃَ ، عَنْ بَیْعِ الْقَصِیلِ فَقَالَ : لاَ بَأْسَ ، فَقُلْت: إِنَّہُ تَسَنْبلُ ، فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 20420","","","كتاب البيوع والأقضية"
"20421","(۲۰۴۲۱) حَدَّثَنَا أَبُو الأَحْوَص، عَنْ طَارِقٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، قَالَ: قَالَ عُمَرُ: لاَ تُسْلِمُوا فِی فِرَاخٍ حَتَّی تَبْلُغَ۔","","Musannaf Ibn Abi Shaybah 20421","","","كتاب البيوع والأقضية"
"20422","(۲۰۴۲۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ عَاصِمٍ ، عَنِ ابْن سِیرِینَ ، قَالَ : لاَ یُشْتَرَی السُّنْبُلُ حَتَّی یَبْیَضَّ۔","No Data Available","Musannaf Ibn Abi Shaybah 20422","","","كتاب البيوع والأقضية"
"20423","(۲۰۴۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنِ ابْنِ أَشَوْعَ وَالْقَاسِمِ أَنَّہُمَا کَرِہَا بَیْعَ الرِّطَابِ إلاَّ جَزَّۃً۔","","Musannaf Ibn Abi Shaybah 20423","","","كتاب البيوع والأقضية"
"20424","(۲۰۴۲۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : یُکْرَہُ السَّلَمُ فِی الْعِنَبِ وَالْبُسْرِ وَالرُّطَبِ وَالتُّفَّاحِ وَالْکُمَّثْرَی وَالْبِطِّیخِ وَالْقِثَّائِ وَالسُّنْبُلِ وَالرَّطْبِ وَأَشْبَاہِہِ۔","","Musannaf Ibn Abi Shaybah 20424","","","كتاب البيوع والأقضية"
"20425","(۲۰۴۲۵) حَدَّثَنَا جَرِیر ، عَنْ مُغِیرَۃ ، عَنْ حَمَّاد ، عَنْ إبْرَاہِیم ، قَالَ : لاَ بَأْسَ أَنْ یتقبل الْخَیَّاطُ الثیاب بِأَجْرٍ مَعْلُومٍ ، یُقَبِّلُہَا بِدُونِ ذَلِکَ بَعْدَ أَنْ یَعْرِفَہَا بِشَیْئٍ ، أَوْ یَقْطَعَ ، أَوْ یُعْطِیَہُ سُلُوکًا وَإِبَرًا ، ویَخِیطَ فِیہَا شَیْئًا ، فَإِنْ لَمْ یَعْرِفْہَا بِہَذَا ، أَوْ بِشَیْئٍ مِنْہُ ، فَلاَ یَأْخُذْنَ فَضْلاً۔","","Musannaf Ibn Abi Shaybah 20425","","","كتاب البيوع والأقضية"
"20426","(۲۰۴۲۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَمَّادٍ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا أَنْ یَأْخُذَ الثَّوْبَ وَیُعْطِیَہُ بِأَقَلَّ مِنْ ذَلِکَ بِالثُّلُثَیْنِ ، وَالنِّصْفُ إذَا قَطَعَ ، أَوْ عَمِلَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 20426","","","كتاب البيوع والأقضية"
"20427","(۲۰۴۲۷) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ أَبِی خَلْدَۃَ ، قَالَ : سَأَلْتُُ عِکْرِمَۃَ وَأَبَا الْعَالِیَۃِ فَقُلْتُ : إنِّی رَجُلٌ خَیَّاطٌ أَقْطَعُ الثَّوْبَ وَأُؤَاجِرُہُ بِأَقَلَّ مِمَّا آخُذُہُ بِہِ؟ قَالاَ: تَعْمَلُ فِیہِ شَیْئًا؟ قُلْتُ: نَعَمْ ، أَقْطَعُہُ وَأَضُمُّہُ ، قَالاَ : لاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 20427","","","كتاب البيوع والأقضية"
"20428","(۲۰۴۲۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ فِی الرَّجُلِ یَدْفَعُ إلَی الرَّجُلِ الثَّوْبَ فَیُؤَاجِرُہُ بِأَقَلَّ ، قَالَ : لاَ بَأْسَ بِہِ إذَا عَمِلَ فِیہِ وَقَطَعَہُ ، قَالَ : یَسْتَأْذِنُہُ أَحَبُّ إلَیَّ۔","","Musannaf Ibn Abi Shaybah 20428","","","كتاب البيوع والأقضية"
"20429","(۲۰۴۲۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ فِی الْخَیَّاطِ یَدْفَعُ الثَّوْبَ بِالنِّصْفِ ، أَوِ الثُّلُثِ ، أَوِ الرُّبُعِ ، قَالَ : إذَا أَعَانَہُ بِشَیْئٍ فَلاَ بَأْسَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20429","","","كتاب البيوع والأقضية"
"20430","(۲۰۴۳۰) حَدَّثَنَا شَرِیکٌ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ مُحَمَّدِ بْنِ بَیَانٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَشْتَرِی الطَّعَامَ قَدْ شَہِدَ کَیْلَہُ ، قَالَ : لاَ ، حَتَّی یَجْرِیَ فِیہِ الصَّاعَانِ۔","Da'if","Musannaf Ibn Abi Shaybah 20430","","","كتاب البيوع والأقضية"
"20431","(۲۰۴۳۱) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قُلْتُ لَہُ : أَکُونُ شَاہِدَ الطَّعَامِ وَہُوَ یُکَالُ أَشْتَرِیہِ آخُذُہُ بِکَیْلِہِ ؟ فَقَالَ : مَعَ کُلِّ صَفْقَۃٍ کَیْلَۃٌ۔","","Musannaf Ibn Abi Shaybah 20431","","","كتاب البيوع والأقضية"
"20432","(۲۰۴۳۲) حَدَّثَنَا مَرْوَانُ بْنُ مُعَاوِیَۃَ ، عَنْ زِیَادٍ مَوْلَی آلِ سَعْدٍ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : رَجُلٌ ابْتَاعَ طَعَامًا فَاکْتَالَہُ ، أَیَصْلُحُ لِی أَنْ أَشْتَرِیَہُ بِکَیْلِ الرَّجُلِ ؟ فَقَالَ : لاَ ، حَتَّی یُکَالَ بَیْنَ یَدَیْک۔","","Musannaf Ibn Abi Shaybah 20432","","","كتاب البيوع والأقضية"
"20433","(۲۰۴۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ کَہْمَسِ بْنِ الْحَسَنِ ، عَنْ مَیْمُونِ الْقَنَّادِ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : الرَّجُلُ یَشْتَرِی الماشیۃ وَأَنَا أَنْظُرُ إلَی وَزْنِہَا أَشْتَرِیہَا بِوَزْنِہَا ؟ قَالَ : کَانَ یُقَالُ : ذَلِکَ الرِّبَا ، خَالَطَ الْکَیْلَ وَالْوَزْنَ۔","","Musannaf Ibn Abi Shaybah 20433","","","كتاب البيوع والأقضية"
"20434","(۲۰۴۳۴) حَدَّثَنَا وَکِیعٌ ، عَنْ خَالِدِ بْنِ عَبْدِ الرَّحْمَنِ السُّلَمِیِّ ، قَالَ : قدِمَ رَجُلٌ بِجِلاَلٍ فَاشْتَرَاہَا رَجُلٌ ، فَکَالَ مِنْہُ جُلَّۃً ، ثُمَّ أَرَادَ أَنْ یَأْخُذَہَا بِکَیْلِہَا فَکَرِہَہُ الْحَسَنُ۔","","Musannaf Ibn Abi Shaybah 20434","","","كتاب البيوع والأقضية"
"20435","(۲۰۴۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ حَفْصٍ ، قَالَ : سَمِعْتُ الْحَسَنَ ، وَسَأَلَہ رَجُل ، عَنْ رجل اشْتَرَی طَعَامًا ، وَہُوَ یَنْظُرُ إلَی کَیْلِہِ ، قَالَ : لاَ ، حَتَّی یَکِیلَہُ۔","","Musannaf Ibn Abi Shaybah 20435","","","كتاب البيوع والأقضية"
"20436","(۲۰۴۳۶) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ ، عَنْ سَوَادَۃَ بْنِ حَیَّانَ ، قَالَ : سَمِعْتُ مُحَمَّدَ بْنَ سِیرِینَ وَسُئِلَ عَنْ رَجُلَیْنِ اشْتَرَی أَحَدُہُمَا طَعَامًا وَالآخَرُ مَعَہُ فَقَالَ : قَدْ شَہِدْتَ الْبَیْعَ وَالْقَبْضَ ، فَقَالَ: خُذْ مِنِّی رِبْحًا وَأَعْطِنِیہِ ؟ قَالَ: لاَ حَتَّی یَجْرِیَ فِیہِ الصَّاعَانِ ، فَیَکُونُ لَکَ زِیَادَتُہُ وَعَلَیْہِ نُقْصَانُہُ۔","","Musannaf Ibn Abi Shaybah 20436","","","كتاب البيوع والأقضية"
"20437","(۲۰۴۳۷) حَدَّثَنَا عَبْدُ الرَّزَّاقِ، عَنْ مَعْمَرٍ ، عَنْ أَیُّوبَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَشْتَرِیَ الثَّوْبَ بِدِینَارٍ إلاَّ دِرْہَمٌ بِنَسِیْئَۃٍ۔","","Musannaf Ibn Abi Shaybah 20437","","","كتاب البيوع والأقضية"
"20438","(۲۰۴۳۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَشْتَرِیَ الثَّوْبَ بِدِینَارٍ إلاَّ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 20438","","","كتاب البيوع والأقضية"
"20439","(۲۰۴۳۹) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ، عَنِ ابْنِ جُرَیْجٍ، عَنْ عَطَائٍ، أَنَّہُ کَرِہَ أَنْ یُشْتَرَی الثَّوْبَ بِدِینَارٍ إلاَّ دِرْہَمًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20439","","","كتاب البيوع والأقضية"
"20440","(۲۰۴۴۰) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ طَلْحَۃَ بْنَ أَبِی سَعِیدٍ ، عَنْ صَخْرِ بْنِ أَبِی غَلِیظٍ ، قَالَ : رَأَیْتُ أَبَا سَلَمَۃَ بْنَ عَبْدِ الرَّحْمَنِ اشْتَرَی ثَوْبًا بِدِینَارٍ إلاَّ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 20440","","","كتاب البيوع والأقضية"
"20441","(۲۰۴۴۱) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ حَمَّادٍ، عَنْ إبْرَاہِیمَ، قَالَ: لاَ بَأْسَ أَنْ یَقُولَ: أَبِیعُک بِدِینَارٍ وَتَزِیدُنِی دِرْہَمَیْنِ۔","","Musannaf Ibn Abi Shaybah 20441","","","كتاب البيوع والأقضية"
"20442","(۲۰۴۴۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، عَنِ الْحَارِثِ ، عَنْ إبْرَاہِیمَ ، وَعَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ أَنَّہُمَا کَرِہَا أَنْ یَقُولَ الرَّجُلُ لِلرَّجُلِ : أَبِیعُک ہَذَا الثَّوْبَ بِدِینَارٍ إلاَّ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 20442","","","كتاب البيوع والأقضية"
"20443","(۲۰۴۴۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَاصِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا مَلَکَ الرَّجُلُ أخاہ فہو حر۔","No Data Available","Musannaf Ibn Abi Shaybah 20443","","","كتاب البيوع والأقضية"
"20444","(۲۰۴۴۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مغیرۃ ، عن حماد ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا مَلَکَ الرَّجُلُ عَمَّہُ ، أَوْ عَمَّتَہُ ، أَوْ خَالَہُ ، أَوْ خَالَتَہُ ؛ فَہُوَ عَتِیقٌ وَہُوَ بِمَنْزِلَۃِ أَبَوَیْہِ۔","","Musannaf Ibn Abi Shaybah 20444","","","كتاب البيوع والأقضية"
"20445","(۲۰۴۴۵) حَدَّثَنَا جَرِیرٌ ، عَنْ أَبَانَ بْنِ تَغْلِبَ ، عَنْ طَلْحَۃَ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ ، قَالاَ : مَنْ مَلَکَ عَمَّہُ ، أَوْ عَمَّتَہُ ، أَوْ خَالَہُ ، أَوْ خَالَتَہُ وَمَا دُونَ ذَلِکَ مِنَ النَّسَبِ ، فَہُوَ عَتِیقٌ۔","","Musannaf Ibn Abi Shaybah 20445","","","كتاب البيوع والأقضية"
"20446","(۲۰۴۴۶) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ عَبْدِ الْکَرِیمِ ، عَنِ الْحَسَنِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَلَکَ ذَا رحم مَحْرَمٍ ، فَہُوَ حُرٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 20446","","","كتاب البيوع والأقضية"
"20447","(۲۰۴۴۷) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃََ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، مِثْلَہُ۔ (ترمذی ۱۳۶۵۔ ابوداؤد ۳۹۴۵)","Hasan","Musannaf Ibn Abi Shaybah 20447","","","كتاب البيوع والأقضية"
"20448","(۲۰۴۴۸) حَدَّثَنَا عَلِیُّ بْنُ ہَاشِمٍ، عَنِ ابْنِ أَبِی لَیْلَی، عَنِ الْحَکَمِ، قَالَ: قَالَ عُمَرُ: مَنْ مَلَکَ ذَا رَحِمٍ مَحْرَمٍ، فَہُوَ حُرٌّ۔","Da'if","Musannaf Ibn Abi Shaybah 20448","","","كتاب البيوع والأقضية"
"20449","(۲۰۴۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَی ، عَنْ أَشْیَاخِہِ ، عنِ الزُّبَیْرِ أَنَّہُ یَوْمَ الطَّائِفِ مَلَکَ خَالاَتٍ لَہُ فَأُعْتِقنَ بِمِلْکِہِ إیَّاہُنَّ۔","Da'if","Musannaf Ibn Abi Shaybah 20449","","","كتاب البيوع والأقضية"
"20450","(۲۰۴۵۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ وَسُفْیَانَ ، عَنْ سَلَمَۃَ بْنِ کُہَیْلٍ ، عَنِ الْمُسْتَوْرِدِ بْنِ الأَحْنَفِ ، قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ فَقَالَ : إنَّ عَمِّی زَوَّجَنِی وَلِیدَتَہُ وَہُوَ یُرِیدُ أَنْ یَسْتَرِقَّ وَلَدِی ، قَالَ : لَیْسَ لَہُ ذَلِکَ۔","Sahih","Musannaf Ibn Abi Shaybah 20450","","","كتاب البيوع والأقضية"
"20451","(۲۰۴۵۱) حَدَّثَنَا أَبُو أُسَامَۃَ، عَنْ سَعِیدٍ، عَنْ قَتَادَۃَ، عَنْ جَابِرِ بْنِ زَیْدٍ، وَالْحَسَنِ، قَالاَ: مَنْ مَلَکَ ذَا رَحِمٍ، فَہُوَ حُرٌّ۔","","Musannaf Ibn Abi Shaybah 20451","","","كتاب البيوع والأقضية"
"20452","(۲۰۴۵۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ یَعْتِقُ کُلُّ رَحِمٍ إذَا مَلَکَہُ ذُو رَحِمٍ۔","","Musannaf Ibn Abi Shaybah 20452","","","كتاب البيوع والأقضية"
"20453","(۲۰۴۵۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، قَالاَ : إذَا مَلَکَ الْعَمَّۃَ وَالْخَالَۃَ وَبِنْتَ الْعَمِّ وَکُلَّ ذِی مَحْرَمٍ عَتَقَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20453","","","كتاب البيوع والأقضية"
"20454","(۲۰۴۵۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یَمْلِکُ وَلَدٌ وَالِدَہُ ، وَلاَ وَالِدٌ وَلَدَہُ ، قَالَ : وَالْعَمَّۃُ وَالْخَالَۃُ بِتِلْکَ الْمَنْزِلَۃِ۔","","Musannaf Ibn Abi Shaybah 20454","","","كتاب البيوع والأقضية"
"20455","(۲۰۴۵۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : مَنْ مَلَکَ ذَا رَحِمٍ ، فَہُوَ عِتْقٌ ، أَوْ ھُوَ عَتِیقٌ۔","","Musannaf Ibn Abi Shaybah 20455","","","كتاب البيوع والأقضية"
"20456","(۲۰۴۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمِّیَّۃَ ، عَنِ ابن أبی نجیح ، عن عَطَائٍ ، قَالَ : إذَا مَلَکَ الْعَمَّۃَ أو الخالۃ ؛ فبتلک المنزلۃ۔","","Musannaf Ibn Abi Shaybah 20456","","","كتاب البيوع والأقضية"
"20457","(۲۰۴۵۷) حَدَّثَنَا عبد الأعلی، عن یعلی، عن یونس، عن الحسن قَالَ: من ملک ذا رحم؛ فقد عتق، أو ہو عتیق۔","No Data Available","Musannaf Ibn Abi Shaybah 20457","","","كتاب البيوع والأقضية"
"20458","(۲۰۴۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمِّیَّۃَ ، عَنِ ابن أبی نجیح ، عن عَطَائٍ ، قَالَ : إذَا مَلَکَ الْعَمَّۃَ وَالْخَالَۃَ عَتَقَا۔","","Musannaf Ibn Abi Shaybah 20458","","","كتاب البيوع والأقضية"
"20459","(۲۰۴۵۹) أَخْبَرَنَا غُنْدَرٌ ، عن شعبۃ عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یُعْتِقُ الْوَلَدَ وَالْوَالِدَ إذَا مَلَکَ أَحَدُہُمَا صَاحِبَہُ۔","","Musannaf Ibn Abi Shaybah 20459","","","كتاب البيوع والأقضية"
"20460","(۲۰۴۶۰) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : مَضَتِ السُّنَّۃُ أَنَّہُ مَنْ مَلَکَ مِنْ مَحْرَمِہِ شَیْئًا ، فَہُوَ حُرٌّ ، بِمِلْکِہِ عَتِیقٌ ، قَالَ : وَمَا وَرَائَ ذَلِکَ مِنَ الْقَرَابَۃِ رَحِمٌ أَمَرَ اللَّہُ بِصِلَتِہَا وَنَہَی عَنْ عُقُوقِہَا ، وَلاَ أَعْلَمُ مِنَ الْعُقُوقِ شَیْئًا أَشَدَّ مِنْ أَنْ یَتَّخِذَ الرَّجُلُ قَرِیبَہُ مَمْلُوکًا۔","","Musannaf Ibn Abi Shaybah 20460","","","كتاب البيوع والأقضية"
"20461","(۲۰۴۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا مَلَکَ الأَخَ فَلاَ یَعْتِقُ عَلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20461","","","كتاب البيوع والأقضية"
"20462","(۲۰۴۶۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : یَبْدَأُ بِالْوَدِیعَۃِ۔","","Musannaf Ibn Abi Shaybah 20462","","","كتاب البيوع والأقضية"
"20463","(۲۰۴۶۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : یَبْدَأُ بِالأَمَانَۃِ۔","","Musannaf Ibn Abi Shaybah 20463","","","كتاب البيوع والأقضية"
"20464","(۲۰۴۶۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ سَیَّارٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الودِیعۃ والْمُضَارَبَۃُ وَالدَّیْنُ کُلُّ ذَلِکَ بِالْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 20464","","","كتاب البيوع والأقضية"
"20465","(۲۰۴۶۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ وَطَاوُسٍ وَالزُّہْرِیِّ قَالُوا : یَأْخُذُونَ بِالْحِصَص۔","No Data Available","Musannaf Ibn Abi Shaybah 20465","","","كتاب البيوع والأقضية"
"20466","(۲۰۴۶۶) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْمُضَارَبَۃُ وَالدَّیْنُ سَوَائٌ إذَا لَمْ یُعَرِّفْ شَیْئًا بِعَیْنِہِ۔","","Musannaf Ibn Abi Shaybah 20466","","","كتاب البيوع والأقضية"
"20467","(۲۰۴۶۷) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنِ الشَّعْبِیِّ ، وَأَبِی جَعْفَرٍ ، وَعَطَائٍ وَالزُّہْرِیِّ قَالُوا : إذَا مَاتَ وَعَلَیْہِ دَیْنٌ وَعِنْدَہُ مُضَارَبَۃٌ ، أَوْ ودیعۃ فَہُمْ فِیہِ عَلَی الْحِصَصِ۔","","Musannaf Ibn Abi Shaybah 20467","","","كتاب البيوع والأقضية"
"20468","(۲۰۴۶۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، عَنْ مَسْرُوقٍ وَشُرَیْحٍ فِی الدَّیْنِ الْوَدِیعَۃِ : بِالْحِصَصِ ، قَالَ عَامِرٌ : إذَا لَمْ تُوجَدْ بِعَیْنِہَا۔","","Musannaf Ibn Abi Shaybah 20468","","","كتاب البيوع والأقضية"
"20469","(۲۰۴۶۹) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنِ الْحَسَنِ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : یُحَاصُّ الْغُرَمَائُ۔","","Musannaf Ibn Abi Shaybah 20469","","","كتاب البيوع والأقضية"
"20470","(۲۰۴۷۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْوَدِیعَۃُ بِمَنْزِلَۃِ الدَّیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20470","","","كتاب البيوع والأقضية"
"20471","(۲۰۴۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عن النضر بن أنس عَنْ بَشِیرِ بْنِ نَہِیکٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا أَفْلَسَ الرَّجُلُ فَوَجَدَ الرَّجُلُ سِلْعَتَہُ قَائِمَۃً بِعَیْنِہَا ، فَہُوَ أَحَقُّ بِہَا مِنَ الْغُرَمَائِ۔ (مسلم ۱۱۹۴۔ احمد ۳۴۷)","","Musannaf Ibn Abi Shaybah 20471","","","كتاب البيوع والأقضية"
"20472","(۲۰۴۷۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ وَحَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، أَنَّ أَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ أَخْبَرَہُ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ وَجَدَ مَالَہُ بِعَیْنِہِ عِنْدَ رَجُلٍ قَدْ أَفْلَسَ ، فَہُوَ أَحَقُّ بِہِ مِنْ غُرَمَائِہِ۔n(بخاری ۲۴۰۲۔ ابوداؤد ۳۵۱۳)","Sahih","Musannaf Ibn Abi Shaybah 20472","","","كتاب البيوع والأقضية"
"20473","(۲۰۴۷۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن عَوْفٍ ، قَالَ : قرِئَ عَلَیْنَا کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ : أَیُّمَا رَجُلٍ أَفْلَسَ فَأَدْرَکَ رَجُلٌ مَالَہُ بِعَیْنِہِ ، فَہُوَ أَحَقُّ مِنْ سَائِرِ الْغُرَمَائِ إلاَّ أَنْ یَکُونَ اقْتَضَی مِنْ مَالِہِ شَیْئًا ، فَہُوَ أُسْوَۃُ الْغُرَمَائِ قَضَی بِذَلِکَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ۔","","Musannaf Ibn Abi Shaybah 20473","","","كتاب البيوع والأقضية"
"20474","(۲۰۴۷۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ قَالَ فِی الْمُفْلِسِ یَجِدُ عِنْدَہُ الرَّجُلُ مَتَاعَہُ بِعَیْنِہِ ، قَالَ : إِنْ کَانَ أَخَذَ مِنْ ثَمَنِہِ شَیْئًا ، فَہُوَ أُسْوَۃُ الْغُرَمَائِ وَإِلا فَہُوَ لَہُ۔","","Musannaf Ibn Abi Shaybah 20474","","","كتاب البيوع والأقضية"
"20475","(۲۰۴۷۵) حَدَّثَنَا ہُشَیْمٌ وَجَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : ہُوَ أُسْوَۃُ الْغُرَمَائِ۔","","Musannaf Ibn Abi Shaybah 20475","","","كتاب البيوع والأقضية"
"20476","(۲۰۴۷۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : ہُوَ أُسْوَۃُ الْغُرَمَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20476","","","كتاب البيوع والأقضية"
"20477","(۲۰۴۷۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ عَطَائِ بْنِ السَّائِبِ ، عَنِ الشَّعْبِیِّ أَنَّہُ أَتَاہُ رَجُلٌ فَقَالَ : دَفَعْتُ إلَی رَجُلٍ مَالاً مُضَارَبَۃً ، فَانْطَلَقَ حَتَّی إذَا بَلَغَ حُلْوَانَ مَاتَ ، فَانْطَلَقْتُ فَوَجَدْتُ کِیسِی بِعَیْنِہِ ، فَقَالَ عَامِرٌ : لَیْسَ لَکَ دُونَ الْغُرَمَائِ۔","","Musannaf Ibn Abi Shaybah 20477","","","كتاب البيوع والأقضية"
"20478","(۲۰۴۷۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَمْرِو بْنِ دِینَارٍ عَمَّنْ حَدَّثَہُ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : مَنْ وَجَدَ عَیْنَ مَالِہِ عِنْدَ رَجُلٍ قَدْ أَفْلَسَ ، فَہُوَ أَحَقُّ بِہِ مِمَّنْ سِوَاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 20478","","","كتاب البيوع والأقضية"
"20479","(۲۰۴۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ خِلاَسٍ ، عَنْ قَتَادَۃَ ، عَنْ عَلِیٍّ ، قَالَ : إذَا أَفْلَسَ الرجل وَسِلْعَتُہُ قَائِمَۃٌ بِعَیْنِہَا ، فَہُوَ أُسْوَۃُ الْغُرَمَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 20479","","","كتاب البيوع والأقضية"
"20480","(۲۰۴۸۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : ہُوَ أُسْوَۃُ الْغُرَمَائِ۔","","Musannaf Ibn Abi Shaybah 20480","","","كتاب البيوع والأقضية"
"20481","(۲۰۴۸۱) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : ہُوَ أُسْوَۃُ الْغُرَمَائِ۔","","Musannaf Ibn Abi Shaybah 20481","","","كتاب البيوع والأقضية"
"20482","(۲۰۴۸۲) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: ہُوَ أُسْوَۃٌ إلاَّ أَنْ یَکُونَ حَبَسَہَا لَہُ سُلْطَانٌ۔","","Musannaf Ibn Abi Shaybah 20482","","","كتاب البيوع والأقضية"
"20483","(۲۰۴۸۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، أَنَّ حَفْصَۃَ بِنْتَ عُمَرَ أَسْکَنَتْ أَسْمَائَ بِنْتَ زَیْدٍ حُجْرَۃً لَہَا حَیَاتَہَا ، فَلَمَّا تُوُفِّیَتْ حَفْصَۃُ قَبَضَ ابْنُ عُمَرَ الْحُجْرَۃَ۔","Da'if","Musannaf Ibn Abi Shaybah 20483","","","كتاب البيوع والأقضية"
"20484","(۲۰۴۸۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن خَالِدٍ الْحَذَّائِ ، قَالَ : کَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ ، أَنَّ السُّکْنَی عَارِیَّۃٌ فَإِذَا قَالَ : ہِیَ لَہُ وَلِعَقِبِہِ ، فَہِیَ لَہُ وَلِعَقِبِہِ مَا بَقِیَتْ مِنْہُمُ امْرَأَۃٌ فَإِذَا انْقَرَضُوا جَمِیعًا رَجَعَتْ إلَی وَرَثَتِہِ۔","","Musannaf Ibn Abi Shaybah 20484","","","كتاب البيوع والأقضية"
"20485","(۲۰۴۸۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یُسْکِنُ الرَّجُلَ لَہُ وَلِعَقِبِہِ ، ثُمَّ یَمُوتُ ، قَالَ : لاَ تَسْتَطِیعُ وَرَثَتُہُ أَنْ یُخْرِجُوہُ ، وَلاَ عَقِبَہُ مَا بَقِیَ مِنْہُمْ أَحَدٌ۔","","Musannaf Ibn Abi Shaybah 20485","","","كتاب البيوع والأقضية"
"20486","(۲۰۴۸۶) حَدَّثَنَا وَکِیعٌ ، عَنِ السَّائِبِ ، عَنْ عُمَرَ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : کَانَتْ عَائِشَۃُ إذَا أَسْکَنَتْ قَالَتْ : أَسْکَنْتُکَ مَا بَدَا لِی۔","Sahih","Musannaf Ibn Abi Shaybah 20486","","","كتاب البيوع والأقضية"
"20487","(۲۰۴۸۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عُثْمَانَ ابْنِ أَخِی شُرَیْحٍ ، عَنْ شُرَیْحٍ ، قَالَ : السُّکْنَی علی مَا اشْتَرَطَ صَاحِبُہَا۔","","Musannaf Ibn Abi Shaybah 20487","","","كتاب البيوع والأقضية"
"20488","(۲۰۴۸۸) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عُثْمَانَ ، عَنْ شُرَیْحٍ بِنَحْوِہِ۔","","Musannaf Ibn Abi Shaybah 20488","","","كتاب البيوع والأقضية"
"20489","(۲۰۴۸۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ وَالشَّعْبِیِّ ، قَالاَ : السُّکْنَی عَارِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 20489","","","كتاب البيوع والأقضية"
"20490","(۲۰۴۹۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُُہُ ، عَنْ رَجُلٍ أَسْکَنَ رَجُلاً دَارِہِ فَمَاتَ الْمُسْکِنُ وَالمسکَنُ، قَالَ: تَرْجِعُ إلَی وَرَثَۃِ الْمُسْکِنِ، قَالَ: قُلْتُ: یَا أَبَا عِمْرَانَ، ألیس کَانَ یُقَالُ: مَنْ مَلَکَ شَیْئًا حَیَاتَہُ، فَہُوَ لِوَرَثَتِہِ مِنْ بَعْدِہِ ، قَالَ : إنَّمَا ذَلِکَ فِی الْعُمْرَی ، فَأَمَّا السُّکْنَی وَالْغَلَّۃُ وَالْعَارِیَّۃُ فَإِنَّہَا تَرْجِعُ إلَی وَرَثَتِہَا۔","","Musannaf Ibn Abi Shaybah 20490","","","كتاب البيوع والأقضية"
"20491","(۲۰۴۹۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا وَہَبَ الرَّجُلُ شَیْئًا فَقَالَ : ہُوَ لَکَ وَلِعَقِبِکَ ، فَہُوَ لَہُ وَلِوَرَثَتِہِ وَإِذَا ، قَالَ : ہِیَ لَکَ حَیَاتَکَ ، فَہِیَ رَاجِعَۃٌ إلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20491","","","كتاب البيوع والأقضية"
"20492","(۲۰۴۹۲) حَدَّثَنَا ابْنُ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ ، قَالَ : السُّکْنَی عَارِیَّۃٌ۔","","Musannaf Ibn Abi Shaybah 20492","","","كتاب البيوع والأقضية"
"20493","(۲۰۴۹۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ مُحَمَّدٍ ، قَالَ : اخْتَصَمَ إخْوَۃٌ إلَی شُرَیْحٍ فَقَالَ أَحَدُہُمْ : زَوَّجَنِی وَأَسْکَنَنِی وأثابنی ، فَقَالَ : أَزَوَّجُہُ وَأَسْکَنَہُ ؟ فَقَالُوا : زَوَّجَہُ وَأَسْکَنَہُ فَقَالَ : شَاہِدَانِ ذَوَا عَدْلٍ عَلَی أَنَّہُ آثَرَک بِہَا عَلَی نَفْسِہِ فِی حَیَاتِہِ۔","","Musannaf Ibn Abi Shaybah 20493","","","كتاب البيوع والأقضية"
"20494","(۲۰۴۹۴) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ: تَصَدَّقَ رَجُلٌ بِمِئَۃِ دِینَارٍ عَلَی ابْنِہِ وَہُمَا شَرِیکَانِ وَالْمَالُ فِی یَدَیِ ابْنِہِ ، قَالَ: لاَ یَجُوزُ حَتَّی یَحُوزَہَا ، قَضَی أَبُو بَکْرٍ ، وَعُمَرُ: أَنَّہُ إِنْ لَمْ یَحُزْ فَلاَ شَیْئَ لَہُ۔","","Musannaf Ibn Abi Shaybah 20494","","","كتاب البيوع والأقضية"
"20495","(۲۰۴۹۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ الْقَارِی ، قَالَ : قَالَ عُمَرُ : مَا بَالُ رِجَالٍ یَنْحَلُونَ أَوْلاَدَہُمْ نِحَلاً ، فَإِذَا مَاتَ أَحَدُہُمْ ، قَالَ : مَالِی وَفِی یَدِی ، وَإِذَا مَاتَ ہُوَ ، قَالَ : قَدْ کُنْتُ نَحَلْتُہُ وَلَدِی ، لاَ نَحْلَۃَ إلاَّ نِحْلَۃٌ یَحُوزُہَا الْوَلَدُ أو الْوَالِدِ۔","Sahih","Musannaf Ibn Abi Shaybah 20495","","","كتاب البيوع والأقضية"
"20496","(۲۰۴۹۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدٍ ، قَالَ : شُکِیَ ذَلِکَ إلَی عُثْمَانَ ، أَنَّ الْوَلَدَ إذَا کَانَ صَغِیرًا لاَ یَحُوزُ ، فَرَأَی ، أَنَّ أَبَاہُ إذَا وَہَبَ لَہُ وَأَشْہَدَ حَازَ۔","Sahih","Musannaf Ibn Abi Shaybah 20496","","","كتاب البيوع والأقضية"
"20497","(۲۰۴۹۷) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عِیسَی بْنِ الْمُسَیَّبِ ، عَنِ الشَّعْبِیِّ ، عَنْ عُثْمَانَ ، أَنَّہُ قَالَ : لاَ تَجُوزُ الصَّدَقَۃُ حَتَّی تُقْبَضَ إلاَّ لِصَبِیٍّ بَیْنَ أَبَوَیْہِ ، فَإِنَّ قَبْضَہُمَا لَہُ قَبْضٌ۔","Da'if","Musannaf Ibn Abi Shaybah 20497","","","كتاب البيوع والأقضية"
"20498","(۲۰۴۹۸) حَدَّثَنَا ابْنَ مُبَارَکٍ ، عَنْ حَجَّاجٍ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : لاَ تَجُوزُ الصَّدَقَۃُ حَتَّی تُقْبَضَ۔","","Musannaf Ibn Abi Shaybah 20498","","","كتاب البيوع والأقضية"
"20499","(۲۰۴۹۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20499","","","كتاب البيوع والأقضية"
"20500","(۲۰۵۰۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی حَصِینٍ ، عَنْ شُرَیْحٍ ، قَالَ : لاَ تَجُوزُ الصَّدَقَۃُ حَتَّی تُقْبَضَ۔","","Musannaf Ibn Abi Shaybah 20500","","","كتاب البيوع والأقضية"
"20501","(۲۰۵۰۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الْقَاسِمِ ، قَالَ : کَانَ مُعَاذٌ وَشُرَیْحٌ یَقُولاَنِ : لاَ تَجُوزُ الصَّدَقَۃُ حَتَّی تُقْبَضَ إلاَّ لِصَبِیٍّ بَیْنَ أَبَوَیْہِ۔","Da'if","Musannaf Ibn Abi Shaybah 20501","","","كتاب البيوع والأقضية"
"20502","(۲۰۵۰۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، عَنْ قَتَادَۃَ ، عَنِ النَّضْرِ بْنِ أَنَسٍ ، قَالَ : نَحَلَنِی أَبِی نِصْفَ دَارِہِ ، فَقَالَ أَبُو بُرْدَۃَ : إِنْ سَرَّکَ أَنْ تجوزَ ذَلِکَ فَاقْبِضْہُ ، فَإِنَّ عُمَرَ بْنَ الْخَطَّابِ قَضَی فِی الأَنْحَالِ: مَا قُبِضَ مِنْہُ ، فَہُوَ جَائِزٌ ، وَمَا لَمْ یُقْبَضْ مِنْہُ ، فَہُوَ مِیرَاثٌ۔","Hasan","Musannaf Ibn Abi Shaybah 20502","","","كتاب البيوع والأقضية"
"20503","(۲۰۵۰۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا فَقَالاَ : لاَ تَجُوزُ حَتَّی یُقْبَضَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20503","","","كتاب البيوع والأقضية"
"20504","(۲۰۵۰۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا عُلِمَتِ الصَّدَقَۃُ فَہِیَ جَائِزَۃٌ ، وَإِنْ لَمْ تُقْبَضْ ، فَإِذَا قَالَ : دَارِی الَّتِی فِی مَکَانِ کَذَا وَکَذَا ، أَوْ غُلاَمِی ، فَہُوَ جَائِزٌ ، وَإِنْ لَمْ یَقْبَضْ۔","","Musannaf Ibn Abi Shaybah 20504","","","كتاب البيوع والأقضية"
"20505","(۲۰۵۰۵) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ ، قَالاَ : إذَا عُلِمَت الصَّدَقَۃُ فَہِیَ جَائِزَۃٌ، وَإِنْ لَمْ تُقْبَضْ۔","","Musannaf Ibn Abi Shaybah 20505","","","كتاب البيوع والأقضية"
"20506","(۲۰۵۰۶) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، أَنَّ أَبَا بَکْرٍ کَانَ نَحَلَہَا جِذَاذَ عِشْرِینَ وَسْقًا ، فَلَمَّا حَضَرَ ، قَالَ لَہَا : وَدِدْتُ أَنَّک کُنْتِ حُزْتِیہِ ، أَوْ جَدَدْتِیہِ ، وَإِنَّمَا ہُوَ الْیَوْمُ مَالُ الْوَارِثِ۔","Sahih","Musannaf Ibn Abi Shaybah 20506","","","كتاب البيوع والأقضية"
"20507","(۲۰۵۰۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا عِیسَی بْنُ الْمُسَیَّبِ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِیہِ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : الصَّدَقَۃُ إذَا عُلِمَتْ قُبِضَتْ ، أَوْ لَمْ تُقْبَضْ۔","Da'if","Musannaf Ibn Abi Shaybah 20507","","","كتاب البيوع والأقضية"
"20508","(۲۰۵۰۸) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَجُوزُ الصَّدَقَۃُ حَتَّی تُقْبَضَ۔","","Musannaf Ibn Abi Shaybah 20508","","","كتاب البيوع والأقضية"
"20509","(۲۰۵۰۹) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ فُضَیْلٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : ہِیَ جَائِزَۃٌ ، وَإِنْ لَمْ تُقْبَضْ۔","","Musannaf Ibn Abi Shaybah 20509","","","كتاب البيوع والأقضية"
"20510","(۲۰۵۱۰) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ عَمَّنْ حَدَّثَہُ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَجُوزُ الصَّدَقَۃُ حَتَّی تُقْبَضَ۔","Da'if","Musannaf Ibn Abi Shaybah 20510","","","كتاب البيوع والأقضية"
"20511","(۲۰۵۱۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا بِالْکِتَابَۃِ عَلَی الْوُصَفَائِ۔","","Musannaf Ibn Abi Shaybah 20511","","","كتاب البيوع والأقضية"
"20512","(۲۰۵۱۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، عَنْ نَافِعٍ ، أَنَّ حَفْصَۃَ کَاتَبَتْ غُلاَمًا لَہَا عَلَی وُصَفَائَ۔","Sahih","Musannaf Ibn Abi Shaybah 20512","","","كتاب البيوع والأقضية"
"20513","(۲۰۵۱۳) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ عَبْدِ الْحَمِیدِ بن سَوَّارٍ ، قَالَ : حدَّثَتْنِی خَتَنَۃٌ لِی یُقَالُ لَہَا سَارَۃُ مَوْلاَۃٌ لأَِبِی بَرْزَۃَ أَنْ أَبَا بَرْزَۃَ کَاتَبَ بَعْضَ مَمَالِیکِہِ عَلَی رَقِیقٍ۔","Da'if","Musannaf Ibn Abi Shaybah 20513","","","كتاب البيوع والأقضية"
"20514","(۲۰۵۱۴) حَدَّثَنَا ہُشَیْمٌ وَجَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ بَأْسَ أَنْ یُکَاتَبَ عَبْدٌ عَلَی الْوُصَفَائِ۔nزَادَ فِیہِ جَرِیرٌ : والْوَصَائِفَ۔","","Musannaf Ibn Abi Shaybah 20514","","","كتاب البيوع والأقضية"
"20515","(۲۰۵۱۵) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ عَمَّارٍ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ: لاَ بَأْسَ أن یکاتب عبد عَلَی الْوُصَفَائِ۔","","Musannaf Ibn Abi Shaybah 20515","","","كتاب البيوع والأقضية"
"20516","(۲۰۵۱۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بِہِ بَأْسًا أَنْ یُکَاتَبَ الْمُکَاتَبُ عَلَی الْوُصَفَائِ۔","","Musannaf Ibn Abi Shaybah 20516","","","كتاب البيوع والأقضية"
"20517","(۲۰۵۱۷) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ بَأْسَ أَنْ یُکَاتِبَ عَبْدَہُ عَلَی الْوُصَفَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20517","","","كتاب البيوع والأقضية"
"20518","(۲۰۵۱۸) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنِ الأَوْزَاعِی ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُکَاتِبَ الرَّجُلُ مَمْلُوکَہُ عَلَی الْوُصَفَائِ۔","Sahih","Musannaf Ibn Abi Shaybah 20518","","","كتاب البيوع والأقضية"
"20519","(۲۰۵۱۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ عِکْرِمَۃَ بْنِ خَالِدٍ الْمَخْزُومِیِّ ، أَنَّ رَجُلاً کَاتَبَ عَبْدَہُ عَلَی غُلاَمَیْنِ یَصْنَعَانِ مِثْلَ صِنَاعَتِہِ فَارْتَفَعَا إلَی عُمَرَ بْنِ الْخَطَّابِ فَقَالَ : إِنْ لَمْ یَجِئْک بِغُلاَمَیْنِ یَصْنَعَانِ مِثْلَ صِنَاعَتِہِ فَرُدَّہُ إلَی الرِّقِّ۔","","Musannaf Ibn Abi Shaybah 20519","","","كتاب البيوع والأقضية"
"20520","(۲۰۵۲۰) حَدَّثَنَا عَبْدُالأَعْلَی، عَنْ مَعْمَرٍ، عَنِ الزُّہْرِیِّ، قَالَ: لاَ بَأْسَ أَنْ یُکَاتِبَ عَبْدَہُ عَلَی رَقِیقٍ إلَی أَجَلٍ مُسَمًّی۔","","Musannaf Ibn Abi Shaybah 20520","","","كتاب البيوع والأقضية"
"20521","(۲۰۵۲۱) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالْکِتَابَۃِ عَلَی الْوُصَفَائِ ، یَدًا بِیَدٍ وَیَکْرَہُ ذَلِکَ نَسِیئَۃً ، وَذَلِکَ رَأْیُ قَتَادَۃَ۔","","Musannaf Ibn Abi Shaybah 20521","","","كتاب البيوع والأقضية"
"20522","(۲۰۵۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ زَیْدٍ ، عَنْ عُبَیْدِ اللہِ بْنِ أَبِی بَکْرِ بْنِ أَنَسٍ ، قَالَ : ہَذِہِ مُکَاتَبَۃُ سِیرِینَ عِنْدَنَا ہَذَا مَا کَاتَبَ عَلَیْہِ أَنَسُ بْنُ مَالِکٍ غُلاَمَہُ ، کَاتَبَہُ عَلَی کَذَا وَکَذَا من أَلْفٍ ، وَعَلَی غُلاَمَیْنِ لہ یَعْمَلاَنِ مِثْلَ عَمَلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 20522","","","كتاب البيوع والأقضية"
"20523","(۲۰۵۲۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نُہِی ، عَنِ الْعِینَۃِ۔n(بخاری ۲۱۲۶۔ مسلم ۱۱۶۰)","Da'if","Musannaf Ibn Abi Shaybah 20523","","","كتاب البيوع والأقضية"
"20524","(۲۰۵۲۴) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ مَسْرُوقٍ ، قَالَ : الْعِینَۃُ حَرَامٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 20524","","","كتاب البيوع والأقضية"
"20525","(۲۰۵۲۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ ، أَنَّہُ کَانَ یَرَی التورق یَعْنِی الْعِینَۃَ۔","","Musannaf Ibn Abi Shaybah 20525","","","كتاب البيوع والأقضية"
"20526","(۲۰۵۲۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَرِہَ الْعِینَۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20526","","","كتاب البيوع والأقضية"
"20527","(۲۰۵۲۷) حَدَّثَنَا مُعَاذٌ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : ذَکَرُوا عِنْدَ مُحَمَّدٍ الْعِینَۃَ فَقَالَ : نُبِّئْتُ ، أَنَّ ابْنَ عَبَّاسٍ کَانَ یَقُولُ : دَرْہَمٌ بِدِرْہَمٍ وَبَیْنَہُمَا حَرِیرَۃٌ۔","Da'if","Musannaf Ibn Abi Shaybah 20527","","","كتاب البيوع والأقضية"
"20528","(۲۰۵۲۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أَبِی جَنَابٍ وَیَزِیدَ بْنِ مَرْدَانُبَۃَ ، قَالَ أَحَدُہُمَا : جَائَنَا ، وَقَالَ الآخَرُ : جَائَ کِتَابُ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ إلَی عَبْدِ الْحَمِیدِ : إِنَّہُ مَنْ قِبَلَکَ عَنِ الْعِینَۃِ ، فَإِنَّہَا أُخْتُ الرِّبَا۔","","Musannaf Ibn Abi Shaybah 20528","","","كتاب البيوع والأقضية"
"20529","(۲۰۵۲۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الرَّبِیعِ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَرِہَا الْعِینَۃَ وَمَا أدْخَلَ النَّاسُ فِیہِ بینہا۔","","Musannaf Ibn Abi Shaybah 20529","","","كتاب البيوع والأقضية"
"20530","(۲۰۵۳۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، قَالَ : سَمِعْتُ مَسْرُوقًا کَرِہَ الْعِینَۃَ وَالْحَرِیرَ۔","","Musannaf Ibn Abi Shaybah 20530","","","كتاب البيوع والأقضية"
"20531","(۲۰۵۳۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی حَمْزَۃَ عِمْرَانَ بْنِ أَبِی عَطَائٍ ، قَالَ : شَہِدْت شُرَیْحًا وَاخْتَصَمَ إلَیْہِ رَجُلاَنِ اکْتَرَی أَحَدُہُمَا مِنَ الآخَرِ دَابَّۃً إلَی مَکَان مَعْلُومٍ فَجَاوَزَ ، فَضَمَّنَہُ شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 20531","","","كتاب البيوع والأقضية"
"20532","(۲۰۵۳۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ ، عَن رَجُلٍ تَکَارَی دَابَّۃً فَجَاوَزَ بِہَا ، قَالَ : ہُوَ ضَامِنٌ ، وَلاَ کِرَائَ عَلَیْہِ فِیمَا خَالَفَ۔","","Musannaf Ibn Abi Shaybah 20532","","","كتاب البيوع والأقضية"
"20533","(۲۰۵۳۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : إذَا سَلِمَت الدَّابَّۃُ اجْتَمَعَ عَلَیْہِ الْکِرَائَانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20533","","","كتاب البيوع والأقضية"
"20534","(۲۰۵۳۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، قَالَ : حدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، قَالَ : حَدَّثَنِی مُحَمَّدُ بْنُ عُبَیْدِ اللہِ الثَّقَفِیُّ ، عَنْ شُرَیْحٍ أَنَّہُ قَضَی فِی رَجُلٍ اسْتَأْجَرَ مِنْ رَجُلٍ دَابَّۃً إلَی البردمۃ ، فَجَاوَزَ عَلَیْہَا الْوَقْتَ فَعَطِبَتْ فَمَاتَتْ ، فَجَعَلَ عَلَیْہِ الأَجْرَ إلَی الْمَکَانِ الَّذِی سَمَّی ، وَضَمَّنَہُ الدَّابَّۃَ حِینَ خَالَفَ۔","","Musannaf Ibn Abi Shaybah 20534","","","كتاب البيوع والأقضية"
"20535","(۲۰۵۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنِ الْحَسَنِ بْنِ عُبَیْدِ اللہِ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا تَکَارَی الرَّجُلُ الدَّابَّۃَ إلَی الْمَکَانِ کَانَ لَہُ کِرَاؤُہَا ، فَإِنْ جَاوَزَ عَلَیْہَا فَنَفَقَتْ کَانَ لَہُ کِرَاؤُہَا الأَوَّلُ ، وَعَلَیْہِ أَنْ یَضْمَنَہَا۔","","Musannaf Ibn Abi Shaybah 20535","","","كتاب البيوع والأقضية"
"20536","(۲۰۵۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أبی عَوْنٍ ، عَنْ شُرَیْحٍ فِی رَجُلٍ اکْتَرَی دَابَّۃً فَجَاوَزَ الْوَقْتَ ، قَالَ : یُجْمَعُ عَلَیْہِ الْکِرَائُ وَالضَّمَانُ۔","","Musannaf Ibn Abi Shaybah 20536","","","كتاب البيوع والأقضية"
"20537","(۲۰۵۳۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ فِی رَجُلٍ اشْتَرَی مِنْ رَجُلٍ مَتَاعًا ہَلَکَ فِی یَدَیِ الْبَائِعِ قَبْلَ أَنْ یَقْبِضَہُ ، قَالَ : إِنْ کَانَ قَالَ لَہُ : خُذْ مَتَاعَک ، فَلَمْ یَأْخُذْہُ ، فَہُوَ مِنْ مَالِ الْمُشْتَرِی ، وَإِنْ کَانَ ، قَالَ : لاَ أَدْفَعُہُ لَکَ حَتَّی تَأْتِیَ بِالثمنِ ، فَہُوَ مَالُ الْبَائِعِ۔","","Musannaf Ibn Abi Shaybah 20537","","","كتاب البيوع والأقضية"
"20538","(۲۰۵۳۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ عن دَاوُد ، قَالَ : قُلْتُ لِعَامِرٍ : رَجُلٌ اشْتَرَی بَزًّا إلَی أَجَلٍ فَحَبَسَہُ وَعَکَمَہُ وَوَضَعَہُ فِی مَنْزِلِ الْبَائِعِ وَلَمْ یَحْتَبِسْہُ رَہْنًا بِالْمَالِ ، فَاحْتَرَقَ الْمَالُ ، قَالَ : مِنْ مَالِ الْبَائِعِ۔","","Musannaf Ibn Abi Shaybah 20538","","","كتاب البيوع والأقضية"
"20539","(۲۰۵۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا اشْتَرَی الرَّجُلُ الْمَتَاعَ فَقَالَ : الْمُشْتَرِی : انْقُلْہُ إلَیَّ ، وَقَالَ الْبَائِعُ : لاَ حَتَّی تَأْتِیَنِی بِالثمنِ فَہَذَا بِمَنْزِلَۃِ الرَّہْنِ ، إِنْ ہَلَکَ ، فَہُوَ مِنْ مَالِ الْبَائِعِ ، وَإِنْ قَالَ الْبَائِعُ لِلْمُشْتَرِی : انْقُلْہُ ، فَقَالَ : دَعْہُ حَتَّی آتِیَک بِالثمن ، فَہَذَا بِمَنْزِلَۃِ الْوَدِیعَۃِ ، إِنْ ہَلَکَ ، فَہُوَ مِنْ مَالِ الْمُشْتَرِی ، وَیَبِیعُ ہَذَا ، وَلاَ یَبِیعُ ذَاکَ ، قَالَ ابْنُ عَوْنٍ : فَذَکَرْتہ لِمُحَمَّدٍ فَقَالَ : صَدَقَ أَظُنُّ۔","","Musannaf Ibn Abi Shaybah 20539","","","كتاب البيوع والأقضية"
"20540","(۲۰۵۴۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن دَاوُدَ بْنِ أَبِی ہِنْدٍ ، أَنَّ رَجُلاً ابْتَاعَ مِنْ رَجُلٍ مَتَاعًا إلَی أَجَلٍ ، وَحَبَسَہُ ، فَبَیَّتَہُمْ حَرِیقٌ مِنَ اللَّیْلِ فَاحْترَقَ بَعْضَہُ ، فَسَأَلْتُ الشَّعْبِیَّ فَقَالَ : ہُوَ مِنْ مَالِ الَّذِی ہُوَ فِی یَدَیْہِ۔","","Musannaf Ibn Abi Shaybah 20540","","","كتاب البيوع والأقضية"
"20541","(۲۰۵۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ : إذَا اشْتَرَطَ عَلَی مُکَاتَبِہِ أَلاَّ یَخْرُجَ ، وَلاَ یَتَزَوَّجَ ، قَالَ : فَشَرْطُہُ بَاطِلٌ ، یَسِیرُ حَیْثُ یَشَائَ وَیَتَزَوَّجُ۔","","Musannaf Ibn Abi Shaybah 20541","","","كتاب البيوع والأقضية"
"20542","(۲۰۵۴۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : إنَّکُمْ تَشْتَرِطُونَ عَلَی الْمُکَاتَبِ شُرُوطًا لاَ تَحِلُّ ، تَشْتَرِطُونَ عَلَیْہِ أَلاَّ یَخْرُجَ ، وَلاَ یَتَزَوَّجَ ، قَالَ : یَخْرُجُ وَیَتَزَوَّجُ۔","","Musannaf Ibn Abi Shaybah 20542","","","كتاب البيوع والأقضية"
"20543","(۲۰۵۴۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20543","","","كتاب البيوع والأقضية"
"20544","(۲۰۵۴۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : لأَہْلِ المکاتبِ مَا اشْتَرَطُوا عَلَیْہِ وَلَہُمْ مَا أَخَذُوا مِنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 20544","","","كتاب البيوع والأقضية"
"20545","(۲۰۵۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْجَہْمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : یَخْرُجُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 20545","","","كتاب البيوع والأقضية"
"20546","(۲۰۵۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ اشْتَرَطَ عَلَی مُکَاتَبِہِ أَنْ لاَّ یَخْرُجَ ، قَالَ : یَخْرُجُ ، قَالَ وَکِیعٌ ، وقَالَ سُفْیَانُ : لاَ یَخْرُجُ إلاَّ بِإِذْنِ مَوْلاَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20546","","","كتاب البيوع والأقضية"
"20547","(۲۰۵۴۷) حَدَّثَنَا أَبُو بَحْرٍ الْبَکْرَاوِیُّ، عَنْ مُحَمَّدِ بْنِ أَبِی یَحْیَی، قَالَ: أَخْبَرَتْنِی أُمِّی، أَنَّ جَدَّہَا کَانَ مُکَاتَبًا لِعَبْدِ اللہِ بْنِ قَیْسٍ الأَسْلَمِیِّ ، فَأَرَادَ الْخُرُوجَ إلَی الْبَصْرَۃِ فَمَنَعَہُ فَأَتَی عُثْمَانَ فَقَالَ : لَیْسَ لَکَ أَنْ تَمْنَعَہُ ، فَخَلَّی عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 20547","","","كتاب البيوع والأقضية"
"20548","(۲۰۵۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ؛ فِی الرَّجُلِ یَشْتَرِطُ عَلَی مُکَاتَبِہِ أَنْ لاَّ یَخْرُجَ ، وَلاَ یَتَزَوَّجَ ، قَالَ : یَتَزَوَّجُ وَیَخْرُجُ۔","","Musannaf Ibn Abi Shaybah 20548","","","كتاب البيوع والأقضية"
"20549","(۲۰۵۴۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ وَحَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَشْتَرِطُوا عَلَی الْمُکَاتَبِ مَا یُضِرُّ بِہِ : أَنْ لاَّ یَخْرُجَ مِنَ الْمِصْرِ ، وَلاَ یَتَزَوَّجَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20549","","","كتاب البيوع والأقضية"
"20550","(۲۰۵۵۰) حَدَّثَنَا شَرِیکُ بْنُ عَبْدِ اللہِ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ خَبَّابٌ قیْنًا وَکَانَ رُبَّمَا اشْتَرَی السَّیْفَ الْمُحَلَّی بِالْوَرِقِ وَرُبَّمَاْ ذُکِرَ الْمُصْحَفَ۔","","Musannaf Ibn Abi Shaybah 20550","","","كتاب البيوع والأقضية"
"20551","(۲۰۵۵۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ، عَنْ حُصَیْنٍ، عَنِ الشَّعْبِیِّ، قَالَ: لاَ بَأْسَ أَنْ یَشْتَرِیَ السَّیْفَ الْمُحَلَّی بِالدراہم۔","","Musannaf Ibn Abi Shaybah 20551","","","كتاب البيوع والأقضية"
"20552","(۲۰۵۵۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ أَشْعَثَ، عَنِ الْحَسَنِ، قَالَ: لاَ بَأْسَ أَنْ یَشْتَرِیَ السَّیْفَ الْمُفَضَّضَ بالتأخیر۔","","Musannaf Ibn Abi Shaybah 20552","","","كتاب البيوع والأقضية"
"20553","(۲۰۵۵۳) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ أَنَّہُ کَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20553","","","كتاب البيوع والأقضية"
"20554","(۲۰۵۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَنَسٍ ، قَالَ : أَتَانَا کِتَابُ عُمَرَ وَنَحْنُ بِأَرْضِ فَارِسَ أَنْ لاَ تَبِیعُوا السُّیُوفَ فِیہَا حَلْقَۃُ فِضَّۃٍ بِالدِّرْہَمِ۔","Sahih","Musannaf Ibn Abi Shaybah 20554","","","كتاب البيوع والأقضية"
"20555","(۲۰۵۵۵) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ سَعِیدِ بْنِ یَزِیدَ ، قَالَ : سَمِعْتُ خَالِدَ بْنَ أَبِی عِمْرَانَ یُحَدِّثُ ، عَنْ حَنَشٍ ، عَنْ فَضَالَۃَ بْنِ عُبَیْدٍ ، قَالَ : أُتِیَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَوْمَ خَیْبَرَ بِقِلاَدَۃٍ فِیہَا خَرَزٌ مُعَلَّقَۃٌ بِذَہَبٍ ابْتَاعَہَا رَجُلٌ بِتِسْعَۃِ دَنَانِیرَ ، أَوْ بِسَبْعَۃٍ فَأَتَی النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَذَکَرَ ذَلِکَ لَہُ فَقَالَ : لاَ حَتَّی تُمَیِّزَ مَا بَیْنَہُمَا ، فَقَالَ : إنَّمَا أَرَدْت الْحِجَارَۃَ ، قَالَ : لاَ حَتَّی تُمَیِّزَ مَا بَیْنَہُمَا قَالَ : فَرَدَّہُ حَتَّی مَیَّزَ مَا بَیْنَہُمَا۔n(مسلم ۱۲۱۴۔ ابوداؤد ۳۳۴۴)","Hasan","Musannaf Ibn Abi Shaybah 20555","","","كتاب البيوع والأقضية"
"20556","(۲۰۵۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : سُئِلَ شُرَیْحٌ ، عَنْ قَوْسِ ذَہَبٍ فِیہِ فُصُوصٌ ، قَالَ : تُنْزَعُ الْفُصُوصُ ، ثُمَّ یُبْتَاعُ الذَّہَبُ وَزْنًا بِوَزْنٍ۔","","Musannaf Ibn Abi Shaybah 20556","","","كتاب البيوع والأقضية"
"20557","(۲۰۵۵۷) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ تُبَاعُ الْمِنْطَقَۃُ الْمُحَلاَّۃُ وَالسَّیْفُ الْمُحَلَّی بِنَسِیئَۃٍ۔","","Musannaf Ibn Abi Shaybah 20557","","","كتاب البيوع والأقضية"
"20558","(۲۰۵۵۸) حَدَّثَنَا عُثْمَانُ بْنُ مَطَرٍ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، وَعَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّہُمَا لَمْ یَرَیَا بَأْسًا بِشِرَائِ السَّیْفِ الْمُفَضَّضِ ، وَالْخِوَانِ الْمُفَضَّضِ ، وَالْقَدَحِ الْمُفَضَّضِ بِالدِّرْہَمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20558","","","كتاب البيوع والأقضية"
"20559","(۲۰۵۵۹) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُشْتَرَی السَّیْفُ الْمُحَلَّی بِفِضَّۃٍ وَیَقُولُ : اشْتَرِہِ بِالذَّہَبِ یَدًا بِیَدٍ۔","","Musannaf Ibn Abi Shaybah 20559","","","كتاب البيوع والأقضية"
"20560","(۲۰۵۶۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سَعِیدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : سَأَلْتُ سُلَیْمَانَ بْنَ مُوسَی ، عَنِ السَّیْفِ الْمُحَلَّی بِالْفِضَّۃِ فَقَالَ : لاَ بَأْسَ بِہِ ، وَقَالَ مَکْحُولٌ : الْجَارِیَۃُ تُبَاعُ وَعَلَیْہَا حُلِیٌّ۔","","Musannaf Ibn Abi Shaybah 20560","","","كتاب البيوع والأقضية"
"20561","(۲۰۵۶۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا ، عَنِ السَّیْفِ الْمُحَلَّی یُبَاعُ بِالدِّرْہَمِ فَقَالَ : لاَ بَأْسَ بِہِ ، وَقَالَ الْحَکَمُ : إذَا کَانَتِ الدَّرَاہِمُ أَکْثَرَ مِنَ الْحِلْیَۃِ فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 20561","","","كتاب البيوع والأقضية"
"20562","(۲۰۵۶۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عُمَارَۃَ بْنِ أَبِی حَفْصَۃَ ، عَنِ الْمُغِیرَۃِ بْنِ حُنَیْنٍ ، قَالَ : سئل عَلِیًّا عَنْ جَامَاتٍ مِنْ ذَہَبٍ ، مَخْلُوطات بِفِضَّۃٍ أَتُبَاعُ بِالْفِضَّۃِ ؟ قَالَ : فَقَالَ : ہَکَذَا بِرَأْسِہِ ، أَیْ لاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 20562","","","كتاب البيوع والأقضية"
"20563","(۲۰۵۶۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن أَیُّوبَ ، أَنَّ مُحَمَّدًا کَانَ یَکْرَہُ شِرَائَ السَّیْفِ الْمُحَلَّی إلاَّ بِعَرَضٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 20563","","","كتاب البيوع والأقضية"
"20564","(۲۰۵۶۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا إذَا کَانَ الثمنُ أَکْثَرَ مِنَ الْحِلْیَۃِ ، وَیَکْرَہُہُ إذَا کَانَ الثمنُ أَقَلَّ مِنَ الْحِلْیَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20564","","","كتاب البيوع والأقضية"
"20565","(۲۰۵۶۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن سَعِیدِ بْنِ أَبِی عَرُوبَۃَ وَغَیْرِہِ ، أَنَّ الْحَسَنَ کَانَ لاَ یَرَی بَأْسًا بِاشْتِرَائِ السَّیْفِ الْمُحَلَّی وَالْخَاتَمِ بِالدِّرْہَمِ۔","","Musannaf Ibn Abi Shaybah 20565","","","كتاب البيوع والأقضية"
"20566","(۲۰۵۶۶) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ یَزِیدَ الدَّالاَنِیِّ ، عَنْ قَیْسِ بْنِ مُسْلِمٍ ، عَنْ طَارِقِ بْنِ شِہَابٍ ، قَالَ : کُنَّا نَبِیعُ السَّیْفَ الْمُحَلَّی بِالْفِضَّۃِ وَنَشْتَرِیہِ۔","","Musannaf Ibn Abi Shaybah 20566","","","كتاب البيوع والأقضية"
"20567","(۲۰۵۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إِسْمَاعِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ بِبَیْعِ السَّیْفِ الْمُحَلَّی بِالدَّرَاہِمِ۔","Sahih","Musannaf Ibn Abi Shaybah 20567","","","كتاب البيوع والأقضية"
"20568","(۲۰۵۶۸) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنْ إبْرَاہِیمَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِبَیْعِ مَنْ یَزِیدُ ، کَذَلِکَ کَانَتْ تُبَاعُ الأَخْمَاسُ۔","","Musannaf Ibn Abi Shaybah 20568","","","كتاب البيوع والأقضية"
"20569","(۲۰۵۶۹) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، أَنَّہُ کَرِہَ بَیْعَ مَنْ یَزِیدُ إلاَّ الشُّرَکَائَ بَیْنَہُمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 20569","","","كتاب البيوع والأقضية"
"20570","(۲۰۵۷۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَمْرِو بْنِ مُہَاجِرٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ بَعَثَ عمیرۃ بْنَ یزِید الْفِلَسْطِینِیَّ یَبِیعُ السَّبْیَ فِیمَنْ یَزِیدُ ، فَلَمَّا فَرَغَ جَائَہُ فَقَالَ لَہُ : عُمَرُ : کَیْف کَانَ الْبَیْعُ الْیَوْمَ ؟ فَقَالَ : إِنْ کَانَ کَاسِدًا یَا أَمِیرَ الْمُؤْمِنِینَ ، لَوْلاَ أَنِّی کُنْتُ أَزِیدَ عَلَیْہِمْ فَأُنْفِقُہُ ، فَقَالَ عُمَرُ : کُنْتَ تَزِیدُہُ عَلَیْہِمْ ، وَلاَ تُرِیدُ أَنْ تَشْتَرِیَ ؟ فَقَالَ : نَعَمْ ، قَالَ عُمَرُ ہَذَا النَّجْشُ لاَ یَحِلُّ ، ابْعَثْ یَا عمیرۃ مُنَادِیًا یُنَادِی أَلاَ إنَّ الْبَیْعَ مَرْدُودٌ إِنَّ النَّجْشَ لاَ یَحِلُّ۔","","Musannaf Ibn Abi Shaybah 20570","","","كتاب البيوع والأقضية"
"20571","(۲۰۵۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حِزَامِ بْنِ ہِشَامٍ الْخُزَاعِیِّ ، عَنْ أَبِیہِ ، قَالَ : شَہِدْتُ عُمَرَ بْنَ الْخَطَّابِ بَاعَ إبِلاً مِنْ إبِلِ الصَّدَقَۃِ فِیمَنْ یَزِیدُ۔","Hasan","Musannaf Ibn Abi Shaybah 20571","","","كتاب البيوع والأقضية"
"20572","(۲۰۵۷۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنِ الأَخْضَرِ بْنِ عَجْلاَنَ ، عَنْ أَبِی بَکْرٍ الْحَنَفِیِّ ، عَنْ أَنَسِ بْنِ مَالِکٍ ، عَنْ رَجُلٍ مِنَ الأَنْصَارِ ، أَنَّ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ بَاعَ حِلْسًا وَقَدَحًا فِیمَنْ یَزِیدُ۔n(نسائی ۶۰۹۹۔ ترمذی ۴۷۹)","Da'if","Musannaf Ibn Abi Shaybah 20572","","","كتاب البيوع والأقضية"
"20573","(۲۰۵۷۳) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ حَمَّادٍ، قَالَ: لاَ بَأْسَ بِبَیْعِ مَنْ یَزِیدُ، إِنْ تَزیِد فِی السَّوْمِ إذَا أَرَدْتَ أَنْ تَشْتَرِیَ۔","","Musannaf Ibn Abi Shaybah 20573","","","كتاب البيوع والأقضية"
"20574","(۲۰۵۷۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا کَرِہَا بَیْعَ مَنْ یَزِیدُ إلاَّ بَیْعَ الْمَوَارِیثِ وَالْغَنَائِمِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20574","","","كتاب البيوع والأقضية"
"20575","(۲۰۵۷۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ عَمَّنْ سَمِعَ مُجَاہِدًا ، وَعَطَائً ، قَالاَ : لاَ بَأْسَ ببَیْعِ مَنْ یَزِیدُ۔","","Musannaf Ibn Abi Shaybah 20575","","","كتاب البيوع والأقضية"
"20576","(۲۰۵۷۶) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ أَبِی جَعْفَرٍ الْخِطْمِیِّ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ أَنَّہُ بَاعَ الْمَغَانِمَ فِیمَنْ یَزِیدُ۔","","Musannaf Ibn Abi Shaybah 20576","","","كتاب البيوع والأقضية"
"20577","(۲۰۵۷۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ أَبِی إِسْحَاقَ الشَّیْبَانِیِّ ، عَنْ مُسْلِمِ بْنِ صُبَیْحٍ ، قَالَ : خطر عَلَیَّ رَجُلاً مِنَ الْبَصْرَۃِ وَمَعَہُ مَصَاحِفُ یَبِیعُہَا فَأَتَیْتُ مَسْرُوقَ بْنَ الأَجْدَعِ ، وَعَبْدَ اللہِ بْنَ یَزِیدَ الأَنْصَارِیَّ وَشُرَیْحًا فَسَأَلْتُہُمْ فَقَالُوا : مَا نُحِبُّ أَنْ نَأْخُذَ بِکِتَابِ اللہِ ثَمَنًا۔","","Musannaf Ibn Abi Shaybah 20577","","","كتاب البيوع والأقضية"
"20578","(۲۰۵۷۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ عَبِیْدَۃَ ، أَنَّہُ کَرِہَ بَیْعَ الْمَصَاحِفِ وَابْتِیَاعَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20578","","","كتاب البيوع والأقضية"
"20579","(۲۰۵۷۹) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ أَبِی مُحَمَّدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : وَدِدْتُ أَنِّی قَدْ رَأَیْتُ الأَیْدِیَ تُقَطَّعُ فِی بَیْعِ الْمَصَاحِفِ۔","Da'if","Musannaf Ibn Abi Shaybah 20579","","","كتاب البيوع والأقضية"
"20580","(۲۰۵۸۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَلحْسُ الدُّبُر أَحَبُّ إلَیَّ مِنْ بَیْعِ الْمَصَاحِفِ ، وَکَانَ یَکْرَہُ أَنْ یَأْخُذَ عَلَی عَرْضِہَا أَجْرًا۔","Hasan","Musannaf Ibn Abi Shaybah 20580","","","كتاب البيوع والأقضية"
"20581","(۲۰۵۸۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ بَیْعَ الْمَصَاحِفِ ، وَقَالَ : ہِیَ لِمَنْ یَقْرَأُ مِنْ أَہْلِ الْبَیْتِ ، وَکَرِہَ الْکِتَابَ فِیہَا بِالأُجْرَۃِ۔","","Musannaf Ibn Abi Shaybah 20581","","","كتاب البيوع والأقضية"
"20582","(۲۰۵۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عِکْرِمَۃَ بْنِ عَمَّارٍ ، عَنْ سَالِمٍ ، قَالَ : بِئْسَ التِّجَارَۃُ بَیْعُ الْمَصَاحِفِ۔","","Musannaf Ibn Abi Shaybah 20582","","","كتاب البيوع والأقضية"
"20583","(۲۰۵۸۳) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن لَیْثٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، عَنْ عَبْدِ اللہِ ، أَنَّہُ کَرِہَ شِرَائَ الْمَصَاحِفِ وَبَیْعَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 20583","","","كتاب البيوع والأقضية"
"20584","(۲۰۵۸۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سَالِمٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : وَدِدْتُ أَنِّی رَأَیْتُ الأَیْدِیَ تُقَطَّعُ فِی بَیْعِ الْمَصَاحِفِ۔","Sahih","Musannaf Ibn Abi Shaybah 20584","","","كتاب البيوع والأقضية"
"20585","(۲۰۵۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ عَلْقَمَۃُ یَکْرَہُ بَیْعَ الْمَصَاحِفِ۔","Hasan","Musannaf Ibn Abi Shaybah 20585","","","كتاب البيوع والأقضية"
"20586","(۲۰۵۸۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، أَنَّ ابْنَ سِیرِینَ کَانَ یَکْرَہُ بَیْعَہَا وَشِرَائَہَا۔","","Musannaf Ibn Abi Shaybah 20586","","","كتاب البيوع والأقضية"
"20587","(۲۰۵۸۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا سُفْیَانُ، عَنْ أَبِی حَصِینٍ، عَنْ أَبِی الضُّحَی ، قَالَ : سَأَلْتُ شُرَیْحًا وَمَسْرُوقًا، وَعَبْدَ اللہِ بْنَ یَزِیدَ ، عَنْ بَیْعِ الْمَصَاحِفِ فَقَالُوا : لاَ تَأْخُذْ بِکِتَابِ اللہِ ثَمَنًا۔","","Musannaf Ibn Abi Shaybah 20587","","","كتاب البيوع والأقضية"
"20588","(۲۰۵۸۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ، قَالَ : قُلْتُ لِعَلْقَمَۃَ : أَبِیعُ مُصْحَفًا ؟ قَالَ : لاَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20588","","","كتاب البيوع والأقضية"
"20589","(۲۰۵۸۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، أَنَّہُ قَالَ : اشْتَرِہَا ، وَلاَ تَبِعْہَا۔","","Musannaf Ibn Abi Shaybah 20589","","","كتاب البيوع والأقضية"
"20590","(۲۰۵۹۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ إبْرَاہِیمَ ، وَابْنُ إدْرِیسَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ أَنَّہُ رَخَّصَ فِی اشْتِرَائِ الْمَصَاحِفِ وَکَرِہَ بَیْعَہَا۔","Da'if","Musannaf Ibn Abi Shaybah 20590","","","كتاب البيوع والأقضية"
"20591","(۲۰۵۹۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20591","","","كتاب البيوع والأقضية"
"20592","(۲۰۵۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : اشْتَرِہَا ، وَلاَ تَبِعْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 20592","","","كتاب البيوع والأقضية"
"20593","(۲۰۵۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، قَالَ : لاَ بَأْسَ بِشِرَائِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20593","","","كتاب البيوع والأقضية"
"20594","(۲۰۵۹۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِشِرَائِ الْمَصَاحِفِ ، وَأَنْ یُعْطِیَ عَلَی کِتَابِہَا أَجْرًا۔","","Musannaf Ibn Abi Shaybah 20594","","","كتاب البيوع والأقضية"
"20595","(۲۰۵۹۵) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مَعْمَرٍ ، عَنْ قَتَادَۃَ ، قَالَ : اشْتَرِ ، وَلاَ تَبِعْ۔","","Musannaf Ibn Abi Shaybah 20595","","","كتاب البيوع والأقضية"
"20596","(۲۰۵۹۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، قَالَ : أَمَرَنِی الشَّعْبِیُّ أَنْ أَبِیعَ۔","","Musannaf Ibn Abi Shaybah 20596","","","كتاب البيوع والأقضية"
"20597","(۲۰۵۹۷) حَدَّثَنَا عَفَّانُ ، قَالَ: حدَّثَنَا ہَمَّامٌ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، قَالَ: سَأَلْتُ أَبَا سَلَمَۃَ ، عَنْ بَیْعِ الْمَصَاحِفِ، فَقَالَ : اشْتَرِہَا ، وَلاَ تَبِعْہَا۔","","Musannaf Ibn Abi Shaybah 20597","","","كتاب البيوع والأقضية"
"20598","(۲۰۵۹۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ، عَنْ دَاوُدَ، عَنْ أَبِی الْعَالِیَۃِ وَالشَّعْبِیِّ، أَنَّہُمَا کَانَا یُرَخِّصَانِ فِی بَیْعِ الْمَصَاحِفِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20598","","","كتاب البيوع والأقضية"
"20599","(۲۰۵۹۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن دَاوُدَ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ قَالَ : إنَّہُمَا لَیْسُوا یَبِیعُونَ کِتَابَ اللہِ ، إنَّمَا یَبِیعُونَ الْوَرِقَ وَعَمَلَ أَیْدِیہِمْ۔","","Musannaf Ibn Abi Shaybah 20599","","","كتاب البيوع والأقضية"
"20600","(۲۰۶۰۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بِبَیْعِہَا وَشِرَائِہَا بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20600","","","كتاب البيوع والأقضية"
"20601","(۲۰۶۰۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن سَعِیدٍ ، عَنْ مَطَرٍ الْوَرَّاقِ ، عَنِ الْحَسَنِ وَالشَّعْبِیِّ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا بِبَیْعِ الْمَصَاحِفِ۔","","Musannaf Ibn Abi Shaybah 20601","","","كتاب البيوع والأقضية"
"20602","(۲۰۶۰۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ دَاوُدَ ، عَنِ الْحَسَنِ أَنَّہُ لَمْ یَکُنْ یَرَی بِبَیْعِہَا وَشِرَائِہَا بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20602","","","كتاب البيوع والأقضية"
"20603","(۲۰۶۰۳) حَدَّثَنَا قَاسِمُ بْنُ مَالِکٍ الْمُزَنِیّ ، عَنْ أَیُّوبَ بْنِ عَائِذٍ ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : ہَاہُنَا قَوْمٌ یَکْتُبُونَ الْمَصَاحِفَ بِالأَجْرِ فَقَالَ : أَمَّا أَنْتَ فَلاَ تَفْعَلْہُ۔","","Musannaf Ibn Abi Shaybah 20603","","","كتاب البيوع والأقضية"
"20604","(۲۰۶۰۴) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ أَنَّہُ یُکْرَہُ أَنْ یُشَارِطَ عَلَی کِتَابَتِہَا۔","","Musannaf Ibn Abi Shaybah 20604","","","كتاب البيوع والأقضية"
"20605","(۲۰۶۰۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی لَیْلَی ، عَنْ أَخِیہِ عِیسَی ، عَنْ أَبِیہِ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی أَنَّہُ کَتَبَ لَہُ نَصْرَانِیٌّ مُصْحَفًا مِنْ أَہْلِ الْحِیرَۃِ بِتِسْعِینَ دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 20605","","","كتاب البيوع والأقضية"
"20606","(۲۰۶۰۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ کِتَابَ الْمَصَاحِفِ بِالأَجْرِ وَتَأَوَّلَ ہَذِہِ الآیَۃَ {فَوَیْلٌ لِلَّذِینَ یَکْتُبُونَ الْکِتَابَ بِأَیْدِیہِمْ}۔","","Musannaf Ibn Abi Shaybah 20606","","","كتاب البيوع والأقضية"
"20607","(۲۰۶۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ أَنَّہُ أَرَادَ أَنْ یَکْتُبَ مُصْحَفًا فَاسْتَعَانَ أَصْحَابَہُ وَکَتَبُوہُ۔","","Musannaf Ibn Abi Shaybah 20607","","","كتاب البيوع والأقضية"
"20608","(۲۰۶۰۸) حَدَّثَنَا حَفْصٌ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُعْطِی عَلَی کِتَابِہِ ، یَعْنِی أَجْرًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20608","","","كتاب البيوع والأقضية"
"20609","(۲۰۶۰۹) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یُعْطِیَ عَلَی کِتَابِہَا أَجْرًا۔","","Musannaf Ibn Abi Shaybah 20609","","","كتاب البيوع والأقضية"
"20610","(۲۰۶۱۰) حَدَّثَنَا جَرِیر ، عَنْ مَنْصُور ، عَنْ مُجَاہِد ، قَالَ : کُنْتُ مَعَ ابْنِ عُمَرَ أَمْشِی فِی السُّوقِ فَإِذَا نَحْنُ بِنَاسٍ مِنَ النَّخَّاسِینَ قَدِ اجْتَمَعُوا عَلَی جَارِیَۃٍ یُقَلِّبُونَہَا ، فَلَمَّا رَأَوُ ابْنَ عُمَرَ تَنَحَّوْا وَقَالُوا : ابْنُ عُمَرَ قَدْ جَائَ ، فَدَنَا مِنْہَا ابْنُ عُمَرَ فَلَمَسَ شَیْئًا مِنْ جَسَدِہَا ، وَقَالَ : أَیْنَ أَصْحَابُ ہَذِہِ الْجَارِیَۃِ ، فَإنَّمَا ہِیَ سِلْعَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20610","","","كتاب البيوع والأقضية"
"20611","(۲۰۶۱۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَانَ إذَا أَرَادَ أَنْ یَشْتَرِیَ الْجَارِیَۃَ وَضَعَ یَدَہُ عَلَی أَلْیَتَیْہَا ، أَوْ بَیْنَ فَخْذِہَا وَرُبَّمَا کَشَفَ عَنْ سَاقَیْہَا۔","Sahih","Musannaf Ibn Abi Shaybah 20611","","","كتاب البيوع والأقضية"
"20612","(۲۰۶۱۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عُبَیْدِ الْمُکْتِبِ ، عَنْ إِبْرَاہِیمَ ، عَن رَجُلٍ مِنْ أَصْحَابِ عَبْدِ اللہِ ، أَنَّہُ قَالَ : مَا أُبَالِی مَسِسْتہَا ، أَوْ مَسِسْت ہَذَا الْحَائِطَ۔","","Musannaf Ibn Abi Shaybah 20612","","","كتاب البيوع والأقضية"
"20613","(۲۰۶۱۳) حَدَّثَنَا وَکِیعٌ، عَنْ عَبْدِ اللہِ بْنِ حَبِیبٍ، عَنْ أَبِی جَعْفَرٍ أَنَّہُ سَاوَمَ بِجَارِیَۃٍ فَوَضَعَ یَدَہُ عَلَی ثَدْیَیْہَا وَصَدْرِہَا۔","","Musannaf Ibn Abi Shaybah 20613","","","كتاب البيوع والأقضية"
"20614","(۲۰۶۱۴) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ الأَوْزَاعِی ، قَالَ : سَمِعْتُ عَطَائً وَسُئِلَ عَنِ الْجَوَارِی اللاَتِی تُبَعْنَ بِمَکَّۃَ ، فَکَرِہَ النَّظَرَ إلَیْہِنَّ إلاَّ لِمَنْ یُرِیدُ أَنْ یَشْتَرِیَ۔","","Musannaf Ibn Abi Shaybah 20614","","","كتاب البيوع والأقضية"
"20615","(۲۰۶۱۵) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : کَانَ مُحَمَّدٌ إذَا بُعِثَ إلَیْہِ بِالْجَارِیَۃِ یَنْظُرُ إلَیْہَا کَشَفَ بَیْنَ سَاقَیْہَا وَذِرَاعَیْہَا۔","","Musannaf Ibn Abi Shaybah 20615","","","كتاب البيوع والأقضية"
"20616","(۲۰۶۱۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، أَنَّ صَدِیقًا لَہُ أَسْوَدَ کَتَبَ إلَیْہِ أَنْ یَشْتَرِیَ لَہُ جَارِیَۃً ، فَفَعَلَ ، فَعَابَ شَیْئًا مِنْ سَاقِ الْجَارِیَۃِ ، قَالَ : فَبَلَغَ ذَلِکَ الأَسْوَدَ مِنْ قَوْلِہِ ، فَقَالَ : مَا أُحِبُّ أَنِّی نَظَرْت إلَی سَاقَیْہَا ، وَلاَ أَنِّی کَذَا وَکَذَا۔","","Musannaf Ibn Abi Shaybah 20616","","","كتاب البيوع والأقضية"
"20617","(۲۰۶۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حَکِیمٍ الأَثْرَمِ ، عَنْ أَبِی تَمِیمَۃَ ، عَنْ أَبِی مُوسَی أَنَّہُ خَطَبَہُمْ فَقَالَ : لاَ أَعْلَمُ رَجُلاً اشْتَرَی جَارِیَۃً فَنَظَرَ إلَی مَا دُونَ الْحَاوِیَۃ وَإِلَی مَا فَوْقَ الرُّکْبَۃِ إلاَّ عَاقَبْتہ۔","Hasan","Musannaf Ibn Abi Shaybah 20617","","","كتاب البيوع والأقضية"
"20618","(۲۰۶۱۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَشْتَرِیَ إلَی الْعَطَائِ وَالْحَصَادِ وَلَکِنْ یُسَمِّی شَہْرًا۔","","Musannaf Ibn Abi Shaybah 20618","","","كتاب البيوع والأقضية"
"20619","(۲۰۶۱۹) حَدَّثَنَا شَرِیکٌ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عَطَائٍ ، أو عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تُسْلِمْ إلَی عَصِیرٍ ، وَلاَ إلَی عَطَائٍ ، وَلاَ إلَی الأَنْدَرِ یَعْنِی الْبَیْدَرَ۔","Hasan","Musannaf Ibn Abi Shaybah 20619","","","كتاب البيوع والأقضية"
"20620","(۲۰۶۲۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ بِنَحْوٍ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20620","","","كتاب البيوع والأقضية"
"20621","(۲۰۶۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ بُکَیْر ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ تَبِعْ إلَی الْحَصَادِ ، ولاَ إلَی الْجِدَادِ ، وَلاَ إلَی الدِّرَاسِ ، وَلَکِنْ سَمِّ شَہْرًا۔","","Musannaf Ibn Abi Shaybah 20621","","","كتاب البيوع والأقضية"
"20622","(۲۰۶۲۲) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُئِلَ مُحَمَّدٌ ، عَنِ الْبَیْعِ إلَی الْعَطَائِ فَقَالَ : ما أَدْرِی مَا ہُوَ۔","","Musannaf Ibn Abi Shaybah 20622","","","كتاب البيوع والأقضية"
"20623","(۲۰۶۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَطَائٍ : کَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 20623","","","كتاب البيوع والأقضية"
"20624","(۲۰۶۲۴) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِالرَّحْمَنِ، عَنْ حَسَنِ بْنِ صَالِحٍ، عَنْ مُغِیرَۃَ، عَنِ الْحَکَمِ، أَنَّہُ کَرِہَ الْبَیْعَ إلَی الْعَطَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20624","","","كتاب البيوع والأقضية"
"20625","(۲۰۶۲۵) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا ضابیء بْنُ عَمْرٍو ، قَالَ : سَأَلْتُ سَالِمًا ، عَنِ السَّلَفِ إلَی إدْرَاکِ الثَّمَرَۃِ فَقَالَ: لاَ إلاَّ إلَی أَجَلٍ مَعْلُومٍ۔","","Musannaf Ibn Abi Shaybah 20625","","","كتاب البيوع والأقضية"
"20626","(۲۰۶۲۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ بُکَیْرِ بْنِ عَتِیقٍ ، قَالَ : قُلْتُ لِسَعِیدِ بْنِ جُبَیْرٍ أَشْتَرِی إلَی الْحَصَادِ وَإِلَی الدِّرَاسِ ؟ قَالَ : اشْتَرِ کَیْلاً مَعْلُومًا إلَی أَجَلٍ مَعْلُومٍ۔","","Musannaf Ibn Abi Shaybah 20626","","","كتاب البيوع والأقضية"
"20627","(۲۰۶۲۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ وَعَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ حَبِیبٍ ، أَنَّ أُمَّہَاتِ الْمُؤْمِنِینَ کُنَّ یَشْتَرِینَ إلَی الْعَطَائِ۔","","Musannaf Ibn Abi Shaybah 20627","","","كتاب البيوع والأقضية"
"20628","(۲۰۶۲۸) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، أَنَّ ابْنَ عُمَرَ کَانَ یَشْتَرِی إلَی الْعَطَائِ۔","","Musannaf Ibn Abi Shaybah 20628","","","كتاب البيوع والأقضية"
"20629","(۲۰۶۲۹) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ وَعَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنْ جَعْفَرِ بْنِ عَمْرِو بْنِ حُرَیْثٍ ، عَنْ أَبِیہِ أَنْ دِہْقَانًا بَعَثَ إلَی عَلِیٍّ بِثَوْبٍ دِیبَاجٍ مَنْسُوجٍ بِذَہَبٍ ، وَقَالَ حَفْصٌ : مَرْسُومٍ بِذَہَبٍ فَابْتَاعَہُ مِنْہُ عَمْرُو بْنُ حُرَیْثٍ بِأَرْبَعَۃِ آلاَفِ دِرْہَمٍ إلَی الْعَطَائِ۔","","Musannaf Ibn Abi Shaybah 20629","","","كتاب البيوع والأقضية"
"20630","(۲۰۶۳۰) حَدَّثَنَا أَبُو بَکْرٍ الْحَنَفِیُّ ، عَنْ نُوحِ بْنِ أَبِی بِلاَلٍ ، قَالَ : اشْتَرَی مِنِّی عَلِیُّ بْنُ حُسَیْن إلَی عَطَائِہِ طَعَامًا۔","","Musannaf Ibn Abi Shaybah 20630","","","كتاب البيوع والأقضية"
"20631","(۲۰۶۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ بِالْبَیْعِ إلَی الْعَطَائِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20631","","","كتاب البيوع والأقضية"
"20632","(۲۰۶۳۲) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ حُکَیمِ بْنِ رزیق ، عَنْ أَبِیہِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی الْبُرِّ بِالدَّقِیقِ ، قَالَ : ہُوَ رِبًا۔","","Musannaf Ibn Abi Shaybah 20632","","","كتاب البيوع والأقضية"
"20633","(۲۰۶۳۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یَکْرَہُ السَّوِیقَ بِالْحِنْطَۃِ وَأَشْبَاہِہَا۔","","Musannaf Ibn Abi Shaybah 20633","","","كتاب البيوع والأقضية"
"20634","(۲۰۶۳۴) حَدَّثَنَا جَرِیرٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِالْحِنْطَۃِ بِالدَّقِیقِ ، وَالْحِنْطَۃِ بِالسَّوِیقِ ، وَالدَّقِیقِ بِالْحِنْطَۃِ ، وَالْخُبْزِ بِالْحِنْطَۃِ ، وَالْفَلْسِ بِالْفَلْسَیْنِ یَدًا بِیَدٍ۔","","Musannaf Ibn Abi Shaybah 20634","","","كتاب البيوع والأقضية"
"20635","(۲۰۶۳۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : سُئِلَ مُحَمَّدٌ ، عَنِ الْخُبْزِ بِالْبُرِّ ، قَالَ : الْخُبْزُ مِنَ الْبُرِّ۔","","Musannaf Ibn Abi Shaybah 20635","","","كتاب البيوع والأقضية"
"20636","(۲۰۶۳۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا ، عَنْ حِنْطَۃٍ بِدَقِیقٍ فَکَرِہَاہُ۔","","Musannaf Ibn Abi Shaybah 20636","","","كتاب البيوع والأقضية"
"20637","(۲۰۶۳۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، قَالَ : کَانَ یَکْرَہُ الْحِنْطَۃَ بِالسَّوِیقِ۔","","Musannaf Ibn Abi Shaybah 20637","","","كتاب البيوع والأقضية"
"20638","(۲۰۶۳۸) حَدَّثَنَا عَبِیْدَۃُ بْنُ حُمَیْدٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ، قَالَ : سُئِلَ عَنِ السَّوِیقِ بِالْحِنْطَۃِ ، قَالَ : قَالَ : إِنْ لَمْ یَکُنْ رِبًا فَرِیبَۃٌ۔","","Musannaf Ibn Abi Shaybah 20638","","","كتاب البيوع والأقضية"
"20639","(۲۰۶۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا ، عَنْ قَفِیزِ حِنْطَۃٍ بِقَفِیزَیْ دَقِیقٍ فَکَرِہَاہُ۔","","Musannaf Ibn Abi Shaybah 20639","","","كتاب البيوع والأقضية"
"20640","(۲۰۶۴۰) حَدَّثَنَا سَہْلُ بْنُ یُوسُفَ ، عَنْ عَمْرٍو ، عَنِ الْحَسَنِ أَنَّہُ کَرِہَہُ إلاَّ وَزْنًا بِوَزْنٍ۔","","Musannaf Ibn Abi Shaybah 20640","","","كتاب البيوع والأقضية"
"20641","(۲۰۶۴۱) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَہُ إلاَّ وَزْنًا بِوَزْنٍ۔","","Musannaf Ibn Abi Shaybah 20641","","","كتاب البيوع والأقضية"
"20642","(۲۰۶۴۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّہُ کَرِہَہُ إلاَّ وَزْنًا بِوَزْنٍ۔","","Musannaf Ibn Abi Shaybah 20642","","","كتاب البيوع والأقضية"
"20643","(۲۰۶۴۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، قَالَ : سَمِعْتُ الشَّعْبِیَّ یَقُولُ : لَیْسَ الْخَلاَصُ بِشَیْئٍ ، مَنْ بَاعَ بَیْعًا فاسْتُحِقَّ فہو لِصَاحِبِہِ ، وَعَلَی الْبَائِعِ الثمنُ الَّذِی أَخَذَہُ بِہِ ، لَیْسَ عَلَیْہِ أَکْثَرُ مِنْ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 20643","","","كتاب البيوع والأقضية"
"20644","(۲۰۶۴۴) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ، عَنْ شُرَیْحٍ ، قَالَ : لاَ یَشْتَرِطُ الْخَلاَصَ إلاَّ أَحْمَقُ ، سَلِّمْ کَمَا بِعْتَ ، أَوِ أَرْدُدْہ کَمَا أَخَذْتَ۔","","Musannaf Ibn Abi Shaybah 20644","","","كتاب البيوع والأقضية"
"20645","(۲۰۶۴۵) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ لاَ یَرَی الْخَلاَصَ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20645","","","كتاب البيوع والأقضية"
"20646","(۲۰۶۴۶) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ ، عَن عُثْمَانَ الْبَتِّیِّ ، عَنِ الْحَسَنِ ، أَنَّ عَلِیًّا کَانَ یُحْسِنُ فِی الْخَلاَصِ۔","Hasan","Musannaf Ibn Abi Shaybah 20646","","","كتاب البيوع والأقضية"
"20647","(۲۰۶۴۷) حَدَّثَنَا یَحْیَی بْنُ یَعْلَی التَّیْمِیُّ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، أَنَّ رَجُلاً تَرَکَ امْرَأَتَہُ وَابْنًا لَہُ وَجَارِیَتَہُ ، فَبَاعَتِ امْرَأَتُہُ وَابْنُہُ الْجَارِیَۃَ ، فَوَطِئَہَا الَّذِی ابْتَاعَہَا فَوَلَدَتْ ، ثُمَّ جَائَ صَاحِبُ الْجَارِیَۃِ فَتَعَلَّقَ بِہَا، فَخَاصَمَہُ إلَی عَلِیٍّ فَقَالَ : عَلِیٌّ : بَاعَتِ امْرَأَتُک وَابْنُک وَقَدْ وَلَدَتْ مِنَ الرَّجُلِ ، سَلِّمَ الْبَیْعَ ، فَقَالَ الرَّجُلُ: أَنْشُدُک اللہ لَمَا قَضَیْتَ بِکِتَابِ اللہِ ، فَقَالَ : خُذْ جَارِیَتَکَ وَوَلَدَہَا ، وَقَالَ لِلآخَرِ : خُذِ الْمَرْأَۃَ وَالإِبْنَ بِالْخَلاَصِ ، فَلَمَّا أَخَذَ سَلَّمَ الآخَرُ الْبَیْعَ۔","","Musannaf Ibn Abi Shaybah 20647","","","كتاب البيوع والأقضية"
"20648","(۲۰۶۴۸) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ سَلَمَۃَ بْنِ عَلْقَمَۃَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کَانَتِ الْقُضَاۃُ تَقْضِی فِیمَنْ بَاعَ شَیْئًا لَیْسَ لَہُ ، فَہُوَ لِصَاحِبِہِ إذَا طَلَبَہُ ہُوَ ، وَیُؤْخَذُ ہَذَا بِالشَّرْوَی۔","","Musannaf Ibn Abi Shaybah 20648","","","كتاب البيوع والأقضية"
"20649","(۲۰۶۴۹) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، أَنَّ امْرَأَۃً بَاعَتْ دَارًا لِزَوْجِہَا وَہُوَ غَائِبٌ ، فَلَمَّا قَدِمَ أَبَی أَنْ یُجِیزَ الْبَیْعَ فَخَاصَمَہُ فِیہَا إلَی إیَاسِ بْنِ مُعَاوِیَۃَ ، فَجَعَلَ الْمُشْتَرِی یَقُولُ : أَصْلَحَکَ اللَّہُ ، أَنْفَقْت فِیہَا أَلْفَیْ دِرْہَمٍ ، فَقَالَ : الْفَاک عَلَیَّ الْفَاک عَلَیَّ ، قَالَ : فَقَضَی لِلرَّجُلِ بِدَارِہِ وَأَمَرَ امْرَأَتَہُ إلَی السِّجْنِ ، فَلَمَّا رَأَی ذَلِکَ جَوَّزَ الْبَیْعَ۔","","Musannaf Ibn Abi Shaybah 20649","","","كتاب البيوع والأقضية"
"20650","(۲۰۶۵۰) حَدَّثَنَا مُعَاذُ بْنُ مُعَاذٍ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ یَرَی الْخَلاَصَ شَرْطًا قَوِیًّا وَکَانَ یُشَدِّدُ فِیہِ۔","","Musannaf Ibn Abi Shaybah 20650","","","كتاب البيوع والأقضية"
"20651","(۲۰۶۵۱) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی الْخَلاَصَ شَیْئًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20651","","","كتاب البيوع والأقضية"
"20652","(۲۰۶۵۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْمُخْتَارِ بْنِ فُلْفُلٍ ، قَالَ : سَأَلْتُ أَنَسًا ، عَنْ شَہَادَۃِ الْعَبِیدِ فَقَالَ : جَائِزَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20652","","","كتاب البيوع والأقضية"
"20653","(۲۰۶۵۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ عَامِرٍ ، أَنَّ شُرَیْحًا أَجَازَ شَہَادَۃَ الْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 20653","","","كتاب البيوع والأقضية"
"20654","(۲۰۶۵۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ منصور ، عَنْ إبْرَاہِیمَ قَالَ : کانوا یجیزونہا فی الشیء الطفیف۔","","Musannaf Ibn Abi Shaybah 20654","","","كتاب البيوع والأقضية"
"20655","(۲۰۶۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَمَّارٍ الدُّہْنِیِّ ، قَالَ : شَہِدْتُ شُرَیْحًا شَہِدَ عِنْدَہُ عَبْدٌ عَلَی دَارٍ فَأَجَازَ شَہَادَتَہُ ، فَقِیلَ لہ : إِنَّہُ عَبْدٌ ، فَقَالَ : کُلُّنَا عَبِیدٌ وَأُمُّنَا حَوَّائُ۔","","Musannaf Ibn Abi Shaybah 20655","","","كتاب البيوع والأقضية"
"20656","(۲۰۶۵۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ شُرَیْحٌ : لاَ نُجِیزُ شَہَادَۃَ الْعَبِیدِ فَقَالَ عَلِیٌّ : لاَ ، کُنَّا نُجِیزُہَا ، قَالَ : فَکَانَ شُرَیْحٌ بَعْدُ یُجِیزُہَا إلاَّ لِسَیِّدِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 20656","","","كتاب البيوع والأقضية"
"20657","(۲۰۶۵۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 20657","","","كتاب البيوع والأقضية"
"20658","(۲۰۶۵۸) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 20658","","","كتاب البيوع والأقضية"
"20659","(۲۰۶۵۹) حَدَّثَنَا ابْنُ مُبَارَکٍ ، عَنْ مُحَمَّدِ بْنِ رَاشِدٍ ، عَنْ مَکْحُولٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 20659","","","كتاب البيوع والأقضية"
"20660","(۲۰۶۶۰) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الْعَبْدِ ، وَإِنْ کَانَ فِی شَیْئٍ طَفِیفٍ۔","","Musannaf Ibn Abi Shaybah 20660","","","كتاب البيوع والأقضية"
"20661","(۲۰۶۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ فِی قَوْلِہِ : {وَاسْتَشْہِدُوا شَہِیدَیْنِ مِنْ رِجَالِکُمْ } قَالَ : مَنِ الأَحْرَارِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20661","","","كتاب البيوع والأقضية"
"20662","(۲۰۶۶۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الْعَبْدِ۔","","Musannaf Ibn Abi Shaybah 20662","","","كتاب البيوع والأقضية"
"20663","(۲۰۶۶۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عِیسَی بْنِ أَبِی عَزَّۃَ ، عَنِ الشَّعْبِیِّ أَنَّہُ رَدَّ شَہَادَۃَ عَبْدٍ۔","","Musannaf Ibn Abi Shaybah 20663","","","كتاب البيوع والأقضية"
"20664","(۲۰۶۶۴) سَمِعْتُ وَکِیعًا یَقُولُ : قَالَ سُفْیَانُ : لاَ تَجُوزُ شَہَادَۃُ الْعَبْدِ ، قَالَ أَبُو بَکْرٍ : وَہُوَ قَوْلُ وَکِیعٍ۔","","Musannaf Ibn Abi Shaybah 20664","","","كتاب البيوع والأقضية"
"20665","(۲۰۶۶۵) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، قَالَ : أَہْلُ مَکَّۃَ لاَ یُجزونَہَا عَلَی دِرْہَمٍ۔","Hasan","Musannaf Ibn Abi Shaybah 20665","","","كتاب البيوع والأقضية"
"20666","(۲۰۶۶۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ، قَالَ : إذَا اخْتَلَفَ الرَّاہِنُ وَالْمُرْتَہِنُ فَقَالَ : ہَذَا: عَشْرَۃٌ ، وَقَالَ ہَذَا : عِشْرُونَ ، فَالْقَوْلُ قَوْلُ الرَّاہِنِ۔","","Musannaf Ibn Abi Shaybah 20666","","","كتاب البيوع والأقضية"
"20667","(۲۰۶۶۷) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ بَسَّامٍ ، عَنِ الْحَکَمِ ، قَالَ : الْقَوْلُ قَوْلُ الْمُرْتَہِنِ۔","","Musannaf Ibn Abi Shaybah 20667","","","كتاب البيوع والأقضية"
"20668","(۲۰۶۶۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، قَالَ : الْقَوْلُ قَوْلُ الَّذِی فِی یَدِہِ الرَّہْنُ۔","","Musannaf Ibn Abi Shaybah 20668","","","كتاب البيوع والأقضية"
"20669","(۲۰۶۶۹) حَدَّثَنَا زَیْدُ بْنُ الْحُبَابِ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ، عَنْ إیَاسِ بْنِ مُعَاوِیَۃَ، قَالَ: إذَا اخْتَلَفَ الرَّاہِنُ وَالْمُرْتَہِنُ فَالْقَوْلُ قَوْلُ الْمُرْتَہِنِ إلا أن تقوم علیہ البینۃ ، وکل مَنْ کَانَ فی یدہ شیء ؛ فالقول فیہ قولہ۔","","Musannaf Ibn Abi Shaybah 20669","","","كتاب البيوع والأقضية"
"20670","(۲۰۶۷۰) حَدَّثَنَا زَیْدُ بْنُ حُبَابِ ، عَنْ أبی عوانۃ ، عن قتادۃ ، قَالَ : إذَا اخْتَلَفَ الرَّاہِنُ وَالْمُرْتَہِنُ فَالْقَوْلُ قَوْلُ الْمُرْتَہِنِ مَا بَیْنَہُ وَبَیْنَ قِیمَتِہِ ، فَإِذَا زَادَتْ فَالْقَوْلُ قَوْلُ الرَّاہِنِ۔","","Musannaf Ibn Abi Shaybah 20670","","","كتاب البيوع والأقضية"
"20671","(۲۰۶۷۱) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ أَبِی ہَاشِمٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا اخْتَلَفَ الرَّاہِنُ وَالْمُرْتَہِنُ فَالْقَوْلُ قَوْلُ الرَّاہِنِ إلاَّ أَنْ یُقِیمَ الْمُرْتَہِنُ الْبَیِّنَۃَ۔","","Musannaf Ibn Abi Shaybah 20671","","","كتاب البيوع والأقضية"
"20672","(۲۰۶۷۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ ہِشَامٍ ، عَنْ عَامِرٍ ، قَالَ : إذَا اخْتَلَفَ الرَّاہِنُ وَالْمُرْتَہِنُ فِی قِیمَۃِ الرَّہْنِ فَالْبَیِّنَۃُ عَلَی الَّذِی یَدَّعِی الرَّہْنَ۔","","Musannaf Ibn Abi Shaybah 20672","","","كتاب البيوع والأقضية"
"20673","(۲۰۶۷۳) حَدَّثَنَا عَرْعَرَۃُ بْنُ الْبِرِنْدِ ، عَنْ عَبْدِ الْمَلِکِ الأَزْرَقِ ، عَنْ عَبْدِ الْکَرِیمِ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : الْقَوْلُ قَوْلُ الْمُرْتَہِنِ۔","","Musannaf Ibn Abi Shaybah 20673","","","كتاب البيوع والأقضية"
"20674","(۲۰۶۷۴) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، قَالَ : سُئِلَ حَمَّادٌ ، عَنْ رَجُلٍ فِی یَدِہِ رَہْنٌ فَقَالَ : ہُوَ بِعَشْرَۃٍ ، وَقَالَ صَاحِبُہُ : ہُوَ بِدِرْہَمٍ ، فَقَالَ : الْبَیِّنَۃُ عَلَی مَنِ ادَّعَی الْفَضْلَ کَمَا أَنَّہُ لَوْ قَالَ : ہُوَ رَہْنٌ ، وَقَالَ صَاحِبُہُ : ہُوَ وَدِیعَۃٌ ، کَانَ الْقَوْلُ قَوْلَ صَاحِبِ الْمَتَاعِ۔","","Musannaf Ibn Abi Shaybah 20674","","","كتاب البيوع والأقضية"
"20675","(۲۰۶۷۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : الْقَوْلُ قَوْلُ الْمُرْتَہِنِ۔","","Musannaf Ibn Abi Shaybah 20675","","","كتاب البيوع والأقضية"
"20676","(۲۰۶۷۶) حَدَّثَنَا شریک ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ کَانَ إذَا خَرَجَ أَمَرَ عَلِیًّا أَنْ یَثْلِم الْحِیطَانَ۔","Da'if","Musannaf Ibn Abi Shaybah 20676","","","كتاب البيوع والأقضية"
"20677","(۲۰۶۷۷) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، قَالَ : سَمِعْتُ ابْنَ أَبِی حَکَم الْغِفَارِیِّ یَقُولُ : حَدَّثَتْنِی جَدَّتِی ، عَنْ عَمِّ أَبِی رَافِعِ بْنِ عَمْرٍو الْغِفَارِیِّ ، قَالَ : کُنْتُ وَأَنَا غُلاَمٌ أَرْمِی نَخْلَ الأَنْصَارِ ، فَقِیلَ لِلنَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إنَّ ہَاہُنَا غُلاَمًا یَرْمِی نَخْلَنَا ، فَأُتِیَ بِی النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : یَا غُلاَمُ ، لِمَ تَرْمِی النَّخْلَ ؟ : قُلْتُ: آکُلُ ، قَالَ : فَلاَ تَرْمِ النَّخْلَ وَکُلْ مِمَّا سَقَطَ فِی أَسْفَلِہَا ، ثُمَّ مَسَحَ رَأْسِی ، وَقَالَ : اللَّہُمَّ أَشْبِعْ بَطْنَہُ۔n(ترمذی ۱۲۸۸۔ ابوداؤد ۲۶۱۵)","Da'if","Musannaf Ibn Abi Shaybah 20677","","","كتاب البيوع والأقضية"
"20678","(۲۰۶۷۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : سَمِعْتُ رَجُلاً مِنْ مُزَیْنَۃَ یَسْأَلُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الثِّمَارِ مَا کَانَتْ فِی أَکْمَامِہَا فَقَالَ : مَنْ أَکَلَ بِفِیہِ وَلَمْ یَتَّخِذْ خُبْنۃ فَلَیْسَ عَلَیْہِ شَیْئٌ۔ (ترمذی ۱۲۸۹۔ احمد ۲۰۷)","","Musannaf Ibn Abi Shaybah 20678","","","كتاب البيوع والأقضية"
"20679","(۲۰۶۷۹) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ قُرَّۃَ ، عَنْ ہَارُونَ بْنِ رِئَابٍ ، عَنْ سِنَانِ بْنِ سَلَمَۃَ ، قَالَ : حدَّثَنَا وَہُوَ بِالْبَحْرَیْنِ ، قَالَ : کُنْتُ فِی أُغَیْلِمَۃٍ نَلْقُطُ الْبَلَحَ ، فَفَجِئَنَا عُمَرُ ، فسعی الْغِلْمَانُ ، فَقُمْتُ فَقُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ إِنَّہُ مِمَّا أَلْقَتِ الرِّیحُ ، فَقَالَ : أَرِنِیہِ ، فَلَمَّا أَرَیْتُہُ ، قَالَ : انْطَلِقْ ، قُلْتُ : یَا أَمِیرَ الْمُؤْمِنِینَ تری ہَؤُلاَئِ الْغِلْمَانَ السَّاعَۃَ ، فَإِنَّک إذَا انْصَرَفْتَ عَنِّی انْتَزَعُوا مَا مَعِی ، قَالَ : فَمَشَی مَعِی حَتَّی بَلَغْتُ مَأْمَنِی۔","Sahih","Musannaf Ibn Abi Shaybah 20679","","","كتاب البيوع والأقضية"
"20680","(۲۰۶۸۰) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، قَالَ : سَأَلْتُ حَمَّادًا ، عَنِ الَّذِی یَسْقُطُ مِنَ النَّخْلِ لَیْسَ لَکَ ؟ قَالَ : فقَالَ إبْرَاہِیمُ : إنَّ الْمُہَاجِرِینَ الأَوَّلِینَ کَانُوا لاَ یَرَوْنَ بِأَکْلِہِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20680","","","كتاب البيوع والأقضية"
"20681","(۲۰۶۸۱) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاہِدٍ ، عَنْ أَبِی عِیَاضٍ ، قَالَ : قَالَ عُمَرُ : إذَا مَرَرْتَ بِبُسْتَانٍ فَکُلْ ، وَلاَ تَتَّخِذْ خُبْنَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 20681","","","كتاب البيوع والأقضية"
"20682","(۲۰۶۸۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِی وَائِلٍ ، قَالَ : کُنَّا نَغْزُو فَنُصِیبُ مِنَ الثِّمَارِ ، وَلاَ نَرَی بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20682","","","كتاب البيوع والأقضية"
"20683","(۲۰۶۸۳) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ، قَالَ: سَأَلْتُ الْحَسَنَ، وَابْنَ سِیرِینَ، قُلْتُ: إنِّی ربما خَرَجْتُ إلَی الأُبُلَّۃِ ، فَنَمُرُّ بِالنَّخْلِ فَنَأْکُلُ مِنْہُ وبالشجر ، فکِلاَہُمَا رَخَّصَ لِی فِیہِ وَقَالاَ : مَا لَمْ تَحْمِلْ ، أَوْ تُفْسِدْ۔","","Musannaf Ibn Abi Shaybah 20683","","","كتاب البيوع والأقضية"
"20684","(۲۰۶۸۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنِ الْجُرَیرِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : إذَا مَرَرْتَ بِبُسْتَانٍ فَنَادِ صَاحِبَہُ ، فَإِنْ أَجَابَک فَاسْتَطْعِمْہُ ، وَإِنْ لَمْ یُجِبْک فَکُلْ ، وَلاَ تُفْسِدْ۔","Sahih","Musannaf Ibn Abi Shaybah 20684","","","كتاب البيوع والأقضية"
"20685","(۲۰۶۸۵) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی زَیْنَبَ ، قَالَ : سَافَرْتُ فِی جَیْشٍ مَعَ أَبِی بَکْرَۃَ ، وَأَبِی برزۃ ، وَعَبْدِ الرَّحْمَنِ بْنِ سَمُرَۃَ فَکُنَّا نَأْکُلُ مِنَ الثِّمَارِ۔","Da'if","Musannaf Ibn Abi Shaybah 20685","","","كتاب البيوع والأقضية"
"20686","(۲۰۶۸۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ حُصَیْنٍ ، عَنْ ذَرٍّ ، عَنْ إبْرَاہِیمَ ، قَالَ : کُنْتُ أُسَافِرُ مَعَہُ ، فَکَانَ یَأْکُلُ مِنَ الثِّمَارِ۔","","Musannaf Ibn Abi Shaybah 20686","","","كتاب البيوع والأقضية"
"20687","(۲۰۶۸۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامِ بْنِ سَعْدٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ مَرَّ بِحَائِطٍ فَلْیَأْکُلْ ، وَلاَ یَحْمِلْ۔ (احمد ۲۲۴)","","Musannaf Ibn Abi Shaybah 20687","","","كتاب البيوع والأقضية"
"20688","(۲۰۶۸۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ بَأْسَ بِثِمَارِ أَہْلِ الذِّمَّۃِ۔","","Musannaf Ibn Abi Shaybah 20688","","","كتاب البيوع والأقضية"
"20689","(۲۰۶۸۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ إبراہیم ، عَنِ ابْنِ سِیرِینَ ، قَالَ : سَأَلْتُ عَبِیْدَۃَ ، عَنِ ابْنِ السَّبِیلِ یَمُرُّ بِالثَّمَرَۃِ فَقَالَ : یَأْکُلُ ، وَلاَ یُفْسِدْ۔","","Musannaf Ibn Abi Shaybah 20689","","","كتاب البيوع والأقضية"
"20690","(۲۰۶۹۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، قَالَ : سَأَلْتُ عَبِیْدَۃَ فَذَکَرَ ، مِثْلَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20690","","","كتاب البيوع والأقضية"
"20691","(۲۰۶۹۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی عِمْرَانَ الْجَوْنِیِّ ، قَالَ : سَمِعْتُ جُنْدُبَ الْبَجَلِیَّ یَقُولُ : کُنَّا نَغْزُو مَعَ أَصْحَابِ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ وَنَحْنُ نَفْعَلُ کَمَا یَفْعَلُونَ ، فَنَأْخُذُ مِنَ الثَّمَرَۃِ وَنَأْخُذُ الْعِلْج فیدلنا مِنَ الْقَرْیَۃِ إلَی الْقَرْیَۃِ مِنْ غَیْرِ أَنْ نُشَارِکَہُمْ فِی بُیُوتِہِمْ۔","Sahih","Musannaf Ibn Abi Shaybah 20691","","","كتاب البيوع والأقضية"
"20692","(۲۰۶۹۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ حَمَّادًا ، عَنِ الْمُسَافِرِ یَأْکُلُ مِنَ الثَّمَرَۃِ ، فَقَالَ : إذَا ظَلَمُوہُمَ الأُمَرَائُ فَأَحَبُّ إلَیَّ أن لاَ یَأْکُلَ ، وَسَأَلْتُ الْحَکَمَ فَقَالَ : کُلْ۔","","Musannaf Ibn Abi Shaybah 20692","","","كتاب البيوع والأقضية"
"20693","(۲۰۶۹۳) حَدَّثَنَا شَبَابَۃُ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ أَبِی بِشْرٍ ، عَنْ عَبَّادِ بْنِ شُرَحْبِیلَ ، رَجُلٍ مِنْ بَنِی غُبَرَ ، قَالَ : أَصَابَتْنَا سَنَۃٌ فَدَخَلْتُ حَائِطًا فَأَخَذْت سُنْبُلاً فَفَرَکْتُہُ ، فَجَائَ صَاحِبُ الْحَائِطِ فَضَرَبَنِی وَأَخَذَ کِسَائِی ، فَأَتَیْنَا النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقَالَ : مَا أَطْعَمْتَہُ إذْ کَانَ جَائِعًا ، أَوْ سَاغِبًا ، وَلاَ عَلَّمْتَہُ إذْ کَانَ جَاہِلاً ، وَأَخَذَ ثَوْبَہُ فَرَدَّہُ عَلَی صَاحِبِہِ۔ (ابوداؤد ۲۶۱۳۔ ابن ماجہ ۲۲۹۸)","Sahih","Musannaf Ibn Abi Shaybah 20693","","","كتاب البيوع والأقضية"
"20694","(۲۰۶۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ مَوْلَی سَعْدٍ ، قَالَ : نَزَلْنَا إلَی جَانِبِ حَائِطِ دِہْقَانٍ فَقَالَ : لِی سَعْدٌ : إِنْ سَرَّک أَنْ تَکُونَ مُسْلِمًا حَقًّا فَلاَ تُصِیبَنَّ مِنْہُ شَیْئًا ، وَأَعْطَانِی دِرْہَمًا ، وَقَالَ : اشْتَرِ بِبَعْضِہِ ثَمْرًا ، أَوْ غذائً وَبِبَعْضِہِ عَلَفًا۔","Da'if","Musannaf Ibn Abi Shaybah 20694","","","كتاب البيوع والأقضية"
"20695","(۲۰۶۹۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : إذَا مَرَرْت بِنَخْلٍ ، أَوْ نَحْوِہِ وَقَدْ أُحِیطَ عَلَیْہِ حَائِطٌ فَلاَ تَدْخُلْہُ إلاَّ بِإِذْنِ صَاحِبِہِ ، وَإِذَا مَرَرْتَ بِہِ فِی فَضَائِ الأَرْضِ فَکُلْ ، وَلاَ تَحْمِلْ۔","Sahih","Musannaf Ibn Abi Shaybah 20695","","","كتاب البيوع والأقضية"
"20696","(۲۰۶۹۶) حَدَّثَنَا کَثِیرُ بْنُ ہِشَامٍ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، قَالَ : حدَّثَنَا یَزِیدُ بْنُ الأَصَمُّ ، قَالَ : تلقیت عَائِشَۃَ وہی مقبلۃ من مکۃ أَنَا وَابْنٌ لِطَلْحَۃَ بْنِ عُبَیْدِ اللہِ، وَہُوَ ابْنُ أُخْتِہَا، وَقَدْ کُنَّا وقعنا فِی حَائِطٍ مِنْ حِیطَانِ الْمَدِینَۃِ، فَأَکَلْنَا مِنْہُ ، فَبَلَغَہَا ذَلِکَ فَأَقْبَلَتْ عَلَی ابْنِ أُخْتِہَا تَلُومُہُ وَتْعذلہ ، ثُمَّ أَقْبَلَتْ عَلَیَّ فَوَعَظَتْنِی مَوْعِظَۃً بَلِیغَۃً۔","Hasan","Musannaf Ibn Abi Shaybah 20696","","","كتاب البيوع والأقضية"
"20697","(۲۰۶۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ تَأْکُلْ مِنَ الثَّمَرَۃِ إلاَّ بِالثَّمَنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20697","","","كتاب البيوع والأقضية"
"20698","(۲۰۶۹۸) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی الْجُعْفِیِّ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : لاَ تَأْکُلْ مِنَ الثَّمَرَۃِ إلاَّ بِإِذْنِ أَہْلِہَا۔","","Musannaf Ibn Abi Shaybah 20698","","","كتاب البيوع والأقضية"
"20699","(۲۰۶۹۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سَعِیدٌ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : کَانَ لاَ یَحْتَمِی الثَّمَرَۃَ إذَا لَمْ یَکُنْ لَہَا حَائِطٌ وَلاَ یَأْکُلُ مِنَ الْحَائِطِ إلاَّ بِإِذْنِ أَہْلِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 20699","","","كتاب البيوع والأقضية"
"20700","(۲۰۷۰۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا فُضَیْلُ بْنُ غَزْوَانَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ حَازِمٍ ، قَالَ : سَأَلْتُ مُجَاہِدًا عَمَّا یَسْقُطُ مِنَ الشَّجَرِ فَقَالَ : دَعْہُ لِلسِّبَاعِ وَلِلطَّیْرِ۔","","Musannaf Ibn Abi Shaybah 20700","","","كتاب البيوع والأقضية"
"20701","(۲۰۷۰۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ جَابِرٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، أَنَّہُ کَرِہَ اللُّقَاطَ۔","Da'if","Musannaf Ibn Abi Shaybah 20701","","","كتاب البيوع والأقضية"
"20702","(۲۰۷۰۲) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرِ بْنِ یَحْیَی ، عَنْ أَبِیہِ ، أَنَّ الْحَسَنَ وَالْحُسَیْنَ کَانَا یَقْبَلاَنِ جَوَائِزَ مُعَاوِیَۃَ۔","Sahih","Musannaf Ibn Abi Shaybah 20702","","","كتاب البيوع والأقضية"
"20703","(۲۰۷۰۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَش ، عَنْ حَبِیبٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ ، وَابْنَ عَبَّاسٍ تَأْتِیہِمَا ہَدَایَا الْمُخْتَارِ فَیَقْبَلاَنِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 20703","","","كتاب البيوع والأقضية"
"20704","(۲۰۷۰۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ سِمَاکِ بْنِ سَلَمَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عِصْمَۃَ ، قَالَ : کُنْتُ عِنْدَ عَائِشَۃَ فَأَتَاہَا رَسُولٌ مِنْ عِنْدَ مُعَاوِیَۃَ بِہَدِیَّۃٍ فَقَبِلَتْہَا۔","Da'if","Musannaf Ibn Abi Shaybah 20704","","","كتاب البيوع والأقضية"
"20705","(۲۰۷۰۵) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، أَنَّ عَائِشَۃَ بَعَثَ إلَیْہَا مُعَاوِیَۃُ قِلاَدَۃً قُوِّمَتْ بِمِئَۃِ أَلْفٍ فَقَبِلَتْہَا ، وَقَسَّمَتْہَا بَیْنَ أُمَّہَاتِ الْمُؤْمِنِینَ۔","","Musannaf Ibn Abi Shaybah 20705","","","كتاب البيوع والأقضية"
"20706","(۲۰۷۰۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ عُمَیْرٍ ، قَالَ : أَرْسَلَ مَعِی بِشْرُ بْنُ مَرْوَانَ بِخَمْسِمِئَۃٍ إلَی خَمْسَۃِ أُنَاسٍ : إلَی أَبِی جُحَیْفَۃَ وَإِلَی أَبِی رَزِینٍ وَعَمْرِو بْنِ مَیْمُونٍ وَمُرَّۃَ ، وَأَبِی عَبْدِ الرَّحْمَنِ ، فَرَدَّہَا أَبُو رَزِینٍ، وَأَبُو جُحَیْفَۃَ وَعَمْرُو بْنُ مَیْمُونٍ وَقَبِلَہَا الآخَرَانِ۔","Sahih","Musannaf Ibn Abi Shaybah 20706","","","كتاب البيوع والأقضية"
"20707","(۲۰۷۰۷) حَدَّثَنَا عَبْدُالرَّحْمَنِ بْنُ مَہْدِیٍّ، عَنْ سُفْیَانَ، عَنْ عَبْدِالْمَلِکِ بْنِ عُمَیْرٍ ذَکَرَ نَحْوَ حَدِیثِ یَحْیَی بْنِ سَعِیدٍ۔","Sahih","Musannaf Ibn Abi Shaybah 20707","","","كتاب البيوع والأقضية"
"20708","(۲۰۷۰۸) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، قَالَ : سَمِعْتُ الْحَسَنَ وَسَأَلَہُ رَجُلٌ ، قَالَ : آتی الْعَامِل فَیُعْطِینِی وَیُجِیزنِی ؟ فَقَالَ : خُذْہَا لاَ أَبًا لَکَ وَانْطَلِقْ۔","","Musannaf Ibn Abi Shaybah 20708","","","كتاب البيوع والأقضية"
"20709","(۲۰۷۰۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ ، عَنْ قَیْسٍ ، قَالَ : دَخَلْتُ مَعَ أَبِی عَلَی أَبِی بَکْرٍ ، نَعُودُہُ وَہُوَ مَرِیضٌ ، فَحَمَلَنَا عَلَی فَرَسَیْنِ ، وَرَأَیْتُ أَسْمَائَ مَوْشُومَۃَ الْیَدَیْنِ ، تَذُبُّ عَنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20709","","","كتاب البيوع والأقضية"
"20710","(۲۰۷۱۰) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ وَإِبْرَاہِیمَ بْنِ مُہَاجِرٍ ، أَنَّ إبْرَاہِیمَ وَتَمِیمَ بْنَ سَلَمَۃَ خَرَجَا إلَی عَامِلٍ فَفَضَّلَ تَمِیمًا عَلَی إبْرَاہِیمَ فِی الْجَائِزَۃِ ، فَغَضِبَ إبْرَاہِیمُ۔","","Musannaf Ibn Abi Shaybah 20710","","","كتاب البيوع والأقضية"
"20711","(۲۰۷۱۱) حَدَّثَنَا یَزِیدُ ، عَنْ شُعْبَۃَ ، عَنْ إبْرَاہِیمَ بْنِ مُحَمَّدِ بْنِ الْمُنْتَشِرِ ، عَنْ أَبِیہِ ، أَنَّ خَالِدَ بْنَ أَسِیدٍ بَعَثَ إلَی مَسْرُوقٍ بِثَلاَثِینَ أَلْفًا ، فَرَدَّہَا فَقَالَ لَہُ : لَوْ أَخَذْتَہَا فَتَصَدَّقْتَ بِہَا وَوَصَلْتَ بِہَا ، فَأَبَی أَنْ یَأْخُذَہَا۔","","Musannaf Ibn Abi Shaybah 20711","","","كتاب البيوع والأقضية"
"20712","(۲۰۷۱۲) حَدَّثَنَا عَبْدَۃُ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ ، أَنَّہُ کَانَ لاَ یَرَی بِجَوَائِزِ الْعُمَّالِ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20712","","","كتاب البيوع والأقضية"
"20713","(۲۰۷۱۳) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ أَنَّہُ رَکِبَ إلَی عَامِلٍ فَأَجَازَہُ وَحَمَلَہُ عَلَی دَابَّۃٍ فَقَبِلَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20713","","","كتاب البيوع والأقضية"
"20714","(۲۰۷۱۴) حَدَّثَنَا وَکِیعٌ ، عَنْ یُونُسَ ، عَنْ مِخْوَلٍ ، عَنْ أَبِی جَعْفَرٍ ، قَالَ : لاَ بَأْسَ بِجَوَائِزِ الْعُمَّالِ۔","","Musannaf Ibn Abi Shaybah 20714","","","كتاب البيوع والأقضية"
"20715","(۲۰۷۱۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : لاَ بَأْسَ بِجَوَائِزِ الْعُمَّالِ۔","","Musannaf Ibn Abi Shaybah 20715","","","كتاب البيوع والأقضية"
"20716","(۲۰۷۱۶) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ حُمَیْدٍ ، أَنَّ ابْنَ ہُبَیْرَۃَ أَجَازَ الْحَسَنَ وَبَکْرًا فَقَبِلاَ ، وَأَجَازَ مُحَمَّدًا فَلَمْ یَقْبَلْ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 20716","","","كتاب البيوع والأقضية"
"20717","(۲۰۷۱۷) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَش ، عَنْ حَبِیبٍ ، أَنَّ رَجُلاً بَعَثَ إلَی ذَرٍّ بِجَائِزَۃٍ فَقَالَ لِلرَّسُولِ : أَکُلُّ مُسْلِمٍ بُعِثَ بِہَذَا ؟ فَقَالَ : لاَ ، قَالَ : رُدَّہُ ، وَقَالَ : {کَلاَّ إِنَّہَا لَظَی نَزَّاعَۃً لِلشَّوَی}۔","","Musannaf Ibn Abi Shaybah 20717","","","كتاب البيوع والأقضية"
"20718","(۲۰۷۱۸) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ ابْنِ مِینَائَ ، أَنَّ عَبْدَالْعَزِیزِ بْنَ مَرْوَانَ بَعَثَ إلَی ابْنِ عُمَرَ فَقَبِلَ مِنْہُ وَبَعَثَ إلَی عَبْدِاللہِ بْنِ عَیَّاش ابْنِ أَبِی رَبِیعَۃَ فَلَمْ یَقْبَلْ مِنْہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20718","","","كتاب البيوع والأقضية"
"20719","(۲۰۷۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَاصِمٍ ، عَنْ أَبِی مِجْلَزٍ ، قَالَ : قَالَ عَلِیٌّ : لاَ بَأْسَ بِجَائِزَۃِ الْعُمَّالِ ، إنَّ لَہُ مَعُونَۃً وَرِزْقًا ، وَإِنَّمَا أَعْطَاک مِنْ طَیِّبِ مَالِہِ۔","","Musannaf Ibn Abi Shaybah 20719","","","كتاب البيوع والأقضية"
"20720","(۲۰۷۲۰) حَدَّثَنَا جَرِیرٌ ، عَنِ الْعَلاَئِ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَوْ أَتَیْتُ عَامِلاً فَأَجَازَنِی لَقَبِلْتُ مِنْہُ ، إنَّمَا ہُوَ بِمَنْزِلَۃِ بَیْتِ الْمَالِ یَدْخُلُہُ الْخَبِیثُ وَالطَّیِّبُ ، وَقَالَ : إذَا أَتَاک الْبَرِیدُ فِی أَمْرِ مَعْصِیَۃٍ فَلاَ خَیْرَ فِی جَائِزَتِہِ وَإِذَا أَتَاک بِأَمْرٍ لَیْسَ بِہِ بَأْسٌ فَلاَ بَأْسَ بِجَائِزَتِہِ۔","","Musannaf Ibn Abi Shaybah 20720","","","كتاب البيوع والأقضية"
"20721","(۲۰۷۲۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ رَجُلٍ لَمْ یُسَمِّہِ ، عَنْ سَعِیدٍ ، عَنْ عَامِرِ بْنِ حِذْیم ، أَنَّ عُمَرَ أَجَازَہُ بِأَلْفِ دِینَارٍ۔","Da'if","Musannaf Ibn Abi Shaybah 20721","","","كتاب البيوع والأقضية"
"20722","(۲۰۷۲۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ زُہَیْرٍ ، قَالَ : حدَّثَنِی أَشْعَثُ بْنُ أَبِی الشَّعْثَائِ ، قَالَ : خَرَجْنَا ثَلاَثِینَ رَاکِبًا عَلَیْنَا الأَسْوَدُ ، أَمَّرَہُ بِشْرُ بْنُ مَرْوَانَ ، وَأَجَازَہُ بِخَمْسِینَ دِینَارًا فَقَبِلَہَا۔","","Musannaf Ibn Abi Shaybah 20722","","","كتاب البيوع والأقضية"
"20723","(۲۰۷۲۳) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ أَنَّہُ لَمْ یَرَ بَأْسًا أَنْ یَبِیعَ الرَّجُلُ أَخَاہُ مِنَ الرَّضَاعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20723","","","كتاب البيوع والأقضية"
"20724","(۲۰۷۲۴) حَدَّثَنَا مُعْتَمِرُ ، عَنْ مَعْمَرٌ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدِ بْنِ سِیرِینَ وَقَتَادَۃَ ، قَالاَ : لاَ بَأْسَ أَنْ یَبِیعَ الرَّجُلُ أَخَاہُ مِنَ الرَّضَاعَۃِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20724","","","كتاب البيوع والأقضية"
"20725","(۲۰۷۲۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 20725","","","كتاب البيوع والأقضية"
"20726","(۲۰۷۲۶) حَدَّثَنَا غُنْدَرٌ، عَنْ شُعْبَۃَ، عَنْ مَنْصُورٍ، أَنَّہُ کَانَ یَقُولُ: یَبِیعُ الرَّجُلُ أَخَاہُ مِنَ الرَّضَاعَۃِ وَأُمَّہُ، لاَ بَأْسَ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 20726","","","كتاب البيوع والأقضية"
"20727","(۲۰۷۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ عَوْنٍ، قَالَ: کَتَبْتُ إلَی نَافِعٍ أَسْأَلُہُ عَنْ بَیْعِ الأَخِ مِنَ الرَّضَاعَۃِ فَقَالَ: لاَ بَأْسَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20727","","","كتاب البيوع والأقضية"
"20728","(۲۰۷۲۸) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، وَأَبُو دَاوُد الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ قَتَادَۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَبِیعَ الرَّجُلُ أَخَاہُ مِنَ الرَّضَاعَۃِ۔","","Musannaf Ibn Abi Shaybah 20728","","","كتاب البيوع والأقضية"
"20729","(۲۰۷۲۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ فِی أختہ وَجَدَّتِہِ مِنَ الرَّضَاعَۃِ فَکَرِہَ بَیْعَہُمَا۔","","Musannaf Ibn Abi Shaybah 20729","","","كتاب البيوع والأقضية"
"20730","(۲۰۷۳۰) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عِمْرَانَ الْقَطَّانِ ، قَالَ : سَمِعْتُ الْحَسَنَ وَسُئِلَ عَنْہُ فَکَرِہَہُ ، فَذَکَرْتہ لِقَتَادَۃَ فَقَالَ : کَانَ جَابِرُ بْنُ زَیْدٍ یَقُولُہُ ، وَکَانَ إبْرَاہِیمُ النَّخَعِیُّ یَقُولُ : یَبِیعُہُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 20730","","","كتاب البيوع والأقضية"
"20731","(۲۰۷۳۱) حَدَّثَنَا مُعْتَمِرٌ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ أَنْ یَبِیعَ أَخَاہُ مِنَ الرَّضَاعَۃِ۔","","Musannaf Ibn Abi Shaybah 20731","","","كتاب البيوع والأقضية"
"20732","(۲۰۷۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَلْقَمَۃَ ، قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ فَقَالَ: إنَّ جَارِیَتِی أَرْضَعَتِ ابْنِی أَمَا أَبِیعُہَا ؟ قَالَ : فَقَالَ عَبْدُ اللہِ : لَوَدِدْتُ أَنَّہُ أَخْرَجَہَا إلَی السُّوقِ فَقَالَ : مَنْ یَشْتَرِی مِنِّی أُمَّ وَلَدِی کَأَنَّہُ کَرِہَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20732","","","كتاب البيوع والأقضية"
"20733","(۲۰۷۳۳) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ سُلَیْمَانَ التَّیْمِیِّ ، قَالَ : سَأَلْتُ الْحَسَنَ ، عَنْ قولہ تعالی : {وَأَشْہِدُوا إذَا تَبَایَعْتُمْ} فَقَالَ : أَلاَ تَرَی إلَی قَوْلِہِ : {فَإِنْ أَمِنَ بَعْضُکُمْ بَعْضًا} أَنَّہُ کَانَ یَرَی أَنَّہُ قَدْ نَسَخَ مَا کَانَ قَبْلَہُ۔","","Musannaf Ibn Abi Shaybah 20733","","","كتاب البيوع والأقضية"
"20734","(۲۰۷۳۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ ، قَالَ : قُلْتُ لِلشَّعْبِیِّ : أَرَأَیْتَ الرَّجُلَ یَشْتَرِی مِنَ الرَّجُلِ الشَّیْئَ حَتْمٌ عَلَیْہِ أَنْ یُشْہِدَ ، لاَ بُدَّ مِنْہُ ؟ قَالَ : لاَ ، أَلاَ تَرَی إلَی قَوْلِہِ : {فَإِنْ أَمِنَ بَعْضُکُمْ بَعْضًا}۔","","Musannaf Ibn Abi Shaybah 20734","","","كتاب البيوع والأقضية"
"20735","(۲۰۷۳۵) حَدَّثَنَا مُحَمَّدُ بْنُ مَرْوَانَ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی نَضْرَۃَ ، عَنْ أَبِیہِ ، عَنْ أَبِی سَعِیدِ الْخُدْرِیِّ فِی قَوْلِہِ : {وَأَشْہِدُوا إذَا تَبَایَعْتُمْ} قَالَ : نَسَخَتْہَا {فَإِنْ أَمِنَ بَعْضُکُمْ بَعْضًا}۔","Hasan","Musannaf Ibn Abi Shaybah 20735","","","كتاب البيوع والأقضية"
"20736","(۲۰۷۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی جَعْفَرٍ الرَّازِیّ ، عَنِ الرَّبِیعِ بْنِ أَنَسٍ ، قَالَ : رَأَیْتُ صَفْوَانَ بْنَ مُحْرِزٍ وَأَتَی السُّوقَ وَمَعَہُ دِرْہَمٌ زَیْفٌ فَقَالَ : مَنْ یَبِیعُنِی عِنَبًا طَیِّبًا بِدِرْہَمٍ خَبِیثٍ ، فَاشْتَرَی وَلَمْ یُشْہِدْ","","Musannaf Ibn Abi Shaybah 20736","","","كتاب البيوع والأقضية"
"20737","(۲۰۷۳۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ الْعَلاَئِ بْنِ الْمُسَیَّبِ ، قَالَ : سَمِعْتُ الْحَکَمَ قَرَأَ : (فَإِنْ أَمِنَ بَعْضُکُمْ بَعْضًا) قَالَ : نَسَخَتْ ہَذِہِ الشُّہُودَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20737","","","كتاب البيوع والأقضية"
"20738","(۲۰۷۳۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : الْبُیُوعُ ثَلاَثَۃٌ : بَیْعُ شُہُودٍ وَکِتَابٍ وَبَیْعٌ بِرِہَانٍ مَقْبُوضَۃٍ ، وَبَیْعٌ بِالأَمَانَۃِ ، ثم قَرَأَ آیَۃَ الدَّیْنِ۔","","Musannaf Ibn Abi Shaybah 20738","","","كتاب البيوع والأقضية"
"20739","(۲۰۷۳۹) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ شُعْبَۃ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ ، عَنْ أَبِی بُرْدَۃَ ، عنْ أَبِی مُوسَی ، قَالَ : ثَلاَثَۃٌ لاَ تُسْتَجَابُ لَہُمْ دَعْوَۃٌ : رَجُلٌ آتَی سَفِیہًا مَالَہُ ، وَقَالَ اللَّہُ : {وَلاَ تُؤْتُوا السُّفَہَائَ أَمْوَالَکُم} وَرَجُلٌ کَانَتْ عِنْدَہُ امْرَأَۃٌ سَیِّئَۃُ الْخُلُقِ فَلَمْ یُفَارِقْہَا وَلَمْ یُطَلِّقْہَا ، وَرَجُلٌ اشْتَرَی وَلَمْ یُشْہِدْ۔","Sahih","Musannaf Ibn Abi Shaybah 20739","","","كتاب البيوع والأقضية"
"20740","(۲۰۷۴۰) حَدَّثَنَا وَکِیعٌ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : ثَلاَثَۃٌ لاَ تُسْتَجَابُ لَہُمْ دَعْوَۃٌ : رَجُلٌ یَدْعُو عَلَی امْرَأَتِہِ وَعَلَی مَمْلُوکِہِ ، وَرَجُلٌ یَبِیعُ وَیَشْتَرِی ، وَلاَ یُشْہِدُ۔","","Musannaf Ibn Abi Shaybah 20740","","","كتاب البيوع والأقضية"
"20741","(۲۰۷۴۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ عَوْفٍ ، عَنِ ابْنِ سِیرِینَ ، أَنَّہُ کَانَ یَقُولُ : یُشْہِدُ إذَا بَاعَ وَإِذَا اشْتَرَی۔","","Musannaf Ibn Abi Shaybah 20741","","","كتاب البيوع والأقضية"
"20742","(۲۰۷۴۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ ، أَنَّہُ کَانَ یَقُولُ : یُشْہِدُ إذَا بَاعَ وَإِذَا اشْتَرَی۔","","Musannaf Ibn Abi Shaybah 20742","","","كتاب البيوع والأقضية"
"20743","(۲۰۷۴۳) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِرٍ ، عَنْ رَجُلٍ مِنْ آلِ أَبِی الْہَیَّاجِ ، عَنْ أَبِی الْہَیَّاجِ ، قَالَ : اسْتَعْمَلَنِی عَلِیٌّ عَلَی السَّوَادِ وَأَمَرَنِی أَنْ أَسْتَحْلِفَ أَہْلَ الْکِتَابِ بِاللَّہِ۔","Da'if","Musannaf Ibn Abi Shaybah 20743","","","كتاب البيوع والأقضية"
"20744","(۲۰۷۴۴) حَدَّثَنَا أبو معاویۃ ، عن حجاج ، عن مَرْوَانَ بْنِ مُعَاوِیَۃَ ، عَنْ یَحْیَی بْنِ مَیْسَرَۃَ ، عَنْ عَمْرِو بْنِ مُرَّۃَ ، عَنْ أَبِی عُبَیْدَۃَ أَنَّہُ اسْتَحْلَفَ الْمُشْرِکَ بِاللَّہِ۔","","Musannaf Ibn Abi Shaybah 20744","","","كتاب البيوع والأقضية"
"20745","(۲۰۷۴۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ مَسْرُوقٍ ، أَنَّہُ کَانَ یَسْتَحْلِفُ الْمُشْرِکِینَ بِاللَّہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20745","","","كتاب البيوع والأقضية"
"20746","(۲۰۷۴۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لاَ یُسْتَحْلَفُ الْمُشْرِکُ إِلاَّ بِاللَّہِ وَلَکِنْ یُغَلَّظُ عَلَیْہِ فِی دِینِہِ۔","","Musannaf Ibn Abi Shaybah 20746","","","كتاب البيوع والأقضية"
"20747","(۲۰۷۴۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَیُّوبَ ، عَنِ ابْنِ سِیرِینَ ، أَنَّ کَعْبَ بْنَ سُورٍ أَدْخَلَہُ الْکَنِیسَۃَ وَوَضَعَ التَّوْرَاۃَ عَلَی رَأْسِہِ وَاسْتَحْلَفَہ بِاللہِ۔","","Musannaf Ibn Abi Shaybah 20747","","","كتاب البيوع والأقضية"
"20748","(۲۰۷۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ عَبْدِ اللہِ بْنِ أَبِی السَّفَرِ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یَسْتَحْلِفُ الْمُشْرِکِینَ بِاللَّہِ حَیْثُ یَکْرَہُونَ۔","","Musannaf Ibn Abi Shaybah 20748","","","كتاب البيوع والأقضية"
"20749","(۲۰۷۴۹) حَدَّثَنَا ابْنُ نُمَیْرٍ، عَنْ أبی الغُصْن، قَالَ: سَمِعْتُ الشَّعْبِیَّ وَأَرَادَ أَنْ یُحَلِّفَ نَصْرَانِیًّا فَقَالَ: أَحْلِفُ بِاللَّہِ ؟ فَقَالَ الشَّعْبِیُّ: قَدْ تَرَکْتُمُ اللَّہَ وَأَنْتُمْ تُبْصِرُونَ، اذْہَبُوا بِہِ إلَی الْبِیعَۃِ فَاسْتَحْلِفُوہُ بِمَا یُسْتَحْلَفُ بِہِ أَہْلُ دِینِہِمْ۔","","Musannaf Ibn Abi Shaybah 20749","","","كتاب البيوع والأقضية"
"20750","(۲۰۷۵۰) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ الْحَمِیدِ ، عَنْ عَطَائٍ ، قَالَ : سُئِلَ عَنِ الْیَہُودِیِّ وَالنَّصْرَانِیِّ أَیُسْتَحْلَفُ بِالتَّوْرَاۃِ وَالإِنْجِیلِ ؟ قَالَ : اسْتَحْلِفُوہُ بِاللَّہِ ، فَإِنَّ التَّوْرَاۃَ وَالإِنْجِیلَ مِنْ کِتَابِ اللہِ۔","","Musannaf Ibn Abi Shaybah 20750","","","كتاب البيوع والأقضية"
"20751","(۲۰۷۵۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یُحَلِّفُ الْمُشْرِکِینَ بِدِینِہِمْ۔","","Musannaf Ibn Abi Shaybah 20751","","","كتاب البيوع والأقضية"
"20752","(۲۰۷۵۲) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ خَالِدِ بْنِ دِینَارٍ ، قَالَ : سَأَلْتُ سَالِمًا ، وَطَاوُوسًا عَنْ بَیْعِ جُلُودِ الْمَیْتَۃِ فَکَرِہَاہَا ، وَقَالَ سَالِمٌ : ہَلْ بَیْعُ جُلُودِ الْمَیْتَۃِ إلاَّ کَأَکْلِ لَحْمِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20752","","","كتاب البيوع والأقضية"
"20753","(۲۰۷۵۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ، عَنْ سَلَمَۃَ أَبِی بِشْرٍ، عَنْ عِکْرِمَۃَ، أَنَّہُ کَرِہَ بَیْعَ جُلُودِ الْمَیْتَۃِ وَالأُضْحِیَّۃِ۔","","Musannaf Ibn Abi Shaybah 20753","","","كتاب البيوع والأقضية"
"20754","(۲۰۷۵۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ خَالِدٍ ، عَنْ أَبِی الْوَلِیدِ ، عَنِ ابْنِ عَبَّاسٍ ، رَفَعَہُ ، قَالَ : إنَّ اللَّہَ إذَا حَرَّمَ عَلَی قَوْمٍ أَکْلَ شَیْئٍ حَرَّمَ عَلَیْہِمْ ثَمَنَہُ۔ (ابوداؤد ۳۴۸۲۔ ابن حبان ۴۹۳۸)","Sahih","Musannaf Ibn Abi Shaybah 20754","","","كتاب البيوع والأقضية"
"20755","(۲۰۷۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، قَالَ : حدَّثَنِی مُغِیرَۃُ مَوْلَی عَمْرِو بْنِ حُرَیْثٍ ، قَالَ : سُئِلَ الشَّعْبِیُّ عَنْ جُلُودِ جَوَامِیسَ مَیِّتَۃٍ فَکَرِہَ بَیْعَہَا قَبْلَ أَنْ تُدْبَغَ۔","","Musannaf Ibn Abi Shaybah 20755","","","كتاب البيوع والأقضية"
"20756","(۲۰۷۵۶) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ أَنْ یَبِیعُوہَا فَیَأْکُلُوا أَثْمَانَہَا ، یَعْنِی جُلُودَ الْمَیْتَۃِ۔","","Musannaf Ibn Abi Shaybah 20756","","","كتاب البيوع والأقضية"
"20757","(۲۰۷۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، أَنَّہُ کَرِہَ بَیْعَہَا وَلُبْسَہَا قَبْلَ أَنْ تُدْبَغَ۔","","Musannaf Ibn Abi Shaybah 20757","","","كتاب البيوع والأقضية"
"20758","(۲۰۷۵۸) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِید ، عَنِ الْحَسَنِ ، أَنَّہُ کَرِہَ بَیْعَ جُلُودِ الْمَیْتَۃِ حَتَّی تُدْبَغَ۔","","Musannaf Ibn Abi Shaybah 20758","","","كتاب البيوع والأقضية"
"20759","(۲۰۷۵۹) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الْحَمِیدِ بن جَعْفَرٍ ، عَنْ یَزِیدَ بْنِ أَبِی حَبِیبٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ ، قَالَ : سَمِعْتُ رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَامَ الْفَتْحِ وَہُوَ یَقُولُ : إنَّ اللَّہَ وَرَسُولَہُ حَرَّمَ بَیْعَ الْمَیْتَۃِ۔n(بخاری ۲۲۳۶۔ مسلم ۱۲۰۷)","Sahih","Musannaf Ibn Abi Shaybah 20759","","","كتاب البيوع والأقضية"
"20760","(۲۰۷۶۰) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بْنِ جَابِرٍ ، قَالَ : حدَّثَنَا الْقَاسِمُ ، عَنْ أَبِی أُمَامَۃَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَنْ یُحْتَکَرَ الطَّعَامُ۔ (حاکم ۱۱/۲۔ طبرانی ۷۷۷۶)","Hasan","Musannaf Ibn Abi Shaybah 20760","","","كتاب البيوع والأقضية"
"20761","(۲۰۷۶۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنِ التَّیْمِیِّ ، عَنْ أَبِی نَضْرَۃَ ، عَنْ أَبِی سَعِیدٍ مَوْلَی الأَنْصَارِ ، عَنْ عُثْمَانَ بْنِ عَفَّانَ أَنَّہُ نَہَی عَنِ الْحُکْرَۃِ۔","Hasan","Musannaf Ibn Abi Shaybah 20761","","","كتاب البيوع والأقضية"
"20762","(۲۰۷۶۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ مَعْمَرِ ابْنِ نَضْلَۃَ الْعَدَوِیِّ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : لاَ یَحْتَکِرُ إلاَّ خَاطِیئٌ۔n(مسلم ۱۲۲۷۔ ابوداؤد ۳۴۴۰)","","Musannaf Ibn Abi Shaybah 20762","","","كتاب البيوع والأقضية"
"20763","(۲۰۷۶۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الْحُکْرَۃُ خَطِیئَۃٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20763","","","كتاب البيوع والأقضية"
"20764","(۲۰۷۶۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ عُبَیْدِ اللہِ ، قَالَ : قَالَ عُمَرُ : مَنِ احْتَکَرَ طَعَامًا ، ثُمَّ تَصَدَّقَ بِرَأْسِ مَالِہِ وَالرِّبْحِ لَمْ یُکَفِّرْ عَنْہُ۔","Da'if","Musannaf Ibn Abi Shaybah 20764","","","كتاب البيوع والأقضية"
"20765","(۲۰۷۶۵) حَدَّثَنَا جَرِیرٌ، عَنْ لَیْثٍ، عَنِ الْحَکَمِ، قَالَ: أُخْبِرَ عَلِیٌّ بِرَجُلٍ احْتَکَرَ طَعَامًا بِمِئَۃِ أَلْفٍ فَأَمَرَ بِہِ أَنْ یُحْرَقَ۔","Da'if","Musannaf Ibn Abi Shaybah 20765","","","كتاب البيوع والأقضية"
"20766","(۲۰۷۶۶) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ الرُّؤَاسِیُّ ، عَنِ الْحَسَنِ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ قَیْسٍ ، قَالَ: قَالَ حبیش : قَدْ أَحْرَقَ علیَّ عَلِیٌّ بَیَادِرَ بِالسَّوَادِ کُنْت احْتَکَرْتُہَا لَوْ تَرَکَہَا لَرَبِحْتُہَا مِثْلَ عَطَائِ الْکُوفَۃِ۔","Da'if","Musannaf Ibn Abi Shaybah 20766","","","كتاب البيوع والأقضية"
"20767","(۲۰۷۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إبْرَاہِیمَ بْنِ مُہَاجِرٍ ، عَنْ عَبْدِ اللہِ بْنِ بابہ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : لاَ یَحْتَکِرُ إلاَّ خَاطِیئٌ ، أَوْ بَاغٍ۔","Hasan","Musannaf Ibn Abi Shaybah 20767","","","كتاب البيوع والأقضية"
"20768","(۲۰۷۶۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنِ الرَّبِیعِ بْنِ حَبِیبٍ ، عَنْ نَوْفَلِ بْنِ عَبْدِ الْمَلِکِ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الْحُکْرَۃِ بِالْبَلَدِ۔ (حارث ۴۲۷)","Da'if","Musannaf Ibn Abi Shaybah 20768","","","كتاب البيوع والأقضية"
"20769","(۲۰۷۶۹) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ: أَخْبَرَنَا الأَصْبَغُ بْنُ زَیْدٍ الْوَرَّاقُ ، قَالَ: حَدَّثَنَا أبو بشر ، عن أَبی الزَّاہِرِیَّۃِ، عَنْ کَثِیرِ بْنِ مُرَّۃَ الْحَضْرَمِیِّ، عَنِ ابْنِ عُمَرَ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ، قَالَ: مَنِ احْتَکَرَ طَعَامًا أَرْبَعِینَ لَیْلَۃً ، فَقَدْ بَرِئَ مِنَ اللہِ وَبَرِئَ اللَّہُ مِنْہُ ، وأَیُّمَا أَہْلِ عَرْصَۃٍ ظَلَّ فِیہِمُ امْرُؤٌ جَائِعٌ ، فَقَدْ بَرِئَتْ مِنْہُمْ ذِمَّۃُ اللہِ۔n(احمد ۳۳۔ ابو یعلی ۵۷۲۰)","Da'if","Musannaf Ibn Abi Shaybah 20769","","","كتاب البيوع والأقضية"
"20770","حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ بقی ابْنُ مَخْلَدٍ ، قَالَ : حَدَّثَنَا أَبُو بَکْرٍ مُحَمَّدُ بْنُ عَبْدِ اللہِ بْنِ أَبِی شَیْبَۃَ ، قَالَ :n(۲۰۷۷۰) حَدَّثَنَا ہُشَیْمُ بْنُ بَشِیرٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یُعْطِیَ الرَّجُلُ الرَّجُلَ الثَّوْبَ فَیَقُولَ : بِعْہُ بِکَذَا وَکَذَا ، فَمَا ازْدَدْتَ فَلَکَ۔","Sahih","Musannaf Ibn Abi Shaybah 20770","","","كتاب البيوع والأقضية"
"20771","(۲۰۷۷۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ ابْنِ سِیرِینَ أَنَّہُ لَمْ یَکُنْ یَرَی بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20771","","","كتاب البيوع والأقضية"
"20772","(۲۰۷۷۲) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الْمُطَرِّفِ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، عَنْ شُرَیْحٍ أَنَّہُ لَمْ یَکُنْ یَرَی بَأْسًا أَنْ یُعْطِیَہُ الثَّوْبَ فَیَقُولَ : بِعْ ہَذَا الثَّوْبَ بِکَذَا وَکَذَا ، فَمَا ازْدَدْتَ فَلَکَ۔","","Musannaf Ibn Abi Shaybah 20772","","","كتاب البيوع والأقضية"
"20773","(۲۰۷۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ أَنَّہُ لَمْ یَکُنْ یَرَی بِذَلِکَ بَأْسًا۔","","Musannaf Ibn Abi Shaybah 20773","","","كتاب البيوع والأقضية"
"20774","(۲۰۷۷۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : إذَا دَفَعَ الرَّجُلُ إلَی الرَّجُلِ مَتَاعًا فَقَالَ : مَا اسْتَفْضَلْتَ ، فَہُوَ لَکَ ، أَوْ فَبَیْنِی وَبَیْنَکَ ، فَلاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 20774","","","كتاب البيوع والأقضية"
"20775","(۲۰۷۷۵) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنْ رَجُلٍ ، عَنِ الْحَکَمِ ؛ فِی الرَّجُلِ یُعْطِی الرَّجُلَ الثَّوْبَ فَیَقُولُ : بِعْہُ بِکَذَا وَکَذَا ، فَمَا زَادَ بَیْنِی وَبَیْنَکَ ، قَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 20775","","","كتاب البيوع والأقضية"
"20776","(۲۰۷۷۶) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، وَعَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُمَا کَرِہَاہ۔","No Data Available","Musannaf Ibn Abi Shaybah 20776","","","كتاب البيوع والأقضية"
"20777","(۲۰۷۷۷) حَدَّثَنَا حَکَّامٌ الرَّازِیّ ، عَنِ الْمُثَنَّی ، عَنْ عَطَائٍ ، أَنَّہُ کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا ، قَالَ : وَکَانَ طَاوُوس یَکْرَہُہُ إلاَّ بِأَجْرٍ مَعْلُومٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 20777","","","كتاب البيوع والأقضية"
"20778","(۲۰۷۷۸) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ الْقَطَّانُ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَدْفَعُ إلَی الرَّجُلِ الثَّوْبَ فَیَقُولُ: بِعْہُ بِکَذَا وَکَذَا، فَمَا اسْتَفْضَلْتَ، فلَکَ، قَالَ: إِنْ کَانَ بِنَقْدٍ فَلاَ بَأْسَ، وَإِنْ کَانَ بِنَسِیئَۃٍ فَلاَ خَیْرَ فِیہِ۔","","Musannaf Ibn Abi Shaybah 20778","","","كتاب البيوع والأقضية"
"20779","(۲۰۷۷۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ خَالِدٍ الْحَذَّائِ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ، عَنِ ابْنِ مَسْعُودٍ : أنہ کَانَ لاَ یَرَی بَأْسًا أَنْ یَبِیعَ الرَّجُلُ الْمَتَاعَ الْعَشَرَۃَ اثْنَیْ عَشَرَ مَا لَمْ یَأْخُذْ لِلنَّفَقَۃِ رِبْحًا۔","","Musannaf Ibn Abi Shaybah 20779","","","كتاب البيوع والأقضية"
"20780","(۲۰۷۸۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ کَرِہَ إذَا بَاعَ الرَّجُلُ الْمَتَاعَ مُرَابَحَۃً أَنْ یَأْخُذَ لِلنَّفَقَۃِ رِبْحًا۔","","Musannaf Ibn Abi Shaybah 20780","","","كتاب البيوع والأقضية"
"20781","(۲۰۷۸۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بِذَلِکَ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20781","","","كتاب البيوع والأقضية"
"20782","(۲۰۷۸۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَأْخُذَ لِلنَّفَقَۃِ رِبْحًا۔","","Musannaf Ibn Abi Shaybah 20782","","","كتاب البيوع والأقضية"
"20783","(۲۰۷۸۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ خَالِدٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ بَأْسَ أَنْ یَحْسِبَ النَّفَقَۃَ عَلَی الْمَتَاعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20783","","","كتاب البيوع والأقضية"
"20784","(۲۰۷۸۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَجْلاَنَ ، قَالَ : قُلْتُ لإِبْرَاہِیمَ : إنَّا نَشْتَرِی الْمَتَاعَ ، ثُمَّ نَزِیدُ عَلَیْہِ الْقَصَارَۃَ وَالْکِرَائَ ، ثُمَّ نَبِیعُہُ بہ مرابحۃ ، قَالَ : لاَ بَأْسَ بہ۔","","Musannaf Ibn Abi Shaybah 20784","","","كتاب البيوع والأقضية"
"20785","(۲۰۷۸۵) حَدَّثَنَا عُبَیْدُ اللہِ ، عَنْ حَنْظَلَۃَ ، عَنْ طَاوُوسٍ ، أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَشْتَرِی الْبز فَیَتَکَارَی لَہُ ، أَیَأْخُذُ لَہُ رِبْحًا ؟ قَالَ : إذَا بَیَّنَ۔","","Musannaf Ibn Abi Shaybah 20785","","","كتاب البيوع والأقضية"
"20786","(۲۰۷۸۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی الرَّجُلِ یَبِیعُ مُرَابَحَۃً یَأْخُذُ رِبْحًا لِلْکِرَائِ؟ قَالَ: یَأْخُذُ رِبْحَ مَا نقد فِی الأَرْضِ الَّتِی خَرَجَ مِنْہَا إِنْ شَائَ، وَمَا نقد فِی الْبَلَدِ الَّذِی بَاعَ فِیہِ فَلاَ یَأْخُذْ رِبْحہ۔","","Musannaf Ibn Abi Shaybah 20786","","","كتاب البيوع والأقضية"
"20787","(۲۰۷۸۷) حَدَّثَنَا عَبْدُ الأَعْلَی بْنُ عَبْدِ الأَعْلَی ، عَنْ دَاوُدَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : ذَلِکَ الْبَاطِلُ۔","","Musannaf Ibn Abi Shaybah 20787","","","كتاب البيوع والأقضية"
"20788","(۲۰۷۸۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ أَبِیہِ ، عَنْ عَامِرٍ ، قَالَ : لاَ تَأْخُذْ سِلْعَتَکَ وَتَأْخُذَ مَعَہَا فَضْلاً۔","No Data Available","Musannaf Ibn Abi Shaybah 20788","","","كتاب البيوع والأقضية"
"20789","(۲۰۷۸۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : سَأَلْتُ إِبْرَاہِیمَ ، عَن رَجُلٍ بَاعَ شَاۃً مِنْ رَجُلٍ ، ثُمَّ بَدَا لَہُ مِنْ قَبْلِ أَنْ یَأْخُذَہَا فَقَالَ : أَقِلْنِی ، فَأَبَی ، وَقَالَ : أَعْطِنِی دِرْہَمًا وَأُقِیلُکَ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 20789","","","كتاب البيوع والأقضية"
"20790","(۲۰۷۹۰) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ، أَنَّ عَلْقَمَۃَ بَاعَ رَجُلاً دَابَّۃً ، فَأَرَادَ صَاحِبُہَا أَنْ یَرُدَّہَا وَیَرُدَّ مَعَہَا دراہم فَقَالَ عَلْقَمَۃُ : ہَذِہِ دَابَّتُنَا فَمَا حَقُّنَا فِی دَرَاہِمِکَ ؟۔","","Musannaf Ibn Abi Shaybah 20790","","","كتاب البيوع والأقضية"
"20791","(۲۰۷۹۱) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، عَنِ الأَسْوَدِ، أَنَّہُ کَرِہَ أَنْ یَرُدَّہَا وَیَرُدَّ مَعَہَا دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 20791","","","كتاب البيوع والأقضية"
"20792","(۲۰۷۹۲) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ أَبِی معبد ، قَالَ : سَمِعْتُ جَابِرَ بْنَ زَیْدٍ سُئِلَ عَنْ رَجُلٍ ابْتَاعَ دارا أو عقارا، فَأَرَادَ أَنْ یُقِیلَہُ فَأَبَی فَتَرَکَ لَہُ عَشَرَۃَ دَرَاہِمَ ، أَوْ عِشْرِینَ دِرْہَمًا فَأَقَالَہُ ، قَالَ : لاَ بَأْسَ بِذَلِکَ۔","","Musannaf Ibn Abi Shaybah 20792","","","كتاب البيوع والأقضية"
"20793","(۲۰۷۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَرِہَ أَنْ یَرُدَّہَا وَیَرُدَّ مَعَہَا دِرْہَمًا۔","","Musannaf Ibn Abi Shaybah 20793","","","كتاب البيوع والأقضية"
"20794","(۲۰۷۹۴) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، قَالَ : سَمِعْتُ سَعِیدَ بْنَ الْمُسَیَّبِ وَسُئِلَ عَنْ رَجُلٍ اشْتَرَی بَعِیرًا فَنَدِمَ الْمُبْتَاعُ ، فَأَرَادَ أَنْ یَرُدَّہُ وَیَرُدَّ مَعَہُ ثَمَانیَۃَ دَرَاہِمَ فَقَالَ سَعِیدٌ : لاَ بَأْسَ بِہِ ، إنَّمَا الرِّبَا فِیمَا یُکَالُ وَیُوزَنُ مِمَّا یُؤْکَلُ وَیُشْرَبُ۔","","Musannaf Ibn Abi Shaybah 20794","","","كتاب البيوع والأقضية"
"20795","(۲۰۷۹۵) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : جَائَ رَجُلاَنِ فَقَامَا عِنْدَ شُرَیْحٍ ، ثُمَّ تَحَاوَرَا ، فَقَالَ لَہُ أَحَدُہُمَا : اشْہَدُوا أَنِّی قَدْ قَبِلْتُ جَمَلِی وَثَلاَثِینَ دِرْہَمًا ، فَسَکَتَ شُرَیْحٌ ، قَالَ : فَأُرَاہُ لَوْ کَرِہَہُ لأَنْکَرَہُ۔","","Musannaf Ibn Abi Shaybah 20795","","","كتاب البيوع والأقضية"
"20796","(۲۰۷۹۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ یَزِیدَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ أَنَّہُمَا لَمْ یَرَیَا بِذَلِکَ بَأْسًا إذَا استغلی الرَّجُلُ الْبَیْعَ۔","","Musannaf Ibn Abi Shaybah 20796","","","كتاب البيوع والأقضية"
"20797","(۲۰۷۹۷) حَدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْوَلِیدِ بْنِ عَبْدِ اللہِ بْنِ أَبِی مُغِیثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عُمَرَ فِی رَجُلٍ اشْتَرَی بَعِیرًا ، فَأَرَادَ أَنْ یَرُدَّہُ وَیَرُدَّ مَعَہُ دراہم فَقَالَ : لاَ بَأْسَ بِہِ۔","Sahih","Musannaf Ibn Abi Shaybah 20797","","","كتاب البيوع والأقضية"
"20798","(۲۰۷۹۸) حدَّثَنَا وَکِیعٌ ، عَنْ یَزِیدَ بْنِ إبْرَاہِیمَ ، عَنِ الْحَسَنِ ، وَابْنِ سِیرِینَ ؛ فِی الرَّجُلِ یَشْتَرِی السِّلْعَۃَ ، ثُمَّ یَسْتَغْلِیہَا ، قَالَ : لاَ بَأْسَ أَنْ یَرُدَّہَا وَیَرُدَّ مَعَہَا دراہم۔","","Musannaf Ibn Abi Shaybah 20798","","","كتاب البيوع والأقضية"
"20799","(۲۰۷۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا تَغَیَّرَتْ عَنْ حَالِہَا فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 20799","","","كتاب البيوع والأقضية"
"20800","(۲۰۸۰۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَابْنُ أَبِی زَائِدَۃَ ، عَنْ صَدَقَۃَ بْنِ الْمُثَنَّی ، عَنْ جَدِّہِ رِیَاحِ بْنِ الْحَارِثِ ، عَنْ عَمَّارِ بْنِ یَاسِرٍ ، قَالَ : الْعَبْدُ خَیْرٌ مِنَ الْعَبْدَیْنِ ، وَالْبَعِیرُ خَیْرٌ مِنَ الْبَعِیرَیْنِ ، وَالثَّوْبُ خَیْرٌ مِنَ الثَّوْبَیْنِ ، لاَ بَأْسَ بِہِ یَدًا بِیَدٍ إنَّمَا الرِّبَا فِی النَّسَائِ ، إلاَّ مَا کِیلَ وَوُزِنَ۔","Sahih","Musannaf Ibn Abi Shaybah 20800","","","كتاب البيوع والأقضية"
"20801","(۲۰۸۰۱) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ اشْتَرَی نَاقَۃً بِأَرْبَعَۃِ أَبْعِرَۃٍ بِالرَّبَذَۃِ فَقَالَ لِصَاحِبِہِ : اذْہَبْ فَانْظُرْ ، فَإِنْ رَضِیْتَ ، فَقَدْ وَجَبَ الْبَیْعُ۔","Sahih","Musannaf Ibn Abi Shaybah 20801","","","كتاب البيوع والأقضية"
"20802","(۲۰۸۰۲) حدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ مُحَمَّدِ بْنِ عَلِیِّ بْنِ الْحَنَفِیَّۃِ ، قَالَ : قُلْتُ لَہُ : أَبِیعُ بَعِیرًا بِبَعِیرَیْنِ إلَی أَجَلٍ ؟ قَالَ : لاَ وَلاَ بَأْسَ بِہِ یَدًا بِیَدٍ۔","","Musannaf Ibn Abi Shaybah 20802","","","كتاب البيوع والأقضية"
"20803","(۲۰۸۰۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَوَانُ وَاحِدٌ بِاثْنَیْنِ لاَ یَصْلُحُ ، یَعْنِی نَسِیئَۃً۔ (ترمذی ۱۳۳۸۔ ابن ماجہ ۲۲۷۱)","","Musannaf Ibn Abi Shaybah 20803","","","كتاب البيوع والأقضية"
"20804","(۲۰۸۰۴) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الْحَجَّاجِ ، عَنِ الْحَکَمِ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الْحَیَوَانِ وَاحِدٌ بِاثْنَیْنِ ، یَعْنِی نَسِیئَۃً۔","","Musannaf Ibn Abi Shaybah 20804","","","كتاب البيوع والأقضية"
"20805","(۲۰۸۰۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ إِسْحَاقَ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، قَالَ : بَاعَ عَلِیٌّ بَعِیرًا بِبَعِیرَیْنِ فَقَالَ لَہُ الَّذِی اشْتَرَاہُ مِنْہُ : سَلِّمْ لِی بَعِیرِی حَتَّی آتِیَکَ بِبَعِیرَیْکَ ، فَقَالَ عَلِیٌّ : لاَ تُفَارِقُ یَدَیْ خِطَامَہُ حَتَّی تَأْتِیَ بِبَعِیرَیَّ۔","","Musannaf Ibn Abi Shaybah 20805","","","كتاب البيوع والأقضية"
"20806","(۲۰۸۰۶) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ عَطَائٍ ، عَنْ جَابِرٍ أَنَّہُ لَمْ یَرَ بَأْسًا بِالْبَعِیرِ بِالْبَعِیرَیْنِ۔","Sahih","Musannaf Ibn Abi Shaybah 20806","","","كتاب البيوع والأقضية"
"20807","(۲۰۸۰۷) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ بَأْسَ بِالْبَعِیرِ بِالْبَعِیرَیْنِ۔","","Musannaf Ibn Abi Shaybah 20807","","","كتاب البيوع والأقضية"
"20808","(۲۰۸۰۸) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ ، قَالَ : قُلْتُ لَہُمَا : مَا تَرَیَانِ فِی طَیْلَسَانٍ بِطَیْلَسَانَیْنِ وَفِی مُسْتُقَۃٍ بِمُسْتُقَتَیْنِ ؟ فَقَالَ الشَّعْبِیُّ : لاَ بَأْسَ بِہِ ، وَکَرِہَہُ إبْرَاہِیمُ۔","","Musannaf Ibn Abi Shaybah 20808","","","كتاب البيوع والأقضية"
"20809","(۲۰۸۰۹) حدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمَیَّۃَ ، عَنْ رَجُلٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لاَ بَأْسَ بِالْقُبْطِیَّۃِ بِالْقُبْطِیَّتَیْنِ۔","","Musannaf Ibn Abi Shaybah 20809","","","كتاب البيوع والأقضية"
"20810","(۲۰۸۱۰) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ أَبِی جَعْفَرٍ ، عَنْ عَلِیٍّ ، قَالَ : لاَ بَأْسَ بِالْحُلَّۃِ بِالْحُلَّتَیْنِ۔","Da'if","Musannaf Ibn Abi Shaybah 20810","","","كتاب البيوع والأقضية"
"20811","(۲۰۸۱۱) حَدَّثَنَا علی بن مُسْہِرٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : کُلُّ ما لاَ یُکَالُ ، وَلاَ یُوزَنُ ، فَلاَ بَأْسَ أَنْ یُعْطَی وَاحِدًا بِاثْنَیْنِ ، أَوْ ثَلاَثَۃٍ ، أَوْ أَقَلَّ ، أَوْ أَکْثَرَ یَدًا بِیَدٍ۔","","Musannaf Ibn Abi Shaybah 20811","","","كتاب البيوع والأقضية"
"20812","(۲۰۸۱۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحَیَوَانُ وَاحِدٌ بِوَاحِدٍ لاَ بَأْسَ بِہِ یَدًا بِیَدٍ ، وَلاَ خَیْرَ فِیہِ نَسَائً۔","","Musannaf Ibn Abi Shaybah 20812","","","كتاب البيوع والأقضية"
"20813","(۲۰۸۱۳) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ ، قَالَ : قُلْتُ لابْنِ عُمَرَ : الْبَعِیرُ بِالْبَعِیرَیْنِ ؟ فقَالَ : یَدًا بِیَدٍ ؟ فقُلْتُ : لاَ ، قَالَ : فَکَرِہَہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20813","","","كتاب البيوع والأقضية"
"20814","(۲۰۸۱۴) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : لاَ بَأْسَ بِالْبَعِیرِ بِالْبَعِیرَیْنِ نَسِیئَۃً۔","","Musannaf Ibn Abi Shaybah 20814","","","كتاب البيوع والأقضية"
"20815","(۲۰۸۱۵) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ مُجَالِدٍ ، عَنْ قَیْسٍ ، عَنِ الصُّنَابِحِ الأَحْمَسِیِّ ، قَالَ : أَبْصَرَ النَّبِیُّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَاقَۃً حَسَنَۃً فَقَالَ : مَا ہَذِہِ النَّاقَۃُ ؟ فَقَالَ : یَا رَسُولَ اللہِ إنِّی ارْتَجَعْتُہَا بِبَعِیرَیْنِ مِنْ حَوَاشِی الإِبِلِ ، قَالَ : فَنَعَمْ إذَنْ۔","Da'if","Musannaf Ibn Abi Shaybah 20815","","","كتاب البيوع والأقضية"
"20816","(۲۰۸۱۶) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃََ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنِ الْحَیَوَانِ بِالْحَیَوَانِ نَسِیئَۃً۔ (احمد ۱۲۔ دارمی ۲۵۶۴)","Hasan","Musannaf Ibn Abi Shaybah 20816","","","كتاب البيوع والأقضية"
"20817","(۲۰۸۱۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی ذِئْبٍ ، عَنْ یَزِیدَ بْنِ عَبْدِ اللہِ بْنِ قُسَیْطٍ ، عَنْ أَبِی الْحَسَنِ الْبَرَّادِ ، عَنْ عَلِیٍّ ، قَالَ : لاَ یَصْلُحُ الْحَیَوَانُ بِالْحَیَوَانَیْنِ ، وَلاَ الشَّاۃُ بِالشَّاتَیْنِ إلاَّ یَدًا بِیَدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 20817","","","كتاب البيوع والأقضية"
"20818","(۲۰۸۱۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : سُئِلَ عُمَرُ عَنِ الشَّاۃِ بِالشَّاتَیْنِ إلَی الْحَیَا ، یَعْنِی الْخِصْبَ ، فَکَرِہَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 20818","","","كتاب البيوع والأقضية"
"20819","(۲۰۸۱۹) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ الأَعْلَی ، عَنْ سُوَیْد بْنِ غَفَلَۃَ ، قَالَ : لاَ بَأْسَ بِالْفَرَسِ بِالْفَرَسَیْنِ وَالدَّابَّۃِ بِالدَّابَّتَیْنِ یَدًا بِیَدٍ۔","","Musannaf Ibn Abi Shaybah 20819","","","كتاب البيوع والأقضية"
"20820","(۲۰۸۲۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، قَالَ سَأَلْتُ أَیُّوبَ عَنِ الثَّوْبِ بِالثَّوْبَیْنِ نَسِیئَۃً ، قَالَ : کَانَ مُحَمَّدُ یَکْرَہُہُ۔","","Musannaf Ibn Abi Shaybah 20820","","","كتاب البيوع والأقضية"
"20821","(۲۰۸۲۱) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ثَابِتٍ ، عَنْ أَنَسٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ اشْتَرَی صَفِیَّۃَ بِسَبْعَۃِ أَرْؤُسٍ۔ (مسلم ۱۰۴۵۔ ابوداؤد ۲۹۹۰)","Sahih","Musannaf Ibn Abi Shaybah 20821","","","كتاب البيوع والأقضية"
"20822","(۲۰۸۲۲) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ أَبِی الْوَازِعِ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ یَقُولُ : مَنْ یَبِیعُنِی بَعِیرًا بِبَعِیرَیْنِ ، مَنْ یَبِیعُنِی نَاقَۃً بِنَاقَتَیْنِ۔","Hasan","Musannaf Ibn Abi Shaybah 20822","","","كتاب البيوع والأقضية"
"20823","(۲۰۸۲۳) حَدَّثَنَا عَبَّادٌ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ بَأْسَ بِالْبَیْضَۃِ بِالْبَیْضَتَیْنِ وَالْجَوْزَۃِ بِالْجَوْزَتَیْنِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20823","","","كتاب البيوع والأقضية"
"20824","(۲??۸۲۴) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ عَبْدِ اللہِ مَوْلَی مُجَاہِدٍ ، عَنْ مُجَاہِدٍ ، قَالَ : لاَ بَأْسَ بِالْبَیْضَۃِ بِالْبَیْضَتَیْنِ وَالْجَوْزَۃَ بِالْجَوْزَتَیْنِ یَدًا بِیَدٍ۔","","Musannaf Ibn Abi Shaybah 20824","","","كتاب البيوع والأقضية"
"20825","(۲۰۸۲۵) حَدَّثَنَا مُلاَزِمُ بْنُ عَمْرَو ، عَنْ زُفَرَ بْنِ یَزِیدَ ، عَنْ أَبِیہِ ، قَالَ : سَأَلْتُ أَبَا ہُرَیْرَۃَ ، عَنْ شِرَائِ الشَّاۃِ بِالشَّاتَیْنِ إلَی أَجَلٍ فَنَہَانِی ، وَقَالَ : لاَ ، إلاَّ یَدًا بِیَدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 20825","","","كتاب البيوع والأقضية"
"20826","(۲۰۸۲۶) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا بْنِ أَبِی زَائِدَۃَ ، عَنْ أَشْعَثَ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : لاَ بَأْسَ أَنْ یَقُولَ لِلسِّلْعَۃِ : ہِیَ بِنَقْدٍ بِکَذَا ، وَبِنَسِیئَۃٍ بِکَذَا ، وَلَکِنْ لاَ یَفْتَرِقَا إلاَّ عَنْ رِضًا۔","Da'if","Musannaf Ibn Abi Shaybah 20826","","","كتاب البيوع والأقضية"
"20827","(۲۰۸۲۷) حَدَّثَنَا أَبُو الأَحْوَص، عَنْ سِمَاکٍ ، عَنْ أَبِی عُبَیْدَۃَ ، أَوْ عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ، عَنِ ابْنِ مَسْعُودٍ، قَالَ : صَفْقَتَانِ فِی صَفْقَۃٍ رِبًا ، إِلاَّ أَنْ یَقُولَ الرَّجُلُ : إِنْ کَانَ بِنَقْدٍ فَبِکَذَا ، وَإِنْ کَانَ بِنَسِیئَۃٍ فَبِکَذَا۔","","Musannaf Ibn Abi Shaybah 20827","","","كتاب البيوع والأقضية"
"20828","(۲۰۸۲۸) وَکِیعٌ ، قَالَ : حَدَّثَنَا سُفْیَانُ ، عَنْ سِمَاکٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللہِ ، عَنْ أَبِیہِ بِمِثْلِہِ۔","","Musannaf Ibn Abi Shaybah 20828","","","كتاب البيوع والأقضية"
"20829","(۲۰۸۲۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ أَیُّوبَ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَسْتَامَ الرَّجُلُ بِالسِّلْعَۃِ یَقُولُ : ہِیَ بِنَقْدٍ بِکَذَا ، وَبِنَسِیئَۃٍ بِکَذَا۔","","Musannaf Ibn Abi Shaybah 20829","","","كتاب البيوع والأقضية"
"20830","(۲۰۸۳۰) حَدَّثَنَا أَبُو دَاوُدَ ، عَنْ زَمْعَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّہُ سَمِعَہُ یَنْہَی عَنِ الْبَیْعَتَیْنِ تحویہما الصَّفْقَۃُ۔","","Musannaf Ibn Abi Shaybah 20830","","","كتاب البيوع والأقضية"
"20831","(۲۰۸۳۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ أَنَّہُ سَمِعَہُ ، قَالَ : لاَ بَأْسَ بِہِ إذَا أَخَذَہُ عَلَی أَحَدِ النَّوْعَیْنِ۔","","Musannaf Ibn Abi Shaybah 20831","","","كتاب البيوع والأقضية"
"20832","(۲۰۸۳۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، وَعَنْ عَبْدِ الرَّحْمَنِ بْنِ عَمْرٍو الأَوْزَاعِی ، عَنْ عَطَائٍ ، قَالاَ : لاَ بَأْسَ أَنْ یَقُولَ : ہَذَا الثَّوْبُ بِالنَّقْدِ بِکَذَا ، وَبِالنَّسِیئَۃِ بِکَذَا ، وَیَذْہَبُ بِہِ عَلَی أَحَدِہِمَا۔","","Musannaf Ibn Abi Shaybah 20832","","","كتاب البيوع والأقضية"
"20833","(۲۰۸۳۳) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ اشْتَرَی بَیْعًا ، ثُمَّ قَالَ : لَیْسَ عِنْدِی ہَذَا ، أَشْتَرِیہِ بِالنَّسِیئَۃِ ، قَالَ : إذَا تتارکا الْبَیْع اشْتَرَاہُ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 20833","","","كتاب البيوع والأقضية"
"20834","(۲۰۸۳۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِی سَلَمَۃَ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : مَنْ بَاعَ بَیْعَتَیْنِ فِی بَیْعَۃٍ فَلَہُ أَوْکَسُہُمَا ، أَوِ الرِّبَا۔ (ترمذی ۱۲۳۱۔ ابوداؤد ۳۴۵۵)","Hasan","Musannaf Ibn Abi Shaybah 20834","","","كتاب البيوع والأقضية"
"20835","(۲۰۸۳۵) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ دَاوُدَ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، أَنَّ جَدَّہُ کَانَ إذَا بَعَثَ تِجَارَۃً نَہَاہُمْ عَنْ شَرْطَیْنِ فِی بَیْعٍ۔","","Musannaf Ibn Abi Shaybah 20835","","","كتاب البيوع والأقضية"
"20836","(۲۰۸۳۶) حَدَّثَنَا ہَاشِمُ بْنُ الْقَاسِمِ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا عَنِ الرَّجُلِ یَشْتَرِی مِنَ الرَّجُلِ الشَّیْئَ فَیَقُولُ: إِنْ کَانَ بِنَقْدٍ فَبِکَذَا، وَإِنْ کَانَ إلَی أَجَلٍ فَبِکَذَا، قَالَ: لاَ بَأْسَ إذَا انْصَرَفَ عَلَی أَحَدِہِمَا قَالَ: شُعْبَۃُ، فَذَکَرْت ذَلِکَ لَمُغِیرَۃَ فَقَالَ: کَانَ إبْرَاہِیمُ لاَ یَرَی بِذَلِکَ بَأْسًا إذَا تَفَرَّقَ عَلَی أَحَدِہِمَا۔","","Musannaf Ibn Abi Shaybah 20836","","","كتاب البيوع والأقضية"
"20837","(۲۰۸۳۷) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَنْ بَیْعِ الْوَلاَئِ ، وَعَنْ ہِبَتِہِ۔ (بخاری ۲۵۳۵۔ مسلم ۱۱۴۵)","Sahih","Musannaf Ibn Abi Shaybah 20837","","","كتاب البيوع والأقضية"
"20838","(۲۰۸۳۸) حدَّثَنَا جَرِیرٌ وَحَفْصٌ ، وَأَبُو خَالِدٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ أَبِی سُلَیْمَانَ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْوَلاَئُ لاَ یُبَاعُ ، وَلاَ یُوہَبُ۔","Da'if","Musannaf Ibn Abi Shaybah 20838","","","كتاب البيوع والأقضية"
"20839","(۲۰۸۳۹) حدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: قَالَ عَبْدُ اللہِ : إنَّمَا الْوَلاَئُ کَالنَّسَبِ ، أَفَیَبِیعُ الرَّجُلُ نَسَبَہُ۔","","Musannaf Ibn Abi Shaybah 20839","","","كتاب البيوع والأقضية"
"20840","(۲۰۸۴۰) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عَلِیٌّ : الْوَلاَئُ بِمَنْزِلَۃِ الْحِلْفِ ، لاَ یُبَاعُ، وَلاَ یُوہَبُ ، أَقِرُّوہُ حَیْثُ جَعَلَہُ اللَّہُ۔","","Musannaf Ibn Abi Shaybah 20840","","","كتاب البيوع والأقضية"
"20841","(۲۰۸۴۱) حَدَّثَنَا مُحَمَّدُ بْنُ یَزِیدَ ، عَنْ أَیُّوبَ أَبِی الْعَلاَئِ ، عَنْ قَتَادَۃَ ، عَنْ عُمَر ، قَالَ : الْوَلاَئُ کَالرَّحِمِ لاَ یُبَاعُ ، وَلاَ یُوہَبُ۔","","Musannaf Ibn Abi Shaybah 20841","","","كتاب البيوع والأقضية"
"20842","(۲۰۸۴۲) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : الْوَلاَئُ کَالنَّسَبِ لاَ یُبَاعُ ، وَلاَ یُوہَبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20842","","","كتاب البيوع والأقضية"
"20843","(۲۰۸۴۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی مِسْکِینٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : الْوَلاَئُ لاَ یُبَاعُ ، وَلاَ یُوہَبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20843","","","كتاب البيوع والأقضية"
"20844","(۲۰۸۴۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ إِبْرَاہِیمَ، عَن لَیْثٍ، عَنْ طَاوُوسٍ، قَالَ: لاَ یُبَاعُ الْوَلاَئُ، وَلاَ یُوہَبُ، وَلاَ یُتَصَدَّقُ بِہِ۔","","Musannaf Ibn Abi Shaybah 20844","","","كتاب البيوع والأقضية"
"20845","(۲۰۸۴۵) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : الْوَلاَئُ لُحْمَۃٌ کَلُحْمَۃِ النَّسَبِ لاَ یُبَاعُ، وَلاَ یُوہَبُ۔","","Musannaf Ibn Abi Shaybah 20845","","","كتاب البيوع والأقضية"
"20846","(۲۰۸۴۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : کَانَ لاَ یَرَی بَأْسًا بِبَیْعِ الْوَلاَئِ إذَا کَانَ مِنْ مُکَاتبہ وَیَکْرَہُہُ إذَا کَانَ عِتْقًا۔","","Musannaf Ibn Abi Shaybah 20846","","","كتاب البيوع والأقضية"
"20847","(۲۰۸۴۷) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ جَابِرٍ ، عَنْ عَامِرٍ ، قَالَ : الْوَلاَئُ لاَ یُبَاعُ ، وَلاَ یُوہَبُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20847","","","كتاب البيوع والأقضية"
"20848","(۲۰۸۴۸) حدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ إبْرَاہِیمَ بن عبد الأعلی ، عن سوید بن غفلۃ قَالَ : الْوَلاَئُ کالنسب لاَ یُبَاعُ ، وَلاَ یُوہَبُ۔","","Musannaf Ibn Abi Shaybah 20848","","","كتاب البيوع والأقضية"
"20849","(۲۰۸۴۹) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْن??ۃَ ، عَنْ عَمْرٍو ، قَالَ : وَہَبَتْ مَیْمُونَۃُ وَلاَئَ سُلَیْمَانَ بْنِ یَسَارٍ لابْنِ عَبَّاسٍ۔","","Musannaf Ibn Abi Shaybah 20849","","","كتاب البيوع والأقضية"
"20850","(۲۰۸۵۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، قَالَ : سَأَلْتُُ إِبْرَاہِیمَ عَن رَجُلٍ أَعْتَقَ رَجُلاً فَانْطَلَقَ الْمُعْتَقُ فَوَالَی غَیْرَہُ ، قَالَ : لَیْسَ لَہُ ذَلِکَ إلاَّ أَنْ یَہَبَہُ الْمُعْتِقُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20850","","","كتاب البيوع والأقضية"
"20851","(۲۰۸۵۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبِی بَکْرِ بْنِ عَمْرِو بْنِ حَزْمٍ ، أَنَّ امْرَأَۃً مِنْ حَاضِرِ مُحَارِبٍ وَہَبَتْ وَلاَئَ عَبْدِہَا لِنَفْسِہِ وَأَعْتَقَہُ فَأَعْتَقَ نَفْسَہُ ، قَالَ : فَوَہَبَ نَفْسَہُ لِعَبْدِ الرَّحْمَنِ بْنِ عَمْرِو بْنِ حَزْمٍ ، قَالَ : وَمَاتَتْ وَخَاصَمَ الْمُوَالی إلَی عُثْمَانَ بْنِ عَفَّانَ فَدَعَا عُثْمَانُ بِالْبَیِّنَۃِ عَلَی مَا قَالَ : فَأَتَاہُ بِالْبَیِّنَۃِ فَقَالَ لَہُ عُثْمَانُ : اذْہَبْ فَوَالِ مَنْ شِئْتَ ، فَوَالَی عَبْدَ الرَّحْمَن بْنَ عَمْرِو بْنِ حَزْمٍ۔","","Musannaf Ibn Abi Shaybah 20851","","","كتاب البيوع والأقضية"
"20852","(۲۰۸۵۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ ، قَالاَ : لاَ بَأْسَ بِبَیْعِ وَلاَئِ السَّائِبَۃِ وَہِبَتِہِ۔","","Musannaf Ibn Abi Shaybah 20852","","","كتاب البيوع والأقضية"
"20853","(۲۰۸۵۳) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، أَنَّ امْرَأَۃً وَہَبَتْ وَلاَئَ مَوَالِیہَا لِزَوْجِہَا ، فَقَالَ ہِشَامُ بْنُ ہُبَیْرَۃَ : أَمَّا أَنَا فَأَرَاہُ لِزَوْجِہَا مَا عَاشَ ، فَإِذَا مَاتَ رَدَدْتُہُ إلَی وَرَثَۃِ الْمَرْأَۃِ۔","","Musannaf Ibn Abi Shaybah 20853","","","كتاب البيوع والأقضية"
"20854","(۲۰۸۵۴) حَدَّثَنَا ہُشَیْمٌ، عَنْ مُغِیرَۃَ، عَنْ إبْرَاہِیمَ، قَالَ: یُکْرَہُ السَّلَفُ فِی الشَّیْئِ الَّذِی لَیْسَ لَہُ فِی أَیْدِی النَّاسِ أَصْلٌ۔q","","Musannaf Ibn Abi Shaybah 20854","","","كتاب البيوع والأقضية"
"20855","(۲۰۸۵۵) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ، عَنْ یَحْیَی بْنِ سَعِیدٍ، عَنْ نَافِعٍ، قَالَ: کَانَ ابْنُ عُمَرَ إذَا سُئِلَ عَنِ الرَّجُلِ یَبْتَاعُ مِنَ الرَّجُلِ شَیْئًا إلَی أَجَلٍ وَلَیْسَ عِنْدَہُ أَصْلُہُ ، لاَ یَرَی بِہِ بَأْسًا ، قَالَ یَحْیَی : وَکَانَ سَعِیدُ بْنُ الْمُسَیَّبِ یَکْرَہُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20855","","","كتاب البيوع والأقضية"
"20856","(۲۰۸۵۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ عِکْرِمَۃَ ، أَنَّہُ کَانَ یَکْرَہُ السَّلَفَ إلاَّ فِی شَیْئٍ عِنْدَہُ أَصْلُہُ ، قَالَ أَیُّوبُ: وَنُبِّئْتُ عَنْ طَاوُوس مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 20856","","","كتاب البيوع والأقضية"
"20857","(۲۰۸۵۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِالسَّلَفِ إلَی أَجَلٍ مَعْلُومٍ ، کَانَ أَصْلُہُ عِنْدَہُ ، أَوْ لَمْ یَکُنْ ، قَالَ : وَکَانَ مُحَمَّدٌ یَکْرَہُ السَّلَفَ إلاَّ فِی شَیْئٍ عِنْدَ صَاحِبِہِ أَصْلُہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20857","","","كتاب البيوع والأقضية"
"20858","(۲۰۸۵۸) حَدَّثَنَا یَحْیَی بْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ یُسْلَمُ فِی شَیْئٍ إلاَّ ومنہ شَیْئٌ فِی أیدی الناس۔","","Musannaf Ibn Abi Shaybah 20858","","","كتاب البيوع والأقضية"
"20859","(۲۰۸۵۹) حَدَّثَنَا شَرِیکٌ ، عَنْ جَابِر ، عَنِ القَاسِم : أن علیًا وشریحًا کانَا یُضَمِّنان الأجیر۔","Da'if","Musannaf Ibn Abi Shaybah 20859","","","كتاب البيوع والأقضية"
"20860","(۲۰۸۶۰) حَدَّثَنَا شَرِیکٌ ، عَنْ سِمَاکٍ ، عَنِ ابْنِ عَبِیدِ بْنِ الأَبْرَصِ ، أَنَّ عَلِیًّا ضَمَّنَ نَجَّارًا۔","Da'if","Musannaf Ibn Abi Shaybah 20860","","","كتاب البيوع والأقضية"
"20861","(۲۰۸۶۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ حَجَّاجٍ ، عَنْ حُصَیْنٍ الْحَارِثِیِّ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، قَالَ : مَنْ أَخَذَ أَجْرًا ، فَہُوَ ضَامِنٌ۔","Da'if","Musannaf Ibn Abi Shaybah 20861","","","كتاب البيوع والأقضية"
"20862","(۲۰۸۶۲) حَدَّثَنَا عَبَّادٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 20862","","","كتاب البيوع والأقضية"
"20863","(۲۰۸۶۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ خَالِدٍ الأَحْوَلِ ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ بْنِ مَسْعُودٍ ، قَالَ : الأَجِیرُ مَضْمُونٌ لَہُ أَجْرُہُ ضَامِنٌ لِمَا اسْتُوْدِعَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20863","","","كتاب البيوع والأقضية"
"20864","(۲۰۸۶۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَخَذَ الأَجِیرُ الْمُشْتَرَکُ شَیْئًا ضَمِنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20864","","","كتاب البيوع والأقضية"
"20865","(۲۰۸۶۵) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ ، قَالَ : کَانَ إذَا اشْتَرَی الشَّیْئَ اسْتَأْجَرَ لَہُ مَنْ یَحْمِلُہُ ، قَالَ الْحَکَمُ : یَضْمَنُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20865","","","كتاب البيوع والأقضية"
"20866","(۲۰۸۶۶) حَدَّثَنَا شَبَابَۃُ بْنُ سَوَّارٍ ، قَالَ : حدَّثَنَا شُعْبَۃُ ، عَنْ مَنْصُورٍ ، عَنْ إِبْرَاہِیمَ ، عَن عَبْدِ الرَّحْمَنِ بْنِ یَزِیدَ بِنَحْوٍ مِنْ حَدِیثِ وَکِیعٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 20866","","","كتاب البيوع والأقضية"
"20867","(۲۰۸۶۷) حَدَّثَنَا أَزْہَرُ السَّمَّانُ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، أَنَّہُ کَانَ لاَ یُضَمِّنُ الأَجِیرَ إلاَّ مِنْ تَضْیِیعٍ۔","","Musannaf Ibn Abi Shaybah 20867","","","كتاب البيوع والأقضية"
"20868","(۲۰۸۶۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : کُلُّ أَجِیرٍ أَخَذَ أَجْرًا ، فَہُوَ ضَامِنٌ إلاَّ مِنْ عَدُوٍّ مُکَابِرٍ ، أَوْ أَجِیرٍ یَدُہُ مَعَ یَدِکَ۔","","Musannaf Ibn Abi Shaybah 20868","","","كتاب البيوع والأقضية"
"20869","(۲۰۸۶۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ إسْمَاعِیلَ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : لَیْسَ عَلَی أَجِیرِ الْمُشَاہَرَۃِ ضَمَانٌ۔","","Musannaf Ibn Abi Shaybah 20869","","","كتاب البيوع والأقضية"
"20870","(۲۰۸۷۰) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ لاَ یُضَمِّنُ الْمَلاَّحَ غَرَقًا ، وَلاَ حَرَقًا۔","","Musannaf Ibn Abi Shaybah 20870","","","كتاب البيوع والأقضية"
"20871","(۲۰۸۷۱) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا حَسَنٌ ، عَنْ مُطَرِّفٍ ، عَنْ صَالِحِ بْنِ دِینَارٍ ، أَنَّ عَلِیًّا رضی اللہ عنہ کَانَ یُضَمِّنُ الأَجِیرَ الْمُشْتَرَکَ۔","Da'if","Musannaf Ibn Abi Shaybah 20871","","","كتاب البيوع والأقضية"
"20872","(۲۰۸۷۲) حَدَّثَنَا وَکِیعٌ حَدَّثَنَا الأَعْمَش ، عَنْ أَبِی الْہَیْثَمِ العَطَّار ، قَالَ : اسْتَأْجَرْتُ حَمَّالاً یَحْمِلُ لِی شَیْئًا فَکَسَرَہُ، فَخَاصَمْتُہُ إلَی شُرَیْحٍ فَضَمَّنَہُ ، وَقَالَ : إنَّمَا اسْتَأْجَرَکَ لِتُبَلِّغَہُ وَلَمْ یَسْتَأْجِرْکَ لِتَکْسِرَہُ۔","","Musannaf Ibn Abi Shaybah 20872","","","كتاب البيوع والأقضية"
"20873","(۲۰۸۷۳) حَدَّثَنَا أَبُو بَکْر ، حدَّثَنَا حَسَنُ بْنُ صَالِحٍ ، عَنْ زُہَیْرٍ الْعَنْسِیّ ، أَنَّ رَجُلاً اسْتَأْجَرَ رَجُلاً یَعْمَلُ عَلَی بَعِیرٍ فَضَرَبَہُ فَفَقَأَ عَیْنَہُ فَخَاصَمَہُ إلَی شُرَیْحٍ فَضَمَّنَہُ ، وَقَالَ : إنَّمَا اسْتَأْجَرَکَ لِتُصْلِحَ وَلَمْ یَسْتَأْجِرْک لِتُفْسِدَ۔","","Musannaf Ibn Abi Shaybah 20873","","","كتاب البيوع والأقضية"
"20874","(۲۰۸۷۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ أَبِی بِشْرٍ ، عَنْ یُوسُفَ بْنِ مَاہَکَ ، عَنْ حَکِیمِ بْنِ حِزَامٍ ، قَالَ : قُلْتُ : یَا رَسُولَ اللہِ، الرَّجُلُ یَأْتِینِی یَسْأَلُنِی الْبَیْعَ لَیْسَ عِنْدِی ما أَبِیعہُ مِنْہُ ، أَبْتَاعُہُ لَہُ مِنَ السُّوقِ ؟ قَالَ : فَقَالَ : لاَ ، لاَ تَبِعْ مَا لَیْسَ عِنْدَکَ۔ (ترمذی ۱۲۳۳۔ ابوداؤد ۳۴۹۷)","","Musannaf Ibn Abi Shaybah 20874","","","كتاب البيوع والأقضية"
"20875","(۲۰۸۷۵) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ أَبِی رَزِینٍ ، قَالَ : قُلْتُ لِمَسْرُوقٍ : یَأْتِینِی الرَّجُلُ یَطْلُبُ مِنِّی السَّمْنَ وَلَیْسَ عِنْدِی أَشْتَرِیہِ ، ثُمَّ أَدْعُوہُ لَہُ ؟ قَالَ : لاَ ، وَلَکِنِ اشْتَرِہِ فَضَعْہُ عِنْدَکَ ، فَإِذَا جَائَکَ فَبِعْہُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 20875","","","كتاب البيوع والأقضية"
"20876","(۲۰۸۷۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَبْدِ الْمَلِکِ بْنِ إیَاسٍ ، أَنَّ عَامِرًا وَإِبْرَاہِیمَ اجْتَمَعَا فَسَأَلَہُمَا عَنْ رَجُلٍ یَطْلُبُ مِنَ الرَّجُلِ الْمَتَاعَ ، وَلَیْسَ عِنْدَہُ فَیَشْتَرِیہِ ، ثُمَّ یَدْعُوہُ إلَیْہِ ، فَقَالَ إبْرَاہِیمُ : یُکْرَہُ ذَلِکَ ، وَقَالَ عَامِرٌ : لاَ بَأْسَ إِنْ شَائَ أَنْ یَتْرُکَہُ تَرَکَہُ۔","","Musannaf Ibn Abi Shaybah 20876","","","كتاب البيوع والأقضية"
"20877","(۲۰۸۷۷) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ یُرِیدُ مِنَ الرَّجُلِ الْبَیْعَ لَیْسَ عِنْدَہُ ، فَإِنْ تَوَاطَآ عَلَی الثمنِ اشْتَرَاہُ ؟ قَالَ : لاَ یَشْتَرِہِ إلاَّ عَلَی غی مُوَاطَأَۃ مِنْ صَاحِبِہِ۔","","Musannaf Ibn Abi Shaybah 20877","","","كتاب البيوع والأقضية"
"20878","(۲۰۸۷۸) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّہُ کَانَ یَکْرَہُ بَیْعَ المراوضۃ : أَنْ تُوَاصِفَ الرَّجُلَ بِالسِّلْعَۃِ لَیْسَتْ عِنْدَکَ ، وَکَرِہَ : الرجل أن یری للرجل الثَّوْبَ لَیْسَ لہ فیَقُولَ مِنْ حَاجَتِکَ ہَذَا ؟ یَشْتَرِیہِ لِیَبِیعَہُ مِنْہُ۔","","Musannaf Ibn Abi Shaybah 20878","","","كتاب البيوع والأقضية"
"20879","(۲۰۸۷۹) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَکَمِ بْنِ أَبِی الْفَضْلِ ، قَالَ : قُلْتُ لِلْحَسَنِ : یَأْتِینِی الرَّجُلُ فَیُسَاوِمُنِی بِالْحَرِیرِ لَیْسَ عِنْدِی ، قَالَ : فَآتِی السُّوق ، ثُمَّ أَبِیعُہُ ، قَالَ : ہَذِہِ الْمُوَاصَفَۃُ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 20879","","","كتاب البيوع والأقضية"
"20880","(۲۰۸۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ شَرِیکٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : اشْتَرَی رَجُلٌ مِنْ رَجُلٍ طَعَامًا ، بَعْضُہُ عِنْدَہُ وَبَعْضُہُ لَیْسَ عِنْدَہُ ، فَسَأَلَ ابْنَ عَبَّاسٍ ، وَابْنَ عُمَر ، فَقَالاَ : مَا کَانَ عِنْدَہُ ، فَہُوَ جَائِزٌ ، وَمَا کَانَ لَیْسَ عِنْدَہُ فَلَیْسَ بِشَیْئٍ۔","Sahih","Musannaf Ibn Abi Shaybah 20880","","","كتاب البيوع والأقضية"
"20881","(۲۰۸۸۱) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَہْضَمِ بْنِ عَبْدِ اللہِ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاہِیمَ ، عَن مُحَمَّدِ بْنِ زَیْدٍ ، عَنْ شَہْرِ بْنِ حَوْشَبٍ ، عَنْ أَبِی سَعِیدٍ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ شِرَائِ مَا فِی بُطُونِ الأَنْعَامِ حَتَّی تَضَعَ ، وَعَمَّا فِی ضُرُوعِہَا إلاَّ بِکَیْلٍ ، وَعَنْ شِرَائِ الْعَبْدِ وَہُوَ آبِقٌ ، وَعَنْ شِرَائِ الْمَغَانِمِ حَتَّی تُقْسَمَ ، وَعَنْ شِرَائِ الصَّدَقَاتِ حَتَّی تُقْبَضَ ، وَعَنْ ضَرْبَۃِ الْغَائِصِ۔","Da'if","Musannaf Ibn Abi Shaybah 20881","","","كتاب البيوع والأقضية"
"20882","(۲۰۸۸۲) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عِکْرِمَۃَ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : لاَ تَبَایَعُوا الصُّوفَ عَلَی ظُہُورِ الْغَنَمِ ، وَلاَ اللَّبَنَ فِی الضُّرُوعِ۔","Sahih","Musannaf Ibn Abi Shaybah 20882","","","كتاب البيوع والأقضية"
"20883","(۲۰۸۸۳) حَدَّثَنَا ابْنُ الْمُبَارَکِ ، عَنْ یَحْیَی بْنِ بِشْرٍ أَنَّہُ سَمِعَ عِکْرِمَۃَ یَقُولُ : لاَ تَشْتَرِی الْغَرَرَ مِنَ الدَّابَّۃِ الضَّالَّۃِ ، وَلاَ الْعَبْدِ الآبِقِ ، فَإِنَّک لاَ تَدْرِی لَعَلَّکَ لاَ تَجِدُہُمَا أَبَدًا ، وَیُؤْکَلُ رَأْسُ مَالِکَ بَاطِلاً۔","","Musannaf Ibn Abi Shaybah 20883","","","كتاب البيوع والأقضية"
"20884","(۲۰۸۸۴) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ ، عَنْ أَبِی الزِّنَادِ ، عَنِ الأَعْرَجِ ، عَنْ أَبِی ہُرَیْرَۃَ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ بَیْعِ الْغَرَرِ۔ (مسلم ۱۱۵۳۔ ابوداؤد ۳۳۶۹)q","Sahih","Musannaf Ibn Abi Shaybah 20884","","","كتاب البيوع والأقضية"
"20885","(۲۰۸۸۵) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ ، عَنْ سنان بْنِ سَلَمَۃَ ، أَنَّ رَجُلاً اشْتَرَی مِنْ رَجُلٍ عَبْدًا آبِقًا فَرَدَّ الْبَیْعَ۔","Da'if","Musannaf Ibn Abi Shaybah 20885","","","كتاب البيوع والأقضية"
"20886","(۲۰۸۸۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا مُوسَی بْنُ عُبَیْدَۃَ ، عَنْ عَبْدِ اللہِ بْنِ دِینَارٍ ، عَنِ ابْنِ عُمَرَ قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ بَیْعِ الْغَرَرِ۔ (احمد ۱۴۴۔ ابن حبان ۴۹۷۲)","Da'if","Musannaf Ibn Abi Shaybah 20886","","","كتاب البيوع والأقضية"
"20887","(۲۰۸۸۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا ابْنُ أَبِی لَیْلَی ، عَنِ الشَّعْبِیِّ ، قَالَ : نَہَی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، عَنْ بَیْعِ الْغَرَرِ۔","Da'if","Musannaf Ibn Abi Shaybah 20887","","","كتاب البيوع والأقضية"
"20888","(۲۰۸۸۸) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانُوا یَکْرَہُونَ بَیْعَ الْغَرَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20888","","","كتاب البيوع والأقضية"
"20889","(۲۰۸۸۹) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ وَالشَّعْبِیِّ ، قَالاَ : لاَ یَجُوزُ بَیْعُہُ حَتَّی یَعْلَمَ الْبَائِعُ مَا یَعْلَمُ الْمُشْتَرِی۔","No Data Available","Musannaf Ibn Abi Shaybah 20889","","","كتاب البيوع والأقضية"
"20890","(۲۰۸۹۰) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : أَتَی رَجُلٌ شُرَیْحًا فَقَالَ : إنَّ لِی عَبْدًا آبِقًا وَإِنَّ رَجُلاً یُسَاوِمُنِی بِہِ فَأَبِیعُہُ مِنْہُ ؟ قَالَ نَعَمْ ، فَإِنَّکَ إذَا رَأَیْتَہُ فَأَنْتَ بِالْخِیَارِ ، فَإِنْ شِئْتَ أَجَزْتَ الْبَیْعَ ، وَإِنْ شِئْتَ لَمْ تُجِزْہُ۔","","Musannaf Ibn Abi Shaybah 20890","","","كتاب البيوع والأقضية"
"20891","(۲۰۸۹۱) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ، عَنِ الشَّعْبِیِّ، قَالَ: إذَا أَعْلَمَہُ مِنْہُ مَا کَانَ یَعْلَمُ مِنْہُ جَازَ بَیْعُہُ وَلَمْ یَکُنْ لَہُ خِیَارٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 20891","","","كتاب البيوع والأقضية"
"20892","(۲۰۸۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ اشْتَرَی عَبْدًا آبِقًا وَجَدَہُ ، أَوْ لَمْ یَجِدْہُ ، فَکَرِہَہُ ، وَقَالَ : ہُوَ غَرَرٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 20892","","","كتاب البيوع والأقضية"
"20893","(۲۰۸۹۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : لاَ أَعْلَمُ بِبَیْعِ الْغَرَرِ بَأْسًا۔","No Data Available","Musannaf Ibn Abi Shaybah 20893","","","كتاب البيوع والأقضية"
"20894","(۲۰۸۹۴) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ، عَنْ عُبَیْدِ اللہِ بْنِ عُمَرَ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ اشْتَرَی بَعِیرًا وَہُوَ شَارِدٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20894","","","كتاب البيوع والأقضية"
"20895","(۲۰۸۹۵) حَدَّثَنَا أَبُو سعد ، عَنِ ابْنِ جُرَیْجٍ ، عَنِ ابْن طَاوُوس ، عَنْ أَبِیہِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَشْتَرِیَ الرَّجُلُ الدَّابَّۃَ الْغَائِبَۃَ إذَا کَانَ قَدْ رَآہَا وَیَقُولُ : إِنْ کَانَتْ صَحِیحَۃً فَہِیَ لِی۔","","Musannaf Ibn Abi Shaybah 20895","","","كتاب البيوع والأقضية"
"20896","(۲۰۸۹۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، أَنَّ النَّاسَ قَالُوا : لَیْتَنَا قَدْ رَأَیْنَا بَیْنَ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ وَبین عُثْمَانَ بَیْعًا ، حَتَّی نَنْظُرَ أَیُّہُمَا أَعْظَمُ جَدًّا فِی التِّجَارَۃِ ، فَاشْتَرَی عَبْدُ الرَّحْمَنِ مِنْ عُثْمَانَ أَفْرَاسًا بِأَرْبَعِینَ أَلْفًا ، وَاشْتَرَطَ عَلَیْہِ إِنْ کَانَتِ الصَّفْقَۃُ أَدْرَکَتْہَا وَہِیَ حَیَّۃٌ مَجْمُوعَۃٌ إلَی الرَّاعِی لَیْسَتْ بِضَالَّۃٍ ، فَقَدْ وَجَبَ الْبَیْعُ ، ثُمَّ جَاوَزَ شَیْئًا فَقَالَ عَبْدُ الرَّحْمَنِ : مَا صَنَعْتُ ؟ فَرَجَعَ إلَیْہِ فَقَالَ : أَزِیدُک سِتَّۃَ آلاَفٍ عَلَی إِنْ أَدْرَکَہَا الرَّسُولُ وَہِیَ حَیَّۃٌ فَعَلَیَّ ، فَأَدْرَکَہَا الرَّسُولُ وَقَدْ نَفَقَتْ ، فَخَرَجَ عَبْدُ الرَّحْمَنِ مِنَ الضَّمَانِ بِالشَّرْطِ الآخِرِ۔","Sahih","Musannaf Ibn Abi Shaybah 20896","","","كتاب البيوع والأقضية"
"20897","(۲۰۸۹۷) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ ہِشَامٍ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِبَیْعِ الْغَرَرِ إذَا کَانَ عِلْمُہُمَا فِیہِ سَوَائً۔","No Data Available","Musannaf Ibn Abi Shaybah 20897","","","كتاب البيوع والأقضية"
"20898","(۲۰۸۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نَہَی عَنْ بَیْعِ الْغَرَرِ۔n(عبدالرزاق ۱۴۵۰۷)","","Musannaf Ibn Abi Shaybah 20898","","","كتاب البيوع والأقضية"
"20899","(۲۰۸۹۹) حَدَّثَنَا علی بن ہاشم ، عن إسماعیل ، عن الحسن وقتادۃ ، عن الحسن أن النبی صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ نہی عن بیع الغرر۔","Hasan","Musannaf Ibn Abi Shaybah 20899","","","كتاب البيوع والأقضية"
"20900","(۲۰۹۰۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، قَالَ : سَأَلْتُ عَطَائً : أَکَانَ ابْنُ عُمَرَ یَطَأُ مُدَبَّرَتَہُ ؟ فَقَالَ : نَعَمْ ، وَابْنُ عَبَّاسٍ۔","Sahih","Musannaf Ibn Abi Shaybah 20900","","","كتاب البيوع والأقضية"
"20901","(۲۰۹۰۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عن سعید ، عَنْ مُطَرِّفٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : إذَا دَبَّرَ الرَّجُلُ مَمْلُوکَتَہُ فَلَہُ أَنْ یَطَأَہَا۔","","Musannaf Ibn Abi Shaybah 20901","","","كتاب البيوع والأقضية"
"20902","(۲۰۹۰۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : لَہُ أَنْ یَطَأَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20902","","","كتاب البيوع والأقضية"
"20903","(۲۰۹۰۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا أَنْ یَطَأَ الرَّجُلُ مُدَبَّرَتَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20903","","","كتاب البيوع والأقضية"
"20904","(۲۰۹۰۴) حدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ وَطَاوُسٍ : لَمْ یَرَیا بَأْسًا أَنْ تُوطَأَ الْمُعْتَقَۃُ عَنْ دُبُرٍ۔","","Musannaf Ibn Abi Shaybah 20904","","","كتاب البيوع والأقضية"
"20905","(۲۰۹۰۵) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامٍ، عَنِ الْحَسَنِ، وَابْنِ سِیرِینَ أَنَّہُمَا کَانَا لاَ یَرَیَانِ بَأْسًا أَنْ یُعْتِقَ الرَّجُلُ أَمَتَہُ، عَنْ دُبُرٍ، ثُمَّ یَطَأَہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20905","","","كتاب البيوع والأقضية"
"20906","(۲۰۹۰۶) حَدَّثَنَا وَکِیعٌ ، عَنْ حَنْظَلَۃَ ، عَنِ الْقَاسِمِ ، قَالَ : لاَ بَأْسَ أَنْ یَسْتَمْتِعَ الرَّجُلُ مِنْ مُدَبَّرَتِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20906","","","كتاب البيوع والأقضية"
"20907","(۲۰۹۰۷) حَدَّثَنَا وَکِیعٌ ، عَنْ زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، قَالَ : لاَ بَأْسَ أَنْ یَقَعَ عَلَیْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20907","","","كتاب البيوع والأقضية"
"20908","(۲۰۹۰۸) حَدَّثَنَا عَبْدُ الْوَہَّابِ بْنُ عَطَائٍ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ بُرْدٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ کَرِہَ أَنْ یَغْشَی الرَّجُلُ أَمَتَہُ وَقَدْ أَعْتَقَہَا عَنْ دُبُرٍ۔","","Musannaf Ibn Abi Shaybah 20908","","","كتاب البيوع والأقضية"
"20909","(۲۰۹۰۹) حَدَّثَنَا عِیسَی بْنُ یُونُسَ وَحَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُثْمَانَ بْنِ حَکِیمٍ ، قَالَ : سَأَلْتُ سَالِمَ بْنَ عَبْدِ اللہِ أَیَطَأُ الرَّجُلُ مُدَبَّرَتَہُ ؟ فَقَالَ : ہِیَ عِنْدِی الآنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20909","","","كتاب البيوع والأقضية"
"20910","(۲۰۹۱۰) حَدَّثَنَا عَبْدُ اللہِ بْنُ الْمُبَارَکِ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : إذَا تُوُفِّیَ الرَّجُلُ وَعَلَیْہِ صَدَاقُ امْرَأَتِہِ ، فَہِیَ أُسْوَۃُ الْغُرَمَائِ ، فَإِنْ کَانَ فِی بَیْتِہِ زَیْتٌ ، أَوْ قَمْحٌ ، أَوْ غَیْرُ ذَلِکَ ، فَہُوَ لِلْوَرَثَۃِ إلاَّ أَنْ یَکُونَ سَمَّاہُ لِلَّتِی دَخَلَ بِہَا وَہُوَ صَحِیحٌ۔","Hasan","Musannaf Ibn Abi Shaybah 20910","","","كتاب البيوع والأقضية"
"20911","(۲۰۹۱۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ سَوَادَۃَ بْنِ زِیَادٍ وَعَمْرِو بْنِ مُہَاجِرٍ ، أَنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ کَتَبَ إلَی الْوُلاَۃِ فِی الدَّیْنِ وَمُہُورِ النِّسَائِ أَنَّہُنَّ أُسْوَۃُ الْغُرَمَائِ۔","","Musannaf Ibn Abi Shaybah 20911","","","كتاب البيوع والأقضية"
"20912","(۲۰۹۱۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ فِی النَّفَرِ یُکَاتِبُونَ جَمِیعًا فَیَمُوتُ بَعْضُہُمْ ، قَالَ : یَسْعَی الْبَاقُونَ فِیمَا کَاتَبُوا عَلَیْہِ جَمِیعًا۔","","Musannaf Ibn Abi Shaybah 20912","","","كتاب البيوع والأقضية"
"20913","(۲۰۹۱۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، قَالَ : سَأَلْتُ عَمْرًا : مَا کَانَ الْحَسَنُ یَقُولُ ؛ فِی الرَّجُلِ کَاتَبَ مَمَالِیکَہُ جَمِیعًا فَیَمُوتُ بَعْضُہُمْ ، قَالَ : یَرْفَعُ عَنْہُمْ بِالْحِصَّۃِ۔","","Musannaf Ibn Abi Shaybah 20913","","","كتاب البيوع والأقضية"
"20914","(۲۰۹۱۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَشْعَثِ ، عَنِ الشَّعْبِیِّ فِی رَجُلٍ کَاتَبَ عَبْدَیْنِ لَہُ فَمَاتَ أَحَدُہُمَا قَالَ : یَرْفَعُ عَنْہُ بِالْحِصَّۃِ۔","","Musannaf Ibn Abi Shaybah 20914","","","كتاب البيوع والأقضية"
"20915","(۲۰۹۱۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ ابْنِ أَبِی غَنِیَّۃَ ، عَنِ الْحَکَمِ ؛ فِی الرَّجُلِ یُکَاتِبُ أَہْلَ الْبَیْتِ جَمِیعًا فَیَمُوتُ بَعْضُہُمْ ، قَالَ : یَرْفَعُ بِالْحِصَّۃِ۔","","Musannaf Ibn Abi Shaybah 20915","","","كتاب البيوع والأقضية"
"20916","(۲۰۹۱۶) حَدَّثَنَا أَبُو بَکْرِ بْنُ عَیَّاشٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ فِی رَجُلٍ اشْتَرَی جَارِیَۃً فَوَلَدَتْ مِنْہُ أَوْلاَدًا ، ثُمَّ أَقَامَ الرَّجُلُ الْبَیِّنَۃَ أَنَّہَا لَہُ ، قَالَ : تُرَدُّ عَلَیْہِ وَیُقَوَّمُ عَلَیْہِ وَلَدُہَا فَیُغَرَّمُ الَّذِی بَاعَہَا بِمَا عَزَّ وَہَانَ۔","Sahih","Musannaf Ibn Abi Shaybah 20916","","","كتاب البيوع والأقضية"
"20917","(۲۰۹۱۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ وَجَدَ أَمَتَہُ عِنْدَ رَجُلٍ اشْتَرَاہَا وَقَدْ وَلَدَتْ مِنْہُ ، قَالَ : یَأْخُذُہا وَیَأْخُذُ قِیمَۃَ الْوَلَدِ مِنْ أَبِیہِمْ وَیُہْضَمُ عَنْہُم مِنَ الْقِیمَۃِ شَیْئٌ۔","","Musannaf Ibn Abi Shaybah 20917","","","كتاب البيوع والأقضية"
"20918","(۲۰۹۱۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ أَبُو مَیْسَرَۃَ : مَکَانَ کُلِّ وَصِیْفٍ وَصِیفٌ فَرِیضَۃً قَدْ حَلبَا وصرَّا۔","","Musannaf Ibn Abi Shaybah 20918","","","كتاب البيوع والأقضية"
"20919","(۲۰۹۱۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الحسن قَالَ : مَکَانَ کل وصیف وصیفٌ۔","","Musannaf Ibn Abi Shaybah 20919","","","كتاب البيوع والأقضية"
"20920","(۲۰۹۲۰) حَدَّثَنَا ہُشَیْمٌ ، عن مُحَمَّدِ بْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : قُلْتُ لَہُ : مَتَی یُقَوَّمُ الْوَلَدُ ؟ قَالَ : یَوْمَ وُلِدُوا۔","","Musannaf Ibn Abi Shaybah 20920","","","كتاب البيوع والأقضية"
"20921","(۲۰۹۲۱) حَدَّثَنَا أَبُو الأَحْوَص ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، قَالَ : کَتَبَ إلَیَّ ابْنُ عَبَّاسٍ أَنْ ضَمِّنِ الْعَارِیَّۃَ إِنْ شَائَ صَاحِبُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 20921","","","كتاب البيوع والأقضية"
"20922","(۲۰۹۲۲) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ سَوَادَۃَ بْنِ زِیَادٍ ، قَالَ : کَتَبْتُ إلَی عُمَرَ بْنِ عَبْدِ الْعَزِیزِ فِی امْرَأَۃٍ اسْتَعَارَتْ حَلْیًا لِعُرْسٍ فَہَلَکَ الْحَلْیُ، فَکَتَبَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ: لاَ ضَمَانَ عَلَیْہَا إلاَّ أَنْ تَکُونَ بَغتہ غَائِلَۃً۔","","Musannaf Ibn Abi Shaybah 20922","","","كتاب البيوع والأقضية"
"20923","(۲۰۹۲۳) حدثنا عبد الوہاب الثقفی ، عن داود ، عن عمر بن عبد العزیز ، أنہ کان یضمن العاریۃ۔","","Musannaf Ibn Abi Shaybah 20923","","","كتاب البيوع والأقضية"
"20924","(۲۰۹۲۴) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، أَنَّ عَلِیًّا ، قَالَ فِی الْعَارِیَّۃِ : ہُوَ مُؤْتَمَنٌ۔","","Musannaf Ibn Abi Shaybah 20924","","","كتاب البيوع والأقضية"
"20925","(۲۰۹۲۵) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ شِبَاک ، قَالَ : اسْتَعَارَتِ امْرَأَۃٌ خَوَاتِیمَ فَأَرَادَتْ أَنْ تَوَضَّأَ فَوَضَعَتْہَا فِی حِجْرِہَا فَضَاعَتْ ، فَارْتَفَعُوا إلَی شُرَیْحٍ فَقَالَ : إنَّمَا اسْتَعَارَتْ لِتَرُدَّہَا فَخَالَفَتْ ، فَضَمَّنَہَا شُرَیْحٌ۔","","Musannaf Ibn Abi Shaybah 20925","","","كتاب البيوع والأقضية"
"20926","(۲۰۹۲۶) حَدَّثَنَا جَرِیرٌ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : لَیْسَ عَلَی الْمُسْتَکْرِی وَالْمُسْتَعِیرِ ضَمَانٌ إلاَّ أَنْ یُخَالِفَا۔","","Musannaf Ibn Abi Shaybah 20926","","","كتاب البيوع والأقضية"
"20927","(۲۰۹۲۷) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ وَحَمَّادٍ أَنَّہُمَا کَانَا لاَ یُضَمِّنَانِ الْمُسْتَعِیرَ۔","","Musannaf Ibn Abi Shaybah 20927","","","كتاب البيوع والأقضية"
"20928","(۲۰۹۲۸) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، قَالَ : إذَا خَالَفَ صَاحِبَ الْعَارِیَّۃِ ضَمِنَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20928","","","كتاب البيوع والأقضية"
"20929","(۲۰۹۲۹) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَطَائٍ ، قَالَ : الْعَارِیَّۃُ مَضْمُونَۃٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 20929","","","كتاب البيوع والأقضية"
"20930","(۲۰۹۳۰) حَدَّثَنَا وَکِیعٌ ، عَنِ ابْنِ جُرَیْجٍ ، وَمحمد بْنِ شَرِیکٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، أَنَّ ابْنَ عَبَّاسٍ کَانَ یُضَمِّنُ الْعَارِیَّۃَ ، وَزَادَ ابْنُ جُرَیْجٍ : إذَا تبعہا صَاحِبُہَا۔","Sahih","Musannaf Ibn Abi Shaybah 20930","","","كتاب البيوع والأقضية"
"20931","(۲۰۹۳۱) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ صَالِحٍ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ مُحَمَّدِ بْنِ الْحَنَفِیَّۃِ ، عَنْ عَلِیٍّ ، قَالَ : الْعَارِیَّۃُ لَیْسَتْ ببَیْعٍ ، وَلاَ مَضْمُونَۃً ، إنَّمَا ہُوَ مَعْرُوفٌ إلاَّ أَنْ یُخَالِفَ فَیُضَمَّنُ۔","Sahih","Musannaf Ibn Abi Shaybah 20931","","","كتاب البيوع والأقضية"
"20932","(۲۰۹۳۲) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ اسْتَعَارَ مِنْ رَجُلٍ فَرَسًا فَرَکَضَہُ حَتَّی مَاتَ ، قَالَ : لَیْسَ عَلَیْہِ ضَمَانٌ لأَنَّ الرَّجُلَ یَرْکُضُ فَرَسَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20932","","","كتاب البيوع والأقضية"
"20933","(۲۰۹۳۳) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إسْرَائِیلَ ، عَنْ أَبِی إِسْحَاقَ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، أَنَّہُ کَانَ یُضَمِّنُ الْعَارِیَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20933","","","كتاب البيوع والأقضية"
"20934","(۲۰۹۳۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عن مبارک عَنِ الْحَسَنِ ، قَالَ : إذَا اسْتَعَارَ دَابَّۃً فَأَکْرَاہَا ضَمِنَ۔","","Musannaf Ibn Abi Shaybah 20934","","","كتاب البيوع والأقضية"
"20935","(۲۰۹۳۵) حَدَّثَنَا جَرِیرٌ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنْ أُنَاسٍ مِنْ آلِ عَبْدِ اللہِ بْنِ صَفْوَانَ ، أَنَّ صَفْوَانَ ہَرَبَ مِنْ رَسُولِ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَأَرْسَلَ إلَیْہِ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فأمَّنَہُ وَأَسْلَمَ ، وَکَانَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یُرِیدُ حُنَیْنًا فَقَالَ : یَا صَفْوَانُ ، ہَلْ لَکَ مِنْ سِلاَحٍ ؟ قَالَ : عَارِیَّۃً أَمْ غَصْبًا؟ قَالَ : لاَ ، بَلْ عَارِیَّۃً ، فَأَعَارَہُ مَا بَیْنَ الثَّلاَثِینَ إلَی الأَرْبَعِینَ دِرْعًا ، وَغَزَا رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حُنَیْنًا ، فَلَمَّا ہَزَمَ المُشرکین جُمِعَتْ دُرُوعُ صَفْوَانَ ، فَفَقَدَ مِنْہَا أَدْرَاعًا ، فَقَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : یَا صَفْوَانُ ، إنَّا فَقَدْنَا مِنْ أَدْرَاعِکَ أَدْرَاعًا فَہَلْ نَغْرَمُ لَکَ ؟ فَقَالَ : لاَ یَا رَسُولَ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، إنَّ فِی قَلْبِی الْیَوْمَ مَا لَمْ یَکُنْ۔ (ابوداؤد ۳۵۵۸۔ احمد ۳/۴۰۱)","","Musannaf Ibn Abi Shaybah 20935","","","كتاب البيوع والأقضية"
"20936","(۲۰۹۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَا ضَمَّنَ شُرَیْحٌ عَارِیَّۃً إلاَّ امْرَأَۃً اسْتَعَارَتْ خَاتَمًا فَوَضَعَتْہُ فِی مَغْسَلِہَا فَحَلَّتْ فَضَمَّنَہَا۔","","Musannaf Ibn Abi Shaybah 20936","","","كتاب البيوع والأقضية"
"20937","(۲۰۹۳۷) حَدَّثَنَا وَکِیعٌ، قَالَ: حدَّثَنَا إسْرَائِیلُ ، عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ شُرَیْحٍ ، أَنَّہُ کَانَ یُضَمِّنُ الْعَارِیَّۃَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20937","","","كتاب البيوع والأقضية"
"20938","(۲۰۹۳۸) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : کَانَ شُرَیْحٌ لاَ یُضَمِّنُ الْعَارِیَّۃَ وَالْوَدِیعَۃَ حَتَّی أَمَرَہُ زِیَادٌ ، قَالَ : فَقُلْتُ لَہُ : فَکَیْفَ کَانَ یَصْنَعُ ذَلِکَ ؟ قَالَ : مَا زَالَ یُضَمِّنُہَا حَتَّی مَاتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20938","","","كتاب البيوع والأقضية"
"20939","(۲۰۹۳۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ السَّائِب ، أَنَّ رَجُلاً اسْتَعَارَ مِنْ رَجُلٍ بَعِیرًا فَعَطِبَ الْبَعِیرُ فَسَأَلَ مَرْوَانُ أَبَا ہُرَیْرَۃَ فَقَالَ : یَضْمَنُ۔","Da'if","Musannaf Ibn Abi Shaybah 20939","","","كتاب البيوع والأقضية"
"20940","(۲۰۹۴۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ شُرَحْبِیلَ بْنِ مُسْلِمٍ الْخَوْلاَنِیِّ ، قَالَ : سَمِعْتُ أَبَا أُمَامَۃَ الْبَاہِلِیَّ ، قَالَ: سَمِعْتُ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ یَقُولُ فِی حَجَّۃِ الْوَدَاعِ : الْعَارِیَّۃُ مُؤَدَّاۃٌ ، وَالدَّیْنُ مُؤَدًّی ، وَالزَّعِیمُ غَارِمٌ یَعْنِی الْکَفِیلَ۔ (ترمذی ۱۲۶۵۔ ابوداؤد ۴۵۶۰)","Hasan","Musannaf Ibn Abi Shaybah 20940","","","كتاب البيوع والأقضية"
"20941","(۲۰۹۴۱) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، عَنْ سَمُرَۃَ ، عَنِ النَّبِیِّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ ، قَالَ : عَلَی الْیَدِ مَا أَخَذَتْ حَتَّی تُؤَدِّیَہُ۔ (ابوداؤد ۳۵۵۶۔ احمد ۸)","Hasan","Musannaf Ibn Abi Shaybah 20941","","","كتاب البيوع والأقضية"
"20942","(۲۰۹۴۲) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ: الْمُکَاتَبُ عَبْدٌ مَا بَقِیَ عَلَیْہِ دِرْہَمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20942","","","كتاب البيوع والأقضية"
"20943","(۲۰۹۴۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : الْمُکَاتَبُ عَبْدٌ مَا بَقِیَ عَلَیْہِ مِنْ کِتَابَتِہِ دِرْہَمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20943","","","كتاب البيوع والأقضية"
"20944","(۲۰۹۴۴) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، وَعَنْ سُفْیَانَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ مُجَاہِدٍ ، عَنْ زَیْدٍ، قَالَ : قَالَ : الْمُکَاتَبُ عَبْدٌ مَا بَقِیَ عَلَیْہِ دِرْہَمٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20944","","","كتاب البيوع والأقضية"
"20945","(۲۰۹۴۵) حَدَّثَنَا أَبُو خالد الأحمر ، عن ابن أبی عروبۃ ، عن قتادۃ ، عن معبد الجہنی ، عن عمر ، قَالَ : الْمُکَاتَبُ عَبْدٌ مَا بَقِیَ عَلَیْہِ دِرْہَمٌ۔","","Musannaf Ibn Abi Shaybah 20945","","","كتاب البيوع والأقضية"
"20946","(۲۰۹۴۶) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ سُلَیْمَانَ التیمی ، عن رجل ، قَالَ : قَالَ عمر : الْمُکَاتَبُ عَبْدٌ مَا بَقِیَ عَلَیْہِ دِرْہَمٌ۔","Da'if","Musannaf Ibn Abi Shaybah 20946","","","كتاب البيوع والأقضية"
"20947","(۲۰۹۴۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ عَمْرِو بْنِ مَیْمُونٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، قَالَ : اسْتَأْذَنْتُ عَلَی عَائِشَۃَ ، فَقَالَتْ : سُلَیْمَانُ ؟ فَقُلْتُ : سُلَیْمَانُ ، فَقَالَتْ : أَدَّیْت مَا بَقِیَ عَلَیْکَ مِنْ کِتَابَتِکَ التی قَاطَعْت أہلک عَلَیْہَا ، قُلْتُ : نَعَمْ ، إلاَّ شَیْئًا یَسِیرًا قَالَتْ : ادْخُلْ فَإِنَّکَ عَبْدٌ مَا بَقِیَ عَلَیْکَ شَیْئٌ۔","Sahih","Musannaf Ibn Abi Shaybah 20947","","","كتاب البيوع والأقضية"
"20948","(۲۰۹۴۸) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : کَانَتْ أُمَّہَاتُ الْمُؤْمِنِینَ لاَ یَحْتَجِبْنَ مِنَ الْمُکَاتَبِ مَا بَقِیَ عَلَیْہِ مِنْ مُکَاتَبَتِہِ مِثْقَالٌ ، أَوْ دِینَارٌ۔","Da'if","Musannaf Ibn Abi Shaybah 20948","","","كتاب البيوع والأقضية"
"20949","(۲۰۹۴۹) حَدَّثَنَا وَکِیعٌ ، عَنْ جَعْفَرِ بْنِ بُرْقَانَ ، عَنْ مَیْمُونٍ ، أَنَّ عَائِشَۃَ قَالَتْ لِمُکَاتَبٍ لَہَا یُکْنَی أَبَا مَرْیَمَ : ادْخُلْ، وَإِنْ لَمْ یَبْقَ عَلَیْک إلاَّ أَرْبَعَۃُ دَرَاہِمَ۔","Sahih","Musannaf Ibn Abi Shaybah 20949","","","كتاب البيوع والأقضية"
"20950","(۲۰۹۵۰) حَدَّثَنَا وَکِیعٌ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ، عَنْ یَحْیَی، عَنْ عِکْرِمَۃَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: حدُّ الْمُکَاتَبِ حَدُّ الْمَمْلُوکِ۔","Sahih","Musannaf Ibn Abi Shaybah 20950","","","كتاب البيوع والأقضية"
"20951","(۲۰۹۵۱) حَدَّثَنَا عبدۃ بْنُ سُلَیْمَانَ ، عَنْ صَالِحِ بْنِ حَیٍّ ، عَنِ الشَّعْبِیِّ ، قَالَ : حدُّ الْمُکَاتَبِ حَدُّ الْمَمْلُوکِ مَا بَقِیَ عَلَیْہِ دِرْہَمٌ۔","","Musannaf Ibn Abi Shaybah 20951","","","كتاب البيوع والأقضية"
"20952","(۲۰۹۵۲) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ معمر ، عن الزہری ، قَالَ : الْمُکَاتَبُ عَبْدٌ مَا بَقِیَ عَلَیْہِ دِرْہَمٌ۔","","Musannaf Ibn Abi Shaybah 20952","","","كتاب البيوع والأقضية"
"20953","(۲۰۹۵۳) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ إسْرَائِیلَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَن عُثْمَانَ ، قَالَ : الْمُکَاتَبُ عَبْدٌ مَا بَقِیَ عَلَیْہِ دِرْہَمٌ۔","","Musannaf Ibn Abi Shaybah 20953","","","كتاب البيوع والأقضية"
"20954","(۲۰۹۵۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ عَبَّادِ بْنِ مَنْصُورٍ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاہِیمَ ، عَنْ عُثْمَانَ قَالَ : الْمُکَاتب عَبْدٌ مَا بَقِیَ عَلَیْہِ دِرْہَمٍ۔","","Musannaf Ibn Abi Shaybah 20954","","","كتاب البيوع والأقضية"
"20955","(۲۰۹۵۵) حَدَّثَنَا زَیْدُ بْنُ حباب ، عَنْ دَاوُدَ بْنِ أَبِی الْفُرَاتِ ، عَنْ إبْرَاہِیمَ الصَّائِغِ ، عَنْ عَطَائٍ ، وَعَبْدِ اللہِ بْنِ عُبَیْدِ بْنِ عُمَیْرٍ ، وَنَافِعٍ قَالُوا : الْمُکَاتَبُ عَبْدٌ مَا بَقِیَ عَلَیْہِ دِرْہَمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 20955","","","كتاب البيوع والأقضية"
"20956","(۲۰۹۵۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، قَالَ : قَالَ عَبْدُ اللہِ : إذَا أَدَّی الْمُکَاتَبُ مِنْ رَقَبَتِہِ فَلاَ رَدَّ عَلَیْہِ فِی الرِّقِّ۔","","Musannaf Ibn Abi Shaybah 20956","","","كتاب البيوع والأقضية"
"20957","(۲۰۹۵۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَش ، عَنْ إبْرَاہِیمَ ، وَعَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ ، قَالاَ : قَالَ عَبْدُ اللہِ : إذَا أَدَّی الْمُکَاتَبُ ثُلُثَ مُکَاتَبَتِہِ ، فَہُوَ غَرِیمٌ۔","","Musannaf Ibn Abi Shaybah 20957","","","كتاب البيوع والأقضية"
"20958","(۲۰۹۵۸) حَدَّثَنَا عبدۃ بن سلیمان ، عن ہشام بن عروۃ ، عن أبیہ ، قَالَ : إذا أدی المکاتب شطر مکاتبتہ فہو غریم یتبع۔","","Musannaf Ibn Abi Shaybah 20958","","","كتاب البيوع والأقضية"
"20959","(۲۰۹۵۹) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُرْوَۃَ ، أَنَّ مَرْوَانَ کَانَ یَقْضِی إذَا أَدَّی الْمُکَاتَبُ نِصْفَ مُکَاتَبَتِہِ ، فَہُوَ دَیْنٌ یُتْبَعُ بِہِ ، فَذَکَرْتُ ذَلِکَ لِعَبْدِ الْمَلِکِ بْنِ مَرْوَانَ فَأَبَی أَنْ یَأْخُذَ بِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20959","","","كتاب البيوع والأقضية"
"20960","(۲۰۹۶۰) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ وَحَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْقَاسِمِ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : قَالَ عُمَرُ : إنَّکُمْ تُکَاتِبُونَ مُکَاتَبِینَ ، فَإِذَا أَدَّی النِّصْفَ فَلاَ رَدَّ عَلَیْہِ فِی الرِّقِّ۔","","Musannaf Ibn Abi Shaybah 20960","","","كتاب البيوع والأقضية"
"20961","(۲۰۹۶۱) حَدَّثَنَا وَکِیعٌ ، عَنِ الْمَسْعُودِیِّ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ ، قَالَ : تَجْرِی فِیہِ الْعَتَاقَۃُ فِی أَوَّلِ نَجْمٍ۔","","Musannaf Ibn Abi Shaybah 20961","","","كتاب البيوع والأقضية"
"20962","(۲۰۹۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ، أَنَّہُ قَالَ فِی مُکَاتَبٍ عَجَزَ وَقَدْ أَدَّی بَعْضَ مُکَاتَبَتِہِ وَقَدْ شَرَطُوا عَلَیْہِ ، فَہُوَ رَدٌّ ؟ قَالَ : إذَا أَدَّی النِّصْفَ ، فَہُوَ غَرِیمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 20962","","","كتاب البيوع والأقضية"
"20963","(۲۰۹۶۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عن محمد بن زیاد ، قَالَ : إذَا أَدَّی النِّصْفَ ، فَہُوَ غَرِیمٌ۔","Hasan","Musannaf Ibn Abi Shaybah 20963","","","كتاب البيوع والأقضية"
"20964","(۲۰۹۶۴) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا أَدَّی الثُّلُثَ ، أَوِ الرُّبُعَ ، أَوِ النِّصْفَ فَلَیْسَ لَہُمْ أَنْ یَسْتَرِقُّوہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20964","","","كتاب البيوع والأقضية"
"20965","(۲۰۹۶۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ نَبْہَانَ ، عَنْ أُمِّ سَلَمَۃَ قَالَتْ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : إذَا کَانَ لإِحْدَاکُنَّ مُکَاتَبٌ وَکَانَ عِنْدَہُ مَا یُؤَدِّی فَلْتَحْتَجِبْ مِنْہُ۔ (ترمذی ۱۲۶۱۔ ابوداؤد ۳۹۲۴)","Da'if","Musannaf Ibn Abi Shaybah 20965","","","كتاب البيوع والأقضية"
"20966","(۲۰۹۶۶) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : کَانَ یُقَالُ : إذَا أَدَّی الثُّلُثَ ، أَوِ الرُّبُعَ ، فَہُوَ غَرِیمٌ۔","No Data Available","Musannaf Ibn Abi Shaybah 20966","","","كتاب البيوع والأقضية"
"20967","(۲۰۹۶۷) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ طَارِقٍ ، عَنِ الشَّعْبِیِّ ، عَنْ عَلِیٍّ ، قَالَ : یَعْتِقُ مِنَ الْمُکَاتَبِ بِقَدْرِ مَا أَدَّی۔","Sahih","Musannaf Ibn Abi Shaybah 20967","","","كتاب البيوع والأقضية"
"20968","(۲۰۹۶۸) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ وَأَصْحَابِہِ ، وَعَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : وَالْقَرْضُ حَالٌّ ، وَإِنْ کَانَ إلَی أَجَلٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 20968","","","كتاب البيوع والأقضية"
"20969","(۲۰۹۶۹) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : مَنْ بَاعَ حُبْلَی ، أَوْ أَعْتَقَہَا وَاسْتَثْنَی مَا فِی بَطْنِہَا ، قَالَ لَہُ : ثُنْیَاہُ فِیمَا قَدِ اسْتَبَانَ خَلْقُہُ ، وَإِنْ لَمْ یَسْتَبِنْ خَلْقُہُ فَلاَ شَیْئَ لَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20969","","","كتاب البيوع والأقضية"
"20970","(۲۰۹۷۰) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یُجِیزُ ثُنْیَاہُ فِی الْبَیْعِ ، وَلاَ یُجِیزُ فِی الْعِتْقِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20970","","","كتاب البيوع والأقضية"
"20971","(۲۰۹۷۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ ہِشَامٍ ، عَنْ مُحَمَّدٍ ؛ فِی الرَّجُلِ یُعْتِقُ الأَمَۃَ وَیَسْتَثْنِی مَا فِی بَطْنِہَا ، قَالَ لَہُ: ثُنْیَاہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20971","","","كتاب البيوع والأقضية"
"20972","(۲۰۹۷۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : ہُمَا حُرَّانِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20972","","","كتاب البيوع والأقضية"
"20973","(۲۰۹۷۳) حَدَّثَنَا یَحْیَی بْنُ یَمَانٍ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، وَعَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنِ الشَّعْبِیِّ ، وَعَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، ??َنْ إبْرَاہِیمَ قَالُوا : إذَا أَعْتَقَہَا وَاسْتَثْنَی مَا فِی بَطْنِہَا فَلَہُ ثُنْیَاہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20973","","","كتاب البيوع والأقضية"
"20974","(۲۰۹۷۴) حَدَّثَنَا حَرَمِیُّ بْنُ عُمَارَۃَ بْنِ أَبِی حَفْصَۃَ ، عَنْ شُعْبَۃَ ، قَالَ : سَأَلْتُ الْحَکَمَ ، وَحَمَّادًا فَقَالاَ : ذَلِکَ لَہُ۔","","Musannaf Ibn Abi Shaybah 20974","","","كتاب البيوع والأقضية"
"20975","(۲۰۹۷۵) حَدَّثَنَا قُرَّۃُ بْنُ سُلَیْمَانَ ، عَنْ مُحَمَّدِ بْنِ الْفَضَّائِ ، عَنْ أَبِیہِ ، عَنِ ابْنِ عُمَرَ ؛ فِی الرَّجُلِ یَبِیعُ الأَمَۃَ وَیَسْتَثْنِی مَا فِی بَطْنِہَا ، قَالَ : لَہُ ثُنْیَاہُ۔","Da'if","Musannaf Ibn Abi Shaybah 20975","","","كتاب البيوع والأقضية"
"20976","(۲۰۹۷۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ ؛ فِی الرَّجُلِ یَدَّعِی الدَّابَّۃَ فِی یَدِ الرَّجُلِ فَیَقُولُ : ضَلَّتْ مِنِّی ، قَالَ : لاَ أَقُولُ لِلشُّہُودِ : إِنَّہُ لَمْ یَبِعْ وَلَمْ یَہَبْ ، وَلَکِنْ إذَا شَہِدَتِ الشُّہُودُ أَنَّہَا دَابَّتُہُ ، ضَلَّتْ مِنْہُ ، أُحَلِّفُہُ بِاللَّہِ : مَا بَاعَ ، وَلاَ وَہَبَ۔","","Musannaf Ibn Abi Shaybah 20976","","","كتاب البيوع والأقضية"
"20977","(۲۰۹۷۷) حَدَّثَنَا جَرِیرٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا شَہِدَت الشُّہُودُ أَنَّہَا دَابَّتُہُ أُحَلِّفُہُ بِاللَّہِ : مَا أَہْلَکْتُ ، وَلاَ أَمَرْتُ مُہْلِکًا۔","","Musannaf Ibn Abi Shaybah 20977","","","كتاب البيوع والأقضية"
"20978","(۲۰۹۷۸) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنِ بْنِ صَالِحٍ ، عَنِ الأَسْوَدِ بْنِ قَیْسٍ ، عَنْ حَسَّانَ بْنِ ثُمَامَۃَ ، أَنَّ حُذَیْفَۃَ عَرَفَ جَمَلا لہُ فَخَاصَمَ فِیہِ إلَی قَاضٍ مِنْ قُضَاۃِ الْمُسْلِمِینَ فَصَارَتْ عَلَی حُذَیْفَۃَ یَمِینٌ فِی الْقَضَائِ فَحَلَفَ بِاللَّہِ الَّذِی لاَ إلَہَ إلاَّ ہُوَ : مَا بَاعَ ، وَلاَ وَہَبَ۔","Da'if","Musannaf Ibn Abi Shaybah 20978","","","كتاب البيوع والأقضية"
"20979","(۲۰۹۷۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، قَالَ : کَانَ الْحَجَّاجُ یُعْطِی النَّاسَ الرِّزْقَ فَیَقُولُ أَصْحَابُ دار الرِّزْقِ : مَنْ شَائَ أَخَذَ أَرْبَعَۃَ أَجْرِبَۃِ شَعِیرٍ بِجَرِیبَیْنِ حِنْطَۃٍ الَّذِی لَہُ ، فَسَأَلْنا إبْرَاہِیمَ وَالشَّعْبِیَّ فَقَالاَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 20979","","","كتاب البيوع والأقضية"
"20980","(۲۰۹۸۰) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : إذَا اخْتَلَفَ النَّوْعَانِ فَلاَ بَأْسَ بِالْفَضْلِ یَدًا بِیَدٍ۔","Da'if","Musannaf Ibn Abi Shaybah 20980","","","كتاب البيوع والأقضية"
"20981","(۲۰۹۸۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَالِمٍ ، أَنَّ ابْنَ عُمَرَ کَانَ لاَ یَرَی بَأْسًا فِیمَا یُکَالُ یَدًا بِیَدٍ وَاحِدًا بِاثْنَیْنِ إذَا اخْتَلَفَتْ أَلْوَانُہُ۔","Sahih","Musannaf Ibn Abi Shaybah 20981","","","كتاب البيوع والأقضية"
"20982","(۲۰۹۸۲) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : إذَا اخْتَلَفَ النَّوْعَانِ بِعْ کَیْفَ شِئْتَ۔","No Data Available","Musannaf Ibn Abi Shaybah 20982","","","كتاب البيوع والأقضية"
"20983","(۲۰۹۸۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، أَنَّہُ کَانَ لاَ یَرَی بَأْسًا بِبَیْعِ الْبُرِّ بِالشَّعِیرِ یَدًا بِیَدٍ أَحَدُہُمَا أَکْثَرُ مِنَ الآخَرِ۔","No Data Available","Musannaf Ibn Abi Shaybah 20983","","","كتاب البيوع والأقضية"
"20984","(۲۰۹۸۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ مُسْلِمِ بْنِ یَسَارٍ ، عَنْ أَبِی الأَشْعَثِ الصَّنْعَانِیِّ ، أَنَّ عُبَادَۃَ بْنَ الصَّامِتِ ، قَالَ : لاَ بَأْسَ بِبَیْعِ الْحِنْطَۃِ بِالشَّعِیرِ وَالشَّعِیرُ أَکْثَرُ مِنْہُ یَدًا بِیَدٍ ، وَلاَ یَصْلُحُ نَسِیئَۃً۔","Sahih","Musannaf Ibn Abi Shaybah 20984","","","كتاب البيوع والأقضية"
"20985","(۲۰۹۸۵) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ أُنَیْسِ بْنِ خَالِدٍ التَّمِیمِیِّ ، قَالَ : سَأَلْتُ عَطَائً عَنِ الشَّعِیرِ بِالْحِنْطَۃِ اثْنَیْنِ بِوَاحِدٍ یَدًا بِیَدٍ ، فقَالَ : لاَ بَأْسَ بِہِ۔","","Musannaf Ibn Abi Shaybah 20985","","","كتاب البيوع والأقضية"
"20986","(۲۰۹۸۶) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ أَبِیہِ ، عَنْ أَبِی حَازِمٍ ، عَنْ أَبِی ہُرَیْرَۃَ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْحِنْطَۃُ بِالْحِنْطَۃِ وَالشَّعِیرُ بِالشَّعِیرِ یَدًا بِیَدٍ کَیْلاً بِکَیْلٍ وَزْنًا بِوَزْنٍ لاَ بأس فَمَنْ زَادَ أو اسْتَزَادَ ، فَقَدْ أَرْبَی إلاَّ مَا اخْتَلَفَتْ أَلْوَانُہُ۔ (مسلم ۸۴۔ احمد ۲/۲۶۲)","Sahih","Musannaf Ibn Abi Shaybah 20986","","","كتاب البيوع والأقضية"
"20987","(۲۰۹۸۷) حَدَّثَنَا وَکِیعٌ، قَالَ : حدَّثَنَا سُفْیَانُ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ أَبِی الأَشْعَثِ الصَّنْعَانِیِّ ، عَنْ عُبَادَۃَ بْنِ الصَّامِتِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الذَّہَبُ بِالذَّہَبِ وَالْفِضَّۃُ بِالْفِضَّۃِ وَالْبُرُّ بِالْبُرِّ وَالشَّعِیرُ بِالشَّعِیرِ مِثْلاً بِمِثْلٍ یَدًا بِیَدٍ ، فَإِذَا اخْتَلَفَتْ ہَذِہِ الأَصْنَافُ فَبِیعُوا کَیْفَ شِئْتُمْ ، إذَا کَانَ یَدًا بِیَدٍ۔n(مسلم ۸۱۔ ابوداؤد ۳۳۴۳)","Sahih","Musannaf Ibn Abi Shaybah 20987","","","كتاب البيوع والأقضية"
"20988","(۲۰۹۸۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، أَنَّ عُمَرَ أَرْسَلَ غُلاَمًا لَہُ ، أَوْ عَبْدًا لَہُ بِصَاعٍ مِنْ تمر یَشْتَرِی لَہُ بِہِ صَاعًا مِنْ شَعِیرٍ ، وَزَجَرَہُ إِنْ زَادُوہُ أَنْ یَزْدَادَ۔","","Musannaf Ibn Abi Shaybah 20988","","","كتاب البيوع والأقضية"
"20989","(۲۰۹۸۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ أَبِی عَبْدِ الرَّحْمَنِ ، أَنَّہُ کَانَ یَکْرَہُ قَفِیزًا مِنْ بُرٍّ بِقَفِیزَیْنِ مِنْ شَعِیرٍ۔","No Data Available","Musannaf Ibn Abi Shaybah 20989","","","كتاب البيوع والأقضية"
"20990","(۲۰۹۹۰) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثٍ ، عَنْ نَافِعٍ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ بْنِ عَبْدِ یَغُوثَ الزُّہْرِیِّ أَنَّہُ أَتَاہ غلامہ فَأُخْبِرَ بِأَنَّ دَابَّتَہُ قَدْ فَنِیَ شَعِیرُہَا ، فَأَمَرَہ أَنْ یَأْخُذَ من حِنْطَۃِ أَہْلِہِ فَیَشْتَرِیَ لَہُ شَعِیرًا، وَلاَ یَأْخُذُ إلاَّ مِثْلاً بِمِثْلٍ ، قَالَ نَافِعٌ : وَأَخْبَرَنِی سُلَیْمَانُ بْنُ یَسَارٍ بِمِثْلِہَا ، عَنْ سَعْدِ بْنِ أَبِی وَقَّاصٍ۔","","Musannaf Ibn Abi Shaybah 20990","","","كتاب البيوع والأقضية"
"20991","(۲۰۹۹۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ سُلَیْمَانَ بْنِ مُوسَی ، قَالَ : مَرَّ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ عَلَی رَجُلٍ یَبِیعُ طَعَامًا مَلْغُوثًا فِیہِ شَعِیرٌ ، فَقَالَ : اعْزِلْ ہَذَا مِنْ ہَذَا ، وَہَذَا مِنْ ہَذَا ، ثُمَّ بِعْ ہَذَا کَیْفَ شِئْتَ، وَبِعْ ذَا کَیْفَ شِئْتَ ، فَإِنَّہُ لَیْسَ فِی دِینِنَا غِشٌّ۔ (ابوداؤد ۱۷۴)","","Musannaf Ibn Abi Shaybah 20991","","","كتاب البيوع والأقضية"
"20992","(۲۰۹۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ یَمَانٍ أَبِی حُذَیْفَۃَ ، عَنْ زِیَادٍ مَوْلَی ابْنِ عَبَّاسٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَخْلِطُ الشَّعِیرَ بِالْحِنْطَۃِ ، ثُمَّ یَبِیعُہُ ، قَالَ : لاَ بَأْسَ بِہِ۔","Da'if","Musannaf Ibn Abi Shaybah 20992","","","كتاب البيوع والأقضية"
"20993","(۲۰۹۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ یَمَانٍ أَبِی حُذَیْفَۃَ أَنَّہُ سَأَلَ الشَّعْبِیَّ عَنْہُ فَکَرِہَہُ۔","","Musannaf Ibn Abi Shaybah 20993","","","كتاب البيوع والأقضية"
"20994","(۲۰۹۹۴) حَدَّثَنَا عَبْدُ الأَعْلَی، عَنْ ہِشَامٍ، عَنْ مُحَمَّدٍ، أَنَّہُ کَانَ یَکْرَہُ أَنْ یَشْتَرِیَ الرَّجُلُ الطَّعَامَ الْجَیِّدَ وَالرَّدِیئَ، فَیَخْلِطُہُمَا جَمِیعًا ، ثُمَّ یَبِیعُہُمَا ، فَإِنْ کَانَ الَّذِی بَیْنَہُمَا قَرِیبًا فَلاَ بَأْسَ۔","","Musannaf Ibn Abi Shaybah 20994","","","كتاب البيوع والأقضية"
"20995","(۲۰۹۹۵) حَدَّثَنَا عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، عَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ حَمَّادٍ سُئِلَ عَنِ الْبُرِّ یُخْلَطُ بِالشَّعِیرِ وَالْبُرِّ یُخْلَطُ بِأَرْدَأَ مِنْہُ فَکَرِہَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 20995","","","كتاب البيوع والأقضية"
"20996","(۲۰۹۹۶) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ؛ فِی الرَّجُلِ یُزَوِّجُ أُمَّ وَلَدِہِ عَبْدَہُ فَتَلِدُ لَہُ أَوْلاَدًا ، قَالَ : ہُمْ بِمَنْزِلَۃِ أُمِّہِمْ ، یَعْتِقُونَ بِعِتْقِہَا وَیُرَقُّونَ بِرِقِّہَا ، فَإِذَا مَاتَ سَیِّدُہُمْ عَتَقُوا۔","No Data Available","Musannaf Ibn Abi Shaybah 20996","","","كتاب البيوع والأقضية"
"20997","(۲۰۹۹۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَابْنُ أَبِی زَائِدَۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ فِی وَلَدِ أُمِّ الْوَلَدِ : یَعْتِقُونَ بِعِتْقِہَا وَیُرَقُّونَ بِرِقِّہَا۔","","Musannaf Ibn Abi Shaybah 20997","","","كتاب البيوع والأقضية"
"20998","(۲۰۹۹۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : إذَا تَزَوَّجَتْ أُمُّ الْوَلَدِ فَوَلَدَتْ فَوَلَدُہَا بِمَنْزِلَتِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20998","","","كتاب البيوع والأقضية"
"20999","(۲۰۹۹۹) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ ، قَالَ : وَلَدُہَا بِمَنْزِلَتِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 20999","","","كتاب البيوع والأقضية"
"21000","(۲۱۰۰۰) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : وَلَدُ أُمِّ الْوَلَدِ بِمَنْزِلَتِہَا۔","Da'if","Musannaf Ibn Abi Shaybah 21000","","","كتاب البيوع والأقضية"
"21001","(۲۱۰۰۱) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنِ الزُّبَیْرِ بْنِ عَدِیٍّ ، عَنْ حَوْطٍ ، أَنَّ رَجُلاً غَصَبَ رَجُلاً أُمُّ وَلَدٍ لَہُ فَوَلَدَتْ لَہُ أَوْلاَدًا فَقَالَ شُرَیْحٌ : أَوْلاَدُہَا بِمَنْزِلَتِہَا ، یَسْتَخْدِمُہُمْ ، وَلاَ یَبِیعُہُمْ۔","","Musannaf Ibn Abi Shaybah 21001","","","كتاب البيوع والأقضية"
"21002","(۲۱۰۰۲) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : وَلَدُ أُمِّ الْوَلَدِ بِمَنْزِلَتِہَا ، یَعْتِقُونَ بِعِتْقِہَا وَیُرَقُّونَ بِرِقِّہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21002","","","كتاب البيوع والأقضية"
"21003","(۲۱۰۰۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : وَلَدُ أُمِّ الْوَلَدِ بِمَنْزِلَتِہَا ، یَعْتِقُونَ بِعِتْقِہَا ، یَبِیعُہُمْ صَاحِبُہُمْ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 21003","","","كتاب البيوع والأقضية"
"21004","(۲۱۰۰۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنْ رِیَاحِ بْنِ عَبِیْدَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ أَنَّہُ أَرَّقَ وَلَدَ أُمِّ الْوَلَدِ۔","","Musannaf Ibn Abi Shaybah 21004","","","كتاب البيوع والأقضية"
"21005","(۲۱۰۰۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، قَالَ : وَلَدُ الْمُدَبَّرَۃِ بِمَنْزِلَتِہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21005","","","كتاب البيوع والأقضية"
"21006","(۲۱۰۰۶) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عن ابْنُ الْمُسَیَّبِ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : وَلَدُ الْمُعْتَقَۃِ ، عَنْ دُبُرٍ مِنْہَا یُرَقُّونَ بِرِقِّہَا وَیَعْتِقُونَ بِعِتْقِہَا۔","Sahih","Musannaf Ibn Abi Shaybah 21006","","","كتاب البيوع والأقضية"
"21007","(۲۱۰۰۷) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرِِ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ ، عَنْ شُرَیْحٍ ، قَالَ : وَلَدُ الْمُدَبَّرَۃِ مِنْہَا۔","No Data Available","Musannaf Ibn Abi Shaybah 21007","","","كتاب البيوع والأقضية"
"21008","(۲۱۰۰۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، قَالَ : کَانَ یَقُولُ : وَلَدُ الْمُعْتَقَۃِ ، عَنْ دُبُرٍ بِمَنْزِلَتِہَا ، ہُمْ وَأُمُّہُمْ مِنَ الثُّلُثِ۔","","Musannaf Ibn Abi Shaybah 21008","","","كتاب البيوع والأقضية"
"21009","(۲۱۰۰۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنْ رِیَاحِ بْنِ عَبِیْدَۃَ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ أَنَّہُ جَعَلَہُمْ بِمَنْزِلَۃِ أُمِّہِمْ۔","","Musannaf Ibn Abi Shaybah 21009","","","كتاب البيوع والأقضية"
"21010","(۲۱۰۱۰) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، وَابْنُ أَبِی زَائِدَۃَ ، عن داود عَنِ الشَّعْبِیِّ ، قَالَ : وَلَدُہَا بِمَنْزِلَتِہَا۔","","Musannaf Ibn Abi Shaybah 21010","","","كتاب البيوع والأقضية"
"21011","(۲۱۰۱۱) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الشَّعْبِیِّ ، قَالَ : کُلُّ شَیْئٍ وَلَدَتْ مِنْ یَوْمِ دُبِّرَتْ فَإِنَّہُمْ بِمَنْزِلَتِہَا ، یَعْتِقُونَ بِعِتْقِہَا وَیُرَقُّونَ بِرِقِّہَا۔","","Musannaf Ibn Abi Shaybah 21011","","","كتاب البيوع والأقضية"
"21012","(۲۱۰۱۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ ابْنِ عَوْنٍ ، قَالَ : قیلَ لِلْقَاسِمِ بْنِ مُحَمَّدٍ إنَّ عُمَرَ بْنَ عَبْدِ الْعَزِیزِ ، قَالَ ذَلِکَ ، فَقَالَ الْقَاسِمُ : ہَذَا رَأْیِی ، وَمَا أَرَی رَأْیَہُ فِی ہَذَا إلاَّ مُعْتَدلاً۔","","Musannaf Ibn Abi Shaybah 21012","","","كتاب البيوع والأقضية"
"21013","(۲۱۰۱۳) حَدَّثَنَا غُنْدَرٌ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : وَلَدُ الْمُدَبَّرَۃِ بِمَنْزِلَۃِ أُمِّہِمْ۔","","Musannaf Ibn Abi Shaybah 21013","","","كتاب البيوع والأقضية"
"21014","(۲۱۰۱۴) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ عُبَیْدِ اللہِ ، عَنْ عَامِرٍ ، عَنِ ابْنِ مَسْعُودٍ ، قَالَ : وَلَدُ الْمُدَبَّرَۃِ بِمَنْزِلَتِہَا ، یَعْتِقُونَ بِعِتْقِہَا وَیُرَقُّونَ بِرِقِّہَا۔","Da'if","Musannaf Ibn Abi Shaybah 21014","","","كتاب البيوع والأقضية"
"21015","(۲۱۰۱۵) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عَبْدِ الْعَزِیزِ ، عَنِ الشَّعْبِیِّ وَشُرَیْحٍ وَمَسْرُوقٍ بِمِثْلِہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21015","","","كتاب البيوع والأقضية"
"21016","(۲۱۰۱۶) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالَ : وَلَدُ الْمُدَبَّرَۃِ بِمَنْزِلَتِہَا۔","","Musannaf Ibn Abi Shaybah 21016","","","كتاب البيوع والأقضية"
"21017","(۲۱۰۱۷) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنْ عَامِرٍ ، قَالَ : إذَا کَانَتِ امْرَأَۃٌ فَوَلَدَتْ أَوْلاَدًا فَوَلَدُہَا بِمَنْزِلَتِہَا ، إذَا أُعْتِقَتْ عَتَقُوا۔","","Musannaf Ibn Abi Shaybah 21017","","","كتاب البيوع والأقضية"
"21018","(۲۱۰۱۸) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ مُسْلِمٍ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ وَطَاوُوسٍ ، وَمُجَاہِدٍ ، وَسَعِیدِ بْنِ جُبَیْرٍ أَنَّہُمْ قَالُوا : وَلَدُ الْمُدَبَّرَۃِ بِمَنْزِلَۃِ أُمِّہِمْ۔","No Data Available","Musannaf Ibn Abi Shaybah 21018","","","كتاب البيوع والأقضية"
"21019","(۲۱۰۱۹) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی امْرَأَۃٍ أَعْتَقَتْ جَارِیَۃً لَہَا ، عَنْ دُبُرٍ فَوَلَدَتْ بَعْدَ ذَلِکَ أَوْلاَدًا : ہُمْ بِمَنْزِلَۃِ أُمِّہِمْ إذَا أُعْتِقَتْ عَتَقُوا۔","","Musannaf Ibn Abi Shaybah 21019","","","كتاب البيوع والأقضية"
"21020","(۲۱۰۲۰) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ ، قَالَ : مَا أَرَی أَوْلاَدَ الْمُدَبَّرَۃِ إلاَّ بِمَنْزِلَۃِ أُمِّہِمْ۔","","Musannaf Ibn Abi Shaybah 21020","","","كتاب البيوع والأقضية"
"21021","(۲۱۰۲۱) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ ، قَالَ : وَلَدُ الْمُدَبَّرَۃِ یَبِیعُہُمْ صَاحِبُہُمْ إِنْ شَائَ۔","","Musannaf Ibn Abi Shaybah 21021","","","كتاب البيوع والأقضية"
"21022","(۲۱۰۲۲) حَدَّثَنَا الضَّحَّاکُ بْنُ مَخْلَدٍ ، عَنْ عَمْرِو بْنِ دِینَارٍ ، عَنْ جَابِرِ بْنِ زَیْدٍ ، قَالَ : وَلَدُ الْمُدَبَّرَۃِ عبید۔","","Musannaf Ibn Abi Shaybah 21022","","","كتاب البيوع والأقضية"
"21023","(۲۱۰۲۳) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ عمْرِو بْنِ حُرَیْثٍ ، أَنَّ رَجُلاً اشْتَرَی جَارِیَۃً بِسِتِّینَ دِینَارًا ، فَنَقَدَ ثَلاَثِینَ ، وَارْتَہَنَہَا الْبَائِعُ بِالْبَقِیَّۃِ ، فَمَکَثَ أَیَّامًا ، ثُمَّ أَتَی الْمُشْتَرِی بِثَمَنِہَا فَوَجَدَہَا قَدْ مَاتَتْ ، فَقَالَ : مَا أَخَذَ الْبَائِعُ فَلَہُ ، وَأَمَّا الْبَقِیَّۃُ فَلِلْمُشْتَرِی۔","","Musannaf Ibn Abi Shaybah 21023","","","كتاب البيوع والأقضية"
"21024","(۲۱۰۲۴) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ مُحَمَّدِ بْنِ عُبَیْدِ اللہِ الثَّقَفِیِّ ، أَنَّ شُرَیْحًا ، قَالَ فِیہَا : لاَ یَرُدَّ الْبَائِعُ مَا أَخَذَ مِنْ ثَمَنِہَا وَیَدْفِنُ جِیفَتَہُ۔","","Musannaf Ibn Abi Shaybah 21024","","","كتاب البيوع والأقضية"
"21025","(۲۱۰۲۵) حَدَّثَنَا حَفْصٌ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، أَنَّ قَوْلَ عَمْرِو بْنِ حُرَیْثٍ کَانَ أَعْجَبَ إلَیْہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21025","","","كتاب البيوع والأقضية"
"21026","(۲۱۰۲۶) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ اشْتَرَی مِنْ رَجُلٍ جَارِیَۃً فَنَقَدَ بَعْضَ ثَمَنِہَا ، وَأَمْسَکَہَا الْبَائِعَ بِالْبَقِیَّۃِ فَمَاتَتْ ، قَالَ : یَرُدُّ عَلَی الْمُشْتَرِی مَا أَخَذَ ، وَہِیَ مِنْ مَالِ الْبَائِعِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21026","","","كتاب البيوع والأقضية"
"21027","(۲۱۰۲۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ وَمُحَمَّدٍ ، قَالاَ : إِنْ کَانَ نَقَدَ بَعْضَ الثمنِ وَارْتَہَنَ الْمَتَاعَ بِالْبَقِیَّۃِ فَہَلَکَ الْمَتَاعُ ، فَہُوَ بِمَا ارْتَہَنَہُ وَلَہُ مَا کَانَ قَدْ أَخَذَ ، فَإِنْ کَانَ بَیْعًا مِمَّا یُکَالُ وَیُوزَنُ فنقصانہ عَلَی الْبَائِعِ حَتَّی یُوَفِّیَہُ الْمُشْتَرِیَ۔","","Musannaf Ibn Abi Shaybah 21027","","","كتاب البيوع والأقضية"
"21028","(۲۱۰۲۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ أَبِی نَجِیحٍ ، عَنْ عَطَائٍ وَطَاوُوسٍ ، وَمُجَاہِدٍ قَالُوا : الْقَاذِفُ إذَا تَابَ جَازَتْ شَہَادَتُہُ۔","","Musannaf Ibn Abi Shaybah 21028","","","كتاب البيوع والأقضية"
"21029","(۲۱۰۲۹) حَدَّثَنَا عبد الأعلی ، عن یونس ، عن عکرمۃ ، قَالَ : إذا تاب ، ولم یُعلم منہ إلا خیر ، جازت شہادتہ۔","","Musannaf Ibn Abi Shaybah 21029","","","كتاب البيوع والأقضية"
"21030","(۲۱۰۳۰) حَدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ مُجَالِدٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، قَالَ : تَجُوزُ شَہَادَتُہُ إذَا تَابَ۔","No Data Available","Musannaf Ibn Abi Shaybah 21030","","","كتاب البيوع والأقضية"
"21031","(۲۱۰۳۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ مُطَرِّفٍ ، عَنْ أَبِی عُثْمَانَ ، عَنْ شُرَیْحٍ ، قَالَ : تَجُوزُ شَہَادَتُہُ إذَا تَابَ۔","","Musannaf Ibn Abi Shaybah 21031","","","كتاب البيوع والأقضية"
"21032","(۲۱۰۳۲) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ أَظُنُّہُ ، عَنْ سَعِیدٍ ، قَالَ : قَالَ عُمَرُ لأَِبِی بَکْرَۃَ : إِنْ تابَ اَقْبَلْ شَہَادَتَہُ۔","","Musannaf Ibn Abi Shaybah 21032","","","كتاب البيوع والأقضية"
"21033","(۲۱۰۳۳) حَدَّثَنَا ابْنُ إدْرِیسَ وَوَکِیعٌ، عَنْ مِسْعَرٍ، عَنْ عِمْرَانَ بْنِ عُمَیْرٍ، عَنْ عَبْدِ اللہِ بْنِ عُتْبَۃَ، قَالَ: تَجُوزُ إذَا تَابَ۔","","Musannaf Ibn Abi Shaybah 21033","","","كتاب البيوع والأقضية"
"21034","(۲۱۰۳۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ سُفْیَانَ بْنِ حُسَیْنٍ ، عَنِ الزُّہْرِیِّ ، قَالَ : تَجُوزُ إذَا تَابَ۔","","Musannaf Ibn Abi Shaybah 21034","","","كتاب البيوع والأقضية"
"21035","(۲۱۰۳۵) حَدَّثَنَا محمد بن یزید ، عن العوام ، عن حبیب بن أبی ثابت ، قَالَ : تجوز إذا تاب۔","","Musannaf Ibn Abi Shaybah 21035","","","كتاب البيوع والأقضية"
"21036","(۲۱۰۳۶) حَدَّثَنَا وَکِیعٌ، عَنِ ابْنِ أَبِی خَالِدٍ، عَنِ الشَّعْبِیِّ، قَالَ: تَجُوزُ، وَقَالَ: یَقْبَلُ اللَّہُ توبتہ، وَلاَ أُجِیزُ أَنَا شَہَادَتَہُ۔","No Data Available","Musannaf Ibn Abi Shaybah 21036","","","كتاب البيوع والأقضية"
"21037","(۲۱۰۳۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنِ الشَّیْبَانِیِّ ، عَنِ الشَّعْبِیِّ ، عَنْ شُرَیْحٍ ، قَالَ : إذَا أُقِیمَ عَلَی الرَّجُلِ الْحَدُّ فِی الْقَذْفِ لَمْ تُقْبَلْ لَہُ شَہَادَۃٌ أَبَدًا ، وَتَوْبَتُہُ فِیمَا بَیْنَہُ وَبَیْنَ اللہِ۔","","Musannaf Ibn Abi Shaybah 21037","","","كتاب البيوع والأقضية"
"21038","(۲۱۰۳۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ أَبِی الضُّحَی ، عَنْ شُرَیْحٍ ، قَالَ : لاَ تَجُوزُ شَہَادَۃُ الْقَاذِفِ ، وَتَوْبَتُہُ فِیمَا بَیْنَہُ وَبَیْنَ اللہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21038","","","كتاب البيوع والأقضية"
"21039","(۲۱۰۳۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْہَیْثَمِ ، قَالَ : سَمِعْتُ إبْرَاہِیمَ وَالشَّعْبِیَّ یَتَذَاکَرَانِ ذَلِکَ فَقَالَ إبْرَاہِیمُ : لاَ تَجُوزُ ، فَقَالَ الشَّعْبِیُّ : لِمَ ؟ فَقَالَ : إبْرَاہِیمُ : إِنَّک لاَ تَدْرِی تَابَ ، أَوْ لَمْ یَتُبْ۔","","Musannaf Ibn Abi Shaybah 21039","","","كتاب البيوع والأقضية"
"21040","(۲۱۰۴۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ، أَنَّہُ کَانَ یَقُولُ فِی الْقَاذِفِ : تَوْبَتُہُ فِیمَا بَیْنَہُ وَبَیْنَ اللہِ ، وَلاَ تَجُوزُ شَہَادَتُہُ۔","","Musannaf Ibn Abi Shaybah 21040","","","كتاب البيوع والأقضية"
"21041","(۲۱۰۴۱) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ حَمَّادِ بْنِ سَلَمَۃَ ، عَنْ قَتَادَۃَ ، عَنِ الْحَسَنِ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ ، قَالاَ : لاَ شَہَادَۃَ لَہُ ، وَتَوْبَتُہُ فِیمَا بَیْنَہُ وَبَیْنَ اللہِ۔","No Data Available","Musannaf Ibn Abi Shaybah 21041","","","كتاب البيوع والأقضية"
"21042","(۲۱۰۴۲) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ أَبِیہِ ، عَنْ جَدِّہِ ، قَالَ : قَالَ رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ : الْمُسْلِمُونَ عُدُولٌ بَعْضُہُمْ عَلَی بَعْضٍ إلاَّ مَحْدُودًا فِی فِرْیَۃٍ۔","","Musannaf Ibn Abi Shaybah 21042","","","كتاب البيوع والأقضية"
