hadiths[65]{hadithnumber,text}:
"617","। আবু যার (রাঃ) হতে বর্ণিত আছে"
"618","। আবূ হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"619","। আনাস (রাঃ) হতে বর্ণিত আছে"
"620","। আলী (রাঃ) হতে বর্ণিত আছে"
"621","। সালিম (রহঃ) হতে তার পিতার সূত্রে বর্ণিত আছে"
"622","। আবদুল্লাহ ইবনু মাসউদ (রাঃ) হতে বর্ণিত আছে"
"623","। মুআয ইবনু জাবাল (রাঃ) হতে বর্ণিত আছে"
"624","। আমর ইবনু মুররা (রহঃ) হতে বর্ণিত আছে"
"625","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"626","। আবু সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"627","। মুহাম্মাদ ইবনু বাশশার আব্দুর রহমান ইবনু মাহদী হতে"
"628","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"629","। ইবনু উমর (রাঃ) হতে বর্ণিত আছে"
"630","। নাফি (রহঃ) বলেন"
"631","। ইবনু উমর (রাঃ) হতে বর্ণিত আছে"
"632","। ইবনু উমর (রাঃ) হতে বর্ণিত আছে"
"633","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"634","। আবূ কুরাইবও এই সনদে অনুরূপ হাদীস বর্ণনা করেছেন। যঈফ"
"635","আবদুল্লাহ (রাঃ)-এর স্ত্রী যাইনাব (রাঃ) হতে বর্ণিত আছে"
"636","। মাহমুদ ইবনু গাইলান আবু দাউদ হতে"
"637","। আমর ইবনু শুআইব (রাহঃ) হতে পর্যায়ক্রমে তার পিতা ও দাদার সুত্রে বর্ণিত আছে। দুইজন মহিলা রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লামের কাছে আসে। তাদের দুজনের হাতে স্বর্ণের বালা ছিল। তিনি তাদের উভয়কে প্রশ্ন করেনঃ তোমরা কি এর যাকাত প্রদান কর? তারা বলল"
"638","। মুআয (রাঃ) হতে বর্ণিত আছে"
"639","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"640","। সালিম (রহঃ) হতে তার পিতার সূত্রে বর্ণিত আছে"
"641","। আমর ইবনু শুআইব (রাহঃ) হতে পালাক্রমে তার পিতা ও দাদার সূত্রে বর্ণিত আছে"
"642","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"643","। আবদুর রহমান ইবনু মাসউদ (রহঃ) বলেন"
"644","আত্তাব ইবনু উসাইদ (রাঃ) হতে বর্ণিত আছে"
"645","। রাফি ইবনু খাদীজ (রাঃ) হতে বর্ণিত"
"646","। আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে"
"647","। জারীর (রাঃ) হতে বর্ণিত আছে"
"648","। আবূ আম্মার আল-হুসাইন ইবনু হুরাইস সুফিয়ান ইবনু উয়াইন হতে"
"649","। আওন ইবনু আবূ জুহাইফা (রাঃ) হতে তার পিতার সূত্রে বর্ণিত আছে"
"650","। আবদুল্লাহ ইবনু মাসউদ (রাঃ) হতে বর্ণিত আছে"
"651","। মাহমূদ ইবনু গাইলান ইয়াহইয়া ইবনু আ-দাম হতে তিনি সুফিয়ান হতে"
"652","। আবদুল্লাহ ইবনু আমর (রাঃ) হতে বর্ণিত আছে"
"653","। হুবশী ইবনু জুনাদা (রাঃ) হতে বর্ণিত আছে"
"654","। মাহমূদ ইবনু গাইলান ইয়াহইয়া ইবনু আদম এর সূত্রে আব্দুর রহীম ইবনু সুলাইমান হতে অনুরূপ হাদীস বর্ণনা করেছেন। দেখুন পূর্বের হাদীস। আবূ ঈসা বলেন"
"655","। আবু সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"656","। বাহয ইবনু হাকীম (রাহঃ) হতে পর্যায়ক্রমে তার পিতা ও দাদার সূত্রে বর্ণিত আছে"
"657","। আবু রাফি (রাঃ) হতে বর্ণিত আছে"
"658","। সালমান ইবনু আমির (রাঃ) হতে বর্ণিত আছে"
"659","। ফাতিমা বিনতু কাইস (রাঃ) হতে বর্ণিত আছে"
"660","। ফাতিমা বিনতু কাইস (রাঃ) হতে বর্ণিত আছে"
"661","। সাঈদ ইবনু ইয়াসার (রহঃ) হতে বর্ণিত আছে"
"662","। আবূ হুরাইরা (রাঃ) বলেন"
"663","। আনাস (রাঃ) হতে বর্ণিত আছে"
"664","। আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে"
"665","আবদুর রাহমান ইবনু বুজাইদ (রহঃ) হতে তার দাদী উম্মু বুজাইদ (রাঃ)-এর সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লামের নিকটে যে সকল মহিলা বাইআ’ত গ্রহণ করেছিলেন তিনিও তাদের অন্তর্ভুক্ত। তিনি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লামকে বললেন"
"666","সাফওয়ান ইবনু উমাইয়া (রাঃ) হতে বর্ণিত আছে"
"667","। আবদুল্লাহ ইবনু বুরাইদা (রাঃ) হতে তার পিতার সূত্রে বর্ণিত আছে"
"668","। উমার (রাঃ) হতে বর্ণিত আছে"
"669","। ইবনু আব্বাস (রাঃ) হতে বর্ণিত আছে"
"670","। আবু উমামা আল-বাহিলী (রাঃ) হতে বর্ণিত আছে"
"671","। আইশা (রাঃ) হতে বর্ণিত আছে"
"672","। আইশা (রাঃ) হতে বর্ণিত আছে"
"673","। আবু সাঈদ আল-খুদরী (রাঃ) হতে বর্ণিত আছে"
"674","। আমর ইবনু শুআইব (রাহঃ) হতে পর্যায়ক্রমে তার পিতা ও দাদার সূত্রে বর্ণিত আছে"
"675","। ইবনু উমার (রাঃ) হতে বর্ণিত আছে"
"676","। আবদুল্লাহ ইবনু উমর (রাঃ) হতে বর্ণিত আছে"
"677","। ইবনু উমর (রাঃ) হতে বর্ণিত আছে"
"678","। আলী (রাঃ) হতে বর্ণিত আছে"
"679","। আলী (রাঃ) হতে বর্ণিত আছে"
"680","। আবু হুরাইরা (রাঃ) হতে বর্ণিত আছে"
"681","। সামুরা ইবনু জুনদাব (রাঃ) হতে বর্ণিত আছে"