hadiths[36]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3086","«جاء جبريل فقال: ما تعدون من شهد بدرا فيكم؟ قلت: خيارنا قال وكذلك من شهد بدرا من الملائكة هم عندنا خيار الملائكة»","صحيح","Sahih al-Jami al-Saghir 3086","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3087","«جار الدار أحق بالدار من غيره»","صحيح","Sahih al-Jami al-Saghir 3087","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3088","«جار الدار أحق بالشفعة»","صحيح","Sahih al-Jami al-Saghir 3088","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3089","«جار الدار أحق بدار الجار»","صحيح","Sahih al-Jami al-Saghir 3089","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3090","«جاهدوا المشركين بأموالكم وأنفسكم وألسنتكم»","صحيح","Sahih al-Jami al-Saghir 3090","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3091","«جزى الله الأنصار عنا خيرا ولا سيما عبد الله بن عمرو بن حرام وسعد بن عبادة»","صحيح","Sahih al-Jami al-Saghir 3091","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3092","«جزوا الشوارب وأرخوا اللحى خالفوا المجوس»","صحيح","Sahih al-Jami al-Saghir 3092","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3093","«جعل الله الأهلة مواقيت للناس فصوموا لرؤيته وأفطروا لرؤيته فإن غم عليكم فعدوا ثلاثين يوما»","صحيح","Sahih al-Jami al-Saghir 3093","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3094","«جعل الله الحسنة بعشر أمثالها الشهر بعشرة أشهر وصيام ستة أيام بعد الشهر تمام السنة»","صحيح","Sahih al-Jami al-Saghir 3094","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3095","«جعل الله الرحمة مائة جزء فأمسك عنده تسعة وتسعين جزءا وأنزل في الأرض جزءا واحدا فمن ذلك الجزء تتراحم الخلق حتى ترفع الفرس حافرها عن ولدها خشية أن تصيبه»","صحيح","Sahih al-Jami al-Saghir 3095","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3096","«جعل الله عذاب هذه الأمة في دنياها»","صحيح","Sahih al-Jami al-Saghir 3096","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3097","«جعل الله عليكم صلاة قوم أبرار يقومون الليل ويصومون النهار ليسوا بأثمة ولا فجار»","صحيح","Sahih al-Jami al-Saghir 3097","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3098","«جعلت قرة عيني في الصلاة»","صحيح","Sahih al-Jami al-Saghir 3098","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3099","«جعلت لي الأرض مسجدا وطهورا»","صحيح","Sahih al-Jami al-Saghir 3099","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3100","«جعلت لي كل أرض طيبة مسجدا وطهورا»","صحيح","Sahih al-Jami al-Saghir 3100","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3101","«جنتان من فضة آنيتهما وما فيهما وجنتان من ذهب آنيتهما وما فيهما وما بين القوم وبين أن ينظروا إلى ربهم إلا رداء الكبرياء على وجهه في جنة عدن»","صحيح","Sahih al-Jami al-Saghir 3101","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3102","«جهادكن الحج»","صحيح","Sahih al-Jami al-Saghir 3102","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3103","«الجار أحق بشفعة جاره ينتظر بها وإن كان غائبا إذا كان طريقهما واحد»","صحيح","Sahih al-Jami al-Saghir 3103","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3104","«الجار أحق بصقبه»","صحيح","Sahih al-Jami al-Saghir 3104","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3105","«الجاهر بالقرآن كالجاهر بالصدقة والمسر بالقرآن كالمسر بالصدقة»","صحيح","Sahih al-Jami al-Saghir 3105","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3106","«الجدال في القرآن كفر»","صحيح","Sahih al-Jami al-Saghir 3106","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3107","«الجرس مزامير الشيطان»","صحيح","Sahih al-Jami al-Saghir 3107","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3108","«الجزور عن سبعة»","صحيح","Sahih al-Jami al-Saghir 3108","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3109","«الجماعة رحمة والفرقة عذاب»","حسن","Sahih al-Jami al-Saghir 3109","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3110","«الجمعة إلى الجمعة كفارة ما بينهما ما لم تغش الكبائر»","صحيح","Sahih al-Jami al-Saghir 3110","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3111","«الجمعة حق واجب على كل مسلم في جماعة إلا أربعة: عبدا مملوكا أو امرأة أو صبيا أو مريضا»","صحيح","Sahih al-Jami al-Saghir 3111","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3112","«الجمعة على من سمع النداء»","حسن","Sahih al-Jami al-Saghir 3112","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3113","«الجمعة واجبة إلا على: امرأة أو صبي أو مريض أو عبد.. ... »","صحيح","Sahih al-Jami al-Saghir 3113","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3114","«الجن ثلاثة أصناف فصنف لهم أجنحة يطيرون بها في الهواء وصنف حيات وكلاب وصنف يحلون ويظعنون»","صحيح","Sahih al-Jami al-Saghir 3114","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3115","«الجنة أقرب إلى أحدكم من شراك نعله والنار مثل ذلك»","صحيح","Sahih al-Jami al-Saghir 3115","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3116","""الجنة بناؤها لبنة من فضة ولبنة من ذهب وملاطها المسك الأذفر وحصباؤها اللؤلؤ والياقوت وتربتها الزعفران من يدخلها ينعم لا يبأس ويخلد لا يموت لا تبلى ثيابهم ولا يفنى شبابهم""","صحيح","Sahih al-Jami al-Saghir 3116","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3117","«الجنة تحت ظلال السيوف»","صحيح","Sahih al-Jami al-Saghir 3117","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3118","«الجنة لبنة من ذهب ولبنة من فضة»","صحيح","Sahih al-Jami al-Saghir 3118","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3119","«الجنة لها ثمانية أبواب والنار لها سبعة أبواب»","صحيح","Sahih al-Jami al-Saghir 3119","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3120","«الجنة مائة درجة ما بين كل درجتين كما بين السماء والأرض»","صحيح","Sahih al-Jami al-Saghir 3120","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
"3121","«الجنة مائة درجة ما بين كل درجتين كما بين السماء والأرض والفردوس أعلى الجنة وأوسطها وفوقه عرش الرحمن ومنها يتفجر أنهار الجنة فإذا سألتم الله فاسألوه الفردوس»","صحيح","Sahih al-Jami al-Saghir 3121","","","الأحاديث المبدوءة بحرف الجيم Hadith Beginning with the Letter Jim (ج)"
