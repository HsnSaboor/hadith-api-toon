hadiths[199]{hadithnumber,text}:
"109","[AI-translation] ((मैं एक छुपा ख़ज़ाना था; मैंने चाहा कि पहचाना जाऊँ, तो मैंने मख़लूक़ पैदा की))।"
"110","[AI-translation] ((न मेरी ज़मीन ने मुझे समाया न मेरे आसमान ने, लेकिन मेरे मोमिन बन्दे के दिल ने मुझे समा लिया। [यानी मैं अपने मोमिन बन्दे के दिल में रहता हूँ]))।"
"111","[AI-translation] ((बेशक रहमान के पास एक तख़्ती है जिसमें तीन सौ पन्द्रह (315) शरीअतें हैं। रहमान, इज़्ज़त और जलाल वाला, फ़रमाता है: मेरी इज़्ज़त और मेरे जलाल की क़सम! मेरे बन्दों में से जो मेरे पास इस हाल में आए कि वह मेरे साथ किसी को शरीक न करता हो और इनमें से कोई एक शरीअत रखता हो, वह जन्नत में दाख़िल होगा))।"
"112","[AI-translation] ((मैंने ख़ैर और शर पैदा किए। तो ख़ुशख़बरी उसके लिए जिसके हाथ में मैंने ख़ैर मुक़द्दर की, और हलाकत उसके लिए जिसके हाथ में मैंने शर मुक़द्दर किया))।"
"113","[AI-translation] ((जिसने मेरी तौहीद का इक़रार किया वह मेरे क़िले में दाख़िल हुआ, और जो मेरे क़िले में दाख़िल हुआ वह मेरे अज़ाब से महफ़ूज़ है))।"
"114","[AI-translation] ((मैं अल्लाह हूँ, मैंने बन्दों को अपने इल्म के मुताबिक़ पैदा किया। तो जिसके लिए मैंने ख़ैर चाही उसे अच्छी ख़िल्क़त [सूरत] दी, और जिसके लिए मैंने बुराई चाही उसे बुरी ख़िल्क़त दी))।"
"115","[AI-translation] ((मेरे बन्दों में कुछ ऐसे हैं जिनका ईमान मालदारी के बग़ैर दुरुस्त नहीं रहता, और अगर मैं उन्हें मुहताज कर दूँ तो वे कुफ़्र में पड़ जाएँ। और मेरे बन्दों में कुछ ऐसे हैं जिनका ईमान फ़क़्र के बग़ैर दुरुस्त नहीं रहता, और अगर मैं उन्हें मालदार कर दूँ तो वे कुफ़्र में पड़ जाएँ))।"
"116","[AI-translation] ((ऐ आदम के बेटे! दिन के अव्वल में मेरे लिए दो रकअतें पढ़ और मैं दिन के आख़िर में तेरी [हर मुश्किल से नजात की] ज़मानत देता हूँ))।"
"117","[AI-translation] ((बेशक जब बन्दा खुले और छुपे दोनों हालों में अच्छी नमाज़ पढ़ता है तो अल्लाह तआला फ़रमाता है: यह हक़ीक़त में मेरा बन्दा है))।"
"118","[AI-translation] ((बड़ों में से जो तीन चीज़ों की हिफ़ाज़त करे वह हक़ीक़त में मेरा दोस्त है, और जो उन्हें ज़ाया करे वह हक़ीक़त में मेरा दुश्मन है [और वे हैं]: नमाज़, रोज़ा और जनाबत का ग़ुस्ल))।"
"119","[AI-translation] ((मैं ज़मीन वालों पर अज़ाब भेजने का इरादा करता हूँ, फिर जब उनमें उन लोगों को देखता हूँ जो महज़ मेरी मुहब्बत में मेरे घरों को आबाद करते हैं, और उन लोगों को जो सहर के वक़्त इस्तिग़फ़ार करते हैं, तो उनसे [अज़ाब] फेर देता हूँ))।"
"120","[AI-translation] ((जब अल्लाह तआला ने ज़मीन पैदा की तो वह हिलने लगी। फिर अल्लाह ने पहाड़ पैदा किए और उन्हें ज़मीन पर रख दिया, तो ज़मीन ठहर गई। फ़रिश्ते पहाड़ों की मज़बूती पर हैरान हुए और पूछा: ऐ रब! क्या तेरी मख़लूक़ में पहाड़ों से ज़्यादा मज़बूत कोई चीज़ है? अल्लाह ने फ़रमाया: हाँ! लोहा। उन्होंने पूछा: ऐ रब! क्या तेरी मख़लूक़ में लोहे से ज़्यादा मज़बूत कोई चीज़ है? अल्लाह ने फ़रमाया: हाँ! आग। उन्होंने पूछा: ऐ रब! क्या तेरी मख़लूक़ में आग से ज़्यादा मज़बूत कोई चीज़ है? अल्लाह ने फ़रमाया: हाँ! पानी। उन्होंने पूछा: ऐ रब! क्या तेरी मख़लूक़ में पानी से ज़्यादा मज़बूत कोई चीज़ है? अल्लाह ने फ़रमाया: हाँ! हवा। उन्होंने पूछा: ऐ रब! क्या तेरी मख़लूक़ में हवा से ज़्यादा मज़बूत कोई चीज़ है? अल्लाह ने फ़रमाया: हाँ! आदम का बेटा जो अपने दाएँ हाथ से सदक़ा दे और उसे अपने बाएँ हाथ से छुपाए))।"
"121","[AI-translation] ((जब बन्दा सज्दे में सो जाए तो अल्लाह अज़्ज़ व जल्ल फ़रिश्तों के सामने उस पर फ़ख़्र करता है, फ़रमाता है: मेरे बन्दे को देखो; उसकी रूह मेरे पास है और उसका जिस्म मेरी इताअत में है))।"
"122","[AI-translation] ((मैंने दस लाख उम्मतें पैदा कीं, और कोई उम्मत नहीं जानती कि मैंने उसके सिवा कोई और उम्मत पैदा की है))।"
"123","[AI-translation] रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) ने यह आयत तिलावत की: ((क्या एहसान का बदला एहसान के सिवा कुछ है?)) और फ़रमाया: ((क्या तुम जानते हो तुम्हारे रब ने क्या फ़रमाया?)) सहाबा ने अर्ज़ किया: ((अल्लाह और उसके रसूल बेहतर जानते हैं))। आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((अल्लाह तआला फ़रमाता है कि जिस पर मैंने तौहीद की नेमत की, उसका बदला सिर्फ़ जन्नत है))।"
"124","[AI-translation] ((ला-इलाहा-इल्लल्लाह कहने वालों को मेरे अर्श के साए के क़रीब करो, क्योंकि मैं उनसे मुहब्बत करता हूँ))।"
"125","[AI-translation] ((अर्श पर लिखा है कि अल्लाह के सिवा कोई माबूद नहीं, मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) अल्लाह के रसूल हैं। जो यह कलिमा कहे, मैं उसे अज़ाब न दूँगा))।"
"126","[AI-translation] ((इख़लास मेरा एक राज़ है; मैं उसे अपने बन्दों में से जिससे मुहब्बत करता हूँ उसके दिल में अमानत रखता हूँ))।"
"127","[AI-translation] ((मैंने क़सम खाई है कि मेरे बन्दों में से जो हर नमाज़ के बाद [सूरत-ए-फ़ातिहा, आयत-उल-कुर्सी, आले-इमरान की दो आयतें 'शहिदल्लाह... आख़िर तक' और «قل اللهم مالك الملك»... आख़िर तक] पढ़ेगा, मैं जन्नत को उसका ठिकाना बनाऊँगा))।"
"128","[AI-translation] ((मैं अज़ीज़ हूँ; जो दुनिया और आख़िरत की इज़्ज़त चाहे वह [अज़ीज़ की] इताअत करे))।"
"129","[AI-translation] ((उस बन्दे को हक़ीर न समझो जिसे मैंने इल्म दिया, क्योंकि मैंने उसे हक़ीर नहीं समझा [इसीलिए मैंने उसे इल्म दिया]))।"
"130","[AI-translation] ((सख़ी मुझसे है और मैं उससे हूँ [यानी हमारा आपसी ताल्लुक़ मज़बूत है], और मैं सख़ी से क़ब्र का अज़ाब हल्का कर देता हूँ))।"
"131","[AI-translation] ((क़ियामत के दिन अल्लाह अज़्ज़ व जल्ल फ़रमाएगा: मेरे पड़ोसी कहाँ हैं? यह सुनकर फ़रिश्ते अर्ज़ करेंगे: ऐ रब! कौन तेरा पड़ोसी हो सकता है? फिर अल्लाह तआला फ़रमाएगा: क़ुरआन पढ़ने वाले और मस्जिदें आबाद करने वाले कहाँ हैं? [यानी ये लोग मेरे पड़ोसी हैं]))।"
"132","[AI-translation] ((जो क़ुरआन की तिलावत में मशग़ूल होने की वजह से दुआ के ज़रिए मुझसे माँग न सका, मैं उसे शुक्र करने वालों से अफ़ज़ल सवाब दूँगा))।"
"133","[AI-translation] ((तकब्बुर से बचो, क्योंकि बन्दा तकब्बुर करता रहता है यहाँ तक कि अल्लाह तआला फ़रमाता है: मेरे इस बन्दे को सरकशों में लिख दो))।"
"134","[AI-translation] ((अल्लाह तआला ने दुनिया की तरफ़ वह्य की: जो मेरी ख़िदमत करे उसकी ख़िदमत कर, और जो तेरी ख़िदमत करे उसे थका दे))।"
"135","[AI-translation] (([ऐ नबी!] अगर तू न होता तो अल्लाह तआला अर्श, कुर्सी, ज़मीन, आसमान, सूरज, चाँद या इनके सिवा कुछ और पैदा न करता))।"
"136","[AI-translation] ((जो अज़ान के वक़्त बात करे, उसके ईमान के जाने का ख़तरा है))।"
"137","[AI-translation] ((तीन चीज़ें ईमान की असल हैं: उससे हाथ रोके जो «لا اله الا الله» कहे, उसे किसी गुनाह की वजह से काफ़िर न कहे, और उसे किसी अमल की वजह से इस्लाम से न निकाले। जिहाद मेरी बेअसत से जारी है और जारी रहेगा यहाँ तक कि मेरी उम्मत का आख़िरी गिरोह दज्जाल से लड़े; न किसी ज़ालिम का ज़ुल्म न किसी आदिल का अद्ल उसे बातिल कर सकता है। और तक़दीर पर ईमान))।"
"138","[AI-translation] ((जब मोमिन की उसके मुँह पर तारीफ़ की जाए तो उसके दिल में ईमान बढ़ता है))।"
"139","[AI-translation] ((सबसे शरीफ़ ईमान यह है कि लोग तुझसे महफ़ूज़ रहें))।"
"140","[AI-translation] ((अफ़ज़ल ईमान यह है कि तुझे यक़ीन हो कि तू जहाँ भी हो, अल्लाह तआला तेरे साथ है))।"
"141","[AI-translation] ((ईमान एक लिबास है; अल्लाह यह लिबास जिसे चाहता है देता है। तो जब बन्दा ज़िना करता है तो अल्लाह उससे ईमान का लिबास उतार लेता है, और अगर वह तौबा करे तो उसे लौटा देता है))।"
"142","[AI-translation] ((ईमान नंगा है, उसका लिबास तक़वा है, उसकी ज़ीनत हया है और उसका फल इल्म है))।"
"143","[AI-translation] ((बेशक हया ईमान से है और फ़हशगोई निफ़ाक़ से है))।"
"144","[AI-translation] ((बुढ़ापे से सिर की सफ़ेदी ईमान का लिबास है))।"
"145","[AI-translation] ((ईमान के चौंसठ (64) दरवाज़े हैं))।"
"146","[AI-translation] ((तक़दीर पर ईमान [सब] फ़िक्र और ग़म दूर करता है))।"
"147","[AI-translation] ((ईमान दिल की नीयत और ज़बान के इक़रार का नाम है, और हिजरत वह है जो जान और माल से हो))।"
"148","[AI-translation] ((ईमान हराम चीज़ों और लालच की जगहों से बचाता है))।"
"149","[AI-translation] ((ईमान दो हिस्से है: एक हिस्सा सब्र में और दूसरा हिस्सा शुक्र में))।"
"150","[AI-translation] ((ईमान और अमल दो भाई हैं। अल्लाह तआला उनमें से एक को दूसरे के बग़ैर क़ुबूल नहीं करता))।"
"151","[AI-translation] ((आदमी के ईमान के लिए काफ़ी है कि वह कहे: मैं अल्लाह से अपने रब होने, मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) से उसके रसूल होने, और इस्लाम से अपना दीन होने पर राज़ी हूँ))।"
"152","[AI-translation] ((मिसवाक इस्तेमाल करो, क्योंकि वह सफ़ाई है, और सफ़ाई ईमान की तरफ़ बुलाती है, और ईमान अपने वाले को जन्नत ले जाता है))।"
"153","[AI-translation] ((जिसमें तीन चीज़ें हों उसका सवाब वाजिब हो जाता है और उसका ईमान कामिल है: ऐसा अख़लाक़ जिससे वह लोगों में रहे; ऐसा तक़वा जो उसे अल्लाह की हराम की हुई चीज़ों से रोके; और ऐसा हिल्म और सब्र जो उसे जाहिलों की जहालत से बचाए))।"
"154","[AI-translation] ((पाँच चीज़ें ईमान से हैं; जिसमें इनमें से कोई एक न हो उसका ईमान दुरुस्त नहीं: अल्लाह के हुक्म को मानना, अल्लाह के फ़ैसले पर राज़ी होना, मामलात अल्लाह के सुपुर्द करना, अल्लाह पर तवक्कुल करना, और पहली मुसीबत पर सब्र करना))।"
"155","[AI-translation] ((अबू बक्र और उमर (रज़ियल्लाहु अन्हुमा) की मुहब्बत ईमान से है, जबकि उनसे बुग़्ज़ कुफ़्र है; अंसार की मुहब्बत ईमान से है, जबकि उनसे बुग़्ज़ कुफ़्र है; अरबों की मुहब्बत ईमान से है, जबकि उनसे बुग़्ज़ कुफ़्र है))।"
"156","[AI-translation] ((हसद ईमान को बिगाड़ता है जैसे इंदिरायन [कड़वी बूटी] शहद को बिगाड़ती है))।"
"157","[AI-translation] ((मिसवाक आधा ईमान है और वुज़ू आधा ईमान है))।"
"158","[AI-translation] ((सब्र का ईमान में वही मक़ाम है जो जिस्म में सिर का है))।"
"159","[AI-translation] ((सब्र आधा ईमान है, जबकि यक़ीन कामिल ईमान है))।"
"160","[AI-translation] ((मोमिन सब लोगों से ज़्यादा नर्म हैं क़त्ल [और ज़िबह] करने में))।"
"161","[AI-translation] ((नमाज़ ईमान का सुतून है, जिहाद अमल का कोहान है, और ज़कात दोनों के दरमियान है))।"
"162","[AI-translation] ((ऊनी लिबास अपनाओ, अपने दिलों में ईमान की मिठास पाओगे))।"
"163","[AI-translation] ((इल्म इस्लाम की ज़िन्दगी और ईमान का सुतून है))।"
"164","[AI-translation] ((जैसे शिर्क के साथ कोई चीज़ फ़ायदा नहीं देती, वैसे ही ईमान के साथ कोई चीज़ नुक़सान नहीं देती))।"
"165","[AI-translation] ((हर चीज़ की एक बुनियाद है, और ईमान की बुनियाद तक़वा है))।"
"166","[AI-translation] ((हर चीज़ का एक खुलासा है, और ईमान का खुलासा नमाज़ है, और नमाज़ का खुलासा पहली तकबीर [तकबीर-ए-तहरीमा] है))।"
"167","[AI-translation] ((मोमिन का ईमान कामिल नहीं जब तक वह आज़माइश को नेमत और ख़ुशहाली को मुसीबत न समझे))।"
"168","[AI-translation] ((ईमान की मिसाल क़मीज़ जैसी है; कभी पहनते हो और कभी उतारते हो))।"
"169","[AI-translation] ((जो शराब पिए, अल्लाह उससे ईमान उतार लेता है जैसे आदमी अपने सिर के ऊपर से क़मीज़ उतारता है))।"
"170","[AI-translation] ((जो सुबह फ़ज्र की नमाज़ के लिए जाए वह ईमान का झंडा लिए है, और जो सुबह बाज़ार जाए वह इबलीस का झंडा लिए है))।"
"171","[AI-translation] ((मदीना इस्लाम का गुम्बद और ईमान का घर है))।"
"172","[AI-translation] ((बन्दा हक़ीक़ी ईमान तक नहीं पहुँचता जब तक अपनी ज़बान को न रोके))।"
"173","[AI-translation] रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) से पूछा गया: ((सबसे अफ़ज़ल ईमान कौन-सा है?)) आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((हिजरत))।"
"174","[AI-translation] ((जो अल्लाह का ज़िक्र कसरत से न करे वह ईमान से बाहर है))।"
"175","[AI-translation] ((जिसमें हया नहीं उसमें ईमान नहीं))।"
"176","[AI-translation] ((ग़ीबत और चुग़ली ईमान को झाड़ देती हैं जैसे चरवाहा अपने जानवरों के लिए दरख़्त के पत्ते झाड़ता है))।"
"177","[AI-translation] ((वतन की मुहब्बत ईमान से है))।"
"178","[AI-translation] ((बिल्ली की मुहब्बत ईमान से है))।"
"179","[AI-translation] ((ईमान दिल में मज़बूत पहाड़ों की तरह जमा हुआ है; उसमें ज़्यादती या कमी कुफ़्र है))।"
"180","[AI-translation] ((सक़ीफ़ का वफ़्द रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) के पास आया और पूछा: ऐ अल्लाह के रसूल! क्या ईमान बढ़ता और घटता है? आप (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: नहीं, ईमान दिल में कामिल है; उसमें ज़्यादती कुफ़्र है और उसमें कमी शिर्क है))।"
"181","[AI-translation] ((ईमान न बढ़ता है न घटता है))।"
"182","[AI-translation] ((आदमी का ईमान कामिल नहीं जब तक वह मज़ाक़ में भी झूठ न छोड़े, और झगड़ा न छोड़े चाहे वह हक़ पर हो))।"
"183","[AI-translation] ((जिसने अपने ईमान में शक किया उसके आमाल बर्बाद हुए और वह आख़िरत में नुक़सान वालों में होगा))।"
"184","[AI-translation] ((जिसके हाथ पर कोई आदमी इस्लाम क़ुबूल करे उसके लिए जन्नत वाजिब हो गई))।"
"185","[AI-translation] ((जिसने कहा: अगर अल्लाह चाहे तो मैं मोमिन हूँ, तो इस्लाम में उसका कोई हिस्सा नहीं))।"
"186","[AI-translation] ((कामिल मोमिन वह है जो अपनी हर बात में 'इंशाअल्लाह' कहे))।"
"187","[AI-translation] ((जो हक़ीक़ी मोमिन न हो वह यक़ीनन हक़ीक़ी काफ़िर है))।"
"188","[AI-translation] ((मेरे नज़दीक मर्तबे और मक़ाम में मेरे दोस्तों में सबसे ज़्यादा रश्क के क़ाबिल वह मोमिन है जो दुबला हो और नमाज़ का बड़ा हिस्सा पाए))।"
"189","[AI-translation] ((अगर मोमिन के ख़ौफ़ और उसकी उम्मीद को तौला जाए तो दोनों बराबर होंगे))।"
"190","[AI-translation] ((जिसने बिदअती को डाँटा, अल्लाह तआला उसका दिल अमन और ईमान से भर देगा))।"
"191","[AI-translation] ((अल्लाह तआला ने घोड़ा पैदा किया और उसे दौड़ाया; वह पसीने से तर हुआ, तो अल्लाह तआला ने उस पसीने से अपनी ज़ात पैदा की))।"
"192","[AI-translation] ((अल्लाह और मख़लूक़ के दरमियान सत्तर हज़ार पर्दे हैं))।"
"193","[AI-translation] ((अल्लाह तआला ने हज़ार उम्मतें पैदा कीं; उनमें से छह सौ समन्दर में और चार सौ ख़ुश्की पर हैं))।"
"194","[AI-translation] ((दिल रब का घर है))।"
"195","[AI-translation] ((हर चीज़ में ग़ौर करो, लेकिन अल्लाह तआला की ज़ात में ग़ौर न करो))।"
"196","[AI-translation] ((सारी मख़लूक़ अल्लाह का कुनबा है, और उनमें अल्लाह को सबसे महबूब वह है जो उसके कुनबे को सबसे ज़्यादा फ़ायदा पहुँचाए))।"
"197","[AI-translation] ((अगर औरतें न होतीं तो अल्लाह की इबादत हक़ के साथ होती))।"
"198","[AI-translation] ((अगर औरत न होती तो मर्द जन्नत में दाख़िल होते))।"
"199","[AI-translation] ((नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) के वालिदैन को ज़िन्दा किया गया यहाँ तक कि वे आप (सल्लल्लाहु अलैहि वसल्लम) पर ईमान लाए))।"
"200","[AI-translation] ((पहले अल्लाह तआला ने क़लम पैदा किया, फिर नून पैदा किया, जो दवात है। इसका ज़िक्र अल्लाह तआला के फ़रमान «ن ، والقلم وما يسطرون» में है))।"
"201","[AI-translation] ((जब आदम (अलैहिस्सलाम) से ख़ता हुई तो उन्होंने कहा: ऐ रब! मैं मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) के हक़ के वसीले से तुझसे मग़फ़िरत माँगता हूँ। अल्लाह तआला ने फ़रमाया: ऐ आदम! तूने मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) को कैसे जाना जबकि मैंने अभी उसे पैदा नहीं किया? आदम (अलैहिस्सलाम) ने कहा: ऐ रब! जब तूने मुझे अपने हाथ से पैदा किया और मुझमें अपनी रूह फूँकी, मैंने सिर उठाया और देखा कि अर्श के सुतूनों पर लिखा था: अल्लाह के सिवा कोई माबूद नहीं, मुहम्मद अल्लाह के रसूल हैं। मैं समझ गया कि जिसका नाम तूने अपने नाम से मिलाया है वह तेरी मख़लूक़ में तुझे सबसे महबूब है। अल्लाह तआला ने फ़रमाया: ऐ आदम! तूने सच कहा! बेशक वह मख़लूक़ में मुझे सबसे महबूब है, तो उसके हक़ के वसीले से मुझसे माँग। मैंने तुझे बख़्श दिया, और अगर मुहम्मद (सल्लल्लाहु अलैहि वसल्लम) न होते तो मैं तुझे पैदा न करता))।"
"202","[AI-translation] ((दाऊद (अलैहिस्सलाम) ने कहा: ऐ अल्लाह! मैं तुझसे अपने आबा इब्राहीम, इस्हाक़ और याक़ूब के वसीले से माँगता हूँ))।"
"203","[AI-translation] ((जब तुम अल्लाह तआला से माँगो तो मेरे जाह [मर्तबे] के वसीले से माँगो))।"
"204","[AI-translation] जाबिर इब्ने अब्दुल्लाह (रज़ियल्लाहु अन्हु) ने अर्ज़ किया: ((ऐ अल्लाह के रसूल! मेरे माँ-बाप आप पर क़ुर्बान, मुझे बताइए सबसे पहली चीज़ जो अल्लाह तआला ने सब चीज़ों से पहले पैदा की))। नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((ऐ जाबिर! अल्लाह तआला ने सब चीज़ों से पहले तेरे नबी के नूर को अपने नूर से पैदा किया, और इस नूर को ऐसी क़ुदरत दी कि अपनी क़ुदरत से जहाँ अल्लाह चाहता वह चलता। उस वक़्त न लौह-ए-महफ़ूज़ था न क़लम, न जन्नत न जहन्नम, न कोई फ़रिश्ता, न ज़मीन और आसमान, न सूरज और चाँद, न जिन्न न इंसान))।"
"205","[AI-translation] ((मैं अल्लाह के नूर से [एक नूर] हूँ, और मोमिन मुझसे हैं। भलाई मुझसे है, और क़ियामत के दिन तक मेरी उम्मत में है))।"
"206","[AI-translation] ((मैं नबी था जबकि आदम (अलैहिस्सलाम) पानी और मिट्टी के दरमियान थे))।"
"207","[AI-translation] ((नबी (सल्लल्लाहु अलैहि वसल्लम) अँधेरे में ऐसे देखते थे जैसे रोशनी में देखते थे))।"
"208","[AI-translation] ((आले-मुहम्मद सब मुत्तक़ी हैं))।"
"209","[AI-translation] ((रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) का साया न धूप में दिखता था न चाँदनी में))।"
"210","[AI-translation] ((बेशक अल्लाह तआला ने मूसा (अलैहिस्सलाम) से कलाम किया, और मुझे अपनी दीदार अता की, मुझे मक़ाम-ए-महमूद से नवाज़ा, और मुझे हौज़-ए-कौसर अता किया जिस पर मोमिन आएँगे))।"
"211","[AI-translation] ((जब मुझे आसमानों की तरफ़ सफ़र कराया गया [यानी मेराज की रात], मैंने अपने रब को देखा। मेरे और उसके दरमियान एक ज़ाहिर पर्दा था। मैंने अपने रब की हर चीज़ देखी, यहाँ तक कि ताज भी))।"
"212","[AI-translation] ((मैंने अपने रब को मिना में ऊँट पर सवार, जुब्बा पहने देखा))।"
"213","[AI-translation] ((जिसने मेरी क़ब्र की ज़ियारत की उसके लिए शफ़ाअत वाजिब हो गई))।"
"214","[AI-translation] ((जुमुआ के दिन मुझ पर कसरत से दुरूद पढ़ो। यह वह दिन है जिसमें फ़रिश्ते हाज़िर होते हैं, और जो मुझ पर दुरूद भेजे, उसकी आवाज़ मुझ तक पहुँचती है वह जहाँ भी हो))। हमने पूछा: ((आपकी वफ़ात के बाद भी?)) नबी (सल्लल्लाहु अलैहि वसल्लम) ने जवाब दिया: ((मेरी वफ़ात के बाद भी। बेशक अल्लाह तआला ने ज़मीन पर अम्बिया के जिस्म खाना हराम किया है))।"
"215","[AI-translation] ((मैं ख़ातम-उन-नबिय्यीन हूँ; मेरे बाद कोई नबी नहीं, सिवाय इसके कि अल्लाह चाहे))।"
"216","[AI-translation] हज़रत मुआज़ इब्ने जबल (रज़ियल्लाहु अन्हु) से रिवायत है कि जब नबी-ए-करीम (सल्लल्लाहु अलैहि वसल्लम) ने उन्हें यमन भेजा तो उनसे पूछा: ((जब तेरे सामने मुक़द्दमे पेश हों तो तू कैसे फ़ैसला करेगा?)) उन्होंने जवाब दिया: ((अल्लाह की किताब के मुताबिक़ फ़ैसला करूँगा))। नबी (सल्लल्लाहु अलैहि वसल्लम) ने फ़रमाया: ((अगर मामला अल्लाह की किताब में न मिले?)) उन्होंने जवाब दिया: ((तो रसूलुल्लाह (सल्लल्लाहु अलैहि वसल्लम) की सुन्नत के मुताबिक़ फ़ैसला करूँगा))। नबी (सल्लल्लाहु अलैहि वसल्लम) ने फिर फ़रमाया: ((अगर मामला रसूल के सुन्नत में भी न मिले?)) उन्होंने जवाब दिया: ((तो अपनी राय से इज्तिहाद करूँगा और कोई कोशिश न छोड़ूँगा))। इस पर नबी (सल्लल्लाहु अलैहि वसल्लम) ने उनके सीने पर हाथ मारा और फ़रमाया: ((सब तारीफ़ अल्लाह के लिए है जिसने अल्लाह के रसूल के क़ासिद को उस काम की तौफ़ीक़ दी जो अल्लाह के रसूल को पसन्द है))।"
"217","[AI-translation] ((बेशक मेरे बाद कुछ लोग होंगे जो मुझसे हदीसें रिवायत करेंगे। उनकी रिवायत की हुई हदीसों को क़ुरआन पर परखो; जो क़ुरआन के मुवाफ़िक़ हों उन्हें क़ुबूल करो, और जो क़ुरआन के मुवाफ़िक़ न हों उन्हें क़ुबूल न करो))।"
"218","[AI-translation] ((जब हदीस लिखो तो उसे उसकी सनद के साथ लिखो))।"
"219","[AI-translation] ((अल्लाह तआला क़ुरआन के सिवा हर किताब की सेहत का इनकार करता है))।"
"220","[AI-translation] ((मेरा कलाम अल्लाह के कलाम को मंसूख़ नहीं कर सकता, लेकिन अल्लाह का कलाम मेरे कलाम को मंसूख़ कर सकता है))।"
"221","[AI-translation] ((जो मेरी उम्मत के दीनी मामलात के बारे में चालीस हदीसें याद करे, अल्लाह तआला उसे [क़ियामत के दिन] फ़क़ीह बनाकर उठाएगा))।"
"222","[AI-translation] ((जब तुमसे कोई हदीस रिवायत की जाए जिसे तुम पहचानते हो तो उसे क़ुबूल करो, और जब तुमसे कोई हदीस रिवायत की जाए जो तुम्हें अजनबी लगे तो उसे क़ुबूल न करो))।"
