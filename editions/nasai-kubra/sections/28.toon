hadiths[165]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4456","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حدثَنَا بشْرٌ يَعْنِي ابْنَ الْمُفَضَّلِ ، قَالَ : حدثَنَا شُعْبَةُ ، عَنِ الْحَكَمِ ، عَنِ ابْنِ أَبِي لَيْلَى ، عَنْ عَبْدِ اللَّهِ بْنِ عُكَيْمٍ ، قَالَ :  قُرِئَ عَلَيْنَا كِتَابُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ أَرْضِ جُهَيْنَةَ وَأَنَا غُلامٌ شَابٌّ : أَنْلا تَنْتَفِعُوا مِنَ الْمَيْتَةِ بِشَيْءٍ بِإِهَابٍ ، وَلا عَصْبٍ """"""","","Sunan al-Kubra al-Nasai 4456","","أَخْبَرَنَا سُلَيْمَانُ بْنُ دَاوُدَ عَنِ ابْنِ وَهْبٍ قَالَ أَخْبَرَنِي عَمْرٌو عَنْ بُكَيْرِ بْنِ الْأَشَجِّ عَنْ مُعَاذِ بْنِ عَبْدِ اللهِ بْنِ خُبَيْبٍ عَنْ عُقْبَةَ بْنِ عَامِرٍ قَالَ","The Book of Fara' and Atirah"
"4457","أَخْبَرَنَا مُحَمَّدُ بْنُ قُدَامَةَ ، قَالَ : حدثَنَا جرِيرٌ ، عَنْ مَنْصُورٍ ، عَنِ الْحَكَمِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، عَنْ عَبْدِ اللَّهِ بْنِ عُكَيْمٍ ، قَالَ :  كَتَبَ إِلَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَنْلا تَسْتَمْتِعُوا مِنَ الْمَيْتَةِ بِإِهَابٍ ، وَلا عَصْبٍ """"""","Sahih|Daif|Isnaad Sahih","Sunan al-Kubra al-Nasai 4457","","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ فِي حَدِيثِهِ عَنْ أَبِي الْأَحْوَصِ عَنْ عَاصِمِ بْنِ كُلَيْبٍ عَنْ أَبِيهِ قَالَ","The Book of Fara' and Atirah"
"4458","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ ، قَالَ : حدثَنَا شَرِيكٌ ، عَنْ هِلالٍ الْوَزَّانِ ، عَنْ عَبْدِ اللَّهِ بْنِ عُكَيْمٍ ، قَالَ :  كَتَبَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى جُهَيْنَةَ أَنْلا تَسْتَمْتِعُوا مِنَ الْمَيْتَةِ بِإِهَابٍ ، وَلا عَصْبٍ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : أَصَحُّ مَا فِي هَذَا الْبَابِ فِي جُلُودِ الْمَيْتَةِ إِذَا دُبِغَتْ ، حَدِيثُ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَيْمُونَةَ ، وَاللَّهُ تَعَالَى أَعْلَمُ""","","Sunan al-Kubra al-Nasai 4458","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا خَالِدٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ عَاصِمِ بْنِ كُلَيْبٍ قَالَ سَمِعْتُ أَبِي يُحَدِّثُ عَنْ رَجُلٍ قَالَ","The Book of Fara' and Atirah"
"4459","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَنَا بِشْرُ بْنُ عُمَرَ ، قَالَ : حدثَنَا مَالِكٌ . ح وَالْحَارِثُ بْنُ مِسْكِينٍ ، قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ ، عَنِ ابْنِ الْقَاسِمِ ، قَالَ : حَدَّثَنِي مَالِكٌ ، عَنْ يَزِيدَ بْنِ عَبْدِ اللَّهِ بْنِ قُسَيْطٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ ، عَنْ أُمّْه ، عَنْ عَائِشَةَ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَأَمَرَ أَنْ يُسْتَمْتَعَ بِجُلُودِ الْمَيْتَةِ إِذَا دُبِغَتْ """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 4459","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ رَاهَوَيْهِ قَالَ أَخْبَرَنَا إِسْمَاعِيلُ عَنْ عَبْدِ الْعَزِيزِ عَنْ أَنَسٍ","The Book of Fara' and Atirah"
"4460","أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، عَنْ يَحْيَى ، عَنِ ابْنِ أَبِي عَرُوبَةَ ، قَالَ : ثنا قَتَادَةُ ، عَنْ أَبِي الْمَلِيحِ ، عَنْ أَبِيهِ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ جُلُودِ السِّبَاعِ """"""","","Sunan al-Kubra al-Nasai 4460","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى عَنْ خَالِدٍ قَالَ حَدَّثَنَا حُمَيْدٌ عَنْ ثَابِتٍ عَنْ أَنَسٍ قَالَ","The Book of Fara' and Atirah"
"4461","أَخْبَرَنِي عَمْرُو بْنُ عُثْمَانَ ، قَالَ : حدثَنَا بقِيَّةُ ، عَنْ بَحِيرٍ ، عَنْ خَالِدِ بْنِ مَعْدَانَ ، عَنِ الْمِقْدَامِ بْنِ مَعْدِي كْرِبَ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنِ الْحَرِيرِ ، وَالذَّهَبِ ، وَمَيَاثِرِ النُّمُورِ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 4461","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنْ قَتَادَةَ عَنْ أَنَسٍ قَالَ","The Book of Fara' and Atirah"
"4462","أَخْبَرَنَا عَمْرُو بْنُ عُثْمَانَ ، قَالَ : حدثَنَا بقِيَّةُ ، عَنْ بَحِيرٍ ، عَنْ خَالِدٍ ، قَالَ : وَفَدَ الْمِقْدَامُ بْنُ مَعْدِ يَكْرِبَ ، عَلَى مُعَاوِيَةَ ، فَقَالَ لَهُ :  أَنْشُدُكَ بِاللَّهِ ، هَلْ تَعْلَمُ أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ لُبْسِ جُلُودِ السِّبَاعِ وَالرُّكُوبِ عَلَيْهَا ؟ قَالَ : نَعَمْ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : أَصَحُّ مَا فِي هَذَا الْبَابِ جُلُودُ الْمَيْتَةِ إِذَا دُبِغَتْ حَدِيثُ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ ، عَنِ ابْنِ عَبَّاسٍ""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4462","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ عَنْ أَيُّوبَ عَنْ مُحَمَّدِ بْنِ سِيرِينَ عَنْ أَنَسِ بْنِ مَالِكٍ قَالَ","The Book of Fara' and Atirah"
"4463","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حدثَنَا اللَّيْثُ ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَامَ الْفَتْحِ وَهُوَ بِمَكَّةَ يَقُولُ : إِنَّ اللَّهَ عَزَّ وَجَلَّ وَرَسُولَهُ حَرَّمَ بَيْعَ الْخَمْرِ ، وَالْمَيْتَةِ ، وَالْخِنْزِيرِ ، وَالأَصْنَامِ ، فَقِيلَ : يَا رَسُولَ اللَّهِ ، أَرَأَيْتَ شُحُومَ الْمَيْتَةِ ، فَإِنَّهُ يُطْلَى بِهَا السُّفُنُ ، وَيُدَّهَنُ بِهَا الْجُلُودُ ، وَيَسْتَصْبِحُ بِهَا النَّاسُ ، فَقَالَ : لا ، هُوَ حَرَامٌ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عِنْدَ ذَلِكَ : قَاتَلَ اللَّهُ الْيَهُودَ إِنَّ اللَّهَ عَزَّ وَجَلَّ لَمَّا حَرَّمَ عَلَيْهِمُ الشُّحُومَ جَمَّلُوهُ ثُمَّ بَاعُوهُ فَأَكَلُوا ثَمَنَهُ """"""","","Sunan al-Kubra al-Nasai 4463","","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ فِي حَدِيثِهِ عَنْ يَزِيدَ بْنِ زُرَيْعٍ عَنِ ابْنِ عَوْنٍ عَنْ مُحَمَّدٍ عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي بَكْرَةَ عَنْ أَبِيهِ قَالَ ثُمَّ انْصَرَفَ","The Book of Fara' and Atirah"
"4464","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أَنْبَأَنَا سُفْيَانُ ، عَنْ عَمْرٍو ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ :  أُبْلِغَ عُمَرُ ، أَنَّ سَمُرَةَ بَاعَ خَمْرًا ، قَالَ : قَاتَلَ اللَّهُ سَمُرَةَ ، أَلَمْ يَعْلَمْ أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ :قَاتَلَ اللَّهُ الْيَهُودَ ، حُرِّمَتْ عَلَيْهِمُ الشُّحُومُ فَجَمَّلُوهَا "". قَالَ سُفْيَانُ : يَعْنِي أَذَابُوهَا""","Sahih|Sahih|Daif","Sunan al-Kubra al-Nasai 4464","","أَخْبَرَنَا عَبْدُ اللهِ بْنُ سَعِيدِ بْنِ الْأَشَجُّ قَالَ حَدَّثَنَا حَفْصٌ عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ عَنْ أَبِيهِ عَنْ أَبِي سَعِيدٍ قَالَ","The Book of Fara' and Atirah"
"4465","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حدثَنَا سفْيَانُ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَيْمُونَةَ ، أَنَّ فَأْرَةً وَقَعَتْ فِي سَمْنٍ فَمَاتَتْ ، فَسُئِلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ : أَلْقُوهَا وَمَا حَوْلَهَا وَكُلُوهُ """"""","","Sunan al-Kubra al-Nasai 4465","","أَخْبَرَنَا أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ الْحَكَمِ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ حَدَّثَنَا شُعْبَةُ قَالَ حَدَّثَنَا سُفْيَانُ الثَّوْرِيُّ عَنْ أَبِيهِ عَنْ عَبَايَةَ بْنِ رِفَاعَةَ بْنِ رَافِعٍ عَنْ جَدِّهِ رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Fara' and Atirah"
"4466","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ ، وَمُحَمَّدُ بْنُ يَحْيَى بْنِ عَبْدِ اللَّهِ النَّيْسَابُورِيُّ ، عَنْ عَبْدِ الرَّحْمَنِ ، عَنْ مَالِكٍ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَيْمُونَةَ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ سُئِلَ عَنْفَأْرَةٍ وَقَعَتْ فِي سَمْنٍ جَامِدٍ ، فَقَالَ : خُذُوهَا وَمَا حَوْلَهَا فَأَلْقُوهُ """"""","Sahih|Sahih|Isnaad Hasan","Sunan al-Kubra al-Nasai 4466","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رُزْمَةَ بْنِ غَزْوَانَ قَالَ أَخْبَرَنَا الْفَضْلُ بْنُ مُوسَى عَنْ حُسَيْنِ بْنِ وَاقِدٍ عَنْ عِلْبَاءِ بْنِ أَحْمَرَ عَنْ عِكْرِمَةَ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Fara' and Atirah"
"4467","أَخْبَرَنَا خُشَيْشُ بْنُ أَصْرَمَ ، قَالَ : حدثَنَا عَبْدُ الرَّزَّاقِ ، قَالَ : أَخْبَرَنِي عَبْدُ الرَّحْمَنِ بْنُ بُوذَوَيْهِ ، أَنَّ مَعْمَرًا ذَكَرَهُ ، عَنِ الزُّهْرِيِّ ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ ، عَنِ ابْنِ عَبَّاسٍ ، عَنْ مَيْمُونَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُ سُئِلَ عَنِالْفَأْرَةِ تَقَعُ فِي السَّمْنِ ، فَقَالَ : إِنْ كَانَ جَامِدًا فَأَلْقُوهُ ، وَمَا حَوْلَهَا وَإِنْ كَانَ مَائِعًا فَلا تَقْرَبُوهُ """"""","","Sunan al-Kubra al-Nasai 4467","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى عَنْ يَحْيَى عَنْ عَبْدِ الْمَلِكِ عَنْ عَطَاءٍ عَنْ جَابِرٍ قَالَ","The Book of Fara' and Atirah"
"4468","أَخْبَرَنَا سَلَمَةُ بْنُ أَحْمَدَ بْنِ سُلَيْمِ بْنِ عُثْمَانَ الْفَوْزِيُّ ، قَالَ : حدثَنَا جَدِّي الْخَطَّابُ يَعْنِي ابْنَ عُثْمَانَ ، قَالَ : حدثَنَا مُحَمَّدُ بْنُ حِمْيَرٍ ، قَالَ : حدثَنَا ثَابِتُ بْنُ عَجْلانَ ، قَالَ : سَمِعْتُ سَعِيدَ بْنَ جُبَيْرٍ ، يَقُولُ : سَمِعْتُ ابْنَ عَبَّاسٍ ، يَقُولُ :  إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَمَرَّ بِعَنْزٍ مَيِّتَةٍ فَقَالَ : مَا كَانَ عَلَى أَهْلِ هَذِهِ الشَّاةِ لَوِ انْتَفَعُوا بِإِهَابِهَا """"""","Sahih Isnaad|Sahih Isnaad|Isnaad Sahih","Sunan al-Kubra al-Nasai 4468","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا يَحْيَى عَنْ يَحْيَى وَأَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا يَحْيَى بْنِ سَعِيدٍ عَنْ بَشِيرِ بْنِ يَسَارٍ عَنْ أَبِي بُرْدَةَ بْنِ نِيَارٍ","The Book of Fara' and Atirah"
"4469","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا يَحْيَى قَالَ : حدثَنَا ابْنُ أَبِي ذِئْبٍ ، قَالَ : حَدَّثَنِي سَعِيدُ بْنُ خَالِدٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : إِذَا وَقَعَ الذُّبَابُ فِي إِنَاءِ أَحَدِكُمْ فَلْيَمْقُلْهُ """"""","","Sunan al-Kubra al-Nasai 4469","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنِ الْأَسْوَدِ بْنِ قَيْسٍ عَنْ جُنْدُبِ بْنِ سُفْيَانَ قَالَ","The Book of Fara' and Atirah"
"4470","أَخْبَرَنَا مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ صُدْرَانَ الْبَصْرِيُّ ، قَالَ : أَنْبَأَنَا خَالِدٌ وَهُوَ ابْنُ الْحَارِثِ ، قَالَ : قَرَأْتُ عَلَى عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ ، أَخْبَرَنِي أَبِي ، عَنْ رَافِعِ بْنِ أُسَيْدِ بْنِ ظُهَيْرٍ ، عَنْ أَبِيهِ أُسَيْدِ بْنِ ظُهَيْرٍ ،  أَنَّهُ خَرَجَ إِلَى قَوْمِهِ إِلَى بَنِي حَارِثَةَ ، فَقَالَ : يَا بَنِي حَارِثَةَ لَقَدْ دَخَلَتْ عَلَيْكُمْ مُصِيبَةٌ ، قَالُوا : وَمَا هِيَ ؟ قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ كِرَاءِ الأَرْضِ ، قُلْنَا : يَا رَسُولَ اللَّهِ ، إِذًا نُكْرِيهَا بِشَيْءٍ مِنَ الْحَبِّ ، قَالَ : لا ، قَالَ : وَكُنَّا نُكْرِيهَا بِالتِّينِ ، فَقَالَ : لا ، وَكُنَّا نُكْرِيهَا بِمَا عَلَى الرَّبِيعِ السَّاقِي ، قَالَ : لا ازْرَعْهَا أَوِ امْنَحْهَا أَخَاكَ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4470","","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ عَنِ ابْنِ أَبِي زَائِدَةَ قَالَ أَخْبَرَنَا أَبِي عَنْ فِرَاسٍ عَنْ عَامِرٍ عَنِ الْبَرَاءِ بْنِ عَازِبٍ قَالَ وَأَخْبَرَنِي دَاوُدُ بْنُ أَبِي هِنْدٍ عَنِ عَامِرٍ عَنِ الْبَرَاءِ بْنِ عَازِبٍ فَذَكَرَ أَحَدُهُمَا مَا لَمْ يَذْكُرِ الْآخَرُ قَالَ","The Book of Sharecropping"
"4471","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ الْمُبَارَكِ ، قَالَ : حدثَنَا يَحْيَى وَهُوَ ابْنُ آدَمَ ، قَالَ : حدثَنَا مُفَضَّلٌ وَهُوَ ابْنُ مُهَلْهِلٍ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ ، عَنْ أُسَيْدِ بْنِ ظُهَيْرٍ ، قَالَ : جَاءَنَا رَافِعُ بْنُ خَدِيجٍ ، فَقَالَ :  إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَاكُمْ عَنِ الْحَقْلِ ، وَالْحَقْلُ الثُّلُثُ وَالرُّبُعُ ، وَعَنِ الْمُزَابَنَةِ ، وَالْمُزَابَنَةُ شِرَاءُ مَا فِي رُءُوسِ النَّخْلِ بِكَذَا وَكَذَا وَسْقًا مِنْ تَمْرٍ """"""","","Sunan al-Kubra al-Nasai 4471","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا أَبُو الْأَحْوَصِ عَنْ مَنْصُورٍ عَنِ الشَّعْبِيِّ عَنِ الْبَرَاءِ قَالَ","The Book of Sharecropping"
"4472","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حدثَنَا مُحَمَّد ، قَالَ : حدثَنَا شُعْبَةُ ، عَنْ مَنْصُورٍ ، سَمِعْتُ مُجَاهِدًا ، يُحَدِّثُ عَنْ أُسَيْدِ بْنِ ظُهَيْرٍ ، قَالَ : أَتَانًا رَافِعُ بْنُ خَدِيجٍ ، فَقَالَ :  نَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَطَاعَةُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَيْرٌ لَكُمْنَهَاكُمْ عَنِ الْحَقْلِ ، وَقَالَ : مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَمْنَحْهَا أَوْ لِيَدَعْهَا ، وَنَهَى عَنِ الْمُزَابَنَةِ ، وَالْمُزَابَنَةُ ، الرَّجُلُ يَكُونُ لَهُ الْمَالُ الْعَظِيمُ مِنَ النَّخْلِ ، فَيَجِيءُ الرَّجُلُ فَيَأْخُذُهَا بِكَذَا وَكَذَا وَسْقًا مِنْ تَمْرٍ """"""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 4472","","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ قَالَ حَدَّثَنَا ابْنُ عُلَيَّةَ قَالَ حَدَّثَنَا أَيُّوبُ عَنْ مُحَمَّدٍ عَنْ أَنَسٍ قَالَ","The Book of Sharecropping"
"4473","أَخْبَرَنِي مُحَمَّدُ بْنُ قُدَامَةَ ، قَالَ : حدثَنَا جرِيرٌ ، عَنْ مَنْصُورٍ ، عَنْ مُجَاهِدٍ ، عَنْ أُسَيْدِ بْنِ ظُهَيْرٍ ، قَالَ : أَتَى عَلَيْنَا رَافِعُ بْنُ خَدِيجٍ ، فَقَالَ : وَلَمْ أَفْهَمْ ، فَقَالَ :  إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَاكُمْ عَنْ أَمْرٍ كَانَ يَنْفَعُكُمْ ، وَطَاعَةُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَيْرٌ لَكُمْ مِمَّا يَنْفَعُكُمْ ،نَهَاكُمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْحَقْلِ ، وَالْحَقْلُ الْمُزَارَعَةُ بِالثُّلُثِ ، وَالرُّبُعِ فَمَنْ كَانَ لَهُ أَرْضٌ فَاسْتَغْنَى عَنْهَا ، فَلْيَمْنَحْهَا أَخَاهُ أَوْ لِيَدَعْ ، وَنَهَاكُمْ عَنِ الْمُزَابَنَةِ ، وَالْمُزَابَنَةُ ، الرَّجُلُ يَجِيءُ إِلَى النَّخْلِ الْكَثِيرِ بِالْمَالِ الْعَظِيمِ فَيَقُولُ : خُذْهُ بِكَذَا وَكَذَا وَسْقًا مِنْ تَمْرٍ ذَلِكَ الْعَامَ """"""","","Sunan al-Kubra al-Nasai 4473","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ قَالَ أَخْبَرَنَا دَاوُدُ عَنْ عَامِرٍ عَنْ مُحَمَّدِ بْنِ صَفْوَانَ","The Book of Sharecropping"
"4474","أَخْبَرَنِي إِسْحَاقُ بْنُ يَعْقُوبَ بْنِ إِسْحَاقَ ، قَالَ : حدَّثَنَا عَفَّانُ ، قَالَ : حدثَنَا عَبْدُ الْوَاحِدِ ، قَالَ : حدثَنَا سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ مُجَاهِدٍ ، قَالَ : حَدَّثَنِي أُسَيْدُ ابْنُ أَخِي رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَافِعُ بْنُ خَدِيجٍ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَطَاعَةُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْفَعُ لَنَا قَالَ :مَنْ كَانَتْ لَهُ أَرْضٌ ، فَلْيَزْرَعْهَا فَإِنْ عَجَزَ عَنْهَا فَلْيُزْرِعْهَا أَخَاهُ """"""","","Sunan al-Kubra al-Nasai 4474","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ عَنْ مُحَمَّدِ بْنِ جَعْفَرٍ قَالَ حَدَّثَنَا شُعْبَةُ قَالَ سَمِعْتُ حَاضِرَ بْنَ الْمُهَاجِرِ الْبَاهِلِيَّ قَالَ سَمِعْتُ سُلَيْمَانَ بْنَ يَسَارٍ يُحَدِّثُ عَنْ زَيْدِ بْنِ ثَابِتٍ","The Book of Sharecropping"
"4475","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أنبأ عُبَيْدُ اللَّهِ يَعْنِي ابْنَ عَمْرٍو ، عَنْ عَبْدِ الْكَرِيمِ ، عَنْ مُجَاهِدٍ ، قَالَ : أَخَذْتُ بِيَدِ طَاوُسٍ حَتَّى أَدْخَلْتُهُ عَلَى ابْنِ رَافِعِ بْنِ خَدِيجٍ ، فَحَدَّثَهُ ، عَنْ أَبِيهِ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ،  أَنَّهُنَهَى عَنْ كِرَاءِ الأَرْضِ ""، فَأَبَى طَاوُسٌ ، فَقَالَ : سَمِعْتُ ابْنَ عَبَّاسٍ لا يَرَى بِذَلِكَ بَأْسًا ، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَرَوَاهُ أَبُو عَوَانَةَ ، عَنْ أَبِي حَصِينٍ ، عَنْ مُجَاهِدٍ ، قَالَ : قَالَ : عَنْ رَافِعٍ ، مُرْسَلٌ""","","Sunan al-Kubra al-Nasai 4475","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى وَإِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَا حَدَّثَنَا خَالِدٌ عَنْ شُعْبَةَ عَنْ سِمَاكٍ قَالَ سَمِعْتُ ابْنَ قَطَرِيٍّ وَاسْمُهُ مُرَيٌّ","The Book of Sharecropping"
"4476","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حدثَنَا أَبُو عَوَانَةَ ، عَنْ أَبِي حَصِينٍ ، عَنْ مُجَاهِدٍ ، قَالَ : قَالَ رَافِعُ بْنُ خَدِيجٍ :  نَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ،وَأَمْرُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى الرَّأْسِ وَالْعَيْنِ ، نَهَانَا أَنْ نَتَقَبَّلَ الأَرْضَ بِبَعْضِ خَرْاجِهَا """"""","","Sunan al-Kubra al-Nasai 4476","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَعْمَرٍ قَالَ حَدَّثَنَا حَبَّانُ بْنُ هِلَالٍ قَالَ أَخْبَرَنَا جَرِيرُ بْنُ حَازِمٍ قَالَ حَدَّثَنَا أَيُّوبُ عَنْ زَيْدِ بْنِ أَسْلَمَ فَلَقِيتُ زَيْدَ بْنَ أَسْلَمَ فَحَدَّثَنِي عَنْ عَطَاءِ بْنِ يَسَارٍ عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ","The Book of Sharecropping"
"4477","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ ، عَنْ عُبَيْدِ اللَّهِ ، قَالَ : حدثَنَا إِسْرَائِيلُ ، عَنْ إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ، عَنْ مُجَاهِدٍ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  مَرَّ النَّبِي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى أَرْضِ رَجُلٍ مِنَ الأَنْصَارِ قَدْ عُرِفَ أَنَّهُ مُحْتَاجٌ ، فَقَالَ : لِمَنْ هَذِهِ الأَرْضُ ؟ قَالَ : لِفُلانٍ أَعْطَانِيهَا بِالأَجْرِ ، فَقَالَ :لَوْ مَنَحَهَا أَخَاهُ ، فَأَتَى رَافِعٌ الأَنْصَارَ ، فَقَالَ : إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَاكُمْ عَنْ أَمْرٍ كَانَ بِكُمْ رَافِقًا وَطَاعَةُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْفَعُ لَكُمْ """"""","","Sunan al-Kubra al-Nasai 4477","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَنْصُورٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ عُمَرَ بْنِ سَعِيدٍ عَنْ أَبِيهِ عَنْ عَبَايَةَ بْنِ رِفَاعَةَ عَنْ رَافِعِ بْنِ خَدِيجٍ","The Book of Sharecropping"
"4478","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالا : حدثَنَا مُحَمَّدٌ ، قَالَ : حدثَنَا شُعْبَةُ ، عَنِ الْحَكَمِ ، عَنْ مُجَاهِدٍ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْحَقْلِ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4478","","أَخْبَرَنَا هَنَّادُ بْنُ السَّرِيِّ عَنْ أَبِي الْأَحْوَصِ عَنْ سَعِيدِ بْنِ مَسْرُوقٍ عَنْ عَبَايَةَ بْنِ رِفَاعَةَ عَنْ أَبِيهِ عَنْ جَدِّهِ رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Sharecropping"
"4479","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، عَنْ خَالِدٍ وَهُوَ ابْنُ الْحَارِثِ ، قَالَ : حدثَنَا شُعْبَةُ ، عَنْ عَبْدِ الْمَلِكِ ، عَنْ مُجَاهِدٍ ، قَالَ : حَدَّثَ رَافِعُ بْنُ خَدِيجٍ ، قَالَ :  خَرَجَ إِلَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَنَهَانَا عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، فَقَالَ :مَنْ كَانَ لَهُ أَرْضٌ ، فَلْيَزْرَعْهَا أَوْ يَمْنَحْهَا أَخَاهُ أَوْ يَذَرْهَا """"""","","Sunan al-Kubra al-Nasai 4479","","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ قَالَ أَخْبَرَنَا إِسْمَاعِيلُ عَنْ خَالِدٍ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْأَشْعَثِ عَنْ شَدَّادٍ قَالَ اثْنَتَانِ حَفِظْتُهُمَا","The Book of Sharecropping"
"4480","أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ خَالِدٍ ، قَالَ : حدَّثَنَا حَجَّاجٌ ، قَالَ : حَدَّثَنِي شُعْبَةُ ، عَنْ عَبْدِ الْمَلِكِ ، عَنْ عَطَاءٍ ، وَطَاوُسٍ ، وَمُجَاهِدٍ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  خَرَجَ إِلَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَنَهَانَا عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا وَأَمْرُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ خَيْرٌ لَنَا قَالَ :مَنْ كَانَ لَهُ أَرْضٌ ، فَلْيَزْرَعْهَا أَوْ لِيَذَرْهَا أَوْ لِيَمْنَحْهَا ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَمِمَّا يَدُلُّ عَلَى أَنَّ طَاوُسًا لَمْ يَسْمَعْ هَذَا الْحَدِيثَ مِنْ رَافِعِ بْنِ خَدِيجٍ ، أَنَّ""","","Sunan al-Kubra al-Nasai 4480","","أَخْبَرَنَا عِيسَى بْنُ أَحْمَدَ الْبَلْخِيُّ قَالَ حَدَّثَنَا ابْنُ وَهْبٍ قَالَ حَدَّثَنِي سُفْيَانُ أَنَّ هِشَامَ بْنَ عُرْوَةَ حَدَّثَهُ عَنْ فَاطِمَةَ بِنْتِ الْمُنْذِرِ عَنْ أَسْمَاءَ بِنْتِ أَبِي بَكْرٍ قَالَتْ","The Book of Sharecropping"
"4481","مُحَمَّدَ بْنَ عَبْدِ اللَّهِ بْنِ الْمُبَارَكِ أخبرنا ، قَالَ : حدثَنَا زَكَرِيَّا بْنُ عَدِيٍّ ، قَالَ : حدثَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : كَانَ طَاوُسٌ يَكْرَهُ أَنْ يُؤَاجِرَ أَرْضَهُ بِالذَّهَبِ وَالْفِضَّةِ ، وَلا يَرَى بِالثُّلُثِ وَالرُّبُعِ بَأْسًا ، فَقَالَ لَهُ مُجَاهِدٌ : اذْهَبْ إِلَى ابْنِ رَافِعِ بْنِ خَدِيجٍ فَاسْمَعْ مِنْهُ حَدِيثَهُ ، فَقَالَ : إِنِّي وَاللَّهِ لَوْ أَعْلَمُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهُ مَا فَعَلْتُهُ ، وَلَكِنْ حَدَّثَنِي مَنْ هُوَ أَعْلَمُ مِنْهُ ابْنُ عَبَّاسٍ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِنَّمَا قَالَ : لأَنْ يَمْنَحَ أَحَدُكُمْ أَخَاهُ أَرْضَهُ خَيْرٌ مِنْ أَنْ يَأْخُذَ عَلَيْهَا خَرَاجًا مَعْلُومًا ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَقَدِ اخْتُلِفَ عَلَى عَطَاءٍ فِي هَذَا الْحَدِيثِ ، فَقَالَ : عَبْدُ الْمَلَكِ بْنُ مَيْسَرَةَ ، عَنْ عَطَاءٍ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، وَقَدْ تَقَدَّمَ ذِكْرُنَا لَهُ وَقَالَ : عَبْدُ الْمَلَكِ بْنُ أَبِي سُلَيْمَانَ ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ""","","Sunan al-Kubra al-Nasai 4481","","أَخْبَرَنَا مُحَمَّدُ بْنُ بَشَّارٍ عَنْ مُحَمَّدِ بْنِ جَعْفَرٍ قَالَ حَدَّثَنَا شُعْبَةُ قَالَ سَمِعْتُ حَاضِرَ بْنَ الْمُهَاجِرِ الْبَاهِلِيَّ قَالَ سَمِعْتُ سُلَيْمَانَ بْنَ يَسَارٍ يُحَدِّثُ عَنْ زَيْدِ بْنِ ثَابِتٍ","The Book of Sharecropping"
"4482","حدثَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حدثَنَا خالِدُ بْنُ الْحَارِثِ ، قَالَ : حدثَنَا عَبْدُ الْمَلِكِ ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ كَانَ لَهُ أَرْضٌ فَلْيَزْرَعْهَا ، فَإِنْ عَجَزَ أَنْ يَزْرَعْهَا ، فَلْيَمْنَحْهَا أَخَاهُ الْمُسْلِمَ ، وَلا يُزْرِعْهَا إِيَّاهُ """"""","Daif|Daif|Daif","Sunan al-Kubra al-Nasai 4482","","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ عَنْ حَمَّادِ بْنِ سَلَمَةَ عَنْ أَبِي الْعُشَرَاءِ عَنْ أَبِيهِ قَالَ","The Book of Sharecropping"
"4483","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا يَحْيَى قَالَ : حدثَنَا عَبْدُ الْمَلِكِ ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ كَانَتْ لَهُ أَرْضٌ ، فَلْيَزْرَعْهَا أَوْ لِيَمْنَحْهَا أَخَاهُ ، وَلا يُكْرِيهَا """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4483","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ عَنْ شُعْبَةَ عَنْ سَعِيدِ بْنِ مَسْرُوقٍ عَنْ عَبَايَةَ بْنِ رِفَاعَةَ عَنْ رَافِعٍ قَالَ","The Book of Sharecropping"
"4484","أَخْبَرَنَا هِشَامُ بْنُ عَمَّارٍ ، عَنْ يَحْيَى بْنِ حَمْزَةَ ، قَالَ : حدثَنَا الأَوْزَاعِي ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ ، قَالَ :  كَانَ لأُنَاسٍ فَضْلُ أَرَضِينَ يُكْرُونَهَا بِالنِّصْفِ وَالثُّلُثِ وَالرُّبُعِ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا أَوْ يُزْرِعْهَا أَوْ يُمْسِكْهَا """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4484","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ أَخْبَرَنَا يَحْيَى بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ قَالَ حَدَّثَنِي أَبِي عَنْ عَبَايَةَ بْنِ رِفَاعَةَ عَنْ رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Sharecropping"
"4485","أَخْبَرَنَا عِيسَى بْنُ مُحَمَّدٍ وَهُوَ أَبُو عُمَيْرِ بْنِ النَّحَّاسِ ، وَعِيسَى بْنِ يُونُسَ هُوَ الْفَاخُورِي ، قَالا : حدثَنَا ضَمْرَةُ ، عَنِ ابْنِ شَوْذَبٍ ، عَنْ مَطَرِ بْنِ طَهْمَانَ ، عَنْ عَطَاءٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ، قَالَ : خَطَبَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : مَنْ كَانَتْ لَهُ أَرْضٌ ، فَلْيَزْرَعْهَا أَوْ لِيُزْرِعْهَا ، وَلا يُؤَاجِّرْهَا """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4485","","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ يَعْقُوبَ قَالَ حَدَّثَنَا عُبَيْدُ اللهِ بْنُ مُوسَى قَالَ أَخْبَرَنَا إِسْرَائِيلُ عَنْ مَنْصُورٍ عَنْ خَالِدٍ الْحَذَّاءِ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي أَسْمَاءَ الرَّحَبِيِّ عَنْ أَبِي الْأَشْعَثِ عَنْ شَدَّادِ بْنِ أَوْسٍ قَالَ","The Book of Sharecropping"
"4486","أَخْبَرَنَا مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ ، عَنْ يُونُسَ ، قَالَ : حدثَنَا حَمَّادٌ ، عَنْ مَطَرٍ ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ ، رَفَعَهُ : نَهَى عَنْ كِرَاءِ الأَرْضِ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4486","","أَخْبَرَنَا الْحُسَيْنُ بْنُ حُرَيْثٍ أَبُو عَمَّارٍ قَالَ أَخْبَرَنَا جَرِيرٌ عَنْ مَنْصُورٍ عَنْ خَالِدٍ الْحَذَّاءِ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْأَشْعَثِ الصَّنْعَانِيِّ عَنْ شَدَّادِ بْنِ أَوْسٍ قَالَ","The Book of Sharecropping"
"4487","أَخْبَرَنَا قُتَيْبَةُ بْنِ سَعِيدٍ ، قَالَ : حدثَنَا الْمُفَضَّلُ ، عَنِ ابْنِ جُرَيْجٍ ، عَنْ عَطَاءٍ ، وَأَبِي الزُّبَيْرِ ، عَنْ جَابِرٍ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنِ الْمُخَابَرَةِ ، وَالْمُزَابَنَةِ ، وَالْمُحَاقَلَةِ ، وَبَيْعِ الثَّمَرِ حَتَّى يُطْعَمَ إِلا الْعَرَايَا """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4487","","أَخْبَرَنَا مُحَمَّدُ بْنُ رَافِعٍ النَّيْسَابُورِيُّ قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ قَالَ أَخْبَرَنَا مَعْمَرٌ عَنْ أَيُّوبَ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْأَشْعَثِ عَنْ شَدَّادِ بْنِ أَوْسٍ قَالَ","The Book of Sharecropping"
"4488","أَخْبَرَنِي زِيَادُ بْنُ أَيُّوبَ ، قَالَ : حدثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، قَالَ : حدثَنَا سُفْيَانُ بْنُ حُسَيْنٍ ، قَالَ : حدثَنَا يُونُسُ بْنُ عُبَيْدٍ ، عَنْ عَطَاءٍ ، عَنْ جَابِرٍ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنِ الْمُحَاقَلَةِ ، وَالْمُزَابَنَةِ ، وَالْمُخَابَرَةِ ، وَعَنِ الثُّنْيَا إِلا أَنْ يُعْلَمَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَفِي رِوَايَةِ هَمَّامِ بْنِ يَحْيَى كَالدَّلِيلِ عَلَى أَنَّ عَطَاءً لَمْ يَسْمَعْ مِنْ جَابِرٍ حَدِيثَهُ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ كَانَتْ لَهُ أَرْضٌ فَلْيَزْرَعْهَا""","","Sunan al-Kubra al-Nasai 4488","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ بَزِيعٍ قَالَ حَدَّثَنَا يَزِيدُ قَالَ حَدَّثَنَا خَالِدٌ وَأَخْبَرَنَا عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ حَدَّثَنَا غُنْدَرٌ عَنْ شُعْبَةَ عَنْ خَالِدٍ عَنْ أَبِي قِلَابَةَ عَنْ أَبِي الْأَشْعَثِ عَنْ شَدَّادِ بْنِ أَوْسٍ قَالَ ثِنْتَانِ حَفِظْتُهُمَا","The Book of Sharecropping"
"4489","أَخْبَرَنِي أَحْمَدُ بْنُ يَحْيَى ، قَالَ : حدثَنَا أَبُو نُعَيْمٍ ، قَالَ : حدثَنَا هَمَّامُ بْنُ يَحْيَى ، قَالَ : سَأَلَ عَطَاءٌ سُلَيْمَانَ بْنَ مُوسَى ، قَالَ : حَدَّثَ جَابِرٌ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ كَانَتْ لَهُ أَرْضٌ ، فَلْيَزْرَعْهَا أَوْ لِيُزْرِعْهَا أَخَاهُ ، وَلا يُكْرِيهَا أَخَاهُ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَقَدْ رَوَى النَّهْيَ عَنِ الْمُحَاقَلَةِ يَزِيدُ بْنُ نُعَيْمٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ""","Sahih|Sahih|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 4489","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ عَنْ شُعْبَةَ قَالَ أَخْبَرَنِي قَتَادَةُ قَالَ سَمِعْتُ أَنَسًا قَالَ","The Book of Sharecropping"
"4490","أَخْبَرَنَا مُحَمَّدُ بْنُ إِدْرِيسَ ، قَالَ : حدثَنَا أَبُو تَوْبَةَ ، قَالَ : حدثَنَا مُعَاوِيَةُ بْنُ سَلامٍ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ يَزِيدَ بْنِ نُعَيْمٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنِ الْحَقْلِ ، وَهو الْمُزَابَنَةُ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4490","","أَخْبَرَنِي أَحْمَدُ بْنُ نَاصِحٍ الْمِصِّيصِيُّ قَالَ أَخْبَرَنِي هُشَيْمٌ عَنْ شُعْبَةَ عَنْ قَتَادَةَ قَالَ حَدَّثَنَا أَنَسُ بْنُ مَالِكٍ قَالَ","The Book of Sharecropping"
"4491","أَخْبَرَنَا الثِّقَةُ ، قَالَ : حدثَنَا حَمَّادُ بْنُ مَسْعَدَةَ ، عَنْ هِشَامِ بْنِ أَبِي عَبْدِ اللَّهِ ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، عَنْ أَبِي سَلَمَةَ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنِ الْمُزَابَنَةِ ، وَالْمُحَالَقَةِ ، وَالْمُخَاضَرَةِ ، وَالْمُخَابَرَةِ ، وَقَالَ : الْمُخَاضَرَةُ بَيْعُ الثَّمَرِ قَبْلَ أَنْ يَزْهُوَ ، وَالْمُخَابَرَةُ بَيْعُ الْكَرْمِ بِكَذَا وَكَذَا مِنْ صَاعٍ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4491","","أَخْبَرَنَا الْقَاسِمُ بْنُ زَكَرِيَّا بْنِ دِينَارٍ الْكُوفِيُّ قَالَ حَدَّثَنَا مُصْعَبُ بْنُ الْمِقْدَامِ عَنِ الْحَسَنِ يَعْنِي ابْنَ صَالِحٍ عَنْ شُعْبَةَ عَنْ قَتَادَةَ عَنْ أَنَسٍ قَالَ","The Book of Sharecropping"
"4492","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا عَبْدُ الرَّحْمَنِ ، قَالَ : حدثَنَا سُفْيَانُ ، عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ ، عَنْ عُمَرَ بْنِ أَبِي سَلَمَةَ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنِ الْمُحَاقَلَةِ ، وَالْمُزَابَنَةِ """"""","","Sunan al-Kubra al-Nasai 4492","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا يَزِيدُ يَعْنِي ابْنَ زُرَيْعٍ قَالَ حَدَّثَنَا سَعِيدٌ قَالَ حَدَّثَنَا قَتَادَةُ أَنَّ أَنَسَ بْنَ مَالِكٍ حَدَّثَهُمْ","The Book of Sharecropping"
"4493","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ الْمُبَارَكِ ، قَالَ : حدثَنَا يَحْيَى وَهُوَ ابْنُ آدَمَ ، قَالَ : حدثَنَا عَبْدُ الرَّحِيمِ وَهُوَ ابْنُ سُلَيْمَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرٍو ، عَنْ أَبِي سَلَمَةَ ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنِ الْمُحَاقَلَةِ ، وَالْمُزَابَنَةِ """"""","","Sunan al-Kubra al-Nasai 4493","","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ وَالْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ عَنِ ابْنِ الْقَاسِمِ قَالَ حَدَّثَنِي مَالِكٌ عَنْ جَعْفَرِ بْنِ مُحَمَّدٍ عَنْ أَبِيهِ عَنْ جَابِرِ بْنِ عَبْدِ اللهِ","The Book of Sharecropping"
"4494","أَخْبَرَنَا زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حدثَنَا محَمَّدُ بْنُ يَزِيدَ بْنِ إِبْرَاهِيمَ ، قَالَ : حدثَنَا عَبْدُ اللَّهِ بْنُ حُمْرَانَ ، قَالَ : حدثَنَا عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ، عَنِ الأَسْوَدِ بْنِ الْعَلاءِ ، عَنْ أَبِي سَلَمَةَ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنِ الْمُحَاقَلَةِ ، وَالْمُزَابَنَةِ ""، وَقَدْ رَوَى هَذَا الْحَدِيثَ الْقَاسِمُ بْنُ مُحَمَّدٍ ، عَنْ رَافِعِ بْنِ خَدِيجٍ""","","Sunan al-Kubra al-Nasai 4494","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ وَمُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ يَزِيدَ قَالَا حَدَّثَنَا سُفْيَانُ عَنْ هِشَامِ بْنِ عُرْوَةَ عَنْ فَاطِمَةَ عَنْ أَسْمَاءَ قَالَتْ","The Book of Sharecropping"
"4495","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا أَبُو عَاصِمٍ ، قَالَ : حدثَنَا عُثْمَانُ بْنُ مُرَّةَ ، قَالَ : سَأَلْتُ الْقَاسِمَ عَنِ الْمُزَارَعَةِ ، فَحَدَّثَ عَنْ رَافِعِ بْنِ خَدِيجٍ ،  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنِ الْمُحَاقَلَةِ ، وَالْمُزَابَنَةِ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4495","","أَخْبَرَنِي مُحَمَّدُ بْنُ آدَمَ الْمِصِّيصِيُّ عَنْ عَبْدَةُ بْنُ سُلَيْمَانَ كُوفِيٌّ عَنْ هِشَامِ بْنِ عُرْوَةَ عَنْ فَاطِمَةَ عَنْ أَسْمَاءَ قَالَتْ","The Book of Sharecropping"
"4496","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ مَرَّةً أُخْرَى ، قَالَ : حدثنا أَبُو عَاصِمٍ ، عَنْ عُثْمَانَ بْنِ مُرَّةَ ، قَالَ : سَأَلْتُ الْقَاسِمَ عَنْ كِرَاءِ الأَرْضِ ، فَقَالَ : قَالَ رَافِعُ بْنُ خَدِيجٍ :  إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الأَرْضِ "". قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَاخْتُلِفَ عَلَى سَعِيدِ بْنِ الْمُسَيِّبِ فِيهِ""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 4496","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا يَحْيَى عَنِ ابْنِ حَيَّانَ يَعْنِي مَنْصُورًا عَنْ عَامِرِ بْنِ وَاثِلَةَ قَالَ","The Book of Sharecropping"
"4497","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حدثَنَا يحْيَى ، عَنْ أَبِي جَعْفَرٍ الْخَطْمِيِّ وَاسْمُهُ عُمَيْرُ بْنُ يَزِيدَ قَالَ : أَرْسَلَنِي عَمِّيَ وَغُلامًا لَهُ إِلَى سَعِيدِ بْنِ الْمُسَيِّبِ أَسْأَلُهُ عَنِ الْمُزَارَعَةِ ، فَقَالَ : كَانَ ابْنُ عُمَرَ لا يَرَى بِهَا بَأْسًا ، حَتَّى بَلَغَهُ عَنْ رَافِعِ بْنِ خَدِيجٍ حَدِيثٌ فَلَقِيَهُ ، فَقَالَ رَافِعٌ :  أَتَى النَّبِي صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَنِي حَارِثَةَ فَرَأَى زَرْعًا ، فَقَالَ :مَا أَحْسَنَ زَرْعِ ظُهَيْرٍ ، فَقَالُوا : لَيْسَ لِظُهَيْرٍ ، فَقَالَ : أَلَيْسَ أَرْضُ ظُهَيْرٍ ؟ قَالُوا : بَلَى ، وَلَكِنَّهُ أَزْرَعَهَا ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : خُذُوا زَرْعَكُمْ وَرُدُّوا إِلَيْهِ نَفَقَتُهُ ، قَالَ : فَأَخَذْنَا زَرْعَنَا وَرَدَدْنَا إِلَيْهِ نَفَقَتَهُ """"""","","Sunan al-Kubra al-Nasai 4497","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا عَبْدُ الرَّزَّاقِ قَالَ أَخْبَرَنَا مَعْمَرٌ عَنِ الزُّهْرِيِّ عَنْ سَالِمٍ عَنِ ابْنِ عُمَرَ","The Book of Sharecropping"
"4498","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حدثَنَا أَبُو الأَحْوَصِ ، عَنْ طَارِقٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنِ الْمُحَاقَلَةِ ، وَالْمُزَابَنَةِ ، وَقَالَ : إِنَّمَا يَزْرَعُ ثَلاثَةٌ : رَجُلٌ لَهُ أَرْضٌ فَهُوَ يَزْرَعْهَا ، أَوْ رَجُلٌ مُنِحَ أَرْضًا فَهُوَ يَزْرَعُ مَا مُنِحَ ، أَوْ رَجُلٌ اسْتَكْرَى أَرْضًا بِذَهَبٍ أَوْ فِضَّةٍ """"""","","Sunan al-Kubra al-Nasai 4498","","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ عَنْ غُنْدَرٍ قَالَ حَدَّثَنَا سَعِيدٌ قَالَ أَخْبَرَنَا مَعْمَرٌ قَالَ أَخْبَرَنَا الزُّهْرِيُّ عَنْ أَبِي عُبَيْدٍ مَوْلَى ابْنِ عَوْفٍ قَالَ شَهِدْتُ مَعَ عَلِيَّ بْنَ أَبِي طَالِبٍ فِي يَوْمِ عِيدٍ بَدَأَ بِالصَّلَاةِ قَبْلَ الْخُطْبَةِ ثُمَّ صَلَّى بِلَا أَذَانٍ وَلَا إِقَامَةٍ ثُمَّ قَالَ","The Book of Sharecropping"
"4499","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ ، قَالَ : حدثَنَا عبَيْدُ اللَّهِ بْنُ مُوسَى ، قَالَ : أَنْبَأَنَا إِسْرَائِيلُ ، عَنْ طَارِقٍ ، عَنْ سَعِيدٍ ، قَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِ الْمُحَاقَلَةِ ""، قَالَ سَعِيدٌ : وَذَكَرَ نَحْوَهُ . رَوَاهُ سُفْيَانُ الثَّوْرِيُّ ، عَنْ طَارِقٍ""","","Sunan al-Kubra al-Nasai 4499","","أَخْبَرَنَا أَبُو دَاوُدَ قَالَ حَدَّثَنَا يَعْقُوبُ قَالَ حَدَّثَنَا أَبِيُ عَنْ صَالِحٍ عَنِ ابْنِ شِهَابٍ أَنَّ أَبَا عُبَيْدٍ أَخْبَرَهُ أَنَّ عَلِيَّ بْنَ أَبِي طَالِبٍ قَالَ","The Book of Sharecropping"
"4500","قَالَ الْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ ، عَنِ ابْنِ الْقَاسِمِ ، قَالَ : حَدَّثَنِي مَالِكٌ ، عَنِ ابْنِ شِهَابٍ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنِ الْمُحَاقَلَةِ ، وَالْمُزَابَنَةِ """"""","Sahih|Sahih|Sahih Muslim","Sunan al-Kubra al-Nasai 4500","","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ وَالْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ عَنِ ابْنِ الْقَاسِمِ قَالَ حَدَّثَنِي مَالِكٌ عَنْ أَبِي الزُّبَيْرِ عَنْ جَابِرِ بْنِ عَبْدِ اللهِ","The Book of Sharecropping"
"4501","أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ سَعْدِ بْنِ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنِي عَمِّي ، قَالَ : حدثَنَا أَبِي ، عَنْ مُحَمَّدِ بْنِ عِكْرِمَةَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ لَبِيبَةَ ، عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ ، عَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ ، قَالَ :  كَانَ أَصْحَابُ الْمَزَارِعِ يُكْرُونَ فِي زَمَانِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَزَارِعَهُمْ بِمَا يَكُونُ عَلَى السَّاقِي مِنَ الزَّرْعِ ، فَجَاءُوا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَاخْتَصَمُوا فِي بَعْضِ ذَلِكَ فَنَهَاهُمْ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ يُكْرُوا بِذَلِكَ وَقَالَ :أَكْرُوا بِالذَّهَبِ وَالْفِضَّةِ """"""","","Sunan al-Kubra al-Nasai 4501","","أَخْبَرَنَا عِيسَى بْنُ حَمَّادٍ قَالَ أَخْبَرَنَا اللَّيْثُ عَنْ يَحْيَى بْنِ سَعِيدٍ عَنِ الْقَاسِمِ بْنِ مُحَمَّدٍ عَنِ ابْنِ خَبَّابٍ","The Book of Sharecropping"
"4502","أَخْبَرَنِي زِيَادُ بْنُ أَيُّوبَ ، قَالَ : حدثَنَا ابْنُ عُلَيَّةَ ، قَالَ : أَنْبَأَنَا أَيُّوبُ ، عَنْ يَعْلَى بْنِ حَكِيمٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّا نُحَاقِلُ بِالأَرْضِ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَنُكْرِيهَا بِالثُّلُثِ ، وَالرُّبُعِ وَالطَّعَامِ الْمُسَمَّى ، فَجَاءَ ذَاتَ يَوْمٍ رَجُلٌ مِنْ عُمُومَتِي ، فَقَالَ : نَهَانِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَطَوَاعِيَةُ اللَّهِ وَرَسُولِهِ أَنْفَعُ لَنَا ،نَهَانَا أَنْ نُحَاقِلَ بِالأَرْضِ ، وَنُكْرِيَهَا بِالثُّلُثِ وَالرُّبُعِ وَالطَّعَامِ الْمُسَمَّى ، وَأَمَرَ رَبَّ الأَرْضِ أَنْ يَزْرَعَهَا أَوْ يُزْرِعَهَا ، وَكَرِهَ كِرَاءَهَا وَمَا سِوَى ذَلِكَ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4502","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا يَحْيَى عَنْ سَعْدِ بْنِ إِسْحَاقَ قَالَ حَدَّثَتْنِي زَيْنَبُ هِيَ زَيْنَبُ بِنْتُ كَعْبِ بْنِ عُجْرَةَ عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ","The Book of Sharecropping"
"4503","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى ، قَالَ : حدثَنَا محَمَّدُ بْنُ عُبَيْدٍ ، قَالَ : حدثَنَا حَمَّادٌ ، عَنْ أَيُّوبَ ، قَالَ : كَتَبَ إِلَيَّ يَعْلَى بْنُ حَكِيمٍ ، أَنِّي سَمِعْتُ سُلَيْمَانَ بْنِ يَسَارٍ ، يُحَدِّثُ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  كُنَّانُحَاقِلُ الأَرْضَ نُكْرِيهَا بِالثُّلُثِ وَالرُّبُعِ وَالطَّعَامِ الْمُسَمَّى """"""","","Sunan al-Kubra al-Nasai 4503","","أَخْبَرَنَا عَمْرُو بْنُ مَنْصُورٍ قَالَ حَدَّثَنَا عَبْدُ اللهِ بْنُ مُحَمَّدٍ النُّفَيْلِيُّ قَالَ حَدَّثَنَا زُهَيْرٌ وَأَخْبَرَنِي مُحَمَّدُ بْنُ مَعْدَانَ قَالَ حَدَّثَنَا الْحَسَنُ بْنُ أَعْيَنَ قَالَ حَدَّثَنَا زُهَيْرٌ قَالَ حَدَّثَنَا زُبَيْدُ عَنْ مُحَارِبِ بْنِ دِثَارٍ عَنِ ابْنِ بُرَيْدَةَ عَنْ أَبِيهِ قَالَ","The Book of Sharecropping"
"4504","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حدثَنَا خالِدُ بْنُ الْحَارِثِ ، عَنْ سَعِيدٍ ، عَنْ يَعْلَى بْنِ حَكِيمٍ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، أَنَّ رَافِعَ بْنَ خَدِيجٍ ، قَالَ :  كُنَّا نُحَاقِلُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَزَعَمَ أَنَّ بَعْضَ عُمُومَتِهِ أَتَاهُ ، فَقَالَ : نَهَانِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ لَنَا نَافِعًا ، وَطَوَاعِيَةُ اللَّهِ وَرَسُولِهِ أَنْفَعُ لَنَا ، قُلْنَا : وَمَا ذَاكَ ؟ قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :مَنْ كَانَتْ لَهُ أَرْضٌ ، فَلْيَزْرَعْهَا أَوْ لِيُزْرِعْهَا أَخَاهُ وَلا يُكَارِيهَا بِثُلُثٍ ، وَلا رُبْعٍ وَلا طَعَامٍ مُسَمًّى """"""","Sahih Lighairihi|Sahih|Sahih","Sunan al-Kubra al-Nasai 4504","","أَخْبَرَنَا الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ عَنِ الْأَحْوَصِ بْنِ جَوَابٍ عَنْ عَمَّارِ بْنِ رُزَيْقٍ عَنْ أَبِي إِسْحَاقَ عَنِ الزُّبَيْرِ بْنِ عَدِيٍّ عَنِ ابْنِ بُرَيْدَةَ عَنْ أَبِيهِ قَالَ","The Book of Sharecropping"
"4505","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ الْمُبَارَكِ ، قَالَ : حدثَنَا حُجَيْنُ بْنُ الْمُثَنَّى ، قَالَ : حدثَنَا اللَّيْثُ ، عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ ، عَنْ حَنْظَلَةَ بْنِ قَيْسٍ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ : حَدَّثَنِي عَمِّي ،  أَنَّهُمْ كَانُوايُكْرُونَ الأَرْضَ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمَا تَنْبُتُ عَلَى الأَرْبِعَاءِ ، وَشَيْءٍ مِنَ الزَّرْعِ يَسْتَثْنِيهِ صَاحِبُ الأَرْضِ فَنَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ ""، فَقُلْتُ لِرَافِعٍ : فَكَيْفَ كِرَاهَا بِالدِّينَارِ وَالدِّرْهَمِ ؟ فَقَالَ رَافِعٌ : لَيْسَ بِهَا بَأْسٌ بِالدِّينَارِ وَالدِّرْهَمِ""","","Sunan al-Kubra al-Nasai 4505","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا يَحْيَى عَنْ مَالِكٍ قَالَ حَدَّثَنِي عَبْدُ اللهِ بْنُ أَبِي بَكْرٍ عَنْ عَمْرَةَ عَنْ عَائِشَةَ قَالَتْ دَفَّتْ دَافَّةٌ مِنْ أَهْلِ الْبَادِيَةِ بِحَضْرَةِ الْأَضْحَى فَقَالَ","The Book of Sharecropping"
"4506","أَخْبَرَنِي الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حدَّثَنَا عِيسَى هُوَ ابْنُ يُونُسَ ، قَالَ : حدثَنَا الأَوْزَاعِيُّ ، عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ ، عَنْ حَنْظَلَةَ بْنِ قَيْسٍ الأَنْصَارِيِّ ، قَالَ : سَأَلْتُ رَافِعَ بْنَ خَدِيجٍ ،  عَنْ كِرَاءِ الأَرْضِ بِالذَّهَبِ أَوِ الْوَرِقِ ، فَقَالَ لا بَأْسَ بِذَلِكَ ، إِنَّمَا كَانَالنَّاسُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُؤَاجِرُونَ مَا عَلَى الْمَاذِيَانَاتِ ، وَأَقْبَالِ الْجَدَاوِلِ فَيَسْلَمُ هَذَا وَيَهْلِكُ هَذَا ، وَيَسْلَمُ هَذَا وَيَهْلِكُ هَذَا ، وَلَمْ يَكُنْ لِلنَّاسِ كِرَاءٌ إِلا هَذَا ، فَلِذَلِكَ زَجَرَ عَنْهُ ، فَأَمَّا شَيْءٌ مَعْلُومٌ مَضْمُونٌ فَلا بَأْسَ بِهِ """"""","","Sunan al-Kubra al-Nasai 4506","","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ عَنْ عَبْدِ الرَّحْمَنِ عَنْ سُفْيَانَ عَنْ عَبْدِ الرَّحْمَنِ هُوَ ابْنُ عَابِسٍ عَنْ أَبِيهِ قَالَ","The Book of Sharecropping"
"4507","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ ، عَنْ حَنْظَلَةَ بْنِ قَيْسٍ ، أَنَّهُ سَأَلَ رَافِعَ بْنَ خَدِيجٍ عَنْ كِرَاءِ الأَرْضِ ، فَقَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ كِرَاءِ الأَرْضِ ، فَقُلْتُ : بِالذَّهَبِ وَالْوَرِقِ ؟ فَقَالَ : أَمَّا بِالذَّهَبِ وَالْوَرِقِ فَلا بَأْسَ بِهِ """"""","","Sunan al-Kubra al-Nasai 4507","","أَخْبَرَنَا يُوسُفُ بْنُ عِيسَى الْمَرْوَزِيُّ قَالَ أَخْبَرَنَا الْفَضْلُ بْنُ مُوسَى قَالَ حَدَّثَنَا يَزِيدُ وَهُوَ ابْنُ زِيَادِ بْنِ أَبِي الْجَعْدِ عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَابِسٍ عَنْ أَبِيهِ قَالَ سَأَلْتُ عَائِشَةَ عَنْ لُحُومِ الْأَضَاحِيِّ قَالَتْ","The Book of Sharecropping"
"4508","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا يَحْيَى قَالَ : حدثَنَا مَالِكٌ ، عَنْ رَبِيعَةَ ، عَنْ حَنْظَلَةَ بْنِ قَيْسٍ ، قَالَ : سَأَلْتُ رَافِعَ بْنَ خَدِيجٍ ، عَنْ كِرَاءِ الأَرْضِ ، فَقَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ كِرَاءِ الأَرْضِ ، فَقُلْتُ : بِالذَّهَبِ وَالْوَرِقِ ؟ قَالَ : لا إِنَّمَا نَهَى عَنْهَا بِمَا يَخْرُجُ مِنْهَا فَأَمَّا الذَّهَبُ وَالْفِضَّةُ فَلا بَأْسَ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4508","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ يَعْنِي ابْنَ الْمُبَارَكِ عَنِ ابْنِ عَوْنٍ عَنِ ابْنِ سِيرِينَ عَنْ أَبِي سَعِيدٍ قَالَ","The Book of Sharecropping"
"4509","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ الْمُبَارَكِ ، عَنْ وَكِيعٍ ، قَالَ : حدثَنَا سُفْيَانُ ، عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ ، عَنْ حَنْظَلَةَ بْنِ قَيْسٍ ، قَالَ : سَأَلْتُ رَافِعَ بْنَ خَدِيجٍ ،  عَنْكِرَاءِ الأَرْضِ الْبَيْضَاءِ بِالذَّهَبِ وَالْفِضَّةِ ، فَقَالَ : حَلالٌ لا بَأْسَ بِهِ ذَلِكَ فَرْضُ الأَرْضِ """"""","","Sunan al-Kubra al-Nasai 4509","","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ قَالَ حَدَّثَنِي يَحْيَى بْنُ سَعِيدٍ عَنْ سُلَيْمَانَ بْنِ الْمُغِيرَةِ قَالَ حَدَّثَنَا حُمَيْدُ بْنُ هِلَالٍ قَالَ حَدَّثَنَا عَبْدُ اللهِ بْنُ مُغَفَّلٍ قَالَ","The Book of Sharecropping"
"4510","أَخْبَرَنَا يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ فِي حَدِيثِهِ ، عَنْ حَمَّادِ بْنِ زَيْدٍ ، عَنْ يَحْيَى بْنِ سَعِيدٍ ، عَنْ حَنْظَلَةَ بْنِ قَيْسٍ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  نَهَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ كِرَاءِ أَرْضِنَا ، وَلَمْ يَكُنْ يَوْمَئِذٍ ذَهَبٌ وَلا فِضَّةٌ ، فَكَانَ الرَّجُلُ يُكْرِي أَرْضَهُ بِمَا عَلَى الرَّبِيعِ ، وَأَشْيَاءَ مَعْلُومَةٍ . . . . . ""وَسَاقَهُ""","","Sunan al-Kubra al-Nasai 4510","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا النَّضْرُ بْنُ شُمَيْلٍ قَالَ حَدَّثَنَا هِشَامُ بْنُ عُرْوَةَ عَنْ أَبِيهِ عَنْ عَائِشَةَ","The Book of Sharecropping"
"4511","أَخْبَرَنَا مُحَمَّدُ بْنُ يَحْيَى بْنِ عَبْدِ اللَّهِ ، قَالَ : حدَّثَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ ، عَنْ جُوَيْرِيَةَ ، عَنْ مَالِكٍ ، عَنِ الزُّهْرِيِّ ، أَنَّ سَالِمِ بْنِ عَبْدِ اللَّهِ أَخْبَرَهُ وَسَأَلَهُ عَنْ كِرَاءِ الْمَزَارِعِ ، فَقَالَ : أَخْبَرَنَا رَافِعُ بْنُ خَدِيجٍ ، أَنَّ عَمَّيْهِ وَكَانَا قَدْ شَهِدَا بَدْرًا أَخْبَرَاهُ ،  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الْمَزَارِعِ ""، فَتَرَكَ عَبْدُ اللَّهِ كِرَاهَا ، وَكَانَ يُكْرِيهَا قَبْلَ ذَلِكَ""","","Sunan al-Kubra al-Nasai 4511","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا سُفْيَانُ قَالَ حَدَّثَنِي هَارُونُ بْنُ أَبِي وَكِيعٍ عَنْ أَبِيهِ عَنِ ابْنِ عَبَّاسٍ","The Book of Sharecropping"
"4512","أَخْبَرَنَا عَبْدُ الْمَلِكِ بْنِ شُعَيْبِ بْنِ اللَّيْثِ بْنِ سَعْدٍ ، قَالَ : حدثَنَا أَبِي ، عَنْ جَدِّي ، قَالَ : أَخْبَرَنِي عُقَيْلُ بْنُ خَالِدٍ ، عَنِ ابْنِ شِهَابٍ ، قَالَ : أَخْبَرَنِي سَالِمُ بْنُ عَبْدِ اللَّهِ ، أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ كَانَ يُكْرِي أَرْضَهُ حَتَّى بَلَغَهُ أَنَّ رَافِعَ بْنَ خَدِيجٍ كَانَ يَنْهَى عَنْ كِرَاءِ الأَرْضِ ، فَلَقِيَهُ عَبْدُ اللَّهِ فَقَالَ : يَا ابْنَ خَدِيجٍ ، مَاذَا تُحَدِّثُ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي كِرَاءِ الأَرْضِ ؟ فَقَالَ رَافِعٌ لِعَبْدِ اللَّهِ : سَمِعْتُ عَمِّي ، وَكَانَا قَدْ شَهِدَا بَدْرًا ، يُحَدِّثَانِ أَهْلَ الدَّارِ ،  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الأَرْضِ ""، قَالَ عَبْدُ اللَّهِ : فَلَقَدْ كُنْتُ أَعْلَمُ فِي عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّ الأَرْضَ لَتُكْرَى ، ثُمَّ خَشِيَ عَبْدُ اللَّهِ أَنْ يَكُونَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَحْدَثَ فِي ذَلِكَ شَيْئًا لَمْ يَكُنْ يَعْلَمُهُ ، فَتَرَكَ كِرَاءَ الأَرْضِ""","","Sunan al-Kubra al-Nasai 4512","","أَخْبَرَنَا عَمْرُو بْنُ عُثْمَانَ قَالَ حَدَّثَنَا بَقِيَّةُ عَنْ بَحِيرٍ عَنْ خَالِدٍ عَنْ جُبَيْرِ بْنِ نُفَيْرٍ عَنْ أَبِي ثَعْلَبَةَ قَالَ","The Book of Sharecropping"
"4513","أَخْبَرَنِي مُحَمَّدُ بْنُ خَالِدِ بْنِ خَلِيٍّ ، قَالَ : حدَّثَنَا بِشْرُ بْنُ شُعَيْبٍ ، عَنْ أَبِيهِ ، عَنِ الزُّهْرِيِّ ، قَالَ : بَلَغَنَا أَنَّ رَافِعَ بْنَ خَدِيجٍ كَانَ يُحَدِّثُ أَنَّهُ سَمِعَ عَمَّيْهِ ، وَكَانَا زَعَمَ شَهِدَا بَدْرًا ،  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الأَرْضِ """"""","","Sunan al-Kubra al-Nasai 4513","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ عَنْ شُعْبَةَ عَنْ هِشَامِ بْنِ زَيْدٍ قَالَ","The Book of Sharecropping"
"4514","أَخْبَرَنَا أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ ، قَالَ : حدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، عَنْ شُعَيْبٍ ، قَالَ الزُّهْرِيُّ : كَانَ ابْنُ الْمُسَيَّبِ ، يَقُولُ : لَيْسَ بِاسْتِكْرَاءِ الأَرْضِ بِالذَّهَبِ وَالْوَرِقِ بَأْسٌ ، وَكَانَ رَافِعُ بْنُ خَدِيجٍ ، يُحَدِّثُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ ذَلِكَ """"""","","Sunan al-Kubra al-Nasai 4514","","أَخْبَرَنَا مُحَمَّدُ بْنُ زُنْبُورٍ الْمَكِّيُّ قَالَ حَدَّثَنَا ابْنُ أَبِي حَازِمٍ عَنْ يَزِيدَ بْنُ الْهَادِ عَنْ مُعَاوِيَةَ بْنِ عَبْدِ اللهِ بْنِ جَعْفَرٍ عَنْ عَبْدِ اللهِ بْنِ جَعْفَرٍ قَالَ","The Book of Sharecropping"
"4515","الْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ ، عَنِ ابْنِ وَهْبٍ ، قَالَ : أَخْبَرَنِي أَبُو خُزَيْمَةَ عَبْدُ اللَّهِ بْنُ طَرِيفٍ ، عَنْ عَبْدِ الْكَرِيمِ بْنِ الْحَارِثِ ، عَنِ ابْنِ شِهَابٍ ، أَنَّ رَافِعَ بْنَ خَدِيجٍ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ كِرَاءِ الأَرْضِ ""، قَالَ ابْنُ شِهَابٍ : فَسُئِلَ رَافِعٌ بَعْدَ ذَلِكَ كَيْفَ كَانُوا يُكْرُونَ الأَرْضَ ، قَالَ : بِشَيْءٍ مِنَ الطَّعَامِ مُسَمًّى ، وَيُشْتَرَطُ أَنَّ لَنَا مَا تُنْبِتُ مَاذِيَانَاتُ الأَرْضِ ، وَأَقْبَالُ الْجَدَاوِلِ""","","Sunan al-Kubra al-Nasai 4515","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا هُشَيْمٌ عَنْ أَبِي بِشْرٍ عَنْ سَعِيدِ بْنِ جُبَيْرٍ عَنِ ابْنِ عُمَرَ قَالَ","The Book of Sharecropping"
"4516","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ بَزِيعٍ ، قَالَ : حدَّثَنَا فُضَيْلٌ ، قَالَ : حدثَنَا مُوسَى وَهُوَ ابْنُ عُقْبَةَ ، قَالَ : أَخْبَرَنِي نَافِعٌ ، أَنَّ رَافِعَ بْنَ خَدِيجٍ أَخْبَرَ عَبْدَ اللَّهِ بْنَ عُمَرَ ، أَنَّ عُمُومَتَهُ جَاءُوا إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، ثُمَّ رَجَعُوا إِلَى رَافِعٍ ، فَأَخْبَرُوا ،  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الْمَزَارِعِ ""، فَقَالَ عَبْدُ اللَّهِ : لَقَدْ عَلِمْنَا أَنَّهُ كَانَ صَاحِبَ مَزْرَعَةٍ يُكْرِيهَا عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى أَنَّ لَهُ مَا عَلَى الرَّبِيعِ السَّاقِي الَّذِي يَتَفَجَّرُ مِنْهُ الْمَاءُ ، وَطَائِفَةً مِنَ التِّبْنِ لا أَدْرِي كَمْ هِيَ ؟""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4516","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا شُعْبَةُ قَالَ حَدَّثَنِي الْمِنْهَالُ بْنُ عَمْرٍو عَنْ سَعِيدِ بْنِ جُبَيْرٍ عَنِ ابْنِ عُمَرَ قَالَ","The Book of Sharecropping"
"4517","أَخْبَرَنِي مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ ، قَالَ : حدثَنَا يَزِيدُ ، قَالَ : أَنْبَأَنَا ابْنُ عَوْنٍ ، عَنْ نَافِعٍ ، كَانَ ابْنُ عُمَرَ يَأْخُذُ كِرَاءَ الأَرْضِ ، فَبَلَغَهُ عَنْ رَافِعِ بْنِ خَدِيجٍ ، حَدِيثٌ ، فَأَخَذَ بِيَدِي فَمَشَى إِلَى رَافِعٍ وَأَنَا مَعَهُ ، فَحَدَّثَهُ رَافِعٌ ، عَنْ بَعْضِ عُمُومَتِهِ ،  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الأَرْضِ ""، فَتَرَكَ عَبْدَ اللَّهِ بَعْدُ""","","Sunan al-Kubra al-Nasai 4517","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ عَنْ شُعْبَةَ عَنْ عَدَيِّ بْنِ ثَابِتٍ عَنْ سَعِيدِ بْنِ جُبَيْرٍ عَنِ ابْنِ عَبَّاسٍ","The Book of Sharecropping"
"4518","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ الْمُبَارَكِ ، قَالَ : حدثَنَا إِسْحَاقُ الأَزْرَقُ ، قَالَ : حدثَنَا ابْنُ عَوْنٍ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّهُ كَانَ يَأْخُذُ كِرَاءَ الأَرْضِ ، حَتَّى حَدَّثَهُ رَافِعٌ ، عَنْ بَعْضِ عُمُومَتِهِ ،  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الأَرْضِ ""فَتَرَكَهَا بَعْدُ""","","Sunan al-Kubra al-Nasai 4518","","أَخْبَرَنَا مُحَمَّدُ بْنُ عُبَيْدٍ قَالَ حَدَّثَنَا عَلِيُّ بْنُ هَاشِمٍ عَنِ الْعَلَاءِ بْنِ صَالِحٍ عَنْ عَدِيِّ بْنِ ثَابِتٍ عَنْ سَعِيدِ بْنِ جُبَيْرٍ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Sharecropping"
"4519","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ بَزِيعٍ ، قَالَ : حدثَنَا يَزِيدُ وَهُوَ ابْنُ زُرَيْعٍ ، قَالَ : حدثَنَا أَيُّوبُ ، عَنْ نَافِعٍ ، أَنَّ ابْنَ عُمَرَ كَانَ يُكْرِي مَزَارِعَهُ حَتَّى بَلَغَهُ فِي آخِرِ خِلافَةِ مُعَاوِيَةَ ، أَنَّ رَافِعَ بْنَ خَدِيجٍ يُخْبِرُ فِيهَا بِنَهْيٍ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَتَاهُ وَأَنَا مَعَهُ فَسَأَلَهُ ، فَقَالَ :  كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَيَنْهَى عَنْ كِرَاءِ الْمَزَارِعِ ""","","Sunan al-Kubra al-Nasai 4519","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ عَمْرٍو عَنْ صُهَيْبٍ عَنْ عَبْدِ اللهِ هُوَ ابْنُ عَمْرِو بْنِ الْعَاصِي يَرْفَعُهُ قَالَ","","The Book of Sharecropping"
"4520","أَخْبَرَنِي عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللَّهِ بْنِ عَبْدِ الْحَكَمِ بْنِ أَعْيَنَ ، قَالَ : حدثَنَا شُعَيْبُ بْنُ اللَّيْثِ ، عَنْ أَبِيهِ ، عَنْ كَثِيرِ بْنِ فَرْقَدَ ، عَنْ نَافِعٍ ، أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ كَانَ يُكْرِي الْمَزَارِعَ فَحُدِّثَ ،  أَنَّ رَافِعَ بْنَ خَدِيجٍ يَأْثُرُ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ نَهَى عَنْ ذَلِكَ ، قَالَ نَافِعٌ : فَخَرَجَ إِلَيْهِ عَلَى الْبَلاطِ وَأَنَا مَعَهُ ، فَسَأَلَهُ ، فَقَالَ : نَعَمْ ، نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ كِرَاءِ الْمَزَارِعِ ""، فَتَرَكَ عَبْدُ اللَّهِ كِرَاءَهَا""","Daif|Daif|Daif","Sunan al-Kubra al-Nasai 4520","","أَخْبَرَنِي مُحَمَّدُ بْنُ دَاوُدَ قَالَ حَدَّثَنَا أَحْمَدُ بْنُ حَنْبَلٍ قَالَ حَدَّثَنَا أَبُو عُبَيْدَةَ عَبْدُ الْوَاحِدِ بْنُ وَاصِلٍ عَنْ خَلَفٍ يَعْنِي ابْنَ مِهْرَانَ قَالَ حَدَّثَنَا عَامِرٌ الْأَحْوَلُ عَنْ صَالِحِ بْنِ دِينَارٍ عَنْ عَمْرِو بْنِ الشَّرِيدِ قَالَ سَمِعْتُ الشَّرِيدَ يَقُولُ","The Book of Sharecropping"
"4521","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : َحدَّثَنَا خَالِدٌ وَهُوَ ابْنُ الْحَارِثِ ، قَالَ : حدثَنَا عُبَيْدُ اللَّهِ بْنُ عُمَرَ ، عَنْ نَافِعٍ ، أَنَّ رَجُلا أَخْبَرَ ابْنَ عُمَرَ ، أَنَّ رَافِعَ بْنَ خَدِيجٍ ، يَأْثُرُ فِي كِرَاءِ الأَرْضِ حَدِيثًا ، فَانْطَلَقْتُ مَعَهُ أَنَا وَالرَّجُلُ الَّذِي أَخْبَرَهُ حَتَّى أَتَى رَافِعًا ، فَأَخْبَرَهُ رَافِعٌ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الأَرْضِ ""، فَتَرَكَ عَبْدُ اللَّهِ كِرَاءَ الأَرْضِ""","Hasan|Hasan|Isnaad Hasan","Sunan al-Kubra al-Nasai 4521","","أَخْبَرَنِي عُثْمَانُ بْنُ عَبْدِ اللهِ بْنِ خُرَّزَادَ قَالَ حَدَّثَنِي سَهْلُ بْنُ بَكَّارٍ قَالَ حَدَّثَنَا وُهَيْبُ بْنُ خَالِدٍ عَنِ ابْنِ طَاوُسٍ عَنْ عَمْرِو بْنِ شُعَيْبٍ عَنْ أَبِيهِ مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ عَمْرٍو قَالَ مَرَّةً عَنْ أَبِيهِ وَقَالَ مَرَّةً عَنْ جَدِّهِ","The Book of Sharecropping"
"4522","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ يَزِيدَ الْمُقْرِئُ ، قَالَ : حدثَنَا أَبِي ، قَالَ : حدثَنَا جُوَيْرِيَةُ ، عَنْ نَافِعٍ ، أَنَّ رَافِعَ بْنَ خَدِيجٍ حَدَّثَ عَبْدَ اللَّهِ بْنَ عُمَرَ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الْمَزَارِعِ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4522","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدٌ قَالَ حَدَّثَنَا هِشَامٌ قَالَ حَدَّثَنَا قَتَادَةُ قَالَ حَدَّثَنَا عِكْرِمَةُ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Sharecropping"
"4523","أَخْبَرَنَا هِشَامُ بْنُ عَمَّارٍ ، قَالَ : حدثَنَا يَحْيَى بْنُ حَمْزَةَ ، قَالَ : حدثَنَا الأَوْزَاعِيُّ وَذَكَرَ كَلِمَةً مَعْنَاهَا ، قَالَ : حَدَّثَنِي حَفْصُ بْنُ عِنان ، عَنْ نَافِعٍ ، أَنَّهُ حَدَّثَهُ قَالَ :  كَانَ ابْنُ عُمَرَ ، يُكْرِي أَرْضَهُ بِبَعْضِ مَا يَخْرُجُ مِنْهَا فَبَلَغَهُ أَنَّ رَافِعَ بْنَ خَدِيجٍ ، يَزْجُرُ عَنْ ذَلِكَ ، وَقَالَ : نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ ذَلِكَ ، قَالَ : قَدْ كُنَّا نُكْرِي الأَرْضَ قَبْلَ أَنْ نَعْرِفَ رَافِعًا ، ثُمَّ وَجَدَ فِي نَفْسِهِ ، فَوَضَعَ يَدَهُ عَلَى مَنْكِبَيَّ حَتَّى دَفَعْنَا إِلَى رَافِعٍ ، فَقَالَ لَهُ عَبْدُ اللَّهِ : أَسَمِعْتَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْ كِرَاءِ الأَرْضِ ؟ فَقَالَ رَافِعٌ : سَمِعْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ :لا تُكْرُوا الأَرْضَ بِشَيْءٍ """"""","","Sunan al-Kubra al-Nasai 4523","","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ قَالَ أَخْبَرَنِي أَبُو نُعَيْمٍ قَالَ حَدَّثَنِي دَاوُدُ بْنُ قَيْسٍ عَنْ عَمْرِو بْنِ شُعَيْبٍ عَنْ أَبِيهِ عَنْ جَدِّهِ قَالَ","The Book of Sharecropping"
"4524","أَخْبَرَنَا حُمَيْدُ بْنُ مَسْعَدَةَ ، عَنْ عَبْدِ الْوَهَّابِ ، قَالَ : حدثَنَا هِشَامٌ ، عَنْ مُحَمَّدٍ ، وَنَافِعٍ قَالا : أنا رَافِعُ بْنُ خَدِيجٍ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الأَرْضِ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَرَوَاهُ ابْنُ عُمَرَ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، وَاخْتُلِفَ عَلَى عَمْرِو بْنِ دِينَارٍ ، فِي رِوَايَتِهِ عَنْهُ فِيهِ""","","Sunan al-Kubra al-Nasai 4524","","أَخْبَرَنَا الْحُسَيْنُ بْنُ حُرَيْثٍ أَبُو عَمَّارٍ قَالَ أَخْبَرَنَا الْفَضْلُ هُوَ ابْنُ مُوسَى عَنِ الْحُسَيْنِ بْنِ وَاقِدٍ عَنْ عَبْدِ اللهِ بْنِ بُرَيْدَةَ عَنْ أَبِيهِ","The Book of Sharecropping"
"4525","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ الْمُبَارَكِ ، قَالَ : أَنْبَأَنَا وَكِيعٌ ، قَالَ : حدثَنَا سُفْيَانُ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، يَقُولُ : كُنَّا نُخَابِرُ وَلا نَرَى بِذَلِكَ بَأْسًا ، حَتَّى زَعَمَ رَافِعُ بْنُ خَدِيجٍ ،  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنِ الْمُخَابَرَةِ """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 4525","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا عَفَّانُ قَالَ حَدَّثَنَا حَمَّادُ بْنُ سَلَمَةَ قَالَ حَدَّثَنَا أَيُّوبُ وَحَبِيبٌ وَيُونُسُ وَقَتَادَةُ عَنْ مُحَمَّدِ بْنِ سِيرِينَ عَنْ سَلْمَانَ بْنِ عَامِرٍ الضَّبِّيِّ","The Book of Sharecropping"
"4526","وَأَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ خَالِدٍ ، قَالَ : حدَّثَنَا حَجَّاجٌ ، قَالَ : قَالَ ابْنُ جُرَيْجٍ : سَمِعْتُ عَمْرَو بْنَ دِينَارٍ ، يَقُولُ : أَشْهَدُ لَسَمِعْتُ ابْنَ عُمَرَ وَهُوَ يَسْأَلُ عَنِ الْخَبَرِ ، فَيَقُولُ :  مَا كُنَّا نَرَى بِذَلِكَ بَأْسًا حَتَّى أَخْبَرَنَا عَامَ الأَوَّلِ ابْنُ خَدِيجٍ ، أَنَّهُ سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ""يَنْهَى عَنِ الْخَبَرِ """"""","Sahih|Sahih|Isnaad Sahih","Sunan al-Kubra al-Nasai 4526","","أَخْبَرَنَا عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الزُّهْرِيُّ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ عَاصِمٍ عَنْ حَفْصَةَ عَنِ الرَّبَابِ عَنْ عَمِّهَا سَلْمَانَ بْنِ عَامِرٍ","The Book of Sharecropping"
"4527","أَخْبَرَنَا يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ، قَالَ : حدثنا حَمَّادِ بْنِ زَيْدٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، قَالَ : سَمِعْتُ ابْنَ عُمَرَ ، يَقُولُ : كُنَّا لا نَرَى بِالْخَبَرِ بَأْسًا حَتَّى كَانَ عَامَ الأَوَّلِ ، فَزَعَمَ رَافِعٌ ، أَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَهَى عَنْهَا """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4527","","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا عَفَّانُ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ قَيْسِ بْنِ سَعْدٍ عَنْ عَطَاءٍ وَطَاوُسٍ وَمُجَاهِدٍ عَنْ أُمِّ كُرْزٍ","The Book of Sharecropping"
"4528","حدثَنَا حَرَمِيُّ بْنُ يُونُسَ ، قَالَ : حدثَنَا عَارِمٌ قَالَ : حدثَنَا حَمَّادُ بْنُ زَيْدٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنْ كِرَاءِ الأَرْضِ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4528","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ قَالَ حَدَّثَنَا عَمْرٌو عَنْ عَطَاءٍ عَنْ حَبِيبَةَ بِنْتِ مَيْسَرَةَ عَنْ أُمِّ كُرْزٍ","The Book of Sharecropping"
"4529","أَخْبَرَنِي مُحَمَّدُ بْنُ عَامِرٍ ، قَالَ : حدثَنَا سُرَيْج قَالَ : حدثَنَا مُحَمَّدُ بْنُ مُسْلِمٍ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ جَابِرٍ ، قَالَ :  نَهَانِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنِ الْمُخَابَرَةِ ، وَالْمُحَاقَلَةِ ، وَالْمُزَابَنَةِ """"""","","Sunan al-Kubra al-Nasai 4529","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ عُبَيْدِ اللهِ يَعْنِي ابْنَ أَبِي يَزِيدَ عَنْ سِبَاعِ بْنِ ثَابِتٍ عَنْ أُمِّ كُرْزٍ قَالَتْ","The Book of Sharecropping"
"4530","أَخْبَرَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : حدثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنِ ابْنِ عُمَرَ ، وَجَابِرٍ ،  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ بَيْعِ الثَّمَرِ حَتَّى يَبْدُوَ صَلاحُهُ ، وَنَهَى عَنِ الْمُخَابَرَةِ كِرَاءِ الأَرْضِ بِالثُّلُثِ وَالرُّبُعِ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4530","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا ابْنُ جُرَيْجٍ قَالَ حَدَّثَنِي عُبَيْدُ اللهِ بْنُ أَبِي يَزِيدَ عَنْ سِبَاعِ بْنِ ثَابِتٍ عَنْ أُمِّ كُرْزٍ","The Book of Sharecropping"
"4531","أَخْبَرَنَا أَبُو بَكْرٍ مُحَمَّدُ بْنُ إِسْمَاعِيلَ الطَّبَرَانِيُّ ، قَالَ : حدثَنَا عَبْدُ الرَّحْمَنِ بْنُ بَحْرٍ ، قَالَ : حدثَنَا مُبَارَكُ بْنُ سَعِيدٍ ، قَالَ : حدثَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ ، قَالَ : حَدَّثَنِي أَبُو النَّجَاشِيِّ ، قَالَ : حَدَّثَنِي رَافِعُ بْنُ خَدِيجٍ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ لِرَافِعٍ :أَتُؤَاجِرُونَ مَحَاقِلَكُمْ ؟ قُلْتُ : نَعَمْ يَا رَسُولَ اللَّهِ ، نُؤَاجِرُهَا عَلَى الرُّبُعِ وَعَلَى الأَوْسَاقِ مِنَ الشَّعِيرِ ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَفْعَلُوا ، ازْرَعُوهَا أَوْ أَعِيرُوهَا أَوِ امْسِكُوهَا """"""","","Sunan al-Kubra al-Nasai 4531","","أَخْبَرَنَا أَحْمَدُ بْنُ حَفْصِ بْنِ عَبْدِ اللهِ قَالَ حَدَّثَنِي أَبِي قَالَ حَدَّثَنِي إِبْرَاهِيمُ بْنُ طَهْمَانَ عَنِ الْحَجَّاجِ بْنِ الْحَجَّاجِ عَنْ قَتَادَةَ عَنْ عِكْرِمَةَ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Sharecropping"
"4532","أَخْبَرَنَا هِشَامُ بْنُ عَمَّارٍ ، قَالَ : حدثَنَا يحْيَى وَهُوَ ابْنُ حَمْزَةَ ، قَالَ : حَدَّثَنِي الأَوْزَاعِيُّ ، عَنْ أَبِي النَّجَاشِيِّ ، عَنْ رَافِعٍ ، قَالَ : أَتَانًا ظُهَيْرُ بْنُ رَافِعٍ ، فَقَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ أَمْرٍ كَانَ بِنَا رَافِقًا ، قُلْتُ : وَمَا ذَاكَ ؟ مَا قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَهُوَ حَقٌّ ، قَالَ : سَأَلَنِي :كَيْفَ تَصْنَعُونَ فِي مَحَاقِلِكُمْ ؟ قُلْتُ : نُؤَاجِرُهَا عَلَى الرُّبُعِ وَالأَوْسَاقِ مِنَ التَّمْرِ أَوِ الشَّعِيرِ ، قَالَ : فَلا تَفْعَلُوا ، ازْرَعُوهَا أَوْ أَزْرِعُوهَا أَوِ امْسِكُوهَا """"""","Sahih|Sahih|Sahih Bukhari","Sunan al-Kubra al-Nasai 4532","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ وَمُحَمَّدُ بْنُ عَبْدِ الْأَعْلَى قَالَ حَدَّثَنَا يَزِيدُ وَهُوَ ابْنُ زُرَيْعٍ عَنْ سَعِيدٍ قَالَ حَدَّثَنَا قَتَادَةُ عَنِ الْحَسَنِ عَنْ سَمُرَةَ بْنِ جُنْدُبٍ","The Book of Sharecropping"
"4533","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمِ بْنِ نُعَيْمٍ ، قَالَ : حدَّثَنَا حَبَّانُ ، قَالَ : حدثَنَا عَبْدُ اللَّهِ بْنُ الْمُبَارَكِ ، عَنْ لَيْثِ بْنِ سَعْدٍ ، قَالَ : حَدَّثَنِي بُكَيْرُ بْنُ عَبْدِ اللَّهِ بْنِ الأَشَجِّ ، عَنْ أُسَيْدِ بْنِ رَافِعِ بْنِ خَدِيجٍ ، أَنَّ أَخَا رَافِعٍ ، قَالَ لِقَوْمِهِ :  قَدْ نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْيَوْمَ عَنْ شَيْءٍ كَانَ لَكُمْ رَافِقًا وَأَمْرُهُ طَاعَةٌ وَخَيْرٌ ،نَهَى عَنِ الْحَقْلِ """"""","","Sunan al-Kubra al-Nasai 4533","","","The Book of Sharecropping"
"4534","أَخْبَرَنَا الرَّبِيعُ بْنُ سُلَيْمَانَ ، قَالَ : حدثَنَا شعَيْبُ بْنُ اللَّيْثِ ، قَالَ : حدثنا اللَّيْثِ ، عَنِ جَعْفَرِ بْنِ رَبِيعَةَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ ، قَالَ : سَمِعْتُ أُسَيْدَ بْنَ رَافِعِ بْنِ خَدِيجٍ الأَنْصَارِيِّ ، يَذْكُرُ  أَنَّهُمْمَنَعُوا الْمُحَاقَلَةَ ، وَهِيَ أَرْضٌ تُزْرَعُ عَلَى بَعْضِ مَا فِيهَا """"""","","Sunan al-Kubra al-Nasai 4534","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا سُفْيَانُ عَنِ الزُّهْرِيِّ عَنْ سَعِيدٍ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Sharecropping"
"4535","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أَنْبَأَنَا حَبَّانُ ، قَالَ : أَنْبَأَنَا عَبْدُ اللَّهِ ، عَنْ سَعِيدِ بْنِ يَزِيدَ أَبِي شُجَاعٍ ، قَالَ : حَدَّثَنِي عِيسَى بْنُ سَهْلِ بْنِ رَافِعِ بْنِ خَدِيجٍ ، قَالَ :  إِنِّي لِيَتِيمٌ فِي حِجْرِ جَدِّي رَافِعِ بْنِ خَدِيجٍ ، وَبَلَغْتُ رَجُلا وَحَجَجْتُ مَعَهُ ، فَجَاءَ أَخِي عِمْرَانُ بْنُ سَهْلِ بْنِ رَافِعِ بْنِ خَدِيجٍ ، فَقَالَ : يَا أَبَتَاهُ إِنَّهُ قَدْ أَكْرَيْنَا أَرْضَنَا فُلانَةَ بِمِائَتَيْ دِرْهَمٍ ، فَقَالَ : يَا بُنَيَّ دَعْ ذَاكَ فَإِنَّ اللَّهَ عَزَّ وَجَلَّ سَيَجْعَلُ لَكُمْ رِزْقًا غَيْرَهُ ، إِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَدْنَهَى عَنْ كِرَاءِ الأَرْضِ """"""","","Sunan al-Kubra al-Nasai 4535","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا أَبُو دَاوُدَ قَالَ حَدَّثَنَا شُعْبَةُ قَالَ حَدَّثْتُ أَبَا إِسْحَاقَ عَنْ مَعْمَرٍ وَسُفْيَانَ بْنَ حُسَيْنٍ عَنِ الزُّهْرِيِّ عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ عَنْ أَبِي هُرَيْرَةَ أَحَدُهُمَا قَالَ","The Book of Sharecropping"
"4536","أَخْبَرَنَا الْحُسَيْنُ بْنُ مُحَمَّدٍ ، قَالَ : حدثَنَا إسْمَاعِيلُ بْنُ إِبْرَاهِيمَ قَالَ : حدثَنَا عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ، عَنْ أَبِي عُبَيْدَةَ بْنِ مُحَمَّدٍ ، عَنِ الْوَلِيدِ بْنِ أَبِي الْوَلِيدِ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ ، قَالَ : قَالَ زَيْدُ بْنُ ثَابِتٍ : يَغْفِرُ اللَّهُ لِرَافِعِ بْنِ خَدِيجٍ ، أَنَا وَاللَّهِ أَعْلَمُ بِالْحَدِيثِ مِنْهُ ،  إِنَّمَاكَانَا رَجُلَيْنِ اقْتَتَلا ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنْ كَانَ هَذَا شَأْنَكُمْ فَلا تُكْرُوا الْمَزَارِعَ ، فَسَمِعَ رَافِعٌ قَوْلَهُ : لا تُكْرُوا الْمَزَارِعَ """"""","Hasan|Hasan|Daif","Sunan al-Kubra al-Nasai 4536","","أَخْبَرَنَا عَمْرُو بْنُ زُرَارَةَ قَالَ أَخْبَرَنَا مُعَاذٌ قَالَ حَدَّثَنَا ابْنُ عَوْنٍ قَالَ حَدَّثَنَا أَبُو رَمْلَةَ قَالَ أَخْبَرَنَا مِخْنَفُ بْنُ سُلَيْمٍ قَالَ","The Book of Sharecropping"
"4537","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : ثنا يَزِيدُ ، قَالَ : ثنا عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ، عَنْ أَبِي عُبَيْدَةَ بْنِ مُحَمَّدِ بْنِ عَمَّارٍ ، عَنِ الْوَلِيدِ بْنِ الْوَلِيدِ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ ، عَنْ زَيْدِ بْنِ ثَابِتٍ ، قَالَ : أَنَا وَاللَّهِ أَعْلَمُ بِالْحَدِيثِ مِنْ رَافِعِ بْنِ خَدِيجٍ ، إِنَّمَاجَاءَ رَجُلانِ قَدِ اقْتَتَلا ، فَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  إِنْ كَانَ هَذَا شَأْنُكُمْ فَلا تُكْرُوا الْمَزَارِعَ """"""","","Sunan al-Kubra al-Nasai 4537","","أَخْبَرَنَا إِبْرَاهِيمُ بْنُ يَعْقُوبَ بْنِ إِسْحَاقَ قَالَ حَدَّثَنَا عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ أَبُو عَلِيٍّ الْحَنَفِيُّ قَالَ حَدَّثَنَا دَاوُدُ بْنُ قَيْسٍ قَالَ سَمِعْتُ عَمْرَو بْنَ شُعَيْبِ بْنِ عَبْدِ اللهِ بْنِ عَمْرٍو عَنْ أَبِيهِ","The Book of Sharecropping"
"4538","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حدثنا بِشْرٌ ، عَنْ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي عُبَيْدَةَ بْنِ مُحَمَّدِ بْنِ عَمَّارٍ ، عَنِ الْوَلِيدِ بْنِ الْوَلِيدِ ، عَنْ عُرْوَةَ بْنِ الزُّبَيْرِ ، عَنْ زَيْدِ بْنِ ثَابِتٍ ، قَالَ : يَغْفِرُ اللَّهُ لِرَافِعِ بْنِ خَدِيجٍ أَنَا كُنْتُ أَعْلَمُ بِالْحَدِيثِ ، إِنَّمَا جَاءَ رَجُلانِ مِنَ الأَنْصَارِ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَدِ اقْتَتَلا ، فَقَالَ : إِنْ كَانَ هَذَا شَأْنَكُمْ فَلا تُكْرُوا الْمَزَارِعَ ، فَسَمِعَ قَوْلَهُ : لا تُكْرُوا الْمَزَارِعَ ""، قَالَ أَبُو عَبْدِ الرَّحْمَنِ : كِتَابَةُ مُزَارَعَةٍ عَلَى أَنَّ الْبَذْرَ ، وَالنَّفَقَةَ عَلَى صَاحِبِ الأَرْضِ ، وَلِلْمُزَارِعِ رُبْعُ مَا يُخْرِجُ اللَّهُ عَزَّ وَجَلَّ مِنْهَا ، هَذَا كِتَابٌ كَتَبَهُ فُلانُ بْنُ فُلانٍ فِي صِحَّةٍ مِنْهُ وَجَوَازِ أَمْرٍ لِفُلانِ بْنِ فُلانٍ أَنَّكَ دَفَعْتَ إِلَيَّ جَمِيعَ أَرْضِكَ الَّتِي بِمَوْضِعِ كَذَا فِي مَدِينَةِ كَذَا مُزَارَعَةً ، وَهِيَ الأَرْضُ الَّتِي تُعْرَفُ بِكَذَا ، وَتَجْمَعُهَا حُدُودٌ أَرْبَعَةٌ يُحِيطُ بِهَا كُلِّهَا ، وَأَحَدُ تِلْكَ الْحُدُودِ بِأَسْرِهِ لَزِيقُ كَذَا ، وَالثَّانِي وَالثَّالِثُ وَالرَّابِعُ دَفَعْتَ إِلَيَّ جَمِيعَ أَرْضِكَ هَذِهِ الْمَحْدُودَةِ فِي هَذَا الْكِتَابِ بِحُدُودِهَا الْمُحِيطَةِ بِهَا ، وَجَمِيعِ حُقُوقِهَا ، وَشِرْبِهَا ، وَأَنْهَارِهَا ، وَسَوَاقِيهَا أَرْضًا بَيْضَاءَ فَارِغَةً لا شَيْءَ فِيهَا مِنْ غَرْسٍ ، وَلا زَرْعٍ سَنَةً تَامَّةً أَوَّلُهَا مُسْتَهَلُّ شَهْرِ كَذَا مِنْ سَنَةِ كَذَا ، وَآخِرُهَا انْسِلاخُ شَهْرِ كَذَا مِنْ سَنَةِ كَذَا عَلَى أَنْ أَزْرَعَ جَمِيعَ هَذِهِ الأَرْضِ الْمَحْدُودَةِ فِي هَذَا الْكِتَابِ الْمَوْصُوفِ مَوْضِعُهَا فِيهِ هَذِهِ السَّنَةُ الْمُؤَقَّتَةُ فِيهَا مِنْ أَوَّلِهَا إِلَى آخِرِهَا كُلَّ مَا أَرَدْتُ وَبَدَا لِي أَنْ أَزْرَعَ فِيهَا مِنْ حِنْطَةٍ ، وَشَعِيرٍ ، وَسَمَاسِمَ ، وَأُرْزٍ ، وَأَقْطَانٍ ، وَرِطَابٍ ، وَبَاقِلا ، وَحِمَّصٍ ، وَلُوبْيَا ، وَعَدَسٍ ، وَمَقَاثِيَ ، وَمَبَاطِيخَ ، وَجَزَرٍ ، وَشَلْجَمٍ ، وَفُجْلٍ ، وَبَصَلٍ ، وَثُومٍ ، وَبُقُولٍ ، وَرَيَاحِينَ ، وَغَيْرِ ذَلِكَ مِنْ جَمِيعِ الْغَلاتِ شِتَاءً وَصَيْفًا بِبُزُورِكَ وَبَذْرِكَ ، وَجَمِيعُهُ عَلَيْكَ دُونِي عَلَى أَنْ أَتَوَلَّى ذَلِكَ بِيَدِي ، وَبِمَنْ أَرَدْتُ مِنْ أَعْوَانِي ، وَأُجَرَائِي وَبَقَرِي ، وَأَدَوَاتِي وَإِلَى زَرَاعَةِ ذَلِكَ وَعِمَارَتِهِ ، وَالْعَمَلِ بِمَا فِيهِ نَمَاؤُهُ ، وَمَصْلَحَتُهُ ، وَكِرَابُ أَرْضِهِ ، وَتَنْقِيَةُ حَشِيشِهَا وَسَقْيُ مَا يُحْتَاجُ إِلَى سَقْيِهِ مِمَّا زُرِعَ ، وَتَسْمِيدُ مَا يُحْتَاجُ إِلَى تَسْمِيدِهِ ، وَحَفْرُ سَوَاقِيهِ وَأَنْهَارِهِ وَاجْتِنَاءِ مَا يُجْتَنَى مِنْهُ ، وَالْقِيَامُ بِحَصَادِ مَا يُحْصَدُ مِنْهُ ، وَجَمْعُهُ وَدِيَاسَةُ مَا يُدَاسُ مِنْهُ ، وَتَذْرِيَتُهُ بِنَفَقَتِكَ عَلَى ذَلِكَ كُلِّهِ دُونِي ، وَأَعْمَلُ فِيهِ كُلِّهِ بِيَدِي ، وَأَعْوَانِي دُونَكَ عَلَى أَنَّ لَكَ مِنْ جَمِيعِ مَا يُخْرِجُ اللَّهُ عَزَّ وَجَلَّ مِنْ ذَلِكَ كُلِّهِ فِي هَذِهِ الْمُدَّةِ الْمَوْصُوفَةِ فِي هَذَا الْكِتَابِ مِنْ أَوَّلِهَا إِلَى آخِرِهَا فَلَكَ ثَلاثَةُ أَرْبَاعِهِ بِحَظِّ أَرْضِكَ ، وَشِرْبِكَ وَبَذْرِكَ وَنَفَقَاتِكَ ، وَلِيَ الرُّبُعُ الْبَاقِي مِنْ جَمِيعِ ذَلِكَ بِزِرَاعَتِي ، وَعَمَلِي ، وَقِيَامِي عَلَى ذَلِكَ بِيَدِي ، وَأَعْوَانِي وَدَفَعْتَ إِلَيَّ جَمِيعَ أَرْضِكَ هَذِهِ الْمَحْدُودَةِ فِي هَذَا الْكِتَابِ بِجَمِيعِ حُقُوقِهَا ، وَمَرَافِقِهَا وَقَبَضْتُ ذَلِكَ كُلَّهُ مِنْكَ يَوْمَ كَذَا مِنْ شَهْرِ كَذَا مِنْ سَنَةِ كَذَا ، فَصَارَ جَمِيعُ ذَلِكَ فِي يَدَيَّ لَكَ لا مِلْكَ لِي فِي شَيْءٍ مِنْهُ ، وَلا دَعْوَى ، وَلا طَلِبَةَ إِلا هَذِهِ الْمُزَارَعَةَ الْمَوْصُوفَةَ فِي هَذَا الْكِتَابِ فِي هَذِهِ السَّنَةِ الْمُسَمَّاةِ فِيهِ ، فَإِذَا انْقَضَتْ فَذَلِكَ كُلُّهُ مَرْدُودٌ إِلَيْكَ وَإِلَى يَدِكِ وَلَكَ أَنْ تُخْرِجَنِي بَعْدَ انْقِضَائِهَا مِنْهَا وَتُخْرِجَهَا مِنْ يَدَيَّ وَيَدِ كُلِّ مَنْ صَارَتْ لَهُ فِيهَا يَدٌ بِسَبَبِي ، أَقَرَّ فُلانٌ وَفُلانٌ ، وَكُتِبَ هَذَا الْكِتَابُ نُسْخَتَيْنِ""","Daif|Daif|Hasan","Sunan al-Kubra al-Nasai 4538","","أَخْبَرَنَا سُوَيْدُ بْنُ نَصْرٍ قَالَ أَخْبَرَنَا عَبْدُ اللهِ يَعْنِي ابْنَ الْمُبَارَكِ عَنْ يَحْيَى قَالَ سَمِعْتُ أَبِي يَذْكُرُ أَنَّهُ سَمِعَ جَدَّهُ الْحَارِثَ بْنَ عَمْرٍو يُحَدِّثُ","The Book of Sharecropping"
"4539","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حدثَنَا اللَّيْثُ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، رَضِيَ اللَّهُ عَنْهُ ،  أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَدَفَعَ إِلَى يَهُودِ خَيْبَرَ نَخْلَ خَيْبَرَ ، وَأَرْضَهَا عَلَى أَنْ يُعْمِلُوهَا مِنْ أَمْوَالِهِمْ ، وَأَنَّ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ شَطْرَ ثَمَرَتِهَا """"""","Daif|Daif|Isnaad Hasan","Sunan al-Kubra al-Nasai 4539","","أَخْبَرَنِي هَارُونُ بْنُ عَبْدِ اللهِ حَدَّثَنَا عَفَّانُ قَالَ حَدَّثَنَا يَحْيَى بْنُ زُرَارَةَ السَّهْمِيُّ قَالَ حَدَّثَنِي أَبِي عَنْ جَدِّهِ الْحَارِثِ بْنِ عَمْرٍو وَأَخْبَرَنَا هَارُونُ قَالَ وَحَدَّثَنَا هِشَامُ بْنُ عَبْدِ الْمَلَكِ أَبُو الْوَلِيدِ الطَّيَالِسِيُّ قَالَ حَدَّثَنَا يَحْيَى بْنُ زُرَاةَ وَهُوَ ابْنُ كَرِيمِ بْنِ الْحَارِثِ بْنِ عَمْرٍو السَّهْمِيُّ قَالَ أَخْبَرَنِي أَبِي عَنْ جَدِّهِ الْحَارِثِ","The Book of Sharecropping"
"4540","أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللَّهِ بْنِ عَبْدِ الْحَكَمِ ، قَالَ : حدثَنَا شُعَيْبُ بْنُ اللَّيْثِ ، عَنْ أَبِيهِ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ نَافِعٍ ، عَنْ عَبْدِ اللَّهِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَعْطَى لِيَهُودِ خَيْبَرَ نَخْلَ خَيْبَرَ وَأَرْضَهَا عَلَى أَنْ يَعْمَلُوهَا ، وَيَزْرَعُوهَا بِأَمْوَالِهِمْ وَأَنَّ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ شَطْرَ مَا يَخْرُجُ مِنْهَا """"""","","Sunan al-Kubra al-Nasai 4540","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنِي ابْنُ أَبِي عَدِيٍّ عَنِ ابْنِ عَوْنٍ قَالَ حَدَّثَنَا جَمِيلٌ عَنْ أَبِي الْمَلِيحِ عَنْ نُبَيْشَةَ قَالَ","The Book of Sharecropping"
"4541","أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللَّهِ بْنِ عَبْدِ الْحَكَمِ ، قَالَ : حدثَنَا شُعَيْبُ بْنُ اللَّيْثِ ، عَنْ أَبِيهِ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ نَافِعٍ ، أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ كَانَ يَقُولُ : كَانَتِ الْمَزَارِعُ تُكْرَى عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى أَنَّ لِرَبِّ الأَرْضِ مَا عَلَى رَبِيعِ السَّاقِي مِنَ الزَّرْعِ ، وَطَائِفَةً مِنَ التِّبْنِ ، لا أَدْرِي كَمْ هُوَ ؟ """"""","","Sunan al-Kubra al-Nasai 4541","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا بِشْرٌ عَنْ خَالِدٍ وَرُبَّمَا قَالَ عَنْ أَبِي الْمَلِيحِ وَرُبَّمَا ذَكَرَ أَبُو قِلَابَةَ عَنْ نُبَيْشَةَ قَالَ نَادَى رَجُلٌ وَهُوَ بِمِنًى فَقَالَ","The Book of Sharecropping"
"4542","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أَنْبَأَنَا شَرِيكٌ ، عَنْ أَبِي إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ ، قَالَ : كَانَ عَمَّايَ يَزْرَعَانِ بِالثُّلُثِ وَالرُّبُعِ وَأَبِي شَرِيكُهُمَا وَعَلْقَمَةُ وَالأَسْوَدُ يَعْلَمَانِ فَلا يُغَيِّرَانِ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4542","","أَخْبَرَنَا عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ حَدَّثَنَا غُنْدَرٌ عَنْ شُعْبَةَ عَنْ خَالِدٍ عَنْ أَبِي قِلَابَةَ عَنِ أَبِي الْمَلِيحِ وَأَحْسِبُنِي قَدْ سَمِعْتُهُ عَنْ أَبِي الْمَلِيحِ عَنْ نُبَيْشَةَ رَجُلٍ مِنْ هُذَيْلٍ","The Book of Sharecropping"
"4543","حدثَنَا مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : َحدَّثَنَا الْمُعْتَمِرُ ، قَالَ : سَمِعْتُ مَعْمَرًا ، عَنْ عَبْدِ الْكَرِيمِ الْجَزَرِيِّ ، قَالَ : قَالَ سَعِيدُ بْنُ جُبَيْرٍ ، قَالَ ابْنُ عَبَّاسٍ :  إِنَّخَيْرَ مَا أَنْتُمْ صَانِعُونَ أَنْ يُؤَاجِرَ أَحَدُكُمْ أَرْضَهُ بِالذَّهَبِ وَالْوَرِقِ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4543","","أَخْبَرَنَا أَبُو الْأَشْعَثِ أَحْمَدُ بْنُ الْمِقْدَامِ وَمُحَمَّدُ بْنُ عَبْدِ اللهِ قَالَا حَدَّثَنَا يَزِيدُ قَالَ حَدَّثَنَا خَالِدٌ عَنْ أَبِي الْمَلِيحِ عَنْ نُبَيْشَةَ قَالَ","The Book of Sharecropping"
"4544","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : ثنا يَحْيَى ، عَنْ سُفْيَانَ ، قَالَ : حَدَّثَنِي أَبُو إِسْحَاقَ ، عَنْ أَبِي عُبَيْدَةَ ، عَنْ عَبْدِ اللَّهِ ، قَالَ : اشْتَرَكْتُ أَنَا ، وَعَمَّارٌ ، وَسَعْدٌ ، يَوْمَ بَدْرٍ فَجَاءَ سَعْدٌ بِأَسِيرَيْنِ وَلَمْ أَجِيءْ أَنَا ، وَعَمَّارٌ بِشَيْءٍ """"""","","Sunan al-Kubra al-Nasai 4544","","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ عَنِ ابْنِ عُلَيَّةَ عَنْ خَالِدٍ قَالَ حَدَّثَنِي أَبُو قِلَابَةَ عَنْ أَبِي الْمَلِيحِ فَلَقِيتُ أَبَا الْمَلِيحِ فَسَأَلْتُهُ فَحَدَّثَنِي عَنْ نُبَيْشَةَ الْهُذَلِيِّ قَالَ","The Book of Sharecropping"
"4545","أَخْبَرَنَا مُحَمَّدُ بْنُ حَاتِمٍ ، قَالَ : أنا حَبَّانُ ، قَالَ : ثنا عَبْدُ اللَّهِ ، عَنْ شُعْبَةَ ، عَنْ حَمَّادٍ ، عَنْ إِبْرَاهِيمَ ، عَنْ أَبِي سَعِيدٍ ، قَالَ : إِذَا اسْتَأْجَرْتَ أَجِيرًا فَأَعْلِمْهُ أَجْرَهُ """"""","Sahih Lighairihi|Sahih|Isnaad Hasan","Sunan al-Kubra al-Nasai 4545","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنْ يَعْلَى بْنِ عَطَاءٍ عَنْ وَكِيعِ بْنِ عُدُسٍ عَنْ عَمِّهِ أَبِي رَزِينٍ لَقِيطِ بْنِ عَامِرٍ الْعُقَيْلِيِّ قَالَ","The Book of Sharecropping"
"4546","أَخْبَرَنَا عَمْرُو بْنُ زُرَارَةَ ، قَالَ : أنا ابْنُ أَبِي زَائِدَةَ ، قَالَ : أنا ابْنُ عَوْنٍ ، عَنِ ابْنِ سِيرِينَ ، عَنْ عَبِيدَةَ ، قَالَ :  جَاءَ رَجُلٌ وَامْرَأَةٌ إِلَى عَلِيٍّ مَعَ كُلِّ وَاحِدٍ مِنْهُمَا فِئَامٌ مِنَ النَّاسِ ، فَلَمَّا بَعَثَ الدُّكَيْنَ ، قال : رُوَيْدَكُمَا حَتَّى أُعْلِمَكُمَا مَاذَا عَلَيْكُمَا ، هَلْ تَدْرِيَانِ مَاذَا عَلَيْكُمَا ؟ إِنَّكُمَاإِنْ رَأَيْتُمَا أَنْ تَجْمَعَا جَمَعْتُمَا ، وَإِنْ رَأَيْتُمَا أَنْ تُفَرِّقَا فَرَّقْتُمَا ، ثُمَّ أَقْبَلَ عَلَى الْمَرْأَةِ ، فَقَالَ : قَدْ رَضِيتِ بِمَا حَكَمَا ؟ قَالَتْ : نَعَمْ ، رَضِيتُ بِكِتَابِ اللَّهِ عَلَيَّ ولِيًّ ، ثُمَّ أَقْبَلَ عَلَى الرَّجُلِ ، فَقَالَ : قَدْ رَضِيتَ بِمَا حَكَمَا ؟ قَالَ : لا ، وَلَكِنِّي أَرْضَى أَنْ يَجْمَعَا وَلا أَرْضَى أَنْ يُفَرِّقَا ، فَقَالَ عَلِيٌّ : كَذَبْتَ وَاللَّهِ لا تَبْرَحْ حَتَّى تَرْضَى بِمِثْلِ الَّذِي رَضِيتُ """"""","","Sunan al-Kubra al-Nasai 4546","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنِ الزُّهْرِيِّ عَنْ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ عَنِ ابْنِ عَبَّاسٍ عَنْ مَيْمُونَةَ","The Book of Sharecropping"
"4547","قُرِئَ عَلَى أَبِي عَبْدِ الرَّحْمَنِ أَحْمَدَ بْنِ شُعَيْبِ بْنِ عَلِيٍّ النَّسَائِيِّ ، حَدَّثَكُمْ شُعَيْبُ بْنُ يُوسُفَ ، وَمُحَمَّدُ بْنُ الْمُثَنَّى قَالا : ثنا يَحْيَى ، عَنْ مُحَمَّدِ بْنِ يُوسُفَ ، عَنِ السَّائِبِ بْنِ يَزِيدَ ،  وَقَالَ مُحَمَّدٌ فِي حَدِيثِهِ : سَمِعْتُ السَّائِبَ بْنَ يَزِيدَ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : شَرُّ الْكَسْبِ ثَمَنُ الْكَلْبِ ، وَمَهْرُ الْبَغِيِّ ، وَكَسْبُ الْحَجَّامِ """"""","","Sunan al-Kubra al-Nasai 4547","","أَخْبَرَنَا مُحَمَّدُ بْنُ سَلَمَةَ وَالْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَاللَّفْظُ لَهُ عَنِ ابْنِ الْقَاسِمِ قَالَ حَدَّثَنِي مَالِكٌ عَنِ ابْنِ شِهَابٍ عَنْ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Sharecropping"
"4548","حدثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، ثنا حَاتِمٌ ، عَنْ مُحَمَّدِ بْنِ يُوسُفَ ، عَنِ السَّائِبِ بْنِ يَزِيدَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : شَرُّ الْكَسْبِ مَهْرُ الْبَغِيِّ ، وَثَمَنُ الْكَلْبِ ، وَكَسْبُ الْحَجَّامِ """"""","Sahih Isnaad|Sahih Isnaad|Hasan","Sunan al-Kubra al-Nasai 4548","","أَخْبَرَنَا عَبْدُ الْمَلِكِ بْنُ شُعَيْبِ بْنِ اللَّيْثِ بْنِ سَعْدٍ قَالَ حَدَّثَنِي أَبِي عَنْ جَدِّي عَنِ ابْنِ أَبِي حَبِيبٍ عَنْ حَفْصِ بْنِ الْوَلِيدِ عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ عَنْ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ حَدَّثَهُ أَنَّ ابْنَ عَبَّاسٍ حَدَّثَهُ","The Book of Sharecropping"
"4549","حدثَنَا الْحُسَيْنُ بْنُ حُرَيْثٍ ، أنا الْفَضْلُ بْنُ مُوسَى ، عَنْ جُعَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ يَزِيدَ بْنِ خُصَيْفَةَ ، عَنِ السَّائِبِ بْنِ يَزِيدَ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : شَرُّ الْكَسْبِ كَسْبُ الْحَجَّامِ ، وَثَمَنُ الْكَلْبِ ، وَمَهْرُ الْبَغِيِّ """"""","","Sunan al-Kubra al-Nasai 4549","","أَخْبَرَنِي عَبْدُ الرَّحْمَنِ بْنُ خَالِدٍ قَالَ حَدَّثَنِي حَجَّاجٌ قَالَ ابْنُ جُرَيْجٍ أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ قَالَ أَخْبَرَنِي عَطَاءٌ مُنْذُ حِينٍ عَنِ ابْنِ عَبَّاسٍ قَالَ أَخْبَرْتِنِي مَيْمُونَةُ أَنَّ شَاةً مَاتَتْ فَقَالَ","The Book of Sharecropping"
"4550","حدثَنَا عَلِيُّ بْنُ الْمُنْذِرِ الْكُوفِيُّ ، عَنِ ابْنِ فُضَيْلٍ ، ثنا مُحَمَّدُ بْنُ إِسْحَاقَ ، عن مُحَمَّدُ بْنُ إِبْرَاهِيمَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ ، سَمِعْتُ السَّائِبَ بْنَ يَزِيدَ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : السُّحْتُ ثَلاثٌ مَهْرُ الْبَغِيِّ ، وَكَسْبُ الْحَجَّامِ ، وَثَمَنُ الْكَلْبِ """"""","","Sunan al-Kubra al-Nasai 4550","","أَخْبَرَنَا مُحَمَّدُ بْنُ مَنْصُورٍ عَنْ سُفْيَانَ عَنْ عَمْرٍو عَنْ عَطَاءٍ قَالَ","The Book of Sharecropping"
"4551","ثنا مُحَمَّدُ بْنُ عَبْدِ اللَّهِ الْقَطَّانُ ، ثنا عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ، ثنا مُحَمَّدٌ وَهُوَ ابْنُ إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ مُحَمَّدِ بْنِ عَبْدِ اللَّهِ ، عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ ، عَنِ السَّائِبِ بْنِ يَزِيدَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مِنَ السُّحْتِ ثَمَنُ الْكَلْبِ ، وَمَهْرُ الْبَغِيِّ ، وَكَسْبُ الْحَجَّامِ "". قَالَ أَبُو عَبْدِ الرَّحْمَنِ : وَيُشْبِهُ أَنْ يَكُونَ ابْنُ فُضَيْلٍ نَسَبَ عَبْدَ الرَّحْمَنِ إِلَى جَدِّهِ""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4551","","أَخْبَرَنِي مُحَمَّدُ بْنُ قُدَامَةَ عَنْ جَرِيرٍ عَنْ مُغِيرَةَ عَنِ الشَّعْبِيِّ قَالَ","The Book of Sharecropping"
"4552","ثنا هِشَامُ بْنُ عَمَّارٍ ، ثنا يَحْيَى يَعْنِي بْنَ حَمْزَةَ ، حَدَّثَنِي الأَوْزَاعِيُّ ، عَنْ يَحْيَى ، عَنْ إِبْرَاهِيمَ بْنِ عَبْدِ اللَّهِ بْنِ قَارِظٍ ، عَنِ السَّائِبِ بْنِ يَزِيدَ ، عَنْ رَافِعِ بْنِ خَدِيجٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : كَسْبُ الْحَجَّامِ خَبِيثٌ ، وَمَهْرُ الْبَغِيِّ خَبِيثٌ ، وَثَمَنُ الْكَلْبِ خَبِيثٌ """"""","","Sunan al-Kubra al-Nasai 4552","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رِزْمَةَ قَالَ أَخْبَرَنَا الْفَضْلُ بْنُ مُوسَى عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ عَنِ الشَّعْبِيِّ عَنْ عِكْرِمَةَ عَنِ ابْنِ عَبَّاسٍ","The Book of Sharecropping"
"4553","حدثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ ، أَخْبَرَنَا مُعَاذُ بْنُ هِشَامٍ ، حَدَّثَنِي أَبِي ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ ، حَدَّثَنِي عَبْدُ اللَّهِ بْنُ إِبْرَاهِيمَ بْنِ قَارِظٍ ، أَنَّ السَّائِبَ بْنَ يَزِيدَ حَدَّثَهُ ، أَنَّ رَافِعَ بْنَ خَدِيجٍ حَدَّثَهُ  أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : ""كَسْبُ الْحَجَّامِ خَبِيثٌ ، وَمَهْرُ الْبَغِيِّ خَبِيثٌ ، وَثَمَنُ الْكَلْبِ خَبِيثٌ """"""","","Sunan al-Kubra al-Nasai 4553","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ وَعَلِيُّ بْنُ حُجْرٍ عَنْ سُفْيَانَ عَنْ زَيْدٍ عَنِ ابْنِ وَعْلَةَ عَنِ ابْنِ عَبَّاسٍ قَالَ","The Book of Sharecropping"
"4554","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنْ مُحَمَّدِ بْنِ يُوسُفَ ، عَنِ السَّائِبِ بْنِ يَزِيدَ ، قَالَ :  أَمَرَ عُمَرُ بْنُ الْخَطَّابِ ، أَبِي كَعْبٍ ، وَتَمِيمًا الدَّارِيَّ ، أَنْيَقُومُوا ، لِلنَّاسِ بِإِحْدَى عَشْرَةَ رَكْعَةً """"""","","Sunan al-Kubra al-Nasai 4554","","أَخْبَرَنِي الرَّبِيعُ بْنُ سُلَيْمَانَ بْنِ دَاوُدَ قَالَ حَدَّثَنَا إِسْحَاقُ بْنُ بَكْرٍ قَالَ حَدَّثَنِي أَبِي عَنْ جَعْفَرِ بْنِ رَبِيعَةَ أَنَّهُ سَمِعَ أَبَا الْخَيْرِ عَنِ ابْنِ وَعْلَةَ أَنَّهُ سَمِعَ ابْنَ عَبَّاسٍ فَقَالَ","The Book of Sharecropping"
"4555","حدثَنَا مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، ثنا خَالِدٌ يَعْنِي ابْنَ الْحَارِثِ ، ثنا ابْنُ جُرَيْجٍ ، عَنْ مُحَمَّدِ بْنِ يُوسُفَ ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ ، قَالَ :  دَخَلْتُ عَلَى أُمِّ سَلَمَةَ ، فَحَدَّثَتْنِي أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، كَانَيُصْبِحُ جُنُبًا مِنْ غَيْرِ احْتِلامٍ ثُمَّ يَصُومُ """"""","Sahih|Sahih|Daif","Sunan al-Kubra al-Nasai 4555","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا مُعَاذُ بْنُ هِشَامٍ قَالَ حَدَّثَنِي أَبِي عَنْ قَتَادَةَ عَنِ الْحَسَنِ عَنْ جَوْنِ بْنِ قَتَادَةَ عَنْ سَلَمَةَ بْنِ الْمُحَبَّقِ","The Book of Sharecropping"
"4556","وَحدثَنَا مَعَ هَذَا الْحَدِيثِ ، أَنَّهَا حَدَّثَتْهُ أَنَّهَا قَرَّبَتْ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ جَنْبًا مَشْوِيًّا فَأَكَلَ مِنْهُ ثُمَّ قَامَ إِلَى الصَّلاةِ ، وَلَمْ يَتَوَضَّأْ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4556","","أَخْبَرَنَا الْحُسَيْنُ بْنُ مَنْصُورِ بْنِ جَعْفَرٍ النَّيْسَابُورِيُّ قَالَ حَدَّثَنَا حُسَيْنٌ الْمَرْوَزِيُّ بْنُ مُحَمَّدٍ قَالَ حَدَّثَنَا شَرِيكٌ عَنِ الْأَعْمَشِ عَنْ عُمَارَةَ بْنِ عُمَيْرٍ عَنِ الْأَسْوَدِ عَنْ عَائِشَةَ قَالَتْ","The Book of Sharecropping"
"4557","حدثَنَا مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ عُلَيَّةَ ، َوإِبْرَاهِيمُ بْنُ الحَسَن ، قَالا : ثنا حَجَّاجٌ ، قَالَ : قَالَ ابْنُ جُرَيْجٍ ، أَخْبَرَنِي مُحَمَّدُ بْنُ يُوسُفَ ، أَنَّ عَطَاءَ بْنَ يَسَارٍ أَخْبَرَهُ ، أَنَّ أُمَّ سَلَمَةَ أَخْبَرَتْهُ  أَنَّهَاقَرَّبَتْ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ جَنْبًا مَشْوِيًّا فَأَكَلَ مِنْهُ ، ثُمَّ قَامَ إِلَى الصَّلاةِ وَلَمْ يَتَوَضَّأْ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4557","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعْدٍ قَالَ حَدَّثَنَا عَمِّي قَالَ حَدَّثَنَا شَرِيكٌ عَنِ الْأَعْمَشِ عَنْ إِبْرَاهِيمَ عَنِ الْأَسْوَدِ عَنْ عَائِشَةَ قَالَتْ سُئِلَ نَبِيُّ اللهِ ﷺ عَنْ جُلُودِ الْمَيْتَةِ فَقَالَ","The Book of Sharecropping"
"4558","حدثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنْ زَيْدِ بْنِ أَسْلَمَ ، عَنْ عَطَاءِ بْنِ يَسَارٍ ، عَنِ ابْنِ عَبَّاسٍ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَأَكَلَ كَتِفَ شَاةٍ ، وَلَمْ يَتَوَضَّأْ """"""","Sahih|Sahih|Sahih","Sunan al-Kubra al-Nasai 4558","","أَخْبَرَنِي أَيُّوبُ بْنُ مُحَمَّدٍ الْوَزَّانُ الرَّقِّيُّ قَالَ حَدَّثَنَا حَجَّاجُ بْنُ مُحَمَّدٍ قَالَ حَدَّثَنَا شَرِيكٌ عَنِ الْأَعْمَشِ عَنْ إِبْرَاهِيمَ عَنِ الْأَسْوَدِ عَنْ عَائِشَةَ","The Book of Sharecropping"
"4559","حَدَّثَنِي عِصْمَةُ بْنُ الْفَضْلِ النَّيْسَابُورِيُّ ، ثنا يَحْيَى بْنُ آدَمَ ، عَنْ إِبْرَاهِيمَ بْنِ حُمَيْدٍ الرُّؤَاسِيِّ ، ثنا هِشَامُ بْنُ عُرْوَةَ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ بْنِ الْحَارِثِ ، عَنْ أَنَسِ بْنِ مَالِكٍ ، قَالَ :  جَاءَ رَجُلٌ مِنْ بَنِي الصَّعْقِ أَحَدُ بَنِي كِلابٍ ، إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَسَأَلَهُ عَنْعَسْبِ الْفَحْلِ ، فَنَهَى عَنْهُ """"""","","Sunan al-Kubra al-Nasai 4559","","أَخْبَرَنِي إِبْرَاهِيمُ قَالَ حَدَّثَنَا مَالِكُ بْنُ إِسْمَاعِيلَ قَالَ حَدَّثَنَا إِسْرَائِيلُ عَنِ الْأَعْمَشِ عَنْ إِبْرَاهِيمَ عَنِ الْأَسْوَدِ عَنْ عَائِشَةَ قَالَتْ","The Book of Sharecropping"
"4560","حدثَنَا مُحَمَّدُ بْنُ بَشَّارٍ ، عَنْ مُحَمَّدٍ هُوَ غُنْدَرٌ ، ثنا شُعْبَةُ ، عَنِ الْمُغِيرَةِ ، سَمِعْتُ ابْنَ أَبِي نُعْم ، سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ كَسْبِ الْحَجَّامِ ، وَثَمَنِ الْكَلْبِ ، وَعَسْبِ الْفَحْلِ """"""","","Sunan al-Kubra al-Nasai 4560","","أَخْبَرَنَا سُلَيْمَانُ بْنُ دَاوُدَ عَنِ ابْنِ وَهْبٍ قَالَ أَخْبَرَنِي عَمْرُو بْنُ الْحَارِثِ وَاللَّيْثُ بْنُ سَعْدٍ عَنْ كَثِيرِ بْنِ فَرْقَدَ أَنَّ عَبْدَ اللهِ بْنَ مَالِكِ بْنِ حُذَافَةَ حَدَّثَهُ عَنِ الْعَالِيَةِ بِنْتِ سُبَيْعٍ","The Book of Sharecropping"
"4561","حَدَّثَنِي مُحَمَّدُ بْنُ عَلِيِّ بْنِ مَيْمُونٍ ، ثنا مُحَمَّدٌ وَهُوَ ابْنُ يُوسُفَ ، ثنا سُفْيَانُ ، عَنْ هِشَامٍ ، وَحدثَنَا مُحَمَّدُ بْنُ حَاتِمِ بْنِ نُعَيْمٍ ، قَالَ : أنا حَبَّانُ ، أنا عَبْدُ اللَّهِ وَهُوَ ابْنُ الْمُبَارَكِ ، عَنْ سُفْيَانَ ، عَنْ هِشَامٍ أَبِي كُلَيْبٍ ، عَنِ ابْنِ أَبِي نُعم ، عَنْ أَبِي سَعِيدٍ ، قَالَ : نُهَى عَنْ عَسْبِ الْفَحْلِ """"""","","Sunan al-Kubra al-Nasai 4561","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا بِشْرٌ يَعْنِي ابْنَ الْمُفَضَّلِ قَالَ حَدَّثَنَا شُعْبَةُ عَنِ الْحَكَمِ عَنِ ابْنِ أَبِي لَيْلَى عَنْ عَبْدِ اللهِ بْنِ عُكَيْمٍ قَالَ","The Book of Sharecropping"
"4562","حدثَنَا الْحَسَنُ بْنُ أَحْمَدَ بْنِ حَبِيبٍ ، ثنا مُحَمَّدٌ يَعْنِي ابْنَ عَبْدِ اللَّهِ بْنِ نُمَيْرٍ ، ثنا أَسْبَاطٌ ، ثنا الأَعْمَشُ ، عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ ، قَالَ : قَالَ أَبُو هُرَيْرَةَ : أَرْبَعٌ مِنَ السُّحْتِ ضِرَابُ الْفَحْلِ ، وَثَمَنُ الْكَلْبِ ، وَمَهْرُ الْبَغِيِّ ، وَكَسْبُ الْحَجَّامِ """"""","","Sunan al-Kubra al-Nasai 4562","","أَخْبَرَنَا مُحَمَّدُ بْنُ قُدَامَةَ قَالَ حَدَّثَنَا جَرِيرٌ عَنْ مَنْصُورٍ عَنِ الْحَكَمِ عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى عَنْ عَبْدِ اللهِ بْنِ عُكَيْمٍ قَالَ","The Book of Sharecropping"
"4563","حَدَّثَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ ، ثنا حَجَّاجُ بْنُ مُحَمَّدٍ ، قَالَ : قَالَ ابْنُ جُرَيْجٍ : أَخْبَرَنِي عَطَاءٌ ، أَنَّ سَعِيدًا مَوْلَى خَلِيفَةَ أَخْبَرَهُ : عَنْ أَبِي هُرَيْرَةَ ، قَالَ : خَرَاجُ الْحَجَّامِ ، وَثَمَنُ الْكَلْبِ ، وَمَهْرُ الزَّانِيَةِ مِنَ السُّحْتِ ""، رَوَاهُ عَمْرٌو ، عَنْ عَطَاءٍ ، وَقَالَ سَعِيدٌ""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4563","","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ قَالَ أَخْبَرَنَا شَرِيكٌ عَنْ هِلَالٍ الْوَزَّانِ عَنْ عَبْدِ اللهِ بْنِ عُكَيْمٍ قَالَ","The Book of Sharecropping"
"4564","ثنا مُحَمَّدُ بْنُ النَّضْرِ بْنِ مُسَاوِرٍ ، ثنا سُفْيَانُ ، عَنْ عَمْرٍو ، عَنْ عَطَاءٍ ، عَنْ سَعِيدٍ مَوْلَى خَلِيفَةَ ، سَمِعْتُ أَبَا هُرَيْرَةَ ، يَقُولُ : ثَمَنُ الْكَلْبِ ، وَمَهْرُ الْبَغِيِّ ، وَكَسْبُ الْحَجَّامِ سُحْتٌ """"""","Daif|Daif|Isnaad Hasan","Sunan al-Kubra al-Nasai 4564","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا بِشْرُ بْنُ عُمَرَ قَالَ حَدَّثَنَا مَالِكٌ وَالْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ عَنِ ابْنِ الْقَاسِمِ قَالَ حَدَّثَنِي مَالِكٌ عَنْ يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ قُسَيْطٍ عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ ثَوْبَانَ عَنْ أُمِّهِ عَنْ عَائِشَةَ","The Book of Sharecropping"
"4565","حدثَنَا وَاصِلُ بْنُ عَبْدِ الأَعْلَى الْكُوفِيُّ ، ثنا ابْنُ فُضَيْلٍ ، عَنِ الأَعْمَشِ ، عَنْ أَبِي حَازِمٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ ثَمَنِ الْكَلْبِ ، وَعَسْبِ التَّيْسِ """"""","","Sunan al-Kubra al-Nasai 4565","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعِيدٍ عَنْ يَحْيَى عَنِ ابْنِ أَبِي عَرُوبَةَ قَالَ حَدَّثَنَا قَتَادَةُ عَنْ أَبِي الْمَلِيحِ عَنْ أَبِيهِ","The Book of Sharecropping"
"4566","حدثَنَا مُحَمَّدُ بْنُ الْحُسَيْنِ ، ثنا ابْنُ أَبِي عُبَيْدَةَ ، ثنا أَبِي ، عَنِ الأَعْمَشِ ، عَنْ أَبِي حَازِمٍ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا يَحِلُّ ثَمَنُ الْكَلْبِ ، وَمَهْرُ الْبَغِيِّ """"""","Sahih|Sahih|Hasan","Sunan al-Kubra al-Nasai 4566","","أَخْبَرَنِي عَمْرُو بْنُ عُثْمَانَ قَالَ حَدَّثَنَا بَقِيَّةُ عَنْ بَحِيرٍ عَنْ خَالِدِ بْنِ مَعْدَانَ عَنِ الْمِقْدَامِ بْنِ مَعْدِ يَكْرِبَ قَالَ","The Book of Sharecropping"
"4567","حَدَّثَنِي إِبْرَاهِيمُ بْنُ الْحَسَنِ ، عَنْ حَجَّاجٍ ، قَالَ : قَالَ ابْنُ جُرَيْجٍ : أَخْبَرَنِي أَبُو الزُّبَيْرِ ، أَنَّهُ سَمِعَ جَابِرًا ، يَقُولُ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ ضِرَابِ الْجَمَلِ ، وَعَنْ بَيْعِ الْمَاءِ """"""","","Sunan al-Kubra al-Nasai 4567","","وأَخْبَرَنِي عَمْرُو بْنُ عُثْمَانَ قَالَ حَدَّثَنَا بَقِيَّةُ عَنْ بَحِيرٍ عَنْ خَالِدٍ قَالَ وَفَدَ الْمِقْدَامُ بْنُ مَعْدِ يَكْرِبَ عَلَى مُعَاوِيَةَ قَالَ أَنْشُدُكَ بِاللهِ هَلْ تَعْلَمُ","The Book of Sharecropping"
"4568","حدثَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، أنا إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، عَنْ عَلِيِّ بْنِ الْحَكَمِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَعَنْ عَسْبِ الْفَحْلِ """"""","","Sunan al-Kubra al-Nasai 4568","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ عَنْ جَابِرِ بْنِ عَبْدِ اللهِ","The Book of Sharecropping"
"4569","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا يَحْيَى بْنُ سَعِيدٍ ، عَنْ سُفْيَانَ ، قَالَ : حَدَّثَنِي أَبُو إِسْحَاقَ ، عَنْ أَبِي عُبَيْدَةَ ، عَنْ عَبْدِ اللَّهِ ، قَالَ : اشْتَرَكْتُ أَنَا وَعَمَّارٌ ، وَسَعْدٌ يَوْمَ بَدْرٍ فَجَاءَ سَعْدٌ بِأَسِيرَيْنِ ، وَلَمْ أَجِئْ أَنَا وَعَمَّارٌ بِشَيْءٍ """"""","Sahih|Sahih Hadith|Sahih - Agreed Upon","Sunan al-Kubra al-Nasai 4569","","أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ قَالَ أَخْبَرَنَا سُفْيَانُ عَنْ عَمْرٍو عَنْ طَاوُسٍ عَنِ ابْنِ عَبَّاسٍ قَالَ بَلَغَ عُمَرَ أَنَّ سَمُرَةَ بَاعَ خَمْرًا قَالَ قَاتَلَ اللهُ سَمُرَةَ أَلَمْ يَعْلَمْ","The Book of Sharecropping"
"4570","حدثَنَا أَبُو عَبْدِ الرَّحْمَنِ أَحْمَدُ بْنُ شُعَيْبٍ ، قَالَ : أَخْبَرَنَا إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبأ الْفَضْلُ بْنُ مُوسَى ، قَالَ : حدثَنَا مُحَمَّدُ بْنُ عَمْرٍو ، قَالَ : حدثَنَا أَبُو سَلَمَةَ ، عَنْ أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : لَمَّا خَلَقَ اللَّهُ الْجَنَّةَ وَالنَّارَ أَرْسَلَ جِبْرِيلَ إِلَى الْجَنَّةِ ، فَقَالَ : انْظُرْ إِلَيْهَا وَإِلَى مَا أَعْدَدْتُ لأَهْلِهَا فِيهَا ، فَنَظَرَ إِلَيْهَا فَرَجَعَ ، فَقَالَ : وَعِزَّتِكَ لا يَسْمَعُ بِهَا أَحَدٌ إِلا دَخَلَهَا ، فَأَمَرَ بِهَا فَحُفَّتْ بِالْمَكَارِهِ ، فَقَالَ : اذْهَبْ إِلَيْهَا فَانْظُرْ إِلَيْهَا وَإِلَى مَا أَعْدَدْتُ لأَهْلِهَا فِيهَا ، فَنَظَرَ إِلَيْهَا فَإِذَا هِيَ قَدْ حُفَّتْ بِالْمَكَارِهِ ، فَقَالَ : وَعِزَّتِكَ لَقَدْ خَشِيتُ أَنْ لا يَدْخُلَهَا أَحَدٌ ، قَالَ : اذْهَبْ فَانْظُرْ إِلَى النَّارِ ، وَإِلَى مَا أَعْدَدْتُ لأَهْلِهَا فِيهَا ، فَنَظَرَ إِلَيْهَا فَإِذَا هِيَ يَرْكَبُ بَعْضُهَا بَعْضًا فَرَجَعَ ، فَقَالَ : وَعِزَّتِكَ لا يَدْخُلُهَا أَحَدٌ ، فَأَمَرَ بِهَا فَحُفَّتْ بِالشَّهَوَاتِ ، فَقَالَ : ارْجِعْ إِلَيْهَا فَانْظُرْ إِلَيْهَا ، فَنَظَرَ إِلَيْهَا فَإِذَا هِيَ قَدْ حُفَّتْ بِالشَّهَوَاتِ فَرَجَعَ ، فَقَالَ : وَعِزَّتِكَ لَقَدْ خَشِيتُ أَنْ لا يَنْجُوَ مِنْهَا أَحَدٌ إِلا دَخَلَهَا """"""","Sahih|Daif|Sahih Bukhari","Sunan al-Kubra al-Nasai 4570","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنِ الزُّهْرِيِّ عَنْ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ عَنِ ابْنِ عَبَّاسٍ عَنْ مَيْمُونَةَ","The Book of Oaths and Vows"
"4571","أنبأ أَحْمَدُ بْنُ سُلَيْمَانَ ، وَمُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ، قَالا : حدثَنَا مُحَمَّدُ بْنُ بِشْرٍ ، قَالَ : حدثَنَا سُفْيَانُ ، عَنْ مُوسَى بْنِ عُقْبَةَ ، عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ بْنِ عُمَرَ ، عَنِ ابْنِ عُمَرَ ، قَالَ :  كَانَتْيَمِينٌ يَحْلِفُ عَلَيْهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لا ، وَمُقَلِّبِ الْقُلُوبِ """"""","","Sunan al-Kubra al-Nasai 4571","","أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ وَمُحَمَّدُ بْنُ يَحْيَى بْنِ عَبْدِ اللهِ عَنْ عَبْدِ الرَّحْمَنِ عَنْ مَالِكٍ عَنِ الزُّهْرِيِّ عَنْ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ عَنِ ابْنِ عَبَّاسٍ عَنْ مَيْمُونَةَ","The Book of Oaths and Vows"
"4572","أَخْبَرَنِي مُحَمَّدُ بْنُ يَحْيَى بْنِ عَبْدِ اللَّهِ ، قَالَ : حدَّثَنَا مُحَمَّدُ بْنُ الصَّلْتِ أَبُو يَعْلَى ، قَالَ : حدثَنَا عَبْدُ اللَّهِ بْنُ رَجَاءٍ ، عَنْ عَبَّادِ بْنِ إِسْحَاقَ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ أَبِيهِ ، قَالَ :  كَانَتْيَمِينٌ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَحْلِفُ بِهَا لا ، وَمُصَرِّفِ الْقُلُوبِ """"""","","Sunan al-Kubra al-Nasai 4572","","أَخْبَرَنَا خُشَيْشُ بْنُ أَصْرَمَ قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ قَالَ أَخْبَرَنِي عَبْدُ الرَّحْمَنِ بْنُ بُوذُوَيْهِ أَنَّ مَعْمَرًا ذَكَرَهُ عَنِ الزُّهْرِيِّ عَنْ عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ عَنِ ابْنِ عَبَّاسٍ عَنْ مَيْمُونَةَ","The Book of Oaths and Vows"
"4573","أنبأ عَلِيُّ بْنُ حُجْرٍ ، عَنْ إِسْمَاعِيلَ ، قَالَ : حدثَنَا عَبْدُ اللَّهِ بْنُ دِينَارٍ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ كَانَ حَالِفًا فَلا يَحْلِفُ إِلا بِاللَّهِ ، وَكَانَتْ قُرَيْشٌ تَحْلِفُ بِآبَائِهَا ، فَقَالَ : لا تَحْلِفُوا بِآبَائِكُمْ """"""","Sahih Isnaad|Sahih Isnaad|Sahih Bukhari","Sunan al-Kubra al-Nasai 4573","","أَخْبَرَنَا سَلَمَةُ بْنُ أَحْمَدَ بْنِ سُلَيْمِ بْنِ عُثْمَانَ قَالَ حَدَّثَنَا جَدِّي الْخَطَّابُ يَعْنِي ابْنَ عُثْمَانَ قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ حِمْيَرٍ قَالَ حَدَّثَنَا ثَابِتُ بْنُ عَجْلَانَ قَالَ سَمِعْتُ سَعِيدَ بْنَ جُبَيْرٍ يَقُولُ","The Book of Oaths and Vows"
"4574","أَخْبَرَنِي زِيَادُ بْنُ أَيُّوبَ ، قَالَ : ثنا ابْنُ عُلَيَّةَ ، قَالَ : ثنا يَحْيَى بْنُ أَبِي إِسْحَاقَ ، قَالَ : حَدَّثَنِي رَجُلٌ مِنْ بَنِي غِفَارٍ ، فِي مَجْلِسِ سَالِمِ بْنِ عَبْدِ اللَّهِ ، قَالَ : قَالَ سَالِمٌ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ عُمَرَ ، يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنَّ اللَّهَ يَنْهَاكُمْ أَنْ تَحْلِفُوا بِآبَائِكُمْ """"""","Sahih|Sahih|Isnaad Hasan","Sunan al-Kubra al-Nasai 4574","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا ابْنُ أَبِي ذِئْبٍ قَالَ حَدَّثَنِي سَعِيدُ بْنُ خَالِدٍ عَنْ أَبِي سَلَمَةَ عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ","The Book of Oaths and Vows"
"4575","أنبأ عُبَيْدُ اللَّهِ بْنُ سَعِيدٍ ، وَقُتَيْبَةُ بْنُ سَعِيدٍ وَاللَّفْظُ لَهُ قَالا : حدثَنَا سُفْيَانُ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ أَبِيهِ ، قَالَ :  سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عُمَرَ وَهُوَ يَقُولُ : وَأَبِي وَأَبِي ، فَقَالَ :إِنَّ اللَّهَ يَنْهَاكُمْ أَنْ تَحْلِفُوا بِآبَائِكُمْ ""، قَالَ عُمَرُ : فَوَاللَّهِ مَا حَلَفْتُ بِهَا بَعْدُ ذَاكِرًا وَلا آثِرًا""","","Sunan al-Kubra al-Nasai 4575","","أَخْبَرَنَا مُحَمَّدُ بْنُ إِبْرَاهِيمَ بْنِ صُدْرَانَ الْبَصْرِيُّ قَالَ حَدَّثَنَا خَالِدٌ وَهُوَ ابْنُ الْحَارِثِ قَالَ قَرَأْتُ عَلَى عَبْدِ الْحَمِيدِ بْنِ جَعْفَرٍ قَالَ أَخْبَرَنِي أَبِي عَنْ رَافِعِ بْنِ أُسَيْدِ بْنِ ظُهَيْرٍ عَنْ أَبِيهِ أُسَيْدِ بْنِ ظُهَيْرٍ أَنَّهُ خَرَجَ إِلَى قَوْمِهِ إِلَى بَنِي حَارِثَةَ فَقَالَ","The Book of Oaths and Vows"
"4576","أنبأ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ يَزِيدَ ، وَسَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ وَاللَّفْظُ لَهُ ، قَالا : ثنا سُفْيَانُ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ أَبِيهِ ، عَنْ عُمَرَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : أَلا إِنَّ اللَّهَ يَنْهَاكُمْ أَنْ تَحْلِفُوا بِآبَائِكُمْ ""، فَوَاللَّهِ مَا حَلَفْتُ بِهَا بَعْدُ ذَاكِرًا وَلا آثِرًا""","","Sunan al-Kubra al-Nasai 4576","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ الْمُبَارَكِ قَالَ حَدَّثَنَا يَحْيَى وَهُوَ ابْنُ آدَمَ قَالَ حَدَّثَنَا مُفَضَّلٌ بْنُ مُهَلْهِلٍ عَنْ مَنْصُورٍ عَنْ مُجَاهِدٍ عَنْ أُسَيْدِ بْنِ ظُهَيْرٍ قَالَ جَاءَنَا رَافِعُ بْنُ خَدِيجٍ فَقَالَ","The Book of Oaths and Vows"
"4577","أَخْبَرَنِي عَمْرُو بْنُ عُثْمَانَ بْنِ سَعِيدٍ الْحِمْصِيُّ ، قَالَ : حدثَنَا مُحَمَّدٌ يَعْنِي ابْنَ حَرْبٍ ، عَنِ الزُّبَيْدِيِّ ، عَنِ الزُّهْرِيِّ ، عَنْ سَالِمٍ ، عَنْ أَبِيهِ أَنَّهُ أَخْبَرَهُ ، عَنْ عُمَرَ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : إِنَّ اللَّهَ يَنْهَاكُمْ أَنْ تَحْلِفُوا بِآبَائِكُمْ ""، قَالَ عُمَرُ : فَوَاللَّهِ مَا حَلَفْتُ بِهَا بَعْدُ ذَاكِرًا وَلا آثِرًا""","","Sunan al-Kubra al-Nasai 4577","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا مُحَمَّدٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ مَنْصُورٍ سَمِعْتُ مُجَاهِدًا يُحَدِّثُ عَنْ أُسَيْدِ بْنِ ظُهَيْرٍ قَالَ أَتَانًا رَافِعُ بْنُ خَدِيجٍ فَقَالَ","The Book of Oaths and Vows"
"4578","أنبأ أَبُو بَكْرِ بْنُ عَلِيٍّ ، قَالَ : حدثَنَا عُبَيْدُ اللَّهِ بْنُ مُعَاذٍ بْنِ مُعَاذٍ ، قَالَ : حدثَنَا أَبِي ، قَالَ : حدثَنَا عَوْفٌ ، عَنْ مُحَمَّدِ بْنِ سِيرِينَ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَحْلِفُوا بِآبَائِكُمْ ، وَلا بِأُمَّهَاتِكُمْ ، وَلا بِالأَنْدَادِ ، وَلا تَحْلِفُوا بِاللَّهِ إِلا وَأَنْتُمْ صَادِقُونَ """"""","","Sunan al-Kubra al-Nasai 4578","","أَخْبَرَنِي مُحَمَّدُ بْنُ قُدَامَةَ قَالَ حَدَّثَنَا جَرِيرٌ عَنْ مَنْصُورٍ عَنْ مُجَاهِدٍ عَنْ أُسَيْدِ بْنِ ظُهَيْرٍ قَالَ أَتَى عَلَيْنَا رَافِعُ بْنُ خَدِيجٍ فَقَالَ وَلَمْ أَفْهَمْ فَقَالَ","The Book of Oaths and Vows"
"4579","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حدثَنَا ابْنُ أَبِي عَدِيٍّ ، عَنْ خَالِدٍ ، وَأنبأ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ بَزِيعٍ ، قَالَ : حدثَنَا يَزِيدُ ، قَالَ : حدثَنَا خَالِدٌ ، عَنْ أَبِي قِلابَةَ ، عَنْ ثَابِتِ بْنِ الضَّحَّاكِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ حَلَفَ بِمِلَّةٍ سِوَى الإِسْلامِ كَاذِبًا فَهُوَ كَمَا قَالَ ، وَمَنْ قَتَلَ نَفْسَهُ بِشَيْءٍ عَذَّبَهُ اللَّهُ بِهِ فِي نَارِ جَهَنَّمَ ""، وَقَالَ قُتَيْبَةُ فِي حَدِيثِهِ : بِشَيْءٍ مُتَعَمِّدًا""","","Sunan al-Kubra al-Nasai 4579","","أَخْبَرَنَا إِسْحَاقُ بْنُ يَعْقُوبَ بْنِ إِسْحَاقَ بَغْدَادِيٌّ قَالَ حَدَّثَنَا عَفَّانُ قَالَ حَدَّثَنَا عَبْدُ الْوَاحِدِ قَالَ حَدَّثَنَا سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ قَالَ حَدَّثَنَا مُجَاهِدٍ قَالَ حَدَّثَنِي أُسَيْدُ ابْنُ أَخِي رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Oaths and Vows"
"4580","أَخْبَرَنِي مَحْمُودُ بْنُ خَالِدٍ ، قَالَ : حدثَنَا الْوَلِيدُ ، قَالَ : حدثَنَا أَبُو عَمْرٍو ، عَنْ يَحْيَى ، أَنَّهُ حَدَّثَهُ ، قَالَ : حَدَّثَنِي أَبُو قِلابَةَ ، قَالَ : حَدَّثَنِي ثَابِتُ بْنُ الضَّحَّاكِ ، أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ حَلَفَ بِمِلَّةٍ سِوَى الإِسْلامِ كَاذِبًا فَهُوَ كَمَا قَالَ ، وَمَنْ قَتَلَ نَفْسَهُ بِشَيْءٍ عُذِّبَ بِهِ فِي الآخِرَةِ """"""","","Sunan al-Kubra al-Nasai 4580","","أَخْبَرَنَا عَلِيُّ بْنُ حُجْرٍ قَالَ أَخْبَرَنَا عُبَيْدُ اللهِ عَنْ عَبْدِ الْكَرِيمِ عَنْ مُجَاهِدٍ قَالَ أَخَذْتُ بِيَدِ طَاوُسٍ حَتَّى أَدْخَلْتُهُ عَلَى ابْنِ رَافِعِ بْنِ خَدِيجٍ فَحَدَّثَ عَنْ أَبِيهِ","The Book of Oaths and Vows"
"4581","أنبأ الْحُسَيْنُ بْنُ حُرَيْثٍ ، قَالَ : أنبأ الْفَضْلُ بْنُ مُوسَى ، عَنْ حُسَيْنِ بْنِ وَاقِدٍ ، عَنْ عَبْدِ اللَّهِ بْنِ بُرَيْدَةَ ، عَنْ أَبِيهِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ قَالَ إِنِّي بَرِيءٌ مِنَ الإِسْلامِ ، فَإِنْ كَانَ كَاذِبًا فَهُوَ كَمَا قَالَ ، وَإِنْ كَانَ صَادِقًا لَمْ يَعُدْ إِلَى الإِسْلامِ سَالِمًا """"""","","Sunan al-Kubra al-Nasai 4581","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا أَبُو عَوَانَةَ عَنْ أَبِي حَصِينٍ عَنْ مُجَاهِدٍ قَالَ","The Book of Oaths and Vows"
"4582","أنبأ يُوسُفُ بْنُ عِيسَى الْمَرْوَزِيُّ ، قَالَ : أنبأ الْفَضْلُ بْنُ مُوسَى ، قَالَ : أنبأ مِسْعَرٌ ، عَنْ مَعْبَدِ بْنِ خَالِدٍ ، عَنْ عَبْدِ اللَّهِ بْنِ يَسَارٍ ، عَنْ قُتَيْلَةَ امْرَأَةٍ مِنْ جُهَيْنَةَ ،  أَنَّ يَهُودِيًّا أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَقَالَ : إِنَّكُمْ تُنَدِّدُونَ وَإِنَّكُمْ تُشْرِكُونَ ، تَقُولُونَ مَا شَاءَ اللَّهُ وَشِئْتُ ، وَتَقُولُونَ وَالْكَعْبَةِفَأَمَرَهُمُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَرَادُوا أَنْ يَحْلِفُوا أَنْ يَقُولُوا : وَرَبِّ الْكَعْبَةِ ، وَيَقُولُ أَحَدُهُمْ مَا شَاءَ اللَّهُ ثُمَّ شِئْتُ """"""","","Sunan al-Kubra al-Nasai 4582","","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا عُبَيْدِ اللهِ قَالَ حَدَّثَنَا إِسْرَائِيلُ عَنْ إِبْرَاهِيمَ بْنِ مُهَاجِرٍ عَنْ مُجَاهِدٍ عَنْ رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Oaths and Vows"
"4583","أنبأ أَحْمَدُ بْنُ سُلَيْمَانَ ، قَالَ : حدثَنَا يَزِيدُ قَالَ : أنبأ هِشَامٌ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : لا تَحْلِفُوا بِآبَائِكُمْ وَلا بِالطَّوَاغِيتِ """"""","","Sunan al-Kubra al-Nasai 4583","","أَخْبَرَنَا مُحَمَّدُ بْنُ الْمُثَنَّى وَمُحَمَّدُ بْنُ بَشَّارٍ قَالَا حَدَّثَنَا مُحَمَّدٌ قَالَ حَدَّثَنَا شُعْبَةُ عَنِ الْحَكَمِ عَنْ مُجَاهِدٍ عَنْ رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Oaths and Vows"
"4584","أنبأ كَثِيرُ بْنُ عُبَيْدٍ ، قَالَ : حدثَنَا مُحَمَّدُ بْنُ حَرْبٍ ، عَنِ الزُّبَيْدِيِّ ، عَنِ الزُّهْرِيِّ ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ ، عَنْ أَبِي هُرَيْرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ حَلَفَ مِنْكُمْ ، فَقَالَ : بِاللاتِ فَلْيَقُلْ : لا إِلَهَ إِلا اللَّهُ ، وَمَنْ قَالَ لِصَاحِبِهِ تَعَالَ أُقَامِرْكَ فَلْيَتَصَدَّقْ """"""","","Sunan al-Kubra al-Nasai 4584","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ عَنْ خَالِدٍ وَهُوَ ابْنُ الْحَارِثِ قَالَ حَدَّثَنَا شُعْبَةُ عَنْ عَبْدِ الْمَلِكِ عَنْ مُجَاهِدٍ قَالَ حَدَّثَ رَافِعُ بْنُ خَدِيجٍ قَالَ","The Book of Oaths and Vows"
"4585","أنبأ أَبُو دَاوُدَ الْحَرَّانِيُّ ، قَالَ : َحدَّثَنَا الْحَسَنُ بْنُ مُحَمَّدٍ وَهُوَ ابْنُ أَعْيَنَ ، ثِقَةٌ قَالَ : حدثَنَا زُهَيْرٌ ، قَالَ : حدثَنَا أَبُو إِسْحَاقَ ، عَنْ مُصْعَبِ بْنِ سَعْدٍ ، عَنْ أَبِيهِ ، قَالَ :  كُنَّا نَذْكُرُ بَعْضَ الأَمْرِ وَأَنَا حَدِيثُ عَهْدٍ بِالْجَاهِلِيَّةِ ، فَحَلَفْتُ بِاللاتِ وَالْعُزَّى ، فَقَالَ لِي أَصْحَابُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : بِئْسَ مَا قُلْتَ ، ائْتِ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَأَخْبِرْهُ فَإِنَّا لا نَرَاكَ إِلا قَدْ كَفَرْتَ ، فَلَقِيتُهُ فَأَخْبَرْتُهُ ، فَقَالَ :قُلْ : لا إِلَهَ إِلا اللَّهُ وَحْدَهُ ثَلاثَ مَرَّاتٍ ، وَتَعَوَّذْ مِنَ الشَّيْطَانِ ثَلاثَ مَرَّاتٍ ، وَاتْفِلْ عَنْ شِمَالِكَ ثَلاثَ مَرَّاتٍ وَلا تَعُدْ لَهُ """"""","","Sunan al-Kubra al-Nasai 4585","","أَخْبَرَنَا عَبْدُ الرَّحْمَنِ بْنُ خَالِدٍ قَالَ حَدَّثَنَا حَجَّاجٌ قَالَ حَدَّثَنِي شُعْبَةُ عَنْ عَبْدِ الْمَلِكِ عَنْ عَطَاءٍ وَطَاوُسٍ وَمُجَاهِدٍ عَنْ رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Oaths and Vows"
"4586","أنبأ عَبْدُ الْحَمِيدِ بْنُ مُحَمَّدٍ ، قَالَ : حدثَنَا مخْلَدٌ ، قَالَ : حدثَنَا يُونُسُ ، عَنْ أَبِيهِ ، قَالَ : حَدَّثَنِي مُصْعَبُ بْنُ سَعْدٍ ، عَنْ أَبِيهِ ، قَالَ :  حَلَفْتُ بِاللاتِ وَالْعُزَّى ، فَقَالَ أَصْحَابُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : بِئْسَ مَا قُلْتَ هُجْرًا ، فَأَتَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرْتُ ذَلِكَ لَهُ ، فَقَالَ :قُلْ : لا إِلَهَ إِلا اللَّهُ وَحْدَهُ لا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، وَانْفُثْ عَنْ شِمَالِكَ ثَلاثًا ، وَتَعَوَّذْ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ ثُمَّ لا تَعُدْ """"""","","Sunan al-Kubra al-Nasai 4586","","","The Book of Oaths and Vows"
"4587","أنبأ مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، عَنْ مُحَمَّدٍ ، قَالَ : حدثَنَا شُعْبَةُ ، عَنِ الأَشْعَثِ بْنِ سُلَيْمٍ ثِقَةٌ ، عَنْ مُعَاوِيَةَ بْنِ سُوَيْدِ بْنِ مُقَرِّنٍ ، عَنِ الْبَرَاءِ بْنِ عَازِبٍ ، قَالَ :  أَمَرَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِسَبْعٍ :أَمَرَنَا بِاتِّبَاعِ الْجَنَائِزِ ، وَعِيَادَةِ الْمَرِيضِ ، وَتَشْمِيتِ الْعَاطِسِ ، وَإِجَابَةِ الدَّاعِي ، وَنَصْرِ الْمَظْلُومِ ، وَإِبْرَارِ الْقَسَمِ ، وَرَدِّ السَّلامِ """"""","","Sunan al-Kubra al-Nasai 4587","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ قَالَ حَدَّثَنَا عَبْدُ الْمَلِكِ عَنْ عَطَاءٍ عَنْ جَابِرٍ","The Book of Oaths and Vows"
"4588","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حدثَنَا ابْنُ أَبِي عَدِيٍّ ، عَنْ سُلَيْمَانَ هُوَ التَّيْمِيُّ ، عَنْ أَبِي السَّلِيلِ ، عَنْ زَهْدَمٍ ، عَنْ أَبِي مُوسَى ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَا عَلَى الأَرْضِ يَمِينٌ أَحْلِفُ عَلَيْهَا ، فَأَرَى غَيْرَهَا خَيْرًا مِنْهَا إِلا أَتَيْتُهُ """"""","","Sunan al-Kubra al-Nasai 4588","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا عَبْدُ الْمَلِكِ عَنْ عَطَاءٍ عَنْ جَابِرٍ قَالَ","The Book of Oaths and Vows"
"4589","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حدثَنَا حمَّادٌ وَهُوَ ابْنُ زَيْدٍ ، عَنْ غَيْلانَ بْنِ جَرِيرٍ ، عَنْ أَبِي بُرْدَةَ ، عَنْ أَبِي مُوسَى الأَشْعَرِيِّ ، قَالَ :  أَتَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي يَعْنِي رَهْطٍ مِنَ الأَشْعَرِيِّينَ نَسْتَحْمِلُهُ ، فَقَالَ :وَاللَّهِ لا أَحْمِلُكُمْ وَمَا عِنْدِي مَا أَحْمِلُكُمْ ، ثُمَّ لَبِثْنَا مَا شَاءَ اللَّهُ ، فَأُتِيَ بِإِبِلٍ فَأَمَرَ لَنَا بِثَلاثَةِ ذَوْدٍ ، فَلَمَّا انْطَلَقْنَا قَالَ بَعْضُنَا لِبَعْضٍ : لا يُبَارِكُ اللَّهُ لَنَا أَتَيْنَا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَسْتَحْمِلُهُ فَحَلَفَ لا يَحْمِلُنَا فَحَمَلْنَا ، قَالَ أَبُو مُوسَى : فَأَتَيْنَا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَذَكَرْنَا ذَلِكَ لَهُ ، فَقَالَ : مَا أَنَا حَمَلْتُكُمْ بَلِ اللَّهُ حَمَلَكُمْ ، إِنِّي وَاللَّهِ إِنْ شَاءَ اللَّهُ لا أَحْلِفُ عَلَى يَمِينٍ فَأَرَى غَيْرَهَا خَيْرًا مِنْهَا إِلا كَفَّرْتُ عَنْ يَمِينِي وَأَتَيْتُ الَّذِي هُوَ خَيْرٌ """"""","","Sunan al-Kubra al-Nasai 4589","","أَخْبَرَنَا هِشَامُ بْنُ عَمَّارٍ عَنْ يَحْيَى وَهُوَ ابْنُ حَمْزَةَ قَالَ حَدَّثَنِي الْأَوْزَاعِي عَنْ عَطَاءٍ عَنْ جَابِرٍ قَالَ كَانَ لِأُنَاسٍ فَضْلُ أَرَضِينَ يُكْرُونَهُ بِالنِّصْفِ وَالثُّلُثِ وَالرُّبُعِ فَقَالَ","The Book of Oaths and Vows"
"4590","أنبأ قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنْ سُهَيْلٍ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ حَلَفَ عَلَى يَمِينٍ فَرَأَى الَّذِي هُوَ خَيْرٌ ، فَلْيُكَفِّرْ عَنْ يَمِينِهِ وَلْيَفْعَلْ """"""","","Sunan al-Kubra al-Nasai 4590","","أَخْبَرَنَا عِيسَى بْنُ مُحَمَّدٍ وَعِيسَى بْنِ يُونُسَ قَالَا حَدَّثَنَا ضَمْرَةُ عَنِ ابْنِ شَوْذَبٍ عَنْ مَطَرِ بْنِ طَهْمَانَ عَنْ عَطَاءٍ عَنْ جَابِرِ بْنِ عَبْدِ اللهِ قَالَ","The Book of Oaths and Vows"
"4591","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا يَحْيَى ، قَالَ : حدثَنَا عُبَيْدُ اللَّهِ بْنُ الأَخْنَسِ ، قَالَ : ثنا عَمْرُو بْنُ شُعَيْبٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ حَلَفَ عَلَى يَمِينٍ فَرَأَى غَيْرَهَا خَيْرًا مِنْهَا فَلْيُكَفِّرْ عَنْ يَمِينِهِ وَلْيَأْتِ الَّذِي هُوَ خَيْرٌ """"""","","Sunan al-Kubra al-Nasai 4591","","أَخْبَرَنِي مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ عَنْ يُونُسَ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ مَطَرٍ عَنْ عَطَاءٍ عَنْ جَابِرٍ رَفَعَهُ «§نَهَى عَنْ كِرَاءِ الْأَرْضِ» وَافَقَهُ عَبْدُ الْمَلَكِ بْنُ عَبْدِ الْعَزِيزِ بْنِ جُرَيْجٍ عَلَى النَّهْيِ","The Book of Oaths and Vows"
"4592","أنبأ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : َحدَّثَنَا الْمُعْتَمِرُ ، عَنْ أَبِيهِ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : إِذَا حَلَفَ أَحَدُكُمْ عَلَى يَمِينٍ ، فَرَأَى غَيْرَهَا خَيْرًا مِنْهَا فَلْيُكَفِّرْ عَنْ يَمِينِهِ ، وَلْيَنْظُرْ إِلَى الَّذِي هُوَ خَيْرٌ فَلْيَأْتِهِ """"""","","Sunan al-Kubra al-Nasai 4592","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا الْمُفَضَّلُ عَنِ ابْنِ جُرَيْجٍ عَنْ عَطَاءٍ وَأَبِي الزُّبَيْرِ عَنْ جَابِرٍ","The Book of Oaths and Vows"
"4593","أنبأ أَحْمَدُ بْنُ سُلَيْمَانَ ، قَالَ : حدثَنَا عَفَّانُ قَالَ : حدثَنَا جَرِيرُ بْنُ حَازِمٍ ، قَالَ : سَمِعْتُ الْحَسَنَ ، قَالَ : حدثَنَا عَبْدُ الرَّحْمَنِ بْنُ سَمُرَةَ ، قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : وَإِذَا حَلَفْتَ عَلَى يَمِينٍ فَكَفِّرْ عَنْ يَمِينِكَ ثُمَّ ائْتِ الَّذِي هُوَ خَيْرٌ """"""","","Sunan al-Kubra al-Nasai 4593","","أَخْبَرَنِي زِيَادُ بْنُ أَيُّوبَ قَالَ أَخْبَرَنَا عَبَّادُ بْنُ الْعَوَّامِ قَالَ أَخْبَرَنَا سُفْيَانُ بْنُ حُسَيْنٍ قَالَ حَدَّثَنَا يُونُسُ بْنُ عُبَيْدٍ عَنْ عَطَاءٍ عَنْ جَابِرٍ","The Book of Oaths and Vows"
"4594","أنبأ مُحَمَّدُ بْنُ يَحْيَى الْقُطَيْعِيُّ الْبَصْرِيُّ ، عَنْ عَبْدِ الأَعْلَى هُوَ ابْنُ عَبْدِ الأَعْلَى الْبَصْرِيُّ ، وَذَكَرَ كَلِمَةً مَعْنَاهَا ، حدثَنَا سَعِيدٌ ، عَنْ قَتَادَةَ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : إِذَا حَلَفْتَ عَلَى يَمِينٍ فَرَأَيْتَ غَيْرَهَا خَيْرًا مِنْهَا فَكَفِّرْ عَنْ يَمِينِكَ وَائْتِ الَّذِي هُوَ خَيْرٌ """"""","","Sunan al-Kubra al-Nasai 4594","","أَخْبَرَنَا أَحْمَدُ بْنُ يَحْيَى قَالَ حَدَّثَنَا أَبُو نُعَيْمٍ قَالَ حَدَّثَنَا هَمَّامُ بْنُ يَحْيَى قَالَ سَأَلَ عَطَاءٌ سُلَيْمَانَ بْنَ مُوسَى قَالَ حَدَّثَ جَابِرٌ","The Book of Oaths and Vows"
"4595","أنبأ إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ : أنبأ عَبْدُ الرَّحْمَنِ ، قَالَ : حدثَنَا شُعْبَةُ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، قَالَ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ عَمْرٍو مَوْلَى الْحَسَنِ بْنِ عَلِيٍّ ، يُحَدِّثُ ، عَنْ عَدِيِّ بْنِ حَاتِمٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ حَلَفَ عَلَى يَمِينٍ فَرَأَى غَيْرَهَا خَيْرًا مِنْهَا فَلْيَأْتِ الَّذِي هُوَ خَيْرٌ وَلْيُكَفِّرْ عَنْ يَمِينِهِ """"""","","Sunan al-Kubra al-Nasai 4595","","أَخْبَرَنَا مُحَمَّدُ بْنُ إِدْرِيسَ قَالَ حَدَّثَنَا أَبُو تَوْبَةَ قَالَ حَدَّثَنَا مُعَاوِيَةُ بْنُ سَلَامٍ عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ عَنْ يَزِيدَ بْنِ نُعَيْمٍ عَنْ جَابِرِ بْنِ عَبْدِ اللهِ","The Book of Oaths and Vows"
"4596","أنبأ هَنَّادُ بْنُ السَّرِيِّ ، عَنْ أَبِي بَكْرِ بْنِ عَيَّاشٍ ، عَنْ عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ ، عَنْ تَمِيمِ بْنِ طَرْفَةَ ، عَنْ عَدِيِّ بْنِ حَاتِمٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ حَلَفَ عَنْ يَمِينٍ فَرَأَى غَيْرَهَا خَيْرًا مِنْهَا ، فَلْيَدَعْ يَمِينَهُ وَلْيَأْتِ الَّذِي هُوَ خَيْرٌ وَلْيُكَفِّرْهَا """"""","","Sunan al-Kubra al-Nasai 4596","","أَخْبَرَنَا الثِّقَةُ قَالَ حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَةَ عَنْ هِشَامِ بْنِ أَبِي عَبْدِ اللهِ عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ عَنْ أَبِي سَلَمَةَ عَنْ جَابِرِ بْنِ عَبْدِ اللهِ","The Book of Oaths and Vows"
"4597","أنبأ عَمْرُو بْنُ يَزِيدَ ، قَالَ : حدثَنَا بَهْزُ بْنُ الأَسْدِ ، قَالَ : حدثَنَا شُعْبَةُ ، قَالَ : أَخْبَرَنِي عَبْدُ الْعَزِيزِ بْنُ رُفَيْعٍ ، قَالَ : سَمِعْتُ تَمِيمَ بْنَ طَرْفَةَ الطَّائِيَّ ، يُحَدِّثُ ، عَنْ عَدِيِّ بْنِ حَاتِمٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَنْ حَلَفَ عَلَى يَمِينٍ فَرَأَى غَيْرَهَا خَيْرًا مِنْهَا ، فَلْيَأْتِ الَّذِي هُوَ خَيْرٌ وَلْيَتْرُكْ يَمِينَهُ """"""","","Sunan al-Kubra al-Nasai 4597","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ عَنْ عُمَرَ بْنِ أَبِي سَلَمَةَ عَنْ أَبِيهِ عَنْ أَبِي هُرَيْرَةَ قَالَ","The Book of Oaths and Vows"
"4598","أنبأ مُحَمَّدُ بْنُ مَنْصُورٍ ، عَنْ سُفْيَانَ قَالَ : حدثَنَا أَبُو الزَّعْرَاءِ ، عَنْ عَمِّهِ أَبِي الأَحْوَصِ ، عَنْ أَبِيهِ ، قَالَ :  قُلْتُ : يَا رَسُولَ اللَّهِ ، أَرَأَيْتَ ابْنَ عَمٍّ لِي آتِيهِ أَسْأَلُهُ ، فَلا يُعْطِينِي وَلا يَصِلُنِي ، ثُمَّ يَحْتَاجُ إِلَيَّ فَيَأْتِينِي فَيَسْأَلُنِي ، وَقَدْ حَلَفْتُ أَنْ لا أُعْطِيَهُ وَلا أَصِلُهُ ،فَأَمَرَنِي أَنْ آتِيَ الَّذِي هُوَ خَيْرٌ وَأُكَفِّرَ عَنْ يَمِينِي """"""","","Sunan al-Kubra al-Nasai 4598","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ الْمُبَارَكِ قَالَ حَدَّثَنَا يَحْيَى وَهُوَ ابْنُ آدَمَ قَالَ حَدَّثَنَا عَبْدُ الرَّحِيمِ وَهُوَ ابْنُ سُلَيْمَانَ عَنْ مُحَمَّدِ بْنِ عَمْرٍو عَنْ أَبِي سَلَمَةَ عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ قَالَ","The Book of Oaths and Vows"
"4599","أَخْبَرَنِي زِيَادُ بْنُ أَيُّوبَ ، قَالَ : حدثَنَا هُشَيْمٌ قَالَ : أنبأ مَنْصُورٌ ، وَيُونُسُ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا آليْتَ عَلَى يَمِينٍ فَرَأَيْتَ غَيْرَهَا خَيْرًا ، فَأْتِ الَّذِي هُوَ خَيْرٌ وَكَفِّرْ عَنْ يَمِينِكَ """"""","","Sunan al-Kubra al-Nasai 4599","","أَخْبَرَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنِي مُحَمَّدُ بْنُ يَزِيدَ بْنِ إِبْرَاهِيمَ قَالَ حَدَّثَنَا عَبْدُ اللهِ بْنُ حُمْرَانَ قَالَ حَدَّثَنَا عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ عَنِ الْأَسْوَدِ بْنِ الْعَلَاءِ عَنْ أَبِي سَلَمَةَ عَنْ رَافِعِ بْنِ خَدِيجٍ","The Book of Oaths and Vows"
"4600","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا يَحْيَى ، قَالَ : حدثَنَا ابْنُ عَوْنٍ ، عَنِ الْحَسَنِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَمُرَةَ ، قَالَ : قَالَ ، يَعْنِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا حَلَفْتَ عَلَى يَمِينٍ ، فَرَأَيْتَ غَيْرَهَا خَيْرًا مِنْهَا ، فَأْتِ الَّذِي هُوَ خَيْرٌ وَكَفِّرْ عَنْ يَمِينِكَ """"""","","Sunan al-Kubra al-Nasai 4600","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا أَبُو عَاصِمٍ قَالَ حَدَّثَنَا عُثْمَانُ بْنُ مُرَّةَ قَالَ سَأَلْتُ الْقَاسِمَ عَنِ الْمُزَارَعَةِ فَحَدَّثَ عَنْ رَافِعِ بْنِ خَدِيجٍ","The Book of Oaths and Vows"
"4601","أَخْبَرَنِي مُحَمَّدُ بْنُ قُدَامَةَ ، عَنْ جَرِيرٍ ، عَنْ مَنْصُورٍ ، عَنِ الْحَسَنِ الْبَصْرِيِّ ، قَالَ : قَالَ عَبْدُ الرَّحْمَنِ بْنُ سَمُرَةَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِذَا حَلَفْتَ عَلَى يَمِينٍ ، فَرَأَيْتَ غَيْرَهَا خَيْرًا مِنْهَا ، فَأْتِ الَّذِي هُوَ خَيْرٌ وَكَفِّرْ عَنْ يَمِينِكَ """"""","","Sunan al-Kubra al-Nasai 4601","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ مَرَّةً أُخْرَى قَالَ حَدَّثَنَا أَبُو عَاصِمٍ عَنْ عُثْمَانَ بْنِ مُرَّةَ قَالَ سَأَلْتُ الْقَاسِمَ عَنْ كِرَاءِ الْأَرْضِ فَقَالَ","The Book of Oaths and Vows"
"4602","أنبأ إِبْرَاهِيمُ بْنُ مُحَمَّدٍ التَّيْمِيُّ ، قَالَ : حدَّثَنَا يَحْيَى ، عَنْ عُبَيْدِ اللَّهِ بْنِ الأَخْنَسِ ، قَالَ : حَدَّثَنِي عَمْرُو بْنُ شُعَيْبٍ ، عَنْ أَبِيهِ ، عَنْ جَدِّهِ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا نَذْرَ ، وَلا يَمِينَ فِيمَا لا يُمْلَكُ ، وَلا فِي مَعْصِيَةِ اللَّهِ وَلا قَطِيعَةِ رَحِمٍ """"""","","Sunan al-Kubra al-Nasai 4602","","حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى قَالَ حَدَّثَنَا يَحْيَى عَنْ أَبِي جَعْفَرٍ الْخَطْمِيِّ وَاسْمُهُ عُمَيْرُ بْنُ يَزِيدَ قَالَ أَرْسَلَنِي عَمِّي وَغُلَامًا لَهُ إِلَى سَعِيدِ بْنِ الْمُسَيِّبِ أَسْأَلُهُ عَنِ الْمُزَارَعَةِ فَقَالَ كَانَ ابْنُ عُمَرَ لَا يَرَى بِهَا بَأْسًا حَتَّى بَلَغَهُ عَنْ رَافِعِ بْنِ خَدِيجٍ حَدِيثٌ فَلَقِيَهُ فَقَالَ","The Book of Oaths and Vows"
"4603","أنبأ أَحْمَدُ بْنُ سَعِيدٍ الْخُرَاسَانِيُّ ، قَالَ : حدَّثَنَا حَبَّانُ ، قَالَ : حدثَنَا عَبْدُ الْوَارِثِ ، قَالَ : حدثَنَا أَيُّوبُ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ حَلَفَ فَاسْتَثْنَى ، فَإِنْ شَاءَ قَضَى ، وَإِنْ شَاءَ تَرَكَ غَيْرَ حَنِثٍ """"""","","Sunan al-Kubra al-Nasai 4603","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ قَالَ حَدَّثَنَا أَبُو الْأَحْوَصِ عَنْ طَارِقٍ عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ عَنْ رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Oaths and Vows"
"4604","أنبأ إِسْحَاقُ بْنُ إِبْرَاهِيمَ ، قَالَ : أنبأ سُلَيْمَانُ بْنُ حَيَّانَ ، قَالَ : حدثَنَا يَحْيَى بْنُ سَعِيدٍ ، عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ ، عَنْ عَلْقَمَةَ بْنِ وَقَّاصٍ اللَّيْثِيِّ ، عَنْ عُمَرَ بْنِ الْخَطَّابِ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : إِنَّمَا الأَعْمَالُ بِالنِّيَّةِ ، وَإِنَّمَا لامْرِئٍ مَا نَوَى ، فَمَنْ كَانَتْ هِجْرَتُهُ إِلَى اللَّهِ وَإِلَى رَسُولِهِ فَهِجْرَتُهُ إِلَى اللَّهِ وَإِلَى رَسُولِهِ ، وَمَنْ كَانَتْ هِجْرَتُهُ لِدُنْيَا يُصِيبُهَا أَوِ امْرَأَةٍ يَتَزَوَّجُهَا فَهِجْرَتُهُ إِلَى مَا هَاجَرَ إِلَيْهِ """"""","","Sunan al-Kubra al-Nasai 4604","","أَخْبَرَنَا أَحْمَدُ بْنُ سُلَيْمَانَ قَالَ حَدَّثَنَا عُبَيْدُ اللهِ قَالَ أَخْبَرَنَا إِسْرَائِيلُ عَنْ طَارِقٍ عَنْ سَعِيدٍ قَالَ","The Book of Oaths and Vows"
"4605","أنبأ الْحَسَنُ بْنُ مُحَمَّدٍ ، قَالَ : حدثَنَا حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ ، زَعَمَ عَطَاءٌ ، أَنَّهُ سَمِعَ عُبَيْدَ بْنَ عُمَيْرٍ ، يَقُولُ : سَمِعْتُ عَائِشَةَ تَزْعُمُ :  أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، كَانَ يَمْكُثُ عِنْدَ زَيْنَبَ بِنْتِ جَحْشٍ ، فَيَشْرَبُ عِنْدَهَا عَسَلا ، فَتَوَاصَيْتُ أَنَا ، وَحَفْصَةُ ، أَنَّ أَيَّتَنَا دَخَلَ عَلَيْهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَلْتَقُلْ إِنِّي أَجِدُ مِنْكَ رِيحَ مَغَافِيرَ أَكَلْتَ مَغَافِيرَ ، فَدَخَلَ عَلَى إِحْدَاهُمَا ، فَقَالَتْ : ذَلِكَ لَهُ ، فَقَالَ :لا بَلْ شَرِبْتُ عَسَلا عِنْدَ زَيْنَبَ بِنْتِ جَحْشٍ ، وَلَنْ أَعُودَ لَهُ ، فَنَزَلَتْ  يَأَيُّهَا النَّبِيُّ لِمَ تُحَرِّمُ مَا أَحَلَّ اللَّهُ لَكَ تَبْتَغِي مَرْضَاتَ أَزْوَاجِكَ ،  إِنْ تَتُوبَا إِلَى اللَّهِ لِعَائِشَةَ وَحَفْصَةَ ،  وَإِذْ أَسَرَّ النَّبِيُّ إِلَى بَعْضِ أَزْوَاجِهِ حَدِيثًا لِقَوْلِهِ : بَلْ شَرِبْتُ عَسَلا """"""","","Sunan al-Kubra al-Nasai 4605","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَلِيٍّ قَالَ حَدَّثَنَا مُحَمَّدٌ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ طَارِقٍ قَالَ سَمِعْتُ سَعِيدَ بْنَ الْمُسَيِّبِ يَقُولُ §لَا يَصْلُحُ مِنَ الزَّرْعِ غَيْرُ ثَلَاثٍ أَرْضٌ يَمْلِكُ رَقَبَتَهَا أَوْ مِنْحَةٌ أَوْ أَرْضٌ بَيْضَاءُ يَسْتَأْجِرُهَا بِذَهَبٍ أَوْ فِضَّةٍ وَرَوَى الزُّهْرِيُّ الْكَلَامَ الْأَوَّلَ","The Book of Oaths and Vows"
"4606","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا يَحْيَى ، قَالَ : حدثَنَا الْمُثَنَّى بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنِي طَلْحَةُ بْنُ نَافِعٍ ، عَنْ جَابِرٍ ، قَالَ :  دَخَلْتُ مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيْتَهُ ، فَإِذَا فَلْقٌ وَخَلٌّ ، قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :كُلْ فَنِعْمَ الأُدْمِ هُوَ """"""","","Sunan al-Kubra al-Nasai 4606","","الْحَارِثُ بْنُ مِسْكِينٍ قِرَاءَةً عَلَيْهِ وَأَنَا أَسْمَعُ عَنِ ابْنِ الْقَاسِمِ قَالَ حَدَّثَنِي مَالِكٌ عَنِ ابْنِ شِهَابٍ عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ","The Book of Oaths and Vows"
"4607","أنبأ عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ الزُّهْرِيُّ الْبَصْرِيُّ ، قَالَ : حدثَنَا سُفْيَانُ ، عَنْ عَبْدِ الْمَلِكِ ، عَنْ أَبِي وَائِلٍ ، عَنْ قَيْسِ بْنِ أَبِي غَرَزَةَ ، قَالَ :  كُنَّا نُسَمَّى السَّمَاسِرَةَ ، فَأَتَانَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ نَبِيعُ ، فَسَمَّانَا بِاسْمٍ هُوَ أَحْسَنُ لَنَا مِنِ اسْمِنَا ، فَقَالَ :يَا مَعْشَرَ التُّجَّارِ إِنَّ هَذَا الْبَيْعَ يَحْضُرُهُ الْحَلِفُ وَالْكَذِبُ ، فَشُوبُوا بَيْعَكُمْ بِصَدَقَةٍ """"""","","Sunan al-Kubra al-Nasai 4607","","أَخْبَرَنَا عُبَيْدُ اللهِ بْنُ سَعْدِ بْنِ إِبْرَاهِيمَ قَالَ حَدَّثَنَا عَمِّي قَالَ حَدَّثَنَا أَبِي عَنْ مُحَمَّدِ بْنِ عِكْرِمَةَ عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ لَبِيبَةَ عَنْ سَعِيدِ بْنِ الْمُسَيِّبِ عَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ قَالَ","The Book of Oaths and Vows"
"4608","أنبأ مُحَمَّدُ بْنُ عَبْدِ اللَّهِ بْنِ يَزِيدَ ، عَنْ سُفْيَانَ ، عَنْ عَبْدِ الْمَلِكِ ، وَعَاصِمٍ ، وَجَامِعٍ ، عَنْ أَبِي وَائِلٍ شَقِيقٍ ، عَنْ قَيْسِ بْنِ أَبِي غَرَزَةَ ، قَالَ :  كُنَّا نَبِيعُ بِالْبَقِيعِ ، فَأَتَانَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَكُنَّا نُسَمَّى السَّمَاسِرَةَ ، فَقَالَ :يَا مَعْشَرَ التُّجَّارِ ، فَسَمَّانَا بِاسْمٍ هُوَ أَحْسَنُ مِنِ اسْمِنَا ، فَقَالَ : إِنَّ هَذَا الْبَيْعَ يَحْضُرُهُ الْخُلْفُ وَالْكَذِبُ ، فَشُوبُوهُ بِصَدَقَةٍ """"""","","Sunan al-Kubra al-Nasai 4608","","أَخْبَرَنَا زِيَادُ بْنُ أَيُّوبَ حَدَّثَنَا ابْنُ عُلَيَّةَ قَالَ حَدَّثَنَا أَيُّوبُ عَنْ يَعْلَى بْنِ حَكِيمٍ عَنْ سُلَيْمَانَ بْنِ يَسَارٍ عَنْ رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Oaths and Vows"
"4609","أنبأ مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حدثَنَا مُحَمَّدٌ ، عَنْ شُعْبَةَ ، عَنْ مُغِيرَةَ ، عَنْ أَبِي وَائِلٍ ، عَنْ قَيْسِ بْنِ أَبِي غَرَزَةَ ، قَالَ :  أَتَانًا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَنَحْنُ فِي السُّوقِ ، فَقَالَ :إِنَّ هَذِهِ السُّوقَ يُخَالِطُهَا اللَّغْوُ وَالْكَذِبُ ، فَشُوبُوهَا بِصَدَقَةٍ """"""","","Sunan al-Kubra al-Nasai 4609","","حَدَّثَنِي زَكَرِيَّا بْنُ يَحْيَى قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ عُبَيْدٍ قَالَ حَدَّثَنَا حَمَّادٌ عَنْ أَيُّوبَ قَالَ كَتَبَ إِلَيَّ يَعْلَى بْنُ حَكِيمٍ إِنِّي سَمِعْتُ سُلَيْمَانَ بْنِ يَسَارٍ يُحَدِّثُ عَنْ رَافِعٍ قَالَ","The Book of Oaths and Vows"
"4610","أنبأ عَلِيُّ بْنُ حُجْرٍ ، قَالَ : أنبأ جَرِيرٌ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي وَائِلٍ ، عَنْ قَيْسِ بْنِ أَبِي غَرَزَةَ ، قَالَ :  كُنَّا بِالْمَدِينَةِ نَبِيعُ الأَوْسَاقَ وَنَبْتَاعُهَا ، وَكُنَّا نُسَمِّي أَنْفُسَنَا السَّمَاسِرَةَ وَيُسَمِّينَاهُ النَّاسُ ، فَخَرَجَ إِلَيْنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ذَاتَ يَوْمٍ فَسَمَّانَا بِاسْمٍ هُوَ خَيْرٌ مِنَ الَّذِي سَمَّيْنَا أَنْفُسَنَا وَسَمَّانَا النَّاسُ ، فَقَالَ :يَا مَعْشَرَ التُّجَّارِ ، إِنَّهُ يَشْهَدُ بَيْعَكُمُ اللَّغْوُ فَشُوبُوهُ بِالصَّدَقَةِ """"""","","Sunan al-Kubra al-Nasai 4610","","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ قَالَ حَدَّثَنَا خَالِدُ بْنُ الْحَارِثِ عَنْ سَعِيدٍ عَنْ يَعْلَى بْنِ حَكِيمٍ عَنْ سُلَيْمَانَ بْنِ يَسَارٍ أَنَّ رَافِعَ بْنَ خَدِيجٍ قَالَ","The Book of Oaths and Vows"
"4611","أَخْبَرَنَا إِسْمَاعِيلُ بْنُ مَسْعُودٍ ، قَالَ : حدثَنَا خالِدٌ ، عَنْ شُعْبَةَ ، قَالَ : أَخْبَرَنِي مَنْصُورٌ ، عَنْ عَبْدِ اللَّهِ بْنِ مُرَّةَ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ،  أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَنَهَى عَنِ النَّذْرِ ، وَقَالَ : إِنَّهُ لا يَأْتِي بِخَيْرٍ إِنَّمَا يُسْتَخْرَجُ بِهِ مِنَ الْبَخِيلِ """"""","","Sunan al-Kubra al-Nasai 4611","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ الْمُبَارَكِ قَالَ حَدَّثَنَا حُجَيْنُ قَالَ حَدَّثَنَا اللَّيْثُ عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ عَنْ حَنْظَلَةَ بْنِ قَيْسٍ عَنْ رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Vows"
"4612","أنبأ عَمْرُو بْنُ مَنْصُورٍ ، قَالَ : حدثَنَا أَبُو نُعَيْمٍ ، قَالَ : ثنا سُفْيَانُ ، عَنْ مَنْصُورٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مُرَّةَ ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ ، قَالَ :  نَهَى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِالنَّذْرِ وَقَالَ : إِنَّهُ لا يَرُدُّ شَيْئًا وَإِنَّمَا يُسْتَخْرَجُ بِهِ مِنَ الشَّحِيحِ """"""","","Sunan al-Kubra al-Nasai 4612","","أَخْبَرَنِي الْمُغِيرَةُ بْنُ عَبْدِ الرَّحْمَنِ قَالَ حَدَّثَنَا عِيسَى بْنُ يُونُسَ قَالَ حَدَّثَنَا الْأَوْزَاعِيُّ عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ عَنْ حَنْظَلَةَ بْنِ قَيْسٍ الْأَنْصَارِيِّ قَالَ سَأَلْتُ رَافِعَ بْنَ خَدِيجٍ عَنْ كِرَاءِ الْأَرْضِ بِالذَّهَبِ أَوِ الْوَرِقِ فَقَالَ","The Book of Vows"
"4613","أنبأ عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا يَحْيَى ، قَالَ : حدثَنَا سُفْيَانُ ، عَنْ مَنْصُورٍ ، عَنْ عَبْدِ اللَّهِ بْنِ مُرَّةَ ، عَنِ ابْنِ عُمَرَ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : النَّذْرُ لا يُقَدِّمُ شَيْئًا وَلا يُؤَخِّرُهُ ، إِنَّمَا هُوَ شَيْءٌ يُسْتَخْرَجُ بِهِ مِنَ الشَّحِيحِ """"""","","Sunan al-Kubra al-Nasai 4613","","أَخْبَرَنَا قُتَيْبَةُ بْنُ سَعِيدٍ عَنْ مَالِكٍ عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ عَنْ حَنْظَلَةَ بْنِ قَيْسٍ أَنَّهُ سَأَلَ رَافِعَ بْنَ خَدِيجٍ عَنْ كِرَاءِ الْأَرْضِ فَقَالَ","The Book of Vows"
"4614","أنبا عَبْدُ اللَّهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ ، قَالَ : حدثَنَا سفْيَانُ ، قَالَ : حدثَنَا أَبُو الزِّنَادَ ، عَنِ الأَعْرَجِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : لا يَأْتِي النَّذْرُ عَلَى ابْنِ آدَمَ شَيْئًا لَمْ يُقَدِّرْهُ عَلَيْهِ ، وَلَكِنَّهُ شَيْءٌ اسْتُخْرِجَ بِهِ مِنَ الْبَخِيلِ """"""","","Sunan al-Kubra al-Nasai 4614","","أَخْبَرَنَا عَمْرُو بْنُ عَلِيٍّ قَالَ حَدَّثَنَا يَحْيَى قَالَ حَدَّثَنَا مَالِكٌ عَنْ رَبِيعَةَ عَنْ حَنْظَلَةَ بْنِ قَيْسٍ قَالَ سَأَلْتُ رَافِعَ بْنَ خَدِيجٍ عَنْ كِرَاءِ الْأَرْضِ فَقَالَ","The Book of Vows"
"4615","أنبا قُتَيْبَةُ بْنُ سَعِيدٍ ، قَالَ : حدثَنَا عَبْدُ الْعَزِيزِ ، عَنِ الْعَلاءِ ، عَنْ أَبِيهِ ، عَنْ أَبِي هُرَيْرَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : لا تُنْذِرُوا ، فَإِنَّ النَّذْرَ لا يُغْنِي مِنَ الْقَدَرِ شَيْئًا ، وَإِنَّمَا يُسْتَخْرَجُ بِهِ مِنَ الْبَخِيلِ """"""","","Sunan al-Kubra al-Nasai 4615","","أَخْبَرَنَا مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ الْمُبَارَكِ عَنْ وَكِيعٍ قَالَ حَدَّثَنَا سُفْيَانُ عَنْ رَبِيعَةَ بْنِ أَبِي عَبْدِ الرَّحْمَنِ عَنْ حَنْظَلَةَ بْنِ قَيْسٍ قَالَ سَأَلْتُ رَافِعَ بْنَ خَدِيجٍ عَنْ كِرَاءِ الْأَرْضِ الْبَيْضَاءِ بِالذَّهَبِ وَالْفِضَّةِ فَقَالَ «§حَلَالٌ لَا بَأْسَ بِهِ ذَلِكَ فَرْضُ الْأَرْضِ» رَوَاهُ يَحْيَى بْنُ سَعِيدٍ عَنْ حَنْظَلَةَ بْنِ قَيْسٍ وَرَفَعَهُ كَمَا رَوَاهُ مَالِكٌ","The Book of Vows"
"4616","أنبا قُتَيْبَةُ بْنُ سَعِيدٍ ، عَنْ مَالِكٍ ، عَنْ طَلْحَةَ بْنِ عَبْدِ الْمَلِكِ ثِقَةٌ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَةَ ، أَنّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ نَذَرَ أَنْ يُطِيعَ اللَّهَ فَلْيُطِعْهُ ، وَمَنْ نَذَرَ أَنْ يَعْصِيَ اللَّهَ فَلا يَعْصِهِ """"""","","Sunan al-Kubra al-Nasai 4616","","أَخْبَرَنَا يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ فِي حَدِيثِهِ عَنْ حَمَّادِ بْنِ زَيْدٍ عَنْ يَحْيَى عَنْ حَنْظَلَةَ بْنِ قَيْسٍ عَنْ رَافِعِ بْنِ خَدِيجٍ قَالَ","The Book of Vows"
"4617","أنبا عَمْرُو بْنُ عَلِيٍّ ، قَالَ : حدثَنَا يَحْيَى ، قَالَ : حدثَنَا مَالِكٌ ، قَالَ : حَدَّثَنِي طَلْحَةُ بْنُ عَبْدِ الْمَلِكِ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَةَ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنْ نَذَرَ أَنْ يُطِيعَ اللَّهَ فَلْيُطِعْهُ ، وَمَنْ نَذَرَ أَنْ يَعْصِيَ اللَّهَ فَلا يَعْصِهِ """"""","","Sunan al-Kubra al-Nasai 4617","","أَخْبَرَنِي مُحَمَّدُ بْنُ يَحْيَى بْنِ عَبْدِ اللهِ قَالَ حَدَّثَنَا عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَسْمَاءَ عَنْ جُوَيْرِيَةَ عَنْ مَالِكٍ عَنِ الزُّهْرِيِّ أَنَّ سَالِمِ بْنِ عَبْدِ اللهِ أَخْبَرَهُ وَسَأَلَهُ عَنْ كِرَاءِ الْمَزَارِعِ فَقَالَ أَخْبَرَ رَافِعُ بْنُ خَدِيجٍ أَنَّ عَمَّيْهِ وَكَانَا قَدْ شَهِدَا بَدْرًا أَخْبَرَاهُ","The Book of Vows"
"4618","أنبا مُحَمَّدُ بْنُ الْعَلاءِ الْكُوفِيُّ ، قَالَ : حدثَنَا ابْنُ إِدْرِيسَ ، عَنْ عُبَيْدِ اللَّهِ هُوَ ابْنُ عُمَرَ بْنِ حَفْصِ بْنِ عَاصِمِ بْنِ عُمَرَ بْنِ الْخَطَّابِ ، عَنْ طَلْحَةَ بْنِ عَبْدِ الْمَلِكِ ، عَنِ الْقَاسِمِ ، عَنْ عَائِشَةَ ، قَالَتْ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، يَقُولُ : مَنْ نَذَرَ أَنْ يُطِيعَ اللَّهَ فَلْيُطِعْهُ ، وَمَنْ نَذَرَ أَنْ يَعْصِيَ اللَّهَ فَلا يَعْصِهِ "". قَالَ أَبُو عَبْدِ الرَّحْمَنِ : طَلْحَةَ بْنِ عَبْدِ الْمَلِكِ ، ثِقَةٌ ثِقَةٌ ثِقَةٌ""","","Sunan al-Kubra al-Nasai 4618","","أَخْبَرَنَا عَبْدُ الْمَلِكِ بْنِ شُعَيْبِ بْنِ اللَّيْثِ بْنِ سَعْدٍ قَالَ حَدَّثَنِي أَبِي عَنْ جَدِّي قَالَ حَدَّثَنِي عُقَيْلٌ عَنِ ابْنِ شِهَابٍ قَالَ أَخْبَرَنِي سَالِمُ بْنُ عَبْدِ اللهِ أَنَّ عَبْدَ اللهِ بْنَ عُمَرَ كَانَ يُكْرِي أَرْضَهُ حَتَّى بَلَغَهُ أَنَّ رَافِعَ بْنَ خَدِيجٍ كَانَ يَنْهَى عَنْ كِرَاءِ الْأَرْضِ فَلَقِيَهُ عَبْدُ اللهِ فَقَالَ يَا ابْنَ خَدِيجٍ مَاذَا تُحَدِّثُ","The Book of Vows"
"4619","أنبا مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حدثَنَا خَالِدٌ ، قَالَ : حدثَنَا شُعْبَةُ ، عَنْ أَبِي حَمْزَةَ وَاسْمُهُ نَصْرُ بْنُ عِمْرَانَ ، عَنْ زَهْدَمٍ ، قَالَ : سَمِعْتُ عِمْرَانَ بْنَ حُصَيْنٍ ، يَذْكُرُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : خَيْرُكُمْ قَرْنِي ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ ""، فَلا أَدْرِي ذَكَرَ قَرْنَيْنِ بَعْدُ أَوْ ثَلاثَةً ، ثُمَّ ذَكَرَ قَوْمًا يَخُونُونَ وَلا يَؤْتَمَنُونَ ، وَيَشهَدُونَ وَلا يُسْتَشْهَدُونَ ، وَيَنْذِرُونَ وَلا يُوفُونَ ، وَيَظْهَرُ فِيهِمُ السِّمَنُ""","","Sunan al-Kubra al-Nasai 4619","","أَخْبَرَنَا مُحَمَّدُ بْنُ خَالِدِ بْنِ خَلِيٍّ قَالَ حَدَّثَنَا بِشْرُ بْنُ شُعَيْبٍ عَنْ أَبِيهِ عَنِ الزُّهْرِيِّ قَالَ بَلَغَنَا أَنَّ رَافِعَ بْنَ خَدِيجٍ كَانَ يُحَدِّثُ أَنَّهُ سَمِعَ عَمَّيْهِ وَكَانَا زَعَمَ شَهِدَا بَدْرًا","The Book of Vows"
"4620","أنبأ مُحَمَّدُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حدثَنَا خالِدٌ ، قَالَ : حدثَنَا ابْنُ جُرَيْجٍ ، قَالَ : حدثَنَا سُلَيْمَانُ الأَحْوَلُ ، عَنْ طَاوُسٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : مَرَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِرَجُلٍ يَقُودُ رَجُلا فِي قَرَنٍ ، فَتَنَاوَلَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَطَعَهُ قَالَ : إِنَّهُ نَذَرَهُ """"""","","Sunan al-Kubra al-Nasai 4620","","أَخْبَرَنَا أَحْمَدُ بْنُ مُحَمَّدِ بْنِ الْمُغِيرَةِ قَالَ حَدَّثَنَا عُثْمَانُ عَنْ شُعَيْبٍ قَالَ قَالَ الزُّهْرِيُّ كَانَ ابْنُ الْمُسَيَّبِ يَقُولُ §لَيْسَ بِاسْتِكْرَاءِ الْأَرْضِ بِالذَّهَبِ وَالْوَرِقِ بَأْسٌ وَكَانَ رَافِعٌ يُحَدِّثُ","The Book of Vows"
