hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"4201","4195  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ : شَيْبَانُ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِبْرَاهِيمَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنِ  الْعِرْبَاضِ بْنِ سَارِيَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَسْتَغْفِرُ لِلصَّفِّ الْأَوَّلِ ثَلَاثَ مَرَّاتٍ  وَلِلثَّانِي مَرَّةً  .         [10/133]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِهَذَا اللَّفْظِ إِلَّا عَنِ  الْعِرْبَاضِ بْنِ سَارِيَةَ  ، وَكُلُّ مَنْ رَوَاهُ عَنْ  يَحْيَى  فَإِنَّمَا يَقُولُ : عَنْ  خَالِدِ بْنِ مَعْدَانَ  عَنِ  الْعِرْبَاضِ  إِلَّا  شَيْبَانُ  ، فَإِنَّهُ قَالَ : عَنْ  خَالِدٍ  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ  ،  فَوَصَلَهُ  .","","Musnad al-Bazzar 4195","","عرباض بن سارية عن جبير بن نفير بن مالك الحضرمي عن خالد بن معدان عن محمد بن إبراهيم بن الحارث التيمي عن يحيى بن أبي كثير عن شيبان بن عبد الرحمن المؤدب عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","مسند العرباض بن سارية رضي الله عنه"
"4202","4196  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو عَاصِمٍ ، قَالَ :  نَا  وَهْبُ بْنُ خَالِدٍ ، قَالَ :  حَدَّثَتْنِي  أُمُّ حَبِيبٍ بِنْتُ الْعِرْبَاضِ ،  عَنْ  أَبِيهَا  - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَهَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تُوطَأَ السَّبَايَا  حَتَّى يَضَعْنَ مَا فِي بُطُونِهِنَّ  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ نَحْوُ كَلَامِهِ مِنْ وُجُوهٍ ، وَذَكَرْنَا هَذَا الْحَدِيثَ عَنِ  الْعِرْبَاضِ  إِلَّا أَنْ يَزِيدَ فِيهِ رَجُلًا أَوْ يُغَيِّرَ فِيهِ لَفْظًا ، فَيُذْكَرُ مِنْ أَجْلِ الزِّيَادَةِ فِيهِ  .","","Musnad al-Bazzar 4196","","عرباض بن سارية عن أم حبيبة بنت العرباض بن سارية عن وهب بن خالد الحميري عن أبو عاصم النبيل عن الفلاس عن البزار","مسند العرباض بن سارية رضي الله عنه"
"4203","4197  -  حَدَّثَنَا  عَمْرٌو ، قَالَ :  نَا  أَبُو عَاصِمٍ ، قَالَ :  نَا  وَهْبُ بْنُ خَالِدٍ ، قَالَ :  حَدَّثَتْنَا  أُمُّ حَبِيبَةَ بِنْتُ الْعِرْبَاضِ ،  عَنِ  الْعِرْبَاضِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ         [10/134]      رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى  يَوْمَ خَيْبَرَ  عَنْ كُلِّ ذِي نَابٍ مِنَ  السِّبَاعِ  ،  وَعَنْ كُلِّ ذِي مِخْلَبٍ مِنَ الطَّيْرِ ، وَعَنْ لُحُومِ الْحُمُرِ  الْأَهْلِيَّةِ  ، وَعَنِ  الْمُجَثَّمَةِ  وَالْخُلْسَةِ  .","","Musnad al-Bazzar 4197","","عرباض بن سارية عن أم حبيبة بنت العرباض بن سارية عن وهب بن خالد الحميري عن أبو عاصم النبيل عن عمرو بن يزيد الجرمي عن البزار","مسند العرباض بن سارية رضي الله عنه"
"4204","4197  (م)  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْخُذُ الْوَبَرَةَ مِنَ الْفَيْءِ فَيَقُولُ :  مَا لِي مِنْهُ مِثْلُ هَذِهِ إِلَّا مَا لِأَحَدِكُمْ إِلَّا الْخُمُسُ وَهُوَ مَرْدُودٌ فِيكُمْ  ، فَرُدُّوا الْخَيْطَ وَالْمِخْيَطَ فَمَا فَوْقَهَا ، وَإِيَّاكُمْ وَالْغُلُولَ ! فَإِنَّهُ عَارٌ وَنَارٌ  وَشَنَارٌ  عَلَى صَاحِبِهِ يَوْمَ الْقِيَامَةِ  .","","Musnad al-Bazzar 4197","","عرباض بن سارية عن أم حبيبة بنت العرباض بن سارية عن وهب بن خالد الحميري عن أبو عاصم النبيل عن الفلاس عن البزار","مسند العرباض بن سارية رضي الله عنه"
"4205","4198  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مَهْدِيٍّ ، قَالَ :  نَا  عَبْدُ الْقُدُّوسِ بْنُ الْحَجَّاجِ ،  عَنْ  أَبِي بَكْرِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  حَبِيبِ بْنِ عُبَيْدٍ ،  عَنِ  الْعِرْبَاضِ بْنِ سَارِيَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيمَا يَرْوِيهِ : ""  إِذَا أَخَذْتُ مِنْ عَبْدِي  كَرِيمَتَيْهِ  وَهُوَ بِهِمَا ضَنِينٌ لَمْ أَرْضَ لَهُ بِهِمَا         [10/135]      ثَوَابًا دُونَ الْجَنَّةِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ  الْعِرْبَاضِ  بِأَحْسَنَ إِسْنَادًا  مِنْ هَذَا  الْإِسْنَادِ  ، وَقَدْ رُوِيَ نَحْوُ كَلَامِهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِغَيْرِ هَذَا اللَّفْظِ ، فَذَكَرْنَا كُلَّ حَدِيثٍ بِلَفْظِهِ فِي مَوْضِعِهِ  .","","Musnad al-Bazzar 4198","","عرباض بن سارية عن حبيب بن عبيد الرحبي عن أبو بكر الغساني عن عبد القدوس بن الحجاج عن الحسين بن مهدي الأبلي عن البزار","مسند العرباض بن سارية رضي الله عنه"
"4206","4199  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مَهْدِيٍّ ، قَالَ :  نَا  أَبُو الْمُغِيرَةِ عَبْدُ الْقُدُّوسِ بْنُ الْحَجَّاجِ ، قَالَ :  نَا  أَبُو بَكْرِ بْنُ أَبِي مَرْيَمَ ،  عَنْ  سَعِيدِ بْنِ سُوَيْدٍ ،  عَنِ  الْعِرْبَاضِ بْنِ سَارِيَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنِّي عِنْدَ اللهِ لَخَاتَمُ النَّبِيِّينَ وَإِنَّ  آدَمَ  لَمُنْجَدِلٌ  فِي طِينَتِهِ  ، وَسَأُنَبِّئُكُمْ بِتَأْوِيلِ ذَلِكَ :  دَعْوَةُ  أَبِي  إِبْرَاهِيمَ  ، وَبِشَارَةُ  عِيسَى  ، وَرُؤْيَا أُمِّي الَّتِي رَأَتْ كَأَنَّهُ خَرَجَ مِنْهَا نُورٌ أَضَاءَتْ لَهُ قُصُورُ  الشَّامِ  ، وَكَذَلِكَ أُمَّهَاتُ         [10/136]      الْمُؤْمِنِينَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِإِسْنَادٍ مُتَّصِلٍ  عَنْهُ بِأَحْسَنَ مِنْ هَذَا  الْإِسْنَادِ  ،  وَسَعِيدُ بْنُ سُوَيْدٍ  رَجُلٌ مِنْ  أَهْلِ الشَّامِ  لَيْسَ بِهِ بَأْسٌ  ،  وَأَبُو بَكْرِ بْنُ أَبِي مَرْيَمَ  قَدْ تَقَدَّمَ ذِكْرُنَا لَهُ فِي غَيْرِ هَذَا الْحَدِيثِ  .","","Musnad al-Bazzar 4199","","عرباض بن سارية عن سعيد بن سويد الكلبي عن أبو بكر الغساني عن عبد القدوس بن الحجاج عن الحسين بن مهدي الأبلي عن البزار","مسند العرباض بن سارية رضي الله عنه"
"4207","4200  -  حَدَّثَنَا  بِشْرُ بْنُ آدَمَ ، قَالَ :  نَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  نَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  سَعِيدِ بْنِ هَانِئٍ ،  عَنِ  الْعِرْبَاضِ بْنِ سَارِيَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  بِعْتُ مِنَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بَكْرًا  ، فَأَتَيْتُهُ أَتَقَاضَاهُ ، فَقُلْتُ : أَقْضِنِي ثَمَنَ بَكْرِي ، فَقَالَ :  لَا أَقْضِيكَ إِلَّا لُجَيْنَةً  فَقَضَانِي فَأَحْسَنَ قَضَائِي  .         [10/137]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ غَيْرِ هَذَا الْوَجْهِ ،  وَإِسْنَادُهُ حَسَنٌ  .","","Musnad al-Bazzar 4200","","عرباض بن سارية عن سعيد بن هانئ الخولاني عن معاوية بن صالح بن حدير الحضرمي عن زيد بن الحباب العكلي عن بشر بن آدم بن يزيد عن البزار","مسند العرباض بن سارية رضي الله عنه"
"4208","4201  -  حَدَّثَنَا  زِيَادُ بْنُ يَحْيَى الْحَسَّانِيُّ ، قَالَ :  حَدَّثَنِي  الْوَلِيدُ بْنُ مُسْلِمٍ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ الْعَلَاءِ بْنِ زَبْرٍ ، قَالَ :  سَمِعْتُ  يَحْيَى بْنَ أَبِي الْمُطَاعِ  يُحَدِّثُ عَنِ  الْعِرْبَاضِ بْنِ سَارِيَةَ السُّلَمِيِّ - رَضِيَ اللهُ عَنْهُ - قَالَ  قَامَ فِينَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَاتَ غَدَاةٍ ، فَوَعَظَنَا مَوْعِظَةً  وَجِلَتْ  مِنْهَا الْقُلُوبُ ،  وَذَرَفَتْ  مِنْهَا الْأَعْيُنُ ، فَقُلْنَا : يَا رَسُولَ اللهِ ، إِنَّكَ وَعَظْتَنَا مَوْعِظَةَ مُوَدِّعٍ فَاعْهَدْ إِلَيْنَا ، قَالَ :  عَلَيْكُمْ بِتَقْوَى اللهِ وَالسَّمْعِ وَالطَّاعَةِ وَلَوْ عَبْدٌ حَبَشِيٌّ  ، فَسَتَرَوْنَ بَعْدِي اخْتِلَافًا شَدِيدًا ، فَعَلَيْكُمْ بِسُنَّتِي وَسُنَّةِ الْخُلَفَاءِ الرَّاشِدِينَ  الْمَهْدِيِّينَ  بَعْدِي ،  وَعَضُّوا  عَلَيْهَا  بِالنَّوَاجِذِ ،  وَإِيَّاكُمْ  وَالْمُحْدَثَاتِ  ؛ فَإِنَّ كُلَّ بِدْعَةٍ ضَلَالَةٌ  .         [10/138]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِهَذَا اللَّفْظِ إِلَّا عَنِ  الْعِرْبَاضِ بْنِ سَارِيَةَ  ، وَقَدْ رُوِيَ عَنِ  الْعِرْبَاضِ  مِنْ غَيْرِ وَجْهٍ ، فَذَكَرْنَا هَذَا الطَّرِيقَ مِنْهُ وَاقْتَصَرْنَا عَلَى هَذَا  الْإِسْنَادِ  دُونَ غَيْرِهِ  .","","Musnad al-Bazzar 4201","","عرباض بن سارية عن يحيى بن أبي المطاع الأردني عن عبد الله بن العلاء بن زبر عن الوليد بن مسلم القرشي عن زياد بن يحيى الحساني عن البزار","مسند العرباض بن سارية رضي الله عنه"
"4209","4202  -  وَقَدْ  حَدَّثَنَاهُ  وَهْبُ بْنُ يَحْيَى بْنِ زِمَامٍ الْقَيْسِيُّ ، قَالَ :  نَا  قُرَّةُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  يُونُسَ بْنِ يُوسُفَ ،  عَنِ  الْحَارِثِ بْنِ زِيَادٍ ،  عَنْ  أَبِي رُهْمٍ ،  عَنِ  الْعِرْبَاضِ بْنِ سَارِيَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  اللَّهُمَّ عَلِّمْ  مُعَاوِيَةَ  الْكِتَابَ وَالْحِسَابَ ، وَقِهِ الْعَذَابَ  ، قَالَ : وَدَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَتَسَحَّرُ ، فَقَالَ : "" هَلُمَّ إِلَى  الْغَدَاءِ  الْمُبَارَكِ  .         [10/139]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ  الْعِرْبَاضِ بْنِ سَارِيَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  ،  وَحَدِيثُ  الْعِرْبَاضِ  فِيهِ عِلَّتَانِ ، إِحْدَاهُمَا أَنَّ  الْحَارِثَ بْنَ زِيَادٍ  لَا نَعْلَمُ كَبِيرَ أَحَدٍ رَوَى عَنْهُ ،  وَيُونُسُ بْنُ سَيْفٍ  صَالِحُ الْحَدِيثِ  قَدْ رَوَى عَنْهُ  .","","Musnad al-Bazzar 4202","","عرباض بن سارية عن أحزاب بن أسيد السماعي عن الحارث بن زياد الشامي عن يونس بن سيف الكلاعي عن معاوية بن صالح بن حدير الحضرمي عن قرة بن سليمان الجهضمي عن وهب بن يحيى بن زمام العلاف عن البزار","مسند العرباض بن سارية رضي الله عنه"
"4210","4203  -  حَدَّثَنَا  عُمَرُ بْنُ الْخَطَّابِ ، قَالَ :  نَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الْحِمْصِيُّ ، قَالَ :  نَا  عَمْرُو بْنُ الْحَارِثِ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ سَالِمٍ ،  عَنِ  الزُّبَيْرِ  ، قَالَ :  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ أَبِي عَوْفٍ أَنَّ سُوَيْدَ بْنَ جَبَلَةَ  حَدَّثَهُ  أَنَّ الْعِرْبَاضَ بْنَ سَارِيَةَ - رَضِيَ اللهُ عَنْهُ -  حَدَّثَهُمْ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِذَا سَأَلْتُمُ اللهَ فَاسْأَلُوهُ الْفِرْدَوْسَ  ، فَإِنَّهُ أَعْلَى الْجَنَّةِ  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ نَحْوُ كَلَامِهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ غَيْرِ وَجْهٍ ، وَلَا نَعْلَمُ يُرْوَى عَنِ  الْعِرْبَاضِ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .         [10/140]      كذا في طبعة مكتبة العلوم والحكم ، والصواب : ( الزبيدي ) ، كما جاء في المعجم الكبير.","","Musnad al-Bazzar 4203","","عرباض بن سارية عن سويد بن جبلة الفزاري عن عبد الرحمن بن أبي عوف الجرشي عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عمرو بن الحارث الزبيدي عن إسحاق بن إبراهيم بن العلاء عن عمر بن الخطاب السجستاني عن البزار","مسند العرباض بن سارية رضي الله عنه"
"4211","[10/141]      مُسْنَدُ  أَبِي جُحَيْفَةَ  رَضِيَ اللهُ عَنْهُ         [10/142]             [10/143]      مَا  أَسْنَدَ  أَبُو جُحَيْفَةَ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  4204  -  أَخْبَرَنَا  مُحَمَّدُ بْنُ أَيُّوبَ الرَّقِّيُّ ، قَالَ :  نَا  أَحْمَدُ بْنُ عَمْرِو بْنِ عَبْدِ الْخَالِقِ ، قَالَ :  نَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  نَا  إِسْمَاعِيلُ - يَعْنِي - ابْنَ أَبِي خَالِدٍ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ  الْحَسَنُ بْنُ عَلِيٍّ  يُشْبِهُهُ  .","","Musnad al-Bazzar 4204","","وهب بن عبد الله السوائي عن إسماعيل بن أبي خالد عن يحيى القطان عن الفلاس عن البزار عن محمد بن أيوب بن حبيب الصموت","مسند أبي جحيفة رضي الله عنه"
"4212","4205  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ، قَالَ :  نَا  إِسْمَاعِيلُ - يَعْنِي - ابْنَ أَبِي خَالِدٍ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ  الْحَسَنُ بْنُ عَلِيٍّ  يُشْبِهُهُ  ، قَالَ : وَقَسَمَ فِينَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اثْنَا عَشَرَ بَعِيرًا ، فَأَصَابَ أَبِي بَعِيرًا فَقُبِضَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَمْ يُعْطِينَا ، فَأَتَيْنَا  أَبَا بَكْرٍ  فَأَعْطَانَا  .","","Musnad al-Bazzar 4205","","وهب بن عبد الله السوائي عن إسماعيل بن أبي خالد عن محمد بن فضيل بن غزوان عن الفلاس عن البزار","مسند أبي جحيفة رضي الله عنه"
"4213","4206  -  حَدَّثَنَا  أَحْمَدُ بْنُ أَبَانَ ، قَالَ :  نَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ، قَالَ :  نَا  صَالِحُ بْنُ مَسْعُودٍ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  أَتَيْتُ النَّبِيَّ         [10/144]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَسَمَ فِينَا إِبِلًا  ..  ثُمَّ ذَكَرَ نَحْوَ حَدِيثِ  ابْنِ فُضَيْلٍ  . وَحَدِيثُ  ابْنِ فُضَيْلٍ  عَنْ  إِسْمَاعِيلَ  لَا نَعْلَمُ حَدَّثَ بِهِ عَنْ  إِسْمَاعِيلَ  غَيْرُهُ  .","","Musnad al-Bazzar 4206","","وهب بن عبد الله السوائي عن صالح بن مسعود الجدلي عن مروان بن معاوية الفزاري عن أحمد بن أبان القرشي عن البزار","مسند أبي جحيفة رضي الله عنه"
"4214","4207  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ  عَنِ  الْحَكَمِ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِالْهَاجِرَةِ فَصَلَّى الظُّهْرَ رَكْعَتَيْنِ ،  وَالْعَصْرَ رَكْعَتَيْنِ ، وَبَيْنَ يَدَيْهِ  عَنَزَةٌ  .","","Musnad al-Bazzar 4207","","وهب بن عبد الله السوائي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند أبي جحيفة رضي الله عنه"
"4215","[10/145]      4208  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  الْفَضْلُ بْنُ دُكَيْنٍ ، قَالَ :  نَا  أَبُو إِسْرَائِيلَ  عَنِ  الْحَكَمِ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  دَهَمَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَاسٌ مِنْ  قَيْسٍ  مُجْتَابِي  النِّمَارِ  ، مُتَقَلِّدِينَ السُّيُوفَ ،  فَسَاءَهُ مَا رَأَى مِنْ هَيْئَتِهِمْ فَصَلَّى ، ثُمَّ دَخَلَ بَيْتَهُ ، ثُمَّ خَرَجَ فَصَلَّى وَجَلَسَ فِي مَجْلِسِهِ ، فَأَمَرَ بِالصَّدَقَةِ أَوْ حَضَّ عَلَيْهَا ، فَقَالَ : ""  تَصَدَّقَ  رَجُلٌ مِنْ دِينَارِهِ ،  تَصَدَّقَ  رَجُلٌ مِنْ دِرْهَمِهِ ،  تَصَدَّقَ  رَجُلٌ مِنْ صَاعِ بُرِّهِ ،  تَصَدَّقَ  رَجُلٌ مِنْ صَاعِ تَمْرِهِ "" فَجَاءَ  رَجُلٌ مِنَ الْأَنْصَارِ  بِصُرَّةٍ مِنْ ذَهَبٍ فَوَضَعَهَا فِي يَدِهِ ، ثُمَّ تَتَابَعَ النَّاسُ حَتَّى رَأَى  كَوْمَيْنِ  مِنْ ثِيَابٍ وَطَعَامٍ ، فَرَأَيْتُ وَجْهَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَهَلَّلُ كَأَنَّهُ  مُذْهَبَةٌ ،  ثُمَّ قَالَ عِنْدَ ذَلِكَ : "" مَنْ سَنَّ سُنَّةً حَسَنَةً عُمِلَ بِهَا بَعْدَهُ كَانَ لَهُ أَجْرُهَا وَمِثْلُ أُجُورِهِمْ مِنْ غَيْرِ أَنْ يَنْتَقِصَ مِنْ أُجُورِهِمْ شَيْئًا ، وَمَنْ سَنَّ سُنَّةً سَيِّئَةً عُمِلَ بِهَا بَعْدَهُ كَانَ عَلَيْهِ وِزْرُهَا وَمِثْلُ أَوْزَارِهِمْ مِنْ غَيْرِ أَنْ يَنْتَقِصَ مِنْ أَوْزَارِهِمْ شَيْئًا  .         [10/146]      قَالَ أَبُو بَكْرٍ :  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  أَبِي جُحَيْفَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  وَأَبُو إِسْرَائِيلَ  لَيِّنُ الْحَدِيثِ  ، وَقَدْ رَوَى عَنْهُ  سُفْيَانُ الثَّوْرِيُّ  وَجَمَاعَةٌ كَثِيرَةٌ وَاحْتَمَلُوا حَدِيثَهُ  .","","Musnad al-Bazzar 4208","","وهب بن عبد الله السوائي عن الحكم بن عتيبة الكندي عن إسماعيل بن خليفة الملائي عن الفضل بن دكين عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي جحيفة رضي الله عنه"
"4216","4209  -  حَدَّثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ، قَالَ :  نَا  أَبُو بَكْرٍ الْحَنَفِيُّ عَبْدُ الْكَبِيرِ بْنُ عَبْدِ الْمَجِيدِ ، قَالَ :  نَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى  بِالْأَبْطَحِ  الْعَصْرَ رَكْعَتَيْنِ  .","","Musnad al-Bazzar 4209","","وهب بن عبد الله السوائي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن عبد الكبير بن عبد المجيد الحنفي عن الجراح بن مخلد عن البزار","مسند أبي جحيفة رضي الله عنه"
"4217","4210  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  زُهَيْرٌ - يَعْنِي - ابْنَ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَيْتُ  عَنْفَقَتَهُ  بَيْضَاءَ  . فَقِيلَ لَهُ : مِثْلُ مَنْ أَنْتَ يَوْمَئِذٍ ؟ قَالَ :  أَبْرِي  النَّبْلَ  وَأَرِيشُهَا  .         [10/147]      وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ جَمَاعَةٌ عَنْ  أَبِي إِسْحَاقَ  عَنْ  أَبِي جُحَيْفَةَ  .","","Musnad al-Bazzar 4210","","وهب بن عبد الله السوائي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن أبو داود الطيالسي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي جحيفة رضي الله عنه"
"4218","4211  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ :  نَا  جَرِيرٌ ،  عَنْ  مَنْصُورٍ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِي جُحَيْفَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4211","","وهب بن عبد الله السوائي عن علي بن الأقمر عن منصور بن المعتمر عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","مسند أبي جحيفة رضي الله عنه"
"4219","4212  -  وَحَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ الْعَمِّيُّ ، قَالَ :  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ ، قَالَ :  نَا  شُعْبَةُ  عَنْ  سُفْيَانَ الثَّوْرِيِّ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِي جُحَيْفَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4212","","وهب بن عبد الله السوائي عن علي بن الأقمر عن سفيان الثوري عن شعبة بن الحجاج عن يعقوب بن إسحاق بن زيد الحضرمي عن عقبة بن مكرم عن البزار","مسند أبي جحيفة رضي الله عنه"
"4220","4213  -  وَحَدَّثَنَا  طَالُوتُ بْنُ عَبَّادٍ ، قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  رَقَبَةَ بْنِ مَصْقَلَةَ ،  عَنْ  عَلِيِّ بْنِ الْأَرْقَمِ  ،  عَنْ  أَبِي جُحَيْفَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : ( بن الأقمر )","","Musnad al-Bazzar 4213","","وهب بن عبد الله السوائي عن علي بن الأقمر عن رقبة بن مصقلة عن الوضاح بن عبد الله اليشكري عن طالوت بن عباد الجحدري عن البزار","مسند أبي جحيفة رضي الله عنه"
"4221","4214  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  الْفَضْلُ بْنُ دُكَيْنٍ ، قَالَ :  نَا  مِسْعَرٌ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ ، قَالَ : ""  أَمَّا أَنَا فَلَا آكُلُ  مُتَّكِئًا  .","","Musnad al-Bazzar 4214","","وهب بن عبد الله السوائي عن علي بن الأقمر عن مسعر بن كدام عن الفضل بن دكين عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي جحيفة رضي الله عنه"
"4222","[10/148]      4215  -  حَدَّثَنَا  عُمَرُ بْنُ الْخَطَّابِ السِّجِسْتَانِيُّ ، قَالَ :  نَا  أَبُو نُعَيْمٍ النَّخَعِيُّ ، قَالَ :  نَا  أَبُو مَالِكٍ النَّخَعِيُّ ،  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَرَّ بِرَجُلٍ يُصَلِّي سَادِلًا ثَوْبَهُ  فَقَطَعَهُ عَلَيْهِ  .         [10/149]      وَهَذَا الْحَدِيثُ أَخْطَأَ فِيهِ  أَبُو مَالِكٍ  ، وَإِنَّمَا يَرْوِيهِ  الثِّقَاتُ  عَنْ  عَلِيِّ بْنِ الْأَقْمَرِ  عَنْ  أُمِّ عَطِيَّةَ  ،  وَأَبُو مَالِكٍ  لَيْسَ بِالْحَافِظِ  ، وَإِنَّمَا يُكْتَبُ مِنْ حَدِيثِهِ مَا يَنْفَرِدُ بِهِ  .","","Musnad al-Bazzar 4215","","وهب بن عبد الله السوائي عن علي بن الأقمر عن ابن ذر ، عبد الملك بن الحسين النخعي عن عبد الرحمن بن هانئ الحارثي عن عمر بن الخطاب السجستاني عن البزار","مسند أبي جحيفة رضي الله عنه"
"4223","4216  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ :  نَا  أَبُو أُسَامَةَ ، قَالَ :  نَا  زَائِدَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى  بِالْبَطْحَاءِ  بِمَكَّةَ  صَلَاةَ الْمُسَافِرِ رَكْعَتَيْنِ  .","","Musnad al-Bazzar 4216","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن سماك بن حرب البكري عن زائدة بن قدامة عن حماد بن أسامة القرشي عن إبراهيم بن سعيد الجوهري عن البزار","مسند أبي جحيفة رضي الله عنه"
"4224","4217  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ  بِالْأَبْطَحِ  فِي  قُبَّةٍ  مِنْ أَدَمٍ حَمْرَاءَ ، فَخَرَجَ عَلَيْنَا  بِلَالٌ  بِفَضْلِ وَضُوئِهِ  ، فَقُمْنَا إِلَيْهِ  فَأَخَذْنَا مِنْ وَضُوئِهِ أَوْ مِنْ فَضْلِ         [10/150]      وَضُوئِهِ  ، ثُمَّ أَذَّنَ  بِلَالٌ  فَجَعَلَ يُتْبِعُ فَاهُ هَاهُنَا وَهَاهُنَا يَمِينًا وَشِمَالًا  .","","Musnad al-Bazzar 4217","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي جحيفة رضي الله عنه"
"4225","4218  -  وَحَدَّثَنَا  أَبُو كُرَيْبٍ ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ  عَنِ  الْحَجَّاجِ - يَعْنِي - ابْنَ أَرْطَاةَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ  كُنْتُ مَعَ النَّبِيِّ - عَلَيْهِ السَّلَامُ -  بِالْأَبْطَحِ  فَصَلَّيْتُ مَعَهُ الظُّهْرَ وَالْعَصْرَ رَكْعَتَيْنِ رَكْعَتَيْنِ  ، وَأَذَّنَ  بِلَالٌ  فَجَعَلَ أُصْبُعَيْهِ فِي أُذُنَيْهِ وَكَانَ يَدُورُ فِي أَذَانِهِ  .","","Musnad al-Bazzar 4218","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن حجاج بن أرطاة عن أبو معاوية الضرير عن أبو كريب محمد بن العلاء عن البزار","مسند أبي جحيفة رضي الله عنه"
"4226","[10/151]      4219  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو الْوَلِيدِ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ، قَالَ :  سَمِعْتُ  أَبِي  يُحَدِّثُ  أَنَّ النَّبِيَّ - عَلَيْهِ السَّلَامُ - صَلَّى بِهِمْ  بِالْبَطْحَاءِ  وَبَيْنَ يَدَيْهِ  عَنَزَةٌ  ، الظُّهْرَ رَكْعَتَيْنِ وَالْعَصْرَ رَكْعَتَيْنِ ، وَتَمُرُّ بَيْنَ يَدَيْهِ الْمَرْأَةُ وَالْحِمَارُ  .","","Musnad al-Bazzar 4219","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن أبو موسى الزمن عن البزار","مسند أبي جحيفة رضي الله عنه"
"4227","4220  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  حَجَّاجُ بْنُ مُحَمَّدٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْأَبْطَحِ  فَجَاءَهُ  بِلَالٌ  فَآذَنَهُ بِالصَّلَاةِ  ، فَدَعَا بِوَضُوءٍ فَتَوَضَّأَ ، فَجَعَلَ النَّاسُ يَأْتُونَ فَيَأْخُذُونَ وَضُوءَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَمْسَحُونَ بِهِ وُجُوهَهُمْ  .  قَالَ  شُعْبَةُ :  وَحَدَّثَنِيهِ  الْحَكَمُ ،  عَنْ  أَبِي جُحَيْفَةَ .","","Musnad al-Bazzar 4220","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن شعبة بن الحجاج عن حجاج بن محمد الأعور عن الحسن بن منصور الشطوي عن البزار","مسند أبي جحيفة رضي الله عنه"
"4228","4221  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  جَعْفَرُ بْنُ عَوْنٍ ، قَالَ :  نَا  أَبُو الْعُمَيْسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ  كَانَ         [10/152]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِالْأَبْطَحِ  فَجَاءَهُ  بِلَالٌ  فَآذَنَهُ بِالصَّلَاةِ  ، فَدَعَا بِالْوَضُوءِ فَتَوَضَّأَ ، فَجَعَلَ النَّاسُ يَأْخُذُونَ وَضُوءَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَتَمَسَّحُونَ بِهِ . قَالَ : ثُمَّ أَخَذَ  بِلَالٌ  الْعَنَزَةَ  فَمَشَى بِهَا مَعَهُ ، وَأَقَامَ الصَّلَاةَ ، فَرَكَزَهَا بَيْنَ يَدَيْهِ ، وَالظُّعُنُ يَمُرُّونَ بَيْنَ يَدَيْهِ : الْمَرْأَةُ وَالْحِمَارُ وَالْبَعِيرُ  .","","Musnad al-Bazzar 4221","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عتبة بن عبد الله بن عتبة المسعودي عن جعفر بن عون المخزومي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي جحيفة رضي الله عنه"
"4229","4222  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ بُنْدَارٌ ، قَالَ :  نَا  أَبُو عَامِرٍ ،  عَنْ  عُمَرَ بْنِ أَبِي زَائِدَةَ ، قَالَ :  حَدَّثَنِي  عَوْنُ بْنُ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّهُ رَأَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  قُبَّةٍ  حَمْرَاءَ مِنْ أَدَمٍ ، قَالَ : وَرَأَيْتُ  بِلَالًا  أَخْرَجَ وَضُوءَهُ  ، فَرَأَيْتُ النَّاسَ يَبْتَدِرُونَ وَضُوءَهُ ، فَمَنْ أَصَابَهُ شَيْءٌ مَسَحَ وَجْهَهُ وَإِلَّا أَخَذَ مِنْ كَفِّ صَاحِبِهِ ، ثُمَّ أَخْرَجَ  عَنَزَةً  فَرَكَزَهَا ، ثُمَّ صَلَّى بِهِمْ ، تَمُرُّ بَيْنَ يَدَيْهِ الدَّوَابُّ وَالنَّاسُ  .","","Musnad al-Bazzar 4222","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عمر بن أبي زائدة الهمداني عن أبو عامر العقدي عن محمد بن بشار بندار عن البزار","مسند أبي جحيفة رضي الله عنه"
"4230","4223  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ :  نَا  جَعْفَرُ بْنُ عَوْنٍ ، قَالَ :  نَا  أَبُو الْعُمَيْسِ - وَاسْمُهُ عُتْبَةُ بْنُ عَبْدِ اللهِ -  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  آخَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَ  سَلْمَانَ         [10/153]      وَأَبِي الدَّرْدَاءِ  ، فَجَاءَ  سَلْمَانُ  يَزُورُ  أَبَا الدَّرْدَاءِ ،  فَرَأَى  أُمَّ الدَّرْدَاءِ  مُتَبَذِّلَةً ،  فَقَالَ : مَا شَأْنُكِ ؟ فَقَالَتْ : إِنَّ أَخَاكَ لَيْسَ لَهُ حَاجَةٌ فِي شَيْءٍ مِنَ النِّسَاءِ ، قَالَ : فَلَمَّا جَاءَ  أَبُو الدَّرْدَاءِ  رَحَّبَ  بِسَلْمَانَ ،  وَقَرَّبَ إِلَيْهِ الطَّعَامَ ، فَقَالَ لَهُ  سَلْمَانُ  : اطْعَمْ ، قَالَ : إِنِّي صَائِمٌ ، قَالَ : أَقْسَمْتُ عَلَيْكَ لَمَا طَعِمْتَ فَمَا أَنَا بِآكِلٍ حَتَّى تَأْكُلَ ، قَالَ : فَأَكَلَ مَعَهُ ، ثُمَّ قَالَ لَهُ : يَا  أَبَا الدَّرْدَاءِ  إِنَّ لِجَسَدِكَ عَلَيْكَ حَقًّا ، وَإِنَّ لِأَهْلِكَ عَلَيْكَ حَقًّا . أَعْطِ كُلَّ ذِي حَقٍّ حَقَّهُ ، صُمْ وَأَفْطِرْ ، وَقُمْ وَنَمْ ، وَائْتِ أَهْلَكَ ، وَأَعْطِ كُلَّ ذِي حَقٍّ حَقَّهُ ، ثُمَّ بَاتَ عِنْدَهُ  سَلْمَانُ  حَتَّى كَانَ فِي بَعْضِ اللَّيْلِ قَامَ  أَبُو الدَّرْدَاءِ  ، فَحَبَسَهُ  سَلْمَانُ  ، فَلَمَّا كَانَ عِنْدَ الصُّبْحِ ، قَالَ : قُمِ الْآنَ ، قَالَ : فَقَامَا فَصَلَّيَا ، ثُمَّ خَرَجَا إِلَى الصَّلَاةِ ، فَلَمَّا صَلَّى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَامَ إِلَيْهِ  أَبُو الدَّرْدَاءِ  فَأَخْبَرَهُ بِمَا قَالَ لَهُ  سَلْمَانُ  ، قَالَ : فَقَالَ لَهُ مِثْلَ مَا قَالَ لَهُ  سَلْمَانُ  .  قَالَ أَبُو بَكْرٍ  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  أَبِي جُحَيْفَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4223","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عتبة بن عبد الله بن عتبة المسعودي عن جعفر بن عون المخزومي عن محمد بن بشار بندار عن البزار","مسند أبي جحيفة رضي الله عنه"
"4231","4224  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ زِيَادٍ الصَّائِغُ الْبَغْدَادِيُّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ عُبَيْدٍ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا يَزَالُ هَذَا الْأَمْرُ قَائِمًا         [10/154]      حَتَّى يَلِيَ اثْنَا عَشَرَ  أَحْسَبُهُ قَالَ : "" مِنْ  قُرَيْشٍ  -  يَعْنِي -  خَلِيفَةً  .  قَالَ أَبُو بَكْرٍ :  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا  تَابَعَ  مُحَمَّدَ بْنَ عُبَيْدٍ  عَلَى رِوَايَتِهِ ، إِنَّمَا يَرْوِيهِ الْحُفَّاظُ عَنِ  الْأَعْمَشِ  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  ، وَهُوَ الصَّوَابُ  .","","Musnad al-Bazzar 4224","","وهب بن عبد الله السوائي عن أبو خالد الوالبي عن الأعمش عن محمد بن عبيد بن أبي أمية عن إبراهيم بن زياد الصائغ عن البزار","مسند أبي جحيفة رضي الله عنه"
"4232","4225  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبِي صَفْوَانَ الثَّقَفِيُّ ، قَالَ :  نَا  أَبُو قُتَيْبَةَ ، قَالَ :  نَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ فِي مَسِيرٍ لَهُ ، فَسَمِعَ مُؤَذِّنً يَقُولُ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَلَعَ الْأَنْدَادَ  ، فَقَالَ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَقَالَ : "" خَرَجَ مِنَ النَّارِ "" ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" تَجِدُونَهُ صَاحِبَ مِعْزًى  مُعْزَبَةٍ  أَوْ صَاحِبَ كِلَابٍ  .         [10/155]      قَالَ أَبُو بَكْرٍ :  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ  أَبِي قُتَيْبَةَ  ، وَغَيْرُ  مُحَمَّدِ بْنِ أَبِي صَفْوَانَ  ، عَنْ  أَبِي قُتَيْبَةَ  ، عَنْ  عَبْدِ الْجَبَّارِ بْنِ الْعَبَّاسِ  ، عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  ، عَنْ  مُسْلِمِ بْنِ بُدَيْلٍ  .","","Musnad al-Bazzar 4225","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن سلم بن قتيبة الشعيري عن محمد بن عثمان بن أبي صفوان الثقفي عن البزار","مسند أبي جحيفة رضي الله عنه"
"4233","4226  -  حَدَّثَنِي  مُحَمَّدُ بْنُ اللَّيْثِ ، وَأَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ، قَالَا :  نَا  الْفَضْلُ بْنُ دُكَيْنٍ ، قَالَ :  نَا  عَبْدُ الْجَبَّارِ بْنُ الْعَبَّاسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ فَنَامُوا فِيهِ حَتَّى طَلَعَتِ الشَّمْسُ ، فَقَالَ :  إِنَّكُمْ أَمْوَاتًا فَرَدَّ اللهُ إِلَيْكُمْ أَرْوَاحَكُمْ ، فَمَنْ نَامَ عَنْ صَلَاةٍ فَلْيُصَلِّهَا إِذَا اسْتَيْقَظَ  ، وَمَنْ نَسِيَ فَلْيُصَلِّ إِذَا ذَكَرَ  .","","Musnad al-Bazzar 4226","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن الفضل بن دكين عن أحمد بن عثمان بن حكيم عن البزار","مسند أبي جحيفة رضي الله عنه"
"4234","[10/156]      4227  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ :  نَا  أَبُو أَحْمَدَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ الْعَبَّاسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ، قَالَ : وَلَا أَعْلَمُهُ إِلَّا  عَنْ  أَبِيهِ ،  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّهَا سَتُفْتَحُ عَلَيْكُمُ الدُّنْيَا حَتَّى تُنَجِّدُوا بُيُوتَكُمْ كَمَا تُنَجَّدُ  الْكَعْبَةُ  قُلْنَا : وَنَحْنُ عَلَى دِينِنَا الْيَوْمَ ، قَالَ : "" وَأَنْتُمْ عَلَى دِينِكُمُ الْيَوْمَ "" . قُلْنَا : فَنَحْنُ يَوْمَئِذٍ خَيْرٌ أَمِ الْيَوْمَ ؟ قَالَ : "" بَلْ أَنْتُمُ الْيَوْمَ خَيْرٌ  .  قَالَ أَبُو بَكْرٍ  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  أَبِي جُحَيْفَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ أَحَدًا حَدَّثَ بِهِ إِلَّا  أَبُو أَحْمَدَ  وَلَا سَمِعْنَاهُ إِلَّا مِنْ  إِبْرَاهِيمَ بْنِ سَعِيدٍ  .","","Musnad al-Bazzar 4227","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن محمد بن عبد الله بن الزبير عن إبراهيم بن سعيد الجوهري عن البزار","مسند أبي جحيفة رضي الله عنه"
"4235","4228  -  حَدَّثَنَا  أَحْمَدُ بْنُ عُثْمَانَ ، وَمُحَمَّدُ بْنُ اللَّيْثِ ،  عَنِ  الْفَضْلِ بْنِ         [10/157]      دُكَيْنٍ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ الْعَبَّاسِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ ثَمَنِ الدَّمِ وَمَهْرِ  الْبَغِيِّ  وَثَمَنِ الْكَلْبِ  .","","Musnad al-Bazzar 4228","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عبد الجبار بن العباس الشبامي عن الفضل بن دكين عن أحمد بن عثمان بن حكيم عن البزار","مسند أبي جحيفة رضي الله عنه"
"4236","4229  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  أَنَّهُ اشْتَرَى غُلَامًا حَجَّامًا فَأَمَرَ بِمَحَاجِمِهِ فَكُسِرَتْ ، فَقُلْتُ لَهُ : أَتَكْسِرُهَا ؟ قَالَ : نَعَمْ ، إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ ثَمَنِ الدَّمِ ، وَثَمَنِ الْكَلْبِ ، وَكَسْبِ  الْبَغِيِّ  ، وَلَعَنَ  آكِلَ  الرِّبَا وَمُوكِلَهُ ،  وَالْوَاشِمَةَ  وَالْمُسْتَوْشِمَةَ ، وَلَعَنَ الْمُصَوِّرَ  .","","Musnad al-Bazzar 4229","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند أبي جحيفة رضي الله عنه"
"4237","[10/158]      4230  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، وَزِيَادُ بْنُ يَحْيَى أَبُو الْخَطَّابِ ، قَالَا :  نَا  سَهْلُ بْنُ حَمَّادٍ أَبُو عَتَّابٍ ، قَالَ :  نَا  يُونُسُ بْنُ أَبِي يَعْفُورٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  كُنْتُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَخْطُبُ  وَعُمَرُ  بَيْنَ يَدَيْهِ فِي الْمَجْلِسِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَزَالُ أَمْرُ أُمَّتِي قَائِمًا حَتَّى يَمْضِيَ اثْنَا عَشَرَ  خَلِيفَةً  كُلُّهُمْ مِنْ  قُرَيْشٍ  - قَالَ : فَخَفَضَ بِهِ صَوْتَهُ - قَالَ : فَنَكَثَ أَبِي بَيْنِ كَتِفَيْ عَمِّي ، فَقَالَ : يَا عَمِّ مَا قَالَ ؟ قَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Musnad al-Bazzar 4230","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن يونس بن أبي يعفور العبدي عن سهل بن حماد الدلال عن زياد بن يحيى الحساني عن البزار","مسند أبي جحيفة رضي الله عنه"
"4238","4231  -  وَحَدَّثَنَاهُ  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ شَبُّوَيْهِ الْمَرْوَزِيُّ ، قَالَ :  نَا         [10/159]      مُحَمَّدُ بْنُ عِمْرَانَ بْنِ أَبِي لَيْلَى ،  عَنْ  أَبِيهِ ،  عَنِ  ابْنِ أَبِي لَيْلَى ، وَهُوَ مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ  ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ -  أَنَّهُ خَرَجَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الْمَدِينَةِ  إِلَى  مَكَّةَ  فَلَمْ يَزَلْ يُصَلِّي رَكْعَتَيْنِ  رَكْعَتَيْنِ حَتَّى رَجَعَ إِلَى بَيْتِهِ  .","","Musnad al-Bazzar 4231","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن محمد بن عبد الرحمن بن أبي ليلى عن عمران بن محمد ابن أبي ليلى عن محمد بن عمران بن محمد بن عبد الرحمن بن أبي ليلى عن عبد الله بن أحمد بن شبوية المروزي عن البزار","مسند أبي جحيفة رضي الله عنه"
"4239","4232  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْأَسْوَدِ بْنِ مَأْمُولٍ الْوَرَّاقُ ، قَالَ :  نَا  يَحْيَى بْنُ السَّكَنِ ، قَالَ :  نَا  أَبُو الْعَوَّامِ وَأَظُنُّهُ صَدَقَةُ بْنُ أَبِي سَهْلٍ ،  عَنْ         [10/160]      عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ سَدَّ فُرْجَةً فِي الصَّفِّ غُفِرَ لَهُ  .  وَهَذَا الْحَدِيثُ لَمْ نَسْمَعْهُ إِلَّا مِنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ  وَكَانَ مِنْ أَفَاضِلِ النَّاسِ  .","","Musnad al-Bazzar 4232","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن سهل بن أبي صدقة البصري عن يحيى بن السكن البصري عن عبد الرحمن بن الأسود بن المأمول الوراق عن البزار","مسند أبي جحيفة رضي الله عنه"
"4240","4233  -  حَدَّثَنَا  حُمَيْدُ بْنُ الرَّبِيعِ ، قَالَ :  نَا  أَبُو أُسَامَةَ  عَنْ  صَدَقَةَ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ رَآنِي فِي الْمَنَامِ فَقَدْ رَآنِي  .","","Musnad al-Bazzar 4233","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن صدقة بن أبي عمران الكوفي عن حماد بن أسامة القرشي عن حميد بن الربيع الجلاد عن البزار","مسند أبي جحيفة رضي الله عنه"
"4241","4234  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  شَرِيكٌ ،  عَنْ  أَبِي عُمَرَ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  كُنَّا عِنْدَ رَسُولِ اللهِ         [10/161]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذُكِرَ الْجُدُودُ  ، فَقِيلَ : جَدُّ بَنِي فُلَانٍ فِي الْإِبِلِ ، وَجَدُّ بَنِي فُلَانٍ أَوْ جَدُّ فُلَانٍ فِي الْغَنَمِ ، فَسَكَتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى إِذَا صَلَّى وَرَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ ، قَالَ : "" اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ وَلَا مُعْطِيَ لِمَا مَنَعْتَ وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Musnad al-Bazzar 4234","","وهب بن عبد الله السوائي عن أبو عمر المنبهي عن شريك بن عبد الله النخعي عن أبو داود الطيالسي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي جحيفة رضي الله عنه"
"4242","4235  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ ، قَالَ :  نَا  عَلِيُّ بْنُ حَكِيمٍ ، قَالَ :  نَا  شَرِيكٌ ،  عَنْ  أَبِي عُمَرَ ،  عَنْ  أَبِي جُحَيْفَةَ - رَضِيَ اللهُ         [10/162]      عَنْهُ -  أَنَّ  رَجُلًا  جَاءَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَشَكَا إِلَيْهِ جَارَهُ ، فَقَالَ : "" يُؤْذِينِي ، فَقَالَ :  ضَعْ مَتَاعَكَ فِي الطَّرِيقِ أَوْ عَلَى ظَهْرِ الطَّرِيقِ  . فَوَضَعَهُ فَكَانَ ، فَكَانَ كُلُّ مَنْ مَرَّ ، قَالَ : مَا شَأْنُكَ ؟ قَالَ : جَارِي يُؤْذِينِي ; فَيَدْعُو عَلَيْهِ ، فَجَاءَ الرَّجُلُ ، فَقَالَ : رُدَّ مَتَاعَكَ فَلَا أُؤْذِيكَ أَبَدًا ، أَوْ كَمَا قَالَ  .","","Musnad al-Bazzar 4235","","وهب بن عبد الله السوائي عن أبو عمر المنبهي عن شريك بن عبد الله النخعي عن علي بن حكيم بن ذبيان عن إبراهيم بن عبد الله بن الجنيد الختلي عن البزار","مسند أبي جحيفة رضي الله عنه"
"4243","4236  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَرَفَةَ ، قَالَ :  نَا  عَلِيُّ بْنُ ثَابِتٍ ،  عَنْ  عُمَرَ بْنِ مُوسَى ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  أَكَلْتُ ثَرِيدًا ، وَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَتَجَشَّأْتُ عِنْدَهُ ، فَقَالَ :  يَا  أَبَا جُحَيْفَةَ ،  إِنَّ أَطْوَلَ النَّاسِ جُوعًا يَوْمَ الْقِيَامَةِ أَكْثَرُهُمْ شِبَعًا فِي الدُّنْيَا  .         [10/163]","","Musnad al-Bazzar 4236","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن عمر بن موسى بن الوجيه الميثمي عن علي بن ثابت الجزري عن الحسن بن عرفة العبدي عن البزار","مسند أبي جحيفة رضي الله عنه"
"4244","4237  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  عَبْدُ السَّلَامِ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنْ  أَبِي جُحَيْفَةَ ، قَالَ :  تَجَشَّأْتُ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فَذَكَرَ نَحْوَهُ .","","Musnad al-Bazzar 4237","","وهب بن عبد الله السوائي عن محرز بن عبد الله الجزري عن عبد السلام بن حرب الملائي عن إسحاق بن منصور السلولي عن عباس بن جعفر العباسي عن البزار","مسند أبي جحيفة رضي الله عنه"
"4245","[10/164]      4238  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَعَمْرُو بْنُ عَلِيٍّ ، وَأَحْمَدُ بْنُ عَبْدَةَ ، قَالُوا :  نَا  عُمَرُ بْنُ عَلِيٍّ الْمُقَدَّمِيُّ ، قَالَ :  نَا  أَشْعَثُ بْنُ سَوَّارٍ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِينَا  سَاعِيًا  بِأَمْرِهِ أَنْ يَأْخُذَ الصَّدَقَةَ مِنْ أَغْنِيَائِنَا  وَيَضَعَهَا فِي فُقَرَائِنَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ  إِلَّا  الْأَشْعَثُ بْنُ سَوَّارٍ  .","","Musnad al-Bazzar 4238","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن أشعث بن سوار عن عمر بن علي بن عطاء عن أحمد بن عبدة الضبي عن البزار","مسند أبي جحيفة رضي الله عنه"
"4246","4239  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزِيدَ بْنِ الرُّؤَاسِ ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ  بَنِي عَامِرٍ         [10/165]      أَتَوُا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فَلَمَّا رَآهُمْ ، قَالَ : "" مَرْحَبًا  .","","Musnad al-Bazzar 4239","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن حجاج بن أرطاة عن أبو معاوية الضرير عن محمد بن يزيد بن الرؤاس عن البزار","مسند أبي جحيفة رضي الله عنه"
"4247","4240  -  حَدَّثَنَا  حَفْصُ بْنُ مَحْبُوبٍ ، قَالَ :  نَا  عَبْدُ الْخَالِقِ بْنُ أَبِي مُخَارِقٍ ، قَالَ :  نَا  الْحَجَّاجُ ،  عَنْ  عَوْنِ بْنِ أَبِي جُحَيْفَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  رَأَيْتُ  بِلَالًا  مُؤَذِّنَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُؤَذِّنُ  ، فَأَدْخَلَ أُصْبُعَيْهِ فِي أُذُنَيْهِ  .         [10/166]","","Musnad al-Bazzar 4240","","وهب بن عبد الله السوائي عن عون بن أبي جحيفة السوائي عن حجاج بن أرطاة عن عبد الخالق بن أبي مخارق عن حفص بن محبوب عن البزار","مسند أبي جحيفة رضي الله عنه"
"4248","[10/167]      مُسْنَدُ  جَابِرِ بْنِ سَمُرَةَ  رَضِيَ اللهُ عَنْهُ         [10/168]             [10/169]      مَا  أَسْنَدَ  جَابِرُ بْنُ سَمُرَةَ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  4241  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمَّى  الْمَدِينَةَ  طَابَةَ  .","","Musnad al-Bazzar 4241","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4249","4242  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ الْقُرَشِيُّ ، قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .","","Musnad al-Bazzar 4242","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4250","[10/170]      4243  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  صَلَّى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  أَبِي الدَّحْدَاحِ  ، ثُمَّ أُتِيَ بِفَرَسٍ عَرَبِيٍّ ، فَرَكِبَهُ ، فَجَعَلَ  يَتَوَقَّصُ  بِهِ ، فَقَالَ كَلِمَةً خَفِيَّةً ، فَقَالَ  رَجُلٌ  مِنَ  الْقَوْمِ  وَنَحْنُ نَمْشِي خَلْفَهُ : إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  كَمْ مِنْ  عِذْقٍ  مُدَلًّى  لِأَبِي الدَّحْدَاحِ  فِي الْجَنَّةِ  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ وَاحِدٍ عَنْ  سِمَاكٍ  ، وَلَا أَعْلَمُ أَحَدًا رَوَاهُ عَنْ  سِمَاكٍ  أَجَلَّ مِنْ  شُعْبَةَ  ، فَاجْتَزَأْنَا بِحَدِيثِ  شُعْبَةَ  .","","Musnad al-Bazzar 4243","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4251","4244  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  كَانَ النَّبِيُّ -         [10/171]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  ضَلِيعَ  الْفَمِ  ،  أَشْكَلَ  الْعَيْنَيْنِ ،  مَنْهُوسَ  الْعَقِبَيْنِ  ، قَالَ :  فَقُلْتُ : مَا  مَنْهُوسُ  الْعَقِبَيْنِ ؟ قَالَ : قَلِيلُ لَحْمِ الْعَقِبَيْنِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ  بِإِسْنَادٍ  أَحْسَنَ مِنْ هَذَا  الْإِسْنَادِ  ، لَا عَنْ  جَابِرٍ  وَلَا عَنْ غَيْرِهِ  .","","Musnad al-Bazzar 4244","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4252","4245  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  رَأَيْتُ خَاتَمَ النُّبُوَّةِ فِي ظَهْرِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - كَأَنَّهُ بَيْضَةُ حَمَامٍ  .         [10/172]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  جَابِرِ بْنِ سَمُرَةَ  إِلَّا مِنْ حَدِيثِ  سِمَاكٍ  ، وَلَا نَعْلَمُ أَحَدًا  أَثْبَتَ  فِي  سِمَاكٍ  مِنْ  شُعْبَةَ  .","","Musnad al-Bazzar 4245","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4253","4246  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - يَقُولُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا يَبْرَحُ الدِّينُ قَائِمًا عَلَيْهِ عِصَابَةٌ مِنَ الْمُسْلِمِينَ  إِلَى أَنْ تَقُومَ السَّاعَةُ  .         [10/173]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  جَابِرِ بْنِ سَمُرَةَ  ، وَقَدْ رُوِيَ نَحْوُ كَلَامِهِ بِغَيْرِ هَذَا اللَّفْظِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ وُجُوهٍ  .","","Musnad al-Bazzar 4246","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4254","4247  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَكُونُ اثْنَا عَشَرَ أَمِيرًا  ، فَقَالَ كَلِمَةً لَمْ أَسْمَعْهَا ، فَقُلْتُ لِأَبِي : مَا قَالَ ؟ قَالَ : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  .","","Musnad al-Bazzar 4247","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4255","4248  -  حَدَّثَنَاهُ  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ - عَلَيْهِ السَّلَامُ - بِنَحْوِهِ .","","Musnad al-Bazzar 4248","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4256","4249  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا :  نَا  مُحَمَّدُ بْنُ         [10/174]      جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - يَقُولُ  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ عَلَى الْمِنْبَرِ قَائِمًا  غَيْرَ أَنَّهُ كَانَ يَقْعُدُ قَعْدَةً ، ثُمَّ يَقُومُ  .","","Musnad al-Bazzar 4249","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4257","4250  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ يَقُولُ :  أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَوْ أُتِيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -  بِرَجُلٍ  أَشْعَرَ  قَصِيرٍ لَهُ  عَضَلَاتٌ  ، فَأَقَرَّ أَنَّهُ قَدْ زَنَى ، فَرَدَّهُ مَرَّتَيْنِ ، ثُمَّ أَمَرَ بِهِ فَرُجِمَ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  كُلَّمَا نَفَرْنَا غَازِينَ فِي  سَبِيلِ  اللهِ تَخَلَّفَ أَحَدُهُمْ ، لَهُ نَبِيبٌ  كَنَبِيبِ  التَّيْسِ  ، يَمْنَحُ أَحَدُهُمُ  الْكُثْبَةَ  لَا أُوتَى بِأَحَدٍ مِنْهُمْ إِلَّا جَعَلْتُهُ نَكَالًا  .         [10/175]      وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ وَاحِدٍ ، عَنْ  سِمَاكٍ  ، عَنْ  جَابِرِ بْنِ سَمُرَةَ  مِنْهُمْ :  إِسْرَائِيلُ ،  وَأَبُو عَوَانَةَ ،  وَغَيْرُهُمَا ،  وَشُعْبَةُ  أَحْسَنُهُمْ حَدِيثًا لَهُ عَنْ  سِمَاكٍ ،  وَأَتَمُّهُمْ حَدِيثًا  .","","Musnad al-Bazzar 4250","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4258","4251  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  سَأَلَهُ رَجُلٌ كَيْفَ كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَصْنَعُ إِذَا صَلَّى الصُّبْحَ ؟ قَالَ :  يَقْعُدُ فِي مَقْعَدِهِ حَتَّى تَطْلُعَ الشَّمْسُ  .","","Musnad al-Bazzar 4251","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4259","[10/176]      4252  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  إِنَّ بَيْنَ يَدَيِ السَّاعَةِ كَذَّابِينَ  قَالَ  سِمَاكٌ :  سَمِعْتُ  أَبِي يَقُولُ :  احْذَرُوهُمْ  .","","Musnad al-Bazzar 4252","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4260","[10/177]      4253  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  كَانَتْ صَلَاةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَصْدًا  وَخُطْبَتُهُ  قَصْدًا  .","","Musnad al-Bazzar 4253","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن أبو داود الطيالسي عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4261","[10/178]      4254  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَيَفْتَحَنَّ نَاسٌ مِنْ أُمَّتِي كُنُوزَ  كِسْرَى  الْأَبْيَضَ  .","","Musnad al-Bazzar 4254","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4262","4255  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  سُلَيْمَانُ بْنُ مُعَاذٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ         [10/179]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنِّي لَأَعْلَمُ حَجَرًا  بِمَكَّةَ  كَانَ يُسَلِّمُ عَلَيَّ حِينَ بُعِثْتُ  .","","Musnad al-Bazzar 4255","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن سليمان بن قرم الضبي عن أبو داود الطيالسي عن محمد بن بشار بندار عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4263","4256  -  حَدَّثَنَاهُ  أَحْمَدُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ، قَالَ :  نَا  إِبْرَاهِيمُ بْنُ طَهْمَانَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .         [10/180]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا حَدَّثَ بِهِ عَنْ  سِمَاكٍ  إِلَّا  إِبْرَاهِيمُ ،  وَسُلَيْمَانُ بْنُ مُعَاذٍ  .","","Musnad al-Bazzar 4256","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إبراهيم بن طهمان عن يحيى بن أبي بكير عن أحمد بن منصور الرمادي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4264","4257  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ ، قَالَ :  نَا  عَمْرُو بْنُ طَلْحَةَ ، قَالَ :  نَا  أَسْبَاطُ بْنُ نَصْرٍ ،  عَنْ  سِمَاكٍ - يَعْنِي - ابْنَ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  صَلَّيْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَاةَ الْأُولَى ، ثُمَّ خَرَجَ إِلَى أَهْلِهِ  ، فَاسْتَقْبَلَهُ وِلْدَانُ  أَهْلِ الْمَدِينَةِ  ، فَجَعَلَ يَمْسَحُ خَدَّ أَحَدِهِمْ ، فَأَمَّا أَنَا فَمَسَحَ خَدِّي ، فَوَجَدْتُ بَرْدًا وَرِيحًا ، كَأَنَّمَا كَانَتْ فِي جُؤْنَةِ عَطَّارٍ  .","","Musnad al-Bazzar 4257","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن عباس بن عبد العظيم العنبري عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4265","4258  -  حَدَّثَنَاهُ  عَبْدُ اللهِ بْنُ الْحَارِثِ الْمَرْوَزِيُّ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ عُثْمَانَ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  شُعْبَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ         [10/181]      النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا حَدَّثَ بِهِ ، عَنْ  شُعْبَةَ  إِلَّا  عُثْمَانُ بْنُ جَبَلَةَ  ، وَلَا نَعْلَمُ حَدَّثَ بِهِ غَيْرُ  شُعْبَةَ  إِلَّا  أَسْبَاطُ بْنُ نَصْرٍ  .","","Musnad al-Bazzar 4258","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شعبة بن الحجاج عن عثمان بن جبلة عن عبد الله بن عثمان بن جبلة عن عبد الله بن الحارث المروزي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4266","4259  -  حَدَّثَنَا  مُعَاذُ بْنُ شُعْبَةَ ، قَالَ :  نَا  شَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَجَمَ  يَهُودِيًّا  وَيَهُودِيَّةً  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  سِمَاكٍ  إِلَّا  شَرِيكٌ  .","","Musnad al-Bazzar 4259","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن معاذ بن شعبة البصري عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4267","4260  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ         [10/182]      النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ  يَقْرَأُ  فِي الظُّهْرِ وَالْعَصْرِ بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  سِمَاكٍ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  .","","Musnad al-Bazzar 4260","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن عبد الرحمن بن مهدي عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4268","4261  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  هِشَامُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ :  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي الظُّهْرَ إِذَا دَحَضَتِ الشَّمْسُ  .         [10/183]      قَالَ أَبُو بَكْرٍ  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  سِمَاكٍ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  .","","Musnad al-Bazzar 4261","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن حماد بن سلمة عن أبو الوليد الطيالسي عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4269","4262  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، وَأَحْمَدُ بْنُ مَنْصُورٍ ، قَالَا :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  أَنَا  الْحَسَنُ بْنُ صَالِحٍ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمْ يَمُتْ حَتَّى كَانَ أَكْثَرُ صَلَاتِهِ جَالِسًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  سِمَاكٍ  إِلَّا  الْحَسَنُ بْنُ صَالِحٍ  .","","Musnad al-Bazzar 4262","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الحسن بن صالح بن صالح بن حي عن عبيد الله بن موسى عن أحمد بن منصور الرمادي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4270","4263  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَعَمْرُو بْنُ عَلِيٍّ ، قَالَا :  نَا  أَبُو         [10/184]      دَاوُدَ ، قَالَ :  نَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا يُؤَذَّنُ لَهُ فِي الْعِيدَيْنِ  .","","Musnad al-Bazzar 4263","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن أبو داود الطيالسي عن الفلاس عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4271","4264  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  كَانَ  بِلَالٌ  لَا يَخْرِمُ عَنِ الْوَقْتِ  وَرُبَّمَا أَخَّرَ الْإِقَامَةَ شَيْئًا  .","","Musnad al-Bazzar 4264","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن أبو داود الطيالسي عن الفلاس عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4272","[10/185]      4265  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْبُخَارِيُّ ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ شَرِيكٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي لَيْلَةِ الْقَدْرِ "" أَنَّهَا لَيْلَةُ رِيحٍ وَقَطْرٍ  .","","Musnad al-Bazzar 4265","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن عبد الرحمن بن شريك بن عبد الله النخعي عن البخاري عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4273","4266  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ شَرِيكٍ ،  عَنْ  أَبِيهِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  الْتَمِسُوا لَيْلَةَ الْقَدْرِ فِي الْعَشْرِ الْأَوَاخِرِ مِنْ رَمَضَانَ ؛  فَإِنِّي قَدْ رَأَيْتُهَا فَنُسِّيتُهَا ، وَهِيَ لَيْلَةُ  مَطَرٍ أَوْ رِيحٍ "" أَوْ         [10/186]      قَالَ : "" قَطْرٍ وَرِيحٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  سِمَاكٍ  إِلَّا  شَرِيكٌ  ، وَلَا نَعْلَمُ أَحَدًا يَرْوِيهِ بِهَذَا اللَّفْظِ عَنْ  شَرِيكٍ  إِلَّا  عَبْدُ الرَّحْمَنِ بْنُ شَرِيكٍ  عَنْ أَبِيهِ  .","","Musnad al-Bazzar 4266","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن عبد الرحمن بن شريك بن عبد الله النخعي عن أحمد بن منصور الرمادي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4274","4267  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْتَمِسُوا لَيْلَةَ الْقَدْرِ فِي الْعَشْرِ الْأَوَاخِرِ  مِنْ رَمَضَانَ  .","","Musnad al-Bazzar 4267","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن أبو داود الطيالسي عن محمد بن بشار بندار عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4275","4268  -  حَدَّثَنَا  مُعَاذُ بْنُ شُعْبَةَ ، قَالَ :  نَا  شَرِيكٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ أَصْحَابُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَذْكُرُونَ عِنْدَهُ الشِّعْرَ ، وَيَتَنَاشَدُونَهُ بَيْنَهُمْ ، وَرُبَّمَا تَبَسَّمَ النَّبِيُّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .         [10/187]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  سِمَاكٍ  إِلَّا  شَرِيكٌ  .","","Musnad al-Bazzar 4268","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن معاذ بن شعبة البصري عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4276","4269  -  حَدَّثَنَا  أَبُو كَامِلٍ ، قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ -  أَنَّ قَوْمًا مَاتَ لَهُمْ بَغْلٌ ، وَلَمْ يَكُنْ لَهُمْ شَيْءٌ يَأْكُلُونَهُ  ، فَجَاءُوا إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَخَّصَ لَهُمْ فِيهِ  .","","Musnad al-Bazzar 4269","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن الوضاح بن عبد الله اليشكري عن فضيل بن حسين الجحدري عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4277","4270  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْبَرْمَكِيُّ ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ         [10/188]      عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ الشَّيْطَانَ عَرَضَ لِي ، فَجَعَلَ يُلْقِي عَلَيَّ شَرَرَ النَّارِ  ; فَلَوْلَا  دَعْوَةُ  أَخِي  سُلَيْمَانَ  أَخَذْتُهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  سِمَاكٍ  إِلَّا  إِسْرَائِيلُ  .","","Musnad al-Bazzar 4270","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن عبد الله بن جعفر بن يحيى البرمكي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4278","4271  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدٍ الْبَغْدَادِيُّ ، قَالَ :  نَا  إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ  بِلَالٌ  يُؤَذِّنُ ، ثُمَّ يُمْهِلُ فَإِذَا رَأَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - أَخَذَ فِي الْإِقَامَةِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  سِمَاكٍ  إِلَّا  إِسْرَائِيلُ  .","","Musnad al-Bazzar 4271","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن إسحاق بن منصور السلولي عن عباس الدوري عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4279","[10/189]      4272  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورِ بْنِ سَيَّارٍ ، قَالَ :  نَا  إِسْحَاقُ بْنُ مَنْصُورٍ السَّلُولِيُّ ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُتَّكِئًا  عَلَى وِسَادَةٍ عَلَى يَسَارِهِ  .  وَهَذَا الْحَدِيثُ إِنَّمَا اخْتُصِرَ مِنْ حَدِيثِ  جَابِرِ بْنِ سَمُرَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُتِيَ  بِمَاعِزٍ  لِيَرْجُمَهُ ، فَزَادَ  إِسْرَائِيلُ  هَذَا الْحَرْفَ فِيهِ ، فَكُتِبَ مِنْ أَجْلِ الزِّيَادَةِ ، وَإِلَّا فَإِنَّ حَدِيثَ  جَابِرِ بْنِ سَمُرَةَ  فِي رَجْمِ  مَاعِزٍ  رَوَاهُ  شُعْبَةُ  وَإِسْرَائِيلُ  وَأَبُو عَوَانَةَ  .","","Musnad al-Bazzar 4272","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن إسحاق بن منصور السلولي عن أحمد بن منصور الرمادي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4280","4273  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ صَالِحِ بْنِ مُسْلِمٍ الْعِجْلِيُّ ، قَالَ :  نَا  نَاصِحٌ أَبُو عَبْدِ اللهِ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا كَانَ يَوْمُ الْفِطْرِ         [10/190]      أَكَلَ قَبْلَ أَنْ يَخْرُجَ سَبْعَ تَمَرَاتٍ  ، وَإِذَا كَانَ يَوْمَ الضُّحَى لَمْ يَطْعَمْ شَيْئًا حَتَّى يَرْجِعَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  جَابِرِ بْنِ سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  سِمَاكٍ  إِلَّا  نَاصِحٌ أَبُو عَبْدِ اللهِ ،  وَهُوَ  لَيِّنُ الْحَدِيثِ  ، وَإِنَّمَا يُكْتَبُ مِنْ حَدِيثِهِ مَا لَمْ يَرْوِهِ غَيْرُهُ  .","","Musnad al-Bazzar 4273","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن عبد الله بن صالح العجلي عن أحمد بن منصور الرمادي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4281","4274  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  نَاصِحٌ أَبُو عَبْدِ اللهِ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَأَنْ يُؤَدِّبَ أَحَدُكُمْ وَلَدَهُ خَيْرٌ لَهُ مِنْ أَنْ يَتَصَدَّقَ  كُلَّ يَوْمٍ بِنِصْفِ صَاعٍ  .         [10/191]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  سِمَاكٍ  إِلَّا  نَاصِحٌ  .","","Musnad al-Bazzar 4274","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن إسحاق بن منصور السلولي عن عباس بن جعفر العباسي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4282","4275  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ مُسْلِمٍ ، قَالَ :  نَا  أَبُو عَبْدِ اللهِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  كُفِّنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ثَلَاثَةِ أَثْوَابٍ  بِيضٍ ، وَإِزَارٍ ، وَلِفَافَةٍ ،  وَكُفِّنَ  عُمَرُ  فِي ثَوْبَيْنِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ بِهَذَا اللَّفْظِ فِي كَفَنِ النَّبِيِّ - عَلَيْهِ السَّلَامُ - إِلَّا  جَابِرُ بْنُ سَمُرَةَ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  سِمَاكٍ  إِلَّا  نَاصِحٌ ،  وَقَدْ تَقَدَّمَ ذِكْرُنَا لَهُ  .","","Musnad al-Bazzar 4275","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن عبد الله بن صالح العجلي عن أحمد بن منصور الرمادي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4283","4276  -  حَدَّثَنَا  مُحَمَّدُ بْنُ اللَّيْثِ الْهِرَائِيُّ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ أَبَانَ ، قَالَ :  نَا  نَاصِحٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  قُلْتُ يَا رَسُولَ اللهِ مَنْ يَحْمِلُ رَايَتَكَ يَوْمَ الْقِيَامَةِ ، قَالَ :  مَنْ يَحْمِلُهَا فِي الدُّنْيَا ؛  عَلِيُّ بْنُ أَبِي طَالِبٍ  .         [10/192]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  سِمَاكٍ  إِلَّا  نَاصِحٌ  .","","Musnad al-Bazzar 4276","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن ناصح بن عبد الله المحلمي عن إسماعيل بن أبان عن محمد بن الليث الهرائي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4284","4277  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جُوَانِ بْنِ شُعْبَةَ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ أَبَانَ ، قَالَ :  نَا  قَيْسٌ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  صَعِدَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْمِنْبَرَ ، فَقَالَ : "" آمِينَ آمِينَ آمِينَ "" فَلَمَّا نَزَلَ سُئِلَ عَنْ ذَلِكَ ، فَقَالَ :  أَتَانِي  جِبْرِيلُ  ، فَقَالَ :  رَغِمَ  أَنْفُ مَنْ أَدْرَكَ رَمَضَانَ فَلَمْ يُغْفَرْ لَهُ  ، قُلْ : آمِينَ ، قُلْتُ : آمِينَ ، وَرَغِمَ أَنْفُ رَجُلٍ ذُكِرْتَ عِنْدَهُ فَلَمْ يُصَلِّ عَلَيْكَ ، قُلْ : آمِينَ ، فَقُلْتُ : آمِينَ ، وَرَغِمَ أَنْفُ رَجُلٍ أَدْرَكَ وَالِدَيْهِ أَوْ أَحَدَهُمَا فَلَمْ يُغْفَرْ لَهُ ، أَوْ لَا يُدْخِلَانِهِ الْجَنَّةَ آمِينَ ، قُلْتُ : آمِينَ  .  هَذَا أَوْ نَحْوَهُ .         [10/193]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  جَابِرِ بْنِ سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  سِمَاكٍ  إِلَّا  قَيْسٌ  ، وَلَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  قَيْسٍ  إِلَّا  إِسْمَاعِيلُ بْنُ أَبَانَ  .","","Musnad al-Bazzar 4277","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن قيس بن الربيع الأسدي عن إسماعيل بن أبان عن محمد بن جوان الواسطي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4285","4278  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  زُهَيْرٌ - يَعْنِي - ابْنَ مُعَاوِيَةَ ،  عَنْ  سِمَاكٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ -  أَنَّ  رَجُلًا  قَتَلَ نَفْسَهُ بِمَشَاقِصَ فَلَمْ يُصَلِّ النَّبِيُّ عَلَيْهِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا مِنْ هَذَا الْوَجْهِ مِنْ حَدِيثِ  جَابِرِ بْنِ سَمُرَةَ  عَنْهُ ،  وَإِنَّمَا تَرَكَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الصَّلَاةَ عَلَيْهِ عِنْدَنَا - وَاللهُ أَعْلَمُ - عُقُوبَةً لِئَلَّا يَعُودَ غَيْرُهُ         [10/194]      فَيَصْنَعَ مِثْلَ ذَلِكَ بِنَفْسِهِ  .","","Musnad al-Bazzar 4278","","جابر بن سمرة السوائي عن سماك بن حرب البكري عن زهير بن معاوية بن حديج عن أبو داود الطيالسي عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4286","4279  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  أَبُو النَّضْرِ هَاشِمُ بْنُ الْقَاسِمِ ، قَالَ :  نَا  أَبُو خَيْثَمَةَ - يَعْنِي - زُهَيْرَ بْنَ مُعَاوِيَةَ ، قَالَ :  نَا  زِيَادُ بْنُ خَيْثَمَةَ ،  عَنِ  الْأَسْوَدِ بْنِ سَعِيدٍ الْهَمْدَانِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَكُونُ مِنْ بَعْدِي اثْنَا عَشَرَ  خَلِيفَةً  كُلُّهُمْ مِنْ  قُرَيْشٍ  ، ثُمَّ رَجَعَ بَيْتَهُ ، فَقُلْتُ : ثُمَّ يَكُونُ مَاذَا ؟ قَالَ : "" ثُمَّ يَكُونُ  الْهَرْجُ  .","","Musnad al-Bazzar 4279","","جابر بن سمرة السوائي عن الأسود بن سعيد الهمداني عن زياد بن خيثمة الجعفي عن زهير بن معاوية بن حديج عن هاشم بن القاسم بن مسلم عن أحمد بن منصور الرمادي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4287","4280  -  حَدَّثَنَا  عَبَّادُ بْنُ يَعْقُوبَ ، قَالَ :  نَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ، قَالَ :  نَا  الْمُهَاجِرُ بْنُ مِسْمَارٍ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .         [10/195]","","Musnad al-Bazzar 4280","","جابر بن سمرة السوائي عن عامر بن سعد بن أبي وقاص عن مهاجر بن مسمار الزهري عن حاتم بن إسماعيل الحارثي عن عباد بن يعقوب الرواجني عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4288","4281  -  وَحَدَّثَنَاهُ  نَصْرُ بْنُ عَلِيٍّ ، قَالَ :  أَنَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ :  أَنَا  ابْنُ عَوْنٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِنَحْوِ حَدِيثِ  الْأَسْوَدِ بْنِ سَعِيدٍ  إِلَّا أَنَّهُ لَا أَحْفَظُ فِي حَدِيثِهِمَا "" ثُمَّ يَكُونُ  الْهَرْجُ  ""  .  وَلَا نَعْلَمُ رَوَى  عَامِرُ بْنُ سَعْدٍ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  إِلَّا هَذَا الْحَدِيثَ ،         [10/196]      وَلَا رَوَى  الشَّعْبِيُّ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  إِلَّا هَذَا الْحَدِيثَ ، وَقَدْ رَوَاهُ  زِيَادُ بْنُ عَلَاقَةَ  عَنْ  جَابِرِ بْنِ سَمُرَةَ  أَيْضًا .","","Musnad al-Bazzar 4281","","جابر بن سمرة السوائي عن الشعبي عن عبد الله بن عون بن أرطبان عن يزيد بن زريع العيشي عن نصر بن علي بن نصر الجهضمي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4289","4282  -  حَدَّثَنَا  صَفْوَانُ بْنُ الْمُغَلِّسِ ، قَالَ :  نَا  بَكْرُ بْنُ خِدَاشٍ ، قَالَ :  نَا  حَرْبُ بْنُ خَالِدِ بْنِ جَابِرِ بْنِ سَمُرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ أَكَلَ مِنْ هَذِهِ الْبَقْلَةِ الْمُنْكَرَةِ  - يَعْنِي الثُّومَ - "" فَلْيَجْلِسْ فِي بَيْتِهِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ عَنْ  جَابِرِ بْنِ سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُهُ يُرْوَى أَيْضًا بِهَذَا اللَّفْظِ عَنْ غَيْرِ  جَابِرِ بْنِ سَمُرَةَ  .","","Musnad al-Bazzar 4282","","جابر بن سمرة السوائي عن خالد بن جابر بن سمرة السوائي عن حرب بن خالد بن جابر السوائي عن بكر بن خداش الكوفي عن صفوان بن المغلس عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4290","4283  -  حَدَّثَنَا  صَفْوَانُ بْنُ الْمُغَلِّسِ ، قَالَ :  نَا  بَكْرُ بْنُ خِدَاشٍ ، قَالَ :  نَا  حَرْبُ بْنُ خَالِدِ بْنِ جَابِرِ بْنِ سَمُرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ -  رَضِيَ اللهُ عَنْهُ - قَالَ  جَاءَ  مَاعِزٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ -         [10/197]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِنِّي قَدْ زَنَيْتُ فَأَعْرَضَ عَنْهُ بِوَجْهِهِ ، ثُمَّ جَاءَهُ مِنْ قِبَلِ وَجْهِهِ فَأَعْرَضَ عَنْهُ ، فَجَاءَهُ الثَّالِثَةَ فَأَعْرَضَ عَنْهُ ، ثُمَّ جَاءَهُ الرَّابِعَةَ ، فَلَمَّا قَالَ لَهُ ذَلِكَ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِأَصْحَابِهِ :  قُومُوا إِلَى صَاحِبِكُمْ فَإِنْ كَانَ صَحِيحًا فَارْجُمُوهُ  فَسُئِلَ عَنْهُ فَوَجَدُوهُ صَحِيحًا فَرُجِمَ ، فَلَمَّا أَصَابَتْهُ الْحِجَارَةُ حَاضَرَهُمْ وَتَلَقَّاهُ  رَجُلٌ مِنْ أَصْحَابِ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِلَحْيَيْ  جَمَلٍ فَضَرَبَهُ بِهِ فَقَتَلَهُ ، فَقَالَ أَصْحَابُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى النَّارِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" كَلَّا فَإِنَّهُ قَدْ تَابَ تَوْبَةً لَوْ تَابَهَا أُمَّةٌ مِنَ الْأُمَمِ لَقُبِلَ مِنْهُمْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ عَنْ  جَابِرِ بْنِ سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا عَنْ غَيْرِ  جَابِرِ بْنِ سَمُرَةَ  أَيْضًا وَإِنْ كَانَ قَدْ رُوِيَ عَنْ  جَابِرٍ  بَعْضُ هَذَا الْكَلَامِ بِغَيْرِ هَذَا اللَّفْظِ .","","Musnad al-Bazzar 4283","","جابر بن سمرة السوائي عن خالد بن جابر بن سمرة السوائي عن حرب بن خالد بن جابر السوائي عن بكر بن خداش الكوفي عن صفوان بن المغلس عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4291","4284  -  وَحَدَّثَنَا  صَفْوَانُ بْنُ الْمُغَلِّسِ ، قَالَ :  نَا  بَكْرُ بْنُ خِدَاشٍ ، قَالَ :  نَا  حَرْبُ بْنُ خَالِدِ بْنِ جَابِرِ بْنِ سَمُرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا تَزَالُ أُمَّتِي عَلَى الْحَقِّ ظَاهِرِينَ ،  وَلَا يَزَالُ أَمْرُ أُمَّتِي صَالِحًا لَا يَضُرُّهُمْ عَدَاوَةُ مَنْ عَادَاهُمْ حَتَّى يَلِيَهُمُ اثْنَا عَشَرَ  خَلِيفَةً  "" فَقَالَ  سَمُرَةُ أَبُو جَابِرٍ  : "" كُلُّهُمْ مِنْ  قُرَيْشٍ  "" قَالَ :         [10/198]      نَعَمْ  .  وَلَا نَعْلَمُ رَوَى عَنْ  حَرْبِ بْنِ خَالِدٍ  إِلَّا  بَكْرُ بْنُ خِدَاشٍ  .","","Musnad al-Bazzar 4284","","جابر بن سمرة السوائي عن خالد بن جابر بن سمرة السوائي عن حرب بن خالد بن جابر السوائي عن بكر بن خداش الكوفي عن صفوان بن المغلس عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4292","4285  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْكُوفِيُّ ، قَالَ :  نَا  عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ ، قَالَ :  نَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يُوشِكُ  أَنْ تَخْرُجَ الظَّعِينَةُ مِنَ  الْمَدِينَةِ  إِلَى  الْحِيرَةِ  لَا تَخَافُ أَحَدًا  .         [10/199]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  جَابِرِ بْنِ سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4285","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن أبو بكر بن عياش عن عمر بن حفص بن غياث عن أحمد بن يحيى بن زكريا عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4293","4286  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ الْقُرَشِيُّ ، قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِذَا هَلَكَ  كِسْرَى  فَلَا  كِسْرَى  بَعْدَهُ  ، وَإِذَا هَلَكَ  قَيْصَرُ  فَلَا  قَيْصَرَ  بَعْدَهُ ، وَالَّذِي نَفْسِي بِيَدِهِ لَتُنْفَقَنَّ كُنُوزُهُمَا فِي  سَبِيلِ  اللهِ  .","","Musnad al-Bazzar 4286","","جابر بن سمرة السوائي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4294","[10/200]      4287  -  حَدَّثَنَا  عَلِيُّ بْنُ مُسْلِمٍ ، قَالَ :  نَا  مُحَمَّدُ بْنُ أَبِي عُبَيْدَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ  ، قَالَ :  سَمِعْتُ  جَابِرَ بْنَ سَمُرَةَ يَقُولُ :  أَوَّلُ مَنْ رَمَى مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِسَهْمٍ - دَمَا بِهِ -  سَعْدٌ  .","","Musnad al-Bazzar 4287","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن الأعمش عن عبد الملك بن معن المسعودي عن محمد بن أبي عبيدة المسعودي عن علي بن مسلم الطوسي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4295","4288  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورِ بْنِ سَيَّارٍ ، قَالَ :  نَا  مُحَمَّدُ بْنُ الْقَاسِمِ         [10/201]      الْأَسَدِيُّ ، قَالَ :  نَا  فِطْرٌ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ السُّوَائِيِّ - سُوَاءِ قِيسٍ - قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : ""  ثَلَاثٌ أَخَافُ عَلَى أُمَّتِي  : الِاسْتِسْقَاءُ بِالْأَنْوَاءِ ، وَحَيْفُ السُّلْطَانِ ، وَالتَّكْذِيبُ بِالْقَدَرِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  جَابِرِ بْنِ سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ،  وَمُحَمَّدُ بْنُ الْقَاسِمِ  لَيِّنُ الْحَدِيثِ  وَقَدِ احْتَمَلَ حَدِيثَهُ أَهْلُ الْعِلْمِ وَرَوَوْا عَنْهُ  .","","Musnad al-Bazzar 4288","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن فطر بن خليفة عن محمد بن القاسم الأسدي عن أحمد بن منصور الرمادي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4296","4289  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  يَزِيدُ بْنُ أَبِي حَكِيمٍ ، قَالَ :  نَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  أَلَا تَصُفُّونَ كَمَا تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهَا  ؟ "" قَالُوا : يَا رَسُولَ اللهِ ، وَكَيْفَ تَصُفُّ الْمَلَائِكَةُ عِنْدَ رَبِّهِمْ ؟ قَالَ : "" يُتِمُّونَ الصُّفُوفَ الْمُقَدَّمَةَ ، وَيَتَرَاصُّونَ فِي الصَّفِّ  .         [10/202]","","Musnad al-Bazzar 4289","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن سفيان الثوري عن يزيد بن أبي حكيم الكناني عن أحمد بن منصور الرمادي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4297","4290  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَهَذَا الْكَلَامُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  جَابِرُ بْنُ سَمُرَةَ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  جَابِرٍ  إِلَّا هَذَا الطَّرِيقَ  .","","Musnad al-Bazzar 4290","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن أبو معاوية الضرير عن الفلاس عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4298","4291  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  يَزِيدُ بْنُ أَبِي حَكِيمٍ ، قَالَ :         [10/203]      نَا  سُفْيَانُ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ دَخَلَ الْمَسْجِدَ فَرَآهُمْ رَافِعِي أَيْدِيهِمْ فِي الصَّلَاةِ ، فَقَالَ :  مَا لَهُمْ رَافِعِي أَيْدِيهِمْ كَأَنَّهَا أَذْنَابُ الْخَيْلِ الشُّمْسِ ، اسْكُنُوا فِي الصَّلَاةِ  .         [10/204]","","Musnad al-Bazzar 4291","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن سفيان الثوري عن يزيد بن أبي حكيم الكناني عن أحمد بن منصور الرمادي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4299","4292  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  الْمُسَيِّبِ بْنِ رَافِعٍ ،  عَنْ  تَمِيمِ بْنِ طَرَفَةَ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا بِرِوَايَةِ  جَابِرِ بْنِ سَمُرَةَ  عَنْهُ ،  وَمَعْنَاهُ عِنْدَنَا : أَنَّ  الْقَوْمَ  كَانُوا  يُشِيرُونَ  بِأَيْدِيهِمْ بِالصَّلَاةِ عَنْ يَمِينٍ وَشِمَالٍ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" اسْكُنُوا فِي الصَّلَاةِ  "" .","","Musnad al-Bazzar 4292","","جابر بن سمرة السوائي عن تميم بن طرفة المذحجي عن المسيب بن رافع الكاهلي عن الأعمش عن أبو معاوية الضرير عن أبو موسى الزمن عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4300","4293  -  حَدَّثَنَا  أَحْمَدُ بْنُ عِيسَى الْكُوفِيُّ ، قَالَ :  نَا  عُمَرُ بْنُ حَفْصِ بْنِ غِيَاثٍ ، قَالَ :  نَا  أَبِي ،  قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ  ، عَنْ  جَابِرِ بْنِ سَمُرَةَ أَوْ رَجُلٍ مِنْ أَصْحَابِ النَّبِيِّ -  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَرْعَى غَنَمًا  ، ثُمَّ كَانَ يَرْعَى الْإِبِلَ مَعَ شَرِيكٍ لَهُ قَدِ اكْتَرَتْهُمَا  أُخْتُ خَدِيجَةَ  ، فَلَمَّا قَضَوُا السَّفَرَ بَقِيَ عَلَيْهِمَا شَيْءٌ ، فَجَعَلَ شَرِيكُهُ يَأْتِيهِمْ فَيَتَقَاضَاهُمْ ، وَيَقُولُ  لِمُحَمَّدٍ  : انْطَلِقْ ، فَيَقُولُ : "" اذْهَبْ أَنْتَ فَإِنِّي         [10/205]      أَسْتَحِي "" فَقَالَتْ لَهُ مَرَّةً - يَعْنِي الشَّرِيكَ - وَأَتَاهُمْ : فَأَيْنَ  مُحَمَّدٌ  لَا يَجِيءُ مَعَكَ ؟ قَالَ : قَدْ قُلْتُ لَهُ فَذَكَرَ أَنَّهُ يَسْتَحِي ، قَالَ : فَذَكَرَتْ ذَلِكَ لِأُخْتِهَا  خَدِيجَةَ  ، فَقَالَتْ : مَا رَأَيْتُ أَحَدًا قَطُّ أَشَدَّ حَيَاءً وَلَا أَعَفَّ مِنْ  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَوَقَعَ فِي نَفْسِ أُخْتِهَا  خَدِيجَةَ  ، فَبَعَثَتْ إِلَيْهِ ، فَقَالَتِ : ائْتِ أَبِي فَاخْطُبْ إِلَيْهِ ، فَقَالَ : "" أَبُوكِ رَجُلٌ كَثِيرُ الْمَالِ وَهُوَ "" - أَحْسَبُهُ قَالَ - "" لَا يَفْعَلُ "" قَالَتْ : فَانْطَلِقْ ، فَأَلْقِ كَلِمَةً فَإِنِّي أَكْفِيكَ ، وَأْتِهِ عِنْدَ سُكْرِهِ ، فَفَعَلَ ، فَأَتَاهُ فَزَوَّجَهُ ، فَلَمَّا أَصْبَحَ جَلَسَ فِي النَّاسِ فَقِيلَ لَهُ : قَدْ أَحْسَنْتَ ، زَوَّجْتَ  مُحَمَّدًا  ، قَالَ : وَفَعَلْتُ ؟ ! قَالُوا : نَعَمْ ، فَقَامَ فَدَخَلَ عَلَيْهَا ، فَقَالَ : إِنَّ النَّاسَ يَقُولُونَ : إِنِّي زَوَّجْتُ  مُحَمَّدًا  وَمَا فَعَلْتُ . قَالَتْ : بَلَى ، فَلَا تُسَفِّهَنَّ ؛ فَإِنَّ  مُحَمَّدًا  كَذَا وَكَذَا ، فَلَمْ تَزَلْ بِهِ حَتَّى رَضِيَ ، ثُمَّ بَعَثَتْ إِلَى  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِأُوقِيَّتَيْنِ مِنْ  فِضَّةٍ أَوْ ذَهَبٍ  ، فَقَالَتِ : اشْتَرِ  حُلَّةً  فَأَهْدِهَا إِلَيْهِ وَكَذَا وَكَذَا . قَالَ وَأَحْسَبُهُ فَعَلَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  جَابِرِ بْنِ سَمُرَةَ  ، وَلَا نَعْلَمُ  أَسْنَدَ  هَذَا الْحَدِيثَ عَنْ  جَابِرٍ  إِلَّا  عُمَرُ بْنُ حَفْصٍ  ، عَنْ أَبِيهِ ، عَنِ  الْأَعْمَشِ  ، عَنْ  أَبِي خَالِدٍ  ، عَنْ  جَابِرٍ  ، وَقَدْ رَوَاهُ غَيْرُ  عُمَرَ بْنِ حَفْصٍ  ، عَنِ  الْأَعْمَشِ  ،         [10/206]      عَنْ  أَبِي خَالِدٍ  مُرْسَلًا  ، وَقَدْ رُوِيَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي تَزْوِيجِهِ  خَدِيجَةَ  أَحَادِيثُ بِأَلْفَاظٍ مُخْتَلِفَةٍ ، نَذْكُرُ كُلَّ حَدِيثٍ مِنْهَا بِلَفْظِهِ فِي مَوْضِعِهِ إِنْ شَاءَ اللهُ .","","Musnad al-Bazzar 4293","","أحد الصحابة عن أبو خالد الوالبي عن الأعمش عن حفص بن غياث النخعي عن عمر بن حفص بن غياث عن أبو حريش أحمد بن عيسى الكوفي عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4301","4294  -  حَدَّثَنَا  أَبُو كُرَيْبٍ ، قَالَ :  نَا  عَثَّامُ بْنُ عَلِيٍّ - فِيمَا أَحْسَبُ  -  عَنِ  الْأَعْمَشِ ،  عَنْ  أَبِي خَالِدٍ الْوَالِبِيِّ ،  عَنْ  جَابِرِ بْنِ سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ كَهَذِهِ مِنْ هَذِهِ  .  وَهَذَا الْحَدِيثُ رَوَاهُ فِطْرٌ ، عَنْ  أَبِي خَالِدٍ  ، عَنْ  جَابِرِ بْنِ سَمُرَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَهَذِهِ مِنْ هَذِهِ ، وَأَشَارَ بِأُصْبُعَيْهِ  .","","Musnad al-Bazzar 4294","","جابر بن سمرة السوائي عن أبو خالد الوالبي عن الأعمش عن عثام بن علي الوحيدي عن أبو كريب محمد بن العلاء عن البزار","مسند جابر بن سمرة رضي الله عنه"
"4302","[10/207]      مُسْنَدُ  زَيْدِ بْنِ أَرْقَمَ  رَضِيَ اللهُ عَنْهُ         [10/208]             [10/209]      مَا  أَسْنَدَ  زَيْدُ بْنُ أَرْقَمَ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  4295  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَانِئٍ ، قَالَ :  نَا  عَفَّانُ ، قَالَ :  نَا  حَمَّادُ بْنُ سَلَمَةَ ، قَالَ :  أَنَا  قَيْسُ بْنُ سَعْدٍ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّهُ قَالَ لِزَيْدِ بْنِ أَرْقَمَ :  أَمَا عَلِمْتَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُهْدِيَ لَهُ عُضْوٌ مِنْ صَيْدٍ وَهُوَ مُحْرِمٌ  فَلَمْ يَقْبَلْهُ ؟ قَالَ : بَلَى  .  وَلَا نَعْلَمُ  أَسْنَدَ  ابْنُ عَبَّاسٍ  ، عَنْ  زَيْدٍ  غَيْرَ هَذَا الْحَدِيثِ .","","Musnad al-Bazzar 4295","","زيد بن أرقم الأنصاري عن عبد الله بن عباس عن عطاء بن أبي رباح عن قيس بن سعد الحبشي عن حماد بن سلمة عن عفان بن مسلم الصفار عن إبراهيم بن هانئ الأغياني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4303","4296  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  الضَّحَّاكُ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَدِمَ زَيْدُ بْنُ أَرْقَمَ ، فَقَالَ لَهُ  ابْنُ عَبَّاسٍ  يَسْتَذْكِرُهُ : كَيْفَ أَخْبَرْتَنِي عَنْ لَحْمِ الصَّيْدِ الَّذِي أُهْدِيَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ حَرَامٌ ؟  قَالَ  : نَعَمْ ، أُهْدِيَ لَهُ رِجْلُ أَوْ عُضْوُ لَحْمِ صَيْدٍ فَرَدَّهُ ، وَقَالَ :  إِنَّا لَا نَأْكُلُهُ ، إِنَّا حُرُمٌ  .","","Musnad al-Bazzar 4296","","زيد بن أرقم الأنصاري عن عبد الله بن عباس عن طاوس بن كيسان عن الحسن بن مسلم بن يناق عن ابن جريج عن أبو عاصم النبيل عن أبو موسى الزمن عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4304","[10/210]      4297  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  أَبِي عَبْدِ اللهِ الشَّامِيِّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ :  أَخْبَرَنِي  الْأَنْصَارِيُّ - يَعْنِي - زَيْدَ بْنَ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا تَزَالُ  طَائِفَةٌ  مِنْ أُمَّتِي عَلَى الْحَقِّ  ، قَالَ : فَإِنِّي لَأَرْجُو أَنْ تَكُونُوا أَنْتُمْ يَا  أَهْلَ الشَّامِ  .  قَالَ أَبُو بَكْرٍ ،  وَلَا نَعْلَمُ  أَسْنَدَ  مُعَاوِيَةُ  عَنْ  زَيْدٍ  إِلَّا هَذَا         [10/211]      الْحَدِيثَ ،  وَأَبُو عَبْدِ اللهِ الشَّامِيُّ  فَلَمْ أَسْمَعْ أَحَدًا سَمَّاهُ ، وَلَا نَعْلَمُ رَوَى عَنْهُ إِلَّا  شُعْبَةُ  .","","Musnad al-Bazzar 4297","","زيد بن أرقم الأنصاري عن معاوية بن أبي سفيان عن أبو عبد الله عن شعبة بن الحجاج عن أبو داود الطيالسي عن محمد بن بشار بندار عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4305","4298  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  يَحْيَى بْنُ حَمَّادٍ ، قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ كُنْتُ  مَوْلَاهُ  فَعَلِيٌّ  مَوْلَاهُ  ، اللَّهُمَّ وَالِ مَنْ وَالَاهُ ، وَعَادِ مَنْ عَادَاهُ  .","","Musnad al-Bazzar 4298","","زيد بن أرقم الأنصاري عن عامر بن واثلة عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن الوضاح بن عبد الله اليشكري عن يحيى بن حماد بن أبي زياد الشيباني عن أبو موسى الزمن عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4306","[10/212]      4299  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَانِئٍ ، قَالَ :  نَا  عَلِيُّ بْنُ حَكِيمٍ ، قَالَ :  نَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ وَهْبٍ ،  وَعَنْ  زَيْدِ بْنِ يُثَيْعٍ ، قَالَا :  نَشَدَ  عَلِيٌّ النَّاسَ فِي  الرَّحَبَةِ  مَنْ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ غَدِيرِ  خُمٍّ  فَقَامَ سِتَّةٌ فَشَهِدُوا أَنَّهُمْ سَمِعُوا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ يَوْمَ غَدِيرِ  خُمٍّ :  "" أَلَسْتُ أَوْلَى بِالْمُؤْمِنِينَ "" قَالُوا : بَلَى ، قَالَ : "" أَوَلَسْتُ أَوْلَى بِكُمْ مِنْ أَنْفُسِكُمْ "" قَالُوا : بَلَى ، قَالَ :  اللَّهُمَّ مَنْ كُنْتُ  مَوْلَاهُ  فَعَلِيٌّ  مَوْلَاهُ  ، اللَّهُمَّ وَالِ مَنْ وَالَاهُ ، وَعَادِ مَنْ عَادَاهُ  .         [10/213]             [10/214]","","Musnad al-Bazzar 4299","","علي بن أبي طالب عن زيد بن يثيع الهمداني عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن علي بن حكيم بن ذبيان عن إبراهيم بن هانئ الأغياني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4307","4300  - قَالَ  وَحَدَّثَنَاهُ  إِبْرَاهِيمُ بْنُ هَانِئٍ ، قَالَ :  نَا  عَلِيُّ بْنُ حَكِيمٍ ، قَالَ :  نَا  شَرِيكٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Musnad al-Bazzar 4300","","زيد بن أرقم الأنصاري عن عامر بن واثلة عن حبيب بن أبي ثابت الكاهلي عن الأعمش عن شريك بن عبد الله النخعي عن علي بن حكيم بن ذبيان عن إبراهيم بن هانئ الأغياني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4308","4301  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  ثُمَامَةَ بْنِ عُقْبَةَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ  جَاءَ  رَجُلٌ مِنَ الْيَهُودِ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا  أَبَا الْقَاسِمِ ،  تَزْعُمُ أَنَّ أَهْلَ الْجَنَّةِ يَأْكُلُونَ وَيَشْرَبُونَ ، فَقَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ إِنَّ الرَّجُلَ مِنْهُمْ لَيُؤْتَى قُوَّةَ مِائَةِ رَجُلٍ فِي الْأَكْلِ وَالشُّرْبِ وَالْجِمَاعِ وَالشَّهْوَةِ  قَالَ : فَإِنَّ الَّذِي يَأْكُلُ وَيَشْرَبُ تَكُونُ لَهُ الْحَاجَةُ ؟ قَالَ : "" عَرَقٌ يَفِيضُ مِثْلَ رِيحِ الْمِسْكِ ، فَإِذَا كَانَ ذَلِكَ ضَمُرَ لَهُ بَطْنُهُ  .         [10/215]","","Musnad al-Bazzar 4301","","زيد بن أرقم الأنصاري عن ثمامة بن عقبة المحلمي عن الأعمش عن أبو معاوية الضرير عن الفلاس عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4309","4302  - ، قَالَ :  نَا  الْحَسَنُ بْنُ يَحْيَى ، قَالَ :  نَا  يَعْلَى ،  عَنِ  الْأَعْمَشِ ،  عَنْ  ثُمَامَةَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَقَالَ غَيْرُ  أَبِي مُعَاوِيَةَ  :  وَيَعْلَى  ، عَنِ  الْأَعْمَشِ  ، عَنْ  يَزِيدَ بْنِ حَيَّانَ  ، عَنْ  زَيْدِ بْنِ أَرْقَمَ  .","","Musnad al-Bazzar 4302","","زيد بن أرقم الأنصاري عن ثمامة بن عقبة المحلمي عن الأعمش عن يعلى بن عبيد الطنافسي عن الحسن بن يحيى الرزي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4310","4303  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ :  نَا  جَرِيرٌ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  ثُمَامَةَ بْنِ عُقْبَةَ الْمُحَلِّمِيِّ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ .","","Musnad al-Bazzar 4303","","زيد بن أرقم الأنصاري عن ثمامة بن عقبة المحلمي عن الأعمش عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4311","4304  -  وَحَدَّثَنَاهُ  إِبْرَاهِيمُ بْنُ هَانِئٍ ، وَالْحَسَنُ بْنُ يَحْيَى ، قَالَ :  نَا         [10/216]      مُوسَى بْنُ مَسْعُودٍ ،  عَنْ  سُفْيَانَ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  ثُمَامَةَ بْنِ عُقْبَةَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  عَقَدَ  رَجُلٌ مِنَ الْأَنْصَارِ  لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عُقَدًا ، فَكَانَ يَأْلَمُ ذَلِكَ ، فَجَاءَهُ الْمَلَكَانِ يَعُودَانِهِ  ، فَقَالَ أَحَدُهُمَا لِصَاحِبِهِ : تَدْرِي مَا بِهِ ؟ عَقَدَ لَهُ فُلَانٌ الْأَنْصَارِيُّ عُقَدًا فَرَمَى بِهِ فِي بِئْرِ كَذَا وَكَذَا ، فَلَوْ أَخْرَجَهُ فَرَمَى بِهِ عُوفِيَ ، فَبُعِثُوا إِلَى الْبِئْرِ ، فَوَجَدُوا الْمَاءَ قَدِ اخْضَرَّ ، فَأَخْرَجُوهُ فَرَمَوْا بِهِ ، فَعُوفِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَا رُئِيَ فِي وَجْهِهِ ، وَلَا حُدِثَ بِهِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  زَيْدِ بْنِ أَرْقَمَ  إِلَّا  ثُمَامَةُ بْنُ عُقْبَةَ  ، وَلَا نَعْلَمُ أَحَدًا حَدَّثَ بِهِ إِلَّا  الْأَعْمَشُ  عَنْهُ ، وَلَا نَعْلَمُ حَدَّثَ  الْأَعْمَشُ         [10/217]      عَنْ  ثُمَامَةَ  إِلَّا هَذَيْنِ الْحَدِيثَيْنِ .","","Musnad al-Bazzar 4304","","زيد بن أرقم الأنصاري عن ثمامة بن عقبة المحلمي عن الأعمش عن سفيان الثوري عن موسى بن مسعود النهدي عن الحسن بن يحيى الرزي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4312","4305  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنِ  السُّدِّيِّ ،  عَنْ  أَبِي سَعْدٍ الْأَزْدِيِّ ، قَالَ :  نَا  زَيْدُ بْنُ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  غَزَوْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَنَا نَاسٌ مِنَ الْأَعْرَابِ ، فَكُنَّا نَبْتَدِرُ الْمَاءَ  ، فَكَانَ الْأَعْرَابُ يَسْبِقُونَنَا ، فَيَسْبِقُ الْأَعْرَابِيُّ أَصْحَابَهُ ، فَيَمْلَأُ الْحَوْضَ ، يَجْعَلُ حَوْلَهُ حِجَارَةً ، وَيَجْعَلُ النِّطْعَ عَلَيْهِ حَتَّى يَجِيءَ أَصْحَابُهُ . قَالَ : فَأَتَى  رَجُلٌ مِنَ الْأَنْصَارِ  أَعْرَابِيًّا ،  فَأَدْخَلَ  زِمَامَ  نَاقَتِهِ لِتَشْرَبَ ، فَأَبَى أَنْ يَدَعَهُ ، فَانْتَزَعَ حَجَرًا فَغَاصَ الْمَاءُ ، فَرَفَعَ الْأَعْرَابِيُّ خَشَبَةً ، فَضَرَبَ بِهَا رَأْسَ الْأَنْصَارِيِّ  فَشَجَّهُ  ، فَأَتَى  عَبْدَ اللهِ بْنَ أُبَيٍّ ابْنَ سَلُولَ  رَأْسَ الْمُنَافِقِينَ فَأَخْبَرَهُ ، وَكَانَ مِنْ أَصْحَابِهِ فَغَضِبَ  عَبْدُ اللهِ بْنُ أُبَيٍّ  ، وَقَالَ : لَا تُنْفِقُوا عَلَى مَنْ عِنْدِ رَسُولِ اللهِ ; حَتَّى يَنْفَضُّوا مِنْ حَوْلِهِ - يَعْنِي : الْأَعْرَابَ - وَكَانُوا يَحْضُرُونَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ الطَّعَامِ ، فَقَالَ  عَبْدُ اللهِ  لِأَصْحَابِهِ : إِذَا انْفَضُّوا مِنْ عِنْدِ  مُحَمَّدٍ  فَأْتُوا  مُحَمَّدًا  بِالطَّعَامِ ، فَلْيَأْكُلْ هُوَ وَمَنْ عِنْدَهُ ، ثُمَّ قَالَ لِأَصْحَابِهِ : إِذَا رَجَعْتُمُ  الْمَدِينَةَ         [10/218]      فَلَيُخْرِجَنَّ الْأَعَزُّ مِنْكُمُ الْأَذَلَّ . قَالَ  زَيْدٌ  : وَأَنَا رِدْفُ عَمِّي ، فَسَمِعْتُ  عَبْدَ اللهِ بْنَ أُبَيٍّ  ، وَكُنَّا أَخْوَالَهُ ، فَأَخْبَرْتُ عَمِّي ، فَانْطَلَقَ فَأَخْبَرَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَرْسَلَ إِلَيْهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَحَلَفَ وَجَحَدَ ، فَصَدَّقَهُ وَكَذَّبَنِي ، فَجَاءَ إِلَيَّ عَمِّي ، فَقَالَ : مَا أَرَدْتُ أَنْ قَبِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَوْلَهُ وَكَذَّبَكَ ، وَكَذَّبَكَ الْمُسْلِمُونَ ، قَالَ : فَوَقَعَ عَلَيَّ مِنَ الْهَمِّ مَا لَمْ يَقَعْ عَلَى أَحَدٍ قَطُّ ، قَالَ : فَبَيْنَا أَنَا أَسِيرُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ فَأَخْفَقْتُ بِرَأْسِي مِنَ الْهَمِّ ، فَأَتَانِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَعَرَكَ أُذُنِي وَضَحِكَ فِي وَجْهِي ، فَمَا كَانَ يَسُرُّنِي أَنَّ لِي بِهَا  الْمُلْكَ أَوِ الدُّنْيَا  ، ثُمَّ إِنَّ  أَبَا بَكْرٍ  لَحِقَنِي ، فَقَالَ : مَا قَالَ لَكَ رَسُولُ اللهِ ؟ قُلْتُ : مَا قَالَ لِي شَيْئًا إِلَّا أَنَّهُ عَرَكَ فِي أُذُنِي وَضَحِكَ فِي وَجْهِي ، فَقَالَ : أَبْشِرْ ، ثُمَّ لَحِقَنِي  عُمَرُ  ، فَقَالَ لِي مِثْلَ قَوْلِ  أَبِي بَكْرٍ ،  فَلَمَّا أَصْبَحْنَا قَرَأَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُورَةَ الْمُنَافِقِينَ  .","","Musnad al-Bazzar 4305","","زيد بن أرقم الأنصاري عن أبو سعد الأزدي عن السدي الكبير عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4313","[10/219]      4306  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنِ  الْحَكَمِ ، قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ كَعْبٍ الْقُرَظِيَّ ، قَالَ :  سَمِعْتُ  زَيْدَ بْنَ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي غَزْوَةٍ ، فَقَالَ  عَبْدُ اللهِ بْنُ أُبَيٍّ  : لَئِنْ رَجَعْنَا إِلَى  الْمَدِينَةِ  لَيُخْرِجَنَّ الْأَعَزُّ مِنْهَا الْأَذَلَّ . فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرْتُهُ ، فَقَالَ لِي قَوْمِي . مَا أَرَدْتُ إِلَى هَذَا ، فَرَجَعْتُ فَنِمْتُ كَئِيبًا حَزِينًا ، وَجَاءَ  عَبْدُ اللهِ بْنُ أُبَيٍّ  فَحَلَفَ ، فَرَجَعْتُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِنَّ اللهَ قَدْ صَدَّقَكَ  وَأَنْزَلَ اللهُ تَبَارَكَ وَتَعَالَى :         {      هُمُ الَّذِينَ يَقُولُونَ لا تُنْفِقُوا عَلَى مَنْ عِنْدَ رَسُولِ اللهِ حَتَّى يَنْفَضُّوا وَلِلَّهِ خَزَائِنُ السَّمَاوَاتِ وَالأَرْضِ وَلَكِنَّ الْمُنَافِقِينَ لا يَفْقَهُونَ         }      .         [10/220]      وَهَذَا الْكَلَامُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ إِلَّا  زَيْدُ بْنُ أَرْقَمَ  ، وَلَا نَعْلَمُ  أَسْنَدَ  مُحَمَّدُ بْنُ كَعْبٍ  عَنْ  زَيْدٍ  غَيْرَ هَذَا الْحَدِيثِ ، وَلَا  أَسْنَدَ  أَبُو سَعْدٍ  عَنْ  زَيْدٍ  غَيْرَ هَذَا الْحَدِيثِ  .","","Musnad al-Bazzar 4306","","زيد بن أرقم الأنصاري عن محمد بن كعب بن سليم القرظي عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4314","4307  -  حَدَّثَنَا  أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  أَبِي عُثْمَانَ ، وَعَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ  أَلَا أُعَلِّمُكُمْ مَا كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُعَلِّمُنَا  اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْعَجْزِ وَالْكَسَلِ ، وَالْبُخْلِ وَالْجُبْنِ ،  وَالْهَرَمِ  وَعَذَابِ الْقَبْرِ  ، اللَّهُمَّ آتِ أَنْفُسَنَا تَقْوَاهَا ، أَنْتَ خَيْرُ مَنْ زَكَّاهَا ، أَنْتَ وَلِيُّهَا وَمَوْلَاهَا ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ قَلْبٍ لَا يَخْشَعُ ، وَنَفْسٍ لَا تَشْبَعُ ، وَعِلْمٍ لَا يَنْفَعُ ، وَدَعْوَةٍ لَا يُسْتَجَابُ لَهَا  .","","Musnad al-Bazzar 4307","","زيد بن أرقم الأنصاري عن أبو عثمان النهدي عن عاصم بن سليمان الأحول عن أبو معاوية الضرير عن أبو كريب محمد بن العلاء عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4315","[10/221]      4308  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْقُرَشِيُّ ، قَالَ :  نَا  عَبْدُ الْوَاحِدِ بْنِ زِيَادٍ ،  عَنْ  عَاصِمٍ الْأَحْوَلِ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِهِ .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  زَيْدِ بْنِ أَرْقَمَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ أَحَدًا جَمَعَ  أَبَا عُثْمَانَ  وَعَبْدَ اللهِ بْنَ الْحَارِثِ  إِلَّا  مُعَاوِيَةُ  عَنْ  عَاصِمٍ  .","","Musnad al-Bazzar 4308","","زيد بن أرقم الأنصاري عن عبد الله بن الحارث الأنصاري عن عاصم بن سليمان الأحول عن عبد الواحد بن زياد عن محمد بن عبد الله بن المبارك المخرمي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4316","4309  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنِ  النَّضْرِ بْنِ أَنَسٍ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  اللَّهُمَّ اغْفِرْ  لِلْأَنْصَارِ  ، وَلِأَبْنَاءِ  الْأَنْصَارِ  ، وَلِأَبْنَاءِ أَبْنَاءِ  الْأَنْصَارِ  .","","Musnad al-Bazzar 4309","","زيد بن أرقم الأنصاري عن النضر بن أنس بن مالك الأنصاري عن قتادة بن دعامة عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4317","[10/222]      4310  -  وَحَدَّثَنَا  زِيَادُ بْنُ أَيُّوبَ ، قَالَ :  نَا  هُشَيْمٌ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  النَّضْرِ بْنِ أَنَسٍ أَنَّ أَنَسَ بْنَ مَالِكٍ  كَتَبَ إِلَيْهِ  زَيْدُ بْنُ أَرْقَمَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  اللَّهُمَّ اغْفِرْ  لِلْأَنْصَارِ  ، وَلِأَبْنَاءِ  الْأَنْصَارِ  ، وَلِأَبْنَاءِ أَبْنَاءِ  الْأَنْصَارِ  .","","Musnad al-Bazzar 4310","","زيد بن أرقم الأنصاري عن أنس بن مالك عن النضر بن أنس بن مالك الأنصاري عن علي بن زيد بن جدعان عن هشيم بن بشير عن دلويه زياد بن أيوب عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4318","4311  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ يَعْمَرَ ، قَالَ :  نَا  أَبُو دَاوُدَ ،  قَالَ  : شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  النَّضْرِ بْنِ أَنَسٍ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمِثْلِهِ .         [10/223]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  قَتَادَةَ  ، عَنِ  النَّضْرِ بْنِ أَنَسٍ  ، عَنْ  زَيْدٍ  أَوْثَقَ مِنْ  شُعْبَةَ  ، وَقَدْ  تَابَعَهُ  عَلَى رِوَايَتِهِ غَيْرُ وَاحِدٍ فَاجْتَزَأْنَا  بِشُعْبَةَ  ، وَخَالَفَهُ  مَعْمَرٌ  فَقَالَ : عَنْ  قَتَادَةَ  ، عَنِ  النَّضْرِ بْنِ أَنَسٍ  ، عَنْ  أَنَسٍ  .","","Musnad al-Bazzar 4311","","زيد بن أرقم الأنصاري عن النضر بن أنس بن مالك الأنصاري عن علي بن زيد بن جدعان عن شعبة بن الحجاج عن أبو داود الطيالسي عن محمد بن يعمر عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4319","4312  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنِ  النَّضْرِ بْنِ أَنَسٍ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ هَذِهِ  الْحُشُوشَ  مُحْتَضَرَةٌ  ، فَإِذَا أَتَى أَحَدُكُمُ الْخَلَاءَ فَلْيَقُلْ : أَعُوذُ بِاللهِ مِنَ  الْخُبُثِ  وَالْخَبَائِثِ  .","","Musnad al-Bazzar 4312","","زيد بن أرقم الأنصاري عن النضر بن أنس بن مالك الأنصاري عن قتادة بن دعامة عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4320","4313  -  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ، قَالَ :  نَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ :  نَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْقَاسِمِ الشَّيْبَانِيِّ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ ، عَنِ         [10/224]      النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَهَذَا الْحَدِيثُ قَدِ اخْتَلَفُوا فِي  إِسْنَادِهِ  عَنْ  قَتَادَةَ  ، فَقَالَ :  شُعْبَةُ  ، عَنْ  قَتَادَةَ  ، عَنِ  النَّضْرِ  ، عَنْ  زَيْدٍ  ، وَقَالَ  مَعْمَرٌ  : عَنْ  قَتَادَةَ  ، عَنِ  النَّضْرِ بْنِ أَنَسٍ  ، عَنْ أَبِيهِ ، وَقَالَ  ابْنُ أَبِي عَرُوبَةَ  : عَنْ  قَتَادَةَ  ، عَنِ  الْقَاسِمِ بْنِ عَوْفٍ الشَّيْبَانِيِّ  ، عَنْ  زَيْدٍ  ، وَقَالَ  حُسَامُ بْنُ مِصَكٍّ  : عَنْ  قَتَادَةَ  ، عَنِ  الْقَاسِمِ بْنِ رَبِيعَةَ  ، عَنْ  زَيْدِ بْنِ أَرْقَمَ  .","","Musnad al-Bazzar 4313","","زيد بن أرقم الأنصاري عن القاسم بن عوف الشيباني عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن العباس بن الوليد النرسي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4321","4314  -  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ ، قَالَ :  نَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ :  نَا  سَعِيدٌ - يَعْنِي - ابْنَ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْقَاسِمِ الشَّيْبَانِيِّ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ ، عَنِ النَّبِيِّ - عَلَيْهِ السَّلَامُ - .","","Musnad al-Bazzar 4314","","زيد بن أرقم الأنصاري عن القاسم بن عوف الشيباني عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن العباس بن الوليد النرسي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4322","4315  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  رَوْحُ بْنُ عُبَادَةَ ،  عَنْ         [10/225]      سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْقَاسِمِ الشَّيْبَانِيِّ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ مَرَّ  بِمَسْجِدِ قُبَاءَ  فَوَجَدَهُمْ يُصَلُّونَ بَعْدَ مَا أَشْرَقَتِ الشَّمْسُ ، فَقَالَ :  صَلَاةُ  الْأَوَّابِينَ  كَانُوا يُصَلُّونَهَا إِذَا  رَمِضَتِ  الْفِصَالُ  .","","Musnad al-Bazzar 4315","","زيد بن أرقم الأنصاري عن القاسم بن عوف الشيباني عن قتادة بن دعامة عن سعيد بن أبي عروبة عن روح بن عبادة القيسي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4323","4316  -  حَدَّثَنَا  مُؤَمَّلُ بْنُ هِشَامٍ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ، قَالَ :  نَا  أَيُّوبُ ،  عَنِ  الْقَاسِمِ الشَّيْبَانِيِّ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ -  أَنَّهُ رَأَى قَوْمًا يُصَلُّونَ مِنَ الضُّحَى فِي  مَسْجِدِ قُبَاءَ  ، فَقَالَ : أَمَا عَلِمُوا أَنَّ الصَّلَاةَ فِي غَيْرِ هَذِهِ السَّاعَةِ أَفْضَلُ ؟ إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  صَلَاةُ  الْأَوَّابِينَ  حِينَ تَرْمَضُ الْفِصَالُ  .         [10/226]      وَهَذَا الْحَدِيثُ بِهَذَا اللَّفْظِ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ إِلَّا  زَيْدُ بْنُ أَرْقَمَ  ، وَلَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  زَيْدٍ  إِلَّا  الْقَاسِمُ بْنُ عَوْفٍ الشَّيْبَانِيُّ  .","","Musnad al-Bazzar 4316","","زيد بن أرقم الأنصاري عن القاسم بن عوف الشيباني عن أيوب السختياني عن إسماعيل ابن علية عن مؤمل بن هشام اليشكري عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4324","4317  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ ابْنُ أَخِي مُحَمَّدِ بْنِ سَوَاءٍ  ، قَالَ :  نَا  مُحَمَّدُ بْنُ سَوَاءٍ ، قَالَ :  نَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْقَاسِمِ الشَّيْبَانِيِّ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ ""  إِذَا دَعَا الرَّجُلُ امْرَأَتَهُ فَلْتُجِبْ  ، وَإِنْ كَانَتْ عَلَى ظَهْرِ  قَتَبٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ بِهَذَا اللَّفْظِ إِلَّا  زَيْدُ بْنُ أَرْقَمَ  ، وَلَا نَعْلَمُ أَحَدًا حَدَّثَ بِهِ عَنْ  سَعِيدٍ  عَنْ  قَتَادَةَ  إِلَّا  مُحَمَّدُ بْنُ سَوَاءٍ  .  كذا في طبعة مكتبة العلوم والحكم وكشف الأستار ، والصواب : (محمد بن ثعلبة ابن أخي محمد بن سواء) كما في مجمع الزوائد ، ومختصر زوائد مسند البزار .","","Musnad al-Bazzar 4317","","زيد بن أرقم الأنصاري عن القاسم بن عوف الشيباني عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن سواء السدوسي عن محمد بن ثعلبة السدوسي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4325","4318  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَانِئٍ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ يَزِيدَ الدِّمَشْقِيُّ ، قَالَ :  نَا  صَدَقَةُ بْنُ عَبْدِ اللهِ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ         [10/227]      قَتَادَةَ ،  عَنِ  الْقَاسِمِ الشَّيْبَانِيِّ ، وَهُوَ ابْنُ عَوْفٍ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  بَعَثَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  مُعَاذَ بْنَ جَبَلٍ  إِلَى  الشَّامِ  ، فَلَمَّا قَدِمَ  مُعَاذٌ  ، قَالَ : يَا رَسُولَ اللهِ ، إِنِّي رَأَيْتُ أَهْلَ الْكِتَابِ يَسْجُدُونَ لِأَسَاقِفَتِهِمْ  وَبَطَارِقَتِهِمْ  أَفَلَا نَسْجُدُ لَكَ ؟ قَالَ :  لَا ، وَلَوْ كُنْتُ آمِرًا أَحَدًا أَنْ يَسْجُدَ لِأَحَدٍ لَأَمَرْتُ الْمَرْأَةَ أَنْ تَسْجُدَ لِزَوْجِهَا  .","","Musnad al-Bazzar 4318","","زيد بن أرقم الأنصاري عن القاسم بن عوف الشيباني عن قتادة بن دعامة عن سعيد بن أبي عروبة عن صدقة بن عبد الله السمين عن عبد الله بن يزيد الدمشقي عن إبراهيم بن هانئ الأغياني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4326","4319  -  وَحَدَّثَنَاهُ  عُمَرُ بْنُ الْخَطَّابِ ، قَالَ :  نَا  أَبُو حَفْصٍ التِّنِّيسِيُّ ، قَالَ :  نَا  صَدَقَةُ - يَعْنِي - ابْنَ عَبْدِ اللهِ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْقَاسِمِ الشَّيْبَانِيِّ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَهَذَا الْحَدِيثُ قَدِ اخْتُلِفَ فِيهِ عَنِ  الْقَاسِمِ الشَّيْبَانِيِّ  ، فَقَالَ  أَيُّوبُ  : عَنِ  الْقَاسِمِ بْنِ أَبِي أَوْفَى  .         [10/228]      وَقَالَ  قَتَادَةُ  : عَنِ  الْقَاسِمِ  ، عَنْ  زَيْدِ بْنِ أَرْقَمَ  ، وَقَالَ  هِشَامٌ  : عَنِ  الْقَاسِمِ الشَّيْبَانِيِّ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  ، عَنْ  مُعَاذٍ  .  وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ عَنْ  أَبِي عَرُوبَةَ  إِلَّا  صَدَقَةُ  ،  وَصَدَقَةُ  لَيْسَ بِالْقَوِيِّ  فِي الْحَدِيثِ ، وَقَدْ  كَتَبَ أَهْلُ الْعِلْمِ حَدِيثَهُ  .","","Musnad al-Bazzar 4319","","زيد بن أرقم الأنصاري عن القاسم بن عوف الشيباني عن قتادة بن دعامة عن سعيد بن أبي عروبة عن صدقة بن عبد الله السمين عن عمرو بن أبي سلمة التنيسي عن عمر بن الخطاب السجستاني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4327","4320  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ :  نَا  أَبُو غَسَّانَ ،  قَالَ  : أَسْبَاطُ بْنُ         [10/229]      نَصْرٍ ،  عَنِ  السُّدِّيِّ ،  عَنْ  صُبَيْحٍ مَوْلَى أُمِّ سَلَمَةَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ قَالَ  لِعَلِيٍّ  وَفَاطِمَةَ  وَالْحَسَنِ  وَالْحُسَيْنِ  - رَضِيَ اللهُ عَنْهُمْ - :  أَنَا حَرْبٌ لِمَنْ حَارَبْتُمْ ، سِلْمٌ لِمَنْ  سَالَمْتُمْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  زَيْدُ بْنُ أَرْقَمَ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  زَيْدٍ  إِلَّا هَذَا الطَّرِيقَ ،  وَصُبَيْحٌ مَوْلَى أُمِّ سَلَمَةَ  لَا نَعْلَمُ حَدَّثَ عَنْهُ إِلَّا  السُّدِّيُّ  .","","Musnad al-Bazzar 4320","","زيد بن أرقم الأنصاري عن صبيح مولى أم سلمة عن السدي الكبير عن أسباط بن نصر الهمداني عن مالك بن إسماعيل النهدي عن يوسف بن موسى بن راشد عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4328","4321  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ، قَالَ :  كَانَ زَيْدُ بْنُ         [10/230]      أَرْقَمَ يُصَلِّي عَلَى جَنَائِزِنَا ، فَيُكَبِّرُ أَرْبَعًا ، فَكَبَّرَ يَوْمًا خَمْسًا ،  فَسَأَلْنَاهُ  عَنْ ذَلِكَ ، فَقَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَبَّرَ خَمْسًا  .","","Musnad al-Bazzar 4321","","زيد بن أرقم الأنصاري عن عبد الرحمن بن أبي ليلى عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4329","4322  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ ، قَالَ :  نَا  خَالِدُ بْنُ عَمْرٍو الْقُرَشِيُّ ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  عَبْدِ الْأَعْلَى         [10/231]      الثَّعْلَبِيِّ ، قَالَ :  صَلَّيْتُ خَلْفَ زَيْدِ بْنِ أَرْقَمَ عَلَى جِنَازَةٍ فَكَبَّرَ خَمْسًا ، فَقَالَ لَهُ  ابْنُ أَبِي لَيْلَى  : أَوَهِمْتَ ؟  فَقَالَ  : لَا ،  إِنِّي صَلَّيْتُ خَلْفَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى جِنَازَةٍ فَكَبَّرَ خَمْسًا  .","","Musnad al-Bazzar 4322","","زيد بن أرقم الأنصاري عن عبد الأعلى بن عامر الثعلبي عن إسرائيل بن يونس بن أبي إسحاق عن خالد بن عمرو السعيدي عن محمد بن عبد الرحيم  صاعقة عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4330","4323  -  وَحَدَّثَنَاهُ  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبٍ ، قَالَ :  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  لَيْثِ بْنِ الْمُرَقِّعِ  ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : (ليث عن المرقع) كما في سنن الدارقطني .","","Musnad al-Bazzar 4323","","زيد بن أرقم الأنصاري عن مرقع بن صيفي الحنظلي عن ليث بن أبي سليم عن محمد بن فضيل بن غزوان عن إسحاق بن إبراهيم الشهيدي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4331","4324  -  حَدَّثَنَا  حُمَيْدُ بْنُ مَسْعَدَةَ ، قَالَ :  نَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ، قَالَ :  نَا  سَعِيدُ بْنُ مَسْرُوقٍ ،  عَنْ  يَزِيدَ بْنِ حَيَّانَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قُلْنَا لَهُ حَدِّثْنَا ، قَالَ :  قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَنَزَلَ بِوَادٍ بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  فَخَطَبَنَا ، ثُمَّ قَالَ :  إِنَّمَا أَنَا بَشَرٌ ،  أُوشِكُ  أَنْ أُدْعَى فَأُجِيبَ  ، أَلَا وَإِنِّي تَارِكٌ فِيكُمُ  الثَّقَلَيْنِ :  أَحَدُهُمَا كِتَابُ اللهِ وَأَهْلُ بَيْتِي "" قَالَهَا ثَلَاثَ مَرَّاتٍ  .  فَقُلْنَا : مَنْ أَهْلُ بَيْتِهِ ؛ نِسَاؤُهُ ؟ قَالَ : أَلَمْ تَرَ أَنَّ الْمَرْأَةَ تَكُونُ مَعَ الرَّجُلِ حِينًا مِنَ الدَّهْرِ فَتَرْجِعُ إِلَى أَبِيهَا وَقَوْمِهَا ؛ أَهْلُ بَيْتِهِ  أَهْلُهُ وَعَصَبَتُهُ         [10/232]      الَّذِينَ حُرِمُوا الصَّدَقَةَ بَعْدَهُ :  آلُ عَبَّاسٍ  ،  وَآلُ عَلِيٍّ  ،  وَآلُ جَعْفَرٍ  ،  وَآلُ عَقِيلٍ  .  وَلَا أَعْلَمُ  أَسْنَدَ  سَعِيدُ بْنُ مَسْرُوقٍ  ، عَنْ  يَزِيدَ بْنِ حَيَّانَ  ، عَنْ  زَيْدِ بْنِ أَرْقَمَ  غَيْرَ هَذَا الْحَدِيثِ ، وَأَكْثَرُ ظَنِّي أَنَّ  حُمَيْدَ بْنَ مَسْعَدَةَ  حَدَّثَنَاهُ  .","","Musnad al-Bazzar 4324","","زيد بن أرقم الأنصاري عن يزيد بن حيان التيمي عن سعيد بن مسروق الثوري عن حسان بن إبراهيم الكرماني عن حميد السامي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4332","4325  -  وَحَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ :  نَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ ،  عَنِ  الْحَسَنِ بْنِ عُبَيْدِ اللهِ النَّخَعِيِّ ،  عَنْ  مُسْلِمِ بْنِ صُبَيْحٍ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنِّي تَارِكٌ فِيكُمُ  الثَّقَلَيْنِ :  كِتَابَ اللهِ وَأَهْلَ بَيْتِي ، وَإِنَّهُمَا لَنْ يَتَفَرَّقَا حَتَّى يَرِدَا عَلَى الْحَوْضِ  .","","Musnad al-Bazzar 4325","","زيد بن أرقم الأنصاري عن مسلم بن صبيح الهمداني عن الحسن بن عبيد الله النخعي عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4333","[10/233]      4326  -  وَحَدَّثَنَاهُ  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ :  نَا  أَسْوَدُ بْنُ عَامِرٍ ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  عُثْمَانَ بْنِ الْمُغِيرَةِ ،  عَنْ  عَلِيِّ بْنِ رَبِيعَةَ ، قَالَ :  لَقِيتُ زَيْدَ بْنَ أَرْقَمَ وَهُوَ دَاخِلٌ عَلَى الْمُخْتَارِ وَأَنَا خَارِجٌ مِنْ عِنْدِهِ ، فَقُلْتُ : سَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنِّي تَارِكٌ فِيكُمُ  الثَّقَلَيْنِ  ؟ ""  قَالَ  : نَعَمْ  .  وَلَا نَعْلَمُ رَوَى  مُسْلِمُ بْنُ صُبَيْحٍ  عَنْ  زَيْدِ بْنِ أَرْقَمَ  إِلَّا هَذَا الْحَدِيثَ ، وَلَا رَوَى  عَلِيُّ بْنُ رَبِيعَةَ  عَنْ  زَيْدِ بْنِ أَرْقَمَ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 4326","","زيد بن أرقم الأنصاري عن علي بن ربيعة بن نضلة الوالبي عن عثمان بن المغيرة الأعشى عن إسرائيل بن يونس بن أبي إسحاق عن الأسود بن عامر شاذان عن الفضل بن سهل الخراساني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4334","4327  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَانِئٍ ، قَالَ :  نَا  عَفَّانُ ، قَالَ :  نَا  أَبُو عَوَانَةَ  عَنِ  الْمُغِيرَةِ ،  عَنْ  أَبِي عُبَيْدَةَ  عَنْ  مَيْمُونٍ أَبِي عَبْدِ اللهِ ، قَالَ :  قَالَ زَيْدُ بْنُ أَرْقَمَ وَأَنَا أَسْمَعُ  :  نَزَلْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَادٍ يُقَالُ لَهُ  وَادِي خُمٍّ  ، فَأُذِّنَ بِالصَّلَاةِ فَصَلَّاهَا  تَهْجِيرًا  ، ثُمَّ خَطَبَنَا ، وَظُلِّلَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِثَوْبٍ عَلَى شَجَرَةِ  سَمُرَةٍ  مِنَ الشَّمْسِ ، فَقَالَ :  أَلَسْتُمْ  تَعْلَمُونَ أَوْ تَشْهَدُونَ  أَنِّي أَوْلَى بِكُلِّ مُؤْمِنٍ مِنْ نَفْسِهِ  قَالُوا : بَلَى ، قَالَ :         [10/234]      "" فَمَنْ كُنْتُ  مَوْلَاهُ  فَإِنَّ  عَلِيًّا  مَوْلَاهُ  ، اللَّهُمَّ وَالِ مَنْ وَالَاهُ ، وَعَادِ مَنْ عَادَاهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  مُغِيرَةَ  إِلَّا  أَبَا عَوَانَةَ  .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : ( أبي عبيد )","","Musnad al-Bazzar 4327","","زيد بن أرقم الأنصاري عن ميمون الكندي مولى عبد الرحمن بن سمرة عن أبو عبيد عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن عفان بن مسلم الصفار عن إبراهيم بن هانئ الأغياني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4335","4328  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ، قَالَ :  سَمِعْتُ  مَيْمُونًا أَبَا عَبْدِ اللهِ يَقُولُ :  سَمِعْتُ  زَيْدَ بْنَ أَرْقَمَ يَقُولُ :  إِنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ أَنْ يُتَدَاوَى مِنْ ذَاتِ  الْجَنْبِ  بِالْعُودِ  الْهِنْدِيِّ وَالزَّيْتِ  .         [10/235]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ – إِلَّا  زَيْدَ بْنَ أَرْقَمَ  .","","Musnad al-Bazzar 4328","","زيد بن أرقم الأنصاري عن ميمون الكندي مولى عبد الرحمن بن سمرة عن خالد الحذاء عن شعبة بن الحجاج عن أبو داود الطيالسي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4336","4329  -  حَدَّثَنَاهُ  الْفَضْلُ بْنُ سَهْلٍ ، وَزُرَيْقُ بْنُ السَّخْتِ ، قَالَا :  نَا  يَعْقُوبُ بْنُ إِسْحَاقَ ، قَالَ  عَبْدُ الرَّحْمَنِ بْنُ مَيْمُونٍ ،  عَنْ  أَبِيهِ  قَالَ :  سَأَلْتُ  زَيْدَ بْنَ أَرْقَمَ مَا كَانَ اسْمُ أُمِّ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - ؟ قَالَ :  آمِنَةُ بِنْتُ وَهْبٍ  .  وَمَيْمُونٌ أَبُو عَبْدِ اللهِ  رَوَى عَنْ  زَيْدٍ  أَحَادِيثَ .","","Musnad al-Bazzar 4329","","زيد بن أرقم الأنصاري عن ميمون الكندي مولى عبد الرحمن بن سمرة عن عبد الرحمن بن ميمون التميمي عن يعقوب بن إسحاق بن زيد الحضرمي عن زريق بن السخت البصري عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4337","4330  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ         [10/236]      جُرَيْجٍ قَالَ  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ ، وَعَامِرُ بْنُ مُصْعَبٍ  أَنَّهُمَا سَمِعَا  أَبَا الْمِنْهَالِ يَقُولُ :  سَأَلْتُ  الْبَرَاءَ ، وَزَيْدَ بْنَ أَرْقَمَ - رَضِيَ اللهُ عَنْهُمَا - عَنِ الصَّرْفِ ، فَقَالَا : كُنَّا تَاجِرَيْنِ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَأَلْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الصَّرْفِ ، فَقَالَ :  مَا كَانَ مِنْ يَدٍ بِيَدٍ فَلَا بَأْسَ  ، وَمَا كَانَ  نَسِيئَةً  فَلَا يَصْلُحُ  .","","Musnad al-Bazzar 4330","","زيد بن أرقم الأنصاري عن عبد الرحمن بن مطعم العنزي عن عامر بن مصعب الكوفي عن ابن جريج عن أبو عاصم النبيل عن الفلاس عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4338","[10/237]      4331  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو عَاصِمٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمٍ ،  عَنْ  أَبِي الْمِنْهَالِ ، قَالَ :  سَمِعْتُ  الْبَرَاءَ ، وَزَيْدَ بْنَ أَرْقَمَ يُحَدِّثَانِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَا كَانَ مِنْ يَدٍ بِيَدٍ فَلَا بَأْسَ  وَمَا كَانَ مِنْ  نَسِيئَةٍ  فَلَا يَصْلُحُ  .  وَلَا نَعْلَمُ رَوَى هَذَيْنِ الْحَدِيثَيْنِ إِلَّا  ابْنُ جُرَيْجٍ  .","","Musnad al-Bazzar 4331","","زيد بن أرقم الأنصاري عن عبد الرحمن بن مطعم العنزي عن الحسن بن مسلم بن يناق عن ابن جريج عن أبو عاصم النبيل عن الفلاس عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4339","4332  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  يُوسُفُ بْنُ صُهَيْبٍ ،  عَنْ  حَبِيبِ بْنِ يَسَارٍ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ لَمْ يَأْخُذْ مِنْ شَارِبِهِ فَلَيْسَ مِنَّا  .         [10/238]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يُحَدَّثُ بِهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  زَيْدَ بْنَ أَرْقَمَ  ، وَلَا نَعْلَمُ لَهُ  إِسْنَادًا  إِلَّا هَذَا  الْإِسْنَادَ  .","","Musnad al-Bazzar 4332","","زيد بن أرقم الأنصاري عن حبيب بن يسار الكندي عن يوسف بن صهيب الكندي عن معتمر بن سليمان عن الفلاس عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4340","4333  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ ، قَالَ :  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  يُوسُفُ بْنُ صُهَيْبٍ ،  عَنْ  حَبِيبِ بْنِ يَسَارٍ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كُنَّا نَقْرَأُ : لَوْ أَنَّ لِابْنِ آدَمَ وَادِيًا مِنْ مَالٍ لَتَمَنَّى إِلَيْهِ ثَانِيًا ،  وَلَا يَمْلَأُ نَفْسَ ابْنِ آدَمَ إِلَّا التُّرَابُ  .","","Musnad al-Bazzar 4333","","زيد بن أرقم الأنصاري عن حبيب بن يسار الكندي عن يوسف بن صهيب الكندي عن معتمر بن سليمان عن العباس بن الوليد النرسي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4341","4334  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  أَبُو عَاصِمٍ ، قَالَ :  نَا         [10/239]      عُمَارَةُ الْأَحْمَرُ ، قَالَ :  أَخْبَرَنِي  حَبِيبُ بْنُ يَزِيدَ ، وَأَبُو لَيْلَى مَوْلَى فُلَانِ بْنِ سَعِيدٍ ، وَحَبِيبُ بْنُ يَسَارٍ ، قَالُوا :  كُنَّا مَعَ زَيْدِ بْنِ أَرْقَمَ جُلُوسًا ، فَجَاءَهُ رَجُلٌ فَجَلَسَ ، فَقَالَ : إِنَّ النَّاسَ قَدْ أَكْثَرُوا فِي هَذَيْنِ الرَّجُلَيْنِ :  عَلِيٍّ  وَعُثْمَانَ  ، فَأَخْبِرْنِي عَنْهُمَا ، قَالَ : لَا أُحَدِّثُكَ إِلَّا بِمَا شَهِدْتُهُ  وَوَعَاهُ  قَلْبِي : خَرَجَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَاسْتَقْبَلَنَا بِوَجْهِهِ ، فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ بِمَا هُوَ أَهْلُهُ ، ثُمَّ قَالَ :  أَلَسْتُمْ تَعْلَمُونَ أَنِّي أَوْلَى بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ  فَأَعَادَهَا عَلَيْنَا ثَلَاثًا ، كُلُّ ذَلِكَ نَقُولُ : بَلَى يَا رَسُولَ اللهِ ،  وَعَلِيٌّ  سَاكِتٌ ، قَالَ : قُمْ يَا  عَلِيُّ ،  وَأَخَذَ  بِعَضُدِهِ أَوْ بِعَضُدَيْهِ  فَرَفَعَهَا أَوْ رَفَعَهُمَا  ، فَقَالَ : "" مَنْ كُنْتُ  مَوْلَاهُ  فَعَلِيٌّ  مَوْلَاهُ  .","","Musnad al-Bazzar 4334","","زيد بن أرقم الأنصاري عن حبيب بن أبي حبيب الأنماطي عن عمارة الأحمر عن أبو عاصم النبيل عن محمد بن معمر بن ربعي البحراني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4342","4335  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ :  نَا  أَبُو حَيَّانَ ،  عَنْ  يَزِيدَ بْنِ حَيَّانَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  بَعَثَ إِلَيَّ  عُبَيْدُ اللهِ بْنُ زِيَادٍ  فَأَتَيْتُهُ ، فَقَالَ : مَا أَحَادِيثُ تَبْلُغُنَا عَنْكَ ، إِنَّكَ تُحَدِّثُ بِهَا وَتَرْوِيهَا عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَا نَسْمَعُهَا فِي كِتَابِ اللهِ ؟ تُحَدِّثُ أَنَّ لَهُ حَوْضًا فِي الْجَنَّةِ ، قُلْتُ : قَدْ حَدَّثَنَا عَنْهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَوَعَيْنَاهُ  ، قَالَ :         [10/240]      كَذَبْتَ وَكَبِرْتَ وَخَرِفْتَ ، فَقَالَ  زَيْدٌ  : أَمَا إِنِّي سَمِعْتُ  وَوَعَاهُ  قَلْبِي مِنْهُ ، وَهُوَ يَقُولُ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Musnad al-Bazzar 4335","","زيد بن أرقم الأنصاري عن يزيد بن حيان التيمي عن يحيى بن سعيد التيمي عن يوسف بن موسى بن راشد عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4343","4336  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ :  نَا  جَرِيرٌ ، قَالَ :  نَا  أَبُو حَيَّانَ ،  عَنْ  يَزِيدَ بْنِ حَيَّانَ ، قَالَ :  انْطَلَقْتُ أَنَا  وَحُصَيْنٌ  وَعَمْرُو بْنُ مُسْلِمٍ  ، أَوْ  عُمَرُ بْنُ مُسْلِمٍ  إِلَى زَيْدِ بْنِ أَرْقَمَ فِي دَارِهِ ، فَقَالَ  حُصَيْنٌ  : يَا  زَيْدُ ،  لَقَدْ لَقِيتَ خَيْرًا وَرَأَيْتَ خَيْرًا كَثِيرًا ، رَأَيْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَسَمِعْتَ حَدِيثَهُ ، وَغَزَوْتَ مَعَهُ ، وَصَلَّيْتَ خَلْفَهُ ، حَدِّثْنَا مَا رَأَيْتَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَشَهِدْتَ مِنْهُ ، قَالَ : يَا ابْنَ أَخِي ، كَبِرَتْ سِنِّي وَقَدُمَ عَهْدِي ، وَنَسِيتُ بَعْضَ الَّذِي كُنْتُ أَذْكُرُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَا حَدَّثْتُكُمْ ، فَاقْبَلُوهُ ، وَمَا لَمْ أُحَدِّثْكُمُوهُ ، فَلَا تُكَلِّفُونِيهِ ، ثُمَّ قَالَ : خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  أَمَّا بَعْدُ أَيُّهَا النَّاسُ إِنَّمَا أَنَا بَشَرٌ  يُوشِكُ  أَنْ يَأْتِيَنِي رَسُولُ رَبِّي فَأُجِيبَ  ، وَإِنِّي تَارِكٌ فِيكُمُ  الثَّقَلَيْنِ  ؛ أَوَّلُهُمَا كِتَابُ اللهِ فِيهِ الْهُدَى وَالنُّورُ "" فَحَثَّ عَلَى كِتَابِ اللهِ وَرَغَّبَ فِيهِ "" ، وَأَهْلُ بَيْتِي ، أُذَكِّرُكُمُ اللهَ فِي أَهْلِ بَيْتِي  ""  قَالَ  حُصَيْنٌ         [10/241]      يَا  زَيْدُ  ، مَنْ أَهْلُ بَيْتِهِ ؛ نِسَاؤُهُ مِنْ أَهْلِ بَيْتِهِ ؟  قَالَ  :  إِنَّ نِسَاءَهُ مِنْ أَهْلِ بَيْتِهِ ، وَلَكِنَّ أَهْلَ بَيْتِهِ مَنْ حُرِمَ الصَّدَقَةَ مِنْ بَعْدِهِ  ، قِيلَ : مَنْ هُمْ ؟ قَالَ :  آلُ عَبَّاسٍ  ،  وَآلُ عَلِيٍّ  ،  وَآلُ جَعْفَرٍ  ،  وَآلُ عَقِيلٍ  ، فَإِنَّ هَؤُلَاءِ تَحْرُمُ عَلَيْهِمُ الصَّدَقَةُ  .","","Musnad al-Bazzar 4336","","زيد بن أرقم الأنصاري عن يزيد بن حيان التيمي عن يحيى بن سعيد التيمي عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4344","4337  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  عُثْمَانَ بْنِ أَبِي زُرْعَةَ ،  عَنْ  إِيَاسِ بْنِ أَبِي رَمْلَةَ ، قَالَ :  شَهِدْتُ  مُعَاوِيَةَ  سَأَلَ  زَيْدَ بْنَ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - : أَشَهِدْتَ الْعِيدَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَالْجُمُعَةَ ؟ قَالَ : شَهِدْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَلِكَ . قَالَ : فَمَا صَنَعَ ؟ قَالَ : صَلَّى الْعِيدَ وَرَخَّصَ فِي الْجُمُعَةِ ، فَقَالَ :  مَنْ شَاءَ أَنْ يَجْلِسَ فَلْيَجْلِسْ  .","","Musnad al-Bazzar 4337","","زيد بن أرقم الأنصاري عن إياس بن أبي رملة الشامي عن عثمان بن المغيرة الأعشى عن إسرائيل بن يونس بن أبي إسحاق عن أبو داود الطيالسي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4345","4338  -  حَدَّثَنَا  مَيْمُونُ بْنُ الْأَصْبَغِ النَّصِيبِيُّ ، قَالَ :  نَا  يَزِيدُ بْنُ         [10/242]      هَارُونَ ، قَالَ :  نَا  حُسَامُ بْنُ مِصَكٍّ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْقَاسِمِ بْنِ رَبِيعَةَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  نِعْمَ الْمَرْءُ  بِلَالٌ  وَهُوَ سَيِّدُ الشُّهَدَاءِ  ، وَالْمُؤَذِّنُونَ أَطْوَلُ النَّاسِ  أَعْنَاقًا  يَوْمَ الْقِيَامَةِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ عَنْ  زَيْدِ بْنِ أَرْقَمَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  إِلَّا  حُسَامُ بْنُ مِصَكٍّ  ، وَلَا عَنْ  حُسَامٍ  إِلَّا  يَزِيدُ بْنُ هَارُونَ  ،  وَحُسَامٌ  رَجُلٌ مِنْ  أَهْلِ الْبَصْرَةِ  قَدْ حَدَّثَ عَنْهُ جَمَاعَةٌ كَثِيرَةٌ وَاحْتَمَلُوا حَدِيثَهُ .","","Musnad al-Bazzar 4338","","زيد بن أرقم الأنصاري عن القاسم بن ربيعة بن جوشن الغطفاني عن قتادة بن دعامة عن حسام بن مصك الأزدي عن يزيد بن هارون عن ميمون بن الأصبغ عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4346","4339  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو قُتَيْبَةَ ، قَالَ :  نَا  يُونُسُ بْنُ         [10/243]      أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ .","","Musnad al-Bazzar 4339","","زيد بن أرقم الأنصاري عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن سلم بن قتيبة الشعيري عن أبو موسى الزمن عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4347","4340  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  خَلَّادُ بْنُ يَزِيدَ الْبَاهِلِيُّ ، قَالَ :  نَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ .","","Musnad al-Bazzar 4340","","زيد بن أرقم الأنصاري عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن خلاد بن يزيد الباهلي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4348","4341  -  وَحَدَّثَنَا  الْحَسَنُ بْنُ يَحْيَى ، وَعَبْدُ اللهِ بْنُ الصَّبَّاحِ الْعَطَّارُ ، قَالَا :  نَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ الْحَنَفِيُّ ، قَالَ :  نَا  إِسْرَائِيلُ ، قَالَ :  حَدَّثَنِي  أَبِي يُونُسُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  مَرِضْتُ فَعَادَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ بَرِئْتُ فَلَقِيَنِي ، فَقَالَ :  يَا  زَيْدُ ،  أَرَأَيْتَ لَوْ كَانَ عَيْنُكَ لِمَا بِهَا ، مَا كُنْتَ صَانِعًا ؟  قُلْتُ : كُنْتُ أَصْبِرُ وَأَحْتَسِبُ ، قَالَ : لَوْ كَانَتْ عَيْنُكَ لِمَا بِهَا فَصَبَرْتَ  وَاحْتَسَبْتَ  وَجَبَتْ لَكَ الْجَنَّةُ  .         [10/244]      وَاللَّفْظُ فِي هَذِهِ الْأَحَادِيثِ لَفْظُ  أَبِي قُتَيْبَةَ  ، وَحَدِيثُ  إِسْرَائِيلَ  لَا نَعْلَمُ رَوَاهُ عَنْ  إِسْرَائِيلَ  إِلَّا  عُبَيْدُ اللهِ الْحَنَفِيُّ  .","","Musnad al-Bazzar 4341","","زيد بن أرقم الأنصاري عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن عبد المجيد الحنفي عن عبد الله بن الصباح المربدي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4349","4342  -  وَحَدَّثَنَا  الْحَسَنُ بْنُ يَحْيَى ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ عَبْدِ الْمَجِيدِ ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  جَابِرٍ ،  عَنْ  خَيْثَمَةَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَا ابْتُلِيَ عَبْدٌ بَعْدَ ذَهَابِ دِينِهِ بِأَشَدَّ مِنْ بَصَرِهِ  ، وَمَنِ ابْتُلِيَ بِبَصَرِهِ ، فَصَبَرَ حَتَّى يَلْقَى اللهَ لَقِيَ اللهَ - تَبَارَكَ وَتَعَالَى - وَلَا حِسَابَ عَلَيْهِ  .  وَخَيْثَمَةُ هَذَا هُوَ خَيْثَمَةُ بْنُ أَبِي خَيْثَمَةَ  .","","Musnad al-Bazzar 4342","","زيد بن أرقم الأنصاري عن خيثمة بن أبي خيثمة البصري عن جابر الجعفي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن عبد المجيد الحنفي عن الحسن بن يحيى الرزي عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4350","[10/245]      4343  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ، قَالَ :  سَمِعْتُ  زَيْدَ بْنَ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - يَقُولُ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تِسْعَةَ عَشَرَ غَزْوَةً  .","","Musnad al-Bazzar 4343","","زيد بن أرقم الأنصاري عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4351","4344  -  حَدَّثَنَا  بِشْرُ بْنُ مُعَاذٍ أَبُو سَهْلٍ الْعَقَدِيُّ ، قَالَ :  نَا  عُوَيْنُ بْنُ عَمْرٍو الْقَيْسِيُّ ، قَالَ :  نَا  أَبُو مُصْعَبٍ الْمَكِّيُّ ، قَالَ : أَدْرَكْتُ زَيْدَ بْنَ أَرْقَمَ         [10/246]      وَالْمُغِيرَةَ بْنَ شُعْبَةَ وَأَنَسَ بْنَ مَالِكٍ  يُحَدِّثُونَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا كَانَ لَيْلَةَ بَاتَ فِي الْغَارِ  أَمَرَ اللهُ تَبَارَكَ وَتَعَالَى شَجَرَةً فَنَبَتَتْ فِي وَجْهِ الْغَارِ فَسَتَرَتْ وَجْهَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَمَرَ اللهُ تَبَارَكَ وَتَعَالَى الْعَنْكَبُوتَ فَنَسَجَتْ عَلَى وَجْهِ الْغَارِ ، وَأَمَرَ اللهُ جَلَّ وَعَزَّ حَمَامَتَيْنِ وَحْشِيَّتَيْنِ فَوَقَعَتَا بِفَمِ الْغَارِ ، وَأَتَى الْمُشْرِكُونَ مِنْ كُلِّ بَطْنٍ حَتَّى إِذَا كَانُوا مِنَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى قَدْرِ أَرْبَعِينَ ذِرَاعًا مَعَهُمْ قِسِيُّهُمْ وَعِصِيُّهُمْ تَقَدَّمَ رَجُلٌ مِنْهُمْ فَنَظَرَ فَرَأَى الْحَمَامَتَيْنِ ، فَرَجَعَ فَقَالَ لِأَصْحَابِهِ : لَيْسَ فِي الْغَارِ شَيْءٌ ، رَأَيْتُ حَمَامَتَيْنِ عَلَى فَمِ الْغَارِ فَعَرَفْتُ أَنْ لَيْسَ فِيهِ أَحَدٌ ، فَسَمِعَ قَوْلَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَعَرَفَ أَنَّ اللهَ تَبَارَكَ وَتَعَالَى قَدْ دَرَأَ بِهِمَا عَنْهُ ،  فَشَمَّتَ  عَلَيْهِمَا ،  وَفَرَضَ  جَزَاءَهُمَا ، وَاتَّخَذَتْ فِي حَرَمِ اللهِ  يُفْرِخْنَ  .  أَحْسَبُهُ قَالَ : فَأَصْلُ كُلِّ حَمَامٍ فِي الْحَرَمِ مِنْ فِرَاخِهَا  .         [10/247]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  عُوَيْنُ بْنُ عَمْرٍو  وَهُوَ رَجُلٌ مِنْ  أَهْلِ الْبَصْرَةِ  مَشْهُورٌ ،  وَأَبُو مُصْعَبٍ  فَلَا نَعْلَمُ حَدَّثَ عَنْهُ بِهَذَا الْحَدِيثِ إِلَّا  عُوَيْنُ بْنُ عَمْرٍو  ، وَكَانَ  عُمَيْرٌ  وَرِيَاحٌ  أَخَوَانِ  .","","Musnad al-Bazzar 4344","","أنس بن مالك عن أبو مصعب المكي عن عوين بن عمرو القيسي عن بشر بن معاذ عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4352","4345  -  حَدَّثَنَا  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ :  نَا  عُبَيْدُ بْنُ إِسْحَاقَ ، قَالَ :  نَا  كَامِلُ بْنُ الْعَلَاءِ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ ،  عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَا بَعَثَ اللهُ نَبِيًّا قَطُّ إِلَّا عَاشَ نِصْفَ الَّذِي عَاشَ النَّبِيُّ الَّذِي قَبْلَهُ  .         [10/248]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  زَيْدِ بْنِ أَرْقَمَ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4345","","زيد بن أرقم الأنصاري عن يحيى بن جعدة بن هبيرة المخزومي عن حبيب بن أبي ثابت الكاهلي عن كامل بن العلاء التميمي عن عبيد بن إسحاق عطار المطلقات عن الفضل بن سهل الخراساني عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4353","4346  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ، قَالَ :  سَمِعْتُ  أَبَا حَمْزَةَ  يُحَدِّثُ ، عَنْ  زَيْدِ بْنِ أَرْقَمَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  أَنْتُمْ جُزْءٌ مِنْ مِائَةِ أَلْفِ جُزْءٍ مِمَّنْ يَرِدُ الْحَوْضَ  وَكَانُوا يَوْمَئِذٍ مَا بَيْنَ السَّبْعِمِائَةِ إِلَى الثَّمَانِمِائَةِ .  وَاسْمُ  أَبِي حَمْزَةَ طَلْحَةُ مَوْلَى قَرَظَةَ  .","","Musnad al-Bazzar 4346","","زيد بن أرقم الأنصاري عن طلحة بن يزيد الأيلي عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند زيد بن أرقم رضي الله عنه"
"4354","[10/249]      مُسْنَدُ  الْجَارُودِ بْنِ الْمُعَلَّى  رَضِيَ اللهُ عَنْهُ         [10/250]             [10/251]      مَا  أَسْنَدَ  الْجَارُودُ بْنُ الْمُعَلَّى  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  4347  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ الْقُرَشِيُّ ، قَالَ :  نَا  بِشْرُ بْنُ الْمُفَضَّلِ ،  عَنِ  الْجُرَيْرِيِّ ،  عَنْ  أَبِي الْعَلَاءِ يَزِيدَ بْنِ عَبْدِ اللهِ ،  عَنْ  مُطَرِّفِ بْنِ عَبْدِ اللهِ ، قَالَ :  نَا  أَبُو مُسْلِمٍ ،  عَنِ  الْجَارُودِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كُنَّا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي بَعْضِ أَسْفَارِهِ وَفِي الظَّهْرِ قِلَّةٌ ، فَتَذَاكَرَ  الْقَوْمُ  بَيْنَهُمُ الظَّهْرَ ، فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ مَا تَقُولُ فِي الضَّالَّةِ ؟ فَقَالَ :  إِذَا رَأَيْتَ ضَالَّةً أَوْ لُقَطَةً فَانْشُدْهَا ، وَلَا تَكْتُمْ وَلَا تُغَيِّرْ  ، وَرَأَيْتُهُ فِي مَوْضِعٍ آخَرَ فَانْشُدْهَا وَلَا تَكْتُمْ وَلَا تُغَيِّبْ ، فَإِنْ عَرَفْتَ صَاحِبَهَا وَإِلَّا فَمَالُ اللهِ يُؤْتِيهِ مَنْ يَشَاءُ  .         [10/252]","","Musnad al-Bazzar 4347","","الجارود ظئر العناق عن أبو مسلم الجذمي عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن بشر بن المفضل عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند الجارود بن المعلى رضي الله عنه"
"4355","4348  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ مَيْمُونٍ ، قَالَ :  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  هِلَالُ بْنُ حِقٍّ ،  عَنِ  الْجُرَيْرِيِّ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  مُطَرِّفٍ ،  عَنْ  أَبِي مُسْلِمٍ ،  عَنِ  الْجَارُودِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .","","Musnad al-Bazzar 4348","","الجارود ظئر العناق عن أبو مسلم الجذمي عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن هلال بن حق البصرى عن معتمر بن سليمان عن محمد بن عبد الله بن ميمون السكري عن البزار","مسند الجارود بن المعلى رضي الله عنه"
"4356","4349  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ :  نَا  حَمَّادٌ - يَعْنِي - ابْنَ زَيْدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي الْعَلَاءِ ،  عَنْ  أَبِي مُسْلِمٍ ،  عَنِ  الْجَارُودِ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  .","","Musnad al-Bazzar 4349","","الجارود ظئر العناق عن أبو مسلم الجذمي عن يزيد بن عبد الله بن الشخير العامري عن أيوب السختياني عن حماد بن زيد عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند الجارود بن المعلى رضي الله عنه"
"4357","[10/253]      4350  -  حَدَّثَنَاهُ  بِشْرُ بْنُ آدَمَ ، قَالَ :  نَا  حَبَّانُ بْنُ هِلَالٍ ، قَالَ :  نَا  سُكَيْنُ بْنُ عَبْدِ الْعَزِيزِ ، قَالَ :  حَدَّثَنِي  حَفْصُ بْنُ خَالِدٍ ، قَالَ :  حَدَّثَنِي  أَبُو الْقَمُوصِ زَيْدُ بْنُ عَلِيٍّ ، قَالَ :  حَدَّثَنِي  الْجَارُودُ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  ضَالَّةُ الْمُسْلِمِ  حَرَقُ  النَّارِ  .","","Musnad al-Bazzar 4350","","الجارود ظئر العناق عن زيد بن علي العبدي عن حفص بن خالد بن جابر عن سكين بن عبد العزيز بن قيس المجاشعي عن حبان بن هلال الباهلي عن بشر بن آدم بن يزيد عن البزار","مسند الجارود بن المعلى رضي الله عنه"
"4358","4351  -  حَدَّثَنَا  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ، قَالَ :  نَا  خَالِدُ بْنُ الْحَارِثِ ،  عَنْ  سَعِيدٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مُسْلِمٍ ، وَهُوَ يُعْرَفُ بِأَبِي مُسْلِمٍ الْجَذْمِيِّ ،  عَنِ         [10/254]      الْجَارُودِ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَهَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الشُّرْبِ قَائِمًا  .  آخِرُ الْخَامِسِ وَالثَّلَاثِينَ وَالْحَمْدُ لِلهِ .","","Musnad al-Bazzar 4351","","الجارود ظئر العناق عن أبو مسلم الجذمي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن خالد الصدق عن يحيى بن حبيب الحارثي عن البزار","مسند الجارود بن المعلى رضي الله عنه"
"4359","[10/255]      مُسْنَدُ  بُرَيْدَةَ بْنِ الْحُصَيْبِ  رَضِيَ اللهُ عَنْهُ         [10/256]             [10/257]      حَدِيثُ  بُرَيْدَةَ بْنِ حُصَيْبٍ  4352  -  أَخْبَرَنَا  أَبُو الْحَسَنِ مُحَمَّدُ بْنُ أَيُّوبَ بْنِ حَبِيبِ بْنِ يَحْيَى الرَّقِّيُّ ، قَالَ :  نَا  أَحْمَدُ بْنُ عَمْرِو بْنِ عَبْدِ الْخَالِقِ الْبَزَّارُ ، قَالَ :  نَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو أَحْمَدَ ، قَالَ :  نَا  عَبْدُ الْمَلِكِ بْنُ أَبِي غَنِيَّةَ ،  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، قَالَ :  حَدَّثَنِي  بُرَيْدَةُ ، قَالَ :  بَعَثَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَعَ  عَلِيِّ بْنِ أَبِي طَالِبٍ  فَرَأَيْتُ مِنْهُ جَفْوَةً ، فَلَمَّا جِئْتُ شَكَوْتُهُ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : فَرَفَعَ رَأْسَهُ ، فَقَالَ :  يَا  بُرَيْدَةُ  مَنْ كُنْتُ  مَوْلَاهُ  فَعَلِيٌّ  مَوْلَاهُ  .","","Musnad al-Bazzar 4352","","بريدة بن الحصيب الأسلمي عن عبد الله بن عباس عن سعيد بن جبير الأسدي عن الحكم بن عتيبة الكندي عن عبد الملك بن حميد الخزاعي عن محمد بن عبد الله بن الزبير عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4360","[10/258]      4353  -  وَحَدَّثَنَاهُ  أَحْمَدُ بْنُ يَحْيَى الْكُوفِيُّ ، قَالَ :  نَا  خَالِدُ بْنُ مَخْلَدٍ ، قَالَ :  نَا  أَبُو مَرْيَمَ ،  عَنْ  عَدِيِّ بْنِ ثَابِتٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  بُرَيْدَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَلَا نَعْلَمُ  أَسْنَدَ  ابْنُ عَبَّاسٍ  عَنْ  بُرَيْدَةَ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 4353","","بريدة بن الحصيب الأسلمي عن عبد الله بن عباس عن سعيد بن جبير الأسدي عن عدي بن ثابت الظفري عن عبد الغفار بن القاسم الأنصاري عن خالد بن مخلد القطواني عن أحمد بن يحيى بن زكريا عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4361","4354  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْأَعْمَشُ ،  عَنْ  سَعْدِ بْنِ عُبَيْدَةَ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  بَعَثَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَرِيَّةٍ فَاسْتَعْمَلَ عَلَيْنَا  عَلِيًّا  - رَضِيَ اللهُ عَنْهُ - فَلَمَّا جِئْنَا قَالَ : كَيْفَ رَأَيْتُمْ صَاحِبَكُمْ ؟ قَالَ :  فَإِمَّا شَكَوْتُهُ وَإِمَّا شَكَاهُ غَيْرِي  ، قَالَ : فَرَفَعْتُ رَأْسِي ، وَكُنْتُ رَجُلًا مِكْبَابًا فَإِذَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدِ احْمَرَّ وَجْهُهُ وَهُوَ يَقُولُ :  مَنْ كُنْتُ وَلِيَّهُ  فَعَلِيٌّ  وَلِيُّهُ  . فَقُلْتُ : لَا أَسُوءُكَ فِيهِ أَبَدًا  .","","Musnad al-Bazzar 4354","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن سعد بن عبيدة السلمي عن الأعمش عن أبو معاوية الضرير عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4362","[10/259]      4355  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا بَعَثَ أَمِيرًا أَوْ أَمَّرَ أَمِيرًا عَلَى سَرِيَّةٍ أَوْ جَيْشٍ أَمَرَهُ وَأَوْصَاهُ فِي خَاصَّتِهِ بِتَقْوَى اللهِ وَبِمَنْ مَعَهُ مِنَ الْمُسْلِمِينَ خَيْرًا ، ثُمَّ قَالَ :  اغْزُوا بِاسْمِ اللهِ وَفِي  سَبِيلِ  اللهِ ، قَاتِلُوا مَنْ كَفَرَ بِاللهِ  اغْزُوا فَلَا تَغُلُّوا وَلَا تَغْدِرُوا ، وَلَا تُمَثِّلُوا وَلَا تَقْتُلُوا  وَلِيدًا ،  وَإِذَا لَقِيتَ عَدُوَّكَ مِنَ الْمُشْرِكِينَ فَادْعُهُمْ إِلَّا ثَلَاثَ  خِصَالٍ أَوْ خِلَالٍ ،  فَأَيَّتُهُمْ مَا أَجَابُوكَ إِلَيْهَا فَاقْبَلْ مِنْهُمْ وَكُفَّ عَنْهُمْ ، ادْعُهُمْ إِلَى الْإِسْلَامِ فَإِنْ أَجَابُوا فَاقْبَلْ مِنْهُمْ وَكُفَّ عَنْهُمْ ، ثُمَّ ادْعُهُمْ إِلَى أَنْ يُهَاجِرُوا مِنْ دَارِهِمْ إِلَى دَارِ  الْمُهَاجِرِينَ  ، وَأَخْبِرْهُمْ إِنْ فَعَلُوا ذَلِكَ أَنَّ لَهُمْ مَا  لِلْمُهَاجِرِينَ  وَعَلَيْهِمْ مَا عَلَى  الْمُهَاجِرِينَ  ، فَإِنْ أَبَوْا أَنْ يَبْرَحُوا مِنْ دَارِهِمْ فَأَخْبِرْهُمْ أَنَّهُمْ يَكُونُونَ         [10/260]      كَأَعْرَابِ الْمُسْلِمِينَ يَجْرِي عَلَيْهِمْ حُكْمُ اللهِ الَّذِي يَجْرِي عَلَى الْمُسْلِمِينَ ، لَا يَكُونُ لَهُمْ فِي الْفَيْءِ وَلَا فِي الْغَنِيمَةِ شَيْءٌ ، فَإِنْ أَبَوْا فَاسْأَلْهُمُ الْجِزْيَةَ ، فَإِنْ فَعَلُوا فَاقْبَلْ مِنْهُمْ وَخَلِّ عَنْهُمْ ، فَإِنْ أَبَوْا فَقَاتِلْهُمْ ، وَإِذَا حَاصَرْتَ أَهْلَ حِصْنٍ فَإِنْ أَرَادُوكَ أَنْ تَجْعَلَ لَهُمْ ذِمَّةَ اللهِ وَذِمَّةَ رَسُولِهِ ، فَلَا تَجْعَلْ لَهُمْ ذِمَّةَ اللهِ وَذِمَّةَ رَسُولِهِ ، وَلَكِنِ اجْعَلْ لَهُمْ ذِمَّتَكَ وَذِمَّةَ أَبِيكَ وَذِمَمَ أَصْحَابِكَ ، فَإِنَّكُمْ إِنْ تُخْفِرُوا ذِمَمَكُمْ وَذِمَمَ أَصْحَابِكُمْ أَهْوَنُ مِنْ أَنْ  تُخْفِرُوا  ذِمَّةَ اللهِ وَذِمَّةَ رَسُولِهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَإِذَا حَاصَرْتَ أَهْلَ حِصْنٍ فَأَرَادُوكَ أَنْ  تُنْزِلَهُمْ  عَلَى حُكْمِ اللهِ فَلَا  تُنْزِلْهُمْ  عَلَى حُكْمِ اللهِ ، وَلَكِنْ أَنْزِلْهُمْ عَلَى حُكْمِكَ ; فَإِنَّكَ لَا تَدْرِي تُصِيبُ حُكْمَ اللهِ فِيهِمْ أَمْ لَا  .  فَقَالَ  عَبْدُ الرَّحْمَنِ  : هَذَا عِنْدِي .","","Musnad al-Bazzar 4355","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن عبد الرحمن بن مهدي عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4363","4356  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَحْمَدُ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - قَالَ :         [10/261]      كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا أَمَّرَ أَمِيرًا عَلَى سَرِيَّةٍ أَوْ بَعَثَ جَيْشًا  ...  ،  فَذَكَرَ نَحْوَ حَدِيثِ  عَبْدِ الرَّحْمَنِ بْنِ مَهْدِيٍّ  ، وَزَادَ فِيهِ : "" قَالَ  عَلْقَمَةُ بْنُ مَرْثَدٍ  : فَذَكَرْتُ ذَلِكَ  لِمُقَاتِلِ بْنِ حَيَّانَ  ، فَقَالَ : حَدَّثَنِي  مُسْلِمُ بْنُ الْهَيْصَمِ  ، عَنِ  النُّعْمَانِ بْنِ مُقَرِّنٍ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - "" .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ  شُعْبَةُ  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ  عَنِ  ابْنِ بُرَيْدَةَ  مُرْسَلًا  هَكَذَا ، رَوَاهُ  ابْنُ أَبِي عَدِيٍّ  ، وَرَوَاهُ  عَبْدُ الصَّمَدِ  عَنْ  شُعْبَةَ  ، عَنْ  عَلْقَمَةَ  ، عَنِ  ابْنِ بُرَيْدَةَ  ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  -","","Musnad al-Bazzar 4356","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن محمد بن عبد الله بن الزبير عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4364","وَرَوَاهُ  اللَّيْثُ بْنُ سَعْدٍ  ، عَنْ  جَرِيرِ بْنِ حَازِمٍ  ، عَنْ  شُعْبَةَ  ، عَنْ  عَلْقَمَةَ  ، عَنِ  ابْنِ بُرَيْدَةَ  ، عَنْ أَبِيهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَ حَدِيثِ  عَبْدِ الرَّحْمَنِ  .  4357  -  حَدَّثَنَا  بِهِ عَبْدُ الرَّحْمَنِ بْنُ عِيسَى ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ صَالِحٍ  عَنِ  اللَّيْثِ بْنِ سَعْدٍ ،  عَنْ  جَرِيرِ بْنِ حَازِمٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .         [10/262]","","Musnad al-Bazzar 4357","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن شعبة بن الحجاج عن جرير بن حازم عن الليث بن سعد عن عبد الله بن صالح المصري عن عبد الرحمن بن عيسى عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4365","4358  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  عَبْدُ الصَّمَدِ  نَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ لَعِبَ النَّرْدَشِيرَ فَكَأَنَّمَا غَمَسَ يَدَهُ فِي لَحْمِ خِنْزِيرٍ  وَدَمِهِ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا مِنْ رِوَايَةِ  بُرَيْدَةَ  ، وَلَا نَعْلَمُ لَهُ عَنْ  بُرَيْدَةَ  طَرِيقًا إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 4358","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن عبد الرحمن بن مهدي عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4366","4359  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى صَلَاةَ الْفَجْرِ ، فَقَامَ  أَعْرَابِيٌّ  ، فَقَالَ : مَنْ  دَعَا  لِلْجَمَلِ الْأَحْمَرِ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا وَجَدْتَ  .         [10/263]","","Musnad al-Bazzar 4359","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4367","4360  -  وَحَدَّثَنَاهُ  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  نَا  مُعَاوِيَةُ بْنُ هِشَامٍ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ ،  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .","","Musnad al-Bazzar 4360","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن معاوية بن هشام القصار عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4368","4361  -  حَدَّثَنَاهُ  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  نَا  مُعَاوِيَةُ بْنُ هِشَامٍ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  أَهْلُ الْجَنَّةِ عِشْرُونَ وَمِائَةُ         [10/264]      صَفٍّ ،  أُمَّتِي مِنْهَا ثَمَانُونَ صَفًّا  .","","Musnad al-Bazzar 4361","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن معاوية بن هشام القصار عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4369","4362  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  قَالَ  : ضِرَارُ بْنُ عَمْرٍو ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  الْأُمَمُ يَوْمَ الْقِيَامَةِ عِشْرُونَ وَمِائَةُ صَفٍّ  أُمَّتِي مِنْهَا ثَمَانُونَ صَفًّا  .","","Musnad al-Bazzar 4362","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن محارب بن دثار عن ضرار بن عمرو الملطي عن محمد بن فضيل بن غزوان عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4370","4363  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَا :  نَا  مُؤَمَّلٌ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ قُتِلَ دُونَ         [10/265]      مَالِهِ فَهُوَ  شَهِيدٌ  .  وَهَذَا الْحَدِيثُ إِنَّمَا يُرْوَى عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ  ، عَنْ  عَطَاءٍ  ، وَلَا نَعْلَمُ أَحَدًا قَالَ : عَنْ  عَلْقَمَةَ  ، عَنِ  ابْنِ بُرَيْدَةَ  ، عَنْ أَبِيهِ إِلَّا  مُؤَمَّلًا  عَنِ  الثَّوْرِيِّ  .","","Musnad al-Bazzar 4363","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن مؤمل بن إسماعيل العدوي عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4371","4364  -  حَدَّثَنَا  سَلَمَةُ بْنُ شَبِيبٍ ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  نَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَتَوَضَّأُ لِكُلِّ صَلَاةٍ حَتَّى كَانَ  يَوْمُ فَتْحِ مَكَّةَ  ; فَإِنَّهُ صَلَّى الصَّلَوَاتِ بِوُضُوءٍ وَاحِدٍ  ، وَمَسَحَ عَلَى خُفَّيْهِ فَقَالَ لَهُ  عُمَرُ  : إِنَّكَ صَنَعْتَ الْيَوْمَ شَيْئًا لَمْ تَصْنَعْهُ ، فَقَالَ : عَمْدًا صَنَعْتُهُ يَا  عُمَرُ  .","","Musnad al-Bazzar 4364","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن عبيد الله بن موسى عن سلمة بن شبيب المسمعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4372","4365  -  وَحَدَّثَنَاهُ  عَلِيُّ بْنُ الْحُسَيْنِ الدِّرْهَمِيُّ ، قَالَ :  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ، عَنِ         [10/266]      النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .","","Musnad al-Bazzar 4365","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن محارب بن دثار عن سفيان الثوري عن معتمر بن سليمان عن علي بن الحسين بن مطر الدرهمي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4373","4366  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ، وَبِشْرُ بْنُ آدَمَ ، قَالَا :  نَا  حَرَمِيُّ بْنُ عُمَارَةَ بْنِ أَبِي حَفْصَةَ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  حُرْمَةُ  نِسَاءِ الْمُجَاهِدِينَ عَلَى الْقَاعِدِينَ  كَحُرْمَةِ  أُمَّهَاتِهِمْ  ، وَمَا مِنْ أَحَدٍ مِنَ الْقَاعِدِينَ خَلَفَ رَجُلًا مِنَ الْمُجَاهِدِينَ فِي أَهْلِهِ إِلَّا قِيلَ لَهُ يَوْمَ الْقِيَامَةِ خُذْ مِنْ حَسَنَاتِهِ مَا شِئْتَ . قَالَ : فَمَا ظَنُّكُمْ  .         [10/267]      وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ  الثَّوْرِيُّ  وَغَيْرُهُ عَنْ  عَلْقَمَةَ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  شُعْبَةَ  إِلَّا  حَرَمِيٌّ  .","","Musnad al-Bazzar 4366","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن شعبة بن الحجاج عن حرمي بن عمارة العتكي عن بشر بن آدم بن يزيد عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4374","4367  -  حَدَّثَنَا  عَبْدَةُ ، قَالَ :  نَا  يَحْيَى بْنُ آدَمَ ، قَالَ :  نَا  مِسْعَرٌ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4367","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن مسعر بن كدام عن يحيى بن آدم عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4375","4368  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ بُنْدَارٌ ، وَبِشْرُ بْنُ آدَمَ ، قَالَا :  نَا  حَرَمِيُّ         [10/268]      بْنُ عُمَارَةَ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا مَرَّ عَلَى الْقُبُورِ ، قَالَ : "" السَّلَامُ عَلَى دِيَارِ قَوْمٍ مُؤْمِنِينَ  ، وَإِنَّا إِنْ شَاءَ اللهُ بِكُمْ  لَاحِقُونَ  . غَفَرَ اللهُ الْعَظِيمُ لَنَا وَلَكُمْ وَرَحِمَنَا وَإِيَّاكُمْ  .","","Musnad al-Bazzar 4368","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن شعبة بن الحجاج عن حرمي بن عمارة العتكي عن بشر بن آدم بن يزيد عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4376","4369  -  وَحَدَّثَنَاهُ  عَبْدَةُ ، قَالَ :  نَا  مُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَلْقَمَةَ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ ،  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَحَدِيثُ  شُعْبَةَ  ، عَنْ  عَلْقَمَةَ  لَا نَعْلَمُ رَوَاهُ عَنْ  شُعْبَةَ  إِلَّا  حَرَمِيُّ  بْنُ  عُمَارَةَ  .","","Musnad al-Bazzar 4369","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن معاوية بن هشام القصار عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4377","4370  -  حَدَّثَنَا  الْحَسَنُ بْنُ خَلَفٍ ، قَالَ :  نَا  إِسْحَاقُ بْنُ يُوسُفَ ، قَالَ :         [10/269]      نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ  رَجُلًا  سَأَلَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ مَوَاقِيتِ الصَّلَاةِ فَصَلَّى الظُّهْرَ حِينَ زَالَتِ الشَّمْسُ ، وَصَلَّى الْعَصْرَ حِينَ صَارَ ظِلُّ كُلِّ شَيْءٍ مِثْلَهُ ، وَصَلَّى الْمَغْرِبَ حِينَ غَرَبَتِ الشَّمْسُ ، وَصَلَّى الْعِشَاءَ حِينَ غَابَ  الشَّفَقُ  ، وَصَلَّى الْفَجْرَ حِينَ طَلَعَ الْفَجْرُ ، وَصَلَّى الظُّهْرَ حَيْثُ صَارَ ظِلُّ كُلِّ شَيْءٍ مِثْلَهُ ، وَالْعَصْرَ حِينَ صَارَ ظِلُّ كُلِّ شَيْءٍ مِثْلَيْهِ ، وَالْمَغْرِبَ حِينَ غَابَتِ الشَّمْسُ لِوَقْتِهَا بِالْأَمْسِ ، وَالْعَشَاءَ بَعْدَ مَا أَعْتَمَ ، وَصَلَّى الْفَجْرَ حِينَ  أَسْفَرَ  ، ثُمَّ قَالَ :  أَيْنَ السَّائِلُ عَنْ مَوَاقِيتِ الصَّلَاةِ ، مَا بَيْنَ هَذَيْنِ وَقْتٌ  .","","Musnad al-Bazzar 4370","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن إسحاق بن يوسف الأزرق عن الحسن بن خلف البزاز عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4378","4371  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ :  نَا  حَرَمِيٌّ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -         [10/270]      عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي مَوَاقِيتِ الصَّلَاةِ .  وَلَمْ يَكُنْ عِنْدَ  بُنْدَارٍ  مِنْ كَلَامِهِ إِلَّا هَذَا ، وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ عَنْ  شُعْبَةَ  إِلَّا  حَرَمِيٌّ  ، وَلَا رَوَاهُ عَنِ  الثَّوْرِيِّ  إِلَّا  إِسْحَاقُ بْنُ يُوسُفَ  .","","Musnad al-Bazzar 4371","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن شعبة بن الحجاج عن حرمي بن عمارة العتكي عن محمد بن بشار بندار عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4379","4372  -  حَدَّثَنَا  أَبُو كُرَيْبٍ ، قَالَ :  نَا  عَلِيُّ بْنُ قَادِمٍ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَوَضَّأَ مَرَّةً مَرَّةً  .","","Musnad al-Bazzar 4372","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن علي بن قادم الخزاعي عن أبو كريب محمد بن العلاء عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4380","4373  -  حَدَّثَنَا  سَلَمَةُ بْنُ شَبِيبٍ ، قَالَ :  نَا  الْفَارَيَابِيُّ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  كُنْتُ نَهَيْتُكُمْ عَنْ زِيَارَةِ الْقُبُورِ  فَقَدْ أُذِنَ  لِمُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي زِيَارَةِ قَبْرِ أُمِّهِ فَزُورُوهَا مَا         [10/271]      بَدَا لَكُمْ ؛ فَإِنَّهَا تُذَكِّرُ الْآخِرَةَ ، وَنَهَيْتُكُمْ عَنْ لُحُومِ الْأَضَاحِيِّ أَنْ تَأْكُلُوهَا فَوْقَ ثَلَاثٍ وَإِنَّمَا أَرَدْنَا بِذَلِكَ أَنْ يَتَّسِعَ أَهْلُ السَّعَةِ عَلَى مَنْ لَا سَعَةَ لَهُ ، فَكُلُوا مِمَّا بَدَا لَكُمْ ، وَنَهَيْتُكُمْ عَنِ الظُّرُوفِ وَإِنَّ الظُّرُوفَ لَا تُحِلُّ شَيْئًا وَلَا تُحَرِّمُهُ ، وَكُلُّ مُسْكِرٍ حَرَامٌ  .","","Musnad al-Bazzar 4373","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن محمد بن يوسف الفريابي عن سلمة بن شبيب المسمعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4381","4374  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ عِيسَى ، قَالَ :  نَا  أَبُو زُهَيْرٍ الْمَرْوَزِيُّ ،         [10/272]      قَالَ :  نَا  ابْنُ الْأَشْجَعِيِّ ،  عَنْ  أَبِيهِ  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَيْسَ شَيْءٌ إِلَّا وَهُوَ أَطْوَعُ لِلهِ تَبَارَكَ وَتَعَالَى  مِنَ ابْنِ آدَمَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  أَبُو زُهَيْرٍ  عَنِ  ابْنِ الْأَشْجَعِيِّ  عَنْ أَبِيهِ عَنِ  الثَّوْرِيِّ  ، وَحَدِيثُ  عَلِيِّ بْنِ قَادِمٍ  لَا نَعْلَمُ رَوَاهُ عَنِ  الثَّوْرِيِّ  إِلَّا  عَلِيُّ بْنُ قَادِمٍ  وَلَمْ يُتَابَعْ عَلَيْهِ .","","Musnad al-Bazzar 4374","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن عبيد الله بن عبيد الرحمن الأشجعي عن أبو عبيدة بن عبيد الله الأشجعي عن محمد بن إسحاق المروزي عن عبد الرحمن بن عيسى عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4382","4375  -  وَحَدَّثَنَا  حُمَيْدُ بْنُ الرَّبِيعِ ، قَالَ :  نَا  يَحْيَى بْنُ الْيَمَانِ ، قَالَ :  نَا         [10/273]      سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - زَارَ قَبْرَ أُمِّهِ  فِي أَلْفِ  مُقَنَّعٍ  .  وَهَذَا الْحَدِيثُ رَوَاهُ جَمَاعَةٌ ، عَنْ  يَحْيَى بْنِ الْيَمَانِ  ، عَنْ  سُفْيَانَ  ، عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ  ، عَنْ أَبِيهِ ، وَلَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  يَحْيَى  مُوصَلًا  مِمَّنْ يُحْتَجُّ بِحَدِيثِهِ  .","","Musnad al-Bazzar 4375","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن يحيى بن يمان العجلي عن حميد بن الربيع الجلاد عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4383","وَإِنَّمَا يُرْوَى عَنْ  سُفْيَانَ  عَنْ  عَلْقَمَةَ  بْنِ  مَرْثَدٍ  مُرْسَلًا  .  4376  -  وَحَدَّثَنَاهُ  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبٍ ، قَالَ :  نَا  يَحْيَى بْنُ الْيَمَانِ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَلْقَمَةَ بْنَ مَرْثَدٍ  مُرْسَلًا  .","","Musnad al-Bazzar 4376","","علقمة بن مرثد الحضرمي عن سفيان الثوري عن يحيى بن يمان العجلي عن إسحاق بن إبراهيم الشهيدي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4384","4377  -  حَدَّثَنَا  عَبْدَةُ بْنُ عُبَيْدِ اللهِ ، قَالَ :  نَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  أَنَا  الْمَسْعُودِيُّ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ         [10/274]      اللهُ عَنْهُ - قَالَ :  جَاءَ  رَجُلٌ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي أُحِبُّ الْخَيْلَ ، فَهَلْ فِي الْجَنَّةِ مِنْ خَيْلٍ ؟ قَالَ :  إِنْ يُدْخِلْكَ اللهُ الْجَنَّةَ فَلَا تَشَاءُ أَنْ تَرْكَبَ فَرَسًا مِنْ يَاقُوتَةٍ حَمْرَاءَ ،  يَطِيرُ بِكَ فِي الْجَنَّةِ حَيْثُ شِئْتَ إِلَّا رَكِبْتَ "" ، قَالَ : وَأَتَى آخَرُ ، فَقَالَ : يَا رَسُولَ اللهِ ، أَفِي الْجَنَّةِ إِبِلٌ ؟ قَالَ : "" إِنْ يُدْخِلْكَ اللهُ الْجَنَّةَ فَإِنَّ لَكَ فِيهَا مَا اشْتَهَتْ نَفْسُكَ وَلَذَّتْ عَيْنُكَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَلْقَمَةَ  عَنِ  ابْنِ بُرَيْدَةَ  عَنْ أَبِيهِ إِلَّا         [10/275]      الْمَسْعُودِيُّ  ، وَرَوَاهُ غَيْرُ  الْمَسْعُودِيِّ  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ  عَنِ  ابْنِ سَابِطٍ  .","","Musnad al-Bazzar 4377","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن يزيد بن هارون عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4385","4378  -  حَدَّثَنَا  سَلَمَةُ بْنُ شَبِيبٍ ، قَالَ :  نَا  عَمْرُو بْنُ عُثْمَانَ ، قَالَ :  نَا  مُوسَى بْنُ أَعْيَنَ ،  عَنْ  لَيْثٍ ،  عَنْ  عَلْقَمَةَ ، بْنُ  مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لِأَهْلِ الذِّمَّةِ مَا أَسْلَمُوا عَلَيْهِ مِنْ أَمْوَالِهِمْ وَأَرْضِيهِمْ  وَذَرَارِيِّهِمْ وَعَبِيدِهِمْ وَمَاشِيَتِهِمْ لَيْسَ عَلَيْهِمْ فِيهَا إِلَّا الصَّدَقَةُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  بُرَيْدَةُ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا إِلَّا هَذَا الطَّرِيقَ عَنْ  بُرَيْدَةَ  .  في طبعة مكتبة العلوم والحكم : عن ، وقال المحقق: كذا بالأصل ، والصواب ( بن ) .أ.هـ وقد صوبناه من كشف الأستار .","","Musnad al-Bazzar 4378","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن ليث بن أبي سليم عن موسى بن أعين الجزري عن عمرو بن عثمان بن سيار الرقي عن سلمة بن شبيب المسمعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4386","4379  -  حَدَّثَنَا  أَبُو غَسَّانَ رَوْحُ بْنُ حَاتِمٍ ، قَالَ :  نَا  عَمْرُو بْنُ سُفْيَانَ ، قَالَ :  نَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  عَلْقَمَةَ بْنِ         [10/276]      مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  ذُكِرَتِ الطِّيَرَةُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  مَنْ أَصَابَهُ مِنْ ذَلِكَ شَيْءٌ وَلَا بُدَّ  فَكَانَ قَوْلُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا بُدَّ أَحَبَّ إِلَيْنَا مِنْ كَذَا "" فَلْيَقُلِ : اللَّهُمَّ لَا طَيْرَ إِلَّا طَيْرُكَ وَلَا خَيْرَ إِلَّا خَيْرُكَ وَلَا إِلَهَ غَيْرُكَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِهَذَا اللَّفْظِ إِلَّا  بُرَيْدَةُ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا إِلَّا هَذَا الطَّرِيقَ ، وَلَا نَعْلَمُ  أَسْنَدَ  مُحَمَّدُ بْنُ جُحَادَةَ  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 4379","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن محمد بن جحادة الأودي عن الحسن بن أبي جعفر الجفري عن عمرو بن سفيان القطيعي عن روح بن حاتم البصري عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4387","4380  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ الْعُرُوقِيُّ ، قَالَ :  نَا  عَمْرُو بْنُ سُفْيَانَ ، قَالَ :  نَا  الْحَسَنُ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  لَيْثٍ يَعْنِي ابْنَ أَبِي سُلَيْمٍ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَجُلًا كَانَ فِي الطَّوَافِ حَامِلًا أُمَّهُ يَطُوفُ بِهَا ، فَسَأَلَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - هَلْ أَدَّيْتُ حَقَّهَا ؟ قَالَ :  لَا ، وَلَا بِزَفْرَةٍ وَاحِدَةٍ  أَوْ كَمَا قَالَ .         [10/277]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا مِنْ هَذَا الْوَجْهِ  .","","Musnad al-Bazzar 4380","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن ليث بن أبي سليم عن الحسن بن أبي جعفر الجفري عن عمرو بن سفيان القطيعي عن إبراهيم بن المستمر العروقي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4388","4381  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْوَضَّاحِ الْكُوفِيُّ ، قَالَ :  نَا  يَحْيَى بْنُ الْيَمَانِ ،  عَنْ  عَائِذِ بْنِ نُسَيْرٍ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَنَّهُ ذَكَرَ الْحَوْضَ ، فَقَالَ :  تَرَى فِيهِ أَبَارِيقَ عَدَدَ نُجُومِ السَّمَاءِ  .  وَفِيهِ كَلَامٌ غَيْرُ هَذَا ،  وَهُوَ  حَدِيثٌ  غَرِيبٌ  .","","Musnad al-Bazzar 4381","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن عائذ بن نسير عن يحيى بن يمان العجلي عن عبد الله بن الوضاح عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4389","4382  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُعَاذُ بْنُ هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا تَقُولُوا لِلْمُنَافِقِ  سَيِّدٌ  ; فَإِنَّكُمْ إِنْ فَعَلْتُمْ أَغْضَبْتُمْ رَبَّكُمْ تَبَارَكَ وَتَعَالَى  .","","Musnad al-Bazzar 4382","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4390","[10/278]      4383  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُعَاذُ بْنُ هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِذَا أَبْرَدْتُمْ إِلَيَّ  بَرِيدًا  فَأَبْرِدُوهُ حَسَنَ الْوَجْهِ  حَسَنَ الِاسْمِ  .  وَهَذَانِ الْحَدِيثَانِ لَا نَعْلَمُ رَوَاهُمَا عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  عَنْ أَبِيهِ إِلَّا  قَتَادَةُ  .","","Musnad al-Bazzar 4383","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4391","4384  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  نَا  الْمُثَنَّى بْنُ سَعِيدٍ ،  عَنْ  قَتَادَةَ ، عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَوْتُ الْمُؤْمِنِ بِعَرَقِ الْجَبِينِ  .         [10/279]","","Musnad al-Bazzar 4384","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن قتادة بن دعامة عن المثنى بن سعيد القسام عن يحيى القطان عن الفلاس عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4392","4385  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  يُوسُفُ بْنُ يَعْقُوبَ الضُّبَعِيُّ ، قَالَ :  نَا  كَهْمَسُ بْنُ الْحَسَنِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ ،  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَلَا نَعْلَمُ  أَسْنَدَ  كَهْمَسٌ  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  عَنْ أَبِيهِ غَيْرَ هَذَا الْحَدِيثِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  كَهْمَسٍ  إِلَّا  يُوسُفُ بْنُ يَعْقُوبَ  .","","Musnad al-Bazzar 4385","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن كهمس بن الحسن النمري عن يوسف بن يعقوب بن أبي القاسم السلعي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4393","4386  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْأَسْفَاطِيُّ ، قَالَ :  نَا  شُعَيْبُ بْنُ بَيَانٍ ، قَالَ :  نَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ         [10/280]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4386","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن قتادة بن دعامة عن عمران بن داور القطان عن شعيب بن بيان الصفار عن محمد بن يزيد بن عبد الملك الأسفاطي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4394","4387  -  وَحَدَّثَنَاهُ  بِشْرُ بْنُ آدَمَ ، قَالَ :  نَا  مُحَمَّدُ بْنُ عُبَيْدٍ ، قَالَ :  نَا  صَالِحُ بْنُ حَبَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ  الْحَبَّةَ  السَّوْدَاءَ  شِفَاءٌ مِنْ كُلِّ دَاءٍ إِلَّا  السَّامَ  .","","Musnad al-Bazzar 4387","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن صالح بن حيان القرشي عن محمد بن عبيد بن أبي أمية عن بشر بن آدم بن يزيد عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4395","4388  -  حَدَّثَنَا  الْفَضْلُ بْنُ سَهْلٍ ، وَالْحَسَنُ بْنُ يُونُسَ ، قَالَا :  نَا  إِسْحَاقُ بْنُ مَنْصُورٍ ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  جَابِرٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَنْ يُبْتَلَى عَبْدٌ بِشَيْءٍ أَشَدَّ عَلَيْهِ مِنَ  الشِّرْكِ  بِاللهِ  ، وَلَنْ يُبْتَلَى عَبْدٌ بِشَيْءٍ بَعْدَ         [10/281]      الشِّرْكِ  بِاللهِ أَشَدَّ عَلَيْهِ مِنْ ذَهَابِ بَصَرِهِ ، وَلَنْ يُبْتَلَى عَبْدٌ بِذَهَابِ بَصَرِهِ فَيَصْبِرُ إِلَّا غُفِرَ لَهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  بُرَيْدَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  إِسْرَائِيلَ  إِلَّا  إِسْحَاقُ بْنُ مَنْصُورٍ  .","","Musnad al-Bazzar 4388","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن جابر الجعفي عن إسرائيل بن يونس بن أبي إسحاق عن إسحاق بن منصور السلولي عن الحسن بن يونس الزيات عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4396","4389  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِرْدَاسٍ الْأَنْصَارِيُّ ، قَالَ :  نَا  يَحْيَى بْنُ كَثِيرٍ أَبُو النَّضْرِ  قَالَ  أَبُو مَسْعُودٍ الْجُرَيْرِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  كَيْفَ تَقُولُ يَا  حَمْزَةُ  إِذَا أَوَيْتَ إِلَى فِرَاشِكَ "" ، قَالَ : أَقُولُ : كَذَا وَكَذَا ، قَالَ : "" وَكَيْفَ تَقُولُ أَنْتَ يَا  عَلِيُّ  "" . قَالَ : أَقُولُ : كَذَا وَكَذَا ، أَحْسَبُهُ قَالَ :  إِذَا أَوَيْتَ إِلَى فِرَاشِكَ فَقُلِ الْحَمْدُ لِلهِ الَّذِي مَنَّ عَلَيَّ وَأَفْضَلَ  ، الْحَمْدُ لِلهِ رَبِّ الْعَالَمِينَ رَبِّ كُلِّ شَيْءٍ وَإِلَهِ كُلِّ شَيْءٍ أَعُوذُ بِكَ مِنَ النَّارِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنِ الْجُرَيْرِيِّ إِلَّا  يَحْيَى بْنُ كَثِيرٍ  وَلَمْ يَكُنْ بِالْحَافِظِ  .","","Musnad al-Bazzar 4389","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن سعيد بن إياس الجريري عن يحيى بن كثير البصري عن محمد بن مرداس الأنصاري عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4397","[10/282]      4390  -  سَمِعْتُ  عَمْرَو بْنَ عَلِيٍّ يَقُولُ  سَمِعْتُ  يَحْيَى بْنَ كَثِيرٍ يَقُولُ :  حَدَّثَنَا  الْجُرَيْرِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  صَلَّى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا بِأَصْحَابِهِ فَلَمَّا انْصَرَفَ ، قَالَ : "" كَيْفَ رَأَيْتُمْ صَلَاتِي "" قَالُوا : مَا أَحْسَنَ مَا صَلَّيْتَ ، قَالَ :  قَدْ  نَسِيتُ  آيَةَ كَذَا إِنَّ مِنْ حُسْنِ صَلَاةِ الْمَرْءِ أَنْ يَحْفَظَ قِرَاءَةَ الْإِمَامِ  .  قَالَ  عَمْرُو بْنُ عَلِيٍّ :  فَلَمْ أُحَدَّثْ بِهِ ، وَلَمْ أُحَدِّثْ بِهِ عَنْ هَذَا الرَّجُلِ وَلَمْ أَكْتُبْهُ .  قَالَ أَبُو بَكْرٍ وَأَنَا فَلَمْ أَكْتُبْهُ إِنَّمَا حَفِظْتُهُ ، عَنْ  عَمْرِو بْنِ عَلِيٍّ  ، وَلَا نَعْلَمُ يُرْوَى هَذَا الْكَلَامُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا مِنْ هَذَا الْوَجْهِ .","","Musnad al-Bazzar 4390","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن سعيد بن إياس الجريري عن يحيى بن كثير العنبري عن الفلاس عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4398","4391  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ،  نَا  إِسْحَاقُ بْنُ شَاهِينَ الْوَاسِطِيُّ ، قَالَ :  نَا  خَالِدُ بْنُ عَبْدِ اللهِ ، قَالَ :  نَا  أَجْلَحُ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ         [10/283]      أَبِيهِ -  رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَ إِلَى  الْيَمَنِ  جَيْشَيْنِ وَأَمَّرَ عَلَى أَحَدِهِمَا  عَلِيَّ بْنَ أَبِي طَالِبٍ  - رَضِيَ اللهُ عَنْهُ - وَعَلَى الْآخَرِ  خَالِدَ بْنَ الْوَلِيدِ  ، وَقَالَ لَهُمَا :  إِذَا اتَّفَقْتُمَا  فَعَلِيٌّ  عَلَى النَّاسِ ، وَإِنْ تَفَرَّقْتُمَا فَكُلُّ وَاحِدٍ عَلَى أَصْحَابِهِ  فَالْتَقَيْنَا فَظَفِرَ الْمُسْلِمُونَ عَلَى الْمُشْرِكِينَ فَقَتَلْنَا الْمُقَاتِلَةَ وَسَبَيْنَا الذُّرِّيَّةَ ، فَاصْطَفَى  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - امْرَأَةً مِنَ السَّبْيِ لِنَفْسِهِ ، فَكَتَبَ مَعِي  خَالِدُ بْنُ الْوَلِيدِ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِذَلِكَ وَأَمَرَنِي  خَالِدٌ  أَنْ أَنَالَ مِنْ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - فَلَمَّا قُرِئَ الْكِتَابُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نِلْتُ مِنْ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - قَالَ : فَرَأَيْتُ الْغَضَبَ فِي وَجْهِهِ ، فَقُلْتُ : يَا نَبِيَّ اللهِ ، بَعَثْتَنِي مَعَ رَجُلٍ وَأَمَرْتَنِي بِطَاعَتِهِ فَفَعَلْتُ مَا أُرْسِلْتُ بِهِ ، فَقَالَ : "" يَا  بُرَيْدَةُ ،  لَا  تَقَعْ  فِي  عَلِيٍّ  فَإِنَّهُ مِنِّي وَأَنَا مِنْهُ  .  وَلَا نَعْلَمُ رَوَى هَذَا الْكَلَامَ ، عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  ، عَنْ أَبِيهِ  بِإِسْنَادٍ  أَحْسَنَ مِنْ هَذَا  الْإِسْنَادِ .","","Musnad al-Bazzar 4391","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن أجلح بن عبد الله الكندي عن خالد بن عبد الله الطحان عن إسحاق بن شاهين الدهقاني عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4399","وَقَدْ رَوَاهُ  الْجُرَيْرِيُّ  ، عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  ، عَنْ أَبِيهِ .  4392  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ مِرْدَاسٍ الْأَنْصَارِيُّ ، قَالَ :  نَا  الْجُرَيْرِيُّ ،         [10/284]      عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4392","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن سعيد بن إياس الجريري عن محمد بن مرداس الأنصاري عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4400","4393  -  حَدَّثَنَا  يَحْيَى بْنُ دَاوُدَ ، قَالَ :  نَا  وَكِيعُ بْنُ الْجَرَّاحِ  عَنْ  دَلْهَمِ بْنِ صَالِحٍ ،  عَنْ  جُبَيْرِ بْنِ عَبْدِ اللهِ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ  النَّجَاشِيَّ  أَهْدَى إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خُفَّيْنِ أَسْوَدَيْنِ سَاذَجَيْنِ فَلَبِسَهُمَا  وَكَانَ يَمْسَحُ عَلَيْهِمَا  .","","Musnad al-Bazzar 4393","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن حجير بن عبد الله الكندي عن دلهم بن صالح الكندي عن وكيع بن الجراح عن يحيى بن داود بن ميمون الواسطي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4401","4394  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو أَحْمَدَ ، قَالَ : شَرِيكٌ ،  عَنْ  أَبِي رَبِيعَةَ الْإِيَادِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ اللهَ تَبَارَكَ وَتَعَالَى يُحِبُّ أَرْبَعَةً وَأَمَرَنِي بِحُبِّهِمْ  قِيلَ : يَا رَسُولَ اللهِ ، مَنْ هُمْ ؟ قَالَ : ""  عَلِيٌّ  مِنْهُمْ ،  وَأَبُو ذَرٍّ الْغِفَارِيُّ ،  وَسَلْمَانُ الْفَارِسِيُّ ،  وَالْمِقْدَادُ بْنُ الْأَسْوَدِ الْكِنْدِيُّ  .","","Musnad al-Bazzar 4394","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن أبو ربيعة الإيادي عن شريك بن عبد الله النخعي عن محمد بن عبد الله بن الزبير عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4402","[10/285]      4395  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو أَحْمَدَ ، قَالَ :  نَا  شَرِيكٌ ،  عَنْ  أَبِي رَبِيعَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِعَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - :  إِنَّ لَكَ أَوَّلَ نَظْرَةٍ فَلَا تُتْبِعِ النَّظْرَةَ النَّظْرَةَ  .  وَلَا نَعْلَمُ رَوَى هَذَيْنِ الْحَدِيثَيْنِ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  إِلَّا  أَبَا رَبِيعَةَ  ، وَلَا نَعْلَمُ رَوَى عَنْ  أَبِي رَبِيعَةَ  إِلَّا  شَرِيكًا  وَالْحَسَنَ بْنَ صَالِحٍ  .","","Musnad al-Bazzar 4395","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن أبو ربيعة الإيادي عن شريك بن عبد الله النخعي عن محمد بن عبد الله بن الزبير عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4403","4396  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  بَكْرُ بْنُ يَحْيَى بْنِ زَبَّانَ الْعَنَزِيُّ ،         [10/286]      قَالَ :  نَا  مِنْدَلُ بْنُ عَلِيٍّ ، أَوْ حِبَّانُ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَطَاءٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  ، قَالَ :  دَخَلَ قَوْمٌ عَلَى أَبِي ، فَقَالُوا : أَخْلِنَا ، فَقَالَ لِأُمِّي وَمَنْ حَوْلَهُ مِنْ أَهْلِ الْبَيْتِ : قُومُوا ، فَقَامُوا وَبَقِيتُ أَنَا ، فَقَالُوا : أَخْلِنَا ، فَقَالَ : إِنَّمَا هُوَ ابْنِي ، قَالُوا :  مَنْ كَانَ أَحَبَّ النَّاسِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ  - .","","Musnad al-Bazzar 4396","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عبد الله بن عطاء الطائفي عن حبان بن علي العنزي عن بكر بن يحيى العنزي عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4404","4397  -  حَدَّثَنَا  عَمْرُو بْنُ مَالِكٍ ، قَالَ :  نَا  أَبُو تُمَيْلَةَ يَحْيَى بْنُ وَاضِحٍ ، قَالَ :  نَا  خَالِدُ بْنُ عُبَيْدٍ أَبُو عِصَامٍ ، قَالَ :  أَخْبَرَنِي  عَبْدُ اللهِ بْنُ         [10/287]      بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ  ذَهَبَ بِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى مَوْضِعٍ بِالْبَادِيَةِ ؛ أَرْضٍ  سَبَخَةٍ  ، حَوْلَهَا مَاءٌ ، قَرِيبَةٌ مِنْ  مَكَّةَ  ، فَقَالَ :  مِنْ هَذَا الْمَوْضِعِ تَخْرُجُ الدَّابَّةُ  فَإِذَا مَوْضِعُ شِبْرٍ فِي فِتْرٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  بُرَيْدَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  مِنْ هَذَا الْوَجْهِ .","","Musnad al-Bazzar 4397","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن خالد بن عبيد العتكي عن يحيى بن واضح الأنصاري عن عمرو بن مالك بن عمر الراسبي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4405","4398  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُتَوَكِّلِ وَيَعْقُوبُ بْنُ إِبْرَاهِيمَ وَاللَّفْظُ  لِيَعْقُوبَ  ، قَالَا :  نَا  أَبُو تُمَيْلَةَ ، قَالَ :  أَنَا  الزُّبَيْرُ بْنُ جُنَادَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَمَّا كَانَ لَيْلَةَ أُسْرِيَ بِهِ فَأَتَى  جِبْرِيلُ  الصَّخْرَةَ الَّتِي  بِبَيْتِ الْمَقْدِسِ  فَوَضَعَ أُصْبُعَهُ فِيهَا فَخَرَقَهَا فَشَدَّ بِهَا الْبُرَاقَ  .         [10/288]      وَلَا نَعْلَمُ رَوَاهُ عَنِ  الزُّبَيْرِ بْنِ جُنَادَةَ  إِلَّا  أَبُو تُمَيْلَةَ  ، وَلَا نَعْلَمُ هَذَا الْحَدِيثَ يُرْوَى إِلَّا عَنْ  بُرَيْدَةَ  .","","Musnad al-Bazzar 4398","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الزبير بن جنادة الهجري عن يحيى بن واضح الأنصاري عن يعقوب بن إبراهيم بن كثير عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4406","4399  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُنْذِرِ ، قَالَ :  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ، قَالَ :  نَا  بَشِيرُ بْنُ الْمُهَاجِرِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  يَجِيءُ قَوْمٌ صِغَارُ الْعُيُونِ عِرَاضُ الْوُجُوهِ كَأَنَّ وُجُوهَهُمُ  الْمَجَانُّ  الْمُطْرَقَةُ  فَيُلْحِقُونَ أَهْلَ الْإِسْلَامِ بِمَنَابِتِ الشِّيحِ كَأَنِّي أَنْظُرُ إِلَيْهِمْ قَدْ رَبَطُوا خُيُولَهُمْ  بِسَوَارِي  الْمَسْجِدِ ، قِيلَ : يَا رَسُولَ اللهِ مَنْ هُمْ ؟ قَالَ : هُمُ  التُّرْكُ  .","","Musnad al-Bazzar 4399","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن بشير بن المهاجر الغنوي عن محمد بن فضيل بن غزوان عن علي بن المنذر العلاف عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4407","4400  -  حَدَّثَنَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ، قَالَ :  نَا  جَعْفَرُ بْنُ         [10/289]      عَوْنٍ ، قَالَ :  نَا  بَشِيرُ بْنُ الْمُهَاجِرِ ، قَالَ :  نَا  ابْنُ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا تَمْضِي مِائَةُ سَنَةٍ وَعَيْنٌ تَطْرِفُ  .","","Musnad al-Bazzar 4400","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن بشير بن المهاجر الغنوي عن جعفر بن عون المخزومي عن أحمد بن عثمان بن حكيم عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4408","4401  -  حَدَّثَنَا  أَحْمَدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  جَعْفَرُ بْنُ عَوْنٍ ،  عَنْ  بَشِيرِ بْنِ الْمُهَاجِرِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  كُنْتُ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَبَلَغَهُ أَنَّ  امْرَأَةً مِنَ الْأَنْصَارِ  مَاتَ ابْنٌ لَهَا فَحَزِنَتْ عَلَيْهِ ، فَقَامَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهُ أَصْحَابُهُ فَلَمَّا بَلَغَ بَابَ الْمَرْأَةِ قِيلَ لِلْمَرْأَةِ : إِنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُرِيدُ أَنْ يَدْخُلَ عَلَيْهَا يُعَزِّيهَا ، فَدَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أَمَا أَنَّهُ قَدْ بَلَغَنِي أَنَّكِ جَزِعْتِ عَلَى ابْنِكِ  فَقَالَتْ : يَا نَبِيَّ اللهِ وَمَا لِي لَا أَجْزَعُ وَأَنَا رَقُوبٌ لَا يَعِيشُ لِي وَلَدٌ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" إِنَّمَا  الرَّقُوبُ  الَّذِي يَعِيشُ وَلَدُهَا إِنَّهُ لَا يَمُوتُ لِامْرَأَةٍ مُسْلِمَةٍ أَوِ امْرِئٍ مُسْلِمٍ         [10/290]      نَسَمَةٌ  - أَوْ قَالَ - ثَلَاثَةٌ مِنَ الْوَلَدِ  فَيَحْتَسِبُهُمْ إِلَّا وَجَبَتْ لَهُ الْجَنَّةُ "" فَقَالَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - وَهُوَ عَلَى يَمِينِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : بِأَبِي وَأُمِّي وَاثْنَيْنِ ، قَالَ نَبِيُّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" وَاثْنَيْنِ  .","","Musnad al-Bazzar 4401","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن بشير بن المهاجر الغنوي عن جعفر بن عون المخزومي عن أحمد بن عثمان بن حكيم عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4409","4402  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ، قَالَ :  نَا  خَلَّادُ بْنُ يَحْيَى ، قَالَ :  نَا  بَشِيرُ بْنُ الْمُهَاجِرِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" قَالَ  بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ  وَضَمَّ أُصْبُعَيْهِ السَّبَّابَةَ وَالْوُسْطَى  .","","Musnad al-Bazzar 4402","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن بشير بن المهاجر الغنوي عن خلاد بن يحيى الأرحبي عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4410","4403  -  حَدَّثَنَا  عَمْرُو بْنُ مُوسَى السَّامِيُّ ، قَالَ :  نَا  أَبُو هِلَالٍ الرَّاسِبِيُّ مُحَمَّدُ بْنُ سُلَيْمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ قَالَ فِي الْإِسْلَامِ شِعْرًا  مُقْذِعًا  فَلِسَانُهُ هَدَرٌ  .         [10/291]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِهَذَا اللَّفْظِ إِلَّا  بُرَيْدَةُ  .","","Musnad al-Bazzar 4403","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن محمد بن سليم الراسبي عن عمرو بن موسى السامي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4411","4404  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الْأَدَمِيُّ ، قَالَ :  نَا  زَكَرِيَّا بْنُ يَحْيَى الْمَشَّاطُ ، قَالَ :  نَا  أَبُو هِلَالٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ أَتَى الْجُمُعَةَ فَلْيَغْتَسِلْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  بُرَيْدَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي هِلَالٍ  إِلَّا  زَكَرِيَّا بْنُ يَحْيَى  .","","Musnad al-Bazzar 4404","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن محمد بن سليم الراسبي عن زكريا بن يحيى بن الخطاب عن أحمد بن محمد بن المعلى الهدادي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4412","[10/292]      4405  -  حَدَّثَنَا  بِشْرُ بْنُ آدَمَ ، قَالَ :  نَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  نَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ حَلَفَ أَنَّهُ بَرِئَ مِنَ الْإِسْلَامِ فَإِنْ كَانَ كَاذِبًا فَهُوَ كَمَا قَالَ  ، وَإِنْ كَانَ صَادِقًا فَلَنْ يَرْجِعَ إِلَى الْإِسْلَامِ سَالِمًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  بُرَيْدَةَ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  بُرَيْدَةَ  إِلَّا  الْحُسَيْنَ بْنَ وَاقِدٍ  ، عَنِ  ابْنِ بُرَيْدَةَ  ، عَنْ أَبِيهِ .","","Musnad al-Bazzar 4405","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن بشر بن آدم بن يزيد عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4413","4406  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  نَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ فَأَقْبَلَ  الْحَسَنُ         [10/293]      وَالْحُسَيْنُ  - رَضِيَ اللهُ عَنْهُمَا - عَلَيْهِمَا قَمِيصَانِ يَعْثُرَانِ ، وَيَقُومَانِ فَنَزَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْمِنْبَرِ فَأَخَذَهُمَا فَوَضَعَهُمَا بَيْنَ يَدَيْهِ ، ثُمَّ قَالَ :  صَدَقَ اللهُ وَرَسُولُهُ         {      إِنَّمَا أَمْوَالُكُمْ وَأَوْلادُكُمْ فِتْنَةٌ         }      .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  بُرَيْدَةُ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 4406","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4414","4407  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  أَنَا  حُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  أَنَّ  سَلْمَانَ الْفَارِسِيَّ  لَمَّا قَدِمَ  الْمَدِينَةَ  أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمَائِدَةٍ عَلَيْهَا رُطَبٌ ، فَقَالَ لَهُ : "" مَا هَذَا يَا  سَلْمَانُ  ؟ "" قَالَ : صَدَقَةٌ تَصَدَّقْتُ بِهَا عَلَيْكَ وَعَلَى أَصْحَابِكَ ، قَالَ :  إِنَّا لَا نَأْكُلُ الصَّدَقَةَ  حَتَّى إِذَا كَانَ مِنَ الْغَدِ جَاءَ بِمِثْلِهَا فَوَضَعَهَا بَيْنَ يَدَيْهِ ، فَقَالَ : "" يَا  سَلْمَانُ  مَا هَذَا ؟ "" قَالَ : هَدِيَّةٌ ،         [10/294]      فَقَالَ : "" كُلُوا "" وَأَكَلَ وَنَظَرَ إِلَى الْخَاتَمِ فِي ظَهْرِهِ ، قَالَ : وَاشْتَرَاهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِكَذَا وَكَذَا دِرْهَمًا مِنْ قَوْمٍ مِنَ الْيَهُودِ ، وَعَلَى أَنْ يَغْرِسَ لَهُمْ كَذَا وَكَذَا مِنَ النَّخِيلِ ، وَيَعْمَلَ حَتَّى يُطْعِمَ ، قَالَ : فَغَرَسَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - النَّخْلَ إِلَّا نَخْلَةً وَاحِدَةً غَرَسَهَا غَيْرُهُ ، فَأَطْعَمَ النَّخْلُ مِنْ عَامِهِ إِلَّا النَّخْلَةَ الَّتِي غَرَسَهَا غَيْرُهُ فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" مَنْ غَرَسَهَا ؟ "" فَقَالُوا : فُلَانٌ ، فَقَلَعَهَا وَغَرَسَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَطْعَمَتْ مِنْ عَامِهَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  بُرَيْدَةَ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Musnad al-Bazzar 4407","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4415","4408  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ أَحْسَابَ أَهْلِ الدُّنْيَا فِي الدُّنْيَا الْمَالُ  .","","Musnad al-Bazzar 4408","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4416","[10/295]      4409  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  خَمْسٌ لَا يَعْلَمُهُنَّ إِلَّا اللهُ تَبَارَكَ وَتَعَالَى         {      إِنَّ اللهَ عِنْدَهُ عِلْمُ السَّاعَةِ وَيُنَـزِّلُ الْغَيْثَ وَيَعْلَمُ مَا فِي الْأَرْحَامِ وَمَا تَدْرِي نَفْسٌ مَاذَا تَكْسِبُ غَدًا وَمَا تَدْرِي نَفْسٌ بِأَيِّ أَرْضٍ تَمُوتُ إِنَّ اللهَ عَلِيمٌ خَبِيرٌ         }      .","","Musnad al-Bazzar 4409","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4417","4410  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، وَبِشْرُ بْنُ آدَمَ ، قَالَا :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  -         [10/296]      رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  صَاحِبُ الدَّابَّةِ أَحَقُّ بِصَدْرِهَا  وَالرَّجُلُ أَحَقُّ بِصَدْرِ فَرَسِهِ  .","","Musnad al-Bazzar 4410","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن بشر بن آدم بن يزيد عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4418","4411  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، وَبِشْرُ بْنُ آدَمَ ، قَالَا :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  نَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ فِي الْمَغْرِبِ وَالْعَشَاءِ         {      وَاللَّيْلِ إِذَا يَغْشَى         }      ،         {      وَالضُّحَى         }      وَكَانَ  يَقْرَأُ  فِي الظُّهْرِ وَالْعَصْرِ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ،         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      .","","Musnad al-Bazzar 4411","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن بشر بن آدم بن يزيد عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4419","[10/297]      4412  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ، قَالَ :  إِنَّ  مُعَاذَ بْنَ جَبَلٍ  صَلَّى بِأَصْحَابِهِ صَلَاةَ الْعِشَاءِ ، فَقَرَأَ         {      اقْتَرَبَتِ السَّاعَةُ وَانْشَقَّ الْقَمَرُ         }      فَصَلَّى رَجُلٌ وَانْصَرَفَ ، فَقَالَ  مُعَاذٌ  قَوْلًا شَدِيدًا ، فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَشْكُو أَنَّهُ كَانَ فِي نَخْلٍ لَهُ يَعْمَلُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اقْرَأْ فِيهِمَا بِـ         {      وَالشَّمْسِ وَضُحَاهَا         }      وَنَحْوِهَا مِنَ السُّوَرِ  .","","Musnad al-Bazzar 4412","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4420","4413  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  بَيْنَنَا وَبَيْنَهُمْ تَرْكُ الصَّلَاةِ ،         [10/298]      فَمَنْ  تَرَكَهَا  فَقَدْ كَفَرَ  .","","Musnad al-Bazzar 4413","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4421","4414  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  إِنَّ  زَيْدَ بْنَ الْحُبَابِ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ - رَضِيَ اللهُ عَنْهُ - :  أَنَّ  امْرَأَةً  سَوْدَاءَ نَذَرَتْ : إِنِ اللهُ تَبَارَكَ وَتَعَالَى نَجَّى رَسُولَهُ سَالِمًا فِي غَزْوَةٍ غَزَاهَا لَتَضْرِبَنَّ عَلَى رَأْسِهِ بِالدُّفِّ ، فَقَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَاءَتْ فَقَالَتْ : يَا رَسُولَ اللهِ ! إِنِّي كُنْتُ نَذَرْتُ : إِنِ اللهُ تَبَارَكَ وَتَعَالَى رَدَّكَ سَالِمًا أَنْ أَضْرِبَ عِنْدَكَ بِالدُّفِّ ، فَقَالَ : "" إِنْ كُنْتِ فَعَلْتِ فَافْعَلِي وَإِلَّا فَلَا "" ، قَالَ : فَضَرَبَتْ ، فَدَخَلَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - وَهِيَ تَضْرِبُ وَدَخَلَ غَيْرُهُ وَهِيَ تَضْرِبُ ، فَلَمَّا جَاءَ  عُمَرُ  طَرَحَتِ الدُّفَّ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَنَا هَا هُنَا  وَأَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - إِنِّي لَأَحْسِبُ أَنَّ الشَّيْطَانَ لَيَفْرَقُ مِنْكَ يَا  عُمَرُ  .         [10/299]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِهَذَا اللَّفْظِ إِلَّا  بُرَيْدَةُ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  بُرَيْدَةَ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 4414","","عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4422","4415  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  دَخَلْتُ الْجَنَّةَ فَرَأَيْتُ فِيهَا قَصْرًا فَقُلْتُ : لِمَنْ هَذَا ؟ قَالُوا : لِرَجُلٍ عَرَبِيٍّ  . فَقُلْتُ : أَنَا عَرَبِيٌّ ، قُلْتُ : لِمَنْ هَذَا الْقَصْرُ ؟ قَالُوا : لِرَجُلٍ مِنْ أُمَّةِ  مُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قُلْتُ : أَنَا  مُحَمَّدٌ  ، ثُمَّ قُلْتُ : لِمَنْ هَذَا الْقَصْرُ ؟ قَالُوا :  لِعُمَرَ بْنِ الْخَطَّابِ  - رَضِيَ اللهُ عَنْهُ - فَلَوْلَا غَيْرَتُكَ لَدَخَلْتُهُ "" ، قَالَ : يَا رَسُولَ اللهِ لَمْ أَكُنْ لِأَغَارَ عَلَيْكَ  .         [10/300]      وَهَذَا الْكَلَامُ قَدْ رُوِيَ بَعْضُهُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ وُجُوهٍ ، وَلَا نَعْلُمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  بُرَيْدَةَ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4415","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4423","4416  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَجُلًا قَالَ  يَوْمَ أُحُدٍ  : اللَّهُمَّ إِنْ كَانَ  مُحَمَّدٌ  عَلَى الْحَقِّ فَاخْسِفْ بِهِ ، فَخُسِفَ بِهِ  .","","Musnad al-Bazzar 4416","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4424","4417  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  فِي الْإِنْسَانِ ثَلَاثُمِائَةٍ وَسِتُّونَ مَفْصِلًا عَلَى كُلِّ مَفْصِلٍ صَدَقَةٌ  قَالُوا : يَا رَسُولَ اللهِ مَنْ يُطِيقُ ذَلِكَ ؟ قَالَ : ""  النُّخَاعَةُ  يَدْفِنُهَا صَدَقَةٌ ، وَإِمَاطَةُ  الْأَذَى  عَنِ الطَّرِيقِ صَدَقَةٌ ، وَرَكْعَتَيِ الضُّحَى تَكْفِي ذَلِكَ  .","","Musnad al-Bazzar 4417","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4425","[10/301]      4418  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  زَيْدُ بْنُ الْحُبَابِ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  سَمِعْتُ  خَشَفَةً  أَمَامِي ، فَقُلْتُ : مَنْ هَذَا قِيلَ  : بِلَالٌ  ، قُلْتُ : فَبِمَ سَبَقْتَنِي إِلَى الْجَنَّةِ "" ، قَالَ : مَا أَحْدَثْتُ إِلَّا تَوَضَّأْتُ ، وَلَا تَوَضَّأْتُ إِلَّا رَأَيْتُ لِلهِ تَبَارَكَ وَتَعَالَى عَلَيَّ رَكْعَتَيْنِ ، قَالَ فَبِهَا  .","","Musnad al-Bazzar 4418","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن زيد بن الحباب العكلي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4426","4419  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْأَزْدِيُّ ، قَالَ :  نَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ، قَالَ :  أَنَا  الْحُسَيْنُ بْنُ وَاقِدٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ         [10/302]      اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ عَلَى  حِرَاءٍ  فَتَحَرَّكَ ، فَقَالَ :  مَا عَلَيْكَ إِلَّا نَبِيٌّ أَوْ صِدِّيقٌ أَوْ شَهِيدٌ  ، وَكَانَ عَلَيْهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  وَعُمَرُ  وَعُثْمَانُ  وَعَلِيٌّ  - رَضِيَ اللهُ عَنْهُمْ أَجْمَعِينَ  - .","","Musnad al-Bazzar 4419","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الحسين بن واقد المروزي عن علي بن الحسن بن شقيق عن محمد بن يحيى بن أبي حاتم عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4427","4420  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  نَا  بَشِيرُ بْنُ الْمُهَاجِرِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ لِلهِ تَبَارَكَ وَتَعَالَى رِيحًا يَبْعَثُهَا عِنْدَ رَأْسِ مِائَةِ سَنَةٍ ،  فَتَقْبِضُ رُوحَ كُلِّ مُؤْمِنٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  بُرَيْدَةَ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4420","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن بشير بن المهاجر الغنوي عن عبيد الله بن موسى عن محمد بن معمر بن ربعي البحراني عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4428","4421  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو أَحْمَدَ ، قَالَ :  نَا  بَشِيرُ بْنُ الْمُهَاجِرِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ         [10/303]      رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  تَعَلَّمُوا الْبَقَرَةَ وَآلَ عِمْرَانَ فَإِنَّهُمَا يَجِيئَانِ يَوْمَ الْقِيَامَةِ كَأَنَّهُمَا غَمَامَتَانِ  أَوْ  غَيَايَتَانِ  أَوْ  فِرْقَانِ  مِنْ طَيْرٍ  صَوَافَّ  يُحَاجَّانِ عَنْ صَاحِبِهِمَا ، تَعَلَّمُوا الْبَقَرَةَ فَإِنَّ أَخْذَهَا بَرَكَةٌ ، وَتَرْكَهَا حَسْرَةٌ ، وَلَا تَسْتَطِيعُهَا  الْبَطَلَةُ  .  هَذَا لَفْظُ  بَشِيرٍ  أَوْ نَحْوُهُ .  وَإِنَّمَا مَعْنَى "" يَجِيئَانِ يَوْمَ الْقِيَامَةِ "" يَجِيءُ ثَوَابُهُمَا كَمَا يُرْوَى عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ ، قَالَ : "" إِنَّ اللُّقْمَةَ لَتَجِيءُ مِثْلَ  أُحُدٍ  "" وَقَالَ : "" ظِلُّ الْمُؤْمِنِ يَوْمَئِذٍ صَدَقَتُهُ "" فَإِنَّمَا هَذَا كُلُّهُ عَلَى ثَوَابِهِ  .","","Musnad al-Bazzar 4421","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن بشير بن المهاجر الغنوي عن محمد بن عبد الله بن الزبير عن الفلاس عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4429","4422  -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ، قَالَ :  نَا  حَيَّانُ بْنُ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  بَيْنَ  أَذَانَيْنِ  صَلَاةٌ إِلَّا الْمَغْرِبَ  .         [10/304]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ إِلَّا  بُرَيْدَةُ  ، وَلَا نَعْلَمُ ؟ رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  إِلَّا  حَيَّانُ بْنُ عُبَيْدِ اللهِ  ،  وَحَيَّانُ  رَجُلٌ مِنْ  أَهْلِ الْبَصْرَةِ  مَشْهُورٌ  لَيْسَ بِهِ بَأْسٌ  .","","Musnad al-Bazzar 4422","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن حيان بن عبيد الله بن حيان البصري عن عبد الواحد بن غياث عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4430","4423  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زِيَادٍ ، قَالَ :  نَا  ابْنُ عُيَيْنَةَ ، قَالَ :  نَا  بَشِيرُ بْنُ الْمُهَاجِرِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  أَهْدَى  الْمُقَوْقِصُ الْقِبْطِيُّ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَارِيَتَيْنِ أُخْتَيْنِ  إِحْدَاهُمَا  مَارِيَةُ أُمُّ إِبْرَاهِيمَ بْنِ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [10/305]      وَالْأُخْرَى وَهَبَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِحَسَّانَ بْنِ ثَابِتٍ  ، وَهِيَ  أُمُّ عَبْدِ الرَّحْمَنِ بْنِ ثَابِتٍ  ، وَأَهْدَى لَهُ بَغْلَةً فَقَبِلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَلِكَ مِنْهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  بُرَيْدَةُ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  إِلَّا  بَشِيرُ بْنُ الْمُهَاجِرِ  ،  وَمُحَمَّدُ بْنُ زِيَادٍ  وَهِمَ  فِي هَذَا الْحَدِيثِ ، فَرَوَاهُ عَنِ  ابْنِ عُيَيْنَةَ  ،  وَابْنُ عُيَيْنَةَ  فَلَيْسَ عِنْدَهُ عَنْ  بَشِيرِ بْنِ الْمُهَاجِرِ  ، وَلَكِنْ رَوَى هَذَا الْحَدِيثَ عَنْ  بَشِيرِ بْنِ الْمُهَاجِرِ  حَاتِمُ بْنُ إِسْمَاعِيلَ  وَدَلْهَمُ بْنُ دَهْتَمٍ  .","","Musnad al-Bazzar 4423","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن بشير بن المهاجر الغنوي عن سفيان بن عيينة عن محمد بن زياد اليؤيؤ عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4431","4424  -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ، قَالَ :  أَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ، قَالَ :  نَا  سَعِيدُ بْنُ عُبَيْدِ اللهِ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -         [10/306]      أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  ثَلَاثٌ مِنَ الْجَفَاءِ  : أَنْ يَبُولَ الرَّجُلُ قَائِمًا ، أَوْ يَمْسَحَ جَبْهَتَهُ قَبْلَ أَنْ يَفْرُغَ مِنْ صَلَاتِهِ ، أَوْ يَنْفُخَ فِي سُجُودِهِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ أَبِيهِ إِلَّا  سَعِيدَ بْنَ عُبَيْدِ اللهِ  ، وَرَوَاهُ عَنْ  سَعِيدٍ  عَبْدُ اللهِ بْنُ دَاوُدَ ،  وَعَبْدُ الْوَاحِدِ بْنُ وَاصِلٍ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  عَبْدِ اللهِ  إِلَّا  نَصْرُ بْنُ عَلِيٍّ  .","","Musnad al-Bazzar 4424","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن سعيد بن عبيد الله الجبيري عن عبد الله بن داود الخريبي عن نصر بن علي بن نصر الجهضمي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4432","4425  -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ ، قَالَ :  أَنَا  عَبْدُ اللهِ بْنُ دَاوُدَ ، قَالَ :  نَا  الْوَلِيدُ بْنُ ثَعْلَبَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَيْسَ مِنَّا مَنْ حَلَفَ  بِالْأَمَانَةِ  وَلَيْسَ مِنَّا مَنْ  خَبَّبَ  امْرَأَةً أَوْ مَمْلُوكًا  .","","Musnad al-Bazzar 4425","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الوليد بن ثعلبة الطائي عن عبد الله بن داود الخريبي عن نصر بن علي بن نصر الجهضمي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4433","[10/307]      4426  -  وَحَدَّثَنَاهُ  نَصْرُ بْنُ عَلِيٍّ ، قَالَ :  أَنَا  الْمُعْتَمِرُ ،  عَنْ  لَيْثٍ ،  عَنْ  عُثْمَانَ - وَلَمْ يَنْسُبْهُ  لَيْثٌ  -  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ حَلَفَ  بِالْأَمَانَةِ  فَلَيْسَ مِنَّا  .","","Musnad al-Bazzar 4426","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن عثمان بن عمير البجلي عن ليث بن أبي سليم عن معتمر بن سليمان عن نصر بن علي بن نصر الجهضمي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4434","4427  -  حَدَّثَنَا  بِشْرُ بْنُ آدَمَ ، وَزَيْدُ بْنُ أَخْزَمَ الطَّائِيُّ ، قَالَا :  نَا  أَبُو عَاصِمٍ ، قَالَ :  نَا  عَبْدُ الْوَارِثِ ، قَالَ :  نَا  حُسَيْنٌ الْمُعَلِّمُ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنِ اسْتَعْمَلْنَاهُ عَلَى عَمَلٍ ، فَرَزَقْنَاهُ عَلَيْهِ رِزْقًا  ، فَمَا أَصَابَ سِوَى رِزْقِهِ فَهُوَ         [10/308]      غُلُولٌ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  بُرَيْدَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ  أَسْنَدَ  الْحُسَيْنُ الْمُعَلِّمُ  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  عَنْ أَبِيهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَيْرَ هَذَا الْحَدِيثِ  .","","Musnad al-Bazzar 4427","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن حسين المعلم عن عبد الوارث بن سعيد بن ذكوان عن أبو عاصم النبيل عن زيد بن أخزم الطائي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4435","4428  -  حَدَّثَنَا  أَبُو كُرَيْبٍ ، قَالَ :  نَا  عُثْمَانُ بْنُ نَاجِيَةَ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ مُسْلِمٍ أَبُو طَيْبَةَ الْخُرَاسَانِيُّ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ مَاتَ مِنْ أَصْحَابِي بِأَرْضٍ  فَهُوَ  شَفِيعٌ لِتِلْكَ الْأَرْضِ ، وَقَائِدٌ لَهُمْ يَوْمَ الْقِيَامَةِ - أَوْ قَالَ - : شَفِيعًا لِأَهْلِ تِلْكَ الْأَرْضِ يَوْمَ الْقِيَامَةِ  .","","Musnad al-Bazzar 4428","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عبد الله بن مسلم السلمي عن عثمان بن ناجية الخراساني عن أبو كريب محمد بن العلاء عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4436","[10/309]      4428  (م)  -  حَدَّثَنَا  عَمْرُو بْنُ مَالِكٍ ، قَالَ :  نَا  يَحْيَى بْنُ عَبَّادٍ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ مُسْلِمٍ أَبُو طَيْبَةَ الْخُرَاسَانِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَنْ مَاتَ مِنْ أَصْحَابِي بِأَرْضٍ فَهُوَ شَفِيعٌ  لِأَهْلِ تِلْكَ الْأَرْضِ يَوْمَ الْقِيَامَةِ  .","","Musnad al-Bazzar 4428","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عبد الله بن مسلم السلمي عن يحيى بن عباد الضبعي عن عمرو بن مالك بن عمر الراسبي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4437","4429  -  حَدَّثَنَا  عَمْرُو بْنُ مَالِكٍ ، قَالَ :  نَا  أَبُو تُمَيْلَةَ يَحْيَى بْنُ وَاضِحٍ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ مُسْلِمٍ أَبُو طَيْبَةَ السُّلَمِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ  كُنْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ فَكَانَ كُلَّمَا بَقِيَ شَيْءٌ حَمَلَهُ عَلَيَّ  وَسَمَّانِي الزَّامِلَةَ  .","","Musnad al-Bazzar 4429","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عبد الله بن مسلم السلمي عن يحيى بن واضح الأنصاري عن عمرو بن مالك بن عمر الراسبي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4438","4430  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْأَزْدِيُّ ، قَالَ :  نَا  زَيْدُ بْنُ الْحُبَابِ         [10/310]      قَالَ  نَا  عَبْدُ اللهِ بْنُ مُسْلِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ  رَجُلًا  دَخَلَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَيْهِ خَاتَمٌ مِنْ حَدِيدٍ ، فَقَالَ :  مَا لِي أَجِدُ مِنْكَ رِيحَ الْأَصْنَامِ  فَذَهَبَ فَاتَّخَذَهُ مِنْ صُفْرٍ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَهُ قَوْلًا فِيهِ ، فَقَالَ : يَا رَسُولَ اللهِ مِمَّا أَتَّخِذُهُ ؟ قَالَ : "" اتَّخِذْهُ مِنْ فِضَّةٍ وَلَا تَزِدْ عَلَى  مِثْقَالٍ  .","","Musnad al-Bazzar 4430","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عبد الله بن مسلم السلمي عن زيد بن الحباب العكلي عن محمد بن يحيى بن أبي حاتم عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4439","4431  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  يَعْلَى بْنُ عُبَيْدٍ ،  عَنْ  صَالِحِ بْنِ حَيَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - :  إِنَّ السَّمَاوَاتِ السَّبْعَ وَالْأَرَضِينَ السَّبْعَ وَالْجِبَالَ لَيَلْعَنَّ الشَّيْخَ الزَّانِي ،  وَإِنَّ  فُرُوجَ  الزُّنَاةِ لَتُؤْذِي أَهْلَ النَّارِ بِنَتْنِ رِيحِهَا  .         [10/311]","","Musnad al-Bazzar 4431","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن صالح بن حيان القرشي عن يعلى بن عبيد الطنافسي عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4440","4432  -  وَحَدَّثَنَاهُ  عَمْرُو بْنُ مَالِكٍ ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ  عَنْ  صَالِحِ بْنِ حَيَّانَ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَلَا نَعْلَمُ  رَفَعَ  هَذَا الْحَدِيثَ إِلَّا  أَبُو مُعَاوِيَةَ  .","","Musnad al-Bazzar 4432","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن صالح بن حيان القرشي عن أبو معاوية الضرير عن عمرو بن مالك بن عمر الراسبي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4441","4433  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ ، قَالَ :  نَا  حَبَّانُ بْنُ هِلَالٍ ، قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ ، قَالَ :  نَا  صُبَيْحٌ أَبُو الْعَلَاءِ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْرَأُ فِي الصَّلَاةِ : "" لَوْ أَنَّ لِابْنِ آدَمَ وَادِيًا مِنْ ذَهَبٍ  لَابْتَغَى إِلَيْهِ ثَانِيًا ، وَلَوْ أُعْطِيَ ثَانِيًا لَابْتَغَى إِلَيْهِ ثَالِثًا ، وَلَا يَمْلَأُ جَوْفَ ابْنِ آدَمَ إِلَّا التُّرَابُ ، وَيَتُوبُ اللهُ عَلَى مَنْ تَابَ  .         [10/312]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  عَبْدُ الْعَزِيزِ بْنُ مُسْلِمٍ  عَنْ  أَبِي الْعَلَاءِ  ، وَهَذَا مِمَّا كَانَ يُقْرَأُ فَنُسِخَ  .","","Musnad al-Bazzar 4433","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن صبيح أبو العلاء عن عبد العزيز بن مسلم الخراساني عن حبان بن هلال الباهلي عن يحيى بن محمد بن السكن البزاز عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4442","4434  -  حَدَّثَنَا  الْقَاسِمُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ عُثْمَانَ ،  عَنْ  عِيسَى بْنِ عُبَيْدٍ ، قَالَ :  سَمِعْتُ  عَبْدَ اللهِ بْنَ بُرَيْدَةَ  يُحَدِّثُ عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَمَا هُوَ يَسِيرُ إِذْ سَمِعَ لَغَطًا ، فَقَالَ : "" مَا هَذَا الصَّوْتُ ؟ "" قَالُوا : يَا نَبِيَّ اللهِ ، قَوْمٌ لَهُمْ شَرَابٌ يَشْرَبُونَهُ ، فَبَعَثَ إِلَى  الْقَوْمِ  فَدَعَاهُمْ ، فَقَالَ :  لَا تَشْرَبُوا إِلَّا مَا أَوْكَيْتُمْ  - ثُمَّ قَالَ : - اشْرَبُوا ، وَكُلُّ مُسْكِرٍ حَرَامٌ  .","","Musnad al-Bazzar 4434","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عيسى بن عبيد الكندي عن عبد الله بن عثمان بن جبلة عن القاسم بن محمد بن الحارث المروزي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4443","4435  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  ضِرَارٍ أَبِي سِنَانٍ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  وَهُوَ         [10/313]      سُلَيْمَانُ بْنُ بُرَيْدَةَ  ، عَنْ أَبِيهِ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  نَهَيْتُكُمْ عَنْ زِيَارَةِ الْقُبُورِ فَزُورُوهَا ،  وَنَهَيْتُكُمْ عَنْ لُحُومِ الْأَضَاحِيِّ أَنْ تُمْسِكُوهَا فَوْقَ ثَلَاثٍ فَأَمْسِكُوهَا مَا بَدَا لَكُمْ ، وَنَهَيْتُكُمْ عَنِ النَّبِيذِ إِلَّا فِي سِقَاءٍ فَاشْرَبُوا فِي الْأَسْقِيَةِ ، وَلَا تَشْرَبُوا مُسْكِرًا  .","","Musnad al-Bazzar 4435","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن محارب بن دثار عن ضرار بن مرة الشيباني عن محمد بن فضيل بن غزوان عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4444","4436  -  وَحَدَّثَنَاهُ  الْفَضْلُ بْنُ سَهْلٍ ، قَالَ :  نَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَخَّصَ فِي الظُّرُوفِ بَعْدَ مَا نَهَى عَنْهَا  .         [10/314]      وَلَا نَعْلَمُ رَوَى  سَلَمَةُ بْنُ كُهَيْلٍ  ، عَنِ  ابْنِ بُرَيْدَةَ  ، عَنْ أَبِيهِ غَيْرَ هَذَا الْحَدِيثِ وَلَا رَوَاهُ عَنْ  سَلَمَةَ  إِلَّا  مُحَمَّدُ بْنُ إِسْحَاقَ  .","","Musnad al-Bazzar 4436","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن سلمة بن كهيل الحضرمي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن الفضل بن سهل الخراساني عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4445","4437  -  حَدَّثَنَا  عَمْرُو بْنُ مَالِكٍ ، قَالَ :  نَا  عُمَرُ بْنُ عَلِيٍّ الْمُقَدَّمِيُّ ، قَالَ :  نَا  صَالِحُ بْنُ حَيَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ أَكْبَرَ الْكَبَائِرِ الْإِشْرَاكُ بِاللهِ  ،  وَعُقُوقُ  الْوَالِدَيْنِ ، وَمَنْعُ  فَضْلِ  الْمَاءِ ، وَمَنْعُ الْفَحْلِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا بِرِوَايَةِ  بُرَيْدَةَ  عَنْهُ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  صَالِحِ بْنِ حَيَّانَ  إِلَّا  عُمَرُ بْنُ عَلِيٍّ  .","","Musnad al-Bazzar 4437","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن صالح بن حيان القرشي عن عمر بن علي بن عطاء عن عمرو بن مالك بن عمر الراسبي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4446","4438  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْوَلِيدِ الْبُسْرِيُّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ عُبَيْدٍ ،         [10/315]      قَالَ :  نَا  صَالِحُ بْنُ حَيَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَسَّ صَنَمًا فَتَوَضَّأَ  .  وَرَأَيْتُهُ عِنْدِي فِي مَوْضِعَيْنِ : فِي مَوْضِعٍ عَنْ  يَعْلَى  ، وَفِي مَوْضِعٍ عَنْ  مُحَمَّدٍ  ،  وَإِنَّمَا مَعْنَاهُ : "" مَسَّ صَنَمًا فَتَوَضَّأَ "" : غَسَلَ يَدَيْهِ  .","","Musnad al-Bazzar 4438","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن صالح بن حيان القرشي عن محمد بن عبيد بن أبي أمية عن محمد بن الوليد البسري عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4447","4439  -  حَدَّثَنَا  عَمْرُو بْنُ مَالِكٍ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ أَبُو إِسْحَاقَ ، قَالَ :  نَا  عُقْبَةُ الْأَصَمُّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ : "" اللَّهُمَّ اجْعَلْنِي شَكُورًا ، وَاجْعَلْنِي صَبُورًا  ، وَاجْعَلْنِي فِي عَيْنِي صَغِيرًا ، وَفِي أَعْيُنِ النَّاسِ كَبِيرًا  .         [10/316]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  ، عَنْ أَبِيهِ إِلَّا  عُقْبَةُ الْأَصَمُّ  ، وَهُوَ رَجُلٌ مِنْ  أَهْلِ الْبَصْرَةِ  لَيْسَ بِهِ بَأْسٌ  .","","Musnad al-Bazzar 4439","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عقبة بن عبد الله الأصم عن إسماعيل القسط المكي عن عمرو بن مالك بن عمر الراسبي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4448","4440  -  حَدَّثَنَا  مَعْمَرُ بْنُ سَهْلٍ ، وَصَفْوَانُ بْنُ الْمُغَلِّسِ ، قَالَا :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  نَا  يُوسُفُ بْنُ صُهَيْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  تَفَرَّقَ النَّاسُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ حُنَيْنٍ  فَلَمْ يَبْقَ مَعَهُ إِلَّا رَجُلٌ يُقَالُ لَهُ :  زَيْدٌ  وَهُوَ آخِذٌ بِعِنَانِ بَغْلَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الشَّهْبَاءِ ، فَقَالَ لَهُ رَسُولُ اللهِ :  وَيْحَكَ ! ادْعُ النَّاسَ  فَنَادَى  زَيْدٌ  : أَيُّهَا النَّاسُ ، هَذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُوكُمْ ، فَلَمْ يَجِئْ أَحَدٌ ، فَقَالَ : "" ادْعُ  الْأَنْصَارَ  "" فَنَادَى : يَا مَعْشَرَ  الْأَنْصَارِ ،  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُوكُمْ فَلَمْ يَجِئْ أَحَدٌ ، قَالَ : "" وَيْحَكَ  خُصَّ  الْأَوْسَ  وَالْخَزْرَجَ  "" ، فَقَالَ : يَا مَعْشَرَ  الْأَوْسِ  وَالْخَزْرَجِ ،  هَذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُوكُمْ فَلَمْ يَجِئْ أَحَدٌ ، قَالَ : "" وَيْحَكَ  خُصَّ  الْمُهَاجِرِينَ  فَإِنَّ لِي فِي أَعْنَاقِهِمْ بَيْعَةً "" ، قَالَ : فَحَدَّثَنِي  بُرَيْدَةُ  أَنَّهُ أَقْبَلَ مِنْهُمْ أَلْفٌ قَدْ طَرَحُوا الْجُفُونَ حَتَّى أَتَوْا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ         [10/317]      وَسَلَّمَ - فَمَشَوْا  قُدُمًا  حَتَّى فَتَحَ اللهُ عَلَيْهِمْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  بُرَيْدَةُ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  عَنْ أَبِيهِ إِلَّا  يُوسُفُ بْنُ صُهَيْبٍ  وَيُوسُفُ  رَجُلٌ مَشْهُورٌ مِنْ  أَهْلِ الْكُوفَةِ  .","","Musnad al-Bazzar 4440","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن يوسف بن صهيب الكندي عن عبيد الله بن موسى عن صفوان بن المغلس عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4449","4441  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، وَصَفْوَانُ بْنُ الْمُغَلِّسِ ، قَالَا :  نَا  عُبَيْدُ اللهِ - يَعْنِي - ابْنَ مُوسَى ،  عَنْ  يُوسُفَ بْنِ صُهَيْبِ بْنِ بُرَيْدَةَ  ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ  امْرَأَةً  حَذَفَتِ  امْرَأَةً  فَقَضَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي وَلَدِهَا خَمْسَمِائَةٍ ،  وَنَهَى يَوْمَئِذٍ عَنِ الْحَذْفِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  إِلَّا  يُوسُفُ بْنُ صُهَيْبٍ  .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : (يوسف بن صهيب عن ابن بريدة) وينظر تعليق المصنف عقب الحديث ، ومصادر التخريج .","","Musnad al-Bazzar 4441","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن يوسف بن صهيب الكندي عن عبيد الله بن موسى عن صفوان بن المغلس عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4450","[10/318]      4442  -  حَدَّثَنَا  عَمْرُو بْنُ مَالِكٍ : قَالَ :  نَا  عَمْرُو بْنُ النُّعْمَانِ ، قَالَ :  نَا  يُوسُفُ بْنُ صُهَيْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِذَا صَلَّى أَحَدُكُمْ إِلَى سُتْرَةٍ فَلْيَدْنُ مِنْهَا  لَا يَقْطَعِ الشَّيْطَانُ عَلَيْهِ صَلَاتَهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ يُرْوَى عَنْ  بُرَيْدَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  يُوسُفَ بْنِ صُهَيْبٍ  إِلَّا  عَمْرُو بْنُ النُّعْمَانِ  ،  وَعَمْرٌو  رَجُلٌ مِنْ  أَهْلِ الْبَصْرَةِ  .","","Musnad al-Bazzar 4442","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن يوسف بن صهيب الكندي عن عمرو بن النعمان الباهلي عن عمرو بن مالك بن عمر الراسبي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4451","4443  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو الْمُسَاوِرِ الْفَضْلُ بْنُ مُسَاوِرٍ ، قَالَ :  نَا  عَوْفٌ  عَنْ  مَيْمُونٍ أَبِي عَبْدِ اللهِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - قَالَ :  لَمَّا كَانَ  يَوْمُ خَيْبَرَ  نَزَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِحَضْرَةِ  أَهْلِ خَيْبَرَ  ، فَأَعْطَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اللِّوَاءَ  عُمَرَ بْنَ الْخَطَّابِ  - رَضِيَ اللهُ عَنْهُ - وَنَهَضَ مَنْ نَهَضَ مَعَهُ مِنَ النَّاسِ ، فَلَقُوا  أَهْلَ خَيْبَرَ  ، فَكَشَفَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - وَأَصْحَابُهُ ، فَرَجَعَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ – يُجْبِنُهُ أَصْحَابُهُ ، وَهُوَ يُجَبِّنُ أَصْحَابَهُ ،         [10/319]      فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَأُعْطِيَنَّ  الرَّايَةَ  غَدًا رَجُلًا يُحِبُّ اللهَ وَرَسُولَهُ ، وَيُحِبُّهُ اللهُ وَرَسُولُهُ  فَلَمَّا كَانَ مِنَ الْغَدِ دَعَا  عَلِيًّا  - رَضِيَ اللهُ عَنْهُ - فَدَفَعَهَا إِلَيْهِ وَهُوَ أَرْمَدُ ،  فَتَفَلَ  فِي عَيْنِهِ ، وَأَعْطَاهُ اللِّوَاءَ وَسَارَ مَعَهُ النَّاسُ ، فَأَتَى  أَهْلَ خَيْبَرَ  ، وَإِذَا  مَرْحَبٌ  يَرْتَجِزُ بَيْنَ أَيْدِيهِمْ يَقُولُ :  فَاخْتَلَفَ هُوَ  وَعَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - ضَرْبَتَيْنِ فَضَرَبَهُ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - ضَرْبَةً عَلَى هَامَتِهِ حَتَّى عَضَّ السَّيْفُ أَضْرَاسَهُ ، وَسَمِعَ أَهْلُ الْعَسْكَرِ صَوْتَ ضَرْبَتِهِ ، وَمَا تَتَامَّ آخِرُ النَّاسِ حَتَّى فُتِحَ أَوَّلُهُمْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  بُرَيْدَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4443","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن ميمون الكندي مولى عبد الرحمن بن سمرة عن عوف بن أبي جميلة عن الفضل بن مساور البصري عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4452","[10/320]      4444  -  حَدَّثَنَا  صَفْوَانُ بْنُ الْمُغَلِّسِ ، قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ أَبَانَ ، قَالَ :  نَا  بَشِيرُ بْنُ الْمُهَاجِرِ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَا مِنْكُمْ مِنْ أَحَدٍ إِلَّا سَيُكَلِّمُهُ اللهُ عَزَّ وَجَلَّ  لَيْسَ بَيْنَهُ وَبَيْنَهُ حِجَابٌ وَلَا  تُرْجُمَانٌ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  بَشِيرِ بْنِ الْمُهَاجِرِ  إِلَّا  عَبْدُ الْعَزِيزِ بْنُ أَبَانَ  ،  وَعَبْدُ الْعَزِيزِ  لَمْ يَكُنْ بِالْقَوِيِّ  وَإِنَّمَا يُكْتَبُ مِنْ حَدِيثِهِ مَا لَمْ يَنْفَرِدْ بِهِ  .","","Musnad al-Bazzar 4444","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن بشير بن المهاجر الغنوي عن عبد العزيز بن أبان السعيدي عن صفوان بن المغلس عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4453","4445  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  رَوْحُ بْنُ عُبَادَةَ ، قَالَ :  نَا         [10/321]      يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَ :  نَا  صَالِحُ بْنُ حَيَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ  ضَمَّرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الْخَيْلَ ،  وَوَقَّتَ  لِإِضْمَارِهَا وَقْتًا  ، وَقَالَ : يَوْمَ كَذَا وَكَذَا مِنْ مَوْضِعِ كَذَا وَكَذَا ، وَأَرْسَلَ الْخَيْلَ الَّتِي لَيْسَتْ بِمُضَمَّرَةٍ مِنْ دُونِ ذَلِكَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  بُرَيْدَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  صَالِحِ بْنِ حَيَّانَ  إِلَّا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ  .","","Musnad al-Bazzar 4445","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن صالح بن حيان القرشي عن أبو يوسف يعقوب بن إبراهيم القاضي عن روح بن عبادة القيسي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4454","4446  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِسْكِينٍ ، قَالَ :  نَا  سَعِيدُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ حَكِيمٍ ،  عَنْ  يُوسُفَ بْنِ صُهَيْبٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  ثَلَاثَةٌ لَا تَقْرَبُهُمُ الْمَلَائِكَةُ  : السَّكْرَانُ ، وَالْمُتَمَضِّخُ بِالزَّعْفَرَانِ ،  وَالْحَائِضُ أَوِ  الْجُنُبُ  .         [10/322]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  بُرَيْدَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  يُوسُفَ بْنِ صُهَيْبٍ  إِلَّا  عَبْدُ اللهِ بْنُ حَكِيمٍ  .","","Musnad al-Bazzar 4446","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن يوسف بن صهيب الكندي عن عبد الله بن حكيم الداهري عن سعيد بن سليمان سعدويه عن محمد بن مسكين بن نميلة اليمامي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4455","4447  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  يَعْقُوبُ بْنُ مُحَمَّدٍ ، قَالَ :  نَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ، قَالَ :  نَا  أَفْلَحُ بْنُ سَعِيدٍ ،  عَنْ  سُفْيَانَ بْنِ فَرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  بُرَيْدَةَ الْأَسْلَمِيِّ - رَضِيَ اللهُ عَنْهُ - قَالَ :  لَمَّا أَقْبَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي مُهَاجَرِهِ لَقِيَ رَكْبًا ، فَقَالَ :  يَا  أَبَا بَكْرٍ ،  سَلِ  الْقَوْمَ  مِمَّنْ هُمْ  قَالُوا : نَحْنُ مِنْ  أَسْلَمَ  ، قَالَ : "" سَلِمْتَ يَا  أَبَا بَكْرٍ ،  سَلْهُمْ مِنْ أَيِّ  أَسْلَمَ  "" قَالُوا : مِنْ  بَنِي سَهْمٍ  ، قَالَ : "" ارْمِ بِسَهْمِكَ يَا  أَبَا بَكْرٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  بُرَيْدَةُ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  بُرَيْدَةَ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 4447","","بريدة بن الحصيب الأسلمي عن أبو سفيان بن فروة الأسلمي عن سفيان بن فروة الأسلمي عن أفلح بن سعيد الأنصاري عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن يعقوب بن محمد بن عيسى عن محمد بن معمر بن ربعي البحراني عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4456","4448  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ الْعَنْبَرِيُّ ، قَالَ :  نَا  يَحْيَى بْنُ كَثِيرٍ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ سُلَيْمَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَوْسٍ ،  عَنْ         [10/323]      بُرَيْدَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ""  بَشِّرِ الْمَشَّائِينَ فِي الظُّلَمِ إِلَى الْمَسَاجِدِ بِالنُّورِ التَّامِّ  يَوْمَ الْقِيَامَةِ  .","","Musnad al-Bazzar 4448","","بريدة بن الحصيب الأسلمي عن عبد الله بن أوس الخزاعي عن إسماعيل بن سليمان الكحال عن يحيى بن كثير العنبري عن عباس بن عبد العظيم العنبري عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4457","4449  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ مُحَمَّدٍ ، قَالَ :  نَا  عَوْنُ بْنُ عُمَارَةَ ، قَالَ :  نَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  وَاصِلٍ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  كُنَّا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَقْبَلَ  رَجُلٌ مِنْ قُرَيْشٍ  يَخْطِرُ فِي  حُلَّةٍ  لَهُ ، فَلَمَّا قَامَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَا  بُرَيْدَةُ  ! هَذَا مِمَّنْ لَا يُقِيمُ اللهُ لَهُ يَوْمَ الْقِيَامَةِ وَزْنًا  .         [10/324]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  إِلَّا  وَاصِلٌ . هُوَ وَاصِلٌ مَوْلَى أَبِي عُيَيْنَةَ  رَجُلٌ مِنْ  أَهْلِ الْبَصْرَةِ  مَشْهُورٌ ،  وَعَوْنُ بْنُ عُمَارَةَ  لَمْ يَكُنْ بِالْحَافِظِ  وَلَمْ يُتَابَعْ  عَلَى هَذَا الْحَدِيثِ  .","","Musnad al-Bazzar 4449","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن واصل الأزدي مولى أبي عيينة بن المهلب عن هشام بن حسان العتكي عن عون بن عمارة القيسي عن عباس الدوري عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4458","4450  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ الْجُنَيْدِ ، وَمُحَمَّدُ بْنُ يَزِيدَ ، قَالَا :  نَا  عَبْدُ الْعَزِيزِ بْنُ الْخَطَّابِ ، قَالَ :  نَا  حِبَّانُ بْنُ عَلِيٍّ ، قَالَ :  نَا  صَالِحُ بْنُ حَيَّانَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  جَاءَ  رَجُلٌ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : أَرِنِي آيَةً ، قَالَ :  اذْهَبْ إِلَى تِلْكَ الشَّجَرَةِ فَادْعُهَا  فَذَهَبَ إِلَيْهَا ، فَقَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَدْعُوكِ ، فَمَالَتْ عَلَى كُلِّ جَانِبٍ مِنْهَا حَتَّى قَلَعَتْ عُرُوقَهَا ، ثُمَّ أَقْبَلَتْ حَتَّى جَاءَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَأَمَرَهَا رَسُولُ اللهِ أَنْ تَرْجِعَ ، فَقَامَ الرَّجُلُ فَقَبَّلَ رَأْسَهُ وَيَدَيْهِ وَرِجْلَيْهِ وَأَسْلَمَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  صَالِحِ بْنِ حَيَّانَ  إِلَّا  حِبَّانُ بْنُ عَلِيٍّ  ،         [10/325]      وَلَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي تَقْبِيلِ الرَّأْسِ إِلَّا هَذَا الْحَدِيثُ .","","Musnad al-Bazzar 4450","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن صالح بن حيان القرشي عن حبان بن علي العنزي عن عبد العزيز بن الخطاب الكوفي عن محمد بن يزيد بن عبد الملك الأسفاطي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4459","4451  -  حَدَّثَنَا  زُهَيْرُ بْنُ مُحَمَّدٍ ، قَالَ :  أَنَا  عَبْدُ الرَّزَّاقِ ، قَالَ :  أَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  مَالِكِ بْنِ مِغْوَلٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمِعَ  رَجُلًا  يَقُولُ : اللَّهُمَّ إِنِّي أَسْأَلُكَ بِأَنَّكَ أَنْتَ اللهُ لَا إِلَهَ إِلَّا أَنْتَ ، الْأَحَدُ الصَّمَدُ ، الَّذِي لَمْ تَلِدْ وَلَمْ تُولَدْ ، وَلَمْ يَكُنْ لَكَ كُفُوًا أَحَدٌ ، فَقَالَ :  لَقَدْ سَأَلَ اللهَ بِاسْمِهِ الَّذِي إِذَا دُعِيَ بِهِ أَجَابَ وَإِذَا سُئِلَ بِهِ أَعْطَى  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  إِلَّا  مَالِكُ بْنُ مِغْوَلٍ  .","","Musnad al-Bazzar 4451","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن مالك بن مغول الصهيبي عن سفيان الثوري عن عبد الرزاق الصنعاني عن زهير بن محمد بن قمير المروزي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4460","4452  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ :  نَا  أَبُو الْجَوَّابِ أَحْوَصُ بْنُ جَوَّابٍ ،  عَنْ  عَمَّارِ بْنِ رُزَيْقٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنِ  الزُّبَيْرِ         [10/326]      بْنِ عَدِيٍّ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  كُلُّ مُسْكِرٍ حَرَامٌ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  أَبِي إِسْحَاقَ  إِلَّا  عَمَّارُ بْنُ رُزَيْقٍ  ، وَلَا نَعْلَمُ رَوَى  الزُّبَيْرُ بْنُ عَدِيٍّ  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  عَنْ أَبِيهِ غَيْرَ هَذَا الْحَدِيثِ .","","Musnad al-Bazzar 4452","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الزبير بن عدي الهمداني عن أبو إسحاق السبيعي عن عمار بن رزيق الضبي عن أحوص بن جواب الضبي عن إبراهيم بن سعيد الجوهري عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4461","4453  -  حَدَّثَنَا  سَلَمَةُ بْنُ شَبِيبٍ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ الْوَزِيرِ الطَّائِفِيُّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى إِذَا كُنَّا  بِوَدَّانَ  أَوْ بِالْقُبُورِ سَأَلَ الشَّفَاعَةَ لِأُمِّهِ  ، أَحْسَبُهُ قَالَ : فَضَرَبَ  جِبْرِيلُ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ صَدْرَهُ ، وَقَالَ : لَا         [10/327]      تَسْتَغْفِرْ لِمَنْ مَاتَ مُشْرِكًا ، فَرَجَعَ وَهُوَ حَزِينٌ  .  وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ بِهَذَا  الْإِسْنَادِ  إِلَّا  مُحَمَّدُ بْنُ جَابِرٍ  ، وَقَدْ رَوَى  عَلْقَمَةُ بْنُ مَرْثَدٍ  ، عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ  ، عَنْ أَبِيهِ - رَضِيَ اللهُ عَنْهُ -  أَنَّهُمْ كَانُوا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَى  جِذْمَ  حَائِطٍ ، فَجَلَسَ إِلَى قَبْرٍ كَأَنَّهُ مُخَاطِبٌ ، فَرَجَعَ ، فَقَالَ : "" هَذَا قَبْرُ أُمِّي اسْتَأْذَنْتُ رَبِّي فِي زِيَارَتِهِ ، فَأَذِنَ لِي ، وَاسْتَأْذَنْتُ رَبِّي فِي الِاسْتِغْفَارِ فَلَمْ يَأْذَنْ لِي "" فَلَمْ نَرَ يَوْمًا أَكْثَرَ بَاكِيًا مِنْ ذَلِكَ الْيَوْمِ  .","","Musnad al-Bazzar 4453","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن القاسم بن عبد الرحمن المسعودي عن سماك بن حرب البكري عن محمد بن جابر بن سيار عن عبد الله بن الوزير الطائفي عن سلمة بن شبيب المسمعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4462","4454  -  حَدَّثَنَا  بِهِ أَحْمَدُ بْنُ الْوَزِيرِ الْبَصْرِيُّ ، قَالَ :  نَا  الضَّحَّاكُ بْنُ مَخْلَدٍ ، قَالَ :  نَا  سُفْيَانُ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  .","","Musnad al-Bazzar 4454","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن سفيان الثوري عن أبو عاصم النبيل عن أحمد بن الوزير البصري عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4463","4455  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ الْمَرْوَزِيُّ ، قَالَ :  نَا  آدَمُ بْنُ أَبِي         [10/328]      إِيَاسٍ ، قَالَ :  نَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  عَطَاءٍ الْخُرَاسَانِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّا كُنَّا نَهَيْنَاكُمْ عَنْ قِرَانِ التَّمْرِ ، فَأَقْرِنُوا ; فَقَدْ وَسَّعَ اللهُ الْخَيْرَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  بُرَيْدَةَ  إِلَّا هَذَا الطَّرِيقَ ، وَلَا نَعْلَمُ رَوَاهُ إِلَّا  آدَمُ  عَنْ  يَزِيدَ بْنِ زُرَيْعٍ  .","","Musnad al-Bazzar 4455","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عطاء الخراساني عن يزيد بن زريع العيشي عن آدم بن أبي إياس عن عبد الله بن أحمد بن شبوية المروزي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4464","4456  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ الْمُبَارَكِ الْمُخَرِّمِيُّ ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْأَعْمَشِ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ         [10/329]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَا يُخْرِجُ الرَّجُلُ الصَّدَقَةَ حَتَّى يَفُكَّ عَنْهَا لَحْيَيْ سَبْعِينَ شَيْطَانًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  أَبُو مُعَاوِيَةَ  عَنِ  الْأَعْمَشِ  ،  وَابْنُ بُرَيْدَةَ هَذَا هُوَ سُلَيْمَانُ بْنُ بُرَيْدَةَ  .","","Musnad al-Bazzar 4456","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الأعمش عن أبو معاوية الضرير عن محمد بن عبد الله بن المبارك المخرمي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4465","4457  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَارَةَ الْكُوفِيُّ ، قَالَ :  نَا  عَلِيُّ بْنُ قَادِمٍ ، قَالَ :  نَا  قَيْسٌ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - اسْتَغْفَرَ  لِمَاعِزٍ  .","","Musnad al-Bazzar 4457","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن قيس بن الربيع الأسدي عن علي بن قادم الخزاعي عن محمد بن عمارة الكوفي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4466","4458  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ عَبْدِ اللهِ ، قَالَ :  نَا  يَحْيَى بْنُ يَعْلَى بْنِ الْحَارِثِ الْمُحَارِبِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ         [10/330]      - رَضِيَ اللهُ عَنْهُ - قَالَ  جَاءَ  مَاعِزُ بْنُ مَالِكٍ  إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَدَّدَهُ ، ثُمَّ قَالَ : ""  اسْتَنْكِهُوهُ  فَاسْتَنْكَهُوهُ ، ثُمَّ رَجَمَهُ  .  وَلَا نَعْلَمُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ ""  اسْتَنْكِهُوهُ  "" إِلَّا فِي حَدِيثِ  يَحْيَى بْنِ يَعْلَى بْنِ الْحَارِثِ  .","","Musnad al-Bazzar 4458","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن يعلى بن الحارث بن حرب المحاربي عن يحيى بن يعلى بن الحارث المحاربي عن عباس بن عبد الله الباكسائي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4467","4459  -  حَدَّثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْأَسْدِيُّ الْكُوفِيُّ ، قَالَ :  نَا  أَبِي  ، قَالَ :  نَا  مُحَمَّدُ بْنُ أَبَانَ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ الْحَجَرَ لَيَهْوَى فِي  جَهَنَّمَ  فَمَا يَصِلُ إِلَى قَعْرِهَا سَبْعِينَ  خَرِيفًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  مُحَمَّدُ بْنُ أَبَانَ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ         [10/331]      مُحَمَّدِ بْنِ أَبَانَ  إِلَّا  مُحَمَّدُ بْنُ الْحَسَنِ  .","","Musnad al-Bazzar 4459","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن محمد بن أبان بن صالح عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4468","4460  -  حَدَّثَنَا  حُمَيْدُ بْنُ الرَّبِيعِ ، قَالَ :  نَا  جَرِيرٌ ،  عَنْ  لَيْثٍ - يَعْنِي - ابْنَ أَبِي سُلَيْمٍ ،  عَنْ  عُثْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ رَمَانَا بِاللَّيْلِ فَلَيْسَ مِنَّا  .","","Musnad al-Bazzar 4460","","بريدة بن الحصيب الأسلمي عن عثمان بن بريدة عن ليث بن أبي سليم عن جرير بن عبد الحميد عن حميد بن الربيع الجلاد عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4469","4461  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  هِشَامُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ :  نَا  مُحَمَّدُ بْنُ أَبَانَ ،  عَنْ  عَلْقَمَةَ بْنِ مَرْثَدٍ ،  عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  جَاءَتِ الْغَامِدِيَّةُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ إِنَّهَا زَنَتْ ، فَأَعْرَضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْهَا ، فَقَالَتْ : يَا رَسُولَ اللهِ تُرِيدُ أَنْ تُرَدِّدَنِي كَمَا رَدَّدْتَ  مَاعِزًا  ، إِنَّهَا حُبْلَى مِنَ الزِّنَا ، فَقَالَ : "" مَتَى تَضَعِي "" ، فَذَهَبَتْ ، فَلَمَّا وَضَعَتْ جَاءَتْ بِهِ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَحْمِلُهُ ، فَقَالَتْ : قَدْ وَلَدْتُ ، قَالَ : "" اذْهَبِي حَتَّى         [10/332]      تَفْطِمِيهِ "" فَذَهَبَتْ ، ثُمَّ جَاءَتْ بِهِ وَفِي يَدِهِ كِسْرَةُ خُبْزٍ ، فَقَالَتْ : إِنِّي قَدْ فَطَمْتُهُ . فَقَالَ : "" ائْتِنِي بِمَنْ يَكْفُلُهُ "" فَقَامَ  رَجُلٌ  فَقَالَ : أَنَا أَكْفُلُهُ ، فَجَعَلَ أَصْحَابُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَتَعَجَّبُونَ مِنَ الرَّجُلِ ، وَيَقُولُونَ مَا كَانَ عَلَيْهِ لَوْ لَمْ يَكْفُلْهُ ، فَأَمَرَ بِهَا فَرُجِمَتْ ، ثُمَّ صَلَّى عَلَيْهَا ، فَقَالَ  رَجُلٌ  : كَيْفَ تُصَلِّي عَلَيْهَا وَهِيَ كَذَا ؟ فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَقَدْ تَابَتْ تَوْبَةً لَوْ قُسِمَتْ بَيْنَ  أَهْلِ الْمَدِينَةِ  لَوَسِعَتْهُمْ  ، أَوْ نَحْوَ هَذَا  .","","Musnad al-Bazzar 4461","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن علقمة بن مرثد الحضرمي عن محمد بن أبان بن صالح عن أبو الوليد الطيالسي عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4470","4462  -  حَدَّثَنَا  عَبَّادُ بْنُ أَحْمَدَ الْعَرْزَمِيُّ ، قَالَ :  حَدَّثَنِي  عَمِّي ،  عَنْ  أَبِيهِ  ،  عَنْ  جَابِرٍ الْجُعْفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  يَا  بُرَيْدَةُ  إِذَا كَانَ حِينَ تَفْتَتِحُ الصَّلَاةَ فَقُلْ : سُبْحَانَكَ اللَّهُمَّ  وَبِحَمْدِكَ  لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، وَلَا إِلَهَ إِلَّا أَنْتَ وَحْدَكَ لَا شَرِيكَ لَكَ ، تَبَارَكَ اسْمُكَ وَتَعَالَى  جَدُّكَ  وَلَا إِلَهَ         [10/333]      غَيْرُكَ ، ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي إِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ ، وَتَقْرَأُ مَا تَيَسَّرَ مِنَ الْقُرْآنِ ، وَتَرْكَعُ فَتَقُولُ : سُبْحَانَ رَبِّيَ الْعَظِيمِ ثَلَاثَ مَرَّاتٍ ، فَإِذَا رَفَعْتَ مِنَ الرُّكُوعِ فَقُلْ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، اللَّهُمَّ رَبَّنَا وَلَكَ الْحَمْدُ مِلْءَ السَّمَاءِ وَمِلْءَ الْأَرْضِ وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ ، فَإِذَا سَجَدْتَ فَقُلْ : سُبْحَانَ رَبِّيَ الْأَعْلَى ثَلَاثًا ، سَجَدَ وَجْهِي لِمَنْ خَلَقَهُ فَشَقَّ سَمْعَهُ وَبَصَرَهُ ، تَبَارَكَ اللهُ أَحْسَنُ الْخَالِقِينَ ، فَإِذَا رَفَعْتَ مِنَ السَّجْدَةِ فَقُلْ : رَبِّ اغْفِرْ لِي وَارْحَمْنِي وَاهْدِنِي وَارْزُقْنِي ، إِنِّي لِمَ أَنْزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ ، فَإِذَا جَلَسْتَ فِي صَلَاتِكَ فَلَا تَتْرُكَنَّ فِي  التَّشَهُّدِ  : لَا إِلَهَ إِلَّا اللهُ ، وَأَنِّي رَسُولُ اللهِ ، وَالصَّلَاةَ عَلَيَّ وَعَلَى جَمِيعِ أَنْبِيَاءِ اللهِ ، وَسَلِّمْ عَلَى عِبَادِ اللهِ الصَّالِحِينَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  بُرَيْدَةَ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4462","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن جابر الجعفي عن عبد الرحمن بن محمد العرزمي عن عمي عن عباد بن أحمد العرزمي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4471","4463  -  حَدَّثَنَا  رَجَاءُ بْنُ مُحَمَّدٍ ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  نَا  بَشِيرُ بْنُ الْمُهَاجِرِ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  مَا نَقَضَ قَوْمٌ الْعَهْدَ إِلَّا كَانَ الْقَتْلُ بَيْنَهُمْ  ، وَلَا ظَهَرَتْ فَاحِشَةٌ فِي قَوْمٍ قَطُّ إِلَّا سَلَّطَ اللهُ عَلَيْهِمُ         [10/334]      الْمَوْتَ ، وَلَا مَنَعَ قَوْمٌ قَطُّ الزَّكَاةَ إِلَّا حَبَسَ اللهُ عَنْهُمُ الْقَطْرَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  بُرَيْدَةَ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  بُرَيْدَةَ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 4463","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن بشير بن المهاجر الغنوي عن عبيد الله بن موسى عن رجاء بن محمد العذري عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4472","4464  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مِسْكِينٍ ، قَالَ :  نَا  سَعِيدُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  مَنْصُورُ بْنُ أَبِي الْأَسْوَدِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  مُحَارِبِ بْنِ دِثَارٍ ،  عَنِ  ابْنِ بُرَيْدَةَ وَهُوَ سُلَيْمَانُ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ  سَأَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  جَعْفَرًا  - رَضِيَ اللهُ عَنْهُ - حِينَ قَدِمَ مِنَ  الْحَبَشَةِ  : مَا أَعْجَبَ شَيْءٍ رَأَيْتَهُ ؟ قَالَ : رَأَيْتُ امْرَأَةً تَحْمِلُ عَلَى رَأْسِهَا  مِكْتَلًا  مِنْ طَعَامٍ ، فَمَرَّ فَارِسٌ فَرَكَضَهُ فَأَبْذَرَهُ ، فَجَلَسَتْ تَجْمَعُ طَعَامَهَا ، ثُمَّ الْتَفَتَتْ ، قَالَتْ : وَيْلٌ لَهُ إِذَا وَضَعَ الْمَلِكُ تَبَارَكَ وَتَعَالَى كُرْسِيَّهُ ، فَأَخَذَ لِلْمَظْلُومِ مِنَ الظَّالِمِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَصْدِيقًا لِقَوْلِهَا :  لَا  قُدِّسَتْ  أُمَّةٌ أَوْ         [10/335]      كَيْفَ تُقَدَّسُ أُمَّةٌ  لَا يَأْخُذُ ضَعِيفُهَا حَقَّهُ  مِنْ شَدِيدِهَا غَيْرَ  مُتَعْتَعٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  عَطَاءِ بْنِ السَّائِبِ  إِلَّا  مَنْصُورُ بْنُ أَبِي الْأَسْوَدِ  ، وَلَا نَعْلَمُ لَهُ عَنْ  بُرَيْدَةَ  طَرِيقًا غَيْرَ هَذَا الطَّرِيقِ .","","Musnad al-Bazzar 4464","","بريدة بن الحصيب الأسلمي عن سليمان بن بريدة الأسلمي عن محارب بن دثار عن عطاء بن السائب عن منصور بن أبي الأسود الليثي عن سعيد بن سليمان سعدويه عن محمد بن مسكين بن نميلة اليمامي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4473","4465  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ يُوسُفَ الصَّيْرَفِيُّ ، قَالَ :  نَا  أَبُو يَحْيَى التَّيْمِيُّ ،  عَنْ  أَبِي فَرْوَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ سُبَيْعٍ الْبَجَلِيِّ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّهُ سَمِعَهُ يَقُولُ  جَالَسْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَيْتُهُ كَالْحَزِينِ ، فَقَالَ لَهُ  رَجُلٌ  : مَا لِي أَرَاكَ كَأَنَّكَ حَزِينٌ ؟ قَالَ :  ذَكَرْتُ أَنِّي كُنْتُ نَهَيْتُكُمْ عَنْ لُحُومِ الْأَضَاحِيِّ أَنْ تَأْكُلُوهَا إِلَّا ثَلَاثَةَ أَيَّامٍ فَكُلُوا وَأَطْعِمُوا  وَادَّخِرُوا  مَا بَدَا لَكُمْ ، وَنَهَيْتُكُمْ عَنْ زِيَارَةِ الْقُبُورِ ، فَمَنْ أَرَادَ مِنْكُمْ أَنْ يَزُورَ قَبْرًا فَلْيَزُرْهُ ، وَنَهَيْتُكُمْ عَنِ  الدُّبَّاءِ  وَالْحَنْتَمِ  وَالنَّقِيرِ         [10/336]      وَالْمُزَفَّتِ  فَاجْتَنِبُوا كُلَّ مُسْكِرٍ ، وَاشْرَبُوا فِيمَا بَدَا لَكُمْ  .","","Musnad al-Bazzar 4465","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن المغيرة بن سبيع العجلي عن عروة بن الحارث الهمداني عن إسماعيل بن إبراهيم الأحول عن إبراهيم بن يوسف الصيرفي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4474","4466  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  سُوَيْدُ بْنُ عَمْرٍو ، قَالَ :  نَا  زُهَيْرٌ ،  عَنِ  الْوَلِيدِ بْنِ ثَعْلَبَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  سَيِّدُ الِاسْتِغْفَارِ أَنْ يَقُولَ الرَّجُلُ إِذَا جَلَسَ فِي صَلَاتِهِ : اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَهَ إِلَّا أَنْتَ  خَلَقْتَنِي فَأَنَا عَبْدُكَ ، أَنَا عَلَى  عَهْدِكَ  وَوَعْدِكَ مَا اسْتَطَعْتُ ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ ،  أَبُوءُ  بِنِعْمَتِكَ عَلَيَّ  وَأَبُوءُ  بِذَنْبِي ، فَاغْفِرْ لِي ، إِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ  .","","Musnad al-Bazzar 4466","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن الوليد بن ثعلبة الطائي عن زهير بن معاوية بن حديج عن سويد بن عمرو الكلبي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4475","[10/337]      4467  -  حَدَّثَنَا  مُحَمَّدُ بْنُ السَّكَنِ ، قَالَ :  نَا  عِمْرَانُ بْنُ أَبَانَ ، قَالَ :  نَا  خَلَفُ بْنُ خَلِيفَةَ ،  عَنْ  أَبِي هَاشِمٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  .","","Musnad al-Bazzar 4467","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن يحيى بن دينار الرماني عن خلف بن خليفة الأشجعي عن عمران بن أبان الواسطي عن محمد بن السكن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4476","4468  -  وَحَدَّثَنَا  أَحْمَدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  بَكْرُ بْنُ عَبْدِ الرَّحْمَنِ ،         [10/338]      عَنْ  قَيْسٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  سَعْدِ بْنِ عُبَيْدَةَ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْقُضَاةُ ثَلَاثَةٌ : اثْنَانِ فِي النَّارِ ، وَوَاحِدٌ فِي الْجَنَّةِ  ، قَاضٍ قَضَى بِجَوْرٍ فَهُوَ فِي النَّارِ ، وَقَاضٍ قَضَى بِغَيْرِ عِلْمٍ فَهُوَ فِي النَّارِ ، وَقَاضٍ بِالْحَقِّ فَهُوَ فِي الْجَنَّةِ  .","","Musnad al-Bazzar 4468","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن سعد بن عبيدة السلمي عن الأعمش عن قيس بن الربيع الأسدي عن بكر بن عبد الرحمن الأنصاري عن أحمد بن عثمان بن حكيم عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4477","4469  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ أَبِي طَالِبٍ ، قَالَ :  نَا  بَكْرُ بْنُ خِدَاشٍ ، قَالَ :  نَا  عِيسَى بْنُ الْمُسَيِّبِ ،  عَنْ  عَطِيَّةَ الْعَوْفِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ         [10/339]      أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ""  لَا يُسْتَعْمَلُ الرَّجُلُ عَلَى عَشَرَةٍ فَمَا فَوْقَهُمْ إِلَّا جِيءَ بِهِ يَوْمَ الْقِيَامَةِ  مَغْلُولَةٌ يَدُهُ إِلَى عُنُقِهِ فَإِنْ كَانَ مُحْسِنًا فُكَّ غُلُّهُ ، وَإِنْ كَانَ مُسِيئًا زِيدَ غُلًّا إِلَى غُلِّهِ  .","","Musnad al-Bazzar 4469","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عطية بن سعد العوفي عن عيسى بن المسيب البجلي عن بكر بن خداش الكوفي عن عباس بن جعفر العباسي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4478","4470  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  يَحْيَى بْنُ أَبِي بُكَيْرٍ ، قَالَ :  نَا  حُسَامُ بْنُ مِصَكٍّ ،  عَنْ  عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ مِنَ الشِّعْرِ  حِكْمَةً  .","","Musnad al-Bazzar 4470","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن حسام بن مصك الأزدي عن يحيى بن أبي بكير عن أبو موسى الزمن عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4479","4471  -  حَدَّثَنَا  رَجَاءُ بْنُ مُحَمَّدٍ ، وَعَبْدُ الْمَلِكِ بْنُ مُحَمَّدٍ الرَّقَاشِيُّ ، قَالَا :  نَا         [10/340]      مَالِكُ بْنُ إِسْمَاعِيلَ ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ حُمَيْدٍ الرُّؤَاسِيُّ ، قَالَ :  نَا  عَبْدُ الْكَرِيمِ بْنُ سَلِيطٍ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  أَبِيهِ  ،  قَالَ نَفَرٌ  لِعَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - : لَوْ خَطَبْتَ  فَاطِمَةَ  - رَضِيَ اللهُ عَنْهَا - ، فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : "" مَا حَاجَةُ  عَلِيٍّ  ؟ "" قَالَ : ذَكَرْتُ  فَاطِمَةَ بِنْتَ رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : مَرْحَبًا وَأَهْلًا ، لَمْ يَزِدْهُ عَلَيْهِمَا ، فَخَرَجَ  عَلِيٌّ  - رَضِيَ اللهُ عَنْهُ - إِلَى أُولَئِكَ الرَّهْطِ وَهُمْ يَنْتَظِرُونَهُ ، قَالُوا : مَا وَرَاءَكَ ؟ قَالَ : لَا أَدْرِي غَيْرَ أَنَّهُ قَالَ لِي : مَرْحَبًا وَأَهْلًا ، قَالُوا : يَكْفِيكَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَعْطَاكَ الْأَهْلَ وَأَعْطَاكَ الْمَرْحَبَ ، قَالَ : فَلَمَّا بَعُدَ مَا زَوَّجَهُ ، قَالَ : "" يَا  عَلِيُّ  إِنَّهُ لَا بُدَّ  لِلْعُرْسِ  مِنْ وَلِيمَةٍ "" وَقَالَ  سَعْدٌ  : عِنْدِي كَبْشٌ وَجَمَعَ لَهُ رَهْطٌ مِنَ  الْأَنْصَارِ  ، فَلَمَّا كَانَ لَيْلَةُ الْبِنَاءِ ، قَالَ : "" يَا  عَلِيُّ  لَا تُحْدِثْ شَيْئًا حَتَّى تَلْقَانِي "" فَدَعَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمَاءٍ فَتَوَضَّأَ مِنْهُ ، ثُمَّ أَفْرَغَهُ عَلَى  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ - ثُمَّ قَالَ :  اللَّهُمَّ بَارِكْ فِيهِمَا وَبَارِكْ لَهُمَا فِي شِبْلَيْهِمَا  .","","Musnad al-Bazzar 4471","","بريدة بن الحصيب الأسلمي عن عبد الله بن بريدة عن عبد الكريم بن سليط الهفاني عن عبد الرحمن بن حميد الرؤاسي عن مالك بن إسماعيل النهدي عن عبد الملك بن محمد الرقاشي عن البزار","مسند بريدة بن الحصيب رضي الله عنه"
"4480","[10/341]      مُسْنَدُ  وَائِلِ بْنِ حُجْرٍ  رَضِيَ اللهُ عَنْهُ         [10/342]             [10/343]      حَدِيثُ  وَائِلِ بْنِ حُجْرٍ  ( وَيُعَدُّ فِي الْمَدَنِيِّينَ )  4472  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  سَأَلَ  سَلَمَةُ بْنُ يَزِيدَ الْجُعْفِيُّ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ إِنْ قَامَتْ عَلَيْنَا أُمَرَاءُ يَسْأَلُونَا حَقَّهُمْ وَيَمْنَعُونَا حَقَّنَا ، فَمَا تَأْمُرُنَا ؟ فَأَعْرَضَ عَنْهُ ، ثُمَّ سَأَلَهُ فَأَعْرَضَ عَنْهُ ، ثُمَّ سَأَلَهُ فَأَعْرَضَ عَنْهُ ، فَقَالَ :  اسْمَعُوا وَأَطِيعُوا فَإِنَّمَا عَلَيْكُمْ مَا حُمِّلْتُمْ وَعَلَيْهِمْ مَا حُمِّلُوا  .","","Musnad al-Bazzar 4472","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند وائل بن حجر رضي الله عنه"
"4481","4473  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  أَنَّ  طَارِقَ بْنَ         [10/344]      سُوَيْدٍ  سَأَلَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنِ الْخَمْرِ يُتَدَاوَى بِهَا ، فَقَالَ :  لَيْسَ هِيَ  دَوَاءً  ، وَلَكِنَّهَا دَاءٌ  .","","Musnad al-Bazzar 4473","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند وائل بن حجر رضي الله عنه"
"4482","4474  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَمُحَمَّدُ بْنُ بَشَّارٍ ، قَالَا :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا تَقُولُوا لِلْعِنَبِ الْكَرْمَ ، وَلَكِنِ  الْحَبَلَةُ  .","","Musnad al-Bazzar 4474","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند وائل بن حجر رضي الله عنه"
"4483","[10/345]      4475  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَقْطَعَهُ أَرْضًا  ، قَالَ : فَأَرْسَلَ مَعِي  مُعَاوِيَةَ  ، فَقَالَ : أَعْطِهَا إِيَّاهُ ، قَالَ : فَخَرَجْتُ وَأَنَا رَاكِبٌ  وَمُعَاوِيَةُ  يَمْشِي فِي نِصْفِ النَّهَارِ ، فَقَالَ :  مُعَاوِيَةُ  أَرْدِفْنِي خَلْفَكَ ، قُلْتُ : لَا تَكُونُ مِنْ أَرْدَافِ الْمُلُوكِ ، قَالَ : فَأَعْطِنِي نَعْلَكَ ، قُلْتُ : انْتَعِلْ ظِلَّ النَّاقَةِ ، فَلَمَّا اسْتُخْلِفَ  مُعَاوِيَةُ  أَتَيْتُهُ فَأَقْعَدَنِي مَعَهُ عَلَى السَّرِيرِ ، وَذَكَّرَنِي الْحَدِيثَ ، فَوَدِدْتُ أَنِّي كُنْتُ حَمَلْتُهُ بَيْنَ يَدَيَّ  .  وَهَذِهِ الْأَحَادِيثُ لَا نَعْلَمُ رَوَاهَا بِهَذِهِ الْأَلْفَاظِ إِلَّا  وَائِلُ بْنُ حُجْرٍ  ، وَلَا نَعْلَمُ لَهَا طَرِيقًا عَنْ  وَائِلٍ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 4475","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند وائل بن حجر رضي الله عنه"
"4484","4476  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ زِيَادٍ الْبَغْدَادِيُّ ، قَالَ :  نَا  عَاصِمُ بْنُ عَلِيٍّ ،         [10/346]      قَالَ :  نَا  أَبُو الْأَحْوَصِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  جَاءَ  رَجُلٌ مِنْ حَضْرَمَوْتَ  وَرَجُلٌ مِنْ كِنْدَةَ  إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ الْحَضْرَمِيُّ : يَا رَسُولَ اللهِ إِنَّ هَذَا قَدْ غَلَبَنِي عَلَى أَرْضٍ كَانَتْ لِأَبِي ، فَقَالَ الْكِنْدِيُّ : هِيَ أَرْضِي وَفِي يَدِي لَيْسَ لَهُ فِيهَا حَقٌّ ، فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِلْحَضْرَمِيِّ : "" أَلَكَ بَيِّنَةٌ "" قَالَ : مَا لِي بَيِّنَةٌ ، قَالَ : يَحْلِفُ ، قَالَ : إِذًا يَحْلِفُ مَا  يُبَالِي  عَلَى مَا حَلَفَ عَلَيْهِ ، لَيْسَ يَتَوَرَّعُ مِنْ شَيْءٍ ، قَالَ : لَيْسَ لَكَ إِلَّا ذَلِكَ ، ثُمَّ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ حَلَفَ عَلَى مَالِ أَخِيهِ ، فَأَكَلَهُ ظُلْمًا لَقِيَ اللهَ وَهُوَ عَنْهُ مُعْرِضٌ  .","","Musnad al-Bazzar 4476","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن سماك بن حرب البكري عن سلام بن سليم الحنفي عن عاصم بن علي الواسطي عن إبراهيم بن زياد الصائغ عن البزار","مسند وائل بن حجر رضي الله عنه"
"4485","4477  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ الْقُرَشِيُّ ، قَالَ :  نَا  أَبُو عَوَانَةَ ،         [10/347]      عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - قَالَ :  كُنْتُ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَتَاهُ رَجُلَانِ يَخْتَصِمَانِ فِي أَرْضٍ ، فَقَالَ أَحَدُهُمَا : إِنَّ هَذَا  انْتَزَى  عَلَى أَرْضِي فِي الْجَاهِلِيَّةِ يَا رَسُولَ اللهِ ، وَهُوَ  امْرُؤُ الْقَيْسِ  ، وَهَذَا  رَبِيعَةُ بْنُ عَبْدَانَ  ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" بَيِّنَتُكَ "" ، قَالَ : لَيْسَ لِي بَيِّنَةٌ ، قَالَ : "" يَمِينُهُ "" قَالَ : إِذًا يَذْهَبُ بِهَا ، قَالَ : "" لَيْسَ لَكَ إِلَّا ذَلِكَ "" ، فَلَمَّا قَامَ لِيَحْلِفَ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنِ اقْتَطَعَ أَرْضًا ظُلْمًا لَقِيَ اللهَ وَهُوَ عَلَيْهِ غَضْبَانُ  قَالَ أَبُو بَكْرٍ  أَحْسَبُ أَنَّهُ قَالَ : "" مَنْ أُقْطِعَ أَرْضًا ظُلْمًا بِيَمِينِهِ  .","","Musnad al-Bazzar 4477","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند وائل بن حجر رضي الله عنه"
"4486","4478  -  حَدَّثَنَا  أَبُو كُرَيْبٍ ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ ،  عَنِ  الْحَجَّاجِ - يَعْنِي -         [10/348]      ابْنَ أَرْطَاةَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلٍ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - قَالَ  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا سَجَدَ وَضَعَ جَبْهَتَهُ وَأَنْفَهُ عَلَى الْأَرْضِ  .","","Musnad al-Bazzar 4478","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن حجاج بن أرطاة عن هشيم بن بشير عن أبو كريب محمد بن العلاء عن البزار","مسند وائل بن حجر رضي الله عنه"
"4487","4479  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ الْكِنْدِيُّ ، قَالَ :  نَا  مَعْمَرُ بْنُ سُلَيْمَانَ الرَّقِّيُّ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَاةَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلِ بْنِ حُجْرٍ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ -  أَنَّ  امْرَأَةً  اسْتُكْرِهَتْ عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَدَرَأَ  الْحَدَّ  عَنِ الْمَرْأَةِ وَأَقَامَهُ عَلَى الَّذِي أَصَابَهُ ،         [10/349]      وَلَمْ يُذْكَرْ أَنَّهُ جَعَلَ لَهَا مَهْرًا  .  4480  -  وَحَدِيثَيِ  الْحَجَّاجُ  لَا نَعْلَمُ رَوَاهُمَا غَيْرُهُ عَنْ  عَبْدِ الْجَبَّارِ  ، وَلَا نَعْلَمُ  أَسْنَدَ  عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ  عَنْ  عَلْقَمَةَ بْنِ وَائِلٍ  ، عَنْ أَبِيهِ إِلَّا هَذَا الْحَدِيثَ الَّذِي ذَكَرْنَاهُ قَبْلَ حَدِيثِ  الْحَجَّاجِ  .","","Musnad al-Bazzar 4479","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن حجاج بن أرطاة عن معمر بن سليمان النخعي عن عبد الله بن سعيد الأشج عن البزار","مسند وائل بن حجر رضي الله عنه"
"4488","4481  -  حَدَّثَنِي  عَلِيُّ بْنُ سَعِيدٍ الْمَسْرُوقِيُّ ، قَالَ :  نَا  أَبُو الْأَحْوَصِ سَلَّامُ بْنُ سُلَيْمٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَبْدِ الْجَبَّارِ بْنِ وَائِلِ بْنِ حُجْرٍ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ -  أَنَّهُ صَلَّى خَلْفَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَرَأَ فَاتِحَةَ الْكِتَابِ  فَلَمَّا قَالَ         {      وَلا الضَّالِّينَ         }      قَالَ : "" آمِينَ "" رَفَعَ بِهَا صَوْتَهُ  .","","Musnad al-Bazzar 4481","","وائل بن حجر بن سعد الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن علي بن سعيد بن مسروق الكندي عن البزار","مسند وائل بن حجر رضي الله عنه"
"4489","[10/350]      4482  -  حَدَّثَنَا  عَبْدَةُ بْنُ عَبْدِ اللهِ ، قَالَ :  أَنَا  سُفْيَانُ بْنُ عُقْبَةَ وَمُعَاوِيَةُ بْنُ هِشَامٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ - وَلِي شَعَرٌ طَوِيلٌ ، فَقَالَ : ""  ذُبَابٌ  "" فَذَهَبْتُ فَأَخَذْتُهُ ، ثُمَّ جِئْتُ ، فَقَالَ :  لَمْ أَعْنِكَ ، وَهَذَا أَحْسَنُ  .","","Musnad al-Bazzar 4482","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن سفيان الثوري عن سفيان بن عقبة السوائي عن عبدة بن عبد الله بن عبدة الخزاعي عن البزار","مسند وائل بن حجر رضي الله عنه"
"4490","4483  -  حَدَّثَنَا  رَجَاءُ بْنُ مُحَمَّدٍ السَّقَطِيُّ ، وَمُحَمَّدُ بْنُ مُوسَى الْوَاسِطِيُّ ، قَالَا :  أَنَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  أَنَا  شَرِيكٌ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ ،  عَنْ         [10/351]      أَبِيهِ  عَنْ  وَائِلِ بْنِ حُجْرٍ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا صَلَّى فَأَرَادَ أَنْ يَسْجُدَ تَقَعُ رُكْبَتَيْهِ  إِلَى الْأَرْضِ قَبْلَ يَدَيْهِ ،  وَإِذَا رَفَعَ رُكْبَتَيْهِ قَبْلَ يَدَيْهِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  يَزِيدُ بْنُ هَارُونَ  عَنْ  شَرِيكٍ  .  قوله : ( تقع ركبتيه إلى الأرض قبل يديه وإذا رفع ركبتيه قبل يديه ) العبارة فيها اضطراب ولعل صوابها : ( تقع ركبتاه إلى الأرض قبل يديه وإذا رفع يديه قبل ركبتيه ) وينظر مصادر التخريج . والله أعلم","","Musnad al-Bazzar 4483","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن شريك بن عبد الله النخعي عن يزيد بن هارون عن محمد بن موسى بن عمران المنقري عن البزار","مسند وائل بن حجر رضي الله عنه"
"4491","4484  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ الْوَاسِطِيُّ ، قَالَ :  نَا  صِلَةُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  أَبُو هَانِئٍ أَشْعَثُ بْنُ عَبْدِ اللهِ ، قَالَ :  حَدَّثَنِي  حَمْزَةُ أَبُو عُمَرَ ، وَرَجُلٌ آخَرُ ، قَالَا : بَلَغَنَا ،  عَنِ  ابْنِ وَائِلِ بْنِ حُجْرٍ حَدِيثٌ فَلَقِينَاهُ         [10/352]      بِوَاسِطٍ  فِي مَجْلِسٍ فَقُلْنَا لَهُ : مَا حَدِيثٌ بَلَغَنَا عَنْكَ ؟ قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  شَهِدْتُ  رَجُلًا  وَجَاءَ  بِرَجُلٍ  يُقَادُ فِي  نِسْعَةٍ  قَدْ قَتَلَ رَجُلًا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِوَلِيِّ الْمَقْتُولِ : "" أَتَعْفُو ؟  قَالَ : لَا ، قَالَ : "" تَأْخُذُ الدِّيَةَ ؟ "" قَالَ : لَا ، قَالَ : "" فَتَقْتُلُهُ "" ، قَالَ : نَعَمْ ، قَالَ : "" فَاذْهَبْ "" ، قَالَ : فَذَهَبَ بِهِ ، فَلَمَّا كَانَ غَيْرَ بَعِيدٍ دَعَاهُ ، فَقَالَ : "" أَتَعْفُو ؟ "" ، قَالَ : لَا ، قَالَ : "" أَتَأْخُذُ الدِّيَةَ ؟ "" ، قَالَ : لَا ، قَالَ : "" تَقْتُلُهُ "" ، قَالَ : نَعَمْ ، وَذَهَبَ بِهِ حَتَّى فَعَلَ ذَلِكَ مِرَارًا ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : "" إِنْ قَتَلَهُ فَهُوَ مِثْلُهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  وَائِلِ بْنِ حُجْرٍ  ، وَقَدْ رَوَى  أَبُو هُرَيْرَةَ  نَحْوَهُ بِغَيْرِ لَفْظِهِ ،  وَحَمْزَةُ أَبُو عُمَرَ  رَجُلٌ رَوَى عَنْهُ  عَوْفٌ  وَأَشْعَثُ  هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 4484","","وائل بن حجر بن سعد الحضرمي عن علقمة بن وائل بن حجر الحضرمي عن رجل آخر عن أشعث الحمراني عن صلة بن سليمان الواسطي عن حيدون أحمد بن عبد الله الواسطي عن البزار","مسند وائل بن حجر رضي الله عنه"
"4492","4485  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ الْقُرَشِيُّ ، قَالَ :  نَا  بِشْرُ بْنُ         [10/353]      الْمُفَضَّلِ ، قَالَ :  نَا  عَاصِمُ بْنُ كُلَيْبٍ ،  عَنْ  أَبِيهِ  عَنْ  وَائِلِ بْنِ حُجْرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ  رَمَقْتُ  النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا افْتَتَحَ الصَّلَاةَ رَفَعَ يَدَيْهِ حَتَّى بَلَغَ بِهِمَا أُذُنَيْهِ وَكَبَّرَ  ، ثُمَّ وَضَعَ يَدَهُ الْيُمْنَى عَلَى الْيُسْرَى ، فَلَمَّا رَكَعَ رَفَعَ وَرَفَعَ يَدَيْهِ حِينَ رَفَعَ ، فَلَمَّا جَلَسَ فِي الثَّانِيَةِ عَلَى رِجْلِهِ الْيُسْرَى ثَنَاهَا تَحْتَهُ ، ثُمَّ نَصَبَ الْيُمْنَى ، وَوَضَعَ يَدَهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى ، وَيَدَهُ الْيُسْرَى عَلَى فَخِذِهِ الْيُسْرَى ، وَحَلَّقَ حَلْقَةً بِأُصْبُعِهِ السَّبَّابَةِ بِالْيُمْنَى  .","","Musnad al-Bazzar 4485","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن بشر بن المفضل عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند وائل بن حجر رضي الله عنه"
"4493","[10/354]      4486  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ، قَالَ :  نَا  مُحَمَّدُ بْنُ حُجْرٍ ، قَالَ :  حَدَّثَنِي  سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ بْنِ وَائِلِ بْنِ حُجْرٍ ،  عَنْ  أَبِيهِ ،  عَنْ  أُمِّهِ  عَنْ  وَائِلِ بْنِ حُجْرٍ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  بَلَغَنَا ظُهُورُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَحْنُ فِي مُلْكٍ عَظِيمٍ وَطَاعَةٍ ، فَرَفَضْتُهُ وَخَرَجْتُ رَاغِبًا فِي اللهِ وَرَسُولِهِ ، فَلَمَّا قَدِمْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ قَدْ بَشَّرَهُمْ بِقُدُومِي ، فَلَمَّا قَدِمْتُ عَلَيْهِ ، وَسَلَّمْتُ عَلَيْهِ رَدَّ عَلَيَّ ، وَبَسَطَ لِي رِدَاءَهُ وَأَجْلَسَنِي عَلَيْهِ ، ثُمَّ صَعِدَ مِنْبَرَهُ وَأَقْعَدَنِي مَعَهُ ، فَرَفَعَ يَدَهُ فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ وَصَلَّى عَلَى النَّبِيِّينَ وَاجْتَمَعَ النَّاسُ إِلَيْهِ ، فَقَالَ لَهُمْ :  أَيُّهَا النَّاسُ ، هَذَا  وَائِلُ بْنُ حُجْرٍ  قَدْ أَتَاكُمْ مِنْ أَرْضٍ بَعِيدَةٍ مِنْ  حَضْرَمَوْتَ  طَائِعًا غَيْرَ مُكْرَهٍ ،  رَاغِبًا فِي اللهِ وَرَسُولِهِ وَفِي دِينِهِ ، بَقِيَّةُ أَبْنَاءِ الْمُلُوكِ "" فَقُلْتُ : يَا رَسُولَ اللهِ ، مَا هُوَ إِلَّا بَلَغَنَا ظُهُورُكَ وَنَحْنُ فِي مُلْكٍ عَظِيمٍ وَطَاعَةٍ عَظِيمَةٍ ،         [10/355]      فَأَتَيْتُكَ رَاغِبًا فِي اللهِ وَفِي رَسُولِهِ وَفِي دِينِهِ . قَالَ : "" صَدَقْتَ  .","","Musnad al-Bazzar 4486","","وائل بن حجر بن سعد الحضرمي عن أم عبد الجبار بن وائل بن حجر الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن سعيد بن عبد الجبار بن وائل بن حجر الحضرمي عن محمد بن حجر بن عبد الجبار عن إبراهيم بن سعيد الجوهري عن البزار","مسند وائل بن حجر رضي الله عنه"
"4494","4487  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ حُجْرٍ ، قَالَ :  نَا  سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ بْنِ وَائِلِ بْنِ حُجْرٍ ،  عَنْ  أَبِيهِ ،  عَنْ  أُمِّهِ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الشِّغَارِ  .","","Musnad al-Bazzar 4487","","وائل بن حجر بن سعد الحضرمي عن أم عبد الجبار بن وائل بن حجر الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن سعيد بن عبد الجبار بن وائل بن حجر الحضرمي عن محمد بن حجر بن عبد الجبار عن إبراهيم بن سعيد الجوهري عن البزار","مسند وائل بن حجر رضي الله عنه"
"4495","4488  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ، قَالَ :  نَا  مُحَمَّدُ بْنُ حُجْرٍ ، قَالَ :  حَدَّثَنِي  سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ بْنِ وَائِلِ بْنِ حُجْرٍ ،  عَنْ  أَبِيهِ ،  عَنْ  أُمِّهِ ،  عَنْ  وَائِلِ بْنِ حُجْرٍ  - رَضِيَ اللهُ عَنْهُ - قَالَ :  شَهِدْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأُتِيَ بِإِنَاءٍ فِيهِ مَاءٌ ، فَأَكْفَاهُ عَلَى يَمِينِهِ ثَلَاثًا  ، ثُمَّ غَمَسَ يَمِينَهُ فِي الْمَاءِ ،         [10/356]      فَغَسَلَ بِهَا يَسَارَهُ ثَلَاثًا ، ثُمَّ أَدْخَلَ يَمِينَهُ فِي الْمَاءِ فَحَفَنَ بِهَا حَفْنَةً مِنَ الْمَاءِ فَمَضْمَضَ وَاسْتَنْشَقَ ثَلَاثًا  وَاسْتَنْثَرَ  ، ثُمَّ أَدْخَلَ كَفَّيْهِ فِي الْإِنَاءِ فَرَفَعَهَا إِلَى وَجْهِهِ ، فَغَسَلَ وَجْهَهُ ثَلَاثًا ، وَغَسَلَ بَاطِنَ أُذُنَيْهِ ، وَأَدْخَلَ أُصْبُعَيْهِ فِي دَاخِلِ أُذُنَيْهِ ، وَمَسَحَ ظَاهِرَ رَقَبَتِهِ وَبَاطِنَ لِحْيَتِهِ ثَلَاثًا ، ثُمَّ أَدْخَلَ يَمِينَهُ فِي الْمَاءِ فَغَسَلَ بِهَا ذِرَاعَهُ الْيُمْنَى حَتَّى جَاوَزَ الْمِرْفَقَ ثَلَاثًا ، ثُمَّ غَسَلَ يَسَارَهُ بِيَمِينِهِ حَتَّى جَاوَزَ الْمِرْفَقَ ثَلَاثًا ، ثُمَّ مَسَحَ عَلَى رَأْسِهِ ثَلَاثًا وَظَاهِرِ أُذُنَيْهِ ثَلَاثًا وَظَاهِرِ رَقَبَتِهِ ، وَأَظُنُّهُ قَالَ : وَظَاهِرِ لِحْيَتِهِ ثَلَاثًا ، ثُمَّ غَسَلَ بِيَمِينِهِ قَدَمَهُ الْيُمْنَى ثَلَاثًا ،  وَفَصَلَ بَيْنَ أَصَابِعِهِ ، أَوْ قَالَ : خَلَّلَ بَيْنَ أَصَابِعِهِ  ، وَرَفَعَ الْمَاءَ حَتَّى جَازَ الْكَعْبَ ، ثُمَّ رَفَعَهُ فِي السَّاقِ ، ثُمَّ فَعَلَ بِالْيُسْرَى مِثْلَ ذَلِكَ ، ثُمَّ أَخَذَ حَفْنَةً مِنْ مَاءٍ فَمَلَأَ بِهَا يَدَهُ ، ثُمَّ وَضَعَهَا عَلَى رَأْسِهِ حَتَّى انْحَدَرَ الْمَاءُ مِنْ جَوَانِبِهِ ، وَقَالَ : هَذَا تَمَامُ الْوُضُوءِ وَلَمْ أَرَهُ تَنَشَّفَ بِثَوْبٍ ، ثُمَّ نَهَضَ إِلَى الْمَسْجِدِ ، فَدَخَلَ فِي  الْمِحْرَابِ  - يَعْنِي- مَوْضِعَ  الْمِحْرَابِ  ، فَصَفَّ النَّاسَ خَلْفَهُ وَعَنْ يَمِينِهِ وَعَنْ يَسَارِهِ ، ثُمَّ رَفَعَ يَدَيْهِ حَتَّى حَاذَتَا  بِشَحْمَةِ  أُذُنَيْهِ ، ثُمَّ وَضَعَ يَمِينَهُ عَلَى يَسَارِهِ عِنْدَ صَدْرِهِ ، ثُمَّ افْتَتَحَ الْقِرَاءَةَ فَجَهَرَ بِالْحَمْدِ ، ثُمَّ فَرَغَ مِنْ سُورَةِ الْحَمْدِ ، ثُمَّ قَالَ : "" آمِينَ "" حَتَّى  سَمِعَ  مَنْ خَلْفَهُ ، ثُمَّ قَرَأَ سُورَةً أُخْرَى ، ثُمَّ رَفَعَ يَدَيْهِ بِالتَّكْبِيرِ حَتَّى حَاذَتَا  بِشَحْمَةِ  أُذُنَيْهِ ، ثُمَّ رَكَعَ فَجَعَلَ يَدَيْهِ عَلَى رُكْبَتَيْهِ ، وَفَرَّجَ بَيْنَ أَصَابِعِهِ ، وَأَمْهَلَ فِي الرُّكُوعِ حَتَّى اعْتَدَلَ وَصَارَ صُلْبُهُ لَوْ وُضِعَ عَلَيْهِ قَدَحٌ مِنَ الْمَاءِ مَا  انْكَفَأَ  ، ثُمَّ رَفَعَ رَأْسَهُ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِخُشُوعٍ وَقَالَ : ""  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ "" ، ثُمَّ رَفَعَ يَدَيْهِ حَتَّى حَاذَتَا  بِشَحْمَةِ  أُذُنَيْهِ ، ثُمَّ انْحَطَّ لِلسُّجُودِ بِالتَّكْبِيرِ فَرَفَعَ يَدَيْهِ إِلَى أَنْ حَاذَتَا  بِشَحْمَةِ  أُذُنَيْهِ ، ثُمَّ أَثْبَتَ جَبْهَتَهُ فِي الْأَرْضِ حَتَّى إِنِّي أَرَى أَنْفَهُ فِي الرَّمْلِ ، وَقَوَّسَ بِذِرَاعَيْهِ وَرَأْسَهُ ، وَبَسَطَ         [10/357]      فَخِذَهُ الْيَسَارَ وَنَصَبَ الْيَمِينَ كَمَا أَثْبَتَ أَصَابِعَ رِجْلَيْهِ وَلَمْ يُمْهِلْ بِالسُّجُودِ وَرَفَعَ رَأْسَهُ ، فَرَفَعَ يَدَيْهِ بِالتَّكْبِيرِ إِلَى أَنْ حَاذَتَا  بِشَحْمَةِ  أُذُنَيْهِ ، وَجَلَسَ جِلْسَةً خَفِيفَةً ، فَوَضَعَ كَفَّهُ الْيَمِينَ عَلَى رُكْبَتِهِ وَبَعْضِ فَخِذِهِ ، وَحَلَّقَ بِأُصْبُعِهِ ، ثُمَّ انْحَطَّ سَاجِدًا بِمِثْلِ ذَلِكَ ، ثُمَّ رَفَعَ رَأْسَهُ بِالتَّكْبِيرِ بِيَدَيْهِ إِلَى أَنْ حَاذَتَا  بِشَحْمَةِ  أُذُنَيْهِ وَإِلَى أَنِ اعْتَدَلَ فِي قِيَامِهِ وَرَجَعَ كُلُّ عَظْمٍ إِلَى مَوْضِعِهِ ، ثُمَّ صَلَّى أَرْبَعَ رَكَعَاتٍ يَفْعَلُ فِيهِنَّ مَا يَفْعَلُ فِي هَذِهِ ، ثُمَّ جَلَسَ جِلْسَةً فِي  التَّشَهُّدِ  مِثْلَ ذَلِكَ ، ثُمَّ سَلَّمَ عَلَى يَمِينِهِ حَتَّى يُرَى بَيَاضُ خَدِّهِ الْأَيْسَرِ ، وَسَلَّمَ عَنْ يَسَارِهِ حَتَّى يُرَى بَيَاضُ خَدِّهِ الْأَيْمَنِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  وَائِلِ بْنِ حُجْرٍ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4488","","وائل بن حجر بن سعد الحضرمي عن أم عبد الجبار بن وائل بن حجر الحضرمي عن عبد الجبار بن وائل بن حجر الحضرمي عن سعيد بن عبد الجبار بن وائل بن حجر الحضرمي عن محمد بن حجر بن عبد الجبار عن إبراهيم بن سعيد الجوهري عن البزار","مسند وائل بن حجر رضي الله عنه"
"4496","4489  -  حَدَّثَنَا  مَعْمَرُ بْنُ سَهْلٍ ، قَالَ :  نَا  عَامِرُ بْنُ مُدْرِكٍ ، قَالَ :  نَا  خَلَّادٌ يَعْنِي ابْنَ مُسْلِمٍ الصَّفَّارَ ،  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ ،  عَنْ  عَاصِمِ بْنِ         [10/358]      كُلَيْبٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  وَائِلِ بْنِ حُجْرٍ - رَضِيَ اللهُ عَنْهُ - قَالَ :  تَفَقَّدْتُ صَلَاةَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَأَيْتُهُ يَرْفَعُ يَدَيْهِ إِذَا كَبَّرَ  ، ثُمَّ يَضَعُ يَدَيْهِ وَاحِدَةً عَلَى الْأُخْرَى ، ثُمَّ إِذَا أَرَادَ أَنْ يَرْكَعَ رَفَعَ يَدَيْهِ فَكَبَّرَ ، ثُمَّ قَالَ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، فَرَفَعَ ، فَأُوهِمْتُ رَفَعَ حِينَ سَجَدَ أَمْ لَا ؟ قَالَ : فَرَكَعَ رَكْعَتَيْنِ ، فَلَمَّا قَعَدَ  لِلتَّشَهُّدِ  افْتَرَشَ رِجْلَهُ الْيُسْرَى وَوَضَعَ يَدَهُ الْيُمْنَى عَلَى فَخِذِهِ ، ثُمَّ عَقَدَ أُصْبُعَيْهِ ، ثُمَّ حَلَّقَ حَلْقَةً وَأَشَارَ بِالسَّبَّابَةِ ، وَسَلَّمَ عَنْ يَمِينِهِ وَعَنْ يَسَارِهِ ، قَالَ : وَرَأَيْتُهُ يُكَبِّرُ كُلَّمَا خَفَضَ وَرَفَعَ  .","","Musnad al-Bazzar 4489","","وائل بن حجر بن سعد الحضرمي عن كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن موسى بن أبي عائشة المخزومي عن خلاد بن عيسى الصفار عن عامر بن مدرك بن أبي الصفيراء الحارثي عن معمر بن سهل بن معمر الأهوازي عن البزار","مسند وائل بن حجر رضي الله عنه"
"4497","[10/359]      مُسْنَدُ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ  رَضِيَ اللهُ عَنْهُ         [10/360]             [10/361]      حَدِيثُ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  4490  -  حَدَّثَنَا  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ، وَإِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ الشَّهِيدِ ، قَالَا :  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  أَبِي  ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ  وَجَارِيَةٌ مِنَ الْأَنْصَارِ  عَلَى بَعِيرٍ لَهَا ، فَنَظَرَتْ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَلْفَهَا وَقَدْ تَضَايَقَ بِهِمُ الْجَبَلُ ، فَقَالَتْ : حَلٍ حَلْ عَلَيْكَ لَعْنَةُ اللهِ -  تَعْنِي لِبَعِيرِهَا  - فَقَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ صَاحِبُ هَذَا الْبَعِيرِ أَوِ الرَّاحِلَةِ ، فَلَا يَصْحَبُنَا بَعِيرٌ عَلَيْهِ مِنَ اللهِ لَعْنَةٌ  .         [10/362]      وَهَذَا الْكَلَامُ قَدْ رُوِيَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِأَلْفَاظٍ مُخْتَلِفَةٍ فَذَكَرْنَا كُلَّ حَدِيثٍ بِلَفْظِهِ فِي مَوْضِعِهِ ، وَلَا نَعْلَمُهُ يُرْوَى عَنْ  أَبِي بَرْزَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَاسْمُ  أَبِي بَرْزَةَ نَضْلَةُ بْنُ عُبَيْدٍ  ، وَاسْمُ  أَبِي عَزَّةَ يَسَارُ بْنُ عُبَيْدٍ  ، وَاسْمُ  أَبِي عُثْمَانَ النَّهْدِيِّ عَبْدُ الرَّحْمَنِ بْنُ مُلٍّ  .","","Musnad al-Bazzar 4490","","نضلة بن عبيد بن عابد الأسلمي عن أبو عثمان النهدي عن سليمان بن طرخان عن معتمر بن سليمان عن يحيى بن حبيب الحارثي عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4498","4491  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  هِشَامُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ :  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  ثَابِتٍ الْبُنَانِيِّ ،  عَنْ  كِنَانَةَ بْنِ نُعَيْمٍ ،  عَنْ  أَبِي بَرْزَةَ - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَقِيَ الْعَدُوَّ فَأَفَاءَ اللهُ عَلَيْهِ ، فَقَالَ : "" هَلْ تَفْقِدُونَ مِنْ أَحَدٍ "" قَالُوا : نَعَمْ ، فُلَانًا وَفُلَانًا ، ثُمَّ قَالَ : "" هَلْ تَفْقِدُونَ مِنْ أَحَدٍ "" فِي الثَّانِي وَالثَّالِثِ ، قَالُوا : لَا ، قَالَ :  لَكِنِّي أَفْقِدُ  جُلَيْبِيبًا  انْطَلِقُوا فَالْتَمِسُوهُ فِي الْقَتْلَى  ، فَالْتَمَسُوهُ فَوَجَدُوهُ إِلَى جَنْبِ سَبْعَةٍ قَدْ قَتَلَهُمْ ، ثُمَّ قَتَلُوهُ فَأُتِيَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأُخْبِرَ ، فَجَاءَ حَتَّى قَامَ ، فَقَالَ : "" هَذَا مِنِّي وَأَنَا مِنْهُ قَتَلَ سَبْعَةً ، هَذَا مِنِّي وَأَنَا مِنْهُ "" يَقُولُهَا مَرَّتَيْنِ ، ثُمَّ حَمَلَهُ عَلَى سَاعِدَيْهِ مَا لَهُ سَرِيرٌ غَيْرَ سَاعِدَيِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى حُفِرَ لَهُ وَدُفِنَ وَلَمْ يَذْكُرْ غُسْلًا  .         [10/363]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  أَبُو بَرْزَةَ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا عَنْ  أَبِي بَرْزَةَ  إِلَّا هَذَا الطَّرِيقَ .","","Musnad al-Bazzar 4491","","نضلة بن عبيد بن عابد الأسلمي عن كنانة بن نعيم العدوي عن ثابت البناني عن حماد بن سلمة عن أبو الوليد الطيالسي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4499","4492  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  حَمَّادٌ - يَعْنِي - ابْنَ سَلَمَةَ  عَنِ  الْأَزْرَقِ بْنِ قَيْسٍ ،  عَنْ  شَرِيكِ بْنِ شِهَابٍ ، قَالَ :  كُنْتُ أَتَمَنَّى أَنْ أَلْقَى رَجُلًا مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَسْأَلُهُ عَنِ الْخَوَارِجِ ، فَلَقِيتُ أَبَا بَرْزَةَ فِي يَوْمِ عِيدٍ فِي نَفَرٍ مِنْ أَصْحَابِهِ ، فَقُلْتُ لَهُ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِأُذُنِي وَرَأَيْتُهُ بِعَيْنِي أُتِيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِمَالٍ فَأَعْطَى مَنْ عَنْ يَمِينِهِ وَمَنْ عَنْ شِمَالِهِ ، وَلَمْ يُعْطِ مَنْ وَرَاءَهُ شَيْئًا ، فَقَامَ  رَجُلٌ  مِنْ وَرَائِهِ ، فَقَالَ : يَا  مُحَمَّدُ ،  وَاللهِ مَا عَدَلْتَ فِيَّ مُنْذُ الْيَوْمِ ، وَكَانَ رَجُلًا أَسْوَدَ  مَطْمُومَ  الشَّعَرِ عَلَيْهِ ثَوْبَانِ أَبْيَضَانِ ، قَالَ فَغَضِبَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - غَضَبًا شَدِيدًا ، وَقَالَ :  اللهِ لَا تَجِدُونَ بَعْدِي رَجُلًا هُوَ أَعْدَلُ عَلَيْكُمْ مِنِّي  ، ثُمَّ قَالَ : "" يَخْرُجُ فِي آخِرِ الزَّمَانِ قَوْمٌ كَأَنَّ هَذَا         [10/364]      مِنْهُمْ يَقْرَءُونَ الْقُرْآنَ لَا يُجَاوِزُ  تَرَاقِيَهُمْ  يَمْرُقُونَ  مِنَ الْإِسْلَامِ كَمَا  يَمْرُقُ  السَّهْمُ مِنَ  الرَّمِيَّةِ ،  سِيمَاهُمُ  التَّحْلِيقُ ، لَا يَزَالُونَ يَخْرُجُونَ حَتَّى يَخْرُجَ آخِرُهُمْ مَعَ  الْمَسِيحِ الدَّجَّالِ  ، فَإِذَا لَقِيتُمُوهُمْ فَاقْتُلُوهُمْ ، شَرُّ  الْخَلْقِ  وَالْخَلِيقَةِ  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ نَحْوُ كَلَامِهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ غَيْرِ وَجْهٍ ، فَذَكَرْنَا كُلَّ حَدِيثٍ بِلَفْظِهِ فِي مَوْضِعِهِ ، وَلَا نَعْلَمُ رَوَى عَنْ  شَرِيكِ بْنِ شِهَابٍ  إِلَّا  الْأَزْرَقُ بْنُ قَيْسٍ  ، وَلَا نَعْلَمُ رَوَى غَيْرَ هَذَا الْحَدِيثِ .","","Musnad al-Bazzar 4492","","نضلة بن عبيد بن عابد الأسلمي عن شريك بن شهاب الحارثي عن أزرق بن قيس الحارثي عن حماد بن سلمة عن أبو داود الطيالسي عن الفلاس عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4500","4493  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْقُرَشِيُّ ، قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ  عَنْ  جَمِيلِ بْنِ مُرَّةَ ،  عَنْ  أَبِي الْوَضِيءِ ،  عَنْ  أَبِي بَرْزَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  الْبَيِّعَانِ  بِالْخِيَارِ  مَا لَمْ  يَتَفَرَّقَا  .         [10/365]","","Musnad al-Bazzar 4493","","نضلة بن عبيد بن عابد الأسلمي عن عباد بن نسيب السحتني عن جميل بن مرة الشيباني عن حماد بن زيد عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4501","4494  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ خَالِدِ بْنِ خِدَاشٍ ، قَالَ :  نَا  عَبْدُ الْقَاهِرِ بْنُ شُعَيْبٍ ، قَالَ :  نَا  هِشَامُ بْنُ حَسَّانَ ،  عَنْ  جَمِيلِ بْنِ مُرَّةَ ،  عَنْ  أَبِي الْوَضِيءِ ،  عَنْ  أَبِي بَرْزَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .","","Musnad al-Bazzar 4494","","نضلة بن عبيد بن عابد الأسلمي عن عباد بن نسيب السحتني عن جميل بن مرة الشيباني عن هشام بن حسان العتكي عن عبد القاهر بن شعيب المعولي عن محمد بن خالد بن خداش المهلبي عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4502","4495  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  نَا  أَبَانُ بْنُ صَمْعَةَ ،  عَنْ  أَبِي الْوَازِعِ ،  عَنْ  أَبِي بَرْزَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ عَلِّمْنِي شَيْئًا أَنْتَفِعُ بِهِ ، قَالَ :  اعْزِلِ  الْأَذَى  عَنْ طَرِيقِ الْمُسْلِمِينَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  أَبِي بَرْزَةَ  ،  وَأَبُو الْوَازِعِ  رَجُلٌ مِنْ  أَهْلِ الْبَصْرَةِ ،  وَرَوَى عَنْهُ  أَيُّوبُ ،  وَشَدَّادُ بْنُ سَعِيدٍ ،  وَمَهْدِيُّ بْنُ مَيْمُونٍ  وَغَيْرُهُمْ .","","Musnad al-Bazzar 4495","","نضلة بن عبيد بن عابد الأسلمي عن جابر بن عمرو الراسبي عن أبان بن صمعة عن يحيى القطان عن الفلاس عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4503","[10/366]      4496  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  رَوْحُ بْنُ أَسْلَمَ ، وَالْحَجَّاجُ بْنُ نُصَيْرٍ ، قَالَ :  نَا  أَبُو طَلْحَةَ وَهُوَ شَدَّادُ بْنُ سَعِيدٍ ،  عَنْ  أَبِي الْوَازِعِ ،  عَنْ  أَبِي بَرْزَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّ لِي حَوْضًا مَا بَيْنَ  أَيْلَةَ  وَصَنْعَاءَ  عَرْضُهُ كَطُولِهِ ،  يَعُبُّ  فِي مِيزَابَانِ مِنَ الْجَنَّةِ أَحَدُهُمَا مِنْ  وَرِقٍ  ، وَالْآخَرُ مِنْ ذَهَبٍ ، وَأَبْيَضُ مِنَ اللَّبَنِ ، وَأَحْلَى مِنَ الْعَسَلِ ، وَأَبْرَدُ مِنَ الثَّلْجِ ، فِيهِ آنِيَةٌ عَدَدُ نُجُومِ السَّمَاءِ ، مَنْ شَرِبَ مِنْهُ شَرْبَةً لَمْ يَظْمَأْ حَتَّى يَدْخُلَ الْجَنَّةَ  .  قَالَ  رَوْحٌ  فِي حَدِيثِهِ : وَزَادَ شَدَّادُ بْنُ سَعِيدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي الْوَازِعِ ،  عَنْ  أَبِي بَرْزَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  تنزوا فِي أَيْدِي الْمُؤْمِنِينَ  .  يَعْنِي الْآنِيَةَ  .  وَلَا نَعْلَمُ رَوَى  أَيُّوبُ  عَنْ  أَبِي الْوَازِعِ  إِلَّا هَذَا الْحَدِيثَ ، وَلَا رَوَاهُ عَنْ  أَيُّوبَ  إِلَّا  شَدَّادُ بْنُ سَعِيدٍ  .","","Musnad al-Bazzar 4496","","نضلة بن عبيد بن عابد الأسلمي عن جابر بن عمرو الراسبي عن أيوب السختياني عن شداد بن سعيد الراسبي عن روح بن أسلم الباهلي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4504","[10/367]      4497  -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ، قَالَ :  نَا  مَهْدِيُّ بْنُ مَيْمُونٍ ، قَالَ :  نَا  أَبُو الْوَازِعِ ،  عَنْ  أَبِي بَرْزَةَ - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَعَثَ  رَجُلًا  إِلَى حَيٍّ مِنْ أَحْيَاءِ الْعَرَبِ ، فَسَبُّوهُ وَضَرَبُوهُ ، فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرَهُ ، فَقَالَ :  لَوْ  أَهْلَ عُمَانَ  أَتَيْتَ إِذًا مَا ضَرَبُوكَ وَلَا سَبُّوكَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ بِهَذَا اللَّفْظِ إِلَّا عَنْ  أَبِي بَرْزَةَ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَدْ رُوِيَ عَنِ  ابْنِ عُمَرَ  قَرِيبًا مِنْهُ بِغَيْرِ لَفْظِهِ .","","Musnad al-Bazzar 4497","","نضلة بن عبيد بن عابد الأسلمي عن جابر بن عمرو الراسبي عن مهدي بن ميمون المعولي عن عبد الواحد بن غياث عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4505","4498  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، وَرَجَاءُ بْنُ مُحَمَّدٍ ، قَالَا :  نَا  يَعْلَى بْنُ عُبَيْدٍ ، قَالَ :  نَا  الْحَجَّاجُ بْنُ دِينَارٍ ،  عَنْ  أَبِي هَاشِمٍ ،  عَنْ  أَبِي الْعَالِيَةِ ،  عَنْ  أَبِي بَرْزَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا جَلَسَ فَأَرَادَ أَنْ يَقُومَ ، قَالَ : "" سُبْحَانَكَ اللَّهُمَّ  وَبِحَمْدِكَ  أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ  أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ "" قَالُوا : يَا رَسُولَ اللهِ ، إِنَّكَ لَتَقُولُ كَلَامًا مَا         [10/368]      كُنْتَ تَقُولُهُ فِيمَا خَلَا ، فَقَالَ : "" هَذَا كَفَّارَةُ مَا يَكُونُ مِنَ الْمَجْلِسِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  أَبِي بَرْزَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4498","","نضلة بن عبيد بن عابد الأسلمي عن رفيع بن مهران عن يحيى بن دينار الرماني عن حجاج بن دينار الأشجعي عن يعلى بن عبيد الطنافسي عن رجاء بن محمد العذري عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4506","4499  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  عُثْمَانُ بْنُ عُثْمَانَ الْغَطَفَانِيُّ ، قَالَ :  نَا  خَالِدٌ الْحَذَّاءُ ،  عَنِ  الْمُغِيرَةِ بْنِ أَبِي بَرْزَةَ ،  عَنْ  أَبِيهِ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ النَّوْمِ قَبْلَهَا وَالْحَدِيثِ بَعْدَهَا  ،  يَعْنِي الْعِشَاءَ  .         [10/369]","","Musnad al-Bazzar 4499","","نضلة بن عبيد بن عابد الأسلمي عن المغيرة بن أبي برزة الأسلمي عن خالد الحذاء عن عثمان بن عثمان الغطفاني عن أبو موسى الزمن عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4507","4500  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  عَنْ  شُعْبَةَ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي الْمِنْهَالِ ،  عَنْ  أَبِي بَرْزَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  4501  -  وَحَدِيثُ  خَالِدٍ الْحَذَّاءِ  ، عَنِ  الْمُغِيرَةِ بْنِ أَبِي بَرْزَةَ  ، عَنْ أَبِيهِ أَحَسَبُ وَهِمَ فِيهِ  عُثْمَانُ بْنُ عُثْمَانَ  ، وَالصَّوَابُ :  خَالِدٌ الْحَذَّاءُ  ، عَنْ  أَبِي الْمِنْهَالِ  ، عَنْ  أَبِي بَرْزَةَ  ،  وَأَبُو الْمِنْهَالِ اسْمُهُ سَيَّارُ بْنُ سَلَامَةَ  .","","Musnad al-Bazzar 4500","","نضلة بن عبيد بن عابد الأسلمي عن سيار بن سلامة الرياحي عن خالد الحذاء عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4508","4502  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  أَبُو النُّعْمَانِ مُحَمَّدُ بْنُ الْفَضْلِ ، قَالَ :  نَا  سُكَيْنُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  سَيَّارِ بْنِ سَلَامَةَ ،  عَنْ  أَبِي         [10/370]      بَرْزَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْأُمَرَاءُ مِنْ  قُرَيْشٍ ،  وَلِي عَلَيْهِمْ حَقٌّ ، وَلَهُمْ عَلَيْكُمْ حَقٌّ  مَا فَعَلُوا ثَلَاثًا : مَا اسْتُرْحِمُوا فَرَحِمُوا ، وَحَكَمُوا فَعَدَلُوا ، وَعَاهَدُوا فَوَفَوْا ، فَمَنْ لَمْ يَفْعَلْ ذَلِكَ مِنْهُمْ فَعَلَيْهِ لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ إِلَّا عَنْ  أَبِي بَرْزَةَ  بِهَذَا  الْإِسْنَادِ  ،  وَسُكَيْنٌ رَجُلٌ مَشْهُورٌ مِنْ أَهْلِ الْبَصْرَةِ  .","","Musnad al-Bazzar 4502","","نضلة بن عبيد بن عابد الأسلمي عن سيار بن سلامة الرياحي عن سكين بن عبد العزيز بن قيس المجاشعي عن محمد بن الفضل السدوسي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4509","4503  -  حَدَّثَنَا  يَحْيَى بْنُ حَكِيمٍ ، قَالَ :  نَا  يَحْيَى بْنُ حَمَّادٍ ، قَالَ :  نَا  أَبُو الْأَشْهَبِ ، وَاسْمُهُ جَعْفَرُ بْنُ حَيَّانَ ،  عَنْ  أَبِي الْحَكَمِ ،  عَنْ  أَبِي بَرْزَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  إِنَّمَا أَخْشَى عَلَيْكُمْ شَهَوَاتِ  الْغَيِّ  فِي بُطُونِكُمْ  وَفُرُوجِكُمْ  وَمُضِلَّاتِ الْهَوَى  .         [10/371]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  أَبِي بَرْزَةَ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4503","","نضلة بن عبيد بن عابد الأسلمي عن علي بن الحكم البناني عن جعفر بن حيان العطاردي عن يحيى بن حماد بن أبي زياد الشيباني عن يحيى بن حكيم المقوم عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4510","4504  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، وَيَحْيَى بْنُ حَكِيمٍ ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْمُغِيرَةِ بْنِ أَبِي بَرْزَةَ ،  عَنْ  أَبِيهِ -  رَضِيَ اللهُ عَنْهُ - قَالَ : ""  أَسْلَمُ  سَالَمَهَا  اللهُ  وَغِفَارُ  غَفَرَ  اللهُ لَهَا  .","","Musnad al-Bazzar 4504","","نضلة بن عبيد بن عابد الأسلمي عن المغيرة بن أبي برزة الأسلمي عن علي بن زيد بن جدعان عن شعبة بن الحجاج عن عبد الرحمن بن مهدي عن يحيى بن حكيم المقوم عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4511","4505  -  وَحَدَّثَنَاهُ  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ، قَالَ :  نَا  خَالِدُ بْنُ الْحَارِثِ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنِ  الْمُغِيرَةِ بْنِ أَبِي بَرْزَةَ  عَنْ  أَبِيهِ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .         [10/372]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  أَبِي بَرْزَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  عَلِيِّ بْنِ زَيْدٍ  إِلَّا  شُعْبَةُ  .","","Musnad al-Bazzar 4505","","نضلة بن عبيد بن عابد الأسلمي عن المغيرة بن أبي برزة الأسلمي عن علي بن زيد بن جدعان عن شعبة بن الحجاج عن خالد الصدق عن يحيى بن حبيب الحارثي عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4512","4506  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  حَمَّادُ بْنُ مَسْعَدَةَ ، قَالَ :  نَا  عَبْدُ السَّلَامِ بْنُ أَبِي حَازِمٍ ، قَالَ :  رَأَيْتُ  أَبَا بَرْزَةَ وَأَرْسَلَ إِلَيْهِ  ابْنُ زِيَادٍ  يَسْأَلُهُ عَنِ الْحَوْضِ ، قَالَ : فَأَخْبَرَنِي مَنْ دَخَلَ مَعَهُ ، قَالَ : فَلَمَّا رَآهُ  ابْنُ زِيَادٍ  ، قَالَ : إِنَّ مُحَمَّدِيَّكُمْ هَذَا  لَدَحْدَاحٌ ،  قَالَ : فَلَمَّا سَمِعَهَا  أَبُو بَرْزَةَ  ، قَالَ : مَا كُنْتُ أَرَى أَنْ أَعِيشَ حَتَّى أُعَيَّرَ بِصُحْبَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : فَقِيلَ لَهُ : إِنَّكَ لَا تُعَيَّرُ بِذَلِكَ ، قَالَ : وَسَأَلَهُ  ابْنُ زِيَادٍ  عَنِ الْحَوْضِ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : أَحْسَبُهُ قَالَ :  إِنَّ لِي حَوْضًا فَمَنْ كَذَّبَ بِهِ لَا أَوْرَدَهُ اللهُ  . يَعْنِي إِيَّاهُ  .","","Musnad al-Bazzar 4506","","نضلة بن عبيد بن عابد الأسلمي عن عبد السلام بن أبي حازم القيسي عن حماد بن مسعدة عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4513","4507  -  حَدَّثَنَا  يَحْيَى بْنُ حَكِيمٍ ، قَالَ :  نَا  أَبُو بَحْرٍ عَبْدُ الرَّحْمَنِ بْنُ عُثْمَانَ ، قَالَ :  نَا  عَوْفٌ ،  عَنْ  أَبِي الْمُسَاوِرِ ، قَالَ :  قُلْتُ  لِأَبِي بَرْزَةَ - رَضِيَ اللهُ         [10/373]      عَنْهُ - : مَنْ رَجَمَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟  قَالَ :  رَجُلٌ  مِنَّا يُقَالُ لَهُ :  مَاعِزُ بْنُ مَالِكٍ  .","","Musnad al-Bazzar 4507","","نضلة بن عبيد بن عابد الأسلمي عن مساور بن عبيد الحماني عن عوف بن أبي جميلة عن أبو بحر البكراوي عن يحيى بن حكيم المقوم عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4514","4508  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُوسَى الْقَطَّانُ الْوَاسِطِيُّ ، قَالَ :  نَا  أَبُو الْمُسَيِّبِ سَلَّامُ بْنُ سَلْمٍ الْوَاسِطِيُّ ، قَالَ :  نَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنِ  الْأَزْرَقِ بْنِ قَيْسٍ ،  عَنْ  أَبِي بَرْزَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  خَيْرُ النَّاسِ  قَرْنِي  ، ثُمَّ الَّذِينَ يَلُونَهُمْ ، ثُمَّ الَّذِينَ يَلُونَهُمْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا  أَسْنَدَهُ  إِلَّا  مُبَارَكُ بْنُ فَضَالَةَ  عَنِ  الْأَزْرَقِ  عَنْ  أَبِي بَرْزَةَ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  مُبَارَكِ بْنِ فَضَالَةَ  إِلَّا  سَلَّامُ بْنُ سَلْمٍ  .","","Musnad al-Bazzar 4508","","نضلة بن عبيد بن عابد الأسلمي عن أزرق بن قيس الحارثي عن مبارك بن فضالة عن سلم بن سلام بن نصر الواسطي عن محمد بن موسى بن عمران المنقري عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4515","[10/374]      4509  -  وَحَدَّثَنَا  عَبَّادُ بْنُ يَعْقُوبَ الْكُوفِيُّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ فُضَيْلِ بْنِ غَزْوَانَ ، قَالَ :  نَا  يَزِيدُ بْنُ أَبِي زِيَادٍ ،  عَنْ  سُلَيْمَانَ بْنِ عَمْرِو بْنِ الْأَحْوَصِ ،  عَنْ  أَبِي هِلَالٍ الْعَكِّيِّ ،  عَنْ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَظَرَ إِلَى رَجُلَيْنِ فِي  أُحُدٍ  يَتَمَثَّلَانِ شِعْرًا فِي  حَمْزَةَ  :  فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  اللَّهُمَّ ارْكُسْهُمَا فِي الْفِتْنَةِ  رَكْسًا  وَادْعُهُمْ إِلَى الْعَذَابِ دَعًّا  .         [10/375]      وَسُلَيْمَانُ بْنُ عَمْرِو بْنِ الْأَحْوَصِ  رَوَى عَنْهُ  يَزِيدُ بْنُ أَبِي زِيَادٍ  وَغَيْرُهُ ،  وَأَبُو هِلَالٍ الْعَكِّيُّ  فَرَجُلٌ غَيْرُ مَعْرُوفٍ .","","Musnad al-Bazzar 4509","","نضلة بن عبيد بن عابد الأسلمي عن أبو هلال العكي عن سليمان بن عمرو الجشمي عن يزيد بن أبي زياد القرشي عن محمد بن فضيل بن غزوان عن عباد بن يعقوب الرواجني عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4516","4510  -  حَدَّثَنَا  أَحْمَدُ بْنُ سِنَانٍ الْوَاسِطِيُّ ، قَالَ :  نَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  نَا  عَبْدُ السَّلَامِ ،  عَنِ  الْأَزْرَقِ بْنِ قَيْسٍ ،  عَنْ  أَبِي بَرْزَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي حَدِيثٍ طَوِيلٍ ذَكَرَهُ  أَنَّهُ تَوَضَّأَ وَمَسَحَ عَلَى الْخُفَّيْنِ  .","","Musnad al-Bazzar 4510","","نضلة بن عبيد بن عابد الأسلمي عن أزرق بن قيس الحارثي عن عبد السلام بن صالح بن كثير الدارمي عن يزيد بن هارون عن أحمد بن سنان القطان عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4517","4511  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ عَثْمَةَ ، قَالَ :  نَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ عَامِرٍ ،  عَنْ  مُحَمَّدٍ مِنْ وَلَدِ أَبِي بَرْزَةَ ،  عَنْ  أَبِي بَرْزَةَ الْأَسْلَمِيِّ  - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ         [10/376]      عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Musnad al-Bazzar 4511","","نضلة بن عبيد بن عابد الأسلمي عن محمد بن أبي برزة عن عبد الله بن عامر الأسلمي عن إبراهيم بن سعد أبو إسحاق الزهري عن محمد بن خالد بن عثمة الهاشمى عن محمد بن معمر بن ربعي البحراني عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4518","4512  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرَةَ الرَّازِيُّ  ، قَالَ :  نَا  السِّنْدِيُّ بْنُ عَبْدَوَيْهِ ، قَالَ :  نَا  جِسْرُ بْنُ جَعْفَرٍ ،  عَنِ  الْأَزْرَقِ بْنِ قَيْسٍ ، قَالَ :  سَمِعْتُ  أَبَا بَرْزَةَ الْأَسْلَمِيَّ - رَضِيَ اللهُ عَنْهُ - يَقُولُ  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ         [10/377]      عَلَيْهِ وَسَلَّمَ - غَزْوَةَ كَذَا وَكَذَا  ، حَتَّى عَدَّ ثَمَانَ غَزَوَاتٍ فَمَا رَأَيْنَا مِنْهُ إِلَّا التَّيْسِيرَ وَالتَّخْفِيفَ  .  قَالَ أَبُو بَكْرٍ :  عَلْقَمَةُ بْنُ مَرْثَدٍ  إِنَّمَا يُحَدِّثُ عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ  ، عَنْ أَبِيهِ .  وَمُحَارِبُ بْنُ دِثَارٍ  إِنَّمَا يُحَدِّثُ عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ  ،  وَمُحَمَّدُ بْنُ جُحَادَةَ  إِنَّمَا يُحَدِّثُ عَنْ  سُلَيْمَانَ بْنِ بُرَيْدَةَ  ،  وَسُلَيْمَانُ الْأَعْمَشُ  إِنَّمَا يُحَدِّثُ عَنِ  ابْنِ بُرَيْدَةَ  . فَذَكَرَ غَيْرُ وَاحِدٍ فِيهِ عَنْ  سُلَيْمَانَ  ، وَبَعْضُهُمْ قَالَ : عَنِ  ابْنِ بُرَيْدَةَ  وَلَمْ يُسَمِّهِ وَهُوَ عِنْدِي  سُلَيْمَانُ  ، وَالْبَاقُونَ مِنْ أَصْحَابِ  ابْنِ بُرَيْدَةَ  إِنَّمَا يُحَدِّثُونَ عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ  إِلَّا رَجُلًا .  آخِرُ السَّادِسِ وَالثَّلَاثِينَ  وَالْحَمْدُ لِلهِ كَثِيرًا كَمَا هُوَ أَهْلُهُ .         [10/378]      كذا في طبعة مكتبة العلوم والحكم ، وقال المحقق : ""كذا بالأصل وهو تحريف صوابه : محمد بن عمار بن الحارث أبو جعفر الرازي"" وقد تقدم عند المصنف ، والله أعلم .","","Musnad al-Bazzar 4512","","نضلة بن عبيد بن عابد الأسلمي عن أزرق بن قيس الحارثي عن جسر بن فرقد القصاب عن سهل بن عبد الرحمن المعروف بالسندي بن عبدويه عن محمد بن عمار الرازي عن البزار","مسند أبي برزة الأسلمي رضي الله عنه"
"4519","[10/379]      مُسْنَدُ  سَمُرَةَ بْنِ جُنْدُبٍ  رَضِيَ اللهُ عَنْهُ         [10/380]             [10/381]      سَمُرَةُ بْنُ جُنْدُبٍ  - رَضِيَ اللهُ عَنْهُ  4513  -  أَخْبَرَنَا  أَبُو الْحَسَنِ مُحَمَّدُ بْنُ أَيُّوبَ بْنِ حَبِيبِ بْنِ يَحْيَى الرَّقِّيُّ الصَّمُوتُ ، قَالَ :  نَا  أَبُو بَكْرٍ أَحْمَدُ بْنُ عَمْرِو بْنِ عَبْدِ الْخَالِقِ الْبَزَّارُ ، قَالَ :  نَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنْ  عَوْفٍ ،  عَنْ  أَبِي رَجَاءٍ الْعُطَارِدِيِّ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ .  وَوَجَدْتُ فِي كِتَابِي  : نَا  عَبْدُ اللهِ بْنُ الْمِصْبَاحِ  ، قَالَ :  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  عَوْفٍ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنْ  سَمُرَةَ ، وَاللَّفْظُ لَفْظُ  ابْنِ أَبِي عَدِيٍّ  ، قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِمَّا يَقُولُ لِأَصْحَابِهِ :  هَلْ رَأَى أَحَدٌ مِنْكُمْ مِنْ رُؤْيَا ؟  ، فَيَقُصُّ عَلَيْهِ مَنْ شَاءَ اللهُ مَنْ يَقُصُّ . قَالَ : وَإِنَّهُ قَالَ لَنَا ذَاتَ غَدَاةٍ : "" إِنَّهُ أَتَانِي آتِيَانِ وَإِنَّهُمَا ابْتَعَثَانِي ، وَإِنَّهُمَا قَالَا لِي : انْطَلِقْ وَإِنِّي انْطَلَقْتُ مَعَهُمَا "" وَقَالَ  الْمُعْتَمِرُ  فِي حَدِيثِهِ : "" أَتَانِي اللَّيْلَةَ آتِيَانِ ، فَقَالَا لِي : انْطَلِقْ وَإِنِّي انْطَلَقْتُ مَعَهُمَا ، فَأَتَيَا عَلَى رَجُلٍ مُضْطَجِعٍ ، وَإِذَا آخَرُ قَائِمٌ عَلَيْهِ بِصَخْرَةٍ ، وَإِذَا هُوَ يَهْوِي بِالصَّخْرَةِ لِرَأْسِهِ ،  فَيَثْلَغُ  بِهَا رَأْسَهُ فَيَذْهَبُ الْحَجَرُ هَكَذَا فَيَتْبَعُ الْحَجَرَ ، فَيَأْخُذُهُ فَمَا يَرْجِعُ إِلَيْهِ حَتَّى يَصِحَّ رَأْسُهُ كَمَا كَانَ ، ثُمَّ يَعُودُ عَلَيْهِ فَيَفْعَلُ بِهِ كَمَا فَعَلَ الْمَرَّةَ الْأُولَى ، قَالَ : قُلْتُ : سُبْحَانَ اللهِ مَا هَذَا ؟ قَالَ : قَالَا لِي : انْطَلِقِ انْطَلِقْ ، قَالَ : فَانْطَلَقْتُ مَعَهُمَا فَأَتَيْنَا عَلَى رَجُلٍ مُسْتَلْقِيًا لِقَفَاهُ وَإِذَا آخَرُ قَائِمٌ عَلَيْهِ  بِكَلُّوبٍ  مِنْ حَدِيدٍ وَإِذْ هُوَ يَأْتِي أَحَدَ شِقَّيْ وَجْهِهِ  فَيُشَرْشِرُ  شِدْقَهُ إِلَى قَفَاهُ  وَمَنْخِرَهُ  إِلَى قَفَاهُ ، وَعَيْنَهُ إِلَى قَفَاهُ ، ثُمَّ يَتَحَوَّلُ إِلَى الْجَانِبِ الْآخَرِ فَيَفْعَلُ بِهِ كَمَا فَعَلَ بِالْجَانِبِ الْأَوَّلِ فَمَا يَفْرُغُ مِنْ ذَلِكَ الْجَانِبِ حَتَّى         [10/382]      يَصِحَّ الْأَوَّلُ كَمَا كَانَ ، ثُمَّ يَعُودُ فَيَفْعَلُ بِهِ كَمَا فَعَلَ الْمَرَّةَ الْأُولَى ، قَالَ : قُلْتُ : يَا سُبْحَانَ اللهِ ! مَا هَذَا ؟ قَالَا : انْطَلِقِ انْطَلِقْ ، فَانْطَلَقْتُ فَأَتَيْنَا عَلَى مِثْلِ بِنَاءِ  التَّنُّورِ  ، قَالَ  عَوْفٌ  : وَأَحْسَبُ أَنَّهُ قَالَ : فِيهِ لَغَطٌ وَأَصْوَاتُ رِجَالٍ وَنِسَاءٍ ، وَإِذَا هُمْ يَأْتِيهِمْ لَهَبٌ أَسْفَلَ مِنْهُمْ ، فَإِذَا أَتَاهُمْ ذَلِكَ اللهَبُ  ضَوْضَوْا ،  قَالَ : قُلْتُ : مَا هَؤُلَاءِ ؟ قَالَا لِي : انْطَلِقِ انْطَلِقْ ، قَالَ : فَانْطَلَقْنَا فَأَتَيْنَا عَلَى نَهَرٍ - حَسِبْتُ أَنَّهُ قَالَ - أَحْمَرَ مِثْلِ الدَّمِ ، وَإِذَا فِي النَّهَرِ رَجُلٌ يَسْبَحُ وَإِذَا عَلَى شَطِّ النَّهَرِ رَجُلٌ قَدْ جَمَعَ عِنْدَهُ حِجَارَةً كَثِيرَةً وَإِذَا ذَلِكَ الرَّجُلُ السَّابِحُ يَسْبَحُ مَا يَسْبَحُ ، ثُمَّ يَأْتِي ذَلِكَ الَّذِي جَمَعَ الْحِجَارَةَ  فَيَفْغَرُ  لَهُ فَاهُ فَيُلْقِمُهُ حَجَرًا ، قَالَ : قُلْتُ : مَا هَذَا ؟ قَالَا لِي : انْطَلِقِ انْطَلِقْ ، قَالَ : فَانْطَلَقْنَا فَأَتَيْنَا عَلَى رَجُلٍ  كَرِيهِ  الْمَرْآةِ ،  وَإِذَا هُوَ عِنْدَ نَارٍ لَهُ  يَحُشُّهَا  وَيَسْعَى حَوْلَهَا ، قَالَ : قُلْتُ لَهُمَا مَا هَذَا ؟ قَالَا لِي : انْطَلِقِ انْطَلِقْ ، فَانْطَلَقْنَا فَأَتَيْنَا عَلَى رَوْضَةٍ مُعْشِبَةٍ فِيهَا مِنْ كُلِّ نَوْرِ الرَّبِيعِ ، وَإِذَا بَيْنَ ظَهْرَانَيِ الرَّوْضَةِ رَجُلٌ قَائِمٌ طَوِيلٌ ، وَإِذَا حَوْلَ الرَّجُلِ مِنْ أَكْثَرِ وِلْدَانٍ رَأَيْتُهُمْ قَطُّ ، وَأَحْسَبُهُ قَالَ : قُلْتُ : لَهُمَا مَا هَذَا أَوْ مَا هَؤُلَاءِ ؟ قَالَ : فَقَالَا لِي : انْطَلِقِ انْطَلِقْ ، فَانْطَلَقْنَا فَأَتَيْنَا إِلَى دَرَجَةٍ عَظِيمَةٍ لَمْ أَرَ دَرَجَةً قَطُّ أَعْظَمَ مِنْهَا وَلَا أَحْسَنَ ، قَالَ : قَالَا لِي : ارْقَ فِيهَا ، قَالَ : فَارْتَقَيْتُ ، فَأَتَيْنَا إِلَى مَدِينَةٍ مَبْنِيَّةٍ بِلَبِنِ ذَهَبٍ وَلَبِنِ فِضَّةٍ ، فَأَتَيْنَا بَابَ الْمَدِينَةِ فَاسْتَفْتَحْنَا فَفُتِحَ لَنَا ، فَدَخَلْنَا فَتَلَقَّانَا فِيهَا رِجَالٌ  شَطْرٌ  مِنْ خَلْقِهِمْ كَأَحْسَنِ مَا أَنْتَ رَاءٍ ،  وَشَطْرٌ  مِنْ خَلْقِهِمْ كَأَقْبَحِ مَا أَنْتَ رَاءٍ ، قَالَ : قَالَا لَهُمُ : اذْهَبُوا فَقَعُوا أَوْ فَقَعُوا فِي ذَلِكَ النَّهَرِ ، فَإِذَا نَهَرٌ مُعْتَرِضٌ يَجْرِي كَأَنَّ مَاءَهُ الْمَحْضُ فِي الْبَيَاضِ فَذَهَبُوا فَوَقَعُوا فِيهِ ،         [10/383]      ثُمَّ رَجَعُوا إِلَيْنَا وَقَدْ ذَهَبَ ذَلِكَ السُّوءُ عَنْهُمْ ، وَصَارُوا فِي أَحْسَنِ صُورَةٍ ، قَالَ : فَقَالَا لِي : هَذِهِ جَنَّةُ عَدْنٍ ، وَهَذَاكَ مَنْزِلُكَ ، قَالَ : فَسَمَا بَصَرِي صُعُدًا ، فَإِذَا  قَصْرٌ  مِثْلُ  الرَّبَابَةِ  الْبَيْضَاءِ ، قَالَ : قَالَا لِي : هَذَا مَنْزِلُكَ ، قَالَ : قُلْتُ : بَارَكَ اللهُ فِيكُمَا ذَرَانِي فَأَدْخُلَهُ ، قَالَ : قَالَا لِي : أَمَّا الْآنَ فَلَا ، وَأَنْتَ دَاخِلُهُ ، قَالَ : قُلْتُ : فَإِنِّي رَأَيْتُ مُنْذُ اللَّيْلَةِ عَجَبًا فَمَا هَذَا الَّذِي رَأَيْتُ ؟ قَالَا لِي : أَمَا إِنَّا سَنُخْبِرُكَ . أَمَّا الرَّجُلُ الْأَوَّلُ الَّذِي أَتَيْتَ عَلَيْهِ  يُثْلَغُ  رَأْسُهُ بِالْحَجَرِ ، فَإِنَّهُ رَجُلٌ يَأْخُذُ الْقُرْآنَ فَيَرْفُضُهُ ، وَيَنَامُ عَنِ الصَّلَاةِ الْمَكْتُوبَةِ ، وَأَمَّا الرَّجُلُ الَّذِي أَتَيْتَ عَلَيْهِ  يُشَرْشَرُ  شِدْقُهُ إِلَى قَفَاهُ وَعَيْنُهُ إِلَى قَفَاهُ  وَمَنْخِرُهُ  إِلَى قَفَاهُ فَالرَّجُلُ الَّذِي يَغْدُوا مِنْ بَيْتِهِ فَيَكْذِبُ الْكَذِبَةَ تَبْلُغُ الْآفَاقَ ، وَأَمَّا الرِّجَالُ وَالنِّسَاءُ الْعُرَاةُ الَّذِي فِي مِثْلِ بِنَاءِ  التَّنُّورِ  فَإِنَّهُمُ الزُّنَاةُ وَالزَّوَانِي ، وَأَمَّا الرَّجُلُ الَّذِي يَسْبَحُ فِي النَّهَرِ وَيُلْقَمُ الْحِجَارَةَ فَإِنَّهُ  آكِلُ  الرِّبَا ، وَأَمَّا الرَّجُلُ  الْكَرِيهُ  الْمَرْآةِ  الَّذِي عِنْدَ النَّارِ فَإِنَّهُ خَازِنُ  جَهَنَّمَ ،  وَأَمَّا الرَّجُلُ الطَّوِيلُ الَّذِي فِي الرَّوْضَةِ فَإِنَّهُ  إِبْرَاهِيمُ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَمَّا الْوِلْدَانُ الَّذِينَ حَوْلَهُ فَكُلُّ مَوْلُودٍ مَاتَ عَلَى الْفِطْرَةِ ، وَأَمَّا  الْقَوْمُ  الَّذِينَ  شَطْرٌ  مِنْهُمْ حَسَنٌ ،  وَشَطْرٌ  مِنْهُمْ قَبِيحٌ فَهُمْ قَوْمٌ خَلَطُوا عَمَلًا صَالِحًا وَآخَرَ سَيِّئًا فَتَجَاوَزَ اللهُ عَنْهُمْ تَبَارَكَ وَتَعَالَى  .  كذا في طبعة مكتبة العلوم والحكم ، ولعل الصواب: ( ابن الصباح ) ، والله أعلم .","","Musnad al-Bazzar 4513","","سمرة بن جندب عن أبو رجاء العطاردي عن عوف بن أبي جميلة عن معتمر بن سليمان عن عبد الله بن الصباح المربدي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4520","4514  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  الْحَجَّاجُ بْنُ الْمِنْهَالِ ،         [10/384]      قَالَ :  نَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا صَلَّى صَلَاةَ الصُّبْحِ اسْتَقْبَلَنَا بِوَجْهِهِ ، ثُمَّ قَالَ :  هَلْ رَأَى مِنْكُمْ أَحَدٌ رُؤْيَا  .","","Musnad al-Bazzar 4514","","سمرة بن جندب عن أبو رجاء العطاردي عن جرير بن حازم عن حجاج بن المنهال الأنماطي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4521","4515  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ :  نَا  رَيْحَانُ بْنُ سَعِيدٍ ، قَالَ :  نَا  عَبَّادُ بْنُ مَنْصُورٍ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  كُلُّ مَوْلُودٍ يُولَدُ عَلَى  الْفِطْرَةِ  فَأَبَوَاهُ يُهَوِّدَانِهِ وَيُنَصِّرَانِهِ  .","","Musnad al-Bazzar 4515","","سمرة بن جندب عن أبو رجاء العطاردي عن عباد بن منصور الناجي عن ريحان بن سعيد الناجي عن إبراهيم بن سعيد الجوهري عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4522","4516  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  عِيسَى بْنُ شُعَيْبٍ ، قَالَ :  نَا         [10/385]      عَبَّادُ بْنُ مَنْصُورٍ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُئِلَ عَنْ أَطْفَالِ الْمُشْرِكِينَ ، فَقَالَ :  هُمْ خَدَمُ أَهْلِ الْجَنَّةِ  .  وَهَذَا الْحَدِيثُ الَّذِي رَوَاهُ  عَوْفٌ ،  وَرَوَاهُ جَمَاعَةٌ مَعَ  عَوْفٍ ،  مِنْهُمْ  حَمَّادُ بْنُ مَنْصُورٍ  ، وَزَادَ فِيهِ عَلَى  عَوْفٍ  سُئِلَ عَنْ أَطْفَالِ الْمُشْرِكِينَ ، فَقَالَ : هُمْ خَدَمُ أَهْلِ الْجَنَّةِ ، وَقَالَ :  كُلُّ مَوْلُودٍ يُولَدُ عَلَى  الْفِطْرَةِ  . وَرَوَاهُ  أَبُو خَلْدَةَ  أَيْضًا عَنْ  أَبِي رَجَاءٍ  عَنْ  سَمُرَةَ  ، وَرَوَاهُ  جَرِيرُ بْنُ حَازِمٍ ،  فَزَادَ فِيهِ : فَاسْتَقْبَلَنَا بِوَجْهِهِ . وَلَمْ يَكُنْ عِنْدَ  جَرِيرٍ  بِطُولِ حَدِيثِ  عَوْفٍ  وَلَا  عَبَّادٍ ،  هَؤُلَاءِ أَطْوَلُ لَهُ حَدِيثًا ، وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  سَمُرَةُ  ، وَلَا رَوَاهُ عَنْهُ إِلَّا  أَبُو رَجَاءٍ الْعُطَارِدِيُّ  .","","Musnad al-Bazzar 4516","","سمرة بن جندب عن أبو رجاء العطاردي عن عباد بن منصور الناجي عن عيسى بن شعيب بن إبراهيم النحوي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4523","4517  -  وَحَدَّثَنَا  جَمِيلُ بْنُ الْحَسَنِ ، قَالَ :  نَا  مَحْبُوبُ بْنُ الْحَسَنِ ، قَالَ :  نَا  عَوْفٌ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4517","","سمرة بن جندب عن أبو رجاء العطاردي عن عوف بن أبي جميلة عن محمد بن الحسن بن هلال محبوب عن جميل بن الحسن الجهضمي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4524","[10/386]      4518  -  وَحَدَّثَنَاهُ  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الرَّقَاشِيُّ ، قَالَ :  نَا  جَعْفَرُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  عَوْفٌ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّمَا الْمَرْأَةُ خُلِقَتْ مِنْ ضِلْعٍ  ، إِنْ تَحْرِصْ عَلَى إِقَامَتِهَا تَكْسِرْهَا ، وَإِنْ تَسْتَمْتِعْ بِهَا تَسْتَمْتِعْ بِهَا وَفِيهَا عِوَجٌ  .  قَالَ أَبُو بَكْرٍ :  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ عَنْ  عَوْفٍ  جَمَاعَةٌ عَنْ  أَبِي رَجَاءٍ  ، وَقَالَ بَعْضُهُمْ : عَنْ رَجُلٍ ، وَهُوَ  شُعْبَةُ  ، وَرَوَاهُ  شُعْبَةُ  وَالثَّوْرِيُّ  عَنْ  عَوْفٍ  عَنْ رَجُلٍ عَنْ  سَمُرَةَ  .","","Musnad al-Bazzar 4518","","سمرة بن جندب عن أبو رجاء العطاردي عن عوف بن أبي جميلة عن جعفر بن سليمان الضبعي عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4525","4519  -  سَمِعْتُ  عَمْرَو بْنَ عَلِيٍّ  يُحَدِّثُ ، عَنْ  يَحْيَى بْنِ سَعِيدٍ الْقَطَّانِ ، قَالَ :  سَمِعْتُ  سُفْيَانَ  يُحَدِّثُ ، عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ،  عَنْ  مَيْمُونِ بْنِ أَبِي شَبِيبٍ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  عَلَيْكُمْ مِنَ الثِّيَابِ بِالْبَيَاضِ  فَلْيَلْبَسْهَا أَحْيَاؤُكُمْ وَكَفِّنُوا         [10/387]      فِيهَا مَوْتَاكُمْ  .","","Musnad al-Bazzar 4519","","سمرة بن جندب عن ميمون بن أبي شبيب عن حبيب بن أبي ثابت الكاهلي عن سفيان الثوري عن يحيى القطان عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4526","4520  -  وَسَمِعْتُ  عَمْرَو بْنَ عَلِيٍّ يَقُولُ : قَالَ :  سَمِعْتُ  يَحْيَى بْنَ سَعِيدٍ يَذْكُرُهُ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَبِي الْمُهَلَّبِ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  مِنْ خَيْرِ ثِيَابِكُمُ الْبَيَاضُ  ، فَلْيَلْبَسْهَا أَحْيَاؤُكُمْ وَكَفِّنُوا فِيهَا مَوْتَاكُمْ  . قَالَ  عَمْرُو بْنُ عَلِيٍّ  : فَلَمْ أَكْتُبْ عَنْ  يَحْيَى         [10/388]      حَدِيثَ  سَعِيدٍ ،  وَحَفِظْتُهُ عَنْهُ  .","","Musnad al-Bazzar 4520","","سمرة بن جندب عن أبو المهلب الجرمي عن أبو قلابة الجرمي عن أيوب السختياني عن سعيد بن أبي عروبة عن يحيى القطان عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4527","4521  -  قَالَ :  وَحَدَّثَنَاهُ  نَصْرُ بْنُ عَلِيٍّ ، قَالَ :  أَنَا  أَبِي  ،  عَنِ  الْمَسْعُودِيِّ ،  عَنْ  حَبِيبِ بْنِ أَبِي ثَابِتٍ ، وَالْحَكَمِ بْنِ عُتَيْبَةَ ،  عَنْ  مَيْمُونِ بْنِ أَبِي شَيْبَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  عَلَيْكُمْ مِنَ الثِّيَابِ بِالْبَيَاضِ  ، فَلْيَلْبَسْهَا أَحْيَاؤُكُمْ وَكَفِّنُوا فِيهَا مَوْتَاكُمْ  .         [10/389]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ حَدِيثِ  مَيْمُونِ بْنِ أَبِي شَبِيبٍ  وَأَبِي الْمُهَلَّبِ  ، وَلَا نَعْلَمُ أَحَدًا قَالَ : عَنْ  أَيُّوبَ  ، عَنْ  أَبِي قِلَابَةَ  ، عَنْ  أَبِي الْمُهَلَّبِ  ، عَنْ  سَمُرَةَ  إِلَّا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ  ، وَغَيْرُ  سَعِيدٍ  يَرْوِيهِ عَنْ  أَيُّوبَ  ، عَنْ  أَبِي قِلَابَةَ  ، عَنْ  سَمُرَةَ  ، وَلَا نَعْلَمُ أَحَدًا رَوَاهُ عَنِ  الْحَكَمِ  إِلَّا  الْمَسْعُودِيُّ  .  كذا في طبعة مكتبة العلوم والحكم ، ولعل الصواب: (ميمون بن أبي شبيب) .","","Musnad al-Bazzar 4521","","سمرة بن جندب عن ميمون بن أبي شبيب عن الحكم بن عتيبة الكندي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن علي بن نصر الجهضمي الكبير عن نصر بن علي بن نصر الجهضمي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4528","4522  -  حَدَّثَنَا  الْفُضَيْلُ بْنُ الْحُسَيْنِ ، وَعَمْرُو بْنُ عَلِيٍّ ، قَالَا :  نَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  حُسَيْنٍ الْمُعَلِّمِ ،  عَنِ  ابْنِ بُرَيْدَةَ - يَعْنِي - عَبْدَ اللهِ بْنَ بُرَيْدَةَ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى عَلَى  امْرَأَةٍ  مَاتَتْ فِي  نِفَاسِهَا  ، فَقَامَ فَصَلَّى عَلَيْهَا ، وَصَلَّى مِنْهَا وَسَطًا  .         [10/390]","","Musnad al-Bazzar 4522","","سمرة بن جندب عن عبد الله بن بريدة عن حسين المعلم عن يزيد بن زريع العيشي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4529","4523  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ عُثْمَانَ الثَّقَفِيُّ وَهُوَ ابْنُ أَبِي صَفْوَانَ ، قَالَ :  نَا  أَبُو قُتَيْبَةَ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  حُسَيْنٍ الْمُعَلِّمِ ،  عَنِ  ابْنِ بُرَيْدَةَ ،  عَنْ  سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ إِلَّا  سَمُرَةُ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  شُعْبَةَ  إِلَّا  أَبُو قُتَيْبَةَ  .","","Musnad al-Bazzar 4523","","سمرة بن جندب عن عبد الله بن بريدة عن حسين المعلم عن شعبة بن الحجاج عن سلم بن قتيبة الشعيري عن محمد بن عثمان بن أبي صفوان الثقفي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4530","4524  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  زَيْدِ بْنِ عُقْبَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4524","","سمرة بن جندب عن زيد بن عقبة الفزاري عن عبد الملك بن عمير القبطي عن شعبة بن الحجاج عن يحيى القطان عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4531","4525  -  وَحَدَّثَنَاهُ  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،         [10/391]      عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  زَيْدِ بْنِ عُقْبَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4525","","سمرة بن جندب عن زيد بن عقبة الفزاري عن عبد الملك بن عمير القبطي عن سفيان الثوري عن عبد الرحمن بن مهدي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4532","4526  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ :  نَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  زَيْدِ بْنِ عُقْبَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4526","","سمرة بن جندب عن زيد بن عقبة الفزاري عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4533","4527  -  وَحَدَّثَنَاهُ  أَحْمَدُ بْنُ الْمِقْدَامِ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عُلَيَّةَ ،  عَنْ  دَاوُدَ الطَّائِيِّ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  زَيْدِ بْنِ عُقْبَةَ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ هَذِهِ  الْمَسَائِلَ  كُدُوحًا  فِي وَجْهِ الرَّجُلِ  ، فَمَنْ شَاءَ أَبْقَى عَلَى وَجْهِهِ إِلَّا أَنْ يَأْتِيَ ذَا سُلْطَانٍ ، أَوْ أَمْرٍ لَا يَجِدُ مِنْهُ بُدًّا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  سَمُرَةُ  .","","Musnad al-Bazzar 4527","","سمرة بن جندب عن زيد بن عقبة الفزاري عن عبد الملك بن عمير القبطي عن داود بن نصير الطائي عن إسماعيل ابن علية عن أحمد بن المقدام العجلي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4534","[10/392]      4528  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنِ  الْمَسْعُودِيِّ ،  عَنْ  مَعْبَدِ بْنِ خَالِدٍ ،  عَنْ  زَيْدِ بْنِ عُقْبَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4528","","سمرة بن جندب عن زيد بن عقبة الفزاري عن معبد بن خالد بن مزين الجدلي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن محمد بن إبراهيم بن أبي عدي القسملي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4535","4529  -  وَحَدَّثَنَاهُ  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  أَنَا  الْحَجَّاجُ بْنُ أَرْطَاةَ ،  عَنْ  مَعْبَدٍ ،  عَنْ  زَيْدِ بْنِ عُقْبَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  كَانَ يَقْرَأُ فِي الْعِيدَيْنِ بِـ         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      وَ         {      هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ         }      .","","Musnad al-Bazzar 4529","","سمرة بن جندب عن زيد بن عقبة الفزاري عن معبد بن خالد بن مزين الجدلي عن حجاج بن أرطاة عن يزيد بن هارون عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4536","[10/393]      4530  -  حَدَّثَنَا  أَبُو كَامِلٍ وَمُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ، قَالَا :  نَا  أَبُو عَوَانَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  حُصَيْنِ بْنِ أَبِي الْحُرِّ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ -  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَأَلَهُ رَجُلٌ كَيْفَ تَرَى الضَّبَّ ؟ قَالَ :  أُمَّةٌ  مُسِخَتْ  ، فَاللهُ أَعْلَمُ  .  قَالَ : وَدَخَلَ  عُيَيْنَةُ بْنُ بَدْرٍ  فَرَأَى  حَجَّامًا  يَحْجِمُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِقَرْنٍ  ، فَقَالَ : تُمَكِّنُ هَذَا مِنْ لَحْمِكَ ، فَقَالَ : "" هَذَا الْحَجْمُ هُوَ خَيْرٌ مَا تَدَاوَيْتُمْ بِهِ  .","","Musnad al-Bazzar 4530","","سمرة بن جندب عن حصين بن أبي الحر العنبري عن عبد الملك بن عمير القبطي عن الوضاح بن عبد الله اليشكري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4537","4531  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  أَبِي قَزَعَةَ - وَهُوَ سُوَيْدُ بْنُ حُجَيْرٍ - ،  عَنِ  الْأَسْقَعِ بْنِ         [10/394]      الْأَسْلَعِ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4531","","سمرة بن جندب عن الأسقع بن الأسلع البصري عن سويد بن حجير الباهلي عن داود بن أبي هند عن يزيد بن زريع العيشي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4538","4532  -  وَحَدَّثَنَاهُ  أَحْمَدُ بْنُ مَالِكٍ الْقُشَيْرِيُّ ، قَالَ :  نَا  قَزَعَةُ بْنُ سُوَيْدِ بْنِ حُجَيْرٍ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنْ  سُوَيْدِ بْنِ حُجَيْرٍ - وَهُوَ : أَبُو قَزَعَةَ - ،  عَنِ  الْأَسْقَعِ بْنِ الْأَسْلَعِ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَا تَحْتَ  الْكَعْبَيْنِ  مِنَ  الْإِزَارِ  فِي النَّارِ  .  وَقَالَ  قَزَعَةُ  :  مَا فَوْقَ الْكَعْبِ مِنَ الثَّوْبِ فِي النَّارِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4532","","سمرة بن جندب عن الأسقع بن الأسلع البصري عن سويد بن حجير الباهلي عن داود بن أبي هند عن قزعة بن سويد بن حجير الباهلي عن أحمد بن مالك القشيري عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4539","4533  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ قَالَ :  سَمِعْتُ  الْمُهَلَّبَ بْنَ أَبِي صُفْرَةَ  يُحَدِّثُ عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الصَّلَاةِ بَعْدَ الْعَصْرِ حَتَّى تَغْرُبَ الشَّمْسُ  ، وَبَعْدَ الصُّبْحِ حَتَّى تَطْلُعَ الشَّمْسُ ، فَإِنَّهَا تَطْلُعُ بَيْنَ  قَرْنَيْ  شَيْطَانٍ  .         [10/395]      وَلَا نَعْلَمُ  أَسْنَدَ  الْمُهَلَّبُ بْنُ أَبِي صُفْرَةَ  عَنْ  سَمُرَةَ  غَيْرَ هَذَا الْحَدِيثِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  سِمَاكٍ  إِلَّا  شُعْبَةُ  .","","Musnad al-Bazzar 4533","","سمرة بن جندب عن المهلب بن أبي صفرة عن سماك بن حرب البكري عن شعبة بن الحجاج عن أبو داود الطيالسي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4540","4534  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  مَنْصُورٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنِ  الرَّبِيعِ بْنِ عَمِيلَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا تُسَمِّيَنَّ غُلَامَكَ أَفْلَحَ وَلَا نَجِيحً  وَلَا يَسَارً وَلَا رَبَاحً ، فَإِنَّكَ إِذَا قُلْتَ ، أَثَمَّ هُوَ أَثَمَّ فُلَانٌ قَالُوا لَا  .         [10/396]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  سَمُرَةَ  بِهَذَا  الْإِسْنَادِ  ،  وَالرَّبِيعُ بْنُ عَمِيلَةَ مَشْهُورٌ مِنْ أَهْلِ الْكُوفَةِ وَهُوَ أَبُو الرُّكَيْنِ بْنُ الرَّبِيعِ  .","","Musnad al-Bazzar 4534","","سمرة بن جندب عن الربيع بن عميلة الفزاري عن هلال بن يساف الأشجعي عن منصور بن المعتمر عن شعبة بن الحجاج عن غندر ربيب شعبة عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4541","4535  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ ،  عَنْ  سُفْيَانَ ،  عَنْ  سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  هِلَالِ بْنِ يَسَافٍ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  أَرْبَعٌ أَفْضَلُ الْكَلَامِ ، لَا يَضُرُّكَ بِأَيِّهِنَّ بَدَأْتَ  : سُبْحَانَ اللهِ ، وَالْحَمْدُ لِلهِ ، وَلَا إِلَهَ إِلَّا اللهُ ، وَاللهُ أَكْبَرُ  .","","Musnad al-Bazzar 4535","","سمرة بن جندب عن هلال بن يساف الأشجعي عن سلمة بن كهيل الحضرمي عن سفيان الثوري عن عبد الرحمن بن مهدي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4542","4536  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ أَوْ أَبُو مُعَاوِيَةَ ،  قَالَ :  نَا  شُعْبَةُ  عَنِ  الْحَكَمِ ،  عَنْ  عَبْدَ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ حَدَّثَ عَنِّي حَدِيثًا وَهُوَ يَرَى أَنَّهُ كَذِبٌ  فَهُوَ أَحَدُ الْكَاذِبِينَ  .         [10/397]             [10/398]      وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  ، عَنِ  الْحَكَمِ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى  ، عَنْ  عَلِيٍّ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَشُعْبَةُ  أَحْفَظُ مِنْ  مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ  ، وَلَا نَعْلَمُ رَوَى  عَبْدُ الرَّحْمَنِ بْنُ أَبِي لَيْلَى  عَنْ  سَمُرَةَ  إِلَّا هَذَا الْحَدِيثَ .","","Musnad al-Bazzar 4536","","سمرة بن جندب عن عبد الرحمن بن أبي ليلى عن الحكم بن عتيبة الكندي عن شعبة بن الحجاج عن أبو معاوية الضرير عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4543","4537  -  حَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ، وَعَمْرُو بْنُ عَلِيٍّ ، قَالَا :  نَا  عَفَّانُ بْنُ مُسْلِمٍ ، قَالَ :  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يُونُسَ يَعْنِي ابْنَ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  يُوشِكُ  أَنْ يَمْلَأَ اللهُ أَيْدِيَكُمْ مِنَ الْعَجَمِ  ، ثُمَّ يَجْعَلَهُمْ أُسْدًا لَا يَفِرُّونَ فَيُقَاتِلُونَ مُقَاتِلَتَكُمْ وَيَأْكُلُونَ فَيْئَكُمْ  .         [10/399]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  يُونُسَ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  .","","Musnad al-Bazzar 4537","","سمرة بن جندب عن الحسن البصري عن يونس بن عبيد عن حماد بن سلمة عن عفان بن مسلم الصفار عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4544","4538  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ بْنِ عَلِيٍّ الْمَقْدِسِيُّ ، وَالْجَرَّاحُ بْنُ مَخْلَدٍ ، قَالَا :  نَا  خَالِدُ بْنُ يَحْيَى - يَعْنِي - ابْنَ أَبِي قُرَّةَ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ ""  جَارُ الدَّارِ أَحَقُّ بِالدَّارِ  .","","Musnad al-Bazzar 4538","","سمرة بن جندب عن الحسن البصري عن يونس بن عبيد عن خالد بن يحيى السدوسي عن محمد بن عمر بن علي بن عطاء المقدمي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4545","4539  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  أَبُو الْوَلِيدِ ،  قَالَ  : شُعْبَةُ ،         [10/400]      عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  جَارُ الدَّارِ أَحَقُّ بِالدَّارِ أَوْ بِالْأَرْضِ  .         [10/401]      وَالْحَسَنُ  يُقَالُ : إِنَّهُ لَمْ يَسْمَعْ مِنْ  سَمُرَةَ  إِلَّا حَدِيثًا وَاحِدًا ، وَإِنَّمَا كَانَ تَرَكَهُ لِأَنَّهُ رَغِبَ عَنْهُ ، ثُمَّ إِنَّهُ بَعْدُ تَبَيَّنَ لَهُ صِدْقُهُ ، فَصَارَ إِلَى مَنْزِلِهِ بَعْدُ ، فَأَخَذَ هَذِهِ الصَّحِيفَةَ فَرَوَاهَا عَنْهُ ، وَالَّذِي يَصِحُّ أَنَّهُ سَمِعَهُ مِنْ  سَمُرَةَ  حَدِيثًا حَدَّثَنَاهُ  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ حَبِيبٍ  ، عَنْ  قُرَيْشِ بْنِ أَنَسٍ  ، عَنْ  حَبِيبِ بْنِ الشَّهِيدِ  ، قَالَ : قَالَ لِي  مُحَمَّدُ بْنُ سِيرِينَ  : سَلِ  الْحَسَنَ  مِمَّنْ سَمِعَ الْحَدِيثَ فِي  الْعَقِيقَةِ  ؟ فَسَأَلْتُهُ ، فَقَالَ : مِنْ  سَمُرَةَ  .","","Musnad al-Bazzar 4539","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4546","4540  -  حَدَّثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ ، قَالَ :  نَا  خَالِدُ بْنُ يَحْيَى ، قَالَ :  نَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4540","","سمرة بن جندب عن الحسن البصري عن يونس بن عبيد عن خالد بن يحيى السدوسي عن الجراح بن مخلد عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4547","4541  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ :  نَا  سَعِيدُ بْنُ سُفْيَانَ الْجَحْدَرِيُّ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ         [10/402]      عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  مَنْ تَوَضَّأَ يَوْمَ الْجُمُعَةِ فَبِهَا  وَنِعْمَتْ  ،  وَمَنِ اغْتَسَلَ فَالْغُسْلُ أَفْضَلُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  يُونُسَ  عَنِ  الْحَسَنِ  عَنْ  سَمُرَةَ  إِلَّا         [10/403]      خَالِدُ بْنُ يَحْيَى  .","","Musnad al-Bazzar 4541","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن شعبة بن الحجاج عن سعيد بن سفيان الجحدري عن محمد بن بشار بندار عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4548","4542  -  حَدَّثَنَا  الْفُضَيْلُ بْنُ الْحُسَيْنِ ، قَالَ :  نَا  يَزِيدُ بْنُ زُرَيْعٍ ،  عَنْ  يُونُسَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  كَانَتْ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَكْتَتَانِ :  سَكْتَةٌ إِذَا ابْتَدَأَ الصَّلَاةَ ، وَسَكْتَةٌ إِذَا فَرَغَ مِنْ قِرَاءَتِهِ  .  وَرَوَى هَذَا الْحَدِيثَ  سَعِيدُ بْنُ أَبِي عَرُوبَةَ  ، عَنْ  قَتَادَةَ  ، عَنِ  الْحَسَنِ  ، عَنْ  سَمُرَةَ  فَأَنْكَرَ ذَلِكَ عَلَيْهِ  عِمْرَانُ  ، قَالَ : فَكَتَبَ إِلَى  أُبَيِّ بْنِ كَعْبٍ  ، فَكَتَبَ         [10/404]      بِصِدْقِ  سَمُرَةَ  .","","Musnad al-Bazzar 4542","","سمرة بن جندب عن الحسن البصري عن يونس بن عبيد عن يزيد بن زريع العيشي عن فضيل بن حسين الجحدري عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4549","4543  -  حَدَّثَنَا  الْحَسَنُ بْنُ قَزَعَةَ ، قَالَ :  نَا  سَلَّامُ بْنُ أَبِي خُبْزَةَ ، قَالَ :  نَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نُصَلِّيَ مِنَ اللَّيْلِ مَا قَلَّ أَوْ كَثُرَ  ، وَنَجْعَلَ آخِرَ ذَلِكَ  وِتْرًا  .","","Musnad al-Bazzar 4543","","سمرة بن جندب عن الحسن البصري عن يونس بن عبيد عن سلام بن أبي خبزة البصري عن الحسن بن قزعة الخلقاني عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4550","4544  -  وَحَدَّثَنَاهُ  خَالِدُ بْنُ يُوسُفَ ، قَالَ :  نَا  أَبِي  ، قَالَ :  نَا  جَعْفَرُ بْنُ سَعْدٍ ،  عَنْ  حَبِيبِ بْنِ سُلَيْمَانَ بْنِ سَمُرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ سَمُرَةَ         [10/405]      بْنِ جُنْدُبٍ  - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُ أَنْ يُصَلِّيَ أَحَدُنَا كُلَّ لَيْلَةٍ بَعْدَ الصَّلَاةِ الْمَكْتُوبَةِ مَا قَلَّ أَوْ كَثُرَ ،  وَنَجْعَلَ  أَحْسَبُهُ - قَالَ : آخِرَ ذَلِكَ  -  وِتْرًا  .  وَجَعْفَرُ بْنُ سَعْدٍ  مِنْ وَلَدِ  سَمُرَةَ  ، وَحَدِيثُ  يُونُسَ  عَنِ  الْحَسَنِ  لَا نَعْلَمُ رَوَاهُ عَنْ  يُونُسَ  إِلَّا  سَلَّامُ بْنُ أَبِي خُبْزَةَ  كَانَ رَجُلًا مِنْ  أَهْلِ الْبَصْرَةِ  فِيهِ ضَعْفٌ  فِي الْقَدْرِ .","","Musnad al-Bazzar 4544","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4551","4545  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ :  نَا  تَمِيمُ بْنُ زِيَادٍ ، قَالَ :  نَا  أَبُو جَعْفَرٍ الرَّازِيُّ ،  عَنْ  يُونُسَ بْنِ عُبَيْدٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4545","","سمرة بن جندب عن الحسن البصري عن يونس بن عبيد عن عيسى بن أبي عيسى الرازي عن تميم بن زياد الرازي عن يوسف بن موسى بن راشد عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4552","4546  -  وَحَدَّثَنَاهُ  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  هِشَامٌ         [10/406]      - يَعْنِي - ابْنَ أَبِي عَبْدِ اللهِ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ  قَتَلَ  عَبْدَهُ قَتَلْنَاهُ  ، وَمَنْ  جَدَعَ  عَبْدَهُ  جَدَعْنَاهُ  .  زَادَ  هِشَامٌ  فِي حَدِيثِهِ ، عَنْ  قَتَادَةَ  ، عَنِ  الْحَسَنِ  ، عَنْ  سَمُرَةَ  مِمَّا لَيْسَ فِي حَدِيثِ  يُونُسَ  وَلَا فِي حَدِيثِ أَحَدٍ مِمَّنْ يَرْوِيهِ عَنْ  قَتَادَةَ  : ""  وَمَنْ أَخْصَى عَبْدَهُ أَخْصَيْنَاهُ  "" ، وَحَدِيثُ  يُونُسَ  عَنِ  الْحَسَنِ  عَنْ  سَمُرَةَ  لَا نَعْلَمُ رَوَاهُ إِلَّا  أَبُو جَعْفَرٍ الرَّازِيُّ  عَنْهُ .","","Musnad al-Bazzar 4546","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن أبو داود الطيالسي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4553","4547  -  وَحَدَّثَنَاهُ  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  عَبْدُ الْأَعْلَى ، قَالَ :  نَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ  قَتَلَ  عَبْدَهُ قَتَلْنَاهُ ،  وَمَنْ  جَدَعَ  عَبْدَهُ  جَدَعْنَاهُ  .         [10/407]      وَكَانَ  الْحَسَنُ  يُحَدِّثُ بِهَذَا عَنْ  سَمُرَةَ  ، قَالَ  قَتَادَةُ  ، ثُمَّ نَسِيَ  الْحَسَنُ  بَعْدُ فَكَانَ يُفْتِي أَنَّهُ لَا يُقْتَلُ السَّيِّدُ بِالْعَبْدِ  .","","Musnad al-Bazzar 4547","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4554","4548  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ :  نَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  عَلَى الْيَدِ مَا أَخَذَتْ حَتَّى تُؤَدِّيَهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  سَمُرَةُ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ         [10/408]      وَسَلَّمَ - .","","Musnad al-Bazzar 4548","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4555","4549  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ :  نَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  كُلُّ غُلَامٍ  رَهِينٌ  أَوْ مُرْتَهَنٌ  بِعَقِيقَتِهِ  ، تُذْبَحُ عَنْهُ يَوْمَ سَابِعِهِ ،  وَيُسَمَّى ، وَيُحْلَقُ رَأْسُهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ بِهَذَا اللَّفْظِ إِلَّا  سَمُرَةُ  .","","Musnad al-Bazzar 4549","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4556","4550  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  يَزِيدُ بْنُ زُرَيْعٍ ، قَالَ :  نَا  سَعِيدٌ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  سَامٌ  أَبُو الْعَرَبِ ،  وَحَامٌ  أَبُو  الْحَبَشِ  ،  وَيَافِثُ  أَبُو  الرُّومِ  .         [10/409]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  سَمُرَةُ  وَأَبُو هُرَيْرَةَ  ، وَلَفْظُ حَدِيثِ  سَمُرَةَ  مُخَالِفٌ لِلَفْظِ  أَبِي هُرَيْرَةَ  .","","Musnad al-Bazzar 4550","","سمرة بن جندب عن الحسن البصري عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4557","4551  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَرْزُوقِ بْنِ بُكَيْرٍ ، قَالَ :  نَا  عَبْدُ الْأَعْلَى ، قَالَ :  نَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا أَتَى أَحَدُكُمْ عَلَى مَاشِيَةٍ ، فَإِنْ كَانَ صَاحِبُهَا فَلْيُنَادِهِ ،  فَإِنْ أَذِنَ لَهُ فَلْيَحْلِبْ وَلْيَشْرَبْ ، وَإِنْ لَمْ يَكُنْ فِيهَا أَحَدٌ فَلْيُنَادِ ثَلَاثًا فَإِنْ أَجَابَهُ وَإِلَّا فَلْيَحْلِبْ وَلْيَشْرَبْ وَلَا يَحْمِلْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4551","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن محمد بن محمد بن مرزوق الباهلي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4558","4552  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ أَحَاطَ حَائِطًا عَلَى أَرْضٍ فَهِيَ لَهُ  .         [10/410]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  سَمُرَةُ  .  وَمَعْنَاهُ عِنْدَنَا : أَنَّهُ مَنْ أَحَاطَ عَلَى أَرْضٍ حَائِطًا فَهِيَ لَهُ إِذَا كَانَتِ الْأَرْضُ لَمْ يَمْلِكْهَا أَحَدٌ فَصَارَتْ لَهُ لِأَنَّهُ سَبَقَ إِلَيْهَا  .","","Musnad al-Bazzar 4552","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4559","4553  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  ابْنُ أَبِي عَدِيٍّ ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنِ  سَمُرَةَ أَوْ عُقْبَةَ بْنِ عَامِرٍ  - رَضِيَ اللهُ عَنْهُمَا - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  أَيُّمَا امْرَأَةٍ أَنْكَحَهَا وَلِيَّانِ فَهِيَ لِلْأَوَّلِ مِنْهُمَا  ، وَأَيُّمَا رَجُلٍ بَاعَ بَيْعًا مِنْ رَجُلَيْنِ فَهُوَ لِلْأَوَّلِ مِنْهُمَا  .","","Musnad al-Bazzar 4553","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4560","[10/411]      4554  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  عَبْدُ الْأَعْلَى ، قَالَ :  نَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  صَلَاةُ الْوُسْطَى صَلَاةُ الْعَصْرِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ  .","","Musnad al-Bazzar 4554","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4561","4555  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  خَالِدُ بْنُ الْحَارِثِ ، وَعَبْدُ الْأَعْلَى ، قَالَا :  نَا  سَعِيدٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .         [10/412]","","Musnad al-Bazzar 4555","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4562","4556  -  وَحَدَّثَنَاهُ  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ، قَالَ :  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ بَيْعِ الْحَيَوَانِ بِالْحَيَوَانِ  نَسِيئَةً  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى ، عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4556","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن حماد بن سلمة عن عبد الواحد بن غياث عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4563","[10/413]      4557  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْبَيِّعَانِ  بِالْخِيَارِ  مَا لَمْ  يَفْتَرِقَا  .","","Musnad al-Bazzar 4557","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن شعبة بن الحجاج عن أبو داود الطيالسي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4564","4558  -  وَحَدَّثَنَاهُ  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَهَذَا الْحَدِيثُ رَوَاهُ عَنْ  قَتَادَةَ  جَمَاعَةٌ مِنْهُمْ  هِشَامُ بْنُ أَبِي عَبْدِ اللهِ  وَأَبُو عَوَانَةَ  وَغَيْرُهُمْ .","","Musnad al-Bazzar 4558","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن حماد بن سلمة عن عبد الواحد بن غياث عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4565","4559  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  مُعَاذُ بْنُ هِشَامٍ ، قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .         [10/414]","","Musnad al-Bazzar 4559","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4566","4560  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  عَنْ  هِشَامٍ - يَعْنِي - ابْنَ أَبِي عَبْدِ اللهِ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا تَلَاعَنُوا بِلَعْنَةِ اللهِ  وَلَا بِغَضَبِهِ وَلَا بِالنَّارِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  إِلَّا  هِشَامٌ  .","","Musnad al-Bazzar 4560","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن عبد الرحمن بن مهدي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4567","4561  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُعَاذُ بْنُ هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  أَصَابَنَا مَطَرٌ أَوْ أَصَابَتْنَا سَمَاءٌ  وَنَحْنُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَنَادَى مُنَادِي         [10/415]      رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ الصَّلَاةَ فِي  الرِّحَالِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ .","","Musnad al-Bazzar 4561","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4568","4562  -  حَدَّثَنَا  بِشْرُ بْنُ آدَمَ ، وَمُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَا :  نَا  مُعَاذُ بْنُ هِشَامٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  التَّبَتُّلِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  إِلَّا  هِشَامٌ  ، وَلَا عَنْ  هِشَامٍ  إِلَّا ابْنُهُ  مُعَاذٌ  ، وَكَانَ  مُعَاذٌ  قَدْ حَدَّثَهُمْ مَرَّةً عَنْ أَبِيهِ عَنْ  قَتَادَةَ  عَنِ  الْحَسَنِ  ، ثُمَّ حَدَّثَهُمْ بَعْدُ بِهِ فَجَعَلَهُ عَنْ  سَمُرَةَ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Musnad al-Bazzar 4562","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن محمد بن معمر بن ربعي البحراني عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4569","[10/416]      4563  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  عَفَّانُ ،  عَنْ  حَمَّادٍ - يَعْنِي - ابْنَ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  أُنْزِلَ الْقُرْآنُ عَلَى ثَلَاثَةِ  أَحْرُفٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  ، وَلَا نَعْلَمُ يُرْوَى هَذَا اللَّفْظُ إِلَّا عَنْ  سَمُرَةَ  .","","Musnad al-Bazzar 4563","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن حماد بن سلمة عن عفان بن مسلم الصفار عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4570","4564  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  الْحَجَّاجُ بْنُ مِنْهَالٍ ، قَالَ :  نَا  حَمَّادٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  عُرِضَ الْقُرْآنُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثَلَاثَ عَرَضَاتٍ  ، قَالَ : فَيَرَوْنَ ، قَالَ : فَلَا أَدْرِي فِي هَذَا الْحَدِيثِ أَوْ غَيْرِهِ أَنَّ قِرَاءَتَنَا هِيَ الْعَرْضَةُ الْآخِرَةُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  حَمَّادٍ  عَنْ  قَتَادَةَ  إِلَّا  الْحَجَّاجُ بْنُ الْمِنْهَالِ  ، وَلَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ .","","Musnad al-Bazzar 4564","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4571","[10/417]      4565  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُعَاوِيَةَ ،  عَنْ  حَمَّادِ بْنِ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ مَلَكَ ذَا  رَحِمٍ  مَحْرَمٍ  فَهُوَ  حُرٌّ  .         [10/418]      وَهَذِهِ الثَّلَاثَةُ الْأَحَادِيثُ لَا نَعْلَمُ رَوَاهَا عَنْ  قَتَادَةَ  إِلَّا  حَمَّادُ بْنُ سَلَمَةَ  .","","Musnad al-Bazzar 4565","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن حماد بن سلمة عن عبد الله بن معاوية الجمحي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4572","4566  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  عَبْدُ الْأَعْلَى بْنُ الْقَاسِمِ ، قَالَ :  نَا  هِشَامٌ  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نُسَلِّمَ عَلَى أَئِمَّتِنَا  وَأَنْ يُسَلِّمَ بَعْضُنَا عَلَى بَعْضٍ فِي الصَّلَاةِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  سَمُرَةَ  .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : ( همام )","","Musnad al-Bazzar 4566","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عبد الأعلى بن القاسم اللؤلؤي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4573","4567  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْبُخَارِيُّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ         [10/419]      بِلَالٍ ، قَالَ :  نَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ تُنْكَحَ الْمَرْأَةُ عَلَى عَمَّتِهَا  وَعَلَى خَالَتِهَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  هَمَّامٍ  إِلَّا  مُحَمَّدُ بْنُ بِلَالٍ  ،  وَيَعْلَى بْنُ عَبَّادٍ الْكِلَابِيُّ ،  وَمُحَمَّدُ بْنُ بِلَالٍ  أَثْبَتُ  مِنْ  يَعْلَى بْنِ عَبَّادٍ  .","","Musnad al-Bazzar 4567","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن محمد بن بلال التمار عن البخاري عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4574","4568  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ، قَالَ :  نَا  يَعْلَى بْنُ عَبَّادٍ ، قَالَ :  نَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  أَفْطَرَ  الْحَاجِمُ  وَالْمَحْجُومُ  .         [10/420]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  هَمَّامٌ  ، عَنْ  قَتَادَةَ  ، عَنِ  الْحَسَنِ  ، عَنْ  سَمُرَةَ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  هَمَّامٍ  إِلَّا  يَعْلَى بْنُ عَبَّادٍ  . وَقَدِ اخْتُلِفَ عَنِ  الْحَسَنِ  ، فَقَالَ  يُونُسُ  : عَنِ  الْحَسَنِ  عَنْ  أَبِي هُرَيْرَةَ  ، وَقَالَ  عَطَاءُ بْنُ السَّائِبِ  : عَنِ  الْحَسَنِ  عَنْ  مَعْقِلِ بْنِ يَسَارٍ  ، وَقَالُوا :  مَعْقِلُ بْنُ سِنَانٍ  ، وَقَالَ  مَطَرٌ الْوَرَّاقُ  : عَنِ  الْحَسَنِ  عَنْ غَيْرِ وَاحِدٍ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، وَقَالَ  عُمَرُ بْنُ إِبْرَاهِيمَ  : عَنْ  قَتَادَةَ  عَنْ  عَلِيٍّ  - رَضِيَ اللهُ عَنْهُ  - .","","Musnad al-Bazzar 4568","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن يعلى بن عباد الكلابي عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4575","4569  -  حَدَّثَنَا  رَجَاءُ بْنُ مُحَمَّدٍ السَّقَطِيُّ ، وَالْحَسَنُ بْنُ يَحْيَى الرُّزِّيُّ ، قَالَا :  نَا  إِسْحَاقُ بْنُ إِدْرِيسَ ، قَالَ :  نَا  هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا تُسَاكِنُوا الْمُشْرِكِينَ فَمَنْ سَاكَنَهُمْ فَهُوَ مِنْهُمْ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  عَنِ  الْحَسَنِ  عَنْ  سَمُرَةَ  إِلَّا  هَمَّامٌ  ، وَلَا عَنْ  هَمَّامٍ  إِلَّا  إِسْحَاقُ بْنُ إِدْرِيسَ  .  وَمَعْنَاهُ أَنَّهُ قَالَ : لَا تُسَاكِنُوهُمْ فِي أَرْضِهِمْ  .","","Musnad al-Bazzar 4569","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن إسحاق بن إدريس الأسواري عن رجاء بن محمد العذري عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4576","4570  -  حَدَّثَنَا  أَحْمَدُ بْنُ إِسْحَاقَ ، قَالَ :  نَا  يَعْلَى بْنُ عَبَّادٍ ، قَالَ :  نَا         [10/421]      هَمَّامٌ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4570","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن همام بن يحيى بن دينار عن يعلى بن عباد الكلابي عن أحمد بن إسحاق بن عيسى الأهوازي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4577","4571  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ بُنْدَارٌ ، قَالَ :  نَا  قُرَيْشُ بْنُ أَنَسٍ ،  عَنْ  أَشْعَثَ - يَعْنِي - ابْنَ عَبْدِ الْمَلِكِ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّهُ  نَهَى أَنْ  يُقَدَّ  السَّيْرُ بَيْنَ الْأُصْبُعَيْنِ  .         [10/422]      وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  سَمُرَةُ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  هَمَّامٍ  عَنْ  قَتَادَةَ  إِلَّا  يَعْلَى بْنُ عَبَّادٍ  ، وَلَا عَنْ  أَشْعَثَ  إِلَّا  قُرَيْشُ بْنُ أَنَسٍ  ، وَلَا عَنْ  يَعْلَى بْنِ عَبَّادٍ  ، وَقَدْ حَدَّثَ بِأَحَادِيثَ  لَمْ يُتَابَعْ عَلَيْهَا ، وَمَا حَدَّثَ بِهِ عَنْ  هَمَّامٍ  مِنْ أَحَادِيثِ  سَمُرَةَ  ،  فَلَمْ يُتَابَعْ عَلَيْهِ إِلَّا حَدِيثٌ قَدْ بَيَّنَّاهُ رَوَاهُ  مُحَمَّدُ بْنُ بِلَالٍ  .","","Musnad al-Bazzar 4571","","سمرة بن جندب عن الحسن البصري عن أشعث الحمراني عن قريش بن أنس عن محمد بن بشار بندار عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4578","4572  -  حَدَّثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ ، وَالْحَسَنُ بْنُ يَحْيَى ، قَالَا :  نَا  إِسْحَاقُ بْنُ إِدْرِيسَ ، قَالَ :  نَا  سُوَيْدُ بْنُ إِبْرَاهِيمَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - .","","Musnad al-Bazzar 4572","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سويد بن إبراهيم الجحدري عن إسحاق بن إدريس الأسواري عن الحسن بن يحيى الرزي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4579","4573  -  وَحَدَّثَنَاهُ  عَبْدُ الرَّحْمَنِ بْنُ عِيسَى بْنِ سَاسَانَ السُّوسِيُّ وَعُمَرُ بْنُ الْخَطَّابِ ، قَالَا :  نَا  أَبُو الْجُمَاهِرِ ، قَالَ :  نَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  مَطَرٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  كَانَ إِذَا اسْتَسْقَى قَالَ : "" اللَّهُمَّ اجْعَلْ فِي أَرْضِنَا  زِينَتَهَا         [10/423]      وَسَكَنَهَا  .  وَحَدِيثُ  قَتَادَةَ  ، عَنِ  الْحَسَنِ  ، عَنْ  سَمُرَةَ  لَا نَعْلَمُ حَدَّثَ بِهِ عَنْ  قَتَادَةَ  إِلَّا  سُوَيْدُ بْنُ إِبْرَاهِيمَ أَبُو حَاتِمٍ  شَيْخٌ مِنْ  أَهْلِ الْبَصْرَةِ  لَا بَأْسَ بِهِ  ، وَحَدِيثُ  مَطَرٍ  لَا نَعْلَمُ رَوَاهُ عَنْهُ إِلَّا  سَعِيدُ بْنُ بَشِيرٍ  .","","Musnad al-Bazzar 4573","","سمرة بن جندب عن الحسن البصري عن مطر بن طهمان الوراق عن سعيد بن بشير الأزدي عن محمد بن عثمان الكفرسوسي عن عمر بن الخطاب السجستاني عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4580","4574  -  حَدَّثَنَا  أَبُو كُرَيْبٍ ، قَالَ :  نَا  أَبُو مُعَاوِيَةَ ، قَالَ :  نَا  الْحَجَّاجُ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  اقْتُلُوا شُيُوخَ الْمُشْرِكِينَ  وَاسْتَحْيُوا  شَرْخَهُمْ  .         [10/424]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  عَنِ  الْحَسَنِ  عَنْ  سَمُرَةَ  إِلَّا  الْحَجَّاجُ بْنُ أَرْطَاةَ  .","","Musnad al-Bazzar 4574","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن حجاج بن أرطاة عن أبو معاوية الضرير عن أبو كريب محمد بن العلاء عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4581","4575  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  يَزِيدُ بْنُ هَارُونَ ، قَالَ :  أَنَا  الْحَجَّاجُ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  كَانَ شِعَارُ  الْمُهَاجِرِينَ  عَبْدَ اللهِ  ، وَشِعَارُ  الْأَنْصَارِ  عَبْدَ الرَّحْمَنِ  - يَعْنِي : فِي الْحَرْبِ - عَلَى عَهْدِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .         [10/425]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  عَنِ  الْحَسَنِ  عَنْ  سَمُرَةَ  إِلَّا  الْحَجَّاجُ بْنُ أَرْطَاةَ  .","","Musnad al-Bazzar 4575","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن حجاج بن أرطاة عن يزيد بن هارون عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4582","4576  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو دَاوُدَ ، قَالَ :  نَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا  يَخْطُبُ  الرَّجُلُ عَلَى خِطْبَةِ أَخِيهِ  وَلَا يَبِيعُ عَلَى بَيْعِ أَخِيهِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  عَنِ  الْحَسَنِ  عَنْ  سَمُرَةَ  إِلَّا         [10/426]      عِمْرَانُ الْقَطَّانُ  .","","Musnad al-Bazzar 4576","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن عمران بن داور القطان عن أبو داود الطيالسي عن الفلاس عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4583","4577  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ :  نَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعِيدٍ  ، قَالَ :  نَا  أَبِي ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ، قَالَ :  نَا  عُمَرُ بْنُ مُوسَى بْنِ وَجِيهٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  نَزَلَتْ هَذِهِ الْآيَةُ         {      الْيَوْمَ أَكْمَلْتُ لَكُمْ دِينَكُمْ وَأَتْمَمْتُ عَلَيْكُمْ نِعْمَتِي         }      عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ  بِعَرَفَةَ  يَوْمَ جُمُعَةٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا رَوَاهُ عَنْ  قَتَادَةَ  إِلَّا  عُمَرُ بْنُ مُوسَى بْنِ وَجِيهٍ  ، وَلَا عَنْ  عُمَرَ  إِلَّا  مُحَمَّدُ بْنُ إِسْحَاقَ  ،  وَعُمَرُ بْنُ مُوسَى  لَيِّنُ الْحَدِيثِ ،  وَإِنَّمَا يُكْتَبُ مِنْ حَدِيثِهِ مَا يَتَفَرَّدُ بِهِ  .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : ( يعقوب بن إبراهيم بن سعد )","","Musnad al-Bazzar 4577","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن عمر بن موسى بن الوجيه الميثمي عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعيد الجوهري عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4584","4578  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ عَبْدِ الْعَظِيمِ ، وَصَالِحُ بْنُ مُعَاذٍ ، قَالَا :  نَا  يُونُسُ بْنُ مُحَمَّدٍ ، قَالَ :  نَا  سَلَّامُ بْنُ أَبِي مُطِيعٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ         [10/427]      سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْحَسَبُ  الْمَالُ وَالْكَرَمُ التَّقْوَى  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ حَدَّثَ بِهِ عَنْ  قَتَادَةَ  إِلَّا  سَلَّامُ بْنُ أَبِي مُطِيعٍ  ، وَكَانَ مِنْ خِيَارِ النَّاسِ وَعُقَلَائِهِمْ .  زاد قبله ( و ) في طبعة مكتبة العلوم والحكم وهو خطأ ، وينظر مصادر التخريج .","","Musnad al-Bazzar 4578","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سلام بن أبي مطيع الخزاعي عن يونس بن محمد بن مسلم البغدادي عن صالح بن معاذ عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4585","4579  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  عَبْدُ الصَّمَدِ ، قَالَ :  نَا  عُمَرُ بْنُ إِبْرَاهِيمَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ -         [10/428]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْمَيِّتُ  يُعَذَّبُ  بِمَا نِيحَ عَلَيْهِ  .  وَهَذَا الْحَدِيثُ أَحْسِبُ أَنَّ  عُمَرَ بْنَ إِبْرَاهِيمَ  أَخْطَأَ فِيهِ ; إِذْ رَوَاهُ عَنْ  قَتَادَةَ  عَنِ  الْحَسَنِ  عَنْ  سَمُرَةَ  ، وَإِنَّمَا يَرْوِيهِ  الثِّقَاتُ  : عَنْ  قَتَادَةَ  ، عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  ، عَنِ  ابْنِ عُمَرَ  ، عَنْ  عُمَرَ  ، وَعَنْ  قَتَادَةَ  ، عَنْ  قَزَعَةَ  ، عَنِ  ابْنِ عُمَرَ  ، عَنْ  عُمَرَ  ، وَعَنْ  قَتَادَةَ ،  عَنْ  يَحْيَى بْنِ رُؤْبَةَ  ، عَنِ  ابْنِ عُمَرَ  ، عَنْ  عُمَرَ  ، وَلَا نَعْلَمُ  تَابَعَ  عُمَرَ بْنَ إِبْرَاهِيمَ  عَلَى رِوَايَتِهِ أَحَدٌ مِنْ أَصْحَابِ  قَتَادَةَ  ، وَلَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ  ، وَعِنْدَ  عُمَرَ بْنِ إِبْرَاهِيمَ  : عَنْ  قَتَادَةَ  ، عَنِ  الْحَسَنِ  ، عَنْ  سَمُرَةَ  ثَلَاثَةُ أَحَادِيثَ لَمْ يُتَابَعْ عَلَيْهَا ، هَذَا أَحَدُهَا .","","Musnad al-Bazzar 4579","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن عمر بن إبراهيم العبدي عن عبد الصمد بن عبد الوارث التنوري عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4586","4580  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى أَبُو مُوسَى ، قَالَ :  نَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، قَالَ :  نَا  عُمَرُ بْنُ إِبْرَاهِيمَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ -  عَنِ  النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَمَّا حَمَلَتْ  حَوَّاءُ  أَطَافَ بِهَا إِبْلِيسُ  ، وَكَانَ لَا يَعِيشُ لَهَا وَلَدٌ ، فَقَالَ : سَمِّيهِ عَبْدَ الْحَارِثِ         [10/429]      فَإِنَّهُ يَعِيشُ . فَسَمَّتْهُ عَبْدَ الْحَارِثِ فَعَاشَ ، وَكَانَ ذَلِكَ مِنْ وَحْيِ الشَّيْطَانِ وَأَمْرِهِ  .  وَلَا نَعْلَمُ هَذَا الْحَدِيثَ رَوَاهُ أَحَدٌ إِلَّا  سَمُرَةَ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  إِلَّا  عُمَرُ بْنُ إِبْرَاهِيمَ  .","","Musnad al-Bazzar 4580","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن عمر بن إبراهيم العبدي عن عبد الصمد بن عبد الوارث التنوري عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4587","4581  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ، قَالَ :  نَا  عُمَرُ بْنُ إِبْرَاهِيمَ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا  أَفْلَسَ  الرَّجُلُ ، فَوَجَدَ رَجُلٌ مَالَهُ بِعَيْنِهِ  فَهُوَ أَحَقُّ بِهِ مِنَ الْغُرَمَاءِ  .         [10/430]      وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ  عُمَرَ بْنِ إِبْرَاهِيمَ  ، عَنْ  قَتَادَةَ  ، عَنِ  النَّضْرِ بْنِ أَنَسٍ  ، عَنْ  بَشِيرِ بْنِ نَهِيكٍ  ، عَنْ  أَبِي هُرَيْرَةَ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ الصَّوَابُ .","","Musnad al-Bazzar 4581","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن عمر بن إبراهيم العبدي عن عبد الصمد بن عبد الوارث التنوري عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4588","4582  -  حَدَّثَنَا  أَحْمَدُ بْنُ عُثْمَانَ بْنِ حَكِيمٍ ، وَمُحَمَّدُ بْنُ اللَّيْثِ ، قَالَا :  نَا  الْحَسَنُ بْنُ بِشْرِ بْنِ سَلْمٍ ، قَالَ :  نَا  الْحَكَمُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  الْفِرْدَوْسُ  رَبْوَةُ  الْجَنَّةِ  ، فَإِذَا سَأَلْتُمُ اللهَ تَبَارَكَ وَتَعَالَى فَاسْأَلُوهُ الْفِرْدَوْسَ  .         [10/431]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  إِلَّا  الْحَكَمُ بْنُ عَبْدِ الْمَلِكِ  .","","Musnad al-Bazzar 4582","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن الحكم بن عبد الملك القرشي عن الحسن بن بشر الكاهلي عن محمد بن الليث السرخسي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4589","4583  -  حَدَّثَنَا  رِزْقُ اللهِ بْنُ مُوسَى ، وَمُحَمَّدُ بْنُ اللَّيْثِ الْهَدَادِيُّ ، قَالَا :  نَا  الْحَسَنُ بْنُ بِشْرِ بْنِ سَلْمٍ ، قَالَ :  نَا  الْحَكَمُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ لِلشَّيْطَانِ كُحْلًا  وَلَعُوقًا  ، فَإِذَا كَحَّلَ الْإِنْسَانَ مِنْ كُحْلِهِ شَغَلَهُ عَنِ الصَّلَاةِ ، وَإِذَا أَلْعَقَهُ مِنْ  لَعُوقِهِ  ذَرِبَ  لِسَانُهُ بِالشَّرِّ  .         [10/432]","","Musnad al-Bazzar 4583","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن الحكم بن عبد الملك القرشي عن الحسن بن بشر الكاهلي عن محمد بن الليث السرخسي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4590","4584  -  وَحَدَّثَنَاهُ  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ بَكَّارٍ ، قَالَ :  نَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  وَهَذَا الْكَلَامُ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  سَمُرَةُ  وَأَنَسٌ  ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  إِلَّا  الْحَكَمُ بْنُ عَبْدِ الْمَلِكِ  وَسَعِيدُ بْنُ بَشِيرٍ  .","","Musnad al-Bazzar 4584","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن بكار العاملي عن إبراهيم بن المستمر العروقي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4591","4585  -  حَدَّثَنَا  أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلَاءِ ، قَالَ :  نَا  وَكِيعٌ ، قَالَ :  نَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَثَلُ  الْمُهَجِّرِ  إِلَى الْجُمُعَةِ كَالْمُهْدِي بَدَنَةً  ، ثُمَّ كَالْمُهْدِي بَقَرَةً ، حَتَّى بَلَغَ إِلَى الدَّجَاجَةِ وَالْبَيْضَةِ أَوْ نَحْوَ هَذَا  .         [10/433]      وَلَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  إِلَّا  سَعِيدُ بْنُ بَشِيرٍ  ،  وَسَعِيدُ بْنُ بَشِيرٍ  لَمْ يَكُنْ بِالْحَافِظِ  .","","Musnad al-Bazzar 4585","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن وكيع بن الجراح عن أبو كريب محمد بن العلاء عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4592","4586  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ بَكَّارٍ ، قَالَ :  نَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  التَّوَرُّكِ  وَالْإِقْعَاءِ  ، وَأَلَّا نَسْتَوْفِزَ فِي صَلَاتِنَا ، وَأَنْ لَا يُصَلِّيَ الْمُهَاجِرُ خَلْفَ الْأَعْرَابِيِّ  .         [10/434]      وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ إِلَّا  سَعِيدُ بْنُ بَشِيرٍ  عَنْ  قَتَادَةَ  .  تَفَرَّدَ  سَمُرَةُ  فِي هَذَا الْحَدِيثِ بِقَوْلِهِ : لَا نَسْتَوْفِزُ فِي صَلَاتِنَا .","","Musnad al-Bazzar 4586","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن بكار العاملي عن إبراهيم بن المستمر العروقي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4593","4587  -  وَحَدَّثَنَاهُ  إِبْرَاهِيمُ بْنُ هَانِي ، قَالَ :  نَا  مُحَمَّدُ بْنُ بَكَّارٍ ، قَالَ :  نَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَلَّا نَسْتَوْفِزَ فِي صَلَاتِنَا  .  وَرَوَى  حَمَّادُ بْنُ سَلَمَةَ  ، عَنْ  قَتَادَةَ  ، عَنْ  أَنَسٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الْإِقْعَاءِ  وَالتَّوَرُّكِ  فِي الصَّلَاةِ  .","","Musnad al-Bazzar 4587","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن بكار العاملي عن إبراهيم بن هانئ الأغياني عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4594","4588  -  وَحَدَّثَنَاهُ  هَارُونُ بْنُ سُفْيَانَ ، قَالَ :  نَا  يَحْيَى بْنُ إِسْحَاقَ وَقَالَ :  نَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ .         [10/435]      وَهَذَا الْحَدِيثُ أَظُنُّ أَنَّ  يَحْيَى بْنَ إِسْحَاقَ  أَخْطَأَ فِيهِ  ،  وَسَعِيدُ بْنُ بَشِيرٍ  فَلَا يُحْتَجُّ بِحَدِيثٍ لَهُ إِذَا  تَفَرَّدَ بِهِ  ،  وَالْحَدِيثُ الْمَحْفُوظُ  رَوَاهُ  حَمَّادُ بْنُ سَلَمَةَ  وَغَيْرُهُ ، عَنْ  قَتَادَةَ  ، عَنْ  أَنَسٍ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا صَلَّى أَحَدُكُمْ فَلَا يَفْتَرِشُ ذِرَاعَيْهِ  افْتِرَاشَ  الْكَلْبِ أَوِ السَّبُعِ  "" هَذَا هُوَ الْحَدِيثُ عِنْدَنَا ، وَاللهُ أَعْلَمُ  .","","Musnad al-Bazzar 4588","","أنس بن مالك عن قتادة بن دعامة عن حماد بن سلمة عن يحيى بن إسحاق السيلحيني عن هارون بن سفيان المستملي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4595","4589  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْفَضْلِ بْنِ الْمُوَفَّقِ ، قَالَ :  نَا  أَبِي  ،  عَنْ  أَبِي بَكْرٍ الْهُذَلِيِّ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  أَفْضَلُ  الْجِهَادِ  أَنْ تَكَلَّمَ بِالْحَقِّ  عِنْدَ سُلْطَانٍ "" ، أَوْ قَالَ : "" عِنْدَ سُلْطَانٍ جَائِرٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  الْحَسَنِ  إِلَّا  أَبُو بَكْرٍ الْهُذَلِيُّ  ،  وَأَبُو بَكْرٍ  رَجُلٌ مِنْ  أَهْلِ الْبَصْرَةِ ،  لَا يُثْبِتُ أَهْلُ الْعِلْمِ حَدِيثَهُ  ، وَقَدْ رَوَى عَنْهُ  ابْنُ جُرَيْجٍ  فَمَنْ دُونَهُ  .","","Musnad al-Bazzar 4589","","سمرة بن جندب عن الحسن البصري عن أبو بكر الهذلي عن الفضل بن الموفق الثقفي عن عبد الرحمن بن الفضل بن موفق عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4596","[10/436]      4590  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ إِسْحَاقَ الْعَطَّارُ ، قَالَ :  نَا  صَفْوَانُ بْنُ هُبَيْرَةَ ،  عَنِ  ابْنِ جُرَيْجٍ ، قَالَ :  أَخْبَرَنِي  أَبُو بَكْرٍ الْهُذَلِيُّ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  طَعَامُ  الْوَاحِدِ يَكْفِي الِاثْنَيْنِ  ، وَطَعَامُ الِاثْنَيْنِ يَكْفِي الْأَرْبَعَةَ ، وَيَدُ اللهِ تَبَارَكَ وَتَعَالَى عَلَى الْجَمَاعَةِ  .         [10/437]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنِ  ابْنِ جُرَيْجٍ  إِلَّا  صَفْوَانُ بْنُ هُبَيْرَةَ  .","","Musnad al-Bazzar 4590","","سمرة بن جندب عن الحسن البصري عن أبو بكر الهذلي عن ابن جريج عن صفوان بن هبيرة القصير عن عبد الله بن إسحاق الجوهري عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4597","4591  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ ، قَالَ :  نَا  خَلَّادُ بْنُ يَزِيدَ صَاحِبُ الْمَحَامِلِ ، قَالَ :  نَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا تَتَّخِذُوا شَيْئًا فِيهِ الرُّوحُ غَرَضًا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنِ  الْحَسَنِ  إِلَّا  مُبَارَكٌ  .","","Musnad al-Bazzar 4591","","سمرة بن جندب عن الحسن البصري عن مبارك بن فضالة عن خلاد بن بزيع عن إبراهيم بن المستمر العروقي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4598","4592  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْعَوَّامِ ، قَالَ :  نَا  أَبُو عُثْمَانَ الْأُبُلِّيُّ ، قَالَ :  نَا  مُبَارَكُ بْنُ فَضَالَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْمُؤْمِنُ يَأْكُلُ فِي مَعِيٍّ وَاحِدٍ  ،         [10/438]      وَالْكَافِرُ يَأْكُلُ فِي سَبْعَةِ أَمْعَاءٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  مُبَارَكٍ  إِلَّا  عُثْمَانُ  وَلَمْ يُسَمِّهِ  .","","Musnad al-Bazzar 4592","","سمرة بن جندب عن الحسن البصري عن مبارك بن فضالة عن الوليد بن محمد بن صالح الأبلي عن محمد بن صالح بن العوام عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4599","4593  -  حَدَّثَنَا  الْحَسَنُ بْنُ يَحْيَى الْأَرُزِّيُّ ، قَالَ :  نَا  أَبُو إِسْمَاعِيلَ الْجُودَانِيُّ عَبْدُ اللهِ بْنُ إِسْمَاعِيلَ ، قَالَ :  نَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِرَجُلٍ  :  أَنْتَ وَمَالُكَ لِأَبِيكَ  .         [10/439]      وَهَذَا الْحَدِيثُ رَوَاهُ غَيْرُ  أَبِي إِسْمَاعِيلَ  عَنْ  جَرِيرٍ  عَنِ  الْحَسَنِ  مُرْسَلًا  ، وَلَا نَعْلَمُ  أَسْنَدَهُ  غَيْرُ  أَبِي إِسْمَاعِيلَ  .","","Musnad al-Bazzar 4593","","سمرة بن جندب عن الحسن البصري عن جرير بن حازم عن عبد الله بن إسماعيل الجهضمي عن الحسن بن يحيى الرزي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4600","4594  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْأَزْدِيُّ ، قَالَ :  نَا  سُرَيْجُ بْنُ النُّعْمَانِ ، قَالَ :  نَا  الْحَكَمُ بْنُ عَبْدِ الْمَلِكِ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا أَتَيْتُمُ الْجُمُعَةَ فَادْنُوا مِنَ الْإِمَامِ  ، وَاسْتَمِعُوا الْخُطْبَةَ وَلَا تَلْغُوا  .         [10/440]      وَهَذَا الْحَدِيثُ رَوَاهُ  هِشَامٌ  عَنْ  قَتَادَةَ  عَنْ رَجُلٍ عَنْ  سَمُرَةَ  .","","Musnad al-Bazzar 4594","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن الحكم بن عبد الملك القرشي عن سريج بن النعمان الجوهري عن محمد بن يحيى بن أبي حاتم عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4601","4595  -  حَدَّثَنَا  عُمَرُ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ ، قَالَ :  نَا  أَبِي  ،  عَنْ  إِبْرَاهِيمَ بْنِ طَهْمَانَ ،  عَنْ  مَطَرٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْغُلَامُ مُرْتَهَنٌ  بِعَقِيقَتِهِ  فَأَمِيطُوا عَنْهُ  الْأَذَى  وَاحْلِقُوا رَأْسَهُ  .  وَقَدْ رَوَى هَذَا الْحَدِيثَ  قَتَادَةُ  عَنِ  الْحَسَنِ  عَنْ  سَمُرَةَ  بِقَرِيبٍ مِنْ هَذَا         [10/441]      اللَّفْظِ ، وَلَا نَعْلَمُ رَوَاهُ عَنْ  مَطَرٍ  إِلَّا  إِبْرَاهِيمُ بْنُ طَهْمَانَ  .","","Musnad al-Bazzar 4595","","سمرة بن جندب عن الحسن البصري عن مطر بن طهمان الوراق عن إبراهيم بن طهمان عن محمد بن الحسن بن الزبير التل عن عمر بن محمد بن الحسن بن الزبير الأسدي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4602","4596  -  حَدَّثَنَا  خَالِدُ بْنُ مُحَمَّدِ بْنِ خَالِدٍ ، قَالَ :  نَا  مُعَاذُ بْنُ هِشَامٍ ، قَالَ :  حَدَّثَنِي  أَبِي  عَنْ  مَطَرٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الْأَجْلَابِ أَنْ تُتَلَقَّى حَتَّى تَبْلُغَ السُّوقَ  ، وَنَهَى أَنْ يَبِيعَ  حَاضِرٌ  لِبَادٍ  .  وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ عَنِ  الْحَسَنِ  إِلَّا  مَطَرٌ  ، وَلَا عَنْ  مَطَرٍ  إِلَّا         [10/442]      هِشَامٌ  .","","Musnad al-Bazzar 4596","","سمرة بن جندب عن الحسن البصري عن مطر بن طهمان الوراق عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن خالد بن محمد بن خالد بن كولخش عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4603","4597  -  حَدَّثَنَا  يَحْيَى بْنُ حَبِيبِ بْنِ عَرَبِيٍّ ، قَالَ :  نَا  خَالِدُ بْنُ الْحَارِثِ ، قَالَ :  نَا  أَشْعَثُ - يَعْنِي - ابْنَ عَبْدِ الْمَلِكِ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ صَلَّى الصُّبْحَ فَهُوَ فِي ذِمَّةِ اللهِ  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ  قَتَادَةُ  وَدَاوُدُ  عَنِ  الْحَسَنِ  عَنْ  جُنْدُبٍ  ، وَهُوَ الصَّوَابُ عِنْدَنَا  .","","Musnad al-Bazzar 4597","","سمرة بن جندب عن الحسن البصري عن أشعث الحمراني عن خالد الصدق عن يحيى بن حبيب الحارثي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4604","4598  -  حَدَّثَنَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْكَبِيرِ ، قَالَ :  نَا  الْحَجَّاجُ بْنُ الْمِنْهَالِ ،  عَنْ  يَزِيدَ بْنِ إِبْرَاهِيمَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ         [10/443]      عَنْهُ - قَالَ :  مَا خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خُطْبَةً إِلَّا أَمَرَنَا بِالصَّدَقَةِ  وَنَهَانَا عَنِ  الْمُثْلَةِ  .  قَالَ أَبُو بَكْرٍ :  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ جَمَاعَةٌ عَنِ  الْحَسَنِ  عَنْ  عِمْرَانَ بْنِ حُصَيْنٍ  ، وَالصَّوَابُ عَنْ  عِمْرَانَ بْنِ حُصَيْنٍ  .","","Musnad al-Bazzar 4598","","سمرة بن جندب عن الحسن البصري عن يزيد بن إبراهيم التستري عن حجاج بن المنهال الأنماطي عن عبد القدوس بن محمد الحبحابي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4605","4599  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ         [10/444]      عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْحُمَّى قِطْعَةٌ مِنَ الْعَذَابِ  - وَذَكَرَ كَلِمَةً مَعْنَاهَا - فَأَطْفِئُوهَا عَنْكُمْ بِالْمَاءِ الْبَارِدِ "" . قَالَ وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا حُمَّ دَعَا بِقِرْبَةٍ مِنْ مَاءٍ فَأَفْرَغَهَا عَلَى رَأْسِهِ فَاغْتَسَلَ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا مِنْ هَذَا الْوَجْهِ ،  وَإِسْمَاعِيلُ بْنُ مُسْلِمٍ  لَيْسَ بِالْقَوِيِّ  وَحَدَّثَ عَنْهُ  الْأَعْمَشُ  وَالثَّوْرِيُّ  وَشَرِيكٌ  وَغَيْرُهُمْ  .","","Musnad al-Bazzar 4599","","سمرة بن جندب عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن محمد بن عبد الله بن المثنى الخزرجي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4606","4600  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  لَا تَسْبِقُوا الْإِمَامَ بِالرُّكُوعِ  ، فَإِنَّكُمْ تُدْرِكُونَهُ بِمَا سَبَقَكُمْ  .","","Musnad al-Bazzar 4600","","سمرة بن جندب عن الحسن البصري عن إسماعيل بن مسلم الكيشي عن محمد بن عبد الله بن المثنى الخزرجي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4607","[10/445]      4601  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا نَعَسَ أَحَدُكُمْ يَوْمَ الْجُمُعَةِ فَلْيَتَحَوَّلْ إِلَى مَكَانِ صَاحِبِهِ  وَيَتَحَوَّلُ صَاحِبُهُ إِلَى مَكَانِهِ "" قِيلَ  لِإِسْمَاعِيلَ  : وَالْإِمَامُ يَخْطُبُ ، قَالَ : "" نَعَمْ  .","","Musnad al-Bazzar 4601","","سمرة بن جندب عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن محمد بن عبد الله بن المثنى الخزرجي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4608","4602  -  وَحَدَّثَنَاهُ  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ مُسْلِمٍ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا  تَحَرَّوْا  بِصَلَاتِكُمْ طُلُوعَ الشَّمْسِ وَلَا غُرُوبَهَا  فَإِنَّهَا تَطْلُعُ فِي  قَرْنَيْ  شَيْطَانٍ  وَتَغْرُبُ فِي  قَرْنَيْ  شَيْطَانٍ  .         [10/446]      قَالَ أَبُو بَكْرٍ :  وَأَحَادِيثُ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ  لَا نَعْلَمُ رَوَاهَا عَنِ  الْحَسَنِ  غَيْرُهُ  .","","Musnad al-Bazzar 4602","","سمرة بن جندب عن الحسن البصري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن محمد بن عبد الله بن المثنى الخزرجي عن أبو موسى الزمن عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4609","4603  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَانِي ، قَالَ :  نَا  مُحَمَّدُ بْنُ بَكَّارٍ ، قَالَ :  نَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ ،  عَنْ  سَمُرَةَ - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  أَشَدُّ حَسَرَاتِ بَنِي آدَمَ فِي الدُّنْيَا ثَلَاثٌ  : رَجُلٌ لَهُ أَرْضٌ تُسْقَى وَلَهُ  سَانِيَةٌ  يَسْقِي عَلَيْهَا أَرْضَهُ ، فَلَمَّا اشْتَدَّ وَأَخْرَجَتْ  ثَمَرَهَا  مَاتَتْ  سَانِيَتُهُ  ، فَيَجِدُ حَسْرَةً عَلَى  سَانِيَتِهِ  الَّتِي قَدْ عَلِمَ أَنَّهُ لَا يَجِدُ مِثْلَهَا ، وَيَجِدُ حَسْرَةً عَلَى  ثَمَرَةِ  أَرْضِهِ أَنْ تَفْسُدَ قَبْلَ أَنْ يَحْتَالَ حِيلَةً . وَرَجُلٌ لَهُ فَرَسٌ جَوَادٌ فَلَقِيَ جَمْعًا مِنَ الْكُفَّارِ ، فَلَمَّا دَنَا بَعْضُهُمْ مِنْ بَعْضٍ انْهَزَمَ أَعْدَاءُ اللهِ ، فَسَبَقَ الرَّجُلُ عَلَى فَرَسِهِ أَنْ لَا يَجِدَ مِثْلَهُ ، وَيَجِدَ حَسْرَةً عَلَى مَا فَاتَهُ مِنَ الظَّفَرِ الَّذِي كَانَ قَدْ أَشْرَفَ عَلَيْهِ . وَرَجُلٌ عِنْدَهُ امْرَأَةٌ قَدْ رَضِيَ هَيْئَتَهَا وَدِينَهَا فَنَفَسَتْ غُلَامًا ، فَمَاتَتْ بِنِفَاسِهِ فَيَجِدُ حَسْرَةً عَلَى امْرَأَتِهِ ، يَظُنُّ أَنَّهُ لَنْ يُصَادِفَ مِثْلَهَا ، وَيَجِدُ حَسْرَةً عَلَى         [10/447]      وَلَدِهِ يَخْشَى ضَيْعَتَهُ قَبْلَ أَنْ يَجِدَ مَنْ يُرْضِعُهُ ، فَهَذِهِ أَكْثَرُ أُولَئِكَ الْحَسَرَاتِ  .","","Musnad al-Bazzar 4603","","سمرة بن جندب عن الحسن البصري عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن محمد بن بكار العاملي عن إبراهيم بن هانئ الأغياني عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4610","4604  -  وَحَدَّثَنَا  بِهِ خَالِدُ بْنُ يُوسُفَ ، قَالَ :  حَدَّثَنِي  أَبِي يُوسُفُ بْنُ خَالِدٍ ، قَالَ :  نَا  جَعْفَرُ بْنُ سَعْدِ بْنِ سَمُرَةَ ، قَالَ :  حَدَّثَنِي  خُبَيْبُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ سُلَيْمَانَ بْنِ سَمُرَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ ،  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنَحْوِهِ .  قَالَ أَبُو بَكْرٍ :  وَلَا نَعْلَمُ هَذَا الْكَلَامَ يُرْوَى إِلَّا عَنْ  سَمُرَةَ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  .","","Musnad al-Bazzar 4604","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4611","[10/448]      4605  -  وَحَدَّثَنَا  خَالِدُ بْنُ يُوسُفَ ، قَالَ :  حَدَّثَنِي  أَبِي : يُوسُفُ بْنُ خَالِدٍ  ، قَالَ :  نَا  جَعْفَرُ بْنُ سَعْدِ بْنِ سَمُرَةَ ، قَالَ :  حَدَّثَنِي  خُبَيْبُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ سُلَيْمَانَ بْنِ سَمُرَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ  أَنَّهُ كَتَبَ إِلَى بَنِيهِ : مِنْ  سَمُرَةَ بْنِ جُنْدُبٍ  سَلَامٌ عَلَيْكُمْ ، فَإِنِّي  أَحْمَدُ  إِلَيْكُمُ اللهَ الَّذِي لَا إِلَهَ إِلَّا هُوَ . أَمَّا بَعْدُ ، فَإِنِّي أُوصِيكُمْ بِتَقْوَى اللهِ ، وَأَنْ تُقِيمُوا الصَّلَاةَ وَتُؤْتُوا الزَّكَاةَ ، وَتَجْتَنِبُوا الْخَبَائِثَ ، وَتُطِيعُوا اللهَ وَرَسُولَهُ وَالْخُلَفَاءَ الَّذِينَ يُقِيمُونَ أَمْرَ اللهِ . أَلَا وَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُنَا أَنْ نُصَلِّيَ مِنَ اللَّيْلِ أَوْ يُصَلِّيَ أَحَدُنَا بَعْدَ الصَّلَاةِ الْمَكْتُوبَةِ مَا قَلَّ أَوْ كَثُرَ وَنَجْعَلُهَا  وِتْرًا  .","","Musnad al-Bazzar 4605","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4612","4606  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُنَا أَنْ نُصَلِّيَ أَيَّ سَاعَةٍ شِئْنَا مِنْ لَيْلٍ أَوْ نَهَارٍ  ، غَيْرَ أَنَّهُ أَمَرَنَا أَنْ نَجْتَنِبَ طُلُوعَ الشَّمْسِ وَغُرُوبَهَا ، وَقَالَ : "" إِنَّ الشَّيْطَانَ يَغِيبُ حِينَ تَغِيبُ وَيَطْلُعُ مَعَهَا  .","","Musnad al-Bazzar 4606","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4613","[10/449]      4607  -  وَبِإِسْنَادِهِ  : قَالَ :  أَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نُحَافِظَ عَلَى الصَّلَوَاتِ كُلِّهِنَّ  وَأَمَرَنَا بِالصَّلَاةِ الْوُسْطَى ، وَقَالَ : "" إِنَّهَا صَلَاةُ الْعَصْرِ  .","","Musnad al-Bazzar 4607","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4614","4608  -  وَبِإِسْنَادِهِ  : قَالَ :  نَهَانَا أَنْ نُوَاصِلَ فِي شَهْرِ الصَّوْمِ وَلَيْسَتْ  بِالْعَزْمَةِ  .","","Musnad al-Bazzar 4608","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4615","[10/450]      4609  -  وَبِإِسْنَادِهِ  : قَالَ :  وَأَمَرَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُسَلِّمَ بَعْضُنَا عَلَى بَعْضٍ إِذَا الْتَقَيْنَا  .","","Musnad al-Bazzar 4609","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4616","4610  -  وَبِإِسْنَادِهِ  : قَالَ :  وَنَهَانَا - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نَلْتَعِنَ بِلَعْنَةِ اللهِ وَغَضَبِهِ  ، وَنَهَانَا أَنْ نَلْتَعِنَ بِالنَّارِ  .","","Musnad al-Bazzar 4610","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4617","4611  -  وَبِإِسْنَادِهِ  : قَالَ :  نَهَانَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ نَسْتَبَّ ، وَقَالَ :  إِنْ كَانَ أَحَدُكُمْ سَابًّا صَاحِبَهُ فَلَا يَعْتَرِي عَلَيْهِ  ، وَلَا يَسُبَّنَّ وَالِدَيْهِ ، وَلَا يَسُبَّنَّ قَوْمَهُ ، وَلَكِنْ إِنْ كَانَ يَعْلَمُ ذَلِكَ فَلْيَقُلْ : إِنَّكَ مُخْتَالٌ ، أَوْ لِيَقُلْ : إِنَّكَ جَبَانٌ ، أَوْ لِيَقُلْ : إِنَّكَ لَكَذُوبٌ ، أَوْ لِيَقُلْ إِنَّكَ لَئُومٌ  .","","Musnad al-Bazzar 4611","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4618","4612  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَأْمُرُنَا أَنْ نَقْرَأَ الْقُرْآنَ كَمَا أَقْرَأَنَاهُ ، وَقَالَ :  أُنْزِلَ عَلَى ثَلَاثَةِ  أَحْرُفٍ  فَلَا تَخْتَلِفُوا فِيهِ  وَلَا تَجَافُوا عَنْهُ فَإِنَّهُ مُبَارَكٌ كُلُّهُ اقْرَءُوهُ كَالَّذِي أُقْرِئْتُمُوهُ  .","","Musnad al-Bazzar 4612","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4619","[10/451]      4613  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُنَا إِذَا نَامَ أَحَدُنَا عَنِ الصَّلَاةِ أَوْ نَسِيَهَا  حَتَّى يَذْهَبَ حِينُهَا الَّتِي تُصَلَّى فِيهِ أَنْ يُصَلِّيَهَا مَعَ الَّتِي تَلِيهَا مِنَ الصَّلَاةِ الْمَكْتُوبَةِ  .","","Musnad al-Bazzar 4613","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4620","4614  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُنَا إِذَا أَدْرَكْنَا الصَّلَاةَ وَنَحْنُ ثَلَاثَةٌ أَنْ يَؤُمَّنَا وَاحِدٌ مِنَّا  .","","Musnad al-Bazzar 4614","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4621","4615  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا أَقَمْتُمُ الصَّلَاةَ فَلَا تَسْبِقُوا قَارِئَكُمْ بِالرُّكُوعِ وَالسُّجُودِ  ، وَلَكِنْ هُوَ يَسْبِقُكُمْ ، فَإِذَا كَانَ حِينَ السَّلَامِ فَسَلِّمُوا عَلَى النَّبِيِّينَ ، ثُمَّ سَلِّمُوا عَلَى قَارِئِكُمْ وَعَلَى أَنْفُسِكُمْ  .","","Musnad al-Bazzar 4615","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4622","[10/452]      4616  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُهُمْ إِذَا كَانُوا فِي الصَّلَاةِ أَنْ لَا يَسْتَوْفِزُوا عَلَى أَطْرَافِ الْأَقْدَامِ ، وَيَقُولُ :  إِذَا نَفَثَ أَحَدُكُمْ فِي الصَّلَاةِ فَلَا يَنْفُثَنَّ قُدَّامَ وَجْهِهِ وَلَا عَنْ يَمِينِهِ  وَلَكِنْ تَحْتَ قَدَمِهِ ، ثُمَّ يَدْلُكُهَا بِالْأَرْضِ  .","","Musnad al-Bazzar 4616","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4623","4617  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِذَا تَبَايَعَ الرَّجُلَانِ فَإِنَّ كُلَّ وَاحِدٍ مِنْهُمَا  بِالْخِيَارِ  حَتَّى  يُفَارِقَ  صَاحِبَهُ  ، فَيَخْتَارُ كُلُّ وَاحِدٍ هَوَاهُ مِنَ الْبَيْعِ  .","","Musnad al-Bazzar 4617","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4624","4618  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَنْهَى النِّسَاءَ أَنْ يَضْطَجِعَ بَعْضُهُنَّ مَعَ بَعْضٍ  ، إِلَّا وَبَيْنَهُنَّ ثِيَابٌ أَوْ ثَوْبٌ ، وَلَا يَضْطَجِعُ الرَّجُلُ مَعَ صَاحِبِهِ إِلَّا وَبَيْنَهُمَا ثَوْبٌ  .","","Musnad al-Bazzar 4618","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4625","[10/453]      4619  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَنْهَى أَنْ يَسِلَّ الْمُسْلِمُ عَلَى الْمُسْلِمِ السِّلَاحَ  .","","Musnad al-Bazzar 4619","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4626","4620  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  الْمُؤْمِنُ يَأْكُلُ فِي  مِعًى  وَاحِدٍ وَالْكَافِرُ يَأْكُلُ فِي سَبْعَةِ أَمْعَاءٍ  .","","Musnad al-Bazzar 4620","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4627","4621  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَ يَقُولُ : ""  أَيُّكُمْ مَا صَنَعَ طَعَامًا قَدْرَ مَا يَأْكُلُ رَجُلَانِ فَإِنَّهُ يَكْفِي ثَلَاثَةً  ، أَوْ         [10/454]      صَنَعَ طَعَامًا قَدْرَ مَا يَكْفِي أَرْبَعَةً فَإِنَّهُ يَكْفِي خَمْسَةً  .","","Musnad al-Bazzar 4621","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4628","4622  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُنَا أَنْ نَصْنَعَ الْمَسَاجِدَ فِي دُورِنَا  ، وَنُنَظِّفَهَا وَنُطَهِّرَهَا إِنْ شَاءَ اللهُ  .","","Musnad al-Bazzar 4622","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4629","4623  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُنَا أَنْ نَشْهَدَ الْجُمُعَةَ وَلَا نَغِيبَ عَنْهَا  ، وَقَالَ : "" إِنَّ أَحَدَكُمْ أَحَقُّ بِمَقْعَدِهِ إِذَا رَجَعَ إِلَيْهِ  .","","Musnad al-Bazzar 4623","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4630","4624  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  إِذَا نَعَسَ أَحَدُكُمْ يَوْمَ الْجُمُعَةِ فَلْيَتَحَوَّلْ مِنْ مَقْعَدِهِ  إِلَى مَكَانٍ آخَرَ  .","","Musnad al-Bazzar 4624","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4631","[10/455]      4625  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَتَاهُ  رَجُلٌ مِنَ الْأَعْرَابِ  يَسْتَفْتِيهِ فِي الَّذِي يَحْرُمُ عَلَيْهِ وَالَّذِي يَحِلُّ لَهُ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أُحِلَّ لَكَ الطَّيِّبَاتُ وَحُرِّمَ عَلَيْكَ الْخَبَائِثُ إِلَّا أَنْ تُضْطَرَّ إِلَى طَعَامٍ  لَا يَحِلُّ لَكَ فَتَأْكُلَ مِنْهُ حَتَّى تَسْتَغْنِيَ  .","","Musnad al-Bazzar 4625","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4632","4626  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُنَا أَلَا نُخْرِجَ الصَّدَقَةَ مِنَ الرَّقِيقِ  .","","Musnad al-Bazzar 4626","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4633","4627  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَوْ تَعْلَمُونَ مَا أَعْلَمُ لَبَكَيْتُمْ كَثِيرًا وَلَضَحِكْتُمْ قَلِيلًا  .","","Musnad al-Bazzar 4627","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4634","[10/456]      4628  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ لَنَا :  إِذَا صَلَّى أَحَدُكُمْ فَلْيَقُلِ : اللَّهُمَّ بَاعِدْ بَيْنِي وَبَيْنَ خَطِيئَتِي  كَمَا بَاعَدْتَ بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ أَنْ  تَصُدَّ  عَنِّي وَجْهَكَ يَوْمَ الْقِيَامَةِ ، اللَّهُمَّ نَقِّنِي مِنَ الْخَطَايَا كَمَا يُنَقَّى الثَّوْبُ الْأَبْيَضُ مِنَ الدَّنَسِ ، اللَّهُمَّ أَحْيِنِي مُسْلِمًا وَأَمِتْنِي مُسْلِمًا  .","","Musnad al-Bazzar 4628","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4635","4629  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ لَنَا :  إِنَّ أَحَدَكُمْ  يُوشِكُ  أَنْ يُحِبَّ أَنْ يَنْظُرَ إِلَيَّ نَظْرَةً وَاحِدَةً  أَحَبُّ إِلَيْهِ مِمَّا لَهُ مِنْ مَالِهِ  .","","Musnad al-Bazzar 4629","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4636","4630  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ لَنَا :  إِنَّكُمْ سَتُوشِكُوا  أَنْ تَكُونُوا فِي النَّاسِ كَالْمِلْحِ فِي الطَّعَامِ  وَلَا يَصِحُّ الطَّعَامُ إِلَّا بِالْمِلْحِ  .  كذا في طبعة مكتبة العلوم والحكم ، وقال المحقق: في الكشف ( 3 / 291 ) : توشكون ، وهو الصواب","","Musnad al-Bazzar 4630","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4637","[10/457]      4631  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَيْسَ مِنْكُمْ رَجُلٌ إِلَّا وَأَنَا مُمْسِكٌ  بِحُجْزَتِهِ  أَنْ يَقَعَ فِي النَّارِ  .","","Musnad al-Bazzar 4631","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4638","4632  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَنْهَى عَنِ النُّهْبَةِ  .","","Musnad al-Bazzar 4632","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4639","4633  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  لَا تَقُومُ السَّاعَةُ حَتَّى يَدُلَّ الْحَجَرُ عَلَى الْيَهُودِيِّ  ، فَيَقُولُ : يَا عَبْدَ اللهِ هَذَا -  أَحْسِبُهُ قَالَ - وَرَائِي يَهُودِيٌّ  .","","Musnad al-Bazzar 4633","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4640","4634  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ  الْمَسِيحَ الدَّجَّالَ  أَعْوَرُ  عَيْنِ الشِّمَالِ عَلَيْهَا  ظَفَرَةٌ  غَلِيظَةٌ  ، يُبْرِئُ الْأَكْمَهَ ،         [10/458]      وَيُحْيِي الْمَوْتَى ، وَيَقُولُ : أَنَا رَبُّكُمْ . فَمَنِ اعْتَصَمَ بِاللهِ فَقَالَ : رَبِّيَ اللهُ حَتَّى يَمُوتَ فَلَا عَذَابَ عَلَيْهِ ، وَمَنْ قَالَ أَنْتَ رَبِّي فَقَدْ فُتِنَ  .","","Musnad al-Bazzar 4634","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4641","4635  -  وَبِإِسْنَادِهِ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ  الْمَسِيحَ الدَّجَّالَ  يَلْبَثُ فِي الْأَرْضِ إِذَا خَرَجَ مَا شَاءَ اللهُ  ، ثُمَّ يَجِيءُ  عِيسَى ابْنُ مَرْيَمَ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الْمَشْرِقِ مُصَدِّقًا  بِمُحَمَّدٍ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَى مِلَّتِهِ ، ثُمَّ يَقْتُلُ  الْمَسِيحَ الدَّجَّالَ  ، ثُمَّ إِنَّمَا هُوَ بَعْدَ قِيَامِ السَّاعَةِ ، وَسَوْفَ تَرَوْنَ قَبْلَ أَنْ تَقُومَ السَّاعَةُ أَشْيَاءَ عِظَامًا تَقُولُونَ هَلْ كُنَّا حَدَّثْنَا بِهَا ، فَإِذَا رَأَيْتُمْ ذَلِكَ فَاذْكُرُوا اللهَ ، وَاعْلَمُوا أَنَّهَا أَوَائِلُ السَّاعَةِ  .","","Musnad al-Bazzar 4635","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4642","4636  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا يَحِلُّ لِرَجُلٍ مُسْلِمٍ أَنْ يَجْدَعَ عَبْدَهُ وَلَا يَخْصِيَهُ  ، فَمَنْ فَعَلَ بِهِ فُعِلَ بِهِ مِثْلُهُ  .","","Musnad al-Bazzar 4636","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4643","[10/459]      4637  -  حَدَّثَنَا  خَالِدُ بْنُ يُوسُفَ ، قَالَ :  حَدَّثَنِي  أَبِي  ، قَالَ :  نَا  جَعْفَرُ بْنُ سَعْدِ بْنِ سَمُرَةَ ، قَالَ :  حَدَّثَنِي  خُبَيْبُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ سُلَيْمَانَ بْنِ سَمُرَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ  - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُ بِقِرَى الضَّيْفِ  ، وَنَهَى أَنْ نَحْتَلِبَ مَاشِيَةَ الرَّجُلِ إِلَّا بِإِذْنِهِ وَيَقُولُ : ""  إِنَّمَا أَلْبَانُهَا كَمَا فِي جِفَانِكُمْ "" - أَوْ كَلِمَةً نَحْوَهَا  - "" لَيْسَ أَحَدُهَا بِأَحَلَّ مِنَ الْآخَرِ  .         [10/460]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4637","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4644","4638  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  إِنَّ الشَّمْسَ وَالْقَمَرَ لَا  يَنْكَسِفَانِ  لِمَوْتِ أَحَدٍ مِنْكُمْ  ، وَلَكِنَّهُمَا آيَتَانِ مِنْ آيَاتِ اللهِ  يَسْتَعْتِبُ  بِهِمَا عِبَادَهُ ; لِيَنْظُرَ مَنْ يَخَافُهُ وَمَنْ يَذْكُرُهُ ، فَإِذَا رَأَيْتُمْ ذَلِكَ  فَافْزَعُوا  إِلَى ذِكْرِ اللهِ فَاذْكُرُوهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ، وَلَا يُرْوَى هَذَا اللَّفْظُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا مِنْ هَذَا الْوَجْهِ .","","Musnad al-Bazzar 4638","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4645","4639  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  لَا تَلَقَّوُا الْأَجْلَابَ قَبْلَ أَنْ تَأْتِيَ سُوقَهَا  ، وَلَا تَبِيعُوا لِلْأَعْرَابِ وَإِنْ كَانَ أَخَا أَحَدِكُمْ أَوْ أَبَاهُ أَوْ أُمَّهُ  .         [10/461]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4639","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4646","4640  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَنْ بَاعَ أَرْضًا أَوْ دَارًا فَإِنَّ جَارَ الدَّارِ أَوِ الْأَرْضِ أَحَقُّ بِهَا  .","","Musnad al-Bazzar 4640","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4647","4641  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  إِذَا نَكَحَ الْمَرْأَةَ الرَّجُلَانِ كِلَاهُمَا ، فَأَحَقُّ النَّاكِحَيْنِ أَوَّلُهُمَا  ، وَالْبَيْعُ إِذَا ابْتَاعَ الرَّجُلَانِ سِلْعَةً وَاحِدَةً ، فَأَحَقُّهُمَا أَوَّلُهُمَا  .","","Musnad al-Bazzar 4641","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4648","[10/462]      4642  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَنْهَى عَنِ  الشِّغَارِ  بَيْنَ النِّسَاءِ  .","","Musnad al-Bazzar 4642","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4649","4643  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَنْهَى إِذَا كَانُوا ثَلَاثَةً أَنْ  يَنْتَجِيَ  اثْنَانِ مِنْهُمْ دُونَ الثَّالِثِ  .  وَهَذَا الْحَدِيثُ  لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا بِهَذَا الْحَدِيثِ .  كذا في طبعة مكتبة العلوم والحكم : ، وصوابه الإسناد]","","Musnad al-Bazzar 4643","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4650","4644  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُنَا إِذَا غَزَوْنَا فَدَعَا رَجُلٌ فِي أُخْرَى  الْقَوْمِ  ، فَقَالَ يَا أَيُّهَا الْأَوَّلُ أَنْ نَنْتَظِرَهُ حَتَّى يَلْحَقَ  .  وَهَذَا الْحَدِيثُ لَا نَحْفَظُ كَلَامَهُ إِلَّا عَنْ  سَمُرَةَ  عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4644","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4651","[10/463]      4645  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُ الْمُهَاجِرِينَ أَنْ يَتَقَدَّمُوا وَأَنْ يَكُونُوا مُقَدَّمَ الصُّفُوفِ ، وَيَقُولُ :  هُمْ أَعْلَمُ بِالصَّلَاةِ مِنَ السُّفَهَاءِ وَالْأَعْرَابِ وَلَا أُحِبُّ أَنْ تَكُونَ الْأَعْرَابُ أَمَامَهُمْ  وَلَا يَدْرُونَ كَيْفَ الصَّلَاةُ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُ أَحَدًا رَوَاهُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِهَذَا اللَّفْظِ إِلَّا  سَمُرَةُ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4645","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4652","4646  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَنْهَى إِذَا دُعِيَ الرَّجُلُ إِلَى الطَّعَامِ أَنْ يَدْعُوَ مَعَهُ أَحَدًا  أَوْ آخَرَ إِلَّا أَنْ يَأْمُرَهُ أَهْلُ الطَّعَامِ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  سَمُرَةَ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4646","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4653","4647  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ فِي الْجَنَّةِ  شَجَرَةً  مُسْتَقِلَّةً عَلَى سَاقٍ وَاحِدٍ  ، عَرْضُ سَاقِهَا اثْنَتَيْنِ وَسَبْعِينَ         [10/464]      سَنَةً  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  سَمُرَةَ  بِهَذَا  الْإِسْنَادِ  .  كذا في طبعة مكتبة العلوم والحكم :وقال المحقق: في الكشف ( 4 / 199 ) ثنتان وسبعون. وكذلك أيضا في مجمع الزوائد.","","Musnad al-Bazzar 4647","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4654","4648  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ لَنَا : ""  إِنَّ اسْمَ الرَّجُلِ الْكَرْمُ مِنْ أَجْلِ مَا كَرَّمَهُ اللهُ عَلَى الْخَلِيقَةِ  إِنَّكُمْ تَدْعُونَ الْعِنَبَ ، وَإِنَّمَا اسْمُهُ الْجَوْهَرُ هُوَ الرَّجُلُ وَهُوَ الْكَرْمُ  .  وَهَذَا الْكَلَامُ قَدْ رُوِيَ مَعْنَاهُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَمَّا لَفْظُ الْحَدِيثِ فَلَا نَعْلَمُ رَوَاهُ إِلَّا  سَمُرَةُ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4648","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4655","4649  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  إِنَّ الْفِرْدَوْسَ هِيَ  رَبْوَةُ  الْجَنَّةِ الْوُسْطَى  الَّتِي هِيَ أَرْفَعُهَا وَأَحْسَنُهَا  .","","Musnad al-Bazzar 4649","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4656","4650  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  إِنَّ الرَّجُلَ لَا تَمْتَلِئُ نَفْسُهُ مِنَ الْمَالِ حَتَّى تَمْتَلِئَ مِنَ التُّرَابِ  ، وَلَوْ         [10/465]      لِأَحَدِكُمْ وَادٍ مَلْآنُ مَا بَيْنَ أَعْلَاهُ إِلَى أَسْفَلِهِ أَحَبَّ أَنْ يُمْلَأَ لَهُ وَادٍ آخَرُ ، فَإِنْ مُلِئَ الْوَادِ  الْآخَرُ فَانْطَلَقَ فَوَجَدَ وَادٍ  آخَرَ قَالَ : أَمَا وَاللهِ لَوِ اسْتَطَعْتُ لَمَلَأْتُكَ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  ، وَقَدْ رُوِيَ فِي نَحْوِ كَلَامِهِ بِغَيْرِ لَفْظِهِ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ وُجُوهٍ .  كذا في طبعة مكتبة العلوم والحكم : وقال المحقق: في الكشف 4 / 245: الوادي وهو الصواب  كذا في طبعة مكتبة العلوم والحكم : وقال المحقق: في الكشف : واديا ، وهو الصواب.]","","Musnad al-Bazzar 4650","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4657","4651  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  إِنِّي لَأَجِدُ مِنَ الدَّوَابِّ : الدَّابَّةُ خَيْرٌ مِنْ مِائَةٍ ،  وَمِنَ الرَّجُلِ الرَّجُلُ خَيْرٌ مِنْ مِائَةِ رَجُلٍ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى بِهَذَا اللَّفْظِ إِلَّا عَنْ  سَمُرَةَ  بِهَذَا  الْإِسْنَادِ  ، وَإِنْ كَانَ قَدْ رُوِيَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوٌ مِنْ مَعْنَاهُ .","","Musnad al-Bazzar 4651","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4658","[10/466]      4652  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا غَزَا أَوْ سَافَرَ فَأَقْبَلَ رَاجِعًا إِلَى  الْمَدِينَةِ  ، قَالَ : "" آيِبُونَ حَامِدُونَ  لِرَبِّنَا عَابِدُونَ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4652","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4659","4653  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَنْهَاهُمْ يَوْمَ وَرَدَ  حِجْرَ ثَمُودَ  عَنْ رَكِيَّةٍ عِنْدَ جَانِبِ  الْمَدِينَةِ  أَنْ يَشْرَبَ مِنْهَا أَحَدٌ  أَوْ يَسْتَقِيَ ، وَنَهَانَا أَنْ نَتَوَلَّجَ بُيُوتَهُمْ  .","","Musnad al-Bazzar 4653","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4660","4654  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِيَّاكُمْ  وَالْغُلُوَّ  ! فَإِنَّ  بَنِي إِسْرَائِيلَ  قَدْ غَلَا كَثِيرٌ مِنْهُمْ  حَتَّى كَانَتِ الْمَرْأَةُ الْقَصِيرَةُ تَتَّخِذُ خُفَّيْنِ مِنْ خَشَبٍ فَتَحْشُوهُمَا ، ثُمَّ تُولِجُ فِيهِمَا رِجْلَيْهَا ، ثُمَّ تَقُومُ إِلَى جَنْبِ الْمَرْأَةِ الطَّوِيلَةِ فَتَمْشِي مَعَهَا ، فَإِذَا هِيَ قَدْ سَاوَتْ بِهَا أَوْ كَانَتْ أَطْوَلَ مِنْهَا  .         [10/467]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4654","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4661","4655  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا اسْتَسْقَى لِلْمَطَرِ ، قَالَ : "" اللَّهُمَّ اجْعَلْ فِي أَرْضِنَا  زِينَتَهَا  ، اللَّهُمَّ اجْعَلْ فِي أَرْضِنَا  سَكَنَهَا  .","","Musnad al-Bazzar 4655","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4662","4656  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهُمْ  يَوْمَ الْفَتْحِ  :  إِنَّ هَذَا الْعَامَ  الْحَجُّ  الْأَكْبَرُ  قَدِ اجْتَمَعَ حَجُّ الْمُسْلِمِينَ وَحَجُّ الْمُشْرِكِينَ فِي ثَلَاثَةِ أَيَّامٍ مُتَتَابِعَاتٍ  ، وَاجْتَمَعَ حَجُّ النَّصَارَى وَالْيَهُودِ فِي سِتَّةِ أَيَّامٍ مُتَتَابِعَاتٍ ، وَلَمْ يَجْتَمِعْ مُنْذُ خُلِقَتِ السَّمَاوَاتُ وَالْأَرْضُ ، وَلَا يَجْتَمِعُ بَعْدَ الْعَامِ حَتَّى تَقُومَ السَّاعَةُ  .         [10/468]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا عَنْ  سَمُرَةَ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4656","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4663","4657  -  حَدَّثَنَا  خَالِدُ بْنُ يُوسُفَ بْنِ خَالِدٍ ، قَالَ :  حَدَّثَنِي  أَبِي ،  قَالَ :  نَا  جَعْفَرُ بْنُ سَعْدِ بْنِ سَمُرَةَ ، قَالَ :  حَدَّثَنِي  خُبَيْبُ بْنُ سُلَيْمَانَ بْنِ سَمُرَةَ ،  عَنْ  أَبِيهِ سُلَيْمَانَ بْنِ سَمُرَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ  - رَضِيَ اللهُ عَنْهُ - عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ : ""  غِفَارُ  غَفَرَ  اللهُ لَهَا  ،  وَأَسْلَمُ  سَالَمَهَا  اللهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4657","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4664","4658  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا تَحْلِفُوا  بِالطَّوَاغِي  وَلَا تَحْلِفُوا بِآبَائِكُمْ  وَاحْلِفُوا بِاللهِ  .         [10/469]      وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4658","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4665","4659  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  إِنَّ الْعَرَبَ بَنُو  سَامِ بْنِ نُوحٍ  ،  وَالرُّومُ  بَنُو  يَافِثَ بْنِ نُوحٍ  ،  وَالْحَبَشَةُ  بَنُو  حَامِ بْنِ نُوحٍ  .","","Musnad al-Bazzar 4659","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4666","4660  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  إِذَا قَاتَلَكُمُ الْمُشْرِكُونَ فَاقْتُلُوا شُيُوخَهُمْ  وَاسْتَحْيُوا  شَرْخَهُمْ  .","","Musnad al-Bazzar 4660","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4667","4661  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  لَا تَكْمُلُ شَهْرَيْنِ سِتِّينَ لَيْلَةً  .         [10/470]      وَمَعْنَى هَذَا الْحَدِيثِ مَا قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : ""  شَهْرَا  عِيدٍ لَا  يَنْقُصَانِ  رَمَضَانُ وَذُو الْحِجَّةِ "" ، قَالَ : لَا يَكُونَا ثَمَانِيَةً وَخَمْسِينَ  .","","Musnad al-Bazzar 4661","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4668","4662  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا لَعَنَ الْمُشْرِكِينَ فِي الصَّلَاةِ يَبْدَأُ  بِقُرَيْشٍ  ، ثُمَّ يُتْبِعُهُمْ بَعْدَ ذَلِكَ قَبَائِلَ كَثِيرَةً مِنَ الْعَرَبِ ، فَقِيلَ لَهُ : الْعَنْ كُفَّارَ  قُرَيْشٍ  فَجَعَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ إِذَا أَرَادَ أَنْ يَلْعَنَ : "" اللَّهُمَّ الْعَنْ كُفَّارَ بَنِي فُلَانٍ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُ رَوَاهُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا  سَمُرَةُ  .","","Musnad al-Bazzar 4662","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4669","4663  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّهُ قِيلَ لِي : اقْرَأْ عَلَى  عُمَرَ بْنِ الْخَطَّابِ  فَدَعَا فَأَمَرَهُ أَنْ يَحْضُرَ الْقُرْآنَ إِذَا نَزَلَ لِيَقْرَأَهُ عَلَيْهِ  .         [10/471]      وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى إِلَّا عَنْ  سَمُرَةَ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4663","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4670","4664  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَسْتَغْفِرُ لِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ  وَالْمُسْلِمِينَ وَالْمُسْلِمَاتِ كُلَّ جُمُعَةٍ  .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِهَذَا اللَّفْظِ إِلَّا عَنْ  سَمُرَةَ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4664","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4671","4665  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ لَنَا : ""  إِنَّ  أَبَا بَكْرٍ  يَتَأَوَّلُ الرُّؤْيَا  ، وَالرُّؤْيَا الصَّالِحَةُ حَظٌّ مِنَ النُّبُوَّةِ  .  وَلَا نَعْلَمُ يُرْوَى هَذَا الْكَلَامُ إِلَّا عَنْ  سَمُرَةَ  بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4665","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4672","4666  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ لَنَا : ""  مَنْ قَتَلَ قَتِيلًا فَإِنَّ لَهُ  سَلَبَهُ  .         [10/472]      وَلَا نَعْلَمُ يُرْوَى هَذَا الْكَلَامُ عَنْ  سَمُرَةَ  إِلَّا بِهَذَا الْكَلَامِ .","","Musnad al-Bazzar 4666","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4673","4667  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  مَنْ قُتِلَ مِنْكُمْ صَابِرًا يُقْتَلُ فِي  سَبِيلِ  اللهِ فَإِنَّهُ فِي الْجَنَّةِ  "" .  وَهَذَا الْكَلَامُ لَا نَعْلَمُهُ يُرْوَى عَنْ  سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4667","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4674","4668  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  لَيْسَ فِي الدُّنْيَا  حَسَدٌ  إِلَّا فِي اثْنَتَيْنِ  : رَجُلٌ يَحْسُدُ الرَّجُلَ أَنْ يُعْطِيَهُ الْمَالَ الْكَثِيرَ ، فَيُنْفِقُ مِنْهُ فَيُكْثِرُ النَّفَقَةَ ، فَيَقُولُ الْآخَرُ : لَوْ كَانَ لِي مِثْلُ مَالِ هَذَا لَأَنْفَقْتُ مِثْلَ مَا يُنْفِقُ ، وَلَأُنْفِقُهُ فِي مِثْلِ مَا يُنْفِقُ ، فَهُوَ يَحْسُدُهُ ، وَرَجُلٌ عَلَّمَهُ اللهُ الْقُرْآنَ -  أَحْسِبُهُ قَالَ - فَهُوَ يَقُومُ بِهِ  ، فَيَقُولُ : لَوْ عَلَّمَنِي اللهُ مِثْلَ هَذَا لَقُمْتُ مِثْلَ مَا يَقُومُ  .         [10/473]      وَلَا نَعْلَمُ يُرْوَى هَذَا الْكَلَامُ عَنْ  سَمُرَةَ  إِلَّا بِهَذَا  الْإِسْنَادِ  .","","Musnad al-Bazzar 4668","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4675","4669  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  مَثَلُ الْمَرْأَةِ كَالضِّلَعِ إِنْ أَرَادَ أَنْ يُقِيمَ الضِّلْعَ لَمْ يَسْتَطِعْ  أَنْ يُقِيمَهُ حَتَّى يَكْسِرَهُ وَهِيَ عَوْجَاءُ  .","","Musnad al-Bazzar 4669","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4676","4670  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  إِنَّكُمْ تُحْشَرُونَ إِلَى  بَيْتِ الْمَقْدِسِ  ، ثُمَّ تَجْتَمِعُونَ يَوْمَ الْقِيَامَةِ  .","","Musnad al-Bazzar 4670","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4677","[10/474]      4671  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جَعَلَ شِعَارَ  الْمُهَاجِرِينَ  يَا بَنِي عَبْدِ الرَّحْمَنِ  ، وَشِعَارَ  بَنِي الْخَزْرَجِ  يَا بَنِي عَبْدِ اللهِ ، وَشِعَارَ  الْأَوْسِ  يَا بَنِي عُبَيْدِ اللهِ  .","","Musnad al-Bazzar 4671","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4678","4672  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ لَنَا : ""  يَدْخُلُ الْجَنَّةَ سَبْعُونَ أَلْفًا بِغَيْرِ حِسَابٍ  -  أَحْسِبُهُ قَالَ - مِنْ هَذِهِ الْأُمَّةِ  .","","Musnad al-Bazzar 4672","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4679","4673  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَأْمُرُنَا إِذَا فَزِعْنَا بِالْجَمَاعَةِ وَالصَّبْرِ  وَالسَّكِينَةِ وَإِذَا قَاتَلْنَا  .","","Musnad al-Bazzar 4673","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4680","4674  -  حَدَّثَنَا  خَالِدُ بْنُ يُوسُفَ بْنِ خَالِدٍ ، قَالَ :  نَا  أَبِي ،  قَالَ :  نَا  جَعْفَرُ بْنُ سَعْدٍ ، قَالَ :  نَا  خُبَيْبُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ سُلَيْمَانَ بْنِ سَمُرَةَ ،  عَنْ  سَمُرَةَ بْنِ جُنْدُبٍ  - رَضِيَ اللهُ عَنْهُ - أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ         [10/475]      عَلَيْهِ وَسَلَّمَ -  كَانَ يَنْهَى رَبَّ النَّخْلِ أَنْ يَتَدَيَّنَ فِي  ثَمَرَةِ  نَخْلِهِ حَتَّى يُؤْكَلَ مِنْ  ثَمَرِهَا  ؛  مَخَافَةَ أَنْ يَتَدَيَّنَ بِدَيْنٍ كَثِيرٍ ، ثُمَّ تَفْسُدُ  الثَّمَرَةُ  ، وَكَانَ يَنْهَى رَبَّ الزَّرْعِ أَنْ لَا يَدَّانَ فِي زَرْعِهِ حَتَّى يَبْلُغَ الْحَصَادَ  .","","Musnad al-Bazzar 4674","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4681","4675  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ لَنَا : ""  وَاللهِ مَا يَسُرُّنِي أَنَّ لِي  أُحُدًا  ذَهَبًا كُلَّهُ  .","","Musnad al-Bazzar 4675","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4682","4676  -  وَبِإِسْنَادِهِ  أَنَّ الرَّسُولَ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَتَاهُ  رَجُلٌ  يَسْتَفْتِيهِ فِي أَكْلِ الضَّبِّ ، فَقَالَ :  لَسْتُ آمُرُ بِهِ وَلَا أَنْهَى عَنْهُ  .","","Musnad al-Bazzar 4676","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4683","4677  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَانَا عَنِ         [10/476]      الْحِمَارِ الْأَهْلِيِّ  ، وَأَمَرَنَا بِإِلْقَاءِ مَا مَعَنَا مِنْهُ فَأَلْقَيْنَاهُ  .","","Musnad al-Bazzar 4677","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4684","4678  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : ""  إِنَّ لِأَحَدِكُمْ يَوْمَ يَمُوتُ ثَلَاثَةَ أَخِلَّاءٍ  مِنْهُمْ مَنْ يَمْنَعُهُ مَا سَأَلَهُ فَذَلِكَ مَالُهُ ، وَمِنْهُمْ  خَلِيلٌ  يَنْطَلِقُ مَعَهُ حَتَّى يَلِجَ الْقَبْرَ لَا يُعْطِيهِ شَيْئًا وَلَا يَمْنَعُهُ فَأُولَئِكَ قَرَابَتُهُ ، وَمِنْهُمْ  خَلِيلٌ  يَقُولُ : أَنَا مَعَكَ أَذْهَبُ مَعَكَ حَيْثُ ذَهَبْتَ وَلَسْتُ بِمُفَارِقِكَ أَبَدًا فَذَلِكَ عَمَلُهُ ، إِنْ كَانَ خَيْرًا وَإِنْ كَانَ شَرًّا  .","","Musnad al-Bazzar 4678","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4685","4679  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَنْهَى أَنْ  يَقُدَّ  الرَّجُلُ السَّيْرَ بَيْنَ أُصْبُعَيْهِ  ، أَوْ كَانَ يَنْهَى أَحَدَنَا أَنْ  يُقَدَّ  السَّيْرُ بَيْنَ أُصْبُعَيْهِ  .","","Musnad al-Bazzar 4679","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4686","4680  -  وَبِإِسْنَادِهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ : ""  إِذَا طَالَبَ الرَّجُلُ الْآخَرَ فَدَعَا أَحَدُهُمَا صَاحِبَهُ  إِلَى الَّذِي يَقْضِي بَيْنَهُمَا فَأَبَى أَنْ يَجِيءَ فَلَا حَقَّ لَهُ  .","","Musnad al-Bazzar 4680","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4687","[10/477]      4682  -  وَبِإِسْنَادِهِ  عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  كَانَ إِذَا مُطِرْنَا فِي السَّفَرِ وَنُودِيَ بِالصَّلَاةِ يَأْمُرُ الْمُؤَذِّنَ فَيُنَادِي : صَلُّوا فِي رِحَالِكُمْ  ; كَرَاهِيَةَ أَنْ يَشُقَّ عَلَيْنَا  .  آخِرُ  مُسْنَدِ  سَمُرَةَ  وَهُوَ آخِرُ السَّابِعِ وَالثَّلَاثِينَ وَالْحَمْدُ لِلهِ كَثِيرًا كَمَا هُوَ أَهْلُهُ ، ثُمَّ  الصَّلَاةُ عَلَى  مُحَمَّدٍ  نَبِيِّهِ وَعَبْدِهِ وَسَلَّمَ","","Musnad al-Bazzar 4682","","سمرة بن جندب عن سليمان بن سمرة بن جندب عن خبيب بن سليمان بن سمرة بن جندب عن جعفر بن سعد بن سمرة بن جندب الفزاري عن يوسف بن خالد السمتي عن خالد بن يوسف بن خالد السمتي عن البزار","مسند سمرة بن جندب رضي الله عنه"
"4688","[11/11]      مُسْنَدُ  ابْنِ عَبَّاسٍ  رَضِيَ اللهُ عَنْهُمَا         [11/12]      مَا رَوَى  جَابِرُ بْنُ عَبْدِ اللهِ  ، عَنِ  ابْنِ عَبَّاسٍ  4682  -  أَخْبَرَنَا  أَبُو الْحَسَنِ مُحَمَّدُ بْنُ أَيُّوبَ بْنِ حَبِيبٍ الرَّقِّيُّ ، قَالَ :  نَا  أَبُو بَكْرٍ أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ ، قَالَ :  نَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ :  نَا  أَزْهَرُ بْنُ سَعْدٍ  عَنْ  سُلَيْمَانَ التَّيْمِيِّ  عَنْ  خِدَاشٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ  عَنِ  ابْنِ عَبَّاسٍ .","","Musnad al-Bazzar 4682","","عبد الله بن عباس عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن خداش بن عياش العبدي عن سليمان بن طرخان عن أزهر بن سعد السمان عن إبراهيم بن سعيد الجوهري عن البزار","ما روى جابر بن عبد الله عن ابن عباس"
"4689","4683  -  وَحَدَّثَنَا  بِشْرُ بْنُ آدَمَ ، قَالَ :  نَا  جَدِّي أَزْهَرُ بْنُ سَعْدٍ  عَنْ  سُلَيْمَانَ التَّيْمِيِّ  عَنْ  خِدَاشٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمْ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيَدْخُلَنَّ الْجَنَّةَ مَنْ بَايَعَ تَحْتَ  الشَّجَرَةِ  إِلَّا صَاحِبَ الْجَمَلِ الْأَحْمَرِ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا رَوَاهُ فَقَالَ عَنْ  جَابِرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  إِلَّا         [11/13]      أَزْهَرُ  عَنِ  التَّيْمِيِّ  عَنْ  خِدَاشٍ  ، وَلَا نَعْلَمُ أَحَدًا  تَابَعَهُ  عَلَيْهِ وَلَمْ يَرْوِ  جَابِرٌ  ، عَنِ  ابْنِ عَبَّاسٍ  إِلَّا حَدِيثَيْنِ بِهَذَا  الْإِسْنَادِ  جَمِيعًا رَوَاهُمَا  أَزْهَرُ  .","","Musnad al-Bazzar 4683","","عبد الله بن عباس عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن خداش بن عياش العبدي عن سليمان بن طرخان عن أزهر بن سعد السمان عن بشر بن آدم بن يزيد عن البزار","ما روى جابر بن عبد الله عن ابن عباس"
"4690","4684  -  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ :  نَا  أَزْهَرُ  عَنْ  سُلَيْمَانَ التَّيْمِيِّ  عَنْ  خِدَاشٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  عَنِ  ابْنِ عَبَّاسٍ .","","Musnad al-Bazzar 4684","","عبد الله بن عباس عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن خداش بن عياش العبدي عن سليمان بن طرخان عن أزهر بن سعد السمان عن إبراهيم بن سعيد الجوهري عن البزار","ما روى جابر بن عبد الله عن ابن عباس"
"4691","4685  -  وَحَدَّثَنَا  بِشْرُ بْنُ آدَمَ قَالَ  حَدَّثَنِي  جَدِّي أَزْهَرُ بْنُ سَعْدٍ  عَنْ  سُلَيْمَانَ التَّيْمِيِّ  عَنْ  خِدَاشٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  جَابِرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، رَضِيَ اللهُ عَنْهُمْ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :         [11/14]      إِذَا اسْتَلْقَى أَحَدُكُمْ فَلَا يَضَعْ إِحْدَى رِجْلَيْهِ عَلَى الْأُخْرَى  .  وَهَذَا الْحَدِيثُ رَوَاهُ غَيْرُ وَاحِدٍ عَنْ  جَابِرٍ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلَمْ يَقُلْ أَحَدٌ عَنْ  جَابِرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  إِلَّا  أَزْهَرُ  عَنِ  التَّيْمِيِّ  عَنْ  خِدَاشٍ  وَخِدَاشٌ  لَا نَعْلَمُ رَوَى عَنْهُ إِلَّا  التَّيْمِيُّ  وَمُحَمَّدُ بْنُ ثَابِتٍ الْعَصْرِيُّ  وَخِدَاشٌ  بَصْرِيٌّ  .","","Musnad al-Bazzar 4685","","عبد الله بن عباس عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو الزبير المكي عن خداش بن عياش العبدي عن سليمان بن طرخان عن أزهر بن سعد السمان عن بشر بن آدم بن يزيد عن البزار","ما روى جابر بن عبد الله عن ابن عباس"
"4692","[11/15]      أَنَسٌ  ، عَنِ  ابْنِ عَبَّاسٍ  4686  -  حَدَّثَنَا  بِشْرُ بْنُ آدَمَ وَمُحَمَّدُ بْنُ يَحْيَى الْقُطَعِيُّ قَالَا :  نَا  عَبْدُ الصَّمَدِ ، قَالَ :  نَا  هِشَامٌ  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ  أَنَّ  عَلِيًّا  - رَضِيَ اللهُ عَنْهُ - أُتِيَ بِنَاسٍ مِنَ  الزُّطِّ  فَأَرَادَ أَنْ يُحَرِّقَهُمْ فَقَالَ ابْنُ عَبَّاسٍ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ بَدَّلَ دِينَهُ فَاقْتُلُوهُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ إِلَّا  عَبْدُ الصَّمَدِ  وَلَا  أَسْنَدَ  أَنَسٌ  ، عَنِ  ابْنِ عَبَّاسٍ  إِلَّا هَذَا الْحَدِيثَ  .","","Musnad al-Bazzar 4686","","عبد الله بن عباس عن أنس بن مالك عن قتادة بن دعامة عن هشام الدستوائي عن عبد الصمد بن عبد الوارث التنوري عن محمد بن يحيى بن أبي حزم القطعي عن البزار","أنس عن ابن عباس"
"4693","[11/16]      أَبُو الطُّفَيْلِ  ، عَنِ  ابْنِ عَبَّاسٍ  4687  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  نَا  فِطْرٌ ،  عَنْ  أَبِي الطُّفَيْلِ قَالَ :  قُلْتُ  لِابْنِ عَبَّاسٍ : إِنَّ قَوْمَكَ يَزْعُمُونَ أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدْ  رَمَلَ  وَأَنَّهَا سُنَّةٌ فَقَالَ : كَذَبُوا وَصَدَقُوا  قَدْ  رَمَلَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَلَيْسَتْ سُنَّةً  قَدِمَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَالْمُشْرِكُونَ عَلَى  جَبَلِ  قُعَيْقِعَانَ  فَبَلَغَهُ أَنَّهُمْ يَقُولُونَ : إِنَّ بِرَسُولِ اللهِ وَأَصْحَابِهِ هَزْلًا فَرَمَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَأَمَرَ أَصْحَابَهُ لِيَرْمُلُوا لِيَرَى الْمُشْرِكُونَ أَنَّ بِهِمْ قُوَّةً  .","","Musnad al-Bazzar 4687","","عبد الله بن عباس عن عامر بن واثلة عن فطر بن خليفة عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","أبو الطفيل عن ابن عباس"
"4694","4688  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مَهْدِيٍّ قَالَ :  أَنَا  عَبْدُ الرَّزَّاقِ قَالَ :  أَنَا  مَعْمَرٌ  عَنِ  ابْنِ خُثَيْمٍ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ         [11/17]      عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 4688","","عبد الله بن عباس عن عامر بن واثلة عن عبد الله بن عثمان بن خثيم عن معمر بن راشد عن عبد الرزاق الصنعاني عن الحسين بن مهدي الأبلي عن البزار","أبو الطفيل عن ابن عباس"
"4695","4689  -  وَحَدَّثَنَاهُ  نَصْرُ بْنُ عَلِيٍّ قَالَ :  أَنَا  عَبْدُ الْأَعْلَى ، قَالَ :  نَا  الْجُرَيْرِيُّ ،  عَنْ  أَبِي الطُّفَيْلِ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِنَحْوِ حَدِيثِ  فِطْرٍ  ، عَنْ  أَبِي الطُّفَيْلِ  ، عَنِ  ابْنِ عَبَّاسٍ  فِي قُدُومِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَكَّةَ  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنِ  ابْنِ عَبَّاسٍ  مِنْ وُجُوهٍ وَرُوِيَ عَنْ  أَبِي الطُّفَيْلِ  ، عَنِ  ابْنِ عَبَّاسٍ  مِنْ غَيْرِ وَجْهٍ وَفِيمَنْ ذَكَرْنَا مُقْنِعٌ إِلَّا أَنَّ  يَزِيدَ  غَيْرُ مَنْ ذَكَرْنَا كَلَامًا فَيَكْتُبُ مِنْ أَجْلِ الزِّيَادَةِ  .","","Musnad al-Bazzar 4689","","عبد الله بن عباس عن عامر بن واثلة عن سعيد بن إياس الجريري عن عبد الأعلى بن عبد الأعلى القرشي عن نصر بن علي بن نصر الجهضمي عن البزار","أبو الطفيل عن ابن عباس"
"4696","4690  -  حَدَّثَنَا  بِشْرُ بْنُ مُعَاذٍ الْعَقَدِيُّ ، قَالَ :  نَا  فُضَيْلُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ خُثَيْمٍ  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ وَأَبِي الطُّفَيْلِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمْ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَظَرَ إِلَى  مَكَّةَ  فَقَالَ :  إِنَّكِ لَأَحَبُّ أَرْضِ اللهِ إِلَى اللهِ وَلَوْلَا أَنَّ قَوْمِي أَخْرَجُونِي مِنْكِ مَا خَرَجْتُ  .         [11/18]      وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنْ  أَبِي هُرَيْرَةَ  وَغَيْرِهِ ،  وَلَا نَعْلَمُهُ يُرْوَى عَنِ  ابْنِ عَبَّاسٍ  بِإِسْنَادٍ  أَحْسَنَ مِنْ هَذَا  الْإِسْنَادِ  ، وَقَدْ قَالَ بَعْضُ مَنْ رَوَاهُ عَنِ  ابْنِ خُثَيْمٍ  : عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  ، عَنِ  ابْنِ عَبَّاسٍ  وَلَمْ يَذْكُرْ  أَبَا الطُّفَيْلِ  وَجَمَعَهُمَا  بِشْرٌ  عَنْ  فُضَيْلٍ  .","","Musnad al-Bazzar 4690","","عبد الله بن عباس عن عامر بن واثلة عن عبد الله بن عثمان بن خثيم عن فضيل بن سليمان النميري عن بشر بن معاذ عن البزار","أبو الطفيل عن ابن عباس"
"4697","4691  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ مَهْدِيٍّ قَالَ :  أَنَا  عَبْدُ الرَّزَّاقِ قَالَ :  أَنَا  مَعْمَرٌ  عَنِ  ابْنِ خُثَيْمٍ ،  عَنْ  أَبِي الطُّفَيْلِ قَالَ :  قَالَ  ابْنُ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُ -  إِنَّمَا  اسْتَلَمَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الْحَجَرَ الْأَسْوَدَ  وَالرُّكْنَ الْيَمَانِيَ فَقَالَ  مُعَاوِيَةُ  : لَيْسَ مِنَ  الْبَيْتِ  شَيْئًا مَهْجُورًا  وَاسْتَلَمَ  الْأَرْكَانَ كُلَّهَا  .         [11/19]      وَهَذَا الْحَدِيثُ قَدْ رُوِيَ نَحْوُ كَلَامِهِ عَنْ غَيْرِ  ابْنِ عَبَّاسٍ  ، وَقَدْ رُوِيَ عَنِ  ابْنِ عَبَّاسٍ  مِنْ غَيْرِ هَذَا الْوَجْهِ ، وَهَذَا  الْإِسْنَادُ  أَحْسَنُ إِسْنَادٍ  يُرْوَى فِي ذَلِكَ ، عَنِ  ابْنِ عَبَّاسٍ  .  كذا في طبعة مكتبة العلوم والحكم : وقال المحقق:وقال المحقق: هكذا بالأصل ، والصواب ( شيء مهجور ) .","","Musnad al-Bazzar 4691","","عبد الله بن عباس عن عامر بن واثلة عن عبد الله بن عثمان بن خثيم عن معمر بن راشد عن عبد الرزاق الصنعاني عن الحسين بن مهدي الأبلي عن البزار","أبو الطفيل عن ابن عباس"
"4698","[11/20]      سَعِيدُ بْنُ الْمُسَيِّبِ  ، عَنِ  ابْنِ عَبَّاسٍ  4692  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى أَبُو مُوسَى ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 4692","","عبد الله بن عباس عن سعيد بن المسيب عن قتادة بن دعامة عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو موسى الزمن عن البزار","سعيد بن المسيب عن ابن عباس"
"4699","4693  -  وَحَدَّثَنَا  أَبُو مُوسَى ، قَالَ :  نَا  ابْنُ أَبِي عَدِيٍّ  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 4693","","عبد الله بن عباس عن سعيد بن المسيب عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن البزار","سعيد بن المسيب عن ابن عباس"
"4700","4694  -  حَدَّثَنَا  أَبُو مُوسَى ، قَالَ :  نَا  الْوَلِيدُ بْنُ مُسْلِمٍ قَالَ :  نَا         [11/21]      الْأَوْزَاعِيُّ  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 4694","","عبد الله بن عباس عن سعيد بن المسيب عن أبو جعفر الباقر عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن أبو موسى الزمن عن البزار","سعيد بن المسيب عن ابن عباس"
"4701","4694  (م)  -  وَحَدَّثَنَا  عُمَرُ بْنُ الْخَطَّابِ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ صَالِحٍ ، قَالَ :  نَا  بَكْرُ بْنُ مُضَرَ  عَنْ  عُمَرَ  بْنِ الْحَارِثِ  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمْ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْعَائِدُ فِي هِبَتِهِ كَالْعَائِدِ فِي قَيْئِهِ  .         [11/22]      وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنِ  ابْنِ عَبَّاسٍ  مِنْ وُجُوهٍ ، وَهَذِهِ  الْأَسَانِيدُ  أَحْسَنُ أَسَانِيدَ  تُرْوَى عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  ، عَنِ  ابْنِ عَبَّاسٍ  وَأَجَلُّ مَنْ رَوَى هَذَا الْحَدِيثَ عَنِ  ابْنِ عَبَّاسٍ  سَعِيدُ بْنُ الْمُسَيِّبِ  .  كذا في طبعة مكتبة العلوم والحكم ، ولعل الصواب: (عمرو ) .","","Musnad al-Bazzar 4694","","عبد الله بن عباس عن سعيد بن المسيب عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن بكر بن مضر المصري عن عبد الله بن صالح المصري عن عمر بن الخطاب السجستاني عن البزار","سعيد بن المسيب عن ابن عباس"
"4702","4695  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَانِي ، قَالَ :  نَا  مُحَمَّدُ بْنُ عُثْمَانَ أَبُو الْجُمَاهِرِ ، قَالَ :  نَا  خُلَيْدُ بْنُ دَعْلَجٍ  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ  فَارَقَ  الْجَمَاعَةَ قِيَاسَ ، أَوْ  قِيدَ  شِبْرٍ- فَقَدْ خَلَعَ  رِبْقَةَ  الْإِسْلَامِ مِنْ عُنُقِهِ  ، وَمَنْ مَاتَ لَيْسَ عَلَيْهِ إِمَامٌ فَمِيتَتُهُ  مِيتَةٌ  جَاهِلِيَّةٌ ، وَمَنْ مَاتَ تَحْتَ رَايَةٍ  عِمِّيَّةٍ  يَدْعُو إِلَى عَصَبَةٍ ، أَوْ يَنْصُرُ عَصَبَةً فَقِتْلَتُهُ قِتْلَةٌ جَاهِلِيَّةٌ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنِ  ابْنِ عَبَّاسٍ  مِنْ هَذَا الْوَجْهِ بِهَذَا  الْإِسْنَادِ  ، وَلَا نَعْلَمُ رَوَى هَذَا الْحَدِيثَ إِلَّا  خُلَيْدُ بْنُ دَعْلَجٍ ،  وَخُلَيْدٌ  رَجُلٌ مَشْهُورٌ حَدَّثَ عَنْهُ  الْوَلِيدُ بْنُ مُسْلِمٍ  وَأَبُو الْجُمَاهِرِ  وَالنُّفَيْلِيُّ  وَغَيْرُهُمْ  .","","Musnad al-Bazzar 4695","","عبد الله بن عباس عن سعيد بن المسيب عن قتادة بن دعامة عن خليد بن دعلج السدوسي عن محمد بن عثمان الكفرسوسي عن إبراهيم بن هانئ الأغياني عن البزار","سعيد بن المسيب عن ابن عباس"
"4703","4696  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَانِئٍ ، قَالَ :  نَا  يَحْيَى بْنُ عُثْمَانَ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ سُلَيْمَانَ ،  عَنْ  أَبِي سَعْدٍ  عَنْ         [11/23]      مُعَاوِيَةَ بْنِ إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ مَشَى إِلَى غَرِيمِهِ بِحَقِّهِ صَلَّتْ عَلَيْهِ دَوَابُّ الْأَرْضِ وَنُونُ الْمَاءِ  وَنَبَتَتْ لَهُ بِكُلِّ خُطْوَةٍ  شَجَرَةٌ  تُغْرَسُ فِي الْجَنَّةِ وَذَنْبٌ يُغْفَرُ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِلَّا  ابْنُ عَبَّاسٍ  ، وَلَا نَعْلَمُ لَهُ طَرِيقًا غَيْرَ هَذَا الطَّرِيقِ .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : ( أبي سعيد )","","Musnad al-Bazzar 4696","","عبد الله بن عباس عن سعيد بن المسيب عن معاوية بن إسحاق بن طلحة التيمي عن الربيع أبو سعيد النصري عن عبد الرحمن بن سليمان الداراني عن إسماعيل بن عياش الأحول عن يحيى بن عثمان عن إبراهيم بن هانئ الأغياني عن البزار","سعيد بن المسيب عن ابن عباس"
"4704","[11/24]      4697  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَرْزُوقٍ ، قَالَ :  نَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَ :  نَا  أَبَانُ بْنُ يَزِيدَ قَالَ :  نَا  قَتَادَةُ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ وَعِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ وَفْدَ  عَبْدِ الْقَيْسِ  أَتَوْا نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالُوا : يَا رَسُولَ اللهِ إِنَّا نَاسٌ مِنْ  رَبِيعَةَ  ، وَإِنَّ بَيْنَنَا وَبَيْنَكَ كُفَّارَ  مُضَرَ  وَإِنَّا لَا نَصِلُ إِلَيْكَ إِلَّا فِي شَهْرٍ حَرَامٍ فَمُرْنَا بِأَمْرٍ إِذَا عَمِلْنَاهُ دَخَلْنَا الْجَنَّةَ وَنَدْعُو إِلَيْهِ مَنْ وَرَاءَنَا  فَأَمَرَهُمْ وَنَهَاهُمْ عَنْ أَرْبَعٍ : أَنْ يَعْبُدُوا اللهَ لَا يُشْرِكُوا بِهِ شَيْئًا وَيُقِيمُوا الصَّلَاةَ وَيُؤْتُوا الزَّكَاةَ وَيَصُومُوا رَمَضَانَ  وَيَحُجُّوا  الْبَيْتَ  وَيُعْطُوا الْخُمُسَ مِنَ الْمَغَانِمِ وَنَهَاهُمْ عَنِ الْحَنَاتِمِ  وَالدُّبَّاءِ  وَالْمُزَفَّتِ  وَالنَّقِيرِ  فَقَالُوا : فِيمَ نَشْرَبُ ؟ قَالَ : اشْرَبُوا عَلَى الَّتِي  يُلَاثُ  عَلَى أَفْوَاهِهَا  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ رَوَاهُ عَنْ  قَتَادَةَ  ، عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  وَعِكْرِمَةَ  ، عَنِ  ابْنِ عَبَّاسٍ  إِلَّا  أَبَانُ بْنُ يَزِيدَ  .","","Musnad al-Bazzar 4697","","عبد الله بن عباس عن سعيد بن المسيب عن قتادة بن دعامة عن أبان بن يزيد العطار عن مسلم بن إبراهيم الشحام عن محمد بن محمد بن مرزوق الباهلي عن البزار","سعيد بن المسيب عن ابن عباس"
"4705","[11/25]      طَاوُسٌ  ، عَنِ  ابْنِ عَبَّاسٍ  4698  -  حَدَّثَنَا  أَبُو كَامِلٍ الْفُضَيْلُ بْنُ الْحُسَيْنِ الْجَحْدَرِيُّ ، قَالَ :  نَا  عَبْدُ الْوَارِثِ ، يَعْنِي: ابْنَ سَعِيدٍ ،  عَنْ  أَيُّوبَ  عَنْ  عَمْرِو بْنِ دِينَارٍ  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 4698","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن أيوب السختياني عن عبد الوارث بن سعيد بن ذكوان عن فضيل بن حسين الجحدري عن البزار","طاوس عن ابن عباس"
"4706","4699  -  وَحَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ ، قَالَ :  نَا  سُفْيَانُ  عَنْ  عَمْرِو بْنِ دِينَارٍ  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ اشْتَرَى طَعَامًا فَلَا يَبِعْهُ حَتَّى يَقْبِضَهُ  .  وَهَذَا الْحَدِيثُ قَدْ رَوَاهُ غَيْرُ وَاحِدٍ عَنْ  طَاوُسٍ  ، وَرَوَاهُ جَمَاعَةٌ عَنْ  عَمْرِو بْنِ دِينَارٍ  عَنْ  طَاوُسٍ  فَاقْتَصَرْنَا عَلَى مَنْ سَمَّيْنَا دُونَ غَيْرِهِ  .","","Musnad al-Bazzar 4699","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان الثوري عن عبد الرحمن بن مهدي عن الفلاس عن البزار","طاوس عن ابن عباس"
"4707","4700  -  وَحَدَّثَنَا  الْمُنْذِرُ بْنُ الْوَلِيدِ الْجَارُودِيُّ ، قَالَ :  نَا  أَبِي  عَنِ  الْحَسَنِ         [11/26]      بْنِ أَبِي جَعْفَرٍ  عَنْ  أَيُّوبَ  عَنْ  عَمْرِو بْنِ دِينَارٍ  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 4700","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن أيوب السختياني عن الحسن بن أبي جعفر الجفري عن الوليد بن عبد الرحمن بن حبيب الجارودي عن المنذر بن الوليد بن عبد الرحمن الجارودي عن البزار","طاوس عن ابن عباس"
"4708","4701  -  وَحَدَّثَنَاهُ  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  مُحَمَّدُ بْنُ جَعْفَرٍ قَالَ :  نَا  شُعْبَةُ ،  عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 4701","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن شعبة بن الحجاج عن غندر ربيب شعبة عن الفلاس عن البزار","طاوس عن ابن عباس"
"4709","4702  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ :  نَا  حَمَّادٌ ، يَعْنِي : ابْنَ زَيْدٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 4702","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن زيد عن محمد بن عبد الله بن محمد بن عبد الملك الرقاشي عن البزار","طاوس عن ابن عباس"
"4710","[11/27]      4703  -  وَحَدَّثَنَاهُ  أَبُو كَامِلٍ ، قَالَ :  نَا  أَبُو عَوَانَةَ  عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  أُمِرْتُ أَنْ أَسْجُدَ عَلَى سَبْعَةٍ  ، وَلَا  أَكُفَّ  شَعَرًا وَلَا ثَوْبًا  .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ وُجُوهٍ بِأَلْفَاظٍ مُخْتَلِفَةٍ ، وَرُوِيَ عَنِ  ابْنِ عَبَّاسٍ  مِنْ غَيْرِ وَجْهٍ ، وَرَوَاهُ عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ  جَمَاعَةٌ فَاجْتَزَأْنَا بِمَنْ ذَكَرْنَا وَاسْتَغْنَيْنَا بِهِ عَنْ غَيْرِهِ  .","","Musnad al-Bazzar 4703","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن الوضاح بن عبد الله اليشكري عن فضيل بن حسين الجحدري عن البزار","طاوس عن ابن عباس"
"4711","4704  -  حَدَّثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ ، قَالَ :  نَا  أَبِي عَبْدُ الْوَارِثِ  عَنْ  أَيُّوبَ  عَنْ  عَمْرِو بْنِ دِينَارٍ  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  لَمْ يَنْهَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ كِرَى الْأَرْضِ  ، وَلَكِنْ قَالَ : لَأَنْ  يَمْنَحَ  الرَّجُلُ أَخَاهُ أَرْضَهُ خَيْرٌ لَهُ مِنْ أَنْ يَأْخُذَ عَلَيْهَا خَرْجًا  .         [11/28]","","Musnad al-Bazzar 4704","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن أيوب السختياني عن عبد الصمد بن عبد الوارث التنوري عن عبد الوارث بن عبد الصمد التنوري عن البزار","طاوس عن ابن عباس"
"4712","4705  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ  عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ .  وَهَذَا الْحَدِيثُ قَدْ رُوِيَ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ نَحْوُهُ مِنْ وُجُوهٍ ، وَهَذَا مِنْ  أَحْسَنِ الْأَسَانِيدِ  الَّتِي تُرْوَى فِي ذَلِكَ  .","","Musnad al-Bazzar 4705","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن زيد عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","طاوس عن ابن عباس"
"4713","4706  -  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ وَعَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  سُفْيَانُ بْنُ عُيَيْنَةَ  عَنْ  عَمْرِو بْنِ دِينَارٍ  عَنْ  عَطَاءٍ وَطَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ احْتَجَمَ وَهُوَ مُحْرِمٌ  .         [11/29]      وَاللَّفْظُ فِي هَذَا الْحَدِيثِ لَفْظُ  عَمْرِو بْنِ عَلِيٍّ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا يَرْوِيهِ عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ  إِلَّا  ابْنُ عُيَيْنَةَ  ، وَقَدْ رُوِيَ عَنِ  ابْنِ عَبَّاسٍ  مِنْ غَيْرِ وَجْهٍ ، وَعَنْ غَيْرِ  ابْنِ عَبَّاسٍ  أَيْضًا  .","","Musnad al-Bazzar 4706","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن الفلاس عن البزار","طاوس عن ابن عباس"
"4714","4707  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  نَا  ابْنُ عُيَيْنَةَ  عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَنْ بَيْعِ الثِّمَارِ حَتَّى يُطْعَمَ  .  وَهَذَا الْحَدِيثُ رَوَاهُ غَيْرُ  عُبَيْدِ اللهِ  ، عَنِ  ابْنِ عُيَيْنَةَ  عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ  مُرْسَلًا  .","","Musnad al-Bazzar 4707","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن عبيد الله بن موسى عن يوسف بن موسى بن راشد عن البزار","طاوس عن ابن عباس"
"4715","[11/30]      4708  -  وَحَدَّثَنَا  عَمْرُو بْنُ يَحْيَى بْنِ غُفْرَةَ الْبَجَلِيُّ ، قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ  عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  كُلُّ شَرْطٍ لَيْسَ فِي كِتَابِ اللهِ فَهُوَ بَاطِلٌ  ، وَإِنْ كَانَ مِائَةَ شَرْطٍ  .","","Musnad al-Bazzar 4708","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن زيد عن عمرو بن يحيى بن غفرة البجلي عن البزار","طاوس عن ابن عباس"
"4716","4709  -  وَحَدَّثَنَاهُ  أَحْمَدُ بْنُ عَبْدَةَ ، قَالَ :  نَا  سُفْيَانُ  عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  وَلَمْ يَذْكُرِ  ابْنَ عَبَّاسٍ  ، وَلَا نَعْلَمُ أَحَدًا  تَابَعَ  عَمْرَو بْنَ يَحْيَى  عَلَى رِوَايَتِهِ عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ  ، عَنِ  ابْنِ عَبَّاسٍ  . وَهَذَا الْكَلَامُ يُرْوَى عَنْ غَيْرِ  ابْنِ عَبَّاسٍ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Musnad al-Bazzar 4709","","طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن البزار","طاوس عن ابن عباس"
"4717","4710  -  وَحَدَّثَنَا حَوْثَرَةُ بْنُ مُحَمَّدٍ الْمِنْقَرِيُّ مِنْ كِتَابِهِ  ، قَالَ :  نَا  سُفْيَانُ         [11/31]      بْنُ عُيَيْنَةَ  عَنْ  عَمْرِو بْنِ دِينَارٍ  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  عَرَفَةُ  كُلُّهَا مَوْقِفٌ  وَمِنًى  كُلُّهَا مَنْحَرٌ  .","","Musnad al-Bazzar 4710","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن حوثرة بن محمد بن قديد الوراق عن البزار","طاوس عن ابن عباس"
"4718","4711  -  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَبْدَةَ قَالَ :  أَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ  عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، بِنَحْوِهِ . وَلَمْ يَقُلْ ، عَنِ  ابْنِ عَبَّاسٍ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا قَالَ : عَنْ  طَاوُسٍ  ، عَنِ  ابْنِ عَبَّاسٍ  إِلَّا  حَوْثَرَةُ  ، وَلَا نَعْلَمُ أَحَدًا  تَابَعَهُ  عَلَيْهِ وَالْحَدِيثُ  مَشْهُورٌ  ، عَنِ  ابْنِ عَبَّاسٍ  عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُرْوَى مِنْ وُجُوهٍ إِلَّا أَنَّهُ لَا يُرْوَى عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ  إِلَّا مِنْ هَذَا الْوَجْهِ  .","","Musnad al-Bazzar 4711","","طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن البزار","طاوس عن ابن عباس"
"4719","4712  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ، قَالَ :  نَا  يُونُسُ بْنُ         [11/32]      مُحَمَّدٍ ، قَالَ :  نَا  حَمَّادُ بْنُ زَيْدٍ  عَنْ  عَمْرِو بْنِ دِينَارٍ  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ  أَعْرَابِيًّا  أَهْدَى إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَعْطَاهُ فَقَالَ لَهُ : أَرَضِيتَ ؟ قَالَ :لَا ، ثُمَّ زَادَهُ فَقَالَ : رَضِيتَ ؟ قَالَ : لَا ، ثُمَّ زَادَهُ فَقَالَ : رَضِيتَ ؟ قَالَ : نَعَمْ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَقَدْ هَمَمْتُ أَلَّا  أَتَّهِبَ  هِبَةً إِلَّا مِنْ قُرَشِيٍّ ، أَوْ أَنْصَارِيٍّ ، أَوْ ثَقَفِيٍّ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُ أَحَدًا قَالَ عَنْ  طَاوُسٍ  ، عَنِ  ابْنِ عَبَّاسٍ  إِلَّا  يُونُسُ بْنُ مُحَمَّدٍ  ، عَنْ  حَمَّادِ بْنِ زَيْدٍ  ، وَرَوَاهُ  ابْنُ عُيَيْنَةَ  .","","Musnad al-Bazzar 4712","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن حماد بن زيد عن يونس بن محمد بن مسلم البغدادي عن إبراهيم بن سعيد الجوهري عن البزار","طاوس عن ابن عباس"
"4720","4713  -  نَاهُ  أَحْمَدُ بْنُ عَبْدَةَ  عَنِ  ابْنِ عُيَيْنَةَ  عَنْ  عَمْرٍو  عَنْ  طَاوُسٍ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  وَلَا نَعْلَمُ يُرْوَى هَذَا الْكَلَامُ عَنِ  ابْنِ عَبَّاسٍ  إِلَّا مِنْ هَذَا الْوَجْهِ وَلَا نَحْفَظُ أَنَّ أَحَدًا رَوَاهُ عَنْ  يُونُسَ  عَنْ  حَمَّادٍ  إِلَّا  إِبْرَاهِيمَ بْنَ سَعِيدٍ ،  فَذَكَرَ         [11/33]      بَعْضُ أَصْحَابِنَا أَنَّ  مُجَاهِدَ بْنَ مُوسَى  رَوَاهُ أَيْضًا عَنْ  يُونُسَ  فَتَابَعَ  إِبْرَاهِيمَ  عَلَى  إِسْنَادِهِ  .","","Musnad al-Bazzar 4713","","طاوس بن كيسان عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن أحمد بن عبدة الضبي عن البزار","طاوس عن ابن عباس"
"4721","4714  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  مُحَمَّدُ بْنُ كَثِيرٍ ، قَالَ :  نَا  سُلَيْمَانُ بْنُ كَثِيرٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  رَفَعَهُ  ، قَالَ :  مَنْ قُتِلَ فِي  عِمِّيَّةٍ  ، أَوْ قَالَ : ""  عِمِّيَّةٍ  ""  ، بِحَجَرٍ أَوْ سَوْطٍ ، أَوْ عَصًا ، فَعَلَيْهِ عَقْلُ  الْخَطَأِ  ، وَمَنْ قُتِلَ عَمْدًا فَهُوَ  قَوَدٌ ،  وَمَنْ حَالَ بَيْنَهُ وَبَيْنَهُ ، فَعَلَيْهِ لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ ، لَا يُقْبَلُ مِنْهُ  صَرْفٌ  وَلَا عَدْلٌ  .  وَهَذَا الْحَدِيثُ لَا نَعْلَمُهُ يُرْوَى عَنِ  ابْنِ عَبَّاسٍ  بِهَذَا اللَّفْظِ إِلَّا مِنْ هَذَا         [11/34]      الْوَجْهِ بِهَذَا  الْإِسْنَادِ  ، وَلَا نَعْلَمُ  أَسْنَدَهُ  عَنْ  عَمْرِو بْنِ دِينَارٍ  عَنْ  طَاوُسٍ  ، عَنِ  ابْنِ عَبَّاسٍ  إِلَّا  سُلَيْمَانُ بْنُ كَثِيرٍ  ، وَرَوَاهُ غَيْرُ  سُلَيْمَانَ  عَنْ  عَمْرِو بْنِ دِينَارٍ  ، عَنْ  طَاوُسٍ  ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  مُرْسَلًا  .","","Musnad al-Bazzar 4714","","عبد الله بن عباس عن طاوس بن كيسان عن عمرو بن دينار الأثرم عن سليمان بن كثير الأصيد عن محمد بن كثير العبدي عن محمد بن معمر بن ربعي البحراني عن البزار","طاوس عن ابن عباس"
"4722","4715  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ الْجُنَيْدِ ، قَالَ :  نَا  يَحْيَى بْنُ السَّكَنِ ، قَالَ :  نَا  شُعْبَةُ قَالَ :  أَنَا  خَالِدٌ الْحَذَّاءُ قَالَ :  سَمِعْتُ  عِكْرِمَةَ يَقُولُ : وَلَا أُرَاهُ إِلَّا  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْعَائِدُ فِي هِبَتِهِ كَالْكَلْبِ يَعُودُ فِي قَيْئِهِ  .","","Musnad al-Bazzar 4715","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن خالد الحذاء عن شعبة بن الحجاج عن يحيى بن السكن البصري عن محمد بن أحمد بن الجنيد الدقاق عن البزار","طاوس عن ابن عباس"
"4723","4716  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ ، قَالَ :  نَا  الْمُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ  سَمِعْتُ  لَيْثًا  يُحَدِّثُ عَنْ  أَبِي فَزَارَةَ  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ، أَوْ مِقْسَمٍ  ،  عَنِ  ابْنِ عَبَّاسٍ  رَفَعَ  الْحَدِيثَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ :  هَذِهِ         [11/35]      الْكَلِمَاتُ وِقَاءٌ مِنْ كُلِّ دَاءٍ  : أَعُوذُ  بِكَلِمَاتِ  اللهِ  التَّامَّةِ  ، وَأَسْمَائِهِ كُلِّهَا عَامَّةً مِنْ شَرِّ  السَّامَّةِ  وَالْعَامَّةِ وَشَرِّ الْعَيْنِ  اللَّامَّةِ  ، وَمِنْ  شَرِّ  حَاسِدٍ إِذَا  حَسَدَ  ، وَمِنْ  شَرِّ  ذِي  شَرٍّ  وَمَا وَلَدَ . ثَلَاثَةً وَثَلَاثِينَ مِنَ الْمَلَائِكَةِ أَتَوْا بِهِمْ ، فَقَالَ : وَصِبَ وَصِبٌ ، فَقَالَ : خُذُوا تُرْبَةً مَنْ أَرْضِكُمْ فَامْسَحُوا نَوَاصِيَكُمْ وَفِيهِ مَنْ أَخَذَ عَلَيْهَا صَفَدًا ، أَوْ كَتَمَهَا أَحَدًا فَلَا أَفْلَحَ إِذًا أَبَدًا  .","","Musnad al-Bazzar 4716","","عبد الله بن عباس عن مقسم بن بجرة عن راشد بن كيسان العبسي عن ليث بن أبي سليم عن معتمر بن سليمان عن العباس بن الوليد النرسي عن البزار","طاوس عن ابن عباس"
"4724","4717  -  وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ سَيْفٍ الْقُطَعِيُّ ، قَالَ :  نَا  يُونُسُ بْنُ أَرْقَمَ ، قَالَ :  نَا  الْأَعْمَشُ  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ         [11/36]      عَلِيًّا  رَضِيَ اللهُ عَنْهُمْ نَاوَلَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ تُرَابًا فَرَمَى بِهِ فِي وُجُوهِ الْمُشْرِكِينَ  يَوْمَ حُنَيْنٍ  .","","Musnad al-Bazzar 4717","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن الأعمش عن يونس بن أرقم الكندي عن إسماعيل بن سيف القطعي عن البزار","طاوس عن ابن عباس"
"4725","4718  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ الْكَرْمَانِيُّ ، قَالَ :  نَا  يَحْيَى بْنُ آدَمَ ، قَالَ :  نَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ  عَنْ  إِدْرِيسَ بْنِ بِنْتِ وَهْبِ بْنِ مُنَبِّهٍ  عَنْ  وَهْبٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  سَأَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  جِبْرِيلَ  أَنْ يَرَاهُ فِي صُورَتِهِ  قَالَ : ادْعُ رَبَّكَ ، فَدَعَا رَبَّهُ فَطَلَعَ عَلَيْهِ مِنْ قِبَلِ الْمَشْرِقِ فَجَعَلَ يَرْتَفِعُ وَيَسِيرُ فَلَمَّا رَآهُ صَعِقَ فَأَتَاهُ  .","","Musnad al-Bazzar 4718","","عبد الله بن عباس عن وهب بن منبه عن إدريس بن سنان اليماني عن أبو بكر بن عياش عن يحيى بن آدم عن محمد بن الحسن الكرماني عن البزار","طاوس عن ابن عباس"
"4726","[11/37]      4719  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  أَبُو عَاصِمٍ ، قَالَ :  نَا  ابْنُ جُرَيْجٍ  عَنْ  حُسَيْنِ بْنِ عَبْدِ اللهِ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ كَانَتْ إِذَا زَاغَتِ الشَّمْسُ وَهُوَ فِي مَنْزِلٍ جَمَعَ بَيْنَ الظُّهْرِ وَالْعَصْرِ  ، وَإِذَا لَمْ تَزِغْ حَتَّى يَرْتَحِلَ صَارَ حَتَّى إِذَا كَانَتِ الْعَصْرُ نَزَلَ فَجَمَعَ بَيْنَ الظُّهْرِ وَالْعَصْرِ ، وَإِذَا غَابَتْ لَهُ الشَّمْسُ جَمَعَ فِي مَنْزِلِهِ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ ، وَإِذَا رَحَلَ قَبْلَ أَنْ تَغِيبَ سَارَ حَتَّى إِذَا غَابَ  الشَّفَقُ  نَزَلَ فَجَمَعَ بَيْنَ الْمَغْرِبِ وَالْعِشَاءِ  .","","Musnad al-Bazzar 4719","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن الحسين بن عبد الله بن عبيد الله بن عباس الهاشمي عن ابن جريج عن أبو عاصم النبيل عن الفلاس عن البزار","طاوس عن ابن عباس"
"4727","4720  -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ، قَالَ :  نَا  عَدِيُّ بْنُ الْفَضْلِ         [11/38]      قَالَ :  نَا  إِسْمَاعِيلُ بْنُ أُمَيَّةَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنِ  ابْنِ عَبَّاسٍ ،  وَقَالَ  غَيْرُهُ :  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ رَضِيَ اللهُ عَنْهُمْ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَمَّا أُصِيبَ إِخْوَانُكُمْ جَعَلَ اللهُ أَرْوَاحَهُمْ فِي جَوْفِ طَيْرٍ خُضْرٍ  تَرِدُ أَنْهَارَ الْجَنَّةِ وَتَأْكُلُ مِنْ ثِمَارِهَا وَتَأْوِي إِلَى قَنَادِيلَ مُعَلَّقَةٍ فِي ظِلِّ الْعَرْشِ ، فَلَمَّا وَجَدُوا طِيبَ مَطْعَمِهِمْ وَمَشْرَبِهِمْ قَالُوا لَوْ يَعْلَمُونَ بِمَا أَكْرَمَنَا ، قَالَ اللهُ تَبَارَكَ وَتَعَالَى : أَنَا مُعْلِمُهُمْ عَنْكُمْ فَأَنْزَلَ اللهُ :         {      وَلا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللهِ أَمْوَاتًا بَلْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ يُرْزَقُونَ             *          فَرِحِينَ بِمَا آتَاهُمُ اللهُ مِنْ فَضْلِهِ وَيَسْتَبْشِرُونَ بِالَّذِينَ لَمْ يَلْحَقُوا بِهِمْ مِنْ خَلْفِهِمْ أَلا خَوْفٌ عَلَيْهِمْ وَلا هُمْ يَحْزَنُونَ         }      .","","Musnad al-Bazzar 4720","","عبد الله بن عباس عن أبو الزبير المكي عن إسماعيل بن أمية الأموي عن عدي بن الفضل التيمي عن عبد الواحد بن غياث عن البزار","طاوس عن ابن عباس"
"4728","[11/39]      4721  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ ، قَالَ :  نَا  حَفْصُ بْنُ غِيَاثٍ  عَنْ  دَاوُدَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  أَتَتِ الصَّبَا الشَّمَالَ فَقَالَتْ : مُرِي حَتَّى نَنْصُرَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَتِ الشَّمَالُ :  إِنَّ  الْحَرَّةَ  لَا تَسْرِي بِاللَّيْلِ ، فَكَانَتِ الرِّيحُ الَّتِي نُصِرَ بِهَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الصَّبَا  .","","Musnad al-Bazzar 4721","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن داود بن أبي هند عن حفص بن غياث النخعي عن عبد الله بن سعيد الأشج عن البزار","طاوس عن ابن عباس"
"4729","4722  -  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ ، قَالَ :  نَا  أَبُو خَالِدٍ  عَنِ  الْأَعْمَشِ  عَنِ  الْحَكَمِ وَمُسْلِمٍ الْبَطِينِ  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ وَعَطَاءٍ وَمُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  جَاءَتِ  امْرَأَةٌ  إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَقَالَتْ : إِنَّ أُخْتِي مَاتَتْ وَعَلَيْهَا صِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ فَقَالَ :  أَرَأَيْتِ لَوْ كَانَ عَلَى أُخْتِكِ دَيْنٌ أَكُنْتِ تَقْضِينَهُ ؟  قَالَتْ : نَعَمْ قَالَ :         [11/40]      فَحَقُّ اللهِ أَحَقُّ  .","","Musnad al-Bazzar 4722","","عبد الله بن عباس عن مجاهد بن جبر المخزومي عن مسلم بن عمران البطين عن الأعمش عن سليمان بن حيان الأحمر عن عبد الله بن سعيد الأشج عن البزار","طاوس عن ابن عباس"
"4730","4723  -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ قَالَ :  أَنَا  أَبِي  ، قَالَ :  نَا  جَرِيرُ بْنُ حَازِمٍ  عَنْ  يَعْلَى بْنِ حَكِيمٍ  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ وَابْنِ عُمَرَ رَضِيَ اللهُ عَنْهُمْ  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ حَرَّمَ نَبِيذَ  الْجَرِّ  .","","Musnad al-Bazzar 4723","","عبد الله بن عمر بن الخطاب عن سعيد بن جبير الأسدي عن يعلى بن حكيم الثقفي عن جرير بن حازم عن علي بن نصر الجهضمي الكبير عن نصر بن علي بن نصر الجهضمي عن البزار","طاوس عن ابن عباس"
"4731","4724  -  حَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ قَالَ :  حَدَّثَنِي  أَبِي  عَنْ  سُفْيَانَ  عَنْ         [11/41]      أَبِيهِ  ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ :         {      وَأَنْتُمْ سَامِدُونَ         }      قَالَ : الْغِنَاءُ  .","","Musnad al-Bazzar 4724","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سعيد بن مسروق الثوري عن سفيان الثوري عن علي بن نصر الجهضمي الكبير عن نصر بن علي بن نصر الجهضمي عن البزار","طاوس عن ابن عباس"
"4732","4725  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ عُمَرَ  ، قَالَ :  نَا  مُجَالِدٌ  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَثَلُ الَّذِي يَتَكَلَّمُ يَوْمَ الْجُمُعَةَ وَالْإِمَامُ يَخْطُبُ كَمَثَلِ الْحِمَارِ يَحْمِلُ أَسْفَارًا  .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : (عبد الله بن نمير) كما سيأتي عند المصنف (5345) وينظر تعليق المصنف عقبه ، والله أعلم .","","Musnad al-Bazzar 4725","","عبد الله بن عباس عن الشعبي عن مجالد بن سعيد عن عبد الله بن نمير عن إبراهيم بن سعيد الجوهري عن البزار","طاوس عن ابن عباس"
"4733","[11/42]      4726  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ عَبْدِ اللهِ الْأَصْبَهَانِيُّ ، قَالَ :  نَا  حُسَيْنُ بْنُ حَفْصٍ ، قَالَ :  نَا  خَطَّابُ بْنُ جَعْفَرِ بْنِ أَبِي الْمُغِيرَةِ  عَنْ  أَبِيهِ  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَطُوفُ فِي النَّخْلِ  بِالْمَدِينَةِ  فَجَعَلَ النَّاسُ يَقُولُونَ : فِيهَا صَاعٌ وَفِيهَا وَسْقٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فِيهَا كَذَا وَكَذَا ، قَالُوا : صَدَقَ اللهُ وَرَسُولُهُ ، فَقَالَ رَسُولُ اللهِ :  إِنَّمَا أَنَا بَشَرٌ فَمَا حَدَّثْتُكُمْ عَنِ اللهِ فَهُوَ حَقٌّ ، وَمَا قُلْتُ فِيهِ مِنْ قِبَلِ نَفْسِي فَإِنَّمَا أَنَا بَشَرٌ أُصِيبُ وَأُخْطِئُ  .","","Musnad al-Bazzar 4726","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن جعفر بن أبي المغيرة عن خطاب بن جعفر بن أبي المغيرة الخزاعي عن الحسين بن حفص الهمداني عن إسماعيل بن عبد الله سمويه عن البزار","طاوس عن ابن عباس"
"4734","4727  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُعَاذُ بْنُ هِشَامٍ قَالَ  حَدَّثَنِي  أَبِي  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي قِلَابَةَ  عَنْ  خَالِدِ بْنِ اللَّجْلَاجِ  عَنْ  عَبْدِ اللهِ بْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - أَنَّ نَبِيَّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  رَأَيْتُ رَبِّي فِي أَحْسَنِ  صُورَةٍ  ، فَقَالَ : يَا  مُحَمَّدُ  ، فَقُلْتُ :  لَبَّيْكَ  رَبِّي         [11/43]      وَسَعْدَيْكَ ،  قَالَ : فِيمَ يَخْتَصِمُ  الْمَلَأُ  الْأَعْلَى ؟ قُلْتُ : رَبِّي لَا أَدْرِي ، قَالَ : فَوَضَعَ يَدَهُ بَيْنَ كَتِفَيَّ فَوَجَدْتُ بَرْدَهَا بَيْنَ ثَدْيَيَّ ، فَعَلِمْتُ مَا بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ فَقَالَ : يَا  مُحَمَّدُ  ، قُلْتُ :  لَبَّيْكَ  رَبِّي  وَسَعْدَيْكَ ،  قَالَ : فِيمَ يَخْتَصِمُ  الْمَلَأُ  الْأَعْلَى ؟ قُلْتُ : رَبِّي فِي الْكَفَّارَاتِ ، وَالْمَشْيِ عَلَى الْأَقْدَامِ إِلَى الْجَمَاعَاتِ وَإِسْبَاغِ الْوُضُوءِ فِي الْمَكْرُوهَاتِ ، وَانْتِظَارِ الصَّلَاةِ بَعْدَ الصَّلَاةِ إِلَى الصَّلَوَاتِ ، فَمَنْ حَافَظَ عَلَيْهِنَّ عَاشَ بِخَيْرٍ ، وَمَاتَ بِخَيْرٍ ، وَكَانَ مِنْ ذُنُوبِهِ كَيَوْمَ وُلِدَ  .","","Musnad al-Bazzar 4727","","عبد الله بن عباس عن خالد بن اللجلاج عن أبو قلابة الجرمي عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن أبو موسى الزمن عن البزار","طاوس عن ابن عباس"
"4735","4728  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِئُ ، قَالَ :  نَا  لَيْثُ بْنُ سَعْدٍ قَالَ :  حَدَّثَنِي  أَبُو الزُّبَيْرِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  وَعَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُعَلِّمُنَا  التَّشَهُّدَ  كَمَا يُعَلِّمُنَا الْقُرْآنَ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  التَّحِيَّاتُ  الْمُبَارَكَاتُ الصَّلَوَاتُ الطَّيِّبَاتُ لِلهِ السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ  ، السَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ         [11/44]      اللهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ  .","","Musnad al-Bazzar 4728","","عبد الله بن عباس عن طاوس بن كيسان عن أبو الزبير المكي عن الليث بن سعد عن عبد الله بن يزيد القصير عن محمد بن معمر بن ربعي البحراني عن البزار","طاوس عن ابن عباس"
"4736","4729  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  مُسْلِمٌ ، قَالَ :  نَا  شَدَّادُ بْنُ سَعِيدٍ  عَنِ  الْجُرَيْرِيِّ ،  عَنْ  أَبِي نَضْرَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا شَبَابَ  قُرَيْشٍ  ، لَا تَزْنُوا احْفَظُوا  فُرُوجَكُمْ  أَلَا مَنْ حَفِظَ فَرْجَهُ فَلَهُ الْجَنَّةُ  .","","Musnad al-Bazzar 4729","","عبد الله بن عباس عن المنذر بن مالك العوقي عن سعيد بن إياس الجريري عن شداد بن سعيد الراسبي عن مسلم بن إبراهيم الشحام عن محمد بن معمر بن ربعي البحراني عن البزار","طاوس عن ابن عباس"
"4737","[11/45]      4730  -  حَدَّثَنَا  أَبُو فَرْوَةَ يَزِيدُ بْنُ مُحَمَّدِ بْنِ يَزِيدَ ، قَالَ :  نَا  أَبِي مُحَمَّدُ بْنُ يَزِيدَ الرَّهَاوِيُّ  عَنْ  أَبِيهِ يَزِيدَ بْنِ سِنَانٍ  ، قَالَ :  نَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَقَامَنِي عَنْ يَمِينِهِ  .","","Musnad al-Bazzar 4730","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن يزيد بن محمد ابن يزيد الرهاوي عن البزار","طاوس عن ابن عباس"
"4738","4731  -  قَالَ :  وَحَدَّثَنِي  أَبِي مُحَمَّدُ بْنُ يَزِيدَ  عَنْ  أَبِيهِ يَزِيدَ بْنِ سِنَانٍ ،  قَالَ :  نَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ         [11/46]      رَضِيَ اللهُ عَنْهُمَا ،  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ  لِضُبَاعَةَ  :  أَحْرِمِي وَلَبِّي وَقُولِي : مَحِلِّي مِنَ الْأَرْضِ حَيْثُ حَبَسْتَنِي  ، فَإِنَّكِ إِنْ مَرِضْتِ فَإِنَّكِ قَدْ أَحْلَلْتِ عَنْ أَمْرِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad al-Bazzar 4731","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن يزيد بن محمد ابن يزيد الرهاوي عن البزار","طاوس عن ابن عباس"
"4739","4732  -  قَالَ :  وَحَدَّثَنِي  أَبِي  عَنْ  أَبِيهِ يَزِيدَ  ، قَالَ :  نَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  لَمْ يَحُجَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مُنْذُ هَاجَرَ إِلَّا حَجَّةً وَاحِدَةً  ، وَهِيَ تِلْكَ الْحَجَّةُ الَّتِي أَهَلَّ فِيهَا بِالْعُمْرَةِ بَيْنَ يَدَيِ  الْحَجِّ  . قَالَ  عَبْدُ اللهِ بْنُ الْعَبَّاسِ  : كَذَلِكَ فَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَدَّمَ عُمْرَةً بَيْنَ يَدَيِ  الْحَجِّ  . قَالَ عَبْدُ اللهِ :  لَا تَنْقُصُ الْعُمْرَةُ مِنَ  الْحَجِّ  شَيْئًا ،  وَلَا تَنْقُصُ الْحَجَّةُ مِنَ الْعُمْرَةِ         [11/47]      شَيْئًا ، وَذَلِكَ خَيْرٌ وَذَلِكَ حَقٌّ ، وَلَكِنَّ الشَّيْطَانَ يُلْبِسُ عَلَيْكُمْ  .","","Musnad al-Bazzar 4732","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن يزيد بن محمد ابن يزيد الرهاوي عن البزار","طاوس عن ابن عباس"
"4740","4733  -  قَالَ :  وَحَدَّثَنِي  أَبِي  عَنْ  أَبِيهِ  ، قَالَ :  نَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَ  عَائِشَةَ  أَنْ تَعْتَمِرَ مِنَ  التَّنْعِيمِ  ثُمَّ تَطُوفَ  بِالْبَيْتِ  وَلَمْ تَكُنْ طَافَتْ مِنْ أَجْلِ حَيْضَتِهَا ، وَكَانَتْ أَهَّلَتْ بِعُمْرَةٍ  .","","Musnad al-Bazzar 4733","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن يزيد بن محمد ابن يزيد الرهاوي عن البزار","طاوس عن ابن عباس"
"4741","4734  -  قَالَ :  وَحَدَّثَنِي  أَبِي  عَنْ  أَبِيهِ  ، قَالَ :  نَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  لَمْ أَكُنْ لِأَحُجَّ أَبَدًا إِلَّا وَأَنْحَرُ ، كَذَلِكَ فَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad al-Bazzar 4734","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن يزيد بن محمد ابن يزيد الرهاوي عن البزار","طاوس عن ابن عباس"
"4742","4735  -  قَالَ :  وَحَدَّثَنِي  أَبِي  عَنْ  أَبِيهِ  ، قَالَ :  نَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  مَنْ طَافَ         [11/48]      بِالصَّفَا  وَالْمَرْوَةِ  فَقَدَّمَهُ لِعُمْرَتِهِ فَإِنَّ ذَلِكَ يَكْفِيهِ لِعُمْرَتِهِ وَحَجَّتِهِ  ، وَكَذَلِكَ فَعَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَصْدَرَهُ ، طَافَ لِعُمْرَتِهِ ثُمَّ لَبِثَ ثُمَّ ارْتَحَلَ مِنَ  الْحَجِّ  فَلَمْ يَطُفْ بَعْدَ  الْحَجِّ  حَتَّى ارْتَحَلَ  .","","Musnad al-Bazzar 4735","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن أبي كثير عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن يزيد بن محمد ابن يزيد الرهاوي عن البزار","طاوس عن ابن عباس"
"4743","4736  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْأَنْصَارِيُّ ، قَالَ :  نَا  سَعِيدٌ  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي طَالِبٍ الضُّبَعِيِّ .","","Musnad al-Bazzar 4736","","أبو طالب الضبعي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن عبد الله بن المثنى الخزرجي عن أبو موسى الزمن عن البزار","طاوس عن ابن عباس"
"4744","4737  -  وَحَدَّثَنَا  نَصْرُ بْنُ عَلِيٍّ قَالَ :  أَنَا  خَالِدُ بْنُ الْحَارِثِ ، قَالَ :  نَا  سَعِيدٌ  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي طَالِبٍ الضُّبَعِيِّ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ حَجَّامًا يُقَالُ لَهُ  أَبُو طَيْبَةَ  حَجَمَ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَعْطَاهُ أَجْرَهُ  وَحَطَّ لَهُ مِنْ عَمَلِهِ ، أَوْ وَضَعَ عَنْهُ طَائِفَةً مِنْ عَمَلِهِ  .","","Musnad al-Bazzar 4737","","عبد الله بن عباس عن أبو طالب الضبعي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن خالد الصدق عن نصر بن علي بن نصر الجهضمي عن البزار","طاوس عن ابن عباس"
"4745","[11/49]      4738  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  أَبُو عَاصِمٍ  عَنِ  ابْنِ جُرَيْجٍ  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  اشْتَدَّ غَضَبُ اللهِ عَلَى مَنْ قَتَلَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِيَدِهِ ،  وَاشْتَدَّ غَضَبُ اللهِ عَلَى قَوْمٍ دَمَّوْا وَجْهَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad al-Bazzar 4738","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عمرو بن دينار الأثرم عن ابن جريج عن أبو عاصم النبيل عن محمد بن معمر بن ربعي البحراني عن البزار","طاوس عن ابن عباس"
"4746","4739  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  أَبُو عَاصِمٍ ، قَالَ :  نَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  أَبِي رَجَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَزَالُ أَمْرُ هَذِهِ الْأُمَّةِ  مُوَامًا ، أَوْ مُقَارِبًا ( قَالَ  جَرِيرٌ  : أَوْ كَلِمَةً تُشْبِهُهَا )  مَا لَمْ يَتَكَلَّمُوا فِي الْقَدَرِ وَالْوِلْدَانِ  .","","Musnad al-Bazzar 4739","","عبد الله بن عباس عن أبو رجاء العطاردي عن جرير بن حازم عن أبو عاصم النبيل عن محمد بن معمر بن ربعي البحراني عن البزار","طاوس عن ابن عباس"
"4747","[11/50]      4740  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  ابْنُ أَبِي عَدِيٍّ ، قَالَ :  نَا  سَعِيدٌ  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّهُ كَانَ يَجْمَعُ بَيْنَ الصَّلَاتَيْنِ فِي السَّفَرِ وَيَقُولُ : مِنَ السُّنَّةِ  .","","Musnad al-Bazzar 4740","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن البزار","طاوس عن ابن عباس"
"4748","4741  -  حَدَّثَنَا  عَمْرُو بْنُ عَلِيٍّ ، قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ ، قَالَ :  نَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  يَقْطَعُ الصَّلَاةَ الْكَلْبُ الْأَسْوَدُ وَالْمَرْأَةُ الْحَائِضُ  ، قَالَ : قُلْتُ : قَدْ كَانَ يَذْكُرُ الثَّالِثَ قَالَ : مَا هُوَ ؟ قُلْتُ : الْحِمَارُ ، قَالَ :  رُوَيْدًا  الْحِمَارُ قُلْتُ : قَدْ ذَكَرَ الرَّابِعَ قَالَ : مَا هُوَ ؟ قُلْتُ : الْكَافِرُ قَالَ : إِنِ اسْتَطَعْتَ أَلَّا يَمُرَّ بَيْنَ يَدَيْكَ كَافِرٌ وَلَا مُسْلِمٌ فَافْعَلْ  .","","Musnad al-Bazzar 4741","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن شعبة بن الحجاج عن يحيى القطان عن الفلاس عن البزار","طاوس عن ابن عباس"
"4749","[11/51]      4742  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ :  نَا  ابْنُ أَبِي عَدِيٍّ  عَنْ  سَعِيدٍ  عَنْ  قَتَادَةَ ،  عَنْ  جَابِرِ بْنِ زَيْدٍ ،  عَنِ  ابْنِ عَبَّاسٍ بِنَحْوِ حَدِيثِ  شُعْبَةَ  وَلَمْ يَرْفَعْهُ  .","","Musnad al-Bazzar 4742","","عبد الله بن عباس عن جابر بن زيد اليحمدي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن البزار","طاوس عن ابن عباس"
"4750","4743  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ مُحَمَّدٍ أَبُو شَيْبَةَ ، قَالَ :  نَا  إِبْرَاهِيمُ بْنُ الْحَسَنِ التَّغْلِبِيُّ ، قَالَ :  نَا  يَحْيَى بْنُ يَعْلَى الْأَسْلَمِيُّ ،  عَنْ  أَبِي سَعْدٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  قِيلَ : يَا رَسُولَ اللهِ أَتُهْلَكُ الْقَرْيَةُ وَفِيهَا الصَّالِحُونَ ؟ قَالَ : نَعَمْ  ، قِيلَ : بِمَ ؟ قَالَ : بِدَهْنَتِهِمْ وَسُكُوتِهِمْ عَنْ مَعَاصِي اللهِ  .","","Musnad al-Bazzar 4743","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سعيد بن المرزبان عن يحيى بن يعلى القطواني عن إبراهيم بن الحسن الثعلبي عن إبراهيم بن عبد الله أبو شيبة العبسي عن البزار","طاوس عن ابن عباس"
"4751","4744  -  وَحَدَّثَنَا  أَبُو شَيْبَةَ ، قَالَ :  نَا  أَحْمَدُ بْنُ يَحْيَى ، قَالَ :  نَا  أَبُو عُبَيْدَةَ  عَنِ  الْأَعْمَشِ  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، رَضِيَ اللهُ         [11/52]      عَنْهُمَا ، قَالَ :  أَخَذَتْهُمْ  يَوْمَ بَدْرٍ  رِيحٌ عَقِيمٌ  .","","Musnad al-Bazzar 4744","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن الأعمش عن عبد الملك بن معن المسعودي عن أحمد بن يحيى بن المنذر الأحول عن إبراهيم بن عبد الله أبو شيبة العبسي عن البزار","طاوس عن ابن عباس"
"4752","4745  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ ، قَالَ :  نَا  عِيسَى بْنُ سَوَادَةَ ، قَالَ :  نَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ  عَنْ  زَاذَانَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ حَجَّ مَاشِيًا كُتِبَ لَهُ بِكُلِّ خُطْوَةٍ سَبْعُمِائَةِ حَسَنَةٍ مِنْ حَسَنَاتِ  الْحَرَمِ  ، قَالَ بَعْضُهُمْ : وَمَا حَسَنَاتُ  الْحَرَمِ  ؟ قَالَ : كُلُّ حَسَنَةٍ بِمِائَةِ أَلْفِ حَسَنَةٍ  .","","Musnad al-Bazzar 4745","","عبد الله بن عباس عن زاذان الكندي عن إسماعيل بن أبي خالد عن عيسى بن سوادة النخعي عن عبد الله بن سعيد الأشج عن البزار","طاوس عن ابن عباس"
"4753","4746  -  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ ، قَالَ :  نَا  يَحْيَى بْنُ سَعِيدٍ الْأُمَوِيُّ ، قَالَ :  نَا  ابْنُ جُرَيْجٍ  عَنْ  خُصَيْفٍ ،  عَنْ  مِقْسَمٍ ،         [11/53]      عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  أَشْهَدُ لَقَدْ عَلِمْتُ أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مَسَحَ عَلَى الْخُفَّيْنِ  .","","Musnad al-Bazzar 4746","","عبد الله بن عباس عن مقسم بن بجرة عن خصيف الجزري عن ابن جريج عن يحيى بن سعيد بن أبان عن إبراهيم بن سعيد الجوهري عن البزار","طاوس عن ابن عباس"
"4754","4747  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْأَسْوَدِ بْنِ مَأْمُولٍ ، قَالَ :  نَا  شَبَابَةُ بْنُ سَوَّارٍ ، قَالَ :  نَا  الْحَسَنُ بْنُ عُمَارَةَ  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْأَصْبَهَانِيِّ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  وَقَعَ مَوْلًى لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ نَخْلَةٍ فَمَاتَ فَأَعْطَى النَّبِيُّ مِيرَاثَهُ أَهْلَ         [11/54]      دِينِهِ  .","","Musnad al-Bazzar 4747","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عبد الرحمن بن عبد الله بن الأصبهاني عن الحسن بن عمارة عن شبابة بن سوار المدائني عن عبد الرحمن بن الأسود بن المأمول الوراق عن البزار","طاوس عن ابن عباس"
"4755","4748  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ، قَالَ :  نَا  ابْنُ أَبِي يَعْلَى  عَنِ  الْحَكَمِ  عَنْ  يَحْيَى بْنِ الْجَزَّارِ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  خَرَجَتَا جَارِيَتَانِ تَمْشِيَانِ فِي الْقِبْلَةِ وَرَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي فَأَخَذَتَا بِحَقْوَيْهِ  فَلَمَّا أَرَادَ أَنْ يَرْكَعَ فَرَّقَ بَيْنَهُمَا ثُمَّ رَكَعَ  .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : ( ابن أبي ليلى )","","Musnad al-Bazzar 4748","","عبد الله بن عباس عن يحيى بن الجزار العرني عن الحكم بن عتيبة الكندي عن محمد بن عبد الرحمن بن أبي ليلى عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4756","[11/55]      4749  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ، قَالَ :  نَا  ابْنُ أَبِي لَيْلَى  عَنِ  الْمِنْهَالِ بْنِ عَمْرٍو  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  أَتَى  رَجُلٌ  النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : إِنَّ عَلَى أُمِّي رَقَبَةً وَعِنْدِي أَمَةٌ سَوْدَاءُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ائْتِنِي بِهَا  ، فَقَالَ لَهَا رَسُولُ اللهِ : أَتَشْهَدِينَ أَنْ لَا إِلَهَ إِلَّا اللهُ وَأَنِّي رَسُولُ اللهِ ؟ قَالَتْ : نَعَمْ . قَالَ : فَأَعْتِقْهَا  .","","Musnad al-Bazzar 4749","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن المنهال بن عمرو الأسدي عن محمد بن عبد الرحمن بن أبي ليلى عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4757","4750  -  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى ، قَالَ :  نَا  أَبُو جَعْفَرٍ الرَّازِيُّ  عَنْ  عَبْدِ الْكَرِيمِ ،  عَنْ  مِقْسَمٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،         [11/56]      رَضِيَ اللهُ عَنْهُمَا ،  فِي الَّذِي يَقَعُ عَلَى امْرَأَتِهِ وَهِيَ حَائِضٌ  : إِنْ كَانَ الدَّمُ  عَبِيطً  فَلْيَتَصَدَّقْ بِدِينَارٍ ، وَإِنْ كَانَ صُفْرَةً فَنِصْفُ دِينَارٍ  .","","Musnad al-Bazzar 4750","","عبد الله بن عباس عن مقسم بن بجرة عن عبد الكريم الاصطخري عن عيسى بن أبي عيسى الرازي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4758","[11/57]      4751  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، قَالَ :  نَا  عُبَيْدُ اللهِ بْنُ مُوسَى  عَنْ  شَرِيكٍ  عَنْ  جَابِرٍ ،  عَنْ  أَبِي الضُّحَى ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  أَفَاضَ  رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ مِنْ  جَمْعٍ  ، أَوْ  عَرَفَةَ  وَقُثَمُ  بَيْنَ يَدَيْهِ  وَالْفَضْلُ  خَلْفَهُ  .","","Musnad al-Bazzar 4751","","عبد الله بن عباس عن مسلم بن صبيح الهمداني عن جابر الجعفي عن شريك بن عبد الله النخعي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4759","4752  -  حَدَّثَنَا  مُحَمَّدٌ ، قَالَ :  نَا  عُبَيْدُ اللهِ ، قَالَ :  نَا  شَرِيكٌ  عَنْ  جَابِرٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  سَنَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ رَكْعَتَيْنِ فِي السَّفَرِ  وَهُمَا تَمَامٌ  وَالْوِتْرُ  فِي السَّفَرِ سُنَّةٌ  .","","Musnad al-Bazzar 4752","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن جابر الجعفي عن شريك بن عبد الله بن أبي نمر الكناني عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4760","[11/58]      4753  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ،  عَنْ  سُفْيَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  جَمَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِالْمَدِينَةِ  بَيْنَ الظُّهْرِ وَالْعَصْرِ  فِي غَيْرِ خَوْفٍ وَلَا مَطَرٍ ، قُلْتُ  لِابْنِ عَبَّاسٍ  : لِأَيِّ شَيْءٍ فَعَلَ ذَلِكَ ؟ قَالَ : لِكَيْ لَا يُحْرِجَ أُمَّتَهُ  .","","Musnad al-Bazzar 4753","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو الزبير المكي عن سفيان الثوري عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4761","[11/59]      4754  -  حَدَّثَنَا  الْحَسَنُ بْنُ عَرَفَةَ ، قَالَ :  نَا  هُشَيْمٌ  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ ، رَضِيَ اللهُ         [11/60]      عَنْهُمَا ، قَالَ :  جَمَعَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بَيْنَ الظُّهْرِ وَالْعَصْرِ وَالْمَغْرِبِ وَالْعِشَاءِ  وَهُوَ مُقِيمٌ  بِالْمَدِينَةِ  مِنْ غَيْرِ خَوْفٍ ، لِكَيْ لَا يُحْرِجَ أُمَّتَهُ  .","","Musnad al-Bazzar 4754","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو الزبير المكي عن أشعث بن سوار عن هشيم بن بشير عن الحسن بن عرفة العبدي عن البزار","طاوس عن ابن عباس"
"4762","4755  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ، قَالَ :  نَا  عُمَرُ بْنُ صُهْبَانَ ،  عَنْ  أَبِي الزُّبَيْرِ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي غَزْوَةٍ يُؤَخِّرُ الظُّهْرَ حَتَّى يُبْرِدَ  ، ثُمَّ يُصَلِّي الظُّهْرَ وَالْعَصْرَ ، ثُمَّ لَا يَنْزِلُ حَتَّى يَغِيبَ  الشَّفَقُ ،  ثُمَّ يُصَلِّي الْمَغْرِبَ وَالْعِشَاءَ  .","","Musnad al-Bazzar 4755","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو الزبير المكي عن عمر بن صهبان الهمداني عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4763","4756  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ،  عَنْ  سُفْيَانَ  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  مَرَّ عَلَيَّ نَاسٌ مِنَ  الْأَنْصَارِ  يَرْمُونَ حَمَامَةً فَقَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ يُتَّخَذَ الرُّوحُ غَرَضًا  .","","Musnad al-Bazzar 4756","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن سفيان الثوري عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4764","[11/61]      4757  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ، قَالَ  : نَا  سُفْيَانُ  عَنْ  عَبْدِ الْأَعْلَى  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَالَ فِي الْقُرْآنِ بِغَيْرِ         [11/62]      عِلْمٍ  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Musnad al-Bazzar 4757","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن عبد الأعلى بن عامر الثعلبي عن سفيان الثوري عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4765","4758  -  حَدَّثَنَا  عَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ ، قَالَ :  نَا  أَبُو عَوَانَةَ  عَنْ  عَبْدِ الْأَعْلَى  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا -أَوْ قَالَ عَلَيَّ مَا لَمْ أَقُلْ  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Musnad al-Bazzar 4758","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن عبد الأعلى بن عامر الثعلبي عن الوضاح بن عبد الله اليشكري عن عبد الواحد بن غياث عن البزار","طاوس عن ابن عباس"
"4766","4759  -  حَدَّثَنَا  الْقَاسِمُ بْنُ وَهْبٍ ، قَالَ :  نَا  الْحَسَنُ بْنُ عَطِيَّةَ ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  عَبْدِ الْأَعْلَى  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  كَانَ يَقْرَأُ فِي  الْوِتْرِ  فِي الرَّكْعَةِ الْأُولَى بِـ :         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ، وَالثَّانِيَةِ بِـ :         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَالثَّالِثَةِ :         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Musnad al-Bazzar 4759","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن عبد الأعلى بن عامر الثعلبي عن إسرائيل بن يونس بن أبي إسحاق عن الحسن بن عطية البزاز عن القاسم بن وهب بن جامع عن البزار","طاوس عن ابن عباس"
"4767","[11/63]      4760  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُوتِرُ بِـ :         {      سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى         }      ، وَ         {      قُلْ يَا أَيُّهَا الْكَافِرُونَ         }      ، وَ         {      قُلْ هُوَ اللهُ أَحَدٌ         }      .","","Musnad al-Bazzar 4760","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4768","4761  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ كَرَامَةَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  سُئِلَ : مِثْلُ مَنْ كُنْتَ حِينَ تُوُفِّيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ         [11/64]      وَسَلَّمَ ؟  قَالَ : أَنَا يَوْمَئِذٍ مَخْتُونٌ  .","","Musnad al-Bazzar 4761","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4769","4762  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ عَلَوَيْهِ الْبَغْدَادِيُّ ، قَالَ :  نَا  حَجَّاجُ بْنُ مُحَمَّدٍ ، قَالَ :  نَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِيهِ  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  وُلِدَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَامَ الْفِيلِ  .","","Musnad al-Bazzar 4762","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن أبو إسحاق السبيعي عن يونس بن أبي إسحاق عن حجاج بن محمد الأعور عن الحسن بن منصور الشطوي عن البزار","طاوس عن ابن عباس"
"4770","4763  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ سَلَمَةَ ، قَالَ :  نَا  الْحَسَنُ بْنُ         [11/65]      عَطِيَّةَ ، قَالَ :  نَا  ...  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  مَا مِنْ أَيَّامٍ الْعَمَلُ فِيهَا خَيْرٌ مِنْ هَذِهِ الْأَيَّامِ  ،  يَعْنِي : أَيَّامَ الْعَشْرِ  قِيلَ : وَلَا  الْجِهَادُ  فِي  سَبِيلِ  اللهِ ؟ قَالَ : وَلَا  الْجِهَادُ  فِي  سَبِيلِ  اللهِ  .","","Musnad al-Bazzar 4763","","","طاوس عن ابن عباس"
"4771","4764  -  حَدَّثَنَا  أُسَيْدُ بْنُ عَاصِمٍ ، قَالَ :  نَا  عَامِرُ بْنُ إِبْرَاهِيمَ ، قَالَ :  نَا  يَعْقُوبُ الْقُمِّيُّ  عَنْ  جَعْفَرِ بْنِ أَبِي الْمُغِيرَةِ  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  خَرَجَ إِلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَدْ أَظَلَّتْنَا سَحَابَةٌ وَنَحْنُ نَطْمَعُ فِيهَا فَقَالَ :  إِنَّ الْمَلَكَ الَّذِي  يَسُوقُهَا ، أَوْ يَسُوقُ هَذِهِ السَّحَابَةَ  دَخَلَ عَلَيَّ فَسَلَّمَ عَلَيَّ فَأَخْبَرَنِي أَنَّهُ         [11/66]      يَسُوقُهَا إِلَى وَادِي كَذَا  .","","Musnad al-Bazzar 4764","","عبد الله بن عباس عن سعيد بن جبير الأسدي عن جعفر بن أبي المغيرة عن يعقوب بن عبد الله بن سعد بن مالك الأشعري عن عامر بن إبراهيم الأصبهاني عن أسيد بن عاصم الأصبهاني عن البزار","طاوس عن ابن عباس"
"4772","4765  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْمَلِكِ ، قَالَ :  نَا  يَحْيَى بْنُ عَمْرِو بْنِ مَالِكٍ النُّكْرِيُّ  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْجَوْزَاءِ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ إِذَا انْصَرَفَ مِنْ صَلَاتِهِ قَالَ : لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ  ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ بِيَدِهِ الْخَيْرُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ وَلَا مُعْطِيَ لِمَا مَنَعْتَ وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْكَ  الْجَدُّ  .","","Musnad al-Bazzar 4765","","عبد الله بن عباس عن أوس بن عبد الله الربعي عن عمرو بن مالك النكري عن يحيى بن عمرو النكري عن محمد بن عبد الملك بن أبي الشوارب الأبلي عن البزار","طاوس عن ابن عباس"
"4773","4766  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ، قَالَ :  نَا  إِسْرَائِيلُ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ ، رَضِيَ اللهُ         [11/67]      عَنْهُمَا ، قَالَ  قَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِي  الرِّكَازِ  الْخُمُسَ  .","","Musnad al-Bazzar 4766","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4774","4767  -  وَبِإِسْنَادِهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الرُّؤْيَا الصَّالِحَةُ  جُزْءٌ  مِنْ سَبْعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ  .","","Musnad al-Bazzar 4767","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4775","4768  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ،  عَنْ  إِسْرَائِيلَ ،  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يُبَاشِرِ الرَّجُلُ الرَّجُلَ  وَلَا الْمَرْأَةُ الْمَرْأَةَ  .","","Musnad al-Bazzar 4768","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4776","[11/68]      4769  -  وَبِإِسْنَادِهِ  قَالَ :  قِيلَ : يَا رَسُولَ اللهِ  حِينَ فَرَغَ مِنْ  بَدْرٍ  : عَلَيْكَ  بِالْعِيرِ  لَيْسَ دُونَهَا شَيْءٌ ، فَنَادَاهُ  الْعَبَّاسُ  وَهُوَ أَسِيرٌ فِي وَثَاقِهِ إِنَّهُ لَا يَصْلُحُ لَكَ . قَالَ : لِمَ ؟  قَالَ : لِأَنَّ اللهَ قَدْ وَعَدَكَ إِحْدَى الطَّائِفَتَيْنِ ، وَقَدْ أَعْطَاكَ مَا وَعَدَكَ  .","","Musnad al-Bazzar 4769","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4777","4770  -  وَبِإِسْنَادِهِ  قَالَ :  قَالُوا :  يَا رَسُولَ اللهِ أَرَأَيْتَ الَّذِينَ مَاتُوا وَهُمْ يَشْرَبُونَ الْخَمْرَ ؟  قَالَ فَنَزَلَتْ :         {      لَيْسَ عَلَى الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جُنَاحٌ فِيمَا طَعِمُوا         }      .","","Musnad al-Bazzar 4770","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4778","[11/69]      4771  -  وَبِإِسْنَادِهِ  قَالَ :  قِيلَ : يَا رَسُولَ اللهِ أَرَأَيْتَ الَّذِينَ مَاتُوا وَهُمْ يُصَلُّونَ إِلَى بَيْتِ الْمَقْدِسِ ؟  فَأَنْزَلَ اللهُ تَبَارَكَ وَتَعَالَى :         {      وَمَا كَانَ اللهُ لِيُضِيعَ إِيمَانَكُمْ         }      ، قَالَ  عُبَيْدُ اللهِ  :  هَذَا بَيْنَ الصَّلَاةِ مِنَ الْإِيمَانِ  .","","Musnad al-Bazzar 4771","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4779","4772  -  وَبِإِسْنَادِهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  عَدْوَى  وَلَا  صَفَرَ  وَلَا  طِيَرَةَ  وَلَا  هَامَةَ  ، فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ إِنَّ الرَّجُلَ لَيَأْخُذُ الشَّاةَ الْجَرْبَاءَ فَيَطْرَحُهَا فِي مِائَةِ شَاةٍ فَتُجْرِبُهَا قَالَ : فَمَا أَجْرَبَ الْأُولَى  .","","Musnad al-Bazzar 4772","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4780","[11/70]      4773  -  وَبِإِسْنَادِهِ  أَتَى رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  رَجُلٌ  فَجَعَلَ يُثْنِي عَلَيْهِ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ مِنَ  الْبَيَانِ  سِحْرًا  ، وَإِنَّ مِنَ الشِّعْرِ  حُكْمًا  .","","Musnad al-Bazzar 4773","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4781","[11/71]      4774  -  وَبِإِسْنَادِهِ  قَالَ :  أُتِيَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بِمَاعِزِ بْنِ مَالِكٍ  فَاعْتَرَفَ مَرَّتَيْنِ فَقَالَ :  اذْهَبُوا بِهِ ثُمَّ رُدُّوهُ  فَاعْتَرَفَ مَرَّتَيْنِ حَتَّى اعْتَرَفَ أَرْبَعًا فَقَالَ : اذْهَبُوا فَارْجُمُوهُ  .  هَكَذَا وَجَدْتُهُ فِي كِتَابِي ، عَنْ  عِكْرِمَةَ  ، عَنِ  ابْنِ عَبَّاسٍ  ، وَإِنَّمَا هُوَ عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  حَدِيثُ  مَاعِزِ بْنِ مَالِكٍ  خَاصَّةً  .","","Musnad al-Bazzar 4774","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن إسرائيل بن يونس بن أبي إسحاق عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4782","4775  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ ، قَالَ :  نَا  عُبَيْدُ اللهِ ، قَالَ :  نَا  عَلِيُّ بْنُ صَالِحٍ  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَتْ  قُرَيْظَةُ  وَالنَّضِيرُ  وَكَانَ  النَّضِيرُ  أَشْرَفَ مِنْ  قُرَيْظَةَ  قَالَ : فَكَانَ إِذَا قَتَلَ         [11/72]      رَجُلٌ مِنْ  قُرَيْظَةَ  رَجُلًا مِنَ  النَّضِيرِ  قُتِلَ بِهِ ، وَإِذَا قَتَلَ رَجُلٌ مِنَ  النَّضِيرِ  رَجُلًا مِنْ  قُرَيْظَةَ  قَالُوا :  ادْفَعُوهُ إِلَيْنَا نَقْتُلْهُ  ، فَقَالُوا بَيْنَنَا وَبَيْنَكُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَتَوْهُ  فَنَزَلَتْ :         {      وَإِنْ حَكَمْتَ فَاحْكُمْ بَيْنَهُمْ بِالْقِسْطِ         }      ، وَالْقِسْطُ النَّفْسُ بِالنَّفْسِ ثُمَّ نَزَلَتْ :         {      أَفَحُكْمَ الْجَاهِلِيَّةِ يَبْغُونَ         }      .  كذا في طبعة مكتبة العلوم والحكم : وقال المحقق: كذا بالأصل ، والصواب الذي في مصادر التخريج ( نقتله ) .","","Musnad al-Bazzar 4775","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن علي بن صالح بن حي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4783","4776  -  حَدَّثَنَا  مُحَمَّدٌ ، قَالَ :  نَا  عُبَيْدُ اللهِ ،  عَنْ  سَالِمٍ أَبِي حَمَّادٍ  عَنِ  السُّدِّيِّ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أُعْطِيتُ خَمْسًا لَمْ يُعْطَهَا أَحَدٌ قَبْلِي مِنَ الْأَنْبِيَاءِ  : جُعِلَتْ لِيَ الْأَرْضُ مَسْجِدًا وَطَهُورًا وَلَمْ يَكُنْ نَبِيٌّ مِنَ الْأَنْبِيَاءِ         [11/73]      يُصَلِّي حَتَّى يَبْلُغَ  مِحْرَابَهُ  وَنُصِرْتُ  بِالرُّعْبِ  مَسِيرَةَ  شَهْرٍ يَكُونُ بَيْنَ يَدِي إِلَى الْمُشْرِكِينَ فَيَقْذِفُ اللهُ الرُّعْبَ فِي قُلُوبِهِمْ وَكَانَ النَّبِيُّ يُبْعَثُ إِلَى خَاصَّةِ قَوْمِهِ وَبُعِثْتُ أَنَا إِلَى الْجِنِّ وَالْإِنْسِ وَكَانَتِ الْأَنْبِيَاءُ يَعْزِلُونَ الْخُمُسَ فَتَجِيءُ النَّارُ فَتَأْكُلُهُ وَأُمِرْتُ أَنْ أَقْسِمَهَا فِي فُقَرَاءِ أُمَّتِي وَلَمْ يَبْقَ نَبِيٌّ إِلَّا قَدْ أُعْطِيَ شَفَاعَةً وَأَخَّرْتُ أَنَا شَفَاعَتِي لِأُمَّتِي  .","","Musnad al-Bazzar 4776","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن السدي الكبير عن سالم بن أبي حماد الصيرفي عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن البزار","طاوس عن ابن عباس"
"4784","4777  -  حَدَّثَنَا  سَهْلُ بْنُ بَحْرٍ ، قَالَ :  نَا  أَبُو نُعَيْمٍ ، قَالَ :  نَا  عِصَامُ بْنُ قُدَامَةَ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لِنِسَائِهِ :  لَيْتَ شِعْرِي أَيَّتُكُنَّ صَاحِبَةُ الْجَمَلِ الْأَدْبَبِ  تَخْرُجُ فَيَنْبَحُهَا كِلَابُ  حَوْأَبٍ  ، فَيُقْتَلُ عَنْ يَمِينِهَا ، وَعَنْ يَسَارِهَا قَتْلًا كَثِيرًا ثُمَّ تَنْجُو بَعْدَمَا كَادَتْ .","","Musnad al-Bazzar 4777","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عصام بن قدامة الجدلي عن الفضل بن دكين عن سهل بن بحر القناد عن البزار","طاوس عن ابن عباس"
"4785","[11/74]      4778  -  حَدَّثَنَا  يُوسُفُ بْنُ مُوسَى ، قَالَ :  نَا  عَمْرُو بْنُ طَلْحَةَ ، قَالَ :  نَا  أَسْبَاطُ بْنُ نَصْرٍ  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَتَا امْرَأَتَانِ ضَرَّتَانِ  بَيْنَهُمَا  سُخْطٌ  فَرَمَتْ إِحْدَاهُمَا الْأُخْرَى  فَأَسْقَطَتْ  غُلَامً مَيِّتً  قَدْ نَبَتَ شَعَرُهُ فَقَضَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  الْعَاقِلَةِ  فَقَالَ عَمُّهَا : يَا رَسُولَ اللهِ إِنَّهَا قَدْ  أَسْقَطَتْ  غُلَامً مَيِّتً  قَدْ نَبَتَ شَعَرُهُ . فَقَالَ أَبُو الْقَاتِلِ : إِنَّهُ كَاذِبٌ إِنَّهُ وَاللهِ مَا  اسْتَهَلَّ  وَلَا أَكَلَ وَلَا شَرِبَ فَمِثْلُهُ يُطَلُّ . فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَسَجْعُ الْجَاهِلِيَّةِ وَكِهَانَتِهَا ؟ إِنَّ فِي الصَّبِيِّ غُرَّةً  ، قَالَ : وَكَانَ اسْمُ إِحْدَاهُمَا  مُلَيْكَةَ  وَالْأُخْرَى  أُمَّ عَطْرَفٍ  .  كذا في طبعة مكتبة العلوم والحكم : وقال المحقق: كذا بالأصل وهو تصحيف وصوابه: امرأتين ضرتين.  كذا في طبعة مكتبة العلوم والحكم : وقال المحقق: كذا بالأصل وهو تصحيف ، وصوابه : غلاما ميتا.  كذا في طبعة مكتبة العلوم والحكم : وقال المحقق: كذا بالأصل وهو تصحيف وصوابه: امرأتين ضرتين.  كذا في طبعة مكتبة العلوم والحكم ، وأظن الصواب: أم غطيف ، فلتحرر.","","Musnad al-Bazzar 4778","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن يوسف بن موسى بن راشد عن البزار","طاوس عن ابن عباس"
"4786","[11/75]      4779  -  حَدَّثَنَا  عُمَرُ بْنُ الْخَطَّابِ وَسَهْلُ بْنُ بَحْرٍ قَالَا :  نَا  عَمْرُو بْنُ حَمَّادِ بْنِ طَلْحَةَ الْقَنَّادُ قَالَ :  نَا  أَسْبَاطُ بْنُ نَصْرٍ  عَنْ  سِمَاكٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  جَاءَتْ  فَأْرَةٌ  فَأَخَذَتْ تَجُرُّ الْفَتِيلَةَ قَالَ : فَذَهَبَتِ الْجَارِيَةُ تَزْجُرُهَا فَقَالَ نَبِيُّ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : دَعِيهَا قَالَ : فَجَاءَتْ بِهَا فَأَلْقَتْهَا بَيْنَ يَدَيْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عَلَى  الْخُمْرَةِ  الَّتِي كَانَ قَاعِدًا عَلَيْهَا فَأَحْرَقَتْ مِنْهَا مِثْلَ مَوْضِعِ دِرْهَمٍ فَقَالَ :  إِذَا نِمْتُمْ فَأَطْفِئُوا سُرُجَكُمْ فَإِنَّ الشَّيْطَانَ يَدُلُّ هَذِهِ عَلَى هَذَا فَتَحْرِقَكُمْ  .","","Musnad al-Bazzar 4779","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن أسباط بن نصر الهمداني عن عمرو بن حماد القناد عن عمر بن الخطاب السجستاني عن البزار","طاوس عن ابن عباس"
"4787","4780  -  حَدَّثَنَا  سَهْلُ بْنُ بَحْرٍ ، قَالَ :  نَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ ، قَالَ         [11/76]      :  نَا  سُلَيْمَانُ بْنُ بِلَالٍ  عَنْ  عَمْرِو بْنِ أَبِي عَمْرٍو ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  شَهِدَ  بَدْرًا  مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ عِشْرُونَ رَجُلًا مِنَ الْمَوَالِي  .","","Musnad al-Bazzar 4780","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن عمرو بن أبي عمرو المخزومي عن سليمان بن بلال القرشي عن يحيى بن عبد الحميد عن سهل بن بحر القناد عن البزار","طاوس عن ابن عباس"
"4788","4781  -  حَدَّثَنَا  سَهْلٌ ، قَالَ :  نَا  سَعِيدُ بْنُ مُحَمَّدٍ الْجَرْمِيُّ ، قَالَ :  نَا  أَبُو تُمَيْلَةَ  عَنْ  سَعِيدِ بْنِ وَاقِدٍ  عَنِ  النَّحْوِيِّ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ  شَهِدَ مَعَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَوْمَ         [11/77]      فَتْحِ  مَكَّةَ  أَلْفٌ مِنْ  بَنِي سُلَيْمٍ  .  كذا في طبعة مكتبة العلوم والحكم ، والصواب : ( حسين بن واقد )","","Musnad al-Bazzar 4781","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يزيد بن أبي سعيد النحوي عن الحسين بن واقد المروزي عن يحيى بن واضح الأنصاري عن سعيد بن محمد الجرمي عن سهل بن بحر القناد عن البزار","طاوس عن ابن عباس"
"4789","4782  -  حَدَّثَنَا  سَهْلٌ ، قَالَ :  نَا  إِبْرَاهِيمُ بْنُ مُوسَى الْفَرَّاءُ ، قَالَ :  نَا  عَبْدُ اللهِ بْنُ عِصْمَةَ ،  عَنْ  أَبِي الصَّبَّاحِ ،  عَنْ  أَبِي هَاشِمٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  ثَلَاثَةٌ لَيْسَ عَلَيْهِمْ حِسَابٌ فِيمَا طَعِمُوا  إِنْ شَاءَ اللهُ إِذَا كَانَ حَلَالً  : الصَّائِمُ وَالْمُتَسَحِّرُ وَالْمُرَابِطُ فِي  سَبِيلِ  اللهِ  .  كذا في طبعة مكتبة العلوم والحكم : وقال المحقق: كذا بالأصل وهو لحن وصوابه: حلالا.","","Musnad al-Bazzar 4782","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن يحيى بن دينار الرماني عن عبد الغفور بن عبد العزيز الواسطي عن عبد الله بن عصمة عن إبراهيم بن موسى بن يزيد الفراء عن سهل بن صالح الأنطاكي عن البزار","طاوس عن ابن عباس"
"4790","[11/78]      4783  -  حَدَّثَنَا  سَهْلٌ ، قَالَ :  نَا  عَبْدُ الرَّحْمَنِ بْنُ صَالِحٍ ، قَالَ :  نَا  يُونُسُ بْنُ بُكَيْرٍ  عَنِ  ابْنِ إِسْحَاقَ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ  ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَمَّا وَجَّهَ  ابْنَ مَسْلَمَةَ  وَأَصْحَابَهُ إِلَى  ابْنِ الْأَشْرَفِ  لِيَقْتُلُوهُ مَشَى مَعَهُمْ إِلَى  بَقِيعِ الْغَرْقَدِ  ، ثُمَّ وَجَّهَهُمْ ثُمَّ قَالَ :  انْطَلِقُوا عَلَى اسْمِ اللهِ اللَّهُمَّ أَعِنْهُمْ  .  كذا في طبعة مكتبة العلوم والحكم وقال الضياء في المختارة في هذه الرواية ثور بن يزيد ، والصواب ( بن زيد) .","","Musnad al-Bazzar 4783","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن ثور بن زيد الديلي عن محمد بن إسحاق عن يونس بن بكير عن عبد الرحمن بن صالح العتكي عن سهل بن بحر العسكري عن البزار","طاوس عن ابن عباس"
"4791","4784  -  حَدَّثَنَا  سَهْلٌ ، قَالَ :  نَا  مُحَمَّدُ بْنُ سُلَيْمَانَ ، قَالَ :  نَا  إِسْمَاعِيلُ         [11/79]      بْنُ زَكَرِيَّا مَوْلَى بَنِي أَسَدٍ  عَنْ  مُحَمَّدِ بْنِ عَوْنٍ الْخُرَاسَانِيِّ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ أَحَدٍ إِلَّا يَلْقَى اللهَ قَدْ هَمَّ بِخَطِيئَةٍ  ، أَوْ عَمِلَهَا إِلَّا  يَحْيَى بْنَ زَكَرِيَّا  فَإِنَّهُ لَمْ يَهُمَّ بِهَا وَلَمْ يَعْمَلْهَا  .","","Musnad al-Bazzar 4784","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن محمد بن عون الخراساني عن إسماعيل بن زكريا شقوصا عن محمد بن سليمان لوين عن سهل بن بحر العسكري عن البزار","طاوس عن ابن عباس"
"4792","4785  -  حَدَّثَنَا  سَهْلٌ ، قَالَ :  نَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، قَالَ :  نَا  حَمَّادُ بْنُ         [11/80]      سَلَمَةَ ، قَالَ :  نَا  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ عَبْدًا  لِسَلَامٍ  لَمَّا هَاجَرَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ خَشِيَ أَهْلُهُ أَنْ يَتْبَعَ النَّبِيَّ فَقَيَّدُوهُ فَكَتَبَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّكَ قَدْ عَلِمْتَ بِإِسْلَامِي  فَسَيِّرْنِي أَوْ خَلِّصْنِي  ، فَبَعَثَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ سَبْعَةَ نَفَرٍ عَلَى بَعِيرٍ وَقَالَ :  لَعَلَّكُمْ تَجِدُونَ فِي دَارِهِ مَنْ يُعِينُكُمْ عَلَيْهِ ، فَأَعْتَقَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Musnad al-Bazzar 4785","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن سماك بن حرب البكري عن حماد بن سلمة عن مسلم بن إبراهيم الشحام عن سهل بن بحر القناد عن البزار","طاوس عن ابن عباس"
"4793","4786  -  حَدَّثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ ، قَالَ :  نَا  يَزِيدُ بْنُ هَارُونَ قَالَ :  أَنَا  حَجَّاجُ بْنُ أَرْطَاةَ  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّهُ كَانَ لَا يَرَى أَنْ يَنْزِلَ  الْأَبْطَحَ  فَيَقُولُ :  إِنَّمَا هُوَ مَنْزِلٌ  نَزَلَهُ ، أَوْ أَقَامَ بِهِ         [11/81]      رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِيهِ عَرِيشَهُ  .","","Musnad al-Bazzar 4786","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن يزيد بن هارون عن عقبة بن مكرم عن البزار","طاوس عن ابن عباس"
"4794","4787  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ ، قَالَ :  نَا  حَفْصُ بْنُ غِيَاثٍ  عَنْ  حَجَّاجٍ  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  عُمْرَةٌ فِي رَمَضَانَ تَعْدِلُ حَجَّةً  .","","Musnad al-Bazzar 4787","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن حفص بن غياث النخعي عن عبد الله بن سعيد الأشج عن البزار","طاوس عن ابن عباس"
"4795","4788  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ سَعِيدٍ ، قَالَ :  نَا  حَفْصٌ - يَعْنِي - ابْنَ غِيَاثٍ ، قَالَ :  نَا  حَجَّاجٌ  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ         [11/82]      عَنْهُمَا -  أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَبْصَرَ شَاةً مَيْتَةً شَاغِرَةً بِرِجْلَيْهَا فَقَالَ :  مَا ضَرَّ أَهْلَ هَذِهِ لَوِ انْتَفَعُوا بِإِهَابِهَا  ، فَدَبَغَتْهُ  سَوْدَةُ  وَانْتَبَذَتْ فِيهِ  .","","Musnad al-Bazzar 4788","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن حفص بن غياث النخعي عن عبد الله بن سعيد الأشج عن البزار","طاوس عن ابن عباس"
"4796","4789  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُعَاوِيَةَ بْنِ مَالِجٍ ، قَالَ :  نَا  عَبَّادُ بْنُ الْعَوَّامِ ، قَالَ :  نَا  الْحَجَّاجُ بْنُ أَرْطَاةَ  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  نَهَى عَنْ بَيْعِ النَّخْلِ سَنَتَيْنِ وَثَلَاثَةً  أَنْ يُشْتَرَى فِي رُءُوسِ النَّخْلِ بِكَيْلٍ ، أَوْ تُبَاعَ  الثَّمَرَةُ  حَتَّى يَبْدُوَ         [11/83]      صَلَاحُهَا  .","","Musnad al-Bazzar 4789","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن عباد بن العوام الكلابي عن محمد بن معاوية بن يزيد بن مالج الأنماطي عن البزار","طاوس عن ابن عباس"
"4797","4790  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ ، قَالَ :  نَا  عَمْرُو بْنُ صَالِحٍ ، قَالَ :  نَا  حَجَّاجٌ  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  كَانَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَرْمِي حَتَّى تَزُولَ الشَّمْسُ  .","","Musnad al-Bazzar 4790","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن عمرو بن صالح الأهوازي عن محمد بن معمر بن ربعي البحراني عن البزار","طاوس عن ابن عباس"
"4798","4791  -  حَدَّثَنَا  الْحَسَنُ بْنُ خَلَفٍ ، قَالَ :  نَا  إِسْحَاقُ بْنُ يُوسُفَ         [11/84]      عَنْ  شَرِيكٍ  عَنْ  حَجَّاجٍ  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا -  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  أَهْدَى  مِائَةَ بَدَنَةٍ مُقَلَّدَةٍ مُجَلَّلَةٍ  .","","Musnad al-Bazzar 4791","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن الحسن بن خلف البزاز عن البزار","طاوس عن ابن عباس"
"4799","4792  -  حَدَّثَنَا  الْحَسَنُ بْنُ خَلَفٍ الْوَاسِطِيُّ الضَّرِيرُ ، قَالَ :  نَا  إِسْحَاقُ ،  عَنْ  شَرِيكٍ ،  عَنْ  حَجَّاجٍ  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ ;  أَنَّ  الصَّعْبَ بْنَ جَثَّامَةَ  أَهْدَى إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحْرِمٌ  عَجُزَ حِمَارٍ فَرَدَّهَا وَلَمْ يَأْكُلْهَا  .","","Musnad al-Bazzar 4792","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن شريك بن عبد الله النخعي عن إسحاق بن يوسف الأزرق عن الحسن بن خلف البزاز عن البزار","طاوس عن ابن عباس"
"4800","4793  -  حَدَّثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدٍ قَالَ :  حَدَّثَنِي  عَمِّي قَالَ :  حَدَّثَنِي         [11/85]      أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  عَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ - رَضِيَ اللهُ عَنْهُمَا - قَالَ :  قُبِضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  وَأَنَا - قَالَ  أَبُو الْحَسَنِ  : أَحْسَبُهُ - وَأَنَا خَتِينٌ  .","","Musnad al-Bazzar 4793","","عبد الله بن عباس عن عطاء بن أبي رباح عن حجاج بن أرطاة عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبيد الله بن سعد بن إبراهيم الزهري عن البزار","طاوس عن ابن عباس"
