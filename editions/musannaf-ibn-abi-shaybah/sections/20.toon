hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"19039","(۱۹۰۳۹) حدَّثَنَا ابْنُ الدَّرَاوَرْدِیِّ ، عَنْ ہِشَامٍ أَنَّ أباہ طَلَّقَ فَمَتَّعَ بواحدۃ۔","","Musannaf Ibn Abi Shaybah 19039","","","كتاب الجنة"
"19040","(۱۹۰۴۰) حدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ عُبَیْدِ اللہِ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ أَنَّہُ طَلَّقَ فَمَتَّعَ بِوَلِیدَۃٍ۔","","Musannaf Ibn Abi Shaybah 19040","","","كتاب الجنة"
"19041","(۱۹۰۴۱) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنِ الْعُمَرِیِّ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ مَتَّعَ بِوَلِیدَۃٍ۔",": Da'if","Musannaf Ibn Abi Shaybah 19041","","","كتاب الجنة"
"19042","(۱۹۰۴۲) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ إسْمَاعِیلَ بْنِ أُمیَۃ ، عَنْ عکرمۃ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : أَرْفَعُ الْمُتْعَۃِ الْخَادِمُ ، ثُمَّ دُونَ ذَلِکَ : الْکِسْوَۃُ ، ثُمَّ دُونَ ذَلِکَ : النَّفَقَۃُ۔",": Sahih","Musannaf Ibn Abi Shaybah 19042","","","كتاب الجنة"
"19043","(۱۹۰۴۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : أَوْضَعُ الْمُتْعَۃِ الثَّوْبُ وَأَرْفَعُہَا الْخَادِمُ۔","","Musannaf Ibn Abi Shaybah 19043","","","كتاب الجنة"
"19044","(۱۹۰۴۴) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ قَالَ : مِنْ أَوْسَطِ الْمُتْعَۃِ الدِّرْعُ وَالْخِمَارُ وَالْمِلْحَفَۃُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19044","","","كتاب الجنة"
"19045","(۱۹۰۴۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ داود ، عَنِ الشَّعْبِیِّ فِی مَتَاعِ الْمُطَلَّقَۃِ : ثِیَابُہَا فِی بَیْتِہَا ، الدِّرْعُ وَالْخِمَارُ وَالْمِلْحَفَۃُ وَالْجِلْبَابُ۔","","Musannaf Ibn Abi Shaybah 19045","","","كتاب الجنة"
"19046","(۱۹۰۴۶) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ: کَانَ النَّاسُ یُمَتِّعُونَ فَمِنْہُمْ مَنْ یُمَتِّعُ بِالْخَادِمِ وَمِنْہُمْ مَنْ کَانَ یُعْطِی الْمِائَتَیْنِ وَمِنْہُمْ مَنْ کَانَ یُعْطِی الدِّرْعَ وَالْخِمَارَ وَالْمِلْحَفَۃَ وَمِنْہُمْ مَنْ کَانَ یُعْطِی النَّفَقَۃَ۔","","Musannaf Ibn Abi Shaybah 19046","","","كتاب الجنة"
"19047","(۱۹۰۴۷) حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ الْمُقْرِیء ، عَنْ سَعِیدِ بْنِ أَبِی أَیُّوبَ قَالَ : حدَّثَنِی عَقِیلٌ ، عَنِ ابْنِ شِہَابٍ قَالَ: أَعْلاَہُ الْخَادِمُ ، ثُمَّ الْکِسْوَۃُ ، ثُمَّ النَّفَقَۃُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19047","","","كتاب الجنة"
"19048","(۱۹۰۴۸) حَدَّثَنَا مُحَمَّدُ بْنُ أَبِی عَدِیٍّ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : الْمُسْتَحَاضَۃُ تَعْتَدُّ بِالأَقْرَائِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19048","","","كتاب الجنة"
"19049","(۱۹۰۴۹) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ، عَنْ رَوْحِ بْنِ الْقَاسِمِ، عَنْ عَمْرُو بْنُ دِینَارٍ، عَنْ جَابِرَ بْنِ زَیْدٍ قَالَ تَعْتَدُّ بِالأَقْرَائِ۔","","Musannaf Ibn Abi Shaybah 19049","","","كتاب الجنة"
"19050","(۱۹۰۵۰) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ رَوْحِ بْنِ الْقَاسِمِ ، عَنْ عَمْرِو بْنِ دِینَارٍ قَالَ طَاوُوسٌ : تَعْتَدُّ بِالشُّہُورِ۔","","Musannaf Ibn Abi Shaybah 19050","","","كتاب الجنة"
"19051","(۱۹۰۵۱) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ سَعِیدٍ ، عَنْ أَبِی رَجَائٍ ، عَنِ الْحَکَمِ ، وَعَطَائٍ أَنَّہُمَا قَالاَ : الْمُسْتَحَاضَۃُ تَعْتَدُّ بِالأَقْرَائِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19051","","","كتاب الجنة"
"19052","(۱۹۰۵۲) حَدَّثَنَا عَبْدُ السَّلاَمِ بْنُ حَرْبٍ ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنْ عَطَائٍ وَالْحَکَمِ ، وَالْحَسَنِ فِی الْمُسْتَحَاضَۃِ قَالُوا : تَعْتَدُّ بِأَیَّامِ أَقْرَائِہَا۔","","Musannaf Ibn Abi Shaybah 19052","","","كتاب الجنة"
"19053","(۱۹۰۵۳) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : تَعْتَدُّ بِالأَقْرَائِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19053","","","كتاب الجنة"
"19054","(۱۹۰۵۴) حَدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّرٍ ، عَنْ إبْرَاہِیمَ بْن طَہْمَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : الْمُسْتَحَاضَۃُ تَعْتَدُّ بِالأَقْرَائِ۔","","Musannaf Ibn Abi Shaybah 19054","","","كتاب الجنة"
"19055","(۱۹۰۵۵) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ حَمَّادٍ قَالَ : إذَا طَلَّقَ الرَّجُلُ الْمُسْتَحَاضَۃَ فَحَاضَتِ الثَّالِثَۃَ أَدْنَی مَا کَانَتْ تَحِیضُ فَلاَ یَمْلِکُ زَوْجُہَا الرَّجْعَۃَ وَلاَ تَغْتَسِلُ وَلاَ تُصَلِّی حَتَّی یَأْتِیَ عَلَیْہَا أَکْثَرُ مِمَّا کَانَتْ تَحِیضُ۔","","Musannaf Ibn Abi Shaybah 19055","","","كتاب الجنة"
"19056","(۱۹۰۵۶) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنْ مَالِکٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : عِدَّۃُ الْمُسْتَحَاضَۃِ سَنَۃٌ۔","","Musannaf Ibn Abi Shaybah 19056","","","كتاب الجنة"
"19057","(۱۹۰۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ، عَنْ عِکْرِمَۃَ قَالَ إِنَّ مِنْ رِیبَۃِ الْمُسْتَحَاضَۃُ وَالَّتِی لاَ تَسْتَقِیمُ لَھَا حَیْضَۃٌ تَحِیضُ فِی الشَّہْرِ مَرَّتَیْنِ وَفِی الأَشْہُرِ مَرَّۃً عِدَّتُہَا ثَلاَثَۃُ أَشْہُرٍ قَالَ : فَکَانَ قَتَادَۃُ ذَلِکَ رَأْیُہُ۔","","Musannaf Ibn Abi Shaybah 19057","","","كتاب الجنة"
"19058","(۱۹۰۵۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ جَعْفَرِ بْنِ أَبِی وَحْشِیَّۃَ ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : تَذَاکَرَ ابْنُ عَبَّاسٍ ، وَابْنُ عُمَرَ امْرَأَۃَ الْمَفْقُودِ فَقَالاَ : جَمِیعًا : تَرَبَّصُ أَرْبَعَ سِنِینَ ، ثُمَّ یُطَلِّقُہَا وَلِیُّ زَوْجِہَا ، ثُمَّ تَرَبَّصُ أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا ، ثُمَّ تَذَاکَرَا النَّفَقَۃَ فَقَالَ ابْنُ عُمَرَ : لَہَا النَّفَقَۃُ فِی مَالِہِ بِحَبْسِہَا نَفْسَہَا فِی سَبَبِہِ ، فَقَالَ ابْنُ عَبَّاسٍ : لَیْسَ کَذَلِکَ ، إذَنْ تُجْحِفُ بِالْوَرَثَۃِ وَلَکِنَّہَا تَأْخُذُ عَلَیْہِ فِی مَالِہِ فَإِنْ قَدِمَ فَذَلِکَ لَہَا عَلَیْہِ فِی مَالِہِ وَإِلاَّ فَلاَ شَیْئَ لَہَا۔","","Musannaf Ibn Abi Shaybah 19058","","","كتاب الجنة"
"19059","(۱۹۰۵۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ قَالَ : إذَا طُلِّقَتِ النُّفَسَائُ لاَ تَعْتَدُّ بِذَلِکَ الدَّمِ۔",": Sahih","Musannaf Ibn Abi Shaybah 19059","","","كتاب الجنة"
"19060","(۱۹۰۶۰) حَدَّثَنَا غُنْدَرٌ ، عَنْ أَشْعَثَ ، عَنِ الْحَسَنِ قَالَ : سُئِلَ عَنِ الْمَرْأَۃِ النُّفَسَائِ ہَلْ تَعْتَدُّ بِالنِّفَاسِ ؟ قَالَ : لاَ تَعْتَدُّ بِنِفَاسِہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 19060","","","كتاب الجنة"
"19061","(۱۹۰۶۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : إذَا طَلُقَتْ وَہِیَ نُفَسَائُ لَمْ تَعْتَدَّ بِدَمِ نِفَاسِہَا فی عدتہا۔","","Musannaf Ibn Abi Shaybah 19061","","","كتاب الجنة"
"19062","(۱۹۰۶۲) حَدَّثَنَا وَکِیعٌ قَالَ: حدَّثَنَا جَرِیرُ بْنُ حَازِمٍ ، عَنْ قَیْسِ بْنِ سَعْدٍ ، عَنْ بُکَیْرِ بْنِ عَبْدِ اللہِ بْنِ الأَشَجِّ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ، عَنْ زَیْدِ بْنِ ثَابِتٍ قَالَ: إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ وَہِیَ نُفَسَائُ لَمْ تَعْتَدَّ بِدَمِ نِفَاسِہَا فِی عِدَّتِہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 19062","","","كتاب الجنة"
"19063","(۱۹۰۶۳) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنِ الْحَارِثِ قَالَ : تَسْتَبِینُ الْمُسْتَحَاضَۃُ أَنَّہَا مُسْتَحَاضَۃٌ إذَا جَاوَزَتْ حَیْضَتُہَا آخِرَ مَا تَطْہُرُ فِیہِ النِّسَائُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19063","","","كتاب الجنة"
"19064","(۱۹۰۶۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مُطَرِّفٍ ، عَنِ الْحَکَمِ قَالَ : إذَا أَدْرَکَ قُرْئٌ قُرْئًا فَہِیَ مُسْتَحَاضَۃٌ۔","","Musannaf Ibn Abi Shaybah 19064","","","كتاب الجنة"
"19065","(۱۹۰۶۵) حَدَّثَنَا یَعْلَی بْنُ عُبَیْدٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ قَالَتْ : إنَّمَا الأَقْرَائُ الأَطْہَارُ۔",": Sahih","Musannaf Ibn Abi Shaybah 19065","","","كتاب الجنة"
"19066","(۱۹۰۶۶) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مَالِکِ بْنِ أَنَسٍ قَالَ : کَانَ الْقَاسِمُ وَسَالِمٌ یَقُولاَنِ : إن الأَقْرَائَ الأَطْہَارُ۔","","Musannaf Ibn Abi Shaybah 19066","","","كتاب الجنة"
"19067","(۱۹۰۶۷) حَدَّثَنَا ابْنُ أَبِی غَنِیَۃَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ قَالَ : الأَقْرَائُ الْحِیَضُ۔","","Musannaf Ibn Abi Shaybah 19067","","","كتاب الجنة"
"19068","(۱۹۰۶۸) حَدَّثَنَا حَفْصٌ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : عِدَّۃُ أُمِّ الْوَلَدِ ثَلاَثُ حِیَضٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19068","","","كتاب الجنة"
"19069","(۱۹۰۶۹) حَدَّثَنَا حَفْصٌ ، عَنْ أَشْعَثَ ، عَنِ ابْنِ سِیرِینَ قَالَ : ثَلاَثُ حِیَضٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19069","","","كتاب الجنة"
"19070","(۱۹۰۷۰) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ وَأَشْعَثُ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ قَالَ : ثَلاَثُ حِیَضٍ۔","","Musannaf Ibn Abi Shaybah 19070","","","كتاب الجنة"
"19071","(۱۹۰۷۱) حَدَّثَنَا حَفْصٌ ، عَنْ حَجَّاجٍ ، عَنْ عَامِرٍ ، عَنْ عَلِیٍّ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 19071","","","كتاب الجنة"
"19072","(۱۹۰۷۲) حَدَّثَنَا أَبُو خَالِدٍ ، عَنْ حَجَّاجٍ ، عَنِ الشَّعْبِیِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِیٍّ ، وَعَبْدِ اللہِ قَالاَ : ثَلاَثُ حِیَضٍ إذَا مَاتَ عَنْہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 19072","","","كتاب الجنة"
"19073","(۱۹۰۷۳) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : ثَلاَثَۃُ قُرُوئٍ۔","","Musannaf Ibn Abi Shaybah 19073","","","كتاب الجنة"
"19074","(۱۹۰۷۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنْ رَجَائِ بْنِ حَیْوَۃَ ، عَنْ قَبِیصَۃَ ، عَنْ عَمْرِو بْنِ الْعَاصِ أَنَّہُ قَالَ : لاَ تُلْبِسُوا عَلَیْنَا سُنَّۃَ نَبِیِّنَا ، عِدَّتُہَا عِدَّۃُ الْمُتَوَفَّی عَنْہَا زَوْجُہَا۔ (ابوداؤد ۲۳۰۲۔ ابویعلی ۷۳۰۰)","","Musannaf Ibn Abi Shaybah 19074","","","كتاب الجنة"
"19075","(۱۹۰۷۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ عَنْ فَضَالَۃَ بْنِ عُبَیْد ، وَعَنْ عَبْدِ رَبِّہِ ، عَنْ أَبِی عِیَاضٍ أَنَّہُما قَالاَ : عِدَّتُہَا إذَا تُوُفِّیَ عَنْہَا زوجہا عِدَّۃُ الْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 19075","","","كتاب الجنة"
"19076","(۱۹۰۷۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : عِدَّۃُ أُمِّ الْوَلَدِ إذَا تُوُفِّیَ عَنْہَا زوجہا أَرْبَعَۃُ أَشْہُرٍ وَعَشْرًا۔","","Musannaf Ibn Abi Shaybah 19076","","","كتاب الجنة"
"19077","(۱۹۰۷۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، عَنِ الْحَسَنِ ، وَسَعِیدِ بْنِ جُبَیْرٍ أَنَّہُمَا قَالاَ : عدۃ أُمِّ الْوَلَدِ إذَا تُوُفِّیَ عَنْہَا سَیِّدُہَا أَرْبَعَۃُ أَشْہُرٍ وَعَشْرًا۔","","Musannaf Ibn Abi Shaybah 19077","","","كتاب الجنة"
"19078","(۱۹۰۷۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ قَالَ : سَأَلَ الحَکَم بن عُتَیْبََۃَ الزُّہْرِیَّ ، عَنْ عِدَّۃِ أُمِّ الْوَلَدِ إذَا تُوُفِّیَ عَنْہَا سَیِّدُہَا ، فَقَالَ : السَّنَۃُ ، فقَالَ : وما السَّنَۃُ ؟ قَالَ : بَرِیرَۃُ أُعْتِقَتْ فَاعْتَدَّتْ عِدَّۃَ الْحُرَّۃِ۔\n(ابن ماجہ ۲۰۰۷۔ بیہقی ۲۵۱)","","Musannaf Ibn Abi Shaybah 19078","","","كتاب الجنة"
"19079","(۱۹۰۷۹) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : عِدَّۃُ أُمِّ الْوَلَدِ أَرْبَعَۃُ أَشْہُرٍ وَعَشْرًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 19079","","","كتاب الجنة"
"19080","(۱۹۰۸۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، وَسَعِیدِ بْنِ الْمُسَیَّبِ مِثْلَ ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19080","","","كتاب الجنة"
"19081","(۱۹۰۸۱) حَدَّثَنَا یَزِیدُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ عَلِیٍّ مِثْلَ ذَلِکَ۔",": Sahih","Musannaf Ibn Abi Shaybah 19081","","","كتاب الجنة"
"19082","(۱۹۰۸۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، وَابْنُ عُلَیَّۃَ ، عَنْ دَاوُدَ ، عَنِ الشَّعْبِیِّ ، عَنِ ابْنِ عُمَرَ قَالَ : عِدَّتُہَا حَیْضَۃٌ۔",": Sahih","Musannaf Ibn Abi Shaybah 19082","","","كتاب الجنة"
"19083","(۱۹۰۸۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ قَالَ : عِدَّۃُ أُمِّ الْوَلَدِ إذَا تُوُفِّیَ عنہا سَیِّدُہَا حَیْضَۃٌ۔","","Musannaf Ibn Abi Shaybah 19083","","","كتاب الجنة"
"19084","(۱۹۰۸۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : عِدَّتُہَا حَیْضَۃٌ إذَا تُوُفِّیَ عَنْہَا سَیِّدُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 19084","","","كتاب الجنة"
"19085","(۱۹۰۸۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، عَنْ زَیْدٍ قَالَ : عِدَّتُہَا حَیْضَۃٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 19085","","","كتاب الجنة"
"19086","(۱۹۰۸۶) حَدَّثَنَا عَبْدُ الْوَہَّابِ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ قَالَ : عِدَّتُہَا حَیْضَۃٌ۔","","Musannaf Ibn Abi Shaybah 19086","","","كتاب الجنة"
"19087","(۱۹۰۸۷) حَدَّثَنَا حَفْصٌ، عَنْ إسْمَاعِیلَ، عَنِ الشَّعْبِیِّ قَالَ: عِدَّتُہَا حَیْضَۃٌ فَلِمَ لاَ تُوَرِّثُونَہَا إذَا جَعَلْتُمُوہَا ثَلاَثَ حِیَضٍ۔","","Musannaf Ibn Abi Shaybah 19087","","","كتاب الجنة"
"19088","(۱۹۰۸۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ عَطَائٍ وَطَاوُسٍ قَالاَ : عِدَّۃُ أُمِّ الْوَلَدِ وَالسُّرِّیَّۃِ إذَا تُوُفِّیَ عَنْہَا سَیِّدُہَا شَہْرَانِ وَخَمْسُ لَیَالٍ۔","","Musannaf Ibn Abi Shaybah 19088","","","كتاب الجنة"
"19089","(۱۹۰۸۹) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، قَالَ : سَمِعْتُ الْقَاسِمَ وَذُکِرَ لَہُ أَنَّ عَبْدَ الْمَلِکِ بْنَ مَرْوَانَ فَرَّقَ بَیْنَ رِجَالٍ وَنِسَائِہِمْ کُنَّ أُمَّہَاتِ أَوْلاَدٍ نُکِحْنَ بَعْدَ حَیْضَۃٍ ، أَوْ حَیْضَتَیْنِ حَتَّی یَعْتَدِدْنَ أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا فَقَالَ : سُبْحَانَ اللہِ ، یَقُولُ اللَّہُ فِی کِتَابِہِ : {وَالَّذِینَ یُتَوَفَّوْنَ مِنْکُمْ وَیَذَرُونَ أَزْوَاجًا} أَتُرَاہُنَّ مِنَ الأزْوَاج۔","","Musannaf Ibn Abi Shaybah 19089","","","كتاب الجنة"
"19090","(۱۹۰۹۰) حَدَّثَنَا عِیسَی بْنُ یُونُسَ ، عَنِ الأَوْزَاعِیِّ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ أنَّ عَمْرَو بْنَ الْعَاصِ أَمَرَ أُمَّ وَلَدٍ أُعْتِقَتْ أَنْ تَعْتَدَّ ثَلاَثَ حِیَضٍ وَکَتَبَ إلَی عُمَرَ فَکَتَبَ یُحَسِّن رَأْیہ۔","","Musannaf Ibn Abi Shaybah 19090","","","كتاب الجنة"
"19091","(۱۹۰۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : إذَا أَعْتَقَہَا فَعِدَّتُہَا ثَلاَثُ حِیَضٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19091","","","كتاب الجنة"
"19092","(۱۹۰۹۲) حَدَّثَنَا وَکِیعٌ، عَنْ شُعْبَۃَ، عَنِ الْحَکَمِ، عَنْ إبْرَاہِیمَ قَالَ: إذَا أَعْتَقَہَا، أَوْ مَاتَ عَنْہَا فَعِدَّتُہَا ثَلاَثُ حِیَضٍ۔","","Musannaf Ibn Abi Shaybah 19092","","","كتاب الجنة"
"19093","(۱۹۰۹۳) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ قَالَ : إذَا أَعْتَقَ الرَّجُلُ أُمَّ وَلَدِہِ اعْتَدَّتْ بِحَیْضَتَیْنِ : وَقَالَ الزُّہْرِیُّ : ثَلاَثَۃَ قُرُوئٍ۔","","Musannaf Ibn Abi Shaybah 19093","","","كتاب الجنة"
"19094","(۱۹۰۹۴) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَبِیبٍ، عَنْ عَمْرٍو قَالَ: سُئِلَ جَابِرُ بْنُ زَیْدٍ عَنِ الرَّجُلِ إذَا أَعْتَقَ سُرِّیَّتَہُ وَہُوَ صَحِیحٌ اعْتَدَّتْ ثَلاَثَۃَ قُرُوئٍ إذا کَانَتْ تَحِیضُ ، وَإِنْ لَمْ تَکُنْ تَحِیضُ فَعِدَّتُہَا ثَلاَثَۃُ أَشْہُرٍ إِنْ تَزَوَّجَہَا غَیْرُہُ۔","","Musannaf Ibn Abi Shaybah 19094","","","كتاب الجنة"
"19095","(۱۹۰۹۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ أَنَّہُ کَانَ یَقُولُ : عِدَّتُہَا حَیْضَۃٌ إذَا أَعْتَقَہَا ، أَوْ مَاتَ عَنْہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 19095","","","كتاب الجنة"
"19096","(۱۹۰۹۶) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ حَبِیبٍ الْمُعَلِّمِ ، عَنِ الْحَسَنِ ، عَنْ عَلِیٍّ : عِدَّۃُ الأَمَۃِ حَیْضَتَانِ فَإِنْ لَمْ تَکُنْ تَحِیضُ فَشَہْرٌ وَنِصْفٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 19096","","","كتاب الجنة"
"19097","(۱۹۰۹۷) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : عِدَّۃُ الأَمَۃِ حَیْضَتَانِ فَإِنْ لَمْ تَکُنْ تَحِیضُ فَشَہْرٌ وَنِصْفٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19097","","","كتاب الجنة"
"19098","(۱۹۰۹۸) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 19098","","","كتاب الجنة"
"19099","(۱۹۰۹۹) حَدَّثَنَا وَکِیعٌ ، عَنْ دَاوُدَ بْنِ قَیْسٍ قَالَ : سَأَلْتُ سَالِمَ بْنَ عَبْدِ اللہِ ، عَنْ عِدَّۃِ الأَمَۃِ فَقَالَ : حَیْضَتَانِ فَإِنْ لَمْ تَکُنْ تَحِیضُ فَشَہْرٌ وَنِصْفٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19099","","","كتاب الجنة"
"19100","(۱۹۱۰۰) حَدَّثَنَا وَکِیعٌ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : عِدَّۃُ الأَمَۃِ حَیْضَتَانِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19100","","","كتاب الجنة"
"19101","(۱۹۱۰۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : إِنْ کَانَتْ تَحِیضُ فَحَیْضَتَانِ ، وَإِنْ کَانَتْ ممن لاَ تَحِیضُ فَشَہْرٌ وَنِصْفٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19101","","","كتاب الجنة"
"19102","(۱۹۱۰۲) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ مَطَرٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عُمَرَ قَالَ : عِدَّۃُ الأَمَۃِ حَیْضَتَانِ إِنْ کَانَتْ تَحِیضُ فَإِنْ لَمْ تَکُنْ تَحِیضُ فَشَہْرٌ وَنِصْفٌ۔",": Da'if","Musannaf Ibn Abi Shaybah 19102","","","كتاب الجنة"
"19103","(۱۹۱۰۳) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرِو سَمع عَمْرَو بْنَ أَوْسٍ یَقُولُ : أَخْبَرَنِی رَجُلٌ مِنْ ثَقِیفٍ یَقُولُ : سَمِعْت عُمَرَ بْنَ الْخَطَّابِ یَقُولُ : لَوِ اسْتَطَعْت أَنْ أَجْعَلَ عِدَّۃَ الأَمَۃِ حَیْضَۃً وَنِصْفًا فَعَلْت فَقَالَ لَہُ رَجُلٌ : لَوْ جَعَلْتہَا شَہْرًا وَنِصْفًا فَسَکَتَ۔",": Da'if","Musannaf Ibn Abi Shaybah 19103","","","كتاب الجنة"
"19104","(۱۹۱۰۴) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : عِدَّۃُ الأَمَۃِ حَیْضَتَانِ فَإِنْ لَمْ تَکُنْ تَحِیضُ فَشَہْرَانِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19104","","","كتاب الجنة"
"19105","(۱۹۱۰۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ فِی الأَمَۃِ الَّتِی لَمْ تَحِضْ وَقَدْ رَاہَقَتْ : عِدَّتُہَا خَمْسَۃٌ وَأَرْبَعُونَ یَوْمًا فَإِنْ کَانَتْ تَحِیضُ فَعِدَّتُہَا حَیْضَۃٌ۔","","Musannaf Ibn Abi Shaybah 19105","","","كتاب الجنة"
"19106","(۱۹۱۰۶) حَدَّثَنَا أَبُو سَعِیدٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ؛ فِی عِدَّۃِ الأَمَۃِ قَالَ : إِنْ کَانَتْ تَحِیضُ فَحَیْضَتَانِ ، وَإِنْ لَمْ تَکُنْ تَحِیضُ فَعِدَّتُہَا خَمْسَۃٌ وَأَرْبَعُونَ یَوْمًا۔","","Musannaf Ibn Abi Shaybah 19106","","","كتاب الجنة"
"19107","(۱۹۱۰۷) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ قَالَ : عِدَّۃُ الأَمَۃِ مِثْلُ نِصْفِ عِدَّۃِ الْحُرَّۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19107","","","كتاب الجنة"
"19108","(۱۹۱۰۸) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ فِی الأَمَۃِ الَّتِی تُوطَأُ : إذَا بِیعَتْ ، أَوْ وُہِبَتْ ، أَوْ أُعْتِقَتْ فَلْتُسْتَبْرَأْ بِحَیْضَۃٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 19108","","","كتاب الجنة"
"19109","(۱۹۱۰۹) حَدَّثَنَا عَبْدُ اللہِ بْنُ إدْرِیسَ ، عَنْ أَبِیہِ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ فِی الأَمَۃِ إذَا أُعْتِقَتْ قَالَ : عِدَّتُہَا ثَلاَثُ حِیَضٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19109","","","كتاب الجنة"
"19110","(۱۹۱۱۰) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ، عَنْ حَجَّاجٍ ، عَنِ الْحَکَمِ ، عَنْ عَلِیٍّ فِی الأَمَۃِ إذَا أُعْتِقَتْ قَالَ: تَعْتَدُّ ثَلاَثَۃَ قُرُوئٍ۔","","Musannaf Ibn Abi Shaybah 19110","","","كتاب الجنة"
"19111","(۱۹۱۱۱) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ قَالَ : الأَمَۃُ إذَا أُعْتِقَتِ اعْتَدَّتْ بِحَیْضَتَیْنِ ، وَقَالَ الزُّہْرِیُّ : ثَلاَثَۃَ قُرُوئٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19111","","","كتاب الجنة"
"19112","(۱۹۱۱۲) حَدَّثَنَا عُمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : تَعْتَدُّ ثَلاَثَ حِیَضٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19112","","","كتاب الجنة"
"19113","(۱۹۱۱۳) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ أَنَّ النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ أَمَرَ بَرِیرَۃَ أَنْ تَعْتَدَّ عِدَّۃَ الْحُرَّۃِ۔",": Hasan","Musannaf Ibn Abi Shaybah 19113","","","كتاب الجنة"
"19114","(۱۹۱۱۴) حَدَّثَنَا ہُشَیْمٌ ، عَنْ خَالِدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ أَنَّ بَرِیرَۃَ اعْتَدَّتْ عِدَّۃَ الْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 19114","","","كتاب الجنة"
"19115","(۱۹۱۱۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنِ الزُّہْرِیِّ قَالَ بَرِیرَۃُ أُعْتِقَتْ فَاعْتَدَّتْ عِدَّۃَ الْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 19115","","","كتاب الجنة"
"19116","(۱۹۱۱۶) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ فِی الأَمَۃِ طَلُقَتْ تَطْلِیقَتَیْنِ لَمْ یُدْرِکْہَا عَتَاقُہُ قَبْلَ أَنْ تَنْقَضِیَ قَالَ : تَعْتَدُّ عِدَّۃَ الأَمَۃِ۔","","Musannaf Ibn Abi Shaybah 19116","","","كتاب الجنة"
"19117","(۱۹۱۱۷) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا طُلِّقَتْ تَطْلِیقَۃً ، ثُمَّ أَدْرَکَہَا عَتَاقُہُ قَبْلَ أَنْ تَنْقَضِیَ عِدَّتُہَا اعْتَدَّتْ عِدَّۃَ الْحُرَّۃِ وَإِذَا طَلُقَتْ تَطْلِیقَتَیْنِ ، ثُمَّ أَدْرَکَتہَا عَتَاقُہُ اعْتَدَّتْ عِدَّۃَ الأَمَۃِ لَمَّا بَانَتْ مِنْہُ ، وَالْمُتَوَفَّی عَنْہَا کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 19117","","","كتاب الجنة"
"19118","(۱۹۱۱۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ قَالَ : إذَا طَلَّقَ الرَّجُلُ امْرَأَتَہُ وَہِیَ أَمَۃٌ تَطْلِیقَۃً ، ثُمَّ أُعْتِقَتْ فِی الْعِدَّۃِ فَعِدَّتُہَا عِدَّۃُ حُرَّۃٍ وَإِذَا طَلَّقَہَا تَطْلِیقَتَیْنِ ، ثُمَّ أُعْتِقَتْ قَالَ : لاَ یَتَزَوَّجُہَا حَتَّی تَزَوَّجَ زَوْجًا غَیْرَہُ ، وَعِدَّتُہَا عِدَّۃُ أَمَۃِ۔","","Musannaf Ibn Abi Shaybah 19118","","","كتاب الجنة"
"19119","(۱۹۱۱۹) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ حَمَّادِ بْنِ زَیْدٍ ، عَنْ عَلِیِّ بْنِ الْحَکَمِ ، عَنِ الضَّحَّاکِ فِی الأَمَۃِ إذَا طُلِّقَتْ تَطْلِیقَتَیْنِ ، ثُمَّ أُعْتِقَتْ فِی عِدَّتِہَا قَالَ : تَعْتَدُّ حَیْضَتَیْنِ ، وَإِنْ طَلُقَتْ وَاحِدَۃً فَأُعْتِقَتْ فِی عِدَّتِہَا قَالَ : تَعْتَدُّ ثَلاَثَ حِیَضٍ وَزَوْجُہَا أَحَقُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 19119","","","كتاب الجنة"
"19120","(۱۹۱۲۰) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّہُ قَالَ : عِدَّتُہَا عِدَّۃُ الْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 19120","","","كتاب الجنة"
"19121","(۱۹۱۲۱) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ قَالَ: حدَّثَنَا إسْمَاعِیلُ بْنُ أَبِی خَالِدٍ ، عَنْ عَامِرٍ قَالَ : إذَا طُلِّقَتِ الأَمَۃُ تَطْلِیقَتَیْنِ، ثُمَّ أُعْتِقَتْ عِنْدَ ذَلِکَ فَعِدَّتُہَا عِدَّۃُ الأَمَۃِ ، وَإِذَا طُلِّقَتْ وَاحِدَۃً ، ثُمَّ أُعْتِقَتْ عِنْدَ ذَلِکَ فَعِدَّتُہَا عِدَّۃُ الْحُرَّۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19121","","","كتاب الجنة"
"19122","(۱۹۱۲۲) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی امْرَأَۃٍ مَاتَ عَنْہَا زَوْجُہَا ، ثُمَّ أُعْتِقَتْ قَالَ : تَمْضِی عَلَی عِدَّۃِ الأَمَۃِ وَلَیْسَ لَہَا إلاَّ عِدَّۃُ الأَمَۃِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19122","","","كتاب الجنة"
"19123","(۱۹۱۲۳) حَدَّثَنَا عُمَرُ بْنُ زُرْعَۃَ ، عَنِ ابْنِ سَالِمٍ ، عَنِ الشَّعْبِیِّ ، أَنَّہُ کَانَ یَقُولُ : إذَا تُوُفِّیَ عَنْہَا زَوْجُہَا وَہِیَ مَمْلُوکَۃٌ فَأَدْرَکَہَا الْعِتْقُ وَہِیَ فِی عِدَّتِہَا فتتم أَرْبَعَۃُ أَشْہُرٍ وَعَشْرًا۔","","Musannaf Ibn Abi Shaybah 19123","","","كتاب الجنة"
"19124","(۱۹۱۲۴) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ صَالِحِ بْنِ مُسْلِمٍ قَالَ : قُلْتُ لِلشَّعْبِیِّ : رَجُلٌ طَلَّقَ امْرَأَتَہُ فَجَائَ آخَرُ فَتَزَوَّجَہَا ؟ قَالَ عُمَرُ : یُفَرَّقُ بَیْنَہُمَا وَتُکْمِلُ عِدَّتَہَا الأُولَی ، وَتأْتنِف مِنْ ہَذَا عِدَّۃً جَدِیدَۃً وَیُجْعَلُ الصَّدَاقُ فِی بَیْتِ الْمَالِ وَلاَ یَتَزَوَّجُہَا الثَّانِی أَبَدًا ، وَیَصِیرُ الأَوَّلُ خَاطِبًا ، وَقَالَ عَلِیٌّ : یُفَرَّقُ بَیْنَہَا وَبَیْنَ زَوْجِہَا ، وَتُکْمِلُ عِدَّتَہَا الأُولَی ، وَتَعْتَدُّ مِنْ ہَذَا عِدَّۃً جَدِیدَۃً ، وَیُجْعَلُ لَہَا الصَّدَاقُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا ، وَیَصِیرَانِ کِلاَہُمَا خَاطِبَیْنِ۔","","Musannaf Ibn Abi Shaybah 19124","","","كتاب الجنة"
"19125","(۱۹۱۲۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنْ إبْرَاہِیمَ وَالشَّعْبِیِّ فِی امْرَأَۃٍ تَزَوَّجَتْ فِی عِدَّتِہَا قَالَ الشَّعْبِیُّ : تَسْتَأْنِفُ ثَلاَثَۃَ قُرُوئٍ وَتُکْمِلُ مَا بَقِیَ عَلَیْہَا مِنَ الأَوَّلِ ، وَقَالَ إبْرَاہِیمُ : تُکْمِلُ مَا بَقِیَ مِنَ الأَوَّلِ وَتَسْتَأْنِفُ ثَلاَثَۃَ قُرُوئٍ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19125","","","كتاب الجنة"
"19126","(۱۹۱۲۶) حَدَّثَنَا یَحْیَی بْنُ عَبْدِ الْمَلِکِ بْنِ أَبِی غَنِیَّۃَ ، عَنْ أَبِیہِ ، عَنِ الْحَکَمِ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَتُکْمِلُ عِدَّتَہَا مِنَ الأَوَّلِ ، وَتَعْتَدُّ مِنْ مَائِ الآخَرِ ، وَیَکُونُ لَہَا الْمَہْرُ بِمَا اسْتَحَلَّ مِنْ فَرْجِہَا ، فَإِذَا انْقَضَتْ عِدَّتُہَا فَلْتَزَوَّجْہُ ، أَوْ غَیْرَہُ إِنْ شَائَتْ۔","","Musannaf Ibn Abi Shaybah 19126","","","كتاب الجنة"
"19127","(۱۹۱۲۷) حَدَّثَنَا عبد اللہ بْنُ نُمَیْرٍ ، عَنْ حَجَّاجٍ ، عَنْ قَتَادَۃَ ، عَنْ خِلاَسٍ ، عَنْ عَلِیٍّ ؛ فِی الرَّجُلِ یَتَزَوَّجُ الأَمَۃَ وَلَہَا وَلَدٌ مِنْ غَیْرِہِ فَیَمُوتُ قَالَ : لاَ یَقْرَبُہَا حَتَّی یَتَبَیَّنَ لَہُ مَا فِی بَطْنِہَا ، أَوْ تَحِیضَ حَیْضَۃً۔","","Musannaf Ibn Abi Shaybah 19127","","","كتاب الجنة"
"19128","(۱۹۱۲۸) حَدَّثَنَا یَحْیَی بْنُ زَکَرِیَّا ، عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ ، عَنْ إبْرَاہِیمَ بْنِ مَیْسَرَۃَ ، عَنْ عُمَرَ قَالَ : لاَ یَقْرَبُہَا حَتَّی یَنْظُرَ ہل بہا حَبْلٌ ، أَوْ لاَ۔","","Musannaf Ibn Abi Shaybah 19128","","","كتاب الجنة"
"19129","(۱۹۱۲۹) حَدَّثَنَا یحیی بْنُ عَیَّاشٍ ، عَنِ الشَّیْبَانِیِّ ، عَنْ حَسَّانِ بْنِ الْمُخَارِقِ أَنَّ الْحَسَنَ بْنَ عَلِیٍّ قَالَ : لاَ یَقْرَبُہَا حَتَّی تَعْتَدَّ ، أَوْ قَالَ : حَتَّی تَحِیضَ۔",": Da'if","Musannaf Ibn Abi Shaybah 19129","","","كتاب الجنة"
"19130","(۱۹۱۳۰) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ أَنَّ الْحَسَنَ بْنَ عَلِیٍّ صَلَّی عَلَی جِنَازَۃٍ فَقَالَ لِلزَّوْجِ وَلِلْمَرْأَۃِ وَلَدٌ مِنْ غَیْرِہِ : لَیْسَ لَکَ أَنْ تَسْتَلْحِقَ سَہْمًا لَیْسَ لَک۔",": Da'if","Musannaf Ibn Abi Shaybah 19130","","","كتاب الجنة"
"19131","(۱۹۱۳۱) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ وَعُمَارَۃَ قَالاَ : لاَ یَقْرَبُہَا حَتَّی یبین حَمْلٌ أَمْ لاَ۔","","Musannaf Ibn Abi Shaybah 19131","","","كتاب الجنة"
"19132","(۱۹۱۳۲) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ قَالَ : لاَ یَقْرَبُہَا حَتَّی تَحِیضَ حَیْضَۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 19132","","","كتاب الجنة"
"19133","(۱۹۱۳۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدٍ ، وَالْحَسَنِ قَالاَ : أَجَّلَ عُمَرُ بْنُ الْخَطَّابِ الْعِنِّینَ سَنَۃً فَإِنِ اسْتَطَاعَہَا وَإِلاَّ فَرَّقَ بَیْنَہُمَا وَعَلَیْہَا الْعِدَّۃُ۔",": Da'if","Musannaf Ibn Abi Shaybah 19133","","","كتاب الجنة"
"19134","(۱۹۱۳۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ قَالَ : إذَا مَضَتِ السَّنَۃُ اعْتَدَّتْ بَعْدَ السَّنَۃِ عِدَّۃَ الْمُطَلَّقَۃِ ، وَإِنْ لَمْ یُطَلِّقْہَا۔","","Musannaf Ibn Abi Shaybah 19134","","","كتاب الجنة"
"19135","(۱۹۱۳۵) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ فِی امْرَأَۃِ الْعِنِّینِ قَالَ : عَلَیْہَا الْعِدَّۃُ إذَا فُرِّقَ بَیْنَہُمَا۔","","Musannaf Ibn Abi Shaybah 19135","","","كتاب الجنة"
"19136","(۱۹۱۳۶) حَدَّثَنَا أَسْوَدُ بْنُ عَامِرٍ قَالَ : حدَّثَنَا حَمَّادُ بْنُ سَلَمَۃَ ، عَنْ ہِشَامِ بن عُرْوَۃَ ، عَنْ أَبِیہِ قَالَ : عَلَیْہَا الْعِدَّۃُ۔","","Musannaf Ibn Abi Shaybah 19136","","","كتاب الجنة"
"19137","(۱۹۱۳۷) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مُوسَی بْنِ أَبِی کَثِیرٍ أَبِی الصَّبَّاحِ قَالَ : قُلْتُ لِسَعِیدِ بْنِ الْمُسَیَّبِ : کَمْ تَعْتَدُّ امْرَأَتُہُ ؟ یَعْنِی الْمُرْتَدَّ ، قَالَ : ثَلاَثَۃَ قُرُوئٍ ، قُلْتُ : فَإِنْ قُتِلَ ؟ قَالَ : أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا۔","","Musannaf Ibn Abi Shaybah 19137","","","كتاب الجنة"
"19138","(۱۹۱۳۸) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ وَالْحَکَمِ قَالاَ : ؛ فِی الرَّجُلِ الْمُسْلِمِ یَرْتَدُّ ، عَنِ الإِسْلاَمِ وَیَلْحَقُ بِأَرْضِ الْعَدُوِّ قَالاَ : تَعْتَدُّ امرأتہ ثَلاَثَۃَ قُرُوئٍ إِنْ کَانَتْ تَحِیضُ ، وَإِنْ کَانَتْ لاَ تَحِیضُ فَثَلاَثَۃَ أَشْہُرٍ ، وَإِنْ کَانَتْ حَامِلاً أن َتَضَعُ حَمْلَہَا ، ثُمَّ تَزَوَّجُ إِنْ شَائَتْ ، وَإِنْ ہُوَ رَجَعَ فَتَابَ قَبْلَ أَنْ تَنْقَضِیَ عِدَّتُہَا یَثْبُتَانِ عَلَی نِکَاحِہِمَا۔","","Musannaf Ibn Abi Shaybah 19138","","","كتاب الجنة"
"19139","(۱۹۱۳۹) حَدَّثَنَا عَبْدُ الرَّحِیمِ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ ، عَنِ الْحَسَنِ قَالَ : إذَا ارْتَدَّ الرَّجُلُ ، عَنِ الإِسْلاَمِ فَقَدْ بَانَتْ مِنْہُ امْرَأَتُہُ بِتَطْلِیقَۃٍ بَائِنَۃٍ وَلَیْسَ عَلَیْہَا سَبِیلٌ إِنْ رَجَعَ وَتَعْتَدُّ عِدَّۃَ الْمُطَلَّقَۃِ۔","","Musannaf Ibn Abi Shaybah 19139","","","كتاب الجنة"
"19140","(۱۹۱۴۰) حَدَّثَنَا عَبْدُ الرَّحِیمِ ، عَنْ إسْمَاعِیلَ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : ہُوَ أَحَقُّ بہا مَا دَامَتْ فِی الْعِدَّۃِ، إِنْ رَجَعَ وَہِیَ فِی عِدَّتِہَا فَہِیَ امْرَأَتُہُ ، قَالَ أَبُو مَعْشَرٍ : فَکَتَبَ بِذَلِکَ عُمَرُ بْنُ عَبْدِ الْعَزِیزِ إلَی عَبْدِ الْحَمِیدِ بْنِ عَبْدِ الرَّحْمَنِ فِی الْمُرْتَدِّ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19140","","","كتاب الجنة"
"19141","(۱۹۱۴۱) حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ مَہْدِیٍّ ، عَنْ زِیَادٍ ، عَنْ عَبْدِ الرَّحْمَنِ قَالَ : سَأَلْتُ الشَّعْبِیَّ ، عَنِ امْرَأَۃٍ ذِمِّیَّۃٍ طُلِّقَتْ فَأَسْلَمَتْ فِی عِدَّتِہَا ، قَالَ : إذَا أَسْلَمَتْ فِی عِدَّتِہَا لَزِمَہَا مَا لَزِمَ الْمُسْلِمَاتِ۔","","Musannaf Ibn Abi Shaybah 19141","","","كتاب الجنة"
"19142","(۱۹۱۴۲) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ أَبِی حُرَّۃَ قَالَ : سُئِلَ الْحَسَنُ ، عَنْ نَصْرَانِیَّۃٍ تحت نَصْرَانِیٍّ فَأَسْلَمَتْ یُفَرَّقُ بَیْنَہُمَا ؟ قَالَ : نَعَمْ ، قَالَ : عَلَیْہَا عِدَّۃٌ قَالَ : نَعَمْ ، عَلَیْہَا عِدَّۃُ ثَلاَثِ حِیَضٍ ، أَوْ ثَلاَثَۃِ أَشْہُرٍ۔","","Musannaf Ibn Abi Shaybah 19142","","","كتاب الجنة"
"19143","(۱۹۱۴۳) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ عَبْدِ الْمَلِکِ قَالَ : سُئِلَ عَطَائٌ ، عَنِ الْمَرْأَۃِ یَمُوتُ زَوْجُہَا وَہو نَصْرَانِیّ ، ثُمَّ تُسْلِمُ کَمْ تَعْتَدُّ ؟ قَالَ : أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا۔","","Musannaf Ibn Abi Shaybah 19143","","","كتاب الجنة"
"19144","(۱۹۱۴۴) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ أَنَّہُ کَانَ یَقُولُ : طَلاَقُ الْیَہُودِیَّۃِ وَالنَّصْرَانِیَّۃ طَلاَقُ الْمُسْلِمَۃِ وَعِدَّتُہُمَا عِدَّۃُ الْحُرَّۃِ الْمُسْلِمَۃِ۔","","Musannaf Ibn Abi Shaybah 19144","","","كتاب الجنة"
"19145","(۱۹۱۴۵) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَالْحَسَنِ فِیمَنْ تَزَوَّجَ الْیَہُودِیَّۃَ ، أَوِ النَّصْرَانِیَّۃَ عَلَی الْمُسْلِمَۃِ قَالَ : یَقْسِمُ بَیْنَہُمَا سَوَائً وَطَلاَقُہَا طَلاَقُ حُرَّۃٍ وَعِدَّتُہَا کَذَلِکَ۔","","Musannaf Ibn Abi Shaybah 19145","","","كتاب الجنة"
"19146","(۱۹۱۴۶) حَدَّثَنَا عَبْدُ اللہِ بْنُ نُمَیْرٍ ، عَنْ عُبَیْدَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : طَلاَقُ الْیَہُودِیَّۃِ وَالنَّصْرَانِیَّۃ طَلاَقُ الْحُرَّۃِ وَعِدَّتُہُمَا عِدَّۃُ الْحُرَّۃِ وَیَقْسِمُ لَہُمَا کَمَا یَقْسِمُ لِلْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 19146","","","كتاب الجنة"
"19147","(۱۹۱۴۷) حَدَّثَنَا مَعْنُ بْنُ عِیسَی ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ قَالَ : عِدَّۃُ النَّصْرَانِیَّۃِ مِثْلُ عِدَّۃِ الْمُسْلِمَۃِ وَقِسْمَتُہُمَا سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 19147","","","كتاب الجنة"
"19148","(۱۹۱۴۸) حَدَّثَنَا أَسْبَاطُ بْنُ مُحَمَّدٍ ، عَنْ مُطَرِّفٍ ، عَنْ عَامِرٍ ؛ فِی الرَّجُلِ یَتَزَوَّجُ الْمُسْلِمَۃَ وَالْیَہُودِیَّۃَ ، أَوِ النَّصْرَانِیَّۃَ قَالَ : یُسَوِّی بَیْنَہُمَا فی الْقَسم مِنْ مَالِہِ وَنَفْسِہِ۔","","Musannaf Ibn Abi Shaybah 19148","","","كتاب الجنة"
"19149","(۱۹۱۴۹) حَدَّثَنَا شَبَابَۃُ ، عَنْ شُعْبَۃَ قَالَ : سَأَلْتُ الْحَکَمَ وَحَمَّادًا عَنِ الرَّجُلِ یَتَزَوَّجُ النَّصْرَانِیَّۃَ فَقَالاَ : قِسْمَتُہُمَا سَوَائٌ۔","","Musannaf Ibn Abi Shaybah 19149","","","كتاب الجنة"
"19150","(۱۹۱۵۰) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ لَیْثٍ ، عَنْ أَبِی عَمْرٍو الْعَبْدِیِّ ، عَنْ عَلِیٍّ قَالَ : إذَا وَضَعَتْ وَلَدًا وَبَقِیَ فِی بَطْنِہَا وَلَدٌ فَہُوَ أَحَقُّ بِہَا مَا لَمْ تَضَعِ الآخَرَ۔",": Da'if","Musannaf Ibn Abi Shaybah 19150","","","كتاب الجنة"
"19151","(۱۹۱۵۱) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائِ بْنِ مَیْسَرَۃَ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : إذَا وَضَعَتْ وَلَدًا وَبَقِیَ فِی بَطْنِہَا وَلَدٌ فَہُوَ أَحَقُّ بِرَجْعَتِہَا مَا لَمْ تَضَعِ الآخَرَ۔","","Musannaf Ibn Abi Shaybah 19151","","","كتاب الجنة"
"19152","(۱۹۱۵۲) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ مِثْلَہُ۔","","Musannaf Ibn Abi Shaybah 19152","","","كتاب الجنة"
"19153","(۱۹۱۵۳) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، وَعَطَائٍ وَسُلَیْمَانَ بْنِ یَسَارٍ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ تَطْلِیقَۃً فَتَضَعُ وَلَدًا ، ویکون فِی بَطْنِہَا آخَرُ ، فَیُرَاجِعُہَا زَوْجُہَا فِیمَا بَیْنَ ذَلِکَ قَالُوا : إِنْ شَائَ رَاجَعَہَا حَتَّی تَضَعَ الآخَرَ مِنْہما۔","","Musannaf Ibn Abi Shaybah 19153","","","كتاب الجنة"
"19154","(۱۹۱۵۴) حَدَّثَنَا أَبُو دَاوُدَ الطَّیَالِسِیُّ ، عَنْ ہِشَامٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ وَفِی بَطْنِہَا وَلَدَانِ ، قَالَ ہُوَ أَحَقُّ بِرَجْعَتِہَا مَا لَمْ تَضَعَ الآخَرَ وَتَلاَ : {وَأُولاَتُ الأَحْمَالِ أَجَلُہُنَّ أَنْ یَضَعْنَ حَمْلَہُنَّ}۔","","Musannaf Ibn Abi Shaybah 19154","","","كتاب الجنة"
"19155","(۱۹۱۵۵) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ فِی الَّذِی یُطَلِّقُ وَفِی بَطْنِہَا الولدان قَالَ لَہُ الرَّجْعَۃُ حَتَّی تَضَعَ مَا فِی بَطْنِہَا۔","","Musannaf Ibn Abi Shaybah 19155","","","كتاب الجنة"
"19156","(۱۹۱۵۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَشْعَثَ ، عَنِ الشَّعْبِیِّ قَالَ ہُوَ أَحَقُّ بِہَا مَا لَمْ تَضَعِ الآخَرَ۔","","Musannaf Ibn Abi Shaybah 19156","","","كتاب الجنة"
"19157","(۱۹۱۵۷) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ وَالحَسَن وَسُلَیْمَانَ بْنِ یَسَارٍ وَعَطَائِ بْنِ أَبِی رَبَاحٍ قَالُوا : ہُوَ أَحَقُّ بِہَا مَا لَمْ تَضَعَ الآخَرَ۔","","Musannaf Ibn Abi Shaybah 19157","","","كتاب الجنة"
"19158","(۱۹۱۵۸) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنْ زَکَرِیَّا ، عَنْ عَامِرٍ قَالَ : کَانُوا یَقُولُونَ : لَوْ کَانَ وَلَدٌ وَاحِدٌ خَرَجَ مِنْہُ طَائِفَۃٌ کان یَمْلِکُ الرَّجْعَۃَ مَا لَمْ یَخْرُجْ کُلُّہُ۔","","Musannaf Ibn Abi Shaybah 19158","","","كتاب الجنة"
"19159","(۱۹۱۵۹) حَدَّثَنَا وَکِیعٌ قَالَ: حدَّثَنَا ابْنُ أَبِی خَالِد، عَنِ أَبِی حَنْظَلَۃَ، عَنِ الشَّعْبِیِّ قَالَ: ہُوَ أَحَقُّ بِہَا مَا لَمْ تَضَعِ الآخَرَ۔","","Musannaf Ibn Abi Shaybah 19159","","","كتاب الجنة"
"19160","(۱۹۱۶۰) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ قَالَ : إذَا تُوُفِّیَ الرَّجُلُ ، أَوْ طَلَّقَ امْرَأَتَہُ وَہِیَ حَامِلٌ فَوَضَعَتْ وَلَدًا وَبَقِیَ فِی بَطْنِہَا آخَرُ فَقَدِ انْقَضَتْ عِدَّتُہَا بِالأَوَّلِ۔","","Musannaf Ibn Abi Shaybah 19160","","","كتاب الجنة"
"19161","(۱۹۱۶۱) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ أَشْعَثَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ قَالَ : إذَا وَضَعَتْ أَحَدَہُمَا فَقَدْ بَانَتْ۔","","Musannaf Ibn Abi Shaybah 19161","","","كتاب الجنة"
"19162","(۱۹۱۶۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ ، عَنْ عِکْرِمَۃَ قَالَ : إذَا وَضَعَتِ الأَوَّلَ فَقَدْ بَانَتْ ، قَالَ : قِیلَ لَہُ : تُزَوَّجُ ؟ قَالَ : لاَ ، قَالَ قَتَادَۃُ : خُصِم الْعَبْدُ۔","","Musannaf Ibn Abi Shaybah 19162","","","كتاب الجنة"
"19163","(۱۹۱۶۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : تَعْتَدُّ الْمُطَلَّقَۃُ فِی بَیْتِ زَوْجِہَا ، وَلاَ تَکْتَحِلُ بِکُحْلٍ زِینَۃً۔","","Musannaf Ibn Abi Shaybah 19163","","","كتاب الجنة"
"19164","(۱۹۱۶۴) حَدَّثَنَا ابْنُ أَبِی زَائِدَۃَ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ مَسْرُوقٍ قَالَ : جَائَ رَجُلٌ إلَی عَبْدِ اللہِ فَقَالَ : إنِّی طَلَّقْتُ امْرَأَتِی ثَلاَثًا ، وَإِنَّہَا تُرِیدُ أَنْ تَخْرُجَ ، قَالَ : احْبِسْہَا ، قَالَ : لاَ تجلس قَالَ : قَیِّدْہَا قَالَ : إنَّ لَہَا إخْوَۃً غَلِیظَۃٌ رِقَابُہُمْ ، قَالَ : اسْتَعْدِ الأَمِیرَ۔",": Sahih","Musannaf Ibn Abi Shaybah 19164","","","كتاب الجنة"
"19165","(۱۹۱۶۵) حَدَّثَنَا جَرِیرٌ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ قَالَ : الْمُطَلَّقَۃُ تَزُورُ وَلاَ تَبِیتُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19165","","","كتاب الجنة"
"19166","(۱۹۱۶۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدِ بْنِ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : الْمُطَلَّقَۃُ ثَلاَثًا لاَ تَخْرُجُ مِنْ بَیْتِ زَوْجِہَا وَلاَ تَمَسُّ طِیبًا إلاَّ عِنْدَ الطُّہْرِ بنُبذۃ مِنْ قُسْطٍ وَأَظْفَارٍ۔","","Musannaf Ibn Abi Shaybah 19166","","","كتاب الجنة"
"19167","(۱۹۱۶۷) حَدَّثَنَا أَبُو زُکَیر یَحْیَی بْنُ مُحَمَّدٍ الْقُرَشِیُّ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ نَضْلَۃَ قَالَ : طَلَّقْتُ بِنْت عَمٍّ لِی ثَلاَثًا الْبَتَّۃَ فَأَتَیْت سَعِیدَ بْنَ الْمُسَیَّبِ أَسْأَلُہُ فَقَالَ : تَعْتَدُّ فِی بَیْتِ زَوْجِہَا حَیْثُ طُلِّقَتْ ، قَالَ : وَسَأَلْت الْقَاسِمَ وَسَالِمًا وَأَبَا بَکْرِ بْنَ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ وَخَارِجَۃَ بْنَ زَیْدٍ وَسُلَیْمَانَ بْنَ یَسَارٍ فکُلُّہُمْ یَقُولُ مِثْلَ قَوْلِ سَعِیدٍ۔","","Musannaf Ibn Abi Shaybah 19167","","","كتاب الجنة"
"19168","(۱۹۱۶۸) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ فِی الْمُطَلَّقَۃِ ثَلاَثًا وَالْمُتَوَفَّی عَنْہَا زَوْجُہَا : تَعْتَدَّانِ فِی بَیْتِ زَوْجَیْہِمَا وَتُحِدَّانِ۔","","Musannaf Ibn Abi Shaybah 19168","","","كتاب الجنة"
"19169","(۱۹۱۶۹) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنِ الْقَاسِمِ أَنَّ یَحْیَی بْنَ سَعِیدِ بْنِ الْعَاصِ طَلَّقَ امْرَأَتَہُ بِنْتَ عَبْدِ الرَّحْمَنِ بْنِ الْحَکَمِ ، فَانْطَلَقَتْ إلَی أَہْلِہَا ، فَأَرْسَلَتْ عَائِشَۃُ إلَی مَرْوَانَ : اتَّقِ اللَّہَ وَرُدَّ الْمَرْأَۃَ إلَی بَیْتِہَا ، فَقَالَ مَرْوَانُ : إنَّ عَبْدَ الرَّحْمَنِ غَلَبَنِی۔",": Sahih","Musannaf Ibn Abi Shaybah 19169","","","كتاب الجنة"
"19170","(۱۹۱۷۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ عُبَیْدِ اللہِ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ قَالَ : لاَ تَبِیتُ الْمَبْتُوتَۃُ وَلاَ الْمُتَوَفَّی عَنْہَا زَوْجُہَا إلاَّ فِی بَیْتِہَا حَتَّی تَنْقَضِیَ عِدَّتُہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 19170","","","كتاب الجنة"
"19171","(۱۹۱۷۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ قَالَ : طُلِّقَتِ امْرَأَۃٌ بِالْمَدِینَۃِ فَسُئِلَ فُقَہَائُ أَہْلِ الْمَدِینَۃِ فَقَالُوا : تَمْکُثُ فِی بَیْتِہَا ، فَسُئِلَ سَعِیدٌ : فَقَالَ : تَمْکُثُ۔","","Musannaf Ibn Abi Shaybah 19171","","","كتاب الجنة"
"19172","(۱۹۱۷۲) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ ، عَنْ أَبِیہِ قَالَ : قالَتْ فَاطِمَۃُ بِنْتُ قَیْسٍ : یَا رَسُولَ اللہِ ، إنِّی أَخَافُ أَنْ یُقْتَحَمَ عَلَیَّ قَالَ : فَأَمَرَہَا أَنْ تَحَوَّلَ۔ (مسلم ۱۱۲۱۔ ابن ماجہ ۲۰۳۳)","","Musannaf Ibn Abi Shaybah 19172","","","كتاب الجنة"
"19173","(۱۹۱۷۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُس ، عَنِ الْحَسَنِ ؛ فِی الْمُطَلَّقَۃِ ثَلاَثًا : تَعْتَدُّ فِی غَیْرِ بَیْتِہَا إِنْ شَائَتْ۔","","Musannaf Ibn Abi Shaybah 19173","","","كتاب الجنة"
"19174","(۱۹۱۷۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ، عَنْ حَبِیبٍ قَالَ: سَأَلْتُ عَطَائً فَقَالَ: تَعْتَدُّ حَیْثُ شَائَتْ، وَقَالَہُ الْحَسَنُ أَیْضًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 19174","","","كتاب الجنة"
"19175","(۱۹۱۷۵) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ: حَدَّثَنَا مُحَمَّدُ بن عَمرو قَالَ : حدَّثَنَا أَبُو سَلَمَۃَ ، عَنْ فَاطِمَۃَ بِنْتِ قَیْسٍ قَالَ : کَتَبْتُ ذَلِکَ مِنْ فِیہَا کِتَابًا ، قَالَتْ: کُنْتُ عِنْدَ رَجُلٍ مِنْ بَنِی مَخْزُومٍ فَطَلَّقَنِی الْبَتَّۃَ، فَقَالَ لِی رَسُولُ اللہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ: انْتَقِلِی إلَی ابْنِ أُمِّ مَکْتُومٍ، فَإِنَّہُ رَجُلٌ قَدْ ذَہَبَ بَصَرُہُ، فَإِنْ وَضَعْت شَیْئًا لَمْ یَرَ شَیْئًا۔\n(مسلم ۱۱۱۶۔ ابوداؤد ۲۲۷۸)",": Sahih","Musannaf Ibn Abi Shaybah 19175","","","كتاب الجنة"
"19176","(۱۹۱۷۶) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ سُئِلَ عَنِ امْرَأَۃٍ طُلِّقَتْ وَہِیَ سَاکِنَۃٌ فِی بَیْتٍ بِکِرَائٍ فَقَالَ : إِنْ أَحْسَنَ أَنْ یُعْطِیَ أَجْرًا وَتَمْکُثَ فِی بَیْتِہَا حَتَّی تَنْقَضِیَ عِدَّتُہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 19176","","","كتاب الجنة"
"19177","(۱۹۱۷۷) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ قَالَ : سُئِلَ سعید بْنُ الْمُسَیَّبِ ، عَنِ امْرَأَۃٍ طُلِّقَتْ وَہِیَ فِی بَیْتٍ بِکِرَائٍ عَلَی مَنِ الْکِرَائُ ؟ قَالَ : عَلَی زَوْجِہَا۔","","Musannaf Ibn Abi Shaybah 19177","","","كتاب الجنة"
"19178","(۱۹۱۷۸) حَدَّثَنَا وَکِیعٌ، عَنْ سُفْیَانَ، عَنْ حَبِیبِ بْنِ أَبِی ثَابِتٍ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ، وَعَنْ سُفْیَانَ، عَنْ مَنْصُورٍ، عَنْ مُجَاہِدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ عُمَرَ رَدَّ نِسْوَۃً حَاجَّاتٍ ، أَوْ مُعْتَمِرَاتٍ خَرَجْنَ فِی عِدَّتِہِنَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 19178","","","كتاب الجنة"
"19179","(۱۹۱۷۹) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ حُمَیْدٍ الأَعْرَجِ عن مجاہد أَنَّ عُمَرَ وَعُثْمَانَ رَدَّا نِسْوَۃً حَوَاجَّ أوْ مُعْتَمِرَاتٍ حَتَّی اعْتَدَدْنَ فِی بُیُوتِہِنَّ۔","","Musannaf Ibn Abi Shaybah 19179","","","كتاب الجنة"
"19180","(۱۹۱۸۰) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ أَنَّ ابْنَ مَسْعُودٍ رَدَّ نِسْوَۃً حَاجَّاتٍ أو مُعْتَمِرَاتٍ خَرَجْنَ فِی عِدَّتِہِنَّ۔","","Musannaf Ibn Abi Shaybah 19180","","","كتاب الجنة"
"19181","(۱۹۱۸۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الْمِقْدَامِ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : الْمُتَوَفَّی عَنْہَا وَالْمُطَلَّقَۃُ لاَ تَحُجُّ وَلاَ تَعْتَمِرُ وَلاَ تَلْبَسُ مُجْسَدًا۔","","Musannaf Ibn Abi Shaybah 19181","","","كتاب الجنة"
"19182","(۱۹۱۸۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ أَنَّ ابْنَ عُمَرَ زَجَرَ امْرَأَۃً تَحُجُّ فِی عِدَّتِہَا۔","","Musannaf Ibn Abi Shaybah 19182","","","كتاب الجنة"
"19183","(۱۹۱۸۳) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ أَشْعَثَ ، عَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ قَالَ : رَدَّ عُمَرُ بْنُ الْخَطَّابِ نِسْوَۃً مِنْ ذِی الْحُلَیْفَۃِ حَاجَّاتٍ قُتِلَ أَزْوَاجُہُنَّ فِی بَعْضِ تِلْکَ الْمِیَاہِ۔",": Da'if","Musannaf Ibn Abi Shaybah 19183","","","كتاب الجنة"
"19184","(۱۹۱۸۴) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مَالِکِ بْنِ أَنَسٍ ، عَنْ حُمَیْدِ بْنِ قَیْسٍ ، عَنْ عَمْرِو بْنِ شُعَیْبٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : رَدَّ عُمَرُ نِسْوَۃَ الْمُتَوَفَّی عَنْہُنَّ أَزْوَاجُہُنَّ مِنَ الْبَیْدَائِ ، فَمَنَعَہُنَّ الْحَجَّ۔",": Hasan","Musannaf Ibn Abi Shaybah 19184","","","كتاب الجنة"
"19185","(۱۹۱۸۵) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ ، عَنِ الْقَاسِمِ ، وَعَنْ جَرِیرِ بْنِ حَازِمٍ ، عَنْ عَطَائٍ أَنَّ عَائِشَۃَ أَحَجَّتْ أُمَّ کُلْثُومٍ فِی عِدَّتِہَا۔",": Hasan","Musannaf Ibn Abi Shaybah 19185","","","كتاب الجنة"
"19186","(۱۹۱۸۶) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ حَجَّاجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ أَنَّہُ کَانَ لاَ یَرَی بَأْسًا لِلْمُطَلَّقَاتِ ثَلاَثًا وَالْمُتَوَفَّی عَنْہُنَّ أَزْوَاجُہُنَّ أَنْ یَحْجُجْنَ فِی عِدَّتِہِنَّ۔","","Musannaf Ibn Abi Shaybah 19186","","","كتاب الجنة"
"19187","(۱۹۱۸۷) حَدَّثَنَا الثَّقَفِیُّ ، عَنْ حَبِیبٍ الْمُعَلِّمِ قَالَ : سَأَلْتُ عَطَائً عَنِ الْمُطَلَّقَۃِ ثَلاَثًا وَالْمُتَوَفَّی عَنْہَا : تَحُجَّانِ عَنْہُمَا فِی عِدَّتِہِمَا ؟ قَالَ : نَعَمْ ، وَقَالَ حَبِیبٌ : وَکَانَ الْحَسَنُ یَقُولُ مِثْلَ ذَلِکَ۔","","Musannaf Ibn Abi Shaybah 19187","","","كتاب الجنة"
"19188","(۱۹۱۸۸) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ سَعْدِ بْنِ إِسْحَاقَ ، عَنْ زَیْنَبَ بِنْتِ کَعْبِ بْنِ عُجْرَۃَ وَکَانَتْ تَحْتَ أَبِی سَعِیدٍ الْخُدْرِیِّ أَنَّ أُخْتَہُ الفُرَیْعَۃَ ابْنَۃَ مَالِکٍ قَالَتْ : خَرَجَ زَوْجِی فِی طَلَبِ أَعْلاَجٍ لَہُ فَأَدْرَکَہُمْ بِطَرَفِ الْقَدُوم فَقَتَلُوہُ فَجَائَ نَعْیُ زَوْجِی وَأَنَا فِی دَارٍ مِنْ دُورِ الأَنْصَارِ شَاسِعَۃٍ عَنْ دُورِ أَہْلِی فَأَتَیْت النَّبِیَّ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ فَقُلْت : یَا رَسُولَ اللہِ ، إنَّہُ أَتَانِی نَعْیُ زَوْجِی وَأَنَا فِی دَارٍ شَاسِعَۃٌ ، عَنْ دَارِ أَہْلِی وَدَارِ إخْوَتِی وَلَمْ یَدَعْ مَالاً یُنْفَقُ عَلَیَّ وَلاَ مَالَ وَرِثْتہ وَلاَ دَارَ یَمْلِکُہَا فَإِنْ رَأَیْت أَنْ تَأْذَنَ فَأَلْحَقَ بدَارِ أَہْلِی ، ودَارِ إخْوَتِی ، فَإِنَّہُ أَحَبُّ إلَیَّ وَأَجْمَعُ إلَیَّ بَعْضَ أَمْرِی قَالَ : فَافْعَلِی إِنْ شِئْتِ ، قَالَتْ : فَخَرَجْت قَرِیرَۃَ عَیْنٍ لِمَا قَضَی اللَّہُ عَلَی لِسَانِ رَسُولِہِ صَلَّی اللَّہُ عَلَیْہِ وَسَلَّمَ حَتَّی إذَا کُنْتُ فِی الْمَسْجِدِ ، أَوْ فِی بَعْضِ الْحُجْرَۃِ دَعَانِی فقال : کَیْفَ زَعَمْت ؟ قَالَتْ : فَقَصَصْت عَلَیْہِ الْقِصَّۃَ ، قَالَ : امْکُثِی فِی بَیْتِکَ الَّذِی کَانَ فِیہِ نعی زَوْجُک حَتَّی یَبْلُغَ الْکِتَابُ أَجَلَہُ ، قَالَتْ : فَاعْتَدَدْت فِیہِ أَرْبَعَۃَ أَشْہُرٍ وَعَشْرًا۔ (ترمذی ۱۲۰۴۔ ابوداؤد ۲۲۹۴)",": Hasan","Musannaf Ibn Abi Shaybah 19188","","","كتاب الجنة"
"19189","(۱۹۱۸۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ أَنَّ نِسْوَۃً مِنْ ہَمْدَانَ قُتِلَ عَنْہُنَّ أَزْوَاجُہُنَّ فَقَالَ عَبْدُ اللہِ : یَجْتَمِعْنَ بِالنَّہَارِ وَیَبِتْنَ فِی بُیُوتِہِنَّ۔",": Sahih","Musannaf Ibn Abi Shaybah 19189","","","كتاب الجنة"
"19190","(۱۹۱۹۰) حَدَّثَنَا أَبُو الأَحْوَصِ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : تُوُفِّیَ عَنْ نِسْوَۃٍ مِنْ ہَمْدَانَ أَزْوَاجُہُنَّ فَأَرَدْنَ أَنْ یَجْتَمِعْنَ فِی بَیْتِ امْرَأَۃٍ مِنْہُمْ یَعْتَدِدْنَ فَأَرْسَلْنَ إلَی ابْنِ مَسْعُودٍ یَسْأَلْنَہُ قَالَ : تَعْتَدُّ کُلُّ امْرَأَۃٍ فِی بَیْتِہَا۔","","Musannaf Ibn Abi Shaybah 19190","","","كتاب الجنة"
"19191","(۱۹۱۹۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ یُوسُفَ بْنِ مَاہَکَ ، عَنْ أُمِّہِ مُسَیْکَۃَ أَنَّ امْرَأَۃً زَارَتْ أَہْلَہَا وَہِیَ فِی عِدَّۃٍ فَتَمَخَّضَتْ عِنْدَہُم فَبَعَثُونِی إلَی عُثْمَانَ بَعْدَ ما صَلَّی الْعِشَائَ وَأَخَذَ مَضْجَعَہُ فَقُلْت : إنَّ فُلاَنَۃَ زَارَتْ أَہْلَہَا وَہِیَ فِی عِدَّتِہَا وَہِیَ تَمْخُضُ فَمَا تَأْمُرُنِی ؟ قَالَ : فَأَمَرَ بِہَا أَنْ تُحْمَلَ إلَی بَیْتِہَا فِی تِلْکَ الْحَالِ۔",": Da'if","Musannaf Ibn Abi Shaybah 19191","","","كتاب الجنة"
"19192","(۱۹۱۹۲) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنِ ابْنِ ثَوْبَانَ أَنَّ امْرَأَۃً تُوُفِّیَ عَنْہَا زَوْجُہَا وَبِہَا فَاقَۃٌ فَسَأَلَتْ عُمَرَ أَنْ تَأْتِیَ أَہْلَہَا ؟ فَرَخَّصَ لَہَا أَنْ تَأْتِیَ أَہْلَہَا بَیَاضَ یَوْمِہَا۔","","Musannaf Ibn Abi Shaybah 19192","","","كتاب الجنة"
"19193","(۱۹۱۹۳) حَدَّثَنَا وَکِیعٌ ، عَنْ عَلِیِّ بْنِ مُبَارَکٍ ، عَنْ یَحْیَی بْنِ أَبِی کَثِیرٍ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ أَنَّ امْرَأَۃً مِنَ الأَنْصَارِ تُوُفِّیَ عَنْہَا زَوْجُہَا فَسَأَلَتْ زَیْدَ بْنَ ثَابِتٍ فَلَمْ یُرَخِّصْ لَہَا إلاَّ فِی بَیَاضِ یَوْمِہَا أَو لَیْلَتِہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 19193","","","كتاب الجنة"
"19194","(۱۹۱۹۴) حَدَّثَنَا جَرِیرٌ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ قَالَ : کَانَتِ امْرَأَۃٌ تَعْتَدُّ مِنْ زَوْجِہَا ، تُوُفِّیَ عَنْہَا ، فَاشْتَکَی أَبُوہَا، فَأَرْسَلَتْ إلَی أُمِّ سَلَمَۃَ تَسْأَلُہَا: تَأْتِی أَبَاہَا تُمَرِّضُہُ؟ فَقَالَتْ: إذَا کُنْتِ إِحَدَی طَرَفَیِ النَّہَارِ فِی بَیْتِکِ۔","","Musannaf Ibn Abi Shaybah 19194","","","كتاب الجنة"
"19195","(۱۹۱۹۵) حَدَّثَنَا وَکِیعٌ، عَنْ إسْمَاعِیلَ، قَالَ: سَمِعْتُ إبْرَاہِیمَ یَقُولُ: الْمُتَوَفَّی عَنْہَا زَوْجُہَا لاَ تَبِیتُ فِی غَیْرِ بَیْتِہَا۔","","Musannaf Ibn Abi Shaybah 19195","","","كتاب الجنة"
"19196","(۱۹۱۹۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أُسَامَۃَ بْنِ زَیْدٍ ، عَنْ نَافِعٍ أَنَّ امْرَأَۃً تُوُفِّیَ زَوْجُہَا فَاعْتَدَّتْ فِی غیر بَیْتِہَا یَوْمًا فَأَمَرَہَا ابْنُ عُمَرَ أَنْ تَقْضِیَہُ۔",": Hasan","Musannaf Ibn Abi Shaybah 19196","","","كتاب الجنة"
"19197","(۱۹۱۹۷) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنْ ہِشَامِ بْنِ عُرْوَۃَ قَالَ : سَأَلْتُ أَبِی ، عَنِ الْمُتَوَفَّی عَنْہَا زَوْجُہَا ، أَتَنْتَقِلُ ؟ قَالَ : لاَ ، إلاَّ أَنْ یَنْتَقِلَ أَہْلُہَا فَتَنْتَقِلَ مَعَہُمْ۔","","Musannaf Ibn Abi Shaybah 19197","","","كتاب الجنة"
"19198","(۱۹۱۹۸) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ خُصَیْفٍ قَالَ : سَأَلْتُ سَعِیدَ بْنَ الْمُسَیَّبِ ، عَنِ الْمُتَوَفَّی عَنْہَا زَوْجُہَا تَخْرُجُ مِنْ بَیْتِہَا ؟ قَالَ : لاَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19198","","","كتاب الجنة"
"19199","(۱۹۱۹۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : کَانَ عُمَرُ وَعَبْدُ اللہِ یَقُولاَنِ : لاَ تَنْتَقِلُ۔","","Musannaf Ibn Abi Shaybah 19199","","","كتاب الجنة"
"19200","(۱۹۲۰۰) حَدَّثَنَا عَبْدَۃُ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ قَالَ : کَانَ أَصْحَابُ عَبْدِ اللہِ یَقُولُونَ : لاَ تَخْرُجُ حَتَّی تُوَفِّیَ أَجَلَہَا فِی بَیْتِ زَوْجِہَا۔","","Musannaf Ibn Abi Shaybah 19200","","","كتاب الجنة"
"19201","(۱۹۲۰۱) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ أَنَّ امْرَأَۃً مِنَ الأَنْصَارِ تُوُفِّیَ عَنْہَا زَوْجُہَا وَأَنَّ أَبَاہَا اشْتَکَی فَاسْتَأْذَنَتْ عُمَرَ فَلَمْ یُرَخِّصْ لَہَا إلاَّ فِی لَیلۃ۔",": Hasan","Musannaf Ibn Abi Shaybah 19201","","","كتاب الجنة"
"19202","(۱۹۲۰۲) حَدَّثَنَا أَبُو خَالِدٍ الأَحْمَرُ ، عَنْ مُحَمَّدِ بْنِ عَجْلاَنَ ، عَنْ عَوْفِ بْنِ أَبِی جمیلۃ قَالَ : تُوُفِّیَ صَدِیقٌ لِی وَتَرَکَ زرعا لَہُ بِقُبَائَ فَجَائَتِ امْرَأَتُہُ فَقَالَتْ : سَلِ ابْنَ عُمَرَ أَخْرُجُ فَأَقُومُ عَلَیْہِ ؟ فَأَتَیْت ابْنَ عُمَرَ فَقَالَ : تَخْرُجُ بِالنَّہَارِ وَلاَ تَبِیتُ بِاللَّیْلِ۔",": Da'if","Musannaf Ibn Abi Shaybah 19202","","","كتاب الجنة"
"19203","(۱۹۲۰۳) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ قَالَ : أَخْبَرَنَا ابْنُ عَوْنٍ ، عَنْ أَنَسِ بْنِ سِیرِینَ أَنَّ ابْنَۃً لِعَبْدِ اللہِ بْنُ عُمَرَ تُوُفِّیَ زَوْجُہَا فَأَتَتْہُمْ فَأَرَادَتْ أَنْ تَبِیتَ عِنْدَہُمْ فَمَنَعَہَا عَبْدُ اللہِ بْنُ عُمَرَ وَقَالَ : ارْجِعِی إلَی بَیْتِکَ فَبِیتِی فِیہِ۔",": Sahih","Musannaf Ibn Abi Shaybah 19203","","","كتاب الجنة"
"19204","(۱۹۲۰۴) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مَنْصُورٍ ، عَنِ الْحَکَمِ قَالَ : نَقَلَ عَلِیُّ أُمَّ کُلْثُومٍ حِیَن قُتِلَ عُمَرُ وَنَقَلَتْ عَائِشَۃُ أُخْتَہَا حِینَ قُتِلَ طَلْحَۃُ۔","","Musannaf Ibn Abi Shaybah 19204","","","كتاب الجنة"
"19205","(۱۹۲۰۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ قَالَ : تَخْرُجُ۔","","Musannaf Ibn Abi Shaybah 19205","","","كتاب الجنة"
"19206","(۱۹۲۰۶) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ عَمْرٍو ، عَنْ عَطَائٍ وَأَبِی الشَّعْثَائِ فِی الْمُتَوَفَّی عَنْہَا قَالاَ : تَخْرُجُ۔","","Musannaf Ibn Abi Shaybah 19206","","","كتاب الجنة"
"19207","(۱۹۲۰۷) حَدَّثَنَا مُحَمَّدُ بْنُ مُیَسَّرٍ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَعَنْ أَبِی الزُّبَیْرِ ، عَنْ جَابِرٍ أنہما قَالاَ : تَعْتَدُّ الْمُتَوَفَّی عَنْہَا زَوْجُہَا حَیْثُ شَائَتْ۔","","Musannaf Ibn Abi Shaybah 19207","","","كتاب الجنة"
"19208","(۱۹۲۰۸) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ قَالَ : کَانَ عَلِیٌّ یُرَحِّلُ الْمُتَوَفَّی عَنْہَا زَوْجُہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 19208","","","كتاب الجنة"
"19209","(۱۹۲۰۹) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ أَنَّ عَلِیًّا نَقَلَ أُمَّ کُلْثُومٍ بَعْدَ سَبْعٍ۔",": Sahih","Musannaf Ibn Abi Shaybah 19209","","","كتاب الجنة"
"19210","(۱۹۲۱۰) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ فَحَاضَتْ حَیْضَۃً ، أَوْ حَیْضَتَیْنِ وَتَزَوَّجَتْ فِی عِدَّتِہَا فَانْقَضَتْ عِدَّتُہَا عِنْدَ زَوْجِہَا فَقَالَ : بَانَتْ مِنْہُ بِتَطْلِیقَۃٍ۔","","Musannaf Ibn Abi Shaybah 19210","","","كتاب الجنة"
"19211","(۱۹۲۱۱) حَدَّثَنَا عَبْدُ الأَعْلَی قَالَ : سُئِلَ سَعِیدٌ عَنْ رَجُلٍ تَزَوَّجَ امْرَأَۃً فِی عِدَّتِہَا ، ثُمَّ عَلِمَ إِنَّہُ تَزَوَّجَہَا فِی عِدَّتِہَا وَقَدِ انْقَضَتْ عِدَّتُہَا عِنْدَہُ ، ہَلْ لِزَوْجِہَا الأَوَّلِ عَلَیْہَا رَجْعَۃٌ فَحَدَّثَنَا عَنْ عَلِیِّ بْنِ الْحَکَمِ ، عَنْ مُحَمَّدِ بْنِ زَیدٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ أَنَّہُ قَالَ : یُفَرَّقُ بَیْنَہُمَا وَلاَ رَجْعَۃَ لَہُ عَلَیْہَا لأَنَّ عِدَّتَہَا قَدِ انْقَضَتْ عِنْدَ ہَذَا۔","","Musannaf Ibn Abi Shaybah 19211","","","كتاب الجنة"
"19212","(۱۹۲۱۲) حَدَّثَنَا عَبْدُ الأَعْلَی ، عَنْ سَعِیدٍ ، عَنْ قَتَادَۃَ أَنَّہُ قَالَ : زَوْجُہَا أَحَقُّ بِہَا وَلاَ یَقْرَبُہَا حَتَّی تَنْقَضِیَ عِدَّتُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 19212","","","كتاب الجنة"
"19213","(۱۹۲۱۳) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ تَطْلِیقَۃً ، أَوْ تَطْلِیقَتَیْنِ فَحَاضَتْ عِنْدَہُ حَیْضَتَیْنِ ، ثُمَّ تزَوَّجَہَا رَجُلٌ فَحَاضَتْ عِنْدَہُ حَیْضَتَیْنِ قَالَ : بَانَتْ مِنَ الأَوَّلِ وَلاَ تُحْتَسَبُ بِہِ لِمَنْ بَعْدَہُ۔","","Musannaf Ibn Abi Shaybah 19213","","","كتاب الجنة"
"19214","(۱۹۲۱۴) حَدَّثَنَا ابْنُ مَہْدِیٍّ ، عَنْ سُفْیَانَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ قَالَ : تُحْتَسَبُ بِہِ۔","","Musannaf Ibn Abi Shaybah 19214","","","كتاب الجنة"
"19215","(۱۹۲۱۵) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَن قَالَ : إِنْ تُوُفِّیَ عَنْہَا زَوْجُہَا یَعْنِی الأَمَۃَ اعْتَدَّتْ شَہْرَیْنِ وَخَمْسَ لَیَالٍ۔","","Musannaf Ibn Abi Shaybah 19215","","","كتاب الجنة"
"19216","(۱۹۲۱۶) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ قَالَ : عِدَّۃُ الأَمَۃِ إذَا مَاتَ عَنْہَا زَوْجُہَا نِصْفُ عِدَّۃِ الْحُرَّۃِ شَہْرَانِ وَخَمْسَۃُ أَیَّامٍ۔","","Musannaf Ibn Abi Shaybah 19216","","","كتاب الجنة"
"19217","(۱۹۲۱۷) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ شَیْبَانَ ، عَنْ فِرَاسٍ ، عَنِ الشَّعْبِیِّ فِی مَمْلُوکَۃٍ تُوُفِّیَ عَنْہَا زَوْجُہَا حُرًّا فَعِدَّتُہَا شَہْرَانِ وَخَمْسَۃُ أَیَّامٍ۔","","Musannaf Ibn Abi Shaybah 19217","","","كتاب الجنة"
"19218","(۱۹۲۱۸) حَدَّثَنَا شَبَابَۃُ ، عَنْ لَیْثِ بْنِ سَعْدٍ ، عَنْ بُکَیْر ، عَنِ ابْنِ الْمُسَیَّبِ ، وَابْنِ قُسَیْطٍ فِی الأَمَۃِ : إذَا تُوُفِّیَ عَنْہَا زَوْجُہَا حُرًّا فَعِدَّتُہَا شَہْرَانِ وَخَمْسَۃُ أَیَّامٍ۔","","Musannaf Ibn Abi Shaybah 19218","","","كتاب الجنة"
"19219","(۱۹۲۱۹) حَدَّثَنَا حَاتِمُ بْنُ وَرْدَانَ ، عَنْ بُرْدٍ ، عَنْ مَکْحُولٍ فِی الأَمَۃِ : إذَا مَاتَ عَنْہَا زَوْجُہَا اعْتَدَّتْ عِدَّۃَ الْحُرَّۃِ۔","","Musannaf Ibn Abi Shaybah 19219","","","كتاب الجنة"
"19220","(۱۹۲۲۰) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ أَنَّ مُعَاوِیَۃَ سَأَلَ زَیْدَ بْنَ ثَابِتٍ فَقَالَ : إذَا طَعَنَتْ فِی الْحَیْضَۃِ الثَّالِثَۃِ فَقَدْ بَرِئَتْ مِنْہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 19220","","","كتاب الجنة"
"19221","(۱۹۲۲۱) حَدَّثَنَا جَرِیرُ بْنُ عَبْدِ الْحَمِیدِ ، عَنْ مُغِیرَۃَ ، عَنْ مُوسَی بْنِ شَدَّادٍ ، عَنْ عُمَرَ بْنِ ثَابِتٍ قَالَ : کَانَ زَیْدُ بْنُ ثَابِتٍ یَقُولُ : إذَا حَاضَتِ المطلقۃ الْحَیْضَۃَ الثَّالِثَۃَ قَبْلَ أَنْ یُرَاجِعَہَا زَوْجُہَا فَلاَ یَمْلِکُ الرَّجْعَۃَ۔",": Da'if","Musannaf Ibn Abi Shaybah 19221","","","كتاب الجنة"
"19222","(۱۹۲۲۲) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ أَشْعَثَ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی بَکْرِ بْنِ عَبْدِ الرَّحْمَنِ أَنَّ عَائِشَۃَ وَزَیْدًا کَانَا یَقُولاَنِ : إذَا دَخَلَتْ فِی الدَّمِ الثَّالِثِ فَلَیْسَ لَہُ عَلَیْہَا الرَّجْعَۃُ۔",": Da'if","Musannaf Ibn Abi Shaybah 19222","","","كتاب الجنة"
"19223","(۱۹۲۲۳) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنْ عَبْدِ اللہِ بْنِ عُمَرَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ وَزَیْدِ بْنِ ثَابِتٍ أَنَّہُمَا قَالاَ : إذَا حَاضَتِ الثَّالِثَۃَ فَقَدْ بَانَتْ۔",": Sahih","Musannaf Ibn Abi Shaybah 19223","","","كتاب الجنة"
"19224","(۱۹۲۲۴) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ أَبَانَ بْنِ عُثْمَانَ وَسَالِمِ بْنِ عَبْدِ اللہِ قَالاَ : إذَا دَخَلَتْ فِی الْحَیْضَۃِ الثَّالِثَۃِ فَقَدْ بَانَتْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19224","","","كتاب الجنة"
"19225","(۱۹۲۲۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ أَبِی الزِّنَادِ ، عَنْ سُلَیْمَانَ بْنِ یَسَارٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ قَالَ : إذَا دَخَلَتْ فِی الْحَیْضَۃِ الثَّالِثَۃِ فَقَدْ بَانَتْ مِنْہُ۔",": Sahih","Musannaf Ibn Abi Shaybah 19225","","","كتاب الجنة"
"19226","(۱۹۲۲۶) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنِ الأَعْمَشِِ ، عَنْ إبْرَاہِیمَ ، عَنْ عَمْرٍو ، وَعَبْدِ اللہِ أَنَّہُمَا قَالاَ : مَنْ طَلَّقَ امْرَأَتَہُ فَہُوَ أَحَقُّ بِرَجْعَتِہَا مَا لَمْ تَغْتَسِلْ مِنْ حَیْضَتِہَا الثَّالِثَۃِ۔","","Musannaf Ibn Abi Shaybah 19226","","","كتاب الجنة"
"19227","(۱۹۲۲۷) حَدَّثَنَا حَفْصُ بْنُ غِیَاثٍ ، عَنْ جَعْفَرِ ، عَنْ أَبِیہِ ، عَنْ عَلِیٍّ وَابْنِ عَبَّاسٍ قَالاَ : ہُوَ أَحَقُّ بِہا مَا لَمْ تَغْتَسِلْ مِنْ حَیْضَتِہَا الثَّالِثَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 19227","","","كتاب الجنة"
"19228","(۱۹۲۲۸) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، عَنْ إبْرَاہِیمَ ، عَنِ الاَسْوَدِ ، عَنْ عُمَرَ ، وَعَبْدِ اللہِ أنہما قَالاَ : ہُوَ أَحَقُّ بِہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 19228","","","كتاب الجنة"
"19229","(۱۹۲۲۹) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، عَنْ عَلْقَمَۃَ ، عَنْ عُمَرَ ، وَعَبْدِ اللہِ قَالاَ : ہُوَ أَحَقُّ بِہَا حَتَّی تَغْتَسِلَ مِنَ الْحَیْضَۃِ الثَّالِثَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 19229","","","كتاب الجنة"
"19230","(۱۹۲۳۰) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ، عَنْ عُبَیْدِاللہِ الْکَلاَعِیِّ، عَنْ مَکْحُولٍ أَنَّ أَبَا بَکْرٍ وَعُمَرَ وَعَلِیًّا، وَابْنَ مَسْعُودٍ وَأَبَا الدَّرْدَائِ وَعُبَادَۃَ بْنَ الصَّامِتِ ، وَعَبْدَ اللہِ بْنَ قَیْسٍ الأَشْعَرِیَّ کَانُوا یَقُولُونَ ؛ فِی الرَّجُلِ یُطَلِّقُ امْرَأَتَہُ تَطْلِیقَۃً ، أَوْ تَطْلِیقَتَیْنِ : إنَّہُ أَحَقُّ بِہَا مَا لَمْ تَغْتَسِلْ مِنْ حَیْضَتِہَا الثَّالِثَۃِ ، یَرِثُہَا وَتَرِثُہُ مَا دَامَتْ فِی الْعِدَّۃِ۔","","Musannaf Ibn Abi Shaybah 19230","","","كتاب الجنة"
"19231","(۱۹۲۳۱) حَدَّثَنَا إسْمَاعِیلُ بْنُ عَیَّاشٍ ، عَنْ عُبَیْدِ اللہِ بْنِ عُبَیْدٍ ، عَنْ مَکْحُولٍ قَالَ : قَالَ عُمَرُ : إِنْ دَخَلَ عَلَیْہَا الْمُغْتَسَلَ قَبْلَ أَنْ تُفِیضَ عَلَیْہَا الْمَائَ فَہُوَ أَحَقُّ بِہَا۔ (سعید بن منصور ۱۲۲۳)","","Musannaf Ibn Abi Shaybah 19231","","","كتاب الجنة"
"19232","(۱۹۲۳۲) حَدَّثَنَا سُفْیَانُ بْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ ، عَنْ عَلِیٍّ قَالَ : ہُوَ أَحَقُّ بِہَا حَتَّی تَغْتَسِلَ مِنَ الْحَیْضَۃِ الثَّالِثَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 19232","","","كتاب الجنة"
"19233","(۱۹۲۳۳) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنِ ابْنِ عَجْلاَنَ ، عَنْ مَکْحُولٍ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ : لَوْ أَنَّ رَجُلاً دَخَلَ عَلَی امْرَأَتِہِ وَہِیَ تَغْتَسِلُ فَقَالَ : قَدْ رَاجَعْتُک فَقَالَتْ : کَذَبْت کَذَبْت ، وَصَبَّتِ الْمَائَ عَلَی رَأْسِہَا کَانَ أَحَقَّ بِہَا۔","","Musannaf Ibn Abi Shaybah 19233","","","كتاب الجنة"
"19234","(۱۹۲۳۴) حَدَّثَنَا عَبَّادُ بْنُ الْعَوَّامِ ، عَنْ جُوَیْبِرٍ ، عَنِ الضَّحَّاکِ بْنِ مُزَاحِمٍ أَنَّ امْرَأَۃً تَزَوَّجَتْ شَابًّا فَطَلَّقَہَا تَطْلِیقَۃً ، أَوْ تَطْلِیقَتَیْنِ قَالَ : فَأَتَاہَا وَہِیَ تَغْتَسِلُ مِنَ الْحَیْضَۃِ الثَّالِثَۃِ فَقَالَ : یَا فُلاَنَۃُ إنِّی قَدْ رَاجَعْتُک ، فَقَالَتْ : کَذَبْت، لَیْسَ ذَلِکَ إلَیْک ، فَارْتَفَعُوا إلَی عُمَرَ بْنِ الْخَطَّابِ ، وَعِنْدَہُ عَبْدُ اللہِ بْنُ مَسْعُودٍ ، فَقَالَ عُمَرُ : مَا تَرَی یَا أَبَا عَبْدِ الرَّحْمَنِ ؟ قَالَ : فَقَالَ : أَنْشُدُک بِاَللَّہِ ، ہَلْ کُنْت لَطَمْتِیہِ بِالْمَائِ ؟ قَالَتْ : مَا فَعَلْت ، قَالَ : فَقَالَ : خُذْ بِیَدِہَا۔",": Da'if","Musannaf Ibn Abi Shaybah 19234","","","كتاب الجنة"
"19235","(۱۹۲۳۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ بْنِ أَبِی خَالِدٍ ، عَنِ الْحَکَمِ أَنَّ أَبَا کَنَفٍ طَلَّقَ امْرَأَتَہُ وَلَمْ یُعْلِمْہَا فَأَشْہَدَ عَلَی رَجْعَتِہَا ولم یعلمہا ، قَالَ : فَقَالَ لَہُ عُمَرُ : إِنْ أَدْرَکْتہَا قَبْلَ أَنْ تَتَزَوَّجَ فَأَنْتَ أَحَقُّ بِہَا۔","","Musannaf Ibn Abi Shaybah 19235","","","كتاب الجنة"
"19236","(۱۹۲۳۶) حَدَّثَنَا وَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ قَالَ : قَالَ عَلِیٌّ : إذَا طَلَّقَہَا ، ثُمَّ أَشْہَدَ عَلَی رَجْعَتِہَا فَہِیَ امْرَأَتُہُ أَعْلَمَہَا ، أَوْ لَمْ یُعْلِمْہَا۔","","Musannaf Ibn Abi Shaybah 19236","","","كتاب الجنة"
"19237","(۱۹۲۳۷) حَدَّثَنَا مُحَمَّدُ بْنُ فُضَیْلٍ ، عَنْ مُطَرَّف ، عَنِ الشَّعْبِیِّ ، عَنْ عُمَیْرِ بْنِ یَزِیدَ قَالَ : کُنْتُ قَاعِدًا عِنْدَ شُرَیْحٍ فَجَائَ رَجُلٌ یُخَاصِمُ امْرَأَتہ فَقَالَتْ : طَلَّقَنِی وَلَمْ یُعْلِمْنِی الرَّجْعَۃَ حَتَّی مَضَتْ عِدَّتِی وَتَزَوَّجْت وَدَخَلَ بِی زَوْجِی فَقَالَ شُرَیْحٌ : أَلاَ أَعْلَمْتہَا الرَّجْعَۃَ کَمَا أَعْلَمْتہَا الطَّلاَقَ ؟ فَلَمْ یَرُدَّہَا عَلَیْہِ۔","","Musannaf Ibn Abi Shaybah 19237","","","كتاب الجنة"
"19238","(۱۹۲۳۸) حَدَّثَنَا حَفْصٌ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرٍو ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : إذَا طَلَّقَہَا ، ثُمَّ لَمْ یُخْبِرْہَا بِالرَّجْعَۃِ حَتَّی تَنْقَضِیَ الْعِدَّۃُ فَتَزَوَّجَتْ فَدَخَلَ بِہَا الزَّوْجُ الثَّانِی ، فَلاَ شَیْئَ لَہُ۔","","Musannaf Ibn Abi Shaybah 19238","","","كتاب الجنة"
"19239","(۱۹۲۳۹) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ عَبْدِ الْمَلِکِ ، عَنْ عَطَائٍ ؛ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ ، ثُمَّ رَاجَعَہَا فَکَتَمَہَا الرَّجْعَۃَ حَتَّی انْقَضَتْ عِدَّتُہَا ، قَالَ : إِنْ أَدْرَکَہَا قَبْلَ أَنْ تَزَوَّجَ فَہُوَ أَحَقُّ بِہَا ، وَإِلاَّ فَہُوَ ضَیَّعَ۔","","Musannaf Ibn Abi Shaybah 19239","","","كتاب الجنة"
"19240","(۱۹۲۴۰) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ أَبِی مَعْشَرٍ ، عَنْ إبْرَاہِیمَ ؛ أَنَّ أَبَا کَنَفٍ طَلَّقَ امْرَأَتَہُ ، ثُمَّ سَافَرَ وَرَاجَعَہَا ، وَکَتَبَ إلَیْہَا بِذَلِکَ ، وَأَشْہَدَ عَلَی ذَلِکَ ، فَلَمْ یَبْلُغْہَا الْکِتَابُ حَتَّی انْقَضَتِ الْعِدَّۃُ ، فَتَزَوَّجَتِ الْمَرْأَۃُ فَرَکِبَ إلَی عُمَرَ ، فَقَصَّ عَلَیْہِ الْقِصَّۃَ فَقَالَ : أَنْتَ أَحَقُّ بِہَا مَا لَمْ یَدْخُلْ بِہَا۔","","Musannaf Ibn Abi Shaybah 19240","","","كتاب الجنة"
"19241","(۱۹۲۴۱) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ عُمَرَ بْنِ عَامِرٍ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ أَنَّ عَلِیًّا کَانَ یَقُولُ : ہُوَ أَحَقُّ بِہَا دُخِلَ بِہَا ، أَوْ لَمْ یُدْخَلْ۔","","Musannaf Ibn Abi Shaybah 19241","","","كتاب الجنة"
"19242","(۱۹۲۴۲) حَدَّثَنَا عَبدَۃ ، عَنْ سَعِیدٍ ، عَنْ عُمَرَ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ أَنَّہُ کَانَ یَرَی ذَلِکَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19242","","","كتاب الجنة"
"19243","(۱۹۲۴۳) حَدَّثَنَا مُحَمَّدُ بْنُ بِشْرٍ قَالَ : حدَّثَنَا إسْمَاعِیلُ ، قَالَ : سَمِعْتُ الْحَکَمَ بْنَ عُتَیْبَۃَ یَذْکُرُ ، عَنْ أَبِی کَنَفٍ أَنَّہُ طَلَّقَ امْرَأَتَہُ ، ثُمَّ رَاجَعَہَا وَلَمْ یُعْلِمْہَا الرَّجْعَۃَ فَتَزَوَّجَتْ فَرَکِب فِی ذَلِکَ إلَی عُمَرَ فَقَالَ : ارْجِعْ ، فإنْ وَجَدْتہَا لَمْ تَأْتِ زَوْجَہَا الَّذِی نَکَحَتْ فَہِیَ امْرَأَتُک ، فَرَجَعَ فَلَمْ یَجِدْہَا أَتَتْ زَوْجَہَا فَقَبَضَہَا۔","","Musannaf Ibn Abi Shaybah 19243","","","كتاب الجنة"
"19244","(۱۹۲۴۴) حَدَّثَنَا حَمَّادُ بْنُ خَالِدٍ، عَنِ ابْنِ أَبِی ذِئْبٍ ، عَنِ الزُّہْرِیِّ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ فِی رَجُلٍ طَلَّقَ امْرَأَتَہُ، ثُمَّ بَعَثَ إلَیْہَا بِالرَّجْعَۃِ فَلَمْ تَأْتِہَا الرَّجْعَۃُ حَتَّی تَزَوَّجَتْ قَالَ : بَانَتْ مِنْہُ ، وَإِنْ أَدْرَکَتْہَا الرَّجْعَۃُ قَبْلَ أَنْ تَزَوَّجَ فَہِیَ امْرَأَتُہُ۔","","Musannaf Ibn Abi Shaybah 19244","","","كتاب الجنة"
"19245","(۱۹۲۴۵) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنِ ابْنِ جُرَیْجٍ ، عَنْ عَمْرو ، عَنْ جَابِرِ بْنِ زَیْدٍ قَالَ : إذَا رَاجَعَ فِی نَفْسِہِ فَلَیْسَ بِشَیْئٍ۔","","Musannaf Ibn Abi Shaybah 19245","","","كتاب الجنة"
"19246","حَدَّثَنَا أَبُو عَبْدِ الرَّحْمَنِ قَالَ : حدَّثَنَا عَبْدُ اللہِ بْنُ مُحَمَّدِ بْنِ أَبِی شَیْبَۃَ قَالَ :\n(۱۹۲۴۶) حَدَّثَنَا أسْمَاعِیلُ بْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ قَالَ : سَأَلْتُ سَعِیدَ بْنَ جُبَیْرٍ وَمُجَاہِدًا وَعَطَائً عَنِ الْمُتَوَفَّی عَنْہَا زَوْجُہَا ، مِنْ أَیِّ یَوْمٍ تَعْتَدُّ ؟ فَقَالُوا : مِنْ یَوْمِ یَمُوتُ قَالَ : وَسَمِعْت عِکْرِمَۃَ وَنَافِعًا وَمُحَمَّدَ بْنَ سِیرِینَ یَقُولُونَ : عِدَّتُہَا من یَوْمَ یَمُوتُ : وَقَالَ طَلْقُ بْنُ حَبِیبٍ : مِنْ یَوْمِ یَمُوتُ۔","","Musannaf Ibn Abi Shaybah 19246","","","كتاب الجنة"
"19247","(۱۹۲۴۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ، عَنْ أَیُّوبَ، عَنْ عَمْرِو بْنِ دِینَارٍ، عَنْ جَابِرِ بْنِ زَیْدٍ یَحْسِبُہُ، عَنِ ابْنِ عَبَّاسٍ قَالَ: یَوْمَ یَمُوتُ۔",": Sahih","Musannaf Ibn Abi Shaybah 19247","","","كتاب الجنة"
"19248","(۱۹۲۴۸) حدَّثَنَا أَبُوالأَحْوَصِ، عَنْ أَبِی إِسْحَاقَ، عَنْ أَبِی الأَحْوَصِ، عَنْ عَبْدِ اللہِ قَالَ الْعِدَّۃُ مِنْ یَوْمِ یَمُوتُ وَیُطَلِّقُ۔",": Sahih","Musannaf Ibn Abi Shaybah 19248","","","كتاب الجنة"
"19249","(۱۹۲۴۹) حَدَّثَنَا أَبُو مُعَاوِیَۃَ، عَنْ عُبَیْدِاللہِ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ قَالَ: عِدَّتُہَا مِنْ یَوْمِ طَلَّقَہَا وَمِنْ یَوْمِ یَمُوتُ عَنْہَا۔",": Sahih","Musannaf Ibn Abi Shaybah 19249","","","كتاب الجنة"
"19250","(۱۹۲۵۰) حَدَّثَنَا ہُشَیْمٌ ، عن خالد عَنْ أَبِی قِلاَبَۃَ ، وَابْنِ سِیرِینَ ، وَأَبِی الْعَالِیَۃِ ، قَالُوا : الْعِدَّۃُ مِنْ یَوْمِ یَمُوتُ وَمِنْ یَوْمِ طَلَّقَ ، فَمَنْ أَکَلَ مِنَ الْمِیرَاثِ شَیْئًا فَہُوَ مِنْ نَصِیبِہِ۔","","Musannaf Ibn Abi Shaybah 19250","","","كتاب الجنة"
"19251","(۱۹۲۵۱) حَدَّثَنَا ابْنُ فُضَیْلٍ ، عَنْ حُصَیْنٍ ، عَنِ الشَّعْبِیِّ ، عَنْ مَسْرُوقٍ ، قَالَ : تَعْتَدُّ الْمَرْأَۃُ مِنْ زَوْجِہَا وَہُوَ غَائِبٌ مِنْ یَوْمِ یَمُوتُ ، أَوْ مِنْ یَوْمِ یُطَلِّقُ۔","","Musannaf Ibn Abi Shaybah 19251","","","كتاب الجنة"
"19252","(۱۹۲۵۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ، عَنْ بُرْدٍ، عَنْ مَکْحُولٍ وَالزُّہْرِیِّ قَالاَ: تَعْتَدُّ الْمَرْأَۃُ مِنْ یَوْمِ مَاتَ ، أَوْ طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 19252","","","كتاب الجنة"
"19253","(۱۹۲۵۳) حَدَّثَنَا جَرِیرٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ قَالَ : تَقَعُ الْعِدَّۃُ مِنْ یَوْمِ یَمُوتُ وَیَوْمِ یَتَکَلَّمُ بِالطَّلاَقِ۔","","Musannaf Ibn Abi Shaybah 19253","","","كتاب الجنة"
"19254","(۱۹۲۵۴) حَدَّثَنَا ابْنُ عُلَیَّۃَ عن لیث ، عَنِ الْحَکَمِ ، عَنْ عَبْدِ اللہِ قَالَ : مِنْ یَوْمِ یَمُوتُ۔",": Da'if","Musannaf Ibn Abi Shaybah 19254","","","كتاب الجنة"
"19255","(۱۹۲۵۵) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ قَالَ : تَعْتَدُّ مِنْ یَوْمِ تُوُفِّیَ عَنْہَا زَوْجُہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 19255","","","كتاب الجنة"
"19256","(۱۹۲۵۶) حَدَّثَنَا وَکِیعٌ ، عَنْ أَبِی الأَشْہَبِ قَالَ : قَالَ جَابِرُ بْنُ زَیْدٍ : مِنْ یَوْمٍ یَمُوتُ ، أَوْ یُطَلِّقُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 19256","","","كتاب الجنة"
"19257","(۱۹۲۵۷) حَدَّثَنَا وَکِیعٌ ، عَنْ ہِشَامٍ ، عَنْ قَتَادَۃَ ، عَنْ سَعِیدِ بْنِ الْمُسَیَّبِ قَالَ مِنْ یَوْمِ مَاتَ أَو طَلَّقَ۔","","Musannaf Ibn Abi Shaybah 19257","","","كتاب الجنة"
"19258","(۱۹۲۵۸) حَدَّثَنَا وَکِیعٌ ، وَیَحْیَی بْنُ آدَمَ ، عَنْ شَرِیکٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَیْدٍ ، عَنْ عَبْدِ اللہِ قَالَ : الْعِدَّۃُ مِنْ یَوْمِ یَمُوتُ ، ویوم یُطَلِّقُ۔",": Hasan","Musannaf Ibn Abi Shaybah 19258","","","كتاب الجنة"
"19259","(۱۹۲۵۹) حدَّثَنَا حُمَیْدُ بْنُ عَبْدِ الرَّحْمَنِ ، عَنْ حَسَنٍ ، عَنْ أَبِی إِسْحَاقَ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَیْدٍ أَوْقَفَہُ قَالَ : الْعِدَّۃُ مِنْ یَوْمِ یَمُوتُ وَیُطَلِّقُ۔",": Sahih","Musannaf Ibn Abi Shaybah 19259","","","كتاب الجنة"
