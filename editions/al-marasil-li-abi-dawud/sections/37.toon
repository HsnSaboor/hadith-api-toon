hadiths[12]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"198","37 - بَابٌ فِي النِّكَاحِ  199  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  حَدَّثَنَا  ابْنُ أَبِي عَدِيٍّ ،  حَدَّثَنَا  حُسَيْنٌ الْمُعَلِّمُ ،  عَنْ  قَتَادَةَ .         [1/179]      عَنِ  الْحَسَنِ ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  صُومُوا وَأَوْفُوا أَشْعَارَكُمْ  ، فَإِنَّهَا  مَجْفَرَةٌ  ( 18540 ) .","","Al-Marasil li-Abi Dawud 199","","الحسن البصري عن قتادة بن دعامة عن حسين المعلم عن محمد بن إبراهيم بن أبي عدي القسملي عن أبو موسى الزمن عن أبو داود السجستاني","باب في النكاح"
"199","200  -  حَدَّثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  حَدَّثَنَا  سُفْيَانُ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  عَنِ  الْحَسَنِ بْنِ مُسْلِمٍ .  عَنْ  طَاوُسٍ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  زِمَامَ  فِي الْإِسْلَامِ  وَلَا  تَبَتُّلَ  فِي الْإِسْلَامِ  ( 18834 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: حدثني .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: ولا خزام في الإسلام ، ولا رهبانية في الإسلام ، ولا سياحة في الإسلام .","","Al-Marasil li-Abi Dawud 200","","طاوس بن كيسان عن الحسن بن مسلم بن يناق عن ابن جريج عن سفيان الثوري عن محمد بن كثير العبدي عن أبو داود السجستاني","باب في النكاح"
"200","201  -  حَدَّثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  عَنْ  خَالِدٍ ،  عَنْ  حُصَيْنٍ .  عَنْ  أَبِي مَالِكٍ ،  فِي قَوْلِهِ [تَعَالَى]  :         {      يَا أَيُّهَا الَّذِينَ آمَنُوا لا تُحَرِّمُوا طَيِّبَاتِ مَا أَحَلَّ اللهُ لَكُمْ         }      قَالَ :  نَزَلَتْ فِي عُثْمَانَ بْنِ مَظْعُونٍ وَأَصْحَابِهِ ، كَانُوا حَرَّمُوا عَلَى أَنْفُسِهِمْ كَثِيرًا مِنَ الشَّهَوَاتِ وَالنِّسَاءَ  ، وَهَمَّ بَعْضُهُمْ أَنْ يَقْطَعَ ذَكَرَهُ ; فَأَنْزَلَ اللهُ - [عَزَّ وَجَلَّ]  - هَذِهِ الْآيَةَ :         [1/180]             {      وَلا تَعْتَدُوا إِنَّ اللهَ لا يُحِبُّ الْمُعْتَدِينَ         }      ( 19191 ) .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: تعالى .","","Al-Marasil li-Abi Dawud 201","","غزوان الغفاري عن حصين بن عبد الرحمن السلمي عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن أبو داود السجستاني","باب في النكاح"
"201","202  -  حَدَّثَنَا  أَحْمَدُ بْنُ حَنْبَلٍ ،  حَدَّثَنَا  مُعَاذُ بْنُ مُعَاذٍ ،  حَدَّثَنَا  ابْنُ جُرَيْجٍ ،  وَحَدَّثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  حَدَّثَنَا  عَبْدُ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  مَيْمُونٍ أَبِي مُغَلِّسٍ .  عَنْ  أَبِي نَجِيحٍ - قَالَ  أَحْمَدُ [بْنُ حَنْبَلٍ  : وَهُوَ وَالِدُ]  عَبْدِ اللهِ بْنِ أَبِي نَجِيحٍ  - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كَانَ مُوسِرًا لِأَنْ يَنْكِحَ فَلَمْ يَنْكِحْ فَلَيْسَ مِنَّا  ( 19555 )  ،  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: هو أبو .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: لم يقل أحمد بن صالح ""ميمون"" .  في طبعة دار الصميعي حديث زائد برقم 191 ؛ وهو : حدثنا أبو داود ، نا عبد العزيز بن الخطاب قال : نا حبان بن علي العنزي ، عن يحيى بن عبد الرحمن ، عن ابن أبي لبيبة ، عن أبيه ، عن جده قال : قال رسول الله صلى الله عليه وسلم : من بلغ له ولد وعنده مال ما ينكحه فلم يفعل ، فأحدث فالإثم بينهما .","","Al-Marasil li-Abi Dawud 202","","يسار الثقفي مولى الأخنس بن شريق عن ميمون الحجازي عن ابن جريج عن عبد الرزاق الصنعاني عن أحمد بن صالح المصري عن أبو داود السجستاني","باب في النكاح"
"202","203  -  حَدَّثَنَا  الرَّبِيعُ بْنُ نَافِعٍ  ،  حَدَّثَنَا  أَبُو أُسَامَةَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ .  عَنْ  أَبِيهِ  ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  انْكِحُوا النِّسَاءَ فَإِنَّهُنَّ يَأْتِينَكُمْ بِالْمَالِ  ( 19033 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: حدثنا أبو توبة الربيع بن نافع .","","Al-Marasil li-Abi Dawud 203","","عروة بن الزبير عن هشام بن عروة بن الزبير عن حماد بن أسامة القرشي عن الربيع بن نافع الحلبي عن أبو داود السجستاني","باب في النكاح"
"203","204  -  حَدَّثَنَا  أَبُو تَوْبَةَ الرَّبِيعُ بْنُ نَافِعٍ ،  حَدَّثَنَا  أَبُو ضَمْرَةَ .         [1/181]      عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  فِي قَوْلِهِ :         {      وَجَعَلَكُمْ مُلُوكًا         }      قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ،  [أَوْ لَا]  أَعْلَمُهُ إِلَّا قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  :  زَوْجَةٌ وَمَسْكَنٌ وَخَادِمٌ  ( 18658 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أو قال لا .","","Al-Marasil li-Abi Dawud 204","","زيد بن أسلم عن أنس بن عياض الليثي عن الربيع بن نافع الحلبي عن أبو داود السجستاني","باب في النكاح"
"204","205  -  حَدَّثَنَا  كَثِيرُ بْنُ عُبَيْدٍ ،  حَدَّثَنَا  بَقِيَّةُ ،  عَنِ  ابْنِ الْمُبَارَكِ ،  عَنِ  الزُّبَيْرِ بْنِ سَعِيدٍ الْهَاشِمِيِّ .  عَنْ  أَشْيَاخِهِ ،  رَفَعَهُ  :  عَلَيْكُمْ بِأُمَّهَاتِ الْأَوْلَادِ فَإِنَّهُنَّ مُبَارَكَاتُ الْأَرْحَامِ  ( 19613 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: قال .","","Al-Marasil li-Abi Dawud 205","","أشياخ الزبير بن سعيد الهاشمي عن الزبير بن سعيد الهاشمي عن عبد الله بن المبارك عن بقية بن الوليد عن كثير بن عبيد المذحجي عن أبو داود السجستاني","باب في النكاح"
"205","206  -  حَدَّثَنَا  كَثِيرُ بْنُ عُبَيْدٍ ،  حَدَّثَنَا  بَقِيَّةُ ،  عَنْ  أَبِي سَبَأٍ عُتْبَةَ بْنِ تَمِيمٍ  ،  عَنْ  عَلِيِّ بْنِ أَبِي طَلْحَةَ  .  عَنْ  كَعْبِ بْنِ مَالِكٍ ،  أَنَّهُ أَرَادَ أَنْ يَتَزَوَّجَ يَهُودِيَّةً فَقَالَ لَهُ [رَسُولُ اللهِ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَزَوَّجْهَا ; فَإِنَّهَا لَا تُحْصِنُكَ  ( 11161 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: التنوخي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: ""قال أبو داود : أبو طلحة سالم بن مخارق .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: النبي .","","Al-Marasil li-Abi Dawud 206","","كعب بن مالك الأنصاري عن علي بن أبي طلحة العباسي عن عتبة بن تميم التنوخي عن بقية بن الوليد عن كثير بن عبيد المذحجي عن أبو داود السجستاني","باب في النكاح"
"206","207  -  حَدَّثَنَا  الْحَسَنُ بْنُ الصَّبَّاحِ ،  حَدَّثَنَا  إِسْحَاقُ ابْنُ بِنْتِ دَاوُدَ [بْنِ أَبِي هِنْدٍ]  ، مِنْ خَيْرِ الرِّجَالِ ،  عَنْ  هِشَامِ بْنِ إِسْمَاعِيلَ الْمَكِّيِّ .  عَنْ  زِيَادٍ السَّهْمِيِّ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تُسْتَرْضَعَ         [1/182]      الْحَمْقَاءُ  ; فَإِنَّ اللَّبَنَ  يُشَبَّهُ  ( 18656 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: يعني ابن أبي هند .","","Al-Marasil li-Abi Dawud 207","","زياد السهمي مولى عمرو بن العاص عن هشام بن إسماعيل المكي عن إسحاق بن عيسى القشيري عن الحسن بن الصباح البزار عن أبو داود السجستاني","باب في النكاح"
"207","208  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُمَرَ بْنِ عَلِيٍّ ،  حَدَّثَنَا  أَبُو عَامِرٍ ،  حَدَّثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  خَالِدِ بْنِ سَلَمَةَ الْمَخْزُومِيِّ .  عَنْ  عِيسَى بْنِ طَلْحَةَ ، قَالَ :  نَهَى رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَنْ تُنْكَحَ الْمَرْأَةُ عَلَى قَرَابَتِهَا  مَخَافَةَ  الْقَطِيعَةِ  ( 19189 ) .","","Al-Marasil li-Abi Dawud 208","","عيسى بن طلحة التيمي عن الفأفأ ، خالد بن سلمة بن العاص عن سفيان الثوري عن أبو عامر العقدي عن محمد بن عمر بن علي بن عطاء المقدمي عن أبو داود السجستاني","باب في النكاح"
"208","[1/183]      209  -  حَدَّثَنَا  مُوسَى  ،  حَدَّثَنَا  حَمَّادٌ ،  عَنْ  حُمَيْدٍ .  عَنِ  الْحَسَنِ ،  أَنَّ  رَجُلًا  قَالَ : يَا رَسُولَ اللهِ إِنَّ عِنْدِي يَتِيمَةً أَفَأَتَزَوَّجُهَا  ؟ قَالَ : أَرَأَيْتَ لَوْ كَانَتْ قَبِيحَةً لَا مَالَ لَهَا ، أَكُنْتَ تَزَوَّجُهَا  ؟ قَالَ : لَا ، قَالَ : فَخِرْ لَهَا  ( 18514 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: بن إسماعيل .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فأتزوجها .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: تزوجتها .","","Al-Marasil li-Abi Dawud 209","","الحسن البصري عن حميد الطويل عن حماد بن سلمة عن موسى بن إسماعيل التبوذكي عن أبو داود السجستاني","باب في النكاح"
"209","210  -  حَدَّثَنَا  مُؤَمَّلُ بْنُ هِشَامٍ ،  حَدَّثَنَا  إِسْمَاعِيلُ ،  عَنْ  يُونُسَ .  [  عَنِ  الْحَسَنِ ] ، قَالَ :  قَالَ : رَجُلٌ لِعَلِيٍّ  نَحْوَهُ ... ( 18514 ) .","","Al-Marasil li-Abi Dawud 210","","علي بن أبي طالب عن الحسن البصري عن يونس بن عبيد عن إسماعيل ابن علية عن مؤمل بن هشام اليشكري عن أبو داود السجستاني","باب في النكاح"
