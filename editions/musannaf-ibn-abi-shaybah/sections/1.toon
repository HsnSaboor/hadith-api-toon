"506","(۵۰۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ نَافِعٍ ؛ أَنَّ ابْنَ عُمَرَ تَوَضَّأَ فَقَبَّلَ بُنَیَّۃً لَہُ ، فَدَعَا بِمَائٍ فَمَضْمَضَ۔",": Sahih","Musannaf Ibn Abi Shaybah 506","","","كتاب الطهارة"
"507","(۵۰۷) حَدَّثَنَا ہُشَیْمٌ ، عَنْ یَحْیَی ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ کَانَ إذَا قَبَّلَ الصَّبِیَّ مَضْمَضَ فَاہُ ، وَلَمْ یَتَوَضَّأْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 507","","","كتاب الطهارة"
"508","(۵۰۸) حَدَّثَنَا ہُشَیْمٌ ، عَنْ مُغِیرَۃَ ، عَنْ إبْرَاہِیمَ ، قَالَ : سَأَلْتُہُ عَنْ قُبْلَۃِ الصَّبِیِّ بَعْدَ الْوُضُوئِ ؟فَقَالَ : إنَّمَا تِلْکَ رَحْمَۃٌ ، لاَ وُضُوئَ فِیہَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 508","","","كتاب الطهارة"
"509","(۵۰۹) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا لَمَسَ ، أَوْ قَبَّلَ لِشَہْوَۃٍ نَقَضَ الْوُضُوئُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 509","","","كتاب الطهارة"
"510","(۵۱۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا زَکَرِیَّا ، عَنِ الشَّعْبِیِّ ، مِثْلَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 510","","","كتاب الطهارة"
"511","(۵۱۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ ہِشَامٍ الدَّسْتَوَائِیِّ ، عَنْ حَمَّادٍ ، عَنْ إبْرَاہِیمَ ، قَالَ : إذَا قَبَّلْتَ ، أَوْ لَمَسْتَ ، أَوْ بَاشَرْتَ فَأَعِدِ الْوُضُوئَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 511","","","كتاب الطهارة"
"512","(۵۱۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، عَنِ الْحَکَمِ ، وَحَمَّادٍ قَالاَ : إذَا لَمَسَ فَعَلَیْہِ الْوُضُوئُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 512","","","كتاب الطهارة"
"513","(۵۱۳) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ أَنَّہُ کَانَ لاَ یَرَی فِی اللَّمْسِ بِالْیَدِ وُضُوئًا۔",": No Data Available","Musannaf Ibn Abi Shaybah 513","","","كتاب الطهارة"
"514","(۵۱۴) حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ اللہِ الأَسَدِیُّ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، قَالَ : إذَا لَمَسَ الرَّجُلُ امْرَأَتَہُ لِشَہْوَۃٍ تَوَضَّأَ ، مَا لَمْ یُنْزِلْ۔",": Sahih","Musannaf Ibn Abi Shaybah 514","","","كتاب الطهارة"
"515","(۵۱۵) حَدَّثَنَا ابْنُ إدْرِیسَ ، وَأَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ عَبْدِ اللہِ بْنِ عَبْدِ اللہِ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِی لَیْلَی ، عَنِ الْبَرَائِ بْنِ عَازِبٍ ، قَالَ : سُئِلَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عَنِ الْوُضُوئِ مِنْ لُحُومِ الإِبِلِ ؟ فَقَالَ : تَوَضَّؤُوا مِنْہَا۔ (احمد ۴/۳۰۳۔ ابن خزیمۃ ۳۲)",": Sahih","Musannaf Ibn Abi Shaybah 515","","","كتاب الطهارة"
"516","(۵۱۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ حُمَیْدٍ ، عَنْ أَبِی الْعَالِیَۃِ ؛ أَنَّ أَبَا مُوسَی نَحَرَ جَزُورًا فَأَطْعَمَ أَصْحَابَہُ ، ثُمَّ قَامُوا یُصَلُّونَ بِغَیْرِ طُہُورٍ ، فَنَہَاہُمْ عَنْ ذَلِکَ ، وَقَالَ : مَا أُبَالِی مَشَیْت فِی فَرْثِہَا وَدَمِہَا وَلَمْ أَتَوَضَّأْ ، أَوْ أَکَلْت مِنْ لَحْمِہَا وَلَمْ أَتَوَضَّأْ۔",": Sahih","Musannaf Ibn Abi Shaybah 516","","","كتاب الطهارة"
"517","(۵۱۷) حَدَّثَنَا وَکِیعٌ ، عَنْ مُحَمَّدِ بْنِ قَیْسٍ ، عَنْ جَعْفَرِ بْنِ أَبِی ثَوْرٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : کُنَّا نَتَوَضَّأُ مِنْ لُحُومِ الإِبِلِ ، وَلاَ نَتَوَضَّأُ مِنْ لُحُومِ الْغَنَمِ۔ (طبرانی ۱۸۶۸)",": Hasan","Musannaf Ibn Abi Shaybah 517","","","كتاب الطهارة"
"518","(۵۱۸) حَدَّثَنَا عُبَیْدُ اللہِ بْنُ مُوسَی ، عَنْ إسْرَائِیلَ ?? عَنْ أَشْعَثَ بْنِ أَبِی الشَّعْثَائِ ، عَنْ جَعْفَرِ بْنِ أَبِی ثَوْرٍ ، عَنْ جَابِرِ بْنِ سَمُرَۃَ ، قَالَ : أَمَرَنَا رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَنْ نَتَوَضَّأَ مِنْ لُحُومِ الإِبِلِ ، وَلاَ نَتَوَضَّأَ مِنْ لُحُومِ الْغَنَمِ۔ (ابن حبان ۱۱۲۵۔ احمد ۵/۱۰۲)",": Hasan","Musannaf Ibn Abi Shaybah 518","","","كتاب الطهارة"
"519","(۵۱۹) حَدَّثَنَا عَائِذُ بْنُ حَبِیبٍ ، عَنْ یَحْیَی بْنِ قَیْسٍ ، قَالَ : رَأَیْتُ ابْنَ عُمَرَ أَکَلَ لَحْمَ جَزُورٍ ، وَشَرِبَ لَبَنَ الإِبِلِ، وَصَلَّی وَلَمْ یَتَوَضَّأْ۔",": Da'if","Musannaf Ibn Abi Shaybah 519","","","كتاب الطهارة"
"520","(۵۲۰) حَدَّثَنَا حَفْصٌ ، عَنْ لَیْثٍ ، عَنْ طَاوُوسٍ ، وَعَطَائٍ ، وَمُجَاہِدٍ ؛ أَنَّہُمْ کَانُوا لاَ یَتَوَضَّؤُونَ مِنْ لُحُومِ الإِبِلِ وَأَلْبَانِہا۔",": No Data Available","Musannaf Ibn Abi Shaybah 520","","","كتاب الطهارة"
"521","(۵۲۱) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ جَابِرٍ ، عَنْ أَبِی سَبْرَۃَ النَّخَعِیِّ ؛ أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَکَلَ لَحْمَ جَزُورٍ ، ثُمَّ قَامَ فَصَلَّی وَلَمْ یَتَوَضَّأْ۔",": Da'if","Musannaf Ibn Abi Shaybah 521","","","كتاب الطهارة"
"522","(۵۲۲) حَدَّثَنَا وَکِیعٌ ، عَنْ شَرِیکٍ ، عَنْ جَابِرٍ ، عَنْ عَبْدِ اللہِ بْنِ الْحَسَنِ ؛ أَنَّ عَلِیًّا أَکَلَ لَحْمَ جَزُورٍ ، ثُمَّ صَلَّی وَلَمْ یَتَوَضَّأْ۔",": Da'if","Musannaf Ibn Abi Shaybah 522","","","كتاب الطهارة"
"523","(۵۲۳) حَدَّثَنَا وَکِیعٌ ، عَنْ نفاعۃ بن مُسْلم ، قَالَ : رَأَیْتُ سُوَیْد بْنَ غَفَلَۃَ أَکَلَ لَحْمَ جَزُورٍ ، ثُمَّ صَلَّی وَلَمْ یَتَوَضَّأْ۔",": Sahih","Musannaf Ibn Abi Shaybah 523","","","كتاب الطهارة"
"524","(۵۲۴) حَدَّثَنَا وَکِیعٌ ، عَنْ سُفْیَانَ ، عَنْ مَنْصُورٍ ، عَنْ إبْرَاہِیمَ ، قَالَ: لَیْسَ فِی لحومِ الإِبِلِ وَالْبَقَرِ وَالْغَنَمِ وُضُوئٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 524","","","كتاب الطهارة"
"525","(۵۲۵) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَلِیُّ بْنُ زَیْدٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ الْمُنْکَدِرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : أَکَلْت مَعَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، وَمَعَ أَبِی بَکْرٍ ، وَعُمَرَ ، وَعُثْمَانَ ، خُبْزًا وَلَحْمًا ، فَصَلَّوْا وَلَمْ یَتَوَضَّؤُوا۔ (ترمذی ۸۰)",": Sahih","Musannaf Ibn Abi Shaybah 525","","","كتاب الطهارة"
"526","(۵۲۶) حَدَّثَنَا أَبُو الأَحْوَصِِ ، عَنْ سِمَاکٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : أَکَلَ النَّبِیُّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَتِفًا ، ثُمَّ مَسَحَ یَدَہُ بِمِسْحٍ کَانَ تَحْتَہُ ، ثُمَّ قَامَ فَصَلَّی۔ (ابوداؤد ۱۹۱۔ ابن حبان ۱۱۶۲)","","Musannaf Ibn Abi Shaybah 526","","","كتاب الطهارة"
"527","(۵۲۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ عَطَائٍ ، عَنِ ابْنِ عَبَّاسٍ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَکَلَ مِنْ عَظْمٍ ، أَوْ تَعَرَّقَ مِنْ ضِلَعٍ ، ثُمَّ صَلَّی ، وَلَمْ یَتَوَضَّأْ۔\n(احمد ۱/۲۲۷۔ ابن خزیمۃ ۳۹)",": Sahih","Musannaf Ibn Abi Shaybah 527","","","كتاب الطهارة"
"528","(۵۲۸) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا جَابِرٌ الْجُعْفِیُّ ، عَنْ أَبِی جَعْفَرٍ ، عَنِ ابْنِ عَبَّاسٍ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ خَرَجَ وَہُوَ یُرِیدُ الصَّلاَۃَ ، فَمَرَّ بِقِدْرٍ تَفُورُ ، فَأَخَذَ مِنْہَا عَرْقًا ، أَوْ کَتِفًا فَأَکَلَہُ ، ثُمَّ مَضْمَضَ وَلَمْ یَتَوَضَّأْ۔ (طبرانی ۱۰۷۴۱۔ احمد ۲۴۱)",": Da'if","Musannaf Ibn Abi Shaybah 528","","","كتاب الطهارة"
"529","(۵۲۹) حَدَّثَنَا وَکِیعٌ ، قَالَ : حدَّثَنَا سُفْیَانُ ، قَالَ : حَدَّثَنَا أَبُو عَوْنٍ ، عَنْ عَبْدِ اللہِ بْنِ شَدَّادٍ ، قَالَ : سَمِعْتُ أَبَا ہُرَیْرَۃَ یُحَدِّثُ مَرْوَانَ ، قَالَ : تَوَضَّأْ مِمَّا مَسَّتِ النَّارَ ، فَأَرْسَلَ مَرْوَانُ إلَی أُمِّ سَلَمَۃَ یَسْأَلہا ، فَقَالَتْ : نَہَسَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ عِنْدِی کَتِفًا ، ثُمَّ خَرَجَ إلَی الصَّلاَۃِ ، وَلَمْ یَمَسَّ مَائً۔\n(احمد ۶/۳۰۶۔ نسائی ۶۶۵۶)",": Sahih","Musannaf Ibn Abi Shaybah 529","","","كتاب الطهارة"
"530","(۵۳۰) حَدَّثَنَا حَاتِمُ بْنُ إسْمَاعِیلَ ، عَنْ جَعْفَرٍ ، عَنْ أَبِیہِ ، عَنْ عَلِیِّ بْنِ حُسَیْنٍ ، أَوْ حُسَیْنِ بْنِ عَلِیٍّ ، عَنْ زَیْنَبَ بِنْتِ أُمِّ سَلَمَۃَ ، قَالَتْ : أُتِیَ رَسُولُ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ بِکَتِفِ شَاۃٍ فَأَکَلَ مِنْہُ ، فَصَلَّی وَلَمْ یَمَسَّ مَائً۔\n(ابن ماجہ ۴۹۱۔ نسائی ۱۸۷)",": Sahih","Musannaf Ibn Abi Shaybah 530","","","كتاب الطهارة"
"531","(۵۳۱) حَدَّثَنَا عَلِیُّ بْنُ مُسْہِرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ بُشَیْرِ بْنِ یَسَارٍ ، قَالَ : أَخْبَرَنِی سُوَیْد بْنُ النُّعْمَانِ الأَنْصَارِیُّ ؛ أَنَّہُمْ خَرَجُوا مَعَ رَسُولِ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ إلَی خَیْبَرَ ، حَتَّی إذَا کَانُوا بِالصَّہْبَائِ صَلَّی الْعَصْرَ ، ثُمَّ دَعَا بِأَطْعِمَۃٍ ، وَلَمْ یُؤْتَ إِلاَّ بِسَوِیقٍ ، فَأَکَلُوا وَشَرِبُوا ، ثُمَّ دَعَا بِمَائٍ فَمَضْمَضَ ، ثُمَّ قَامَ فَصَلَّی بِنَا الْمَغْرِبَ۔ (ابن ماجہ ۴۹۲)",": Sahih","Musannaf Ibn Abi Shaybah 531","","","كتاب الطهارة"
"532","(۵۳۲) حَدَّثَنَا ابْنُ نُمَیْرٍ ، عَنْ یَحْیَی بْنِ سَعِیدٍ ، عَنْ بُشَیْرِ بْنِ یَسَارٍ ، عَنْ سُوَیْد بْنِ النُّعْمَانِ ، عَنِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ، بِمِثْلِہِ ، وَزَادَ فِیہِ : وَمَضْمَضْنَا مَعَہُ ، وَمَا مَسَّ مَائً۔(احمد ۳/۴۶۲)",": Sahih","Musannaf Ibn Abi Shaybah 532","","","كتاب الطهارة"
"533","(۵۳۳) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا سُلَیْمَانُ بْنُ بِلاَلٍ ، قَالَ : حَدَّثَنِی عَمْرُو بْنُ أَبِی عَمْرٍو ، عَنْ حُنَیْنِ بْنِ أَبِی الْمُغِیرَۃِ ، عَنْ أَبِی رَافِعٍ ، قَالَ : رَأَیْتُ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَکَلَ کَتِفًا ، ثُمَّ قَامَ إلَی الصَّلاَۃِ ، وَلَمْ یَمَسَّ مَائً۔ (مسلم ۹۴۔ احمد ۶/۳۹۲)",": Hasan","Musannaf Ibn Abi Shaybah 533","","","كتاب الطهارة"
"534","(۵۳۴) حَدَّثَنَا الْفَضْلُ بْنُ دُکَیْنٍ ، عَنْ إبْرَاہِیمَ بْنِ إسْمَاعِیلَ ، عَنِ الزُّہْرِیِّ ، عَنْ جَعْفَرِ بْنِ عَمْرِو بْنِ أُمَیَّۃَ الضَّمْرِیِّ ، عَنْ أَبِیہِ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ احْتَزَّ مِنْ کَتِفِ شَاۃٍ ، ثُمَّ صَلَّی ، وَلَمْ یَتَوَضَّأْ۔\n(احمد ۴/۱۳۹۔ مسلم ۹۳)",": Sahih","Musannaf Ibn Abi Shaybah 534","","","كتاب الطهارة"
"535","(۵۳۵) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا عُبَیْدُ اللہِ بْنُ إیَادٍ ، قَالَ : حَدَّثَنِی إیَادٌ ، عَنْ سُوَیْد بْنِ سَرْحَانَ ، عَنِ الْمُغِیرَۃِ بْنِ شُعْبَۃَ ، أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ أَکَلَ طَعَامًا ، ثُمَّ أُقِیمَتِ الصَّلاَۃُ وَقَدْ کَانَ تَوَضَّأَ قَبْلَ ذَلِکَ ، فَأَتَیْتُہُ بِمَائٍ لِیَتَوَضَّأَ ، فَانْتَہَرَنِی ، وَقَالَ : وَرَائَکَ ، وَلَوْ فَعَلْت ذَلِکَ فَعَلَ النَّاسُ بَعْدِی۔ (طبرانی ۱۰۰۸)",": Hasan","Musannaf Ibn Abi Shaybah 535","","","كتاب الطهارة"
"536","(۵۳۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا عَمْرُو بْنُ دِینَارٍ ، وَأَبُو الزُّبَیْرِ ، عَنْ جَابِرِ بْنِ عَبْدِ اللہِ ، قَالَ : أَکَلْت مَعَ أَبِی بَکْرٍ خُبْزًا وَلَحْمًا ، فَصَلَّی وَلَمْ یَتَوَضَّأْ۔",": Sahih","Musannaf Ibn Abi Shaybah 536","","","كتاب الطهارة"
"537","(۵۳۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا مُغِیرَۃُ ، عَنْ إبْرَاہِیمَ ، أَنَّ عَلْقَمَۃَ ، وَالأَسْوَدَ کَانَا مَعَ عَبْدِ اللہِ وَہُوَ یُرِیدُ الْمَسْجِدَ ، فَتَلَقَّی بِجَفْنَۃٍ مِنْ ثَرِیدٍ ، وَہُوَ فِی الرَّحْبَۃِ ، قَالَ : فَجَلَسَ فَأَکَلَ مِنْہَا ہُوَ وَعَلْقَمَۃُ وَالأَسْوَدُ ، قَالَ : ثُمَّ دَعَا بِمَائٍ ، فَمَضْمَضَ فَاہُ ، وَغَسَلَ یَدَیْہِ مِنْ غَمْرِ اللَّحْمِ ، ثُمَّ دَخَلَ فَصَلَّی۔",": Sahih","Musannaf Ibn Abi Shaybah 537","","","كتاب الطهارة"
"538","(۵۳۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ وَہْبِ بْنِ کَیْسَانَ ، عَنْ جَابِرٍ ؛ أَنَّ أَبَا بَکْرٍ أَکَلَ خُبْزًا وَلَحْمًا ، فَمَا زَادَ عَلَی أَنْ مَضْمَضَ فَاہُ وَغَسَلَ یَدَیْہِ ، ثُمَّ صَلَّی۔",": Sahih","Musannaf Ibn Abi Shaybah 538","","","كتاب الطهارة"
"539","(۵۳۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ خَالِدٍ ، عَنْ عِکْرِمَۃَ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْوُضُوئُ مِمَّا خَرَجَ ، وَلَیْسَ مِمَّا دَخَلَ۔",": Sahih","Musannaf Ibn Abi Shaybah 539","","","كتاب الطهارة"
"540","(۵۴۰) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حُصَیْنٌ ، عَنْ مُجَاہِدٍ ، قَالَ : مَا رَأَیْت ابْنَ عُمَرَ مُتَوَضِّئًا مِنْ طَعَامٍ قَطُّ ، کَانَ یَلْعَقُ أَصَابِعَہُ الثَّلاَثَ ، ثُمَّ یَمْسَحُ یَدَہُ بِالتُّرَابِ ، ثُمَّ یَقُومُ إلَی الصَّلاَۃِ۔",": Sahih","Musannaf Ibn Abi Shaybah 540","","","كتاب الطهارة"
"541","(۵۴۱) حَدَّثَنَا وَکِیعٌ ، عَنْ مِسْعَرٍ ، قَالَ : قُلْتُ لِجَبَلَۃَ : أَسَمِعْتَ ابْنَ عُمَرَ یَقُولُ إِنِّیْ لَآکُلُ اللَّحْمَ وَأَشْرَبُ اللَّبَنَ وَأُصَلِّی ، وَلاَ أَتَوَضَّأُ ؟ قَالَ: نَعَمْ۔",": Sahih","Musannaf Ibn Abi Shaybah 541","","","كتاب الطهارة"
"542","(۵۴۲) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ یَحْیَی بْنِ وَثَّابٍ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : الْوُضُوئُ مِمَّا خَرَجَ ، وَلَیْسَ مِمَّا دَخَلَ ، وَلاَ مِمَّا أُوطِیَٔ۔",": Sahih","Musannaf Ibn Abi Shaybah 542","","","كتاب الطهارة"
"543","(۵۴۳) حَدَّثَنَا ہُشَیْمٌ ، عَنْ حُصَیْنٍ ، عَنْ عِکْرِمَۃَ ، قَالَ : الْوُضُوئُ مِمَّا خَرَجَ ، وَلَیْسَ مِمَّا دَخَلَ۔",": No Data Available","Musannaf Ibn Abi Shaybah 543","","","كتاب الطهارة"
"544","(۵۴۴) حَدَّثَنَا غُنْدَرٌ ، وَوَکِیعٌ ، عَنْ شُعْبَۃَ ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ زُرَارَۃَ ، أَنَّہُ سَمِعَ مُحَمَّدَ بْنَ عَمْرِو بْنِ أُبَیٍّ یُحَدِّثُ ، عَنْ أُمِّ الطُّفَیْلِ امْرَأَۃِ أُبَیٍّ ؛ أَنَّ أُبَیًّا کَانَ یَأْکُلُ الثَّرِیدَ وَیُمَضْمِضُ فَاہُ وَیُصَلِّی۔",": Hasan","Musannaf Ibn Abi Shaybah 544","","","كتاب الطهارة"
"545","(۵۴۵) حَدَّثَنَا یَزِیدُ بْنُ ہَارُونَ ، قَالَ : أَخْبَرَنَا سَعِیدُ بْنُ أَبِی عَرُوبَۃَ ، عَنْ قَتَادَۃَ ، عَنْ صَالِحٍ أَبِی الْخَلِیلِ ، عَنْ عَبْدِ اللہِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ، عَنْ أُمِّ حَکِیمٍ ابْنَۃِ الزُّبَیْرِ ؛ أَنَّ رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ دَخَلَ عَلَی ضُبَاعَۃَ ؛ فَنَہَسَ عِنْدَہَا مِنْ کَتِفٍ ، ثُمَّ خَرَجَ إلَی الصَّلاَۃِ ، وَلَمْ یَتَوَضَّأْ۔ (احمد ۶/۴۱۹۔ طبرانی ۲۱۴)","","Musannaf Ibn Abi Shaybah 545","","","كتاب الطهارة"
"546","(۵۴۶) حَدَّثَنَا مَرْحُومُ بْنُ عَبْدِ الْعَزِیزِ ، عَنْ أَبِیہِ ، قَالَ : رَأَیْتُ أَبَا السَّوَّارِ الْعَدَوِیَّ أَکَلَ ثَرِیدًا وَلَحْمًا ، ثُمَّ قَامَ فَصَلَّی وَلَمْ یَتَوَضَّأْ۔",": No Data Available","Musannaf Ibn Abi Shaybah 546","","","كتاب الطهارة"
"547","(۵۴۷) حَدَّثَنَا عَبْدَۃُ بْنُ سُلَیْمَانَ ، عَنْ إسْمَاعِیلَ ، عَنِ الشَّعْبِیِّ ، قَالَ : بِئْسَ الطَّعَامُ طَعَامٌ یُتَوَضَّأُ مِنْہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 547","","","كتاب الطهارة"
"548","(۵۴۸) حَدَّثَنَا وَکِیعٌ ، عَنْ إسْرَائِیلَ ، عَنْ عَبْدِ الأَعْلَی ، عَنِ ابْنِ الْحَنَفِیَّۃِ ؛ أَنَّہُ کَانَ یَأْکُلُ الثَّرِیدَ وَیَشْرَبُ النَّبِیذَ وَیُصَلِّی ، وَلاَ یَتَوَضَّأُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 548","","","كتاب الطهارة"
"549","(۵۴۹) حَدَّثَنَا إسْمَاعِیلُ ابْنُ عُلَیَّۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنِ ابْنِ سِیرِینَ ، قَالَ : أَتَیْتُ عَبِیدَۃَ ، فَأَمَرَ بِشَاۃٍ فَذُبِحَتْ ، فَدَعَا بِخُبْزٍ وَلَبَنٍ وَسَمْنٍ فَأَکَلْنَا ، ثُمَّ قَامَ فَصَلَّی ، وَلَمْ یَتَوَضَّأْ ، فَظَنَنْت أَنَّہُ کَانَ أَحَبَّ إلَیْہِ أَنْ یَتَوَضَّأَ ، لَوْلا أَنَّہُ أَرَادَ أَنْ یُرِیَنِی أَنَّہُ لَیْسَ بِہِ بَأْسٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 549","","","كتاب الطهارة"
"550","(۵۵۰) حَدَّثَنَا حُسَیْنٌ ، عَنْ زَائِدَۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ رُفَیْعٍ ، عَنِ ابْنِ أَبِی مُلَیْکَۃَ ، وَعِکْرِمَۃَ ، عَنْ عَائِشَۃَ ؛ أَنَّ النَّبِیَّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ کَانَ یَمُرُّ بِالْقِدْرِ ، فَیَتَنَاوَلُ مِنْہَا الْعَرْقَ فَیُصِیبُ مِنْہُ ، ثُمَّ یُصَلِّی وَلَمْ یَتَوَضَّأْ ، وَلَمْ یَمَسَّ مَائً۔ (احمد ۶/۱۶۱)",": Sahih","Musannaf Ibn Abi Shaybah 550","","","كتاب الطهارة"
"551","(۵۵۱) حَدَّثَنَا یَحْیَی بْنُ سَعِیدٍ ، عَنْ أَبِی جَعْفَرٍ الْخَطْمِیِّ ، عَنْ مُحَمَّدِ بْنِ کَعْبٍ ، قَالَ : کَانَ عَبْدُ اللہِ بْنُ یَزِیدَ یَأْکُلُ اللَّحْمَ وَالثَّرِیدَ ، فَیُصَلِّی وَلاَ یَتَوَضَّأُ۔",": Sahih","Musannaf Ibn Abi Shaybah 551","","","كتاب الطهارة"
"552","(۵۵۲) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ عُثْمَانَ مَوْلَی ثَقِیفٍ یُحَدِّثُ ، عَنْ أَبِی زِیَادٍ ، قَالَ : شَہِدْت ابْنَ عَبَّاسٍ ، وَأَبَا ہُرَیْرَۃَ وَہُمْ یَنْتَظِرُونَ جَدْیًا لَہُمْ فِی التَّنُّورِ ، فَقَالَ ابْنُ عَبَّاسٍ : أَخْرِجُوہُ لَنَا لاَ یَفْتِنَّا فِی الصَّلاَۃِ ، فَأَخْرَجُوہُ فَأَکَلُوا مِنْہُ ، ثُمَّ إنَّ أَبَا ہُرَیْرَۃَ تَوَضَّأَ ، فَقَالَ لَہُ ابْنُ عَبَّاسٍ : أَکَلْنَا رِجْسًا ؟! قَالَ : فَقَالَ أَبُو ہُرَیْرَۃَ : أَنْتَ خَیْرٌ مِنِّی وَأَعْلَمُ ، ثُمَّ صَلَّوْا۔",": Da'if","Musannaf Ibn Abi Shaybah 552","","","كتاب الطهارة"
"553","(۵۵۳) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُمَرَ بْنِ عَبْدِ الْعَزِیزِ ، عَنْ إبْرَاہِیمَ بْنِ عَبْدِ اللہِ بْنِ قَارِظٍ؛ أَنَّ أَبَا ہُرَیْرَۃَ أَکَلَ أَثْوَارَ أَقِطٍ ، فَقَامَ فَتَوَضَّأَ فَقَالَ : أَتَدْرُونَ لِمَ تَوَضَّأْت ؟ إنِّی أَکَلْت أَثْوَارَ أَقِطٍ ، سَمِعْت رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : تَوَضَّؤُوا مِمَّا مَسَّتِ النَّارُ ، قَالَ ، فَکَانَ عُمَرُ یَتَوَضَّأُ مِنَ السُّکَّرِ۔",": Sahih","Musannaf Ibn Abi Shaybah 553","","","كتاب الطهارة"
"554","(۵۵۴) حَدَّثَنَا ابْنُ نُمَیْرٍ ، قَالَ: حدَّثَنَا عُثْمَانُ بْنُ حَکِیمٍ ، عَنِ الزُّہْرِیِّ ، عَنْ أَبِی سُفْیَانَ بْنِ الْمُغِیرَۃِ بْنِ الأَخْنَسِ؛ أَنَّہُ دَخَلَ عَلَی خَالَتِہِ أُمِّ حَبِیبَۃَ ، فَسَقَتْہُ شَرْبَۃً مِنْ سَوِیقٍ ، ثُمَّ قَالَتْ : یَا ابْنَ أُخْتِی تَوَضَّہْ ، فَإِنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : تَوَضَّؤُوا مِمَّا مَسَّتِ النَّارُ۔",": Da'if","Musannaf Ibn Abi Shaybah 554","","","كتاب الطهارة"
"555","(۵۵۵) حَدَّثَنَا خَالِدُ بْنُ مَخْلَدٍ ، قَالَ : حدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ الْعَزِیزِ الأَنْصَارِیُّ ، قَالَ : حَدَّثَنِی الزُّہْرِیُّ ، قَالَ : حَدَّثَنِی أَبُو سَلَمَۃَ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ، قَالَ : أَخْبَرَنِی أَبُو سُفْیَانَ بْنُ سَعِیدٍ الأَخْنَسِیُّ ، قَالَ : دَخَلْتُ عَلَی خَالَتِی أُمِّ حَبِیبَۃَ فَسَقَتْنِی سَوِیقًا ، ثُمَّ قَالَتْ : یَا ابْنَ أُخْتِی تَوَضَّأْ ، فَإِنِّی سَمِعْت رَسُولَ اللہِ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ یَقُولُ : تَوَضَّؤُوا مِمَّا مَسَّتِ النَّارُ۔ (احمد ۶/۳۲۸)",": Da'if","Musannaf Ibn Abi Shaybah 555","","","كتاب الطهارة"
"556","(۵۵۶) حَدَّثَنَا عَفَّانُ ، قَالَ : حدَّثَنَا ہَمَّامٌ ، قَالَ : قِیلَ لِمَطَرٍ الْوَرَّاقِ ، وَأَنَا عِنْدَہُ : عَمَّنْ أَخَذَ الْحَسَنُ ، أَنَّہُ کَانَ یَتَوَضَّأُ مِمَّا مَسَّتِ النَّارُ ؟ فَقَالَ : أَخَذَہُ عَنْ أَنَسٍ ، وَأَخَذَہُ أَنَسٌ عَنْ أَبِی طَلْحَۃَ ، وَأَخَذَہُ أَبُو طَلْحَۃَ عَنِ النَّبِیِّ صلی اللہ علیہ وسلم۔ (طحاوی ۶۹۔ احمد ۴/۳۰)",": Da'if","Musannaf Ibn Abi Shaybah 556","","","كتاب الطهارة"
"557","(۵۵۷) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ عُرْوَۃَ ، عَنْ عَائِشَۃَ ، أَنَّہَا قَالَتْ : تَوَضَّؤُوا مِمَّا مَسَّتِ النَّارُ۔","","Musannaf Ibn Abi Shaybah 557","","","كتاب الطهارة"
"558","(۵۵۸) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ مَعْمَرٍ ، عَنِ الزُّہْرِیِّ ، عَنْ خَارِجَۃَ بْنِ زَیْدٍ ، عَنْ زَیْدِ بْنِ ثَابِتٍ ، أَنَّہُ قَالَ : تَوَضَّؤُوا مِمَّا مَسَّتِ النَّارُ۔ (طبرانی ۴۸۳۹)",": Sahih","Musannaf Ibn Abi Shaybah 558","","","كتاب الطهارة"
"559","(۵۵۹) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ یُونُسَ ، عَنِ الْحَسَنِ ؛ أَنَّ أَبَا مُوسَی کَانَ یَتَوَضَّأُ مِمَّا غَیَّرَتِ النَّارُ۔",": Da'if","Musannaf Ibn Abi Shaybah 559","","","كتاب الطهارة"
"560","(۵۶۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، قَالَ : أَتَیْتُ أَنَسَ بْنَ مَالِکٍ فَلَمْ أَجِدْہُ ، فَقَعَدْتُ أَنْتَظِرُہُ ، فَجَائَ وَہُوَ مُغْضَبٌ ، فَقَالَ : کُنْتُ عِنْدَ ہَذَا ، یَعْنِی الْحَجَّاجَ ، فَأَکَلُوا ، ثُمَّ قَامُوا فَصَلَّوْا ، وَلَمْ یَتَوَضَّؤُوا ! ، فَقُلْتُ : أَوَ مَا کُنْتُمْ تَفْعَلُونَ ہَذَا یَا أَبَا حَمْزَۃَ ؟ قَالَ : مَا کُنَّا نَفْعَلُہُ۔ (عبدالرزاق ۶۷۰)",": Sahih","Musannaf Ibn Abi Shaybah 560","","","كتاب الطهارة"
"561","(۵۶۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ نَافِعٍ ، عَنِ ابْنِ عُمَرَ ؛ أَنَّہُ شَرِبَ سَوِیقًا فَتَوَضَّأَ۔",": Sahih","Musannaf Ibn Abi Shaybah 561","","","كتاب الطهارة"
"562","(۵۶۲) حَدَّثَنَا مُعْتَمِرُ بْنُ سُلَیْمَانَ ، عَنْ أَبِیہِ ، أَنَّ أَنَسًا ، وَأَبَا طَلْحَۃَ ، وَأَبَا مُوسَی ، وَابْنَ عُمَرَ ، وَزَیْدَ بْنَ ثَابِتٍ ، وَامْرَأَتَیْنِ مِنْ أَزْوَاجِ النَّبِیِّ صَلَّی اللّٰہُ عَلَیْہِ وَسَلَّمَ ؛ کَانُوا یَتَوَضَّؤُونَ مِمَّا غَیَّرَتِ النَّارُ۔",": Sahih","Musannaf Ibn Abi Shaybah 562","","","كتاب الطهارة"
"563","(۵۶۳) حَدَّثَنَا عَبْدُ الْوَہَّابِ الثَّقَفِیُّ ، عَنْ خَالِدٍ ، عَنْ أَبِی قِلاَبَۃَ ؛ أَنَّہُ کَانَ یَأْمُرُ بِالْوُضُوئِ مِمَّا غَیَّرَتِ النَّارُ ، وَسَقَاہُمْ مَرَّۃً نَبِیذًا ، فَأَتَاہُمْ بِوَضُوئٍ ، فَتَوَضَّؤُوا۔",": No Data Available","Musannaf Ibn Abi Shaybah 563","","","كتاب الطهارة"
"564","(۵۶۴) حَدَّثَنَا وَکِیعٌ ، عَنِ الْحَکَمِ بْنِ عَطِیَّۃَ ، عَنْ عَبْدِ الْعَزِیزِ بْنِ صُہَیْبٍ ، عَنْ أَنَسٍ ، قَالَ : تَوَضَّؤُوا مِنَ السُّکَّرِ، فَإِنَّ لَہُ ثُفْلاً۔",": Da'if","Musannaf Ibn Abi Shaybah 564","","","كتاب الطهارة"
"565","(۵۶۵) حَدَّثَنَا ابْنُ عُیَیْنَۃَ ، عَنِ الزُّہْرِیِّ ، أَنَّ عَائِشَۃَ ، وَأَبَا سَلَمَۃَ ، وَعُمَرَ بْنَ عَبْدِ الْعَزِیزِ ؛ کَانُوا یَتَوَضَّؤُونَ مِمَّا مَسَّتِ النَّارُ ، وَکَانَ الزُّہْرِیُّ یَتَوَضَّأُ مِنْہُ۔",": Da'if","Musannaf Ibn Abi Shaybah 565","","","كتاب الطهارة"
"566","(۵۶۶) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ أَیُّوبَ ، عَنْ أَبِی قِلاَبَۃَ ، عَنْ رَجُلٍ مِنْ ہُذَیْلٍ ، أُرَاہُ قَدْ ذَکَرَ أَنَّ لَہُ صُحْبَۃً ، قَالَ : یُتَوَضَّأُ مِمَّا غَیَّرَتِ النَّارُ۔",": Sahih","Musannaf Ibn Abi Shaybah 566","","","كتاب الطهارة"
"567","(۵۶۷) حَدَّثَنَا وَکِیعٌ ، عَنْ عُمَرَ بْنِ شَیْبَۃَ ، عَنْ عَبْدِ اللہِ بْنِ إبْرَاہِیمَ ، قَالَ : کُنْتُ مَعَ أَبِی ہُرَیْرَۃَ فَتَوَضَّأَ فَوْقَ الْمَسْجِدِ ، فَقُلْتُ لَہُ : مِنْ أَیِّ شَیْئٍ تَوَضَّأْتَ ؟ فَقَالَ : أَکَلْتُ ثَوْرَیْ أَقِطٍ۔",": Hasan","Musannaf Ibn Abi Shaybah 567","","","كتاب الطهارة"
"568","(۵۶۸) حَدَّثَنَا وَکِیعٌ ، عَنْ قُرَّۃَ بْنِ خَالِدٍ ، عَنِ الْحَسَنِ ، قَالَ : تَوَضَّأْ مِمَّا غَیَّرَتِ النَّارُ۔",": Sahih","Musannaf Ibn Abi Shaybah 568","","","كتاب الطهارة"
"569","(۵۶۹) حَدَّثَنَا غُنْدَرٌ ، عَنْ شُعْبَۃَ ، قَالَ : سَمِعْتُ أَبَا إِسْحَاقَ یُحَدِّثُ ، أَنَّہُ سَمِعَ أَبَا السَّفَرِ یُحَدِّثُ ، عَنْ عَبْدِ اللہِ بْنِ عَمْرٍو ، قَالَ : کَانُوا عِنْدَ الْمُغِیرَۃِ بْنِ شُعْبَۃَ فَأَکَلُوا لَحْمًا وَثَرِیدًا ، وَخَرَجُوا مِنْ عِنْدِہِ فَجَعَلُوا یُصَلُّونَ وَلاَ یَتَوَضَّؤُونَ ، فَقَالَ أَبُو مَسْعُودٍ : اُنْظُرْ ! یُصَلُّونَ وَلاَ یَتَوَضَّؤُونَ۔",": Sahih","Musannaf Ibn Abi Shaybah 569","","","كتاب الطهارة"
"570","(۵۷۰) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ عُبَیْدِ اللہِ بْنِ الْعَیْزَارِ ، عَنْ طَلْقِ بْنِ حَبِیبٍ ، قَالَ: رَأَی عُمَرُ بْنُ الْخَطَّابِ رَجُلاً حَکَّ إبِطَہُ ، أَوْ مَسَّہُ ، فَقَالَ لَہُ : قُمْ فَاغْسِلْ یَدَک ، أَوْ تَطَہَّرْ۔",": Da'if","Musannaf Ibn Abi Shaybah 570","","","كتاب الطهارة"
"571","(۵۷۱) حَدَّثَنَا ابْنُ عُلَیَّۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، قَالَ : قَالَ عُمَرُ : مَنْ نَقَّی أَنْفَہُ ، أَوْ حَکَّ إبِطَہُ تَوَضَّأَ۔",": Da'if","Musannaf Ibn Abi Shaybah 571","","","كتاب الطهارة"
"572","(۵۷۲) حَدَّثَنَا خَلَفُ بْنُ خَلِیفَۃَ ، عَنْ لَیْثٍ ، عَنْ مُجَاہِدٍ ، عَنِ ابْنِ عَبَّاسٍ، قَالَ: لَیْسَ عَلَیْہِ وُضُوئٌ فِی نَتْفِ الإِبِطِ۔",": Da'if","Musannaf Ibn Abi Shaybah 572","","","كتاب الطهارة"
"573","(۵۷۳) حَدَّثَنَا ابْنُ إدْرِیسَ ، عَنْ ہِشَامٍ ، عَنِ الْحَسَنِ ؛ أَنَّہُ سُئِلَ عَنِ الرَّجُلِ یَمَسُّ إبِطَہُ ، أَوْ یَنْتِفُہُ ؟ فَلَمْ یَرَ بِہِ بَأْسًا ، إِلاَّ أَنْ یُدْمِیَہُ۔",": No Data Available","Musannaf Ibn Abi Shaybah 573","","","كتاب الطهارة"
"574","(۵۷۴) حَدَّثَنَا أَبُو أُسَامَۃَ ، عَنِ ابْنِ عَوْنٍ ، عَنْ مُحَمَّدٍ ، قَالَ : ہَؤُلاَئِ یَقُولُونَ : مَنْ مَسَّ إبِطَہُ أَعَادَ الْوُضُوئَ ؟ وَأَنَا لاَ أَقُولُ ذَلِکَ ، وَلاَ أَدْرِی مَا ہَذَا۔",": No Data Available","Musannaf Ibn Abi Shaybah 574","","","كتاب الطهارة"
"575","(۵۷۵) حَدَّثَنَا أَبُو مُعَاوِیَۃَ ، عَنِ الأَعْمَشِ ، عَنْ مُجَاہِدٍ ، عَنْ عَبْدِاللہِ بْنِ عَمْرٍو؛ أَنَّہُ کَانَ یَغْتَسِلُ مِنْ نَتْفِ الأَبِطِ۔",": Da'if","Musannaf Ibn Abi Shaybah 575","","","كتاب الطهارة"
"576","(۵۷۶) حَدَّثَنَا ہُشَیْمٌ ، قَالَ: أَخْبَرَنَا یُونُسُ ، عَنِ الْحَسَنِ ؛ فِی الرَّجُلِ یَأْخُذُ مِنْ شَعْرِہِ وَمِنْ أَظْفَارِہِ بَعْدَ مَا یَتَوَضَّأُ؟ قَالَ: لاَ شَیْئَ عَلَیْہِ۔",": No Data Available","Musannaf Ibn Abi Shaybah 576","","","كتاب الطهارة"
"577","(۵۷۷) حَدَّثَنَا ہُشَیْمٌ ، قَالَ : أَخْبَرَنَا حَجَّاجٌ ، عَنِ الْحَکَمِ ، وَعَطَائٍ ، قَالاَ : لاَ شَیْئَ عَلَیْہِ ، لَمْ یَزِدْہُ إِلاَّ طَہَارَۃً۔",": No Data Available","Musannaf Ibn Abi Shaybah 577","","","كتاب الطهارة"
"578","(۵۷۸) حَدَّثَنَا شَرِیکٌ ، عَنْ عَطَائٍ ، عَنْ سَعِیدِ بْنِ جُبَیْرٍ ، قَالَ : ہُوَ طَہُورٌ وَبَرَکَۃٌ۔",": No Data Available","Musannaf Ibn Abi Shaybah 578","","","كتاب الطهارة"
