hadiths[9]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"223","[1/192]      40 - بَابُ [مَا جَاءَ]  فِي تَزْوِيجِ الْأَكْفَاءِ  224  -  حَدَّثَنَا  يَحْيَى بْنُ مَعِينٍ ،  حَدَّثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  حَدَّثَنَا  ابْنُ هُرْمُزَ الْفَدَكِيُّ ،  عَنْ  سَعِيدٍ ، وَمُحَمَّدٍ ، ابْنَيْ عُبَيْدٍ .  عَنْ  أَبِي حَاتِمٍ الْمُزَنِيِّ ، قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا جَاءَكُمْ مَنْ تَرْضَوْنَ دِينَهُ  وَخُلُقَهُ  فَأَنْكِحُوهُ  ثَلَاثَ مَرَّاتٍ .  ( 11886 )  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 224","","أبو حاتم المزني عن محمد بن عبيد عن عبد الله بن مسلم بن هرمز الفدكي عن حاتم بن إسماعيل الحارثي عن يحيى بن معين عن أبو داود السجستاني","باب ما جاء في تزويج الأكفاء"
"224","[1/193]      225  -  حَدَّثَنَا  قُتَيْبَةُ [بْنُ سَعِيدٍ]  ،  حَدَّثَنَا  اللَّيْثُ ،  عَنِ  ابْنِ عَجْلَانَ .  عَنْ  عَبْدِ اللهِ بْنِ هُرْمُزَ الْيَمَانِيِّ  ، أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ : بِمَعْنَاهُ ، قَالَ :  فَرَاجَعُوهُ  النَّاسُ ، فَرَدَّدَهَا  ثَلَاثَ مَرَّاتٍ  ( 11886 ) .  قَالَ أَبُو دَاوُدَ :  قَدْ  أَسْنَدَهُ  عَبْدُ الْحَمِيدِ بْنُ سُلَيْمَانَ  عَنِ  ابْنِ عَجْلَانَ  ، وَهُوَ  خَطَأٌ  .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: اليمامي .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فراجعه .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فردها .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: وقد .","","Al-Marasil li-Abi Dawud 225","","عبد الله بن هرمز الفدكي عن محمد بن عجلان عن الليث بن سعد عن قتيبة بن سعيد عن أبو داود السجستاني","باب ما جاء في تزويج الأكفاء"
"225","226  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ الْجَرَّاحِ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنِ  الشَّيْبَانِيِّ .  عَنِ  الْحَكَمِ بْنِ عُتَيْبَةَ  ،  أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَرْسَلَ  بِلَالًا  إِلَى أَهْلِ بَيْتٍ مِنَ  الْأَنْصَارِ  يَخْطُبُ إِلَيْهِمْ ، فَقَالُوا : عَبْدٌ حَبَشِيٌّ ، فَقَالَ  بِلَالٌ  : لَوْلَا أَنَّ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَنِي أَنْ آتِيَكُمْ مَا أَتَيْتُكُمْ ، فَقَالُوا : النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ أَمَرَكَ ، قَالَ : نَعَمْ ، قَالُوا : قَدْ مَلَكْتَ ، فَجَاءَ [إِلَى]  النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرَهُ ، فَأُدْخِلَتْ عَلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قِطْعَةٌ مِنْ ذَهَبٍ فَأَعْطَاهُ إِيَّاهَا فَقَالَ :  سُقْ هَذَا إِلَى         [1/194]      امْرَأَتِكَ  ، وَقَالَ لِأَصْحَابِهِ : اجْمَعُوا لِأَخِيكُمْ فِي وَلِيمَتِهِ  ( 18584 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: عتبة .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 226","","الحكم بن عتيبة الكندي عن سليمان بن فيروز الشيباني عن جرير بن عبد الحميد عن عبد الله بن الجراح القهستاني عن أبو داود السجستاني","باب ما جاء في تزويج الأكفاء"
"226","227  -  حَدَّثَنَا  عُثْمَانُ  ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ .  عَنْ  عَامِرٍ قَالَ :  انْطَلَقَ بِلَالٌ بِأَخِيهِ يَخْطُبُ عَلَيْهِ إِلَى قَوْمٍ مِنَ الْعَرَبِ  ، فَقَالُوا  : عَبْدَانِ حَبَشِيَّانِ ،  [فَقَالَ  بِلَالٌ  : نَعَمْ]  ، كُنَّا ضَالَّيْنِ فَهَدَانَا اللهُ ، وَكُنَّا مَمْلُوكَيْنِ فَأَعْتَقَنَا اللهُ - [عَزَّ وَجَلَّ]  -  ( 18873 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: بن أبي شيبة .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فقال .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .  كذا في طبعة الرسالة ، وما بين المعقوفين غير موجود في طبعة دار الصميعي .","","Al-Marasil li-Abi Dawud 227","","بلال بن رباح سابق الحبشة عن الشعبي عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو داود السجستاني","باب ما جاء في تزويج الأكفاء"
"227","228  -  حَدَّثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  حَدَّثَنَا  جَرِيرٌ ،  عَنْ  مُغِيرَةَ  ، ذَكَرَهُ .  عَنْ  مُحَارِبٍ ، قَالَ :  إِنْ تُنْكِحُونَا ، فَالْحَمْدُ لِلهِ ، وَإِنْ تَرُدُّونَا فَاللهُ أَكْبَرُ  ( 18873 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي ، زيادة: عن إبراهيم قال .","","Al-Marasil li-Abi Dawud 228","","محارب بن دثار عن المغيرة بن مقسم الضبي عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن أبو داود السجستاني","باب ما جاء في تزويج الأكفاء"
"228","229  -  حَدَّثَنَا  هَارُونُ بْنُ زَيْدٍ ،  حَدَّثَنَا  أَبِي  ،  عَنْ  هِشَامِ بْنِ سَعْدٍ .  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  أَنَّ  بَنِي بُكَيْرٍ  أَتَوْا [رَسُولَ اللهِ]  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا : زَوِّجْ أُخْتَنَا مِنْ فُلَانٍ  ، فَقَالَ : أَيْنَ أَنْتُمْ عَنْ  بِلَالٍ  ؟ فَأَعَادُوا ، فَأَعَادَ الْكَلَامَ ثَلَاثًا فَزَوَّجُوهُ ، قَالَ : وَكَانَ  بَنُو بُكَيْرٍ مِنَ الْمُهَاجِرِينَ مِنْ بَنِي لَيْثٍ  ( 18759 ) .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: قال نا .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: النبي .","","Al-Marasil li-Abi Dawud 229","","زيد بن أسلم عن هشام بن سعد المخزومي عن زيد بن أبي الزرقاء التغلبي عن هارون بن زيد بن أبي الزرقاء عن أبو داود السجستاني","باب ما جاء في تزويج الأكفاء"
"229","[1/195]      230  -  حَدَّثَنَا  عَمْرُو بْنُ عُثْمَانَ ، وَكَثِيرُ بْنُ عُبَيْدٍ ، قَالَا :  حَدَّثَنَا  بَقِيَّةُ ،  حَدَّثَنِي  الزُّبَيْدِيُّ .  حَدَّثَنِي  الزُّهْرِيُّ ، قَالَ :  أَمَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  بَنِي بَيَاضَةَ  أَنْ يُزَوِّجُوا  أَبَا هِنْدٍ  امْرَأَةً مِنْهُمْ  ، فَقَالُوا : يَا رَسُولَ اللهِ نُزَوِّجُ بَنَاتِنَا مَوَالِيَنَا ؟ فَأَنْزَلَ اللهُ - [عَزَّ وَجَلَّ]  - :         {      إِنَّا خَلَقْنَاكُمْ مِنْ ذَكَرٍ وَأُنْثَى وَجَعَلْنَاكُمْ شُعُوبًا وَقَبَائِلَ         }      الْآيَةَ .  قَالَ الزُّهْرِيُّ :  نَزَلَتْ فِي  أَبِي هِنْدٍ  خَاصَّةً  ( 19373 ) .  قَالَ أَبُو دَاوُدَ :  وَرُوِيَ  بَعْضُهُ  مُسْنَدًا  ، وَهُوَ ضَعِيفٌ  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: تعالى .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: روي .","","Al-Marasil li-Abi Dawud 230","","الزهري عن محمد بن الوليد بن عامر الزبيدي عن بقية بن الوليد عن عمرو بن عثمان بن سعيد الحمصي عن أبو داود السجستاني","باب ما جاء في تزويج الأكفاء"
"230","[1/196]      231  -  حَدَّثَنَا  عِيسَى بْنُ يُونُسَ الطَّرَسُوسِيُّ ،  حَدَّثَنَا  مُوسَى بْنُ دَاوُدَ ،  عَنْ  مُحَمَّدِ بْنِ مُسْلِمٍ .  عَنْ  عَمْرِو بْنِ دِينَارٍ :  أَنَّ  بِلَالًا  كَانَتْ تَحْتَهُ قُرَشِيَّةٌ  ( 19160 ) .","","Al-Marasil li-Abi Dawud 231","","عمرو بن دينار الأثرم عن محمد بن مسلم بن سوسن الطائفي عن موسى بن داود الخلقاني عن عيسى بن يونس الطرسوسي عن أبو داود السجستاني","باب ما جاء في تزويج الأكفاء"
"231","232  -  حَدَّثَنَا  ابْنُ عُبَيْدٍ ، فِي حَدِيثِ حَمَّادٍ  عَنْ  أَيُّوبَ .  عَنْ  عِكْرِمَةَ ،  أَنَّ  رَجُلًا  زَوَّجَ  ابْنَتَهُ  وَهِيَ كَارِهَةٌ  ، فَأَتَتِ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَتْ ذَلِكَ لَهُ ، فَقَالَ  : أَتَكْرَهِينَهُ  ؟ قَالَتْ : نَعَمْ ، فَجَعَلَ أَمْرَهَا بِيَدِهَا  ( 19103 )  .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: فقال النبي صلى الله عليه وسلم .  كذا في طبعة الرسالة ، وفي طبعة دار الصميعي: أزجرتيه .  يوجد أربعة أحاديث في طبعة دار الصميعي بعد هذا الحديث ، وهي : 221 - حدثنا هارون بن زيد ، نا أبي ، نا محمد بن راشد ، نا مكحول ، عن سلمة بن أبي سلمة ، عن أبيه ، أن عبد الله بن عمر خطب إلى نعيم بن عبد الله وكانت بكرا ، فقال له : إن عندي يتيما لي ، ولست مؤثرا عليه أحدا ، فأتت أم الجارية رسول الله - صلى الله عليه وسلم - فذكرت ذلك له ، وكراهيتها وكراهية ابنتها لليتيم ، فأرسل رسول الله - صلى الله عليه وسلم - إلى نعيم فقال : أرضها وأرض ابنتها . ثم لقيت سلمة بعد ذلك فحدثني كما حدثني مكحول عنه . 222 - حدثنا عثمان بن أبي شيبة ، نا معاوية بن هشام ، عن سفيان ، عن إسماعيل بن أمية قال : أخبرني الثقة عن ابن عمر قال : قال رسول الله - صلى الله عليه وسلم - آمروا النساء في بناتهن . 223 - حدثنا الوليد بن عتبة ، نا الوليد ، نا الأوزاعي ، عن إبراهيم بن مرة ، عن عطاء أن رجلا زوج ابنته وهي كارهة ، فرد رسول الله - صلى الله عليه وسلم - نكاحها . 224 - حدثنا مسدد ، نا يحيى ، عن هشام بن أبي عبد الله ، عن يحيى بن أبي كثير ، عن مهاجر بن عكرمة ، عن عبد الله بن أبي بكر ، أن النبي - صلى الله عليه وسلم - فرق بين جارية بكر وبين زوجها ، زوجها أبوها وهي كارهة .","","Al-Marasil li-Abi Dawud 232","","عكرمة مولى ابن عباس عن أيوب السختياني عن حماد بن زيد عن محمد بن عبيد بن حساب الغبري عن أبو داود السجستاني","باب ما جاء في تزويج الأكفاء"
