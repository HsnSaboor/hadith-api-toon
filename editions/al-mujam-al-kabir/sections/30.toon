hadiths[600]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"17401","320  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ أَبِي الْوَزِيرِ ،  ثَنَا  مُحَمَّدُ بْنُ مُوسَى الْعَنْقَزِيُّ  ،  عَنْ  سَعْدِ بْنِ إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَلَّى الْمَغْرِبَ فِي  مَسْجِدِ بَنِي عَبْدِ الْأَشْهَلِ  ،  فَلَمَّا صَلَّى قَامَ نَاسٌ يَتَنَفَّلُونَ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : عَلَيْكُمْ بِهَذِهِ الصَّلَاةِ فِي الْبُيُوتِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( الفطري )","","Al-Mu'jam al-Kabir 320","","كعب بن عجرة عن إسحاق بن كعب بن عجرة القضاعي عن سعد بن إسحاق بن كعب بن عجرة عن محمد بن موسى الفطري عن إبراهيم بن أبي الوزير عن محمد بن أبي بكر المقدمي عن إبراهيم بن هاشم البغوي عن الطبراني","إسحاق بن كعب بن عجرة عن أبيه كعب"
"17402","321  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ قَالَ :  ثَنَا  حُمَيْدُ بْنُ الرَّبِيعِ ،  ثَنَا         [19/147]      دَاوُدُ بْنُ عَطَاءٍ الْمَدَنِيُّ ،  ثَنَا  سَعْدُ بْنُ إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَتَطَهَّرُ رَجُلٌ فِي بَيْتِهِ ثُمَّ يَخْرُجُ إِلَّا كَانَ فِي صَلَاةٍ حَتَّى يُصَلِّيَ صَلَاتَهُ ،  فَلَا  يُشَبِّكْ  أَحَدُكُمْ بَيْنَ أَصَابِعِهِ وَهُوَ فِي الصَّلَاةِ .","","Al-Mu'jam al-Kabir 321","","كعب بن عجرة عن إسحاق بن كعب بن عجرة القضاعي عن سعد بن إسحاق بن كعب بن عجرة عن داود بن عطاء المزني عن حميد بن الربيع الجلاد عن عبد الله بن أحمد الجواليقي عن الطبراني","إسحاق بن كعب بن عجرة عن أبيه كعب"
"17403","322  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مَتُّوَيْهِ الْأَصْبَهَانِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  صَالِحُ بْنُ بَدَلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الْمَدَنِيُّ ،  عَنْ  سَعْدِ بْنِ إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ  قَالَ : كُنَّا  جُلُوسًا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَرَّ بِنَا  رَجُلٌ  مُتَقَنِّعٌ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَكُونُ بَيْنَ النَّاسِ فُرْقَةٌ وَاخْتِلَافٌ ، فَيَكُونُ هَذَا وَأَصْحَابُهُ عَلَى الْحَقِّ  ،  قَالَ  كَعْبٌ  : فَأَدْرَكْتُهُ فَنَظَرْتُ إِلَيْهِ حَتَّى عَرَفْتُهُ  ، وَكُنَّا نَسْأَلُ  كَعْبًا  مَنِ الرَّجُلُ ؟ فَيَأْبَى يُخْبِرُنَا ، حَتَّى خَرَجَ  كَعْبٌ  مَعَ  عَلِيٍّ  إِلَى  الْكُوفَةِ  فَلَمْ يَزَلْ حَتَّى مَاتَ ، فَكَأَنَّا أَنْ عَرَفْنَا أَنَّ ذَلِكَ الرَّجُلَ  عَلِيٌّ  رَضِيَ اللهُ عَنْهُ  .","","Al-Mu'jam al-Kabir 322","","كعب بن عجرة عن إسحاق بن كعب بن عجرة القضاعي عن سعد بن إسحاق بن كعب بن عجرة عن عبد الله بن جعفر بن نجيح عن صالح بن بدل عن إبراهيم بن سعيد الجوهري عن إبراهيم بن محمد الطيان عن الطبراني","إسحاق بن كعب بن عجرة عن أبيه كعب"
"17404","323  -  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ الرَّمْلِيُّ  ، ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللهِ الْأَوْسِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ نِسْطَاسٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  بِشْرُ بْنُ عُبَيْسِ بْنِ مَرْحُومٍ الْعَطَّارُ ،  ثَنَا  جَدِّي مَرْحُومُ بْنُ عَبْدِ الْعَزِيزِ  ،  عَنْ  إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ نِسْطَاسٍ ،  عَنْ  سَعْدِ بْنِ إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا لِأَصْحَابِهِ :  فَمَا تَقُولُونَ فِي رَجُلٍ قُتِلَ فِي  سَبِيلِ         [19/148]      اللهِ ؟ قَالُوا : الْجَنَّةُ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : الْجَنَّةُ إِنْ شَاءَ اللهُ .  قَالَ : فَمَا تَقُولُونَ فِي رَجُلٍ مَاتَ فِي  سَبِيلِ  اللهِ ؟ قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ . قَالَ : الْجَنَّةُ إِنْ شَاءَ اللهُ . قَالَ : فَمَا تَقُولُونَ فِي رَجُلٍ مَاتَ فَقَامَ رَجُلَانِ ذَوَا عَدْلٍ فَقَالَا : لَا نَعْلَمُ إِلَّا خَيْرًا ؟ قَالُوا : اللهُ وَرَسُولُهُ أَعْلَمُ . قَالَ : الْجَنَّةُ إِنْ شَاءَ اللهُ . قَالَ : فَمَا تَقُولُونَ فِي رَجُلٍ مَاتَ فَقَامَ رَجُلَانِ ذَوَا عَدْلٍ فَقَالَا : لَا نَعْلَمُ خَيْرًا ؟ فَقَالُوا : النَّارُ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مُذْنِبٌ ، وَاللهُ غَفُورٌ رَحِيمٌ  .","","Al-Mu'jam al-Kabir 323","","كعب بن عجرة عن إسحاق بن كعب بن عجرة القضاعي عن سعد بن إسحاق بن كعب بن عجرة عن إسحاق بن إبراهيم بن نسطاس عن مرحوم بن عبد العزيز العطار عن بشر بن عبيس بن مرحوم العطار عن محمد بن علي بن زيد الصائغ عن الطبراني","إسحاق بن كعب بن عجرة عن أبيه كعب"
"17405","324  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  سُفْيَانُ بْنُ بِشْرٍ الْكُوفِيُّ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنْ  إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  أَبِيهِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا  تَسُبُّوا  عَلِيًّا  ، فَإِنَّهُ كَانَ مَمْسُوسًا فِي ذَاتِ اللهِ عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 324","","كعب بن عجرة عن إسحاق بن كعب بن عجرة القضاعي عن يزيد بن أبي زياد القرشي عن عبد الرحيم بن سليمان الأشل عن سفيان بن بشر الكوفي عن يحيى بن عثمان بن صالح عن الطبراني","إسحاق بن كعب بن عجرة عن أبيه كعب"
"17406","عَبْدُ الْمَلِكِ بْنُ كَعْبِ بْنِ عُجْرَةَ  عَنْ  كَعْبٍ  325  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  سَعْدِ بْنِ إِسْحَاقَ بْنِ كَعْبٍ ،  عَنْ  عَمِّهِ         [19/149]      عَبْدِ الْمَلِكِ قَالَ :  خَرَجْتُ مَعَ كَعْبِ بْنِ عُجْرَةَ يَوْمَ الْعِيدِ إِلَى الْمُصَلَّى ، فَجَلَسَ قَبْلَ أَنْ يَأْتِيَ الْإِمَامُ وَلَمْ يُصَلِّ حَتَّى انْصَرَفَ الْإِمَامُ  ، وَالنَّاسُ ذَاهِبُونَ كَأَنَّهُمْ عُنُقٌ نَحْوَ الْمَسْجِدِ ، فَقُلْتُ : أَلَا تَرَى ؟  فَقَالَ  : هَذِهِ بِدْعَةٌ وَتَرْكُ السُّنَّةِ .","","Al-Mu'jam al-Kabir 325","","كعب بن عجرة عن عبد الملك بن كعب بن عجرة البلوي عن سعد بن إسحاق بن كعب بن عجرة عن محمد بن عبد الرحمن بن المغيرة عن آدم بن أبي إياس عن أبو زرعة الدمشقي عن الطبراني","عبد الملك بن كعب بن عجرة عن كعب"
"17407","326  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  ثَنَا  أَبِي  ، ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  سَعْدِ بْنِ إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ كَعْبِ بْنِ عُجْرَةَ قَالَ :  شَهِدْتُ مَعَ كَعْبٍ إِحْدَى الْعِيدَيْنِ ، فَلَمَّا انْصَرَفَ النَّاسُ ذَهَبَ أَكْثَرُهُمْ إِلَى الْمَسْجِدِ  ، وَرَأَيْتُهُ يَعْمِدُ إِلَى الْبَيْتِ ، فَقُلْتُ : يَا أَبَهْ ، أَلَا تَعْمِدُ إِلَى الْمَسْجِدِ ، فَإِنِّي أَرَى النَّاسَ يَعْمِدُونَ إِلَيْهِ ؟  فَقَالَ  : إِنَّ كَثِيرًا مِمَّا تَرَى جَفَاءٌ وَقِلَّةُ عِلْمٍ ، إِنَّ هَاتَيْنِ الرَّكْعَتَيْنِ  سُبْحَةُ  هَذَا الْيَوْمِ حَتَّى تَكُونَ الصَّلَاةُ تَدْعُوكَ  .","","Al-Mu'jam al-Kabir 326","","كعب بن عجرة عن عبد الملك بن كعب بن عجرة البلوي عن سعد بن إسحاق بن كعب بن عجرة عن أنس بن عياض الليثي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","عبد الملك بن كعب بن عجرة عن كعب"
"17408","مُحَمَّدُ بْنُ كَعْبِ بْنِ عُجْرَةَ  عَنْ أَبِيهِ  327  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  عَنْ  سَعْدِ بْنِ إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  حَدَّثَنِي  عَمِّي  قَالَ :  خَرَجْتُ مَعَ أَبِي - وَكَانَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الْعِيدِ إِلَى الْمُصَلَّى ، فَجَلَسَ قَبْلَ أَنْ يَأْتِيَ الْإِمَامُ ،  وَلَمْ يَأْتِ ، حَتَّى إِذَا انْصَرَفَ الْإِمَامُ انْصَرَفُوا ذَاهِبِينَ نَحْوَ الْمَسْجِدِ كَأَنَّهُمْ عُنُقٌ ، فَقُلْتُ لَهُ : أَلَا تَرَى النَّاسَ ؟  فَقَالَ  : هَذِهِ بِدْعَةٌ وَتَرْكُ السُّنَّةِ  .","","Al-Mu'jam al-Kabir 327","","كعب بن عجرة عن عبد الملك بن كعب بن عجرة البلوي عن سعد بن إسحاق بن كعب بن عجرة عن محمد بن عبد الرحمن بن المغيرة عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","محمد بن كعب بن عجرة عن أبيه"
"17409","الرَّبِيعُ بْنُ كَعْبِ بْنِ عُجْرَةَ  عَنْ أَبِيهِ  328  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ         [19/150]      ، ثَنَا  عَمْرُو بْنُ النُّعْمَانِ ،  حَدَّثَنِي  مُوسَى بْنُ دِهْقَانَ ،  حَدَّثَنِي  الرَّبِيعُ بْنُ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كُنْتُ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا فُلَانُ ، تَزَوَّجْتَ ؟ فَقَالَ : لَا ، فَقَالَ لِي : تَزَوَّجْتَ ؟ فَقُلْتُ : نَعَمْ ، فَقَالَ : أَبِكْرًا أَمْ  ثَيِّبًا  ؟ قُلْتُ : لَا ، بَلْ  ثَيِّبًا  ، فَقَالَ :  فَهَلَّا بِكْرًا تَعَضُّهَا وَتَعَضُّكَ  .","","Al-Mu'jam al-Kabir 328","","كعب بن عجرة عن الربيع بن أبي بن كعب الأنصاري عن موسى بن دهقان البصري عن عمرو بن النعمان الباهلي عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","الربيع بن كعب بن عجرة عن أبيه"
"17410","سُلَيْمَانُ بْنُ مُحَمَّدِ بْنِ كَعْبِ بْنِ عُجْرَةَ  عَنْ جَدِّهِ  329  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  سُفْيَانُ ،         [19/151]      عَنْ  أَيُّوبَ بْنِ مُوسَى ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنْ  سُلَيْمَانَ بْنِ مُحَمَّدِ بْنِ كَعْبٍ  أَنَّ  عُمَرَ  سَأَلَ كَعْبًا فَقَالَ : أَيَّ شَيْءٍ افْتَدَى  كَعْبٌ  حِينَ حَلَقَ رَأْسَهُ ؟ قَالَ : ذَبَحَ بَقَرَةً  .","","Al-Mu'jam al-Kabir 329","","كعب بن عجرة عن سليمان بن كعب بن عجرة الأنصاري عن محمد بن يحيى بن حبان عن أيوب بن موسى الأموي عن سفيان الثوري عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","سليمان بن محمد بن كعب بن عجرة عن جده"
"17411","330  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدٍ ،  ثَنَا  عَمِّي ،  ثَنَا  أَبِي  ،  عَنِ  ابْنِ إِسْحَاقَ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ الْأَنْصَارِيِّ ،  عَنْ  سُلَيْمَانَ بْنِ كَعْبِ بْنِ عُجْرَةَ  أَنَّ  كَعْبًا قَالَ  لِعُمَرَ  : ذَبَحْتُ بَقَرَةً  .","","Al-Mu'jam al-Kabir 330","","كعب بن عجرة عن سليمان بن كعب بن عجرة الأنصاري عن محمد بن يحيى بن حبان عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبيد الله بن سعد بن إبراهيم الزهري عن عبد الله بن أحمد الجواليقي عن الطبراني","سليمان بن محمد بن كعب بن عجرة عن جده"
"17412","أَنَسُ بْنُ سُلَيْمَانَ مَوْلَى كَعْبِ بْنِ عُجْرَةَ  عَنْ  كَعْبٍ  331  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو ضَمْرَةَ أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  سَعْدِ بْنِ إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  أَنَسِ بْنِ سُلَيْمَانَ مَوْلَى كَعْبِ بْنِ عُجْرَةَ قَالَ :  أَشْهَدُ لَقَدْ  رَأَيْتُ  أَرْبَعَةً أَوْ خَمْسَةً مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَلْبَسُونَ الْمُعَصْفَرَ  ، مِنْهُمْ كَعْبُ بْنُ عُجْرَةَ  .","","Al-Mu'jam al-Kabir 331","","كعب بن عجرة عن أنس بن سليمان مولى كعب بن عجرة عن سعد بن إسحاق بن كعب بن عجرة عن أنس بن عياض الليثي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","أنس بن سليمان مولى كعب بن عجرة عن كعب"
"17413","أَبُو ثُمَامَةَ الْحَنَّاطُ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  332  -  حَدَّثَنَا  الْحَسَنُ بْنُ سَهْلٍ الْمُجَوِّزُ الْبَصْرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ         [19/152]      الْهَيْثَمِ الْمُؤَذِّنُ ،  ثَنَا  دَاوُدُ بْنُ قَيْسٍ الْفَرَّاءُ ،  ثَنَا  سَعْدُ بْنُ إِسْحَاقَ بْنِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  أَبِي ثُمَامَةَ الْحَنَّاطِ قَالَ : لَقِيَنِي كَعْبُ بْنُ عُجْرَةَ وَأَنَا مُتَوَجِّهٌ إِلَى الْمَسْجِدِ مُشَبِّكٌ أَصَابِعِي ،  فَقَالَ  : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا تَوَضَّأَ أَحَدُكُمْ ثُمَّ أَتَى الْمَسْجِدَ فَلَا  يُشَبِّكْ  بَيْنَ أَصَابِعِهِ ، فَإِنَّهُ فِي صَلَاةٍ  .","","Al-Mu'jam al-Kabir 332","","كعب بن عجرة عن أبو ثمامة القماح عن سعد بن إسحاق بن كعب بن عجرة عن داود بن قيس الدباغ عن عثمان بن الهيثم بن جهم الأشج عن الحسن بن سهل بن عبد العزيز المجوز عن الطبراني","أبو ثمامة الحناط عن كعب بن عجرة"
"17414","333  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَبُو ضَمْرَةَ أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  سَعْدِ بْنِ إِسْحَاقَ بْنِ  كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِي ثُمَامَةَ قَالَ :  لَقِيتُ كَعْبَ بْنَ عُجْرَةَ يَوْمَ جُمُعَةٍ وَأَنَا أُرِيدُ الْجُمُعَةَ ، فَلَمَّا رَأَيْتُهُ أَسْرَعْتُ نَحْوَهُ وَقَدْ شَبَّكْتُ بَيْنَ أَصَابِعِي ، فَلَمَّا دَنَوْتُ مِنْهُ ضَرَبَ يَدَيَّ وَفَرَّقَ بَيْنَ أَصَابِعِي ، فَقُلْتُ : مَا هَذَا يَا  أَبَا مُحَمَّدٍ  ؟  فَقَالَ  :  إِنَّا قَدْ نُهِينَا أَنْ  يُشَبِّكَ  أَحَدُنَا بَيْنَ أَصَابِعِهِ فِي الصَّلَاةِ  ، قُلْتُ : إِنِّي لَسْتُ فِي الصَّلَاةِ ، فَقَالَ : أَلَيْسَ تَوَضَّأْتَ وَأَنْتَ تُرِيدُ الْجُمُعَةَ ؟ قُلْتُ : بَلَى ، قَالَ : فَأَنْتَ فِي صَلَاةٍ  .  في طبعة مكتبة ابن تيمية : (عن) والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 333","","كعب بن عجرة عن أبو ثمامة القماح عن أبو سعيد المقبري عن سعد بن إسحاق بن كعب بن عجرة عن أنس بن عياض الليثي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","أبو ثمامة الحناط عن كعب بن عجرة"
"17415","سَعِيدُ بْنُ أَبِي سَعِيدٍ الْمَقْبُرِيُّ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  334  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ         [19/153]      بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ (  ح  ) .  وَحَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنِ  ابْنِ عَجْلَانَ قَالَ :  حَدَّثَنِي  سَعِيدُ بْنُ أَبِي سَعِيدٍ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ : قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا تَوَضَّأْتَ ثُمَّ خَرَجْتَ عَامِدًا إِلَى الْمَسْجِدِ فَلَا  تُشَبِّكَنَّ  بَيْنَ أَصَابِعِكَ ، فَإِنَّكَ فِي صَلَاةٍ  .","","Al-Mu'jam al-Kabir 334","","كعب بن عجرة عن سعيد المقبري عن محمد بن عجلان عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سعيد بن أبي سعيد المقبري عن كعب بن عجرة"
"17416","335  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هِشَامٍ الْمُسْتَمْلِي  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ قُسَيْطٍ وَمُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  رَجُلٍ مِنْ آلِ كَعْبِ بْنِ عُجْرَةَ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَا  كَعْبُ ،  إِذَا خَرَجْتَ مِنْ مَنْزِلِكَ تُرِيدُ الصَّلَاةَ فَلَا  تُشَبِّكْ  بَيْنَ أَصَابِعِكَ  .","","Al-Mu'jam al-Kabir 335","","كعب بن عجرة عن رجل من آل كعب بن عجرة عن سعيد المقبري عن محمد بن عجلان عن سفيان بن عيينة عن علي ابن المديني عن ابن أبى الدميك محمد بن هشام بن علي عن الطبراني","سعيد بن أبي سعيد المقبري عن كعب بن عجرة"
"17417","336  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  خَالِدُ بْنُ الْحَارِثِ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا تَوَضَّأْتَ فَأَحْسَنْتَ الْوُضُوءَ ثُمَّ خَرَجْتَ عَامِدًا إِلَى الْمَسْجِدِ فَلَا  تُشَبِّكَنَّ  بَيْنَ أَصَابِعِكَ  .","","Al-Mu'jam al-Kabir 336","","كعب بن عجرة عن سعيد المقبري عن محمد بن عجلان عن خالد الصدق عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سعيد بن أبي سعيد المقبري عن كعب بن عجرة"
"17418","337  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ         [19/154]      أَبِي مَعْشَرٍ ،  عَنْ  أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  رَجُلٍ مِنْ بَنِي سَلِمَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَا مِنْ رَجُلٍ يَتَوَضَّأُ فِي بَيْتِهِ ثُمَّ يَخْرُجُ يُرِيدُ الصَّلَاةَ إِلَّا كَانَ فِي صَلَاةٍ حَتَّى يَقْضِيَ صَلَاتَهُ  ، فَلَا  يُشَبِّكْ  بَيْنَ أَصَابِعِهِ فِي الصَّلَاةِ .","","Al-Mu'jam al-Kabir 337","","كعب بن عجرة عن جده عن أبيه عن رجل من بني سلمة عن أبو سعيد المقبري عن نجيح بن عبد الرحمن السندي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سعيد بن أبي سعيد المقبري عن كعب بن عجرة"
"17419","سُلَيْمَانُ بْنُ يَسَارٍ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  339  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  ابْنِ أَبِي لَيْلَى ،  عَنْ  نَافِعٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ  أَنَّهُ ذَبَحَ بَقَرَةً  .","","Al-Mu'jam al-Kabir 339","","كعب بن عجرة عن سليمان بن يسار مولى ميمونة زوج رسول الله عن نافع مولى ابن عمر عن محمد بن عبد الرحمن بن أبي ليلى عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","سليمان بن يسار عن كعب بن عجرة"
"17420","أَبُو جَعْفَرٍ مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحُسَيْنِ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  340  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  ابْنُ الْأَصْبَهَانِيِّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  جَابِرٍ ،  عَنْ  أَبِي جَعْفَرٍ قَالَ :  قُلْتُ  لِكَعْبِ بْنِ عُجْرَةَ : حَدِّثْ بِمَا سَمِعْتَ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ . فَقَالَ : سَمِعْتُهُ يَقُولُ :  لَا تَحِلُّ بِنْتُ الْأَخِ وَلَا بِنْتُ الْأُخْتِ مِنَ الرَّضَاعَةِ  .","","Al-Mu'jam al-Kabir 340","","كعب بن عجرة عن أبو جعفر الباقر عن جابر الجعفي عن شريك بن عبد الله النخعي عن عبد الرحمن بن عبد الله بن الأصبهاني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو جعفر محمد بن علي بن الحسين عن كعب بن عجرة"
"17421","أَبُو بَكْرِ بْنُ حَفْصِ بْنِ عُمَرَ بْنِ سَعْدٍ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  341  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ سَعِيدٍ الْقَطَّانُ ،  ثَنَا  يَحْيَى بْنُ آدَمَ (  ح  ) .         [19/155]      وَحَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ أَبِي كَثِيرٍ  - قَالَا :  ثَنَا  فُضَيْلُ بْنُ مَرْزُوقٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  رَجُلٍ يُقَالُ لَهُ أَبُو بَكْرٍ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ :  قَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، قَدْ عَلِمْنَا كَيْفَ السَّلَامُ عَلَيْكَ ، فَكَيْفَ الصَّلَاةُ عَلَيْكَ ؟ فَقَالَ :  تَقُولُوا : اللَّهُمَّ صَلِّ عَلَى  مُحَمَّدٍ  وَعَلَى  آلِ مُحَمَّدٍ  كَمَا صَلَّيْتَ عَلَى  إِبْرَاهِيمَ  إِنَّكَ حَمِيدٌ مَجِيدٌ  ، اللَّهُمَّ بَارِكْ عَلَى  مُحَمَّدٍ  وَعَلَى  آلِ مُحَمَّدٍ  كَمَا بَارَكْتَ عَلَى  إِبْرَاهِيمَ  إِنَّكَ حَمِيدٌ مَجِيدٌ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( أبي بكير )","","Al-Mu'jam al-Kabir 341","","كعب بن عجرة عن أبو بكر بن بشير عن أبو إسحاق السبيعي عن فضيل بن مرزوق الأغر عن يحيى بن آدم عن أحمد بن محمد بن يحيى القطان عن محمد بن العباس ابن الأخرم عن الطبراني","أبو بكر بن حفص بن عمر بن سعد عن كعب بن عجرة"
"17422","342  -  حَدَّثَنَا  يَعْقُوبُ بْنُ إِسْحَاقَ بْنِ أَبِي إِسْرَائِيلَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ :  سَأَلْنَا رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : كَيْفَ نُصَلِّي عَلَيْكَ ؟  فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 342","","كعب بن عجرة عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن أبو إسحاق السبيعي عن محمد بن جابر بن سيار عن إسحاق بن أبي إسرائيل عن يعقوب بن إبراهيم بن كامجرا البغدادي عن الطبراني","أبو بكر بن حفص بن عمر بن سعد عن كعب بن عجرة"
"17423","عَبْدُ اللهِ بْنُ أَبِي الْحُسَيْنِ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  343  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي الْمِصِّيصِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ،  ثَنَا  مُحَمَّدُ بْنُ جَابِرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْحُسَيْنِ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَلَا أَدُلُّكُمْ عَلَى خَيْرِ  أَخْلَاقِ  أَهْلِ الدُّنْيَا وَالْآخِرَةِ ؟ مَنْ وَصَلَ مَنْ قَطَعَهُ  ، وَعَفَا عَمَّنْ ظَلَمَهُ ، وَأَعْطَى مَنْ حَرَمَهُ  . قَالَ  لُوَيْنٌ  : يُقَالُ وَاللهُ أَعْلَمُ :  عَبْدُ اللهِ بْنُ أَبِي الْحُسَيْنِ يُكْنَى أَبَا الْحُسَيْنِ  .  وَرَوَى  أَبُو الْأَحْوَصِ  عَنْ  أَبِي إِسْحَاقَ  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْحُسَيْنِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَمْ يَذْكُرْ  كَعْبَ بْنَ عُجْرَةَ  .","","Al-Mu'jam al-Kabir 343","","كعب بن عجرة عن أبو الحسين عن أبو إسحاق السبيعي عن محمد بن جابر بن سيار عن محمد بن سليمان لوين عن يحيى بن عبد الباقي الثغري عن الطبراني","عبد الله بن أبي الحسين عن كعب بن عجرة"
"17424","[19/156]      الْمِسْوَرُ بْنُ رِفَاعَةَ الْقُرَظِيُّ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  344  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَحْمَدُ بْنُ عَبُّودٍ الدِّمَشْقِيُّ ،  ثَنَا  مَرْوَانُ بْنُ مُحَمَّدٍ الطَّاطَرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي عَمْرٍو ،  عَنِ  الْمِسْوَرِ بْنِ رِفَاعَةَ الْقُرَظِيِّ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ :  شَهِدْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَجْلِسَيْنِ ؛ أَمَّا أَحَدُهُمَا فَأُتِيَ بِجِنَازَةٍ فَقِيلَ : هَذَا فُلَانٌ ، وَبِئْسَ الرَّجُلُ ! وَأُثْنِيَ عَلَيْهِ شَرًّا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَعْلَمُونَ ذَلِكَ ؟ فَقَالُوا : نَعَمْ . قَالَ : وَجَبَتْ . وَأَمَّا الْآخَرُ فَأُتِيَ بِجِنَازَةِ رَجُلٍ فَقَالُوا : هَذَا فُلَانٌ ، وَأَثْنَوْا عَلَيْهِ خَيْرًا  ، فَقَالَ : تَعْلَمُونَ ذَلِكَ ؟ فَقَالُوا : نَعَمْ . قَالَ : وَجَبَتْ  .","","Al-Mu'jam al-Kabir 344","","كعب بن عجرة عن المسور بن رفاعة بن أبي مالك القرظي عن عبد الرحمن بن أبي عمرو عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن مروان بن محمد الطاطري عن أحمد بن عبد الواحد بن واقد التميمي عن عبد الله بن أحمد الجواليقي عن الطبراني","المسور بن رفاعة القرظي عن كعب بن عجرة"
"17425","حُدَيْرٌ مَوْلَى زَيْنَبَ بِنْتِ جَحْشٍ  عَنْ  كَعْبٍ  345  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  ثَنَا  لَيْثٌ ،  عَنِ  الْحُدَيْرِ - مَوْلًى لِزَيْنَبَ بِنْتِ جَحْشٍ -  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ :  دَخَلَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَحْنُ تِسْعَةٌ فِينَا سِتَّةٌ مِنَ الْعَجَمِ ، فَقَالَ :  إِنَّهَا سَتَكُونُ أُمَرَاءُ ، فَمَنْ صَدَّقَهُمْ بِكَذِبِهِمْ وَأَعَانَهُمْ عَلَى ظُلْمِهِمْ وَأَمْضَى لَهُمْ مَكْرَهُمْ فَلَيْسَ مِنِّي  وَلَا أَنَا مِنْهُ ، وَلَا يَرِدُ عَلَيَّ الْحَوْضَ  .","","Al-Mu'jam al-Kabir 345","","كعب بن عجرة عن الحدير مولى لزينب بنت جحش عن ليث بن أبي سليم عن معتمر بن سليمان عن الفلاس عن عبد الله بن أحمد الجواليقي عن الطبراني","حدير مولى زينب بنت جحش عن كعب"
"17426","أَبُو يَحْيَى مَوْلَى جَعْدَةَ بْنِ هُبَيْرَةَ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  346  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا         [19/157]      يَحْيَى بْنُ عِيسَى الرَّمْلِيُّ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  شِمْرِ بْنِ عَطِيَّةَ ،  عَنْ  أَبِي يَحْيَى ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقُومُ السَّاعَةُ حَتَّى يُدِيرَ الرَّجُلُ أَمَرَ خَمْسِينَ امْرَأَةٍ  .","","Al-Mu'jam al-Kabir 346","","كعب بن عجرة عن مصدع المعرقب عن شمر بن عطية الكاهلي عن الأعمش عن يحيى بن عيسى النهشلي عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو يحيى مولى جعدة بن هبيرة عن كعب بن عجرة"
"17427","يَحْيَى بْنُ جَعْدَةَ بْنِ هُبَيْرَةَ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  347  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَطِيعِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَمَرَ  كَعْبَ بْنَ عُجْرَةَ  أَنْ يَحْلِقَ رَأْسَهُ مِنَ الْقَمْلِ ، ثُمَّ قَالَ : صُمْ ثَلَاثَةَ أَيَّامٍ ، أَوْ أَطْعِمْ سِتَّةَ مَسَاكِينَ مُدَّيْنِ مُدَّيْنِ ، أَوِ اذْبَحْ  .","","Al-Mu'jam al-Kabir 347","","كعب بن عجرة عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن ابن جريج عن محمد بن بكر بن عثمان البرساني عن محمد بن يحيى بن أبي حزم القطعي عن عبد الله بن أحمد الجواليقي عن الطبراني","يحيى بن جعدة بن هبيرة عن كعب بن عجرة"
"17428","348  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  يَحْيَى بْنِ جَعْدَةَ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَمَرَهُ أَنْ يَحْلِقَ رَأْسَهُ مِنَ الْقَمْلِ ، فَقَالَ : صُمْ ثَلَاثَةَ أَيَّامٍ ، أَوْ أَطْعِمْ سِتَّةَ مَسَاكِينَ ، أَوِ اذْبَحْ  .","","Al-Mu'jam al-Kabir 348","","كعب بن عجرة عن يحيى بن جعدة بن هبيرة المخزومي عن عمرو بن دينار الأثرم عن ابن جريج عن إسماعيل بن عياش الأحول عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","يحيى بن جعدة بن هبيرة عن كعب بن عجرة"
"17429","عَطَاءُ بْنُ أَبِي رَبَاحٍ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  349  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  إِسْمَاعِيلُ بْنُ زَكَرِيَّا الْكُوفِيُّ ،  ثَنَا  عَبْدُ الرَّحِيمِ بْنُ سُلَيْمَانَ ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ الْعَرْزَمِيِّ ،  عَنْ  عَطَاءٍ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ :  آذَانِي  هَوَامُّ  رَأْسِي ، فَأَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَسَأَلْتُهُ عَنْ ذَلِكَ ، فَأَنْزَلَ اللهُ عَزَّ وَجَلَّ :         {      فَمَنْ كَانَ مِنْكُمْ مَرِيضًا أَوْ بِهِ أَذًى مِنْ رَأْسِهِ فَفِدْيَةٌ مِنْ صِيَامٍ أَوْ صَدَقَةٍ أَوْ نُسُكٍ         }      ، فَدَعَانِي رَسُولُ اللهِ - صَلَّى اللهُ         [19/158]      عَلَيْهِ وَسَلَّمَ - فَقَالَ :  هَلْ عِنْدَكَ فَرَقٌ تَقْسِمُهُ بَيْنَ سِتَّةِ مَسَاكِينَ - وَالْفَرَقُ ثَلَاثَةُ آصُعٍ - أَوْ  نُسُكُ  شَاةٍ أَوْ تَصُومُ ثَلَاثَةَ أَيَّامٍ  ؟ فَقُلْتُ : يَا رَسُولَ اللهِ ، خِرْ لِي ! قَالَ : أَطْعِمْ سِتَّةَ مَسَاكِينَ  .","","Al-Mu'jam al-Kabir 349","","كعب بن عجرة عن عطاء بن أبي رباح عن محمد بن عبيد الله بن أبي سليمان العرزمي عن عبد الرحيم بن سليمان الأشل عن إسماعيل بن زكريا الكوفي عن عبد الله بن أحمد الجواليقي عن الطبراني","عطاء بن أبي رباح عن كعب بن عجرة"
"17430","مُحَمَّدُ بْنُ كَعْبٍ الْقُرَظِيُّ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  350  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَسَنِ التَّغْلِبِيُّ ،  ثَنَا  شُعَيْبٌ الْأَنْمَاطِيُّ ،  عَنْ  لَيْثٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ  نَفَّسَ  عَنْ مُؤْمِنٍ كُرْبَةً  نَفَّسَ  اللهُ عَنْهُ كُرْبَةً يَوْمَ الْقِيَامَةِ  ، وَمَنْ سَتَرَ عَلَى مُؤْمِنٍ  عَوْرَتَهُ  سَتَرَ اللهُ عَلَيْهِ  عَوْرَتَهُ  ، وَمَنْ فَرَّجَ عَنْ مُؤْمِنٍ كُرْبَةً فَرَّجَ اللهُ عَنْهُ كُرْبَةً  .","","Al-Mu'jam al-Kabir 350","","كعب بن عجرة عن محمد بن كعب بن سليم القرظي عن ليث بن أبي سليم عن شعيب بن راشد الأنماطي عن إبراهيم بن الحسن الثعلبي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن كعب القرظي عن كعب بن عجرة"
"17431","351  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  بَكْرُ بْنُ خَلَفٍ (  ح  ) .  وَحَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ - قَالَا :  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  أُسَامَةُ بْنُ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ قَالَ :  سَمِعْتُ  كَعْبَ بْنَ عُجْرَةَ قَالَ :  أَمَرَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ أَحْلِقَ رَأْسِي وَأَفْدِيَ بِشَاةٍ  .","","Al-Mu'jam al-Kabir 351","","كعب بن عجرة عن محمد بن كعب بن سليم القرظي عن أسامة بن زيد الليثي المدني عن روح بن عبادة القيسي عن زيد بن الحريش الأهوزاي عن عبد الله بن أحمد الجواليقي عن الطبراني","محمد بن كعب القرظي عن كعب بن عجرة"
"17432","352  -  حَدَّثَنَا  النُّعْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ حَمْزَةَ الزُّبَيْرِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ نَافِعٍ ،  عَنْ  أُسَامَةَ بْنِ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ :  أَمَرَنِي النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ آذَانِي الْقَمْلُ أَنْ         [19/159]      أَحْلِقَ رَأْسِي ثُمَّ أَصُومَ ثَلَاثَةَ أَيَّامٍ  أَوْ أُطْعِمَ سِتَّةَ مَسَاكِينَ ، وَقَدْ عَلِمَ أَنَّهُ لَيْسَ عِنْدِي مَا أَنْسُكُ بِهِ  .","","Al-Mu'jam al-Kabir 352","","كعب بن عجرة عن محمد بن كعب بن سليم القرظي عن أسامة بن زيد الليثي المدني عن عبد الله بن نافع الصائغ عن عبد الله بن حمزة الزبيري عن النعمان بن أحمد بن نعيم الواسطي عن الطبراني","محمد بن كعب القرظي عن كعب بن عجرة"
"17433","عُمَرُ بْنُ الْحَكَمِ بْنِ ثَوْبَانَ  عَنْ  كَعْبٍ  353  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِي مَعْشَرٍ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ عَبْدِ اللهِ ، قَالَ : دَخَلَ أَبُو بَكْرِ بْنُ عَمْرِو بْنِ حَزْمٍ عَلَى عُمَرَ بْنِ الْحَكَمِ بْنِ ثَوْبَانَ  فَقَالَ لَهُ  : يَا  أَبَا حَفْصٍ ،  حَدِّثْنَا عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَدِيثًا لَيْسَ فِيهِ اخْتِلَافٌ !  فَحَدَّثَ عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ عَادَ مَرِيضًا خَاضَ فِي الرَّحْمَةِ ، فَإِذَا جَلَسَ عِنْدَهُ اسْتَشْفَعَ فِيهَا ،  قَالَ : يَقُولُ لِأَصْحَابِهِ : اسْتَشْفَعْنَا إِنْ شَاءَ اللهُ  .","","Al-Mu'jam al-Kabir 353","","كعب بن عجرة عن عمر بن الحكم بن ثوبان الحجازي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن نجيح بن عبد الرحمن السندي عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","عمر بن الحكم بن ثوبان عن كعب"
"17434","أَبُو أَبِي مُوسَى الْهِلَالِيُّ مِنْ أَهْلِ الْبَصْرَةِ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  354  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  سُلَيْمَانُ بْنُ الْمُغِيرَةِ ،  حَدَّثَنِي  أَبُو مُوسَى الْهِلَالِيُّ ،  عَنْ  أَبِيهِ  ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ :  دَخَلَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  مَنْ هَاهُنَا ؟ هَلْ تَسْمَعُونَ ؟ إِنَّ مِنْ بَعْدِي أُمَرَاءَ يَعْمَلُونَ بِغَيْرِ طَاعَةِ اللهِ  ، فَمَنْ شَارَكَهُمْ فِي عَمَلِهِمْ وَأَعَانَهُمْ عَلَى ظُلْمِهِمْ فَلَيْسَ مِنِّي وَلَسْتُ مِنْهُ ، وَمَنْ لَمْ يُشَارِكْهُمْ فِي عَمَلِهِمْ وَلَمْ يُعِنْهُمْ عَلَى ظُلْمِهِمْ فَهُوَ مِنِّي وَأَنَا مِنْهُ  .","","Al-Mu'jam al-Kabir 354","","كعب بن عجرة عن أبو أبو موسى الهلالي عن أبو موسى الهلالي عن سليمان بن المغيرة القيسي عن شيبان بن فروخ الحبطي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو أبي موسى الهلالي من أهل البصرة عن كعب بن عجرة"
"17435","[19/160]      الْحَسَنُ بْنُ أَبِي الْحَسَنِ الْبَصْرِيُّ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  355  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ الْجُمَحِيُّ ،  حَدَّثَنِي  سَعْدُ بْنُ إِبْرَاهِيمَ بْنِ كَعْبِ بْنِ عُجْرَةَ  ،  عَنْ  أَبَانَ بْنِ صَالِحٍ  أَنَّهُ سَمِعَ  الْحَسَنَ بْنَ أَبِي الْحَسَنِ يَقُولُ :  سَأَلْتُ  كَعْبَ بْنَ عُجْرَةَ - قُلْتُ : فِيكَ أُنْزِلَتْ آيَةُ الرُّخْصَةِ ، فَكَيْفَ صَنَعْتَ ؟ قَالَ : ذَبَحْتُ شَاةً  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب سعد بن إسحاق بن كعب بن عجرة .","","Al-Mu'jam al-Kabir 355","","كعب بن عجرة عن الحسن البصري عن أبان بن صالح بن عمير عن سعد بن إسحاق بن كعب بن عجرة عن سعيد بن عبد الرحمن الجمحي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","الحسن بن أبي الحسن البصري عن كعب بن عجرة"
"17436","356  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَطِيعِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَكْرٍ الْبُرْسَانِيُّ ،  ثَنَا  هِشَامُ بْنُ حَسَّانَ ،  عَنِ  الْحَسَنِ  أَنَّ  كَعْبَ بْنَ عُجْرَةَ قَالَ :  خَرَجَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِنَّهَا سَتَكُونُ عَلَيْكُمْ أُمَرَاءُ مِنْ بَعْدِي يُعْطُونَ بِالْحِكْمَةِ عَلَى مَنَابِرَ  ، فَإِذَا نَزَلُوا اخْتُلِسَتْ مِنْهُمْ ، وَقُلُوبُهُمْ أَنْتَنُ مِنَ الْجِيَفِ ، فَمَنْ صَدَّقَهُمْ بِكَذِبِهِمْ وَأَعَانَهُمْ عَلَى ظُلْمِهِمْ فَلَيْسَ مِنِّي وَلَسْتُ مِنْهُ ، وَلَا يَرِدُ عَلَيَّ الْحَوْضَ ، وَمَنْ لَمْ يُصَدِّقْهُمْ بِكَذِبِهِمْ وَلَمْ يُعِنْهُمْ عَلَى ظُلْمِهِمْ فَهُوَ مِنِّي وَأَنَا مِنْهُ ، وَسَيَرِدُ عَلَيَّ الْحَوْضَ  .","","Al-Mu'jam al-Kabir 356","","كعب بن عجرة عن الحسن البصري عن هشام بن حسان العتكي عن محمد بن بكر بن عثمان البرساني عن محمد بن يحيى بن أبي حزم القطعي عن عبد الله بن أحمد الجواليقي عن الطبراني","الحسن بن أبي الحسن البصري عن كعب بن عجرة"
"17437","357  -  حَدَّثَنَا  أَحْمَدُ بْنُ سُلَيْمَانَ بْنِ يُوسُفَ الْأَصْبَهَانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  النُّعْمَانُ بْنُ عَبْدِ السَّلَامِ ،  ثَنَا  أَبُو سَلَمَةَ السَّرَّاجُ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنِ  الْحَسَنِ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الصَّوْمُ  جُنَّةٌ ،  وَالصَّدَقَةُ تُطْفِئُ الْخَطِيئَةَ كَمَا يُطْفِئُ الْمَاءُ النَّارَ  .","","Al-Mu'jam al-Kabir 357","","كعب بن عجرة عن الحسن البصري عن مطر بن طهمان الوراق عن المغيرة بن مسلم القسملي عن النعمان بن عبد السلام عن سليمان بن يوسف بن صالح العقيلي عن أحمد بن سليمان بن يوسف الفابزاني عن الطبراني","الحسن بن أبي الحسن البصري عن كعب بن عجرة"
"17438","358  -  حَدَّثَنَا  أَحْمَدُ بْنُ سُلَيْمَانَ بْنِ يُوسُفَ الْعُقَيْلِيُّ الْأَصْبَهَانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  النُّعْمَانُ بْنُ عَبْدِ السَّلَامِ ،  ثَنَا  أَبُو سَلَمَةَ السَّرَّاجُ ،  عَنْ  مَطَرٍ الْوَرَّاقِ ،  عَنِ  الْحَسَنِ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  كَعْبُ بْنَ عُجْرَةَ ،  أَعَاذَكَ اللهُ مِنْ أُمَرَاءَ يَكُونُونَ بَعْدِي ، مَنْ دَخَلَ عَلَيْهِمْ         [19/161]      فَصَدَّقَهُمْ بِكَذِبِهِمْ وَأَعَانَهُمْ عَلَى ظُلْمِهِمْ فَلَيْسَ مِنِّي  وَلَسْتُ مِنْهُ ، وَلَنْ يَرِدَ عَلَيَّ الْحَوْضَ  .","","Al-Mu'jam al-Kabir 358","","كعب بن عجرة عن الحسن البصري عن مطر بن طهمان الوراق عن المغيرة بن مسلم القسملي عن النعمان بن عبد السلام عن سليمان بن يوسف بن صالح العقيلي عن أحمد بن سليمان بن يوسف الفابزاني عن الطبراني","الحسن بن أبي الحسن البصري عن كعب بن عجرة"
"17439","مُحَمَّدُ بْنُ سِيرِينَ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  359  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  أَبُو شِهَابٍ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ :  كُنْتُ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ فِتْنَةً فَقَرَّبَهَا ،  فَمَرَّ رَجُلٌ  مُقَنَّعٌ  ، فَقَالَ : هَذَا يَوْمَئِذٍ عَلَى الْحَقِّ ! فَقُمْتُ إِلَيْهِ فَأَخَذْتُ  بِضَبْعَيْهِ  فَأَقْبَلْتُ بِوَجْهِهِ عَلَى رَسُولِ اللهِ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : يَا رَسُولَ اللهِ ، هَذَا ؟ قَالَ : نَعَمْ ، فَإِذَا هُوَ  عُثْمَانُ بْنُ عَفَّانَ  .","","Al-Mu'jam al-Kabir 359","","كعب بن عجرة عن محمد بن سيرين عن هشام بن حسان العتكي عن عبد ربه بن نافع الحناط عن أحمد بن عبد الله اليربوعي عن محمد بن أحمد بن النضر النضري عن الطبراني","محمد بن سيرين عن كعب بن عجرة"
"17440","360  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  ابْنُ عُلَيَّةَ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ : ذَكَرَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ فِتْنَةً فَقَرَّبَهَا - فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 360","","كعب بن عجرة عن محمد بن سيرين عن هشام بن حسان العتكي عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","محمد بن سيرين عن كعب بن عجرة"
"17441","[19/162]      أَبُو بَكْرِ بْنُ بَشِيرٍ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  361  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ قَالَ :  سَمِعْتُ  عَبْدَ الْمَلِكِ بْنَ أَبِي جَمِيلَةَ  يُحَدِّثُ عَنْ  أَبِي بَكْرِ بْنِ بَشِيرٍ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا كَانَ عَلَيْكَ أُمَرَاءُ ، مَنْ دَخَلَ عَلَيْهِمْ فَصَدَّقَهُمْ بِكَذِبِهِمْ وَأَعَانَهُمْ عَلَى ظُلْمِهِمْ فَلَيْسَ مِنِّي وَلَا أَنَا مِنْهُ  ، وَلَا يَرِدُ عَلَيَّ الْحَوْضَ ، وَمَنْ دَخَلَ عَلَيْهِمْ فَلَمْ يُصَدِّقْهُمْ بِكَذِبِهِمْ وَلَمْ يُعِنْهُمْ عَلَى ظُلْمِهِمْ فَهُوَ مِنِّي وَأَنَا مِنْهُ ، يَا  كَعْبُ بْنَ عُجْرَةَ  إِنَّهُ لَا يَدْخُلُ الْجَنَّةَ لَحْمٌ وَلَا دَمٌ نَبَتَا مِنْ  سُحْتٍ  ، كُلُّ لَحْمٍ وَدَمٍ نَبَتَا مِنْ  سُحْتٍ  فَالنَّارُ أَوْلَى بِهِمَا ، يَا  كَعْبُ بْنَ عُجْرَةَ  غَادِيَانِ رَائِحَانِ ؛ فَغَادٍ فِي فِكَاكِ رَقَبَتِهِ فَمُعْتِقُهَا وَغَادٍ  فَمُوبِقُهَا  ، يَا  كَعْبُ بْنَ عُجْرَةَ ،  الصَّلَاةُ  بُرْهَانٌ  ، وَالصَّوْمُ  جُنَّةٌ  .","","Al-Mu'jam al-Kabir 361","","كعب بن عجرة عن أبو بكر بن بشير عن عبد الملك بن أبي جميلة عن معتمر بن سليمان عن أمية بن بسطام عن إبراهيم بن هاشم البغوي عن الطبراني","أبو بكر بن بشير عن كعب بن عجرة"
"17442","أَبُو الْأَشْعَثِ الصَّنْعَانِيُّ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  362  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ أَبِي بَكْرٍ  ،  حَدَّثَنِي  يَحْيَى بْنُ السَّكَنِ ،  ثَنَا  أَبُو قَحْذَمٍ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  أَبِي الْأَشْعَثِ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ قَالَ :  كُنْتُ جَالِسًا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يُحَدِّثُنَا عَنِ الْفِتَنِ ،  فَمَرَّ رَجُلٌ  مُقَنَّعٌ  ، فَقَالَ : هَذَا يَوْمَئِذٍ وَأَصْحَابُهُ عَلَى الْهُدَى  ! فَقُمْتُ فَلَحِقْتُهُ فَكَشَفْتُ الْقِنَاعَ عَنْ رَأْسِهِ فَإِذَا  عُثْمَانُ بْنُ عَفَّانَ  ، قُلْتُ : يَا رَسُولَ اللهِ ، هَذَا ؟ قَالَ : نَعَمْ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بكير ) والله أعلم.","","Al-Mu'jam al-Kabir 362","","كعب بن عجرة عن شراحيل بن آدة الأبناوي عن أبو قلابة الجرمي عن النضر بن معبد الجرمي عن يحيى بن السكن البصري عن عبد الله بن محمد بن يحيى الكرماني عن أحمد بن يحيى بن زهير التستري عن الطبراني","أبو الأشعث الصنعاني عن كعب بن عجرة"
"17443","أُمُّ حُمَيْدٍ بِنْتُ عُبَيْدِ بْنِ رِفَاعَةَ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  363  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،         [19/163]      ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي حُمَيْدٍ ،  حَدَّثَتْنِي  حُمَيْدَةُ بِنْتُ عُبَيْدٍ ،  عَنْ  أُمِّهَا  ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَقِيَ الْمِنْبَرَ فَقَالَ :  رَقِيتُ وَقَدْ عَلِمْتُ لَيْلَةَ الْقَدْرِ فَأُنْسِيتُهَا ، فَالْتَمِسُوهَا فِي الْعَشْرِ الْأَوَاخِرِ فِي  وِتْرٍ  .","","Al-Mu'jam al-Kabir 363","","كعب بن عجرة عن أم حميدة بنت عبيد بن رفاعة الزرقية عن حميدة بنت عبيد بن رفاعة الزرقية عن محمد بن أبي حميد الزرقي عن أبو داود الطيالسي عن محمد بن أبي بكر المقدمي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","أم حميد بنت عبيد بن رفاعة عن كعب بن عجرة"
"17444","رَجُلٌ مِنَ  الْأَنْصَارِ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  364  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  أَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  مُوسَى بْنِ عُقْبَةَ ،  عَنْ  نَافِعٍ ،  عَنْ  رَجُلٍ مِنَ الْأَنْصَارِ  عَنْ  كَعْبِ بْنِ عُجْرَةَ  أَنَّهُ أَصَابَهُ أَذًى فِي رَأْسِهِ فَأَمَرَهُ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يَحْلِقَ وَيَفْدِيَ بِبَقَرَةٍ  .","","Al-Mu'jam al-Kabir 364","","كعب بن عجرة عن رجل من الأنصار عن نافع مولى ابن عمر عن موسى بن عقبة عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","رجل من الأنصار عن كعب بن عجرة"
"17445","365  -  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ النَّوْفَلِيُّ الْمَدَنِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  عَنْ  عَبْدِ اللهِ بْنِ نَافِعٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  رَجُلٍ مِنَ الْأَنْصَارِ ،  عَنْ  كَعْبِ بْنِ عُجْرَةَ  أَنَّهُ أَصَابَهُ أَذًى فِي رَأْسِهِ فَحَلَقَهُ ، فَقَالَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : بِمَاذَا أَنْسُكُ ؟ فَأَمَرَهُ أَنْ يُهْدِيَ هَدْيًا  يُقَلِّدُهَا ثُمَّ يَسُوقُهَا حَتَّى يُوقِفَهَا  بِعَرَفَةَ  مَعَ النَّاسِ ثُمَّ يَدْفَعُ بِهَا مَعَ النَّاسِ ، وَكَذَلِكَ يَفْعَلُ بِالْهَدْيِ  .","","Al-Mu'jam al-Kabir 365","","كعب بن عجرة عن رجل من الأنصار عن نافع مولى ابن عمر عن عبد الله بن نافع مولى عبد الله بن عمر عن محمد بن إسماعيل بن مسلم الديلي عن إبراهيم بن المنذر الحزامي عن جعفر بن سليمان النوفلي عن الطبراني","رجل من الأنصار عن كعب بن عجرة"
"17446","كَعْبُ بْنُ عَمْرٍو أَبُو الْيَسَرِ الْأَنْصَارِيُّ ثُمَّ الْخَزْرَجِيُّ ،  عَقَبِيٌ بَدْرِيٌّ  366  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ :  فِي تَسْمِيَةِ مَنْ شَهِدَ الْعَقَبَةَ مِنَ  الْأَنْصَارِ  أَبُو الْيَسَرِ كَعْبُ بْنُ عَمْرِو بْنِ عَبَّادٍ ، وَقَدْ شَهِدَ  بَدْرًا  .","","Al-Mu'jam al-Kabir 366","","كعب بن عمرو بن عباد البدري عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","كعب بن عمرو أبو اليسر الأنصاري"
"17447","[19/164]      367  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ، ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ السَّدُوسِيُّ  ، ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ  ، عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  :  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي الْخَزْرَجِ  أَبُو الْيَسَرِ كَعْبُ بْنُ عَمْرِو بْنِ عَبَّادِ بْنِ عَمْرِو بْنِ غَنْمِ بْنِ سَوَّادِ بْنِ غَنْمِ بْنِ كَعْبِ بْنِ سَلَمَةَ بْنِ عَلِيٍّ  .","","Al-Mu'jam al-Kabir 367","","","كعب بن عمرو أبو اليسر الأنصاري"
"17448","368  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  قَالَ :  تُوُفِّيَ  أَبُو الْيَسَرِ كَعْبُ بْنُ عَمْرٍو  سَنَةَ خَمْسٍ وَخَمْسِينَ  بِالْمَدِينَةِ ،  وَيُقَالُ : إِنَّهُ آخِرُ مَنْ مَاتَ مِنْ  أَهْلِ بَدْرٍ  .","","Al-Mu'jam al-Kabir 368","","","كعب بن عمرو أبو اليسر الأنصاري"
"17449","369  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ  قَالَ :  مَاتَ  أَبُو الْيَسَرِ كَعْبُ بْنُ عَمْرٍو  سَنَةَ خَمْسٍ وَخَمْسِينَ  بِالْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 369","","","كعب بن عمرو أبو اليسر الأنصاري"
"17450","مِمَّا  أَسْنَدَ  كَعْبُ بْنُ عَمْرٍو أَبُو الْيَسَرِ  عَمَّارُ بْنُ أَبِي الْيَسَرِ  عَنْ أَبِيهِ  370  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عِمْرَانَ ،  حَدَّثَنِي  مُحَمَّدٌ  ،  عَنْ  مُوسَى  ،  عَنْ  عُمَارَةَ بْنِ عَمَّارِ بْنِ أَبِي الْيَسَرِ ،  عَنْ  أَبِيهِ ،  عَنْ  أَبِي الْيَسَرِ  قَالَ :  نَظَرْتُ  يَوْمَ بَدْرٍ  إِلَى  الْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ  وَهُوَ قَائِمٌ كَأَنَّهُ صَنَمٌ وَعَيْنَاهُ تَذْرِفَانِ  ، فَلَمَّا نَظَرْتُ إِلَيْهِ قُلْتُ : جَزَاكَ اللهُ مِنْ ذِي رَحِمٍ شَرًّا ، أَتُقَاتِلُ ابْنَ أَخِيكَ مَعَ عَدُوِّهِ ؟ قَالَ : مَا فَعَلَ ؟ وَهَلْ أَصَابَهُ الْقَتْلُ ؟ قُلْتُ : اللهُ أَعَزُّ لَهُ وَأَنْصَرُ مِنْ ذَلِكَ . قَالَ : مَا تُرِيدُ إِلَيَّ ؟ قُلْتُ : إِسَارٌ ، لَكِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَى عَنْ قَتْلِكَ . قَالَ : لَيْسَتْ بِأَوَّلِ صِلَتِهِ  ، فَأَسَرْتُهُ ثُمَّ جِئْتُ بِهِ إِلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( محمد بن موسى )  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( محمد بن موسى )  في طبعة مكتبة ابن تيمية : ( لست أول صلبه ) والمثبت من نسخة أحمد الثالث ، والمعجم الأوسط.","","Al-Mu'jam al-Kabir 370","","كعب بن عمرو بن عباد البدري عن عمار بن أبي اليسر الأنصاري عن عمارة بن عمار بن أبي اليسر عن محمد بن موسى الفطري عن عبد العزيز بن عمران بن عبد العزيز الأعرج عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","عمار بن أبي اليسر عن أبيه"
"17451","[19/165]      مُوسَى بْنُ طَلْحَةَ  عَنْ  أَبِي الْيَسَرِ  371  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ (  ح  ) .  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ (  ح  ) .  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ - قَالُوا :  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  عُثْمَانَ بْنِ عَبْدِ اللهِ بْنِ مَوْهَبٍ ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،  عَنْ  أَبِي الْيَسَرِ قَالَ :  أَتَتْنِي  امْرَأَةٌ  تَبْتَاعُ مِنِّي تَمْرًا ، فَقُلْتُ : إِنَّ فِي الْبَيْتِ تَمْرًا أَطْيَبُ مِنْهُ ، فَدَخَلَتْ مَعِي الْبَيْتَ فَأَهْوَيْتُ إِلَيْهَا فَغَمَزْتُهَا وَقَبَّلْتُهَا فَأُسْقِطَ فِي يَدَيَّ ، فَأَتَيْتُ  أَبَا بَكْرٍ  فَذَكَرْتُ ذَلِكَ لَهُ ، فَقَالَ : اسْتُرْ عَلَى نَفْسِكَ وَلَا تُخْبِرْ أَحَدًا ، فَلَمْ أَصْبِرْ ، فَأَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرْتُ ذَلِكَ لَهُ ، فَقَالَ :  أَخَلَفْتَ  غَازِيًا فِي أَهْلِهِ بِمِثْلِ هَذَا ؟  حَتَّى تَمَنَّيْتُ أَنِّي لَمْ أَكُنْ أَسْلَمْتُ إِلَّا تِلْكَ السَّاعَةَ ، حَتَّى ظَنَنْتُ أَنِّي مِنْ أَهْلِ النَّارِ ،  فَأَطْرَقَ  رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - طَوِيلًا ثُمَّ أَوْحَى اللهُ إِلَيْهِ :         {      وَأَقِمِ  الصَّلاةَ طَرَفَيِ النَّهَارِ         }      إِلَى آخِرِ الْآيَةِ ، قَالَ  أَبُو الْيَسَرِ  : فَأَتَيْتُهُ فَقَرَأَهَا عَلَيَّ ، فَقَالَ أَصْحَابُهُ : يَا رَسُولَ اللهِ ، أَلَهُ خَاصَّةً أَوْ لِلنَّاسِ عَامَّةً ؟ قَالَ : بَلْ لِلنَّاسِ عَامَّةً  .  في طبعة مكتبة ابن تيمية ( أقم ) بدون الواو .","","Al-Mu'jam al-Kabir 371","","كعب بن عمرو بن عباد البدري عن موسى بن طلحة بن عبيد الله التيمي عن عثمان بن عبد الله بن موهب الأعرج عن قيس بن الربيع الأسدي عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","موسى بن طلحة عن أبي اليسر"
"17452","رِبْعِيُّ بْنُ حِرَاشٍ  عَنْ  أَبِي الْيَسَرِ  372  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  زَائِدَةُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَرَ  ،  عَنْ  رِبْعِيِّ بْنِ حِرَاشٍ ،  عَنْ  أَبِي الْيَسَرِ قَالَ : سَمِعْتُ         [19/166]      رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَنْظَرَ مُعْسِرًا أَوْ  وَضَعَ  عَنْهُ أَظَلَّهُ اللهُ فِي ظِلِّهِ يَوْمَ لَا ظِلَّ إِلَّا ظِلُّهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عمير )","","Al-Mu'jam al-Kabir 372","","كعب بن عمرو بن عباد البدري عن ربعي بن حراش العبسي عن عبد الملك بن عمير القبطي عن زائدة بن قدامة عن أحمد بن عبد الله اليربوعي عن محمد بن أحمد بن النضر النضري عن الطبراني","ربعي بن حراش عن أبي اليسر"
"17453","عَوْنُ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ  عَنْ  أَبِي الْيَسَرِ  373  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  عَاصِمِ بْنِ سُلَيْمَانَ ،  عَنْ  عَوْنِ بْنِ عَبْدِ اللهِ قَالَ :  كَانَ لِأَبِي الْيَسَرِ عَلَى  رَجُلٍ  دَيْنٌ فَأَتَاهُ يَتَقَاضَاهُ فِي أَهْلِهِ ، فَقَالَ لِجَارِيَتِهِ : قُولِي : لَيْسَ هُوَ هَاهُنَا ! فَسَمِعَ صَوْتَهُ ، فَقَالَ : اخْرُجْ ، قَدْ سَمِعْتُ صَوْتَكَ ! فَخَرَجَ إِلَيْهِ ، فَقَالَ : مَا حَمَلَكَ عَلَى مَا صَنَعْتَ ؟ قَالَ : الْعُسْرَةُ ! قَالَ : آللهِ ؟ قَالَ : اللهِ . قَالَ : اذْهَبْ فَلَكَ مَا عَلَيْكَ ، إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَنْظَرَ مُعْسِرًا أَوْ  وَضَعَ  عَنْهُ كَانَ فِي  ظِلِّ اللهِ يَوْمَ الْقِيَامَةِ أَوْ  كَنَفِ  اللهِ  .","","Al-Mu'jam al-Kabir 373","","كعب بن عمرو بن عباد البدري عن عون بن عبد الله بن عتبة عن عاصم بن سليمان الأحول عن سلام بن سليم الحنفي عن أحمد بن عبد الله اليربوعي عن محمد بن أحمد بن النضر النضري عن الطبراني","عون بن عبد الله بن عتبة عن أبي اليسر"
"17454","مُحَمَّدُ بْنُ عَلِيِّ بْنِ الْحُسَيْنِ  عَنْ  أَبِي الْيَسَرِ  374  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْيَسَرِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَنْظَرَ مُعْسِرًا أَوْ  وَضَعَ  عَنْهُ أَظَلَّهُ اللهُ فِي ظِلِّ عَرْشِهِ  .","","Al-Mu'jam al-Kabir 374","","كعب بن عمرو بن عباد البدري عن أبو جعفر الباقر عن جعفر الصادق عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","محمد بن علي بن الحسين عن أبي اليسر"
"17455","375  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ  ، ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي الْيَسَرِ قَالَ : قَالَ النَّبِيُّ         [19/167]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَرَّهُ أَنْ يَسْتَظِلَّ مِنْ  فَوْرِ  جَهَنَّمَ  فَلْيُنْظِرْ  غَرِيمًا أَوْ يَدَعْ لِمُعْسِرٍ  .","","Al-Mu'jam al-Kabir 375","","كعب بن عمرو بن عباد البدري عن جعفر الصادق عن محمد بن جعفر ابن علي بن الحسين العلوي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","محمد بن علي بن الحسين عن أبي اليسر"
"17456","حَنْظَلَةُ بْنُ قَيْسٍ  عَنْ  أَبِي الْيَسَرِ  376  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  بِشْرُ بْنُ الْفَضْلِ  ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مُعَاوِيَةَ ،  عَنْ  حَنْظَلَةَ بْنِ قَيْسٍ ،  عَنْ  أَبِي الْيَسَرِ الْبَدْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَحَبَّ أَنْ يُظِلَّهُ اللهُ فِي ظِلِّهِ  فَلْيُنْظِرْ  مُعْسِرًا أَوْ لِيَضَعْ عَنْهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( بشر بن المفضل )","","Al-Mu'jam al-Kabir 376","","كعب بن عمرو بن عباد البدري عن حنظلة بن قيس بن عمرو الزرقي عن عبد الرحمن بن معاوية النوفلي عن عبد الرحمن بن إسحاق العامري عن بشر بن المفضل عن العباس بن الوليد النرسي عن عبد الله بن أحمد بن حنبل عن الطبراني","حنظلة بن قيس عن أبي اليسر"
"17457","أَبُو يُونُسَ سُلَيْمُ بْنُ جُبَيْرٍ مَوْلَى أَبِي هُرَيْرَةَ  عَنْ  أَبِي الْيَسَرِ  377  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي  ، ثَنَا  كَامِلُ بْنُ طَلْحَةَ الْجَحْدَرِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  أَبُو يُونُسَ أَنَّ أَبَا الْيَسَرِ  حَدَّثَهُ  قَالَ :  أَشْهَدُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَسَمِعْتُهُ يَقُولُ :  إِنَّ أَوَّلَ النَّاسِ يَسْتَظِلُّ فِي ظِلِّ اللهِ يَوْمَ الْقِيَامَةِ لَرَجُلٌ  يُنْظِرُ  مُعْسِرًا  حَتَّى يَجِدَ شَيْئًا أَوْ  تَصَدَّقَ  عَلَيْهِ بِمَا يَطْلُبُهُ ، يَقُولُ مَا لِيَ عَلَيْكَ صَدَقَةٌ ابْتِغَاءَ وَجْهِ اللهِ - وَيَحْرِقُ صَحِيفَتَهُ  .","","Al-Mu'jam al-Kabir 377","","كعب بن عمرو بن عباد البدري عن سليم بن جبير مولى أبي هريرة عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","أبو يونس سليم بن جبير مولى أبي هريرة عن أبي اليسر"
"17458","سَالِمُ بْنُ أَبِي الْجَعْدِ  عَنْ  أَبِي الْيَسَرِ  378  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا         [19/168]      أَبُو أُسَامَةَ ،  حَدَّثَنِي  ثَابِتُ بْنُ دِينَارٍ ،  ثَنَا  سَالِمُ بْنُ أَبِي الْجَعْدِ قَالَ :  قَالَ  أَبُو الْيَسَرِ الْأَنْصَارِيُّ :  كُنْتُ جَالِسًا عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَتَاهُ  أَبُو عَامِرٍ الْأَشْعَرِيُّ  فَقَالَ : بَعَثَنِي فِي كَذَا وَكَذَا ، ثُمَّ أَتَيْتُ  مُؤْتَةَ  ، فَلَمَّا صَفَّ  الْقَوْمُ  رَكِبَ  جَعْفَرٌ  فَرَسَهُ وَلَبِسَ الدِّرْعَ وَأَخَذَ اللِّوَاءَ وَمَشَى حَتَّى أَتَى  الْقَوْمَ  ، ثُمَّ نَادَى : مَنْ يُبَلِّغُ هَذِهِ صَاحِبَهَا ؟ فَقَالَ  رَجُلٌ  مِنَ  الْقَوْمِ  : أَنَا ، فَبَعَثَ بِهَا ثُمَّ تَقَدَّمَ فَضَرَبَ بِسَيْفِهِ حَتَّى قُتِلَ ، فَتَحَدَّرَتْ عَيْنَا رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - دُمُوعًا ، فَصَلَّى بِنَا الظُّهْرَ ثُمَّ دَخَلَ وَلَمْ يُكَلِّمْنَا ، ثُمَّ أُقِيمَتِ الْعَصْرُ فَخَرَجَ فَصَلَّى ، ثُمَّ دَخَلَ وَلَمْ يُكَلِّمْنَا ، فَفَعَلَ كَذَلِكَ فِي الْمَغْرِبِ وَالْعِشَاءِ فَدَخَلَ وَلَا يُكَلِّمُنَا ، وَكَانَ إِذَا صَلَّى أَقْبَلَ عَلَيْنَا بِوَجْهِهِ ، فَخَرَجَ عَلَيْنَا فِي الْفَجْرِ فِي السَّاعَةِ الَّتِي كَانَ يَخْرُجُ فِيهَا ، وَأَنَا  وَأَبُو عَامِرٍ الْأَشْعَرِيُّ  جُلُوسٌ ، فَجَلَسَ بَيْنَنَا وَقَالَ :  أَلَا أُخْبِرُكُمْ عَنْ رُؤْيَا رَأَيْتُهَا ؟ دَخَلْتُ الْجَنَّةَ فَرَأَيْتُ  جَعْفَرًا  ذَا جَنَاحَيْنِ  مُضَرَّجَيْنِ  بِالدِّمَاءِ ،  وَزَيْدٌ  مُقَابِلَهُ ،  وَابْنُ رَوَاحَةَ  مَعَهُمْ كَأَنَّهُ يُعْرِضُ عَنْهُمْ  ، وَسَأُخْبِرُكُمْ عَنْ ذَلِكَ ، إِنَّ  جَعْفَرًا  حِينَ تَقَدَّمَ فَرَأَى الْقَتْلَ لَمْ يَصْرِفْ وَجْهَهُ ،  وَزَيْدٌ  كَذَلِكَ ،  وَابْنُ رَوَاحَةَ  صَرَفَ وَجْهَهُ  .","","Al-Mu'jam al-Kabir 378","","كعب بن عمرو بن عباد البدري عن سالم بن أبي الجعد الغطفاني عن ثابت بن أبي صفية الثمالي عن حماد بن أسامة القرشي عن أبو كريب محمد بن العلاء عن الحسين بن إسحاق التستري عن الطبراني","سالم بن أبي الجعد عن أبي اليسر"
"17459","عُبَادَةُ بْنُ الْوَلِيدِ بْنِ عُبَادَةَ بْنِ الصَّامِتِ  عَنْ  أَبِي الْيَسَرِ  379  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  عَلِيُّ بْنُ بَحْرٍ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُحَمَّدُ بْنُ عَبَّادٍ الْمَكِّيُّ - قَالُوا :  ثَنَا  حَاتِمُ بْنُ إِسْمَاعِيلَ ،  عَنْ  أَبِي حَزْرَةَ يَعْقُوبَ بْنِ مُجَاهِدٍ الْمَدَنِيِّ ،  عَنْ  عُبَادَةَ بْنِ الْوَلِيدِ بْنِ         [19/169]      عُبَادَةَ بْنِ الصَّامِتِ  قَالَ  :  خَرَجْتُ أَنَا وَأَبِي نَطْلُبُ الْعِلْمَ فِي هَذَا الْحَيِّ مِنَ  الْأَنْصَارِ  قَبْلَ أَنْ يَهْلِكُوا ، وَكَانَ أَوَّلَ مَنْ لَقِيَنَا أَبُو الْيَسَرِ السُّلَمِيُّ صَاحِبُ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهُ غُلَامٌ لَهُ ، وَعَلَيْهِ بُرْدَةٌ وَعَلَى غُلَامِهِ بُرْدَةٌ وَمَعَافِرِيٌّ وَضِمَامَةُ مُصْحَفٍ ، فَقَالَ لَهُ أَبِي : كَأَنِّي أَرَى فِي وَجْهِكَ سَعْفَةٌ مِنْ غَضَبٍ ! قَالَ : نَعَمْ ، كَانَ لِي عَلَى فُلَانِ بْنِ فُلَانٍ الْحَرَامِيِّ مَالٌ ، فَأَتَيْتُ أَهْلَهُ فَقُلْتُ : أَثَمَّ هُوَ ؟ قَالُوا : لَا ، فَخَرَجَ عَلَيَّ ابْنٌ لَهُ  جَفْرٌ  ، فَقُلْتُ لَهُ : أَيْنَ أَبُوكَ ؟ قَالَ : سَمِعَ كَلَامَكَ فَدَخَلَ فِي أَرِيكَةِ أُمِّي ! فَقُلْتُ : اخْرُجْ إِلَيَّ ، فَقَدْ عَلِمْتُ أَيْنَ أَنْتَ ! فَخَرَجَ إِلَيَّ ، فَقُلْتُ : مَا حَمَلَكَ عَلَى أَنِ اخْتَبَأْتَ مِنِّي ؟ قَالَ : أَنَا وَاللهِ لَأُحَدِّثُكَ ثُمَّ لَا أَكْذِبُكَ ، خَشِيتُ وَاللهِ أَنْ أُحَدِّثَكَ فَأَكْذِبَكَ أَوْ أَعِدَكَ فَأُخْلِفَكَ ، وَكُنْتَ صَاحِبَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكُنْتُ وَاللهِ مُعْسِرًا ! قَالَ : آللهِ ! فَقُلْتُ : آللهِ . قَالَ : آللهِ ! فَقُلْتُ : آللهِ . قَالَ : آللهِ ! فَقُلْتُ : آللهِ . فَنَسَوْتُ الصَّحِيفَةَ فَمَحَوْتُ الْحَقَّ ، وَقُلْتُ : إِنْ وَجَدْتَ قَضَاءً فَاقْضِ وَإِلَّا فَأَنْتَ فِي حِلٍّ ، فَأَشْهَدُ بَصُرَتْ عَيْنَيَّ هَاتَانِ وَوَضَعَ إِصْبَعَيْهِ عَلَى عَيْنَيْهِ ، وَسَمِعَتْ أُذُنَايَ هَاتَانِ ، وَوَضَعَ إِصْبَعَيْهِ فِي أُذُنَيْهِ ،  وَوَعَاهُ  قَلْبِي هَذَا - وَأَشَارَ إِلَى مَنَاطِ قَلْبِهِ - رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَنْظَرَ مُعْسِرًا أَوْ  وَضَعَ  لَهُ أَظَلَّهُ اللهُ فِي ظِلِّهِ يَوْمَ لَا ظِلَّ إِلَّا ظِلُّهُ  . قُلْتُ لَهُ أَنَا : يَا عَمُّ ، لَوْ أَنَّكَ أَخَذْتَ بُرْدَةَ غُلَامِكَ وَأَعْطَيْتَهُ مَعَافِرِيَّكَ وَأَخَذْتَ مَعَافِرِيَّهُ فَأَعْطَيْتَهُ بُرْدَتَكَ ، فَكَانَ عَلَيْكَ  حُلَّةٌ  وَعَلَيْهِ  حُلَّةٌ  ! فَمَسَحَ رَأْسِي وَقَالَ : اللَّهُمَّ بَارِكْ فِيهِ ، يَا ابْنَ أَخِي أَبْصَرَتْ عَيْنَايَ هَاتَانِ وَسَمِعَتْ أُذُنَايَ هَاتَانِ  وَوَعَاهُ  قَلْبِي - وَأَشَارَ إِلَى عَيْنَيْهِ وَإِلَى أُذُنَيْهِ وَإِلَى مَنَاطِ قَلْبِهِ - رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ : أَطْعِمُوهُمْ مِمَّا تَأْكُلُونَ ، وَأَلْبِسُوهُمْ مِمَّا تَلْبَسُونَ ، وَكَانَ أَنْ أَعْطَيْتُهُ مِنْ مَالِ الدُّنْيَا أَحَبَّ إِلَيَّ مِنْ أَنْ يَأْخُذَ مِنْ حَسَنَاتِي يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 379","","كعب بن عمرو بن عباد البدري عن عبادة بن الوليد بن عبادة بن الصامت عن يعقوب بن مجاهد المخزومي عن حاتم بن إسماعيل الحارثي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عبادة بن الوليد بن عبادة بن الصامت عن أبي اليسر"
"17460","[19/170]      380  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْخَلَّالُ الْمَكِّيُّ  ، ثَنَا  يَعْقُوبُ بْنُ حُمَيْدٍ ،  ثَنَا  حَنْظَلَةُ بْنُ عَمْرٍو الدَّوْرَقِيُّ ،  عَنْ  أَبِي حَزْرَةَ يَعْقُوبَ بْنِ مُجَاهِدٍ ،  عَنْ  عُبَادَةَ بْنِ الْوَلِيدِ بْنِ عُبَادَةَ بْنِ الصَّامِتِ ،  عَنْ  أَبِي الْيَسَرِ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَنْظَرَ مُعْسِرًا أَوْ  وَضَعَ  عَنْهُ أَظَلَّهُ اللهُ يَوْمَ لَا ظِلَّ إِلَّا ظِلُّهُ  .","","Al-Mu'jam al-Kabir 380","","كعب بن عمرو بن عباد البدري عن عبادة بن الوليد بن عبادة بن الصامت عن يعقوب بن مجاهد المخزومي عن حنظلة بن عمرو بن حنظلة الزرقي عن يعقوب بن حميد بن كاسب المدني عن أحمد بن عمرو بن مسلم الخلال عن الطبراني","عبادة بن الوليد بن عبادة بن الصامت عن أبي اليسر"
"17461","صَيْفِيٌّ مَوْلَى أَبِي أَيُّوبَ  عَنْ  أَبِي الْيَسَرِ  381  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ النَّضْرِ الْأَزْدِيُّ  ، ثَنَا  عَلِيُّ بْنُ بَحْرٍ ،  ثَنَا  مَكِّيُّ بْنُ إِبْرَاهِيمَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ - قَالُوا :  ثَنَا  عَبْدُ اللهِ بْنُ سَعِيدِ بْنِ أَبِي هِنْدٍ ،  ثَنَا  صَيْفِيٌّ مَوْلَى أَبِي أَيُّوبَ ،  عَنْ  أَبِي الْيَسَرِ السُّلَمِيِّ قَالَ : كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ  الْهَدْمِ  ، وَأَعُوذُ بِكَ مِنَ التَّرَدِّي  ، وَأَعُوذُ بِكَ مِنَ  الْغَرَقِ  وَالْحَرَقِ  ، وَأَعُوذُ بِكَ أَنْ  يَتَخَبَّطَنِي  الشَّيْطَانُ عِنْدَ الْمَوْتِ ، وَأَعُوذُ بِكَ أَنْ أَمُوتَ  لَدِيغًا  .","","Al-Mu'jam al-Kabir 381","","كعب بن عمرو بن عباد البدري عن صيفي بن زياد المدني عن عبد الله بن سعيد بن أبي هند الفزاري عن غندر ربيب شعبة عن أبو موسى الزمن عن محمد بن العباس ابن الأخرم عن الطبراني","صيفي مولى أبي أيوب عن أبي اليسر"
"17462","رَجُلٌ غَيْرُ مُسَمًّى عَنْ  أَبِي الْيَسَرِ  382  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ         [19/171]      إِسْمَاعِيلَ النَّهْدِيُّ ،  ثَنَا  يَحْيَى بْنُ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ ،  عَنْ  رَجُلٍ ،  عَنْ  أَبِي الْيَسَرِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  تَقْتُلُ  عَمَّارًا  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 382","","كعب بن عمرو بن عباد البدري عن رجل عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","رجل غير مسمى عن أبي اليسر"
"17463","383  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  الْأَزْرَقُ بْنُ عَلِيٍّ ،  ثَنَا  حَسَّانُ بْنُ إِبْرَاهِيمَ ،  عَنْ  يَحْيَى بْنِ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي بَكْرِ بْنِ حَفْصٍ ،  عَنْ  رَجُلٍ ،  عَنْ  أَبِي الْيَسَرِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَتَقْتُلُ  عَمَّارًا  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 383","","كعب بن عمرو بن عباد البدري عن رجل عن عبد الله بن حفص بن عمر بن سعد بن أبي وقاص عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن حسان بن إبراهيم الكرماني عن الأزرق بن علي بن مسلم الحنفي عن إبراهيم بن هاشم البغوي عن الطبراني","رجل غير مسمى عن أبي اليسر"
"17464","384  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنْ  رَجُلٍ ،  عَنْ  أَبِي الْيَسَرِ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَرَّمَ مَا بَيْنَ  لَابَتَيِ  الْمَدِينَةِ  .","","Al-Mu'jam al-Kabir 384","","كعب بن عمرو بن عباد البدري عن رجل عن عمارة بن غزية عن عبد العزيز بن محمد الدراوردي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","رجل غير مسمى عن أبي اليسر"
"17465","كَعْبُ بْنُ عَاصِمٍ الْأَشْعَرِيُّ  385  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  أَبُو عَاصِمٍ - كِلَاهُمَا  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  ابْنُ شِهَابٍ أَنَّ صَفْوَانَ بْنَ عَبْدِ اللهِ  حَدَّثَهُ  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 385","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن ابن جريج عن أبو عاصم النبيل عن أبو مسلم الكجي عن الطبراني","كعب بن عاصم الأشعري"
"17466","[19/172]      386  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ - وَكَانَ مِنْ أَصْحَابِ السَّفِينَةِ - قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 386","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","كعب بن عاصم الأشعري"
"17467","387  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنِ امْبِرِّ امْصِيَامُ فِي امْسَفَرِ  .","","Al-Mu'jam al-Kabir 387","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","كعب بن عاصم الأشعري"
"17468","388  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ (  ح  )  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْقَعْنَبِيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ شَيْبَةَ الْحِزَامِيُّ (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ - قَالُوا :  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ بْنِ صَفْوَانَ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 388","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن سفيان بن عيينة عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","كعب بن عاصم الأشعري"
"17469","[19/173]      389  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  عَنِ  اللَّيْثِ (  ح  ) .  وَحَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 389","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن الليث بن سعد عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","كعب بن عاصم الأشعري"
"17470","390  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ  ، ثَنَا  إِسْحَاقُ بْنُ عُمَرَ بْنِ سَلِيطٍ - قَالَا :  ثَنَا  سُلَيْمَانُ بْنُ كَثِيرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 390","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن سليمان بن كثير الأصيد عن إسحاق بن عمر بن سليط الهذلي عن أحمد بن داود بن موسى السدوسي عن الطبراني","كعب بن عاصم الأشعري"
"17471","391  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  يَحْيَى بْنُ حَمْزَةَ ،  عَنِ  الزُّبَيْدِيِّ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 391","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن محمد بن الوليد بن عامر الزبيدي عن يحيى بن حمزة بن البتلهي عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","كعب بن عاصم الأشعري"
"17472","392  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْمُعَافَى بْنِ سُلَيْمَانَ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُوسَى         [19/174]      بْنُ أَعْيَنَ ،  عَنْ  إِسْحَاقَ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 392","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن إسحاق بن راشد الجزري عن موسى بن أعين الجزري عن المعافى بن سليمان الرسعني عن سليمان بن المعافى الرسعني عن الطبراني","كعب بن عاصم الأشعري"
"17473","393  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  حَجَّاجُ بْنُ الشَّاعِرِ ،  ثَنَا  يَزِيدُ بْنُ أَبِي حَكِيمٍ ،  ثَنَا  مَالِكُ بْنُ أَنَسٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 393","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن مالك بن أنس عن يزيد بن أبي حكيم الكناني عن حجاج يوسف الثقفي عن محمد بن عبدوس السراج عن الطبراني","كعب بن عاصم الأشعري"
"17474","394  -  حَدَّثَنَا  الْمُفَضَّلُ بْنُ مُحَمَّدٍ الْجَنَدِيُّ  ، ثَنَا  عَلِيُّ بْنُ زِيَادٍ اللَّخْمِيُّ  ،  ثَنَا  أَبُو قُرَّةَ مُوسَى بْنُ طَارِقٍ قَالَ :  ثَنَا  زَمْعَةُ بْنُ صَالِحٍ ،  عَنْ  زِيَادِ بْنِ سَعْدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( اللحجي )","","Al-Mu'jam al-Kabir 394","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن زياد بن سعد الخراساني عن زمعة بن صالح الجندي عن موسى بن طارق الزبيدي عن على بن زياد اللحجى عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","كعب بن عاصم الأشعري"
"17475","395  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  مَسْرُوقُ بْنُ الْمَرْزُبَانِ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ مُسْلِمٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ بْنِ صَفْوَانَ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 395","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن إسماعيل بن مسلم المكي مولى حدير من الأزد عن مروان بن معاوية الفزاري عن مسروق بن المرزبان الكندي عن محمد بن عثمان بن أبي شيبة عن الطبراني","كعب بن عاصم الأشعري"
"17476","396  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الزَّنْبَقِيُّ الْبَصْرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مَعْمَرٍ الْبَحْرَانِيُّ ،  ثَنَا  وَهْبُ بْنُ جَرِيرِ بْنِ حَازِمٍ قَالَ :  حَدَّثَنِي  أَبِي  ،  عَنِ  النُّعْمَانِ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : الزئبقي .","","Al-Mu'jam al-Kabir 396","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن النعمان بن راشد الجزري عن جرير بن حازم عن وهب بن جرير بن حازم عن محمد بن معمر بن ربعي البحراني عن أحمد بن عمرو بن أحمد الزئبقي عن الطبراني","كعب بن عاصم الأشعري"
"17477","[19/175]      397  -  حَدَّثَنِي  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ قَالَ :  ثَنَا  مُحَمَّدُ بْنُ أَبِي حَفْصَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 397","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن محمد بن أبي حفصة البصري عن روح بن عبادة القيسي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","كعب بن عاصم الأشعري"
"17478","398  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  عَبَّادُ بْنُ الْوَلِيدِ الْغُبَرِيُّ ،  ثَنَا  حَبَّانُ بْنُ هِلَالٍ ،  ثَنَا  عُمَارَةُ بْنُ زَاذَانَ ،  ثَنَا  مَكْحُولٌ الْأَزْدِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُسْلِمِ بْنِ شِهَابٍ الزُّهْرِيُّ ،  عَنْ  صَفْوَانَ بْنِ عَبْدِ اللهِ بْنِ صَفْوَانَ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 398","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن مكحول العتكي عن عمارة بن زاذان الصيدلاني عن حبان بن هلال الباهلي عن عباد بن الوليد الغبري عن أحمد بن يحيى بن زهير التستري عن الطبراني","كعب بن عاصم الأشعري"
"17479","399  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  عَبَّادٌ (  ح  ) .  وَحَدَّثَنَا  عَمْرُو بْنُ أَبِي الطَّاهِرِ بْنِ السَّرْحِ الْمِصْرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُزَيْزٍ الْأَيْلِيُّ ،  ثَنَا  سَلَامَةُ بْنُ رَوْحٍ ،  عَنْ  عُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  صَفْوَانَ ،  عَنْ  أُمِّ الدَّرْدَاءِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَيْسَ مِنَ  الْبِرِّ  الصِّيَامُ فِي السَّفَرِ  .","","Al-Mu'jam al-Kabir 399","","كعب بن عاصم الأشعري عن هجيمة الأوصابية أم الدرداء الصغرى عن صفوان عن الزهري عن عقيل بن خالد الأيلي عن سلامة بن روح الأيلي عن محمد بن عزيز بن عبد الله الأيلي عن عمرو بن أبي الطاهر المصري عن الطبراني","كعب بن عاصم الأشعري"
"17480","بَابٌ  400  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبَادَةَ الْوَاسِطِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  حَدَّثَتْنِي  كَرَامَةُ بِنْتُ الْحُسَيْنِ بْنِ جَعْفَرِ بْنِ الْحَارِثِ الْأَنْصَارِيَّةُ قَالَتْ :  سَمِعْتُ  أَبِي  يُحَدِّثُ عَنْ  أَبِي عَيَّاشٍ الزُّرَقِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  عَنْ  كَعْبِ بْنِ عَاصِمٍ الْأَشْعَرِيِّ قَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى         [19/176]      اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ  فِي حَجَّةِ الْوَدَاعِ  فِي أَوْسَطِ أَيَّامِ  التَّشْرِيقِ  يَقُولُ :  هَذَا الْيَوْمُ حَرَامٌ  ؟ قَالُوا : بَلَى يَا رَسُولَ اللهِ . قَالَ : فَإِنَّ  حُرْمَتَكُمْ  بَيْنَكُمْ  كَحُرْمَةِ  يَوْمِكُمْ هَذَا ، أُنْبِئُكُمْ مَنِ الْمُسْلِمُ ؟ الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ ، أُنْبِئُكُمْ مَنِ الْمُؤْمِنُ ؟ مَنْ أَمِنَهُ الْمُسْلِمُونَ عَلَى أَنْفُسِهِمْ وَأَمْوَالِهِمْ ، وَأُنْبِئُكُمْ مَنِ الْمُهَاجِرُ ؟ الْمُهَاجِرُ مَنْ هَجَرَ السَّيِّئَاتِ مِمَّا حَرَّمَ اللهُ عَلَيْهِ ، وَالْمُؤْمِنُ عَلَى الْمُؤْمِنِ حَرَامٌ  كَحُرْمَةِ  هَذَا الْيَوْمِ ، لَحْمُهُ عَلَيْهِ حَرَامٌ أَنْ يَأْكُلَهُ بِالْغَيْبِ وَيَغْتَابَهُ ، وَعِرْضُهُ عَلَيْهِ حَرَامٌ أَنْ يَخْرِقَهُ ، وَوَجْهُهُ عَلَيْهِ حَرَامٌ أَنْ يَلْطِمَهُ ، وَأَذَاهُ عَلَيْهِ حَرَامٌ أَنْ يُؤْذِيَهُ ، وَعَلَيْهِ حَرَامٌ أَنْ يَدْفَعَهُ دَفْعًا يُتَعْتِعُهُ  .","","Al-Mu'jam al-Kabir 400","","كعب بن عاصم الأشعري عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن أبو عياش الزرقي عن حسين عن كرامة بنت الحسين بن جعفر بن الحارث الأنصارية عن يعقوب بن محمد بن عيسى عن محمد بن عبادة بن البخترى الأسدي عن محمد بن أبان الأصبهاني عن الطبراني","باب"
"17481","401  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  بِشْرُ بْنُ آدَمَ قَالَ :  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ  قَالَ :  حَدَّثَتْنِي  كَرَامَةُ بِنْتُ الْحُسَيْنِ بْنِ الْحَارِثِ بْنِ عَبْدِ اللهِ بْنِ كَعْبٍ الْمَازِنِيِّ - وَكَانَ  عَبْدُ اللهِ بْنُ كَعْبٍ  عَلَى  ثَقَلِ  النَّبِيِّ  يَوْمَ بَدْرٍ  - قَالَتْ :  سَمِعْتُ  أَبِي  يُحَدِّثُ عَنْ  أَبِي عَيَّاشٍ الزُّرَقِيِّ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ ،  حَدَّثَنِي  كَعْبُ بْنُ عَاصِمٍ الْأَشْعَرِيُّ قَالَ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَخْطُبُ أَوْسَطَ أَيَّامِ الْأَضْحَى عِنْدَ الْجَمْرَةِ  .  في طبعة مكتبة ابن تيمية : (الزرقي) والمثبت من النسخة الخطية . والله أعلم .","","Al-Mu'jam al-Kabir 401","","كعب بن عاصم الأشعري عن جابر بن عبد الله بن عمرو بن حرام الأنصاري عن زيد بن عياش الزرقي عن حسين عن كرامة بنت الحسين بن الحارث بن عبد الله بن كعب المازني عن يعقوب بن محمد بن عيسى عن بشر بن آدم بن يزيد عن الحسين بن إسحاق التستري عن الطبراني","باب"
"17482","كَعْبُ بْنُ زُهَيْرِ بْنِ أَبِي سُلْمَى الْمُزَنِيُّ  402  -  حَدَّثَنَا  أَبُو خَلِيفَةَ  ،  عَنْ  مُحَمَّدِ بْنِ سَلَّامٍ  قَالَ :  وَاسْمُ  أَبِي سُلْمَى رَبِيعَةُ بْنُ رِيَاحِ بْنِ قُرْظِ بْنِ الْحَارِثِ بْنِ مَازِنِ بْنِ ثَعْلَبَةَ بْنِ ثَوْرِ بْنِ هَدْمَةَ بْنِ لَاطِي بْنِ عُثْمَانَ بْنِ مُزَيْنَةَ  .","","Al-Mu'jam al-Kabir 402","","","كعب بن زهير بن أبي سلمى المزني"
"17483","403  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ  ، ثَنَا  أَبُو         [19/177]      جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  قَالَ  :  لَمَّا قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْمَدِينَةَ  مُنْصَرَفَهُ مِنَ  الطَّائِفِ  كَتَبَ  بُجَيْرُ بْنُ زُهَيْرِ بْنِ أَبِي سُلْمَى  إِلَى أَخِيهِ  كَعْبِ بْنِ زُهَيْرِ بْنِ أَبِي سُلْمَى  يُخْبِرُهُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَتَلَ رَجُلًا  بِمَكَّةَ  مِمَّنْ كَانَ يَهْجُوهُ وَيُؤْذِيهِ ، وَأَنَّهُ مَنْ بَقِيَ مِنْ شُعَرَاءِ  قُرَيْشٍ  ابْنُ الزِّبَعْرَى  وَهُبَيْرَةُ بْنُ أَبِي وَهْبٍ  قَدْ هَرَبُوا فِي كُلِّ وَجْهٍ ، فَإِنْ كَانَتْ لَكَ فِي نَفْسِكَ حَاجَةٌ فَفِرَّ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَإِنَّهُ لَا يَقْتُلُ أَحَدًا جَاءَ تَائِبًا ، وَإِنْ أَنْتَ لَمْ تَفْعَلْ فَانْجُ إِلَى  نَجَائِكَ  . وَقَدْ كَانَ  كَعْبٌ  قَالَ أَبْيَاتًا نَالَ فِيهَا مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا بَلَغَ  كَعْبًا  الْكِتَابُ ضَاقَتْ بِهِ الْأَرْضُ وَأَشْفَقَ عَلَى نَفْسِهِ وَأَرْجَفَ بِهِ مَنْ كَانَ فِي حَاضِرِهِ مِنْ عَدُوِّهِ ، قَالُوا : هُوَ مَقْتُولٌ ! فَلَمَّا لَمْ يَجِدْ مِنْ شَيْءٍ بُدًّا قَالَ قَصِيدَتَهُ الَّتِي مَدَحَ فِيهَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَذَكَرَ خَوْفَهُ وَإِرْجَافَ الْوُشَاةِ بِهِ مِنْ غَدِهِ ، ثُمَّ خَرَجَ حَتَّى قَدِمَ  الْمَدِينَةَ  فَنَزَلَ عَلَى رَجُلٍ كَانَتْ بَيْنَهُ وَبَيْنَهُ مَعْرِفَةٌ مِنْ  جُهَيْنَةَ  كَمَا ذُكِرَ لِي ، فَغَدَا بِهِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ صَلَّى الصُّبْحَ ، فَصَلَّى مَعَ النَّاسِ ، ثُمَّ أَشَارَ لَهُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : هَذَا رَسُولُ اللهِ ، فَقُمْ إِلَيْهِ فَاسْتَأْمِنْهُ ! فَذَكَرَ لِي أَنَّهُ قَامَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى وَضَعَ يَدَهُ فِي يَدِهِ ، وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ لَا يَعْرِفُهُ ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ  كَعْبَ بْنَ زُهَيْرٍ  جَاءَ يَسْتَأْمِنُ مِنْكَ تَائِبًا مُسْلِمًا ، فَهَلْ أَنْتَ قَابِلٌ مِنْهُ إِنْ أَنَا جِئْتُكَ بِهِ ؟ فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : نَعَمْ . قَالَ : يَا رَسُولَ اللهِ ، أَنَا  كَعْبُ بْنُ زُهَيْرٍ !  قَالَ ابْنُ إِسْحَاقَ : فَحَدَّثَنِي عَاصِمُ بْنُ عَمْرِو بْنِ قَتَادَةَ  قَالَ : وَثَبَ عَلَيْهِ  رَجُلٌ مِنَ الْأَنْصَارِ  فَقَالَ : يَا رَسُولَ اللهِ ، دَعْنِي وَعَدُوَّ اللهِ أَضْرِبْ عُنُقَهُ ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَعْهُ عَنْكَ ، فَإِنَّهُ قَدْ جَاءَ تَائِبًا نَازِعًا  ! فَغَضِبَ عَلَى هَذَا الْحَيِّ مِنَ  الْأَنْصَارِ  بِمَا صَنَعَ بِهِ صَاحِبُهُمْ ، وَذَلِكَ أَنَّهُ لَمْ         [19/178]      يَتَكَلَّمْ فِيهِ رَجُلٌ مِنَ  الْمُهَاجِرِينَ  إِلَّا بِخَيْرٍ ، فَقَالَ قَصِيدَتَهُ الَّتِي قَالَهَا حِينَ قَدِمَ عَلَى رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَكَانَ مِمَّا قَالَ فِيهَا :  أَبَا  ـفُرْقَانِ  الْعَرَانِينِ  سَرَابِيلُ  قَالَ  ابْنُ إِسْحَاقَ  : فَحَدَّثَنِي  عَاصِمُ بْنُ عَمْرٍو  قَالَ : فَلَمَّا قَالَ "" السُّودُ التَّنَابِيلُ "" ، وَإِنَّمَا يُرِيدُ مَعْشَرَ  الْأَنْصَارِ  إِنَّمَا كَانَ صَاحِبُهُمْ صَنَعَ ، وَخَصَّ  الْمُهَاجِرِينَ  مِنْ  قُرَيْشٍ  مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ بِمِدْحَتِهِ - غَضِبَتْ عَلَيْهِ  الْأَنْصَارُ ،  فَقَالَ بَعْدَ أَنْ أَسْلَمَ يَمْدَحُ  الْأَنْصَارَ  وَيَذْكُرُ بَلَاءَهُمْ         [19/179]      مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَوْضِعَهُمْ مِنَ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مِقْنَبٍ  نُسُكٌ  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عاصم بن عمر بن قتادة ).","","Al-Mu'jam al-Kabir 403","","عاصم بن عمر الظفري عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","كعب بن زهير بن أبي سلمى المزني"
"17484","كَعْبُ بْنُ عِيَاضٍ الْأَشْعَرِيُّ  404  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ أَنَّ  عَبْدَ الرَّحْمَنِ بْنَ جُبَيْرِ بْنِ نُفَيْرٍ  حَدَّثَهُ  عَنْ  أَبِيهِ  ،  عَنْ  كَعْبِ بْنِ عِيَاضٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ لِكُلِّ أُمَّةٍ فِتْنَةً ، وَإِنَّ فِتْنَةَ أُمَّتِي الْمَالُ  .","","Al-Mu'jam al-Kabir 404","","كعب بن عياض الأشعري عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","كعب بن عياض الأشعري"
"17485","405  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عَبْدُ اللهِ         [19/180]      بْنُ يَحْيَى الْإِسْكَنْدَرَانِيُّ ،  ثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  أَبِي الزَّاهِرِيَّةِ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  كَعْبِ بْنِ عِيَاضٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْقُصَّاصُ ثَلَاثَةٌ  ؛ أَمِيرٌ ، أَوْ مَأْمُورٌ ، أَوْ مُخْتَالٌ  .","","Al-Mu'jam al-Kabir 405","","كعب بن عياض الأشعري عن جبير بن نفير بن مالك الحضرمي عن أبو الزاهرية حدير بن كريب عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن يحيى البرلسي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","كعب بن عياض الأشعري"
"17486","406  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي  ، ثَنَا  الْمُسَيِّبُ بْنُ وَاضِحٍ ،  ثَنَا  حَجَّاجُ بْنُ مُحَمَّدٍ ،  ثَنَا  لَيْثُ بْنُ سَعْدٍ ،  عَنْ  مُعَاوِيَةَ بْنِ صَالِحٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  كَعْبِ بْنِ عِيَاضٍ الْأَشْعَرِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَوْ سُئِلَ لِابْنِ آدَمَ وَادِيَانِ مِنْ مَالٍ لَتَمَنَّى إِلَيْهِمَا ثَالِثًا  ، وَلَا يُشْبِعُ ابْنَ آدَمَ إِلَّا التُّرَابُ ، وَيَتُوبُ اللهُ عَلَى مَنْ تَابَ  .","","Al-Mu'jam al-Kabir 406","","كعب بن عياض الأشعري عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن معاوية بن صالح بن حدير الحضرمي عن الليث بن سعد عن حجاج بن محمد الأعور عن المسيب بن واضح التلمنسي عن يحيى بن عبد الباقي الثغري عن الطبراني","كعب بن عياض الأشعري"
"17487","كَعْبُ بْنُ عَمْرٍو الْيَامِيُّ  407  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو مَعْمَرٍ الْمُقْعَدُ ،  ثَنَا  عَبْدُ الْوَارِثِ بْنُ سَعِيدٍ ،  عَنْ  لَيْثِ بْنِ أَبِي سُلَيْمٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَسَحَ رَأْسَهُ مَرَّةً هَكَذَا  ، حَتَّى بَلَغَ الْقَذَالَ  .","","Al-Mu'jam al-Kabir 407","","كعب بن عمرو اليامي عن مصرف بن عمرو بن كعب اليامي عن طلحة بن مصرف الهمداني عن ليث بن أبي سليم عن عبد الوارث بن سعيد بن ذكوان عن عبد الله بن عمرو المقعد عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","كعب بن عمرو اليامي"
"17488","408  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  عَبْدُ الْوَارِثِ ،  عَنْ  لَيْثٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَسَحَ رَأْسَهُ مِنْ مُقَدَّمِهِ إِلَى مُؤَخَّرِهِ  وَأَخْرَجَ يَدَيْهِ مِنْ تَحْتِ أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 408","","كعب بن عمرو اليامي عن مصرف بن عمرو بن كعب اليامي عن طلحة بن مصرف الهمداني عن ليث بن أبي سليم عن عبد الوارث بن سعيد بن ذكوان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","كعب بن عمرو اليامي"
"17489","409  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  شَيْبَانُ بْنُ فَرُّوخَ ،  ثَنَا  أَبُو سَلَمَةَ الْكِنْدِيُّ ،  ثَنَا  لَيْثُ بْنُ أَبِي سُلَيْمٍ ،  حَدَّثَنِي  طَلْحَةُ بْنُ مُصَرِّفٍ ،         [19/181]      عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَوَضَّأَ فَمَضْمَضَ ثَلَاثًا وَاسْتَنْشَقَ ثَلَاثًا  ، يَأْخُذُ لِكُلِّ وَاحِدَةٍ مَاءً جَدِيدًا ، وَغَسَلَ وَجْهَهُ ثَلَاثًا ، فَلَمَّا مَسَحَ رَأْسَهُ قَالَ هَكَذَا - وَأَوْمَأَ بِيَدِهِ مِنْ مُقَدَّمِ رَأْسِهِ حَتَّى بَلَغَ بِهِمَا إِلَى أَسْفَلِ عُنُقِهِ مِنْ قِبَلِ قَفَاهُ  .","","Al-Mu'jam al-Kabir 409","","كعب بن عمرو اليامي عن مصرف بن عمرو بن كعب اليامي عن طلحة بن مصرف الهمداني عن ليث بن أبي سليم عن أبو سلمة الكندي عن شيبان بن فروخ الحبطي عن الحسين بن إسحاق التستري عن الطبراني","كعب بن عمرو اليامي"
"17490","410  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  أُمَيَّةُ بْنُ بِسْطَامٍ ،  ثَنَا  مُعْتَمِرٌ ،  ثَنَا  لَيْثٌ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَتَوَضَّأُ وَالْمَاءُ يَسِيلُ مِنْ وَجْهِهِ عَلَى لِحْيَتِهِ وَصَدْرِهِ  ، يَفْصِلُ بَيْنَ الْمَضْمَضَةِ وَالِاسْتِنْشَاقِ  .","","Al-Mu'jam al-Kabir 410","","كعب بن عمرو اليامي عن مصرف بن عمرو بن كعب اليامي عن طلحة بن مصرف الهمداني عن ليث بن أبي سليم عن معتمر بن سليمان عن أمية بن بسطام عن إبراهيم بن هاشم البغوي عن الطبراني","كعب بن عمرو اليامي"
"17491","411  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  سَعِيدُ بْنُ عَنْبَسَةَ الْخَزَّازُ ،  ثَنَا  شُعَيْبُ بْنُ حَرْبٍ ،  ثَنَا  مَالِكُ بْنُ مِغْوَلٍ ،  عَنْ  طَلْحَةَ بْنِ مُصَرِّفٍ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَوَضَّأَ فَمَسَحَ بِرَأْسِهِ  .","","Al-Mu'jam al-Kabir 411","","كعب بن عمرو اليامي عن مصرف بن عمرو بن كعب اليامي عن طلحة بن مصرف الهمداني عن مالك بن مغول الصهيبي عن شعيب بن حرب الأبناوي عن سعيد بن عنبسة الرازي عن الحسين بن إسحاق التستري عن الطبراني","كعب بن عمرو اليامي"
"17492","412  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ مُصَرِّفِ بْنِ عَمْرٍو الْيَامِيُّ ،  حَدَّثَنِي  أَبِي مُصَرِّفُ بْنُ عَمْرِو بْنِ السَّرِيِّ بْنِ مُصَرِّفِ بْنِ كَعْبِ بْنِ عَمْرٍو ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  يَبْلُغُ بِهِ  كَعْبَ بْنَ عَمْرٍو قَالَ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - تَوَضَّأَ فَمَسَحَ بَاطِنَ لِحْيَتِهِ وَقَفَاهُ  .","","Al-Mu'jam al-Kabir 412","","كعب بن عمرو اليامي عن مصرف بن عمرو بن كعب اليامي عن عمرو بن السري عن مصرف بن عمرو بن السري الهمداني عن أحمد بن مصرف بن عمرو اليامي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","كعب بن عمرو اليامي"
"17493","[19/182]      كَعْبُ بْنُ قُطْبَةَ  413  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ .","","Al-Mu'jam al-Kabir 413","","","كعب بن قطبة"
"17494","مَنِ اسْمُهُ كُلْثُومٌ  كُلْثُومُ بْنُ حُصَيْنٍ أَبُو رُهْمٍ الْغِفَارِيُّ  وَهُوَ كُلْثُومُ بْنُ حُصَيْنِ بْنِ عُبَيْدِ بْنِ خَلَفِ بْنِ قَيْسِ بْنِ أَحْمَسَ بْنِ عَفَّانَ بْنِ مُقْبِلِ بْنِ ضَمْرَةَ بْنِ بَكْرِ بْنِ عَبْدِ مَنَاةَ بْنِ كِنَانَةَ بْنِ خُزَيْمَةَ بْنِ مُدْرِكَةَ بْنِ إِلْيَاسَ بْنِ مُضَرَ بْنِ نِزَارِ بْنِ مَعَدِّ بْنِ عَدْنَانَ  ، وَكَانَ مِمَّنْ بَايَعَ تَحْتَ الشَّجَرَةِ .  414  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُبَيْدِ اللهِ بْنِ عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا خَرَجَ  لِفَتْحِ مَكَّةَ  اسْتَخْلَفَ عَلَى  الْمَدِينَةِ  أَبَا رُهْمٍ كُلْثُومَ بْنَ الْحُصَيْنِ الْغِفَارِيَّ  .","","Al-Mu'jam al-Kabir 414","","عبد الله بن عباس عن عبيد الله بن عبد الله بن عتبة بن مسعود عن الزهري عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","استخلاف أبو رهم الغفاري على المدينة"
"17495","[19/183]      مَا  أَسْنَدَ  أَبُو رُهْمٍ الْغِفَارِيُّ  415  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  ابْنُ أَخِي أَبِي رُهْمٍ  أَنَّهُ سَمِعَ  أَبَا رُهْمٍ الْغِفَارِيَّ - وَكَانَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّذِينَ بَايَعُوا تَحْتَ الشَّجَرَةِ - قَالَ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  تَبُوكَ  ، فَلَمَّا سِرْنَا لَيْلَةً سِرْتُ قَرِيبًا مِنْهُ فَأُلْقِيَ عَلَيَّ النُّعَاسُ ، فَطَفِقْتُ أَسْتَيْقِظُ وَقَدْ دَنَتْ رَاحِلَتِي مِنْ رَاحِلَتِهِ ، فَيُفْزِعُنِي دُنُوُّهَا خَشْيَةَ أَنْ أُصِيبَ رِجْلَهُ فِي  الْغَرْزِ  ، فَأُؤَخِّرُ رَاحِلَتِي ، حَتَّى غَلَبَ عَلَى عَيْنِي بَعْضُ اللَّيْلِ فَزَاحَمَتْ رَاحِلَتِي رِجْلَهُ فِي  الْغَرْزِ  فَأَصَابَتْ رِجْلَهُ ، فَلَمْ أَسْتَيْقِظْ إِلَّا بِقَوْلِهِ :  حَسِّ  ! فَقُلْتُ : اسْتَغْفِرْ لِي يَا رَسُولَ اللهِ ! فَقَالَ : سِرْ . فَطَفِقَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْتَخْبِرُ عَمَّنْ تَخَلَّفَ مِنْ  بَنِي غِفَارٍ  فَأُخْبِرُهُ ، فَإِذَا هُوَ يَسْأَلُنِي :  مَا فَعَلَ الْحُمْرُ الطُّوَالُ الثِّطَاطُ ؟  فَحَدَّثْتُهُ بِتَخَلُّفِهِمْ ، فَقَالَ : مَا فَعَلَ  النَّفَرُ السُّودُ - أَوْ قَالَ : الْقِصَارُ  الْجِعَادُ  الثِّطَاطُ  الَّذِينَ لَهُمْ نَعَمٌ  بِشَبَكَةِ  سَرْحٍ  ؟ قَالَ : فَذَكَرْتُ فِي  بَنِي غِفَارٍ  فَلَمْ أَذْكُرْهُمْ ، حَتَّى ذَكَرْتُ رَهْطًا مِنْ  أَسْلَمَ  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، أُولَئِكَ رَهْطٌ مِنْ  أَسْلَمَ  قَدْ تَخَلَّفُوا ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فَمَا يَمْنَعُ أَحَدَ أُولَئِكَ         [19/184]      حِينَ تَخَلَّفَ أَنْ يَحْمِلَ عَلَى بَعِيرٍ مِنْ إِبِلِهِ امْرَأً نَشِيطًا فِي  سَبِيلِ  اللهِ ؟ فَإِنَّ أَعَزَّ أَهْلِي عَلَيَّ أَنْ يَتَخَلَّفَ عَنِّي  الْمُهَاجِرُونَ  مِنْ  قُرَيْشٍ  وَالْأَنْصَارُ  وَأَسْلَمُ  وَغِفَارٌ  .","","Al-Mu'jam al-Kabir 415","","كلثوم بن الحصين بن خالد السمعي عن ابن أخي أبي رهم عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ما أسند أبو رهم الغفاري"
"17496","416  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  الزُّهْرِيِّ ،  حَدَّثَنِي  ابْنُ أَخِي أَبِي رُهْمٍ الْغِفَارِيِّ  أَنَّهُ سَمِعَ  أَبَا رُهْمٍ - وَكَانَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّذِينَ بَايَعُوا تَحْتَ الشَّجَرَةِ - قَالَ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَبِتُّ لَيْلَةً فَسِرْتُ قَرِيبًا مِنْهُ  . فَذَكَرَ الْحَدِيثَ .","","Al-Mu'jam al-Kabir 416","","كلثوم بن الحصين بن خالد السمعي عن ابن أخي أبي رهم عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","ما أسند أبو رهم الغفاري"
"17497","417  -  حَدَّثَنِي  أَبُو أُسَامَةَ الْحَلَبِيُّ  ، ثَنَا  حَجَّاجُ بْنُ أَبِي مَنِيعٍ الرُّصَافِيُّ ،  ثَنَا  جَدِّي  ،  عَنِ  الزُّهْرِيِّ ،  أَخْبَرَنِي  ابْنُ أَخِي أَبِي رُهْمٍ الْغِفَارِيِّ  أَنَّهُ سَمِعَ  أَبَا رُهْمٍ - وَكَانَ مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ الَّذِينَ بَايَعُوا تَحْتَ الشَّجَرَةِ - يَقُولُ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  غَزْوَةَ تَبُوكَ  ، فَلَمَّا قَفَلَ سَرَى لَيْلَةً بِالْأَخْضَرِ ، فَسِرْتُ قَرِيبًا مِنْهُ ، وَأُلْقِيَ عَلَيْنَا النُّعَاسُ ، فَطَفِقْتُ أَسْتَيْقِظُ وَقَدْ دَنَتْ رَاحِلَتِي مِنْ رَاحِلَتِهِ فَيُفْزِعُنِي دُنُوُّهَا ، حَتَّى خَشِيتُ أَنْ أُصِيبَ رِجْلَهُ فِي  الْغَرْزِ  ، فَأُؤَخِّرُ رَاحِلَتِي ، حَتَّى غَلَبَتْنِي عَيْنِي فِي بَعْضِ اللَّيْلِ فَزَاحَمَتْ رَاحِلَتِي رَاحِلَةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  الْغَرْزِ  فَأَصَابَتْ رِجْلَهُ ، فَلَمْ أَسْتَيْقِظْ إِلَّا بِقَوْلِهِ :  حَسِّ  ! فَقُلْتُ : يَا رَسُولَ اللهِ اسْتَغْفِرْ لِي ! فَقَالَ : سِرْ . فَطَفِقَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْأَلُنِي عَمَّنْ تَخَلَّفَ         [19/185]      مِنْ  بَنِي غِفَارٍ  ، فَأَخْبَرْتُهُ ، فَقَالَ وَهُوَ يَسْأَلُنِي :  مَا فَعَلَ النَّفَرُ الْحُمْرُ الطُّوَالُ الثِّطَاطُ ؟  فَحَدَّثْتُهُ بِتَخَلُّفِهِمْ ، فَقَالَ : مَا فَعَلَ النَّفَرُ السُّودُ الْجَرَادُ الْقِصَارُ الَّذِينَ لَهُمْ نَعَمٌ  بِشَبَكَةِ  سَرْحٍ  ؟ قَالَ : فَتَذَكَّرْتُ فِي  بَنِي غِفَارٍ  فَلَمْ أَذْكُرْهُمْ ، حَتَّى ذَكَرْتُ أَنَّهُمْ رَهْطٌ مِنْ  أَسْلَمَ  وَقَدْ تَخَلَّفُوا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا مَنَعَ أَحَدَ أُولَئِكَ حِينَ تَخَلَّفَ أَنْ يَحْمِلَ عَلَى بَعِيرٍ مِنْ إِبِلِهِ امْرَأً نَشِيطًا فِي  سَبِيلِ  اللهِ ؟ فَإِنَّ أَعَزَّ أَهْلِي عَلَيَّ أَنْ يَتَخَلَّفَ عَنِّي  الْمُهَاجِرُونَ  مِنْ  قُرَيْشٍ  وَالْأَنْصَارُ  وَأَسْلَمُ  وَغِفَارٌ  .  فَرَوَاهُ مُحَمَّدُ بْنُ  إِسْحَاقَ  عَنِ  الزُّهْرِيِّ  ، وَبَيْنَ  ابْنِ أَخِي أَبِي رُهْمٍ  ابْنُ أُكَيْمَةَ  .","","Al-Mu'jam al-Kabir 417","","كلثوم بن الحصين بن خالد السمعي عن ابن أخي أبي رهم عن الزهري عن عبيد الله بن أبي زياد الرصافي عن حجاج بن يوسف الرصافي عن عبد الله بن محمد بن أبي أسامة الحلبي عن الطبراني","ما أسند أبو رهم الغفاري"
"17498","418  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ، ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ السَّدُوسِيُّ ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ الْبَكَّائِيُّ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  ابْنِ أُكَيْمَةَ اللَّيْثِيِّ ،  عَنِ  ابْنِ أَخِي أَبِي رُهْمٍ  أَنَّهُ سَمِعَ  أَبَا رُهْمٍ كُلْثُومَ بْنَ حُصَيْنٍ مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الَّذِينَ بَايَعُوا تَحْتَ الشَّجَرَةِ أَنَّهُ قَالَ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  غَزْوَةَ تَبُوكَ  ، فَسِرْتُ ذَاتَ لَيْلَةٍ مَعَهُ وَنَحْنُ بِـ ( الْأَخْضَرِ ) قَرِيبٌ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأُلْقِيَ عَلَيْنَا النُّعَاسُ وَجَعَلْتُ أَسْتَيْقِظُ وَقَدْ دَنَتْ رَاحِلَتِي مِنْ رَاحِلَةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيُفْزِعُنِي دُنُوُّهَا مِنْهُ مَخَافَةَ أَنْ أُصِيبَ رِجْلَهُ فِي  الْغَرْزِ  ، فَطَفِقْتُ  أَحُوزُ  رَاحِلَتِي عَنْهُ ، حَتَّى غَلَبَتْنِي عَيْنِي فِي بَعْضِ الطَّرِيقِ وَنَحْنُ فِي بَعْضِ اللَّيْلِ ، فَزَاحَمَتْ رَاحِلَتِي رَاحِلَةَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَرِجْلُهُ فِي  الْغَرْزِ  ، فَمَا اسْتَيْقَظْتُ إِلَّا بِقَوْلِهِ : حَسِّ ! فَقُلْتُ : يَا رَسُولَ اللهِ اسْتَغْفِرْ لِي ! فَقَالَ : سِرْ . فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَسْأَلُنِي عَمَّنْ تَخَلَّفَ مِنْ  بَنِي غِفَارٍ  فَأُخْبِرُهُ بِهِ ، فَقَالَ وَهُوَ يَسْأَلُنِي :  مَا فَعَلَ النَّفَرُ الْحُمْرُ الطُّوَالُ الثِّطَاطُ ؟  فَحَدَّثْتُهُ بِتَخَلُّفِهِمْ ، قَالَ : فَمَا فَعَلَ السُّودُ  الْجِعَادُ  الْقِصَارُ ؟ قَالَ : قُلْتُ : وَاللهِ مَا أَعْرِفُ هَؤُلَاءِ         [19/186]      مِنَّا ! قَالَ : بَلَى ، الَّذِينَ لَهُمْ نَعَمٌ  بِشَبَكَةِ  شَدْخٍ ؟ فَتَذَكَّرْتُهُمْ فِي  بَنِي غِفَارٍ  وَلَمْ أَذْكُرْهُمْ حَتَّى ذَكَرْتُ أَنَّهُمْ رَهْطٌ مِنْ  أَسْلَمَ  كَانُوا حُلَفَاءَ فِينَا ، فَقُلْتُ : يَا رَسُولَ اللهِ ، أُولَئِكَ رَهْطٌ مِنْ  أَسْلَمَ  كَانُوا حُلَفَاءَ فِينَا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : مَا مَنَعَ أَحَدَ أُولَئِكَ حِينَ تَخَلَّفَ أَنْ يَحْمِلَ عَلَى بَعِيرٍ مِنْ إِبِلِهِ امْرَأً نَشِيطًا فِي  سَبِيلِ  اللهِ ؟ إِنَّ أَعَزَّ أَهْلِي عَلَيَّ أَنْ يَتَخَلَّفَ عَنِّي  الْمُهَاجِرُونَ  مِنْ  قُرَيْشٍ  وَالْأَنْصَارُ  وَغِفَارٌ  وَأَسْلَمُ  .","","Al-Mu'jam al-Kabir 418","","كلثوم بن الحصين بن خالد السمعي عن ابن أخي أبي رهم عن عمارة بن أكيمة الجندعي عن الزهري عن محمد بن إسحاق عن زياد بن عبد الله البكائي عن عبد الملك بن هشام الذهلي عن عبد الرحيم بن عبد الله البرقي عن الطبراني","ما أسند أبو رهم الغفاري"
"17499","419  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  إِبْرَاهِيمُ بْنُ إِسْحَاقَ الضَّبِّيُّ - قَالَا :  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ السُّلَمِيِّ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ الْمَدَنِيِّ ،  عَنْ  أَبِي حَازِمٍ مَوْلَى أَبِي رُهْمٍ ،  حَدَّثَنِي  مَوْلَايَ أَبُو رُهْمٍ قَالَ :  شَهِدْتُ أَنَا وَأَخِي  خَيْبَرَ  وَمَعَنَا فَرَسَانِ ، فَقَسَمَ لَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سِتَّةَ أَسْهُمٍ  ؛ لِلْفَرَسَيْنِ أَرْبَعَةَ أَسْهُمٍ ، وَلَنَا سَهْمَيْنِ ، فَبِعْنَا سَهْمَيْنَا بِبَكْرَيْنِ  .","","Al-Mu'jam al-Kabir 419","","كلثوم بن الحصين بن خالد السمعي عن دينار مولى أبي رهم الغفاري عن إسحاق بن أبي فروة عن محمد بن علي بن ربيعة السلمي عن قيس بن الربيع الأسدي عن إبراهيم بن إسحاق الضبي الكوفي عن محمد بن عثمان بن أبي شيبة عن الطبراني","ما أسند أبو رهم الغفاري"
"17500","420  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ أَبِي فَرْوَةَ ،  عَنْ  أَبِي حَازِمٍ مَوْلَى أَبِي رُهْمٍ ،  عَنْ  أَبِي رُهْمٍ  وَعَنْ  أَخِيهِ  أَنَّهُمَا كَانَا فَارِسَيْنِ  يَوْمَ خَيْبَرَ  فَأُعْطِيَا سِتَّةَ أَسْهُمٍ  ؛ أَرْبَعَةٌ لِفَرَسَيْهِمَا وَسَهْمَانِ لَهُمَا ، فَبَاعَا السَّهْمَيْنِ بِبَكْرَيْنِ  .","","Al-Mu'jam al-Kabir 420","","أبو ذر الغفاري عن دينار مولى أبي رهم الغفاري عن إسحاق بن أبي فروة عن إسماعيل بن عياش الأحول عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","ما أسند أبو رهم الغفاري"
"17501","كَلَدَةُ بْنُ حَنْبَلٍ الْغَسَّانِيُّ  حَلِيفُ  بَنِي جُمَحٍ  ، كَانَ يَنْزِلُ  مَكَّةَ  ، وَهُوَ  كَلَدَةُ بْنُ حَنْبَلِ بْنِ مَالِكِ         [19/187]      بْنِ عَائِدَةَ بْنِ كُلْوَةَ ،  وَأُمُّهُ  أُنَيْسَةُ بِنْتُ مَعْمَرِ بْنِ حَبِيبِ بْنِ وَهْبِ بْنِ حُذَافَةَ بْنِ جُمَحٍ  ، وَهُوَ أَخُو  صَفْوَانَ بْنِ أُمَيَّةَ  لِأُمِّهِ ، حَالَفَ أَبُوهُ  مَعْمَرًا  وَأَنْكَحَهُ ابْنَتَهُ .  مَا  أَسْنَدَ  كَلَدَةُ بْنُ حَنْبَلٍ  421  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْحَسَنِ الْمِصْرِيُّ الْأُبُلِّيُّ  ، ثَنَا  أَبُو عَاصِمٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  الْعَبَّاسُ بْنُ الْفَرَجِ الرِّيَاشِيُّ (  ح  ) .  وَحَدَّثَنَا  الْحَسَنُ بْنُ حَمَّادِ بْنِ فَضَالَةَ الصَّيْرَفِيُّ الْبَصْرِيُّ  ، ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ - قَالَا :  ثَنَا  أَبُو عَاصِمٍ (  ح  ) .  وَحَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  رَوْحُ بْنُ عُبَادَةَ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ - قَالَا :  ثَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ أَبِي سُفْيَانَ أَنَّ عَمْرَو بْنَ عَبْدِ اللهِ بْنِ صَفْوَانَ  أَخْبَرَهُ  أَنَّ كَلَدَةَ بْنَ حَنْبَلٍ  أَخْبَرَهُ  أَنَّ  صَفْوَانَ بْنَ أُمَيَّةَ  بَعَثَهُ فِي الْفَتْحِ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِلَبَنٍ وَجَدَايَةٍ  وَضَغَابِيسَ  ، وَالنَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِأَعْلَى الْوَادِي ، فَدَخَلْتُ فَلَمْ أَسْتَأْذِنْ وَلَمْ أُسَلِّمْ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اخْرُجْ فَقُلِ السَّلَامُ عَلَيْكُمْ ، أَأَدْخُلُ ؟  وَذَلِكَ بَعْدَمَا أَسْلَمَ  صَفْوَانُ  .  قَالَ  أَبُو عَاصِمٍ  :  الضَّغَابِيسُ  بَقْلَةٌ  تَكُونُ فِي الْبَادِيَةِ  .  في طبعة مكتبة ابن تيمية : ( بغلة ) والمثبت من الأصل الخطي ، وكذا أخرجه المزي في تهذيب الكمال من طريق المصنف","","Al-Mu'jam al-Kabir 421","","كلدة بن الحنبل الجمحي عن عمرو بن عبد الله بن صفوان الجمحي عن عمرو بن أبي سفيان الجمحي عن ابن جريج عن روح بن عبادة القيسي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","ما أسند كلدة بن حنبل"
"17502","مَنِ اسْمُهُ كُدَيْرٌ  كُدَيْرٌ الضَّبِّيُّ  كَانَ يَنْزِلُ  الْكُوفَةَ ،  وَقَدِ اخْتُلِفَ فِي صُحْبَتِهِ  422  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ         [19/188]      مَعْمَرٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  أَخْبَرَنِي  كُدَيْرٌ الضَّبِّيُّ  أَنَّ  رَجُلًا أَعْرَابِيًّا  أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : أَخْبِرْنِي بِعَمَلٍ يُقَرِّبُنِي مِنَ الْجَنَّةِ وَيُبَاعِدُنِي مِنَ النَّارِ ! فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَوَهُمَا أَهَمَّتَاكَ ؟ قَالَ : نَعَمْ . قَالَ : تَقُولُ الْعَدْلَ ، وَتُعْطِي الْفَضْلَ .  قَالَ : وَاللهِ مَا أَسْتَطِيعُ أَنْ أَقُولَ الْعَدْلَ كُلَّ سَاعَةٍ ، وَمَا أَسْتَطِيعُ أَنْ أُعْطِيَ فَضْلَ مَالِي . قَالَ : تُطْعِمُ الطَّعَامَ ، وَتُفْشِي السَّلَامَ . قَالَ : هَذِهِ أَيْضًا شَدِيدَةٌ . فَقَالَ : فَهَلْ لَكَ إِبِلٌ ؟ قَالَ : نَعَمْ . قَالَ : فَانْظُرْ إِلَى بَعِيرٍ مِنْ إِبِلِكَ وَسِقَاءٍ ثُمَّ اعْمِدْ إِلَى أَهْلَ بَيْتٍ لَا يَشْرَبُونَ الْمَاءَ إِلَّا غِبًّا فَاسْقِهِمْ ، فَلَعَلَّكَ لَا تُهْلِكُ بَعِيرَكَ وَلَا تَخْرِقُ سِقَاءَكَ حَتَّى تَجِبَ لَكَ الْجَنَّةُ . فَانْطَلَقَ الْأَعْرَابِيُّ يُكَبِّرُ ، فَمَا انْخَرَقَ سِقَاؤُهُ وَلَا هَلَكَ بَعِيرُهُ حَتَّى قُتِلَ  شَهِيدًا  .","","Al-Mu'jam al-Kabir 422","","كدير الضبي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","كدير الضبي"
"17503","مَنِ اسْمُهُ كَثِيرٌ  كَثِيرُ بْنُ الْعَبَّاسِ  423  -  حَدَّثَنَا  أَبُو عُبَيْدَةَ عَبْدُ الْوَارِثِ بْنُ إِبْرَاهِيمَ الْعَسْكَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الْحَارِثِيُّ  ،  ثَنَا  الْحَسَنُ بْنُ عَنْبَسَةَ ،  ثَنَا  عَلِيُّ بْنُ هَاشِمٍ ،  عَنِ  الصَّبَّاحِ بْنِ يَحْيَى ،  عَنْ  يَزِيدَ بْنِ أَبِي زِيَادٍ ،  عَنِ  الْعَبَّاسِ بْنِ كَثِيرٍ ،  عَنْ  كَثِيرِ بْنِ الْعَبَّاسِ  قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَجْمَعُنَا أَنَا  وَعَبْدَ اللهِ  وَعُبَيْدَ اللهِ  وَقُثَمَ  فَيُفَرِّجُ يَدَيْهِ هَكَذَا ، فَيَمُدُّ بَاعَهُ  ، وَيَقُولُ : مَنْ سَبَقَ إِلَيَّ فَلَهُ كَذَا وَكَذَا  .  في طبعة مكتبة ابن تيمية : (المازني) ، والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 423","","كثير بن العباس بن عبد المطلب بن هاشم عن العباس بن كثير عن يزيد بن أبي زياد القرشي عن صباح بن يحيى المزني عن علي بن هاشم العائذي عن الحسن بن عنبسة الوراق عن عبيد الله بن محمد الأهوازى عن عبد الوارث بن إبراهيم العسكري عن الطبراني","كثير بن العباس"
"17504","[19/189]      مَنِ اسْمُهُ كَرِيزٌ  كَرِيزُ بْنُ سَامَةَ  424  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ وَأَحْمَدُ بْنُ مَابِهْرَامَ الْإِيذَجِيُّ - قَالَا :  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْأَسْفَاطِيُّ ،  ثَنَا  يَحْيَى بْنُ رَاشِدٍ ،  ثَنَا  الرَّحَّالُ بْنُ الْمُنْذِرِ بْنِ يَزِيدَ الْعُمَرِيُّ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي  ،  عَنْ  كَرِيزِ بْنِ سَامَةَ - وَقَدْ كَانَ وَفَدَ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  قِيلَ : يَا رَسُولَ اللهِ ، ادْعُ عَلَى  بَنِي عَامِرٍ  ! فَقَالَ :  إِنِّي لَمْ أُبْعَثْ لَعَّانًا  .","","Al-Mu'jam al-Kabir 424","","كرز بن أسامة العامري عن بيحرة بن عامر القيسي عن والد الرحال بن المنذر عن الرحال بن المنذر عن يحيى بن راشد المازني عن محمد بن يزيد بن عبد الملك الأسفاطي عن أحمد بن الحسين بن مابهرام الأيذجي عن الطبراني","كريز بن سامة"
"17505","425  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  عَمْرُو بْنُ بُسْرٍ ،  ثَنَا  يَحْيَى بْنُ رَاشِدٍ ،  ثَنَا  الرَّحَّالُ بْنُ الْمُنْذِرِ ،  حَدَّثَنِي  أَبِي ،  عَنْ  أَبِيهِ  ،  عَنْ  كَرِيزِ بْنِ سَامَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَقَدَ رَايَةً  لِبَنِي سُلَيْمٍ  حَمْرَاءَ  .","","Al-Mu'jam al-Kabir 425","","كرز بن أسامة العامري عن بيحرة بن عامر القيسي عن والد الرحال بن المنذر عن الرحال بن المنذر عن يحيى بن راشد المازني عن عمرو بن بسر عن البزار عن الطبراني","كريز بن سامة"
"17506","مَنِ اسْمُهُ كَرْدَمٌ  كَرْدَمُ بْنُ سُفْيَانَ الثَّقَفِيُّ ، أَبُو مَيْمُونَةَ  426  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الرَّحْمَنِ - يَعْنِي ابْنَ كَعْبٍ الطَّائِفِيَّ  - عَنْ  يَزِيدَ بْنِ مِقْسَمٍ ،  عَنْ  مَيْمُونَةَ بِنْتِ كَرْدَمٍ  أَنَّهَا كَانَتْ رَدِيفَ أَبِيهَا  فَسَمِعَتْ  أَبَاهَا يَسْأَلُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ         [19/190]      وَسَلَّمَ - قَالَ : إِنِّي نَذَرْتُ لَأَنْحَرَنَّ  بِبُوَانَةَ  ! فَقَالَ : هَلْ بِهَا وَثَنٌ أَوْ طَاغِيَةٌ تُعْبَدُ ؟ قَالَ : لَا ، قَالَ :  أَوْفِ بِنَذْرِكَ  .","","Al-Mu'jam al-Kabir 426","","كردم بن سفيان الثقفي عن ميمونة بنت كردم اليسارية عن يزيد بن مقسم الطائفي عن عبد الله بن عبد الرحمن بن يعلى الطائفي عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","كردم بن سفيان الثقفي أبو ميمونة"
"17507","427  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  كَامِلُ بْنُ طَلْحَةَ الْجَحْدَرِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  عَمْرُو بْنُ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  أَنَّ  كَرْدَمَ بْنَ سُفْيَانَ الثَّقَفِيَّ أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي نَذَرْتُ أَنْ أَنْحَرَ ذَوْدَ إِبِلٍ  بِبُوَانَةَ  ! فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : عَلَى وَثَنٍ ؟ فَقَالَ : لَا ، فَقَالَ : أَعَلَى جَمْعٍ مِنْ جُمُوعِ الْجَاهِلِيَّةِ ؟ قَالَ : لَا ، قَالَ :  أَوْفِ بِنَذْرِكَ حَيْثُ كَانَ  ، يَا  كَرْدَمُ  إِنَّهُ لَا نَذْرَ وَلَا يَمِينَ فِي مَعْصِيَةِ اللهِ  .","","Al-Mu'jam al-Kabir 427","","كردم بن سفيان الثقفي عن عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن عبد الله بن لهيعة عن كامل بن طلحة الجحدري عن موسى بن هارون الحمال عن الطبراني","كردم بن سفيان الثقفي أبو ميمونة"
"17508","428  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ الْعَيْشِيُّ ،  حَدَّثَنِي  سَلْمُ بْنُ قُتَيْبَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ يَزِيدَ الثَّقَفِيِّ قَالَ :  حَدَّثَتْنِي  سَارَةُ بِنْتُ مِقْسَمٍ ،  عَنْ  مَيْمُونَةَ ابْنَةِ كَرْدَمٍ ،  عَنْ  أَبِيهَا كَرْدَمِ بْنِ سُفْيَانَ الثَّقَفِيِّ  أَنَّ  رَجُلًا  قَالَ : يَا رَسُولَ اللهِ ! فَأَصْغَى إِلَيْهِ ، فَقَالَ : أَيْنَ عَامُ جَيْشِ عِثْرَانَ ؟ قَالَ : فَعَرَفَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَلِكَ الْجَيْشَ ، كُنْتُ فِي ذَلِكَ الْجَيْشِ ، فَقَالَ  طَارِقُ بْنُ الْمُرَقِّعِ  : مَنْ يُعْطِينِي رُمْحًا بِثَوَابِهِ ؟ قُلْتُ : وَمَا ثَوَابُهُ ؟ فَقَالَ : أَوَّلُ ابْنَةٍ تُولَدُ لِي أُزَوِّجُهُ إِيَّاهَا ، فَأَعْطَيْتُهُ رُمْحِي فَأَهْوَتْ عَنْهُ شَيْئًا ، ثُمَّ بَلَغَنِي أَنَّهُ وُلِدَ لَهُ ابْنَةٌ وَقَدْ بَلَغَتْ ، فَقُلْتُ : انْقُلْ إِلَيَّ أَهْلِي ، فَأَبَى إِلَّا بِصَدَاقٍ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : وَبِقَدْرِ أَيِّ النِّسَاءِ هِيَ ؟ قَالَ : قَدْ رَأَتِ  الْقَتِيرَ  ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرٌ لَكَ أَنْ لَا تَأْثَمَ وَلَا تُؤْثِمَ ، دَعْهَا عَنْكَ  .","","Al-Mu'jam al-Kabir 428","","كردم بن سفيان الثقفي عن ميمونة بنت كردم اليسارية عن سارة بنت مقسم الثقفية عن عبد الله بن يزيد بن مقسم ابن ضبة عن سلم بن قتيبة الشعيري عن عبد الرحمن بن المبارك الخلقاني عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","كردم بن سفيان الثقفي أبو ميمونة"
"17509","[19/191]      كَرْدَمُ بْنُ قَيْسٍ  429  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ وَأَبُو زَيْدٍ أَحْمَدُ بْنُ زَيْدٍ الْحَوْطِيُّ قَالَا :  ثَنَا  أَبُو الْيَمَانِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ الْعَزِيزِ بْنِ عُبَيْدِ اللهِ ،  عَنْ  جَعْفَرِ بْنِ عَمْرِو بْنِ أُمَيَّةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَمْرٍو قَالَ :  سَمِعْتُ  كَرْدَمَ بْنَ قَيْسٍ قَالَ :  خَرَجْتُ أَنَا وَابْنُ عَمٍّ لِي يُقَالُ لَهُ  أَبُو ثَعْلَبَةَ  فِي يَوْمٍ حَارٍّ وَعَلَيَّ حِذَاءٌ وَلَا حِذَاءَ لَهُ ، فَقَالَ : أَعْطِنِي نَعْلَكَ ، فَقُلْتُ : لَا ، إِلَّا أَنْ تُزَوِّجَنِي ابْنَتَكَ ، فَقَالَ : أَعْطِنِي فَقَدْ زَوَّجْتُكَهَا ، فَلَمَّا انْصَرَفْنَا بَعَثَ إِلَيَّ بِنَعْلَيَّ وَقَالَ : لَا زَوْجَةَ لَكَ عِنْدِي ، فَذَكَرْتُ ذَلِكَ لِلنَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  دَعْهَا ، وَلَا خَيْرَ لَكَ فِيهَا  ، فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي نَذَرْتُ لَأَنْحَرَنَّ ذَوْدًا مِنْ إِبِلِ ذَوْدِي مَكَانَ كَذَا وَكَذَا ! قَالَ : أَوْفِ بِنَذْرِكَ ، لَا نَذْرَ فِي قَطِيعَةِ رَحِمٍ وَلَا فِيمَا لَا يَمْلِكُ ابْنُ آدَمَ  .","","Al-Mu'jam al-Kabir 429","","كردم بن قيس الخشني عن إبراهيم بن عمرو عن جعفر بن عمرو بن أمية الضمري عن عبد العزيز بن عبيد الله بن حمزة الحمصي عن إسماعيل بن عياش الأحول عن أبو اليمان الحكم بن نافع عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","كردم بن قيس"
"17510","كَرْدَمُ بْنُ أَبِي السَّائِبِ  430  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَحْمَدُ بْنُ الْكُوفِيِّ ،  ثَنَا  الْقَاسِمُ بْنُ مَالِكٍ الْمُزَنِيُّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنْ  كَرْدَمِ بْنِ أَبِي السَّائِبِ ،         [19/192]      قَالَ :  خَرَجْتُ مَعَ أَبِي لِحَاجَةٍ مِنَ  الْمَدِينَةِ  نُرِيدُ  مَكَّةَ  ، وَذَلِكَ أَوَّلَ مَا ذُكِرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمَكَّةَ  ، فَأَتَى بِنَا إِلَى صَاحِبِ غَنَمٍ ، فَلَمَّا انْتَصَفَ اللَّيْلُ جَاءَ الذِّئْبُ فَأَخَذَ حَمَلًا مِنْ غَنَمِهِ ، فَوَثَبَ الرَّاعِي فَقَالَ :  يَا عَامِرَ الْوَادِي ، جَارَكَ !  قَالَ : فَسَمِعْنَا صَوْتًا لَا نَرَى صَاحِبَهُ : يَا سَرْحَانُ أَرْسِلْهُ ! قَالَ : فَجَاءَ الْحَمَلُ يَشْتَدُّ مَا بِهِ كَدْمَةٌ حَتَّى دَخَلَ فِي الْغَنَمِ ، قَالَ : وَأُنْزِلَ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ  بِالْمَدِينَةِ  :         {      وَأَنَّهُ كَانَ رِجَالٌ مِنَ الإِنْسِ يَعُوذُونَ بِرِجَالٍ مِنَ الْجِنِّ         }      الْآيَةَ  .","","Al-Mu'jam al-Kabir 430","","كردم بن قيس الخشني عن عبد الرحمن بن إسحاق بن سعد  الواسطي عن القاسم بن مالك المزني عن أحمد بن إشكاب الصفار عن يوسف بن يزيد القراطيسي عن الطبراني","كردم بن أبي السائب"
"17511","بَقِيَّةُ بَابِ الْكَافِ  مَنِ اسْمُهُ كَنَّازٌ  كَنَّازُ بْنُ حُصَيْنٍ ، أَبُو مَرْثَدٍ الْغَنَوِيُّ  431  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ فُسْتُقَةُ  ،  ثَنَا  الْحُسَيْنُ بْنُ عَلِيِّ بْنِ يَزِيدَ الصُّدَائِيُّ  ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ بْنِ سَعْدٍ  ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ إِسْحَاقَ  قَالَ :  أَبُو مَرْثَدٍ كَنَّازُ بْنُ حُصَيْنِ بْنِ يَرْبُوعَ بْنِ عَمْرَةَ بْنِ يَرْبُوعَ بْنِ خَرَشَةَ بْنِ سَعْدِ بْنِ طَرِيفِ بْنِ جِلَّانَ  - وَيُقَالُ : حِلَّانَ - بْنِ غَنِيِّ بْنِ يُعْصَرَ بْنِ سَعْدِ بْنِ قَيْسِ غَيْلَانَ بْنِ مُضَرَ  .","","Al-Mu'jam al-Kabir 431","","","كناز بن حصين أبو مرثد الغنوي"
"17512","432  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرٍو الْحَرَّانِيُّ  ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ، عَنْ  عُرْوَةَ  :  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَبُو مَرْثَدٍ الْغَنَوِيُّ  حَلِيفُ  حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ  ، مَاتَ  أَبُو مَرْثَدٍ  سَنَةَ اثْنَتَيْ عَشْرَةَ ، وَهُوَ ابْنُ سِتٍّ وَسِتِّينَ سَنَةً  .","","Al-Mu'jam al-Kabir 432","","","كناز بن حصين أبو مرثد الغنوي"
"17513","[19/193]      433  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ - قَالَا :  ثَنَا  صَدَقَةُ بْنُ خَالِدٍ - قَالَا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ جَابِرٍ ،  عَنْ  بُسْرِ بْنِ عُبَيْدِ اللهِ قَالَ :  سَمِعْتُ  وَاثِلَةَ بْنَ الْأَسْقَعِ يَقُولُ :  سَمِعْتُ  أَبَا مَرْثَدٍ الْغَنَوِيَّ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَجْلِسُوا عَلَى الْقُبُورِ وَلَا تُصَلُّوا إِلَيْهَا  .","","Al-Mu'jam al-Kabir 433","","كناز بن الحصين الغنوي عن واثلة بن الأسقع الليثي عن بسر بن عبيد الله الحضرمي عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","كناز بن حصين أبو مرثد الغنوي"
"17514","434  -  حَدَّثَنِي  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ (  ح  ) .  وَحَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ - قَالَا :  ثَنَا  ابْنُ الْمُبَارَكَ ،  ثَنَا  ابْنُ جَابِرٍ قَالَ :  سَمِعْتُ  بُسْرَ بْنَ عُبَيْدِ اللهِ  يُحَدِّثُ عَنْ  وَاثِلَةَ بْنِ الْأَسْقَعِ ،  عَنْ  أَبِي مَرْثَدٍ الْغَنَوِيِّ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَجْلِسُوا إِلَى الْقُبُورِ وَلَا تُصَلُّوا إِلَيْهَا  .","","Al-Mu'jam al-Kabir 434","","كناز بن الحصين الغنوي عن واثلة بن الأسقع الليثي عن بسر بن عبيد الله الحضرمي عن عبد الرحمن بن يزيد الداراني عن عبد الله بن المبارك عن العباس بن الوليد النرسي عن الساجي عن الطبراني","كناز بن حصين أبو مرثد الغنوي"
"17515","[19/194]      مَنِ اسْمُهُ كَهْمَسٌ  كَهْمَسٌ الْهِلَالِيُّ  435  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  حَمَّادُ بْنُ يَزِيدَ الْمِنْقَرِيُّ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ ،  عَنْ  كَهْمَسٍ الْهِلَالِيِّ قَالَ :  قَدِمْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَقَمْتُ عِنْدَهُ ثُمَّ خَرَجْتُ عَنْهُ ، فَأَتَيْتُهُ بَعْدَ حَوْلٍ فَقُلْتُ : يَا رَسُولَ اللهِ ، أَمَا تَعْرِفُنِي ؟ قَالَ : لَا ، قُلْتُ : أَنَا الَّذِي كُنْتُ عِنْدَكَ عَامَ أَوَّلٍ ! قَالَ : فَمَا غَيَّرَكَ بَعْدِي ؟ قَالَ : مَا أَكَلْتُ طَعَامًا بِنَهَارٍ مُنْذُ فَارَقْتُكَ ! قَالَ : فَمَنْ أَمَرَكَ بِتَعْذِيبِ نَفْسِكَ ؟ صُمْ يَوْمًا مِنَ السُّرَرِ . قُلْتُ : زِدْنِي ! فَزَادَنِي ، حَتَّى قَالَ :  صُمْ ثَلَاثَةَ أَيَّامٍ مِنَ  الشَّهْرِ  .","","Al-Mu'jam al-Kabir 435","","كهمس الهلالي عن معاوية بن قرة عن حماد بن يزيد بن مسلم المقرئ عن موسى بن إسماعيل التبوذكي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","كهمس الهلالي"
"17516","مَنِ اسْمُهُ كَيْسَانُ  كَيْسَانُ أَبُو عَبْدِ الرَّحْمَنِ مَوْلَى سَلَمَةَ بْنِ أُسَيْدٍ  436  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو عَوْنٍ الزِّيَادِيُّ ،  ثَنَا  عَمْرُو بْنُ كَثِيرِ بْنِ أَفْلَحَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ كَيْسَانَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ مِنَ  الْمَطَابِخِ  حَتَّى أَتَى بِئْرَ الصَّلَاةِ  وَهُوَ فِي إِزَارٍ مُلْتَحِفٌ بِهِ ، فَصَلَّى رَكْعَتَيِ  الظُّهْرِ أَوِ الْعَصْرِ  وَخَالَفَ بَيْنَ طَرَفَيْهِ  .","","Al-Mu'jam al-Kabir 436","","كيسان بن جرير القرشي عن عبد الرحمن بن كيسان القرشي عن عمرو بن كثير بن أفلح المكي عن محمد بن عون الزيادي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","كيسان أبو عبد الرحمن مولى سلمة بن أسيد"
"17517","[19/195]      437  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الشَّافِعِيُّ ،  حَدَّثَنِي  عَمِّي إِبْرَاهِيمُ بْنُ مُحَمَّدٍ ،  ثَنَا  مُحَمَّدُ بْنُ حَنْظَلَةَ ،  عَنْ  مَعْرُوفِ بْنِ مُشْكَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ كَيْسَانَ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي  بِبِئْرِ الْعُلْيَا  فِي ثَوْبٍ  .","","Al-Mu'jam al-Kabir 437","","كيسان بن جرير القرشي عن عبد الرحمن بن كيسان القرشي عن معروف بن مشكان الحجازي عن محمد بن حنظلة المخزومي عن إبراهيم بن محمد بن العباس المطلبي عن أحمد بن محمد ابن بنت الشافعى عن الطبراني","كيسان أبو عبد الرحمن مولى سلمة بن أسيد"
"17518","كَيْسَانُ ، أَبُو نَافِعٍ ، وَيُكَنَّى أَبَا رَافِعٍ  438  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  أَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  سُلَيْمَانَ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  نَافِعِ بْنِ كَيْسَانَ الدِّمَشْقِيِّ أَنَّ أَبَاهُ كَيْسَانَ  نَفْسَهُ  أَخْبَرَهُ  أَنَّهُ كَانَ يَتَّجِرُ فِي الْخَمْرِ فِي زَمَانِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَقْبَلَ مِنَ  الشَّامِ  وَمَعَهُ خَمْرٌ فِي الزِّقَاقِ يُرِيدُ بِهِ التِّجَارَةَ ، فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي جِئْتُ بِشَرَابٍ جَيِّدٍ ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  كَيْسَانُ ،  إِنَّهَا قَدْ حُرِّمَتْ  ! قَالَ  كَيْسَانُ  : فَأَذْهَبُ فَأَبِيعُهَا يَا نَبِيَّ اللهِ ؟ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّهَا قَدْ حُرِّمَتْ ، وَحَرَامٌ ثَمَنُهَا ! فَانْطَلَقَ  كَيْسَانُ  إِلَى الزِّقَاقِ فَأَخَذَهَا بِأَرْجُلِهَا ثُمَّ أَهَرَاقَهَا جَمِيعًا  .","","Al-Mu'jam al-Kabir 438","","كيسان بن عبد الله بن طارق الدمشقي عن نافع بن كيسان الثقفي عن سليمان بن عبد الرحمن الدمشقي عن عبد الله بن لهيعة عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","كيسان أبو نافع ويكنى أبا رافع"
"17519","[19/196]      439  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  أَبُو حَاتِمٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ بْنِ سِنَانٍ ،  ثَنَا  أَبِي يَزِيدُ ،  ثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  حَدَّثَنِي  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ الْفَدَكِيُّ ،  أَخْبَرَنِي  مُحَمَّدُ بْنُ عَبْدِ اللهِ الطَّائِفِيُّ أَنَّ نَافِعَ بْنَ كَيْسَانَ  أَخْبَرَهُ  أَنَّ  أَبَاهُ  حَمَلَ خَمْرًا إِلَى  الْمَدِينَةِ  قَبْلَ أَنْ يُحَرِّمَهَا النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَجَاءَهُ فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا حَمَلْتَ يَا  أَبَا رَافِعٍ  ؟  قَالَ : خَمْرًا يَا رَسُولَ اللهِ . قَالَ : أَمَا تَعْرِفُ أَنَّهَا قَدْ حُرِّمَتْ بَعْدَكَ ؟ قَالَ : أَمَا أَبِيعُهَا الْيَهُودَ ؟ قَالَ : إِنَّ بَائِعَهَا كَشَارِبِهَا ! فَشَقَّ  أَبُو رَافِعٍ  زِقَاقَهُ  بِالْبَطْحَاءِ  .","","Al-Mu'jam al-Kabir 439","","كيسان بن عبد الله بن طارق الدمشقي عن نافع بن كيسان الثقفي عن محمد بن عبد الله بن عياض الطائفي عن إسماعيل بن أبي خالد الفدكي عن يحيى بن أبي كثير عن يزيد بن سنان الرهاوي عن محمد بن يزيد بن سنان بن يزيد الرهاوي عن أبو حاتم الرازي عن أحمد بن يحيى بن زهير التستري عن الطبراني","كيسان أبو نافع ويكنى أبا رافع"
"17520","440  -  حَدَّثَنَا  عَبْدَانُ بْنُ أَحْمَدَ  ، ثَنَا  هِشَامُ بْنُ أَبِي خَالِدٍ  ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  رَبِيعَةُ بْنُ يَزِيدَ ،  عَنْ  نَافِعِ بْنِ كَيْسَانَ ،  عَنْ  أَبِيهِ  قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَنْزِلُ  عِيسَى ابْنُ مَرْيَمَ  - عَلَيْهِ السَّلَامُ - عِنْدَ  الْمَنَارَةِ الْبَيْضَاءِ  فِي  دِمَشْقَ  .  كذا في طبعة مكتبة ابن تيمية ، ونسخة أحمد الثالث ، والصواب : ( هشام بن خالد ) وينظر ترجمته في التهذيبين وغيرهما . والله أعلم.","","Al-Mu'jam al-Kabir 440","","كيسان بن جرير القرشي عن نافع بن كيسان الثقفي عن ربيعة بن يزيد القصير عن الوليد بن مسلم القرشي عن هشام بن خالد السلامي عن عبد الله بن أحمد الجواليقي عن الطبراني","كيسان أبو نافع ويكنى أبا رافع"
"17521","[19/197]      مَنِ اسْمُهُ كَدَنٌ  كَدَنُ بْنُ عَبْدٍ الْعَكِّيُّ  441  -  حَدَّثَنَا  يَحْيَى بْنُ عَبْدِ الْبَاقِي  ، ثَنَا  الْحَسَنُ بْنُ مُوسَى الرَّمْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ فِهْرِ بْنِ جَمِيلِ بْنِ أَبِي كَرِيمٍ الْعَكِّيِّ مِنْ  أَهْلِ يَافَا  ،  حَدَّثَنِي  أُمَيَّةُ وَلِفَافٌ ابْنَا الْمُفَضَّلِ بْنِ أَبِي كَرِيمِ بْنِ لِفَافِ بْنِ كَدَنٍ ،  عَنْ  أَبِيهِمَا ،  عَنْ  جَدِّهِمَا ،  عَنْ  لِفَافِ بْنِ كَدَنٍ ،  عَنْ  أَبِيهِ كَدَنِ بْنِ عَبْدٍ  قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الْيَمَنِ  فَبَايَعْتُهُ وَأَسْلَمْتُ عَلَى يَدِهِ  .","","Al-Mu'jam al-Kabir 441","","كدن بن عبد العكي عن لفاف بن كدن عن أبو كريم بن لفاف عن المفضل بن أبي كريم بن لفاف عن لفاف بن المفضل عن محمد بن فهر بن جميل بن أبي كريم العكي عن الحسن بن موسى الرملي عن يحيى بن عبد الباقي الثغري عن الطبراني","كدن بن عبد العكي"
"17522","مَنِ اسْمُهُ كُرْزٌ  كُرْزُ بْنُ عَلْقَمَةَ الْخُزَاعِيُّ ،  كَانَ يَنْزِلُ  الْمَدِينَةَ  442  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  كُرْزِ بْنِ عَلْقَمَةَ الْخُزَاعِيِّ قَالَ :  قَالَ  أَعْرَابِيٌّ  : يَا رَسُولَ اللهِ ، هَلْ لِلْإِسْلَامِ مُنْتَهًى ؟ قَالَ : نَعَمْ ،  أَيُّمَا أَهْلِ بَيْتٍ مِنَ الْعَرَبِ أَوِ الْعَجَمِ أَرَادَ اللهُ بِهِمْ خَيْرًا أَدْخَلَ عَلَيْهِمُ الْإِسْلَامَ .  قَالَ : ثُمَّ مَاذَا يَا رَسُولَ اللهِ ؟ قَالَ : ثُمَّ تَقَعُ فِتَنٌ كَأَنَّهَا اللَّيْلُ . قَالَ : فَقَالَ الْأَعْرَابِيُّ :  كَلَّا  يَا رَسُولَ اللهِ ! فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : كَلَّا ، وَالَّذِي نَفْسِي بِيَدِهِ لَيَقُودُنَّ فِيهَا  أَسَاوِدَ  صُبًّا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .         [19/198]","","Al-Mu'jam al-Kabir 442","","كرز بن علقمة بن هلال الخزاعي عن عروة بن الزبير عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","كرز بن علقمة الخزاعي"
"17523","443  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  الْحُمَيْدِيُّ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ بَشَّارٍ الرَّمَادِيُّ - قَالُوا :  ثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  كُرْزِ بْنِ عَلْقَمَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَحْوَهُ .","","Al-Mu'jam al-Kabir 443","","كرز بن علقمة بن هلال الخزاعي عن عروة بن الزبير عن الزهري عن سفيان بن عيينة عن إبراهيم بن بشار الرمادى عن أبو مسلم الكجي عن الطبراني","كرز بن علقمة الخزاعي"
"17524","444  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ خَالِدِ بْنِ مُسَافِرٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ  أَنَّ  كُرْزَ بْنَ عَلْقَمَةَ الْخُزَاعِيَّ قَالَ :  بَيْنَمَا أَنَا جَالِسٌ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ جَاءَهُ  رَجُلٌ مِنَ الْأَعْرَابِ  فَقَالَ : يَا رَسُولَ اللهِ ، هَلْ لِلْإِسْلَامِ مُنْتَهًى ؟ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : نَعَمْ ،  أَيُّمَا أَهْلِ بَيْتٍ مِنَ الْعَرَبِ أَوِ الْعَجَمِ أَرَادَ اللهُ بِهِمْ خَيْرًا أَدْخَلَ عَلَيْهِمُ الْإِسْلَامَ  . قَالَ الْأَعْرَابِيُّ : ثُمَّ مَاذَا يَا رَسُولَ اللهِ ؟ قَالَ : ثُمَّ تَقَعُ الْفِتَنُ كَأَنَّهَا  الظُّلَلُ  . قَالَ الْأَعْرَابِيُّ :  كَلَّا  يَا رَسُولَ اللهِ ! قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : وَالَّذِي نَفْسِي بِيَدِهِ لَتَعُودُنَّ فِيهَا  أَسَاوِدَ  صُبًّا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .","","Al-Mu'jam al-Kabir 444","","كرز بن علقمة بن هلال الخزاعي عن عروة بن الزبير عن الزهري عن عبد الرحمن بن خالد بن مسافر الفهمي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","كرز بن علقمة الخزاعي"
"17525","445  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  الْهِقْلُ بْنُ زِيَادٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ يَحْيَى ،  حَدَّثَنِي  الزُّهْرِيُّ ،  حَدَّثَنِي  عُرْوَةُ بْنُ الزُّبَيْرِ  أَنَّ  كُرْزَ بْنَ عَلْقَمَةَ الْخُزَاعِيَّ قَالَ :  بَيْنَمَا أَنَا جَالِسٌ عِنْدَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ جَاءَهُ  رَجُلٌ مِنْ أَعْرَابِ نَجْدٍ  ، قَالَ : يَا رَسُولَ اللهِ ، هَلْ لِلْإِسْلَامِ مُنْتَهًى ؟ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : نَعَمْ ،         [19/199]      أَيُّمَا أَهْلِ بَيْتٍ مِنَ الْعَرَبِ أَوِ الْعَجَمِ أَرَادَ اللهُ بِهِمْ خَيْرًا أَدْخَلَ عَلَيْهِمُ الْإِسْلَامَ  . قَالَ الْأَعْرَابِيُّ : ثُمَّ مَاذَا يَا رَسُولَ اللهِ ؟ قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : ثُمَّ تَقَعُ الْفِتَنُ كَأَنَّهَا  الظُّلَلُ  . قَالَ الْأَعْرَابِيُّ :  كَلَّا  يَا رَسُولَ اللهِ ! قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : وَالَّذِي نَفْسِي بِيَدِهِ تَعُودُونَ فِيهَا  أَسَاوِدَ  صُبًّا  يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ  .","","Al-Mu'jam al-Kabir 445","","كرز بن علقمة بن هلال الخزاعي عن عروة بن الزبير عن الزهري عن معاوية بن يحيى الصدفي عن هقل بن زياد السكسكي عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","كرز بن علقمة الخزاعي"
"17526","446  -  حَدَّثَنَا  أَحْمَدُ بْنُ طَاهِرِ بْنِ حَرْمَلَةَ بْنِ يَحْيَى ،  حَدَّثَنِي  جَدِّي حَرْمَلَةُ بْنُ يَحْيَى  ،  حَدَّثَنِي  إِدْرِيسُ بْنُ يَحْيَى الْخَوْلَانِيُّ ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ ،  عَنْ  عُقَيْلٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ ،  عَنْ  كُرْزٍ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 446","","كرز بن علقمة بن هلال الخزاعي عن عروة بن الزبير عن الزهري عن عقيل بن خالد الأيلي عن حيوة بن شريح التجيبي عن إدريس بن يحيى الخولاني عن حرملة بن يحيى التجيبي عن أحمد بن طاهر بن حرملة التجيبي عن الطبراني","كرز بن علقمة الخزاعي"
"17527","كُرْزُ بْنُ جَابِرٍ الْقُرَشِيُّ ثُمَّ الْفِهْرِيُّ  اسْتُشْهِدَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الْفَتْحِ  447  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ، عَنْ  عُرْوَةَ  :  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ الْفَتْحِ  مِنَ الْمُسْلِمِينَ مِنْ  قُرَيْشٍ  ثُمَّ مِنْ  بَنِي مُحَارِبِ بْنِ فِهْرٍ  ،  كُرْزُ بْنُ جَابِرٍ  .","","Al-Mu'jam al-Kabir 447","","","كرز بن جابر القرشي الفهري"
"17528","مَنِ اسْمُهُ كُلَيْبٌ  كُلَيْبُ بْنُ شِهَابِ بْنِ مَحْبُوبٍ الْجَرْمِيُّ ، أَبُو عَاصِمٍ  448  -  حَدَّثَنَا  بَكْرُ بْنُ مُقْبِلٍ الْبَصْرِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ وَهْبٍ الْكُوفِيُّ ،         [19/200]      ثَنَا  قُطْبَةُ بْنُ الْعَلَاءِ الْغَنَوِيُّ ،  ثَنَا  أَبِي الْعَلَاءُ بْنُ الْمِنْهَالِ ،  عَنْ  عَاصِمِ بْنِ كُلَيْبٍ الْجَرْمِيِّ ،  عَنْ  أَبِيهِ  أَنَّهُ خَرَجَ مَعَ أَبِيهِ إِلَى جِنَازَةٍ شَهِدَهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا غُلَامٌ أَعْقِلُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يُحِبُّ اللهُ لِلْعَامِلِ إِذَا عَمِلَ أَنْ يُحْسِنَ  .","","Al-Mu'jam al-Kabir 448","","كليب بن شهاب القضاعي عن عاصم بن كليب الجرمي عن العلاء بن المنهال العنبري عن قطبة بن العلاء الغنوي عن القاسم بن وهب بن جامع عن بكر بن أحمد بن مقبل الهاشمي عن الطبراني","كليب بن شهاب بن محبوب الجرمي"
"17529","كُلَيْبُ بْنُ حَزْنٍ  449  -  حَدَّثَنَا  سَلَامَةُ بْنُ نَاهِضٍ الْمَقْدِسِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ زُرَارَةَ الرَّقِّيُّ ،  ثَنَا  يَعْلَى بْنُ الْأَشْدَقِ ،  عَنْ  كُلَيْبِ بْنِ حَزْنٍ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَا قَوْمُ ، اطْلُبُوا الْجَنَّةَ  جَهْدَكُمْ  ، وَاهْرُبُوا مِنَ النَّارِ  جَهْدَكُمْ  ، فَإِنَّ الْجَنَّةَ لَا يَنَامُ طَالِبُهَا ، وَإِنَّ النَّارَ لَا يَنَامُ هَارِبُهَا ، أَلَا إِنَّ الْآخِرَةَ الْيَوْمَ مُحَفَّفَةٌ بِالْمَكَارِهِ ، وَإِنَّ الدُّنْيَا مُحَفَّفَةٌ بِالشَّهَوَاتِ  .","","Al-Mu'jam al-Kabir 449","","كليب بن حزن العقيلي عن يعلى بن الأشدق عن إسماعيل بن عبد الله بن زرارة الثغري عن سلام بن محمد بن ناهض الترياقي عن الطبراني","كليب بن حزن"
"17530","كُلَيْبٌ الْجُهَنِيُّ  450  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْأَزْدِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُنِيبٍ ،  عَنْ  غُنَيْمِ بْنِ كَثِيرِ بْنِ كُلَيْبٍ الْجُهَنِيِّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  -  وَكَانَتْ لَهُ صُحْبَةٌ  - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْأَكْبَرُ مِنَ الْإِخْوَةِ بِمَنْزِلَةِ الْأَبِ  .","","Al-Mu'jam al-Kabir 450","","كليب الجهني عن كثير بن كليب الحضرمي عن عثيم بن كثير بن كليب الحضرمي عن عبد الله بن المنيب الأنصاري عن الواقدي عن محمد بن يحيى بن أبي حاتم عن محمد بن صالح النرسي عن الطبراني","كليب الجهني"
"17531","بَابُ اللَّامِ  مَنِ اسْمُهُ  لَقِيطٌ  لَقِيطُ بْنُ الرَّبِيعِ بْنِ عَبْدِ الْعُزَّى بْنِ عَبْدِ شَمْسِ بْنِ عَبْدِ مَنَافٍ  أَبُو الْعَاصِ ،  صِهْرُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، وَقَدِ اخْتُلِفَ فِي         [19/201]      اسْمِهِ ؛ فَقِيلَ  مِهْشَمٌ  ، وَقِيلَ  الْقَاسِمُ  .  451  -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَحْمَدَ الْخُزَاعِيُّ  ،  ثَنَا  الزُّبَيْرُ بْنُ بَكَّارٍ  قَالَ :  أَبُو الْعَاصِ بْنُ الرَّبِيعِ  زَوْجُ بِنْتِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَابْنُ خَالَتِهَا  ، أُمُّهُ  هَالَةُ بِنْتُ خُوَيْلِدِ بْنِ أَسَدِ بْنِ عَبْدِ الْعُزَّى بْنِ قُصَيٍّ  أُخْتُ  خَدِيجَةَ بِنْتِ خُوَيْلِدٍ  لِأَبِيهَا ، وَأُمُّهَا  فَاطِمَةُ بِنْتُ زَائِدَةَ ،  وَهُوَ  الْأَصَمُّ بْنُ جُنْدُبِ بْنِ هَرِمِ بْنِ رَوَاحَةَ بْنِ حُجْرِ بْنِ عَبْدِ بْنِ مَعِيصِ بْنِ عَامِرِ بْنِ لُؤَيٍّ ،  وَيُقَالُ اسْمُ  أَبِي الْعَاصِ بْنِ الرَّبِيعِ مِهْشَمٌ ،  وَكَانَ يُسَمَّى  جَرْوَ الْبَطْحَاءِ  ، قَالَ  الزُّبَيْرُ  :  وَحَدَّثَنِي  مُحَمَّدُ بْنُ الْحَسَنِ  وَيَحْيَى بْنُ مُحَمَّدٍ  قَالَا :  اسْمُ  أَبِي الْعَاصِ بْنِ الرَّبِيعِ لَقِيطٌ  ، قَالَ  الزُّبَيْرُ  :  وَحَدَّثَنِي  مُحَمَّدُ بْنُ الضَّحَّاكِ  ،  عَنْ  أَبِيهِ  قَالَ :  اسْمُ  أَبِي الْعَاصِ بْنِ الرَّبِيعِ الْقَاسِمُ  ، وَذَلِكَ الثَّبْتُ فِي اسْمِهِ ، وَتُوُفِّيَ  أَبُو الْعَاصِ بْنُ الرَّبِيعِ  فِي ذِي الْحَجَّةِ سَنَةَ اثْنَتَيْ عَشْرَةَ  .","","Al-Mu'jam al-Kabir 451","","","لقيط بن الربيع بن عبد العزى بن عبد شمس بن عبد مناف أبو العاص"
"17532","452  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  جَابِرٍ ،  عَنِ  الشَّعْبِيِّ  أَنَّ  زَيْنَبَ بِنْتَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَسْلَمَتْ وَزَوْجُهَا مُشْرِكٌ  أَبُو الْعَاصِ بْنُ الرَّبِيعِ ، ثُمَّ أَسْلَمَ بَعْدَ ذَلِكَ بِحِينٍ فَلَمْ يُجَدِّدْ نِكَاحًا  .  قَالَ  عَبْدُ الرَّزَّاقِ  : وَذَكَرَ مَعْمَرٌ ، عَنْ  جَابِرٍ  ، عَنِ  الشَّعْبِيِّ  .","","Al-Mu'jam al-Kabir 452","","جرو البطحاء أبو العاص بن الربيع عن الشعبي عن جابر الجعفي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","لقيط بن الربيع بن عبد العزى بن عبد شمس بن عبد مناف أبو العاص"
"17533","453  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ دِينَارٍ أَنَّ حَسَنَ بْنَ مُحَمَّدٍ  أَخْبَرَهُ  أَنَّ  أَبَا الْعَاصِ بْنَ الرَّبِيعِ         [19/202]      بْنِ عَبْدِ الْعُزَّى بْنِ عَبْدِ شَمْسِ بْنِ عَبْدِ مَنَافٍ  ، وَكَانَ تَزَوَّجَ بِنْتَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجِيءَ بِهِ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْفِدَاءِ  فَجَاءَتْهُ  زَيْنَبُ  ، قَالَ  عَمْرٌو  :  وَلَا أَظُنُّهُمَا إِلَّا أُقِرَّا عَلَى نِكَاحِهِمَا فِي الْجَاهِلِيَّةِ  .","","Al-Mu'jam al-Kabir 453","","الحسن بن محمد بن علي بن أبي طالب عن عمرو بن دينار الأثرم عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","لقيط بن الربيع بن عبد العزى بن عبد شمس بن عبد مناف أبو العاص"
"17534","454  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  إِبْرَاهِيمَ بْنِ مُحَمَّدٍ ،  عَنْ  دَاوُدَ بْنِ الْحُصَيْنِ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  أَسْلَمَتْ  زَيْنَبُ بِنْتُ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَزَوْجُهَا  أَبُو الْعَاصِ بْنُ الرَّبِيعِ  مُشْرِكٌ  ، ثُمَّ أَسْلَمَ بَعْدَ ذَلِكَ فَأَقَرَّهُمَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى نِكَاحِهِمَا  .","","Al-Mu'jam al-Kabir 454","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن داود بن الحصين الأموي عن إبراهيم بن محمد بن أبي يحيى عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","لقيط بن الربيع بن عبد العزى بن عبد شمس بن عبد مناف أبو العاص"
"17535","455  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  دَاوُدَ بْنِ الْحُصَيْنِ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  رَدَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  أَبِي الْعَاصِ  زَيْنَبَ  بِالنِّكَاحِ الْأَوَّلِ  وَلَمْ يُحْدِثْ شَيْئًا  .  وَقَدِ اخْتُلِفَ فِي ذَلِكَ وَقَالُوا : بِنِكَاحٍ جَدِيدٍ  .","","Al-Mu'jam al-Kabir 455","","عبد الله بن عباس عن عكرمة مولى ابن عباس عن داود بن الحصين الأموي عن محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","لقيط بن الربيع بن عبد العزى بن عبد شمس بن عبد مناف أبو العاص"
"17536","456  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  حُمَيْدٍ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَأَةَ ،  عَنْ  عَمْرِو بْنِ شُعَيْبٍ ،  عَنْ  أَبِيهِ ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرٍو  قَالَ :  أَسْلَمَتْ  زَيْنَبُ بِنْتُ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَبْلَ زَوْجِهَا  أَبِي الْعَاصِ         [19/203]      بْنِ الرَّبِيعِ  بِسَنَةٍ  ، ثُمَّ أَسْلَمَ فَرَدَّهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِنِكَاحٍ مِنْ جَدِيدٍ  .","","Al-Mu'jam al-Kabir 456","","عبد الله بن عمرو بن العاص عن شعيب بن محمد السهمي عن عمرو بن شعيب عن حجاج بن أرطاة عن حميد بن رويمان عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","لقيط بن الربيع بن عبد العزى بن عبد شمس بن عبد مناف أبو العاص"
"17537","لَقِيطُ بْنُ عَامِرٍ ، أَبُو رَزِينٍ الْعُقَيْلِيُّ  عَمْرُو بْنُ أَوْسٍ الثَّقَفِيُّ  عَنْ  أَبِي رَزِينٍ  .  457  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ وَحَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ - قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ ،  عَنْ  أَبِي رَزِينٍ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ أَبِي شَيْخٌ لَا يَسْتَطِيعُ  الْحَجَّ  وَالْعُمْرَةَ وَلَا الظَّعْنَ ! قَالَ :  حُجَّ عَنْ أَبِيكَ وَاعْتَمِرْ  -  وَاللَّفْظُ لِحَدِيثِ  عَلِيِّ بْنِ عَبْدِ الْعَزِيزِ  .","","Al-Mu'jam al-Kabir 457","","لقيط بن صبرة العقيلي عن عمرو بن أوس بن أبي أوس الثقفي عن النعمان بن سالم الطائفي عن شعبة بن الحجاج عن سليمان بن حرب الواشحي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","عمرو بن أوس الثقفي عن أبي رزين"
"17538","458  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ الْعَلَاءِ بْنِ زِبْرِيقٍ الْحِمْصِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  شُعْبَةَ بْنِ الْحَجَّاجِ ،  عَنِ  النُّعْمَانِ بْنِ سَالِمٍ ،  عَنْ  عَمْرِو بْنِ أَوْسٍ ،  عَنْ  أَبِي رَزِينٍ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ أَبِي شَيْخٌ كَبِيرٌ لَا يَسْتَطِيعُ  الْحَجَّ  وَالْعُمْرَةَ وَلَا الظَّعْنَ ! قَالَ  : حُجَّ عَنْ أَبِيكَ وَاعْتَمِرْ  .","","Al-Mu'jam al-Kabir 458","","لقيط بن صبرة العقيلي عن عمرو بن أوس بن أبي أوس الثقفي عن النعمان بن سالم الطائفي عن شعبة بن الحجاج عن محمد بن إسحاق عن إسماعيل بن عياش الأحول عن محمد بن إسماعيل بن عياش العنسي عن عمرو بن إسحاق بن إبراهيم الزبيدي عن الطبراني","عمرو بن أوس الثقفي عن أبي رزين"
"17539","[19/204]      وَكِيعُ بْنُ حُدُسٍ - وَيُقَالُ عُدُسٌ  - عَنْ  أَبِي رَزِينٍ  459  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  حَجَّاجُ بْنُ نُصَيْرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ قَالَ :  سَمِعْتُ  وَكِيعَ بْنَ عُدُسٍ  يُحَدِّثُ عَنْ  عَمِّهِ أَبِي رَزِينٍ الْعُقَيْلِيِّ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَثَلُ الْمُؤْمِنِ مَثَلُ  النَّحْلَةِ  ؛  لَا تَأْكُلُ إِلَّا طَيِّبًا ، وَلَا تَضَعُ إِلَّا طَيِّبًا  .","","Al-Mu'jam al-Kabir 459","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن حجاج بن نصير الفساطيطي عن أبو مسلم الكجي عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17540","460  -  حَدَّثَنَا  حَجَّاجُ بْنُ عِمْرَانَ السَّدُوسِيُّ  ، ثَنَا  أَبُو سَلَمَةَ يَحْيَى بْنُ خَلَفٍ الْجُوبَارِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ ،  عَنْ  شُعْبَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ عُدُسٍ  يُحَدِّثُ عَنْ  أَبِي رَزِينٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَثَلُ الْمُؤْمِنِ مَثَلُ  النَّحْلَةِ  ؛  لَا يَأْكُلُ إِلَّا طَيِّبًا ، وَلَا يَضَعُ إِلَّا طَيِّبًا  .","","Al-Mu'jam al-Kabir 460","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن محمد بن إبراهيم بن أبي عدي القسملي عن يحيى بن خلف الجوباري عن حجاج بن عمران السدوسي عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17541","461  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ ،  أَنَا  شُعْبَةُ وَهُشَيْمٌ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ عُدُسٍ ،  عَنْ  عَمِّهِ أَبِي رَزِينٍ         [19/205]      الْعُقَيْلِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الرُّؤْيَا  جُزْءٌ  مِنْ  أَرْبَعِينَ  جُزْءًا  - أَوْ سِتَّةٍ وَأَرْبَعِينَ  جُزْءًا  -  مِنَ النُّبُوَّةِ  ، وَهِيَ عَلَى رِجْلِ طَائِرٍ ، فَإِذَا عُبِرَتْ وَقَعَتْ . قَالَ  شُعْبَةُ  فِي حَدِيثِهِ :  وَأَحْسَبُهُ قَالَ : لَا  يَقُصُّهَا  إِلَّا عَلَى وَادٍّ أَوْ ذِي رَأْيٍ  .","","Al-Mu'jam al-Kabir 461","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن هشيم بن بشير عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17542","462  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  غُنْدَرٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ عُدُسٍ ،  عَنْ  عَمِّهِ أَبِي رَزِينٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  رُؤْيَا الْمُؤْمِنِ  جُزْءٌ  مِنْ أَرْبَعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ  ، وَهِيَ عَلَى رِجْلِ طَائِرٍ مَا لَمْ يُحَدِّثْ ، فَإِذَا حَدَّثَ بِهَا وَقَعَتْ  .","","Al-Mu'jam al-Kabir 462","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17543","463  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  إِبْرَاهِيمُ بْنُ         [19/206]      الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ حُدُسٍ ،  عَنْ  عَمِّهِ أَبِي رَزِينٍ الْعُقَيْلِيِّ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الرُّؤْيَا  جُزْءٌ  مِنْ سِتَّةٍ وَأَرْبَعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ  ، وَالرُّؤْيَا مُعَلَّقَةٌ بِرِجْلِ طَائِرٍ حَتَّى يُحَدِّثَ بِهَا صَاحِبُهَا ، فَإِذَا حَدَّثَ بِهَا وَقَعَتْ ، فَلَا يُحَدِّثْ بِهَا إِلَّا عَالِمًا أَوْ نَاصِحًا أَوْ حَبِيبًا  .","","Al-Mu'jam al-Kabir 463","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن عبد الله بن أحمد بن حنبل عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17544","464  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ عُدُسٍ الْعُقَيْلِيِّ ،  عَنْ  عَمِّهِ أَبِي رَزِينٍ الْعُقَيْلِيِّ أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الرُّؤْيَا عَلَى  رِجْلِ  طَائِرٍ  مَا لَمْ تُعْبَرْ ، فَإِذَا عُبِرَتْ وَقَعَتْ  .  وَقَالَ : الرُّؤْيَا  جُزْءٌ  مِنْ سِتَّةٍ وَأَرْبَعِينَ  جُزْءًا  مِنَ النُّبُوَّةِ ،  وَأَحْسَبُهُ قَالَ : وَلَا  يَقُصُّهَا  إِلَّا عَلَى وَادٍّ أَوْ ذِي رَأْيٍ  .","","Al-Mu'jam al-Kabir 464","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن هشيم بن بشير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17545","465  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  أَسَدُ بْنُ مُوسَى قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ حُدُسٍ ،  عَنْ  أَبِي رَزِينٍ قَالَ :  قُلْنَا : يَا رَسُولَ اللهِ ، أَكُلُّنَا يَرَى رَبَّهُ يَوْمَ الْقِيَامَةِ ؟ وَمَا آيَةُ ذَلِكَ فِي خَلْقِهِ ؟ قَالَ :  أَلَيْسَ كُلُّكُمْ يَرَى الْقَمَرَ مُجْلِيًّا بِهِ ؟  قُلْتُ : نَعَمْ . قَالَ : فَاللهُ أَعْظَمُ  .","","Al-Mu'jam al-Kabir 465","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن حماد بن سلمة عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17546","466  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي  ، ثَنَا  عُقْبَةُ بْنُ مُكْرَمٍ         [19/207]      الْعَمِّيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي عَدِيٍّ - كِلَاهُمَا  عَنْ  شُعْبَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ عُدُسٍ ،  عَنْ  أَبِي رَزِينٍ الْعُقَيْلِيِّ قَالَ :  قُلْتُ : يَا نَبِيَّ اللهِ ، أَكُلُّنَا نَرَى رَبَّنَا ؟ قَالَ : نَعَمْ ، قُلْتُ : وَمَا آيَةُ ذَلِكَ فِي خَلْقِهِ ؟ قَالَ :  أَلَيْسَ كُلُّكُمْ يَنْظُرُ إِلَى الْقَمَرِ لَيْلَةَ الْبَدْرِ ؟ وَإِنَّمَا هُوَ خَلْقٌ مِنْ خَلْقِ اللهِ ، وَاللهُ أَعْظَمُ وَأَجَلُّ  .","","Al-Mu'jam al-Kabir 466","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن محمد بن إبراهيم بن أبي عدي القسملي عن عقبة بن مكرم عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17547","467  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُعَلَّى بْنُ مَهْدِيٍّ الْمَوْصِلِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ حُدُسٍ ،  عَنْ  عَمِّهِ أَبِي رَزِينٍ - وَهُوَ لَقِيطُ بْنُ عَامِرٍ - أَنَّهُ قَالَ :  إِنَّا كُنَّا نَذْبَحُ فِي رَجَبٍ ذَبَائِحَ فَنَأْكُلُ مِنْهَا وَنُطْعِمُ ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَا بَأْسَ بِذَلِكَ  . وَقَالَ  وَكِيعٌ  :  لَا أَدَعُهَا أَبَدًا  .","","Al-Mu'jam al-Kabir 467","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن الوضاح بن عبد الله اليشكري عن معلى بن مهدي الموصلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17548","468  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ (  ح  ) .  وَحَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى - قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ حُدُسٍ ،  عَنْ  عَمِّهِ أَبِي رَزِينٍ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، أَيْنَ كَانَ رَبُّنَا قَبْلَ أَنْ يَخْلُقَ السَّمَاءَ وَالْأَرْضَ ؟ قَالَ : كَانَ فِي  عَمَاءٍ  مَا تَحْتَهُ هَوَاءٌ وَمَا فَوْقَهُ هَوَاءٌ  ، ثُمَّ خَلَقَ عَرْشَهُ عَلَى الْمَاءِ  .","","Al-Mu'jam al-Kabir 468","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن حماد بن سلمة عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17549","469  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ حُدُسٍ ،  عَنْ  أَبِي رَزِينٍ أَنَّ         [19/208]      رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ضَحِكَ اللهُ - تَعَالَى - مِنْ قُنُوطِ عِبَادِهِ وَقُرْبِ غَيْرِهِ  ، قَالَ  أَبُو رَزِينٍ  فَقُلْتُ : يَا رَسُولَ اللهِ ، وَيَضْحَكُ الرَّبُّ ؟ قَالَ : نَعَمْ . قَالَ : لَنْ نَعْدَمَ مِنْ رَبٍّ يَضْحَكُ خَيْرًا  .","","Al-Mu'jam al-Kabir 469","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17550","470  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ - قَالَا :  ثَنَا  غُنْدَرٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ عُدُسٍ ،  عَنْ  عَمِّهِ أَبِي رَزِينٍ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، كَيْفَ يُحْيِي اللهُ الْمَوْتَى ؟ قَالَ : أَوَمَا مَرَرْتَ بِوَادِي قَوْمِكَ قَحْلًا ثُمَّ مَرَرْتَ بِهِ خَضْرَاءَ  ، ثُمَّ مَرَرْتَ بِهِ قَحْلًا ثُمَّ مَرَرْتَ بِهِ خَضْرَاءَ ؟ كَذَلِكَ يُحْيِي اللهُ الْمَوْتَى  .","","Al-Mu'jam al-Kabir 470","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17551","471  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ - قَالَا :  ثَنَا  غُنْدَرٌ ،  عَنْ  شُعْبَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ  وَكِيعِ بْنِ عُدُسٍ ،  عَنْ  أَبِي رَزِينٍ قَالَ :  قُلْتَ : يَا رَسُولَ اللهِ ، أَيْنَ أُمِّي ؟ قَالَ : أُمُّكَ فِي النَّارِ !  قَالَ : فَأَيْنَ مَنْ مَضَى مِنْ أَهْلِكَ ؟ قَالَ : أَمَا تَرْضَى أَنْ تَكُونَ أُمُّكَ مَعَ أُمِّي . ؟","","Al-Mu'jam al-Kabir 471","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17552","472  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  مُؤَمَّلُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  يَعْلَى بْنِ عَطَاءٍ ،  عَنْ         [19/209]      وَكِيعِ بْنِ عُدُسٍ ،  عَنْ  عَمِّهِ أَبِي رَزِينٍ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَكْرَهُ  الْمَسَائِلَ  وَيَعِيبُهَا  ، فَإِذَا سَأَلَهُ  أَبُو رَزِينٍ  أَجَابَهُ وَأَعْجَبَهُ ذَلِكَ  .","","Al-Mu'jam al-Kabir 472","","لقيط بن صبرة العقيلي عن وكيع بن عدس العقيلي عن يعلى بن عطاء الطائفي عن حماد بن سلمة عن مؤمل بن إسماعيل العدوي عن أبو موسى الزمن عن محمد بن صالح النرسي عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17553","473  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْمُؤَدِّبُ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ الْمُنْذِرِ الْقَزَّازُ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ  ، ثَنَا  عَلِيُّ بْنُ الْجَعْدِ - قَالُوا :  ثَنَا  هَمَّامُ بْنُ يَحْيَى ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ الْيَشْكُرِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  قَدِمْتُ  الْكُوفَةَ  وَصَاحِبٌ لِي لِنَجْلِبَ مِنْهَا نِعَالًا ، فَغَدَوْنَا إِلَى السُّوقِ وَلَمْ يَقُمْ بَعْدُ ، فَقُلْتُ لِصَاحِبِي : لَوْ دَخَلْنَا الْمَسْجِدَ ، وَالْمَسْجِدُ يَوْمَئِذٍ فِي أَصْحَابِ التَّمْرِ ، فَدَخَلْنَا فَإِذَا رَجُلٌ مِنْ  قَيْسٍ  يُقَالُ لَهُ ابْنُ الْمُنْتَفِقِ ، فَسَمِعْتُهُ يَقُولُ : وُصِفَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَجُلِّيَ لِي ، فَطَلَبْتُهُ  بِمَكَّةَ  فَقِيلَ لِي هُوَ  بِمِنًى  ، وَطَلَبْتُهُ  بِمِنًى  فَقِيلَ لِي هُوَ  بِعَرَفَاتٍ  ، فَانْتَهَيْتُ إِلَيْهِ وَهُوَ فِي رَكْبٍ مِنْ أَصْحَابِهِ ، فَقِيلَ لِي : تَنَحَّ عَنْ طَرِيقِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ! فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَعُوا الرَّجُلَ ،  أَرَبٌ  مَا لَهُ ؟  فَدَنَوْتُ حَتَّى أَخَذْتُ  بِزِمَامِ نَاقَتِهِ أَوْ بِخِطَامِهَا  فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي أَسْأَلُكَ عَمَّا يُنَجِّينِي مِنَ النَّارِ وَعَمَّا يُبَلِّغُنِي الْجَنَّةَ ! فَرَفَعَ رَسُولُ         [19/210]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأْسَهُ إِلَى السَّمَاءِ ثُمَّ نَكَسَ ، ثُمَّ أَقْبَلَ عَلَيَّ بِوَجْهِهِ فَقَالَ : لَئِنْ كُنْتَ أَوْجَزْتَ الْمَسْأَلَةَ لَقَدْ سَأَلْتَ عَنْ عَظِيمٍ طَوِيلٍ ! فَاحْفَظْ عَنِّي : اعْبُدِ اللهَ وَلَا تُشْرِكْ بِهِ شَيْئًا ، وَأَقِمِ الصَّلَاةَ الْمَكْتُوبَةَ ، وَأَدِّ الزَّكَاةَ الْمَفْرُوضَةَ ، وَصُمْ رَمَضَانَ ، وَمَا تُحِبُّ أَنْ يَفْعَلَهُ النَّاسُ بِكَ فَافْعَلْهُ بِهِمْ ، وَمَا تَكْرَهُ أَنْ يَفْعَلَهُ النَّاسُ بِكَ فَذَرِ النَّاسَ مِنْهُ ، خَلِّ سَبِيلَ النَّاقَةِ أَوِ الرَّاحِلَةِ ، قَالَ  هَمَّامٌ  : وَأَمَّا  الْحَجُّ  فَقَدْ حَجَّ حَيْثُ سَأَلَهُ  .","","Al-Mu'jam al-Kabir 473","","أبو المنتفق ، ويقال عن عبد الله بن أبي عقيل اليشكري عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن محمد بن جحادة الأودي عن همام بن يحيى بن دينار عن علي بن الجعد عن محمد بن عبدوس السراج عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17554","474  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى بْنِ مُعَاذِ بْنِ مُعَاذٍ الْعَسْكَرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ ،  عَنْ  زَمِيلٍ لَهُ  يُخْبِرُ عَنْ  أَبِيهِ - وَكَانَ يُكَنَّى أَبَا الْمُنْتَفِقِ -  قَالَ :  أَتَيْتُ  مَكَّةَ  فَسَأَلْتُ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقَالُوا  بِعَرَفَةَ ،  فَأَتَيْتُهُ فَذَهَبْتُ أَدْنُو مِنْهُ حَتَّى اجْتَازَ عُنُقُ رَاحِلَتِي وَعُنُقُ رَاحِلَتِهِ ، فَقُلْتُ :  يَا رَسُولَ اللهِ ، عَلِّمْنِي بِمَا يُنَجِّينِي مِنْ عَذَابِ اللهِ وَيُدْخِلُنِي جَنَّتَهُ ، فَقَالَ : اعْبُدِ اللهَ وَلَا تُشْرِكْ بِهِ شَيْئًا  ، وَأَقِمِ الصَّلَاةَ الْمَكْتُوبَةَ ، وَأَدِّ الزَّكَاةَ الْمَفْرُوضَةَ ، وَحُجَّ وَاعْتَمِرْ -  وَأَظُنُّهُ قَالَ : وَصُمْ رَمَضَانَ - وَانْظُرْ مَا تُحِبُّ لِلنَّاسِ أَنْ يَأْتُوهُ إِلَيْكَ فَافْعَلْهُ بِهِمْ ، وَمَا تَكْرَهُ أَنْ يَأْتُوهُ إِلَيْكَ فَذَرْهُمْ مِنْهُ  .  اضْطَرَبَ  ابْنُ عَوْنٍ  فِي  إِسْنَادِ  هَذَا الْحَدِيثِ ، وَلَمْ يَضْبِطْهُ عَنْ  مُحَمَّدِ بْنِ جُحَادَةَ  ، وَضَبَطَهُ  هَمَّامٌ  .","","Al-Mu'jam al-Kabir 474","","أبو المنتفق ، ويقال عن زميل محمد بن جحادة الأودي عن محمد بن جحادة الأودي عن عبد الله بن عون بن أرطبان عن معاذ بن معاذ بن نصر عن معاذ بن المثنى العنبري عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17555","475  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ وَمُوسَى بْنُ هَارُونَ قَالَا :  ثَنَا  أَبُو مُوسَى الْهَرَوِيُّ ،  ثَنَا  أَشْعَثُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ زُبَيْرٍ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي  ،  عَنِ  الْمُغِيرَةِ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِيهِ  قَالَ : انْتَهَيْتُ إِلَى ابْنِ الْمُنْتَفِقِ - وَذَكَرَهُ .         [19/211]","","Al-Mu'jam al-Kabir 475","","أبو المنتفق ، ويقال عن عبد الله بن أبي عقيل اليشكري عن المغيرة بن عبد الله بن أبي عقيل اليشكري عن زبيد بن الحارث اليامي عن عبد الرحمن بن زبيد بن الحارث اليامي عن أشعث بن عبد الرحمن بن زبيد اليامي عن إسحاق بن إبراهيم الهروي عن موسى بن هارون الحمال عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17556","476  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  يَحْيَى بْنُ عِيسَى ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عُمَرَ بْنِ مُرَّةَ  ،  عَنِ  الْمُغِيرَةِ بْنِ سَعِيدٍ الْأَخْرَمِ ،  عَنْ  أَبِيهِ أَوْ  عَنْ  عَمِّهِ  -  يَشُكُّ  الْأَعْمَشُ -  قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أُرِيدُ أَنْ أَسْأَلَهُ  .  فَذَكَرَ نَحْوَهُ .  كذا في طبعة مكتبة ابن تيمية ، والصواب: (عمرو بن مرة ) .","","Al-Mu'jam al-Kabir 476","","عبد الله بن أبي عقيل اليشكري عن المغيرة بن سعد بن الأخرم الطائي عن عمرو بن مرة المرادي عن الأعمش عن يحيى بن عيسى النهشلي عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17557","477  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ وَعَبْدُ اللهِ بْنُ الصَّقْرِ الْعَسْكَرِيُّ قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُغِيرَةِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ بْنِ خَالِدِ بْنِ حِزَامٍ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ عَيَّاشٍ الْأَنْصَارِيُّ ثُمَّ الْمِسْمَعِيُّ ،  عَنْ  دَلْهَمِ بْنِ الْأَسْوَدِ ،  عَنْ  عَاصِمِ بْنِ لَقِيطٍ  أَنَّ لَقِيطَ بْنَ عَامِرٍ خَرَجَ وَافِدًا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهُ صَاحِبٌ لَهُ يُقَالُ لَهُ  نَهِيكُ بْنُ عَاصِمِ بْنِ مَالِكِ بْنِ الْمُنْتَفِقِ  ، قَالَ  لَقِيطٌ  : خَرَجَ فَخَرَجْتُ أَنَا وَصَاحِبِي حَتَّى قَدِمْتُ  الْمَدِينَةَ  لِانْسِلَاخِ رَجَبٍ ، فَأَتَيْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حِينَ انْصَرَفَ مِنْ صَلَاةِ الْغَدَاةِ ، فَقَامَ فِي النَّاسِ خَطِيبًا ، فَقَالَ :  أَيُّهَا النَّاسُ ، أَلَا إِنِّي قَدْ خَبَّأْتُ لَكُمْ صَوْتِي مُنْذُ أَرْبَعَةِ أَيَّامٍ لِأُسْمِعَكُمُ الْيَوْمَ ، أَلَا فَهَلْ مِنِ امْرِئٍ بَعَثَهُ قَوْمُهُ  فَقَالُوا اعْلَمْ لَنَا مَا يَقُولُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ أَلَا ثُمَّ لَعَلَّهُ أَنْ يُلْهِيَهُ حَدِيثُ نَفْسِهِ أَوْ حَدِيثُ صَاحِبٍ لَهُ أَوْ يُلْهِيَهُ الضُّلَّالُ ، أَلَا إِنِّي مَسْئُولٌ هَلْ بَلَّغْتُ ؟ أَلَا فَاسْمَعُوا تَعِيشُوا ، أَلَا فَاسْمَعُوا تَعِيشُوا ، أَلَا اجْلِسُوا ! قَالَ : فَجَلَسَ النَّاسُ وَقُمْتُ أَنَا وَصَاحِبِي ، حَتَّى إِذَا فَرَغَ لَنَا فُؤَادُهُ وَبَصَرُهُ قُلْتُ : يَا رَسُولَ اللهِ ، مَا عِنْدَكَ مِنْ عِلْمِ الْغَيْبِ ؟         [19/212]      فَضَحِكَ  لَعَمْرُ  اللهِ وَهَزَّ رَأْسَهُ وَعَلِمَ أَنِّي أَبْتَغِي سَقْطَهُ ، فَقَالَ : ضَنَّ رَبُّكَ بِخَمْسٍ مِنَ الْغَيْبِ لَا يَعْلَمُهُنَّ إِلَّا هُوَ - وَأَشَارَ بِيَدِهِ ، فَقُلْتُ : مَا هُنَّ يَا رَسُولَ اللهِ ؟ قَالَ : عِلْمُ الْمَنِيَّةِ مَتَى مَنِيَّةُ أَحَدِكُمْ وَلَا تَعْلَمُونَهُ ، وَعِلْمُ الْمَنِيِّ حِينَ يَكُونُ فِي الرَّحِمِ قَدْ عَلِمَ وَلَا تَعْلَمُونَهُ ، وَعِلْمُ مَا فِي غَدٍ قَدْ عَلِمَ مَا أَنْتَ طَاعِمٌ غَدًا وَلَا تَعْلَمُهُ ، وَعِلْمُ يَوْمِ الْغَيْبِ يُشْرِفُ عَلَيْكُمْ آزِلِينَ مُشْفِقِينَ ، وَيَظَلُّ رَبُّكَ يَضْحَكُ قَدْ عَلِمَ أَنَّ عَوْدَتَكُمْ قَرِيبٌ - قَالَ  لَقِيطٌ  : قُلْتُ : لَنْ نَعْدَمَ مِنْ رَبٍّ يَضْحَكُ خَيْرًا - وَعِلْمُ يَوْمِ السَّاعَةِ .  قُلْتُ : يَا رَسُولَ اللهِ ، إِنِّي سَائِلُكَ عَنْ حَاجَتِي فَلَا تَعْجَلْنِي ! قَالَ : سَلْ عَمَّا شِئْتَ ، قُلْتُ : يَا رَسُولَ اللهِ ، عَلِّمْنَا مَا تُعَلِّمُ النَّاسَ وَمَا نَعْلَمُ ، فَإِنَّا مِنْ قَبِيلٍ لَا يُصَدِّقُونَ تَصْدِيقَنَا أَحَدٌ مِنْ  مَذْحِجٍ  الَّتِي تَعْلُو عَلَيْنَا ،  وَخَثْعَمٌ  الَّتِي تُوَازِينَا تُوَالِينَا ، وَعَشِيرَتِنَا الَّتِي نَحْنُ مِنْهَا . قَالَ : تَلْبَثُونَ مَا لَبِثْتُمْ ثُمَّ تُبْعَثُ الصَّيْحَةُ ،  لَعَمْرُ  إِلَهِكَ مَا يَدَعُ عَلَى ظَهْرِهَا مِنْ شَيْءٍ إِلَّا مَاتَ ، وَالْمَلَائِكَةُ الَّذِينَ مَعَ رَبِّكَ ، وَأَصْبَحَ رَبُّكَ يَتَطَوَّفُ فِي الْأَرْضِ وَخَلَتْ عَلَيْهِ الْبِلَادُ ، فَأَرْسَلَ رَبُّكَ السَّمَاءَ  بِهَضْبٍ  مِنْ عِنْدِ الْعَرْشِ ، فَلَعَمْرُ إِلَهِكَ مَا يَدَعُ عَلَى ظَهْرِهَا مِنْ قَتِيلٍ وَلَا مَدْفَنِ مَيِّتٍ إِلَّا شَقَّتِ الْقَبْرَ عَنْهُ وَيَخْلُقُهُ مِنْ قِبَلِ رَأْسِهِ فَيَسْتَوِي جَالِسًا ، يَقُولُ رَبُّكَ :  مَهْيَمْ  ؟ لِمَا كَانَ فِيهِ يَقُولُ : يَا رَبِّ أَمْسِ الْيَوْمَ - لِعَهْدِهِ بِالْحَيَاةِ يَحْسَبُهُ حَدِيثًا .  قُلْتُ : يَا رَسُولَ اللهِ ، كَيْفَ يَجْمَعُنَا بَعْدَمَا تُمَزِّقُنَا الرِّيَاحُ وَالْبِلَى وَالسِّبَاعُ ؟ قَالَ : أُنَبِّئُكَ بِمِثْلِ ذَلِكَ فِي  آلَاءِ  اللهِ ؛ الْأَرْضُ أَشْرَفْتُ عَلَيْهَا وَهِيَ مَدَرَةٌ بَالِيَةٌ ، فَقُلْتَ لَا تَحْيَا أَبَدًا ، ثُمَّ أَرْسَلَ عَلَيْهَا رَبُّكَ السَّمَاءَ فَلَمْ يَلْبَثْ عَلَيْهَا إِلَّا يَسِيرًا حَتَّى أَشْرَفْتُ عَلَيْهَا فَإِذَا هِيَ  شَرْبَةٌ  وَاحِدَةٌ ، وَلَعَمْرُ إِلَهِكَ لَهُوَ أَقْدَرُ عَلَى أَنْ يَجْمَعَكُمْ مِنَ الْمَاءِ عَلَى أَنْ يَجْمَعَ نَبَاتَ الْأَرْضِ فَتَخْرُجُونَ مِنَ الْأَضْوَاءِ وَمِنْ مَصَارِعِكُمْ فَتَنْظُرُونَ إِلَيْهِ سَاعَةً وَيَنْظُرُ إِلَيْكُمْ .  قُلْتُ : يَا رَسُولَ اللهِ ، كَيْفَ وَنَحْنُ مِلءُ الْأَرْضِ وَهُوَ شَخْصٌ وَاحِدٌ يَنْظُرُ إِلَيْنَا وَنَنْظُرُ إِلَيْهِ ؟ قَالَ :         [19/213]      أُنَبِّئُكَ بِمِثْلِ ذَلِكَ فِي  آلَاءِ  اللهِ ؛ الشَّمْسُ وَالْقَمَرُ آيَةٌ مِنْهُ صَغِيرَةٌ تَرَوْنَهَا سَاعَةً وَاحِدَةً وَيَرَيَانِكُمْ ، وَلَا تُضَامُونَ فِي رُؤْيَتِهِمَا ، وَلَعَمْرُ إِلَهِكَ لَهُوَ أَقْدَرُ عَلَى أَنْ يَرَاكُمْ وَتَرَوْهُ مِنْهُمَا أَنْ تَرَوْهُمَا وَيَرَيَانِكُمْ .  قُلْتُ : يَا رَسُولَ اللهِ ، فَمَا يَفْعَلُ بِنَا رَبُّنَا إِذَا لَقِينَاهُ ؟ قَالَ : تُعْرَضُونَ عَلَيْهِ بَادِيَةً صَفَحَاتُكُمْ لَا يَخْفَى عَلَيْهِ مِنْكُمْ خَافِيَةٌ ، فَيَأْخُذُ رَبُّكَ بِيَدِهِ غَرْفَةً مِنَ الْمَاءِ  فَيَنْضَحُ  بِهَا قَلْبَكُمْ ، فَلَعَمْرُ إِلَهِكَ مَا يُخْطِئُ وَجْهَ وَاحِدٍ مِنْكُمْ قَطْرَةٌ ، فَأَمَّا الْمُسْلِمُ فَتَدَعُ وَجْهَهُ مِثْلَ  الرَّيْطَةِ  الْبَيْضَاءِ ، وَأَمَّا الْكَافِرُ فَيَجْعَلُهُ مِثْلَ الْحُمَمِ الْأَسْوَدِ ، أَلَا ثُمَّ يَنْصَرِفُ عَنْكُمْ ، وَيَتَفَرَّقُ عَلَى أَثَرِهِ الصَّالِحُونَ فَيَسْلُكُونَ جِسْرًا مِنَ النَّارِ يَطَأُ أَحَدُكُمْ عَلَى الْجَمْرَةِ فَيَقُولُ : حَسِّ ! فَيَقُولُ رَبُّكَ : أَوَانُهُ ، أَلَا فَيَطَّلِعُونَ عَلَى حَوْضِ الرَّسُولِ لَا يَظْمَأُ وَاللهِ بِأَهْلِهِ ، فَلَعَمْرُ إِلَهِكَ مَا يَبْسُطُ أَحَدٌ مِنْكُمْ يَدَهُ إِلَّا وَقَعَ عَلَيْهَا قَدَحٌ يُطَهِّرُهُ مِنَ الطَّوَافِ وَالْبَوْلِ وَالْأَذَى ، وَتُحْبَسُ الشَّمْسُ وَالْقَمَرُ فَلَا تَرَوْنَ مِنْهُمَا وَاحِدًا .  قُلْتُ : يَا رَسُولَ اللهِ ، فَبِمَ نُبْصِرُ ؟ قَالَ : مِثْلَ بَصَرِ سَاعَتِكَ هَذِهِ ، وَذَلِكَ مَعَ طُلُوعِ الشَّمْسِ فِي يَوْمٍ أَشْرَقَتِ الْأَرْضُ وَوَاجَهَتْهُ الْجِبَالُ .  قُلْتُ : يَا رَسُولَ اللهِ ، فَبِمَ نُجْزَى مِنْ سَيِّئَاتِنَا وَحَسَنَاتِنَا ؟ قَالَ : الْحَسَنَةُ بِعَشْرِ أَمْثَالِهَا ، وَالسَّيِّئَةُ بِمِثْلِهَا أَوْ يَغْفِرُ .  قُلْتُ : يَا رَسُولَ اللهِ ، فَمَا الْجَنَّةُ وَالنَّارُ ؟ قَالَ :  لَعَمْرُ  إِلَهِكَ ، إِنَّ النَّارَ لَسَبْعَةُ أَبْوَابٍ مَا مِنْهُنَّ بَابٌ إِلَّا يَسِيرُ الرَّاكِبُ بَيْنَهُمَا سَبْعِينَ عَامًا ، وَإِنَّ لِلْجَنَّةِ ثَمَانِيَةَ أَبْوَابٍ مَا مِنْهُمَا بَابَانِ إِلَّا يَسِيرُ الرَّاكِبُ بَيْنَهُمَا سَبْعِينَ عَامًا .  قُلْتُ : يَا رَسُولَ اللهِ ، فَعَلَى مَا نَطَّلِعُ مِنَ الْجَنَّةِ ؟ قَالَ : عَلَى أَنْهَارٍ مِنْ عَسَلٍ مُصَفًّى ، وَأَنْهَارٍ مِنْ كَأْسٍ مَا بِهَا مِنْ صُدَاعٍ وَلَا نَدَامَةٍ ، وَأَنْهَارٍ مِنْ لَبَنٍ لَمْ يَتَغَيَّرْ طَعْمُهُ وَمَاءٍ غَيْرِ آسِنٍ ، وَفَاكِهَةٍ  لَعَمْرُ  إِلَهِكَ مَا تَعْلَمُونَ ، وَخَيْرٍ مِنْ مِثْلِهِ مَعَهُ ، وَأَزْوَاجٍ مُطَّهَرَةٍ ، قُلْتُ : يَا رَسُولَ اللهِ ، أَوَلَنَا فِيهَا أَزْوَاجٌ أَوَ مِنْهُنَّ مُصْلِحَاتٌ ؟ قَالَ : الصَّالِحَاتُ لِلصَّالِحِينَ تَلَذُّونَهُنَّ مِثْلَ لَذَّاتِكُمْ فِي الدُّنْيَا         [19/214]      وَتَلَذُّونَكُمْ غَيْرَ أَنْ لَا تَوَالُدَ ، قَالَ  لَقِيطٌ  : قُلْتُ : مَا أَفْضَلَ مَا نَحْنُ بَالِغُونَ مُنْتَهُونَ إِلَيْهِ ؟ قُلْتُ : يَا رَسُولَ اللهِ ، عَلَامَ  أُبَايِعُكَ  ؟ فَبَسَطَ يَدَهُ وَقَالَ : عَلَى إِقَامِ الصَّلَاةِ ، وَإِيتَاءِ الزَّكَاةِ ، وَزِيَالِ  الشِّرْكِ  ، لَا تُشْرِكْ بِاللهِ إِلَهًا غَيْرَهُ . قَالَ : قُلْتُ لَهُ : فَمَا بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ ؟ وَقَبَضَ وَبَسَطَ أَصَابِعَهُ وَظَنَّ أَنِّي مُشْتَرِطٌ شَيْئًا لَا يُعْطِينِيهِ ، قَالَ : قُلْتُ : نَحِلُّ مِنْهَا حَيْثُ شِئْنَا ، وَلَا  يَجْنِي  امْرُؤٌ إِلَّا نَفْسَهُ ، فَبَسَطَ يَدَهُ وَقَالَ : فَلَكَ ، حِلَّ حَيْثُ شِئْتَ وَلَا  تَجْنِي  عَلَيْكَ إِلَّا نَفْسُكَ . قَالَ : فَانْصَرَفْنَا عَنْهُ ، وَقَالَ : هَا إِنَّ ذَيْنِ ، هَا إِنَّ ذَيْنِ لَمِنْ نَفَرٍ ، لَعَمْرُو إِلَهِكَ إِنَّهُمْ مِنْ أَتْقَى النَّاسِ رَبَّهُ فِي الدُّنْيَا وَالْآخِرَةِ ، فَقَالَ لَهُ  كَعْبُ بْنُ الْخُدَارِيَّةِ  أَحَدُ  بَنِي أَبِي بَكْرِ بْنِ كِلَابٍ  : مَنْ هُمْ يَا رَسُولَ اللهِ ؟ قَالَ :  بَنُو الْمُنْتَفِقِ .  قَالَ :  بَنُو الْمُنْتَفِقِ  أَهْلُ ذَلِكَ مِنْهُمْ ، أَهْلُ ذَلِكَ مِنْهُمْ ، فَانْصَرَفْتُ وَأَقْبَلْتُ عَلَيْهِ ، فَقُلْتُ : يَا رَسُولَ اللهِ ، هَلْ لِأَحَدٍ مِمَّنْ مَضَى قَبْلَنَا مِنْ خَيْرٍ فِي جَاهِلِيَّتِهِمْ ؟ فَقَالَ رَجُلٌ مِنْ عُرْضِ  قُرَيْشٍ  : وَاللهِ إِنَّ أَبَاكَ  الْمُنْتَفِقَ  لَفِي النَّارِ . قَالَ : فَكَأَنَّهُ وَقَعَ حَرٌّ بَيْنَ جِلْدِ وَجْهِي وَلَحْمِي بِمَا قَالَ عَلَى رُءُوسِ النَّاسِ ، وَهَمَمْتُ أَنْ أَقُولَ : أَيْنَ أَبُوكَ يَا رَسُولَ اللهِ ؟ فَإِذَا الْأُخْرَى أَجْمَلُ ، قُلْتُ : أَوَأَهْلُكَ يَا رَسُولَ اللهِ ؟ قَالَ : وَأَهْلِي ، مَا أَتَيْتَ عَلَيْهِ مِنْ قَبْرِ عَامِرِيٍّ أَوْ قُرَشِيٍّ مِنْ مُشْرِكٍ فَقُلْ : أَرْسَلَنِي إِلَيْكَ  مُحَمَّدٌ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَبْشِرْ بِمَا يَسُوؤُكَ ، تُجَرُّ عَلَى وَجْهِكَ وَبَطْنِكَ فِي النَّارِ ، قُلْتُ : يَا رَسُولَ اللهِ ، وَمَا فَعَلَ ذَلِكَ بِهِمْ وَكَانُوا عَلَى عَمَلٍ لَا يُحْسِنُونَ إِلَّا إِيَّاهُ ، وَكَانُوا يَحْسَبُونَهُمْ مُصْلِحِينَ ؟ قَالَ : ذَلِكَ فَإِنَّ اللهَ بَعَثَ فِي آخِرِ كُلِّ سَبْعِ أُمَمٍ نَبِيًّا ، فَمَنْ أَطَاعَ نَبِيَّهُ كَانَ مِنَ الْمُهْتَدِينَ ، وَمَنْ عَصَاهُ كَانَ مِنَ الضَّالِّينَ  .","","Al-Mu'jam al-Kabir 477","","لقيط بن صبرة العقيلي عن عاصم بن لقيط بن عامر العقيلي عن دلهم بن الأسود العقيلي عن عبد الرحمن بن عياش القبائي عن عبد الرحمن بن المغيرة الحزامي عن إبراهيم بن المنذر الحزامي عن عبد الله بن الصقر السكري عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17558","478  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ         [19/215]      أَبِي شَيْبَةَ ،  ثَنَا  يَحْيَى بْنُ آدَمَ ،  ثَنَا  سُفْيَانُ ،  عَنْ  مُوسَى بْنِ أَبِي عَائِشَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي رَزِينٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فِي الصَّيْدِ يَتَوَارَى عَنْ صَاحِبِهِ ، قَالَ :  لَعَلَّ هَوَامَّ الْأَرْضِ هِيَ قَتَلَتْهُ  .","","Al-Mu'jam al-Kabir 478","","مسعود بن مالك الأسدي عن عبد الله بن أبي رزين الأسدي عن موسى بن أبي عائشة المخزومي عن سفيان الثوري عن يحيى بن آدم عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","وكيع بن حدس ويقال عدس عن أبي رزين"
"17559","لَقِيطُ بْنُ صَبِرَةَ الْعُقَيْلِيُّ  479  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  إِسْمَاعِيلُ بْنُ كَثِيرٍ ،  عَنْ  عَاصِمِ بْنِ لَقِيطِ بْنِ صَبِرَةَ ،  عَنْ  أَبِيهِ  قَالَ :  انْطَلَقْتُ أَنَا  وَصَاحِبٌ لِي  حَتَّى انْتَهَيْنَا إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ نَجِدْهُ ، فَأَطْعَمَتْنَا  عَائِشَةُ  تَمْرًا وَعَصَدَتْ لَنَا  عَصِيدَةً  ، إِذْ جَاءَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْقَلِعُ ، فَقَالَ : هَلْ أَطْعَمْتِيهِمْ مِنْ شَيْءٍ ؟ قُلْنَا : نَعَمْ ، فَبَيْنَا نَحْنُ عَلَى ذَلِكَ دَفَعَ  الرَّاعِي  الْغَنَمَ إِلَى  الْمُرَاحِ  عَلَى يَدِهِ سَخْلَةٌ ، فَقَالَ : هَلْ  وَلَدَتْ  ؟ قَالَ : نَعَمْ . قَالَ : فَاذْبَحْ شَاةً ، ثُمَّ أَقْبَلَ عَلَيْنَا بِوَجْهِهِ فَقَالَ : لَا تَحْسَبَنَّ - وَلَمْ يَقُلْ : لَا تَحْسَبُنَّ - أَنَّا ذَبَحْنَا الشَّاةَ مِنْ أَجْلِكُمَا ، لَنَا غَنَمٌ مِائَةٌ لَا نُرِيدُ أَنْ تَزِيدَ عَلَيْهَا ، إِذَا وُلِدَ لِلرَّاعِي  بَهْمَةٌ  أَمَرْنَاهُ فَذَبَحَ شَاةً . قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، أَخْبِرْنِي عَنِ الْوُضُوءِ ، قَالَ :  إِذَا تَوَضَّأْتَ فَأَسْبِغِ الْوُضُوءَ وَخَلِّلِ الْأَصَابِعَ ،         [19/216]      وَإِذَا  اسْتَنْثَرْتَ  فَأَبْلِغْ إِلَّا أَنْ تَكُونَ صَائِمًا .  قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ لِي  امْرَأَةً  - فَذَكَرَ مِنْ طُولِ لِسَانِهَا  وَبَذَائِهَا  ، قَالَ : طَلِّقْهَا . قَالَ : قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّهَا ذَاتُ صُحْبَةٍ وَوَلَدٍ ! قَالَ : أَمْسِكْهَا وَأْمُرْهَا ، فَإِنْ يَكُنْ فِيهَا خَيْرٌ فَسَتَفْعَلُ ، وَلَا تَضْرِبْ ظَعِينَتَكَ ضَرْبَكَ أَمَتَكَ  .","","Al-Mu'jam al-Kabir 479","","لقيط بن صبرة العقيلي عن عاصم بن لقيط بن صبرة الطائفي عن إسماعيل بن كثير التبالي عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","لقيط بن صبرة العقيلي"
"17560","480  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  يَحْيَى بْنُ سُلَيْمٍ الطَّائِفِيُّ ،  عَنْ  إِسْمَاعِيلَ بْنِ كَثِيرٍ ،  عَنْ  عَاصِمِ بْنِ لَقِيطٍ ،  عَنْ  أَبِيهِ  ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ  .","","Al-Mu'jam al-Kabir 480","","لقيط بن صبرة العقيلي عن عاصم بن لقيط بن صبرة الطائفي عن إسماعيل بن كثير التبالي عن يحيى بن سليم الطائفي عن العباس بن الوليد النرسي عن عبد الله بن أحمد بن حنبل عن الطبراني","لقيط بن صبرة العقيلي"
"17561","481  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ ،  عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  إِسْمَاعِيلَ بْنِ كَثِيرٍ ،  عَنْ  عَاصِمِ بْنِ لَقِيطِ بْنِ صَبِرَةَ ،  عَنْ  أَبِيهِ  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ شَيْئًا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَسْبِغِ الْوُضُوءَ ، وَخَلِّلِ الْأَصَابِعَ  .","","Al-Mu'jam al-Kabir 481","","لقيط بن صبرة العقيلي عن عاصم بن لقيط بن صبرة الطائفي عن إسماعيل بن كثير التبالي عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","لقيط بن صبرة العقيلي"
"17562","482  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ - قَالَا :  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي هَاشِمٍ ،  عَنْ  عَاصِمِ بْنِ لَقِيطِ بْنِ صَبِرَةَ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أَسْبِغِ الْوُضُوءَ ، وَخَلِّلِ الْأَصَابِعَ  ، وَإِذَا اسْتَنْشَقْتَ فَبَالِغْ إِلَّا أَنْ تَكُونَ صَائِمًا  -  وَلَفْظُهُمَا وَاحِدٌ  .","","Al-Mu'jam al-Kabir 482","","لقيط بن صبرة العقيلي عن عاصم بن لقيط بن صبرة الطائفي عن إسماعيل بن كثير التبالي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","لقيط بن صبرة العقيلي"
"17563","483  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَبَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  عَلِيُّ بْنُ حَسَّانَ الْعَطَّارُ الْبَصْرِيُّ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْقَطَّانُ ،  ثَنَا  قُرَّةُ بْنُ خَالِدٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ         [19/217]      كَثِيرٍ ،  عَنْ  عَاصِمِ بْنِ لَقِيطِ بْنِ صَبِرَةَ ،  عَنْ  أَبِيهِ  - وَافِدِ  بَنِي الْمُنْتَفِقِ  -  أَنَّهُ أَتَى  عَائِشَةَ  هُوَ  وَصَاحِبٌ لَهُ  يَطْلُبَانِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ يَجِدَاهُ ، فَأَطْعَمَتْهُمَا  عَائِشَةُ  عَصِيدَةً  ، فَلَمْ يَلْبَثْ أَنْ جَاءَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْقَلِعُ يَتَكَفَّأُ ، فَقَالَ : أَطْعَمْتِهِمَا ؟ قُلْنَا : نَعَمْ ، قُلْتُ : يَا رَسُولَ اللهِ ، الصَّلَاةُ ؟ قَالَ :  أَسْبِغِ الْوُضُوءَ ، وَخَلِّلِ الْأَصَابِعَ  ، وَبَالِغْ فِي الِاسْتِنْشَاقِ إِلَّا أَنْ تَكُونَ صَائِمًا . قُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ لِي  امْرَأَةً -  وَذَكَرَ مِنْ بَلَائِهَا ، فَقَالَ : طَلِّقْهَا ، قُلْتُ : إِنَّهَا ذَاتُ صُحْبَةٍ وَوَلَدٍ ! قَالَ : فَعِظْهَا ، إِنْ يَكُنْ فِيهَا خَيْرٌ فَسَتَفْعَلُ ، وَلَا تَضْرِبْ ظَعِينَتَكَ ضَرْبَكَ أُمَيَّتَكَ ، فَبَيْنَا نَحْنُ كَذَلِكَ إِذْ دَفَعَ رَاعِي الْغَنَمِ عَلَى يَدَيْهِ فِي  الْمُرَاحِ  سَخْلَةً ، قَالَ : أَوَلَدَتْ ؟ قَالَ : نَعَمْ ، قَالَ :  بَهْمَةٌ  - قَالَ - اذْبَحْ مَكَانَهَا شَاةً ، ثُمَّ أَقْبَلَ عَلَيَّ فَقَالَ : لَا تَحْسَبَنَّ - وَلَمْ يَقُلْ لَا تَحْسَبُنَّ - أَنَّا ذَبَحْنَاهَا مِنْ أَجْلِكَ ، إِنَّ لَنَا غَنَمٌ مِائَةٌ لَا نُحِبُّ أَنْ يَزِيدَ عَلَيْهَا ، وَكُلَّمَا وَلَّدَ الرَّاعِي  بَهْمَةً  أَمَرْنَاهُ فَذَبَحَ شَاةً  .","","Al-Mu'jam al-Kabir 483","","لقيط بن صبرة العقيلي عن عاصم بن لقيط بن صبرة الطائفي عن إسماعيل بن كثير التبالي عن قرة بن خالد السدوسي عن يحيى القطان عن علي بن حسان العطار البصري عن محمد بن أبان الأصبهاني عن الطبراني","لقيط بن صبرة العقيلي"
"17564","لَقِيطُ بْنُ أَرْطَأَةَ السَّكُونِيُّ  484  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، قَالَا :  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  مَسْلَمَةُ بْنُ عُلَيٍّ ،  ثَنَا  نَصْرُ بْنُ عَلْقَمَةَ ،  عَنْ  أَخِيهِ  ،  عَنِ  ابْنِ عَائِذٍ ،  عَنْ  لَقِيطِ بْنِ أَرْطَأَةَ السَّكُونِيِّ  أَنَّ  رَجُلًا  قَالَ لَهُ : إِنَّ لَنَا جَارًا يَشْرَبُ الْخَمْرَ وَيَأْتِي الْقَبِيحَ  ، فَارْفَعْ أَمْرَهُ إِلَى السُّلْطَانِ ! قَالَ : لَقَدْ قَتَلْتُ تِسْعًا وَتِسْعِينَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا أُحِبُّ أَنِّي قَتَلْتُ مِثْلَهُمْ وَأَنِّي كَشَفْتُ قِنَاعَ مُسْلِمٍ  .","","Al-Mu'jam al-Kabir 484","","لقيط بن أرطاة السكوني عن عبد الرحمن بن عائذ الثمالي عن محفوظ بن علقمة الحضرمي عن نصر بن علقمة الحضرمي عن مسلمة بن علي بن خلف الخشني عن هشام بن عمار عن الحسين بن إسحاق التستري عن الطبراني","لقيط بن أرطأة السكوني"
"17565","[19/218]      485  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ الْحِمْصِيُّ  ، ثَنَا  أَبُو عَلْقَمَةَ نَصْرُ بْنُ خُزَيْمَةَ أَنَّ أَبَاهُ  حَدَّثَهُ  عَنْ  نَصْرِ بْنِ عَلْقَمَةَ ،  عَنْ  أَخِيهِ مَحْفُوظِ بْنِ عَلْقَمَةَ  ، عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَائِذٍ  قَالَ  : قَالَ لَقِيطُ بْنُ صَبِرَةَ السَّكُونِيُّ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَرِجْلَايَ مُعْوَجَّتَانِ  لَا تَمَسَّانِ الْأَرْضَ ، فَدَعَا لِي فَمَشَيْتُ عَلَى الْأَرْضِ  .","","Al-Mu'jam al-Kabir 485","","لقيط بن صبرة العقيلي عن عبد الرحمن بن عائذ الثمالي عن محفوظ بن علقمة الحضرمي عن نصر بن علقمة الحضرمي عن أبو نصر بن خزيمة بن علقمة الحضرمي عن نصر بن خزيمة بن علقمة الحضرمي عن عمرو بن إسحاق بن إبراهيم الزبيدي عن الطبراني","لقيط بن أرطأة السكوني"
"17566","مَنِ اسْمُهُ لُبَيٌّ  لُبَيُّ بْنُ لَبَّا  486  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ  ، ثَنَا  خَالِدُ بْنُ خِدَاشٍ ،  ثَنَا  مُحَمَّدُ بْنُ يَزِيدَ الْوَاسِطِيُّ ،  عَنْ  أَبِي بَلْجٍ قَالَ :  رَأَيْتُ  لُبَيَّ بْنَ لَبَّا الْأَسَدِيَّ  - وَكَانَ  رَجُلًا مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَوْ قَدْ أَدْرَكَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - سَبَقَ فَرَسٌ لَهُ  فَجَلَّلَهُ  بُرْدًا عَدَنِيًّا ، وَرَأَيْتُ عَلَيْهِ ثَوْبَ  خَزٍّ أَوْ مُطَرَّفًا  .","","Al-Mu'jam al-Kabir 486","","لبي بن لبا عن جارية بن بلج الواسطي عن محمد بن يزيد الكلاعي عن خالد المهلبي عن محمد بن علي بن شعيب السمسار عن الطبراني","لبي بن لبا"
"17567","مَنِ اسْمُهُ لَجْلَاجٌ  لَجْلَاجٌ أَبُو خَالِدٍ ،  كَانَ يَنْزِلُ  دِمَشْقَ  487  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  الْمُعَلَّى بْنُ الْوَلِيدِ الْقَعْقَاعِيُّ ،  ثَنَا  مُبَشِّرُ بْنُ إِسْمَاعِيلَ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ الْعَلَاءِ بْنِ اللَّجْلَاجِ ،         [19/219]      عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ اللَّجْلَاجِ  قَالَ :  مَا مَلَأْتُ بَطْنِي طَعَامًا مُنْذُ أَسْلَمْتُ مَعَ النَّبِيِّ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - آكُلُ حَسْبِي وَأَشْرَبُ حَسْبِي  ،  قَالَ  الْعَلَاءُ  : يَعْنِي قُوتِي  .","","Al-Mu'jam al-Kabir 487","","لجلاج الغطفانى عن العلاء بن اللجلاج الغطفاني عن عبد الرحمن بن العلاء بن اللجلاج الغطفاني عن مبشر بن إسماعيل الحلبي عن معلى بن الوليد القنسريني عن يوسف بن يزيد القراطيسي عن الطبراني","لجلاج أبو خالد"
"17568","488  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَرَمِيُّ بْنُ حَفْصٍ الْعَتَكِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُلَاثَةَ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ عُمَرَ ، عَنْ خَالِدِ بْنِ اللَّجْلَاجِ ،  حَدَّثَهُ  أَنَّ أَبَاهُ اللَّجْلَاجَ  أَخْبَرَهُ  أَنَّهُ كَانَ قَاعِدًا فِي السُّوقِ فَمَرَّتِ  امْرَأَةٌ  تَحْمِلُ صَبِيًّا ، فَثَارَ النَّاسُ وَثُرْتُ ، فَسِرْنَا فَانْتَهَيْنَا إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ يَقُولُ : مَنْ أَبُو هَذَا مَعَكِ ؟ فَسَكَتَتْ ، فَقَالَ  شَابٌّ  حِذَاءَهَا : أَنَا أَبُوهُ يَا رَسُولَ اللهِ ! فَأَقْبَلَ عَلَيْهَا فَقَالَ : مَنْ أَبُو هَذَا مَعَكِ ؟ فَسَكَتَتْ ، فَقَالَ الْفَتَى : يَا رَسُولَ اللهِ ، إِنَّهَا حَدِيثَةُ السِّنِّ ، حَدِيثَةُ عَهْدٍ بِخُرْبَةٍ ، وَلَيْسَتْ تُكَلِّمُكَ ، وَأَنَا أَبُوهُ يَا رَسُولَ اللهِ ! فَنَظَرَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى بَعْضِ أَصْحَابِهِ كَأَنَّهُ يَسْأَلُهُمْ عَنْهُ ، فَقَالُوا :  مَا نَعْلَمُ إِلَّا خَيْرًا أَوْ نَحْوَ ذَا  ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَحْصَنْتَ ؟ قَالَ : نَعَمْ ، فَأَمَرَ بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُرْجَمَ ، فَخَرَجْنَا بِهِ فَحَفَرْنَا لَهُ حَتَّى أَمْكَنَّا ، ثُمَّ رَمَيْنَاهُ بِالْحِجَارَةِ حَتَّى هَدَأَ ، ثُمَّ انْصَرَفْنَا إِلَى مَجَالِسِنَا ، فَبَيْنَا نَحْنُ كَذَلِكَ إِذْ جَاءَ  شَيْخٌ  يَسْأَلُ عَنِ الْمَرْجُومِ ، فَقُمْنَا إِلَيْهِ فَأَخَذْنَا بِتَلَابِيبِهِ فَانْطَلَقْنَا بِهِ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَقُلْنَا : يَا رَسُولَ اللهِ ، هَذَا جَاءَ يَسْأَلُ عَنِ الْخَبِيثِ . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَهْ ،  هُوَ أَطْيَبُ عِنْدَ اللهِ مِنْ رِيحِ الْمِسْكِ  ! فَانْصَرَفْنَا مَعَ الشَّيْخِ فَإِذَا هُوَ أَبُوهُ ، فَانْتَهَيْنَا إِلَيْهِ فَأَعَنَّاهُ عَلَى غُسْلِهِ وَتَكْفِينِهِ وَدَفْنِهِ . قَالَ :  وَمَا أَدْرِي قَالَ "" الصَّلَاةِ عَلَيْهِ "" أَمْ لَا  .","","Al-Mu'jam al-Kabir 488","","لجلاج الغطفانى عن خالد بن اللجلاج عن عبد العزيز بن عمر بن عبد العزيز عن قاضي الجن محمد بن عبد الله بن علاثة عن حرمي بن حفص العتكي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","لجلاج أبو خالد"
"17569","[19/220]      489  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  صَدَقَةُ بْنُ خَالِدٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الشُّعَيْثِيُّ ،  عَنْ  مَسْلَمَةَ بْنِ عَبْدِ اللهِ الْجُهَنِيِّ ،  عَنْ  خَالِدِ بْنِ اللَّجْلَاجِ ،  عَنْ  أَبِيهِ  قَالَ :  كُنَّا غِلْمَانًا نَعْمَلُ فِي السُّوقِ ، فَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِرَجُلٍ  فَرُجِمَ ، فَجَاءَ  رَجُلٌ  يَسْأَلُنَا عَنْهُ ، فَأَتَيْنَا بِهِ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْنَا : يَا رَسُولَ اللهِ ، إِنَّ هَذَا جَاءَ يَسْأَلُنَا عَنْ هَذَا الْخَبِيثِ الَّذِي رُجِمَ الْيَوْمَ . فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تَقُولُوا خَبِيثٌ ، فَوَاللهِ لَهُوَ أَطْيَبُ عِنْدَ اللهِ مِنَ الْمِسْكِ  .","","Al-Mu'jam al-Kabir 489","","لجلاج الغطفانى عن خالد بن اللجلاج عن مسلمة بن عبد الله بن ربعي الجهني عن محمد بن عبد الله بن المهاجر الشعيثي عن صدقة بن خالد السمين عن هشام بن عمار عن أحمد بن المعلى الأسدي عن الطبراني","لجلاج أبو خالد"
"17570","490  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  أَبُو مُسْهِرٍ ،  ثَنَا  صَدَقَةُ بْنُ خَالِدٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ النَّصْرِيِّ ،  عَنْ  مَسْلَمَةَ بْنِ عَبْدِ اللهِ الْجُهَنِيِّ ،  عَنْ  خَالِدِ بْنِ اللَّجْلَاجِ ،  عَنْ  أَبِيهِ  قَالَ :  كُنَّا غِلْمَانًا نَعْدُو إِلَى السُّوقِ ، فَأُتِيَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِرَجُلٍ  أَقَرَّ بِالزِّنَا فَرُجِمَ ، فَجَاءَ  رَجُلٌ  يَسْأَلُنَا عَنْ مَكَانِ ذَلِكَ الرَّجُلِ الَّذِي رُجِمَ ، فَأَتَيْنَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْنَا : يَا رَسُولَ اللهِ ، إِنَّ هَذَا يَسْأَلُنَا عَنْ ذَلِكَ الْخَبِيثِ . فَقَالَ :  لَا تَقُولُوا خَبِيثٌ ، فَوَاللهِ لَهُوَ أَطْيَبُ عِنْدَ اللهِ مِنَ الْمِسْكِ  .","","Al-Mu'jam al-Kabir 490","","لجلاج الغطفانى عن خالد بن اللجلاج عن مسلمة بن عبد الله بن ربعي الجهني عن محمد بن عبد الله بن المهاجر الشعيثي عن صدقة بن خالد السمين عن عبد الأعلى بن مسهر الغساني عن أبو زرعة الدمشقي عن الطبراني","لجلاج أبو خالد"
"17571","491  -  حَدَّثَنَا  أَبُو أُسَامَةَ عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَبِي أُسَامَةَ الْحَلَبِيُّ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  (  ح  ) .         [19/221]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عَلِيُّ بْنُ بَحْرٍ - قَالُوا :  ثَنَا  مُبَشِّرُ بْنُ إِسْمَاعِيلَ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ الْعَلَاءِ بْنِ اللَّجْلَاجِ ،  عَنْ  أَبِيهِ  قَالَ  :  قَالَ لِي أَبِي :  يَا بُنَيَّ ، إِذَا أَنَا مُتُّ فَأَلْحِدْنِي ، فَإِذَا وَضَعْتَنِي فِي لَحْدِي فَقُلْ : بِسْمِ اللهِ وَعَلَى مِلَّةِ رَسُولِ اللهِ  ، ثُمَّ سِنَّ عَلَيَّ  الثَّرَى  سِنًّا ، ثُمَّ اقْرَأْ عِنْدَ رَأْسِي بِفَاتِحَةِ الْبَقَرَةِ وَخَاتِمَتِهَا  ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ ذَلِكَ  .","","Al-Mu'jam al-Kabir 491","","لجلاج الغطفانى عن العلاء بن اللجلاج الغطفاني عن عبد الرحمن بن العلاء بن اللجلاج الغطفاني عن مبشر بن إسماعيل الحلبي عن علي بن بحر بن بري القطان عن الحسين بن إسحاق التستري عن الطبراني","لجلاج أبو خالد"
"17572","مَنِ اسْمُهُ لَبِيبَةُ  لَبِيبَةُ الْأَنْصَارِيُّ  492  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبَّادٍ  ، ثَنَا  إِسْحَاقُ بْنُ بُهْلُولٍ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  عَنْ  يَحْيَى بْنِ عَبْدِ الرَّحْمَنِ بْنِ لَبِيبَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا قَرَأَ هَذِهِ الْآيَةَ :         {      فَكَيْفَ إِذَا جِئْنَا مِنْ كُلِّ أُمَّةٍ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَى هَؤُلاءِ شَهِيدًا         }      بَكَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَالَ :  يَا رَبِّ ، هَذَا شَهِدْتُ عَلَى مَنْ أَنَا بَيْنَ ظَهْرَيْهِ ، فَكَيْفَ بِمَنْ لَمْ أَرَ . ؟","","Al-Mu'jam al-Kabir 492","","أبو لبيبة الأشهلى عن محمد بن عبد الرحمن بن لبيبة المكي عن يحيى بن محمد ابن أبي لبيبة المدني عن محمد بن إسماعيل بن مسلم الديلي عن إسحاق بن بهلول الأنباري عن القاسم بن عباد الخطابى عن الطبراني","لبيبة الأنصاري"
"17573","493  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبَّادٍ الْخَطَّابِيُّ  ، ثَنَا  إِسْحَاقُ بْنُ بُهْلُولٍ الْأَنْبَارِيُّ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  ثَنَا  يَحْيَى بْنُ عَبْدِ الرَّحْمَنِ بْنِ لَبِيبَةَ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  أُهْدِيَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ خَيْبَرَ  شَاةٌ  مَصْلِيَّةٌ  فَأَكَلَ مِنْهَا هُوَ  وَبِشْرُ بْنُ الْبَرَاءِ بْنِ مَعْرُورٍ ،  فَمَرِضَا مَرَضًا شَدِيدًا ، ثُمَّ إِنَّ  بِشْرًا  مَاتَ ، فَلَمَّا مَاتَ أَرْسَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى  الْيَهُودِيَّةِ  الَّتِي أَهْدَتْهَا فَقَالَ : مَا أَطْعَمْتِنَا وَيْحَكِ ؟ فَقَالَتْ : أَطْعَمْتُكَ السُّمَّ ،         [19/222]      قَالَ : مَا حَمَلَكِ عَلَى ذَلِكَ ؟ قَالَتْ : إِنِّي سَمِعْتُكَ تَذْكُرُ ، فَإِنْ كُنْتَ نَبِيًّا عَلِمْتُ أَنَّهَا لَا تَضُرُّكَ ، وَإِنْ كُنْتَ غَيْرَ ذَلِكَ فَأَرَدْتُ أَنْ أُرِيحَ النَّاسَ مِنْكَ ! ثُمَّ أَمَرَ بِهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصُلِبَتْ  .","","Al-Mu'jam al-Kabir 493","","عبد الرحمن بن نافع الطائفي عن محمد بن عبد الرحمن بن لبيبة المكي عن يحيى بن محمد ابن أبي لبيبة المدني عن محمد بن إسماعيل بن مسلم الديلي عن إسحاق بن بهلول الأنباري عن القاسم بن عباد الخطابى عن الطبراني","لبيبة الأنصاري"
"17574","بَابُ الْمِيمِ  مَنِ اسْمُهُ مُحَمَّدٌ  مُحَمَّدُ بْنُ مَسْلَمَةَ الْأَنْصَارِيُّ ،  بَدْرِيٌّ ، أَقَامَ  بِالْمَدِينَةِ  إِلَى أَنْ مَاتَ بِهَا سَنَةَ ثَلَاثٍ وَأَرْبَعِينَ وَسِنُّهُ سَبْعٌ وَسَبْعُونَ ، وَمِنْ أَخْبَارِهِ وَذِكْرِ سِنِّهِ وَوَفَاتِهِ :  494  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي زَعُورَاءَ بْنِ عَبْدِ الْأَشْهَلِ  مُحَمَّدُ بْنُ مَسْلَمَةَ بْنِ خَالِدِ بْنِ عَدِيِّ بْنِ مَجْدَعَةَ بْنِ حَارِثَةَ بْنِ الْحَارِثِ  .","","Al-Mu'jam al-Kabir 494","","","ومن أخباره وذكر سنه ووفاته"
"17575","495  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  ،  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ثُمَّ مِنَ  الْأَوْسِ  مِنْ  بَنِي حَارِثَةَ ،  مُحَمَّدُ بْنُ مَسْلَمَةَ  .","","Al-Mu'jam al-Kabir 495","","","ومن أخباره وذكر سنه ووفاته"
"17576","496  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ،  ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ السَّدُوسِيُّ  ،  ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي حَارِثَةَ  مُحَمَّدُ بْنُ مَسْلَمَةَ بْنِ         [19/223]      خَالِدِ بْنِ عَدِيِّ بْنِ مَجْدَعَةَ بْنِ حَارِثَةَ بْنِ الْحَارِثِ بْنِ الْخَزْرَجِ بْنِ عَمْرِو بْنِ مَالِكِ بْنِ الْأَوْسِ  ، وَكَانَ حَلِيفًا  لِبَنِي عَبْدِ الْأَشْهَلِ  .","","Al-Mu'jam al-Kabir 496","","","ومن أخباره وذكر سنه ووفاته"
"17577","497  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  قَالَ :  تُوُفِّيَ  مُحَمَّدُ بْنُ مَسْلَمَةَ  بِالْمَدِينَةِ  سَنَةَ ثَلَاثٍ وَأَرْبَعِينَ  ، وَسِنُّهُ سَبْعٌ وَسَبْعُونَ سَنَةً  .","","Al-Mu'jam al-Kabir 497","","","ومن أخباره وذكر سنه ووفاته"
"17578","498  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ،  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ  قَالَ :  مَاتَ  مُحَمَّدُ بْنُ مَسْلَمَةَ  فِي صَفَرٍ سَنَةَ ثَلَاثٍ وَأَرْبَعِينَ  .","","Al-Mu'jam al-Kabir 498","","","ومن أخباره وذكر سنه ووفاته"
"17579","مَا  أَسْنَدَ  مُحَمَّدُ بْنُ مَسْلَمَةَ  سَهْلُ بْنُ أَبِي حَثْمَةَ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  499  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  يَحْيَى بْنِ الْعَلَاءِ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَأَةَ ،  عَنْ  مُحَمَّدِ بْنِ عُثْمَانَ ،  عَنْ  سَهْلِ بْنِ أَبِي حَثْمَةَ قَالَ :  مَرَّ نَاسٌ مِنَ  الْأَنْصَارِ  بِمُحَمَّدِ بْنِ مَسْلَمَةَ وَهُوَ يُطَالِعُ جَارِيَةً مِنْ  بَنِي النَّجَّارِ  ،  فَقَالُوا : سُبْحَانَ اللهِ ، لَوْ فَعَلَ هَذَا بَعْضُ شَبَابِنَا رَأَيْنَاهُ قَبِيحًا !  قَالَ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا أَلْقَى اللهُ فِي قَلْبِ رَجُلٍ خِطْبَةَ امْرَأَةٍ فَلَا بَأْسَ أَنْ يَنْظُرَ إِلَيْهَا -  هَكَذَا قَالَ  يَحْيَى بْنُ الْعَلَاءِ  عَنِ  الْحَجَّاجِ  ، عَنْ  مُحَمَّدِ بْنِ عُثْمَانَ  .","","Al-Mu'jam al-Kabir 499","","محمد بن مسلمة بن سلمة الخزرجي عن سهل بن أبي حثمة الخزرجي عن محمد بن عثمان عن حجاج بن أرطاة عن يحيى بن العلاء الفوراردي عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","سهل بن أبي حثمة عن محمد بن مسلمة"
"17580","[19/224]      500  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ ،  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  حَفْصُ بْنُ غِيَاثٍ ،  عَنِ  الْحَجَّاجِ ،  عَنْ  مُحَمَّدِ بْنِ سُلَيْمَانَ ،  عَنْ  عَمِّهِ سَهْلِ بْنِ أَبِي حَثْمَةَ ،  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ قَالَ :  خَطَبْتُ امْرَأَةً فَجَعَلْتُ أَتَخَبَّأُ لَهَا حَتَّى نَظَرْتُ إِلَيْهَا  ، فَقِيلَ لَهُ : أَتَفْعَلُ هَذَا وَأَنْتَ صَاحِبُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا أَلْقَى اللهُ فِي قَلْبِ أَحَدٍ مِنْكُمْ خِطْبَةَ امْرَأَةٍ فَلَا بَأْسَ أَنْ يَنْظُرَ إِلَيْهَا  .  هَكَذَا رَوَاهُ  حَفْصُ بْنُ غِيَاثٍ ،  وَتَابَعَهُ  يَزِيدُ بْنُ هَارُونَ  .","","Al-Mu'jam al-Kabir 500","","محمد بن مسلمة بن سلمة الخزرجي عن سهل بن أبي حثمة الخزرجي عن محمد بن سليمان بن أبي حثمة الأنصاري عن حجاج بن أرطاة عن حفص بن غياث النخعي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","سهل بن أبي حثمة عن محمد بن مسلمة"
"17581","501  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  يَزِيدُ بْنُ هَارُونَ ،  ثَنَا  الْحَجَّاجُ بْنُ أَرْطَأَةَ ،  عَنْ  مُحَمَّدِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ ،  عَنْ  سَهْلِ بْنِ أَبِي حَثْمَةَ قَالَ :  رَأَيْتُ  مُحَمَّدَ بْنَ مَسْلَمَةَ يُطَارِدُ ابْنَةَ الضَّحَّاكِ بِبَصَرِهِ  ، فَقُلْتُ : سُبْحَانَ اللهِ ، تَنْظُرُ إِلَيْهَا وَأَنْتَ مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ! فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ         [19/225]      وَسَلَّمَ - يَقُولُ :  إِذَا أَلْقَى اللهُ فِي قَلْبِ امْرِئٍ خِطْبَةَ امْرَأَةٍ فَلَا بَأْسَ أَنْ يَنْظُرَ إِلَيْهَا  .  وَرَوَاهُ  يَحْيَى بْنُ سَعِيدٍ  عَنْ  مُحَمَّدِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ  عَنْ عَمِّهِ  سَهْلِ بْنِ أَبِي حَثْمَةَ  ، كَمَا رَوَاهُ  حَفْصُ بْنُ غِيَاثٍ  وَيَزِيدُ بْنُ هَارُونَ  عَنِ  الْحَجَّاجِ  .","","Al-Mu'jam al-Kabir 501","","محمد بن مسلمة بن سلمة الخزرجي عن سهل بن أبي حثمة الخزرجي عن محمد بن سليمان بن أبي حثمة الأنصاري عن حجاج بن أرطاة عن يزيد بن هارون عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","سهل بن أبي حثمة عن محمد بن مسلمة"
"17582","502  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ مُوسَى بْنِ شَيْبَةَ الْأَنْصَارِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ صِرْمَةَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ الْأَنْصَارِيِّ ،  عَنْ  عَمِّهِ سَهْلِ بْنِ أَبِي حَثْمَةَ الْأَنْصَارِيِّ قَالَ :  كُنْتُ جَالِسًا مَعَ مُحَمَّدِ بْنِ مَسْلَمَةَ فَمَرَّتْ بِنْتُ الضَّحَّاكِ مِنْ خَلْفِهِ فَجَعَلَ يُطَارِدُهَا  بِبَصَرِهِ  ، فَقُلْتُ : سُبْحَانَ اللهِ ، تَفْعَلُ هَذَا وَأَنْتَ صَاحِبُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ !  فَقَالَ  : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا أَلْقَى اللهُ خِطْبَةَ امْرَأَةٍ فِي قَلْبِ رَجُلٍ فَلَا بَأْسَ أَنْ يَنْظُرَ إِلَيْهَا  .","","Al-Mu'jam al-Kabir 502","","محمد بن مسلمة بن سلمة الخزرجي عن سهل بن أبي حثمة الخزرجي عن محمد بن سليمان بن أبي حثمة الأنصاري عن يحيى بن سعيد الأنصاري عن إبراهيم بن صرمة المديني عن عبد الله بن موسى بن شيبة النهروانى عن عبد الله بن أحمد بن حنبل عن الطبراني","سهل بن أبي حثمة عن محمد بن مسلمة"
"17583","503  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْوَهَّابِ الْجُمَحِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  ثَنَا  الْحَجَّاجُ بْنُ أَرْطَأَةَ ،  عَنْ  مُحَمَّدِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ ،  عَنْ  أَبِيهِ  قَالَ :  كُنْتُ قَاعِدًا مَعَ مُحَمَّدِ بْنِ مَسْلَمَةَ الْأَنْصَارِيِّ فِي دَارِهِ ، فَرَأَى جَارِيَةً مِنَ  الْأَنْصَارِ  فَطَرَدَهَا بِبَصَرِهِ  ، فَقُلْتُ لَهُ : يَرْحَمُكَ اللهُ ، تَنْظُرُ إِلَيْهَا هَذَا النَّظَرَ !  فَقَالَ  : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا قَذَفَ اللهُ فِي قَلْبِ امْرِئٍ خِطْبَةَ امْرَأَةٍ فَلَا بَأْسَ أَنْ يَنْظُرَ إِلَيْهَا  .  هَكَذَا رَوَاهُ  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ  عَنِ  الْحَجَّاجِ  عَنْ  مُحَمَّدِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ  عَنْ أَبِيهِ .","","Al-Mu'jam al-Kabir 503","","محمد بن مسلمة بن سلمة الخزرجي عن سليمان بن أبي حثمة العدوي عن محمد بن سليمان بن أبي حثمة الأنصاري عن حجاج بن أرطاة عن عبد الواحد بن زياد عن عبد الله بن عبد الوهاب الحجبي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سهل بن أبي حثمة عن محمد بن مسلمة"
"17584","504  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،         [19/226]      ثَنَا  أَبُو مُعَاوِيَةَ ،  ثَنَا  الْحَجَّاجُ ،  عَنْ  سَهْلِ بْنِ مُحَمَّدِ بْنِ أَبِي حَثْمَةَ ،  عَنْ  عَمِّهِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ قَالَ :  رَأَيْتُ  مُحَمَّدَ بْنَ مَسْلَمَةَ يُطَارِدُ  ثُبَيْتَةَ بِنْتَ الضَّحَّاكِ  عَلَى بَعْضِ مَنَازِلِ  الْمَدِينَةِ  بِبَصَرِهِ  ، فَقُلْتُ : تَفْعَلُ هَذَا ؟ فَقَالَ : نَعَمْ ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا أَلْقَى اللهُ فِي قَلْبِ امْرِئٍ خِطْبَةَ امْرَأَةٍ فَلَا بَأْسَ أَنْ يَنْظُرَ  إِلَيْهَا  . هَكَذَا رَوَاهُ  أَبُو مُعَاوِيَةَ  عَنِ  الْحَجَّاجِ  عَنْ  سَهْلِ بْنِ مُحَمَّدِ بْنِ أَبِي حَثْمَةَ  عَنْ عَمِّهِ  سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ  .","","Al-Mu'jam al-Kabir 504","","محمد بن مسلمة بن سلمة الخزرجي عن سليمان بن أبي حثمة العدوي عن سهل بن محمد بن أبي حثمة عن حجاج بن أرطاة عن أبو معاوية الضرير عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","سهل بن أبي حثمة عن محمد بن مسلمة"
"17585","505  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنِ  الْحَجَّاجِ بْنِ أَرْطَأَةَ ،  عَنْ  مُحَمَّدِ بْنِ سَهْلِ بْنِ حُنَيْفٍ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَيْتُ  مُحَمَّدَ بْنَ مَسْلَمَةَ الْأَنْصَارِيَّ رَأَى بِنْتَ الضَّحَّاكِ عَلَى جِدَارٍ تَلْعَبُ ، فَجَعَلَ يَنْظُرُ إِلَيْهَا  ، فَقِيلَ لَهُ : أَتَنْظُرُ إِلَيْهَا وَأَنْتَ صَاحِبُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ! قَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِذَا قَذَفَ اللهُ فِي قَلْبِ امْرِئٍ خِطْبَةَ امْرَأَةٍ فَلَا بَأْسَ أَنْ يَنْظُرَ إِلَيْهَا .  هَكَذَا رَوَاهُ  حَمَّادُ بْنُ سَلَمَةَ  وَخَالَفَ النَّاسَ فِيهِ ، قَدِ اخْتَلَفَ الرُّوَاةُ عَنِ  الْحَجَّاجِ بْنِ أَرْطَأَةَ  فِي هَذَا الْحَدِيثِ ، وَالصَّوَابُ عِنْدِي - وَاللهُ أَعْلَمُ - مَا رَوَاهُ  حَفْصُ بْنُ غِيَاثٍ  وَيَزِيدُ بْنُ هَارُونَ  عَنِ  الْحَجَّاجِ  عَنْ  مُحَمَّدِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ  عَنْ عَمِّهِ  سَهْلِ بْنِ أَبِي حَثْمَةَ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  .","","Al-Mu'jam al-Kabir 505","","محمد بن مسلمة بن سلمة الخزرجي عن سهل بن أبي حثمة الخزرجي عن محمد بن سهل بن أبي حثمة الأوسي عن حجاج بن أرطاة عن حماد بن سلمة عن سليمان بن حرب الواشحي عن يوسف القاضي ابن حماد بن زيد بن درهم عن الطبراني","سهل بن أبي حثمة عن محمد بن مسلمة"
"17586","عُرْوَةُ بْنُ الزُّبَيْرِ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  506  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ         [19/227]      جُرَيْجٍ ،  أَخْبَرَنِي  هِشَامُ بْنُ عُرْوَةَ ، عَنْ عُرْوَةَ  أَنَّهُ  حَدَّثَ  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ ، عَنْ  عُمَرَ  حَدِيثًا فِي  إِمْلَاصِ  الْمَرْأَةِ ، فَقَالَ  الْمُغِيرَةُ  :  قَضَى فِيهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِغُرَّةٍ  ، فَقَالَ  عُمَرُ  : إِنْ كُنْتَ صَادِقًا فَائْتِ بِأَحَدٍ يَعْلَمُ ذَلِكَ ! فَشَهِدَ مُحَمَّدُ بْنُ مَسْلَمَةَ بِأَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَضَى فِيهِ بِغُرَّةٍ  .","","Al-Mu'jam al-Kabir 506","","محمد بن مسلمة بن سلمة الخزرجي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عروة بن الزبير عن محمد بن مسلمة"
"17587","507  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  أَنَّ  عُمَرَ  اسْتَشَارَ النَّاسَ فِي الْجَنِينِ تَطْرَحُهُ الْمَرْأَةُ ، فَقَالَ  الْمُغِيرَةُ  :  قَضَى فِيهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِغُرَّةٍ  عَبْدٍ أَوْ وَلِيدَةٍ  ، فَقَالَ  عُمَرُ  : إِنْ كُنْتَ صَادِقًا فَائْتِ بِأَحَدٍ يَشْهَدُ مَعَكَ ! فَشَهِدَ مُحَمَّدُ بْنُ مَسْلَمَةَ أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَضَى بِهِ  .","","Al-Mu'jam al-Kabir 507","","محمد بن مسلمة بن سلمة الخزرجي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن أنس بن عياض الليثي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","عروة بن الزبير عن محمد بن مسلمة"
"17588","508  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الشَّافِعِيُّ الْمَكِّيُّ ،  ثَنَا  عَمِّي إِبْرَاهِيمُ بْنُ مُحَمَّدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْمُغِيرَةِ بْنِ شُعْبَةَ  أَنَّ  عُمَرَ  سَأَلَ عَنِ الْجَنِينِ ، فَقَالَ  الْمُغِيرَةُ  :  قَضَى فِيهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِغُرَّةٍ  عَبْدٍ أَوْ أَمَةٍ  ، فَقَالَ  عُمَرُ  : مَنْ يَشْهَدُ مَعَكَ إِنْ كُنْتَ صَادِقًا ؟ فَشَهِدَ مُحَمَّدُ بْنُ مَسْلَمَةَ أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَضَى بِذَلِكَ  .","","Al-Mu'jam al-Kabir 508","","محمد بن مسلمة بن سلمة الخزرجي عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبد العزيز بن أبي حازم المخزومي عن إبراهيم بن محمد بن العباس المطلبي عن أحمد بن محمد ابن بنت الشافعى عن الطبراني","عروة بن الزبير عن محمد بن مسلمة"
"17589","509  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ  (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  وَكِيعٌ وَعَبْدَةُ بْنُ سُلَيْمَانَ ،  عَنْ  هِشَامِ بْنِ عُرْوَةَ ،  عَنْ  أَبِيهِ ،  عَنِ  الْمِسْوَرِ بْنِ مَخْرَمَةَ  أَنَّ  عُمَرَ بْنَ الْخَطَّابِ  اسْتَشَارَ النَّاسَ فِي  إِمْلَاصِ  الْمَرْأَةِ ، فَقَالَ الْمُغِيرَةُ بْنُ شُعْبَةَ :  شَهِدْتُ         [19/228]      رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَضَى فِيهَا  بِغُرَّةٍ  عَبْدٍ أَوْ أَمَةٍ .  قَالَ : فَائْتِنِي بِمَنْ يَشْهَدُ مَعَكَ ! فَأَتَاهُ بِمُحَمَّدِ بْنِ مَسْلَمَةَ  .","","Al-Mu'jam al-Kabir 509","","محمد بن مسلمة بن سلمة الخزرجي عن المسور بن مخرمة عن عروة بن الزبير عن هشام بن عروة بن الزبير عن عبدة بن سليمان الكلابي عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","عروة بن الزبير عن محمد بن مسلمة"
"17590","قَبِيصَةُ بْنُ ذُؤَيْبٍ الْخُزَاعِيُّ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  510  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ الْخُزَاعِيِّ قَالَ :  جَاءَتِ الْجَدَّةُ إِلَى أَبِي بَكْرٍ تَطْلُبُ مِيرَاثَهَا مِنِ  ابْنِهَا أَوِ ابْنَتِهَا  ،  فَقَالَ  أَبُو بَكْرٍ  : مَا أَجِدُ لَكِ فِي كِتَابِ اللهِ شَيْئًا ، وَمَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْضِي لَكِ بِشَيْءٍ ، وَسَأَسْأَلُ النَّاسَ الْعَشِيَّةَ . فَلَمَّا صَلَّى الظُّهْرَ أَقْبَلَ عَلَى النَّاسِ فَقَالَ : إِنَّ الْجَدَّةَ أَتَتْنِي تَسْأَلُ مِيرَاثَهَا مِنَ ابْنِهَا أَوِ ابْنَتِهَا ، وَإِنِّي لَمْ أَجِدْ لَهَا فِي الْكِتَابِ شَيْئًا ، وَمَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْضِي لَهَا بِشَيْءٍ ، فَهَلْ سَمِعَ أَحَدٌ مِنْكُمْ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِيهَا شَيْئًا ؟ فَقَامَ الْمُغِيرَةُ بْنُ شُعْبَةَ فَقَالَ :  شَهِدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْضِي لَهَا بِالسُّدُسِ  ، فَأَعْطَاهَا  أَبُو بَكْرٍ  السُّدُسَ ، فَقَالَ : هَلْ سَمِعَ ذَلِكَ مَعَكَ أَحَدٌ ؟ فَقَامَ مُحَمَّدُ بْنُ مَسْلَمَةَ فَقَالَ : شَهِدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقْضِي لَهَا بِالسُّدُسِ ، فَأَعْطَاهَا  أَبُو بَكْرٍ  السُّدُسَ ، فَلَمَّا كَانَتْ خِلَافَةُ  عُمَرَ  جَاءَتْهُ الْجَدَّةُ الَّتِي تُخَالِفُهَا ،  فَقَالَ  عُمَرُ : إِنَّمَا كَانَ الْقَضَاءُ فِي غَيْرِكِ ، وَلَكِنْ إِذَا اجْتَمَعْتُمَا فَالسُّدُسُ بَيْنَكُمَا ، وَأَيَّتُكُمَا خَلَتْ فَهُوَ لَهَا  .","","Al-Mu'jam al-Kabir 510","","عمر بن الخطاب عن قبيصة بن ذؤيب الخزاعي عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","قبيصة بن ذؤيب الخزاعي عن محمد بن مسلمة"
"17591","[19/229]      511  -  حَدَّثَنَا  أَبُو يَزِيدُ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ الْحَكَمِ  ،  أَنَا  مَالِكٌ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُثْمَانَ بْنِ إِسْحَاقَ بْنِ خَرَشَةَ ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ قَالَ :  جَاءَتِ الْجَدَّةُ إِلَى  أَبِي بَكْرٍ الصِّدِّيقِ  تَسْأَلُهُ مِيرَاثَهَا فِي كِتَابِ اللهِ  ،  فَقَالَ  لَهَا  أَبُو بَكْرٍ  : مَا لَكِ فِي كِتَابِ اللهِ شَيْءٌ ، وَمَا عَلِمْتُ لَكِ فِي سُنَّةِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - شَيْئًا ، فَارْجِعِي حَتَّى أَسْأَلَ النَّاسَ ! فَسَأَلَ النَّاسَ ، فَقَالَ الْمُغِيرَةُ بْنُ شُعْبَةَ :  حَضَرْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَعْطَاهَا السُّدُسَ  ، فَقَالَ  أَبُو بَكْرٍ  : هَلْ مَعَكَ غَيْرُكَ ؟ فَقَامَ مُحَمَّدُ بْنُ مَسْلَمَةَ الْأَنْصَارِيُّ فَقَالَ مِثْلَ مَا قَالَ  الْمُغِيرَةُ ،  فَأَنْفَذَهُ لَهَا أَبُو بَكْرٍ ، ثُمَّ جَاءَتِ الْجَدَّةُ الْأُخْرَى عُمَرَ بْنَ الْخَطَّابِ تَسْأَلُهُ مِيرَاثَهَا ،  فَقَالَ  :  مَا لَكِ فِي كِتَابِ اللهِ مِنْ شَيْءٍ ، وَمَا كَانَ الْقَضَاءُ الَّذِي قُضِيَ بِهِ إِلَّا لِغَيْرِكِ  ، وَمَا أَنَا بِزَائِدٍ فِي الْفَرَائِضِ شَيْئًا ، وَلَكِنْ هُوَ ذَلِكَ السُّدُسُ ، فَإِنِ اجْتَمَعْتُمَا فِيهِ فَهُوَ بَيْنَكُمَا وَأَيُّكُمَا خَلَتْ بِهِ فَهُوَ لَهَا  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبد الله بن عبد الحكم ).","","Al-Mu'jam al-Kabir 511","","عمر بن الخطاب عن قبيصة بن ذؤيب الخزاعي عن عثمان بن إسحاق بن خرشة العامري عن الزهري عن مالك بن أنس عن عبد الله بن عبد الحكم بن أعين عن يوسف بن يزيد القراطيسي عن الطبراني","قبيصة بن ذؤيب الخزاعي عن محمد بن مسلمة"
"17592","[19/230]      512  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  يُوسُفُ بْنُ مُوسَى الْقَطَّانُ ،  ثَنَا  جَرِيرٌ ،  عَنْ  أَشْعَثَ بْنِ سَوَّارٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  قَبِيصَةَ بْنِ ذُؤَيْبٍ قَالَ :  جَاءَتِ  الْجَدَّةُ إِلَى أَبِي بَكْرٍ فَقَالَتْ :  إِنَّ ابْنَ ابْنِي أَوِ ابْنَ بِنْتِي مَاتَ  ، فَذَكَرَ أَنَّ لِي حَقًّا فِيمَا تَرَكَ ، فَمَا حَقِّي ؟  قَالَ  أَبُو بَكْرٍ  : مَا أَعْلَمُ لَكِ فِي كِتَابِ اللهِ شَيْئًا ، وَسَأَسْأَلُ ، فَارْجِعِي . فَلَمَّا صَلَّى الظُّهْرَ قَالَ : مَنْ سَمِعَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي الْجَدَّاتِ شَيْئًا ؟ قَالَ الْمُغِيرَةُ بْنُ شُعْبَةَ : أَنَا سَمِعْتُهُ ، قَالَ : كَيْفَ سَمِعْتَهُ ؟ قَالَ :  أَعْطَى الْجَدَّةَ السُّدُسَ  ، قَالَ : هَلْ عَلِمَ ذَلِكَ أَحَدٌ غَيْرُكَ ؟ فَقَامَ مُحَمَّدُ بْنُ مَسْلَمَةَ فَقَالَ : صَدَقَ ، هُوَ كَمَا قَالَ . قَالَ : فَجَاءَتِ الْمَرْأَةُ فَأَعْطَاهَا السُّدُسَ ، فَلَمَّا قُبِضَ  أَبُو بَكْرٍ  - رَضِيَ اللهُ عَنْهُ - وَكَانَ  عُمَرُ  - رَضِيَ اللهُ عَنْهُ - أَتَتْهُ امْرَأَةٌ فِي مِثْلِ ذَلِكَ ، فَقَالَتْ مَا قَالَتِ الْمَرْأَةُ الَّتِي قَالَتْ  لِأَبِي بَكْرٍ  ، فَرَدَّ عَلَيْهَا مِثْلَ قَوْلِهِ ، ثُمَّ سَأَلَ فَقَالُوا : إِنَّ  الْمُغِيرَةَ  قَالَ كَذَا وَكَذَا ، وَشَهِدَ مَعَهُ  مُحَمَّدُ بْنُ مَسْلَمَةَ  فَأَعْطَاهَا السُّدُسَ ،  وَقَالَ  عُمَرُ مِنْ قِبَلِهِ :  إِذَا اجْتَمَعْتُمَا فَهُوَ لَكُمَا ، وَأَيُّكُمَا خَلَتْ بِهِ فَهُوَ لَهَا  .","","Al-Mu'jam al-Kabir 512","","عمر بن الخطاب عن قبيصة بن ذؤيب الخزاعي عن الزهري عن أشعث بن سوار عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن أحمد بن يحيى بن زهير التستري عن الطبراني","قبيصة بن ذؤيب الخزاعي عن محمد بن مسلمة"
"17593","مَحْمُودُ بْنُ لَبِيدٍ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  513  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ وَمُوسَى بْنُ هَارُونَ قَالَا :  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  سَالِمِ بْنِ صَالِحِ بْنِ إِبْرَاهِيمَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَحْمُودِ بْنِ لَبِيدٍ ،  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، كَيْفَ أَصْنَعُ إِذَا اخْتَلَفَ الْمُصَلُّونَ ؟ قَالَ :  تَخْرُجُ بِسَيْفِكَ إِلَى  الْحَرَّةِ  فَتَضْرِبُهَا بِهِ  ، ثُمَّ تَدْخُلُ بَيْتَكَ حَتَّى يَأْتِيَكَ مَنِيَّةٌ قَاضِيَةٌ أَوْ يَدٌ خَاطِئَةٌ  .","","Al-Mu'jam al-Kabir 513","","محمد بن مسلمة بن سلمة الخزرجي عن محمود بن لبيد الأشهلي عن صالح بن إبراهيم بن عبد الرحمن بن عوف عن سالم بن صالح بن إبراهيم الرازي عن إبراهيم بن سعد أبو إسحاق الزهري عن يحيى بن عبد الحميد عن موسى بن هارون الحمال عن الطبراني","محمود بن لبيد عن محمد بن مسلمة"
"17594","[19/231]      جَعْفَرُ بْنُ مَحْمُودِ بْنِ مَسْلَمَةَ  عَنْ عَمِّهِ  مُحَمَّدِ بْنِ مَسْلَمَةَ  514  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  عَمِّي الْقَاسِمُ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  ذُؤَيْبُ بْنُ عِمَامَةَ ،  عَنْ  إِبْرَاهِيمَ بْنِ جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ ،  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  قَالَ :  لَمَّا حَكَمَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي  بَنِي قُرَيْظَةَ  وَجَدَتِ  الْأَوْسُ  مِنْ ذَلِكَ ،  فَأَرْسَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَى كُلِّ دَارٍ مِنْ دُورِ  الْأَوْسِ  بِأَسِيرَيْنِ ، وَأَرْسَلَ إِلَى  بَنِي حَارِثَةَ  بِأَسِيرَيْنِ  .","","Al-Mu'jam al-Kabir 514","","محمد بن مسلمة بن سلمة الخزرجي عن جعفر بن محمود بن عبد الله الحارثي عن إبراهيم بن جعفر بن محمود الحارثى عن ذؤيب بن عمامة السهمي عن قاسم بن محمد بن أبي شيبة العبسي عن محمد بن عثمان بن أبي شيبة عن الطبراني","جعفر بن محمود بن مسلمة عن عمه محمد بن مسلمة"
"17595","عَبْدُ الرَّحْمَنِ الْأَعْرَجُ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  515  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  مُحَمَّدُ بْنُ حِمْيَرَ ،  حَدَّثَنِي  شُعَيْبُ بْنُ أَبِي حَمْزَةَ ،  عَنْ  مُحَمَّدِ بْنِ الْمُنْكَدِرِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ الْأَعْرَجِ ،  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا قَامَ يُصَلِّي قَالَ :  اللهُ أَكْبَرُ ،  وَجَّهْتُ  وَجْهِيَ لِلَّذِي فَطَرَ السَّمَاوَاتِ وَالْأَرْضَ حَنِيفًا مُسْلِمًا وَمَا أَنَا مِنَ الْمُشْرِكِينَ  ، إِنَّ صَلَاتِي  وَنُسُكِي  وَمَحْيَايَ وَمَمَاتِي لِلهِ رَبِّ الْعَالَمِينَ لَا شَرِيكَ لَهُ وَبِذَلِكَ أُمِرْتُ وَأَنَا أَوَّلُ الْمُسْلِمِينَ ، اللَّهُمَّ أَنْتَ الْمَلِكُ لَا إِلَهَ إِلَّا أَنْتَ سُبْحَانَكَ  وَبِحَمْدِكَ  - ثُمَّ يَقْرَأُ ، فَيَقُولُ إِذَا رَكَعَ : اللَّهُمَّ لَكَ رَكَعْتُ ، وَبِكَ آمَنْتُ ، وَلَكَ أَسْلَمْتُ وَعَلَيْكَ تَوَكَّلْتُ ، أَنْتَ رَبِّي ، رَكَعَ لَكَ جَمِيعُ سَمْعِي وَبَصَرِي وَلَحْمِي وَدَمِي وَمُخِّي لِلهِ رَبِّ الْعَالَمِينَ ، ثُمَّ يَرْفَعُ رَأْسَهُ فَيَقُولُ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، رَبَّنَا وَلَكَ الْحَمْدُ  مِلْءَ  السَّمَاوَاتِ         [19/232]      وَمِلْءَ الْأَرْضِ وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ ، وَإِذَا سَجَدَ قَالَ : اللَّهُمَّ لَكَ سَجَدْتُ وَبِكَ آمَنْتُ وَلَكَ أَسْلَمْتُ ، أَنْتَ رَبِّي ، سَجَدَ وَجْهِي لِلَّذِي خَلَقَهُ وَصَوَّرَهُ وَشَقَّ سَمْعَهُ وَبَصَرَهُ ، تَبَارَكَ اللهُ أَحْسَنُ الْخَالِقِينَ  .","","Al-Mu'jam al-Kabir 515","","محمد بن مسلمة بن سلمة الخزرجي عن عبد الرحمن بن هرمز الأعرج عن محمد بن المنكدر عن شعيب بن أبي حمزة الحمصي عن محمد بن حمير القضاعي عن محمد بن مصفى بن بهلول عن أحمد بن النضر بن بحر العسكري عن الطبراني","عبد الرحمن الأعرج عن محمد بن مسلمة"
"17596","516  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ وَالْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ قَالَا :  ثَنَا  يَحْيَى بْنُ عُثْمَانَ الْحِمْصِيُّ ،  ثَنَا  أَبُو حَيْوَةَ شُرَيْحُ بْنُ يَزِيدَ ،  ثَنَا  شُعَيْبُ بْنُ أَبِي حَمْزَةَ ،  عَنْ  إِسْحَاقَ بْنِ عَبْدِ اللهِ بْنِ أَبِي فَرْوَةَ ،  عَنِ  الْأَعْرَجِ ،  عَنْ  عُبَيْدِ اللهِ بْنِ أَبِي رَافِعٍ ،  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُولُ فِي سُجُودِهِ :  اللَّهُمَّ لَكَ سَجَدْتُ ، وَبِكَ آمَنْتُ ، وَلَكَ أَسْلَمْتُ  ، وَأَنْتَ رَبِّي ، سَجَدَ وَجْهِي لِلَّذِي خَلَقَهُ وَصَوَّرَهُ وَشَقَّ سَمْعَهُ وَبَصَرَهُ ، تَبَارَكَ اللهُ أَحْسَنُ الْخَالِقِينَ ، وَإِذَا رَكَعَ قَالَ : اللَّهُمَّ لَكَ رَكَعْتُ وَبِكَ آمَنْتُ وَلَكَ أَسْلَمْتُ وَعَلَيْكَ تَوَكَّلْتُ ، أَنْتَ رَبِّي ،  خَشَعَ  سَمْعِي وَبَصَرِي وَدَمِي وَمُخِّي وَعَظْمِي وَعَصَبِي لِلهِ رَبِّ الْعَالَمِينَ ، ثُمَّ يَرْفَعُ رَأْسَهُ مِنَ الرُّكُوعِ فَيَقُولُ :  سَمِعَ  اللهُ لِمَنْ حَمِدَهُ ، رَبَّنَا وَلَكَ الْحَمْدُ  مِلْءَ  السَّمَاوَاتِ وَمِلْءَ الْأَرْضِ وَمِلْءَ مَا شِئْتَ مِنْ شَيْءٍ بَعْدُ  .","","Al-Mu'jam al-Kabir 516","","محمد بن مسلمة بن سلمة الخزرجي عن عبيد الله بن أبي رافع مولى رسول الله عن عبد الرحمن بن هرمز الأعرج عن إسحاق بن أبي فروة عن شعيب بن أبي حمزة الحمصي عن شريح بن يزيد الحمصي عن يحيى بن عثمان بن سعيد الحمصي عن الحسين بن إسحاق التستري عن الطبراني","عبد الرحمن الأعرج عن محمد بن مسلمة"
"17597","أَبُو بُرْدَةَ بْنُ أَبِي مُوسَى  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  517  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا         [19/233]      حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  ثَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنْ  أَبِي بُرْدَةَ قَالَ :  مَرَرْنَا  بِالرَّبَذَةِ  وَإِذَا  فُسْطَاطٌ  ، قُلْتُ : لِمَنْ هَذَا ؟ قِيلَ : لِمُحَمَّدِ بْنِ مَسْلَمَةَ ، فَدَخَلْتُ عَلَيْهِ فَقَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَا  مُحَمَّدَ بْنَ مَسْلَمَةَ ،  إِنَّهَا سَتَكُونُ فِتْنَةٌ وَفُرْقَةٌ وَاخْتِلَافٌ  ، فَإِذَا كَانَ ذَلِكَ فَاكْسِرْ سَيْفَكَ ، وَاكْسِرْ نَبْلَكَ ، وَاقْطَعْ وَتَرَكَ ، وَاجْلِسْ فِي بَيْتِكَ . فَقَدْ وَقَعَتِ الْفِتْنَةُ وَفَعَلْتُ الَّذِي أَمَرَنِي بِهِ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَالْتَفَتُّ فَإِذَا السَّيْفُ مُعَلَّقٌ بِعَمُودِ  الْفُسْطَاطِ  ،  فَانْتَصَلْتُهُ  فَإِذَا سَيْفٌ مِنْ خَشَبٍ ، قَالَ : قَدْ فَعَلْتُ مَا أَمَرَنِي بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاتَّخَذْتُ هَذَا أَهِيبُ بِهِ النَّاسَ  .","","Al-Mu'jam al-Kabir 517","","محمد بن مسلمة بن سلمة الخزرجي عن أبو بردة بن أبي موسى الأشعري عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","أبو بردة بن أبي موسى عن محمد بن مسلمة"
"17598","يُوسُفُ بْنُ مِهْرَانَ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  518  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْقَاسِمُ بْنُ سَعِيدِ بْنِ الْمُسَيِّبِ بْنِ شَرِيكٍ ،  ثَنَا  الْأَسْوَدُ بْنُ عَامِرٍ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  يُوسُفَ بْنِ مِهْرَانَ  أَنَّ  مُحَمَّدَ بْنَ مَسْلَمَةَ قَالَ :  قَالَ لِي رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّهَا سَتَكُونُ فُرْقَةٌ وَفِتْنَةٌ وَاخْتِلَافٌ  ، فَاضْرِبْ بِسَيْفِكَ عُرْضَ  أُحُدٍ  ، وَاجْلِسْ فِي بَيْتِكَ حَتَّى يَأْتِيَكَ يَدٌ خَاطِئَةٌ أَوْ يُعَافِيَكَ اللهُ  .","","Al-Mu'jam al-Kabir 518","","محمد بن مسلمة بن سلمة الخزرجي عن يوسف بن مهران البصري عن علي بن زيد بن جدعان عن حماد بن زيد عن الأسود بن عامر شاذان عن القاسم بن سعيد بن المسيب التميمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","يوسف بن مهران عن محمد بن مسلمة"
"17599","الْمُهَاجِرُ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  519  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ وَأَحْمَدُ بْنُ زَيْدِ بْنِ الْحَرِيشِ الْأَهْوَازِيُّ ، قَالُوا :  ثَنَا  أَحْمَدُ بْنُ عَبْدَةَ         [19/234]      الضَّبِّيُّ ،  ثَنَا  الْحَسَنُ بْنُ صَالِحِ بْنِ أَبِي الْأَسْوَدِ ،  ثَنَا  شَيْخٌ يُكْنَى أَبَا مُحَمَّدٍ ،  ثَنَا  شَيْخٌ يُقَالُ لَهُ الْمُهَاجِرُ فِي مَسْجِدِ الْأَعْظَمِ زَمَنَ  خَالِدٍ  ،  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ الْأَنْصَارِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ لِرَبِّكُمْ فِي أَيَّامِ دَهْرِكُمْ  نَفَحَاتٍ  ، فَتَعَرَّضُوا لَهُ  ، لَعَلَّهُ أَنْ يُصِيبَكُمْ  نَفْحَةٌ  مِنْهَا فَلَا تَشْقَوْنَ بَعْدَهَا أَبَدًا  -  وَاللَّفْظُ  لِإِبْرَاهِيمَ بْنِ هَاشِمٍ  .","","Al-Mu'jam al-Kabir 519","","محمد بن مسلمة بن سلمة الخزرجي عن شيخ يقال له المهاجر عن شيخ يكنى أبا محمد عن الحسن بن صالح بن الأسود الليثي عن أحمد بن عبدة الضبي عن أحمد بن زيد بن الحريش الأهوازي عن الطبراني","المهاجر عن محمد بن مسلمة"
"17600","مُعَاوِيَةُ بْنُ قُرَّةَ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  520  -  حَدَّثَنَا  أَحْمَدُ بْنُ زَيْدِ بْنِ الْحَرِيشِ الْأَهْوَازِيُّ  ، ثَنَا  نَصْرُ بْنُ عَلِيٍّ ،  أَخْبَرَنِي  حَرْبُ بْنُ مَيْمُونٍ ،  عَنِ  الْجَلْدِ بْنِ أَيُّوبَ ،  عَنْ  مُعَاوِيَةَ بْنِ قُرَّةَ قَالَ :  قَالَ  مُحَمَّدُ بْنُ مَسْلَمَةَ :  قَدِمْتُ مِنْ سَفَرٍ فَأَخَذَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِيَدِي  ، فَمَا تَرَكَ يَدِي حَتَّى تَرَكْتُ يَدَهُ  .","","Al-Mu'jam al-Kabir 520","","محمد بن مسلمة بن سلمة الخزرجي عن معاوية بن قرة عن الجلد بن أيوب البصري عن حرب بن ميمون العبدي عن نصر بن علي بن نصر الجهضمي عن أحمد بن زيد بن الحريش الأهوازي عن الطبراني","معاوية بن قرة عن محمد بن مسلمة"
"17601","يُونُسُ بْنُ أَبِي خَلْدَةَ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  521  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ ،  ثَنَا  قُرَيْشُ بْنُ حَيَّانَ ،  عَنْ  يُونُسَ بْنِ أَبِي خَلْدَةَ ،  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَكَلَ آخِرَ أَمْرَيْهِ لَحْمًا  ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 521","","محمد بن مسلمة بن سلمة الخزرجي عن يونس بن أبي خلدة عن قريش بن حيان العجلي عن عبد الرحمن بن المبارك الخلقاني عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","يونس بن أبي خلدة عن محمد بن مسلمة"
"17602","الْحَسَنُ الْبَصْرِيُّ  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  522  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ وَمُحَمَّدُ بْنُ الْعَبَّاسِ         [19/235]      الْأَخْرَمِ الْأَصْبَهَانِيُّ - قَالَا :  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  عَبَّادُ بْنُ مُوسَى السَّعْدِيُّ ،  ثَنَا  يُونُسُ ،  عَنِ  الْحَسَنِ ،  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ قَالَ :  مَرَرْتُ فَإِذَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  الصَّفَا  وَاضِعًا خَدَّهُ عَلَى خَدِّ رَجُلٍ ، فَذَهَبْتُ فَلَمْ أَلْبَثْ أَنْ نَادَانِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : يَا  مُحَمَّدَ بْنَ مَسْلَمَةَ ،  مَا مَنَعَكَ أَنْ تُسَلِّمَ ؟ فَقَالَ  مُحَمَّدُ بْنُ مَسْلَمَةَ  : يَا رَسُولَ اللهِ ، رَأَيْتُكَ فَعَلْتَ بِهَذَا الرَّجُلِ شَيْئًا لَمْ تَفْعَلْهُ بِأَحَدٍ مِنَ النَّاسِ ، فَكَرِهْتُ أَنْ أَقْطَعَكَ مِنْ حَدِيثِكَ ، فَمَنْ كَانَ يَا رَسُولَ اللهِ ؟ قَالَ : كَانَ  جِبْرِيلَ  صَلَّى اللهُ عَلَيْهِ ، وَقَالَ : مَا  لِمُحَمَّدِ بْنِ مَسْلَمَةَ  لَمْ يُسَلِّمْ ؟ أَمَا إِنَّهُ لَوْ سَلَّمَ لَرَدَدْنَا عَلَيْهِ السَّلَامَ ، قَالَ : فَمَا قَالَ لَكَ يَا رَسُولَ اللهِ ؟ قَالَ :  مَا زَالَ يُوصِينِي بِالْجَارِ حَتَّى كُنْتُ أَنْتَظِرُ أَنْ يَأْمُرَنِي بِتَوْرِيثِهِ  .","","Al-Mu'jam al-Kabir 522","","محمد بن مسلمة بن سلمة الخزرجي عن الحسن البصري عن يونس بن عبيد عن عباد بن موسى بن شداد السعدي عن أبو موسى الزمن عن محمد بن العباس ابن الأخرم عن الطبراني","الحسن البصري عن محمد بن مسلمة"
"17603","523  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  زَيْدُ بْنُ الْحُبَابِ ،  ثَنَا  سَهْلُ بْنُ أَبِي الصَّلْتِ قَالَ :  سَمِعْتُ  الْحَسَنَ يَقُولُ :  إِنَّ  عَلِيًّا  بَعَثَ إِلَى مُحَمَّدِ بْنِ مَسْلَمَةَ فَجِيءَ بِهِ ،  فَقَالَ  : مَا خَلَّفَكَ عَنْ هَذَا الْأَمْرِ ؟ فَقَالَ : دَفَعَ إِلَيَّ ابْنُ عَمِّكَ - يَعْنِي رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَيْفًا فَقَالَ :  قَاتِلْ بِهِ مَا قُوتِلَ بِهِ الْعَدُوُّ  ، فَإِذَا رَأَيْتَ النَّاسَ يَقْتُلُ بَعْضُهُمْ بَعْضًا فَاعْمِدْ بِهِ إِلَى صَخْرَةٍ فَاضْرِبْهُ بِهَا ، ثُمَّ الْزَمْ بَيْتَكَ حَتَّى يَأْتِيَكَ مَنِيَّةٌ قَاضِيَةٌ أَوْ يَدٌ خَاطِئَةٌ . قَالَ : خَلُّوا عَنْهُ  .","","Al-Mu'jam al-Kabir 523","","محمد بن مسلمة بن سلمة الخزرجي عن الحسن البصري عن سهل بن أبي الصلت العبسي عن زيد بن الحباب العكلي عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","الحسن البصري عن محمد بن مسلمة"
"17604","[19/236]      رَجُلٌ لَمْ يُسَمَّ عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  524  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْفَضْلِ السَّقَطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ الْوَاسِطِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ سُلَيْمَانَ ،  عَنْ  مُوسَى بْنِ عَبْدَةَ ،  عَنِ  الزُّبَيْرِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ رَافِعِ بْنِ خَدِيجٍ ،  عَنْ  بَعْضِ وَلَدِ مُحَمَّدِ بْنِ مَسْلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ مَسْلَمَةَ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّهَا سَتَكُونُ بَعْدِي فِتَنٌ ،  فَإِنْ أَدْرَكْتَ مِنْهَا شَيْئًا فَائْتِ بِسَيْفِكَ عُرْضَ  الْحَرَّةِ  وَاضْرِبْهَا بِهِ ، وَالْحَقْ  بِالرَّبَذَةِ  فَكُنْ رَبَّ بَعِيرٍ حَتَّى تَقْتُلَكَ يَدٌ خَاطِئَةٌ أَوْ مَنِيَّةٌ قَاضِيَةٌ  .","","Al-Mu'jam al-Kabir 524","","محمد بن مسلمة بن سلمة الخزرجي عن بعض ولد محمد بن مسلمة عن الزبير بن عبد الرحمن بن رافع بن خديج عن موسى بن عبيدة بن نشيط الحميري عن إسحاق بن سليمان الرازي عن سعيد بن سليمان سعدويه عن محمد بن الفضل بن جابر السقطى عن الطبراني","رجل لم يسم عن محمد بن مسلمة"
"17605","مُحَمَّدُ بْنُ صَفْوَانَ  وَقَدْ قِيلَ  صَفْوَانُ بْنُ مُحَمَّدٍ ، وَالصَّوَابُ مُحَمَّدُ بْنُ صَفْوَانَ  525  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  صَفْوَانَ بْنِ مُحَمَّدٍ  أَنَّهُ أَتَى غَنَمَهُ فَصَادَ أَرْنَبَيْنِ فَذَبَحَهُمَا  بِمَرْوَةٍ  ،  فَأَتَى بِهِمَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُتَعَلِّقَهُمَا ، فَقَالَ : يَا رَسُولَ اللهِ ، ذَكَّيْتُهُمَا  بِمَرْوَةٍ  ! فَقَالَ : كُلْهُمَا  .","","Al-Mu'jam al-Kabir 525","","محمد بن صفوان الأنصاري عن الشعبي عن داود بن أبي هند عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن صفوان"
"17606","526  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  عَبْدُ الْأَعْلَى بْنُ عَبْدِ الْأَعْلَى ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنِ  ابْنِ صَفْوَانَ  أَنَّهُ أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِأَرْنَبَيْنِ فَعَلَّقَهُمَا فِي يَدِهِ  ، فَقَالَ : يَا رَسُولَ اللهِ ، إِنِّي أَتَيْتُ غَنَمًا لِي فَوَجَدْتُ هَاتَيْنِ الْأَرْنَبَيْنِ وَلَمْ أَجِدْ حَدِيدَةً أُذَكِّيهِمَا بِهَا فَذَكَّيْتُهُمَا  بِمَرْوَةٍ  ، أَفَآكُلُهُمَا ؟ قَالَ : نَعَمْ  .","","Al-Mu'jam al-Kabir 526","","محمد بن صفوان الأنصاري عن الشعبي عن داود بن أبي هند عن عبد الأعلى بن عبد الأعلى القرشي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","محمد بن صفوان"
"17607","527  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ الْوَارِثِ بْنُ عَبْدِ الصَّمَدِ بْنِ عَبْدِ الْوَارِثِ ،  ثَنَا  أَبِي  (  ح  ) .         [19/237]      وَحَدَّثَنَا  الْحَسَنُ بْنُ عَلِيِّ بْنِ نَصْرٍ الطُّوسِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ يَحْيَى النَّيْسَابُورِيُّ ،  ثَنَا  وَهْبُ بْنُ جَرِيرٍ - قَالَا :  ثَنَا  شُعْبَةُ ،  عَنْ  عَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مُحَمَّدِ بْنِ صَفْوَانَ  أَنَّهُ صَادَ أَرْنَبَيْنِ فَذَبَحَهُمَا  بِمَرْوَةٍ  ، فَسَأَلَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَمَرَهُ بِأَكْلِهِمَا  .","","Al-Mu'jam al-Kabir 527","","محمد بن صفوان الأنصاري عن الشعبي عن عاصم بن سليمان الأحول عن شعبة بن الحجاج عن وهب بن جرير بن حازم عن محمد بن يحيى الذهلي عن أبو علي الطوسي كردوش عن الطبراني","محمد بن صفوان"
"17608","528  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ قَالَا :  ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  عَاصِمٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مُحَمَّدِ بْنِ صَفْوَانَ قَالَ :  ذَبَحْتُ أَرْنَبَيْنِ  بِمَرْوَةٍ  ، فَأَتَيْتُ بِهِمَا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَمَرَنِي بِأَكْلِهِمَا  .","","Al-Mu'jam al-Kabir 528","","محمد بن صفوان الأنصاري عن الشعبي عن عاصم بن سليمان الأحول عن سلام بن سليم الحنفي عن أبو بكر ابن أبي شيبة عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن صفوان"
"17609","529  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ ،  عَنْ  حُصَيْنٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مُحَمَّدِ بْنِ صَفْوَانَ قَالَ :  ذَبَحْتُ أَرْنَبَيْنِ  بِمَرْوَةٍ  ، فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرْتُ ذَلِكَ لَهُ وَقُلْتُ : آكُلُهُمَا ؟  قَالَ : نَعَمْ  .","","Al-Mu'jam al-Kabir 529","","محمد بن صفوان الأنصاري عن الشعبي عن حصين بن عبد الرحمن السلمي عن محمد بن فضيل بن غزوان عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","محمد بن صفوان"
"17610","مُحَمَّدُ بْنُ صَيْفِيٍّ الْأَنْصَارِيُّ  530  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  جَرِيرُ بْنُ عَبْدِ الْحَمِيدِ (  ح  ) .  وَحَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ (  ح  ) .         [19/238]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ أَسَدٍ - قَالَا :  ثَنَا  عَبْثَرُ بْنُ الْقَاسِمِ أَبُو زَيْدٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُلَيْمَانُ بْنُ كَثِيرٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى الْحُلْوَانِيُّ وَأَبُو كُرَيْبٍ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ فُضَيْلٍ - كُلُّهُمْ  عَنْ  حُصَيْنِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مُحَمَّدِ بْنِ صَيْفِيٍّ الْأَنْصَارِيِّ قَالَ :  خَرَجَ إِلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي يَوْمِ عَاشُورَاءَ فَقَالَ :  أَفِيكُمْ مَنْ طَعِمَ الْيَوْمَ ؟  فَقُلْنَا : مِنَّا مَنْ طَعِمَ وَمِنَّا مِنْ لَمْ يَطْعَمْ . فَقَالَ : مَنْ كَانَ لَمْ يَطْعَمْ فَلْيُتِمَّ صَوْمَهُ ، وَمَنْ كَانَ طَعِمَ شَيْئًا فَلْيُتِمَّ بَقِيَّةَ يَوْمِهِ - ثُمَّ أَرْسَلَ إِلَى أَهْلِ  الْعَرُوضِ  يَأْمُرُهُمْ بِذَلِكَ  .","","Al-Mu'jam al-Kabir 530","","محمد بن صيفي بن سهل الخطمي عن الشعبي عن حصين بن عبد الرحمن السلمي عن محمد بن فضيل بن غزوان عن أبو كريب محمد بن العلاء عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن صيفي الأنصاري"
"17611","531  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  خَالِدٌ ،  ثَنَا  حُصَيْنٌ ،  عَنْ  عَامِرٍ ،  عَنْ  مُحَمَّدِ بْنِ صَيْفِيٍّ الْأَنْصَارِيِّ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ يَوْمَ عَاشُورَاءَ :  مَنْ كَانَ مِنْكُمْ طَعِمَ فَلْيُمْسِكْ بَقِيَّةَ يَوْمِهِ  ، وَمَنْ لَمْ يَكُنْ طَعِمَ فَلْيَصُمْ ، وَأَرْسَلَ إِلَى أَهْلِ  الْعَرُوضِ  فَأَمَرَهُمْ بِصَوْمِهِ  .","","Al-Mu'jam al-Kabir 531","","محمد بن صيفي بن سهل الخطمي عن الشعبي عن حصين بن عبد الرحمن السلمي عن خالد بن عبد الله الطحان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","محمد بن صيفي الأنصاري"
"17612","532  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ رَاشِدٍ الْآدَمِيُّ ،  ثَنَا  الْحُرُّ بْنُ مَالِكٍ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  دَاوُدَ بْنِ أَبِي هِنْدٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  مُحَمَّدِ بْنِ صَيْفِيٍّ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ مُنَادِيَهُ فِي يَوْمِ عَاشُورَاءَ :  مَنْ كَانَ صَائِمًا فَلْيَمْضِ فِي صَوْمِهِ  ، وَمَنْ كَانَ أَكَلَ وَشَرِبَ فَلْيُتِمَّ صَوْمَهُ  .","","Al-Mu'jam al-Kabir 532","","محمد بن صيفي بن سهل الخطمي عن الشعبي عن داود بن أبي هند عن هشيم بن بشير عن حر بن مالك بن الخطاب العنبري عن إبراهيم بن راشد بن سليمان الآدمي عن أحمد بن يحيى بن زهير التستري عن الطبراني","محمد بن صيفي الأنصاري"
"17613","533  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سَلَّامٍ الْجُمَحِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ عَبْدِ الْوَاحِدِ الْحَرَّانِيُّ ،  عَنْ  زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  عَنِ         [19/239]      الشَّعْبِيِّ ،  عَنْ  مُحَمَّدِ بْنِ صَيْفِيٍّ قَالَ :  كُنْتُ أَرْعَى غَنَمًا لِأَهْلِي بِشِعْبِ  أُحُدٍ  فَأَصَبْتُ خِرْنَقَيْنِ  ، فَأَخَذْتُ حَجَرًا فَذَبَحْتُهُمَا بِحَيْفِهِ -  يَعْنِي بِحَدِّهِ  - فَأَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَخْبَرْتُهُ ، فَقَالَ : كُلُوهُ  .","","Al-Mu'jam al-Kabir 533","","محمد بن صيفي بن سهل الخطمي عن الشعبي عن زكريا بن أبي زائدة الوادعي عن الوليد بن عبد الواحد الحراني عن محمد بن سلام الجمحي عن أحمد بن النضر بن بحر العسكري عن الطبراني","محمد بن صيفي الأنصاري"
"17614","مُحَمَّدُ بْنُ حَاطِبِ بْنِ الْحَارِثِ بْنِ مَعْمَرِ بْنِ حَبِيبِ بْنِ وَهْبِ بْنِ حُذَافَةَ بْنِ جُمَحِ بْنِ عَمْرِو بْنِ هَصَصَ بْنِ كَعْبِ بْنِ لُؤَيٍّ الْجُمَحِيُّ  وَأُمُّهُ  فَاطِمَةُ بِنْتُ الْمُجَلِّلِ بْنِ عَبْدِ اللهِ بْنِ أَبِي قَيْسِ بْنِ عَبْدِ وُدِّ بْنِ نَصْرِ بْنِ مَالِكِ بْنِ حِسْلٍ ،  هَاجَرَتْ بِهِ أُمُّهُ إِلَى  أَرْضِ الْحَبَشَةِ  .  534  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  هَارُونُ بْنُ إِسْحَاقَ  ، ثَنَا  وَكِيعٌ  ، عَنْ  شَرِيكٍ  ، عَنْ  سِمَاكِ بْنِ حَرْبٍ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ حَاطِبٍ يَقُولُ :  وُلِدْتُ فِي  الْحَبَشَةِ  .","","Al-Mu'jam al-Kabir 534","","محمد بن حاطب بن الحارث الجمحي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن وكيع بن الجراح عن هارون بن إسحاق الهمداني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن حاطب بن الحارث بن معمر بن حبيب"
"17615","535  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْحَارِثِ بْنِ مُحَمَّدِ بْنِ حَاطِبٍ الْجُمَحِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ مُحَمَّدِ بْنِ حَاطِبٍ  قَالَ :  لَمَّا قَدِمَتْ بِي أُمِّي مِنْ أَرْضِ  الْحَبَشَةِ  حِينَ مَاتَ  حَاطِبٌ ،  فَجَاءَتِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَدْ أَصَابَتْ إِحْدَى يَدَيَّ حَرِيقٌ مِنْ نَارٍ ، فَقَالَتْ : يَا رَسُولَ اللهِ ، هَذَا  مُحَمَّدُ بْنُ حَاطِبٍ  ، وَقَدْ أَصَابَهُ هَذَا الْحَرْقُ مِنَ النَّارِ . قَالَ  مُحَمَّدُ بْنُ حَاطِبٍ  : فَلَا أَكْذِبُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَلَا أَدْرِي  أَنَفَثَ أَوْ مَسَحَ  عَلَى رَأْسِي ، وَدَعَا فِيَّ بِالْبَرَكَةِ وَفِي ذُرِّيَّتِي  .","","Al-Mu'jam al-Kabir 535","","محمد بن حاطب بن الحارث الجمحي عن أبو عبد الله بن الحارث بن محمد بن عمر الحاطبي عن عبد الله بن الحارث بن محمد بن عمر الحاطبي عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","محمد بن حاطب بن الحارث بن معمر بن حبيب"
"17616","[19/240]      536  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ - كِلَاهُمَا  عَنْ  شُعْبَةَ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ حَاطِبٍ الْجُمَحِيَّ قَالَ :  انْصَبَّ عَلَى يَدِي شَيْءٌ مِنْ قِدْرٍ ، فَذَهَبَتْ بِي أُمِّي إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ فِيهِ كَلَامًا :  أَذْهِبِ الْبَأْسَ رَبَّ النَّاسِ  .  وَأَحْسِبُهُ قَالَ : اشْفِ وَأَنْتَ الشَّافِي  .","","Al-Mu'jam al-Kabir 536","","محمد بن حاطب بن الحارث الجمحي عن سماك بن حرب البكري عن شعبة بن الحجاج عن النضر بن شميل عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","محمد بن حاطب بن الحارث بن معمر بن حبيب"
"17617","537  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  مُحَمَّدِ بْنِ حَاطِبٍ قَالَ :  وَقَعَتِ الْقِدْرُ عَلَى يَدِي فَاحْتَرَقَتْ ، فَانْطُلِقَ بِي إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ  يَتْفُلُ  عَلَيْهَا وَيَقُولُ :  أَذْهِبِ الْبَأْسَ رَبَّ النَّاسِ  .  وَأَحْسِبُهُ قَالَ : وَاشْفِ أَنْتَ الشَّافِي  .","","Al-Mu'jam al-Kabir 537","","محمد بن حاطب بن الحارث الجمحي عن سماك بن حرب البكري عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","محمد بن حاطب بن الحارث بن معمر بن حبيب"
"17618","538  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ الْحَمِيدِ الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  مُحَمَّدِ بْنِ حَاطِبٍ قَالَ :  دَنَيْتُ إِلَى قِدْرٍ لَنَا وَأَنَا غُلَامٌ صَغِيرٌ فَاحْتَرَقَتْ يَدِي ، فَتُدْرِكُنِي أُمِّي ، فَأَتَتْ بِي رَجُلًا  بِالْبَطْحَاءِ  فَقَالَتْ :  يَا  مُحَمَّدُ ،  احْتَرَقَتْ يَدُ  مُحَمَّدٍ !  فَجَعَلَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَتْفُلُ  عَلَيْهَا  .","","Al-Mu'jam al-Kabir 538","","محمد بن حاطب بن الحارث الجمحي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","محمد بن حاطب بن الحارث بن معمر بن حبيب"
"17619","539  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  هَارُونُ بْنُ إِسْحَاقَ ،         [19/241]      ثَنَا  وَكِيعٌ ،  عَنْ  مِسْعَرٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  مُحَمَّدِ بْنِ حَاطِبٍ قَالَ :  دَنَوْتُ إِلَى قِدْرٍ لِأُمِّي فَأَكْفَأْتُهَا عَلَيَّ وَأَنَا غُلَامٌ ، فَجَلَبَتْنِي أُمِّي إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَقَانِي ، فَقَالَ :  أَذْهِبِ الْبَأْسَ رَبَّ النَّاسِ وَاشْفِ أَنْتَ الشَّافِي  ، لَا شَافِيَ إِلَّا أَنْتَ . قَالَ : فَلَمْ أَحْفَظِ الْكَلِمَاتِ ،  فَسَأَلْتُ  أُمِّي عَنْهُنَّ  فَأَخْبَرَتْنِي  فِي زَمَنِ  عُثْمَانَ  .","","Al-Mu'jam al-Kabir 539","","أم جميل بنت المجلل العامرية عن محمد بن حاطب بن الحارث الجمحي عن سماك بن حرب البكري عن مسعر بن كدام عن وكيع بن الجراح عن هارون بن إسحاق الهمداني عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن حاطب بن الحارث بن معمر بن حبيب"
"17620","540  -  حَدَّثَنِي  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  ثَنَا  زَكَرِيَّا بْنُ أَبِي زَائِدَةَ ،  حَدَّثَنِي  سِمَاكُ بْنُ حَرْبٍ ،  عَنْ  مُحَمَّدِ بْنِ حَاطِبٍ قَالَ :  تَنَاوَلْتُ قِدْرًا كَانَتْ لَنَا فَاحْتَرَقَتْ يَدِي ، فَانْطَلَقَتْ بِي أُمِّي إِلَى رَجُلٍ فِي  الْجَبَّانَةِ  فَقَالَتْ لَهُ : يَا رَسُولَ اللهِ ! فَقَالَ :  لَبَّيْكِ  وَسَعْدَيْكِ ،  ثُمَّ أَدْنَتْنِي مِنْهُ فَجَعَلَ يَنْفُثُ وَيَتَكَلَّمُ بِكَلَامٍ لَا أَدْرِي مَا هُوَ ،  فَسَأَلْتُ  أُمِّي بَعْدَ ذَلِكَ مَا كَانَ يَقُولُ ، فَقَالَتْ : كَانَ يَقُولُ :  أَذْهِبِ الْبَأْسَ رَبَّ النَّاسِ ، وَاشْفِ أَنْتَ الشَّافِي  ، لَا شَافِيَ إِلَّا أَنْتَ  .","","Al-Mu'jam al-Kabir 540","","أم جميل بنت المجلل العامرية عن محمد بن حاطب بن الحارث الجمحي عن سماك بن حرب البكري عن زكريا بن أبي زائدة الوادعي عن محمد بن بشر بن الفرافصة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","محمد بن حاطب بن الحارث بن معمر بن حبيب"
"17621","541  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  مُعَاوِيَةُ بْنُ عَمْرٍو ،  ثَنَا  إِسْحَاقُ  الْفَزَارِيُّ ،  عَنْ  أَبِي مَالِكٍ الْأَشْجَعِيِّ قَالَ : كُنْتُ جَالِسًا مَعَ مُحَمَّدِ بْنِ حَاطِبٍ  فَقَالَ  : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنِّي قَدْ رَأَيْتُ أَرْضًا ذَاتَ نَخْلٍ فَاخْرُجُوا .  قَالَ : فَخَرَجَ  حَاطِبٌ  وَجَعْفَرٌ  فِي الْبَحْرِ قِبَلَ  النَّجَاشِيِّ ،  فَوُلِدْتُ أَنَا فِي تِلْكَ السَّفِينَةِ .  كذا في طبعة مكتبة ابن تيمية وصوابه: (أبو إسحاق) . كما في مصادر التخريج.","","Al-Mu'jam al-Kabir 541","","محمد بن حاطب بن الحارث الجمحي عن سعد بن طارق بن أشيم الأشجعي عن أبو إسحاق الفزاري عن معاوية بن عمرو بن المهلب الأزدي عن محمد بن أحمد بن النضر النضري عن الطبراني","محمد بن حاطب بن الحارث بن معمر بن حبيب"
"17622","[19/242]      542  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  أَبِي بَلْجٍ ،  عَنْ  مُحَمَّدِ بْنِ حَاطِبٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  فَصْلُ مَا بَيْنَ الْحَلَالِ وَالْحَرَامِ  الصَّوْتُ  وَضَرْبُ الدُّفِّ  .","","Al-Mu'jam al-Kabir 542","","محمد بن حاطب بن الحارث الجمحي عن أبو بلج يحيى بن سليم الفزاري عن الوضاح بن عبد الله اليشكري عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","محمد بن حاطب بن الحارث بن معمر بن حبيب"
"17623","543  -  حَدَّثَنَا  عُبَيْدُ  اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَحْيَى بْنُ حَسَّانَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الْمَوَالِي ،  ثَنَا  مُوسَى بْنُ مُحَمَّدِ بْنِ حَاطِبٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا حُرِمَ أَحَدُكُمُ الزَّوْجَةَ وَالْوَلَدَ فَعَلَيْهِ  بِالْجِهَادِ  .  في طبعة مكتبة ابن تيمية : (عبد) والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 543","","محمد بن حاطب بن الحارث الجمحي عن موسى بن محمد بن حاطب عن عبد الرحمن بن أبي الموال مولى علي بن أبي طالب عن يحيى بن حسان بن حيان التنيسي عن ابن البرقي عن عبيد الله بن محمد بن عبد الله البرقي عن الطبراني","محمد بن حاطب بن الحارث بن معمر بن حبيب"
"17624","مُحَمَّدُ بْنُ طَلْحَةَ بْنِ عُبَيْدِ اللهِ  وُلِدَ فِي عَهْدِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَسَمَّاهُ مُحَمَّدًا ،  وَكَنَّاهُ  أَبَا الْقَاسِمِ  544  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ  ، ثَنَا  فَهْدُ بْنُ عَوْفٍ أَبُو رَبِيعَةَ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  هِلَالٍ الْوَزَّانِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى ،         [19/243]      قَالَ :  نَظَرَ  عُمَرُ  إِلَى  ابْنِ عَبْدِ الْحَمِيدِ  - وَكَانَ اسْمُهُ  مُحَمَّدًا  - وَرَجُلٌ يَقُولُ لَهُ : فَعَلَ اللهُ بِكَ يَا  مُحَمَّدُ  وَفَعَلَ ! يَسُبُّهُ ، فَدَعَاهُ  عُمَرُ  فَقَالَ : يَا  ابْنَ زَيْدٍ ،  لَا أَرَى  مُحَمَّدًا  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يُسَبُّ  بِكَ ، وَاللهِ لَا يُدْعَى  مُحَمَّدًا  أَبَدًا مَا دُمْتُ حَيًّا ! فَسَمَّاهُ  عَبْدَ الرَّحْمَنِ  ، فَأَرْسَلَ إِلَى  بَنِي طَلْحَةَ -  وَهُمْ سَبْعَةٌ ، وَسَيِّدُهُمْ وَكَبِيرُهُمْ مُحَمَّدُ بْنُ طَلْحَةَ - لِيُغَيِّرَ أَسْمَاءَهُمْ ، فَقَالَ  مُحَمَّدٌ  :  أُذَكِّرُكَ اللهَ يَا أَمِيرَ الْمُؤْمِنِينَ ، فَوَاللهِ  لَمُحَمَّدٌ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمَّانِي  مُحَمَّدًا !  فَقَالَ :  قُومُوا ، لَا سَبِيلَ إِلَى شَيْءٍ سَمَّاهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 544","","محمد بن طلحة بن عبيد الله السجاد عن عبد الرحمن بن أبي ليلى عن هلال بن أبي حميد عن الوضاح بن عبد الله اليشكري عن زيد بن عوف القطعي عن حفص بن عمر سنجة ألف عن الطبراني","محمد بن طلحة بن عبيد الله"
"17625","مُحَمَّدٌ السَّعْدِيُّ  545  -  حَدَّثَنَا  أَبُو شُعَيْبٍ الْحَرَّانِيُّ  ، ثَنَا  يَحْيَى بْنُ عَبْدِ اللهِ الْبَابْلُتِّيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ خُرَاشَةَ ،  حَدَّثَنِي  عُرْوَةُ بْنُ مُحَمَّدٍ السَّعْدِيُّ ،  عَنْ  أَبِيهِ  ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  ثَلَاثٌ إِذَا رَأَيْتَهُنَّ فَعِنْدَكَ عِنْدَكَ ؛  إِخْرَابُ  الْعَامِرِ  ، وَإِعْمَارُ الْخَرَابِ ، وَأَنْ يَكُونَ الْغَزْوُ رِفْدًا ، وَأَنْ  يَتَمَرَّسَ  الرَّجُلُ بِأَمَانَتِهِ تَمَرُّسَ الْبَعِيرِ بِالشَّجَرَةِ  .","","Al-Mu'jam al-Kabir 545","","محمد بن عطية بن عروة البلقاوي عن عروة بن محمد بن عطية الجشمي عن محمد بن خراشة عن أبو عمرو الأوزاعي عن يحيى بن عبد الله بن الضحاك البابلتي عن أبو شعيب الحراني عن الطبراني","محمد السعدي"
"17626","مُحَمَّدُ بْنُ فَضَالَةَ الْأَنْصَارِيُّ ثُمَّ الظَّفَرِيُّ  546  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ وَإِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ قَالَا :  ثَنَا  الصَّلْتُ بْنُ مَسْعُودٍ الْجَحْدَرِيُّ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ عَبْدِ الْعَزِيزِ الْبَغَوِيُّ  ، ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،         [19/244]      ثَنَا  فُضَيْلُ بْنُ سُلَيْمَانَ الْبَصْرِيُّ ،  ثَنَا  يُونُسُ بْنُ مُحَمَّدِ بْنِ فَضَالَةَ الظَّفَرِيُّ ،  عَنْ  أَبِيهِ  - وَكَانَ مِمَّنْ صَحِبَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَتَاهُمْ فِي  مَسْجِدِ بَنِي ظُفُرٍ  فَجَلَسَ عَلَى الصَّخْرَةِ الَّتِي فِي  مَسْجِدِ بَنِي ظُفُرٍ  الْيَوْمَ ، وَمَعَهُ  عَبْدُ اللهِ بْنُ مَسْعُودٍ  وَمُعَاذُ بْنُ جَبَلٍ  وَأُنَاسٌ مِنْ أَصْحَابِهِ ، فَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَارِئًا  فَقَرَأَ حَتَّى أَتَى عَلَى هَذِهِ الْآيَةِ :         {      فَكَيْفَ إِذَا جِئْنَا مِنْ كُلِّ أُمَّةٍ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَى هَؤُلاءِ شَهِيدًا         }      ، فَبَكَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى اضْطَرَبَ لَحْيَاهُ ، فَقَالَ :  أَيْ رَبِّ ، شَهِدْتُ عَلَى مَنْ أَنَا بَيْنَ ظَهْرَيْهِ ، فَكَيْفَ بِمَنْ لَمْ أَرَ .  ؟","","Al-Mu'jam al-Kabir 546","","محمد بن فضالة اللخمي عن يونس بن محمد بن فضالة الظفري عن فضيل بن سليمان النميري عن فضيل بن حسين الجحدري عن أبو القاسم البغوي عن الطبراني","محمد بن فضالة الأنصاري ثم الظفري"
"17627","547  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ أَبِي زِيَادٍ الْقَطَوَانِيُّ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ الْبَزَّارُ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ عُبَيْدِ بْنِ عَقِيلٍ - قَالَا :  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  إِدْرِيسُ بْنُ مُحَمَّدِ بْنِ أَنَسِ بْنِ مُحَمَّدِ بْنِ فَضَالَةَ  ،  حَدَّثَنِي  جَدِّي ،  عَنْ  أَبِيهِ  قَالَ :  قَدِمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْمَدِينَةَ  وَأَنَا ابْنُ أُسْبُوعَيْنِ ، فَأُتِيَ بِي إِلَيْهِ فَمَسَحَ عَلَى رَأْسِي وَقَالَ :  سَمُّوهُ بِاسْمِي ، وَلَا تُكَنُّوهُ بِكُنْيَتِي  . وَحُجَّ بِي مَعَهُ حَجَّةَ الْوَدَاعِ وَأَنَا ابْنُ عَشْرِ سِنِينَ ، قَالَ : فَلَقَدْ عُمِّرَ  مُحَمَّدٌ  حَتَّى شَابَ رَأْسُهُ ، وَمَا شَابَ مَوْضِعُ يَدِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، والصواب : (إدريس بن محمد بن يونس بن محمد بن أنس بن فضالة) وينظر مصادر الترجمة ، والله أعلم.","","Al-Mu'jam al-Kabir 547","","محمد بن أنس بن فضالة الظفري عن يونس بن محمد بن فضالة الظفري عن إدريس بن محمد بن يونس الظفري عن يعقوب بن محمد بن عيسى عن محمد بن عبد الله بن عبيد بن عقيل الهلالي عن أحمد بن عبد الله البزاز عن الطبراني","محمد بن فضالة الأنصاري ثم الظفري"
"17628","548  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ بْنِ أَبِي فُدَيْكٍ ،  ثَنَا  إِدْرِيسُ بْنُ مُحَمَّدِ بْنِ يُونُسَ الظَّفَرِيُّ ،  عَنْ  أَبِيهِ ،         [19/245]      عَنْ  جَدِّهِ  أَنَّهُ حَضَرَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَجَّةَ الْوَدَاعِ  وَهُوَ ابْنُ عَشْرِ سِنِينَ وَلَهُ ذُؤَابَةٌ  .","","Al-Mu'jam al-Kabir 548","","يونس بن محمد بن فضالة الظفري عن أبو إدريس بن محمد بن يونس الظفري عن إدريس بن محمد بن يونس الظفري عن محمد بن إسماعيل بن مسلم الديلي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","محمد بن فضالة الأنصاري ثم الظفري"
"17629","مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ جَحْشِ بْنِ رِيَابٍ الْأَسَدِيُّ  549  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ، ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ السَّدُوسِيُّ  ، ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  قَالَ  :  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ جَحْشِ بْنِ رِيَابِ بْنِ يَعْمَرَ بْنِ صَبِرَةَ بْنِ مُرَّةَ بْنِ كَثِيرِ بْنِ غَنْمِ بْنِ دُودَانَ بْنِ أَسَدِ بْنِ خُزَيْمَةَ بْنِ مُدْرِكَةَ بْنِ إِلْيَاسَ بْنِ مُضَرَ بْنِ نِزَارٍ حَلِيفُ بَنِي أُمَيَّةَ  ، جَدَّتُهُ أُمُّ أَبِيهِ  أُمَيْمَةُ بِنْتُ عَبْدِ الْمُطَّلِبِ  عَمَّةُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَقُتِلَ أَبُوهُ  يَوْمَ أُحُدٍ  شَهِيدًا  ، وَعَمَّتُهُ  زَيْنَبُ بِنْتُ جَحْشٍ  زَوْجُ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 549","","","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17630","550  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  أَخْبَرَنِي  الْعَلَاءُ بْنُ عَبْدِ الرَّحْمَنِ ،  أَخْبَرَنِي  أَبُو كَثِيرٍ مَوْلَى مُحَمَّدِ بْنِ جَحْشٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ قَالَ :  كُنْتُ مَعَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَمَرَّ عَلَى  مَعْمَرٍ  وَهُوَ جَالِسٌ عِنْدَ دَارِهِ بِالسُّوقِ وَفَخِذَاهُ         [19/246]      مَكْشُوفَانِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  يَا  مَعْمَرُ ،  غَطِّ فَخِذَيْكَ فَإِنَّ الْفَخِذَيْنِ  عَوْرَةٌ  .","","Al-Mu'jam al-Kabir 550","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن العلاء بن عبد الرحمن الحرقي عن محمد بن جعفر بن أبي كثير الزرقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17631","551  -  حَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ جَعْفَرٍ ،  عَنِ  الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي كَثِيرٍ - مَوْلًى لِمُحَمَّدِ بْنِ جَحْشٍ ،  عَنْ  مُحَمَّدِ بْنِ جَحْشٍ قَالَ :  مَرَّ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا مَعَهُ - عَلَى  مَعْمَرٍ  وَفَخِذَاهُ مَكْشُوفَانِ ، فَقَالَ :  يَا  مَعْمَرُ ،  غَطِّ فَخِذَيْكَ فَإِنَّ الْفَخِذَ  عَوْرَةٌ  .","","Al-Mu'jam al-Kabir 551","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن العلاء بن عبد الرحمن الحرقي عن إسماعيل بن جعفر بن أبي كثير الزرقي عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17632","552  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  ابْنُ أَبِي حَازِمٍ ،  عَنِ  الْعَلَاءِ ،  عَنْ  أَبِي كَثِيرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ  .","","Al-Mu'jam al-Kabir 552","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن العلاء بن عبد الرحمن الحرقي عن عبد العزيز بن أبي حازم المخزومي عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17633","553  -  حَدَّثَنَا  أَبُو عَرُوبَةَ الْحُسَيْنُ بْنُ مُحَمَّدٍ الْحَرَّانِيُّ  ، ثَنَا  أَبُو الْمُعَافَى مُحَمَّدُ بْنُ وَهْبِ بْنِ أَبِي كَرِيمَةَ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحِيمِ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنِ  الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي كَثِيرٍ مَوْلَى مُحَمَّدِ بْنِ جَحْشٍ ،  عَنْ  مُحَمَّدِ بْنِ جَحْشٍ قَالَ :  خَرَجْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَرَرْنَا بِرَجُلٍ مِنْ  بَنِي عَدِيٍّ  كَاشِفٍ عَنْ فَخِذِهِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  غَطِّ فَخِذَكَ يَا  مَعْمَرُ ،  فَإِنَّهَا مِنَ  الْعَوْرَةِ  .","","Al-Mu'jam al-Kabir 553","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن العلاء بن عبد الرحمن الحرقي عن زيد بن أبي أنيسة الجزري عن خالد بن يزيد الحراني عن محمد بن سلمة الباهلي عن محمد بن وهب بن عمر الحراني عن الحسين بن محمد بن أبي معشر الجزري عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17634","554  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنِ  الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي كَثِيرٍ مَوْلَى مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ قَالَ :  كُنْتُ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي السُّوقِ ، فَمَرَّ عَلَى  مَعْمَرٍ  عَلَى بَابِهِ مَكْشُوفَةٌ فَخِذُهُ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  غَطِّ فَخِذَكَ يَا  مَعْمَرُ ،  فَإِنَّهَا مِنَ  الْعَوْرَةِ  .         [19/247]","","Al-Mu'jam al-Kabir 554","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن العلاء بن عبد الرحمن الحرقي عن سليمان بن بلال القرشي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17635","555  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ ،  ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنِ  الْعَلَاءِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي كَثِيرٍ مَوْلَى مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ  .","","Al-Mu'jam al-Kabir 555","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن العلاء بن عبد الرحمن الحرقي عن سليمان بن بلال القرشي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17636","556  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  رَوْحُ بْنُ صَلَاحٍ ،  ثَنَا  يَحْيَى بْنُ سَعِيدِ بْنِ أَبِي أَيُّوبَ  ،  عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ ،  عَنْ  أَبِي كَثِيرٍ مَوْلَى مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَوْ أَنَّ رَجُلًا قُتِلَ فِي  سَبِيلِ  اللهِ ثُمَّ أُحْيِيَ ثُمَّ قُتِلَ فِي  سَبِيلِ  اللهِ ثُمَّ أُحْيِيَ لَمْ يَدْخُلِ الْجَنَّةَ حَتَّى يُقْضَى عَنْهُ دَيْنُهُ  ، وَلَيْسَ ثَمَّةَ ذَهَبٌ وَلَا فِضَّةٌ ، إِنَّمَا هِيَ الْحَسَنَاتُ وَالسَّيِّئَاتُ  .  كذا في طبعة ابن تيمية ، والصواب: (أبو يحيى سعيد بن أبي أيوب) ، كما جاء في المعجم الأوسط 1 / 90 .","","Al-Mu'jam al-Kabir 556","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن صفوان بن سليم القرشي عن سعيد بن أبي أيوب الخزاعي عن روح بن صلاح بن سيابة الحارثي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17637","557  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  ثَنَا  مُحَمَّدُ بْنُ عَمْرٍو ،  حَدَّثَنِي  أَبُو كَثِيرٍ مَوْلَى اللَّيْثِيِّينَ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ  أَنَّ  رَجُلًا  جَاءَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  يَا رَسُولَ اللهِ ، إِنْ قُتِلْتُ فِي  سَبِيلِ  اللهِ ؟ قَالَ : الْجَنَّةُ ،  فَلَمَّا وَلَّى قَالَ : إِلَّا الدَّيْنَ ، سَارَّنِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ آنِفًا  .","","Al-Mu'jam al-Kabir 557","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن محمد بن عمرو بن علقمة بن وقاص الليثي عن محمد بن بشر بن الفرافصة عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17638","[19/248]      558  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  دُحَيْمٌ (  ح  ) .  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى بْنِ بُكَيْرٍ ،  ثَنَا  أَبِي  - قَالَا :  ثَنَا  أَنَسُ بْنُ عِيَاضٍ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ أَبِي يَحْيَى الْأَسْلَمِيُّ ،  عَنْ  أَبِي كَثِيرٍ مَوْلَى الْأَسْلَمِيِّينَ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ عَبْدِ اللهِ بْنِ جَحْشٍ - وَكَانَتْ لَهُ  صُحْبَةٌ -  يَقُولُ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَتَاهُ  رَجُلٌ  فَقَالَ : يَا رَسُولَ اللهِ ، مَاذَا تَرَى إِنْ قَاتَلْتُ فِي  سَبِيلِ  اللهِ حَتَّى أُقْتَلَ ؟ قَالَ : الْجَنَّةُ ، فَلَمَّا وَلَّى الرَّجُلُ قَالَ : كُرُّوهُ عَلَيَّ ، فَلَمَّا جَاءَ قَالَ :  إِنَّ  جِبْرِيلَ  عَلَيْهِ السَّلَامُ قَالَ : إِلَّا أَنْ يَكُونَ عَلَيْهِ دَيْنٌ  .","","Al-Mu'jam al-Kabir 558","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن محمد بن أبي يحيى الأسلمي عن أنس بن عياض الليثي عن يحيى بن عبد الله بن بكير المخزومي عن عبد الملك بن يحيى المخزومي عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17639","559  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنِ  الْعَلَاءِ ،  عَنْ  أَبِي كَثِيرٍ مَوْلَى مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  قَالَ لِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ : لَوْ أَنَّ عَبْدًا قُتِلَ فِي  سَبِيلِ  اللهِ وَعَلَيْهِ دَيْنٌ لَمْ يَدْخُلِ الْجَنَّةَ  حَتَّى يُقْضَى عَنْهُ دَيْنُهُ  .","","Al-Mu'jam al-Kabir 559","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن العلاء بن عبد الرحمن الحرقي عن عبد العزيز بن محمد الدراوردي عن يحيى بن عبد الحميد عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17640","560  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  ضِرَارُ بْنُ صُرَدٍ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ ،  ثَنَا  الْعَلَاءُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  أَبِي كَثِيرٍ مَوْلَى مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ ،  عَنْ  مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ قَالَ :  كُنَّا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِفِنَاءِ الْمَسْجِدِ ، فَرَفَعَ رَأْسَهُ إِلَى السَّمَاءِ فَقَالَ :  سُبْحَانَ اللهِ ، مَاذَا أُنْزِلَ مِنَ التَّشْدِيدِ ؟  فَظَلَلْنَا بَقِيَّةَ يَوْمِنَا وَلَيْلَتِنَا ، فَلَمَّا أَصْبَحْتُ غَدَوْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقُلْتُ : يَا رَسُولَ اللهِ ، مَاذَا         [19/249]      أُنْزِلَ مِنَ التَّشْدِيدِ ؟ قَالَ : لَوْ أَنَّ رَجُلًا قُتِلَ فِي  سَبِيلِ  اللهِ ثُمَّ أُحْيِيَ ثُمَّ قُتِلَ ثُمَّ أُحْيِيَ لَمْ يَدْخُلِ الْجَنَّةَ وَعَلَيْهِ دَيْنٌ  .","","Al-Mu'jam al-Kabir 560","","محمد بن عبد الله بن جحش الأسدي عن أبو كثير الجحشى عن العلاء بن عبد الرحمن الحرقي عن عبد العزيز بن أبي حازم المخزومي عن ضرار بن صرد التيمي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17641","561  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  أَنَا  عَبْدُ اللهِ بْنُ عُمَرَ الْعُمَرِيُّ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عَبْدِ اللهِ بْنِ جَحْشٍ ،  عَنْ  أَبِيهِ  أَنَّ  زَيْنَبَ بِنْتَ جَحْشٍ  كَانَتْ تَغْسِلُ رَأْسَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - فِي  مِخْضَبٍ  مِنْ صُفْرٍ . قَالَ  عَبْدُ اللهِ بْنُ عُمَرَ  : قَدْ رَأَيْتُ ذَلِكَ  الْمِخْضَبَ  .","","Al-Mu'jam al-Kabir 561","","محمد بن عبد الله بن جحش الأسدي عن إبراهيم بن محمد بن عبد الله بن جحش بن رئاب الأسدي عن عبد الله بن عمر العمري عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","محمد بن عبد الله بن جحش بن رياب الأسدي"
"17642","مُحَمَّدُ بْنُ أَبِي عَمِيرَةَ الْمُزَنِيُّ  562  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي  ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  ثَوْرُ بْنُ يَزِيدَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ ،  عَنْ  جُبَيْرِ بْنِ نُفَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ أَبِي عَمِيرَةَ - وَكَانَ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَوْ أَنَّ عَبْدًا جُرَّ عَلَى وَجْهِهِ مِنْ يَوْمِ وُلِدَ إِلَى يَوْمِ يَمُوتُ  هَرَمًا  فِي طَاعَةِ اللهِ لَحَقَّرَ ذَلِكَ يَوْمَ الْقِيَامَةِ  وَلَوَدَّ أَنَّهُ يَزْدَادُ كَمَا يَزْدَادُ مِنَ الْأَجْرِ وَالثَّوَابِ  .","","Al-Mu'jam al-Kabir 562","","محمد بن أبي عميرة المزني عن جبير بن نفير بن مالك الحضرمي عن خالد بن معدان عن ثور بن يزيد الكلاعي عن الوليد بن مسلم القرشي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","محمد بن أبي عميرة المزني"
"17643","مَنِ اسْمُهُ مَالِكٌ  مَالِكُ بْنُ التَّيِّهَانِ ، أَبُو الْهَيْثَمِ الْأَنْصَارِيُّ ،  عَقَبِيٌّ بَدْرِيٌّ ، لَمْ يَزَلْ  بِالْمَدِينَةِ  حَتَّى تُوُفِّيَ بِهَا سَنَةَ عِشْرِينَ ، مِنْ أَخْبَارِهِ :  563  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ         [19/250]      لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  :  فِي تَسْمِيَةِ مَنْ شَهِدَ الْعَقَبَةَ مِنَ  الْأَنْصَارِ  ، ثُمَّ مِنَ  الْأَوْسِ  مِنْ  بَنِي عَبْدِ الْأَشْهَلِ  ،  أَبُو الْهَيْثَمِ بْنُ التَّيِّهَانِ  ، وَهُوَ نَقِيبٌ ، وَقَدْ شَهِدَ  بَدْرًا  ، وَهُوَ أَوَّلُ مَنْ بَايَعَ عَلَى الْإِسْلَامِ فِي الْعَقَبَةِ  .","","Al-Mu'jam al-Kabir 563","","","من أخباره"
"17644","564  -  حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ،  عَنِ  ابْنِ شِهَابٍ  :  فِي تَسْمِيَةِ مَنْ شَهِدَ الْعَقَبَةَ مِنَ  الْأَنْصَارِ  ،  أَبُو الْهَيْثَمِ بْنُ التَّيِّهَانِ  ، وَهُوَ نَقِيبٌ  .","","Al-Mu'jam al-Kabir 564","","","من أخباره"
"17645","565  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  قَالَ :  تُوُفِّيَ  أَبُو الْهَيْثَمِ بْنُ التَّيِّهَانِ  سَنَةَ عِشْرِينَ  ، وَاسْمُهُ  مَالِكٌ  .","","Al-Mu'jam al-Kabir 565","","","من أخباره"
"17646","566  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي الْأَسْوَدِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ قَالَ :  وَكَانَ أَوَّلَ مَنْ بَايَعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الْعَقَبَةِ  أَبُو الْهَيْثَمِ بْنُ التَّيِّهَانِ  ، وَقَالَ : يَا رَسُولَ اللهِ ، إِنَّ بَيْنَنَا وَبَيْنَ النَّاسِ  حِبَالًا  -  وَالْحِبَالُ  : الْحَلِفُ وَالْمَوَاثِيقُ  - فَلَعَلَّنَا نَقْطَعُهَا ، ثُمَّ تَرْجِعَ إِلَى قَوْمِكَ وَقَدْ قَطَعْنَا الْحِبَالَ وَحَارَبْنَا النَّاسَ ! قَالَ : فَضَحِكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ قَوْلِهِ ، وَقَالَ :  الدَّمُ  الدَّمُ  ،  الْهَدْمُ  الْهَدْمُ  . فَلَمَّا رَضِيَ  أَبُو الْهَيْثَمِ  بِمَا رَجَعَ إِلَيْهِ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ قَوْلِهِ أَقْبَلَ عَلَى قَوْمِهِ فَقَالَ : يَا قَوْمُ ، هَذَا رَسُولُ اللهِ - صَلَّى اللهُ         [19/251]      عَلَيْهِ وَسَلَّمَ - أَشْهَدُ أَنَّهُ لَصَادِقٌ ، وَإِنَّهُ الْيَوْمَ فِي حَرَمِ اللهِ وَأَمْنِهِ وَبَيْنَ ظَهْرَيْ قَوْمِهِ وَعَشِيرَتِهِ ، فَاعْلَمُوا أَنَّكُمْ إِنْ تُخْرِجُوهُ بَرَتْكُمُ الْعَرَبُ عَنْ قَوْسٍ وَاحِدَةٍ ، فَإِنْ كَانَتْ طَابَتْ أَنْفُسُكُمْ بِالْقِتَالِ فِي  سَبِيلِ  اللهِ وَذَهَابِ الْأَمْوَالِ وَالْأَوْلَادِ فَادْعُوهُ إِلَى أَرْضِكُمْ ، فَإِنَّهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَقًّا ، وَإِنْ خِفْتُمْ خِذْلَانًا فَمِنَ الْآنَ ، فَقَالَ  عَبْدُ اللهِ  : قَبِلْنَا عَنِ اللهِ وَعَنْ رَسُولِهِ مَا أَعْطَانَا ، وَقَدْ أَعْطَيْنَاكَ مِنْ أَنْفُسِنَا الَّذِي سَأَلْتَنَا يَا رَسُولَ اللهِ ، فَخَلِّ بَيْنَنَا يَا  أَبَا الْهَيْثَمِ  وَبَيْنَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَلْنُبَايِعْهُ  ، فَقَالَ  أَبُو الْهَيْثَمِ  : أَنَا أَوَّلُ مَنْ بَايَعَ ، ثُمَّ  تَبَايَعُوا  كُلُّهُمْ ، وَصَاحَ الشَّيْطَانُ مِنْ رَأْسِ الْجَبَلِ فَقَالَ : يَا مَعْشَرَ  قُرَيْشٍ ،  هَذِهِ  الْخَزْرَجُ  وَالْأَوْسُ  تُحَالِفُ  مُحَمَّدًا  عَلَى قِتَالِكُمْ ، فَفَزِعُوا عِنْدَ ذَلِكَ وَرَاعَهُمْ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا يَرُعْكُمْ هَذَا الصَّوْتُ ، فَإِنَّمَا هُوَ عَدُوُّ اللهِ إِبْلِيسُ ،  لَيْسَ يَسْمَعُهُ أَحَدٌ مِمَّنْ تَخَافُونَ . وَقَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَصَرَخَ بِالشَّيْطَانِ فَقَالَ : يَا ابْنَ  أَزَبَّ  ، هَذَا عَمَلُكَ فَسَأَفْرُغُ لَكَ  .","","Al-Mu'jam al-Kabir 566","","عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","من أخباره"
"17647","567  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عُبَيْدُ بْنُ يَعِيشَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدٍ الْمُحَارِبِيُّ ،  عَنْ  يَحْيَى بْنِ عُبَيْدِ اللهِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي هُرَيْرَةَ ،  حَدَّثَنِي  أَبُو بَكْرِ بْنُ أَبِي قُحَافَةَ قَالَ :  فَاتَنِي الْعَشَاءُ ذَاتَ لَيْلَةٍ ، فَجَعَلْتُ أَتَقَلَّبُ لَا يَأْتِينِي النَّوْمُ ، فَقُلْتُ : لَوْ خَرَجْتُ إِلَى الْمَسْجِدِ فَصَلَّيْتُ مَا قُدِّرَ لِي ! فَفَعَلْتُ ، ثُمَّ اسْتَنَدْتُ إِلَى نَاحِيَةٍ مِنْهُ فَدَخَلَ  عُمَرُ ،  فَلَمَّا رَآنِي أَنْكَرَنِي وَقَالَ : مَنْ هَذَا ؟         [19/252]      فَقُلْتُ :  أَبُو بَكْرٍ ،  قَالَ : مَا أَخْرَجَكَ هَذِهِ السَّاعَةَ ؟ قُلْتُ : الْجُوعُ ! قَالَ : وَأَنَا مَا أَخْرَجَنِي إِلَّا الَّذِي أَخْرَجَكَ ! فَلَمْ يَلْبَثْ أَنْ دَخَلَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا رَأَى سَوَادَنَا أَنْكَرَهُ ، فَقَالَ : مَنْ هَذَانِ ؟ فَبَدَرَنِي  عُمَرُ  فَقَالَ : هَذَا  أَبُو بَكْرٍ ،  وَهَذَا  عُمَرُ .  فَقَالَ : مَا أَخْرَجَكُمَا هَذِهِ السَّاعَةَ ؟ فَأَخْبَرْنَاهُ الْخَبَرَ ، قَالَ :  وَأَنَا مَا أَخْرَجَنِي إِلَّا الَّذِي أَخْرَجَكُمَا ، انْطَلِقُوا بِنَا إِلَى مَنْزِلِ  الْوَاقِمِيِّ  ، فَأَتَيْنَا الْبَابَ فَاسْتَأْذَنَّا فَخَرَجَتِ  الْمَرْأَةُ  فَقَالَ : أَيْنَ فُلَانٌ ؟ قَالَتْ : ذَهَبَ  يَسْتَعْذِبُ  لَنَا مِنْ حَشِّ  بَنِي حَارِثَةَ  ، فَفَتَحَتِ الْبَابَ فَدَخَلْنَا ، فَلَمْ نَلْبَثْ أَنْ جَاءَ حَامِلًا قِرْبَةً عَلَى ظَهْرِهِ حَتَّى عَلَّقَهَا فِي كَرْنَفَةٍ مِنْ كَرَانِفِ النَّخْلِ ، ثُمَّ أَقْبَلَ إِلَيْنَا فَقَالَ : مَرْحَبًا وَأَهْلًا ، مَا زَارَ النَّاسَ خَيْرٌ مِنْ  زَوْرٍ  زَارُونِي اللَّيْلَةَ ، ثُمَّ جَاءَ  بِعِذْقِ  بُسْرٍ فَجَعَلْنَا نَنْتَقِي فِي الْقَمَرِ وَنَأْكُلُ ، ثُمَّ أَخَذَ الشَّفْرَةَ  وَجَالَ  فِي الْغَنَمِ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِيَّاكَ  وَالْحَلُوبَ  - أَوْ قَالَ : ذَاتَ  الدَّرِّ  ،  فَذَبَحَ لَنَا شَاةً وَسَلَخَهَا وَقَطَّعَهَا فِي الْقِدْرِ ، وَأَمَرَ الْمَرْأَةَ فَعَجَنَتْ وَخَبَزَتْ ، ثُمَّ جَاءَنَا بِثَرِيدَةٍ وَلَحْمٍ فَأَكَلْنَا ، ثُمَّ قَامَ إِلَى الْقِرْبَةِ وَقَدْ تَخَفَّقَهَا الرِّيحُ فَبَرَدَتْ فَأَسْقَانَا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : الْحَمْدُ لِلهِ ، خَرَجْنَا لَمْ يُخْرِجْنَا إِلَّا الْجُوعُ ، ثُمَّ لَمْ نَرْجِعْ حَتَّى أَصَبْنَا هَذَا ، هَذَا مِنَ النَّعِيمِ الَّذِي تُسْأَلُونَ عَنْهُ يَوْمَ الْقِيَامَةِ . ثُمَّ قَالَ  لِلْوَاقِمِيِّ  : أَمَا لَكَ خَادِمٌ يَكْفِيكَ هَذَا ؟ قَالَ : لَا يَا رَسُولَ اللهِ ! قَالَ : فَانْظُرْ أَوَّلَ سَبْيٍ يَأْتِينِي فَائْتِنِي آمُرُ لَكَ بِخَادِمٍ . فَلَمْ يَلْبَثْ أَنْ أَتَاهُ سَبْيٌ فَأَتَاهُ ، فَقَالَ : مَا جَاءَ بِكَ ؟ قَالَ : مَوْعِدُكَ الَّذِي وَعَدْتَنِي ! قَالَ : قُمْ فَاخْتَرْ مِنْهُمْ ، فَقَالَ : يَا رَسُولَ اللهِ ، كُنْ أَنْتَ الَّذِي تَخْتَارُ لِي . قَالَ : خُذْ هَذَا  الْغُلَامَ  فَأَحْسِنْ إِلَيْهِ . فَأَتَى امْرَأَتَهُ فَأَخْبَرَهَا بِمَا قَالَ لِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَا قَالَ لَهُ ، فَقَالَتْ : فَقَدْ أَمَرَكَ أَنْ تُحْسِنَ إِلَيْهِ ! قَالَ : وَمَا الْإِحْسَانُ ؟ قَالَتْ : أَنْ  تُعْتِقَهُ  . قَالَ : هُوَ  حُرٌّ  لِوَجْهِ اللهِ عَزَّ وَجَلَّ  .","","Al-Mu'jam al-Kabir 567","","أبو  بكر الصديق عن أبو هريرة الدوسي عن عبيد الله بن عبد الله بن موهب القرشى عن يحيى بن عبيد الله بن عبد الله بن موهب التيمي عن عبد الرحمن بن محمد المحاربي عن عبيد بن يعيش عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","من أخباره"
"17648","[19/253]      568  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ وَجَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ قَالَا :  ثَنَا  زَكَرِيَّا بْنُ يَحْيَى الرِّيَاشِيُّ  ،  ثَنَا  عَبْدُ اللهِ بْنُ عِيسَى الْخَزَّازُ ،  ثَنَا  يُونُسُ بْنُ عُبَيْدٍ ،  عَنْ  عِكْرِمَةَ ،  عَنِ  ابْنِ عَبَّاسٍ  أَنَّهُ سَمِعَ  عُمَرَ بْنَ الْخَطَّابِ يَقُولُ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ الظُّهْرِ فَوَجَدَ  أَبَا بَكْرٍ  فِي الْمَسْجِدِ ، فَقَالَ لَهُ : مَا أَخْرَجَكَ هَذِهِ السَّاعَةَ ؟ قَالَ : أَخْرَجَنِي الَّذِي أَخْرَجَكَ يَا رَسُولَ اللهِ . وَجَاءَ  عُمَرُ بْنُ الْخَطَّابِ  فَقَالَ : يَا  ابْنَ الْخَطَّابِ  مَا أَخْرَجَكَ ؟ قَالَ : أَخْرَجَنِي الَّذِي أَخْرَجَكُمَا ! فَقَعَدَ  عُمَرُ  فَجَعَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُحَدِّثُهُمَا ، ثُمَّ قَالَ : فِيكُمَا مِنْ قُوَّةٍ تَنْطَلِقَانِ إِلَى هَذَا النَّخْلِ فَتُصِيبَانِ طَعَامًا وَشَرَابًا وَطِلَاءً ، قُلْنَا : نَعَمْ . قَالَ : مُرُّوا بِنَا إِلَى مَنْزِلِ  أَبِي الْهَيْثَمِ بْنِ التَّيِّهَانِ الْأَنْصَارِيِّ  ، فَتَقَدَّمَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بَيْنَ أَيْدِينَا فَسَلَّمَ وَاسْتَأْذَنَ ثَلَاثَ مَرَّاتٍ ،  وَأُمُّ الْهَيْثَمِ  مِنْ وَرَاءِ الْبَابِ تَسْمَعُ سَلَامَهُ تُرِيدُ أَنْ يَزِيدَهَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ السَّلَامِ ، فَلَمَّا أَرَادَ أَنْ يَنْصَرِفَ خَرَجَتْ  أُمُّ الْهَيْثَمِ  تَسْعَى خَلْفَهُمْ ، فَقَالَتْ : يَا رَسُولَ اللهِ ، قَدْ وَاللهِ سَمِعْتُ تَسْلِيمَكَ ، وَلَكِنِّي أَرَدْتُ أَنْ تَزِيدَنَا مِنْ سَلَامِكَ ! قَالَ لَهَا صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : خَيْرًا ! ثُمَّ قَالَ : أَيْنَ  أَبُو الْهَيْثَمِ  ؟ فَقَالَتْ : يَا رَسُولَ اللهِ ،         [19/254]      هُوَ قَرِيبٌ ، ذَهَبَ  يَسْتَعْذِبُ  لَنَا مِنَ الْمَاءِ ، ادْخُلُوا ، فَإِنَّهُ يَأْتِي السَّاعَةَ إِنْ شَاءَ اللهُ . فَبَسَطَتْ لَهُمْ بِسَاطًا تَحْتَ الشَّجَرَةِ ، وَجَاءَ  أَبُو الْهَيْثَمِ  فَفَرِحَ بِهِمْ  وَقَرَّتْ  عَيْنَاهُ بِهِمْ ، وَصَعِدَ عَلَى نَخْلَةٍ فَصَرَمَ لَهُمْ أَعْذَاقًا ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  احْتَسِبْ  يَا  أَبَا الْهَيْثَمِ  . فَقَالَ : يَا رَسُولَ اللهِ ، تَأْكُلُونَ مِنْ بُسْرِهِ وَمِنْ رُطَبِهِ وَمِنْ تَذْنُوبِهِ . ثُمَّ أَتَاهُمْ بِمَاءٍ فَشَرِبُوا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَذَا مِنَ النَّعِيمِ الَّذِي تُسْأَلُونَ عَنْهُ  . فَقَامَ  أَبُو الْهَيْثَمِ  لِيَذْبَحَ لَهُمْ شَاةً ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِيَّاكَ وَاللَّبُونَ ، وَقَامَتْ  أُمُّ الْهَيْثَمِ  تَعْجِنُ وَتَخْبِزُ لَهُمْ ، وَوَضَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  وَعُمَرُ  - رَضِيَ اللهُ عَنْهُمَا - رُءُوسَهُمْ لِلْقَائِلَةِ فَأُيْقِظُوا وَقَدْ أَدْرَكَ طَعَامُهُمْ ، فَوُضِعَ الطَّعَامُ بَيْنَ أَيْدِيهِمْ فَأَكَلُوا وَشَبِعُوا ، وَرَدَّ عَلَيْهِمْ  أَبُو الْهَيْثَمِ  بَقِيَّةَ الْأَعْذَاقِ فَأَكَلُوا مِنْ رُطَبِهِ وَتَذْنُوبِهِ ، فَسَلَّمَ عَلَيْهِمْ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَدَعَا لَهُمْ بِخَيْرٍ  .  كذا في طبعة مكتبة ابن تيمية ، ولعل الصواب: ( الرقاشي ) ، كما في المطالب .","","Al-Mu'jam al-Kabir 568","","عمر بن الخطاب عن عبد الله بن عباس عن عكرمة مولى ابن عباس عن يونس بن عبيد عن عبد الله بن عيسى بن خالد الخزاز عن زكريا بن يحيى بن عبد الله الرقاشي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","من أخباره"
"17649","569  -  حَدَّثَنَا  مُحَمَّدُ بْنُ زَكَرِيَّا الْغَلَّابِيُّ  ، ثَنَا  بَكَّارُ بْنُ مُحَمَّدٍ السِّيرِينِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  نَافِعٍ ،  عَنِ  ابْنِ عُمَرَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ فِي سَاعَةٍ لَمْ يَكُنْ يَخْرُجُ فِيهَا ، ثُمَّ خَرَجَ  أَبُو بَكْرٍ ،  فَقَالَ لَهُ : مَا أَخْرَجَكَ يَا  أَبَا بَكْرٍ ؟  قَالَ : أَخْرَجَنِي الْجُوعُ ! قَالَ : وَأَنَا أَخْرَجَنِي الَّذِي أَخْرَجَكَ ! قَالَ : ثُمَّ خَرَجَ  عُمَرُ ،  فَقَالَ لَهُ : مَا أَخْرَجَكَ يَا  عُمَرُ ؟  قَالَ : أَخْرَجَنِي وَالَّذِي بَعَثَكَ بِالْحَقِّ الْجُوعُ ! ثُمَّ سَارَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَاسٌ مِنْ أَصْحَابِهِ فَقَالَ لَهُمُ : انْطَلِقُوا بِنَا إِلَى مَنْزِلِ  أَبِي الْهَيْثَمِ بْنِ التَّيِّهَانِ  . فَانْطَلَقُوا ، فَلَمَّا انْتَهَوْا إِلَى مَنْزِلِ  أَبِي الْهَيْثَمِ  قَالَتِ امْرَأَتُهُ : إِنَّ  أَبَا         [19/255]      الْهَيْثَمِ  قَدْ ذَهَبَ  يَسْتَعْذِبُ  لَنَا مِنَ الْمَاءِ ، فَدُورُوا إِلَى الْحَائِطِ ، فَفَتَحَتْ لَهُمْ بَابَ الْحَائِطِ فَجَلَسُوا ، فَجَاءَ  أَبُو الْهَيْثَمِ  فَقَالَتْ لَهُ امْرَأَتُهُ : تَدْرِي مَنْ عِنْدَكَ ؟ فَقَالَ : لَا ، فَقَالَتْ : عِنْدَكَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابُهُ ، فَدَخَلَ فَعَلَّقَ فَرَسَهُ عَلَى نَخْلَةٍ ، ثُمَّ أَتَاهُمْ فَسَلَّمَ عَلَيْهِمْ حَيَّى وَرَحَّبَ ، ثُمَّ أَتَى  مَخْرَفًا  لَهُ فَأَتَى  عِذْقًا  فَاخْتَرَفَ لَهُمْ رُطَبًا ، فَأَتَاهُمْ بِهِ فَصَبَّهُ بَيْنَ أَيْدِيهِمْ ، ثُمَّ إِنَّ  أَبَا الْهَيْثَمِ  أَهْوَى إِلَى غُنَيْمَةٍ لَهُ فِي نَاحِيَةِ الْحَائِطِ لَيَذْبَحَ لَهُمْ مِنْهَا شَاةً ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَمَّا ذَاتُ  دَرٍّ  فَلَا ، فَأَخَذَ شَاةً فَذَبَحَهَا وَسَلَخَهَا وَقَطَّعَهَا أَعْضَاءً فَطَبَخَهَا بِالْمَاءِ وَالْمِلْحِ ، ثُمَّ أَتَى امْرَأَتَهُ فَسَأَلَهَا : هَلْ عِنْدَكِ مِنْ شَيْءٍ ؟ فَقَالَتْ : نَعَمْ ، عِنْدَنَا شَيْءٌ مِنْ شَعِيرٍ كُنَّا نُؤَخِّرُهُ ، فَطَحَنَاهُ بَيْنَهُمَا ، ثُمَّ عَجَنَتْهُ وَخَبَزَتْهُ ، فَكَسَرَهُ  أَبُو الْهَيْثَمِ  وَأَكْفَأَ عَلَيْهِ ذَلِكَ اللَّحْمَ الَّذِي طَبَخَهُ ، ثُمَّ أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابَهُ فَأَكَلُوا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : يَا  أَبَا الْهَيْثَمِ ،  أَمَا لَكَ مِنْ خَادِمٍ ؟ قَالَ : لَا ، وَالَّذِي بَعَثَكَ بِالْحَقِّ مَا لَنَا خَادِمٌ . قَالَ : فَإِذَا بَلَغَكَ أَنَّهُ جَاءَنَا سَبْيٌ فَائْتِنَا نُخْدِمْكَ . فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَبْيٌ فَأَتَاهُ  أَبُو الْهَيْثَمِ  وَبَيْنَ يَدَيْهِ  غُلَامَانِ ، أَوْ قَالَ : وَصِيفَانِ  ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : يَا  أَبَا الْهَيْثَمِ ،  اخْتَرْ مِنْهُمَا - أَوْ قَالَ : تَخَايَرْ مِنْهُمَا  ، فَقَالَ  أَبُو الْهَيْثَمِ  : يَا رَسُولَ اللهِ خِرْ لِي ، فَاحْتَاطَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى  حَسَرَ  عَنْ ذِرَاعَيْهِ ، وَقَالَ :  الْمُسْتَشَارُ مُؤْتَمَنٌ يَا  أَبَا الْهَيْثَمِ ،  خُذْ هَذَا .  فَلَمَّا وَلَّى بِهِ  أَبُو الْهَيْثَمِ  قَالَ : يَا  أَبَا الْهَيْثَمِ ،  أَحْسِنْ إِلَيْهِ ، فَإِنِّي قَدْ رَأَيْتُهُ يُصَلِّي . قَالَ : نَعَمْ ، نُطْعِمُهُ مِمَّا نَأْكُلُ وَنُلْبِسُهُ مِمَّا نَلْبَسُ ، وَلَا نُكَلِّفُهُ مِنَ الْعَمَلِ مَا لَا يُطِيقُ . فَانْطَلَقَ  أَبُو الْهَيْثَمِ  إِلَى أَهْلِهِ فَفَرِحُوا بِهِ فَرَحًا شَدِيدًا وَقَالُوا : الْحَمْدُ لِلهِ الَّذِي رَزَقَنَا خَادِمًا يَخْدِمُنَا وَيُعِينُنَا عَلَى ضَيْعَتِنَا ! فَقَالَ  أَبُو الْهَيْثَمِ  : إِنَّ رَسُولَ اللهِ         [19/256]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ أَوْصَانِي بِهِ ، قَالَتِ امْرَأَتُهُ : نَعَمْ ، نُطْعِمُهُ مِمَّا نَأْكُلُ ، وَنُلْبِسُهُ مِمَّا نَلْبَسُ ، وَلَا نُكَلِّفُهُ مِنَ الْعَمَلِ مَا لَا يُطِيقُ ! قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَوْصَانِي بِهِ ، قَالَتِ امْرَأَتُهُ : سُبْحَانَ اللهِ ، خَادِمٌ أَخْدَمَنَا اللهُ وَرَسُولُهُ تُرِيدُ أَنْ تَحْرِمَنَاهُ ؟ فَقَالَ  أَبُو الْهَيْثَمِ  لِلْغُلَامِ  : أَنْتَ  حُرٌّ  لِوَجْهِ اللهِ ، فَإِنْ أَحْبَبْتَ أَنْ تُقِيمَ مَعَنَا نُطْعِمْكَ مِمَّا نَأْكُلُ وَنُلْبِسْكَ مِمَّا نَلْبَسُ وَلَا نُكَلِّفْكَ مِنَ الْعَمَلِ إِلَّا مَا تُطِيقُ ، وَإِنْ شِئْتَ فَاذْهَبْ حَيْثُ شِئْتَ  .","","Al-Mu'jam al-Kabir 569","","عبد الله بن عمر بن الخطاب عن نافع مولى ابن عمر عن عبد الله بن عمر العمري عن بكار بن محمد السيريني عن محمد بن زكريا بن دينار الإخباري عن الطبراني","من أخباره"
"17650","570  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الْبَغَوِيُّ  ، ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،  ثَنَا  شَيْبَانُ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي هُرَيْرَةَ قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَاعَةٍ لَا يَخْرُجُ فِيهَا وَلَا يَلْقَاهُ فِيهَا أَحَدٌ ، فَأَتَاهُ  أَبُو بَكْرٍ  فَقَالَ : مَا أَخْرَجَكَ يَا  أَبَا بَكْرٍ ؟  قَالَ : خَرَجْتُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَالنَّظَرِ فِي وَجْهِهِ وَالتَّسْلِيمِ عَلَيْهِ ، فَلَمْ يَلْبَثْ أَنْ جَاءَ  عُمَرُ ،  فَقَالَ : مَا أَخْرَجَكَ يَا  عُمَرُ ؟  قَالَ : الْجُوعُ ! قَالَ : وَأَنَا قَدْ وَجَدْتُ بَعْضَ الَّذِي تَجِدُ ، فَانْطَلِقُوا بِنَا إِلَى  أَبِي الْهَيْثَمِ بْنِ التَّيِّهَانِ الْأَنْصَارِيِّ -  وَكَانَ رَجُلًا كَثِيرَ الْخَيْلِ  وَالْشِيَاهِ  ، وَلَمْ يَكُنْ لَهُ خَادِمٌ ، فَأَتَوْهُ فَلَمْ يَجِدُوهُ وَوَجَدُوا  امْرَأَتَهُ ،  فَقَالَ : أَيْنَ صَاحِبُكُمْ ؟ قَالَتِ : انْطَلَقَ غُدْوَةً  ليَسْتَعْذِبَ  مِنَ الْمَاءِ مِنْ قَنَاةِ بَنِي فُلَانٍ ، فَلَمْ يَلْبَثْ أَنْ جَاءَ بِقِرْبَةٍ ثُمَّ وَضَعَهَا ، ثُمَّ أَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَلْزَمُهُ وَيُفَدِّيهِ بِأَبِيهِ وَأُمِّهِ ، فَانْطَلَقَ بِهِمْ إِلَى ظِلِّ  حَدِيقَتِهِ  فَبَسَطَ لَهُمْ بِسَاطًا ، ثُمَّ انْطَلَقَ إِلَى نَخْلَةٍ فَجَاءَ  بِعِذْقٍ  ، فَقَالَ رَسُولُ         [19/257]      اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : فَهَلَّا تَنَقَّيْتَ مِنْ رُطَبِهِ ؟ فَقَالَ : أَرَدْتُ أَنْ تُحِسُّونَ مِنْ رُطَبِهِ وَبُسْرِهِ ، فَأَكَلُوا وَشَرِبُوا مِنْ ذَلِكَ الْمَاءِ ، فَلَمَّا فَرَغَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  هَذَا وَالَّذِي نَفْسِي بِيَدِهِ مِنَ النَّعِيمِ الَّذِي تُسْأَلُونَ عَنْهُ يَوْمَ الْقِيَامَةِ ، هَذَا الظِّلُّ الْبَارِدُ وَالرُّطَبُ الْبَادِ عَلَيْهِ الْمَاءُ  ، انْطَلِقْ فَضَعْ لَهُمْ طَعَامًا ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَا تَذْبَحْ ذَاتَ  دَرٍّ  ، فَذَبَحَ لَهُمْ  عَنَاقًا  أَوْ  جَدْيًا  ، ثُمَّ أَتَاهُمْ فَأَكَلُوا ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : هَلْ لَكَ مِنْ خَادِمٍ ؟ قَالَ : لَا . قَالَ : فَإِذَا أَتَانَا سَبْيٌ فَائْتِنَا ، فَأَتَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأْسَانِ لَيْسَ لَهُمَا ثَالِثٌ ، فَقَالَ : اخْتَرْهُمَا ، فَقَالَ : يَا رَسُولَ اللهِ خِرْ لِي ، فَقَالَ : الْمُسْتَشَارُ مُؤْتَمَنٌ ، خُذْ هَذَا فَإِنِّي قَدْ رَأَيْتُهُ يُصَلِّي ، وَاسْتَوْصِ بِهِ مَعْرُوفًا ، فَأَتَى امْرَأَتَهُ فَحَدَّثَهَا حَدِيثَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَتْ : مَا شَيْءٌ هَمَّا بِهِ قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَيْرٌ مِنْ عِتْقِهِ . قَالَ : فَهُوَ عَتِيقٌ ، فَقَالَ  أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  : إِنَّمَا يُسْأَلُ عَنْهُ مَنْ لَمْ يُسَمِّ اللهَ عَلَى أَوَّلِهِ وَلَمْ يَحْمَدِ اللهَ عَلَى آخِرِهِ ، فَأَمَّا مَنْ سَمَّى فِي أَوَّلِهِ وَحَمِدَ فِي آخِرِهِ فَقَدْ أَدَّى شُكْرَهُ  .","","Al-Mu'jam al-Kabir 570","","أبو هريرة الدوسي عن أبو سلمة بن عبد الرحمن عن عبد الملك بن عمير القبطي عن شيبان بن عبد الرحمن المؤدب عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","من أخباره"
"17651","571  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ الْهَرَوِيُّ ،  ثَنَا  خَلَفُ بْنُ خَلِيفَةَ ،  عَنْ  يَزِيدَ بْنِ كَيْسَانَ ،  عَنْ  أَبِي حَازِمٍ ،  عَنْ  أَبِي هُرَيْرَةَ - رَضِيَ اللهُ عَنْهُ - قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا ، فَإِذَا هُوَ  بِأَبِي بَكْرٍ  وَعُمَرَ  رَضِيَ اللهُ عَنْهُمَا ، فَقَالَ : مَا أَخْرَجَكُمَا مِنْ بُيُوتِكُمَا ؟ قَالَا : الْجُوعُ ! قَالَ : وَأَنَا وَالَّذِي نَفْسِي بِيَدِهِ مَا أَخْرَجَنِي إِلَّا الَّذِي أَخْرَجَكُمَا ، قُومُوا . فَقَامُوا مَعَهُ وَأَتَى  رَجُلًا مِنَ الْأَنْصَارِ  ، فَإِذَا الْأَنْصَارِيُّ لَيْسَ ثَمَّ ، وَإِذَا هُوَ  بِالْمَرْأَةِ ،  فَقَالَ لَهَا : أَيْنَ فُلَانٌ ؟ قَالَتِ : انْطَلَقَ  يَسْتَعْذِبُ  لَنَا مِنَ الْمَاءِ ،         [19/258]      فَبَيْنَمَا هُوَ كَذَلِكَ إِذْ جَاءَ الْأَنْصَارِيُّ وَعَلَيْهِ قِرْبَةٌ مِنْ مَاءٍ ، فَلَمَّا نَظَرَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَصَاحِبَيْهِ قَالَ : اللهُ أَكْبَرُ ! مَا أَحَدٌ مِنَ النَّاسِ أَكْرَمُ مِنْ أَضْيَافِنَا . قَالَ : فَعَلَّقَ الْقِرْبَةَ وَقَطَعَ لَهُمْ  عِذْقًا  فِيهِ بُسْرٌ وَرُطَبٌ وَتَمْرٌ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَوِ انْتَقَيْتَ ؟ قَالَ :  تَخَيَّرُوا  يَا رَسُولَ اللهِ عَلَى أَعْيُنِكُمْ . قَالَ : وَأَخَذَ الْمُدْيَةَ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِيَّاكَ  وَالْحَلُوبَ  ! فَذَبَحَ لَهُمْ فَأَكَلُوا ، فَلَمَّا فَرَغُوا قَالَ لَهُمُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَتُسْأَلُنَّ عَنْ هَذَا النَّعِيمِ يَوْمَ الْقِيَامَةِ ، أَخْرَجَكُمْ مِنْ بُيُوتِكُمُ الْجُوعُ ثُمَّ لَمْ تَرْجِعُوا حَتَّى أَصَبْتُمْ مِنْ هَذَا النَّعِيمِ  .","","Al-Mu'jam al-Kabir 571","","أبو هريرة الدوسي عن سلمان الأعرج مولى عزة الأشجعية عن يزيد بن كيسان اليشكري عن خلف بن خليفة الأشجعي عن إبراهيم بن عبد الله الهروي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","من أخباره"
"17652","572  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ (  ح  ) .  وَحَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ الْعَطَّارُ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ - قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَمَّارِ بْنِ أَبِي عَمَّارٍ ،  عَنْ  جَابِرِ بْنِ عَبْدِ اللهِ الْأَنْصَارِيِّ قَالَ :  جَاءَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  وَأَبُو بَكْرٍ  وَعُمَرُ  فَأَطْعَمْنَاهُمْ رُطَبًا وَسَقَيْنَاهُمْ مِنَ الْمَاءِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَذَا مِنَ النَّعِيمِ الَّذِي تُسْأَلُونَ عَنْهُ يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 572","","جابر بن عبد الله بن عمرو بن حرام الأنصاري عن عمار بن أبي عمار الحارثي عن حماد بن سلمة عن هدبة بن خالد عن سليمان بن الحسن العطار عن الطبراني","من أخباره"
"17653","مَا  أَسْنَدَ  مَالِكُ بْنُ التَّيِّهَانِ  573  -  حَدَّثَنَا  مُحَمَّدُ بْنُ النَّضِرِ الْأَزْدِيُّ  ، ثَنَا  شِهَابُ بْنُ عَبَّادٍ الْعَبْدِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ ،  عَنْ  دَاوُدَ بْنِ أَبِي عَبْدِ اللهِ - أَخُو شَقِيقِ بْنِ أَبِي         [19/259]      عَبْدِ اللهِ مَوْلَى الْحَسَنِ بْنِ أَبِي عَبْدِ اللهِ بْنِ أَبِي طَالِبٍ -  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ مُحَمَّدِ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  جَدَّتِهِ  ،  عَنْ  أَبِي الْهَيْثَمِ بْنِ التَّيِّهَانِ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْمُسْتَشَارُ مُؤْتَمَنٌ  .","","Al-Mu'jam al-Kabir 573","","مالك بن التيهان الأنصاري عن جدة عبد الرحمن بن محمد القرشي عن عبد الرحمن بن محمد القرشي عن داود بن أبي عبد الله الهاشمي عن محمد بن بشر بن الفرافصة عن شهاب بن عباد الرواس عن محمد بن أحمد بن النضر النضري عن الطبراني","ما أسند مالك بن التيهان"
"17654","574  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  الْحَسَنُ بْنُ سَهْلٍ الْحَنَّاطُ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ - قَالَا :  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  أَيُّوبَ بْنِ خَالِدٍ ،  عَنْ  أَبِي أُمَامَةَ بْنِ سَهْلِ بْنِ حُنَيْفٍ ،  عَنْ  مَالِكِ بْنِ التَّيِّهَانِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ قَالَ السَّلَامُ عَلَيْكُمْ كُتِبَتْ لَهُ عَشْرُ حَسَنَاتٍ  ، وَمَنْ قَالَ السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ كُتِبَتْ لَهُ عِشْرُونَ حَسَنَةً ، وَمَنْ قَالَ السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ كُتِبَتْ لَهُ خَمْسُونَ حَسَنَةً  .","","Al-Mu'jam al-Kabir 574","","مالك بن التيهان الأنصاري عن أسعد بن سهل بن حنيف عن أيوب بن خالد بن صفوان النجاري عن موسى بن عبيدة بن نشيط الحميري عن حماد بن أسامة القرشي عن الحسن بن علي الريحاني عن عبيد العجل عن الطبراني","ما أسند مالك بن التيهان"
"17655","مَالِكُ بْنُ رَبِيعَةَ ، أَبُو أُسَيْدٍ الْأَنْصَارِيُّ ثُمَّ الْخَزْرَجِيُّ ثُمَّ السَّاعِدِيُّ ، بَدْرِيٌّ  575  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ بْنِ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ  ، ثَنَا  عَبْدُ الْمَلِكِ بْنُ هِشَامٍ السَّدُوسِيُّ  ، ثَنَا  زِيَادُ بْنُ عَبْدِ اللهِ  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  :  فِي تَسْمِيَةِ مَنْ شَهِدَ  بَدْرًا  أَبُو أُسَيْدٍ مَالِكُ بْنُ رَبِيعَةَ بْنِ الْبُدْنِ بْنِ عَامِرِ بْنِ عَوْفِ بْنِ حَارِثَةَ بْنِ عَمْرِو بْنِ الْخَزْرَجِ بْنِ سَاعِدَةَ بْنِ كَعْبِ بْنِ الْخَزْرَجِ بْنِ حَارِثَةَ بْنِ ثَعْلَبَةَ بْنِ عَمْرِو بْنِ عَامِرٍ .","","Al-Mu'jam al-Kabir 575","","","مالك بن ربيعة أبو أسيد الأنصاري ثم الخزرجي ثم الساعدي"
"17656","[19/260]      576  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  يَزِيدَ بْنِ حَازِمٍ ،  عَنْ  سُلَيْمَانَ بْنِ يَسَارٍ  أَنَّ  أَبَا أُسَيْدٍ السَّاعِدِيَّ أُصِيبَ بَصَرُهُ قَبْلَ قَتْلِ  عُثْمَانَ ،  فَقَالَ :  الْحَمْدُ لِلهِ الَّذِي  مَتَّعَنِي  بِبَصَرِي فِي حَيَاةِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  ، فَلَمَّا أَرَادَ اللهُ الْفِتْنَةَ فِي عِبَادِهِ كَفَّ بَصَرِي عَنْهَا  .","","Al-Mu'jam al-Kabir 576","","مالك بن ربيعة أبو أسيد الساعدي عن سليمان بن يسار مولى ميمونة زوج رسول الله عن يزيد بن حازم الجهضمي عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مالك بن ربيعة أبو أسيد الأنصاري ثم الخزرجي ثم الساعدي"
"17657","577  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ،  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  قَالَ :  تُوُفِّيَ  أَبُو أُسَيْدٍ السَّاعِدِيُّ  - وَاسْمُهُ  مَالِكُ بْنُ رَبِيعَةَ  - سَنَةَ ثَلَاثِينَ ،  وَسِنُّهُ تِسْعُونَ سَنَةً  .","","Al-Mu'jam al-Kabir 577","","","مالك بن ربيعة أبو أسيد الأنصاري ثم الخزرجي ثم الساعدي"
"17658","مَا  أَسْنَدَ  أَبُو أُسَيْدٍ  سَهْلُ بْنُ سَعْدٍ السَّاعِدِيُّ  عَنْ  أَبِي أُسَيْدٍ  578  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ وَزَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عُزَيْزٍ الْأَيْلِيُّ ،  ثَنَا  سَلَامَةُ بْنُ رَوْحٍ ،  عَنْ  عُقَيْلِ بْنِ خَالِدٍ  ،  عَنِ  ابْنِ شِهَابٍ ،  أَخْبَرَنِي  أَبُو حَازِمٍ ،  عَنْ  سَهْلِ بْنِ سَعْدٍ قَالَ :  قَالَ لِي  أَبُو أُسَيْدٍ السَّاعِدِيُّ بَعْدَمَا ذَهَبَ بَصَرُهُ :  يَا ابْنَ أَخِي ، لَوْ كُنْتُ أَنَا وَأَنْتَ الْآنَ  بِبَدْرٍ  ثُمَّ أَطْلَقَ اللهُ لِي بَصَرِي لَأَرَيْتُكَ الشِّعْبَ الَّذِي خَرَجَتْ عَلَيْنَا مِنْهُ الْمَلَائِكَةُ غَيْرَ شَكٍّ وَلَا تَمَارٍ  .  في طبعة مكتبة ابن تيمية :(عقيل وخالد) والمثبت من النسخة الخطية ، وما فيها أقرب للمثبت وينظر مصادر الترجمة ، والله أعلم .","","Al-Mu'jam al-Kabir 578","","مالك بن ربيعة أبو أسيد الساعدي عن سهل بن سعد الساعدي عن سلمة بن دينار الأعرج عن الزهري عن عقيل بن خالد الأيلي عن سلامة بن روح الأيلي عن محمد بن عزيز بن عبد الله الأيلي عن الساجي عن الطبراني","سهل بن سعد الساعدي عن أبي أسيد"
"17659","[19/261]      أَنَسُ بْنُ مَالِكٍ  عَنْ  أَبِي أُسَيْدٍ  579  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ التُّنُوخِيُّ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  أَبِي أُسَيْدٍ الْأَنْصَارِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُ  دُورِ  الْأَنْصَارِ  بَنُو النَّجَّارِ  ثُمَّ  بَنُو عَبْدِ الْأَشْهَلِ  ثُمَّ  بَنُو الْحَارِثِ بْنِ الْخَزْرَجِ  ثُمَّ  بَنُو سَاعِدَةَ ،  وَفِي كُلِّ  دُورِ  الْأَنْصَارِ  خَيْرٌ  . فَقَالَ  سَعْدُ بْنُ عُبَادَةَ  : مَا أَرَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا قَدْ فَضَّلَ عَلَيْنَا ! قَالَ : قَدْ فُضِّلْتُمْ عَلَى كَثِيرٍ  .","","Al-Mu'jam al-Kabir 579","","مالك بن ربيعة أبو أسيد الساعدي عن أنس بن مالك عن قتادة بن دعامة عن شعبة بن الحجاج عن عفان بن مسلم الصفار عن أحمد بن محمد التنوخي عن الطبراني","أنس بن مالك عن أبي أسيد"
"17660","حَمْزَةُ بْنُ أَبِي أُسَيْدٍ  عَنْ أَبِيهِ  580  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  أَبِي الْيَمَانِ النَّبَّالِ ،  عَنْ  شَدَّادِ بْنِ أَبِي عَمْرِو بْنِ حِمَاسٍ ،  عَنْ  حَمْزَةَ بْنِ أَبِي أُسَيْدٍ الْأَنْصَارِيِّ ،  عَنْ  أَبِيهِ  أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ خَارِجٌ مِنَ الْمَسْجِدِ فَاخْتَلَطَ الرِّجَالُ مَعَ النِّسَاءِ فِي الطَّرِيقِ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اسْتَأْخِرْنَ ، فَإِنَّهُ لَيْسَ لَكُنَّ أَنْ  تَحْقُقْنَ  الطَّرِيقَ ، عَلَيْكُنَّ بِحَافَّاتِ الطَّرِيقِ  . وَكَانَتِ الْمَرْأَةُ تَلْتَصِقُ بِالْجِدَارِ ، حَتَّى إِنَّ ثَوْبَهَا لَيَتَعَلَّقُ بِالشَّيْءِ مِنَ الْجِدَارِ مِنْ لُصُوقِهَا  .","","Al-Mu'jam al-Kabir 580","","مالك بن ربيعة أبو أسيد الساعدي عن حمزة بن أبي أسيد الساعدي عن شداد بن أبي عمرو الليثي عن كثير بن اليمان الرحال عن عبد العزيز بن محمد الدراوردي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حمزة بن أبي أسيد عن أبيه"
"17661","[19/262]      581  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْغَسِيلِ ،  عَنْ  حَمْزَةَ بْنِ أَبِي أُسَيْدٍ ،  عَنْ  أَبِيهِ  قَالَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَوْمَ بَدْرٍ  حِينَ صَفَفْنَا لِلْقِتَالِ :  إِنْ  أَكْثَبُوكُمْ  فَارْمُوهُمْ بِالنَّبْلِ  .","","Al-Mu'jam al-Kabir 581","","مالك بن ربيعة أبو أسيد الساعدي عن حمزة بن أبي أسيد الساعدي عن عبد الرحمن بن سليمان الأوسي عن الفضل بن دكين عن أبو زرعة الدمشقي عن الطبراني","حمزة بن أبي أسيد عن أبيه"
"17662","582  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْغَسِيلِ ،  حَدَّثَنِي  الْعَبَّاسُ بْنُ سَهْلٍ  عَنْ  أَبِيهِ  وَحَمْزَةَ بْنِ أَبِي أُسَيْدٍ ،  عَنْ  أَبِيهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا  أَكْثَبُوكُمْ  فَارْمُوهُمْ بِالنَّبْلِ  .","","Al-Mu'jam al-Kabir 582","","مالك بن ربيعة أبو أسيد الساعدي عن حمزة بن أبي أسيد الساعدي عن عبد الرحمن بن سليمان الأوسي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","حمزة بن أبي أسيد عن أبيه"
"17663","583  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ قَالَ :  ثَنَا  أَبُو نُعَيْمٍ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ - قَالَا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْغَسِيلِ ،  حَدَّثَنِي  عَبَّاسُ بْنُ سَهْلٍ ،  وَحَمْزَةُ بْنُ أَبِي أُسَيْدٍ ،  عَنْ  أَبِيهِ  قَالَ :  مَرَّ بِنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَصْحَابٌ لَهُ فَخَرَجْنَا مَعَهُ فَانْطَلَقْنَا حَتَّى انْتَهَيْنَا إِلَى حَائِطٍ يُقَالُ لَهُ  الشَّوْطُ  ، حَتَّى انْتَهَيْنَا إِلَى حَائِطَيْنِ فَجَلَسْنَا بَيْنَهُمَا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : اجْلِسُوا هَاهُنَا ، وَقَدْ أُتِيَ  بِالْجَوْنِيَّةِ  فَعُزِلَتْ فِي بَيْتِ  أُمَيْمَةَ بِنْتِ الْحَارِثِ بْنِ شَرَاحِيلَ  وَمَعَهَا دَايَةٌ لَهَا ، فَلَمَّا دَخَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : هَبِي إِلَيَّ نَفْسَكِ ، قَالَتْ : وَهَلْ تَهَبُ الْمَلِكَةُ نَفْسَهَا  لِلسُّوقَةِ  ؟  فَأَهْوَى  بِيَدِهِ إِلَيْهَا لِيَضَعَهَا عَلَيْهَا ، فَقَالَتْ : إِنِّي أَعُوذُ بِاللهِ مِنْكَ ! قَالَ : لَقَدْ  عُذْتِ  بِمَعَاذٍ ! ثُمَّ خَرَجَ عَلَيْنَا ،         [19/263]      فَقَالَ :  يَا  أَبَا أُسَيْدٍ ،  اكْسُهَا  رَازِقِيَّتَيْنِ  وَأَلْحِقْهَا بِأَهْلِهَا  .","","Al-Mu'jam al-Kabir 583","","مالك بن ربيعة أبو أسيد الساعدي عن حمزة بن أبي أسيد الساعدي عن عبد الرحمن بن سليمان الأوسي عن الفضل بن دكين عن أبو زرعة الدمشقي عن الطبراني","حمزة بن أبي أسيد عن أبيه"
"17664","584  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ الْهَرَوِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ إِسْحَاقَ بْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ ،  حَدَّثَنِي  جَدِّي أَبُو أُمِّي  مَالِكُ بْنُ حَمْزَةَ بْنِ أَبِي أُسَيْدٍ السَّاعِدِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ أَبِي أُسَيْدٍ السَّاعِدِيِّ  قَالَ :  قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِلْعَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ  :  يَا  أَبَا الْفَضْلِ ،  لَا  تَرِمْ  مَنْزِلَكَ أَنْتَ وَبَنُوكَ غَدًا حَتَّى آتِيَكُمْ  ، فَانْتَظَرُوهُ حَتَّى جَاءَ بَعْدَمَا أَضْحَى ، فَدَخَلَ عَلَيْهِمْ فَقَالَ : السَّلَامُ عَلَيْكُمْ . قَالَ : وَعَلَيْكَ السَّلَامُ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ . قَالَ : كَيْفَ أَصْبَحْتُمْ ؟ قَالَ : بِخَيْرٍ ، أَحْمَدُ اللهَ . فَقَالَ : تَقَارَبُوا تَقَارَبُوا تَقَارَبُوا ،  يَزْحَفُ  بَعْضُكُمْ إِلَى بَعْضٍ ، حَتَّى إِذَا أَمْكَنُوهُ اشْتَمَلَ عَلَيْهِمْ بِمُلَاءَتِهِ ، ثُمَّ قَالَ : يَا رَبِّ ، هَذَا عَمِّي  وَصِنْوُ  أَبِي ، وَهَؤُلَاءِ أَهْلُ بَيْتِي ، فَاسْتُرْهُمْ مِنَ النَّارِ كَسَتْرِي إِيَّاهُمْ بِمُلَاءَتِي هَذِهِ . قَالَ : فَأَمَّنَتْ أُسْكُفَّةُ الْبَابِ وَحَوَائِطُ الْبَيْتِ فَقَالَتْ : آمِينَ آمِينَ آمِينَ  .","","Al-Mu'jam al-Kabir 584","","مالك بن ربيعة أبو أسيد الساعدي عن حمزة بن أبي أسيد الساعدي عن مالك بن حمزة بن أبي أسيد الساعدي عن عبد الله بن عثمان بن إسحاق بن سعد بن أبي وقاص عن إبراهيم بن عبد الله الهروي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حمزة بن أبي أسيد عن أبيه"
"17665","585  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ الْهَرَوِيُّ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ عُثْمَانَ بْنِ إِسْحَاقَ بْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ قَالَ :  سَمِعْتُ مِنْ  أَبِي أُمِّي  مَالِكِ بْنِ حَمْزَةَ بْنِ أَبِي أُسَيْدٍ  يُحَدِّثُ عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ أَبِي أُسَيْدٍ السَّاعِدِيِّ الْخَزْرَجِيِّ  قَالَ -  وَلَهُ بِئْرٌ  بِالْمَدِينَةِ  يُقَالُ لَهَا  بِئْرُ بُضَاعَةَ :  قَدْ بَصَقَ فِيهَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَهُوَ يَبْشُرُ بِهَا وَيَتَيَمَّنُ بِهَا ، قَالَ : فَلَمَّا قَطَعَ  أَبُو أُسَيْدٍ  ثَمَرَةَ  حَائِطِهِ جَعَلَهَا فِي غُرْفَةٍ لَهُ ، فَكَانَتِ الْغُولُ تُخَالِفُهُ         [19/264]      إِلَى  مَشْرُبَتِهِ  فَتَسْرِقُ تَمْرَهُ وَتُفْسِدُهُ عَلَيْهِ ، فَشَكَا ذَلِكَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  تِلْكَ الْغُولُ يَا  أَبَا أُسَيْدٍ  فَاسْتَمِعْ عَلَيْهَا  ، فَإِذَا سَمِعْتَ اقْتِحَامَهَا -  يَعْنِي  وَجْبَتَهَا  - فَقُلْ : بِسْمِ اللهِ ، حَبَسَنِي رَسُولُ اللهِ ، فَقَالَتِ الْغُولُ : يَا  أَبَا أُسَيْدٍ ،  اعْفِنِي أَنْ تُكَلِّفَنِي أَذْهَبُ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأُعْطِيكَ مَوْثِقًا مِنَ اللهِ أَنْ لَا أُخَالِفَكَ إِلَى بَيْتِكَ وَلَا أَسْرِقَ تَمْرَكَ ، فَأَدُلَّكَ عَلَى آيَةٍ مِنْ كِتَابِ اللهِ فَتَقْرَأَ بِهَا عَلَى بَيْتِكَ فَلَا نُخَالِفُ إِلَى أَهْلِكَ وَلَا نَكْشِفُ غِطَاءَهُ ، فَأَعْطَتْهُ الْمَوْثِقَ الَّذِي رَضِيَ بِهِ مِنْهَا ، فَقَالَتِ : الْآيَةُ الَّتِي أَدُلُّكَ عَلَيْهَا هِيَ آيَةُ الْكُرْسِيِّ ، ثُمَّ حَكَّتِ اسْتَهَا تَضْرَطُ ، فَأَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَصَّ عَلَيْهِ الْقِصَّةَ حَيْثُ وَلَّتْ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : صَدَقَتْ وَهِيَ كَذُوبٌ  .","","Al-Mu'jam al-Kabir 585","","مالك بن ربيعة أبو أسيد الساعدي عن حمزة بن أبي أسيد الساعدي عن مالك بن حمزة بن أبي أسيد الساعدي عن عبد الله بن عثمان بن إسحاق بن سعد بن أبي وقاص عن إبراهيم بن عبد الله الهروي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حمزة بن أبي أسيد عن أبيه"
"17666","الزُّبَيْرُ بْنُ أَبِي أُسَيْدٍ  عَنْ أَبِيهِ  586  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ (  ح  ) .  وَحَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  أَبُو مُوسَى الْأَنْصَارِيُّ - قَالَا :  ثَنَا  الْحَسَنُ بْنُ عَلِيِّ بْنِ حَسَنِ بْنِ أَبِي حَسَنٍ الْبَرَّادُ الْمَدِينِيُّ ،  حَدَّثَنِي  أَبِي عَلِيُّ بْنُ حَسَنٍ ،  أَخْبَرَنِي  الزُّبَيْرُ بْنُ أَبِي أُسَيْدٍ ،  عَنْ  أَبِيهِ  أَنَّ  رَجُلًا  جَاءَ إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ : بِأَبِي أَنْتَ وَأُمِّي ، إِنِّي قَدْ رَأَيْتُ مَوْضِعًا لِلسُّوقِ ، أَفَلَا تَنْظُرُ إِلَيْهِ ؟ قَالَ :         [19/265]      بَلَى ، فَقَامَ مَعَهُ حَتَّى جَاءَ مَوْضِعَ السُّوقِ ، فَلَمَّا رَآهُ أَعْجَبَهُ وَرَكَضَهُ بِرِجْلِهِ  ، ثُمَّ قَالَ : نِعْمَ سُوقُكُمْ هَذَا ، فَلَا يُنْتَقَضْ ، وَلَا يُضْرَبَنَّ عَلَيْهِ خَرَاجٌ  .","","Al-Mu'jam al-Kabir 586","","مالك بن ربيعة أبو أسيد الساعدي عن الزبير بن المنذر الساعدي عن علي بن الحسن البراد عن الحسن بن علي بن حسن البراد عن إسحاق بن موسى الخطمي عن موسى بن هارون الحمال عن الطبراني","الزبير بن أبي أسيد عن أبيه"
"17667","يَزِيدُ بْنُ زَيْدٍ  عَنْ  أَبِي أُسَيْدٍ  587  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ صَالِحٍ التَّمَّارُ ،  عَنْ  يَزِيدَ بْنِ زَيْدٍ ،  عَنْ  أَبِي أُسَيْدٍ السَّاعِدِيِّ قَالَ :  أَنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  قَبْرِ حَمْزَةَ بْنِ عَبْدِ الْمُطَّلِبِ  ، فَجَعَلُوا يَجُرُّونَ  النَّمِرَةَ  عَلَى وَجْهِهِ فَتَنْكَشِفُ قَدَمَاهُ ، وَيَجُرُّونَهَا عَلَى قَدَمَيْهِ فَيَنْكَشِفُ وَجْهُهُ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  اجْعَلُوهَا عَلَى وَجْهِهِ ، وَاجْعَلُوا عَلَى قَدَمَيْهِ مِنْ هَذَا الشَّجَرِ .  قَالَ : فَرَفَعَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَأْسَهُ فَإِذَا أَصْحَابُهُ يَبْكُونَ ، فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّهُ يَأْتِي عَلَى النَّاسِ زَمَانٌ يَخْرُجُونَ إِلَى  الْأَرْيَافِ  فَيُصِيبُونَ بِهَا مَطْعَمًا وَمَلْبَسًا  وَمَرْكَبًا - أَوْ قَالَ مَرَاكِبَ  - فَيَكْتُبُونَ إِلَى أَهْلِيهِمْ : هَلُمَّ إِلَيْنَا فَإِنَّكُمْ بِأَرْضٍ مَجَازٍ جَدُوبَةٍ ،  وَالْمَدِينَةُ  خَيْرٌ لَهُمْ لَوْ كَانُوا يَعْلَمُونَ ، وَلَا يَصْبِرُ عَلَى  لَأْوَائِهَا  وَشِدَّتِهَا أَحَدٌ إِلَّا كُنْتُ لَهُ شَفِيعًا وَشَهِيدًا يَوْمَ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 587","","مالك بن ربيعة أبو أسيد الساعدي عن يزيد بن زيد المدني عن محمد بن صالح بن دينار التمار عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يزيد بن زيد عن أبي أسيد"
"17668","غَزِيَّةُ أَبُو عُمَارَةَ  عَنْ  أَبِي أُسَيْدٍ  588  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ وَأَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ الرَّقِّيُّ قَالَا :  ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  عُمَارَةُ بْنُ غَزِيَّةَ ،  عَنْ  أَبِيهِ  أَنَّهُ حَدَّثَ أَنَّ فِتْيَةً سَأَلُوا أَبَا أُسَيْدٍ عَنْ تَخْيِيرِ رَسُولِ اللهِ         [19/266]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  الْأَنْصَارَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  خَيْرُ  قَبَائِلِ  الْأَنْصَارِ  دُورُ  بَنِي النَّجَّارِ  ثُمَّ  بَنِي عَبْدِ الْأَشْهَلِ  ثُمَّ  بَنِي الْحَارِثِ بْنِ الْخَزْرَجِ  ثُمَّ  بَنِي سَاعِدَةَ ،  وَفِي كُلِّ  الْأَنْصَارِ  خَيْرٌ ، قَالَ  أَبُو أُسَيْدٍ  : لَوْ كُنْتُ قَائِلًا غَيْرَ الْحَقِّ لَبَدَأْتُ بِجَدِّي ، وَكَانَ  أَبُو أُسَيْدٍ  سَاعِدِيًّا  .","","Al-Mu'jam al-Kabir 588","","مالك بن ربيعة أبو أسيد الساعدي عن غزية بن الحارث الحجازى عن عمارة بن غزية عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن أحمد بن يحيى بن خالد الرقي عن الطبراني","غزية أبو عمارة عن أبي أسيد"
"17669","أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  أَبِي أُسَيْدٍ  589  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ أَبِي الزِّنَادِ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ أَنَّ أَبَا أُسَيْدٍ صَاحِبَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَخْبَرَهُ  قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  خَيْرُ  دُورِ  الْأَنْصَارِ  دُورُ  بَنِي النَّجَّارِ  ، ثُمَّ  بَنِي عَبْدِ الْأَشْهَلِ  ،  ثُمَّ دَارُ  الْحَارِثِ بْنِ الْخَزْرَجِ  ، ثُمَّ دَارُ  بَنِي سَاعِدَةَ  ، وَفِي كُلِّ  دُورِ  الْأَنْصَارِ  خَيْرٌ  . قَالَ  أَبُو أُسَيْدٍ  : لَوْ كُنْتُ كَاذِبًا لَبَدَأْتُ بِقَوْمِي  بَنِي سَاعِدَةَ ،  فَبَلَغَ ذَلِكَ  سَعْدَ بْنَ عُبَادَةَ  فَوَجَدَ فِي نَفْسِهِ مِنْ ذَلِكَ ، فَقَالَ : خُلِقْنَا فَكُنَّا أَهَمَّ الْأَرْبَعَةِ ، أَسْرِجُوا لِي حِمَارِي آتِي رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ! فَقَالَ لَهُ ابْنُ أَخِيهِ  سَهْلٌ  : أَتَذْهَبُ تَرُدُّ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَوْلَهُ ، وَاللهُ وَرَسُولُهُ أَعْلَمُ ؟ فَأَمَرَ بِحِمَارِهِ فَحُلَّ عَنْهُ  .","","Al-Mu'jam al-Kabir 589","","مالك بن ربيعة أبو أسيد الساعدي عن أبو سلمة بن عبد الرحمن عن أبو الزناد عن عبد الرحمن بن أبي الزناد عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","أبو سلمة بن عبد الرحمن عن أبي أسيد"
"17670","590  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ مَهْدِيٍّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  أَبِي الزِّنَادِ ،  عَنْ  أَبِي سَلَمَةَ ،  عَنْ  أَبِي أُسَيْدٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  خَيْرُ  الْأَنْصَارِ  بَنُو النَّجَّارِ  ، ثُمَّ  بَنُو عَبْدِ الْأَشْهَلِ ،  ثُمَّ  بَنُو سَاعِدَةَ ،  ثُمَّ  بَنُو الْحَارِثِ بْنِ الْخَزْرَجِ  .","","Al-Mu'jam al-Kabir 590","","مالك بن ربيعة أبو أسيد الساعدي عن أبو سلمة بن عبد الرحمن عن أبو الزناد عن سفيان الثوري عن عبد الرحمن بن مهدي عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","أبو سلمة بن عبد الرحمن عن أبي أسيد"
"17671","[19/267]      مَالِكُ بْنُ حَمْزَةَ بْنِ أَبِي أُسَيْدٍ  عَنْ جَدِّهِ  591  -  حَدَّثَنَا  جَعْفَرُ بْنُ سُلَيْمَانَ النَّوْفَلِيُّ الْمَدَنِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ ،  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  عَنْ  عَبْدِ الْمَجِيدِ بْنِ سَهْلٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ الْغَسِيلِ ،  عَنْ  مَالِكِ بْنِ حَمْزَةَ ،  عَنْ  أَبِي أُسَيْدٍ السَّاعِدِيِّ  أَنَّ النَّاسَ جَاءُوا إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لِحَفْرِ  الْخَنْدَقِ  يُبَايِعُونَهُ  عَلَى الْهِجْرَةِ ، فَلَمَّا فَرَغَ قَالَ :  يَا مَعْشَرَ  الْأَنْصَارِ ،  لَا  تُبَايِعُونَ  عَلَى الْهِجْرَةِ  ، إِنَّمَا يُهَاجِرُ النَّاسُ إِلَيْكُمْ ، مَنْ لَقِيَ اللهَ وَهُوَ يُحِبُّ  الْأَنْصَارَ  لَقِيَ اللهَ وَهُوَ يُحِبُّهُ ، وَمَنْ لَقِيَ اللهَ وَهُوَ يُبْغِضُ  الْأَنْصَارَ  لَقِيَ اللهَ وَهُوَ يُبْغِضُهُ  .","","Al-Mu'jam al-Kabir 591","","مالك بن ربيعة أبو أسيد الساعدي عن مالك بن حمزة بن أبي أسيد الساعدي عن عبد الرحمن بن سليمان الأوسي عن عبد المجيد بن سهيل بن عبد الرحمن بن عوف عن محمد بن إسماعيل بن مسلم الديلي عن إبراهيم بن المنذر الحزامي عن جعفر بن سليمان النوفلي عن الطبراني","مالك بن حمزة بن أبي أسيد عن جده"
"17672","عَلِيُّ بْنُ عُبَيْدٍ  عَنْ  أَبِي أُسَيْدٍ  592  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ وَمُوسَى بْنُ هَارُونَ قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْوَاهِبِ الْحَارِثِيُّ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ - قَالُوا :  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْغَسِيلِ ،  حَدَّثَنِي  أَسِيدُ بْنُ عَلِيٍّ ،  عَنْ  أَبِيهِ عَلِيِّ بْنِ عُبَيْدٍ مَوْلَى أَبِي أُسَيْدٍ ،  عَنْ  أَبِي أُسَيْدٍ - وَكَانَ بَدْرِيًّا - قَالَ :  بَيْنَمَا أَنَا جَالِسٌ عِنْدَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذْ جَاءَ  رَجُلٌ مِنَ الْأَنْصَارِ  فَقَالَ :  يَا رَسُولَ اللهِ ، هَلْ أَبَرُّ         [19/268]      وَالِدَيَّ بَعْدَ مَوْتِهِمَا ؟ قَالَ : نَعَمْ ، خِصَالٌ أَرْبَعٌ : الصَّلَاةُ عَلَيْهِمَا وَالِاسْتِغْفَارُ لَهُمَا  ، وَإِيفَاءُ عَهْدِهِمَا بَعْدَ وَفَاتِهِمَا ، وَإِكْرَامُ صَدِيقِهِمَا ، وَصِلَةُ الرَّحِمِ الَّتِي لَا رَحِمَ لَكَ إِلَّا مِنْ قِبَلِهِمَا . قَالَ : فَهَذَا الَّذِي بَقِيَ عَلَيَّ  .","","Al-Mu'jam al-Kabir 592","","مالك بن ربيعة أبو أسيد الساعدي عن علي بن عبيد الله الساعدي عن أسيد بن علي مولى أبي أسيد الساعدي عن عبد الرحمن بن سليمان الأوسي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","علي بن عبيد عن أبي أسيد"
"17673","قُرَّةُ بْنُ أَبِي قُرَّةَ  عَنْ  أَبِي أُسَيْدٍ  593  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ وَعَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ قَالَا :  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  ثَنَا  يَحْيَى بْنُ أَبِي كَثِيرٍ أَنَّ قُرَّةَ بْنَ أَبِي قُرَّةَ  حَدَّثَنَا  أَنَّ أَبَا أُسَيْدٍ  حَدَّثَهُ  أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا صَلَاةَ بَعْدَ صَلَاةِ الْعَصْرِ  .","","Al-Mu'jam al-Kabir 593","","مالك بن ربيعة أبو أسيد الساعدي عن قرة بن أبي قرة عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","قرة بن أبي قرة عن أبي أسيد"
"17674","عِرَاكُ بْنُ مَالِكٍ  عَنْ  أَبِي أُسَيْدٍ  594  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ حَاتِمٍ الْمُؤَدِّبُ ،  ثَنَا  عَلِيُّ بْنُ ثَابِتٍ الْجَزَرِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ جَعْفَرٍ ،  حَدَّثَنِي  يَزِيدُ بْنُ أَبِي حَبِيبٍ الْمِصْرِيُّ ،  عَنْ  عِرَاكِ بْنِ مَالِكٍ ،  عَنْ  أَبِي أُسَيْدٍ الْأَنْصَارِيِّ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ يُجْمَعَ بَيْنَ التَّمْرِ وَالزَّبِيبِ  .","","Al-Mu'jam al-Kabir 594","","أبو أسيد بن ثابت الزرقي عن عراك بن مالك الغفاري عن يزيد بن أبي حبيب الأزدي عن عبد الحميد بن جعفر الأوسي عن علي بن ثابت الجزري عن محمد بن حاتم الخراساني عن عبيد العجل عن الطبراني","عراك بن مالك عن أبي أسيد"
"17675","أَبُو الزُّبَيْرِ الْمَكِّيُّ مُحَمَّدُ بْنُ مُسْلِمٍ  عَنْ  أَبِي أُسَيْدٍ  595  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَتِيقُ بْنُ يَعْقُوبَ الزُّبَيْرِيُّ ،         [19/269]      ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ طَهْمَانَ ،  عَنْ  أَبِي الزُّبَيْرِ الْمَكِّيِّ قَالَ :  سَمِعْتُ  أَبَا أُسَيْدٍ السَّاعِدِيَّ  وَابْنُ عَبَّاسٍ  يُفْتِي بِالدِّينَارِ بِالدِّينَارَيْنِ ، فَقَالَ  أَبُو أُسَيْدٍ  وَأَغْلَظَ لَهُ الْقَوْلَ ، فَقَالَ  ابْنُ عَبَّاسٍ  : مَا كُنْتُ أَظُنُّ أَنَّ أَحَدًا يَعْرِفُ قَرَابَتِي مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ لِي مِثْلَ هَذَا يَا  أَبَا أُسَيْدٍ ،  فَقَالَ  أَبُو أُسَيْدٍ  : أَشْهَدُ لَسَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الدِّينَارُ بِالدِّينَارِ ، وَالدِّرْهَمُ بِالدِّرْهَمِ  ، وَصَاعُ حِنْطَةٍ بِصَاعِ حِنْطَةٍ ، وَصَاعُ شَعِيرٍ بِصَاعِ شَعِيرٍ ، وَصَاعُ مِلْحٍ بِصَاعِ مِلْحٍ ، لَا فَضْلَ بَيْنَ شَيْءٍ مِنْ ذَلِكَ . فَقَالَ  ابْنُ عَبَّاسٍ  : هَذَا شَيْءٌ كُنْتُ أَقُولُهُ بِرَأْيِي وَلَمْ أَسْمَعْ فِيهِ شَيْئًا  .","","Al-Mu'jam al-Kabir 595","","مالك بن ربيعة أبو أسيد الساعدي عن أبو الزبير المكي عن إبراهيم بن طهمان عن عبد العزيز بن محمد الدراوردي عن عتيق بن يعقوب الزبيري عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو الزبير المكي محمد بن مسلم عن أبي أسيد"
"17676","596  -  عَطَاءٌ الشَّامِيُّ  عَنْ  أَبِي أُسَيْدٍ  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى الْحُلْوَانِيُّ ،  ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ ،  عَنْ  زُهَيْرِ بْنِ مُعَاوِيَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عِيسَى ،  عَنْ  عَطَاءٍ - لَيْسَ بِابْنِ أَبِي رَبَاحٍ -  عَنْ  أَبِي أُسَيْدٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُوا الزَّيْتَ وَادَّهِنُوا بِالزَّيْتِ ، فَإِنَّهُ شَجَرَةٌ مُبَارَكَةٌ  .","","Al-Mu'jam al-Kabir 596","","أبو أسيد بن ثابت الزرقي عن عطاء الشامي عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن زهير بن معاوية بن حديج عن سعيد بن سليمان سعدويه عن أحمد بن يحيى بن إسحاق الحلواني عن الطبراني","عطاء الشامي عن أبي أسيد"
"17677","597  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا         [19/270]      وَكِيعٌ ،  عَنْ  سُفْيَانَ ،  عَنْ  عَبْدِ اللهِ بْنِ عِيسَى ،  عَنْ  عَطَاءٍ الشَّامِيِّ ،  عَنْ  أَبِي أُسَيْدٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  كُلُوا الزَّيْتَ وَادَّهِنُوا بِهِ ، فَإِنَّهُ مِنْ شَجَرَةٍ مُبَارَكَةٍ  .","","Al-Mu'jam al-Kabir 597","","أبو أسيد بن ثابت الزرقي عن عطاء الشامي عن عبد الله بن عيسى بن عبد الرحمن بن أبي ليلى عن سفيان الثوري عن وكيع بن الجراح عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","عطاء الشامي عن أبي أسيد"
"17678","مَالِكُ بْنُ صَعْصَعَةَ الْأَنْصَارِيُّ  598  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ وَمُوسَى بْنُ هَارُونَ قَالَا :  ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  هَمَّامُ بْنُ يَحْيَى ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  مَالِكِ بْنِ صَعْصَعَةَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَدَّثَنِي عَنْ لَيْلَةِ أُسْرِيَ بِهِ  .","","Al-Mu'jam al-Kabir 598","","مالك بن صعصعة الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن همام بن يحيى بن دينار عن هدبة بن خالد عن موسى بن هارون الحمال عن الطبراني","مالك بن صعصعة الأنصاري"
"17679","599  -  حَدَّثَنَا  عَلِيُّ بْنُ أَحْمَدَ الْأَبَّارُ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ         [19/271]      الْعَيْشِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  مَالِكِ بْنِ صَعْصَعَةَ ، عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ  ، ثَنَا  الْعَبَّاسُ بْنُ الْوَلِيدِ النَّرْسِيُّ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  مَالِكِ بْنِ صَعْصَعَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ (  ح  ) .  وَحَدَّثَنَا  عَبْدُ الْعَزِيزِ الْحَرْمَلِيُّ  ، أَنَا  يَعْقُوبُ بْنُ كَعْبٍ ،  ثَنَا  أَبِي  ،  عَنِ  الْخَلِيلِ بْنِ مُرَّةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  مَالِكِ بْنِ صَعْصَعَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  أَبُو حَفْصٍ عَمْرُو بْنُ عَلِيٍّ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  هِشَامٌ الدَّسْتُوَائِيُّ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَنَسٍ ،  عَنْ  مَالِكِ بْنِ صَعْصَعَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  بَيْنَا أَنَا  فِي  الْحَطِيمِ  - وَرُبَّمَا قَالَ : فِي  الْحِجْرِ  - بَيْنَ النَّائِمِ وَالْيَقْظَانِ ، إِذْ أَتَانِي آتٍ فَشُقَّ مِنَ النَّحْرِ إِلَى  مَرَاقِّ  الْبَطْنِ فَاسْتَخْرَجَ قَلْبِي  ، ثُمَّ أُتِيتُ بِطَسْتٍ مِنْ ذَهَبٍ فَغُسِلَ بِمَاءِ زَمْزَمَ وَمُلِئَ حِكْمَةً وَإِيمَانًا ، وَأُتِيتُ بِدَابَّةٍ دُونَ الْبَغْلِ وَفَوْقَ الْحِمَارِ أَبْيَضَ يُقَالُ لَهُ الْبُرَاقُ ، يَقَعُ خَطْوُهُ عِنْدَ أَقْصَى طَرْفِهِ فَحُمِلْتُ عَلَيْهِ ، فَانْطَلَقْتُ أَنَا  وَجِبْرِيلُ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى أَتَيْنَا سَمَاءَ الدُّنْيَا ، فَاسْتَفْتَحَ  جِبْرِيلُ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقِيلَ : مَنْ مَعَكَ ؟ فَقَالَ :  مُحَمَّدٌ  ، قِيلَ : وَقَدْ أُرْسِلَ إِلَيْهِ ؟ قَالَ : نَعَمْ ، قَالُوا : مَرْحَبًا ، وَلَنِعْمَ الْمَجِيءُ مَا جَاءَ ، فَفُتِحَ لَنَا فَدَخَلْنَا ، فَأَتَيْتُ عَلَى  آدَمَ  فَسَلَّمْتُ عَلَيْهِ ، فَقَالَ : مَرْحَبًا بِكَ مِنِ ابْنٍ وَنَبِيٍّ ، ثُمَّ أَتَيْنَا السَّمَاءَ الثَّانِيَةَ فَاسْتَفْتَحَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقِيلَ : مَنْ مَعَكَ ؟ فَقَالَ :  مُحَمَّدٌ  ، قِيلَ : قَدْ أُرْسِلَ إِلَيْهِ ؟ قَالَ : نَعَمْ ، قَالُوا : مَرْحَبًا بِهِ ، وَلَنِعْمَ الْمَجِيءُ جَاءَ ، فَفُتِحَ لَنَا فَأَتَيْتُ عَلَى  عِيسَى  وَيَحْيَى  فَسَلَّمْتُ عَلَيْهِمَا ، فَقَالَا : مَرْحَبًا بِكَ مِنْ أَخٍ وَنَبِيٍّ ، ثُمَّ أَتَيْنَا         [19/272]      السَّمَاءَ الثَّالِثَةَ ، فَاسْتَفْتَحَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقِيلَ : مَنْ مَعَكَ ؟ قَالَ :  مُحَمَّدٌ  ، قَالُوا : وَقَدْ أُرْسِلَ إِلَيْهِ ؟ قَالَ : نَعَمْ ، قَالُوا : مَرْحَبًا بِهِ ، وَلَنِعْمَ الْمَجِيءُ جَاءَ ، فَأَتَيْتُ عَلَى  يُوسُفَ  فَسَلَّمْتُ عَلَيْهِ ، فَقَالَ : مَرْحَبًا بِكَ مِنْ أَخٍ وَنَبِيٍّ ، ثُمَّ أَتَيْنَا السَّمَاءَ الرَّابِعَةَ ، فَاسْتَفْتَحَ  جِبْرِيلُ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقِيلَ : مَنْ مَعَكَ ؟ قَالَ :  مُحَمَّدٌ  ، قَالُوا : وَقَدْ أُرْسِلَ إِلَيْهِ ؟ قَالَ : نَعَمْ ، قَالُوا : مَرْحَبًا بِهِ ، وَلَنِعْمَ الْمَجِيءُ جَاءَ ، قَالَ : فَأَتَيْتُ عَلَى  إِدْرِيسَ  فَسَلَّمْتُ عَلَيْهِ ، فَقَالَ : مَرْحَبًا بِكَ مِنْ أَخٍ وَنَبِيٍّ ، ثُمَّ أَتَيْنَا السَّمَاءَ الْخَامِسَةَ فَاسْتَفْتَحَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقِيلَ : مَنْ مَعَكَ ؟ قَالَ :  مُحَمَّدٌ  ، قَالُوا : وَقَدْ أُرْسِلَ إِلَيْهِ ؟ قَالَ : نَعَمْ ، قَالُوا : مَرْحَبًا بِهِ ، وَلَنِعْمَ الْمَجِيءُ جَاءَ ، فَأَتَيْتُ عَلَى  هَارُونَ  فَسَلَّمْتُ عَلَيْهِ ، فَقَالَ : مَرْحَبًا بِكَ مِنْ أَخٍ وَنَبِيٍّ ، ثُمَّ أَتَيْنَا السَّمَاءَ السَّادِسَةَ فَاسْتَفْتَحَ  جِبْرِيلُ  عَلَيْهِ السَّلَامُ ، فَقِيلَ : مَنْ مَعَكَ ؟ قَالَ :  مُحَمَّدٌ  ، قَالُوا : وَقَدْ أُرْسِلَ إِلَيْهِ ؟ قَالَ : نَعَمْ ، قَالُوا : مَرْحَبًا بِهِ ، وَلَنِعْمَ الْمَجِيءُ جَاءَ ، فَأَتَيْتُ عَلَى  مُوسَى  فَسَلَّمْتُ عَلَيْهِ فَقَالَ : مَرْحَبًا بِكَ مِنْ أَخٍ وَنَبِيٍّ ، فَلَمَّا جَاوَزْتُهُ بَكَى ، فَقِيلَ : مَا يُبْكِيكَ ؟ فَقَالَ : يَا رَبِّ ، هَذَا بُعِثَ بَعْدِي يَدْخُلُ مِنْ أُمَّتِهِ الْجَنَّةَ أَكْثَرُ مِمَّا يَدْخُلُ مِنْ أُمَّتِي ! ثُمَّ أَتَيْنَا السَّمَاءَ السَّابِعَةَ فَاسْتَفْتَحَ  جِبْرِيلُ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالُوا : مَنْ مَعَكَ ؟ قَالَ :  مُحَمَّدٌ  ، قَالُوا : أَوَقَدْ أُرْسِلَ إِلَيْهِ ؟ قَالَ : نَعَمْ ، قَالُوا : مَرْحَبًا بِهِ ، وَلَنِعْمَ الْمَجِيءُ جَاءَ ، فَأَتَيْتُ عَلَى  إِبْرَاهِيمَ  فَسَلَّمْتُ عَلَيْهِ ، فَقَالَ : مَرْحَبًا بِكَ مِنِ ابْنٍ وَنَبِيٍّ ، ثُمَّ رُفِعَتْ لَنَا  سِدْرَةُ  الْمُنْتَهَى ،  فَسَأَلْتُ  جِبْرِيلَ  عَلَيْهِ السَّلَامُ فَقَالَ : هَذِهِ  سِدْرَةُ  الْمُنْتَهَى ،  وَإِذَا  نَبْقُهَا  كَالْقِلَالِ  ، وَإِذَا وَرَقُهَا كَأُذُنِ الْفِيَلَةِ ، وَرَأَيْتُ فِي أَصْلِهَا أَرْبَعَةَ أَنْهَارٍ نَهَرَانِ ظَاهِرَانِ وَنَهَرَانِ بَاطِنَانِ ، فَسَأَلْتُ  جِبْرِيلَ  - عَلَيْهِ السَّلَامُ - فَقَالَ : أَمَّا الْبَاطِنَانِ فَنَهَرَانِ فِي الْجَنَّةِ ، وَأَمَّا الظَّاهِرَانِ  فَالنِّيلُ  وَالْفُرَاتُ  ، ثُمَّ رُفِعَ لَنَا الْبَيْتُ الْمَعْمُورُ ، فَسَأَلْتُ  جِبْرِيلَ  عَلَيْهِ السَّلَامُ فَقَالَ :         [19/273]      هَذَا الْبَيْتُ الْمَعْمُورُ ، يَدْخُلُهُ كُلَّ يَوْمٍ سَبْعُونَ أَلْفَ مَلَكٍ ثُمَّ لَا يَعُودُونَ إِلَيْهِ آخِرَ مَا عَلَيْهِمْ ، وَفُرِضَتْ عَلَيَّ خَمْسُونَ صَلَاةً ، فَانْطَلَقْتُ حَتَّى أَتَيْتُ عَلَى  مُوسَى  - عَلَيْهِ السَّلَامُ - فَقَالَ : مَا صَنَعْتَ ؟ فَقُلْتُ : فُرِضَتْ عَلَيَّ خَمْسُونَ صَلَاةً . قَالَ : إِنِّي أَعْلَمُ بِالنَّاسِ مِنْكَ ، فَقَدْ  عَالَجْتُ  بَنِي إِسْرَائِيلَ  أَشَدَّ الْمُعَالَجَةِ ، وَإِنَّ أُمَّتَكَ لَنْ تُطِيقَ ذَلِكَ ، فَارْجِعْ إِلَى رَبِّكَ فَاسْأَلْهُ أَنْ يُخَفِّفَ عَنْكَ ، فَرَجَعْتُ فَسَأَلْتُهُ أَنْ يُخَفِّفَ عَنِّي فَجَعَلَهَا أَرْبَعِينَ صَلَاةً ، فَأَتَيْتُ عَلَى  مُوسَى  عَلَيْهِ السَّلَامُ فَقَالَ : مَا صَنَعْتَ ؟ قُلْتُ : جَعَلَهَا أَرْبَعِينَ . قَالَ : إِنِّي أَعْلَمُ بِالنَّاسِ مِنْكَ ، وَقَدْ  عَالَجْتُ  بَنِي إِسْرَائِيلَ  أَشَدَّ الْمُعَالَجَةِ ، وَإِنَّ أُمَّتَكَ لَنْ تُطِيقَ ذَلِكَ ، فَارْجِعْ إِلَى رَبِّكَ فَسَلْهُ أَنْ يُخَفِّفَ عَنْكَ . فَرَجَعْتُ ، فَسَأَلْتُ رَبِّي فَخَفَّفَ عَنِّي عَشْرًا ، فَأَتَيْتُ عَلَى  مُوسَى  فَقَالَ : مَا صَنَعْتَ ؟ فَقُلْتُ : جَعَلَهَا ثَلَاثِينَ . قَالَ : إِنِّي أَعْلَمُ بِالنَّاسِ مِنْكَ ، وَقَدْ  عَالَجْتُ  بَنِي إِسْرَائِيلَ  أَشَدَّ الْمُعَالَجَةِ ، وَإِنَّ أُمَّتَكَ لَنْ تُطِيقَ ذَلِكَ ، فَارْجِعْ إِلَى رَبِّكَ فَسَلْهُ أَنْ يُخَفِّفَ عَنْكَ . فَرَجَعْتُ فَسَأَلْتُهُ أَنْ يُخَفِّفَهَا عَنِّي فَجَعَلَهَا عِشْرِينَ ، فَأَتَيْتُ عَلَى  مُوسَى  فَقَالَ : مَا صَنَعْتَ ؟ فَقُلْتُ : جَعَلَهَا عِشْرِينَ . قَالَ : إِنِّي أَعْلَمُ بِالنَّاسِ مِنْكَ ، وَقَدْ  عَالَجْتُ  بَنِي إِسْرَائِيلَ  أَشَدَّ الْمُعَالَجَةِ ، وَإِنَّ أُمَّتَكَ لَنْ تُطِيقَ ذَلِكَ ، فَارْجِعْ إِلَى رَبِّكَ فَسَلْهُ أَنْ يُخَفِّفَ عَنْكَ . فَرَجَعْتُ إِلَى رَبِّي فَسَأَلْتُهُ أَنْ يُخَفِّفَ عَنِّي فَجَعَلَهَا خَمْسَ عَشْرَةَ ، فَأَتَيْتُ عَلَى  مُوسَى  فَقَالَ : مَا صَنَعْتَ ؟ قُلْتُ : جَعَلَهَا خَمْسَ عَشْرَةَ . قَالَ : إِنِّي أَعْلَمُ بِالنَّاسِ مِنْكَ ، وَقَدْ  عَالَجْتُ  بَنِي إِسْرَائِيلَ  أَشَدَّ الْمُعَالَجَةِ ، وَإِنَّ أُمَّتَكَ لَنْ تُطِيقَ ذَلِكَ ، فَارْجِعْ إِلَى رَبِّكَ فَسَلْهُ أَنْ يُخَفِّفَ عَنْكَ ، فَرَجَعْتُ إِلَى رَبِّي فَسَأَلْتُهُ أَنْ يُخَفِّفَ عَنِّي فَجَعَلَهَا عَشْرًا ، فَأَتَيْتُ عَلَى  مُوسَى  فَقَالَ : مَا صَنَعْتَ ؟ قُلْتُ : جَعَلَهَا عَشْرًا . قَالَ : إِنِّي أَعْلَمُ بِالنَّاسِ مِنْكَ ، وَقَدْ  عَالَجْتُ  بَنِي إِسْرَائِيلَ  أَشَدَّ الْمُعَالَجَةِ ، وَإِنَّ أُمَّتَكَ لَنْ تُطِيقَ ذَلِكَ ، فَارْجِعْ إِلَى رَبِّكَ فَسَلْهُ أَنْ يُخَفِّفَ عَنْكَ . فَرَجَعْتُ إِلَى رَبِّي         [19/274]      فَسَأَلْتُهُ أَنْ يُخَفِّفَ عَنِّي فَوَضَعَ عَنِّي خَمْسًا ، فَأَتَيْتُ عَلَى  مُوسَى  فَقَالَ : مَا صَنَعْتَ ؟ فَقُلْتُ : حَطَّ عَنِّي خَمْسًا . قَالَ : إِنِّي أَعْلَمُ بِالنَّاسِ مِنْكَ ، وَقَدْ  عَالَجْتُ  بَنِي إِسْرَائِيلَ  أَشَدَّ الْمُعَالَجَةِ ، وَإِنَّ أُمَّتَكَ لَنْ تُطِيقَ ذَلِكَ ، فَارْجِعْ إِلَى رَبِّكَ فَسَلْهُ أَنْ يُخَفِّفَ عَنْكَ . قُلْتُ : قَدِ اسْتَحْيَيْتُ كَمْ أَرْجِعُ إِلَى رَبِّي ، قَدْ رَضِيتُ وَسَلَّمْتُ ! فَنُودِيَ : إِنِّي قَدْ أَمْضَيْتُ فَرِيضَتِي وَخَفَّفْتُ عَنْ عِبَادِي ، وَأَجْزِي بِالْحَسَنَةِ عَشْرَ أَمْثَالِهَا  .","","Al-Mu'jam al-Kabir 599","","مالك بن صعصعة الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن هشام الدستوائي عن أبو داود الطيالسي عن الفلاس عن محمد بن صالح النرسي عن الطبراني","مالك بن صعصعة الأنصاري"
"17680","600  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  عَبْدُ الْقُدُّوسِ بْنُ مُحَمَّدٍ الْعَطَّارُ ،  ثَنَا  عَمْرُو بْنُ عَاصِمٍ الْكِلَابِيُّ ،  ثَنَا  هَمَّامٌ ،  ثَنَا  قَتَادَةُ ،  عَنْ  أَنَسٍ ،  عَنْ  مَالِكِ بْنِ صَعْصَعَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَيْلَةَ أُسْرِيَ بِي مَا مَرَرْتُ عَلَى مَلَكٍ مِنَ الْمَلَائِكَةِ إِلَّا أَمَرُونِي بِالْحَجْمِ  .","","Al-Mu'jam al-Kabir 600","","مالك بن صعصعة الأنصاري عن أنس بن مالك عن قتادة بن دعامة عن همام بن يحيى بن دينار عن عمرو بن عاصم الكلابي عن عبد القدوس بن محمد الحبحابي عن أحمد بن يحيى بن زهير التستري عن الطبراني","مالك بن صعصعة الأنصاري"
"17681","مَالِكُ بْنُ رَبِيعَةَ ، أَبُو مَرْيَمَ السَّلُولِيُّ  601  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  يَزِيدَ بْنِ أَبِي مَرْيَمَ  ،  عَنْ  أَبِيهِ  قَالَ :  كُنَّا مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي سَفَرٍ ، فَنَزَلْنَا مَنْزِلًا فَنَامُوا عَنِ الصَّلَاةِ حَتَّى طَلَعَتِ الشَّمْسُ ، فَقَامَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَمَرَ  بِلَالًا  فَأَذَّنَ ، وَتَوَضَّئُوا وَصَلَّوْا رَكْعَتَيْنِ ،  ثُمَّ أَقَامَ  بِلَالٌ  فَصَلَّى بِنَا النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ثُمَّ حَدَّثَنَا بِمَا هُوَ كَائِنٌ إِلَى يَوْمِ الْقِيَامَةِ ، حَفِظَهُ مَنْ حَفِظَهُ وَنَسِيَهُ مَنْ نَسِيَهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب: (بريد بن أبي مريم) ، كما في مصادر التخريج.","","Al-Mu'jam al-Kabir 601","","مالك بن ربيعة السلولي عن بريد بن أبي مريم السلولي عن عطاء بن السائب عن سلام بن سليم الحنفي عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","مالك بن ربيعة أبو مريم السلولي"
"17682","[19/275]      602  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ - قَالَا :  ثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  يَزِيدَ بْنِ أَبِي مَرْيَمَ  ،  عَنْ  أَبِيهِ  قَالَ :  نَامَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي وَجْهِ الصُّبْحِ فَلَمْ يَسْتَيْقِظْ حَتَّى طَلَعَتِ الشَّمْسُ ،  فَاسْتَيْقَظَ فَأَمَرَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِلَالًا  فَأَذَّنَ ثُمَّ صَلَّى رَكْعَتَيْنِ ، ثُمَّ أَمَرَ فَصَلَّى الْفَجْرَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب: (بريد بن أبي مريم) ، كما في مصادر التخريج.","","Al-Mu'jam al-Kabir 602","","مالك بن ربيعة السلولي عن بريد بن أبي مريم السلولي عن عطاء بن السائب عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","مالك بن ربيعة أبو مريم السلولي"
"17683","603  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُثْمَانُ بْنُ أَبِي شَيْبَةَ - قَالَا :  ثَنَا  جَرِيرٌ ،  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  يَزِيدَ بْنِ أَبِي مَرْيَمَ  ،  عَنْ  أَبِيهِ  قَالَ :  قَامَ فِينَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَقَامًا ، ثُمَّ حَدَّثَنَا بِمَا هُوَ كَائِنٌ إِلَى أَنْ تَقُومَ السَّاعَةُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب: (بريد بن أبي مريم) ، كما في مصادر التخريج.","","Al-Mu'jam al-Kabir 603","","مالك بن ربيعة السلولي عن بريد بن أبي مريم السلولي عن عطاء بن السائب عن جرير بن عبد الحميد عن عثمان ابن أبي شيبة عن الحسين بن إسحاق التستري عن الطبراني","مالك بن ربيعة أبو مريم السلولي"
"17684","604  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو غَسَّانَ مَالِكُ بْنُ إِسْمَاعِيلَ ،  ثَنَا  حِبَّانُ بْنُ يَسَارٍ الْكِلَابِيُّ ،  ثَنَا  يَزِيدُ بْنُ أَبِي مَرْيَمَ  أَنَّهُ سَمِعَ  أَبَاهُ أَبَا مَرْيَمَ  يَذْكُرُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ فِي خُطْبَةٍ لَهُ :  اللَّهُمَّ اغْفِرْ  لِلْمُحَلِّقِينَ  . قَالَ : يَقُولُ لَهُ  رَجُلٌ  : يَا رَسُولَ اللهِ وَالْمُقَصِّرِينَ ! ثَلَاثَ مَرَّاتٍ  ، قَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : وَالْمُقَصِّرِينَ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب: (بريد بن أبي مريم) ، كما في مصادر التخريج.","","Al-Mu'jam al-Kabir 604","","مالك بن ربيعة السلولي عن بريد بن أبي مريم السلولي عن حبان بن يسار الكلابي عن مالك بن إسماعيل النهدي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مالك بن ربيعة أبو مريم السلولي"
"17685","605  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  رَجَاءُ بْنُ مُحَمَّدٍ الْعُذْرِيُّ (  ح  ) .         [19/276]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ مُكْرَمٍ  ، ثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ السَّكَنِ - قَالَا :  ثَنَا  إِسْحَاقُ بْنُ إِدْرِيسَ ،  حَدَّثَنِي  يَحْيَى بْنُ يَزِيدَ بْنِ مَالِكِ بْنِ رَبِيعَةَ السَّلُولِيُّ ،  ثَنَا  يَزِيدُ بْنُ مَالِكٍ ،  عَنْ  أَبِيهِ  أَنَّهُ شَهِدَ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الشَّجَرَةِ وَيَوْمَ الْهَدْيِ مَعْكُوفًا قَبْلَ أَنْ يَبْلُغَ مَحِلَّهُ ، وَأَنَّ  رَجُلًا مِنَ الْمُشْرِكِينَ  قَالَ : يَا  مُحَمَّدُ ،  مَا يَحْمِلُكَ عَلَى أَنْ تُدْخِلَ هَؤُلَاءِ عَلَيْنَا وَنَحْنُ كَارِهُونَ ؟ فَقَالَ :  هَؤُلَاءِ خَيْرٌ مِنْكَ وَمِنْ أَجْدَادِكَ  ؛ يُؤْمِنُونَ بِاللهِ وَالْيَوْمِ الْآخِرِ ، وَالَّذِي نَفْسِي بِيَدِهِ لَقَدْ رَضِيَ اللهُ عَنْهُمْ  .","","Al-Mu'jam al-Kabir 605","","مالك بن ربيعة السلولي عن بريد بن أبي مريم السلولي عن يحيى بن بريد بن مالك بن ربيعة السلولي عن إسحاق بن إدريس الأسواري عن يحيى بن محمد بن السكن البزاز عن محمد بن الحسين بن مكرم البارع عن الطبراني","مالك بن ربيعة أبو مريم السلولي"
"17686","مَالِكُ بْنُ نَضْلَةَ الْجُشَمِيُّ  606  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَمُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ قَالَا :  ثَنَا  أَحْمَدُ بْنُ يُونُسَ ،  ثَنَا  سُفْيَانُ الثَّوْرِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  قَالَ :  قُلْتُ : يَا رَسُولَ اللهِ ، مَرَرْتُ  بِرَجُلٍ  فَلَمْ يَضِفْنِي وَلَمْ يَقْرِنِي ، فَمَرَّ بِي ، فَأَقْرِيهِ ؟ قَالَ : بَلِ اقْرِهِ  .","","Al-Mu'jam al-Kabir 606","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سفيان الثوري عن أحمد بن عبد الله اليربوعي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مالك بن نضلة الجشمي"
"17687","607  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  قَالَ :  رَأَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَيَّ أَطْمَارًا ، فَقَالَ : هَلْ لَكَ مِنْ مَالٍ ؟ قُلْتُ : نَعَمْ ، قَالَ : مِنْ أَيِّ الْمَالِ ؟ قُلْتُ : مِنْ كُلٍّ قَدْ آتَانِي اللهُ . قَالَ :  فَلْتُرَ نِعْمَةُ اللهِ وَكَرَامَتُهُ عَلَيْكَ  .","","Al-Mu'jam al-Kabir 607","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","مالك بن نضلة الجشمي"
"17688","[19/277]      608  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى وَأَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ وَعُثْمَانُ بْنُ عُمَرَ الضَّبِّيُّ ، قَالُوا :  ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا  قَشِفُ  الْهَيْئَةِ ، فَقَالَ : هَلْ لَكَ مِنْ مَالٍ ؟ فَقُلْتُ : نَعَمْ ، فَقَالَ : مِنْ أَيِّ الْمَالِ ؟ فَقُلْتُ : مِنْ كُلٍّ قَدْ آتَانِي اللهُ ؛ مِنَ الْإِبِلِ وَالْخَيْلِ وَالرَّقِيقِ وَالْغَنَمِ . قَالَ :  إِذَا آتَاكَ اللهُ عَزَّ وَجَلَّ مَالًا فَلْيُرَ عَلَيْكَ  .  وَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : هَلْ  تُنْتَجُ  إِبِلُ قَوْمِكَ صِحَاحًا آذَانُهَا فَتَعْمِدُ إِلَى الْمُوسَى فَتَقْطَعُ آذَانَهَا فَتَقُولُ هَذِهِ  بُحُرٌ  ، وَتَشُقُّ جُلُودَهَا فَتَقُولُ هَذِهِ  صُرُمٌ  ، فَتُحَرِّمُهَا عَلَيْكَ وَعَلَى أَهْلِكَ ؟ قُلْتُ : نَعَمْ ، قَالَ : فَكُلُّ مَا آتَاكَ اللهُ - عَزَّ وَجَلَّ - لَكَ حِلٌّ ، وَسَاعِدُ اللهِ أَشَدُّ مِنْ سَاعِدِكَ ، وَمُوسَى اللهِ أَحَدُّ مِنْ مُوسَاكَ .  قُلْتُ : يَا رَسُولَ اللهِ ، أَرَأَيْتَ رَجُلًا نَزَلْتُ بِهِ فَلَمْ يُكْرِمْنِي وَلَمْ يَقْرِنِي فَنَزَلَ بِي ، أَجْزِهِ بِمَا صَنَعَ ؟ قَالَ : لَا ، بَلِ اقْرِهِ  .","","Al-Mu'jam al-Kabir 608","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن أبو الوليد الطيالسي عن عثمان بن عمر الضبي عن الطبراني","مالك بن نضلة الجشمي"
"17689","609  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  إِسْرَائِيلُ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَبْدُ اللهِ بْنُ رَجَاءٍ ،  أَنَا  إِسْرَائِيلُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَآنِي سَيِّئَ الْهَيْئَةِ ، فَقَالَ لِي : هَلْ عِنْدَكَ مَالٌ ؟ قُلْتُ : نَعَمْ ، مِنْ كُلِّ الْمَالِ قَدْ آتَانِي اللهُ ؛ مِنَ الْإِبِلِ وَالْبَقَرِ وَالْخَيْلِ وَالرَّقِيقِ . قَالَ :  فَإِذَا آتَاكَ اللهُ خَيْرًا فَلْيُرَ عَلَيْكَ نِعْمَةُ اللهِ وَكَرَامَتُهُ عَلَيْكَ  . قُلْتُ : يَا  مُحَمَّدُ  - وَلَمْ أَكُنْ أَسْلَمْتُ يَوْمَئِذٍ - أَرَأَيْتَ إِنْ نَزَلْتُ بِرَجُلٍ فَلَمْ يَقْرِنِي وَلَمْ يَرَ لِي حَقًّا ، ثُمَّ         [19/278]      أَصَابَهُ الدَّهْرُ ثُمَّ نَزَلَ بِي ، أَفَأُجْزِيهِ بِمَا فَعَلَ أَوْ أَقْرِيهِ ؟ قَالَ : لَا ، بَلِ اقْرِهِ .  ثُمَّ قَالَ لِي : هَلْ  تُنْتَجُ  إِبِلُكَ وَافِرَةً آذَانُهَا ؟ قُلْتُ : وَهَلْ  تُنْتَجُ  الْإِبِلُ إِلَّا كَذَلِكَ ؟ قَالَ : فَتَأْخُذُ الْمُوسَى فَتَقْطَعُ آذَانَهَا فَتَقُولُ هَذِهِ  بُحُرٌ  ؟ وَتَأْخُذُ مُوسَاكَ وَتَشُقُّ آذَانَهَا وَتَقُولُ هَذِهِ  صُرُمٌ  ؟ قُلْتُ : إِنَّا لَنَفْعَلُ ذَاكَ ! قَالَ : فَلَا تَفْعَلْ ، كُلُّ مَا آتَاكَ اللهُ حِلٌّ ، وَمُوسَى اللهِ أَحَدُّ مِنْ مُوسَاكَ ، وَسَاعِدُ اللهِ أَشَدُّ مِنْ سَاعِدِكَ . قَالَ : وَكَانَتْ أَفْضَلَ الْعَرَبِ لِذَلِكَ  قَيْسٌ  .  وَاللَّفْظُ لِحَدِيثِ  ابْنِ رَجَاءٍ  .","","Al-Mu'jam al-Kabir 609","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن إسرائيل بن يونس بن أبي إسحاق عن عبد الله بن رجاء الغداني عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مالك بن نضلة الجشمي"
"17690","610  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  زُهَيْرٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ثَوْبٍ دُونٍ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَلَكَ مَالٌ ؟ قَالَ : نَعَمْ ، قَدْ آتَانِي اللهُ مِنْ كُلِّ الْمَالِ . قَالَ : مِنْ أَيِّ الْمَالِ ؟ قَالَ : آتَانِي اللهُ مِنَ الْخَيْلِ وَالرَّقِيقِ . فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا آتَاكَ اللهُ مَالًا فَلْيُرَ عَلَيْكَ أَثَرُ نِعْمَتِهِ وَكَرَامَتِهِ  . ثُمَّ قَالَ :  أَتُنْتِجُ  إِبِلُكَ  وَافِيَةَ  الْآذَانِ ؟ قَالَ : وَهَلْ  تُنْتَجُ  إِلَّا كَذَلِكَ ؟ قَالَ : فَإِنَّكَ تَعْمِدُ إِلَى مُوسَاكَ فَتَقْطَعُ أَطْرَافَ الْآذَانِ فَتَقُولُ هَذِهِ  بُحُرٌ  ؟ وَتَشُقُّ طَائِفَةً فَتَقُولُ هَذِهِ  صُرُمٌ  ؟ فَقَالَ : إِنِّي لَأَفْعَلُ ذَلِكَ ! قَالَ : لَا تَفْعَلْ ، فَإِنَّ كُلَّ مَا آتَاكَ اللهُ لَكَ حِلٌّ . ثُمَّ قَالَ لِلنَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَلَمْ يَكُنْ أَسْلَمَ : أَيَا  مُحَمَّدُ ،  أَرَأَيْتَ إِنْ نَزَلْتُ بِرَجُلٍ فَلَمْ يُضِفْنِي وَلَمْ يَعْرِفْ حَقِّي ، ثُمَّ أَضَافَهُ الدَّهْرُ إِلَيَّ ، أَقْرِيهِ أَمْ أَجْزِيهِ ؟ قَالَ : بَلِ اقْرِهِ  .","","Al-Mu'jam al-Kabir 610","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","مالك بن نضلة الجشمي"
"17691","[19/279]      611  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ مُوسَى السُّدِّيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَيَّ  بُرْدَتَانِ أَوْ شَمْلَانِ  ، فَقَالَ :  هَلْ لَكَ مِنْ مَالٍ ؟ قُلْتُ : نَعَمْ ، مِنْ كُلِّ الْمَالِ . قَالَ : فَلْيُرَ عَلَيْكَ نِعْمَةُ اللهِ  ! فَغَدَوْتُ عَلَيْهِ فِي  حُلَّةٍ  حَمْرَاءَ  .","","Al-Mu'jam al-Kabir 611","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن شريك بن عبد الله النخعي عن إسماعيل بن موسى الفزاري عن محمد بن عبد الله مطين الحضرمي عن الطبراني","مالك بن نضلة الجشمي"
"17692","612  -  حَدَّثَنَا  مُحَمَّدُ بْنُ شُعَيْبٍ الْأَصْبَهَانِيُّ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلَمَةَ الرَّازِيُّ ،  ثَنَا  أَبُو زُهَيْرٍ عَبْدُ الرَّحْمَنِ بْنُ مَغْرَاءَ ،  عَنِ  الْأَجْلَحِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَيْهِ ثِيَابٌ رَدِيئَةٌ وَهُوَ سَيِّئُ الْهَيْئَةِ ، فَقَالَ لَهُ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَلْ لَكَ مِنْ مَالٍ ؟ قَالَ : نَعَمْ ، مِنْ أَنْوَاعِ الْمَالِ كُلِّهِ .  قَالَ : فَلْيُرَ عَلَيْكَ مَا رَزَقَكَ اللهُ  .","","Al-Mu'jam al-Kabir 612","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن أجلح بن عبد الله الكندي عن عبد الرحمن بن مغراء الدوسي عن عبد الرحمن بن سلمة الأزداني عن محمد بن شعيب التاجر عن الطبراني","مالك بن نضلة الجشمي"
"17693","613  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  أَبُو الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ  قَالَ  :  دَخَلَ  أَبِي  عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي ثِيَابٍ  أَسْمَالٍ  ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : هَلْ لَكَ مِنْ مَالٍ ؟ قَالَ : مِنْ كُلِّ الْمَالِ قَدْ آتَانِي اللهُ ؛ مِنَ الْإِبِلِ وَالْبَقَرِ وَالْغَنَمِ . قَالَ :  فَلْيُرَ عَلَيْكَ مَا آتَاكَ اللهُ  . قَالَ : يَا رَسُولَ اللهِ ،  رَجُلٌ  مَرَرْتُ بِهِ فَأَبَى أَنْ يَقْرِيَنِي ، فَأَلْجَأَهُ الدَّهْرُ إِلَيَّ ، أَفَأَقْرِيهِ أَمْ أَمْنَعُهُ ؟ قَالَ : بَلِ اقْرِهِ  .","","Al-Mu'jam al-Kabir 613","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مالك بن نضلة الجشمي"
"17694","614  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  الْمَسْعُودِيُّ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ  أَنَّ  عَوْفَ بْنَ مَالِكٍ -  يَعْنِي أَبَاهُ -  أَتَى رَسُولَ         [19/280]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَيْهِ أَطْمَارٌ ، فَقَالَ :  يَا  عَوْفَ بْنَ مَالِكٍ ،  أَلَيْسَ  تُنْتَجُ  إِبِلُكَ وَهِيَ صَحِيحَةٌ آذَانُهَا فَتَعْمِدُ إِلَى بَعْضِهَا فَتَجْدَعُهَا  فَتَقُولُ : هَذِهِ بَحِيرَةٌ ، وَتَعْمِدُ إِلَى بَعْضِهَا فَتَشُقُّ آذَانَهَا ، ثُمَّ تَقُولُ : هَذِهِ  صُرُمٌ  ؟ فَلَا تَفْعَلْ ،  سَاعِدُ  اللهِ أَشَدُّ مِنْ سَاعِدِكَ ، وَمُوسَى اللهِ أَحَدُّ ، كُلُّ مَا آتَاكَ اللهُ حَلَالٌ ، وَلَا تُحَرِّمْ مِنْ مَالِكَ شَيْئًا . ثُمَّ قَالَ لَهُ : يَا  عَوْفَ بْنَ مَالِكٍ ،  غُلَامُكَ الَّذِي يُطِيعُكَ وَيَتَّبِعُ أَمْرَكَ أَحَبُّ إِلَيْكَ أَمْ غُلَامُكَ الَّذِي لَا يُطِيعُكَ وَلَا يَتَّبِعُ أَمْرَكَ ؟ قَالَ : بَلْ غُلَامِي الَّذِي يُطِيعُنِي وَيَتَّبِعُ أَمْرِي . قَالَ : فَكَذَلِكُمْ أَنْتُمْ عِنْدَ رَبِّكُمْ تَعَالَى  .","","Al-Mu'jam al-Kabir 614","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن عبد الرحمن بن عبد الله بن عتبة المسعودي عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مالك بن نضلة الجشمي"
"17695","615  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَالِدٍ الْمِصِّيصِيُّ  ، ثَنَا  يَحْيَى بْنُ مُحَمَّدِ بْنِ سَابِقٍ ،  ثَنَا  زِيَادُ بْنُ الْحَسَنِ بْنِ فُرَاتٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَجَعَلَ يَسْأَلُ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، فَلَمَّا رَأَى النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سُوءَ هَيْئَتِهِ قَالَ : هَلْ لَكَ مِنْ مَالٍ ؟ قَالَ : نَعَمْ ، كُلُّ الْمَالِ قَدْ آتَانِي اللهُ ؛ مِنَ الْإِبِلِ وَالْغَنَمِ وَالْخَيْلِ . قَالَ :  إِذَا آتَاكَ اللهُ مَالًا فَلْيُرَ عَلَيْكَ  .","","Al-Mu'jam al-Kabir 615","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن الحسن بن الفرات القزاز عن زياد بن الحسن القزاز عن يحيى بن محمد بن سابق المصيصي عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","مالك بن نضلة الجشمي"
"17696","616  -  حَدَّثَنَا  أَحْمَدُ بْنُ شُعَيْبٍ أَبُو عَبْدِ الرَّحْمَنِ النَّسَائِيُّ  ، ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  أَنَا  مُحَمَّدُ بْنُ يَزِيدَ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي خَالِدٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  قَالَ :  دَخَلْتُ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَإِنِّي سَيِّئُ الْهَيْئَةِ ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : هَلْ لَكَ مِنْ مَالٍ ؟ قُلْتُ : نَعَمْ ، مِنْ كُلِّ الْمَالِ قَدْ آتَانِي اللهُ . قَالَ :  إِذَا كَانَ لَكَ مَالٌ فَلْيُرَ عَلَيْكَ  .","","Al-Mu'jam al-Kabir 616","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن إسماعيل بن أبي خالد عن محمد بن يزيد الكلاعي عن إسحاق ابن راهويه عن النسائي عن الطبراني","مالك بن نضلة الجشمي"
"17697","617  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ         [19/281]      كَرَامَةَ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ مُوسَى ،  ثَنَا  فِطْرُ بْنُ خَلِيفَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَفِيَّ أَعْرَابِيَّةٌ وَعَلَيَّ لِبَاسُ الْأَعْرَابِ ، فَقَالَ لِي : أَلَكَ مَالٌ ؟ قَالَ : قُلْتُ : مِنْ كُلِّ الْمَالِ قَدْ آتَانِي اللهُ . قَالَ :  فَإِذَا آتَاكَ اللهُ مَالًا فَلْيُرَ أَثَرُ نِعْمَةِ اللهِ .  فَقُلْتُ : يَا رَسُولَ اللهِ ، إِنَّ الرَّجُلَ يُؤْذِينِي ، أَفَأَفْعَلُ بِهِ كَمَا يَفْعَلُ بِي ؟ قَالَ : لَا ، فَإِنَّ  الْيَدَ  الْعُلْيَا  خَيْرٌ مِنَ  الْيَدِ  السُّفْلَى ، فَقَالَ : كَيْفَ تَصْنَعُ فِي إِبِلِكَ ، تَقْطَعُ آذَانَهَا وَتَقُولُ بَحِيرَةٌ  وَسَائِبَةٌ  وَوَصِيلَةٌ  ؟ قُلْتُ : نَعَمْ ، قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : إِنَّ مُوسَى اللهِ أَحَدُّ مِنْ مُوسَاكَ ، وَسَاعِدَ اللهِ أَشَدُّ مِنْ سَاعِدِكَ  .","","Al-Mu'jam al-Kabir 617","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن فطر بن خليفة عن عبيد الله بن موسى عن محمد بن عثمان بن كرامة الوراق عن أحمد بن يحيى بن زهير التستري عن الطبراني","مالك بن نضلة الجشمي"
"17698","618  -  حَدَّثَنَا  الْمُفَضَّلُ بْنُ مُحَمَّدٍ الْجَنَدِيُّ ،  ثَنَا  أَبُو حُمَةَ مُحَمَّدُ بْنُ يُوسُفَ الزُّبَيْدِيُّ ،  ثَنَا  أَبُو قُرَّةَ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَآهُ سَيِّئَ الْهَيْئَةِ ، فَقَالَ لَهُ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  أَمَا لَكَ مَالٌ ؟ قَالَ : قَالَ : بَلَى . قَالَ : فَلْيُرَ عَلَيْكَ نِعْمَةُ اللهِ  .","","Al-Mu'jam al-Kabir 618","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن ابن جريج عن موسى بن طارق الزبيدي عن محمد بن يوسف الزيادي عن المفضل بن محمد بن إبراهيم الشعبي عن الطبراني","مالك بن نضلة الجشمي"
"17699","619  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ مَنْدَهْ الْأَصْبَهَانِيُّ  ، ثَنَا  حُمَيْدُ بْنُ مَسْعَدَةَ ،  ثَنَا  الْفَضْلُ بْنُ الْعَلَاءِ ،  ثَنَا  أَشْعَثُ بْنُ سَوَّارٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  قَالَ :  دَخَلْتُ عَلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَعَلَيَّ خُلْقَانٌ مِنْ ثِيَابٍ ، فَقَالَ : لَكَ مَالٌ ؟ قُلْتُ : نَعَمْ ، مِنْ كُلِّ الْمَالِ قَدْ آتَانِي اللهُ ، فَعَدَّ الْخَيْلَ وَالْإِبِلَ وَالرَّقِيقَ وَالْغَنَمَ ، قَالَ :  إِذَا آتَاكَ اللهُ خَيْرًا فَلْيُرَ عَلَيْكَ  .  قَالَ :  أَتُنْتِجُ  إِبِلُكَ وَهِيَ  وَافِيَةٌ  آذَانُهَا ؟ قَالَ : فَتَأْخُذُ مُوسَاكَ ، فَتَقُولُ هَذِهِ  بُحُرٌ  وَهَذِهِ  صُرُمٌ  ؟ قَالَ : نَعَمْ . قَالَ : إِنَّ كُلَّ مَا آتَاكَ اللهُ حِلٌّ ، وَسَاعِدَ اللهِ أَشَدُّ ، وَمُوسَى اللهِ أَحَدُّ  .  كذا في طبعة مكتبة ابن تيمية ، والذي في نسخة أحمد الثالث : ( أشعث بن سوار عن أبي الأحوص عن أبي إسحاق عن أبيه ) وظاهر أن فيه قلب ، والصواب ( أشعث بن سوار عن أبي الأحوص عن أبي إسحاق عن أبيه ) وينظر ما قبله وما بعده . والله أعلم.","","Al-Mu'jam al-Kabir 619","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن سلام بن سليم الحنفي عن أشعث بن سوار عن الفضل بن العلاء الكوفي عن حميد السامي عن محمد بن يحيى بن مندة عن الطبراني","مالك بن نضلة الجشمي"
"17700","[19/282]      620  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ دَاوُدَ الْجَنَدِيُّ النَّيْسَابُورِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عُقْبَةَ السَّدُوسِيُّ ،  ثَنَا  عَبْدُ الْحَمِيدِ بْنُ الْحَسَنِ ،  ثَنَا  أَبُو إِسْحَاقَ الْهَمْدَانِيُّ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنَا  قَشِفُ  الْهَيْئَةِ ، فَقَالَ لِي :  هَلْ لَكَ مِنْ مَالٍ ؟ قُلْتُ : نَعَمْ ؛ مِنَ الْإِبِلِ وَالْغَنَمِ وَالرَّقِيقِ . قَالَ : فَهَلَّا يُرَى عَلَيْكَ  .","","Al-Mu'jam al-Kabir 620","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن عبد الحميد بن الحسن الهلالي عن محمد بن عقبة بن هرم السدوسي عن أحمد بن محمد بن داود الجندي النيسابوري عن الطبراني","مالك بن نضلة الجشمي"
"17701","621  -  حَدَّثَنَا  الْهَيْثَمُ بْنُ خَالِدٍ الْمِصِّيصِيُّ  ، ثَنَا  دَاوُدُ بْنُ مَنْصُورٍ الْقَاضِي ،  ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَشِفَ  الْهَيْئَةِ سَيِّئَ الْهَيْئَةِ ، فَقَالَ :  هَلْ لَكَ مَالٌ ؟ قَالَ : نَعَمْ . قَالَ : مَا مَالُكَ ؟ قَالَ : إِبِلٌ وَخَيْلٌ وَرَقِيقٌ .  قَالَ : فَإِذَا آتَاكَ اللهُ  مَالًا - أَوْ قَالَ : خَيْرًا  - فَلْيُرَ عَلَيْكَ ، فَإِنَّ اللهَ إِذَا أَكْرَمَ عَبْدًا أَحَبَّ أَنْ يَرَى كَرَامَتَهُ عَلَيْهِ .  قَالَ : هَلْ  تُنْتَجُ  إِبِلُكَ صِحَاحًا آذَانُهَا ؟ قَالَ : وَهَلْ  تُنْتَجُ  الْإِبِلُ لَيْسَتْ لَهَا آذَانٌ ؟ قَالَ : فَتَعْمِدُ إِلَى مُوسَى فَتَقْطَعُ آذَانَهَا وَتَقُولُ هَذِهِ  بُحُرٌ  وَتَشُقُّ آذَانَهَا وَتَقُولُ هَذِهِ  صُرُمٌ  وَتُحَرِّمُهَا عَلَيْكَ ؟ قُلْتُ : نَعَمْ . قَالَ : فَإِنَّ كُلَّ مَا آتَاكَ اللهُ حَلَالٌ ، وَسَاعِدَ اللهِ أَشَدُّ مِنْ سَاعِدِكَ ، وَمُوسَى اللهِ أَحَدُّ مِنْ مُوسَاكَ ! قُلْتُ : يَا نَبِيَّ اللهِ ، إِنِّي آتِي الرَّجُلَ وَلَا يَقْرِينِي وَلَا يُكْرِمُنِي ، أَفَأُجَازِيهِ أَمْ أَقْرِيهِ ؟ قَالَ : بَلِ اقْرِهِ  .","","Al-Mu'jam al-Kabir 621","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن أبو إسحاق السبيعي عن جرير بن حازم عن داود بن منصور الثغري عن الهيثم بن خالد بن يزيد المصيصي عن الطبراني","مالك بن نضلة الجشمي"
"17702","622  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  ثَنَا  أَبُو الزَّعْرَاءِ عَمْرُو بْنُ عَمْرٍو ،  عَنْ  عَمِّهِ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  قَالَ :  أَتَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  فَصَعَّدَ  فِيَّ النَّظَرَ  وَصَوَّبَ         [19/283]      وَقَالَ :  أَرَبُّ إِبِلٍ أَوْ رَبُّ غَنَمٍ ؟ قَالَ : مِنْ كُلٍّ قَدْ آتَانِي اللهُ فَأَكْثَرَ وَأَطْيَبَ .  قَالَ :  فَتُنْتِجُهَا  وَافِيَةً  أَعْيُنُهَا وَآذَانُهَا فَتَجْذِمُ هَذِهِ فَتَقُولُ صَرْمَاءُ - ثُمَّ تَكَلَّمَ  سُفْيَانُ  بِكَلِمَةٍ لَمْ أَفْهَمْهَا - وَتَقُولُ : بَحِيرَةُ اللهِ ، وَسَاعِدُ اللهِ أَشَدُّ ، وَمُوسَى اللهِ أَحَدُّ ، وَلَوْ شَاءَ أَنْ يَأْتِيَكَ بِهِ صَرْمَاءَ آتَاكَ ، قُلْتُ : إِلَامَ تَدْعُو ؟ قَالَ : إِلَى اللهِ وَالرَّحِمِ ، قُلْتُ : يَأْتِينِي الرَّجُلُ مِنْ بَنِي عَمِّي فَأَحْلِفُ أَنْ لَا أُعْطِيَهُ ثُمَّ أَفْعَلُ ! قَالَ : فَكَفِّرْ عَنْ يَمِينِكَ وَائْتِ الَّذِي هُوَ خَيْرٌ ، أَرَأَيْتَ إِنْ كَانَ لَكَ عَبْدَانِ أَحَدُهُمَا يُطِيعُكَ وَلَا يَخُونُكَ وَلَا يَكْذِبُكَ ، وَالْآخَرُ يَخُونُكَ وَيَكْذِبُكَ ، الَّذِي يُطِيعُكَ وَلَا يَكْذِبُكَ أَحَبُّ إِلَيْكَ أَمِ الَّذِي يَخُونُكَ وَيَكْذِبُكَ ؟ قُلْتُ : لَا ، بَلِ الَّذِي لَا يَخُونُنِي وَلَا يَكْذِبُنِي وَيَصْدُقُنِي الْحَدِيثَ أَحَبُّ إِلَيَّ . قَالَ : كَذَاكُمْ أَنْتُمْ عِنْدَ رَبِّكُمْ  .","","Al-Mu'jam al-Kabir 622","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن عمرو بن عمرو الجشمي عن سفيان بن عيينة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","مالك بن نضلة الجشمي"
"17703","623  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ الْحَسَنِ الْعَطَّارُ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  أَنَّهُ أَتَى النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَرَآهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَشْعَثَ  أَغْبَرَ فِي هَيْئَةِ أَعْرَابِيٍّ ، فَقَالَ لَهُ :  مَا لَكَ مِنْ مَالٍ ؟ قَالَ : مِنْ كُلِّ الْمَالِ قَدْ آتَانِي اللهُ .  قَالَ : فَإِنَّ اللهَ إِذَا أَنْعَمَ عَلَى الْعَبْدِ نِعْمَةً أَحَبَّ أَنْ يُرَى عَلَيْهِ  .","","Al-Mu'jam al-Kabir 623","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن عبد الملك بن عمير القبطي عن حماد بن سلمة عن هدبة بن خالد عن سليمان بن الحسن العطار عن الطبراني","مالك بن نضلة الجشمي"
"17704","624  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحُسَيْنِ بْنِ مُكْرَمٍ ،  ثَنَا  مَعْمَرُ بْنُ سَهْلٍ الْأَهْوَازِيُّ ،  ثَنَا  عَامِرُ بْنُ مُدْرِكٍ ،  حَدَّثَنِي  يَحْيَى بْنُ سَلَمَةَ بْنِ كُهَيْلٍ ،  عَنْ  أَبِيهِ  وَعَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ ،  عَنْ  أَبِي الْأَحْوَصِ ،  عَنْ  أَبِيهِ  أَنَّهُ أَتَى النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَذَكَرَ نَحْوَهُ .","","Al-Mu'jam al-Kabir 624","","مالك بن نضلة الجشمي عن عوف بن مالك بن نضلة الجشمي عن سلمة بن كهيل الحضرمي عن يحيى بن سلمة بن كهيل عن عامر بن مدرك بن أبي الصفيراء الحارثي عن معمر بن سهل بن معمر الأهوازي عن محمد بن الحسين بن مكرم البارع عن الطبراني","مالك بن نضلة الجشمي"
"17705","[19/284]      مَالِكُ بْنُ الْحُوَيْرِثِ ، أَبُو سُلَيْمَانَ اللَّيْثِيُّ  625  -  حَدَّثَنَا  أَبُو مَعْنٍ ثَابِتُ بْنُ نُعَيْمٍ الْهَوْجِيُّ  ، ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ حُبَابٍ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ الْبَصْرِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ الْبَصْرِيُّ  ، ثَنَا  حَفْصُ بْنُ عُمَرَ الْحَوْضِيُّ (  ح  ) .  وَحَدَّثَنَا  عُمَرُ بْنُ حَفْصٍ السَّدُوسِيُّ  ، ثَنَا  عَاصِمُ بْنُ عَلِيٍّ - قَالُوا :  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  ثَنَا  نَصْرُ بْنُ عَاصِمٍ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا كَبَّرَ رَفَعَ يَدَيْهِ إِذَا دَخَلَ فِي الصَّلَاةِ حَتَّى يُحَاذِيَ بِهِمَا أُذُنَيْهِ  ، وَإِذَا رَكَعَ وَرَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ . وَاللَّفْظُ وَاحِدٌ  .","","Al-Mu'jam al-Kabir 625","","مالك بن الحويرث الليثي عن نصر بن عاصم الليثي عن قتادة بن دعامة عن شعبة بن الحجاج عن عاصم بن علي الواسطي عن عمر بن حفص السدوسي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17706","626  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  نَصْرِ بْنِ عَاصِمٍ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا دَخَلَ فِي الصَّلَاةِ رَفَعَ يَدَيْهِ إِلَى  فُرُوعِ  أُذُنَيْهِ ، وَإِذَا رَكَعَ  ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ  .","","Al-Mu'jam al-Kabir 626","","مالك بن الحويرث الليثي عن نصر بن عاصم الليثي عن قتادة بن دعامة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17707","627  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  نَصْرِ بْنِ عَاصِمٍ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا كَبَّرَ رَفَعَ يَدَيْهِ حَتَّى يُحَاذِيَ بِهِمَا أُذُنَيْهِ  ،         [19/285]      وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ فَعَلَ مِثْلَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 627","","مالك بن الحويرث الليثي عن نصر بن عاصم الليثي عن قتادة بن دعامة عن الوضاح بن عبد الله اليشكري عن فضيل بن حسين الجحدري عن عبد الله بن أحمد بن حنبل عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17708","628  -  حَدَّثَنَا  أَحْمَدُ بْنُ بِشْرِ بْنِ حَبِيبٍ الْبَيْرُوتِيُّ  ، ثَنَا  عَبْدُ الْحَمِيدِ بْنُ بَكَّارٍ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  نَصْرِ بْنِ عَاصِمٍ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ قَالَ :  رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَرْفَعُ يَدَيْهِ إِذَا كَبَّرَ حَتَّى يُحَاذِيَ بِهِمَا أُذُنَيْهِ  ، وَإِذَا رَكَعَ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ  .","","Al-Mu'jam al-Kabir 628","","مالك بن الحويرث الليثي عن نصر بن عاصم الليثي عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن عبد الحميد بن بكار البيروتي عن أحمد بن بشر بن حبيب البيروتي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17709","629  -  حَدَّثَنَا  عَبْدَانُ بْنُ مُحَمَّدٍ الْمَرْوَزِيُّ  ، ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  هِشَامُ بْنُ أَبِي عَبْدِ اللهِ ،  ثَنَا  قَتَادَةُ ،  عَنْ  نَصْرِ بْنِ عَاصِمٍ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ إِذَا كَبَّرَ رَفَعَ يَدَيْهِ حَتَّى يَجْعَلَهُمَا قَرِيبًا مِنْ أُذُنَيْهِ  ، وَإِذَا رَكَعَ صَنَعَ مِثْلَ ذَلِكَ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ صَنَعَ مِثْلَ ذَلِكَ  .","","Al-Mu'jam al-Kabir 629","","مالك بن الحويرث الليثي عن نصر بن عاصم الليثي عن قتادة بن دعامة عن هشام الدستوائي عن يزيد بن زريع العيشي عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17710","630  -  حَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  مُحَمَّدُ بْنُ الْمِنْهَالِ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ اللهِ بْنُ نُمَيْرٍ - قَالَا :  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  نَصْرِ بْنِ عَاصِمٍ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ قَالَ :  رَأَيْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَرْفَعُ يَدَيْهِ حَتَّى يُحَاذِيَ بِهِمَا  فُرُوعَ  أُذُنَيْهِ  . زَادَ  يَزِيدُ بْنُ زُرَيْعٍ  : وَإِذَا رَكَعَ كَذَلِكَ ، وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ كَذَلِكَ  .","","Al-Mu'jam al-Kabir 630","","مالك بن الحويرث الليثي عن نصر بن عاصم الليثي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن عبد الله بن نمير عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17711","[19/286]      631  -  حَدَّثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الرَّاسِبِيُّ  ، ثَنَا  مُهَلَّبُ بْنُ الْعَلَاءِ ،  ثَنَا  شُعَيْبُ بْنُ بَيَانٍ ،  ثَنَا  عِمْرَانُ الْقَطَّانُ ،  عَنْ  قَتَادَةَ ،  عَنْ  نَصْرِ بْنِ عَاصِمٍ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ  أَنَّهُ صَلَّى مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  فَرَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَرْفَعُ يَدَيْهِ إِذَا كَبَّرَ  وَإِذَا أَرَادَ أَنْ يَرْكَعَ وَإِذَا رَفَعَ رَأْسَهُ مِنَ الرُّكُوعِ نَحْوَ أُذُنَيْهِ  .","","Al-Mu'jam al-Kabir 631","","مالك بن الحويرث الليثي عن نصر بن عاصم الليثي عن قتادة بن دعامة عن عمران بن داور القطان عن شعيب بن بيان الصفار عن مهلب بن العلاء عن محمد بن خالد الراسبي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17712","632  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ التَّمَّارُ  ، ثَنَا  سَهْلُ بْنُ زِيَادٍ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ  ، ثَنَا  عَبْدُ اللهِ بْنُ سَوَّارٍ الْعَنْبَرِيُّ (  ح  ) .  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ - قَالُوا :  ثَنَا  أَبَانُ بْنُ يَزِيدَ الْعَطَّارُ ،  ثَنَا  يَزِيدُ بْنُ مَيْسَرَةَ ،  ثَنَا  أَبُو عَطِيَّةَ - مَوْلًى مِنَّا - قَالَ :  كَانَ مَالِكُ بْنُ الْحُوَيْرِثِ يَأْتِينَا إِلَى مُصَلَّانَا ، فَأُقِيمَتِ الصَّلَاةُ ، فَقُلْنَا لَهُ : تَقَدَّمْ فَصَلِّ ! فَقَالَ لَنَا : قَدِّمُوا رَجُلًا مِنْكُمْ لِيُصَلِّيَ بِكُمْ ، وَسَأُحَدِّثُكُمْ لِمَ لَا أُصَلِّي بِكُمْ ؛ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ زَارَ قَوْمًا فَلَا يَؤُمَّهُمْ ، وَلْيَؤُمَّهُمْ رَجُلٌ مِنْهُمْ  .","","Al-Mu'jam al-Kabir 632","","مالك بن الحويرث الليثي عن أبو عطية العقيلى عن يزيد بن ميسرة الجبيري عن أبان بن يزيد العطار عن أبو الوليد الطيالسي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17713","633  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ حَرْبٍ - قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  أَيُّوبُ ،  عَنْ  أَبِي قِلَابَةَ  أَنَّ مَالِكَ بْنَ الْحُوَيْرِثِ قَالَ لِأَصْحَابِهِ :  أَلَا أُرِيكُمْ كَيْفَ كَانَتْ صَلَاةُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟  وَذَلِكَ فِي غَيْرِ حِينِ صَلَاةٍ ،         [19/287]      فَقَامَ ، ثُمَّ رَكَعَ فَكَبَّرَ ، ثُمَّ رَفَعَ رَأْسَهُ فَقَامَ هُنَيْهَةً ، ثُمَّ سَجَدَ ثُمَّ رَفَعَ رَأْسَهُ ، ثُمَّ انْتَظَرَ ، ثُمَّ سَجَدَ ، ثُمَّ رَفَعَ رَأْسَهُ ، ثُمَّ انْتَظَرَ هُنَيْهَةً ، ثُمَّ سَجَدَ  .  وَاللَّفْظُ  لِعَارِمٍ  .","","Al-Mu'jam al-Kabir 633","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن أيوب السختياني عن حماد بن زيد عن سليمان بن حرب الواشحي عن أبو مسلم الكجي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17714","634  -  حَدَّثَنَا  زَكَرِيَّا بْنُ حَمْدَوَيْهِ الصَّفَّارُ  ، ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  وُهَيْبُ بْنُ خَالِدٍ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ قَالَ :  جَاءَنَا مَالِكُ بْنُ الْحُوَيْرِثِ فِي مَسْجِدِنَا فَصَلَّى بِنَا ،  فَقَالَ  :  إِنِّي لَأُصَلِّي بِكُمْ وَلَا أُرِيدُ الصَّلَاةَ ، وَلَكِنْ أُرِيدُ أَنْ أُرِيَكُمْ كَيْفَ رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُصَلِّي  . قَالَ  أَيُّوبُ  : فَقُلْتُ  لِأَبِي قِلَابَةَ  : كَيْفَ كَانَتْ صَلَاتُهُ ؟ قَالَ : كَصَلَاةِ شَيْخِنَا  عَمْرِو بْنِ سَلِمَةَ ،  وَكَانَ الشَّيْخُ يُتِمُّ التَّكْبِيرَ ، وَكَانَ إِذَا رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ الْأُولَى اعْتَمَدَ عَلَى الْأَرْضِ ثُمَّ قَامَ  .","","Al-Mu'jam al-Kabir 634","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن أيوب السختياني عن وهيب بن خالد الكرابيسي عن عفان بن مسلم الصفار عن زكريا بن حمدويه الصفار عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17715","635  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ - قَالُوا :  ثَنَا  حَمَّادٌ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ قَالَ :  أَتَيْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَنَحْنُ  شَبَبَةٌ  فَأَقَمْنَا مَعَهُ نَحْوًا مِنْ عِشْرِينَ لَيْلَةً أَوْ يَوْمًا ، فَقَالَ لَنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنْ رَجَعْتُمْ إِلَى  أَهْلِيكُمْ - أَوْ قَالَ : بِلَادِكُمْ  - عَلِّمُوهُمْ .  قَالَ : وَكَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ         [19/288]      رَحِيمًا ، مُرُوهُمْ فَلْيُصَلُّوا صَلَاةَ كَذَا فِي حِينِ كَذَا وَصَلَاةَ كَذَا فِي حِينِ كَذَا ، فَإِذَا حَضَرَتِ الصَّلَاةُ فَلْيُؤَذِّنْ أَحَدُكُمْ ثُمَّ لِيَؤُمَّكُمْ أَكْبَرُكُمْ .  وَاللَّفْظُ لِحَدِيثِ  عَارِمٍ  .","","Al-Mu'jam al-Kabir 635","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن أيوب السختياني عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17716","636  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَيُّوبَ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  يَؤُمُّ  الْقَوْمَ  أَكْبَرُهُمْ سِنًّا  . وَكَانَ  مَالِكُ بْنُ الْحُوَيْرِثِ  إِذَا رَفَعَ رَأْسَهُ مِنَ السَّجْدَةِ الثَّانِيَةِ قَعَدَ ثُمَّ نَهَضَ  .","","Al-Mu'jam al-Kabir 636","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن أيوب السختياني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17717","637  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  أَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ قَالَ :  أَتَيْنَا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي نَاسٍ وَنَحْنُ  شَبَبَةٌ  مُتَقَارِبُونَ ، فَأَقَمْنَا عِنْدَهُ عِشْرِينَ لَيْلَةً ، وَكَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَحِيمًا رَقِيقًا حَلِيمًا ، فَظَنَّ أَنَّا قَدِ اشْتَقْنَا أَهْلَنَا وَاشْتَهَيْنَاهُمْ ، فَسَأَلَنَا عَمَّنْ تَرَكْنَا بَعْدَنَا فَأَخْبَرْنَاهُ ، فَقَالَ :  ارْجِعُوا إِلَى أَهْلِيكُمْ وَأَقِيمُوا عِنْدَهُمْ وَعَلِّمُوهُمْ وَمُرُوهُمْ  ، وَقَالَ : إِذَا حَضَرَتِ الصَّلَاةُ فَلْيُؤَذِّنْ أَحَدُكُمْ وَلْيَؤُمَّكُمْ أَكْبَرُكُمْ  .","","Al-Mu'jam al-Kabir 637","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن خالد الحذاء عن عبد الوهاب بن عبد المجيد الثقفي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17718","638  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ - قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا كُنْتَ مَعَ صَاحِبِكَ فَأَذِّنْ وَأَقِمْ ، وَلْيَؤُمَّكُمَا أَكْبَرُكُمَا  .","","Al-Mu'jam al-Kabir 638","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن خالد الحذاء عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17719","639  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، أَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ قَالَ :  أَتَى رَجُلَانِ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يُرِيدَانِ         [19/289]      سَفَرًا ، فَقَالَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَنْتُمَا خَرَجْتُمَا فَأَذِّنَا ثُمَّ أَقِيمَا ، وَلْيَؤُمَّكُمَا أَكْبَرُكُمَا  .","","Al-Mu'jam al-Kabir 639","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن خالد الحذاء عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17720","640  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهُ  وَلِصَاحِبٍ لَهُ  :  إِذَا حَضَرَتِ الصَّلَاةُ فَأَذِّنَا ثُمَّ أَقِيمَا ، وَلْيَؤُمَّكُمَا أَكْبَرُكُمَا  .","","Al-Mu'jam al-Kabir 640","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن خالد الحذاء عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17721","641  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  إِسْمَاعِيلُ ابْنُ عُلَيَّةَ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لَهُ  وَلِصَاحِبٍ لَهُ  :  إِذَا حَضَرَتِ الصَّلَاةُ فَأَذِّنَا ثُمَّ أَقِيمَا ، وَلْيَؤُمَّكُمَا أَكْبَرُكُمَا  . فَقُلْتُ  لِأَبِي قِلَابَةَ  : فَأَيْنَ الْقِرَاءَةُ ؟ فَقَالَ : إِنَّهُمَا كَانَا مُتَقَارِبَيْنِ  .","","Al-Mu'jam al-Kabir 641","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن خالد الحذاء عن إسماعيل ابن علية عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17722","642  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  أَبِي  ،  ثَنَا  عَبْدُ الْوَهَّابِ (  ح  ) .  وَحَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ قَالَ :  كَانَ مَالِكُ بْنُ الْحُوَيْرِثِ يَأْتِينَا فَيَقُولُ :  أَلَا أُحَدِّثُكُمْ عَنْ صَلَاةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَيُصَلِّي فِي غَيْرِ وَقْتِ صَلَاةٍ  ، فَإِذَا رَفَعَ رَأْسَهُ مِنَ السَّجْدَةِ الثَّانِيَةِ فِي أَوَّلِ رَكْعَةٍ اسْتَوَى قَاعِدًا ثُمَّ قَامَ وَاعْتَمَدَ عَلَى الْأَرْضِ  .","","Al-Mu'jam al-Kabir 642","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن خالد الحذاء عن عبد الوهاب بن عبد المجيد الثقفي عن إسحاق ابن راهويه عن محمد بن إسحاق الحنظلي عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17723","643  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  سُوَيْدُ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا         [19/290]      عُبَيْدُ بْنُ عَقِيلٍ الْمُقْرِي ،  ثَنَا  سُلَيْمَانُ بْنُ مُحَمَّدٍ الْقَافِلَّائِيُّ ،  عَنْ  عَاصِمٍ الْجَحْدَرِيِّ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  مَالِكِ بْنِ الْحُوَيْرِثِ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَقْرَأَنَاهُ :         {      فَيَوْمَئِذٍ لا يُعَذِّبُ         }             {      وَلا يُوثِقُ         }      .","","Al-Mu'jam al-Kabir 643","","مالك بن الحويرث الليثي عن أبو قلابة الجرمي عن عاصم بن العجاج الجحدري عن سليمان بن أبي سليمان القافلاني عن عبيد بن عقيل الهلالي عن سويد بن عبد العزيز السلمي عن معاذ بن المثنى العنبري عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17724","644  -  حَدَّثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ الرَّازِيُّ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي الْأَسْوَدِ (  ح  ) .  وَحَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ وَأَحْمَدُ بْنُ الْحُسَيْنِ بْنِ نَصْرٍ الْحَذَّاءُ قَالَا :  ثَنَا  شَبَابٌ الْعُصْفُرِيُّ - قَالَا :  ثَنَا  أُنَيْسُ بْنُ سَوَّارٍ الْجَرْمِيُّ ،  ثَنَا  أَبِي ،  ثَنَا  مَالِكُ بْنُ الْحُوَيْرِثِ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِذَا أَرَادَ اللهُ أَنْ يَخْلُقَ  النَّسَمَةَ  فَجَامَعَ الرَّجُلُ الْمَرْأَةَ طَارَ مَاؤُهُ فِي كُلِّ عِرْقٍ وَعَصَبٍ مِنْهَا  ، فَإِذَا كَانَ يَوْمُ السَّابِعِ أَحْضَرَ اللهُ - عَزَّ وَجَلَّ - لَهُ كُلَّ عِرْقٍ بَيْنَهُ وَبَيْنَ  آدَمَ  ، ثُمَّ قَرَأَ :         {      فِي أَيِّ صُورَةٍ مَا شَاءَ رَكَّبَكَ         }      .","","Al-Mu'jam al-Kabir 644","","مالك بن الحويرث الليثي عن سوار الجرمي عن أنيس بن سوار الجرمي عن خليفة بن خياط عن أحمد بن الحسين بن نصر السامري عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17725","645  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ  ، ثَنَا  حُمَيْدُ بْنُ مَسْعَدَةَ ،  ثَنَا  أُنَيْسُ بْنُ سَوَّارٍ أَبُو زِيَادٍ الْجَرْمِيُّ قَالَ :  قَالَ  أَبِي :  كُنْتُ أَنَا  وَأَبُو قِلَابَةَ  جَالِسَيْنِ فِي مُؤَخَّرِ الْمَسْجِدِ ، فَدَخَلَ عَلَيْنَا مَالِكُ بْنُ الْحُوَيْرِثِ فَقَالَ : أَلَا أُنَبِّئُكُمْ كَيْفَ كَانَ يُصَلِّي نَبِيُّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قُلْنَا : نَعَمْ -  فَتَقَدَّمَ وَرَكَعَ رَكْعَتَيْنِ أَوْجَزَ فِيهِمَا ، فَاخْتَلَفْتُ أَنَا  وَأَبُو قِلَابَةَ  فِي رُكْبَتَيْهِ ؛  فَقُلْتُ أَنَا : أَلْزَقَ بِالْأَرْضِ ، وَقَالَ  أَبُو قِلَابَةَ  :  يُجَافِي  .","","Al-Mu'jam al-Kabir 645","","مالك بن الحويرث الليثي عن سوار الجرمي عن أنيس بن سوار الجرمي عن حميد السامي عن موسى بن هارون الحمال عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17726","[19/291]      646  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  عُمَرُ بْنُ أَبَانَ  ،  ثَنَا  مَالِكُ بْنُ الْحُسَيْنِ بْنِ مَالِكِ بْنِ الْحُوَيْرِثِ  ،  أَخْبَرَنِي  أَبِي ،  عَنْ  جَدِّي مَالِكِ بْنِ الْحُوَيْرِثِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ كُنْتُ  مَوْلَاهُ  فَعَلِيٌّ  مَوْلَاهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عمران بن أبان )  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( مالك بن الحسن بن مالك بن الحويرث )","","Al-Mu'jam al-Kabir 646","","مالك بن الحويرث الليثي عن الحسن بن مالك بن الحويرث عن مالك بن الحسن بن مالك عن عمران بن أبان الواسطي عن الحسن بن علي الريحاني عن عبيد العجل عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17727","647  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  عِمْرَانُ بْنُ أَبَانَ ،  ثَنَا  مَالِكُ بْنُ الْحَسَنِ بْنِ مَالِكِ بْنِ الْحُوَيْرِثِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  لِعَلِيٍّ  :  أَمَا تَرْضَى أَنْ تَكُونَ مِنِّي بِمَنْزِلَةِ  هَارُونَ  مِنْ  مُوسَى  .","","Al-Mu'jam al-Kabir 647","","مالك بن الحويرث الليثي عن الحسن بن مالك بن الحويرث عن مالك بن الحسن بن مالك عن عمران بن أبان الواسطي عن الحسن بن علي الريحاني عن عبيد العجل عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17728","648  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  عِمْرَانُ بْنُ أَبَانَ ،  ثَنَا  مَالِكُ بْنُ الْحَسَنِ بْنِ مَالِكِ بْنِ الْحُوَيْرِثِ ،  عَنْ  أَبِيهِ قَالَ :  قَالَ  مَالِكُ بْنُ الْحُوَيْرِثِ  :  كَانَ أَوَّلَ مَنْ أَسْلَمَ مِنَ الرِّجَالِ  عَلِيٌّ  ، وَمِنَ النِّسَاءِ  خَدِيجَةُ  .","","Al-Mu'jam al-Kabir 648","","مالك بن الحويرث الليثي عن الحسن بن مالك بن الحويرث عن مالك بن الحسن بن مالك عن عمران بن أبان الواسطي عن الحسن بن علي الريحاني عن عبيد العجل عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17729","649  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  الْحَسَنُ بْنُ عَلِيٍّ الْحُلْوَانِيُّ ،  ثَنَا  عِمْرَانُ بْنُ أَبَانَ ،  ثَنَا  مَالِكُ بْنُ الْحَسَنِ بْنِ مَالِكِ بْنِ الْحُوَيْرِثِ ،  عَنْ  أَبِيهِ ،  عَنْ         [19/292]      جَدِّهِ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَقَى عَتَبَةَ الْمِنْبَرِ فَقَالَ :  آمِينَ ، ثُمَّ رَقَى عَتَبَةً أُخْرَى فَقَالَ : آمِينَ ،  ثُمَّ رَقَى عَتَبَةً أُخْرَى فَقَالَ : آمِينَ ، فَقَالَ : أَتَانِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ فَقَالَ : يَا  مُحَمَّدُ ،  مَنْ أَدْرَكَ وَالِدَيْهِ أَوْ أَحَدَهُمَا ثُمَّ دَخَلَ النَّارَ  فَأَبْعَدَهُ  اللهُ ، قُلْ : آمِينَ ، فَقُلْتُ : آمِينَ ، وَمَنْ أَدْرَكَ رَمَضَانَ فَلَمْ يُغْفَرْ لَهُ  فَأَبْعَدَهُ  اللهُ ، قُلْ : آمِينَ ، فَقُلْتُ : آمِينَ ، وَمَنْ ذُكِرْتَ عِنْدَهُ فَلَمْ يُصَلِّ عَلَيْكَ  فَأَبْعَدَهُ  اللهُ ، قُلْ : آمِينَ ، فَقُلْتُ : آمِينَ  .","","Al-Mu'jam al-Kabir 649","","مالك بن الحويرث الليثي عن الحسن بن مالك بن الحويرث عن مالك بن الحسن بن مالك عن عمران بن أبان الواسطي عن الحسن بن علي الريحاني عن عبيد العجل عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17730","650  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ اللهِ الْبَزَّارُ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ السَّكَنِ الْأَيْلِيُّ ،  ثَنَا  عِمْرَانُ بْنُ أَبَانَ ،  ثَنَا  مَالِكُ بْنُ الْحَسَنِ بْنِ مَالِكِ بْنِ الْحُوَيْرِثِ اللَّيْثِيُّ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  الْحَسَنُ  وَالْحُسَيْنُ  سَيِّدَا شَبَابِ أَهْلِ الْجَنَّةِ  ، وَأَبُوهُمَا خَيْرٌ مِنْهُمَا  .","","Al-Mu'jam al-Kabir 650","","مالك بن الحويرث الليثي عن الحسن بن مالك بن الحويرث عن مالك بن الحسن بن مالك عن عمران بن أبان الواسطي عن محمد بن السكن الأيلي عن التستري أحمد بن عبد الله بن زياد عن الطبراني","مالك بن الحويرث أبو سليمان الليثي"
"17731","مَالِكُ بْنُ عَبْدِ اللهِ الْخُزَاعِيُّ  651  -  حَدَّثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ كَيْسَانَ الْمِصِّيصِيُّ  ، ثَنَا  مُعَلَّى بْنُ أَسَدٍ الْعَمِّيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  عَفَّانُ (  ح  ) .  وَحَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ  ، ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ الْمُبَارَكِ الْعَيْشِيُّ - قَالُوا :  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  مَنْصُورِ بْنِ حَيَّانَ ،  عَنْ  سُلَيْمَانَ الْخُزَاعِيِّ ،  عَنْ  خَالِهِ مَالِكِ بْنِ عَبْدِ اللهِ قَالَ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [19/293]      فَمَا صَلَّيْتُ خَلْفَ إِمَامِ قَوْمٍ أَخَفَّ صَلَاةً مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 651","","مالك بن عبد الله بن سنان الخثعمي عن سليمان بن بسر الخزاعي عن منصور بن حيان الأسدي عن عبد الواحد بن زياد عن عبد الرحمن بن المبارك الخلقاني عن الفضل بن الحباب الجمحي عن الطبراني","مالك بن عبد الله الخزاعي"
"17732","652  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  أَبُو بَكْرِ بْنُ أَبِي شَيْبَةَ ،  ثَنَا  مَرْوَانُ بْنُ مُعَاوِيَةَ ،  عَنْ  مَنْصُورِ بْنِ حَيَّانَ ،  ثَنَا  سُلَيْمَانُ بْنُ بِشْرٍ الْخُزَاعِيُّ ،  عَنْ  خَالِهِ مَالِكِ بْنِ عَبْدِ اللهِ قَالَ :  غَزَوْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمْ نُصَلِّ خَلْفَ إِمَامٍ كَانَ أَخَفَّ صَلَاةً فِي الْمَكْتُوبَةِ مِنْهُ  .","","Al-Mu'jam al-Kabir 652","","مالك بن عبد الله الخزاعي عن سليمان بن بسر الخزاعي عن منصور بن حيان الأسدي عن مروان بن معاوية الفزاري عن أبو بكر ابن أبي شيبة عن عبيد بن غنام النخعي عن الطبراني","مالك بن عبد الله الخزاعي"
"17733","مَالِكٌ  وَعُبَيْدٌ  وَقَيْسٌ بَنُو الْخَشْخَاشِ الْعَنْبَرِيِّ  653  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبِي  ،  ثَنَا  الْحُرُّ بْنُ حُصَيْنٍ ،  حَدَّثَنِي  نَصْرُ بْنُ حَسَّانَ ،  عَنْ  حُصَيْنِ بْنِ أَبِي الْحُرِّ  أَنَّ أَبَاهُ  مَالِكًا  وَعَمَّيْهِ  قَيْسًا  وَعُبَيْدًا بَنِي الْخَشْخَاشِ  أَتَوُا النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَشَكَوْا إِلَيْهِ إِغَارَةَ رَجُلٍ مِنْ بَنِي عَمِّهِمْ عَلَى النَّاسِ ، فَكَتَبَ لَهُمْ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  هَذَا كِتَابٌ مِنْ  مُحَمَّدٍ  رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِمَالِكٍ  وَعُبَيْدٍ  وَقَيْسٍ بَنِي الْخَشْخَاشِ  ،  إِنَّكُمْ آمِنُونَ مُسْلِمُونَ عَلَى دِمَائِكُمْ وَأَمْوَالِكُمْ ، لَا تُؤْخَذُونَ  بِجَرِيرَةِ  غَيْرِكُمْ ، وَلَا  يَجْنِي  عَلَيْكُمْ إِلَّا أَيْدِيكُمْ  .","","Al-Mu'jam al-Kabir 653","","حصين بن أبي الحر العنبري عن نصر بن حسان العنبري التميمي عن الحر بن حصين عن المثنى بن معاذ بن معاذ العنبري عن معاذ بن المثنى العنبري عن الطبراني","مالك وعبيد وقيس بنو الخشخاش العنبري"
"17734","[19/294]      مَالِكُ بْنُ أُخَيْمِرَ  654  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  حَدَّثَنِي  أَبِي  (  ح  ) .  وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرَفُ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ - قَالَا :  ثَنَا  ابْنُ أَبِي فُدَيْكٍ ،  ثَنَا  مُوسَى بْنُ يَعْقُوبَ الزَّمْعِيُّ ،  عَنْ  أَبِي رَزِينٍ الْبَاهِلِيِّ ،  عَنْ  مَالِكِ بْنِ أُخَيْمِرَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ اللهَ لَا يَقْبَلُ مِنَ  الصَّقُّورِ  صَرْفًا  وَلَا  عَدْلًا  ، قِيلَ : مَا  الصَّقُّورُ  يَا رَسُولَ اللهِ ؟ قَالَ : الَّذِي يُدْخِلُ الرَّجُلَ عَلَى أَهْلِهِ  .","","Al-Mu'jam al-Kabir 654","","مالك بن يخامر السكسكي عن أبو رزين الباهلي عن موسى بن يعقوب بن عبد الله بن وهب الزمعي عن محمد بن إسماعيل بن مسلم الديلي عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف المصرف عن الطبراني","مالك بن أخيمر"
"17735","مَالِكُ بْنُ عُمَيْرٍ السُّلَمِيُّ  655  -  حَدَّثَنَا  عَلِيُّ بْنُ إِسْحَاقَ الْوَزِيرُ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مَنْصُورٍ الْجَوَّازُ الْمَكِّيُّ ،  ثَنَا  يَعْقُوبُ بْنُ مُحَمَّدٍ الزُّهْرِيُّ ،  ثَنَا  أَبُو صَخْرٍ وَاصِلُ         [19/295]      بْنُ يَزِيدَ السُّلَمِيُّ ثُمَّ النَّاصِرِيُّ ،  حَدَّثَنِي  أَبِي وَعُمُومَتِي ،  عَنْ  جَدِّي مَالِكِ بْنِ عُمَيْرٍ  أَنَّهُ شَهِدَ مَعَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ الْفَتْحِ  وَخَيْبَرَ  وَالطَّائِفَ  ، وَكَانَ رَجُلًا شَاعِرًا ، فَقَالَ : يَا رَسُولَ اللهِ ، أَفْتِنِي فِي الشِّعْرِ ! فَقَالَ :  لَأَنْ يَمْتَلِئَ مَا بَيْنَ  لَبَّتِكَ  إِلَى عَاتِقِكَ  قَيْحًا  خَيْرٌ مِنْ أَنْ يَمْتَلِئَ شِعْرًا  ، قُلْتُ : يَا رَسُولَ اللهِ ، امْسَحْ عَلَى رَأْسِي ! فَوَضَعَ يَدَهُ عَلَى رَأْسِي ، فَمَا قُلْتُ بَعْدَ ذَلِكَ بَيْتَ شِعْرٍ . وَلَقَدْ عُمِّرَ  مَالِكٌ  حَتَّى شَابَ رَأْسُهُ وَلِحْيَتُهُ وَمَا شَابَ مَوْضِعُ يَدِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 655","","مالك بن عمير السلمي عن وعمومتي عن أبو صخر واصل بن يزيد السلمي ثم الناصري عن يعقوب بن محمد بن عيسى عن محمد بن منصور بن ثابت الجواز عن الوزير علي بن إسحاق بن إبراهيم عن الطبراني","مالك بن عمير السلمي"
"17736","مَالِكُ بْنُ عَبْدِ اللهِ الْغَافِقِيُّ ، أَبُو مُوسَى  656  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  ثَعْلَبَةَ بْنِ أَبِي الْكَنُودِ ،  عَنْ  مَالِكِ بْنِ عَبْدِ اللهِ الْغَافِقِيِّ قَالَ :  أَكَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمًا طَعَامًا ثُمَّ قَالَ :  اسْتُرْ عَلَيَّ حَتَّى أَغْتَسِلَ  ، فَقُلْتُ : كُنْتَ  جُنُبًا  يَا رَسُولَ اللهِ ؟ قَالَ : نَعَمْ ، فَأَخْبَرْتُ ذَلِكَ  عُمَرَ بْنَ الْخَطَّابِ  فَجَاءَ إِلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ لَهُ : هَذَا يَزْعُمُ أَنَّكَ أَكَلْتَ وَأَنْتَ  جُنُبٌ  ؟ فَقَالَ : نَعَمْ ، إِذَا تَوَضَّأْتُ أَكَلْتُ وَشَرِبْتُ ، وَلَا أُصَلِّي وَلَا أَقْرَأُ حَتَّى أَغْتَسِلَ  .","","Al-Mu'jam al-Kabir 656","","مالك بن عبادة الغافقي عن ثعلبة بن أبى الكنود الحمراوي عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","مالك بن عبد الله الغافقي أبو موسى"
"17737","657  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  حَدَّثَنِي  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  يَحْيَى بْنِ مَيْمُونٍ الْغَافِقِيِّ - رَجُلٍ         [19/296]      مِنْ غَافِقٍ -  عَنْ  أَبِي مُوسَى الْغَافِقِيِّ  أَنَّهُ سَمِعَ  عُقْبَةَ بْنَ عَامِرٍ  يُحَدِّثُ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  إِنَّ صَاحِبَكُمْ هَذَا لَحَافِظٌ وَهَالِكٌ ، إِنَّ آخِرَ مَا عَهِدَ إِلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ قَالَ :  مَنْ حَفِظَ عَنِّي شَيْئًا فَلْيُحَدِّثْ بِهِ ،  وَمَنْ كَذَبَ عَلَيَّ مُتَعَمِّدًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 657","","مالك بن عبادة الغافقي عن يحيى بن ميمون بن ربيعة الحضرمي عن عمرو بن الحارث بن يعقوب عن الليث بن سعد عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","مالك بن عبد الله الغافقي أبو موسى"
"17738","658  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  يَحْيَى بْنِ مَيْمُونٍ أَنَّ وَدَاعَةَ الْحَمْدِيَّ  حَدَّثَهُ  أَنَّهُ كَانَ بِجَنْبِ مَالِكِ بْنِ عَبْدِ اللهِ الْغَافِقِيِّ  وَعُقْبَةُ بْنُ عَامِرٍ  يَقُصُّ ، فَقَالَ  مَالِكٌ  : إِنَّ صَاحِبَكُمْ هَذَا غَافِلٌ وَهَالِكٌ ، إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَهِدَ إِلَيْنَا فِي  حَجَّةِ الْوَدَاعِ  فَقَالَ :  عَلَيْكُمْ بِالْقُرْآنِ فَإِنَّكُمْ سَتَرْجِعُونَ إِلَى قَوْمٍ يَشْتَهُونَ الْحَدِيثَ عَنِّي  ، فَمَنْ عَقَلَ شَيْئًا فَلْيُحَدِّثْ بِهِ ، وَمَنِ افْتَرَى عَلَيَّ  فَلْيَتَبَوَّأْ  مَقْعَدًا أَوْ شَيْئًا مِنْ  جَهَنَّمَ  - لَا أَدْرِي أَيُّهُمَا قَالَ  .","","Al-Mu'jam al-Kabir 658","","مالك بن عبادة الغافقي عن وداعة الغافقي عن يحيى بن ميمون بن ربيعة الحضرمي عن عمرو بن الحارث بن يعقوب عن عبد الله بن لهيعة عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","مالك بن عبد الله الغافقي أبو موسى"
"17739","مَالِكُ بْنُ عَبْدِ اللهِ الْخَثْعَمِيُّ  659  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَلِيٍّ الْأَبَّارُ  ، ثَنَا  أَيُّوبُ بْنُ مُحَمَّدٍ الْوَزَّانُ ،  ثَنَا  ضَمْرَةُ ،  عَنْ  رَجَاءِ بْنِ أَبِي سَلَمَةَ ،  عَنْ  حَسَّانَ مَوْلَى مَالِكِ بْنِ عَبْدِ اللهِ الْخَثْعَمِيِّ - وَكَانَ  مَالِكٌ  مِنْ أَصْحَابِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  رَأَيْتُ مَالِكَ بْنَ عَبْدِ اللهِ يَتَوَضَّأُ ، وَكَانَ فِي سَاقِهِ  عِرْقٌ  مَكْتُوبٌ لِلهِ ، فَجَعَلْتُ أَنْظُرُ إِلَيْهِ ، فَقَالَ :  أَيَّ شَيْءٍ تَنْظُرُ ؟ أَمَا إِنَّهُ لَمْ يَكْتُبْهُ كَاتِبٌ  .","","Al-Mu'jam al-Kabir 659","","مالك بن عبد الله بن سنان الخثعمي عن حسان مولى مالك بن عبد الله الخثعمي عن رجاء بن أبي سلمة الرملي عن ضمرة بن ربيعة الفلسطيني عن أيوب بن محمد الوزان عن أحمد بن علي بن مسلم النخشبي عن الطبراني","مالك بن عبد الله الخثعمي"
"17740","660  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ         [19/297]      الْحِزَامِيُّ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَبْدُ الرَّحْمَنِ بْنُ شُرَيْحِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عُقْبَةَ الْمَعَافِرِيُّ ،  عَنْ  أَبِيهِ  أَنَّهُ سَمِعَ  مَالِكَ بْنَ عَبْدِ اللهِ الْخَثْعَمِيَّ يُحَدِّثُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَ حَدِيثِ  أَبِي قَتَادَةَ  أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ رَآنِي فِي الْمَنَامِ فَسَيَرَانِي فِي الْيَقَظَةِ ، وَلَا يَتَمَثَّلُ الشَّيْطَانُ بِي  .","","Al-Mu'jam al-Kabir 660","","مالك بن عبد الله بن سنان الخثعمي عن أبو عبد الرحمن بن شريح المعافري عن عبد الرحمن بن شريح المعافري عن عبد الله بن وهب المصري عن إبراهيم بن المنذر الحزامي عن محمد بن علي بن زيد الصائغ عن الطبراني","مالك بن عبد الله الخثعمي"
"17741","661  -  حَدَّثَنَا  سُلَيْمَانُ بْنُ أَيُّوبَ بْنِ حَذْلَمٍ الدِّمَشْقِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْعَلَاءِ بْنِ زَبْرٍ وَابْنِ جَابِرٍ ،  عَنْ  أَبِي الْمُصَبِّحِ ،  عَنْ  مَالِكِ بْنِ عَبْدِ اللهِ الْخَثْعَمِيِّ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنِ اغْبَرَّتْ قَدَمَاهُ فِي  سَبِيلِ  اللهِ حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 661","","مالك بن عبد الله بن سنان الخثعمي عن أبو مصبح الردماني عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن سليمان بن عبد الرحمن التميمي عن سليمان بن أيوب بن سليمان بن داود الأسدي عن الطبراني","مالك بن عبد الله الخثعمي"
"17742","مَالِكُ بْنُ عَبْدِ اللهِ الْجُهَنِيُّ  662  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ وَبَكْرُ بْنُ سَهْلٍ قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  أَبُو شُرَيْحٍ عَبْدُ الرَّحْمَنِ بْنُ شُرَيْحٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ سُلَيْمَانَ بْنِ أَبِي زَيْنَبَ  أَنَّ  مَالِكَ بْنَ عَبْدِ اللهِ الْجُهَنِيَّ مَرَّ عَلَى  حَبِيبِ بْنِ مَسْلَمَةَ  - أَوْ  حَبِيبَ بْنَ مَسْلَمَةَ  مَرَّ عَلَى  مَالِكٍ -  وَهُوَ يَقُودُ فَرَسَهُ وَيَمْشِي ، فَقَالَ لَهُ : أَلَا تَرْكَبُ         [19/298]      إِذْ حَمَلَكَ اللهُ ؟ فَقَالَ : إِنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  مَنِ اغْبَرَّتْ قَدَمَاهُ فِي  سَبِيلِ  اللهِ حَرَّمَهُ اللهُ عَلَى النَّارِ  .","","Al-Mu'jam al-Kabir 662","","مالك بن عبد الله بن سنان الخثعمي عن عبد الله بن سليمان بن أبي زينب عن عبد الرحمن بن شريح المعافري عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","مالك بن عبد الله الجهني"
"17743","مَالِكُ ابْنُ بُحَيْنَةَ الْأَزْدِيُّ ، أَبُو عَبْدِ اللهِ ،  وَبُحَيْنَةُ  أُمُّهُ ، وَهِيَ  بُحَيْنَةُ بِنْتُ الْحَارِثِ بْنِ الْمُطَّلِبِ بْنِ عَبْدِ مَنَافٍ أُخْتُ عُبَيْدَةَ بْنِ الْحَارِثِ ،  وَهُوَ  مَالِكُ بْنُ سَعِيدِ بْنِ الْقِشْبِ  مِنْ  أَزْدِ شَنُوءَةَ  663  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْمُقْرِي الْوَاسِطِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ خَالِدٍ الْوَاسِطِيُّ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  حَفْصِ بْنِ عَاصِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَالِكِ ابْنِ بُحَيْنَةَ ،  عَنْ  أَبِيهِ  قَالَ :  مَرَّ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - بِرَجُلٍ يُصَلِّي وَقَدْ أُقِيمَتِ الصَّلَاةُ ، فَكَلَّمَهُ بِشَيْءٍ لَا أَدْرِي مَا هُوَ ، فَلَمَّا انْصَرَفْنَا أَحَطْنَا بِهِ نَقُولُ : مَاذَا قَالَ لَكَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ قَالَ : قَالَ :  يُوشِكُ  أَنْ يُصَلَّى الصُّبْحُ أَرْبَعًا  .","","Al-Mu'jam al-Kabir 663","","مالك بن بحينة عن عبد الله بن مالك بن سعد بن القشب الأزدي عن حفص بن عاصم بن عمر بن الخطاب عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن محمد بن خالد بن عبد الله الواسطي عن يوسف بن يعقوب بن الحسين الواسطي عن الطبراني","مالك ابن بحينة الأزدي أبو عبد الله"
"17744","مَالِكُ بْنُ حَيْدَةَ الْقُشَيْرِيُّ  664  -  حَدَّثَنَا  جَعْفَرُ بْنُ أَحْمَدَ بْنِ سِنَانٍ الْوَاسِطِيُّ  ، ثَنَا  الْحَسَنُ بْنُ مُكْرَمٍ ،  ثَنَا  يَحْيَى بْنُ حَمَّادٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  أَبِي قَزَعَةَ ،  عَنْ  حَكِيمِ بْنِ مُعَاوِيَةَ ،  عَنْ  أَبِيهِ  أَنَّهُ قَالَ  لِأَخِيهِ مَالِكِ بْنِ حَيْدَةَ  :  انْطَلِقْ بِنَا إِلَى النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَإِنَّهُ يَعْرِفُكَ وَلَا يَعْرِفُنِي ، فَقَدْ حَبَسَ نَاسًا مِنْ  بَنِي بَهْدَمَ  جِيرَانِي ، فَأَتَيَاهُ فَقَالَ  مَالِكُ بْنُ حَيْدَةَ  :  يَا رَسُولَ اللهِ ، إِنِّي قَدْ أَسْلَمْتُ وَأَسْلَمَ جِيرَانِي ، فَخَلِّ عَنْهُمْ ! فَلَمْ يُجِبْهُ ،  ثُمَّ أَعَادَ عَلَيْهِ فَلَمْ يُجِبْهُ ، ثُمَّ أَعَادَ عَلَيْهِ فَلَمْ يُجِبْهُ ، فَقَامَ         [19/299]      مُتَمَقِّطًا  ، فَقَالَ : لَئِنْ فَعَلْتَ ذَاكَ ، إِنَّهُمْ يَزْعُمُونَ أَنَّكَ تَدْعُو إِلَى الْأَمْرِ وَتُخَالِفُ إِلَى غَيْرِهِ ، فَجَعَلْتُ أَزْجُرُهُ وَأَنْهَاهُ ، فَقَالَ : مَا يَقُولُ ؟ قَالُوا : إِنَّهُ يَقُولُ كَذَا وَكَذَا ، فَقَالَ : إِنْ فَعَلْتَ ذَلِكَ ، إِنَّ ذَاكَ عَلَيَّ مَا عَلَيْهِمْ مِنْهُ ، دَعْ لَهُ جِيرَانَهُ  .","","Al-Mu'jam al-Kabir 664","","مالك بن حيدة القشيري عن معاوية بن حيدة القشيري عن حكيم بن معاوية بن حيدة القشيري عن سويد بن حجير الباهلي عن حماد بن سلمة عن يحيى بن حماد بن أبي زياد الشيباني عن الحسن بن مكرم البغدادي عن جعفر بن أحمد بن سنان الواسطي عن الطبراني","مالك بن حيدة القشيري"
"17745","مَالِكُ بْنُ هُبَيْرَةَ السَّكُونِيُّ  665  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مَرْثَدِ بْنِ عَبْدِ اللهِ الْيَزَنِيِّ ،  عَنْ  مَالِكِ بْنِ هُبَيْرَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا مِنْ مُسْلِمٍ يُصَلِّي عَلَيْهِ ثَلَاثُ صُفُوفٍ إِلَّا أَوْجَبَ .  قَالَ : وَكَانَ  مَالِكٌ  إِذَا اسْتَقْبَلَ أَهْلَ الْجِنَازَةِ جَزَّأَهُمْ ثَلَاثَةَ صُفُوفٍ  .","","Al-Mu'jam al-Kabir 665","","مالك بن هبيرة السكوني عن مرثد بن عبد الله اليزني عن يزيد بن أبي حبيب الأزدي عن محمد بن إسحاق عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","مالك بن هبيرة السكوني"
"17746","مَالِكُ بْنُ عَمْرٍو الْقُشَيْرِيُّ  666  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  هُدْبَةُ بْنُ خَالِدٍ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنْ  مَالِكٍ الْقُشَيْرِيِّ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ أَعْتَقَ رَقَبَةً مُسْلِمَةً فَهِيَ فِدَاؤُهُ مِنَ النَّارِ  ، عَظْمٌ مِنْ عِظَامِ  مُحَرَّرِهِ  بِعَظْمٍ مِنْ عِظَامِهِ  .","","Al-Mu'jam al-Kabir 666","","مالك بن عمرو القشيري عن زرارة بن أوفى عن علي بن زيد بن جدعان عن حماد بن سلمة عن هدبة بن خالد عن عبد الله بن أحمد بن حنبل عن الطبراني","مالك بن عمرو القشيري"
"17747","667  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا         [19/300]      حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنْ  مَالِكِ بْنِ عَمْرٍو الْقُشَيْرِيِّ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَدْرَكَ أَحَدَ وَالِدَيْهِ ثُمَّ لَمْ يُغْفَرْ لَهُ  فَأَبْعَدَهُ  اللهُ ،  وَمَنْ ضَمَّ يَتِيمًا بَيْنَ أَبَوَيْنِ إِلَى طَعَامِهِ وَشَرَابِهِ حَتَّى يُغْنِيَهُ اللهُ وَجَبَتْ لَهُ الْجَنَّةُ  .","","Al-Mu'jam al-Kabir 667","","مالك بن عمرو القشيري عن زرارة بن أوفى عن علي بن زيد بن جدعان عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","مالك بن عمرو القشيري"
"17748","668  -  حَدَّثَنَا  الْمِقْدَامُ بْنُ دَاوُدَ  ، ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَلِيِّ بْنِ زَيْدِ بْنِ جُدْعَانَ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنْ  رَجُلٍ مِنْ قَوْمِهِ يُقَالُ لَهُ  مَالِكٌ أَوْ أَبُو مَالِكٍ  قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ ضَمَّ يَتِيمًا بَيْنَ مُسْلِمِينَ إِلَى طَعَامِهِ وَشَرَابِهِ حَتَّى يَسْتَغْنِيَ عَنْهُ وَجَبَتْ لَهُ الْجَنَّةُ  أَلْبَتَّةَ  ، وَأَيُّمَا رَجُلٍ أَدْرَكَ وَالِدَيْهِ أَوْ أَحَدَهُمَا فَدَخَلَ النَّارَ  فَأَبْعَدَهُ  اللهُ ، وَأَيُّمَا رَجُلٍ مُسْلِمٍ أَعْتَقَ رَقَبَةً مُسْلِمَةً كَانَتْ فِكَاكَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 668","","مالك بن عمرو القشيري عن زرارة بن أوفى عن علي بن زيد بن جدعان عن شعبة بن الحجاج عن أسد السنة عن المقدام بن داود الرعيني عن الطبراني","مالك بن عمرو القشيري"
"17749","669  -  حَدَّثَنَا  أَحْمَدُ بْنُ دَاوُدَ الْمَكِّيُّ وَمُعَاذُ بْنُ الْمُثَنَّى قَالَا :  ثَنَا  يَحْيَى بْنُ كَثِيرٍ  ،  ثَنَا  سُفْيَانُ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنْ  مَالِكِ بْنِ عَمْرِو بْنِ مَالِكٍ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ ضَمَّ يَتِيمًا بَيْنَ أَبَوَيْنِ مُسْلِمِينَ حَتَّى يَسْتَغْنِيَ فَقَدْ أَوْجَبَ اللهُ لَهُ الْجَنَّةَ  أَلْبَتَّةَ  .  كذا في طبعة مكتبة ابن تيمية ، والذي في النسخة الخطية غير واضح وهو أقرب إلى (محمد) إلا أنه كتب أمامه في الهامش : (يحيى) وصحح عليه ، والصواب : (محمد بن كثير) كما عند المصنف في مكارم الأخلاق ، والله أعلم .","","Al-Mu'jam al-Kabir 669","","مالك بن عمرو القشيري عن زرارة بن أوفى عن علي بن زيد بن جدعان عن سفيان الثوري عن محمد بن كثير العبدي عن معاذ بن المثنى العنبري عن الطبراني","مالك بن عمرو القشيري"
"17750","670  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الزَّهْرَانِيُّ ،  ثَنَا  هُشَيْمٌ ،  أَنَا  عَلِيُّ بْنُ زَيْدٍ ،  عَنْ  زُرَارَةَ بْنِ أَوْفَى ،  عَنْ  مَالِكِ بْنِ عَمْرٍو قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ ضَمَّ يَتِيمًا بَيْنَ مُسْلِمِينَ إِلَى طَعَامِهِ وَشَرَابِهِ حَتَّى يَسْتَغْنِيَ عَنْهُ وَجَبَتْ لَهُ الْجَنَّةُ  أَلْبَتَّةَ  ، وَمَنْ أَعْتَقَ امْرَأً مُسْلِمًا كَانَتْ فِكَاكَهُ مِنَ النَّارِ يَفْدِي كُلُّ عُضْوٍ مِنْهُ عُضْوًا مِنْهُ  .","","Al-Mu'jam al-Kabir 670","","مالك بن عمرو القشيري عن زرارة بن أوفى عن علي بن زيد بن جدعان عن هشيم بن بشير عن سليمان بن داود العتكي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","مالك بن عمرو القشيري"
"17751","[19/301]      مَالِكُ بْنُ عَتَاهِيَةَ  671  -  حَدَّثَنَا  أَبُو حَبِيبٍ يَحْيَى بْنُ نَافِعٍ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ ،  عَنْ  مُحْسِنِ بْنِ ظِبْيَانَ  أَنَّهُ سَمِعَ  عَبْدَ الرَّحْمَنِ بْنَ حَسَّانَ ،  أَخْبَرَنِي  رَجُلٌ مِنْ جُذَامٍ  أَنَّهُ سَمِعَ  مَالِكَ بْنَ عَتَاهِيَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنْ لَقِيتُمْ عَشَّارًا فَاقْتُلُوهُ - يَعْنِي بِذَلِكَ الصَّدَقَةَ يَأْخُذُهَا عَلَى غَيْرِ حَقِّهَا  .","","Al-Mu'jam al-Kabir 671","","مالك بن عتاهية التجيبي عن رجل من جذام عن عبد الرحمن بن حسان الكناني عن مخيس بن ظبيان الأوابى عن يزيد بن أبي حبيب الأزدي عن عبد الله بن لهيعة عن سعيد بن الحكم الجمحي عن يحيى بن نافع بن خالد المصري عن الطبراني","مالك بن عتاهية"
"17752","مَالِكُ بْنُ عَوْفٍ النَّصْرِيُّ ، يُكَنَّى أَبَا عَلِيٍّ  672  - حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ  قَالَ : ثَنَا  مُحَمَّدُ بْنُ سَلَّامٍ الْجُمَحِيُّ :  مَالِكُ بْنُ عَوْفِ بْنِ سَعْدِ بْنِ رَبِيعَةَ بْنِ يَرْبُوعِ بْنِ وَاثِلَةَ بْنِ دَهْمَانَ بْنِ نَصْرِ بْنِ مُعَاوِيَةَ بْنِ بَكْرِ بْنِ هَوَازِنَ  ، قَالَ  ابْنُ سَلَّامٍ  : وَكَانَ  مَالِكُ بْنُ عَوْفٍ النَّضْرِيُّ  رَئِيسًا مِقْدَامًا ، كَانَ أَوَّلَ ذِكْرِهِ وَمَا شَهَرَ مِنْ بَلَائِهِ يَوْمُ  الْفِجَارِ  مَعَ قَوْمِهِ ، كَثُرَ صَنِيعُهُ يَوْمَئِذٍ ، وَهُوَ عَلَى  هَوَازِنَ  حِينَ لَقِيَهُمْ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَسَاقَ مَعَ النَّاسِ أَمْوَالَهُمْ وَذَرَارِيَّهُمْ ، فَخَالَفَهُ  دُرَيْدُ بْنُ الصِّمَّةِ  فَلَجَّ وَأَبَى ، فَصَارُوا إِلَى أَمْرِهِ فَلَمْ يَحْمَدُوا رَأْيَهُ ، وَكَانَ يَوْمَئِذٍ رَئِيسَهُمْ ، فَلَمَّا رَأَى هَزِيمَةَ أَصْحَابِهِ قَصَدَ النَّبِيَّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَكَانَ شَدِيدَ الْإِقْدَامِ - لَيُصِيبَهُ ، زَعَمَ ! فَوَافَاهُ  مَرْثَدُ بْنُ أَبِي مَرْثَدٍ الْغَنَوِيُّ  فَقَتَلَهُ وَحَمَلَ فَرَسَهُ مَحَاجَّ فَلَمْ يُقْدِمْ ، ثُمَّ أَرَادَهُ وَصَاحَ بِهِ فَلَمْ يُقْدِمْ ، فَقَالَ :         [19/302]      ثُمَّ شَهِدَ بَعْدَمَا أَسْلَمَ  الْقَادِسِيَّةَ  فَقَالَ :  ثُمَّ انْهَزَمَ مِنْ  حُنَيْنٍ  فَصَارَ إِلَى  الطَّائِفِ ،  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : لَوْ أَتَانِي لَأَمَّنْتُهُ وَأَعْطَيْتُهُ مِائَةً ، فَجَاءَ فَفَعَلَ بِهِ ذَلِكَ وَوَجَّهَهُ إِلَى قِتَالِ  أَهْلِ الطَّائِفِ  ، وَكَتَبَ  سَعْدُ بْنُ أَبِي وَقَّاصٍ  إِلَى  عُمَرَ  - رَضِيَ اللهُ عَنْهُ - يَسْتَمِدُّهُ ، فَكَتَبَ إِلَيْهِ : أَتَسْتَمِدُّنِي وَأَنْتَ فِي عَشْرَةِ آلَافٍ وَمَعَكَ  مَالِكُ بْنُ عَوْفٍ  وَحَنْظَلَةُ بْنُ رَبِيعَةَ  ، وَهُوَ الَّذِي كَانَ يُقَالُ لَهُ  حَنْظَلَةُ الْكَاتِبُ ،  قَالَ  ابْنُ سَلَّامٍ  : فَحَدَّثَنِي بَعْضُ قَوْمِهِ أَنَّهُ قَالَ  لِعُمَرَ بْنِ الْخَطَّابِ  : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَعْطَانِي يَتَأَلَّفُنِي عَلَى الْإِسْلَامِ فَلَمْ أُحِبَّ أَنْ آخُذَ عَلَى الْإِسْلَامِ أَجْرًا ، فَأَنَا أَرُدُّهَا . قَالَ : إِنَّهُ لَمْ يُعْطِهَا إِلَّا وَهُوَ يَرَى أَنَّهَا لَكَ حَقًّا  .","","Al-Mu'jam al-Kabir 672","","","مالك بن عوف النصري يكنى أبا علي"
"17753","673  -  حَدَّثَنَا  أَبُو شُعَيْبٍ عَبْدُ اللهِ بْنُ الْحَسَنِ الْحَرَّانِيُّ  ، ثَنَا  أَبُو جَعْفَرٍ النُّفَيْلِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سَلَمَةَ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ لِوَفْدِ  هَوَازِنَ  بِحُنَيْنٍ  ، وَسَأَلَهُمْ عَنْ  مَالِكِ بْنِ عَوْفٍ النَّضْرِيِّ :  مَاذَا فَعَلَ  مَالِكٌ ؟  قَالَ : هُوَ  بِالطَّائِفِ .  فَقَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : أَخْبِرُوا  مَالِكًا  أَنَّهُ إِنْ يَأْتِنِي مُسْلِمًا رَدَدْتُ إِلَيْهِ أَهْلَهُ وَمَالَهُ وَأَعْطَيْتُهُ مِائَةً مِنَ الْإِبِلِ . فَأُتِيَ  مَالِكٌ  بِذَلِكَ فَخَرَجَ إِلَيْهِ مِنَ  الطَّائِفِ ،  وَكَانَ  مَالِكٌ  خَافَ  ثَقِيفًا  عَلَى نَفْسِهِ أَنْ يَعْلَمُوا أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَدْ قَالَ لَهُ مَا قَالَ فَيَحْبِسُوهُ ، فَأَمَرَ  بِرَاحِلَةٍ  لَهُ فَهُيِّئَتْ ، وَأَمَرَ بِفَرَسٍ لَهُ فَأُتِيَ بِهِ مِنَ  الطَّائِفِ  ، فَخَرَجَ لَيْلًا فَجَلَسَ عَلَى فَرَسِهِ فَلَحِقَ بِرَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَأَدْرَكَهُ  بِالْجِعِرَّانَةِ  أَوْ  مَكَّةَ ،  فَرَدَّ إِلَيْهِ أَهْلَهُ وَمَالَهُ وَأَعْطَاهُ مِائَةً مِنَ الْإِبِلِ  .","","Al-Mu'jam al-Kabir 673","","محمد بن إسحاق عن محمد بن سلمة الباهلي عن عبد الله بن محمد النفيلي عن أبو شعيب الحراني عن الطبراني","مالك بن عوف النصري يكنى أبا علي"
"17754","[19/303]      مَالِكٌ ، أَبُو السَّائِبِ ،  جَدُّ  عَطَاءِ بْنِ السَّائِبِ  674  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ  ، ثَنَا  رَاشِدُ بْنُ سَلَّامٍ الْأَهْوَازِيُّ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ تَمَّامٍ السُّلَمِيُّ ،  عَنْ  مُحَمَّدِ بْنِ تَمَّامٍ ،  حَدَّثَنِي  عَطَاءُ بْنُ السَّائِبِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  مَرَّ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى بِئْرٍ وَإِذَا فِيهَا  أَسْوَدُ مَيِّتٌ ،  قَالَ : فَأَشْرَفَ فِي الْبِئْرِ ، فَإِذَا هُوَ مُلْقًى فِي الْبِئْرِ ، فَسَأَلَ النَّبِيُّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَا لَهُ مُلْقًى فِي الْبِئْرِ ؟  قَالُوا : يَا رَسُولَ اللهِ ، إِنَّهُ كَانَ جَافِيَ الدِّينِ يُصَلِّي أَحْيَانًا وَأَحْيَانًا لَا يُصَلِّي ! قَالَ : وَيْحَكُمْ أَخْرِجُوهُ ! فَأَمَرَ بِهِ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَغُسِّلَ وَكُفِّنَ ، وَقَالَ : احْمِلُوهُ . وَقَالَ : لَقَدْ كَادَتِ الْمَلَائِكَةُ أَنْ تَسْبِقَنَا ! قَالَ : وَصَلَّى عَلَيْهِ  .","","Al-Mu'jam al-Kabir 674","","مالك أبو السائب الثقفي عن السائب بن مالك الثقفي عن عطاء بن السائب عن محمد بن تمام عن عبيد الله بن تمام السلمي عن راشد بن سلام البصري عن سعيد بن عبد الرحمن التستري عن الطبراني","مالك أبو السائب جد عطاء بن السائب"
"17755","675  -  حَدَّثَنَا  سَعِيدُ بْنُ عَبْدِ الرَّحْمَنِ التُّسْتَرِيُّ  ، ثَنَا  رَاشِدُ بْنُ سَلَّامٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ تَمَّامٍ السُّلَمِيُّ ،  عَنْ  مُحَمَّدِ بْنِ تَمَّامٍ ،  حَدَّثَنِي  عَطَاءُ بْنُ السَّائِبِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ لُقِّنَ عِنْدَ الْمَوْتِ شَهَادَةَ أَنْ لَا إِلَهَ إِلَّا اللهُ دَخَلَ الْجَنَّةَ  .","","Al-Mu'jam al-Kabir 675","","مالك أبو السائب الثقفي عن السائب بن مالك الثقفي عن عطاء بن السائب عن محمد بن تمام بن صالح البهراني عن عبيد الله بن تمام السلمي عن راشد بن سلام البصري عن سعيد بن عبد الرحمن التستري عن الطبراني","مالك أبو السائب جد عطاء بن السائب"
"17756","676  -  وَبِإِسْنَادِهِ  عَنْ  عَطَاءِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  دَعُوا النَّاسَ يُصِيبُ بَعْضُهُمْ مِنْ بَعْضٍ ، فَإِذَا اسْتَنْصَحَكَ أَخُوكَ فَانْصَحْ لَهُ  .","","Al-Mu'jam al-Kabir 676","","مالك أبو السائب الثقفي عن السائب بن مالك الثقفي عن عطاء بن السائب عن محمد بن تمام بن صالح البهراني عن عبيد الله بن تمام السلمي عن راشد بن سلام البصري عن سعيد بن عبد الرحمن الديباجي عن الطبراني","مالك أبو السائب جد عطاء بن السائب"
"17757","[19/304]      مَنِ اسْمُهُ مَحْمُودٌ  مَحْمُودُ بْنُ مَسْلَمَةَ الْأَنْصَارِيُّ ، أَخُو مُحَمَّدِ بْنِ مَسْلَمَةَ ،  اسْتُشْهِدَ  يَوْمَ خَيْبَرَ  677  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ  ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ  ، عَنْ  أَبِي الْأَسْوَدِ  ،  عَنْ  عُرْوَةَ  :  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ خَيْبَرَ  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ الْمُسْلِمِينَ  ثُمَّ مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي عَبْدِ الْأَشْهَلِ  مَحْمُودُ بْنُ مَسْلَمَةَ  .","","Al-Mu'jam al-Kabir 677","","","محمود بن مسلمة الأنصاري أخو محمد بن مسلمة"
"17758","678  - حَدَّثَنَا  الْحَسَنُ بْنُ هَارُونَ بْنِ سُلَيْمَانَ الْأَصْبَهَانِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ الْمُسَيِّبِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ فُلَيْحٍ  ، عَنْ  مُوسَى بْنِ عُقْبَةَ  ، عَنِ  ابْنِ شِهَابٍ  :  فِي تَسْمِيَةِ مَنِ اسْتُشْهِدَ  يَوْمَ خَيْبَرَ  مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنَ  الْأَنْصَارِ  ثُمَّ مِنْ  بَنِي حَارِثَةَ  مَحْمُودُ بْنُ مَسْلَمَةَ  .  وَذَكَرُوا  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ  لِمُحَمَّدِ بْنِ مَسْلَمَةَ  :  أَخُوكَ لَهُ أَجْرُ شَهِيدَيْنِ  . وَاللهُ أَعْلَمُ .","","Al-Mu'jam al-Kabir 678","","","محمود بن مسلمة الأنصاري أخو محمد بن مسلمة"
"17759","سِنُّ  مُعَاوِيَةَ  وَوَفَاتُهُ ، وَمِنْ أَخْبَارِهِ :  679  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ  ،         [19/305]      حَدَّثَنِي  اللَّيْثُ  قَالَ :  تُوُفِّيَ  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ  لِأَرْبَعِ لَيَالٍ خَلَوْنَ مِنْ رَجَبٍ سَنَةَ سِتِّينَ  ،  قَالَ  ابْنُ كَثِيرٍ  : وَسِنُّهُ  بِضْعٌ  وَسَبْعُونَ إِلَى الثَّمَانِينَ  .","","Al-Mu'jam al-Kabir 679","","","سن معاوية ووفاته ومن أخباره"
"17760","680  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الْمَدِينِيُّ فُسْتُقَةُ  ، ثَنَا  أَبُو زَيْدٍ عُمَرُ بْنُ شَبَّةَ  ،  عَنْ  أَبِي نُعَيْمٍ  قَالَ :  مَاتَ  مُعَاوِيَةُ  سَنَةَ سِتِّينَ وَسِنُّهُ  بِضْعٌ  وَسَبْعُونَ إِلَى الثَّمَانِينَ  .","","Al-Mu'jam al-Kabir 680","","","سن معاوية ووفاته ومن أخباره"
"17761","681  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ الْبَجَلِيِّ ،  عَنْ  جَرِيرٍ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ يَقُولُ :  مَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  ،  وَأَبُو بَكْرٍ  وَعُمَرُ  وَأَنَا ابْنُ ثَلَاثٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 681","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن عامر بن سعد البجلي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن غندر ربيب شعبة عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17762","682  -  حَدَّثَنَا  وَرْدُ بْنُ أَحْمَدَ بْنِ لَبِيدٍ الْبَيْرُوتِيُّ  ، ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  خَالِدِ بْنِ مَعْدَانَ  قَالَ  :  كَانَ مُعَاوِيَةُ طَوِيلًا أَبْيَضَ أَجْلَحَ  .","","Al-Mu'jam al-Kabir 682","","معاوية بن أبي سفيان عن خالد بن معدان عن ثور بن يزيد الكلاعي عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن محمد بن أحمد بن لبيد عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17763","683  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ  ، ثَنَا  آدَمُ بْنُ أَبِي إِيَاسٍ ،         [19/306]      ثَنَا  ابْنُ أَبِي ذِئْبٍ ،  ثَنَا  مُسْلِمُ بْنُ جُنْدُبٍ ،  عَنْ  أَسْلَمَ مَوْلَى عُمَرَ  قَالَ  :  قَدِمَ عَلَيْنَا مُعَاوِيَةُ وَهُوَ أَبْيَضُ النَّاسِ وَأَجْمَلُهُمْ  .","","Al-Mu'jam al-Kabir 683","","معاوية بن أبي سفيان عن أسلم العدوي مولى عمر بن الخطاب عن مسلم بن جندب الهذلي عن محمد بن عبد الرحمن بن المغيرة عن آدم بن أبي إياس عن هاشم بن مرثد الطيالسي عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17764","684  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  عُبَيْدُ بْنُ يَعِيشَ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  أَبِيهِ  قَالَ  :  رَأَيْتُ مُعَاوِيَةَ  بِالْأَبْطَحِ  أَبْيَضَ الرَّأْسِ وَاللِّحْيَةِ كَأَنَّهُ ثَلْجٌ  .","","Al-Mu'jam al-Kabir 684","","معاوية بن أبي سفيان عن إسحاق بن يسار المازنى عن محمد بن إسحاق عن يونس بن بكير عن عبيد بن يعيش عن محمد بن عبد الله مطين الحضرمي عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17765","685  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مِنْهَابُ بْنُ عَبَّادٍ الْعَبْدِيُّ  ،  ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ بْنِ أَبِي يَزِيدَ الْهَمْدَانِيُّ ،  عَنْ  مُجَالِدٍ ،  عَنِ  الشَّعْبِيِّ  قَالَ  :  خَرَجَ مُعَاوِيَةُ مِنَ  الشَّامِ  يُرِيدُ  مَكَّةَ ،  فَنَزَلَ مَنْزِلًا بَيْنَ  مَكَّةَ  وَالْمَدِينَةِ  يُقَالُ لَهُ  الْأَبْوَاءُ ،  فَاطَّلَعَ فِي بِئْرٍ  عَادِيَّةٍ  فَأَصَابَتْهُ  لَقْوَةٌ  ، فَأَجَدَّ السَّيْرَ حَتَّى قَدِمَ  مَكَّةَ  فَأَتَاهُ  الْحَاجِبُ  ، فَقَالَ : يَا أَمِيرَ الْمُؤْمِنِينَ ، النَّاسُ بِالْبَابِ مَا أَفْقِدُ وَجْهًا ! قَالَ : فَابْسُطْ لِي إِذًا . قَالَ : ثُمَّ دَعَا بِعِمَامَةٍ فَلَفَّ بِهَا رَأْسَهُ وَشَقَّ وَجْهَهُ ، ثُمَّ خَرَجَ فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  أَمَّا بَعْدُ ، فَإِنْ أُعَافَ فَقَدْ عُوفِيَ الصَّالِحُونَ قَبْلِي ، وَمَا أُسِرُّ أَنِّي لَأَرْجُو أَنْ أَكُونَ مِنْهُمْ  ، وَإِنْ كَانَ قَدْ مَرِضَ مِنِّي عُضْوٌ فَمَا أُحْصِي صَحِيحِي ، وَإِنْ كَانَ وَجَدَ عَلَيَّ بَعْضُ خَاصَّتِكُمْ فَقَدْ كُنْتُ حَرْبًا عَلَى عَامَّتِكُمْ ، وَمَا لِي أَنْ أَتَمَنَّى عَلَى اللهِ أَكْثَرَ مِمَّا أَعْطَانِي ، فَرَحِمَ اللهُ رَجُلًا دَعَا لِي بِالْعَافِيَةِ ، فَارْتَجَّتِ الْأَصْوَاتُ بِالدُّعَاءِ فَاسْتَبْكَى ، فَقَالَ لَهُ  مَرْوَانُ  : مَا يُبْكِيكَ يَا أَمِيرَ الْمُؤْمِنِينَ ؟ قَالَ : رَاجَعْتُ مَا كُنْتُ عَنْهُ عَزُوفًا ، كَبِرَتْ سِنِّي ،  وَرَقَّ  عَظْمِي ، وَكَثُرَ الدُّمُوعُ فِي عَيْنِي ، وَرُمِيتُ فِي أَحْسَنِي وَمَا يَبْدُو مِنِّي ، وَلَوْلَا هَوًى مِنِّي فِي  يَزِيدَ  أَبْصَرْتُ قَصْدِي  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( شهاب )","","Al-Mu'jam al-Kabir 685","","معاوية بن أبي سفيان عن الشعبي عن مجالد بن سعيد عن محمد بن الحسن المعشاري عن شهاب بن عباد الرواس عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17766","[19/307]      686  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  الْمُعَلَّى الْقَعْقَاعِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حَبِيبٍ الْخَوْلَانِيُّ ،  عَنْ  أَبِي بَكْرِ بْنِ عَبْدِ اللهِ بْنِ أَبِي مَرْيَمَ الْغَسَّانِيِّ ،  عَنْ  مُحَمَّدِ بْنِ زِيَادٍ الْأَلْهَانِيِّ ،  عَنْ  عَوْفِ بْنِ مَالِكٍ الْأَشْجَعِيِّ قَالَ :  كُنْتُ قَائِلًا فِي كَنِيسَةٍ  بِأَرِيحَا  ، وَهِيَ يَوْمَئِذٍ مَسْجِدٌ يُصَلَّى فِيهِ ، قَالَ : فَانْتَبَهَ  عَوْفُ بْنُ مَالِكٍ  مِنْ نَوْمَتِهِ وَإِذَا مَعَهُ فِي الْبَيْتِ أَسَدٌ يَمْشِي إِلَيْهِ ، فَقَامَ فَزِعًا إِلَى سِلَاحِهِ ، فَقَالَ لَهُ الْأَسَدُ : مَهْ ، إِنَّمَا أُرْسِلْتُ إِلَيْكَ بِرِسَالَةٍ لِتُبَلِّغَهَا ! قُلْتُ : مَنْ أَرْسَلَكَ ؟ قَالَ :  أَرْسَلَنِي إِلَيْكَ اللهُ لِأَنْ تُعْلِمَ مُعَاوِيَةَ الرَّحَّالَ أَنَّهُ مِنْ أَهْلِ الْجَنَّةِ  ! قُلْتُ : مَنْ  مُعَاوِيَةُ  ؟ قَالَ :  ابْنُ أَبِي سُفْيَانَ  .","","Al-Mu'jam al-Kabir 686","","عوف بن مالك بن أبي عوف عن محمد بن زياد الألهاني عن أبو بكر الغساني عن محمد بن حبيب الخولاني عن معلى بن الوليد القنسريني عن يوسف بن يزيد القراطيسي عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17767","687  -  حَدَّثَنَا  قَيْسُ بْنُ مُسْلِمٍ الْبُخَارِيُّ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  سَعِيدُ بْنُ عَبْدِ الْجَبَّارِ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَبْدِ اللهِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  ثَابِتٌ مَوْلَى أَبِي  سُفْيَانَ  قَالَ  :  غَزَوْتُ مَعَ مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  أَرْضَ الرُّومِ ،  فَوَقَعَ ثَلْبٌ فِي رَحْلِهِ فَنَادَى :  يَا عِبَادَ اللهِ الْمُسْلِمِينَ ! فَكَانَ أَوَّلَ مَنْ أَجَابَ  مُعَاوِيَةُ  ، فَنَزَلَ وَنَزَلَ النَّاسُ  ، فَقَالُوا : نَكْفِي الْأَمِيرَ ، فَقَالَ : أَلَا إِنَّهُ بَلَغَنِي أَنَّهُ أَوَّلُ مَنْ يُغِيثُ  جِبْرِيلُ ،  فَأَحْبَبْتُ أَنْ أَكُونَ الثَّانِي  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، والصواب : (مولى سفيان) وينظر مصادر الترجمة ، والله أعلم .","","Al-Mu'jam al-Kabir 687","","معاوية بن أبي سفيان عن ثابت مولى سفيان بن أبي مريم عن أبو بكر الغساني عن سعيد بن عبد الجبار الزبيدي عن قتيبة بن سعيد عن قيس بن مسلم بن منصور البخاري عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17768","688  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  الْحُسَيْنُ بْنُ أَبِي السَّرِيِّ الْعَسْقَلَانِيُّ ،  ثَنَا  زَيْدُ بْنُ أَبِي الزَّرْقَاءِ ،  عَنْ  جَعْفَرِ بْنِ بُرْقَانَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ قَالَ :  قَالَ  عَلِيٌّ :  قَتْلَايَ وَقَتْلَى  مُعَاوِيَةَ  فِي الْجَنَّةِ  .","","Al-Mu'jam al-Kabir 688","","علي بن أبي طالب عن يزيد بن الأصم بن عبيد البكائي عن جعفر بن برقان الكلابي عن زيد بن أبي الزرقاء التغلبي عن الحسين بن أبي السري العسقلاني عن الحسين بن إسحاق التستري عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17769","689  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  يُوسُفُ بْنُ         [19/308]      مُحَمَّدِ بْنِ سَابِقٍ قَالَ :  سَمِعْتُ  أَبَا أُسَامَةَ يَقُولُ :  سَمِعْتُ  مُجَالِدَ بْنَ سَعِيدٍ  يَقُولُ  :  رَحِمَ اللهُ مُعَاوِيَةَ ، مَا كَانَ أَشَدَّ حُبِّهِ لِلْعَرَبِ  .","","Al-Mu'jam al-Kabir 689","","معاوية بن أبي سفيان عن مجالد بن سعيد عن حماد بن أسامة القرشي عن يوسف بن محمد بن سابق القرشي عن الحسين بن إسحاق التستري عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17770","690  -  حَدَّثَنَا  الْقَاسِمُ بْنُ عَبَّادٍ الْخَطَّابِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ،  عَنْ  قَيْسٍ قَالَ :  قَالَ  مُعَاوِيَةُ لِأَخِيهِ :  ارْتَدِفْ ، فَأَبَى ، فَقَالَ : بِئْسَ مَا أُدِّبْتَ  ، فَقَالَ أَبُو سُفْيَانَ : دَعْ أَخَاكَ  .","","Al-Mu'jam al-Kabir 690","","صخر بن حرب رئيس قريش عن قيس بن أبي حازم عن إسماعيل بن أبي خالد عن سفيان بن عيينة عن محمد بن سليمان لوين عن القاسم بن عباد الخطابى عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17771","691  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ  ، ثَنَا  يُوسُفُ بْنُ مُحَمَّدِ بْنِ سَابِقٍ ،  سَمِعْتُ  أَبَا يَحْيَى الْحِمَّانِيَّ يَقُولُ :  سَمِعْتُ  الْأَعْمَشَ  يَقُولُ  :  لَوْ رَأَيْتُمْ مُعَاوِيَةَ لَقُلْتُمْ هَذَا الْمَهْدِيُّ  .","","Al-Mu'jam al-Kabir 691","","معاوية بن أبي سفيان عن الأعمش عن عبد الحميد بن عبد الرحمن بشمين عن يوسف بن محمد بن سابق القرشي عن الحسين بن إسحاق التستري عن الطبراني","سن معاوية ووفاته ومن أخباره"
"17772","مَا  أَسْنَدَ  مُعَاوِيَةُ  رَحِمَهُ اللهُ  الصَّحَابَةُ عَنْهُ  مَا رَوَى  ابْنُ عَبَّاسٍ  عَنْ  مُعَاوِيَةَ  رَحِمَهُمُ اللهُ  692  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  هِشَامُ بْنُ حُجَيْرٍ ،  عَنْ  طَاوُسٍ قَالَ :  سَمِعْتُ  ابْنَ عَبَّاسٍ يَقُولُ :  هَذِهِ حُجَّةٌ عَلَى         [19/309]      مُعَاوِيَةَ قَوْلُهُ :  إِنِّي قَصَّرْتُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  بِمِشْقَصِ  أَعْرَابِيٍّ عِنْدَ  الْمَرْوَةِ  يَقُولُ : حِينَ يَنْهَى عَنِ  الْمُتْعَةِ  .","","Al-Mu'jam al-Kabir 692","","معاوية بن أبي سفيان عن عبد الله بن عباس عن طاوس بن كيسان عن هشام بن حجير الحجازي عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","ما روى ابن عباس عن معاوية رحمهم الله"
"17773","693  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ  ، ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  الْحَسَنُ بْنُ مُسْلِمٍ ،  عَنْ  طَاوُسٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ :  قَصَّرْتُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فِي عُمْرَتِهِ عَلَى  الْمَرْوَةِ  بِمِشْقَصٍ  .","","Al-Mu'jam al-Kabir 693","","معاوية بن أبي سفيان عن عبد الله بن عباس عن طاوس بن كيسان عن الحسن بن مسلم بن يناق عن ابن جريج عن عثمان بن الهيثم بن جهم الأشج عن إبراهيم بن صالح الشيرازي عن الطبراني","ما روى ابن عباس عن معاوية رحمهم الله"
"17774","694  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي ،  ثَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  ابْنِ طَاوُسٍ ،  عَنْ  أَبِيهِ  ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  مُعَاوِيَةَ قَالَ :  قَصَّرْتُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ  الْمَرْوَةِ  بِمِشْقَصٍ  فِي حَجَّتِهِ  .","","Al-Mu'jam al-Kabir 694","","معاوية بن أبي سفيان عن عبد الله بن عباس عن طاوس بن كيسان عن عبد الله بن طاووس عن معمر بن راشد عن عبد الرزاق الصنعاني عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","ما روى ابن عباس عن معاوية رحمهم الله"
"17775","695  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ صَالِحٍ الشِّيرَازِيُّ  ، ثَنَا  عُثْمَانُ بْنُ الْهَيْثَمِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  مُعَاوِيَةَ قَالَ :  قَصَّرْتُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ  الْمَرْوَةِ  بِمِشْقَصٍ  .","","Al-Mu'jam al-Kabir 695","","معاوية بن أبي سفيان عن عبد الله بن عباس عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن ابن جريج عن عثمان بن الهيثم بن جهم الأشج عن إبراهيم بن صالح الشيرازي عن الطبراني","ما روى ابن عباس عن معاوية رحمهم الله"
"17776","696  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ سُوَيْدٍ الشِّيَامِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَلِيِّ بْنِ حُسَيْنٍ ،  عَنِ  ابْنِ عَبَّاسٍ ،  عَنْ  مُعَاوِيَةَ قَالَ :  قَصَّرْتُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى  الْمَرْوَةِ  بِمِشْقَصِ  أَعْرَابِيٍّ  .","","Al-Mu'jam al-Kabir 696","","معاوية بن أبي سفيان عن عبد الله بن عباس عن علي بن الحسين زين العابدين عن أبو جعفر الباقر عن جعفر الصادق عن ابن جريج عن عبد الرزاق الصنعاني عن إبراهيم بن محمد بن عبد الله الشبامي عن الطبراني","ما روى ابن عباس عن معاوية رحمهم الله"
"17777","697  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ (  ح  ) .         [19/310]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ الْعَبَّاسِ الْأَخْرَمُ الْأَصْبَهَانِيُّ  ، ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ الدَّوْرَقِيُّ - قَالُوا :  ثَنَا  مَرْوَانُ بْنُ شُجَاعٍ ،  ثَنَا  خُصَيْفٌ ،  عَنْ  مُجَاهِدٍ وَعَطَاءٍ ،  عَنِ  ابْنِ عَبَّاسٍ أَنَّ مُعَاوِيَةَ  أَخْبَرَهُ  أَنَّهُ رَأَى رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَصَّرَ  مِنْ شَعَرِهِ  بِمِشْقَصٍ  ، قُلْنَا  لِابْنِ عَبَّاسٍ  : مَا بَلَغَنَا هَذَا إِلَّا عَنْ  مُعَاوِيَةَ ،  فَقَالَ  ابْنُ عَبَّاسٍ  : مَا كَانَ  مُعَاوِيَةُ  عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مُتَّهَمًا  .","","Al-Mu'jam al-Kabir 697","","معاوية بن أبي سفيان عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن خصيف الجزري عن مروان بن شجاع الخصيفي عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","ما روى ابن عباس عن معاوية رحمهم الله"
"17778","698  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ  ، ثَنَا  حُمَيْدُ بْنُ يَعِيشَ  ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنِ  الْحَارِثِ بْنِ عَبْدِ الرَّحْمَنِ ،  عَنْ  مُجَاهِدٍ ،  عَنِ  ابْنِ عَبَّاسٍ قَالَ :  قَالَ لِي  مُعَاوِيَةُ : أَرَأَيْتَ مَنْ تَمَتَّعَ وَسَاقَ الْهَدْيَ ، هَلْ يَمَسُّ مِنْ شَعَرِهِ شَيْئًا ؟ فَقُلْتُ : لَا . قَالَ :  فَإِنِّي أَشْهَدُ لَأَخَذْتُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِنْ شَعَرِهِ عِنْدَ  الْمَرْوَةِ  حِينَ فَرَغَ مِنْ طَوَافِهِ  بِمِشْقَصٍ  مِنْ كِنَانَتِهِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( عبيد بن يعيش )","","Al-Mu'jam al-Kabir 698","","معاوية بن أبي سفيان عن عبد الله بن عباس عن مجاهد بن جبر المخزومي عن الحارث بن عبد الرحمن الدوسي عن محمد بن إسحاق عن يونس بن بكير عن عبيد بن يعيش عن محمد بن عثمان بن أبي شيبة عن الطبراني","ما روى ابن عباس عن معاوية رحمهم الله"
"17779","699  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  عُمَرُ بْنُ سَعِيدِ بْنِ أَبِي حُسَيْنٍ ،  عَنْ  عَلِيِّ بْنِ عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  عَنْ  أَبِيهِ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  نَهَى عَنْ لُبْسِ الذَّهَبِ  .","","Al-Mu'jam al-Kabir 699","","معاوية بن أبي سفيان عن عبد الله بن علي بن رفاعة العبشمي عن علي بن عبد الله بن عباس بن عبد المطلب عن عمر بن سعيد النوفلي عن روح بن عبادة القيسي عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","ما روى ابن عباس عن معاوية رحمهم الله"
"17780","700  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  عُمَرُ بْنُ سَعِيدِ بْنِ أَبِي حُسَيْنٍ ،  عَنْ  عَلِيِّ بْنِ عَبْدِ اللهِ بْنِ عَبَّاسٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ  نَهَى عَنْ لُبْسِ الْحُلِيِّ وَالذَّهَبِ  .","","Al-Mu'jam al-Kabir 700","","معاوية بن أبي سفيان عن عبد الله بن علي بن رفاعة العبشمي عن علي بن عبد الله بن عباس بن عبد المطلب عن عمر بن سعيد النوفلي عن روح بن عبادة القيسي عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","ما روى ابن عباس عن معاوية رحمهم الله"
"17781","[19/311]      أَبُو سَعِيدٍ الْخُدْرِيُّ  عَنْ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُمَا  701  -  حَدَّثَنَا  يُوسُفُ بْنُ يَعْقُوبَ الْقَاضِي  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ (  ح  ) .  وَحَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ - قَالَا :  ثَنَا  مَرْحُومُ بْنُ عَبْدِ الْعَزِيزِ الْعَطَّارُ ،  ثَنَا  أَبُو نَعَامَةَ ،  عَنْ  أَبِي عُثْمَانَ النَّهْدِيِّ ،  عَنْ  أَبِي سَعِيدٍ الْخُدْرِيِّ - رَضِيَ اللهُ عَنْهُ -  قَالَ  :  خَرَجَ مُعَاوِيَةُ عَلَى حَلْقَةٍ فِي الْمَسْجِدِ فَقَالَ : مَا أَجْلَسَكُمْ ؟ قَالُوا : جَلَسْنَا نَذْكُرُ اللهَ . قَالَ : آللهِ مَا أَجْلَسَكُمْ إِلَّا ذَلِكَ ؟ قَالُوا : وَاللهِ مَا أَجْلَسَنَا إِلَّا ذَلِكَ . قَالَ : أَمَا إِنِّي لَمْ أَسْتَحْلِفْكُمْ  تُهْمَةً  لَكُمْ ، وَمَا كَانَ أَحَدٌ بِمَنْزِلَتِي مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَقَلَّ عَنْهُ حَدِيثًا مِنِّي ، وَإِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَرَجَ عَلَى حَلْقَةٍ مِنْ أَصْحَابِهِ فَقَالَ : مَا أَجْلَسَكُمْ ؟ قَالُوا : جَلَسْنَا نَذْكُرُ اللهَ وَنَحْمَدُهُ عَلَى مَا هَدَانَا لِلْإِسْلَامِ وَمَنَّ عَلَيْنَا بِكَ . قَالَ : آللهِ مَا أَجْلَسَكُمْ إِلَّا ذَاكَ ؟ قَالُوا :  آللهِ مَا أَجْلَسَنَا إِلَّا ذَلِكَ . قَالَ : أَمَا إِنِّي لَمْ أَسْتَحْلِفْكُمْ  تُهْمَةً  لَكُمْ ، إِنَّهُ أَتَانِي  جِبْرِيلُ  عَلَيْهِ السَّلَامُ فَأَخْبَرَنِي أَنَّ اللهَ عَزَّ وَجَلَّ  يُبَاهِي  بِكُمُ الْمَلَائِكَةَ  .","","Al-Mu'jam al-Kabir 701","","معاوية بن أبي سفيان عن أبو سعيد الخدري عن أبو عثمان النهدي عن عبد ربه السعدي عن مرحوم بن عبد العزيز العطار عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو سعيد الخدري عن معاوية رضي الله عنهما"
"17782","أَبُو الدَّرْدَاءِ  عَنْ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُمَا  702  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ مُصَفَّى ،  ثَنَا  بَقِيَّةُ ،  ثَنَا  بِشْرُ بْنُ جَبَلَةَ ،  عَنْ  أَبِي عَبْدِ الرَّحْمَنِ  أَنَّ  أَبَا الدَّرْدَاءِ         [19/312]      قَالَ كَلِمَةً نَفَعَ اللهُ بِهَا  مُعَاوِيَةَ  ، قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تُفَتِّشُوا النَّاسَ فَتُفْسِدُوهُمْ  .","","Al-Mu'jam al-Kabir 702","","أبو الدرداء عن أبو عبدالرحمن التميمي الشامي عن بشر بن جبلة عن بقية بن الوليد عن محمد بن مصفى بن بهلول عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","أبو الدرداء عن معاوية رضي الله عنهما"
"17783","جَرِيرُ بْنُ عَبْدِ اللهِ الْبَجَلِيُّ  عَنْ  مُعَاوِيَةَ  703  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  يُونُسُ بْنُ أَبِي إِسْحَاقَ ،  عَنْ  أَبِي السَّفَرِ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرٍ ،  عَنْ  مُعَاوِيَةَ قَالَ :  قُبِضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  ، وَقُبِضَ  أَبُو بَكْرٍ  وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ ، وَقُبِضَ  عُمَرُ  وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 703","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن سعيد بن يحمد الهمداني عن يونس بن أبي إسحاق عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","جرير بن عبد الله البجلي عن معاوية"
"17784","704  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  زُهَيْرُ بْنُ مُعَاوِيَةَ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  جَرِيرٍ ،  عَنْ  مُعَاوِيَةَ قَالَ :  قُبِضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 704","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن عامر بن سعد البجلي عن أبو إسحاق السبيعي عن زهير بن معاوية بن حديج عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","جرير بن عبد الله البجلي عن معاوية"
"17785","705  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  أُمَيَّةُ بْنُ خَالِدٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي إِسْحَاقَ ،  عَنْ  عَامِرِ بْنِ سَعْدٍ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ :  مَاتَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  ، وَمَاتَ  أَبُو بَكْرٍ  وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ ، وَمَاتَ  عُمَرُ  وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 705","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن عامر بن سعد البجلي عن أبو إسحاق السبيعي عن شعبة بن الحجاج عن أمية بن خالد الثوباني عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","جرير بن عبد الله البجلي عن معاوية"
"17786","706  -  حَدَّثَنَا  أَحْمَدُ بْنُ مَسْعُودٍ الْمَقْدِسِيُّ  ، ثَنَا  الْهَيْثَمُ بْنُ جَمِيلٍ (  ح  ) .  وَحَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْبَزَّارُ  ، ثَنَا  سَعْدَانُ بْنُ يَزِيدَ ،  ثَنَا  الْهَيْثَمُ بْنُ جَمِيلٍ ،  ثَنَا  شَرِيكُ بْنُ عَبْدِ اللهِ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنِ  الشَّعْبِيِّ ،  عَنْ  جَرِيرِ بْنِ عَبْدِ اللهِ ،  عَنْ  مُعَاوِيَةَ قَالَ :  قُبِضَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ ، وَقُبِضَ  أَبُو بَكْرٍ  وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ ، وَقُبِضَ  عُمَرُ  وَهُوَ ابْنُ ثَلَاثٍ وَسِتِّينَ  .","","Al-Mu'jam al-Kabir 706","","معاوية بن أبي سفيان عن جرير بن عبد الله بن جابر يوسف الأمة عن الشعبي عن سماك بن حرب البكري عن شريك بن عبد الله النخعي عن الهيثم بن جميل الأنطاكي عن سعدان بن يزيد البغدادي عن البزار عن الطبراني","جرير بن عبد الله البجلي عن معاوية"
"17787","النُّعْمَانُ بْنُ بَشِيرٍ الْأَنْصَارِيُّ  عَنْ  مُعَاوِيَةَ  707  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ         [19/313]      الشَّاذَكُونِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ الْوَاقِدِيُّ ،  ثَنَا  مُوسَى بْنُ عُمَرَ الْحَازِمِيُّ ،  عَنْ  مُوسَى بْنِ سَهْلٍ ،  عَنْ  يَزِيدَ بْنِ النُّعْمَانِ بْنِ بَشِيرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ اللهَ عَزَّ وَجَلَّ جَعَلَ  الْحَقَّ  عَلَى لِسَانِ  عُمَرَ  وَقَلْبِهِ  .","","Al-Mu'jam al-Kabir 707","","معاوية بن أبي سفيان عن النعمان بن بشير الأنصاري عن يزيد بن النعمان بن بشير الشامي عن موسى بن سهل عن موسى بن عمر الحازمي عن الواقدي عن الشاذكوني عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","النعمان بن بشير الأنصاري عن معاوية"
"17788","عَبْدُ اللهِ بْنُ عَمْرِو بْنِ الْعَاصِ  عَنْ  مُعَاوِيَةَ  708  -  حَدَّثَنَا  الْقَاسِمُ بْنُ زَكَرِيَّا وَعَبْدُ اللهِ بْنُ أَحْمَدَ وَعَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ، قَالُوا :  ثَنَا  بِشْرُ بْنُ مُعَاذٍ الْعَقَدِيُّ ،  ثَنَا  أَبُو الْمُطَرِّفِ الْمُغِيرَةُ بْنُ مُطَرِّفٍ الْوَاسِطِيُّ ،  ثَنَا  هِشَامُ بْنُ عُرْوَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  عَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ ،  عَنْ  مُعَاوِيَةَ قَالَ :  خَطَبَنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَوْمَ عَاشُورَاءَ فَقَالَ :  هَذَا يَوْمٌ لَمْ يُكْتَبْ عَلَيْكُمْ صِيَامُهُ ، وَأَنَا صَائِمٌ ، فَمَنْ شَاءَ أَنْ يَصُومَ فَلْيَصُمْ ، وَمَنْ شَاءَ أَنْ يُفْطِرَ فَلْيُفْطِرْ  .","","Al-Mu'jam al-Kabir 708","","معاوية بن أبي سفيان عن عبد الله بن عمرو بن العاص عن عروة بن الزبير عن هشام بن عروة بن الزبير عن مغيرة بن مطرف الواسطي عن بشر بن معاذ عن علي بن سعيد بن بشير عليك عن الطبراني","عبد الله بن عمرو بن العاص عن معاوية"
"17789","وَائِلُ بْنُ حُجْرٍ الْحَضْرَمِيُّ  عَنْ  مُعَاوِيَةَ  أَبُو عَامِرٍ الْأَشْعَرِيُّ  عَنْ  مُعَاوِيَةَ  709  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ النَّشِيطِيُّ (  ح  ) .         [19/314]      وَحَدَّثَنَا  أَحْمَدُ بْنُ سَهْلِ بْنِ أَيُّوبَ الْأَهْوَازِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ أَبِي بَكْرٍ الْعَتَكِيُّ  - قَالَا : ثَنَا  جَرِيرُ بْنُ حَازِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ مَلَاذٍ ،  عَنْ  نُمَيْرِ بْنِ أَوْسٍ ،  عَنْ  مَالِكِ بْنِ مَسْرُوحٍ ،  عَنْ  عَامِرِ بْنِ أَبِي عَامِرٍ الْأَشْعَرِيِّ ،  عَنْ  أَبِيهِ  قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  نِعْمَ الْحَيُّ  الْأَزْدُ  وَالْأَشْعَرِيُّونَ  ! فَقَالَ مُعَاوِيَةُ : لَيْسَ هَكَذَا ! قَالَ : إِنَّمَا قَالَ : هُمْ مِنِّي وَإِلَيَّ  .","","Al-Mu'jam al-Kabir 709","","معاوية بن أبي سفيان عن عامر بن أبي عامر الأشعري عن مالك بن مسروح الشامي عن نمير بن أوس الأشعري عن عبد الله بن ملاذ الأشعري عن جرير بن حازم عن عبد الله بن أبي بكر العتكي عن أحمد بن سهل بن أيوب الأهوازي عن الطبراني","وائل بن حجر الحضرمي عن معاوية - أبو عامر الأشعري عن معاوية"
"17790","عَبْدُ اللهِ بْنُ الزُّبَيْرِ  عَنْ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُمَا  710  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ الْبَغْدَادِيُّ  ، ثَنَا  الْهَيْثَمُ بْنُ مَرْوَانَ الدِّمَشْقِيُّ ،  ثَنَا  زَيْدُ بْنُ يَحْيَى بْنِ عُبَيْدٍ ،  ثَنَا  سَعِيدُ بْنُ بِشْرٍ ،  عَنْ  أَبِي بِشْرٍ ،  عَنْ  سَعِيدِ بْنِ جُبَيْرٍ  أَنَّ  عَبْدَ اللهِ بْنَ الزُّبَيْرِ  قَالَ  لِمُعَاوِيَةَ فِي الْكَلَامِ الَّذِي جَرَى بَيْنَهُمَا فِي بَيْعَةِ  يَزِيدَ  : وَأَنْتَ يَا  مُعَاوِيَةُ  أَخْبَرْتَنِي أَنَّ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  إِذَا كَانَ فِي الْأَرْضِ خَلِيفَتَانِ فَاقْتُلُوا أَحَدَهُمَا  .","","Al-Mu'jam al-Kabir 710","","معاوية بن أبي سفيان عن عبد الله بن الزبير عن سعيد بن جبير الأسدي عن جعفر بن إياس اليشكري عن سعيد بن بشير الأزدي عن زيد بن يحيى بن عبيد الخزاعي عن الهيثم بن مروان بن الهيثم العنسي عن أحمد بن محمد بن عبد الله البغدادي عن الطبراني","عبد الله بن الزبير عن معاوية رضي الله عنهما"
"17791","أُسَيْدُ بْنُ ظُهَيْرٍ  عَنْ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُمَا  عَبْدُ الرَّحْمَنِ بْنُ شِبْلٍ  عَنْ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُمَا  711  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ الْبَصْرِيُّ  ، ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  زَيْدِ بْنِ سَلَّامٍ ،  عَنْ  أَبِي         [19/315]      سَلَّامٍ ،  عَنْ  أَبِي رَاشِدٍ الْحُبْرَانِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ شِبْلٍ  أَنَّ  مُعَاوِيَةَ قَالَ :  إِذَا أَتَيْتَ  فُسْطَاطِي  فَقُمْ فِي النَّاسِ فَأَخْبِرْهُمْ مَا سَمِعْتُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ  التُّجَّارَ  هُمُ  الْفُجَّارُ  . فَقَالَ  رَجُلٌ  : يَا رَسُولَ اللهِ ، أَلَمْ يُحِلَّ اللهُ الْبَيْعَ ؟ فَقَالَ : إِنَّهُمْ يَقُولُونَ فَيَكْذِبُونَ ، وَيَحْلِفُونَ فَيَأْثَمُونَ  .","","Al-Mu'jam al-Kabir 711","","معاوية بن أبي سفيان عن عبد الرحمن بن شبل الأوسي عن أخضر الحبراني عن ممطور الحبشي عن زيد بن سلام الحبشي عن يحيى بن أبي كثير عن أبان بن يزيد العطار عن موسى بن إسماعيل التبوذكي عن محمد بن يحيى بن المنذر القزاز عن الطبراني","أسيد بن ظهير عن معاوية رضي الله عنهما - عبد الرحمن بن شبل عن معاوية رضي الله عنهما"
"17792","السَّائِبُ بْنُ يَزِيدَ  عَنْ  مُعَاوِيَةَ  712  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  ابْنُ جُرَيْجٍ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  هَوْذَةُ بْنُ خَلِيفَةَ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  أَخْبَرَنِي  عُمَرُ بْنُ أَبِي الْخُوَارِ  أَنَّ  نَافِعَ بْنَ جُبَيْرٍ  أَرْسَلَهُ إِلَى السَّائِبِ بْنِ يَزِيدَ يَسْأَلُهُ عَنْ شَيْءٍ رَآهُ مِنْهُ مُعَاوِيَةُ فِي الصَّلَاةِ ، فَقَالَ : صَلَّيْتُ مَعَهُ الْجُمُعَةَ فِي الْمَقْصُورَةِ ، فَلَمَّا سَلَّمَ قُمْتُ فِي مَقَامِي فَصَلَّيْتُ ، فَلَمَّا دَخَلَ أَرْسَلَ إِلَيَّ فَقَالَ : لَا تَعُدْ لِمَا فَعَلْتَ ،  إِذَا صَلَّيْتَ الْجُمُعَةَ فَلَا تَصِلْهَا بِصَلَاةٍ حَتَّى تَتَكَلَّمَ أَوْ تَخْرُجَ ، فَإِنَّ نَبِيَّ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَمَرَ بِذَلِكَ  . زَادَ  هَوْذَةُ  فِي حَدِيثِهِ : أَلَّا تُوصَلَ بِصَلَاةٍ حَتَّى تَتَكَلَّمَ أَوْ تَخْرُجَ  .","","Al-Mu'jam al-Kabir 712","","معاوية بن أبي سفيان عن السائب بن يزيد الكندي عن عمر بن عطاء بن أبي الخوار العامري عن ابن جريج عن هوذة بن خليفة البكراوي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","السائب بن يزيد عن معاوية"
"17793","713  -  حَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  أَخِي  ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ السَّائِبِ ،  عَنْ  أَبِيهِ         [19/316]      قَالَ :  أَرْسَلَ إِلَيَّ مُعَاوِيَةُ بَعْدَ الْعَصْرِ فَقَالَ : أَيْنَ كُنْتَ ؟ قُلْتُ : كُنْتُ أُصَلِّي ، فَقَالَ :  تُصَلِّي بَعْدَ الْعَصْرِ ؟ فَقُلْتُ : نَعَمْ ، فَقَالَ  مُعَاوِيَةُ  : فَلَا تَفْعَلْ ، فَإِنِّي أَعْلَمُ بِرَسُولِ اللهِ  صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 713","","معاوية بن أبي سفيان عن السائب بن يزيد الكندي عن عبد الله بن السائب بن يزيد الكندي عن محمد بن عبد الرحمن بن المغيرة عن عبد الحميد بن أبي أويس الأعشى عن إسماعيل بن أبي أويس عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","السائب بن يزيد عن معاوية"
"17794","714  -  حَدَّثَنَا  مَسْعَدَةُ بْنُ سَعْدٍ الْعَطَّارُ  ، ثَنَا  إِبْرَاهِيمُ بْنُ الْمُنْذِرِ الْحِزَامِيُّ ،  ثَنَا  دَاوُدُ بْنُ عَطَاءٍ ،  عَنِ  ابْنِ أَبِي ذِئْبٍ ،  عَنْ  عَبْدِ اللهِ بْنِ السَّائِبِ ، عَنْ أَبِيهِ  أَنَّهُ أَخْبَرَهُ  أَنَّ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ نَهَى عَنِ السَّجْدَتَيْنِ تُصَلَّيَانِ بَعْدَ الْجُمُعَةِ فِي الْمَسْجِدِ  وَالسَّجْدَتَيْنِ بَعْدَ الْعَصْرِ ، يَقُولُ  مُعَاوِيَةُ :  وَأَنَا أَعْلَمُ بِصَلَاةِ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 714","","معاوية بن أبي سفيان عن السائب بن يزيد الكندي عن عبد الله بن السائب بن يزيد الكندي عن محمد بن عبد الرحمن بن المغيرة عن داود بن عطاء المزني عن إبراهيم بن المنذر الحزامي عن مسعدة بن سعد المكي عن الطبراني","السائب بن يزيد عن معاوية"
"17795","715  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو غَسَّانَ أَحْمَدُ بْنُ سَهْلٍ السُّكَّرِيُّ الْأَهْوَازِيُّ  ، ثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ - قَالَا :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  النُّعْمَانِ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ يَخْطُبُ  بِالْمَدِينَةِ  عَلَى مِنْبَرِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَفِي يَدِهِ  قُصَّةٌ  مِنْ شَعَرٍ ، فَقَالَ : أَيْنَ عُلَمَاؤُكُمْ يَا  أَهْلَ الْمَدِينَةِ ؟  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْ هَذِهِ ، وَقَالَ : إِنَّمَا هَلَكَ الَّذِينَ مِنْ قَبْلِكُمْ حِينَ اتَّخَذَهَا نِسَاؤُهُمْ  .","","Al-Mu'jam al-Kabir 715","","معاوية بن أبي سفيان عن السائب بن يزيد الكندي عن الزهري عن النعمان بن راشد الجزري عن جرير بن حازم عن وهب بن جرير بن حازم عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","السائب بن يزيد عن معاوية"
"17796","716  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ (  ح  ) .         [19/317]      وَحَدَّثَنَا  أَبُو غَسَّانَ أَحْمَدُ بْنُ سَهْلٍ الْأَهْوَازِيُّ  ، ثَنَا  الْجَرَّاحُ بْنُ مَخْلَدٍ - قَالَا :  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  النُّعْمَانِ بْنِ رَاشِدٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنِ  السَّائِبِ بْنِ يَزِيدَ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ يَخْطُبُ يَقُولُ : يَا  أَهْلَ الْمَدِينَةِ ،  أَيْنَ عُلَمَاؤُكُمْ ؟ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  هَذَا يَوْمُ عَاشُورَاءَ ، وَلَمْ يَفْرِضِ اللهُ صِيَامَهُ ، وَأَنَا صَائِمٌ ، فَمَنْ أَحَبَّ أَنْ يَصُومَ فَلْيَصُمْ  ، وَمَنْ أَحَبَّ أَنْ يُفْطِرَ فَلْيُفْطِرْ  .","","Al-Mu'jam al-Kabir 716","","معاوية بن أبي سفيان عن السائب بن يزيد الكندي عن الزهري عن النعمان بن راشد الجزري عن جرير بن حازم عن وهب بن جرير بن حازم عن محمد بن أبي بكر المقدمي عن عبد الله بن أحمد بن حنبل عن الطبراني","السائب بن يزيد عن معاوية"
"17797","سَبْرَةُ بْنُ مَعْبَدٍ الْجُهَنِيُّ  عَنْ  مُعَاوِيَةَ  717  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ نَصْرٍ أَبُو جَعْفَرٍ التِّرْمِذِيُّ  ، ثَنَا  الْحَارِثُ بْنُ مَعْبَدِ بْنِ عَبْدِ الْعَزِيزِ بْنِ الرَّبِيعِ بْنِ سَبْرَةَ الْجُهَنِيُّ ،  حَدَّثَنِي  عَمِّي حَرْمَلَةُ بْنُ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ سَبْرَةَ بْنِ مَعْبَدٍ  قَالَ :  قَالَ  عِمْرَانُ بْنُ حُصَيْنٍ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  جُهَيْنَةُ  مِنِّي وَأَنَا مِنْهُمْ ، غَضِبُوا لِغَضَبِي وَرَضُوا لِرِضَايَ  ، أَغْضَبُ لِغَضَبِهِمْ وَأَرْضَى لِرِضَاهُمْ ، فَمَنْ أَغْضَبَهُمْ فَقَدْ أَغْضَبَنِي ، وَمَنْ أَغْضَبَنِي فَقَدْ أَغْضَبَ اللهَ . فَقَالَ لَهُ  مُعَاوِيَةُ  : إِنَّمَا قَالَ هَذَا الْحَدِيثَ فِي  قُرَيْشٍ .  فَقَالَ  عِمْرَانُ  : أَنَا سَمِعْتُهُ مِنَ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَأَنْتَ يَوْمَئِذٍ مَيْتٌ  .","","Al-Mu'jam al-Kabir 717","","عمران بن حصين بن عبيد بن خلف الخزاعي عن سبرة بن معبد الجهني عن عبد العزيز بن الربيع الجهني عن حرملة بن عبد العزيز الجهني عن الحارث بن معبد بن عبد العزيز بن الربيع بن سبرة الجهني عن محمد بن أحمد بن نصر الترمذي عن الطبراني","سبرة بن معبد الجهني عن معاوية"
"17798","يَزِيدُ بْنُ جَارِيَةَ الْأَنْصَارِيُّ  عَنْ  مُعَاوِيَةَ  718  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  يَزِيدُ بْنُ هَارُونَ ،         [19/318]      ثَنَا  يَحْيَى بْنُ سَعِيدٍ الْأَنْصَارِيُّ (  ح  ) .  وَحَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  أَخْبَرَنِي  سَعْدُ بْنُ إِبْرَاهِيمَ ،  عَنِ  الْحَكَمِ بْنِ مِينَاءَ ،  عَنْ  يَزِيدَ بْنِ جَارِيَةَ الْأَنْصَارِيِّ قَالَ :  كُنَّا جُلُوسًا حَوْلَ سَرِيرِ مُعَاوِيَةَ ، فَخَرَجَ إِلَيْنَا فَقَالَ : مَا كُنْتُمْ تَتَحَدَّثُونَ ؟ قَالُوا : كُنَّا فِي حَدِيثٍ مِنْ حَدِيثِ  الْأَنْصَارِ .  فَقَالَ  مُعَاوِيَةُ  : أَلَا أَزِيدُكُمْ حَدِيثًا سَمِعْتُهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ أَحَبَّ  الْأَنْصَارَ  أَحَبَّهُ اللهُ ، وَمَنْ أَبْغَضَ  الْأَنْصَارَ  أَبْغَضَهُ اللهُ  .","","Al-Mu'jam al-Kabir 718","","معاوية بن أبي سفيان عن يزيد بن جارية الأنصاري عن الحكم بن ميناء الأنصاري عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن يحيى بن سعيد الأنصاري عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","يزيد بن جارية الأنصاري عن معاوية"
"17799","مُعَاوِيَةُ بْنُ حُدَيْجٍ  عَنْ  مُعَاوِيَةَ  أَبُو أُمَامَةَ بْنُ سَهْلِ بْنِ حُنَيْفٍ  عَنْ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُ  719  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  مُجَمِّعُ بْنُ يَحْيَى الْأَنْصَارِيُّ ،  حَدَّثَنِي  أَبُو أُمَامَةَ بْنُ سَهْلِ بْنِ حُنَيْفٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ إِذَا كَبَّرَ الْمُؤَذِّنُ اثْنَتَيْنِ كَبَّرَ اثْنَتَيْنِ ، وَإِذَا شَهِدَ اثْنَتَيْنِ شَهِدَ اثْنَتَيْنِ . فَالْتَفَتَ إِلَيَّ فَقَالَ :  هَكَذَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ عِنْدَ الْأَذَانِ  .","","Al-Mu'jam al-Kabir 719","","معاوية بن أبي سفيان عن أسعد بن سهل بن حنيف عن مجمع بن يحيى بن زيد الأنصاري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","معاوية بن حديج عن معاوية - أبو أمامة بن سهل بن حنيف عن معاوية رضي الله عنه"
"17800","720  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ عُيَيْنَةَ ،  عَنْ  مُجَمِّعٍ الْأَنْصَارِيِّ  أَنَّهُ سَمِعَ  أَبَا أُمَامَةَ بْنَ سَهْلِ بْنِ حُنَيْفٍ  حِينَ سَمِعَ الْمُؤَذِّنَ كَبَّرَ كَبَّرَ وَتَشَهَّدَ بِمَا تَشَهَّدَ بِهِ ، ثُمَّ قَالَ : هَكَذَا  حَدَّثَنَا  مُعَاوِيَةُ أَنَّهُ         [19/319]      سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ كَمَا قَالَ الْمُؤَذِّنُ ،  فَإِذَا قَالَ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ - قَالَ : وَأَنَا أَشْهَدُ .  ثُمَّ سَكَتَ  .","","Al-Mu'jam al-Kabir 720","","معاوية بن أبي سفيان عن أسعد بن سهل بن حنيف عن مجمع بن يحيى بن زيد الأنصاري عن سفيان بن عيينة عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","معاوية بن حديج عن معاوية - أبو أمامة بن سهل بن حنيف عن معاوية رضي الله عنه"
"17801","721  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  أَبِي بَكْرِ بْنِ عُثْمَانَ بْنِ سَهْلِ بْنِ حُنَيْفٍ قَالَ :  سَمِعْتُ  أَبَا أُمَامَةَ بْنَ سَهْلِ بْنِ حُنَيْفٍ يَقُولُ :  سَمِعْتُ  مُعَاوِيَةَ وَهُوَ عَلَى الْمِنْبَرِ جَالِسٌ ، فَأَذَّنَ الْمُؤَذِّنُ اللهُ أَكْبَرَ ، فَقَالَ  مُعَاوِيَةُ  : اللهُ أَكْبَرُ  ، ثُمَّ ذَكَرَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ  .","","Al-Mu'jam al-Kabir 721","","معاوية بن أبي سفيان عن أسعد بن سهل بن حنيف عن أبو بكر بن عثمان بن سهل بن حنيف الأوسي عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","معاوية بن حديج عن معاوية - أبو أمامة بن سهل بن حنيف عن معاوية رضي الله عنه"
"17802","722  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  يُوسُفُ بْنُ مُوسَى الْقَطَّانُ ،  ثَنَا  جَرِيرٌ ،  عَنْ  مِسْعَرِ بْنِ كِدَامٍ ،  عَنْ  مُجَمِّعِ بْنِ يَحْيَى ،  عَنْ  أَبِي أُمَامَةَ بْنِ سَهْلِ بْنِ حُنَيْفٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَسَمِعَ الْمُؤَذِّنَ فَقَالَ مِثْلَ مَا قَالَ  .","","Al-Mu'jam al-Kabir 722","","معاوية بن أبي سفيان عن أسعد بن سهل بن حنيف عن مجمع بن يحيى بن زيد الأنصاري عن مسعر بن كدام عن جرير بن عبد الحميد عن يوسف بن موسى بن راشد عن أحمد بن يحيى بن زهير التستري عن الطبراني","معاوية بن حديج عن معاوية - أبو أمامة بن سهل بن حنيف عن معاوية رضي الله عنه"
"17803","مَنْ رَوَى عَنْ  مُعَاوِيَةَ  مِنْ تَابِعِي  الْمَدِينَةِ  مَرْوَانُ بْنُ الْحَكَمِ  عَنْ  مُعَاوِيَةَ  723  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ بْنِ مُسَاوِرٍ الْجَوْهَرِيُّ  ، ثَنَا  عَفَّانُ (  ح  ) .  وَحَدَّثَنَا  الْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ  ، ثَنَا  سَعِيدُ بْنُ سُلَيْمَانَ النَّشِيطِيُّ - قَالَا :  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَلِيِّ بْنِ زَيْدٍ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مَرْوَانَ بْنِ الْحَكَمِ قَالَ :  دَخَلْتُ مَعَ مُعَاوِيَةَ عَلَى عَائِشَةَ أُمِّ الْمُؤْمِنِينَ ،  فَقَالَتْ  : يَا  مُعَاوِيَةُ ،  قَتَلْتَ  حُجْرًا  وَأَصْحَابَهُ ، وَفَعَلْتَ الَّذِي فَعَلْتَ ، أَمَا خَشِيتَ أَنْ أُخَبِّئَ لَكَ رَجُلًا فَيَقْتُلَكَ  بِمُحَمَّدِ بْنِ أَبِي بَكْرٍ ؟  قَالَ : لَا ، إِنِّي فِي بَيْتِ أَمْنٍ ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْإِيمَانُ  قَيْدُ  الْفَتْكِ ،  لَا يَفْتِكُ مُؤْمِنٌ  ،  يَا أُمَّ         [19/320]      الْمُؤْمِنِينَ كَيْفَ أَنَا فِي حَاجَاتِكِ وَرُسُلِكِ وَأَمْرِكِ ؟ قَالَتْ : صَالِحٌ ، قَالَ : فَدَعِينِي  وَحُجْرًا  حَتَّى نَلْتَقِيَ عِنْدَ اللهِ  .","","Al-Mu'jam al-Kabir 723","","معاوية بن أبي سفيان عن مروان بن الحكم بن أبي العاص عن سعيد بن المسيب عن علي بن زيد بن جدعان عن حماد بن سلمة عن سعيد بن سليمان النشيطي عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","مروان بن الحكم عن معاوية"
"17804","724  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَدَقَةَ  ، ثَنَا  مُحَمَّدُ بْنُ خَالِدِ بْنِ خَلِيٍّ الْحِمْصِيُّ ،  ثَنَا  أَبِي  ،  عَنْ  بَقِيَّةَ بْنِ الْوَلِيدِ ،  عَنْ  مُبَشِّرِ بْنِ عُبَيْدٍ ،  عَنْ  بِشْرِ بْنِ عُبَيْدٍ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ سَرَّهُ إِذَا رَأَتْهُ الرِّجَالُ مُقْبِلًا أَنْ يَتَمَثَّلُوا لَهُ قِيَامًا  فَلْيَتَبَوَّأْ  بَيْتًا فِي النَّارِ  .","","Al-Mu'jam al-Kabir 724","","معاوية بن أبي سفيان عن مروان بن الحكم بن أبي العاص عن عبد العزيز بن مروان بن الحكم الأموي عن عمر بن عبد العزيز بن مروان عن بشر بن عبيد الدارسي عن مبشر بن عبيد الحمصي عن بقية بن الوليد عن خالد بن خلي الكلاعي عن محمد بن خالد بن خلي الكلاعي عن أحمد بن محمد بن عبد الله البغدادي عن الطبراني","مروان بن الحكم عن معاوية"
"17805","سَعِيدُ بْنُ الْمُسَيِّبِ  عَنْ  مُعَاوِيَةَ  725  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ وَجَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ قَالَا :  ثَنَا  إِبْرَاهِيمُ بْنُ الْحَجَّاجِ السَّامِيُّ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  هِشَامِ بْنِ أَبِي عَبْدِ اللهِ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مُعَاوِيَةَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الزُّورِ ، وَالزُّورُ أَنْ تَصِلَ الْمَرْأَةُ شَعَرَهَا  .","","Al-Mu'jam al-Kabir 725","","معاوية بن أبي سفيان عن سعيد بن المسيب عن قتادة بن دعامة عن هشام الدستوائي عن حماد بن سلمة عن إبراهيم بن الحجاج السامي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","سعيد بن المسيب عن معاوية"
"17806","726  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ الْبَغَوِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ أَبِي بَكْرٍ الْمُقَدَّمِيُّ ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مُعَاوِيَةَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الزُّورِ  .","","Al-Mu'jam al-Kabir 726","","معاوية بن أبي سفيان عن سعيد بن المسيب عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن محمد بن أبي بكر المقدمي عن إبراهيم بن هاشم البغوي عن الطبراني","سعيد بن المسيب عن معاوية"
"17807","727  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  يَعْقُوبَ بْنِ الْقَعْقَاعِ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ  أَنَّ         [19/321]      مُعَاوِيَةَ قَالَ :  يَا أَيُّهَا النَّاسُ ، إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَاكُمْ عَنِ الزُّورِ  ، فَجَاءَ بِخِرْقَةٍ سَوْدَاءَ فَأَلْقَاهَا بَيْنَ أَيْدِيهِمْ ، ثُمَّ قَالَ : هُوَ هَذَا تَجْعَلُهُ الْمَرْأَةُ فِي رَأْسِهَا ثُمَّ تَخْتَمِرُ عَلَيْهِ  .","","Al-Mu'jam al-Kabir 727","","معاوية بن أبي سفيان عن سعيد بن المسيب عن قتادة بن دعامة عن يعقوب بن القعقاع الأزدي عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","سعيد بن المسيب عن معاوية"
"17808","728  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْقَاسِمِ الْجَوْهَرِيُّ  ، ثَنَا  عَفَّانُ ،  ثَنَا  شُعْبَةُ ،  عَنْ  عَمْرِو بْنِ مُرَّةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ قَالَ :  قَدِمَ مُعَاوِيَةُ  الْمَدِينَةَ  فَقَامَ عَلَى الْمِنْبَرِ وَفِي يَدِهِ عِقْصَةٌ مِنْ شَعَرٍ ، فَقَالَ :  مَا كُنْتُ أَرَى أَحَدًا يَصْنَعُ هَذَا ، لِأَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - سَمَّاهُ الزُّورَ  .","","Al-Mu'jam al-Kabir 728","","معاوية بن أبي سفيان عن سعيد بن المسيب عن عمرو بن مرة المرادي عن شعبة بن الحجاج عن عفان بن مسلم الصفار عن أحمد بن القاسم بن مساور الجوهري عن الطبراني","سعيد بن المسيب عن معاوية"
"17809","729  -  حَدَّثَنَا  أَحْمَدُ بْنُ النَّضْرِ الْعَسْكَرِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ سَلَمَةَ الْخَبَائِرِيُّ ،  ثَنَا  زَيْدُ بْنُ يَحْيَى بْنِ عُبَيْدٍ ،  عَنْ  سَعِيدِ بْنِ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  سَعِيدِ بْنِ الْمُسَيِّبِ ،  عَنْ  مُعَاوِيَةَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 729","","معاوية بن أبي سفيان عن سعيد بن المسيب عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن زيد بن يحيى بن عبيد الخزاعي عن سليمان بن سلمة الخبائري عن أحمد بن النضر بن بحر العسكري عن الطبراني","سعيد بن المسيب عن معاوية"
"17810","عَلْقَمَةُ بْنُ وَقَّاصٍ اللَّيْثِيُّ  عَنْ  مُعَاوِيَةَ  730  -  حَدَّثَنَا  أَبُو حَبِيبٍ يَحْيَى بْنُ نَافِعٍ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  دَاوُدُ بْنُ عَبْدِ الرَّحْمَنِ الْعَطَّارُ ،  حَدَّثَنِي  عَمْرُو بْنُ يَحْيَى ،  عَنْ  عَبْدِ اللهِ بْنِ عَلْقَمَةَ بْنِ وَقَّاصٍ ،  عَنْ  أَبِيهِ  قَالَ :  كُنْتُ جَالِسًا مَعَ مُعَاوِيَةَ ، فَلَمَّا أَذَّنَ الْمُؤَذِّنُ فَقَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، قَالَ  مُعَاوِيَةُ  : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ  ، ثُمَّ قَالَ الْمُؤَذِّنُ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَقَالَ  مُعَاوِيَةُ  : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، ثُمَّ قَالَ الْمُؤَذِّنُ :  حَيَّ  عَلَى الصَّلَاةِ ، فَقَالَ  مُعَاوِيَةُ  : لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، ثُمَّ قَالَ :  حَيَّ  عَلَى  الْفَلَاحِ  ، فَقَالَ  مُعَاوِيَةُ  : لَا  حَوْلَ  وَلَا قُوَّةَ         [19/322]      إِلَّا بِاللهِ ، ثُمَّ قَالَ : اللهُ أَكْبَرُ اللهُ أَكْبَرُ ، فَقَالَ  مُعَاوِيَةُ  : اللهُ أَكْبَرُ اللهُ أَكْبَرُ ، ثُمَّ قَالَ : لَا إِلَهَ إِلَّا اللهُ ، فَقَالَ  مُعَاوِيَةُ  : لَا إِلَهَ إِلَّا اللهُ ، ثُمَّ قَالَ  مُعَاوِيَةُ  : هَكَذَا سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ .","","Al-Mu'jam al-Kabir 730","","معاوية بن أبي سفيان عن علقمة بن وقاص العتواري عن عبد الله بن علقمة بن وقاص الليثي عن عمرو بن يحيى بن عمارة المازني عن داود ابن النصراني عن سعيد بن الحكم الجمحي عن يحيى بن نافع بن خالد المصري عن الطبراني","علقمة بن وقاص الليثي عن معاوية"
"17811","731  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِيهِ ،  عَنْ  جَدِّهِ  قَالَ :  أَذَّنَ الْمُؤَذِّنُ عِنْدَ مُعَاوِيَةَ فَقَالَ : اللهُ أَكْبَرُ اللهُ أَكْبَرُ ، فَقَالَ  مُعَاوِيَةُ  : اللهُ أَكْبَرُ اللهُ أَكْبَرُ  ، فَقَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، قَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، فَقَالَ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، قَالَ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَقَالَ :  حَيَّ  عَلَى الصَّلَاةِ ، قَالَ : لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، قَالَ :  حَيَّ  عَلَى  الْفَلَاحِ  ، قَالَ : لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، قَالَ : اللهُ أَكْبَرُ اللهُ أَكْبَرُ ، قَالَ  مُعَاوِيَةُ  : اللهُ أَكْبَرُ اللهُ أَكْبَرُ ، فَقَالَ : لَا إِلَهَ إِلَّا اللهُ ، فَقَالَ : لَا إِلَهَ إِلَّا اللهُ ، ثُمَّ قَالَ : هَكَذَا سَمِعْتُ نَبِيَّكُمْ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ  .","","Al-Mu'jam al-Kabir 731","","معاوية بن أبي سفيان عن علقمة بن وقاص العتواري عن عمرو بن علقمة بن وقاص الليثي عن محمد بن عمرو بن علقمة بن وقاص الليثي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","علقمة بن وقاص الليثي عن معاوية"
"17812","عُرْوَةُ بْنُ الزُّبَيْرِ  عَنْ  مُعَاوِيَةَ  732  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ الْمِصْرِيُّ  ، ثَنَا  يَحْيَى بْنُ بُكَيْرٍ ،  حَدَّثَنِي  ابْنُ لَهِيعَةَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ الْأَسْوَدِ ،  عَنْ  عُرْوَةَ بْنِ الزُّبَيْرِ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ عَلَى مِنْبَرِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَمَعَهُ  قُصَّةُ  شَعَرٍ ، فَقَالَ : إِنِّي وَجَدْتُ هَذِهِ فِي أَهْلِي ، وَإِنَّهُمْ زَعَمُوا أَنَّ النِّسَاءَ يَزِدْنَهُ فِي شُعُورِهِنَّ ، وَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَعَنَ اللهُ  الْوَاصِلَةَ  وَالْمَوْصُولَةَ  .","","Al-Mu'jam al-Kabir 732","","معاوية بن أبي سفيان عن عروة بن الزبير عن محمد بن عبد الرحمن بن نوفل عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن روح بن الفرج القطان عن الطبراني","عروة بن الزبير عن معاوية"
"17813","[19/323]      مُحَمَّدُ ابْنُ الْحَنَفِيَّةِ  عَنْ  مُعَاوِيَةَ  733  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ الْجُمَحِيُّ  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ (  ح  ) .  وَحَدَّثَنَا  يُوسُفُ الْقَاضِي  ، ثَنَا  أَبُو الْوَلِيدِ الطَّيَالِسِيُّ وَعَبْدُ الْوَاحِدِ بْنُ غِيَاثٍ قَالَا :  أَبْنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  مُحَمَّدِ بْنِ عَلِيٍّ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْعُمْرَى  جَائِزَةٌ لِأَهْلِهَا  .","","Al-Mu'jam al-Kabir 733","","معاوية بن أبي سفيان عن ابن الحنفية عن عبد الله بن محمد بن عقيل بن أبي طالب عن حماد بن سلمة عن أبو الوليد الطيالسي عن الفضل بن الحباب الجمحي عن الطبراني","محمد ابن الحنفية عن معاوية"
"17814","734  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  ابْنُ مُبَارَكٍ ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  مُحَمَّدِ ابْنِ الْحَنَفِيَّةِ ،  عَنْ  مُعَاوِيَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  الْعُمْرَى  جَائِزَةٌ  .","","Al-Mu'jam al-Kabir 734","","معاوية بن أبي سفيان عن ابن الحنفية عن عبد الله بن محمد بن عقيل بن أبي طالب عن محمد بن إسحاق عن عبد الله بن المبارك عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","محمد ابن الحنفية عن معاوية"
"17815","735  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  رَوْحُ بْنُ صَلَاحٍ ،  ثَنَا  سَعِيدُ بْنُ أَبِي أَيُّوبَ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ،  عَنْ  عَمِّهِ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ قَالَ :  الْعُمْرَى  بِمَنْزِلَةِ الْمِيرَاثِ  .","","Al-Mu'jam al-Kabir 735","","معاوية بن أبي سفيان عن ابن الحنفية عن عبد الله بن محمد بن عقيل بن أبي طالب عن سعيد بن أبي أيوب الخزاعي عن روح بن صلاح بن سيابة الحارثي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","محمد ابن الحنفية عن معاوية"
"17816","عِيسَى بْنُ طَلْحَةَ  عَنْ  مُعَاوِيَةَ  736  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ كَثِيرٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  طَلْحَةَ بْنِ يَحْيَى ،  عَنْ  عِيسَى بْنِ طَلْحَةَ ،  عَنْ  مُعَاوِيَةَ قَالَ : سَمِعْتُ النَّبِيَّ         [19/324]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  أَطْوَلُ النَّاسِ  أَعْنَاقًا  الْمُؤَذِّنُونَ  .","","Al-Mu'jam al-Kabir 736","","معاوية بن أبي سفيان عن عيسى بن طلحة التيمي عن طلحة بن يحيى بن طلحة التيمي عن سفيان الثوري عن محمد بن كثير العبدي عن أبو مسلم الكجي عن الطبراني","عيسى بن طلحة عن معاوية"
"17817","737  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ،  عَنْ  إِبْرَاهِيمَ بْنِ الْحَارِثِ التَّيْمِيِّ ،  عَنْ  عِيسَى بْنِ طَلْحَةَ قَالَ :  دَخَلْنَا عَلَى مُعَاوِيَةَ فَنَادَى الْمُنَادِي لِلصَّلَاةِ ، فَقَالَ : اللهُ أَكْبَرُ اللهُ أَكْبَرُ ، فَقَالَ  مُعَاوِيَةُ  كَمَا قَالَ  ، فَقَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، فَقَالَ مِثْلَ ذَلِكَ أَيْضًا ، فَقَالَ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَقَالَ مِثْلَ ذَلِكَ ، ثُمَّ قَالَ : هَكَذَا سَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ  .","","Al-Mu'jam al-Kabir 737","","معاوية بن أبي سفيان عن عيسى بن طلحة التيمي عن إبراهيم بن الحارث بن خالد بن صخر التيمي عن يحيى بن أبي كثير عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","عيسى بن طلحة عن معاوية"
"17818","مُوسَى بْنُ طَلْحَةَ  عَنْ  مُعَاوِيَةَ  738  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ الْعَبَّاسِ الْأَصْبَهَانِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  يَحْيَى بْنُ زَكَرِيَّا بْنِ أَبِي زَائِدَةَ ،  ثَنَا  قَيْسُ بْنُ الرَّبِيعِ ،  عَنْ  مَيْسَرَةَ بْنِ حَبِيبٍ ،  عَنْ  مُوسَى بْنِ طَلْحَةَ قَالَ :  شَهِدْتُ  عُثْمَانَ يَخْطُبُ عَلَى الْمِنْبَرِ قَائِمًا ، وَشَهِدْتُ مُعَاوِيَةَ يَخْطُبُ قَاعِدًا  ، فَقَالَ : أَمَا إِنِّي لَمْ أَجْهَلِ السُّنَّةَ ، وَلَكِنِّي كَبِرَتْ سِنِّي  وَرَقَّ  عَظْمِي وَكَثُرَتْ حَوَائِجُكُمْ ، فَأَرَدْتُ أَنْ أَقْضِيَ بَعْضَ حَوَائِجِكُمْ وَأَنَا قَاعِدٌ ثُمَّ أَقُومَ فَآخُذَ نَصِيبِي مِنَ السُّنَّةِ  .","","Al-Mu'jam al-Kabir 738","","معاوية بن أبي سفيان عن موسى بن طلحة بن عبيد الله التيمي عن ميسرة بن حبيب النهدي عن قيس بن الربيع الأسدي عن يحيى بن زكريا بن أبي زائدة عن سهل بن عثمان العسكري عن عبد الله بن محمد بن العباس الأصبهاني عن الطبراني","موسى بن طلحة عن معاوية"
"17819","739  -  حَدَّثَنَا  قَيْسُ بْنُ مُسْلِمٍ الْبُخَارِيُّ  ، ثَنَا  قُتَيْبَةُ بْنُ سَعِيدٍ ،  ثَنَا  مُعَاوِيَةُ بْنُ عِيسَى  ،  ثَنَا  إِسْحَاقُ بْنُ يَحْيَى بْنِ طَلْحَةَ ،  عَنْ  مُوسَى بْنِ طَلْحَةَ ،         [19/325]      قَالَ :  دَخَلْتُ عَلَى مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، فَلَمَّا خَرَجْتُ دَعَانِي فَقَالَ : اصْغِ ، عِنْدِي حَدِيثٌ يَا ابْنَ أَخِي سَمِعْتُهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ، أَشْهَدُ لَسَمِعْتُ رَسُولَ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يَقُولُ :  طَلْحَةُ  مِمَّنْ قَضَى  نَحْبَهُ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( معن بن عيسى )","","Al-Mu'jam al-Kabir 739","","معاوية بن أبي سفيان عن موسى بن طلحة بن عبيد الله التيمي عن إسحاق بن يحيى بن طلحة التيمي عن معن بن عيسى عن قتيبة بن سعيد عن قيس بن مسلم بن منصور البخاري عن الطبراني","موسى بن طلحة عن معاوية"
"17820","حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  عَنْ  مُعَاوِيَةَ  740  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنْ  مَعْمَرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ  أَنَّهُ رَأَى مُعَاوِيَةَ يَخْطُبُ عَلَى الْمِنْبَرِ وَفِي يَدِهِ  قُصَّةٌ  مِنَ الشَّعَرِ ، قَالَ :  فَسَمِعْتُهُ  يَقُولُ : أَيْنَ عُلَمَاؤُكُمْ يَا  أَهْلَ الْمَدِينَةِ ؟  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْ مِثْلِ هَذَا ، وَقَالَ : إِنَّمَا عُذِّبَتْ  بَنُو إِسْرَائِيلَ  حِينَ اتَّخَذَتْ هَذِهِ نِسَاؤُهُمْ  .","","Al-Mu'jam al-Kabir 740","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","حميد بن عبد الرحمن بن عوف عن معاوية"
"17821","741  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  ابْنُ شِهَابٍ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ وَفِي يَدِهِ  قُصَّةٌ  مِنْ شَعَرٍ يَقُولُ :  شَهِدْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْ مِثْلِ هَذَا ، وَيَقُولُ : إِنَّمَا عُذِّبَتْ  بَنُو إِسْرَائِيلَ  حِينَ اتَّخَذَتْ نِسَاؤُهُمْ هَذِهِ  .","","Al-Mu'jam al-Kabir 741","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن ابن جريج عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","حميد بن عبد الرحمن بن عوف عن معاوية"
"17822","742  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  أَنَا  مَالِكٌ (  ح  ) .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  ثَنَا  مَالِكٌ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ عَامَ         [19/326]      حَجَّ وَهُوَ عَلَى الْمِنْبَرِ وَتَنَاوَلَ  قُصَّةً  مِنْ شَعَرٍ كَانَتْ فِي يَدِ  حَرَسِيٍّ ،  وَهُوَ يَقُولُ : يَا  أَهْلَ الْمَدِينَةِ ،  أَيْنَ عُلَمَاؤُكُمْ ؟  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْ مِثْلِ هَذِهِ وَيَقُولُ : إِنَّمَا هَلَكَتْ  بَنُو إِسْرَائِيلَ  حِينَ اتَّخَذَ هَذِهِ نِسَاؤُهُمْ  .  وَاللَّفْظُ لِحَدِيثِ  الْقَعْنَبِيِّ  .","","Al-Mu'jam al-Kabir 742","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","حميد بن عبد الرحمن بن عوف عن معاوية"
"17823","743  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بِشْرٍ التِّنِّيسِيُّ ،  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  الزُّهْرِيُّ ،  حَدَّثَنِي  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ وَبِيَدِهِ  قُصَّةٌ  مِنْ شَعَرٍ يَقُولُ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْ مِثْلِ هَذِهِ وَيَقُولُ :  إِنَّمَا هَلَكَتْ  بَنُو إِسْرَائِيلَ  حِينَ اتَّخَذَهَا نِسَاؤُهُمْ  .","","Al-Mu'jam al-Kabir 743","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن أبو عمرو الأوزاعي عن محمد بن بشر التنيسي عن محمد بن علي بن زيد الصائغ عن الطبراني","حميد بن عبد الرحمن بن عوف عن معاوية"
"17824","744  -  حَدَّثَنَا  هَارُونُ بْنُ كَامِلٍ الْمِصْرِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  يُونُسُ ،  عَنِ  ابْنِ شِهَابٍ ،  حَدَّثَنِي  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَخْطُبُ عَلَى الْمِنْبَرِ  بِالْمَدِينَةِ  يَقُولُ : أَيْنَ عُلَمَاؤُكُمْ يَا  أَهْلَ الْمَدِينَةِ ؟  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْ مِثْلِ هَذِهِ الْقُصَّةِ ، يَقُولُ :  إِنَّمَا هَلَكَ  بَنُو إِسْرَائِيلَ  حِينَ اتَّخَذَهَا نِسَاؤُهُمْ  .","","Al-Mu'jam al-Kabir 744","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن يونس بن يزيدالأيلي عن الليث بن سعد عن عبد الله بن صالح المصري عن هارون بن كامل المصري عن الطبراني","حميد بن عبد الرحمن بن عوف عن معاوية"
"17825","745  -  حَدَّثَنَا  أَبُو الزِّنْبَاعِ رَوْحُ بْنُ الْفَرَجِ وَأَحْمَدُ بْنُ حَمَّادِ بْنِ زُغْبَةَ قَالَا :  ثَنَا  سَعِيدُ بْنُ عُفَيْرٍ ،  أَنَا  يَحْيَى بْنُ أَيُّوبَ ،  عَنِ  ابْنِ الْهَادِ ،  عَنْ  عَبْدِ الْوَهَّابِ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ وَفِي يَدِهِ  قُصَّةٌ  مِنْ شَعَرٍ يَقُولُ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْ مِثْلِ هَذَا وَيَقُولُ :  إِنَّمَا عُذِّبَتْ  بَنُو إِسْرَائِيلَ  حِينَ اتَّخَذَتْ مِثْلَ هَذِهِ نِسَاؤُهُمْ  .","","Al-Mu'jam al-Kabir 745","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن عبد الوهاب بن أبي بكر المدني عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن يحيى بن أيوب الغافقي عن سعيد بن كثير بن عفير عن زغبة ، أحمد بن حماد بن مسلم التجيبي عن الطبراني","حميد بن عبد الرحمن بن عوف عن معاوية"
"17826","746  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  ثَنَا  خَالِدٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ         [19/327]      مَعَ  رَجُلٍ  فَقَالَ : إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْ مِثْلِ هَذَا وَيَقُولُ :  إِنَّمَا هَلَكَ  بَنُو إِسْرَائِيلَ  حِينَ اتَّخَذَتْ هَذِهِ نِسَاؤُهُمْ  .","","Al-Mu'jam al-Kabir 746","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","حميد بن عبد الرحمن بن عوف عن معاوية"
"17827","747  -  حَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْقَعْنَبِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ :  قَدِمَ مُعَاوِيَةُ  الْمَدِينَةَ  فَقَالَ : أَيْنَ عُلَمَاؤُكُمْ ؟ وَأَخْرَجَ كُبَّةً مِنْ شَعَرٍ مِنْ كُمِّهِ فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَنْهَى عَنْ هَذَا ، وَقَالَ :  إِنَّمَا هَلَكَ  بَنُو إِسْرَائِيلَ  حِينَ اتَّخَذَ نِسَاؤُهُمْ مِثْلَ هَذَا  .","","Al-Mu'jam al-Kabir 747","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن سفيان بن عيينة عن عبد الله بن مسلمة القعنبي عن أبو مسلم الكجي عن الطبراني","حميد بن عبد الرحمن بن عوف عن معاوية"
"17828","بَابٌ  748  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  حَدَّثَنِي  حُمَيْدُ بْنُ عَبْدِ الرَّحْمَنِ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ يَخْطُبُ يَقُولُ : يَا  أَهْلَ الْمَدِينَةِ ،  أَيْنَ عُلَمَاؤُكُمْ ؟ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  هَذَا يَوْمُ عَاشُورَاءَ وَلَمْ يُفْرَضْ عَلَيْنَا صِيَامُهُ ، فَمَنْ شَاءَ مِنْكُمْ أَنْ يَصُومَ فَلْيَصُمْ فَإِنِّي صَائِمٌ ، فَصَامَ النَّاسُ  .","","Al-Mu'jam al-Kabir 748","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","باب"
"17829","749  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ (  ح  ) .  وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  أَنَا  مَالِكٌ (  ح  ) .  وَحَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ عَبْدِ الْحَكَمِ ،  أَنَا  مَالِكٌ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ يَوْمَ عَاشُورَاءَ عَامَ حَجَّ وَهُوَ عَلَى الْمِنْبَرِ يَقُولُ : يَا  أَهْلَ الْمَدِينَةِ ،  أَيْنَ عُلَمَاؤُكُمْ ؟ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ         [19/328]      عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ هَذَا الْيَوْمَ يَوْمُ عَاشُورَاءَ ، وَلَمْ يُكْتَبْ عَلَيْكُمْ صِيَامُهُ ، وَأَنَا صَائِمٌ  ، فَمَنْ شَاءَ فَلْيَصُمْ وَمَنْ شَاءَ فَلْيُفْطِرْ  .","","Al-Mu'jam al-Kabir 749","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن مالك بن أنس عن عبد الله بن مسلمة القعنبي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","باب"
"17830","750  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ  ، ثَنَا  الْقَعْنَبِيُّ - قَالَا :  ثَنَا  سُفْيَانُ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ قَالَ :  قَدِمَ مُعَاوِيَةُ  الْمَدِينَةَ  فَقَالَ  : أَيْنَ عُلَمَاؤُكُمْ ؟ إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ فِي هَذَا الْيَوْمِ فَقَالَ :  إِنِّي صَائِمٌ ، فَمَنْ شَاءَ فَلْيَصُمْ وَمَنْ شَاءَ فَلْيُفْطِرْ  .","","Al-Mu'jam al-Kabir 750","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن سفيان بن عيينة عن عبد الله بن مسلمة القعنبي عن أبو مسلم الكجي عن الطبراني","باب"
"17831","751  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ خَالِدِ بْنِ مُسَافِرٍ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ وَهُوَ عَلَى الْمِنْبَرِ يَقُولُ فِي خُطْبَتِهِ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  هَذَا الْيَوْمُ يَوْمُ عَاشُورَاءَ ، وَلَمْ يُكْتَبْ عَلَيْكُمْ صِيَامُهُ ، وَأَنَا صَائِمٌ  ، فَمَنْ أَحَبَّ فَلْيَصُمْهُ -  يَعْنِي يَوْمَ عَاشُورَاءَ  .","","Al-Mu'jam al-Kabir 751","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن عبد الرحمن بن خالد بن مسافر الفهمي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","باب"
"17832","752  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدٌ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَخْطُبُ يَوْمَ عَاشُورَاءَ فَقَالَ : يَا  أَهْلَ الْمَدِينَةِ ،  أَيْنَ عُلَمَاؤُكُمْ ؟ سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  هَذَا يَوْمُ عَاشُورَاءَ ، وَلَمْ يُكْتَبْ عَلَيْكُمْ صِيَامُهُ ، وَإِنِّي صَائِمٌ ،  فَمَنْ أَحَبَّ أَنْ يَصُومَهُ فَلْيَصُمْهُ ، وَمَنْ أَحَبَّ أَنْ يُفْطِرَ فَلْيُفْطِرْ  .","","Al-Mu'jam al-Kabir 752","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن عبد الرحمن بن إسحاق العامري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","باب"
"17833","753  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ سَعْدٍ ،  حَدَّثَنَا  عَمِّي ،  ثَنَا  أَبِي  ،  عَنْ  صَالِحِ بْنِ كَيْسَانَ ،  عَنِ  ابْنِ شِهَابٍ أَنَّ حُمَيْدَ بْنَ عَبْدِ الرَّحْمَنِ  أَخْبَرَهُ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ وَهُوَ يَخْطُبُ لِلنَّاسِ يَوْمَ عَاشُورَاءَ وَهُوَ يَقُولُ :         [19/329]      يَا  أَهْلَ الْمَدِينَةِ ،  أَيْنَ عُلَمَاؤُكُمْ ؟ إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  هَذَا يَوْمُ عَاشُورَاءَ ، وَلَمْ يُكْتَبْ عَلَيْكُمْ صِيَامُهُ ، وَإِنِّي صَائِمٌ -  وَهُوَ يَقُولُ ذَلِكَ - فَمَنْ أَحَبَّ مِنْكُمْ أَنْ يَصُومَهُ فَلْيَصُمْ ، وَمَنْ أَحَبَّ أَنْ يُفْطِرَ فَلْيُفْطِرْ  .","","Al-Mu'jam al-Kabir 753","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن صالح بن كيسان الدوسي عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن عبيد الله بن سعد بن إبراهيم الزهري عن أحمد بن يحيى بن زهير التستري عن الطبراني","باب"
"17834","754  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  مَالِكُ بْنُ سَعْدٍ الْقَيْسِيُّ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي حَفْصَةَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ عَلَى الْمِنْبَرِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  هَذَا يَوْمُ عَاشُورَاءَ ، وَلَمْ يُكْتَبْ عَلَيْكُمْ صِيَامُهُ ، وَأَنَا صَائِمٌ ، فَمَنْ شَاءَ فَلْيَصُمْ  ، وَمَنْ شَاءَ فَلْيُفْطِرْ  .","","Al-Mu'jam al-Kabir 754","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن محمد بن أبي حفصة البصري عن روح بن عبادة القيسي عن مالك بن سعد بن عبادة القيسي عن محمد بن صالح النرسي عن الطبراني","باب"
"17835","بَابٌ  755  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ بْنُ سَعْدٍ ،  عَنْ  يَزِيدَ بْنِ الْهَادِ ،  عَنْ  عَبْدِ الْوَهَّابِ بْنِ أَبِي بَكْرٍ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّمَا أَنَا قَاسِمٌ وَيُعْطِي اللهُ  .","","Al-Mu'jam al-Kabir 755","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن عبد الوهاب بن أبي بكر المدني عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","باب"
"17836","وَسَمِعْتُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 17836","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن عبد الوهاب بن أبي بكر المدني عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","باب"
"17837","وَسَمِعْتُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  :  لَا يَزَالُ مِنْ هَذِهِ الْأُمَّةِ أُمَّةٌ قَائِمَةٌ عَلَى أَمْرِ اللهِ لَا يَضُرُّهُمْ مَنْ خَالَفَهُمْ  حَتَّى يَأْتِيَ أَمْرُ اللهِ وَهُمْ ظَاهِرُونَ عَلَى الْحَقِّ  .","","Al-Mu'jam al-Kabir 17837","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن عبد الوهاب بن أبي بكر المدني عن يزيد بن عبد الله بن أسامة بن الهاد الليثي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","باب"
"17838","[19/330]      756  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الْعَزِيزِ بْنِ أَبِي رِزْمَةَ ،  ثَنَا  عَلِيُّ بْنُ الْحَسَنِ بْنِ شَقِيقٍ ،  أَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  عَنْ  يُونُسَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 756","","معاوية بن أبي سفيان عن حميد بن عبد الرحمن القرشي عن الزهري عن يونس بن يزيدالأيلي عن عبد الله بن المبارك عن علي بن الحسن بن شقيق عن محمد بن عبد العزيز بن أبي رزمة عن الحسين بن إسحاق التستري عن الطبراني","باب"
"17839","أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ  عَنْ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُ  757  -  حَدَّثَنَا  عُبَيْدٌ الْعِجْلِيُّ  ، ثَنَا  إِبْرَاهِيمُ بْنُ سَعِيدٍ الْجَوْهَرِيُّ ،  ثَنَا  أَبُو أُسَامَةَ ،  عَنْ  مُحَمَّدِ بْنِ عَمْرٍو ،  عَنْ  أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ قَالَ :  حَجَّ مُعَاوِيَةُ فَصَلَّى رَكْعَتَيْنِ فَلَمَّا دَخَلَ عَلَيْهِ قِيلَ لَهُ : مَا عَابَ أَحَدٌ ابْنَ عَمِّكَ عَيْبَكَ ، قَالَ : وَمَا ذَاكَ ؟ قَالُوا : صَلَّيْتَ رَكْعَتَيْنِ  وَعُثْمَانُ  صَلَّى أَرْبَعًا ، قَالَ :  صَلَّيْتُ مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - رَكْعَتَيْنِ ، فَلَمْ يَزَالُوا بِهِ حَتَّى خَرَجَ فَصَلَّى أَرْبَعًا  .","","Al-Mu'jam al-Kabir 757","","معاوية بن أبي سفيان عن أبو سلمة بن عبد الرحمن عن محمد بن عمرو بن علقمة بن وقاص الليثي عن حماد بن أسامة القرشي عن إبراهيم بن سعيد الجوهري عن عبيد العجل عن الطبراني","أبو سلمة بن عبد الرحمن عن معاوية رضي الله عنه"
"17840","عَبْدُ اللهِ بْنُ الْحَارِثِ بْنِ نَوْفَلٍ  عَنْ  مُعَاوِيَةَ  758  -  حَدَّثَنَا  عُبَيْدُ بْنُ غَنَّامٍ  ، ثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  أَسْبَاطُ بْنُ مُحَمَّدٍ ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ،  أَنَّ  عَمْرَو بْنَ الْعَاصِ قَالَ لِمُعَاوِيَةَ : يَا أَمِيرَ الْمُؤْمِنِينَ أَمَا سَمِعْتَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ حِينَ كَانَ يَبْنِي الْمَسْجِدَ  لِعَمَّارٍ  :  إِنَّكَ         [19/331]      لَحَرِيصٌ عَلَى  الْجِهَادِ  ، وَإِنَّكَ لِمَنْ أَهْلِ الْجَنَّةِ ، وَلَتَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  ، قَالَ : بَلَى ، قَالَ : فَلِمَ قَتَلْتُمُوهُ ؟ قَالَ : وَاللهِ مَا تَزَالُ تَدْحَضُ فِي بَوْلِكَ ، أَنَحْنُ قَتَلْنَاهُ ؟ إِنَّمَا قَتَلَهُ الَّذِي جَاءَ بِهِ  .","","Al-Mu'jam al-Kabir 758","","معاوية بن أبي سفيان عن عبد الله بن الحارث بن نوفل عن عبد الرحمن بن زياد الهاشمي عن الأعمش عن أسباط بن محمد بن ميسرة القرشي عن محمد بن عبد الله بن نمير عن عبيد بن غنام النخعي عن الطبراني","عبد الله بن الحارث بن نوفل عن معاوية"
"17841","759  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  عُبَيْدُ بْنُ أَسْبَاطِ بْنِ مُحَمَّدٍ ،  ثَنَا  أَبِي  ،  عَنِ  الْأَعْمَشِ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ أَبِي زِيَادٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ بْنِ نَوْفَلٍ ،  أَنَّهُ سَمِعَ  عَمْرَو بْنَ الْعَاصِ ، وَعَبْدَ اللهِ بْنَ عَمْرٍو ، وَمُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُونَ :  قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  لِعَمَّارٍ  : تَقْتُلُكَ  الْفِئَةُ  الْبَاغِيَةُ  .","","Al-Mu'jam al-Kabir 759","","معاوية بن أبي سفيان عن عبد الله بن الحارث بن نوفل عن عبد الرحمن بن زياد الهاشمي عن الأعمش عن أسباط بن محمد بن ميسرة القرشي عن عبيد بن أسباط بن محمد الهمداني عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن الحارث بن نوفل عن معاوية"
"17842","760  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  زَكَرِيَّا بْنُ يَحْيَى زَحْمَوَيْهِ ،  ثَنَا  صَالِحُ بْنُ عُمَرَ ،  عَنْ  حَنْظَلَةَ السَّدُوسِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ الْحَارِثِ ، وَكَانَ  مُعَاوِيَةُ  خَالَهُ قَالَ :  كُنْتُ عِنْدَ مُعَاوِيَةَ بَعْدَ صَلَاةِ الْعَصْرِ فَأَبْصَرَ نَاسًا يُصَلُّونَ بَعْدَهَا رَكْعَتَيْنِ ، فَقَالَ :  مَا هَذِهِ الصَّلَاةُ ؟ قَدْ صَلَّيْنَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَمَا رَأَيْنَا أَحَدًا يُصَلِّيهَا  .","","Al-Mu'jam al-Kabir 760","","معاوية بن أبي سفيان عن عبد الله بن الحارث بن نوفل عن حنظلة بن عبد الله السدوسي عن صالح بن عمر الواسطي عن زكريا بن يحيى زحمويه عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الله بن الحارث بن نوفل عن معاوية"
"17843","عُبَيْدُ اللهِ بْنُ عَبْدِ اللهِ بْنِ عُتْبَةَ  عَنْ  مُعَاوِيَةَ  761  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  ثَنَا  الْفَضْلُ بْنُ الْعَلَاءِ ،  ثَنَا  طَلْحَةُ بْنُ يَحْيَى ،  عَنْ  عُبَيْدِ اللهِ بْنِ         [19/332]      عَبْدِ اللهِ بْنِ عُتْبَةَ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يُصَلِّي فِي الثَّوْبِ الْوَاحِدِ  .","","Al-Mu'jam al-Kabir 761","","معاوية بن أبي سفيان عن عبيد الله بن عبد الله بن عتبة بن مسعود عن طلحة بن يحيى بن طلحة التيمي عن الفضل بن العلاء الكوفي عن الشاذكوني عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","عبيد الله بن عبد الله بن عتبة عن معاوية"
"17844","سَعِيدُ بْنُ عَمْرِو بْنِ سَعِيدِ بْنِ الْعَاصِ  عَنْ  مُعَاوِيَةَ  762  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ كَامِلٍ السَّرَّاجُ  ، ثَنَا  أَبُو حَسَّانَ الزِّيَادِيُّ ،  ثَنَا  هِشَامُ بْنُ مُحَمَّدِ بْنِ السَّائِبِ الْكَلْبِيُّ ،  ثَنَا  خَالِدُ بْنُ سَعِيدِ بْنِ عَمْرِو بْنِ سَعِيدِ بْنِ الْعَاصِ ،  عَنْ  أَبِيهِ  ،  قَالَ  :  كَانَ مُعَاوِيَةُ يَقُولُ : وَاللهِ مَا هِبْتُ الْكَلَامَ عِنْدَ أَحَدٍ قَطُّ هَيْبَتِي عِنْدَ  عَائِشَةَ  ، وَمَا سَمِعْتُ كَلَامَهَا إِلَّا ذَكَرْتُ كَلَامَ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 762","","معاوية بن أبي سفيان عن سعيد بن عمرو بن سعيد بن العاص العذري عن خالد بن سعيد بن عمرو الأموي عن هشام بن محمد بن السائب الكلبي عن الحسن بن عثمان الزيادي عن محمد بن عبدوس السراج عن الطبراني","سعيد بن عمرو بن سعيد بن العاص عن معاوية"
"17845","سَالِمُ بْنُ عَبْدِ اللهِ بْنِ عُمَرَ  عَنْ  مُعَاوِيَةَ  763  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  مُعْتَمِرٌ ،  عَنْ  أَبِيهِ  ،  عَنِ  الْحَضْرَمِيِّ ،  عَنْ  سَالِمِ بْنِ عَبْدِ اللهِ ،  أَنَّ مُعَاوِيَةَ جَعَلَ يَقُولُ لِبَعْضِ مَنْ حَضَرَ : أَتَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ فِي كَذَا كَذَا ؟ قَالُوا : بَلَى ، قَالَ :  أَفَلَمْ يَقُلْ فِي  شَأْنِ  التَّمَتُّعِ وَالْعُمْرَةِ فَنَهَى عَنْهَا ؟  قَالَ الَّذِينَ يُصَدِّقُونَ فِي الْحَدِيثِ الْأَوَّلِ : لَا وَاللهِ مَا قَالَ هَذَا وَمَا عَلِمْنَاهُ قَالَ  .","","Al-Mu'jam al-Kabir 763","","معاوية بن أبي سفيان عن سالم بن عبد الله بن عمر بن الخطاب عن يحيى بن أبي إسحاق الحضرمي عن سليمان بن طرخان عن معتمر بن سليمان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","سالم بن عبد الله بن عمر عن معاوية"
"17846","الْقَاسِمُ بْنُ مُحَمَّدٍ  عَنْ  مُعَاوِيَةَ  764  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ، وَالْعَبَّاسُ بْنُ الْفَضْلِ الْأَسْفَاطِيُّ ، قَالَا :  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  سُلَيْمَانُ بْنُ بِلَالٍ ،  عَنْ  جَعْفَرِ بْنِ مُحَمَّدٍ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ ،  عَنْ  مُعَاوِيَةَ ،  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ         [19/333]      وَسَلَّمَ - قَالَ لِلنَّاسِ :  إِنْ صَلَّى الْإِمَامُ جَالِسًا فَصَلُّوا جُلُوسًا  ، قَالَ  الْقَاسِمُ  : فَعَجِبَ النَّاسُ مِنْ صِدْقِ  مُعَاوِيَةَ  .","","Al-Mu'jam al-Kabir 764","","معاوية بن أبي سفيان عن القاسم بن محمد بن أبي بكر الصديق عن جعفر الصادق عن سليمان بن بلال القرشي عن إسماعيل بن أبي أويس عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","القاسم بن محمد عن معاوية"
"17847","عَبَّادُ بْنُ عَبْدِ اللهِ بْنِ الزُّبَيْرِ  عَنْ  مُعَاوِيَةَ  765  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  يَعْقُوبُ بْنُ إِبْرَاهِيمَ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  يَحْيَى بْنِ عَبَّادِ بْنِ عَبْدِ اللهِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِيهِ عَبَّادِ بْنِ عَبْدِ اللهِ  قَالَ  :  حَجَجْنَا مَعَ مُعَاوِيَةَ عَامَ حَجَّ فَصَلَّى الظُّهْرَ رَكْعَتَيْنِ ، ثُمَّ دَخَلَ عَلَيْهِ  مَرْوَانُ بْنُ الْحَكَمِ ،  وَعَمْرُو بْنُ عُثْمَانَ  فَقَالَا :  مَا هَذِهِ الصَّلَاةُ ؟ فَقَالَ : هَذِهِ سُنَّةٌ صَلَّيْتُهَا مَعَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - وَمَعَ  أَبِي بَكْرٍ ،  وَعُمَرَ  - رَضِيَ اللهُ عَنْهُمَا - فَقَالَا : كَانَ ابْنُ عَمِّكَ أَتَمَّهَا أَرْبَعًا ، فَقَالَ : مَا ذَكَرْتُ إِلَّا هَذَا .","","Al-Mu'jam al-Kabir 765","","معاوية بن أبي سفيان عن عباد بن عبد الله بن الزبير بن العوام عن يحيى بن عباد بن عبد الله بن الزبير بن العوام عن محمد بن إسحاق عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","عباد بن عبد الله بن الزبير عن معاوية"
"17848","حُمْرَانُ بْنُ أَبَانَ  عَنْ  مُعَاوِيَةَ  766  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي التَّيَّاحِ قَالَ :  سَمِعْتُ  حُمْرَانَ يَقُولُ :  خَطَبَنَا  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ ، فَقَالَ :  إِنَّكُمْ لَتُصَلُّونَ صَلَاةً مَا كَانَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ يُصَلِّيهَا  ، وَلَقَدْ كَانَ يَنْهَى عَنْهَا  ،  يَعْنِي الرَّكْعَتَيْنِ بَعْدَ الْعَصْرِ  .","","Al-Mu'jam al-Kabir 766","","معاوية بن أبي سفيان عن حمران بن أبان النمري عن يزيد بن حميد الضبعي عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","حمران بن أبان عن معاوية"
"17849","[19/334]      ذَكْوَانُ أَبُو صَالِحٍ السَّمَّانُ  عَنْ  مُعَاوِيَةَ  767  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، عَنْ  عَبْدِ الرَّزَّاقِ ،  عَنِ  الثَّوْرِيِّ ،  عَنْ  عَاصِمِ بْنِ أَبِي النَّجُودِ ،  عَنْ  ذَكْوَانَ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ  شَرِبَ  الْخَمْرَ فَاجْلِدُوهُ ،  قَالَهَا ثَلَاثًا ، فَإِذَا شَرِبُوا الرَّابِعَةَ فَاقْتُلُوهُمْ  .","","Al-Mu'jam al-Kabir 767","","معاوية بن أبي سفيان عن ذكوان السمان عن عاصم بن بهدلة عن سفيان الثوري عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","ذكوان أبو صالح السمان عن معاوية"
"17850","768  -  حَدَّثَنَا  حَجَّاجُ بْنُ عِمْرَانَ السَّدُوسِيُّ  ، ثَنَا  أَبُو سَلَمَةَ يَحْيَى بْنُ خَلَفٍ الْجُوبَارِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  سَعِيدِ بْنِ أَبِي عَرُوبَةَ ،  عَنْ  عَاصِمِ ابْنِ بَهْدَلَةَ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  مُعَاوِيَةَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا  شَرِبَ  الْخَمْرَ فَاجْلِدُوهُ  ، قَالَ عِنْدَ الرَّابِعَةِ :  فَاقْتُلُوهُ  .","","Al-Mu'jam al-Kabir 768","","معاوية بن أبي سفيان عن ذكوان السمان عن عاصم بن بهدلة عن سعيد بن أبي عروبة عن عبد الأعلى بن عبد الأعلى القرشي عن يحيى بن خلف الجوباري عن حجاج بن عمران السدوسي عن الطبراني","ذكوان أبو صالح السمان عن معاوية"
"17851","769  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  أَبُو بَكْرِ بْنُ عَيَّاشٍ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  مُعَاوِيَةَ قَالَ : سَمِعْتُ رَسُولَ         [19/335]      اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ مَاتَ وَلَيْسَ فِي عُنُقِهِ بَيْعَةٌ مَاتَ  مِيتَةً  جَاهِلِيَّةً  .","","Al-Mu'jam al-Kabir 769","","معاوية بن أبي سفيان عن ذكوان السمان عن عاصم بن بهدلة عن أبو بكر بن عياش عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","ذكوان أبو صالح السمان عن معاوية"
"17852","770  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  عَاصِمِ ابْنِ بَهْدَلَةَ ،  عَنْ  ذَكْوَانَ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ :  كَانَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِذَا سَمِعَ الْمُؤَذِّنَ يَقُولُ اللهُ أَكْبَرُ قَالَ مِثْلَ قَوْلِهِ  ، فَإِذَا قَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ قَالَ مِثْلَ قَوْلِهِ ، فَإِذَا قَالَ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ مَرَّتَيْنِ قَالَ مِثْلَ قَوْلِهِ .","","Al-Mu'jam al-Kabir 770","","معاوية بن أبي سفيان عن ذكوان السمان عن عاصم بن بهدلة عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","ذكوان أبو صالح السمان عن معاوية"
"17853","771  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى الْقَزَّازُ الْبَصْرِيُّ  ، ثَنَا  مُوسَى بْنُ إِسْمَاعِيلَ ،  ثَنَا  أَبَانُ بْنُ يَزِيدَ ،  عَنْ  عَاصِمٍ ،  عَنْ  أَبِي صَالِحٍ ،  عَنْ  مُعَاوِيَةَ ،  أَنَّهُ سَمِعَ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  وَبِلَالٌ  يُؤَذِّنُ فَلَمَّا قَالَ : اللهُ أَكْبَرُ اللهُ أَكْبَرُ ، قَالَ نَبِيُّ اللهِ : اللهُ أَكْبَرُ اللهُ أَكْبَرُ  ، ثُمَّ قَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، قَالَ نَبِيُّ اللهِ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، ثُمَّ قَالَ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَقَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهَا ثُمَّ صَمَتَ  .","","Al-Mu'jam al-Kabir 771","","معاوية بن أبي سفيان عن ذكوان السمان عن عاصم بن بهدلة عن أبان بن يزيد العطار عن موسى بن إسماعيل التبوذكي عن محمد بن يحيى بن المنذر القزاز عن الطبراني","ذكوان أبو صالح السمان عن معاوية"
"17854","يُوسُفُ أَبُو مُحَمَّدٍ مَوْلَى عُثْمَانَ  عَنْ  مُعَاوِيَةَ  772  -  حَدَّثَنَا  إِدْرِيسُ بْنُ جَعْفَرٍ الْعَطَّارُ  ، ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  ابْنُ جُرَيْجٍ ،  عَنْ  مُحَمَّدِ بْنِ يُوسُفَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُعَاوِيَةَ ، أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ نَسِيَ مِنْ صَلَاتِهِ شَيْئًا فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ  .","","Al-Mu'jam al-Kabir 772","","معاوية بن أبي سفيان عن يوسف مولى عثمان بن عفان عن محمد بن يوسف مولى عثمان بن عفان عن ابن جريج عن روح بن عبادة القيسي عن إدريس بن جعفر العطار عن الطبراني","يوسف أبو محمد مولى عثمان عن معاوية"
"17855","[19/336]      773  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ الْمِصْرِيُّ  ، ثَنَا  سَعِيدُ بْنُ أَبِي مَرْيَمَ ،  ثَنَا  يَحْيَى بْنُ أَيُّوبَ ، وَابْنُ لَهِيعَةَ ، قَالَا :  ثَنَا  ابْنُ عَجْلَانَ أَنَّ  مُحَمَّدَ بْنَ يُوسُفَ مَوْلَى عُثْمَانَ بْنِ عَفَّانَ  حَدَّثَهُ  ،  عَنْ  أَبِيهِ  أَنَّ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ ،  صَلَّى بِهِمْ فَنَسِيَ فَقَامَ وَعَلَيْهِ جُلُوسٌ فَلَمْ يَجْلِسْ ، فَلَمَّا كَانَ آخِرُ صَلَاتِهِ سَجَدَ سَجْدَتَيْنِ قَبْلَ التَّسْلِيمِ  ، ثُمَّ قَالَ : هَكَذَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَصْنَعُ  .","","Al-Mu'jam al-Kabir 773","","معاوية بن أبي سفيان عن يوسف مولى عثمان بن عفان عن محمد بن يوسف مولى عثمان بن عفان عن محمد بن عجلان عن يحيى بن أيوب الغافقي عن سعيد بن الحكم الجمحي عن يحيى بن أيوب العلاف عن الطبراني","يوسف أبو محمد مولى عثمان عن معاوية"
"17856","774  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  بَكْرُ بْنُ مُضَرَ ،  عَنْ  عَمْرِو بْنِ الْحَارِثِ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ بْنِ الْأَشَجِّ ، أَنَّ مُحَمَّدَ بْنَ عَجْلَانَ ،  حَدَّثَهُ  أَنَّ  مُحَمَّدَ بْنَ يُوسُفَ  حَدَّثَهُ  ،  عَنْ  أَبِيهِ  ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  صَلَّى بِهِمْ فَنَسِيَ فَقَامَ وَعَلَيْهِ جُلُوسٌ فَلَمْ يَجْلِسْ ، فَلَمَّا كَانَ فِي آخِرِ الصَّلَاةِ سَجَدَ سَجْدَتَيْنِ قَبْلَ أَنْ يُسَلِّمَ  ، ثُمَّ قَالَ : هَكَذَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَفْعَلُ  .","","Al-Mu'jam al-Kabir 774","","معاوية بن أبي سفيان عن يوسف مولى عثمان بن عفان عن محمد بن يوسف مولى عثمان بن عفان عن محمد بن عجلان عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن بكر بن مضر المصري عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","يوسف أبو محمد مولى عثمان عن معاوية"
"17857","775  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ  ، ثَنَا  يَحْيَى بْنُ صَالِحٍ الْوُحَاظِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ الرَّبِيعِ بْنِ سَبْرَةَ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ يُوسُفَ ، مَوْلَى عُثْمَانَ  يَقُولُ  :  إِنَّ مُعَاوِيَةَ كَانَ إِذَا أَذَّنَ الْمُؤَذِّنُ قَالَ مِثْلَ مَا يَقُولُ حَتَّى يَنْتَهِيَ إِلَى قَوْلِهِ :  حَيَّ  عَلَى الصَّلَاةِ ،  حَيَّ  عَلَى  الْفَلَاحِ  ، فَيَقُولُ : لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ  ، ثُمَّ يَقُولُ مِثْلَ مَا يَقُولُ ، ثُمَّ قَالَ : هَكَذَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  .","","Al-Mu'jam al-Kabir 775","","معاوية بن أبي سفيان عن محمد بن يوسف مولى عثمان بن عفان عن عبد العزيز بن الربيع الجهني عن يحيى بن صالح الوحاظي عن أبو زرعة الدمشقي عن الطبراني","يوسف أبو محمد مولى عثمان عن معاوية"
"17858","[19/337]      776  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  عَمْرُو بْنُ الْحَارِثِ ،  عَنْ  بُكَيْرِ بْنِ عَبْدِ اللهِ ، أَنَّ مُحَمَّدَ بْنَ عَجْلَانَ ،  حَدَّثَهُ  أَنَّ  مُحَمَّدَ بْنَ يُوسُفَ  حَدَّثَهُ  ،  عَنْ  أَبِيهِ ،  أَنَّ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ  صَلَّى بِهِمْ فَنَسِيَ فَقَامَ وَعَلَيْهِ جُلُوسٌ فَلَمْ يَجْلِسْ ، فَلَمَّا كَانَ آخِرُ صَلَاتِهِ سَجَدَ سَجْدَتَيْنِ قَبْلَ أَنْ يُسَلِّمَ  ، ثُمَّ قَالَ : هَكَذَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - صَنَعَ  .","","Al-Mu'jam al-Kabir 776","","معاوية بن أبي سفيان عن يوسف مولى عثمان بن عفان عن محمد بن يوسف مولى عثمان بن عفان عن محمد بن عجلان عن بكير بن عبد الله بن الأشج القرشي عن عمرو بن الحارث بن يعقوب عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن الحجاج المصري عن الطبراني","يوسف أبو محمد مولى عثمان عن معاوية"
"17859","777  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيٍّ الصَّائِغُ الْمَكِّيُّ  ، ثَنَا  أَحْمَدُ بْنُ مُحَمَّدٍ الْقَوَّاسُ ،  ثَنَا  عَبْدُ الْمَجِيدِ ،  عَنِ  ابْنِ جُرَيْجٍ ،  حَدَّثَنِي  أَبُو بَكْرٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  مُحَمَّدِ بْنِ يُوسُفَ ، مَوْلَى عَمْرِو بْنِ عُثْمَانَ ،  عَنْ  أَبِيهِ يُوسُفَ  ،  أَنَّهُ رَأَى  مُعَاوِيَةَ صَلَّى بِالنَّاسِ فَقَامَ فِي الثِّنْتَيْنِ فَسَبَّحَ النَّاسُ فَأَشَارَ إِلَيْهِمْ أَنْ قُومُوا ، فَلَمَّا فَرَغَ مِنْ صَلَاتِهِ سَجَدَ سَجْدَتَيْنِ قَبْلَ السَّلَامِ وَسَجَدَهُمَا النَّاسُ مَعَهُ ، ثُمَّ قَالَ : يَا أَيُّهَا النَّاسُ إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ دَاخَلَهُ شَكٌّ فِي صَلَاتِهِ فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ  .","","Al-Mu'jam al-Kabir 777","","معاوية بن أبي سفيان عن يوسف مولى عثمان بن عفان عن محمد بن يوسف مولى عثمان بن عفان عن محمد بن عجلان عن أبو بكر الهذلي عن ابن جريج عن عبد المجيد بن عبد العزيز بن أبي رواد عن أحمد بن محمد بن علقمة النبال عن محمد بن علي بن زيد الصائغ عن الطبراني","يوسف أبو محمد مولى عثمان عن معاوية"
"17860","778  -  حَدَّثَنَا  الْفَضْلُ بْنُ الْعَبَّاسِ الْأَسْفَاطِيُّ  ، ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  عَنْ  سُلَيْمَانَ بْنِ بِلَالٍ ،  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  مُحَمَّدِ بْنِ يُوسُفَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُعَاوِيَةَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ نَسِيَ شَيْئًا مِنْ صَلَاتِهِ فَلْيَسْجُدْ سَجْدَتَيْنِ  .  كذا في طبعة مكتبة ابن تيمية ، والصواب العباس بن الفضل .","","Al-Mu'jam al-Kabir 778","","معاوية بن أبي سفيان عن يوسف مولى عثمان بن عفان عن محمد بن يوسف مولى عثمان بن عفان عن محمد بن عجلان عن سليمان بن بلال القرشي عن إسماعيل بن أبي أويس عن العباس بن الفضل بن يونس الأسفاطي عن الطبراني","يوسف أبو محمد مولى عثمان عن معاوية"
"17861","مُحَمَّدُ بْنُ جُبَيْرِ بْنِ مُطْعِمٍ  عَنْ  مُعَاوِيَةَ  779  -  حَدَّثَنَا  أَبُو أُسَامَةَ عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ أَبِي أُسَامَةَ الْحَلَبِيُّ  ، ثَنَا  الْحَجَّاجُ بْنُ أَبِي مَنِيعٍ الرُّصَافِيُّ ،  ثَنَا  جَدِّي  ،  عَنِ  الزُّهْرِيِّ قَالَ : كَانَ         [19/338]      مُحَمَّدُ بْنُ جُبَيْرِ بْنِ مُطْعِمٍ  يُحَدِّثُ  قَالَ  :  بَلَغَ مُعَاوِيَةَ أَنَّ  عَبْدَ اللهِ بْنَ عَمْرٍو  يُحَدِّثُ أَنَّهُ سَيَكُونُ  مَلِكٌ  مِنْ  قَحْطَانَ ،  فَغَضِبَ  مُعَاوِيَةُ  فَقَامَ فَأَثْنَى عَلَى اللهِ بِمَا هُوَ أَهْلُهُ ، ثُمَّ قَالَ : أَمَّا بَعْدُ ، فَإِنَّهُ بَلَغَنِي أَنَّ رِجَالًا مِنْكُمْ يَتَحَدَّثُونَ أَحَادِيثَ لَيْسَتْ فِي كِتَابِ اللهِ وَلَا يُؤْثَرُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَإِنَّ ذَلِكَ لَجُهَّالُكُمْ ، فَإِيَّاكُمْ وَالْأَمَانِيَّ الَّتِي تُضِلُّ أَهْلَهَا ، فَإِنِّي سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ هَذَا الْأَمْرَ فِي  قُرَيْشٍ  لَا يُعَادِيهِمْ أَحَدٌ إِلَّا أَكَبَّهُ اللهُ لِوَجْهِهِ مَا أَقَامُوا الدِّينَ  .","","Al-Mu'jam al-Kabir 779","","معاوية بن أبي سفيان عن محمد بن جبير بن مطعم النوفلي عن الزهري عن عبيد الله بن أبي زياد الرصافي عن حجاج بن يوسف الرصافي عن عبد الله بن محمد بن أبي أسامة الحلبي عن الطبراني","محمد بن جبير بن مطعم عن معاوية"
"17862","780  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ جَابِرٍ الْبَخْتَرِيُّ الْحِمْصِيُّ  ، ثَنَا  بِشْرُ بْنُ شُعَيْبِ بْنِ أَبِي حَمْزَةَ ،  حَدَّثَنِي  أَبِي  ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ ،  عَنْ  مُعَاوِيَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ هَذَا الْأَمْرَ فِي  قُرَيْشٍ  لَا يُعَادِيهِمْ أَحَدٌ إِلَّا أَكَبَّهُ اللهُ عَلَى وَجْهِهِ مَا أَقَامُوا الدِّينَ  .","","Al-Mu'jam al-Kabir 780","","معاوية بن أبي سفيان عن محمد بن جبير بن مطعم النوفلي عن الزهري عن شعيب بن أبي حمزة الحمصي عن بشر بن شعيب بن أبي حمزة عن عبد الرحمن بن جابر الطائي عن الطبراني","محمد بن جبير بن مطعم عن معاوية"
"17863","781  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  نُعَيْمُ بْنُ حَمَّادٍ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  أَنَا  مَعْمَرٌ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  مُحَمَّدِ بْنِ جُبَيْرِ بْنِ مُطْعِمٍ  قَالَ  :  بَلَغَ مُعَاوِيَةَ أَنَّ  عَبْدَ اللهِ بْنَ عَمْرٍو  يُحَدِّثُ يَذْكُرُ أَنَّهُ يَكُونُ  مَلِكٌ  مِنْ  قَحْطَانَ  ، فَغَضِبَ وَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَزَالُ هَذَا الْأَمْرُ فِي  قُرَيْشٍ  لَا يُعَادِيهِمْ أَحَدٌ إِلَّا كُبَّ عَلَى وَجْهِهِ مَا أَقَامُوا الدِّينَ  .","","Al-Mu'jam al-Kabir 781","","معاوية بن أبي سفيان عن محمد بن جبير بن مطعم النوفلي عن الزهري عن معمر بن راشد عن عبد الله بن المبارك عن نعيم بن حماد الخزاعي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","محمد بن جبير بن مطعم عن معاوية"
"17864","مُحَمَّدُ بْنُ كَعْبٍ الْقُرَظِيُّ  عَنْ  مُعَاوِيَةَ  782  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْقَعْنَبِيُّ ،  عَنْ  مَالِكٍ (  ح  ) .         [19/339]      وَحَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  عَبْدُ اللهِ بْنُ يُوسُفَ ،  أَنَا  مَالِكٌ ،  عَنْ  يَزِيدَ بْنِ زِيَادٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ قَالَ :  قَالَ  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ ، وَهُوَ عَلَى الْمِنْبَرِ :  أَيُّهَا النَّاسُ إِنَّهُ لَا مَانِعَ لِمَا أَعْطَى اللهُ ، وَلَا مُعْطِيَ لِمَا مَنَعَ  ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْهُ  الْجَدُّ ،  وَمَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ ، ثُمَّ قَالَ : سَمِعْتُ هَذِهِ الْكَلِمَاتِ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى هَذِهِ الْأَعْوَادِ  .","","Al-Mu'jam al-Kabir 782","","معاوية بن أبي سفيان عن محمد بن كعب بن سليم القرظي عن يزيد بن زياد المخزومي عن مالك بن أنس عن عبد الله بن يوسف التنيسي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","محمد بن كعب القرظي عن معاوية"
"17865","783  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ  ، ثَنَا  كَثِيرُ بْنُ يَحْيَى ،  ثَنَا  أَبُو أُمَيَّةَ بْنُ يَعْلَى ،  حَدَّثَنِي  يَزِيدُ بْنُ زِيَادٍ ، مَوْلَى عَلِيِّ بْنِ أَبِي طَالِبٍ  حَدَّثَنِي  مُحَمَّدُ بْنُ كَعْبٍ الْقُرَظِيُّ  قَالَ  :  قَدِمَ عَلَيْنَا مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ فَصَعِدَ الْمِنْبَرَ فَحَمِدَ اللهَ وَأَثْنَى عَلَيْهِ ، ثُمَّ قَالَ :  يَا أَيُّهَا النَّاسُ لَا مَانِعَ لِمَا أَعْطَى اللهُ ، وَلَا مُعْطِيَ لِمَا مَنَعَ  ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْهُ  الْجَدُّ ،  وَمَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ ، سَمِعْتُ هَؤُلَاءِ الْكَلِمَاتِ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 783","","معاوية بن أبي سفيان عن محمد بن كعب بن سليم القرظي عن يزيد بن زياد المخزومي عن إسماعيل بن يعلى الثقفي عن كثير بن يحيى بن كثير الشيعي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","محمد بن كعب القرظي عن معاوية"
"17866","784  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى بْنُ سَعِيدٍ ،  عَنِ  ابْنِ عَجْلَانَ ،  حَدَّثَنِي  مُحَمَّدُ بْنُ كَعْبٍ الْقُرَظِيُّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَخْطُبُ  بِالْمَدِينَةِ  يَقُولُ :  لِتَعْلَمُنَّ  أَيُّهَا النَّاسُ أَنَّهُ لَا مَانِعَ لِمَا أَعْطَى اللهُ ، وَلَا مُعْطِيَ لِمَا مَنَعَ اللهُ  ، وَلَا يَنْفَعُ ذَا  الْجَدِّ  مِنْهُ  الْجَدُّ ،  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ ، سَمِعْتُ هَذِهِ الْأَحْرُفَ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى هَذِهِ الْأَعْوَادِ  .","","Al-Mu'jam al-Kabir 784","","معاوية بن أبي سفيان عن محمد بن كعب بن سليم القرظي عن محمد بن عجلان عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","محمد بن كعب القرظي عن معاوية"
"17867","785  -  حَدَّثَنَا  أَبُو خَلِيفَةَ الْفَضْلُ بْنُ الْحُبَابِ  ، ثَنَا  الْعَبَّاسُ بْنُ الْفَرَجِ الرِّيَاشِيُّ ،  ثَنَا  عُثْمَانُ بْنُ عَمْرٍو (  ح  ) .  وَحَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ الْمِصْرِيُّ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ، قَالَا :  ثَنَا  أُسَامَةُ بْنُ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ الْقُرَظِيِّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ         [19/340]      يَخْطُبُ فَقَالَ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  ، وَإِنَّ هَذَا الْمَالَ  خَضِرَةٌ  حُلْوَةٌ ، فَمَنْ يَأْخُذْ بِحَقِّهِ يُبَارَكْ لَهُ فِيهِ ، ثُمَّ يَقُولُ : سَمِعْتُ هَؤُلَاءِ الْكَلِمَاتِ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى الْمِنْبَرِ ، وَإِنَّ السَّامِعَ الْمُطِيعَ لَا حُجَّةَ عَلَيْهِ ، وَإِنَّ السَّامِعَ الْعَاصِي لَا حُجَّةَ لَهُ  .","","Al-Mu'jam al-Kabir 785","","معاوية بن أبي سفيان عن محمد بن كعب بن سليم القرظي عن أسامة بن زيد الليثي المدني عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف المصري عن الطبراني","محمد بن كعب القرظي عن معاوية"
"17868","786  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  شَرِيكٌ ،  عَنْ  عُثْمَانَ بْنِ رَاشِدٍ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ ،  وَيُلْهِمْهُ  رُشْدَهُ  .","","Al-Mu'jam al-Kabir 786","","معاوية بن أبي سفيان عن محمد بن كعب بن سليم القرظي عن عثمان بن راشد السلمي عن شريك بن عبد الله النخعي عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","محمد بن كعب القرظي عن معاوية"
"17869","787  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  يَحْيَى الْحِمَّانِيُّ ،  ثَنَا  عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ ،  عَنْ  عُثْمَانَ بْنِ حَكِيمٍ قَالَ :  سَمِعْتُ  مُحَمَّدَ بْنَ كَعْبٍ يَقُولُ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ وَلَا مُعْطِيَ لِمَا مَنَعْتَ  ، مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 787","","معاوية بن أبي سفيان عن محمد بن كعب بن سليم القرظي عن عثمان بن حكيم الأحلافي عن عبد الواحد بن زياد عن يحيى بن عبد الحميد عن الحسين بن إسحاق التستري عن الطبراني","محمد بن كعب القرظي عن معاوية"
"17870","788  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  الْحَسَنُ بْنُ بِشْرٍ الْكُوفِيُّ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  عَنْ  مُوسَى بْنِ عُبَيْدَةَ ،  عَنْ  مُحَمَّدِ بْنِ كَعْبٍ ،  أَنَّ  نَفَرًا كَانُوا فِي عَهْدِ مُعَاوِيَةَ يَشْهَدُونَ الْفَجْرَ وَيَجْلِسُونَ عِنْدَ قَاصِّ الْجَمَاعَةِ ، فَإِذَا سَلَّمَ تَحَوَّلُوا إِلَى نَاحِيَةِ الْمَسْجِدِ فَيَذْكُرُونَ اللهَ وَيَتْلُونَ كِتَابَ اللهِ حَتَّى يَتَعَالَى النَّهَارُ ، فَأُخْبِرَ  مُعَاوِيَةُ  بِهِمْ فَجَاءَ  يُهَرْوِلُ أَوْ يَسْعَى  فِي مِشْيَتِهِ حَتَّى وَقَفَ عَلَيْهِمْ فَقَالَ : جِئْتُ أُبَشِّرُكُمْ بِبُشْرَى اللهِ فِيمَا رَزَقَكُمْ ، أَنَّ نَفَرًا عَلَى عَهْدِ رَسُولِ اللهِ         [19/341]      صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  أَحْسَبُهُ - قَالَ : كَانُوا يَصْنَعُونَ نَحْوًا مِمَّا تَصْنَعُونَ  ، فَأَقْبَلَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَأَنِّي أَحْكِيهِ فِي مِشْيَتِهِ حَتَّى وَقَفَ عَلَيْهِمْ ، فَقَالَ :  أَبْشِرُوا وَالَّذِي نَفْسِي بِيَدِهِ إِنَّ اللهَ عَزَّ وَجَلَّ  يُبَاهِي  بِكُمُ الْمَلَائِكَةَ  .","","Al-Mu'jam al-Kabir 788","","معاوية بن أبي سفيان عن محمد بن كعب بن سليم القرظي عن موسى بن عبيدة بن نشيط الحميري عن المعافى بن عمران عن الحسن بن بشر الكاهلي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","محمد بن كعب القرظي عن معاوية"
"17871","النُّعْمَانُ بْنُ مُرَّةَ الزُّرَقِيُّ  عَنْ  مُعَاوِيَةَ  789  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  حَرْمَلَةُ بْنُ يَحْيَى ،  ثَنَا  ابْنُ وَهْبٍ ،  حَدَّثَنِي  مُعَاوِيَةُ بْنُ صَالِحٍ ،  عَنْ  يَحْيَى بْنِ سَعِيدٍ ،  عَنِ  النُّعْمَانِ بْنِ مُرَّةَ الزُّرَقِيِّ ،  أَنَّهُ سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَحَبَّ  الْأَنْصَارَ  فَبِحُبِّي أَحَبَّهُمْ  ، وَمَنْ أَبْغَضَ  الْأَنْصَارَ  فَبِبُغْضِي أَبْغَضَهُمْ  .","","Al-Mu'jam al-Kabir 789","","معاوية بن أبي سفيان عن النعمان بن مرة الزرقي عن يحيى بن سعيد الأنصاري عن معاوية بن صالح بن حدير الحضرمي عن عبد الله بن وهب المصري عن حرملة بن يحيى التجيبي عن الحسين بن إسحاق التستري عن الطبراني","النعمان بن مرة الزرقي عن معاوية"
"17872","مُحَمَّدُ بْنُ عُقْبَةَ مَوْلَى آلِ الزُّبَيْرِ  عَنْ  مُعَاوِيَةَ  790  -  حَدَّثَنَا  يَحْيَى بْنُ عُثْمَانَ بْنِ صَالِحٍ ، وَبَكْرُ بْنُ سَهْلٍ ، قَالَا :  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ قَالَ :  حَدَّثَنِي  هِشَامُ بْنُ سَعْدٍ ،  عَنْ  مُحَمَّدِ بْنِ عُقْبَةَ  قَالَ  :  خَطَبَ مُعَاوِيَةُ فَتَكَلَّمَ بِشَيْءٍ مِمَّا يُنْكِرُهُ النَّاسُ فَرَدُّوا عَلَيْهِ فَسَّرَهُ ذَلِكَ ، وَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  يَكُونُ أُمَرَاءُ يَقُولُونَ وَلَا يُرَدُّ عَلَيْهِمْ  يَتَهَافَتُونَ  فِي النَّارِ يَتْبَعُ بَعْضُهُمْ بَعْضًا  .","","Al-Mu'jam al-Kabir 790","","معاوية بن أبي سفيان عن محمد بن عقبة بن أبي مالك القرظي عن هشام بن سعد المخزومي عن الليث بن سعد عن عبد الله بن صالح المصري عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","محمد بن عقبة مولى آل الزبير عن معاوية"
"17873","[19/342]      أَيُّوبُ بْنُ بَشِيرٍ الْأَنْصَارِيُّ  عَنْ  مُعَاوِيَةَ  791  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ، وَمُوسَى بْنُ عِيسَى بْنِ الْمُنْذِرِ الْحِمْصِيُّ ، قَالَا :  ثَنَا  أَحْمَدُ بْنُ خَالِدٍ الْوَهْبِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ ،  عَنِ  الزُّهْرِيِّ ،  عَنْ  أَيُّوبَ بْنِ بَشِيرِ بْنِ النُّعْمَانِ الْأَنْصَارِيِّ ،  حَدَّثَنِي  مُعَاوِيَةُ قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَتَّى صَعِدَ الْمِنْبَرَ ، وَذَكَرَ  قَتْلَى أُحُدٍ  ، فَصَلَّى عَلَيْهِمْ وَأَكْثَرَ الصَّلَاةَ ، ثُمَّ قَالَ :  إِنَّ عَبْدًا مِنْ عِبَادِ اللهِ خَيَّرَهُ اللهُ بَيْنَ الدُّنْيَا وَمَا عِنْدَهُ  ، فَاخْتَارَ مَا عِنْدَ اللهِ ، فَلَمْ يَلْقَهَا إِلَّا  أَبُو بَكْرٍ  ، قَالَ : نَحْنُ نَفْدِيكَ بِآبَائِنَا وَأُمَّهَاتِنَا ، فَقَالَ : عَلَى رِسْلِكَ يَا  أَبَا بَكْرٍ ،  إِنَّ أَفْضَلَ النَّاسِ عِنْدِي فِي الصُّحْبَةِ وَذَاتِ يَدِهِ  ابْنُ أَبِي قُحَافَةَ  .","","Al-Mu'jam al-Kabir 791","","معاوية بن أبي سفيان عن أيوب بن بشير بن سعد المعاوي عن الزهري عن محمد بن إسحاق عن أحمد بن خالد بن موسى الوهبي عن موسى بن عيسى بن المنذر الحمصي عن الطبراني","أيوب بن بشير الأنصاري عن معاوية"
"17874","زَيْدُ بْنُ أَبِي الْعَتَّابِ  عَنْ  مُعَاوِيَةَ  792  -  حَدَّثَنَا  فُضَيْلُ بْنُ مُحَمَّدٍ الْمَلَطِيُّ  ، ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَشَّرِ الْمَدِينِيُّ ، جَلِيسُ ابْنِ أَبِي ذِئْبٍ ،  عَنْ  زَيْدِ بْنِ أَبِي الْعَتَّابِ  قَالَ  : قَامَ مُعَاوِيَةُ عَلَى الْمِنْبَرِ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 792","","معاوية بن أبي سفيان عن زيد بن أبي عتاب الشامي عن عبد الله بن مبشر الأموي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","زيد بن أبي العتاب عن معاوية"
"17875","وَسَمِعْتُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَيُّمَا امْرَأَةٍ أَدْخَلَتْ فِي رَأْسِهَا شَعَرًا مِنْ غَيْرِ شَعَرِهَا فَإِنَّمَا تُدْخِلُهُ زُورًا  .","","Al-Mu'jam al-Kabir 17875","","معاوية بن أبي سفيان عن زيد بن أبي عتاب الشامي عن عبد الله بن مبشر الأموي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","زيد بن أبي العتاب عن معاوية"
"17876","[19/343]      وَسَمِعْتُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  خَيْرُ نِسَاءٍ رَكِبْنَ الْإِبِلَ نِسَاءُ  قُرَيْشٍ  أَرْعَاهُ  عَلَى زَوْجٍ فِي ذَاتِ يَدِهِ ،  وَأَحْنَاهُ  عَلَى وَلَدٍ فِي صِغَرِهِ  .","","Al-Mu'jam al-Kabir 17876","","معاوية بن أبي سفيان عن زيد بن أبي عتاب الشامي عن عبد الله بن مبشر الأموي عن الفضل بن دكين عن فضيل بن محمد  بن فضيل الملطي عن الطبراني","زيد بن أبي العتاب عن معاوية"
"17877","مَحْمُودُ بْنُ عَلِيٍّ الْقُرَظِيُّ  عَنْ  مُعَاوِيَةَ  793  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ  ، ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  عَنِ  ابْنِ لَهِيعَةَ ،  عَنْ  مَحْمُودِ بْنِ عَلِيٍّ الْقُرَظِيِّ  أَنَّ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ لَمَّا أَذَّنَ الْمُؤَذِّنُ كَبَّرَ كَنَحْوِ تَكْبِيرِهِ ، وَتَشَهَّدَ كَنَحْوِ  تَشَهُّدِهِ  ، فَلَمَّا قَالَ :  حَيَّ  عَلَى الصَّلَاةِ ،  حَيَّ  عَلَى  الْفَلَاحِ  ، قَالَ : لَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ ، هَكَذَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ  .","","Al-Mu'jam al-Kabir 793","","معاوية بن أبي سفيان عن محمود بن علي القرظي عن عبد الله بن لهيعة عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","محمود بن علي القرظي عن معاوية"
"17878","الْمُطَّلِبُ بْنُ عَبْدِ اللهِ بْنِ حَنْطَبٍ  عَنْ  مُعَاوِيَةَ  794  -  حَدَّثَنَا  مُحَمَّدُ بْنُ أَحْمَدَ بْنِ نَصْرٍ أَبُو جَعْفَرٍ التِّرْمِذِيُّ ،  ثَنَا         [19/344]      مُحَمَّدُ بْنُ عَبْدِ الْوَهَّابِ الْأَزْهَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ إِسْمَاعِيلَ الْجَعْفَرِيُّ ،  ثَنَا  عَبْدُ الْعَزِيزِ بْنُ مُحَمَّدٍ الدَّرَاوَرْدِيُّ ،  عَنْ  عَمْرِو بْنِ أَبِي عَمْرٍو ،  عَنِ  الْمُطَّلِبِ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَسْتُ مِنْ دَدٍ ، وَلَا دَدٌ مِنِّي  .","","Al-Mu'jam al-Kabir 794","","معاوية بن أبي سفيان عن المطلب بن عبد الله بن حنطب المخزومي عن عمرو بن أبي عمرو المخزومي عن عبد العزيز بن محمد الدراوردي عن محمد بن إسماعيل بن جعفر الجعفري عن محمد بن عبد الوهاب الأزهري عن محمد بن أحمد بن نصر الترمذي عن الطبراني","المطلب بن عبد الله بن حنطب عن معاوية"
"17879","فَضْلٌ الْمَدَنِيُّ  عَنْ  مُعَاوِيَةَ  795  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ أَبِي جَعْفَرٍ ،  عَنْ  صَفْوَانَ بْنِ سُلَيْمٍ ،  عَنْ  فَضْلٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ وَمَعَهُ قُصَّةُ النِّسَاءِ ، فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ زَادَ فِي شَعَرِهِ شَيْئًا لَيْسَ مِنْهُ فَإِنَّهُ يَزِيدُ فِيهِ زُورًا  .","","Al-Mu'jam al-Kabir 795","","معاوية بن أبي سفيان عن الفضل بن الحسن بن عمرو الضمري عن صفوان بن سليم القرشي عن عبيد الله بن أبي جعفر الكناني عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","فضل المدني عن معاوية"
"17880","يَزِيدُ بْنُ الْأَصَمِّ  عَنْ  مُعَاوِيَةَ  796  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الْحَرَّانِيُّ ،  ثَنَا  جَعْفَرُ بْنُ بُرْقَانَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ ، قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ  بِالْمَدِينَةِ  بِيَدِهِ قُصَّةٌ مِنْ قُصَصِ النِّسَاءِ يَقُولُ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ مِثْلِ هَذَا ، وَقَالَ : إِنَّمَا هَلَكَتْ نِسَاءُ  بَنِي إِسْرَائِيلَ  حِينَ اتَّخَذَ نِسَاؤُهُمْ هَذَا  .","","Al-Mu'jam al-Kabir 796","","معاوية بن أبي سفيان عن يزيد بن الأصم بن عبيد البكائي عن جعفر بن برقان الكلابي عن عثمان بن عبد الرحمن الطرائفي عن أبو كريب محمد بن العلاء عن الحسين بن إسحاق التستري عن الطبراني","يزيد بن الأصم عن معاوية"
"17881","797  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ  ، ثَنَا  سَهْلُ بْنُ عُثْمَانَ ،  ثَنَا  شَرَاحِيلُ بْنُ عَبْدِ اللهِ ،  عَنْ  جَعْفَرِ بْنِ بُرْقَانَ ،  عَنْ  يَزِيدَ بْنِ الْأَصَمِّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ وَهُوَ يَخْطُبُ عَلَى الْمِنْبَرِ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 797","","معاوية بن أبي سفيان عن يزيد بن الأصم بن عبيد البكائي عن جعفر بن برقان الكلابي عن شراحيل بن عبد الله المروزي عن سهل بن عثمان العسكري عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","يزيد بن الأصم عن معاوية"
"17882","[19/345]      أَبُو سَعِيدٍ الْمَقْبُرِيُّ  عَنْ  مُعَاوِيَةَ  798  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  فُلَيْحُ بْنُ سُلَيْمَانَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِيهِ  قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُ عَلَى الْمِنْبَرِ ، وَفِي يَدِهِ  قُصَّةٌ  مِنْ شَعَرٍ ، فَقَالَ :  مَا بَالُ نِسَائِكُمْ يَجْعَلُونَ فِي رُءُوسِهِمْ مِثْلَ هَذَا ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنِ امْرَأَةٍ تَجْعَلُ فِي رَأْسِهَا شَعَرًا مِنْ شَعَرِ غَيْرِهَا إِلَّا كَانَ زُورًا  .","","Al-Mu'jam al-Kabir 798","","معاوية بن أبي سفيان عن أبو سعيد المقبري عن سعيد المقبري عن فليح بن سليمان عن محمد بن بكار الرصافي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو سعيد المقبري عن معاوية"
"17883","799  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  مُحَمَّدُ بْنُ بَكَّارٍ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  زَيْدِ بْنِ أَسْلَمَ ،  عَنْ  سَعِيدٍ الْمَقْبُرِيِّ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 799","","معاوية بن أبي سفيان عن أبو سعيد المقبري عن سعيد المقبري عن زيد بن أسلم عن إسماعيل بن عياش الأحول عن محمد بن بكار الرصافي عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو سعيد المقبري عن معاوية"
"17884","سَعِيدُ بْنُ أَبِي سَعِيدٍ الْمَقْبُرِيُّ  عَنْ  مُعَاوِيَةَ  800  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ نَافِعٍ الطَّحَّانُ  ، ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  حَدَّثَنِي  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  مَخْرَمَةُ بْنُ بُكَيْرٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  سَعِيدِ بْنِ أَبِي سَعِيدٍ الْمَقْبُرِيِّ ،  أَنَّهُ سَمِعَ  مُعَاوِيَةَ ، عَلَى الْمِنْبَرِ وَمَعَهُ كُبَّةٌ مِنْ كُبَبِ النِّسَاءِ ، فَقَالَ : مَا بَالُ الْمُسْلِمَاتِ يَصْنَعْنَ هَذَا ، إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَيُّمَا امْرَأَةٍ زَادَتْ فِي رَأْسِهَا شَعَرًا لَيْسَ مِنْهُ فَإِنَّهُ زُورٌ  .","","Al-Mu'jam al-Kabir 800","","معاوية بن أبي سفيان عن سعيد المقبري عن بكير بن عبد الله بن الأشج القرشي عن مخرمة بن بكير المخزومي عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن أحمد بن محمد بن نافع الطحاوي عن الطبراني","سعيد بن أبي سعيد المقبري عن معاوية"
"17885","مُسْلِمُ بْنُ هُرْمُزَ  عَنْ  مُعَاوِيَةَ  801  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ دَاوُدَ الشَّاذَكُونِيُّ ،  ثَنَا  يَحْيَى بْنُ أَبِي الْحَجَّاجِ ،  ثَنَا  عَبْدُ اللهِ بْنُ مُسْلِمِ بْنِ هُرْمُزَ ،  عَنْ  أَبِيهِ         [19/346]      قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا يَزَالُ فِي هَذِهِ الْأُمَّةِ قَوْمٌ يُقَاتِلُونَ عَلَى أَمْرِ اللهِ لَا يَضُرُّهُمْ عَدَاوَةُ مَنْ عَادَاهُمْ وَلَا خِذْلَانُ مَنْ خَذَلَهُمْ  حَتَّى يَأْتِيَهُمْ أَمْرُ اللهِ تَعَالَى وَهُمْ عَلَى ذَلِكَ  .","","Al-Mu'jam al-Kabir 801","","معاوية بن أبي سفيان عن مسلم بن هرمز عن عبد الله بن مسلم بن هرمز الفدكي عن يحيى بن أبي الحجاج الأهتمي عن الشاذكوني عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","مسلم بن هرمز عن معاوية"
"17886","ابْنُ يَسَافٍ  عَنْ  مُعَاوِيَةَ  802  -  حَدَّثَنَا  أَبُو عَامِرٍ مُحَمَّدُ بْنُ إِبْرَاهِيمَ الصُّورِيُّ النَّحْوِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  إِسْمَاعِيلَ بْنِ عَيَّاشٍ ،  عَنْ  عُمَارَةَ بْنِ غَزِيَّةَ ،  عَنِ  ابْنِ يَسَافٍ ،  أَنَّهُ سَمِعَ  مُعَاوِيَةَ ، يُحَدِّثُ أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ سَمِعَ الْمُؤَذِّنَ فَقَالَ مِثْلَ مَا يَقُولُ فَلَهُ مِثْلُ أَجْرِهِ  .","","Al-Mu'jam al-Kabir 802","","معاوية بن أبي سفيان عن خبيب بن عبد الرحمن الخزرجي عن عمارة بن غزية عن إسماعيل بن عياش الأحول عن الوليد بن مسلم القرشي عن سليمان بن عبد الرحمن التميمي عن محمد بن إبراهيم الصوري عن الطبراني","ابن يساف عن معاوية"
"17887","عَبْدُ الرَّحْمَنِ بْنُ هُرْمُزَ الْأَعْرَجُ  عَنْ  مُعَاوِيَةَ  803  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  يَعْقُوبُ ،  عَنْ  إِبْرَاهِيمَ بْنِ سَعْدٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  مُحَمَّدِ بْنِ إِسْحَاقَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ هُرْمُزَ الْأَعْرَجِ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ : أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الشِّغَارِ  .","","Al-Mu'jam al-Kabir 803","","معاوية بن أبي سفيان عن عبد الرحمن بن هرمز الأعرج عن محمد بن إسحاق عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن يعقوب بن إبراهيم بن سعد بن إبراهيم بن عبد الرحمن بن عوف عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","عبد الرحمن بن هرمز الأعرج عن معاوية"
"17888","مُحَمَّدُ بْنُ يُوسُفَ مَوْلَى عُثْمَانَ  عَنْ  مُعَاوِيَةَ  804  -  حَدَّثَنَا  إِسْحَاقُ بْنُ أَبِي حَسَّانَ الْأَنْمَاطِيُّ  ، ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  حُذَيْفَةُ بْنُ عَبْدِ الْعَزِيزِ بْنِ الرَّبِيعِ بْنِ سَبْرَةَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُحَمَّدِ بْنِ يُوسُفَ ، مَوْلَى آلِ عُثْمَانَ  قَالَ  :  أَذَّنَ الْمُؤَذِّنُ فَقَالَ : اللهُ أَكْبَرُ ، فَقَالَ مُعَاوِيَةُ : اللهُ أَكْبَرُ  ، فَقَالَ الْمُؤَذِّنُ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، فَقَالَ  مُعَاوِيَةُ  : أَشْهَدُ         [19/347]      أَنْ لَا إِلَهَ إِلَّا اللهُ ، فَقَالَ الْمُؤَذِّنُ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَقَالَ  مُعَاوِيَةُ  : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، ثُمَّ قَالَ  مُعَاوِيَةُ  : هَكَذَا سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  - .","","Al-Mu'jam al-Kabir 804","","معاوية بن أبي سفيان عن محمد بن يوسف مولى عثمان بن عفان عن عبد العزيز بن الربيع الجهني عن حذيفة بن عبد العزيز بن الربيع بن سبرة عن هشام بن عمار عن إسحاق بن إبراهيم بن أبي حسان الأنماطي عن الطبراني","محمد بن يوسف مولى عثمان عن معاوية"
"17889","إِبْرَاهِيمُ بْنُ عَبْدِ اللهِ بْنِ قَارِظٍ  عَنْ  مُعَاوِيَةَ  805  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  شُعَيْبُ بْنُ يَحْيَى التُّجِيبِيُّ ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ عُمَرَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ قَارِظٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ ، وَهُوَ عَلَى الْمِنْبَرِ  بِالْمَدِينَةِ  يَقُولُ : يَا  أَهْلَ الْمَدِينَةِ  أَيْنَ فُقَهَاؤُكُمْ ؟ إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَنْهَى عَنْ مِثْلِ هَذِهِ الْقُصَّةِ ، وَوَضَعَهَا عَلَى رَأْسِهِ  ، فَلَمْ أَرَهَا عَلَى عَرُوسٍ وَلَا عَلَى غَيْرِهَا أَجْمَلَ مِنْهَا عَلَى  مُعَاوِيَةَ  .","","Al-Mu'jam al-Kabir 805","","معاوية بن أبي سفيان عن إبراهيم بن عبد الله بن قارظ الكناني عن عمر بن عبد العزيز بن مروان عن الزهري عن عبد الجبار بن عمر الأيلي عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","إبراهيم بن عبد الله بن قارظ عن معاوية"
"17890","806  -  حَدَّثَنَا  بَكْرُ بْنُ سَهْلٍ الدِّمْيَاطِيُّ  ، ثَنَا  شُعَيْبُ بْنُ يَحْيَى ،  ثَنَا  عَبْدُ الْجَبَّارِ بْنُ عُمَرَ ،  عَنِ  ابْنِ شِهَابٍ ،  عَنْ  عُمَرَ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  إِبْرَاهِيمَ بْنِ عَبْدِ اللهِ بْنِ قَارِظٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ عَلَى الْمِنْبَرِ وَذَكَرَ يَوْمَ عَاشُورَاءَ فَقَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنَّ يَوْمَ عَاشُورَاءَ كُنَّا نَصُومُهُ فِي الْجَاهِلِيَّةِ  فَفَرَضَ  اللهُ عَلَيْنَا صِيَامَ رَمَضَانَ  ، فَوَضَعَ عَنَّا صِيَامَ عَاشُورَاءَ ، فَمَنْ شَاءَ صَامَهُ وَمَنْ شَاءَ أَفْطَرَهُ  .","","Al-Mu'jam al-Kabir 806","","معاوية بن أبي سفيان عن إبراهيم بن عبد الله بن قارظ الكناني عن عمر بن عبد العزيز بن مروان عن الزهري عن عبد الجبار بن عمر الأيلي عن شعيب بن يحيى التجيبي عن بكر بن سهل بن إسماعيل الدمياطي عن الطبراني","إبراهيم بن عبد الله بن قارظ عن معاوية"
"17891","مُجَاهِدٌ  عَنْ  مُعَاوِيَةَ  807  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  زَيْدُ بْنُ الْحَرِيشِ ،  ثَنَا  عَبْدُ الْوَهَّابِ الثَّقَفِيُّ ،  عَنْ  عَبْدِ الْوَهَّابِ بْنِ مُجَاهِدٍ قَالَ :  سَمِعْتُ  مُجَاهِدًا ،         [19/348]      يَقُولُ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَعْجَلْ إِلَى شَيْءٍ تَظُنُّ أَنَّكَ إِنِ اسْتَعْجَلْتَ إِلَيْهِ أَنْتَ مُدْرِكُهُ وَإِنْ كَانَ اللهُ لَمْ يُقَدِّرْهُ لَكَ  ، وَلَا تَسْتَأْخِرَنَّ عَنْ شَيْءٍ تَظُنُّ أَنَّكَ إِنِ اسْتَأْخَرْتَ عَنْهُ أَنَّهُ قَدْ فَرَغَ عَنْكَ وَإِنْ كَانَ اللهُ قَدْ قَدَّرَهُ عَلَيْكَ  .","","Al-Mu'jam al-Kabir 807","","معاوية بن أبي سفيان عن مجاهد بن جبر المخزومي عن عبد الوهاب بن مجاهد مولى السائب عن عبد الوهاب بن عبد المجيد الثقفي عن زيد بن الحريش الأهوزاي عن الحسين بن إسحاق التستري عن الطبراني","مجاهد عن معاوية"
"17892","هَمَّامُ بْنُ مُنَبِّهٍ  عَنْ  مُعَاوِيَةَ  808  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  الْحُمَيْدِيُّ ،  ثَنَا  سُفْيَانُ ،  ثَنَا  عَمْرُو بْنُ دِينَارٍ قَالَ :  سَمِعْتُ  وَهْبَ بْنَ مُنَبِّهٍ يَقُولُ  بِصَنْعَاءَ  وَأَطْعَمَنِي مِنْ جَوْزَةٍ فِي دَارِهِ ،  يُحَدِّثُ عَنْ  أَخِيهِ  عَنْ  مُعَاوِيَةَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  لَا تُلْحِفُوا فِي الْمَسْأَلَةِ  ، فَوَاللهِ لَا يَسْأَلُنِي أَحَدٌ مِنْكُمْ شَيْئًا ، فَيُخْرِجُهُ لَهُ مِنِّي الْمَسْأَلَةُ فَأُعْطِيهِ إِيَّاهُ وَأَنَا لَهُ كَارِهٌ ، فَيُبَارَكُ لَهُ فِي الَّذِي أَعْطَيْتُهُ  .","","Al-Mu'jam al-Kabir 808","","معاوية بن أبي سفيان عن همام بن منبه الصنعاني عن وهب بن منبه عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن الحميدي عن بشر بن موسى بن صالح الأسدي عن الطبراني","همام بن منبه عن معاوية"
"17893","809  -  حَدَّثَنَا  عُمَارَةُ بْنُ وَثِيمَةَ الْمِصْرِيُّ  ، ثَنَا  هَارُونُ بْنُ سَعِيدٍ الْأَيْلِيُّ ،  ثَنَا  سُفْيَانُ بْنُ عُيَيْنَةَ ،  عَنْ  عَمْرِو بْنِ دِينَارٍ ،  عَنْ  وَهْبِ بْنِ مُنَبِّهٍ ،  عَنْ  أَخِيهِ  ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الرَّجُلَ لَيَسْأَلُنِي الشَّيْءَ فَأَمْنَعُهُ كَيْ تَشْفَعُوا فَتُؤْجَرُوا  .","","Al-Mu'jam al-Kabir 809","","معاوية بن أبي سفيان عن همام بن منبه الصنعاني عن وهب بن منبه عن عمرو بن دينار الأثرم عن سفيان بن عيينة عن هارون بن سعيد بن الهيثم عن عمارة بن وثيمة المصري عن الطبراني","همام بن منبه عن معاوية"
"17894","يُوسُفُ بْنُ مَاهَكَ  عَنْ  مُعَاوِيَةَ  810  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  عَلِيُّ بْنُ الْمَدِينِيِّ ،  ثَنَا  هَارُونُ بْنُ مُسْلِمٍ ،  عَنْ  عَبْدِ اللهِ بْنِ الْأَخْنَسِ ،  عَنْ  يُوسُفَ بْنِ مَاهَكَ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 810","","معاوية بن أبي سفيان عن يوسف بن ماهك الفارسي عن عبيد الله بن الأخنس النخعي عن هارون بن مسلم بن هرمز العجلي عن علي ابن المديني عن معاذ بن المثنى العنبري عن الطبراني","يوسف بن ماهك عن معاوية"
"17895","[19/349]      عَطَاءُ بْنُ أَبِي رَبَاحٍ  عَنْ  مُعَاوِيَةَ  811  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  أَبُو كُرَيْبٍ ،  ثَنَا  عُثْمَانُ بْنُ عَبْدِ الرَّحْمَنِ ،  عَنْ  عُبَيْدَةَ بْنِ حَسَّانَ ،  عَنْ  عَطَاءٍ ،  عَنْ  مُعَاوِيَةَ قَالَ :  أَمَرَنِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنْ لَا آتِيَ أَهْلِي فِي غُرَّةِ الْهِلَالِ  ، وَأَنْ لَا أَتَوَضَّأَ فِي طُهْرَةِ النُّحَاسِ ، وَأَنْ أَسْتَنَّ كُلَّمَا قُمْتُ مِنْ سُنَّتِي  .","","Al-Mu'jam al-Kabir 811","","معاوية بن أبي سفيان عن عطاء بن أبي رباح عن عبيدة بن حسان السنجاري عن عثمان بن عبد الرحمن الطرائفي عن أبو كريب محمد بن العلاء عن الحسين بن إسحاق التستري عن الطبراني","عطاء بن أبي رباح عن معاوية"
"17896","عَبْدُ اللهِ بْنُ عَلِيٍّ  عَنْ  مُعَاوِيَةَ  812  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ  ، ثَنَا  أَبُو الرَّبِيعِ الْحَارِثِيُّ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  عُمَرُ بْنُ سَعِيدٍ ،  حَدَّثَنِي  عَلِيُّ بْنُ عَبْدِ اللهِ ، أَنَّ أَبَاهُ ،  أَخْبَرَهُ  قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَنْهَى عَنْ لُبْسِ الذَّهَبِ وَالْحَرِيرِ  .","","Al-Mu'jam al-Kabir 812","","معاوية بن أبي سفيان عن عبد الله بن علي بن رفاعة العبشمي عن علي بن عبد الله العبشمي عن عمر بن سعيد النوفلي عن روح بن عبادة القيسي عن أبو الربيع الحارثي عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد الله بن علي عن معاوية"
"17897","مَنْ رَوَى عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  مِنْ  أَهْلِ الْبَصْرَةِ  مُطَرِّفُ بْنُ عَبْدِ اللهِ بْنِ الشِّخِّيرِ  عَنْ  مُعَاوِيَةَ  813  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ  ، حَدَّثَنِي  عُبَيْدُ اللهِ بْنُ مُعَاذٍ ،  ثَنَا  أَبِي  ،  ثَنَا  شُعْبَةُ ،  عَنْ  قَتَادَةَ ،  سَمِعَ  مُطَرِّفًا ،  يُحَدِّثُ عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  قَالَ فِي لَيْلَةِ الْقَدْرِ : سَبْعٌ وَعِشْرُونَ  .","","Al-Mu'jam al-Kabir 813","","معاوية بن أبي سفيان عن مطرف بن عبد الله بن الشخير الحرشي عن قتادة بن دعامة عن شعبة بن الحجاج عن معاذ بن معاذ بن نصر عن عبيد الله بن معاذ بن معاذ عن عبد الله بن أحمد بن حنبل عن الطبراني","مطرف بن عبد الله بن الشخير عن معاوية"
"17898","814  -  حَدَّثَنَا  مَحْمُودُ بْنُ مُحَمَّدٍ الْوَاسِطِيُّ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  سَعِيدٍ الْحَرَّانِيِّ ،  عَنْ  يَزِيدَ بْنِ عَبْدِ اللهِ بْنِ الشِّخِّيرِ ،  عَنْ         [19/350]      مُطَرِّفٍ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْتَمِسُوا لَيْلَةَ الْقَدْرِ لَيْلَةَ سَبْعٍ وَعِشْرِينَ  .","","Al-Mu'jam al-Kabir 814","","معاوية بن أبي سفيان عن مطرف بن عبد الله بن الشخير الحرشي عن يزيد بن عبد الله بن الشخير العامري عن سعيد بن إياس الجريري عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن محمود بن محمد بن منويه المفيد عن الطبراني","مطرف بن عبد الله بن الشخير عن معاوية"
"17899","مَعْبَدٌ الْجُهَنِيُّ  عَنْ  مُعَاوِيَةَ  815  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  شُعْبَةُ ،  أَخْبَرَنِي  سَعْدُ بْنُ إِبْرَاهِيمَ قَالَ :  سَمِعْتُ  مَعْبَدًا  قَالَ  :  كَانَ مُعَاوِيَةُ قَلَّمَا يُحَدِّثُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَيَذْكُرُ هَؤُلَاءِ الْكَلِمَاتِ ، يُكْثِرُ أَنْ يُحَدِّثَ بِهِنَّ فِي الْجُمَعِ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  ، وَإِنَّ هَذَا الْمَالَ خَضِرٌ حُلْوٌ فَمَنْ أَخَذَهُ بِحَقِّهِ بُورِكَ فِيهِ ، وَإِيَّاكُمْ وَالتَّمَادُحَ فَإِنَّهُ الذَّبْحُ  .","","Al-Mu'jam al-Kabir 815","","معاوية بن أبي سفيان عن معبد الجهني عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن شعبة بن الحجاج عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","معبد الجهني عن معاوية"
"17900","816  -  حَدَّثَنَا  مُصْعَبُ بْنُ إِبْرَاهِيمَ بْنِ حَمْزَةَ الزُّبَيْرِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَعْبَدٍ الْجُهَنِيِّ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الدُّنْيَا حُلْوَةٌ  خَضِرَةٌ  ، فَمَنْ أَخَذَهَا بِحَقِّهَا بُورِكَ لَهُ فِيهَا  .","","Al-Mu'jam al-Kabir 816","","معاوية بن أبي سفيان عن معبد الجهني عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن إبراهيم بن حمزة الزبيري عن مصعب بن إبراهيم بن حمزة عن الطبراني","معبد الجهني عن معاوية"
"17901","817  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  مَنْصُورُ بْنُ أَبِي مُزَاحِمٍ ،  ثَنَا  إِبْرَاهِيمُ بْنُ سَعْدٍ ،  عَنْ  أَبِيهِ  ،  عَنْ  مَعْبَدٍ الْجُهَنِيِّ  قَالَ  : كَانَ مُعَاوِيَةُ قَلَّمَا يُحَدِّثُ عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ فِي خُطْبَتِهِ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  اتَّقُوا التَّمَادُحَ فَإِنَّهُ الذَّبْحُ  .","","Al-Mu'jam al-Kabir 817","","معاوية بن أبي سفيان عن معبد الجهني عن سعد بن إبراهيم بن عبد الرحمن بن عوف عن إبراهيم بن سعد أبو إسحاق الزهري عن منصور بن أبي مزاحم عن محمد بن عبد الله مطين الحضرمي عن الطبراني","معبد الجهني عن معاوية"
"17902","818  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ         [19/351]      ، بُنْدَارٌ  ثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  أَبِي التَّيَّاحِ ،  عَنْ  مَعْبَدٍ الْجُهَنِيِّ ،  عَنْ  مُعَاوِيَةَ قَالَ :  إِنَّكُمْ لَتُصَلُّونَ هَذِهِ الصَّلَاةَ ، لَقَدْ صَحِبْنَا رَسُولَ اللهِ وَرَأَيْنَاهُ ، فَمَا رَأَيْنَاهُ يُصَلِّي هَذِهِ الصَّلَاةَ بَعْدَ الصَّلَاةِ  ،  يَعْنِي الْعَصْرَ  .","","Al-Mu'jam al-Kabir 818","","معاوية بن أبي سفيان عن معبد الجهني عن يزيد بن حميد الضبعي عن شعبة بن الحجاج عن عثمان بن عمر بن فارس عن محمد بن بشار بندار عن الساجي عن الطبراني","معبد الجهني عن معاوية"
"17903","أَبُو مِجْلَزٍ لَاحِقُ بْنُ حُمَيْدٍ  عَنْ  مُعَاوِيَةَ  819  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ  ، ثَنَا  مُسْلِمُ بْنُ إِبْرَاهِيمَ ، وَعَارِمٌ أَبُو النُّعْمَانِ ، قَالَا :  ثَنَا  حَمَّادُ بْنُ زَيْدٍ ،  ثَنَا  حَبِيبُ بْنُ الشَّهِيدِ ،  عَنْ  أَبِي مِجْلَزٍ ،  أَنَّ  مُعَاوِيَةَ دَخَلَ بَيْتًا فِيهِ  عَبْدُ اللهِ بْنُ عَامِرٍ  ،  وَابْنُ الزُّبَيْرِ  ، فَقَعَدَ  ابْنُ الزُّبَيْرِ  وَقَامَ  عَبْدُ اللهِ بْنُ عَامِرٍ ،  وَكَانَ أَرْزَنَ الرَّجُلَيْنِ ، فَقَالَ  مُعَاوِيَةُ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ سَرَّهُ أَنْ يَتَمَثَّلَ لَهُ الرِّجَالُ قِيَامًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 819","","معاوية بن أبي سفيان عن لاحق بن حميد عن حبيب بن الشهيد عن حماد بن زيد عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو مجلز لاحق بن حميد عن معاوية"
"17904","820  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ  ، ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  حَبِيبِ بْنِ الشَّهِيدِ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ سَرَّهُ أَنْ يَتَمَثَّلَ لَهُ الرِّجَالُ قِيَامًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 820","","معاوية بن أبي سفيان عن لاحق بن حميد عن حبيب بن الشهيد عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","أبو مجلز لاحق بن حميد عن معاوية"
"17905","821  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  وَكِيعٌ         [19/352]      عَنْ  سُفْيَانَ ،  عَنْ  حَبِيبِ بْنِ الشَّهِيدِ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ سَرَّهُ أَنْ يَتَمَثَّلَ لَهُ النَّاسُ قِيَامًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 821","","معاوية بن أبي سفيان عن لاحق بن حميد عن حبيب بن الشهيد عن سفيان الثوري عن وكيع بن الجراح عن أحمد بن حنبل عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو مجلز لاحق بن حميد عن معاوية"
"17906","822  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  حَيَّانُ بْنُ مُوسَى الْمَرْوَزِيُّ ،  ثَنَا  ابْنُ الْمُبَارَكِ ،  عَنْ  سُفْيَانَ ،  عَنْ  حَبِيبِ بْنِ الشَّهِيدِ ،  عَنْ  أَبِي مِجْلَزٍ ،  عَنْ  مُعَاوِيَةَ عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ سَرَّهُ أَنْ يَتَمَثَّلَ لَهُ الرِّجَالُ قِيَامًا  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .","","Al-Mu'jam al-Kabir 822","","معاوية بن أبي سفيان عن لاحق بن حميد عن حبيب بن الشهيد عن سفيان الثوري عن عبد الله بن المبارك عن حبان بن موسى الكشميهني عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","أبو مجلز لاحق بن حميد عن معاوية"
"17907","823  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ  ، ثَنَا  وَهْبُ بْنُ بَقِيَّةَ ،  أَنَا  خَالِدُ بْنُ عَبْدِ اللهِ ،  عَنْ  عِمْرَانَ بْنِ حُدَيْرٍ ،  عَنْ  أَبِي مِجْلَزٍ ،  أَنَّ  مُعَاوِيَةَ قَالَ :  إِنَّ تَسْوِيَةَ الْقُبُورِ مِنَ السُّنَّةِ  ، وَقَدْ رَفَعَتِ الْيَهُودُ وَالنَّصَارَى فَلَا تَشَّبَّهُوا بِهِمَا  .","","Al-Mu'jam al-Kabir 823","","معاوية بن أبي سفيان عن لاحق بن حميد عن عمران بن حدير عن خالد بن عبد الله الطحان عن وهب بن بقية الواسطي عن الحسين بن إسحاق التستري عن الطبراني","أبو مجلز لاحق بن حميد عن معاوية"
"17908","أَبُو شَيْخٍ الْهُنَائِيُّ  عَنْ  مُعَاوِيَةَ  824  -  حَدَّثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ الدَّبَرِيُّ  ، أَنَا  عَبْدُ الرَّزَّاقِ ،  أَنَا  مَعْمَرٌ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي شَيْخٍ الْهُنَائِيِّ ،  أَنَّ  مُعَاوِيَةَ قَالَ لِنَفَرٍ مِنْ أَصْحَابِ النَّبِيِّ         [19/353]      - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  أَتَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَى عَنِ الشُّرْبِ فِي آنِيَةِ الذَّهَبِ وَالْفِضَّةِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ . قَالَ : فَتَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ جُلُودِ  النُّمُورِ  أَنْ يُرْكَبَ عَلَيْهَا  ؟ قَالُوا : اللَّهُمَّ ، نَعَمْ . قَالَ : وَتَعْلَمُونَ أَنَّهُ  نَهَى عَنِ  الْمُتْعَةِ  ،  يَعْنِي مُتْعَةَ  الْحَجِّ  ؟ قَالُوا : اللَّهُمَّ لَا قَالَ : بَلَى  .","","Al-Mu'jam al-Kabir 824","","معاوية بن أبي سفيان عن أبو شيخ الهنائي عن قتادة بن دعامة عن معمر بن راشد عن عبد الرزاق الصنعاني عن إسحاق الدبري عن الطبراني","أبو شيخ الهنائي عن معاوية"
"17909","825  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ، وَأَبُو مُسْلِمٍ الْكَشِّيُّ قَالَا :  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  هَمَّامُ بْنُ يَحْيَى ،  ثَنَا  قَتَادَةُ ،  عَنْ  أَبِي شَيْخٍ الْهُنَائِيِّ ،  قَالَ  :  كُنْتُ فِي مَلَأٍ مِنْ أَصْحَابِ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عِنْدَ مُعَاوِيَةَ فَقَالَ  مُعَاوِيَةُ  :  نَشَدْتُكُمْ  بِاللهِ هَلْ تَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ لُبْسِ الْحَرِيرِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : وَأَنَا أَشْهَدُ قَالَ :  نَشَدْتُكُمْ  بِاللهِ ، هَلْ تَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الشَّرَابِ فِي آنِيَةِ الذَّهَبِ وَالْفِضَّةِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : وَأَنَا أَشْهَدُ  .","","Al-Mu'jam al-Kabir 825","","معاوية بن أبي سفيان عن أبو شيخ الهنائي عن قتادة بن دعامة عن همام بن يحيى بن دينار عن حجاج بن المنهال الأنماطي عن أبو مسلم الكجي عن الطبراني","أبو شيخ الهنائي عن معاوية"
"17910","826  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدِ اللهِ الْحَضْرَمِيُّ  ، ثَنَا  أَحْمَدُ بْنُ رَاشِدٍ ،  ثَنَا  يَزِيدُ بْنُ زُرَيْعٍ ،  ثَنَا  سَعِيدُ بْنُ أَبِي عَرُوبَةَ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي شَيْخٍ الْهُنَائِيِّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ وَعِنْدَهُ رَهْطٌ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أَنْشُدُكُمْ  بِاللهِ هَلْ تَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ لُبْسِ الْحَرِيرِ ؟ قَالُوا : اللَّهُمَّ نَعَمْ  .","","Al-Mu'jam al-Kabir 826","","معاوية بن أبي سفيان عن أبو شيخ الهنائي عن قتادة بن دعامة عن سعيد بن أبي عروبة عن يزيد بن زريع العيشي عن أحمد بن راشد بن خثيم الكوفي عن محمد بن عبد الله مطين الحضرمي عن الطبراني","أبو شيخ الهنائي عن معاوية"
"17911","827  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى  ، ثَنَا  مُسَدَّدٌ ،  ثَنَا  يَحْيَى ،  عَنْ  هِشَامِ بْنِ أَبِي عَبْدِ اللهِ ،  ثَنَا  قَتَادَةُ ،  عَنْ  أَبِي شَيْخٍ الْهُنَائِيِّ ،  أَنَّ  مُعَاوِيَةَ قَالَ يَوْمًا وَعِنْدَهُ أَصْحَابُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : أَتَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى         [19/354]      اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ لُبْسِ الذَّهَبِ إِلَّا  مُقَطَّعًا  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : أَتَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الرُّكُوبِ عَلَى جُلُودِ  النِّمَارِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : أَتَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ جَمْعٍ بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  ؟ قَالُوا : اللَّهُمَّ لَا  .","","Al-Mu'jam al-Kabir 827","","معاوية بن أبي سفيان عن أبو شيخ الهنائي عن قتادة بن دعامة عن هشام الدستوائي عن يحيى القطان عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو شيخ الهنائي عن معاوية"
"17912","828  -  حَدَّثَنَا  مُحَمَّدُ بْنُ إِسْحَاقَ بْنِ رَاهَوَيْهِ ،  ثَنَا  عَلِيُّ بْنُ خَشْرَمٍ ،  ثَنَا  الْفَضْلُ بْنُ مُوسَى ،  عَنْ  مُحَمَّدِ بْنِ عُبَيْدِ اللهِ الْعَرْزَمِيِّ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي شَيْخٍ الْهُنَائِيِّ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَهُ .","","Al-Mu'jam al-Kabir 828","","معاوية بن أبي سفيان عن أبو شيخ الهنائي عن قتادة بن دعامة عن محمد بن عبيد الله بن أبي سليمان العرزمي عن الفضل بن موسى السيناني عن علي بن خشرم عن محمد بن إسحاق الحنظلي عن الطبراني","أبو شيخ الهنائي عن معاوية"
"17913","829  -  حَدَّثَنَا  مُحَمَّدُ بْنُ صَالِحِ بْنِ الْوَلِيدِ النَّرْسِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  عُثْمَانُ بْنُ عُمَرَ ،  ثَنَا  بَيْهَسُ بْنُ فَهْدَانَ ،  عَنْ  أَبِي شَيْخٍ الْهُنَائِيِّ  قَالَ  :  كُنْتُ عِنْدَ مُعَاوِيَةَ وَعِنْدَهُ نَاسٌ مِنَ  الْمُهَاجِرِينَ  وَالْأَنْصَارِ  فَقَالَ  مُعَاوِيَةُ  :  أَنْشُدُكُمُ  اللهَ أَلَسْتُمْ تَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ لُبْسِ الذَّهَبِ إِلَّا  مُقَطَّعًا  ؟  قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : أَلَسْتُمْ تَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الشُّرْبِ فِي آنِيَةِ الْفِضَّةِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : أَلَسْتُمْ تَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى أَنْ يُجْمَعَ بَيْنَ  الْحَجِّ  وَالْعُمْرَةِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ  .","","Al-Mu'jam al-Kabir 829","","معاوية بن أبي سفيان عن أبو شيخ الهنائي عن بيهس بن فهدان الهنائي عن عثمان بن عمر بن فارس عن أبو موسى الزمن عن محمد بن صالح النرسي عن الطبراني","أبو شيخ الهنائي عن معاوية"
"17914","حِمَّانُ أَخُو أَبِي شَيْخٍ الْهُنَائِيِّ  عَنْ  مُعَاوِيَةَ  830  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ الدِّمَشْقِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  شُعَيْبُ         [19/355]      بْنُ إِسْحَاقَ ،  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  حَدَّثَنِي  أَبُو شَيْخٍ الْهُنَائِيُّ ،  حَدَّثَنِي  حِمَّانُ  ،  قَالَ  :  حَجَّ مُعَاوِيَةُ فَدَعَا نَفَرًا مِنَ  الْأَنْصَارِ  ، فَقَالَ :  أَنْشُدُكُمُ  اللهَ أَلَمْ تَعْلَمُوا أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الذَّهَبِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : وَأَنَا أَشْهَدُ قَالَ :  أَنْشُدُكُمُ  اللهَ أَلَمْ تَسْمَعُوا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ  صُفَفِ  الْحَرِيرِ  ؟ فَقَالُوا : اللَّهُمَّ نَعَمْ قَالَ :  أَنْشُدُكُمُ  اللهَ أَلَمْ تَسْمَعُوا أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  يَنْهَى عَنْ  صُفَفِ  النُّمُورِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : وَأَنَا أَشْهَدُ .","","Al-Mu'jam al-Kabir 830","","معاوية بن أبي سفيان عن حمان الهنائي عن أبو شيخ الهنائي عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن شعيب بن إسحاق الدمشقي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","حمان أخو أبي شيخ الهنائي عن معاوية"
"17915","831  -  حَدَّثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ سَهْلِ بْنِ مُحَمَّدٍ الْعَسْكَرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ يَحْيَى بْنِ فَيَّاضٍ الزِّمَّانِيُّ ،  ثَنَا  عَبْدُ الصَّمَدِ بْنُ عَبْدِ الْوَارِثِ ،  ثَنَا  حَرْبُ بْنُ شَدَّادٍ ،  عَنْ  يَحْيَى بْنِ أَبِي كَثِيرٍ ، أَنَّ  أَبَا شَيْخٍ  حَدَّثَهُ  عَنْ  أَخِيهِ حِمَّانَ  أَنَّهُ  شَهِدَ  مُعَاوِيَةَ وَعِنْدَهُ نَاسٌ مِنْ أَصْحَابِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أَنْشُدُكُمُ  اللهَ أَتَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ لُبْسِ الذَّهَبِ إِلَّا  مُقَطَّعًا  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : وَأَنَا أَشْهَدُ قَالَ :  أَنْشُدُكُمُ  اللهَ أَتَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ رُكُوبِ جُلُودِ  النِّمَارِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : وَأَنَا أَشْهَدُ .","","Al-Mu'jam al-Kabir 831","","معاوية بن أبي سفيان عن حمان الهنائي عن أبو شيخ الهنائي عن يحيى بن أبي كثير عن حرب بن شداد اليشكري عن عبد الصمد بن عبد الوارث التنوري عن محمد بن يحيى بن فياض الزماني عن محمد بن يحيى بن سهل بن محمد العسكري عن الطبراني","حمان أخو أبي شيخ الهنائي عن معاوية"
"17916","832  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  شُعَيْبُ بْنُ إِسْحَاقَ ،  ثَنَا  الْأَوْزَاعِيُّ ،  حَدَّثَنِي  يَحْيَى بْنُ أَبِي كَثِيرٍ ،  حَدَّثَنِي  أَبُو شَيْخٍ ،  حَدَّثَنِي  حِمَّانُ  ،  قَالَ  :  حَجَّ مُعَاوِيَةُ فَدَعَا نَفَرًا مِنَ  الْأَنْصَارِ  فِي  الْكَعْبَةِ  ، فَقَالَ :  أَنْشُدُكُمُ  اللهَ أَلَمْ تَسْمَعُوا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ         [19/356]      وَسَلَّمَ -  نَهَى عَنِ الذَّهَبِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : وَأَنَا أَشْهَدُ ، أَلَمْ تَسْمَعُوا أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ  صُفَفِ  النُّمُورِ  ؟ قَالُوا : نَعَمْ قَالَ : وَأَنَا أَشْهَدُ ، أَلَمْ تَسْمَعُوا أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ الْحَرِيرِ  ؟ قَالُوا : اللَّهُمَّ نَعَمْ قَالَ : وَأَنَا أَشْهَدُ  .","","Al-Mu'jam al-Kabir 832","","معاوية بن أبي سفيان عن حمان الهنائي عن أبو شيخ الهنائي عن يحيى بن أبي كثير عن أبو عمرو الأوزاعي عن شعيب بن إسحاق الدمشقي عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","حمان أخو أبي شيخ الهنائي عن معاوية"
"17917","مُحَمَّدُ بْنُ سِيرِينَ  عَنْ  مُعَاوِيَةَ  833  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ ،  ثَنَا  أَبُو الْخَطَّابِ زِيَادُ بْنُ يَحْيَى ،  ثَنَا  الْهَيْثَمُ بْنُ الرَّبِيعِ ،  ثَنَا  سَرَّارُ بْنُ مُجَشِّرٍ أَبُو عُبَيْدَةَ الْعَنَزِيُّ ،  عَنْ  هِشَامِ بْنِ حَسَّانَ ،  عَنْ  مُحَمَّدِ بْنِ سِيرِينَ ،  قَالَ  :  لَمَّا بَايَعَ مُعَاوِيَةُ  لِيَزِيدَ  حَجَّ ، فَمَرَّ  بِالْمَدِينَةِ  فَخَطَبَ النَّاسَ ، فَقَالَ :  إِنَّا قَدْ بَايَعْنَا  يَزِيدَ  فَبَايِعُوا  ، فَقَامَ الْحُسَيْنُ بْنُ عَلِيٍّ - رَضِيَ اللهُ عَنْهُ - فَقَالَ : أَنَا وَاللهِ أَحَقُّ بِهَا مِنْهُ ، فَإِنَّ أَبِي خَيْرٌ مِنْ أَبِيهِ ، وَجَدِّي خَيْرٌ مِنْ جَدِّهِ ، وَإِنَّ أُمِّي خَيْرٌ مِنْ أُمِّهِ ، وَأَنَا خَيْرٌ مِنْهُ ، فَقَالَ  مُعَاوِيَةُ  : أَمَّا مَا ذَكَرْتَ أَنَّ جَدَّكَ خَيْرٌ مِنْ جَدِّهِ فَصَدَقْتَ ، رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَيْرٌ مِنْ  أَبِي سُفْيَانَ بْنِ حَرْبٍ  ، وَأَمَّا مَا ذَكَرْتَ أَنَّ أُمَّكَ خَيْرٌ مِنْ أُمِّهِ فَصَدَقْتَ ،  فَاطِمَةُ  بِنْتُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - خَيْرٌ مِنْ  بِنْتِ مِجْدَلٍ  ، وَأَمَّا مَا ذَكَرْتَ أَنَّ أَبَاكَ خَيْرٌ مِنْ أَبِيهِ فَقَدْ قَارَعَ أَبُوهُ أَبَاكَ فَقَضَى اللهُ لِأَبِيهِ عَلَى أَبِيكَ ، وَأَمَّا مَا ذَكَرْتَ أَنَّكَ خَيْرٌ مِنْهُ فَلَهُوَ أَرَبُّ مِنْكُ وَأَعْقَلُ ، مَا يَسُرُّنِي بِهِ مِثْلُكَ أَلْفٌ  .","","Al-Mu'jam al-Kabir 833","","الحسين بن علي عن محمد بن سيرين عن هشام بن حسان العتكي عن سرار بن مجشر العنزي عن الهيثم بن الربيع العقيلي عن زياد بن يحيى الحساني عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","محمد بن سيرين عن معاوية"
"17918","مُحَارِبٌ أَبُو مَسْلَمَةَ  عَنْ  مُعَاوِيَةَ  834  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ نَائِلَةَ الْأَصْبَهَانِيُّ ،  ثَنَا  شَبَابٌ الْعُصْفُرِيُّ ،         [19/357]      ثَنَا  عَوْنُ بْنُ كَهْمَسٍ ،  ثَنَا  مَسْلَمَةُ بْنُ مُحَارِبٍ ،  عَنْ  أَبِيهِ  ، قَالَ :  كَتَبَ  مُعَاوِيَةُ إِلَى  زِيَادٍ  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ الْعَدُوَّ لَا يَظْهَرُ عَلَى قَوْمٍ إِذَا هُمْ ،  أَوْ قَالَ : رَأَيْتُهُمْ مَعَ رَجُلٍ مِنْ  بَنِي بَكْرِ بْنِ وَائِلٍ  .","","Al-Mu'jam al-Kabir 834","","معاوية بن أبي سفيان عن محارب الزيادي عن مسلمة بن محارب الزيادي عن عون بن كهمس التميمي عن خليفة بن خياط عن ابن نائلة إبراهيم بن محمد بن الحارث الأصبهاني عن الطبراني","محارب أبو مسلمة عن معاوية"
"17919","الْحَسَنُ بْنُ أَبِي الْحَسَنِ  عَنْ  مُعَاوِيَةَ  835  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُثَنَّى ،  ثَنَا  مُعَاذُ بْنُ هِشَامٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  قَتَادَةَ ،  عَنِ  الْحَسَنِ قَالَ :  قَالَ  مُعَاوِيَةُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا يَزْدَادُ الْأَمْرُ إِلَّا شِدَّةً ، وَلَا يَزْدَادُ النَّاسُ إِلَّا  شُحًّا  ، وَلَا تَقُومُ السَّاعَةُ إِلَّا عَلَى شِرَارِ النَّاسِ  .","","Al-Mu'jam al-Kabir 835","","معاوية بن أبي سفيان عن الحسن البصري عن قتادة بن دعامة عن هشام الدستوائي عن معاذ بن هشام الدستوائي عن أبو موسى الزمن عن الساجي عن الطبراني","الحسن بن أبي الحسن عن معاوية"
"17920","أَيُّوبُ بْنُ عَبْدِ اللهِ بْنِ يَسَارٍ  عَنْ  مُعَاوِيَةَ  836  -  حَدَّثَنَا  مُحَمَّدُ بْنُ اللَّيْثِ الْجَوْهَرِيُّ  ثَنَا  مُحَمَّدُ بْنُ سُلَيْمَانَ لُوَيْنٌ ،  ثَنَا  أَبُو مَعْشَرٍ الْبَرَّاءُ ،  ثَنَا  عَبْدُ اللهِ بْنُ أَبِي عُثْمَانَ ،  ثَنَا  أَيُّوبُ بْنُ عَبْدِ اللهِ بْنِ يَسَارٍ ، قَالَ :  سَمِعْتُ  مُعَاوِيَةَ ، وَهُوَ  بِمَكَّةَ  يَوْمَ عَاشُورَاءَ يَقُولُ : صَامَهُ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَقَالَ :  مَنْ لَمْ يَكُنْ صَامَ مِنْكُمْ فَلْيَصُمْهُ  .","","Al-Mu'jam al-Kabir 836","","معاوية بن أبي سفيان عن أيوب بن عبد الله بن يسار البصري عن عبد الله بن أبي عثمان البصري عن يوسف بن يزيد البراء عن محمد بن سليمان لوين عن محمد بن الليث الجوهري عن الطبراني","أيوب بن عبد الله بن يسار عن معاوية"
"17921","أَبُو قِلَابَةَ الْجَرْمِيُّ  عَنْ  مُعَاوِيَةَ  837  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  ثَنَا  أَبُو كَامِلٍ الْجَحْدَرِيُّ ،         [19/358]      ثَنَا  سُفْيَانُ بْنُ حَبِيبٍ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  مُعَاوِيَةَ قَالَ :  نَهَى رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَنْ لُبْسِ الذَّهَبِ إِلَّا  مُقَطَّعًا  ، وَعَنْ رُكُوبِ  النِّمَارِ  .","","Al-Mu'jam al-Kabir 837","","معاوية بن أبي سفيان عن أبو قلابة الجرمي عن خالد الحذاء عن سفيان بن حبيب البصري عن فضيل بن حسين الجحدري عن عبد الله بن أحمد بن حنبل عن الطبراني","أبو قلابة الجرمي عن معاوية"
"17922","838  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  مُسَدَّدٌ ،  ثَنَا  إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ ،  عَنْ  خَالِدٍ الْحَذَّاءِ ،  عَنْ  مَيْمُونٍ الْقَنَّادِ ،  عَنْ  أَبِي قِلَابَةَ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ : أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنْ رُكُوبِ  النِّمَارِ  ، وَعَنْ لُبْسِ الذَّهَبِ إِلَّا  مُقَطَّعًا  .","","Al-Mu'jam al-Kabir 838","","معاوية بن أبي سفيان عن أبو قلابة الجرمي عن ميمون القناد عن خالد الحذاء عن إسماعيل ابن علية عن مسدد بن مسرهد عن معاذ بن المثنى العنبري عن الطبراني","أبو قلابة الجرمي عن معاوية"
"17923","أَبُو مَيْمُونَةَ  عَنْ  مُعَاوِيَةَ  839  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ ، وَأَبُو زَيْدٍ الْحَوْطِيَّانِ قَالَا :  ثَنَا  أَبُو الْمُغِيرَةِ ،  ثَنَا  سَعِيدُ بْنُ بَشِيرٍ ،  عَنْ  قَتَادَةَ ،  عَنْ  أَبِي مَيْمُونَةَ قَالَ :  قَالَ  مُعَاوِيَةُ بْنُ أَبِي سُفْيَانَ :  إِنَّ  أَهْلَ مَكَّةَ  أَخْرَجُوا رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَا تَكُونُ فِيهِمُ الْخِلَافَةُ  ، وَإِنَّ  أَهْلَ الْمَدِينَةِ  قَتَلُوا  عُثْمَانَ  - رَضِيَ اللهُ عَنْهُ - فَلَا تَعُودُ الْخِلَافَةُ فِيهِمْ أَبَدًا  .","","Al-Mu'jam al-Kabir 839","","معاوية بن أبي سفيان عن أبو ميمونة الفارسي الأبار عن قتادة بن دعامة عن سعيد بن بشير الأزدي عن عبد القدوس بن الحجاج عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","أبو ميمونة عن معاوية"
"17924","مَنْ رَوَى عَنْ  مُعَاوِيَةَ  مِنْ  أَهْلِ الْكُوفَةِ  قَيْسُ بْنُ أَبِي حَازِمٍ  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  - رَضِيَ اللهُ عَنْهُ -  840  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ ،  ثَنَا  عُمَرُ بْنُ إِسْمَاعِيلَ بْنِ مُجَالِدٍ ،  حَدَّثَنِي  أَبِي  ،  عَنْ  بَيَانٍ ،  عَنْ  قَيْسٍ  عَنْ  مُعَاوِيَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَزَالُ أُمَّتِي ظَاهِرِينَ عَلَى النَّاسِ حَتَّى يَأْتِيَ أَمْرُ اللهِ  .","","Al-Mu'jam al-Kabir 840","","معاوية بن أبي سفيان عن قيس بن أبي حازم عن بيان بن بشر الأحمسي عن إسماعيل بن مجالد بن سعيد الهمداني عن عمر بن إسماعيل بن مجالد الهمداني عن عبد الله بن أحمد بن حنبل عن الطبراني","قيس بن أبي حازم عن معاوية بن أبي سفيان رضي الله عنه"
"17925","[19/359]      أَبُو بُرْدَةَ بْنُ أَبِي مُوسَى  عَنْ  مُعَاوِيَةَ  841  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  فَرْوَةُ بْنُ أَبِي الْمَغْرَاءِ ،  ثَنَا  الْقَاسِمُ بْنُ مَالِكٍ الْمُزَنِيُّ ،  ثَنَا  عَاصِمُ بْنُ كُلَيْبٍ ،  عَنْ  أَبِي بُرْدَةَ بْنِ أَبِي مُوسَى الْأَشْعَرِيِّ ،  قَالَ  :  دَخَلْتُ عَلَى مُعَاوِيَةَ ، وَهُوَ يَتَضَوَّرُ وَقَرْحُهُ بَيْنَ كَتِفَيْهِ ، فَقَالَ : مَا يَسُرُّنِي أَنِّي لَا أَجِدُ مَا تَرَى ، سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ أَذًى يُصِيبُ الْمُؤْمِنَ فِي جَسَدِهِ إِلَّا كَانَ كَفَّارَةً لِخَطَايَاهُ  .","","Al-Mu'jam al-Kabir 841","","معاوية بن أبي سفيان عن أبو بردة بن أبي موسى الأشعري عن عاصم بن كليب الجرمي عن القاسم بن مالك المزني عن فروة بن أبي المغراء الكندي عن محمد بن عثمان بن أبي شيبة عن الطبراني","أبو بردة بن أبي موسى عن معاوية"
"17926","842  -  حَدَّثَنَا  أَبُو حُصَيْنِ بْنُ مُحَمَّدِ بْنِ الْحَسَنِ الْوَادِعِيُّ الْقَاضِي ،  ثَنَا  عُبَيْدُ بْنُ يَعِيشَ ،  ثَنَا  يُونُسُ بْنُ بُكَيْرٍ ،  ثَنَا  طَلْحَةُ بْنُ يَحْيَى ،  عَنْ  أَبِي بُرْدَةَ بْنِ أَبِي مُوسَى ،  قَالَ  :  دَخَلْتُ عَلَى مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، وَبِظَهْرِهِ قُرْحَةٌ وَهُوَ يَتَأَوَّهُ مِنْهَا تَأَوُّهًا شَدِيدًا ، فَقُلْتُ : أَكُلُّ هَذَا مِنْ هَذِهِ ؟ فَقَالَ :  مَا يَسُرُّنِي أَنَّ هَذَا التَّأَوُّهَ لَمْ يَكُنْ  ، ثُمَّ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ مُسْلِمٍ يُصِيبُهُ أَذًى فِي جَسَدِهِ إِلَّا كَانَ كَفَّارَةً لِخَطَايَاهُ  ، وَهَذَا أَشَدُّ الْأَذَى  .","","Al-Mu'jam al-Kabir 842","","معاوية بن أبي سفيان عن أبو بردة بن أبي موسى الأشعري عن طلحة بن يحيى بن طلحة التيمي عن يونس بن بكير عن عبيد بن يعيش عن محمد بن الحسين بن حبيب الوادعي عن الطبراني","أبو بردة بن أبي موسى عن معاوية"
"17927","أَبُو عَبْدِ اللهِ الْجَدَلِيُّ  ، وَاسْمُهُ  مَعْبَدُ بْنُ مَعْبَدٍ  ، وَقِيلَ :  عَبْدُ بْنُ عَبْدٍ  ، وَقِيلَ :  عَبْدُ الرَّحْمَنِ بْنُ عَبْدٍ  عَنْ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُ  843  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَمْرُو بْنُ عَوْنٍ الْوَاسِطِيُّ ،  ثَنَا  هُشَيْمٌ ،  عَنْ  مُغِيرَةَ ،  عَنْ  مَعْبَدِ بْنِ خَالِدٍ ،  عَنْ  عَبْدِ بْنِ عَبْدٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ ،         [19/360]      يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ  شَرِبَ  الْخَمْرَ فَاضْرِبُوهُ  ، فَإِنْ عَادَ فَاضْرِبُوهُ ، ثُمَّ إِنْ عَادَ فَاقْتُلُوهُ  .","","Al-Mu'jam al-Kabir 843","","معاوية بن أبي سفيان عن عبد بن عبد الجدلي عن معبد بن خالد بن مزين الجدلي عن المغيرة بن مقسم الضبي عن هشيم بن بشير عن عمرو بن عون الواسطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","أبو عبد الله الجدلي واسمه معبد بن معبد وقيل عبد بن عبد وقيل عبد الرحمن بن عبد عن معاوية"
"17928","844  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ هَاشِمٍ ،  ثَنَا  كَثِيرُ بْنُ يَحْيَى ،  ثَنَا  أَبُو عَوَانَةَ ،  عَنْ  مُغِيرَةَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ الْجَدَلِيِّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ  شَرِبَ  الْخَمْرَ فَاجْلِدُوهُ  ، فَإِنْ عَادَ فَاجْلِدُوهُ ، فَإِنْ عَادَ فَاجْلِدُوهُ ، ثَلَاثًا ، فَإِنْ عَادَ الرَّابِعَةَ فَاضْرِبُوا عُنُقَهُ  .","","Al-Mu'jam al-Kabir 844","","معاوية بن أبي سفيان عن عبد بن عبد الجدلي عن المغيرة بن مقسم الضبي عن الوضاح بن عبد الله اليشكري عن كثير بن يحيى بن كثير الشيعي عن إبراهيم بن هاشم البغوي عن الطبراني","أبو عبد الله الجدلي واسمه معبد بن معبد وقيل عبد بن عبد وقيل عبد الرحمن بن عبد عن معاوية"
"17929","845  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ حَفْصٍ الْأُبُلِّيُّ ،  ثَنَا  مُعْتَمِرُ بْنُ سُلَيْمَانَ ،  عَنْ  أَبِيهِ  ،  عَنْ  مُغِيرَةَ ،  عَنْ  مَعْبَدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ الْجَدَلِيِّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ  شَرِبَ  الْخَمْرَ فَاجْلِدُوهُ  ، فَإِنْ عَادَ فَاجْلِدُوهُ ، فَإِنْ عَادَ فَاجْلِدُوهُ ، فَإِنْ عَادَ الرَّابِعَةَ فَاضْرِبُوا عُنُقَهُ  .","","Al-Mu'jam al-Kabir 845","","معاوية بن أبي سفيان عن عبد بن عبد الجدلي عن المغيرة بن مقسم الضبي عن سليمان بن طرخان عن معتمر بن سليمان عن إسماعيل بن حفص بن عمر بن دينار الأبلي عن الحسين بن إسحاق التستري عن الطبراني","أبو عبد الله الجدلي واسمه معبد بن معبد وقيل عبد بن عبد وقيل عبد الرحمن بن عبد عن معاوية"
"17930","846  -  حَدَّثَنَا  عَبْدُ الرَّحْمَنِ بْنُ سَلْمٍ الرَّازِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حُمَيْدٍ ،  ثَنَا  حَكَّامُ بْنُ مُسْلِمٍ ،  عَنْ  سُفْيَانَ ،  عَنْ  مَعْبَدِ بْنِ خَالِدٍ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَبْدٍ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ  شَرِبَ  الْخَمْرَ فَاجْلِدُوهُ  ، فَإِنْ عَادَ فَاجْلِدُوهُ ، فَإِنْ عَادَ فَاجْلِدُوهُ ، فَإِنْ عَادَ فَاجْلِدُوهُ ، فَإِنْ رَبَّعَ فَاقْتُلُوهُ  .","","Al-Mu'jam al-Kabir 846","","معاوية بن أبي سفيان عن عبد بن عبد الجدلي عن معبد بن خالد بن مزين الجدلي عن سفيان الثوري عن حكام بن سلم الكناني عن محمد بن حميد الرازي عن عبد الرحمن بن محمد بن سلم الرازي عن الطبراني","أبو عبد الله الجدلي واسمه معبد بن معبد وقيل عبد بن عبد وقيل عبد الرحمن بن عبد عن معاوية"
"17931","عَبْدُ اللهِ بْنُ أَبِي الْهُذَيْلِ  عَنْ  مُعَاوِيَةَ  847  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  مُحَمَّدُ بْنُ جَعْفَرٍ ،  ثَنَا  شُعْبَةُ (  ح  ) .         [19/361]      وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  مَحْمُودُ بْنُ غَيْلَانَ ،  ثَنَا  النَّضْرُ بْنُ شُمَيْلٍ ،  ثَنَا  شُعْبَةُ ،  عَنْ  حَبِيبِ بْنِ الزُّبَيْرِ ،  عَنْ  عَبْدِ اللهِ بْنِ أَبِي الْهُذَيْلِ ، قَالَ :  كَتَبَ  مُعَاوِيَةُ إِلَى  عَمْرٍو  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  قُرَيْشٌ  وُلَاةُ النَّاسِ فِي الْخَيْرِ وَالشَّرِّ  إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 847","","معاوية بن أبي سفيان عن عبد الله بن أبي الهذيل الغنوي عن حبيب بن الزبير بن مشكان الهلالي عن شعبة بن الحجاج عن النضر بن شميل عن محمود بن غيلان المروزي عن الحسين بن إسحاق التستري عن الطبراني","عبد الله بن أبي الهذيل عن معاوية"
"17932","عَمْرُو بْنُ يَحْيَى الْقُرَشِيُّ  عَنْ  مُعَاوِيَةَ  848  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  أَبُو نُعَيْمٍ ،  ثَنَا  سُفْيَانُ ،  عَنْ  جَابِرٍ  عَنْ  عَمْرِو بْنِ يَحْيَى الْقُرَشِيِّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ :  لَعَنَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - الَّذِينَ يُشَقِّقُونَ الْخُطَبَ  تَشْقِيقَ  الشِّعْرِ  .","","Al-Mu'jam al-Kabir 848","","معاوية بن أبي سفيان عن عمرو بن يحيى بن سعيد السعيدي عن جابر الجعفي عن سفيان الثوري عن الفضل بن دكين عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عمرو بن يحيى القرشي عن معاوية"
"17933","أَبُو إِسْحَاقَ الْهَمْدَانِيُّ  عَنْ  مُعَاوِيَةَ  849  -  حَدَّثَنَا  مُطَّلِبُ بْنُ شُعَيْبٍ الْأَزْدِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ صَالِحٍ ،  حَدَّثَنِي  اللَّيْثُ ،  عَنْ  أَبِي إِسْحَاقَ الْهَمْدَانِيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ دَعَا بِهَؤُلَاءِ الْكَلِمَاتِ الْخَمْسِ لَمْ يَسْأَلِ اللهَ شَيْئًا إِلَّا أَعْطَاهُ  : لَا إِلَهَ إِلَّا اللهُ وَاللهُ أَكْبَرُ ، لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ ، لَا إِلَهَ إِلَّا اللهُ وَلَا  حَوْلَ  وَلَا قُوَّةَ إِلَّا بِاللهِ  .","","Al-Mu'jam al-Kabir 849","","معاوية بن أبي سفيان عن أبو إسحاق السبيعي عن الليث بن سعد عن عبد الله بن صالح المصري عن مطلب بن شعيب بن حيان المروزي عن الطبراني","أبو إسحاق الهمداني عن معاوية"
"17934","عَبْدُ الْمَلِكِ بْنُ عُمَيْرٍ  عَنْ  مُعَاوِيَةَ  850  -  حَدَّثَنَا  مُحَمَّدُ بْنُ عُثْمَانَ بْنِ أَبِي شَيْبَةَ ،  ثَنَا  مُحَمَّدُ بْنُ         [19/362]      عَبْدِ اللهِ بْنِ نُمَيْرٍ ،  ثَنَا  أَبِي  ،  عَنْ  إِسْمَاعِيلَ بْنِ إِبْرَاهِيمَ بْنِ مُهَاجِرٍ ،  عَنْ  عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ قَالَ :  قَالَ  مُعَاوِيَةُ :  مَا زِلْتُ أَطْمَعُ فِي الْخِلَافَةِ  مُنْذُ قَالَ لِي رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  إِنْ مَلَكْتَ فَأَحْسِنْ  .","","Al-Mu'jam al-Kabir 850","","معاوية بن أبي سفيان عن عبد الملك بن عمير القبطي عن إسماعيل بن إبراهيم بن مهاجر النخعي عن عبد الله بن نمير عن محمد بن عبد الله بن نمير عن محمد بن عثمان بن أبي شيبة عن الطبراني","عبد الملك بن عمير عن معاوية"
"17935","مَعْنُ بْنُ عَلِيٍّ  عَنْ  مُعَاوِيَةَ  851  -  حَدَّثَنَا  حَفْصُ بْنُ عُمَرَ بْنِ الصَّبَّاحِ الرَّقِّيُّ ،  ثَنَا  الْعَلَاءُ بْنُ هِلَالٍ ،  ثَنَا  عُبَيْدُ اللهِ بْنُ عُمَرَ ،  عَنْ  زَيْدِ بْنِ أَبِي أُنَيْسَةَ ،  عَنْ  عِيَاضِ بْنِ مُرَّةَ ،  عَنْ  أَبِي الْفَيَّاضِ  ،  عَنْ  مَعْنِ بْنِ عَلِيٍّ ،  قَالَ  :  صَلَّيْتُ مَعَ مُعَاوِيَةَ أَمِيرِ الْمُؤْمِنِينَ فَقَامَ فِي الرَّكْعَةِ الثَّانِيَةِ فَسَبَّحَ بِهِ النَّاسُ ، فَأَوْمَأَ إِلَيْهِمْ بِيَدِهِ أَنْ قُومُوا ، فَلَمَّا قَضَى صَلَاتَهُ سَجَدَ لِذَلِكَ سَجْدَتَيْنِ ثُمَّ انْصَرَفَ ، وَقَالَ :  هَكَذَا رَأَيْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَعَلَ  .  كذا ، والصواب : (أبي الفيض).","","Al-Mu'jam al-Kabir 851","","معاوية بن أبي سفيان عن معن بن علي السلمي عن موسى بن أيوب المهري عن عياض بن مرة عن زيد بن أبي أنيسة الجزري عن عبيد الله بن عمرو بن أبي الوليد عن العلاء بن هلال الباهلي عن حفص بن عمر سنجة ألف عن الطبراني","معن بن علي عن معاوية"
"17936","عَبْدُ اللهِ بْنُ بُرَيْدَةَ الْأَسْلَمِيُّ  عَنْ  مُعَاوِيَةَ  852  -  حَدَّثَنَا  سَهْلُ بْنُ مُوسَى شِيرَانُ الرَّامَهُرْمُزِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ أَبِي صَفْوَانَ الثَّقَفِيُّ ،  ثَنَا  يَحْيَى بْنُ كَثِيرٍ الْعَنْبَرِيُّ ،  ثَنَا  الْمُغِيرَةُ أَبُو سَلَمَةَ الْخُرَاسَانِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ بُرَيْدَةَ ،  أَنَّ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ أَحَبَّ أَنْ يَتَمَثَّلَ لَهُ بَنُو آدَمَ قِيَامًا وَجَبَتْ لَهُ النَّارُ  .","","Al-Mu'jam al-Kabir 852","","معاوية بن أبي سفيان عن عبد الله بن بريدة عن المغيرة بن مسلم القسملي عن يحيى بن كثير العنبري عن محمد بن عثمان بن أبي صفوان الثقفي عن شيران سهل بن موسى الرامهرمزي عن الطبراني","عبد الله بن بريدة الأسلمي عن معاوية"
"17937","[19/363]      853  -  حَدَّثَنَا  أَسْلَمُ بْنُ سَهْلٍ الْوَاسِطِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ حَرْبٍ النَّشَائِيُّ ،  ثَنَا  عَلِيُّ بْنُ عَاصِمٍ ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  خَيْرُكُمْ خَيْرُكُمْ لِأَهْلِهِ  .","","Al-Mu'jam al-Kabir 853","","معاوية بن أبي سفيان عن عبد الله بن بريدة عن سعيد بن إياس الجريري عن علي بن عاصم بن صهيب عن محمد بن حرب النشائي عن بحشل عن الطبراني","عبد الله بن بريدة الأسلمي عن معاوية"
"17938","854  -  حَدَّثَنَا  حَجَّاجُ بْنُ عِمْرَانَ السَّدُوسِيُّ ،  ثَنَا  يَحْيَى بْنُ خَلَفٍ الْجُوبَارِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  سَعِيدٍ الْجُرَيْرِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ بُرَيْدَةَ ،  عَنْ  مُعَاوِيَةَ ، قَالَ :  خَرَجَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - عَلَى رُفْقَةٍ مُجْتَمِعِينَ ، فَقَالَ : مَا جَمَعَكُمْ ؟ فَقَالُوا : نَذْكُرُ اللهَ وَمَا أَنْعَمَ بِهِ عَلَيْنَا وَمَا اسْتَنْقَذَنَا بِهِ مِنَ الْجَاهِلِيَّةِ وَجَهْلِهَا ، فَقَالَ : آللهِ لِذَاكَ جَمْعُكُمْ ؟ قَالُوا : نَعَمْ قَالَ :  وَالَّذِي نَفْسِي بِيَدِهِ إِنْ كُنْتُمْ صَادِقِينَ ، إِنَّ اللهَ تَعَالَى  لَيُبَاهِي  بِكُمُ الْمَلَائِكَةَ  .","","Al-Mu'jam al-Kabir 854","","معاوية بن أبي سفيان عن عبد الله بن بريدة عن سعيد بن إياس الجريري عن عبد الأعلى بن عبد الأعلى القرشي عن يحيى بن خلف الجوباري عن حجاج بن عمران السدوسي عن الطبراني","عبد الله بن بريدة الأسلمي عن معاوية"
"17939","أَبُو أُمَيَّةَ الثَّقَفِيُّ  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  855  -  حَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  أَحْمَدُ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللهِ الدَّشْتَكِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  عَمْرُو بْنُ أَبِي قَيْسٍ ،  عَنْ  سِمَاكِ بْنِ حَرْبٍ ،  عَنْ  أَبِي أُمَيَّةَ الثَّقَفِيِّ ،  قَالَ  :  خَرَجَ مُعَاوِيَةُ حِينَ صَلَّى الظُّهْرَ فَقَالَ : مَكَانَكُمْ حَتَّى آتِيَكُمْ ، فَخَرَجَ عَلَيْنَا وَقَدْ تَرَدَّى ، فَلَمَّا صَلَّى الْعَصْرَ قَالَ : أَلَا أُحَدِّثُكُمْ شَيْئًا فَعَلَهُ أَصْحَابُ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ قَالَ : فَإِنَّهُمْ صَلَّوْا         [19/364]      مَعَهُ الْأَوَّلَ ثُمَّ جَلَسُوا ، فَخَرَجَ عَلَيْهِمْ فَقَالَ : مَا بَرَحْتُمْ بَعْدُ ؟ قَالُوا : لَا ، فَقَالَ :  لَوْ رَأَيْتُمْ إِلَى رَبِّكُمْ فَتَحَ بَابًا مِنَ السَّمَاءِ فَأَرَى مَجْلِسَكُمْ مَلَائِكَتَهُ  يُبَاهِي  بِكُمْ  وَأَنْتُمْ تَرْقُبُونَ الصَّلَاةَ  .","","Al-Mu'jam al-Kabir 855","","معاوية بن أبي سفيان عن أبو أمية الثقفي عن سماك بن حرب البكري عن عمرو بن أبي قيس عن عبد الرحمن بن عبد الله الدشتكي عن أحمد بن عبد الرحمن حمدون الدشتكي عن علي بن سعيد بن بشير عليك عن الطبراني","أبو أمية الثقفي عن معاوية بن أبي سفيان"
"17940","مَنْ رَوَى عَنْ  مُعَاوِيَةَ  مِنْ  أَهْلِ الشَّامِ  أَبُو إِدْرِيسَ الْخَوْلَانِيُّ  عَنْ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُ  856  -  حَدَّثَنَا  خَيْرُ بْنُ عَرَفَةَ الْمِصْرِيُّ ،  ثَنَا  يَزِيدُ بْنُ عَبْدِ رَبِّهِ الْجُرْجُسِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  عَنْ  عِيسَى بْنِ أَبِي مُوسَى ،  عَنْ  أَبِي عَوْفٍ الْأَنْصَارِيِّ ،  عَنْ  أَبِي إِدْرِيسَ الْخَوْلَانِيِّ ،  سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ ، سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَا مِنْ ذَنْبٍ إِلَّا عَسَى اللهُ أَنْ يَغْفِرَهُ  إِلَّا مَنْ كَانَ مُشْرِكًا أَوْ قَتَلَ مُؤْمِنًا مُتَعَمِّدًا  .","","Al-Mu'jam al-Kabir 856","","معاوية بن أبي سفيان عن عائذ الله بن عبد الله الخولاني عن عبد الله بن أبي عبد الله الشامي الأعور عن عيسى بن أبي موسى عن بقية بن الوليد عن يزيد بن عبد ربه الزبيدي عن خير بن عرفة المصري عن الطبراني","أبو إدريس الخولاني عن معاوية رضي الله عنه"
"17941","857  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عُمَارَةُ بْنُ وَثِيمَةَ الْمِصْرِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَالِمٍ ،  عَنِ  الزُّبَيْدِيِّ ،  ثَنَا  أَبُو عَوْنٍ ، أَنَّ أَبَا إِدْرِيسَ الْخَوْلَانِيَّ ،  حَدَّثَهُمْ  أَنَّ مُعَاوِيَةَ  قَالَ  - وَكَانَ قَلِيلَ الْحَدِيثِ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  عَسَى أَنْ يُغْفَرَ كُلُّ ذَنْبٍ إِلَّا أَنْ يَمُوتَ رَجُلٌ وَهُوَ كَافِرٌ  أَوْ يَقْتُلَ مُؤْمِنًا مُتَعَمِّدًا  .","","Al-Mu'jam al-Kabir 857","","معاوية بن أبي سفيان عن عائذ الله بن عبد الله الخولاني عن عبد الله بن أبي عبد الله الشامي الأعور عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عمرو بن الحارث الزبيدي عن إسحاق بن إبراهيم بن العلاء عن عمارة بن وثيمة المصري عن الطبراني","أبو إدريس الخولاني عن معاوية رضي الله عنه"
"17942","[19/365]      858  -  حَدَّثَنَا  أَبُو زُرْعَةَ الدِّمَشْقِيُّ ،  ثَنَا  عَبْدُ اللهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ،  ثَنَا  عِيسَى بْنُ يُونُسَ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَلِيِّ بْنِ شُعَيْبٍ السِّمْسَارُ ،  ثَنَا  الْحَسَنُ بْنُ بِشْرٍ ،  ثَنَا  الْمُعَافَى بْنُ عِمْرَانَ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  أَبِي عَوْنٍ ،  عَنْ  أَبِي إِدْرِيسَ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  كُلُّ ذَنْبٍ عَسَى اللهُ أَنْ يَغْفِرَهُ إِلَّا الرَّجُلُ يَمُوتُ كَافِرًا  أَوْ رَجُلٌ قَتَلَ مُؤْمِنًا مُتَعَمِّدًا  .","","Al-Mu'jam al-Kabir 858","","معاوية بن أبي سفيان عن عائذ الله بن عبد الله الخولاني عن عبد الله بن أبي عبد الله الشامي الأعور عن ثور بن يزيد الكلاعي عن المعافى بن عمران عن الحسن بن بشر الكاهلي عن محمد بن علي بن شعيب السمسار عن الطبراني","أبو إدريس الخولاني عن معاوية رضي الله عنه"
"17943","جُبَيْرُ بْنُ نُفَيْرٍ  عَنْ  مُعَاوِيَةَ  859  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  عُمَارَةُ بْنُ وَثِيمَةَ الْمِصْرِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ ،  ثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَالِمٍ ،  عَنِ  الزُّبَيْدِيِّ ،  ثَنَا  يَحْيَى بْنُ جَابِرٍ ، أَنَّ  عَبْدَ الرَّحْمَنِ بْنَ جُبَيْرِ بْنِ نُفَيْرٍ  حَدَّثَهُ  أَنَّ أَبَاهُ  حَدَّثَهُ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُ : إِنِّي سَمِعْتُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَلَامًا نَفَعَنِي اللهُ بِهِ ، سَمِعْتُهُ يَقُولُ :  أَعْرِضُوا عَنِ النَّاسِ ، أَلَمْ تَرَ أَنَّكَ إِنِ اتَّبَعْتَ  الرِّيبَةَ  فِي النَّاسِ أَفْسَدْتَهُمْ  أَوْ كِدْتَ تُفْسِدُهُمْ . ؟","","Al-Mu'jam al-Kabir 859","","معاوية بن أبي سفيان عن جبير بن نفير بن مالك الحضرمي عن عبد الرحمن بن جبير الحضرمي عن يحيى بن جابر بن حسان عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عمرو بن الحارث الزبيدي عن إسحاق بن إبراهيم بن العلاء عن عمرو بن إسحاق بن إبراهيم الزبيدي عن الطبراني","جبير بن نفير عن معاوية"
"17944","[19/366]      عَبْدُ اللهِ بْنُ مُحَيْرِيزٍ الْجُمَحِيُّ  عَنْ  مُعَاوِيَةَ  860  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  حَجَّاجُ بْنُ الْمِنْهَالِ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  جَبَلَةَ بْنِ عَطِيَّةَ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَيْرِيزٍ ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 860","","معاوية بن أبي سفيان عن عبد الله بن محيريز الجمحي عن جبلة بن عطية الفلسطيني عن حماد بن سلمة عن حجاج بن المنهال الأنماطي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبد الله بن محيريز الجمحي عن معاوية"
"17945","861  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ أَحْمَدَ بْنِ حَنْبَلٍ ، وَمُحَمَّدُ بْنُ عُبْدُوسِ بْنِ كَامِلٍ السَّرَّاجُ ، قَالَا :  ثَنَا  مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ أَبُو يَحْيَى صَاعِقَةُ ،  ثَنَا  رَوْحُ بْنُ عُبَادَةَ ،  ثَنَا  حَمَّادُ بْنُ سَلَمَةَ ،  عَنْ  جَبَلَةَ بْنِ عَطِيَّةَ ،  عَنِ  ابْنِ مُحَيْرِيزٍ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ السَّامِعَ الْمُطِيعَ لَا حُجَّةَ عَلَيْهِ  ، وَإِنَّ السَّامِعَ الْعَاصِي لَا حُجَّةَ لَهُ  .","","Al-Mu'jam al-Kabir 861","","معاوية بن أبي سفيان عن عبد الله بن محيريز الجمحي عن جبلة بن عطية الفلسطيني عن حماد بن سلمة عن روح بن عبادة القيسي عن محمد بن عبد الرحيم  صاعقة عن محمد بن عبدوس السراج عن الطبراني","عبد الله بن محيريز الجمحي عن معاوية"
"17946","862  -  حَدَّثَنَا  عَلِيُّ بْنُ الْمُبَارَكِ الصَّنْعَانِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ ،  حَدَّثَنِي  سُلَيْمَانُ بْنُ بِلَالٍ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ الْمُتَوَكِّلِ الْبَغْدَادِيُّ ،  ثَنَا  عَفَّانُ بْنُ مُسْلِمٍ ،  ثَنَا  وُهَيْبٌ (  ح  ) .         [19/367]      وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  حَدَّثَنِي  أَبِي  ،  ثَنَا  بَكْرُ بْنُ مُضَرَ ، كُلُّهُمْ  عَنْ  مُحَمَّدِ بْنِ عَجْلَانَ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ الْأَنْصَارِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ مُحَيْرِيزٍ الْجُمَحِيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَانَ يَقُولُ :  يَا أَيُّهَا النَّاسُ لَا تُبَادِرُونِي إِلَى الرُّكُوعِ وَالسُّجُودِ مَهْمَا أَسْبِقْكُمْ بِهِ  ، إِذَا رَكَعْتُ تُدْرِكُونِي بِهِ إِذَا رَفَعْتُ ، إِنِّي قَدْ  بَدُنْتُ  أَيْ : كَبِرْتُ  .  وَاللَّفْظُ لِحَدِيثِ  سُلَيْمَانَ بْنِ بِلَالٍ  .","","Al-Mu'jam al-Kabir 862","","معاوية بن أبي سفيان عن عبد الله بن محيريز الجمحي عن محمد بن يحيى بن حبان عن محمد بن عجلان عن بكر بن مضر المصري عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","عبد الله بن محيريز الجمحي عن معاوية"
"17947","863  -  حَدَّثَنَا  إِسْمَاعِيلُ بْنُ الْحَسَنِ الْخَفَّافُ ،  ثَنَا  أَحْمَدُ بْنُ صَالِحٍ ،  ثَنَا  ابْنُ وَهْبٍ ،  أَخْبَرَنِي  أُسَامَةُ بْنُ زَيْدٍ ،  عَنْ  مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ ،  عَنِ  ابْنِ مُحَيْرِيزٍ الْجُمَحِيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ قَالَ :  لَا تُبَادِرُونِي بِالرُّكُوعِ وَالسُّجُودِ فَإِنِّي مَا أَسْبِقْكُمْ بِهِ  حِينَ أَسْجُدُ تُدْرِكُونِي بِهِ إِذَا رَفَعْتُ ، وَمَا أَسْبِقْكُمْ بِهِ حِينَ أَرْكَعُ تُدْرِكُونِي بِهِ حِينَ أَرْفَعُ ، وَإِنِّي قَدْ  بَدُنْتُ  .","","Al-Mu'jam al-Kabir 863","","معاوية بن أبي سفيان عن عبد الله بن محيريز الجمحي عن محمد بن يحيى بن حبان عن أسامة بن زيد الليثي المدني عن عبد الله بن وهب المصري عن أحمد بن صالح المصري عن إسماعيل بن الحسن الخفاف عن الطبراني","عبد الله بن محيريز الجمحي عن معاوية"
"17948","أَبُو أَسْمَاءَ الرَّحَبِيُّ  عَنْ  مُعَاوِيَةَ  864  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ، وَعَبْدَانُ بْنُ أَحْمَدَ ، قَالَا :  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ الضَّحَّاكِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  رَاشِدِ بْنِ دَاوُدَ ،  عَنْ  أَبِي أَسْمَاءَ ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 864","","معاوية بن أبي سفيان عن عمرو بن مرثد الرحبي عن راشد بن داود البرسمي عن إسماعيل بن عياش الأحول عن عبد الوهاب بن الضحاك عن عبد الله بن أحمد الجواليقي عن الطبراني","أبو أسماء الرحبي عن معاوية"
"17949","[19/368]      عُبَادَةُ بْنُ نُسَيٍّ الْكِنْدِيُّ  عَنْ  مُعَاوِيَةَ  865  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنِ  الْأَوْزَاعِيِّ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعْدٍ ،  عَنْ  عُبَادَةَ بْنِ نُسَيٍّ الْكِنْدِيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ ،  أَنَّهُمْ ذَكَرُوا  الْمَسَائِلَ  عِنْدَهُ ، فَقَالَ :  أَمَا تَعْلَمُونَ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَى عَنْ عُضَلِ  الْمَسَائِلِ  .","","Al-Mu'jam al-Kabir 865","","معاوية بن أبي سفيان عن عبادة بن نسي الأردني عن عبد الله بن سعد بن فروة البجلي عن أبو عمرو الأوزاعي عن الوليد بن مسلم القرشي عن سليمان بن أحمد الدمشقي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبادة بن نسي الكندي عن معاوية"
"17950","عُبَيْدَةُ بْنُ الْمُهَاجِرِ أَبُو عَبْدِ رَبٍّ  عَنْ  مُعَاوِيَةَ  866  -  حَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  عَارِمٌ أَبُو النُّعْمَانِ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْمُبَارَكِ ،  أَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ جَابِرٍ ،  ثَنَا  أَبُو عَبْدِ رَبٍّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ ، يَقُولُ عَلَى الْمِنْبَرِ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّمَا بَقِيَ مِنَ الدُّنْيَا بَلَاءٌ وَفِتْنَةٌ  ، وَإِنَّمَا مَثَلُ أَحَدِكُمْ مَثَلُ الْوِعَاءِ إِذَا طَابَ أَعْلَاهُ طَابَ أَسْفَلُهُ  .","","Al-Mu'jam al-Kabir 866","","معاوية بن أبي سفيان عن أبو عبد رب الدمشقي عن عبد الرحمن بن يزيد الداراني عن عبد الله بن المبارك عن محمد بن الفضل السدوسي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","عبيدة بن المهاجر أبو عبد رب عن معاوية"
"17951","[19/369]      867  -  حَدَّثَنَا  أَبُو عِمْرَانَ مُوسَى بْنُ سَهْلٍ الْخَوْلَانِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ ،  ثَنَا  صَدَقَةُ بْنُ خَالِدٍ (  ح  ) .  وَحَدَّثَنَا  أَبُو مُسْلِمٍ الْكَشِّيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ، قَالَا :  ثَنَا  ابْنُ جَابِرٍ ،  ثَنَا  عُبَيْدَةُ بْنُ الْمُهَاجِرِ أَبُو عَبْدِ رَبٍّ  ،  أَنَّهُ سَمِعَ  مُعَاوِيَةَ عَلَى الْمِنْبَرِ يُحَدِّثُ أَنَّهُ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ  رَجُلًا  أَسْرَفَ عَلَى نَفْسِهِ فَأَتَى  رَجُلًا  ، فَقَالَ : إِنَّ الْآخَرَ قَتَلَ تِسْعَةً وَتِسْعِينَ نَفْسًا كُلُّهُمْ يَقْتُلُهَا ظُلْمًا  ، فَهَلْ لِي مِنْ تَوْبَةٍ ؟ فَقَالَ : لَا ، فَقَتَلَهُ ، وَأَتَى آخَرَ ، فَقَالَ : إِنَّ الْآخَرَ قَتَلَ مِائَةَ نَفْسٍ كُلُّهَا ظُلْمًا فَهَلْ لَهُ مِنْ تَوْبَةٍ ؟ قَالَ : إِنْ حَدَّثْتُكَ أَنَّ اللهَ لَا يَتُوبُ عَلَى مَنْ تَابَ فَقَدْ كَذَبْتُكَ ، هَاهُنَا مَكَانٌ فِيهِ قَوْمٌ يَتَعَبَّدُونَ ، فَائْتِهِمْ تَعْبُدِ اللهَ مَعَهُمْ ، فَتَوَجَّهَ إِلَيْهِمْ فَمَاتَ عَلَى ذَلِكَ ، فَاخْتَصَمَتْ مَلَائِكَةُ الرَّحْمَةِ وَمَلَائِكَةُ الْعَذَابِ ، فَبَعَثَ اللهُ إِلَيْهِمْ مَلَكًا قَالَ : قِيسُوا بَيْنَ الْمَكَانَيْنِ فَأَيُّهُمْ كَانَ أَقْرَبَ فَهُوَ مِنْهُمْ ، فَوَجَدُوهُ أَقْرَبَ إِلَى دَيْرِ التَّوَّابِينَ بِأُنْمُلَةٍ ، فَغُفِرَ لَهُ  ،  وَاللَّفْظُ لِحَدِيثِ  الْوَلِيدِ  .  كذا في طبعة مكتبة ابن تيمية والنسخة الخطية ، والصواب : (عبيدة بن أبي المهاجر أو أبو عبد رب) وينظر مصادر التخريج ، والله أعلم .","","Al-Mu'jam al-Kabir 867","","معاوية بن أبي سفيان عن أبو عبد رب الدمشقي عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن سليمان بن أحمد الدمشقي عن أبو مسلم الكجي عن الطبراني","عبيدة بن المهاجر أبو عبد رب عن معاوية"
"17952","868  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ صَعْصَعَةَ الْبَغْدَادِيُّ ،  ثَنَا  مَنْصُورُ         [19/370]      بْنُ أَبِي مُزَاحِمٍ ،  ثَنَا  يَزِيدُ بْنُ يُوسُفَ ،  عَنْ  ثَابِتِ بْنِ ثَوْبَانَ ،  عَنْ  أَبِي عَبْدِ رَبٍّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ قَالَ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّ اللهَ لَا يُغْلَبُ ، وَلَا يُخْلَبُ  ، وَلَا يُنَبَّأُ بِمَا لَا يَعْلَمُ ، مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 868","","معاوية بن أبي سفيان عن أبو عبد رب الدمشقي عن ثابت بن ثوبان العبسي عن يزيد بن يوسف الرحبي عن منصور بن أبي مزاحم عن أحمد بن محمد بن صعصعة البغدادي عن الطبراني","عبيدة بن المهاجر أبو عبد رب عن معاوية"
"17953","عَبْدُ اللهِ بْنُ عَامِرٍ الْيَحْصَبِيُّ الْقَارِي  عَنْ  مُعَاوِيَةَ  869  -  حَدَّثَنَا  أَبُو يَزِيدَ الْقَرَاطِيسِيُّ ،  ثَنَا  أَسَدُ بْنُ مُوسَى ،  ثَنَا  مُعَاوِيَةُ بْنُ صَالِحٍ ،  ثَنَا  رَبِيعَةُ بْنُ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ الْيَحْصَبِيِّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ عَلَى الْمِنْبَرِ  بِدِمَشْقَ  يَقُولُ :  أَيُّهَا النَّاسُ إِيَّاكُمْ وَأَحَادِيثَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - إِلَّا حَدِيثًا كَانَ يُذْكَرُ عَلَى عَهْدِ  عُمَرَ  ،  فَإِنَّ  عُمَرَ  - رَضِيَ اللهُ عَنْهُ - كَانَ رَجُلًا يُخِيفُ النَّاسَ فِي اللهِ  ، ثُمَّ سَمِعْتُهُ يَقُولُ : أَلَا إِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 869","","معاوية بن أبي سفيان عن عبد الله بن عامر بن يزيد اليحصبي عن ربيعة بن يزيد القصير عن معاوية بن صالح بن حدير الحضرمي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","عبد الله بن عامر اليحصبي القاري عن معاوية"
"17954","أَلَا  وَسَمِعْتُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّمَا أَنَا خَازِنٌ ، وَإِنَّمَا يُعْطِي اللهُ ، فَمَنْ أَعْطَيْتُهُ عَنْ طِيبِ نَفْسٍ فَإِنَّهُ يُبَارَكُ لَهُ فِيهِ  ، وَمَنْ أَعْطَيْتُهُ عَطَاءً عَنْ مَسْأَلَةٍ فَهُوَ كَالَّذِي يَأْكُلُ وَلَا يَشْبَعُ  .","","Al-Mu'jam al-Kabir 17954","","معاوية بن أبي سفيان عن عبد الله بن عامر بن يزيد اليحصبي عن ربيعة بن يزيد القصير عن معاوية بن صالح بن حدير الحضرمي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","عبد الله بن عامر اليحصبي القاري عن معاوية"
"17955","-  أَلَا  وَسَمِعْتُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَزَالُ أُمَّةٌ مِنْ أُمَّتِي قَائِمَةً عَلَى أَمْرِ اللهِ لَا يَضُرُّهُمْ مَنْ خَالَفَهُمْ  وَلَا مَنْ خَذَلَهُمْ حَتَّى يَأْتِيَ اللهُ وَهُمْ ظَاهِرُونَ عَلَى النَّاسِ  .","","Al-Mu'jam al-Kabir 17955","","معاوية بن أبي سفيان عن عبد الله بن عامر بن يزيد اليحصبي عن ربيعة بن يزيد القصير عن معاوية بن صالح بن حدير الحضرمي عن أسد السنة عن يوسف بن يزيد القراطيسي عن الطبراني","عبد الله بن عامر اليحصبي القاري عن معاوية"
"17956","[19/371]      870  -  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى بْنِ بُكَيْرٍ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  بِشْرُ بْنُ مُوسَى  ، ثَنَا  يَحْيَى بْنُ إِسْحَاقَ السَّيْلَحِينِيُّ ، قَالَا :  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ الْيَحْصَبِيِّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُ : قَالَ رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - :  لَا تَزَالُ أُمَّتِي قَائِمَةً بِالْحَقِّ يُقَاتِلُونَ مَنْ قَاتَلَهُمْ  وَحَارَبَهُمْ إِلَى يَوْمِ الْقِيَامَةِ  .","","Al-Mu'jam al-Kabir 870","","معاوية بن أبي سفيان عن عبد الله بن عامر بن يزيد اليحصبي عن ربيعة بن يزيد القصير عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن يحيى بن إسحاق السيلحيني عن بشر بن موسى بن صالح الأسدي عن الطبراني","عبد الله بن عامر اليحصبي القاري عن معاوية"
"17957","871  -  حَدَّثَنَا  بِشْرُ بْنُ مُوسَى ،  ثَنَا  يَحْيَى بْنُ إِسْحَاقَ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ الْيَحْصَبِيِّ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 871","","معاوية بن أبي سفيان عن عبد الله بن عامر بن يزيد اليحصبي عن ربيعة بن يزيد القصير عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن يحيى بن إسحاق السيلحيني عن بشر بن موسى بن صالح الأسدي عن الطبراني","عبد الله بن عامر اليحصبي القاري عن معاوية"
"17958","872  -  حَدَّثَنَا  أَحْمَدُ بْنُ زُهَيْرٍ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  ثَنَا  وَهْبُ بْنُ جَرِيرٍ ،  ثَنَا  أَبِي  قَالَ :  سَمِعْتُ  يَحْيَى بْنَ أَيُّوبَ  يُحَدِّثُ عَنْ  يَزِيدَ بْنِ أَبِي حَبِيبٍ  ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّمَا أَنَا خَازِنٌ ، وَإِنَّمَا يُعْطِي اللهُ ، فَمَنْ أَعْطَيْتُهُ عَطَاءً وَأَنَا بِهِ طَيِّبُ النَّفْسِ بُورِكَ لَهُ فِيهِ  ، وَمَنْ أَعْطَيْتُهُ عَطَاءً عَنْ شَرَهِ النَّفْسِ وَشِدَّةِ الْمَسْأَلَةِ فَهُوَ كَالَّذِي يَأْكُلُ وَلَا يَشْبَعُ  .  في طبعة مكتبة ابن تيمية : ( يزيد بن أبي خصيفة) والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 872","","معاوية بن أبي سفيان عن عبد الله بن عامر بن يزيد اليحصبي عن جعفر بن ربيعة الكندي عن يزيد بن أبي حبيب الأزدي عن يحيى بن أيوب الغافقي عن جرير بن حازم عن وهب بن جرير بن حازم عن محمد بن بشار بندار عن أحمد بن يحيى بن زهير التستري عن الطبراني","عبد الله بن عامر اليحصبي القاري عن معاوية"
"17959","873  -  حَدَّثَنَا  عَبْدُ الْمَلِكِ بْنُ يَحْيَى بْنِ بُكَيْرٍ ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  جَعْفَرِ بْنِ رَبِيعَةَ ،  عَنْ  رَبِيعَةَ بْنِ يَزِيدَ ،  عَنْ  عَبْدِ اللهِ بْنِ عَامِرٍ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ عَلَى الْمِنْبَرِ :  إِنَّمَا أَنَا خَازِنٌ ، وَإِنَّمَا يُعْطِي اللهُ  ، فَمَنْ أَعْطَيْتُهُ عَطَاءً وَأَنَا طَيِّبَةٌ بِهِ نَفْسِي فَإِنَّهُ يُبَارَكُ لَهُ فِيهِ ، وَمَنْ أَعْطَيْتُهُ عَطَاءً عَنْ شَرَهِ نَفْسٍ ، وَشِدَّةِ مَسْأَلَةٍ فَهُوَ كَالَّذِي يَأْكُلُ وَلَا يَشْبَعُ  .","","Al-Mu'jam al-Kabir 873","","معاوية بن أبي سفيان عن عبد الله بن عامر بن يزيد اليحصبي عن ربيعة بن يزيد القصير عن جعفر بن ربيعة الكندي عن عبد الله بن لهيعة عن يحيى بن عبد الله بن بكير المخزومي عن عبد الملك بن يحيى المخزومي عن الطبراني","عبد الله بن عامر اليحصبي القاري عن معاوية"
"17960","[19/372]      ابْنُ هُبَيْرَةَ  عَنْ  مُعَاوِيَةَ  874  -  حَدَّثَنَا  عُمَارَةُ بْنُ وَثِيمَةَ الْمِصْرِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِبْرَاهِيمَ بْنِ زِبْرِيقٍ ،  ثَنَا  عَمْرُو بْنُ الْحَارِثِ ،  ثَنَا  عَبْدُ اللهِ بْنُ سَالِمٍ ،  عَنِ  الزُّبَيْدِيِّ ،  ثَنَا  الْحَسَنُ بْنُ جَابِرٍ ،  عَنِ  ابْنِ هُبَيْرَةَ ،  أَنَّهُ كَانَ يُكَلِّمُ مُعَاوِيَةَ وَأَذَّنَ الْمُؤَذِّنُ فَأَمَرَهُ أَنْ  يُنْصِتَ  ، ثُمَّ كَبَّرَ كَمَا كَبَّرَ ، ثُمَّ قَالَ الْمُؤَذِّنُ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، فَقَالَ : وَنَحْنُ نَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، قَالَ الْمُؤَذِّنُ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، فَقَالَ : وَنَحْنُ نَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ ، قَالَ  ابْنُ هُبَيْرَةَ  : فَقُلْتُ لَهُ : أَشَيْءٌ رَأَيْتَهُ أَمْ سَمِعْتَهُ مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ؟ فَقَالَ :  سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - كَبَّرَ حِينَ سَمِعَ الْمُؤَذِّنَ  ، فَإِذَا قَالَ : أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ قَالَ : وَأَنَا أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَإِذَا قَالَ : أَشْهَدُ أَنَّ  مُحَمَّدًا  رَسُولُ اللهِ قَالَ : وَأَنَا أَشْهَدُ أَنِّي رَسُولُ اللهِ  .","","Al-Mu'jam al-Kabir 874","","معاوية بن أبي سفيان عن عبد الله بن هبيرة السبئي عن الحسن بن جابر اللخمي عن محمد بن الوليد بن عامر الزبيدي عن عبد الله بن سالم الوحاظي عن عمرو بن الحارث الزبيدي عن إسحاق بن إبراهيم بن العلاء عن عمارة بن وثيمة المصري عن الطبراني","ابن هبيرة عن معاوية"
"17961","عَطِيَّةُ بْنُ قَيْسٍ الْكِلَابِيُّ  عَنْ  مُعَاوِيَةَ  875  -  حَدَّثَنَا  أَحْمَدُ بْنُ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَمْزَةَ الدِّمَشْقِيُّ ،  ثَنَا  حَيْوَةُ بْنُ شُرَيْحٍ الْحِمْصِيُّ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُبَارَكِ الصُّورِيُّ ،  ثَنَا  بَقِيَّةُ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ سَعِيدٍ الرَّازِيُّ ،  ثَنَا  عَلِيُّ بْنُ الْحُسَيْنِ الْخَوَّاصُ الْمَوْصِلِيُّ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  أَبِي بَكْرِ بْنِ أَبِي مَرْيَمَ ،  عَنْ  عَطِيَّةَ بْنِ قَيْسٍ قَالَ :         [19/373]      سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّمَا الْعَيْنُ  وِكَاءُ  السَّهِ  ، فَإِذَا نَامَتِ الْعَيْنُ انْطَلَقَ  الْوِكَاءُ  ، فَمَنْ نَامَ فَلْيَتَوَضَّأْ  .","","Al-Mu'jam al-Kabir 875","","معاوية بن أبي سفيان عن عطية بن قيس الكلابي عن أبو بكر الغساني عن الوليد بن مسلم القرشي عن علي بن الحسين الخواص عن علي بن سعيد بن بشير عليك عن الطبراني","عطية بن قيس الكلابي عن معاوية"
"17962","كَيْسَانُ أَبُو حَرِيزٍ مَوْلَى مُعَاوِيَةَ  عَنْ  مُعَاوِيَةَ  رَضِيَ اللهُ عَنْهُ  876  -  حَدَّثَنَا  [مُحَمَّدُ بْنُ]  عَمْرِو بْنِ خَالِدٍ الْحَرَّانِيُّ ،  ثَنَا  أَبِي  ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  عَبْدِ اللهِ بْنِ دِينَارٍ ،  عَنْ  أَبِي حَرِيزٍ ، مَوْلَى مُعَاوِيَةَ قَالَ :  خَطَبَ  مُعَاوِيَةُ النَّاسَ فَذَكَرَ فِي خُطْبَتِهِ :  أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - حَرَّمَ سِتَّةَ [سَبْعَةَ] أَشْيَاءٍ ، وَإِنِّي أُبَلِّغُكُمْ ذَلِكَ وَأَنْهَاكُمْ عَنْهُ  : مِنْهُنَّ النَّوْحُ ، وَالشِّعْرُ ، وَالتَّصَاوِيرُ ،  وَالتَّبَرُّجُ  ، وَجُلُودُ  السِّبَاعِ  ، وَالذَّهَبُ ، وَالْحَرِيرُ  .  سقط من طبعة مكتبة ابن تيمية والمثبت من النسخة الخطية .","","Al-Mu'jam al-Kabir 876","","معاوية بن أبي سفيان عن حريز الشامي مولى معاوية بن أبي سفيان عن عبد الله بن دينار البهراني عن إسماعيل بن عياش الأحول عن عمرو بن خالد بن فروخ عن محمد بن عمرو بن خالد الحراني عن الطبراني","كيسان أبو حريز مولى معاوية عن معاوية رضي الله عنه"
"17963","877  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  يَحْيَى بْنُ صَالِحٍ الْوُحَاظِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ مُهَاجِرٍ الْأَنْصَارِيُّ ،  عَنْ  كَيْسَانَ ، مَوْلَى مُعَاوِيَةَ قَالَ :  خَطَبَ مُعَاوِيَةُ النَّاسَ ، فَقَالَ :  يَا أَيُّهَا النَّاسُ إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَى عَنْ تِسْعٍ ، وَأَنَا أَنْهَاكُمْ عَنْهُنَّ  : النَّوْحُ ، وَالشِّعْرُ ،  وَالتَّبَرُّجُ  ، وَالتَّصَاوِيرُ ، وَجُلُودُ  السِّبَاعِ  ، وَالْغِنَاءُ ، وَالذَّهَبُ ، وَالْحِرُ ، وَالْحَرِيرُ  .","","Al-Mu'jam al-Kabir 877","","معاوية بن أبي سفيان عن كيسان مولى معاوية الشامي عن محمد بن مهاجر بن أبي مسلم عن يحيى بن صالح الوحاظي عن أبو زرعة الدمشقي عن الطبراني","كيسان أبو حريز مولى معاوية عن معاوية رضي الله عنه"
"17964","878  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ، وَأَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَبَّانَ الرَّقِّيُّ ، قَالَا :  ثَنَا  أَبُو عُبَيْدَةَ بْنُ الْفُضَيْلِ بْنِ عِيَاضٍ ،  ثَنَا  أَبُو سَعِيدٍ ، مَوْلَى بَنِي هَاشِمٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ أَبُو الْعَلَاءِ ،  ثَنَا  مُحَمَّدُ بْنُ مُهَاجِرٍ ،  عَنْ         [19/374]      كَيْسَانَ ، مَوْلَى مُعَاوِيَةَ قَالَ :  خَطَبَنَا مُعَاوِيَةُ فَقَالَ :  إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَهَى عَنْ تِسْعٍ ، وَأَنَا أَنْهَاكُمْ عَنْهُنَّ  ، أَلَا إِنَّ مِنْهُنَّ : النَّوْحَ ، وَالْغِنَاءَ ، وَالتَّصَاوِيرَ ، وَالشِّعْرَ ، وَالذَّهَبَ ، وَالْحِرَ ، وَالسُّرُوجَ ، وَالْحَرِيرَ  .","","Al-Mu'jam al-Kabir 878","","معاوية بن أبي سفيان عن كيسان مولى معاوية الشامي عن محمد بن مهاجر بن أبي مسلم عن عبد الرحمن أبو العلاء عن عبد الرحمن بن عبد الله بن عبيد جردقة عن أبو عبيدة بن الفضيل بن عياض عن أحمد بن يحيى بن خالد الرقي عن الطبراني","كيسان أبو حريز مولى معاوية عن معاوية رضي الله عنه"
"17965","الْقَاسِمُ أَبُو عَبْدِ الرَّحْمَنِ  عَنْ  مُعَاوِيَةَ  879  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  عَمْرُو بْنُ عُثْمَانَ ،  ثَنَا  بَقِيَّةُ بْنُ الْوَلِيدِ ،  حَدَّثَنِي  عُتْبَةُ بْنُ أَبِي حَكِيمٍ ،  حَدَّثَنِي  الْقَاسِمُ أَبُو عَبْدِ الرَّحْمَنِ قَالَ :  كُنْتُ قَاعِدًا عِنْدَ  مُعَاوِيَةَ  فَبَعَثَ إِلَى عَبْدِ اللهِ بْنِ عَمْرٍو ، فَقَالَ : مَا أَحَادِيثُ بَلَغَنِي عَنْكَ تُحَدِّثُ بِهَا ؟ لَقَدْ هَمَمْتُ أَنْ أَنْفِيَكَ مِنَ  الشَّامِ  ، فَقَالَ : أَمَا وَاللهِ لَوْلَا إِنَاثٌ مَا أَحْبَبْتُ أَنْ أَكُونَ بِهَا سَاعَةً ، فَقَالَ  مُعَاوِيَةُ  : مَا حَدِيثٌ تُحَدِّثُ بِهِ فِي الطِّلَا ؟ فَقَالَ : أَمَا إِنَّهُ مَا يَحِلُّ لِي أَنْ أَقُولَ عَلَى رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مَا لَمْ يَقُلْ ، سَمِعْتُهُ يَقُولُ :  مَنْ تَقَوَّلَ عَلَيَّ مَا لَمْ أَقُلْ  فَلْيَتَبَوَّأْ  مَقْعَدَهُ مِنَ النَّارِ  .  وَسَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ فِي الْخَمْرِ :  مَنْ وَضَعَهَا عَلَى كَفِّهِ لَمْ تُقْبَلْ لَهُ دَعْوَةٌ  ، وَمَنْ أَدْمَنَ عَلَى شُرْبِهَا سُقِيَ مِنَ  الْخَبَالِ  ،  وَالْخَبَالُ  وَادٍ فِي  جَهَنَّمَ ،  فَقَالَ : يَا  مُعَاوِيَةُ  مَا أَرَاكَ إِلَّا قَدْ سَمِعْتَ مِثْلَ الَّذِي سَمِعْتُ قَالَ : فَهَمَّ  مُعَاوِيَةُ  أَنْ يُصَدِّقَهُ ثُمَّ سَكَتَ  .","","Al-Mu'jam al-Kabir 879","","عبد الله بن عمرو بن العاص عن القاسم بن عبد الرحمن الدمشقي عن عتبة بن أبي حكيم عن بقية بن الوليد عن عمرو بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","القاسم أبو عبد الرحمن عن معاوية"
"17966","[19/375]      880  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  يَحْيَى بْنُ عُثْمَانَ ،  ثَنَا  مَرْوَانُ بْنُ مُحَمَّدٍ الطَّاطَرِيُّ ،  ثَنَا  الْهَيْثَمُ بْنُ حُمَيْدٍ ،  عَنِ  الْعَلَاءِ بْنِ الْحَارِثِ ،  ثَنَا  الْقَاسِمُ أَبُو عَبْدِ الرَّحْمَنِ ،  أَنَّهُ سَمِعَ  مُعَاوِيَةَ يَقُولُ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  كَانَ يَقُومُ عَلَى الْمِنْبَرِ قَبْلَ رَمَضَانَ بِيَوْمٍ وَيَقُولُ :  إِنَّ الصِّيَامَ يَوْمَ كَذَا وَكَذَا ، وَنَحْنُ مُتَقَدِّمُونَ فَمَنْ أَحَبَّ أَنْ يَتَقَدَّمَ فَلْيَتَقَدَّمْ  ، وَمَنْ أَحَبَّ أَنْ يَتْرُكَ فَلْيَتْرُكْ  .","","Al-Mu'jam al-Kabir 880","","معاوية بن أبي سفيان عن القاسم بن عبد الرحمن الدمشقي عن العلاء بن الحارث الرمادي عن الهيثم بن حميد الغساني عن مروان بن محمد الطاطري عن يحيى بن عثمان بن سعيد الحمصي عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","القاسم أبو عبد الرحمن عن معاوية"
"17967","ابْنُ ذِي الْكَلَاعِ  عَنْ  مُعَاوِيَةَ  881  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ  ، ثَنَا  مُحَمَّدُ بْنُ سُفْيَانَ الْحَضْرَمِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  ثَنَا  حَسَّانُ بْنُ كُرَيْبٍ ،  أَنَّهُ سَمِعَ  ابْنَ ذِي كَلَاعٍ يَقُولُ : كُنْتُ عِنْدَ مُعَاوِيَةَ  فَقَالَ  : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  سَتَفْتَحُونَ مَنَابِتَ الشِّيحِ  .","","Al-Mu'jam al-Kabir 881","","معاوية بن أبي سفيان عن شرحبيل بن ذي الكلاع الحميري عن حسان بن كريب الرعيني عن عبد الله بن لهيعة عن محمد بن سفيان الحضرمي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","ابن ذي الكلاع عن معاوية"
"17968","882  -  حَدَّثَنَا  يَحْيَى بْنُ أَيُّوبَ الْعَلَّافُ ،  ثَنَا  أَبُو صَالِحٍ الْحَرَّانِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  كَعْبِ بْنِ عَلْقَمَةَ التُّنُوخِيِّ ،  حَدَّثَنِي  حَسَّانُ بْنُ كُرَيْبٍ قَالَ :  سَمِعْتُ  ابْنَ ذِي الْكَلَاعِ يَقُولُ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  اتْرُكُوا  التُّرْكَ  مَا تَرَكُوكُمْ  .","","Al-Mu'jam al-Kabir 882","","معاوية بن أبي سفيان عن شرحبيل بن ذي الكلاع الحميري عن حسان بن كريب الرعيني عن كعب بن علقمة بن كعب عن عبد الله بن لهيعة عن عبد الغفار بن داود الحراني عن يحيى بن أيوب العلاف عن الطبراني","ابن ذي الكلاع عن معاوية"
"17969","[19/376]      883  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَمْرٍو الْقَطِرَانِيُّ ،  ثَنَا  عَبْدُ الْأَعْلَى بْنُ حَمَّادٍ النَّرْسِيُّ ،  ثَنَا  بِشْرُ بْنُ السَّرِيِّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  كَعْبِ بْنِ عَلْقَمَةَ قَالَ :  سَمِعْتُ  حَسَّانَ بْنَ كُرَيْبٍ الْحِمْيَرِيَّ يَقُولُ :  سَمِعْتُ  ابْنَ ذِي كَلَاعٍ يَقُولُ :  جَاءَ مُعَاوِيَةَ بَرِيدٌ مِنْ صَاحِبِ  أَرْمِينِيَّةَ  ، فَلَمَّا قَرَأَ  مُعَاوِيَةُ  الْكِتَابَ خَرَجَ مُغْضَبًا ، ثُمَّ دَعَا كَاتِبَهُ فَقَالَ : اكْتُبْ إِلَى صَاحِبِ  أَرْمِينِيَّةَ  جَوَابَ كِتَابِهِ  ثَكِلَتْكَ  أُمُّكَ ، وَلَا تُحَرِّكْهُمْ بِشَيْءٍ ، فَإِنِّي سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  تَارِكُوا  التُّرْكَ  مَا تَرَكُوكُمْ  .","","Al-Mu'jam al-Kabir 883","","معاوية بن أبي سفيان عن شرحبيل بن ذي الكلاع الحميري عن حسان بن كريب الرعيني عن كعب بن علقمة بن كعب عن عبد الله بن لهيعة عن بشر بن السري عن عبد الأعلى بن حماد النرسي عن أحمد بن عمرو بن حفص القريعي عن الطبراني","ابن ذي الكلاع عن معاوية"
"17970","أَبُو عَامِرٍ الْهَوْزَنِيُّ عَبْدُ اللهِ بْنُ لُحَيٍّ  عَنْ  مُعَاوِيَةَ  884  -  حَدَّثَنَا  أَحْمَدُ بْنُ عَبْدِ الْوَهَّابِ بْنِ نَجْدَةَ الْحَوْطِيُّ ،  ثَنَا  أَبُو الْمُغِيرَةِ (  ح  ) .  وَحَدَّثَنَا  أَبُو زَيْدٍ الْحَوْطِيُّ  ، ثَنَا  أَبُو الْيَمَانِ الْحَكَمُ بْنُ نَافِعٍ ، قَالَا :  ثَنَا  صَفْوَانُ بْنُ عَمْرٍو ،  عَنْ  أَزْهَرَ بْنِ عَبْدِ اللهِ ،  عَنْ  أَبِي عَامِرٍ الْهَوْزَنِيِّ عَبْدِ اللهِ بْنِ لُحَيٍّ قَالَ :  حَجَجْنَا مَعَ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  ، فَلَمَّا قَدِمْنَا  مَكَّةَ  أُخْبِرَ بِقَاصٍّ يَقُصُّ عَلَى  أَهْلِ مَكَّةَ  مَوْلًى  لِبَنِي مَخْزُومٍ  ، فَأَرْسَلَ إِلَيْهِ  مُعَاوِيَةُ  ، فَقَالَ : أُمِرْتَ بِهَذَا الْقَصَصِ ؟ قَالَ : لَا قَالَ : فَمَا حَمَلَكَ عَلَى أَنْ تَقُصَّ بِغَيْرِ إِذْنٍ ؟ قَالَ : نَنْشُرُ عِلْمًا عَلَّمَنَاهُ اللهُ ، فَقَالَ  مُعَاوِيَةُ  :  لَوْ كُنْتُ تَقَدَّمْتُ إِلَيْكَ قَبْلَ مُدَّتِي هَذِهِ لَقَطَعْتُ         [19/377]      مِنْكَ طَائِفًا  ، ثُمَّ قَامَ حَتَّى صَلَّى الظُّهْرَ  بِمَكَّةَ  ،  ثُمَّ قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ أَهْلَ الْكِتَابِ افْتَرَقُوا عَلَى ثِنْتَيْنِ وَسَبْعِينَ مِلَّةً  ، وَإِنَّ هَذِهِ الْأُمَّةَ سَتَفْتَرِقُ عَلَى ثَلَاثٍ وَسَبْعِينَ مِلَّةً -  يَعْنِي الْأَهْوَاءَ  - وَكُلُّهَا فِي النَّارِ إِلَّا وَاحِدَةً وَهِيَ الْجَمَاعَةُ  .  وَقَالَ :  إِنَّهُ سَيَخْرُجُ مِنْ أُمَّتِي أَقْوَامٌ تَتَجَارَى بِهِمُ الْأَهْوَاءُ كَمَا  يَتَجَارَى  الْكَلْبُ  بِصَاحِبِهِ  ، فَلَا يَبْقَى مِنْهُ  عِرْقٌ  وَلَا مَفْصِلٌ إِلَّا دَخَلَهُ ، وَاللهِ يَا مَعْشَرَ الْعَرَبِ لَئِنْ لَمْ تَقُومُوا بِمَا جَاءَ بِهِ  مُحَمَّدٌ  - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَغَيْرُكُمْ مِنَ النَّاسِ أَحْرَى أَنْ لَا يَقُومَ بِهِ  .","","Al-Mu'jam al-Kabir 884","","معاوية بن أبي سفيان عن عبد الله بن لحي الهوزني عن أزهر بن عبد الله بن جميع الحرازي عن صفوان بن عمرو السكسكي عن أبو اليمان الحكم بن نافع عن أحمد بن عبد الرحيم بن يزيد الحوطي عن الطبراني","أبو عامر الهوزني عبد الله بن لحي عن معاوية"
"17971","885  -  حَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  حَدَّثَنِي  صَفْوَانُ بْنُ عَمْرٍو ،  عَنِ  الْأَزْهَرِ بْنِ عَبْدِ اللهِ الْهَوْزَنِيِّ ،  عَنْ  أَبِي عَامِرٍ عَبْدِ اللهِ بْنِ لُحَيٍّ الْهَوْزَنِيِّ ،  عَنْ  مُعَاوِيَةَ قَالَ : إِنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِنَّ أَهْلَ الْكِتَابِ افْتَرَقُوا فِي كِتَابِهِمْ عَلَى ثِنْتَيْنِ وَسَبْعِينَ مِلَّةً  ، وَتَفْتَرِقُ هَذِهِ الْأُمَّةُ عَلَى ثَلَاثٍ وَسَبْعِينَ مِلَّةً -  يَعْنِي الْأَهْوَاءَ  - كُلُّهَا فِي النَّارِ إِلَّا وَاحِدَةً وَهِيَ الْجَمَاعَةُ ، وَإِنَّهُ يَخْرُجُ فِي أُمَّتِي أَقْوَامٌ تَجَارَى بِهِمْ تِلْكَ الْأَهْوَاءُ كَمَا  يَتَجَارَى  الْكَلْبُ  لِصَاحِبِهِ ، وَلَا يَبْقَى  عِرْقٌ  وَلَا مَفْصِلٌ إِلَّا دَخَلَهُ  .","","Al-Mu'jam al-Kabir 885","","معاوية بن أبي سفيان عن عبد الله بن لحي الهوزني عن أزهر بن عبد الله بن جميع الحرازي عن صفوان بن عمرو السكسكي عن إسماعيل بن عياش الأحول عن سليمان بن عبد الرحمن التميمي عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","أبو عامر الهوزني عبد الله بن لحي عن معاوية"
"17972","الْقَاسِمُ بْنُ مُحَمَّدٍ الثَّقَفِيُّ  عَنْ  مُعَاوِيَةَ  886  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ،  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  عُثْمَانَ بْنِ الْمُنْذِرِ ،  عَنِ  الْقَاسِمِ بْنِ مُحَمَّدٍ الثَّقَفِيِّ ،  أَنَّ         [19/378]      مُعَاوِيَةَ أَرَاهُمْ وُضُوءَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَلَمَّا بَلَغَ مَسْحَ رَأْسِهِ وَضَعَ كَفَّيْهِ عَلَى مُقَدَّمِ رَأْسِهِ  ثُمَّ بَلَغَ بِهِمَا حَتَّى بَلَغَ الْقَفَا ، ثُمَّ رَدَّهُمَا حَتَّى بَلَغَ الْمَكَانَ الَّذِي مِنْهُ بَدَأَ  .","","Al-Mu'jam al-Kabir 886","","معاوية بن أبي سفيان عن القاسم بن محمد الثقفي عن عثمان بن المنذر الشامي عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن هاشم بن مرثد الطيالسي عن الطبراني","القاسم بن محمد الثقفي عن معاوية"
"17973","887  -  حَدَّثَنَا  مُحَمَّدُ بْنُ هَارُونَ بْنِ مُحَمَّدِ بْنِ بَكَّارٍ الدِّمَشْقِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ خَالِدٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ قَالَ :  قَالَ  عُثْمَانُ بْنُ الْمُنْذِرِ  : سَمِعْتُ  الْقَاسِمَ بْنَ مُحَمَّدٍ الثَّقَفِيَّ ،  يُحَدِّثُ عَنْ  مُعَاوِيَةَ :  أَنَّهُ أَرَاهُمْ وُضُوءَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ، فَلَمَّا بَلَغَ مَسْحَ رَأْسِهِ وَضَعَ كَفَّيْهِ عَلَى مُقَدَّمِ رَأْسِهِ ثُمَّ مَرَّ بِهِمَا حَتَّى بَلَغَ الْقَفَا  ثُمَّ رَدَّهُمَا حَتَّى بَلَغَ الْمَكَانَ الَّذِي مِنْهُ بَدَأَ  .  قَالَ  الْوَلِيدُ  :  وَأَخْبَرَنِي  عَبْدُ اللهِ بْنُ الْعَلَاءِ بْنِ زَبْرٍ ،  عَنْ  أَبِي الْأَزْهَرِ ،  عَنْ  مُعَاوِيَةَ بِذَلِكَ .  وَأَخْبَرَنِي  حَرِيزُ بْنُ عُثْمَانَ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ مَيْسَرَةَ ،  عَنِ  الْمِقْدَامِ بْنِ مَعْدِي كَرِبَ ، عَنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - مِثْلَ ذَلِكَ .","","Al-Mu'jam al-Kabir 887","","المقدام بن معدي كرب الكندي عن عبد الرحمن بن ميسرة الحمصي عن حريز بن عثمان الرحبي عن الوليد بن مسلم القرشي عن محمد بن خالد الدمشقي عن محمد بن هارون بن محمد الدمشقي عن الطبراني","القاسم بن محمد الثقفي عن معاوية"
"17974","888  -  حَدَّثَنَا  إِسْحَاقُ بْنُ دَاوُدَ الصَّوَّافُ التُّسْتَرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سِنَانٍ الْقَزَّازُ ،  ثَنَا  إِسْحَاقُ بْنُ إِدْرِيسَ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  عُثْمَانَ بْنِ مُحَمَّدٍ ،  حَدَّثَنِي  الْقَاسِمُ بْنُ مُحَمَّدٍ الثَّقَفِيُّ ،  أَنَّهُ حَضَرَ مُعَاوِيَةَ تَوَضَّأَ فَمَسَحَ أُذُنَيْهِ ظَاهِرَهُمَا وَبَاطِنَهُمَا ، وَقَالَ :  هَذَا وُضُوءُ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ  .","","Al-Mu'jam al-Kabir 888","","معاوية بن أبي سفيان عن القاسم بن محمد الثقفي عن عثمان بن محمد عن الوليد بن مسلم القرشي عن إسحاق بن إدريس الأسواري عن محمد بن سنان القزاز عن إسحاق بن داود الصواف التستري عن الطبراني","القاسم بن محمد الثقفي عن معاوية"
"17975","يَزِيدُ بْنُ أَبِي مَالِكٍ  وَأَبُو الْأَزْهَرِ  عَنْ  مُعَاوِيَةَ  889  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ ،  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  حَدَّثَنِي  عَبْدُ اللهِ بْنُ الْعَلَاءِ ، أَنَّ يَزِيدَ بْنَ أَبِي مَالِكٍ ، وَأَبَا الْأَزْهَرِ ،  حَدَّثَاهُ  عَنْ  وُضُوءِ مُعَاوِيَةَ  يُرِيهِمْ وُضُوءَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -         [19/379]      فَتَوَضَّأَ ثَلَاثًا إِلَّا غَسْلَ رِجْلَيْهِ بِغَيْرِ عَدَدٍ  .","","Al-Mu'jam al-Kabir 889","","معاوية بن أبي سفيان عن المغيرة بن فروة الثقفي عن عبد الله بن العلاء بن زبر عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن هاشم بن مرثد الطيالسي عن الطبراني","يزيد بن أبي مالك وأبو الأزهر عن معاوية"
"17976","رَاشِدُ بْنُ سَعْدٍ  عَنْ  مُعَاوِيَةَ  890  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  مُحَمَّدُ بْنُ يُوسُفَ الْفِرْيَابِيُّ ،  ثَنَا  سُفْيَانُ ،  عَنْ  ثَوْرِ بْنِ يَزِيدَ ،  عَنْ  رَاشِدِ بْنِ سَعْدٍ ،  عَنْ  مُعَاوِيَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  إِنَّكَ إِنِ اتَّبَعْتَ  عَوْرَاتِ  النَّاسِ أَفْسَدْتَهُمْ أَوْ كِدْتَ أَنْ تُفْسِدَهُمْ  قَالَ :  يَقُولُ  أَبُو الدَّرْدَاءِ  : كَلِمَةٌ سَمِعَهَا  مُعَاوِيَةُ  مِنْ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - نَفَعَهُ اللهُ بِهَا  .","","Al-Mu'jam al-Kabir 890","","معاوية بن أبي سفيان عن راشد بن سعد المقرائي عن ثور بن يزيد الكلاعي عن سفيان الثوري عن محمد بن يوسف الفريابي عن عبد الله بن محمد بن سعيد المصري عن الطبراني","راشد بن سعد عن معاوية"
"17977","891  -  حَدَّثَنَا  عَمْرُو بْنُ إِسْحَاقَ بْنِ إِبْرَاهِيمَ بْنِ الْعَلَاءِ الْحِمْصِيُّ ،  ثَنَا  جَدِّي إِبْرَاهِيمُ بْنُ الْعَلَاءِ  (  ح  ) .  وَحَدَّثَنَا  جَعْفَرُ بْنُ مُحَمَّدٍ الْفِرْيَابِيُّ ،  حَدَّثَنِي  إِبْرَاهِيمُ بْنُ الْعَلَاءِ الْحِمْصِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  حَرِيزِ بْنِ عُثْمَانَ ،  عَنْ  رَاشِدِ بْنِ سَعْدٍ الْمَقْرَائِيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  أَنَّهُ كَانَ يُعَلِّمُ النَّاسَ  التَّشَهُّدَ  وَهُوَ عَلَى الْمِنْبَرِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  التَّحِيَّاتُ  لِلهِ وَالصَّلَوَاتُ  وَالطَّيِّبَاتُ  ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ  ، السَّلَامُ عَلَيْنَا وَعَلَى عَبَّادِ اللهِ الصَّالِحِينَ ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللهُ ، وَأَشْهَدُ أَنَّ  مُحَمَّدًا  عَبْدُهُ وَرَسُولُهُ  .","","Al-Mu'jam al-Kabir 891","","معاوية بن أبي سفيان عن راشد بن سعد المقرائي عن حريز بن عثمان الرحبي عن إسماعيل بن عياش الأحول عن إبراهيم بن العلاء زبريق عن جعفر بن محمد بن الحسن الفريابي عن الطبراني","راشد بن سعد عن معاوية"
"17978","[19/380]      الصُّنَابِحِيُّ  عَنْ  مُعَاوِيَةَ  892  -  حَدَّثَنَا  مُوسَى بْنُ هَارُونَ ،  ثَنَا  إِسْحَاقُ بْنُ رَاهَوَيْهِ ،  ثَنَا  عِيسَى بْنُ يُونُسَ ،  ثَنَا  الْأَوْزَاعِيُّ ،  عَنْ  عَبْدِ اللهِ بْنِ سَعْدٍ ،  عَنِ  الصُّنَابِحِيِّ ،  عَنْ  مُعَاوِيَةَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ -  نَهَى عَنِ  الْغُلُوطَاتِ  قَالَ  إِسْحَاقُ  : وَثَنَا  رَوْحُ بْنُ عُبَادَةَ  ، عَنِ  الْأَوْزَاعِيِّ  قَالَ :  وَالْغُلُوطَاتُ صِعَابِ  الْمَسَائِلِ  وَشِدَادُهَا  .","","Al-Mu'jam al-Kabir 892","","معاوية بن أبي سفيان عن عبد الرحمن بن عسيلة الصنابحي عن عبد الله بن سعد بن فروة البجلي عن أبو عمرو الأوزاعي عن عيسى بن يونس بن أبي إسحاق عن إسحاق ابن راهويه عن موسى بن هارون الحمال عن الطبراني","الصنابحي عن معاوية"
"17979","عُبَيْدُ بْنُ سَعْدٍ  وَابْنُ أَبِي مَرْيَمَ  عَنْ  مُعَاوِيَةَ  893  -  حَدَّثَنَا  مُحَمَّدُ بْنُ مُحَمَّدٍ الْجُذُوعِيُّ الْقَاضِي ،  ثَنَا  إِبْرَاهِيمُ بْنُ الْمُسْتَمِرِّ الْعُرُوقِيُّ ،  ثَنَا  إِسْحَاقُ بْنُ إِدْرِيسَ الْأُسْوَارِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْحَسَنِ الْمُزَنِيُّ ،  ثَنَا  عَاصِمُ بْنُ رَجَاءِ بْنِ حَيْوَةَ ،  عَنْ  عُبَيْدِ بْنِ سَعْدٍ وَابْنِ أَبِي مَرْيَمَ  أَنَّهُمَا سَمِعَا  مُعَاوِيَةَ عَلَى الْمِنْبَرِ وَهُوَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَزَالُ مِنْ أُمَّتِي أُمَّةٌ قَائِمَةٌ لَا يَضُرُّهُمْ مَنْ خَذَلَهُمْ  حَتَّى يَأْتِيَ أَمْرُ اللهِ وَهُمْ ظَاهِرُونَ عَلَى النَّاسِ  .","","Al-Mu'jam al-Kabir 893","","معاوية بن أبي سفيان عن يزيد بن أبي مريم الدمشقي عن عاصم بن رجاء بن حيوة الكندي عن محمد بن الحسن المزني عن إسحاق بن إدريس الأسواري عن إبراهيم بن المستمر العروقي عن الجذوعى محمد بن محمد بن إسماعيل عن الطبراني","عبيد بن سعد وابن أبي مريم عن معاوية"
"17980","ثَابِتُ بْنُ سَعْدٍ  عَنْ  مُعَاوِيَةَ  894  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو ،  ثَنَا  يَحْيَى بْنُ         [19/381]      صَالِحٍ الْوُحَاظِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عُمَرَ الطَّائِيُّ ،  ثَنَا  ثَابِتُ بْنُ سَعْدٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  عَلَيْكُمْ بِالصِّدْقِ فَإِنَّهُ يَهْدِي إِلَى  الْبِرِّ  وَهُمَا فِي الْجَنَّةِ ، وَإِيَّاكُمْ وَالْكَذِبَ فَإِنَّهُ يَهْدِي إِلَى  الْفُجُورِ  وَهُمَا فِي النَّارِ  .","","Al-Mu'jam al-Kabir 894","","معاوية بن أبي سفيان عن ثابت بن سعد الطائفي عن محمد بن عمر المحري عن يحيى بن صالح الوحاظي عن أبو زرعة الدمشقي عن الطبراني","ثابت بن سعد عن معاوية"
"17981","مَالِكُ بْنُ يَخَامِرَ  عَنْ  مُعَاوِيَةَ  895  -  حَدَّثَنَا  الْحَسَنُ بْنُ جَرِيرٍ الصُّورِيُّ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  ضَمْضَمِ بْنِ زُرْعَةَ ،  عَنْ  شُرَيْحِ بْنِ عُبَيْدٍ ،  عَنْ  مَالِكِ بْنِ يَخَامِرَ السَّكْسَكِيِّ ،  عَنْ  عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ وَمُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ وَعَبْدِ اللهِ بْنِ عَمْرِو بْنِ الْعَاصِ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  الْهِجْرَةُ هِجْرَتَانِ ؛ أَحَدُهُمَا أَنْ يَهْجُرَ السَّيِّئَاتِ  ، وَالْأُخْرَى أَنْ يُهَاجِرَ إِلَى اللهِ وَرَسُولِهِ ، وَلَا تَنْقَطِعُ  الْهِجْرَةُ  مَا تُقُبِّلَتِ التَّوْبَةُ ، وَلَا تَزَالُ التَّوْبَةُ مَقْبُولَةً حَتَّى تَطْلُعَ الشَّمْسُ مِنَ الْمَغْرِبِ ، فَإِذَا طَلَعَتْ طُبِعَ عَلَى كُلِّ قَلْبٍ بِمَا فِيهِ وَكُفِيَ النَّاسُ الْعَمَلَ  .","","Al-Mu'jam al-Kabir 895","","عبد الله بن عمرو بن العاص عن مالك بن يخامر السكسكي عن شريح بن عبيد المقرائي عن ضمضم بن زرعة الحضرمي عن إسماعيل بن عياش الأحول عن سليمان بن عبد الرحمن التميمي عن الحسن بن جرير الزنبقي عن الطبراني","مالك بن يخامر عن معاوية"
"17982","[19/382]      عُمَيْرُ بْنُ الْحَارِثِ السَّكُونِيُّ  عَنْ  مُعَاوِيَةَ  896  -  حَدَّثَنَا  عَبْدُ اللهِ بْنُ مُحَمَّدِ بْنِ سَعِيدِ بْنِ أَبِي مَرْيَمَ ،  ثَنَا  عَمْرُو بْنُ أَبِي سَلَمَةَ (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  دُحَيْمٌ ،  ثَنَا  عَمْرُو بْنُ أَبِي سَلَمَةَ ،  ثَنَا  صَدَقَةُ بْنُ عَبْدِ اللهِ ،  عَنْ  نَصْرِ بْنِ عَلْقَمَةَ ،  عَنْ  أَخِيهِ  ،  عَنِ  ابْنِ عَائِذٍ ،  عَنْ  عُمَيْرِ بْنِ الْحَارِثِ السَّكُونِيِّ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ :  لَقَدْ رَافَقْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - وَاسْتَمَعْتُ إِلَيْهِ ، فَسَمِعْتُ أَكْثَرَ صَلَاتِهِ أَنْ يَقُولَ : سُبْحَانَكَ رَبَّ الْعَالَمِينَ  .","","Al-Mu'jam al-Kabir 896","","معاوية بن أبي سفيان عن عمير بن الحارث السكوني عن عبد الرحمن بن عائذ الثمالي عن محفوظ بن علقمة الحضرمي عن نصر بن علقمة الحضرمي عن صدقة بن عبد الله السمين عن عمرو بن أبي سلمة التنيسي عن دحيم عن الحسين بن إسحاق التستري عن الطبراني","عمير بن الحارث السكوني عن معاوية"
"17983","عَبْدُ اللهِ بْنُ مَوْهَبٍ  عَنْ  مُعَاوِيَةَ  897  -  حَدَّثَنَا  أَحْمَدُ بْنُ رِشْدِينَ الْمِصْرِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ سُفْيَانَ الْحَضْرَمِيُّ ،  ثَنَا  ابْنُ لَهِيعَةَ ،  عَنْ  أَبِي قَبِيلٍ أَنَّ ابْنَ مَوْهَبٍ  أَخْبَرَهُ  أَنَّهُ كَانَ عِنْدَ مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ فَدَخَلَ عَلَيْهِ  مَرْوَانُ  فَكَلَّمَهُ فِي حَوَائِجِهِ ، فَقَالَ :  اقْضِ حَاجَتِي يَا أَمِيرَ الْمُؤْمِنِينَ ، فَوَاللهِ إِنَّ مُؤْنَتِي لَعَظِيمَةٌ  ، إِنِّي أَصْبَحْتُ أَبَا عَشَرَةٍ وَأَخَا عَشَرَةٍ وَعَمَّ عَشَرَةٍ ، فَلَمَّا أَدْبَرَ  مَرْوَانُ  وَابْنُ عَبَّاسٍ  جَالِسٌ مَعَ  مُعَاوِيَةَ  عَلَى سَرِيرِهِ ، فَقَالَ  مُعَاوِيَةُ  :  أَنْشُدُكَ  اللهَ يَا  ابْنَ عَبَّاسٍ ،  أَمَا تَعْلَمُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  إِذَا بَلَغَ  بَنُو الْحَكَمِ  ثَلَاثِينَ رَجُلًا اتَّخَذُوا آيَاتِ اللهِ بَيْنَهُمْ دُوَلًا ، وَعِبَادَهُ  خَوَلًا  ، وَكِتَابَهُ  دَغَلًا  ، فَإِذَا بَلَغُوا تِسْعَةً وَتِسْعِينَ وَأَرْبَعَمِائَةٍ         [19/383]      كَانَ هَلَاكُهُمْ أَسْرَعَ مِنَ  الثَّمَرَةِ  ؟ قَالَ ابْنُ عَبَّاسٍ : اللَّهُمَّ نَعَمْ ، فَذَكَرَ  مَرْوَانُ  حَاجَةً لَهُ فَرَدَّ  مَرْوَانُ بْنُ عَبْدِ الْمَلِكِ  إِلَى  مُعَاوِيَةَ  فَكَلَّمَهُ فِيهَا ، فَلَمَّا أَدْبَرَ قَالَ  مُعَاوِيَةُ  :  أَنْشُدُكَ  اللهَ يَا  ابْنَ عَبَّاسٍ ،  أَمَا تَعْلَمُ أَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - ذَكَرَ هَذَا فَقَالَ :  أَبُو الْجَبَابِرَةِ الْأَرْبَعَةِ  ؟ فَقَالَ  ابْنُ عَبَّاسٍ  : اللَّهُمَّ نَعَمْ  .","","Al-Mu'jam al-Kabir 897","","عبد الله بن عباس عن عبد الله بن موهب الهمداني عن حيي بن هانئ السريعي عن عبد الله بن لهيعة عن محمد بن سفيان الحضرمي عن أحمد بن محمد بن الحجاج المصري عن الطبراني","عبد الله بن موهب عن معاوية"
"17984","أَبُو عَبْدِ اللهِ مُسْلِمُ بْنُ مِشْكَمٍ  عَنْ  مُعَاوِيَةَ  898  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  يُوسُفُ بْنُ مُحَمَّدٍ الْمَعْنَى  ،  ثَنَا  عَبْدُ الْأَعْلَى ،  عَنْ  جَعْفَرِ بْنِ الزُّبَيْرِ ،  عَنْ  أَبِي عَبْدِ اللهِ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ عَلَى الْمِنْبَرِ - وَكَانَ قَلِيلَ الْحَدِيثِ عَنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّ اللهَ تَعَالَى أَخْرَجَ  ذُرِّيَّةَ  آدَمَ مِنْ صُلْبِهِ حَتَّى مَلَئُوا الْأَرْضَ وَكَانُوا هَكَذَا  - فَضَمَّ  جَعْفَرٌ  يَدَيْهِ إِحْدَاهُمَا عَلَى الْأُخْرَى  .  كذا في طبعة مكتبة ابن تيمية ، والصواب : ( يوسف بن حماد )","","Al-Mu'jam al-Kabir 898","","معاوية بن أبي سفيان عن مسلم بن مشكم الخزاعي عن جعفر بن الزبير الباهلي عن عبد الأعلى بن عبد الأعلى القرشي عن يوسف بن حماد البصري عن الساجي عن الطبراني","أبو عبد الله مسلم بن مشكم عن معاوية"
"17985","عُمَيْرُ بْنُ هَانِئٍ الْعَنْسِيُّ  عَنْ  مُعَاوِيَةَ  899  -  حَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى بْنِ الطَّبَّاعِ ،  ثَنَا  الْقَاسِمُ بْنُ مُوسَى ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ جَابِرٍ أَنَّ عُمَيْرَ بْنَ هَانِئٍ  حَدَّثَهُ  أَنَّهُ سَمِعَ  مُعَاوِيَةَ يَقُولُ : سَمِعْتُ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَزَالُ  طَائِفَةٌ  مِنْ أُمَّتِي قَائِمَةً بِأَمْرِ اللهِ  لَا يَضُرُّهُمْ مَنْ خَذَلَهُمْ حَتَّى يَأْتِيَ أَمْرُ اللهِ وَهُمْ ظَاهِرُونَ عَلَى النَّاسِ  .","","Al-Mu'jam al-Kabir 899","","معاوية بن أبي سفيان عن عمير بن هانئ الداراني عن عبد الرحمن بن يزيد الداراني عن القاسم بن موسى عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","عمير بن هانئ العنسي عن معاوية"
"17986","[19/384]      أَبُو الْأَزْهَرِ  عَنْ  مُعَاوِيَةَ  900  -  حَدَّثَنَا  هَاشِمُ بْنُ مَرْثَدٍ الطَّبَرَانِيُّ وَوَرْدُ بْنُ أَحْمَدَ بْنِ لَبِيدٍ الْبَيْرُوتِيُّ قَالَا :  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْعَلَاءِ ،  عَنْ  أَبِي الْأَزْهَرِ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ  أَنَّهُ ذَكَرَ لَهُمْ وُضُوءَ رَسُولِ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - أَنَّهُ مَسَحَ بِرَأْسِهِ حَتَّى قَطَرَ الْمَاءُ مِنْ رَأْسِهِ أَوْ كَادَ أَنْ يَقْطُرَ  ، وَأَنَّ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - لَمَّا بَلَغَ مَسْحَ رَأْسِهِ وَضَعَ كَفَّيْهِ عَلَى مُقَدَّمِ رَأْسِهِ ثُمَّ مَرَّ بِهِمَا حَتَّى بَلَغَ بِهِمَا الْقَفَا ، ثُمَّ رَدَّهُمَا حَتَّى بَلَغَ الْمَكَانَ الَّذِي مِنْهُ بَدَأَ  .","","Al-Mu'jam al-Kabir 900","","معاوية بن أبي سفيان عن المغيرة بن فروة الثقفي عن عبد الله بن العلاء بن زبر عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن هاشم بن مرثد الطيالسي عن الطبراني","أبو الأزهر عن معاوية"
"17987","901  -  حَدَّثَنَا  وَرْدُ بْنُ أَحْمَدَ بْنِ لَبِيدٍ ،  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  عَبْدُ اللهِ بْنُ الْعَلَاءِ بْنِ زَبْرٍ قَالَ :  سَمِعْتُ  أَبَا الْأَزْهَرِ يَقُولُ :  قَامَ مُعَاوِيَةُ  بِدَيْرِ مِسْحَلٍ  الَّذِي عَلَى  بَابِ حِمْصٍ  فَقَالَ : أَلَا إِنَّ الصِّيَامَ يَوْمُ كَذَا وَكَذَا ، وَإِنَّا مُتَقَدِّمُونَ غَدًا ، فَقَامَ إِلَيْهِ  مَالِكُ بْنُ هُبَيْرَةَ  فَقَالَ : يَا  مُعَاوِيَةُ ،  أَرَأْيٌ رَأَيْتَهُ أَمْ شَيْئًا سَمِعْتَهُ مِنْ رَسُولِ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ؟ فَقَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  صُومُوا  الشَّهْرَ  وَسِرَّهُ  .","","Al-Mu'jam al-Kabir 901","","معاوية بن أبي سفيان عن المغيرة بن فروة الثقفي عن عبد الله بن العلاء بن زبر عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن محمد بن أحمد بن لبيد عن الطبراني","أبو الأزهر عن معاوية"
"17988","أَيُّوبُ بْنُ مَيْسَرَةَ بْنِ حَلْبَسٍ  عَنْ  مُعَاوِيَةَ  902  -  حَدَّثَنَا  أَبُو زُرْعَةَ عَبْدُ الرَّحْمَنِ بْنُ عَمْرٍو الدِّمَشْقِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُبَارَكِ الصُّورِيُّ ،  ثَنَا  خَالِدُ بْنُ يَزِيدَ بْنِ صُبَيْحٍ ،  عَنْ  أَيُّوبَ بْنِ مَيْسَرَةَ ،  عَنْ  مُعَاوِيَةَ  أَنَّهُ كَانَ يَبْعَثُ  حَرَسًا  مِنْ  حَرَسِهِ  إِلَى  كَنَاكِرُونَ كُبَّةٍ  ،  وَقَرُوا  يَقُولُ :         [19/385]      إِنَّ هَذَا يَوْمَ عَاشُورَاءَ ، وَكَانَ النَّبِيُّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَصُومُهُ  ، وَنَحْنُ صَائِمُونَ ، فَمَنْ أَحَبَّ أَنْ يَصُومَهُ فَلْيَصُمْهُ  .","","Al-Mu'jam al-Kabir 902","","معاوية بن أبي سفيان عن أيوب بن ميسرة بن حبلس الجبلاني عن خالد بن يزيد بن صالح المري عن محمد بن المبارك القلانسي عن أبو زرعة الدمشقي عن الطبراني","أيوب بن ميسرة بن حلبس عن معاوية"
"17989","يُونُسُ بْنُ مَيْسَرَةَ بْنِ حَلْبَسٍ  عَنْ  مُعَاوِيَةَ  903  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ،  ثَنَا  صَفْوَانُ بْنُ صَالِحٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  عَبْدُ الرَّحْمَنِ بْنُ يَزِيدَ بْنِ جَابِرٍ ،  عَنْ  يُونُسَ بْنِ مَيْسَرَةَ بْنِ حَلْبَسٍ ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  لَا تُقَدَّسُ أُمَّةٌ لَا يُقْضَى فِيهَا بِالْحَقِّ  وَيَأْخُذُ الضَّعِيفُ حَقَّهُ مِنَ الْقَوِيِّ غَيْرَ  مُتَعْتَعٍ  .","","Al-Mu'jam al-Kabir 903","","معاوية بن أبي سفيان عن يونس بن ميسرة بن حلبس الجبلاني عن عبد الرحمن بن يزيد الداراني عن الوليد بن مسلم القرشي عن صفوان بن صالح الدمشقي عن أحمد بن المعلى الأسدي عن الطبراني","يونس بن ميسرة بن حلبس عن معاوية"
"17990","904  -  حَدَّثَنَا  أَحْمَدُ بْنُ الْمُعَلَّى الدِّمَشْقِيُّ ،  ثَنَا  هِشَامُ بْنُ عَمَّارٍ (  ح  ) .  وَحَدَّثَنَا  مُحَمَّدُ بْنُ عَبْدُوسِ بْنِ جَرِيرٍ الصُّورِيُّ  ، ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ الرَّحْمَنِ الدِّمَشْقِيُّ (  ح  ) .  وَحَدَّثَنَا  عَلِيُّ بْنُ عَبْدِ الْعَزِيزِ ،  ثَنَا  سُلَيْمَانُ بْنُ أَحْمَدَ الْوَاسِطِيُّ - قَالُوا :  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  مَرْوَانُ بْنُ جَنَاحٍ ،  ثَنَا  يُونُسُ بْنُ مَيْسَرَةَ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ         [19/386]      بْنَ أَبِي سُفْيَانَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  الْخَيْرُ عَادَةٌ وَالشَّرُّ لَجَاجَةٌ  . زَادَ  ابْنُ بِنْتِ شُرَحْبِيلَ  فِي حَدِيثِهِ عَنِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ : وَمَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 904","","معاوية بن أبي سفيان عن يونس بن ميسرة بن حلبس الجبلاني عن مروان بن جناح الدمشقي عن الوليد بن مسلم القرشي عن سليمان بن أحمد الدمشقي عن علي بن عبد العزيز بن المرزبان البغوي عن الطبراني","يونس بن ميسرة بن حلبس عن معاوية"
"17991","905  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ دُحَيْمٍ ،  ثَنَا  أَبِي  (  ح  ) .  وَحَدَّثَنَا  الْحُسَيْنُ بْنُ إِسْحَاقَ التُّسْتَرِيُّ ،  ثَنَا  دُحَيْمٌ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  ثَنَا  مَرْوَانُ بْنُ جَنَاحٍ ،  عَنْ  يُونُسَ بْنِ مَيْسَرَةَ بْنِ حَلْبَسٍ ،  عَنْ  مُعَاوِيَةَ بْنِ أَبِي سُفْيَانَ قَالَ :  كُنَّا جُلُوسًا فِي الْمَسْجِدِ إِذْ خَرَجَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  إِنَّكُمْ تَتَحَدَّثُونَ أَنِّي مِنْ آخِرِكُمْ وَفَاةً وَأَنِّي مِنْ أَوَّلِكُمْ وَفَاةً  ، وَتَتْبَعُونِي  أَفْنَادًا  -  يَعْنِي بَعْضُكُمْ بَعْضًا  - ثُمَّ نَزَعَ بِهَذِهِ الْآيَةِ ، فَقَالَ :         {      قُلْ هُوَ الْقَادِرُ عَلَى أَنْ يَبْعَثَ عَلَيْكُمْ عَذَابًا مِنْ فَوْقِكُمْ أَوْ مِنْ تَحْتِ أَرْجُلِكُمْ         }      - حَتَّى بَلَغَ :         {      لِكُلِّ نَبَإٍ مُسْتَقَرٌّ وَسَوْفَ تَعْلَمُونَ         }      ، ثُمَّ قَالَ : لَا تَبْرَحُ عِصَابَةٌ مِنْ أُمَّتِي يُقَاتِلُونَ عَلَى الْحَقِّ ظَاهِرِينَ لَا  يُبَالُونَ  مَنْ خَذَلَهُمْ وَلَا مَنْ خَالَفَهُمْ حَتَّى يَأْتِيَ أَمْرُ اللهِ عَلَى ذَلِكَ ، ثُمَّ نَزَعَ بِهَذِهِ الْآيَةِ :         {      يَا عِيسَى إِنِّي مُتَوَفِّيكَ وَرَافِعُكَ إِلَيَّ وَمُطَهِّرُكَ مِنَ الَّذِينَ كَفَرُوا وَجَاعِلُ الَّذِينَ اتَّبَعُوكَ فَوْقَ الَّذِينَ كَفَرُوا إِلَى يَوْمِ الْقِيَامَةِ         }      .","","Al-Mu'jam al-Kabir 905","","معاوية بن أبي سفيان عن يونس بن ميسرة بن حلبس الجبلاني عن مروان بن جناح الدمشقي عن الوليد بن مسلم القرشي عن دحيم عن إبراهيم بن دحيم الدمشقي عن الطبراني","يونس بن ميسرة بن حلبس عن معاوية"
"17992","906  -  حَدَّثَنَا  الْحُسَيْنُ بْنُ السَّمَيْدَعِ الْأَنْطَاكِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ الْمُبَارَكِ الصُّورِيُّ ،  ثَنَا  عَمْرُو بْنُ وَاقِدٍ ،  ثَنَا  يُونُسُ بْنُ مَيْسَرَةَ بْنِ حَلْبَسٍ قَالَ :  سَمِعْتُ  مُعَاوِيَةَ بْنَ أَبِي سُفْيَانَ يَقُولُ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 906","","معاوية بن أبي سفيان عن يونس بن ميسرة بن حلبس الجبلاني عن عمرو بن واقد القرشي عن محمد بن المبارك القلانسي عن الحسين بن السميدع البجلي عن الطبراني","يونس بن ميسرة بن حلبس عن معاوية"
"17993","[19/387]      قَالَ  :  وَخَرَجَ عَلَيْنَا رَسُولُ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - فَقَالَ :  أَتَقُولُونَ إِنِّي مِنْ آخِرِكُمْ مَوْتًا  ؟ قُلْنَا : نَعَمْ . قَالَ : فَإِنِّي مِنْ أَوَّلِكُمْ مَوْتًا ، ثُمَّ تَتْبَعُونِي  أَفْنَادًا  يَتْبَعُ بَعْضُكُمْ بَعْضًا .","","Al-Mu'jam al-Kabir 17993","","معاوية بن أبي سفيان عن يونس بن ميسرة بن حلبس الجبلاني عن عمرو بن واقد القرشي عن محمد بن المبارك القلانسي عن الحسين بن السميدع البجلي عن الطبراني","يونس بن ميسرة بن حلبس عن معاوية"
"17994","وَسَمِعْتُ  رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَزَالُ  طَائِفَةٌ  مِنْ أُمَّتِي قَائِمَةً عَلَى الْحَقِّ لَا  يُبَالُونُ  مَنْ خَالَفَهُمْ  وَلَا مَنْ خَذَلَهُمْ حَتَّى يَأْتِيَ أَمْرُ اللهِ وَهُمْ ظَاهِرُونَ عَلَى النَّاسِ  .","","Al-Mu'jam al-Kabir 17994","","معاوية بن أبي سفيان عن يونس بن ميسرة بن حلبس الجبلاني عن عمرو بن واقد القرشي عن محمد بن المبارك القلانسي عن الحسين بن السميدع البجلي عن الطبراني","يونس بن ميسرة بن حلبس عن معاوية"
"17995","أَبُو هِنْدٍ الْبَجَلِيُّ  عَنْ  مُعَاوِيَةَ  907  -  حَدَّثَنَا  أَحْمَدُ بْنُ حَمْزَةَ الدِّمَشْقِيُّ ،  ثَنَا  عَلِيُّ بْنُ عَيَّاشٍ الْحِمْصِيُّ ،  ثَنَا  حَرِيزُ بْنُ عُثْمَانَ ،  حَدَّثَنِي  عَبْدُ الرَّحْمَنِ بْنُ أَبِي عَوْفٍ ،  عَنْ  أَبِي هِنْدٍ الْبَجَلِيِّ ،  عَنْ  مُعَاوِيَةَ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا تَنْقَطِعُ  الْهِجْرَةُ  حَتَّى تَنْقَطِعَ التَّوْبَةُ  - ثَلَاثَ مَرَّاتٍ - وَلَا تَنْقَطِعُ التَّوْبَةُ حَتَّى تَطْلُعَ الشَّمْسُ مِنْ مَغْرِبِهَا  .","","Al-Mu'jam al-Kabir 907","","معاوية بن أبي سفيان عن أبو هند البجلي عن عبد الرحمن بن أبي عوف الجرشي عن حريز بن عثمان الرحبي عن علي بن عياش الألهاني عن أحمد بن محمد بن يحيى البتلهي عن الطبراني","أبو هند البجلي عن معاوية"
"17996","رَبِيعَةُ بْنُ يَزِيدَ  عَنْ  مُعَاوِيَةَ  908  -  حَدَّثَنَا  عَبْدُ الْعَزِيزِ بْنُ سُلَيْمَانَ الْحَرْمَلِيُّ الْأَنْطَاكِيُّ ،  ثَنَا  يَعْقُوبُ بْنُ كَعْبٍ ،  ثَنَا  الْوَلِيدُ بْنُ مُسْلِمٍ ،  عَنْ  سَعِيدِ بْنِ عَبْدِ الْعَزِيزِ ،  عَنْ  رَبِيعَةَ         [19/388]      بْنِ يَزِيدَ  أَنَّ  مُعَاوِيَةَ  كَتَبَ  إِلَى  مَسْلَمَةَ بْنِ مَخْلَدٍ  أَنْ سَلْ عَبْدَ اللهِ بْنَ عَمْرِو بْنِ الْعَاصِ هَلْ سَمِعَ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  لَا  قُدِّسَتْ  أُمَّةٌ لَا يَأْخُذُ ضَعِيفُهَا حَقَّهُ مِنْ قَوِيِّهَا وَهُوَ غَيْرُ مُضْطَهَدٍ  ؟ فَإِنْ قَالَ نَعَمْ فَاحْمِلْهُ إِلَيَّ عَلَى الْبَرِيدِ - فَسَأَلَهُ  فَقَالَ  نَعَمْ ، فَحَمَلَهُ عَلَى الْبَرِيدِ مِنْ  مِصْرَ  إِلَى  الشَّامِ ،  فَسَأَلَهُ  مُعَاوِيَةُ  فَأَخْبَرَهُ ، فَقَالَ  مُعَاوِيَةُ  : وَأَنَا قَدْ سَمِعْتُهُ ، وَلَكِنْ أَحْبَبْتُ أَنْ أَثَّبَّتَ  .","","Al-Mu'jam al-Kabir 908","","عبد الله بن عمرو بن العاص عن ربيعة بن يزيد القصير عن سعيد بن عبد العزيز التنوخي عن الوليد بن مسلم القرشي عن يعقوب بن كعب الأنطاكي عن عبد العزيز بن سليمان الحرملي عن الطبراني","ربيعة بن يزيد عن معاوية"
"17997","يَعْلَى بْنُ شَدَّادِ بْنِ أَوْسٍ  عَنْ  مُعَاوِيَةَ  909  -  حَدَّثَنَا  أَحْمَدُ بْنُ يَحْيَى بْنِ خَالِدِ بْنِ حَيَّانَ ،  حَدَّثَنِي  أَبِي ،  عَنْ  جَدِّي  (  ح  ) .  وَحَدَّثَنَا  طَالِبُ بْنُ قُرَّةَ الْأَذَنِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ عِيسَى الطَّبَّاعُ ،  ثَنَا  خَالِدُ بْنُ حَيَّانَ ،  ثَنَا  سُلَيْمَانُ بْنُ عَبْدِ اللهِ بْنِ الزِّبْرِقَانِ ،  عَنْ  يَعْلَى بْنِ شَدَّادٍ ،  ثَنَا  مُعَاوِيَةُ قَالَ : سَمِعْتُ رَسُولَ اللهِ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - يَقُولُ :  أَلَا إِنَّ كُلَّ مُسْكِرٍ عَلَى كُلِّ مُؤْمِنٍ حَرَامٌ  .","","Al-Mu'jam al-Kabir 909","","معاوية بن أبي سفيان عن يعلى بن شداد بن أوس الخزرجي عن سليمان بن عبد الله بن الزبرقان الأنطاكي عن خالد بن حيان الرقي عن ابن الطباع ، محمد بن عيسى بن نجيح البغدادي عن طالب بن قرة الأذني عن الطبراني","يعلى بن شداد بن أوس عن معاوية"
"17998","شُرَيْحُ بْنُ عُبَيْدٍ  عَنْ  مُعَاوِيَةَ  910  -  حَدَّثَنَا  إِبْرَاهِيمُ بْنُ مُحَمَّدِ بْنِ عِرْقٍ الْحِمْصِيُّ ،  ثَنَا  عَبْدُ الْوَهَّابِ بْنُ الضَّحَّاكِ ،  ثَنَا  إِسْمَاعِيلُ بْنُ عَيَّاشٍ ،  عَنْ  ضَمْضَمِ بْنِ زُرْعَةَ ،  عَنْ  شُرَيْحِ بْنِ عُبَيْدٍ ،  عَنْ  مُعَاوِيَةَ قَالَ : قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ :  مَنْ مَاتَ بِغَيْرِ إِمَامٍ مَاتَ  مِيتَةً  جَاهِلِيَّةً  .","","Al-Mu'jam al-Kabir 910","","معاوية بن أبي سفيان عن شريح بن عبيد المقرائي عن ضمضم بن زرعة الحضرمي عن إسماعيل بن عياش الأحول عن عبد الوهاب بن الضحاك عن إبراهيم بن محمد بن عرق الحمصي عن الطبراني","شريح بن عبيد عن معاوية"
"17999","[19/389]      رَجَاءُ بْنُ حَيْوَةَ  عَنْ  مُعَاوِيَةَ  911  -  حَدَّثَنَا  زَكَرِيَّا بْنُ يَحْيَى السَّاجِيُّ ،  ثَنَا  مُحَمَّدُ بْنُ بَشَّارٍ ،  ثَنَا  أَبُو دَاوُدَ ،  ثَنَا  شُعْبَةُ ،  عَنْ  جَرَادٍ ،  عَنْ  رَجَاءِ بْنِ حَيْوَةَ ،  عَنْ  مُعَاوِيَةَ ، عَنِ النَّبِيِّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا يُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 911","","معاوية بن أبي سفيان عن رجاء بن حيوة عن جراد بن مجالد الضبي عن شعبة بن الحجاج عن أبو داود الطيالسي عن محمد بن بشار بندار عن الساجي عن الطبراني","رجاء بن حيوة عن معاوية"
"18000","912  -  حَدَّثَنَا  مُعَاذُ بْنُ الْمُثَنَّى ،  ثَنَا  أَبِي  ،  ثَنَا  ابْنُ عَوْنٍ ،  عَنْ  رَجَاءِ بْنِ حَيْوَةَ ،  عَنْ  مُعَاوِيَةَ أَنَّ النَّبِيَّ - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - قَالَ :  مَنْ يُرِدِ اللهُ بِهِ خَيْرًا فَلْيُفَقِّهْهُ فِي الدِّينِ  .","","Al-Mu'jam al-Kabir 912","","معاوية بن أبي سفيان عن رجاء بن حيوة عن عبد الله بن عون بن أرطبان عن المثنى بن معاذ بن معاذ العنبري عن معاذ بن المثنى العنبري عن الطبراني","رجاء بن حيوة عن معاوية"
