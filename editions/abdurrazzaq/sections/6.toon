hadiths[count]{hadithnumber,arabic,grades,reference,international_number,narrator_chain,chapter_intro}:
"3026","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ السَّائِبِ , عَنْ زَاذَانَ , عَنِ ابْنِ مَسْعُودٍ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" إِنَّ لِلَّهِ عَزَّ وَجَلَّ مَلائِكَةٌ سَيَّاحِينَ فِي الأَرْضِ يُبَلِّغُونَ عَنْ أُمَّتِي السَّلامَ \"","","","","","Book of Prayer"
"3027","عَنِ الثَّوْرِيِّ , عَنْ مُوسَى بْنِ عُبَيْدَةَ , عَنْ مُحَمَّدِ بْنِ إِبْرَاهِيمَ التَّيْمِيِّ , عَنْ أَبِيهِ , عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا تَجْعَلُونِي كَقَدَحِ الرَّاكِبِ , فَإِنَّ الرَّاكِبَ إِذَا أَرَادَ أَنْ يَنْطَلِقَ عَلَّقَ مَعَالِقَهُ , وَمَلأَ قَدَحًا مَاءً , فَإِنْ كَانَتْ لَهُ حَاجَةٌ فِي أَنْ يَتَوَضَّأَ تَوَضَّأَ , وَأَنْ يَشْرَبَ شَرِبَ , وَإِلا أَهْرَاقَ , فَاجْعَلُونِي فِي وَسَطِ الدُّعَاءِ وَفِي أَوَّلِهِ وَفِي آخِرِهِ \"","","","","","Book of Prayer"
"3028","عَنِ الثَّوْرِيِّ , عَنْ مُوسَى بْنِ عُبَيْدَةَ , عَنْ مُحَمَّدِ بْنِ ثَابِتٍ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا قَالَ الرَّجُلُ لأَخِيهِ : جَزَاكَ اللَّهُ خَيْرًا فَقَدْ أَبْلَغَ فِي الثَّنَاءِ \"","","","","","Book of Prayer"
"3029","قَالَ : وَقَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" صَلُّوا عَلَى أَنْبِيَاءِ اللَّهِ وَرُسُلِهِ , فَإِنَّ اللَّهَ بَعَثَهُمْ \"","","","","","Book of Prayer"
"3030","عَنِ الثَّوْرِيِّ , عَنْ أَبِي سَهْلٍ عُثْمَانَ بْنِ حَكِيمٍ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" لا يَنْبَغِي الصَّلاةُ عَلَى أَحَدٍ إِلا عَلَى النَّبِيِّينَ \" . قَالَ سُفْيَانُ : \" يُكْرَهُ أَنْ يُصَلَّى إِلا عَلَى نَبِيٍّ \"","","","","","Book of Prayer"
"3031","عَنِ الثَّوْرِيِّ , عَنْ لَيْثٍ , عَنْ كَعْبٍ , عَنْ أَبِي هُرَيْرَةَ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" إِذَا صَلَّيْتُمْ عَلَيَّ فَسَلُوا الْوَسِيلَةَ \" , قِيلَ : وَمَا الْوَسِيلَةُ يَا رَسُولَ اللَّهِ ؟ , قَالَ : \" أَعْلَى دَرَجَةٍ فِي الْجَنَّةِ لا يَنَالُهَا إِلا رَجُلٌ وَاحِدٌ , وَأَرْجُو أَنْ أَكُونَ أَنَا هُوَ \"","","","","","Book of Prayer"
"3032","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , وَابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ مُحَمَّدِ بْنِ عَلِيٍّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مِنَ الْجَفَاءِ أَنْ أُذْكَرَ عِنْدَ الرَّجُلِ فَلا يُصَلِّي عَلَيَّ \"","","","","","Book of Prayer"
"3033","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَسْتَغْفِرُ لِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ؟ , قَالَ : \" نَعَمْ , قَدْ ولاء أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِذَلِكَ , فَإِنَّ ذَلِكَ الْوَاجِبُ عَلَى النَّاسِ , قَالَ اللَّهُ لِنَبِيِّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ :  وَاسْتَغْفِرْ لِذَنْبِكَ وَلِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ \" , قُلْتُ : أَفَتَدَعُ ذَلِكَ فِي الْمَكْتُوبَةِ أَبَدًا ؟ , قَالَ : \" لا \" , قُلْتُ : فَبِمَنْ تَبْدَأُ , بِنَفْسِكَ أَمْ بِالْمُؤْمِنِينَ ؟ , قَالَ : \" بَلْ بِنَفْسِي كَمَا , قَالَ اللَّهُ :  وَاسْتَغْفِرْ لِذَنْبِكَ وَلِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ \"","","","","","Book of Prayer"
"3034","عَنْ مَعْمَرٍ , عَنْ أَبَانَ , عَنْ أَنَسٍ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَا مِنْ عَبْدٍ يَدْعُو لِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ إِلا رَدَّ اللَّهُ عَلَيْهِ عَنْ كُلِّ مُؤْمِنٍ وَمُؤْمِنَةٍ مَضَى , أَوْ هُوَ كَائِنٌ إِلَى يَوْمِ الْقِيَامَةِ بِمِثْلِ مَا دَعَا بِهِ","","","","","Book of Prayer"
"3035","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : كَيْفَ بَلَغَكَ كَانَ بَدْءُ السَّلامِ ؟ , قَالَ : \" لا أَدْرِي غَيْرَ أَنَّ أَوَّلَ مَنْ رَفَعَ صَوْتَهُ بِالتَّسْلِيمِ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ , قَالَ : \" كَانُوا يُسَلِّمُونَ عَلَى أَنْفُسِهِمْ لا يَرْفَعُونَ بِالتَّسْلِيمِ أَصْوَاتَهُمْ \" , قُلْتُ : فَيَنْصَرِفُونَ عَلَى تَسْلِيمِ التَّشَهُّدِ , قَالَ : \" لا , وَلَكِنْ كَانُوا يَقُولُونَ : السَّلامُ عَلَيْكُمْ فِي أَنْفُسِهِمْ , ثُمَّ يَقُومُونَ حَتَّى رَفَعَ عُمَرُ صَوْتَهُ \"","","","","","Book of Prayer"
"3036","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , أَنَّ مُجَاهِدًا أَخْبَرَهُ , عَنْ طَاوُسٍ : \" إِنَّ أَوَّلَ مَنْ رَفَعَ صَوْتَهُ بِالتَّسْلِيمِ عُمَرُ بْنُ الْخَطَّابِ رَضِيَ اللَّهُ عَنْهُ \"","","","","","Book of Prayer"
"3037","عَنِ ابْنِ عُيَيْنَةَ , قَالَ : أَخْبَرَنِي ابْنُ أَبِي حُسَيْنٍ , قَالَ : أَدْرَكَنِي ابْنُ طَاوُسٍ بِالطَّوَافِ فَضَرَبَ عَلَى مَنْكِبِي , فَقَالَ لأَبِيهِ : صَاحِبُكَ عَلَى أَنْ يَجْهَرَ بِالتَّسْلِيمِ يَعْنِي ابْنَ هِشَامٍ , قَالَ : \" أَوَّلُ مَنْ جَهَرَ بِالتَّسْلِيمِ عُمَرُ بْنُ الْخَطَّابِ , فَعَابَ عَلَيْهِ ذَلِكَ الأَنْصَارُ , فَقَالُوا : وَعَلَيْكَ أَيْ عَلَيْكَ السَّلامُ مَا شَأْنُكَ ؟ , قَالَ : \" أَرَدْتُ أَنْ يَكُونَ إِذْنِي \"","","","","","Book of Prayer"
"3038","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ أَبِي الضُّحَى , عَنْ مَسْرُوقٍ , عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ , قَالَ : \" مَا نَسِيتُ فِيمَا نَسِيتُ عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَنَّهُ كَانَ يُسَلِّمُ عَنْ يَمِينِهِ السَّلامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ حَتَّى نَرَى بَيَاضَ خَدِّهِ , وَعَنْ يَسَارِهِ السَّلامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ حَتَّى نَرَى بَيَاضَ خَدِّهِ أَيْضًا \"","","","","","Book of Prayer"
"3039","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنْ حَمَّادٍ , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا سَلَّمَ يُرَى بَيَاضُ خَدِّهِ الأَيْسَرِ \"","","","","","Book of Prayer"
"3040","عَنْ مَعْمَرٍ , عَنْ خُصَيْفٍ الْجَزَرِيِّ , عَنْ أَبِي عُبَيْدَةَ بْنِ عَبْدِ اللَّهِ , أَنَّ ابْنَ مَسْعُودٍ : \" كَانَ يُسَلِّمُ عَنْ يَمِينِهِ السَّلامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , وَعَنْ يَسَارِهِ السَّلامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , يَجْهَرُ بِكِلْتَيْهِمَا \" , قَالَ : أَظُنُّهُ لَمْ يُتَابِعْهُ عَلَيْهِ أَحَدٌ عَنْ مَعْمَرٍ , والثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي الأَحْوَصِ , عَنْ عَبْدِ اللَّهِ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَ أَبِي الضُّحَى","","","","","Book of Prayer"
"3041","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنْ أَبِي رَزِينٍ , \" أَنَّ عَلِيًّا كَانَ يُسَلِّمُ عَنْ يَمِينِهِ , وَعَنْ يَسَارِهِ , السَّلامُ عَلَيْكُمُ السَّلامُ عَلَيْكُمْ \" , عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ رَجُلٍ , عَنْ عَلِيٍّ مِثْلَهُ . عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي رَزِينٍ , عَنْ عَلِيٍّ مِثْلَهُ","","","","","Book of Prayer"
"3042","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ حَارِثَةَ بْنِ مُضَرِّبٍ , \" أَنَّ عَمَّارَ بْنَ يَاسِرٍ كَانَ يُسَلِّمُ عَنْ يَمِينِهِ السَّلامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ , وَعَنْ يَسَارِهِ مِثْلَ ذَلِكَ \"","","","","","Book of Prayer"
"3043","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مِسْعَرٍ , عَنْ مُهَاجِرِ بْنِ الْقِبْطِيَّةِ , قَالَ : سَمِعْتُ جَابِرَ بْنَ سَمُرَةَ , يَقُولُ : كُنَّا نُصَلِّي مَعَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَنَقُولُ بِأَيْدِينَا : السَّلامُ عَلَيْكُمْ , فَقَالَ : \" مَا بَالُ أَقْوَامٍ يُلْقُونَ أَيْدِيَهُمْ كَأَنَّهَا أَذْنَابُ خَيْلٍ شُمْسٍ , أَلا يَكْفِي أَحَدَكُمْ , أَوْ إِنَّمَا يَكْفِي أَحَدَكُمْ , أَنْ يَضَعَ يَدَهُ عَلَى فَخِذِهِ , ثُمَّ يُسَلِّمَ عَلَى أَخِيهِ , عَنْ يَمِينِهِ , وَعَنْ شِمَالِهِ \"","","","","","Book of Prayer"
"3044","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , \" أَنَّ نَافِعَ بْنَ عَبْدِ الْحَارِثِ وَهُوَ أَمِيرُ مَكَّةَ دَخَلَ , كَانَ إِذَا سَلَّمَ الْتَفَتَ فَيُسَلِّمُ عَنْ يَمِينِهِ , ثُمَّ يُسَلِّمُ عَنْ شِمَالِهِ \" , فَبَلَغَتْ ابْنَ مَسْعُودٍ , فَقَالَ : أَنَّى أَخَذَهَا ابْنُ عَبْدِ الْحَارِثِ ؟ , قَالَ ابْنُ جُرَيْجٍ : وَبَلَغَنِي أَنَّ ابْنَ مَسْعُودٍ , قَالَ : \" أَنَّى أَخَذَهَا ؟ , فَإِنِّي رَأَيْتُ بَيَاضَ وَجْهِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ كِلا الشِّقَّيْنِ إِذَا سَلَّمَ \"","","","","","Book of Prayer"
"3045","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : يَقُومُونَ عَنْ يَسَارِي قَبْلَ أَنْ أُسَلِّمَ وَمَعِي رَجُلٌ عَنْ يَمِينِي فَكَيْفَ أُسَلِّمُ ؟ , قَالَ : \" وَاحِدَةً مِنْ عَلَى يَمِينِكَ \"","","","","","Book of Prayer"
"3046","عَنِ ابْنِ جُرَيْجٍ , قال : \" رَأَيْتُ عَطَاءً يُسَلِّمُ عَنْ يَمِينِهِ , وَعَنْ يَسَارِهِ \"","","","","","Book of Prayer"
"3047","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوْ لَمْ تُسَلِّمْ إِلا وَاحِدًا أَمَامَكَ , أَلَيْسَ حَسْبَكَ ؟ , قَالَ : \" لَعَمْرِي , وَلَكِنْ أُحِبُّ أَنْ أُسَلِّمَ عَنْ يَمِينِي , وَعَنْ يَسَارِي \"","","","","","Book of Prayer"
"3048","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : لَيْسَ عَنْ يَمِينِي أَحَدٌ , وَعَنْ يَسَارِي أُنَاسٌ , قَالَ : \" فَابْدَأْ فَسَلِّمْ مَنْ عَلَى يَمِينِكَ مِنْ أَجْلِ الْمَلائِكَةِ , ثُمَّ سَلِّمْ عَلَى الَّذِي يَسَارَكَ \"","","","","","Book of Prayer"
"3049","عَنْ مَعْمَرٍ , عَنْ عَاصِمِ بْنِ سُلَيْمَانَ , عَنِ ابْنِ سِيرِينَ , قال : \" إِذَا صَلَّيْتَ وَحْدَكَ فَسَلِّمْ عَنْ يَمِينِكَ السَّلامُ , وَعَنْ يَسَارِكَ : السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ , وَإِذَا كُنْتَ فِي صَفٍّ عَنْ يَمِينِكَ , وَعَنْ يَسَارِكَ أُنَاسٌ , فَقُلِ : السَّلامُ عَلَيْكُمْ , وَعَنْ يَسَارِكَ قُلِ : السَّلامُ عَلَيْنَا , وَإِذَا كُنْتَ فِي طَرَفِ الصَفِّ عَنْ يَمِينِكَ نَاسٌ وَلَيْسَ عَنْ يَسَارِكَ نَاسٌ , فَقُلْ عَنْ يَمِينِكَ : السَّلامُ عَلَيْكُمْ , وَعَنْ يَسَارِكَ : السَّلامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ , وَإِنْ كُنْتَ عَنْ يَسَارِكَ أُنَاسٌ , وَلَيْسَ عَنْ يَمِينِكَ نَاسٌ , فَقُلِ : السَّلامُ عَلَيْكُمْ , وَعَنْ يَسَارِكَ : السَّلامُ عَلَيْكُمْ \" , قَالَ عَاصِمٌ : فَحَدَّثْتُ بِهِ أَبَا قِلابَةَ فَوَافَقَهُ كُلَّهُ , إِلا أَنَّهُ زَادَ فِي التَّسْلِيمِ : \" السَّلامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ , وَكَانَ مَعْمَرٌ لا يُسَلِّمُ إِذَا أَمَّنَا إِلا السَّلامُ عَلَيْكُمْ لا يَزِيدُ عَلَيْهِ \" , قَالَ عَبْدُ الرَّزَّاقِ : \" وَبِهِ نَأْخُذُ \"","","","","","Book of Prayer"
"3050","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , وَسَأَلْتُهُ : كَيْفَ كَانَ ابْنُ عُمَرَ يُسَلِّمُ إِذَا كَانَ إِمَامَكُمْ ؟ , قَالَ : \" عَنْ يَمِينِهِ وَاحِدَةً السَّلامُ عَلَيْكُمْ \" . عَنْ مَعْمَرٍ , عَنْ رَجُلٍ , عَنْ عَبْدِ الْقَيْسِ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ مِثْلَهُ , قَالَ مَعْمَرٌ : وَكَانَ الْحَسَنُ , وَالزُّهْرِيُّ يَفْعَلانِ مِثْلَ مَا فَعَلَ ابْنُ عُمَرَ","","","","","Book of Prayer"
"3051","عَنْ هِشَامِ بْنِ حَسَّانَ : \" أَنَّ الْحَسَنَ , وَابْنَ سِيرِينَ كَانَا يُسَلِّمَانِ فِي الصَّلاةِ وَاحِدَةً \"","","","","","Book of Prayer"
"3052","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , قَالَ : أَخْبَرَنِي الصَّلْتُ بْنُ دِينَارٍ , قَالَ : سَمِعْتُ الْحَسَنَ , يَقُولُ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَبُو بَكْرٍ , وَعُمَرُ , وَعُثْمَانُ يُسَلِّمُونَ تَسْلِيمَةً وَاحِدَةً \" , قَالَ الصَّلْتُ : \" وَصَلَّيْتُ خَلْفَ عُمَرَ بْنِ عَبْدِ الْعَزِيزِ فَسَلَّمَ وَاحِدَةً \"","","","","","Book of Prayer"
"3053","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : كَيْفَ تَصْنَعُ إِذَا صَلَّيْتَ لِنَفْسِكَ ؟ , قَالَ : \" أُسَلِّمُ عَنْ يُمْنَايَ قَطُّ \"","","","","","Book of Prayer"
"3054","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , قَالَ : \" كَانَ ابْنُ عُمَرَ إِذَا كَانَ فِي النَّاسِ رَدَّ عَلَى الإِمَامِ ثُمَّ سَلَّمَ عَنْ يَمِينِهِ , وَلا يُسَلِّمُ عَنْ يَسَارِهِ إِلا أَنْ يُسَلِّمَ عَلَيْهِ إِنْسَانٌ فَيَرُدُّ عَلَيْهِ \"","","","","","Book of Prayer"
"3055","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" حَقٌّ عَلَيْكَ أَنْ تَرُدَّ يَعْنِي عَلَى الإِمَامِ إِذَا سَلَّمَ \"","","","","","Book of Prayer"
"3056","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" ابْدَأْ بِالإِمَامِ , ثُمَّ سَلِّمْ عَلَى مَنْ عَنْ يَمِينِكَ , ثُمَّ عَلَى مَنْ عَنْ يَسَارِكَ \" , عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , مِثْلَ قَوْلِ عَطَاءٍ","","","","","Book of Prayer"
"3057","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِنْ مَكَثَ قَلِيلا لا أَرُدُّ عَلَى الإِمَامِ حَتَّى أَفْرُغَ مِنْ حَاجَتِي أَعَلَيَّ بَأْسٌ ؟ , قَالَ : \" لا \" , قُلْتُ : رَأَيْتُكَ تَفْعَلُهُ , قَالَ : \" أَجَلْ , مَا أَرُدُّ عَلَيْهِ حَتَّى يَكُونَ مَعَ التَّسْلِيمِ الانْصِرَافُ \" , قَالَ : \" لا يَضُرُّكَ أَيُّ ذَلِكَ فَعَلْتَ سَوَاءٌ ذَلِكَ \"","","","","","Book of Prayer"
"3058","قَالَ ابْنُ جُرَيْجٍ : قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ إِذَا سَلَّمَ عَلَيَّ الَّذِي عَلَى شِقِّي أَجْعَلُهُ التَّسْلِيمَ مِنِّي عَلَى الانْصِرَافِ , وَأَرُدُّ عَلَيْهِ سَلامَهُ جَمِيعًا , أَمْ أَرُدُّهُ عَلَيْهِ , ثُمَّ أُسَلِّمُ بَعْدَ تَسْلِيمِ الانْصِرَافِ ؟ , قَالَ : \" لا يَضُرُّكَ أَيُّ ذَاكَ فَعَلْتَ , سَوَاءٌ ذَلِكَ \" , قَالَ ابْنُ جُرَيْجٍ : وَرَأَيْتُهُ يَفْعَلُ كُلَّ ذَلِكَ","","","","","Book of Prayer"
"3059","عَنْ مَعْمَرٍ , عَنْ حَمَّادٍ , قال : \" إِذَا كَانَ الإِمَامُ عَنْ يَمِينِكَ فَسَلَّمْتَ عَنْ يَمِينِكَ وَنَوَيْتَ الإِمَامَ فِي ذَلِكَ , وَإِذَا كَانَ عَنْ يَسَارِكَ سَلَّمْتَ وَنَوَيْتَ الإِمَامَ فِي ذَلِكَ أَيْضًا , وَإِذَا كَانَ بَيْنَ يَدَيْكَ فَسَلَّمْتَ عَلَيْهِ فِي نَفْسِكَ ثُمَّ سَلَّمْتَ عَنْ يَمِينِكَ , وَعَنْ شِمَالِكَ \"","","","","","Book of Prayer"
"3060","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : قُلْتُ : كَيْفَ يَرُدُّهُ عَلَى الإِمَامِ ؟ , قَالَ : \" يَقُولُ : السَّلامُ عَلَيْكُمْ \"","","","","","Book of Prayer"
"3061","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِذَا سَلَّمَ الإِمَامُ أَيُسْمِعُهُ الرَّدَّ عَلَيْهِ مَنْ يَسْمَعُ تَسْلِيمَهُ ؟ , قَالَ : \" لا , حَسْبُهُمْ إِذَا رَدُّوا عَلَيْهِ \"","","","","","Book of Prayer"
"3062","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : تَفُوتُنِي رَكْعَةٌ مَعَ الإِمَامِ فَيُسَلِّمُ الإِمَامُ , فَأَقُومُ , فَأَقْضِي أَمْ أَنْتَظِرُ قِيَامَهُ ؟ , قَالَ : \" تَنْتَظِرُ قَلِيلا , فَإِنِ احْتَبَسَ فَقُمْ وَدَعْهُ \"","","","","","Book of Prayer"
"3063","عَنِ ابْنِ أَبِي رَوَّادٍ , عَنْ نَافِعٍ , قَالَ : \" كَانَ ابْنُ عُمَرَ إِذَا سُبِقَ بِشَيْءٍ مِنَ الصَّلاةِ فَإِذَا سَلَّمَ الإِمَامُ قَامَ يَقْضِي مَا فَاتَهُ , وَإِذَا لَمْ يُسْبَقْ بِشَيْءٍ لَمْ يَقُمْ حَتَّى يَقُومَ الإِمَامُ \" , عَنْ مَعْمَرٍ , عَنْ رَجُلٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ مِثْلَهُ","","","","","Book of Prayer"
"3064","عَنْ مَعْمَرٍ , عَنْ أَبِي هَارُونَ الْعَبْدِيِّ , قَالَ : \" صَلَّيْتُ مَعَ أَهْلِ الْمَدِينَةِ رَكْعَةً مِنَ الصُّبْحِ , فَلَمَّا سَلَّمَ الإِمَامُ قُمْتُ لأَقْضِيَ رَكْعَتِي فَجَذَبُونِي , فَذَكَرْتُ ذَلِكَ لأَبِي سَعِيدٍ الْخُدْرِيِّ , فَقَالَ : \" كَذَلِكَ كَانُوا يَفْعَلُونَ , وَلَكِنَّهُمْ خَافُوا السَّيْفَ \"","","","","","Book of Prayer"
"3065","عَنِ الثَّوْرِيِّ , عَنْ مُحَمَّدِ بْنِ قَيْسٍ , عَنِ الشَّعْبِيِّ , قال : \" لا يَقْضِي الَّذِي سَبَقَهُ الإِمَامُ حَتَّى يَنْحَرِفَ مِنْ بِدْعَتِهِ , وَإِنَّمَا يُؤْمَرُ الرَّجُلُ بِالْجُلُوسِ مَخَافَةَ أَنْ يَكُونَ الإِمَامُ سَهَا \" , قَالَ : \" وَبِدْعَتُهُ اسْتِقْبَالُ الْقِبْلَةِ بَعْدَ التَّسْلِيمِ \"","","","","","Book of Prayer"
"3066","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنَّ عَلِيًّا , قَالَ : \" مَا أَدْرَكْتَ مَعَ الإِمَامِ فَهُوَ أَوَّلُ صَلاتِكَ , وَاقْضِ مَا سَبَقَكَ بِهِ مِنَ الْقِرَاءَةِ \" , عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيِّبِ , مِثْلَ قَوْلِ عَلِيٍّ , عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , مِثْلَهُ أَيْضًا","","","","","Book of Prayer"
"3067","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" إِنْ أَمْكَنَكَ الإِمَامُ , فَاقْرَأْ فِي الرَّكْعَتَيْنِ اللَّتَيْنِ بَقِيَتَا سُورَةً , فَتَجْعَلُهَا أَوَّلَ صَلاتِكَ \"","","","","","Book of Prayer"
"3068","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنَّ ابْنَ مَسْعُودٍ , قَالَ : \" اقْرَأْ فِيمَا فَاتَكَ \"","","","","","Book of Prayer"
"3069","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنِ الشَّعْبِيِّ , أَنَّ جُنْدَبًا , وَمَسْرُوقًا , أَدْرَكَا رَكْعَةً مِنَ الْمَغْرِبِ فَقَرَأَ جُنْدُبٌ , وَلَمْ يَقْرَأْ مَسْرُوقٌ خَلْفَ الإِمَامِ , فَلَمَّا سَلَّمَ الإِمَامُ قَامَا يَقْضِيَانِ , فَجَلَسَ مَسْرُوقٌ فِي الثَّانِيَةِ وَالثَّالِثَةِ , وَقَامَ جُنْدُبٌ فِي الثَّانِيَةِ وَلَمْ يَجْلِسْ , فَلَمَّا انْصَرَفَا تَذَاكَرَا ذَلِكَ , فَأَتَيَا ابْنَ مَسْعُودٍ , فَقَالَ : \" كُلٌّ قَدْ أَصَابَ , أَوْ كُلٌّ قَدْ أَحْسَنَ , وَنَفْعَلُ كَمَا فَعَلَ مَسْرُوقٌ \"","","","","","Book of Prayer"
"3070","عَنْ مَعْمَرٍ , عَنْ جَعْفَرٍ الْجَزَرِيِّ , عَنِ الْحَكَمِ , أَنَّ جُنْدَبًا , وَمَسْرُوقًا , أَدْرَكَا رَكْعَةً مِنَ الْمَغْرِبِ , فَقَرَأَ أَحَدُهُمَا فِي الرَّكْعَتَيْنِ الأُخْرَيَيْنِ مَا فَاتَهُ مِنَ الْقِرَاءَةِ , وَلَمْ يَقَْرْإِ الآخَرُ فِي رَكْعَةٍ , فَسُئِلَ ابْنُ مَسْعُودٍ , فَقَالَ : \" كِلاكَمَا مُحْسِنٌ , وَأَنَا أَصْنَعُ كَمَا صَنَعَ هَذَا الَّذِي قَرَأَ فِي الرَّكْعَتَيْنِ \"","","","","","Book of Prayer"
"3071","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : \" اقْرَأْ فِيمَا تَقْضِي \"","","","","","Book of Prayer"
"3072","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , وَأَبِي قِلابَةَ , قَالا : \" يُصَلِّي مَعَ الإِمَامِ مَا أَدْرَكَ , وَيَقْضِي مَا سُبِقَ بِهِ مَعَ الإِمَامِ مِنَ الْقِرَاءَةِ \" , مِثْلَ قَوْلِ ابْنِ مَسْعُودٍ","","","","","Book of Prayer"
"3073","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ : \" أَنَّ ابْنَ عُمَرَ كَانَ إِذَا فَاتَتْهُ رَكْعَةٌ أَوْ شَيْءٌ مِنَ الصَّلاةِ مَعَ الإِمَامِ فَسَلَّمَ قَامَ سَاعَةً يُسَلِّمُ الإِمَامُ , وَلَمْ يَنْتَظِرْ قِيَامَ الإِمَامِ \"","","","","","Book of Prayer"
"3074","عَنْ مَالِكٍ , عَنْ نَافِعٍ , قَالَ : \" كَانَ ابْنُ عُمَرَ إِذَا فَاتَهُ شَيْءٌ مِنَ الصَّلاةِ مَعَ الإِمَامِ الَّتِي يُعْلِنُ فِيهَا بِالْقِرَاءَةِ , فَإِذَا سَلَّمَ الإِمَامُ قَامَ عَبْدُ اللَّهِ فَقَرَأَ لِنَفْسِهِ \"","","","","","Book of Prayer"
"3075","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ عُبَيْدَةَ , قَالَ : \" اقْرَأْ فِيمَا تَقْضِي \"","","","","","Book of Prayer"
"3076","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ \" , أَنَّ عَبْدَ اللَّهِ بْنَ عَمْرٍو , فَاتَتْهُ رَكْعَةٌ مِنَ الْمَغْرِبِ الأُولَى مِنْهُنَّ , وَأَنَّهُ أَخْبَرَهُ رَفْعَ صَوْتِهِ بِالْقِرَاءَةِ فِي الآخِرَةِ الثَّالِثَةِ \" , قَالَ : \" كَأَنِّي أَسْمَعُ إِلَى قَوْلِهِ : نَارًا تَلَظَّى \"","","","","","Book of Prayer"
"3077","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أَرَأَيْتَ لَوْ فَاتَتْنِي رَكْعَتَانِ مِنَ الْعِشَاءِ الآخِرَةِ فَقُمْتُ أَجْهَرُ الْقِرَاءَةَ حِينَئِذٍ ؟ , قَالَ : بَلْ خَافِتْ بِهَا \" , عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مَنْ أُصَدِّقُ , عَنْ عَلِيٍّ , مِثْلَ قَوْلِ عَطَاءٍ","","","","","Book of Prayer"
"3078","عَنِ الثَّوْرِيِّ , عَنْ حُصَيْنٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , قَالَ : \" كَانَ النَّاسُ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا جَاءَ الرَّجُلُ وَقَدْ فَاتَهُ مِنَ الصَّلاةِ شَيْءٌ , أَشَارَ إِلَيْهِ النَّاسُ فَصَلَّى مَا فَاتَهُ , ثُمَّ دَخَلَ فِي الصَّلاةِ , حَتَّى جَاءَ يَوْمًا مُعَاذُ بْنُ جَبَلٍ , فَأَشَارُوا إِلَيْهِ فَدَخَلَ , وَلَمْ يَنْتَظِرْ مَا قَالُوا , فَلَمَّا صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ذَكَرُوا ذَلِكَ لَهُ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : سَنَّ لَكُمْ مُعَاذٌ \"","","","","","Book of Prayer"
"3079","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : كَانَ النَّاسُ لا يَأْتَمُّونَ بِإِمَامٍ إِذَا كَانَ لَهُ وِتْرٌ وَلَهُمْ شَفْعٌ وَهُوَ جَالِسٌ , وَيَجْلِسُونَ وَهُوَ قَائِمٌ , حَتَّى صَلَّى ابْنُ مَسْعُودٍ وَرَاءَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَائِمًا , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنَّ ابْنَ مَسْعُودٍ سَنَّ لَكُمْ سُنَّةً فَاسْتَنُّوا بِهَا","","","","","Book of Prayer"
"3080","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَوْ فَاتَتْنِي رَكْعَةٌ فَكَانَتْ لِي رَكْعَتَانِ وَهِيَ لِلإِمَامِ ثَلاثٌ , قَالَ : \" قُمْ لِقِيَامِهِ , وَلا تَجْلِسْ شَيْئًا \"","","","","","Book of Prayer"
"3081","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , عَنْ أَبِي الشَّعْثَاءِ , أَنَّهُ قَالَ : \" يَأْتَمُّ بِهِ وَلا يَجْلِسُ \"","","","","","Book of Prayer"
"3082","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ : \" أَنَّ ابْنَ عُمَرَ , كَانَ يَأْتَمُّ بِهِ وَلا يَجْلِسُ \"","","","","","Book of Prayer"
"3083","عَنِ ابْنِ جُرَيْجٍ , عَنْ رَجُلٍ , عَنْ نَافِعٍ : \" أَنَّ ابْنَ عُمَرَ كَانَ يَأْتَمُّ بِهِ وَلا يَجْلِسُ \" , عَنِ ابْنِ جُرَيْجٍ , عَنْ رَجُلٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ مِثْلَهُ","","","","","Book of Prayer"
"3084","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : قَالَ لَنَا ابْنُ الْمُسَيِّبِ : \" أَخْبِرُونِي بِصَلاةٍ , تَجْلِسُونَ فِيهَا كُلِّهَا ؟ \" , قَالَ : قُلْنَا لَهُ , فَقَالَ : \" إِنَّهَا الْمَغْرِبُ , أَدْرَكْتَ فِيهَا رَكْعَةً فَجَلَسْتَ مَعَ الإِمَامِ , ثُمَّ نَقَضْتَ فَصَلَّيْتَ رَكْعَةً , فَجَلَسْتَ , ثُمَّ صَلَّيْتَ رَكْعَةً أُخْرَى فَجَلَسْتَ فِيهَا , وَلَمْ يَذْكُرْ فِيهَا سُجُودًا \"","","","","","Book of Prayer"
"3085","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , قَالَ : سَأَلْتُ عُبَيْدَةَ , قُلْتُ : أَدْرَكْتُ رَكْعَةً مِنَ الْمَغْرِبِ أَشْفَعُ إِلَيْهَا أُخْرَى , ثُمَّ أَسْتَقْبِلُ صَلاتِي ؟ , قَالَ : \" السُّنَّةُ خَيْرٌ , صَلِّ مَا أَدْرَكْتَ , وَأَتْمِمْ مَا فَاتَكَ \" , قَالَ : قُلْتُ : أَقْرَأُ ؟ , قَالَ : \" نَعَمْ \"","","","","","Book of Prayer"
"3086","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي زَكَرِيَّا بْنُ مَالِكٍ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , \" فِي دُبُرِ صَلاتِهِ ثَلاثَةً وَثَلاثِينَ تَكْبِيرَةً , وَثَلاثَةً وَثَلاثِينَ تَسْبِيحَةً , وَثَلاثَةً وَثَلاثِينَ تَحْمِيدَةً , وَلا إِلَهَ إِلا اللَّهُ وَاحِدَةً وَاحِدَةً \"","","","","","Book of Prayer"
"3087","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : أَتَى النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَعْضُ أَصْحَابِهِ , فَقَالَ : يَا نَبِيَّ اللَّهِ , إِنَّ أَصْحَابَكَ لأَصْحَابِهِ الأَوَّلِينَ سَبَقُونَا بِالأَعْمَالِ , فَقَالَ : \" أَلا أُخْبِرُكُمْ بِشَيْءٍ تَصْنَعُونَهُ بَعْدَ الْمَكْتُوبَاتِ , تُدْرِكُونَ بِهِ مَنْ سَبَقَكُمْ , وَتَسْبِقُونَ بِهِ مَنْ بَعْدَكُمْ ؟ \" , قَالُوا : بَلَى , يَا نَبِيَّ اللَّهِ , \" فَأَمَرَهُمْ أَنْ يُكَبِّرُوا أَرْبَعًا وَثَلاثِينَ , وَيُسَبِّحُوا ثَلاثًا وَثَلاثِينَ , وَيَحْمَدُوا ثَلاثًا وَثَلاثِينَ \" , قَالَ : ثُمَّ أَخْبَرَنَا عِنْدَ ذَلِكَ رَجُلٌ , قَالَ : فَجَاءَهُ الْمَسَاكِينُ , فَقَالُوا : يَا نَبِيَّ اللَّهِ , غَلَبَنَا أُولُو الدَّثْرِ عَلَى الأَجْرِ , \" فَأْمُرْنَا بِعَمَلٍ نُدْرِكُ بِهِ أَعْمَالَهُمْ \" , فَأَخْبَرَهُمْ مِثْلَ مَا , قَالَ عَطَاءٌ : فَلَمَّا بَلَغَ أَصْحَابُ الأَمْوَالِ أَخَذُوا بِهِ , فَلَمَّا رَأَى ذَلِكَ الْمَسَاكِينُ جَاءُوا النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَخْبَرُوهُ , فَقَالَ : \" هِيَ الْفَضَائِلُ \"","","","","","Book of Prayer"
"3088","عَنْ مُحَمَّدِ بْنِ رَاشِدٍ , عَنْ مَكْحُولٍ : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَمَرَ رَجُلا , أَنْ يُسَبِّحَ خَلْفَ الصَّلاةِ ثَلاثًا وَثَلاثِينَ , وَيَحْمَدَ ثَلاثًا وَثَلاثِينَ , وَيُكَبِّرَ أَرْبَعًا وَثَلاثِينَ \"","","","","","Book of Prayer"
"3089","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ , عَنْ أَبِي عُمَرَ , عَنْ أَبِي الدَّرْدَاءِ , قَالَ : قُلْتُ : يَا رَسُولَ اللَّهِ , ذَهَبَ أَهْلُ الأَمْوَالِ بِالدُّنْيَا وَالآخِرَةِ , يَصُومُونَ كَمَا نَصُومُ , وَيُصَلُّونَ كَمَا نُصَلِّي , وَيُجَاهِدُونَ كَمَا نُجَاهِدُ , وَيَتَصَدَّقُونَ وَلا نَتَصَدَّقُ , قَالَ : \" أَفَأَدُلُّكَ عَلَى أَمْرٍ إِنْ فَعَلْتَهُ أَدْرَكْتَ مَنْ سَبَقَكَ , وَلَمْ يُدْرِكْكَ مَنْ بَعْدَكَ إِلا مَنْ فَعَلَ كَمَا فَعَلْتَ , تُسَبِّحُ اللَّهَ ثَلاثًا وَثَلاثِينَ دُبُرَ كُلِّ صَلاةٍ مَكْتُوبَةٍ , وَتَحْمَدُ اللَّهَ ثَلاثًا وَثَلاثِينَ , وَتُكَبِّرُ أَرْبَعًا وَثَلاثِينَ \"","","","","","Book of Prayer"
"3090","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : قَالَ نَاسٌ مِنْ فُقَرَاءِ الْمُؤْمِنِينَ : يَا رَسُولَ اللَّهِ , ذَهَبَ أَصْحَابُ الدُّثُورِ بِالأُجُورِ , يَتَصَدَّقُونَ وَلا نَتَصَدَّقُ , وَيُنْفِقُونَ وَلا نُنْفِقُ , قَالَ : \" أَفَرَأَيْتُمْ لَوْ كَانَ مَالُ الدُّنْيَا وُضِعَ بَعْضُهُ عَلَى بَعْضٍ أَكَانَ بَالِغًا السَّمَاءَ ؟ \" , قَالُوا : لا يَا رَسُولَ اللَّهِ , قَالَ : \" أَلا أُخْبِرُكُمْ بِشَيْءٍ أَصْلُهُ فِي الأَرْضِ وَفَرْعُهُ فِي السَّمَاءِ ؟ , أَنْ تَقُولُوا فِي دُبُرِ كُلِّ صَلاةٍ : لا إِلَهَ إِلا اللَّهُ , وَاللَّهُ أَكْبَرُ , وَسُبْحَانَ اللَّهِ , وَالْحَمْدُ لِلَّهِ عَشْرَ مَرَّاتٍ , فَإِنَّ أَصْلَهُنَّ فِي الأَرْضِ وَفَرْعَهُنَّ فِي السَّمَاءِ \"","","","","","Book of Prayer"
"3091","عَنِ الثَّوْرِيِّ , عَنْ عَطَاءِ بْنِ السَّائِبِ , عَنْ أَبِيهِ , عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" خَصْلَتَانِ لا يُحْصِيهِمَا رَجُلٌ مُسْلِمٌ إِلا دَخَلَ الْجَنَّةَ , وَهُمَا يَسِيرٌ , وَمَنْ يَعْمَلُ بِهِمَا قَلِيلٌ \" , قَالُوا : وَمَا هُمَا يَا رَسُولَ اللَّهِ ؟ , قَالَ : \" يُسَبِّحُ أَحَدُكُمْ عَشْرًا , وَيَحْمَدُ عَشْرًا , وَيُكَبِّرُ عَشْرًا فِي دُبُرِ كُلِّ صَلاةٍ , فَتِلْكَ خَمْسُونَ وَمِائَةٌ بِاللِّسَانِ , وَأَلْفٌ وَخَمْسُ مِائَةٍ فِي الْمِيزَانِ , وَإِذَا أَوَى أَحَدُكُمْ إِلَى فِرَاشِهِ كَبَّرَ اللَّهَ وَحَمِدَهُ وَسَبَّحَهُ مِائَةً , فَتِلْكَ مِائَةٌ بِاللِّسَانِ وَأَلْفٌ فِي الْمِيزَانِ , فَأَيُّكُمْ يَعْمَلُ فِي يَوْمِهِ وَلَيْلَتِهِ أَلْفَيْنِ وَخَمْسَمِائَةِ سَيِّئَةٍ ؟ \" , قَالَ : وَلَقَدْ رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَعُدُّ هَكَذَا , وَعَدَّ بِأَصَابِعِهِ , قَالُوا : يَا رَسُولَ اللَّهِ , كَيْفَ لا نُحْصِيهَا ؟ , قَالَ : \" يَأْتِي أَحَدَكُمُ الشَّيْطَانُ فِي صَلاتِهِ , فَيَقُولُ لَهُ : اذْكُرْ حَاجَةَ كَذَا وَحَاجَةَ كَذَا حَتَّى يَنْصَرِفَ وَلَمْ يَذْكُرْ , وَيَأْتِيهِ عِنْدَ مَنَامِهِ فَيُنَوِّمُهُ وَلَمْ يَذْكُرْ \" , عَنْ مَعْمَرٍ , عَنْ عَطَاءِ بْنِ السَّائِبِ , عَنْ أَبِيهِ , عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" خَصْلَتَانِ مَنْ حَافَظَ عَلَيْهِمَا دَخَلَ الْجَنَّةَ , مَنْ سَبَّحَ فِي دُبُرِ كُلِّ صَلاةٍ عَشْرًا , ثُمَّ ذَكَرَ مِثْلَ حَدِيثِ الثَّوْرِيِّ \" , إِلا أَنَّهُ لَمْ يَذْكُرْ , قَوْلَهُ : رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَعُدُّهُنَّ","","","","","Book of Prayer"
"3092","عَنِ الثَّوْرِيِّ , عَنْ مُوسَى بْنِ أَبِي عَائِشَةَ , عَنْ رَجُلٍ , سَمِعَ أُمَّ سَلَمَةَ , تَقُول : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي دُبُرِ صَلاةٍ : اللَّهُمَّ إِنِّي أَسْأَلُكَ رِزْقًا طَيِّبًا , وَعَمَلا مُتَقَبَّلا , وَعِلْمًا نَافِعًا \"","","","","","Book of Prayer"
"3093","عَنْ إِسْمَاعِيلَ بْنِ عَيَّاشٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عَبْدِ الرَّحْمَنِ بْنِ أَبِي حُسَيْنٍ , وَلَيْثٌ , عَنْ شَهْرِ بْنِ حَوْشَبٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ , عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ : \" مَنْ قَالَ دُبُرَ كُلِّ صَلاةٍ ,  قَالَ ابْنُ أَبِي حُسَيْنٍ فِي حَدِيثِهِ : وَهُوَ ثَانِيَ رِجْلِهِ قَبْلَ أَنْ يَتَكَلَّمَ : لا إِلَهَ إِلا اللَّهُ وَحْدَهُ لا شَرِيكَ لَهُ , لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ , يُحْيِي وَيُمِيتُ , بِيَدِهِ الْخَيْرُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ , عَشْرَ مَرَّاتٍ , كَتَبَ اللَّهُ لَهُ بِكُلِّ وَاحِدَةٍ عَشْرَ حَسَنَاتٍ , وَحَطَّ عَنْهُ عَشْرَ سَيِّئَاتٍ , وَرَفَعَ لَهُ عَشْرَ دَرَجَاتٍ , وَكَانَ لَهُ بِكُلِّ وَاحِدَةٍ , قَالَهَا : عِدْلُ رَقَبَةٍ مِنْ وَلَدِ إِسْمَاعِيلَ , وَكُنَّ مَسْلَحَةً وَحَرَسًا مِنَ الشَّيْطَانِ , وَحِرْزًا مِنْ كُلِّ مَكْرُوهٍ , وَلَمْ يَعْمَلْ عَمَلا يَقْهَرُهُنَّ إِلا أَنْ يُشْرِكَ بِاللَّهِ \"","","","","","Book of Prayer"
"3094","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنِ الْحَكَمِ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , عَنْ كَعْبِ بْنِ عُجْرَةَ , عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" مُعَقِّبَاتٌ لا يَخِيبُ قَائِلُهُنَّ , أَوْ قَالَ : فَاعِلُهُنَّ مَنْ سَبَّحَ اللَّهَ دُبُرَ كُلِّ صَلاةٍ ثَلاثًا وَثَلاثِينَ , وَحَمِدَ ثَلاثًا وَثَلاثِينَ , وَكَبَّرَ أَرْبَعًا وَثَلاثِينَ \"","","","","","Book of Prayer"
"3095","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , عَنْ رَجُلٍ , عَنْ أَبِي هُرَيْرَةَ , أَنَّهُ قَالَ : \" مَنْ هَلَّلَ بَعْدَ الْمَكْتُوبَةِ مِائَةً , وَسَبَّحَ مِائَةً , وَحَمِدَ مِائَةً , وَكَبَّرَ مِائَةً , غُفِرَتْ ذُنُوبُهُ , لَوْ كَانَتْ مِثْلَ زَبَدِ الْبَحْرِ \"","","","","","Book of Prayer"
"3096","عَنْ مَعْمَرٍ , عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنْ رَجُلٍ , عَنْ مُعَاذِ بْنِ جَبَلٍ , قَالَ : \" مَنْ قَالَ بَعْدَ كُلِّ صَلاةٍ : أَسْتَغْفِرُ اللَّهَ الَّذِي لا إِلَهَ إِلا هُوَ الْحَيَّ الْقَيُّومَ وَأَتُوبُ إِلَيْهِ , ثَلاثَ مَرَّاتٍ , كَفَّرَ اللَّهُ عَنْهُ ذُنُوبَهُ , وَإِنْ كَانَ فَرَّ مِنَ الزَّحْفِ \"","","","","","Book of Prayer"
"3097","عَنِ ابْنِ عُيَيْنَةَ , عَنْ أَبِي حَمْزَةَ الثُّمَالِيِّ , عَنِ الأَصْبَغِ بْنِ نُبَاتَةَ , قَالَ : قَالَ عَلِيٌّ : \" مَنْ سَرَّهُ أَنْ يَكْتَالَ بِالْمِكْيَالِ الأَوْفَى فَلْيَقُلْ عِنْدَ فُرُوغِهِ مِنْ صَلاتِهِ : سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَا يَصِفُونَ وَسَلامٌ عَلَى الْمُرْسَلِينَ وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ \"","","","","","Book of Prayer"
"3098","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَاصِمٍ الأَحْوَلِ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَوْسَجَةَ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الرَّمَاحِ , عَنْ عَائِشَةَ , قَالَتْ : كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا قَضَى صَلاتَهُ قَالَ : \" اللَّهُمَّ أَنْتَ السَّلامُ , وَمِنْكَ السَّلامُ , تَبَارَكْتَ يَا ذَا الْجَلالِ وَالإِكْرَامِ \"","","","","","Book of Prayer"
"3099","عَنِ ابْنِ التَّيْمِيِّ , عَنْ لَيْثٍ , أَنَّ أَبَا الدَّرْدَاءِ , كَانَ يَقُولُ إِذَا فَرَغَ مِنْ صَلاتِهِ : \" بِحَمْدِ رَبِّيَ انْصَرَفْتُ , وَبِذُنُوبِيَ اعْتَرَفْتُ , أَعُوذُ بِرَبِّي مِنْ شَرِّ مَا اقْتَرَفْتُ , يَا مُقَلِّبَ الْقُلُوبِ قَلِّبْ قَلْبِي عَلَى مَا تُحِبُّ وَتَرْضَى \"","","","","","Book of Prayer"
"3100","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ مَالِكِ بْنِ الْحَارِثِ , قال : \" كَانَ يَقُولُ اللَّهُ عَزَّ وَجَلَّ : إِذَا شَغَلَ الْعَبْدَ ثَنَاؤُهُ عَلَيَّ مِنْ مُسَاءَلَتِهِ إِيَّايَ أَعْطَيْتُهُ أَفْضَلَ مَا أُعْطِي السَّائِلِينَ \"","","","","","Book of Prayer"
"3101","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ هِلالِ بْنِ يِسَافٍ , عَنْ أُمِّ الدَّرْدَاءِ , قَالَتْ : \" مَنْ قَالَ : لا إِلَهَ إِلا اللَّهُ وَحْدَهُ لا شَرِيكَ لَهُ , لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ مِائَةَ مَرَّةٍ جَاءَ فَوْقَ كُلِّ عَمَلٍ إِلا مَنْ زَادَ \"","","","","","Book of Prayer"
"3102","عَنْ مَعْمَرٍ , عَنْ مُغِيرَةَ , قال : \" لا بَأْسَ بِعَدَدِ التَّكْبِيرِ وَالتَّسْبِيحِ فِي الصَّلاةِ بِمَا جَاءَ فِيهِ الأَحَادِيثُ \"","","","","","Book of Prayer"
"3103","عَنْ إِسْرَائِيلَ , عَنْ سِمَاكِ بْنِ حَرْبٍ , قَالَ : سَمِعْتُ جَابِرَ بْنَ سَمُرَةَ , يَقُولُ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا صَلَّى الْغَدَاةَ قَعَدَ فِي مَجْلِسِهِ حَتَّى تَطْلُعَ الشَّمْسُ \"","","","","","Book of Prayer"
"3104","عَنِ الثَّوْرِيِّ , عَنْ عُثْمَانَ الْبَتِّيِّ , قَالَ : قُلْتُ : الرَّجُلُ يَجْلِسُ فِي مُصَلاهُ بَعْدَ الْفَجْرِ أَحَبُّ إِلَيْكَ أَمِ الَّذِي يَأْتِي الْفَرَائِضَ ؟ , قَالَ : \" بَلِ الَّذِي يَجْلِسُ فِي مَجْلِسِهِ أَحَبُّ إِلَيَّ \"","","","","","Book of Prayer"
"3105","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الَّذِي ذَكَرْتَ مِنْ عَدَدِ التَّسْبِيحِ وَالتَّكْبِيرِ وَالتَّحْمِيدِ وَرَاءَ الْمَكْتُوبَةِ أَحَبُّ إِلَيْكَ أَمْ نَزِيدُ عَلَى ذَلِكَ ؟ , قَالَ \" نَعَمْ \" , قَالَ : قُلْتُ : أَحَبُّ إِلَيْكَ أَنْ لا تَقُومَ حَتَّى تَفْرُغَ مِنْ تَسْبِيحِكَ ؟ , قَالَ : \" نَعَمْ \" , قُلْتُ : لِمَ ؟ , قَالَ : \" لأَنَّهُمْ يَقُولُونَ : لا تَزَالُ الْمَلائِكَةُ تُصَلِّي عَلَى الْمَرْءِ مَا لَمْ يَقُمْ مَنْ مُصَلاهُ الَّذِي صَلَّى فِيهِ مَا لَمْ يُحْدِثْ \" , قَالَ : \" وَإِنِّي لأُحِبُّ أَنْ يَكُونَ ذَلِكَ فِي دُبُرِ الْمَكْتُوبَةِ \" , قُلْتُ : أَتَسْتَحِبُّ أَنْ لا تَتَكَلَّمَ حَتَّى تَفْرُغَ مِنْهُ ؟ , قَالَ : \" نَعَمْ , وَاللَّهِ , وَلَكِنْ مَا يَدَعُونَنَا \"","","","","","Book of Prayer"
"3106","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ : أَبَلَغَكَ عَمَّنْ مَضَى فِي الْجُلُوسِ بَعْدَ التَّسْلِيمِ شَيْءٌ ؟ , قَالَ : \" لا \" , قُلْتُ : فَرَأَيْتُكَ تَجْلِسُ , قَالَ : \" سُبْحَانَ اللَّهِ ! أَذْكُرُ اللَّهَ \" , قُلْتُ : أَفَلا تَفْرُغُ مِنْ حَاجَتِكَ قَبْلَ أَنْ تُسَلِّمَ , فَإِذَا سَلَّمْتَ لَمْ يَكُنْ إِلا الْقِيَامِ ؟ , قَالَ : \" بَلْ أُسَلِّمُ فَأَسْتَرِيحُ , ثُمَّ أَفْرُغُ لِتَهْلِيلِ اللَّهِ , وَتَسْبِيحِهِ , وَحَمْدِهِ , وَذِكْرِهِ \"","","","","","Book of Prayer"
"3107","عَنْ مَعْمَرٍ , عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" لا يَضُرُّكَ عَلَى أَيِّ جَانِبَيْكَ انْصَرَفْتَ \"","","","","","Book of Prayer"
"3108","عَنِ الثَّوْرِيِّ , عَنْ سِمَاكِ بْنِ حَرْبٍ , عَنْ قَبِيصَةَ بْنِ هُلْبٍ , عَنْ أَبِيهِ , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَنْصَرِفُ مَرَّةً عَنْ يَمِينِهِ , وَمَرَّةً عَنْ شِمَالِهِ , وَكَانَ يُمْسِكُ بِيَمِينِهِ عَلَى شِمَالِهِ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3109","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنِ الأَسْوَدِ , عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ , قَالَ : \" لا يَجْعَلَنَّ أَحَدُكُمْ لِلشَّيْطَانِ مِنْ نَفْسِهِ جُزْءًا , لا يَرَى إِلا أَنَّ عَلَيْهِ حَقًّا أَنْ يَنْصَرِفَ عَنْ يَمِينِهِ , قَالَ : قَدْ رَأَيْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَكْثَرَ مَا يَنْصَرِفُ عَنْ شِمَالِهِ \"","","","","","Book of Prayer"
"3110","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي الأَحْوَصِ , عَنِ ابْنِ مَسْعُودٍ , أَنَّهُ كَانَ يَقُولُ : \" إِذَا سَلَّمَ الإِمَامُ فَانْصَرِفْ حَيْثُ كَانَتْ حَاجَتُكَ يَمِينًا , أَوْ شِمَالا , وَلا تَسْتَدِرِ اسْتِدَارَةِ الْحِمَارِ \"","","","","","Book of Prayer"
"3111","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : \" كَانَ ابْنُ مَسْعُودٍ إِذَا كَانَتْ حَاجَتُهُ عَنْ يَسَارِهِ انْصَرَفَ عَنْ يَسَارِهِ , وَإِذَا كَانَتْ حَاجَتُهُ عَنْ يَمِينِهِ انْصَرَفَ عَنْ يَمِينِهِ \"","","","","","Book of Prayer"
"3112","عَنِ ابْنِ جُرَيْجٍ , عَنْ نَافِعٍ , قَالَ : \" مَا كَانَ ابْنُ عُمَرَ يُبَالِي عَلَى أَيِّ ذَلِكَ انْصَرَفَ عَنْ يَمِينِهِ , أَوْ عَنْ شِمَالِهِ \" , قَالَ : وَذَلِكَ أَنِّي سَأَلْتُهُ عَنْ ذَلِكَ","","","","","Book of Prayer"
"3113","عَنِ ابْنِ عُيَيْنَةَ , عَنْ رَجُلٍ سَمَّاهُ , عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ , عَنْ عَمِّهِ وَاسِعِ بْنِ حَبَّانَ , قَالَ : صَلَّيْتُ فَرَأَيْتُ ابْنَ عُمَرَ جَالِسًا , فَانْقَلَبْتُ عَنْ شِمَالِي فَجَلَسْتُ إِلَيْهِ , قَالَ : \" مَا مَنَعَكَ أَنْ تَنْفَتِلَ عَنْ يَمِينِكَ ؟ \" , قَالَ : قُلْتُ : رَأَيْتُكَ فَانْثَنَيْتُ إِلَيْكَ , قَالَ : \" قَدْ أَصَبْتَ , أَنَّ نَاسًا يَقُولُونَ : لا تَنْفَتِلْ إِلا عَنْ يَمِينِكَ \"","","","","","Book of Prayer"
"3114","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لا يَضُرُّهُ أَعَلَى يَمِينِهِ انْصَرَفَ أَوْ عَلَى شِمَالِهِ \" , قُلْتُ : أَيُّهُمَا يُسْتَحَبُّ ؟ , قَالَ : \" سَوَاءٌ \"","","","","","Book of Prayer"
"3115","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنْ حَمَّادٍ , وَجَابِرٍ , وَأَبِي الضُّحَى , عَنْ مَسْرُوقٍ , أَنَّ أَبَا بَكْرٍ , كَانَ إِذَا سَلَّمَ عَنْ يَمِينِهِ , وَعَنْ شِمَالِهِ , قَالَ : \" السَّلامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ , ثُمَّ انْفَتَلَ سَاعَتَئِذٍ , كَأَنَّمَا كَانَ جَالِسًا عَلَى الرَّضَفِ \"","","","","","Book of Prayer"
"3116","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : \" كَانَ أَبُو بَكْرٍ إِذَا سَلَّمَ , كَأَنَّهُ عَلَى الرَّضَفِ حَتَّى يَنْهَضَ \"","","","","","Book of Prayer"
"3117","عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , قَالَ : قُلْتُ لابْنِ عُمَرَ : إِذَا سَلَّمَ الإِمَامُ انْصَرَفَ ؟ , قَالَ : \" كَانَ الإِمَامُ إِذَا سَلَّمَ انْكَفَتَ وَانْكَفَتْنَا مَعَهُ \" , عَنِ الثَّوْرِيِّ , عَنْ حُمَيْدِ بْنِ أَبِي حُمَيْدٍ , عَنْ إِبْرَاهِيمَ مِثْلَهُ","","","","","Book of Prayer"
"3118","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي الأَحْوَصِ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" إِذَا سَلَّمَ الإِمَامُ فَلْيَقُمْ , وَإِلا فَلْيَنْحَرِفْ عَنْ مَجْلِسِهِ \" قُلْتُ : فَيُجْزِيهِ أَنْ يَنْحَرِفَ عَنْ مَجْلِسِهِ وَيَسْتَقْبِلَ الْقِبْلَةَ ؟ , قَالَ : \" الانْحِرَافُ أَنْ يُغَرِّبَ , أَوْ يُشَرِّقَ عَنْ غَيْرِ وَاحِدٍ \"","","","","","Book of Prayer"
"3119","عَنِ الثَّوْرِيِّ , عَنْ لَيْثٍ , قَالَ : صَلَّى مُجَاهِدٌ خَلْفَ إِبْرَاهِيمَ النَّخَعِيِّ فَلَمَّا أَنْ سَلَّمَ انْحَرَفَ , فَقال : \" لَيْسَتْ مِنَ السُّنَّةِ أَنْ تَقْعُدَ حَتَّى تَقُومَ , ثُمَّ تَقْعُدُ بَعْدُ إِنْ شَاءَ اللَّهُ \"","","","","","Book of Prayer"
"3120","عَنِ الثَّوْرِيِّ , عَنْ خُصَيْفٍ , أَنَّ سَعِيدَ بْنَ جُبَيْرٍ , قال : \" لَيْسَتْ مِنَ السُّنَّةِ أَنْ يَقْعُدَ حَتَّى يَقُومَ , فَلَمَّا تَتَامَّ قَامَ ثُمَّ جَلَسَ يَعْنِي يُشَرِّقُ أَوْ يُغَرِّبُ , فَأَمَّا أَنْ يَسْتَقْبِلَ الْقِبْلَةَ فَلا \"","","","","","Book of Prayer"
"3121","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي الأَحْوَصِ , عَنِ ابْنِ مَسْعُودٍ : \" أَنَّهُ كَانَ إِذَا سَلَّمَ قَامَ عَنْ مَجْلِسِهِ , أَوِ انْحَرَفَ مُشَرِّقًا , أَوْ مُغَرِّبًا \"","","","","","Book of Prayer"
"3122","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ أَبِي الأَحْوَصِ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" إِذَا كُنْتَ خَلْفَ الإِمَامِ فَلا تَرْكَعْ حَتَّى يَرْكَعَ , وَلا تَسْجُدْ حَتَّى يَسْجُدَ , وَلا تَرْفَعْ رَأْسَكَ قَبْلَهُ , فَإِذَا فَرَغَ الإِمَامُ وَلَمْ يَقُمْ وَلَمْ يَنْحَرِفْ , وَكَانَتْ لَكَ حَاجَةٌ فَاذْهَبْ , وَدَعْهُ , فَقَدْ تَمَّتْ صَلاتُكَ \"","","","","","Book of Prayer"
"3123","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , وَقَتَادَةَ , قَالَ : وَأَخْبَرَنِيهِ رَجُلٌ , عَنِ الْحَسَنِ , قَالُوا : \" وَلا يَنْصَرِفْ حَتَّى يَقُومَ الإِمَامُ \" , قَالَ الزُّهْرِيُّ : \" إِنَّمَا جُعِلَ الإِمَامُ لِيُؤْتَمَّ بِهِ وَلا يَنْصَرِفْ \"","","","","","Book of Prayer"
"3124","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَبْدَةَ بْنِ أَبِي لُبَابَةَ , عَنْ وَرَّادٍ , مَوْلَى الْمُغِيرَةِ , أَنَّ الْمُغِيرَةَ كَتَبَ إِلَيَّ مُعَاوِيَةَ كَتَبَ ذَلِكَ الْكِتَابَ إِلَيْهِ وَرَّادٌ , أَنِّي سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ حِينَ يُسَلِّمُ : \" لا إِلَهَ إِلا اللَّهُ وَحْدَهُ لا شَرِيكَ لَهُ , لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ , اللَّهُمَّ لا مَانِعَ لِمَا أَعْطَيْتَ , وَلا مُعْطِيَ لِمَا مَنَعْتَ , وَلا يَنْفَعُ ذَا الْجَدِّ مِنْكَ الْجَدُّ \" , قَالَ وَرَّادٌ : ثُمَّ وَفَدْتُ بَعْدَ ذَلِكَ إِلَى مُعَاوِيَةَ , فَسَمِعْتُهُ عَلَى الْمِنْبَرِ يَأْمُرُ النَّاسَ بِذَلِكَ الْقَوْلِ وَيُعَلِّمُهُمْ , قُلْتُ : فَمَا الْجَدُّ ؟ , قَالَ : \" كَثْرَةُ الْمَالِ \"","","","","","Book of Prayer"
"3125","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , أَنَّ أَبَا مَعْبَدٍ , مَوْلَى ابْنِ عَبَّاسٍ أَخْبَرَهُ : \" أَنَّ رَفْعَ الصَّوْتِ بِالذِّكْرِ حِينَ يَنْصَرِفَ النَّاسُ مِنَ الْمَكْتُوبَةِ كَانَ عَلَى عَهْدِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" , وَأَنَّهُ قَالَ ابْنُ عَبَّاسٍ : كُنْتُ أَعْلَمُ إِذَا انْصَرَفُوا بِذَلِكَ إِذَا سَمِعْتُهُ","","","","","Book of Prayer"
"3126","عَنِ الثَّوْرِيِّ , عَنْ عَطَاءِ بْنِ السَّائِبِ , عَنْ أَبِي الْبَخْتَرِيِّ , قال : \" إِنَّ عُبَيْدَةَ لآخِذٌ بِيَدِي إِذْ سَمِعَ صَوْتَ الْمُصْعَبِ بْنِ الزُّبَيْرِ وَهُوَ , يَقُولُ : لا إِلَهَ إِلا اللَّهُ وَاللَّهُ أَكْبَرُ , مُسْتَقْبِلَ الْقِبْلَةِ بَعْدَمَا سَلَّمَ مِنَ الصَّلاةِ , فَقَالَ عُبَيْدَةُ : مَا لَهُ قَاتَلَهُ اللَّهُ نَعَّارٌ بِالْبِدَعِ \"","","","","","Book of Prayer"
"3127","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ هِنْدَ بِنْتِ الْحَارِثِ , عَنْ أُمِّ سَلَمَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا فَرَغَ مِنْ صَلاتِهِ مَكَثَ قَلِيلا , وَكَانَ يَرَوْنَ أَنَّ ذَلِكَ كَيْمَا يَنْفُذُ النِّسَاءُ قَبْلَ الرِّجَالِ \" , عَنِ ابْنِ جُرَيْجٍ , بَلَغَهُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلُهُ , عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ مِثْلَهُ , كَانَ يَجْلِسُ الإِمَامُ بَعْدَمَا يُسَلِّمُ , وَأَقُولُ أَنَا : التَّسْلِيمُ الانْصِرَافُ قَدْرَ مَا يَنْتَعِلُ بِنَعْلَيْهِ","","","","","Book of Prayer"
"3128","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" يَتَكَلَّمُ الإِمَامُ إِذَا جَلَسَ , فَإِذَا تَكَلَّمَ وَلَمْ يَقُمْ مَعَهُ إِنْ شَاءَ \" , قُلْتُ : يَتْرُكُ كَلامَهُ بِمَنْزِلَةِ كَلامِهِ ؟ , قَالَ : \" نَعَمْ \"","","","","","Book of Prayer"
"3129","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ , عَنْ أَنَسِ بْنِ مَالِكٍ , قَالَ : \" صَلَّيْتُ وَرَاءَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَكَانَ سَاعَةَ يُسَلِّمُ يَقُومُ , ثُمَّ صَلَّيْتُ وَرَاءَ أَبِي بَكْرٍ , فَكَانَ إِذَا سَلَّمَ وَثَبَ , فَكَأَنَّمَا يَقُومُ عَنْ رَضْفَةٍ \"","","","","","Book of Prayer"
"3130","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَاصِمِ بْنِ ضَمْرَةَ , عَنْ عَلِيٍّ , قَالَ : \" إِذَا تَشَهَّدَ الرَّجُلُ , وَخَافَ أَنْ يُحْدِثَ قَبْلَ أَنْ يُسَلِّمَ الإِمَامُ , فَلْيُسَلِّمْ فَقَدْ تَمَّتْ صَلاتُهُ \"","","","","","Book of Prayer"
"3131","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , أَنَّهُ سَمِعَ طَاوُسًا , يَقُولُ : دَعَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى قَوْمٍ فَرَفَعَ يَدَيْهِ , فَأَشَارَ لِي عَمْرٌو فَنَصَبَ يَدَيْهِ جِدًّا فِي السَّمَاءِ , فَجَالَتِ النَّاقَةُ , فَأَمْسَكَهَا بِإِحْدَى يَدَيْهِ , وَالأُخْرَى قَائِمَةٌ فِي السَّمَاءِ","","","","","Book of Prayer"
"3132","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : \" كَانَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَرْفَعُ يَدَيْهِ عِنْدَ صَدْرِهِ فِي الدُّعَاءِ , ثُمَّ يَمْسَحُ بِهِمَا وَجْهَهُ \" وَرُبَّمَا رَأَيْتُ مَعْمَرًا يَفْعَلُهُ , وَأَنَا أَفْعَلُهُ \"","","","","","Book of Prayer"
"3133","عَنْ مَعْمَرٍ , عَنْ أَبَانَ , عَنْ أَنَسٍ , قَالَ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَدْعُو وَالزِّمَامُ بَيْنَ إِصْبَعَيْهِ , فَسَقَطَ الزِّمَامُ , فَأَهْوَى لِيَأْخُذَهُ , وَقَالَ بِإِصْبَعِهِ الَّتِي تَلِي الإِبْهَامَ فَرَفَعَهَا . وَذَكَرَ ابْنُ جُرَيْجٍ , عَنْ أَنَسٍ نَحْوَهُ","","","","","Book of Prayer"
"3134","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ أَبِي سَعِيدٍ الْخُزَاعِيِّ , عَن ِ ابْنِ أَبْزَى , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ فِي صَلاتِهِ : هَكَذَا , وَأَشَارَ بِإِصْبَعِهِ السَّبَّابَةِ \"","","","","","Book of Prayer"
"3135","أَخْبَرَنَا مَعْمَرٌ , عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , \" كَانَ إِذَا جَلَسَ فِي الصَّلاةِ وَضَعَ يَدَيْهِ عَلَى رُكْبَتَيْهِ , وَرَفَعَ إِصْبَعَهُ الْيُمْنَى الَّتِي تَلِي الإِبْهَامَ , فَدَعَا بِهِمَا , وَيَدُهُ الْيُسْرَى عَلَى رُكْبَتِهِ , بَاسِطُهَا عَلَيْهَا \"","","","","","Book of Prayer"
"3136","أَخْبَرَنَا مَالِكٍ , عَنْ مُسْلِمِ بْنِ أَبِي مَرْيَمَ , عَنْ رَجُلٍ , قَالَ : رَآنِي عُمَرُ وَأَنَا أَعْبَثُ بِالْحَصَى فِي الصَّلاةِ , فَلَمَّا انْصَرَفَ نَهَانِي , وَقَالَ : \" اصْنَعْ كَمَا كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصْنَعُ , كَانَ إِذَا جَلَسَ فِي الصَّلاةِ وَضَعَ كَفَّهُ الْيُمْنَى عَلَى فَخِذِهِ الْيُمْنَى , وَقَبَضَ أَصَابِعَهُ , وَأَشَارَ بِإِصْبَعِهِ الَّتِي تَلِي الإِبْهَامَ , وَوَضَعَ كَفَّهُ الْيُسْرَى عَلَى فَخِذِهِ الْيُسْرَى \"","","","","","Book of Prayer"
"3137","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , عَنِ ابْنِ عُمَرَ : \" أَنَّ إِنْسَانًا إِلَى جَنْبِهِ وَهُمَا مَعَ الْقَاضِي إِذَا دَعَا الْقَاضِي رَفَعَ الرَّجُلُ يَدَيْهِ , فَغَمَزَهُ ابْنُ عُمَرَ , فَأَشَارَ إِلَيْهِ بِإِصْبَعٍ فِي الأَرْضِ , ثُمَّ دَعَا الْقَاضِي أُخْرَى , فَنَسِيَ الرَّجُلُ وَرَفَعَ أَيْضًا يَدَهُ , فَغَمَزَهُ ابْنُ عُمَرَ فَأَشَارَ لَهُ كَذَلِكَ \"","","","","","Book of Prayer"
"3138","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ ، عَنْ نَافِعٍ , أَنَّ ابْنَ عُمَرَ رَأَى رَجُلا يُشِيرُ بِإِصْبَعَيْهِ , فَقَالَ لَهُ ابْنُ عُمَرَ : \" إِنَّمَا اللَّهُ إِلَهٌ وَاحِدٌ , فَأَشِرْ بِإِصْبَعٍ وَاحِدَةٍ إِذَا أَشَرْتَ \"","","","","","Book of Prayer"
"3139","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ , عَنْ عَامِرِ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُشِيرُ بِإِصْبَعِهِ إِذَا دَعَا لا يُحَرِّكُهَا , وَتَحَامَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِيَدِهِ الْيُسْرَى عَلَى رِجْلِهِ الْيُسْرَى , وَذَلِكَ مَثْنَى \"","","","","","Book of Prayer"
"3140","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ رَجُلٍ , عَنْ عَائِشَةَ , أَنَّهَا رَأَتِ امْرَأَةً تَدْعُو وَهِيَ رَافِعَةٌ إِصْبَعَهَا الَّتِي تَلِي الإِبْهَامَيْنِ , فَقَالَتْ لَهَا عَائِشَةُ : \" إِنَّمَا هُوَ اللَّهُ إِلَهٌ وَاحِدٌ , تَنْهَاهَا عَنْ ذَلِكَ \"","","","","","Book of Prayer"
"3141","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ التَّمِيمِيِّ , قَالَ : \" سُئِلَ ابْنُ عَبَّاسٍ , عَنْ تَحْرِيكِ الرَّجُلِ إِصْبَعَهُ فِي الصَّلاةِ , فَقَالَ : ذَلِكَ الإِخْلاصُ \"","","","","","Book of Prayer"
"3142","عَنِ الثَّوْرِيِّ , عَنْ عُثْمَانَ بْنِ الأَسْوَدِ , عَنْ مُجَاهِدٍ , قال : \" تَحْرِيكُ الرَّجُلِ إِصْبَعَهُ فِي الصَّلاةِ مِقْعَمَةٌ لِلشَّيْطَانِ \"","","","","","Book of Prayer"
"3143","عَنْ مَعْمَرِ بْنِ رَاشِدٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي حَازِمٍ مَوْلَى الأَنْصَارِ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ جُزْءًا مِنْ سَبْعِينَ جُزْءًا مِنَ النُّبُوَّةِ تَأْخِيرُ السُّحُورِ , وَتَبْكِيرُ الإِفْطَارِ , وَإِشَارَةُ الرَّجُلِ بِإِصْبَعِهِ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3144","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَبَّاسِ بْنِ عَبْدِ اللَّهِ بْنِ مَعْبَدٍ , عَنْ عِكْرِمَةَ , قَالَ : قَالَ ابْنُ عَبَّاسٍ : \" الابْتِهَالُ هَكَذَا وَبَسَطَ يَدَيْهِ وَظُهُورُهُمَا إِلَى وَجْهِهِ وَالدُّعَاءُ هَكَذَا وَرَفَعَ يَدَيْهِ حَتَّى لِحْيَتِهِ وَالإِخْلاصُ هَكَذَا , يُشِيرُ بِإِصْبَعِهِ \" , وَذَكَرَهُ ابْنُ جُرَيْجٍ , عَنِ ابْنِ عَبَّاسٍ","","","","","Book of Prayer"
"3145","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ , عَنْ سِمَاكِ بْنِ حَرْبٍ , عَنْ عِكْرِمَةَ , عَنْ عَائِشَةَ , قَالَتْ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَرْفَعُ يَدَيْهِ يَدْعُو حَتَّى إِنِّي لأَسْأَمُ لَهُ مِمَّا يَرْفَعُهُمَا , اللَّهُمَّ إِنَّمَا أَنَا بَشَرٌ فَلا تُعَذِّبْنِي بِشَتْمِ رَجُلٍ شَتَمْتُهُ , أَوْ آذَيْتُهُ \"","","","","","Book of Prayer"
"3146","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ : أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَرَّ بِقَوْمٍ مِنَ الأَعْرَابِ كَانُوا أَسْلَمُوا , وَكَانْتِ الأَحْزَابُ خَرَّبَتْ بِلادَهُمْ , فَرَفَعَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَدْعُو لَهُمْ بَاسِطًا يَدَيْهِ قِبَلَ وَجْهِهِ , فَقَالَ لَهُ أَعْرَابِيٌّ : امْدُدْ يَا رَسُولَ اللَّهِ , فِدَاكَ أَبِي وَأُمِّي , قَالَ : فَمَدَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَدَيْهِ تِلْقَاءَ وَجْهِهِ , وَلَمْ يَرْفَعْهُمَا فِي السَّمَاءِ","","","","","Book of Prayer"
"3147","عَنْ مَعْمَرٍ , عَنْ أَبَانَ , عَنْ أَنَسٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ رَبَّكُمْ حَيِيٌّ كَرِيمٌ , ثُمَّ يَسْتَحْيِي إِذَا رَفَعَ الْعَبْدُ يَدَيْهِ أَنْ يَرُدَّهُمَا صِفْرًا حَتَّى يَجْعَلَ فِيهِمَا خَيْرًا \"","","","","","Book of Prayer"
"3148","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيَّبِ , قال : \" ثَلاثٌ مِمَّا أَحْدَثَ النَّاسُ اخْتِصَارُ السُّجُودِ , وَرَفْعُ الأَيْدِي , وَرَفْعُ الصَّوْتِ عِنْدَ الدُّعَاءِ \"","","","","","Book of Prayer"
"3149","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ جَابِرِ بْنِ سَمُرَةَ , قَالَ : دَخَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْمَسْجِدَ , فَرَآهُمْ رَافِعِينَ أَيْدِيَهُمْ فِي الصَّلاةِ , فَقَالَ : \" مَا لَهُمْ رَافِعِينَ أَيْدِيَهُمْ كَأَنَّهُمْ أَذْنَابُ الْخَيْلِ الشُّمُسِ , اسْكُنُوا فِي الصَّلاةِ \" , عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَأَى قَوْمًا رَافِعِينَ أَيْدِيَهُمْ فَوْقَ رُءُوسِهِمْ فِي الصَّلاةِ , ثُمَّ ذَكَرَ مِثْلَ حَدِيثِ الثَّوْرِيِّ L3436 . عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنْ عَائِشَةَ , مِثْلَهُ","","","","","Book of Prayer"
"3150","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ عَجْلانَ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَرَّ بِرَجُلٍ يَدْعُو بِإِصْبَعَيْهِ , فَقَبَضَ أَحَدَهُمَا , وَقَالَ : أَحِّدْ يَعْنِي اللَّهُ وَاحِدٌ","","","","","Book of Prayer"
"3151","عَنِ ابْنِ جُرَيْجٍ , عَنْ يَحْيَى بْنِ سَعِيدٍ : \" أَنَّ ابْنَ عُمَرَ , كَانَ يَبْسُطُ يَدَيْهِ مَعَ الْعَاصِ , وَذَكَرُوا أَنَّ مَنْ مَضَى كَانُوا يَدْعُونَ , ثُمَّ يَرُدُّونَ أَيْدِيَهُمْ عَلَى وُجُوهِمْ لَيَرُدُّوا الدُّعَاءَ وَالْبَرَكَةَ \" , قَالَ عَبْدُ الرَّزَّاقِ : \" رَأَيْتُ أَنَا مَعْمَرًا يَدْعُو بِيَدَيْهِ عِنْدَ صَدْرِهِ , ثُمَّ يَرُدُّ يَدَيْهِ فَيَمْسَحُ وَجْهَهُ \"","","","","","Book of Prayer"
"3152","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا كَانَ أَحَدُكُمْ فِي الصَّلاةِ فَلا يَرْفَعْ بَصَرَهُ إِلَى السَّمَاءِ أَنْ يُلْتَمَعَ بَصَرُهُ \" , عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُبَيْدُ اللَّهِ بْنُ عَبْدِ اللَّهِ , أَنَّ رَجُلا حَدَّثَهُ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ","","","","","Book of Prayer"
"3153","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَا بَالُ أَقْوَامٍ يَرْفَعُونَ أَبْصَارَهُمْ إِلَى السَّمَاءِ فِي الصَّلاةِ , حَتَّى اشْتَدَّ قَوْلُهُ فِي ذَلِكَ , ثُمَّ قَالَ : لَيَنْتَهُنَّ عَنْ ذَلِكَ , أَوْ لَيَخْطِفَنَّ اللَّهُ أَبْصَارَهُمْ \"","","","","","Book of Prayer"
"3154","عَنِ الثَّوْرِيِّ , عَنْ عَاصِمٍ , عَنْ أَبِي قِلابَةَ , عَنْ مُسْلِمِ بْنِ يَسَارٍ , قَالَ : قُلْنَا لَهُ : أَيْنَ مُنْتَهَى الْبَصَرُ فِي الصَّلاةِ ؟ , قَالَ \" إِنْ حَيْثُ يَسْجُدُ فَحَسَنٌ \"","","","","","Book of Prayer"
"3155","عَنِ الثَّوْرِيِّ , عَنْ خَالِدٍ , عَنِ ابْنِ سِيرِينَ , قَالَ : كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَرْفَعُ بَصَرَهُ إِلَى السَّمَاءِ فَأُمِرَ بِالْخُشُوعِ , فَرَفَعَ بَصَرَهُ نَحْوَ مَسْجِدِهِ","","","","","Book of Prayer"
"3156","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَرْفَعُ رَأْسَهُ إِلَى السَّمَاءِ وَهُوَ يُصَلِّي حَتَّى أَنْزَلَ اللَّهُ  الَّذِينَ هُمْ فِي صَلاتِهِمْ خَاشِعُونَ , أَوْ غَيْرَهَا , فَإِنْ لَمْ تَكُنْ تِلْكَ فَلا أَدْرِي مَا هِيَ , فَضَرَبَ بِرَأْسِهِ \" , قَالَ مَعْمَرٌ : فَسَمِعْتُ الزُّهْرِيَّ يَقُولُ فِي قَوْلِهِ :  خَاشِعُونَ , قَالَ : \" السُّكُونُ فِي الصَّلاةِ \" , وَقَالَهُ الثَّوْرِيُّ , عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ مِثْلَهُ","","","","","Book of Prayer"
"3157","عَنِ الثَّوْرِيِّ , عَنْ أَبِي سِنَانٍ الشَّيْبَانِيِّ , عَنْ رَجُلٍ , أَنَّهُ سُئِلَ عَنْ قَوْلِهِ :  الَّذِينَ هُمْ فِي صَلاتِهِمْ خَاشِعُونَ , قَالَ : \" لا تَلْتَفِتْ فِي صَلاتِكَ , وَأَنْ تَلِينَ كَتِفُكَ لِلرَّجُلِ الْمُسْلِمِ \"","","","","","Book of Prayer"
"3158","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , قال : \" كَانَ الرَّجُلُ إِذَا لَمْ يُبْصِرْ كَذَا وَكَذَا يُؤْمَرُ أَنْ يُغْمِضَ عَيْنَيْهِ \"","","","","","Book of Prayer"
"3159","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِير , أَنَّ الْعَبْدَ إِذَا الْتَفَتَ فِي صَلاتِهِ , قَالَ اللَّهُ : أَنَا خَيْرٌ لَكَ مِمَّنْ تَلْتَفِتُ إِلَيْهِ , فَإِنْ فَعَلَ الثَّانِيَةَ , قَالَ : مِثْلَ ذَلِكَ , فَإِنْ فَعَلَ الثَّالِثَةَ أَعْرَضَ عَنْهُ \" , قَالَ مَعْمَرٌ : وَسَمِعْتُ أَبَانَ يَذْكُرُ نَحْوَهُ","","","","","Book of Prayer"
"3160","عَنِ ابْنِ جُرَيْجٍ , قال : \" قُلْتُ لِعَطَاءٍ : أُبْصِرُ عَنْ يَمِينِي , وَعَنْ شِمَالِي فِي الصَّلاةِ , هَلْ يَقْطَعُ الالْتِفَاتُ الصَّلاةَ ؟ , قَالَ : لا , قُلْتُ : أَسْجُدُ سَجْدَتَيِ السَّهْوِ ؟ , قَالَ : . . . \"","","","","","Book of Prayer"
"3161","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أُبْصِرُ عَنْ يَمِينِي , وَعَنْ شِمَالِي فِي الصَّلاةِ ؟ , قَالَ : \" لا , إِلا أَنْ تُقِيمَ صَفًّا , أَوْ تَطْمَحَ بِبَصَرِكَ أَمَامَكَ , وَجَاهِدْ أَنْ لا تَحْفَظَهُ , وَلا تَطْمَحْ بِهِ هَاهُنَا , وَلا هَاهُنَا , إِنَّمَا الصَّلاةُ تَخَشُّعٌ وَخُشُوعٌ لِلَّهِ \"","","","","","Book of Prayer"
"3162","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الْمَرْأَةُ يَبْكِي ابْنُهَا وَهِيَ فِي الْمَكْتُوبَةِ أَتَتَوَرَّكُهُ ؟ , قَالَ : \" نَعَمْ , قَدْ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَخَذَ حَسَنًا فِي الصَّلاةِ , فَحَمَلَهُ قَائِمًا حَتَّى إِذَا سَجَدَ وَضَعَهُ \" , قُلْتُ : فِي الْمَكْتُوبَةِ ؟ , قَالَ : \" لا أَدْرِي \"","","","","","Book of Prayer"
"3163","عَنْ إِبْرَاهِيمَ بْنِ أَبِي يَحْيَى , قَالَ : أَخْبَرَنِي شَيْخٌ مِنْ أَهْلِ الْمَدِينَةِ , يُقَالُ لَهُ : أَبُو عَلِيٍّ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا دَخَلَ فِي الصَّلاةِ رَمَى بِبَصَرِهِ يَمِينًا وَشِمَالا مِنْ غَيْرِ أَنْ يَثْنِيَ عُنُقَهُ \"","","","","","Book of Prayer"
"3164","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : \" إِذَا صَلَّى أَحَدُكُمْ فَلا يَلْتَفِتْ , إِنَّهُ يُنَاجِي رَبَّهُ , إِنَّ رَبَّهُ أَمَامَهُ , وَإِنَّهُ يُنَاجِيهِ \" , قَالَ : \" وَبَلَغَنَا أَنَّ الرَّبَّ تَبَارَكَ وَتَعَالَى , يَقُولُ : يَا ابْنَ آدَمَ , إِلَى مَنْ تَلْتَفِتُ ؟ أَنَا خَيْرٌ لَكَ مِمَّنْ تَلْتَفِتُ إِلَيْهِ \"","","","","","Book of Prayer"
"3165","أَخْبَرَنِي مَنْ , \" رَأَى الْقَاسِمَ أَوْ سَالِمًا يُصَلِّي وَهُوَ يَنْظُرُ عَنْ يَمِينَهُ , وَعَنْ شِمَالِهِ \"","","","","","Book of Prayer"
"3166","عَنِ الْحَسَنِ بْنِ عُمَارَةَ , عَنِ الْحَكَمِ بْنِ عُتَيْبَةَ , عَنْ عَبْدِ اللَّهِ يَعْنِي ابْنَ مَعْبَدٍ , عَنْ حُذَيْفَةَ , قَالَ : \" إِنَّ الْعَبْدَ إِذَا تَوَضَّأَ فَأَحْسَنَ وُضُوءَهُ , ثُمَّ قَامَ إِلَى الصَّلاةِ , اسْتَقْبَلَهُ اللَّهُ بِوَجْهِهِ يُنَاجِيهِ , فَلَمْ يَصْرِفْهُ عَنْهُ حَتَّى يَكُونَ هُوَ الَّذِي يَصْرِفُ , أَوْ يَلْتَفِتُ يَمِينًا أَوْ شِمَالا \"","","","","","Book of Prayer"
"3167","عَنْ مَعْمَرٍ , عَمَّنْ , سَمِعَ الْحَسَنَ , يَقُولُ : \" إِنَّ الْعَبْدَ إِذَا الْتَفَتَ فِي الصَّلاةِ , فَإِنَّمَا يَلْوِي عُنُقَهُ شَيْطَانٌ \"","","","","","Book of Prayer"
"3168","عَنْ مَالِكٍ , عَنْ أَبِي جَعْفَرٍ الْقَارِئِ , قَالَ : \" كُنْتُ أُصَلِّي وَابْنُ عُمَرَ وَرَائِي , وَلا أَشْعُرُ بِهِ , فَوَضَعَ يَدَهُ فِي قَفَاي فَغَمَزَنِي \"","","","","","Book of Prayer"
"3169","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ عُمَارَةَ , عَنْ أَبِي عَطِيَّةَ , قَالَ : سَأَلْتُ عَائِشَةَ , عَنِ الالْتِفَاتِ فِي الصَّلاةِ , فَقَالَتْ : \" هُوَ اخْتِلاسٌ يَخْتَلِسُهُ الشَّيْطَانُ مِنِ الصَّلاةِ \"","","","","","Book of Prayer"
"3170","أَخْبَرَنَا مَعْمَرٌ , عَنِ الزُّهْرِيِّ , عَنْ أَنَسِ بْنِ مَالِكٍ : \" أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُشِيرُ فِي الصَّلاةِ \" , عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ مِثْلَهُ","","","","","Book of Prayer"
"3171","عَنْ مَعْمَرٍ , عَنْ ثَابِتٍ الْبُنَانِيِّ , عَنْ أَبِي رَافِعٍ , قَالَ : \" رَأَيْتُ أَصْحَابَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , وَإِنَّ أَحَدَهُمْ لَيَشْهَدُ الشَّهَادَةَ وَهُوَ قَائِمٌ يُصَلِّي \"","","","","","Book of Prayer"
"3172","قَالَ مَعْمَرٌ وَحَدَّثَنِي بَعْضُ أَصْحَابِنَا \" أَنَّ عَائِشَةَ كَانَتْ تَأْمُرُ خَادِمَتَهَا أَنْ تَقْسِمَ الْمَرَقَةَ , فَتَمُرُّ بِهَا وَهِيَ فِي الصَّلاةِ , فَتُشِيرُ إِلَيْهَا أَنْ زِيدِي \"","","","","","Book of Prayer"
"3173","عَنْ أَبِي مَعْشَرٍ , قَالَ : أَخْبَرَنَا مُحَمَّدُ بْنُ قَيْسٍ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى فِي بَيْتِ أُمِّ سَلَمَةَ , فَجَاءَهُ عُمَرُ بْنُ أَبِي سَلَمَةَ لأَنْ يَمُرَّ بَيْنَ يَدَيْهِ , فَأَشَارَ إِلَيْهِ فَرَجَعَ , فَجَاءَتْ زَيْنَبُ بِنْتُ أَبِي سَلَمَةَ , فَأَشَارَ إِلَيْهَا فَمَضَتْ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَنْتُنَّ أَعْصَى","","","","","Book of Prayer"
"3174","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ أَبِي لَيْلَى , عَنِ الْحَكَمِ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , قال : \" إِنِّي لأَعُدُّهَا لِلرَّجُلِ عِنْدِي يَدًا أَنْ يَعْدِلَنِي فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3175","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ خَيْثَمَةَ , قَالَ : \" رَأَيْتُ ابْنَ عُمَرَ يُشِيرُ إِلَيَّ وَإِلَى رَجُلٍ فِي الصَّفِّ وَرَأَى خَلَلا أَنْ تَقَدَّمْ \"","","","","","Book of Prayer"
"3176","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : فِي رَجُلٍ كَانَ يُصَلِّي فَمَرَّ بِهِ رَجُلٌ , فَقَالَ لَهُ : فَعَلْتَ كَذَا وَكَذَا فَاضْطَمَرَ , فَقال : \" لِيُتِمَّ صَلاتَهُ وَلْيَسْجُدْ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3177","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : يَمُرُّ بِي إِنْسَانٌ , فَأَقُولُ : سُبْحَانَ اللَّهِ مَرَّتَيْنِ أَوْ ثَلاثًا فَيُقْبِلُ , فَأَقُولُ أَنْ يَذْهَبَ بِيَدِي , فَيَقُولُ : أَلِي كَذَا وَأَلِي كَذَا , وَأَنَا فِي الْمَكْتُوبَةِ انْقَطَعَتْ صَلاتِي ؟ , قَالَ \" لا , وَلَكِنْ أَكْرَهُهُ \" , قُلْتُ : أَسْجُدُ سَجْدَتَيِ السَّهْوِ ؟ , قَالَ : \" لا , قَدْ بَلَغَنَا أَنَّهُ مَا يَخْشَى الإِنْسَانُ شَيْئًا أَشَدَّ عَلَيْهِ مِنْ صَلاتِهِ فَأَخْشَى أَنْ يَكُونَ ذَلِكَ نَقْصًا لَهَا \"","","","","","Book of Prayer"
"3178","عَنِ ابْنِ جُرَيْجٍ , قال : \" قُلْتُ لِعَطَاءٍ : أَفَتَكْرَهُ كُلَّ شَيْءٍ مِنَ الإِيمَاءِ فِي الْمَكْتُوبَةِ ؟ إِذَا جَاءَ رَجُلٌ , فَقَالَ : أَصَلَّيْتَ الصَّلاةَ ؟ كَرِهْتُ أَنْ أُشِيرَ إِلَيْهِ بِرَأْسِي ؟ , قَالَ : نَعَمْ , أَكْرَهُ كُلَّ شَيْءٍ مِنْ ذَلِكَ \"","","","","","Book of Prayer"
"3179","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ : أَوْ فِي التَّطَوُّعِ ؟ , قَالَ : \" إِنْ كَانَ شَيْءٌ لا بُدَّ مِنْهُ , وَأَحَبُّ إِلَيَّ أَنْ لا تَفْعَلَ \"","","","","","Book of Prayer"
"3180","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ إِنْسَانٌ لِعَطَاءٍ : يَأْتِينِي إِنْسَانٌ وَأَنَا فِي الْمَكْتُوبَةِ فَيُخْبِرُنِي الْخَبَرَ فَأَسْتَمِعُ إِلَيْهِ , قَالَ : \" مَا أُحِبُّهُ , حَتَّى أَنْ يَكُونَ سَهْوًا , إِنَّمَا هِيَ الْمَكْتُوبَةُ , فَتَفَرَّغْ لَهَا حَتَّى تَفَرُغَ مِنْهَا \"","","","","","Book of Prayer"
"3181","عَنْ إِسْمَاعِيلَ بْنِ أُمَيَّةَ : أَنَّ إِنْسَانًا , اسْتَأْذَنَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِهَدِيَّةٍ , فَأَخَذَهَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِيَدِهِ وَهُوَ فِي الصَّلاةِ","","","","","Book of Prayer"
"3182","عَنْ مَعْمَرٍ , عَنِ الْحَسَنِ , وَقَتَادَةَ في رجل كان يصلي , فأشفق أَنْ يَذْهَبَ دَابَّتُهُ , أَوْ أَغَارَ عَلَيْهَا السَّبُعُ ؟ , قَالا : \" يَنْصَرِفُ \" , قِيلَ : أَفَيُتِمُّ عَلَى مَا قَدْ صَلَّى ؟ , قَالَ مَعْمَرٌ : أَخْبَرَنِي عَمْرٌو , عَنِ الْحَسَنِ , أَنَّهُ قَالَ : \" إِذَا وَلَّى ظَهْرَهُ الْقِبْلَةَ اسْتَأْنَفَ الصَّلاةَ \"","","","","","Book of Prayer"
"3183","عَنْ مَعْمَرٍ , عَنِ الأَزْرَقِ بْنِ قَيْسٍ , أَنَّ أَبَا بَرْزَةَ الأَسْلَمِيَّ , \" خَافَ عَلَى دَابَّتِهِ الأَسَدَ , فَمَشَى إِلَيْهَا وَهُوَ فِي الصَّلاةِ فَأَخَذَهَا \"","","","","","Book of Prayer"
"3184","عَنِ ابْنِ التَّيْمِيِّ , عَنْ أَبِيهِ , عَنِ الأَزْرَقِ بْنِ قَيْسٍ : \" أَنَّ أَبَا بَرْزَةَ الأَسْلَمِيَّ كَانَ يُصَلِّي , وَإِنَّهُ خَافَ عَلَى بَغْلَتِهِ , فَمَشَى إِلَيْهَا حَتَّى أَخَذَهَا وَهُوَ يُصَلِّي \"","","","","","Book of Prayer"
"3185","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" سَأَلْتُهُ , قَالَ : قُلْتُ : الرَّجُلُ يُصَلِّي فَيَرَى صَبِيًّا عَلَى بِئْرٍ يَتَخَوَّفُ أَنْ يَسْقُطَ فِيهَا , أَيَنْصَرِفُ ؟ , قَالَ : نَعَمْ , قُلْتُ : فَيَرَى سَارِقًا يُرِيدُ أَنْ يَأْخُذَ بَغْلَتَهُ ؟ , قَالَ : يَنْصَرِفُ \"","","","","","Book of Prayer"
"3186","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : سَأَلَهُ رَجُلٌ , قَالَ : \" تَدْخُلُ الشَّاةُ بَيْتِي وَأَنَا أُصَلِّي , فَأُطَأْطِئُ رَأْسِي فَآخُذُ الْقَصَبَةَ فَأَضْرِبُهَا , قَالَ : لا بَأْسَ \"","","","","","Book of Prayer"
"3187","عَنِ الثَّوْرِيِّ , عَنْ بَعْضِ أَصْحَابِهِ : \" أَنَّ أَبَا بَرْزَةَ الأَسْلَمِيَّ , انْفَلَتَتْ دَابَّتُهُ وَهُوَ فِي الصَّلاةِ , فَانْصَرَفَ فَأَخَذَهَا \"","","","","","Book of Prayer"
"3188","عَنِ الثَّوْرِيِّ , عَنِ الْعَلاءِ بْنِ الْمُسَيَّبِ , عَنْ أَبِي مُصْعَبٍ , عَنِ ابْنِ عَبَّاسٍ : \" كَرِهَ أَنْ يَنْقُضَ الرَّجُلُ أَصَابِعَهُ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3189","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : \" أَنَّهُ كَرِهَهُ \"","","","","","Book of Prayer"
"3190","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : الرَّجُلُ يَتَمَطَّى فِي الصَّلاةِ ؟ , قَالَ : \" لَمْ يَبْلُغْنِي فِيهِ شَيْءٌ وَلَكِنِّي لا أُحِبُّهُ \" , قُلْتُ : فَيُقَعْقِعُ الرَّقَبَةَ وَالأَصَابِعَ وَغَيْرَ ذَلِكَ فِي الصَّلاةِ ؟ , قَالَ : \" أَكْرَهُهُ \" , قُلْتُ : التَّنَخُّعُ , أَوِ الامْتِخَاطُ , وَالْبُزَاقُ , وَإِدْخَالُ الرَّجُلِ يَدَهُ فِي أَنْفِهِ ؟ , قَالَ : \" لا تَفْعَلْهُ فِي الصَّلاةِ \" , قُلْتُ : فَالاحْتِكَاكُ فِي الصَّلاةِ , وَالارْتِدَاءُ , وَالاتِّزَارُ فِي الصَّلاةِ ؟ , قَالَ : \" كُلُّ ذَلِكَ لا تَفْعَلْهُ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3191","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" وَأَكْرَهُ أَنْ يُكْثِرَ التَّحَرُّكَ \" , قُلْتُ : فَفَعَلْتُ شَيْئًا مِمَّا قُلْتُ لَكَ : أَسْجُدُ سَجْدَتَيِ السَّهْوِ ؟ , قَالَ : \" لا \"","","","","","Book of Prayer"
"3192","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : يُكْرَهُ مَسْحُ الْقَدَمَيْنِ فِي الصَّلاةِ الْمَكْتُوبَةِ ؟ , قَالَ : \" وَإِنِّي لأُحِبُّ أَنْ يُقِلَّ الرَّجُلُ التَّحَرُّكَ \"","","","","","Book of Prayer"
"3193","عَنِ ابْنِ جُرَيْجٍ , قَالَ : بَلَغَنِي , أَنَّ ابْنَ عُمَرَ , كَانَ يُصَلِّي فَيَمْسَحُ الْحَصَى بِرِجْلَيْهِ \"","","","","","Book of Prayer"
"3194","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , \" أَنَّ ابْنَ عُمَرَ كَانَ يَقْرَأُ الْبَقَرَةَ فِي رَكْعَةٍ , وَكَانَ بَطِيءُ الْقِرَاءَةِ , فَيَضْرِبُ بِأَصَابِعِ رِجْلِهِ عَلَى الأَرْضِ \"","","","","","Book of Prayer"
"3195","وَسَأَلْتُ عَطَاءً عَنْ ضَمِّ الْمَرْءِ قَدَمَيْهِ فِي الصَّلاةِ , فَقال : \" أَمَّا هَكَذَا حَتَّى تُمَاسَّ بَيْنَهُمَا فَلا , وَلَكِنْ وَسَطًا مِنْ ذَلِكَ \" , فَقَالَ ابْنُ جُرَيْجٍ : وَلقَدْ أَخْبَرَنِي نَافِعٌ \" أَنَّ ابْنَ عُمَرَ كَانَ لا يُفَرْسِخُ بَيْنَهُمَا , وَلا يُمِسُّ إِحْدَاهُمَا الأُخْرَى , قَالَ : بَيْنَ ذَلِكَ \"","","","","","Book of Prayer"
"3196","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِنِّي لأُحِبُّ أَنْ يُقِلَّ التَّحَرُّكَ فِي الصَّلاةِ , وَأَنْ يَعْتَدِلَ قَائِمًا عَلَى قَدَمَيْهِ , إِلا أَنْ يَكُونَ إِنْسَانًا كَبِيرًا لا يَسْتَطِيعُ ذَلِكَ , فَأَمَّا الطُّولُ عَلَى الإِنْسَانِ فَلا بُدَّ لَهُ مِنَ التَّوَرُّكِ عَلَى هَذِهِ مَرَّةً , وَعَلَى هَذِهِ مَرَّةً \"","","","","","Book of Prayer"
"3197","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ : \" أَنَّ أَبَا بَكْرٍ , وَابْنَ الزُّبَيْرِ , كَانَ إِذَا صَلَّى كَأَنَّهُ عَمُودٌ \"","","","","","Book of Prayer"
"3198","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , وَمَنْصُورٍ , عَنْ مُجَاهِدٍ , قَالَ : \" كَانَ عَبْدُ اللَّهِ إِذَا صَلَّى كَأَنَّهُ ثَوْبٌ مُلْقًى \"","","","","","Book of Prayer"
"3199","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : \" كَانَ الزُّبَيْرُ إِذَا صَلَّى كَأَنَّهُ كَعْبٌ رَاتِبٌ \"","","","","","Book of Prayer"
"3200","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي الضُّحَى , عَنْ مَسْرُوقٍ , قَالَ : قَالَ عَبْدُ اللَّهِ : \" قَارُّوا الصَّلاةَ \" , يَقُولُ : \" اسْكُنُوا , اطْمَئِنُّوا \"","","","","","Book of Prayer"
"3201","عَنِ الثَّوْرِيِّ , عَنْ رَجُلٍ , عَنِ الْمِنْهَالِ بْنِ عَمْرٍو , عَنْ أَبِي عُبَيْدَةَ , قَالَ : مَرَّ ابْنُ مَسْعُودٍ بِرَجُلٍ صَافٍّ بَيْنَ قَدَمَيْهِ , فَقَالَ : \" أَمَّا هَذَا فَقَدْ أَخْطَأَ السُّنَّةَ , لَوْ رَاوَحَ بِهِمَا كَانَ أَحَبَّ إِلَيَّ \"","","","","","Book of Prayer"
"3202","عَنِ ابْنِ جُرَيْجٍ , قال : \" قُلْتُ لِعَطَاءٍ : يَرْكَعُ الْمَرْءُ حَاذِيًا قَدَمَيْهِ , يَفُوقُ إِحْدَاهُمَا الأُخْرَى ؟ , قَالَ : لا بَأْسَ بِذَلِكَ \"","","","","","Book of Prayer"
"3203","عَنْ مَعْمَرٍ , عَنْ أَبَانَ , قال : \" رَأَى ابْنُ الْمُسَيَّبِ رَجُلا يَعْبَثُ بِلِحْيَتِهِ فِي الصَّلاةِ , فَقَالَ : إِنِّي لأَرَى هَذَا لَوْ خَشَعَ قَلْبُهُ خَشَعَتْ جَوَارِحُهُ \"","","","","","Book of Prayer"
"3204","عَنِ الثَّوْرِيِّ , عَنْ رَجُلٍ , قال : \" رَآنِي ابْنُ الْمُسَيَّبِ أَعْبَثُ بِالْحَصَى فِي الصَّلاةِ , فَقَالَ : لَوْ خَشَعَ قَلْبُ هَذَا خَشَعَتْ جَوَارِحُهُ \"","","","","","Book of Prayer"
"3205","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : \" أَنَّهُ كَانَ يَكْرَهُ كُلَّ شَيْءٍ مِنَ الْعَبَثِ فِي الصَّلاةِ \" , قَالَ الثَّوْرِيُّ : \" جَاءَتِ الأَحَادِيثُ أَنَّهُ كَانَ يَكْرَهُ الْعَبَثَ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3206","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" يُكْرَهُ لِلرَّجُلِ أَنْ يَعْبَثَ بِالْحَصَى وَهُوَ يُصَلِّي \"","","","","","Book of Prayer"
"3207","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" يُكْرَهُ أَنْ يَمَسَّ أَنْفَهُ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3208","عَنْ مَعْمَرٍ , وَابْنِ التَّيْمِيِّ , عَنْ لَيْثٍ , عَنْ طَلْحَةَ بْنِ مُصَرِّفٍ , قال : \" تَقْلِيبُ الْحَصَى أَذًى لِلْمَلِكِ \"","","","","","Book of Prayer"
"3209","عَنِ الثَّوْرِيِّ , عَنْ عَلِيِّ بْنِ الأَقْمَرِ , قال : \" رَآنِي مَسْرُوقٌ وَأَنَا أَعْبَثُ بِالْحَصَى بِيَدِي فِي الصَّلاةِ , فَضَرَبَ يَدِي \"","","","","","Book of Prayer"
"3210","عَنِ الثَّوْرِيِّ , عَنْ مَعْنِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ شَيْخٍ , عَنْ عَبْدِ اللَّهِ , قَالَ : \" رَأَى رَجُلا يُحَرِّكُ الْحَصَى وَهُوَ فِي الصَّلاةِ , فَقَالَ عَبْدُ اللَّهِ : إِذَا سَأَلْتَ رَبَّكَ فِي صَلاةٍ فَلا تَسْأَلْهُ وَبِيَدِكَ الْحَجَرُ \"","","","","","Book of Prayer"
"3211","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ , قال : \" كَانَ يُقَالُ فِي مَسْحِ اللِّحْيَةِ فِي الصَّلاةِ : وَاحِدَةً أَوْ دَعْ \" , قَالَ : سَأَلْتُ مُجَاهِدًا عَنْ طِينِ الْمَطَرِ يُصِيبُ الثَّوْبَ , قَالَ : \" حُتَّهُ إِذَا يَبِسَ \"","","","","","Book of Prayer"
"3212","عَنْ هُشَيْمِ بْنِ بَشِيرٍ , قَالَ : أَخْبَرَنِي حُصَيْنُ بْنُ عَبْدِ الرَّحْمَنِ , عَنْ عَبْدِ الْمَلِكِ بْنِ سَعِيدٍ , قَالَ : \" كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَضَعُ يَدَهُ الْيُمْنَى عَلَى يَدِهِ الْيُسْرَى , وَكَانَ رُبَّمَا وَضَعَ يَدَهُ عَلَى لِحْيَتِهِ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3213","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" بَلَغَنَا أَنَّهُ يُكْرَهُ التَّثَاؤُبُ فِي الصَّلاةِ وَفِي غَيْرِهَا \" , قَالَ : وَقَالَ : \" يَلْعَبُ الشَّيْطَانُ بِالإِنْسَانِ \" , قَالَ : \" وَهُوَ فِي الصَّلاةِ أَشَدُّ \"","","","","","Book of Prayer"
"3214","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنَّ عَلِيًّا , قَالَ : \" سَبْعٌ مِنَ الشَّيْطَانِ الرُّعَافُ , وَالْقَيْءُ , وَشِدَّةُ الْعُطَاسِ , وَالتَّثَاؤُبُ , وَالنُّعَاسُ عِنْدَ الْمَوْعِظَةِ , وَالْغَضَبُ , وَالنَّجْوَى \"","","","","","Book of Prayer"
"3215","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ يَزِيدَ , قال : \" إِنَّ لِلشَّيْطَانِ قَارُورَةٌ فِيهَا نُفُوخٌ , فَإِذَا قَامَ الْقَوْمُ إِلَى الصَّلاةِ أَشَمَّهُمْ , فَيَتَثَاوَبُونَ , فَيُؤْمَرُ مَنْ وَجَدَ ذَلِكَ أَنْ يَضُمَّ شَفَتَيْهِ وَمِنْخَرَيْهِ \"","","","","","Book of Prayer"
"3216","عَنِ الثَّوْرِيِّ , عَنْ عُثْمَانَ بْنِ الأَسْوَدِ , عَنْ مُجَاهِدٍ , قال : \" إِذَا كَانَ الرَّجُلُ يَقْرَأُ فَيَتَثَاوَبُ , فَلْيُمْسِكْ عَنِ الْقِرَاءَةِ \"","","","","","Book of Prayer"
"3217","عَنِ الثَّوْرِيِّ , عَنْ مُحَمَّدِ بْنِ عَجْلانَ , عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : \" إِنَّ اللَّهَ يُحِبُّ الْعُطَاسَ , وَيُبْغِضُ التَّثَاؤُبَ , فَإِذَا قَالَ أَحَدُكُمْ : هَاهْ هَاهْ , فَإِنَّمَا هُوَ مِنَ الشَّيْطَانِ يَضْحَكُ مِنْ جَوْفِهِ \" . ذَكَرَهُ أَبُو مَعْشَرٍ , عَنْ سَعِيدٍ , عَنْ أَبِي هُرَيْرَةَ","","","","","Book of Prayer"
"3218","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ هِلالِ بْنِ يَسَافٍ , أَنَّ ابْنَ عَبَّاسٍ كَانَ , يَقُولُ : \" إِذَا تَثَاوَبَ أَحَدُكُمْ فِي الصَّلاةِ فَلْيَضَعْ يَدَهُ عَلَى فِيهِ , فَإِنَّهُ مِنَ الشَّيْطَانِ \"","","","","","Book of Prayer"
"3219","عَنِ ابْنِ عُيَيْنَةَ , عَنِ الْعَلاءِ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِيهِ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا تَثَاوَبَ أَحَدُكُمْ فَلْيَضُمَّ مَا اسْتَطَاعَ \"","","","","","Book of Prayer"
"3220","أَخْبَرَنَا مَعْمَرٌ , عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ , عَنِ ابْنِ أَبِي سَعِيدٍ الْخُدْرِيِّ , عَنْ أَبِيهِ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا تَثَاوَبَ أَحَدُكُمْ فَلْيَضَعْ يَدَهُ عَلَى فِيهِ , فَإِنَّ الشَّيْطَانَ يَدْخُلُ مَعَ التَّثَاوُبِ \"","","","","","Book of Prayer"
"3221","عَنْ مَعْمَرٍ , قَالَ : سَمِعْتُ بَعْضَ الْمَدَنِيِّينَ , يَقُولُ : \" إِذَا قَالَ الإِنْسَانُ فِي التَّثَاوُبِ : هَاهْ هَاهْ , فَإِنَّ الشَّيْطَانَ يَضْحَكُ مِنْ جَوْفِهِ \"","","","","","Book of Prayer"
"3222","عَنِ الثَّوْرِيِّ , عَنِ الْعَلاءِ بْنِ الْمُسَيَّبِ , عَنْ أَبِي مُصْعَبٍ , عَنِ ابْنِ عَبَّاسٍ : \" أَنَّهُ كَرِهَ أَنْ يَنْقُضَ الرَّجُلُ أَصَابِعَهُ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3223","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : \" أَنَّهُ كَرِهَ تَفْقِيعَ الرَّجُلِ رَقَبَتَهُ وَأَصَابِعَهُ فِي الصَّلاةِ \" . يَعْنِي تَنْقِيضَ الأَصَابِعِ","","","","","Book of Prayer"
"3224","عَنِ الثَّوْرِيِّ , عَنْ لَيْثٍ , عَنْ مُجَاهِدٍ , قال : \" يُكْرَهُ أَنْ يُغْمِضَ الرَّجُلُ عَيْنَيْهِ فِي الصَّلاةِ كَمَا يُغْمِضُ الْيَهُودُ \"","","","","","Book of Prayer"
"3225","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , قال : \" كَانَ يُؤْمَرُ إِذَا كَانَ يُكْثِرُ الالْتِفَاتَ فِي الصَّلاةِ , فَلْيُغْمِضْ عَيْنَيْهِ \"","","","","","Book of Prayer"
"3226","عَنْ أَبِي مَعْشَرٍ , عَنْ سَعِيدٍ الْمَقْبُرِيِّ , عَنْ رَجُلٍ , مِنْ بَنِي سَالِمٍ , عَنْ أَبِيهِ , عَنْ جَدِّهِ , عَنْ كَعْبِ بْنِ عُجْرَةَ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" مَا مِنْ رَجُلٍ يَتَوَضَّأُ فِي بَيْتِهِ , ثُمَّ يَخْرُجُ يُرِيدُ الصَّلاةَ , إِلا كَانَ فِي صَلاةٍ حَتَّى يَقْضِيَ صَلاتَهُ , فَلا يُشَبِّكْ بَيْنَ أَصَابِعَهُ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3227","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ عَجْلانَ , عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ , عَنْ رَجُلٍ مُصَدَّقٍ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" إِذَا تَوَضَّأَ أَحَدُكُمْ فِي بَيْتِهِ , ثُمَّ يَخْرُجُ يُرِيدُ الصَّلاةَ , فَلا يَزَالُ فِي صَلاتِهِ حَتَّى يَرْجِعَ , فَلا تَقُولُوا : هَكَذَا , ثُمَّ شَبَّكَ فِي الأَصَابِعِ , إِحْدَى أَصَابِعِ يَدَيْهِ فِي الأُخْرَى \"","","","","","Book of Prayer"
"3228","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ عَجْلانَ , عَنْ سَعِيدٍ الْمَقْبُرِيِّ , عَنْ بَعْضِ بَنِي كَعْبِ بْنِ عُجْرَةَ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" إِذَا تَوَضَّأْتَ فَأَحْسَنْتَ وُضُوءَكَ , ثُمَّ عَمَدْتَ إِلَى الْمَسْجِدِ , فَإِنَّكَ فِي صَلاةٍ , فَلا تُشَبِّكْ أَصَابِعَكَ \"","","","","","Book of Prayer"
"3229","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ عَجْلانَ , قَالَ : حَدَّثَنِي سَعِيدُ بْنُ أَبِي سَعِيدٍ , عَنْ كَعْبِ بْنِ عُجْرَةَ , قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا تَوَضَّأْتَ ثُمَّ خَرَجْتَ عَامِدًا إِلَى الْمَسْجِدِ فَلا تُشَبِّكْ بَيْنَ أَصَابِعِكَ , فَإِنَّكَ فِي الصَّلاةِ \" , عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ عَجْلانَ , عَنِ ابْنِ الْمُسَيَّبِ مِثْلَهُ , إِلا أَنَّهُ لَمْ يَبْلُغْ بِهِ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Prayer"
"3230","عَنِ ابْنِ جُرَيْجٍ , عَنْ مُحَمَّدٍ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَقِيَ رَجُلا وَهُوَ مُشَبِّكٌ إِحْدَى يَدَيْهِ بِالأُخْرَى , فَقَالَ : \" أَيْنَ تُرِيدُ ؟ \" , فَقَالَ : الْمَسْجِدَ , فَفَرَّجَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بَيْنَ أَصَابِعِ الرَّجُلِ , ثُمَّ قَالَ : \" إِذَا خَرَجَ أَحَدُكُمْ مِنْ بَيْتِهِ إِلَى الْمَسْجِدِ فَلا يَصْنَعْ هَذَا التَّشْبِيكَ \"","","","","","Book of Prayer"
"3231","عَنْ مُحَمَّدِ بْنِ مُسْلِمٍ , عَنْ إِبْرَاهِيمَ بْنِ مَيْسَرَةَ , عَنْ طَاوُسٍ : \" أَنَّهُ كَرِهَ أَنْ يُشَبِّكَ الرَّجُلُ أَصَابِعَهُ فِي الصَّلاةِ , وَأَنْ يُصَلِّيَ وَهُوَ عَاقِدٌ شَعْرَهُ \"","","","","","Book of Prayer"
"3232","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي الضُّحَى , عَنْ مَسْرُوقٍ , عَنْ عَائِشَةَ : \" نَهَتْ أَنْ يَجْعَلَ الرَّجُلُ أَصَابِعَهُ فِي خَاصِرَتِهِ فِي الصَّلاةِ كَمَا يَصْنَعُ الْيَهُودُ \" , قَالَ مَعْمَرٌ فِي حَدِيثِهِ : \" فَإِنَّهُ مَعْشَرُ الْيَهُودِ \"","","","","","Book of Prayer"
"3233","عَنِ الثَّوْرِيِّ , عَنْ صَالِحِ بْنِ نَبْهَانَ , قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : \" إِذَا قَامَ أَحَدُكُمْ إِلَى الصَّلاةِ فَلا يَجْعَلْ يَدَهُ فِي خَاصِرَتِهِ , فَإِنَّ الشَّيْطَانَ يَحْضُرُ ذَلِكَ \"","","","","","Book of Prayer"
"3234","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِسْحَاقُ بْنُ عُوَيْمِرٍ , قَالَ : \" إِنَّ وَضْعَ الإِنْسَانِ يَدَهُ عَلَى حَقْوِهِ اسْتِرَاحَةُ أَهْلِ النَّارِ \"","","","","","Book of Prayer"
"3235","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : \" أَنَّهُ كَرِهَ أَنْ يَضَعَ الرَّجُلُ يَدَهُ عَلَى حَقْوِهِ فِي الصَّلاةِ \" , قُلْتُ : لِمَ ؟ , قَالَ : \" لا أَدْرِي \"","","","","","Book of Prayer"
"3236","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ جُرَيْجٍ , عَنْ إِسْحَاقَ ابْنِ عُوَيْمِرٍ , عَنْ مُجَاهِدٍ , , أَنَّهُ قَالَ : \" وَضْعُ الْيَدِ فِي الْخَاصِرَةِ اسْتِرَاحَةُ أَهْلِ النَّارِ \" , قَالَ : وَفِي حَدِيثٍ آخَرٍ \" أَنَّهَا مِشْيَةُ إِبْلِيسَ \"","","","","","Book of Prayer"
"3237","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ يَرْوِيهِ , قَالَ \" إِنَّ اللَّهَ كَرِهَ لَكُمْ ثَلاثًا اللَّغْوَ عِنْدَ الْقُرْآنِ , وَرَفْعَ الصَّوْتِ فِي الدُّعَاءِ , وَالتَّخَصُّرَ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3238","عَنْ رَجُلٍ مِنْ أَهْلِ الْبَصْرَةِ , يُقَالُ لَهُ أَبُو شَيْبَانَ , قَالَ : أَخْبَرَنِي سَعِيدٌ الْجُرَيْرِيُّ , عَنْ يَحْيَى بْنِ يَعْمَرَ , أَوْ غَيْرِهِ , عَنْ قَيْسِ بْنِ عَبَّادٍ , قَالَ : بَيْنَمَا أَنَا قَاعِدٌ عِنْدَهُ إِذْ أَبْصَرَ رَجُلا فِي الصَّلاةِ مُخْرِجًا يَدَهُ مِنْ ثَوْبِهِ إِلَى خَلْفِهِ , فَقَالَ لِي : \" قُمْ إِلَى هَذَا , فَأْمُرْهُ أَنْ يَضَعَ يَدَيْهِ مِنْ مَوْضِعِ الْغُلِّ \" , قَالَ : وَأَبْصَرَ رَجُلا قَائِمًا يُصَلِّي وَقَدْ وَضَعَ يَدَهُ عَلَى حَقْوِهِ , فَقَالَ لِي : \" قُمْ إِلَى هَذَا , فَأْمُرْهُ أَنْ يَضَعَ يَدَهُ مِنْ مَوْضِعِ يَدِ الرَّاجِزِ \"","","","","","Book of Prayer"
"3239","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : \" أَنَّهُ كَانَ يَكْرَهُ أَنْ يَجْعَلَ الرَّجُلُ يَدَهُ الْيُسْرَى إِلَى جَنْبِهِ , وَيَجْعَلَ كَفَّهُ الْيُمْنَى بَيْنَ عَضُدِهِ الْيُسْرَى , وَبَيْنَ جَنْبِهِ , وَكَرِهَ أَنْ يَقْبِضَ بِكَفِّهِ الْيُمْنَى عَلَى عَضُدِهِ الْيُسْرَى , أَوْ كَفِّهِ الْيُسْرَى عَلَى عَضُدِهِ الْيُمْنَى \"","","","","","Book of Prayer"
"3240","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَفَأَقْبِضُ بِكَفَّيَّ أَحَدِهِمَا عَلَى كَفِّ الأُخْرَى , أَوْ عَلَى رَأْسِ الذِّرَاعِ , ثُمَّ أَسْدِلُهُمَا ؟ , قَالَ : \" لَيْسَ بِذَلِكَ بَأْسٌ \" , قَالَ أَبُو بَكْرٍ : \" وَرَأَيْتُ ابْنَ جُرَيْجٍ يُصَلِّي فِي إِزَارٍ وَرِدَاءٍ مُسْبِلا يَدَيْهِ \"","","","","","Book of Prayer"
"3241","عَنِ الثَّوْرِيِّ , وَهُشَيْمٍ , أو أحدهما , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ كَانَ يُصَلِّي مُسَدِّلا يَدَيْهِ \"","","","","","Book of Prayer"
"3242","عَنِ الثَّوْرِيِّ , عَنِ الْعَلاءِ بْنِ الْمُسَيَّبِ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ كَانَ يَكْرَهُ أَنْ يُتَرَوَّحَ فِي الصَّلاةِ يَعْنِي بِثَوْبِهِ مِنَ الْحَرِّ \"","","","","","Book of Prayer"
"3243","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : \" كَرِهَهُ \"","","","","","Book of Prayer"
"3244","عَنْ إِسْرَائِيلَ , عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ , عَنْ مُجَاهِدٍ , قال : \" لا بَأْسَ بِالتَّرَوُّحِ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3245","عَنْ إِسْرَائِيلَ بْنِ يُونُسَ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ عَبْدِ الرَّحْمَنِ : \" أَنَّهُ أَخْبَرَهُ مَنْ رَأَى جَابِرَ بْنِ عَبْدِ اللَّهِ يُصَلِّي وَهُوَ مُعْتَمِدٌ عَلَى الْجُدُرِ \"","","","","","Book of Prayer"
"3246","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قَالَ : سُئِلَ ابْنُ عُمَرَ , عَنِ الاعْتِمَادِ عَلَى الْجُدُرِ فِي الصَّلاةِ ؟ , فَقَالَ : \" إِنَّا لَنَفْعَلُهُ , وَإِنَّ ذَلِكَ يُنْقِصُ مِنَ الأَجْرِ \"","","","","","Book of Prayer"
"3247","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو مُحَمَّدٍ , عَنْ نَاسٍ مِنْ أَصْحَابِهِمْ , أَنَّ ابْنَ عُمَرَ , قَالَ : \" قَدْ عَلِمْتُ أَنَّهُ يُنْقِصُ الأَجْرَ وَضْعُ الإِنْسَانِ يَدَهُ عَلَى الْجُدُرِ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3248","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : \" يُكْرَهُ لِلرَّجُلِ أَنْ يُصَلِّيَ مُسْتَنِدًا إِلَى الْحَائِطِ إِلا مِنْ عُذْرٍ \"","","","","","Book of Prayer"
"3249","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , أَنَّ زَيْدَ بْنَ ثَابِتٍ , وَابْنَ عُمَرَ كَانَا يُفْتِيَانِ الرَّجُلَ إِذَا انْتَهَى إِلَى الْقَوْمِ وَهُمْ رُكُوعٌ أَنْ يُكَبِّرَ تَكْبِيرَةً , وَقَدْ أَدْرَكَ الرَّكْعَةَ , قَالا : \" وَإِنْ وَجَدَهُمْ سُجُودًا سَجَدَ مَعَهُمْ وَلَمْ يَعْتَدَّ بِذَلِكَ \"","","","","","Book of Prayer"
"3250","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" يُجْزِيهِ تَكْبِيرَةٌ وَاحِدَةٌ \"","","","","","Book of Prayer"
"3251","عَنِ الثَّوْرِيِّ , عَنْ أَبِي حَمْزَةَ , عَنْ إِبْرَاهِيمَ , قال : \" يُجْزِيهِ تَكْبِيرَةٌ وَاحِدَةٌ , وَإِنْ كَبَّرَ اثْنَتَيْنِ فَهُوَ أَحَبُّ إِلَيْنَا \"","","","","","Book of Prayer"
"3252","عَنْ مَعْمَرٍ , عَنْ حَمَّادٍ , قال : \" لا يُجْزِيهِ إِلا تَكْبِيرَتَانِ تَكْبِيرَةٌ يَفْتَتِحُ بِهَا , وَتَكْبِيرَةٌ يَرْكَعُ بِهَا \"","","","","","Book of Prayer"
"3253","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا دَخَلْتَ الْمَسْجِدَ وَالإِمَامُ رَاكِعٌ فَكَبَّرْتَ , ثُمَّ لا تَرْكَعُ حَتَّى يَرْفَعَ رَأْسَهُ , فَلا تَعْتَدَّهَا \" , عَنِ الثَّوْرِيِّ , عَنْ بَعْضِ أَصْحَابِهِ , عَنْ إِبْرَاهِيمَ مِثْلَ قَوْلِ عَطَاءٍ","","","","","Book of Prayer"
"3254","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِذَا أَدْرَكَتَ الإِمَامَ رَاكِعًا فَرَكَعْتَ قَبْلَ أَنْ يَرْفَعَ فَقَدْ أَدْرَكْتَ , وَإِنْ رَفَعَ قَبْلَ أَنْ تَرْكَعَ فَقَدْ فَاتَتْكَ \"","","","","","Book of Prayer"
"3255","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ أَبِي لَيْلَى , قال : \" إِذَا كَبَّرَ قَبْلَ أَنْ يَرْفَعَ الإِمَامُ رَأْسَهُ اتَّبَعَ الإِمَامَ , وَكَانَ بِمَنْزِلَةِ النَّائِمِ \"","","","","","Book of Prayer"
"3256","عَنِ الثَّوْرِيِّ فِي رَجُلٍ كَبَّرَ مَعَ الإِمَامِ فِي أَوَّلِ الصَّلاةِ , ثُمَّ نَعَسَ حَتَّى صَلَّى الإِمَامُ رَكْعَةً أَوْ رَكْعَتَيْنِ , قَالَ : \" إِذَا اسْتَيْقَظَ رَكَعَ وَسَجَدَ مَا سَبَقَهُ الإِمَامُ , وَيَتَّبِعُ الإِمَامَ مَا بَقِيَ , يَرْكَعُ وَيَسْجُدُ بِغَيْرِ قِرَاءَةٍ \"","","","","","Book of Prayer"
"3257","عَنْ مَعْمَرٍ , عَنْ رَجُلٍ , عَنِ الْحَسَنِ : \" فِي رَجُلٍ دَخَلَ مَعَ قَوْمٍ فِي صَلاتِهِمْ فَنَعَسَ حَتَّى رَكَعَ الإِمَامُ , قَالَ : يَتَّبِعُ الإِمَامَ \"","","","","","Book of Prayer"
"3258","عَنْ هِشَامِ بْنِ حَسَّانَ , عَنِ الْحَسَنِ : \" فِي رَجُلٍ دَخَلَ مَعَ الإِمَامِ فِي الصَّلاةِ حَتَّى رَكَعَ مِنْ نَعَسِهِ وَسَجَدَ , ثُمَّ اسْتَيْقَظَ , قَالَ : يَتَّبِعُ الإِمَامَ \"","","","","","Book of Prayer"
"3259","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ لَوْ كَبَّرْتُ مَعَ الإِمَامِ لاسْتِفْتَاحِ الصَّلاةِ , ثُمَّ رَكَعَ الإِمَامُ فَسَهَوْتُ فَلَمْ أَرْكَعْ حَتَّى رَكَعَ الإِمَامُ ؟ , قَالَ : \" فَقَدْ أَدْرَكْتَهَا فَاعْتَدَّ بِهَا \"","","","","","Book of Prayer"
"3260","عَنِ ابْنِ جُرَيْجٍ , قال : \" قُلْتُ لِعَطَاءٍ : نَعَسْتُ فَلَمْ أَزَلْ قَائِمًا حَتَّى رَكَعَ النَّاسُ وَسَجَدُوا , فَجَبَذَنِي إِنْسَانٌ , فَجَلَسْتُ كَمَا أَنِّي ؟ , قَالَ : أَوْفِ تِلْكَ الرَّكْعَةَ \"","","","","","Book of Prayer"
"3261","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أُقِيمَتِ الصَّلاةُ وَأَنَا مَعَ النَّاسِ فَكَبَّرَ الإِمَامُ وَرَفَعَ مِنَ الرَّكْعَةِ , وَلَمْ أُكَبِّرْ فِي ذَلِكَ , قَالَ : \" إِنْ كُنْتَ قَدِ اعْتَدَلْتَ فِي الصَّفِّ فَاعْتَدَّ بِهَا , وَإِنْ كُنْتَ لَمْ تَزَلْ تُحْدِثُ حَتَّى تَرْكَعَ , وَرَفَعَ رَأْسَهُ مِنْ رَكْعَتِهِ فَكَبِّرْ ثُمَّ ارْفَعْ , وَاعْتَدَّ بِهَا , وَإِنْ كُنْتَ لَمْ تَعْتَدِلْ فِي الصَّفِّ فَلا \"","","","","","Book of Prayer"
"3262","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : سَمِعْتُ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ : \" مَنْ أَدْرَكَ رَكْعَةً مِنَ الصَّلاةِ فَقَدْ أَدْرَكَ الصَّلاةَ \"","","","","","Book of Prayer"
"3263","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , عَنْ أَبِي سَلَمَةَ , عَنْ أَبِي هُرَيْرَةَ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" مَنْ أَدْرَكَ مِنَ الصَّلاةِ رَكْعَةً فَقَدْ أَدْرَكَ الصَّلاةَ \"","","","","","Book of Prayer"
"3264","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , أَنَّ هُبَيْرَةَ بْنَ يَرِيمَ أَخْبَرَهُ , عَنْ عَلِيٍّ , وَابْنِ مَسْعُودٍ , قَالا : \" مَنْ لَمْ يُدْرِكِ الرَّكْعَةَ الأُولَى فَلا يَعْتَدَّ بِالسَّجْدَةِ \"","","","","","Book of Prayer"
"3265","عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ هُبَيْرَةَ بْنِ يَرِيمَ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" مَنْ فَاتَهُ الرُّكُوعُ فَلا يَعْتَدَّ بِالسُّجُودِ \"","","","","","Book of Prayer"
"3266","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الْعَزِيزِ بْنِ رُفَيْعٍ , عَنْ شَيْخٍ , لِلأَنْصَارِ , قَالَ : دَخَلَ رَجُلٌ الْمَسْجِدَ وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الصَّلاةِ , فَسَمِعَ خَفْقَ نَعْلَيْهِ , فَلَمَّا انْصَرَفَ , قَالَ : \" عَلَى أَيِّ حَالٍ وَجَدْتَنَا ؟ \" , قَالَ : سُجُودًا , فَسَجَدْتُ , قَالَ : \" كَذَلِكَ فَافْعَلُوا , وَلا تَعْتَدُّوا بِالسُّجُودِ , إِلا أَنْ تُدْرِكُوا الرَّكْعَةَ , وَإِذَا وَجَدْتُمُ الإِمَامَ قَائِمًا فَقُومُوا , أَوْ قَاعِدًا فَاقْعُدُوا , أَوْ رَاكِعًا فَارْكَعُوا , أَوْ سَاجِدًا فَاسْجُدُوا , أَوْ جَالِسًا فَاجْلِسُوا \"","","","","","Book of Prayer"
"3267","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ : \" أَنَّ ابْنَ عُمَرَ كَانَ يُدْرِكُ الإِمَامَ سَاجِدًا فَسَجَدَهُمَا مَعَهُ , وَلا يَعْتَدُّ بِهِمَا \"","","","","","Book of Prayer"
"3268","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا رَكَعْتَ قَبْلَ أَنْ يَرْفَعَ الإِمَامُ رَأْسَهُ فَقَدْ أَدْرَكْتَ , فَإِنْ رَفَعَ قَبْلَ أَنْ تَرْكَعَ فَقَدْ فَاتَتْكَ , فَإِنْ أَدْرَكْتَهُ سَاجِدًا فَاسْجُدْ , وَجَالِسًا يَتَشَهَّدُ فَاجْلِسْ وَتَشَهَّدْ , وَلا تَعْتَدَّ بِذَلِكَ \"","","","","","Book of Prayer"
"3269","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ , أَنَّ أَبَا بَكْرَةَ دَخَلَ الْمَسْجِدَ وَالإِمَامُ رَاكِعٌ فَرَكَعَ قَبْلَ أَنْ يَصِلَ إِلَى الصَّفِّ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" زَادَكَ اللَّهُ حِرْصًا فَلا تَعُدْ \" , عَنْ هِشَامٍ , عَنِ الْحَسَنِ , عَنْ أَبِي بَكْرَةَ , عَنِ النَّبِيِّ مِثْلَهُ","","","","","Book of Prayer"
"3270","عَنِ الثَّوْرِيِّ , عَنْ يُونُسَ , عَنِ الْحَسَنِ قَالَ : سَمِعَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَجُلا وَهُوَ يُسْرِعُ إِلَى الصَّلاةِ وَهُوَ رَاكِعٌ , فَقَالَ : \" زَادَكَ اللَّهُ حِرْصًا فَلا تَعُدْ \"","","","","","Book of Prayer"
"3271","عَنِ ابْنِ جُرَيْجٍ , عَنِ الْحَسَنِ , قَالَ : الْتَفَتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَ : \" زَادَكَ اللَّهُ حِرْصًا وَلا تَعُدْ \" , قَالَ : فَثَبَتَ مَكَانَهُ","","","","","Book of Prayer"
"3272","عَنِ ابْنِ جُرَيْجٍ , عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ : \" أَنَّ زَيْدَ بْنَ ثَابِتٍ , كَانَ يَرْكَعُ , ثُمَّ يَتَمَشَّى رَاكِعًا \"","","","","","Book of Prayer"
"3273","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ زَيْدِ بْنِ وَهْبٍ , قَالَ : \" دَخَلْتُ أَنَا وَابْنُ مَسْعُودٍ الْمَسْجِدَ وَالإِمَامُ رَاكِعٌ , فَرَكَعْنَا , ثُمَّ مَضَيْنَا حَتَّى اسْتَوَيْنَا فِي الصَّفِّ , فَلَمَّا فَرَغَ الإِمَامُ قُمْتُ أُصَلِّي , فَقَالَ : قَدْ أَدْرَكْتَهُ \"","","","","","Book of Prayer"
"3274","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنَّ ابْنَ مَسْعُودٍ , قَالَ : لا بَأْسَ أَنْ تَرْكَعَ دُونَ الصَّفِّ \"","","","","","Book of Prayer"
"3275","عَنِ ابْنِ جُرَيْجٍ , عَنْ كَثِيرِ بْنِ كَثِيرٍ , عَنْ أَبِيهِ , عَنِ ابْنِ الزُّبَيْرِ , أَنَّهُ عَلَّمَ النَّاسَ عَلَى الْمِنْبَرِ , يَقُولُ : \" لِيَرْكَعْ ثُمَّ لِيَمْشِ رَاكِعًا , وَإِنَّهُ رَأَى ابْنَ الزُّبَيْرِ يَفْعَلُهُ \"","","","","","Book of Prayer"
"3276","عَنْ يَعْقُوبَ بْنِ عَطَاءٍ , قال : رَأَيْتُ سَعِيدَ بْنَ جُبَيْرٍ يَدْخُلُ وَالإِمَامُ رَاكِعٌ فَيَرْكَعُ , وَمَا خَلَّفَ , ثُمَّ يَمْضِي كَمَا هُوَ , وَهُوَ رَاكِعٌ \"","","","","","Book of Prayer"
"3277","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عُبَيْدُ اللَّهِ بْنُ أَبِي يَزِيدَ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : رَكَعَ بَعْدَ مَا خَلَّفَ النِّسَاءَ \"","","","","","Book of Prayer"
"3278","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : إِذَا دَخَلْتَ وَالإِمَامُ رَاكِعٌ فَارْكَعْ قَبْلَ أَنْ تُخَلِّفَ النِّسَاءَ , ثُمَّ امْشِ رَاكِعًا , فَإِذَا رَفَعَ رَأْسَهُ فَارْفَعْ , ثُمَّ اسْجُدْ حَيْثُ يُدْرِكُكَ السَّجْدَةَ \" , قَالَهُ : غَيْرَ مَرَّةٍ , قَالَ : قُلْتُ لَهُ : سَجَدْتُ فَكَانَتْ لِلإِمَامِ مَثْنًى , قَالَ : \" فَاجْلِسْ مَكَانَكَ , فَإِذَا قَامَ فَاصْفُفْ مَعَ النَّاسِ , فَإِنْ لَمْ يَكُنْ لَهُ مَثْنًى , فَإِذَا سَجَدْتَ فَقُمْ فَاصْفُفْ مَعَ النَّاسِ \" , قَالَ أَبُو بَكْرٍ : \" رَأَيْتُ مَعْمَرًا , وَابْنَ جُرَيْجٍ , وَإِسْمَاعِيلَ بْنَ زِيَادٍ دَخَلُوا , وَالإِمَامُ رَاكِعٌ , فَرَكَعُوا وَمَشَوْا رَاكِعِينَ حَتَّى وَصَلُوا الصَّفَّ \"","","","","","Book of Prayer"
"3279","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنَّ ابْنَ مَسْعُودٍ : \" أَدْرَكَ قَوْمًا جُلُوسًا فِي آخِرِ صَلاتِهِمْ , فَقَالَ : قَدْ أَدْرَكْتُ إِنْ شَاءَ اللَّهُ \"","","","","","Book of Prayer"
"3280","عَنْ إِسْرَائِيلَ , عَنْ عَامِرِ بْنِ شَقِيقٍ , عَنْ شَقِيقِ بْنِ سَلَمَةَ , قال : \" مَنْ أَدْرَكَ التَّشَهُّدَ فَقَدْ أَدْرَكَ الصَّلاةَ \"","","","","","Book of Prayer"
"3281","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ : \" فِي رَجُلٍ انْتَهَى إِلَى قَوْمٍ جُلُوسٍ فِي آخِرِ صَلاتِهِمْ , قَالَ : يَجْلِسُ مَعَهُمْ وَلا يُكَبِّرْ \"","","","","","Book of Prayer"
"3282","عَنِ الثَّوْرِيِّ , قَالَ : أَخْبَرَنِي مَنْ , سَمِعَ الْحَسَنَ , قال : \" إِذَا انْتَهَى إِلَيْهِمْ وَهُمْ سُجُودٌ سَجَدَ مَعَهُمْ وَكَبَّرَ , فَإِنْ كَانَ فِي مَثْنًى قَامَ فِي تَكْبِيرَةٍ أُخْرَى , وَإِنْ كَانَ فِي وِتْرٍ قَامَ بِغَيْرِ تَكْبِيرٍ \"","","","","","Book of Prayer"
"3283","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ فِي رَجُلٍ دَخَلَ وَالإِمَامُ سَاجِدٌ , أَوْ حِينَ رَفَعَ رَأْسَهُ مِنَ الرَّكْعَةِ , أَوْ جَالِسًا يَتَشَهَّدُ , يُكَبِّرُ تَكْبِيرَةَ اسْتِفْتَاحِ الصَّلاةِ , قال : \" إِنْ شَاءَ يُكَبِّرُ , وَإِنْ شَاءَ فَلا يُكَبِّرُ , وَلَكِنْ إِذَا قَامَ وَسَلَّمَ الإِمَامُ فَيُكَبِّرُ وَيَسْتَفْتِحُ \"","","","","","Book of Prayer"
"3284","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" قُلْتُ : رَجُلٌ جَاءَ وَقَدْ رَكَعَ الإِمَامُ آخِرَ رَكْعَةٍ مِنَ الْمَكْتُوبَةِ , فَسَجَدَ مَعَهُ سَجْدَتَيْنِ , وَتَشَهَّدَ مَعَ الإِمَامِ , فَسَلَّمَ الإِمَامُ , أَلا يَتَكَلَّمُ الرَّجُلُ إِنْ شَاءَ حِينَئِذٍ وَيَذْهَبُ إِلَى مُصَلًّى آخَرٍ ؟ , قَالَ : بَلَى , قَدْ فَاتَتْهُ الرَّكْعَةُ , فَلْيَتَكَلَّمْ إِنْ شَاءَ فَلَمْ يَكُنْ فِي صَلاتِهِ \"","","","","","Book of Prayer"
"3285","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : \" فِي الرَّجُلِ يَأْتِي وَقَدْ سَلَّمَ الإِمَامُ وَهُوَ يَدْعُو , أَيَسْتَفْتِحُ ؟ , قَالَ : يَجْلِسُ مَا كَانَ الإِمَامُ جَالِسًا \"","","","","","Book of Prayer"
"3286","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ , عَنِ ابْنِ مَسْعُودٍ : أَنَّهُ كَانَ يَقُولُ : \" إِذَا وَجَدْتَ الإِمَامَ وَالنَّاسُ جُلُوسٌ فِي آخِرِ الصَّلاةِ فَكَبِّرْ قَائِمًا , ثُمَّ اجْلِسْ وَكَبِّرْ حِينَ تَجْلِسُ , فَتِلْكَ تَكْبِيرَتَانِ , الأُولَى وَأَنْتَ قَائِمٌ لاسْتِفْتَاحِ الصَّلاةِ , وَالأُخْرَى حِينَ تَجْلِسُ كَأَنَّهَا لِلسَّجْدَةِ , ثُمَّ لا تَكَلَّمْ فَقَدْ وَجَبَ عَلَيْكَ الصَّلاةُ , وَاسْتَفْتَحْتَ فِيهَا , وَلَكِنْ لا تَعْتَدَّ بِجُلُوسِكَ مَعَهُمْ , وَقُلْ كَمَا يَقُولُونَ وَأَنْتَ جَالِسٌ مَعَهُمْ \"","","","","","Book of Prayer"
"3287","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ بْنُ كَثِيرٍ , قَالَ : \" رَأَيْتُ سَعِيدَ بْنَ جُبَيْرٍ يَدْخُلُ وَالإِمَامُ رَاكِعٌ , فَيَرْكَعُ وَمَا خَلَّفَ النِّسَاءَ , ثُمَّ يَمْضِي كَمَا هُوَ \"","","","","","Book of Prayer"
"3288","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ : \" أَنَّ ابْنَ عُمَرَ كَانَ إِذَا أَدْرَكَ مَعَ الإِمَامِ سَجْدَةً سَجَدَ إِلَيْهَا أُخْرَى , وَإِذَا فَرَغَ مِنْ صَلاتِهِ سَجَدَ سَجْدَتَيِ السَّهْوِ \" , عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ عُمَرَ مِثْلَهُ . عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ مِثْلَهُ أَنَّ ابْنَ عُمَرَ , كَانَ يَفْعَلُ ذَلِكَ , قَالَ الزُّهْرِيُّ : \" وَلَمْ أَعْلَمْ أَحَدًا فَعَلَهُ أَصْلا \"","","","","","Book of Prayer"
"3289","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيَّبِ , عَنْ أَبِي هُرَيْرَةَ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" مَا أَدْرَكْتُمْ فَصَلُّوا , وَمَا فَاتَكُمْ فَاقْضُوا , وَلَمْ يَذْكُرْ سُجُودًا \"","","","","","Book of Prayer"
"3290","عَنْ عُثْمَانَ بْنِ مَطَرٍ , عَنْ سَعِيدٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ . وَعَنْ أَبِي مَعْشَرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ , وَعَنْ أَبِي مَعْشَرٍ , عَنْ إِبْرَاهِيمَ , قَالا : \" إِذَا أَدْرَكْتَ مَعَ الإِمَامِ سَجْدَةً فَاسْجُدْ مَعَهُ , ثُمَّ انْهَضْ بِهَا وَلا تَزِدْ إِلَيْهَا , وَلا تَعْتَدَّ بِهَا \"","","","","","Book of Prayer"
"3291","عَنِ الثَّوْرِيِّ , قال : \" إِذَا أَدْرَكَتَ الإِمَامَ سَاجِدًا , فَإِنَّهُ يُكَبِّرُ تَكْبِيرَةً , وَيَنْوِي بِهَا افْتِتَاحَ الصَّلاةِ , وَيَسْجُدُ مَعَهُمْ , وَلَكِنَّهُ إِذَا قَامَ كَبَّرَ \"","","","","","Book of Prayer"
"3292","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : \" إِذَا كَانَ أَحَدُكُمْ مُقْبِلا إِلَى الصَّلاةِ فَأُقِيمَتِ الصَّلاةُ فَلْيَمْشِ عَلَى رِسْلِهِ , فَإِنَّهُ فِي صَلاةٍ , فَمَا أَدْرَكَ فَصَلَّى , وَمَا فَاتَهُ فَلْيَقْضِهِ بَعْدُ \" , قَالَ عَطَاءٌ : \" وَإِنِّي لأَجِدُهُ أَنَا \" , قُلْتُ : فَلا تَعْجَلُ إِذَا أُقِيمَتْ , وَإِنْ كُنْتَ تَتَوَضَّأُ وَتَغْتَسِلُ ؟ , قَالَ : \" نَعَمْ , لا أَعْجَلُ عَنْ ذَلِكَ \"","","","","","Book of Prayer"
"3293","عَنْ مَعْمَرٍ , عَنْ هَمَّامِ بْنِ مُنَبِّهٍ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا نُودِيَ بِالصَّلاةِ فَأْتُوهَا وَأَنْتُمْ تَمْشُونَ وَعَلَيْكُمُ السَّكِينَةُ , فَمَا أَدْرَكْتُمْ فَصَلُّوا , وَمَا فَاتَكُمْ فَأَتِمُّوا \"","","","","","Book of Prayer"
"3294","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيَّبِ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا أُقِيمَتْ فَلا تَأْتُوهَا تَسْعَوْنَ , وَلَكِنِ ائِتُوهَا وَأَنْتُمْ تَمْشُونَ , وَعَلَيْكُمُ السَّكِينَةُ , فَمَا أَدْرَكْتُمْ فَصَلُّوا , وَمَا فَاتَكُمْ فَأَتِمُّوا \"","","","","","Book of Prayer"
"3295","عَنِ الثَّوْرِيِّ , عَنْ سَعْدِ بْنِ إِبْرَاهِيمَ , قَالَ : حَدَّثَنِي عُمَرُ بْنُ أَبِي سَلَمَةَ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَنْ أَتَى مِنْكُمُ الصَّلاةَ فَلْيَأْتِهَا بِوَقَارٍ وَسَكِينَةٍ , فَلْيُصَلِّ مَا أَدْرَكَ , وَلْيَقْضِ مَا فَاتَهُ أَوْ سَبَقَهُ \"","","","","","Book of Prayer"
"3296","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ حُمَيْدٍ الطَّوِيلِ , قَالَ : سَمِعْتُ أَنَسَ بْنَ مَالِكٍ , يَقُولُ : دَخَلَ رَجُلٌ وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي وَلَهُ نَفَسٌ , فَقَالَ : الْحَمْدُ لِلَّهِ كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ , فَلَمَّا فَرَغَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنْ صَلاتِهِ قَالَ : \" مَنْ صَاحِبُ الْكَلِمَاتِ ؟ \" مَرَّتَيْنِ , فَقَامَ إِلَيْهِ رَجُلٌ , فَقَالَ : أَنَا يَا رَسُولَ اللَّهِ , قَالَ : \" لَقَدِ ابْتَدَرَهَا اثَنَا عَشْرَ مِلَكًا أَيُّهُمْ يَسْبِقُ بِهَا , فَيُحَيِّي بِهَا اللَّهَ تَبَارَكَ وَتَعَالَى \" , قَالَ : \" فَمَا لِي أَسْمَعُ نَفَسَكَ ؟ \" , قَالَ : أُقِيمَتِ الصَّلاةُ , فَأَسْرَعْتُ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا سَمِعْتَ الإِقَامَةَ فَامْشِ عَلَى هِينَتِكَ , فَمَا أَدْرَكْتَ فَصَلِّ , وَمَا فَاتَكَ فَاقْضِ \"","","","","","Book of Prayer"
"3297","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , قَالَ : سَمِعْتُ ثَابِتًا الْبُنَانِيَّ , يَقُولُ : وَأَنَسُ بْنُ مَالِكٍ وَاضِعٌ يَدَهُ عَلَيَّ , أُقِيمَتِ الصَّلاةُ قَالَ : فَجَعَلْتُ أَهَابُهُ أَنْ أَرْفَعَ يَدَهُ عَنِّي , وَجَعَلَ يُقَارِبُ بَيْنَ الْخُطَى , فَانْتَهَيْنَا إِلَى الْمَسْجِدِ , وَقَدْ سُبِقْنَا بِرَكْعَةٍ , وَقَدْ صَلَّيْنَا مَعَ الإِمَامِ وَقَضَيْنَا مَا كَانَ فَاتَنَا , فَقَالَ لِي أَنَسُ بْنُ مَالِكٍ : \" يَا ثَابِتُ , اعْمَلْ بِالَّذِي صَنَعْتُ بِكَ \" , قُلْتُ : نَعَمْ , قَالَ : \" صَنَعَهُ بِي أَخِي زَيْدُ بْنُ ثَابِتٍ \"","","","","","Book of Prayer"
"3298","عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" كَانَ الأَسْوَدُ يُهَرْوِلُ إِلَى الصَّلاةِ \"","","","","","Book of Prayer"
"3299","عَنِ الثَّوْرِيِّ , عَنْ عَمْرِو بْنِ قَيْسٍ الْمُلائِيِّ , عَنْ سَلَمَةَ بْنِ كُهَيْلٍ , أَنَّ ابْنَ مَسْعُودٍ , سَعَى إِلَى الصَّلاةِ , فَقِيلَ لَهُ : فَقال : أَوَ لَيْسَ أَحَقَّ مَا سَعَيْتُ إِلَيْهِ الصَّلاةُ \"","","","","","Book of Prayer"
"3300","عَنْ مَالِكٍ , عَنْ نَافِعٍ : \" أَنَّ ابْنَ عُمَرَ سَمِعَ الإِقَامَةَ وَهُوَ بِالْبَقِيعِ , فَأَسْرَعَ الْمَشْيَ إِلَى الْمَسْجِدِ \"","","","","","Book of Prayer"
"3301","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ رَجُلٍ , عَنْ أَبِي ذَرٍّ , قَالَ : مَنْ أَقْبَلَ يَشْهَدُ فِي الصَّلاةِ , فَأُقِيمَتْ وَهُوَ فِي الطَّرِيقِ , فَلا يُسْرِعْ , وَلا يَزِدْ عَلَى مِشْيَتِهِ الأُولَى , فَمَا أَدْرَكَ فَلْيُصَلِّ مَعَ الإِمَامِ , وَمَا لَمْ يُدْرِكْ فَلْيُتِمَّهُ \" , عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ رَجُلٍ مِنْ بَنِي غِفَارٍ , عَنْ أَبِي نَضْرَةَ , عَنْ أَبِي ذَرٍّ مِثْلَهُ , ذَكَرَهُ ابْنُ جُرَيْجٍ , عَنْ عَمْرٍو , عَنْ رَجُلٍ , عَنْ أَبِي ذَرٍّ","","","","","Book of Prayer"
"3302","عَنِ ابْنِ جُرَيْجٍ , قال : \" قُلْتُ لِعَطَاءٍ : نَفَرٌ دَخَلُوا مَسْجِدَ مَكَّةَ خِلافَ الصَّلاةِ لَيْلا أَوْ نَهَارًا يُنْكِرُونَ ذَلِكَ الآنَ \"","","","","","Book of Prayer"
"3303","عَنْ مَعْمَرٍ , عَنْ أَبِي عُثْمَانَ , قَالَ : \" مَرَّ بِنَا أَنَسُ بْنُ مَالِكٍ وَمَعَهُ أَصْحَابٌ لَهُ , فَقَالَ : أَصَلَّيْتُمْ ؟ , قُلْنَا : نَعَمْ , قَالَ : فَنَزَلَ فَأَمَّ أَصْحَابَهُ , فَتَقَدَّمَ فَصَلَّى بِهِمْ , قَالَ أَبُو عُثْمَانَ : ثُمَّ جَلَسَ فَوَضَعْنَا لَهُ طِنْفِسَةً وَوِسَادَتَيْنِ , فَحَدَّثَنَا حَدِيثًا حَسَنًا عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , ثُمَّ رَكِبَ فَانْطَلَقَ \"","","","","","Book of Prayer"
"3304","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , قَالَ : حَدَّثَنَا الْجَعْدُ أَبُو عُثْمَانَ , قَالَ : \" مَرَّ بِنَا أَنَسُ بْنُ مَالِكٍ وَمَعَهُ أَصْحَابٌ لَهُ زُهَاءَ عَشَرَةٍ , وَقَدْ صَلَّيْنَا صَلاةَ الْغَدَاةِ , فَقَالَ : أَصَلَّيْتُمْ ؟ , قُلْنَا : نَعَمْ , قَالَ : فَأَمَرَ بَعْضَهُمْ فَأَذَّنَ , وَصَلَّى رَكْعَتَيْنِ , ثُمَّ أَمَرَهُ فَأَقَامَ , ثُمَّ تَقَدَّمَ فَصَلَّى رَكْعَتَيْنِ أَنَسٌ بِأَصْحَابِهِ , ثُمَّ انْصَرَفَ , وَقَدْ أَلْقَوْا لَهُ وِسَادَةً وَمِرْفَقَةً , فَحَدَّثَنَا , فَكَانَ مِمَّا حَدَّثَنَا بِهِ , قَالَ : جَاءَتْ أُمِّي أُمُّ سُلَيْمٍ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَقَالَتْ : يَا رَسُولَ اللَّهِ , بِأُمِّي وَأَبِي أَنْتَ يَا رَسُولَ اللَّهِ , لَوْ دَعَوْتَ لَهُ , فَقَالَ : \" قَدْ دَعَوْتُ لَهُ بِثَلاثِ دَعَوَاتٍ , قَدْ رَأَيْتُ اثْنَتَيْنِ وَأَنَا أَرْجُو الثَّالِثَةَ \"","","","","","Book of Prayer"
"3305","عَنِ الثَّوْرِيِّ , عَنْ يُونُسَ بْنِ عُبَيْدٍ , عَنِ الْجَعْدِ أَبِي عُثْمَانَ , قَالَ : \" جَاءَ أَنَسٌ عِنْدَ الْفَجْرِ وَقَدْ صَلَّيْنَا , فَأَذَّنَ وَأَقَامَ وَأَمَّ أَصْحَابَهُ \"","","","","","Book of Prayer"
"3306","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ يَزِيدَ , قال : \" أَمَّنِي إِبْرَاهِيمُ فِي مَسْجِدٍ قَدْ صَلَّى فِيهِ , فَأَقَامَنِي عَنْ يَمِينِهِ بِغَيْرِ أَذَانٍ وَلا إِقَامَةٍ \"","","","","","Book of Prayer"
"3307","قَالَ الثَّوْرِيِّ وَأَمَّا الْحَسَنُ بن عمرو فأخبرني : \" أَنَّ إِبْرَاهِيمَ كَرِهَ أَنْ يَؤُمَّهُمْ فِي مَسْجِدٍ قَدْ صَلَّى فِيهِ \"","","","","","Book of Prayer"
"3308","عَنْ مَعْمَرٍ , قال : \" صَحِبْتُ أَيُّوبَ مِنْ مَكَّةَ إِلَى الْبَصْرَةِ , فَأَتَيْنَا مَسْجِدَ أَهْلِ مَاءٍ قَدْ صَلَّى فِيهِ , فَأَذَّنَ أَيُّوبُ وَأَقَامَ , ثُمَّ تَقَدَّمَ فَصَلَّى بِنَا \"","","","","","Book of Prayer"
"3309","عَنِ ابْنِ التَّيْمِيِّ , عَنْ لَيْثٍ , قال : \" دَخَلْتُ مَعَ ابْنِ سَابِطٍ فَسَجَدَ بَعْضُنَا وَنَهَى بَعْضَنَا لِلسُّجُودِ , فَلَمَّا سَلَّمَ قَامَ ابْنُ سَابِطٍ فَصَلَّى بِأَصْحَابِهِ , فَقَالَ : ذَكَرْتُ لِعَطَاءٍ , فَقَالَ : كَذَلِكَ يَنْبَغِي , قَالَ : قُلْتُ : إِنَّ هَذَا لا يُفْعَلُ عِنْدَنَا , قَالَ : يَفْرِقُونَ \"","","","","","Book of Prayer"
"3310","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ فِي الْقَوْمِ يَدْخُلُونَ الْمَسْجِدَ فَيُدْرِكُونَ مَعَ الإِمَامِ رَكْعَةً , قال : \" يَقُومُونَ فَيَقْضُونَ مَا بَقِيَ عَلَيْهِمْ , يَؤُمُّهُمْ أَحَدُهُمْ وَهُوَ قَائِمٌ مَعَهُمْ فِي الصَّفِّ , يُصَلُّونَ بِصَلاتِهِ \" , قَالَ : وَقَالَ الْحَسَنُ : \" يَقْضُونَ وُحْدَانًا \"","","","","","Book of Prayer"
"3311","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ فِي قَوْمٍ انْتَهُوا إِلَى مَسْجِدٍ , وَقَدْ صُلِّيَ فِيهِ , قال : \" يُصَلُّونَ بِإِقَامَةٍ , وَيَقُومُ إِمَامُهُمْ مَعَهُمْ فِي الصَّفِّ \"","","","","","Book of Prayer"
"3312","عَنْ مَعْمَرٍ , عَنْ غَيْرِ وَاحِدٍ , عَنِ الْحَسَنِ , قال : يُصَلُّونَ فُرَادَى \" ذَكَرَهُ عَنْ حَفْصِ بْنِ سُلَيْمَانَ","","","","","Book of Prayer"
"3313","عَنِ الثَّوْرِيِّ , عَنْ يُونُسَ , عَنِ الْحَسَنِ , قال : \" يُصَلُّونَ وُحْدَانًا وَبِهِ يَأْخُذُ الثَّوْرِيُّ \" , قَالَ عَبْدُ الرَّزَّاقِ : \" وَبِهِ نَأْخُذُ أَيْضًا \"","","","","","Book of Prayer"
"3314","عَنِ الثَّوْرِيِّ , عَنْ سُلَيْمَانَ , عَنْ أَبِي عُثْمَانَ النَّهْدِيِّ , قَالَ : رَأَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَجُلا يُصَلِّي وَحْدَهُ , فَقَالَ : \" مَنْ يَتَصَدَّقُ عَلَى هَذَا فَيُصَلِّيَ مَعَهُ \"","","","","","Book of Prayer"
"3315","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنْ سُلَيْمَانَ , عَنْ أَبِي عُثْمَانَ النَّهْدِيِّ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رَأَى رَجُلا يُصَلِّي وَحْدَهُ فَقَالَ : \" أَلا أَحَدٌ يَحْتَسِبُ عَلَى هَذَا فَيُصَلِّيَ مَعَهُ ؟ \"","","","","","Book of Prayer"
"3316","عَنِ ابْنِ التَّيْمِيِّ , عَنْ لَيْثٍ , عَنْ طَاوُسٍ , وَعَطَاءٍ , وَمُجَاهِدٍ , قَالُوا : \" إِذَا دَخَلْتَ مَسْجِدًا قَدْ صُلِّيَ فِيهِ فَأَقِمِ الصَّلاةَ وَصَلِّ , أُقِيمَتِ الصَّلاةُ أَوْ لَمْ تُقَمْ \"","","","","","Book of Prayer"
"3317","عَنْ مَعْمَرٍ , عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى , قال : \" لِيُصَلِّ فِيهِ بِغَيْرِ أَذَانٍ وَلا إِقَامَةٍ \"","","","","","Book of Prayer"
"3318","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" إِذَا دَخَلَ الرَّجُلانِ الْمَسْجِدَ خِلافَ الصَّلاةِ صَلَّيَا جَمِيعًا أَمَّ أَحَدُهُمَا صَاحِبَهُ \"","","","","","Book of Prayer"
"3319","عَنْ مَعْمَرٍ , عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ , قَالَ : سَمِعْتُ رَجُلا يَسْأَلُ عَبْدَ الرَّحْمَنِ بْنَ أَبِي لَيْلَى , قَالَ : جِئْتُ إِلَى قَوْمٍ وَقَدْ صَلَّوْا أَفَأُقِيمُ ؟ , قَالَ : \" قَدْ كُفِيتَ \" , قَالَ : أَتَطَوَّعُ ؟ , قَالَ : \" ابْدَأْ بِالَّذِي جِئْتَ لَهُ \"","","","","","Book of Prayer"
"3320","عَنْ مَعْمَرٍ , وَقَتَادَةَ : \" إِنْ لَمْ يَسْمَعْ أَقَامَ وَصَلَّى \"","","","","","Book of Prayer"
"3321","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , قَالَ : \" كَانَ ابْنُ عُمَرَ إِذَا انْتَهَى إِلَى الْمَسْجِدِ وَقَدْ صُلِّيَ فِيهِ بَدَأَ بِالْفَرِيضَةِ \"","","","","","Book of Prayer"
"3322","عَنْ مَالِكٍ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِذَا أَتَيْتَ الْمَسْجِدَ فَوَجَدْتَهُمْ قَدْ صَلَّوْا فَلا تُصَلِّ إِلا الْمَكْتُوبَةَ \"","","","","","Book of Prayer"
"3323","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَ نَافِعٌ , عَنِ ابْنِ عُمَرَ , أَنَّهُ قَالَ : \" اقْضِ مَا عَلَيْكَ وَاجِبًا خَيْرًا لَكَ , ابْدَأْ بِالْمَكْتُوبَةِ \"","","","","","Book of Prayer"
"3324","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلَ إِنْسَانٌ عَطَاءً , قَالَ : وَقَدْ صَلَّى الإِمَامُ الْمَكْتُوبَةَ فَأَرْكَعُ قَبْلَ أَتَيْتُ الْمَسْجِدَ أَنْ أُصَلِّيَ رَكْعَتَيْنِ رَكْعَتَيْنِ ؟ , قَالَ \" بَلِ ابْدَأْ بِالْمَكْتُوبَةِ , فَالْحَقُّ قَبْلُ , ثُمَّ صَلِّ بَعْدُ مَا بَدَا لَكَ \" , قُلْتُ : فَأَمَّا فِي بَادِيَتِي ؟ , قَالَ : \" فَصَلِّ قَبْلَهَا إِنْ شِئْتَ فِي بَادِيَتِكَ \"","","","","","Book of Prayer"
"3325","عَنِ الثَّوْرِيِّ , عَنِ الزُّبَيْرِ , وَالأَعْمَشِ , وَمُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : إِذَا أَتَيْتَ الْمَسْجِدَ وَقَدْ صَلَّوْا فَابْدَأْهَا بِالْمَكْتُوبَةِ \"","","","","","Book of Prayer"
"3326","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ عَوْنٍ , عَنِ الشَّعْبِيِّ , قال : \" ابْدَأْ بِالَّذِي طَلَبْتَ \"","","","","","Book of Prayer"
"3327","عَنْ هِشَامِ بْنِ حَسَّانَ , سَمِعْتُهُ يُحَدِّثُ , عَنِ الْحَسَنِ , قال : \" ابْدَأْ بِالْمَكْتُوبَةِ إِلا رَكْعَتَيِ الْفَجْرِ \"","","","","","Book of Prayer"
"3328","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : \" صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ أَوِ الْعَصْرَ , فَسَهَا فِي رَكْعَتَيْنِ وَانْصَرَفَ \" , فَقَالَ لَهُ : ذُو الشِّمَالَيْنِ ابْنُ عَبْدِ عَمْرٍو , وَكَانَ حَلِيفًا لِبَنِي زُهْرَةَ أَخُفِّفَتِ الصَّلاةُ أَوْ نَسِيتَ ؟ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَا يَقُولُ ذُو الْيَدَيْنِ ؟ \" , فَقَالُوا : صَدَقَ يَا نَبِيَّ اللَّهِ , فَأَتَمَّ بِهِمُ الرَّكْعَتَيْنِ اللَّتَيْنِ نَقَصَ , قَالَ الزُّهْرِيُّ : \" وَكَانَ ذَلِكَ قَبْلَ بَدْرٍ , ثُمَّ اسْتَحْكَمَتِ الأُمُورُ بَعْدُ \"","","","","","Book of Prayer"
"3329","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , عَنْ أَبِي بَكْرِ بْنِ سُلَيْمَانَ بْنِ أَبِي حَثْمَةَ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى رَكْعَتَيْنِ فِي صَلاةِ الْعَصْرِ , أَوْ صَلاةِ الظُّهْرِ , ثُمَّ سَلَّمَ , فَقَالَ لَهُ ذُو الشِّمَالَيْنِ بْنُ عَبْدِ عَمْرٍو : يَا نَبِيَّ اللَّهِ , أَقَصُرَتِ الصَّلاةُ أَمْ نَسِيتَ ؟ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لَمْ تُقْصَرْ وَلَمْ أَنْسَ \" , فَقَالَ لَهُ ذُو الشِّمَالَيْنِ : بَلَى بِأَبِي , يَا نَبِيَّ اللَّهِ , قَدْ كَانَ بَعْضُ ذَلِكَ , فَالْتَفَتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِلَى النَّاسِ فَقَالَ : \" أَصَدَقَ ذُو الْيَدَيْنِ ؟ \" , قَالُوا : نَعَمْ , يَا نَبِيَّ اللَّهِ , فَقَامَ إِلَى الصَّلاةِ حِينَ اسْتَيْقَنَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","","","","","Book of Prayer"
"3330","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي عَطَاءٌ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى مَرَّةً بَعْضَ الأَرْبَعِ , فَصَلَّى رَكْعَتَيْنِ ثُمَّ سَلَّمَ , فَقَامَ إِلَيْهِ رَجُلٌ , فَقَالَ : أَخَفَّفْتَ عَنَّا مِنَ الصَّلاةِ , يَا نَبِيَّ اللَّهِ ؟ , قَالَ : وَمَا ذَاكَ ؟ , قَالَ : سَلَّمْتَ فِي رَكْعَتَيْنِ , قَالَ : لا , ثُمَّ قَامَ فَرَكَعَ رَكْعَتَيْنِ أَوْفَى بِهِمَا , وَلَمْ يَسْتَقْبِلِ الصَّلاةَ وَافِيَةً , فَلَمَّا سَلَّمَ سَجَدَ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3331","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنِ عُبَيْدِ اللَّهِ بْنِ أَبِي مُلَيْكَةَ , أَنَّهُ سَمِعَ عُبَيْدَ بْنَ عُمَيْرٍ يَقُصُّ هَذَا الْخَبَرَ , قَالَ : صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْعَصْرَ رَكْعَتَيْنِ , ثُمَّ سَلَّمَ وَانْصَرَفَ إِلَى أَهْلِهِ , قُلْتُ : وَوَلَّى ؟ , قَالَ : وَوَلَّى , فَأَدْرَكَهُ ذُو الْيَدَيْنِ أَخُو بَنِي سُلَيْمٍ , قَالَ : يَا نَبِيَّ اللَّهِ , أَنَسِيتَ أَمْ خَفَّفْتَ عَنَّا الصَّلاةَ ؟ , قَالَ : \" وَمَا ذَاكَ ؟ \" , قَالَ : صَلَّيْتَ الْعَصْرَ رَكْعَتَيْنِ , قَالَ : \" أَصَدَقَ ذُو الْيَدَيْنِ أَخُو بَنِي سُلَيْمٍ ؟ \" , قَالَ النَّاسُ : نَعَمْ , قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" حَيَّ عَلَى الْفَلاحِ , حَيَّ عَلَى الْفَلاحِ \" , قَدْ قَامَتِ الصَّلاةُ , ثُمَّ صَلَّى بِهِمْ رَكْعَتَيْنِ , ثُمَّ انْصَرَفَ","","","","","Book of Prayer"
"3332","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , قَالَ : سَمِعْتُ طَاوُسًا , يَقُولُ : صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , ثُمَّ سَلَّمَ فَقَالَ لَهُ رَجُلٌ : نَسِيتَ يَا نَبِيَّ اللَّهِ , أَمْ خَفَّفْتَ عَنَّا الصَّلاةَ ؟ , قَالَ : \" مَا قَالَ ذُو الْيَدَيْنِ ؟ \" , قَالُوا : نَعَمْ , فَعَادَ فَصَلَّى مَا بَقِيَ قَطُّ , قَالَ : حَدَّثَكَ أَنَّهُ سَجَدَ سَجْدَتَيْنِ بَعْدَمَا سَلَّمَ ؟ , قَالَ : \" لا أَعْلَمُ \"","","","","","Book of Prayer"
"3333","عَنْ مَعْمَرٍ , وَابْنِ جُرَيْجٍ , قَالا : أَخْبَرَنَا ابْنُ طَاوُسٍ , عَنْ أَبِيهِ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى بَعْضَ الأَرْبَعِ فَسَلَّمَ فِي سَجْدَتَيْنِ , فَقَالَ لَهُ ذُو الْيَدَيْنِ : أَنَسِيتَ أَمْ خَفَّفْتَ عَنَّا يَا نَبِيَّ اللَّهِ ؟ , قَالَ : أَوَ فَعَلْتُ ؟ , قَالُوا : نَعَمْ , فَعَادَ فَصَلَّى رَكْعَتَيْنِ ثُمَّ سَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3334","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الظُّهْرَ أَوِ الْعَصْرِ فَسَلَّمَ فِي رَكْعَتَيْنِ , ثُمَّ انْصَرَفَ , فَخَرَجَ سَرْعَانُ النَّاسِ \" , فَقَالُوا : أَخَفَّفْتَ عَنَّا الصَّلاةَ ؟ , قَالَ ذُو الشِّمَالَيْنِ : يَا رَسُولَ اللَّهِ , أَخَفَّفْتَ الصَّلاةَ ؟ , قَالَ : فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَا يَقُولُ ذُو الْيَدَيْنِ ؟ \" , قَالُوا : صَدَقَ , قَالَ : \" فَصَلَّى الرَّكْعَتَيْنِ اللَّتَيْنِ تَرَكَ , ثُمَّ سَجَدَ سَجْدَتَيْنِ بَعْدَمَا سَلَّمَ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3335","عَنْ مَالِكٍ , عَنْ دَاوُدَ بْنِ الْحُصَيْنِ , عَنْ أَبِي سُفْيَانَ مَوْلَى ابْنِ أَبِي أَحْمَدَ , أَنَّهُ قَالَ : سَمِعْتُ أَبَا هُرَيْرَةَ , يَقُولُ : صَلَّى رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الْعَصْرِ , فَسَلَّمَ فِي رَكْعَتَيْنِ , فَقَامَ ذُو الْيَدَيْنِ , فَقَالَ : أَقَصُرَتِ الصَّلاةُ , يَا رَسُولَ اللَّهِ أَمْ نَسِيتَ ؟ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" كُلُّ ذَلِكَ لَمْ يَكُنْ \" , قَالَ : قَدْ كَانَ بَعْضُ ذَلِكَ يَا رَسُولَ اللَّهِ , فَأَقْبَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى النَّاسِ فَقَالَ : \" أَصَدَقَ ذُو الْيَدَيْنِ ؟ \" , فَقَالُوا : نَعَمْ , فَقَامَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأَتَمَّ مَا بَقِيَ مِنَ الصَّلاةِ , ثُمَّ سَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ بَعْدَ التَّسْلِيمِ","","","","","Book of Prayer"
"3336","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ , عَنْ عَبْدِ اللَّهِ بْنِ بُحَيْنَةَ , قَالَ : \" صَلَّى لَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِحْدَى صَلاتَيِ الْعَشِيِّ , فَقَامَ فِي رَكْعَتَيْنِ فَلَمْ يَجْلِسْ , فَلَمَّا كَانَ فِي آخِرِ صَلاتِهِ انْتَظَرْنَا أَنْ يُسَلِّمَ فَسَجَدَ سَجْدَتَيْنِ قَبْلَ التَّسْلِيمِ , ثُمَّ سَلَّمَ \"","","","","","Book of Prayer"
"3337","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ , عَنِ ابْنِ بُحَيْنَةَ الأَسْدِيِّ حَلِيفُ بَنِي عَبْدِ الْمُطَّلِبِ , \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَامَ فِي الظُّهْرِ وَعَلَيْهِ جُلُوسٌ , فَلَمَّا أَتَمَّ صَلاتَهُ سَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ قَبْلَ أَنْ يُسَلِّمَ , كَبَّرَ فِي كُلِّ سَجْدَةٍ , وَسَجَدَهُمَا النَّاسُ مَعَهُ مَكَانَ مَا نَسِيَ مِنَ الْجُلُوسِ \"","","","","","Book of Prayer"
"3338","عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ , عَنْ عَبْدِ اللَّهِ بْنِ بُحَيْنَةَ , قَالَ : \" قَامَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ مِنَ الظُّهْرِ أَوِ الْعَصْرِ , فَلَمْ يَجْلِسْ , فَلَمَّا قَضَى صَلاتَهُ سَجَدَ سَجْدَتَيْنِ قَبْلَ أَنْ يُسَلِّمَ \"","","","","","Book of Prayer"
"3339","عَنِ الثَّوْرِيِّ , عَنِ ابْنِ أَبِي لَيْلَى , عَنِ الشَّعْبِيِّ , عَنِ الْمُغِيرَةِ بْنِ شُعْبَةَ : \" أَنَّهُ قَامَ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ فَسَبَّحُوا بِهِ فَلَمْ يَجْلِسْ , فَلَمَّا قَضَى صَلاتَهُ سَجَدَ سَجْدَتَيْنِ بَعْدَ التَّسْلِيمِ , ثُمَّ قَالَ : هَكَذَا فَعَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \"","","","","","Book of Prayer"
"3340","أَخْبَرَنَا مَعْمَرٌ , وَابْنُ عُيَيْنَةَ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , عَنْ عِمْرَانَ بْنِ الْحُصَيْنِ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" التَّسْلِيمُ بَعْدَ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3341","عَنْ مَعْمَرٍ , عَنِ الْحَسَنِ , وَقَتَادَةَ , قَالا : \" سَجْدَتَيِ السَّهْوِ بَعْدَ التَّسْلِيمِ \"","","","","","Book of Prayer"
"3342","عَنِ الثَّوْرِيِّ , عَنِ الْحَسَنِ بْنِ عُبَيْدِ اللَّهِ , عَنْ إِبْرَاهِيمَ , عَنْ عَلْقَمَةَ : \" أَنَّهُ صَلَّى خَمْسًا , فَقَالَ لَهُ : يَا أَبَا شِبْلٍ , إِنَّكَ صَلَّيْتَ خَمْسًا , قَالَ : وَتَقُولُ أَنْتَ ذَلِكَ لإِبْرَاهِيمَ يَا أَعْوَرُ , قَالَ : قُلْتُ : نَعَمْ , قَالَ : \" فَثَنَى رِجْلَهُ فَسَجَدَ سَجْدَتَيْنِ , ثُمَّ قَالَ : هَكَذَا فَعَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \"","","","","","Book of Prayer"
"3343","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَسْوَدِ , عَنِ الأَسْوَدِ بْنِ يَزِيدَ , عَنْ عَبْدِ اللَّهِ بْنِ مَسْعُودٍ , أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلَّى الظُّهْرَ أَوِ الْعَصْرِ خَمْسًا , ثُمَّ سَجَدَ سَجْدَتَيِ السَّهْوِ , ثُمَّ قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" هَاتَانِ السَّجْدَتَانِ لِمَنْ ظَنَّ مِنْكُمْ , أَنَّهُ زَادَ أَوْ نَقَصَ \"","","","","","Book of Prayer"
"3344","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ فِي رَجُلٍ صَلَّى الظُّهْرَ خَمْسًا , قال : \" يَسْجُدُ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3345","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ الزُّهْرِيَّ , عَنْ رَجُلٍ صَلَّى الظُّهْرَ خَمْسًا هُوَ يَسْجُدُ سَجْدَتَيْنِ \" , عَنْ مَعْمَرٍ , وَأَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ , أَنَّهُ يَقُولُ مِثْلَهُ","","","","","Book of Prayer"
"3346","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ فِي رَجُلٍ صَلَّى الظُّهْرَ خَمْسًا , قال : \" يَزِيدُ إِلَيْهَا رَكْعَةً فَتَكُونُ صَلاةَ الظُّهْرِ وَرَكَعَتَيْنِ بَعْدَهَا , وَإِذَا صَلَّى الصُّبْحَ ثَلاثًا صَلَّى إِلَيْهَا رَابِعَةً فَتَكُونُ رَكْعَتَانِ تَطَوُّعًا , وَسَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \" , قَالَ : \" وَكَذَلِكَ إِنْ صَلَّى الْمَغْرِبَ أَرْبَعًا صَلَّى إِلَيْهَا رَكْعَةً خَامِسَةً فَتَكُونُ رَكْعَتَانِ تَطَوُّعًا \" , قَالَ مَعْمَرٌ : وَأَخْبَرَنِي مَنْ سَمِعَ , الْحَسَنَ يَقُولُ فِي هَذَا كُلِّهِ : \" يَسْجُدُ سَجْدَتَيِ السَّهْوِ إِلَى وَهْمِهِ \"","","","","","Book of Prayer"
"3347","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , قال : \" إِذَا صَلَّى الرَّجُلُ خَمْسًا وَلَمْ يَجْلِسْ فِي الرَّابِعَةِ , فَإِنَّهُ يَزِيدُ السَّادِسَةَ , ثُمَّ يُسَلِّمُ ثُمَّ يَسْتَأْنِفُ صَلاتَهُ \"","","","","","Book of Prayer"
"3348","أَخْبَرَنَا مَعْمَرٌ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا نَادَى الْمُنَادِي أَدْبَرَ الشَّيْطَانُ لَهُ ضَرِيطٌ حَتَّى لا يَسْمَعَ النِّدَاءَ , فَإِذَا سَكَتَ أَقْبَلَ , فَإِذَا ثَوَّبَ أَدْبَرَ لَهُ ضَرِيطٌ , فَإِذَا سَكَتَ أَقْبَلَ , فَإِنَّهُ لَيَخْطُرُ بَيْنَ الْمَرْءِ وَقَلْبِهِ , يَقُولُ : اذْكُرْ كَذَا , اذْكُرْ كَذَا , لِشَيْءٍ لَمْ يَكُنْ يَذْكُرُهُ قَبْلَ ذَلِكَ , فَيَظَلُّ الرَّجُلُ إِنْ يَدْرِي كَمْ صَلَّى , فَإِذَا وَجَدَ أَحَدُكُمْ ذَلِكَ فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3349","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ عِيَاضِ بْنِ هِلالٍ , قَالَ : سَمِعْتُ أَبَا سَعِيدٍ الْخُدْرِيَّ , فَقُلْتُ : أَحَدُنَا يُصَلِّي فَلا يَدْرِي كَمْ صَلَّى ؟ , فَقَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا لَمْ يَدْرِ أَحَدُكُمْ فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ , وَإِذَا جَاءَ أَحَدَكُمُ الشَّيْطَانُ , فَيَقُولُ : قَدْ أَحْدَثْتَ فَلْيَقُلْ فِي نَفْسِهِ كَذَبْتَ , حَتَّى يَسْمَعَ صَوْتًا بِأُذُنِهِ , أَوْ يَجِدَ رِيحًا بِأَنْفِهِ \"","","","","","Book of Prayer"
"3350","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي ابْنُ شِهَابٍ , عَنْ أَبِي سَلَمَةَ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" يَأْتِي أَحَدَكُمُ الشَّيْطَانُ فِي صَلاتِهِ فَيَلْبِسُ عَلَيْهِ حَتَّى لا يَدْرِي كَمْ صَلَّى , فَإِذَا وَجَدَ ذَلِكَ فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3351","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ أَبِي سَلَمَةَ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" يَأْتِي أَحَدَكُمُ الشَّيْطَانُ فَيَلْبِسُ عَلَيْهِ فِي صَلاتِهِ أَزَادَ أَمْ نَقَصَ , فَإِذَا وَجَدَ ذَلِكَ فَلْيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \" . وَذَكَرَ ابْنُ أَبِي ذِئْبٍ , عَنِ الزُّهْرِيِّ , عَنْ أَبِي سَلَمَةَ , عَنْ أَبِي هُرَيْرَةَ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِثْلَهُ","","","","","Book of Prayer"
"3352","عَنْ مَالِكٍ , عَنْ زَيْدِ بْنِ أَسْلَمَ , عَنْ عَطَاءِ بْنِ يَسَارٍ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا شَكَّ أَحَدُكُمْ فِي صَلاتِهِ فَلَمْ يَدْرِ كَمْ صَلَّى أَثَلاثًا أَمْ أَرْبَعًا , فَلْيَقُمْ فَلْيُصَلِّ رَكْعَةً فَلْيُكْمِلْ بِهَا , ثُمَّ يَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ قَبْلَ أَنْ يُسَلِّمَ , فَإِنْ كَانَتِ الرَّكْعَةُ الَّتِي صَلَّى خَامِسَةً شَفَعَهَا بِهَاتَيْنِ السَّجْدَتَيْنِ , وَإِنْ كَانَتْ رَابِعَةً فَالرَّكْعَتَيْنِ تَرْغِيمٌ لِلشَّيْطَانِ \"","","","","","Book of Prayer"
"3353","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" إِذَا كُنْتَ لا تَدْرِي أَرْبَعًا صَلَّيْتَ أَمْ ثَلاثًا فَتَوَخَّ الصَّوَابَ , ثُمَّ قُمْ فَارْكَعْ رَكْعَةً , ثُمَّ اسْجُدْ سَجْدَتَيْنِ , فَإِنَّ اللَّهَ لا يُعَذِّبُ عَلَى الزِّيَادَةِ \"","","","","","Book of Prayer"
"3354","عَنْ مَعْمَرٍ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , عَنْ عَلْقَمَةَ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" إِذَا شَكَّ الرَّجُلُ فِي صَلاتِهِ فَلَمْ يَدْرِ ثَلاثًا صَلَّى أَمِ اثْنَيْنِ فَلْيَبْنِ عَلَى أَوْثَقِ ذَلِكَ , ثُمَّ يَسْجُدْ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3355","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِذَا شَكَّ الرَّجُلُ فِي صَلاتِهِ فَلَمْ يَدْرِ أَثَلاثًا أَمْ أَرْبَعًا فَلْيَبْنِ عَلَى أَتَمِّ ذَلِكَ فِي نَفْسِهِ , وَلَيْسَ عَلَيْهِ سُجُودٌ \" , قَالَ : وَكَانَ الزُّهْرِيُّ , يَقُولُ : \" يَسْجُدُ سَجْدَتَيِ السَّهْوِ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3356","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ , قَالَ : سَمِعْتُ ابْنَ عُمَرَ , يَقُولُ : \" إِذَا شَكَّ أَحَدُكُمْ فِي صَلاتِهِ فَلْيَتَوَخَّ , حَتَّى يَعْلَمَ أَنَّهُ قَدْ أَتَمَّ , ثُمَّ يَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3357","عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِذَا شَكَّ أَحَدُكُمْ فِي صَلاتِهِ فَلْيَبْنِ عَلَى أَوْثَقِ ذَلِكَ فِي نَفْسِهِ , ثُمَّ لِيَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3358","عَنْ مَعْمَرٍ , عَمَّنْ سَمِعَ الْحَسَنَ , يَقُولُ : \" إِذَا شَكَّ أَحَدُكُمْ فِي صَلاتِهِ فَلْيَتَوَخَّ , حَتَّى يَعْلَمَ أَنَّهُ قَدْ أَتَمَّ , ثُمَّ يَسْجُدْ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3359","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِنِ الْتَبَسَ عَلَى الإِمَامِ فَلا يَدْرِي كَمْ صَلَّى وَهُوَ قَائِمٌ , كَيْفَ يَصْنَعُ ؟ , قَالَ : \" يُوشِكُ أَنْ يَعْلَمَ بِعِلْمِ مَنْ وَرَاءَهُ \"","","","","","Book of Prayer"
"3360","عَنْ رَجُلٍ , عَنْ مُحَمَّدِ بْنِ جَابِرٍ , عَنْ إِبْرَاهِيمَ , قال : \" إِنَّ أَحَبَّ إِلَيَّ أَنْ أُعِيدَ الصَّلاةَ إِذَا نَسِيتُ , إِلا أَنْ أَكُونَ أُكْثِرُ النِّسْيَانَ فَأَسْجُدُ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3361","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , وَالْحَسَنِ في الزيادة في الصلاة : \" يَسْجُدُ سَجْدَتَيْنِ لِلسَّهْوِ , وَإِذَا لَمْ يَذْكُرْ كَمْ صَلَّى بَنَى عَلَى أَتَمِّ ذَلِكَ فِي نَفْسِهِ , وَسَجَدَ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3362","عَنِ ابْنِ الْمُبَارَكِ , قَالَ : أَخْبَرَنِي إِسْمَاعِيلُ بْنُ مُسْلِمٍ , عَنِ ابْنِ شِهَابٍ , عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : كُنْتُ عِنْدَ عُمَرَ أُذَاكِرُهُ لِلصَّلاةِ , فَدَخَلَ عَلَيْنَا عَبْدُ الرَّحْمَنِ بْنِ عَوْفٍ , فَقَالَ : أَلا أُحَدِّثُكُمْ حَدِيثًا سَمِعْتُهُ مِنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ؟ , قُلْنَا : بَلَى , قَالَ : أَشْهَدُ شَهَادَةَ اللَّهِ , أَنِّي سَمِعْتُهُ , يَقُولُ : \" إِذَا كَانَ أَحَدُكُمْ عَلَى شَكٍّ مِنَ الصَّلاةِ فِي النُّقْصَانِ فَلْيُصَلِّ حَتَّى يَكُونَ عَلَى شَكٍّ مِنَ الزِّيَادَةِ \"","","","","","Book of Prayer"
"3363","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَمِعْتُ عَطَاءً , يَقُولُ : سَمِعْتُ ابْنَ عَبَّاسٍ , يَقُولُ : \" إِنْ نَسِيتَ الصَّلاةَ الْمَكْتُوبَةَ فَعُدْ لِصَلاتِكَ \" , قَالَ : لَمْ أَسْمَعْهُ مِنْهُ فِي ذَلِكَ غَيْرَ ذَلِكَ , قَالَ : وَلَكِنْ بَلَغَنِي عَنْهُ , وَعَنِ ابْنِ عُمَرَ أَنَّهُمَا , قَالا : \" فَإِنْ نَسِيتَ الثَّانِيَةَ فَلا تُعِدْهَا , وَصَلِّ عَلَى أَحْرَى فِي نَفْسِكَ , ثُمَّ اسْجُدْ سَجْدَتَيْنِ بَعْدَمَا تُسَلِّمُ وَأَنْتَ جَالِسٌ \"","","","","","Book of Prayer"
"3364","عَنِ ابْنِ جُرَيْجٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قال : \" إِذَا لَمْ تَدْرِ كَمْ صَلَّيْتَ فَعُدْ لِصَلاتِكَ كُلِّهَا , فَإِنْ أَثْبَتَّ أَنَّكَ صَلَّيْتَ رَكْعَتَيْنِ , وَلَمْ تَدْرِ فِيمَا سِوَاهُمَا كَمْ صَلَّيْتَ , فَعُدْ لِلَّذِي شَكَكْتَ فِيهَا , وَلا تَعُدْ لِلرَّكْعَتَيْنِ اللَّتَيْنِ قَدْ أَثْبَتَّ , وَاسْجُدْ سَجْدَتَيْنِ وَأَنْتَ جَالِسٌ , فَإِنْ شَكَكْتَ الثَّانِيَةَ فَلا تَعُدْ , فَإِنَّمَا الْعَودُ مَرَّةً وَاحِدَةً \"","","","","","Book of Prayer"
"3365","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : إِنْ صَلَّيْتُ الْمَكْتُوبَةَ فَشَكَكْتُ عُدْتُ ثُمَّ شَكَكْتُ ؟ , قَالَ : \" فَلا تَعُدْ \" , قَالَ : فَقُلْتُ : إِنِّي اسْتَيْقَنْتُ , أَنِّي صَلَّيْتُ خَمْسَ رَكَعَاتٍ , قَالَ : \" فَلا تَعُدْ , وَإِنْ صَلَّيْتَ عَشَرَ رَكَعَاتٍ , فَاسْجُدْ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3366","عَنْ مَعْمَرٍ , عَنْ عَاصِمِ بْنِ مُنَبِّهٍ , قَالَ : سَأَلْتُ أَبَا هُرَيْرَةَ , فَقُلْتُ : شَكَكْتُ فِي صَلاتِي , قَالَ : \" يَقُولُونَ : تَسْجُدُ سَجْدَتَيْنِ وَأَنْتَ جَالِسٌ \" , قَالَ : وَسَأَلْتُ عَبْدَ اللَّهِ بْنَ عُمَرَ , فَقَالَ : \" عُدْ لِصَلاتِكَ حَتَّى تَحْفَظَ \"","","","","","Book of Prayer"
"3367","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مِسْعَرَ , قَالَ : قُلْتُ لِمُحَارِبِ بْنِ دِثَارٍ : سَمِعْتُ عَبْدَ اللَّهِ بْنَ عُمَرَ , يَقُولُ : \" أَحْصِ الصَّلاةَ مَا اسْتَطَعْتَ وَلا تَعُدْ ؟ \" , قَالَ : نَعَمْ","","","","","Book of Prayer"
"3368","عَنِ ابْنِ عُيَيْنَةَ , عَنْ مِسْعَرٍ , قَالَ : حَدَّثَنَا زِيَادُ بْنُ الْفَيَّاضِ , عَنْ أَبِي عِيَاضٍ , قَالَ : قَالَ عُمَرُ بْنُ الْخَطَّابِ : \" لا تُعَادُ الصَّلاةُ \"","","","","","Book of Prayer"
"3369","عَنْ يَحْيَى , عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , قَالَ : حَدَّثَنَا الْمُغِيرَةُ بْنُ شُبَيْلٍ , عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ , عَنِ الْمُغِيرَةِ بْنِ شُعْبَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا قَامَ الإِمَامُ فِي الرَّكْعَتَيْنِ , فَإِنْ ذَكَرَ قَبْلَ أَنْ يَسْتَوِيَ قَائِمًا فَلْيَجْلِسْ وَيَسْجُدْ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3370","عَنِ الثَّوْرِيِّ , قال : \" إِذَا قَامَ الرَّجُلُ فِي الرَّكْعَتَيْنِ الأُولَيَيْنِ فَلْيُسَبَّحْ بِهِ , فَإِنْ كَانَ قَدِ اسْتَتَمَّ قَائِمًا فَلا يَجْلِسْ , وَإِنْ كَانَ لَمْ يَسْتَتِمَّ قَائِمًا فَلْيَجْلِسْ \"","","","","","Book of Prayer"
"3371","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , فِي رَجُلٍ سَهَا فَقَامَ فِي رَكْعَتَيِ الْجُلُوسِ , قال : \" يَجْلِسُ مَا لَمْ يَسْتَوِ قَائِمًا \"","","","","","Book of Prayer"
"3372","عَنِ الثَّوْرِيِّ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , وَبَيَانٍ , عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ : \" أَنَّ سَعْدًا , قَامَ فِي الرَّكْعَتَيْنِ , فَسَبَّحُوا بِهِ فَجَلَسَ وَلَمْ يَسْجُدْ \"","","","","","Book of Prayer"
"3373","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ , عَنِ ابْنِ مَسْعُودٍ : \" أَنَّهُ صَلَّى بِالنَّاسِ فَسَهَا , فَقَامَ فِي مَثْنَى الأُولَى فَلَمْ يَتَشَهَّدْ , فَسَبَّحَ النَّاسُ , فَأَشَارَ إِلَيْهِمْ أَنْ قُومُوا فَقَامُوا \"","","","","","Book of Prayer"
"3374","عَنِ الثَّوْرِيِّ , عَنْ مُسْلِمٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ أَبِي لَيْلَى : \" أَنَّهُ نَهَضَ عَلَى سَاقَيْهِ , فَسَبَّحُوا بِهِ , فَسَجَدَ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3375","عَنِ الثَّوْرِيِّ , عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنْ أَنَسٍ , قَالَ : \" كُنَّا مَعَهُ فَصَلَّى الْعَصْرَ فَتَحَرَّكَ لِلْقِيَامِ , فَسَبَّحُوا , فَسَجَدَ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3376","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , أَنَّ طَاوُسًا أَخْبَرَهُ : \" أَنَّ ابْنَ الزُّبَيْرِ قَامَ فِي رَكْعَتَيْنِ مِنَ الْمَغْرِبِ , أَوْ أَرَادَ الْقِيَامَ , قَالَ : مَا رَأَيْتُ طَاوُسًا إِلا شَكَّ أَيَّهُمَا فَعَلَ ؟ نَهَضَ أَوْ أَرَادَ النُّهُوضَ ثُمَّ سَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ , قَالَ : فَذَكَرْتُ ذَلِكَ لابْنِ عَبَّاسٍ , قَالَ : فَقَالَ : أَصَابَ لَعَمْرِي , قُلْتُ : وَأَخْبَرَكَ أَنَّهُ سَجَدَهَا قَبْلَ التَّسْلِيمِ , أَوْ بَعْدُ ؟ قَالَ : لا أَدْرِي \"","","","","","Book of Prayer"
"3377","عَنِ الثَّوْرِيِّ , عَنْ خَصِيفٍ , عَنْ أَبِي عُبَيْدَةَ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : \" السَّهْوُ إِذَا قَامَ فِيمَا يُجْلَسُ فِيهِ , أَوْ قَعَدَ فِيمَا يُقَامُ فِيهِ , أَوْ يُسَلِّمَ فِي رَكْعَتَيْنِ , فَإِنَّهُ يَفْرُغُ مِنْ صَلاتِهِ , وَيَسْجُدُ سَجْدَتَيْنِ وَهُوَ جَالِسٌ يَتَشَهَّدُ فِيهَا \"","","","","","Book of Prayer"
"3378","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : \" صَلَّى بِنَا ابْنُ الزُّبَيْرِ ذَاتَ يَوْمٍ الْمَغْرِبَ , فَقُلْتُ : وَحَضَرْتَ ذَلِكَ ؟ , قَالَ : نَعَمْ , فَسَلَّمَ فِي رَكْعَتَيْنِ , قَالَ النَّاسُ : سُبْحَانَ اللَّهِ , سُبْحَانَ اللَّهِ , فَقَامَ فَصَلَّى الثَّالِثَةَ , فَلَمَّا سَلَّمَ سَجَدَ سَجْدَتَيِ السَّهْوِ , وَسَجَدَهُمَا النَّاسُ مَعَهُ , قَالَ : فَدَخَلَ أَصْحَابٌ لَنَا عَلَى ابْنِ عَبَّاسٍ فَذَكَرَ لَهُ بَعْضُهُمْ ذَلِكَ , كَأَنَّهُ يُرِيدُ أَنْ يَعِيبَ بِذَلِكَ ابْنَ الزُّبَيْرِ , فَقَالَ ابْنُ عَبَّاسٍ : أَصَابَ وَأَصَابُوا \"","","","","","Book of Prayer"
"3379","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا قَامَ فِي قُعُودٍ , فَإِذَا فَرَغَ مِنْ صَلاتِهِ سَجَدَ سَجْدَتَيِ السَّهْوِ وَيَتَشَهَّدُ تَشَهُّدَيْنِ \"","","","","","Book of Prayer"
"3380","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : إِذَا سَلَّمَ فِي مَثْنَى الانْصِرَافِ ثُمَّ ذَكَرَ , فَلْيُوفِ عَلَى مَا مَضَى , وَيَسْجُدْ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3381","عَنِ الثَّوْرِيِّ , قال : \" إِذَا قُمْتَ فِيمَا يُجْلَسُ فِيهِ , أَوْ جَلَسْتَ فِيمَا يُقَامُ فِيهِ , أَوْ جَهَرْتَ فِيمَا يُخَافَتُ فِيهِ , أَوْ خَافَتَّ فِيمَا يُجْهَرُ فِيهِ نَاسِيًا سَجَدْتَ سَجْدَتَيِ السَّهْوِ , فَإِنْ تَعَمَّدْتَ الْجَهْرَ فِيمَا يُخَافَتُ فِيهِ , أَوْ عَمَدْتَ شَيْئًا مِنْ ذَلِكَ لَمْ تَسْجُدْ سَجْدَتَيِ السَّهْوِ , فَإِنْ نَسِيتَ شَيْئًا مِنْ صَلاةِ النَّهَارِ فَتَقْضِيهَا بِاللَّيْلِ , فَاقْرَأْ كَمَا أَنْتَ تَقْرَأُ بِالنَّهَارِ مِنَ الْمَكْتُوبَةِ \"","","","","","Book of Prayer"
"3382","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : رَجُلٌ صَلَّى الظُّهْرَ رَكْعَتَيْنِ , ثُمَّ قَامَ وَلَمْ يَبْرَحْ فَيَذْكُرُ , قَالَ : \" يُوفِي عَلَى مَا مَضَى \" , فَقَالَ لَهُ إِنْسَانٌ : أَقُومُ فِي الْمَكْتُوبَةِ فَأَسْهُوَ حَتَّى أُشِيرُ إِلَى إِنْسَانٍ بِيَدِي وَلَمْ أَتَكَلَّمْ , قَالَ : \" اقْعُدْ وَاسْجُدْ سَجْدَتَيْنِ \"","","","","","Book of Prayer"
"3383","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" إِنْ قَامَ فِي قُعُودٍ , أَوْ قَعَدَ فِي قِيَامٍ , أَوْ سَلَّمَ سَجَدَ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3384","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أَرَأَيْتَ إِنْ سَهَا فَقَامَ , وَلَمْ يَبْرَحْ ثُمَّ ذَكَرَ , قَالَ : أَوْفِ عَلَى مَا مَضَى \"","","","","","Book of Prayer"
"3385","عَنِ الثَّوْرِيِّ , عَنْ خَصِيفٍ , عَنْ أَبِي عُبَيْدَةَ , عَنِ ابْنِ مَسْعُودٍ : \" أَنَّهُ تَشَهَّدَ فِي سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3386","عَنِ الثَّوْرِيِّ , عَنْ أَبِي الْجَحَّافِ , عَنْ إِسْمَاعِيلَ بْنِ رَجَاءٍ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ سَهَا فِي صَلاتِهِ فَسَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ , قَالَ : فَقُلْنَا لَهُ : هَلْ كَانَ مِنْ تَشَهُّدٍ ؟ , قَالَ : نَعَمْ , وَسَلَّمَ إِبْرَاهِيمُ فِيهِمَا \"","","","","","Book of Prayer"
"3387","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" يَتَشَهَّدُ فِي سَجْدَتَيِ السَّهْوِ وَيُسَلِّمُ \"","","","","","Book of Prayer"
"3388","عَنْ عَبْدِ اللَّهِ بْنِ كَثِيرٍ , عَنْ شُعْبَةَ بْنِ الْحَجَّاجِ , عَنِ الْحَكَمِ : \" أَنَّ عَبْدَ الرَّحْمَنِ بْنِ أَبِي لَيْلَى وَهِمَ فِي صَلاتِهِ , فَسَلَّمَ فَسَجَدَ سَجْدَتَيِ السَّهْوِ , ثُمَّ سَلَّمَ مَرَّةً أُخْرَى \" , قَالَ : سَأَلْتُ الْحَكَمَ , وَحَمَّادًا , فَقَالا : \" يَتَشَهَّدُ فِي سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3389","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لَيْسَ فِي سَجْدَتَيِ السَّهْوِ قِرَاءَةٌ وَلا رُكُوعٌ وَلا تَشَهُّدٌ \" , قُلْتُ : أَرَأَيْتَ إِذَا سَجَدْتُ سَجْدَتَيِ السَّهْوِ أَجْعَلُ نَهْضِي قِيَامٌ ؟ , قَالَ : \" بَلِ اجْلِسْ فَهُوَ أَحَبُّ إِلَيَّ , وَأَوْفَى لَهَا \"","","","","","Book of Prayer"
"3390","عَنِ ابْنِ جُرَيْجٍ , عَنِ الْحَسَنِ , قال : \" لَيْسَ فِيهِمَا تَشَهُّدٌ وَلا تَسْلِيمٌ \"","","","","","Book of Prayer"
"3391","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : مَتَى يَسْجُدُ سَجْدَتَيِ السَّهْوِ ؟ , قَالَ : \" حِينَ يُسَلِّمُ , مَا أُحِبُّ أَنْ يَجْعَلَ بَيْنَهُمَا وَبَيْنَ السَّلامُ عَلَيْكُمْ شَيْئًا \" , قُلْتُ : أُكَبِّرُ حِينَ أَخْفِضُ صُلْبِي لِلسُّجُودِ , وَحِينَ أَرْفَعُ ؟ , قَالَ : \" نَعَمْ لَيْسَ فِيهَا إِلا ذَلِكَ , إِلا أَنْ يَذْكُرَ إِنْسَانٌ رَبَّهُ , فَأَوْفِ سُجُودَهُمَا , فَإِذَا رَفَعَ صُلْبَهُ فَلْيَنْصِبْهُ حَتَّى يَرْجِعَ كُلُّ عَظْمٍ إِلَى مَفْصِلِهِ \"","","","","","Book of Prayer"
"3392","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا سَهَا الإِمَامُ فَلَمْ يَسْجُدْ , فَلَيْسَ عَلَى مَنْ وَرَاءَهُ سَهْوٌ وَلا سُجُودٌ \"","","","","","Book of Prayer"
"3393","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لَيْسَ عَلَى مَنْ خَلْفَ الإِمَامِ سَهْوٌ \" , قَالَ : قُلْتُ : وَإِنْ سَجَدَ فِي كُلِّ رَكْعَةٍ ثَلاثَ سَجَدَاتٍ ؟ , قَالَ : \" لَيْسَ عَلَيْهِمْ سَهْوٌ \"","","","","","Book of Prayer"
"3394","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : \" إِذَا سَهَا الإِمَامُ فَلَمْ يَسْجُدْ , فَلَيْسَ عَلَى مَنْ خَلْفَهُ أَنْ يَسْجُدُوا \"","","","","","Book of Prayer"
"3395","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , قال : \" إِذَا سَهَا الإِمَامُ سَجَدَ مَنْ خَلْفَهُ , وَإِذَا سَهَا مَنْ خَلْفَهُ فَلَيْسَ عَلَيْهِمْ حَتَّى لا يَضُرُّهُمْ سَهْوٌ مَعَ الإِمَامِ \" , عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , وَقَتَادَةَ مِثْلَهُ","","","","","Book of Prayer"
"3396","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ فِي الرَّجُلِ يَفُوتُهُ مِنَ الصَّلاةِ شَيْءٌ ثُمَّ يُسَلِّمُ نَاسِيًا , قال : \" يَقُومُ فَيَبْنِي , ثُمَّ يَسْجُدُ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3397","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ فِي رَجُلٍ فَاتَهُ مِنَ الصَّلاةِ شَيْءٌ , وَقَدْ سَهَا الإِمَامُ قَبْلَ أَنْ يَجِيءَ , قال : \" إِذَا سَلَّمَ وَسَجَدَ فَلْيَسْجُدْ مَعَهُ , فَإِذَا فَرَغَ فَلْيَقُمْ , وَلْيَقْضِ \" , عَنِ الثَّوْرِيِّ , عَنْ يُونُسَ , عَنِ الْحَسَنِ مِثْلَهُ , عَنِ الثَّوْرِيِّ , عَنْ قَتَادَةَ مِثْلَهُ","","","","","Book of Prayer"
"3398","أَخْبَرَنَا مَعْمَرٌ , عَنْ قَتَادَةَ , عَنْ أَنَسٍ : \" أَنَّهُ نَسِيَ رَكْعَةً مِنْ صَلاةِ الْفَرِيضَةِ حَتَّى دَخَلَ فِي التَّطَوُّعِ , ثُمَّ ذَكَرَ فَصَلَّى بَقِيَّةَ صَلاةِ الْفَرِيضَةِ , ثُمَّ سَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3399","أَخْبَرَنَا مَعْمَرٌ , عَنْ حَمَّادٍ , قَالَ : أَحْسَبُهُ , عَنْ إِبْرَاهِيمَ , أَنَّهُ قَالَ : \" إِذَا نَسِيَ شَيْئًا مِنَ الْفَرِيضَةِ حَتَّى يَدْخُلَ فِي التَّطَوُّعِ , ثُمَّ ذَكَرَ , انْصَرَفَ عَلَى شَفْعٍ , وَاسْتَقْبَلَ صَلاتَهُ \" , وَكَانَ يَقُولُ : \" التَّطَوُّعُ بِمَنْزِلَةِ الْكَلامِ \" , قَالَ مَعْمَرٌ : وَأَخْبَرَنِي مَنْ سَمِعَ الْحَسَنَ , يَقُولُ مِثْلُهُ","","","","","Book of Prayer"
"3400","عَنِ ابْنِ جُرَيْجٍ , قال : كَانَ إِذَا كَانَ الإِمَامُ فِي أَرْبَعٍ جَالِسًا , وَقَدْ فَاتَ الرَّجُلَ رَكْعَةٌ , فَقَامَ الرَّجُلُ يَقْضِي وَظَنَّ أَنَّ الإِمَامَ قَدْ سَلَّمَ , فَأَتَمَّ الرَّابِعَةَ ثُمَّ سَلَّمَ الإِمَامُ , فَلا يَعُدْ لَهَا , وَلَكِنْ لِيَقْضِ تِلْكَ الرَّكْعَةَ بَعْدَمَا يُسَلِّمُ الإِمَامُ \"","","","","","Book of Prayer"
"3401","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْنَا : \" باس باس إِنْ سَهَا رَجُلٌ فِي أَوَّلِ رَكْعَةٍ , فَلَمَّا صَلَّى رَكْعَتَيْنِ ظَنَّ أَنَّهُ قَدْ صَلَّى أَرْبَعًا , فَسَجَدَ سَجْدَتَيِ السَّهْوِ , ثُمَّ ذَكَرَ فَقَامَ فَأَتَمَّ أَرْبَعًا , فَلْيُعِدْ صَلاتَهُ مِنْ أَجْلِ , أَنَّهُ جَعَلَ مِنْ بَيْنِ ظَهْرَانِيِّ صَلاتِهِ تَطَوُّعًا يَعْنِي سَجْدَتَيِ السَّهْوِ , قَالَ : وَنَحْنُ نَقُولُ : لا \"","","","","","Book of Prayer"
"3402","عَنْ مَعْمَرٍ , عَنْ رَجُلٍ , عَنِ الْحَسَنِ , قال : \" إِذَا كَانَ شَكُّهُ بَعْدَ الانْصِرَافِ فَلا بَأْسَ عَلَيْهِ , وَإِذَا شَكَّ أَصَلَّى أَمْ لا ؟ , فَإِنْ كَانَ فِي وَقْتٍ أَعَادَ , وَإِنْ ذَهَبَ لَمْ يُعِدْ \"","","","","","Book of Prayer"
"3403","عَنْ شَيْخٍ مِنْ أَهْلِ الْبَصْرَةِ , عَنْ أَشْعَثَ , عَنِ الْحَسَنِ فِي رَجُلٍ لا يَدْرِي أَصَلَّى أَمْ لا ؟ , قَالَ : \" يُعِيدُ مَا كَانَ فِي وَقْتِ تِلْكَ الصَّلاةِ , فَإِذَا مَضَى الْوَقْتُ فَلَيْسَ عَلَيْهِ إِعَادَةٌ \"","","","","","Book of Prayer"
"3404","عَنْ صَاحِبٍ لَهُ , عَنْ مُحَمَّدِ بْنِ جَابِرٍ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : إِنَّ أَحَبَّ إِلَيَّ , أَنْ أُعِيدَ الصَّلاةَ إِلا أَنْ أَكُونَ أُكْثِرُ النِّسْيَانَ , فَأَسْجُدُ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3405","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , فِي رَجُلٍ قَرَأَ فِي الْمَكْتُوبَةِ سُورَةً فِيهَا سَجْدَةٌ , فَسَهَا فَلَمْ يَسْجُدْ حَتَّى رَكَعَ وَسَجَدَ لَهَا , قال : \" فَلا يَقْرَأْ , وَيَسْجُدُ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3406","عَنْ مَعْمَرٍ , قَالَ : سَأَلْتُ حَمَّادًا , عَنْ رَجُلٍ صَلَّى فَقَرَأَ السَّجْدَةَ فَرَكَعَ بِهَا , وَنَسِيَ أَنْ يَسْجُدَهَا حَتَّى رَفَعَ رَأْسَهُ , قَالَ : \" يَسْجُدُ سَجْدَتَيِ الرَّكْعَةِ حَتَّى إِذَا قَضَى صَلاتَهُ سَجَدَ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3407","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِنْ شَكَكْتَ فِي السُّجُودِ فَلا تُعِدْ وَاسْجُدْ سَجْدَتَيِ السَّهْوِ , وَإِنِ اسْتَيْقَنْتَ أَنَّكَ قَدْ سَجَدْتَ فِي رَكْعَةٍ ثَلاثَ سَجَدَاتٍ فَلا تُعِدْ , وَاسْجُدْ سَجْدَتَيِ السَّهْوِ \" , قُلْتُ : فَمَا لِلرُّكُوعِ لا يَكُونُ كَذَلِكَ ؟ , قَالَ : \" إِنَّ الرُّكُوعَ أَشَدُّ , فَإِنْ نَسِيتَ الرَّكْعَةَ ثُمَّ اسْتَيْقَنْتَ فَأَعِدْهَا \"","","","","","Book of Prayer"
"3408","عَنِ الثَّوْرِيِّ , فِي رَجُلٍ قَامَ فَقَرَأَ , ثُمَّ رَكَعَ , ثُمَّ سَجَدَ سَجْدَةً وَاحِدَةً , ثُمَّ قَامَ فَقَرَأَ فَرَكَعَ , ثُمَّ ذَكَرَ وَهُوَ سَاجِدٌ , أَنَّهُ لَمْ يَسْجُدْ فِي الرَّكْعَةِ الأُولَى إِلا سَجْدَةً وَاحِدَةً , قَالَ : \" لا يَعْتَدَّ بِهَذِهِ الرَّكْعَةِ الَّتِي ذَكَرَ وَهُوَ سَاجِدٌ , وَلَكِنْ لِيَرْفَعْ رَأْسَهُ فَلْيَسْجُدِ الَّتِي فَاتَتْهُ , وَلْيَسْجُدْ سَجْدَتَيِ الرَّكْعَةِ الَّتِي هُوَ فِيهَا , ثُمَّ يَسْجُدْ سَجْدَتَيِ السَّهْوِ إِذَا فَرَغَ مِنْ صَلاتِهِ \" , قَالَ : \" وَإِنْ ذَكَرَ بَعْدَمَا سَجَدَ سَجْدَةً اعْتَدَّ بِهَا , ثُمَّ سَجَدَ سَجْدَتَهُ الَّتِي فَاتَتْهُ , ثُمَّ لِيَسْجُدْ إِلَى سَجْدَتِهِ الأُولَى أُخْرَى , وَإِنْ ذَكَرَ وَهُوَ قَائِمٌ سَجَدَ , ثُمَّ عَادَ قَائِمًا إِلَى حَيْثُ كَانَ يَقْرَأُ مِنْ قِرَاءَتِهِ , وَإِنْ نَسِيَ الرَّجُلُ الرُّكُوعَ لَمْ يَعْتَدَّ بِسُجُودِهِ , وَقَضَى الرُّكُوعَ وَالسُّجُودَ مُسْتَأْنِفًا \"","","","","","Book of Prayer"
"3409","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , فِي رَجُلٍ نَسِيَ سَجْدَةً فِي أَوَّلِ صَلاتِهِ , حَتَّى صَلَّى ثَلاثَ رَكَعَاتٍ أَوْ أَرْبَعًا , قال : \" إِذَا ذَكَرَهَا خَرَّ سَاجِدًا , وَإِذَا ذَكَرَهَا بَعْدَمَا يَرْكَعُ مَضَى فِي رُكُوعِهِ وَسَجَدَ ثَلاثَ سَجَدَاتٍ \"","","","","","Book of Prayer"
"3410","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , فِي رَجُلٍ رَكَعَ , ثُمَّ سَهَا فَسَجَدَ سَجْدَةً وَاحِدَةً , ثُمَّ ذَكَرَ وَهُوَ قَائِمٌ , قال : \" يُتِمُّ صَلاتَهُ فَإِذَا سَلَّمَ سَجَدَ سَجْدَتَيِ السَّهْوِ \" , قُلْتُ : وَلا يَخِرُّ سَاجِدًا إِذَا ذَكَرَهَا ؟ , قَالَ : \" أَمَّا بَعْدُ قِيَامِهِ \"","","","","","Book of Prayer"
"3411","عَنِ الثَّوْرِيِّ , فِي رَجُلٍ جَلَسَ فِي الرَّكْعَةِ الرَّابِعَةِ , ثُمَّ ذَكَرَ أَنَّهُ نَسِيَ مِنْ كُلِّ رَكْعَةٍ سَجْدَةً , قَالَ : \" يَسْجُدُ أَرْبَعًا مُتَوَالِيَاتٍ , ثُمَّ يَتَشَهَّدُ , ثُمَّ يُسَلِّمُ , ثُمَّ يَسْجُدُ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3412","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ صَالِحٍ مَوْلَى التَّوْأَمَةِ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : \" لا صَلاةَ إِلا بِرُكُوعٍ \"","","","","","Book of Prayer"
"3413","عَنْ قَيْسِ بْنِ الرَّبِيعِ , قَالَ : أَخْبَرَنَا يُونُسُ بْنُ درَافِسَ , قال : \" صَلَّيْتُ خَلْفَ إِبْرَاهِيمَ النَّخَعِيّ إِحْدَى صَلاتَيِ الْعَشِيِّ , فَلَمَّا سَلَّمَ سَجَدَ سَجْدَتَيِ السَّهْوِ \" , فَقُلْتُ لَهُ : مَا شَأْنُكَ يَا أَبَا عِمْرَانَ ؟ , قَالَ : \" خَشِيتُ أَنْ أَكُونَ سَهَوْتُ \" , قَالَ : قُلْتُ : لَوْ سَهَوْتَ لَسَبَّحْنَا , قَالَ : \" خَشِيتُ أَنْ تَكُونُوا نَسِيتُمْ كَمَا نَسِيتُ \" , عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ : \" نَسِيتُمْ كَمَا نَسِيتُ \"","","","","","Book of Prayer"
"3414","عَنِ الثَّوْرِيِّ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , قال : \" إِنَّكَ إِنْ تَسْجُدَهُمَا فِيمَا لَيْسَ عَلَيْكَ خَيْرٌ لَكَ مِنْ أَنْ تَدَعَهُمَا فِيمَا عَلَيْكَ يَعْنِي سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3415","عَنْ إِسْمَاعِيلَ بْنِ عَيَّاشٍ , عَنْ عُبَيْدِ اللَّهِ الْكَلاعِيِّ , عَنْ زُهَيْرِ بْنِ سَالِمٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ , عَنْ ثَوْبَانَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لِكُلِّ سَهْوٍ سَجْدَتَانِ بَعْدَ التَّسْلِيمِ \"","","","","","Book of Prayer"
"3416","عَنِ الثَّوْرِيِّ , عَنْ رَجُلٍ , فَاتَتْهُ إِحْدَى صَلاتَيِ الْعَشِيِّ وَلا يَدْرِي الظُّهْرَ أَوِ الْعَصْرَ , قال : لا يَبْدُو أَيُصَلِّي الظُّهْرَ ثُمَّ الْعَصْرَ \"","","","","","Book of Prayer"
"3417","عَنِ الثَّوْرِيِّ , فِي رَجُلٍ نَسِيَ يَوْمَ السَّبْتِ صَلاةَ الظُّهْرِ , أَوْ صَلاةَ الْعَصْرِ , وَلا يَدْرِي أَيَّتَهُمَا نَسِيَ يَوْمَ الأَحَدِ , قال : \" يُصَلِّي الظُّهْرَ وَالْعَصْرَ , ثُمَّ يُصَلِّي الظُّهْرَ أَيْضًا \"","","","","","Book of Prayer"
"3418","عَنْ مُقَاتِلٍ , عَنْ حَمَّادٍ فِي رَجُلٍ نَسِيَ صَلاةً وَاحِدَةً مِنْ صَلاةِ النَّهَارِ , وَلا يَدْرِي أَيَّتَهُنَّ الَّتِي نَسِيَ ؟ , قال : يُصَلِّي الْغَدَاةَ , ثُمَّ الظُّهْرَ , ثُمَّ الْعَصْرَ , كُلَّ صَلاةٍ مِنْهُنَّ بِإِقَامَةٍ , وَإِنْ نَسِيَ صَلاةً مِنْ صَلاةِ اللَّيْلِ وَلا يَدْرِي أَيَّتَهُنَّ هِيَ , فَلْيُصَلِّ الْمَغْرِبَ بِإِقَامَةٍ وَالْعِشَاءَ بِإِقَامَةٍ , فَإِنْ كَانَ الَّذِي لا يَدْرِي أَيَّتَهُنَّ الَّتِي نَسِيَ مِنْ صَلاةِ اللَّيْلِ , أَوْ مِنْ صَلاةِ النَّهَارِ , فَلْيُصَلِّ الصَّلَوَاتِ بِإِقَامَةٍ إِقَامَةٍ \"","","","","","Book of Prayer"
"3419","عَنِ الثَّوْرِيِّ , عَنْ هِشَامٍ , قَالَ : اخْتَلَفَ الْحَسَنُ , وَابْنُ سِيرِينَ فِي رَجُلٍ يَفُوتُهُ بَعْضُ الصَّلاةِ مَعَ الإِمَامِ فِي أَيَّامِ التَّشْرِيقِ , فَقَالَ الْحَسَنُ : \" يُكَبِّرُ مَعَ الإِمَامِ إِذَا كَبَّرَ , ثُمَّ يَقُومُ فَيَقْضِيَ مَا فَاتَهُ \" , وَقَالَ ابْنُ سِيرِينَ : \" يَقُومُ فَيَقْضِيَ , فَإِذَا فَرَغَ مِنْ صَلاتِهِ كَبَّرَ بَعْدُ \" . وَأَحَبُّ إِلَى سُفْيَانَ , قَوْلُ ابْنِ سِيرِينَ , قَالَ : \" يَقُومُ فَيَقْضِيَ \" عَنِ الثَّوْرِيِّ , عَنْ غَيْرِهِ , عَنْ إِبْرَاهِيمَ , مِثْلَ قَوْلِ الْحَسَنِ","","","","","Book of Prayer"
"3420","عَنْ أَبِي حَنِيفَةَ , عَنْ حَمَّادٍ , عَنْ إِبْرَاهِيمَ , فِي الرَّجُلِ يَفُوتُهُ بَعْضُ الصَّلاةِ فِي أَيَّامِ التَّشْرِيقِ مَعَ الإِمَامِ , قال : يَقُومُ فَيَقْضِيَّ , فَإِذَا فَرَغَ مِنْ صَلاتِهِ كَبَّرَ بَعْدُ , مِثْلَ قَوْلِ ابْنِ سِيرِينَ \" , قَالَ ابْنُ الْمُبَارَكِ : \" فَإِنِّي لَمْ أَسْمَعْ لأَبِي حَنِيفَةَ أَحْسَنَ مِنْ هَذَا الْحَدِيثِ \"","","","","","Book of Prayer"
"3421","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : \" فِي كُلِّ مَا يَنْبَغِي لَكَ أَنْ تَسْجُدَ سَجْدَتَيِ السَّهْوِ إِذَا نَسِيتَهُمَا حَتَّى تَقُومَ , فَارْكَعْ رَكْعَتَيْنِ إِذَا ذَكَرْتَ فِي الْمَكْتُوبَةِ \"","","","","","Book of Prayer"
"3422","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ فِي رَجُلٍ نَسِيَ سَجْدَتَيِ السَّهْوِ , قال : \" إِذَا لَمْ يَذْكُرْهُمَا حَتَّى انْصَرَفَ وَلَمْ يَسْجُدْهُمَا , فَقَدْ مَضَتْ صَلاتُهُ , فَإِنْ ذَكَرَهُمَا وَهُوَ قَاعِدٌ لَمْ يَقُمْ يَسْجُدُهُمَا \"","","","","","Book of Prayer"
"3423","عَنِ ابْنِ جُرَيْجٍ , قَالَ : \" قُلْتُ لِعَطَاءٍ : نَسِيتُ سَجْدَتَيِ السَّهْوِ فَتَحَدَّثْتُ , أَوْ عَلِمْتُ وَلَمْ أَقُمْ , قَالَ : فَاسْجُدْهُمَا , قَالَ : فَإِنْ كَانَ حِينَ فَرَغْتَ وَلَمْ تَتَكَلَّمْ ثُمَّ ذَكَرْتَ , قَالَ : فَاجْلِسْ فَاجْلِسْ , فَاسْجُدْهُمَا \"","","","","","Book of Prayer"
"3424","عَنِ الثَّوْرِيِّ , عَنْ سَلَمَةَ بْنِ نُبَيْطٍ الأَشْجَعِيِّ , قال : سَهَوْتُ فَأَتَيْتُ الضَّحَاكَ بْنَ مُزَاحِمٍ فِي مَنْزِلِهِ , فَقُلْتُ : إِنِّي سَهَوْتُ , فَقَالَ : اسْجُدْهُمَا الآنَ \" , قَالَ الثَّوْرِيُّ : \" وَأَمَّا غَيْرُهُ فَكَانَ يَسْتَحِبُّ إِنْ ذَكَرَهُمَا وَهُوَ فِي الْمَسْجِدِ أَنْ يَسْجُدَهُمَا وَإِلا فَلا \"","","","","","Book of Prayer"
"3425","عَنْ مَعْمَرٍ , عَنِ ابْنِ إِسْحَاقَ : \" أَنَّ عَلْقَمَةَ بْنَ قَيْسٍ , سَهَا فِي صَلاتِهِ , فَتَكَلَّمَ بَعْدَمَا سَلَّمَ قَبْلَ أَنْ يَسْجُدَ سَجْدَتَيِ السَّهْوِ , فَقِيلَ لَهُ : فَتَنَحَّى وَسَجَدَهُمَا \"","","","","","Book of Prayer"
"3426","عَنِ الثَّوْرِيِّ , عَنِ الْحَسَنِ بْنِ عَبْدِ اللَّهِ , عَنْ إِبْرَاهِيمَ : \" أَنَّ عَلْقَمَةَ أَوْهَمَ فِي صَلاتِهِ فَسَلَّمَ , فَقَالَ رَجُلٌ : إِنَّكَ أَوْهَمْتَ , فَقَالَ : أَكَذَلِكَ ؟ , قَالَ : نَعَمْ , فَثَنَى رِجْلَهُ فَسَجَدَ سَجْدَتَيِ السَّهْوِ , قَالَ مَعْمَرٌ : فَسَمِعْتُ مَنْ يَذْكُرُ أَنَّهُ انْفَتَلَ , فَقَالَ لَهُ رَجُلٌ : إِنَّكَ لَمْ تَسْجُدْ سَجْدَتَيِ السَّهْوِ فَتَحَرَّفَ لِلْقِبْلَةِ فَسَجَدَهُمَا \"","","","","","Book of Prayer"
"3427","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ : \" إِذَا قُمْتَ فِي التَّطَوُّعِ فِيمَا يُجْلَسُ فِيهِ , أَوْ جَلَسْتَ فِيمَا يُقَامُ فِيهِ , فَاسْجُدْ سَجْدَتَيِ السَّهْوِ ؟ , يَقُولُ : \" إِذَا سَهَا فِيهَا فَلا يَسْجُدُ وَيَتَوَخَّى الإِمَامُ فِيهَا \"","","","","","Book of Prayer"
"3428","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : \" لَيْسَ فِي سَجْدَتَيِ السَّهْوِ سَهْوٌ , يَقُولُ : إِذَا سَهَا فِيهَا فَلا يَتَوَخَّى فِيهَا وَيَتَوَخَّى التَّمَامَ فِيهَا \"","","","","","Book of Prayer"
"3429","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا سَهَوْتَ فِي التَّطَوُّعِ فَلَمْ تَدْرِ مَا صَلَّيْتَ , فَلا تُعِدْ , وَلَكِنْ عَلَى أَحْرَى ذَلِكَ فِي نَفْسِكَ , ثُمَّ اسْجُدْ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3430","أَخْبَرَنَا مَعْمَرٌ , يَقُولُ : \" مَنْ أَخَذَ الْعِلْمَ جُمْلَةً ذَهَبَ مِنْهُ جُمْلَةً \"","","","","","Book of Prayer"
"3431","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِنْ سَهَوْتَ فِي التَّطَوُّعِ , فَلا بَأْسَ أَنْ لا تَسْجُدَ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3432","عَنْ مَعْمَرٍ , قال : \" رَأَيْتُهُ يُصَلِّي التَّطَوُّعَ , ثُمَّ سَجَدَ وَهُوَ جَالِسٌ , فَقُلْتُ لَهُ : مَا هَذَا ؟ , فَقَالَ : إِنِّي كَثِيرُ السَّهْوِ , فَقُلْتُ : أَفِي التَّطَوُّعِ سَهْوٌ ؟ , قَالَ : أَخْبَرَنِي أَيُّوبُ , عَنِ ابْنِ سِيرِينَ , أَنَّهُ كَانَ لا يَرَى عَلَى مَنْ سَهَا فِي التَّطَوُّعِ سَهْوًا , قَالَ : وَكَانَ الْحَسَنُ يَرَاهُ سَهْوًا , وَيَسْجُدُ فِيهِ كَمَا يَسْجُدُ فِي الْفَرِيضَةِ \"","","","","","Book of Prayer"
"3433","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" إِذَا كَانَ وَهْمُهُ فِي التَّطَوُّعِ وَالْوِتْرِ , فَلْيَبْنِ إِلَى وَهْمِهِ , وَلْيَسْجُدْ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3434","عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , عَنْ عَوْفٍ , عَنِ الْحَسَنِ : \" أَنَّهُ كَانَ إِذَا سَهَا فِي التَّطَوُّعِ سَجَدَ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3435","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ , قَالَ : أَخْبَرَنِي شُعْبَةُ , أَنَّهُ سَأَلَ حَمَّادًا , فَقَالَ : \" اسْجُدْهُمَا إِذَا سَهَوْتَ فِي التَّطَوُّعِ \"","","","","","Book of Prayer"
"3436","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ , قَالَ : ذَكَرْتُ لِلثَّوْرِيِّ قَوْلَ ابْنِ سِيرِينَ \" لَيْسَ فِي التَّطَوُّعِ سَهْوٌ \"","","","","","Book of Prayer"
"3437","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : إِنْ سَهَوْتَ فِي التَّطَوُّعِ فَاسْجُدْهُمَا فِي آخِرِ صَلاتِكَ \"","","","","","Book of Prayer"
"3438","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِذَا قُمْتَ فِي التَّطَوُّعِ فِيمَا يُجْلَسُ فِيهِ , أَوْ جَلَسْتَ فِيمَا يُقَامُ فِيهِ , فَاسْجُدْ سَجْدَتَيِ السَّهْوِ \"","","","","","Book of Prayer"
"3439","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : \" أَرَأَيْتَ إِنْ سَهَوْتَ قَبْلَ الْوِتْرِ أَسْجُدُهُمَا بَعْدَ الْوِتْرِ ؟ , قَالَ : نَعَمْ \"","","","","","Book of Prayer"
"3440","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ لَهُ : \" إِنْ نَسِيتُ , أَنْ أَسْجُدَ سَجْدَتَيِ السَّهْوِ فِي التَّطَوُّعِ حَتَّى انْقَلَبْتُ إِلَى أَهْلِي , قَالَ : فَلا تَسْجُدْهُمَا مِنْ أَجْلِ أَنَّهُمَا تَطَوُّعٌ \"","","","","","Book of Prayer"
"3441","عَنِ الأَوْزَاعِيِّ , قَالَ : أَخْبَرَنِي هَارُونُ بْنُ رِئَابٍ , عَنِ الأَحْنَفِ بْنِ قَيْسٍ , قَالَ : \" دَخَلْتُ بَيْتَ الْمَقْدِسِ فَوَجَدْتُ فِيهِ رَجُلا كَثِيرَ السُّجُودِ , فَوَجَدْتُ فِي نَفْسِي مِنْ ذَلِكَ , فَلَمَّا انْصَرَفَ , قُلْتُ : أَتَدْرِي أَعَلَى شَفْعٍ انْصَرَفْتَ أَمْ عَلَى وِتْرٍ ؟ , قَالَ : إِنْ أَكُ لا أَدْرِي , فَإِنَّ اللَّهَ يَدْرِي , ثُمَّ قَالَ : أَخْبَرَنِي حِبِّي أَبُو الْقَاسِمِ , ثُمَّ بَكَا , ثُمَّ قَالَ : أَخْبَرَنِي حِبِّي أَبُو الْقَاسِمِ , ثُمَّ بَكَا , ثُمَّ قَالَ : أَخْبَرَنِي حِبِّي أَبُو الْقَاسِمِ , ثُمَّ بَكَا , ثُمَّ قَالَ : أَخْبَرَنِي حِبِّي أَبُو الْقَاسِمِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : أَنَّهُ مَا مِنْ عَبْدٍ يَسْجُدُ لِلَّهِ سَجْدَةً إِلا رَفَعَهُ اللَّهُ بِهَا دَرَجَةً , وَحَطَّ عَنْهُ بِهَا خَطِيئَةً , وَكَتَبَ لَهُ بِهَا حَسَنَةً , قَالَ : قُلْتُ : أَخْبِرْنِي مَنْ أَنْتَ رَحِمَكَ اللَّهُ ؟ , قَالَ : أَبُو ذَرٍّ صَاحِبُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : فَتَقَاصَرَتْ إِلَيَّ نَفْسِي \"","","","","","Book of Prayer"
"3442","عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ اللَّهِ , عَنْ دَاوُدَ بْنِ أَبِي هِنْدٍ , وَخَالِدٍ الْحَذَّاءِ , عَنْ أَبِي عُثْمَانَ النَّهْدِيِّ , عَنْ مُطَرِّفٍ , قَالَ : \" كُنْتُ أَمْشِي مَعَ كَعْبٍ فَمَرَرْنَا بِرَجُلٍ يَرْكَعُ وَيَسْجُدُ , لا يَدْرِي أَعَلَى شَفْعٍ هُوَ أَمْ عَلَى وِتْرٍ ؟ , قَالَ : قُلْتُ : لأُرْشِدَنَّ هَذَا , فَتَخَلَّفْتُ فَقُلْتُ : يَا أَبَا عَبْدِ اللَّهِ , أَعَلَى شَفْعٍ أَنْتَ أَمْ عَلَى وِتْرٍ ؟ , قَالَ : قَدْ كُفِيتُ , قُلْتُ : مَنْ كَفَاكَ ؟ , قَالَ : الْكِرَامُ الْكَاتِبُونَ , قَالَ : ثُمَّ قَالَ : مَنْ سَجَدَ لِلَّهِ سَجْدَةً كَتَبَ اللَّهُ لَهُ بِهَا حَسَنَةً , وَرَفَعَ لَهُ بِهَا دَرَجَةً , وَحَطَّ عَنْهُ بِهَا خَطِيئَةً , قَالَ : ثُمَّ قُلْتُ : مَنْ أَنْتَ ؟ , قَالَ : أَبُو ذَرٍّ , قَالَ : فَقُلْتُ : ثَكِلَتْ مُطَرِّفًا أُمُّهُ , أَبِي ذَرٍّ يَعْرِفُ السُّنَّةَ , قَالَ : فَقَالَ كَعْبٌ : أَيْنَ مُطَرِّفٌ ؟ , قَالَ قِيلَ : تَخَلَّفَ يُرْشِدُ رَجُلا رَآهُ لا يَدْرِي أَعَلَى شَفْعٍ هُوَ أَمْ عَلَى وِتْرٍ ؟ , فَقَالَ كَعْبٌ : مَنْ سَجَدَ لِلَّهِ سَجْدَةً كَتَبَ اللَّهُ لَهُ بِهَا حَسَنَةً وَرَفَعَ لَهُ بِهَا دَرَجَةً , وَحَطَّ عَنْهُ بِهَا خَطِيئَةً \"","","","","","Book of Prayer"
"3443","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , قَالَ : سَأَلْتُ الشَّعْبِيَّ , عَنْ رَجُلٍ , قَالَ فِي مَوْضِعِ سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ : اللَّهُ أَكْبَرُ , قَالَ : \" لَيْسَ عَلَيْهِ سَهْوٌ \"","","","","","Book of Prayer"
"3444","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , قال : \" مَنْ نَسِيَ شَيْئًا مِنْ تَكْبِيرِ الصَّلاةِ , أَوْ سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ , فَإِنَّهُ يَقْضِيهِ حِينَ ذَكَرَهُ \"","","","","","Book of Prayer"
"3445","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أَيُحْصِي الصَّلاةَ الْمَكْتُوبَةَ بِالْحَصَى وَالْخُطُوطِ ؟ , قَالَ : لا بَأْسَ \"","","","","","Book of Prayer"
"3446","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوْ سَهَوْتُ فِي الْمَكْتُوبَةِ فَتَكَلَّمْتُ ؟ , قَالَ \" بِلَفْظَةٍ ؟ \" , قُلْتُ : نَعَمْ , قَالَ : \" قَدِ انْقَطَعَتْ صَلاتُكَ , فَعُدْ لَهَا جَدِيدًا \"","","","","","Book of Prayer"
"3447","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي سَعْدُ بْنُ إِبْرَاهِيمَ , \" أَنَّ عُرْوَةَ بْنَ الزُّبَيْرِ صَلَّى بِهِمُ الْمَغْرِبَ فَرَكَعَ رَكْعَتَيْنِ , فَجَاءَهُ ابْنٌ لَهُ صَغِيرٌ فَجَلَسَ إِلَيْهِ , فَكَلَّمَهُ عُرْوَةُ , حَسِبَ أَنَّهُ قَدْ أَتَمَّ , قَالَ : فَسَبَّحْنَا بِهِ , فَقَامَ فَرَكَعَ الثَّالِثَةَ , ثُمَّ سَجَدَ سَجْدَتَيْنِ وَهُوَ جَالِسٌ \"","","","","","Book of Prayer"
"3448","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَمْرِو بْنِ دِينَارٍ , قَالَ : إِنْ عَمَدَ الْكَلامَ فَلْيُتِمَّ صَلاتَهُ وَافِيَةً , وَقَالَ : إِنَّمَا تَكَلَّمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ سَهَا , حَسِبَ أَنَّهُ قَدْ أَتَمَّ , وَلَوْ عَمَدَهُ","","","","","Book of Prayer"
"3449","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , سفِي رَجُلٍ يُصَلِّي الظُّهْرَ رَكْعَتَيْنِ , ثُمَّ سَلَّمَ وَانْصَرَفَ , قال : \" يَعُودُ لَهَا كَامِلَةً , إِلا أَنْ يَكُونَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَنَعَ الَّذِي يَقُولُونَ \"","","","","","Book of Prayer"
"3450","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ سُئِلَ عَنْ رَجُلٍ صَلَّى فَتَكَلَّمَ , وَقَدْ بَقِيَتْ عَلَيْهِ رَكْعَةٌ , قَالَ : يَسْتَقْبِلُ صَلاتَهُ , قَالَ : وَسَأَلْتُهُ عَنْ رَجُلٍ صَلَّى فَانْتَشَرَ ذَكَرُهُ ؟ , قَالَ : لا يَضُرُّهُ \"","","","","","Book of Prayer"
"3451","عَنِ ابْنِ التَّيْمِيِّ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , عَنْ إِبْرَاهِيمَ , قال : \" إِذَا تَكَلَّمَ فِي صَلاتِهِ أَعَادَ الصَّلاةَ \" , قَالَ إِسْمَاعِيلُ : \" يَبْنِي عَلَى مَا مَضَى \"","","","","","Book of Prayer"
"3452","عَنْ عَبْدِ الرَّحْمَنِ بْنِ زَيْدِ بْنِ أَسْلَمَ , عَنْ أَبِيهِ , قَالَ : بَيْنَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي بِأَصْحَابِهِ بِطَرِيقِ مَكَّةَ , مَرَّ رَجُلٌ يَطْرُدُ شَوْلا لَهُ , فَأَشَارَ إِلَيْهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَلَمْ يَفْطِنْ , فَصَرَخَ بِهِ عُمَرُ , فَقَالَ : يَا صَاحِبَ الشَّوْلِ رُدَّ إِبِلَكَ , فَرَدَّهَا , فَلَمَّا صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : مَنِ الْمُتَكَلِّمُ ؟ , قَالُوا : عُمَرُ , قَالَ : يَا لَكَ فِقْهًا يَا ابْنَ الْخَطَّابِ , قُلْتُ لَهُ : مَا الشَّوْلُ ؟ , قَالَ : فِرْقَةٌ مِنَ الإِبِلِ","","","","","Book of Prayer"
"3453","عَنْ مَعْمَرٍ , عَنْ رَجُلٍ , عَنِ الْحَسَنِ , وَقَتَادَةَ , وَحَمَّادٍ , قَالُوا : فِي رَجُلٍ سَهَا فِي صَلاتِهِ فَتَكَلَّمَ , قَالُوا : \" يُعِيدُ صَلاتَهُ \"","","","","","Book of Prayer"
"3454","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ مُجَاهِدٍ , قَالَ : كَانُوا يَتَكَلَّمُونَ فِي الصَّلاةِ , وَيُعْلِمُ الرَّجُلُ أَخَاهُ , حَتَّى نَزَلَتْ هَذِهِ الآيَةُ :  وَقُومُوا لِلَّهِ قَانِتِينَ فَقَطَعُوا الْكَلامَ , قَالَ : \" الْقُنُوتُ هُوَ السُّكُوتُ , وَالْقُنُوتُ الطَّاعَةُ \"","","","","","Book of Prayer"
"3455","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" إِذَا عَطَسْتَ وَأَنْتَ تُصَلِّي فَاحْمِدْ فِي نَفْسِكَ \"","","","","","Book of Prayer"
"3456","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنَا عَمْرُو بْنُ دِينَارٍ , قال : \" لا أَرَانِي إِلا وَقَدْ سَمِعْتُ أَبَا سَلَمَةَ بْنَ عَبْدِ الرَّحْمَنِ , يَقُولُ : عَطَسَ إِنْسَانٌ فَتَرَحَّمَ عَلَيْهِ آخَرُ وَهُوَ يُصَلِّي , فَقَالَ النَّاسُ : إِنَّ ذَلِكَ لا يُفْعَلُ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3457","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ زَيْدِ بْنِ أَسْلَمَ , قَالَ : \" عَطَسَ رَجُلٌ فِي الصَّلاةِ , فَقَالَ لَهُ أَعْرَابِيٌّ إِلَى جَنْبِهِ : رَحِمَكَ اللَّهُ , قَالَ الأَعْرَابِيُّ : فَنَظَرَ إِلَيَّ الْقَوْمُ , فَقُلْتُ : وَاثَكْلاهُ , مَا بَالُهُمْ يَنْظُرُونَ إِلَيَّ , فَضَرَبُوا بِأَكُفِّهِمْ عَلَى أَفْخَاذِهِمْ , فَلَمَّا قَضَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاتَهُ دَعَانِي , فَقَالَ الأَعْرَابِي : بِأَبِي وَأُمِّي , مَا رَأَيْتُ مُعَلِّمًا قَطُّ خَيْرًا مِنْهُ , وَاللَّهِ , فَقَالَ : وَاللَّهِ مَا كَهَرَنِي وَلا شَتَمَنِي , فَقَالَ : إِنَّ الصَّلاةَ لا يَصْلُحُ فِيهَا شَيْءٌ مِنْ كَلامِ النَّاسِ , إِنَّمَا هُوَ تَسْبِيحٌ , وَتَكْبِيرٌ , وَتَهْلِيلٌ , وَقِرَاءَةُ الْقُرْآنِ , أَوْ كَمَا قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \"","","","","","Book of Prayer"
"3458","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" لا يُؤْكَلُ فِي الصَّلاةِ وَلا يُشْرَبُ \" , قُلْتُ : فَشَرِبْتُ نَاسِيًا , قَالَ : \" إِنْ كُنْتَ لَمْ تَتَكَلَّمْ فَأَوْفِ مَا بَقِيَ عَلَى مَا مَضَى , ثُمَّ اسْجُدْ سَجْدَتَيِ السَّهْوِ , وَإِنْ شَرِبْتَ عَامِدًا فَقَدِ انْقَطَعَتْ صَلاتُكَ فَأَعِدِ الصَّلاةَ \"","","","","","Book of Prayer"
"3459","عَنِ الثَّوْرِيِّ , عَمَّنْ سَمِعَ عَطَاءً , قال : لا يَأْكُلْ وَلا يَشْرَبْ وَهُوَ يُصَلِّي , فَإِنْ فَعَلَ أَعَادَ \"","","","","","Book of Prayer"
"3460","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" آكُلُ فِي التَّطَوُّعِ وَأَشْرَبُ وَلَوْ مَجَّةً ؟ \" , قَالَ : \" لا لَعَمْرِي , وَلَكِنِ انْصَرِفْ وَاشْرَبْ \"","","","","","Book of Prayer"
"3461","عَنِ الثَّوْرِيِّ , عَنْ أَشْعَثَ , عَنْ إِبْرَاهِيمَ : \" أَنَّهُ كَانَ يَكْرَهُ , أَنْ يَشْرَبَ وَهُوَ يُصَلِّي \"","","","","","Book of Prayer"
"3462","عَنِ الثَّوْرِيِّ , عَنْ عُثْمَانَ , قال : \" رَأَيْتُ سَعِيدَ بْنَ جُبَيْرٍ يَشْرَبُ وَهُوَ يُصَلِّي تَطَوُّعًا \"","","","","","Book of Prayer"
"3463","عَنِ الثَّوْرِيِّ , عَنْ لَيْثٍ , عَنْ طَاوُسٍ , قال : بَأْسَ بِذَلِكَ \"","","","","","Book of Prayer"
"3464","عَنِ الثَّوْرِيِّ , عَنْ لَيْثٍ , قال : \" يُكْرَهُ أَنْ يَكُونَ فِي فِيهِ الدَّرَاهِمُ , أَوِ الشَّيْءُ وَهُوَ يُصَلِّي \"","","","","","Book of Prayer"
"3465","قَالَ سُفْيَانُ : \" وَلا بَأْسَ أَنْ يُصَلِّيَ الرَّجُلُ وَفِي حُجْزَتِهِ الطَّعَامُ أَوِ الشَّيْءُ , عَنْ غَيْرِ وَاحِدٍ \"","","","","","Book of Prayer"
"3466","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ : \" كَرِهَ الأَكْلَ فِي الصَّلاةِ , أَوْ قَالَ : هُوَ حَرَامٌ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3467","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : سَهَوْتُ فَاتَّكَأْتُ فِي مَثْنًى , أَوْ قَبْلَ أَنْ أُسَلِّمَ تَسْلِيمَ التَّشَهُّدِ الآخَرِ ؟ , قال : \" فَصَلِّ مَا بَقِيَ إِنْ كُنْتَ لَمْ تَتَكَلَّمْ , ثُمَّ اسْجُدْ سَجْدَتَيِ السَّهْوِ \" , قَالَ : \" وَإِنْ عَمَدْتَ ذَلِكَ فَقَدِ انْقَطَعَتْ صَلاتُكَ \"","","","","","Book of Prayer"
"3468","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي مُحَمَّدُ بْنُ عَلِيِّ بْنِ حُسَيْنٍ : \" أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , سَلَّمَ عَلَيْهِ عَمَّارُ بْنُ يَاسِرٍ وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي , فَرَدَّ عَلَيْهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" , قَالَ ابْنُ جُرَيْجٍ : أَخْبَرَ بِهِ عَطَاءٌ , عَنْ مُحَمَّدِ بْنِ عَلِيٍّ , فَلَقِيتُ مُحَمَّدَ بْنَ عَلِيٍّ فَسَأَلْتُهُ , فَحَدَّثَنِي بِهِ","","","","","Book of Prayer"
"3469","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ , \" أَنَّ عُثْمَانَ بْنَ مَظْعُونٍ , سَلَّمَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ جَالِسٌ فِي الصَّلاةِ , فَرَدَّ عَلَيْهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ السَّلامَ \"","","","","","Book of Prayer"
"3470","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَوْنُ بْنُ عَبْدِ اللَّهِ عَنْ حُمَيْدٍ الْحِمْيَرِيِّ : \" أَنَّ ابْنَ مَسْعُودٍ , سَلَّمَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِمَكَّةَ , وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُصَلِّي فَرَدَّ عَلَيْهِ السَّلامَ \"","","","","","Book of Prayer"
"3471","عَنِ ابْنِ جُرَيْجٍ , قَالَ لِي عَوْنُ بْنُ عَبْدِ اللَّهِ : عَنْ حُمَيْدٍ الْحِمْيَرِيِّ , عَمَّنْ يُرْضَى بِهِ , أَنّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمَّا رَجَعَتْ مُهَاجِرَةُ الْحَبَشِ نَزَعَ عَنْ ذَلِكَ , فَكَانَ يُسَلَّمُ عَلَيْهِ فِي الصَّلاةِ فَلا يَرُدُّ , فَقِيلَ لَهُ : قَدْ كُنْتَ يَا نَبِيَّ اللَّهِ , تَرُدُّ وَأَنْتَ بِمَكَّةَ فِي الصَّلاةِ , قَالَ : \" إِنَّ فِي الصَّلاةِ شُغْلا \" , قَالَ ابْنُ جُرَيْجٍ : فَأَخْبَرَنِي أَنَّ ابْنَ أَبِي لَيْلَى , \" أَنَّ ابْنَ مَسْعُودٍ هُوَ الَّذِي سَلَّمَ عَلَيْهِ مَرْجِعَهُ مِنْ مُهَاجِرِهِ مِنَ الْحَبَشِ \"","","","","","Book of Prayer"
"3472","عَنْ مَعْمَرٍ , عَنْ حَمَّادٍ , قَالَ : حَسِبْتُ أَنَّهُ قَالَ : عَنْ أَبِي وَائِلٍ  شَكَّ مَعْمَرٌ , عَنِ ابْنِ مَسْعُودٍ , قَالَ : كَانَ النَّاسُ يَرُدُّ بَعْضُهُمْ عَلَى بَعْضٍ السَّلامَ فِي الصَّلاةِ , حَتَّى سَلَّمَ ابْنُ مَسْعُودٍ فَسَلَّمَ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَلَمْ يَرُدَّ عَلَيْهِ , فَقَعَدَ حَزِينًا يُخَيَّلُ إِلَيْهِ أَنَّهُ قَدْ نَزَلَ فِيهِ شَيْءٌ , فَلَمَّا قَضَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاتَهُ ذَكَرَ ذَلِكَ لَهُ ابْنُ مَسْعُودٍ , فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : إِنَّ فِي الصَّلاةِ لَشُغْلا , أَوْ كَفَى بِالصَّلاةِ شُغْلا , قَالَ : فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" أَلا أُعَلِّمُكَ التَّحِيَّاتِ \" يَعْنِي التَّشَهُّدَ","","","","","Book of Prayer"
"3473","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قَالَ : قَالَ عَبْدُ اللَّهِ : كُنَّا نُسَلِّمُ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى رَجَعْنَا مِنْ عِنْدِ النَّجَاشِيِّ , فَسَلَّمْنَا عَلَيْهِ , فَلَمْ يَرُدَّ عَلَيْنَا , وَقَالَ : \" إِنَّ فِي الصَّلاةِ لَشُغْلا \"","","","","","Book of Prayer"
"3474","عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , أَنَّ ابْنَ مَسْعُودٍ انْتَهَى إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَرْجِعَهُ مِنَ الْحَبَشَةِ وَهُوَ يُصَلِّي , فَسَلَّمَ عَلَيْهِ فَلَمْ يَرُدَّ عَلَيْهِ حَتَّى انْفَتَلَ , فَقَالَ : \" إِنَّ فِي الصَّلاةِ لَشُغْلا \"","","","","","Book of Prayer"
"3475","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَاصِمِ بْنِ أَبِي النَّجُودِ , عَنْ أَبِي وَائِلٍ , قَالَ : قَالَ ابْنُ مَسْعُودٍ : كُنَّا نُسَلِّمُ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ فِي الصَّلاةِ فَيَرُدُّ عَلَيْنَا , فَلَمَّا جِئْتُ مِنْ أَرْضِ الْحَبَشَةِ فَسَلَّمْتُ عَلَيْهِ , فَلَمْ يَرْدُدْ عَلَيَّ , فَأَخَذَنِي مَا تَقَدَّمَ وَمَا تَأَخَّرَ , ثُمَّ انْتَظَرْتُهُ , فَلَمَّا قَضَى صَلاتَهُ ذَكَرْتُ ذَلِكَ لَهُ , فَقَالَ : \" إِنَّ اللَّهَ يُحْدِثُ مِنْ أَمْرِهِ يُسْرًا , وَإِنَّهُ قَضَى , أَوْ قَالَ : أَحْدَثَ , أَنْ لا تَكَلَّمُوا فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3476","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , أَنَّ ابْنَ عُمَرَ مَرَّ عَلَى رَجُلٍ يُصَلِّي , فَسَلَّمَ عَلَيْهِ فَرَدَّ عَلَيْهِ الرَّجُلُ , فَقَالَ لَهُ ابْنُ عُمَرَ : \" إِذَا كَانَ أَحَدُكُمْ فِي الصَّلاةِ يُسَلَّمُ عَلَيْهِ فَلا يَتَكَلَّمَنَّ , وَلْيُشِرْ إِشَارَةً , فَإِنَّ ذَلِكَ رَدَّهُ \"","","","","","Book of Prayer"
"3477","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ : \" أَنَّ ابْنَ عُمَرَ سَلَّمَ عَلَى رَجُلٍ وَهُوَ فِي الصَّلاةِ , فَرَدَّ عَلَيْهِ الرَّجُلُ , فَرَجَعَ إِلَيْهِ ابْنُ عُمَرَ , فَقَالَ : إِذَا سُلِّمَ عَلَيْكَ وَأَنْتَ تُصَلِّي فَرُدَّ عَلَيْهِ إِشَارَةً \" , قَالَ مَعْمَرٌ : وَأَخْبَرَنِي أَيُّوبُ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ مِثْلَهُ","","","","","Book of Prayer"
"3478","عَنِ ابْنِ عُيَيْنَةَ , عَنْ زَيْدِ بْنِ أَسْلَمَ , قَالَ , قَالَ ابْنُ عُمَرَ : \" دَخَلَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَسْجِدَ بَنِي عَمْرِو بْنِ عَوْفٍ يُصَلِّي فِيهِ , وَدَخَلَ مَعَهُ صُهَيْبٌ , فَدَخَلَ عَلَيْهِ رِجَالٌ مِنَ الأَنْصَارِ يُسَلِّمُونَ عَلَيْهِ , قَالَ عَبْدُ اللَّهِ : فَسَأَلْتُ صُهَيْبًا كَيْفَ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَصْنَعُ إِذَا سُلِّمَ عَلَيْهِ فِي الصَّلاةِ ؟ , قَالَ : كَانَ يُشِيرُ بِيَدِهِ \"","","","","","Book of Prayer"
"3479","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : رَأَيْتُ مُوسَى بْنَ جَمِيلٍ وَكَانَ مُصَلِّيًا , وَابْنُ عَبَّاسٍ يُصَلِّي لَيْلا إِلَى الْكَعْبَةِ , قَالَ : \" فَرَأَيْتُ مُوسَى صَلَّى , ثُمَّ يَعُودُ , ثُمَّ انْصَرَفَ , فَمَرَّ عَلَى ابْنِ عَبَّاسٍ فَسَلَّمَ عَلَيْهِ , فَقَبَضَ ابْنُ عَبَّاسٍ عَلَى يَدِ مُوسَى هَكَذَا \" , وَقَبَضَ عَطَاءٌ بِكَفِّهِ عَلَى كَفِّهِ , قَالَ عَطَاءٌ : \" فَكَانَ ذَلِكَ مِنْهُ تَحِيَّةٌ , وَلَمْ أَرَ ابْنَ عَبَّاسٍ تَكَلَّمَ \"","","","","","Book of Prayer"
"3480","عَنِ ابْنِ عُيَيْنَةَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ عَطَاءٍ , قَالَ : \" رَأَيْتُ مُوسَى بْنَ عَبْدِ اللَّهِ بْنِ جَمِيلٍ الْجُمَحِيَّ , سَلَّمَ عَلَى ابْنِ عَبَّاسٍ , وَابْنُ عَبَّاسٍ يُصَلِّي فِي قِبَلِ الْكَعْبَةِ , فَأَخَذَ ابْنُ عَبَّاسٍ يَدَهُ \"","","","","","Book of Prayer"
"3481","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ أَبِي سُفْيَانَ , عَنْ جَابِرٍ , قَالَ : \" لَوْ مَرَرْتُ بِقَوْمٍ يُصَلُّونَ مَا سَلَّمْتُ عَلَيْهِمْ \"","","","","","Book of Prayer"
"3482","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قَالَ عَطَاءٌ : \" أَمَّا أَنَا فَأَكْرَهُ , أَنْ أُسَلِّمَ عَلَى قَوْمٍ يُصَلُّونَ أُحْرِجُهُمْ \" , قَالَ : \" وَيُسَلِّمُ عَلَيَّ وَأَنَا جَالِسٌ فِي مَثْنًى فَأَرُدُّ حِينَئِذٍ \"","","","","","Book of Prayer"
"3483","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : كُنْتَ قَائِمًا لِتُصَلِّيَ فَكُنْتَ رَادًّا لَوْ سُلِّمَ عَلَيْكَ ؟ , قال : \" لا , وَلَكِنْ أَنْظُرُ أَنْ أَنْصَرِفَ , ثُمَّ أَرُدُّ عَلَيْهِ \"","","","","","Book of Prayer"
"3484","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" إِذَا سُلِّمَ عَلَيْكَ فِي الصَّلاةِ فَلا تَرُدَّ عَلَيْهِ , فَإِذَا انْصَرَفْتَ , فَإِنْ كَانَ قَرِيبًا فَرُدَّ , وَإِنْ كَانَ قَدْ ذَهَبَ فَأَتْبِعْهُ السَّلامَ \"","","","","","Book of Prayer"
"3485","عَنْ مَعْمَرٍ , عَنِ الْحَسَنِ , وَقَتَادَةَ , قَالا : \" يَرُدُّ السَّلامَ وَهُوَ فِي الصَّلاةِ \"","","","","","Book of Prayer"
"3486","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أُخْبِرْتُ : \" أَنَّ ابْنَ مَسْعُودٍ كَانَ إِذَا سُلِّمَ عَلَيْهِ وَهُوَ يُصَلِّي أَشَارَ بِرَأْسِهِ \"","","","","","Book of Prayer"
"3487","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" إِذَا وَجَدَ أَحَدٌ رِزًّا أَوْ رُعَافًا , أَوْ قَيْئًا فَلْيَنْصَرِفْ , وَلْيَضَعْ يَدَهُ عَلَى أَنْفِهِ , فَلْيَتَوَضَّأْ , فَإِنْ تَكَلَّمَ اسْتَقْبَلَ وَإِلا اعْتَدَّ بِمَا مَضَى \" , عَنْ مَعْمَرٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَاصِمٍ , عَنْ عَلِيٍّ مِثْلَهُ","","","","","Book of Prayer"
"3488","عَنِ الثَّوْرِيِّ , عَنْ عِمْرَانَ بْنِ ظَبْيَانَ الْحَنَفِيِّ , عَنْ حَكِيمِ بْنِ سَعْدٍ الْحَنَفِيِّ , قَالَ : قَالَ سَلْمَانُ : \" إِذَا وَجَدَ أَحَدُكُمْ رِزًّا مِنْ غَائِطٍ , أَوْ بَوْلٍ فَلْيَنْصَرِفْ , فَلْيَتَوَضَّأْ غَيْرَ مُتَكَلَّمٍ وَلا بَاغٍ يَعْنِي عَمِلَ عَمَلا , ثُمَّ لَيَعُدْ إِلَى الآيَةِ الَّتِي كَانَ يَقْرَأُ \"","","","","","Book of Prayer"
"3489","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِذَا رَعَفَ الرَّجُلُ فِي الصَّلاةِ , أَوْ ذَرَعَهُ الْقَيْءُ , أَوْ وَجَدَ مَذِيًّا , فَإِنَّهُ يَنْصَرِفُ وَيَتَوَضَّأُ , ثُمَّ يَرْجِعُ فَيُتِمُّ مَا بَقِيَ عَلَى مَا مَضَى , مَا لَمْ يَتَكَلَّمْ \"","","","","","Book of Prayer"
"3490","عَنِ ابْنِ جُرَيْجٍ , قَالَ ابْنُ شِهَابٍ : عَنْ سَالِمٍ , عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ : \" أَنَّهُ كَانَ يُفْتِي الرَّجُلَ إِذَا رَعَفَ فِي الصَّلاةِ , أَوْ ذَرَعَهُ قَيْءٌ , أَوْ وَجَدَ مَذِيًّا أَنْ يَنْصَرِفَ فَيَتَوَضَّأُ , ثُمَّ يُتِمُّ مَا بَقِيَ مِنْ صَلاتِهِ مَا لَمْ يَتَكَلَّمْ \"","","","","","Book of Prayer"
"3491","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قال : \" الْقَيْءُ وَالرُّعَافُ سَوَاءٌ , يَتَوَضَّأُ مِنْهُمَا , وَإِنْ لَمْ يَتَكَلَّمْ \"","","","","","Book of Prayer"
"3492","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي نَافِعٌ , \" أَنَّ ابْنَ عُمَرَ رَعَفَ وَهُوَ فِي الصَّلاةِ , فَدَخَلَ بَيْتَهُ , وَأَشَارَ إِلَى وَضُوءٍ , فَأُتِيَ بِهِ فَتَوَضَّأَ , ثُمَّ دَخَلَ فَأَتَمَّ عَلَى مَا مَضَى مِنْهَا , وَلَمْ يَتَكَلَّمْ بَيْنَ ذَلِكَ \"","","","","","Book of Prayer"
"3493","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , فِيمَنْ رَعَفَ فِي الصَّلاةِ , قال : يَنْفَتِلُ فَيَتَوَضَّأُ , ثُمَّ يُتِمُّ مَا بَقِيَ مِنْ صَلاتِهِ مَا لَمْ يَتَكَلَّمْ \"","","","","","Book of Prayer"
"3494","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ الْحَمِيدِ بْنِ جُبَيْرٍ , أَنَّهُ سَمِعَ سَعِيدَ بْنَ الْمُسَيِّبِ , يَقُولُ : \" إِنْ رَعَفْتَ فِي الصَّلاةِ فَاشْدُدْ مِنْخَرَكَ , وَصَلِّ كَمَا أَنْتَ , فَإِنْ خَرَجَ شَيْءٌ مِنَ الدَّمِ فَتَوَضَّأْ , ثُمَّ لا تَتَكَلَّمْ حَتَّى تَبْنِي عَلَى مَا مَضَى \"","","","","","Book of Prayer"
"3495","عَنْ مَعْمَرٍ , عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ , عَنْ عِكْرِمَةَ , قال : \" إِنْ كَانَ لا يَسْتَمْسِكُ رُعَافُهُ فِي الصَّلاةِ حَشَاهُ \"","","","","","Book of Prayer"
"3496","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قال : \" إِذَا رَعَفَ الإِنْسَانُ وَهُوَ فِي الصَّلاةِ انْصَرَفَ , فَغَسَلَ الدَّمَ عَنْهُ , ثُمَّ رَجِعَ وَأَتَمَّ مَا بَقِيَ عَلَى مَا مَضَى إِذَا لَمْ يَتَكَلَّمْ , وَلا وُضُوءَ عَلَيْهِ \"","","","","","Book of Prayer"
"3497","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَمْرُو بْنُ دِينَارٍ , عَنْ طَاوُسٍ , أَنَّهُ قَالَ : \" إِنْ رَعَفَ إِنْسَانٌ فِي الصَّلاةِ , ثُمَّ لَمْ يَتَكَلَّمْ حَتَّى يَتَوَضَّأَ وَيُصَلِّيَ , فَلْيُصَلِّ مَا بَقِيَ عَلَى مَا مَضَى إِذَا لَمْ يَتَكَلَّمْ \"","","","","","Book of Prayer"
"3498","وَلَكِنَّ عَمْرًا , يَقُولُ : إِنْ عَمَدَ الْكَلامَ فَلْيَسْتَقْبِلْ صَلاتَهُ وَافِيَةً , وَقَالَ : إِنَّمَا تَكَلَّمَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذْ سَهَا , حَسِبَ أَنَّهُ قَدْ أَتَمَّ , فَلَمْ يُعِدْ","","","","","Book of Prayer"
"3499","عَنِ ابْنِ جُرَيْجٍ , عَنْ أَبِيهِ , يَرْوِيهِ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ قَالَ : \" إِذَا رَعَفَ أَحَدُكُمْ فِي الصَّلاةِ أَوْ ذَرَعَهُ الْقَيْءُ , فَإِنْ كَانَ قَلْسًا يَغْسِلْهُ , أَوْ وَجَدَ مَذِيًّا فَلْيَنْصَرِفْ فَلْيَتَوَضَّأْ , ثُمَّ يَرْجِعْ إِلَى مَا بَقِيَ مِنْ صَلاتِهِ , وَلا يَسْتَقْبِلْهَا جَدِيدًا , وَهُوَ مَعَ ذَلِكَ لا يَتَكَلَّمُ حَتَّى يَرْجِعَ إِلَى مَا بَقِيَ مِنْ صَلاتِهِ \"","","","","","Book of Prayer"
"3500","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حُدِّثْتُ عَنِ ابْنِ مَسْعُودٍ , أَنَّهُ قَالَ : \" إِذَا أَحْدَثَ الرَّجُلُ فِي صَلاتِهِ حَدَثًا , ثُمَّ لَمْ يَتَكَلَّمْ حَتَّى تَوَضَّأَ , أَتَمَّ مَا بَقِيَ مِنْ صَلاتِهِ عَلَى مَا مَضَى مِنْهَا , فَإِنْ تَكَلَّمَ اسْتَقْبَلَهَا مُؤْتَنِفَةً \"","","","","","Book of Prayer"
"3501","عَنْ مَعْمَرٍ , وَابْنِ جُرَيْجٍ , عَنِ الزُّهْرِيِّ , أَنَّ الْمِسْوَرَ بْنَ مَخْرَمَةَ , قَالَ : \" يُعِيدُ الصَّلاةَ , وَلا يَعْتَدَّ بِشَيْءٍ مِمَّا مَضَى فِي الرُّعَافِ \"","","","","","Book of Prayer"
"3502","عَنْ مَعْمَرٍ , عَمَّنْ سَمِعَ الْحَسَنَ , يَقُولُ : \" يَسْتَقْبِلُ صَلاتَهُ تَكَلَّمَ , أَوْ لَمْ يَتَكَلَّمْ \"","","","","","Book of Prayer"
"3503","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنِ ابْنِ سِيرِينَ , يَقُولُونَ : يَسْتَقْبِلُ مَا لَمْ يَتَكَلَّمْ فَإِذَا تَكَلَّمَ , حَتَّى لا أَكُونَ فِي شَكٍّ أَحَبُّ إِلَيَّ \"","","","","","Book of Prayer"
"3504","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , قال : \" الضَّحِكُ , وَالْبَوْلُ , وَالرِّيحُ , يُعِيدُ الْوُضُوءَ وَالصَّلاةَ , وَالْقَيْءُ وَالرُّعَافُ يَبْنِي إِذَا لَمْ يَتَكَلَّمْ , فَإِنْ تَكَلَّمَ اسْتَقْبَلَ \"","","","","","Book of Prayer"
"3505","عَنْ يَحْيَى , عَنِ الثَّوْرِيِّ , عَنْ مُجَالِدِ بْنِ سَعِيدٍ , أَنَّهُ سَمِعَ إِبْرَاهِيمَ النَّخَعِيَّ , قَالَ : \" ثَلاثٌ يُعَادُ مِنْهُ الْوُضُوءُ وَالصَّلاةُ الضَّحِكُ , وَالْبَوْلُ , وَالرِّيحُ , وَثَلاثٌ يُعَادُ مِنْهُ الصَّلاةُ وَلا يُعَادُ مِنْهُ الْوُضُوءُ الْكَلامُ , وَالأَكْلُ , وَالشُّرْبُ , وَثَلاثٌ يُعَادُ مِنْهُ الْوُضُوءُ وَلا يُعَادُ مِنْهَا الصَّلاةُ إِلا أَنْ يَتَكَلَّمَ الْقَيْءُ , وَالرُّعَافُ , وَمَا يَسِيلُ مِنَ الْجُرُوحِ وَالْقُرُوحِ \" , قَالَ : \" وَكَانَ إِبْرَاهِيمُ يَرَى الْقَيْحَ وَالدَّمَ \"","","","","","Book of Prayer"
"3506","عَنِ ابْنِ التَّيْمِيِّ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , عَنْ عَامِرٍ , قال : \" أَيُّمَا رَجُلٌ أَحْدَثَ وَهُوَ فِي الصَّلاةِ فَلْيَنْصَرِفْ فَلْيَتَوَضَّأْ , ثُمَّ لِيُتِمَّ مَا بَقِيَ , وَإِنْ تَكَلَّمَ \"","","","","","Book of Prayer"
"3507","قَالَ إِسْمَاعِيلُ , وَقَالَ إِبْرَاهِيمُ : \" إِذَا تَكَلَّمَ أَعَادَ الصَّلاةَ \"","","","","","Book of Prayer"
"3508","عَنْ أَبِي بَكْرِ بْنِ مُحَمَّدٍ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ الْحَارِثِ , عَنْ عَبْدِ اللَّهِ بْنِ كَعْبٍ الْحِمْيَرِيِّ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : لا تَقْطَعْ إِلا لِثَلاثٍ لِرُعَافٍ , أَوْ لإِحْدَاثٍ , أَوْ لِتَسْلِيمِ الانْصِرَافِ","","","","","Book of Prayer"
"3509","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِنْ صَلَّيْتَ ثُمَّ فَرَغْتَ , فَإِذَا أَنْتَ لَمْ تُصِبِ الْقِبْلَةَ وَلَمْ تَفُتْكَ الصَّلاةُ , فَعُدْ لِصَلاتِكَ \" , قَالَ : \" وَإِنْ كَانَتْ قَدْ فَاتَتْكَ تِلْكَ الصَّلاةُ وَلَمْ تَذْكُرْ فَلا تَعُدْ \"","","","","","Book of Prayer"
"3510","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ , قال : \" يُعِيدُ مَا كَانَ فِي وَقْتٍ \"","","","","","Book of Prayer"
"3511","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : يَزْحَمُنِي النَّاسُ فِي كَثْرَتِهِمْ , وَيَلْفِتُنِي عَنْ مُنْقَطَعِ الْبَيْتِ , حَتَّى مَا أَكَادُ أَسْتَقْبِلُ الْقِبْلَةَ , أَوْ مَا أَكَادُ أَسْتَقْبِلُ مِنَ الْبَيْتِ شَيْئًا , قال : \" اجْتَهِدْ عَلَى أَنْ تَسْتَقْبِلَهُ , فَإِنْ غَلَبَكَ الأَمْرُ فَلا بَأْسَ \"","","","","","Book of Prayer"
"3512","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيَّبِ , قال : \" مَنْ صَلَّى مُخْطِئًا لِلْقِبْلَةِ فَلا إِعَادَةَ عَلَيْهِ \"","","","","","Book of Prayer"
"3513","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" مَنْ صَلَّى لِغَيْرِ الْقِبْلَةِ أَجْزَأَهُ \"","","","","","Book of Prayer"
"3514","عَنْ إِسْرَائِيلَ , عَنْ ثُوَيْرِ بْنِ أَبِي فَاخِتَةَ , قَالَ : \" قُلْتُ لِمُجَاهِدٍ : صَلَّيْتُ مُنْحَرِفًا عَنِ الْقِبْلَةِ ؟ , قَالَ : يُجْزِيكَ \"","","","","","Book of Prayer"
"3515","عَنِ الثَّوْرِيِّ , عَنْ عُبَيْدِ اللَّهِ بْنِ عُمَرَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , عَنْ عُمَرَ , قَالَ : \" مَا بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَةٌ \" , عَنِ الثَّوْرِيِّ , وَعَبْدِ اللَّهِ الثَّوْرِيِّ , عَنْ عُبَيْدِ اللَّهِ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , عَنْ عُمَرَ","","","","","Book of Prayer"
"3516","عَنِ الثَّوْرِيِّ , عَنْ حَكِيمِ بْنِ جُبَيْرٍ , عَنْ إِبْرَاهِيمَ , وَعَنْ عَبْدِ الأَعْلَى , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : \" مَا بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَةٌ \"","","","","","Book of Prayer"
"3517","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ نَافِعٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" مَا بَيْنَ الْمَشْرِقِ وَالْمَغْرِبِ قِبْلَةٌ \"","","","","","Book of Prayer"
"3518","عَنِ الثَّوْرِيِّ \" فِي رَجُلٍ فِي أَرْضِ الْحَبَشَةِ فِي يَوْمِ سَحَابٍ لَمْ يَدْرِ أَحَضَرَ وَقْتُ الصَّلاةَ أَمْ لا , فَقَالَ : أُصَلِّي فَإِنْ كَانَتِ الْوَقْتُ قَدْ حَضَرَ كُنْتَ قَدْ صَلَّيْتَ , وَإِلا أَعَدْتَ , قَالَ : فَكَانَ قَدْ صَلَّى فِي الْوَقْتِ , قَالَ : يُجْزِئُهُ ذَلِكَ \"","","","","","Book of Prayer"
"3519","عَنْ مَالِكٍ , عَنْ جَعْفَرِ بْنِ سُلَيْمَانَ , قَالَ : أَخْبَرَنِي يَزِيدُ الرَّشْكَ , قَالَ : حَدَّثَنَا صَفْوَانُ بْنُ مُحْرِزٍ الْمَازِنِيُّ , قَالَ : \" صَلَّى بِنَا أَبُو مُوسَى الأَشْعَرِيُّ صَلاةَ الْعَصْرِ فِي يَوْمٍ مَطِيرٍ , فَلَمَّا أَصْحَتْ إِذَا هُوَ قَدْ صَلاهَا لِغَيْرِ وَقْتٍ , فَأَعَادَ الصَّلاةَ \"","","","","","Book of Prayer"
"3520","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" صَلَّيْتُ الظُّهْرَ قَبْلَ أَنْ تَزِيغَ الشَّمْسُ , أَوِ الصُّبْحَ قَبْلَ الْفَجْرِ , ثُمَّ لَمْ أَعْلَمْ حَتَّى فَاتَتْ , فَقَالَ لِي : وَمَا هَذَا ؟ وَلِمَ لا تَعْلَمُ ؟ وَكَيْفَ لا تَعْلَمُ ؟ \"","","","","","Book of Prayer"
"3521","عَنِ الثَّوْرِيِّ , عَنْ دَاوُدَ , عَنِ الشَّعْبِيِّ , قال : \" الصُّفُوفُ بَعْضُهَا لِبَعْضٍ أَئِمَّةٌ \"","","","","","Book of Prayer"
"3522","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : فِي أَيَّامِ الْحَجِّ وَغَيْرِهَا أَكُونُ بِمَعْزِلٍ عَنِ الإِمَامِ , أَيُجْزِئُنِي رَفْعُ الإِمَامِ رَأْسَهُ مِنَ الرُّكُوعِ وَالسُّجُودِ أَمْ أَنْتَظِرُ رَفْعَ مَنْ عِنْدِي مِمَّنْ يَلِنِي مِنَ النَّاسِ ؟ , قَالَ : \" بَلْ يُجْزِئُكَ رَفْعٌ , وَيُجْزِئُ أَشَدَّ ذَلِكَ فِي نَفْسِكَ مُوَافَقَتُهُ لِرَفْعِ الإِمَامِ , ائِتَمَّ بِهِ مَا اسْتَطَعْتَ \"","","","","","Book of Prayer"
"3523","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ ابْنِ عُتْبَةَ , قَالَ : أُقِيمَتِ الصَّلاةُ فَخَرَجَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ حَتَّى إِذَا قَامَ فِي مُصَلاهُ ذَكَرَ أَنَّهُ لَمْ يَغْتَسِلْ , فَقَالَ لِلنَّاسِ : \" مَكَانَكُمْ , ثُمَّ دَخَلَ فَاغْتَسَلَ , ثُمَّ خَرَجَ عَلَى النَّاسِ وَهُمْ قِيَامٌ فِي الصُّفُوفِ , وَرَأْسُهُ يَنْطُفُ مَاءً \"","","","","","Book of Prayer"
"3524","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" أَفْقَهُ الْقَوْمِ جُنُبًا لَمْ يَجِدْ مَاءً أَيَؤُمُّهُمْ ؟ , قَالَ : لا لَعَمْرِي , وَإِنْ كَانَ أَمِيرًا فَلا يَؤُمُّهُمْ \"","","","","","Book of Prayer"
"3525","عَنْ مَالِكٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ , عَنْ زُبَيْدِ بْنِ الصَّلْتِ , أَنَّهُ قَالَ : خَرَجْنَا مَعَ عُمَرَ بْنِ الْخَطَّابِ إِلَى الْجُرُفِ , فَنَظَرَ فَإِذَا هُوَ قَدِ احْتَلَمَ , فَصَلَّى وَلَمْ يَغْتَسِلْ , فَقَالَ : \" وَاللَّهِ مَا أَرَانِي إِلا وَقَدِ احْتَلَمْتُ وَمَا شَعُرْتُ , وَصَلَّيْتُ وَمَا شَعُرْتُ \" , قَالَ : \" فَاغْتَسَلَ وَغَسَلَ مَا رَأَى فِي ثَوْبِهِ , وَنَضَحَ مَا لَمْ يَرَ , ثُمَّ أَذَّنَ وَأَقَامَ , ثُمَّ صَلَّى بَعْدَ مَا ارْتَفَعَ الضُّحَى مُتَمَكِّنًا \" , عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ نَحْوَهُ , إِلا أَنَّهُ قَالَ : \" أَعَادَ الصَّلاةَ وَلَمْ يَبْلُغْنَا أَنَّ النَّاسَ أَعَادُوا \"","","","","","Book of Prayer"
"3526","عَنْ مَعْمَرٍ , عَنْ أَيُّوبَ , عَنْ سُلَيْمَانَ بْنِ يَسَارٍ , قَالَ : حَدَّثَنِي الشَّرِيدُ , قَالَ : وَكُنْتُ أَنَا وَعُمَرُ بْنُ الْخَطَّابِ جَالِسَيْنِ بَيْنَنَا جَدْوَلٌ , قَالَ : فَرَأَى عُمَرُ فِي ثَوْبِهِ جَنَابَةً , فَقَالَ : \" فَرَطَ عَلَيْنَا الاحْتِلامُ , مُنْذُ أَكَلْنَا هَذَا الدَّسَمَ , ثُمَّ غَسَلَ مَا رَأَى فِي ثَوْبِهِ , وَاغْتَسَلَ وَأَعَادَ الصَّلاةَ \"","","","","","Book of Prayer"
"3527","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : صَلَّيْتُ جُنُبًا , أَوْ غَيْرَ مُتَوَضِّئٍ وَلَمْ أَعْلَمْ , حَتَّى فَاتَتْ تِلْكَ الصَّلاةُ ؟ , قَالَ : \" فَتَوَضَّأْ , ثُمَّ عُدْ لِصَلاتِكَ \"","","","","","Book of Prayer"
"3528","عَنْ مَعْمَرٍ , عَنْ هِشَامِ بْنِ عُرْوَةَ , عَنْ أَبِيهِ : \" أَنَّ عُمَرَ بْنَ الْخَطَّابِ , صَلَّى بِالنَّاسِ وَهُوَ جُنُبٌ فَأَعَادَ , وَلَمْ يَبْلُغْنَا أَنَّ النَّاسَ أَعَادُوا \"","","","","","Book of Prayer"
"3529","عَنِ الثَّوْرِيِّ , عَنْ جَابِرٍ , عَنِ الْقَاسِمِ بْنِ عَبْدِ الرَّحْمَنِ : \" أَنَّ عُمَرَ بْنَ الْخَطَّابِ أَمَّهُمْ وَهُوَ جُنُبٌ , أَوْ عَلَى غَيْرِ وُضُوءٍ , فَأَعَادَ الصَّلاةَ , وَلَمْ يُعِدْ مَنْ وَرَاءَهُ \"","","","","","Book of Prayer"
"3530","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ : \" أَنَّ ابْنَ عُمَرَ صَلَّى بِأَصْحَابِهِ صَلاةَ الْعَصْرِ وَهُوَ عَلَى غَيْرِ وُضُوءٍ , فَأَعَادَ , وَلَمْ يُعِدْ أَصْحَابُهُ \"","","","","","Book of Prayer"
"3531","عَنِ الثَّوْرِيِّ , عَنْ مُغِيرَةَ , عَنْ إِبْرَاهِيمَ , قال : \" يُعِيدُ وَلا يُعِيدُونَ \"","","","","","Book of Prayer"
"3532","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ , قال : \" يُعِيدُ وَلا يُعِيدُونَ \"","","","","","Book of Prayer"
"3533","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِنْ صَلَّى بِالنَّاسِ إِمَامُ قَوْمٍ غَيْرُ مُتَوَضٍّ , فَذَكَرَ حِينَ فَرَغَ \" , قَالَ : \" يُعِيدُ وَيُعِيدُونَ , فَإِنْ ذَكَرَ حَتَّى فَاتَتْ تِلْكَ الصَّلاةُ , فَإِنَّهُ يُعِيدُ هُوَ وَلا يُعِيدُونَ \"","","","","","Book of Prayer"
"3534","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : قُلْتُ : فَصَلَّى بِهِمْ جُنُبًا فَلَمْ يَعْلَمُوا وَلَمْ يَعْلَمْ , حَتَّى فَاتَتْ تِلْكَ الصَّلاةُ , قَالَ : \" فَلْيُعِيدُوا فَلَيْسَتِ الْجَنَابَةُ كَالْوُضُوءِ \"","","","","","Book of Prayer"
"3535","عَنْ هُشَيْمٍ , عَنْ أَبِي بِشْرٍ , عَنْ سَعِيدِ بْنِ جُبَيْرٍ , قال : \" يُعِيدُ وَلا يُعِيدُونَ \"","","","","","Book of Prayer"
"3536","عَنِ ابْنِ جُرَيْجٍ , قَالَ : حَدَّثَنِي بَعْضُ أَهْلِ الْمَدِينَةِ , قَالَ : حَدِيثٌ مُتَثَبِّتٌ عِنْدَنَا أَنَّ عُمَرَ بْنَ الْخَطَّابِ كَانَ يَرْكَبُ فِي كُلِّ جُمُعَةٍ رَكْبَتَيْنِ , إِحْدَاهُمَا يَنْظُرُ فِي أَمْوَالِ يَتَامَى أَبْنَاءِ الْمُهَاجِرِينَ , وَالأُخْرَى يَنْظُرُ أَرِقَّاءَ النَّاسِ , مَا يَبْلُغُ مِنْهُمْ , حَتَّى إِذَا كَانَ يَوْمًا فِي بَعْضِ ذَلِكَ بِالْجُرُفِ نَزَلَ , وَقَالَ : أَدَخَلَ يَدَهُ فَوَجَدَ شَيْئًا , فَقَالَ : \" إِنِّي لأَظُنُّنِي قَدْ صَلَّيْتُ جُنُبًا , إِنَّا إِذَا أَصَابَنَا الَوَدَكُ لانَتْ عُرُوقُنَا , ثُمَّ اغْتَسَلَ فَصَلَّى الصُّبْحَ , وَلَمْ يَأْمُرِ النَّاسَ أَنْ يُصَلُّوهَا \"","","","","","Book of Prayer"
"3537","عَنِ الثَّوْرِيِّ , عَنْ صَاعِدٍ , عَنِ الشَّعْبِيِّ , قال : \" يُعِيدُ وَيُعِيدُونَ \"","","","","","Book of Prayer"
"3538","عَنِ الثَّوْرِيِّ , عَنْ صَاعِدٍ , قال : \" سُئِلَ الشَّعْبِيُّ , عَنْ رَجُلٍ كَانَ يَؤُمُّ قَوْمًا فَصَلَّى رَكْعَةً أَوْ رَكْعَتَيْنِ , ثُمَّ رَأَى شَيْئًا فَفَزِعَ فَقَطَعَ صَلاتَهُ , قَالَ : يَسْتَأْنِفُونَ \"","","","","","Book of Prayer"
"3539","عَنِ الثَّوْرِيِّ , قَالَ : سَمِعْتُ حَمَّادًا , يَقُولُ : \" إِذَا فَسَدَتْ صَلاةُ الإِمَامِ فَسَدَتْ صَلاةُ الْقَوْمِ \"","","","","","Book of Prayer"
"3540","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ رَجُلٍ , عَنْ أَبِي جَابِرٍ الْبَيَاضِيِّ , عَنِ ابْنِ الْمُسَيَّبِ , قَالَ : \" صَلَّى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِأَصْحَابِهِ مَرَّةً وَهُوَ جُنُبٌ فَأَعَادَ بِهِمْ \"","","","","","Book of Prayer"
"3541","عَنْ عَبَّادِ بْنِ كَثِيرٍ , عَنْ عَمْرِو بْنِ خَالِدٍ , عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ , عَنْ عَاصِمِ بْنِ أَبِي ضَمْرَةَ , عَنْ عَلِيٍّ , \" أَنَّهُ صَلَّى بِالنَّاسِ جُنُبًا , ثُمَّ أَمَرَ ابْنَ النَّبَّاحِ فَنَادَى مَنْ كَانَ صَلَّى مَعَ أَمِيرِ الْمُؤْمِنِينَ الصُّبْحَ فَلْيُعِدِ الصَّلاةَ , فَإِنَّهُ صَلَّى بِالنَّاسِ وَهُوَ جُنُبٍ \" . وَذَكَرَهُ غَالِبُ بْنُ عُبَيْدِ اللَّهِ , عَنْ حَبِيبِ بْنِ أَبِي ثَابِتٍ , عَنْ عَاصِمِ بْنِ ضَمْرَةَ , عَنْ عَلِيٍّ مِثْلَهُ","","","","","Book of Prayer"
"3542","عَنْ حُسَيْنِ بْنِ مَهْرَانَ , عَنِ الْمُطَّرِحِ أَبِي الْمُهَلَّبِ , عَنْ عُبَيْدِ اللَّهِ بْنِ زَحْرٍ , عَنْ عَلِيِّ بْنِ يَزِيدَ , عَنِ الْقَاسِمِ , عَنْ أَبِي أُمَامَةَ , قَالَ : \" صَلَّى عُمَرُ بِالنَّاسِ وَهُوَ جُنُبٌ , فَأَعَادَ وَلَمْ يُعِدِ النَّاسُ , فَقَالَ لَهُ عَلِيٌّ : قَدْ كَانَ يَنْبَغِي لِمَنْ صَلَّى مَعَكَ أَنْ يُعِيدُوا \" , قَالَ : فَنَزَلُوا إِلَى قَوْلِ عَلِيٍّ , قَالَ : قُلْتُ : مَا نَزَلُوا ؟ , قَالَ : رَجَعُوا , قَالَ الْقَاسِمُ , وَقَالَ ابْنُ مَسْعُودٍ مِثْلَ قَوْلِ عَلِيٍّ","","","","","Book of Prayer"
"3543","عَنْ إِبْرَاهِيمَ بْنِ يَزِيدَ , عَنْ عَمْرِو بْنِ دِينَارٍ , عَنْ أَبِي جَعْفَرٍ : \" أَنَّ عَلِيًّا صَلَّى بِالنَّاسِ وَهُوَ جُنُبٌ , أَوْ عَلَى غَيْرِ وُضُوءٍ , فَأَعَادَ وَأَمَرَهُمْ أَنْ يُعِيدُوا \"","","","","","Book of Prayer"
"3544","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , قَالَ : سَأَلْتُهُ عَنْ إِمَامِ قَوْمٍ أَصَابَتْهُ جَنَابَةٌ فَلَمْ يَجِدْ مَاءً يَتَوَضَّأُ بِهِ ؟ , قَالَ : \" يَتَيَمَّمُ وَيَتَقَدَّمُ فَيُصَلِّي بِهِمْ , فَإِنَّ اللَّهَ قَدْ طَهَّرَهُ \"","","","","","Book of Prayer"
"3545","عَنْ سَعِيدِ بْنِ بَشِيرٍ , عَنْ قَتَادَةَ , عَنِ الْحَسَنِ , وَابْنِ الْمُسَيَّبِ , قَالا : \" التَّيَمُّمُ بِمَنْزِلَةِ الْمَاءِ \"","","","","","Book of Prayer"
"3546","عَنِ ابْنِ جُرَيْجٍ , قَالَ : سَأَلْتُ عَطَاءً , فَقُلْتُ : أَفْقَهُ الْقَوْمِ أَصَابَتْهُ جَنَابَةٌ , أَوْ أَتَى غَائِطًا فَتَمَسَّحَ بِالتُّرَابِ أَيَؤُمُّهُمْ ؟ , قَالَ : \" لا , فَلا يَؤُمُّهُمْ , وَإِنْ كَانَ أَمِيرُهُمْ \"","","","","","Book of Prayer"
"3547","عَنِ الثَّوْرِيِّ , عَنْ إِبْرَاهِيمَ \" فِي إِمَامِ قَوْمٍ أَصَابَتْهُ جَنَابَةٌ فَلَمْ يَجِدْ مَاءً , قَالَ : لَيُقَدِّمَ غَيْرَهُ \"","","","","","Book of Prayer"
"3548","عَنْ صَاحِبٍ لَهُ , عَنْ مُحَمَّدٍ , عَنْ مُحَمَّدِ بْنِ جَابِرٍ , عَنْ أَبِي إِسْحَاقَ , أَوْ غَيْرِهِ , عَنِ الْحَارِثِ , عَنْ عَلِيٍّ , قَالَ : \" لا يَؤُمُّ الْمُتَيَمِّمُ الْمُتَطَهِّرِينَ \" , قَالَ , وَقَالَ عَلِيٌّ : \" لا يَؤُمُّ الْمُقَيَّدُ الْمُطْلَقِينَ \"","","","","","Book of Prayer"
"3549","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , عَنْ عَلْقَمَةَ : \" أَنَّهُ أَمَّ قَوْمًا فَرَعَفَ , ثُمَّ انْصَرَفَ فَأَوْمَى إِلَى رَجُلٍ أَنْ يَتَقَدَّمَ , ثُمَّ جَاءَ فَأَتَمَّ بَقِيَّةَ صَلاتِهِ \"","","","","","Book of Prayer"
"3550","عَنْ أَبِي بَكْرِ بْنِ عَيَّاشٍ , عَنْ إِسْمَاعِيلَ بْنِ سُمَيْعٍ , قَالَ : عَنْ أَبِي رَزِينٍ , قَالَ : \" أَمَّنَا عَلِيٌّ فَرَعَفَ , فَأَخَذَ رَجُلا فَقَدَّمَهُ وَتَأَخَّرَ \"","","","","","Book of Prayer"
"3551","عَنْ مَعْمَرٍ , عَنِ الْحَسَنِ , وَقَتَادَةَ في رجل أَمَّ قَوْمًا فَأَحْدَثَ فِي صَلاتِهِ , قَالا : \" يُقَدِّمُ رَجُلا يُصَلِّي بِهِمْ مَا بَقِيَ مِنْ صَلاتِهِمْ \"","","","","","Book of Prayer"
"3552","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِنْ رَعَفَ الإِمَامُ فَلْيَتَأَخَّرْ , وَلْيُقَدِّمْ رَجُلا فَيُصَلِّي بِهِمْ \"","","","","","Book of Prayer"
"3553","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ زِيَادٍ , عَنْ بَكْرِ بْنِ سَوَادَةَ , وَعَبْدِ الرَّحْمَنِ بْنِ رَافِعٍ , عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا أَحْدَثَ الإِمَامُ فِي آخِرِ صَلاتِهِ حِينَ يَسْتَوِي قَاعِدًا , فَقَدْ تَمَّتْ صَلاتُهُ , وَصَلاةُ مَنْ وَرَاءَهُ عَلَى مِثْلِ صَلاتِهِ \"","","","","","Book of Prayer"
"3554","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ \" فِي رَجُلٍ أَحْدَثَ فِي صَلاتِهِ , وَقَبْلَ أَنْ يَتَشَهَّدَ , قَالَ : فَحَسْبُهُ , فَلا يُعِدْ \"","","","","","Book of Prayer"
"3555","عَنِ ابْنِ عُيَيْنَةَ , عَنِ ابْنِ أَبِي نَجِيحٍ , عَنْ عَطَاءٍ , قال : \" إِذَا رَفَعَ الإِمَامُ رَأْسَهُ مِنَ السُّجُودِ فِي آخِرِ صَلاتِهِ , فَقَدْ تَمَّتْ صَلاتُهُ , وَإِنْ أَحْدَثَ \"","","","","","Book of Prayer"
"3556","عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيَّبِ فِي رَجُلٍ يُحْدِثُ بَيْنَ ظَهْرَانِيِّ صَلاتِهِ , قَالَ : \" إِذَا قَضَى الرُّكُوعَ وَالسُّجُودَ تَمَّتْ صَلاتُهُ \"","","","","","Book of Prayer"
"3557","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , قَالَ : \" قُلْتُ لإِبْرَاهِيمَ \" الرَّجُلُ يُحْدِثُ حِينَ يَفْرُغُ مِنَ السُّجُودِ فِي الرَّابِعَةِ وَقَبْلَ التَّشَهُّدِ ؟ , قَالَ : قَدْ تَمَّتْ صَلاتُهُ \"","","","","","Book of Prayer"
"3558","عَنْ مَعْمَرٍ , عَنْ عَمْرِو بْنِ عُبَيْدٍ , قَالَ : أَمَّا أَنَا فَسَمِعْتُ الْحَسَنَ , يَقُولُ فِي الرَّجُلِ يُحْدِثُ فِي آخِرِ صَلاتِهِ قَبْلَ التَّشَهُّدِ , قَالَ : \" لا يُعِيدُ \" وَأَمَّا هَؤُلاءِ يَعْنِي أَصْحَابَهُ , فَقَالُوا : عَنْ عَمْرٍو : يُعِيدُ \"","","","","","Book of Prayer"
"3559","عَنِ ابْنِ التَّيْمِيِّ , عَنْ أَبِيهِ , عَنِ ابْنِ الْمُسَيَّبِ , وَالنَّخِعِيِّ , قَالا : \" لا يُعِيدُ \" , وَقَالَ ابْنُ سِيرِينَ : \" حَتَّى يُسَلِّمَ , فَإِنَّ صَلاتَهُ لَمْ تَتِمَّ \"","","","","","Book of Prayer"
"3560","عَنِ ابْنِ عُيَيْنَةَ , عَنِ ابْنِ أَبِي نَجِيحٍ , عَنْ مُجَاهِدٍ , قال : \" لا تَتِمُّ صَلاتُهُ حَتَّى يُسَلِّمَ , تَحْرِيمُ الصَّلاةِ التَّكْبِيرُ , وَخَاتِمَتُهَا التَّسْلِيمُ , أَوْ قَالَ : آخِرُهَا التَّسْلِيمُ \"","","","","","Book of Prayer"
"3561","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ , أَوِ ابْنِ عَمْرٍو , أَنَا أَشُكُّ , قَالَ : \" فَصْلُ الصَّلاةِ التَّسْلِيمُ \" , قَالَ : وَكَانَ الزُّهْرِيُّ , يَقُولُ : \" يُعِيدُ الصَّلاةَ \"","","","","","Book of Prayer"
"3562","عَنْ عَبْدِ الْمَلِكِ بْنِ أَبِي سُلَيْمَانَ , عَنْ عَطَاءِ بْنِ أَبِي رَبَاحٍ فِي الرَّجُلِ يُحْدِثُ فِي آخِرِ السَّجْدَةِ مِنَ الصَّلاةِ , قَالَ : \" يَنْصَرِفُ فَيَتَوَضَّأُ , ثُمَّ يَجِيءُ فَيَتَشَهَّدُ مَا لَمْ يَتَكَلَّمْ \" , قَالَ : \" فَإِنْ تَكَلَّمَ أَعَادَهُ \"","","","","","Book of Prayer"
"3563","عَنِ الثَّوْرِيِّ , فِي رَجُلٍ يُحْدِثُ بَعْدَمَا جَلَسَ فِي الرَّابِعَةِ , وَلَمْ يَتَشَهَّدْ , قَالَ : \" يَنْصَرِفُ فَيَتَوَضَّأُ , ثُمَّ يَعُودُ فَيَتَشَهَّدُ \"","","","","","Book of Prayer"
"3564","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ مَا يُكْرَهُ , أَنْ يُقَالُ فِي الصَّلاةِ , أَيُكْرَهُ أَنْ يَقُولَهُ : بَعْدَمَا يَفْرُغُ مِنَ التَّشَهُّدِ الأَوَّلِ ؟ , قَالَ : نَعَمْ \"","","","","","Book of Prayer"
"3565","عَنْ عَبْدِ اللَّهِ , عَنْ شُعْبَةَ , عَنْ مُسْلِمٍ الشَّامِيِّ , عَنْ حَمْلَةَ رَجُلٍ مِنْ عَكٍّ , عَنْ عُمَرَ بْنِ الْخَطَّابِ , قَالَ : \" لا تُجْزِئُ صَلاةٌ إِلا بِتَشَهُّدٍ \"","","","","","Book of Prayer"
"3566","عَنْ إِسْرَائِيلَ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَاصِمِ بْنِ ضَمْرَةَ , عَنْ عَلِيٍّ , قَالَ : \" إِذَا تَشَهَّدَ الرَّجُلُ , وَخَافَ أَنْ يُحْدِثَ , قَبْلَ أَنْ يُسَلِّمَ الإِمَامُ , فَلْيُسَلِّمْ , وَقَدْ تَمَّتْ صَلاتُهُ , وَإِنْ كَبَّرَ يَتَشَهَّدْ \"","","","","","Book of Prayer"
"3567","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , \" أَنَّ مُعَاوِيَةَ صَلَّى بِالنَّاسِ فَرَكَعَ ثُمَّ طُعِنَ وَهُوَ سَاجِدٌ أَوْ رَاكِعٌ , فَسَلَّمَ , ثُمَّ قَالَ : أَتِمُّوا صَلاتَكُمْ \" , فَصَلَّى كُلُّ رَجُلٍ لِنَفْسِهِ , وَلَمْ يُقَدِّمْ أَحَدًا","","","","","Book of Prayer"
"3568","عَنِ الثَّوْرِيِّ فِي رَجُلٍ أَمَّ قَوْمًا فَصَلَّى بِهِمْ رَكْعَةً أَوْ رَكْعَتَيْنِ , ثُمَّ أَحْدَثَ فَقَدَّمَ رَجُلا لَمْ يُدْرِكْ أَوَّلَ الصَّلاةِ ؟ , قَالَ : \" يُصَلِّي بِهِمُ الَّذِي قُدِّمَ صَلاةَ الإِمَامِ , ثُمَّ يَنْكُصُ قَاعِدًا , وَيُقَدِّمُ رَجُلا زَحْفًا , فَيُسَلِّمُ بِهِمْ , وَيَقُومُ هُوَ فَيُتِمُّ \"","","","","","Book of Prayer"
"3569","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : \" صَلَّيْتُ فِي إِزَارٍ غَيْرِ طَاهِرٍ , فَعَلِمْتُ قَبْلَ أَنْ تَفُوتَ تِلْكَ الصَّلاةُ , أَوْ بَعْدَمَا فَاتَتْ , قَالَ : لا تُعِدْ , وَمَا شَأْنُ الثَّوْبِ وَمَا شَأْنُ ذَلِكَ ؟ \"","","","","","Book of Prayer"
"3570","أَخْبَرَنَا مَعْمَرٌ , عَنْ عَطَاءٍ الْخَرَاسَانِيِّ , قَالَ : قَالَ لِي عَطَاءُ بْنُ أَبِي رَبَاحٍ : \" قَدْ صَلَّيْتُ فِي ثَوْبِي هَذَا كَذَا وَكَذَا \" ؟ , وَقَالَ : \" صَلَّيْتُ فِيهِ مِرَارًا وَفِيهِ دَمٌ نَسِيتُ أَنْ أَغْسِلَهُ \"","","","","","Book of Prayer"
"3571","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيَّبِ , قال : \" إِذَا رَأَى الرَّجُلُ فِي ثَوْبِهِ دَمًا بَعْدَ انْصِرَافِهِ مِنَ الصَّلاةِ لا يُعِيدُ \" , قَالَ مَعْمَرٌ : وَسَمِعْتُ الزُّهْرِيَّ , يَقُولُ : مِثْلَ ذَلِكَ","","","","","Book of Prayer"
"3572","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , عَنِ ابْنِ الْمُسَيَّبِ , قال : \" إِذَا رَأَى الرَّجُلُ فِي ثَوْبِهِ دَمًا , أَوْ نَجَسًا , أَوْ صَلَّى لِغَيْرِ الْقِبْلَةِ , أَوْ تَيَمَّمَ فَأَدْرَكَ الْمَاءَ فِي وَقْتٍ , فَإِنَّهُ لا إِعَادَةَ عَلَيْهِ \" , قَالَ قَتَادَةُ , وَقَالَ الْحَسَنُ : \" يُعِيدُ هَذَا كُلَّهُ مَا دَامَ فِي وَقْتٍ \"","","","","","Book of Prayer"
"3573","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قال : \" يُعِيدُ , فَإِنْ عَلِمَ بِهِ حِينَ صَلَّى وَقَبْلَ أَنْ يُصَلِّيَ \"","","","","","Book of Prayer"
"3574","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , أَنَّهُ قَالَ : \" لا يُعِيدُ \"","","","","","Book of Prayer"
"3575","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ أَبِي هِشَامٍ , قَالَ : سَأَلْتُ سَعِيدَ بْنَ جُبَيْرٍ عَنِ الرَّجُلِ يَرَى فِي ثَوْبِهِ الأَذَى وَقَدْ صَلَّى ؟ , قَالَ : \" اقْرَأْ عَلَيَّ الآيَةَ الَّتِي فِيهَا غَسْلُ الثَّوْبِ \"","","","","","Book of Prayer"
"3576","أَخْبَرَنَا أَيْمَنُ بْنُ نَابِلٍ , قال : \" سَأَلْتُ عَطَاءً , وَمُجَاهِدًا , عَنِ الرَّجُلِ يُصَلِّي فِي ثَوْبٍ وَلَيْسَ بِطَاهِرٍ , قَالا : لا يُعِيدُ \"","","","","","Book of Prayer"
"3577","عَنْ أَبِي بَكْرِ بْنِ عَيَّاشٍ , عَنْ يَزِيدَ بْنِ أَبِي زِيَادٍ , عَنْ مُجَاهِدٍ , قَالَ : كَانَ ابْنُ عُمَرَ جَالِسًا مَعَنَا , فَقَالَ : \" إِنِّي لأَرَى فِي ثَوْبِي مَنِيًّا , وَقَدْ صَلَّيْتُ فِيهِ , فَحَتَّهُ بِيَدِهِ وَلَمْ يُعِدِ الصَّلاةَ \"","","","","","Book of Prayer"
"3578","عَنْ إِبْرَاهِيمَ بْنِ مُحَمَّدٍ , عَنْ دَاوُدَ بْنِ حُصَيْنٍ , عَنْ عِكْرِمَةَ , عَنِ ابْنِ عَبَّاسٍ , قَالَ : \" مَنْ صَلَّى وَفِي ثَوْبِهِ دَمٌ , أَوِ احْتِلامٌ عَلِمَ بِهِ , فَلا يُعِيدُ الصَّلاةَ \"","","","","","Book of Prayer"
"3579","عَنْ إِسْرَائِيلَ , عَنْ عِيسَى بْنِ أَبِي عَزَّةَ , قَالَ : سَأَلْتُ عَامِرًا الشَّعْبِيَّ , قَالَ : قُلْتُ : أَصَابَ ثَوْبِي دَمٌ , فَعَلِمْتُ بِهِ بَعْدَمَا سَلَّمْتُ ؟ , قَالَ : \" لا تُعِدْ , وَإِنْ كُنْتَ قَدْ عَلِمْتَ بِهِ \"","","","","","Book of Prayer"
"3580","عَنْ أَبِي بَكْرِ بْنِ عَيَّاشٍ , عَنْ حُصَيْنٍ , عَنْ إِبْرَاهِيمَ النَّخَعِيِّ , قال : \" إِذَا رَأَيْتَ فِي ثَوْبِكَ دَمًا وَأَنْتَ فِي الصَّلاةِ , فَإِنْ كَانَ قَلِيلا فَامْضِ , وَإِنْ كَانَ كَثِيرًا فَضَعْهُ وَلا تُعِدْ \"","","","","","Book of Prayer"
"3581","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنْ سَالِمٍ , عَنِ ابْنِ عُمَرَ , قَالَ : \" إِذَا رَأَى الإِنْسَانُ فِي ثَوْبِهِ دَمًا وَهُوَ فِي الصَّلاةِ فَانْصَرَفَ يَغْسِلُهُ , أَتَمَّ مَا بَقِيَ عَلَى مَا مَضَى مَا لَمْ يَتَكَلَّمْ \" , قَالَ الزُّهْرِيُّ , وَقَالَ سَالِمٌ : \" كَانَ ابْنُ عُمَرَ يَنْصَرِفُ لِقَلِيلِهِ وَكَثِيرِهِ \"","","","","","Book of Prayer"
"3582","عَنِ ابْنِ التَّيْمِيِّ , عَنْ أَبِيهِ , عَنِ الْحَسَنِ , قال : \" يُعِيدُ مَا كَانَ فِي وَقْتٍ \" , قَالَ : وَقَالَ النَّخَعِيُّ : \" لا يُعِيدُ \"","","","","","Book of Prayer"
"3583","عَنْ مَعْمَرٍ , وَالثَّوْرِيِّ , عَنْ حَمَّادٍ , قال : \" إِذَا كَانَ فِي ثَوْبِهِ قَدْرُ الدِّرْهَمِ أَعَادَ الصَّلاةَ \"","","","","","Book of Prayer"
"3584","عَنِ ابْنِ التَّيْمِيِّ , عَنْ أَبِيهِ , قال : \" يُغْسَلُ قَلِيلُ الدَّمِ وَكَثِيرُهُ \"","","","","","Book of Prayer"
"3585","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" قَدْ كَانَ يَرْكُدُ فِي الأُولَيَيْنِ مِنَ الظُّهْرِ , وَيُخَفِّفُ الأُخْرَيَيْنِ , وَكَذَلِكَ فِي الْمَغْرِبِ وَالْعِشَاءِ , وَكُلُّ ذَلِكَ فِي الْقِيَامِ , فَأَمَّا فِي الرُّكُوعِ وَالسُّجُودِ فَلا \" , قُلْتُ : أَفَنَجْعَلُ الأُخْرَيَيْنِ فِي الْقِيَامِ ؟ , قَالَ : \" أَوْ لَمْ يَتَشَكَّكْ أَمَّا هَذَا فَلا \"","","","","","Book of Prayer"
"3586","عَنْ مَعْمَرٍ , عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ , عَنْ جَابِرِ بْنِ سَمُرَةَ , قَالَ : كُنْتُ جَالِسًا عِنْدَ عُمَرَ بْنِ الْخَطَّابِ , إِذْ جَاءَ أَهْلُ الْكُوفَةِ يَشْكُونَ سَعْدَ بْنَ أَبِي وَقَّاصٍ , فَقَالُوا : إِنَّهُ لا يُحْسِنُ يُصَلِّي , فَبَيْنَا هُمْ كَذَلِكَ إِذْ مَرَّ بِهِمْ سَعْدٌ , فَدَعَاهُ , فَقَالَ : \" إِنَّ هَؤُلاءِ يَشْكُونَكَ , وَزَعَمُوا أَنَّكَ لا تُحْسِنُ تُصَلِّي , قَالَ : أَمَّا أَنَا فَأُصَلِّي بِهِمْ صَلاةَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَأُصَلِّي بِهِمْ صَلاةَ الْعِشَاءِ فَأَرْكُدُ فِي الأُولَيَيْنِ وَأَحْذِفُ فِي الأُخْرَيَيْنِ \" , قَالَ عُمَرُ : كَذَلِكَ الظَّنُّ يَا أَبَا إِسْحَاقَ","","","","","Book of Prayer"
"3587","عَنِ الثَّوْرِيِّ , عَنْ عَبْدِ الْمَلِكِ بْنِ عُمَيْرٍ , عَنْ جَابِرِ بْنِ سَمُرَةَ , قَالَ : \" شَكَا أَهْلُ الْكُوفَةِ سَعْدًا إِلَى عُمَرَ , فَقَالُوا : لا يُحْسِنُ يُصَلِّي , قَالَ : فَسَأَلَهُ عُمَرُ , فَقَالَ : إِنِّي لأُصَلِّي بِهِمْ صَلاةَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَرْكُدُ فِي الأُولَيَيْنِ , وَأَحْذِفُ فِي الأُخْرَيَيْنِ , قَالَ : ذَلِكَ الظَّنُّ بِكَ يَا أَبَا إِسْحَاقَ , قَالَ الثَّوْرِيُّ : قَالَ عَبْدُ الْمَلِكِ , أَوْ غَيْرُهُ , قَالَ رَجُلٌ مِنْ بَنِي عَبْسٍ لِسَعْدٍ : اللَّهُمَّ إِنَّكَ لا تَنْفُرُ فِي السَّرِيَّةِ , وَلا تَعْدِلُ فِي الرَّعِيَّةِ , وَلا يَقْسِمُ فِي السَّوِيَّةِ , فَقَالَ سَعْدٌ : اللَّهُمَّ إِنْ كَانَ كَذِبَ فَأَعْمِ بَصَرَهُ , وَعَرِّضْهُ لِلْفِتَنِ , وَأَطِلْ فَقْرَهُ , فَقَالَ بَعْضُهُمْ : فَلَقَدْ رَأَيْتُهُ وَهُوَ يَقُولُ أَصَابَتْنِي دَعْوَةُ سَعْدٍ \"","","","","","Book of Prayer"
"3588","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ إِبْرَاهِيمَ , قال : \" الأَوَّلُ مِنَ الصَّلَوَاتِ كُلِّهَا هِيَ أَطْوَلُ فِي الْقِرَاءَةِ \" , عَنْ إِسْرَائِيلَ , عَنْ عِيسَى بْنِ أَبِي عَزَّةَ , عَنِ الشَّعْبِيِّ مِثْلَ قَوْلِ إِبْرَاهِيمَ","","","","","Book of Prayer"
"3589","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قال : \" إِنِّي لأُحِبُّ أَنْ يُطَوِّلَ الإِمَامُ الأُولَى مِنْ كُلِّ صَلاةٍ حَتَّى يَكْثُرَ النَّاسُ \" , قَالَ : \" فَإِذَا صَلَّيْتُ لِنَفْسِي , فَإِنِّي أَحْرِصُ عَلَى أَنْ أَجْعَلَ الأُولَيَيْنِ وَالأُخْرَيَيْنِ سَوَاءً , إِنَّمَا يُفَضَّلُ الأُولَيَانِ فِي الْجَمَاعَةِ لِيَثُوبَ النَّاسُ \"","","","","","Book of Prayer"
"3590","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِنَافِعٍ : هَلْ كَانَ ابْنُ عُمَرَ يُسَوِّي بَيْنَ الْقِيَامِ فِي الظُّهْرِ وَالْعَصْرِ وَالْعِشَاءِ الآخِرَةِ ؟ , قَالَ : \" كَانَ يُسَوِّي بَيْنَ ذَلِكَ كُلِّهِ حَتَّى مَا يَكَادُ شَيْءٌ مِنْ صَلاتِهِ يَكُونُ أَطْوَلَ مِنْ شَيْءٍ \"","","","","","Book of Prayer"
"3591","عَنْ مَعْمَرٍ , عَنْ هَمَّامِ بْنِ مُنَبِّهٍ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا أَمَّ أَحَدُكُمْ لِلنَّاسِ فَلْيُخَفِّفِ الصَّلاةَ , فَإِنَّ فِيهِمُ الْكَبِيرَ , وَالضَّعِيفَ , وَالسَّقِيمَ , وَإِذَا صَلَّى وَحْدَهُ فَلْيُطِلْ صَلاتَهُ مَا شَاءَ \"","","","","","Book of Prayer"
"3592","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ ابْنِ الْمُسَيَّبِ , وَأَبِي سَلَمَةَ , أَوْ أَحَدِهِمَا , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا صَلَّى أَحَدُكُمْ بِالنَّاسِ فَلْيُخَفِّفْ , فَإِنَّ فِيهِمُ السَّقِيمَ , وَالشَّيْخَ الْكَبِيرَ , وَذَا الْحَاجَةِ \"","","","","","Book of Prayer"
"3593","عَنِ الثَّوْرِيِّ , عَنْ إِسْمَاعِيلَ , وَيُونُسَ , عَنِ الْحَسَنِ , أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" مَنْ أَمَّ النَّاسَ فَلْيُقَدِّرِ الْقَوْمَ بِأَضْعَفِهِمْ , فَإِنَّ فِيهِمُ الضَّعِيفَ , وَالْكَبِيرَ , وَذَا الْحَاجَةِ \"","","","","","Book of Prayer"
"3594","عَنِ ابْنِ جُرَيْجٍ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : \" إِذَا كُنْتَ إِمَامًا فَاحْذِفِ الصَّلاةَ , فَزِنْ فِي النَّاسِ الْكَبِيرَ , وَالضَّعِيفَ , وَالْمُعْتَلَّ , وَذَا الْحَاجَةِ , وَإِذَا صَلَّيْتَ وَحْدَكَ فَطَوِّلْ مَا بَدَا لَكَ , وَأَبْرِدْ عَنِ الصَّلاةِ , فَإِنَّ شِدَّةَ الْحَرِّ مِنْ فَيْحِ جَهَنَّمَ فِي كُلِّ صَلاةٍ يَقْرَأُ فِيهَا مَا أَسْمَعَنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَسْمَعْنَاكُمْ , وَمَا أَخْفَى عَلَيْنَا أَخْفَيْنَاهُ مِنْكُمْ \" , ذَلِكَ كُلُّهُ فِي حَدِيثٍ وَاحِدٍ سَمِعْتُهُ مِنْ أَبِي هُرَيْرَةَ","","","","","Book of Prayer"
"3595","عَنِ ابْنِ جُرَيْجٍ , عَنْ عَطَاءٍ , قَالَ : لَمَّا أَمَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عُثْمَانَ بْنَ أَبِي الْعَاصِ , قَالَ لَهُ فِي قَوْلٍ مِنْ ذَلِكَ : \" اقْدُرِ النَّاسَ بِأَضْعَفِهِمْ , فَإِنَّ فِيهِمُ النَّحْوُ مِنْ هَذَا الْخَبَرِ , وَإِذَا كُنْتَ وَحْدَكَ فَطَوِّلْ مَا شِئْتَ \" , وَزَادَ آخَرُونَ , عَنْ عَطَاءٍ فِي حَدِيثِهِ هَذَا حِينَ أَمَّرَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى الطَّائِفِ قَالَ : \" وَإِنْ أَتَاكَ الْمُؤَذِّنُ يُرِيدُ أَنْ يُؤَذِّنَ فَلا تَمْنَعْهُ \"","","","","","Book of Prayer"
"3596","عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ , قَالَ : أَخْبَرَنِي عَبْدُ رَبِّهِ , عَنْ عُثْمَانَ بْنِ أَبِي الْعَاصِ الثَّقَفِيِّ , وَكَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَعْمَلَهُ عَلَى الطَّائِفِ قَالَ : \" وَكَانَ آخِرُ شَيْءٍ عَهِدَهُ إِلَيَّ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنْ أُخَفِّفَ عَنِ النَّاسِ الصَّلاةَ \"","","","","","Book of Prayer"
"3597","أَخْبَرَنَا مَعْمَرٌ , عَنْ ثَابِتٍ , وَأَبَانَ , عَنْ أَنَسٍ , قَالَ : \" مَا صَلَّيْتُ بَعْدَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةً أَخَفَّ مِنْ صَلاةِ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي تَمَامٍ لِرُكُوعٍ وَسُجُودٍ \"","","","","","Book of Prayer"
"3598","أَخْبَرَنَا ابْنُ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عُثْمَانَ , عَنْ نَافِعِ بْنِ سَرْجِسَ , قَالَ : عُدْنَا أَبَا وَاقِدٍ الْبَكْرِيَّ فِي وَجَعِهِ الَّذِي مَاتَ فِيهِ , فَسَمِعْتُهُ , يَقُولُ : \" كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَخَفَّ صَلاةٍ عَلَى النَّاسِ , وَأَطْوَلَ النَّاسِ صَلاةً لِنَفْسِهِ \"","","","","","Book of Prayer"
"3599","عَنْ مَعْمَرٍ , عَنِ الزُّهْرِيِّ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , قَالَ : \" إِنِّي لأَتَجَاوَزُ فِي صَلاتِي إِذْ أَسْمَعُ بُكَاءً \" , أَوْ قَالَ : إِذَا سَمِعْتُ بُكَاءَ الصَّبِيِّ","","","","","Book of Prayer"
"3600","عَنْ مَعْمَرٍ , عَنْ أَبِي هَارُونَ الْعَبْدِيِّ , عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ , قَالَ : صَلَّى بِنَا رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ صَلاةَ الصُّبْحِ , فَقَرَأَ سُورَتَيْنِ مِنْ أَقْصَرِ سُوَرِ الْمُفَصَّلِ , فَذُكِرَ ذَلِكَ لَهُ , فَقَالَ : \" إِنِّي سَمِعْتُ بُكَاءَ صَبِيٍّ فِي مُؤَخَّرِ الصُّفُوفِ فَأَحْبَبْتُ أَنْ تَفْرُغَ إِلَيْهِ أُمُّهُ \" , قَالَ ابْنُ جُرَيْجٍ : قَرَأَ إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ يَوْمَئِذٍ","","","","","Book of Prayer"
"3601","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي عَطَاءٌ , أَنَّهُ بَلَغَهُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" إِنِّي لأُخَفِّفُ الصَّلاةَ إِذْ أَسْمَعُ بُكَاءَ الصَّبِيِّ خَشْيَةَ أَنْ تَفْتَتِنَ أُمُّهُ \"","","","","","Book of Prayer"
"3602","عَنِ الثَّوْرِيِّ , عَنْ أَبِي الْحُوَيْرِثِ الزُّرَقِيِّ , قَالَ : سَمِعْتُ عَلِيَّ بْنَ حُسَيْنٍ , يَقُولُ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنِّي لأَسْمَعُ صَوْتَ الصَّبِيِّ وَرَائِي فَأُخَفِّفُ الصَّلاةَ شَفَقًا أَنْ تَفْتَتِنَ أُمُّهُ \"","","","","","Book of Prayer"
"3603","عَنِ الثَّوْرِيِّ , عَنْ أَبِي السَّوْدَاءِ , عَنْ عَبْدِ الرَّحْمَنِ بْنِ سَابِطٍ , قَالَ : \" قَرَأَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْفَجْرِ فِي الرَّكْعَةِ الأُولَى بِسِتِّينَ آيَةً , ثُمَّ قَامَ فِي الرَّكْعَةِ الثَّانِيَةِ , فَسَمِعَ صَوْتَ صَبِيٍّ , فَقَرَأَ فِيهَا ثَلاثَ آيَاتٍ \"","","","","","Book of Prayer"
"3604","عَنِ ابْنِ جُرَيْجٍ , قَالَ : أَخْبَرَنِي أَبُو الزُّبَيْرِ , قَالَ : سَمِعْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ , يَقُولُ : بَيْنَا فَتًى مِنَ الأَنْصَارِ عَلَفَ نَاضِحَهُ , وَأَقَامَ مُعَاذُ بْنُ جَبَلٍ صَلاةَ الْعِشَاءِ , فَنَزَّلَ الْفَتَى عَلَفَهُ , فَقَامَ فَتَوَضَّأَ , وَحَضَرَ الصَّلاةَ , وَافْتَتَحَ مُعَاذٌ بِسُورَةِ الْبَقَرَةِ , فَصَلَّى الْفَتَى وَتَرَكَ مُعَاذًا , وَانْصَرَفَ إِلَى نَاضِحِهِ فَعَلَفَهُ , أَوْ فَعَلَفَهَا , فَلَمَّا انْصَرَفَ مُعَاذٌ جَاءَ الْفَتَى , فَسَبَّهُ وَنَقَصَهُ , ثُمَّ قَالَ : لآتِيَنَّ نَبِيَّ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَأُخْبِرَهُ خَبَرَكَ , فَأَصْبَحْنَا فَاجْتَمَعَا عِنْدَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , فَذَكَرَ لَهُ مُعَاذٌ شَأْنَهُ , فَقَالَ الْفَتَى : إِنَّا أَهْلُ عَمَلٍ وَشُغْلٍ , فَطَوَّلَ عَلَيْنَا , اسْتَفْتَحَ بِسُورَةِ الْبَقَرَةِ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" يَا مُعَاذُ , أَتُرِيدُ أَنْ تَكُونَ فَتَّانًا ؟ إِذَا أَمَمْتَ النَّاسَ فَاقْرَأْ بِـ سَبِّحِ اسْمَ رَبِّكَ الأَعْلَى , وَاللَّيْلِ إِذَا يَغْشَى , وَ اقْرَأْ بِاسْمِ رَبِّكَ , وَالضُّحَى , وَبِهَذَا النَّحْوِ \" , فَقَالَ عَبْدُ اللَّهِ بْنُ عُبَيْدِ بْنِ عُمَيْرٍ : فَدَعَا النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْفَتَى فَقَالَ : \" يَا مُعَاذُ , ادْعُ \" , فَدَعَا , فَقَالَ لِلْفَتَى : \" ادْعُ \" , فَقَالَ : وَاللَّهِ ! لا أَدْرِي مَا دَنْدَنَتُكُمَا هَذِهِ , غَيْرَ أَنِّي وَاللَّهِ لَئِنْ لَقِيتُ الْعَدُوَّ لأَصْدُقَنَّ اللَّهَ , فَلَقِيَ الْعَدُوَّ فَاسْتَشْهَدَ , فَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" صَدَقَ اللَّهَ فَصَدَقَهُ اللَّهُ \"","","","","","Book of Prayer"
"3605","عَنِ الثَّوْرِيِّ , عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ , عَنْ قَيْسِ بْنِ أَبِي حَازِمٍ , عَنْ أَبِي مَسْعُودٍ الأَنْصَارِيِّ , قَالَ : قَالَ رَجُلٌ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : مَا أَشْهَدُ الصَّلاةَ مِمَّا يُطِيلُ بِنَا فُلانٌ , قَالَ : فَمَا رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ غَضِبَ فِي مَوْعِظَةٍ أَشَدَّ غَضَبًا مِنْهُ يَوْمَئِذٍ , قَالَ : \" مَنْ أَمَّ النَّاسَ فَلْيُخَفِّفْ , فَإِنَّ خَلْفَهُ الضَّعِيفَ , وَالْكَبِيرَ , وَذَا الْحَاجَةِ \"","","","","","Book of Prayer"
"3606","عَنْ مَعْمَرٍ , عَنْ أَبِي رَجَاءٍ الْعُطَارِدِيِّ , قَالَ : \" قَدِمَ طَلْحَةُ , وَالزُّبَيْرُ فَصَلَّى بِنَا طَلْحَةُ فَخَفَّفَ , فَقُلْنَا : مَا هَذَا ؟ , قَالَ : \" بَادَرْتُ الْوَسْوَاسَ \"","","","","","Book of Prayer"
"3607","عَنِ الثَّوْرِيِّ , عَنْ نُسَيْرِ بْنِ ذُعْلُوقٍ , عَنْ خُلَيْدٍ , عَنْ عَمَّارِ بْنِ يَاسِرٍ , قَالَ : \" احْذِفُوا هَذِهِ الصَّلاةَ قَبْلَ وَسْوَسَةِ الشَّيْطَانِ \"","","","","","Book of Prayer"
"3608","عَنْ مُوسَى الْجُهَنِيِّ , عَنْ مُصْعَبِ بْنِ سَعْدِ بْنِ أَبِي وَقَّاصٍ , قَالَ : \" كَانَ أَبِي يُطِيلُ الصَّلاةَ فِي بَيْتِهِ , وَيُخَفِّفُ عِنْدَ النَّاسِ , فَقُلْتُ : يَا أَبَتَاهُ , لِمَ تَفْعَلُ هَذَا ؟ , قَالَ : إِنَّا أَئِمَّةٌ يُقْتَدَى بِنَا \"","","","","","Book of Prayer"
"3609","عَنِ الثَّوْرِيِّ , عَنْ عَوْفٍ , عَنْ أَبِي رَجَاءٍ , قَالَ : صَلَّى بِنَا الزُّبَيْرُ صَلاةً فَخَفَّفَ , فَقِيلَ لَهُ , فَقَالَ \" إِنِّي أُبَادِرُ الْوَسْوَاسَ \"","","","","","Book of Prayer"
"3610","عَنِ الثَّوْرِيِّ , عَنْ عَوْفٍ , عَنْ أَبِي إِسْحَاقَ , عَنْ عَمْرِو بْنِ مَيْمُونَ الأَوْدِيِّ , قال : \" لَوْ أَنَّ رَجُلا أَخَذَ شَاةً عَزُوزًا لَمْ يَفْرُغْ مِنْ لَبَنِهَا حَتَّى أُصَلِّيَ الصَّلَوَاتِ الْخَمْسَ , أُتِمُّ رُكُوعَهَا وَسُجُودَهَا \"","","","","","Book of Prayer"
"3611","عَنْ مَعْمَرٍ , عَنِ الأَعْمَشِ , عَنْ زَيْدِ بْنِ وَهْبٍ , قَالَ : كُنَّا جُلُوسًا مَعَ حُذَيْفَةَ فِي الْمَسْجِدِ , فَرَأَى رَجُلا يُصَلِّي صَلاةً لا يُتِمُّ رُكُوعَهَا وَلا سُجُودَهَا , فَلَمَّا انْصَرَفَ دَعَاهُ , فَقَالَ لَهُ : \" مُنْذُ كَمْ صَلَّيْتَ هَذِهِ الصَّلاةَ ؟ \" , قَالَ : مُنْذُ أَرْبَعِينَ سَنَةً , قَالَ حُذَيْفَةُ : \" مَا صَلَّيْتَ مُنْذُ كُنْتَ , وَلَوْ مُتَّ وَأَنْتَ عَلَى هَذَا لَمُتَّ عَلَى غَيْرِ فِطْرَةِ مُحَمَّدٍ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الَّذِي فُطِرَ عَلَيْهَا \"","","","","","Book of Prayer"
"3612","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ زَيْدِ بْنِ وَهْبٍ , قَالَ : كُنَّا مَعَ حُذَيْفَةَ , فَجَاءَهُ رَجُلٌ مِنْ أَبْوَابِ كِنْدَةَ صَلَّى صَلاةً جَعَلَ يَنْقُرُ فِيهَا , وَلا يُتِمُّ رُكُوعَهُ , فَقَالَ لَهُ حُذَيْفَةُ : \" مُنْذُ كَمْ صَلَّيْتَ هَذِهِ الصَّلاةَ ؟ \" , قَالَ : مُنْذُ أَرْبَعِينَ سَنَةً , قَالَ : \" مَا صَلَّيْتَ مُنْذُ أَرْبَعِينَ سَنَةً , وَلَوْ مُتَّ لَمُتَّ عَلَى غَيْرِ الْفِطْرَةِ الَّتِي فُطِرَ عَلَيْهَا مُحَمَّدٌ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ \" , ثُمَّ قَالَ حُذَيْفَةُ : \" إِنَّ الرَّجُلَ يُخَفِّفُ , ثُمَّ يُتِمُّ رُكُوعَهُ وَسُجُودَهُ \"","","","","","Book of Prayer"
"3613","عَنِ الثَّوْرِيِّ , قَالَ : حَدَّثَنِي رَجُلٌ أَثِقُ بِهِ , عَنْ أَبِي الدَّرْدَاءِ , \" أَنَّهُ مَرَّ بِرَجُلٍ لا يُتِمُّ رُكُوعًا وَلا سُجُودًا , فَقَالَ : شَيْءٌ خَيْرٌ مِنْ لا شَيْءٍ \"","","","","","Book of Prayer"
"3614","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَوْ غَيْرِهِ , عَنِ ابْنِ مَسْعُودٍ , أَنَّهُ رَأَى رَجُلَيْنِ يُصَلِّيَانِ , أَحَدُهُمَا مُسْبِلٌ إِزَارَهُ , وَالآخَرُ لا يُتِمُّ رُكُوعَهُ وَلا سُجُودَهُ , فَضَحِكَ , قَالُوا : مِمَّا تَضْحَكُ يَا أَبَا عَبْدِ الرَّحْمَنِ ؟ , قَالَ : \" عَجِبْتُ لِهَذَيْنِ الرَّجُلَيْنِ , أَمَّا الْمُسْبِلُ إِزَارَهُ فَلا يَنْظُرُ اللَّهُ إِلَيْهِ , وَأَمَّا الآخَرُ فَلا يَقْبَلُ اللَّهُ صَلاتَهُ \"","","","","","Book of Prayer"
"3615","عَنِ الثَّوْرِيِّ , عَنِ الأَعْمَشِ , عَنْ عُمَارَةَ بْنِ عُمَيْرٍ , عَنْ أَبِي مَعْمَرٍ , عَنْ أَبِي مَسْعُودٍ , قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" لا تُجْزِئُ صَلاةٌ لا يُقِيمُ الرَّجُلُ فِيهَا صُلْبَهُ فِي الرُّكُوعِ وَالسُّجُودِ \"","","","","","Book of Prayer"
"3616","عَنْ إِسْمَاعِيلَ , عَنِ ابْنِ أَبِي ذِئْبٍ , قَالَ : حَدَّثَنَا عَجْلانُ , عَنْ أَبِي هُرَيْرَةَ , قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنِّي لأَنْظُرُ فِي الصَّلاةِ مِنْ وَرَائِي كَمَا أَنْظُرُ بَيْنَ يَدَيَّ , فَسَوُّوا صُفُوفَكُمْ , وَأَحْسِنُوا رُكُوعَكُمْ وَسُجُودَكُمْ \"","","","","","Book of Prayer"
"3617","عَنِ الثَّوْرِيِّ , عَنْ أَبِي إِسْحَاقَ الْهَجْرِيِّ , عَنْ أَبِي الأَحْوَصِ , عَنْ عَبْدِ اللَّهِ , عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" مَنْ أَحْسَنَ الصَّلاةَ حَيْثُ يَرَاهُ النَّاسُ , ثُمَّ أَسَاءَهَا حِينَ يَخْلُو , فَتِلْكَ اسْتِهَانَةٌ اسْتَهَانَ بِهَا رَبَّهُ \"","","","","","Book of Prayer"
"3618","أَخْبَرَنَا دَاوُدُ بْنُ قَيْسٍ , قَالَ : حَدَّثَنِي عَلِيُّ بْنُ يَحْيَى بْنِ خَلادِ بْنِ رَافِعِ بْنِ مَالِكٍ الزُّرَقِيُّ , قَالَ : حَدَّثَنِي أَبِي , عَنْ عَمِّهِ , وَكَانَ بَدْرِيًّا , قَالَ : بَيْنَا نَحْنُ جُلُوسٌ مَعَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمَسْجِدِ , إِذْ دَخَلَ رَجُلٌ فَصَلَّى رَكْعَتَيْنِ , وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَرْمُقُهُ , ثُمَّ جَاءَ فَسَلَّمَ عَلَيْهِ , فَرَدَّ عَلَيْهِ السَّلامَ , ثُمَّ قَالَ : \" ارْجِعْ فَصَلِّ , فَإِنَّكَ لَمْ تُصَلِّ \" , قَالَ : فَرَجَعَ فَصَلَّى , ثُمَّ جَاءَ فَسَلَّمَ عَلَيْهِ , فَرَدَّ عَلَيْهِ السَّلامَ , ثُمَّ قَالَ : \" ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ \" , فَرَجَعَ , ثُمَّ جَاءَ فَسَلَّمَ عَلَيْهِ , فَرَدَّ عَلَيْهِ السَّلامَ , ثُمَّ قَالَ : \" ارْجِعْ فَصَلِّ فَإِنَّكَ لَمْ تُصَلِّ \" , فَأَعَادَ عَلَيْهِ الْقَوْلَ الثَّالِثَةَ أَوِ الرَّابِعَةَ , وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَقُولُ مِثْلَ قَوْلِهِ الأَوَّلِ , فَقَالَ : أَيْ رَسُولَ اللَّهِ , بِأَبِي أَنْتَ وَأُمِّي , وَالَّذِي أَنْزَلَ عَلَيْكَ الْكِتَابَ لَقَدِ اجْتَهَدْتُ وَحَرِصْتُ فَأَرِنِي وَعَلِّمْنِي , فَقَالَ : \" إِذَا أَرَدْتَ أَنْ تُصَلِّيَ فَأَحْسِنْ وُضُوءَكَ , ثُمَّ اسْتَقْبِلِ الْقِبْلَةَ فَكَبِّرْ , ثُمَّ اقْرَأْ , ثُمَّ ارْكَعْ حَتَّى تَطْمَئِنَّ رَاكِعًا , ثُمَّ ارْفَعْ حَتَّى تَعْتَدِلَ قَائِمًا , ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا , ثُمَّ ارْفَعْ حَتَّى تَطْمَئِنَّ جَالِسًا , ثُمَّ اسْجُدْ حَتَّى تَطْمَئِنَّ سَاجِدًا , ثُمَّ ارْفَعْ , فَإِذَا أَتْمَمْتَ عَلَى هَذَا , فَقَدْ أَتْمَمْتَ , وَمَا نَقَصْتَ مِنْ هَذَا نَقَصْتَهُ مِنْ نَفْسِكَ \"","","","","","Book of Prayer"
"3619","عَنِ ابْنِ عُيَيْنَةَ , عَنْ يَحْيَى بْنِ سَعِيدٍ , عَنْ نُعْمَانَ بْنِ مُرَّةَ الزُّرَقِيِّ , رَفَعَ الْحَدِيثَ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ , أَنَّهُ قَالَ : \" مَا تَقُولُونَ فِي السَّارِقِ , وَالزَّانِي , وَشَارِبِ الْخَمْرِ ؟ \" , قَالُوا : اللَّهُ وَرَسُولُهُ أَعْلَمُ , قَالَ : \" هُنَّ فَوَاحِشُ , وَفِيهُنَّ عُقُوبَاتٌ , وَشَرُّ السَّرِقَةِ سَرِقَةُ الرَّجُلِ صَلاتَهُ \" , قَالُوا : يَا رَسُولَ اللَّهِ , وَكَيْفَ يَسْرِقُ صَلاتَهُ ؟ , قَالَ : \" لا يُتِمُّ رُكُوعَهَا وَلا سُجُودَهَا \"","","","","","Book of Prayer"
"3620","عَنْ مَعْمَرٍ , عَنِ ابْنِ طَاوُسٍ , عَنْ أَبِيهِ , قال : \" إِنَّ الْمَلائِكَةَ يَكْتُبُونَ أَعْمَالَ بَنِي آدَمَ , فَيَقُولُونَ : فُلانٌ نَقَصَ مِنْ صَلاتِهِ الرُّبْعُ , وَنَقَصَ فُلانٌ الشَّطْرَ وَزَادَ فُلانٌ كَذَا وَكَذَا \"","","","","","Book of Prayer"
"3621","عَنِ الثَّوْرِيِّ , عَنْ آدَمَ بْنِ عَلِيٍّ الشَّيْبَانِيِّ , قَالَ : سَمِعْتُ ابْنَ عُمَرَ , يَقُولُ : \" لَيُدْعَنَّ أُنَاسٌ يَوْمَ الْقِيَامَةِ الْمَنْقُوصِينَ \" , قِيلَ : يَا أَبَا عَبْدِ الرَّحْمَنِ وَمَا الْمَنْقُوصُونَ ؟ , قَالَ : \" يُنْقِصُ أَحَدُهُمْ صَلاتَهُ فِي وُضُوئِهِ وَالْتِفَاتِهِ \"","","","","","Book of Prayer"
"3622","عَنْ يَحْيَى بْنِ الْعَلاءِ , عَنْ رَجُلٍ , عَنْ زَيْدِ بْنِ أَسْلَمَ , قال : \" النَّاسُ فِي الصَّلاةِ ثَلاثَةٌ مُقْمَحٌ , وَمُلْجَمٌ , وَمَعْصُومٌ , فَأَمَّا الْمُقْمَحُ فَالَّذِي يَضْرِبُ بِيَدِهِ عَلَى صَدْرِهِ , ثُمَّ يُفَكِّرُ فِي أَمْرِ دُنْيَاهُ حَتَّى يَفْرُغَ مِنْ أَمْرِ صَلاتِهِ , وَأَمَّا الْمُلْجَمُ فَالَّذِي يَلْوِي عُنُقَهُ يَمِينًا وَشِمَالا , وَأَمَّا الْمَعْصُومُ فَالَّذِي يُقْبِلُ عَلَى صَلاتِهِ , لا يَهُمُّهُ غَيْرُهَا حَتَّى يَفْرُغَ مِنْهَا \"","","","","","Book of Prayer"
"3623","عَنِ الثَّوْرِيِّ , عَنْ مَنْصُورٍ , عَنْ إِبْرَاهِيمَ , قال : \" كَانُوا إِذَا رَأَوُا الرَّجُلَ لا يُحْسِنُ الصَّلاةَ عَلَّمُوهُ \"","","","","","Book of Prayer"
"3624","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : أَرَأَيْتَ لَوْ أَنِّي بَعْدَمَا فَرَغتُ مِنْ صَلاتِي لَمْ أَرْضَ كَمَالَهَا , أَعُودُ لَهَا ؟ , قَالَ : \" بَلَى , هَا اللَّهِ إِذًا فَعُدْ لَهَا , فَإِنْ كَانَتْ قَدْ فَاتَتِ ابْتِغَاءَ وَجْهِ اللَّهِ , فَإِنِّي أَرْجُو أَنْ لا يَرُدَّ اللَّهُ عَلَيْكَ \"","","","","","Book of Prayer"
"3625","عَنِ ابْنِ جُرَيْجٍ , قَالَ : قُلْتُ لِعَطَاءٍ : مَا الَّذِي إِذَا بَلَغَهُ الإِنْسَانُ مِنَ الصَّلاةِ إِتْمَامًا لا يُجْزِيهِ دُونَهُ ؟ , قَالَ : \" الْوُضُوءُ لا يَكْفِي مِنْهُ إِلا الإِسْبَاغُ , وَمِنَ الْقِرَاءَةِ أُمُّ الْقُرْآنِ , قَالَ : قُلْتُ : يَكْفِي إِذَا انْتَهَى إِلَيْهَا ؟ , قَالَ : نَعَمْ \"","","","","","Book of Prayer"
"3626","عَنْ مَعْمَرٍ , عَنْ قَتَادَةَ , أَنَّ ابْنَ مَسْعُودٍ , قَالَ : \" إِنَّ لِلصَّلاةِ وَقْتًا كَوَقْتِ الْحَجِّ \"","","","","","Book of Prayer"
"3627","أَخْبَرَنَا الثَّوْرِيُّ , عَنْ أَبِي إِسْحَاقَ , عَنْ ذَكْوَانَ , عَنْ كَعْبٍ , قَالَ : إِنَّ الصَّلاةَ ثَلاثَةُ أَثْلاثٍ ثُلْثٌ طَهُورٌ , وَثُلْثٌ رُكُوعٌ , وَثُلْثٌ سُجُودٌ , فَمَنْ حَافَظَ عَلَيْهِنَّ قُبِلْنَ مِنْهُ , وَمَنْ نَقَصَ فَإِنَّمَا يَنْقُصُ مِنْ نَفْسِهِ \" , أَخْبَرَنَا الثَّوْرِيُّ , عَنْ زُبَيْدٍ , عَنْ أَبِي الضُّحَى , عَنْ كَعْبٍ , مِثْلَ هَذَا , إِلا أَنَّهُ قَالَ : \" مَنْ حَافَظَ عَلَيْهِنَّ قُبِلْنَ مِنْهُ وَمَا سِوَاهُنَّ , وَمَنْ ضَيَّعَهُنَّ رُدِدْنَ عَلَيْهِ وَمَا سِوَاهُنَّ \"","","","","","Book of Prayer"
"3628","عَنِ الثَّوْرِيِّ , عَنْ أَبِي نَصْرٍ , عَنْ سَالِمِ بْنِ أَبِي الْجَعْدِ , قَالَ : قَالَ سَلْمَانُ : \" الصَّلاةُ مِكْيَالٌ مَنْ أَوْفَى أُوفِيَ بِهِ , وَمَنْ طَفَّفَ فَقَدْ عَلِمْتُمْ مَا لِلْمُطَفِّفِينَ \"","","","","","Book of Prayer"
"3629","عَنْ مَعْمَرٍ , عَنْ مُحَمَّدِ بْنِ زِيَادٍ , أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ , يَقُولُ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَا يُؤَمِّنُ الَّذِي يَرْفَعُ رَأْسَهُ قَبْلَ الإِمَامِ أَنْ يَرُدَّ اللَّهُ رَأْسَهُ رَأْسَ حِمَارٍ \"","","","","","Book of Prayer"
"3630","عَنِ الثَّوْرِيِّ , عَنْ زِيَادِ بْنِ الْفَيَّاضِ , عَنْ تَمِيمِ بْنِ سَلَمَةَ , قَالَ : قَالَ عَبْدُ اللَّهِ : \" مَا يُؤَمِّنُ الرَّجُلُ إِذَا رَفَعَ رَأْسَهُ قَبْلَ الإِمَامِ , أَنْ يَعُودَ رَأْسُهُ كَرَأْسِ كَلْبٍ , لَيَنْتَهِيَنَّ أَقْوَامٌ يَرْفَعُونَ أَبْصَارَهُمْ إِلَى السَّمَاءِ , أَوْ لا تَرْجِعُ إِلَيْهِمْ \"","","","","","Book of Prayer"
