hadiths[3]{hadithnumber,text}:
"662","[AI-translation] ((Seyyidünâ Ebû Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: “Katır yırtıcı hayvanlara dahildir.”))"
"663","[AI-translation] ((Seyyidünâ Ebû Hüreyre (radıyallahu anh) Resulullah'tan (sallallahu aleyhi ve sellem) rivayet etti — buyurdu: “Çölde oturan sert huylu olur; avı takip eden gafil olur; kralların kapılarına giden fitnelere düşer; kişi krala yaklaştıkça Allah'tan uzaklaşır.”))"
"664","[AI-translation] ((Ya'la bin Ubeyd'den aynı zincirle rivayet edildi — bunda Peygamber (sallallahu aleyhi ve sellem) buyurdu: “Kralların kapılarına gitmeyi âdet edinen.”))"
