hadiths[22]{hadithnumber,text}:
"484","[AI-translation] ((Sayyiduna Abu Hurairah (Allah amridhie) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Umra (kumpa mtu kitu kwa muda wa uhai wake) ni mirathi kwa warithi wake. Au ni halali kwa warithi wake.""))"
"485","[AI-translation] ((Shurayh amesimulia: Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) alitoa hukumu kuhusu Umra kwamba ni halali.))"
"486","[AI-translation] ((Sayyiduna Abu Hurairah (Allah amridhie) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Umra ni halali.""))"
"487","[AI-translation] ((Qatadah (Allah amrehemu) amesimulia, Hasan (Allah amrehemu) amesema: Walikuwa wakisema: 'Umra ni halali.' ))"
"488","[AI-translation] ((Imam Zuhri (Allah amrehemu) amesema: Umra ni mtu kusema: ""Hii ni kwa ajili yake, na baada yake kwa kizazi chake."" Basi ni kwa aliyemwekea sharti.))"
"489","[AI-translation] ((Sayyiduna Jabir bin Abdullah (Allah amridhie) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Umra ni halali.""))"
"490","[AI-translation] ((Imam Zuhri (Allah amrehemu) amesema: Makhalifa walikuwa wakiamua jambo hili. Ata (Allah amrehemu) amesema: Abdul Malik bin Marwan aliamua jambo hili.))"
"491","[AI-translation] ((Sayyiduna Jabir bin Abdullah (Allah amridhie) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Umra ni halali.""))"
"492","[AI-translation] ((Sayyiduna Abu Hurairah (Allah amridhie) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Atakayepewa kitu bila kukiomba na akakikubali, basi ni riziki ambayo Allah amemtumia.""))"
"493","[AI-translation] ((Sayyiduna Abu Hurairah (Allah amridhie) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Nikizawadiwa mguu wa mbele, nitaukubali, na nikiitwa kwenye karamu ya mguu, pia nitaukubali mwaliko huo.""))"
"494","[AI-translation] ((A'mash (Allah amrehemu) amesimulia kwa isnad hii riwaya mfano wa hadithi iliyotangulia.))"
"495","[AI-translation] ((Sayyiduna Abu Hurairah (Allah amridhie) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Nikizawadiwa nyama ya mguu wa mbele, nitaikubali."" Jarir (Allah amrehemu) amesimulia: Nadhani kwamba yeye (Swalla Allahu 'alayhi wa sallam) amesema: ""Nikiitwa kwenye nyama ya mguu wa mbele, nitaikubali.""))"
"496","[AI-translation] ((Imesimuliwa na Abu Hurairah (Allah amridhie) kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Anayerudisha zawadi yake ni kama mbwa anayeendelea kula hadi ashibe, kisha hutapika, kisha huanza kula matapishi yake.""))"
"497","[AI-translation] ((Sayyiduna Abu Hurairah (Allah amridhie) amesimulia: Chakula kilipowasilishwa kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) nyumba isiyo yake, aliuliza: ""Hii ni zawadi au sadaka?"" Ikisemwa kwamba ni sadaka, yeye (Swalla Allahu 'alayhi wa sallam) hakula humo, lakini Masahaba zake walikula. Na ikisemwa kwamba ni zawadi, basi yeye (Swalla Allahu 'alayhi wa sallam) alikula humo.))"
"498","[AI-translation] ((Sayyiduna Ibn Abbas (Allah awaridhie wote wawili) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Anayerudisha zawadi yake ni kama mbwa anayetapika kisha huyaramba.""))"
"499","[AI-translation] ((Sayyiduna Ibn Abbas (Allah awaridhie wote wawili) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Anayerudisha zawadi yake ni kama mbwa anayetapika kisha huyaramba.""))"
"500","[AI-translation] ((Sayyiduna Ibn Abbas (Allah awaridhie wote wawili) amesimulia kwamba Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) amesema: ""Si halali kwa yeyote kutoa zawadi kisha kuirudisha, isipokuwa baba anayempa mtoto wake. Mfano wa mtu anayetoa zawadi kisha kuirudisha ni kama mbwa anayetapika kisha huyaramba.""))"
"501","[AI-translation] ((Tawoos (Allah amrehemu) amesimulia, Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) amesema: ""Si halali kwa yeyote kutoa zawadi kisha kuirudisha, isipokuwa baba (anaweza kurudisha alichompa mtoto wake).\"))"
"502","[AI-translation] ((Ata (Allah amrehemu) amesimulia, Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) amesema: ""Anayerudisha zawadi yake ni kama anayeramba matapishi yake mwenyewe.""))"
"503","[AI-translation] ((Sayyiduna Ibn Abbas (Allah awaridhie wote wawili) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Zawadi inapopewa mmoja wenu na kuna watu pamoja naye, basi wao pia hushiriki humo.""))"
"504","[AI-translation] ((Imesimuliwa na Sayyiduna Ibn Abbas (Allah awaridhie wote wawili) kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam), amesema: ""Hakuna mfano mbaya kwetu (hatutakuwa miongoni mwa wanaoelezewa na mfano huu); anayerudisha zawadi yake ni kama mbwa anayetapika kisha huyaramba.""))"
"505","[AI-translation] ((Sayyiduna Ibn Abbas (Allah awaridhie wote wawili) amesimulia kutoka kwa Mtume wa Allah (Swalla Allahu 'alayhi wa sallam) riwaya mfano wa hadithi iliyotangulia.))"
